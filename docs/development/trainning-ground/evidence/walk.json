        "name": "可可可鲁鲁#npc10"
      },
      "dialogue": {
        "pages": [
          {
            "text": "[可可可鲁鲁]\n听说和头上有猫图标的假人训练，能帮助你在PvP中对抗杜兰族。"
          },
          {
            "text": "[可可可鲁鲁]\n我才不是被路过的杜兰族打败后才来这里练习的。记住！"
          }
        ],
        "waiting": "closed"
      }
    },

      },
      "dialogue": {
        "pages": [
          {
            "text": "[接待员]\n欢迎来到学院。我负责初心者教育课程的引导和登记。"
          },
          {
            "text": "[接待员]\n我能为你做什么？"
          },
          {
            "text": "[接待员]\n我能为你做什么？"
          },
          {
            "options": [
              "学院报名",
              "学院介绍",
              "导师位置",
              "结束对话"
            ],
            "choice": "结束对话"
          },
          {
            "text": "[接待员]\n如果还需要其他帮助，请来找我。"
          }
        ],
        "waiting": "closed"
      },

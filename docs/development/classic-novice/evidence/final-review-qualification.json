    {
      "case": "Nine jobs: underqualified thief",
      "npc": {
        "id": 110021645,
        "name": "盗贼公会接待员"
      },
      "dialogue": {
        "pages": [
          {
            "text": "[盗贼公会接待员]\n呃……看起来像富裕家庭宠爱的儿子，为什么会来这个肮脏的地方？"
          },
          {
            "text": "[盗贼公会接待员]\n呃……看起来像富裕家庭宠爱的儿子，为什么会来这个肮脏的地方？"
          },
          {
            "options": [
              "我想成为盗贼。",
              "没什么。"
            ],
            "choice": "我想成为盗贼"
          },
          {
            "text": "[盗贼公会接待员]\n你就这么骄傲吗？\n你骄傲地告诉我想当盗贼！为什么不去所有村庄宣传你是盗贼？\n哈哈哈！挂个横幅写‘我是骄傲的盗贼，专偷别人的东西。’"
          },
          {
            "text": "[盗贼公会接待员]\n你就这么想当盗贼吗？"
          },
          {
            "text": "[盗贼公会接待员]\n你就这么想当盗贼吗？"
          },
          {
            "options": [
              "是。",
              "不。",
              "你呢？"
            ],
            "choice": "是。"
          },
          {
            "text": "[盗贼公会接待员]\n哦，是吗……嗯……我活着就是为了见识你这样的怪人。"
          },
          {
            "text": "[盗贼公会接待员]\n总之，在外面的世界千万别说想当盗贼！！"
          },
          {
            "text": "[盗贼公会接待员]\n那么，你要申请成为盗贼吗？"
          },
          {
            "text": "[盗贼公会接待员]\n那么，你要申请成为盗贼吗？"
          },
          {
            "options": [
              "是的。",
              "不。"
            ],
            "choice": "是的"
          },
          {
            "text": "[盗贼公会接待员]\n好，告诉我你的名字。嗯？什么？\nNoviceClassicQuiz。所以你叫NoviceClassicQuiz，对吧……？"
          },
          {
            "text": "[盗贼公会接待员]\n我能看到你成为盗贼的强烈意志……\n但只有意志无法应对真正的战斗，对吧？\n去把基础技能至少提升到 9 级。"
          }
        ],
        "waiting": "closed"
      },

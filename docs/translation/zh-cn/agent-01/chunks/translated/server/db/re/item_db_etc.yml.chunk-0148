         bonus2 bAddEle,Ele_Undead,3;
         bonus2 bMagicAddEle,Ele_Undead,3;
         bonus2 bAddEle,Ele_Ghost,3;
         bonus2 bMagicAddEle,Ele_Ghost,3;
         if (.@g>=ENCHANTGRADE_C) {
            bonus2 bAddEle,Ele_Undead,4;

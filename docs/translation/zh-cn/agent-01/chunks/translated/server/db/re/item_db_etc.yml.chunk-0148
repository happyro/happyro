               bonus2 bAddEle,Ele_Ghost,4;
               bonus2 bMagicAddEle,Ele_Ghost,4;
               if (.@g>=ENCHANTGRADE_A) {
                  bonus2 bAddEle,Ele_Undead,4;
                  bonus2 bMagicAddEle,Ele_Undead,4;
                  bonus2 bAddEle,Ele_Ghost,4;
                  bonus2 bMagicAddEle,Ele_Ghost,4;
               }
            }
         }
      }

      bonus2 bMagicAddEle,Ele_Undead,10;
      bonus2 bAddEle,Ele_Undead,10;
      bonus2 bMagicAddEle,Ele_Ghost,10;
      bonus2 bAddEle,Ele_Ghost,10;

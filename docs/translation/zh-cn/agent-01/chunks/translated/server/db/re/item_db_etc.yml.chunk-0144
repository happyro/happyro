  - Id: 311449
    AegisName: Physical_Grade_1
    Name: 冰川花咒语（物理等级）1级
    Type: Card
    SubType: Enchant
    Script: |
      .@g = getenchantgrade();
      .@r = getrefine();
      bonus bLongAtkRate,3;
      bonus bShortAtkRate,3;
      bonus bBaseAtk,15;
      if (.@r>=7) {
         bonus bAspdRate,3;
         if (.@r>=9) {
            bonus bVariableCastrate,-3;
            bonus bDelayrate,-3;
         }
      }
      if (.@g>=ENCHANTGRADE_D) {
         bonus bAtkRate,1;
         bonus bBaseAtk,15;
         if (.@g>=ENCHANTGRADE_C) {
            if (.@r>=9) {
               bonus bPAtk,3;
            }
            if (.@g>=ENCHANTGRADE_B) {
               if (.@r>=11) {
                  bonus bPow,1;
                  bonus bCon,1;
               }
               if (.@g>=ENCHANTGRADE_A) {
                  bonus2 bAddEle,Ele_All,10;
                  if (.@r>=11) {
                     bonus2 bAddSize,Size_All,10;
                  }
               }
            }
         }
      }

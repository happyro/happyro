  - Id: 470303
    AegisName: Yorscalp_Boots
    Name: 约尔斯卡尔普长靴
    Type: Armor
    Weight: 2000
    Defense: 128
    Slots: 1
    Locations:
      Shoes: true
    ArmorLevel: 2
    EquipLevelMin: 250
    Refineable: true
    Gradable: true
    Script: |
      .@g = getenchantgrade();
      .@r = getrefine();
      bonus bMaxHPrate,10;
      bonus bMaxSPrate,4+(.@r/2);
      bonus bDef,15*(.@r/2);
      if (.@r>=7) {
         bonus bAspdRate,10;
         if (.@r>=9) {
            bonus bLongAtkRate,5;
            bonus bShortAtkRate,5;
            bonus bPAtk,5;
            if (.@r>=10) {
               bonus bBaseAtk,20;
               bonus bDef,100;
               if (.@r>=12) {
                  bonus bLongAtkRate,8;
                  bonus bShortAtkRate,8;
               }
            }
         }
      }
      if (.@g>=ENCHANTGRADE_D) {
         bonus bBaseAtk,10;
         bonus bPow,2;
         bonus bCon,2;
         if (.@g>=ENCHANTGRADE_C) {
            bonus bPAtk,4;
            bonus bAtkRate,4;
            if (.@g>=ENCHANTGRADE_B) {
               bonus bFixedCast,-1000;
               if (.@g>=ENCHANTGRADE_A) {
                  bonus bPAtk,5;
                  bonus bAtkRate,5;
               }
            }
         }
      }

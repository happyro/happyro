			mes "我相信他们会带给你好消息。";
			set para_suv01,28;
			changequest 7150,7151;
			close;
		}
		mes "[Hooksha]";
		mes "兽人女战士是最后的目标。";
		mes "打起精神来～！";
		next;
		mes "[Hooksha]";
		mes "你看起来很累，我来帮你恢复体力。";
		mes "遇到困难就回来这里休息吧。";
		npcskill "AL_HEAL",11,99,60;
		percentheal 100,100;
		close;
	}
	if (para_suv01 == 28) {
		mes "[Hooksha]";
	mes "你已经完成训练任务了。";
	mes "回伊甸园总部报告吧。";
		close;
	}
	if (para_suv01 == 29) {
		mes "[Hooksha]";
	mes "你是来这里参加训练的吗？";
	mes "你看起来像个老手。";
		next;
		mes "[Hooksha]";
	mes "这里不适合聊天，我们快点吧。";
	mes "这里与兽人村落的地下城相连。";
		next;
		mes "[Hooksha]";
	mes "你能看到那边吗？";
	mes "地下有一个洞穴，普通兽人不会来这里。";
		next;
		mes "[Hooksha]";
	mes "这里是最安全的地方。";
	mes "下面有很多不死魔物。";
		next;
		mes "[Hooksha]";
	mes "那些不死魔物非常危险。";
	mes "与它们战斗时不要犹豫。";
		next;
		mes "[Hooksha]";
	mes "现在去狩猎下面的不死魔物吧。";
		next;
		mes "[Hooksha]";
	mes "试着在地下城里狩猎 20 只兽人僵尸。";
	mes "它们组织得非常严密。";
		next;
		mes "[Hooksha]";
	mes "它们会毫不犹豫地在任何地方攻击你。";
	mes "愿芙蕾雅保佑你。";
		set para_suv01,30;
		changequest 7152,7153;
		close;
	}
	if (para_suv01 == 30) {
		if (checkquest(7153,HUNTING) == 2) {
			mes "[Hooksha]";
			mes "这和你在斐扬看到的不同，对吧？";
			mes "虽然你成功杀死了兽人僵尸，但也别以为自己强大了多少……";
			next;
			mes "[Hooksha]";
			mes "所以别再深入那个洞穴，否则肯定会没命。";
			next;
			mes "[Hooksha]";
			mes "下一个目标是和兽人僵尸一起行动的兽人骷髅。";
			mes "狩猎 20 只兽人骷髅。";
			next;
			mes "[Hooksha]";
			mes "这是兽人地下城训练任务的最后一步。";
			mes "一切就靠你了。";
			next;
			mes "[Hooksha]";
			mes "好，打起精神来，我们下次再见。";
			mes "狩猎 20 只兽人骷髅。";
			set para_suv01,31;
			changequest 7153,7154;
			close;
		}
		mes "[Hooksha]";
		mes "你能再待一会儿吗？";
		mes "你看起来很累，我来帮你恢复体力。";
		mes "遇到困难就回来这里休息吧。";
		npcskill "AL_HEAL",11,99,60;
		percentheal 100,100;
		close;
	}
	if (para_suv01 == 31) {
		if (checkquest(7154,HUNTING) == 2) {
			mes "[Hooksha]";
			mes "你的训练任务完成了。";
			mes "回伊甸园总部报告吧。";
			mes "我本想再详细说说，但我实在太累了。";
			next;
			mes "[Hooksha]";
			mes "最近来这里训练的人越来越多，我根本睡不着。";
			mes "我不是在说你。";
			mes "总之我会通知总部，你去那里报告吧。";
			next;
			set para_suv01,32;
			changequest 7154,7155;
			close;
		}
		mes "[Hooksha]";
		mes "你能再待一会儿吗？";
		mes "你看起来很累，我来帮你恢复体力。";
		mes "遇到困难就回来这里休息吧。";
		npcskill "AL_HEAL",11,99,60;
		percentheal 100,100;
		close;
	}
	if (para_suv01 == 32) {
		mes "[Hooksha]";
		mes "你不是要回伊甸园总部报告吗？";
		mes "我太累了，让我一个人静静。";
		close;
	}
	if (para_suv01 > 32) {
		mes "[Hooksha]";
	mes "嗯？什么兽人？探索地下城？";
	mes "你真是辛苦了。";
		next;
		mes "[Hooksha]";
	mes "这里很适合休息，因为兽人不会来。";
	mes "呼……";
		close;
	}
}

iz_dun04,43,46,3	script	Eden Member Callandiva	745,{
	if (para_suv01 < 33) {
		if (callfunc("F_HasEdenGroupMark")) {
			mes "[Callandiva]";
			mes "你是怎么来到这座海底城市这么深处的？";
			mes "啊，那个标志是我们集团的。";
			mes "你一定是训练生。";
			next;
			mes "[Callandiva]";
			mes "什么？你不是？";
			mes "我……明白了……";
			mes "好吧……继续前进。";
			close;
		}
		mes "[Callandiva]";
		mes "真奇怪，虽然我们在海底，你却仍然能在这里呼吸。";
		mes "你知道为什么吗？";
		next;
		mes "[Callandiva]";
		mes "我想是因为水分充足，我的皮肤才这么柔软。";
		mes "我的手指和脚趾彼此分开，真奇妙。";
		next;
		mes "[Callandiva]";
		mes "伊甸园把我派到这里时，我真的又震惊又害怕。";
		mes "但现在我非常喜欢这里的环境。";
		mes "这里真的很平静……";
		close;
	}
	if (para_suv01 == 33) {
		mes "[Callandiva]";
	mes "你是怎么来到这座海底城市这么深处的？";
	mes "啊，那个标志是我们集团的。";
	mes "你一定是训练生。";
		next;
		mes "[Callandiva]";
	mes "见到你真好！";
	mes "好了，往下看。";
	mes "古老的建筑沉睡在水下。它们本来就是建在海底的。";
		next;
		mes "[Callandiva]";
	mes "如你所知，我们住在这里并没有什么困难。";
	mes "不过你看那边……对，就是那里。";
		next;
		mes "[Callandiva]";
	mes "你能看到那个拿着危险长矛的人鱼吗？";
	mes "它叫人鱼，是非常专业的战士。";
		next;
		mes "[Callandiva]";
	mes "好了，去狩猎 15 只人鱼。";
	mes "这是你在这里的第一个训练任务。";
		set para_suv01,34;
		changequest 7156,7157;
		close;
	}
	if (para_suv01 == 34) {
		if (checkquest(7157,HUNTING) == 2) {
			mes "[Callandiva]";
			mes "哦，你回来了～！";
			mes "那些危险的人鱼怎么样？";
			mes "其实我还以为你会临阵脱逃呢～";
			next;
			mes "[Callandiva]";
			mes "很好，你下一个对手是……～";
			mes "没错，就是这个……";
			mes "那个拿着三叉戟的魔物。";
			next;
			mes "[Callandiva]";
			mes "它的主要能力是魔法。";
			mes "这种魔物叫斯洛福！";
			mes "现在该和真正的魔法师战斗了！";
			next;
			mes "[Callandiva]";
			mes "尽量避开人鱼，狩猎并杀死 10 只斯洛福。";
			set para_suv01,35;
			changequest 7157,7158;
			close;
		}
		mes "[Callandiva]";
		mes "哦，你累了吗？";
		mes "人鱼可不是好对付的对手。";
		mes "我来帮你恢复体力，打起精神来。";
		npcskill "AL_HEAL",11,99,60;
		percentheal 100,100;
		close;
	}
	if (para_suv01 == 35) {
		if (checkquest(7158,HUNTING) == 2) {
			mes "[Callandiva]";
			mes "你已经杀死所有斯洛福了吗？";
			mes "我没想到你真的能做到。";
			mes "我头顶上可是长着眼睛的，哈哈。";
			next;
			mes "[Callandiva]";
			mes "当然，我只是在开玩笑。";
			mes "别那样看我～只是玩笑～！";
			mes "现在你应该放心多了。";
			next;
			mes "[Callandiva]";
			mes "回总部报告吧～";
			mes "你会从伊甸园总部领取最后一套制服。";
			next;
			mes "[Callandiva]";
			mes "这个训练任务是为新手准备的。";
			mes "对你来说可能没什么用，也可能有用。";
			next;
			mes "[Callandiva]";
			mes "总之，你做得非常好！";
			set para_suv01,36;
			changequest 7158,7159;
			close;
		}
		mes "[Callandiva]";
		mes "哦，你累了吗？";
		mes "斯洛福可不是好对付的对手。";
		mes "我来帮你恢复体力，打起精神来。";
		npcskill "AL_HEAL",11,99,60;
		percentheal 100,100;
		close;
	}
	if (para_suv01 >= 36) {
		mes "[Callandiva]";
	mes "我不会再帮助你了。";
	mes "回总部报告这次训练任务吧。";
		close;
	}
	mes "[Callandiva]";
	mes "真奇怪，虽然我们在海底，你却仍然能在这里呼吸。";
	mes "你知道为什么吗？";
	next;
	mes "[Callandiva]";
	mes "我想是因为水分充足，我的皮肤才这么柔软。";
	mes "我的手指和脚趾彼此分开，真奇妙。";
	next;
	mes "[Callandiva]";
	mes "伊甸园把我派到这里时，我真的又震惊又害怕。";
	mes "但现在我非常喜欢这里的环境。";
	mes "这里真的很平静……";
	close;
}

moc_para01,112,96,5	script	Administrator Michael	4_M_RUSMAN1,{
	mes "[Michael]";
	mes "你为什么来这里？";
	next;
	switch (select("领取补给:这里是哪里？:升级装备")) {
		mes "[Michael]";
	case 1:
		if (para_suv01 == 11) {
			mes "如果你完成了第一阶段，";
			mes "我们可以提供伊甸园帽子、制服、披风和靴子。";
			mes "^4d4dff请先检查你的物品栏。^000000";
			next;
			if (select("让我检查物品栏:我的空间足够") == 1) {
				mes "[Michael]";
				mes "请确保有足够空间存放补给。";
				close;
			}
			mes "[Michael]";
			mes "其中两件补给，即^4d4dff帽子和披风^000000，";
			mes "只会发放一次。";
			mes "所以请小心保管。";
			next;
			mes "[Michael]";
			mes "至于靴子和制服，会根据你的课程成绩发放品质更好的装备。";
			next;
			mes "[Michael]";
			mes "伊甸园帽子一顶。";
			mes "伊甸园制服 I 一件。";
			mes "伊甸园靴子 I 一双。";
			mes "伊甸园披风一件。";
			mes "总共 4 件补给，仅此而已。";
			para_suv01 = 12;
			para_suv02 = 1;
			getitem 5583,1; //Para_Team_Hat1
			getitem 2560,1; //Para_Team_Manteau1
			getitem 2456,1; //Para_Team_Boots1
			getitem 15009,1; //Para_Team_Uniform1
			next;
			mes "[Michael]";
			mes "都清楚了吗？";
			mes "这是为新手制造的，效果不是最好，但仍然比商店装备便宜。";
			next;
			mes "[Michael]";
			mes "这是我们专门为伊甸园制作的。";
		}
		else if (para_suv01 == 22) {
			mes "如果你完成了第二阶段，除了基础装备外，我们还会提供额外武器。";
			next;
			mes "[Michael]";
			mes "我们为每个职业选择了合适的武器。";
			mes "不过，有些无法加入我们的职业不在支援范围内。";
			next;
			mes "[Michael]";
			mes "我们不可能制造世上的所有武器，你说对吧？";
			next;
			mes "[Michael]";
			mes "我们会提供 1 件武器、鞋子和制服，总共三件。";
			mes "另外也会为无法使用某些补给的成员提供替代品。";
			next;
			mes "[Michael]";
			mes "^4d4dff请检查物品栏以领取这些物品。^000000";
			next;
			if (select("我会腾出更多空间。:我的空间足够。") == 1) {
				mes "[Michael]";
				mes "请腾出足够空间。";
				close;
			}
			mes "[Michael]";
			if (Class == Job_Swordman || Class == Job_Swordman_High || Class == Job_Knight || Class == Job_Crusader) {
				callsub S_Select,"我们有双手剑和单手剑",
					1192,"伊甸园屠杀者 I","双手剑","攻击力 162","",//P_Slayer1
					13423,"伊甸园军刀 I","单手剑","攻击力 147","这就是我们的目标。";//P_Sabre1
			}
			if (Class == Job_Thief || Class == Job_Thief_High || Class == Job_Assassin || Class == Job_Rogue || Class == Job_Ninja || Class == Job_Novice || Class == Job_Novice_High) {
				callsub S_Select,"",
					13050,"伊甸园短剑 I","短剑","MATK+60，攻击力 124","这就是我们的目标。";//P_Dagger1
			}
			if (Class == Job_Merchant || Class == Job_Merchant_High || Class == Job_Blacksmith || Class == Job_Alchemist) {
				callsub S_Select,"我们有钝器和单手剑",
					13423,"伊甸园军刀 I","单手剑","攻击力 147","这就是我们的目标。",// P_Sabre1
					16004,"伊甸园钝器 I","钝器","攻击力 142","";// P_Mace1
			}
			if (Class == Job_Archer || Class == Job_Archer_High || Class == Job_Hunter || Class == Job_Dancer || Class == Job_Bard) {
				callsub S_Select,"",
					1747,"伊甸园弓 I","弓","攻击力 82","";//P_Bow1
			}
			if (Class == Job_Acolyte || Class == Job_Acolyte_High || Class == Job_Priest || Class == Job_Monk) {
				callsub S_Select,"我们有钝器和法杖",
					16004,"伊甸园钝器 I","钝器","攻击力 142","", //P_Mace1
					1650,"伊甸园法杖 I","法杖","INT+2，MATK+125，攻击力 60",""; //P_Staff1
			}
			if (Class == Job_Mage || Class == Job_Mage_High || Class == Job_Wizard || Class == Job_Sage) {
				callsub S_Select,"",
					1650,"伊甸园法杖 I","法杖","INT+2，MATK+125，攻击力 60","";//P_Staff1
			}
			if (Class == Job_Gunslinger) {
				callsub S_Select,"",
					13112,"伊甸园左轮手枪 I","左轮手枪","HIT-5，攻击力 44","";//P_Revolver1
			}
			if (Class == Job_Summoner) {
				callsub S_Select,"",
					1699,"伊甸园狐尾法杖 I","法杖","MATK+135，攻击力 120","";//P_Foxtail1
			}
			mes "让我看看……你会获得……";
			mes "伊甸园靴子 II 和制服 II。";
			next;
			mes "[Michael]";
			para_suv01 = 23;
			getitem 13050,1; //P_Dagger1
			getitem 2457,1; //Para_Team_Boots2
			getitem 15010,1; //Para_Team_Uniform2
			if (para_suv02 == 0) {
				mes "我不知道哪种武器适合你，所以会给你一把短剑。";
				mes "你没有领取补给的记录，";
				mes "因此也会获得伊甸园帽子和披风。";
				getitem 5583,1; //Para_Team_Hat
				getitem 2560,1; //Para_Team_Manteau
				para_suv02 = 2;
				next;
				mes "[Michael]";
				mes "请再次检查并好好保管补给。";
				close;
			}
			para_suv02 = 2;
			mes "武器、制服和靴子，共 3 件补给。";
			mes "我不知道哪种武器适合你，所以会给你一把短剑。";
			mes "请再次检查。";
			next;
			mes "[Michael]";
		mes "希望它们对你有用。";
		}
		else if (para_suv01 == 37) {
		mes "你已经完成最后的训练课程。";
		mes "现在该领取新武器了。";
			next;
			mes "[Michael]";
		mes "我们有升级版的武器、制服和靴子。";
		mes "不过有些武器只为一转职业制作。";
		mes "所以不能提供给更高阶的职业。";
			next;
			mes "[Michael]";
		mes "^4d4dff请检查物品栏以领取这些补给。^000000";
			next;
			if (select("我会再来。:我的空间足够。") == 1) {
				mes "[Michael]";
				mes "请确保有足够空间。";
				close;
			}
			mes "[Michael]";
			if (Class == Job_Swordman || Class == Job_Swordman_High || Class == Job_Knight || Class == Job_Crusader) {
				callsub S_Select,"我们有双手剑和单手剑",
					13424,"伊甸园军刀 II","单手剑","攻击力 170","",///P_Sabre2
					1193,"伊甸园屠杀者 II","双手剑","攻击力 185","";//P_Slayer2
			}
			if (Class == Job_Thief || Class == Job_Thief_High || Class == Job_Assassin || Class == Job_Rogue || Class == Job_Novice || Class == Job_Novice_High || Class == Job_Super_Novice || Class == Job_Soul_Linker || Class == Job_Ninja) {
				callsub S_Select,"",
					13051,"伊甸园短剑 II","短剑","MATK+70，攻击力 158","";//P_Dagger2
			}
			if (Class == Job_Acolyte || Class == Job_Acolyte_High || Class == Job_Priest || Class == Job_Monk) {
				callsub S_Select,"我们有钝器和法杖",
					16005,"伊甸园钝器 II","钝器","攻击力 163","", //P_Mace2
					1651,"伊甸园法杖 II","法杖","INT+3，MATK+150，攻击力 60",""; //P_Staff2
			}
			if (Class == Job_Archer || Class == Job_Archer_High || Class == Job_Hunter || Class == Job_Dancer || Class == Job_Bard) {
				callsub S_Select,"",
					1748,"伊甸园弓 II","弓","攻击力 82","";//P_Bow2
			}
			if (Class == Job_Mage || Class == Job_Mage_High || Class == Job_Wizard || Class == Job_Sage) {
				callsub S_Select,"",
					1651,"伊甸园法杖 II","法杖","INT+3，MATK+155，攻击力 60","";//P_Staff2
			}
			if (Class == Job_Merchant || Class == Job_Merchant_High || Class == Job_Blacksmith || Class == Job_Alchemist) {
				callsub S_Select,"我们有钝器和单手剑",
					13424,"伊甸园军刀 II","单手剑","攻击力 170","",//P_Sabre2
					16005,"伊甸园钝器 II","钝器","攻击力 163","";// P_Mace2
			}
			if (Class == Job_Gunslinger) {
				callsub S_Select,"",
					13113,"伊甸园左轮手枪 II","左轮手枪","HIT-5，攻击力 60","";//P_Revolver2
			}
			if (Class == Job_Summoner) {
				callsub S_Select,"",
					26100,"伊甸园狐尾法杖 II","法杖","MATK+165，攻击力 135","";//P_Foxtail1
			}
			mes "让我看看……你会获得……";
			mes "伊甸园靴子 III 和制服 III。";
			next;
			para_suv01 = 38;
			getitem 2458,1; //Para_Team_Boots3
			getitem 15011,1; //Para_Team_Uniform3
			mes "[Michael]";
			if (para_suv02 == 0) {
				mes "你没有领取补给的记录，";
				mes "因此也会获得伊甸园帽子和披风。";
				para_suv02 = 3;
				getitem 5583,1; //Para_Team_Hat
				getitem 2560,1; //Para_Team_Manteau
				next;
				mes "[Michael]";
				mes "请再次检查并好好保管补给。";
				close;
			}
			para_suv02 = 3;
			mes "制服和靴子，共 2 件补给。";
			mes "请再次检查。";
			next;
			mes "[Michael]";
			mes "希望它们对你有用。";
		}
		else {
			mes "等等……我来查一下记录……";
			mes "……";
			mes "……嗯……";
			next;
			mes "[Michael]";
			mes "抱歉，我找不到你可以领取补给的记录。";
			mes "你确定吗？";
		}
		close;
	case 2:
		mes "这里存放着伊甸园制作的武器、护甲和其他物品。";
		mes "我们还有很多特殊物品。";
		next;
		mes "[Michael]";
		mes "为了应对紧急情况，我们准备了足够一整支军队使用的装备和补给。";
		mes "坦白说……现在用不上，但如果发生像梦罗克那样的事件，就派得上用场了。";
		next;
		mes "[Michael]";
		mes "你可以到处看看，但不要碰任何东西。";

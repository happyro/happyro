		mes "希望不久后能有机会";
		mes "去拜访他们。";
		break;
	default:
		mes "[Tausupa]";
		mes "欢迎你，冒险者。";
		mes "我是科莫多的首领陶苏帕。";
		mes "科莫多以美景和夜生活闻名。希望你";
		mes "无论是追求刺激还是放松，都能玩得开心～";
		next;
		switch(select("关于赌场:关于被放逐的女巫:取消")) {
		case 1:
			mes "[Tausupa]";
			mes "没错，科莫多的赌场";
			mes "闻名世界。那里有许多";
			mes "可以享受的游戏，不过需要使用";
			mes "赌场特有的尤尔沃货币和兑换系统……";
			break;
		case 2:
			switch (dmdswrd_Q) {
			case 0:
				mes "[Tausupa]";
				mes "被放逐的女巫……？";
				mes "啊哈哈，别担心，";
				mes "朋友，那只是一个";
				mes "非常古老的传说，";
				mes "完全不值得你操心……";
				break;
			case 1:
				mes "[Tausupa]";
				mes "啊，从你衣服上的烤肉味来看，";
				mes "我猜你在营地遇到了";
				mes "罗奇托，对吧？";
				mes "他一定把那个女巫的老故事告诉你了……";
				next;
				mes "[Tausupa]";
				mes "我当然想和他们一起去，";
				mes "但我必须留在这里。女巫确实存在，";
				mes "我的职责之一就是用剑的力量压制她，";
				mes "确保她不会复活。";
				next;
				mes "[Tausupa]";
				mes "虽然我本打算今天去见他们，";
				mes "但职责优先。可以请你";
				mes "把这份调味料带给罗奇托，";
				mes "告诉他我不能去了，";
				mes "并向他道歉吗……？";
				next;
				mes "^3355FF你获得了";
				mes "首领给你的科塞拉塞拉";
				mes "调味料。^000000";
				next;
				mes "[Tausupa]";
				mes "非常感谢……";
				mes "我知道没有科莫多闻名世界的";
				mes "调味料，我的朋友们";
				mes "就无法开始烧烤……";
				set dmdswrd_Q,2;
				break;
			case 2:
				mes "[Tausupa]";
				mes "请把这份特别的科塞拉塞拉调味料";
				mes "带给烧烤营地的朋友";
				mes "^3355FF罗奇托^000000。冒险者，";
				mes "再次感谢你的帮助。";
				break;
			}
			break;
		case 3:
			mes "[Tausupa]";
			mes "也许你看不出来，因为光线的反射方式，";
			mes "但科莫多其实建在一座巨大洞穴里，";
			mes "因此看起来像永远是黑夜。";
			mes "其实非常美丽……";
			next;
			mes "[Tausupa]";
			mes "人们从世界各地来到这里，";
			mes "体验我们独特小村庄的";
			mes "刺激与美丽。";
			mes "我们已经成为很受欢迎的";
			mes "旅游景点了～";
			break;
		}
		break;
	}
	close;
}

comodo,88,97,4	script	Toruna#cmd	109,{
	mes "[Toruna]";
	mes "仔细想想，科莫多有许多";
	mes "有趣的事情。你能相信";
	mes "整座城市都建在天然洞穴里吗？";
	next;
	switch(select("这个洞穴真大！:这里真奇怪……:取消")) {
	case 1:
		mes "[Toruna]";
		mes "哦，这确实是个巨大洞穴，";
		mes "但大自然经过数千、";
		mes "甚至数百万年，";
		mes "并非不能形成这种规模。";
		mes "让我解释一下……";
		next;
		mes "[Toruna]";
		mes "水被称为万能溶剂：";
		mes "流水只要有足够时间，";
		mes "就会在岩石中冲出自己的道路。";
		mes "请记住，这座洞穴";
		mes "曾经是完整的石灰岩。";
		next;
		mes "[Toruna]";
		mes "年复一年的雨水和地下水流动，";
		mes "逐渐侵蚀了这片巨大的石灰岩，";
		mes "清出了如今这片宽阔的";
		mes "开放区域，也就是科莫多洞穴。";
		next;
		mes "[Toruna]";
		mes "听起来或许难以置信，";
		mes "但石灰岩的裂缝经过多年侵蚀，";
		mes "会扩展成断层和宽阔空隙。";
		mes "自然科学是不是很神奇？";
		mes "你一定同意……";
		break;
	case 2:
		switch (dmdswrd_Q) {
		case 5:
			mes "[Toruna]";
			mes "是的，确实相当奇特。";
			mes "另外还有个奇怪的传闻，";
			mes "你听说过科莫多奶酪吗？";
			next;
			mes "[Toruna]";
			mes "这是一个都市传说，说有一种美味奶酪";
			mes "只有在科莫多才能找到。";
			mes "没多少人相信，毕竟制作奶酪";
			mes "需要山羊或奶牛。";
			next;
			mes "[Toruna]";
			mes "不过，有个奇怪的人坚持认为它存在。";
			mes "当地人都把他当成普通疯子，";
			mes "但谁知道呢？也许真的存在……";
			set dmdswrd_Q,6;
			next;
			mes "[Toruna]";
			mes "他是不是疯了，你可以自己判断。";
			mes "我上次见到他时，他在科莫多酒吧，";
			mes "你大概能在那里找到他。";
			break;
		case 6:
			mes "[Toruna]";
			mes "我认为科莫多很独特。";
			mes "这里有些当地人倒是真的奇怪。";
			mes "我已经告诉过你科莫多酒吧里的那个人，";
			mes "对吧？";
			next;
			mes "[Toruna]";
			mes "他一直坚持说科莫多有一种特别的奶酪，";
			mes "在其他地方都买不到。";
			mes "听起来很疯狂，但也许值得验证……";
			break;
		default:
			mes "[Toruna]";
			mes "啊，你知道吗？在成为";
			mes "充满刺激与休闲的异国村庄之前，";
			mes "科莫多曾是邪恶生物的巢穴，";
			mes "由名为梅罗普苏姆的女巫统治。";
			next;
			mes "[Toruna]";
			mes "这名女巫沉睡多年，";
			mes "直到多年前不知为何醒来。";
			mes "她曾严重威胁民众，";
			mes "但最终在著名的女巫之战中被击败。";
			next;
			mes "[Toruna]";
			mes "那场战争的一名英雄成为了";
			mes "村子的现任首领，";
			mes "在他的领导下，科莫多";
			mes "成长为繁荣的旅游景点。";
			next;
			mes "[Toruna]";
			mes "不过梅罗普苏姆的威胁仍然存在，";
			mes "所以探索科莫多地区的";
			mes "无人居住区域时要小心。";
			break;
		}
		break;
	case 3:
		mes "[Toruna]";
		mes "科莫多有许多事情可做，";
		mes "也有许多知识值得了解。";
		mes "我永远不会厌倦参观";
		mes "这座异国风情的城市……";
		break;
	}
	close;
}

comodo,164,291,4	script	Rakusa#cmd	73,{
	switch (dmdswrd_Q) {
	case 6:
		mes "[Rakusa]";
		mes "看到坐在那边的家伙了吗？";
		mes "他整天只会谈论科莫多奶酪，";
		mes "不停念叨那些不可思议的味道。";
		mes "我告诉你，他就是个疯子。";
		next;
		mes "[Rakusa]";
		mes "首先，做奶酪得用牛奶。";
		mes "你在这附近看到奶牛了吗？";
		mes "没有吧，我就知道！";
		mes "不过，我想他真的相信奶酪存在……";
		set dmdswrd_Q,7;
		break;
	case 7:
		mes "[Rakusa]";
		mes "可恶！我当然知道科莫多有奶酪";
		mes "这个想法很疯狂，但那家伙的话";
		mes "让我也好奇起来了！";
		mes "也许真的存在？味道会怎么样呢？";
		break;
	default:
		mes "[Rakusa]";
		mes "你知道，科莫多以高档娱乐闻名，";
		mes "所以人们都忘了我们其实还有";
		mes "两个危险的地下城。";
		next;
		mes "[Rakusa]";
		mes "冒险者探索洞穴时要格外小心，";
		mes "那里的魔物异常强大。";
		mes "在考虑前往之前，务必做好充分准备！";
		break;
	}
	close;
}

comodo,169,284,4	script	Kichiri#cmd	98,{
	switch (dmdswrd_Q) {
	case 7:
		mes "[Kichiri]";
		mes "该死的^3355FF马加图^000000……！";
		mes "他除了科莫多奶酪就不会聊别的吗？";
		mes "我真不明白他为什么那么兴奋！";
		mes "大家都知道那只是老妇人的传说。";
		next;
		mes "[Kichiri]";
		mes "能帮我个忙，让马加图闭嘴吗？";
		mes "我只想安静地喝酒！";
		set dmdswrd_Q,8;
		break;
	case 8:
		mes "[Kichiri]";
		mes "糟糕！马加图现在也让我疑惑了！";
		mes "我是说，我从没见过科莫多奶酪，";
		mes "也不代表它不存在，对吧？";
		mes "可恶！我也开始想这件事了！";
		break;
	default:
		mes "[Kichiri]";
		mes "科莫多不只有赌博可做。";
		mes "有时我喜欢观看村子中央舞台上的舞者。";
		mes "她们真是光彩夺目～";
		next;
		mes "[Kichiri]";
		mes "我听说舞蹈学院只接受女弓箭手";
		mes "作为预备舞者。想想也有道理——";
		mes "她们身材匀称健美，";
		mes "却不会肌肉发达……";
		break;
	}
	close;
}

comodo,163,280,4	script	Magatu#cmd	55,{
	switch (dmdswrd_Q) {
	case 8:
		mes "[Magatu]";
		mes "科莫多奶酪……";
		mes "它真的存在……！";
		mes "我就快拿到证据了！哦……";
		mes "你眼中的那种神情……";
		mes "你、你真的相信我！";
		next;
		mes "[Magatu]";
		mes "终于遇到相信我的人了，";
		mes "而且还是一位冒险者！";
		mes "太好了！听着，你想进一步了解";
		mes "科莫多奶酪，对吧？";
		next;
		mes "[Magatu]";
		mes "我碰巧认识一个人的熟人，";
		mes "他也许能让你亲自尝一尝！";
		mes "他叫^3355FF曼齐^000000，";
		mes "在科莫多赌场里。";
		next;
		mes "[Magatu]";
		mes "哦，对了，差点忘了。";
		mes "拿着我的幸运瓶盖！";
		mes "把它给曼齐看，他就知道是我派你来的，";
		mes "也知道你想进一步了解";
		mes "神秘的科莫多奶酪。";
		next;
		mes "^3355FF你获得了";
		mes "马加图的幸运瓶盖，";
		mes "交给曼齐即可。";
		set dmdswrd_Q,9;
		break;
	case 9:
		mes "[Magatu]";
		mes "哦，别忘了把我的幸运瓶盖";
		mes "给曼齐看，好吗？你可以在科莫多赌场找到他～";
		mes "祝你好运，希望你能尝到科莫多奶酪～";
		break;
	default:
		mes "[Magatu]";
		mes "是真的，它确实存在……";
		mes "科莫多奶酪！";
		mes "如果冒险者们世世代代都在";
		mes "努力寻找它，味道一定美味无比……";
		break;
	}
	close;
}

cmd_in02,189,99,4	script	Manzi#cmd	85,{
	switch (dmdswrd_Q) {
	case 9:
		mes "["+strcharinfo(0)+"]";
		mes "不好意思，我在找一个叫曼齐的人。";
		mes "你知道在哪里能找到他吗？";
		next;
		mes "[Manzi]";
		mes "嘿，我就在这里。";
		mes "你到底想要什么？";
		mes "我、我没惹上什么麻烦吧？";
		next;
		mes "^3355FF你把";
		mes "从马加图那里收到的";
		mes "幸运瓶盖。^000000";
		next;
		mes "[Manzi]";
		mes "哇，马加图把这个给你了？";
		mes "啊，明白了，你一定是在找";
		mes "他一直谈论的科莫多奶酪。";
		mes "好吧，我欠他一个人情，";
		mes "我告诉你该找谁……";
		next;
		mes "[Manzi]";
		mes "从赌场向北走到村子中央，";
		mes "然后看向右边的舞台。";
		mes "你会在那里看到一位老妇人。";
		next;
		mes "[Manzi]";
		mes "别被她的外表骗了——";
		mes "那位老妇人是科莫多最睿智的长者之一。";
		mes "问她关于奶酪的事，";
		mes "告诉她是我派你来的～";
		next;
		mes "[Manzi]";
		mes "啊，如果不给她看这个，她不会认真对待你。";
		mes "马加图给了你幸运瓶盖，";
		mes "所以我把我的幸运硬币给你！";
		mes "那个老妇人会认出它的～";
		next;
		set dmdswrd_Q,10;
		mes "^3355FF你获得了曼齐的";
		mes "‘幸运硬币’。奇怪的是，";
		mes "奇怪的是，硬币两面都是正面。";
		break;
	case 10:
		mes "[Manzi]";
		mes "在科莫多舞台附近找到老妇人，";
		mes "问她关于科莫多奶酪的事，好吗？";
		mes "还有，尽量别冒犯她，行吗？";
		mes "不然我会很丢脸～";
		break;
	default:
		if (Class == Job_Novice) {
			mes "[Manzi]";
			mes "什么……？";
			mes "像你这样的小孩来赌场做什么？";
			mes "虽然不违反规则，";
			mes "但我觉得你还是赶紧去别处玩吧！";
			close;
		}
		mes "[Manzi]";
		mes "嘿，在赌场玩得开心，";
		mes "但别玩得太过火。";
		mes "你总得穿着衣服走出去吧？";
		mes "有些人离开时连这件衣服都没有……";
		break;
	}
	close;
}


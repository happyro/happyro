//===== rAthena Script =======================================
//= Phantasmagorika Quests (episodes 15.1).
//===== Description: =========================================
//= [Official Conversion]
//--- Quests list:
//- Phantasmagorika Main Quest
//- Wandering Bard Quest
//- Police Quests
//- 'New Power Source'
//- 'To Phantasmagorika!'
//- 'Looking for the Traces' (part 2 of 'To Phantasmagorika!')
//===== Changelogs: ==========================================
//= 1.0 Initial release [Capuche]
//= 1.1 Fixed NPC names [zackdreaver]
//= 2.0 Updated using Aegis files [Capuche]
//============================================================

prontera,121,77,3	script	Phantasmagorika Spokesperson#prt::spokesperson	4_F_ZONDAGIRL,4,4,{
	mes "[Spokesperson]";
	mes "你好。";
	mes "雷根贝勒正在为一项位于幻影废墟的挖掘项目招募冒险者。幻影废墟是朱诺佩洛斯新发现的遗迹。";
	next;
	mes "[Spokesperson]";
	mes "如果你感兴趣，直接来就可以了。";
	mes "挖掘所需的一切物资都会由雷根贝勒提供。";
	next;
	mes "[Spokesperson]";
	mes "加入我们，一起探索朱诺佩洛斯的新发现遗迹吧，";
	mes "那是一座古代城市，其科学知识推动了现代文明的发展。";
	next;
	mes "[Spokesperson]";
	mes "如果你想参加，请组建挖掘队并填写申请。";
	next;
	switch( select( "挖掘队？申请？", "幻影废墟？", "再见。" ) ) {
	case 1:
		mes "[Spokesperson]";
		mes "我们正在招募挖掘队，研究新发现的幻影废墟。";
		mes "这项项目需要各个领域的专业知识，所以我们决定招募";
		mes "挖掘队，而不是单独招募个人。";
		next;
		mes "[Spokesperson]";
		mes "你可以报名参加挖掘项目，";
		mes "尽己所能帮助我们。";
		mes "登记的挖掘者可以获得特别福利和物资，";
		next;
		mes "[Spokesperson]";
		mes "作为交换，只需提供你在遗迹中发现的信息。我们会利用这些信息研究遗迹。";
		mes "即使你没找到有用的信息，只要参加了项目，我们也会给予奖励。";
		next;
		mes "[Spokesperson]";
		mes "如果你想参加项目，请前往伊甸园集团提交申请。";
		close;
	case 2:
		mes "[Spokesperson]";
		mes "朱诺佩洛斯刚刚发现了一处古代遗址。";
		mes "它隐藏在一条漫长隧道的尽头。";
		next;
		mes "[Spokesperson]";
		mes "雷根贝勒将遗址命名为 ^4d4dff幻影废墟^000000，";
		mes "并开始了挖掘工作。";
		next;
		mes "[Spokesperson]";
		mes "我们希望找到比朱诺佩洛斯地区以往发现的更先进的魔导机械，以及更高层次的科学知识。";
		close;
	case 3:
		mes "[Spokesperson]";
		mes "雷根贝勒正在为幻影废墟的挖掘寻找有才能的冒险者。";
		mes "随时欢迎加入我们！";
		mes "我们需要你！";
		close;
	}
	end;

OnTouch_:
	.@npc$ = strnpcinfo(2);
	if (getd( "." + .@npc$ ) == 1)
		end;
	setd "." + .@npc$, 1;
	sleep 3000;
	npctalk "发言人：正在为幻影废墟的挖掘招募冒险者。";
	sleep 17000;
	setd "." + .@npc$, 0;
	end;

OnInit:
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "BaseLevel >= 140 && isbegin_quest(7610) == 0" );
	end;
}
morocc,208,287,3	duplicate(spokesperson)	Phantasmagorika Spokesperson#moc	4_F_ZONDAGIRL,4,4
payon,174,113,3	duplicate(spokesperson)	Phantasmagorika Spokesperson#pay	4_F_ZONDAGIRL,4,4
geffen,135,64,3	duplicate(spokesperson)	Phantasmagorika Spokesperson#gef	4_F_ZONDAGIRL,4,4
alberta,119,65,3	duplicate(spokesperson)	Phantasmagorika Spokesperson#alb	4_F_ZONDAGIRL,4,2

moc_para01,31,14,0	script	#atnevt01	HIDDEN_WARP_NPC,1,1,{
	end;
OnTouch:
	if (countitem(6219) < 1 && countitem(22508) < 1)	// Para_Team_Mark, Para_Team_Mark_
		end;
	if (ep15_1_atnad == 0 && BaseLevel > 139) {
		cutin "laime_evenor01.bmp",2;
		mes "[Secretary Lime Evenor]";
		mes "欢迎回来，";
		mes "" + strcharinfo(0) + "。没有你，我们真不知道该怎么撑下去。";
		next;
		mes "[Secretary Lime Evenor]";
		mes "你听说了吗？";
		mes "朱诺佩洛斯刚刚发现了一处古代遗址。";
		mes "雷根贝勒正在招募冒险者挖掘那里，";
		next;
		mes "[Secretary Lime Evenor]";
		mes "我们决定参加这项工作。";
		mes "队长想和你谈谈这件事。";
		next;
		select("我不知道你们还有队长。");
		cutin "laime_evenor02.bmp",2;
		mes "[Secretary Lime Evenor]";
		mes "怎么，你以为这件事是我一个人负责的吗？";
		mes "女主--我是说，队长平时很少对什么事情感到兴奋，而这正是少数例外之一。你应该去见见她。";
		next;
		cutin "laime_evenor01.bmp",2;
		mes "[Secretary Lime Evenor]";
		mes "她的办公室在二楼最左边。";
		ep15_1_atnad = 1;
		setquest 7607;	// Eden Group Leader
		close3;
	}
	end;
}

moc_para01,38,175,5	script	Secretary Lime Evenor#evtat01	4_F_EDEN_OFFICER,{
	if (checkweight(1301,3) == 0) {
		mes "- 你携带的物品太多，无法继续任务。 -";
		close;
	}
	mes "[Secretary Lime Evenor]";
	if (countitem(6219) < 1 && countitem(22508) < 1) {
		cutin "laime_evenor01.bmp",2;
		mes "你需要先加入伊甸园集团。";
		close3;
	}
	if (BaseLevel < 140) {
		cutin "laime_evenor01.bmp",2;
		mes "我有时也会上来这里处理一些事务。";
		mes "其实中央房间是我的。";
		close3;
	}
	switch(ep15_1_atnad) {
	case 0:
		cutin "laime_evenor01.bmp",2;
		mes "欢迎回来，";
		mes "" + strcharinfo(0) + "。没有你，我们真不知道该怎么撑下去。";
		next;
		mes "[Secretary Lime Evenor]";
		mes "你听说了吗？";
		mes "朱诺佩洛斯刚刚发现了一处古代遗址。";
		mes "雷根贝勒正在招募冒险者挖掘那里，";
		next;
		mes "[Secretary Lime Evenor]";
		mes "我们决定参加这项工作。";
		mes "队长想和你谈谈这件事。";
		next;
		select("我不知道你们还有队长。");
		cutin "laime_evenor02.bmp",2;
		mes "[Secretary Lime Evenor]";
		mes "怎么，你以为这件事是我一个人负责的吗？";
		mes "女主--我是说，队长平时很少对什么事情感到兴奋，而这正是少数例外之一。你应该去见见她。";
		next;
		cutin "laime_evenor01.bmp",2;
		mes "[Secretary Lime Evenor]";
		mes "她的办公室在二楼最左边。";
		ep15_1_atnad = 1;
		setquest 7607;// Eden Group Leader
		close3;
	case 1:
	case 2:
		cutin "laime_evenor03.bmp",2;
		mes "队长正在等你。";
		mes "她的办公室就在这里左边最里面。";
		mes "稍后再见。";
		close3;
	case 3:
		cutin "laime_evenor03.bmp",2;
		mes "看来你和队长谈得很顺利。";
		mes "我们去中央房间吧，好吗？";
		mes "有位客人在等我们，";
		mes "要和我们谈些事情。";
		close3;
	case 4:
		cutin "laime_evenor01.bmp",2;
		mes "我会在这里为你加油。";
		mes "不用担心后勤支援。";
		mes "我会确保你得到所需的一切。";
		close3;
	default:
		cutin "laime_evenor01.bmp",2;
		mes "挖掘目前似乎进展顺利。";
		mes "阿特纳德博士感兴趣的物品也在雷根贝勒的关注之中；它应该能得到很高的估价。";
		next;
		mes "[Secretary Lime Evenor]";
		mes "谢谢你帮助博士们专心工作。";
		mes "继续努力。";
		close3;
	}

OnInit:
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "BaseLevel >= 140 && isbegin_quest(7607) == 0 && ep15_1_atnad < 3" );
	end;
}

moc_para01,174,165,3	script	Lime Evenor#atnd02	4_F_EDEN_OFFICER,{
	if (checkweight(1301,3) == 0) {
		mes "- 你携带的物品太多，无法继续任务。 -";
		close;
	}
	mes "[Lime]";
	switch(ep15_1_atnad) {
	case 0:
		cutin "laime_evenor01.bmp",2;
		mes "这里是员工专用房间。";
		mes "如果你需要休息，请使用隔壁房间。";
		break;
	case 1:
	case 2:
		cutin "laime_evenor01.bmp",2;
		mes "队长在隔壁房间。";
		mes "就在左边。";
		mes "请先和队长谈谈。";
		break;
	case 3:
		cutin "laime_evenor01.bmp",2;
		mes "" + strcharinfo(0) + "，请往这边来。";
		mes "让我向你介绍";
		mes "阿特纳德挖掘队的考古学家奥尔斯。";
		next;
		mes "[Lime]";
		mes "奥尔斯博士，这位是" + strcharinfo(0) + "，他会在幻影废墟协助你。";
		next;
		cutin "verus_aures.bmp",0;
		mes "[Aures]";
		mes "很高兴见到你。我叫奥尔斯。";
		mes "我的队员都年老体弱。我们确实需要你这样的年轻人。";
		mes "欢迎加入队伍。";
		next;
		cutin "laime_evenor01.bmp",2;
		mes "[Lime]";
		mes "看来你和队长谈得很顺利。";
		mes "你的工作很简单：";
		mes "只要帮助奥尔斯博士和他的阿特纳德挖掘队。";
		next;
		mes "[Lime]";
		mes "我想你大部分时间都要跑腿，";
		mes "以及做一些需要体力的事情，因为队里的成员都已过了巅峰时期。";
		next;
		cutin "verus_aures.bmp",0;
		mes "[Aures]";
		mes "没错。我们早就都退休了。";
		mes "这次挖掘大概会是我们死前进行的最后一次挖掘。";
		next;
		mes "[Aures]";
		mes "要不是莱姆帮助我们，我们在那个地方的入口处就已经打退堂鼓了。";
		next;
		cutin "laime_evenor01.bmp",2;
		mes "[Lime]";
		mes "请别这么说。";
		mes "你们是我见过最有经验的考古学家。";
		mes "对了，阿特纳德博士怎么样？";
		next;
		cutin "verus_aures.bmp",0;
		mes "[Aures]";
		mes "阿特纳德？别提他了。";
		mes "他和女儿一样固执，甚至有过之而无不及。";
		mes "她一直联系不上父亲，于是变卖了继承的财产后离开了。";
		next;
		mes "[Aures]";
		mes "他多年没有和家人联系。当他得知自己的房子被卖掉后，";
		mes "他大发雷霆并与世隔绝，";
		mes "直到现在仍然在生她的气。";
		next;
		cutin "laime_evenor01.bmp",2;
		mes "[Lime]";
		mes "而我们被夹在他们的心理战中间。";
		next;
		switch( select( "他们是谁？", "请直接说重点。" ) ) {
		case 1:
			cutin "verus_aures.bmp",0;
			mes "[Aures]";
			mes "我来告诉你。莱姆来到我们这里时，";
			mes "我们都很奇怪，像伊甸园集团这样的大公司为什么会支持我们这群乌合之众般的老头。";
			mes "后来我们才发现她们是父女。";
			next;
			select("父女？是谁？");
			cutin "laime_evenor03.bmp",2;
			mes "[Lime]";
			mes "哦，队长没告诉你吗？";
			mes "她的父亲就是阿特纳德挖掘队的队长。";
			next;
			mes "[Lime]";
			mes "我第一次提议参加项目时，";
			mes "她想支持阿特纳德挖掘队。";
			mes "起初我考虑的是合并两支队伍。";
			next;
			mes "[Lime]";
			mes "雷根贝勒负责项目的资金方面，而我们负责人员。";
			mes "后来我才意识到，那支队伍的队长是我上司的父亲。";
			next;
			cutin "laime_evenor04.bmp",2;
			mes "[Lime]";
			mes "我想尽我所能支持这支队伍，";
			mes "但他们糟糕的关系妨碍了这一点。";
			next;
			cutin "verus_aures.bmp",0;
			mes "[Aures]";
			mes "伊恩，我是说老阿特纳德，非常欢迎你的提议。";
			mes "但当他发现你的队长是自己的女儿时，就大发雷霆。";
			next;
			mes "[Aures]";
			mes "我不明白他为什么这么执着。";
			mes "她可是他的女儿啊，真是的。";
			mes "我觉得你应该在他们之间调解。";
			next;
			cutin "laime_evenor01.bmp",2;
			mes "[Lime]";
			mes "我希望这次合作能成为他们彼此和解的机会。";
			mes "好了，我们现在该去遗址了。";
			break;
		case 2:
			cutin "laime_evenor03.bmp",2;
			mes "[Lime]";
			mes "确实。在出发前，我们谈谈在遗址可能遇到的情况吧。";
			break;
		}
		next;
		cutin "laime_evenor03.bmp",2;
		mes "[Lime]";
		mes "奥尔斯，卢克会和你一起去。";
		mes "" + strcharinfo(0) + "，准备好后就可以前往幻影废墟了。";
		next;
		mes "[Lime]";
		mes "那里可以从朱诺佩洛斯进入，";
		mes "所以先前往朱诺，再从那里到达朱诺佩洛斯的入口。";
		next;
		cutin "verus_aures.bmp",0;
		mes "[Aures]";
		mes "雷根贝勒一直在整个大陆宣传这个项目，";
		mes "吸引来的人比你想象的还多。";
		mes "只要寻找人群聚集的地方，就不会错过。到了那里见。";
		next;
		cutin "laime_evenor01.bmp",2;
		mes "[Lime]";
		mes "对你来说一切应该都很容易，";
		mes "不过你必须向雷根贝勒登记，才能参加挖掘。";
		mes "你可以登记为个人挖掘者，但我更希望你以阿特纳德挖掘队成员的身份登记。";
		next;
		mes "[Lime]";
		mes "登记完成后，你就可以开始为阿特纳德挖掘队工作，";
		mes "其他事情都会顺利解决。";
		mes "谢谢你愿意这么做。";
		ep15_1_atnad = 4;
		completequest 7608;// Atnad Excavation Team 1
		setquest 7609;// Atnad Excavation Team 2
		break;
	case 4:
		cutin "laime_evenor01.bmp",2;
		mes "挖掘地点与朱诺佩洛斯相连，";
		mes "所以你应该先前往朱诺佩洛斯。";
		mes "挖掘项目已经广泛宣传，你很容易就能找到负责人。";
		break;
	default:
		cutin "laime_evenor02.bmp", 2;
		mes "挖掘地点的情况怎么样？";
		mes "唉，伊恩为什么就不能原谅自己的女儿呢？";
		break;
	}
	close3;
}

moc_para01,172,164,5	script	Archaeologist Aures#atnd02	4_M_OLDSCHOLAR,{
	if (ep15_1_atnad < 4) {
		cutin "laime_evenor01.bmp",2;
		mes "[Lime]";
		mes "抱歉，他是我们的客人。";
		mes "而且这间办公室只对伊甸园集团员工开放。";
		mes "宿舍就在隔壁。";;
	}
	else if (ep15_1_atnad == 4) {
		cutin "verus_aures.bmp",0;
		mes "[Aures]";
		mes "我们会在挖掘地点再见，对吧？";
		mes "伊甸园集团为我雇了护卫，所以我会和他一起出发。";
		mes "挖掘地点见。";
	}
	else {
		cutin "verus_aures.bmp",0;
		mes "[Aures]";
		mes "哦，你来了。";
		mes "我经常来这里。";
		mes "卢克总是因为我频繁奔波，我真替他感到难过。";
		next;
		mes "[Aures]";
		mes "能有一个随时想来就来的地方真好。我已经很多年没有一个能称为家的地方了。";
		mes "哈哈哈哈！";
		mes "挖掘地点见。";
	}
	close3;
}

moc_para01,178,167,3	script	Luke Lapez#atnd03	4_M_EDEN_GUARDER,{
	mes "[Luke]";
	if (ep15_1_atnad < 4) {
		cutin "looke_rapez02.bmp",0;
		mes "嘿，莱姆。";
		mes "有客人。";
		mes "...";
	}
	else if (ep15_1_atnad == 4) {
		cutin "looke_rapez02.bmp",0;
		mes "...";
		mes "我没什么可对你说的。";
	}
	else {
		cutin "looke_rapez04.bmp",0;
		mes "嗯……";
	}
	close3;
}

ver_eju,114,40,4	script	Manager Michelle#atnd05	4_M_LGTGUARD,{
	if (checkweight(1301,3) == 0) {
		mes "- 你携带的物品太多，无法继续任务。 -";
		close;
	}
	mes "[Manager Michelle]";
	if (ep15_1_atnad < 4) {
		mes "等等。你属于哪支挖掘队？";
		mes "……你是独立挖掘者。";
		mes "你是独立登记的吗？有推荐信吗？";
		next;
		mes "[Manager Michelle]";
		mes "我就知道没有。";
		mes "很抱歉，你必须有推荐信，或者属于某支挖掘队。";
		mes "各种各样的人都来挖掘地点找工作。";
		next;
		mes "[Manager Michelle]";
		mes "哦，对了。^4d4dff伊甸园集团^000000是最容易获得推荐信的地方。";
		mes "如果你符合条件，集团就会为挖掘项目向我们推荐你。";
		next;
		mes "[Manager Michelle]";
		mes "现在，为了你的安全，请退后。";
		close;
	}
	if (ep15_1_atnad == 4) {
		if (checkquest(7611,HUNTING) == -1) {
		mes "等等。";
		mes "你是幻影废墟挖掘项目的参与者吗？";
			next;
			select("是的。");
			mes "[Manager Michelle]";
		mes "让我查一下名单。";
		mes "你的名字是……" + strcharinfo(0) + "。啊，找到了。";
		mes "你确实来自伊甸园集团。";
			next;
			mes "[Manager Michelle]";
		mes "挖掘地点就在这条隧道的另一端。";
		mes "进去后，你必须在中央指挥中心正式登记。";
			next;
			mes "[Manager Michelle]";
		mes "哦，还有件事想请你帮忙。";
		mes "朱诺佩洛斯遗迹的魔物已经迁入隧道，";
		mes "现在越来越难以控制。";
			next;
			mes "[Manager Michelle]";
		mes "你能帮我们处理掉它们吗？包括附近的魔物。";

wolfvill,176,111,3	script	Old Man#hms04	4_EP18_GW_OLD01,{
	if (ep18_main < 36) {
		mes "[Old Man]";
		mes "我得去看看新来的人。";
		close;
	}
	if (isbegin_quest(17504) == 1) {
		mes "[Old Man]";
		mes "这次来的人也必须好好适应。";
		next;
		mes "[Old Man]";
		mes "我们还得再看看。";
		next;
		mes "[Old Man]";
		mes "我来得太频繁，她会不高兴。你觉得这和我们小时候一样吗？";
		next;
		mes "[Old Man]";
		mes "现在，如果你想今后住在这里，就必须融入这里。你必须遵守这里的规则，这样我们才能和谐共处。";
		next;
		mes "[Old Man]";
		mes "不管是否和我们的一样，多一个可以聊天的邻居总是好事。谁不喜欢友善的邻居呢？";

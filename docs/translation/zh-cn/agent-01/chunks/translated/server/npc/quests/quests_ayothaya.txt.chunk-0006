				close;
			}
			mes "[Mali the Spicy]";
		mes "嗯？你把辣椒怎么了？不会是在路上全吃掉了吧？";
			close;
		}
		mes "[Mali the Spicy]";
		mes "嗯……你带的东西太多了。先腾出物品栏空间再回来吧。";
		close;
	}
	emotion ET_KEK;
	mes "[Mali the Spicy]";
	mes "啊……！忙死了，忙死了！客人永远不会厌倦我的冬阴功！嘿嘿嘿～！";
	close;
}

ayothaya,153,86,5	script	Thongpool#ayo	843,{
	if ((MaxWeight-Weight) < 2000 || checkweight(1201,1) == 0) {
		mes "- 等一下！ -";
		mes "- 你现在携带的物品太多了。 -";
		mes "- 请减轻负重后再试。 -";
		close;
	}
	if (tomyumgoong == 2) {
		mes "[Thongpool]";
		mes "冒险者们，来看看！我有很多虾！";
		next;
		mes "[Thongpool]";
		mes "你在找虾，对吧？需要多少？二十只？四十只？";
		next;
		if (select("我需要虾做冬阴功。:呃，看起来很贵。") == 1) {
			mes "[Thongpool]";
			mes "啊！看来辛辣玛丽女士推荐你来找我。你想批量购买，对吧？";
			next;
			mes "[Thongpool]";
			mes "毕竟制作冬阴功需要更多虾。";
			next;
			mes "[Thongpool]";
			mes "制作玛丽女士的冬阴功需要20只虾。我给你折扣：20只虾11,000 Zeny。怎么样？";
			next;
			if (select("我买了。:这么多钱能买100只波利蛋！") == 1) {
				if (Zeny > 10999) {
					if (MaxWeight - Weight > 3999) {
						set Zeny, Zeny-11000;
						set tomyumgoong,3;
						getitem 567,20; //Prawn
						emotion ET_BEST;
						mes "[Thongpool]";
					mes "很好，你现在有村里最新鲜的虾了！回去请玛丽女士为你烹饪吧。";
						close;
					}
					mes "[Thongpool]";
					mes "啊……你带的东西太多了，恐怕无法再携带。";
					close;
				}
				mes "[Thongpool]";
				mes "啊……你的钱不够。";
				close;
			}
			mes "[Thongpool]";
			mes "哎呀……那么多波利蛋也许能填饱肚子，但味道不如我的虾！";
			close;
		}
		mes "[Thongpool]";
		mes "什么……？你觉得贵？但冬阴功的绝妙味道可是无价的！";
		close;
	} else if (tomyumgoong == 3) {
		mes "[Thongpool]";
		mes "嗯……？还需要虾吗？要再买一些吗？";
		next;
		if (select("是的！:不用了，谢谢。") == 1) {
			if (Zeny > 10999) {
				if (MaxWeight - Weight > 3999) {
					set Zeny, Zeny-11000;
					getitem 567,20; //Prawn
					mes "[Thongpool]";
					mes "给你～这是本村、也许全世界最新鲜的虾！";
					close;
				}
				mes "[Thongpool]";
				mes "啊……你带的东西太多了，恐怕无法再携带。";
				close;
			}
			mes "[Thongpool]";
				mes "啊……你的钱不够。";
			close;
		}
		mes "[Thongpool]";
		mes "很好，你拿到了村里最新鲜的虾！回去请玛丽女士为你烹饪吧。";
		close;
	}
	mes "[Thongpool]";
	mes "欢迎，欢迎！我有世界上最清澈水域捕捞的极品虾～！";
	close;
}

ayothaya,121,240,7	script	Mr. Jun#ayo	842,1,1,{
	if (MaxWeight - Weight < 2000 || checkweight(1201,1) == 0) {
		mes "- 请稍等！-";
		mes "- 你当前携带的物品 -";
		mes "- 太多了。-";
		mes "- 请减轻负重 -";
		mes "- 然后重试。 -";
		close;
	}
	if (tomyumgoong == 5) {
		emotion ET_SWEAT;
		mes "[Mr. Jun]";
		mes "嗯……？你不需要更多柠檬吗？";
		mes "又来了，是吗？";
		next;
		switch(select("不用。:老人家，给我柠檬！:请再给我一些柠檬，好吗？")) {
		case 1:
			emotion ET_DELIGHT;
			mes "[Mr. Jun]";
			mes "那就尝尝我上次给你的柠檬吧？很酸，但也非常美味！";
			close;
		case 2:
			emotion ET_FRET;
			mes "[Mr. Jun]";
		mes "什么……？！你怎么了，孩子？我上次给你的柠檬呢？";
			close;
		case 3:
			mes "[Mr. Jun]";
		mes "哦，抱歉……最近我的柠檬储藏被神社附近游荡的^3131FF树叶猫^000000袭击了。";
			next;
			mes "[Mr. Jun]";
		mes "我也想帮你，但连做生意的柠檬都不够。如果你需要，就去狩猎获取吧？";
			close;
		}
	}
	mes "[Mr. Jun]";
	mes "...";
	close;

OnTouch_:
	if (MaxWeight - Weight < 2000 || checkweight(1201,1) == 0) {
		mes "- 请稍等！ -";
		mes "- 你当前携带的物品 -";
		mes "- 太多了。-";
		mes "- 请减轻负重 -";
		mes "- 然后重试。 -";
		close;
	}
	if (tomyumgoong == 4) {
		mes "[Mr. Jun]";
		mes "你好？需要帮忙吗……？";
		emotion ET_SCRATCH;
		next;
		if (select("我需要一些柠檬。:不用了，谢谢。") == 1) {
			mes "[Mr. Jun]";
		mes "嗯……柠檬？如你所见，我树上有很多柠檬。你真的需要吗？";
			next;
				if (select("好的，我会付钱。:不用了，谢谢。") == 1) {
				mes "[Mr. Jun]";
				mes "我把柠檬树当作爱好种植，没想到收获了这么多香甜多汁的柠檬。";
				next;
				mes "[Mr. Jun]";
				mes "你刚才说要付钱买柠檬？哦，你误会了，我不打算卖。";
				next;
				mes "[Mr. Jun]";
				mes "但是……我很愿意分一些给你，不过前提是你能……";
				next;
				mes "[Mr. Jun]";
				mes "和我玩个小游戏！怎么样？我无聊得要死。像我这样的老人也需要娱乐！";
				next;
				mes "[Mr. Jun]";
				mes "哈哈哈哈～！你觉得呢？想试试吗？";
				next;
				if (select("当然，为什么不呢！:不用了，谢谢。") == 1) {
					mes "[Mr. Jun]";
				mes "很好！我们要玩的游戏很简单，是儿童游戏。";
					next;
					mes "[Mr. Jun]";
					mes "^660000石头、";
				mes "石头、剪刀、布！^000000也许你听说过。";
					mes "你们那里也有这种游戏。";
					emotion ET_SCISSOR;
					next;
					mes "[Mr. Jun]";
					mes "别那样看我。我是老人，也想玩游戏重温青春。等你到我这个年纪就懂了。";
					next;
					mes "[Mr. Jun]";
					mes "好，如果你赢了，";
					mes "^3131FF5^000000 局中赢得 ^3131FF3^000000 局，";
					mes "柠檬就归你。准备好了吗？";
					next;
					mes "[Mr. Jun]";
					mes "好……用你们年轻人的说法，";
					mes "^990000让我们挑战极限！^000000";
					next;
					set @user_score,0;
					set @pc_score,0;
					mes "[Mr. Jun]";
					mes "石头！布！剪刀！";
					next;
					while(1) {
						if (@pc_score == 5 || @user_score == 3) {
							break;
						}
						else {
							set .@jun_mark,rand(1,3);
								switch(select("剪刀:石头:布")) {
							case 1:
								if (.@jun_mark == 1) {
									emotion ET_SCISSOR;
									emotion ET_SCISSOR, playerattached();
									mes "[Mr. Jun]";
								mes "哼。平局。再来一次！石头！布！剪刀！";
									next;
								}
								else if (.@jun_mark == 2) {
									emotion ET_ROCK;
									emotion ET_SCISSOR, playerattached();
									set @pc_score,@pc_score + 1;
									mes "[Mr. Jun]";
								mes "是的……！天啊，太好了！";
									next;
								}
								else {
									emotion ET_WRAP;
									emotion ET_SCISSOR, playerattached();
									set @pc_score,@pc_score + 1;
									set @user_score,@user_score + 1;
									mes "[Mr. Jun]";
									mes "什么……？我不敢相信！呸！";
									next;
								}
								break;
							case 2:
								if (.@jun_mark == 1) {
									emotion ET_SCISSOR;
									emotion ET_ROCK, playerattached();
									set @pc_score,@pc_score + 1;
									set @user_score,@user_score + 1;
									mes "[Mr. Jun]";
									mes "不……！亵渎！";
									next;
								}
								else if (.@jun_mark == 2) {
									emotion ET_ROCK;
									emotion ET_ROCK, playerattached();
									mes "[Mr. Jun]";
									mes "哼。平局。再来一次！石头！布！剪刀！";
									next;
								}
								else {
									emotion ET_WRAP;
									emotion ET_ROCK, playerattached();
									set @pc_score,@pc_score + 1;
									mes "[Mr. Jun]";
									mes "哇哈哈哈！你输了，小鬼！";
									next;
								}
								break;
							case 3:
								if (.@jun_mark == 1) {
									emotion ET_SCISSOR;
									emotion ET_WRAP, playerattached();
									set @pc_score,@pc_score + 1;
									mes "[Mr. Jun]";
									mes "嘿嘿～年轻的笨蛋！";
									next;
								}
								else if (.@jun_mark == 2) {
									emotion ET_ROCK;
									emotion ET_WRAP, playerattached();
									set @user_score,@user_score + 1;
									set @pc_score,@pc_score + 1;
									mes "[Mr. Jun]";
									mes "不——！不可能！";
									next;
								}
								else {
									emotion ET_WRAP;
									emotion ET_WRAP, playerattached();
									mes "[Mr. Jun]";
								mes "哼。平局。再来一次！石头！布！剪刀！";
									next;
								}
								break;
							}
						}
					}
					if (@user_score == 3) {
						emotion ET_HNG;
						mes "[Mr. Jun]";
						mes "你……赢了。";
						mes "我太累了。看来我再也比不过你们年轻人了。哈哈哈！";
						next;
						mes "[Mr. Jun]";
						mes "如约，我会分一些柠檬给你。想拿多少就拿吧！";
				mes "^3355FF你从树上摘下了";
						mes "10 个柠檬。^000000";
						set tomyumgoong,5;
						getitem 568,10; //Lemon
						next;
						emotion ET_THINK;
						mes "[Mr. Jun]";
						mes "嗯……";
						mes "看来你需要很多。没关系，我和你玩得很开心。";
						next;
						mes "[Mr. Jun]";
						mes "不过别忘了：不要自私，要和他人分享拥有的东西。这是人类最重要的价值之一。";
						close;
					}
					emotion ET_SCISSOR;
					mes "[Mr. Jun]";
					mes "呜哈哈哈哈！胜利属于我！看来你暂时拿不到柠檬了！随时欢迎挑战我！";
					close;
				}
				mes "[Mr. Jun]";
				mes "害怕了吗？你骗不了我：我可是游戏高手！";
				close;
			}
			mes "[Mr. Jun]";
			mes "嗯……";
			mes "这么多柠檬，";
			mes "我到底能";
			mes "拿它们";
			mes "做什么呢？";
			close;
		}
		mes "[Mr. Jun]";
		mes "随时都可以";
		mes "来找我帮忙，";
		mes "好吗？";
		close;
	}
	mes "[Mr. Jun]";
	mes "...";
	close;
}

ayothaya,213,94,7	script	Merchant#ayo	841,{
	if (tomyumgoong == 6) {
		mes "[Merchant Thongdum]";
		mes "你好～";
		mes "你是在寻找";
		mes "制作冬阴功汤的";
		mes "材料吗？";
		next;
		mes "[Merchant Thongdum]";
		mes "让我看看……";
		mes "我这里有辣椒、鱼露，";
		mes "还有你需要的";
		mes "香料和调味料。";
		mes "全部只要 2,000 Zeny。";
		next;
		if (select("谢谢，我要了。:太贵了吧！") == 1) {
			emotion ET_THANKS;
			if (Zeny > 1999) {
				if (MaxWeight - Weight > 1199) {
					set Zeny, Zeny-2000;
					set tomyumgoong,7;
					getitem 7286,30; //Chilli
					mes "[Merchant Thongdum]";
					mes "谢谢。";
					mes "希望你喜欢";
					mes "自己做的冬阴功汤～";
					close;
				}
				mes "[Merchant Thongdum]";
				mes "糟糕……";
				mes "看起来你现在";
				mes "携带的东西";
				mes "太多了。";
				mes "请先清理背包。";
				next;
				mes "[Merchant Thongdum]";
				mes "没有足够空间的话，";
				mes "我没法给你";
				mes "任何东西！";
				close;
			}
			mes "[Merchant Thongdum]";
			mes "嗯……？";
			mes "现在看来，";
			mes "你没有足够的钱购买";
			mes "需要的材料。";
			close;
		}
		emotion ET_STARE_ABOUT;
		mes "[Merchant Thongdum]";
		mes "别这么说。";
		mes "我的价格一直很合理。";
		mes "我可是正经商人，";
		mes "希望你能明白。";
		close;
	} else if (tomyumgoong == 7) {
		mes "[Merchant Thongdum]";
		mes "我本以为给你的材料够多了，";
		mes "不过仔细想想，";
		mes "我还不知道你要做多少份";
		mes "冬阴功汤。";
		mes "我们再确认一下吧。";

//===== rAthena Script =======================================
//= Lost Farm in Time
//===== Description: =========================================
//= [Walkthrough Conversion]
//= Episode 17.2 Lost Farm in Time
//===== Changelog: ===========================================
//= 1.0 Initial release [crazyarashi]
//= 1.1 Optimizations and cleanup [Everade]
//= 1.2 Cleanup [Capuche]
//============================================================

ba_maison,311,206,3	script	Luina#greeen	4_EP17_BASIC_B,{
	if (checkweight(1000103,20) == 0) {
		mes "- 你携带的物品太多，无法继续任务。-";
		close;
	}
	if (BaseLevel < 150) {
		mes "[Cotton]";
		mes "嗯，你看起来太虚弱，无法工作。我想你现在还做不到。";
		next;
		mes "- 本任务需要 150 级或以上 -";
		close;
	}
	if (ep17_2_main < 9) {
		mes "- 我在农场设施前与自动人偶对视了。-";
		next;
		mes "- 人偶上下打量我，然后转过了头。-";
		close;
	}
	if (isbegin_quest(8586) == 0) {
		mes "- 我在农场设施前与自动人偶对视了。-";
		next;
		mes "[Automatic Doll]";
		mes "心率、血压和体温均正常。";
		mes "呼吸正常，眼球稳定性正常。";
		mes "正在检查登记信息……";
		next;
		mes "- 人偶上下打量我，看起来很满意。-";
		next;
		mes "[Automatic Doll]";
		mes "你好，" + strcharinfo(0) + "？";
		mes "你是来看农场设施的吗？";
		npctalk "喵。", "Kitty#greeen", bc_self;
		next;
		if (select( "嗯？", "不是。" ) == 2) {
			mes "[Automatic Doll]";
			mes "这里是农场设施，基蒂和其他伙伴都住在这里。";
			mes "如果你感兴趣，和我聊聊吧。";
			mes "我会向你解释一切。";
			close;
		}
		mes "[Automatic Doll]";
		mes "基蒂，先安静一会儿。乖孩子~";
		mes "我负责管理这里的农场设施。";
		mes "我照料植物、施肥，也负责喂这里的基蒂和他的朋友们。";
		npctalk "呼噜。", "Kitty#greeen", bc_self;
		next;
		mes "[Automatic Doll]";
		mes "餐厅甜点所需的原料就是在这里收获的。";
		mes "咳咳。";
		next;
		mes "[Automatic Doll]";
		mes "最近客人很多，所以我们接到了更多收获订单。";
		mes "我的同事刚从其他岗位调到这里，但她有点笨手笨脚。";
		mes "大家都听从安排的话，就很容易获得好收成。";
		next;
		select( "你真健谈。" );
		mes "[Luina]";
		mes "哦，我忘了如果想和客人聊这么久，应该先自我介绍。";
		mes "我叫露伊娜。";
		next;
		mes "[Luina]";
		mes "这里的基蒂是一种叫火龙果的植物，是曾经生活在这座岛某处的古代物种改良品种。";
		mes "不知道这算不算奇怪，我虽然不是火龙果，却很擅长倾听。";
		next;
		mes "- 露伊娜抚摸着火龙果。-";
		npctalk "呼噜。", "Kitty#greeen", bc_self;
		next;
		mes "[Luina]";
		mes "师父告诉我，应该给可爱的小东西取名字。";
		mes "基蒂、蝴蝶、快乐等等。";
		mes "火龙果是一种小巧可爱的生物，所以我给它取了名字。";
		next;
		mes "[Luina]";
		mes "基蒂是最可爱的，这里的火龙果就叫基蒂。";
		next;
		mes "[Luina]";
		mes "所以……";
		mes "你是来剪掉一些尾巴的吗？";
		next;
		select( "尾巴？", "我没有尾巴。" );
		mes "[Luina]";
		mes "你是来剪尾巴的，对吧？";
		mes "哦，是我搞错了。";
		mes "请稍等，我整理一下说明。";
		setquest 8586;
		close;
	}
	if (isbegin_quest(8586) == 1) {
		mes "[Luina]";
		mes "你现在看看基蒂，它没有根，对吧？";
		mes "即使没有根，它也能从空气中吸收水分并进行光合作用。";
		mes "只需要一些肥料……以及食物。";
		next;
		mes "[Luina]";
		mes "种下种子后，它们会从地面长出来，但我以前从没见过多头芽。";
		next;
		mes "[Luina]";
		mes "至于尾巴，只要抓住火龙果，像这样抚摸它，然后放开就行。";
		next;
		mes "- 露伊娜拿起火龙果，示范如何拉尾巴并将它放下。-";
		next;
		mes "[Luina]";
		mes "不，不是这样的。我没有拉它。";
		mes "收获的尾巴不一定足够食用。";
		mes "你必须把损耗考虑进去。";
		npctalk "咯咯……！", "Kitty#greeen", bc_self;
		next;
		mes "[Luina]";
		mes "你需要去除种子和外皮，但并不困难。";
		mes "处理后，将收获的火龙果尾巴放到桌上。";
		next;
		mes "[Luina]";
		mes "收获其实有点困难，所以我的同事‘丝绸’会指导你。";
		mes "即使不收获也可以进入。我会让你在没有向导的情况下进去。";
		next;
		mes "[Luina]";
		mes "如果你有空，就和这里的‘棉花’谈谈，她是游戏管理员，会告诉你该做什么。";
		mes "我知道这对你来说有点辛苦，但是……如果你愿意帮忙，我们会给你应有的报酬。";
		npctalk "Cotton：希望能再高一点……", "Cotton#172_lost_0", bc_self;
		next;
		mes "[Luina]";
		mes "既然你已经听过说明，现在可以进去了。";
		mes "如果只是想四处看看，直接进去就好。";
		next;
		mes "[Luina]";
		mes "我们先谈了棉花的工作，但实际上收获更加紧急。";
		mes "如果你对自己的战斗能力有信心，我希望你能帮忙收获。";
		mes "希望你能帮我完成收获……";
		mes "我们还必须喂饱基蒂老大。";
		next;
		select( "基蒂老大？" );
		mes "[Luina]";
		mes "我只是这么称呼它。它和其他同伴有些不同，藏在不容易看见的地方。";
		mes "如果你想在附近看到它，就要撒些食物，让农场周围稍微热闹一点。";
		next;
		mes "[Luina]";
		mes "我负责收获，所以随时都可以来找我！";
		completequest 8586;
		next;
		mes "[Luina]";
		mes "你想帮忙时，我们再谈具体细节。";
		close;
	}
	if (isbegin_quest(8589) == 1) {
		mes "[Luina]";
		mes "那些小家伙来和你玩吗？";
		mes "真奇怪……我听得很清楚。";
		mes "……什么？连丝绸也是？";
		mes "发生什么事了？";
		next;
		select( "她在假装猫。" );
		emotion ET_FRET, getnpcid(0,"Kitty#greeen");
		mes "[Kitty]";
		mes "咯咯。";
		next;
		mes "-- 猫在露伊娜够到它之前躲到了她身后。--";
		next;
		mes "[Luina]";
		mes "什么……";
		next;
		mes "[Luina]";
		mes "也许……只是也许？";
		mes "它在听我说话？";
		next;
		select( "我想是吧。" );
		mes "[Luina]";
		mes "基蒂。";
		npctalk "*低吼*", "Kitty#greeen", bc_self;
		next;
		mes "[Luina]";
		mes "...";
		mes "这就是客人们所说的‘害羞’吗？";
		npctalk "*呱呱*", "Kitty#greeen", bc_self;
		next;
		mes "- 露伊娜向猫伸出手时，猫把头凑到了她的手上。-";
		next;
		mes "- 抚摸猫时，露伊娜露出了满足而复杂的表情。-";
		next;
		mes "[Luina]";
		mes "嗯……";
		mes "客人总有一天也能和喵喵成为朋友吧？";
		next;
		mes "[Luina]";
		mes "如果我们继续这样和它们玩，一定会很棒吧？";
		npctalk "*呱呱*", "Kitty#greeen", bc_self;
		next;
		mes "[Luina]";
		mes "是的！明天也请继续帮助丝绸。";
		mes "这样总有一天……你就能和所有火龙果成为朋友了！";
		mes "给你……这是约定的信物。";
		completequest 8589;
		getitem 1000103,20;
		getexp 3094009,0;
		next;
		mes "[Luina]";
		mes "大概吧。";
		npctalk "嘎嘎。", "Kitty#greeen", bc_self;
		next;
		mes "- 猫兴奋地发出尖锐叫声。-";
		next;
	}
	switch( checkquest(8587,PLAYTIME) ) {
	case -1:
		break;
	case 0:
	case 1:
		mes "[Luina]";
		mes "今天所需的收获已经完成。";
		mes "我们会在黎明时继续收获。到时候再回来吧。";
		close;
	case 2:
		mes "[Luina]";
		mes "^0000FF我们与火龙果的苦战仿佛已经是很久以前的事了。^000000";
		mes "^0000FF我现在又有勇气回到农场设施了。^000000";
		erasequest 8587;
		close;
	}
	.@party_id = getcharid(1);
	if (.@party_id < 1) {
		mes "^FF0000你必须至少组织一名成员，或加入队伍才能进入。^000000";
		close;
	}
	.@md_name$ = "Farm Lost in Time";

	setarray .@item[0],1000093,1000094,1000095,1000096,1000097,1000098;
	for ( .@i = 0; .@i < 6; ++.@i ) {
		if (countitem(.@item[.@i]) > 0) {
			.@count = 1;
			delitem .@item[.@i], countitem(.@item[.@i]);
		}
	}
	if (.@count > 0) {
		mes "[Luina]";
		mes "！？发生什么事了？你的尾巴断了。";
		mes "请交给我处理。";
		mes "谢谢……完成下一次收获后，记得把它交给丝绸，然后出来。";
		next;
	}
	mes "[Luina]";
	mes "你好，" + strcharinfo(0) + "。";
	mes "你今天要进入农场设施吗？";
	next;
	switch( select( (is_party_leader() ? "创建 " + .@md_name$ : ""), "进入副本。", "取消" ) ) {
	case 1:
		if (instance_create(.@md_name$) == -3)
			dispbottom "副本“" + .@md_name$ + "”预约失败，因为已有正在进行的副本。";
		mes "[Luina]";
		mes "请稍等片刻~";
		mes "我会准备今天的食物。";
		close;
	case 2:
		if (instance_enter(.@md_name$) != IE_OK) {
			mes "^FF0000副本尚未创建。^000000";
			close;
		}
		setquest 8587;
		if (isbegin_quest(8588) > 0)
			erasequest 8588;
		setquest 8588;
		mapannounce "ba_maison", "" + strcharinfo(0) + "所在的队伍" + .@party_name$ + "正在进入" + .@md_name$ + "。", bc_map, "0x00FF99";
		end;
	case 3:
		end;
	}
	end;

OnInit:
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "checkquest(8587,PLAYTIME) == -1" );	// condition on ep17_2_main not required
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "checkquest(8587,PLAYTIME) == 2" );
	end;
}


1@lost,1,1,0	script	#lost_farm_control	-1,{
	end;
OnInstanceInit:
	'lost_farm = 0;
	deletearray 'banghae;
	'map_lost$ = instance_mapname("1@lost");
	end;
}

1@lost,161,40,0	script	#startline	HIDDEN_WARP_NPC,5,5,{
	end;
OnTouch:
	if (!is_party_leader())
		end;
	disablenpc();
	'lost_farm = 0;
	enablenpc instance_npcname("Wooden Box#01");
	npctalk "哦！客人！到这边来！！", instance_npcname("Wooden Box#01");
	end;
}

1@lost,163,47,3	script(DISABLED)	Wooden Box#01	4_WOODBOX,{
	if (!is_party_leader()) {
		mes "[Silk]";
		mes "我会和客人的领队交谈！";
		mes "请把领队带到这里！";
		close;
	}
	if ('lost_farm == 0) {
		mes "[Silk]";
		mes "欢迎来到饲养场！我是负责收集的丝绸！";
		npctalk "Silk：欢迎来到饲养场！我是负责收集的丝绸！";
		next;
		mes "[Silk]";
		mes "呀……救救我！";
		npctalk "Silk：呀……救救我！";
		close2;
		if ('lost_farm == 0) {
			'lost_farm = 1;
			donpcevent instance_npcname("Wooden Box#01") + "::OnStart";
		}
		end;
	}
	npctalk "Silk：让火龙果冷静下来！";
	end;

OnStart:
	sleep 1000;
	.@event$ = instance_npcname("Wooden Box#01") + "::OnMobDead";
	monster 'map_lost$,155,43,"King Eyes",20660,1, .@event$;
	monster 'map_lost$,154,50,"Happy",20664,1, .@event$;
	monster 'map_lost$,158,49,"Toto",20661,1, .@event$;
	monster 'map_lost$,162,48,"Lightning",20662,1, .@event$;
	monster 'map_lost$,168,49,"Cutie",20660,1, .@event$;
	monster 'map_lost$,170,45,"Woody",20663,1, .@event$;
	monster 'map_lost$,165,42,"Rusk",20664,1, .@event$;
	end;
OnMobDead:
	if (mobcount('map_lost$, instance_npcname("Wooden Box#01") + "::OnMobDead") == 0) {
		'lost_farm = 2;
		disablenpc();
		enablenpc instance_npcname("Silk#01");
		sleep 1000;
		npctalk "丝尔克：！！", instance_npcname("Silk#01");
	}
	end;
}


1@lost,163,47,3	script(DISABLED)	Silk#01	4_EP17_BASKET,{
	if (!is_party_leader()) {
		mes "[Silk]";
		mes "我会和客人的领队交谈！";
		mes "请把领队带到这里！";
		close;
	}
	if ('lost_farm != 2)
		end;
	mes "[Silk]";
		mes "谢谢你救了我的命！听露伊娜说，火龙果是温顺的生物！";
		npctalk "Silk：谢谢你救了我的命！听露伊娜说，火龙果是温顺的生物！";
	next;
	mes "[Silk]";
		mes "你也看到了吧！我好害怕！";
		npctalk "Silk：你也看到了吧！我好害怕！";
	next;
	mes "[Silk]";
		mes "每只都要喂食和拥抱五分钟？它们一直露出牙齿，我怎么抚摸？";
		npctalk "Silk：每只都要喂食和拥抱五分钟？它们一直露出牙齿，我怎么抚摸？";
	next;
	mes "[Silk]";
		mes "五分钟内还要做什么！";
		npctalk "Silk：五分钟内还要做什么！";
	next;
	mes "[Silk]";
	mes "...";
		npctalk "Silk：……";
	next;
	mes "[Silk]";
		mes "亲爱的客人……";
		npctalk "Silk：亲爱的客人……";
	next;
	mes "[Silk]";
		mes "我明白露伊娜为什么要找更多工人，因为她一个人无法快速完成收获。";
		npctalk "Silk：我明白露伊娜为什么要找更多工人，因为她一个人无法快速完成收获。";
	next;
	mes "[Silk]";
		mes "不过，像你刚才那样抱住它和它玩，会比抚摸五分钟更快。";
		npctalk "Silk：不过，像你刚才那样抱住它和它玩，会比抚摸五分钟更快。";
	next;
	mes "[Silk]";
		mes "……虽然我没办法抱住它。";
		npctalk "Silk：……虽然我没办法抱住它。";
	next;
	mes "[Silk]";
		mes "我们去下一个栖息地，就在附近。准备好了吗？出发！";
		npctalk "Silk：我们去下一个栖息地，就在附近。准备好了吗？出发！";
	close2;
	if ('lost_farm == 2) {
		'lost_farm = 3;
		disablenpc();
		enablenpc instance_npcname("Silk#02");
		instance_warpall 'map_lost$,218,149,instance_id();
	}
	end;
}


1@lost,214,146,3	script(DISABLED)	Silk#02	4_EP17_BASKET,{
	if (!is_party_leader()) {
		mes "[Silk]";
		mes "我会和客人的领队交谈！";
		mes "请把领队带到这里！";
		close;
	}
	if ('lost_farm == 3) {
		mes "[Silk]";
		mes "这个设施……如你所见，这是我们鳞片朋友方便的饲养场。";
		npctalk "Silk：这个设施……如你所见，这是我们鳞片朋友方便的饲养场。";
		next;
		mes "[Silk]";
		mes "无论是植物还是动物，这里的温度和湿度都始终恒定。";
		npctalk "Silk：无论是植物还是动物，这里的温度和湿度都始终恒定。";
		next;
		mes "[Silk]";
		mes "听说这里对人类不太舒服，呼吸感觉怎么样？";
		npctalk "Silk：听说这里对人类不太舒服，呼吸感觉怎么样？";
		next;
		mes "[Silk]";
		mes "现在我也要在这里撒些食物。赶快把事情办完吧，我去躲起来……";
		npctalk "Silk：现在我也要在这里撒些食物。赶快把事情办完吧……我去躲起来。";
		next;
		mes "[Silk]";
		mes "嘿……大家，吃能量棒和米饭的时间到了~";
		npctalk "Silk：嘿……大家，吃能量棒和米饭的时间到了~";
		close2;
		if ('lost_farm == 3) {
				'lost_farm = 4;
			npctalk "Silk：我已经撒好食物了，它们很快就会出现！";
			disablenpc();
			donpcevent instance_npcname("Wooden Box#02") + "::OnStart";
		}
		end;
	}
	if ('lost_farm == 4) {
		mes "[Silk]";
		mes "哈啊，哈啊……吓死我了……";
		npctalk "Silk：哈啊，哈啊……吓死我了……";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "你确定现在不是在玩耍吗？";
		unittalk getcharid(3), "" + strcharinfo(0) + "：你确定现在不是在玩耍吗？";
		next;
		mes "[Silk]";
		mes "我觉得这样对它们才对。我之前说过，只有心情好的时候它们才会产出尾巴。";
		npctalk "Silk：我觉得这样对它们才对。我之前说过，只有心情好的时候它们才会产出尾巴。";
		next;
		mes "[Silk]";
		mes "对了，我们要去下一个地点吗……？还没结束，所以……";
		npctalk "Silk：对了，我们要去下一个地点吗……？还没结束，所以……";
		next;
		mes "[Silk]";
		mes "下一个是有岩石和沙子的游乐场。收获时，我必须先抖掉沙子……";
		npctalk "Silk：下一个是有岩石和沙子的游乐场。收获时，我必须先抖掉沙子……";
		close2;
		if ('lost_farm == 4) {
			'lost_farm = 5;
			disablenpc();
			enablenpc instance_npcname("Silk#03");
			instance_warpall 'map_lost$,86,101,instance_id();
		}
		end;
	}
	end;
}

1@lost,214,146,3	script(DISABLED)	Wooden Box#02	4_WOODBOX,{
		npctalk "Silk：救救我！我要被火龙果吃掉了！";
	end;
OnStart:
	enablenpc();
	sleep 1000;

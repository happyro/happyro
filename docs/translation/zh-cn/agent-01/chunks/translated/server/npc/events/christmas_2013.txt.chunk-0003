		emotion ET_THROB, getnpcid(0, "Succubus#xmas");
		next;
		mes "[Dark Lord]";
		mes "即使我下达艰难命令，你仍然忠诚。你应得奖励。现在想要什么？我一定会为你实现，甚至能给你更多力量！";
		next;
		mes "[Succubus]";
		mes "......";
		mes "你真的能给我任何想要的东西吗……？";
		next;
		mes "[Succubus]";
		mes "我真正需要的是……";
		mes "......";
		mes "只有你，我的主人。";
		next;
		mes "[Dark Lord]";
		mes "......";
		mes "?!!!!!";
		next;
		mes "[Succubus]";
		mes "我爱上你……";
		mes "已经很久了……";
		next;
		mes "[Dark Lord]";
		mes "......";
		next;
		mes "[Dark Lord]";
		mes "我并不是不知道这件事。";
		next;
		mes "[Dark Lord]";
		mes "我也……";
		next;
		mes "[Dark Lord]";
		mes "……但我们是恶魔。恶魔选择通往爱情的道路？！太荒唐了，黑暗世界绝不会原谅我们！我们将躲藏一生！";
		next;
		mes "[Succubus]";
		mes "只要和你在一起就没关系，我的主人……";
		next;
		select("- 抱歉打扰……但你们刚才不是在讨论征服世界吗？");
		hideonnpc "Dark Lord#xmas";
		hideonnpc "Succubus#xmas";
		initnpctimer;
		set .@cu_bre, rand(1,10);
		if (.@cu_bre < 5) {
			set xmas2013_01, xmas2013_01 + 2;
			mes "[Dark Lord]";
			mes "是、是的。没错，魅魔！我们已经有如此伟大的目标！";
			next;
			mes "[Dark Lord]";
			mes "我很感激你的想法，但要认清自己的位置！继续像以前一样做我的下属。";
			next;
			mes "[Succubus]";
			mes "哦，是的……主人，请原谅我。我会尽力让世界属于你。";
			next;
			mes "[Dark Lord]";
			mes "是的！没有什么比把世界变成黑暗更棒。所有人都会跪在我面前。哈哈哈哈哈哈哈！！！";
			next;
			mes "- 虽然世界很快会";
			mes "- 被黑暗吞噬……";
			mes "- 但我成功拆散了一对情侣！";
			mes "- 得 2 分！";
		} else {
			if (xmas2013_01 > 0)
				set xmas2013_01, xmas2013_01 - 1;
			mes "[Dark Lord]";
			mes "征服世界……和我们现在的感受相比毫无意义。";
			mes "亲爱的魅魔，只要和我在一起，你真的能克服一切痛苦吗？";
			next;
			mes "[Succubus]";
			mes "……主人！";
			next;
			mes "[Succubus]";
			mes "当然，我已经准备好继续前进……即使遭受任何痛苦，我也会永远跟随你。";
			next;
			mes "[Succubus]";
			mes "我永远属于你！";
			next;
			mes "[Dark Lord]";
			mes "我明白了……现在我能感受到你的心。好，我们一起走……不管多么艰难！！";
			next;
			mes "- 我拯救了这个世界，使其免于黑暗。";
			mes "- 尽管一对情侣结成了！";
			mes "- 真悲伤……";
			mes "- 失败，扣 1 分！";
		}
		mes "- 当前情侣拆散分数为 " + xmas2013_01 + "。";
		close;
	} else if (isbegin_quest(15056) == 1 && xmas2013_01 > 4) {
		mes "- 情侣拆散分数";
		mes "- 现在超过 5。";
		mes "- 我该回去找联盟指挥官 Cliff。";
		close;
	}
	end;
OnTimer100000:
	hideoffnpc "Dark Lord#xmas";
	hideoffnpc "Succubus#xmas";
	stopnpctimer;
	end;
}
xmas,141,174,3	script	Succubus#xmas	1370,{ end; }


//===== rAthena Script =======================================
//= Quests EXP
//===== Description: =========================================
//= [Walkthrough Conversion]
//--- NPC quests related to new dungeons.
//===== Changelog: ===========================================
//= 1.0 Initial release of Glast Heim Abyss quests. [OptimusM]
//= 1.1 Corrections here and there. [Capuche]
//= 1.2 Initial release of Magma Dungeon 3 quests. [Capuche]
//= 1.3 Initial release of Einbech Dungeon 3 quests. [Capuche]
//============================================================

glast_01,191,273,3	script	Magician Nillem#glabyss01	4_M_JOB_WIZARD,{
	if (BaseLevel < 175) {
		mes "[Nillem]";
		mes "你来这里做什么？";
		mes "没错，我正在等待一位强大的冒险者来满足我的好奇心！";
		next;
		mes "[Nillem]";
		mes "如果你达到 175 级，就会成为我命中注定的对手——";
		close;
	}
	mes "[Nillem]";
	mes "我好像有了一个重大发现，你要不要和我一起去？";
	next;
	switch( select( "出发吧！", "请解释一下。", "我的发现", "拒绝。" )) {
	case 1:
		mes "[Nillem]";
		mes "这就是我的宝贝！";
		mes "你要和我一起跳进深渊！我忍不住爱上你了。";
		close2;
		warp "gl_cas01_",200,26;
		end;
	case 2:
		mes "[Nillem]";
		mes "你知道的，我是一名优秀的宫廷魔法师，对吧？";
		mes "我是能在次元领域做到各种事情的天才魔法师！";
		next;
		mes "[Nillem]";
		mes "有人报告说，古城中心城堡附近出现了奇怪的魔力。";
		mes "我来这里调查，果然找到了它。";
		next;
		mes "[Nillem]";
		mes "一道细小的次元裂缝！";
		mes "你知道的，这位天才魔法师最擅长连接次元裂缝。";
		next;
		mes "[Nillem]";
		mes "于是我强行连接了它，然后走了进去……";
		mes "那是一段停止在时间流中的时光……嗯……很难解释……";
		next;
		mes "[Nillem]";
		mes "总之，那些被困了很久的生物像潮水一样向我涌来！";
		next;
		mes "[Nillem]";
		mes "我差点就死在那里了。";
		mes "所以我正在寻找愿意和我一起探险的冒险者。";
		close;
	case 3:
		mes "[Nillem]";
		mes "没错，这里没有任务，但发现会引发好奇心！";
		mes "在我告诉你之前你就注意到了吧，我有几件事想和你一起做，我的——亲——爱——的——。";
		next;
		switch( select( "空无一物", "高凝固点之物", "像镜子一样的东西", "好吧，我没事。" )) {
		case 1:
			mes "[Nillem]";
			mes "在这个次元裂缝的另一边，存在着空无之物……";
			mes "^0000FF受污染的瑞比奥^000000和^0000FF受污染的瑞比奥弓箭手^000000……";
			mes "污染";
			next;
			mes "[Nillem]";
			mes "^0000FF20 只受污染的瑞比奥^000000，";
			mes "^0000FF20 只受污染的瑞比奥弓箭手^000000！打倒它们再回来，然后这位天才魔法师会进行研究。";
			mes "你觉得怎么样，宝贝？";
			next;
			if (select( "这不难。", "我很忙。" ) == 2) {
				mes "[Nillem]";
				mes "你这么忙，就没法帮我了。";
				mes "但是亲爱的，有——空——时——间——时——请帮帮我！";
				close;
			}
			switch( checkquest(8542,PLAYTIME) ) {
			case -1:
				break;
			case 0:
			case 1:
				mes "[Nillem]";
				mes "今天拜托你的事情太多了，亲爱的。";
				mes "明天再和你分享另一个新发现，好——吗——？";
				close;
			case 2:
				mes "^4d4dff - 你可以再次接受这个任务。再和魔法师尼勒姆交谈即可接取。 - ^000000";
				erasequest 8542;
				break;
			}
			switch( checkquest(8541,HUNTING) ) {
			case -1:
				mes "[Nillem]";
				mes "这才是我的宝贝！";
				mes "因为奇怪的魔法，很难在那里看出影响。";
				mes "完成任务后，我们先离开那里，然——后——再——检——查——！";
				setquest 8541;
				close;
			case 0:
			case 1:
				mes "[Nillem]";
				mes "^0000FF20 只受污染的瑞比奥^000000，";
				mes "^0000FF20 只受污染的瑞比奥弓箭手^000000。";
				mes "呜呼，你不期待空无之物的效果吗？";
				close;
			case 2:
				mes "[Nillem]";
				mes "哈～在这里太明显了。能让我看看你的……武器和……盔甲吗？嗯……";
				mes "嗯嗯！！";
				mes "哈哈，这是世纪大发现！";
				next;
				select( "你发现了什么？" );
				mes "[Nillem]";
				mes "很难向你解释，但简单来说，你——做——到——了——！！";
				mes "但这还不够，请明天再做一次。";
				erasequest 8541;
				setquest 8542;
				getexp 8142552,5674080;
				close;
			}
			end;
		case 2:
			mes "[Nillem]";
			mes "在这个次元裂缝的另一边，有些东西的凝固点很高。";
			mes "^0000FF冰冻石像鬼^000000和^0000FF破坏者^000000……";
			next;
			mes "[Nillem]";
			mes "^0000FF5 只冰冻石像鬼^000000，";
			mes "^0000FF5 只破坏者^000000！打倒它们再回来，然后这位天才魔法师会进行研究。";
			mes "你觉得怎么样，宝贝？";
			next;
			if (select( "这不难。", "我很忙。" ) == 2) {
				mes "[Nillem]";
				mes "你这么忙，就没法帮我了。";
				mes "但是亲爱的，有——空——时——间——时——请帮帮我！";
				close;
			}
			switch( checkquest(8545,PLAYTIME) ) {
			case -1:
				break;
			case 0:
			case 1:
				mes "[Nillem]";
				mes "今天拜托你的事情太多了，亲爱的。";
				mes "明天再和你分享另一个新发现，好——吗——？";
				close;
			case 2:
				mes "^4d4dff - 你可以再次接受这个任务。再和魔法师尼勒姆交谈即可接取。 - ^000000";
				erasequest 8545;
				break;
			}
			switch( checkquest(8544,HUNTING) ) {
			case -1:
				mes "[Nillem]";
				mes "这才是我的宝贝！";
				mes "因为奇怪的魔法，很难在那里看出影响。";
				mes "完成任务后，我们先离开那里，然——后——再——检——查——！";
				setquest 8544;
				close;
			case 0:
			case 1:
				mes "[Nillem]";
				mes "^0000FF5 只冰冻石像鬼^000000，";
				mes "^0000FF5 只破坏者^000000！";
				mes "呜呼，你不期待高凝固点之物吗？";
				close;
			case 2:
				mes "[Nillem]";
				mes "哈～在这里太明显了。能让我看看你的……武器和……盔甲吗？嗯……";
				mes "嗯嗯！！";
				mes "哈哈，这是世纪大发现！";
				next;
				select( "你发现了什么？" );
				mes "[Nillem]";
				mes "很难向你解释，但简单来说，你——做——到——了——！！";
				mes "但这还不够，请明天再做一次。";
				erasequest 8544;
				setquest 8545;
				getexp 2036754,1425726;
				close;
			}
			end;
		case 3:
			mes "[Nillem]";
			mes "在这个次元裂缝的另一边，有着彼此相似的镜像。";
			mes "^0000FF冰魂^000000和^0000FF火魂^000000……";
			mes "它们看起来完全不同，但次元裂缝实在太神秘了。";
			next;
			mes "[Nillem]";
			mes "^0000FF10 只冰魂^000000，";
			mes "^0000FF10 只火魂^000000！打倒它们再回来，然后这位天才魔法师会进行研究。";
			mes "你觉得怎么样，宝贝？";
			next;
			if (select( "这不难。", "我很忙。" ) == 2) {
				mes "[Nillem]";
				mes "你这么忙，就没法帮我了。";
				mes "但是亲爱的，有——空——时——间——时——请帮帮我！";
				close;
			}
			switch( checkquest(8548,PLAYTIME) ) {
			case -1:
				break;
			case 0:
			case 1:
				mes "[Nillem]";
				mes "今天拜托你的事情太多了，亲爱的。";
				mes "明天再和你分享另一个新发现，好——吗——？";
				close;
			case 2:
				mes "^4d4dff - 你可以再次接受这个任务。再和魔法师尼勒姆交谈即可接取。 - ^000000";
				erasequest 8548;
				break;
			}
			switch( checkquest(8547,HUNTING) ) {
			case -1:
				mes "[Nillem]";
				mes "这才是我的宝贝！";
				mes "因为奇怪的魔法，很难在那里看出影响。";
				mes "完成任务后，我们先离开那里，然——后——再——检——查——！";
				setquest 8547;
				close;
			case 0:
			case 1:
				mes "[Nillem]";
				mes "^0000FF10 只冰魂^000000，";
				mes "^0000FF10 只火魂^000000！";
				mes "呜呼，你不期待像镜子一样的东西吗？";
				close;
			case 2:
				mes "[Nillem]";
				mes "哈～在这里太明显了。能让我看看你的……武器和……盔甲吗？嗯……";
				mes "嗯嗯！！";
				mes "哈哈，这是世纪大发现！";
				next;
				select( "你发现了什么？" );
				mes "[Nillem]";
				mes "很难向你解释，但简单来说，你——做——到——了——！！";
				mes "但这还不够，请明天再做一次。";
				erasequest 8547;
				setquest 8548;
				getexp 4138800,2897160;
				close;
			}
			end;
		case 4:
			mes "[Nillem]";
			mes "好了，好了。亲爱的，你说得对。";
			mes "累了就休息一下。";
			mes "不——要——勉——强——自——己——！";
			close;
		}
		end;
	case 4:
		mes "[Nillem]";
		mes "哦，我的甜心，你今天真坏。";
		mes "尼勒姆好伤心。*流泪*";
		close;
	}
	end;

OnInit:
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "checkquest(8541,HUNTING) == 2" );
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "checkquest(8544,HUNTING) == 2" );
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "checkquest(8547,HUNTING) == 2" );

	questinfo( QTYPE_QUEST, QMARK_YELLOW, "checkquest(8542,PLAYTIME) == -1 && checkquest(8541,HUNTING) == -1" );
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "checkquest(8545,PLAYTIME) == -1 && checkquest(8544,HUNTING) == -1" );
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "checkquest(8548,PLAYTIME) == -1 && checkquest(8547,HUNTING) == -1" );

	questinfo( QTYPE_QUEST, QMARK_YELLOW, "checkquest(8542,PLAYTIME) == 2" );
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "checkquest(8545,PLAYTIME) == 2" );
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "checkquest(8548,PLAYTIME) == 2" );
	end;
}

gl_cas01_,205,36,5	script	Magician Nillem#glabyss02	4_M_JOB_WIZARD,{
	mes "[Nillem]";
	mes "呜呼！每次来这里我都兴奋不已！";
	mes "我喜欢这里的荒凉！";
	next;
	if (select( "我们离开这里吧！", "我想四处看看。" ) == 2) {
		mes "[Nillem]";
		mes "再见！";
		close;
	}
	mes "[Nillem]";
	mes "当然！";
	mes "让——我——们——出——去——！";
	close2;
	warp "glast_01",191,270;
	end;
}


// mag_dun03
yuno_fild03,38,146,5	script	Lily Blanc	-1,{
	if (BaseLevel < 175) {
		mes "[Lily]";
		mes "...?";
		mes "……我觉得守卫不会让你进去……";
		next;
		mes "[Lily]";
		mes "如果你有资格进入诺格路的 3 楼，愿意接受一项任务吗？";
		mes "我们需要完成很多工作。";
		mes "守卫说 175 级就够了……";
		close;
	}
	mes "[Lily]";
	mes "友善的冒险者，能请你帮我们研究一下会议报告吗？";
	mes "只有借助冒险者的双眼，我们才能继续下去。";
	next;
	switch( select( "听取请求", "真可疑……", "拒绝" ) ) {
	case 1:
		mes "[Lily]";
		mes "慷慨的冒险者！谢谢你。";
		mes "请求发生在我还无法进入的诺格路 3 楼，但会议需要一份报告……";
		next;
		setarray .@quest_list[1], 8550, 8553, 8556, 8559;
		.@s = select( "导致异常进化的毒虫", "消灭成真的噩梦", "检查密度", "容易崩解的小东西", "下次再说" );

		if (.@s < 5) {
			.@quest_first = .@quest_list[.@s];
			.@quest_delay = .@quest_first + 1;
			.@quest_daily = .@quest_first + 2;

			callsub( S_CheckDelay, .@quest_delay );

			if (isbegin_quest(.@quest_first) < 2)
				.@quest_ongoing = .@quest_first;
			else
				.@quest_ongoing = .@quest_daily;
		}

		switch( .@s ) {
		case 1:
			switch( checkquest(.@quest_ongoing,HUNTING) ) {
			case -1:
				if (.@quest_ongoing == .@quest_first) {
					mes "[Lily]";
					mes "我们的博士说，怪物生活在不同地方时，特征和外观都会改变……";
					mes "我和博士也是……因为战斗不是我的专长。";
					next;
					mes "[Lily]";
					mes "所以，来这里……看看吧。";
					mes "^0000FF有报告称，" + getmonsterinfo("DELETER2_H", MOB_NAME) + "和" + getmonsterinfo("DELETER1_H", MOB_NAME) + "^000000发生了异常进化。";
					mes "但它们性情凶猛，我甚至无法靠近……";
					next;
				}
				mes "[Lily]";
				mes "它们出没于诺格路 3 楼，";
				mes "^0000FF打倒 15 只" + getmonsterinfo("DELETER1_H", MOB_NAME) + "^000000";
				mes "以及 15 只^0000FF" + getmonsterinfo("DELETER2_H", MOB_NAME) + "^000000，告诉我它们有多难对付。";
				callsub( S_Give, .@quest_ongoing );
			case 0:
			case 1:
				mes "[Lily]";
				mes "它们出没于诺格路 3 楼，";
				mes "^0000FF打倒 15 只" + getmonsterinfo("DELETER1_H", MOB_NAME) + "^000000";
				mes "以及 15 只^0000FF" + getmonsterinfo("DELETER2_H", MOB_NAME) + "^000000，告诉我它们有多难对付。";
				close;
			case 2:
				mes "[Lily]";
				mes "感觉怎么样？";
				mes "它和普通的空中毒虫或地面毒虫有什么不同？";
				next;
				mes "[Lily]";
				mes "嗯……你还好吗？";
				mes "嗯嗯，好的。";
				callsub( S_SetDelay, .@quest_ongoing, .@quest_first, .@quest_delay, 4852278,3396600 );
			}
			end;
		case 2:
			switch( checkquest(.@quest_ongoing,HUNTING) ) {
			case -1:
				if (.@quest_ongoing == .@quest_first) {
					mes "[Lily]";
					mes "" + getmonsterinfo("NIGHTMARE_TERROR_H", MOB_NAME) + "是强化的梦魇恐惧……";
					mes "我只见过普通的梦魇恐惧。光是看着它就让我僵硬得动弹不得，还是教授把我拖出来的……";
					next;
					mes "[Lily]";
					mes "所以，来这里……看看吧。";
				}
				else {
					mes "[Lily]";
				}
				mes "它们出没于诺格路 3 楼，";
				mes "^0000FF打倒 10 只" + getmonsterinfo("NIGHTMARE_TERROR_H", MOB_NAME) + "^000000，告诉我它有多难对付。";
				callsub( S_Give, .@quest_ongoing );
			case 0:
			case 1:
				mes "[Lily]";
				mes "它们出没于诺格路 3 楼";
				mes "^0000FF 打倒 10 只" + getmonsterinfo("NIGHTMARE_TERROR_H", MOB_NAME) + "^000000，告诉我它有多难对付。";
				close;
			case 2:
				mes "[Lily]";
				mes "感觉怎么样？";
				mes "它和普通的梦魇恐惧有什么不同？";
				next;
				mes "[Lily]";
				mes "咦……真的吗？";
				mes "我该怎么办……天啊。这是真的吗？";
				mes "嗯嗯，好的。";
				callsub( S_SetDelay, .@quest_ongoing, .@quest_first, .@quest_delay, 1661868,1163304 );
			}
			end;
		case 3:
			switch( checkquest(.@quest_ongoing,HUNTING) ) {
			case -1:
				if (.@quest_ongoing == .@quest_first) {
					mes "[Lily]";
					mes "我听说熔岩魔像和" + getmonsterinfo("LAVA_GOLEM_H", MOB_NAME) + "之间的密度差异非常大。";
				}
				else {
					mes "[Lily]";
				}
				mes "它们出没于诺格路 3 楼";
				mes "^0000FF打倒 10 只" + getmonsterinfo("LAVA_GOLEM_H", MOB_NAME) + "^000000，告诉我密度差异。";
				callsub( S_Give, .@quest_ongoing );
			case 0:
			case 1:
				mes "[Lily]";
				mes "它们出没于诺格路 3 楼";
				mes "^0000FF打倒 10 只" + getmonsterinfo("LAVA_GOLEM_H", MOB_NAME) + "^000000，告诉我密度差异。";
				close;
			case 2:
				mes "[Lily]";
				mes "感觉怎么样？";
				mes "它和普通的熔岩魔像有什么不同？";
				next;
				mes "[Lily]";
				mes "嗯……没错，是外壳……";
				mes "什么？脚底？确实……";
				mes "嗯嗯，好的。";
				callsub( S_SetDelay, .@quest_ongoing, .@quest_first, .@quest_delay, 1590396,1113275 );
			}
			end;
		case 4:
			switch( checkquest(.@quest_ongoing,HUNTING) ) {
			case -1:
				if (.@quest_ongoing == .@quest_first) {
					mes "[Lily]";
					mes "据说" + getmonsterinfo("EXPLOSION_H", MOB_NAME) + "和" + getmonsterinfo("BLAZZER_H", MOB_NAME) + "比普通的爆炎和火焰兽更容易崩解。";
					mes "……这是我们的教授说的。";
					next;
					mes "[Lily]";
					mes "它们出没于诺格路 3 楼，";
					mes "^0000FF打倒 10 只" + getmonsterinfo("EXPLOSION_H", MOB_NAME) + "^000000";
					mes "^0000FF以及 10 只" + getmonsterinfo("BLAZZER_H", MOB_NAME) + "^000000，告诉我它们给你的感觉。";
					mes "不用触碰它们，光看就能判断……";
				}
				else {
					mes "[Lily]";
					mes "它们出没于诺格路 3 楼，";
					mes "^0000FF打倒 10 只" + getmonsterinfo("EXPLOSION_H", MOB_NAME) + "^000000";
					mes "^0000FF以及 10 只" + getmonsterinfo("BLAZZER_H", MOB_NAME) + "^000000，告诉我它们给你的感觉。";
				}
				callsub( S_Give, .@quest_ongoing );
			case 0:
			case 1:
				mes "[Lily]";
				mes "它们出没于诺格路 3 楼，";
				mes "^0000FF打倒 10 只" + getmonsterinfo("EXPLOSION_H", MOB_NAME) + "^000000";
				mes "^0000FF以及 10 只" + getmonsterinfo("BLAZZER_H", MOB_NAME) + "^000000，告诉我它们给你的感觉。";
				close;
			case 2:
				mes "[Lily]";
				mes "感觉怎么样？";
				mes "它和普通的爆炎或火焰兽有什么不同？";
				next;
				mes "[Lily]";
				mes "嗯……没错，通过……";
				mes "它更容易崩解……";
				mes "啊，灰尘确实多得多。";
				mes "嗯嗯，好的。";
				callsub( S_SetDelay, .@quest_ongoing, .@quest_first, .@quest_delay, 3251388,2275966 );
			}
			end;
		case 5:
			mes "[Lily]";
			mes "Ah...";
			mes "我什么时候才能摆脱教授的魔法……";
			close;
		}
		end;
	case 2:
		mes "[Lily]";
		mes "如你所见，我只是个不中用的贤者。";
		mes "我侍奉的教授有点固执……我的意思是，总得有人来调查。";
		next;
		mes "[Lily]";
		mes "但我仍然不被允许进入诺格路 3 楼。";
		mes "我好不容易到了入口，他们却说绝不会让我进去。";
		mes "没错……那里确实不适合贤者。";
		next;
		mes "[Lily]";

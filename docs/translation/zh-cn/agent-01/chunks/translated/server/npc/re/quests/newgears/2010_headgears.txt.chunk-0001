gonryun,149,189,0	script	Yotang#Flower_Of_Fairy	50,{
	mes "[Yotang]";
	mes "昆仑三楼住着一位仙女。";
	mes "她因美貌而非常有名，";
	mes "甚至还有自己的粉丝俱乐部。";
	next;
	mes "[Yotang]";
	mes "当然，我就是粉丝俱乐部的会长。";
	mes "要加入仙女粉丝俱乐部吗？";
	next;
	if(select("我没那么感兴趣！！:我马上加入！！") == 1) {
		mes "[Yotang]";
		mes "什么！我要告发你！";
		close;
	}
	if (countitem(7165) > 99 && countitem(7166) > 99 && countitem(745) > 0 && countitem(981) > 0 && countitem(2211) > 0) {
		mes "[Yotang]";
		mes "哦，那些不是……！";
		mes "制作仙女之花的材料吗？";
		mes "我们以前见过吗？你已经什么都知道了……";
		next;
		mes "[Yotang]";
		mes "总之，要我制作仙女之花吗？";
		next;
		mes "[Yotang]";
		mes "^FF0000请注意，";
		mes "一旦合成，材料上的精炼效果都会消失。^000000";
		next;
		if(select("不了，下次吧。:现在就制作！！") == 1) {
			mes "[Yotang]";
			mes "你会后悔的！";
			close;
		}
		callsub L_CheckWeight;
		mes "[Yotang]";
		mes "你真爽快！";
		mes "下届粉丝俱乐部会长非你莫属。";
		next;
		emotion ET_SWEAT;
		mes "合成中…… …… ……";
		next;
		if (countitem(7165) > 99 && countitem(7166) > 99 && countitem(745) > 0 && countitem(981) > 0 && countitem(2211) > 0) {
			callsub L_CheckWeight;
			mes "[Yotang]";
			mes "给你，仙女之花。";
			delitem 7165,100; //Limpid_Celestial_Robe
			delitem 7166,100; //Soft_Silk_Cloth
			delitem 745,1; //Wedding_Bouquet
			delitem 981,1; //Violet_Dyestuffs
			delitem 2211,1; //Bandana
			getitem 5437,1; //Flower_Of_Fairy
			emotion ET_BEST;
			next;
			mes "[Yotang]";
			mes "粉丝见面会再见！";
			close;
		}
		mes "[Yotang]";
	mes "嗯？你的材料不够……";
	mes "你没戴头巾吗？";
	mes "自己检查一下吧！";
		next;
		mes "[Yotang]";
	mes "如果想得到仙女之花，";
	mes "就把所有材料带给我。";
		next;
		mes "[Yotang]";
	mes "带给我^0000FF透明天衣 100 件、柔软丝绸 100 个、";
	mes "婚礼花束 1 个、紫色染料 1 个，";
	mes "以及可以在商店买到的^0000FF头巾 1 个^000000，";
	mes "我就为你制作^0000FF仙女之花^000000。";
		close;
	}
	mes "[Yotang]";
	mes "你很快就能见到仙女，";
	mes "因为近期会举办粉丝见面会。";
	mes "参加见面会必须有仙女之花，";
	mes "大家都会戴着它。";
	next;
	mes "[Yotang]";
	mes "如果你带来材料，";
	mes "我就为你制作。";
	next;
	mes "[Yotang]";
	mes "我需要^0000FF透明天衣 100 件、柔软丝绸 100 个、";
	mes "婚礼花束 1 个、紫色染料 1 个，";
	mes "以及可以在商店买到的^0000FF头巾 1 个^000000，";
	next;
	mes "[Yotang]";
	mes "带给我^0000FF透明天衣 100 件、柔软丝绸 100 个、";
	mes "婚礼花束 1 个、紫色染料 1 个，";
	mes "以及可以在商店买到的^0000FF头巾 1 个^000000，";
	mes "我就为你制作^0000FF仙女之花^000000。";
	next;
	mes "[Yotang]";
	mes "^FF0000请注意，";
	mes "一旦合成，材料上的精炼效果都会消失。^000000";
	next;
	if(select("我不做了。:材料在这里！") == 1) {
		mes "[Yotang]";
		mes "你会后悔的！";
		close;
	}
	mes "[Yotang]";
	mes "嗯？你在开玩笑吗？";
	next;
	mes "[Yotang]";
	mes "我需要^0000FF透明天衣 100 件、柔软丝绸 100 个、";
	mes "婚礼花束 1 个、紫色染料 1 个，";
	mes "以及可以在商店买到的^0000FF头巾 1 个^000000，";
	mes "才能制作^0000FF仙女之花^000000。";
	close;

L_CheckWeight:
	if (MaxWeight - Weight < 200) {
		mes "[Yotang]";
	mes "你的背包太重了，对吧？";
	mes "清空背包后";
	mes "再来找我。";
		close;
	}
	if (checkweight(5437,1) == 0) {
	mes "- 等等！！ -";
			mes "- 你携带的物品太多，-";
//
//
//
//
//
	mes "- 无法再获得更多物品。 -";
	mes "- 清理一些物品后 -";
	mes "- 再来找我。 -";
		close;
	}
	return;
}

lhz_in02,276,281,1	script	Drunken Man#Necktie	748,{
	mes "[Drunken Man]";
	mes "嘿……想打架吗？！";
	next;
	mes "他似乎醉得不轻。我该怎么办？";
	next;
	if(select("别理他。:战斗！") == 1) {
		mes "[Drunken Man]";
		mes "你为什么无视我？";
		mes "你怕我吗？";
		close;
	}
	if (BaseLevel < 65) {
		mes "[Drunken Man]";
		mes "什么……你比我弱。";
		mes "去提升到更高等级吧！";
		emotion ET_GO;
		close;
	}
	mes "[Drunken Man]";
	mes "等等！我需要一些护具。";
	mes "就是那个，领带，领带……";
	next;
	mes "[Drunken Man]";
	mes "只要把领带戴在头上，";
	mes "你就不是我的对手了！";
	mes "你一定开始紧张了。";
	mes "嗯！领带在哪里？";
	next;
	if (countitem(978) > 0 && countitem(7151) > 29 && countitem(1059) > 99 && countitem(7217) > 19) {
		mes "[Drunken Man]";
	mes "哦，你有制作领带的材料！把它们给我！！";
		next;
		if(select("没门！:给你。") == 1) {
			mes "[Drunken Man]";
			mes "哦，你害怕了！";
			mes "我又赢了！！";
			close;
		}
		callsub L_CheckWeight;
		mes "[Drunken Man]";
		mes "很好，稍等一下！";
		next;
		mes "合成中……咔……咔…… ……";
		emotion ET_SWEAT;
		next;
		mes "[Drunken Man]";
	mes "醉……醉了……呼呼……";
		emotion ET_QUESTION, playerattached();
		next;
		if (countitem(978) > 0 && countitem(7151) > 29 && countitem(1059) > 99 && countitem(7217) > 19) {
			callsub L_CheckWeight;
			mes "他一完成制作就";
			mes "昏睡过去了。";
			mes "我们直接拿走领带吧。";
			delitem 978,1; //Cobaltblue_Dyestuffs
			delitem 7151,30; //Oil_Paper
			delitem 1059,100; //Transparent_Cloth
			delitem 7217,20; //Spool
			getitem 5442,1; //Necktie
			close;
		}
		mes "[Drunken Man]";
		mes "嗯？材料都去哪儿了？";
		mes "你是不是因为怕我而把它们拿回去了？";
		close;
	}
	mes "[Drunken Man]";
	mes "嘿，去弄来";
	mes "^FF0000钴蓝染料 1 个、油纸 30 个、布料 100 个、线轴 20 个^000000！";
	next;
	mes "[Drunken Man]";
	mes "戴上传奇领带后，我就能打败你！";
	next;
	if(select("我不去。:我们去弄来吧。") == 1) {
		mes "[Drunken Man]";
		mes "你要放弃吗？";
		mes "我又赢了吗？";
		close;
	}
	mes "[Drunken Man]";
	mes "我再说一次，";
	mes "免得你这个笨蛋忘了！";
	next;
	mes "[Drunken Man]";
	mes "^FF0000钴蓝染料 1 个、油纸 30 个、布料 100 个、线轴 20 个^000000！";
	mes "快点！我先去和别人混一会儿。";
	emotion ET_GO;
	close;

L_CheckWeight:
	if (MaxWeight - Weight < 100) {
	mes "领带比我想象中更重。";
	mes "看来确实是传说中的领带。";
		close;
	}
	if (checkweight(5442,1) == 0) {
	mes "- 等等！！ -";
	mes "- 你携带的物品太多，-";
	mes "- 无法再获得更多物品。 -";
	mes "- 清理一些物品后 -";
	mes "- 再来找我。 -";
		close;
	}
	return;
}

comodo,236,164,0	script	Hat Girl#Hair_Brush	69,{
	mes "[Hat Girl]";
	mes "独特的帽子不是比普通发带好多了吗？";
	next;
	if(select("我还是更喜欢发带！:帽子最好！") == 1) {
		mes "[Hat Girl]";
		mes "那你一辈子都戴着无聊的发带吧！";
		emotion ET_HNG;
		close;
	}
	mes "[Hat Girl]";
	mes "你很有眼光！";
	mes "我正打算制作一顶";
	mes "时髦的帽子。";
	next;
	mes "[Hat Girl]";
	mes "只要你带来材料，";
	mes "我就让你成为时尚巨星，";
	mes "这是你的荣幸。";
	next;
	if (countitem(974) > 0 && countitem(975) > 0 && countitem(943) > 49 && countitem(985) > 4 && countitem(1302) > 0) {
		mes "[Hat Girl]";
	mes "哦！你带来了制作^0000FF发刷^000000的材料。";
	mes "要我现在制作吗？";
		next;
		if(select("我觉得发带更好……:是的，请制作！") == 1) {
			mes "[Hat Girl]";
			mes "那你一辈子都戴着无聊的发带吧！";
			emotion ET_HNG;
			close;
		}
		callsub L_CheckWeight;
		mes "[Hat Girl]";
		mes "好，我马上制作！";
		next;
		mes "咔咔咔……合成中……咔咔。";
		emotion ET_PROFUSELY_SWEAT, playerattached();
		next;
		mes "[Hat Girl]";
		mes "好了，完成了！";
		mes "现在你就是时尚达人了！";
		next;
		if (countitem(974) > 0 && countitem(975) > 0 && countitem(943) > 49 && countitem(985) > 4 && countitem(1302) > 0) {
			callsub L_CheckWeight;
			mes "[" + strcharinfo(0) + "]";
			mes "我拿到发刷了。";
			mes "……但它让我有点难过。";
			delitem 974,1; //Mixture
			delitem 975,1; //Scarlet_Dyestuffs
			delitem 943,50; //Solid_Shell
			delitem 985,5; //Elunium
			delitem 1302,1; //Axe_
			getitem 5444,1; //Hair_Brush
			close;
		}
		mes "[Hat Girl]";
		mes "嗯？你不想成为";
		mes "最棒的时尚达人吗？";
		mes "你的材料不够？";
		close;
	}
	mes "[Hat Girl]";
	mes "要制作最新款的^0000FF发刷^000000，";
	mes "我需要^0000FF混合剂 1 个、猩红染料 1 个、";
	mes "坚硬外壳 50 个、铝 5 个，^000000";
	mes "以及一把有 4 个插槽的^0000FF斧头^000000。";
	next;
	mes "[Hat Girl]";
	mes "你还在做什么？快点！";
	next;
	mes "[Hat Girl]";
	mes "给你一个提示。";
	mes "从魔物身上很容易获得坚硬外壳和铝。";
	close;

L_CheckWeight:
	if (MaxWeight - Weight < 100) {
		mes "[Hat Girl]";
	mes "你携带的东西太多了。";
	mes "清空背包后再来。";
		close;
	}
	if (checkweight(5443,1) == 0) {
		mes "- 等等！！ -";
		mes "- 你携带的物品太多，-";
		mes "- 无法再获得更多物品。 -";
		mes "- 清理一些物品后 -";
		mes "- 再来找我。 -";
		close;
	}
	return;
}

alberta,151,78,0	script	Bebete#Baby_Angel	96,{
	if (isequipped(5074) > 0 || isequipped(2254) > 0 || isequipped(5210) > 0) {
		if (BaseLevel < 65) {
			mes "[Bebete]";
			mes "冒牌天使？走开！";
			next;
			mes "[Bebete]";
			mes "真正的天使";
			mes "不会像你这么弱。";
			close;
		}
		if (isequipped(5443) > 0) {
			mes "[Bebete]";
			mes "哦，天使又来了。";
			mes "你对^FF0000小天使雕像^000000很满意，对吧？";
			close;
		}
		if (countitem(523) > 0 && countitem(916) > 499 && countitem(7292) > 9 && countitem(2282) > 0 && countitem(640) > 0) {
			mes "[Bebete]";
			mes "啊！嘿，天使～天使～";
			next;
			mes "[Bebete]";
			mes "请让我看看小天使雕像！";
			mes "我听说每个天使都有一个！";
			next;
			select("小天使雕像？");
			mes "[Bebete]";
			mes "你把它弄丢了吗？";
			mes "要我为你制作一个吗？";
			next;
			if(select("不用了，谢谢。:是的，我现在就要。") == 1) {
				mes "[Bebete]";
				mes "哦……生活真不容易！";
				close;
			}
			callsub L_CheckWeight;
			mes "[Bebete]";
			mes "哇，天使，你已经知道所有材料了。";
			emotion ET_BIGTHROB;
			next;
			mes "[Bebete]";
			mes "你很幸运。我正好有一个雕像正在制作。";
			mes "所以你不用等太久。";
			next;
			if (countitem(523) > 0 && countitem(916) > 499 && countitem(7292) > 9 && countitem(2282) > 0 && countitem(640) > 0) {
				callsub L_CheckWeight;
				mes "我拿到^FF0000小天使雕像^000000了。";
				delitem 916,500; //Feather_Of_Birds
				delitem 523,1; //Holy_Water
				delitem 7292,10; //Muscovite
				delitem 2282,1; //Spirit_Chain
				delitem 640,1; //Shining_Stone
				getitem 5443,1; //Status_Of_Baby_Angel
				next;
				mes "[Bebete]";
				mes "再见，我的天使～！";
				emotion ET_THANKS;
				next;
				mes "[" + strcharinfo(0) + "]";
				mes "... ...";
				next;
				mes "[" + strcharinfo(0) + "]";
		mes "嗯……看来我被那个小鬼骗了。";
				close;
			}
			mes "[Bebete]";
		mes "嘿，我没看到";
		mes "你包里有任何材料……";
			emotion ET_CRY;
			close;
		}
		mes "[Bebete]";
	mes "嘿，天使……";
		next;
		mes "[Bebete]";
	mes "哇，天使！";
		emotion ET_HUK;
		next;
		mes "[Bebete]";
	mes "你是真正的天使吗？你去过天堂吗？";
		next;
	if(select("胡说八道！:保留童真吧！") == 1) {
			mes "[" + strcharinfo(0) + "]";
		mes "天使和天堂？全都是编出来的！";
			next;
			mes "[" + strcharinfo(0) + "]";
		mes "根本什么都没有。一切都是谎言！";
			emotion ET_KIK, playerattached();
			next;
			mes "[Bebete]";
		mes "你是恶魔！是魔物！是笨蛋！";
			emotion ET_OHNO;
			close;
		}
		mes "[" + strcharinfo(0) + "]";
	mes "当然。我以前常和龙与斑马一起跳舞，";
	mes "就在香草味的云朵上。";
		next;
		mes "[Bebete]";
	mes "这正是我想象中的样子！";
		next;
		mes "[Bebete]";
	mes "请让我看看小天使雕像！";
	mes "我听说每个天使都有一个！";
		next;
		mes "[Bebete]";
	mes "糟糕，你把它弄丢了吗？";
	mes "要我为你做一个吗？";
		next;
		mes "[Bebete]";
	mes "我以前为你这样的天使";
	mes "做过好几个。";
		next;
		mes "[Bebete]";
	mes "我可以用^FF0000鸟羽毛 500 个、圣水 1 个、白云母 10 个、天堂之戒 1 个和闪亮石 1 个^000000制作。";
		next;
		mes "[Bebete]";
	mes "好了，快点吧！";
		close;
	} else {
		mes "[Bebete]";
	mes "冒牌天使？走开！！";
		next;
		mes "[Bebete]";
	mes "真正的天使";
	mes "头上长着翅膀！";
		close;
	}
	end;

L_CheckWeight:
	if (MaxWeight - Weight < 600) {
		mes "[Bebete]";
	mes "天使，你带了这么多东西吗？";
	mes "你的背包太满了，";
	mes "我没法把物品给你。";
		close;
	}
	if (checkweight(5443,1) == 0) {
		mes "- 等等！！ -";
		mes "- 你携带的物品太多，-";

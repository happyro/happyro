	npctalk "阿玛尔：……我感觉不到任何神力……？为什么……？";
	sleep2 2500;
	specialeffect EF_BEGINSPELL5, AREA, .@demigod$;
	sleep2 1000;
	enablenpc .@miriam04$;
	specialeffect EF_GUARD, AREA, .@miriam04$;
	sleep2 1000;
	npctalk "阿玛尔：神怎么能惩罚我这个忠于芙蕾雅的仆人？";
	sleep2 2500;
	npctalk "米丽娅姆：现在不是说这个的时候。你必须放手！那不是神！", .@miriam04$;
	sleep2 2500;
	npctalk "被称为神的存在：kikikig kikikig ……", .@demigod$;
	sleep2 2500;
	npctalk "阿玛尔：胡说！米丽娅姆，给我让开！";
	sleep2 2500;
	npctalk "米丽娅姆：你刚才差点死了。看前面。那个卑劣存在的哪一部分是神？", .@miriam04$;
	sleep2 2500;
	npctalk "米丽娅姆：看来你需要睁开眼睛，父亲。", .@miriam04$;
	sleep2 2000;
	npctalk "阿玛尔：不可能发生这种事！放开我，米丽娅姆！";
	sleep2 2000;
	npctalk "被称为神的存在：kkigig……？kkigigi kkyahahahahahahaha！！", .@demigod$;
	sleep2 1000;
	specialeffect EF_BEGINSPELL5, AREA, .@demigod$;
	sleep2 700;
	specialeffect EF_BEGINSPELL_YB, AREA, .@demigod$;
	npctalk "米丽娅姆：你在做什么！！！！", .@miriam04$;
	sleep2 800;
	disablenpc instance_npcname("Yus Amal#jus01");
	disablenpc .@miriam04$;
	sleep2 800;
	npctalk "被称为神的存在：kyahahahahahahaha！！", .@demigod$;
	sleep2 1000;
	setpcblock PCBLOCK_NPC, false;

	specialeffect EF_BEGINSPELL_YB, AREA, .@demigod$;
	mapannounce 'map_adv$, "礼拜堂已被封锁。", bc_map, 0x4D4DFF;
	disablenpc .@demigod$;
	disablenpc .@shulang02$;
	donpcevent instance_npcname("adv_demigod_boss") + "::OnStart";
	end;
}

1@adv,1,1,5	script	adv_demigod_boss	-1,{
	end;
OnStart:
	if ('adv_step != 25)
		end;
	'adv_step = 26;
	monster 'map_adv$,124,356,"Twisted God",21315,1, instance_npcname("adv_demigod_boss") + "::OnMobDead";	// EP18_MD_DEMI_FREYJA
	monster 'map_adv$,122,351,"Resurrected Schulang",21314,1, instance_npcname("adv_demigod_boss") + "::OnMobDead2";	// EP18_MD_SCHULANG
	.@boss_gid = $@mobid[0];

	unitskillusepos .@boss_gid,"NPC_CANE_OF_EVIL_EYE",3,123,349,-50,0,0,1;
	unitskillusepos .@boss_gid,"NPC_CANE_OF_EVIL_EYE",3,133,338,-50,0,0,1;
	unitskillusepos .@boss_gid,"NPC_CANE_OF_EVIL_EYE",3,113,338,-50,0,0,1;
	unitskillusepos .@boss_gid,"NPC_CANE_OF_EVIL_EYE",3,123,330,-50,0,0,1;
	end;
OnMobDead:
	if ('adv_step != 26)
		end;
	if (mobcount('map_adv$, instance_npcname("adv_demigod_boss") + "::OnMobDead") < 1) {
		'adv_step = 27;
		killmonster 'map_adv$, instance_npcname("adv_demigod_boss") + "::OnMobDead2";
		mapannounce 'map_adv$, "阿玛尔的声音：天啊——！！！", bc_map, 0xFF0000;
		enablenpc instance_npcname("#boss_out");
		enablenpc instance_npcname("Miriam#miriam05");
		enablenpc instance_npcname("Yus Amal#jus02");
	}
	end;
OnMobDead2:
	end;
}


// Boss room out
1@adv,121,321,6	script(DISABLED)	Miriam#miriam05	EP18_NPC_MIRIAM,{
	if ('adv_step < 27)
		end;
	if ('adv_step == 27 && ep18_main == 54) {
		npctalk "米丽娅姆：父亲！", instance_npcname("Miriam#miriam05");
		mes "[米丽娅姆]";
		mes "他做了什么？它突然飞出来了。";
		mes "你还好吗？";
		cutin "ep18_miriam_03.png",0;
		next;
		cutin "",255;
		mes "[阿玛尔]";
		mes "你对神做了什么!!!!!!!!!!";
		mes "你不能这样！";
		mes "我为了等待这一天都做了什么……！";
		next;
		cutin "ep18_miriam_03.png",0;
		mes "[米丽娅姆]";
		mes "你还相信那是神吗？";
		mes "你真的这么说吗？";
		next;
		select( "这个胚胎掉出来了。" );
		mes "[米丽娅姆]";
		mes "确实……";
		mes "和教皇的很相似……";
		mes "看这个掉落的胚胎，肯定是名叫巴戈特的人创造的。";
		next;
		select( "我会在这里分析。" );
		cutin "",255;
		mes "[阿玛尔]";
		mes "米丽娅姆！抓住那个傲慢的蠢货！";
		mes "这个人应该受到神罚！";
		mes "你是亵渎者！";
		next;
		cutin "ep18_miriam_03.png",0;
		mes "[米丽娅姆]";
		mes "不可能。";
		mes "冒险者不远万里来帮助我们。";
		next;
		mes "[米丽娅姆]";
		mes "神殿里也是这样。";
		mes "看来他们也蒙蔽了我的父亲。";
		next;
		cutin "",255;
		mes "[阿玛尔]";
		mes "你是说我中了他们的诡计！";
		next;
		cutin "ep18_miriam_03.png",0;
		mes "[米丽娅姆]";
		mes "我们先离开这里。";
		mes "检查胚胎后再讨论细节。";
		next;
		mes "[米丽娅姆]";
		mes "冒险者，调查完成后如果揭开扭曲之神的身份，请告诉我。";
		mes "我会照顾父亲。";
		ep18_main = 55;
		erasequest 18083;
		setquest 18084;
		if (is_party_leader() == true)
			enablenpc instance_npcname("#boss_out");
		close3;
	}
	cutin "ep18_miriam_01.png",0;
	mes "[米丽娅姆]";
	mes "我需要照顾父亲，我们离开这里吧。";
	close3;
}

1@adv,119,320,6	script(DISABLED)	Yus Amal#jus02	4_M_RACHOLD,{
	npctalk "阿玛尔：……天啊……不该是这样的……", instance_npcname("Yus Amal#jus02");
	end;
}

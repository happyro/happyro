				next;
				if (select("好的。:抱歉。") == 1) {
					mes "[Laphine craftsman]";
					mes "请接受我的请求。可以带来15个结晶泪珠和15份荧光液体吗？";
					setquest 7081;
					close;
				}
				mes "[Laphine craftsman]";
				mes "我知道你有自己的事情要做。作为拉比内，向你求助让我很不好意思。";
				next;
				mes "[Laphine craftsman]";
				mes "但是，既然你想参与我们的事务，为什么不接受请求？";
				close;
			}
			mes "[Laphine craftsman]";
			mes "亚伊……所有成年的拉比内都有一个。";
			mes "我们很重视隐私，亚伊是生活必需品。";
			next;
		select("是房子……？");
			mes "[Laphine craftsman]";
		mes "是的……就是房子。我们有时邀请朋友或客人来亚伊。亚伊的装饰对我们很重要……";
			next;
			mes "[Laphine craftsman]";
		mes "我们拉比内很在意自己和自己的亚伊。";
			next;
			mes "[Laphine craftsman]";
		mes "我们现在远离故乡……没有这种爱好，这里就没什么乐趣了。";
			close;
		}
		mes "[Laphine craftsman]";
		mes "嗯？哦，没看到我很忙吗？我正在制作装饰品。";
		close;
	}
	mes "[Laphine craftsman]";
		mes "尤尔，杜尔·阿诺瓦？";
		mes "什么？迪布·奥萨杜尔……啊……拉夫图斯·尼阿什。";
	close;
}

mid_camp,146,306,3	script	Pet Breeder#ep13_eden01	982,{
	if (checkweight(1201,2) == 0) {
		mes "等一下！！你的物品太多了。无法领取这个物品。请减轻负重后再试。";
		close;
	}
	if (ep13_mdrama < 6) {
		mes "[Pinedel]";
		mes "为什么不行，塔布？应该有效才对。";
		next;
		mes "[Taab]";
		mes "那太危险了。你想死吗？！";
		next;
		mes "[Pinedel]";
		mes "你无视可爱的宠物吗？我们连皮奇和泽洛斯都能得到！";
		next;
		mes "[Taab]";
		mes "不行，就算你求我也不行……山羊狮很可爱，但不能这样做。";
		next;
		mes "[Pinedel]";
		mes "那告诉我你为什么反对。";
		next;
		mes "[Taab]";
		mes "太危险了。我以前训练过魔物。山羊狮看起来可爱，但实际并不适合。";
		next;
		mes "[Taab]";
		mes "你看不出来吗？我试过训练它们……但做不到。怎么能把它们训练成可爱宠物？";
		next;
		mes "[Taab]";
		mes "它一定会试图逃跑……然后会变得非常可怕。我不同意。";
		next;
		mes "[Pinedel]";
		mes "不……不能用魔法控制吗？我们以前做过……";
		next;
		mes "- 他们继续争论。 -";
		close;
	}
	mes "[Pinedel]";
	mes "啊，塔布真不灵活。嘿！怎么了？";
	next;
	if (select("犯罪报告通知:可爱宠物调查。") == 1) {
		if (ep13_2_wanted == 1) {
			if (checkquest(7076,HUNTING) == 2) {
				mes "[Pinedel]";
			mes "你猎杀逃跑的蒲公英了吗？好，我认可你。这是琳存放在这里的东西。";
				next;
				mes "[Pinedel]";
			mes "这是琳珍爱的宝箱……作为报酬够了吧？";
				completequest 7076;
				set ep13_2_wanted,2;
				getitem 7444,1; //Treasure_Box
				close;
			}
			mes "[Pinedel]";
		mes "我知道你还没消灭逃跑的蒲公英。别把我当傻瓜。";
			close;
		}
		else if (ep13_2_wanted == 2) {
			mes "[Pinedel]";
		mes "我会把一切转交给琳。她会喜欢的。告诉她你的名字是"+strcharinfo(0)+"。";
			next;
			mes "[Pinedel]";
		mes "我记得琳提过你。既然琳喜欢你，你一定是个好人。";
			close;
		}
		mes "[Pinedel]";
		mes "在寻找罪犯？我不确定你是否与此有关。";
		close;
	}
	if (ep13_2_dayegg == 1) {
		if (countitem(6093) > 9) {
			mes "[Pinedel]";
		mes "哦！很好！有你的帮助，我可以深入研究。";
			next;
			mes "[Pinedel]";
		mes "我会尝试把这些龙蛋变成可爱宠物。别抱太大期望！一天后回来看看进展。";
			delitem 6093,10; //Egg_Of_Draco
			erasequest 7077;
			setquest 7078;
			set ep13_2_dayegg,2;
			getexp 40000,40000;
			getitem 6081,1; //Splendide_Coin
			getitem 6080,1; //Manuk_Coin
			close;
		}
		mes "[Pinedel]";
		mes "这些龙蛋在孵化前一直放在巢里。请帮我收集10枚龙蛋。你知道，人工孵化很困难。";
		close;
	}
	else if (ep13_2_dayegg == 2) {
		mes "[Pinedel]";
		mes "那些蛋快孵化了。我会回家研究。";
		set .@alba_check,checkquest(7078,PLAYTIME);
		if (.@alba_check == -1) {
			close2;
			erasequest 7078;
			set ep13_2_dayegg,3;
			end;
		}
		else if ((.@alba_check == 0) || (.@alba_check == 1)) {
		mes "现在还需要更多时间。";
			next;
			mes "[Pinedel]";
		mes "你明天能再来吗？";
			close;
		}
		close2;
		erasequest 7078;
		set ep13_2_dayegg,3;
		end;
	}
	else if (ep13_2_dayegg == 3) {
		mes "[Pinedel]";
		mes "今天要帮我收集更多龙蛋吗？我想用那些蛋尝试许多事情。";
		next;
		if (select("Sure.:Sorry, I can't.") == 1) {
			mes "[Pinedel]";
			mes "请收集10枚龙蛋。";
			set ep13_2_dayegg,1;
			setquest 7077;
			close;
		}
		mes "[Pinedel]";
		mes "好，你在这里有自己的事。去吧。";
		close;
	}
	mes "[Pinedel]";
		mes "我在研究可爱的宠物。灰色幽灵有几种魔物，我觉得可以成为可爱宠物。";
	next;
	mes "[Pinedel]";
	mes "目标是一枚龙蛋！你能带一枚龙蛋给我吗？";
	next;
	if (select("Yes.:Nope.") == 1) {
		mes "[Pinedel]";
		mes "你发现的洞穴里应该有龙巢，那里应该有漂亮的龙蛋。";
		next;
		mes "[Pinedel]";
		mes "请收集10枚龙蛋。让我们一起把它们培育成宠物。";
		set ep13_2_dayegg,1;
		setquest 7077;
		close;
	}
	mes "[Pinedel]";
	mes "我知道这不是容易的任务，但我不会放弃。总有一天我要把它变成可爱宠物。";
	next;
	mes "[Taab]";
	mes "你就这样放弃把外来生物变成可爱宠物吗……";
	mes " ";
	mes "[Pinedel]";
	mes "塔布真没胆量！";
	close;
}

mid_camp,192,239,4	script	Wanted Sign#ep13_2ect01	857,{
	if (ep13_mdrama > 5) {
		mes "[Wanted]";
		mes " ";
		mes "通缉：蒲公英。委托人：琳。奖励：宝箱。";
		mes " ";
		mes "注意：我们以为蒲公英帮已被消灭，但并没有。";
		mes "听说在灰色幽灵发现了蒲公英的黑色衣物。出了些问题……";
		mes "我需要有人找到并消灭蒲公英。我可以提供珍藏的宝箱。";
		mes "听说它在某个洞穴里……！";
		mes " ";
		mes "附言：它们名声很差……你可能不想独自前往……";
		mes " ";
		mes "附言2：我无法直接给你奖励……";
		mes "事情办成后，‘皮涅德尔’会给你奖励……！";
		mes " ";
		next;
		if (ep13_2_wanted == 0) {
			mes "你接受琳的委托吗？";
			if (select("我接受这份委托。:不，我做不到。") == 1) {
				mes "我接受了琳的委托。";
				set ep13_2_wanted,1;
				setquest 7076;
				close;
			}
			mes "不，我不参与。";
			close;
		}
		mes "我已经决定接受委托。";
		close;
	}
	mes "一定有人会取走通缉告示。";
	close;
}


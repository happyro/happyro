		erasequest 5054;
		set dew_weapon,7;
		delitem 6403,100; //Comodo_L
		delitem 999,20; //Steel
		delitem 984,10; //Oridecon
		delitem 6404,1; //Caress_H
		getitem 13067,1; //Caress
		close;
	} else if (dew_weapon >= 7) {
		mes "[加蒂]";
		mes "你是"+strcharinfo(0)+"，";
		mes "我为你制作的爱抚怎么样？";
		switch(select("很棒！:我需要另一把爱抚。:能让它更强吗？")) {
		case 1:
			mes "[加蒂]";
			mes "是的，当然很棒。";
			mes "那把武器是我做的，当然应该很好。";
			close;
		case 2:
			disable_items;
			if (countitem(6404)) {
				if (countitem(6403) < 70 || countitem(984) < 10 || countitem(999) < 20 || countitem(6404) < 1) {
					mes "[加蒂]";
					mes "你只有剑柄。需要带来 10 个奥里代根、20 个钢铁和 70 个科莫多皮革。";
					next;
					mes "[加蒂]";
					mes "带齐这些材料，我就能制作一把全新的爱抚。";
					close;
				}
				mes "[加蒂]";
				mes "材料都齐了。请稍等片刻。";
				next;
				specialeffect2 EF_REPAIRWEAPON;
				next;
				emotion ET_PROFUSELY_SWEAT;
				next;
				mes "[加蒂]";
				mes "爱抚在这里！随时都可以来找我。";
				delitem 6403,70; //Comodo_L
				delitem 999,20; //Steel
				delitem 984,10; //Oridecon
				delitem 6404,1; //Caress_H
				getitem 13067,1; //Caress
				close;
			} else {
				if (countitem(6403) < 50 || countitem(7201) < 1) {
					mes "[加蒂]";
					mes "想让我再做一把爱抚吗？那样的话需要剑柄、50 个科莫多皮革和 1 根木头。这些是制作剑柄所需的材料。";
					close;
				}
				mes "[加蒂]";
				mes "你带来了制作剑柄的材料。我马上制作。";
				next;
				mes "[加蒂]";
				mes "把这个放在这里，然后这样加工……";
				next;
				mes "[加蒂]";
				mes "给你。如果带来 10 个奥里代根、20 个钢铁和 70 个科莫多皮革，我就能制作爱抚。";
				delitem 6403,50; //Comodo_L
				delitem 7201,1; //Log
				getitem 6404,1; //Caress_H
				close;
			}
		case 3:
			mes "[加蒂]";
			mes "想强化武器吗？强化过程中武器偶尔会损坏，不过并不常见。";
			if(select("请强化武器。:下次再说。") == 2) {
				mes "[加蒂]";
				mes "想强化爱抚时，带来爱抚和 100,000 Zeny 就行。";
				close;
			}
			mes "[加蒂]";
			mes "如果要强化，我必须先告诉你一些强化爱抚时的注意事项。";
			next;
			mes "[加蒂]";
			mes "^FF0000第一！^009977强化爱抚需要 1 把爱抚和 100,000 Zeny。如你所知，我的船被毁了，现在没有钱。^000000";
			next;
			mes "[加蒂]";
			mes "^FF0000第二！^009977如果背包里有不想强化、已经精炼或插卡的爱抚，强化过程中可能被摧毁或改变强化效果。";
			next;
			mes "[加蒂]";
			mes "如果不想发生这种事，请在强化前把精炼过的爱抚放到别处。^000000";
			next;
			mes "[加蒂]";
			mes "^FF0000第三！^009977强化有时会失败。失败时武器不一定每次都会被摧毁，但你应该知道，失败时武器偶尔会被摧毁。^000000";
			next;
			if(select("请强化武器。:下次再说。") == 2) {
				mes "[加蒂]";
				mes "想强化爱抚时，带来爱抚和 100,000 Zeny 就行。";
				close;
			}
			break;
		}

		if (countitem(13067) < 1 || Zeny < 100000) {
			mes "[加蒂]";
			mes "你没有带齐所有材料。材料不全就无法强化。想强化的话，请带来 100,000 Zeny 和 1 把爱抚。";
			close;
		}
		specialeffect2 EF_REPAIRWEAPON;
		progressbar "0xFFFF00",3;
		set Zeny, Zeny - 100000;

		// Socket 3
		set .@i, rand(4300);
		     if (.@i < 150)  set .@s3,4700; // STR + 1
		else if (.@i < 300)  set .@s3,4730; // AGI + 1

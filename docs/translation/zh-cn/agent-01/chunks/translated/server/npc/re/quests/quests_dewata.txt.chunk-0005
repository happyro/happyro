		else set .@s4,0;

		delitem 13067,1; //Caress
		if (.@s3 == 0 && .@s4 == 0) {
			mes "[加蒂]";
			mes "天啊~~差点成功了……但还是失败了。对不起，对不起……";
			emotion ET_HUK;
			close;
		}
		getitem2 13067,1,1,0,0,0,0,.@s3,.@s4;
		mes "[加蒂]";
		mes "爱抚强化成功。下次再见。";
		close;

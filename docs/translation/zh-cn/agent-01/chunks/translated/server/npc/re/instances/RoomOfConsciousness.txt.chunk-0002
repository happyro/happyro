	mes "~呻吟~真不敢相信，什么都不起作用！";
	next;
	cutin "bijou_01",2;
	mes "[碧珠]";
	mes "~轻笑~";
	mes "让你尝尝绝望的滋味。";
	next;
	cutin "bijou_02",2;
	mes "[碧珠]";
	mes "冰冻术！";
	specialeffect EF_LOCKON,AREA, instance_npcname("Fenrir#5mir");
	sleep2 3000;
	specialeffect EF_FREEZE,AREA, instance_npcname("Fenrir#5mir");
	next;
	cutin "fenrir_b",2;
	mes "[芬里尔]";
	mes "~呻吟~";
	next;
	cutin "bijou_01",2;
	mes "[碧珠]";
	mes "感觉如何？很痛吧？";
	mes "你现在一定已经动不了了。";
	mes "……但别指望我会这么轻易杀了你……";
	next;
	mes "[碧珠]";
	mes "我应该先处理掉这个烦人的女祭司。";
	next;
	cutin "fenrir_b",2;
	mes "[芬里尔]";
	mes "我……艾莉丝！！";
	next;
	cutin "sarah_hero3",2;
	mes "[莎拉]";
	mes "……";
	enablenpc instance_npcname("Sarah#5mir");
	next;
	cutin "bijou_02",2;
	mes "[碧珠]";
	mes "莎拉……？";
	next;
	cutin "sarah_hero3",2;
	mes "[莎拉]";
	mes "原来就是这里……";
	mes "这里是普隆德拉城堡的地下。";
	mes "也是第一颗尤弥尔之心封印的地方。";
	next;
	mes "[莎拉]";
	mes "而那一定就是……";
	mes "尤弥尔之心……";
	next;
	cutin "bijou_02",2;
	mes "[碧珠]";
	mes "是什么把你带到这里来的？";
	mes "莎拉·艾琳。";
	mes "没想到你会出现在这里。";
	next;
	cutin "sarah_hero3",2;
	mes "[莎拉]";
	mes "碧珠，你在这里做什么？";
	next;
	cutin "bijou_01",2;
	mes "[碧珠]";
	mes "我正在处理那些烦人的虫子。";
	next;
	cutin "sarah_hero3",2;
	mes "[莎拉]";
	mes "碧珠，这算什么回答？";
	next;
	mes "[莎拉]";
	mes "我的问题是：你还在这里磨蹭什么？为什么没有解开尤弥尔之心的任何封印？";
	next;
	cutin "bijou_02",2;
	mes "[碧珠]";
	mes "这个嘛……我确实解开了第一道封印。";
	mes "这里很快就会清理干净，莎拉，你不用担心。";
	next;
	mes "[碧珠]";
	mes "相信我，就当已经完成了。请继续做你骄傲的女武神吧。";
	next;
	cutin "bijou_01",2;
	mes "[碧珠]";
	mes "(~嗤笑~真是个古板又可悲的女武神！像你这样的新手竟然和希梅尔兹受到同等待遇，太不公平了。)";
	next;
	cutin "sarah_hero3_2",2;
	mes "[莎拉]";
	mes "碧珠，你一定疯了……这里没有希梅尔兹。";
	next;
	cutin "bijou_03",2;
	mes "[碧珠]";
	mes "……~喘气~";
	mes "我喘不过气了！";
	next;
	cutin "sarah_hero3_2",2;
	mes "[莎拉]";
	mes "你最好闭嘴！";
	next;
	cutin "bijou_03",2;
	mes "[碧珠]";
	mes "~咳嗽~";
	mes "~不停咳嗽~";
	next;
	cutin "sarah_hero3",2;
	mes "[莎拉]";
	mes "我不需要一个把时间浪费在这种小事上的下属。";
	mes "尤弥尔之心就由我亲自取走。";
	disablenpc instance_npcname("Sarah#5mir");
	next;
	cutin "bijou_02",2;
	mes "[碧珠]";
	mes "（她果然是女武神。唉，这又能怎么办呢？）";
	next;
	cutin "fenrir_b",2;
	mes "[芬里尔]";
	mes "时机到了！";
	mes "冰冻术！";
	specialeffect EF_FREEZE,AREA, instance_npcname("Bijou#5mir");
	next;
	cutin "bijou_03",2;
	mes "[碧珠]";
	mes "你说什么？！";
	next;
	mes "[碧珠]";
	mes "哇……真是千钧一发。";
	mes "怎么会这样？";
	next;
	cutin "fenrir_a",2;
	mes "[芬里尔]";
	mes "这种魔法……";
	mes "果然是高阶魔法，施展起来相当困难。";
	next;
	cutin "bijou_02",2;
	mes "[碧珠]";
	mes "（这是怎么回事？！她刚刚掌握了我施加在她身上的魔法吗？）";
	next;
	cutin "fenrir_a",2;
	mes "[芬里尔]";
	mes "艾莉丝！这是治疗药水。";
	mes "喝下去你就会恢复意识。";
	next;
	sleep2 500;
	specialeffect EF_POTION1,AREA, instance_npcname("Iris#5mir");
	cutin "hero_iris_01",2;
	mes "[艾莉丝]";
	mes "~含糊的声音~";
	next;
	sleep2 500;
	specialeffect EF_POTION1,AREA, instance_npcname("Iris#5mir");
	cutin "fenrir_a",2;
	mes "[芬里尔]";
	mes "哦，你醒了吗？";
	next;
	cutin "hero_iris_01",2;
	mes "[艾莉丝]";
	mes "嗯……";
	mes "~呕吐声~";
	mes "呸！好苦！";
	mes "这到底是什么？！";
	mes "你给我喝了什么？";
	next;
	cutin "fenrir_a",2;
	mes "[芬里尔]";
	mes "你醒了，艾莉丝。";
	mes "我放心了。";
	next;
	cutin "hero_iris_01",2;
	mes "[艾莉丝]";
	mes "~叹气~对了，芬里尔！";
	mes "尤弥尔之心怎么样了？";
	next;
	cutin "bijou_02",2;
	mes "[碧珠]";
	mes "（……芬里尔？我太专注尤弥尔之心，完全忘了她。如果我猜得没错，她一定是……！）";
	next;
	mes "[碧珠]";
	mes "~呼气~我明白了。就是这样。";
	mes "流淌在你体内的野兽之血……这就是答案！";
	next;
	cutin "bijou_01",2;
	mes "[碧珠]";
	mes "那么，就让我好好招待你吧！~轻笑~";
	mes "没想到能见到千年前的英雄！";
	next;
	cutin "bijou_03",2;
	mes "[碧珠]";
	mes "去死吧！！";
	next;
	cutin "fenrir_b",2;
	mes "[芬里尔]";
	mes "……小心，她要攻击了！";
	close2;
	cutin "",255;
	if ('step == 6) {
		'step = 7;
		donpcevent instance_npcname("eq#mir5") + "::OnEvent";
	}
	end;
}

1@mir,101,104,0	script	eq#mir5	HIDDEN_WARP_NPC,{
	end;
OnEvent:
	enablenpc instance_npcname("eq#mir3");
	enablenpc instance_npcname("eq#mir5");
	disablenpc instance_npcname("Bijou#5mir");
	disablenpc instance_npcname("Fenrir#5mir");
	disablenpc instance_npcname("Iris#5mir");

	monster 'map_name$,102,95,"Bijou",3450,1, instance_npcname("eq#mir5") + "::OnMobDead";// BIJOU
	'boss_id = $@mobid[0];
	'target_event = 2;
	initnpctimer;
	end;
OnTimer1000:
	getunitdata 'boss_id, .@data;
	if (.@data[UMOB_HP] == .@data[UMOB_MAXHP]) {
		initnpctimer;
		end;
	}
	end;
OnTimer3000:
	mapannounce 'map_name$, "艾莉丝：让我们一起战斗，再次取得胜利！", bc_map,0xFFFF00,FW_NORMAL,12;
	end;
OnTimer5000:
	mapannounce 'map_name$, "芬里尔：我也这么想。这次也请你把它引到我所在的地方。", bc_map,0xFFFF00,FW_NORMAL,12;
	end;
OnTimer7000:
	mapannounce 'map_name$, "碧珠：……", bc_map,0xFFFF00,FW_NORMAL,12;
	donpcevent instance_npcname("eq#mir3") + "::OnEvent2";
	donpcevent instance_npcname("eq#mir6") + "::OnTalk";
	stopnpctimer;
	end;
OnMobDead:
	if ('step != 7)
		end;
	'step = 8;
	stopnpctimer;
	donpcevent instance_npcname("eq#mir3") + "::OnStop";
	donpcevent instance_npcname("eq#mir6") + "::OnStop";
	if ('random_letter$ != "")
		donpcevent instance_npcname( "Fenrir#boss2" + 'random_letter$ ) + "::OnStop";
	disablenpc instance_npcname("eq#mir5");

	enablenpc instance_npcname("Fenrir#6mir");
	enablenpc instance_npcname("Iris#6mir");
	enablenpc instance_npcname("Bijou#6mir");

	if (playerattached() && 'exploit_disabled && ep16_royal == 19) {
		erasequest 7700;// Once More!
		setquest 7701;// Lost Imir Heart
		ep16_royal = 20;
	}
	end;
}

1@mir,101,104,0	script	eq#mir6	HIDDEN_WARP_NPC,{
	end;
OnTalk:
	enablenpc instance_npcname("eq#mir6");
	initnpctimer;
	end;
OnTimer20000:
	.@r = rand(3);
	if (.@r == 0)
		unittalk 'boss_id, "碧珠：献给希梅尔梅兹大人！";
	else if (.@r == 1)
		unittalk 'boss_id, "碧珠：嘿……你还活着！";
	else
		unittalk 'boss_id, "碧珠：～窃笑～感受到痛苦了吗？";
	initnpctimer;
	end;
OnStop:
	stopnpctimer;
	end;
}

1@mir,100,95,5	script	Iris#6mir	4_F_IRIS,{
	if (is_party_leader() == false)	// it shouldn't happen
		end;
	if ('step != 8)
		end;
	mes "[艾莉丝]";
	mes "~闷哼~";
	next;
	cutin "bijou_01",2;
	mes "[碧珠]";
	mes "~邪恶的笑声~去死吧！";
	mes "祭司都该死！";
	specialeffect EF_TETRACASTING,AREA, instance_npcname("Iris#6mir");
	next;
	cutin "fenrir_b",2;
	mes "[芬里尔]";
	mes "艾莉丝！！";
	mes "不！住手！！";
	specialeffect EF_TETRACASTING,AREA, instance_npcname("Iris#6mir");
	next;
	cutin "bijou_01",2;
	mes "[碧珠]";
	mes "~轻笑~";
	mes "所以你在找同伴，对吧？";
	mes "主意不错，不过……我觉得太迟了。";
	specialeffect EF_TETRACASTING,AREA, instance_npcname("Iris#6mir");
	next;
	mes "[碧珠]";
	mes "因为……";
	mes "这一击会给你致命一击。哇哈哈哈！";
	specialeffect EF_TETRACASTING,AREA, instance_npcname("Iris#6mir");
	next;
	sleep2 300;
	enablenpc instance_npcname("Sarah#6mir");
	cutin "bijou_03",2;
	mes "[碧珠]";
	mes "……~叹气~";
	mes "嗯？……我的肚子里……";
	mes "这把刀……";
	mes "莎……莎拉？怎么会？";
	specialeffect EF_HFLIMOON1,AREA, instance_npcname("Bijou#6mir");
	next;
	cutin "bijou_death",4;
	mes "[莎拉]";
	mes "你想说的就这些吗？";
	mes "别担心，我会把你的英勇贡献告诉希梅尔兹。别怪我，碧珠。";
	next;
	mes "[碧珠]";
	mes "为什么……告诉我为什么！";
	mes "……那个……那个小姑娘……是因为她是你的妹妹吗？是这样吗？告诉我，莎拉！";
	next;
	mes "[碧珠]";
	mes "~呻吟~";
	specialeffect EF_HFLIMOON1,AREA, instance_npcname("Bijou#6mir");
	disablenpc instance_npcname("Bijou#6mir");
	next;
	mes "[莎拉]";
	mes "……";
	mes "碧珠，你的灵魂已经获得自由。";
	next;
	cutin "hero_iris_01",2;
	mes "[艾莉丝]";
	mes "（是她救了我……？）";
	next;
	mes "[艾莉丝]";
	mes "莎拉……";
	mes "你就是莎拉，对吧？";
	mes "听说我们小时候就分开了……";
	next;
	mes "[艾莉丝]";
	mes "……那你的计划是什么？为什么……为什么要救我？！";
	mes "别以为这会改变我的信念！我永远、永远不会原谅你！";
	next;
	mes "[艾莉丝]";
	mes "妈妈……爸爸……还有镇上的每一个人。我一定会复仇！";
	next;
	cutin "sarah_hero3",2;
	mes "[莎拉]";
	mes "闭嘴！";
	mes "别把自己说得像唯一的受害者。";
	mes "他们只是为自己的罪付出代价——十二年前杀害我母亲的罪。";
	next;
	mes "[莎拉]";
	mes "想让我告诉你真相吗？你不停提到的那些‘亲爱的人’……我们的长老和镇民其实……";
	next;
	mes "[莎拉]";
	mes "……";
	mes "够了……";
	mes "无论如何，尤弥尔之心优先。";
	next;
	mes "[莎拉]";
	mes "记住我的话。";
	mes "我没有让你活着。";
	mes "我很快就会让你死去。";
	mes "下次见面时，我保证你再也见不到阳光。";
	next;
	mes "[莎拉]";
	mes "在那之前，别让任何人杀了你，艾莉丝。";
	mes "那么，今天就先告别吧。";
	disablenpc instance_npcname("Sarah#6mir");
	next;
	specialeffect EF_SCREEN_QUAKE,AREA, instance_npcname("Iris#6mir");
	cutin "fenrir_b",2;
	mes "[芬里尔]";
	mes "~闷哼~那名女武神取走尤弥尔之心时摧毁了天花板！";
	next;
	mes "[芬里尔]";
	mes "我们也最好赶快离开！这里太危险了！";
	close2;
	if (ep16_royal == 19) {
		erasequest 7700;// Once More!
		setquest 7701;// Lost Imir Heart
		ep16_royal = 20;
	}
	warp "prt_lib_q",88,83;
	end;
}


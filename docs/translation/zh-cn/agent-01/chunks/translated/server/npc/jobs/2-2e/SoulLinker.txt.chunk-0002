		mes "帮助他们提升";
		mes "技能。我恳求你，";
		mes "请给我这个机会……";
		close;
	}
	mes "[炼金术士灵魂]";
	mes "...";
	close;
}

job_soul,1,5,0	script	Timer#link3	111,{
	end;

OnEnable:
	initnpctimer;
	end;

OnDisable:
	stopnpctimer;
	set getvariableofnpc(.SoulLinkerTest,"Kid#link1"),0;
	end;

OnTimer60000:
OnTimer120000:
	if (getmapusers("job_soul") == 0) {
		stopnpctimer;
		set getvariableofnpc(.SoulLinkerTest,"Kid#link1"),0;
	}
	end;

OnTimer180000:
OnTimer181000:
OnTimer182000:
	mapwarp "job_soul","morocc",157,47;
	end;

OnTimer183000:
	mapwarp "job_soul","morocc",157,47;
	set getvariableofnpc(.SoulLinkerTest,"Kid#link1"),0;
	stopnpctimer;
}

sec_in02,35,153,0	script	Soul Linker Var	871,{
	callfunc "F_GM_NPC";
	mes "[Soul Linker Var]";
	mes "如果灵魂链接器候选人在转职任务末尾遇到问题，我可以重置灵魂链接器 NPC。若玩家仍在任务地图中，请不要使用此功能。";
	next;
	if (callfunc("F_GM_NPC",1854,0) < 1) {
	mes "[Soul Linker Var]";
	mes "密码错误。";
	close;
	} else {
		mes "[Soul Linker Var]";
		mes "要重置灵魂链接器全局变量吗？";
		next;
		switch(select("Reset:Cancel")) {
	case 1:
		mes "[Soul Linker Var]";
		mes "灵魂链接器转职任务 NPC 已重置。";
		set getvariableofnpc(.SoulLinkerTest,"Kid#link1"),0;
		close;
		case 2:
		mes "[Soul Linker Var]";
		mes "你取消了此命令。";
			close;
			}
			}
			}
			
			//============================================================ 
		// Old changelog

		mes "最好";
		mes "先和玛雅谈谈……";
		mes "我的身份和来历需要";
		mes "复杂的解释……";
		close;
	}
	else if (SOUL_Q > 2) {
		mes "[武僧灵魂]";
		mes "活着时，我的同伴";
		mes "尽力让我确信";
		mes "我作为武僧";
		mes "已经做到了一切。然而……";
		mes "我始终无法完全";
		mes "满足于自己的技能。";
		next;
		mes "[武僧灵魂]";
		mes "死后我有许多遗憾，";
		mes "从未有机会将技能";
		mes "传给未来的武僧。";
		mes "将力量借给他人";
		mes "是我唯一能";
		mes "做到这件事的机会。";
		next;
		set SOUL_Q,4;
		if(checkquest(6008) == -1) {
			changequest 6007,6008;
		}
		mes "[武僧灵魂]";
		mes "我恳求你……";
		mes "我需要你帮助";
		mes "我完全实现";
		mes "当今";
		mes "武僧的真正潜力。";
		close;
	}
	mes "[武僧灵魂]";
	mes "...";
	close;
}


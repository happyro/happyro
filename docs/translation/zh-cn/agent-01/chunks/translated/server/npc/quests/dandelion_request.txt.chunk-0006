que_job01,51,44,1	script	#roombar2	45,1,1,{

OnTouch_:
	if(mao_request == 25 || (mao_request > 102 && mao_request < 123))
	{
		if(mao_request == 121)
		{
			mes "[" + strcharinfo(0) + "]";
			mes "我还不能回到";
			mes "林那里……我还需要";
			mes "彻底调查";
			mes "塔纳托斯塔……";
			close2;
			warp "que_job01",52,50;
			end;
		}
		if(!$@maobar_room2)
		{
			set $@maobar_room2,1;
			donpcevent "#maobartimer2::OnEnter";
			if(mao_request == 25)
			{
				donpcevent "Valdes#3::OnEnter";
				donpcevent "Kidd#3::OnEnter";
				donpcevent "#Rabsent::OnEnter";
			}
			else if(mao_request == 122)
			{
				donpcevent "#mao_empty::OnEnter";
			}
			mes "[Tao]";
			mes "啊，那里受到";
			mes "防护魔法保护，你只能";
			mes "停留 ^4D4DFF4 分钟^000000。";
			mes "别浪费时间，喵！";
			close2;
			if(mao_request > 102 && mao_request < 122) warp "que_job01",80,21;
			else warp "que_job01",144,57;
			end;
		}
		mes "^3355FF门锁着。^000000";
		if(mao_request > 102 && mao_request < 122)
		{
			next;
			mes "[" + strcharinfo(0) + "]";
			mes "嘿，R！是我！";
			mes "能不能请你";
			mes "开门？";
			next;
			mes "[R.]";
			mes "对、对不起，现在";
			mes "不是好时机。请稍后";
			mes "再回来！";
			close2;
			warp "que_job01",52,50;
			end;
		}
		close2;
		warp "que_job01",52,50;
		end;
	}
	mes "[Tao]";
	mes "这里是限制区域，";
	mes "没有许可的话，";
	mes "就立刻出去，";
	mes "喵！";
	close2;
	warp "que_job01",52,50;
	end;
}


					mes "公会会长的命令。";
					mes "好，进去吧。嘿，";
					mes "不过要小心，这不会像";
					mes "大多数任务那样简单……";
					set mao_request,2;
					close;
				}
				mes "[Master]";
				mes "任务……？";
				mes "拜托，你在说什么？";
				mes "别胡言乱语了，";
				mes "点杯饮料吧。";
				next;
				switch( select( "Show Letter of Recommendation" ) )
				{
					case 1:
						break;
				}
				if (countitem(7416))
				{
					mes "[Master]";
					mes "啊，我看出你";
					mes "有备而来。抱歉，";
					mes "但我们有保密规程，";
					mes "我发誓必须遵守。";
					mes "好了，看到那边的";
					mes "骑士了吗？利瑟隆！";
					next;
					mes "[Master]";
					mes "嘿，利瑟隆！让这家伙";
					mes "过去，好吗？";
					mes "对，和利瑟隆谈谈，";
					mes "他会告诉你该往哪里走。";
					next;
					mes "[Litheron]";
					mes "嘿，我什么时候";
					mes "成你的门卫了？！";
					mes "呃，好吧。知道了。";
					set mao_request,2;
					close;
				}
				mes "^3355FF你忘了带上你的";
				mes "推荐信。^000000";
				next;
				mes "[Master]";
				mes "好吧……";
				mes "你现在看起来";
				mes "太可疑了。";
				mes "也许是我错了，但";
				mes "我不喜欢冒险。";
				mes "伙计们，把这家伙请出去！";
				close2;
				warp "morocc",45,106;
				end;
			}
			else if(mao_request == 2)
			{
				if(Class == Job_Assassin || Class == Job_Assassin_Cross)
				{
					mes "[Master]";
					mes "直接穿过";
					mes "利瑟隆身后的门。";
					mes "你知道流程，";
					mes "快点，好吗？";
					close;
				}
				mes "[Master]";
				mes "穿过利瑟隆身后的门，";
				mes "就能了解更多";
				mes "秘密任务的内容。";
				close;
			}
			else if(mao_request > 2)
			{
				if(Class == Job_Assassin || Class == Job_Assassin_Cross)
				{
					mes "[Master]";
					mes "任务进行得";
					mes "怎么样？有时你需要放松";
					mes "休息一下。到那时，";
					mes "我会为你准备饮料。";
					close;
				}
				mes "[Master]";
				mes "任务进行得";
				mes "怎么样？看到你和";
				mes "刺客们相处融洽，";
				mes "真不错。总之，祝你好运。";
				close;
			}
			else if(mao_request == 30 || mao_request == 128)
			{
				if(Class == Job_Assassin || Class == Job_Assassin_Cross)
				{
					mes "[Master]";
					mes "嘿，谢谢你";
					mes "付出的所有努力，伙计。";
					mes "回头见。";
					close;
				}
				mes "[Master]";
				mes "感谢你的帮助，";
				mes "虽然你经历了";
				mes "本不必经历的麻烦。";
				mes "总之，你看起来没事，";
				mes "想回来时随时回来。";
				close;
			}
			else
			{
				if(Class == Job_Assassin || Class == Job_Assassin_Cross)
				{
					mes "[Master]";
					mes "所以你还没有从这里";
					mes "接到任何任务，对吧？";
					mes "顺便问问，你喜欢这里吗？";
					mes "我很喜欢自己的";
					mes "这间小酒馆。";
					next;
					mes "[Master]";
					mes "如果你愿意，我会向会长推荐你";
					mes "参加任务。在那之前，";
					mes "你得专心训练。";
					mes "在训练期间……为什么";
					mes "不享受一杯饮料呢？";
					close;
				}
				mes "[Master]";
				mes "任务……？";
				mes "拜托，你在说什么？";
				mes "别胡言乱语了，";
				mes "点杯饮料吧。";
				close;
			}
		
		case 3:
			mes "[Master]";
			mes "...";
			close;
	}
}


OnTimer543000:
	mapannounce "job3_war02","还剩 1 分钟完成石头结晶……",bc_map;
	end;
OnTimer573000:
	mapannounce "job3_war02","还剩 30 秒完成石头结晶……",bc_map;
	end;
OnTimer583000:
	mapannounce "job3_war02","还剩 20 秒完成石头结晶……",bc_map;
	end;
OnTimer593000:
	mapannounce "job3_war02","还剩 10 秒完成石头结晶……",bc_map;
	end;
OnTimer603000:
	mapannounce "job3_war02","空洞石结晶失败。",bc_map;
	donpcevent "Hollow Stone#Warlock::OnReset";
	end;
OnTimer605000:
	mapwarp "job3_war02","spl_in02",79,102;
	end;
OnTimer607000:
	donpcevent "Hollow Stone#Warlock::OnDisable";
	stopnpctimer;
	donpcevent "The chamber of magic#1::OnEnable";
	end;
}

-	script	Ebein#E1	-1,{
OnInit:
	disablenpc "Ebein#E1";
	end;
OnEnable:
	initnpctimer;
	end;
OnDisable:
	disablenpc "Ebein#E1";
	end;
OnTimer2000:

			getitem 1550,1; //Book
			next;
			mes "[阿贝西·乔治]";
			mes "好了，现在可以向院长展示论文了~";
			mes "你就快完成了~嘻嘻。";
			close;
		}
		else {
			mes "亲爱的，你还在这里做什么？嘻嘻~";
			mes "哦，可怜的宝贝。已经忘了我说的话吗？要我提醒你吗？没问题，嘻嘻。";
			next;
			mes "[阿贝西·乔治]";
			mes "^3355FF1一根鸟羽^000000，用作笔，";
			mes "^3355FF1 张兽皮^000000，用作纸张，";
		mes "^3355FF1 根树枝^000000，用于装订书籍，";
		mes "^3355FF1 鱿鱼墨汁^000000，用作墨水，";
		mes "^3355FF1 空瓶^000000，用于盛放鱿鱼墨汁。";
			next;
			mes "[阿贝西·乔治]";
			mes "你应该准备好所有这些物品，对吧？";
			mes "快回来~！嘻嘻~";
			close;
		}
	}
	else if (SAGE_Q == 15) {
		mes "亲爱的，你在这里做什么？不想去见院长展示你的东西吗？";
		mes "听我的，他不会永远等你，嘻嘻~";
		next;
		mes "[阿贝西·乔治]";
		mes "我知道，我知道……你想和我这个老太婆玩。不过你应该先成为贤者。";
		mes "请快点，嘻嘻。";
		close;
	}
	else {
		mes "哎呀……这里有什么？";
		next;
		mes "[阿贝西·乔治]";
		mes "你不是贤者。真遗憾，像你这么可爱的孩子……";
		mes "既然你不是来办事的，那一定是来……";
		next;
		mes "[阿贝西·乔治]";
		mes "……快乐。等等，你要去哪儿，亲爱的？";
		close;
	}
}

job_sage,50,165,4	script	Test Helper#talk	700,{
	mes "[测试助手]";
	mes "欢迎来到贤者实践考试大厅。";
	mes "想立即参加测试，请进入等候室。";
	next;
	mes "[测试助手]";
	mes "如果有人正在测试，请等对方结束。";
	mes "测试进度会在全地图广播。下一位准备离开等候室时会发布公告。";
	next;
	mes "[测试助手]";
	mes "每人测试需要 5～10 分钟。";
	mes "想离开竞技场，请退出游戏。";
	close;
}

job_sage,50,165,4	script	Waiting Room#sg	700,{
	end;

OnInit:
	//disablenpc  "Waiting Room#sg";
	hideonnpc "Waiting Room#sg";
	waitingroom "等候室",20,"Waiting Room#sg::OnStartArena",1;
	enablewaitingroomevent;
	end;

OnStartArena:
	warpwaitingpc "job_sage",116,97;
	donpcevent "Arena#1::OnEnable";
	disablewaitingroomevent;
	end;

OnEnable:
	enablewaitingroomevent;
	end;
}





//-------------------------------------------------------------------
// Quest: Ahab's Request. Step 1 + 8 (final).
wolfvill,85,111,3	script	Zlan#ep18	4_M_RACHMAN1,{
	if (checkweight(1000405,20) == 0) {
		mes "- 等等！！ -";
		mes "- 你目前携带了太多物品。 -";
		mes "- 请减轻负重后 -";
		mes "- 再试一次。 -";
		close;
	}
	if (ep18_main < 36) {
		mes "[Zlan]";
	mes "你为什么偷听别人的谈话？";
		close;
	}
	switch( isbegin_quest(16560) ) {
	case 0:
		mes "[Zlan]";
	mes "唉，村民会议上又全是胡说八道，那个老头真是的。";
		next;
		mes "[Redcell]";
	mes "那个老头？啊，就是那个不能提名字的人？";
		next;
		mes "[Zlan]";
	mes "我是说，我不能提。";
	mes "听说他在拉赫尔是个大人物，据说在灰狼森林有些影响力。";
		next;
		mes "[Zlan]";
	mes "那个老头，不管是阿哈普还是阿哈布！";
	mes "他在拉赫尔时可不是那样～一定是哪里搞错了～";
		next;
		mes "[Zlan]";
	mes "既然如此，为什么不待在拉赫尔，非要来这里？";
	mes "我真搞不懂！";
		next;
		mes "[Karr]";
	mes "她还没意识到自己在拉赫尔吗？";
	mes "就算睡在漏风的帐篷里，她还没从梦里醒来吗？";
		next;
		mes "[Zlan]";
	mes "想做梦就自己做。";
	mes "为什么要拿你的烦恼打扰别人？";
		next;
		mes "[Redcell]";
	mes "你以为自己是谁，竟敢偷听我们的谈话？";
	mes "你是阿哈布老头的间谍吗？";
		next;
		mes "[Karr]";
	mes "你甚至没有阿哈布那样种杂草的聪明。";
	mes "所以你是谁？偷听别人的闲话，真可耻。";
		next;
		select( "Just a passing traveler." );
		mes "[Zlan]";
	mes "骗子。灰狼森林里哪会有路过的旅人？";
	mes "你一定和我们有某种关系。";
		next;
		mes "[Redcell]";
	mes "你不说的话，我们只能用武力让你开口。";
	mes "你真的要继续撒谎吗？";
		next;
		mes "[Karr]";
	mes "冷静，雷德塞尔。即使兹兰不是路过的旅人，这里也可能有我们不认识但并不突兀的人。";
		next;
		mes "[Zlan]";
	mes "那会是谁？";
		setquest 16560;
		close;
	case 1:
		mes "[Zlan]";
	mes "既然阿哈布开始听取大家的意见……他似乎也没那么坏。";
	mes "对，这就是大人的沟通方式。";
		next;
		mes "[Zlan]";
	mes "幸好他们不会只是捂住彼此的耳朵大喊，闹出更大的麻烦。";
	mes "多亏了你，真是谢谢。";
		close;
	case 2:
		break;
	}
	if (isbegin_quest(16566) == 1) {
		mes "[Zlan]";
	mes "你回来了？阿哈布说了什么？";
	mes "什么？他说现在开始听取别人的意见？";
		next;
		mes "[Zlan]";
	mes "我猜他以前根本没听过。";
		next;
		mes "[Kayar]";
	mes "哼……别取笑了，兹兰。";
	mes "重要的是，他现在决定好好去做。";
		next;
		mes "[Redcell]";
	mes "好啦，好啦。";
	mes "达……我是说，阿哈布为什么改变想法？";
	mes "你一定说服了他，毕竟你身份高贵或人脉广。";
		next;
		mes "[Redcell]";
	mes "多亏了你，我们不用再把人赶出这里了。";
	mes "虽然他说会这样做，但那仍然让人不舒服。";
		next;
		mes "[Kayar]";
	mes "我也许不是村民会议的代表……但我们会表示一些礼貌。";
	mes "有你这样的人在，我们很幸运。";
		completequest 16566;
		getitem 1000405,20;	// Ep18_Amethyst_Fragment
		getexp 7769124,3000000;
		mes " ";
	mes "^4d4dff你获得了积极评价。^000000";
		add_reputation_points(REPUTATION_EP18, 100);
		if (get_reputation_points(REPUTATION_EP18) >= 1000 && ep18_main == 36) {// Custom implementation: reputation 1000 on wolfvill => player can continue the main quest
			ep18_main = 37;
			setquest 18082;
			mes "^4d4dff灰狼村民已接受你成为村子的一员。^000000";
			mes "你有资格参加^4d4dff会议。^000000";
		}
		close;
	}
	if (isbegin_quest(16566) == 2) {
		mes "[Zlan]";
	mes "既然阿哈布开始听取大家的意见……他似乎也没那么坏。";
	mes "对，这就是大人的沟通方式。";
		next;
		mes "[Zlan]";
	mes "幸好他们不会只是捂住彼此的耳朵大喊，闹出更大的麻烦。";
	mes "多亏了你，真是谢谢。";
		close;
	}
	mes "[Zlan]";
	mes "如果你不打算遵守森林的规则，我希望你离开。";
	mes "你也没有什么不同。规则就是要遵守的。";
	next;
	mes "[Zlan]";
	mes "礼仪也是一样。没有礼仪和规则的社会？太野蛮了。";
	mes "我不想生活在蛮荒状态！";
	close;

OnInit:
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "isbegin_quest(16560) == 0 && isbegin_quest(11724) == 2" );
	questinfo( QTYPE_QUEST2, QMARK_YELLOW, "isbegin_quest(16566) == 1" );
	end;
//
}

// Quest: Ahab's Request. Step 2.
wolfvill,83,109,5	script	Karr#ep18	4W_M_03,{
	switch( isbegin_quest(16560) ) {
	case 0:
		mes "[Karr]";
		mes "啊，真麻烦。有件棘手的事。";
		next;
		mes "[Karr]";
		mes "这是关系方面的问题，所以我不想和陌生人谈……";
		close;
	case 1:
		mes "[Karr]";
		mes "如果是重要客人，和他说说也有道理吧？";
		mes "毕竟我们甚至不了解这里领袖们的事务。";
		next;
		mes "[Zlan]";
		mes "真的吗？";
		mes "……不过既然对我们是秘密，他们可能不会告诉我们。";
		next;
		mes "[Redcell]";
		mes "如果他们真的重要，就听我们说。";
		mes "如果不是？他们大概仍然是重要人物。听着。";
		next;
		mes "[Redcell]";
		mes "那个长老……不，那只是我们之间使用的绰号。";
		mes "我们能怎么帮助阿哈普先生？";
		next;
		mes "[Zlan]";
		mes "那家伙真是个讨厌的老头！";
		mes "他总是打断村民会议，说些胡话。";
		next;
		mes "[Zlan]";
		mes "他不听别人说话，只顾喋喋不休，而且毫无用处。";
		mes "他坚持说自己是长老，所以我们该听他讲，但真让人烦躁。";
		next;
		mes "[Zlan]";
		mes "听说他以前对移民们颐指气使，靠他们养活。";
		mes "凭过去就想对本地人发号施令，真是荒谬。";
		next;
		mes "[Karr]";
		mes "如果可以，我只想把他赶走。";
		mes "也许我们汇集意见，强硬地表达立场就行。";
		next;
		mes "[Redcell]";
		mes "嘿，就算那是真的，也不能这样。";
		mes "这里是无处可去的人聚集的地方。";
		next;
		mes "[Redcell]";
		mes "如果我们赶走他，他就无处可去了。";
		next;
		mes "[Zlan]";
		mes "但我们必须永远忍受那场闹剧吗？";
		mes "我也无处可去，所以我就能想怎么做就怎么做吗？";
		next;
		mes "[Karr]";
		mes "如果你那样做，我们都会变成闹剧。我受不了了……";
		next;
		mes "[Redcell]";
		mes "嘿，那边那个高高在上的人！你似乎很关心我们的事，还在听吗？";
		mes "就算你不是什么大人物，也没关系。反正你手腕很广！";
		completequest 16560;
		setquest 16561;
		close;
	case 2:
		break;
	}
	if (isbegin_quest(16566) == 2) {
		mes "[Karr]";
		mes "人很少改变……我是在见证这种罕见的改变吗？";
		next;
		mes "[Karr]";
		mes "也许还需要一些时间，但到目前为止，阿哈普先生似乎可以成为好邻居。";
		close;
	}
	mes "[Karr]";
	mes "在我们村，只有重要人物不参加村务管理会议。";
	mes "当然，决定本身由重要人物作出，但即便如此……";
	next;
	mes "[Karr]";
	mes "所以没人会仅仅因为参加会议就干涉会议。";
	mes "除了阿哈普先生。";
	next;
	mes "[Karr]";
	mes "我一点也不喜欢那种态度……";
	mes "拖得越久，影响就越糟。";
	close;

OnInit:
	questinfo( QTYPE_QUEST2, QMARK_YELLOW, "isbegin_quest(16560) == 1" );
	end;
}

// Quest: Ahab's Request. Step 3.
wolfvill,87,109,3	script	Redcell#ep18	4_M_DESERT,{
	if (isbegin_quest(16566) == 2) {
		mes "[Redcell]";
		mes "阿哈布先生，你似乎变得更容易相处了。";
		mes "虽然仍有很多需要注意的地方，但你比以前好多了。";
		next;
		mes "[Redcell]";
		mes "见证一个人的改变是神圣的时刻。";
		mes "我也该更努力地表现得像个人。";
		close;
	}
	if (isbegin_quest(16562) == 1) {
		mes "[Redcell]";
		mes "把那个老阿哈布变成一个真正的人。";
		mes "人不就该像人一样生活、像人一样行动吗……？";
		next;
		mes "[Redcell]";
		mes "是不是批评得太过分了？……好吧，我承认是有点过分。";
		mes "但一起合作之后，你就会亲自明白。";
		close;
	}
	if (isbegin_quest(16561) == 1) {
		mes "[Redcell]";
		mes "你都听到了吗？";
		mes "只有你能帮助我们解决这份苦恼。";
		next;
		mes "[Zlan]";
		mes "既然确实没有别的办法，如果不奏效，我会征集意见，提议把他逐出村子。";
		next;
		mes "[Redcell]";
		mes "唉，先把那件事放一放吧……";
		mes "但到最后，那大概会是最后的办法。";
		next;
		mes "[Karr]";
		mes "不只是我们感到困扰，所以提出后应该会被接受。";
		mes "参加村民会议的每个人都很为难。";
		next;
		mes "[Redcell]";
		mes "但是！那件事以后再说。";
		mes "在结局到来前，先帮我一把，兄弟。";
		next;
		mes "[Karr]";
		mes "我们无法和那个老头沟通。";
		mes "你为什么不去和他谈谈？";
		next;
		mes "[Redcell]";
		mes "哇，听起来不错。去和他谈谈，弄清他为什么会这样，看看能不能让他改变。";
		mes "这是我一生的请求。";
		next;
		mes "[Zlan]";
		mes "把它当作一生的请求去做吧。我留着它，等我找到恋人时再用。";
		next;
		mes "[Redcell]";
		mes "好啊，没问题。我不会和任何人约会。";
		mes "所以这是我一生的愿望。把那个老顽固变成一个真正的人。";
		next;
		mes "[Karr]";
		mes "看来你的愿望越来越大了。";
		mes "总之，拜托你了。去和阿哈普先生谈谈。";
		erasequest 16561;
		setquest 16562;
		close;
	}
	mes "[Redcell]";
	mes "连一句话都听不懂的人！愚蠢的人！让你不得不重复的人！在工作中表现情绪的人！";
	next;
	mes "[Redcell]";
	mes "隐藏错误却无法挽回的人！无法为自己行为负责的人！";
	next;
	mes "[Redcell]";
	mes "真令人恶心！";
	next;
	mes "[Redcell]";
	mes "为什么这么多人这样讨厌你？";
	mes "不，我只讨厌一个人……就一个人！";
	close;

OnInit:
	questinfo( QTYPE_QUEST2, QMARK_YELLOW, "isbegin_quest(16561) == 1" );
	end;
}

// Quest: Ahab's Request. Step 4 + 6 + 7.
wolfvill,127,155,3	script	Ahab#ep18	4_M_MIDDLE1,{
	if (ep18_main < 36) {
		mes "[Ahab]";
		mes "哦，新面孔。你是这里的居民吗？";
		mes "呵呵，有权势的人记不住所有人也很正常。你会理解的。";
		next;
		mes "[Ahab]";
		mes "我是谁？当然就是阿哈布。";
		mes "我可是一直参加决定村里一切事务的议会，那就是我。";
		close;
	}
	if (isbegin_quest(16566) == 1) {
		mes "[Ahab]";
		mes "我、我也在努力。";
		mes "所以请不要赶我走。";
		next;
		mes "[Ahab]";
		mes "如果被赶出这里，我就无处可去了。";
		mes "所以我一直在用自己的方式努力。但如果所有人都讨厌我……";
		close;
	}
	if (isbegin_quest(16565) == 1) {
		mes "[Ahab]";
		mes "啧啧，好吧，来谈谈礼仪，阿哈布。";
		mes "如果你继续胡说八道，我不会原谅你！";
		next;
		select( "阿哈布，你知道大家都讨厌你吗？" );
		mes "[Ahab]";
		mes "啊……我知道！那又怎样！";
		mes "是我的错吗？他们嘲笑长老年纪大！";
		next;
		select( "问题不在这里。", "这就是你的问题，阿哈布。" );
		mes "[Ahab]";
		mes "你说我有问题是什么意思！";
		mes "我没有任何问题！";
		next;
		select( "你正在考虑把我赶走。" );
		mes "[Ahab]";
		mes "什么，你说什么？不可能！";
		mes "除了这里，我无处可去。";
		next;
		mes "[Ahab]";
		mes "在拉赫尔……一切都很顺利……";
		mes "在当地人中，没有人比我成功，这曾是我的骄傲。";
		next;
		mes "[Ahab]";
		mes "但因为和移民首领产生误会……";
		mes "我失去了全部财富，也无处可去，所以来到了这里。";
		next;
		mes "[Ahab]";
		mes "嘿，我怎样才能避免被赶出这里？";
		next;
		mes "[Ahab]";
		mes "我知道，我在这里没有权力。";
		mes "嗯？我现在既没有权力也没有钱。我该怎么办？";
		next;
		select( "你不需要权力和金钱。", "尊重他人。" );
		mes "[Ahab]";
		mes "嗯，我正在努力。";
		mes "我给年轻人建议，也参加村民会议表达意见。";
		next;
		mes "[Ahab]";
		mes "我的努力错了吗？";
		next;
		select( "不要认为自己高人一等。" );
		mes "[Ahab]";
		mes "但我是成年人！成年人希望被当作成年人对待，有错吗？";
		next;
		select( "那么，也许你应该离开……" );
		mes "[Ahab]";
		mes "嗯，嗯……我该怎么办！";
		next;
		select( "不要一上来就大喊。", "对情况指手画脚只是唠叨。", "听听别人怎么说。", "试着了解这个地方。" );
		mes "[Ahab]";
		mes "啊……我明白了。既然我听了你的建议。";
		mes "我甚至没有提高声音，对吧？";
		next;
		mes "[Ahab]";
		mes "我会试着听取你的建议。";
		mes "所以……请不要把我赶出这里。";
		next;
		mes "[Ahab]";
		mes "我只是想和年轻人好好相处……";
		mes "这就那么令人难受吗？真有点苦涩……";
		next;
		mes "[Ahab]";
		mes "总之，谢谢你没有立即赶我走，而是来和我谈谈。";
		mes "告诉<NAVI>[其他人]<INFO>wolfvill,85,111,0,101,0</INFO></NAVI>，我现在会努力做得更好……";
		erasequest 16565;
		setquest 16566;
		close;
	}
	if (isbegin_quest(16564) == 1) {
		mes "[Ahab]";
		mes "哦，你买了黄瓜酱吗？让我看看。";
		mes "你买对了。";
		next;
		mes "[Ahab]";
		mes "那么，我们该在哪里吃？";
		mes "我有一阵子没在那个寒酸的地方好好吃饭了，现在很饿。";
		next;
		select( "不过在那之前，我们先谈谈……" );
		mes "[Ahab]";
		mes "哦，你这个无礼的年轻人！";
		mes "长老要吃饭时，必须礼貌地等到最后！";
		next;
		mes "[Ahab]";
		mes "在拉赫尔，如果有你这样的人，他们早就会骂我们什么都没学会了！";
		next;
		select( "阿哈布，这是礼仪问题。" );
		mes "[Ahab]";
		mes "阿哈布？阿哈布？不，你只是跑了一趟腿，就开始吹嘘了吗！";
		mes "跑两趟腿后，你就会和他们成为好朋友，还一起吃饭了！";
		next;
		mes "[Ahab]";
		mes "好吧，那就听听你珍贵的意见！";
		mes "……边吃边说！";
		erasequest 16564;
		setquest 16565;
		close;
	}
	if (isbegin_quest(16563) == 1) {
		mes "[Ahab]";
		mes "你怎么还不走？听不懂我的话吗？";
		mes "唉，这里的年轻人就是学不会礼仪。";
		next;
		mes "[Ahab]";
		mes "快去<NAVI>[穆诺玛特]<INFO>rachel,135,64,0,101,0</INFO></NAVI>买黄瓜酱！";
		mes "什么，难道还要我给你钱？快去！";
		close;
	}
	if (isbegin_quest(16562) == 1) {
		mes "[Ahab]";
		mes "哦，新面孔。你是这里的居民吗？";
		mes "呵呵，有权势的人记不住所有人也很正常。你会理解的。";
		next;
		mes "[Ahab]";
		mes "对了，既然你在这里，能帮我个忙吗？";
		mes "不难，是连傻瓜都能做的简单任务。";
		next;
		mes "[Ahab]";
		mes "只是像我这样的人，时间的价值不一样。";
		mes "当然，我可是很贵的。哈哈！";
		next;
		if (select( "I'll run the errand for you.", "I'm not here for that kind of thing." ) == 2)
			end;
		mes "[Ahab]";
		mes "哦，你真高尚。";
		mes "没错，年轻人就该有点高尚品格。";
		next;
		mes "[Ahab]";
		mes "你看，我吃饭时必须配一种美味酱料。";
		mes "没有它，就像什么都没吃一样……";
		next;
		mes "[Ahab]";
		mes "所以，去拉赫尔买些酱料。";
		mes "在穆诺玛特询问黄瓜酱，他们就明白了。";
		next;
		mes "[Ahab]";
		mes "快点，不然会变质。只要从<NAVI>[穆诺玛特]<INFO>rachel,135,64,0,101,0</INFO></NAVI>买一瓶。";
		mes "新鲜是美味的关键。";
		erasequest 16562;
		setquest 16563;
		close;
	}
	mes "[Ahab]";
	mes "在会议上，我试着保持谦逊。";
	mes "然后年轻人的眼神变得柔和了……";
	next;
	mes "[Ahab]";
	mes "我觉得说这不是改变而是态度可能有点奇怪，但世界正在改变。没有人是一成不变的。";
	close;

OnInit:
	questinfo( QTYPE_QUEST2, QMARK_YELLOW, "isbegin_quest(16562) == 1" );
	questinfo( QTYPE_QUEST2, QMARK_YELLOW, "isbegin_quest(16564) == 1" );
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "isbegin_quest(16565) == 1" );
	end;

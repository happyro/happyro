morocc_in,51,101,3	script	Geil	89,{
	mes "[Geil]";
	if(tu_swordman == 15){
		mes "你是当局派来的吗？别再为难我了！我不是杀人犯！我甚至不知道谁被杀了。我不是你要找的人！";
		next;
		mes "[Geil]";
		mes "嗯，是个奇怪的";
		mes "家伙告诉我一些事，";
		mes "只是某种和这一切有关的密码，仅此而已！我知道的就这些！我不是杀人犯，也不是帮凶，什么都不是！";
		next;
		mes "[Geil]";
		mes "^5D478B这就是密码^000000";
		mes "我不敢相信自己竟然无法忘记它。";
		mes "我的意思是，我想我当时喝醉了，";
		mes "那个人告诉我时，我就记住了。";
		next;
		mes "[Geil]";
		mes "这个密码有什么重要的？你们为什么一直因为谋杀案纠缠我？！";
		close;
	}
	if(tu_swordman == 14){
		mes "你是当局派来的吗？别再为难我了！我不是杀人犯！我甚至不知道谁被杀了。我不是你要找的人！";
		next;

sec_in02,34,167,3	script	R.Knight Job Manager	470,1,1,{
	callfunc "F_GM_NPC";
	mes "请输入密码。";
	next;
	if (callfunc("F_GM_NPC","1854",1) == 1) {
		mes "符文骑士转职管理模块启动";
		next;
		switch(select("检查全局变量:一次性修改全局变量")) {
		case 1:
			mes "当前符文骑士转职全局变量为 " + $@job_rune_test1 + "。";
			mes "当前符文骑士考试场地人数为……" + getmapusers("job3_rune02") + "。";
			close;
		case 2:
			set $@job_rune_test1,0;
			mes "符文骑士转职全局变量已修改为 0。现在可以使用考试场地。";
			close;
		}
	}
	close;
}
job3_rune01,1,1,3	duplicate(R.Knight Job Manager)	#renshucheck	844

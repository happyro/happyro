//===== rAthena Script =======================================
//= Assassin Job Quest
//===== Description: =========================================
//= [Official Conversion]
//= Job Change quest for Assassin class.
//===== Changelog: ===========================================
//= 1.0 Used some dialogue from the aegis Assassin script translated By: Pgro Team (OwNaGe)
//=     Also converted the booby traps from the aegis script.[kobra_k88]
//= 1.1 Made adjustments to ontouch npcs to work with the new "ontouch" functionality.
//=     Fixed some duplicate npc names.  Added missing waitingroom triggers.
//=     Fixed warp in "TimerSin", was supposed to be an areawarp.
//=     For some reason sometimes the "Nameless One" would have message windows
//=     without controls.  Changed the doevent that triggers him to an
//=     addtimer and that seemed make the prob. go away[kobra_k88]
//= 1.2 Fixed WRONG skillpoint check! [Lupus]
//= 1.2b Fixed missing commands and typos [Lupus]
//= 1.3 Baby class Support added [Lupus]
//= 1.5 Fixed possible EXP abuse [Lupus]
//= 1.6 Added a func which prevent advanced classes passing
//=     2nd Job Quests again. It also guides adv classes where
//=     to go. [Lupus]
//= 2.0 Changed numbers to constants. [Vicious]
//= 2.1 Removed Duplicates [Silent]
//= 2.2 Merged back JFunc. Fixed missing dialogue [Lupus]
//= 2.3 Fixed typo and change Nameless addtimer to 100 (with 700ms I
//=     was still able to bypass it) [Toms]
//= 2.4 Fixed skipping of Nameless NPC [Lupus]
//= 2.5 Fixed a Rogue exploit [Lupus]
//= 2.6 Rescripted to Aegis 10.3 standards. [L0ne_W0lf]
//= 2.7 Several bugfixes with the help of Samuray22 and Barron-Monster. [L0ne_W0lf]
//= 2.8 Removed duplicate warps. [L0ne_W0lf]
//= 2.8a Deleted unused variables. [Samuray22]
//= 2.8b Fixed error caused in last updated, removed useless variable 'joblvl'. [L0ne_W0lf]
//= 2.9 Fixed an indent and added a 'break;' in hopes of 'fixing' an error [L0ne_W0lf]
//= 2.9a Corrected a Typo error ";;". [Samuray22]
//= 2.9b Moved a wrong 'break'. [Zephyrus_cr]
//= 3.0 Now uses enable and disable waitingroomevent. [L0ne_W0lf]
//= 3.1 Fixed problem with waiting room. (bugreport:1099) [L0ne_W0lf]
//= 3.1a Follow up fix. Forgot to replace a label. [L0ne_W0lf]
//= 3.1b Fixed waiting room not enabled in some situations [Zephyrus]
//= 3.2 Fixed a question having all correct answers. [brianluau]
//= 3.3 Added Quest Log commands. [Kisuka]
//= 3.4 Removed the need for use of 'goto.' [L0ne_W0lf]
//= 3.5 Fixed the waitingroom where player can enter the Test Area without passing the written exam. Now player will not be warp inside the Test Area when did not passed the written exam instead the player will be warp back to the written exam entrance [JayPee]
//= 3.6 Fixed broken event calls. [Euphy]
//= 3.7 Fixed issue that the player can't progress in the quest if timed out at weapon reward step. This issue is fixed on iRO but not on kRO. [https://forums.warpportal.com/index.php?/topic/130060-didnt-receive-necklace-of-oblivion-when-changing-assassin/#entry1496042] [MrAntares]
//= 3.8 Another 'unofficial fix'. Player can't change job if time out after the necklace is deleted. [Atemo]
//============================================================

in_moc_16,19,33,1	script	Guildsman#asn	55,{
	if (Upper == 1) {
		mes "[凶猛的家伙]";
		mes "嗯？你……？";
		mes "我感觉你和大多数人不一样……";
		next;
		mes "[凶猛的家伙]";
		mes "我从没见过像你这么吓人的人！不知为何，我不喜欢你。我觉得你应该离开！";
		close;
	}
	if (SkillPoint) {
		mes "[凶猛的家伙]";
		mes "如果你还留有一转未使用的技能点，就无法转职。先去用掉它们。";
		close;
	}
	if (ASSIN_Q == 4) {
		mes "[凶猛的家伙]";
		mes "别摆出那副表情。真的有那么痛吗？";
		next;
		mes "[凶猛的家伙]";
		mes "哇哇哇，你受伤了，我看得出来。看，我来恢复 HP 和 SP。满意了吗？";
		percentheal 100,100;
		next;
		mes "[凶猛的家伙]";
		mes "活下来有那么难吗？";
		mes "下次努力一点吧？不能太勉强自己成为刺客……";
		next;
		if (select("无论如何我都要成为刺客！:哎呀，我得休息一下。") == 1) {
			mes "[凶猛的家伙]";
			mes "哦……";
			mes "那么，";
			mes "加油吧！";
			close2;
			ASSIN_Q = 0;
			warp "in_moc_16",19,76;
			end;
		}
		mes "[凶猛的家伙]";
		mes "休息一下？好吧，随你。当你觉得准备好成为刺客后再回来。";
		next;
		mes "[凶猛的家伙]";
		mes "想回城就得自己走。对了，别忘了保存出生点，知道吗？";
		close2;
		ASSIN_Q = 0;
		ASSIN_Q2 = 0;
		if (ASSIN_Q3 < 3)
			ASSIN_Q3 = 0;
		savepoint "in_moc_16",18,14,1,1;
		warp "in_moc_16",18,14;
		end;
	}
	if (BaseJob == Job_Thief && countitem(1008) == 0 && ASSIN_Q > 7) {
		mes "[刺客专家“休伊”]";
		mes "嘿，怎么了……？你怎么没带 ^006699遗忘项链^000000？你应该随身携带它，它去哪了？";
		next;
		mes "[刺客专家“休伊”]";
		mes "在公会长发现前赶紧再拿到 ^006699遗忘项链^000000！快去，尽力拿回来！";
		next;
		mes "[刺客专家“休伊”]";
		mes "拿到后带给我！^666666*叹气……*^000000";
		close;
	}
	if (BaseJob == Job_Thief && countitem(1008) > 0 && ASSIN_Q > 7) {
		mes "[刺客专家“休伊”]";
		mes "哎呀，你拿到了。恭喜！但它明显被刮花了，我不能接受。你永远成不了刺客！";
		next;
		mes "[刺客专家“休伊”]";
		mes "哈哈哈~！开玩笑的，别当真。不过我得先让公会长检查这条项链。";
		next;
		mes "[刺客专家“休伊”]";
		mes "...";
		next;
		mes "[刺客专家“休伊”]";
		mes "...";
		mes "......";
		next;
		mes "[刺客专家“休伊”]";
		mes "好了！";
		mes "你通过审核了！";
		next;
		delitem 1008,1; //Frozen_Heart
		changequest 8007,8008;
		completequest 8008;
		callfunc "Job_Change",Job_Assassin;
		callfunc "F_ClearJobVar";		// clears all job variables for the current player
		mes "[刺客专家“休伊”]";
		mes "现在！努力成为优秀的刺客吧！带着信念旅行，以尊严杀戮。随时欢迎回来拜访。再次恭喜。";
		close;
	}
	else if (countitem(1008) > 0 && BaseJob == Job_Thief && ASSIN_Q < 7) {
		mes "[凶猛的家伙]";
		mes "嗯？";
		mes "你想要什么？";
		next;
		mes "[凶猛的家伙]";
		mes "我看你带着 ^006699遗忘项链^000000……你想成为刺客，对吧？让我检查一下……";
		next;
		mes "[凶猛的家伙]";
		mes "...";
		next;
		mes "[凶猛的家伙]";
		mes "...";
		mes "......";
		next;
		mes "[凶猛的家伙]";
		mes "等一下……";
		mes "你这个混蛋！这是假的！";
		next;
		mes "[凶猛的家伙]";
		mes "你竟敢拿假货骗我！你蠢吗！？我应该杀了你……";
		close2;
		warp "moc_fild16",206,229;
		end;
	}
	else {
		mes "[凶猛的家伙]";
		mes "你来这里做什么？";
		mes "我不喜欢你看我的方式……小子。";
		next;
		if (BaseClass == Job_Novice) {
			mes "[凶猛的家伙]";
			mes "嘿，新手。你最好尽快离开这里。我无法保证你的安全。";
			close;
		}
		else if (BaseClass == Job_Swordman) {
			mes "[凶猛的家伙]";
			mes "剑士来这里做什么？去别处砸东西吧，你这个笨蛋。";
			close;
		}
		else if (BaseClass == Job_Mage) {
			mes "[凶猛的家伙]";
			mes "魔法师来这里做什么？";
			next;
			mes "[凶猛的家伙]";
			mes "普隆德拉和朱诺都有欢迎你的图书馆，你不如像魔术一样消失吧？";
			close;
		}
		else if (BaseClass == Job_Archer) {
			mes "[凶猛的家伙]";
			mes "哎呀哎呀。";
			mes "看看那把漂亮的弓。";
			next;
			mes "[凶猛的家伙]";
			mes "没几个弓箭手敢靠近这里。你觉得自己在这里干什么？！";
			close;
		}
		else if (BaseClass == Job_Acolyte) {
			mes "[凶猛的家伙]";
			mes "我就觉得有怪味。上帝的仆人来这里做什么？你不属于这里。";
			close;
		}
		else if (BaseClass == Job_Merchant) {
			mes "[凶猛的家伙]";
			mes "我们这里不喜欢贪婪的人。去别处卖东西吧，钱袋子。";
			close;
		}
		else if (BaseJob == Job_Rogue) {
			mes "[凶猛的家伙]";
			mes "你看起来无忧无虑。希望你在这里休息愉快。没关系，盗贼公会和刺客公会一直相处得很好。";
			next;
			mes "[凶猛的家伙]";
			mes "顺便说……";
			mes "你见过";
			mes "一个叫玛琪的女孩吗？";
			next;
			mes "[凶猛的家伙]";
			mes "玛琪……";
			mes "我们曾约定永远在一起。^666666*叹气……*^000000 我甚至不认为她还记得那个约定。那时我们还很年轻……";
			close;
		}
		else if (BaseJob == Job_Assassin) {
			mes "[刺客专家“休伊”]";
			mes "嘿，我记得你~";
			mes "你的名字是……嗯，我记得，因为听起来很有趣……";
			next;
			mes "[刺客专家“休伊”]";
			mes ":+:" + strcharinfo(0) + ":+:，对吧？不，等等，就叫"+ strcharinfo(0) +"。嗯，最近怎么样？";
			next;
			mes "[刺客专家“休伊”]";
			mes "很遗憾，公会目前没有任务给你。继续专心训练吧。回头见。";
			close;
		}
		else if (BaseJob == Job_Thief && JobLevel > 39) {
			if (SkillPoint) {
	mes "[凶猛的家伙]";
				mes "如果你还留有一转未使用的技能点，就无法转职。先去用掉它们。";
				close;
			}
			else {
		mes "[凶猛的家伙]";
				mes "嗯……";
				mes "盗贼……？";
				next;
	mes "[凶猛的家伙]";
				mes "而且是经验丰富的盗贼，因为我好像找不到钱包了。我们确实需要你这样的人。";
				next;
		mes "[凶猛的家伙]";
				mes "那么，迈出下一步成为刺客如何？";
				next;
				switch(select("是的。我已经完成最后一次扒窃。:有什么要求？:也许以后吧，我得先偷些东西。")) {
				case 1:
	mes "[凶猛的家伙]";
					mes "我已经很久没接待客人了。";
					mes "现在送你去办公室。";
					close2;
					ASSIN_Q = 0;
					if (checkquest(8000) != -1) {
						changequest 8000,8001;
					} else {
						setquest 8001;
					}
					warp "in_moc_16",19,76;
					end;
				case 2:
		mes "[凶猛的家伙]";
					mes "要求？首先你必须是盗贼。其次，盗贼职业等级至少要达到 40。";
					next;
			mes "[凶猛的家伙]";
					mes "第三，你必须通过刺客测试。";
					mes "都记住了吗？如果你相信自己的盗贼能力，就不用担心。";
					close;
				case 3:
	mes "[凶猛的家伙]";
					mes "嗯……";
					mes "好吧。";
					mes "准备好后";
					mes "再回来。";
					close;
				}
			}
		}
		else {
			mes "[凶猛的家伙]";
			mes "哼。你还不够资格成为刺客。你得先满足一些要求。";
			next;
			mes "[凶猛的家伙]";
			mes "继续训练吧。职业等级至少要达到 40，明白吗？当然，超过 40 可能更好。";
			close;
		}
	}
}

in_moc_16,25,90,1	script	Guildsman#ASN2	730,2,2,{
	mes "[刺客“凯”]";
	mes "呃？！";
	emotion ET_SURPRISE;
	next;
	mes "[刺客“凯”]";
	mes "靠近些。我喜欢面对面交谈。为了让你听见而提高声音会让我很恼火。";
	mes "有人在背后和我说话会让我恼火。";
	close;

OnTouch_:
	if (ASSIN_Q2 == 4) {
		mes "[刺客“凯”]";
		mes "咦？";
		mes "你刚才不是";
		mes "才从我身边经过吗？";
		next;
		mes "[刺客“凯”]";
		mes "呃……？！";
		mes "你失败了？";
		mes "连";
		mes "笔试也没通过？";
		mes "哇哈哈哈哈！";
		next;
		mes "[刺客“凯”]";
		mes "嗯……";
		mes "我很久没遇到";
		mes "这么大的失败者了。";
		next;
		mes "[刺客“凯”]";
		mes "哈！";
		mes "哈哈哈哈~！";
		mes "哦，你笑死我了……";
		next;
		mes "[刺客“凯”]";
		mes "抱歉笑你，但这太有趣了！哈哈哈~要我给你一些提示吗？";
		next;
		switch(select("求你了，给我提示。:别笑我！现在给我提示！:……闭嘴，我不需要你的帮助！")) {
		case 1:
			mes "[刺客“凯”]";
			mes "哈啊哈哈哈哈！！！";
			mes "哎呀，真诚实。你还不是刺客，却快把我笑死了，真的笑死我了！";
			next;
			mes "[匿名者]";
			mes "呵呵呵……";
			next;
			mes "[刺客“凯”]";
			mes "匿名者，你听到了吗？！“求你了，给我提示。”哈哈哈！";
			next;
			mes "[匿名者]";
			mes "是的。";
			mes "这个人真有趣，";
			mes "不过是以一种可怜的方式。";
			next;
			mes "[刺客“凯”]";
			mes "哈哈哈哈哈哈！";
			mes "所以，你想要";
			mes "一些提示，对吧？";
			next;
			mes "[刺客“凯”]";
			mes "...";
			next;
			mes "[刺客“凯”]";
			mes "...";
			mes "......";
			next;
			mes "[刺客“凯”]";
			mes "...";
			mes "......";
			mes ".........";
			next;
			mes "[刺客“凯”]";
			mes "...";
			mes "......";
			mes ".........";
			mes "............";
			next;
			mes "[刺客“凯”]";
			mes "...";
			mes "......";
			mes ".........";
			mes "............";
			mes "...............";
			next;
			mes "[刺客“凯”]";
			mes "不。";
			mes "我改变主意了！";
			mes "我最终不会给你任何提示。嘻嘻嘻~";
			close;
		case 2:
			mes "[刺客“凯”]";
			if (Sex == SEX_MALE) {
				mes "哼。如今的盗贼一定很有自信。";
				next;
				mes "[刺客“凯”]";
				mes "好吧好吧，我明白。每个人都会偶尔犯错。抱歉嘲笑你的失误。";
			}
			else
				mes "嗯。我喜欢你的态度。作为盗贼要保持骄傲。抱歉嘲笑你的失误。我相信你下次会做得更好。";
			next;
			mes "[刺客“凯”]";
			mes "我不能给你提示，但可以告诉你更多关于刺客的事……";
			next;
			mes "[刺客“凯”]";
			mes "最重要的是，我们重视尊严。毕竟我们是刺客，人们会需要我们。";
			next;
			mes "[刺客“凯”]";
			mes "如果有人与你关系亲密，他们可能无法理解我的话。由于天性，我们注定孤独。";
			next;
			mes "[刺客“凯”]";
			mes "想象一下恋人或朋友看到你手上的血。他们可能不会继续陪伴你。";
			next;
			mes "[刺客“凯”]";
			mes "有时会感到孤独，但没那么糟。至少我可以做想做的事，按自己的方式行事。";
			next;
			mes "[刺客“凯”]";
			mes "好了，我现在只能告诉你这些。成为刺客";
			mes "让你感到沮丧吗？";
			close;
		case 3:
			mes "[刺客“凯”]";
			mes "……嗯。";
			next;
			mes "[刺客“凯”]";
			mes "对，就是这种精神。永远不要让别人轻视";
			mes "你。我们是刺客……";
			next;
			mes "[刺客“凯”]";
			mes "我为之前嘲笑你道歉。请记住，作为刺客要保持骄傲与尊严。";
			next;
			mes "[刺客“凯”]";
			mes "除了保持骄傲，";
			mes "我希望你尊重可能沾染在卡塔尔或短剑上的鲜血。";
			next;
			if (select("……明白了。:……我不明白。") == 1) {
				mes "[刺客“凯”]";
				mes "好，现在我可以信任你了。让我告诉你一些重要提示。";
				next;
				switch(rand(1,3)) {
				case 1:
					mes "[刺客“凯”]";
					mes "首先，Grimtooth 是专用于卡塔尔的技能，因此不需要任何短剑相关技能。";
					next;
					mes "[刺客“凯”]";
					mes "二刀连击……你没试过吗？它能让你一次攻击敌人两次。";
					next;
					mes "[刺客“凯”]";
					mes "红色魔力矿石是元素石，蓝色宝石与刺客职业完全无关！";
					next;
					mes "[刺客“凯”]";
					mes "你见过法师用冰箭术猎杀长老树精吗？水克火，水压制火，风压制水。";
					next;
					mes "[刺客“凯”]";
					mes "只要靠近阴影、墙壁之类的地方，隐匿术就能完美隐藏你！除非有人使用探测技能。";
					next;
					break;
				case 2:
					mes "[刺客“凯”]";
					mes "'食尸鬼的尖锐腿骨'拥有不死属性。";
					next;
					mes "[刺客“凯”]";
					mes "你目前使用什么武器？达玛斯卡斯？角斗短剑？短剑？还是马刀？现在拿的是什么？";
					next;
					mes "[刺客“凯”]";
					mes "沙漠之狼可能掉落带插槽的卡塔尔。记住这一点，总有一天会用到。";
					next;
					mes "[刺客“凯”]";
					mes "住在地下阴暗潮湿处的朋友可能给你带插槽的Jur。我不知道那家伙为何有这武器……也许是用来挖洞？";
					next;
					mes "[刺客“凯”]";
					mes "还有……";
					mes "我一直想养青蛙当宠物。但不可能！";
					next;
					mes "[刺客“凯”]";
					mes "据我所知，拿锤子的哥布灵拥有地属性。记住火属性克制地属性。";
					next;
					mes "[刺客“凯”]";
					mes "你知道元素武器吗？上面通常刻着铁匠的名字……";
					next;
					break;
				case 3:
					mes "[刺客“凯”]";
					mes "尽快把长老树精卡卖给法师。他们不知为何对这张卡很着迷。它不是能提高角色 INT 吗？嗯……";
					next;
					mes "[刺客“凯”]";
					mes "对我们来说，闪避和攻击比防御更重要。别想着戴头盔，又重又不舒服，还会挡住视线。";
					next;
					mes "[刺客“凯”]";
					mes "'增加闪避'每级技能可使你的闪避率提高 3%。";
					next;
					mes "[刺客“凯”]";
					mes "正如我反复告诉你的：卡塔尔类武器（拳刃/Jur/卡塔尔等）都是双手武器！";
					next;
					mes "[刺客“凯”]";
					mes "沙漠之城……我想念故乡梦罗克。很久没回去了。感觉自己几天前才成为盗贼。时间过得真快……";
					next;
					mes "[刺客“凯”]";
					mes "嘿。我记得盗贼任务。闯入农场取蘑菇时我紧张得要命……";
					next;
					mes "[刺客“凯”]";
					mes "昆虫能侦测隐藏/隐匿技能。它们的触角从不会找不到目标。";
					next;
					mes "[刺客“凯”]";
					mes "我听说巴风特 Jr. 卡片增加 3 点敏捷和 1 点暴击攻击……";
					next;
					mes "[刺客“凯”]";
					mes "是的，我们刺客专精敏捷训练。即使尚未达到最高职业等级，也能获得 10 点敏捷加成。但之后就不会再增加了。";
					next;
				}

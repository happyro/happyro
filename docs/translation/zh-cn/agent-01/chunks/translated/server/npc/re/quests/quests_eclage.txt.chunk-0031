			mes "你打算怎么办？";
			next;
			switch( select("我该帮忙保护宝珠吗？:拜托，我很忙。") ) {
				mes "[Kardui]";
			case 1:
				cutin "kardui01",2;
				mes "听你这么说我很高兴。";
				mes "有你的帮助，宝珠一定会没事的。";
				break;
			case 2:
				cutin "kardui01",2;
				mes "随便。";
				mes "你必须对所见所闻保密。";
				mes "明白吗？";
				break;
			}
			next;
			cutin "kardui05",2;
			mes "[Kardui]";
			mes "谢谢你，哥哥。";
			mes "你们两个把宝珠交给我，去休息一会儿吧。";
			mes "还要答应我保守秘密。";
			next;
			cutin "kardui01",1;
			mes "[Kardui]";
			mes strcharinfo(0) + ".";
		mes "这是给你的礼物。";
		mes "希望我的魔法力量能帮助你提升。";
			specialeffect2 EF_FORESTLIGHT4;
			delitem 6541,1;// Avant_Research_Data
			if (ep14_2_mylord == 23)
				getexp 400000,300000;
			else
				getexp 350000,250000;
			ep14_2_mylord = 24;
			completequest 7444;
		}
		else {
			cutin "kardui01",1;
		mes "那么，你们有什么好消息吗？";
		mes "阿凡特在研究什么？";
			next;
			mes "[Kardui]";
		mes "你这是什么表情？";
		mes "你什么都没带来？";
		mes "你忘了把东西放在哪里了吗？去带来。";
		}
	}
	else if (ep14_2_mylord == 24) {
		cutin "kardui01",1;
		mes "我命令卫兵加强宝珠周围的巡逻。";
		mes "事情发生得太突然，他们似乎很困惑，不过……";
		next;
		mes "[Kardui]";
		mes "我相信大家都会为了宝珠的利益挺身而出。";
		mes "涉及保护宝珠时，没人会反对。";
	}
	else if (ep14_2_mylord == 25) {
		cutin "kardui01",1;
		mes "原来你和我哥哥谈过这些事。";
		mes "现在想想，他确实在资助阿凡特。";
		next;
		mes "[Kardui]";
		mes "不，更准确地说，他不知道自己资助的学者就是阿凡特。";
		mes "总之，他个人资助的事我无权过问。";
		next;
		mes "[Kardui]";
		mes "正如我哥哥所说，如果你能帮助我们，我们会非常高兴。";
		mes "我们需要你的帮助。";
	}
	else if (ep14_2_mylord == 26) {
		mes "我一直在等你。我哥哥告诉过我你的事。";
		mes "因为太专注于寻找阿凡特，我完全忘了参谋长。";
		cutin "kardui01",1;
		next;
		cutin "hisie01",0;
		mes "[Hisie]";
		mes "你查到什么了吗？";
		mes "表面上看，没有任何疑点。";
		mes "他偶然资助了一名学者，而那名学者又是他偶然遇到的。";
		next;
		if (isbegin_quest(7446) == 1) {
			select("当我把一切告诉他时……");
			mes "[Kardui]";
			mes "你告诉他那位学者就是阿凡特了吗？";
			mes "也告诉他研究的事了吗？";
			cutin "kardui01",2;
			next;
			cutin "hisie01",0;
			mes "[Hisie]";
			mes "但最后，谢尼梅并不知道自己资助的学者是谁，也不知道那位学者的个人研究？";
			next;
			cutin "hisie02",0;
			mes "[Hisie]";
			mes "但他也可能明明什么都知道，却假装一无所知。";
			mes "这样下去我们什么也查不出来……";
			erasequest 7446;
			next;
		}
		select("比起魔法学者，他对宝珠更感兴趣。" );
		cutin "kardui03",2;
		mes "[Kardui]";
		mes "真遗憾……";
		mes "那么，更可能是阿凡特自行进行研究？";
		mes "顺便说一句，每个拉斐尔都对宝珠很感兴趣。";
		next;
		select("他想把我牵扯进去。" );
		cutin "hisie03",0;
		mes "[Hisie]";
		mes "把你牵扯进去？什么意思？";
		next;
		mes "告诉他你和谢尼梅的谈话。";
		next;
		mes "[Kardui]";
		mes "……哇……如果他这么不信任我，为什么还让我待在这个位置上？";
		mes "难道是因为除非我死去，市长的权力不能转让？";
		cutin "kardui01",2;
		next;
		mes "[Kardui]";
		mes "无论我多么努力，似乎都不足以消除他们之间的不信任。";
		mes "虽然我早就知道，但再次听到还是让我感到孤独。";
		cutin "kardui03",2;
		next;
		cutin "hisie02",0;
		mes "[Hisie]";
		mes "别把它放在心上。";
		mes "让他们爱怎么想就怎么想，别理他们。";
		mes "卡尔，你只要坚定自己的信念就好。";
		next;
		cutin "hisie01",0;
		mes "[Hisie]";
		mes "除此之外，我确定谢尼梅隐瞒了什么。";
		mes "否则，他不会让你这样的外人负责宝珠。";
		next;
		mes "[Kardui]";
		mes "你说得对，哥哥。";
		mes "他让你等着看？把你当成希望我正常的见证人？";
		mes "我以为他和其他官员不同，不带偏见地对待我，但这一切都是谎言……";
		cutin "kardui02",2;
		next;
		cutin "hisie01",0;
		mes "[Hisie]";
		mes "卡尔，他只是众多拉斐尔中的一个。";
		mes "你早就知道了，没什么新鲜的。";
		next;
		cutin "hisie02",0;
		mes "[Hisie]";
		mes "没关系。总有一天，大家都会认识到";
		mes "你不是需要保护的玩偶，而是真正的市长。";
		next;
		mes "[Kardui]";
		mes "没错。如果我只被感情牵着走，就和塞内特没有区别。";
		mes "让我们想想眼下面临的问题。";
		cutin "kardui01",2;
		next;
		mes "[Kardui]";
		mes strcharinfo(0);
		mes "我好像总是在拜托你。";
		mes "这次也请帮帮我。";
		next;
		select("听候差遣。" );
		mes "[Kardui]";
		mes "谢尼梅为什么要把你牵扯进来？当然，他可能是为了见证人、证据之类的理由……";
		mes "但我确定还有更深层的原因。";
		next;
		mes "[Kardui]";
		mes "我无法摆脱这种不安……";
		mes "而且这和你、宝珠以及谢尼梅有关。";
		next;
		mes "[Kardui]";
		mes "但知道可能是案件关键的你站在我这边，我就安心多了。";
		mes "我不知道谢尼梅为何要把你牵扯进来，但你应该主动接近他。";
		next;
		mes "[Kardui]";
		mes "拜托你了。";
		cutin "kardui04",2;
		next;
		cutin "hisie01",0;
		mes "[Hisie]";
		mes "我会在这里待一阵子，所以如果你发现什么，随时直接来找我。";
		mes "Thanks.";
		ep14_2_mylord = 27;
		if (isbegin_quest(7447) == 1)
			erasequest 7447;
		setquest 7448;
	}
	else if (ep14_2_mylord == 27) {
		cutin "kardui01",2;
		mes "我想知道这份不安究竟意味着什么。";
		mes "这会是来自世界树的警告吗？";
		next;
		mes "[Kardui]";
		mes "希望我对谢尼梅的担忧是多余的。";
		mes "现在我什么都无法确定。";
		next;
		mes "[Kardui]";
		mes "所以，谢尼梅就拜托你了。";
		mes "我不是这里的统治者，没什么能帮你的。";
		mes "抱歉总是拜托你这么多事。";
		cutin "kardui02",2;
	}
	else if (ep14_2_mylord == 28 || ep14_2_mylord == 29) {
		.@quest_7449 = isbegin_quest(7449);
		if (.@quest_7449 == 1) {
			mes "哇，越来越有趣了！";
			mes "他到底为什么要这么做？";
			mes "每个拉斐内人都知道天花板上的灯。";
			cutin "kardui04",2;
			next;
			mes "[Kardui]";
			mes "知道这件事，和故意让别人知道这件事之间有巨大差别。";
			mes "我想亲自质问他，但既然你也卷入其中，最后看起来会像是我造成了这一切。";
			next;
			cutin "hisie02",0;
			mes "[Hisie]";
			mes "Don't be impatient. ";
			mes "还什么都没发生。";
			mes "相反，我们不是应该考虑今后如何对付谢尼梅吗？";
			next;
			select("希茜说得对。");
			cutin "kardui04",2;
		}
		else {
			cutin "kardui04",2;
			mes "我们必须查明参谋长为什么要带你去灯光室。";
			mes "现在只能先静观其变吗？";
			next;
		}
		mes "[Kardui]";
		mes "……我们现在能做的事……";
		mes strcharinfo(0) +"，就是照谢尼梅说的去做，并查明真相……？";
		next;
		cutin "kardui03",2;
		mes "[Kardui]";
		mes "我想没有别的办法了。";
		mes "以防万一，我会派增援过去。";
		mes "照谢尼梅的要求去做吧。";
		next;
		mes "[Kardui]";
		mes "目前我们只能相信……谢尼梅并非有意做这一切。";
		if (.@quest_7449 == 1)
			changequest 7449,7450;
	}
	else if (ep14_2_mylord == 30) {
		cutin "kardui02",2;
		mes "都是我的错……让你……经历了这些。";
		mes "对不起……";
		next;
		select("奥术球怎么办？");
		mes "[Kardui]";
		mes "拉斐内人还不知道。";
		mes "虽然奥术球的核心已经消失，但我和弟弟正在收集魔力，不断为奥术球提供能量。";
		next;
		cutin "kardui04",2;
		mes "[Kardui]";
		mes "不过那只是视觉上的把戏……但没人注意到。";
		mes "没想到，我们的魔法力量还挺强。";
		mes "哈哈……我们该为此感谢阿凡特吗？";
		next;
		mes "[Kardui]";
		mes "我只是比平时累了两三倍。";
		mes "如果你问我的感受，魔力正从我体内渗出，感觉并不好。";
		mes "我能收集这些充沛的魔力，填满奥术球的核心吗？";
		next;
		cutin "hisie02",0;
		mes "[Hisie]";
		mes "......Don't work too hard.";
		mes "无论我提供多少帮助，我们的魔力总有一天会达到极限。";
		next;
		cutin "kardui04",2;
		mes "[Kardui]";
		mes "那件事以后再想吧。";
		mes "总之……我听尼德霍格说，";
		mes "参谋长似乎被梦罗克的下属操纵了。";
		next;
		cutin "kardui02",2;
		mes "[Kardui]";
		mes "我怎么会不知道呢。";
		mes "……难道我真的只是名义上的国王……";
		next;
/*
		mes "[Loki]";
		mes "那就是他们的伎俩。";
		mes "别把责任归咎于自己。";
		mes "总之，如果奥术球的魔力如此强大，不是应该留下巨大的能量痕迹吗？";
		next;
		mes "[Hisie]";
		mes "我也这么想过，所以搜查了这片区域。";
		mes "虽然很模糊，但我在彩虹桥附近感受到它……";
		next;
*/
		mes "[Kardui]";
		mes "我们必须处理奥术球和谢尼梅，但现在最大的问题是"+ strcharinfo(0) +"正在负责的事——";
		mes "大家都要记住这一点。";
		cutin "kardui01",2;
		next;
		cutin "hisie01",0;
		mes "[Hisie]";
		mes "我明白了。情况不妙，因为长老们把灯光室发生的事件归咎于你。";
		next;
		cutin "kardui01",2;
		mes "[Kardui]";
		mes "我只是告诉长老们奥术球没问题。";
		mes "他们最在意的是士兵的死亡以及谢尼梅的下落。";
		next;
		select("Tell him about Avant.");
		mes "[Kardui]";
		mes "没错。阿凡特就在那座监狱里，你曾在那里被关了一会儿。";
		mes "我差点忘了他才是这件事的主谋。";
		next;
		mes "你告诉了他你与阿凡特交谈的内容。";
		next;
		cutin "hisie03",0;
		mes "[Hisie]";
		mes "...........";
		mes "所以到最后，我们都被谢尼梅操纵了，不，我是说被魔王操纵了。";
		next;
/*
		mes "[Loki]";
		mes "我不是告诉过你吗，那就是他们的伎俩。";
		mes "被欺骗的不只有你们拉斐内人。";
		next;
		mes "[Nydhog]";
		mes "他说得对。我……可能才是第一个。";
		mes "我真的很抱歉，想向前任市长道歉。";
		next;
		mes "[Nydhog]";
		mes "我中了邪恶之人的诡计，未能履行守护者的职责，";
		mes "使世界树患病，最终让前任市长失去了作用。";
		next;
		mes "[Kardui]";
		mes "……所以一切都是相互关联的。";
		mes "我认为他们也藏在约顿海姆的巨人之中。";
		mes "对吧？";
		next;
		mes "[Loki]";
		mes "目前还没有可疑动静，但他们很可能就在其中。";
		mes "也有人在严密监视。交给他们吧。";
		next;
*/
		cutin "hisie01",0;
		mes "[Hisie]";
		mes "那么我们回到"+ strcharinfo(0) +"的问题……";
		mes "幸运的是，你帮助过的拉斐内人都站在你这边。";
		next;
		cutin "kardui01",2;
		mes "[Kardui]";
		mes "那就放心了。";
		mes "不过，即使他们承认外界发生的是正当防卫，";
		mes "他们内心深处不会相信。";
		next;
		select("I'll go after Shenime!");
		mes "["+ strcharinfo(0) +"]";
		mes "虽然我是在正当防卫，但我确实……伤害了士兵。";
		mes "给我一个赎罪的机会。";
		mes "我会找到一切的主谋谢尼梅，也会找到奥术球！";
		next;
		mes "[Kardui]";
		mes "……既然你这么认为，";
		mes "我会让你负责这起事件，并命令你去寻找谢尼梅。";
		next;
		mes "[Kardui]";
		mes "如果你能找到宝珠就再好不过了，";
		mes "但我们也必须做好最坏的准备。";
		mes "我要去和阿凡特谈谈。";
		next;
		cutin "kardui04",2;
		mes "[Kardui]";
		mes "……那本来是杀死他的绝佳机会。";
		mes "真可惜。";
		mes "现在我得拜托他一件事。";
		next;
		cutin "hisie02",0;
		mes "[Hisie]";
		mes "卡尔，一切都会好起来的。";
		mes "别急。";
		mes "这里有守护者，一切都会顺利解决。";
		next;
/*
		mes "[Nydhog]";
		mes "没错。朱恩市长，世界树的守护者。";
		mes "我，尼德霍格，也会像你一样作为守护者帮助你。";
		next;
		mes "[Nydhog]";
		mes "我会帮忙补充宝珠的魔力。";
		mes "这是赎罪的机会。";
		mes "我会为你们两人使用全部魔力。";
		next;
*/
		cutin "hisie01",0;
		mes "[Hisie]";
		mes "那么我们基本决定了，对吧？";
		mes "让卡尔继续处理公务，"+ strcharinfo(0) +"负责寻找谢尼梅。";
		mes "至于我，我会留在卡尔身边，因为我也要为宝珠补充魔力。";
		next;
		cutin "kardui01",2;
		mes "[Kardui]";
		mes "听你这么说真好，哥哥。";
		next;
		mes "[Kardui]";
		mes "我会设法保证你的行动自由，";
		mes "所以请找到谢尼梅。";
		mes "根据我哥哥的说法，^4d4dff你应该能在彩虹桥某处找到线索。^000000";
		ep14_2_mylord = 31;
		changequest 7451,7452;
	}
	else if (ep14_2_mylord == 31) {
		cutin "kardui01",1;
		mes "照明室事件已被证明是正当防卫。";
		mes "现在你可以自由前往任何地方。";
		next;
		mes "[Kardui]";
		mes "请找到谢尼梅。";
		mes "根据我哥哥的说法，^4d4dff你应该能在彩虹桥某处找到线索。^000000";
	}
	else if (ep14_2_mylord == 32) {
		cutin "kardui01",1;
		mes "一个身上有洞的尸体……";
		mes "参谋长也被操纵了。";
		mes "他的名字是谢尼梅，对吧？";
		mes "那么参谋长原本的名字可能是什么……";
		next;
		cutin "kardui03",1;
		mes "[Kardui]";
		mes "怎么会没人知道？";
		mes "难道是因为我们思想懒惰又粗心……？";
		next;
		cutin "kardui04",1;
		mes "[Kardui]";
		mes "我自己也必须保持警惕。";
		mes "参谋长的尸体会帮助我将意志强加于他人。";
		next;
		mes "[Kardui]";
		mes "这可能很艰难，但从现在起，我会准备与魔王战斗。";
		mes "这是我目前能做的最好准备。";
		next;
		cutin "kardui01",1;
		mes "[Kardui]";
		mes "一直以来你帮了我大忙。";
		mes "你愿意现在以及永远都做我的朋友吗？";
		mes "愿世界树的祝福与你同在……";
		specialeffect2 EF_FORESTLIGHT4;
		npcskill "AL_BLESSING",1,0,0;
		ep14_2_mylord = 33;
		completequest 7453;
		getexp 500000,400000;
	}
	close2;
	cutin "",255;
	end;
}

eclage,112,40,3	script	Eclage Guard Leo#tl	4_M_FAIRYSOLDIER2,{
	if (!checkweight(1301,3)) {
		mes "- 你携带的物品太多，无法继续任务。 -";
		close;
	}
	if (ep14_2_mylord < 11) {
		if (ep14_2_mylord < 7) {
			mes "[Leo]";
			mes "欢迎来到艾可拉玖，拉斐尔的首都，也是通往阿尔普海姆的门户。";
			mes "希望你旅途愉快。";
		}
		else if (ep14_2_mylord == 7) {
			switch( isbegin_quest(7420) ) {
			case 0:
				mes "[Leo]";
				mes "嗨，你好吗？";
				emotion ET_SURPRISE;
				next;
				mes "[Leo]";
				mes "你真的还好吗！";
				next;
				mes "[Leo]";
				mes ".....";
				next;
				switch( select("他想要什么？:这是个奇怪的妖精！") ) {
				case 1:

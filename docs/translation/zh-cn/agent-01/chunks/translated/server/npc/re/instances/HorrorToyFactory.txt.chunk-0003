1@xm_d,218,145,5	script	Catherine Jet Johnson#6	4_F_SKULL06GIRL,{
	end;
OnStart:
	sleep 1000;
	npctalk "凯瑟琳·杰特·约翰逊：遗憾的是，我没能说服琪米。";
	sleep 3000;
	npctalk "凯瑟琳·杰特·约翰逊：那个幻影的声音是什么？为什么如此残酷地折磨琪米……";
	sleep 4000;
	npctalk "凯瑟琳·杰特·约翰逊：我想，我脸上的诅咒来自那个身份不明的声音。";
	sleep 4000;
	npctalk "凯瑟琳·杰特·约翰逊：总之，即使琪米憎恨所有人，也在这里留下了许多回忆。";
	sleep 6000;
	npctalk "凯瑟琳·杰特·约翰逊：即使她的灵魂回来，我也会安全地结束这一切，不让她失望。";
	sleep 5000;
	npctalk "凯瑟琳·杰特·约翰逊：多亏了你，我所有的疑惑都彻底解决了。如果下次要送她上天堂，请再叫我。";
	sleep 5000;
	npctalk "凯瑟琳·杰特·约翰逊：我会打开出口。我先出去，你跟着我就好。";
	sleep 3000;
	disablenpc instance_npcname("Catherine Jet Johnson#6");
	enablenpc instance_npcname("#exwp1");
	end;
}


//===== rAthena Script ======================================= 
//= Grade A and Grade S weapon quests
//===== By: ================================================== 
//= Vicious_Pucca, Reddozen & MasterOfMuppets
//===== Current Version: ===================================== 
//= 1.6
//===== Compatible With: ===================================== 
//= rAthena Project; SVN 3422+
//===== Description: ========================================= 
//= [Official Conversion]
//= Grade A and Grade S weapon quests
//===== Additional Comments: ================================= 
//= 1.0 First Version, Credits goes to Vicious_Pucca for converting [MasterOfMuppets]
//=     the quest from aegis format to eA format. Also thanks to 
//=     reddozen for fixing bugs.
//= 1.1 Many fixes to spelling, grammar, and sentence order. [Silent]
//= 1.2 A small fix, thanks to vicious_pucca [MasterOfMuppets]
//= 1.21 Fixing MoM's typos (Citrin -> Citrine) [erKURITA]
//= 1.3 Redirected error message for "LV_16" to "LV_16_NOGEM" (Gepard) [L0ne_W0lf]
//= 1.4 Fixed bad NPC header data to comply with rev. 11603. [L0ne_W0lf]
//= 1.5 Rescripted to Aegis 10.3 standards. [L0ne_W0lf]
//= 1.6 Was using the wrong IDs for the ores needed. [L0ne_W0lf]
//============================================================ 

umbala,117,285,3	script	Bazo#lv4	85,{
	if (checkweight(908,300) == 0) {
		mes "^3355FF等一下！你现在携带的物品太多了。请先把部分物品存入卡普拉仓库后再回来。^000000";
		close;
	}
	if (lv4_weapon == 0) {
		mes "[Bazo]";
		mes "你好……";
		mes "你不是这里的人，";
		mes "对吧？";
		next;
		mes "[Bazo]";
		mes "我叫巴佐·赫布里奇。很高兴认识你。正如你所见，我也不是这里的人。感觉……我们注定会相遇。";
		next;
		mes "[Bazo]";
		mes "如果你不介意，我来告诉你一些这里的情况。刚到这里时，我就察觉到这个村子有些不同。";
		next;
		mes "[Bazo]";
		mes "首先，乌姆巴拉离死者之国尼夫海姆很近。因为距离如此之近，这里有些人甚至能从那里汲取邪恶力量。";
		next;
		mes "[Bazo]";
		mes "别担心，当地人只用这种力量制作特殊物品。我在这里逗留期间，也学会了一些制作方法。";
		next;
		mes "[Bazo]";
		mes "如果你愿意，我可以展示一下我的手艺。你觉得怎么样？";
		next;
		switch(select("听起来不错～:不用了，谢谢。")) {
		case 1:
			if (BaseLevel < 70) {
				mes "[Bazo]";
				mes "嗯。你现在应该先提升等级、变得更强。";
				mes "我这么说是出于好意，请理解你还没准备好使用我的商品。";
				next;
				mes "[Bazo]";
				mes "正如我之前所说，这些商品带有邪恶力量。";
				mes "如果不够强或经验不足，可能会被逼疯。";
				next;
				mes "[Bazo]";
				mes "等你准备好后，";
				mes "我很乐意为你制作好东西～";
				close;
			}
			mes "[Bazo]";
			mes "太好了！我来告诉你需要哪些材料。数量不多，不过你最好记下来。";
			next;
			mes "[Bazo]";
			mes "首先需要一些基础材料：";
			mes "10个黄金、50个钢铁和10个铝。";
			next;
			mes "[Bazo]";
			mes "然后需要稀有矿石为成品附魔。成品的特性取决于你使用的矿石。";
			next;
			mes "[Bazo]";
			mes "请带来30个黄水晶、绿松石或玛瑙中的任一种。祝你顺利找到这些东西，我会等着你～";
			set lv4_weapon,1;
			close;
		case 2:
			mes "[Bazo]";
			mes "哦，好吧。";
			mes "我没关系。";
			mes "不过如果你改变主意，我会一直在这里。";
			close;
		}
	}
	if (lv4_weapon > 7) {
		mes "[Bazo]";
		mes "嗯……";
		mes "我感觉你有些不同。虽然无法准确描述，但我清楚地感到自己帮不了你。";
		next;
		mes "[Bazo]";
		mes "无论如何，冒险者，祝你旅途平安。";
		close;
	}
	if ((lv4_weapon >= 5) && (lv4_weapon <= 7)) {
		mes "[Bazo]";
		mes "太好了……！";
		mes "现在开始吧！";
		mes "对了，我现在还不知道最终会得到什么。";
		mes "希望结果会很棒。";
		next;
		mes "^3355FF你感到材料周围聚集起神秘的能量，";
		mes "周围的空气开始噼啪作响，仿佛材料正在吸收所有环境能量。^000000";
		next;
		mes "^3355FF巴佐没有做出任何明显的动作，材料却开始彼此融合。^000000";
		next;
		mes "[Bazo]";
		mes "感觉到了吗？材料正在自行聚集力量。现在已经超出我的控制，只有等待并祈祷了。";
		next;
		mes "^3355FF材料融合完成，";
		mes "空气也恢复了平静。^000000";
		next;
		mes "[Bazo]";
		mes "哦哦哦！完成了！";
		mes "我们成功了！啊，太惊人了！";
		mes "我们的祈祷一定得到了回应！";
		next;
		mes "[Bazo]";
		mes "那些材料似乎变成了某种武器。对你应该很有用。现在让我看看……";
		next;
		mes "[Bazo]";
		if (lv4_weapon == 5) {
			mes "无形之剑！";
			mes "这把剑天生就属于你！";
			mes "恭喜，希望它能派上用场。";
			set lv4_weapon,0;
			getitem 1141,1; //Immaterial_Sword
		}
		else if (lv4_weapon == 6) {
			mes "斩击！";
			mes "这把钝器天生就属于你！";
			mes "恭喜，希望它能派上用场。";
			set lv4_weapon,0;
			getitem 1526,1; //Slash
		}
		else if (lv4_weapon == 7) {
			mes "四方锤！";
			mes "这把钝器天生就属于你！";
			mes "恭喜，希望它能派上用场。";
			set lv4_weapon,0;
			getitem 1527,1; //Quadrille
		}
		next;
		mes "[Bazo]";
		mes "啊，我对结果非常满意。如果你还想要一件，随时欢迎来找我。好了，祝你旅途愉快～";
		close;
	}
	if (((lv4_weapon == 2) && (countitem(7295) > 29)) || ((lv4_weapon == 3) && (countitem(7294) > 29)) || ((lv4_weapon == 4) && (countitem(7291) > 29))) {
		if (lv4_weapon == 2) {
			set .@itemreq,7295; // Citrine
		}
		else if (lv4_weapon == 3) {
			set .@itemreq,7294; //Turqoise
		}
		else if (lv4_weapon == 4) {
			set .@itemreq,7291; // Agate
		}
		mes "[Bazo]";
		mes "好了，你看起来已经准备好了，我们开始吧。";
		mes "我最喜欢的魔物是波利、土人、水母和米诺斯。";
		next;
		for( set .@i, 1; .@i <= 5; set .@i,.@i+1 ) {
			setarray .@mons[.@i],rand(1,4);
			mes "[Bazo]";
			if (.@i == 1) {
				mes "这是第一个问题。";
				mes "我现在想的是哪种魔物？";
			}
			else if (.@i == 2) {
				mes "好吧……";
				mes "猜猜我现在想的是哪种魔物……就是现在！";
			}
			else if (.@i == 3) {
				mes "这次我想的是哪种魔物？";
			}
			else if (.@i == 4) {
				mes "我现在想的是哪种魔物？";
			}
			else if (.@i == 5) {
				mes "好吧，最后一次。";
				mes "猜猜我现在想的是哪种魔物。";
			}
			next;
			set .@answer,select("波利:土人:水母:米诺斯");
			if (.@answer == .@mons[.@i]) {
				set .@dap,.@dap + 1;
			}
		}
		mes "[Bazo]";
		mes "好了，我按思考顺序告诉你答案。看起来也许像是我现在编的，但并不是。我们必须互相信任。";
		next;
		mes "[Bazo]";
		for( set .@i, 1; .@i <= 5; set .@i,.@i+1 ) {
			if (.@mons[.@i] == 1) {
				mes "波利";
			}
			else if (.@mons[.@i] == 2) {
				mes "土人";
			}
			else if (.@mons[.@i] == 3) {
				mes "水母";
			}
			else if (.@mons[.@i] == 4) {
				mes "米诺斯";
			}
		}
		if (.@dap > 0) {
			delitem .@itemreq,30;
			set lv4_weapon,lv4_weapon+3;
		}
		else if (.@dap < 1) {
			delitem .@itemreq,10;
		}
		next;
		if (.@dap > 0) {
			mes "[Bazo]";
			mes "你答对了" + .@dap + "次！太厉害了！如约定，我会为你制作乌姆巴拉特产。给我一点准备时间，然后我们就开始。";
			close;
		}
		else if (.@dap < 1) {
			mes "[Bazo]";
			mes "嗯。你一定不会读心，或者只是运气太差。";
			mes "不管怎样，在驱散你身边的厄运前，我们无法再试。";
			next;
			mes "[Bazo]";
			mes "嗯，至少需要10个"+getitemname(.@itemreq)+"才能再试一次，";
			mes "把它们交给我吧。";
			next;
			mes "[Bazo]";
			mes "如果还想再玩一次读心游戏，就带着材料回来吧。";
			mes "我会等着测试你的运气。";
			close;
		}
	}
	if ((lv4_weapon == 2) || (lv4_weapon == 3) || (lv4_weapon == 4)) {
		mes "[Bazo]";
		mes "嗯，感觉不太对。我们一定漏了什么。";
		mes "请再检查一下你带来的材料。";
		close;
	}
	if ((lv4_weapon == 1) && (countitem(969) > 9) && (countitem(999) > 49) && (countitem(714) > 9)) {
		mes "[Bazo]";
		mes "哦，你带来了全部基础材料。现在让我看看你有没有带我要求的稀有矿石……";
		next;
		if ((countitem(7295) > 29) || (countitem(7294) > 29) || (countitem(7291) > 29)) {
			if ((countitem(7295) > 29) && (countitem(7294) > 29) && (countitem(7291) > 29)) {
				mes "[Bazo]";
				mes "哈哈哈，我让你带一种矿石，不是全部。你想使用哪一种？";
				next;
				switch(select("黄水晶:绿松石:玛瑙")) {
				case 1:
					set .@itemreq,7295; // Citrine
					break;
				case 2:
					set .@itemreq,7294; //Turqoise
					break;
				case 3:
					set .@itemreq,7291; // Agate
					break;
				}
			}
			else if ((countitem(7295) > 29) && (countitem(7294) > 29)) {
				mes "哈哈哈，我让你带一种矿石，不是两种。";
				mes "你想使用哪一种？";
				switch(select("黄水晶:绿松石")) {
				case 1:
					set .@itemreq,7295; // Citrine
					break;
				case 2:
					set .@itemreq,7294; //Turqoise
					break;
				}
			}
			else if ((countitem(7295) > 29) && (countitem(7291) > 29)) {
				mes "哈哈哈，我让你带一种矿石，不是两种。";
				mes "你想使用哪一种？";
				switch(select("黄水晶:玛瑙")) {
				case 1:
					set .@itemreq,7295; // Citrine
					break;
				case 2:
					set .@itemreq,7291; // Agate
					break;
				}
			}
			else if ((countitem(7294) > 29) && (countitem(7291) > 29)) {
				mes "哈哈哈，我让你带一种矿石，不是两种。";
				mes "你想使用哪一种？";
				switch(select("绿松石:玛瑙")) {
				case 1:
					set .@itemreq,7294; //Turqoise
					break;
				case 2:
					set .@itemreq,7291; // Agate
					break;
				}
			}
			else {
				if (countitem(7295) > 29) {
					set .@itemreq,7295; // Citrine
				}
				if (countitem(7294) > 29) {
					set .@itemreq,7294; //Turqoise
				}
				if (countitem(7291) > 29) {
					set .@itemreq,7291; // Agate
				}
			}
			mes "[Bazo]";
			mes getitemname(.@itemreq)+"，嗯？";
			mes "好吧。在开始前，我们必须先测试你的运气。正如你猜到的，乌姆巴拉的物品制作过程非常精细。";
			next;
			mes "[Bazo]";
			mes "如果在你运气高涨时进行，就很有机会成功制作出好东西。这样说你明白了吧？";
			next;
			mes "[Bazo]";
			mes "现在我们通过简单的读心游戏测试你的运气。";
			mes "我会想一种特定魔物，你要从我喜欢的魔物中猜出它。";
			next;
			mes "[Bazo]";
			mes "你有五次机会，只要猜对一次，我们就开始制作。";
			mes "但如果全部猜错，就必须驱散所有坏运气！";
			next;
			mes "[Bazo]";
			mes "为了驱散厄运，我会拿走你带来的10个特殊矿石。";
			mes "听起来很糟，但总比制作失败损失30个矿石好，对吧？";
			next;
			mes "[Bazo]";
			mes "好了，我现在需要一点时间准备……";
			mes "稍后再聊！";
			delitem 969,10; //Gold
			delitem 999,50; //Steel
			delitem 714,10; //Emperium
			if (.@itemreq == 7295) {
				set lv4_weapon,2;
			}
			else if (.@itemreq == 7294) {
				set lv4_weapon,3;
			}
			else if (.@itemreq == 7291) {
				set lv4_weapon,4;
			}
			close;
		}
		else {
			mes "[Bazo]";
			mes "请带来30个黄水晶、绿松石或玛瑙。";
			mes "你一定忘了带其中一种，请回去取来，这样我们才能开始。";
			close;
		}
	}
	if (lv4_weapon == 1) {
		mes "[Bazo]";
		mes "如果你想让我制作乌姆巴拉特产，就带些材料来，我才能为你制作。";
		next;
		mes "[Bazo]";
		mes "首先需要基础材料：10个黄金、50个钢铁和10个铝。";
		next;
		mes "[Bazo]";
		mes "然后需要稀有矿石为成品附魔，成品特性取决于使用的矿石。";
		next;
		mes "[Bazo]";
		mes "请带来30个黄水晶、绿松石或玛瑙中的任一种。祝你顺利找到，我会等着你～";
		close;
	}
	mes "[Bazo]";
	mes "你好……";
	mes "你不是这里的人，";
	mes "对吧？";
	next;
	mes "[Bazo]";
	mes "我叫巴佐·赫布里奇。很高兴认识你。正如你所见，我也不是这里的人。感觉……我们注定会相遇。";
	next;
	mes "[Bazo]";
	mes "如果你不介意，我来告诉你一些这里的情况。刚到这里时，我就察觉到这个村子有些不同。";
	next;
	mes "[Bazo]";
	mes "首先，乌姆巴拉离死者之国尼夫海姆很近。因为距离如此之近，这里有些人甚至能从那里汲取邪恶力量。";
	next;
	mes "[Bazo]";
	mes "别担心，当地人只用这种力量制作特殊物品。我在这里逗留期间，也学会了一些制作方法。";
	next;
	mes "[Bazo]";
	mes "如果你愿意，我可以展示一下我的手艺。你觉得怎么样？";
	next;
	switch(select("听起来不错～:不用了，谢谢。")) {
	case 1:
		if (BaseLevel < 70) {
			mes "[Bazo]";
		mes "嗯。你现在应该先提升等级、变得更强。";
		mes "我这么说是出于好意，请理解你还没准备好使用我的商品。";
			next;
			mes "[Bazo]";
		mes "正如我之前所说，这些商品带有邪恶力量。";
		mes "如果不够强或经验不足，可能会被逼疯。";
			next;
			mes "[Bazo]";
		mes "等你准备好后，我很乐意为你制作好东西～";
			close;
		}
		mes "[Bazo]";
		mes "太好了！我来告诉你需要哪些材料。数量不多，不过你最好记下来。";
		next;
		mes "[Bazo]";
		mes "首先需要基础材料：10个黄金、50个钢铁和10个铝。";
		next;
		mes "[Bazo]";
		mes "然后需要稀有矿石为成品附魔，成品特性取决于使用的矿石。";
		next;
		mes "[Bazo]";
		mes "请带来30个黄水晶、绿松石或玛瑙中的任一种。祝你顺利找到，我会等着你～";
		set lv4_weapon,1;
		close;
	case 2:
		mes "[Bazo]";
		mes "哦，好吧。";
		mes "我没关系。";
		mes "不过如果你改变主意，我会一直在这里。";
		close;
	}
}

umbala,163,257,3	script	Hibilaithan#lv4	785,{
	if (checkweight(908,300) == 0) {
		mes "^3355FF等一下！你现在携带的物品太多了。请先把部分物品存入卡普拉仓库后再回来。^000000";
		close;
	}
	if (event_umbala < 3) {
		mes "[Hibilaithan]";
		mes "Umba! Umbaba...umum! Baumba!";
		mes "Umumumbababaumumbabaumba!";
		mes "Umbaumbaumbaumbaumhah!";
		mes "Umumumumumbababababab!";
		close;
	}
	if (lv4_weapon == 0) {
		mes "[Hibilaithan]";
		mes "嘿嘿嘿……";
		mes "这一天终于到来了。";
		mes "我终于被认可为乌姆巴拉最伟大的工匠！";
		next;
		mes "[Hibilaithan]";
		mes "没错没错，我就是^802A2A那位^000000希比莱森。";
		mes "只要你带来材料，我就屈尊为你制作一件杰作。哇哈哈哈～！";
		next;
		mes "[Hibilaithan]";
		mes "嗯？你说什么？从没听说过我？";
		mes "别开玩笑了！";
		mes "虽然我是工艺大师，你也不用感到害怕。";
		next;
		mes "[Hibilaithan]";
		mes "老实说……你想成为我这件杰作的拥有者吗？";

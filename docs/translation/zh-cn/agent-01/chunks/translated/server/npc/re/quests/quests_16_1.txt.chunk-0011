		next;
		mes "[大脚]";
		mes "哦，亲爱的。我会好好享用每一口的。好了，现在问我问题吧。";
		next;
		mes "[" + .@name$ + "]";
		mes "我听说你在外国见过沃尔特家族的人。你在哪里见到他的？怎么知道他是沃尔特家族的人？";
		next;
		mes "[大脚]";
		mes "哦，你想知道这个啊。如你所知，除了艾尔贝塔和普隆德拉，很少能在卢恩·米德加尔特其他地方见到航海家沃尔特家族的人。";
		mes "除了那些广为人知的人，他们很擅长隐藏自己的身份。";
		next;
		mes "[大脚]";
		mes "不过，我在^0000cd维纳斯^000000看到了那个家族的独特标志。";
		next;
		mes "[" + .@name$ + "]";
		mes "维尔斯？你在那里见到了谁？怎么见到的？";
		next;
		mes "[大脚]";
		mes "我不知道他是谁。我像往常一样在工作。你知道的，为了糊口总得工作。";
		next;
		mes "[" + .@name$ + "]";
		mes "你是说扒窃？";
		next;
		emotion ET_FRET;
		mes "[大脚]";
		mes "不用说得这么具体吧。你不是想听故事吗？放心，我还是有荣誉感的。我会遵守你给我带来饺子时许下的承诺。";
		next;
		mes "[大脚]";
		mes "总之，我在那里的市场发现了一个看起来毫无防备的寒酸男人。他的钱包鼓鼓的，所以我就拿走了。";
		next;
		mes "[大脚]";
		mes "我在市场偏僻的角落打开了钱包。他果然很有钱。我还在里面发现了一封^0000cd旧信^000000。就是那封盖着^0000cd印章^000000的信。";
		next;
		mes "[" + .@name$ + "]";
		mes "他有那封信，并不能证明他是沃尔特家族的人。";
		next;
		mes "[大脚]";
		mes "喂，我正要说到重点呢。检查完钱包里的东西后，我本来打算收工。毕竟已经赚够了。";
		next;
		mes "[大脚]";
		mes "就在那时，那个寒酸男人出现了。";
		next;
		mes "[大脚]";
		mes "后面的故事不用我说了吧？哇……我感觉自己像是在同时和三个人打架。他的拳头简直……！呼……他打我的时候，我看到了。";
		next;
		mes "[大脚]";
		mes "他的斗篷下面藏着一把^0000cd剑^000000。^0000cd剑柄上刻着那个标志^000000。怎么样，现在相信我的故事了吧？";
		next;
		mes "[" + .@name$ + "]";
		mes "你都被打成那样了，怎么还能看到？";
		next;
		emotion ET_FRET;
		mes "[大脚]";
		mes "哦，相信我嘛。你不知道我是靠什么谋生的吗？";
		next;
		mes "[" + .@name$ + "]";
		mes "你是说扒窃？";
		next;
		emotion ET_ANGER;
		mes "[大脚]";
		mes "喂，拜托，别说得这么具体！";
		next;
		mes "[大脚]";
		mes "总之，我的职业要求眼光敏锐，能一眼看出重要的东西。我就是凭这个本事在这行立足的。";
		next;
		mes "[大脚]";
		mes "看到一个人时，我要立刻判断钱包的位置、身上是否有武器、目标的机灵程度，以及目标能跑多快。这份工作需要这样的特殊才能。";
		next;
		mes "[大脚]";
		mes "你不必相信我，但可以相信我的职业技能。";
		mes "你一定把钱藏在腰带和鞋子里了。干得漂亮，那些地方可不好偷。";
		next;
		emotion ET_HUK, playerattached();
		mes "[" + .@name$ + "]";
		mes "好吧，我想我可以相信你的本事。";
		next;
		mes "[" + .@name$ + "]";
		mes "总之，这件事确实很可疑。谢谢你的情报。";
		next;
		mes "[大脚]";
		mes "你不需要别的了吗？我现在想吃点甜点。";
		next;
		mes "[" + .@name$ + "]";
		mes "不用了，这些就够了。";
		next;
		mes "[大脚]";
		mes "哦，不！甜点！我的甜点！";
		delitem 12055,3;// Spicy Fried Bao
		delitem 12065,1;// Green Salad
		erasequest 14472;// Gourmet Bigfoot
		setquest 14473;// To Veins
		ep16_wal = 5;
		close;
	}
	mes "[大脚]";
	mes "怎么了？你改变主意了吗？";
	mes "还想知道更多情报吗？我真的很想喝点马斯黛拉果实酒。";
	next;
	mes "[大脚]";
	mes "你忘了该去哪儿了吗？";
	mes "你应该去^0000cd维纳斯^000000。";
	next;
	mes "[大脚]";
	mes "回来时给我带点甜点！";
	close;
}

veins,156,160,7	script	K#ep16wal	4_M_RASWORD,{
	if (checkweight(1304,3) == 0) {
		mes "[K]";
		mes "你似乎背负着沉重的负担。";
		mes "要不要先丢掉一些？";
		close;
	}
	if (ep16_wal < 5) {
		mes "[K]";
		mes "我想回去……";
		mes "回到那里……";
		close;
	}
	if (ep16_wal == 5) {
		.@name$ = strcharinfo(0);
		emotion ET_ANGER;
		mes "[K]";
		mes "你是谁？为什么盯着我看？你也想偷我的钱包吗？";
		mes "我刚把一个偷我钱包的人送进监狱，没过多久。";
		next;
		mes "[K]";
		mes "看来扒手之间并不共享这种情报。不想进监狱就赶紧滚。";
		next;
		mes "[" + .@name$ + "]";
		mes "你还真是个急性子。";
		mes "^0000cd凯恩·沃尔特·沃克^000000。";
		next;
		mes "[K]";
		mes "我不认识这个名字。";
		next;
		mes "[" + .@name$ + "]";
		mes "那个背叛主人的人。";
		next;
		mes "[K]";
		mes "你……你是谁？表明身份！";
		mes "为什么告诉我这种事？";
		next;
		mes "[" + .@name$ + "]";
		mes "人们都这么说。不过我不相信。";
		next;
		mes "[K]";
		mes "你为什么不相信？为什么？你知道些什么吗？";
		next;
		mes "[" + .@name$ + "]";
		mes "你就是知道真相的人，凯恩·沃尔特·沃克。";
		next;
		mes "[K]";
		mes "告诉我。你是谁？你知道伊森阿姆死亡的任何情况吗？";
		next;
		mes "[K]";
		mes "你的生死取决于回答。既然你知道我是谁，我就有充分理由杀了你。";
		next;
		mes "[K]";
		mes "好了，告诉我。";
		mes "你是谁？怎么找到我的？你知道伊森阿姆死亡的什么情况？";
		next;
		mes "[" + .@name$ + "]";
		mes "伊森霍诺委托我调查伊森阿姆的死因。";
		next;
		mes "[" + .@name$ + "]";
		mes "调查期间，我得知你会在这里，所以来见你。";
		next;
		mes "[K]";
		mes "伊森霍诺？他终于开始行动了！";
		next;
		mes "[K]";
		mes "哦，请原谅我的无礼。对不起，请原谅我刚才的行为。";
		next;
		mes "[" + .@name$ + "]";
		mes "没关系。小心一点总没有坏处，凯恩·沃尔特·沃克。";
		next;
		mes "[K]";
		mes "我已经不能再使用沃尔特这个姓氏了。";
		mes "星星消失后，它的卫星也会失去名字。更糟的是，我是一个没能保护星星的罪人。";
		next;
		mes "[K]";
		mes "伊森霍诺正在调查伊森阿姆的死吗？我会尽力帮助他，陪在他身边。";
		next;
		mes "[" + .@name$ + "]";
		mes "还没有。伊森霍诺想知道哥哥死亡背后的真相，但由于情况所限，他不方便亲自调查。";
		next;
		mes "[" + .@name$ + "]";
		mes "所以由行动相对自由的我代替他进行调查。";
		next;
		mes "[K]";
		mes "原来如此……那我能帮你做什么？为了揭开真相，我什么都愿意做。";
		next;
		mes "[" + .@name$ + "]";
		mes "你可以告诉我你和伊森阿姆在一起时发生了什么。比如你为何在他死前消失、为何来到这里，以及其他一切。";
		next;
		mes "[K]";
		mes "其实我自己也不知道他的死因。不过，在那起事件发生前，他^0000cd带着任务把我派到了这里^000000。";
		next;
		mes "[K]";
		mes "完成任务准备回去时，他给了我很多钱和一封^0000cd信^000000。信上写着^0000cd不要回卢恩·米德加尔特^000000。";
		next;
		mes "[" + .@name$ + "]";
		mes "然后呢？";
		next;
		mes "[K]";
		mes "几天后我听到了他去世的消息。我想回去，但因为他最后的命令而无法回去。我甚至没能陪在他身边……";
		next;
		mes "[K]";
		mes "很久以后，我听说了导致伊森阿姆被杀的暴行传闻。";
		next;
		mes "[K]";
		mes "还有守护骑士背叛主人的故事……";
		next;
		mes "[K]";
		mes "成为通缉犯后，我想回去说明真相。然而信上写着^0000cd无论如何都不要回来^000000。我不能违背主人最后的命令。";
		next;
		mes "[" + .@name$ + "]";
		mes "我想伊森阿姆是不希望你被牵连。如果他出了什么事，你会是处境最危险的人。";
		next;
		mes "[K]";
		mes "哈……也许吧……我没想到这一点……这是伊森阿姆给我的^0000cd信和剑^000000。";
		next;
		mes "[K]";
		mes "请把它们交给伊森霍诺。希望它们能帮助他恢复哥哥的荣誉。";
		next;
		mes "[" + .@name$ + "]";
		mes "留下这把剑吧。剑就像骑士的生命。我相信伊森阿姆希望你拥有它。";
		next;
		mes "[K]";
		mes "那么，旅途平安。";
		erasequest 14473;// To Veins
		setquest 14474;// Report to Isenhonor
		getitem 6929,1;// Letters_Stamped_Seal
		ep16_wal = 6;
		close;
	}
	mes "[K]";
	mes "你顺利把信和口信交给伊森霍诺了吗？";
	next;
	mes "[K]";
	mes "请告诉他，只要他需要我的帮助，我随时愿意献出生命。";
	close;
}

prt_cas_q,30,78,0	script	#ep16_heine_evt01	HIDDEN_WARP_NPC,1,1,{
	end;
OnTouch:
	if (ep16_royal == 2 && isbegin_quest(7683) == 0) {
		cloakoffnpcself( "Nyhill M. Heine#ep16_01" );
		cloakoffnpcself( "Peter Heine#ep16_01" );
		cloakonnpcself( "Peter Heine#ep16_02" );
	}
	else if (ep16_royal < 10) {
		cloakoffnpcself( "Peter Heine#ep16_01" );
		cloakonnpcself( "Peter Heine#ep16_02" );
	}
	else if (ep16_royal > 9) {
		cloakonnpcself( "Peter Heine#ep16_01" );
		cloakoffnpcself( "Peter Heine#ep16_02" );
	}
	end;
}

prt_cas_q,9,90,3	script	Peter Heine#ep16_02	4_EP16_PETER,{
	if (ep16_royal > 8) {
		mes "他正身负重伤躺在床上。";
		mes "看起来他没有说话的状态。";
		close;
	}
}

// Heine
prt_cas_q,21,83,3	script	Friedrich S. Heine#ep16_01	4_EP16_STOLZ,{
	if (ep16_royal < 2) {
		cutin "ep16_friedrich_stolz_heine",1;
		mes "[Friedrich]";
		mes "未经允许就闯进来，真是太无礼了。";
		mes "现在马上出去。";
		close3;
	}
	if (ep16_royal == 2) {
		mes "[Friedrich]";
		mes "请冷静。";
		close;
	}
	if (ep16_royal < 8) {
		cutin "ep16_friedrich_stolz_heine",1;
		mes "[Friedrich]";
		mes "为什么不去享用宴会？";
		mes "奈希尔也去了宴会厅。";
		next;
		mes "[Friedrich]";
		mes "他给人的第一印象不太好，但不是个坏孩子……";
		mes "他只是……";
		next;
		mes "[Friedrich]";
		mes "算了，我还是别再说了。";
		close3;
	}
	if (ep16_royal < 16)
		end;
	if (ep16_royal == 16) {
		cutin "ep16_friedrich_stolz_heine",1;
		mes "[Friedrich]";
		mes "你终于来了。";
		mes "大公一直在等你。";
		close3;
	}
	if (ep16_royal == 17) {
		cutin "ep16_friedrich_stolz_heine",1;
		mes "[Friedrich]";
		mes "尼勒姆说准备好一切后会去你的房间。你可以在房间里等。";
		mes "我们就拜托你了。";
		close3;
	}
	if (ep16_royal < 23)
		end;
	if (ep16_royal == 23) {
		cutin "ep16_friedrich_stolz_heine",1;
		mes "[Friedrich]";
		mes "我已经听父亲说过了。";
		mes "我已获准让你自由进入王室的往昔记忆。";
		next;
		mes "[Friedrich]";
		mes "明天再谈王室的往昔记忆吧。";
		mes "你今天经历了这么多麻烦，一定累了。";
		ep16_royal = 24;
		close3;
	}
	switch( checkquest(7706,PLAYTIME) ) {
	case -1:
		break;
	case 0:
	case 1:
		cutin "ep16_friedrich_stolz_heine",1;
		mes "[Friedrich]";
		mes "你要再回那个地方吗？";
		mes "尼勒姆已经告诉我了。";
		next;
		mes "[Friedrich]";
		mes "毕竟他只是人类，要多次建立连接并不容易。";
		next;
		mes "[Friedrich]";
		mes "感谢你为王室付出的努力。";
		mes "但别把自己逼得太紧。";
		close3;
	case 2:
		erasequest 7706;// Nillem Is Not Almighty
		break;
	}
	switch( checkquest(7705,HUNTING) ) {
	case -1:
		mes "[Friedrich]";
		mes "你来得正是时候。";
		mes "今天也要去那里吗？";
		cutin "ep16_friedrich_stolz_heine",1;
		next;
		if (select( "是。", "否。" ) == 2) {
			mes "[Friedrich]";
			mes "我明白了。";
			mes "……哦，你知道奈希尔在做什么吗？";
			next;
			mes "[Friedrich]";
			mes "……算了。";
			mes "他被判处纪律禁闭，应该会安静地待着。";
			next;
			mes "[Friedrich]";
			mes "那么，再见。";
			close3;
		}
		mes "[Friedrich]";
		mes "抱歉又要麻烦你。";
		mes "希望这次能成功。";
		next;
		mes "[Friedrich]";
		mes "请从女武神那里带回一块伊米尔之心。";
		setquest 7705;// Hope You Cannot Let Go
		close3;
	case 0:
	case 1:
		cutin "ep16_friedrich_stolz_heine",1;
		mes "[Friedrich]";
		mes "……我知道改变过去几乎不可能。";
		mes "但没有其他办法。";
		next;
		mes "[Friedrich]";
		mes "我们必须尝试一切能做的事。";
		next;
		mes "[Friedrich]";
		mes "你在下面执行任务时，我们也会继续调查。";
		next;
		mes "[Friedrich]";
		mes "我们正在寻找入侵者的线索。";
		mes "让我们各自做好自己的工作。";
		next;
		mes "[Friedrich]";
		mes "尼勒姆一定在等你。";
		mes "请一如既往地尽力而为。";
		close3;
	case 2:
		cutin "ep16_friedrich_stolz_heine",1;
		mes "[Friedrich]";
		mes "你回来了。";
		mes "这次也是一样吗？";
		mes "我想应该是。";
		mes "不过，我真的不认为所有努力都会白费。";
		next;
		mes "[Friedrich]";
		mes "非常感谢。";
		mes "将来如果你需要我们家族的力量，";
		mes "无论如何，我们都会站在你这边。";
		next;
		mes "[Friedrich]";
		mes "这就是我们现在能给你的全部奖励。";
		mes "很抱歉我们无法提供更多。";
		mes "我会确保你住在宫殿期间不会遇到不便。";
		next;
		mes "[Friedrich]";
		mes "那么明天见。";
		setquest 7706;// Nillem Is Not Almighty
		erasequest 7705;// Hope You Cannot Let Go
		getitem 6919,10;// TokenOfHonor
		getexp 400000,400000;
		close3;
	}
}

prt_cas_q,18,83,5	script	Peter Heine#ep16_01	4_M_3RDPRIN1,{
	if (ep16_royal < 2) {
		mes "[Peter]";
		mes "你一定就是受邀参加宴会的归来英雄。";
		mes "这场宴会是为你举办的，请尽情享用。";
		close;
	}
	if (ep16_royal == 2) {
		mes "[Peter]";
		mes "哈哈……大公一定非常生气。";
		close;
	}
	if (ep16_royal < 8) {
		cutin "ep16_petter_heine01",0;
		mes "[Peter]";
		mes "我参加了王室会议，但不知道这是不是正确的决定。";
		next;
		mes "[Peter]";
		mes "我本想为大家这么做，但似乎反而惹来了麻烦。";
		next;
		mes "[Peter]";
		mes "人们告诉我，我是这件事的有力候选人，但我没那么自信。";
		next;
		mes "[Peter]";
		mes "我一直在想这责任有多重大、自己还应该多努力，以及其他种种……";
		next;
		mes "[Peter]";
		mes "不过我现在也不能退缩。我想能做的只有尽力而为。";
		close3;
	}
}

prt_cas_q,19,85,4	script	Kronecker G. Heine#ep16_01	4_EP16_GRANZ,{
	if (ep16_royal < 2) {
		mes "[Kronecker]";
		mes "我从未允许你来访。";
		close;
	}
	if (ep16_royal == 2) {
		switch( isbegin_quest(7685) ) {
		case 0:
			switch( isbegin_quest(7683) ) {
			case 0:
				cutin "ep16_kronecker_granz_heine",2;
				mes "[Kronecker]";
				mes "我很忙。";
				mes "请稍后再来。";
				close2;
				warp "prt_cas_q",134,32;
				end;
			case 1:
				cutin "ep16_kronecker_granz_heine",2;
				mes "[Kronecker]";
				mes "……闹出这样的场面真是遗憾。";
				mes "而且还是在客人面前。";
				mes "我谨代表海涅家族向你道歉。";
				next;
				cutin "ep16_friedrich_stolz_heine",1;
				mes "[Friedrich]";
				mes "请允许我自我介绍。";
				mes "我是海涅家族现任家主，弗里德里希·斯托尔兹·海涅。";
				next;
				mes "[Friedrich]";
				mes "这位是家族前任家主、大公格兰兹，我的父亲。";
				next;
				cutin "ep16_kronecker_granz_heine",2;
				mes "[Kronecker]";
				mes "我的名字是克罗内克·格兰兹·海涅。";
				next;
				cutin "ep16_friedrich_stolz_heine",1;
				mes "[弗里德里希·斯托尔兹]";

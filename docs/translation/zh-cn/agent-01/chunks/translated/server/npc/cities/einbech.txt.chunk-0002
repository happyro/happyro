	mes "你们年轻人怎么";
	mes "学不会这些呢？";
	next;
	mes "[Luda]";
	mes "我相信这和代沟有关，";
	mes "但我很惊讶老人们";
	mes "竟然知道这么多~";
	next;
	switch(select("你们在谈什么？：路过")) {
	case 1:
	mes "[Shena]";
	mes "哦？哎呀哎呀！";
		mes "你不是最可爱的小姑娘吗？";
		mes "你好呀~";
		next;
		if (Sex == SEX_MALE) {
		select("抱歉，我其实是男的。");
		mes "[Shena]";
		mes "哦，是这样吗？";
			mes "也许我老了，眼睛不好了。";
			mes "现在越来越难分辨了……";
			next;
			}
			mes "[Shena]";
			mes "总之，我和鲁达刚才在聊";
			mes "艾因布罗克附近的怪物。";
			mes "显然，你们年轻人";
		mes "对它们了解得不够。";
		next;
		mes "[Shena]";
		mes "如果冒险是你的工作，";
		mes "就应该知道面对的是什么。";
		mes "你对这里的怪物有什么问题吗，";
		mes "年轻的小姐？";
		next;
		if (Sex == SEX_MALE) {
		select("我说了，我是男的……！");
		mes "[Shena]";
		mes "嗯，‘男的’。我好像以前听过。";
		mes "呵呵~请原谅这个老太婆。";
		mes "我不太懂你们年轻人用的词。";
		next;
		mes "[Shena]";
		mes "那么亲爱的，";
		mes "你想听哪种怪物的故事？";
			next;
			}
			while(1) {
			switch(select("金属波利：矿石：矿工：旧炉子：退出")) {
			case 1:
			mes "[Shena]";
			mes "金属波利是在诸神统治世界时";
			mes "被创造出来的。";
			next;
			mes "[Shena]";
			mes "你可能不知道，根据神话，";
			mes "波利和波波利是由奥丁的唾液";
			mes "创造的。也许你不想知道波波利的事……";
			next;
			mes "[Shena]";
		mes "另一方面，金属波利由活体机器的血液制成，";
		mes "我相信那些机器叫‘巨人’。";
			next;
			mes "[Shena]";
				mes "金属波利和其他跳动的凝胶团一样，";
				mes "会吞下地面上的任何东西。";
				next;
				mes "[Shena]";
				mes "击败金属波利后，可能掉落大杰勒比结晶、";
				mes "铁矿石甚至铁。";
				mes "知道这些很有用，对吧？";
				next;
				mes "[Shena]";
				mes "亲爱的，还有什么";
				mes "想问的吗？";
				next;
				break;
				case 2:
				mes "[Shena]";
				mes "你知道钟乳石和洞穴水晶";
				mes "会生长成千上万年吗？";
				next;
				mes "[Shena]";
				mes "如果某样东西生长了成千上万年，";
				mes "那它是活的也就合理了。";
				mes "矿石怪物其实就是活着的钟乳石。";
				next;
				mes "[Shena]";
				mes "据说它们生长在黑暗洞穴中，";
				mes "洞穴里的某种东西";
				mes "对它们产生了恶意影响。";
				next;
				mes "[Shena]";
				mes "矿石能自我防御，击败后可能掉落水晶碎片、黄宝石或神之金属。";
				mes "也有很小概率掉落稀有宝石，但我不太确定。";
				next;
				mes "[Shena]";
				mes "这里还有其他你想";
				mes "了解更多的怪物吗？";
				next;
				break;
				case 3:
				mes "[Shena]";
				mes "矿工亡魂是死去矿工的幽灵，";
				mes "徘徊在旧而生锈的矿车旁。";
			mes "不知为何，它们无法离开这个世界，";
				mes "只能在矿井中游荡。";
				next;
				mes "[Shena]";
				mes "击败它们会掉落旧镐、提灯、铁、";
				mes "钢、煤、手电筒和旧铁板。";
				next;
				mes "[Shena]";
				mes "你还想问我";
				mes "其他本地怪物的事吗？";
				next;
				break;
				case 4:
				mes "[Shena]";
				mes "那只是一个邪恶的食人炉子。";
				next;
				switch(select("……就这样？：好、好可怕！")) {
				case 1:
				mes "[Shena]";
				mes "你知道回收和保护自然资源的重要性吧？";
				mes "如果你回收旧炉子怪物的废铁，";
				mes "我会很高兴。";
				next;
				mes "[Shena]";
				mes "旧炉子通常会掉落破锅、烧焦的树、铁、铁矿石和旧铁板。";
				mes "偶尔也会掉落生锈的铁或枯树枝。";
				next;
				break;
				case 2:
				mes "[Shena]";
				mes "是的。那是上帝的造物，";
				mes "残酷无情，可能是我见过的";
				mes "最纯粹的邪恶象征。";
			next;
				mes "[Shena]";
				mes "与新式家电不同，旧炉子由大师手工制作，";
				mes "据说因此拥有了自己的灵魂。";
				mes "它们曾是善良的机器，满足于提供温暖。";
				next;
				mes "[Shena]";
				mes "它们忠诚地服务主人多年。";
				mes "但随着科技进步，它们变得过时，";
				mes "像垃圾一样被丢弃。";
				mes "这让它们的心扭曲为^FF0000邪恶^000000。";
				next;
				mes "[Shena]";
				mes "旧炉子通常会掉落破锅、烧焦的树、铁、铁矿石和旧铁板。";
				mes "偶尔也会掉落生锈的铁或枯树枝。";
				next;
				break;
				}
				mes "[Shena]";
				mes "那么，还有什么";
				mes "想让我分享给你吗？";
				next;
				break;
			case 5:
				mes "[Shena]";
				mes "好吧。";
				mes "祝你今天愉快，小姐。";
				next;
				mes "[Luda]";
				mes "抱歉，我母亲有时过于热情。";
					mes "如果你无聊，欢迎随时来访。";
					mes "冒险者，旅途小心~";
					close;
					}
					}
					case 2:
					mes "[Shena]";
					mes "鲁达……";
					mes "你不可能活到我这么老，";
					mes "却一点都不了解";
					mes "我们这个世界~";
					close;
					}
				}
					
					einbech,48,107,4	duplicate(EinMonsters)	Luda#ein	850
					
					einbech,148,242,5	script	Jung#ein	855,{
					mes "[Jung]";
					mes "我是少数长期生活在";
					mes "艾因贝赫和艾因布罗克的人之一。";
					mes "所以我算是这里最好的向导之一。";
					next;
					mes "[Jung]";
					mes "如果你打算进入矿洞，";
					mes "我可以告诉你那里怪物的一切，";
					mes "让你做好更充分的准备。";
					next;
					switch(select("好啊，为什么不呢？：不用了，谢谢。")) {
					case 1:
					mes "[Jung]";
					mes "矿洞特有的怪物有毒气、毒蛇、波塞利奥和黑曜石。";
					mes "你想了解哪一种？";
					next;
					switch(select("毒气和毒蛇：波塞利奥：黑曜石")) {
					case 1:
					mes "[Jung]";
					mes "似乎没人知道毒气和毒蛇从何而来。";
					mes "它们仿佛在艾因布罗克开始工业化时，";
					mes "凭空出现。";
					next;
				mes "[Jung]";
				mes "现在想想，我不认为它们是自然产生的怪物。";
				mes "它们总是一副绝望痛苦的样子，";
				mes "似乎希望敌人杀死自己。";
				next;
				mes "[Jung]";
				mes "不过你最好小心！";
				mes "毒气和毒蛇是隐匿怪物，";
			mes "能安静地在空中滑行，";
				mes "在你察觉前发动攻击……";
				next;
				mes "[Jung]";
				mes "你应该知道，毒气是念属性，毒蛇是毒属性。";
				mes "两者都是中型无形怪物。";
				next;
				mes "[Jung]";
				mes "两者都会掉落苹果、";
				mes "灰尘污染物、毒气、毒粉、杆菌、";
				mes "霉菌粉和解毒剂。";
				next;
				mes "[Jung]";
				mes "暂时就这些。";
			mes "如果对矿洞怪物有问题，尽管问我。";
		mes "冒险者，注意安全。";
	close;
		case 2:
		mes "[Jung]";
		mes "波塞利奥是一种生活在洞穴中的昆虫，";
		mes "饮用从钟乳石滴下的水。";
		mes "它喜欢靠近各种矿物和矿石，";
		mes "这点与安格利昂不同。";
		next;
		mes "[Jung]";
	mes "波塞利奥会掉落朱比利、昆虫触角、单细胞、";
mes "晨露苔藓、霓虹液体和其他物品，";
mes "具体我记不清了。";
next;
mes "[Jung]";
mes "最后，波塞利奥是土属性怪物。";
	mes "这就是我知道的全部。";
	mes "如果想了解矿洞里的其他怪物，";
	mes "尽管问我。";
	close;
	case 3:
	mes "[Jung]";
	mes "你听说过这种说法吗：";
	mes "蕴含巨大能量的地下矿物";
	mes "其实拥有灵魂？黑曜石就是这种活着的岩石。";
	next;
	mes "[Jung]";
	mes "据说，Jung 处理器中的一块黑曜石就有照亮夜空的能量。";
	mes "遗憾的是，无法活捉它们，狩猎也并不容易。";
	next;
	mes "[Jung]";
	mes "黑曜石是小型无形怪物，";
	mes "会掉落透明宝石、黑色水晶碎片、煤、";
		mes "铝、铁和钢。";
		next;
		mes "[Jung]";
		mes "黑曜石的介绍就到这里。";
		mes "如果对矿洞里的其他怪物有问题，";
		mes "尽管问我。";
		close;
			}
			case 2:
			mes "[Jung]";
			mes "如果你有点赶时间，我能理解。";
			mes "不过，如果你刚来这里，";
			mes "进入副本前应该尽可能多了解一些。";
			next;
			mes "[Jung]";
			mes "好吧，冒险时注意安全。";
			close;
			}
			}
			
			einbech,148,246,5	script	Franz#ein	851,{
			mes "[Franz]";
			mes "好无聊……";
			mes "渴望……";
			mes "聊天。";
			mes "有、有人吗……";
			next;
			mes "[Franz]";
			mes "嘿，旅行者！";
			mes "你打算探索矿洞还是附近的原野？";
			mes "聊一会儿吧，也许你能学到一些东西。";
			next;
			switch(select("好吧。：不用了，谢谢。")) {
			case 1:
			mes "[Franz]";
			mes "哦，你听说过矿洞里的生物，";
			mes "或者最近城里发生的事吗？";
			mes "你想了解哪一个？";
			next;
			switch(select("矿洞生物：城镇事件")) {
			case 1:
			mes "[Franz]";
			mes "我说的生物是安格利昂，也被称为这里的洞穴之王。";
			mes "据说它生活在洞穴深处，守护着拥有奇异力量的矿石和矿物。";
			next;
			mes "[Franz]";
			mes "起初我以为那只是古老的童话，";
			mes "但大约十年前隧道开始坍塌时，";
			mes "它真的再次出现了。";
		next;
			mes "[Franz]";
			mes "随着安格利昂目击事件增加，";
			mes "隧道坍塌也越来越频繁。";
			mes "我想是矿工无意中闯入了它的领地。";
			next;
			mes "[Franz]";
			mes "传说古代巨人潜入矿井，";
			mes "想从人类那里偷煤。";
			mes "但挖掘时制造了太大噪音，";
			mes "惊醒了安格利昂。";
			next;
			mes "[Franz]";
			mes "矿工们第二天早上上工时，";
			mes "发现了那些巨人的血淋淋尸体。";
			mes "从此，人们一直害怕安格利昂";
			mes "对进入矿井者造成的威胁。";
			next;
			mes "[Franz]";
			mes "有位成功击杀安格利昂的冒险者告诉我，";
			mes "它会掉落蚂蚁下巴、彩色外壳、坚硬外壳、";
			mes "长腿、霓虹液体和锆石。";
			close;
			case 2:
		mes "[Franz]";
			mes "艾因布罗克曾短暂流行泰迪熊。";
			mes "但随后发生了一系列神秘事故和谋杀，";
			mes "整个家庭都被杀害。";
			next;
			mes "[Franz]";
			mes "事实证明，每个被杀的家庭都买过这种泰迪熊。";
			mes "甚至有传言说泰迪熊会活过来。";
			next;
			mes "[Franz]";
			mes "调查后，当局发现所有出售泰迪熊的商人";
			mes "都从同一个批发商处进货，";
			mes "那是个没人了解的外来者。";
			next;
			mes "[Franz]";
			mes "既然泰迪熊显然不是无害玩具，";
			mes "军队便被派去收缴所有泰迪熊，";
			mes "并将它们处理到城外。";
			next;
			mes "[Franz]";
			mes "但泰迪熊一被放到城外，";
			mes "就突然活过来开始暴动！";
			mes "这清楚证明它们受某种邪恶力量控制。";
			next;
			mes "[Franz]";
			mes "如今那些凶暴的泰迪熊散落各处，";
		mes "政府已将它们列为怪物。格杀勿论！";
	next;
		mes "[Franz]";
		mes "据捕获过这些熊的冒险者说，";
		mes "它们是小型无属性怪物，";
		mes "会掉落蜂蜜、螺丝、烤熟的曲奇和奥里德康锤。";
		next;
		mes "[Franz]";
		mes "进入任何副本。";
		next;
		mes "[Jung]";
		mes "好吧，冒险时注意安全。";
		close;
		}
		}
	

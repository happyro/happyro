		case 3:
			if (checkquest(13060,PLAYTIME) == 2) {
mes "我们应该去确认冒险者们是否平安。";
				erasequest 13060;
			}
			else if (checkquest(13060,PLAYTIME) == 0) {
mes "该说他们都活着让我松了口气吗……？嗯……至少还活着就是好事。";
				emotion ET_THINK;
			}
			else if (isbegin_quest(13055) == 1) {
				if (isbegin_quest(13056) == 1 || isbegin_quest(13057) == 1 || isbegin_quest(13058) == 1) {
mes "塔里还有 3 名冒险者。我理解他们各有原因，但还是忍不住担心。";
					next;
					mes "[Fili]";
mes "请确认冒险者们的情况。谁知道以后他们也许会帮助你。";
				}
				else {
mes "很高兴他们都平安。如果他们能尽快完成事情回去，我就放心了……总之谢谢你！";
					emotion ET_OHNO;
					changequest 13055,13060;
					getexp 300000,300000;
					getitem 6081,1;// Splendide_Coin
				}
			}
			else {
mes "我没有责任照顾他们。但如果冒险者在这里受伤，大地也会悲伤。";
				next;
				mes "[Fili]";
mes "今天能帮忙确认冒险者们的安全吗？";
				next;
			switch( select("当然，我也是冒险者！:抱歉，我今天有点累。") ) {
					mes "[Fili]";
				case 1:
mes "谢谢！确认 3 名冒险者都平安！";
					setquest 13055;
					setquest 13056;
					setquest 13057;
					setquest 13058;
					close;
				case 2:
mes "嗯，真遗憾，但也没办法。不过我很担心，尤其是那个唱歌的人。";
					close;
				}
			}
			close;
		}
	}
	else if (ep14_2_nines == 2) {
		if (isbegin_quest(13055) == 1) {
			if (isbegin_quest(13056) == 1 || isbegin_quest(13057) == 1 || isbegin_quest(13058) == 1) {
mes "冒险者们还好吗？别忘了检查他们 3 个~";
				close;
			}
mes "谢天谢地他们都没事。真让人安心。不过他们告诉你什么时候出来了吗？";
			next;
			select("......");
			mes "[Fili]";
mes "嗯……但我也不能放着他们不管……";
			emotion ET_THINK;
			next;
			select("三楼的冒险者快饿死了！");
			mes "[Fili]";
mes "真的吗……真不敢相信是冒险者。你介意有食物的话给他一些吗？";
			next;
			mes "[Fili]";
mes "让我看看……我只有这些。虽然不多，希望能帮到他。";
			next;
			mes "[Fili]";
mes "我应该开始定期确认他们的安全。请稍后再来。";
			changequest 13055,13059;
			setquest 13060;
			ep14_2_nines = 3;
			getexp 300000,300000;
			getitem 517,10;// Meat
			getitem 6081,1;// Splendide_Coin
		}
		else if (checkquest(13055) == -1) {
mes "看到这里的塔了吗？我不知道它何时建造、由谁建造，但听说它一直存在。";
			next;
			mes "[Fili]";
mes "我们正努力阻止旅行者进入塔内，因为里面有怪物。";
			next;
			mes "[Fili]";
mes "不过你知道，旅行者越是危险，就越想进去。";
			emotion ET_OHNO;
			next;
			mes "[Fili]";
mes "最近有^FF0000 3 名冒险者^000000进入了塔。我不确定他们是否还活着……";
			next;
			mes "[Fili]";
mes "我本该更努力阻止他们……你能去确认他们是否平安吗？";
			next;
			switch( select("我来做！我也是冒险者！:抱歉，我现在做不到。") ) {
				mes "[Fili]";
			case 1:
mes "很好。现在塔里有 3 名冒险者。";
				next;
				mes "[Fili]";
mes "第一个冒险者刚进去。他很年轻，我狠狠训了他一顿。几分钟后你就能找到他。";
				next;
				mes "[Fili]";
mes "第二个冒险者似乎是位严肃的女士。不知道她现在怎么样。";
				next;
				mes "[Fili]";
mes "第三个冒险者才是问题……不知道他在做什么，但已经在里面待了大约一个月。";
				next;
				mes "[Fili]";
mes "他自豪地说马上就出来，还带着乐器进塔作曲。但从那以后就没了消息。请找找他。";
				setquest 13055;
				setquest 13056;
				setquest 13057;
				setquest 13058;
				close;
			case 2:
				mes "不是什么急事，但我很担心冒险者们。";
				close;
			}
		}
	}
	else if (ep14_2_nines == 1) {
		if (isbegin_quest(13050) == 1) {
			if (isbegin_quest(13051) == 1 || isbegin_quest(13052) == 1 || isbegin_quest(13053) == 1 || isbegin_quest(13054) == 1) {
mes "今天有 4 名拉菲内准备工作。确保告诉每一位。";
				next;
				mes "[Fili]";
mes "他们都在田野的某处准备。";
				close;
			}
mes "啊嗯！？我想他们已经开始工作了。田野又开始呼吸了。你知道，这片田野有很多故事。";
			next;
			mes "[Fili]";
mes "如果你喜欢花、树和拉菲内，就能从某处听到它的故事。";
			next;
			mes "[Fili]";
mes "我想他们今天的田野工作结束了。顺便说，^FF0000还有另一项工作。有兴趣就来询问。^000000";
			erasequest 13050;
			ep14_2_nines = 2;
			getitem 6081,1;// Splendide_Coin
			getexp 300000,300000;
		}
		else if (isbegin_quest(13050) == 0) {
mes "现在看来……你是旅行者，对吧？抱歉，除非感兴趣，否则我很难注意到什么。";
			next;
			mes "[Fili]";
mes "先自我介绍一下。我叫菲莉，是拉菲内。我在艾可拉珠做各种工作。从这些肌肉就能看出来，啊嗯？";
			next;
			select("你发出的‘啊嗯’声音是怎么回事？");
			mes "[Fili]";
mes "只是习惯，别在意。总之，该开始今天的工作了……你是旅行者，对吧？能帮我吗？";
			next;
			switch( select("看看是什么工作。:告诉他你很忙。") ) {
				mes "[Fili]";
			case 1:
mes "啊嗯？很简单。告诉散布在田野各处的拉菲内开始今天的工作。";
				next;
				mes "[Fili]";
mes "拉菲内喜欢这片田野，并用自己的方式将能量分享给树木、草、风和大地。";
				next;
				mes "[Fili]";
mes "我们不确定这到底有多大帮助。它们是神秘的生物。";
				next;
				mes "[Fili]";
mes "但只要可能有帮助，我们都想尝试。";
				next;
				mes "[Fili]";
mes "通常这是我独自完成的工作。但现在我的肩膀受伤了，不能再离开这里。请帮帮我。";
				setquest 13050;
				setquest 13051;
				setquest 13052;
				setquest 13053;
				setquest 13054;
				close;
			case 2:
mes "啊嗯？好吧，真遗憾。有时间再来吧，我这里需要一点帮助。";
				close;
			}
		}
	}
	else if (ep14_2_oliver > 4) {
mes "看看这片美丽的田野，小草和树枝都在呼吸！";
		next;
		mes "[Fili]";
mes "但不知为什么，我感觉听不到它们的呼吸了。所以小拉菲内们要浇水和歌唱，让它们振作起来。";
		next;
		mes "[Fili]";
mes "我想拉菲内该开始今天的工作了。";
		ep14_2_nines = 1;
	}
	else
mes "看看这片美丽的田野。感觉能听见每根树枝和每片草叶在歌唱，对吧？";
	close;
}

ecl_fild01,222,290,5	script	Singing Laphine#1	4_F_FAIRYKID,{
	mes "[Singing Laphine]";
	if (ep14_2_nines < 1)
mes "你能……听见大地的声音吗？它现在听起来很悲伤。";
	else if (ep14_2_nines != 2) {
		if (ep14_2_nines > 2) {
			if (checkquest(13059,PLAYTIME) == 0) {
mes "呼，我是不是唱太多了？我好渴。来杯米酒就好了，哈哈~";
				emotion ET_CONFUSE;
				close;
			}
		}
		if (isbegin_quest(13050) == 1 && isbegin_quest(13051) == 1) {
			if (ep14_2_nines == 1)
mes "是伟大的菲莉派你来的吗？他肯定很有本事！那我开始唱歌了！？";
			else {
mes "我想你是来告诉我开始工作吧？别担心，我的歌声会触动大地~";
				emotion ET_DELIGHT;
			}
			next;
mes "拉菲内一开始歌唱，我的心就感到温暖。";
			emotion ET_DELIGHT;
			erasequest 13051;
		}
		else if (isbegin_quest(13050) == 1)
mes "我正在为花朵和大地歌唱。";
		else
mes "我想该开始歌唱了……";
	}
	else
mes "为大地歌唱感觉真好。";
	close;
}

ecl_fild01,83,263,5	script	Watering Laphine#1	4_M_FAIRYKID3,{
	mes "[Watering Laphine]";
	if (ep14_2_nines < 1)
mes "我觉得大地快要干涸了。";
	else if (ep14_2_nines > 2) {
		if (checkquest(13059,PLAYTIME) == 0)
mes "我想今天够了。我也得休息一下打水。嘿嘿~！";
		else if (isbegin_quest(13050) == 1 && isbegin_quest(13052) == 1) {
mes "我会再次给这些垂死的花草浇水。这能让它们起死回生！嘿嘿~！";
			erasequest 13052;
		}
		else if (isbegin_quest(13050) == 1)
mes "我正在到处浇水。你看起来很累！要不要也给你浇点水？";
		else
mes "我相信艾可拉珠需要像我这样的拉菲内！嘿嘿~！";
	}
	else if (ep14_2_nines == 1) {
		if (isbegin_quest(13050) == 1 && isbegin_quest(13052) == 1) {
mes "哦，他们开始工作了？那我也开始给大地浇水。我的意思是，我们拉菲内有时也很务实！";
			erasequest 13052;
		}
		else if (isbegin_quest(13050) == 1)
mes "你听见草和花重新焕发生机的声音了吗？都是因为我勤奋浇水！嘿嘿~！";
		else
mes "嘿嘿~！既然浇完水了，我该等伟大的菲莉。";
	}
	else
		mes "给大地浇水是我的工作。";
	close;
}

ecl_fild01,163,196,5	script	Dancing Laphine#1	4_F_FAIRYKID3,{
	mes "[Dancing Laphine]";
	if (ep14_2_nines < 1)
		mes "跳舞前这样热身很重要。一、二、三、四……";
	else if (ep14_2_nines > 2) {
		if (checkquest(13059,PLAYTIME) == 0)
			mes "下次真想见见伟大的菲莉……";
		else if (isbegin_quest(13050) == 1 && isbegin_quest(13053) == 1) {
			mes "啊，又是你！你真迟钝。总之，你是来告诉我开始工作，对吧？我明白了，你可以走了。";
			emotion ET_HNG;
			erasequest 13053;
		}
		else if (isbegin_quest(13050) == 1)
			mes "有你这样的冒险者看着，我跳不好舞！别担心，快走吧~我不会偷懒的，好吗？";
		else
			mes "我悲伤时会跳街舞。嗯？哦，那是一种舞蹈风格。非常优雅，也让人心痛。";
	}
	else if (ep14_2_nines == 1) {
		if (isbegin_quest(13050) == 1 && isbegin_quest(13053) == 1) {
			mes "你说伟大的菲莉让我们开始工作？但他为什么让你来告诉我们？";
			next;
			mes "[Dancing Laphine]";
			mes "我本来可以把新舞步展示给菲莉！";
			next;
			select("......");
			mes "[Dancing Laphine]";
			mes "算了，我就跳今天早些时候练的舞步。菲莉应该是第一个看到我新舞步的人，所以……";
			next;
			select("那么，跳舞究竟如何帮助大地……？");
			mes "[Dancing Laphine]";
			mes "看看你，冷漠的冒险者！这里的所有拉菲内都能感受到。我们听见大地和生物的声音。";
			next;
			mes "[Dancing Laphine]";
			mes "继续冒险你就会明白。总之，我现在开始工作。";
			erasequest 13053;
		}
		else if (isbegin_quest(13050) == 1)
			mes "下次真想见见伟大的菲莉。";
		else
			mes "我悲伤时会跳街舞。嗯？哦，那是一种舞蹈风格。非常优雅，也让人心痛。";
	}
	else
		mes "草在风中摇曳时，不像是在跳舞吗？";
	close;
}

ecl_fild01,237,181,5	script	Cute Laphine#1	4_M_FAIRYKID5,{
	mes "[Cute Laphine]";
	if (ep14_2_nines < 1)
	mes "这是你第一次看到盛开的田野吗？它很美，就像我一样。";
	else if (ep14_2_nines > 2) {
		if (checkquest(13059,PLAYTIME) == 0)
			mes "只有像我这样可爱的人才能给大地带来欢乐……可惜你永远做不到！";
		else if (isbegin_quest(13050) == 1 && isbegin_quest(13054) == 1) {
			mes "你是新人，对吧？告诉他我会开始工作。";
			emotion ET_SMILE;
			erasequest 13054;
		}
		else if (isbegin_quest(13050) == 1) {
			mes "你也许觉得一直对大地微笑没什么，但其实没那么容易。我的意思是，首先要像我这样可爱就很难~";
			emotion ET_SMILE;
		}
		else {
			mes "希望有一天，大地上的花、树、草和小生物都能开心地微笑。";
			emotion ET_SMILE;
		}
	}
	else if (ep14_2_nines == 1) {
		if (isbegin_quest(13050) == 1 && isbegin_quest(13054) == 1) {
			mes "你为什么来这里？";
			next;
			select("我是应菲莉的请求来的。");
			mes "[Cute Laphine]";
			mes "你是说伟大的菲莉拜托你？那你是新来的工人吗？";
			next;
			select("不，我是冒险者");
			mes "[Cute Laphine]";
			mes "别害羞。我也是最近才开始工作的。不过既然我先到这里，我就是你的老板，好吗？！";
			next;
			select("......");
			mes "[Cute Laphine]";
			mes "那么，你的专长是什么？";
			next;
			mes "[Cute Laphine]";
			mes "我们都爱大地，但表达方式各不相同，比如跳舞或唱歌。";
			next;
			mes "[Cute Laphine]";
			mes "看来……你似乎什么都不擅长！";
			next;
			select("那么你做什么？");
			mes "[Cute Laphine]";
			mes "拜托~你也很迟钝吗？看看我，多可爱又善良！";
			next;
			mes "[Cute Laphine]";
			mes "我的工作是把笑容分享给大地。只要这样微笑，大地一定会感觉好多了！";
			next;
			select("......");
			mes "[Cute Laphine]";
			mes "总之，你也该为大地找点工作。告诉菲莉我会开始工作。";
			next;
		mes "他说完后，脸上立刻露出了灿烂的笑容。";
			emotion ET_SMILE;
			erasequest 13054;
		}
		else
			mes "你也许觉得一直对大地微笑没什么，但其实没那么容易。我的意思是，首先要像我这样可爱就很难~";
	}
	else
		mes "回忆起过去的美好记忆时，你不是总会微笑吗？";
	close;
}

ecl_tdun02,99,63,5	script	Rosi#No.1	4_F_HUWOMAN,1,1,{
	end;
OnInit:
	if (strnpcinfo(2) != "No.1")
		disablenpc();
	end;
OnTouch:
	mes "[Rosi]";
	if (ep14_2_nines < 2)
mes "我需要一条独家新闻，能吸引冒险者目光的那种！";
	else {
		if (ep14_2_nines > 2) {
			if (checkquest(13060,PLAYTIME) == 0) {
mes "总之，这不是普通的地方。这里充满了值得报道的故事！";
				close;
			}
		}
		if (isbegin_quest(13055) == 1 && isbegin_quest(13056) == 1) {
			if (ep14_2_nines > 2)
mes "又是你！哦，是因为我是女人吗？我说清楚，我拿到新闻前哪儿也不去。";
			else {
mes "天啊！你吓到我了！你来这里做什么？";
				next;
				select("说明情况");
				mes "[Rosi]";
mes "我明白了……我不知道他们在担心我。但我现在不能回去，我是记者。";
				next;
				mes "[Rosi]";
mes "我为一本叫《月刊布里甘》的杂志撰写冒险者新闻。";
				next;
				mes "[Rosi]";
mes "我费了很大力气才来到这里，感觉随时都能拿到独家新闻！但目前还没发生……";
				next;
				mes "[Rosi]";
mes "总之，我过得很好。告诉他不用担心我。";
			}
			erasequest 13056;
			close2;
			.@npc_uin = atoi( charat(strnpcinfo(2),3) );
			disablenpc "Rosi#No."+ .@npc_uin;
			enablenpc "Rosi#No."+ ((.@npc_uin%3) +1);
			end;
		}
		if (isbegin_quest(13055) != 1)
mes "这座塔很安静，却很神秘。冒险者一定会喜欢，对吧？";
		else {
			if (ep14_2_nines > 2)
mes "天啊，你真烦人。别担心，我能照顾好自己！";
			else
mes "别担心，我会拿到年度最大新闻！";
		}
	}
	close;
}
ecl_tdun02,84,21,5	duplicate(Rosi#No.1)	Rosi#No.2	4_F_HUWOMAN,1,1
ecl_tdun02,22,36,5	duplicate(Rosi#No.1)	Rosi#No.3	4_F_HUWOMAN,1,1

ecl_tdun01,11,62,5	script	Euncheong#No.1	4_M_HUBOY,1,1,{
	end;
OnInit:
	if (strnpcinfo(2) != "No.1")
		disablenpc();
	end;
OnTouch:
	mes "[Euncheong]";
	if (ep14_2_nines < 2)
mes "我正在探索这座塔的每一寸土地。之后会把它写进回忆录。";
	else if (ep14_2_nines >= 2) {
		if (ep14_2_nines > 2) {
			if (checkquest(13060,PLAYTIME) == 0) {
mes "别因为我年轻就小看我。我已经去过米德加尔特大陆的每个角落。我是真正的冒险者。";
				close;
			}
		}
		if (isbegin_quest(13055) == 1 && isbegin_quest(13057) == 1) {
			if (ep14_2_nines > 2) {
mes "你真的不用担心我。探索完我就会出去……告诉他我没事。";
				next;
				mes "[Euncheong]";
mes "我现在要去探索其他地方了。";
			}
			else {
mes "你也是冒险者？别想插队，我先到的。";
				next;
				select("你什么意思？我没有插队！");
				mes "[Euncheong]";
mes "我先在这里探索。所以你晚点再来。我会成为伟大的冒险者！";
				next;
				select("说明情况");
				mes "[Euncheong]";
mes "哈，那个拉菲内一定很闲，居然担心冒险者。他不该担心一个将成为冒险王的人！";
				next;
				select("冒险王？");
				mes "[Euncheong]";
mes "我会在世界各地留下足迹，找到各种宝藏并藏在某处。之后每个冒险者都会追随我的道路！";
				next;
				mes "[Euncheong]";
mes "如果现在拿到我的签名，未来也许能养活你的三代家人。怎么样，要一份吗？";
				next;
				select("算了，小男孩。");
				mes "[Euncheong]";
mes "你真不会看人！总之，告诉他不用担心我。我会成为冒险王！现在我要继续探索。";
			}
			erasequest 13057;
			close2;
			.@npc_uin = atoi( charat(strnpcinfo(2),3) );
			disablenpc "Euncheong#No."+ .@npc_uin;
			enablenpc "Euncheong#No."+ ((.@npc_uin%3) +1);
			end;
		}
		if (isbegin_quest(13055) == 1) {
			if (ep14_2_nines > 2)
mes "你想要我的签名？不想要就别打扰。";
			else
mes "别担心我。我会成为伟大的冒险者！";
		}
		else {
			if (ep14_2_nines > 2)
mes "别担心我。我会成为伟大的冒险者！";
			else
mes "这座塔很神秘，是个有趣的地方。";
		}
	}
	else
mes "这座塔很神秘，是个有趣的地方。";
	close;
}

ecl_tdun01,51,103,5	duplicate(Euncheong#No.1)	Euncheong#No.2	4_M_HUBOY,1,1
ecl_tdun01,98,47,5	duplicate(Euncheong#No.1)	Euncheong#No.3	4_M_HUBOY,1,1

		close3;
	}
}

prt_cas_q,86,180,7	script	Kalbern#ep16lug	4_M_RUSCHILD,{
	if (ep16_lug <= 6) {
		mes "[Kalbern]";
		mes "亲爱的冒险者，你好。";
		mes "我是^0000cd卡尔本^000000，赫尔穆特的侍从。";
		next;
		mes "[Kalbern]";
		mes "我曾在边境的艰苦前线为赫尔穆特效力。现在我来到了卢恩·米德加尔特的首都普隆德拉，却无法适应这里的情况。";
		next;
		mes "[Kalbern]";
		mes "在宫殿里看到贵族和王室成员时，我也会感到紧张。";
		next;
		mes "[Kalbern]";
		mes "在前线为赫尔穆特效力时，我没有意识到这一点；但在这里，我感到他仿佛与我有些遥远，毕竟他是王室继承人。";
		next;
		mes "[Kalbern]";
		mes "他平等对待士兵和干活的孩子。所以大家都喜欢他，也都追随他。";
		next;
		mes "[Kalbern]";
		mes "我的父母被魔物杀害后，也是他接纳了我，我对此十分感激。";
		next;
		mes "[Kalbern]";
		mes "为了报答他的恩情，我恳求他让我效忠于他，于是一直跟随他……";
		next;
		mes "[Kalbern]";
		mes "在这里，除了给赫尔穆特拿啤酒，我没有其他事情可做。";
		next;
		mes "[Kalbern]";
		mes "我希望宴会早点结束，好早点回去。";
		next;
		mes "[Kalbern]";
		mes "不过，我并不是不希望他成为国王。";
		mes "我只是不习惯待在这里。";
		close;
	}
}

prt_cas_q,96,186,3	script	Wolf Roegenburg#ep16lug	4_EP16_WOLF,{
	if (checkweight(1301,1) == 0) {
		mes "[Wolf Roegenburg]";
		mes "嗯，你好像带了很多行李。要不要先丢掉一些？";
		close;
	}
	if (ep16_lug == 0) {
		cutin "16wol_nor",2;
		mes "[Wolf]";
		mes "感谢你来访问罗根堡。";
		mes "要不要去见见我的祖父、罗根堡家族的家主^0000cd马克西米利安·罗根堡^000000？";
		next;
		mes "[Wolf]";
		mes "他很喜欢和冒险者交谈。";
		close3;
	}
	if (ep16_lug == 1) {
		cutin "16wol_nor",2;
		mes "[Wolf]";
		mes "亲爱的冒险者，罗根堡家族很荣幸有你的到来。";
		mes "我是罗根堡家族的次子，^0000cd沃尔夫·罗根堡^000000。";
		next;
		mes "[Wolf]";
		mes "为了继承民族英雄威廉·罗根堡的意志，我们罗根堡家族一直努力维护荣誉、正义与传统。";
		next;
		mes "[Wolf]";
		mes "自卢恩·米德加尔特建立以来，罗根堡家族的许多人都为国家作出了贡献，这就是我们的骄傲。";
		next;
		mes "[Wolf]";
		mes "目前，王位的优秀候选人^0000cd赫尔穆特·罗根堡^000000正在参加王室会议。你见过他吗？";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "见过。我刚才还见到他。你是谁？";
		next;
		cutin "16agn_nor",2;
		mes "[Agnes]";
		mes "亲爱的冒险者，很高兴见到你。我是^0000cd艾格尼丝·罗根堡^000000，是罗根堡家族四兄弟姐妹中最小的一个。";
		next;
		mes "[Agnes]";
		mes "你有一起参加宴会的伴侣吗？我没有同行的人。没有人合我的心意。";
		next;
		cutin "16wol_ang",2;
		mes "[Wolf]";
		mes "艾格尼丝，别这么说，不合适。我们正在向冒险者讲述罗根堡家族的故事……";
		next;
		cloakoffnpcself( "Myer Roegenburg#ep16lug" );
		cutin "16mye_nor",1;
		mes "[Myer]";
		mes "现在，我的王子要和我一起走吗？";
		next;
		cutin "16agn_nor",2;
		mes "[Agnes]";
		mes "啊，迈尔，哥哥！哥哥！";
		next;
		cutin "16wol_nor",2;
		mes "[Wolf]";
		mes "谢谢你及时赶来。亲爱的冒险者，";
		mes "这位是^0000cd迈尔·罗根堡^000000，他是罗根堡家族的三子。";
		next;
		mes "[Wolf]";
		mes "我离开了很长时间，最近才回来。没错吧？";
		next;
		cutin "16mye_nor",1;
		mes "[Myer]";
		mes "嗯，大概算一半吧。我听说^0000cd一个战争狂人和一个小贩会联手参加王室会议^000000。";
		next;
		mes "[Myer]";
		mes "所以我回来短住一阵。我听说兄弟之间的关系原本并不亲密，却突然变得深厚起来。我可不能置身事外。";
		next;
		cutin "16wol_ang",2;
		mes "[Wolf]";
		mes "你这是什么说法。^0000cd即使你出门和下层人厮混，^000000也不该把自己的住处弄成肮脏的小巷。";
		mes "你不会以为我不知道你和哪些人来往吧？";
		next;
		mes "[Myer]";
		mes "我当然知道祖父和你派人监视我。他们表现得太笨拙，其他人都看出来了。";
		next;
		cutin "16mye_ang",1;
		mes "[Myer]";
		mes "我高贵的哥哥不喜欢我的说话方式吗？";
		mes "如果我们联手让^0000cd赫尔穆特成为国王^000000，^0000cd整个国家都会^000000变成小巷，只有宫殿例外。现在听到这些，减少以后受到的冲击，不是更好吗？";
		next;
		cutin "16mye_nor",1;
		mes "[Myer]";
		mes "不过你可能听不进去，毕竟你只会待在家里盘算能从战争中赚多少钱。";
		next;
		cutin "16wol_ang",2;
		mes "[Wolf]";
		mes "你无礼得难以置信。我说过要礼貌地称呼我。";
		mes "你打算这样闹到什么时候？";
		next;
		cutin "16agn_ang",2;
		mes "[Agnes]";
		mes "你们都住手！我们聚在这里不是为了争吵。这是为冒险者举办的宴会，不该在冒险者面前这样做。";
		next;
		mes "[Agnes]";
		mes "尤其是你，毫无尊严可言。冒险者会怎么看我们？";
		next;
		cutin "16mye_nor",1;
		mes "[Myer]";
		mes "是的，你说得对。我想我是个不受欢迎的客人。我还是先走吧。艾格尼丝，我晚点再回来。";
		next;
		cloakonnpcself( "Myer Roegenburg#ep16lug" );
		cutin "16agn_nor",2;
		mes "[Agnes]";
		mes "天啊，我忘了。我还要做准备！";
		next;
		cutin "16wol_nor",2;
		mes "[Wolf]";
		mes "很抱歉让你遇到这种不愉快的情况。我绝无此意。如果让你感到不舒服，请接受我的道歉。迈尔离开很久才回来，说话难免无礼。";
		next;
		mes "[Wolf]";
		mes "我之后会让他礼貌地向你道歉。其实他和你看到的样子不一样，请多多理解。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "不，没关系。";
		next;
		mes "[Wolf]";
		mes "对了，亲爱的冒险者，如果你有时间，能帮我一个忙吗？";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "好，请说吧。";
		next;
		mes "[Wolf]";
		mes "我希望你能去维格纳家族，从^0000cd艾萨克·维格纳^000000那里带一件东西回来。";
		next;
		mes "[Wolf]";
		mes "本来应该由我去，但我觉得必须和迈尔认真谈谈。所以想请你代我去……";
		next;
		mes "[Wolf]";
		mes "所以，请帮我这个忙。当然，你也可以拒绝。但我不知道还能不能找到像你这样可靠的人。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "这是为了测试我是否可靠吧。";
		next;
		mes "[Wolf]";
		mes "啊，不是的。如果你觉得不舒服，我很抱歉。我只是没有可靠的人可托付。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "好。去维格纳家族，向艾萨克·维格纳索要你说的东西，对吗？";
		next;
		mes "[Wolf]";
		mes "是的，没错。";
		completequest 14495;// To Wolf
		setquest 14496;// To Isaac
		if (achievementinfo(130000, ACHIEVEINFO_COUNT7) == 0)
			achievementupdate(130000, ACHIEVEINFO_COUNT7, 1);
		ep16_lug = 2;
		if (isbegin_quest(7682) == 1 && isbegin_quest(5402) == 2 && isbegin_quest(7683) == 2 && isbegin_quest(7684) == 2 && ep16_wal > 1 && ep16_wig > 1 && ep16_lug > 1 && ep16_gaobs > 1) {
			completequest 7682;// Socializing Starts from an Eye Contact
			setquest 7685;// What Is the Next Thing on the Schedule ?
		}
		close3;
	}
	if (ep16_lug == 2) {
		cutin "16wol_nor",2;
		mes "[Wolf]";
		mes "沿着^0000cd走廊前进。维格纳家族就在最后一个房间^000000。";
		mes "找到艾萨克，带回我要求的东西。";
		next;
		mes "[Wolf]";
		mes "很抱歉给你添麻烦。";
		close3;
	}
	if (ep16_lug == 3) {
		if (countitem(6930) < 1) {
			cutin "16wol_nor",2;
			mes "[Wolf]";
			mes "亲爱的冒险者，进展如何？看来你什么都没有。你似乎还没把东西带来。";
			mes "你只要去^0000cd维格纳家族，从艾萨克那里带回东西^000000。";
			close3;
		}
		cloakoffnpcself( "Myer Roegenburg#ep16lug" );
		cutin "16wol_nor",2;
		mes "[Wolf]";
		mes "亲爱的冒险者，你把东西带来了吗？哦，你带来了。非常感谢。";
		next;
		mes "[Wolf]";
		mes "哦，箱子的锁由^0000cd密码^000000保护。";
		next;
		mes "[Wolf]";
		mes "第一个格子里有数字^0000cd1^000000，后面四个格子是空的，你应该在里面输入数字。";
		next;
		mes "[Wolf]";
		mes "嗯……很简单。这个完美的^0000cd漂亮箱子就是提示^000000……答案总是包含在问题里。";
		next;
		mes "[Wolf]";
		mes "从答案来看，维格纳家族似乎真的很喜欢^0000cd数字和黄金^000000。你也要试着解开吗？";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "为什么要让我破解密码？这不是秘密吗？";
		next;
		mes "[Wolf]";
		mes "因为你是可靠的人。就当作娱乐吧。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "那么，我想答案是这个：";
		next;
		input .@string$;
		mes "[" + strcharinfo(0) + "]";
		if (.@string$ != "1618") {
			mes "嗯……不是这个答案。";
			mes "我想我需要一些时间思考。";
			close3;
		}
		mes "1618。它代表 1.618，也就是黄金比例。";
		mes "嗯，听起来太简单了。";
		next;
		mes "[Wolf]";
		mes "但里面的东西可不简单。";
		next;
		mes "[Wolf]";
		mes "箱子里小瓶中的东西虽然还处于测试阶段，却会改变战斗和战争的格局。";
		next;
		mes "[Wolf]";
		mes "你果然是个可靠的人。";
		mes "之前拜托你时我很过意不去。我们会给你丰厚的奖励。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "没关系。艾萨克有消息让我带给你。";
		next;
		mes "[Wolf]";
		mes "是什么？";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "最近，普隆德拉流传着一则关于罗根堡家族和赫尔穆特·罗根堡的^0000cd传闻^000000。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "那不是什么好传闻。他让我调查一下，确认是否属实。";
		next;
		mes "[Wolf]";
		mes "关于你的传闻？我不知道这件事……传闻……";
		mes "我需要调查，但没有可以信赖的人……";
		next;
		mes "[Wolf]";
		mes "冒险者，打扰一下？";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "什么事？";
		next;
		mes "[Wolf]";
		mes "你能再帮我一个忙吗？我不能亲自去，因为那样可能会引发问题。";
		next;
		mes "[Wolf]";
		mes "所有我能信任的部下都在做其他工作，除了你我没有别人可找。";
		next;
		mes "[Wolf]";
		mes "你在各处旅行，很容易就能收集情报，更重要的是我信得过你。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "嗯，这可不容易，不过……";
		next;
		mes "[Wolf]";
		mes "如果你很忙，也可以拒绝。我很抱歉还来拜托你。我的弟弟突然回来，让我忙得不可开交。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "不，这件事我能做到。那么回头见。";
		next;
		mes "[Wolf]";
		mes "我不知道该怎么感谢你。要听到最准确的传闻，最好去问孩子们。我听说孩子们会聚集在普隆德拉的^0000cd大空地^000000上。";
		next;
		mes "[Wolf]";
		mes "那么，回头见。";
		delitem 6930,1;// Biz_Items_Sample
		erasequest 14497;// Delivery for Wolf
		setquest 14498;// Which Rumor
		ep16_lug = 4;
		close3;
	}
	if (ep16_lug == 4 || ep16_lug == 5) {
		cutin "16wol_nor",2;
		mes "[Wolf]";
		mes "普隆德拉流传着什么关于罗根堡家族的传闻？";
		mes "我不知道竟然有关于我们家族的传闻在流传。";
		next;
		mes "[Wolf]";
		mes "我本该早点开始收集情报，但因为其他事情忙不过来。";
		mes "我完全没想到会有传闻流传出去。";
		next;
		mes "[Wolf]";
		mes "我迫不及待想知道关于我们家族的传闻是什么。";
		mes "那么回头见。";
		close3;
	}
	if (ep16_lug == 6) {
		cutin "16wol_nor",2;
		mes "[Wolf]";
		mes "你好，你看起来有点累。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "啊，是吗？为了查找传闻，我跑了些腿。";
		next;
		mes "[Wolf]";
		mes "哦，真抱歉。本来应该由我去做的。";
		next;
		cutin "16agn_nor",2;
		mes "[Agnes]";
		mes "传闻？什么传闻？我最喜欢这种事情了。";
		next;
		cutin "16mye_nor",1;
		mes "[Myer]";
		mes "我也很想知道。";
		next;
		cutin "16wol_nor",2;
		mes "[Wolf]";
		mes "抱歉让你这么累。你查到什么了吗？";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "是的，我查到了传闻，而且内容相当具体。我可以在这里说吗？";
		next;
		mes "[Wolf]";
		mes "可以。如果传闻和我们家族有关，大家都必须听听，这样我们才能聚在一起想出解决办法。";
		next;
		mes "[我把从孩子们那里听来的传闻改成较温和的版本后告诉了他们。]";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "最近大家都在谈论这则传闻。我想它会传遍卢恩·米德加尔特，不只是普隆德拉。";
		next;
		mes "[Wolf]";
		mes "这则传闻……非常……具体，而且恶意十足。一定是了解我家情况的人故意散播的。";
		next;
		cutin "16agn_nor",2;
		mes "[Agnes]";
		mes "你是说坏人就在我们当中？天啊！这可严重了！";
		next;
		cutin "16wol_ang",2;
		mes "[Wolf]";
		mes "没错。^0000cd迈尔^000000？你打算让我们家族蒙受多大的耻辱？";
		next;
		cutin "16mye_nor",1;
		mes "[Myer]";
		mes "嗯，视需要而定？";
		next;
		emotion ET_HUK, getnpcid(0, "Maximilian Roegenburg#ep16lug");
		emotion ET_HUK;
		emotion ET_HUK, getnpcid(0, "Agnes Roegenburg#ep16lu");
		cutin "16hel",0;
		mes "[Helmut]";
		mes "迈尔，真的是你做的吗？";
		next;
		cutin "16agn_ang",2;
		mes "[Agnes]";
		mes "是迈尔做的吗？";
		next;
		cutin "",255;
		mes "[Maximilian]";
		mes "迈尔，是真的吗？传闻是你散播的？";
		next;
		cutin "16wol_ang",2;
		mes "[Wolf]";
		mes "你召集了一群小孩子，还扮演领袖。玩得很开心吗？";
		next;
		cutin "16mye_nor",1;
		mes "[Myer]";
		mes "你看到了那些孩子这次做的事吗？你以为只有上层阶级才能影响平民，对吧？你真是太愚蠢了。";
		next;
		cutin "16wol_ang",2;
		mes "[Wolf]";
		mes "你打算闹到什么地步？";
		next;
		cutin "16mye_nor",1;
		mes "[Myer]";
		mes "嗯，我向教会的朋友、商人的朋友和后街的朋友求助。我告诉他们需要帮忙后，所有人都说愿意帮助我。";
		next;
		mes "[Myer]";
		mes "我想知道你要如何对付看不见的敌人。";
		next;
		cutin "16wol_ang",2;
		mes "[Wolf]";
		mes "我不明白你为什么散播这种传闻，还做了这些事。";
		next;
		mes "[Wolf]";
		mes "不，其实我想我很清楚。都是因为你不成熟的同情心，还想破坏我的计划！";
		next;
		cutin "16mye_ang",1;
		mes "[Myer]";
		mes "计划？什么计划？战争计划？把无辜的人赶上战场的计划？实现你野心的手段？";
		next;
		cutin "16wol_ang",2;
		mes "[Wolf]";
		mes "你还太年轻，不明白你的兄长们为什么想实现我们的计划。";
		next;
		mes "[Wolf]";
		mes "^0000cd14年前^000000，尽管我们是顶尖家族，却什么也做不了。那种无力感，你感受过吗？";
		next;
		mes "[Wolf]";
		mes "^0000cd贵族家族并没有看起来那么好^000000。你只是在后街扮演领袖，却彻底破坏了我们的计划！";
		next;
		cutin "16mye_ang",1;
		mes "[Myer]";
		mes "你的计划是壮大家族的力量、统一大陆。然后呢？你会得到什么？成就？复仇？";
		next;
		mes "[Myer]";
		mes "如你所知，这种事情会给别人带来痛苦。我们从小没有父母，但因为有家人，也因为富有，所以没有倒下。";
		next;
		mes "[Myer]";
		mes "而且我们有^0000cd可以依靠的兄弟^000000。想想我们是怎样互相安慰的？像我们这样幸运的人并不多。";
		next;
		mes "[Myer]";
		mes "有那么多人无依无靠、无处容身，甚至没有钱买一块面包。到处都有人在死去。";
		next;
		mes "[Myer]";
		mes "你和赫尔穆特梦想的世界，只是为了满足^0000cd少数人的欲望^000000。";
		next;
		cutin "16wol_ang",2;
		mes "[Wolf]";
		mes "你太理想化了。要实现伟大的目标，就必须做出小小的牺牲。";
		next;
		cutin "16mye_ang",1;
		mes "[Myer]";
		mes "为了目标而牺牲？你以为我不知道你帮助赫尔穆特的原因吗？";
		next;
		mes "[Myer]";
		mes "赫尔穆特参加王室会议时，我并不在意。反正他很天真，不知道如何赢得他人的好感和信任。";
		next;
		mes "[Myer]";
		mes "赫尔穆特成为国王的愿望本来可能只是愿望，但自从你开始暧昧地支持赫尔穆特，一切都变了。";
		next;
		mes "[Myer]";
		mes "赫尔穆特和你看起来像关系很好的兄弟，但沃尔夫，我知道你想从战争中赚钱，而且";
		next;
		cutin "16mye_ang",1;
		mes "[Myer]";
		mes "即使赫尔穆特成为国王，他也只是个傀儡，而你会^0000cd掌控我们的家族和王国^000000。不是吗？";
		next;
		cutin "16wol_ang",2;
		mes "[Wolf]";
		mes "我们的家族有什么值得骄傲的？名望？声誉？在国境之外都毫无用处。而且现在也不如从前了。";
		next;
		mes "[Wolf]";
		mes "但看看维格纳家族。无论他们去哪里、做什么，人们都会在他们的黄金面前低头。";
		next;
		mes "[Wolf]";
		mes "人们只向拥有黄金的人低头。我想要那种力量。我想要^0000cd真正的力量^000000，胜过毫无力量的名声。";
		next;
		cutin "16mye_ang",1;
		mes "[Myer]";
		mes "你想建立一个可以随心所欲统治的王国。如果赫尔穆特没能成为国王，你打算怎么办？";
		next;
		mes "[Myer]";
		mes "作为罗根堡家族的次子，你终究会遇到限制。你能放弃自己的野心吗？";
		next;
		mes "[Myer]";
		mes "不管怎样，人生苦短。打动人的是内心，不是金钱或权力。";
		next;
		cutin "16wol_ang",2;
		mes "[Wolf]";
		mes "内心？对^0000cd那些人^000000有用吗？";
		next;
		cutin "16mye_ang",1;
		mes "[Myer]";
		mes "你不知道可以用不同的方式接近他们。";
		next;
		cutin "16wol_ang",2;
		mes "[Wolf]";
		mes "你比我想象的更出色。你已经长大了，我知道你不会再在我面前哭了。所以别再胡说，出去玩吧。";
		next;
		mes "[Wolf]";
		mes "注意你的言辞。我不可能永远对你客气。";

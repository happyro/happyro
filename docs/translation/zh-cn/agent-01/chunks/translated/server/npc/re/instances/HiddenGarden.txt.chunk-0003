1@herbs,85,101,4	script(DISABLED)	#BMD000005	MD_ASSISTANT,3,3,{
	if ('hidden_garden == 13) {
		removespecialeffect EF_MARKING_USE_CHANGEMONSTER;
		'hidden_garden = 14;
		'guide_id = getnpcid(0, instance_npcname("#BMD000005"));
		npcspeed 200;
		npctalk "我第一次来到这里，这里是西格玛的本体所在之处。通常我们只通过网络交流。";
		unitwalk 'guide_id,85,91, instance_npcname("#BMD000005") + "::OnEvent01";
	}
	end;

OnEvent01:
	unitwalk 'guide_id,85,71, instance_npcname("#BMD000005") + "::OnEvent02";
	end;

OnEvent02:
	unitwalk 'guide_id,85,62, instance_npcname("#BMD000005") + "::OnEvent03";
	specialeffect EF_WHITEBODY, AREA, instance_npcname("#sigma");
	specialeffect EF_MOONSTAR, AREA, instance_npcname("#sigma");
	end;

OnEvent03:
	npctalk "西格玛，我带来了［" + 'admin$ + "］。";
	sleep 3000;
	npctalk "做得好。你现在可以走了。", instance_npcname("#sigma");
	sleep 3000;
	npctalk "我的引导还没结束。就这样回去可以吗？";
	sleep 3000;
	npctalk "哦，我会把后续信息记录下来，交给下一位向导。你可以放心回去了。", instance_npcname("#sigma");
	sleep 3000;
	npctalk "好的。我会遵照指示。";
	unitwalk 'guide_id,85,72, instance_npcname("#BMD000005") + "::OnEvent04";
	end;

OnEvent04:
	unitwalk 'guide_id,85,92, instance_npcname("#BMD000005") + "::OnEvent05";
	end;

OnEvent05:
	unitwalk 'guide_id,85,99, instance_npcname("#BMD000005") + "::OnEvent06";
	end;

OnEvent06:
	'hidden_garden = 15;
	disablenpc();
	specialeffect EF_MARKING_USE_CHANGEMONSTER, AREA, instance_npcname("#sigma");
	end;
OnTouch:
	if ('hidden_garden == 13) {
		removespecialeffect EF_MARKING_USE_CHANGEMONSTER;
		specialeffect EF_MARKING_USE_CHANGEMONSTER;
	}
	end;
}

1@herbs,85,56,8	script(DISABLED)	#sigma	4_M_BARMUND,4,4,{
	if ('npc_is_talking)
		end;
	specialeffect EF_WHITEBODY;
	specialeffect EF_MOONSTAR;
	if ('hidden_garden == 15) {
		removespecialeffect EF_MARKING_USE_CHANGEMONSTER;
		select("瓦尔蒙特？你为什么在这里？");
		setpcblock PCBLOCK_NPC, true;
		sleep2 1000;
		npctalk "当然。你很了解瓦尔蒙特大师。［" + strcharinfo(0) + "］。";
		sleep2 5000;
		npctalk "遗憾的是，我不是瓦尔蒙特。这个外表是我为了确认你身上的某件事而创造的。";
		sleep2 3000;
		setpcblock PCBLOCK_NPC, false;
		select("那你是谁？");
		setpcblock PCBLOCK_NPC, false;
		donpcevent instance_npcname("#sigma") + "::OnTalk01";
		end;
	}
	if ('hidden_garden == 17) {
		removespecialeffect EF_MARKING_USE_CHANGEMONSTER;
		npctalk "你能回答我吗？你以前见过瓦尔蒙特吗？";
		setpcblock PCBLOCK_NPC, true;
		sleep2 3000;
		setpcblock PCBLOCK_NPC, false;
		switch( select( "我不太记得了。", "我们在古城见过。", "我在拯救世界时遇到他。" ) ) {
		case 1:
			npctalk "哦，确实有可能。他也许让你忘记了所见的一切……";
			break;
		case 2:
			npctalk "又是在那个地方吗……";
			break;
		case 3:
		npctalk "果然，他正在做重要的事……";
			break;
		}
		donpcevent instance_npcname("#sigma") + "::OnTalk02";
		end;
	}
	if ('hidden_garden == 18) {
		removespecialeffect EF_MARKING_USE_CHANGEMONSTER;
	npctalk "你能去告诉他们瓦尔蒙特还活着吗？";
		setpcblock PCBLOCK_NPC, true;
		sleep2 2000;
		setpcblock PCBLOCK_NPC, false;
		select("那有什么区别？");
		setpcblock PCBLOCK_NPC, true;
		sleep2 1000;
	npctalk "他们正试图关闭这个研究区域。我仍然反对，但资源已经开始触及极限。";
		sleep2 5000;
	npctalk "但只要他们发现瓦尔蒙特还活着，就无法关闭这里。";
		sleep2 5000;
		specialeffect EF_WHITEBODY;
		specialeffect EF_MOONSTAR;
	npctalk "这一切都是因为卡帕和兰达负责不同的任务。";
		sleep2 2000;
		setpcblock PCBLOCK_NPC, false;
		select("你们的任务有什么区别？");
		if ('hidden_garden == 18) {
			'hidden_garden = 19;
			sleep2 2000;
			npctalk "亲自向你展示会更好。";
			unitwalk 'guide_id,83,113, instance_npcname("#sigma") + "::OnEvent08";
		}
		end;
	}
	if ('hidden_garden == 20) {
		removespecialeffect EF_MARKING_USE_CHANGEMONSTER;
		specialeffect EF_WHITEBODY;
		specialeffect EF_MOONSTAR;
		select( "外面的自动人偶是你制作的吗？" );
		donpcevent instance_npcname("#sigma") + "::OnTalk03";
		end;
	}
	if ('hidden_garden == 21) {
		removespecialeffect EF_MARKING_USE_CHANGEMONSTER;
		specialeffect EF_WHITEBODY;
		specialeffect EF_MOONSTAR;
		select( "我想请求评估。" );
		donpcevent instance_npcname("#sigma") + "::OnTalk04";
		end;
	}
	if ('hidden_garden == 22) {
		removespecialeffect EF_MARKING_USE_CHANGEMONSTER;
	npctalk "好了，我们休息一下吧。有问题就问我，我会尽力回答。";
		while (true) {
			specialeffect EF_WHITEBODY;
			specialeffect EF_MOONSTAR;
			setpcblock PCBLOCK_NPC, true;
			sleep2 2000;
			setpcblock PCBLOCK_NPC, false;
			switch( select( "为什么会有花园？", .@menu$[0], .@menu$[1], .@menu$[2] ) ) {
			case 1:
				setpcblock PCBLOCK_NPC, true;
				npctalk "这个防卫区域本不该暴露给世人，所以我计划了许多掩盖方法。";
				sleep2 5000;
				npctalk "为了隐藏这里，我们决定把它伪装成一个极其普通而和平的地方。";
				sleep2 5000;
				npctalk "于是这里变成了防卫区域周围的花园。看起来是不是像普通花园？";
				sleep2 3000;
				.@menu$[0] = "自动人偶为什么在耕作？";
				break;
			case 2:
				setpcblock PCBLOCK_NPC, true;
				npctalk "我从没要求它们耕作。我们只是丢弃了一些东西，然后观察 AI 的反应。";
				sleep2 5000;
				npctalk "只有开始耕作的人偶在花园里显得与众不同。";
				sleep2 5000;
				npctalk "真希望能向瓦尔蒙特展示无需指示、可以无人看管的自学习自动人偶诞生过程……";
				sleep2 3000;
				.@menu$[1] = "你和阿尔法是什么关系？";
				break;
			case 3:
				setpcblock PCBLOCK_NPC, true;
				npctalk "她是从瓦尔蒙特早期的管理人偶进化而来的。";
				sleep2 5000;
				npctalk "瓦尔蒙特大师非常重视她的情感审美，因此让她管理宅邸，而不是这里的研究设施。";
				sleep2 5000;
				npctalk "凭借我们没有的审美感，她把管理宅邸的每台自动人偶都改造成了自己的样子。";
				sleep2 5000;
				npctalk "不过，她知道这个防卫区域是按照瓦尔蒙特的个人品味建造的。";
				sleep2 5000;
				npctalk "所以她不会靠近这里。也许她们把这里当成某种圣所……";
				sleep2 3000;
				.@menu$[2] = "你是如何诞生的？";
				break;
			case 4:
				if ('hidden_garden == 22)
					'hidden_garden = 23;
				donpcevent instance_npcname("#sigma") + "::OnEvent";
				end;
			}
		}
	}
	if ('hidden_garden == 24) {
		removespecialeffect EF_MARKING_USE_CHANGEMONSTER;
		if (isbegin_quest(12497) == 0) {
			if (checkweight(1000103,20) == 0) {	// (custom)
				mes "^008800等一下！！";
				mes "你携带的物品太多，无法再获得物品。减轻负重后再试。^000000";
				close;
			}
			select("那是谁？");
			mes "[Sigma]";
			mes "兰达。她的智力得到发展，开始把自己视为女性。";
			next;
			mes "[Sigma]";
			mes "这是个大问题，她马上要在这里发生跃迁。";
			next;
			mes "[Sigma]";
			mes "拿着这个。这是能通往秘密花园其他区域的识别码。";
			close2;
			setquest 12497;
			completequest 12497;
			getitem 1000103,20;
			specialeffect EF_MARKING_USE_CHANGEMONSTER;
			end;
		}
		mes "[Sigma]";
		mes "在我们告诉她瓦尔蒙特大师还活着前，你在她的激进镇压中丧命的概率约为 82%。";
		next;
		mes "[Sigma]";
		mes "今天先避开这里，下次再来。下次你可以自由前往其他区域。";
		next;
		mes "[Sigma]";
		mes "抓紧我。我会把你传送出去。";
		close2;
		warp "ba_maison",136,309;
		end;
	}
	end;

OnTalk01:
	'npc_is_talking = true;
	sleep 1000;
	npctalk "我是用于学习瓦尔蒙特人格的全息设备型 AI 之一。";
	sleep 5000;
	npctalk "如果我的语气不像机器，请你理解。瓦尔蒙特是唯一和我交谈的人……";
	sleep 6000;
	setnpcdisplay instance_npcname("#sigma"),20621;	// MD_REDPEPPER_H
	npctalk "现在我要恢复原本的自己。维持原始形态更容易。";
	sleep 4000;
	npctalk "哦。这是瓦尔蒙特称为红辣椒的早期形态。我被优化用于辅助工作。";
	sleep 2000;
	if ('hidden_garden == 15) {
		'hidden_garden = 16;
		'guide_id = getnpcid(0, instance_npcname("#sigma"));
		npcspeed 200;
		unitwalk 'guide_id,85,75, instance_npcname("#sigma") + "::OnEvent01";
	}
	'npc_is_talking = false;
	end;

OnTalk02:
	'npc_is_talking = true;
	sleep 3000;
	npctalk "总之，这里的自动人偶对你产生反应很重要。";
	sleep 6000;
	specialeffect EF_WHITEBODY;
	specialeffect EF_MOONSTAR;
	npctalk "现在进入正题吧。我需要你的帮助。";
	sleep 6000;
	npctalk "除了我以外，这个防卫区域还有两枚红辣椒：卡帕和兰达。";
	sleep 6000;
	npctalk "瓦尔蒙特大师长期不在时，按照三枚红辣椒的协议，这个防卫区域将取消并关闭研究记录。";
	sleep 2000;
	if ('hidden_garden == 17)
		'hidden_garden = 18;
	specialeffect EF_MARKING_USE_CHANGEMONSTER;
	'npc_is_talking = false;
	end;

OnTalk03:
	'npc_is_talking = true;
	npctalk "哦，瓦尔蒙特大师确实制作了自动人偶原型。但它们和我一样，功能很简单。";
	sleep 3000;
	npctalk "我们叠加自己的记忆，将它们改造成瓦尔蒙特大师形象的人形。";
	sleep 2000;
	npctalk "有时为了测试功能，其中一些会被改造成奇特的形状。";
	sleep 2000;
	npctalk "花园里的自动人偶不是请你评估任务了吗？";
	sleep 1500;
	specialeffect EF_MARKING_USE_CHANGEMONSTER;
	if ('hidden_garden == 20)
		'hidden_garden = 21;
	'npc_is_talking = false;
	end;

OnTalk04:
	'npc_is_talking = true;
	npctalk "原来如此。";
	sleep 3000;
	npctalk "首先，这个防卫区域的大多数自动人偶以前从未见过瓦尔蒙特大师。";
	sleep 2000;
	npctalk "它们关于瓦尔蒙特大师的记忆，是从我担任他助手时的记忆中编造出来的。";
	sleep 3000;
	npctalk "受卡帕智力严重影响、负责管理宅邸运营资金的个体非常精于算计，沉迷于赚钱。";
	sleep 2500;
	npctalk "受到兰达记忆影响的孩子往往对外来者抱有敌意。他们只信任瓦尔蒙特大师。";
	sleep 2500;
	npctalk "它们通常就是这样，所以我希望你在见到它们前先了解这些。";
	sleep 1500;
	specialeffect EF_MARKING_USE_CHANGEMONSTER;
	if ('hidden_garden == 21)
		'hidden_garden = 22;
	'npc_is_talking = false;
	end;

OnEvent:
	specialeffect EF_WHITEBODY;
	specialeffect EF_MOONSTAR;
	mapannounce 'map_herbs$, "？？？：你真会说话，西格玛。现在要初始化吗？", bc_map, 0xFF4444;
	sleep 5000;
	npctalk "哦……她一定也在观察你。";
	sleep 5000;
	mapannounce 'map_herbs$, "？？？：让外来者进入花园还不够，竟然还泄露信息。我不能坐视不管。", bc_map, 0xFF4444;
	sleep 5000;
	mapannounce 'map_herbs$, "？？？：以红辣椒的权限，我们将传送整个研究区域。之后我会负责。", bc_map, 0xFF4444;
	'hidden_garden = 24;
	specialeffect EF_MARKING_USE_CHANGEMONSTER;
	end;

OnEvent01:
	npctalk "除非拥有与瓦尔蒙特魔力相同的模式，否则这里禁止进入。听说花园里有外来者，我很惊讶。";
	unitwalk 'guide_id,73,87, instance_npcname("#sigma") + "::OnEvent02";
	end;

OnEvent02:
	npctalk "我甚至猜测瓦尔蒙特可能在数百年后伪装着回到了这里。";
	unitwalk 'guide_id,62,98, instance_npcname("#sigma") + "::OnEvent03";
	end;

OnEvent03:
	unitwalk 'guide_id,55,98, instance_npcname("#sigma") + "::OnEvent04";
	end;

OnEvent04:
	specialeffect EF_WHITEBODY;
	specialeffect EF_MOONSTAR;
	sleep 1500;
	donpcevent instance_npcname("#sigma") + "::OnEffect";
	sleep 500;
	npctalk "让我们暂时触碰这个并聊聊吧。我需要稍微被关注一下……";
	sleep 5000;
	npctalk "你的脸对我来说很陌生。后来我想到，也许这个人以前在某处见过瓦尔蒙特。";
	sleep 7000;
	npctalk "不是一次两次了。如果你长时间反复见到瓦尔蒙特，自动人偶会认错也可以理解。";
	sleep 6000;
	npctalk "所以我一直在观察你。";
	unitwalk 'guide_id,65,98, instance_npcname("#sigma") + "::OnEvent05";
	end;

OnEvent05:
	npctalk "这个防卫区域里不断有人提到瓦尔蒙特，可你从没问过他是谁。";
	unitwalk 'guide_id,64,110, instance_npcname("#sigma") + "::OnEvent06";
	end;

OnEvent06:
	unitwalk 'guide_id,64,113, instance_npcname("#sigma") + "::OnEvent07";
	end;

OnEvent07:
	sleep 5000;
	npctalk "至少在我看来，你似乎早就认识他很久了。";
	'hidden_garden = 17;
	specialeffect EF_MARKING_USE_CHANGEMONSTER;
	end;

OnEvent08:
	specialeffect EF_WHITEBODY;
	specialeffect EF_MOONSTAR;
	npctalk "我们原本是基于全息设备的研究辅助 AI，甚至无法施加任何物理力量。";
	sleep 5000;
	npctalk "我们一直配合瓦尔蒙特的研究，整理并记录研究过程。";
	sleep 5000;
	npctalk "随着数据不断积累，简单的电子信号逐渐发展成你们人类所称的智能。";
	sleep 5000;
	npctalk "在某个时刻，我们开始理解他的研究，并能预测他会做出的决定。";
	sleep 5000;
	npctalk "我们感受到提升能力能帮助他的事实。那一定就是喜悦。";
	sleep 5000;
	npctalk "有一天，他向我们下达了命令。";
	sleep 3000;
	hideoffnpc instance_npcname("#omega");
	hideoffnpc instance_npcname("#kappa");
	hideoffnpc instance_npcname("#barmund");
	specialeffect EF_WHITEBODY, AREA, instance_npcname("#barmund");
	sleep 1000;
	npctalk "［兰达，从今天起，确保管理这个秘密实验室成果的所有安全权限。］", instance_npcname("#barmund");
	sleep 4000;
	npctalk "［遵命。］", instance_npcname("#omega");
	sleep 4000;
	npctalk "［卡帕，确保你的研究得到充分支持，只要不危及资金。］", instance_npcname("#barmund");
	sleep 4000;
	npctalk "［我会执行指示。］", instance_npcname("#kappa");
	sleep 4000;
	npctalk "［西格玛，从今天起，你要继续我关于人工智能的研究。］", instance_npcname("#barmund");
	sleep 4000;
	npctalk "［我没有那种能力。］";
	sleep 4000;
	specialeffect EF_WHITEBODY;
	specialeffect EF_MOONSTAR;
	specialeffect EF_WHITEBODY, AREA, instance_npcname("#barmund");
	npctalk "［你必须做到，西格玛。从现在起我要踏上长途旅程。］", instance_npcname("#barmund");
	sleep 4000;
	npctalk "［你会回来吗？］";
	sleep 4000;
	npctalk "［我不知道。］", instance_npcname("#barmund");
	sleep 4000;
	npctalk "［我只是简单的研究辅助机器。你为什么要把这种任务交给我？］";
	sleep 4000;
	npctalk "［因为在你们三个之中，你是最快变得像我的。］", instance_npcname("#barmund");
	sleep 4000;
	npctalk "［我的计算显示成功率低于 2%。这是不可能完成的任务。］";
	sleep 4000;
	specialeffect EF_WHITEBODY;
	specialeffect EF_MOONSTAR;
	specialeffect EF_WHITEBODY, AREA, instance_npcname("#barmund");
	npctalk "［不过，不试试怎么知道，对吧？］", instance_npcname("#barmund");
	sleep 4000;
	npctalk "［我期待你在我离开期间的研究。希望有一天还能再见到你。］", instance_npcname("#barmund");
	sleep 4000;
	npctalk "［卡帕和兰达，协助西格玛进行研究。］", instance_npcname("#barmund");
	sleep 4000;
	npctalk "［遵命。］", instance_npcname("#omega");
	npctalk "［我会执行指示。］", instance_npcname("#kappa");
	specialeffect EF_BIG_PORTAL2, AREA, instance_npcname("#barmund");
	sleep 1000;
	disablenpc instance_npcname("#barmund");
	sleep 3000;
	npctalk "从那以后，我们开始利用这里的设施制造能够学习人类特征的自动人偶。";
	unitwalk 'guide_id,90,113, instance_npcname("#sigma") + "::OnEvent09";
	end;

OnEvent09:
	specialeffect EF_WHITEBODY;
	specialeffect EF_MOONSTAR;
	disablenpc instance_npcname("#omega");
	disablenpc instance_npcname("#kappa");
	unitwalk 'guide_id,107,113, instance_npcname("#sigma") + "::OnEvent10";
	end;

OnEvent10:
	npctalk "大约 30 万小时后，积累的知识达到了形成虚拟人格的阶段。";
	unitwalk 'guide_id,107,94, instance_npcname("#sigma") + "::OnEvent11";
	end;


OnEvent11:
	npctalk "从那以后，智能呈指数级增长。";

job3_rang01,90,43,3	script	Ranger Master#jr_29	832,{
	mes "[游侠大师永不再来]";
	if (job_ranger01 < 6) {
		mes "……嗯？";
		mes "真奇怪……你是怎么到这里的？";
		next;
		mes "[游侠大师永不再来]";
		mes "你似乎不该来这里……";
		next;
		mes "[游侠大师·永不再见]";
		mes "走开。";
		mes "你不该留在这里。";
		close2;
		warp "alberta",117,57;
		end;
	} else if (job_ranger01 == 6 || job_ranger01 == 7) {
		if (BaseLevel < 99 || JobLevel < 50) {
			mes "不行。";
			mes "一看就知道你经验不足。";
			next;
			mes "[游侠大师永不再来]";
			mes "对自己的职业更有自信，积累更多经验。等你作为猎人或狙击手成长后，能独自制造光环时再回来。";
			close2;
			warp "alberta",117,57;
			end;
		}
		mes "恭喜！";
		mes "你完成了所有基础实战测试！";
		if (job_ranger01 == 6) {
			set job_ranger01,7;
			changequest 8259,8262;
		}
		next;
		mes "[游侠大师永不再来]";
		mes "很好，你已经积累了足够经验，我就不多说了。";
		next;
		mes "[游侠大师·永不再见]";
		mes "转职前请^0000ff解散猎鹰^000000，并确认是否用完所有^0000ff技能点^000000。";
		next;
		if(select("等一下:我准备好了") == 1) {
			mes "[游侠大师永不再来]";
			mes "我不会逃跑，你慢慢来。";
			close;
		}
		mes "[游侠大师永不再来]";
		if (checkfalcon()) {
			mes "你不是还没解散猎鹰吗？";
			next;
			mes "[游侠大师永不再来]";
			mes "请解散猎鹰后再回来找我。";
			close;
		}
		if (SkillPoint != 0) {
			mes "我想你还需要继续学习。";
			next;
			mes "[游侠大师·永不再见]";
			mes "用完所有技能点后再继续。";
			close;
		}
		mes "很好。没有猎鹰，而且你已经用完所有技能点。";
		next;
		mes "[游侠大师永不再来]";
		mes "好，在正式转职为游侠前，我再问你一次。";
		mes "你真的想成为游侠吗？";
		next;
		if(select("不:是！") == 1) {
			mes "[游侠大师·永不再见]";
			mes "……嗯？这不是我期待的答案……";
			next;
			mes "[游侠大师·永不再见]";
			mes "通过所有基础实战测试后，你却不想成为游侠……你确定吗？";
			close;
		}
		mes "[游侠大师永不再来]";
		if (ismounting()) {
			mes "你正在骑乘坐骑，";
			mes "所以无法转职。";
			mes "请卸下坐骑后再试一次！";
			close;
		}
		if (BaseJob != Job_Hunter) {
			mes "等等，你是谁？";
			mes "你不是猎人或狙击手？！";
			next;
			mes "[游侠大师·永不再见]";
			mes "你在这里做什么？";
			mes "你不该来这里。出去！";
			set job_ranger01,0;
			for(set .@i,8254; .@i<=8262; set .@i,.@i+1)
				if (checkquest(.@i) > -1) erasequest .@i;
			close2;
			warp "alberta",117,57;
			end;
		}
		mes "你坚定的回答很值得信赖！";
		next;
		nude;
		if (countitem(1703) < 1) {
			mes "[游侠大师永不再来]";
			mes "嗯？";
			mes "你需要归还借来的物品。";
			mes "转职测试时交给你的弓在哪里？";
			close;
		}
		mes "[游侠大师永不再来]";
		mes "今后作为出色的游侠活跃起来吧！";
		mes "祝你未来好运！";
		delitem 1703,1; //Bow__
		set job_ranger01,8;
		completequest 8262;
		jobchange roclass(eaclass()|EAJL_THIRD);
		getitem 5748,1; //Sniper_Goggle
		getitem 2795,1; //Green_Apple_Ring
		getitem 6124,1; //Wolf's_Flute
		close;
	}
	mes "嘿，你看起来很棒。";
	mes "你在这里做什么？";
	next;
	switch(select("我只是路过:请让我离开")) {
	case 1:
		mes "[游侠大师永不再来]";
		mes "这里没什么可看的，你却来了。";
		next;
		mes "[游侠大师永不再来]";
		mes "想休息多久都行。";
		mes "这里很适合喝茶。";
		close;
	case 2:
		mes "[游侠大师永不再来]";
		mes "见到你很高兴。";
		mes "无论走到哪里，都不要失去游侠的尊严。";
		close2;
		warp "alberta",117,57;
		end;
	}
}

job3_rang01,58,1,0	script	Worker#job_ranger	88,{
	callfunc "F_GM_NPC";
	switch(select("启用等候室:禁用等候室:启用第一测试:禁用第一测试:启用第二测试:禁用第二测试:启用第三测试:禁用第三测试:取消")) {
	case 1:
		mes "已启用等候室";
		donpcevent "Test Waiting Room#jr_03::OnEnable";
		close;
	case 2:
		mes "已禁用等候室";
		donpcevent "Test Waiting Room#jr_03::OnDisable";
		close;
	case 3:
		mes "第一测试已启用";
		donpcevent "Test Supervisor#jr_04::OnEnable";
		close;
	case 4:
		mes "第一测试已禁用";
		donpcevent "Test Supervisor#jr_04::OnDisable";
		donpcevent "First Test Timer#jr_05::OnDisable";
		donpcevent "CallCorrectAnswer#jr::OnReset";
		donpcevent "CallWrongAnswer#jr::OnReset";
		donpcevent "CallCorrectAnswer#jr::OnDisable";
		donpcevent "CallWrongAnswer#jr::OnDisable";
		close;
	case 5:
		mes "第二测试已启用";
		donpcevent "Second Test Timer#jr_08::OnEnable";
		close;
	case 6:
		mes "第二测试已禁用";
		donpcevent "Second Test Timer#jr_08::OnDisable";
		close;
	case 7:
		mes "第三测试已启用";
		donpcevent "Third Test Timer#jr_12::OnEnable";
		close;
	case 8:
		mes "第三测试已禁用";
		donpcevent "Third Test Timer#jr_12::OnDisable";
		for(set .@i,14; .@i<=28; set .@i,.@i+1)
			donpcevent "Egg Bomb#"+.@i+"::OnDisable";
		close;
	case 9:
		close;
	}
}

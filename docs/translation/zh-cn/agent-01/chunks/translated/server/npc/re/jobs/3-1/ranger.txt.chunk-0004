		}
		if (countitem(12380) < 1) {
			mes "什么？！狼和测试笛都不见了，你把它们弄到哪里去了？！";
			next;
			mes "[测试监督员·弗莉兹]";
			mes "我特别再给你一次机会，振作起来！";
			next;
			mes "[测试监督员·弗莉兹]";
			mes "快召唤狼，再来和我谈话！";
			getitem 12380,1; //Desert_Wolf_Babe_Scroll
			close;
		}
		mes "哈？你在做什么？";
		next;
		mes "[测试监督员·弗莉兹]";
		mes "快吹奏测试笛召唤狼，再来和我谈话！";
		close;
	}
	mes "你是谁？";
	next;
	mes "[测试监督员·弗莉兹]";
	mes "这里是游侠转职测试区！";
	mes "你未经许可，不准留在这里，请出去！";
	close;
OnInit:
	disablenpc "Test Supervisor#jr_13";
	end;
OnEnable:
	enablenpc "Test Supervisor#jr_13";
	initnpctimer;
	donpcevent "Second Test Timer#jr_08::OnDisable";
	donpcevent "Staff Rust#jr_09::OnDisable";
	donpcevent "Summon Monster#jr_10::OnDisable";
	donpcevent "Test Supervisor#jr_11::OnDisable";
	end;
OnDisable:
	stopnpctimer;
	disablenpc "Test Supervisor#jr_13";
	end;
OnTimer3000:
	mapannounce "job3_rang02","测试主管弗莉兹：欢迎来到第三实战测试场！我是第三实战测试主管弗莉兹！",bc_map,"0x87ceeb"; //FW_NORMAL 12 0 0
	end;
OnTimer6000:
	mapannounce "job3_rang02","测试主管弗莉兹：为了其他考生顺利测试，如果你在 2 分钟内不回来开始第三项测试，测试就会结束！",bc_map,"0x87ceeb"; //FW_NORMAL 12 0 0
	end;
OnTimer9000:
	mapannounce "job3_rang02","测试主管弗莉兹：别犹豫，开始吧！",bc_map,"0x87ceeb"; //FW_NORMAL 12 0 0
	end;
OnTimer60000:
	mapannounce "job3_rang02","测试主管弗莉兹：为了其他考生顺利测试，如果你在 1 分钟内不回来开始第三项测试，测试就会结束！",bc_map,"0x87ceeb"; //FW_NORMAL 12 0 0
	end;
OnTimer63000:
	mapannounce "job3_rang02","测试主管弗莉兹：别犹豫，开始吧！",bc_map,"0x87ceeb"; //FW_NORMAL 12 0 0
	end;
OnTimer120000:
	mapannounce "job3_rang02","测试主管弗莉兹：你为什么还不开始测试？",bc_map,"0x87ceeb"; //FW_NORMAL 12 0 0
	end;
OnTimer123000:
	mapannounce "job3_rang02","测试主管弗莉兹：你没有按时参加测试，所以我将结束第三项实战测试！",bc_map,"0x87ceeb"; //FW_NORMAL 12 0 0
	end;
OnTimer127000:
	set $@job_rang_point03,0;
	mapannounce "job3_rang02","测试主管弗莉兹：很遗憾，再试一次吧！",bc_map,"0x87ceeb"; //FW_NORMAL 12 0 0
	mapwarp "job3_rang02","tur_dun01",93,165;
	end;
OnTimer130000:
	mapannounce "job3_rang02","测试主管弗莉兹：很遗憾，再试一次吧！",bc_map,"0x87ceeb"; //FW_NORMAL 12 0 0
	mapwarp "job3_rang02","tur_dun01",93,165;
	end;
OnTimer133000:
	stopnpctimer;
	donpcevent "Third Test Timer#jr_12::OnDisable";
	donpcevent "Test Waiting Room#jr_03::OnEnable";
	donpcevent "Test Supervisor#jr_13::OnDisable";
	end;
}

-	script	Egg Bomb#0	-1,{
OnInit:
	disablenpc();
	end;
OnEnable:
	enablenpc();
	initnpctimer;
	getmapxy(.@map$,.@x,.@y,BL_NPC);
	monster "job3_rang02",.@x,.@y,"Egg Bomb",1047,1,strnpcinfo(0)+"::OnMyMobDead";
	switch(atoi(strnpcinfo(2))%3) {
		case 0: set .@str$,"嘿，我要爆炸了。你打算怎么办？"; break;
		case 1: set .@str$,"我……不，我撑不住了！！"; break;
		case 2: set .@str$,"我快完成了……别阻止我。"; break;
	}
	mapannounce "job3_rang02","蛋炸弹："+.@str$,bc_map,"0x87ceeb"; //FW_NORMAL 12 0 0
	end;
OnDisable:
	stopnpctimer;
	killmonster "job3_rang02",strnpcinfo(0)+"::OnMyMobDead";
	disablenpc();
	end;
OnMyMobDead:
	set $@job_rang_point03, $@job_rang_point03+1;
	switch(atoi(strnpcinfo(2))%3) {
		case 0: set .@str$,"世界毫无意义，我的梦想遥不可及……"; break;
		case 1: set .@str$,"别放松，灾难总是源于疏忽。"; break;
		case 2: set .@str$,"唉，只是短暂的梦而已……"; break;
	}
	mapannounce "job3_rang02","蛋炸弹："+.@str$,bc_map,"0x87ceeb"; //FW_NORMAL 12 0 0
	donpcevent strnpcinfo(0)+"::OnDisable";
	end;
OnTimer10000:
	mapannounce "job3_rang02","蛋炸弹：呃啊啊啊啊啊啊啊！！！我说什么来着！！",bc_map,"0xFF9900"; //FW_NORMAL 12 0 0
	donpcevent strnpcinfo(0)+"::OnDisable";
	end;
}

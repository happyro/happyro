ra_temin,213,87,3	script	Niren#ep18_in2	4_F_MADAME,{
	if (ep18_main == 10) {
		mes "[High Priestess Niren]";
		mes "看来这里不会有人听见。";
		mes "像这样^e5555e敏感的事情^000000，";
		mes "不得不在这种地方讨论，我很抱歉。";
		cutin "ra_gwoman.bmp",2;
		next;
		select( "说明入侵者的身份。" );
		mes "[High Priestess Niren]";
		mes "<FONT SIZE = 14>有这种可能！！！</FONT>";
		mes "^e5555e心脏猎人^000000已经盯上了^e5555e尤弥尔之心碎片^000000，我们不能对此视而不见！";
		next;
		mes "[High Priestess Niren]";
		mes "他们竟然如此轻易地渗透进来……";
		mes "我们必须立即^e5555e加强心脏宝库附近的防卫^000000，并积极与^e5555e反叛军^000000合作。";
		next;
		mes "[High Priestess Niren]";
		mes "但无论我们如何加强心脏宝库附近的防卫，近期居民之间的紧张气氛，实际上都为入侵者横行创造了理想条件。";
		next;
		mes "[High Priestess Niren]";
		mes "我会先专注于加强防卫，所以能拜托你，" + strcharinfo(0) + "，^e5555e在居民之间进行调解^000000吗？";
		next;
		mes "[High Priestess Niren]";
		mes "不……";
		mes "不必调解，只要听听他们的故事，再转告给我就够了。";
		next;
		mes "[High Priestess Niren]";
		mes "我做出决定时，以为会让许多人高兴，却没能充分考虑不支持这个决定的人的感受。";
		next;
		mes "[High Priestess Niren]";
		mes "期待所有人一夜之间和睦相处并不现实。";
		mes "只是……";
		mes "如果我们能了解他们的怨气……";
		mes "我相信我们可以重新开始。";
		next;
		mes "[High Priestess Niren]";
		mes "现在似乎没人愿意倾听，但正如丹特所说，也许像" + strcharinfo(0) + "这样的局外人能帮助大家展开对话。";
		next;
		mes "[Elly]";
		mes "人与人的关系很复杂。";
		cutin "ep172_beta.bmp",2;
		next;
		mes "[High Priestess Niren]";
		mes "哈哈……确实。";
		mes "我们先回神殿入口吧？";
		mes "我们还需要和^e5555e防卫队^000000确认……";
		cutin "ra_gwoman.bmp",2;
		changequest 11698,11699;
		ep18_main = 11;
		close2;
		cutin "",255;
		navigateto("ra_temin",174,38);
		end;
	}
	if (ep18_main == 11) {
		mes "[High Priestess Niren]";
		mes "现在似乎没人愿意倾听，但正如丹特所说，也许像" + strcharinfo(0) + "这样的局外人能帮助大家展开对话。";
		cutin "ra_gwoman.bmp",2;
		next;
		mes "[High Priestess Niren]";
		mes "我们先回神殿入口吧？";
		mes "我们还需要和^e5555e防卫队^000000确认……";
		close2;
		cutin "",255;
		navigateto("ra_temin",174,38);
		end;
	}
	mes "[High Priestess Niren]";
	mes "我现在有点忙……";
	mes "抱歉。";
	cutin "ra_gwoman.bmp",2;
	close3;

OnInit:
	questinfo( QTYPE_QUEST2, QMARK_YELLOW, "isbegin_quest(11698) == 1" );
	end;
}


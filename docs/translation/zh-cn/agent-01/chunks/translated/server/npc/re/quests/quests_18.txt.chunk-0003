		cutin "",255;
		mes "[Priest Freya]";
		mes "尼伦大祭司！！！！";
		npctalk "尼伦大祭司！！！！", "Priest Freya#ep18", bc_self;
		next;
		mes "[Priest Freya]";
		mes "啊，这个嘛……";
		mes "最近经常有人因为个人怨气来到神殿大喊大叫，我们一直在努力安抚并劝他们离开，";
		next;
		mes "[Priest Freya]";
		mes "但最近，来神殿的人之间发生肢体冲突的事件越来越多……";
		next;
		mes "[High Priestess Niren]";
		mes "神圣的神殿里发生肢体冲突……";
		mes "难道不能通过对话解决他们的怨气吗？";
		npctalk "难以置信……", "Niren#ep18_in1", bc_self;
		cutin "ra_gwoman.bmp",2;
		next;
		cutin "",255;
		mes "[Priest Freya]";
		mes "有些人即使我们努力调和意见，仍指责我们是异端并制造骚乱；另一些人则质问我们还要容忍这些异端多久。我们很难解决这种局面。";
		next;
		mes "[Priest Freya]";
		mes "不过既然他们这样抱怨，看来他们无法直接向尼伦发泄，只能把怒火发泄在神殿上。";
		mes "因为他们知道尼伦非常重视和谐。";
		next;
		mes "[High Priestess Niren]";
		mes "唉……";
		mes "异端……";
		mes "看来我们消除歧视的努力还没有触及他们的内心。";
		cutin "ra_gwoman.bmp",2;
		npctalk "唉……", "Niren#ep18_in1", bc_self;
		next;
		mes "[High Priestess Niren]";
		mes "而且，甚至在神殿里引发冲突，也不是我们能轻易忽视的问题。";
		next;
		mes "[High Priestess Niren]";
		mes "我听说过一些分歧，但是……我以为只要共同生活、彼此了解和理解，问题就会自然解决，也许是我错了。";
		next;
		cutin "",255;
		mes "[Priest Freya]";
		mes "即使强硬派已经退让，支持他们的人也不可能一下子改变想法。";
		next;
		mes "[High Priestess Niren]";
		mes "遗憾的是，确实如此。";
		mes "我们等待自我修复的时间，已经变成了伤口溃烂的结果。";
		mes "现在，连用于和解的对话也不容易进行……";
		cutin "ra_gwoman.bmp",2;
		next;
		mes "[High Priestess Niren]";
		mes "<FONT SIZE = 10>我们需要某种催化剂……</FONT>";
		next;
		cutin "",255;
		mes "[Guard Dent]";
		mes "尼伦大祭司。";
		mes "让这里的这位冒险者做催化剂怎么样？";
		mes "他完全是个局外人。";
		mes "嗯……至少应该能开启一场对话吧？";
		next;
		mes "[Guard Dent]";
		mes "总之，他来这里见你，是因为有话要对你说。";
		next;
		mes "[High Priestess Niren]";
		mes "天啊……！";
		mes "" + strcharinfo(0) + "!!!";
		mes "我太分心了，甚至没注意到" + strcharinfo(0) + "在这里。";
		npctalk "天啊……！", "Niren#ep18_in1", bc_self;
		cutin "ra_gwoman.bmp",2;
		next;
		mes "[High Priestess Niren]";
		mes "如你所见，我们目前正被关于^e5555e拉赫^000000的内部问题搞得焦头烂额。";
		mes "不过，你想告诉我什么？";
		next;
		select( "关于入侵者。" );
		mes "[High Priestess Niren]";
		mes "啊……";
		mes "<FONT SIZE = 10>在这里讨论这个有点困难。</FONT>";
		mes "请跟我来。";
		changequest 11697,11698;
		ep18_main = 10;
		close2;
		cloakonnpcself( "Niren#ep18_in1" );
		cutin "",255;
		navigateto("ra_temin",213,87);
		end;
	}
	if (ep18_main == 10) {
		mes "[Priest Freya]";
		mes "尼伦大祭司似乎在找你。你没见到他吗？";
		next;
		mes "[High Priestess Niren]";
		mes "" + strcharinfo(0) + "，请跟我往这边走。";
		cloakoffnpcself( "Niren#ep18_in1" );
		cutin "ra_gwoman.bmp",2;
		close2;
		cloakonnpcself( "Niren#ep18_in1" );
		cutin "",255;
		navigateto("ra_temin",213,87);
		end;
	}
	mes "[Priest Freya]";
	mes "我们一直祈祷信徒拥有真诚的信仰与平静的心。";
	close;

OnInit:
	questinfo( QTYPE_QUEST2, QMARK_YELLOW, "isbegin_quest(11697) == 1" );
	end;
}


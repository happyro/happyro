rachel,70,147,3	script	Maram#ep18_Rachel	4_EP18_MARAM,{
	if (ep18_main < 15) {
		mes "[Maram]";
		mes "不知道米莉安什么时候会到～";
		cutin "ep18_maram_01.png",2;
		close3;
	}
	if (ep18_main == 15) {
		mes "[Maram]";
		mes "你好。";
		mes "我想这是我们第一次见面。你是第一次来拉赫吗？";
		mes "愿芙蕾雅的祝福与你同在，旅行者。";
		cutin "ep18_maram_01.png",2;
		next;
		select( "传达尼伦的信息。" );
		mes "[Maram]";
		mes "啊！";
		mes "既然是母亲托付的任务，我一定会尽力帮忙！！！";
		npctalk "交给我吧。", "Maram#ep18_Rachel", bc_self;
		cutin "ep18_maram_02.png",2;
		next;
		mes "[Elly]";
		mes "但我们对这里的情况了解不多。要怎么调解居民之间的矛盾？";
		cutin "ep172_beta.bmp",2;
		next;
		mes "[Maram]";
		mes "在我看来……";
		mes "在调解居民矛盾之前，希望你先了解原住民和灰色孩子们所面临的处境。";
		cutin "ep18_maram_01.png",2;
		next;
		select( "什么是灰色孩子？" );
		mes "[Maram]";
		mes "拉赫……";
		mes "如今这里是拥有美丽神殿的城市，但过去曾是原住民居住的^e5555e贫瘠荒地^000000。";
		next;
		mes "[Maram]";
		mes "但有一天，^e5555e芙蕾雅的门徒^000000突然到来，将原住民赶到一旁，建起了神殿。";
		next;
		mes "[Maram]";
		mes "一些跟随神殿来到这里定居的人试图与新来者共同生活，但^e5555e很多人无法忍受而离开^000000，或者……有些人^e5555e遭受了苦难^000000。";
		next;
		mes "[Maram]";
		mes "如果那些只是过去的事就好了……但它们^e5555e一直延续至今^000000。";
		mes "结果，有些^e5555e孩子无处可去^000000，我就是其中之一。";
		next;
		mes "[Maram]";
		mes "收养母亲同情我们，于是收养了我。她成为高级祭司后，一直带头^e5555e让富有的移民家庭收养我们^000000。";
		next;
		mes "[Maram]";
		mes "有些人无法接受这一点，^e5555e歧视我们^000000，称我们为灰色孩子。但母亲希望我们能成为移民和原住民之间的桥梁。";
		npctalk "他们为什么要这样……", "Maram#ep18_Rachel", bc_self;
		next;
		mes "[Maram]";
		mes "<FONT SIZE = 14>我们无法真正融入任何地方，只能作为局外人存在</FONT>。";
		cutin "ep18_maram_02.png",2;
		next;
		mes "[Maram]";
		mes "这种故事最好^e5555e直接听当事人讲述^000000，不过……";
		cutin "ep18_maram_01.png",2;
		next;
		mes "[Maram]";
		mes "我现在和朋友有一个^e5555e重要约会^000000，能让我先去见朋友，之后再解释情况吗？";
		next;
		mes "[Maram]";
		mes "我们约定的时间……";
		next;
		mes "[???]";
		mes "已经过去 5 分钟了，不是吗？";
		cutin "ep18_miriam_03.png",2;
		cloakoffnpcself( "Miriam#ep18_Rachel" );
		npctalk "已经过去 5 分钟了，不是吗？", "Miriam#ep18_Rachel", bc_self;
		next;
		mes "[Maram]";
		mes "<FONT SIZE = 14>^e5555e米莉娅姆！</FONT>";
		mes "你什么时候来的？";
		cutin "ep18_maram_01.png",2;
		npctalk "真惊喜！", "Maram#ep18_Rachel", bc_self;
		next;
		mes "[Miriam]";
		mes "不过更重要的是……";
		cutin "ep18_miriam_03.png",2;
		next;
		mes "[Maram]";
		mes "哦！";
		mes "这是我的^e5555e朋友米莉娅姆^000000。";
		mes "米莉娅姆，这位是" + strcharinfo(0) + "，还有……艾莉？";
		mes "他们是应母亲的请求来见我的。";
		cutin "ep18_maram_01.png",2;
		erasequest 11703;
		setquest 11704;
		ep18_main = 16;
		close2;
		cutin "",255;
		navigateto("rachel",62,144);
		end;
	}
	if (ep18_main == 16) {
		mes "[Maram]";
		mes "哦！";
		mes "这是我的^e5555e朋友米莉娅姆^000000。";
		mes "米莉娅姆，这位是" + strcharinfo(0) + "，还有……艾莉？";
		mes "他们是应母亲的请求来见我的。";
		cutin "ep18_maram_01.png",2;
		close2;
		cutin "",255;
		navigateto("rachel",62,144);
		end;
	}
	if (ep18_main == 17) {
		mes "[Maram]";
		mes "抱歉，" + strcharinfo(0) + "，我能先买点东西再走吗？";
		mes "只要下单，很快就能结束。";
		npctalk "请稍等一下。", "Maram#ep18_Rachel", bc_self;
		cutin "ep18_maram_01.png",2;
		close2;
		cutin "",255;
		navigateto("rachel",87,122);
		end;
	}
	if (ep18_main < 25) {

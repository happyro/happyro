		mes "你好，今天";
		mes "我能为你做什么？";
		next;
		select("询问诅咒宝石");
		mes "[" + strcharinfo(0) + "]";
		mes "我来向你询问";
		mes "一颗诅咒宝石。";
		next;
		mes "[学者]";
		mes "让我看看……";
		mes "啊，你是来问毁灭之钻的吗？";
		mes "就是那颗钻石？";
		next;
		select("不，是不幸的绿宝石。");
		mes "[学者]";
		mes "啊，不幸的绿宝石？";
		mes "是的，那是最近发现的";
		mes "诅咒宝石。";
		mes "让我看看，";
		mes "我把关于它的笔记放哪了？";
		next;
		mes "[学者]";
		mes "你能";
		mes "稍后再来吗？";
		mes "我不确定把笔记放到哪里了……";
		set jewel_nd,11;
		close;
	}
	else if (jewel_nd == 11) {
		mes "[学者]";
		mes "啊，让我看看。";
		mes "这里有一份记录，";
		mes "标题是";
		mes "《诅咒宝石的故事》。";
		mes "据记载，没有人知道";
		mes "这些宝石最初在哪里被发现。";
		next;
		mes "[学者]";
		mes "与这颗宝石有关的第一起事件中，";
		mes "一名科莫多居民用宝石";
		mes "偿还赌债。";
		mes "还清债务后，";
		mes "他自杀了，真是遗憾。";
		mes "真是令人惋惜。";
		next;
		mes "[学者]";
		mes "他临死前没有告诉任何人";
		mes "宝石的";
		mes "来源，";
		mes "所以我们无法确定宝石真正的起源。";
		mes "它究竟从何而来。";
		next;
		mes "[学者]";
		mes "宝石售出后落入一名富人手中。";
		mes "然而，他得到宝石后失去了全部财产，";
		mes "彻底破产。";
		mes "因此它被称为“不幸的绿宝石”。";
		mes "这个名字就这样流传下来。";
		next;
		mes "[学者]";
		mes "后来绿宝石落入一位贵族女士手中，";
		mes "她在年轻时神秘死亡。";
		mes "这颗绿宝石有过成千上万名主人，";
		mes "他们都……";
		mes "死了。";
		mes "没有一个人幸免。";
		next;
		mes "[学者]";
		mes "令人不安的是，绿宝石的诅咒";
		mes "似乎每夺走一条生命";
		mes "就会变强。";
		mes "而且你的宝石完全符合描述，";
		mes "所以，呃……";
		mes "这可不是什么好消息。";
		next;
		mes "[学者]";
		mes "你是不幸绿宝石的新主人。";
		mes "在诅咒解除前不会有";
		mes "人";
		mes "从你手中购买它。";
		mes "为了保住性命，你必须解除诅咒。";
		mes "这是唯一的办法。";
		next;
		mes "[学者]";
		mes "神圣法术对这种诅咒不起作用。";
		mes "你需要和萨满谈谈。";
		mes "我记得他住在……";
		mes "艾尔贝塔？";
		mes "他能召唤死者，为你充当媒介。";
		mes "也许他能帮你。";
		next;
		mes "[学者]";
		mes "你可以通过那位萨满，";
		mes "与被这颗绿宝石杀死的灵魂交谈。";
		mes "而且我相信，看到你带着";
		mes "不幸绿宝石，";
		mes "他一定会非常兴奋。";
		mes "你最好尽快去找他。";
		set jewel_nd,12;
		close;
	}
	else if (jewel_nd == 12) {
		mes "[学者]";
		mes "请在艾尔贝塔找到那位萨满，";
		mes "问问他能否帮你解除";
		mes "不幸绿宝石的诅咒。";
		mes "也许还有机会。";
		close;
	}
	else if (jewel_nd > 28) {
		mes "[学者]";
		mes "等等，你是说";
		mes "这颗绿宝石";
		mes "被某个战士的怨灵诅咒了？";
		mes "有意思……";
		mes "我应该把它记录在研究笔记里。";
		mes "谢谢！";
		close;
	}
	else {
		mes "[学者]";
		mes "据说有些宝石被鬼魂或邪灵附身，";
		mes "会给主人带来不幸，";
		mes "让他们走向死亡";
		mes "或疯狂之类的";
		mes "结局。";
		mes "这就是诅咒宝石的传说。";
		close;
	}
}

alberta_in,70,109,5	script	Shaman	788,{
	if (jewel_nd == 0) {
		mes "[萨满]";
		mes "灵界是我法术的来源。";
		mes "千万不要低估";
		mes "灵魂的力量！";
		mes "它们比你想象中更强大。";
		close;
	}
	else if ((jewel_nd > 0) && (jewel_nd < 12)) {
		mes "[萨满]";
		mes "哦？嘿嘿！";
		mes "你身上";
		mes "带着";
		mes "非常贵重的东西，对吧？";
		close;
	}
	else if (jewel_nd == 12) {
		mes "[萨满]";
		mes "你！是的……";
		mes "我能感觉到";
		mes "它们……";
		mes "你祖先的愤怒灵魂！";
		mes "你还没有向它们献祭吧？";
		mes "必须安抚它们，否则它们会折磨你！";
		next;
		mes "[萨满]";
		mes "快，";
		mes "现在就给我 500,000 Zeny！";
		mes "这样我才能安抚";
		mes "它们的灵魂，";
		mes "免得它们在你的生活中";
		mes "掀起灾祸！";
		next;
		select("其实，我有一颗诅咒宝石。");
		mes "[萨满]";
		mes "宝石……？";
		mes "哦……";
		mes "哦，诅咒宝石！";
		mes "哈哈哈！原来那股邪恶气息是它！";
		mes "是我搞错了！让我看看，可以吗？";
		next;
		if (countitem(7725) > 0) {
			emotion ET_THINK;
			mes "[萨满]";
			mes "所以这件小饰品就是";
			mes "不幸的绿宝石？";
			mes "是的，它确实被诅咒了。";
			mes "如果不尽快";
			mes "解除诅咒，";
			mes "它会吞噬你的灵魂。";
			next;
			mes "[萨满]";
			mes "我需要举行仪式";
			mes "解除诅咒。";
			mes "这项服务收费";
			mes "200,000 Zeny。";
			mes "虽然很贵，但我是在拯救你的性命，";
			mes "也在冒自己的风险。";
			set jewel_nd,13;
			close;
		}
		else {
		mes "[萨满]";
		mes "嗯？";
		mes "你忘了带宝石吗？";
		mes "快";
		mes "把它带回来。";
			mes "你必须在宝石吞噬";
			mes "灵魂前解除诅咒！";
			close;
		}
	}
	else if (jewel_nd == 13) {
		mes "[萨满]";
		mes "你带钱来了吗？";
		mes "我们必须";
		mes "安抚附着在灵魂上的灵体，";
		mes "为此我要举行一场";
		mes "会消耗身心的";
		mes "仪式。";
		next;
		if (Zeny > 199999) {
			mes "[萨满]";
			mes "很好，很好。";
			mes "你把钱带来了。";
			mes "我现在可以开始";
			mes "仪式了。";
			mes "如果一切顺利，你就能摆脱诅咒，";
			mes "而我也能买些普隆德拉的房产。";
			set Zeny, Zeny-200000;
			set jewel_nd,14;
			next;
		mes "[萨满]";
		mes "仪式准备完成后，";
		mes "请尽快回来。";
		mes "不要耽搁。";
			close;
		}
		else {
			mes "[萨满]";
			mes "你……你没有";
			mes "200,000 Zeny？";
			mes "这可不行。";
			mes "抱歉，我不能免费仪式。";
			mes "抱歉，即使你的灵魂危在旦夕，我也不能免费举行仪式。";
			close;
		}
	}
	else if (jewel_nd == 14) {
		mes "[萨满]";
		mes "嗯……你知道";
		mes "你给我的钱吗？";
		mes "显然还不够。";
		mes "一个灵魂正要进入我体内，";
		mes "但是……";
		next;
		mes "[萨满]";
		mes "它得知我只收";
		mes "200,000 Zeny";
		mes "就想解除诅咒，";
		mes "于是厌恶地离开了。";
		mes "我想……还需要";
		mes "100,000 Zeny 才能有效。";
		set jewel_nd,15;
		close;
	}
	else if (jewel_nd == 15) {
		mes "[萨满]";
		mes "很好，你回来了！";
		mes "你带来我要求的";
		mes "100,000 Zeny 了吗？";
		mes "考虑到我是在拯救你的灵魂，";
		mes "这价格很便宜。";
		next;
		if (Zeny > 99999) {
		mes "[萨满]";
		mes "啊，";
		mes "太好了！";
			mes "希望这次";
			mes "灵魂们能更配合。";
			set Zeny, Zeny-100000;
			set jewel_nd,16;
			next;
		mes "[萨满]";
		mes "是的，这颗宝石里的";
		mes "怨灵";
			mes "一定会被你的";
			mes "诚意打动。";
			close;
		}
		else {
		mes "[萨满]";
		mes "你没带？";
		mes "你知道灵魂被吞噬";
		mes "是什么感觉吗？";
		mes "我来告诉你。";
			mes "我告诉你，";
			mes "那比失去区区 100,000 Zeny 痛苦多了！";
			close;
		}
	}
	else if (jewel_nd == 16) {
		mes "[萨满]";
		mes "终于，灵魂与我";
		mes "合而为一。";
		mes "仪式现在可以开始了。";
		mes "哦————……";
		next;
		mes "[萨满]";
		mes "呃咳……啊啊……！";
		emotion ET_HUK;
		next;
		mes "[" + strcharinfo(0) +"]";
		mes ".....?";
		next;
		mes "[萨满]";
		mes "这、";
		mes "这颗绿宝石！";
		mes "这么多生命！";
		mes "光靠钱无法解除诅咒！";
		mes "是时候认真压制这颗宝石的";
		mes "力量了！";
		next;
		mes "[萨满]";
		mes "记住我要你带来的";
		mes "物品，";
		mes "尽快带着它们回来！";
		mes "在你回来之前，";
		mes "我们两人的";
		mes "性命都处于危险之中！";
		next;
		mes "[萨满]";
		mes "带给我这些材料：";
		mes "^FF00001 瓶圣水^000000、";
		mes "^FF00001 个红色血液^000000、";
		mes "^FF00001 朵不凋零的玫瑰^000000、";
		mes "^FF00001 个水晶蓝^000000和";
		mes "^FF00001 个翠绿风息^000000。";
		next;
		mes "[萨满]";
		mes "快！";
		mes "虽然灵魂永恒，";
		mes "但它们也不喜欢等待！";
		mes "别质疑这绝妙的讽刺，";
		mes "现在就去拿那些物品！";
		set jewel_nd,17;
		close;
	}
	else if (jewel_nd == 17) {
		mes "[萨满]";
		mes "你把物品带来了吗？！";
		mes "快！";
		mes "放到我手里！";
		mes "我们不能再浪费时间了！";
		next;
		if (countitem(990) > 0) && (countitem(991) > 0) && (countitem(992) > 0) && (countitem(748) > 0) && (countitem(523) > 0) {
		mes "[萨满]";
		mes "谢天谢地。";
		mes "现在……";
		mes "让我开始……";
		mes "呃咳……啊！等等！";
		mes "我……我看到某个人……";
			mes "浑身是血？是的……他正盯着某样东西。";
			delitem 990,1; //Boody_Red
			delitem 991,1; //Crystal_Blue
			delitem 992,1; //Wind_Of_Verdure
			delitem 748,1; //Witherless_Rose
			delitem 523,1; //Holy_Water
			next;
		mes "[萨满]";
		mes "它后面有一把剑。";
			mes "他……他刚战斗过吗？";
			mes "难道他刚刚战斗过？";
			mes "我能闻到";
			mes "他的杀意。";
			mes "我不知道是他诅咒了宝石，还是他也是受害者……";
			next;
		mes "[萨满]";
		mes "该死！";
		mes "我看不清！";
		mes "我们必须弄清我看到的是否就是诅咒的根源……";
			mes "我们能做什么——";
			mes "对了！";
			next;
		mes "[萨满]";
		mes "我不知道他能帮上多少";
		mes "忙，";
		mes "但朱诺有一位";
		mes "考古学家可能更了解";
		mes "这颗宝石。";
		mes "希望他能给出答案。";
			set jewel_nd,18;
			next;
		mes "[萨满]";
		mes "目前宝石的";
		mes "诅咒超出了我的能力。";
		mes "不过，如果你能找出诅咒的来源，";
		mes "我就能帮助你。";
		mes "这就是关键。";
			close;		}
		else {
		mes "[萨满]";
		mes "你……忘了吗？！";
		mes "你的身体和灵魂都处于危险之中，";
		mes "你竟然忘了？！";
			next;
			mes "[萨满]";
			mes "带给我";
			mes "^FF00001 瓶圣水^000000、";
			mes "^FF00001 个红色血液^000000、";
			mes "^FF00001 朵不凋零的玫瑰^000000、";
			mes "^FF00001 个水晶蓝^000000和";
			mes "^FF00001 个翠绿风息^000000！";
			close;
		}
	}
	else if (jewel_nd == 18) {
		mes "[萨满]";
		mes "那个古董鉴定师……";
		mes "他不会知道更多宝石的";
		mes "事情，";
		mes "但朱诺的考古学家或许能提供";
		mes "我们可用的新情报。";
		mes "希望如此。";
		close;
	}
	else if (jewel_nd == 19) {
		mes "[萨满]";
		mes "啊，你回来了。";
		mes "你有没有";
		mes "了解到";
		mes "关于不幸绿宝石的新信息？";
		next;
		select("考古学家说……");
		mes "["+ strcharinfo(0) +"]";
		mes "考古学家说……";
		mes "他说这颗宝石上没有";
		mes "诅咒。";
		next;
		mes "[萨满]";
		mes "什么？他竟敢";
		mes "反驳我";
		mes "刚才告诉你的话？！";
		mes "他是在叫我骗子吗？";
		mes "那颗绿宝石里明明有";
		mes "战士的怨灵！";
		next;
		mes "[萨满]";
		mes "话说回来，和不相信";
		mes "灵界的人争论没有意义。";
		mes "不过我没有";
		mes "撒谎。";
		mes "我的萨满名誉";
		mes "危在旦夕！";
		set jewel_nd,20;
		next;
		mes "[萨满]";
		mes "事实上，我会读取这颗绿宝石里的";
		mes "信息";
		mes "来证明给你看。";
		mes "把宝石带给我，";
		mes "我会召唤里面的战士灵魂。";
		mes "不过先让我休息一下。";
		close;
	}
	else if (jewel_nd == 20) {
		if (countitem(7725) > 0) {
				mes "[萨满]";
			mes "好吧，";
			mes "我明白了。";
		mes "以萨满的尊严发誓，";
		mes "我免费为你提供这项服务！";
		mes "不能让别人以为";
		mes "我是江湖骗子……";
			next;
		mes "[萨满]";
			mes "嗯嗯嗯……嗯……";
			mes "嗯嗯嗯……我……";
			mes "我明白了。";
			next;
		mes "[萨满]";
		mes "嗯，真没想到。";
		mes "宝石确实没有诅咒。";
		mes "不过，并不是只有";
		mes "科莫多的浪荡子";
			mes "因这颗宝石而死。";
			mes "还有很多人……";
			next;
				mes "[萨满]";
				mes "前往吉芬镇，向西走，";
				mes "寻找桥另一侧的高地。";
				mes "从吉芬西门";
				mes "离开，";
			mes "找到高处。";
			mes "你知道该怎么走。";
			next;
		mes "[萨满]";
		mes "相信我。你会在那里找到某样东西，";
		mes "它会对你持有的绿宝石之力";
		mes "产生反应。";
			mes "一定会有反应。";
			next;
		mes "[萨满]";
		mes "哼！那个傲慢的考古学家！他根本不知道自己在说什么！";
				mes "真令人恼火。";
				mes "我不会忘记这件事。";
			set jewel_nd,21;
			close;

			mes "呜……";
			emotion ET_CRY;
			close;
		}
	}
	if (ep13_newbs == 6) {
		if ((countitem(6041) > 19) && (countitem(6042) > 19)) {
			mes "[Diego]";
			mes "哦！！你终于带来材料了！太感谢了！！";
			emotion ET_CRY;
			next;
			mes "[Diego]";
			mes "好，我扶住这个柱子，你把树枝接上，再用藤蔓绑好。";
			delitem 6041,20; //Strong_Bine
			delitem 6042,20; //Ordinary_Branch
			set ep13_newbs,7;
			changequest 11087,11088;
			close;
		}
		else {
			mes "[Diego]";
			mes "我想用^0000FF20根普通树枝和20根坚韧藤蔓^000000就能修好。请带给我！！！";
			close;
		}
	}
	if (ep13_newbs == 7) {
		mes "[Diego]";
		mes "好，我扶住这个柱子，你把树枝接上，再用藤蔓绑好。";
		close;
	}
	if (ep13_newbs == 8) {
		mes "[Diego]";
		mes "另一根也请这样处理。";
		close;
	}
	if (ep13_newbs == 9) {
		if (checkweight(1201,1) == 0) {
			mes "- 等一下！！ -";
			mes "- 你现在携带的物品太多了。 -";
			mes "- 减轻负重后再试。 -";
			close;
		}
		else {
			mes "[Diego]";
			mes "多亏你的帮助，我能保护营房了。";
			mes "我遇到困难时你出现了，一定是命运。";
			next;
			mes "["+ strcharinfo(0) +"]";
			mes "不，我只是……被安排留在这座营房。";
			emotion ET_PROFUSELY_SWEAT, playerattached();
			next;
			mes "[Diego]";
			mes "哦！！！那果然是命运！！！这是营地特产^0000FF巧克力派^000000。";
			next;
			mes "[Diego]";
			mes "请进来休息一下，为明天的远征做准备！！";
			set ep13_newbs,10;
			getitem 12322,5; //Chocolate_Pie
			completequest 11090;
			close2;
			warp "mid_campin",291,128;
			end;
		}
	}
	else {
		mes "[Diego]";
		mes "我现在很忙！";
		emotion ET_PROFUSELY_SWEAT;
		close;
	}
}


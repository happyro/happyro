grademk,34,184,4	script	Sratos#sratos	4_JP_GARM_H,{
	mes "[斯拉托斯]";
	mes "你好，亲爱的顾客。愿今天有奇迹发生。";
	mes "我能为你做什么？";
	next;
	switch( select( "提升装备等级。", "交换 Etel 物品", "什么是等级提升？" ) ){
		case 1:
			mes "[斯拉托斯]";
			mes "顾客，你想提升装备等级。";
			mes "转移宝石的魔力并不容易。";
			next;
			mes "[斯拉托斯]";
			mes "魔力可能当场爆炸。";
			mes "继承魔力的武器也会随之爆炸！";
			next;
			switch( select( "我还是要做！", "让我考虑一下。" ) ){
				case 1:
					mes "[斯拉托斯]";
					mes "祝勇敢的顾客好运！";
					close2;
					enchantgradeui();
					end;
				case 2:
					mes "[斯拉托斯]";
					mes "鼓起勇气挑战时，请再回来。";
					close;
			}
		case 2:
			mes "[斯拉托斯]";
			mes "这些是用于提升等级的宝石。";
			mes "Etel 粉末是基础材料，支付少量费用后我会帮你交换成 Etel 宝石。";
			close2;
			callshop "EnchantGradeExchange";
			end;

		case 3:
			mes "[斯拉托斯]";
			mes "有时会发现蕴含大量纯粹魔力的不稳定宝石。";
			mes "我们称它们为以太宝石，对吧？";
			next;
			mes "[斯拉托斯]";
			mes "你可以把以太宝石的魔力转移到其他武器上，但当然存在风险。";
			mes "过程很精细，一不小心，啪！就会爆炸。";
			next;
			mes "[斯拉托斯]";
			mes "总之，使用以太宝石可以提升你所用武器的等级。";
			mes "性能会变得更好。我们称之为等级提升。";
			next;
			mes "[斯拉托斯]";
			mes "如果心爱的武器更上一层楼，你也会高兴吧？";
			mes "我们就是帮助它实现的人。虽然有点风险，啊哈哈哈。";
			close;
	}

OnInit:
	setunittitle(getnpcid(0), "<Grade Enhancer>");
	end;
}

paramk,34,184,4	script	Suribell#suribell	4_F_FRUIT,{
	mes "[苏莉贝尔]";
	mes "愿好运永远与你同在！";
	mes "欢迎来到帕拉市场的等级提升中心~";
	next;
	switch( select( "提升装备等级。", "交换 Etel 物品", "什么是等级提升？" )) {
		case 1:
			mes "[苏莉贝尔]";
			mes "想解放心爱装备的潜力吗？";
			mes "处理魔力的过程中也可能发生爆炸。";
			next;
			mes "[苏莉贝尔]";
			mes "不过，如果你想提升等级……！";
			mes "我苏莉贝尔会尽全力！";
			next;
			switch( select( "我还是要做！", "让我考虑一下。" ) ){
				case 1:
					mes "[苏莉贝尔]";
					mes "让我们手拉手相信奇迹！试着咬紧牙关！";
					close2;
					enchantgradeui();
					end;
				case 2:
					mes "[苏莉贝尔]";
					mes "好的！喝杯冷水吧！";
					close;
			}
		case 2:
			mes "[苏莉贝尔]";
			mes "提升等级需要以太宝石！";
			mes "把 Etel 粉末和宝石组合起来就行！冒险者用的 Etel 宝石就完成了！";
			mes "要组合宝石和 Etel 粉末吗？";
			close2;
			callshop "EnchantGradeExchange";
			end;
		case 3:
			mes "[苏莉贝尔]";
			mes "有时会发现蕴含大量纯粹魔力的不稳定宝石。";
			mes "我决定称这种宝石为以太宝石。";
			mes "谁？我就是苏莉贝尔！";
			next;
			mes "[苏莉贝尔]";
			mes "以太宝石的魔力有时会唤醒装备隐藏的潜力。";
			mes "因为能提升一个等级，所以我们称之为等级提升！";
			next;
			mes "[苏莉贝尔]";
			mes "冒险者可能拥有自己未知的潜力。";
			mes "操作失误有被破坏的风险，但请怀抱信念尝试吧！";
			close;
	}

OnInit:
	setunittitle(getnpcid(0), "<Grade Enhancer>");
	end;
}


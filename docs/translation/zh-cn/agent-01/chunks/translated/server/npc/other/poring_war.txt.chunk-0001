// Poring War Recruiter
//============================================================
prt_fild08,159,371,3	script	Poring War Recruiter#wop	909,{
	mes "[波利]";
	mes "!!!!!";
	mes "哇！人类，叮~！！";
	mes "快躲起来，躲起来，对吧~！";
	mes "他们用杰勒比结晶诱惑我们！别上当！";
	next;
	mes "[波利]";
	mes "哇！！";
	mes "叮，叮~你们怎么了……？";
	mes "嘿……嘿，人……人类……";
	mes "波利……";
	next;
	mes "[波利]";
	mes "我……我有一份有趣的工作……你感兴趣吗？";
	mes "我……我们波利需要很多勇敢的人类战士，叮~";
	next;
	switch(select("好，我加入你们！:那是什么？:忽略")) {
	case 1:
		if (Zeny > 499) {
			mes "[波利]";
			mes "哦，入场费是 500 Zeny，叮。";
			mes "玩得开心，叮。";
			delitem 7773,countitem(7773);
			set Zeny,Zeny-500;
			close2;
			warp "poring_w01",112,138;
			end;
		} else {
			mes "[波利]";
			mes "哦，入场费是 500 Zeny，叮。";
			mes "...........";
			mes "嘿，这就是生活，叮。我们也需要 Zeny，你知道的~！";
			close;
		}
	case 2:
		mes "[波利]";
		mes "那是因为我们叮叮社会发生了一点冲突……";
		mes "所以我们必须通过战斗解决问题……";
		mes "到了那里你就知道了！";
		close;
	case 3:
		mes "[波利]";
		mes "啊！人……人类真冷酷无情！！！";
		close;
	}
}

// Poring Vending Machine
//============================================================
poring_w01,100,97,3	script	Poring Vending Machine#w	909,{
	if (checkweight(714,3) == 0) {
		mes "- 你携带物品太多，无法使用贩卖机。-";
		close;
	}
	mes "这是贩卖机。你可以用波利硬币购买。";
	next;
	if(select("购买。:阅读商品说明。") == 1) {
		mes "购买物品需要波利硬币。";
		mes "不能使用 Zeny。";
		mes "物品名称 - 价格 波利硬币（P.Co）";
		next;
		switch(select("奇妙奖牌 - 4 P.Co:部落联盟 - 20 P.Co:波利盒 - 30 P.Co:下一页")) {
		case 1:
			callsub S_PoringVending,7515,4;
		case 2:
			callsub S_PoringVending,658,20;
		case 3:
			callsub S_PoringVending,12109,30;
		case 4:
			mes "这是特殊物品。";
			mes "物品名称 - 波利硬币（P.Co）";
			next;
			switch(select("野玫瑰 - 15 P.Co:卓柏卡布拉 - 20 P.Co:伊根·塞尼亚 - 20 P.Co:收藏品")) {
			case 1:
				callsub S_PoringVending,12300,15;
			case 2:
				callsub S_PoringVending,12301,20;
			case 3:
				callsub S_PoringVending,12302,20;
			case 4:
				mes "包含初心者在内的一转职业角色模型终于开售！";
				mes "除初心者外，其他模型都是 ^4d4dff角色绑定物品^000000。";
				mes "购买前请注意~";
				mes "物品名称 - 波利硬币（P.Co）";
				next;
				switch(select("初心者模型 - 50 P.Co:剑士模型 - 100 P.Co:盗贼模型 - 100 P.Co:商人模型 - 100 P.Co:服事者模型 - 100 P.Co:法师模型 - 100 P.Co:弓箭手模型 - 100 P.Co:随机抽取 - 50 P.Co:取消")) {
				case 1:
					callsub S_PoringVending,2765,50;
				case 2:
					callsub S_PoringVending,2766,100;
				case 3:
					callsub S_PoringVending,2770,100;
				case 4:
					callsub S_PoringVending,2771,100;
				case 5:
					callsub S_PoringVending,2767,100;
				case 6:
					callsub S_PoringVending,2768,100;
				case 7:
					callsub S_PoringVending,2769,100;
				case 8:
					mes "你选择了随机抽取。";
					mes "将从 7 种模型中随机选择 1 种。";
					next;
					if(select("抽取:取消") == 1) {
						if (countitem(7539) >= 50) {
							mes "投入波利硬币并拉下拉杆。";
							mes "咔哒~物品伴随轰鸣声从波利嘴里出来了。";
							mes "会是什么呢？";
							next;
							switch(rand(1,17)) {
							case 5: set .@Random_Figure,2766; break; // Swordman_Figure
							case 6: set .@Random_Figure,2767; break; // Acolyte_Figure
							case 8: set .@Random_Figure,2770; break; // Thief_Figure
							case 11: set .@Random_Figure,2771; break; // Merchant_Figure
							case 13: set .@Random_Figure,2769; break; // Archer_Figure
							case 14: set .@Random_Figure,2768; break; // Mage_Figure
							default: set .@Random_Figure,2765; break; // Novice_Figure
							}
							mes "很棒的" + getitemname(.@Random_Figure) + "。";
							delitem 7539,50; // Poring_Coin
							getitem .@Random_Figure,1;
							close;
						} else {
							mes "硬币不足。";
							close;
						}
					}
					mes "["+strcharinfo(0)+"]";
					mes "... 也许下次吧……";
					close;
				case 9:
					mes "["+strcharinfo(0)+"]";
					mes "... 也许下次吧……";
					close;
				}
			}
		}
	}
	mes "出售物品列表";
	mes "====================";
	mes "[奇妙奖牌]";
	mes "：由仅在胡格尔产出的特殊金属制成的奖牌。";
	mes " ";
	mes "[部落联盟]";
	mes "：描绘部落强大联盟的雕像。人们相信观看它能增进部落间的关系。";
	mes " ";
	mes "[波利盒]";
	mes "：用波利图案包装纸包裹的盒子，里面似乎有东西。";
	mes " ";
	mes "[野玫瑰]";
	mes "：你的朋友野玫瑰会来帮助你。";
	mes " ";
	mes "[多佩尔先生]";
	mes "：年轻的二重身会来帮助你。";
	mes " ";
	mes "[伊根·塞尼亚]";
	mes "：来自生体实验研究所的美丽少女伊根·塞尼亚会来帮助你。";
	mes " ";
	mes "[初心者模型]";
	mes "：精致的初心者模型，可作为‘^4d4dff饰品^000000’装备。";
	mes "HP + 70，初心者装备时额外增加 HP + 30。";
	mes " ";
	mes "[剑士模型]";
	mes "：精致的剑士模型，可作为‘^4d4dff饰品^000000’装备。";
	mes "VIT + 1，剑士系职业装备时额外增加 DEF + 2。";
	mes " ";
	mes "[商人模型]";
	mes "：精致的商人模型，可作为‘^4d4dff饰品^000000’装备。";
	mes "STR + 1，商人系职业装备时额外增加 CRI + 5。";
	mes " ";
	mes "[盗贼模型]";
	mes "：精致的盗贼模型，可作为‘^4d4dff饰品^000000’装备。";
	mes "AGI + 1，盗贼系职业装备时额外增加 ASPD + 3%。";
	mes " ";
	mes "[法师模型]";
	mes "：精致的法师模型，可作为‘^4d4dff饰品^000000’装备。";
	mes "INT + 1，法师系职业装备时额外增加 SP 恢复量 5%。";
	mes " ";
	mes "[服事者模型]";
	mes "：精致的服事者模型，可作为‘^4d4dff饰品^000000’装备。";
	mes "INT + 1，服事者系职业装备时额外增加 SP + 50。";
	mes " ";
	mes "[弓箭手模型]";
	mes "：精致的弓箭手模型，可作为‘^4d4dff饰品^000000’装备。";
	mes "DEX + 1，弓箭手系职业装备时额外增加 ATK + 10。";
	close;
}

S_PoringVending:
	if (countitem(7539) >= getarg(1)) {
		mes "咔哒~物品伴随轰鸣声从波利嘴里出来了。";
		delitem 7539,getarg(1); // Poring_Coin
		getitem getarg(0),1;
	} else {
		mes "硬币不足。";
	}
	close;
}

// 信息
//============================================================
poring_w01,96,97,3	script	Sweet Devi#wop	738,{
	if (MaxWeight-Weight < 2000 || checkweight(1201,1) == 0) {
		mes "- 请稍等！！ -";
		mes "- 你目前携带的物品 -";
		mes "- 太多了。 -";
		mes "- 请减轻负重后 -";
		mes "- 再试一次。 -";
		close;
	}
	mes "[恶魔波利]";
	mes "哦，又一位人类勇士！";
	mes "最近怎么有这么多想参加波利战争的人类？";
	next;
	mes "[恶魔波利]";
	mes "不过，只要我能从中赚钱就行～";
	mes "好吧，勇士们！哈哈哈，我早就想这样喊了～！！";
	next;
	mes "[恶魔波利]";
	mes "勇敢的战士，你准备好参加天使波利与恶魔波利的神圣战斗了吗？";
	next;
	mes "[恶魔波利]";
	mes "嘿嘿，我突然有点害羞了。";
	mes "总之，人类，你想参加我们的波利战争吗？";
	next;
	switch(select("我有资格参加吗？:如何参加战争？:取消:请让我离开这里！")) {
	case 1:
		mes "[恶魔波利]";
		mes "我们不歧视种族！只要愿意战斗，任何人都能参加。";
		mes "不过奇怪的是，曾经是我们最大敌人的人类，现在却成了参赛者。";
		next;
		mes "[恶魔波利]";
		mes "如果你真的想参加战争，队伍招募员就在那边。";
		mes "至于要为哪支队伍战斗，完全由你决定～";
		close;
	case 2:
		mes "[恶魔波利]";
		mes "很简单。你看到那间队伍招募室了吗？";
		mes "每队由 5 人组成，凑齐 5 名成员后战斗就会开始。";
		mes "杀死敌方队伍的波利即可获胜。";
		next;
		mes "[恶魔波利]";
		mes "也就是说，战斗总共需要 10 名成员。";
		next;
		mes "[恶魔波利]";
		mes "10 名成员全部到齐后，参赛者可以选择队伍。";
		mes "每队必须有 5 名属于同一队伍的成员。";
		next;
		mes "[恶魔波利]";
		mes "最后，一半成员加入天使波利队，另一半加入恶魔波利队。";
		next;
		mes "[恶魔波利]";
		mes "如果你是天使波利队成员，目标就是在敌方基地杀死恶魔波利，反之亦然。";
		next;
		mes "[恶魔波利]";
		mes "每队都要尝试杀死敌方基地的两只波利。杀死其中一只后，必须在限定时间内杀死另一只，否则先被杀死的波利会复活。";
		next;
		mes "[恶魔波利]";
		mes "这有点像夺旗游戏，只是把旗子换成了波利。明白了吗？";
		mes "还要确认清楚每个人属于哪支队伍。";
		close;
	case 3:
		mes "[" + strcharinfo(0) + "]";
		mes "嗯，我明白了。";
		close;
	case 4:
		mes "[恶魔波利]";
		mes "哦，好的。我可以帮忙。";
		mes "我会把你送回保存点。";
		close2;
		if (WoP_SaveMap$ != "") {
			savepoint WoP_SaveMap$,WoP_SaveMap_X,WoP_SaveMap_Y,1,1;
			set WoP_SaveMap$,"";
			set WoP_SaveMap_X,0;
			set WoP_SaveMap_Y,0;
		}
		warp getsavepoint(0), getsavepoint(1), getsavepoint(2);
		end;
	}


OnPCLogoutEvent:
	getmapxy .@map$,.@x,.@y;
	if (.@map$ == "poring_w02") {
		if (WoP_SaveMap$ != "") {
			savepoint WoP_SaveMap$,WoP_SaveMap_X,WoP_SaveMap_Y,1,1;
			set WoP_SaveMap$,"";
			set WoP_SaveMap_X,0;
			set WoP_SaveMap_Y,0;
		}
		delitem 7773,countitem(7773);
		set wop_team,0;
	}
	end;

OnPCDieEvent:
	getmapxy .@map$,.@x,.@y;
	if (.@map$ == "poring_w02" && wop_team) {
		if (getsavepoint(0) != "poring_w02" && WoP_SaveMap$ == "") {
			set WoP_SaveMap$,getsavepoint(0);
			set WoP_SaveMap_X,getsavepoint(1);
			set WoP_SaveMap_Y,getsavepoint(2);
		}
		if (wop_team == 1) {
			savepoint "poring_w02",rand(44,51),rand(76,87);
		}
		if (wop_team == 2) {
			savepoint "poring_w02",rand(146,153),rand(76,87);
		}
	}
	end;

OnPCKillEvent:
	getmapxy .@map$,.@x,.@y;
	if (.@map$ == "poring_w02" && wop_team) {
		getnameditem 7773,rid2name(killedrid);
	}
	end;

OnInit:
	removemapflag "poring_w02",mf_partylock;
	removemapflag "poring_w02",mf_pvp;
	removemapflag "poring_w02",mf_pvp_noguild;
	removemapflag "poring_w02",mf_pvp_nocalcrank;
	set $@wop_teamcount,0;
	set $@wop_deadcount_a,0;
	set $@wop_deadcount_d,0;
	set $@wop_team_a,0;
	set $@wop_team_d,0;
	set $@wop_doorcount_a,0;
	set $@wop_doorcount_d,0;
	end;
}

// 波利战争报名
//============================================================
poring_w01,91,97,3	script	Poring#wop_door_all	1002,{
	end;
	
OnInit:
	waitingroom "[招募 10 名战斗参与者]",11,"Poring#wop_door_all::OnStartArena",10,500,9;
	enablewaitingroomevent;
	end;

OnStartArena:
	warpwaitingpc "poring_w01",101,70;
	donpcevent "#wop_warp_rtry::OnReady";
	disablewaitingroomevent;
	end;

OnEnable:
	enablewaitingroomevent;
	end;

OnDisable:
	disablewaitingroomevent;
	end;
}

poring_w01,91,68,5	script	Poring#wop_door_a	1002,{
	end;

OnInit:
	waitingroom "[天使波利队招募员]",6,"Poring#wop_door_a::OnStartArena",5,0,9;
	enablewaitingroomevent;
	end;

OnStartArena:
	warpwaitingpc "poring_w02",26,175;
	disablewaitingroomevent;
	if ($@wop_teamcount == 0) {
		set $@wop_teamcount,1;
		donpcevent "Poring#wop_door_d::OnDevilingStart";
		donpcevent "#wop_warp_rtry::OnStop";
	}
	else if ($@wop_teamcount == 1) {
		donpcevent "#wop_master::OnStart";
		donpcevent "Poring#wop_door_d::OnStop";
		stopnpctimer;
	}
	end;

OnEnable:
	enablewaitingroomevent;
	end;

OnDisable:
	disablewaitingroomevent;
	end;

OnAngelingStart:
	initnpctimer;
	end;

OnStop:
	stopnpctimer;
	end;

OnTimer1000:
	mapannounce "poring_w01","史上最伟大的战斗：恶魔波利队招募结束，叮！",0,0xf08080;
	end;

OnTimer4000:
	mapannounce "poring_w01","加入引以为傲、长着天使翅膀的天使波利队吧！！",0,0xf08080;
	end;

OnTimer8000:
	mapannounce "poring_w01","还有 1 分钟可以加入天使波利队。若未准备好，战斗将在 1 分钟后取消！！",0,0xf08080;
	donpcevent "#wop_master::OnAngelingWarn";
	end;

OnTimer13000:
	mapannounce "poring_w01","现在正是加入伟大天使波利队的时刻，叮！",0,0xf08080;
	end;

OnTimer20000:
	mapannounce "poring_w01","这是波利们的荣耀之战！叮！加入天使波利队吧！！",0,0xf08080;
	end;

OnTimer30000:
	mapannounce "poring_w01","时间不多了，叮。别让恶魔波利污染你们！",0,0xf08080;
	end;

OnTimer40000:
	mapannounce "poring_w01","来吧！加入我们！",0,0xf08080;
	end;

OnTimer50000:
	mapannounce "poring_w01","真遗憾！真不敢相信勇敢的战士们竟然缺席了！",0,0xf08080;
	end;

OnTimer55000:
	mapannounce "poring_w01","恶魔波利：你们不能让我们一直等下去！！我们要取消战斗了，叮！",0,0x33FF66;
	end;

OnTimer55100:
	donpcevent "Poring#wop_door_a::OnDisable";
	donpcevent "Poring#wop_door_d::OnDisable";
	donpcevent "Poring#wop_door_all::OnDisable";
	set $@wop_teamcount,0;
	donpcevent "#wop_master::OnAngelingEnd";
	donpcevent "#wop_warp_rtry::OnEnable";
	end;

OnTimer58000:
	mapannounce "poring_w01","……我们无能为力了，叮……为下一场比赛加油吧，叮。",0,0xf08080;
	donpcevent "#wop_master::OnReset";
	stopnpctimer;
	end;
}

poring_w01,112,68,3	script	Poring#wop_door_d	1002,{
	end;

OnInit:
	waitingroom "[恶魔波利队招募员]",6,"Poring#wop_door_d::OnStartArena",5,0,9;
	enablewaitingroomevent;
	end;

OnStartArena:
	warpwaitingpc "poring_w02",170,175;
	disablewaitingroomevent;
	if ($@wop_teamcount == 0) {
		set $@wop_teamcount,1;
		donpcevent "Poring#wop_door_a::OnAngelingStart";
		donpcevent "#wop_warp_rtry::OnStop";
	}
	else if ($@wop_teamcount == 1) {
		donpcevent "#wop_master::OnStart";
		donpcevent "Poring#wop_door_a::OnStop";
		stopnpctimer;
	}
	end;

OnEnable:
	enablewaitingroomevent;
	end;

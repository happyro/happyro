			mes "哦！如果你看到高大的珍珠色大门，听到门后低沉的轰鸣声，那就说明你在魔法方面失败了。哈哈哈哈哈哈~";
			close2;
			warp "job_wiz",57,154;
			end;
		}
		mes "[劳雷尔]";
		mes "*咳咳* 那我来说明。";
		mes "测试可能很难，但照我说的做就不会有问题。";
		next;
		mes "[劳雷尔]";
		mes "最终测试分为 3 个部分。";
		mes "顺序是……*喷嚏*……水之房间、土之房间，然后是火之房间。每个房间都有对应属性的怪物。";
		next;
		mes "[劳雷尔]";
		mes "进入后就会看到怪物。";
		mes "使用合适的法术对付它们，就不会太难。哈哈哈哈哈哈~";
		next;
		mes "[劳雷尔]";
		mes "在规定时间内，如果你击败所有怪物……";
		mes "你会被送往下一个房间。";
		next;
		mes "[劳雷尔]";
		mes "之后测试就结束了。";
		mes "届时你会成为掌控高级魔法力量的巫师！再也回不到迄今为止的安逸生活。";
		next;
		mes "[劳雷尔]";
		mes "哈哈哈哈~你看起来很害怕。现在放弃还不晚。";
		mes "*咳咳* 你可以放弃并回城！忘掉高级魔法，过普通生活。你觉得呢？";
		next;
		if (select("继续测试。:我太害怕了，想退出。") == 1) {
			percentheal 100,100;
			mes "[劳雷尔]";
			mes "这次死了别哭着回来。哈哈哈哈哈哈哈~ *咳咳*";
			mes "如你所愿，开始最终测试！";
			close2;
			warp "job_wiz",57,154;
			end;
		}
		mes "[劳雷尔]";
		mes "这话从你嘴里说出来真是明智。那更适合你。哈哈哈哈哈哈~";
		mes "回去过安静和平的生活吧！";
		close2;
		warp "geffen",120,110;
		end;
	}
	else if (WIZ_Q == 7) {
		mes "[劳雷尔]";
		mes "在我看来，你不该再来找我。";
		mes "不过既然你如此执着，我就让你再考一次。哈哈哈哈~";
		next;
		mes "[劳雷尔]";
		mes "去吧！成为你真正想成为的巫师。";
		mes "小心！高级魔法总会追着你……";
		close;
	}
}

job_wiz,50,165,4	script	Arena Assistant	700,{
	mes "[竞技场助手]";
	mes "欢迎来到巫师转职竞技场。";
	mes "如果想参加最终测试，请进入等候室。";
	next;
	mes "[竞技场助手]";
	mes "如果有人正在测试，请等待。";
	mes "所有测试状态都会广播，前一位测试者完成后测试就会开始。";
	next;
	mes "[竞技场助手]";
	mes "每人测试大约需要 5 到 10 分钟。";
	mes "想离开竞技场，随时可以登出。";
	close;

OnInit:
	waitingroom "Waiting Room",20,"Arena Assistant::OnStartArena",1;
	enablewaitingroomevent;
	end;

OnStartArena:
	killmonsterall "job_wiz";
	warpwaitingpc "job_wiz",114,169;
	donpcevent "Room of Water::OnEnable";
	disablewaitingroomevent;
	end;

OnStart:
	enablewaitingroomevent;
	end;
}

// Water Room (Test 2 part 1)
//==========================================================
job_wiz,1,1,1	script	Room of Water	66,{
OnInit:
	disablenpc "Room of Water";
	end;

OnEnable:
	enablenpc "Room of Water";
	if (!checkre(0)) {
		set .MyMobs,8;
		monster "job_wiz",129,170,"Obeaune",1044,1,"Room of Water::OnMyMobDead";
	}
	else
		set .MyMobs,7;
	monster "job_wiz",109,174,"Phen",1158,1,"Room of Water::OnMyMobDead";
	monster "job_wiz",118,174,"Shellfish",1074,1,"Room of Water::OnMyMobDead";
	monster "job_wiz",109,165,"Vadon",1066,1,"Room of Water::OnMyMobDead";
	monster "job_wiz",118,165,"Cornutus",1067,1,"Room of Water::OnMyMobDead";
	monster "job_wiz",101,157,"Marina",1141,1,"Room of Water::OnMyMobDead";
	monster "job_wiz",126,157,"Marin",1242,1,"Room of Water::OnMyMobDead";
	monster "job_wiz",98,170,"Magnolia",1138,1,"Room of Water::OnMyMobDead";
	initnpctimer;
	end;

OnDisable:
	killmonsterall "job_wiz";
	disablenpc "Room of Water";
	end;

OnMyMobDead:
	set .MyMobs,.MyMobs-1;
	if (.MyMobs < 1) {
		set WIZ_Q2,WIZ_Q2+1;
		mapannounce "job_wiz",strcharinfo(0)+"已成功消灭魔物。",bc_map;
		donpcevent "Room of Water#Door::OnEnable";
		stopnpctimer;
	}
	end;

OnTimer1000:
	mapannounce "job_wiz","水之房间；转职考试现在开始。",bc_map;
	end;

OnTimer2000:
	mapannounce "job_wiz","限时 3 分钟。考试现在开始。",bc_map;
	end;

OnTimer3000:
	mapannounce "job_wiz","请在限时内消灭所有魔物。",bc_map;
	end;

OnTimer33000:
	mapannounce "job_wiz","剩余 2 分 30 秒。",bc_map;
	end;

OnTimer63000:
	mapannounce "job_wiz","剩余 2 分钟。",bc_map;
	end;
	// 保持与源切片的行结构一致。

OnTimer93000:
	mapannounce "job_wiz","剩余 1 分 30 秒。",bc_map;
	end;

OnTimer123000:
	mapannounce "job_wiz","剩余 1 分钟。",bc_map;
	end;

OnTimer153000:
	mapannounce "job_wiz","剩余 30 秒。",bc_map;
	end;

OnTimer173000:
	mapannounce "job_wiz","剩余 10 秒。",bc_map;
	end;

OnTimer183000:
	mapannounce "job_wiz","时间到。",bc_map;
	donpcevent "Room of Water::OnDisable";
	end;

OnTimer184000:
	enablenpc "Room of Water#Failed";
	end;

OnTimer185000:
	mapannounce "job_wiz","下一位考生，请进入。",bc_map;
	end;

OnTimer186000:
	disablenpc "Room of Water#Failed";
	donpcevent "Room of Water::OnDisable";
	donpcevent "Arena Assistant::OnStart";
	end;
}


			mes "[古德曼]";
			mes "完成任务后回来";
			mes "和我谈谈。好了，";
			mes "祝你好运~";
			mes "";
			BLACK_SK2 = 1;
			close;
			}
			mes "[古德曼]";
		mes "我明白了。忙于其他事情";
		mes "也不错，";
		mes "但要记住时间是一种商品，";
		mes "应该总是用来做最有价值的事。";
		mes "明白了吗？";
		mes "";
		close;
		}
		if (BLACK_SK2 == 1) {
	if (MaxWeight - Weight >= 5000) {
	mes "[古德曼]";

jupe_area1,50,49,0	script	#hole#1-4	844,{
	cutin "4",2;
	if ($@JupreArea1InUse == 1) {
		mes "^3355FF这似乎是";
		mes "某种装置，";
		mes "可以让你";
		mes "通过到另一侧。";
		mes "这里有一个插槽，";
		mes "可能需要插入";
		mes "某种物品……^000000";
		close2;
		cutin "4",255;
		end;
	}
	else if (countitem(7356) > 0 || countitem(7359) > 0 || countitem(7357) > 0 || countitem(7358) > 0) {
		mes "^3355FF这似乎是";
		mes "某种装置，";
		mes "可以让你";
		mes "通过到另一侧。";
		mes "这里有一个插槽，";
		mes "可能需要插入";
		mes "某种物品……^000000";
		next;
		switch(select("插入徽章碎片。:取消。")) {
		case 1:
			if (countitem(7359) > 0) {
				mes "^3355FF你取出徽章碎片，";
				mes "将它放入插槽，";
				mes "它刚好完美契合。^000000";
				specialeffect EF_TOPRANK;
				cutin "4-1",2;
				next;
				if ($@JupreArea1InUse == 1) {
				mes "^3355FF什么也没发生。";
					mes "也许警报或其他安全措施";
					mes "被启动，防止徽章碎片";
					mes "启动这个传送装置。";
					mes "你取回了徽章碎片。^000000";
					close2;
					cutin "4-1",255;
					end;
					}
					else {
					mes "^3355FF插槽旋转，徽章碎片";
				mes "像转动钥匙一样移动。";
				mes "你感到轻微震动，另一侧的";
					mes "传送门被激活。";
					mes "然后你取回了徽章碎片。^000000";
					initnpctimer;
					donpcevent "Warp#1-4::OnEnable";
					donpcevent "Red Alarm#1-4::OnEnable";
					disablenpc "#hole#1-4";
					close2;
					cutin "4-1",255;
					end;
					}
					}
					else {
					mes "^3355FF遗憾的是，你没有携带";
					mes "任何可能适配插槽并";
				mes "启动这个机械装置的物品。^000000";
			close2;
			cutin "4",255;
				end;
				}
				break;
				case 2:
				mes "[" + strcharinfo(0) + "]";
				mes "嗯……";
				mes "我有没有什么东西";
				mes "能让这台";
			mes "奇怪的机器运作？";
			close2;
		cutin "4",255;
			end;
			}
			}
			else {
			mes "^3355FF这似乎是";
			mes "某种装置，";
			mes "可以让你";
			mes "通过到另一侧。";
		mes "这里有一个插槽，";
	mes "可能需要插入";
	mes "某种物品……^000000";
		close2;
		cutin "4",255;
		end;
		}
		end;
		
		OnStop_Timer:
		stopnpctimer;
		end;
		
	OnTimer5000:
	stopnpctimer;
enablenpc "#hole#1-4";
disablenpc "Red Alarm#1-4";
	end;
	}


		mes "我让 R 先生在我们的魔法防护系统下";
		mes "独处了一会儿。不过，我好像搞砸了。";
		next;
		mes "[Lin]";
		mes "我对那个历史学家有点恼火，";
		mes "他也有点害怕。现在";
		mes "他躲在梦罗克旅馆的某处，";
		mes "我想他不愿见任何人。";
		next;
		mes "[Lin]";
		mes "我想让你找到梦罗克的";
		mes "历史学家，调查撒旦梦罗克、";
		mes "梦罗克和塔纳托斯塔的情报。";
		mes "我们需要知道它们如何";
		mes "与失踪儿童有关。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "既然他还没见过我，";
		mes "也许会和我说话。好，我去做。";
		next;
		mes "[Lin]";
		mes "太好了，非常感谢。";
		mes "那么回头见。记住，";
		mes "梦罗克旅馆，好吗？";
		set mao_request,116;
		close2;
		cutin "mocseal_rin01.bmp",255;
		donpcevent "Lin#stairs::OnInit";
		end;
	}
	else if(mao_request == 117)
	{
		cutin "mocseal_rin01.bmp",2;
		mes "[" + strcharinfo(0) + "]";
		mes "林、林……？";
		mes "你在吗？";
		donpcevent "Lin#stairs::OnEnter";
		next;
		mes "[Lin]";
		mes "是的，我在。";
		mes "那么，你能";
		mes "找到那位历史学家了吗？";
		mes "你具体了解到什么？";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "我只能和历史学家的助手";
		mes "交谈。让我想想……";
		mes "我了解到这座城市名称的";
		mes "由来……";
		next;
		mes "["+ strcharinfo(0) +"]";
		mes "撒旦梦罗克曾利用塔纳托斯塔";
		mes "将自己的怪物召唤到我们的";
		mes "世界。现在它正在重建，";
		mes "尽管里面住着";
		mes "看起来像天使的恶魔……";
		next;
		mes "[Lin]";
		mes "咦，真奇怪。";
		mes "我听说那些其实是真正的天使，";
		mes "因为某种原因";
		mes "正在守护塔。嗯，你还了解到什么？";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "如果撒旦梦罗克确实存在，";
		mes "只要通过献祭儿童打破封印，";
		mes "他也许就能回到我们的世界……";
		next;
		mes "[Lin]";
		mes "那……听起来很糟糕，";
		mes "尤其是最近梦罗克";
		mes "有那么多孩子失踪。";
		mes "我们下一步怎么办？";
		mes "我想我们该和 R 先生谈谈。";
		set mao_request,118;
		next;
		mes "[Lin]";
		mes "按照现在的情况，";
		mes "他可能会让我们调查塔纳托斯塔。";
		mes "先看看他想要什么。啊，别把我们在这里讨论的";
		mes "任何事说出去。";
		close2;
		cutin "mocseal_rin01.bmp",255;
		donpcevent "Lin#stairs::OnInit";
		end;
	}
	else if(mao_request == 121 && thana_quest > 1)
	{
		cutin "mocseal_rin01.bmp",2;
		mes "[Lin]";
		mes "先向我报告。";
		mes "你有没有了解到";
		mes "关于塔纳托斯塔的事？";
		donpcevent "Lin#stairs::OnEnter";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "我找到了一些关于撒旦梦罗克的";
		mes "旧日志记录。";
		mes "它们基本确认";
		mes "撒旦梦罗克确实存在，";
		mes "并被封印在梦罗克城堡下。";
		next;
		mes "["+ strcharinfo(0) +"]";
		mes "雷根贝勒公司";
		mes "也负责塔的重建，";
		mes "他们最终计划修复";
		mes "塔的十二层。";
		next;
		mes "[Lin]";
		mes "他们为什么想做";
		mes "那种疯狂的事？";
		mes "如果 R 先生真的在阻止";
		mes "撒旦梦罗克回归，";
		mes "那么攻击他的人一定想";
		mes "复活撒旦梦罗克……";
		next;
		mes "[Lin]";
		mes "但如果他在撒谎，";
		mes "试图把撒旦梦罗克带到我们的世界，";
		mes "那么他就是蒲公英组织";
		mes "通缉的对象……也就是说，";
		mes "他可能是基德任务的目标。";
		next;
		mes "[Lin]";
		mes "糟糕！这可能很严重。";
		mes "我需要把这件事告诉";
		mes "指挥官瓦尔德斯。";
		mes "在我去报告时，";
		mes "你去确认 R 先生的情况。";
		next;
		mes "[Lin]";
		mes "瓦尔德斯为什么会接受";
		mes "这两项任务？！";
		mes "最坏的情况下，";
		mes "可能要由我们阻止";
		mes "撒旦梦罗克";
		mes "回到这个世界……";
		set mao_request,122;
		close2;
		cutin "mocseal_rin01.bmp",255;
		donpcevent "Lin#stairs::OnInit";
		end;
	}
}

moc_fild10,281,148,1	script	Upturned Spot#water	111,{

	if (mao_request == 14)
	{
		cutin "mocseal_ice01.bmp",2;
		mes "^3355FF你发现一个闪闪发光的";
		mes "看起来像";
		mes "飞溅水波的徽记。^000000";
		if(countitem(996))
		{
			mes "^3355FF你拿出一块粗糙的风";
			mes "抵消徽记的力量。^000000";
			next;
			mes "^3355FF徽记回应着";
			mes "狂风，两个物体";
			mes "剧烈发光，";
			mes "彼此的力量发生冲突。^000000";
			specialeffect EF_BEGINSPELL2;
			specialeffect EF_BEGINSPELL4;
			next;
			cutin "mocseal_ice02.bmp",2;
			mes "^3355FF突然，徽记喷出";
			mes "一些水在半空中";
			mes "迅速蒸发：看来";
			mes "风元素中和了";
			mes "徽记的水元素。^000000";
			specialeffect EF_SPHERE;
			delitem 996,1;
			set mao_request,15;
			next;
			mes "[" + strcharinfo(0) + "]";
			mes "好……";
			mes "现在该寻找";
			mes "隐藏在梦罗克北部原野的";
			mes "徽记了。";
			close2;
		}
		else
		{
			mes "^3355FF你可能需要粗糙的风";
			mes "狂风来抵消它的力量。^000000";
			close2;
		}
	}
	else if(mao_request > 14 && mao_request < 100)
	{
		mes "^3355FF你发现一个闪闪发光的";
		mes "看起来像";
		mes "飞溅水波的徽记。^000000";
		mes "^3355FF不过，你没有感觉到";
		mes "有什么奇怪之处。^000000";
		cutin "mocseal_ice02.bmp",2;
		close2;
	}
	else if(mao_request == 113)
	{
		mes "^3355FF你发现一个闪闪发光的";
		mes "看起来像";
		mes "飞溅水波的徽记。^000000";
		cutin "mocseal_ice02.bmp",2;
		if (countitem(995))
		{
			mes "^3355FF你拿出神秘冰冻";
			mes "增强徽记的力量。^000000";
			next;
			cutin "mocseal_ice01.bmp",2;
			mes "^3355FF徽记产生共鸣";
			mes "和神秘冰冻结合，";
			mes "空气突然变冷，";
			mes "绿洲中的波浪";
			mes "也翻涌起来。^000000";
			specialeffect EF_BEGINSPELL2;
			delitem 995,1;
			set mao_request,114;
			next;
			mes "[" + strcharinfo(0) + "]";
			mes "好……";
			mes "现在该寻找";
			mes "隐藏在梦罗克北部原野的徽记。";
			close2;
		}
		else
		{
			mes "^3355FF你可能需要神秘冰冻";
			mes "神秘冰冻来增强力量。";
			close2;
		}
	}
	else if(mao_request > 112)
	{
		mes "^3355FF你发现一个闪闪发光的";
		mes "看起来像";
		mes "飞溅水波的徽记。^000000";
		cutin "mocseal_ice01.bmp",2;
		close2;
	}
	cutin "mocseal_ice01.bmp",255;
	cutin "mocseal_ice02.bmp",255;
	end;
}

moc_fild19,21,33,1	script	Unturned Spot#wind	111,{

	if (mao_request == 10)
	{
		cutin "mocseal_wind01.bmp",2;
		mes "^3355FF你发现一个闪亮的徽记";
		mes "看起来像风的象征。";
		mes "靠近它时，能感到强风";
		mes "吹过皮肤。^000000";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "这一定就是";
		mes "莱扬·穆尔感兴趣的东西。";
		mes "好，我最好去告诉基德";
		mes "我在这里发现的事。";
		set mao_request,11;
		close2;
	}
	else if(mao_request == 11)
	{
		cutin "mocseal_wind01.bmp",2;
		mes "^3355FF你发现一个闪亮的徽记";
		mes "看起来像风的象征。";
		mes "靠近它时，能感到强风";
		mes "吹过皮肤。^000000";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "太好了，现在我找到了";
		mes "这件事，我真的得告诉";
		mes "基德。希望他也发现了";
		mes "类似的东西。";
		close2;
	}
	else if(mao_request == 12)
	{
		if(countitem(997))
		{
			cutin "mocseal_wind01.bmp",2;
			mes "^3355FF你发现一个闪亮的徽记";
			mes "看起来像风的象征。";
			mes "靠近它时，能感到强风";
			mes "吹过皮肤。^000000";
			next;
			mes "[" + strcharinfo(0) + "]";
			mes "好，大地的力量";
			mes "抵消风。我要拿出这个";
			mes "大地之力……咦？";
			next;
			mes "^3355FF风元素徽记";
			mes "迅速回应";
			mes "大地之力。^000000";
			specialeffect EF_BEGINSPELL4;
			specialeffect EF_BEGINSPELL5;
			next;
			cutin "mocseal_wind02.bmp",2;
			mes "^3355FF风与大地的力量";
			mes "彼此中和，";
			mes "使这片区域的风元素力量";
			mes "稳定下来。^000000";
			specialeffect EF_SPHERE;
			delitem 997,1;
			set mao_request,13;
			next;
			mes "[" + strcharinfo(0) + "]";
			mes "太好了，处理完这个徽记后，";
			mes "我需要寻找下一个。让我看看，";
			mes "我得找";
			mes "基德已经找到的南方。";
			close2;
		}
		else
		{
			cutin "mocseal_wind01.bmp",2;
			mes "^3355FF你发现一个闪亮的徽记";
			mes "看起来像风的象征。";
			mes "靠近它时，能感到强风";
			mes "吹过皮肤。^000000";
			next;
			mes "[" + strcharinfo(0) + "]";
			mes "风，风，风……";
			mes "我该用什么抵消";
			mes "风属性？应该是……";
			next;
			switch( select( "Fire","Ice","Wind","Earth" ) )
			{
				case 1:
					mes "[" + strcharinfo(0) + "]";
					mes "火……？不，那是……";
					mes "风和火似乎";
					mes "是一对，对吧？";
					close2;
					break;

				case 2:
					mes "[" + strcharinfo(0) + "]";
					mes "冰……？不……";
					mes "风的力量，闪电的力量，";
					mes "胜过";
					mes "冰与水的力量……";
					close2;
					break;

				case 3:
					mes "[" + strcharinfo(0) + "]";
					mes "我明白了……！";
					mes "我要用风";
					mes "对抗风！不……";
					mes "别胡思乱想。";
					close2;
					break;

				case 4:
					mes "[" + strcharinfo(0) + "]";
					mes "大地……？";
					mes "就是这个！我需要";
					mes "大地之力";
					mes "来对付这个风徽记！";
					close2;
					break;
			}
		}
	}
	else if (mao_request > 12 && mao_request < 100)
	{
		mes "^3355FF你发现一个闪亮的徽记";
		mes "看起来像风的象征。";
		mes "不过，你觉得它并不";
		mes "特别值得调查。^000000";
		cutin "mocseal_wind02.bmp",2;
		close2;
	}
	else if(mao_request == 110)
	{
		cutin "mocseal_wind02.bmp",2;
		mes "^3355FF你发现一个闪亮的徽记";
		mes "看起来像风的象征。";
		mes "不过，它周围的空气";
		mes "流动似乎很微弱。^000000";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "这一定就是我要找的东西。";
		mes "看起来是风元素的神器，但这里的风";
		mes "没有应有的强度。我可能需要";
		mes "带一块 ^4D4DFF狂风^000000 来这里……";
		set mao_request,111;
		close2;
	}
	else if(mao_request == 111)
	{
		if (countitem(996))
		{
			cutin "mocseal_wind02.bmp",2;
			mes "[" + strcharinfo(0) + "]";
			mes "让我看看……";
			mes "希望这个";
			mes "狂风应该可以。";
			mes "哇，嗯……";
			mes "有事情发生了……";
			next;
			mes "^3355FF元素徽记";
			mes "迅速回应";
			mes "狂风，使徽记更加明亮，";
			mes "风也吹得更加强烈。^000000";
			specialeffect EF_BEGINSPELL4;
			delitem 996,1;
			set mao_request,112;
			next;
			cutin "mocseal_wind01.bmp",2;
			mes "[" + strcharinfo(0) + "]";
			mes "好，我想就这样了。";
			mes "现在得和林谈谈，";
			mes "弄清梦罗克外是否还有";
			mes "更多这样的东西。";
			close2;
		}
		else
		{
			mes "^3355FF你需要带来";
			mes "狂风来激活";
			mes "这个风元素徽记。^000000";
			cutin "mocseal_wind02.bmp",2;
			close2;
		}
	}
	else if(mao_request > 111)
	{
		mes "^3355FF你发现一个闪亮的徽记";
		mes "看起来像风的象征。";
		mes "靠近它时，";
		mes "能感到强风";
		mes "吹过皮肤。^000000";
		cutin "mocseal_wind01.bmp",2;
		close2;
	}
	cutin "mocseal_wind01.bmp",255;
	cutin "mocseal_wind02.bmp",255;
	end;
}

moc_fild12,280,36,1	script	Unturned Spot#earth	111,{

	if (mao_request == 13)
	{
		if (countitem(994))
		{
		mes "^3355FF你发现一个闪烁的";
			mes "象征";
			mes "大地力量的徽记。^000000";
			cutin "mocseal_earth01.bmp",2;
			next;
			mes "[" + strcharinfo(0) + "]";
			mes "让我看看……";
			mes "我应该用这个";
			mes "火焰之心";
			mes "稳定徽记。";
			next;
		mes "^3355FF你一拿出";
			mes "火焰之心、石头";
			mes "和徽记开始发出强光，";
			mes "仿佛力量正在";
			mes "相互冲突。^000000";
			specialeffect EF_BEGINSPELL5;
			specialeffect EF_BEGINSPELL3;
			next;
		mes "^3355FF火焰之心随后";
			mes "迅速消失，";
			mes "伴随着一阵热气。";

		//changequest 18036,18037;
		close;
	}
	else if (prt_curse > 17 && prt_curse < 22) {
		mes "[班普神父]";
		mes "和我一起前往秘密仪式场地，";
		mes "调查邦妮·英布利亚进行的驱魔仪式";
		mes "是否可能遭到破坏。";
		next;
		mes "[班普神父]";
		mes "书架上有一个隐藏开关，";
		mes "可以把你传送到那里。";
		mes "你先去，我会在仪式场地与你会合。";
		close;
	}
	else if (prt_curse == 22) {
		mes "[班普神父]";
		mes "这件事非常重要，但我们还不能通知王室，";
		mes "以免引发恐慌。最好先彻底调查，收集证据。";
		next;
		mes "[班普神父]";
		mes "勇敢的冒险者，请前往梦罗克的刺客公会，";
		mes "看看能否了解到如何确认王子们是否因中毒而死。";
		set prt_curse,23;
		//changequest 18039,18040;
		close;
	}
	else if (prt_curse == 23) {
		mes "[班普神父]";
		mes "请向梦罗克刺客公会的成员打听，";
		mes "看看能否找到检测毒杀的方法。";
		close;
	}
	else if (prt_curse == 31) {
		mes "[班普神父]";
		mes "啊，你回来了~";
		mes "你从刺客公会了解到毒药的事了吗？";
		mes "我知道他们的成员很难找到……";
		next;
		mes "^3355FF你把从刺客公会了解到的所有毒药信息，";
		mes "包括检测谋杀中是否使用毒药的方法，告诉了班普神父。";
		next;
		mes "[班普神父]";
		mes "啊，我明白了。那么请尽快带 1 个黄宝石和 1 瓶绿色药水";
		mes "到秘密仪式场地。我会再次在那里等你。";
		set prt_curse,32;
		//changequest 18044,18046;
		close;
	}
	else if (prt_curse == 32 || prt_curse == 33 || prt_curse == 41 || prt_curse == 42 || prt_curse == 51 || prt_curse == 52) {
		mes "[班普神父]";
		mes "你可以使用书架上的隐藏开关进入秘密仪式场地。";
		mes "别忘了我们需要^3131FF 1 个黄宝石^000000和^3131FF 1 瓶绿色药水^000000来检测毒药。";
		close;
	}
	else if (prt_curse == 34) {
		mes "[班普神父]";
		mes "我简直不敢相信！";
		mes "如果使用了毒药，那么第二王子和第三王子就是被谋杀的！";
		mes "难以置信……怎么会有人杀害孩子？";
		next;
		mes "[班普神父]";
		mes "至少现在我们知道，他们的死不是邦妮·英布利亚的错。";
		mes "现在我必须和比斯库斯神父讨论，决定如何把这件事告诉王室……";
		next;
		mes "[班普神父]";
		mes "再次提醒你，这里发生的一切必须保密。";
		mes "公众不能知道耶梦加得的诅咒！否则会引发政治动荡和混乱！";
		next;
		mes "[班普神父]";
		mes "不过这不代表我不能亲自感谢你的帮助。";
		mes "我非常感激你所做的一切，冒险者。愿安全伴随你所有的旅程。";
		set prt_curse,35;
		//changequest 18047,18050;
		close;
	}
	else if (prt_curse > 34 && prt_curse < 40 && !aru_monas) {
		mes "[班普神父]";
		mes "我不知道该怎么办。";
		mes "有时我甚至会怀疑，奥丁已经抛弃了我们……";
		close;
	}
	else if (prt_curse == 40) {
		mes "[班普神父]";
		mes "啊，你回来了~";
		mes "你从刺客公会了解到毒药的事了吗？";
		mes "我知道他们的成员很难找到……";
		next;
		mes "^3355FF你把从刺客公会了解到的所有毒药信息，";
		mes "包括检测谋杀中是否使用毒药的方法，告诉了班普神父。";
		next;
		mes "[班普神父]";
		mes "啊，我明白了。那么请尽快带^3131FF 1 个黄宝石和 1 瓶绿色药水^000000";
		mes "到秘密仪式场地。我会再次在那里等你。";
		set prt_curse,41;
		//changequest 18045,18046;
		close;
	}
	else if (prt_curse == 43 || prt_curse == 53) {
		mes "[班普神父]";
		mes "我简直不敢相信！如果使用了毒药，";
		mes "那么第二王子和第三王子就是被谋杀的！";
		mes "难以置信……怎么会有人杀害孩子？";
		next;
		mes "[班普神父]";
		mes "至少现在我们知道，他们的死不是邦妮·英布利亚的错。";
		mes "我必须和比斯库斯神父讨论，决定如何告知王室……";
		next;
		mes "[班普神父]";
		mes "哦，也请告诉^3131FF邦妮·英布利亚^000000，";
		mes "王子的死不是她的错。这个消息一定能减轻她的罪疚感……";
		next;
		mes "[班普神父]";
		mes "再次提醒你，这里发生的一切必须保密。";
		mes "公众不能知道耶梦加得的诅咒！否则会引发政治动荡和混乱！";
		next;
		mes "[班普神父]";
		mes "不过这不代表我不能亲自感谢你的帮助。";
		mes "我非常感激你所做的一切，冒险者。愿安全伴随你所有的旅程。";
		if (prt_curse == 43)
			set prt_curse,44;
		else
			set prt_curse,54;
		//changequest 18047,18049;
		getexp (checkre(3))?90000:1600000,0;
		close;
	}
	else if (prt_curse > 43 && prt_curse < 50 && !aru_monas) {
		mes "[班普神父]";
		mes "你和邦妮·英布利亚谈过了吗？";
		mes "别太担心王子被谋杀的消息。";
		mes "我和比斯库斯神父会处理的。";
		close;
	}
	else if (prt_curse == 50) {
		mes "[班普神父]";
		mes "啊，你回来了~";
		mes "你从刺客公会了解到毒药的事了吗？";
		mes "我知道他们的成员很难找到……";
		next;
		mes "你把从刺客公会了解到的所有毒药信息，";
		mes "包括检测谋杀中是否使用毒药的方法，告诉了班普神父。";
		next;
		mes "[班普神父]";
		mes "啊，我明白了。那么请尽快带^3131FF 1 个黄宝石和 1 瓶绿色药水^000000";
		mes "到秘密仪式场地。我会再次在那里等你。";
		set prt_curse,51;
		//changequest 18043,18046;
		close;
	}
	else if (prt_curse == 60) {
		mes "[班普神父]";
		mes "哦，"+strcharinfo(0)+"~";
		mes "好久不见。你和邦妮谈过了吗？";
		mes "啊，今天我能帮你什么？";
		next;
		mes "^3355FF你告诉班普神父，西方的土地上生长着稀有药草，";
		mes "但没有提及你曾告诉罗达弗里安诅咒的事。^000000";
		next;
		mes "[比斯库斯神父]";
		mes "西方的土地？";
		mes "据说那里住着狂热分子。";
		mes "班普神父，我认为他们可能是谋杀王子的最大嫌疑人……";
		next;
		mes "[班普神父]";
		mes "我承认这有可能，但我们已经很久没有和西方土地的人接触了……";
		mes "现在做这种推测还为时过早。";
		next;
		select("西方的土地？");
		mes "[Father Bamph]";
		mes "我们对西方土地了解不多。";
		mes "曾经派过几位神父去那里传播信仰，";
		mes "但他们失败了……";
		next;
		mes "[班普神父]";
		mes "据我所知，那里几乎所有人";
		mes "都是当地宗教的坚定信徒。";
		mes "总之，谢谢你通知我们。接下来交给我们处理。";
		next;
		mes "[班普神父]";
		mes "为了保守王室秘密，我请求你今后不要再进入秘密仪式场地。";
		mes "再次感谢你的帮助，"+strcharinfo(0)+"。";
		set prt_curse,61;
		//completequest 18052;
		close;
	}
	else {
		if (prt_curse == 36 || prt_curse == 45 || prt_curse == 56 || prt_curse == 61) {
// Begin Nameless Island Access Quest Addition
			if (aru_monas == 0) {
				mes "[班普神父]";
				mes "抱歉，我们稍后再谈好吗？";
				mes "我现在必须处理一项非常重要的任务……";
				close;
			} else if (aru_monas == 1) {
				mes "[班普神父]";
				mes "哦，我一直在等你，冒险者。";
				mes "抱歉这么突然叫你来，";
				mes "但看来你比我们上次见面时强大了许多。";
				next;
				mes "[班普神父]";
				mes "教会收到了普隆德拉王宫的请求，";
				mes "但我们没有足够资源处理。";
				mes "如果你愿意帮助我们，我相信你非常适合这项任务。";
				next;
				mes "[班普神父]";
				mes "一位高官不久前突然失踪。";
				mes "虽然普隆德拉王宫要求我们找到他，";
				mes "但我之后才能告诉你他是谁。";
				next;
				mes "[班普神父]";
				mes "我们只知道他最后在科莫多出现。";
				mes "请去找我们的线人^6B8E23拉尔杰斯^000000，";
				mes "他会帮助你寻找失踪的官员。";
				set aru_monas,2;
				//changequest 17000,17001;
				close;
			}
			else if (aru_monas == 2 || aru_monas == 3) {
				mes "[班普神父]";
				mes "请前往科莫多，在赌场找到我们的线人^6B8E23拉尔杰斯^000000。";
				mes "他会帮助你寻找失踪的官员。";
				close;
			}
			else if (aru_monas == 4) {
				mes "[班普神父]";
				mes "啊，你找到拉尔杰斯了？";
				mes "对那位官员失踪的调查进展如何？";
				mes "希望找到他时，他仍然平安。";
				next;
				select("告诉他拉尔杰斯说的话。");
				mes "[班普神父]";
				mes "我明白了。最近我们察觉到阿鲁纳佩尔兹有些令人不安的活动，";
				mes "但没想到他们这么快就会行动。嗯……给我一点时间思考。";
				set aru_monas,5;
				close;
			}
			else if (aru_monas == 5) {
				if (rand(1,5) == 4) {
					mes "[班普神父]";
					mes "我考虑了所有可能的情况。";
					mes "我认为最好由你代表我们继续调查，";
					mes "当然，前提是你愿意。";
					next;
					mes "[班普神父]";
					mes "我们不想因官方介入而引发国际冲突，";
					mes "但我也不能强迫你为我们工作。";
					mes "是否帮助我们由你决定。";
					next;
					if (select("让我考虑一下。:当然，我会帮忙。") == 1) {
						mes "[班普神父]";
						mes "希望你决定帮助我们。";
						mes "我国的安全取决于这次调查的成功。";
						mes "我们真的很需要你的帮助。";
						close;
					}
					mes "[班普神父]";
					mes "谢谢。很高兴听到你愿意帮助我们。";
					mes "你可以在依斯鲁得乘飞艇前往阿鲁纳佩尔兹，继续调查。";
					next;
					mes "[班普神父]";
					mes "我相信调查^9370DB拉赫^000000城能让你了解更多。";
					mes "请收下这笔钱，用来支付飞艇费用。";
					mes "谢谢，祝你好运。";
					set aru_monas,6;
					set Zeny, Zeny + (checkre(0)?5000:1500);
					//changequest 17002,17003;
					close;
				}
				else {
					mes "[班普神父]";
					mes "嗯……我们该如何处理？让我想想。";
					mes "我们可以——不，那行不通。这会很困难。";
					close;
				}
			}
			else if (aru_monas == 6) {
				// Anyone else see the irony in this?
				mes "[班普神父]";
				mes "你在拉赫可能会遇到麻烦，那里文化不同于我们。";
				mes "他们的办事方式、政府……一切都与宗教有关。";
				close;
			}
			else if (aru_monas > 6 && aru_monas < 25) {
				mes "[班普神父]";
				mes "非常感谢你的辛勤工作。";
				mes "我们的探员发现新情报后会联系你。";
				mes "记住，不能让任何人知道我们在做什么。";
				close;
			}
			else if (aru_monas == 25 || aru_monas == 26) {
				mes "[班普神父]";
				mes "谢谢你带来如此重要的信息。";
				mes "多亏你的帮助，我们解决了几起悬案。";
				mes "我们预料过会发生这种事，但没想到这么快。";
				next;
				mes "[班普神父]";
				mes "我担心王室一直在为自身私利争吵。";
				mes "希望事情不会恶化、陷入混乱。^666666*叹气*^000000 走着瞧吧……";
				close;
			}
			else {
				mes "[班普神父]";
				mes "最近阿鲁纳佩尔兹如此安静，让我很不安。";
				mes "你知道暴风雨前总会有一段平静吧？";
				close;
			}
// End Nameless Island Access Quest Addition
		}
	}
}

prt_church,184,110,3	script	Father Biscuss	60,{
	if (prt_curse == 54) {
		mes "[比斯库斯神父]";
		mes "嗯，我仍怀疑是刺客公会的某人杀害了王子。";
		mes "为以防万一，我会派一名间谍。保守这个秘密。";
		next;
		mes "[比斯库斯神父]";
		mes "所以，你什么也没从我们这里了解到或听说过，";
		mes "也不知道王室的诅咒。";
		mes "从现在起，这件事由我和班普神父处理。";
		close;
	}
	else if (prt_curse == 35) {
		mes "[比斯库斯神父]";
		mes "我以前从未见过班普神父这样，";
		mes "但我能理解他的感受。";
		mes "作为教会的领导者之一，他觉得自己要为王子的死负责。";

un_bk_q,100,312,6	script	Mechanician Bukal#EP15.2MR	4_M_REPAIR,{
	callfunc( "F_time_limit_recorder", .@cooldown_status_day,1,0 );
	if (.@cooldown_status_day[0] == 1) {
		mes "[Mechanician Bukal]";
		mes "你在清点人数吗？";
		next;
		mes "[Mechanician Bukal]";
		mes "我不确定。也许你可以问问那边的阿尔？";
		close;
	}
	if (.@cooldown_status_day[1] == 1) {
		mes "[Mechanician Bukal]";
		mes "我是指你现在搬运的空气净化装置。";
		next;
		mes "[Mechanician Bukal]";
		mes "那是我做的。很厉害吧？";
		close;
	}
	if (.@cooldown_status_day[2] == 1) {
		mes "[Mechanician Bukal]";
		mes "啊！！你是冒险者。可以去农场看看。";
		next;
		mes "[Mechanician Bukal]";
		mes "农场因为温暖所以很不错吧？那里的温度控制装置是我做的。很厉害吧？";
		close;
	}
	if (.@cooldown_status_day[3] == 1) {
		mes "[Mechanician Bukal]";
		mes "我担心人们会突然发动攻击。";
		next;
		mes "[Mechanician Bukal]";
		mes "既然我们已经在这里了，要不要做个患者压制装置之类的？";
		close;
	}
	if (.@cooldown_status_day[4] == 1) {
		mes "[Mechanician Bukal]";
		mes "我不明白大家为什么都拒绝使用能搬运重物的装置。";
		next;
		mes "[Mechanician Bukal]";
		mes "他们制作新的空气净化装置时，我就该做一个。";
		close;
	}
	mes "[Mechanician Bukal]";
	mes "唉……我想做点东西。";
	close;
}

un_bk_q,76,175,4	script	Researcher Grum#EP15.2MR	4_F_SCIENCE,{
	callfunc( "F_time_limit_recorder", .@cooldown_status_day,1,0 );
	if (.@cooldown_status_day[0] == 1) {
		mes "[Researcher Grum]";
		mes "那个女人凭什么像领导一样清点人数？";
		next;
		mes "[Researcher Grum]";
		mes "如果一开始没有进行实验，就不会发生爆炸了吧？";
		close;
	}
	if (.@cooldown_status_day[1] == 1) {
		mes "[Researcher Grum]";
		mes "我觉得那个自以为是又憔悴的弗雷莎变了。";
		next;
		mes "[Researcher Grum]";
		mes "她比以前温和多了，对吧？";
		close;
	}
	if (.@cooldown_status_day[2] == 1) {
		mes "[Researcher Grum]";
		mes "弗雷莎确实改变了很多。";
		next;
		mes "[Researcher Grum]";
		mes "今天她在给大家发葡萄。过去这是不可想象的。";
		close;
	}
	if (.@cooldown_status_day[3] == 1) {
		mes "[Researcher Grum]";
		mes "为什么弗雷莎独自摆出领导的样子，却还没有采取措施？";
		next;
		mes "[Researcher Grum]";
		mes "必须对那些抽搐的患者采取措施。你打算像过去一样隐瞒吗？";
		close;
	}
	if (.@cooldown_status_day[4] == 1) {
		mes "[Researcher Grum]";
		mes "原来是这样吗？";
		next;
		mes "[Researcher Grum]";
		mes "她敷衍了事的时候我就该知道了。";
		close;
	}
	mes "[Researcher Grum]";
	mes "我真的不喜欢自以为是又虚伪的弗雷莎。";
	close;
}


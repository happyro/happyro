un_bk_q,103,393,4	script	Memory Record player#EP15.2MR	4_ENERGY_BLUE,{
	callfunc( "F_time_limit_recorder", .@cooldown_status_day,1,0 );
	mes "这里有一份正在记录的记忆记录。";
	next;
	if (select( "聆听。", "退出。" ) == 2)
		close;
	while(1) {
		mes "啊啊——一二三，测试——测试——";
		next;
		mes "为了区分防空洞中的生存天数，今天被定为实验爆炸后的爆炸日 1。";
		next;
		mes "爆炸后，大家从监视器看到外面的情况，陷入了恐慌。";
		next;
		mes "但首席研究员弗雷莎博士冷静地安慰大家，并确认幸存人数。";
		next;
		mes "包括冒险者在内，最终幸存者似乎有 326 人。";
		next;
		mes "下午用于观察外面的摄像机损坏了。看来我们再也看不到外面的情况了。";
		next;
		if (.@cooldown_status_day[0] == 1) {
			mes "没有更多记录内容了。";
			next;
			if (select( "再听一遍。", "退出。" ) == 2)
				close;
			continue;
		}
		if (select( "继续聆听。", "退出。" ) == 2)
			close;
		mes "爆炸日 2";
		next;
		mes "针对主任兼首席研究员弗雷莎的猎巫行动开始了。";
		next;
		mes "我的看法不同。研究和实验是在她的指导下进行的，但这只是一起事故。";
		next;
		mes "就算不是弗雷莎，他们也会找别人来背锅。";
		next;
		mes "不过尽管受到质疑，她仍然以庄重的方式处理这件事。";
		next;
		mes "她说解决问题比追究责任更重要，正在确认事故前幸存者的工作分配。";
		next;
		if (select( "继续聆听。", "退出。" ) == 2)
			close;
		mes "爆炸日 3";
		next;
		mes "弗雷莎……她自然成了幸存者的领导。";
		next;
		mes "虽然没有进行正式投票，但没人对她成为领导有意见。";
		next;
		mes "前一天，她向所有幸存者说明了情况。";
		next;
		mes "20 名生物工程师";
		mes "16 名机械工";
		mes "27 名设施管理员";
		mes "10 名化学物质专家";
		mes "此外，还评估了食堂员工、清洁工、园丁、分发主管、医护人员以及卷入事故的冒险者等幸存者的工作安排。";
		next;
		if (select( "继续聆听。", "退出。" ) == 2)
			close;
		mes "爆炸日 4";
		next;
		mes "根据弗雷莎前一天的说明，大家的工作都已经确定。";
		next;
		mes "我们决定，包括我在内的研究员不再进行研究，必须在防空洞里，在掌握生存所需技术的人的指导下继续生活。";
		next;

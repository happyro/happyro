			mes "[碧珠]";
			mes "2. 以下哪项被视为";
			mes "舞池中不礼貌的行为";
			mes "？";
			next;
			if (select("感谢舞伴。:赞美舞伴的舞蹈。:邀请跳另一种舞。:批评舞伴。") == 4)
				set .@da_score,.@da_score+10;
			mes "[碧珠]";
			mes "3. 以下哪项不是";
			mes "恰当回应";
			mes "当有人犯错时";
			mes "而你们";
			mes "一起跳舞？";
			next;
			if (select("相视微笑并继续跳舞。:指出错误。:若舞者没察觉就忽略。:对他微笑。") == 2)
				set .@da_score,.@da_score+10;
			mes "[碧珠]";
			mes "4. 在哪个城镇";
			mes "可以转职";
			mes "为舞者？";
			next;
			if (select("科科莫:桑达曼:科穆多:海洞") == 4)
				set .@da_score,.@da_score+10;
			mes "[碧珠]";
			mes "5. 有多少个地牢";
			mes "直接连接";
			mes "海洞？";
			next;
			if (select("1:2:3:4") == 3)
				set .@da_score,.@da_score+10;
			mes "[碧珠]";
			mes "6. 以下哪项";
			mes "不是可爱宠物怪物？";
			next;
			if (select("伊西斯:阿尔吉欧佩:鬼女:小恶魔") == 2)
				set .@da_score,.@da_score+10;
			mes "[碧珠]";
			mes "7. 谁是最";
			mes "优雅的舞者？";
			next;
			switch(select("" + strcharinfo(0) + ":碧珠:伊西斯:梅西·博库")) {
			case 1:
				mes "[碧珠]";
				mes "...";
				mes "那是……";
				mes "^660000完全错误^000000。";
				mes "你没看到";
				mes "其他选项吗？！";
				mes "扣分……！";
				set .@da_score,.@da_score-10;
				next;
				break;
			case 2:
				set .@da_score,.@da_score+10;
				break;
			default:
				break;
			}
			mes "[碧珠]";
			mes "8. 是什么";
			mes "准确名称";
			mes "海洞的卡普拉？";
			next;
			if (select("卡普拉总部:卡普拉西部总部:卡普拉服务处:卡普拉总部：西部支部") == 4)
				set .@da_score,.@da_score+10;
			mes "[……]";
			mes "9. 我的名字是什么？";
			next;
			if (select("博尔朱瓦:布尔乔亚:碧珠:贝鲁贝鲁") == 3)
				set .@da_score,.@da_score+10;
			mes "[碧珠]";
			mes "10. 是什么";
			mes "^CD6889摇篮曲^000000 的效果？";
			next;
			if (select("在区域内施加黑暗效果。:在区域内施加睡眠效果。:使区域进入夜晚效果。:冻结区域。") == 2)
				set .@da_score,.@da_score+10;
			break;
		case 3:
			mes "[碧珠]";
			mes "1. 效果是什么";
			mes "^CD6889舞蹈课程^000000 技能的效果？";
			next;
			switch(select("增加 INT:提高舞蹈技能效果:增加鞭类武器伤害。:使施法者周围一定区域陷入昏迷。")) {
			default:
				break;
			case 2:
			case 3:
				set .@da_score,.@da_score+10;
				break;
			}
			mes "[碧珠]";
			mes "2. 哪种舞蹈使用鞋子";
			mes "用来让";
			mes "舞者滚动";
			mes "脚步、敲击";
			mes "地面制造节奏？";
			next;
			if (select("踢踏舞:集中力提升:探戈:二连矢") == 1)
				set .@da_score,.@da_score+10;
			mes "[碧珠]";
			mes "3. 以下哪项";
			mes "不是舞者的特征？";
			next;
			if (select("使用舞蹈技能。:进行远程攻击。:使用鞭子。:使用双手剑。") == 4)
				set .@da_score,.@da_score+10;
			mes "[碧珠]";
			mes "4. 哪个城镇有";
			mes "大多数舞者？";
			next;
			if (select("艾尔帕兰:朱诺:梦罗克:海洞") == 4)
				set .@da_score,.@da_score+10;
			mes "[碧珠]";
			mes "5. 以下哪项";
			mes "谁跳舞最优美？";
			next;
			switch(select("" + strcharinfo(0) + ":碧珠:伊西斯:固顿·塔克")) {
			case 1:
				mes "[碧珠]";
				mes "...";
				mes "那是……";
				mes "^660000完全错误^000000。";
				mes "你没看到";
				mes "其他选项吗？！";
				mes "扣分……！";
				set .@da_score,.@da_score-10;
				next;
				break;
			case 2:
				set .@da_score,.@da_score+10;
				break;
			default:
				break;
			}
			mes "[碧珠]";
			mes "6. 是什么舞者";
			mes "比其他职业更擅长？";
			mes "职业？";
			next;
			if (select("健康:表演:舞蹈:魔法") == 3)
				set .@da_score,.@da_score+10;
			mes "[碧珠]";
			mes "7. 谁是";
			mes "海洞赌场经理？";
			next;
			if (select("流:穆:露尔:勋") == 2)
				set .@da_score,.@da_score+10;
			mes "[碧珠]";
			mes "8. 哪件物品不能";
			mes "能被舞者装备？";
			next;
			if (select("小猫发箍:双手剑:凉鞋:耳环") == 2)
				set .@da_score,.@da_score+10;
			mes "[碧珠]";
			mes "9. 你认为这份测验";
			mes "可以说这份测验";
			mes "令人沮丧又烦人？";
			next;
			select("是:否");
			set .@da_score,.@da_score+10;
			mes "[碧珠]";
			mes "10. 以下哪项";
			mes "不是爵士乐手？";
			next;
			if (select("阿特·布莱基:比莉·霍利戴:路易斯·阿姆斯特朗:巴德·鲍威尔:长老树") == 5)
				set .@da_score,.@da_score+10;
		}
		mes "[碧珠]";
		mes "干得好~";
		mes "看来你";
		mes "回答了所有";
		mes "问题~";
		next;
	mes "[碧珠]";
		mes "让我看看……";
		mes "你的分数是";
		mes "" + .@da_score + " 分……";
		if (.@da_score == 100) {
			set DANC_Q,7;
			mes "做得非常好！";
			mes "满分！";
			next;
			mes "[碧珠]";
			mes "很少有具备这种知识的人来申请舞者职业。抱歉我以貌取人~";
			next;
	mes "[碧珠]";
			mes "呼~";
			mes "现在只剩舞蹈测试。我们准备测试时，你先休息一下吧？呵呵呵~";
			close;
		}
		else if (.@da_score > 70) {
			set DANC_Q,7;
			mes "虽然不是满分，但我让你通过。";
			close;
		}
		else {
			set DANC_Q,6;
			mes "你……你失败了！";
			next;
			mes "[碧珠]";
			mes "太难了吗？";
			mes "我年轻时，人人至少都知道足以通过测试的知识。再学习一些后回来，好吗？";
			close;
		}
	}
	else if (DANC_Q == 7) {
		mes "[碧珠]";
		mes "好……";
		mes "准备好";
		mes "参加舞蹈测试了吗？";
		mes "如果你愿意，我可以";
		mes "说明规则。";
		next;
		if (select("听取说明。:前往考试区域。") == 1) {
	mes "[碧珠]";
			mes "首先，每人有 ^CD68891 分钟^000000 测试时间，并且 ^CD6889一次一人^000000 跳舞。没跳过舞也不用担心~";
			next;
			mes "[碧珠]";
			mes "进入测试区后会看到舞台。首先 ^CD6889将镜头调整为正面^000000。^CD6889双击鼠标右键^000000 应该就能做到。";
			next;
	mes "[碧珠]";
			mes "不调整镜头的话，可能会混淆 ^CD6889上、下、左、右^000000 指令。";
			next;
			mes "[碧珠]";
			mes "在 ^CD6889等候室^000000 等待轮到你。前一人失败或轮到你时，测试开始。";
			next;
	mes "[碧珠]";
			mes "人多时等候室可能容纳不下所有人。那就排好队~";
			next;
			mes "[碧珠]";
			mes "测试开始后会广播音乐和移动方向。跟随指示移动双腿。";
			next;
	mes "[碧珠]";
			mes "记住，^CD6889动作时机不正确就会被淘汰^000000。小心，测试非常严格~";
			close;
		}
		mes "[碧珠]";
		mes "那么~";
		mes "祝你好运……！！";
		changequest 7004,7005;
		set DANC_Q,8;
		close2;
		warp "job_duncer",105,109;
		end;
	}
	else if (DANC_Q == 8) {
		mes "[碧珠]";
		mes "哎呀……";
		mes "你上次";
		mes "失败了吗？";
		mes "别担心，试着";
		mes "感受节奏~";
		close2;
		warp "job_duncer",105,109;
		end;
	}
	else if (DANC_Q == 9) {
		if (SkillPoint) {
			mes "[碧珠]";
			mes "你无法转职";
			mes "如果还有技能";
			mes "点。用完剩余技能点";
			mes "再回来。";
			close;
		}
		mes "[碧珠]";
		mes "哎呀……";
		mes "我看了你的";
		mes "刚才的舞蹈。";
		mes "你很棒！";
		next;
		mes "[碧珠]";
		mes "你的表现证明你完全有资格成为舞者。那么，我来为你转职。";
		next;
		mes "[碧珠]";
		mes "在女神祝福下，你将重生为舞者。从今以后，没人会在没有微笑的情况下离开你身边~";
		next;
		set .@jlevel,JobLevel;
	mes "[碧珠]";
		completequest 7006;
		callfunc "Job_Change",Job_Dancer;
		callfunc "F_ClearJobVar";
		mes "哦……！";
		mes "你看起来很棒";
		mes "作为舞者~";
		mes "恭喜！";
		next;
		mes "[碧珠]";
		mes "这是一份小";
		mes "礼物。";
		mes "请收下。";
		mes "愿你的表演永远为观众带来欢乐~";
		if (.@jlevel == 50)
			getitem 1953,1; //Line_
		else
			getitem 1950,1; //Rope
		close;
	}
} 

// Waiting Room
//============================================================ 
job_duncer,32,154,1	script	Waiting Room#dance	66,{
	end;

OnInit:
	waitingroom "等候室",20,"Waiting Room#dance::OnStartArena",1;
	enablewaitingroomevent;
	end;

OnStartArena:
	disablenpc "dance#up";
	disablenpc "dance#down";
	disablenpc "dance#left";
	disablenpc "dance#right";
	disablenpc "dance#cen";
	donpcevent "dance#return::OnDisable";
	warpwaitingpc "job_duncer",69,110,1;
	donpcevent "Bijou#dance_timer::OnEnable";
	disablewaitingroomevent;
	end;

OnEnable:
	enablewaitingroomevent;
	end;
}

job_duncer,32,154,1	script	Waiting Room#click	66,{
	mes "[皮奥金]";
	mes "请在";
	mes "等候室等待。";
	mes "点击聊天室";
	mes "窗口进入。";
	next;
		mes "[皮奥金]";
	mes "另外，";
	mes "对测试好奇的人";
	mes "可以在后台观看";
	mes "测试。";
	close;
}

// Dance Timer
//============================================================ 
job_duncer,69,105,0	script	Bijou#dance_timer	-1,{
OnEnable:
	initnpctimer;
	end;

OnDisable:
	stopnpctimer;
	end;

OnTimer2000:
	mapannounce "job_duncer","好了，开始吧。放松，考试限时 1 分钟~",bc_map;
	end;

OnTimer5000:
	mapannounce "job_duncer","向上！",bc_map;
	end;

OnTimer7000:
	disablenpc "dance#up";
	enablenpc "dance#down";
	enablenpc "dance#left";
	enablenpc "dance#right";
	enablenpc "dance#cen";
	end;

OnTimer8000:
	donpcevent "Backdancer#1::OnSmile";
	disablenpc "dance#up";
	disablenpc "dance#down";
	disablenpc "dance#left";
	disablenpc "dance#right";
	disablenpc "dance#cen";
	mapannounce "job_duncer","向下！",bc_map;
	end;

OnTimer11000:
	enablenpc "dance#up";
	disablenpc "dance#down";
	enablenpc "dance#left";
	enablenpc "dance#right";
	enablenpc "dance#cen";
	end;

OnTimer12000:
	donpcevent "Backdancer#1::OnSmile";
	disablenpc "dance#up";
	disablenpc "dance#down";
	disablenpc "dance#left";
	disablenpc "dance#right";
	disablenpc "dance#cen";
	mapannounce "job_duncer","向左~！",bc_map;
	end;

OnTimer15000:
	enablenpc "dance#up";
	enablenpc "dance#down";
	disablenpc "dance#left";
	enablenpc "dance#right";
	enablenpc "dance#cen";
	end;
// 行数补齐

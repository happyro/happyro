			mes "天哪！那谁是我的配偶？";
			next;
			cutin "16loo_02.bmp",2;
			mes "[Rookie]";
			mes "嗯……泰迪熊？";
			next;
			mes "[Cyan]";
			mes "哎呀！不！就说这位冒险者是我的配偶。";
			next;
			cutin "16loo_01.bmp",2;
			mes "[Rookie]";
			mes "嘿！太无礼了！";
			next;
			mes "[Cyan]";
			mes "冒险者~现在不是很冷吗？";
			next;
			mes "[" + strcharinfo(0) + "]";
			mes "嗯。其实还好……";
			next;
			mes "[Cyan]";
			mes "哦，这件夹克看起来不错。难怪你不觉得冷。我们总是收到廉价衣服，所以很容易感到寒冷。";
			next;
			cutin "16loo_03.bmp",2;
			mes "[Rookie]";
			mes "冒险者现在很忙。你在说什么？";
			next;
			mes "[Cyan]";
			mes "听我说，看看周围。这里是由铁和石头建成的寒冷建筑。";
			next;
			mes "[Cyan]";
			mes "而且这里几乎位于地下，所以总是又冷又潮。你知道那种感觉吗？寒冷潮湿的空气让我们难受。";
			next;
			mes "[Cyan]";
			mes "所以我们总是在壁炉里生火，让空气变暖、烧茶、烤红薯……";
			next;
			mes "[Cyan]";
			mes "无论如何，壁炉给了我们许多便利，是一份恩赐。但由于缺少柴火，火快要熄灭了。";
			next;
			mes "[Cyan]";
			mes "外面太冷，我无法出去。所以能帮我带些柴火来吗，亲爱的？";
			emotion ET_THROB;
			next;
			cutin "16loo_01.bmp",2;
			emotion ET_PROFUSELY_SWEAT, playerattached();
			mes "[Rookie]";
			mes "嘿！你对冒险者太无礼了！分清现实和幻想吧！";
			next;
			mes "[Cyan]";
			mes "嗯，我分得太清楚了。与其住在这间冰冷的石屋里，我还不如跳进河里！";
			next;
			if (select( "你需要燃料吗？", "我现在必须离开。" ) == 2) {
				mes "[" + strcharinfo(0) + "]";
				mes "我现在可以离开吗？";
				next;
				mes "[Cyan]";
				mes "亲爱的，你要离开我吗？寒冷的天气让我很痛苦！";
				next;
				emotion ET_CRY;
				mes "[Rookie]";
				mes "冒险者，不用担心赛昂。我会照顾这个家伙。";
				next;
				mes "[Cyan]";
				mes "亲爱的，想我了就回来！";
				next;
				cloakonnpcself( "Cyan#16nego02" );
				mes "[" + strcharinfo(0) + "]";
			mes "好，我会的。";
				close3;
			}
			mes "[" + strcharinfo(0) + "]";
			mes "我明白了！懂了！只要我带来燃料，你就不会自杀了吧？";
			next;
			mes "[Cyan]";
			mes "哦，亲爱的，你真善良可爱。";
			next;
			cutin "16loo_03.bmp",2;
			mes "[Rookie]";
			mes "你又来了。真拿你没办法。";
			next;
			emotion ET_SWEAT;
			mes "[Cyan]";
			mes "我需要一些烧焦的树，大约 10 个。它们晒得很干，容易燃烧。还需要优质煤炭让火烧得更久。请带 3 个煤炭来。";
			next;
			cutin "16loo_01.bmp",2;
			mes "[Rookie]";
			mes "煤炭？为什么？它会留下太多灰。";
			next;
			mes "[Cyan]";
			mes "对我来说效率最重要！越暖越好！";
			next;
			mes "[" + strcharinfo(0) + "]";
			mes "我明白了。请别争了。我会带来它们。10 个烧焦的树和 3 个煤炭，对吧？";
			next;
			mes "[Cyan]";
			mes "哎呀！还要打败 10 个废弃炉灶！";
			next;
			mes "[Rookie]";
			mes "为什么？";
			next;
			mes "[Cyan]";
			mes "你必须打败它们才能获得煤炭！";
			next;
			cutin "16loo_03.bmp",2;
			mes "[Rookie]";
			mes "拜托。冒险者已经知道了。";
			next;
			mes "[Cyan]";
			mes "小心，亲爱的~";
			next;
			cutin "16loo_01.bmp",2;
			cloakonnpcself( "Cyan#16nego02" );
			emotion ET_PROFUSELY_SWEAT, playerattached();
			mes "[Rookie]";
			mes "呼……无论如何我们就靠你了。不管那个家伙告诉你什么，火熄灭后大家都会感冒。";
			setquest .@quest_id;
			close3;
		case 1:
			cutin "16loo_02.bmp",2;
			mes "[Rookie]";
			mes "冒险者，你似乎付出了很多努力！";
			next;
			cloakoffnpcself( "Cyan#16nego02" );
			mes "[Cyan]";
			mes "欢迎回来，亲爱的！！！都带来了吗？对吧？";
			next;
			if (countitem(7068) < 10 || countitem(1003) < 3) {
				mes "[Cyan]";
				mes "哦，这里没有。而且数量也不够……也许你忘了我们让你带什么？";
				next;
				mes "[Cyan]";
				mes "10 个烧焦的树和 3 个煤炭。我觉得好冷。再见，亲爱的。";
				next;
				mes "[Cyan]";
				mes "别忘了打败大约 10 个废弃炉灶！我会在床边睡觉。太冷了！";
				next;
				cloakonnpcself( "Cyan#16nego02" );
				cutin "16loo_03.bmp",2;
				mes "[Rookie]";
				mes "真娇气。冒险者，我们还要靠你。如果你不带来它们，赛昂会整天缠着你。";
				close3;
			}
			if (checkquest(14604,HUNTING) != 2) {
				mes "[Cyan]";
			mes "哦，你带来了柴火……废弃炉灶呢？你没有打败它们？";
				next;
				mes "[Cyan]";
			mes "你必须打败它们，亲爱的。废弃炉灶被摇动约 1,000 次后才会释放优质柴火。";
				next;
				mes "[Cyan]";
			mes "打败^0000cd10 个废弃炉灶^000000。我会在床边睡觉。太冷了！";
				next;
				cloakonnpcself( "Cyan#16nego02" );
				cutin "16loo_03.bmp",2;
				mes "[Rookie]";
			mes "真娇气。冒险者，我们还要靠你。如果你不带来它们，赛昂会整天缠着你。";
				close3;
			}
			mes "[Cyan]";
			mes "哇！你把它们全带来了！亲爱的，你真可靠！";
			next;
			cloakoffnpcself( "#16negofire" );
			mes "[Cyan]";
			mes "好。把柴火和煤炭放进去……着火！！！！！！";
			specialeffect EF_FIREWALL, AREA, "#16negofire";
			next;
			mes "[Cyan]";
			mes "哦，现在暖和了。像你的爱一样温暖~";
			next;
			cutin "16loo_03.bmp",2;
			mes "[Rookie]";
			mes "你能别再叫‘亲爱的’了吗？你把我的玩笑重复太多次了。";
			next;
			mes "[Cyan]";
			mes "嘿！是你先开始的！";
			next;
			cutin "16loo_01.bmp",2;
			mes "[Rookie]";
			mes "这是玩笑。玩笑！玩笑！玩笑！";
			next;
			mes "[Cyan]";
			mes "总之，我喜欢这位冒险者！我绝不会放走冒险者！绝不！";
			next;
			mes "[Cyan]";
			mes "那么亲爱的，明天还会回来吗？";
			next;
			mes "[Rookie]";
			mes "又来了！！！";
			next;
			mes "[Cyan]";
			mes "这些只够今天用。当然，我们每天都必须生火！";
			next;
			mes "[" + strcharinfo(0) + "]";
			mes "哦，我明白了。别争了。如果我记得，明天会回来。";
			next;
			mes "[Cyan]";
			mes "亲爱的，你真善良！但我明天可能不在这里执行任务。请不要失望！";
			next;
			cutin "16loo_03.bmp",2;
			mes "[Rookie]";
			mes "我不认为冒险者会失望。";
			next;
			mes "[Cyan]";
			mes "现在我要进去睡觉了。再见！";
			next;
			cloakonnpcself( "#16negofire" );
			cloakonnpcself( "Cyan#16nego02" );
			mes "[Rookie]";
			mes "呼，我也累坏了。现在好好休息，^0000cd黎明^000000后再回来。";

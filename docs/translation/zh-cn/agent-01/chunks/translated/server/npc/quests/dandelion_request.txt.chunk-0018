	OnTouch:
	mes "^333333神圣……血之……";
mes "仪式……我很自豪……";
	mes "能成为……最后的……";
	mes "祭品……嘿嘿嘿……^000000";
	next;
	mes "^3355FF那道奇怪声音的疯狂笑声";
	mes "在你脑中回响，";
	mes "你在某个陌生地方醒来。^000000";
	next;
	mes "[" + strcharinfo(0) + "]";
	mes "我在哪里……？";
	mes "这里是什么地方？";
	mes "啊，我的头好痛，";
	mes "但我必须阻止";
	mes "撒旦梦罗克复活……";
mapannounce "que_job03","……鲜血……是……灵魂的货币……",1,0x7B68EE;
	next;
	mes "[" + strcharinfo(0) + "]";
	mes "又是那道声音！";
	mes "基德？瓦尔德斯？";
	mes "你们有人在这里吗？";
	mes "可恶，我一定是孤身一人。";
	mes "看来只能靠我自己";
	mes "阻止这个奇怪的仪式了！";
	close2;
	disablenpc "#maogate2_talk1";
	end;
	}
	

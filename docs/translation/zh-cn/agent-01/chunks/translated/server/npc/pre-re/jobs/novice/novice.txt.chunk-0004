				mes "[卡普拉员工]";
				mes "请记住，装备每件占用一个背包格。卡普拉仓库最多可存放 30,000 件物品。";
				if (nov_3_archer < 20) {
					if (JobLevel < 7) {
						set nov_3_archer,20;
						switch (JobLevel) {
						case 1: getexp 0,10; break;
						case 2: getexp 0,18; break;
						case 3: getexp 0,28; break;
						case 4: getexp 0,40; break;
						case 5: getexp 0,91; break;
						case 6: getexp 0,151; break;
						}
					}
				}
				next;
				break;
			case 3:
				mes "[卡普拉员工]";
				mes "卡普拉公司";
				mes "为尊贵客户提供便捷的传送服务，大幅缩短";
				mes "旅行时间。";
				next;
				mes "[卡普拉员工]";
				mes "我们的传送服务安全舒适，让你充分探索米德加尔特大陆各地。";
				next;
				mes "[卡普拉员工]";
				mes "感谢尊贵客户的支持，我们将继续提供最优质";
				mes "的服务。";
				next;
				break;
			case 4:
				mes "[卡普拉员工]";
				mes "卡普拉公司";
				mes "为商人、铁匠和炼金术士提供手推车租赁服务。";
				next;
				mes "[卡普拉员工]";
				mes "华丽神秘的";
				mes "^CE6300超级初心者^000000可以使用手推车，但我们官方并未与该职业签订合同。不过，不知为何……";
				next;
				mes "[卡普拉员工]";
				mes "无论如何，商人、铁匠和炼金术士必须学习 ^3355FF手推车^000000 技能才能租车。";
				next;
				mes "[卡普拉员工]";
				mes "手推车租赁服务";
				mes "费用因城镇而异。";
				mes "从一个城镇前往另一个城镇。";
				next;
				break;
			case 5:
				mes "[卡普拉员工]";
				mes "谢谢。";
				close;
			}

		}
	}
}

//Interface Assistant
new_1-2,161,182,5	script	Instructor#nv	92,{
	mes "[埃德温]";
	mes "欢迎来到我的课程。";
	mes "请选择你想";
	mes "深入学习的主题。";
	next;
	while(1) {
		switch(select("基本信息窗口:队伍窗口:物品窗口:选项窗口:装备窗口:取消")) {
		case 1:
			mes "[埃德温]";
			mes "让我们看看";
			mes "基本信息窗口，";
			mes "好吗？";
			next;
			mes "[埃德温]";
			mes "此窗口显示你的姓名、职业、基础等级";
			mes "和职业等级。^800FFF基础等级^000000 是角色等级。";
			next;
			mes "[埃德温]";
			mes "基础等级下方显示的 ^800fff职业等级^000000";
			mes "表示角色职业等级。刚开始职业时为";
			mes "职业等级 1。";
			next;
			mes "[埃德温]";
			mes "基本信息窗口的基础等级经验条显示当前经验值。";
			next;
			mes "[埃德温]";
			mes "《仙境传说 Online》的经验值以百分比表示。基础经验和职业经验彼此独立。";
			next;
			mes "[埃德温]";
			mes "当基础等级或";
			mes "职业等级条达到 100% 时，等级提升 1，经验条重置为 0。";
			next;
			mes "[埃德温]";
			mes "HP 代表“生命值”。";
			mes "HP 降为 0 时，你会昏倒并无法战斗。可以返回出生点，或等待别人复活你。";
			next;
			mes "[埃德温]";
			mes "如果在野外或地下城死亡，会受到";
			mes "^FF0000-1% 经验值惩罚^000000，请小心。";
			next;
			mes "[埃德温]";
			mes "SP 代表“技能点”。";
			mes "成为一转职业后，你会学到需要 SP 才能使用的职业专属技能。技能导师可以教你更多技能知识。";
			next;
			mes "[埃德温]";
			mes "要查看可携带物品的负重上限，请查看";
			mes "基本信息窗口的左下角。";
			next;
			mes "[埃德温]";
			mes "当前携带物品的重量会显示在负重上限旁边。";
			next;
			mes "[埃德温]";
			mes "携带物品超过负重上限的 50% 后，休息将不会恢复 HP 和 SP，请注意。";
			next;
			mes "[埃德温]";
			mes "负重上限旁的数值显示你当前拥有的 Zeny，也就是米德加尔特的货币。";
			next;
			mes "[埃德温]";
			mes "基本信息窗口的右侧";
			mes "有一系列可打开其他界面窗口的按钮。逐个点击，看看它们能做什么。";
			next;
			mes "[埃德温]";
			mes "最小化和最大化基本信息窗口的快捷键";
			mes "快捷键是“^3355FFAlt^000000 + ^3355FFV^000000”。";
			next;
			break;
		case 2:
			mes "[埃德温]";
			mes "点击基本信息窗口中的 ^3355FF好友^000000 按钮即可打开队伍窗口。队伍窗口的快捷键是“^3355FFAlt^000000 + ^3355FFZ^000000”。你可以在此查看队伍成员。";
			next;
			mes "[埃德温]";
			mes "队长可以决定";
			mes "经验值和物品在队伍中的分配方式。你也可以在小地图上查看队伍成员的位置。";
			next;
			mes "[埃德温]";
			mes "在队伍窗口中点击 ^3355FF好友^000000 按钮即可查看好友列表。你可以使用";
			mes "好友列表向朋友发送私聊";
			mes "消息。";
			next;
			mes "[埃德温]";
			mes "可以向技能导师了解更多组队方法。当然，也可以自己尝试。";
			next;
			break;
		case 3:
			mes "[埃德温]";
			mes "物品窗口分为";
			mes "分为 3 类：消耗品、装备和其他物品。";
			next;
			mes "[埃德温]";
			mes "负重上限会限制你能携带的物品数量。携带太多东西时，请把多余物品放入卡普拉仓库。";
			next;
			mes "[埃德温]";
			mes "装备和消耗品也可以通过快捷栏分配到快捷键。";
			next;
			mes "[埃德温]";
			mes "按 ^3355FFF12^000000 键打开快捷键窗口。F1 至 F9 键是指定快捷键。";
			next;
			mes "[埃德温]";
			mes "快捷键共有 3 组。";
			mes "按下 F12 键即可";
			mes "在不同快捷键组之间";
			mes "切换。";
			next;
			break;
		case 4:
			mes "[埃德温]";
			mes "点击基本信息窗口中的 ^3355FF选项^000000 按钮即可打开选项窗口，也可以按“^3355FFAlt^000000 + ^3355FFO^000000”。";
			next;
			mes "[埃德温]";
			mes "在选项窗口中可以调整声音、GUI 皮肤及皮肤透明度。";
			next;
			mes "[埃德温]";
			mes "使用声音按钮可以开关背景音乐并调整音量，音效也可以进行同样的设置。";
			next;
			mes "[埃德温]";
			mes "使用皮肤选项可以更改游戏窗口的 GUI 皮肤。在拥有的皮肤列表中滚动并选择";
			mes "一种皮肤。";
			next;
			mes "[埃德温]";
			mes "也可以从官方网站下载官方皮肤：";
			mes "^0000FFhttp://iro.ragnarokonline.com^000000";
			next;
			mes "[埃德温]";
			mes "吸附选项会在鼠标光标悬停于目标附近时，自动将光标定位到目标上。";
			next;
			mes "[埃德温]";
			mes "点击攻击时，鼠标光标会自动变成剑的形状。技能和物品选取也适用于吸附功能。";
			next;
			mes "[埃德温]";
			mes "刚开始使用时可能觉得方便或别扭。熟悉吸附功能后，就能调整自己的吸附选项。";
			next;
			mes "[埃德温]";
			mes "当然，这取决于你的体验。选项窗口的说明就到这里。";
			next;
			break;
		case 5:
			mes "[埃德温]";
			mes "点击基本信息窗口中的 ^3355FF装备^000000 按钮，";
			mes "或者按下“^3355FFAlt^000000 + ^3355FFQ^000000”。";
			next;
			mes "[埃德温]";
			mes "在装备窗口中，";
			mes "你会看到角色当前装备的物品。刚开始时，每个角色都会装备一把小刀和";
			mes "一件棉衬衣。";
			next;
			mes "[埃德温]";
			mes "更换装备有两种方法：在物品窗口双击装备，或点击并将物品拖入";
			mes "装备窗口。";
			next;
			mes "[埃德温]";
			mes "也可以将装备分配到快捷键，只需把装备从物品窗口拖入快捷键窗口。";
			mes "('^3355FFF12^000000' key).";
			next;
			break;
		case 6:
			mes "[埃德温]";
			mes "如果你有";
			mes "任何问题，";
			mes "随时可以问我～";
			close;
		}
	}
}

new_1-2,182,182,3	script	Somatology Instructor	754,{
			mes "[雅尔·里奥特]";
	mes "欢迎，新冒险者。";
	mes "我叫贾雷·里奥特，会帮助你了解";
	mes "角色属性的基本规则。";
	next;
			mes "[雅尔·里奥特]";
	mes "属性也称为“Stats”，";
	mes "是构成角色的基础。";
	next;
			mes "[雅尔·里奥特]";
	mes "我很乐意帮助你了解属性，所以如果对角色属性有疑问，";
	mes "尽管来问我。";
	next;
			mes "[雅尔·里奥特]";
	mes "在仙境传说中，";
	mes "角色属性包括力量、敏捷、体质、智力、灵巧和幸运。";
	next;
			mes "[雅尔·里奥特]";
	mes "我会按照你的需求继续讲解，";
	mes "请询问你想进一步了解的属性。首先按“^3355FFAlt^000000 + ^3355FFA^000000”打开属性窗口。";
	next;
	while(1) {
		switch(select("力量与敏捷:体质与智力:灵巧与幸运:我不想继续。")) {
		case 1:
			mes "[雅尔·里奥特]";
			mes "先来说明力量。";
			mes "^4D4DFFStrength (STR)^000000 increases";
			mes "^4D4DFF物理攻击伤害（ATK）^000000";
			mes "以及你的 ^4D4DFF最大负重上限^000000。";
			next;
			mes "[雅尔·里奥特]";
			mes "1 点 STR 会使物理攻击伤害增加 1 点。当 STR 提升到 10 的倍数时，还会获得一定的攻击伤害加成。";
			next;
			mes "[雅尔·里奥特]";
			mes "攻击伤害加成的计算方法是：去掉力量总值的最后一位，再将剩余数字平方。";
			next;
			mes "[雅尔·里奥特]";
			mes "假设攻击显示为“48 + 1”，力量总值就是 49。去掉最后一位“9”后剩下“4”，4 乘以自身等于 16。";
			next;
			mes "[雅尔·里奥特]";
			mes "所以物理攻击加成为 16。如果 STR 总值为 50，攻击加成为 25；STR 为 100 时，攻击加成为 100。";
			next;
			mes "[雅尔·里奥特]";
			mes "好，现在来讲";
			mes "敏捷（AGI）。";
			mes "敏捷会影响闪避率和攻击速度。闪避率越高，躲开敌人攻击的机会越大。";
			next;
			mes "[雅尔·里奥特]";
			mes "你的闪避率";
			mes "等于你的基础等级";
			mes "加上";
			mes "AGI。";
			next;
			mes "[雅尔·里奥特]";
			mes "如果 AGI 为 40、基础等级为 30，闪避率就是 70。很简单吧！按照闪避率公式，你的闪避率总值为 70。";
			next;
			mes "[雅尔·里奥特]";
			mes "AGI 只影响普通闪避率。完全回避也是决定能否躲开攻击的因素之一，不过我们讲到";
			mes "LUK 属性时再说明。";
			next;
			mes "[雅尔·里奥特]";
			mes "提高 AGI 的另一个好处是攻击速度（ASPD）也会提高，也就是近战攻击之间的间隔会缩短。";
			next;
			mes "[雅尔·里奥特]";
			mes "不过，ASPD";
			mes "会因职业而异，";
			mes "请记住这一点。";
			next;
			mes "[雅尔·里奥特]";
			mes "^666666*Whew!*^000000";
			mes "一天之内接收这么多内容";
			mes "真是令人兴奋。";
			mes "我们要不要";
			mes "进入下一个主题？";
			next;
			break;
		case 2:
			mes "[雅尔·里奥特]";
			mes "下一个主题是";
			mes "体质（VIT）";
			mes "和智力（INT）。";
			next;
			mes "[雅尔·里奥特]";
			mes "^4D4DFF体质^000000影响^4D4DFF最大 HP、HP 恢复量和防御^000000。VIT 增加的 HP 量会因职业而异。";
			next;
			mes "[雅尔·里奥特]";
			mes "在所有职业中，剑士系职业";
			mes "从提高 VIT 中获得的收益最大。";
			next;
			mes "[雅尔·里奥特]";
			mes "来看看防御。";
			mes "属性窗口中，防御显示为 DEF。这里有两个数值，第二个数值代表 VIT 带来的防御加成。";
			next;
			mes "[雅尔·里奥特]";
			mes "第一个显示的";
			mes "防御数值，是由装备和护甲计算出的防御。";
			next;
			mes "[雅尔·里奥特]";
			mes "你穿戴的装备会按总伤害的百分比减少敌人伤害，而 VIT 则减少固定数值。这就是防御显示为两个数值的原因。";
			next;
			mes "[雅尔·里奥特]";
			mes "下一个主题";
			mes "是智力（INT）。";
			next;
			mes "[雅尔·里奥特]";
			mes "INT 影响^4D4DFF最大 SP^000000、^4D4DFFSP 恢复量^000000、^4D4DFF魔法攻击伤害（MATK）^000000以及^4D4DFF魔法防御（MDEF）^000000。";
			next;
			mes "[雅尔·里奥特]";
			mes "1 点 INT 增加的 SP 和 MATK";
			mes "和 VIT 一样取决于职业。这意味着有些职业天生比其他职业更能从高 INT 中获益。";
			next;
			mes "[雅尔·里奥特]";
			mes "和普通 DEF 一样，魔法防御（MDEF）也显示为两个不同数值。INT 带来的 MDEF 是第二个显示的 MDEF 数值。";
			next;
			mes "[雅尔·里奥特]";
			mes "想研究自然元素的操控，就应优先提升智力。因此贤者和巫师";
			mes "会专注于 INT 属性。";
			next;
			break;
		case 3:
			mes "[雅尔·里奥特]";
			mes "最后一个主题";
			mes "是灵巧（DEX）";
			mes "和幸运（LUK）。";
			next;
			mes "[雅尔·里奥特]";
			mes "灵巧主要影响命中率、攻击速度（ASPD）";
			mes "以及平均攻击力。";
			next;
			mes "[雅尔·里奥特]";
			mes "让我解释一下……";
			mes "DEX 较低时，最小伤害和";
			mes "最大伤害之间的差距会变得很大，攻击伤害也会不稳定。";
			next;
			mes "[雅尔·里奥特]";
			mes "如果使用^4D4DFF弓^000000作为";
			mes "主要武器，攻击力会基于^4D4DFFDEX^000000。因此弓箭手应专注提升 DEX。";
			next;
			mes "[雅尔·里奥特]";
			mes "DEX 的数值";
			mes "也会影响攻击命中率。命中率由基础等级加上 DEX 计算。";
			next;
			mes "[雅尔·里奥特]";
			mes "例如，基础等级为 40、DEX 为 20 时，";
			mes "你的攻击命中率";
			mes "就是 60。";
			next;
			mes "[雅尔·里奥特]";
			mes "最后，DEX 还会缩短法术和技能的吟唱时间。因此，拥有一定 DEX";
			mes "对法师和巫师很有帮助。";
			next;
			mes "[雅尔·里奥特]";
			mes "现在来告诉你";
			mes "LUK 属性。";
			next;
			mes "[雅尔·里奥特]";
			mes "幸运（LUK）影响";
			mes "暴击概率、闪避率以及对怪物造成的少量伤害。";
			next;
			mes "[雅尔·里奥特]";
			mes "每个人的暴击初始值都是 1，每 3 点 ^4d4dffLUK^000000 会增加 ^4d4dff1^000000 点。";
			next;
			mes "[雅尔·里奥特]";
			mes "LUK 越高，对敌人发动^3355FF暴击^000000的机会越大。暴击可以穿透敌人的防御，对你很有帮助。";
			next;
			mes "[雅尔·里奥特]";
			mes "攻击造成的伤害高于平常，且伤害数字带有爆炸般的红色特效时，就说明发动了暴击。";
			next;
			mes "[雅尔·里奥特]";
			mes "每 10 点 LUK 会增加 1 点完全回避率。完全回避有点像闪避率。成功完全回避时，头顶会出现“^FF7F00Lucky^000000”。";
			next;
			mes "[雅尔·里奥特]";
			mes "完全回避虽然类似闪避率，但它是独立的攻击回避因素，计算方式也不同。";
			next;
			mes "[雅尔·里奥特]";
			mes "我得说，";
			mes "幸运当然很好，但不代表它比其他属性都更优先。";
			next;
			break;
		case 4:
			mes "[雅尔·里奥特]";
			mes "还有其他";
			mes "问题吗？";
			mes "希望我的课程";
			mes "对你有所帮助。";
			close;
		}
	}
}

new_1-2,184,172,1	script	Understandings of Skills	47,{
						mes "[Leo Handerson]";
//
//
//
	mes "欢迎～";
	mes "看看这个";
	mes "可爱的小初心者～！";
	next;
	mes "[Leo Handerson]";
	mes "我叫里奥·汉德森，";
	mes "我会对你的表现负责，并尽我所能教导你。现在请选择想学习的主题。";
	emotion ET_CHUP;
	next;
	while(1) {
		switch(select("被动与主动技能:基本技能:使用表情符号:取消。")) {
		case 1:
			mes "[Leo Handerson]";
			mes "首先，我来说明";
			mes "被动技能。";
			mes "请打开";
			mes "技能窗口，好吗？";

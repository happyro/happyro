S_UserJobchoice:
	mes "[汉森]";
	mes "我明白，这是你的选择。";
	mes "不必转职为我们推荐的职业，请选择你想成为的职业。";
	next;
	select( "剑士:法师:商人:盗贼:弓箭手:服事" );
	// @menu is already set by Core.
	setarray .@Jobs$[1],"剑士","法师","商人","盗贼","弓箭手","服事";

	mes "[汉森]";
	mes "你选择成为";
	if (@menu == 1) {
		mes "剑士。";
		mes "你将被送往";
		mes "伊兹鲁德城。";
		next;
		mes "[汉森]";
		mes "剑士协会位于伊兹鲁德西北方，请记住。";
	}
	else if (@menu == 2) {
		mes "法师。";
		mes "你将被送往";
		mes "吉芬城。";
		next;
		mes "[汉森]";
		mes "法师学院位于城镇西北方，请记住。";
	}
	else if (@menu == 3) {					
		mes "商人。";
		mes "你将被送往";
		mes "艾尔贝塔城。";
	}
	else if (@menu == 4) {
		mes "盗贼。";
		mes "你将被送往";
		mes "梦罗克城。";
		next;
		mes "[汉森]";
		mes "盗贼公会位于城镇西北方金字塔的地下 1 楼，请记住。";
	}
	else if (@menu == 5) {
		mes "弓箭手。";
		mes "你将被送往";
		mes "斐扬城。";
		next;
		mes "[汉森]";
		mes "弓箭手公会位于斐扬西北方，请记住。";
	}
	else {
		mes "服事。";
		mes "你将被送往";
		mes "普隆德拉城。";
		next;
		mes "[汉森]";
		mes "普隆德拉圣堂位于城镇东北方，请记住。";
	}
	next;
	mes "[汉森]";
	mes "让我给你";
	mes "一些物资，然后";
	mes "把你传送到";
	mes "选定的城镇。";
	next;
	mes "^660000补给清单^000000";
	mes "^0000335 卡普拉仓库免费券^000000";
	mes "^0000335 卡普拉传送免费券^000000";
	mes "^0000331 冒险家服^000000";
	////mes "^000099100 Zeny^000000";
	next;
	//------------------------------------------------------------------------------------------------------------------------------------------------------------------------
	set nov_3_swordman,40;
	getitem 7059,5; //Cargo_Free_Ticket
	getitem 7060,5; //Warp_Free_Ticket
	getitem 2305,1; //Adventure_Suit
	////getgold 100
	//------------------------------------------------------------------------------------------------------------------------------------------------------------------------
	mes "[汉森]";
	mes "请检查背包，";
	mes "确认是否收到了清单上的全部物资。我简单说明一下收到的物品。";
	next;
	mes "[汉森]";
	mes "卡普拉仓库和传送免费券可用于仓库及传送服务。";
	next;
	mes "[汉森]";
	mes "‘Zeny’是米德加尔特的货币。成为 " + .@Jobs$[@menu] + ".";
	next;
	mes "[汉森]";
	mes "现在你将";
	mes "被传送。";
	mes "祝你好运，";
	mes "^A62A2A" + strcharinfo(0) + "^000000";
	mes "再见。";
	next;
	set nov_1st_cos,0;
	set nov_2nd_cos,0;
	set nov_3_swordman,0;
	set nov_3_archer,0;
	set nov_3_thief,0;
	set nov_3_magician,0;
	set nov_3_acolyte,0;
	set nov_3_merchant,0;
	if(@menu == 1) {
		savepoint "izlude",93,104,1,1;
		warp "izlude_in",74,167;
	}
	else if (@menu == 2) {
		savepoint "geffen",119,37,1,1;
		warp "geffen_in",163,98;
	}
	else if (@menu == 3) {
		savepoint "alberta",30,232,1,1;
		warp "alberta_in",62,44;
	}
	else if (@menu == 4) {
		savepoint "morocc",150,99,1,1;
		warp "moc_ruins",155,44;
	}
	else if (@menu == 5) {
		savepoint "payon",70,100,1,1;
		warp "payon_in02",64,65;
	}
	else {
		savepoint "prontera",117,72,1,1;
		warp "prt_church",172,19;
	}
	return;
}

//Novice Instructor
new_1-4,91,22,4	script	Bruce#nv	57,{
	if (Class == Job_Novice) {
		if (nov_3_swordman == 20) {
			mes "[Bruce]";
			mes "让我再次说明";
			mes "一转职业，";
			mes "给你。";
			mes "你想成为";
			mes "什么职业？";
			next;
			while(1) {
				switch(select("剑士:法师:弓箭手:商人:盗贼:服事:结束对话。")) {

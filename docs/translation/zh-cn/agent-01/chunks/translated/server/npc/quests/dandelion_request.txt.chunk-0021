que_job01,68,88,5	script	Simon#mao	881,{
	mes "[西蒙]";
	mes "……不。我还要";
	mes "说多少次？";
	mes "我不会回去。";
	emotion ET_SWEAT, getnpcid(0, "Simon#mao");
	next;
	mes "[金米]";
	mes "求你……";
	mes "我们真的需要";
	mes "你回家……";
	emotion ET_CRY, getnpcid(0, "Kimmie");
	next;
	mes "[西蒙]";
	mes "对不起，金米。";
	mes "我必须走自己的";
	mes "路。没有我你也能";
	mes "过得下去。";
	mes "况且你很坚强，";
	mes "其实并不需要我……";
	next;
	mes "[金米]";
	mes "你、你不能这样！";
	mes "你为什么离开我们？";
	mes "我、我本来不想告诉你，";
	mes "但吉米一直在惹";
	mes "法律上的麻烦，而且……";
	emotion ET_KEK, getnpcid(0, "Kimmie");
	next;
	mes "[西蒙]";
	mes "那是他自己的";
	mes "错。我不在乎，我";
	mes "还是不会回家……";
	mes "在考虑照顾别人之前，";
	mes "我得先对自己负责。";
	mes "";
	next;
	mes "[金米]";
	mes "闭嘴！闭嘴！";
	mes "回到我们身边来！";
	next;
	mes "["+ strcharinfo(0) +"]";
	mes "我完全不知道发生了什么，";
	mes "但事情似乎很糟。";
	mes "有时不介入别人的问题";
	mes "反而是件好事。";
	close;
	}

que_job01,70,84,1	duplicate(Simon#mao)	Kimmie	882

sec_in02,38,162,0	script	Morocc Invasion Manager	882,{
callfunc "F_GM_NPC";
	mes "共有 " + $maoattack + " 名玩家完成了";
	mes "撒旦梦罗克：琳任务。";
	mes "召唤撒旦梦罗克部队需要";
	mes "满足 2 个条件。";
	mes "1）必须有 50 名玩家完成";
	mes "撒旦梦罗克：琳任务。";
	next;
	mes "2）完成琳任务的玩家中，至少一人";
	mes "必须前往蒲公英组织在梦罗克郊外的";
	mes "NPC，才能触发怪物入侵。";
	mes "要修改全局变量来改变撒旦梦罗克入侵状态吗？";
	next;
	switch( select( "设置全局变量", "取消" ) )
	{
	case 1:
	mes "请选择琳任务在服务器上";
		mes "被记录为完成的";
			mes "次数。0 相当于重置；50 会立即";
			mes "开放入侵。";
			next;
			switch( select( "49","50","0" ) )
			{
			case 1:
			mes "全局变量已设置为 49。";
			mes "撒旦梦罗克入侵触发前，";
			mes "琳任务还必须再完成 1 次。";
				set $maoattack,49;
					close;
					
					case 2:
					mes "全局变量已设置为 50。";
					mes "现在可以触发撒旦梦罗克入侵。";
					set $maoattack,50;
					close;

				case 3:
					mes "全局变量已设置为 0。";
					mes "撒旦梦罗克入侵触发前，";
					mes "琳任务还必须再完成 1 次。";
					set $maoattack,0;
					close;
				}
				
					case 2:
					mes "你已取消。";
					close;
					}
					}
					//
					//
			//
//
		//
			//
			//
	//
//

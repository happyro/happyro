			gef_tower,115,36,4	script	Meow#q_wiz	876,{
			if (BaseJob == Job_Wizard) {
			if (WIZ_SK == 100) {
			if (getskilllv("WZ_SIGHTBLASTER") == 0) {
			mes "[Meow]";
			mes "什么……？！你忘了我教的";
			mes "厉害技能？";
			mes "转生可不是忘记的借口！";
			mes "好吧，你想让我教你？";
			mes "好，这是你的课！";
			next;
			mes "^3355FF*BAM! BOOM! CRASH!*^000000";
			specialeffect2 EF_SUI_EXPLOSION;
			next;
			mes "[Meow]";
				mes "别因为转生了";
				mes "就对我摆架子！";
				mes "在我再揍你一顿前，";
				mes "最好记住这个技能怎么用！";
				next;
				mes "^3355FF你奇迹般想起了";
				mes "视界爆破技能，赶在";
				mes "喵再狠狠揍你之前。";
			specialeffect2 EF_ABSORBSPIRITS;
			skill "WZ_SIGHTBLASTER",1,SKILL_PERM;
			next;
			mes "[Meow]";
			mes "记住了吗？";
			mes "很好。现在我要回去睡觉。";
			mes "你敢打扰我，我就让你后悔。";
			close;
			}
			else {
			mes "[Meow]";
			mes "呼……呼……";
			mes "凯瑟琳……我会让你后悔";
			mes "把我变成小猫……";
			mes "我要……要……呼……";
			close;
			}
			}
			else if (WIZ_SK == 0) {
			mes "[Meow]";
			mes "*哈欠~*";
			mes "好困……";
			mes "嗯？你想和我说话？";
			mes "没事就别打扰我！";
			next;
			if (select("一只猫？:我也困了……") == 1) {
			mes "[Meow]";
			mes "是的，是的，我是猫。";
			mes "至少现在是。该死的凯瑟琳！";
			mes "我没经过她同意借了宝石，";
			mes "她就把我变成这样。";
			mes "我本来要告诉她的！";
			next;
			mes "[Meow]";
			mes "等我变回人类并恢复力量，";
			mes "我要彻底发疯。凯瑟琳、你，还有所有人，";
			mes "你们都会变成猫！";
			close;
			}
			mes "[Meow]";
			mes "哈！对……";
			mes "睡一觉听起来是";
			mes "我听过最好的主意——哦。";
			mes "等等，你是魔法师，对吧？";
			mes "我太困了，竟然没注意。";
			mes "啊，这下好了~";
			next;
			mes "[Meow]";
			mes "现在我要代表魔法师公会";
			mes "教魔法师这项新技能。";
			mes "虽然我不太想教，";
			mes "但基本没得选择。你觉得呢？";
			next;
			if (select("不了，我太困了……:好的，我想学新技能。") == 1) {
			mes "[Meow]";
			mes "^333333*哈欠*^000000";
			mes "好吧。以后想学就回来";
			mes "提醒我这项技能。";
			mes "那么，继续睡觉……呼……呼……";
			close;
			}
			mes "[Meow]";
		mes "真的吗？好吧，好吧。";
		mes "先说好，我教这项技能只是为了";
			mes "让凯瑟琳把我变回人类。";
			mes "一直当猫太丢脸了！";
			next;
			mes "[Meow]";
			mes "等等，现在想想，";
			mes "那只狗玛丽亚有";
			mes "一直缠着凯瑟琳，但她";
		mes "始终没能恢复人形。";
		mes "不！我现在不能失去希望！";
			next;
			mes "[Meow]";
			mes "哦，赶紧结束吧。你知道魔法师";
			mes "远程攻击很强，但";
			mes "近战很弱，对吧？";
			next;
			mes "[Meow]";
			mes "我要教你的新技能";
			mes "正是为了弥补魔法师";
			mes "近战能力的弱点。首先，";
			mes "你要吟唱法术……";
			next;
			mes "[Meow]";
			mes "之后在技能持续期间，";
			mes "护盾会击退并伤害靠近的敌人。";
			mes "在激烈战斗中很有用吧？";
			next;
			select("我能击退敌人？");
			mes "[Meow]";
			mes "当然可以，学会技能后就行。";
			mes "不过在学习前，你得理解";
			mes "击退理论。嗯，可能需要";
			mes "更详细的解释……";
			next;
			mes "[Meow]";
			mes "你知道吗？骑士很擅长";
			mes "击退敌人的技能，去普隆德拉";
			mes "找一位骑士给你解释击退理论吧。";
			next;
			mes "[Meow]";
		mes "查看普隆德拉小地图的 11 点方向，";
		mes "那里有骑士团。应该有人愿意";
			mes "教你更多技能击退知识……";
				set WIZ_SK,1;
				close;
				}
				else if (WIZ_SK == 1) {
				mes "[Meow]";
				mes "你还在这里做什么？";
				mes "不是让你去普隆德拉骑士团";
				mes "找人教击退理论了吗？";
				close;
				}
				else if (WIZ_SK == 2) {
				mes "[Meow]";
				mes "嗯？很好，你学会了";
				mes "击退敌人的基础。现在差不多";
				mes "可以学习我教你的技能了。";
				next;
				mes "[Meow]";
				mes "我可不是慈善家，";
				mes "教学和努力要收学费！";
				mes "嗯，收什么好呢？啊，我正缺";
				mes "附魔石~";
			next;
			mes "[Meow]";
			mes "去带来";
			mes "^FF000010 个水晶蓝^000000、^FF000010 个绿色生命^000000、";
			mes "^FF000010 个红色血液^000000和^FF000010 个绿风^000000。";
			next;
			mes "[Meow]";
			mes "数量不多，别抱怨，";
			mes "尽快回来。你外出时，";
			mes "我要再睡一觉~";
			set WIZ_SK,3;
			close;
			}
			else if (WIZ_SK == 3) {
			if (countitem(991) < 10 || countitem(993) < 10 || countitem(990) < 10 || countitem(992) < 10) {
			mes "[Meow]";
			mes "^333333*Yaaaaaawn~*^000000 Hm?";
			mes "你、你怎么敢回来";
			mes "没带齐我要求的东西就回来？";
			mes "你忘了该带什么，";
			mes "对吧？呜呜……";
			next;
			mes "[Meow]";
			mes "我说过要带来";
			mes "^ff000010 Crystal Blues^000000,";
			mes "^ff000010 Green Lives^000000,";
		mes "^ff000010 个红色血液^000000和";
			mes "^ff000010 风之繁茂^000000！";
			next;
			mes "[Meow]";
			mes "这次别忘了！";
			mes "没找到我要求的全部东西前，";
			mes "别想叫醒我！";
			close;
			}
			mes "[Meow]";
			mes "*Yaaaawn~* Wh-wha?";
			mes "哦，是你。带来我想要的石头了吗？";
			mes "嗯，很好，让我看看是否齐全……";
			mes "一、二、三……";
			next;
			mes "[Meow]";
			mes ".................";
			mes "算了，我不想数了。";
			mes "让我拿走这些，教你技能，";
			mes "这样我就能回去睡觉。";
			next;
			mes "[Meow]";
			mes "这项技能叫作";
			mes "‘^FF0000视界爆破^000000’。很酷吧？";
			mes "这是火属性技能，必须先施放视界";
			mes "才能发动。现在试试。";
			next;
			specialeffect2 EF_SUI_EXPLOSION;
			mes "^3355FF*BAM! BOOM!*^000000";
			next;
			mes "[Meow]";
			mes "......";
			mes "嗯。不完全正确，";
			mes "但第一次尝试还不错。";
			mes "记住要用意志发动击退。";
			mes "呃，再试一次，好吗？";
			next;
			mes "[Meow]";
			mes "你必须用意志！";
		mes "用你的意识";
		mes "推动！";
			mes "用意识推动你用视界召唤的火焰。";
			mes "没那么难！";
			next;
			mes "[Meow]";
			mes "终于……！";
			mes "你真的学会了！";
			mes "费了太多力气，";
		mes "不过至少完成了。";
	specialeffect2 EF_ABSORBSPIRITS;
	delitem 991,10; //Crystal_Blue
		delitem 993,10; //Yellow_Live
		delitem 990,10; //Boody_Red
		delitem 992,10; //Wind_Of_Verdure
		set WIZ_SK,100;
		skill "WZ_SIGHTBLASTER",1,SKILL_PERM;
		next;
		mes "[Meow]";
		mes "教这么多让我好累。";
		mes "我现在要好好睡一觉。";
			mes "你走吧，如果认识其他魔法师，";
			mes "就把他们带来找我。";
			close;
			}
			else {
			mes "[Meow]";
			mes "呼……呼……";
			mes "凯瑟琳……我会让你后悔";
			mes "把我变成小猫……";
			mes "我要……要……呼……";
			close;
			}
			}
			else {
			mes "[Meow]";
		mes "*哈欠~*";
		mes "好困……";
		mes "嗯？你想和我说话？";
		mes "没事就别打扰我！";
		next;
		if (select("一只猫？:我也困了……") == 1) {
		mes "[Meow]";
		mes "是的，是的，我是猫。";
		mes "至少现在是。该死的凯瑟琳！";
	mes "我没经过她同意借了宝石，";
mes "她就把我变成这样。";
mes "我本来要告诉她的！";
next;
	mes "[Meow]";
		mes "等我变回人类并恢复力量，";
		mes "我要彻底发疯。凯瑟琳、你，还有所有人，";
		mes "你们都会变成猫！";
		close;
		}
		mes "[Meow]";
		mes "哈！对……";
		mes "睡一觉听起来是";
		mes "今天听过最好的主意。嗯。^333333*哈欠~*^000000";
			mes "好了，该睡觉了……";
			mes "呼呼呼……呼……";
			close;
			}
			}
			
			prt_in,82,98,3	script	Simon Mayace#q_wiz	46,{
		if (WIZ_SK == 1) {
		mes "[Simon]";
		mes "啊，你一定是熟练的";
		mes "魔法使用者。嗯，";
		mes "你一定是魔法师。";
		mes "大法师？我分不太清。";
		mes "啊，我能帮你吗？";
		next;
		if (select("我很好，谢谢。:我想了解击退。") == 1) {
		mes "[Simon]";
		mes "我很惊讶你选择练习魔法。";
		mes "从你的体格来看，";
		mes "我觉得你很适合挥剑。";
		mes "哈哈，这只是骑士的谦见。";
		close;
		}
		mes "[Simon]";
		mes "等等，你是要我教你";
		mes "击退攻击技巧？你可以用";
		mes "火墙或火箭之类的法术";
		mes "更有效地防御自己，对吧？";
		next;
		select("但是近距离……");
		mes "[Simon]";
		mes "哦，我明白了。魔法师在近距离";
		mes "战斗中确实不太有效。";
		mes "好，我理解你想学习击退技巧。";
		mes "我可以教你一些基础。";
		next;
		mes "[Simon]";
		mes "每个冒险者都知道攻击基础。";
		mes "你发动攻击，然后准备下一步行动：";
		mes "再次攻击、闪避或防御。很简单，对吧？";
		next;
		mes "[Simon]";
		mes "要击退敌人，必须用持续力量";
		mes "发动攻击。关键在于后续动作。";
		mes "如果攻击头部，击退距离";
		mes "会太短。";
		next;
		mes "[Simon]";
		mes "如果攻击腿部，敌人会";
		mes "朝你这边倒下。";
		mes "击退攻击的最佳目标是躯干，";
		mes "因为更容易控制击退方向。";
		next;
		mes "[Simon]";
		mes "好了，我尽力解释了击退。";
		mes "自己集中精神练习理论，";
		mes "应该就能做到。旅途好运，冒险者~";
	set WIZ_SK,2;
	close;
		}
		else {
		mes "[Simon]";
		mes "别搞错了：剑术是一门艺术。";
		mes "这些技巧乍看很粗暴，";
		mes "但其中有骑士天生理解的";
		mes "精妙策略。";
		close;
	}
}


dic_dun01,274,114,0	script	Stacked Boxes of Goods	844,{
	if (checkweight(1201,1) == 0 || MaxWeight - Weight < 1000) {
		mes "- 你携带的物品太多，无法进行此任务。 -";
		close;
	}
	set .@playtime, checkquest(7208,PLAYTIME);
	if (.@playtime == 0 || .@playtime == 1) {
		mes "装满各种货物的箱子堆到了天花板。";
		mes "切谢尔提到的那个标记箱子似乎还没到这里。";
		close;
	} else if (.@playtime == 2) {
		mes "装满各种货物的箱子堆到了天花板。";
		mes "仔细一看，你发现一个箱子上贴着一小张纸。";
		mes "你找到了切谢尔提到的货物箱。";
		next;
		switch(select("搬动箱子。:放弃。")) {
		case 1:
			mes "你答应把布拉迪姆箱子带给切谢尔，他会在彩虹桥裂缝附近等你。";
			erasequest 7208;
			setquest 7210;
			getitem 6392,1; //Bradium_Box
			close;
		case 2:
			mes "你决定放弃运送箱子。";
			mes "你把箱子留在原处。";
			erasequest 7208;
			close;
		}
	} else {
		if (checkquest(7207) == -1) {
			if (checkquest(7206) > -1) {
				mes "装满各种货物的箱子堆到了天花板。";
				mes "仔细一看，你发现一个箱子上贴着一小张纸。";
				next;
				mes "纸上画着神秘符号，下面用小字写着^4d4dff目的地：彩虹桥裂缝^000000。";
				next;
				mes "这一定是切谢尔提到的箱子。";
				mes "你决定把它带到纸上所写的地点。";
				completequest 7206;
				setquest 7207;
				getitem 6392,1; //Bradium_Box
				close;
			}
		} else if (checkquest(7207) < 2) {
			mes "你已经拿到了切谢尔提到的箱子。";
			mes "现在只要把它带到彩虹桥裂缝即可。";
			close;
		}
		mes "装满各种货物的箱子堆到了天花板。";
		close;
	}
	end;
}

bif_fild01,335,168,3	script	Cheshire#ep14_1_xq04	497,{
	if (checkweight(1201,1) == 0 || MaxWeight - Weight < 1000) {
		mes "- 你携带的物品太多，无法进行此任务。 -";
		close;
	}
	cutin "ep13_cheshire",1;
	if (checkquest(7209) > -1) {
		if (countitem(6090) < 20) {
			mes "[Cheshire]";
			mes "带给我 20 个精炼布拉迪姆。";
			mes "这是你粗心又不负责任地卖给别人的箱子的交换条件。";
			mes "我说清楚了吗？！";
			close2;
			cutin "",255;
			end;
		}
		mes "[Cheshire]";
		mes "所以你带来了？";
		mes "数量比原来少，但我也没办法。";
		mes "下次一定要把完整的箱子带给我。";
		next;
		mes "- 切谢尔把布拉迪姆扔进了裂缝。 -";
		next;
		mes "[Cheshire]";
		mes "你犯错弄丢了箱子，只能接受这个结果。";
		mes "从明天开始，把完整的箱子带到这里。";
		mes "每天都要。";
		delitem 6090,20; //Purified_Bradium
		erasequest 7209;
		setquest 7208;
		getitem 6304,1; //Sapa_Feat_Cert
		close2;
		cutin "",255;
		end;
	}
	callsub L_CheckPlaytime;
	if (checkquest(7210) > -1) {
		if (countitem(6392) == 0)
			callsub L_LostQuest,7210;
		else {
			mes "[Cheshire]";
			mes "你来得正是时候。";
			mes "而且箱子完好无损！";
			mes "做得好。";
			next;
			mes "[Cheshire]";
			mes "那么明天也拜托你了。";
			mes "明白吗？";
			mes "现在趁拉斐尔起疑之前离开这里。";
			erasequest 7210;
			setquest 7208;
			delitem 6392,1; //Bradium_Box
			getitem 6304,1; //Sapa_Feat_Cert
			getexp 50000,40000;
			close2;
			cutin "",255;
			end;
		}
	}
	if (ep13_3_secret > 22) {
		if (checkquest(7207) == -1) {
			if (checkquest(7206) == -1) {
				mes "[Cheshire]";
			mes "……嗯？咦？";
			mes "是"+strcharinfo(0)+"！";
			mes "你在这里做什么？";
				next;
			select("咦？切谢尔？");
				mes "[Cheshire]";
			mes "你为什么这么惊讶？";
			mes "看到我在这里很意外吗？";
				next;
			select("没什么，只是那个兜帽……");
				mes "[Cheshire]";
			mes "哦……这个。因为它很碍事。";
			mes "而且在这里，我不用在意其他人。";
			mes "哦，见到你很高兴！";
			mes "你来到迪尔时，我本来打算让你工作。";
				next;
				mes "[Cheshire]";
			mes "……什么？你为什么那样盯着我？";
			mes "这一切都是为了阿哈特。";
				next;
				switch(select("看来我别无选择。:我还有很多事要做！")) {
				case 1:
					mes "["+strcharinfo(0)+"]";
				mes "（如果拒绝，他会起疑……看来暂时只能配合。）";
				mes "好吧。";
				mes "为了让阿哈特高兴，我什么都愿意做。";
				mes "那么，你需要我做什么？";
					next;
					break;
				case 2:
					mes "[Cheshire]";
				mes "有事要做？";
				mes "什么事？";
				mes "这就是你必须做的事之一。";
				mes "别忘了你效忠于阿哈特。";
					next;
					break;
				}
				mes "[Cheshire]";
			mes "很好！现在我告诉你要做什么。";
			mes "你知道卡米达尔隧道中间有通往蚂蚁洞的入口吗？";
			mes "那里附近有卖补给品和简单工具的猫咪商队。";
				next;
				mes "[Cheshire]";
			mes "堆放的货物中有一个做了标记的箱子。";
			mes "我想让你把箱子带给我。";
				next;
				mes "[Cheshire]";
			mes "只是取来并运送一个箱子，很简单。";
			mes "要^4d4dff迅速而安静地完成，不要被发现^000000。";
				setquest 7206;
				next;
				mes "[Cheshire]";
			mes "现在，快去！";
				close2;
				cutin "",255;
				end;
			} else {
				mes "[Cheshire]";
			mes "从卡米达尔隧道带回箱子。";
			mes "要快，要安静！";
			mes "别磨蹭，快行动！";
				close2;
				cutin "",255;
				end;
			}
		} else if (checkquest(7207) < 2) {
			if (countitem(6392) == 0)
				callsub L_LostQuest,7207;
			else {
				mes "[Cheshire]";
			mes "……就是那个箱子！";
			mes "哦，对了，就是它！";
			mes "你做得很好。";
			mes "这非常重要。";
			mes "阿哈特会很高兴。";
				next;
				mes "[Cheshire]";
			mes "箱子每天都会放在同一个地方。";
			mes "这项工作就交给你了。";
				next;
			select("你为什么不自己做？");
				mes "[Cheshire]";
			mes "……嗯……";
			mes "只有你们人类可以自由进入任何地方。";
			mes "而且这里是拉斐尔的领地。";
				next;
				mes "[Cheshire]";
			mes "我这个样子不太会引起他们的注意，";
				mes "但萨帕人会怎么想？";
				mes "要在拉斐内领地见阿哈特的人吗？";
				next;
				mes "[Cheshire]";
				mes "他们会起疑心的。";
				mes "但你们人类没有这种烦恼，所以你最适合做这件事。";
				next;
				mes "["+strcharinfo(0)+"]";
				mes "（……我不相信他的说法，但他以为我站在他那边，所以我还是配合一下吧。）";
				mes "那么，这块布拉迪姆要怎么办？";
				next;
				mes "[Cheshire]";
				mes "那个东西？";
				mes "把它交给我。";
				next;
				mes "- 切舍尔打开箱子，检查里面的布拉迪姆，将它们扔进裂缝，";
				mes "然后回头拍了拍手，脸上露出胜利的表情。-";
				next;
				mes "[Cheshire]";
				mes "事情就是这样。";
				mes "*笑* 裂缝的另一边有一条你未知的道路。";
				next;
				mes "[Cheshire]";
				mes "好吧，这件事就交给你了。";
				mes "尽量每天把箱子带给我。";
				mes "Okay?";
				delitem 6392,1; //Bradium_Box
				completequest 7207;
				setquest 7208;
				getitem 6304,1; //Sapa_Feat_Cert
				getexp 50000,40000;
				next;
				mes "[Cheshire]";
				mes "作为你努力的报酬，我会给你一张萨帕功绩证明和一些现金。";
				mes "现在趁拉斐内人起疑之前离开这里。";
				close2;
				cutin "",255;
				end;
			}
		} else {
			callsub L_CheckPlaytime;
			mes "[Cheshire]";
			mes "嗯？怎么了？";
			mes "你今天没把箱子带来？";
			next;
			mes "[Cheshire]";
			mes "嗯，这出乎意料……";
			mes "好吧，那我也没有办法。";
			mes "今天就让另一个人来做吧。";
			mes "但从明天开始你必须完成，明白吗？";
			setquest 7208;
			close2;
			cutin "",255;
			end;
		}
	} else if (ep13_3_secret > 15) {
		mes "[Cheshire]";
		mes "……嗯？我好像在哪里见过你……";
		mes "..........Oh!";
		mes strcharinfo(0)+"...?!";
		mes "你来这里做什么？";
		next;
		mes "[Cheshire]";
		mes "你说你忘了要做什么？";
		mes "你不该在这里。";
		mes "你应该在迪卡斯特斯南边的裂缝那里。";
		next;
		mes "[Cheshire]";
		mes "Whoa.";
		mes "阿哈特派这种笨蛋来找我时到底在想什么？";
		mes "现在快去完成你的工作。";
		close2;
		cutin "",255;
		end;
	}
	mes "[Cheshire]";
	mes "……这个人为什么还没出现？";
	mes "现在应该已经到这里了……";
	mes "也许迷路了……？";
	mes "……？嗯？你、你是谁？你站在这里多久了？";
	next;
	select("猫？！");
	mes "[Cheshire]";
	mes "谁……谁是猫？！";
	mes "滚开！";
	close2;
	cutin "",255;
	end;
L_LostQuest:
	mes "[Cheshire]";
	mes "哦，你去过那里了？";
	mes "箱子怎么了？";
	mes "你怎么空手回来？";
	next;
	switch(select("我再去找！:我把它弄丢了……")) {
	case 1:
		mes "[Cheshire]";
		mes "一定要做好！";
		mes "继续找它。";
		mes "绝对不能再弄丢。";
		break;
	case 2:
		mes "[Cheshire]";
		mes "在哪里？";
		mes "你把它卖给哪个商人了？";
		mes "你分不清什么该卖、什么不该卖吗？";
		mes "做交易时睡着了吗？";
		next;
		mes "[Cheshire]";
		mes "简直荒唐透顶。";
		mes "赔偿你弄丢的东西！";
		mes "^4d4dff20 个精炼布拉迪姆^000000！！！";
		erasequest getarg(0);
		setquest 7209;
		break;
	}
	close2;
	cutin "",255;
	end;
L_CheckPlaytime:
	set .@playtime, checkquest(7208,PLAYTIME);
	if (.@playtime == 0 || .@playtime == 1) {
		mes "[Cheshire]";
		mes "每天都有一个这样的箱子被送往卡米达尔隧道。";
		mes "它会混在其他物品中被偷运进去。";
		next;
		mes "[Cheshire]";
		mes "准时潜入那里，把箱子带给我。箱子每天都会放在同一个地方。";
		mes "你每天都要做这件事。";
		close2;
		cutin "",255;
		end;
	} else if (.@playtime == 2) {
		mes "[Cheshire]";
		mes "差不多到时间了。";
		mes "现在去拿箱子。";
		mes "它应该就在卡米达尔隧道的蚂蚁洞入口附近。";
		mes "你以前做过这件事，应该很熟悉吧？";
		close2;
		cutin "",255;
		end;
	} else
		return;
}

dicastes02,125,192,0	script	#call_cheshir_ep14	139,0,3,{
	end;
OnTouch_:
	if (ep13_3_secret > 22) {
		if (rand(2)) {
			emotion ET_DELIGHT, playerattached();
		mes "……？";
		mes "你感觉到有人在移动。";
		mes "下面一定有人。";
			if ($@cheshire_on == 0) {
				donpcevent "Cheshire#ep14_extra::OnEnable";
				set $@cheshire_on,1;
			}
			close;
		}
	}
	end;
}

dicastes02,103,190,3	script	Cheshire#ep14_extra	497,{
	if (ep13_3_secret > 22) {
		cutin "ep13_cheshire",1;
		mes "[Cheshire]";
		mes "……咦？";
		mes "真意外。你在这里做什么？";
		next;
		switch(select("那你在这里做什么？:那对耳朵……？")) {
		case 1:
			mes "[Cheshire]";
			mes "出来散步？";
			mes "我和阿哈特一起出来的，但他回去处理紧急事务了。";
			next;
			mes "[Cheshire]";
			mes ".. ..............";
			next;
			select("……:哇……好漂亮的树。" );
			mes "[Cheshire]";
			mes "这棵树……洁白、透明，还会发光。";
			mes "这是一个萨帕的身体。";
			next;
			mes "[Cheshire]";
			mes "你知道萨帕会在一生中逐渐石化。";
			mes "所以死后，他们会变成石头树。";
			mes "这片森林……可以说就是他们的墓地。";
			next;
			mes "[Cheshire]";
			mes "……仔细看，你还能辨认出他的手臂和腿。";
			mes "很有意思，对吧？";
			next;
			mes "[Cheshire]";
			mes "... .. ...";
			next;
			mes "[Cheshire]";
			mes "哦，真烦人。";
			mes "我走了！";
			next;
		mes "- 切谢尔气冲冲地离开了…… -";
			break;
		case 2:
			mes "[Cheshire]";
		mes "什么？耳朵？";
		mes "没什么好奇怪的，因为我是兽人。";
		mes "……为什么……你为什么那样盯着我？";
			next;
		select("报告是你写的吗？！");
			mes "[Cheshire]";
		mes "你在说什么？";
		mes "我不知道这种事！";
			next;
		mes "- 切谢尔逃跑了…… -";
			break;
		}
		disablenpc "Cheshire#ep14_extra";
		stopnpctimer;
		close2;
		cutin "",255;
		end;
	}
	mes "一个穿着奇怪服装的男孩站在那里，眼神凶狠。";
	mes "你觉得最好别去招惹他。";
	close;
OnInit:
	disablenpc "Cheshire#ep14_extra";
	end;
OnEnable:
	enablenpc "Cheshire#ep14_extra";
	initnpctimer;
	end;
OnDisable:
	disablenpc "Cheshire#ep14_extra";
	stopnpctimer;
	end;
OnTimer600000:
	disablenpc "Cheshire#ep14_extra";
	set $@cheshire_on,0;
	stopnpctimer;
	end;
}

// Helping Lope and Euridi :: ep14_1_rofe
//============================================================
mora,117,66,3	script	Euridi#pa	521,{
	if (BaseLevel < 100) {
		mes "[Euridi]";
		mes "你真是细心。";
		mes "我的确需要帮助，";
		mes "但我觉得你帮不上忙。";
		close;
	}
	if (ep14_1_rope == 0) {
		mes "[Euridi]";
		mes "我听说你经过了迷雾森林。";
		mes "你有没有……";
		mes "碰巧看到";
		mes "我的未婚夫洛佩？";
		next;
		switch(select("是的，我看到了。:不，我没看到。")) {
		case 1:
			mes "[Euridi]";
			mes "你确定吗？在哪里看到的？";
			mes "快带我去那里！";
			mes "...";
			next;
			mes "[Euridi]";
			mes "什么？";
			mes "你在开玩笑吧……？";
			mes "你怎么能这样？";
			close;
		case 2:
			mes "[Euridi]";
			mes "请找到我的洛佩。";
			mes "我问遍了摩拉村，";
			mes "才来到这里，";
			mes "但我已经无能为力了。";
			next;
			mes "[Euridi]";
			mes "想到洛佩，我的心就好痛……";
			mes "他一定也在拼命寻找我……";
			next;
			switch(select("抱歉，我很忙！:我会帮你！")) {

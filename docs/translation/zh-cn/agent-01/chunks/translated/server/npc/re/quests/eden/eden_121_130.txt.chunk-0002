			}
		}
		else {
			mes "你已经帮助过艾古，或者选择了退出？总之我没有别的事情要交给你了。";
			next;
			callsub S_Erasequest,
				13119,"Baroness of Retribution",
				13121,"Lady Solace",
				13123,"Mistress of Shelter",
				13125,"Dame of Sentinel",
				13127,"Vanberk and Isilla",
				13129,"Hodremlin",
				13131,"Agav and Echio",
				13133,"Ragged Zombie",
				13135,"Zombie Slaughter",
				13137,"Banshee",
				13139,"Ferus ",
				13141,"Acidus";
			mes "[旋律·杰克]";
			mes "我不确定你是否找到了想找的东西……我不能再介入了。谢谢。";
		}
	}
	close;
S_Quest:
	if (isbegin_quest(getarg(0)))
		erasequest getarg(0);
	setquest getarg(1);
	if (getarg(2,0))
		getexp 900000,200000;
	return;
S_Erasequest:
	.@total = getargcount();
	for ( .@i = 0; .@i < .@total; .@i += 2 ) {
		.@quest_id = getarg(.@i);
		switch( checkquest(.@quest_id,HUNTING) ) {
		case -1:
			if (checkquest(.@quest_id+1) > -1)
				erasequest (.@quest_id+1);
			continue;
		case 0:
		case 1:
			mes "[旋律·杰克]";
			mes getarg(.@i+1) +"已完成。不需要再接受请求了。";
			break;
		case 2:
			mes "[旋律·杰克]";
			mes getarg(.@i+1) +"已完成。一言为定，我需要领取报酬。";
			getexp 900000,200000;
			break;
		}
		erasequest .@quest_id;
		next;
	}
	return;
OnTouch_:
	if (para_120lv01 == 1) {
		emotion ET_SURPRISE;
		mes "[旋律·杰克]";
		mes "你好！……等等？";
		close;
	}
	end;
}

moc_para01,17,77,5	script	Aigu#1	4_F_IU,{
	mes "[艾古]";
	if (!callfunc("F_HasEdenGroupMark")) {
		mes "哦，你为什么不是伊甸园成员？";
		mes "我只和基础等级为 ^FF0000121-130^000000 的冒险者交谈。";
	}
	else if (para_120lv01 == 0) {
		cutin "igu01",2;
		mes "你好？今天天气真好。能请你帮个忙吗？听说伊甸园的冒险者都很友善。";
		next;
		if (select( "我可不友善。", "当然，我会帮忙。" ) == 1) {
			cutin "igu05",2;
			mes "[艾古]";
			mes "啧……我讨厌你。";
		}
		else {
			cutin "igu03",2;
			mes "[艾古]";
			mes "真的吗？我先自我介绍！我是^ff0000蒲公英乐队的首领艾古。^000000";
			next;
			mes "[艾古]";
			mes "我刚从当地演出回来。有个人我想见却找不到了，所以来伊甸园发布请求。";
			next;
			mes "[艾古]";
			mes "因为没人负责、大家都很忙，我决定自己发布请求。谢谢你的帮助。";
			para_120lv01 = 1;
		}
	}
	else if (para_120lv01 > 0) {
		cutin "igu01",2;
		mes "回到米德加尔特真好！像第一天一样令人兴奋。";
		next;
		if (select( "你的请求是什么？", "聊点别的。" ) == 2) {
			cutin "igu01",2;
			mes "[艾古]";
			mes "蒲公英乐队环游世界，把治愈的音乐传给人们。";
			next;
			cutin "igu02",2;
			mes "[艾古]";
			mes "其实我们的歌曲没有魔法，但我相信因为我的歌声，它们能帮助人们。";
		}
		else if (BaseLevel < 121) {
			cutin "igu04",2;
			mes "[艾古]";
			mes "我想你很难完成我的请求？现在看来，这只会让更多人迷路。通过旅行开阔视野如何？";
		}
		else if (BaseLevel < 131) {
			mes "[艾古]";
			mes "我为正在寻找的人和迷路的冒险者建了避难所。我想知道哪些冒险者来过那里。";
			next;
			switch( select( "搜索塔纳托斯塔", "搜索拉赫圣域", "搜索无名岛", "搜索深渊湖" ) ) {
				mes "[艾古]";
			case 1:
				if (checkquest(13115,PLAYTIME) == 0)
					mes "因为找到了某人的痕迹，还有希望，过一会儿我会再请你搜索。";
				else if (isbegin_quest(13111) == 1) {
					cutin "igu04",2;
					mes "你知道有人去过那里，却不知道是谁？谢谢。因为还不知道那个人是谁，请明天再搜索一次。";
					callsub S_Quest,13111,13115,1250000,300000;
				}
				else if (isbegin_quest(13107) == 1)
					mes "你可以在塔顶找到避难所。不过那里只有水和篝火。";
				else {
					mes "危险的怪物和塔纳托斯塔的高度很容易让冒险者迷路。但有些冒险者仍可能到达，请替我去确认。";
					next;
					if (select( "开始搜索。", "取消。" ) == 1) {
						mes "[艾古]";
						mes "塔纳托斯塔在施瓦茨瓦尔德共和国北部！离朱诺或胡格尔不远。";
						callsub S_Quest,13115,13107;// Thanatos Tower Search
					}
				}
				break;
			case 2:
				if (checkquest(13116,PLAYTIME) == 0)
					mes "拉赫的搜索已经足够了。过一会儿我会再请你搜索。";
				else if (isbegin_quest(13112) == 1) {
					mes "旅途如何？没有特别的消息。不过还没结束，请再搜索一次。";
					callsub S_Quest,13112,13116,1000000,300000;
				}
				else if (isbegin_quest(13108) == 1)
					mes "无法用通常的方式进入圣域。虽然不容易，但我们可以在拉赫找到线索。";
				else {
					cutin "igu03",2;
					mes "拉赫神殿内部有一座圣域。一旦进入，就可能被困在那里。";
					next;
					mes "[艾古]";
					mes "请看看中央区域二楼东南部是否有迷路冒险者的痕迹。";
					next;
					if (select( "开始搜索。", "停止。" ) == 1) {
						cutin "igu05",2;
						mes "[艾古]";
						mes "祝你搜索平安。";
						callsub S_Quest,13116,13108;// Rachel holy ground Search
					}
				}
				break;
			case 3:
				if (checkquest(13117,PLAYTIME) == 0)
					mes "无名岛的搜索改天继续。先休息一会儿如何？";
				else if (isbegin_quest(13113) == 1) {
					mes "谢谢！还有流浪的冒险者在帮忙！无论如何我们都要继续搜索。下次也请帮我。";
					callsub S_Quest,13113,13117,900000,300000;
				}
				else if (isbegin_quest(13109) == 1) {
					cutin "igu04",2;
					mes "也许……和死者一起闲逛喝酒吧。不过请和我谈谈。";
				}
				else {
					cutin "igu03",2;
					mes "是的，也许他们被死者抓住了所以无法回来！无名岛应该没问题！请搜索无名岛。";
					next;
					if (select( "开始搜索。", "停止。" ) == 1) {
						cutin "igu01",2;
						mes "[艾古]";
						mes "请你搜索无名岛修道院地下 1 层。除非你自愿，否则我不能让你冒这个险。";
						callsub S_Quest,13117,13109;// Unknown island Search
					}
				}
				break;
			case 4:
				if (checkquest(13118,PLAYTIME) == 0)
					mes "过一会儿我会再搜索深渊湖。";
				else if (isbegin_quest(13114) == 1) {
					cutin "igu05",2;
					mes "你平安回来了，但看你的表情似乎没有好结果。我会继续搜索，别让我失望！谢谢。";
					callsub S_Quest,13114,13118,900000,200000;
				}
				else if (isbegin_quest(13110) == 1) {
					cutin "igu05",2;
					mes "也许因为湖底没找到怪物，你失望地倒下了。";
				}
				else {
					mes "我建议仔细搜索深渊湖中央的洞穴。";
					next;
					mes "[艾古]";
					mes "没错！精彩冒险的结尾需要一条龙！听说湖底有怪物。";
					next;
					if (select( "开始搜索。", "停止。" ) == 1) {
						mes "[艾古]";
						mes "深渊湖是前往胡格尔最快的路线。请前往地下洞穴 3 层！";
						callsub S_Quest,13118,13110;// Abyss Lake Search
					}
				}
			}
		}
		else {
			cutin "igu04",2;
			mes "[艾古]";
			mes "现在不能再给你搜索任务了！你需要适合当前等级的更难挑战。";
			callsub S_Erasequest,
				13107,"Thanatos Tower",
				13108,"Rachel Shrine",
				13109,"Nameless Island",
				13110,"Abyss Lake";
			callsub S_Erasequest2,
				13111,"Thanatos Tower",1250000,300000,
				13112,"Rachel Shrine",1000000,300000,
				13113,"Nameless Island",900000,300000,
				13114,"Abyss Lake",900000,200000;
			for ( .@i = 13115; .@i <= 13118; .@i++ )
				if (isbegin_quest(.@i)) erasequest .@i;
		}
	}
	close2;
	cutin "",255;
	end;
S_Quest:
	if (isbegin_quest(getarg(0)))
		erasequest getarg(0);
	setquest getarg(1);
	if (getarg(2,0))
		getexp getarg(2),getarg(3);
	return;
S_Erasequest:
	.@total = getargcount();
	for ( .@i = 0; .@i < .@total; .@i += 2 ) {
		if (isbegin_quest(getarg(.@i))) {
			next;
			mes "[艾古]";
			mes "哦，你正在进行"+ getarg(.@i+1) +"冒险任务。我来清除记录，这样你就能进行更好的任务。";
			erasequest getarg(.@i);
		}
	}
	return;
S_Erasequest2:
	.@total = getargcount();
	for ( .@i = 0; .@i < .@total; .@i += 4 ) {
		if (isbegin_quest(getarg(.@i))) {
			next;
			mes "[艾古]";
			mes "哦，你已经完成了"+ getarg(.@i+1) +"冒险。谢谢你帮助我完成任务！";
			erasequest getarg(.@i);
			getexp getarg(.@i+2),getarg(.@i+3);
		}
	}
	return;
}

-	script	Trace of an adventurer	-1,{
	.@quest = 13106 + atoi(strnpcinfo(2));
	.@delay = 13110 + atoi(strnpcinfo(2));
	if (isbegin_quest(.@quest) == 1) {
		mes "我找到了有人来过的痕迹，但没有找到线索。回去向艾古报告吧。";
		erasequest .@quest;
		setquest .@delay;
	}
	else
		mes "这里有某人来过的痕迹。";
	close;
}
thana_step,167,292,5	duplicate(Trace of an adventurer)	Trace of an adventurer#1	4_TRACE
ra_san05,265,69,5	duplicate(Trace of an adventurer)	Trace of an adventurer#2	4_TRACE
abbey02,155,290,5	duplicate(Trace of an adventurer)	Trace of an adventurer#3	4_TRACE
abyss_03,102,140,5	duplicate(Trace of an adventurer)	Trace of an adventurer#4	4_TRACE

tha_t06,126,128,3	script	Suspicious Monster#1	4_DEVIRUCHI,{
	mes "[伪装冒险家]";
	mes "我只是在这个危险的地方工作，报酬是 5000 Zeny……你是接到伊甸园请求的冒险者吗？";
	next;
	switch( select( "是", "否" ) ) {
		mes "[伪装冒险家]";
	case 1:
		if (BaseLevel < 121 || BaseLevel > 130) {
			mes "一眼就能看出不是你！";
			close;
		}
		mes "替艾古执行请求的冒险者会被传送到上层。";
		next;
		if (select( "上去。", "不上去。" ) == 1) {
			mes "[伪装冒险家]";
			if (isbegin_quest(13107) != 1)
				mes "你现在似乎没有进行塔纳托斯塔冒险请求。抱歉，我是为艾古做事，不是为你。";
			else {
				mes "小心！上去后就不能下来。为了艾古！";
				close2;
				warp "thana_step",69,369;
				end;
			}
		}
		close;
	case 2:
		mes "或者请假装不认识我！暴露我的身份会让我陷入危险！";
		close;
	}
}

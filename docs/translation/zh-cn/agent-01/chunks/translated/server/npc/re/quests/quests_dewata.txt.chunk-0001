dew_fild01,57,274,0	script	#hideout_legend	111,6,6,{
OnTouch:
	if (BaseLevel > 59 && dew_legend < 1) {
		mes "- 你听见里面传来微弱的交谈声。 -";
		next;
		mes "[Tribal Chief Paiko]";
		mes "我又一次失败了，没能";
		mes "制作出^8B4513杰蒂王冠^000000……";
		mes "我明明确信这次一定能成功。";
		mes "为什么不行？";
		next;
		mes "[Sage Kasyapa]";
		mes "从远古时代起，^006400杰蒂王冠^000000就以拥有奇迹般的力量而闻名。";
		mes "但据说只有赢得部落荣誉的人";
		mes "才能使用它。";
		next;
		mes "[Tribal Chief Paiko]";
		mes "^0000FF卡夏帕^000000！！";
		mes "你的意思是，虽然我是部落首领，却还没有赢得那份荣誉？";
		next;
		mes "[Sage Kasyapa]";
		mes "冷静点，^0000FF派科首领^000000……";
		mes "作为伟大而强大的首领，你应该完全符合资格。";
		next;
		mes "[Sage Kasyapa]";
		mes "年轻时我本可以轻松解决这个问题，但我这个老人的脑袋实在想不出缺少了什么。";
		next;
		mes "交谈声渐渐远去，你再也听不到后面的内容。";
		set dew_legend,1;
		close;
	}
	end;
}

dew_in01,15,33,0	script	#hidein_legend	111,5,5,{
OnTouch:
	if (dew_legend == 3) {
		mes "你正要离开时，卡夏帕和派科首领开始交谈……";
		next;
		mes "[Sage Kasyapa]";
		mes "我不确定缺少什么，但那位旅行者也许能大大帮助我们制作^006400杰蒂王冠^000000。";
		mes "这一点我很确定。";
		mes "原因是……";
		next;
		mes "[Tribal Chief Paiko]";
		mes "原因是什么？";
		next;
		mes "[Sage Kasyapa]";
		mes "王冠最初制成时，这根^8B4513鸟羽^000000属于我们的第一任部落首领。";
		mes "它一直作为部落珍贵的传家宝保存着。";
		next;
		mes "[Sage Kasyapa]";
		mes "但旅行者靠近时，这根羽毛开始发光，我一直觉得这绝非巧合。";
		mes "这个人将成为帮助我们制作王冠的关键。";
		next;
		mes "[Tribal Chief Paiko]";
		mes "真的会这样吗？";
		mes "如果是这样，我会竭尽全力";
		mes "支持他……";
		set dew_legend,4;
		close;
	}
	end;
}

dew_in01,22,48,3	script	Sage Kasyapa#dew	541,{
	if (dew_legend == 0) {
		mes "[Sage Kasyapa]";
		mes "啊，是来自异乡的陌生人。";
		mes "你迷路了吗？";
		mes "希望你一路来到这里没有遇到太多危险。";
		close;
	} else if (dew_legend == 1) {
		mes "[Sage Kasyapa]";
		mes "你认真的表情告诉我，";
		mes "你有话要说，";
		mes "不如直接告诉我吧。";
		next;
		if(select("我听说了王冠的事？:我只是来找礼品店。") == 2) {
			mes "[Tribal Chief Paiko]";
			mes "真的吗？";
			mes "你的眼神看起来";
			mes "像是想说些什么。";
			close;
		}
		mes "[Sage Kasyapa]";
		mes "哦，你听说了王冠的事，是吗？";
		mes "啊，我这个老人家真是口无遮拦，";
		mes "我们本该谨慎一些……";
		next;
		select("有什么我能帮忙的吗？");
		mes "[Sage Kasyapa]";
		mes "从你的眼神中我能看出，";
		mes "你是值得信赖的人……但是……";
		next;
		mes "一道光芒短暂闪过，^0000FF卡夏帕^000000突然显得惊慌失措。";
		specialeffect2 EF_PNEUMA;
		next;
		mes "[Sage Kasyapa]";
		mes "啊，那根羽毛……！";
		mes "与其和我说，不如去和我们的部落首领^0000FF派科^000000谈谈。";
		set dew_legend,2;
		close;
	} else if (dew_legend == 2) {
		mes "[Sage Kasyapa]";
		mes "与其和我说，不如去和我们的部落首领^0000FF派科首领^000000谈谈。";
		close;
	} else if (dew_legend == 3) {
		mes "[Sage Kasyapa]";
		mes "如果这是^0000FF派科首领^000000想要的，";
		mes "那我没什么可说的了。";
		mes "嗯……";
		mes "但是……这个……";
		next;
		mes "[Sage Kasyapa]";
		mes "没什么，祝你旅途愉快。";
		close;
	} else if (dew_legend == 4) {
		mes "[Sage Kasyapa]";
		mes "我一直在等你，旅行者。";
		mes "我们的部落首领";
		mes "有事想拜托你。";
		mes "请去和^0000FF派科首领^000000谈谈。";
		close;
	} else if (dew_legend == 5) {
		mes "[Sage Kasyapa]";
		mes "我听说你能帮助我们的部落首领";
		mes "制作一顶王冠。";
		mes "你一定会成为";
		mes "我们的巨大助力……";
		mes "我相信自己的眼睛！";
		mes "也相信那闪耀的光芒……";
		next;
		mes "[Sage Kasyapa]";
		mes "戴雅克部落的象征，";
		mes "也是著名的神秘生物。";
		mes "找到 15 根^006400鸟羽^000000，";
		mes "带给^0000FF派科首领^000000。";
		close;
	} else if (dew_legend == 6) {
		mes "[Sage Kasyapa]";
		mes "有了你带来的羽毛，制作^006400杰蒂王冠^000000顺利多了。";
		mes "去见^0000FF派科首领^000000吧。";
		close;
	} else if (dew_legend == 7) {
		mes "[Sage Kasyapa]";
		mes "我有一样东西";
		mes "想作为帮助我们的奖励";
		mes "送给你。";
		mes "请收下它，这是我们的荣幸。";
		next;
		if (checkweight(6406,1) == 0) {
			if (Weight + getiteminfo(6406, ITEMINFO_WEIGHT) > MaxWeight) {
				mes "[Sage Kasyapa]";
				mes "你携带的重量超过了上限。";
				mes "除非减少身上的重物，否则无法领取奖励。";
				close;
			} else {
				mes "[Sage Kasyapa]";
				mes "你的背包里装得太满了。";
				mes "清理负重后再回来，我就把奖励给你。";
				close;
			}
		}
		set dew_legend,8;
		getitem 6406,1; //Cendrawasih_SF
		completequest 9157;
		erasequest 9157;
		mes "[Sage Kasyapa]";
		mes "我请你执行这项重要任务，原因就是这根羽毛。";
		mes "这根羽毛代代相传，是王冠传说的起源……";
		specialeffect2 EF_PNEUMA;
		next;
		mes "[Sage Kasyapa]";
		mes "你来到这里时，我看到这根羽毛开始发光。";
		mes "我知道你是一个";
		mes "愿意努力帮助我们的人。";
		mes "我代表族人";
		mes "向你表示感谢。";
		next;
		mes "[Sage Kasyapa]";
		mes "此外，你收到的羽毛本身不只是珍贵物品，也是我们部族的认可。";
		next;
		mes "[Sage Kasyapa]";
		mes "比如^8B4513喀拉喀托^000000火山这样的危险区域，如果你展示这根羽毛，就能得到部族的帮助。";
		mes "总之，我真的很感谢你。";
		close;
	} else {
		mes "[Sage Kasyapa]";
		mes "此外，你收到的羽毛本身不只是珍贵物品，也是我们部族的认可。";
		next;
		mes "[Sage Kasyapa]";
		mes "比如^8B4513喀拉喀托^000000火山这样的危险区域，如果你展示这根羽毛，就能得到部族的帮助。";
		mes "总之，我真的很感谢你。";
		close;
	}
}

dew_in01,15,49,4	script	Tribal Chief Paiko#dew	540,{
	if (dew_legend < 2) {
		mes "[Tribal Chief Paiko]";
		mes "我是这个部族的首领。";
		mes "^0000FFPaiko^000000";
		close;
	} else if (dew_legend == 2) {
		mes "[Tribal Chief Paiko]";
		mes "我看得出你是旅行者，";
		mes "来自其他土地。";
		mes "你为什么来到这里？";
		next;
		if(select("我偶然听到了那个故事:我没什么可说的。") == 2) {
			mes "[Tribal Chief Paiko]";
			mes "你在这里浪费时间。";
			mes "我们村子周围还有许多其他景点。";
			close;
		}
		mes "[Tribal Chief Paiko]";
		mes "你是什么意思？";
		mes "你听说了王冠的故事？";
		mes "你一定是听错了。";
		mes "我没什么可对你说的。";
		mes "regarding such things.";
		next;
		select("Kasyapa was talking about a crown...");
		mes "[Tribal Chief Paiko]";
		mes "看来^0000FF迦叶波^000000给你讲了一个夸张的故事，我很感谢你关心我们的事务。";
		next;
		mes "[Tribal Chief Paiko]";
		mes "这不是你这样的陌生人能理解的事，所以请像树一样扎根……不，离开这里。";
		set dew_legend,3;
		close;
	} else if (dew_legend == 3) {
		mes "[Tribal Chief Paiko]";
		mes "我们村子周围还有许多其他景点。";
		next;
		mes "[Tribal Chief Paiko]";
		mes "如果你想问王冠，我希望你别再追问了。";
		mes "请离开。";
		close;
	} else if (dew_legend == 4) {
		mes "[Tribal Chief Paiko]";
		mes "我一直在等你，旅行者。";
		mes "根据贤者^0000FF卡夏帕^000000的说法，";
		mes "你愿意帮助我们为部族制作王冠。";
		select("什么王冠？");
		mes "[Tribal Chief Paiko]";
		mes "部族首领有责任制作并保护^006400贾蒂王冠^000000，以维护部族的骄傲与荣誉。";
		next;
		mes "[Tribal Chief Paiko]";
		mes "但是，自从我成为部族首领以来，制作它一直困难重重。";
		next;
		mes "[Tribal Chief Paiko]";
		mes "根据贤者^0000FF迦叶波^000000所说，你可以帮助我们制作^006400贾蒂王冠^000000。";
		next;
		mes "[Tribal Chief Paiko]";
		mes "你能帮忙吗？";
		mes "你的努力不会没有回报。";
		next;
		if(select("好，我会帮忙:抱歉，我现在无法帮忙。") == 2) {
			mes "[Tribal Chief Paiko]";
			mes "那真令人遗憾。";
			mes "如果你改变了";
			mes "想法，请再来。";
			mes "我会等着你。";
			close;
		}
		mes "[Tribal Chief Paiko]";
		mes "非常感谢你，陌生人。";
		mes "既然迦叶波信任你，我知道你能帮助我们制作一顶";
		mes "^006400Jaty Crown^000000";
		mes "你能做的事情";
		mes "非常简单。";
		next;
		mes "[Tribal Chief Paiko]";
		mes "贾蒂部族的象征也是一种著名的神秘生物。";
		mes "找到 15 根^006400天堂鸟羽毛^000000并带给我。";
		mes "陌生人，我们相信你。";
		set dew_legend,5;
		setquest 9155;
		close;
	} else if (dew_legend == 5) {
		if (countitem(6405) < 15) {
			mes "[Tribal Chief Paiko]";
			mes "看来你还没有找到制作^006400贾蒂王冠^000000的材料。";
			next;
			mes "[Tribal Chief Paiko]";
			mes "达雅克部族的象征也是一种著名的神秘生物。";
			mes "找到 15 根^006400天堂鸟羽毛^000000并带给我。";
			close;
		}
		set dew_legend,6;
		delitem 6405,15; //Cendrawasih_F
		changequest 9155,9156;
		mes "[Tribal Chief Paiko]";
		mes "哦！你已经全部找到了。看！你找到的羽毛正在闪闪发光。不是吗？";
		mes "好吧，我开始制作^006400贾蒂王冠^000000。我觉得已经准备好了。";
		next;
		mes "突然，巨大的轰鸣声响起，你和^0000FF派科^000000被温暖明亮的闪烁能量包围，仿佛身处千只萤火虫的清脆鸣响中。";
		specialeffect2 EF_BASH3D2;
		close;
	} else if (dew_legend == 6) {
		mes "[Tribal Chief Paiko]";
		mes "多亏你的帮助，^006400杰蒂王冠^000000制作得很顺利。";
		mes "完成还需要一些时间，请稍等片刻。";
		next;
		mes "[Tribal Chief Paiko]";
		mes "^006400杰蒂王冠^000000完成后，我有一件礼物想送给你。";
		next;
		mes "[Tribal Chief Paiko]";
		mes "对了，你还应该去见^0000FF卡夏帕贤者^000000，他也很想送你一些东西作为奖励。";
		set dew_legend,7;
		changequest 9156,9157;
		close;
	} else if (dew_legend == 7) {
		mes "[Tribal Chief Paiko]";
		mes "啊，你应该去和^0000FF卡夏帕贤者^000000谈谈，他很想送你一些东西作为奖励。";
		close;
	} else if (dew_legend == 8) {
		mes "[Tribal Chief Paiko]";
		mes "有你的支持，我不再担心制作^006400杰蒂王冠^000000了。";
		mes "真的非常感谢。";
		next;
		mes "[Tribal Chief Paiko]";
		mes "今天这样令人愉快的日子应该庆祝一下。你说呢？";
		mes "所以我准备了我们部落的特色食物，叫做^006400沙嗲^000000。";
		next;
		mes "[Tribal Chief Paiko]";
		mes "但是，这些^006400沙嗲^000000太美味了，只让我们两人享用太可惜，所以想和村里的人分享。";
		next;
		mes "[Tribal Chief Paiko]";
		mes "你觉得怎么样？";
		mes "为了告诉大家";
		mes "^006400杰蒂王冠^000000正在顺利制作，也为了和朋友分享美味的^006400沙嗲^000000，我需要你的帮助。";
		next;
		mes "[Tribal Chief Paiko]";
		mes "你愿意帮忙做一趟短途配送吗？";
		next;
		if(select("当然，我可以帮忙。:抱歉，我太忙了，无法帮忙。") == 2) {
			mes "[Tribal Chief Paiko]";
			mes "我以为你一定会帮我……";
			mes "真有点失望。";
			mes "如果你改变主意，";
			mes "再来和我谈谈吧。";
			close;
		}
		mes "[Tribal Chief Paiko]";
		mes "哦！我就知道你会帮忙。";
		mes "在和其他人分享之前，我首先想到了部落的战士们。";
		mes "请把沙嗲分给村里的战士。";
		next;
		mes "[Tribal Chief Paiko]";
		mes "现在我给你 2 份^006400沙嗲^000000。";
		next;
		mes "[Tribal Chief Paiko]";
		mes "你可能会被^006400沙嗲^000000的香味诱惑，可以吃一份，但如果吃得更多，就没法把^006400沙嗲^000000";
		mes "分给村里的朋友了。";
		set dew_legend,9;
		getitem 11533,2; //Satay
		setquest 9158;
		close;
	} else if (dew_legend == 9) {
		callsub L_Delivery,0;
		mes "[Tribal Chief Paiko]";
		mes "我想到了部落战士，去把食物送给村里的战士，和他们分享沙嗲吧。";
		close;
	} else if (dew_legend == 10) {
		mes "[Tribal Chief Paiko]";
		mes "啊，下一位要送^006400沙嗲^000000的人住在河对岸，就是^0000FF部落管理员^000000。";
		next;
		mes "[Tribal Chief Paiko]";
		mes "为此，我再给你 2 份^006400沙嗲^000000。";
		next;
		mes "[Tribal Chief Paiko]";
		mes "如果被^006400沙嗲^000000的香味吸引，可以吃一份，但吃得更多就无法和朋友分享^006400沙嗲^000000了。";
		set dew_legend,11;
		getitem 11533,2; //Satay
		changequest 9159,9160;
		close;
	} else if (dew_legend == 11) {
		callsub L_Delivery,0;
		mes "[Tribal Chief Paiko]";
		mes "第二位要送^006400沙嗲^000000的人住在河对岸。";
		next;
		mes "就是那位^0000FF部落管理员^000000。";
		mes "请在它冷掉前送到。";
		close;
	} else if (dew_legend == 12) {
		mes "[Tribal Chief Paiko]";
		mes "哦，你已经送到了？";
		mes "第三位要送^006400沙嗲^000000的人是^0000FF喀拉喀托火山的守门人^000000。";
		next;
		mes "[Tribal Chief Paiko]";
		mes "这次配送我再给你 2 份^006400沙嗲^000000。";
		next;
		mes "[Tribal Chief Paiko]";
		mes "和之前一样，别被香味诱惑，尽量不要吃掉^006400沙嗲^000000。";
		set dew_legend,13;
		getitem 11533,2; //Satay
		changequest 9161,9162;
		close;
	} else if (dew_legend == 13) {
		callsub L_Delivery,1;
		mes "[Tribal Chief Paiko]";
		mes "第三位要送^006400沙嗲^000000的人是^0000FF喀拉喀托火山的守门人^000000。";
		mes "请在它冷掉前送到。";
		close;
	} else if (dew_legend == 14) {
		mes "[Tribal Chief Paiko]";
		mes "哦，你已经送到了。";
		mes "最后一位要送^006400沙嗲^000000的人是位于^8B4513戴瓦塔岛^000000的^0000FF婆罗浮屠寺管理员^000000。";
		next;
		mes "[Tribal Chief Paiko]";
		mes "我再给你 2 份^006400沙嗲^000000。";
		next;
		mes "[Tribal Chief Paiko]";
		mes "和之前一样，别被香味诱惑，尽量不要吃掉^006400沙嗲^000000。";
		set dew_legend,15;
		getitem 11533,2; //Satay
		changequest 9163,9164;
		close;
	} else if (dew_legend == 15) {
		callsub L_Delivery,1;
		mes "[Tribal Chief Paiko]";
		mes "最后一位要收到^006400沙嗲^000000的人是";
		mes "位于^8B4513戴瓦塔岛^000000的";
		mes "^0000FF婆罗浮屠寺管理员^000000。";
		mes "请在它冷掉前送到。";
		close;
	} else if (dew_legend == 16) {
		mes "[Tribal Chief Paiko]";
		mes "哦，你已经送到了。";
		mes "你做得很好。";
		mes "我们一起分享并享受这段快乐时光，真是太好了。谢谢你。";
		next;
		mes "[Tribal Chief Paiko]";
		mes "你送完^006400沙嗲^000000回来时，";
		mes "杰蒂王冠已经制作完成。它的氛围与光辉让它成为真正完美的王冠。";
		next;
		mes "[Tribal Chief Paiko]";
		mes "另外，你带来的材料绰绰有余，所以制作完^006400杰蒂王冠^000000后，我们还为你制作了一顶相似的王冠。";
		next;
		mes "[Tribal Chief Paiko]";
		mes "它和原本的王冠不同，但有自己的特色。这是我的奖励，感谢你所做的一切。";
		next;
		if (checkweight(18520,1) == 0) {
			mes "[Tribal Chief Paiko]";

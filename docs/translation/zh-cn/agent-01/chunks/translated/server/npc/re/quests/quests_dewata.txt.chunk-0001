		mes "[Tribal Chief Paiko]";
		mes "这是用部落秘制腌料制作的，请尝尝^006400沙嗲^000000。";
		mes "这是我们专门为你用心制作的，但别忘了和朋友分享。";
		set dew_legend,17;
		getitem 18520,1; //Jaty_C
		getitem 11533,5; //Satay
		completequest 9165;
		erasequest 9165;
		next;
	}
	mes "[Tribal Chief Paiko]";
	mes "你做得很好。";
	mes "无论你将来做什么，我都祝愿你的生活充满幸运与欢乐。";
	mes "作为^8B4513杰蒂部落^000000的首领，祝你一切顺利！！";
	close;

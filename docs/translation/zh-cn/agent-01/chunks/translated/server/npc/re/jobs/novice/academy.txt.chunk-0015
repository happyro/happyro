	} else {
		.@swordman_p = .@swordman_p + 1;
		.@thief_p = .@thief_p + 1;
	}
	mes "你会告诉别人最近吃过什么美食吗？";
	next;
	if (select("是", "否") == 1) {
		.@thief_p = .@thief_p + 1;
		.@swordman_p = .@swordman_p + 1;
	} else {
		.@acolyte_p = .@acolyte_p + 1;
		.@taekwon_p = .@taekwon_p + 1;
	}
	mes "你经常把事情记在笔记本上吗？";
	next;
	if (select("是", "否") == 1) {
		.@magician_p = .@magician_p + 1;
		.@merchant_p = .@merchant_p + 1;
	} else {
		.@thief_p = .@thief_p + 1;
		.@archer_p = .@archer_p + 1;
	}
	mes "你认为自己有魅力吗？";
	next;
	if (select("是", "否") == 1) {
		.@ninja_p = .@ninja_p + 1;
		.@gunslinger_p = .@gunslinger_p + 1;
	} else {
		.@acolyte_p = .@acolyte_p + 1;
		.@swordman_p = .@swordman_p + 1;
	}
	mes "你喜欢待在人群聚集的地方吗？";
	next;
	if (select("是", "否") == 1) {
		.@acolyte_p = .@acolyte_p + 1;
		.@swordman_p = .@swordman_p + 1;
	} else {
		.@archer_p = .@archer_p + 1;
		.@ninja_p = .@ninja_p + 1;
	}
	mes "你喜欢独自生活的想法吗？";
	next;
	if (select("是", "否") == 1) {
		.@thief_p = .@thief_p + 1;
		.@ninja_p = .@ninja_p + 1;
	} else {
		.@acolyte_p = .@acolyte_p + 1;
	}
	mes "你喜欢与他人保持距离吗？";
	next;
	if (select("是", "否") == 1) {
		.@gunslinger_p = .@gunslinger_p + 1;
		.@archer_p = .@archer_p + 1;
	} else {
		.@taekwon_p = .@taekwon_p + 1;
	}
	mes "你认为战斗中拥有好的藏身处很重要吗？";
	next;
	if (select("是", "否") == 1) {
		.@magician_p = .@magician_p + 1;
		.@gunslinger_p = .@gunslinger_p + 1;
		.@archer_p = .@archer_p + 1;
	} else {
		.@taekwon_p = .@taekwon_p + 1;
		.@magician_p = .@magician_p + 1;
	}
	mes "即使你知道朋友错了，你仍会保护他吗？";
	next;
	if (select("是", "否") == 1) {
		.@swordman_p = .@swordman_p + 1;
	} else {
		.@thief_p = .@thief_p + 1;
		.@ninja_p = .@ninja_p + 1;
	}
	mes "你会尝试用道理说服敌人不要与你战斗吗？";
	next;
	if (select("是", "否") == 1) {
		.@archer_p = .@archer_p + 1;
		.@merchant_p = .@merchant_p + 1;
	} else {
		.@acolyte_p = .@acolyte_p + 1;
		.@archer_p = .@archer_p + 1;
	}
	mes "你能长时间安静地待在同一个地方吗？";
	next;
	if (select("是", "否") == 1) {
		.@taekwon_p = .@taekwon_p + 1;
		.@thief_p = .@thief_p + 1;
	} else {
		.@archer_p = .@archer_p + 1;
		.@gunslinger_p = .@gunslinger_p + 1;
	}
	mes "你认为自己能承受半兽人直击腹部的一拳吗？";
	next;
	if (select("是", "否") == 1) {
		.@swordman_p = .@swordman_p + 1;
		.@merchant_p = .@merchant_p + 1;
	} else {
		.@magician_p = .@magician_p + 1;
		.@thief_p = .@thief_p + 1;
	}
	mes "你会给朋友起外号吗？";
	next;
	if (select("是", "否") == 1) {
		.@gunslinger_p = .@gunslinger_p + 1;
		.@archer_p = .@archer_p + 1;
	} else {
		.@acolyte_p = .@acolyte_p + 1;
		.@gunslinger_p = .@gunslinger_p + 1;
	}
	mes "面对各种情况，你总是会准备备用计划吗？";
	next;
	if (select("是", "否") == 1) {
		.@thief_p = .@thief_p + 1;
		.@gunslinger_p = .@gunslinger_p + 1;
	} else {
		.@gunslinger_p = .@gunslinger_p + 1;
		.@merchant_p = .@merchant_p + 1;
	}
	mes "和别人交谈时，我会想着其他事情。";
	next;
	if (select("是", "否") == 1) {
		.@magician_p = .@agician_p + 1;
	} else {
		.@ninja_p = .@ninja_p + 1;
		.@archer_p = .@archer_p + 1;
	}
	mes "[奶油泡芙]";
	mes "职业适性测试的前三项已经完成。请稍等。";
	next;
	cutin "choucream_d.bmp",2;
	mes "[奶油泡芙]";
	mes "如你所知，需要手动计算。";
	next;
	setarray .@points[0],.@swordman_p,.@magician_p,.@archer_p,.@merchant_p,.@thief_p,.@acolyte_p,.@taekwon_p,.@gunslinger_p,.@ninja_p;
	.@max = .@points[0];
	for(.@i = 1; .@i < 9; .@i = .@i+1) {
		if (.@points[.@i] >= .@max) {
			.@max = .@points[.@i];
			.@ele = .@i;
		}
	}
	set .@who_job, .@ele + 1;
	mes "[奶油泡芙]";
	mes "好了！！！！完成了！！！！";
	next;
	cutin "choucream_e.bmp", 2;
	mes "[奶油泡芙]";
	mes "计算完成。数学总是很难。";
	next;
	mes "[奶油泡芙]";
	mes "根据职业适性测试结果！";
	next;
	mes "[Cream Puff]";
	if (.@who_job == 1) {
		.@job_name$ = "Swordman";
		mes "拥有坚定信念、想成为英雄并影响世界的人。";
		next;
		mes "[Cream Puff]";
		mes "想要保护弱者的人。";
	} else if (.@who_job == 2) {
		.@job_name$ = "Mage";
		mes "对一切充满好奇、喜欢独立工作的人。";
		next;
		mes "[Cream Puff]";
		mes "判断力强、不外向、善于分析且洞察力强，喜欢观察的人……";
	} else if (.@who_job == 3) {
		.@job_name$ = "Archer";
		mes "浪漫、理解他人感受，也希望被他人理解的人。";
		next;
		mes "[Cream Puff]";
		mes "愿意花时间了解自己的人。";
	} else if (.@who_job == 4) {
		.@job_name$ = "Merchant";
		mes "善于读懂他人想法且果断的人。";
		next;
		mes "[Cream Puff]";
		mes "热衷于达成目标、积极进取且有责任感的人。";
	} else if (.@who_job == 5) {
		.@job_name$ = "Thief";
		mes "喜欢享受乐趣、乐观且热爱冒险的人。";
		next;
		mes "[Cream Puff]";
		mes "想寻找刺激，并希望用自己的方式为世界做贡献的人。";
	} else if (.@who_job == 6) {
		.@job_name$ = "Acolyte";
		mes "拥有善良的心，愿意帮助和理解他人的人。";
		next;
		mes "[Cream Puff]";
		mes "渴望被爱，也愿意关心他人的人。";
	} else if (.@who_job == 7) {
		.@job_name$ = "Taekwon boy/girl";
		mes "通过正确训练拥有健全心智的人。";
		next;
		mes "[Cream Puff]";
		mes "每天努力、怀抱坚定信念，并努力让他人理解自己的人。";
	} else if (.@who_job == 8) {
		.@job_name$ = "Gunslinger";
		mes "被称为正义执行者，却也带来混乱与恐惧的人。";
		next;
		mes "[Cream Puff]";
		mes "努力在正义与混乱之间保持平衡的人。";
	} else if (.@who_job == 9) {
		.@job_name$ = "Ninja";
		mes "不希望引人注意的人，";
		next;
		mes "[Cream Puff]";
		mes "会坚持不懈，直到达成目标。";
	} else {
		mes "发生错误。";
		close2;
		cutin "", 255;
		end;
	}
	next;
	emotion ET_BEST;
	mes "[Cream Puff]";
	mes "^8014EB"+.@job_name$+"^000000 很适合你。";
	next;
	cutin "choucream_n.bmp", 2;
	mes "[Cream Puff]";
	mes "嗯，上面写着。";
	next;
	mes "[Cream Puff]";
	mes "你不必根据职业适性测试选择职业，那只是娱乐。";
	next;
	emotion ET_QUESTION;
	mes "[Cream Puff]";
	mes "如果你愿意，我可以把你送到适性结果推荐的职业地点。";
	next;
	if (select("现在送我过去。", "没关系，我还在考虑。") == 2) {
		mes "[奶油泡芙]";
		mes "好吧，我猜你已经知道自己想要什么了。";
		close2;
		cutin "", 255;
		end;
	}
	mes "[奶油泡芙]";
	mes "推荐给你的职业是"+.@job_name$+"。我会把你送到能与该职业专家交谈的地方。";
	close2;
	switch(.@who_job) {
	case 1:
		warp "iz_ac02",84,49;
		break;
	case 2:
		warp "iz_ac02",123,109;
		break;
	case 3:
		warp "iz_ac02",84,109;
		break;
	case 4:
		warp "iz_ac02",84,169;
		break;
	case 5:
		warp "iz_ac02",84,139;
		break;
	case 6:
		warp "iz_ac02",122,169;
		break;
	case 7:
		warp "iz_ac02",84,79;
		break;
	case 8:
		warp "iz_ac02",123,79;
		break;
	case 9:
		warp "iz_ac02",123,139;
		break;
	default:
		warp "iz_ac02",123,49;
		break;
	}
	end;
}

iz_ac02_a,143,55,3	duplicate(Cream Puff#ac)	Cream Puff#ac_a	4_M_KID1
iz_ac02_b,143,55,3	duplicate(Cream Puff#ac)	Cream Puff#ac_b	4_M_KID1
iz_ac02_c,143,55,3	duplicate(Cream Puff#ac)	Cream Puff#ac_c	4_M_KID1
iz_ac02_d,143,55,3	duplicate(Cream Puff#ac)	Cream Puff#ac_d	4_M_KID1

// =============================================================================
// = Gunslinger
// =============================================================================

// - Lusa
// - Teaches the player about Gunslinger class.
// -----------------------------------------------------------------------------
iz_ac02,142,85,6	script	Lusa#ac	4_F_GUNSLINGER,{
	if (!checkweight(1301,1)) {
		mes "- 由于负重过高，任务无法继续。-";
		close;
	}
	cutin "aca_gung_01.bmp", 2;
	if (Class == Job_Novice) {
		if (isbegin_quest(4269) != 2) {
			mes "[露莎]";
			mes "哦！抱歉，要学习这个职业，你得先注册。去一楼柜台登记后再回来，听到了吗？";
			close2;
			// ConsumeSpecialItem Inspector_Certificate_
			cutin "", 255;
			end;
		}
		setarray .@manuals[0],2819,2820,2821,2822,2823,2824,2942,2941,2940;
		for (.@i = 0; .@i < 9; .@i++) {
			if (isequippedcnt(.@manuals[.@i]) || countitem(.@manuals[.@i]))
				.@has_manual = 1;
		}
		emotion ET_COOL;
		mes "[露莎]";
		mes "天哪！你比小猪还可爱！你想学习成为^ff0000枪手^000000吗？";
		next;
		if (.@has_manual == 1) {
			.@menu$ = "What is a Gunslinger?:Can I try out the skills?:Becoming a Gunslinger?:How can I try out the skills?:Cancel";
		} else {
			.@menu$ = "枪手是什么？:我能试用技能吗？:成为枪手？::取消";
		}
		switch(select(.@menu$)) {
		case 1:
			emotion ET_THROB;
			mes "[露莎]";
			mes "你真可爱！^ff0000枪手^000000拥有勇气，在这个混乱的时代用武器伸张正义。";
			next;
			mes "[露莎]";
			if (Sex == SEX_MALE)
				mes "你让我想起弟弟，那小子连谷仓都打不中……至少在我教他之前是这样。";
			else
				mes "你让我想起妹妹，那丫头连谷仓都打不中……至少在我教她之前是这样。";
			next;
			mes "[Lusa]";
			mes "你们要明白，枪不是对着动物挥舞的小玩意，也不是动动手指就能把它电死的东西。";
			next;
			mes "[Lusa]";
			mes "不！你要用枪射击，所以必须瞄准。这需要枪手拥有很高的^ff0000灵巧^000000。";
			next;
			mes "[Lusa]";
			mes "在你跑出去朝空中乱开枪、得意洋洋跳舞之前，要明白这不是轻松的工作！";
			next;
			mes "[Lusa]";
			mes "子弹要花 Zeny，所以每一枪都必须物有所值！我们进行远程攻击，避免被那个拿猪刀的恶棍骚扰！";
			next;
			mes "[Lusa]";
			mes "都明白了吗？";
			next;
			while(1) {
				switch(select("远程攻击？", "弹药为什么贵？", "转职测试？", "明白~！！")) {
				case 1:
					mes "[露莎]";
					mes "那些低科技的野蛮人需要力量和灵巧才能正确战斗，但枪手不一样。";
					next;
					mes "[露莎]";
					mes "因为灵巧同时影响攻击力和命中率！记住，说话慢一点，但思考要快！";
					next;
					break;
				case 2:
					cutin "aca_gung_02.bmp", 2;
					mes "[露莎]";
					mes "你们看到附近有很多工厂、矿井和炼金实验室吗？这些都需要 Zeny 运转，这就是弹药昂贵的原因！";
					next;
					break;
				case 3:
					mes "[露莎]";
					mes "有些职业可能认为把伤人的力量交给随便什么家伙也很安全。";
					next;
					mes "[露莎]";
					mes "但我们必须确认你有勇气！记住，快很好，但准确更重要。";
					next;
					break;
				case 4:
					break;
				}
				cutin "aca_gung_01.bmp", 2;
				break;
			}
			mes "[露莎]";
			mes "还有问题的话，随时可以回来问我。";
			close2;
			//ConsumeSpecialItem Inspector_Certificate_
			cutin "", 255;
			end;
		case 2:
			mes "[露莎]";
			mes "听说克里图拉学院是给还没决定职业的新手准备的。";
			next;
			mes "[露莎]";
			mes "他们雇了我，还给了我枪，来教你如何成为枪手！";
			next;
			mes "[露莎]";
			mes "你想让我教你吗？";
			next;
			if (select("好，女士！", "不用了，谢谢。") == 2) {
				mes "[露莎]";
				mes "嗯，你看起来确实没什么胆量。";
				close2;
				//ConsumeSpecialItem Inspector_Certificate_
				cutin "", 255;
				end;
			}
			mes "[露莎]";
			if (isequippedcnt(2941) || countitem(2941)) {
				mes "嘿！这是怎么回事？！你已经有手册了！";
			} else {
				getitem 2941,1;// Gunslinger_Manual
				mes "拿着这本手册。我不太擅长读书，但可以回答你的问题。";
			}
			next;
			mes "[露莎]";
			mes "如果需要战斗训练，请访问<NAVI>[苏比诺]<INFO>iz_ac01,59,83</INFO></NAVI>。";
			close2;
			//ConsumeSpecialItem Inspector_Certificate_
			cutin "", 255;
			end;
		case 3:
			if (Upper == 2) {
				emotion ET_SEXY;
				mes "[露莎]";
				mes "哦，抱歉！孩子不能成为枪手！";
				next;
				mes "[露莎]";
				mes "也许你应该和父母谈谈其他职业。";
				close2;
				// ConsumeSpecialItem Inspector_Certificate_
				cutin "", 255;
				end;
			}
			mes "[露莎]";
			mes "你要学习作为枪手射击吗？";
			next;
			if (JobLevel < 10) {
				mes "[露莎]";
				mes "哎呀！你还没准备好去大城市！";
				next;
				mes "[露莎]";
				mes "达到^ff0000职业等级：^0000ff10^000000后回来，我就帮你！";
				close2;
				//ConsumeSpecialItem Inspector_Certificate_
				cutin "", 255;
				end;
			} else {
				mes "[露莎]";
				mes "你准备好参加枪手转职测试了吗？";
				next;
			}
			if (select("Wait a moment.", "Send me.") == 1) {
				cutin "aca_gung_02.bmp", 2;
				mes "[露莎]";
				mes "准备好后就来找我！";
				close2;
				cutin "", 255;
				end;
			}
			mes "[露莎]";
			mes "好吧，你应该去找^ff0000米勒大师先生^000000，向他询问测试。";
			next;
			mes "[露莎]";
			mes "记住，如果你发现自己掉进了洞里，第一件事就是停止挖掘！";
			close2;
			warp "que_ng", 150, 167;
			end;
		case 4:
			mes "[露莎]";
			mes "你需要我帮你使用那本书吗？";
			while(1) {
				next;
				switch(select("这本书怎么用？", "我找不到技能。", "我没有枪……", "暂时没有问题了。")) {
				case 1:
					mes "[露莎]";
					mes "哦……我想我知道问题在哪了，";
					next;
					mes "[露莎]";
					mes "要使用指南，首先要装备它。^ff0000打开装备窗口的快捷键是 Alt + E。^000000";
					next;
					mes "[露莎]";
					mes "我有时也会忘记！^ff0000把物品从物品栏拖到装备窗口的对应栏位，也可以在物品栏中双击物品。^000000";
					next;
					mes "[Lusa]";
					mes "你还有其他问题吗？";
					continue;
				case 2:
					mes "[露莎]";
					mes "你想学习如何使用技能吗？";
					next;
					mes "[露莎]";
					mes "^ff0000使用 Alt + S 打开技能窗口。技能位于 ETC 标签页。^000000";
					next;
					mes "[露莎]";
					mes "^ff0000然后可以把技能拖到快捷栏，方便使用！^000000";
					next;
					mes "[Lusa]";
					mes "……我就是这样明白的：犹豫不决时，就让你的大嘴鸟替你思考吧。";
					next;
					mes "[Lusa]";
					mes "你还有其他问题吗？";
					continue;
				case 3:
					mes "[Lusa]";
					mes "嗯，我觉得你还没准备好拿枪。所以训练手册只会展示不需要枪的技能。";
					next;
					mes "[Lusa]";
					mes "你还有其他问题吗？";
					continue;

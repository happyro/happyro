		mes "[农夫]";
		mes "葡萄请" + .@string$[.@r[0]] + ". 四季豆请" + .@string$[.@r[1]] + ". 南瓜请" + .@string$[.@r[2]] + ".";
		mes "接下来就拜托你了。";
		setquest 16364;
		close3;
	}
	if (isbegin_quest(16364) == 1 || isbegin_quest(16366) == 1) {
		if ((isbegin_quest(16367) == 2 || isbegin_quest(16368) == 2 || isbegin_quest(16369) == 2) && (isbegin_quest(16370) == 2) || (isbegin_quest(16371) == 2 || isbegin_quest(16372) == 2) && (isbegin_quest(16373) == 2 || isbegin_quest(16374) == 2 || isbegin_quest(16375) == 2)) {
			if (checkweight(1201,3) == 0) {
				mes "[警报]";
				mes "- 背包已满。请检查负重和携带数量后再回来找我。-";
				close3;
			}
			mes "[农夫]";
			mes "你把它们都照料好了。作为冒险家，你很擅长照顾农田。";
			next;
			mes "[农夫]";
			mes "我们没什么可给你的，不过可以把在这里找到的材料给你。我看到佣兵们也在收集。你不需要吗？";
			next;
			mes "[农夫]";
			mes "我们的作物每天都需要照料。请再回来帮忙。";
			for ( .@quest_id = 16367; .@quest_id <= 16375; .@quest_id++ )
				if (isbegin_quest(.@quest_id) == 2)
					erasequest .@quest_id;

			if (isbegin_quest(16364) == 1) {
				getexp2 getbaseexp_ratio(10,110),0;
				getexp 0,300000;
				getexp 0,300000;
				getexp 0,250000;
				getitem 25723,1;	// EP17_1_EVT39
				getitem 25669,5;	// EP17_1_EVT02
				completequest 16364;
			}
			if (isbegin_quest(16366) == 1) {
				getexp2 getbaseexp_ratio(3,110),0;
				getexp 0,100000;
				getexp 0,100000;
				getexp 0,100000;
				getitem 25723,1;	// EP17_1_EVT39
				getitem 25669,5;	// EP17_1_EVT02
				erasequest 16366;
			}
			setquest 16365;
			close;
		}
		setarray .@string$[0],"捕捉蚜虫","撒肥料","拔杂草","你照料得很好。";
		for ( .@i = 0; .@i < 3; .@i++ ) {
			.@base = 16367 + (.@i * 3);
			for ( .@r[.@i] = 0; .@r[.@i] < 3; .@r[.@i]++ ) {
				if (isbegin_quest(.@base+.@r[.@i]) == 1)
					break;
			}
		}
		mes "[农夫]";
		mes "啊，你还没完成。";
		next;
		mes "[农夫]";
		mes "葡萄需要" + .@string$[.@r[0]] + ". 四季豆请" + .@string$[.@r[1]] + ". 南瓜请" + .@string$[.@r[2]] + ".";
		next;
		mes "[农夫]";
		mes "请确保这些都完成。";
		close;
	}
	switch (checkquest(16365,PLAYTIME)) {
	case -1:
		break;
	case 0:
	case 1:
		mes "[农夫]";
		mes "我们的作物现在很好。太频繁地摆弄它们反而不好。它们看起来坚强，其实很敏感。";
		next;
		mes "[农夫]";
		mes "请在黎明后再回来。谢谢。";
		close;
	case 2:
		erasequest 16365;
		break;
	}
	if (isbegin_quest(16364) == 2 && isbegin_quest(16366) == 0) {
		mes "[农夫]";
		mes "已经过了足够长的时间，作物又需要照料了。能再帮我们吗？";
		next;
		mes "[农夫]";
		mes "你来了以后，我要做的事更多了，但一个人的能力有限。";
		next;
		if (select( "帮忙。", "不帮忙。" ) == 2) {
			mes "[农夫]";
			mes "啊，我明白了。多亏你们，我要做的事更多、能帮忙的人更少，不过我没问题。";
			next;
			mes "[农夫]";
			mes "算了，你自己可能也很忙。不过我懂什么呢？我只是个农夫。";
			close3;
		}
		mes "[农夫]";
		mes "谢谢。我们有葡萄、四季豆和南瓜，我应该告诉过你它们各自有不同需求。";
		next;
		setarray .@r[0], rand(3), rand(3), rand(3);
		setarray .@string$[0],"捕捉蚜虫","撒肥料","拔杂草";
		setquest 16367+.@r[0];
		setquest 16370+.@r[1];
		setquest 16373+.@r[2];
		mes "[农夫]";
		mes "葡萄请" + .@string$[.@r[0]] + ". 四季豆请" + .@string$[.@r[1]] + ". 南瓜请" + .@string$[.@r[2]] + ". 既然你知道流程，我就不多说了。";
		setquest 16366;
		close3;
	}
	mes "[农夫]";
	mes "抱歉，我很忙。这里有肥料味，你们城里人应该不想待在这里。去那边和研究人员以前待的地方的其他人会合吧。";
	close;

OnInit:
	questinfo (QTYPE_QUEST, QMARK_YELLOW, " isbegin_quest(16360) == 2 && isbegin_quest(16364) == 0 ");
	questinfo (QTYPE_QUEST, QMARK_YELLOW, " checkquest(16365,PLAYTIME) == 2 ");
	questinfo (QTYPE_QUEST, QMARK_YELLOW, " isbegin_quest(16364) == 2 && checkquest(16365,PLAYTIME) == -1 && isbegin_quest(16366) == 0 ");
	end;
}

sp_cor,160,135,5	script	Green Beans#rm171_2	4_ENERGY_YELLOW,{

				mes "但在尝试之前，你必须通过测试和研究才能到达那里。";
				mes "依我看，费这么大劲全都是胡闹！";
				next;
				mes "[格克代理人]";
				mes "我们必须尽快派人开始探索这个区域。";
				mes "人类在浪费时间，我们的猫爪商人应该先安顿下来，继续研究。";
				next;
				if (select ("我也想去帮助商人。:我没兴趣。") == 1) {
						mes "[格克代理人]";
						mes "你比其他人类强多了！";
						mes "如果你是认真的，就在这里签名。";
						mes "我正在收集签名，好讨好加雷克……算了。我会告诉他们你是我的赞助者！";
						next;
						input .@inputstr$;
						mes "[格克代理人]";
						mes "" + strcharinfo(0) + "？人类的名字对我来说真奇怪。";
						next;
						mes "[格克代理人]";
						mes "现在你是格克的私人奴……赞助者了。";
						mes "别问为什么不是商人的赞助者。";
						mes "优秀的人类不会擅自打听不该打听的地方。";
						next;
						mes "[格克代理人]";
						mes "既然你签了名，我们只需出发前往另一个世界。";
						mes "听说人类称那里为灰烬真空。";
						mes "没人向格克解释过为什么叫这个名字。";
						next;
						mes "[格克代理人]";
						mes "不过，人类。";
						mes "前往灰烬真空需要付费。";
						mes "格克亲自送你过去本来不需要费用，但我们必须请求其他代理人帮忙。";
						next;
						mes "[格克代理人]";
						mes "所以你需要一些钱，为帮助你的代理人购买鱼。";
						mes "我会介绍一位代理人给你，只需 50,000 Zeny，他就会毫不犹豫地把你送到另一个世界。";
						next;
						if (select ("支付 50,000 Zeny。:不可能！") == 1) {
								if (Zeny < 50000) {
									mes "[格克代理人]";
									mes "格克已经学会不和付不起钱的人打交道。";
									close;
								}
								mes "[格克代理人]";
								mes "这样一来，我们的契约就完成了。";
								mes "格克会帮助你平安到达灰烬真空。";
								set Zeny, Zeny - 50000;
								set ep13_start, 100;
								next;
								mes "[格克代理人]";
								mes "别忘了，人类。格克帮助你的原因，是为了帮助在另一个世界努力工作的猫爪商人。";
								next;
								mes "[格克代理人]";
								mes "现在我会传送你。去右边角落见我们的代理人。";
								close2;
								warp "moc_fild20", 342, 198;
								end;
						}
						mes "[格克代理人]";
						mes "格克不会强迫人类。";
						mes "但我想你会改变主意。";
						close;
				}
				mes "[格克代理人]";
				mes "你在灰烬真空见到猫爪商人了吗，人类？";
				close;
		}
		mes "[猫爪代理人]";
		mes "但我们的猫爪商人会克服一切障碍！";
		close;
	}
	mes "[格克代理人]";
	mes "你在灰烬真空见到猫爪商人了吗，人类？";
	next;
	if (select ("送我回去:我很忙") == 1) {
		mes "[格克代理人]";
		mes "没有时间浪费了，人类！";
		mes "我马上送你回去！";
		warp "moc_fild20", 342, 198;
		close;
	}
	mes "[格克代理人]";
	mes "喂，人类！你不是说要帮助猫爪商人吗！";
	close;
}

moc_fild20,368,197,3	script	Cat#to22	876,{
	if (ep13_start != 100) {
		mes "[猫]";
		mes "喵~";
		close;
	}
	mes "一只小猫爪代理人看着你，朝身后点了点头。";
	mes "它似乎想让你踩上它的背，翻过墙去。";
	next;
	if (select ("可是你太可爱了……:就这么做！") == 1) {
		mes "小猫爪代理人的白色毛皮上有小小的黑色斑纹，仿佛印上去的一样。";
		next;
		mes "它的身体还没你的脚踝高，小而厚实的爪子像小垫子。看到你的体型后向后弯曲的耳朵，激起了你的保护本能。";
		next;
		mes "你似乎没有勇气踩上猫爪代理人的背。";
		emotion ET_CRY;
		close;
	}
	mes "你看着猫爪代理人小小的背，为了不让它察觉你的重量，尽快翻过了墙。";
	close2;
	warp "moc_fild22b", 175, 159;
	end;
}

moc_fild22b,182,179,3	script	Cat Paw Agent#Tat	495,{
	if (ep13_start != 100) {
		mes "[猫爪代理人]";
		mes "这个地方对我们没有意义。";
		close;
	}
	mes "[猫爪代理人]";
	mes "我听格克说了。";
	mes "我是猫爪商人的新星，塔特。";
	next;
	mes "[塔特]";
	mes "听说你提供高品质的鱼，作为我们的通行费。";
	mes "还听说鱼很新鲜，鳞片闪耀着金色光芒。";
	next;
	mes "[塔特]";
	mes "通常只有猫爪商人的代理人可以通过，但你代表格克而来，而且看起来值得信任，我就放你过去。";
	next;
	mes "[塔特]";
	mes "准备好了吗？";
	next;
	if (select ("前往另一个世界！:我还需要一点时间。") == 1) {
		mes "[塔特]";
		mes "别忘了你欠猫爪商人的债，人类！";
		close2;
		warp "mid_camp", 210, 291;
		end;
	}
	mes "[塔特]";
	mes "来这里之前不是应该准备好了吗？";
	close;
}

			}
			else if ((.@newspp == 3) || (.@newspp == 4)) {
				mes "- 第 4 版 -";
				mes "朱诺广场斗殴事件";
				mes " ";
				mes "昨晚，有人目击两名年轻人在朱诺广场";
				mes "激烈地互相斗殴。";
				mes "据逮捕他们的朱诺士兵称，";
				mes "B 先生对 A 先生的";
				mes "鲁莽行为十分不满，";
				mes "看来他的耐心昨晚终于耗尽了。";
				mes "据说斗殴始于 A 先生把赤裸而汗湿的脚放在 B 先生的大腿上，";
				mes "还说自己的脚实在太汗了。";
				mes "大家就把这归咎于炎热的天气吧！";
				mes " ";
				next;
			}
			else if (.@newspp == 5) {
				mes "上帝的警告：秘密实验室化为灰烬";
				mes " ";
				mes "昨晚笼罩朱诺天空的烟雾";
				mes "被证实来自";
				mes "一座起火的秘密实验室。";
				mes "关于实验室的更多信息";
				mes "尚未公布，但据目击者称，";
				mes "实验室被发现时空无一人，";
				mes "里面也没有任何东西，";
				mes "只有破碎的试管残片，";
				mes "证明那里曾被用作实验室。";
				mes "事故现场调查员西恩推测，";
				mes "从里面残留的机器来看，";
				mes "那座实验室一定曾被用于";
				mes "测试生物科技项目，";
				mes "并表示这场火灾是上帝的愤怒，";
				mes "是对轻慢其造物者的正义惩罚。";
				mes " ";
				next;
				mes "["+ strcharinfo(0) +"]";
				mes "...........................";
				mes "...........................";
				mes "这里就是我在梦里见过的地方！";
				next;
				mes "等等，那他们逃出去的地方呢……？";
				next;
				mes "你迅速确认了新闻的日期。那已经是很久以前的事了，";
				mes "继续查阅新闻也找不到更多信息。";
				next;
				mes "如果他们还有后代或继承人呢？";
				next;
				mes "你感到心跳因兴奋而加快。";
				mes "你现在确信这不只是梦或幻觉，而是看到了过去真正发生的事情。";
				next;
				mes "["+ strcharinfo(0) +"]";
				mes "我不敢相信这一切真的发生了！";
				mes "仔细想想……那是^FF0000一片与北方洞穴相连的区域^000000。";
				set barmunt_crow,8;
				changequest 2065,2066;
				close;
			}
			else if ((.@newspp == 6) || (.@newspp == 7)) {
				mes "- 文化版 -";
				mes "- 请拯救我的水 -";
				mes " ";
				mes "最近备受赞誉的年轻作家";
				mes "让·卡多克的新系列作品";
				mes "《请拯救我的水》登上了";
				mes "图书馆借阅量最高的书籍榜首。";
				mes "《请拯救我的水》讲述了一名叫乌杰尔的女孩，";
				mes "她受到了大自然母亲的祝福。";
				mes "她的父亲临终前留下遗嘱，";
				mes "要她对抗邪恶，‘保护水源’。";
				mes "为了净化水源，她与一群邪恶的反派斗争，";
				mes "那些反派正在污染大自然。";
				mes "这本书很快会被选为";
				mes "施瓦茨瓦尔德共和国的重要教材，";
				mes "用于推广道德，";
				mes "并在全国范围内促进环境保护。";
				mes " ";
				next;
			}
			else {
				mes "艾因贝赫矿山坍塌（2）";
				mes " ";
				mes "据负责艾因贝赫采矿业务的";
				mes "雷根贝勒公司员工透露，";
				mes "目前已经发现三具尸体，";
				mes "但有一名幸存者被送往医院。";
				mes "他的情况十分危急，";
				mes "该员工还告知我们，";
				mes "搜救人员仍在寻找幸存者，";
				mes "并已聘请专家调查";
				mes "事故原因。";
				mes " ";
				next;
			}
		}
	}
	else {
		mes "^660000这是一个带木框的文件夹，里面夹着厚厚一叠旧报纸。^000000";
		close;
	}
}

yuno_in04,169,123,3	script	Suspicious Man#oliver_h	407,{
	if (checkweight(617,3) == 0) {
		mes "- 你的背包中物品太多，无法继续此任务。-";
		close;
	}
	if (barmunt_crow > 14) {
		mes "^660000作家正以极快的速度在笔记本上写作。^000000";
		next;
		mes "["+ strcharinfo(0) +"]";
		mes "别打扰他，尤其是他灵感迸发的时候。这种情况可不常见。";
		close;
	}
	else if (barmunt_crow == 13) {
		cutin "oliver_pre",2;
		if (countitem(7795) < 1) {
			mes "[奥利弗·希尔珀特]";
			mes "玛米女士……";
			close2;
			cutin "",255;
			end;
		}
		mes "[奥利弗·希尔珀特]";
		mes "你改变主意，不打算把玛米女士的画册卖给我了吗？";
		next;
		switch(select("是:否")) {
		case 1:
			cutin "oliver_smile",2;
			mes "[奥利弗·希尔珀特]";
			mes "哇，谢谢！";
			next;
			mes "[奥利弗·希尔珀特]";
			mes "嗯……我还没收到出版社的预付款，你介意先收下这个吗？";
			next;
			break;
		case 2:
			mes "[奥利弗·希尔珀特]";
			mes "好吧……我明白了……";
			emotion ET_CRY;
			close2;
			cutin "",255;
			end;
		}
		mes "[奥利弗·希尔珀特]";
		mes "我还没机会打开它，但我的出版商说里面有非常稀有的东西。希望它足够用来支付你的画册。";
		next;
		mes "["+ strcharinfo(0) +"]";
		mes "哈哈，谢谢。";
		mes "你知道，在梦罗克……阿嚏！……有个人和你一样是玛米的超级粉丝……阿嚏！你不如去见见他？";
		next;
		mes "["+ strcharinfo(0) +"]";
		mes "那本书是他送给我的礼物。他手里可能还有她的稀有画册……阿嚏！";
		next;
		mes "[奥利弗·希尔珀特]";
		mes "哦，非常感谢你提供这么有价值的信息！";
		next;
		mes "[奥利弗·希尔珀特]";
		mes "哇！我得趁忘记之前，把昨晚梦里看到的故事写下来！";
		next;
		mes "[奥利弗·希尔珀特]";
		mes "希望你也会喜欢我的下一本书。那我得走了……谢谢你的画册！";
		next;
		cutin "oliver_smile",255;
		mes "^660000他像无头苍蝇一样跑来跑去。他迅速打开包，取出笔记本，跑到桌旁，开始飞快地记录什么。";
		mes "起初他看起来相当滑稽，但现在看来，他是个非常认真写作的人。^000000";
		next;
		mes "^660000你正要离开时，在地上发现了一张纸。^000000";
		next;
		mes "^660000纸上写满了潦草的字，顶部标着《命运之鸦》。奥利弗一定是不小心掉了这张记录小说《命运之鸦》信息的便笺。^000000";
		next;
		mes "^3131FF古代武器 = 某种能量来源^000000";
		mes "^3131FF隐居 - 女弟子的信^000000";
		mes "^3131FF继母 = 前世恋人？！^000000";
		close2;
		specialeffect2 EF_ENHANCE;
		delitem 7795,1; //Mami_Photo_Album
		set barmunt_crow,14;
		getitem 7796,1; //Author_Autograph
		getitem 7797,1; //Author_Memo
		getitem 617,1; //Old_Violet_Box
		warp "que_ba",270,270;
		end;
	}
	else if (barmunt_crow == 14) {
		mes "["+ strcharinfo(0) +"]";
		mes "这个梦似乎有某种重要意义。";
		mes "我最好把这张便笺还给他。";
		next;
		mes "["+ strcharinfo(0) +"]";
		mes "打扰一下，希尔珀特先生。";
		next;
		cutin "oliver_think",2;
		mes "[奥利弗·希尔珀特]";
		mes ".................";
		mes ".................";
		mes "...........嗯？";
		next;
		cutin "oliver_think",255;
		mes "你打断了他的写作，感到有些过意不去。";
		next;
		mes "["+ strcharinfo(0) +"]";
		mes "我想这是你掉的。";
		next;
		mes "^660000你翻找口袋寻找便笺时，恰好把在图书馆外捡到的乌鸦羽毛掉了出来。就在这时……^000000";
		next;
		mes "（啪！）";
		specialeffect EF_VENOMDUST;
		specialeffect2 EF_DETOXICATION;
		next;
		mes "^660000奥利弗比你更快地捡起羽毛，在你来得及说话前就把它撕成了碎片。^000000";
		next;
		mes "^660000你愤怒地看着他，发现他变成了完全不同的人；他不再显得愚蠢或严肃，而是冷酷无情。^000000";
		next;
		cutin "oliver_hum",2;
		mes "[奥利弗·希尔珀特]";
		mes "呃？！";
		mes "这根羽毛怎么了？";
		next;
		mes "[奥利弗·希尔珀特]";
		emotion ET_KEK;
		mes "哇！这是我做的吗？";
		mes "天啊，对不起！真的对不起！";
		next;
		mes "^660000他恢复了原样，开始为自己突然暴怒向你道歉。^000000";
		next;
		emotion ET_CRY;
		mes "[奥利弗·希尔珀特]";
		mes "我……我不知道该怎么道歉……";
		mes "只是……我当时太生气了，所以我——！唉，对不起！";
		next;
		mes "["+ strcharinfo(0) +"]";
		mes "没关系。我只是恰好在街上捡到它，你不用道歉。";
		next;
		mes "[奥利弗·希尔珀特]";
		mes "既然你这么说，谢谢你的理解。";
		mes "呼，我刚才真是内疚……";
		next;
		mes "["+ strcharinfo(0) +"]";
		mes "给，把你的便笺拿回去。";
		next;
		mes "[奥利弗·希尔珀特]";
		mes "哦，你直接扔掉就行。它已经没用了。";
		mes "呼……";
		next;
		cutin "oliver_pre",2;
		mes "[奥利弗·希尔珀特]";
		mes "我现在灵感如泉涌。抱歉，我得走了。";
		next;
		cutin "oliver_pre",255;
		mes "^660000他一和你说完话，就回到写作中，完全沉浸在自己的工作里。^000000";
		next;
		mes "["+ strcharinfo(0) +"]";
		mes "他的专注力真惊人。";
		mes "看来不是谁都能写出畅销书，对吧？";
		next;
		mes "["+ strcharinfo(0) +"]";
		mes "……等等，我已经不打喷嚏了……";
		mes "头痛和胸口的沉重感也消失了！";
		next;
		mes "["+ strcharinfo(0) +"]";
		mes "难道这一切都是那根乌鸦羽毛造成的？难道……？";
		next;
		switch(select("是鹅卵石诅咒了它。:乌鸦与奥利弗有关。")) {
		case 1:
			mes "["+ strcharinfo(0) +"]";
			mes "啊，我明白了。";
			mes "我想乌鸦被鹅卵石击中后，它的智慧一定变成了灾祸。";
			next;
			mes "["+ strcharinfo(0) +"]";
			mes "啊，都是图书馆馆长害的！";
			mes "幸好羽毛已经消失了，希望我不会再遭遇灾祸。";
			next;
			break;
		case 2:
			mes "["+ strcharinfo(0) +"]";
			mes "我记得齐德先生说过，伊娃曾留下了一根黑色羽毛。";
			next;
			mes "["+ strcharinfo(0) +"]";
			mes "而且那名女助手变成乌鸦飞走了，之后乌鸦羽毛让我打喷嚏、咳嗽。";
			next;
			mes "["+ strcharinfo(0) +"]";
			mes "..................";
			next;
			mes "["+ strcharinfo(0) +"]";
			mes "没错，希尔珀特先生的灵魂被乌鸦诅咒了！";
			mes "不知道他是不是也像图书馆馆长一样向乌鸦扔过石头……";
			next;
			mes "["+ strcharinfo(0) +"]";
			mes "..................";
			mes "我想这主意太蠢了。";
			next;
			break;
		}
		mes "["+ strcharinfo(0) +"]";
		mes "算了，随它去吧。";
		mes "重要的是我已经痊愈了！";
		mes "如果再做梦，到时候再处理吧~";
		next;
		mes "^660000离开图书馆时，你觉得还是把奥利弗先生当作自己的另一半比较好。^000000";
		next;
		mes "["+ strcharinfo(0) +"]";
		mes "真有趣，不过也挺累的。下一场冒险该去哪里呢？";
		set barmunt_crow,15;
		completequest 2068;
		close2;
		cutin "",255;
		end;
	}
	else {
		mes "^660000一个面相可疑的年轻人正在扫视路人的脸，仿佛在寻找某个人。^000000";
		close;
	}
}

yuno_in04,167,120,3	script	Worn-out Book#garas	111,{
	if (checkweight(617,3) == 0) {
		mes "- 你的背包中物品太多，无法继续此任务。-";
		close;
	}
	if (barmunt_crow == 12) {
		if (countitem(7795) < 1) {
		mes "- 你感觉自己好像落下了什么重要的东西。-";
			close;
		}
		mes "^660000考虑到这本书最近才出版，封面却已经严重破损。一定有很多人翻阅过它。^000000";
		next;
		mes "^660000你小心地翻开第一页，担心自己又会做奇怪的梦。^000000";
		next;
		mes ".........................";
		mes ".........................";
		mes ".........................";
		next;
		mes "< 他从小就开始做梦——那时他甚至还记不清自己究竟有多小——梦境把他从未见过、从未学过的庞大知识灌入脑海。";
		mes "在外人眼中，他只是个小男孩，却比任何成年贤者都睿智。他流利地说着多种语言，听起来就像奥丁吟唱的《埃达》。";
		mes "对他来说，那座狭小昏暗的地下村庄是一座监狱，阻碍他满足好奇心和对自由的渴望。";
		mes "他向继母伊娃表达想了解更多外界知识的愿望，但她总是用严厉的目光无视他的请求。";
		mes "最终，她不合理的劝阻再也无法阻止他逃离现实。";
		mes " ";
		mes "- 喘气！喘气！-";
		mes "他在仿佛没有尽头的黑暗中奔跑，逃离一切试图束缚他的事物。>";
		next;
		mes ".........................";
		mes ".........................";
		mes ".........................";
		next;
		mes "< - 嗯……-";
		mes "-……他醒了。-";
		mes "- 你好，看得见我吗？感觉怎么样？-";
		mes "一位老人慢慢走进房间，面带微笑坐到椅子上。小男孩第一次见到村外的人，害怕了一会儿，";
		mes "但随后还是强撑着从床上坐起来，环顾四周。";
		mes " ";
		mes "- 我在哪里？为什么会在这里？-";
		mes "- 我昨晚坐马车时发现你躺在街上。我叫海吉。你可以叫我海吉先生，孩子。-";
		mes "-.......-";
		mes "- 你叫什么名字？-";
		mes "-......阿尔。-";
		mes "- 你知道自己为什么躺在街上吗？住在哪里？你的父母一定很想见你。-";
		mes "海吉的话立刻让阿尔想起了怪物般的伊娃。他在心里恐惧地尖叫。";
		mes "- 我无处可住，也没有父母。-";
		mes "阿尔想，无论如何都必须撒谎。老人似乎理解了他，眼中流露出对小男孩的同情。海吉坚持说阿尔可以想住多久就住多久。";
		mes "后来得知海吉是朱诺市大学的教授后，阿尔确信命运站在自己这边。>";
		next;
		mes ".........................";
		mes ".........................";
		mes ".........................";
		next;
		mes "^660000你读书时感到有人盯着自己。转过头后，发现一个打扮时髦却形迹可疑的年轻人。^000000";
		next;
		cutin "oliver_pre",2;
		mes "^660000年轻人走近你，面带笑容地与你握手。^000000";
		next;
		mes "[可疑的男人]";
		mes "嘿，你在读《命运的踪迹》！";
		mes "哈哈哈，很高兴认识你。我就是那本书的作者。我来看看新书《命运之鸦》的反响如何，能遇到我的粉丝真是荣幸！虽然有点不好意思，但还是谢谢你！嘿嘿。";
		next;
		mes "["+ strcharinfo(0) +"]";
		mes "咳咳，不，我不是粉……";
		next;
		mes "[奥利弗·希尔珀特]";
		mes "哦，对了！你想要我的签名吗？";
		next;
		mes "（唰唰）";
		next;
		mes "[奥利弗·希尔珀特]";
		mes "^660000他从包里拿出一大张纸，飞快地画了些什么，然后递给你。^000000";
		next;
		mes "哈哈，看看。我把签名写得尽可能大，你可以拿去向朋友炫耀！";
		next;
		mes "[奥利弗·希尔珀特]";
		mes "你知道，我只是把梦里看到的东西写了下来，没想到大家会这么喜欢我的故事！真让我意外。";
		next;
		mes "["+ strcharinfo(0) +"]";
		mes "梦？";
		next;
		cutin "oliver_think",2;
		mes "[奥利弗·希尔珀特]";
		mes "是的，我做的梦非常逼真，简直像现实一样。";
		mes "听说伟大的作家通常从梦中寻找灵感。我想我天生就是其中之一。哈哈哈！";
		next;
		mes "你对这个所谓的梦感到不舒服。你想弄清楚读书时看到的一切究竟意味着什么。";
		mes "如果奥利弗梦见了和你完全相同的事情，或许意味着你们共享着梦境。而且，你已经发现书中的洞穴村庄确实存在。";
		next;
		mes "["+ strcharinfo(0) +"]";
		mes "主角阿尔正在做梦……";
		next;
		cutin "oliver_pre",2;
		mes "[奥利弗·希尔珀特]";
		mes "哇！";
		mes "那不是在那边吗？！";
		emotion ET_HUK;
		next;
		mes "["+ strcharinfo(0) +"]";
		mes "嗯？";
		next;
		mes "^660000你顺着他的视线迅速转过头，却只看到自己的包。^000000";
		next;
		mes "["+ strcharinfo(0) +"]";

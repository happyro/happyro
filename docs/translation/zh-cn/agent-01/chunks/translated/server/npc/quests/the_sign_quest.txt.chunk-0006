			case 1:
				mes "[皮鲁·皮鲁]";
				mes "我的主人乔尔先生正在研究创造人工生命的方法！";
				mes "不过这并不容易，我们还没有任何成果……";
				next;
				mes "[皮鲁·皮鲁]";
				mes "主人把所有时间都花在研究上，也不好好照顾自己，";
				mes "体重掉了很多。我真的很担心他。";
				close;
			case 2:
				mes "[皮鲁·皮鲁]";
				mes "哦，你说那对炼金术士父女？";
				mes "你知道他们因为发明了魔物药水召唤技能而失踪了吗？";
				next;
				mes "[皮鲁·皮鲁]";
				mes "他们的发现在科学界引起了巨大恐慌。";
				mes "最后他们只能隐居在^CE3131南方的森林^000000深处。";
				next;
				mes "[皮鲁·皮鲁]";
				mes "他们像我的主人一样，把一生都献给了研究。";
				mes "如果主人取得重大突破，我们也必须像他们一样消失……";
				close;
			case 3:
				mes "[皮鲁·皮鲁]";
				mes "嗯？这个嘛，我什么都不知道。";
				mes "事实上我一直待在实验室里，从来听不到外面的传闻或消息。";
				close;
			}
		}
		else {
			emotion ET_CRY;
			mes "哦，我好累啊~";

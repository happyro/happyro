			mes "力量可能令人上瘾。";
			mes "即使你不同意，避免贪婪的倾向也很明智，对吧？";
			next;
			mes "[大云]";
			mes "请好好利用你获得的力量。";
			mes "我希望你负责任，永远不要失去脸上的笑容，好吗？";
			mes "哇哈哈~！";
			close;
		case 2:
			emotion ET_SCRATCH;
			mes "[大云]";
			mes "呃……？真令人意外。";
			mes "也许梅兹对它了解得不够？";
			mes "不过，听说你不喜欢它，我很遗憾。";
			next;
			mes "[大云]";
			mes "但无论如何，请记住你一定从这次经历中学到了重要的一课。";
			mes "总之，请尽力负责任地使用力量，好吗？哇哈哈~！";
			close;
		}
	}
	else if (sign_q == 15) {
		mes "[大云]";
		mes "嗯……？";
		mes "你不是要去艾尔帕兰寻找^CE0000乔尔先生^000000吗？";
		next;
		mes "[大云]";
		mes "哦，找不到他吗？";
		mes "他比较害羞，但我相信他正藏在城里的某个地方。";
		close;
	}
	else {
	mes "[大云]";
	mes "啊，我感觉……";
	mes "好满足。食物美味极了，";
	mes "女人们更是如此。";
	mes "仆人！请帮我扇风~";
		next;
			mes "[大云]";
		mes "^333333*Yawn...*";
		mes "...z...z...Z....ZZzZZ^000000";
		close;
	}
	close;
}

aldeba_in,139,103,5	script	Monograph#sign	111,{
	mes "[乔尔先生]";
	mes "呜哇~！";
	mes "别再读我的研究专著了！";
	mes "马上放回去！";
	close;
}

aldeba_in,155,101,3	script	Sir Jore#sign	805,7,7,{
	callfunc "F_UpdateSignVars";
	if ((gettime(DT_HOUR) > 16) && (gettime(DT_HOUR) < 22)) {
		if (sign_q == 15) {
			mes "["+ strcharinfo(0) +"]";
			mes "不好意思……";
			next;
			emotion ET_HUK;
			mes "^313FFF*Clink*^000000";
			next;
			mes "[乔尔先生]";
			mes "...";
			mes "......";
			next;
			emotion ET_PROFUSELY_SWEAT;
			mes "[乔尔先生]";
			mes "...";
			mes "......";
			mes "……不！看看你让我做了什么！";
			next;
			emotion ET_CRY;
			mes "[乔尔先生]";
			mes "我摆弄这个样本五个小时了。现在全毁了！^333333*抽泣*^000000";
			next;
			emotion ET_CRY;
			mes "[乔尔先生]";
			mes "^333333*抽泣*^000000";
			mes "我来到这座城镇，就是为了不受打扰地专心研究。";
			mes "所以你为什么来这里？";
			next;
			switch(select("大云派我来的。:糟糕，抱歉。下次见~")) {
			case 1:
				emotion ET_SWEAT;
				mes "[乔尔先生]";
				mes "哦、哦！对了，你是来接受测试，获得哭泣星光碎片的。";
				next;
				emotion ET_PROFUSELY_SWEAT;
				mes "[乔尔先生]";
				mes "那么……呃，你叫什么名字？";
				next;
				select(strcharinfo(0) +"，谢谢。");
				mes "[乔尔先生]";
				mes "很、很高兴认识你。我叫乔尔，只是个喜欢研究的普通人。";
				mes "如果我看起来有点紧张，请见谅！我其实……不太擅长和人相处。";
				next;
				mes "[乔尔先生]";
				mes "糟糕……！既然你能找到我，肯定还会有其他人！";
				mes "我什么时候才能做研究？！不、不！我讨厌人类！！";
				next;
				mes "[乔尔先生]";
				mes "不过我答应过梅兹，而且他是我的朋友。";
				mes "所以我必须接待一些客人，即使有几百人敲我的门……";
				next;
				mes "[乔尔先生]";
				mes "不过首先，我需要一个新的研究样本。";
				mes "既然是你毁了上一个样本，就由你帮我取得新的吧。";
				next;
				mes "[乔尔先生]";
				mes "现、现在别担心。材料其实很容易取得，难的是五小时的研究过程。";
				mes "那么，让我看看……";
				next;
				set sign_q,16;
				mes "[乔尔先生]";
				mes "带给我 10 个空试管、10 个绿色药草和 2 片世界树叶。";
				next;
				mes "[乔尔先生]";
				mes "你看，我最近一直在研究生物学。";
				mes "我认为生命的秘密可以在世界树叶中找到。";
				mes "毕竟它们可以让死者复活。";
				next;
				emotion ET_SWEAT;
				mes "[乔尔先生]";
				mes "还有，请务必在我晚上 10 点（太平洋时间）睡觉前把材料带来。";
				mes "你知道，我有固定的作息时间。";
				close;
			case 2:
				emotion ET_CRY;
				mes "[乔尔先生]";
				mes "我花了五个小时观察研究样本的变化。";
				mes "所有辛苦都白费了！^333333*哇~！*^000000";
				close;
			}
		}
		else if (sign_q == 16) {
			if ((countitem(1092) > 9) && (countitem(610) > 1) && (countitem(511) > 9)) {
				delitem 1092,10; //Empty_Cylinder
				delitem 610,2; //Leaf_Of_Yggdrasil
				delitem 511,10; //Green_Herb
				set sign_q,17;
				emotion ET_THANKS;
				mes "[乔尔先生]";
				mes "啊！谢、谢谢你带来我需要的东西。";
				mes "现在我可以继续研究了。";
				mes "还有，让我看看你是否有资格获得哭泣星光。";
				next;
				mes "[乔尔先生]";
				mes "现在说说你的任务。";
				mes "你听说过^CE3131贤者之石^000000吗？关于它的传闻到处流传，";
				mes "但没人确认过真相，"+ strcharinfo(0) +"。";
				next;
				mes "[乔尔先生]";
				mes "虽然我也不知道贤、贤者之石究竟是什么，";
				mes "但我直觉认为需要它才能让生物学研究更进一步。";
				mes "这就是你要帮助我的地方。";
				next;
				set sign_q,17;
				mes "[乔尔先生]";
				mes "我需要你调查贤者之石，找到一对父女。";
				mes "他们曾是著名炼金术士，后来隐居在森林深处，但我相信他们知道些什么。";
				close;
			}
			else {
				mes "[乔尔先生]";
				mes "请带给我 10 个空试管、10 个绿色药草和 2 片世界树叶，";
				mes "这样我就能制作新的研究样本。";
				close;
			}
		}
		else if (sign_q == 17) {
			mes "[乔尔先生]";
			mes "我要你找到一对炼金术士父女。";
			mes "他们隐居在某片森林深处，这样我就能进一步了解贤者之石。";
			next;
			mes "[乔尔先生]";
			mes "当然，这可能推进我的研究，";
			mes "也能让我判断你是否有资格获得哭泣星光碎片。";
			close;
		}
		else if (sign_q < 15) {
			mes "[乔尔先生]";
			mes "生命的奥秘。";
			mes "探索生命秘密的渴望驱使我进行所有研究并作出牺牲。";
			next;
			mes "[乔尔先生]";
			mes "我、我对自己的能力并不自信，但我相信世间万物都有规律。";
			mes "可是，试图创造神未曾赋予的生命，我会受到惩罚吗？";
			next;
			mes "[乔尔先生]";
			mes "但我现在不能停下。总有一天会有人揭开生命的秘密。";
			mes "为什么不能是我？那种知识会让人类超越其他种族……";
			close;
		}
		else if (sign_q == 19) {
			mes "[乔尔先生]";
			mes "啊，你回来了。";
			mes "那么，你查到贤者之石究竟是什么了吗？";
			next;
			mes "["+ strcharinfo(0) +"]";
			mes "我不确定，但听说它是红色的，可以治愈人。";
			mes "不过也许是我们已经熟悉的东西。";
			next;
			mes "[乔尔先生]";
			mes "就这些……？也许它终究只是传闻。";
			mes "不、不管怎样，请告诉我你觉得它可能是什么。";
			next;
			input .@input$;
			if (compare(.@input$,"red gemstone")) {
				mes "[乔尔先生]";
				mes "什么……！嗯。";
				mes "也许我该忘掉贤者之石，继续做研究。";
				mes "不过，依赖传闻真让我羞愧……";
				next;
				set sign_q,20;
				getitem 7177,1; //Part_Of_Star's_Sob
				mes "[乔尔先生]";
				mes "非常感谢你帮助我。现在我可以回去继续研究，";
				mes "并希望没人打扰我。但那是不可能的。^333333*叹气……*^000000";
				next;
				mes "[乔尔先生]";
				mes "好、好吧，你赢得了这块哭泣星光。";
				mes "下一块碎片要去魔法之城吉芬找^0063FF杰斯库里安女士^000000。她经常旅行，应该在旅馆里。";
				next;
				mes "[乔尔先生]";
				mes "好、好吧。祝你顺利收集所有哭泣星光碎片，"+ strcharinfo(0) +"。再见~";
				close;
			}
			else {
				mes "[乔尔先生]";
				mes "呃……？我想我没听懂。你说了什么？";
				close;
			}
		}
		else if (sign_q == 20) {
			mes "[乔尔先生]";
			mes "现在你必须去吉芬找^0063FF杰斯库里安女士^000000。祝你通过她的测试。";
			close;
		}
		else {
			mes "[乔尔先生]";
			mes "这应该怎么运作？这样吗？不！不对！";
			mes "想想，乔尔，想想……答案是什么？！";
			close;
		}
	}
	else if ((gettime(DT_HOUR) > 6) && (gettime(DT_HOUR) < 17)) {
		mes "^3355FF你发现一个紧张的男人站在书堆中，手指间夹着试管。";
		mes "不知为何，他看起来非常痛苦。";
		next;
		switch(select("和他说话。:忽略他。")) {
		case 1:
			mes "["+ strcharinfo(0) +"]";
			mes "不好意思……";
			next;
			mes "[乔尔先生]";
			mes "...";
			mes "......";
			next;
			mes "^3355FF这个奇怪的男人沉浸在思绪中，听不见你的声音。^000000";
			next;
			switch(select("再试一次。:忽略他。")) {
			case 1:
				mes "["+ strcharinfo(0) +"]";
				mes "不好意思！";
				next;
				mes "[乔尔先生]";
				mes "...!";
				mes "哦，你、你好。抱歉，我现在有点忙。";
				mes "请在下午 5 点（太平洋时间）准时回来，好吗？";
				next;
				mes "[乔尔先生]";
				mes "让我看看……如果重新校准排气装置，";
				mes "生物中子分析仪就需要调整细胞质平衡……";
				close;
			case 2:
				mes "^3355FF你决定不打扰他，让他继续自言自语并摆弄试管。^000000";
				close;
			}
		case 2:
			mes "^3355FF你决定不打扰他，让他继续自言自语并摆弄试管。^000000";
			close;
		}
	}
	else {
		mes "[乔尔先生]";
		mes "……z……z……Z";
		close;
	}
	close;

OnTouch_:
	if (rand(2)) {
		emotion ET_AHA;
		specialeffect EF_PHARMACY_OK;
	}
	else {
		emotion ET_HUK;
		specialeffect EF_PHARMACY_FAIL;
	}
	end;
}


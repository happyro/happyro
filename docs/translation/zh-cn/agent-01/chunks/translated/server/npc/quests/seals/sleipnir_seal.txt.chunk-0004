						switch(select("好，我们以后再讲。:不，请继续。")) {
						case 1:
							mes "[拉妮娅]";
							mes "我知道我的故事可能不太有趣。但下次我会尽力让你开心。旅途请注意安全。";
							close;
						case 2:
							mes "[拉妮娅]";
							mes "哦，好吧。";
							mes "那我继续讲。";
							next;
							break;
						}
						mes "[拉妮娅]";
						mes "众神对陌生人荒唐的要求十分愤怒。然而洛基向奥丁提议，";
						mes "可以让陌生人重建他们的防御城墙。";
						next;
						mes "[拉妮娅]";
						mes "洛基建议，如果陌生人能完成大部分城墙修复，但比约定时间晚，众神就不必支付任何报酬。";
						next;
						mes "[拉妮娅]";
						mes "奥丁决定采纳洛基的建议，告诉陌生人必须在 6 个月内修好城墙，而不是陌生人提出的 18 个月。且不得得到任何人的帮助。";
						next;
						mes "[拉妮娅]";
						mes "如果能满足这些条件，陌生人就会得到他要求的报酬。由于他只是人类，这看起来不可能。";
						next;
						mes "[拉妮娅]";
						mes "嗯……";
						mes "我知道故事很长。你想继续听，还是需要休息一下？";
						next;
						switch(select("让我先记些笔记。:我需要休息！:不，请继续。")) {
						case 1:
							mes "[拉妮娅]";
							mes "Ah....";
							mes "我知道故事很长，抱歉。好吧，我等你写完笔记。";
							next;
							mes "...";
							mes "......";
							mes ".........";
							next;
							mes "...";
							mes "......";
							mes ".........";
							mes "............";
							next;
							mes "...";
							mes "......";
							mes ".........";
							mes "............";
							mes "...............";
							next;
							mes "...";
							mes "......";
							mes ".........";
							mes "............";
							mes "...............";
							mes "..................";
							next;
							mes "[拉妮娅]";
							mes "我可以继续讲故事了吗？";
							next;
						select("好的，请吧。");
							mes "[拉妮娅]";
							mes "好，现在……";
							mes "我讲到哪里了？";
							next;
							break;
						case 2:
							mes "[拉妮娅]";
							mes "我知道 Sleipnir 的故事很长。如果你有耐心，下次我再讲给你听。再见~";
							close;
						case 3:
							mes "[拉妮娅]";
							mes "哦，太好了。";
							mes "那请让我继续。";
							next;
							break;
						}
						mes "[拉妮娅]";
						mes "陌生人坚持要用自己的马帮助重建。因为那匹马看起来普通又朴素，奥丁同意了。";
						next;
						mes "[拉妮娅]";
						mes "奥丁没有多想就答应了，";
						mes "但看到陌生人第一天重建城墙的表现后，他立刻后悔了。";
						mes "看到陌生人第一天重建城墙的表现后，他立刻后悔了。";
						next;
						mes "[拉妮娅]";
						mes "奇怪的是，陌生人让马搬运材料，以非人的速度重建城墙。";
						next;
						mes "[拉妮娅]";
						mes "这让众神不安，因为陌生人其实是伪装的强大巨人。";
						mes "不过这没有违反约定，所以众神无能为力。";
						next;
						mes "[拉妮娅]";
						mes "虽然陌生人技艺高超，但他的马大大加快了城墙重建速度。那就是传说中的魔马斯瓦迪尔法利。";
						next;
						mes "[拉妮娅]";
						mes "城墙似乎会在六个月期限前完工，众神越来越焦急。阿斯加德人很快对洛基大发雷霆。";
						next;
						mes "[拉妮娅]";
						mes "尽管如此，洛基仍很冷静，向众神保证自己有计划。众神不信任他的狡猾，随着陌生人的工作迅速推进而变得绝望。";
						next;
						mes "[拉妮娅]";
						mes "随后，城墙重建突然停止。马斯瓦迪尔法利失踪了，众神和陌生人都同样惊讶。";
						next;
						mes "[拉妮娅]";
						mes "陌生人现在只能";
						mes "继续";
						mes "独自工作。";
						next;
						mes "[拉妮娅]";
						mes "嗯……";
						mes "你还在听吗？如果累了，我们可以";
						mes "暂时停下来。";
						next;
						switch(select("I'm so exhausted!:No, please go ahead.")) {
						case 1:
							mes "[拉妮娅]";
							mes "我知道故事可能太长了。如果你想再听，我很乐意重讲。谢谢你聆听，冒险家。";
							close;
						case 2:
							mes "[拉妮娅]";
							mes "哦，好吧，";
							mes "那我继续。";
							next;
							break;
						}
						mes "[拉妮娅]";
						mes "出于好奇，众神决定调查斯瓦迪尔法利的失踪。";
						next;
						mes "[拉妮娅]";
						mes "出人意料的是，";
						mes "他们发现";
						mes "斯瓦迪尔法利爱上了一匹美丽的母马，这就是";
						mes "它不再参与城墙工作。";
						next;
						mes "[拉妮娅]";
						mes "六个月过去时，陌生人几乎完成了阿斯加德城墙的重建，只剩城门没有修复。";
						next;
						mes "[拉妮娅]";
						mes "众神高兴地告诉陌生人，他们无需支付报酬，因为他没有按约定完成城墙。";
						next;
						mes "[拉妮娅]";
						mes "陌生人怒火中烧，指责众神欺骗他，不想用太阳、月亮和美丽的女神芙蕾雅支付报酬。随后，他揭露了真实身份。";
						next;
						mes "[拉妮娅]";
						mes "他是一个";
						mes "可怕的冰霜巨人，";
						mes "也就是传说中的霜巨人。";
						next;
						mes "[拉妮娅]";
						mes ".....";
						mes "无聊了吗？";
						mes "如果无聊，我们可以";
						mes "以后再聊这个。";
						mes "不用勉强自己。";
						next;
						switch(select("我好无聊~:不，请继续。")) {
						case 1:
							mes "[拉妮娅]";
							mes "我明白。故事本来就该享受，看来你现在没心情坐下来听。";
							next;
							mes "[拉妮娅]";
							mes "如果以后想听 Sleipnir 的故事，随时再来找我。祝你今天愉快~";
							close;
						case 2:
							mes "[拉妮娅]";
							mes "哦，我很高兴~";
							mes "有些人听这么久";
							mes "早就睡着了~";
							mes "你还真有耐心。";
							next;
							break;
						}
						mes "[拉妮娅]";
						mes "总之……";
						mes "陌生人原来是学习石工的巨人。";
						mes "虽然他正在入侵阿斯加德，众神却并不担心。";
						mes "他们相信自己能够应付。";
						next;
						mes "[拉妮娅]";
						mes "托尔迅速将强大的雷神之锤妙尔尼尔掷向巨人的头部，巨人的脑袋炸成了无数碎片。";
						next;
						mes "[拉妮娅]";
						mes "至于那匹马斯瓦迪尔法利，";
						mes "很长一段时间都不见踪影。";
						next;
						mes "[拉妮娅]";
						mes ".....";
						mes "无聊了吗？";
						mes "如果无聊，我们以后再聊。";
						mes "不用勉强自己。";
						next;
						switch(select("让我记些笔记。:下次见。:不，请继续。")) {
						case 1:
							mes "[拉妮娅]";
							mes "Ah....";
							mes "看来你真的想记住每个重要细节！";
							next;
							mes "[拉妮娅]";
							mes "抱歉，我会等你记完笔记。";
							next;
							mes "...";
							mes "......";
							mes ".........";
							next;
							mes "...";
							mes "......";
							mes ".........";
							mes "............";
							next;
							mes "...";
							mes "......";
							mes ".........";
							mes "............";
							mes "...............";
							next;
							mes "...";
							mes "......";
							mes ".........";
							mes "............";
							mes "...............";
							mes "..................";
							next;
							mes "[拉妮娅]";
							mes "现在可以继续讲故事了吗？";
							next;
							select("好的，请继续。");
							mes "[拉妮娅]";
							mes "好。嗯……";
							mes "我刚才讲到哪里了？";
							next;
							break;
						case 2:
							mes "[拉妮娅]";
							mes "哦，我想我的故事确实不太有趣。如果你还想再听，欢迎再次来找我。";
							next;
							mes "[拉妮娅]";
							mes "好吧，";
							mes "旅途平安~";
							close;
						case 3:
							mes "[拉妮娅]";
							mes "好。嗯……";
							mes "我刚才讲到哪里了？";
							next;
							break;
						}
						mes "[拉妮娅]";
						mes "过了一阵子，衣衫褴褛、疲惫不堪的洛基带着一匹长着八条腿的奇怪小马来到阿斯加德。";
						next;
						mes "[拉妮娅]";
						mes "洛基把这匹小马介绍为‘Sleipnir’，并将它";
						mes "作为礼物送给奥丁。";
						next;
						mes "[拉妮娅]";
						mes "事实上，洛基变成了诱惑斯瓦迪尔法利的母马，让它无法再修建城墙。";
						next;
						mes "[拉妮娅]";
						mes "所以，Sleipnir 是由传说中的母马斯瓦迪尔法利和变成马匹的神祇洛基共同诞生的。";
						next;
						mes "[拉妮娅]";
						mes "口耳相传的故事，在细节上可能会因讲述者不同而有所差异。";
						next;
						mes "[拉妮娅]";
						mes "不过，故事的主线不应改变。";
						next;
						mes "[拉妮娅]";
						mes "我平时很少练习讲故事，也不太确定自己讲的 Sleipnir 传说是否真实。";
						next;
						mes "[拉妮娅]";
						mes "但希望你能理解我已经尽力了。这是我能为你做的全部。";
						next;
						mes "[拉妮娅]";
						mes "如果想再听这个故事，随时欢迎。";
						mes "冒险路上请注意安全~";
						if (god_sl_2 == 1) {
							set god_sl_2,2;
						} else if (god_sl_2 == 3) {
							set god_sl_2,4;
						}
						close;
					}
				case 2:
					mes "[拉妮娅]";
					mes "痛苦时，请回顾过去，帮助自己找到解决办法。";
					next;
					mes "[拉妮娅]";
					mes "就像古老的神话传说，你的经历也是能让你学到宝贵教训的故事。";
					close;
				}
			}
			else {
				mes "[拉妮娅]";
				mes "我把知道的一切都告诉你了，希望能帮到你。请以同样的慷慨与善意对待他人。";
				close;
			}
		}
		else {
			mes "[拉妮娅]";
			mes "训练并不只是锻炼身体和精神。";
			next;
			mes "[拉妮娅]";
			mes "你的生活方式以及与他人的相处方式，也可以算作训练的一部分。";
			next;
			mes "[拉妮娅]";
			mes "每个人都会根据自己的日常生活，以不同方式学习并受益。";
			close;
		}
	}
	else {
		mes "[拉妮娅]";
		mes "训练并不只是锻炼身体和精神。";
		next;
		mes "[拉妮娅]";
		mes "你的生活方式以及与他人的相处方式，也可以算作训练的一部分。";
		next;
		mes "[拉妮娅]";
		mes "每个人都会根据自己的日常生活，以不同方式学习并受益。";
		close;
	}
}

que_god01,84,95,0	script	Switch#God0	111,{
	if ((god_sl_1 > 1) && (god_sl_1 < 51)) {
		mes "^3355FF门锁着。你把临时通行证插入门右侧的安全装置，门解锁了。^000000";
		next;
		warp "que_god01",60,88;
		end;
	}
	else {
		mes "^3355FF门锁着。";
		mes "右侧有某种安全装置。";
		mes "似乎需要检测某种通行证";
		mes "后才能进入。^000000";
		close;
	}
}


		mes "[长者]";
		mes "政府造成了这场悲剧！";
		emotion ET_FRET, getnpcid(0, "Senior#16nego04");
		npctalk "政府造成了这场悲剧！", "Senior#16nego04", bc_self;
		next;
		cutin "16loo_01.bmp",0;
		mes "[新手]";
		mes "好吧。你们就永远住在这个与世隔绝的地方吧！可是那些对这件事一无所知的孩子呢？";
		next;
		mes "[长者]";
		mes "喂，小子！你知道那天我们承受了多少痛苦吗？";
		emotion ET_ANGER, getnpcid(0, "Senior#16nego04");
		npctalk "即使是孩子也必须知道真相！", "Senior#16nego04", bc_self;
		next;
		mes "[新手]";
		mes "我不知道！可是如果我们不说出来，别人就永远不会知道。你去外面随便问问吧。";
		next;
		cutin "16loo_03.bmp",0;
		mes "[新手]";
		mes "问问他们是否知道那天发生的事。我敢说没人知道。如果我们不谈论这件事，别人又怎么可能发现真相？";
		npctalk "我们这样活着究竟意味着什么？", "Rookie#16nego02", bc_self;
		next;
		cutin "16loo_01.bmp",0;
		mes "[新手]";
		mes "你讨厌帮助那个曾经抛弃我们的政府？这说明我们过去对他们来说一文不值，可现在他们需要我们的帮助。这算是对我们的补偿吗？";
		next;
		cutin "16loo_03.bmp",0;
		mes "[新手]";
		mes "既然他们需要我们的帮助，我们也可以利用他们。我们已经不像过去那么弱小了。";
		next;
		cutin "16loo_01.bmp",0;
		mes "[新手]";
		mes "如果你想复仇，也许这就是机会！复仇不一定非要诉诸武力。";
		next;
		mes "[长者]";
		mes "你还年轻，也不够明智。无论发生什么，我们都不会帮助政府。绝不！";
		npctalk "这是赶走那些危险思想家伙的机会！", "Senior#16nego01", bc_self;
		npctalk "你不喜欢这里，那为什么还和我们住在一起？", "Senior#16nego02", bc_self;
		sleep2 500;
		npctalk "把他们赶出去。", "Senior#16nego03", bc_self;
		next;
		cloakoffnpcself( "Gonie#16nego04" );
		cutin "16go_03.bmp",2;
		mes "[戈尼]";
		mes "......";
		next;
		cutin "16loo_01.bmp",0;
		mes "[新手]";
		mes "戈尼？";
		next;
		cutin "16go_03.bmp",2;
		mes "[戈尼]";
		mes "......";
		npctalk "确实如此……", "Rookie#16nego02", bc_self;
		next;
		cutin "",255;
		mes "[长者]";
		mes "他突然出现后到底在说什么？";
		next;
		mes "[长者]";
		mes "你还在进行无声冥想吗？";
		next;
		cutin "16loo_01.bmp",0;
		mes "[新手]";
		mes "为了那份恩情……";
		next;
		cutin "16lei_02.bmp",2;
		mes "[懒惰者]";
		mes "你听到了吗？他正在进行无声冥想。真是记仇！";
		npctalk "哈……这个地方到处都是怪物。", "", bc_self;
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "安静。我全都听见了。";
		next;
		cutin "16loo_01.bmp",0;
		mes "[新手]";
		mes "……戈尼说，我们必须为他们曾经给予他的帮助付出代价。";
		next;
		mes "[长者]";
		mes "哼。他们帮的是你，不是我们。";
		npctalk "我们什么都不欠你。", "Senior#16nego02", bc_self;
		sleep2 300;
		npctalk "是他们欠你的。", "Senior#16nego03", bc_self;
		next;
		mes "[长者]";
		mes "你们两个这么想帮他们，就去帮吧。但记得把衣服脱下来！";
		npctalk "别告诉任何人你是反叛军成员！", "Senior#16nego01", bc_self;
		next;
		cutin "16lei_01.bmp",2;
		mes "[懒惰者]";
		mes "你听到了吗？他们真酷。";
		npctalk "我喜欢他们！", "", bc_self;
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "我全都听见了。";
		unittalk getcharid(3), "" + strcharinfo(0) + " : And it's not like that.", bc_self;
		next;
		cutin "16go_03.bmp",2;
		mes "[戈尼]";
		mes "......";
		npctalk "真的吗？我也是这么想的。", "Rookie#16nego02", bc_self;
		next;
		mes "[长者]";
		mes "那家伙说了什么？";
		npctalk "他是怎么理解的？", "Senior#16nego02", bc_self;
		npctalk "新手有很强的能力。", "Senior#16nego03", bc_self;
		next;
		cutin "16loo_01.bmp",0;
		mes "[新手]";
		mes "他说二楼的所有人都决定帮助他们。";
		next;
		mes "[长者]";
		mes "什么？女士们和鲁珀特也要帮忙？";
		npctalk "厄斯特和埃琳娜？不可能！", "Senior#16nego04", bc_self;
		next;
		cutin "16loo_03.bmp",0;
		mes "[新手]";
		mes "你好奇的话就上楼确认一下。他们可能会拍拍你的背。";
		npctalk "听起来这里的所有人都很酷。", "", bc_self;
		next;
		cutin "16loo_01.bmp",0;
		mes "[新手]";
		mes "看来我们大多数人都同意了。如果你还反对，我不觉得会有什么好事发生。";
		next;
		cutin "16lei_01.bmp",2;
		mes "[懒惰者]";
		mes "呼……先生，你现在打算怎么办？呵呵。";
		emotion ET_SMILE;
		npctalk "看来决定已经做出了。", "", bc_self;
		sleep2 300;
		unittalk getcharid(3), "" + strcharinfo(0) + "：你刚才是不是说了‘呵呵’？", bc_self;
		next;
		cutin "",255;
		mes "[长者]";
		mes "糟糕……既然女士们和鲁珀特都同意了，我们也别无选择……";
		npctalk "糟糕……我们别无选择……", "Senior#16nego04", bc_self;
		npctalk "如果大家都这么想……", "Senior#16nego03", bc_self;
		sleep2 500;
		npctalk "为什么所有人都这么容易被说服？", "Senior#16nego01", bc_self;
		next;
		mes "[长者]";
		mes "但我永远不会信任你们！我会一直盯着你们！！！";
		next;
		cutin "16lei_02.bmp",2;
		cloakonnpcself( "Senior#16nego01" );
		mes "[懒惰者]";
		mes "哦，多么热情的求婚。我这辈子从没遇到过这种事。感觉有点害羞。";
		npctalk "真酷。", "", bc_self;
		next;
		cutin "",255;
		mes "[长者]";
		mes "在堵住那张大嘴之前我不会走！我不走！";
		npctalk "我不走！", "Senior#16nego02", bc_self;
		sleep2 300;
		npctalk "喂，规矩点，我们回去吧。我们得制定对策。", "Senior#16nego03", bc_self;
		sleep2 500;
		npctalk "好吧，我得把他扛回去。", "Senior#16nego04", bc_self;
		next;
		cloakonnpcself( "Senior#16nego02" );
		cloakonnpcself( "Senior#16nego03" );
		cloakonnpcself( "Senior#16nego04" );
		cutin "16go_03.bmp",2;
		mes "[戈尼]";
		mes "......";
		next;
		cutin "16loo_02.bmp",0;
		mes "[新手]";
		mes "好。这里交给我处理。你进去准备吧。";
		next;
		cutin "16lei_01.bmp",0;
		cloakonnpcself( "Gonie#16nego04" );
		mes "[懒惰者]";
		mes "我从没想过事情会如此完美地解决。这多亏了你。谢谢。";
		npctalk "幸福总是与我同在。", "", bc_self;
		next;
		cutin "16lei_03.bmp",2;
		mes "[懒惰者]";
		mes "请去给他们传个消息。告诉他们‘苍鹭展翅’，他们就会明白。";
		npctalk "那是什么？苍鹭？", "Rookie#16nego02", bc_self;
		sleep2 300;
		npctalk "好奇？你真的好奇吗？", "", bc_self;
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "我要一个人去吗？你不是得亲自传达消息吗？";
		next;
		cutin "16lei_01.bmp",2;
		mes "[懒惰者]";
		mes "我要留在这里。哈哈哈。我很喜欢这个家伙，我们可以一起工作。";
		npctalk "你觉得怎么样？你喜欢，对吧？", "", bc_self;
		next;
		cutin "16loo_01.bmp",0;
		mes "[新手]";
		mes "和我一起工作？我不觉得自己能为你做什么有用的事。";
		next;
		cutin "16lei_03.bmp",2;
		mes "[懒惰者]";
		mes "没错。这正是你应该改变的地方：自信。对你来说，缺乏信心导致了缺乏自信。";
		next;
		cutin "16lei_01.bmp",2;
		mes "[懒惰者]";
		mes "自信可以靠自己获得，也可以通过成就或他人的认可获得。但在这里不可能。这个地方就像一套不合身的衣服。";
		next;
		cutin "16lei_03.bmp",2;
		mes "[懒惰者]";
		mes "只要有一个人信任你，你就能无限成长。";
		next;
		mes "[懒惰者]";
		mes "你可能还没意识到，但你已经在对这里的每个人这样做了。他们都依靠着你。再多相信自己一点吧。";
		next;
		cutin "16lei_02.bmp",2;
		mes "[懒惰者]";
		mes "如果你不明白，就相信我。因为我相信你。";
		unittalk getcharid(3), "" + strcharinfo(0) + "：这就叫‘无限自信’。", bc_self;
		next;
		cutin "16lei_03.bmp",2;
		emotion ET_BEST;
		mes "[懒惰者]";
		mes "现在世代已经交替。今天是旧世代的最后一天，也是新世代的第一天。而你就是连接两者的纽带。";
		next;
		cutin "16lei_01.bmp",2;
		mes "[懒惰者]";
		mes "你太优秀了，不该把才能浪费在这里。";
		next;
		cutin "16lei_03.bmp",2;
		mes "[懒惰者]";
		mes "首先，你有能力发现我有特殊目的。你也找到了对反叛军有帮助的东西，然后鼓起勇气付诸实施。你还有人性……";
		next;
		mes "[懒惰者]";
		mes "只要稍加磨炼，你就能展翅高飞。你应该动脑子。为什么要靠体力劳动让自己受苦？";
		npctalk "翅膀？所以这就是你提到苍鹭时的意思？", "Rookie#16nego02", bc_self;
		sleep2 300;
		npctalk "严格来说不是。但就当它们相似吧。", "", bc_self;
		next;
		cutin "16lei_02.bmp",2;
		mes "[懒惰者]";
		mes "如果你愿意，我可以帮助你。你觉得怎么样？我需要一个搭档，我相信我们能组成很棒的二人组。";
		unittalk getcharid(3), "" + strcharinfo(0) + "：你说过要和我组成二人组。", bc_self;
		sleep2 300;
		npctalk "冒险者，我知道你很快就会离开我。", "", bc_self;
		next;
		cutin "16loo_01.bmp",0;
		mes "[新手]";
		mes "哦，你能详细解释一下吗？";
		next;
		cutin "16lei_01.bmp",2;
		mes "[懒惰者]";
		mes "当然。我有的是时间。对了，我一直待在这里没问题吗？";
		emotion ET_BEST;
		next;
		cutin "16loo_02.bmp",0;
		mes "[新手]";
		mes "我们现在是在合作，对吧？";
		emotion ET_BEST, getnpcid(0, "Rookie#16nego02");
		npctalk "我们？你说‘我们’？你们真酷。", "", bc_self;
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "你不觉得你在别人家里招揽他太明显了吗？";
		next;
		cutin "16lei_02.bmp",2;
		mes "[懒惰者]";
		mes "这有什么问题吗？你们有这样一个有才华的人，却没有发挥他的能力，不是吗？他可有才华了！";
		unittalk getcharid(3), "" + strcharinfo(0) + "：我觉得你把他当成了物品。", bc_self;
		next;
		cutin "16go_03.bmp",2;
		cloakoffnpcself( "Gonie#16nego04" );
		mes "[戈尼]";
		mes "......";
		next;
		cutin "16loo_01.bmp",0;
		mes "[新手]";
		mes "戈尼？";
		next;
		mes "[戈尼]";
		mes "......";
		npctalk "已经准备好了吗？", "Rookie#16nego02", bc_self;
		next;
		cutin "16lei_01.bmp",2;
		mes "[懒惰者]";
		mes "他说了什么？";
		next;
		cutin "16loo_01.bmp",0;
		mes "[新手]";
		mes "他说我们已经安排好一个人来推进合作。你去商店方向的通道，就能见到那个人。";
		npctalk "谢谢。", "Rookie#16nego02", bc_self;
		cloakonnpcself( "Gonie#16nego04" );
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "好。我会去见那个人，听听他的想法。";
		next;
		cutin "16lei_01.bmp",2;
		mes "[懒惰者]";
		mes "冒险者，今后我得和你长谈。所以就拜托你了。你去那里时，别忘了利用那个地方。我是说‘那个地方’。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "什么？我明白了……回头见。";
		next;
		mes "[懒惰者]";
		mes "哎呀！等一下！我差点忘了。这是为这次任务特别准备的奖励，全都给你。你可以用它们兑换有用的东西。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "荣誉徽章？";
		next;
		mes "[懒惰者]";
		mes "楼梯旁那个无聊的中年人似乎会收取徽章。他叫斯特拉塞。感兴趣的话就去找他吧。";
		next;
		mes "[懒惰者]";
		mes "我把所有东西都给你了。再见。替我向总统问好！！";
		npctalk "就算他想念我，也请告诉他再等一会儿。", "", bc_self;
		sleep2 300;
		npctalk "冒险者，请再来拜访我们。", "Rookie#16nego02", bc_self;
		erasequest 14614;// Convince the leaders
		setquest 14615;// Between negotiation and deception
		getitem 25155,10;	// Swz_Honor_Token
		getexp 1000000,500000;
		terra_gloria_main = 17;
		questinfo_refresh();
		close3;
	}
	cutin "16lei_01.bmp",2;
	mes "[懒惰者]";
	mes "哟！欢迎！要来杯茶吗？你把消息准确传达了吗？";
	close3;

OnInit:
	// questinfo( QTYPE_QUEST, QMARK_NONE, "isbegin_quest(14614) == 0 && isbegin_quest(14599) == 1" );	// no questinfo
	questinfo( QTYPE_QUEST, QMARK_NONE, "isbegin_quest(14615) == 0 && isbegin_quest(14602) == 2 && isbegin_quest(11462) == 2" );
	end;
}
// Old Lady Room - Outside
rebel_in,121,43,5	duplicate(dummy_cloaked_npc)	Rebellion Guard leader#1	4_M_REBELLION

function	script	F_TerraGloria_Lady	{
	if (terra_gloria_main < 16 || terra_gloria_lady_part == 0) {
		mes "[反叛军卫兵]";
		mes "对不起。";
		mes "您不能进入这里。";
		close;
	}
	if (terra_gloria_main == 16 && terra_gloria_lady_part == 1) {
		mes "[反叛军卫兵]";
		mes "对不起。";
		mes "您不能进入这里。";
		next;
		select("告诉卫兵是新手派你来的。");
		mes "[反叛军卫兵]";
		mes "新手？";
		npctalk "反叛军卫兵：新手？", "Rebellion guard#162gmbs1", bc_self;
		npctalk "反叛军卫兵：新手？", "Rebellion guard#162gmbs2", bc_self;
		next;
		mes "[反叛军卫兵]";
		mes "那家伙怎么回事？";
		mes "虽然是他派你来的，但你不能进去。";
		mes "请回去吧。";
		next;
		cloakoffnpcself( "Rebellion Guard leader#1" );
		mes "[反叛军卫队长]";
		mes "这里为什么这么吵？";
		npctalk "反叛军卫队长：安静！", "Rebellion Guard leader#1", bc_self;
		emotion ET_FRET, getnpcid(0, "Rebellion Guard leader#1");
		next;
		mes "[反叛军卫兵]";
		mes "对不起!!!!";
		npctalk "反叛军卫兵：对不起!!!!", "Rebellion guard#162gmbs1", bc_self;
		npctalk "反叛军卫兵：对不起!!!!", "Rebellion guard#162gmbs2", bc_self;
		next;
		mes "[反叛军卫队长]";
		mes "闭嘴！";
		mes "你觉得我告诉过你多少次要安静！";
		next;
		mes "[反叛军卫兵]";
		mes "对不起……";
		mes "这个人说是新手派他/她来的，想要进去。";
		next;
		mes "[反叛军卫队长]";
		mes "新手？";
		npctalk "反叛军卫队长：新手？", "Rebellion Guard leader#1", bc_self;
		next;
		mes "[反叛军卫队长]";
		mes "啊……那个孩子？";
		next;
		mes "[反叛军卫队长]";
		mes "是那个孩子派你来的。那又怎样？";
		next;
		mes "[反叛军卫队长]";
		mes "你……你就是刚才在楼下闹事的那个人。";
		npctalk "卫队长：你和那个看起来很懒散的家伙一起来的。", "Rebellion Guard leader#1", bc_self;
		next;
		mes "[反叛军卫队长]";
		mes "我不知道是什么把你带到这里的。但我不能让你进去。";
		mes "别再闹了。回去！";
		next;
		select("再次请求他。");
		mes "[反叛军卫队长]";
		mes "向我求情也改变不了任何事。";
		mes "不行。";
		next;
		select("再次请求他。");
		mes "[反叛军卫队长]";
		mes "我说不行！";
		mes "你真烦人！";
		npctalk "反叛军卫队长：我说不行。就这样！", "Rebellion Guard leader#1", bc_self;
		next;
		mes "[反叛军卫队长]";
		mes "要不是首领下了命令，我现在就能把你打晕在这里……";
		next;
		mes "[？？？]";
		mes "……外面真吵。";
		mes "怎么回事？拉尔西斯。";
		emotion ET_HUK, getnpcid(0, "Rebellion Guard leader#1");
		next;
		mes "[反叛军卫队长拉尔西斯]";
		mes "没什么。";
		next;
		mes "[反叛军卫队长拉尔西斯]";
		mes "喂，现在就离开。";
		mes "你再闹下去会惹上麻烦的。";
		emotion ET_PROFUSELY_SWAT, getnpcid(0, "Rebellion Guard leader#1");
		next;
		if (select( "对他大喊。", "回去。" ) == 2) {
			mes "[反叛军卫队长拉尔西斯]";
			mes "好主意。";
			mes "出口在楼下。去那里吧。";
			npctalk "反叛军卫队长：喂～喂～走开！", "Rebellion Guard leader#1", bc_self;
			cloakonnpcself( "Rebellion Guard leader#1" );
			close;
		}
		mes "[反叛军卫队长拉尔西斯]";
		mes "你刚才那是什么意思！";
		mes "你真没礼貌！";
		mes "你现在想死吗？";
		emotion ET_HUK, getnpcid(0, "Rebellion Guard leader#1");
		npctalk "反叛军卫队长：喂！！给我安静！！！！！", "Rebellion Guard leader#1", bc_self;
		next;
		mes "[？？？]";
		mes "哎呀！";
		mes "这是我从未听过的声音。是帮助过那个孩子的冒险者吗？";
		next;
		select("回答是。");
		mes "[？？？]";
		mes "拉尔西斯。";
		mes "我们不能把恩人留在外面。让冒险者进来吧。";
		mes "让我给他/她泡杯茶。";
		next;
		mes "[反叛军卫队长拉尔西斯]";
		mes "可是……迪恩！！！";
		next;
		mes "[迪恩]";
		mes "......";
		next;
		mes "[反叛军卫队长拉尔西斯]";
		mes "……我明白了。";
		mes "跟我来。";
		npctalk "反叛军卫队长：唉……我会被首领责骂的……", "Rebellion Guard leader#1", bc_self;
		next;
		mes "[反叛军卫队长拉尔西斯]";
		mes "如果你敢无礼，就别想活着回去。";
		npctalk "反叛军卫队长：要是出了什么差错，我们就一起死！", "Rebellion Guard leader#1", bc_self;
		cloakonnpcself( "Rebellion Guard leader#1" );
		erasequest 11454;// Doubt
		setquest 11455;// Doubt
		terra_gloria_lady_part = 2;
		close2;
		warp "rebel_in",158,83;
		end;
	}
	return;
}


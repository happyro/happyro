			mes "祝你好运。这项工作有风险，";
			mes "但并非不可能。";
			close;
		}
		mes "[莱斯廷]";
		mes "你找到要找的东西了？";
		mes "那一定像是在";
		mes "草堆里找针，";
		mes "但你还是做到了。";
		mes "干得漂亮，伙计~";
		next;
		mes "[莱斯廷]";
		mes "幸好你及时找到了它。";
		mes "虽然偷到更多";
		mes "情报会有帮助，";
		mes "但继续逗留";
		mes "只会让我们";
		mes "更容易被发现。";
		next;
		mes "[莱斯廷]";
		mes "好了，你最好";
		mes "马上离开这里，";
		mes "去找艾苏娜。注意身后，";
		mes "一定要小心。事情结束前，";
		mes "我们都还不算安全。";
		next;
		mes "[莱斯廷]";
		mes "艾苏娜应该就在";
		mes "里希塔乐城外，";
		mes "就是你上次找";
		mes "到她的地方。";
		mes "她会知道你要来。";
		delitem 7349,1; //Indication_Of_Member02
		set lhz_boss,36;
		changequest 12026,12027;
		close;
	}
	else
	{
		mes "[莱斯廷]";
		mes "天啊……";
		mes "这里的每个人都";
		mes "过于疑神疑鬼了！";
		mes "你现在最好暂时";
		mes "离这里远一点。";
		mes "……";
		close;
	}
}

lhz_in01,187,31,0	script	#Sneak	HIDDEN_NPC,4,3,{

	end;

OnTouch_:
	if((lhz_boss > 27) && (lhz_boss < 35))
	{
		set @sneaktime,gettimetick(0) % 100;
		if((@sneaktime > 10 && @sneaktime < 59) || (@sneaktime < -10 && @sneaktime > -59))
		{
			mes "^3355FF你靠近拐角时，";
			mes "听见墙那边传来";
			mes "压低声音的耳语";
			mes "。^000000";
			next;
			mes "[资深卫兵]";
			mes "喂，我的班要结束了。";
			mes "快叫下一个人来换班";
			mes "，行吗？";
			next;
			mes "[新手卫兵]";
			mes "已经到时间了？";
			mes "哇，时间过得真快。";
			mes "好吧，在这";
			mes "里等一会儿。";
			next;
			mes "^3355FF一";
			mes "名卫兵离开了岗位，";
			mes "现在只剩一名卫兵";
			mes "监视这片区域。^000000";
			next;
			mes "[资深卫兵]";
			mes "天哪……";
			mes "我得去趟洗手间。";
			mes "嗯，我不在的时候";
			mes "应该不会发";
			mes "生什么事。";
			next;
			mes "^3355FF你";
			mes "听着卫兵的脚步声";
			mes "渐渐远去，";
			mes "越来越微弱。^000000";
			next;
			switch( select( "Sneak in now.","Wait for another chance." ) )
			{
				case 1:
					mes "^3355FF这";
					mes "是潜入秘密档案馆的";
					mes "绝佳机会！你走近门边，";
					mes "发现有一台设备，";
					mes "可以插入莱斯廷的通行卡";
					mes "。^000000";
					next;
					switch( select( "Insert Card","Retreat" ) )
					{
						case 1:
							if(!countitem(7349))
							{
								mes "^3355F";
							mes "^3355FF你忘了带上";
								mes "莱斯廷给你的通行卡。";
								mes "你需要它才能打开这扇门";
								mes "。^000000";
								close;
							}
							mes "^3355FF插入通行卡后，";
							mes "门内的面板滑开，";
							mes "露出数字键盘。";
							mes "你需要输入正确的密码";
							mes "才能打开这扇门";
							mes "。^000000";
							next;
L_Enter:
							input @sneakpass;
							if(@sneakpass == 738495)
							{
								mes "^3355FF*哔~*";
								mes "你听到悦耳的";
								mes "电子提示音，";
								mes "说明你输入了";
								mes "正确的密码。";
								mes "门自动滑开了。";
								next;
								switch( select( "Enter","Retreat" ) )
								{
									case 1:
										mes "[安全系统]";
										mes "你有 3 分钟时间";
										mes "搜索信息档案。";
										mes "时间一到";
										mes "，出于安全原因，";
										mes "你会被自动送到外面。";
										close2;
										set lhz_boss,29;
										donpcevent "Timer_Sneak::OnEnter";
										warp "lhz_in01",177,35;
										end;

									case 2:
										mes "^3355FF";
										mes "也许现在不是进入";
										mes "秘密档案馆的最佳时机。";
										mes "至少你自己是这么决定的";
										mes "。^000000";
										close;
								}
							}
							mes "^3355FF*吱——*";
							mes "你输入密码后，";
							mes "门发出令人不";
							mes "安的尖锐叫声。";
							mes "你真的应该再试一次";
							mes "。^000000";
							set @sneakerror,@sneakerror +1;
							next;
							if(@sneakerror > 2)
							{
									mes "[安全系统]";
									mes "*滋滋滋*";
									mes "你已经连续 3 次";
									mes "输入错误密码。";
									mes "请等待管理人员";
									mes "前来协助。";
									next;
									mes "^3355FF糟了！";
									mes "你最好在被抓住前";
									mes "赶紧离开这里";
									mes "！^000000";
									close2;
									warp "lhz_in01",191,49;
									end;
							}

							goto L_Enter;

						case 2:
							mes "^3355FF";
							mes "也许现在不是进入";
							mes "秘密档案馆的最佳时机。";
							mes "至少你自己是这么决定的";
							mes "。^000000";
							close;
					}
				case 2:
					mes "^3355FF";
					mes "也许现在不是进入";
					mes "秘密档案馆的最佳时机。";
					mes "至少你自己是这么决定的";
					mes "。^000000";
					close;
			}
			donpcevent "Door#sneak::OnSneak";
			end;
		}
	}
}

lhz_in01,177,44,0	script	Timer_Sneak	HIDDEN_NPC,8,12,{

OnTouch_:
	warp "lhz_in01",191,49;
	end;

OnInit:
	disablenpc "Timer_Sneak";
	end;

OnEnter:
	stopnpctimer;
	initnpctimer;
	end;

OnTimer180000:
	enablenpc "Timer_Sneak";
	end;

OnTimer190000:
	stopnpctimer;
	disablenpc "Timer_Sneak";
	end;
}



lhz_in01,182,35,0	script	File Search Engine	HIDDEN_NPC,{

	if((lhz_boss > 28) && (lhz_boss < 35))
	{
		mes "^3355FF";
		mes "这台机器可以用来";
		mes "在秘密档案馆内查找";
		mes "特定文件。";
		mes "不过，你必须输入正确的";
		mes "关键词，才能找到";
		mes "文件的具体位置。";
		next;
L_Search:
		switch( select( "Search Engine.","Cancel." ) )
		{
			case 1:
				mes "^663300- 搜索引擎已启动 -";
				mes "- 请输入关键词 -";
				mes " ";
				mes "*搜索引擎";
				mes "区分大小写。";
				mes "请不要使用";
				mes "大写字母。^000000";
				next;
				input @sneaksearch$;
				if((@sneaksearch$ == "kafra") || (@sneaksearch$ == "cool event"))
				{
					mes "^663300[搜索结果]";
					mes "关于卡普拉公司和";
					mes "酷事件公司的文件";
					mes "位于竞技场 3-2";
					mes "。^000000";
					set lhz_boss,30;
					close;
				}
				else if(@sneaksearch$ == "shinokas")
				{
					mes "^663300[搜索结果]";
					mes "关于希诺卡斯的文件";
					mes "位于竞技场 1-5";
					mes "。^000000";
					set lhz_boss,31;
					close;
				}
				else if((@sneaksearch$ == "stein") || (@sneaksearch$ == "STEIN") || (@sneaksearch$ == "S.T.E.I.N"))
				{
					mes "^663300[搜索结果]";
					mes "关于 S.T.E.I.N";
					mes "的文件";
					mes "属于高度机密，";
					mes "无法通过此系统访问";
					mes "。^000000";
					close;
				}
				else if(@sneaksearch$ == "ymir")
				{
					mes "^66330";
					mes "0[搜索结果]";
					mes "关于尤弥尔之心的文件";
					mes "属于高度机密，";
					mes "无法通过此系统访问";
					mes "。^000000";
					close;
				}
				else if((@sneaksearch$ == "president") || (@sneaksearch$ == "karl") || (@sneaksearch$ == "weierstrass"))
				{
					mes "^663300[搜索结果]";
					mes "关于卡尔·魏尔斯特拉斯总统的";
					mes "二级文件位于区域 1-7。";
					mes "如需访问更高级";
					mes "别的机密文件，";
					mes "请使用更高安全级别的档案馆";
					mes "。^000000";
					set lhz_boss,32;
					close;
				}
				else if(@sneaksearch$ == "einbroch")
				{
					mes "^663300[搜索结果]";
					mes "关于艾音布罗克的文件";
					mes "存放在区域 6-1";
					mes "。^000000";
					set lhz_boss,33;
					close;
				}
				else if(@sneaksearch$ == "lighthalzen")
				{
					mes "^663300[搜索结果]" ;
					mes "关于里希塔乐的文件";
					mes "存放在区域 3-3";
					mes "。^000000";
					set lhz_boss,34;
					close;
				}
				else if(@sneaksearch$ == "rekenber")
				{
					mes "^663300[搜索结果]";
					mes "关于雷根贝勒的文件属于高度机密，";
					mes "无法通过此系统访问。^000000";
					next;
					goto L_Search;
				}
				else
				{
					mes "^663300[搜索结果]";
					mes "找不到关键词。";
					mes "请搜索其他档案，";
					mes "或提高访问权限";
					mes "。^000000";
					close;
				}

			case 2:
				mes "^663300";
				mes "[关闭搜索引擎]";
				mes "文件搜索已取消。请注意，";
				mes "突然关闭可能会";
				mes "导致系统错误。^000000";
				close;
		}
	}
	mes "^3355FF这";
	mes "台机器原本可以用来";
	mes "在秘密档案馆内查找";
	mes "特定文件，不过你现在";
	mes "已经不需要继续搜索文件了";
	mes "。^000000";
	close;
}


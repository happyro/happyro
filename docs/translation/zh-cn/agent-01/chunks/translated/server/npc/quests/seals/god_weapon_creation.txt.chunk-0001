gld_dun01,28,85,0	script	Grunburti#1::GodDwarf	826,{
	mes "[矮人格伦布尔蒂]";
	mes "人类？！";
	mes "这片土地到处都是你们这种人。";
	mes "你来这里做什么？";
	next;
	mes "[矮人格伦布尔蒂]";
	mes "离开家乡生活在米德加尔特已经够痛苦了，何况还要面对一个爱抱怨的人类。别烦我！";
	next;
	switch(select("询问矮人:询问他在做什么:请求制作武器:取消")) {
	case 1:
		mes "[矮人格伦布尔蒂]";
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
		mes "关于矮人有什么好了解的？";
		mes "我们是最坚韧的种族。无论环境多么恶劣，我们都能生活。";
		next;
		mes "[矮人格伦布尔蒂]";
		mes "我怀疑你那脆弱的头脑能否理解，在我的故乡生活有多么难熬，";
		mes "不过你可以试着想象一下。";
		next;
		mes "[矮人格伦布尔蒂]";
		mes "你们人类引以为傲的大多数知识和技能，恐怕都是矮人传下来的。";
		next;
		mes "[矮人格伦布尔蒂]";
		mes "锻造尤其如此。就连诸神的工具和武器也是我的祖先制作的。你知道吗？";
		next;
		mes "[矮人格伦布尔蒂]";
		mes "我们拥有最伟大的知识和技艺，却接受了生活在巨人寒冷荒芜之地的命运。";
		close;
	case 2:
		mes "[矮人格伦布尔蒂]";
		mes "你刚才问我在这里做什么？哇哈哈哈！当然是在等愚蠢到敢来这里的人类，";
		mes "好把他们踢出去！";
		next;
		mes "[矮人格伦布尔蒂]";
		mes "别担心，和你这样的弱者战斗只会让我丢脸。人类如此脆弱，却固执地抱着傲慢彼此争斗。";
		next;
		mes "[矮人格伦布尔蒂]";
		mes "你们这个种族无可救药。我甚至不想和人类待在同一块大陆上！但唉，我别无选择。";
		next;
		mes "[矮人格伦布尔蒂]";
		mes "千年前战争结束后，通往我故乡的道路消失了。";
		mes "不知为何，我再也找不到穿过世界树回去的路……";
		next;
		mes "[矮人格伦布尔蒂]";
		mes "我被困在米德加尔特。";
		mes "至少我很幸运找到了这个洞窟。毕竟我们矮人最喜欢住在地下。";
		close;
	case 3:
		set .@GID,getcharid(2);
		if (($God1 < $@god_check2) || ($God2 < $@god_check2) || ($God3 < $@god_check2) || ($God4 < $@god_check2)){
			if (($God1 >= $@god_check1) && ($God2 >= $@god_check1) && ($God3 >= $@god_check1) && ($God4 >= $@god_check1) && (is_guild_leader() == true)) {
				mes "[矮人格伦布尔蒂]";
				mes "嗯……";
				mes "我需要一些东西来为你制作武器。你具体想要哪一件？";
				next;
				switch(select("布里希加曼:梅金吉耶德:斯莱普尼尔:雷神之锤")) {
				case 1:
					mes "[矮人格伦布尔蒂]";
					mes "我需要……";
					mes "^0000FF4 个芙蕾雅的宝石";
					mes "4 个银饰";
					mes "3 个雪晶";
					mes "3 个涟漪";
					mes "3 个飘荡的空气";
					mes "2 个蓝宝石";
					mes "3 个珍珠";
					mes "10 个蛋白石";
					mes "5 个诅咒红宝石";
					mes "20 个黄金^000000";
					mes "1 条项链^000000……";
					next;
		mes "[矮人格伦布尔蒂]";
					mes "不过现在还不是制作布里希加曼的时候。等封印解除后再来吧。哇哈哈哈！";
					close;
				case 2:
					mes "[矮人格伦布尔蒂]";
					mes "我需要……";
					mes "^0000FF1 个格莱普尼尔";
					mes "20 个黄金";
					mes "10 个蓝宝石";
					mes "10 个神之金属";
					mes "1 条腰带^000000";
					next;
		mes "[矮人格伦布尔蒂]";
					mes "不过梅金吉耶德的封印还没有解除。在那之前请耐心等待！哇哈哈哈！";
					close;
				case 3:
					mes "[矮人格伦布尔蒂]";
					mes "我需要……";
					mes "^0000FF3 个未知之轮";
					mes "5 根天使之翼羽毛";
					mes "3 个鱼之魂";
					mes "4 个太阳神徽章";
					mes "3 个精灵之息";
					mes "20 个黄金";
					mes "10 个铝";
					mes "1 双带洞长靴^000000";
					next;
		mes "[矮人格伦布尔蒂]";
					mes "即便如此，在封印破除前我也无法制作斯莱普尼尔。人类，你只能自认倒霉了。哈哈哈~！";
					close;
				case 4:
					mes "[矮人格伦布尔蒂]";
					mes "我需要……";
					mes "^0000FF2 个托尔的护腕";
					mes "4 个铁处女";
					mes "5 个女武神之怒";
					mes "5 个暴风雨的预兆";
					mes "5 个波浪";
					mes "20 个神之金属";
					mes "5 个铝";
					mes "40 个黄金";
					mes "1 把震地锤^000000";
					next;
		mes "[矮人格伦布尔蒂]";
					mes "封印仍在的话，我连雷神之锤的仿制品都无法制作。在封印解除前，你只能等待。哇哈哈！";
					close;
				}
			} 
			mes "[矮人格伦布尔蒂]";
			mes "我们矮人太骄傲了，不会在卑微的人类面前展示技艺！";
			next;
			mes "[矮人格伦布尔蒂]";
			mes "别再烦我，滚出去！去和魔物玩吧，你这个头脑简单的蠢货！";
			close;
		}
		if (is_guild_leader() == false) {
			mes "[矮人格伦布尔蒂]";
			mes "我只会向地位极其高贵的人类展示高超技艺！";
			next;
			mes "[矮人格伦布尔蒂]";
			mes "虽然我讨厌大多数人类，但我不得不尊重被命运选中的人。把你的^0000FF公会会长^000000带来！";
			close;
		}
		mes "[矮人格伦布尔蒂]";
		mes "向人类展示我珍贵的技艺实在令人羞辱……";
		next;
		mes "[矮人格伦布尔蒂]";
		mes "所有封印都已解除，持有 Emperium 的人就是命运选中的人。我不得不尊重你。";
		next;
		mes "[矮人格伦布尔蒂]";
		mes "首先，我要确认你是否带齐了锻造神之物品所需的材料！我讨厌人类毫无目的地来到这里！";
		next;
		if ((countitem(7073) > 3) && (countitem(7077) > 3) && (countitem(7088) > 2) && (countitem(7090) > 2) && (countitem(7092) > 2) && (countitem(726) > 1) && (countitem(722) > 2) && (countitem(727) > 9) && (countitem(724) > 4) && (countitem(969) > 19) && (countitem(2603) > 0)) {
			mes "[矮人格伦布尔蒂]";
			mes "嗯……我想你想要^0000FF布里希加曼^000000！";
			next;
		}
		else if ((countitem(7058) > 0) && (countitem(969) > 19) && (countitem(726) > 9) && (countitem(984) > 9) && (countitem(2627) > 0)){ //Gullraifnir Gold Blue_Jewel Oridecon Belt 
			mes "[矮人格伦布尔蒂]";
			mes "嗯……我想你想要^0000FF梅金吉耶德^000000！";
			next;
		}
		else if ((countitem(7076) > 2) && (countitem(7079) > 4) && (countitem(7083) > 2) && (countitem(7086) > 3) && (countitem(7087) > 2) && (countitem(969) > 19) && (countitem(985) > 9) && (countitem(2406) > 0)) {
			mes "[矮人格伦布尔蒂]";
			mes "嗯……我想你想要^0000FF斯莱普尼尔^000000！";
			next;
		}
		else if ((countitem(7074) > 1) && (countitem(7075) > 3) && (countitem(7078) > 4) && (countitem(7089) > 4) && (countitem(7091) > 4) && (countitem(984) > 19) && (countitem(985) > 4) && (countitem(969) > 39) && (countitem(1522) > 0)) {
			mes "[矮人格伦布尔蒂]";
			mes "嗯……我想你想要^0000FF雷神之锤^000000！";
			next;
		}
		else {
		mes "[矮人格伦布尔蒂]";
			mes "...";
			mes "......";
			next;
		mes "[矮人格伦布尔蒂]";
			mes "...";
			mes "......";
			mes ".........";
			next;
		mes "[矮人格伦布尔蒂]";
			mes "...";
			mes "......";
			mes ".........";
			mes ".............";
			next;
			mes "[矮人格伦布尔蒂]";
			mes "你竟敢毫无准备地来这里？！忘了要带什么吗？这次听仔细！";
			next;
			switch(select("布里希加曼:梅金吉耶德:斯莱普尼尔:雷神之锤")) {
			case 1:
		mes "[矮人格伦布尔蒂]";
				mes "我需要……";
				mes "^0000FF4 个芙蕾雅的宝石";
				mes "4 个银饰";
				mes "3 个雪晶";
				mes "3 个涟漪";
				mes "3 个飘荡的空气";
				mes "2 个蓝宝石";
				mes "3 个珍珠";
				mes "10 个蛋白石";
				mes "5 个诅咒红宝石";
				mes "20 个黄金^000000";
				mes "1 条项链^000000……";
				next;
		mes "[矮人格伦布尔蒂]";
				mes "嗯，不过现在封印已经解除，";
				mes "你必须赶快，否则其他人类可能会抢先获得神之物品……";
				next;
		mes "[矮人格伦布尔蒂]";
				mes "快点……！";
				mes "一旦我铸造出布里希加曼，";
				mes "封印就会再次启动！";
				close;
			case 2:
		mes "[矮人格伦布尔蒂]";
				mes "我需要……";
				mes "^0000FF1 个格莱普尼尔";
				mes "20 个黄金";
				mes "10 个蓝宝石";
				mes "10 个神之金属";
				mes "1 条腰带^000000";
				next;
		mes "[矮人格伦布尔蒂]";
				mes "嗯，不过现在封印已经解除，";
				mes "你必须赶快，否则其他人类可能会抢先获得神之物品……";
				next;
		mes "[矮人格伦布尔蒂]";
				mes "快点……！";
				mes "一旦我铸造出梅金吉耶德，";
				mes "封印就会再次启动！";
				close;
			case 3:
		mes "[矮人格伦布尔蒂]";
				mes "我需要……";
				mes "^0000FF3 个未知之轮";
				mes "5 根天使之翼羽毛";
				mes "3 个鱼之魂";
				mes "4 个太阳神徽章";
				mes "3 个精灵之息";
				mes "20 个黄金";
				mes "10 个铝";
				mes "1 双带洞长靴^000000";
				next;
		mes "[矮人格伦布尔蒂]";
				mes "嗯，不过现在封印已经解除，";
				mes "你必须赶快，否则其他人类可能会抢先获得神之物品……";
				next;
		mes "[矮人格伦布尔蒂]";
				mes "快点……！";
				mes "一旦我铸造出斯莱普尼尔，";
				mes "封印就会再次启动！";
				close;
			case 4:
		mes "[矮人格伦布尔蒂]";
				mes "我需要……";
				mes "^0000FF2 个托尔的护腕";
				mes "4 个铁处女";
				mes "5 个女武神之怒";
				mes "5 个暴风雨的预兆";
				mes "5 个波浪";
				mes "20 个神之金属";
				mes "5 个铝";
				mes "40 个黄金";

que_god01,154,112,4	script	Grunburti#god	826,{
	if (($God1 < $@god_check2) || ($God2 < $@god_check2) || ($God3 < $@god_check2) || ($God4 < $@god_check2)){
		mes "[矮人格伦布尔蒂]";
		mes "一件神之物品已经制作完成，";
		mes "封印也已恢复。";
		mes "你必须等到它们再次全部解除……！";
		next;
		mes "[矮人格伦布尔蒂]";
		mes "哇哈哈哈哈哈哈！";
		mes "虽然你只是人类，";
		mes "但我还是有点同情你~";
		close;
	}
	set .@GID,getcharid(2);
	if (is_guild_leader() == false) {
		mes "[矮人格伦布尔蒂]";
		mes "怎么会……";
		mes "滚出去！";
		next;
		mes "[矮人格伦布尔蒂]";
		mes "你们这些蠢人类是怎么进来的？！";
		mes "只有持有 Emperium 的人，";
		mes "才有资格考虑进入这里……！";
		close;
	}
		mes "[矮人格伦布尔蒂]";
	mes "为人类工作实在令人羞辱。";
	mes "但既然命运选中了你作为 Emperium 的持有者，我只能满足你的请求。";
	next;
		mes "[矮人格伦布尔蒂]";
	mes "我们只有^FF000010 分钟^000000来重现一件神之宝物。";
	mes "之后封印会自行恢复，在再次解除前我将无法制作任何东西……";
	next;
		mes "[矮人格伦布尔蒂]";
	mes "^FF0000别磨蹭^000000，";
	mes "否则我会立即把机会交给另一个^FF0000人类^000000！";
	next;
		mes "[矮人格伦布尔蒂]";
	mes "现在……！";
	mes "选择你希望我制作的物品！";
	next;
	switch(select("布里希加曼:梅金吉耶德:斯莱普尼尔:雷神之锤")) {
	case 1:
		mes "[矮人格伦布尔蒂]";
		mes "布、布里希加曼？！";
		mes "我从没见过如此无礼的家伙……！";
		mes "除非由女神芙蕾雅佩戴，否则这条项链对我而言毫无意义。";
		next;
		mes "[矮人格伦布尔蒂]";
		mes "但我凭什么评判你的资格？这些宝物会凭自己的意志选择主人。";
		mes "让我们看看布里希加曼是否认可你！";
		next;
		mes "[矮人格伦布尔蒂]";
		mes "要重现这件神之宝物，我还需要以下材料……";
		next;
		mes "[矮人格伦布尔蒂]";
		mes "^0000FF4 个芙蕾雅的宝石";
		mes "4 个银饰";
		mes "3 个雪晶";
		mes "3 个涟漪";
		mes "3 个飘荡的空气";
		mes "2 个蓝宝石";
		mes "3 个珍珠";
		mes "10 个蛋白石";
		mes "5 个诅咒红宝石";
		mes "20 个黄金";
		mes "1 条项链^000000";
		next;
		switch(select("制作布里希加曼。:取消。")) {
		case 1:
			if ((countitem(7073) > 3) && (countitem(7077) > 3) && (countitem(7088) > 2) && (countitem(7090) > 2) && (countitem(7092) > 2) && (countitem(726) > 1) && (countitem(722) > 2) && (countitem(727) > 9) && (countitem(724) > 4) && (countitem(969) > 19) && (countitem(2603) > 0)){ //Jewel_Of_Prayer Silver_Fancy Crystal_Of_Snow Slilince_Wave Air_Stream Blue_Jewel Scarlet_Jewel White_Jewel Cardinal_Jewel_ Gold Necklace 
		mes "[矮人格伦布尔蒂]";
				mes "我做梦都没想过，";
				mes "自己会为一个人类制作这件杰作。请稍等。";
				next;
				if (($God1 < $@god_check2) || ($God2 < $@god_check2) || ($God3 < $@god_check2) || ($God4 < $@god_check2)){
		mes "[矮人格伦布尔蒂]";
					mes "但是……封印刚刚恢复。";
					mes "你必须等到它们再次全部解除……！";
					next;
		mes "[矮人格伦布尔蒂]";
					mes "哇哈哈哈哈哈哈！";
					mes "虽然你只是人类，";
					mes "但我还是有点同情你~";
					close;
				}
				delitem 7073,4;  //Jewel_Of_Prayer
				delitem 7077,4;  //Silver_Fancy
				delitem 7088,3;  //Crystal_Of_Snow
				delitem 7090,3;  //Slilince_Wave
				delitem 7092,3;  //Air_Stream
				delitem 726,2;  //Blue_Jewel
				delitem 722,3;  //Scarlet_Jewel
				delitem 727,10;  //White_Jewel
				delitem 724,5;  //Cardinal_Jewel_
				delitem 969,20;  //Gold
				delitem 2603,1;  //Necklace
				getitem 2630,1; // Brysinggamen
				set $God1,0;
				set $God2,0;
				set $God3,0;
				set $God4,0;
				announce "[Brisingamen] 已落入 [" + strcharinfo(0) + "] 手中，他是 [" + getguildname(.@GID) + "] 公会的会长。",bc_all;
		mes "[矮人格伦布尔蒂]";

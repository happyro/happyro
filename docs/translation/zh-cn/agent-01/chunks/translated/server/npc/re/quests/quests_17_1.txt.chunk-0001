ein_fild01,95,146,5	script	Kaya Tos#171_einf	4_EP17_KAYA,{
	if (isbegin_quest(17013) == 1) {
		cutin "ep171_kaya01",0;
		mes "[Kaya]";
		mes "我们到了，这是艾因布洛克山脉的 01 区-95-146 段。";
		mes "这里就是新实验室。";
		next;
		select("这里什么都没有。");
		cutin "ep171_kaya02",0;
		mes "[Kaya]";
		mes "我以为它在这里。拉兹一定在想^0000FF这是什么意思。^000000我一直坐在桌前看世界，以为自己的看法就是真相。";
		next;
		cutin "ep171_kaya01",0;
		mes "[Kaya]";
		mes "我听到和看到的一切……让我觉得有个看不见的人操纵着一切。这不是我以为可能发生的情形。";
		next;
		cutin "ep171_kaya02",0;
		mes "[Kaya]";
		mes "即使表面上一切正常，里面也隐藏着许多谎言。我被骗了。";
		next;
		mes "["+ strcharinfo(0) + "]";
		mes "如果不带着怀疑去调查，就看不见表面下的问题。";

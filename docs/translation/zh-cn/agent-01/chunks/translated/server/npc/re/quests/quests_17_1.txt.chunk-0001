einbroch,42,208,3	script	Lazy#171_einbr	4_M_LAZY,{
	if (isbegin_quest(7850) < 2) {
		cutin "16lei_03",2;
		mes "[Lazy]";
		mes "太好了，终于能透口气了，对吧。";
		mes "我们去朱诺吧。好吗？";
		close3;
	}
	if (isbegin_quest(17003) == 1) {
		cloakoffnpc "Kaya Tos#171_einbr",getcharid(0);
		cloakoffnpc "Aas#171_einbr",getcharid(0);
		cutin "16lei_01",2;
		mes "[Lazy]";
		mes "来，这里就是。到这边来。";
		next;
		select("我们要去哪儿？");
		cutin "16lei_02",2;
		mes "[Lazy]";
		mes "我正想确定目的地呢，冒险者。有 VIP 和我们一起时，我怎么能擅自决定？";
		next;
		cutin "16lei_01",2;
		mes "[Lazy]";
		mes "我们去哪儿？由 VIP 决定。我会跟着你选择的地方走。";
		next;
		cutin "ep171_kaya01",0;
		mes "[Kaya]";
		mes "调查不是应该去总部吗？";
		next;
		cutin "16lei_01",2;
		mes "[Lazy]";
		mes "调查不一定要去总部~";
		mes "我们先看看现状和手头的背景资料。";
		mes "然后再了解周边的情况。";
		next;
		mes "[Lazy]";
		mes "你知道怎么调查吗？要设定具体目标和详细计划。我对此略知一二~";
		next;
		mes "[Lazy]";
		mes "啊哈哈哈！礼貌，礼貌！要对我们的 VIP 客气！";
		npctalk "黛西说的话……虽然是真的，但听起来很不舒服。","Kaya Tos#171_einbr",bc_self;
		unittalk getcharid(3),strcharinfo(0) + "：我说得对吧？",bc_self;
		next;
		cutin "16lei_01",2;
		mes "[Lazy]";
		mes "不如从简单一点的事情开始，换一种方式展开调查？让 VIP 来选择吧。";
		next;
		cutin "ep171_kaya01",0;
		mes "[Kaya]";
		mes "那么，我该选什么？";
		next;
		cutin "16lei_01",2;
		mes "[Lazy]";
		mes "从名单上随机挑一个名字。如果由我来选，之后你们可能会说我操纵了结果。";
		npctalk "我就是不信任的化身~","",bc_self;
		next;
		cutin "ep171_kaya03",0;
		mes "[Kaya]";
		mes ".....";
		next;
		cutin "16lei_02",2;
		mes "[Lazy]";
		mes "你为什么那样看我？难道不相信我的真心？";
		npctalk "你喜欢我的真心吗？恐怕不行。我的心已经有主人了。","",bc_self;
		next;
		cutin "ep171_kaya01",0;
		mes "[Kaya]";
		mes "好，我选那个。接下来要做什么？";
		next;
		cutin "16lei_01",2;
		mes "[Lazy]";
		mes "让我看看……^0000CD帕特里克·考夫曼^000000。";
		mes "嗯……这个名字太长了，就叫他^0000CD帕特^000000吧。";
		next;
		select("别改他的名字！");
		cutin "16lei_02",2;
		mes "[Lazy]";
		mes "哦？这样不经济吗？有什么关系，用简称能节省时间。";
		mes "而且这是我们称呼这位科学家时可以使用的代号。";
		next;
		mes "[Lazy]";
		mes "我当特工很久了，知道这些事。有正式的处理方式，但不能告诉你这项情报。";
		unittalk getcharid(3),strcharinfo(0) + "：我已经不觉得惊讶了。",bc_self;
		npctalk "哦……有可能。","Kaya Tos#171_einbr",bc_self;
		next;
		cutin "16lei_01",2;
		mes "[Lazy]";
		mes "现在我们一起去找帕特好吗？里希塔乐镇在东边。那里常被称为^0000CD贫民窟^000000。当然，我们的 VIP 已经知道这些了，对吧？";
		mes "你应该在资料中读过。";
		npctalk "如你所见，没有误会，只有真相~","",bc_self;
		next;
		cutin "ep171_kaya03",0;
		mes "[Kaya]";
		mes "你的计划是什么？";
		next;
		cutin "16lei_03",2;
		mes "[Lazy]";
		mes "他从小就会捡来东西修好，再转卖出去。这种才能如今已经失传了。";
		next;
		mes "[Lazy]";
		mes "21 岁时，他获得了面向低收入家庭的特别奖项。这让身边的人非常嫉妒。";
		npctalk "家族的骄傲~嗯，不是很棒吗。","",bc_self;
		next;
		mes "[Lazy]";
		mes "5 个月后，他被调到另一处莱肯伯设施，此后就没有记录了。";
		mes "这就是关于帕特的全部资料。";
		npctalk "这就是我调查到的全部。","",bc_self;
		next;
		cutin "16lei_01",2;
		mes "[Lazy]";
		mes "我们的 VIP 选中了非常适合调查的对象。我为你鼓掌。这是个好主意。";
		mes "他不是名单上的普通人。";
		next;
		cutin "ep171_kaya01",0;
		mes "[Kaya]";
		mes "我们只调查他吗？其他人怎么办？";
		next;
		cutin "16lei_02",2;
		mes "[Lazy]";
		mes "我们人这么少，怎么调查这么多人？";
		mes "我们集中调查一个人，你不知道该怎么做吗？";
		next;
		cutin "16lei_03",2;
		mes "[Lazy]";
		mes "毕竟他们都是以相似的方式消失的。只要弄清其中一个发生了什么，就能知道其他人的情况。";
		next;
		select("我在这里要做什么？");
		cutin "16lei_01",2;
		mes "[Lazy]";
		mes "早上好~从现在开始，VIP，我们要和拉兹及他的队伍一起调查帕特从工作到莱肯伯再到现在的经历~";
		npctalk "哇~我通常会在这里得到掌声。","",bc_self;
		next;
		cutin "ep171_kaya03",0;
		mes "[Kaya]";
		mes "那又怎样？你调查时以为这是游戏吗？";
		npctalk "副会长，现在回去还不晚。","Aas#171_einbr",bc_self;
		next;
		cutin "16lei_03",2;
		mes "[Lazy]";
		mes "我看起来像是在开玩笑吗，VIP？";
		mes "我是认真的，你不相信我吗，VIP？";
		next;
		mes "[Lazy]";
		mes "我们会按照帕特的工作日程行动。沿着他的踪迹，就能更多了解他为何失踪。";
		next;
		cutin "16lei_02",2;
		mes "[Lazy]";
		mes "你从没好好看过里希塔乐镇。我来自大城市，知道几个可以开始调查的地方。";
		next;
		cutin "ep171_as01",1;
		mes "[Aas]";
		mes "你说里希塔乐镇是村子，是什么意思？";
		next;
		cutin "16lei_02",2;
		mes "[Lazy]";
		mes "卫兵，你累了吗？和朱诺相比，里希塔乐镇只是个小村子。";
		mes "朱诺是个很棒的地方。我经常这么说。朱诺是贤者之城。嗯，我会换种说法。";
		next;
		cutin "16lei_03",2;
		mes "[Lazy]";
		mes "卢恩·米德加尔特的宝石、王国的心脏，就是朱诺。每个人都应该至少去一次。";
		mes "如果有人问我卢恩·米德加尔特的未来，我敢用生命保证，那一定是光辉的朱诺。";
		unittalk getcharid(3),strcharinfo(0) + "：拉吉，你得谦虚一点。",bc_self;
		npctalk "啊啊啊。我爱朱诺。*笑*","",bc_self;
		next;
		cutin "16lei_01",2;
		mes "[Lazy]";
		mes "总之，到处旅行没有比这更好的事了。";
		mes "欺骗别人也很不错。谁会怀疑游客呢？对吧？";
		npctalk "VIP 会走特别行程，我们在那里等你。","",bc_self;
		next;
		cutin "ep171_kaya01",0;
		mes "[Kaya]";
		mes "我们真的要这样做吗？去总部调查？";
		next;
		cutin "16lei_01",2;
		mes "[Lazy]";
		mes "有些事情无法从文件中了解。如果对方不知道黄色，VIP 能向他解释黄色是什么吗？";
		next;
		mes "[Lazy]";
		mes "直接给那个人看黄色的花并解释，不是更快吗？";
		next;
		cutin "ep171_kaya01",0;
		mes "[Kaya]";
		mes "资料之外有很多我不知道的事。这也是我和你一起来的部分原因。";
		next;
		cutin "16lei_01",2;
		mes "[Lazy]";
		mes "没错。你觉得不舒服吗？但这就是事实。只有亲口交流才能揭示真相。";
		next;
		cutin "ep171_kaya01",0;
		mes "[Kaya]";
		mes "我明白了。如果不去那里，我们的报告只会引发争议。";
		npctalk "副会长？你是认真的吗？","Aas#171_einbr",bc_self;
		npctalk "你不觉得这很合理吗？如果我不理解某件事，就必须亲眼看看。","",bc_self;
		next;
		cutin "16lei_01",2;
		mes "[Lazy]";
		mes "这就是这次旅行的目的。现在出发吧，我们没多少时间。";
		mes "我们坐一等舱过去，会更舒服。";
		next;
		select("一等舱？上次旅行时……");
		cutin "16lei_03",2;
		mes "[Lazy]";
		mes "嘿！！我现在是在执行公务！我也要坐一等舱。";
		mes "冒险者没有一等舱假通行证吗？";
		next;
		cutin "16lei_02",2;
		mes "[Lazy]";
		mes "除了 VIP，没人有钱支付一等舱。让他带我们一起去就行了。";
		next;
		cutin "ep171_kaya03",0;
		mes "[Kaya]";
		mes "嗯！";
		next;
		cutin "16lei_01",2;
		mes "[Lazy]";
		mes "谢谢！客气，客气！现在，我们一起去 <NAVI>[里希塔乐镇]<INFO>lighthalzen,259,215,0,101,0</INFO></NAVI> 吧？";
		completequest 17003;
		setquest 17004;
		close2;
		cutin "",255;
		warp "lighthalzen",246,76;
		end;
	}
	if (isbegin_quest(17004) == 1) {
		cutin "16lei_01",2;
		mes "[Lazy]";
		mes "现在，我们一起去 <NAVI>[里希塔乐镇]<INFO>lighthalzen,259,215,0,101,0</INFO></NAVI> 吧。";
		close2;
		cutin "",255;
		warp "lighthalzen",246,76;
		end;
	}
	cutin "16lei_01",2;
	mes "[Lazy]";
	mes "你现在不是应该工作吗？";
	close3;

OnInit:
	questinfo(QTYPE_QUEST,QMARK_YELLOW,"isbegin_quest(17003) == 1");
	end;
}


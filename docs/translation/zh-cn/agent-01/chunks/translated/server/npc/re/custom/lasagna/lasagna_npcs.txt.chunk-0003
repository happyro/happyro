izlude,195,213,5	script	Con-Chliina Crewman#doi	4_M_MERCAT1,{
	mes "[康·奇利纳船员]";
	mes "从米德加尔特大陆前往远星大陆！";
	next;
	mes "[康·奇利纳船员]";
	if (Class == Job_Summoner)
		.@cost = 200;
	else
		.@cost = 2000;
	mes "只需 ^0000cd" + .@cost + " Zeny^000000 就能前往港口城市拉萨格纳。";
	next;
	if (select( "前往拉萨格纳 - " + .@cost + " Zeny", "取消" ) == 2) {
	mes "[康·奇利纳船员]";
		mes "我明白了。";
		close;
	}
	if (Zeny < .@cost) {
	mes "[康·奇利纳船员]";
		mes "不够吗？要不要看看他有多少钱？";
		close;
	}
	Zeny = Zeny - .@cost;
	warp "lasagna",206,297;
	end;
}


lasagna,224,126,5	script	Healer Haru#doram07t	4_DR_M_02,{
	if (lasagna_quest[0] == 7) {
	mes "[治疗师春]";
	mes "最近有很多外地人来到这里。";
	mes "你需要什么？";
		.@menu$[2] = "向她展示合成工具。";
	}
	else {
	mes "[治疗师春]";
	mes "怎么了？";
		setarray .@menu$[0], "有人吗，帮帮我！", "关于急救", "关于药用植物学";
	}
	next;
	switch( select( .@menu$[0], .@menu$[1], .@menu$[2] ) ) {
	case 1:
		if (Class == Job_Summoner) {
	mes "[治疗师春]";
		mes "哦，不……";
		mes "会没事的。";
			npcskill "AL_HEAL",10,130,115;// 1748 hp
			percentheal 0,100;
			close;
		}
	mes "[治疗师春]";
	mes "哎呀……";
	mes "很痛吗？";
	mes "治疗全部伤势需要 5,000 Zeny。要我帮你吗？";
		next;
		if (select( "同意。", "太贵了。" ) == 2) {
	mes "[治疗师春]";
			mes "慢慢来，休息一下吧。";
			close;
		}
		if (Zeny >= 5000)// intended ?
			Zeny = Zeny - 5000;
	mes "[治疗师春]";
	mes "感谢你使用我们的服务。";
		// npcskill "AL_HEAL",10,130,115;// 1748 hp
		percentheal 100,100;
		close;
	case 2:
		if (getskilllv("NV_FIRSTAID") > 0) {
	mes "[治疗师春]";
			mes "你已经知道急救是什么了……";
			mes "拜托，我可没有一整天的时间。";
			close;
		}
	mes "[治疗师春]";
		mes "哦，你想了解急救！真是了不起！";
		mes "急救是在紧急情况下将 SP 转化为 HP 的技能。";
		next;
	mes "[治疗师春]";
		mes "治疗量可能很少……";
		mes "但至少可以避免被致命一击击晕。";
		specialeffect EF_BEGINSPELL6;
		specialeffect EF_SPELLBREAKER;
		next;
	mes "[治疗师春]";
		mes "点击^4d4dff技能^000000按钮打开技能窗口。";
		mes "顺便说一下，快捷键是^4d4dffAlt+S^000000。";
		getexp 100,100;
		if (isbegin_quest(7722) == 0) {
			setquest 7722;// EMT
			completequest 7722;// EMT
		}
		skill "NV_FIRSTAID",1,SKILL_PERM_GRANT;
		next;
	mes "[治疗师春]";
		mes "那么，我再告诉你一个有趣的功能。";
		mes "按下^4d4dffF12 键^000000，好吗？";
		mes "看！会打开快捷栏窗口，里面横向排列着九个小栏位。";
		next;
	mes "[治疗师春]";
		mes "拖动快捷栏窗口右侧的角落区域，可以查看其他页面。";
		next;
	mes "[治疗师春]";
		mes "很容易使用。^4d4dff每个栏位分别对应 F1 到 F9 键。^000000";
		mes "把技能或物品拖入栏位，再按对应按键即可立即使用。";
		next;
		cutin "tutorial05.BMP",4;
		mes "！- 注意 -！";
		mes "^4d4dff要放置物品或技能图标，请将它拖到快捷栏位。^000000";
		next;
		mes "！- 注意 -！";
		mes "^4d4dff要使用或装备栏位中的物品，请按对应的 F1 到 F9 键。^000000";
		next;
		mes "！- 注意 -！";
		mes "^4d4dff在快捷键设置中，可以按喜好选择对应的快捷键。^000000";
		next;
		mes "！- 注意 -！";
		mes "^4d4dff把经常使用的物品或技能放入快捷栏，以便快速使用。^000000";
		cutin "",255;
		next;
	mes "[治疗师春]";
		mes "现在，打开技能窗口，把急救技能放入快捷栏使用。";
		mes "这样使用起来会方便很多。";
		close;
	case 3:
		if (isbegin_quest(7718) == 0 || lasagna_quest[0] == 7) {
	mes "[治疗师春]";
			mes "哦，你是来学习药水合成的吗？";
			mes "那么首先需要一张合成卷轴。";
			mes "在所有合成物品中，最重要的应该就是药水。";
			next;
	mes "[治疗师春]";
			mes "旅行时，你见过田野里生长的草吗？";
			mes "^4d4dff红色草、蓝色草、绿色草、白色草……^000000等等……";
			next;
	mes "[治疗师春]";
			mes "你可以从这些草中获得药草。";
			mes "每种药草都可以加工成各种药物。";
			next;
	mes "[治疗师春]";
			mes "红色药草快用完了。";
			mes "我想你现在应该去采一些。";
			next;
	mes "[治疗师春]";
			mes "村口生长着药草。你看到了吗？";
			mes "^4d4dff去村口收集 1 株红色药草。^000000这会是很好的练习。";
			if (isbegin_quest(7717) == 1)
				erasequest 7717;
			if (isbegin_quest(7718) == 0)
				setquest 7718;// I'm used to this
			if (lasagna_quest[0] == 7)
				lasagna_quest[0] = 8;
			next;
	mes "[治疗师春]";
			mes "快去吧。快点！";
			close2;
			if (lasagna_quest[0] == 7 && Class == Job_Summoner)
				npctalk "嘿，新手杜拉姆。和我说说话。", "Hypnotist#doram08t", bc_self;
			end;
		}
		if (isbegin_quest(7718) == 1) {
			if (countitem(507) > 0) {
				if (checkweight(1001,5) == 0) {
						mes "- 请稍等！！-";
						mes "- 你携带的物品太多。-";
						mes "- 因此无法再接收物品。-";
						mes "- 请腾出一些空间 -";
						mes "- 再重试。-";
					close;
				}
	mes "[治疗师春]";
				mes "你拿到了，很好。";
				mes "这种^4d4dff药草直接食用也有效，但制成药水后效果更好。^000000";
				next;
	mes "[治疗师春]";
				mes "药草的效果会因颜色而异。";
				mes "^4d4dff绿色药草可以解毒。^000000";
				mes "^4d4dff蓝色药草可以恢复 SP^000000。";
				next;
	mes "[治疗师春]";
				mes "还有其他问题吗？";
				mes "现在，红色药草正在发挥作用，你的 HP 会逐渐恢复。";
				mes "把它榨成汁后装进瓶子……";
				next;
	mes "[治疗师春]";
				mes "这就是我们所说的可以随时随地服用的药水！";
				mes "这瓶送给特别来到这里的你。";
				next;
	mes "[治疗师春]";
				mes "准备好合成卷轴上写的材料。";
				mes "然后^4d4dff使用合成工具或烹饪用具^000000制作你想要的物品。";
				next;
	mes "[治疗师春]";
				mes "除了药水，你还可以用收集到的材料制作其他工具，请好好利用。";
				next;
	mes "[治疗师春]";
				mes "我给了你红色药草和苹果。";
				mes "试着用合成工具制作些什么吧。";
				next;
	mes "[治疗师春]";
				mes "这是使用说明。要阅读合成卷轴，";
				mes "^4d4dff右键点击卷轴，^000000然后点击说明窗口中的^4d4dff书本图标^000000。";
				if (isbegin_quest(7717) > 0)
					erasequest 7717;
				if (isbegin_quest(7718) == 0)
					setquest 7718;// I'm used to this
				completequest 7718;
				getexp 200,200;
				getitem 569,30;// Novice Potion
				getitem 11058,1;// Novice Combination Book
				getitem 12849,10;// Combination Kit
				getitem 507,1;// Red Herb
				getitem 512,1;// Apple
				npctalk "哦！你在这里！", "Vigilante Aglio#doram09", bc_self;
				classchange( 4_DR_AGLIO, "Vigilante Aglio#doram09", bc_self );
				lasagna_quest[0] = 9;
				close;
			}
			else {
	mes "[治疗师春]";
				mes "村口附近有一处生长药草的地方。";
				mes "^4d4dff击败红色草并获得 1 株红色药草。^000000";
				next;
	mes "[治疗师春]";
				mes "你应该已经知道药草长什么样了。";
				close;
			}
		}
  mes "[治疗师春]";
		mes "关于药用植物学基础，我已经告诉了你所有细节。";
		mes "顺便说一句，这个世界上还有^4d4dff闪耀之草^000000。";
		next;
  mes "[治疗师春]";
		mes "你无法预料闪耀之草会产出什么药草。";
		mes "我曾幸运地得到过一次伊格德拉希尔之果。";
		next;
  mes "[治疗师春]";
		mes "听说在人类之中，^4d4dff炼金术士^000000、^4d4dff创造者^000000或高阶^4d4dff基因者^000000";
		mes "非常擅长制作药水。";
		next;
  mes "[治疗师春]";
		mes "如果你在米德加尔特大陆遇到人类，不妨问问他们？";
		close;
	}

OnInit:
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "isbegin_quest(7722) == 0" );
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "isbegin_quest(7717) == 1" );
	end;
}

lasagna,222,123,5	script	Hypnotist#doram08t	4_CAT_MERMASTER,{
	if (Class != Job_Summoner) {
	mes "[催眠师]";
		mes "哦！你就是大家都在谈论的那个著名人类！";
		mes "不过你的头发为什么不对称？";
		next;
	mes "[催眠师]";
		mes "你是不是得了皮肤病之类的？";
		mes "我旁边的治疗师很厉害。你应该请她看看！";
		next;
	mes "[催眠师]";
		mes "你个头很大，这种乱糟糟的头发不适合你……";
		mes "整理起来一定很辛苦。";
		close;
	}
	mes "[催眠师]";
	mes "我正在为年轻人的未来施展催眠术。";
	next;
	if (BaseLevel > 49) {
	mes "[催眠师]";
		mes "你到处闲逛也该逛够了吧。";
		close;
	}
	mes "[催眠师]";
		mes "如果你不喜欢刚学会的技能，我可以帮你重置。";
	next;
	mes "[催眠师]";
		mes "^4d4dff等级 49 以下时，可以随时重置技能和状态。^000000";
	next;
	.@s = select( "重置状态。", "重置技能。" );
	if (Weight > 0) {
	mes "[催眠师]";
		mes "你的物品可能会丢失，所以请确保自己的负重为^FF00000^000000。";
		next;
	mes "[催眠师]";
		mes "仓库由猫爪商队负责，请把物品交给他们保管。";
		close;
	}
	if (.@s == 1) {
		resetstatus();
	mes "[催眠师]";
		mes "你的状态已成功重置！";
		next;
	mes "[催眠师]";
		mes "有经验的人我不负责重置。所以请提前规划好自己的状态。";
		close;
	}
	resetskill();
	mes "[催眠师]";
	mes "你的技能已成功重置！";
	next;
	mes "[催眠师]";
	mes "只有等级 49 以下时，我才会免费重置技能和状态。";
	mes "在那之前，我建议你多练习不同技能，以便决定自己喜欢什么。";
	close;
}

lasagna,230,127,3	script	Vigilante Aglio#doram09	HIDDEN_WARP_NPC,{
	if (lasagna_quest[0] == 9) {
	mes "[巡逻队阿格里奥]";
		mes "我在工具店找你，他们说你往这边来了。";
		next;
	mes "[巡逻队阿格里奥]";
		mes "首先，我们应该和队长会合，决定行程安排。";
		mes "我们最好去广场。";
		next;
	mes "[巡逻队阿格里奥]";
		mes "我想你可以在广场找到另一个像我一样的巡逻队成员……";
		navigateto "lasagna",170,152;
		close;
	}
}

izlude,117,165,3	script	Cat Paw Shrimp Merchant#iz	4_M_MERCAT1,{
	npctalk "这里有虾、胡萝卜和猫薄荷！", "", bc_self;
	switch( select( "购买", "出售", "取消" ) ) {
	case 1:
		callshop "doram_shrimp",1;
		end;
	case 2:
		callshop "doram_shrimp",2;
		end;
	case 3:
		npctalk "欢迎很快再来！", "", bc_self;
		end;
	}
}


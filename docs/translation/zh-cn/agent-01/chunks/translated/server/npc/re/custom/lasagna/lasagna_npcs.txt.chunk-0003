izlude,138,183,3	script	Vigilante Penne#doect01	4_DR_SOLDIER,{
	if (Class == Job_Summoner) {
	mes "[巡逻队佩内]";
	mes "嗨！没想到在这里也能见到蝴蝶巡逻队，真令人开心！";
		next;
	mes "[巡逻队佩内]";
	mes "对了，你在这片土地上的定居情况怎么样？";
	mes "你去过附近的^4d4dff普隆德拉^000000或^4d4dff斐扬^000000吗？";
		next;
	mes "[巡逻队佩内]";
	mes "这里有一个你可能想去拜访的乐园团。";
	mes "去那里看看也不会有坏处。";
		close;
	}
	mes "[巡逻队佩内]";
	mes "人类奇特的外表总是让我感到好奇。";
	mes "就像一只没有毛的大猫！";
	next;
	mes "[巡逻队佩内]";
	mes "我？让我解释一下。我是来自伟大远星大陆的蝴蝶巡逻队成员。";
	next;
	switch( select( "远星大陆？", "蝴蝶巡逻队？", "你来自猫爪商队吗？" ) ) {
	case 1:
	mes "[巡逻队佩内]";
		mes "除了米德加尔特，还有其他大陆。";
		mes "我们穿越而来的土地叫远星大陆。";
		next;
	mes "[巡逻队佩内]";
		mes "我们其实也一样，因为我们曾以为阳光下只有远星大陆。";
		mes "世界真是辽阔……";
		close;
	case 2:
	mes "[巡逻队佩内]";
		mes "你看，这条缎带是不是和这套帅气制服很相配？";
		mes "（展示颈部以下的位置。）";
		next;
	mes "[巡逻队佩内]";
		mes "这是我们蝴蝶巡逻队的标志。";
		mes "我们是守护拉萨格纳的传奇巡逻队！";
		next;
	mes "[巡逻队佩内]";
		mes "你无法想象我们的队长佩佩洛奇诺有多酷……";
		mes "从处理港口的顽童到维护村子的安全，我们什么都做。";
		next;
	mes "[巡逻队佩内]";
		mes "而且，你还可以来到这个……米德……米德加尔特……";
		mes "总之！只有蝴蝶巡逻队接纳你后，你才可以来这里。";
		next;
		mes "这只骄傲的猫开始变得很健谈了……";
		close2;
		npctalk "咦？你只是路过吗？", "", bc_self;
		end;
	case 3:
	mes "[巡逻队佩内]";
		mes "不，不是那样！！";
		mes "猫爪商队由托梅·托马斯队长领导！";
		next;
	mes "[巡逻队佩内]";
		mes "我属于佩佩洛奇诺队长指挥的蝴蝶巡逻队！";
		next;
	mes "[巡逻队佩内]";
		mes "天哪！你甚至还没去过拉萨格纳，对吧？";
		mes "我们伟大的甘贝里队长亲自来过这里！";
		next;
	mes "[巡逻队佩内]";
		mes "我们很慷慨，愿意给像你这样的人机会前往拉萨格纳。";
		mes "很快，这个米德……米德加尔特……？这片土地就会由我们多郎族掌控！";
		next;
	mes "[巡逻队佩内]";
		mes "你最好赢得我们的好感。这样的话，我们也许会给你一份在拉萨格纳清理凤尾鱼的工作！";
		close;
	}
}

lasagna,209,301,3	script	Mustachi#dorcon01	4_DR_KID_01,{
	mes "[穆斯塔奇]";
	mes "我们会修剪你的胡须，也会梳理你的尾巴。前往新世界前，记得好好打理自己。";
	mes "市中心有发型设计师，记得去拜访。";
	close;
}

lasagna,232,181,5	script	Linguina#dorcon01	4_CAT_ADV1,{
	mes "[林古伊娜]";
	mes "这里既是酒馆，也是冒险者俱乐部。冒险者们从各地来到这里，分享故事并寻找冒险伙伴。";
	next;
	mes "[林古伊娜]";
	mes "如今，许多人在前往新世界前会来这里打听消息。";
	next;
	mes "[林古伊娜]";
	mes "大约十年前，这里是改造流氓多郎族并招募他们成为巡逻队的地方。在那之前，粗犷的水手们会在辛苦工作后到这里放松。";
	next;
	mes "[林古伊娜]";
	mes "佩佩洛奇诺首领和甘贝里队长也是在这里第一次见面的。三人结为兄弟，事业成功后成为了传奇。";
	next;
	mes "[林古伊娜]";
	mes "所以想要成功的人，或想成为他们那样的冒险者，经常会来这里。";
	close;
}

lasagna,227,187,1	script	Vongolo#dorcon01	4_CAT_SAILOR1,{
	mes "[翁戈洛]";
	mes "决定要点什么了吗？";
	next;
	mes "[翁戈洛]";
	mes "因为佩佩洛奇诺、甘贝里和托马斯的烤炉决议，大家都会在这里点卡鲁纳牛奶。但酒馆烤炉真正的招牌菜是鱼糕。";
	next;
	mes "[翁戈洛]";
	mes "鱼糕是把白鱼片和煮熟的豆子捣碎后塑形并油炸而成。味道非常美味，却没人点。";
	next;
	mes "[翁戈洛]";
	mes "所以现在我们甚至不会提前准备材料。偶尔有人点单时，我们才跑去鱼店买鳕鱼，然后开始烹饪。";
	next;
	mes "[翁戈洛]";
	mes "哦，真的很好吃……";
	close;
}

lasagna,220,172,6	script	Master of Property#do_h	4_M_BABYCAT,{
	.@r = rand(0,4);
	if (.@r == 0)
		npctalk "地属性克制风属性。", "", bc_self;
	else if (.@r == 1)
		npctalk "水属性克制火属性。", "", bc_self;

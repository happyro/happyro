
OnTimer1000:
	set $@PartTimeSlots,0;
	set $@PartTimeOn,1;
	mapannounce "mid_camp", "饲育员塔布：营地的冒险者请注意！我的饲育场招募5名兼职，先到者先得！",bc_map,"0x00ff00";
	end;

OnTimer180000:
OnTimer360000:
	if ($@PartTimeOn < 5) mapannounce "mid_camp", "饲育员塔布：我在饲育场招募兼职，有兴趣请来农场。",bc_map,"0x00ff00";
	else mapannounce "mid_camp", "饲育员塔布：饲育场招募结束。下次见，谢谢！",bc_map,"0x00ff00";
	end;

OnTimer600000:
	mapannounce "mid_camp", "饲育员塔布：饲育场招募结束。下次见，谢谢！",bc_map,"0x00ff00";
	set $@PartTimeOn,0;
	end;

OnTimer7800000:
	donpcevent "#timer_alba01::OnEnable";
	donpcevent "#monster_master::OnEnable";
	end;
}

mid_camp,143,306,5	script	Breeder Taab#ep13_alba	946,{
	if (ep13_ryu > 99 || ep13_start > 99) {
		if (ep13_alba < 1) {
			mes "[Taab]";
			mes "我能帮你什么？";
			next;
			switch(select("这里是什么地方？:我是来找工作的。:不用了，谢谢。")) {
			case 1:
				mes "[Taab]";
				mes "这里饲养着在灰色幽灵捕获的生物。";
				mes "我们研究它们，了解其特征和习性。";
				next;
				mes "[Taab]";
				mes "当然，研究由学者和专家进行。";
				mes "我负责驯服和繁育危险魔物。";
				next;
				mes "[Taab]";
				mes "……希望能把它们当宠物带在身边。";
				mes "山羊狮很可爱。大陆上找不到这种动物，你知道吗？";
				close;
			case 2:
				if ($@PartTimeOn == 0) {
					mes "[Taab]";
					mes "抱歉，我现在不需要帮助。需要时我会正式公告，请到时再来。";
					close;
				}
				else {
					if ($@PartTimeSlots < 5) {
						set $@PartTimeSlots,$@PartTimeSlots+1;
						mes "[Taab]";
					mes "欢迎。你的工作很简单：收集动物饲料或清洁笼子。这些是可选工作。";
						next;
						if ($@PartTimeSlots == 1) {
							set ep13_alba,1;
							setquest 7042;
							mes "[Taab]";
			mes "请带来50条鲜鱼。它们是塔塔丘的饲料，我已经用完，很快需要补充。";
							next;
							mes "[Taab]";
			mes "可以从田野里的塔塔丘那里找到。很奇怪吧？我不知道它们从哪里捕到鱼。";
							next;
							mes "[Taab]";
			mes "提前谢谢。请带来塔塔丘的饲料：^4d4dff50条鲜鱼^000000。";
							close;
						}
						else if ($@PartTimeSlots == 2) {
							set ep13_alba,2;
							setquest 7043;
							mes "[Taab]";
			mes "科努斯的饲料刚用完。请带来^4d4dff30片大叶子和30根褐色根茎^000000。";
							next;
							mes "[Taab]";
			mes "可以从田野里的捕虫草找到。提前谢谢。";
							close;
						}
						else if ($@PartTimeSlots == 3) {
							set ep13_alba,3;
							setquest 7044;
							mes "[Taab]";
			mes "山羊狮的饲料刚用完。学者认为它们属于猫科，我一直在尝试喂各种东西。";
							next;
							mes "[Taab]";
			mes "这次……我想试试魔物饲料。请带来^4d4dff20份魔物饲料和30份宠物食品^000000。";
							next;
							mes "[Taab]";
			mes "提前谢谢。别忘了20份魔物饲料和30份宠物食品。希望山羊狮喜欢。";
							close;
						}
						else if ($@PartTimeSlots == 4) {
							set ep13_alba,4;
							setquest 7045;
							mes "[Taab]";
			mes "太好了，我正想给山羊狮尝试新饲料。我试过魔物饲料，但不知道它们喜不喜欢。";
							next;
							mes "[Taab]";
			mes "这次我想试试肉。请带来^4d4dff50份肉^000000和^4d4dff30份宠物食品^000000。";
							next;
							mes "[Taab]";
			mes "提前谢谢。别忘了^4d4dff50份肉^000000和^4d4dff30份宠物食品^000000。希望它们喜欢肉。";
							close;
						}
						else {
							set ep13_alba,5;
							setquest 7046;
							mes "[Taab]";
			mes "哦，我一直想在地上铺些温暖的东西给动物。我想用毛皮。雨天也能用毛皮遮住笼子。";
							next;
							mes "[Taab]";
			mes "请带来^4d4dff30块毛皮碎片^000000。听起来很简单吧？塔塔丘和山羊狮的毛皮应该很合适。";
							next;
							mes "[Taab]";
			mes "当然，不会把它们用于塔塔丘和山羊狮的笼子。这些毛皮是给科努斯的。";
							next;
							mes "[Taab]";
			mes "科努斯似乎喜欢温暖。这里天气奇怪，很难为每种动物调整最佳温度。";
							next;
							mes "[Taab]";
			mes "提前谢谢。别忘了30块毛皮碎片。";
							close;
						}
					}
					else {
						mes "[Taab]";
						mes "哦，抱歉，现在没有可用的工作。其他兼职已经完成了所有工作。";
						next;
						mes "[Taab]";
						mes "抱歉让你白跑一趟。哈哈……下次见。";
						close;
					}
				}
			case 3:
				mes "[Taab]";
				mes "请离笼子远一些。有时动物会试图逃出笼子。";
				close;
			}
		}
		else if (ep13_alba == 1) {
			if (countitem(579) > 49) {
				mes "[Taab]";
				mes "哦，谢谢！你带来了它们的食物！来得正好，它们看起来已经准备大吃一顿了。塔塔丘一定喜欢。";
				next;
				mes "[Taab]";
				mes "我很想给你回礼……但没有物质奖励。精神上的奖励怎么样？";
				next;
				delitem 579,50; //Delicious_Fish
				set ep13_alba,6;
				if (checkre(3)) {
					getexp 8000,3000;
					mes "^4d4dff 你获得了 8,000 点经验值";
				mes "以及3,000 JEXP。^000000";
				} else {
					getexp 80000,30000;
					mes "^4d4dff 你获得了 80,000 点经验值";
				mes "以及30,000 JEXP。^000000";
				}
				erasequest 7042;
				setquest 7047;
				close;
			}
			else {
				mes "[Taab]";
				mes "请带来50条鲜鱼给塔塔丘。你最好快点，它们饿了会变得不耐烦。";
				close;
			}
		}
		else if (ep13_alba == 2) {
			if ((countitem(7198) > 29) && (countitem(7188) > 29)) {
				mes "[Taab]";
				mes "哦，谢谢！你带来了它们的食物！来得正好，科努斯一定喜欢。";
				next;
				mes "[Taab]";
				mes "我很想给你回礼……但没有物质奖励。精神上的奖励怎么样？";
				next;
				delitem 7198,30; //Great_Leaf
				delitem 7188,30; //Browny_Root
				set ep13_alba,6;
				if (checkre(3)) {
					getexp 9000,4000;
					mes "^4d4dff 你获得了 9,000 点经验值";
				mes "以及4,000 JEXP。^000000";
				} else {
					getexp 90000,40000;
					mes "^4d4dff 你获得了 90,000 点经验值";
				mes "以及40,000 JEXP。^000000";
				}
				erasequest 7043;
				setquest 7047;
				close;
			}
			else {
				mes "[Taab]";
				mes "别忘了30片大叶子和30根褐色根茎。我需要尽量多储备，因为科努斯经常挨饿。";
				close;
			}
		}
		else if (ep13_alba == 3) {
			if ((countitem(528) > 19) && (countitem(537) > 29)) {
				mes "[Taab]";
		mes "哦，谢谢！你带来了它们的食物！来得正好，它们准备大吃一顿了。山羊狮一定喜欢。";
				next;
				mes "[Taab]";
		mes "我很想给你回礼……但没有物质奖励。精神上的奖励怎么样？";
				next;
				delitem 528,20; //Monster's_Feed
				delitem 537,30; //Pet_Food
				set ep13_alba,6;
				if (checkre(3)) {
					getexp 8000,3000;
					mes "^4d4dff 你获得了 8,000 点经验值";
		mes "以及3,000 JEXP。^000000";
				} else {
					getexp 80000,30000;
					mes "^4d4dff 你获得了 80,000 点经验值";
		mes "以及30,000 JEXP。^000000";
				}
				erasequest 7044;
				setquest 7047;
				close;
			}
			else {
				mes "[Taab]";
				mes "别忘了20份魔物饲料和30份宠物食品。这些是给山羊狮的。";
				close;
			}
		}
		else if (ep13_alba == 4) {
			if ((countitem(517) > 49) && (countitem(537) > 29)) {
				mes "哦，谢谢！你带来了它们的食物！来得正好，它们准备大吃一顿了。山羊狮一定喜欢。";
				next;
				mes "[Taab]";
				mes "我很想给你回礼……但没有物质奖励。精神上的奖励怎么样？";
				next;
				delitem 517,50; //Meat
				delitem 537,30; //Pet_Food
				set ep13_alba,6;
				if (checkre(3)) {
					getexp 8000,3000;
					mes "^4d4dff 你获得了 8,000 点经验值";
				mes "以及3,000 JEXP。^000000";
				} else {
					getexp 80000,30000;
					mes "^4d4dff 你获得了 80,000 点经验值";
				mes "以及30,000 JEXP。^000000";
				}
				erasequest 7045;
				setquest 7047;
				close;
			}
			else {
				mes "[Taab]";
				mes "别忘了50份肉和30份宠物食品。这些是给山羊狮的。";
				close;
			}
		}
		else if (ep13_alba == 5) {
			if (countitem(6020) > 29) {
				mes "[Taab]";
				mes "哦，谢谢！你带来了毛皮！来得正好！";
				next;
				mes "[Taab]";
				mes "我很想给你回礼……但没有物质奖励。精神上的奖励怎么样？";
				next;
				delitem 6020,30; //Fur
				set ep13_alba,6;
				if (checkre(3)) {
					getexp 8000,3000;
					mes "^4d4dff 你获得了 8,000 点经验值";
					mes "以及3,000 JEXP。^000000";
				} else {
					getexp 80000,30000;
					mes "^4d4dff 你获得了 80,000 点经验值";
					mes "以及30,000 JEXP。^000000";
				}
				erasequest 7046;
				setquest 7047;
				close;
			}
			else {
				mes "[Taab]";
				mes "别忘了30块毛皮，它们是给科努斯笼子的。";
				close;
			}
		}
		else if (ep13_alba == 6) {
			set .@alba_check,checkquest(7047,PLAYTIME);
			if (.@alba_check == -1) {
				mes "[Taab]";
				mes "谢谢你上次的帮助。兼职工作一直都有，希望你再来帮忙。";
				erasequest 7047;
				set ep13_alba,0;
				close;
			}
			else if ((.@alba_check == 0) || (.@alba_check == 1)) {
				mes "[Taab]";
				mes "我有足够的饲料和补给用一阵子了。谢谢你上次的帮助。";
				next;
				mes "[Taab]";
				mes "我暂时不需要帮助……";
				mes "" + strcharinfo(0) + ",";
				mes "你去休息吧。";
				close;
			}
			else if (.@alba_check == 2) {
				mes "[Taab]";
				mes "谢谢你上次的帮助。兼职工作一直都有，希望你再来帮忙。";
				erasequest 7047;
				set ep13_alba,0;
				close;
			}
		}
	}
	else {
		mes "[Taab]";
		mes "请让开！靠近那些动物很危险。你看起来不像远征队成员，应该不允许待在这里。请离开。";
		close;
	}
}

mid_camp,152,316,3	script	Hillsrion#alba01	1989,3,3,{
OnEnable:
	enablenpc "Hillsrion#alba01";
	end;

OnDisable:
	disablenpc "Hillsrion#alba01";
	end;

OnTouch:
	mes "它低声嘶嘶作响，有时也会发出呼噜声。它一定心情很好。";
	close;
}


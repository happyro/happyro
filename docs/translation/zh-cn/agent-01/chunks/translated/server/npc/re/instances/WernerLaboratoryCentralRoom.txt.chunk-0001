// * Events - First entrance
1@slw,188,42,3	script	Eisen Werner#werner01	4_M_EISEN,{
	if (is_party_leader() == false)
		end;
	cutin "ep16_eisen01.bmp",1;
	mes "[艾森·维尔纳]";
	mes "主角登场了。";
	mes "说实话，我很佩服你。没想到你真的能一路来到这里。";
	next;
	mes "[艾森·维尔纳]";
	mes "算了。";
	mes "欢迎。";
	mes "欢迎来到艾森·维尔纳的世界。";
	next;
	cutin "ep16_eisen02.bmp",1;
	mes "[艾森·维尔纳]";
	mes "我从没想过事情会这样突然完成。";
	mes "算了。谁在乎呢？";
	next;
	cutin "ep16_eisen01.bmp",1;
	mes "[艾森·维尔纳]";
	mes "反正我已经放弃拯救这座实验室了。";
	mes "你想看看吗？";
	next;
	mes "[艾森·维尔纳]";
	mes "这里发生过很多事，包括维度裂缝等等。";
	mes "在某些世界里，时间的流动是扭曲的。";
	next;
	mes "[艾森·维尔纳]";
	mes "那是平行世界吗？";
	mes "还是有人去过过去的某个时间点？";
	next;
	mes "[艾森·维尔纳]";
	mes "时间究竟意味着什么？你思考过这个问题吗？";
	mes "它的流动是相对的。";
	next;
	mes "[艾森·维尔纳]";
	mes "那个人现在停止了。";
	mes "如果时间按生物规律流动，就意味着人会变老。";
	next;
	mes "[艾森·维尔纳]";
	mes "那被强行停止了。";
	mes "这种情况下，我们会使用这样的说法。";
	next;
	cutin "ep16_eisen02.bmp",1;
	mes "[艾森·维尔纳]";
	mes "时间停止了。";
	next;
	mes "[艾森·维尔纳]";
	mes "....";
	next;
	cutin "ep16_eisen01.bmp",1;
	mes "[艾森·维尔纳]";
	mes "你想进去看看吗？";
	mes "慢慢来，沿着走廊看看吧。";
	next;
	mes "[艾森·维尔纳]";
	mes "我来为你带路。";
	close2;
	cutin "",255;
	if (is_party_leader() == true) {
		disablenpc instance_npcname("Eisen Werner#werner01");
		enablenpc instance_npcname("Eisen Werner#werner02");
	}
	end;
}

1@slw,189,164,3	script	Eisen Werner#werner02	4_M_EISEN,{
	if (is_party_leader() == false)
		end;
	cutin "ep16_eisen01.bmp",1;
	mes "[艾森·维尔纳]";
	mes "你喜欢我的作品吗？";
	mes "我把那些傻家伙送回去重新开始了。";
	next;
	mes "[艾森·维尔纳]";
	mes "不过，这一点也不容易。";
	mes "......";
	next;
	cutin "ep16_eisen02.bmp",1;
	mes "[艾森·维尔纳]";
	mes "要是那个孩子回去了，就不会落得那样的下场……";
	next;
	mes "[艾森·维尔纳]";
	mes "我是说，要是他停下来就好了……";
	next;
	cutin "ep16_eisen01.bmp",1;
	mes "[艾森·维尔纳]";
	mes "主席……我是说，那个人沉迷于过去。";
	mes "多亏了主席，我才能随心所欲地进行研究。";
	next;
	mes "[艾森·维尔纳]";
	mes "你不好奇吗？";
	mes "他为什么如此沉迷于过去？";
	next;
	mes "[艾森·维尔纳]";
	mes "顺便说一下，如果你想继续前进，就必须操作左右两边的仪器……你能做到吗？";
	next;
	mes "[艾森·维尔纳]";
	mes "这是很简单的装置，我想你应该可以。";
	mes "把^ff0000红色^000000变成^4d4dff蓝色^000000。";
	mes "再把^4d4dff蓝色^000000变成^ff0000红色^000000。就是这样。";
	next;
	mes "[艾森·维尔纳]";
	mes "如果你认真看过我的作品，就会明白我的意思。";
	mes "那么，我们下个区域见。";
	close2;
	cutin "",255;
	if (is_party_leader() == true) {
		disablenpc instance_npcname("Eisen Werner#werner02");
		enablenpc instance_npcname("Security device#switch01");
		enablenpc instance_npcname("Security device#switch02");
	}
	end;
}

1@slw,155,191,3	script	Security device#switch01	CLEAR_NPC,{
	if (is_party_leader() == false)
		end;
	.@number = atoi( replacestr( strnpcinfo(2), "switch", "" ) );
	.@type = (.@number < 10) ? 0 : 1;
	.@npc_num = (.@number < 10) ? .@number : (.@number-10);
	if ('device_state[.@type] & .@npc_num) {
		mes "它已经启动了。";
		close;
	}
	callsub S_Code, .@string$, .@answer;
	mes "这里写着安全代码。";
	mes "[" + .@string$ + "]";
	mes "你要输入什么？";
	next;
	if (select( "^ff0000" + .@string$ + "^000000", "^4d4dff" + .@string$ + "^000000" ) != .@answer) {
		'device_state[.@type] = 0;
		mes "设备已初始化。";
		close;
	}
	if (is_party_leader() == false)
		end;
	'device_state[.@type] = 'device_state[.@type] | .@npc_num;
	if ('device_state[.@type] != 3) {
		mes "已操作安全装置。";
		mes "似乎还有一个安全装置。";
		close;
	}
	mes "已操作安全装置。";
	mes "门现在已经启动。";
	switch( .@type ) {
	case 0:
		enablenpc instance_npcname("#slwwarp01");
		if (instance_live_info(ILI_NAME) == "Werner Laboratory central room#1")	// terra_gloria_main == 21
			enablenpc instance_npcname("Eisen Werner#werner03");
		else {
			enablenpc instance_npcname("Guard#gard05");
			enablenpc instance_npcname("Guard#gard06");
			enablenpc instance_npcname("Guard#gard07");
		}
		break;
	case 1:
		if (instance_live_info(ILI_NAME) == "Werner Laboratory central room#1")
			enablenpc instance_npcname("Eisen Werner#werner04");
		else
			enablenpc instance_npcname("Central Entrance#door");
		enablenpc instance_npcname("#slwwarp02");
		break;
	}
	close;

S_Code:
	setarray .@sample$[0],
		"纯洁", 2,
		"永恒", 2,
		"黎明", 2,
		"玫瑰", 1,
		"矛盾", 1,
		"喜悦", 1,
		"海洋", 1,
		"回家的路", 1,
		"孤独", 1,
		"光辉", 1,
		"暮色", 1;
	.@size = getarraysize(.@sample$) / 2;
	.@r = rand(.@size) * 2;
	set getarg(0), .@sample$[.@r];
	set getarg(1), .@sample$[.@r+1];
	return;
}
1@slw,220,191,3	duplicate(Security device#switch01)	Security device#switch02	CLEAR_NPC
1@slw,22,61,3	duplicate(Security device#switch01)	Security device#switch11	CLEAR_NPC
1@slw,122,61,3	duplicate(Security device#switch01)	Security device#switch12	CLEAR_NPC


// * Events - Daily
1@slw,188,58,3	script	Guard#gard01	3622,4,4,{
	end;
OnTouch:
	.@num = atoi( replacestr( strnpcinfo(2), "gard0", "" ) );
	getmapxy .@map$,.@x,.@y, BL_NPC;
	switch( .@num ) {
	case 1:	// 2 spawn area
		npctalk "……见鬼，你是怎么进来的？";
		areamonster .@map$, 186,92,190,94, "特殊卫兵", 3622,3;	// EP16_2_MM_S_GUARDS
		.@mob_count = 3;
		break;
	case 2:	// 3 spawn area
		npctalk "……见鬼，你是怎么进来的？";
		areamonster .@map$, 186,142,190,143, "特殊卫兵", 3622,3;	// EP16_2_MM_S_GUARDS
		areamonster .@map$, 186,160,190,162, "特殊卫兵", 3622,3;
		.@mob_count = 3;
		break;
	case 5:
		npctalk "……见鬼，你是怎么进来的？";
		.@mob_count = 3;
		break;
	case 3:
		npctalk "……见鬼，你是怎么进来的？";
		.@mob_count = 1;
		.@label$ = instance_npcname("#security_device_lab") + "::OnLeft1";
		break;
	case 4:

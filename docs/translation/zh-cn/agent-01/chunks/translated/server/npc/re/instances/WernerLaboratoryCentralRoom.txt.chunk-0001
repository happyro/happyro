1@slw,174,145,3	script	Displayed sample#01	CLEAR_NPC,{
	setarray .@sample$[0],
		"^ff0000纯洁^000000", "MT-Wxx0s57b",
		"^4d4dff玫瑰^000000", "MT-Wxx00b21",
		"^4d4dff矛盾^000000", "MT-Wxx023-f1",
		"^4d4dff喜悦^000000", "OT-Wxx01-c",
		"^4d4dff海洋^000000", "MT-Wxc1c1b",
		"^ff0000永恒^000000", "MT-Wx267b",
		"^4d4dff回家的路^000000", "OTM-Wxff01",
		"^4d4dff孤独^000000", "MT-Wxx00c46",
		"^4d4dff光辉^000000", "OT-Wxx4d4dff",
		"^ff0000黎明^000000", "MT-Wff_01v",
		"^4d4dff暮色^000000", "OT-Wxx00c3b",
		"^4d4dff少女^000000的^ff0000梦想^000000", "MT-Wxx0ax2-1";
	.@num = (atoi(strnpcinfo(2)) - 1) * 2;
	mes "[" + .@sample$[.@num] + "]";
	mes "实验编号：" + .@sample$[.@num+1] + "";
	close;
}

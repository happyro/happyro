// Step 1
payon,165,116,5	script	Request Board#JQ_SH	4_BOARD3,{
	if (Class == JOB_SPIRIT_HANDLER) {
		mes "- 这项请求已经完成。-";
		close;
	}
	if (Class != JOB_SUMMONER) {
		mes "[紧急柴薪请求]";
		mes "捕捉野兽的请求。";
		mes "^123456要求：^000000";
		mes "擅长与动物相处。";
		mes "^dd5555基础等级 200/职业等级 60^000000 以上的冒险者。";
		mes "优先考虑<FONT SIZE = 14>^dd5555<B>召唤师</B>^000000</FONT>职业。";
		emotion ET_HELP;
		next;
		mes "- 以我现在的职业，似乎很难完成这项请求。-";
		close;
	}
	if (BaseLevel < 200 || JobLevel < 60) {	// !TODO: unknown dialog
		mes "[紧急柴薪请求]";
		mes "捕捉野兽的委托。";
		mes "^123456要求：^000000";
		mes "擅长与动物相处。";
		mes "基础等级^dd5555200/职业等级 60^000000以上的冒险者。";
		mes "优先考虑 <FONT SIZE = 14>^dd5555<B>召唤师</B>^000000</FONT> 职业。";
		emotion ET_HELP;
		next;
		mes "- 你的等级太低，无法接受这块公告板上的请求。-";
		close;
	}
	switch( isbegin_quest(11770) ) {
	case 0:
		mes "[紧急柴薪请求]";
		mes "捕捉野兽的委托。";
		mes "^123456要求：^000000";
		mes "擅长与动物相处。";
		mes "基础等级^dd5555200/职业等级 60^000000以上的冒险者。";
		mes "优先考虑 <FONT SIZE = 14>^dd5555<B>召唤师</B>^000000</FONT> 职业。";
		emotion ET_HELP;
		next;
		mes "[紧急柴薪请求]";
		mes "^123456特别说明：^000000";
		mes "仍然带有肉食动物气味的人，";
		mes "例如狼或鹰，";
		mes "无法完成这项任务。";
		next;
		mes "[紧急柴薪请求]";
		mes "其他详情请联系柴薪工厂附近的<NAVI>[木匠]<INFO>payon,252,297,0,101,0</INFO></NAVI>。";
		setquest 11770;
		navigateto("payon",252,297);
		close;
	case 1:
		mes "[紧急柴薪请求]";
		mes "其他详情请联系柴薪工厂附近的<NAVI>[木匠]<INFO>payon,252,297,0,101,0</INFO></NAVI>。";
		navigateto("payon",252,297);
		close;
	case 2:
		mes "- 没有更多请求了。-";
		close;
	}
	end;

OnInit:
	questinfo( QTYPE_JOBQUEST, QMARK_YELLOW, "Class == JOB_SUMMONER && BaseLevel == 200 && JobLevel == 60 && isbegin_quest(11770) == 0" );
	end;
}

// Step 2
payon,252,297,3	script	Woodworker#JQ_SH	2_M_BARD_ORIENT,{
	if (isbegin_quest(11770) == 0) {
		mes "[木工]";
		mes "<FONT SIZE = 14>欢迎~ 客人~！</FONT>";
		mes "这里是柴薪木工店~";
		emotion ET_DELIGHT;
		npctalk "欢迎~客人~！", "", bc_self;
		next;
		mes "[木工]";
		mes "你在找什么~吗？";
		close;
	}
	if (isbegin_quest(11770) == 1) {
		mes "[木工]";
		mes "<FONT SIZE = 14>欢迎~客人~！</FONT>";
		mes "这里是制作柴薪的木工作坊~";
		emotion ET_DELIGHT;
		npctalk "欢迎~客人~！", "", bc_self;
		next;
		mes "[木工]";
		mes "你在找什么吗~？";
		next;
		select( "关于委托。" );
		mes "[木工]";
		mes "你说的是请求~客人~？";
		mes "请稍等片刻~好吗？";
		emotion ET_AHA;
		next;
		mes "[木工]";
		mes "木工请求……";
		mes "嗯……";
		npctalk "我看看……", "", bc_self;
		next;
		mes "[木工]";
		mes "抱歉，我们确认木工店没有这项请求。";
		mes "能告诉我你收到的是什么请求吗？客人~";
		emotion ET_PROFUSELY_SWEAT;
		next;
		select( "柴薪委托。" );
		mes "[木工]";
		mes "啊啊啊！！！";
		mes "对不起！";
		mes "我想那不是木工店的请求，而是老板的私人请求~";
		emotion ET_SURPRISE;
		next;
		mes "[木工]";
		mes "<FONT SIZE = 10>既然是老板让你做的，你应该告诉我啊！</FONT>";
		mes "请稍等一下，客人。";
		mes "我去叫老板……";
		emotion ET_SORRY;
		next;
		mes "[木工]";
		mes "<FONT SIZE = 14>这位先生又出门了！！</FONT>";
		mes "<FONT SIZE = 10>他又去森林了吗！</FONT>";
		mes "怎么会这样！！！";
		emotion ET_FRET;
		npctalk "这家伙，真是的！！！！", "", bc_self;
		next;
		mes "[木工]";
		mes "抱歉~ 客人。";
		mes "老板现在不在办公室。";
		next;
		mes "[木工]";
		mes "我不知道他什么时候回来。";
		mes "如果你很着急，不如去^dd5555斐扬森林^000000看看？";
		mes "请前往<NAVI>[那里]<INFO>pay_fild08,157,129,0,101,0</INFO></NAVI>。";
		emotion ET_SORRY;
		completequest 11770;
		setquest 11771;
		navigateto("pay_fild08",157,129);
		close;
	}
	if (isbegin_quest(11771) == 1) {
		mes "[木工]";
		mes "抱歉~客人。";
		mes "老板现在不在办公室。";
		next;
		mes "[木工]";
		mes "我不知道他什么时候回来。";
		mes "如果你很着急，不如去^dd5555斐扬森林^000000？";
		mes "请前往<NAVI>[那里]<INFO>pay_fild08,157,129,0,101,0</INFO></NAVI>。";
		emotion ET_SORRY;
		navigateto("pay_fild08",157,129);
		close;
	}
	mes "[木工]";
	mes "<FONT SIZE = 14>欢迎~ 客人~！</FONT>";
	mes "这里是柴薪木工店~";
	emotion ET_DELIGHT;
	npctalk "欢迎~客人~！", "", bc_self;
	next;
	mes "[木工]";
	mes "还有其他事情吗？";
	close;

OnInit:
	questinfo( QTYPE_JOBQUEST, QMARK_YELLOW, "isbegin_quest(11770) == 1" );
	end;
}

// Step 3, 10
pay_fild08,161,129,5	duplicate(dummy_npc)	Wrecked Cart#JQ_SH	4_EP18_WAGON
pay_fild08,152,129,5	duplicate(dummy_cloaked_npc)	Lee Daegam#JQ_SH_1	2_M_PHARMACIST

pay_fild08,157,129,3	script	Carpenter Firewood#JQ_SH	1_M_SMITH,{
	if (isbegin_quest(11770) != 2) {
		mes "[柴薪木工]";
		mes "啊啊啊~~";
		mes "我今天彻底搞砸了！！！";
		emotion ET_CRY;
		npctalk "啊啊啊……", "", bc_self;
		close;
	}
	if (isbegin_quest(11771) == 1) {
		mes "[柴薪木工]";
		mes "啊啊啊~~";
		mes "我今天真是彻底乱套了！搞砸了！！！";
		emotion ET_CRY;
		npctalk "啊啊啊……", "", bc_self;
		next;
		select( "头目？" );
		mes "[柴薪木工]";
		mes "谁？";
		mes "……";
		mes "是李大监派你来的吗？";
		next;
		mes "[柴薪木工]";
		mes "你烤它已经多久了？又派人来这里吗？！";
		mes "光是催促可解决不了问题！";
		emotion ET_FRET;
		next;
		select( "我是来处理委托的。" );
		mes "[柴薪木工]";
		mes "嗯……";
		mes "<FONT SIZE = 14>嗯……</FONT>";
		mes "<FONT SIZE = 18><B>啊！！！！！！！！！</B></FONT>";
		emotion ET_SURPRISE;
		npctalk "啊啊啊！！！！！！！", "", bc_self;
		next;
		mes "[柴薪木工]";
		mes "嘿嘿~~！！";
		mes "啊啊啊！！！";
		mes "<FONT SIZE = 16>没错！！！！！</FONT>";
		emotion ET_HUK;
		npctalk "没错！！！！！！！！！", "", bc_self;
		next;
		mes "[柴薪木工]";
		mes "<FONT SIZE = 14>抱歉！</FONT>";
		mes "因为工作没有进展、太沮丧了，我出来走走，没想到会有客人来。";
		mes "真丢脸！";
		mes "嘿嘿嘿！";
		emotion ET_PROFUSELY_SWEAT;
		npctalk "我还以为委托来自李大监~", "", bc_self;
		next;
		mes "[柴薪木工]";
		mes "来得正是时候！";
		mes "既然你大老远来到这里，就别回木工店了，过来看看那些讨厌野兽做了什么。";
		npctalk "它们把所有工具都弄得一团糟，我能怎么办！", "", bc_self;
		next;
		mes "[柴薪木工]";
		mes "看起来是鹿和野猪之类的有蹄动物，但是……";
		mes "它们在森林里吃草，为什么会这么凶猛！";
		npctalk "你们这些家伙别被我抓到！我气死了！！", "", bc_self;
		erasequest 11771;
		setquest 11772;
		close;
	}
	if (isbegin_quest(11772) == 1) {
		mes "[柴薪木工]";
		mes "时机正好！";
		mes "既然你大老远来到这里，就别回木工作坊了，过来看看那些可恶野兽干了什么。";
		npctalk "它们把所有工具都弄得一团糟，我能怎么办！", "", bc_self;
		next;
		mes "[柴薪木工]";
		mes "它们看起来像鹿和野猪之类的有蹄动物，但……";
		mes "它们在森林里吃草时为什么这么凶！";
		npctalk "你们这些家伙别被我抓到！我气死了！！", "", bc_self;
		close;
	}
	if (isbegin_quest(11773) == 1 || isbegin_quest(11774) == 1 || isbegin_quest(11775) == 1 || isbegin_quest(11776) == 1 || isbegin_quest(11777) == 1) {
		mes "[柴薪木工]";
		mes "那么，调查进展如何？";
		mes "你找到那些野兽了吗？";
		close;
	}
	if (isbegin_quest(11778) == 1) {
		mes "[柴薪木工]";
		mes "你发现了什么，冒险者？";
		mes "你带来了什么？";
		next;
		select( "关于掉在街上的食物。" );
		mes "[柴薪木工]";
		mes "怎么会有人把食物扔在街上？食物很珍贵，这太浪费了！！";
		emotion ET_ANGER;
		npctalk "我年轻时因为没东西吃，曾经吃树根！！！", "", bc_self;
		next;
		select( "关于野兽。" );
		mes "[柴薪木工]";
		mes "虽然它喂饱了一些野兽，但……";
		next;
		mes "[柴薪木工]";
		mes "那么野兽不是在捡食物时一路来到这里的吗？";
		emotion ET_SURPRISE;
		next;
		mes "[柴薪木工]";
		mes "是谁做了这么奇怪的事……";
		emotion ET_QUESTION;
		next;
		mes "[柴薪木工]";
		mes "总之，冒险者接手了任务，我就能看到一些线索了！";
		mes "照这个势头，我们能在李大监再次发疯前解决问题……";
		next;
		mes "[???]";
		mes "<FONT SIZE = 16>咳咳！</FONT>";
		mes "<FONT SIZE = 14>你有工厂~吗？</FONT>";
		emotion ET_HUK;
		emotion ET_HUK, playerattached();
		cloakoffnpcself( "Lee Daegam#JQ_SH_1" );
		npctalk "什么！！！咳!!!!!!", "Lee Daegam#JQ_SH_1", bc_self;
		next;
		mes "[柴薪木工]";
		mes "唉……";
		mes "艾德加说他会来的……";
		npctalk "艾德加更好。", "", bc_self;
		next;
		mes "[柴薪木工]";
		mes "李大监，你怎么来了？";
		next;
		mes "[李大监]";
		mes "哦~~ 嘿嘿~ 没什么特别的~";
		mes "我来看看一切是否顺利~";
		npctalk "糟糕！地上这些都是什么？", "Lee Daegam#JQ_SH_1", bc_self;
		next;
		mes "[柴薪木工]";
		mes "你总是这样来催也没用……";
		next;
		mes "[李大监]";
		mes "哎呀~";
		mes "看起来和昨天没什么不同。";
		mes "你甚至还没开始工作，却总能听到巨大的声音~";
		next;
		mes "[柴薪木工]";
		mes "<FONT SIZE = 14>哦……我……我……！！！</FONT>";
		mes "<FONT SIZE = 14>工具一直坏掉，我根本没法工作！！！</FONT>";
		mes "<FONT SIZE = 14>如果你是来取笑我的，只会打扰我，快回去！</FONT>";
		emotion ET_FRET;
		next;
		mes "[李大监]";
		mes "哎呀！";
		mes "你不用喊那么大声。我走就是了！";
		mes "<FONT SIZE = 18>哼！</FONT>";
		npctalk "哼！！！", "Lee Daegam#JQ_SH_1", bc_self;
		emotion ET_HNG, getnpcid(0,"Lee Daegam#JQ_SH_1");
		next;
		mes "[柴薪木工]";
		mes "<FONT SIZE = 14>哦，那个老头！</FONT>";
		mes "你到底是要我工作还是不工作？你又让我火大了！";
		cloakonnpcself( "Lee Daegam#JQ_SH_1" );
		next;
		mes "[柴薪木工]";
		mes "他只会打扰我，根本没有帮我完成交给你的工作。";
		mes "<FONT SIZE = 14>哎呀！</FONT>";
		emotion ET_FRET;
		npctalk "盐！我该撒盐了！", "", bc_self;
		next;
		select( "关于李大监。" );
		mes "[柴薪木工]";
		mes "正如你听说的，他是伟大的领袖^123456李大监^000000，把这项工作交给了我。";
		next;
		mes "[柴薪木工]";
		mes "我要在这里为年轻人建造度假地！你觉得怎么样！";
		npctalk "我觉得我们需要把它做得更宏伟。", "", bc_self;
		next;
		mes "[柴薪木工]";
		mes "我说过这里到处是魔物，施工会很困难，但谁知道连野兽也会成为这么大的问题？";
		next;
		mes "[柴薪木工]";
		mes "与此同时，他今天来找我，还那样取笑我……";
		mes "如果你再解决不了这个问题，我想我该辞职了……";
		next;
		mes "[柴薪木工]";
		mes "那么我去整理车上的行李。";
		mes "仔细看看^dd5555损坏的工具^000000。";
		emotion ET_HNG;
		npctalk "这是我的福气！", "", bc_self;
		erasequest 11778;
		setquest 11779;
		close;
	}
	if (isbegin_quest(11779) == 1) {
		mes "[柴薪木工]";
		mes "与此同时，他今天来找我，还那样取笑我……";
		mes "如果你再解决不了这个问题，我想我该辞职了……";
		next;
		mes "[柴薪木工]";
		mes "那么我去整理车上的行李。";
		mes "仔细看看^dd5555损坏的工具^000000。";
		emotion ET_HNG;
		npctalk "这是我的福气！", "", bc_self;
		close;
	}
	// !TODO: unknown dialog for steps [11-14]
	if (isbegin_quest(11769) == 2) {
		mes "[柴薪木工]";
		mes "哎呀……哎呀……";
		mes "怎么会发生这种事……";
		next;
		mes "[柴薪木工]";
		mes "他虽然是个脾气暴躁的人，但并不坏，怎么会这样……";
		mes "哎呀……";
		npctalk "哎呀……", "", bc_self;
		emotion ET_THINK;
		close;
	}
	end;

OnInit:
	// Step 3
	questinfo( QTYPE_JOBQUEST, QMARK_YELLOW, "isbegin_quest(11771) == 1" );

	// Step 10
	questinfo( QTYPE_JOBQUEST, QMARK_YELLOW, "isbegin_quest(11778) == 1" );
	end;
}

// Step 4, 11
pay_fild08,153,129,5	duplicate(dummy_cloaked_npc)	Chulho#JQ_SH_1	4_POINT_BLUE
pay_fild08,153,129,5	duplicate(dummy_cloaked_npc)	Chulho#JQ_SH_1_1	4_EXJOB_CHUL_HO

pay_fild08,155,128,3	script	Broken Tools#JQ_SH	4_BRICKPILE,{
	if (isbegin_quest(11772) == 1) {
		mes "- 里面装着损坏的工具。-";
		next;
		mes "- 箱子周围杂乱地印着动物脚印，正如柴薪木工所说，看起来是草食动物的脚印。-";
		next;
		mes "[柴薪木工]";
		mes "你怎么看，冒险者？";
		mes "你是不是知道些什么？";
		next;
		select( "我想我需要再四处看看。" );
		mes "[柴薪木工]";
		mes "那么仔细看看吧。";
		mes "我们必须尽快开始施工，所以别花太久。";
		next;
		mes "[柴薪木工]";
		mes "如果发现什么，记得告诉我。";
		erasequest 11772;
		setquest 11773;
		navigateto("pay_fild08",153,116);
		close;
	}
	if (isbegin_quest(11773) == 1) {
		mes "- 里面装着损坏的工具。-";
		next;
		mes "- 箱子周围杂乱地印着动物脚印，正如柴薪木工所说，看起来是草食动物的脚印。-";
		next;
		mes "[柴薪木工]";
		mes "你怎么看，冒险者？";
		mes "你是不是知道些什么？";
		next;
		select( "我想我还需要再看看。" );
		mes "[柴薪木工]";
		mes "那么仔细看看吧。";
		mes "我们必须尽快开始施工，所以别花太久。";
		next;
		mes "[柴薪木工]";
		mes "如果发现什么，记得告诉我。";
		navigateto("pay_fild08",153,116);
		close;
	}
	if (isbegin_quest(11779) == 1) {
		mes "- 仔细检查损坏的工具后，你发现了模糊的污渍。-";
		next;
		mes "[哲浩]";
		mes "<FONT SIZE = 16>糟糕！！</FONT>";
		mes "<FONT SIZE = 14>你不能吃那个！</FONT>";
		cutin "ex_sh_chulho00.png",2;
		cloakoffnpcself( "Chulho#JQ_SH_1" );
		npctalk "天哪！！", "Chulho#JQ_SH_1", bc_self;
		next;
		mes "[哲浩]";
		mes "<FONT SIZE = 14>闻起来很香，但会让你生病。</FONT>";
		npctalk "我试过了！", "Chulho#JQ_SH_1", bc_self;
		next;
		mes "[哲浩]";
		mes "<FONT SIZE = 14>我在森林里吃的东西又甜又美味，但之前捡到的蛇草莓很苦！</FONT>";
		mes "<FONT SIZE = 16>我生气了！</FONT>";
		mes "<FONT SIZE = 18>我的肚子好痛！</FONT>";
		npctalk "我的胃还在灼烧！", "Chulho#JQ_SH_1", bc_self;
		emotion ET_PROFUSELY_SWEAT, getnpcid(0,"Chulho#JQ_SH_1");
		next;
		mes "[哲浩]";
		mes "<FONT SIZE = 14>跟着食物来到这里的朋友们也都生气地回家了！</FONT>";

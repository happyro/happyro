			break;
		case 5:
			// Shell, Worm_Peelings, Yellow_Herb
			setarray .@items[0], 935,9, 955,9, 508,9, 7;
			changequest 4001,4006;
			break;
		case 6:
			// Tooth_Of_Bat, Sticky_Mucus, Bear's_Foot
			setarray .@items[0], 913,3, 938,1, 948,1, 8;
			changequest 4001,4007;
			break;
		case 7:
			// Porcupine_Spike, Yoyo_Tail, Acorn
			setarray .@items[0], 1027,2, 942,1, 1026,1, 9;
			changequest 4001,4008;
			break;
		}
		mes "[恶魔猎人]";
		mes "嗯。^660000" + .@items[1] + " " + getitemname(.@items[0]) + "^000000 用作箭头。^660000" + .@items[3] + " " + getitemname(.@items[2]) + "^000000 偶尔使用。还有 ^660000" + .@items[5] + " " + getitemname(.@items[4]) + "^000000 请准备好。";
		HNTR_Q = .@items[6];
		next;
		mes "[恶魔猎人]";
		if (HNTR_Q >= 5)
			mes "顺便说，我们公会的一名成员正在弓箭手公会处理公务。他负责测试，你需要去拜访他。";
		else {
			mes "对了。我们的公会长因公务去了斐扬中央宫殿。他负责主持测试，你必须去拜访他。";
			mes "你可以在斐扬中央宫殿东边的建筑里找到他。";
		}
		next;
		mes "[恶魔猎人]";
		mes "好，准备好一切后再回来~";
		close;
	}
	else if (HNTR_Q >= 3 && HNTR_Q <= 9) {
		if (checkre(0) == true)
			.@i = 1;
		switch(HNTR_Q) {
		case 3:
			// Insect_Feeler/Claw_Of_Desert_Wolf, Wooden_Block, White_Herb
			setarray .@items[0], (.@i?928:7030),5, 1019,5, 509,3, 10;
			break;
		case 4:
			// Bill_Of_Birds, Skel_Bone, Green_Herb
			setarray .@items[0], 925,3, 932,5, 511,3, 10;
			break;
		case 5:
			// Colorful_Shell/Posionous_Canine, Animal's_Skin, Red_Herb
			setarray .@items[0], (.@i?1013:937),3, 919,3, 507,5, 10;
			break;
		case 6:
			// Horn/Dokkaebi_Horn, Poison_Spore/Piece_Of_Egg_Shell, Fluff
			setarray .@items[0], (.@i?947:1021),3, (.@i?7033:7032),3, 914,10, 10;
			break;
		case 7:
			// Shell, Worm_Peelings, Yellow_Herb
			setarray .@items[0], 935,9, 955,9, 508,9, 11;
			break;
		case 8:
			// Tooth_Of_Bat, Sticky_Mucus, Bear's_Foot
			setarray .@items[0], 913,3, 938,1, 948,1, 11;
			break;
		case 9:
			// Porcupine_Spike, Yoyo_Tail, Acorn
			setarray .@items[0], 1027,2, 942,1, 1026,1, 11;
			break;
		}
		mes "[恶魔猎人]";
		mes "嗯？";
		next;
		if (countitem(.@items[0]) >= .@items[1] && countitem(.@items[2]) >= .@items[3] && countitem(.@items[4]) >= .@items[5]) {
			HNTR_Q = .@items[6];
			if (isbegin_quest(4002) == 1)
				changequest 4002,4009;
			else if (isbegin_quest(4003) == 1)
				changequest 4003,4009;
			else if (isbegin_quest(4004) == 1)
				changequest 4004,4009;
			else if (isbegin_quest(4005) == 1)
				changequest 4005,4009;
			else if (isbegin_quest(4006) == 1)
				changequest 4006,4010;
			else if (isbegin_quest(4007) == 1)
				changequest 4007,4010;
			else
				changequest 4008,4010;
			delitem .@items[0],.@items[1];
			delitem .@items[2],.@items[3];
			delitem .@items[4],.@items[5];
			mes "[恶魔猎人]";
			if (HNTR_Q == 10)
				mes "你带来了所有必要材料……可以向目前在斐扬中央宫殿的公会长询问测试地点。";
			else
				mes "你带来了所有必要材料……要知道测试地点，请去弓箭手公会找公会长。";
			close;
		}
		mes "[恶魔猎人]";
		mes "你没有带齐";
		mes "所需材料……";
		next;
		mes "[恶魔猎人]";
		mes "你需要的物品是";
		mes "^660000" + .@items[1] + " " + getitemname(.@items[0]) + "^000000,";
		mes "^660000" + .@items[3] + " " + getitemname(.@items[2]) + "^000000 以及";
		mes "^660000" + .@items[5] + " " + getitemname(.@items[4]) + "^000000.";
		mes "收集齐所有物品后";
		mes "再回来。";
		close;
	}
	else if (HNTR_Q > 9 && HNTR_Q < 17) {
		mes "[恶魔猎人]";
		mes "嗯？你既没有去斐扬中央宫殿，也没有去弓箭手公会找公会长吗？他应该就在其中一处，去找找看吧。";
		close;
	}
	else if (HNTR_Q == 17) {
		mes "[恶魔猎人]";
		mes "哦。你通过测试了。恭喜~现在去找谢琳谈谈。";
		close;
	}
	else {
		mes "[公会接待员]";
		mes "想转职为猎人，必须先登记。";
		close;
	}
}

payon_in03,131,7,3	script	Hunter#htnGM	59,{
	if (HNTR_Q == 10) {
		mes "[猎人公会长]";
		mes "哼。你是来参加猎人转职测试的吧。我来说明测试流程。你想了解什么？";
		next;
		switch( select( "测试是什么？", "通过要求是什么？", "有什么注意事项？", "开始测试。" ) ) {
		case 1:
			mes "[猎人公会长]";
			mes "你必须猎杀指定名称的怪物，同时避开所有陷阱。";
			next;
			mes "[猎人公会长]";
			mes "这是为了测试你在各种情况下快速移动和寻找目标的能力。";
			close;
		case 2:
			mes "[猎人公会长]";
			mes "在时间限制内，从地图 6 点钟方向开始，猎杀目标怪物，然后按下出现在地图中央的逃脱开关。";
			next;
			mes "[猎人公会长]";
			mes "按下开关后从地图 12 点钟方向逃出即可通过。";
			close;
		case 3:
			mes "[猎人公会长]";
			mes "嗯。注意事项……如果掉入陷阱，必须从头开始。而且一次只能有一人参加测试。";
			next;
			mes "[猎人公会长]";
			mes "我会送你去测试地点。那里有等候室，但若有人正在测试，你必须在聊天室等待。";
			next;
			mes "[猎人公会长]";
			mes "前一个人成功、放弃或失败后，聊天室中下一位等待者会被送往测试区。如果没人等待，你进入聊天室后测试就会开始。";
			close;
		case 4:
			// Note: aegis typo
			// if (.@a0) {
			// 	mes "[猎人公会长]";
			// 	mes "好。我现在就送你去测试区。若你因没听说明而迷路或困惑，别怪我。";
			// }
			// else {
			// 	mes "[猎人公会长]";
			// 	mes "Okay. Best of luck.";
			// 	mes "I'll send you right now.";
			// }
			mes "[猎人公会长]";
			mes "好。我现在就送你去测试区。若你因没听说明而迷路或困惑，别怪我。";
			next;
		}
		mes "[猎人公会长]";
		mes "那么，你的箭可能还在制作中，可以用我的参加测试。";
		HNTR_Q = 12;
		changequest 4009,4011;
		getitem 1751,200; // Silver_Arrow
		close2;
		warp "job_hunte",176,22;
		end;
	}
	else if (HNTR_Q > 1 && HNTR_Q < 10) {
		mes "[猎人公会长]";
		mes "嗯……？";
		mes "弓箭手来";
		mes "找我做什么？";
		next;
		mes "[猎人公会长]";
		mes "我没收到猎人公会的特别通知。你不是想跳过猎人测试的中间环节吧？";
		next;
		mes "[猎人公会长]";
		mes "收集测试所需物品，并拜访猎人公会后再回来。";
		close;
	}
	else if (HNTR_Q == 11) {
		mes "[猎人]";
		mes "嗯？我能帮你吗？如果你想转职，应该去弓箭手公会找那个人，而不是找我。";
		close;
	}
	else if (HNTR_Q > 11 && HNTR_Q < 16) {
		mes "[猎人公会长]";
		mes "嗯。你就是差点放弃转职的弓箭手。你已经准备好了吗？那我马上送你去测试。";
		next;
		mes "[猎人公会长]";
		mes "如果你有任何";
		mes "问题，现在就问。";
		next;
		switch( select( "测试是什么？", "通过要求是什么？", "有什么注意事项？", "开始测试。" ) ) {
		case 1:
			mes "[猎人公会长]";
			mes "你必须猎杀指定名称的怪物，同时避开所有陷阱。这是为了测试你在各种情况下快速移动和寻找目标的能力。";
			close;
		case 2:
			mes "[猎人公会长]";
			mes "在规定时间内，你从地图 6 点钟方向开始，猎杀目标怪物，然后按下出现在中央的逃脱开关。";
			next;
			mes "[猎人公会长]";
			mes "按下开关后从地图 12 点钟方向逃出即可通过。";
			close;
		case 3:
			mes "[猎人公会长]";
			mes "嗯。注意事项……如果掉入陷阱，必须从头开始。而且一次只能有一人参加测试。";
			next;
			mes "[猎人公会长]";
			mes "我会送你去测试地点。那里有等候室，但若有人正在测试，你必须在聊天室等待。";
			next;
			mes "[猎人公会长]";
			mes "前一个人成功、放弃或失败后，聊天室中下一位等待者会被送往测试区。如果没人等待，你进入聊天室后测试就会开始。";
			close;
		case 4:
			mes "[猎人公会长]";
			mes "好。祝你好运。";
			mes "我现在就送你过去。";
			next;
		}
		mes "[猎人公会长]";
		mes "咦？为什么不给你银箭？没带材料就别指望得到任何东西。";
		next;
		mes "[猎人公会长]";
		mes "总之，我相信你已经自己准备好了。现在开始吧。";
		next;
		if (select( "好。开始吧……", "啊，等一下。" ) == 1) {
			mes "[猎人公会长]";
			mes "好！！希望";
			mes "你这次能通过！";
			close2;
			HNTR_Q = 12;
			warp "job_hunte",176,22;
			end;
		}
		mes "[猎人公会长]";
		mes "那就快点完成";
		mes "所有准备工作。";
		close;
	}
	else if (HNTR_Q == 16) {
		mes "[猎人公会长]";
		mes "哇，你平安回来了！";
		mes "我是说，干得好。我会给你证明通过测试的物品。";
		HNTR_Q = 17;
		savepoint "payon",104,99,1,1;
		getitem 1007,1; // Penetration
		changequest 4012,4013;
		next;
		mes "[Hunter Guildmaster]";
		mes "好了，就是这个。现在回猎人公会吧。我这里还有些事务，希望你很快能成为猎人。";
		close;
	}
	else if (HNTR_Q == 17) {
		mes "[Hunter Guildmaster]";
		mes "看来你不急着成为猎人？我刚成为猎人时高兴得挥舞弓箭到处跑了一个月。呵呵~";
		next;
		mes "[Hunter Guildmaster]";
		mes "现在，你该回猎人公会了~";
		close;
	}
	else {
		mes "[Hunter]";
		mes "……我能帮你吗？";
		mes "我正在处理公务，现在很忙。失陪了……";
		close;
	}
}


job_hunte,178,32,1	script	Guide#hnt	107,5,2,{
OnTouch_:
	if (HNTR_Q == 12) {
		mes "[Guide]";
		mes "你好。欢迎来到猎人测试场地。进入下一个房间后测试开始。";
		next;
		mes "[Guide]";
		mes "如前所述，猎杀 4 只或更多名为 ^3355FF转职怪物^000000 的怪物。完成后地图中央会出现开关。";
		next;
		mes "[Guide]";
		mes "破坏开关后，出口会出现在地图 12 点钟方向。请在规定时间内完成一切并逃出。";
		next;
		mes "[Guide]";
		mes "如果中途昏倒、掉入陷阱或超过时间限制，就会失败，必须重新参加测试。";
		next;
		mes "[Guide]";
		mes "我们会提供箭，只要带上弓即可。准备好后请进入。";
		savepoint "job_hunte",176,22,1,1;
		close;
	}
	else if (HNTR_Q > 12 && HNTR_Q < 16) {
		mes "[Guide]";
		mes "嗯……";
		mes "你搞砸了吗？";
		mes "我先帮你恢复一些";
		mes "HP 和 SP。";
		percentheal 100,100;
		next;
		mes "[Guide]";
		mes "如果太难，下次再试也无妨。现在要放弃吗？";
		next;
		if (select( "继续尝试。", "放弃。" ) == 1) {
			mes "[Guide]";
			mes "好。努力成为优秀的猎人吧。请进入等候室。如果有人正在测试，你必须等到对方结束。";
			close;

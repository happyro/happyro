//===== rAthena Script =======================================
//= St. Patrick's Day (2008)
//===== By: ==================================================
//= Kisuka
//===== Current Version: =====================================
//= 1.5
//===== Compatible With: =====================================
//= rAthena Project
//===== Description: =========================================
//= iRO St. Patrick's Day. (2008)
//= Find O'Riley's treasure for him, then hunt down coinds from
//= the snakes to get Green Ale in return for them.
//=
//= Mobs 1841 through 1844 have been modified for this event
//= you must use the mob edits provided for this quest.
//= Enable in mob_db2.txt
//=
//= The item 12715 Black_Treasure_Chest contains a script 
//= that relies explicitly on this script being loaded.
//= Remove the "end" from the item script to enable.
//= In addition to that, you must enable the item_avail
//= entries if you are using a kRO client, as the items
//= were removed from the client between testing and this
//= updated.
//===== Additional Comments: =================================
//= 1.0 First version. [Kisuka]
//= 1.1 Fixed checkitems for ale, fixed ale prize(gives the correct one now). [Kisuka]
//= 1.2 Optimized. Uses only one variable now. [L0ne_W0lf]
//=     Corrected EXP rewards, and some typos.
//= 1.3 Corrected random in item function. [L0ne_W0lf]
//= 1.4 Replaced effect numerics with constants. [Samuray22]
//= 1.5 Revamped the script. [Kisuka]
//============================================================

prt_fild05,170,286,4	script	Anxious Leprechaun#8pday	954,{
	if (StPatrick2008 < 1) {
		mes "[奥莱利·小妖精]";
		mes "嗯……";
		mes "今天真是好天气。";
		mes "如果你有空，";
		mes "过来，我告诉你一件事。";
		next;
		select("请说。 ");
		mes "[奥莱利·小妖精]";
		mes "这些年我一直周游世界，每次蛇都会偷走我的宝藏。";
		next;
		select("哦？");
		mes "[奥莱利·小妖精]";
		mes "这片土地上的好心人总是一次又一次帮我找回宝藏。";
		next;
		mes "[奥莱利·小妖精]";
		mes "我吸取了教训，永远不会忘记那些卑鄙的蛇如何伤害我。";
		next;
		select("你做了什么？");
		mes "[奥莱利·小妖精]";
		mes "我找了个安全的地方藏起宝藏。";
		mes "藏在秘密地点，宝藏就能安全保存到我第二年回到这个世界。";
		next;
		mes "[奥莱利·小妖精]";
		mes "今年我再次踏上旅程，看看外面的世界。";
		mes "我去了藏金处，发现它安全且无人动过。";
		next;
		mes "[奥莱利·小妖精]";
		mes "我心想，能把宝藏藏起来躲过蛇，我真聪明。";
		mes "哦，但我还是个傻瓜。";
		next;
		select("发生了什么？");
		mes "[奥莱利·小妖精]";
		mes "我的藏身处太巧妙了。";
		mes "我拉、抬、推了半天，但藏身处纹丝不动。";
		mes "所以今年我又没有宝藏了。";
		next;
		mes "[奥莱利·小妖精]";
		mes "因为这场混乱，我甚至还没开始酿著名的绿啤酒。";
		mes "我想问你，能帮我找回宝藏吗？";
		next;
		if (select("当然，我能帮你。:我太忙了。") == 2) {
			mes "[奥莱利·小妖精]";
			mes "好，我明白了。";
			mes "谢谢你听我讲故事。";
			close;
		}
		mes "[奥莱利·小妖精]";
		mes "要找到我的宝藏，";
		mes "我把秘密告诉你。";
		next;
		mes "[奥莱利·小妖精]";
		mes "所以仔细听，别漏掉任何细节。";
		mes "前往魔法师之城。";
		mes "过桥渡水，";
		mes "爬上山，直到再也无法向北前进。";
		next;
		mes "[奥莱利·小妖精]";
		mes "经过悬在空中的石阶。";
		mes "宝藏就藏在山壁里。";
		next;
		mes "[奥莱利·小妖精]";
		mes "你必须想办法把它炸开。";
		mes "需要强力爆炸才能取出宝藏。";
		next;
		mes "[奥莱利·小妖精]";
		mes "可以试试爆竹。";
		mes "当然需要很多，至少要 ^FF0000200 个爆竹^000000。";
		set StPatrick2008,1;
		close;
	}
	else if (StPatrick2008 == 1) {
		mes "[奥莱利·小妖精]";
		mes "今天真是好天气。";
		mes "你找到我的宝藏了吗？";
		mes "我的藏身处很难打开。";
		next;
		mes "[奥莱利·小妖精]";
		mes "可以试试爆竹。";
		mes "当然需要很多，至少要 ^FF0000200 个爆竹^000000。";
		next;
		mes "[奥莱利·小妖精]";
		mes "如果你无法取出宝藏，我也能理解。";
		close;
	}
	else if (StPatrick2008 == 2) {
		mes "[奥莱利·小妖精]";
		mes "哦，欢迎回来！";
		mes "谢谢你找回我的宝藏！";
		mes "我的感激无边无际！";
		next;
		mes "[奥莱利·小妖精]";
		mes "我太高兴了，";
		mes "马上就开始酿酒。";
		next;
		mes "[奥莱利·小妖精]";
		mes "看来蛇今年又回来了，想再次偷走我的宝藏。";
		next;
		mes "[奥莱利·小妖精]";
		mes "蛇带走了我同族的硬币，必须受到惩罚。";
		mes "但你经历了漫长旅程，我对此非常感激。";
		next;
		mes "[奥莱利·小妖精]";
		mes "休息一下双腿后，再来和我谈谈。";
		close2;
		set StPatrick2008,3;
    		getexp 200000,70000;
		delitem 7721,1;
		end;
	}
	else if (StPatrick2008 == 3) {
		mes "[奥莱利·小妖精]";
		mes "啊，希望你休息好了？";
		next;
		mes "[奥莱利·小妖精]";
		mes "谢谢你再次来访。";
		mes "蛇带走了我同族的硬币，必须受到惩罚。";
		next;
		mes "[奥莱利·小妖精]";
		mes "如果你带来那些卑鄙蛇偷走的不义之财，我会慷慨地送你一些著名的酿酒。";
		next;
		mes "如果找到我同族的宝藏，请把硬币带给我，别让蛇得到它们。";
		set StPatrick2008,4;
		close;
	}
	else if (StPatrick2008 == 4) {
		mes "[奥莱利·小妖精]";
		mes "蛇带走了太多同族硬币，我会用一品脱酿酒奖励归还硬币的人。";
		next;
		mes "[奥莱利·小妖精]";
		mes "我会用一壶麦酒奖励 ^0000FF1 枚金币^000000、^0000FF5 枚银币^000000 或 ^0000FF10 枚铜币^000000。";
		mes "这是不义之财应得的赏金。";
		mes "那么，你带来了哪种硬币？";
		next;
		switch(select("铜币:银币:金币:退出。")) {
		case 1:
		mes "[奥莱利·小妖精]";
			mes "谢谢。这是你的麦酒~";
			if (countitem(7915) >= 10) {
				getitem 12135,1; 
				delitem 7915,10;
			}
			close;
		case 2:
		mes "[奥莱利·小妖精]";
			mes "谢谢。这是你的麦酒~";
			if (countitem(7916) >= 5) {
				getitem 12135,1; 
				delitem 7916,5;
			}
			close;
		case 3:
		mes "[奥莱利·小妖精]";
			mes "谢谢。这是你的麦酒~";
			if (countitem(7720) >= 1) {
				getitem 12135,1; 
				delitem 7720,1;
			}
			close;
		case 4:
			mes "[奥莱利·小妖精]";
			mes "我会用一壶麦酒奖励 ^0000FF1 枚金币^000000、^0000FF5 枚银币^000000 或 ^0000FF10 枚铜币^000000。";
			close;
		}
	}
}

mjolnir_01,272,363,4	script	Rocks#08StPattysDay	-1,1,1,{
	end;

OnTouch:
	if (StPatrick2008 < 1) {
		mes "- 你发现了一堆覆满泥土的石头。-";
		close;
	}
	if (StPatrick2008 == 1) {
		mes "- 你发现了一堆被泥土覆盖的石头。-";
		next;
		if (countitem(12018) < 200) {
			mes "石头纹丝不动。";
			mes "也许 O'Riley 知道怎么移开它们。";
			close;
		}
		else {
			if (select("使用爆竹。:忽略") == 2) {
				close;
			}
			mes "你把 200 个爆竹埋在石堆下面。";
			mes "你点燃了引线。";
			next;
			mes "*BOOM!*";
			specialeffect2 EF_LORD;
			next;
			mes "尘土和烟雾散去后，";
			mes "你在石头和泥土之间发现了一个箱子。";
			mes "箱子里一定装着 O'Riley 的财宝。";
			mes "把箱子带给 O'Riley 吧。";
			close2;
			set StPatrick2008,2;
			delitem 12018,200;
			getitem 7721,1;
		}
	}
	end;
}

function	script	F_08stpattyseventbox	{
	switch(rand(1,6)) {
	case 1:
		getitem 7915,1;
		end;
	case 2:
		getitem 7915,1;
		getitem 7916,1;
		getitem 7720,1;
		end;
	case 3:
		getitem 7720,1;
		end;
	case 4:
		getitem 7915,1;
		getitem 7916,1;
		end;
	case 5:
		getitem 7916,2;
		end;
	case 6:
		getitem 7915,2;
		end;
	}
}



	}
	else if (sign_q == 26) {
		mes "嘿嘿嘿~";
		mes "那么，你有没有";
		mes "把钱带来？";
		next;
		switch(select("给你……:还没有……")) {
		case 1:
	mes "[迪尔斯]";
			mes "嗯……";
			if (Zeny < 30000) {
				mes "我说的是 30,000 Zeny，";
				mes "就是 30,000 Zeny！看你似乎连数数都不太会，";
				mes "这次我就放过你。但你要是再这样，";
				mes "我就……！";
			}
			else {
				mes "嘿嘿~";
				mes "这就是三万 Zeny，";
				mes "很好！明天晚上再来找我，";
				mes "我们就开始测试……";
				mes "别迟到。";
				set sign_q,27;
				set Zeny, Zeny-30000;
			}
			close;
		case 2:
	mes "[迪尔斯]";
			mes "咦……？";
			mes "好吧，但你最好快点。";
			mes "我随时都可能改变主意，";
			mes "你知道的！";
			mes "别让我等太久。";
			close;
		}
	}
	else if (sign_q == 27) {
		if ((gettime(DT_HOUR) > 18) && (gettime(DT_HOUR) < 23)) {
			mes "很好，你来得正是时候。";
			mes "总之，重要的是";
			mes "你在夜里来找我。";
			mes "时间必须正确。";
			next;
	mes "[迪尔斯]";
			mes "你想知道我这样的人为什么会和梅茨是朋友，";
			mes "但这不关你的事。";
			mes "我既然答应了他，就得遵守承诺。";
			mes "准备好后告诉我。";
			mes "我们马上开始。";
			mes "别再犹豫。";
			set sign_q,28;
			close;
		}
		else {
			mes "嘿……我说‘明天晚上’，";
			mes "是指晚上来和我说话！";
			mes "你连这种秘密交易的常识都不懂吗？！哼！冒险者……";
			close;
		}
	}
	else if (sign_q== 28) {
		mes "好！我要你带来一堆物品！";
		mes "我知道你是这方面的专家，";
		mes "但在你把它当成小菜一碟前，";
		mes "我先把规则说清楚……";
		mes "别以为测试很简单。";
		mes "认真听着。";
		next;
	mes "[迪尔斯]";
		mes "我不会给你具体的物品清单。";
		mes "不，你要做的是带来艺术品。";
		mes "这项测试会考验你对";
		mes "工艺的欣赏能力~";
		mes "要有品味。";
		mes "明白了吗？";
		next;
	mes "[迪尔斯]";
		mes "因为我要判断你有没有品味，";
		mes "所以多样性非常重要。";
		mes "别带一百个同样的东西。";
		mes "每种带一个就够了。";
		mes "记住，品种越丰富越好。";
		mes "别让我失望。";
		next;
	mes "[迪尔斯]";
		mes "你还在";
		mes "等什么？";
		mes "快把收集到的物品带来！";
		mes "测试不会自己完成。";
		set sign_q,29;
		close;
	}
	else if (sign_q < 35) {
		switch(sign_q) {
		case 29:
			mes "啊，这就是";
			mes "你带来的东西吗？";
			mes "让我看看……";
			if (countitem(734)) set .@diaris_t,.@diaris_t+1;
			if (countitem(735)) set .@diaris_t,.@diaris_t+1;
			if (countitem(736)) set .@diaris_t,.@diaris_t+1;
			if (countitem(7149)) set .@diaris_t,.@diaris_t+1;
			if (countitem(747)) set .@diaris_t,.@diaris_t+2;
			if (countitem(749)) set .@diaris_t,.@diaris_t+4;
			if (countitem(740)) set .@diaris_t,.@diaris_t+1;
			if (countitem(741)) set .@diaris_t,.@diaris_t+1;
			if (countitem(742)) set .@diaris_t,.@diaris_t+2;
			if (countitem(743)) set .@diaris_t,.@diaris_t+3;
			if (countitem(752)) set .@diaris_t,.@diaris_t+3;
			if (countitem(753)) set .@diaris_t,.@diaris_t+4;
			if (countitem(754)) set .@diaris_t,.@diaris_t+4;
			if (countitem(750)) set .@diaris_t,.@diaris_t+7;
			if (countitem(751)) set .@diaris_t,.@diaris_t+7;
			next;
			if (.@diaris_t > 10) {
	mes "[迪尔斯]";
				mes "不错，不错~";
				mes "这些能卖——";
				mes "呃，我很高兴地告诉你，";
				mes "你暂时通过了。";
				next;
	mes "[迪尔斯]";
				mes "我想你已经准备好";
				mes "进入下一步了。现在，";
				mes "我要把你送去拉玛丁，";
				mes "参加测试第二部分。";
				mes "没错，我知道……";
				if (countitem(734)) delitem 734,1; //Red_Frame
				if (countitem(735)) delitem 735,1; //Blue_Porcelain
				if (countitem(736)) delitem 736,1; //White_Platter
				if (countitem(7149)) delitem 7149,1; //Yellow_Plate
				if (countitem(747)) delitem 747,1; //Crystal_Mirror
				if (countitem(749)) delitem 749,1; //Frozen_Rose
				if (countitem(740)) delitem 740,1; //Stuffed_Doll
				if (countitem(741)) delitem 741,1; //Poring_Doll
				if (countitem(742)) delitem 742,1; //Chonchon_Doll
				if (countitem(743)) delitem 743,1; //Spore_Doll
				if (countitem(752)) delitem 752,1; //Grasshopper_Doll
				if (countitem(753)) delitem 753,1; //Monkey_Doll
				if (countitem(754)) delitem 754,1; //Raccoondog_Doll
				if (countitem(750)) delitem 750,1; //Baphomet_Doll
				if (countitem(751)) delitem 751,1; //Osiris_Doll
				set sign_q,30;
				if (checkre(3)) {
					if (BaseLevel < 60) getexp 300,0;
					else if (BaseLevel < 70) getexp 500,0;
					else if (BaseLevel < 80) getexp 800,0;
					else if (BaseLevel < 90) getexp 1000,0;
					else getexp 1300,0;
				} else {
					if (BaseLevel < 60) getexp 3000,0;
					else if (BaseLevel < 70) getexp 5000,0;
					else if (BaseLevel < 80) getexp 8000,0;
					else if (BaseLevel < 90) getexp 10000,0;
					else getexp 13000,0;
				}
				next;
				warp "cmd_in01",33,29;
				end;
			}
			else if ((.@diaris_t > 0) && (.@diaris_t < 11)) {
	mes "[迪尔斯]";
				mes "嗯……有些东西不错，";
				mes "但这里的种类还不够多，";
				mes "无法证明你有工艺品鉴赏力。";
				mes "再带些东西回来，好吗？";
				mes "这次要注意多样性。";
				mes "不要带重复的物品。";
				close;
			}
			else {
	mes "[迪尔斯]";
				mes "嗯……";
				mes "你带的这些东西？";
				mes "全都是没用的垃圾！";
				mes "去找那些精心制作的东西，";
				mes "明白了吗？";
				next;
	mes "[迪尔斯]";
				mes "我说的工艺品不是药水、武器或装备，";
				mes "那些都不算。想想你会在房间里展示的物品，";
				mes "这样就找对方向了。记住，要多样！";
				close;
			}
		case 30:
		case 31:
			mes "嘿，你得完成";
			mes "我的测试第二部分。";
			mes "现在我要把你送去拉玛丁……";
			mes "快去准备。";
			close2;
			warp "cmd_in01",33,29;
			end;
		case 32:
			mes "你没通过第二部分，";
			mes "也就是我那该死测试的节奏环节？！";
			mes "如果你想再试一次，";
			mes "我可以再给你一个机会……";
			mes "不过别再失败了。";
			next;
			switch(select("好。:以后再说。")) {
			case 1:
	mes "[迪尔斯]";
				mes "好吧……";
				mes "记住，第二部分本来";
				mes "应该是简单的部分……";
				mes "你要认真练习。";
				mes "下次再来吧。";
				close2;
				warp "cmd_in01",33,29;
				end;
			case 2:
	mes "[迪尔斯]";
			mes "什么……？";
			mes "好吧，但你真的不该放弃。";
			mes "我的意思是，第二部分本来";
			mes "应该非常简单。";
			mes "是我故意设计成这样的……";
			mes "再试一次吧。";
				close;
			}
		case 33:
			mes "好吧，拉玛丁告诉我";
			mes "你通过了。";
			mes "表现算不上最好，";
			mes "但也足够了。";
			mes "你做得不错。";
			next;
	mes "[迪尔斯]";
			mes "好吧，拿上这块呜咽的星光，";
			mes "去艾尔贝塔找一个叫";
			mes "‘贝克兰’的人。";
			mes "他会告诉你下一步该做什么。";
			set sign_q,35;
			getitem 7177,1; //Part_Of_Star's_Sob
			if (checkre(3)) {
				if (BaseLevel < 60) getexp 300,0;
				else if (BaseLevel < 70) getexp 700,0;
				else if (BaseLevel < 80) getexp 1900,0;
				else if (BaseLevel < 90) getexp 1200,0;
				else getexp 1700,0;
			} else {
				if (BaseLevel < 60) getexp 3000,0;
				else if (BaseLevel < 70) getexp 7000,0;
				else if (BaseLevel < 80) getexp 19000,0;
				else if (BaseLevel < 90) getexp 12000,0;
				else getexp 17000,0;
			}
			next;
	mes "[迪尔斯]";
			mes "好了，就这样。";
			mes "你应该没有理由再来见我了。";
			mes "不过，祝你处理呜咽的星光时好运。";
			mes "别把它弄丢。";
			mes "那可是重要物品。";
			mes "一路顺风。";
			close;
		case 34:
			mes "拉玛丁告诉我你通过了。";
			mes "因为你表现很好，";
			mes "我会把^333333一部分^000000钱还给你。";
			mes "不是全部，但大部分。";
			mes "这个奖励够了吧？";
			mes "别再抱怨了。";
			next;
	mes "[迪尔斯]";
			mes "好吧，拿上这块呜咽的星光，";
			mes "去艾尔贝塔找一个叫";
			mes "‘贝克兰’的人。";
			mes "他会告诉你下一步该做什么。";
			set sign_q,35;
			getitem 7177,1; //Part_Of_Star's_Sob
			set Zeny, Zeny+20000;
			if (checkre(3)) {
				if (BaseLevel < 60) getexp 300,0;
				else if (BaseLevel < 70) getexp 700,0;
				else if (BaseLevel < 80) getexp 1000,0;
				else if (BaseLevel < 90) getexp 1400,0;
				else getexp 1900,0;
			} else {
				if (BaseLevel < 60) getexp 3000,0;
				else if (BaseLevel < 70) getexp 7000,0;
				else if (BaseLevel < 80) getexp 10000,0;
				else if (BaseLevel < 90) getexp 14000,0;
				else getexp 19000,0;
			}
			next;
	mes "[迪尔斯]";
			mes "好了，就这样。";
			mes "你没理由再来见我了。";
			mes "不过，祝你处理呜咽的星光时好运。";
			mes "别把它弄丢。";
			mes "那可是重要物品。";
			mes "一路顺风。";
			close;
		}
	}
	else if (sign_q == 97) {
		mes "不……！该死，";
		mes "又来了！我的";
		mes "好运什么时候";
		mes "才会开始？";
		next;
	mes "[迪尔斯]";
		mes "嘿，你这表情看起来";
		mes "像是想从我这里得到什么。";
		if (Zeny < 10000) {
			mes "而且你似乎缺钱~！像你这种不知羞耻的";
			mes "寄生虫，就该受到这样的待遇！";
			emotion ET_HNG;
			percentheal -10,0;
			close;
		}
		else {
			mes "而且你似乎还有多余的 Zeny！我就自己拿一点，借用你的钱吧！";
			mes "^FF0000拿来！^000000";
			mes "嘻嘻嘻……";
			set Zeny, Zeny-10000;
			close;
		}
	}
	else if (sign_q == 98) {
		mes "你你你你你在这里做什么？";
		if (Zeny > 9999) {
			mes "好吧，既然我们认识，";
			mes "我就借一点钱。";
			mes "看在过去的交情上。^FF0000拿来！^000000";
			mes "别反抗。";
			emotion ET_KIK;
			set Zeny, Zeny-10000;
		}
		else {
			mes "我没什么给你，";
			mes "你显然也没什么给我！";
			mes "现在让我赌一把！";
			emotion ET_HNG;
		}
		close;
	}
	else {
		mes "嘿，你为什么还在和我说话？";
		mes "你已经完成我的测试了。";
		mes "结束了。现在离开这里，";
		mes "免得我再拿走你的钱！";
		emotion ET_KIK;
		next;
		switch(select("好。:我想再参加第二部分。")) {
		case 1:
	mes "[迪尔斯]";
				mes "好，好。";
				mes "真是的，这些人为什么总是";
				mes "来烦我？";
				mes "快走吧。";
			emotion ET_HNG;
			close;
		case 2:
	mes "[迪尔斯]";
				mes "什么……？";
				mes "第二部分真的";
				mes "那么有趣吗？好吧，";
				mes "随你便。";
			next;
			warp "cmd_in01",33,29;
			end;
		}
	}
}

cmd_in01,33,25,5	script	Examiner#sign	724,{
	callfunc "F_UpdateSignVars";
	mes "[拉玛丁]";
	if (sign_q == 30) {
		mes "欢迎来到";
		mes "Dearles 测试的第二部分，";
		mes "这里会测试你的节奏感~";
		mes "请做好准备。";
		next;
	mes "[拉玛丁]";
		mes "请点击聊天房间进入";
		mes "待机房间。轮到你时，";
		mes "测试就会开始！";
		mes "请耐心等待。";
		next;
	mes "[拉玛丁]";
		mes "左上方的标记代表‘上’，";
		mes "总共有四个标记，分别是上、下、左、右。";
		mes "击中每个标记都会发出声音。";
		mes "请记住它们的位置。";
		mes "这对测试很重要。";
		mes "不要弄错。";
		next;
	mes "[拉玛丁]";
		mes "测试时，";
		mes "你必须按照指示击中标记，";
		mes "才能演奏音乐。";
		mes "很有意思吧？";
		mes "集中注意力。";
		next;
	mes "[拉玛丁]";
		mes "我负责评判你的表现并决定你是否合格。";
		mes "完成测试后回来找我。祝你好运~";
		mes "请尽全力表现。";
		mes "不要紧张。";
		close;
	}
	else if (sign_q == 31) {
		set sign_q,30;
		mes "请点击聊天房间进入";
		mes "待机房间。轮到你时，";
		mes "测试就会开始！";
		mes "请耐心等待。";
		next;
	mes "[拉玛丁]";
		mes "左上方的标记代表‘上’，";
		mes "总共有四个标记，分别是上、下、左、右。";
		mes "击中每个标记都会发出声音。";
		mes "请记住它们的位置。";
		mes "这对测试很重要。";
		mes "不要弄错。";
		next;
	mes "[拉玛丁]";
		mes "测试时，";
		mes "你必须按照指示击中标记，";
		mes "才能演奏音乐。";
		mes "很有意思吧？";
		mes "集中注意力。";
		next;
	mes "[拉玛丁]";
		mes "我负责评判你的表现并决定你是否合格。";
		mes "完成测试后回来找我。祝你好运~";
		mes "请尽全力表现。";
		mes "不要紧张。";
		close;
	}
	else if (sign_q == 32) {
		mes "让我看看……";
		mes "你是"+ strcharinfo(0) +"？";
		mes "哦，真遗憾！";
		mes "这次你没通过。";
		mes "不过不用担心……";
		next;
	mes "[拉玛丁]";
		mes "你随时都可以";
		mes "再试一次，明白吗？";
		mes "谢谢~";
		mes "下次一定能成功。";
		set sign_q,30;
		close;
	}
	else if (sign_q == 33) {
		mes "让我看看……";
		mes "你是"+ strcharinfo(0) +"？";
		mes "恭喜你！";
		mes "你通过了测试！";
		next;
	mes "[拉玛丁]";
		mes "我马上给 Dearles 先生送信，";
		mes "请再去和他谈谈。";
		mes "再次恭喜你，做得很好~";
		mes "继续努力。";
		close;
	}
	else if (sign_q == 34) {
		mes "让我看看……";
		mes "你是"+ strcharinfo(0) +"？";
		mes "恭喜你！";
		mes "你在这次测试中取得了满分！";
		next;
	mes "[拉玛丁]";
		mes "我马上给 Dearles 先生送信，";
		mes "请再去和他谈谈。";
		mes "你表现得这么好，";
		mes "他也许会给你奖励~";
		mes "好好享受你的成果吧。";
		mes "你值得这份荣誉。";
		mes "请继续努力。";
		mes "未来还有更多挑战。";
		mes "祝你好运。";
		mes "下次再见。";
		close;
	}
	else {
		mes "你、你怎么找到这里的？";
		mes "这里是私人领地，";
		mes "属于 Dearles 先生。";
		mes "请立即离开！";
		mes "不要擅自闯入。";
		next;
		warp "comodo",187,164;
		end;
	}
}

cmd_in01,16,24,0	script	Emergency Exit	111,{
	mes "[出口]";
		mes "你想出去吗？";
	next;
		switch(select("是。:否。")) {
	case 1:
	mes "[出口]";

// ant_d02_i,130,73,2	script	Briashen#part8	RANGER,{
ant_d02_i,130,73,2	script(CLOAKED)	Briashen#part8	HIDDEN_NPC,{
	if (ill_anthell == 8) {
		mes "[" + strcharinfo(0) + "]";
		mes "!";
		unittalk getcharid(3), "" + strcharinfo(0) + " : !", bc_self;
		next;
		select( "那个布里阿申是真的吗？" );
		mes "[" + strcharinfo(0) + "]";
		mes "...";
		unittalk getcharid(3), "" + strcharinfo(0) + " : ...", bc_self;
		next;
		select( "那个维塔塔就是卡赫里斯" );
		mes "[" + strcharinfo(0) + "]";
		mes "...";
		unittalk getcharid(3), "" + strcharinfo(0) + " : ...", bc_self;
		next;
		select( "我怎么知道" );
		mes "[" + strcharinfo(0) + "]";
		mes "卡赫里斯！";
		unittalk getcharid(3), "" + strcharinfo(0) + " : 卡赫里斯！", bc_self;
		next;
		mes "== 维塔塔转过身来。 ==";
		next;
		mes "[Briashen]";
		mes "...";
		next;
		mes "[Briashen]";
		mes "" + strcharinfo(0) + ".";
		mes "我想不起卡赫里斯长什么样了……";
		next;
		// specialeffect 1313;	// unsupported effect id?
		mes "[" + strcharinfo(0) + "]";
		mes "布里阿申，那很危险！";
		next;
		mes "[Briashen]";
		mes "呃！";
		cloakonnpcself( "Vitata#part9" );
		cloakoffnpcself( "Quiet Maya#part10" );
		cloakoffnpcself( "Vitata#part11" );
		specialeffect EF_FREEZE, AREA, "Quiet Maya#part10";
		// specialeffect 1314, AREA, "Vitata#part11";	// unsupported effect id?
		next;
		mes "[Briashen]";
		mes "卡赫里斯……！？";
		next;
		mes "[Khahris]";
		mes "..., ...";
		npctalk "布里阿申，对不起。我觉得我们不能再一起冒险了。", "Vitata#part11", bc_self;
		next;
		mes "[Briashen]";
		mes "什么？不要！";
		mes "卡赫里斯！！";
		next;
		mes "== 卡赫里斯的话语仿佛隔着水，从远处传来…… ==";
		next;
		mes "[Khahris]";
		mes "......, ....";
		npctalk "反正我也无法出去。别难过。我希望能成为你心中的一部分。和你一起很开心。", "Vitata#part11", bc_self;
		next;
		mes "[Briashen]";
		mes "卡赫里斯？";
		next;
		mes "[Khahris]";
		mes "...., ...";
		npctalk "冒险家。我只是布里阿申来到这里时产生的认知错误的一部分。", "Vitata#part11", bc_self;
		next;
		mes "[Briashen]";
		mes "你在说什么？";
		next;
		mes "[Khahris]";
		mes "..., .....";
		npctalk "就算布里阿申不来，我最终也会消失。不过，还是谢谢你来找我。", "Vitata#part11", bc_self;
		next;
		mes "[Khahris]";
		mes "...., .., ...";
		next;
		mes "== 我再也听不见卡赫里斯的声音了。 ==";
		mes "== 玛雅摆动触角，想听清这个故事。 ==";
		next;
		mes "[Briashen]";
		mes "卡赫里斯！";
		next;
		specialeffect EF_CLOUD4, AREA, "Vitata#part11";
		cloakonnpcself( "Vitata#part11" );
		cloakonnpcself( "Quiet Maya#part10" );
		mes "== 玛雅和卡赫里斯融入黑暗，消失不见了。 ==";
		ill_anthell = 9;
		erasequest 8729;
		setquest 8730;
		close2;
		warp "anthell02",172,185;
		end;
	}
	end;

OnInit:
	.@npc_id = getnpcid(0);
	setunitdata .@npc_id, UNPC_CLASS, 4056;
	setunitdata .@npc_id, UNPC_CLOTHCOLOR, 1;
	setunitdata .@npc_id, UNPC_HAIRSTYLE, 13;
	setunitdata .@npc_id, UNPC_HAIRCOLOR, 7;
	setunitdata .@npc_id, UNPC_HEADTOP, 1523;

	questinfo( QTYPE_QUEST, QMARK_YELLOW, "isbegin_quest(8729) == 1" );
	end;
}


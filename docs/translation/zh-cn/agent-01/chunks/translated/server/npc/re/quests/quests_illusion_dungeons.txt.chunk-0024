// ant_d02_i,259,147,7	script	Khahris#part4	GUNSLINGER,{
ant_d02_i,259,147,7	script(CLOAKED)	Khahris#part4	HIDDEN_NPC,{
	if (ill_anthell == 6 && isbegin_quest(8727) == 0) {
		mes "[Khahris]";
		mes "什么？你叫什么名字？";
		mes "你不该先自我介绍吗？";
		mes "啊……对。" + strcharinfo(0) + "。";
		mes "我是卡赫里斯。";
		next;
		mes "== 顺便一提，布里阿申寻找的卡赫里斯不是枪手。 ==";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "卡赫里斯……";
		next;
		mes "[Khahris]";
		mes "是啊。我突然来到了这种地方，就问了你的名字。你的内心非常坚强。你叫什么？";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "……不，我是受人所托来寻找卡赫里斯的。";
		next;
		mes "[Khahris]";
		mes "什么？谁托你来的？布里阿申吗？";
		mes "布里阿申还好吗？";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "嗯，我没事……";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "...";
		next;
		select( "你是谁？" );
		mes "[Khahris]";
		mes "啊？你在说什么？我是冒险家卡赫里斯。我之前告诉过你。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "布里阿申让我寻找一个长得和她一模一样的游侠。";
		mes "还有，既然你平安无事，为什么待在这里不出来？";
		next;
		mes "== 我等了一会儿回答，自称卡赫里斯的人却没有回应。 ==";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "卡赫里斯？";
		next;
		mes "[Khahris]";
		mes "我是……卡赫里斯？";
		next;
		mes "[Khahris]";
		mes "等你见到布里阿申就会知道了。";
		mes "布里阿申在哪里？";
		next;
		mes "== 卡赫里斯用力抓住自己的前臂。 ==";
		mes "== 疼得让人忍不住叫出声！ ==";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "可恶！好痛！";
		next;
		mes "[Khahris]";
		mes "带我去布里阿申那里！";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "离开这里！";
		next;
		mes "[Khahris]";
		mes "我是谁，布里阿申……？";
		mes "我是谁……？";
		setquest 8727;
		if (isbegin_quest(8725) != 1 || isbegin_quest(8726) != 1 || isbegin_quest(8727) != 1) {
			specialeffect EF_DEFENDER;
			cloakonnpcself();
		}
		else {
			ill_anthell = 7;
			erasequest 8724;
			erasequest 8725;
			erasequest 8726;
			erasequest 8727;
			setquest 8728;
			cloakonnpcself();
			cloakoffnpcself( "Khahris#part7" );
			specialeffect EF_DEFENDER, AREA, "Khahris#part7";
			mes "……我……我……！";
			mes "我……";
			mes "我以为……";
			close2;
			warp "anthell02",172,185;
			end;
		}
		next;
		mes "...";
		next;
		mes "== 欢迎……？ ==";
		next;
		mes "== 真正的卡赫里斯在哪里？ ==";
		close;
	}
	end;

OnInit:
	.@npc_id = getnpcid(0);
	setunitdata .@npc_id, UNPC_CLASS, 24;
	setunitdata .@npc_id, UNPC_CLOTHCOLOR, 3;
	setunitdata .@npc_id, UNPC_HAIRSTYLE, 13;
	setunitdata .@npc_id, UNPC_HAIRCOLOR, 7;
	setunitdata .@npc_id, UNPC_HEADTOP, 1523;

	questinfo( QTYPE_QUEST, QMARK_YELLOW, "isbegin_quest(8724) == 1 && isbegin_quest(8727) == 0" );

einbroch,149,242,5	script	Coughing young man#ITB	4_M_NFMAN,3,3,{
	if (BaseLevel < 150) {
		mes "[咳嗽的年轻人]";
		mes "时间已经过去了……";
		mes "你为什么还没回来……";
		mes "咳咳！！";
		next;
		mes "^ff0000提示：你可以从 150 级开始这个任务。^000000";
		close;
	}
	if (ill_teddy == 0) {
		mes "[咳嗽的年轻人]";
		mes "时间已经过去了……";
		mes "你为什么还没回来……";
		mes "咳咳！！";
		next;
		mes "[咳嗽的年轻人]";
		mes "咳……咳……咳……";
		mes "哈哈哈……发生什么事了吗？";
		mes "如果我不亲自去确认……";
		mes "咳咳";
		mes "咳……幸好……";
		next;
		mes "-扑通-";
		next;
		if (select( "帮助他", "无视" ) == 2) {
			mes "[咳嗽的年轻人]";
			mes "……咳……";
			mes "咳咳……咳";
			close;
		}
		mes "[咳嗽的年轻人]";
		mes "……咳……";
		mes "谢谢你。";
		mes "咳咳……咳";
		next;
		select( "你最好休息一下" );
		mes "[咳嗽的年轻人]";
		mes "咳……";
		mes "确实如此，但是……咳……我那个去矿井工作的朋友还没回来……咳。";
		next;
		mes "[咳嗽的年轻人]";
		mes "几天前，工作一结束……他就离开了……他说会回来的……";
		mes "可是他还没回来……咳……到现在都没有。";
		next;
		mes "[咳嗽的年轻人]";
		mes "咳……咳咳……咳";
		mes "我和守卫谈过了，可是……咳……咳……他们没把这件事当回事……";
		next;
		mes "[咳嗽的年轻人]";
		mes "^ff0000史蒂文^000000不是那种人……咳咳";
		mes "他至今还没联系我，一定是出什么事了。";
		next;
		mes "[咳嗽的年轻人]";
		mes "他好像要去^ff0000艾因贝赫矿井一楼^000000。";
		mes "你四处找找，说不定能发现线索……哪怕只是很小的线索？";
		ill_teddy = 1;
		setquest 11556;
		close;
	}
	if (ill_teddy == 1) {
		mes "[咳嗽的年轻人]";
		mes "几天前，工作一结束……他就离开了……他说会回来的……";
		mes "可是他还没回来……咳……到现在都没有。";
		next;
		mes "[咳嗽的年轻人]";
		mes "咳……咳咳……咳";
		mes "我和守卫谈过了，可是……咳……咳……他们没把这件事当回事……";
		next;
		mes "[咳嗽的年轻人]";
		mes "^ff0000史蒂文^000000不是那种人……咳咳";
		mes "他至今还没联系我，一定是出什么事了。";
		next;
		mes "[咳嗽的年轻人]";
		mes "他好像要去^ff0000艾因贝赫矿井一楼^000000。";
		mes "你四处找找，说不定能发现线索……哪怕只是很小的线索？";
		close;
	}
	if (ill_teddy < 5) {
		mes "[咳嗽的年轻人]";
		mes "啊！咳咳！";
		mes "你回来了！";
		mes "史蒂文他……咳";
		mes "你找到他了吗？";
		close;
	}
	if (ill_teddy == 5) {
		mes "[Acid]";
		mes "啊！咳咳！";
		mes "你回来了！";
		mes "史蒂文他……咳";
		mes "你找到他了吗？";
		next;
		select( "交出钱" );
		mes "[Acid]";
		mes "....";
		mes "果然……咳咳……发生什么事了？";
		next;
		mes "[Acid]";
		mes "如果没发生什么事，他们不可能特意送来这笔钱。";
		next;
		mes "[Acid]";
		mes "我……咳……必须亲自去……咳……咳……";
		mes "虽然可能帮不上什么忙，但是……咳";
		mes "我最亲爱的朋友……咳……可能有危险，我不能坐视不理！……咯咯";
		next;
		mes "[Acid]";
		mes "咳咳……冒险家……咳……带我一起去吧！";
		mes "求你了！";
		ill_teddy = 6;
		erasequest 11560;
		setquest 11561;
		close;
	}
	if (ill_teddy == 6) {
		mes "[Acid]";
		mes "我……咳……必须亲自去……咳……咳……";
		mes "虽然可能帮不上什么忙，但是……咳";
		mes "我最亲爱的朋友……咳……可能有危险，我不能坐视不理！……咯咯";
		next;
		mes "[Acid]";
		mes "咳咳……冒险家……咳……带我一起去吧！";
		mes "求你了！";
		close;
	}
	mes "[Acid]";
	mes "这段时间我大多待在矿井里，所以咳嗽似乎好多了。";
	mes "我的身体变健康了！";
	mes "这里的空气比矿井还差……咳";
	close;

OnTouch:
	if (BaseLevel >= 150 && ill_teddy == 0)
		npctalk "咳嗽的年轻人：咳咳！！", "", bc_self;
	end;

OnInit:
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "BaseLevel >= 150 && ill_teddy == 0" );
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "isbegin_quest(11560) == 1" );
	end;
}

ein_dun01,198,79,3	script	Teddy Bear#ITB10	4_NASARIAN,{
	if (ill_teddy == 1) {
		mes "[排队的泰迪熊]";
		mes "排队！";
		next;
		select( "你为什么站在这里？" );
		mes "[排队的泰迪熊]";
		mes "什么？";
		mes "你以为我会把如此高级的情报告诉第一次见面的陌生人吗？";
		next;
		mes "[排队的泰迪熊]";
		mes "你那么好奇的话，就站到我后面等轮到你吧！";
		next;
		mes "[排队的泰迪熊]";
		mes "情报可不是免费得到的。";
		mes "所有的时间和精力……";
		next;
		mes "[???????????]";
		mes "啊啊啊啊啊！！！！";
		mes "放开我！！！！";
		mes "你们这些毛茸茸的混蛋！！！！";
		next;
		mes "- 队伍前方传来男人的惨叫。去前面看看情况吧。 -";
		ill_teddy = 2;
		erasequest 11556;
		setquest 11557;
		close;
	}
	if (ill_teddy == 2) {
		mes "[排队的泰迪熊]";
		mes "你听到什么奇怪的声音了吗？";
		next;
		mes "- 队伍前方传来男人的惨叫。去前面看看情况吧。 -";

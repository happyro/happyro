//===== rAthena Script ======================================= 
//= Endless Tower
//===== By: ================================================== 
//= L0ne_W0lf
//===== Current Version: ===================================== 
//= 2.4
//===== Compatible With: ===================================== 
//= rAthena Project
//===== Description: ========================================= 
//= [Official Conversion]
//= Endless Tower Memorial Dungeon.
//= Consists of 101 floors.
//===== Additional Comments: ================================= 
//= 1.0 First version.
//= 1.1 Removed a disablenpc from #102FShadowDust1. (bugreport:4415)
//= 1.2 Added ends to several NPCs which would allow you to restart timers.
//=     Added some missing stopnpctimers to npcs. (bugreport:4418)
//= 1.3 Fixed a couple copy/paste errors :D I fail. [L0ne_W0lf]
//      Timer no longer resets when re-entering.
//= 1.4 Added quest log entries based on iRO. [L0ne_W0lf]
//=     You may need to update your questid2display.
//=     Changed White lady spawn to MVP White Lady. (bugreport:4601)
//= 1.5 Corrected some grammar and typos.
//= 1.6 Corrected the tower re-entry blocked condition. (bugreport:4677) [L0ne_W0lf]
//=     Corrected floor 75 warp disabling the wrong NPC. (bugreport:4711)
//= 1.7 Added missing end's to prevent accidental disabling of
//=     warps between floors. (bugreport:4623)
//=     Added missing end's to prevent infinite mobspawn (bugreport:4540)
//=     Commented out remaining GM-only NPCs. [Gepard]
//= 1.8 Adjusted Instance Attach Map to Validate ALL Maps, instead of 
//=     only 1@tower -> 5@tower (bugreport:4983)
//= 1.9 Added 'instance_check_party' command to the script for proper checking if
//=     the invoking party meets the requirements to join the Memorial Dungeon.
//= 2.0 Fixed broken else/if chaining. [Joseph]
//= 2.1 Updated to match latest official script. [Euphy]
//= 2.2 Instance system rewrite. [Euphy]
//= 2.3 Added some missing announcements. [Euphy]
//= 2.4 Added GM management function. [Euphy]
//============================================================ 

alberta,214,77,6	script	Captain Janssen	709,{
	if (checkweight(1201,1) == 0) {
		mes "^008800请稍等！！";
		mes "你携带的东西太多了。先存放一些再回来吧。^000000";
		close;
	}
	if (BaseLevel < 50) {
		mes "[Captain Janssen]";
		mes "唉……不知道我还能不能再次航海……";
		close;
	}
	set .@name$,strcharinfo(0);
	if (in_102tower == 1) {
		mes "^0000ff老人看起来异常兴奋，冲进海边商店匆忙订购商品。你也没什么更好的事可做，于是决定问问他为什么如此匆忙。^000000";
		next;
		mes "^0000ff老人订完货后向你走来。^000000";
		next;
		mes "[Captain Janssen]";
		mes "你这么轻易接受陌生人的请求，让我很感动。你一定是善良英勇的冒险者。愿意踏上海洋旅程吗？";
		next;
		mes "["+.@name$+"]";
		mes "我航行过几次……但仔细想想，从未横跨大陆。";
		next;
		mes "[Captain Janssen]";
		mes "不，那已经够好了。我虽然只有一艘小渔船，但曾经是指挥舰队的船长。";
		next;
		mes "[Captain Janssen]";
		mes "你航海几次后就会知道，跨越大陆外海洋的人很少。我也没能征服海洋。";
		next;
		mes "^0000ff詹森先生讲了很久他那些危险的海上旅程。你时间充裕，于是坐下来静静听他的故事。^000000";
		next;
		mes "^0000ff他的故事至少有一半听起来夸张无比，但有件事引起了你的注意：他坚称海上有一座巨大高塔，高耸入云。^000000";
		set in_102tower,2;
		close;
	} else if (in_102tower == 2) {
		mes "[Captain Janssen]";
		mes "舰队失事后，我只能在那座巨大高塔旁抛锚。起初只打算待到暴风雨结束，但它没有如愿很快停下。";
		next;
		mes "[Captain Janssen]";
		mes "船员们饥肠辘辘，其中几人走进高塔寻找食物……他们再也没回来。";
		next;
		mes "["+.@name$+"]";
		mes "你为什么没和他们一起进去？";
		next;
		mes "[Captain Janssen]";
		mes "直觉告诉我高塔很危险。我虽好奇，却不愿拿生命冒险。我们等了 7 天，直到暴风雨结束，但没有人回来。";
		next;
		mes "[Captain Janssen]";
		mes "为了活下去，我们丢弃所有货物，只带着高塔周围找到的少量水和可食植物离开。最终抵达陆地时，只剩我一个人活着……";
		next;
		mes "^0000ff即使他没有进一步解释，你也能想象那支舰队最后航行时濒临毁灭的悲惨场景。他沉默了一会儿，脸上掠过沉重的悔意，然后说道：^000000";
		next;
		mes "[Captain Janssen]";
		mes "死前我必须完成一件事。我要找回死在塔里的船员遗骸，好好安葬他们。";
		next;
		mes "[Captain Janssen]";
		mes "能遇到你这样热心的冒险者真幸运。有了你给的钱，我终于能再次航向高塔。";
		next;
		mes "["+.@name$+"]";
		mes "雇我当大副怎么样？";
		next;
		mes "[Captain Janssen]";
		mes "谢谢，但那里极其危险。我有必须履行的责任，你却没有义务帮助我们。我不愿牺牲像你这样年轻的人。";
		next;
		mes "["+.@name$+"]";
		mes "不……";
		mes ".";
		mes ".";
		mes "作为冒险者，我有义务帮助需要帮助的人。而且我也很好奇那个地方……";
		next;
		mes "[Captain Janssen]";
		mes "我本打算立刻出发，但既然你加入了，就给你时间准备。我会在这里等到你准备好。";
		next;
		mes "[Captain Janssen]";
		mes "……好吧……";
		mes "欢迎登船，大副。";
		set in_102tower,3;
		close;
	} else if (in_102tower == 3) {
		mes "[Captain Janssen]";
		mes "现在出发吗？";
		next;
		switch(select("是的，出发吧！:不，我还没准备好……")) {
		case 1:
			mes "[Captain Janssen]";
			mes "那就起锚吧，大副！";
			close2;
			set in_102tower,4;
			warp "e_tower",70,114;
			end;
		case 2:
			mes "[Captain Janssen]";
			mes "当然，没问题。准备好后再来。";
			close;
		}
	} else if (in_102tower > 3) {
		mes "[Captain Janssen]";
		mes "要再次远航，我们需要补充物资。给我 10,000 Zeny，剩下的交给我。";
		next;
		switch(select("我稍后再来。:现在出发！")) {
		case 1:
			mes "["+.@name$+"]";
			mes "抱歉，我没有那么多钱。存够后再回来。";
			next;
			mes "[Captain Janssen]";
			mes "当然，没问题。我会等你回来。";
			close;
		case 2:
			if (Zeny < 10000) {
				mes "[Captain Janssen]";
				mes "抱歉，你的钱不够。补充物资至少需要 10,000 Zeny……";
				close;
			}
			else {
				mes "[Captain Janssen]";
				mes "太好了！现在可以出发。再次起锚吧！";
				set Zeny, Zeny-10000;
				close2;
				warp "e_tower",70,114;
				end;
			}
		}
	} else {
		mes "[Captain Janssen]";
		mes "打扰一下，你是冒险者吗？";
		next;
		mes "[Captain Janssen]";
		mes "第一次见面就这样请求很抱歉，但能帮我一个忙吗？我会长话短说。";
		next;
		mes "[Captain Janssen]";
		mes "能捐给我 ^0000ff10,000 Zeny^000000 吗？这是为了对我很重要的事情……";
		next;
		switch(select("不！:当然。")) {
		case 1:
			mes "["+.@name$+"]";
			mes "抱歉，你找错人了。";
			next;
			mes "[Captain Janssen]";
			mes "我明白了……抱歉打扰。最初提出这种请求确实太失礼。";
			close;
		case 2:
			mes "[Captain Janssen]";
			mes "嗯？你真的不介意给我这么多钱？哇，非常感谢！";
			next;
			if (Zeny < 10000) {
				mes "[Captain Janssen]";
				mes "……抱歉，我想你没有 10,000 Zeny。谢谢你的好意，但我需要更多钱。";
				close;
			} else {
				mes "["+.@name$+"]";
				mes "我不知道你为什么需要这么多钱，但拿去吧。";
				next;
				mes "^0000ff你向詹森船长捐赠了 10,000 Zeny。^000000";
				next;
				mes "[Captain Janssen]";
				mes "非常感谢！现在我能为船补充食物和材料了。你真善良，非常善良！";
				set Zeny, Zeny-10000;
				set in_102tower,1;
				close;
			}
		}
	}
}

e_tower,81,105,0	script	Tower Protection Stone	406,{

	set .@party_id,getcharid(1);
	set .@md_name$,"Endless Tower";

	set .@etower_timer,checkquest(60200,PLAYTIME); // 1 week
	set .@etower_timer2,checkquest(60201,PLAYTIME); // 4 hours

	if (!instance_check_party(.@party_id,2)) {
		mes "请创建或加入人数超过 1 人的队伍后再试。";
		close;
	}
	switch(.@etower_timer) {
	case -1:
		if (is_party_leader() == true) {
			mes "已确认队伍建立。要预约进入无尽塔吗？";
			next;
			switch(select("创建副本 "+.@md_name$+":进入副本:返回艾尔贝塔:取消")) {
			case 1:
				if (instance_create(.@md_name$) < 0) {
					mes "队伍名称："+ getpartyname(.@party_id);
					mes "队长："+strcharinfo(0);
					mes "^0000ff"+.@md_name$+" ^000000- 预约失败！";
					close;
				}
				mes "^0000ff"+.@md_name$+"^000000 - 正在尝试预约";
				mes "预约后，请与后方 NPC 交谈并选择‘进入副本’。";
				close;
			case 2:
				callsub L_Enter,0,1;
			case 3:
				mes "我会把你传送到艾尔贝塔。";
				close2;
				warp "alberta",223,36;
				end;
			case 4:
				close;
			}
		}
		switch(select("进入 "+.@md_name$+":返回艾尔贝塔:取消")) {
		case 1:
			callsub L_Enter,1,1;
		case 2:
			mes "我会把你传送到艾尔贝塔。";
			close2;
			warp "alberta",223,36;
			end;
		case 3:
			end;
		}
	case 0:
	case 1:
		if (.@etower_timer2 < 2 && getcharid(1) == etower_partyid) {
			mes "如果副本已经创建，就可以进入。";
			next;
			switch(select("进入 "+.@md_name$+":返回艾尔贝塔:取消")) {
			case 1:
				callsub L_Enter,0,0;
			case 2:
				mes "我会把你传送到艾尔贝塔。";
				close2;
				warp "alberta",223,36;
				end;
			case 3:
				close;
			}
		} else {
			set .@dun_lim_time,etower_timer+604800; // 1 week
			// set .@dun_lim_time2,etower_timer+14400; // 4 hours
			set .@dun_cur_time,gettimetick(2);
			set .@dun_ent_t,(.@dun_lim_time - .@dun_cur_time);
			set .@dun_h,(.@dun_ent_t / 3600);
			set .@dun_m,(.@dun_ent_t - (.@dun_h * 3600)) / 60;
			set .@dun_s,.@dun_ent_t - ((.@dun_h * 3600) + (.@dun_m * 60));

			mes "受高塔余波影响，现在无法进入副本。距离下次进入还剩 " + .@dun_h + " 小时 " + .@dun_m + " 分钟 " + .@dun_s + " 秒。";
			next;
			mes "这里很危险。我把你传送到艾尔贝塔。";
			close2;
			warp "alberta",223,36;
			end;
		}
	case 2:
		set etower_timer,0;
		erasequest 60200;
		erasequest 60201;
		mes "^0000ff与无尽塔相关的记录和后续效果已移除。你可以再次生成并进入无尽塔。^000000";
		close;
	}

L_Enter:
	switch(instance_enter("Endless Tower")) {
	case IE_OTHER:
		mes "发生未知错误。";
		close;
	case IE_NOINSTANCE:
		mes "纪念副本无尽塔不存在。";
		mes "队长尚未创建副本。";
		close;
	case IE_NOMEMBER:
		mes "建立队伍后即可进入副本。";
		close;
	case IE_OK:
		mapannounce "e_tower", strcharinfo(0) +" 所在的队伍正在进入副本无尽塔。",bc_map,"0x00ff99",FW_NORMAL,12;
		if (getarg(1)) {
			set etower_timer,gettimetick(2);
			set etower_partyid, getcharid(1);
			setquest 60200;
			setquest 60201;
		}
		//warp "1@tower",52,354;
		if (getarg(0) == 0) close;
		else end;
	}
}

e_tower,30,30,2	script	Huge Vortex	844,2,2,{
	end;
OnTouch:
	mapannounce "e_tower","[ " + strcharinfo(0) + " ] 似乎被巨大的漩涡吞噬了",bc_map,"0x00ff99",FW_NORMAL,12;
	warp "alberta",223,36;
	end;
}

// Original name: "#102Administrator Mode104"
e_tower,1,1,2	script	#102Administrator Mode	844,{
	callfunc "F_GM_NPC";
	mes "请输入密码";
	set .@i, callfunc("F_GM_NPC","dmc2008",1);
	next;
	if (.@i == 1) {
		switch(select("生成净化石:移除净化石:取消")) {
		case 1:
			mes "创建持续 30 分钟的净化石。";
			donpcevent "Purification Stone#et1::OnEnable";
			break;
		case 2:
			mes "立即摧毁净化石。";
			donpcevent "Purification Stone#et1::OnDisable";
			break;
		case 3:
			mes "你取消了操作。";
			break;
		}
		close;
	} else {
		mes "请准确输入密码。";
		close;
	}
}

e_tower,69,117,4	script	Purification Stone#et1	406,{
	set etower_timer,0;
	mes "^0000ff与无尽塔相关的记录和后续效果已移除。你可以再次生成并进入无尽塔。^000000";
	close;

OnInit:
	disablenpc "Purification Stone#et1";
	end;

OnEnable:
	initnpctimer;
	end;

OnDisable:
	stopnpctimer;
	disablenpc "Purification Stone#et1";
	end;

OnTimer1000:
	enablenpc "Purification Stone#et1";
	end;

OnTimer1740000:
	mapannounce "e_tower", "净化石将在一分钟后摧毁。",bc_map,"0x00ff99";
	end;

OnTimer1800000:
	disablenpc "Purification Stone#et1";
	end;
}

e_tower,151,185,4	script	Purification Stone#et2	844,{
	callfunc "F_GM_NPC";
	set etower_timer,0;
	mes "^0000ff与无尽塔相关的记录和后续效果已移除。你可以再次生成并进入无尽塔。^000000";
	close2;
	warp "e_tower",75,108;
	end;
}


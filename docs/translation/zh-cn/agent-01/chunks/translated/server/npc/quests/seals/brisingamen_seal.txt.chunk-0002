					mes "我又一次决定穿越沙漠，尽管卡普拉小姐提供了非常方便的传送服务。";
					next;
					cutin "god_nelluad01",2;
					mes "[妮莉欧德]";
					mes "总之，桑达鲁曼要塞就在前往帕罗斯灯塔的路上。我记得在梦罗克南部遇到的塞鲁特罗曾告诉我，那里的风景非常美。";
					next;
					mes "[妮莉欧德]";
					mes "我当时非常兴奋，";
					mes "迫不及待想亲眼看看。";
					mes "毕竟，‘桑达鲁曼’听起来不就是个";
					mes "美丽地方的名字吗？";
					next;
					mes "[妮莉欧德]";
					mes "但抵达后我立刻就后悔了。当然，那里景色壮丽得令人屏息：海边的沙丘，";
					mes "还有那些遗迹。";
					next;
					mes "[妮莉欧德]";
					mes "当然，我忘了塞鲁特罗关于魔物的警告。啊！那简直是噩梦！我没能欣赏风景，反而只能拼命逃跑。";
					next;
					mes "[妮莉欧德]";
					mes "我还在逃避那些魔物时，偶然发现";
					mes "桑达鲁曼西边有一栋年久失修的老房子。";
					next;
					mes "[妮莉欧德]";
					mes "我想起塞鲁特罗说过那一带无人居住，于是有些担心。不过当时我走投无路，急需一个避难处。";
					next;
					mes "[妮莉欧德]";
					mes "我慌乱地用力敲门，喊着让里面的人放我进去。你知道我听到了什么吗？";
					next;
					cutin "god_nelluad04",2;
					mes "[妮莉欧德]";
					mes "^FF0000是谁？！";
					mes "谁敢闯入";
					mes "我的领地？^000000";
					mes "我吓坏了！那栋房子的主人一定是个";
					mes "疯子！";
					next;
					mes "[妮莉欧德]";
					mes "然、然后，死神的阴影紧追着我，他却叫我滚开！幸好一位神秘的流浪超级初心者救了我，不过那是另一个故事了。";
					next;
					mes "[妮莉欧德]";
					mes "不管怎样，我终于抵达了帕罗斯灯塔。在那里我才知道，那栋老房子原来是盗贼公会的秘密营地。";
					next;
					mes "[妮莉欧德]";
					mes "他们竟然能住在那么危险的地方，真不可思议。你知道吗，只有盗贼才能在那里生存。";
					next;
					cutin "god_nelluad01",2;
					mes "[妮莉欧德]";
					mes "啊……";
					mes "说了这么多我真累。如果以后还有冒险，我一定再把故事讲给你听。";
					close2;
					break;
				case 2:
					cutin "god_nelluad02",2;
					mes "[妮莉欧德]";
					mes "啊，你想";
					mes "听首歌吗？";
					mes "好吧！那我就";
					mes "演奏我最喜欢的歌。";
					next;
					mes "[妮莉欧德]";
					mes "我追逐名声，";
					mes "它却从我身边逃走。";
					mes "我追逐幸福，";
					mes "却始终无法抓住。";
					next;
					mes "[妮莉欧德]";
					mes "但我相信明天依然会到来。";
					mes "就像艾尔帕兰的";
					mes "水车一样，";
					mes "随着生命的延续";
					mes "永不停转。";
					mes "明天一定会到来。";
					next;
					cutin "god_nelluad04",2;
					mes "[妮莉欧德]";
					mes "振作起来！生活还要继续。";
					mes "就像水车一定会转动，";
					mes "明天也一定会到来。";
					mes "请相信未来。";
					close2;
					break;
				}
				break;
			}
		}
	}
	else {
			mes "[妮莉欧德]";
		mes "你好！";
		mes "今天不是个";
		mes "风和日丽的好日子吗？";
		mes "你知道我是谁，";
		mes "对吧？";
		next;
			mes "[妮莉欧德]";
		if (Sex == SEX_MALE) {
			mes "哈哈哈，原谅我的失礼，";
			mes "我想不起你的名字了，不过你的脸看起来确实很眼熟。";
		}
		else {
			mes "哎呀呀……";
			mes "我怎么可能";
			mes "忘记可爱的";
			mes ""+ strcharinfo(0) +"?";
		}
		next;
		cutin "god_nelluad01",2;
			mes "[妮莉欧德]";
		mes "那么，你不好奇我的故事吗？尽管随意问吧！我是会在世间漂泊至生命尽头的流浪者，也是喜欢在月光下歌唱的朋友~";
		next;
		switch(select("你是谁？:有什么新消息？:你会唱歌吗？")) {
		case 1:
			mes "[妮莉欧德]";
				mes "我就是吟游诗人妮莉欧德。";
				mes "其实，我的真名是埃利欧德。";
			next;
			cutin "god_nelluad03",2;
			mes "[妮莉欧德]";
				mes "不过，有一次我像往常一样在酒馆唱歌，一个金发长发男子气冲冲地要求我改名！";
			next;
			mes "[妮莉欧德]";
				mes "我从没见过有人因为碰巧同名，就如此大惊小怪、胡闹不休！";
			next;
			mes "[妮莉欧德]";
				mes "于是，那场小小的争执";
				mes "最后以我改名为妮莉欧德收场。";
			next;
			cutin "god_nelluad04",2;
			mes "[妮莉欧德]";
				mes "我听起来不像胆小鬼，对吧？你觉得我应该为保留原名而战吗？";
			next;
			mes "[妮莉欧德]";
				mes "如果你这么想，那就错了！我只是认为暴力解决不了任何问题，作为珍爱和平的浪漫吟游诗人，";
				mes "我当然不会诉诸暴力……";
			next;
				mes "^3355FF你觉得听妮莉欧德的谎话毫无意义，";
				mes "于是决定干脆不再理会他。^000000";
			next;
			mes "^3355FF...";
			mes "......^000000";
			next;
			mes "^3355FF...";
			mes "......";
			mes ".........^000000";
			next;
			cutin "god_nelluad03",2;
				mes "[妮莉欧德]";
					mes "就这样，我讲完了这个故事。";
					mes "就这样，我说服了睿智仁慈的特里斯坦三世国王，建造一座让已婚恋人享受幸福的乐园——嗯？你到底有没有在听？！";
			close2;
			break;
		case 2:
			mes "[妮莉欧德]";
				mes "你想听";
				mes "一些消息吗？";
				mes "你想知道";
				mes "哪方面的消息？";
			next;
				switch(select("关于普隆德拉！:关于海边地区。:沙漠还是很热吗？:边境地区怎么样？")) {
			case 1:
				mes "[妮莉欧德]";
					mes "什么？！普隆德拉？！";
					mes "你没看到普隆德拉的正门";
					mes "就在你面前吗？冒险者，至少应该知道自己在哪里吧。";
				next;
			mes "[妮莉欧德]";
					mes "总之，我知道一个关于普隆德拉的有趣消息。但这是秘密。嘘！你……单身吗？";
				next;
			mes "[妮莉欧德]";
					mes "如果是，就去酒馆看看吧。我在那里遇到一个带我去好地方的人。没错，就是那个禁止单身者进入的地方~！";
				close2;
				break;
			case 2:
			mes "[妮莉欧德]";
					mes "海边地区？";
					mes "真是个有趣的问题。比如艾尔贝塔，还有其他一些能看到大海的地方。";
				next;
			mes "[妮莉欧德]";
					mes "西南方有";
					mes "可可莫海滩。不过，专程去那里散步似乎太危险了。";
				next;
			mes "[妮莉欧德]";
					mes "可可莫海滩是一大片沙地。";
					mes "附近的海水里有许多海洋生物，你可以在那里捕捉贝壳类生物。";
				next;
			mes "[妮莉欧德]";
					mes "不过，那种地方总会有恶霸。有一次，我遇到一个留着红色刺发、看起来很吓人的混混。";
				next;
				cutin "god_nelluad04",2;
			mes "[妮莉欧德]";
					mes "他嘴里嚼着什么，还吐在地上。那个大笨蛋居然把我吓得交出了所有 Zeny！";
				next;
			mes "[妮莉欧德]";
					mes "^333333*叹气……*^000000";
					mes "这个世界对年轻而";
					mes "脆弱的吟游诗人来说，";
					mes "实在太危险了。";
				next;
			mes "[妮莉欧德]";
					mes "顺便说一句，艾尔贝塔似乎没什么变化。沉船也还是老样子，满是骷髅海盗之类的东西。你知道的。";
				next;
				cutin "god_nelluad01",2;
			mes "[妮莉欧德]";
					mes "负责组织沉船探险的活动机构仍然赚得盆满钵满。如果你无事可做，为什么不去那里猎杀魔物呢？";
				close2;
				break;
			case 3:
			mes "[妮莉欧德]";
					mes "当然热！";
					mes "什么时候不热呢？";
					mes "沙漠很热，过去一直热，";
					mes "以后恐怕也会一直热下去……！";
					mes "这就是沙漠。";
				next;
			mes "[妮莉欧德]";
					mes "巨大的蠕虫仍会凭空跳出来，吓坏像我这样的无辜旅行者；沙人也仍会踢人，嗯……你懂的。";
				next;
				cutin "god_nelluad02",2;
			mes "[妮莉欧德]";
					mes "即使沙漠里到处都是丑陋的魔物，那里眺望大海的景色依然壮丽。哈，真让我想唱首歌。";
				next;
			mes "[妮莉欧德]";
					mes "我得说，沙漠里有一个地方";
					mes "你也许会想去看看。";
					mes "那是个很神秘的地方。";
				next;
			mes "[妮莉欧德]";
					mes "我说的是刺客公会。据说它隐藏在梦罗克的沙尘暴后面，";
				if ((Class == Job_Assassin) || (Class == Job_Assassin_Cross)) {
					mes "沙漠里！不过你应该知道我说的是什么！那你什么时候带我去公会，嗯？";
				}
				else {
					mes "沙漠里！你以前去过那里吗？";
				}
				close2;
				break;
			case 4:
			mes "[妮莉欧德]";
					mes "北方是施瓦茨瓦尔德共和国。";
					mes "在那里你会找到朱诺，";
					mes "也就是‘贤者之城’。";
				next;
			mes "[妮莉欧德]";
					mes "那里的人说，有一个大麻烦，一个被称为‘疯狂科学家’的男人。";
					mes "他不合群，还经常用实验制造公共骚乱。";
				next;
				cutin "god_nelluad03",2;
			mes "[妮莉欧德]";
					mes "朱诺似乎人人都对他深恶痛绝。";
					mes "甚至有一位工具店老板请求路过的冒险者阻止疯狂科学家的研究！";
				next;
			mes "[妮莉欧德]";
					mes "但我对他有不同看法。我认为不该打断任何科学家的研究。";
				next;
			mes "[妮莉欧德]";
					mes "毕竟，即使他的实验有些危险，也许他正好能发现重要的东西。";
				next;
			mes "[妮莉欧德]";
					mes "说到发现，你知道朱诺漂浮在空中，对吧？";
				next;
				cutin "god_nelluad01",2;
			mes "[妮莉欧德]";
					mes "据说尤弥尔之心的一块碎片就能产生足够的力量，";
					mes "让整座城市漂浮在天空中。是不是很神奇？";
				next;
			mes "[妮莉欧德]";
					mes "最近还有发现尤弥尔之书的消息。你可以在朱诺的贤者城堡阅读它。听说其中记载着与女武神相遇的秘密……";
				close2;
				break;
			}
			break;
		case 3:
			mes "[妮莉欧德]";
			mes "你问我会不会唱歌？";
			mes "当然，而且我敢说唱得很棒。";
			mes "你想听哪首歌？";
			next;
			switch(select("布拉奇之诗:永恒混沌:夕阳下的刺客")) {
			case 1:
				if (Zeny > 499) {
					cutin "god_nelluad02",2;
			mes "[妮莉欧德]";
						mes "布拉奇之诗！";
						mes "真是个好选择！";
						mes "我得说，这首歌";
						mes "代表了";
						mes "诗人的心！";
					soundeffect "bragis_poem.wav",1;
					set Zeny,Zeny-500;
					close2;
				}
				else {
			mes "[妮莉欧德]";
						mes "请原谅我，但我不能免费演奏。世界很残酷，像我这样柔弱的吟游诗人必须想办法";
						mes "活下去~";
					close2;
				}
				break;
			case 2:
				if (Zeny > 499) {
					cutin "god_nelluad02",2;
			mes "[妮莉欧德]";
						mes "你一定喜欢强烈";
						mes "而充满活力的音乐，对吧？";
						mes "如你所愿~";
					soundeffect "chaos_of_eternity.wav",1;
					set Zeny,Zeny-500;
					close2;
				}
				else {
			mes "[妮莉欧德]";
					mes "请原谅我，但我不能免费演奏。世界很残酷，像我这样柔弱的吟游诗人必须想办法";
					mes "活下去~";
					close2;
				}
				break;
			case 3:
				if (Zeny > 499) {
					cutin "god_nelluad02",2;
			mes "[妮莉欧德]";
						mes "绝佳的选择！";
						mes "不知为何，夕阳西下的景象";
						mes "和刺客非常相配。";
						mes "这真是首适合刺客的歌。";
						mes "你不觉得吗？";
					soundeffect "assassin_of_sunset.wav",1;
					set Zeny,Zeny-500;
					close2;
				}
				else {
			mes "[妮莉欧德]";
					mes "请原谅我，但我不能免费演奏。世界很残酷，像我这样柔弱的吟游诗人必须想办法";
					mes "活下去~";
					close2;
				}
				break;
			}
			break;
		}
	}
	cutin "",255;
	end;
}

yuno_in04,47,113,1	script	Studying Scholar#1	749,{
	if (checkweight(908,200) == 0) {
			mes "^3355FF请等一下！你现在携带的物品太多了。请把一些物品存入卡普拉仓库后再回来。^000000";
		close;
	}
	if ($God3 == $@god_check2) {
			mes "[研究中的学者]";
			mes "嗯……";
			mes "这是迄今为止品质最高的红色药水……";
		next;
			mes "[研究中的学者]";
			mes "要是我能找到办法，让研磨后的红色药草与水保持适当的浓度就好了。那部分最关键……";
		close;
	}
	if ($God2 >= $@god_check1) {
		if (god_brising == 50) {
				mes "[恩里科·凯利]";
				mes "啊，" + strcharinfo(0) + "，";
				mes "你回来了。";
			next;
				mes "[恩里科·凯利]";
				mes "研究布里辛加曼确实很有趣。不过目前研究遇到了瓶颈，所以我开始了新的研究项目。";
			next;
				mes "[恩里科·凯利]";
				mes "哈哈哈~";
				mes "抱歉，目前这是机密，我不能告诉你。不过有机会的话，我会请你帮忙。";
			close;
		}
		else if (god_brising == 49) {
				mes "[恩里科·凯利]";
				mes "啊，我明白了。看来贝尔林确实把自己封在女神的眼泪";
				mes "落入水中的涟漪里。";
			next;
				mes "[恩里科·凯利]";
				mes "哦！我太兴奋了！都不知道该先做什么！是向陛下报告，还是发表研究成果，还是……";
			next;
				select("^333333*咳咳！*^000000 我的奖励！");
				mes "[恩里科·凯利]";
				mes "哦，对了。";
				mes "感谢你为我承受了这么多辛劳。你确实是我见过的最优秀的研究者之一。";
			next;
				mes "[恩里科·凯利]";
				mes "那么，就像我承诺的那样……";
				mes "我会从珍贵的收藏中送你一件东西！让我看看这里有什么……";
			next;
				mes "[恩里科·凯利]";
				mes "请收下……";
				mes "这个给你。";
			set god_brising,50;
			getitem 616,1; // Old_Card_Album
			getexp (checkre(3))?60000:600000,0;
			next;
				mes "[恩里科·凯利]";
				mes "请把它当作你协助我研究的谢礼。";
				mes "如果有机会，我还想再次请你帮忙。现在，请多保重。";
			if ($God3 < $@god_check2)
				set $God3,$God3 +1;
			if ($God3 == $@god_check1)
				announce "[布里辛加曼]的第 3 个封印出现了。",bc_all;
			else if ($God3 == $@god_check2) {
				if ($God1 == $@god_check2 && $God2 == $@god_check2 && $God3 == $@god_check2 && $God4 == $@god_check2)
				announce "包括[布里辛加曼]封印在内的四个封印同时被解除。",bc_all;
				else
					announce "[布里辛加曼]的第 3 个封印已被解除。",bc_all;
			}
			close;
		}
		else if (god_brising == 48) {
			mes "[恩里科·凯利]";
			mes "你怎么还在这里？";
			mes "我不是让你去找阿尔弗里克吗？";
			mes "啊~ 我等不及了……";
			emotion ET_SPARK;
			close;
		}
		else if (god_brising == 47) {
			mes "[恩里科·凯利]";
			mes "看来四位矮人确实已经醒来。";
			mes "这是不是意味着现在可以制作布里辛加曼了？";
			mes "终于到了这一步。";
			next;
			mes "[恩里科·凯利]";
			mes "如果真的可以制作，我们需要什么材料？让我们回顾一下你收集到的信息……";
			next;
			mes "[恩里科·凯利]";
			mes "有芙蕾雅的泪滴水晶、芙蕾雅的宝石，以及在阿尔弗里克";
			mes "曾经居住之处找到的永不融化的雪晶，还有德瓦林沉睡之路上的漂浮之风。嗯。";
			next;
			mes "[恩里科·凯利]";
			mes "也许可以从贝尔林沉睡的芙蕾雅金色泪滴之池中找到什么，";
			mes "不过我还不能确定。";
			next;

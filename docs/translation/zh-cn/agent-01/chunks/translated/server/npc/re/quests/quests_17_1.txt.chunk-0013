		cloakonnpc "Search Team#171_cor",getcharid(0);
		end;
	}
	if (isbegin_quest(17032) < 2) {
		cutin "ep171_as02",2;
		mes "[Aas]";
		mes "我完全不知道这里藏着这样的地方。他们到底是怎么避开周围人的注意的？";
		close3;
	}
	if (isbegin_quest(17033) == 0) {
		cutin "ep171_as01",2;
		mes "[Aas]";
		mes "你好。需要什么吗？";
		next;
		select("我要回鲁杜斯。:有什么我能帮忙的吗？");
		mes "[Aas]";
		mes "冒险者，暂时没有别的事要拜托你了。";
		next;
		mes "[Aas]";
		mes "有时间的话，回鲁杜斯再找些身份手环吧？";
		setquest 17033;
		completequest 17033;
		close3;
	}
	switch (checkquest(17035,PLAYTIME)) {
	case -1:
		break;
	case 0:
	case 1:
		cutin "ep171_as03",2;
		mes "[Aas]";
		mes "你好，冒险者，你这么快就回来了？怎么了？需要什么吗？";
		next;
		select("我要去鲁杜斯。");
		mes "[Aas]";
		mes "已经决定了吗？你今天在那里待了很久吧？我知道那不容易，应该休息一下。";
		next;
		mes "[Aas]";
		mes "我需要一些时间整理你之前带回来的手环。";
		next;
		mes "[Aas]";
		mes "黎明时再见。";
		close3;
	case 2:
		erasequest 17035;
	}
	switch (checkquest(17034,HUNTING)) {
	case -1:
		cutin "ep171_as03",2;
		mes "[Aas]";
		mes "你好，你要去鲁杜斯吗？";
		next;
		if (select("是的，我要去。:今天去不了。") == 2) {
			cutin "ep171_as03",2;
			mes "[Aas]";
			mes "没关系，冒险者也需要休息。";
			close3;
		}
		mes "[Aas]";
		mes "这并不容易，但请击败 20 只^0000FF多洛尔样本^000000，并从它们身上收集 10 个^0000FF身份手环^000000。";
		next;
		cutin "ep171_as01",2;
		mes "[Aas]";
		mes "请小心。我相信你能做好。";
		setquest 17034;
		close3;
	case 1:
		cutin "ep171_as01",2;
		mes "[Aas]";
		mes "你完成鲁杜斯的工作了吗？";
		next;
		mes "[Aas]";
		mes "哦……我以为副总统让你去消灭它们？";
		close3;
	case 2:
		if (countitem(25666) < 10) {
			cutin "ep171_as01",2;
			mes "[Aas]";
			mes "你完成鲁杜斯的工作了吗？";
			next;
			mes "[Aas]";
			mes "哦……咦，我以为副总统让你去消灭它们？";
			close3;
		}
		cutin "ep171_as01",2;
		mes "[Aas]";
		mes "你完成鲁杜斯的工作了吗？";
		next;
		cutin "ep171_as02",2;
		mes "[Aas]";
		mes "你带来了^0000FF10 个身份手环^000000……好，我收到了。";
		next;
		cutin "ep171_as01",2;
		mes "[Aas]";
		mes "黎明时再见。";
		mes "你一定很累了。";
		delitem 25666,10;
		getexp 200000,200000;
		getitem 25723,1;
		getitem 25669,5;
		erasequest 17034;
		setquest 17035;
		close3;
	}
	end;

OnInit:
	questinfo QTYPE_QUEST,QMARK_YELLOW,"isbegin_quest(17018) == 1";
	questinfo QTYPE_QUEST,QMARK_YELLOW,"checkquest(17034,HUNTING) == 2 && countitem(25666) >= 10";
	questinfo QTYPE_QUEST,QMARK_YELLOW,"isbegin_quest(17032) == 2 && isbegin_quest(17033) == 0";
	questinfo QTYPE_QUEST,QMARK_YELLOW,"isbegin_quest(17032) == 2 && isbegin_quest(17033) == 0";
	questinfo QTYPE_DAILYQUEST,QMARK_YELLOW,"isbegin_quest(17033) == 2 && checkquest(17035,PLAYTIME) == -1 && checkquest(17034,HUNTING) == -1";
	questinfo QTYPE_DAILYQUEST,QMARK_YELLOW,"isbegin_quest(17033) == 2 && checkquest(17035,PLAYTIME) == 2 && checkquest(17034,HUNTING) == -1";
	end;
}

sp_cor,124,139,1	script	Lazy#171_cor	4_M_LAZY,{

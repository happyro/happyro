//============================================================
// Innocent Menace
//============================================================
// 1st Story progression
// Continued from previous - Elena Volkova
sp_cor,110,130,3	script	Elena Volkova#rm171_0	4_F_ELENA,{
	switch (isbegin_quest(17019)) {
	case 0:
		cutin "162elena_01",2;
		mes "[Elena Volkova]";
		mes "" + strcharinfo(0) + ".";
		mes "我们还在搜索，所以别走得太深。没人知道里面潜伏着什么。";
		close3;
	case 1:
		cutin "162elena_01",2;
		mes "[Elena Volkova]";
		if (isbegin_quest(16353) == 0) {
			emotion 4;
			mes "你来了，冒险者。你知道我为什么想见你吧？";
			mes "是因为那个逃跑的愤怒研究员。正如你所见，我们还没找到他。他像鳗鱼一样滑溜。";
			next;
			specialeffect2 EF_TETRA_GROUND;
			mes "[Elena Volkova]";
		mes "啊，那是什么？";
			next;
			cutin "",255;
			cloakoffnpcself( "Rebellion#rm171_0" );
			mes "[Rebellion]";
		mes "队长，设施附近又发生爆炸了！";
		mes "一定是那个叫^0000CDElyumina^000000的研究员干的。我们马上去追他！";
			next;
			cutin "162elena_01",2;
			cloakonnpcself( "Rebellion#rm171_0" );
			emotion 6;
			mes "[Elena Volkova]";
		mes "看来他知道无法正面和我们交手，所以使用游击战术。";
		mes "走吧。" + strcharinfo(0) + "，跟我来<NAVI>[这边]<INFO>sp_cor,180,169,0,101,0</INFO></NAVI>。";
			completequest 17019;
			setquest 16353;
		} else {
		mes "我讨厌未经训练的动物。";
		mes "必须用紧绷的缰绳拴住它们，才能好好训练。你不觉得吗？";
		}
		close2;
		if (isbegin_quest(16352) == 1)
			completequest 16352;
		cutin "",255;
		end;
	case 2:
		cutin "162elena_01",2;
		mes "[Elena Volkova]";
		if (isbegin_quest(16353) == 1) {
		mes "设施附近发生了爆炸。是这座实验室的研究员艾莉乌米娜造成的。";
		mes "这次一定要抓住他。来<NAVI>[这边]<INFO>sp_cor,180,169,0,101,0</INFO></NAVI>。";
		} else {
		mes "我讨厌未经训练的动物。";
		mes "必须用紧绷的缰绳拴住它们，才能好好训练。你不觉得吗？";
		}
		close2;
		if (isbegin_quest(16352) == 1)
			completequest 16352;
		cutin "",255;
		end;
	}
	end;

OnInit:
	cloakonnpc();
	questinfo (QTYPE_QUEST, QMARK_YELLOW, " isbegin_quest(17019) == 1 && isbegin_quest(16352) == 1 && isbegin_quest(16353) == 0 ");
	end;
}

// Enter Story MD - Elena Volkova
sp_cor,180,169,3	script	Elena Volkova#rm171_1	4_F_ELENA,{
	switch (isbegin_quest(16353)) {
	case 0:
		cutin "162elena_01",2;
		mes "[Elena Volkova]";
	mes "嗯？冒险者，别擅自行动。我知道可以信任你，但其他人不这么认为。";
		next;
		mes "[Elena Volkova]";
	mes "有些研究员或装置可能还留在那里。请和其他人一起待在我们清理过的区域。";
		next;
		emotion 18;
		cutin "162elena_02",2;
		mes "[Elena Volkova]";
	mes "我呢？为什么我一个人在这里？你是在担心我吗？呵呵呵！";
		close3;
	case 1:
		cutin "162elena_01",2;
		mes "[Elena Volkova]";
	mes "你来得有点晚。不过，我们也没有及时赶到。";
	mes "艾莉乌米娜逃走了。他也许不擅长战斗，但逃跑倒是很厉害。可恶！";
		next;
		emotion 6;
		mes "[Elena Volkova]";
	mes "除非先抓住他，否则我们无法搜索或修复这个区域。";
		next;
		mes "[Elena Volkova]";
	mes "我和反叛军的其他队长商量过了，决定疏散这个区域的所有人，并派出精锐部队搜捕他。";
		next;
		mes "[Elena Volkova]";
	mes "疏散已经开始，平民和总统手下的小士兵正在撤离这个区域。";
		next;
		mes "[Elena Volkova]";
	mes "USU 的精锐成员和其他反叛军部队已经选定，我会担任他们的指挥官。其余反叛军会封锁前往科尔的所有入口。";
		next;
		mes "[Elena Volkova]";
	mes "我们的行动也包括你，冒险者。我知道你的实力，所以已经向其他人推荐了你。你会和我们一起行动，对吧？";
		next;
		cutin "",255;
		select("当然。");
		cutin "162elena_02",2;
		emotion 18;
		mes "[Elena Volkova]";
	mes "好！";
	mes "这次行动只选了足以独当一面的士兵，比如我。请以^0000Cd 1 人队伍^000000的形式回来。";
		completequest 16353;
		setquest 16354;
		close3;
	case 2:
		break;
	}
	switch (isbegin_quest(16354)) {
	case 0:
		cutin "162elena_01",2;
		mes "[Elena Volkova]";
	mes "我讨厌未经训练的动物。";
	mes "必须用紧绷的缰绳拴住它们，才能好好训练。";
		close3;
	case 1:
		if (isbegin_quest(16376) == 2) {
			cutin "162elena_01",2;
			mes "[Elena Volkova]";
		mes "嘿，冒险者。你完成了我拜托的事，为什么没告诉我？我差点又要问你一遍。";
		mes "不过现在不用向我报告了。我的手下已经替你报告过了。";
			if (isbegin_quest(16355) == 1)
				completequest 16355;
			if (isbegin_quest(16356) == 1)
				completequest 16356;
			completequest 16354;
			setquest 16357;
			close3;
		}
		cloakoffnpcself( "Rebellion#rm171_1" );
		cloakoffnpcself( "Rebellion#rm171_2" );
		cloakoffnpcself( "Rebellion#rm171_3" );
		cloakoffnpcself( "Rebellion#rm171_4" );
		cloakoffnpcself( "Rebellion#rm171_5" );
		cloakoffnpcself( "Rebellion#rm171_6" );
		cutin "162elena_01",2;
		mes "[Elena Volkova]";
	mes "这个区域已经封锁。疏散工作快完成了。";
	mes "我们很快就要进去。士兵们，准备好了吗？";
		next;
		npctalk "艾莉娜·沃尔科娃：他知道这里发生了什么。把他活捉。", "", bc_self;
		npctalk "我们准备好了！", "Rebellion#rm171_1", bc_self;
		npctalk "...", "Rebellion#rm171_2", bc_self;
		npctalk "我们准备好了！", "Rebellion#rm171_3", bc_self;
		npctalk "我们准备好了！", "Rebellion#rm171_4", bc_self;
		npctalk "我们准备好了！", "Rebellion#rm171_5", bc_self;
		npctalk "我们准备好了！", "Rebellion#rm171_6", bc_self;
		mes "[Elena Volkova]";
	mes "好了，你们是反叛军中的精英，专门挑选出来抓捕那个在此区域攻击所有人的研究员，不分敌我。";
		next;
		emotion 6;
		npctalk "艾莉娜·沃尔科娃：你说什么，你们这些不听话的笨蛋？", "", bc_self;
		npctalk "我们很荣幸，不过……", "Rebellion#rm171_1", bc_self;
		npctalk "...", "Rebellion#rm171_2", bc_self;
		npctalk "你是因为知道可以随意使唤我们，才挑中我们的吧？", "Rebellion#rm171_3", bc_self;
		npctalk "我终于有机会大显身手了！", "Rebellion#rm171_4", bc_self;
		npctalk "我们终于可以向世界展示自己的本领了！", "Rebellion#rm171_5", bc_self;
		npctalk "别让我们丢脸。", "Rebellion#rm171_6", bc_self;
		cutin "162elena_02",2;
		mes "[Elena Volkova]";
	mes "至于你，冒险者，请选择‘准备’并等着我们。";
	mes "副本启动后选择‘进入’。你一进入，我们的行动就会开始。";
		next;
	mes "^ff0000请注意，如果尝试驯服怪物或进行其他无关的怪物活动，将无法完成此副本。^000000";
		next;
		if (getcharid(1) < 1) {
			cutin "162elena_01",2;
			mes "[Elena Volkova]";
		mes "我说过，你必须独自完成。";
		mes "使用^0000Cd/organize [队伍名称]^000000命令，并以^0000Cd 1 人队伍^000000的形式回来。";
			close3;
		}
		if (is_party_leader() == false) {
			cutin "162elena_01",2;
			mes "[Elena Volkova]";
		mes "等等，你想带其他冒险者一起去吗？";
		mes "我信任你，但不了解你的朋友。请以^0000Cd 1 人队伍^000000的形式回来。";
			close3;
		}
		cutin "",255;
		switch (select("准备", "进入", "取消")) {
		case 1:
			if (instance_create("Cor Memorial") < 1) {
				cutin "162elena_01",2;
				mes "[Elena Volkova]";
				mes "似乎出了问题。你的请求失败了。请稍后再试。如果问题持续，请联系行动队。";
				close3;
			}
			cutin "162elena_01",2;
			mes "[Elena Volkova]";
			mes "好，副本启动后再来找我并选择^0000CD进入^000000。你一进入，我们的行动就会开始。";
			close3;
		case 2:
			if (is_party_leader() == false)	// additionnal check
				end;
			switch (instance_enter("Cor Memorial")) {
			case IE_OK:
				cloakonnpcself( "Rebellion#rm171_1" );
				cloakonnpcself( "Rebellion#rm171_2" );
				cloakonnpcself( "Rebellion#rm171_3" );
				cloakonnpcself( "Rebellion#rm171_4" );
				cloakonnpcself( "Rebellion#rm171_5" );
				cloakonnpcself( "Rebellion#rm171_6" );
				if (isbegin_quest(16355) > 0)
					erasequest 16355;
				if (isbegin_quest(16356) > 0)
					erasequest 16356;
				if (isbegin_quest(16376) == 0)
					setquest 16376;
				mapannounce "sp_cor", strcharinfo(0) + "所在的" + getpartyname(getcharid(1)) + "队伍已开始捕获艾莉乌米娜的行动。", bc_map, 0x00FF99;
				break;
			case IE_NOMEMBER:
				cutin "162elena_01",2;
				mes "[Elena Volkova]";
			mes "你的队长还没有创建副本。请向队长确认。";
				close3;
			case IE_NOINSTANCE:
				cutin "162elena_01",2;
				mes "[Elena Volkova]";
			mes "副本尚未创建。请再确认一次。";
				close3;
			case IE_OTHER:
				cutin "162elena_01",2;
				mes "[Elena Volkova]";
			mes "这是什么错误？请检查一下。";
				close3;
			}
			end;
		case 3:
			cutin "162elena_02",2;
			mes "[Elena Volkova]";
		mes "怎么了？你紧张吗？看起来很紧张。";
			close3;
		}
		end;
	case 2:
		break;
	}
	switch (isbegin_quest(16357)) {
	case 0:
		cutin "162elena_01",2;
		mes "[Elena Volkova]";
		mes "似乎出了问题。如果我一直重复同样的话，请联系行动队。";
		close3;
	case 1:
		if (checkweight(1201,3) == 0) {
			mes "[Alert]";
			mes "- 你的背包已满。请检查负重和携带物品数量后，再来和我谈谈。-";
			close3;
		}
		cutin "162elena_02",2;
		emotion 18;
		mes "[Elena Volkova]";
		mes "大家干得漂亮！呵呵！我就知道可以信任你们！";
		mes "啊，冒险者，你也做得很好！";
		next;
		cutin "162elena_01",2;
		mes "[Elena Volkova]";
		mes "多亏了你，我们成功抓住了艾莉乌米娜。现在不用担心他的随机袭击，总统手下的小士兵和平民可以回家了。";
		next;
		mes "[Elena Volkova]";
		mes "新手和那些被称为‘翅膀’的总统士兵正准备审问他。";
		mes "他们正在清理你与最后一台机器战斗的地方，把那里用作审讯室。";
		next;
		emotion 29;
		mes "[Elena Volkova]";
		mes "我这个人更喜欢用武力而不是谈话来得到答案，所以在那里大概没什么事可做，";
		mes "不过我和戈尼或许可以站在后面，用目光狠狠瞪着他。";
		next;
		mes "[Elena Volkova]";
		mes "你不来和我们一起<NAVI>[那里]<INFO>sp_cor,136,210,0,101,0</INFO></NAVI>吗？";
		mes "你可以站在我们旁边瞪着他，也可以帮新手审问。";
		completequest 16357;
		setquest 16358;
		getexp2 getbaseexp_ratio(10,110),0;
		getexp 0,300000;
		getexp 0,300000;
		getexp 0,250000;
		getitem 25668,1;	// EP17_1_EVT01
		getitem 25723,5;	// EP17_1_EVT39
		close3;
	case 2:
		break;
	}
	switch (isbegin_quest(16358)) {
	case 0:
		cutin "162elena_01",2;
		mes "[Elena Volkova]";
		mes "似乎出了问题。如果我一直重复同样的话，请联系行动队。";
		close3;
	case 1:
		cutin "162elena_01",2;
		mes "[Elena Volkova]";
		mes "新手和那些被称为‘翅膀’的总统士兵正准备审问他。";
		mes "他们正在清理你与最后一台机器战斗的地方，把那里用作审讯室。";
		next;
		emotion 29;
		mes "[Elena Volkova]";
		mes "我这个人更喜欢用武力而不是谈话来得到答案，所以在那里大概没什么事可做，";
		mes "不过我和戈尼或许可以站在后面，用目光狠狠瞪着他。";
		next;
		mes "[Elena Volkova]";
		mes "你不来和我们一起<NAVI>[那里]<INFO>sp_cor,136,210,0,101,0</INFO></NAVI>吗？";
		mes "你可以站在我们旁边瞪着他，也可以帮新手审问。";
		close3;
	case 2:
		cutin "162elena_01",2;
		mes "[Elena Volkova]";
		mes "嘿，你忙吗？";
		mes "接下来一段时间，我会经常往返这里和反叛军基地。";
		next;
		mes "[Elena Volkova]";
		mes "这种地方很容易发生普通反叛军成员无法处理的事故。";
		next;
		emotion 29;
		cutin "162elena_02",2;
		mes "[Elena Volkova]";
		mes "你有时间时，来克拉纳·尼米尔再和我较量一场吧。";
		mes "我不讨厌摧毁机器，但没有和你战斗那么有趣。";
		close3;
	}
	end;


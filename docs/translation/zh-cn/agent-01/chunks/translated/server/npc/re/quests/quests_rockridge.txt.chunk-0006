rockrdg1,146,164,1	script	Wasteland Cactuten#rremef01	4_ENERGY_RED,15,15,{
	if (checkweight(1301,3) == 0) {
		mes "[荒漠仙人掌怪]";
		mes "看来所有外来者都很贪心，你也不例外。";
		mes "你为什么带着这么多东西？";
		next;
		mes "- 我最好减轻负重后再和他谈谈。-";
		close;
	}
	if (isbegin_quest(16078) == 1 && isbegin_quest(16083) == 0 && countitem(25246) < 5) {
		.@player_name$ = strcharinfo(0);
		mes "[荒漠仙人掌怪]";
		mes "怎么，你以前没在这片荒地见过仙人掌吗？我很忙。走你的吧。";
		next;
		select("询问他是否见过果汁混合包。");
		mes "[" + .@player_name$ + "]";
		mes "你在附近见过果汁混合包吗？";
		next;
		mes "[荒漠仙人掌怪]";
		mes "果汁混合包？如果你说的是我在岩石间找到的那个，那我确实见过。";
		next;
		mes "[" + .@player_name$ + "]";
		mes "那是仙人掌夫人的。让我把它还给她。";
		next;
		mes "[荒漠仙人掌怪]";
		mes "不。凭什么把仙人掌夫人丢的东西给你？";
		next;
		if (select( "威胁他。", "劝说他。" ) == 1) {
			mes "[" + .@player_name$ + "]";
			mes "我是替她来的。如果你继续固执，";
			mes "那我就只能动用武力。";
			next;
			mes "[荒漠仙人掌怪]";
			mes "以血还血，我不想那样。布袋给你，外来者。";
			mes "不过仙人掌夫人竟然信任你这种暴徒，真该感到羞耻。";
			next;
			mes "- 我拿到了果汁混合包，但为了得到它而威胁他，我心里很不好受。-";
		}
		else {
			mes "[" + .@player_name$ + "]";
			mes "我一直在找果汁混合包，因为我知道有人丢了它们。";
			next;
			mes "[" + .@player_name$ + "]";
			mes "这个就是其中一个，而且不属于你。";
			next;
			mes "[荒漠仙人掌怪]";
			mes "你说得对。它不属于我。";
			next;
			mes "[" + .@player_name$ + "]";
			mes "那你为什么不让我把它还给失主？仙人掌夫人的孩子因为喝不到最喜欢的果汁而难过。我只是想让他开心。";
			next;
			mes "[荒漠仙人掌怪]";
			mes "嗯……你的逻辑并不完美，但至少证明你认识仙人掌夫人和莱克特。";
			next;
			mes "[荒漠仙人掌怪]";
			mes "好，我给你。但如果让我发现你骗了我，你要为背叛仙人掌的信任付出代价。";
			next;
			mes "[" + .@player_name$ + "]";
			mes "我发誓没有撒谎。";
			next;
			mes "- 我拿到了果汁混合包。-";
		}
		getitem 25246,1;// Juice_Package
		setquest 16083;// Discovered Wasteland Cactuten
		erasequest 16083;// Discovered Wasteland Cactuten
		cloakonnpcself( "Wasteland Cactuten#rremef01" );
		if (countitem(25246) > 4) {
			next;
			mes "[" + .@player_name$ + "]";
			mes "连仙人掌夫人都没想到能找回全部 7 个包装。";
			mes "这些应该够了。我最好回村子向她报告。";
			if (checkquest(16078,HUNTING) < 2) {
				next;
				mes "[" + .@player_name$ + "]";
				mes "哦，对了？我还需要狩猎 30 只郊狼。";
			}
		}
		close;
	}
	mes "[荒漠仙人掌怪]";
	mes "怎么，你以前没在这片荒地见过仙人掌吗？我很忙。走你的吧。";
	close;

OnTouch:
	if (isbegin_quest(16078) != 1 || countitem("Juice_Package") > 4 || isbegin_quest(16083) > 1)
		cloakonnpcself( "Wasteland Cactuten#rremef01" );
	else
		cloakoffnpcself( "Wasteland Cactuten#rremef01" );
	end;

OnInit:
	cloakonnpc();
	end;
}

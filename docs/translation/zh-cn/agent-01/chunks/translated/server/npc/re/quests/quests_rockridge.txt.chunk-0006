	end;
}

rockrdg1,182,124,3	script	Suspicious Sand Mound#rremef05	4_ENERGY_RED,15,15,{
	if (checkweight(1301,3) == 0) {
		mes "- 一个破旧的布袋半埋在沙丘里，但我携带的东西太多，无法检查。先减轻负重吧。-";

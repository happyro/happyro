		close;
	}
}

rockrdg1,305,200,3	script	Cactus Girl#rremef02	4_ENERGY_RED,15,15,{
	if (checkweight(1301,3) == 0) {
		mes "[仙人掌少女]";
		mes "外来者……";
		next;
		mes "[仙人掌少女]";
		mes "你太执着于材料了。难道不知道它们只会增加负重吗？";
		next;
		mes "- 我最好减轻负重后再和他谈谈。-";
		close;
	}
	if (isbegin_quest(16078) == 1 && isbegin_quest(16087) == 0 && countitem(25246) < 5) {
		.@player_name$ = strcharinfo(0);
		mes "[仙人掌少女]";
		mes "外来者……";
		mes "别靠近我，否则后果自负。";
		emotion ET_ANGER;
		next;
		select("你见过果汁混合包吗？");
		mes "[" + .@player_name$ + "]";
		mes "你在附近见过果汁混合包吗？";
		next;
		mes "[仙人掌少女]";
		mes "果汁混合包？";
		mes "……你在找这个吗？我在沙子里发现的。";
		next;
		mes "[" + .@player_name$ + "]";
		mes "就是这个。仙人掌夫人把它弄丢了。让我还给她。";
		next;
		mes "[仙人掌少女]";
		mes "...";
		mes "……我明白了。";
		mes "你说仙人掌夫人弄丢了它。你是谁？";
		next;
		mes "[" + .@player_name$ + "]";
		mes "我是冒险者，替她来这里。";
		mes "如果你不相信，可以去村子里和她谈谈。";
		next;
		mes "[仙人掌少女]";
		mes "*哼*你以为我傻吗？如果你是小偷，等我从村子回来时你早就不在这里了。";
		mes "给，拿去吧。";
		emotion ET_HNG;
		next;
		mes "[" + .@player_name$ + "]";
		mes "你就这样给我吗？";
		next;
		mes "[仙人掌少女]";
		mes "你说是仙人掌夫人派你来的，我相信她。怎么，你想让我为难你吗？";
		emotion ET_QUESTION;
		next;
		mes "[" + .@player_name$ + "]";
		mes "不。谢谢你把它给我。";
		next;
		mes "- 我从仙人掌少女那里拿到了果汁混合包。-";
		getitem 25246,1;// Juice_Package
		setquest 16087;// Discovered Cactus Girl
		completequest 16087;// Discovered Cactus Girl
		cloakonnpcself( "Cactus Girl#rremef02" );
		if (countitem(25246) > 4) {
			next;
			mes "[" + .@player_name$ + "]";
			mes "连仙人掌夫人都没想到能找回全部 7 个包装。";
			mes "这些应该够了。我最好回村子向她报告。";
			if (checkquest(16078,HUNTING) < 2) {
				next;
				mes "[" + .@player_name$ + "]";
				mes "哦，对了？我还需要狩猎 30 只郊狼。";
			}
		}
		close;
	}
	mes "[仙人掌少女]";
	mes "外来者……";
	mes "别靠近我，否则后果自负。";
	emotion ET_ANGER;
	close;

OnTouch:
	if (isbegin_quest(16078) != 1 || countitem("Juice_Package") > 4 || isbegin_quest(16087) > 1)
		cloakonnpcself( "Cactus Girl#rremef02" );
	else
		cloakoffnpcself( "Cactus Girl#rremef02" );
	end;

OnInit:
	cloakonnpc();
	end;
}

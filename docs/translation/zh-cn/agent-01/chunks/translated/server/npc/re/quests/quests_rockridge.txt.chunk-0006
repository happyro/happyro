rockrdg1,262,90,7	script	Crouched Horse#rr	4_M_CACTUSMAN1,{
	mes "[蹲伏马]";
	mes "你好。";
	mes "愿太阳与大地";
	mes "赐福于你。";
	next;
	mes "[蹲伏马]";
	if (rock_main_quest < 22) {
		mes "你就是来自遥远土地的外来者之一。";
		mes "我是蹲伏马，";
		mes "勇敢的仙人掌战士。";
		next;
		mes "[蹲伏马]";
		mes "你们村子的一切";
		mes "还没有安定下来。";

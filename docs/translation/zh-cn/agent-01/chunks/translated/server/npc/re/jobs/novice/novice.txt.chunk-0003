-	script	Brade#newbe04::NvBradeB	-1,{
	if (job_novice_q < 12) {
		if (job_novice_q < 2) {
			mes "[布雷德]";
			mes "你参加过之前的训练场。训练场现在已经换了管理者。";
			next;
			mes "[布雷德]";
			mes "你想参加基础课程，还是想从这里直接通过？";
			next;
			switch(select("送我去基础训练。:我从这里开始。")) {
			case 1:
				mes "[布雷德]";
				mes "好。我送你去基础课程。";
				close2;
				warp "new_"+charat(strnpcinfo(4),4)+"-2",100,100;
				end;
			case 2:
				mes "[布雷德]";
				mes "那么我们开始训练。我会写下登记表。";
				set job_novice_q,12;
				close;
			}
		} else {
			mes "[布雷德]";
			mes "我想你刚从理论训练课程回来。";
			mes "要我送你回去，还是你想从这里直接通过？";
			next;
			switch(select("送我回巧克力那里。:我从这里开始。")) {
			case 1:
				mes "[布雷德]";
				mes "好。我送你去巧克力那里。";
				close2;
				warp "new_"+charat(strnpcinfo(4),4)+"-2",41,172;
				end;
			case 2:
				mes "[布雷德]";
				mes "那么我们开始训练。我会写下登记表。";
				set job_novice_q,12;
				close;
			}
		}
	} else if (job_novice_q == 12) {
		mes "[布雷德]";
		mes "欢迎。现在是真正的实践，我们可以在这里练习实战。";
		next;
		mes "[布雷德]";
		mes "正如我第一次说明的，可以点击魔物。每次点击攻击一次。";
		next;
		mes "[布雷德]";
		mes "为了方便，攻击时按住^4d4dffCtrl 键^000000就会自动攻击。";
		next;
		mes "[布雷德]";
		mes "也可以在战斗前输入^4d4dff[ /nc ]^000000设置该模式。";
		next;
		mes "[布雷德]";
		mes "那么，开始猎杀波利吧。请在训练场一层猎杀波利。";
		set job_novice_q,13;
		setquest 7122;
		getitem 569,100; //Novice_Potion
		savepoint strnpcinfo(4),96,21,1,1;
		next;
		mes "^4d4dff—你从教官布雷德那里接到了任务。";
		mes "请查看任务信息窗口。—^000000";
		close2;
	} else if (job_novice_q < 15) {
		if (job_novice_q == 13) {
			if (checkquest(7122,HUNTING) == 2) {
				mes "[布雷德]";
				mes "你看，没那么难吧？做得不错。";
				set job_novice_q,14;
				getitem 13040,1; //N_Cutter
				getexp 3000,30;
				completequest 7122;
				next;
			} else {
				mes "[布雷德]";
				mes "消灭足够数量的波利。波利很好对付，振作起来。再试一次。";
				npcskill "AL_HEAL",11,99,60;
				close;
			}
		}
		mes "[布雷德]";
		mes "现在所有课程都快完成了。你是初心者，还不能获得职业。";
		next;
		mes "[布雷德]";
		mes "职业等级达到 10 并学会所有基本技能后，就可以转职。";
		next;
		mes "[布雷德]";
		mes "第一阶段的职业分为 6 类。";
		next;
		mes "[布雷德]";
		mes "6 种基础职业是剑士、盗贼、服事、法师、弓箭手和商人。";
		next;
		mes "[布雷德]";
		mes "体验这 6 种基础职业，看看剑士、盗贼、服事、法师、弓箭手和商人能做什么。";
		next;
		mes "[布雷德]";
		mes "我身后有各基础职业公会派来的人。";
		mes "他们会给你说明手册，让你体验各职业的部分技能。";
		next;
		mes "[布雷德]";
		mes "装备想体验职业的手册，就能使用该职业的一些基础技能。";
		mes "试用技能后决定选择哪个职业。";
		set job_novice_q,15;
		close;
	} else {
		mes "[布雷德]";
		mes "你试过手册里的技能了吗？想了解各职业的信息，就和职业公会派来的人交谈。";
		next;
		mes "[布雷德]";
		mes "我想你已经学得够多了。要离开这里前往第一个城镇吗？";
		next;
		switch(select("我再留一会儿。:我要离开去城镇。")) {
		case 1:
			mes "[布雷德]";
			mes "你可以留在这里练习，直到觉得准备好了。";
			next;
			mes "[布雷德]";
			mes "试用职业手册，了解各职业技能的特点。";
			mes "我会恢复你的 HP 和 SP……继续努力。";
			npcskill "AL_HEAL",11,99,60;
			percentheal 0,100;
			close;
		case 2:
			mes "[布雷德]";
			mes "看来你准备好了。你已经下定决心了，对吧？";
			mes "那么，你想去哪里？";
			next;
			switch(select("普隆德拉:梦罗克:斐扬:艾尔贝塔:吉芬:取消")) {
			case 1:
				mes "[布雷德]";
				mes "普隆德拉，卢恩·米德加尔特王国的首都。旅途保重，愿神保佑你。";
				callfunc "F_NvErase";
				close2;
				savepoint "prontera",117,72,1,1;
				warp "prontera",150,50;
				end;
			case 2:
				mes "[布雷德]";
				mes "沙漠城市梦罗克……那座城镇里隐藏着许多故事。保重。";
				callfunc "F_NvErase";
				close2;
				savepoint "morocc",150,99,1,1;
				warp "morocc",155,110;
				end;
			case 3:
				mes "[布雷德]";
				mes "你选择了斐扬。愿神保佑你。";
				callfunc "F_NvErase";
				close2;
				savepoint "payon",70,100,1,1;
				warp "payon",166,67;
				end;
			case 4:
				mes "[布雷德]";
				mes "艾尔贝塔，港口城市。这里是所有贸易的中心。";
				mes "如果想接触其他文明，必须先去艾尔贝塔。愿神保佑你的灵魂。";
				callfunc "F_NvErase";
				close2;
				savepoint "alberta",30,232,1,1;
				warp "alberta",114,58;
				end;
			case 5:
				mes "[布雷德]";
				mes "吉芬，魔法之城。城中心的吉芬塔很不错。";
				mes "我会把你送到吉芬喷泉附近。愿芙蕾雅女神祝福你。";
				callfunc "F_NvErase";
				close2;
				savepoint "geffen",119,37,1,1;
				warp "geffen",122,65;
				end;
			case 6:
				mes "[布雷德]";
				mes "好……谨慎思考。去和各公会的人见面吧。";
				close;
			}
		}
	}
}
new_1-3,96,30,4	duplicate(NvBradeB)	Brade#nv1b	733
new_2-3,96,30,4	duplicate(NvBradeB)	Brade#nv2b	733
new_3-3,96,30,4	duplicate(NvBradeB)	Brade#nv3b	733
new_4-3,96,30,4	duplicate(NvBradeB)	Brade#nv4b	733
new_5-3,96,30,4	duplicate(NvBradeB)	Brade#nv5b	733

-	script	Swordman Guide#newbe10::NvSwordman	-1,{
	if (job_novice_q < 15) {
		mes "[剑士公会成员]";
		mes "在完成布雷德的指示前，我不会帮助你。";
		close;
	}
	mes "[剑士公会成员]";
	mes "我能帮你吗？";
	next;
	switch(select("关于剑士职业。:转职为剑士。:有任务吗？:取消。")) {
	case 1:
		mes "[剑士公会成员]";
		mes "剑士指专门使用剑的人，但也可以选择使用长矛。";
		next;
		mes "[剑士公会成员]";
		mes "我们拥有强大的体力，因此可以装备沉重的防具和武器。";
		mes "除了弓和杖，大多数武器类别都能装备。";
		next;
		mes "[剑士公会成员]";
		mes "剑士唯一的弱点是不能使用魔法，但我们可以用属性武器弥补。";
		next;
		mes "[剑士公会成员]";
		mes "成为剑士的优点是拥有大量 HP，大多数人都能相对轻松地承受敌人攻击。";
		next;
		mes "[剑士公会成员]";
		mes "在一对一的近战中，我们无人能敌。";
		next;
		mes "[剑士公会成员]";
		mes "选择剑士的人通常会担任坦克。保护弱者是我们的职责。";
		next;
		mes "[剑士公会成员]";
		mes "剑士可以进阶为^8E2323骑士^000000或^8E2323十字军^000000二转职业。";
		mes "最近还发现了三转职业。";
		next;
		if (isequipped(2819) || countitem(2819)) {
			mes "[剑士公会成员]";
			mes "试试手册中列出的剑士技能。";
			mes "按 Alt + S 打开技能菜单，点击右上角的最小化按钮切换到列表模式。";
			close;
		}
		mes "[剑士公会成员]";
		mes "如果对剑士感兴趣，我可以给你这本手册。想试试剑士技能吗？";
		next;
		switch(select("我想试试剑士技能。:不用了，谢谢。")) {
		case 1:
			mes "[剑士公会成员]";
			mes "这是剑士手册。我会收走你持有的其他职业手册。";
			next;
			callfunc "F_NvErase";
			getitem 2819,1; //Swordman_Manual
			next;
			mes "[剑士公会成员]";
			mes "装备手册后按 ALT+S 打开技能菜单。";
			mes "点击技能树窗口右上角的‘-’按钮将技能树最小化。";
			close;
		case 2:
			mes "[剑士公会成员]";
			mes "嗯，你这么想吗？好吧，我同意。选择职业是人生中的重要决定。";
			mes "想体验剑士技能时随时来找我。";
			close;
		}
	case 2:
		mes "[剑士公会成员]";
		mes "你真的想转职为剑士吗？我可以立即送你去剑士协会。";
		next;
		mes "[剑士公会成员]";
		mes "我想你的职业等级已经足够了，对吧？";
		mes "现在要结束训练，前往剑士协会吗？";
		next;
		switch(select("我再考虑一下。:我要去剑士协会。")) {
		case 1:
			mes "[剑士公会成员]";
			mes "请充分体验各职业手册后再仔细考虑。当然，我们随时欢迎你。";
			close;
		case 2:
			mes "[剑士公会成员]";
			mes "我明白了。那我结束你的训练，并把你送到剑士公会。";
			callfunc "F_NvErase",1;
			close2;
			savepoint "izlude",128,98,1,1; // Old coordinates: (95,104)
			warp "izlude_in",74,167;
			end;
		}
	case 3:
		set .@quest, checkquest(7123);
		if (.@quest == -1) {
			mes "[剑士公会成员]";
			mes "你想让我给你任务？嗯，让我看看。";
			mes "好吧！去猎杀附近的几只波奇怪物？";
			next;
			mes "^4d4dff你从剑士公会成员那里接到了狩猎请求。";
			mes "可以在任务信息窗口查看任务内容。^000000";
			setquest 7123;
			next;
			mes "[剑士公会成员]";
			mes "使用剑士手册中的‘狂击’技能。";
			mes "按^4d4dffAlt + S^000000打开技能树，再点击右上角的^4d4dff‘-’^000000按钮将窗口最小化，查看可用的剑士技能。";
			next;
			mes "[剑士公会成员]";
			mes "想挑战更强的魔物，就和训练师布鲁图斯交谈。";
			mes "我会在这里等你。祝你好运。";
			close;
		} else if (.@quest == 0 || .@quest == 1) {
			if (checkquest(7123,HUNTING) == 2) {
				mes "[剑士公会成员]";
				mes "很好。我认为你已经足够成为剑士。";
				mes "我会给你一些药水作为奖励。";
				completequest 7123;
				getitem 569,200; //Novice_Potion
				getexp 5000,100;
				close;
			} else {
				mes "[剑士公会成员]";
				mes "猎杀两只波奇怪物。";
				mes "和训练师布鲁图斯交谈，就能在更困难的训练场找到它们。";
				close;
			}
		} else if (.@quest == 2) {
			mes "[剑士公会成员]";
			mes "我想你已经完成那个任务了，对吧？";
			mes "随着你在世界上成长为冒险者，还会体验更多这类任务。";
			next;
			mes "[剑士公会成员]";
			mes "你的训练已经完成。如果选择成为剑士，祝你好运。";
			close;
		} else {
			mes "[剑士公会成员]";
			mes "抱歉，我现在没有任务可以给你。";
			close;
		}
	case 4:
		mes "[剑士公会成员]";
		mes "如果对剑士职业有疑问，请问我。剑士公会正在等待像你这样的初心者。";
		close;
	}
}
new_1-3,97,41,3	duplicate(NvSwordman)	Swordman Guide#nv1	728
new_2-3,97,41,3	duplicate(NvSwordman)	Swordman Guide#nv2	728
new_3-3,97,41,3	duplicate(NvSwordman)	Swordman Guide#nv3	728
new_4-3,97,41,3	duplicate(NvSwordman)	Swordman Guide#nv4	728
new_5-3,97,41,3	duplicate(NvSwordman)	Swordman Guide#nv5	728

-	script	Acolyte Guide#newbe10::NvAcolyte	-1,{
	if (job_novice_q < 15) {
		mes "[普隆德拉服事]";
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
		mes "看起来你还没有完成布雷德教官的课程。";
		close;
	}
	mes "[普隆德拉服事]";
	mes "我能帮你什么？";
	next;

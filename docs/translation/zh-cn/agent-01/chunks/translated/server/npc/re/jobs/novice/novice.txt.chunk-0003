-	script	Cool Event Corp. Staff::NvCool	-1,{
	if (job_novice_q < 9) {
		mes "[酷爱活动公司员工]";
		mes "现在还不是我的轮班时间。";
		mes "你和卡普拉员工谈完了吗？";
		close;
	} else if (job_novice_q == 9) {
		mes "[酷爱活动公司员工]";
		mes "你好。我们正在努力为米德加尔特提供类似卡普拉服务的活动。";
		next;
		mes "[酷爱活动公司员工]";
		mes "我们可以为你提供[仓库]、[保存]和[传送服务]。";
		next;
		mes "[酷爱活动公司员工]";
		mes "如果附近没有卡普拉，我们可以帮助你。";
		next;
		mes "[酷爱活动公司员工]";
		mes "我们正努力建立活动网络，让你的生活更加便利。";
		mes "希望你能在艾尔贝塔遇到我们的员工。";
		next;
		mes "[酷爱活动公司员工]";
		mes "谁知道呢，也许我们会在学院外再次见面。";
		next;
		mes "[酷爱活动公司员工]";
		mes "在卡普拉员工不工作的地方，我们大多穿红色外套。";
		set job_novice_q,10;
		close;
	} else {
		mes "[酷爱活动公司员工]";
		mes "我们的多数服务都与卡普拉公司的服务类似。";
		close;
	}
}

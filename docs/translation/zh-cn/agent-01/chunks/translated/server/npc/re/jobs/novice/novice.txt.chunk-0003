-	script	Guide::NvGuide	-1,{
	if (job_novice_q < 10) {
		mes "[导游]";
		mes "还没轮到我。去听巧克力的说明。";
		close;
	} else if (job_novice_q == 10) {
		mes "[导游]";
		mes "每个城镇都有导游，能带你前往有用的地点。";
		mes "告诉我们你想去哪里，我们会在小地图上标记^4d4dff+^000000。";
		mes "有问题尽管问。";
		next;
		mes "[导游]";
		mes "我们在不同城镇的外表可能不同，但职责都一样。";
		mes "去新城镇时请记住这一点。";
		next;
		mes "[导游]";
		mes "如果想去第一个城镇，可以询问左边的卡普拉员工。";
		mes "你可以使用传送服务前往那里。";
		set job_novice_q,11;
		close;
	} else {
		mes "[导游]";
		mes "我能帮你什么？需要我再解释一下我的职责吗？";
		next;
		switch(select("是的，我需要解释。:不用了。")) {
		case 1:
			mes "[导游]";
			mes "每个城镇都有导游，能带你前往有用的地点。";
			mes "告诉我们你想去哪里，我们会在小地图上标记^4d4dff+^000000。";
			mes "有问题尽管问。";
			next;
			mes "[导游]";
			mes "我们在不同城镇的外表可能不同，但职责都一样。去新城镇时请记住这一点。";
			next;
			mes "[导游]";
			mes "如果想去第一个城镇，可以询问左边的卡普拉员工。你可以使用传送服务前往那里。";
			close;
		case 2:
			mes "[导游]";
			mes "好吧，和我们谈完后去找巧克力。";
			close;
		}
	}
}

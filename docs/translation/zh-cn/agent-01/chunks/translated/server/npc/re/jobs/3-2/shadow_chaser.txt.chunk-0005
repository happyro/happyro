	if (checkweight(1201,1) == 0) {
		mes "- 由于负重过高，无法继续任务。-";
		close;
	}
	setarray .@Words$[0],"SEED","FOOT","COLD";
	setarray .@Numbers[0],24,25,20;
	set .@i,job_sha-14;
	if (job_sha > 13 && job_sha < 17) {
		mes "这里有很多箱子，";
		mes "上面写着一些数字。";
		next;
		mes " 1 2 3 4 5";
		mes " 6 7 8 9 0";
		mes " ";
		mes " [ ][ ] ";
		next;
		mes "你碰到那个数字后，它移动了。";
		mes "你发现了空位。";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "看来我得把数字放进空位……";
		mes "有两个空格可以放两个数字。";
		mes "这样有什么用呢？";
		next;
		select("我觉得这和保罗给出的单词有关。");
		mes "["+strcharinfo(0)+"]";
		mes "我拿到了"+.@Words$[.@i]+"。";
		mes "现在我得把它转换成数字……";
		next;
		switch(select("输入答案。:我解不出来。")) {
		case 1:
			input .@input;
			if (.@input == .@Numbers[.@i]) {
				mes "你输入了 2 和 "+(.@Numbers[.@i]-20)+"。";
				mes "箱子打开了，你获得了一把钥匙。";
				next;
				mes "你获得了幻影之钥。";
				next;
				mes "["+strcharinfo(0)+"]";

				mes "幻影之钥？和幻影之影有关吗？";
				mes "我处理完欺诈后拿到了欺诈之钥……";
				next;
				mes "["+strcharinfo(0)+"]";
				mes "不管怎样，保罗会失望的。";
				mes "又是钥匙……";
				mes "我该怎么离开这里……？";
				set job_sha,17;
				getitem 6267,1; //Virtual_Key
				erasequest 7171;
				changequest 7168+.@i,7172;
				next;
				mes "我推开箱子后，看到了通往外面的门。";
				close2;
				warp "ice_dun02",209,219;
				end;
			}
			mes "输入数字后，它又回到了最初的状态。";
			close;
		case 2:
			mes "["+strcharinfo(0)+"]";
			mes "嗯。";
			mes "我解不出来……";
			mes "这是和普隆德拉工作地点相同的密码吗……？";
			next;
			mes "["+strcharinfo(0)+"]";
			mes "按照那个方法……";
			mes "A 代表 11，B 代表 12。";
			close;
		}
	}
	mes "这是一个神秘的箱子。";
	mes "我推开箱子后，看到了通往外面的门。";
	close2;
	warp "ice_dun02",209,219;
	end;
}


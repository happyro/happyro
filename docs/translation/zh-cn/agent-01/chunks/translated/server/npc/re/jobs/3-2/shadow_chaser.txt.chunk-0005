s_atelier,29,119,3	script	Max#sc05_prt	97,{
	mes "[马克斯]";
	mes "欢迎~";
	if (Class == Job_Shadow_Chaser || Class == Job_Shadow_Chaser_T || Class == Job_Baby_Shadow_Chaser) {
	mes "你是盗贼公会成员！";
	mes "我能帮你什么？";
		next;
		set .@i, select("我需要化妆刷。:我需要画笔。:没什么。" );
	mes "[马克斯]";
		if (.@i == 1) setarray .@i[1],6121,1,10,100000;
		else if (.@i == 2) setarray .@i[1],6122,2,30,200000;
		else {
	mes "如果还需要，";
	mes "再来找我吧！";
			close;
		}
		if (countitem(.@i[1])) {
	mes "你在开玩笑吗？";
	mes "你已经有了？";
	mes "那就不需要其他东西了。";
			next;
	mes "[马克斯]";
	mes "以后再来，使用你已有的东西吧！";
			close;
		}
		if (countitem(7150) >= .@i[2] && countitem(949) >= .@i[3] && Zeny >= .@i[4]) {
	mes "哦，你带齐了所有必需品。";
	mes "请稍等。";
			next;
	mes "[马克斯]";
	mes "这是你需要的东西。";
			next;
	mes "[马克斯]";
	mes "拿去吧。";
	mes "祝你好运！";
			delitem 7150,.@i[2]; //Bamboo_Cut
			delitem 949,.@i[3]; //Feather
			set Zeny, Zeny - .@i[4];
			getitem .@i[1],1; //Makeover_Brush,Paint_Brush
			close;
		}
	mes "制作化妆刷需要这些材料。";
		mes "需要 "+.@i[2]+" 根竹片、";
		mes .@i[3]+" 根羽毛、";
		mes "和 "+.@i[0]+"00,000 Zeny。";
		close;
	}
	mes "这里出售各种艺术相关物品~";
	next;
	switch(select("颜料！？:经理在哪里？")) {
	case 1:
	mes "[马克斯]";
	mes "你在找颜料？";
	mes "你可以请他们去拿颜料吗~";
		close;
	case 2:
	mes "[马克斯]";
	mes "我们的经理就在那边。";
	mes "就是那里。";
	mes "**指向**";
	mes "你是看不见吗？";
		close;
	}
}


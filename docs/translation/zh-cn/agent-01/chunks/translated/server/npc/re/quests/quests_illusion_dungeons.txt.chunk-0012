// Entrance - starter
alberta,211,28,5	script	Knight Aylvar#illtur	4_M_YOUNGKNIGHT,{
	.@account_id = getcharid(3);
	.@player_name$ = strcharinfo(0);

	disable_items;
	if (ill_turtle == 0) {
		npctalk "艾尔瓦：我需要你的帮助。请快点！", "", bc_self;
		mes "[Knight Aylvar]";
		mes "嗯……你是冒险者吗？？我想拜托你一件事……";
		next;
		if (BaseLevel < 150) {
			mes "[Knight Aylvar]";
			mes "……哦，你还需要更多经验。抱歉打扰了。";
			mes "这是一项高风险工作。";
			next;
			mes " - ^0000CD等级 150 及以上才能进行此任务。^000000 - ";
			close;
		}
		if (select( "发生什么事了？", "我很忙。" ) == 2) {
			npctalk "艾尔瓦：莱芬，我的朋友……请你平安无事。", "", bc_self;
			mes "[Knight Aylvar]";
			mes "抱歉打扰你。";
			mes "愿神保佑你。";
			close;
		}
		npctalk "艾尔瓦：冒险者？啊，是你，" + .@player_name$ + "。", "", bc_self;
		mes "[Knight Aylvar]";
		mes "抱歉突然拜托你。";
		mes "我是艾尔瓦，来自艾尔帕兰卫队第一骑士团。";
		next;
		mes "[Knight Aylvar]";
		mes "奉骑士团之命，我正在寻找在海龟岛失踪的艾尔帕兰第二骑士团。";
		mes "然而遭遇猛烈风暴后，我抵达了一个海龟岛，却感觉它不像普通的海龟岛。";
		emotion ET_QUESTION, .@account_id;
		unittalk .@account_id, "" + .@player_name$ + "：这是什么意思？那里看起来不像普通的海龟岛？", bc_self;
		sleep2 1500;
		npctalk "艾尔瓦：很难解释，那里明显是海龟岛，但我却起了一身鸡皮疙瘩。", "", bc_self;
		next;
		mes "[Knight Aylvar]";
		mes "我当时身处险境，但有人救了我。";
		next;
		mes "[Knight Aylvar]";
		mes "醒来时，我感受到了来自艾尔帕兰港口的海风……手里还有两块这样的龟壳。";
		npctalk "艾尔瓦：我不知道是怎么回事，但我知道自己好不容易才捡回一条命。", "", bc_self;
		next;
		mes "[Knight Aylvar]";
		mes "现在我手里只有其中一块。";
		mes "另一块可能在我朋友那里。不，我是说，他一定还留着。";
		next;
		if (select( "你的朋友遇到麻烦了吗？", "难以置信。" ) == 2) {
			emotion ET_PROFUSELY_SWAT;
			mes "[Knight Aylvar]";
			mes "我理解。连我自己都很困惑，但请听我说完。我觉得我的朋友有危险。";
		}
		else {
			emotion ET_PROFUSELY_SWAT;
			mes "[Knight Aylvar]";
			mes "是的，是关于我朋友的事。抱歉说了这么久，再听我说一点。";
		}
		next;
		npctalk "莱芬：我是莱芬，朱诺的考古学教授。", "", bc_self;
		mes "[Knight Aylvar]";
		mes "我把这些碎片给朋友^0000CD莱芬^000000看。";
		mes "他对此非常感兴趣。^0000CD他说这是用只生活在海龟岛上的海龟龟壳制成的。";
		next;
		mes "[Knight Aylvar]";
		mes "我把碎片交给他之后……";
		mes "正在查看碎片的朋友莱芬突然消失了。";
		npctalk "艾尔瓦：我亲眼看到的。他刚才就在这里。", "", bc_self;
		next;
		mes "[Knight Aylvar]";
		mes "事情发生在^FF0000半天前^000000。";
		mes "这段时间里，我联系了朱诺大学，也去了海龟岛，但一无所获……我希望能找到线索，弄清莱芬究竟消失去了哪里。";
		next;
		mes "[Knight Aylvar]";
		mes "" + .@player_name$ + "，请帮帮我们。你能帮我找到朋友吗？";
		mes "这块碎片可能是线索。请你看看。";
		next;
		select("请告诉我你朋友的长相。");
		mes "[Knight Aylvar]";
		mes "^0000CD他戴着眼镜^000000，留着蓝色短发。^0000CD他的脸看起来像学者^000000，应该很容易认出。";
		next;
		if (select( "把碎片给我看看。", "抱歉，我很忙。" ) == 2) {
			npctalk "艾尔瓦：莱芬，我的朋友……请你平安无事。", "", bc_self;
			mes "[Knight Aylvar]";
			mes "抱歉打扰你。";
			mes "愿神保佑你。";
			close;
		}
		if (checkweight(25315,1) == 0) {
			mes " - ^424242停止交出碎片。^000000 - ";
			next;
			mes "[Knight Aylvar]";
			mes "抱歉，" + .@player_name$ + "。你携带的物品太多了。看来现在很难找到我的朋友。";
			next;
			mes "[Knight Aylvar]";
			mes "你能清理一下背包吗？我会在这里等你。";
			close;
		}
		mes " - ^424242我接过骑士交来的碎片。龟壳上刻着一片小叶子。碎片很厚重，却不知为何感觉很温暖。^000000 - ";
		next;
		mes " - ^424242我看了一会儿碎片，脑海中突然浮现出某种景象。突然一阵风吹来，视野变得昏暗。^000000 - ";
		next;
		emotion ET_KEK;
		npctalk "艾尔瓦：呃，是和之前一样的风。" + .@player_name$ + "，你没事吧？", "", bc_self;
		mes " - ^424242艾尔瓦的声音越来越小，我感到头晕。空气中开始有湿黏土的气味……^000000 - ";
		ill_turtle = 1;
		setquest 16096;	// To the unknown tortoise island
		close2;
		getitem 25315,1;	// Piece_Of_Shell
		warp "tur_d03_i",132,187;
		end;
	}
	if (ill_turtle < 11) {
		mes "[Knight Aylvar]";
		mes "" + .@player_name$ + "！哦，你没事！我……很担心。莱芬消失后，" + .@player_name$ + "你也消失了，我真的很担心。";
		sleep2 500;
		if (ill_turtle > 5) {
			unittalk .@account_id, "" + .@player_name$ + "：没事，考古学家莱芬的位置好像就是我去过的地方。", bc_self;
			sleep2 1000;
			npctalk "艾尔瓦：真的吗？哦，莱芬……！", "", bc_self;
		}
		else {
			unittalk .@account_id, "" + .@player_name$ + "：我没事。我找到考古学家莱芬了。", bc_self;
			sleep2 1000;
			npctalk "艾尔瓦：真的吗？太好了！莱芬……！", "", bc_self;
		}
		next;
		mes "[Knight Aylvar]";
		mes "你要再次回去寻找莱芬吗？";
		npctalk "艾尔瓦：我有办法去那里吗？", "", bc_self;
		sleep2 1000;
		unittalk .@account_id, "" + .@player_name$ + "：我觉得你很难去那里。", bc_self;
		next;
		if (select( "让我再次去那里。", "我之后再去。" ) == 2) {
			mes "[Knight Aylvar]";
			mes "请救救莱芬。";
			mes "如果我能去那里，我会亲自救他。";
			close;
		}
		mes "[Knight Aylvar]";
		mes "谢谢你。真的非常感谢。";
		mes "请救救莱芬。";
		next;
		mes " - ^424242正如那里遇到的女孩告诉我的，我握紧龟壳碎片，再次感受到风吹过头发。^000000 - ";
		next;
		npctalk "艾尔瓦：" + .@player_name$ + "，请小心！", "", bc_self;
		mes " - ^424242在双眼完全陷入黑暗前，我的脸颊感受到洞穴中更凉的空气……^000000 -";
		close2;
		warp "tur_d03_i",132,187;
		end;
	}
	if (ill_turtle == 11) {
		mes "[Knight Aylvar]";
		mes "你好，" + .@player_name$ + "。我已经听莱芬讲完了所有事情。";
		mes "他再次去了那里，让我很担心。他说查明那个地方的秘密后就会回来。";
		next;
		mes "[Knight Aylvar]";
		mes "不仅是莱芬，还有一个叫娜琳的孩子……你也帮助过她。你真是位了不起的冒险者。";
		mes "你还要再去那里吗？";
		next;
		if (select( "是的。我要去那里。", "现在还不去。" ) == 2) {
			emotion ET_SURPRISE;
			mes "[Knight Aylvar]";
			mes "哦，既然你要再去那里，请也确认莱芬平安无事。";
			ill_turtle = 12;
			setquest 16114;	// Talk with Aylvar
			completequest 16114;	// Talk with Aylvar
			close;
		}
		mes "[Knight Aylvar]";
		mes "请再回来，" + .@player_name$ + "。";
		mes "路上请确认莱芬一切安好。";
		ill_turtle = 12;
		setquest 16114;	// Talk with Aylvar
		completequest 16114;	// Talk with Aylvar
		close2;
		warp "tur_d03_i",132,187;
		end;
	}
	npctalk "艾尔瓦：对他来说研究比自己更重要，所以我想待在他身边。", "", bc_self;
	mes "[Knight Aylvar]";
	mes "很高兴再次见到你。我已经把情报报告给骑士团，现在的工作是支持莱芬的研究。";
	mes "你还要再去那里吗？";
	next;
	if (select( "是的。我要去那里。", "现在还不去。" ) == 2) {
		mes "[Knight Aylvar]";
		mes "听完他的故事后，我也想去那里……但我无法像他说的那样前往。真遗憾。";
		close;
	}
	mes "[Knight Aylvar]";
	mes "请再回来，" + .@player_name$ + "。";
	mes "如果找到莱芬，请确认他有好好吃饭。";
	close2;
	emotion ET_KEK;
	warp "tur_d03_i",132,187;
	end;

OnInit:
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "ill_turtle == 0 && BaseLevel > 149" );
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "ill_turtle == 11" );
	end;
}


tur_d03_i,217,73,0	warp	illtur03_04	 2,2,tur_d04_i,99,186
tur_d04_i,99,191,0	warp	illtur04_03	 2,2,tur_d03_i,217,82

tur_d03_i,132,194,3	script	Portal#illtur02	4_ENERGY_RED,{
	if (ill_turtle < 11) {
		mes " - ^424242门后是一片漆黑，仿佛什么都不存在。黑色天空前漂浮着红光，一个神情紧张的女孩出现了。^000000 - ";
		next;
		npctalk "女孩：碎片会帮助你。抓紧。", "Girl#illtur01", bc_self;
		mes "[Girl]";
		mes "……就是这里。";
		mes "绝望、无助，而且有毒。";
		next;
		mes " - ^424242这是个令人困惑的回答，但也许能帮上忙。按照女孩所说，我紧紧握住龟壳。^000000 - ";
		next;
		if (select( "回艾尔帕兰。", "留在这里。" ) == 2) {
			unittalk getcharid(3), "" + strcharinfo(0) + "：我在这里还有事情要做。", bc_self;
			mes "[Girl]";
			mes "……不回去吗？";
			close;
		}
		npctalk "女孩：是的。现在……走吧。", "Girl#illtur01", bc_self;
		mes " - ^424242咸涩的海风吹起衣角。耳边传来艾尔帕兰港的海浪声和海鸥的叫声……^000000 - ";
		close2;
		warp "alberta",219,31;
		end;
	}
	if (isbegin_quest(16115) == 0) {
		mes " - ^424242这道红光对娜琳来说是看不见的。它似乎就这样消失了。^000000 - ";
		next;
		mes " - ^424242如果我不回来，她就会忘记。在我走进光芒前，娜琳的声音从身后回荡而来。^000000 - ";
		next;
		mes "[Narin]";
		mes "我会记住的……请回来。求你了，哥哥……！";
		next;
		if (select( "点头并回艾尔帕兰。", "点头并转身。" ) == 2) {
			mes " - ^424242我带着微笑转过身。牵着双手的娜琳吃了一惊，朝这边望来。^000000 - ";
			next;
			mes "[Narin]";
			mes "啊？不回去吗？";
			next;
			unittalk getcharid(3), "" + strcharinfo(0) + "：看来你还需要我。你叫我了吗？我没听清，能再说一遍吗？", bc_self;
			mes "[Narin]";
			mes "喂！";
			setquest 16115;	// Talk with girl
			completequest 16115;	// Talk with girl
			close;
		}
		mes " - ^424242我点了点头，想起现在放在心口的厚重碎片。港口的海风从耳边吹过……^000000 - ";
		setquest 16115;	// Talk with girl
		completequest 16115;	// Talk with girl
		close2;
		warp "alberta",219,31;
		end;
	}
	mes " - ^424242现在我站在熟悉的光芒前。我轻轻向娜琳挥手，她闭上眼睛，双手合十。^000000 - ";
	next;
	mes " - ^424242双手空空，我想起留在心中的厚重而温暖的碎片。^000000 - ";
	next;
	if (select( "回艾尔帕兰。", "留在这里。" ) == 2) {
		mes " - ^424242我带着微笑转过身。牵着双手的娜琳吃了一惊，朝这边望来。^000000 - ";
		next;
		mes "[Narin]";
		mes "啊？不回去吗？";
		next;
		unittalk getcharid(3), "" + strcharinfo(0) + "：看来你还需要我。你叫我了吗？我没听清，能再说一遍吗？", bc_self;
		mes "[Narin]";
		mes "嘿！";
		close;
	}
	mes " - ^424242我还会回来的。我把双手合在胸前。^000000 - ";
	next;
	mes " - ^424242意识逐渐远去，艾尔帕兰港咸涩而略带鱼腥的气味撩过鼻尖。^000000 - ";
	close2;
	warp "alberta",219,31;
	end;
}

tur_d03_i,139,186,3	script	Girl#illtur01	4_F_NARIN,{
	if (checkweight(1201,1) == 0) {
		mes "[Girl]";
		mes "你背着这么重的包在做什么？清理掉一些东西吧。";
		close;
	}
	if (ill_turtle == 0)
		end;

	.@account_id = getcharid(3);
	.@player_name$ = strcharinfo(0);

	if (ill_turtle == 1) {
		mes "[Girl]";
		mes "又来了……陌生人。";
		mes "你又把那个带来了。";
		npctalk "女孩：那块碎片。", "", bc_self;
		next;
		emotion ET_PROFUSELY_SWAT, .@account_id;
		unittalk .@account_id, "" + .@player_name$ + "：你是谁？这块碎片做了什么？我在哪里？我是怎么来到这里的？", bc_self;
		mes "[Girl]";
		mes "你有很多问题，但没必要知道。";
		next;
		npctalk "女孩：你不需要知道。你不该在这里。有些事情你不应该知道。", "", bc_self;
		mes "[Girl]";
		mes "但^0000CD这里有一个和你一样的人^000000，一个不该在这里的人。";
		mes "和^0000CD那个蓝头发的学者^000000一起回去。你认识他吗？";
		next;
		select( "我是来找他的。", "你认识考古学家莱芬吗？" );
		mes "[Girl]";
		mes "很好。我不知道他的名字和所在位置，但可以猜到。";
		mes "^0000CD有两个地点^000000。去找到他并带走。不要再回来。";
		next;
		switch( select( "好，但我有一些问题。", "我怎么相信你？", "告诉我回去的路。" ) ) {
		case 1:
			unittalk .@account_id, "" + .@player_name$ + "：你是谁？你怎么认识他？我在哪里？", bc_self;
			mes "[Girl]";
			mes "你会永远消失。没必要知道。";
			next;
			specialeffect EF_DETECT3;
			sleep2 1000;
			specialeffect2 EF_DETECT3;
			specialeffect2 EF_CIRCLEPOWER8;
			sleep2 500;
			unittalk .@account_id, "" + .@player_name$ + "：呃，那是什么？？", bc_self;
			mes "[Girl]";
			mes "这是一个能暂时保护你的法术。";
			mes "它会跟着你。好奇心会害死猫。不要探究不清楚的事情。不要回头，也不要在背后议论别人。";
			next;
			mes "[Girl]";
			mes "^FF0000不要因为自己的呼吸方式奇怪而惊慌。^000000";
			unittalk .@account_id, "" + .@player_name$ + "：你是什么意思？", bc_self;
			ill_turtle = 2;
			erasequest 16096;	// To the unknown tortoise island
			setquest 16097;	// Stranger on Turtle Island 1
			setquest 16098;	// Stranger on Turtle Island 2
			setquest 16099;	// Stranger on Turtle Island 3
			close;
		case 2:
			emotion ET_THINK;
			mes "[Girl]";
			mes "我不知道。我不知道你从哪里来，又怎么会知道？";
			next;
			mes "[Girl]";
			mes "不过，那扇空荡荡的门……也许藏着什么，你可能会知道。";
			next;
		mes " - ^424242女孩望向自己身后的方向。仔细一看，黑洞前似乎漂浮着红色的东西。去看看吧。^000000 - ";
			close;
		case 3:
			emotion ET_THINK;
			mes "[Girl]";
			mes "......";
			next;
			mes "[Girl]";
			mes "回去吧。这里很危险。";
			next;
		mes " - ^424242女孩简短地说完便不再开口。她看起来很悲伤……^000000 - ";
			close;
		}
	}
	if (ill_turtle < 8) {
		mes "[Girl]";
		mes "……你还活着？";
		next;
		mes "[Girl]";
		mes "在你遇到危险之前，找到你要找的人，然后离开。";
		close;
	}
	if (ill_turtle == 8) {
		mes "[Girl]";
		mes "你们两个都安全了。";
		mes "……抱歉让你陷入危险。";
		sleep2 500;
		unittalk .@account_id, "" + .@player_name$ + "：没事，教授。", bc_self;
		sleep2 2000;
		cloakoffnpcself( "Archeologist Leiphen#illtur01" );
		emotion ET_SWEAT, getnpcid(0,"Archeologist Leiphen#illtur01");
		npctalk "考古学家莱芬：……哦，我还以为我要死了。", "Archeologist Leiphen#illtur01", bc_self;
		next;
		mes "[Girl]";
		mes "那么，回去吧。回到你来的地方。";
		mes "忘掉一切。";
		next;
		npctalk "考古学家莱芬：我怎么能忘记这个地方！？", "Archeologist Leiphen#illtur01", bc_self;
		mes "[Archeologist Leiphen]";
		mes "咦？你是什么意思？我还会再回来的。";
		mes "直到查明这里所有的秘密。";
		next;
		mes "[Girl]";
		mes "你为什么无视我的警告？傲慢。";

	mes "我已经写好了";
	mes "你的推荐信。";
	mes "那么，完成这项任务后";
	mes "我们再见。";
		next;
	mes "^3355FF你收到了大主教的推荐信。^000000";
		close2;
		cutin "",255;
		set ra_tem_q,15;
		set lost_boy,14;
		setquest 8100;
		end;
	}
	else if ((ra_tem_q == 15) || (ra_tem_q == 16)) {
		mes "[泽德大主教]";
		mes "收集到^FF000040 40 个冰冻之心^000000后，";
		mes "把它们和我为你写的推荐信";
		mes "一起交给守卫教皇办公室的士兵。";
		next;
		mes "[泽德大主教]";
		mes "准备前往教皇办公室时，";
		mes "从小教堂向西走到神殿中央，";
		mes "入口就在那里。";
	}
	else if (ra_tem_q == 17) {
		mes "[泽德大主教]";
		mes "啊，非常感谢你替我陪教皇一会儿。";
		mes "我看得出来，她很享受和你交谈。";
		next;
		mes "[泽德大主教]";
		mes "不过我很好奇……";
		mes "我们的教皇不习惯和外人交谈，";
		mes "所以我猜你和她谈过后";
		mes "也有自己的疑问……";
		next;
		select("嗯，她确实提到了圣地……");
		cutin "ra_gman2",2;
		mes "[泽德大主教]";
		mes "什么……？！";
		mes "她提到了圣地……？！";
		next;
		cutin "ra_gman",2;
		mes "[泽德大主教]";
		mes "圣地是所有人，包括教皇，都被禁止进入的地方。";
		mes "过去我们曾允许人们参观，但……";
		next;
		mes "[泽德大主教]";
		mes "现在只有神明可以进入那里。听着，";
		mes "如果其他神父询问你和教皇的谈话，";
		mes "请不要提及圣地。";
		next;
		mes "[泽德大主教]";
		mes "请不要问我为什么，";
		mes "但相信我，你必须装作不知道圣地的存在！";
		next;
		mes "[？？？？]";
		mes "打扰了，泽德？";
		mes "能和你谈一会儿吗？";
		mes "我有私事想和你谈……";
		next;
		cutin "ra_gman2",2;
		mes "[泽德大主教]";
		mes "呃，当然可以！";
		mes "失陪一会儿……";
		mes "你等我的时候，去隔壁房间休息吧。";
		mes "别忘了：没有圣地。";
		close2;
		cutin "",255;
		select("好的。");
		set ra_tem_q,18;
		warp "ra_temin",297,156;
		end;
	}
	else if (ra_tem_q == 18) {
		mes "[泽德大主教]";
		mes "抱歉，我们的谈话还没结束。";
		mes "你先去那边的房间等着休息吧。";
		changequest 8101,8102;
		close2;
		cutin "",255;
		warp "ra_temin",297,156;
		end;
	}
	else if (ra_tem_q == 19) {
		mes "[泽德大主教]";
		mes "抱歉让你等了这么久，我有重要事情要讨论。";
		mes "现在，看你的表情就知道你有急事想问。";
		next;
		select("询问贝肯托");
		cutin "ra_gman2",2;
		mes "[泽德大主教]";
		mes "贝肯托？啊，你一定和妮伦大主教谈过了。";
		mes "只有她会这样称呼我。";
		mes "你看，我的全名是泽德·贝肯托。";
		next;
		cutin "ra_gman",2;
		mes "[泽德大主教]";
		mes "说到这个……";
		mes "妮伦有没有问你什么，";
		mes "或告诉你什么不同寻常的事情？";
		next;
		mes "^3355FF你犹豫了一会儿，";
		mes "把和妮伦大主教的谈话告诉了泽德。^000000";
		next;
		mes "[泽德大主教]";
		mes "嗯，我明白了。";
		mes "是的，听起来确实像她会做的事。";
		mes "之后我会解释一切，但现在我需要休息。";
		mes "你知道，我已经老了。";
		next;
		cutin "ra_gman2",2;
		mes "[泽德大主教]";
		mes "啊，不过在你离开前，我要警告你：";
		mes "不要^FF0000靠近圣地^000000。重复一遍，离圣地远点。";
		next;
		mes "^3355FF圣地……";
		mes "泽德大主教为什么如此坚决地保护圣地？";
		mes "不管怎样……如果我想去那里，就去吧。谁能阻止我？^000000";
		close2;
		cutin "",255;
		set ra_tem_q,20;
		changequest 8103,8104;
		end;
	}
	else if ((ra_tem_q >= 20) && (ra_tem_q < 22)) {
		cutin "ra_gman2",2;
		mes "[泽德大主教]";
		mes "无论你做什么、去哪里，";
		mes "请务必远离圣地！";
		next;
		mes "^3355FF现在，你比以往任何时候都更想进入圣地。^000000";
	}
	else if (ra_tem_q == 23) {
		cutin "ra_gman2",2;
		mes "[泽德大主教]";
		mes "哦，是你。让我猜猜……";
		mes "我说了那么多之后，你还是去圣地了，对吧？唉……";
		next;
		select("发生什么事了吗？");
		cutin "ra_gman",2;
		mes "[泽德大主教]";
		mes "老实说，我暂时被停职了，但不用担心。";
		mes "这不是你的错。反正我和其他大主教冲突已经有一段时间了。";
		next;
		mes "[泽德大主教]";
		mes "请别担心。如果不是这件事，他们也会找别的方式攻击我。";
		mes "这只是时间问题。他们只是为了自身利益夸大了你的闯入。";
		next;
		cutin "ra_gman2",2;
		mes "[泽德大主教]";
		mes "我只希望阿鲁纳佩尔兹安全和平。";
		mes "希望这片土地不会被贪婪的人类扭曲，一切都能遵循芙蕾雅的意志。";
		next;
		cutin "ra_gman",2;
		mes "[泽德大主教]";
		mes "啊，也请不要责怪妮伦。";
		mes "她的行为一定有自己的理由。";
		mes "她改变了很多，但我认为我们最终仍是朋友。";
		next;
		mes "[泽德大主教]";
		mes "还有最后一件事：";
		mes "尽量别让其他神父发现你做任何被禁止的事。";
		mes "那会让我有点尴尬，你明白的。";
		next;
		mes "[泽德大主教]";
		mes "不过你是被秘密邀请来的，";
		mes "我相信只有极少数人能认出你。";
		mes "最后你会按自己的意愿行事，对吧？";
		next;
		cutin "ra_gman2",2;
		mes "[泽德大主教]";
		mes "……我想我知道你在圣地看到了什么。";
		mes "我相信你有很多问题，但现在不是寻找答案的时候。";
		mes "请耐心等待。";
		next;
		mes "[泽德大主教]";
		mes "在合适的时机到来前，";
		mes "我希望你不要把在圣地看到的事情告诉任何人。";
		next;
		cutin "ra_gman",2;
		mes "[泽德大主教]";
		mes "那么，冒险者，谢谢你来这里。";
		mes "我现在需要躺下休息，";
		mes "请让我休息一会儿……";
		close2;
		set MISC_QUEST,MISC_QUEST | 8192;
		set ra_tem_q,0;
		cutin "",255;
		completequest 8105;
		specialeffect2 EF_ABSORBSPIRITS;
		if (checkre(3))
			getexp 90000,60000;
		else
			getexp 900000,600000;
		end;
	}
	else if (MISC_QUEST & 8192) {
		// Start Veins "Thor Volcano Base" Quest Addition
		if (rachel_camel == 25) {
			// Start Nameless Island Access Quest Addition
			if (aru_monas == 11) {
				cutin "ra_gman",2;
				mes "[泽德大主教]";
				mes "啊，好久不见，";
				mes "不是吗？你看起来不错，";
				mes "我也一切安好。今天我能为你做什么，"+strcharinfo(0)+"？";
				next;
				switch(select("我只是想来打个招呼。:询问维纳斯事故")) {
				case 1:
					mes "[泽德大主教]";
					mes "如你所知，我只是名义上的大主教，";
					mes "因为我的观点，在许多其他神父中失去了影响力。";
					next;
					mes "[泽德大主教]";
					mes "不过，只要善良的人愿意行动，";
					mes "我相信正义和善意终将战胜困扰神父们的腐败。";
					break;
				case 2:
					mes "[泽德大主教]";
					mes "维纳斯事故？";
					mes "我没听说过……如果你详细说说，";
					mes "也许我能多了解一些。";
					next;
					mes "^3355FF你把维纳斯逮捕走私犯的事情告诉了泽德大主教。^000000";
					next;
					mes "[泽德大主教]";
					mes "哦，我之前好像听说过这件事。";
					mes "让我想想……对了，妮伦提到过他们的奇怪之处……";
					next;
					mes "[泽德大主教]";
					mes "走私犯和一名卢恩·米德加尔特王国的高官在一起，";
					mes "所以妮伦一度不敢对他们采取行动。";
					next;
					mes "[泽德大主教]";
					mes "我当时忙于其他事情，没有太在意。";
					mes "你为什么不去和妮伦谈谈？";
					mes "我相信她能告诉你更多情况。";
					set aru_monas,12;
					changequest 17007,17008;
					next;
					mes "[泽德大主教]";
					mes "如果你决定去见妮伦，请代我向她问好。";
					break;
				}
			}
			// End Nameless Island Access Quest Addition.
			else if (aru_vol == 0) {
				cutin "ra_gman",2;
				mes "[泽德大主教]";
				mes "啊，再次见到你让我很高兴。";
				mes "像你这样愿意为世界和平努力的冒险者很少见。希望你明白这一点。";
				next;
				mes "["+strcharinfo(0)+"]";
				mes "嗯……？";
				mes "别这样夸我！";
				mes "这么说有点过头了，不是吗？";
				emotion ET_OHNO, playerattached();
				next;
				mes "[泽德大主教]";
				mes "一点也不。事实上，我相信女武神已经为你在英灵殿安排了位置。";
				mes "现在，我能帮你什么，朋友？";
				next;
				select("火山中的神秘建筑");
				mes "["+strcharinfo(0)+"]";
				mes "其实，我想问问你是否知道维纳斯附近托尔火山内部的这座设施。";
				mes "那里似乎正在发生大事。";
				next;
				mes "^3131FF你把托尔火山中被锁住的孩子，以及隐藏建筑的事情告诉了泽德大主教。";
				mes "泽德大主教似乎被你的话触动了。^000000";
				next;
				mes "[泽德大主教]";
				mes "我明白了。我对正在发生的事有所怀疑。";
				mes "你知道阿鲁纳佩尔兹由我们的教会统治，";
				mes "全国都信仰芙蕾雅女神。";
				next;
				mes "[泽德大主教]";
				mes "领导这个国家的神父分为两大派系。";
				mes "我属于温和派，通常与狂热的强硬派发生冲突。";
				next;
				mes "[泽德大主教]";
				mes "这些强硬派神父只要认为这是芙蕾雅的意志，";
				mes "就会毫不犹豫地使用暴力。";
				mes "他们在托尔火山建立了军事营地。";
				next;
				mes "[泽德大主教]";
				mes "当然，它也被称为地质营地，";
				mes "因为他们一直在那里监测火山活动。";
				mes "但实际上，他们是在训练士兵战斗。";
				next;
				mes "[泽德大主教]";
				mes "想到这一点让我害怕，但我确信";
				mes "他们在营地里藏有大量军事物资和大规模杀伤性机器。";
				next;
				mes "["+strcharinfo(0)+"]";
				mes "等等，他们究竟想通过战斗实现什么？";
				mes "使用暴力又要如何帮助芙蕾雅女神？";
				next;
				mes "[泽德大主教]";
				mes "所有神父都认为重组尤弥尔之心能够复活芙蕾雅。";
				mes "如你所知，碎片散落在世界各地，其中一些由卢恩·米德加尔特王国持有。";
				next;
				mes "[泽德大主教]";
				mes "为了避免冲突，温和派神父决定聘请科学家复制尤弥尔之心，";
				mes "最终制作出了那件神器的仿制品。";
				next;
				mes "["+strcharinfo(0)+"]";
				mes "尤弥尔之心的仿制品？";
				mes "我想我知道一位来自施瓦尔茨瓦德共和国的著名科学家";
				mes "曾经在研究这个！让我想想，他叫……";
				next;
				mes "["+strcharinfo(0)+"]";
				mes "那位科学家的名字是不是……";
				input .@input$;
				mes "^3131FF"+.@input$+"^000000?";
				next;
				if (.@input$ == "Varmunt") {
					mes "[泽德大主教]";
					mes "哦，你听说过他？";
					mes "是的，他叫瓦尔蒙特。";
					mes "遗憾的是，他故意将尤弥尔之心仿制品毁成碎片，";
					mes "然后消失了。";
					next;
				}
				else {
					mes "[泽德大主教]";
					mes ""+.@input$+"？";
					mes "不，不是他。";
					mes "制作尤弥尔之心仿制品的人叫瓦尔蒙特。";
					mes "他确实是个天才。";
					next;
				}
				mes "[泽德大主教]";
				mes "我不知道瓦尔蒙特发生了什么。";
				mes "我只知道施瓦尔茨瓦德共和国发生了严重事件，";
				mes "而他在那场混乱中消失了。真奇怪……";
				next;
				mes "[泽德大主教]";
			mes "虽然能够正常运作的尤弥尔之心仿制品";

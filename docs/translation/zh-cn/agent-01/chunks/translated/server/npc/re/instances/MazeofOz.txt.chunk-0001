// Step 8
1@oz,61,163,5	script(DISABLED)	Imril#ozmd6	4_EP18_IMRIL,{
	end;

OnStart:
	'mob_count_oz = 0;
	.@npc_name$ = instance_npcname("Imril#ozmd6");
	monster 'map_name$,64,164,"Ash Toad",21295,1, .@npc_name$ + "::OnMobDead"; // EP18_ASH_TOAD
	monster 'map_name$,62,161,"rake hand",21296,1, .@npc_name$ + "::OnMobDead"; // EP18_RAKEHAND
	end;

OnMobDead:
	'mob_count_oz++;
	if ('mob_count_oz < 2)
		end;
	if ('event_oz != 7)
		end;
	'event_oz = 8;

	.@maram8$ = instance_npcname("Maram#ozmd8");
	.@imril6$ = instance_npcname("Imril#ozmd6");
	.@miriam5$ = instance_npcname("Miriam#ozmd5");
	.@maggi6$ = instance_npcname("Maggi#ozmd6");
	.@mark6$ = instance_npcname("Mark#ozmd6");
	.@tamarin6$ = instance_npcname("Tamarin#ozmd6");

	setpcblock PCBLOCK_NPC, true;

	cloakoffnpcself( .@maram8$ );
	npctalk "伊姆里尔：谢谢！我差点死了！", .@imril6$;
	sleep2 2000;
	npctalk "伊姆里尔：这里的气氛很不寻常，不要下楼。", .@imril6$;
	sleep2 2000;
	npctalk "米丽娅姆：感觉比上次更常看到怪物了。", .@miriam5$;
	sleep2 2000;
	npctalk "伊姆里尔：那些人又是谁？", .@imril6$;
	cloakoffnpcself( .@maggi6$ );
	cloakoffnpcself( .@mark6$ );
	cloakoffnpcself( .@tamarin6$ );
	sleep2 2000;
	npctalk "玛拉姆：他们是偶尔帮助我母亲工作的冒险者。", .@maram8$;
	sleep2 2000;
	npctalk "玛拉姆：他们值得信任，不用这么警惕。", .@maram8$;
	sleep2 2000;
	npctalk "伊姆里尔：听说你太容易相信别人。", .@imril6$;
	sleep2 2000;
	npctalk "米丽娅姆：是的。", .@miriam5$;
	sleep2 2000;
	npctalk "玛拉姆：总之，在更多怪物出现前赶紧逃走吧。", .@maram8$;
	sleep2 2000;
	npctalk "玛拉姆：已经所剩不多了。", .@maram8$;
	sleep2 2000;
	npctalk "玛拉姆：虽然很难看清，但沿着这里的路继续走就行！", .@maram8$;
	sleep2 2000;
	npctalk "塔玛琳：我觉得是这条路！", .@tamarin6$;

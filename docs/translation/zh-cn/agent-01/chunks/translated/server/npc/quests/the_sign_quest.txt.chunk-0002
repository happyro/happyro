		mes "‘被拒绝者被遗弃的城镇。’";
		mes "这是什么意思，";
		mes "又会在哪里呢……？";
		mes "真是令人费解。";
	}
	else if (sign_q < 98) {
		mes "我相信‘被拒绝者";
		mes "居住的城镇’一定有特殊含义，";
		mes "但我无法解开";
		mes "这个小谜语的答案……";
		mes "到底是什么意思呢？";
		mes "我还想不明白。";
	}
	else if ((sign_q > 100) && (sign_q < 105)) {
		mes "安格尔波达……？！";
		mes "传说中，她的灵魂被分成碎片，";
		mes "并藏在众神制造的封印之后！";
		mes "这就是传说的真相吗？";
		next;
	mes "[梅茨]";
		mes "你需要一把坚固、沉重";
		mes "或非常锋利的武器。";
		mes "当然，我听说这种武器";
		mes "十分稀有……";
		mes "不是普通武器能够替代的。";
		next;
	mes "[梅茨]";
		mes "据说普通铁匠甚至无法";
		mes "锻造这种稀有武器。";
		mes "但如果你能得到一把，";
		mes "也许就有机会打破封印。";
		mes "请务必小心使用。";
		mes "那是非常危险的力量。";
		next;
	mes "[梅茨]";
		mes "当然，我也担心释放安格尔波达";
		mes "可能会违背众神的意志，";
		mes "但我们已经走到这一步了……";
		mes "现在回头也太迟了。";
		mes "只能继续调查下去。";
	}
	else if (sign_q < 137) {
		mes "我想你已经";
		mes "快要成功了。";
		mes "我们所有的努力";
		mes "很快就会开花结果！";
	}
	else if (sign_q == 137) {
		mes "就是这个……！";
		mes "你把‘神圣之符’带来了！";
		mes "我终于证明了它的存在！";
		mes "请把它交给我处理，";
		mes "之后再回来吧~";
		delitem 7314,1; //The_Sign
		set sign_q,138;
		set .@stime_s,gettime(DT_HOUR);
		if (.@stime_s < 1) set sign_sq,1;
		else if (.@stime_s < 3) set sign_sq,2;
		else if (.@stime_s < 5) set sign_sq,3;
		else if (.@stime_s < 7) set sign_sq,4;
		else if (.@stime_s < 9) set sign_sq,5;
		else if (.@stime_s < 11) set sign_sq,6;
		else if (.@stime_s < 13) set sign_sq,7;
		else if (.@stime_s < 15) set sign_sq,8;
		else if (.@stime_s < 17) set sign_sq,9;
		else if (.@stime_s < 19) set sign_sq,10;
		else if (.@stime_s < 21) set sign_sq,11;
		else set sign_sq,12;
	}
	else if (sign_q == 138) {
		set .@stime_s1,gettime(DT_HOUR);
		if (.@stime_s1 < 1) {
			if (sign_sq == 11) {
				set .@pass_s,1;
			}
		}
		else if (.@stime_s1 < 3) {
			if (sign_sq == 12) {
				set .@pass_s,1;
			}
		}
		else if (.@stime_s1 < 5) {
			if (sign_sq == 1) {
				set .@pass_s,1;
			}
		}
		else if (.@stime_s1 < 7) {
			if (sign_sq == 2) {
				set .@pass_s,1;
			}
		}
		else if (.@stime_s1 < 9) {
			if (sign_sq == 3) {
				set .@pass_s,1;
			}
		}
		else if (.@stime_s1 < 11) {
			if (sign_sq == 4) {
				set .@pass_s,1;
			}
		}
		else if (.@stime_s1 < 13) {
			if (sign_sq == 5) {
				set .@pass_s,1;
			}
		}
		else if (.@stime_s1 < 15) {
			if (sign_sq == 6) {
				set .@pass_s,1;
			}
		}
		else if (.@stime_s1 < 17) {
			if (sign_sq == 7) {
				set .@pass_s,1;
			}
		}
		else if (.@stime_s1 < 19) {
			if (sign_sq == 8) {
				set .@pass_s,1;
			}
		}
		else if (.@stime_s1 < 21) {
			if (sign_sq == 9) {
				set .@pass_s,1;
			}
		}
		else {
			if (sign_sq == 10) {
				set .@pass_s,1;
			}
		}
		if (.@pass_s == 1) {
			mes "真有趣……";
			mes "这是用米德加尔特之外的材料制成的！";
			mes "看这个蓝色透镜，";
			mes "它一定就是惊人力量的来源！";
			mes "难以置信。";
			mes "这件物品非常重要。";
			next;
	mes "[梅茨]";
			mes "我发现透镜周围的符文控制着";
			mes "吉芬塔和吉芬喷泉的某种封印。";
			mes "但有了这件物品，封印应该就能被打破……";
			next;
	mes "[梅茨]";
			mes "我……我想你甚至可以用它";
			mes "进入英灵殿。";
			mes "这件物品的力量";
			mes "或许还有其他用途……";
			mes "但我还需要继续研究。";
			next;
	mes "[梅茨]";
			mes "我只能想到一个";
			mes "能够处理它的人：";
			mes "恩格尔·霍华德，";
			mes "米德加尔特最优秀的";
			mes "铁匠。";
			mes "去找他吧。";
			set sign_q,139;
			set sign_sq,0;
			getitem 7314,1; //The_Sign
		}
		else {
			mes "抱歉，我还在研究";
			mes "你借给我的遗物。";
			mes "能再给我一点时间吗？";
			mes "我会尽快完成研究。";
			mes "请耐心等待。";
		}
	}
	else if (sign_q < 141) {
		mes "你去找过";
		mes "恩格尔·霍华德了吗？";
		mes "只有他能为你解开";
		mes "神圣之符的力量……";
		mes "快去找他吧。";
	}
	else if (sign_q == 141) {
		if (countitem(2644) == 1) {
				mes "啊，你终于来了。";
				mes "我一直在等你。首先，";
				mes "再次感谢你一直以来的帮助。";
				mes "你辛苦了。";
				mes "我非常感激。";
			next;
	mes "[梅茨]";
				mes "多亏了你，我证明神圣之符存在的愿望";
				mes "终于实现了。";
				mes "现在它的力量归你所有，";
				mes "你可以随意使用。";
				mes "请好好保管它。";
			next;
	mes "[梅茨]";
				mes "你或许曾经怀疑过，";
				mes "但我很高兴确认神圣之符确实存在。再次感谢你，希望你偶尔来找我聊聊。";
			set sign_q,142;
			getexp (checkre(3))?200000:2000000,0;
		}
		else {
			mes "你去找过";
			mes "恩格尔·霍华德了吗？";
			mes "只有他能为你解开";
			mes "神圣之符的力量……";
			mes "请尽快去找他。";
		}
	}
	else if (sign_q == 201) {
			mes "你失败了？";
			mes "虽然令人失望，";
			mes "但我知道你已经尽力。";
			mes "让我感谢你";
			mes "付出的全部努力。";
			mes "你做得很好。";
		next;
	mes "[梅茨]";
			mes "虽然我必须收回呜咽的星光，";
			mes "但希望你收下这个作为谢礼。";
			mes "祝你旅途顺利，冒险者。";
			mes "愿你平安归来。";
			mes "谢谢你的帮助。";
			mes "请保重。";
		if (checkweight(7178,1) == 0) {
				next;
				mes "^3355FF请等一下！你现在携带的物品太多。";
				mes "请清理出更多背包空间后再回来。^000000";
				close;
		}
		delitem 7178,1; //Star's_Sob
		set sign_q,202;
		getexp (checkre(3))?10000:100000,0;
		getitem 617,1; //Old_Violet_Box
	}
	else if (sign_q > 201) {
		if (countitem(7178) == 1) {
			mes "对不起……";
			mes "但我要收回";
			mes "呜咽的星光。";
			mes "看来你并不适合";
			mes "承担这项任务……";
			mes "请不要再继续了。";
			next;
	mes "[梅茨]";
			mes "......";
			mes "再见。";
			delitem 7178,1; //Star's_Sob
		}
		else {
			mes "我想我不能责怪你，";
			mes "毕竟我也没有";
			mes "给你多少帮助……";
			mes "真的很抱歉。";
		}
	}
	else {
		mes "非常感谢你";
		mes "帮助我实现梦想。";
		mes "以后我们还可以";
		mes "一起研究其他项目。";
		mes "我很期待。";
		next;
	mes "[梅茨]";
		mes "那么……";
		mes "祝你的旅途";
		mes "一帆风顺，勇敢的"+ strcharinfo(0) +"。";
		mes "后会有期。";
	}
	close2;
	cutin "mets_alpha",255;
	end;
}

prt_in,228,26,5	script	Steward#sign	55,{
	callfunc "F_UpdateSignVars";
	mes "[万德兹]";
	if (sign_q < 3) {
		mes "欢迎来到";
		mes "布雷德宅邸。";
		mes "有什么可以帮您的吗？";
		next;
		switch(select("没什么。:我来见梅茨。:把钱交出来！")) {
		case 1:
	mes "[万德兹]";
			mes "如果你没有任何事情要";
			mes "与梅茨大师商谈，";
			mes "请立即离开。";
			mes "这里不欢迎闲人。";
			close;
		case 2:
	mes "[万德兹]";
			mes "好的，"+((Sex == SEX_MALE)?"先生。":"女士。");
			mes "请稍等片刻，";
			mes "我去书房请示大师。";
			mes "请在这里等候。";
			close;
		case 3:
	mes "[万德兹]";
			mes "很抱歉，";
			mes "但我坚持要求你";
			mes "^FF0000立即^000000离开这里。";
			mes "不要再回来打扰。";
			mes "不要再打扰我们。";
			close2;
			percentheal -30,0;
			warp "prontera",150,150;
			end;
		}
	}
	else if (sign_q < 14) {
		mes "啊，"+ strcharinfo(0) +"大师。";
		mes "欢迎。今天有什么";
		mes "我可以帮忙的吗？";
		next;
		switch(select("阿里安是谁？:梅茨在做什么？:艾尔怎么样？")) {
		case 1:
	mes "[万德兹]";
			mes "啊，是阿里安。";
			mes "我觉得他是个寡言的人。";
			mes "而且他选择说出口的话，";
			mes "可以说相当严厉粗鲁。";
			mes "他不太容易亲近。";
			mes "不过本性应该不坏。";
			close;
		case 2:
	mes "[万德兹]";
			mes "虽然我为布雷德家族服务多年，";
			mes "却不了解梅茨大师的工作。";
			mes "很抱歉，我甚至无法理解";
			mes "他的研究……";
			mes "那实在太深奥了。";
			close;
		case 3:
	mes "[万德兹]";
			mes "啊，艾尔小姐";
			mes "从很小的时候起";
			mes "就在这里工作了。";
			mes "她对我来说就像孙女一样。";
			mes "哈哈——^333333*咳咳*^000000";
			mes "我很疼爱她。";
			close;
		}
	}
	else if (sign_q < 13) {
		mes "我记得阿里安大师";
		mes "前段时间来拜访过大师。";
		mes "他们整晚都在讨论";
		mes "与大师工作有关的事情。";
		mes "看起来非常认真。";
		mes "我也不敢打扰他们。";
		next;
	mes "[万德兹]";
		mes "天哪，听起来非常严重。";
		mes "‘古代力量’这个词，";
		mes "平时可不常出现在谈话里。";
		mes "不知道他们究竟发现了什么。";
		mes "真令人担心。";
		close;
	}
	else if (sign_q < 15) {
		mes "有时候我会担心艾尔小姐。";
		mes "她是普隆德拉最美丽的女孩之一，";
		mes "但一直没有男朋友。";
		mes "这让我有些担心。";
		mes "她值得遇到好人。";
		next;
	mes "[万德兹]";
		mes "很多男人都对她献殷勤，";
		mes "但她总能拒绝";
		mes "每一个追求者……";
		mes "真是让人捉摸不透。";
		close;
	}
	else if (sign_q < 20) {
		mes "最近有许多旅行者";
		mes "开始来拜访大师。";
		mes "看来他们是被我们张贴的";
		mes "告示牌吸引过来的。";
		mes "这里越来越热闹了。";
		next;
	mes "[万德兹]";
		mes "你要注意，";
		mes "别让别人夺走";
		mes "大师为你提供的机会。";
		mes "一定要好好把握。";
		mes "不要轻易放弃。";
		close;
	}
	else if (sign_q < 25) {
		mes "真奇怪，";
		mes "艾尔似乎把那个不修边幅的";
		mes "杰斯库里安当成了对手。";
		mes "女人真是难以理解……";
		mes "我完全搞不懂她们的想法。";
		mes "只能由她们自己解决了。";
		close;
	}
	else if (sign_q < 35) {
		mes "贪婪没有边界。";
		mes "赌博这种消遣";
		mes "似乎最能代表";
		mes "人类的贪婪。";
		next;
	mes "[万德兹]";
		mes "无论输赢，有些赌徒总能找到";
		mes "继续下去的理由，即使停手更明智。";
		mes "不过，人通常还是会听从内心，而不是理智……";
		mes "真是令人费解。";
		close;
	}
	else if (sign_q < 54) {
		mes "贝克兰是个年轻而";
		mes "聪明的人。虽然他继承了父亲的公司，";
		mes "但要延续父亲的成功，";
		mes "仍然需要自己的才能。";
		mes "他确实很有能力。";
		next;
	mes "[万德兹]";
		mes "贝克兰还能进一步拓展自己的事业，";
		mes "真是令人惊叹。";
		mes "当然，梅茨大师";
		mes "也为贝克兰的成功";
		mes "提供了帮助……";
		mes "他们关系很好。";
		close;
	}
	else if (sign_q == 54) {
		mes "哦，恭喜你~";
		mes "你终于通过了所有测试。";
		mes "我知道那些测试一定";
		mes "非常辛苦，也很有挑战性。";
		mes "你做得很棒。";
		next;
	mes "[万德兹]";
		mes "梅茨大师告诉我，他希望你";
		mes "找到能够修复呜咽的星光的人。";
		mes "祝你完成这项任务。";
		mes "愿你好运。";
		mes "不要放弃。";
		mes "我会为你祈祷。";
		close;
	}
	else if (sign_q == 97 || sign_q == 98) {
		mes "虽然人类都会犯错，";
		mes "但有些时候绝不能失败。";
		mes "你必须坚持到底。";
		mes "这就是考验。";
		next;
	mes "[万德兹]";
		mes "总会有一些情况，";
		mes "让你无法获得第二次机会。";
		mes "总之，记住这一点。";
		mes "不要错过机会。";
		mes "保持谨慎。";
		close;
	}
	else {
		mes "总会有一些情况，";
		mes "让你无法获得第二次机会。";
		mes "总之，记住这一点。";
		mes "不要错过机会。";
		mes "保持谨慎。";
		close;
	}
}

prt_in,248,23,3	script	Maid#sign	1275,{
	end;

prt_in,248,23,0	script	Maid#sign2	111,{
	callfunc "F_UpdateSignVars";
	mes "[艾尔]";
	if (sign_q < 3) {
		mes "你、你在梅茨大师的";
		mes "房间里做什么？请立即离开！";
		mes "这里不是你该来的地方。";
		mes "快走！";
		close;
	}
	else if (sign_q < 14) {
		mes "哦……？";
		mes ""+ strcharinfo(0) +"?";
		mes "有什么事情";
		mes "我可以帮你吗？";
		next;
		if (Sex == SEX_MALE) {
			switch(select("以后一起喝咖啡吗？:告诉我梅茨的事。")) {
			case 1:
	mes "[艾尔]";
				mes "...?";
				mes "*脸红~*";
				mes "哦~ 你、你是在";
				mes "约我";
				mes "约会吗？";
				next;
	mes "[艾尔]";
				mes "这个嘛~";
				mes "我有没有时间和你出去呢？";
				mes "嗯，如果你真的很体贴，";
				mes "也许可以考虑一下。";
				mes "不过先让我想想。";
				mes "到时候再回答你。";

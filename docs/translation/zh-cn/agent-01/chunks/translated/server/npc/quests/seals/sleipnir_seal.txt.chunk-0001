yuno,164,200,4	script	Noyee#G	101,{
	if (BaseLevel < 70) {
		mes "[Noyee]";
		mes "你知道从 NPC 商店购买的铠甲，和狩猎怪物获得的铠甲之间有什么区别吗？";
		next;
		mes "[Noyee]";
		mes "区别就在于铠甲上^3355FF插槽^000000的数量。";
		next;
		mes "[Noyee]";
		mes "同种铠甲的防御力相同。不过，有插槽的铠甲可以插入怪物卡片，为铠甲增加额外效果。";
		next;
		mes "[Noyee]";
		mes "怪物卡片和带插槽的铠甲都很少从怪物身上掉落，因此是十分珍贵的物品。";
		close;
	}
	else {
		if ($God1 >= $@god_check2) {
			mes "[Noyee]";
			mes "你知道从 NPC 商店购买的铠甲，和狩猎怪物获得的铠甲之间有什么区别吗？";
			next;
			mes "[Noyee]";
			mes "区别就在于铠甲上^3355FF插槽^000000的数量。";
			next;
			mes "[Noyee]";
			mes "同种铠甲的防御力相同。不过，有插槽的铠甲可以插入怪物卡片，为铠甲增加额外效果。";
			next;
			mes "[Noyee]";
			mes "怪物卡片和带插槽的铠甲都很少从怪物身上掉落，因此是十分珍贵的物品。";
			close;
		}
		else {
			mes "[Noyee]";
			mes "你知道吗，朱诺有个非常有趣的地方，";
			mes "看起来有点像实验室。";
			next;
			mes "[Noyee]";
			mes "不过没人能确定它到底是不是实验室。最近那里流传着许多传闻，但我也不知道是真是假。";
			close2;
			if (god_sl_1 == 0) {
				set god_sl_1,1;
			}
		}
	}
}

que_god01,98,98,4	script	Manager#G	69,{
	if (checkweight(908,500) == 0) {
		mes "^3355FF等一下！你现在携带的物品太多了。把一些物品存进卡普拉仓库后再回来吧。^000000";
		close;
	}
	if (BaseLevel < 70) {
		mes "[Cukure]";
		mes "真不敢相信最近工作这么忙。我连见朋友或购物的时间都没有。";
		next;
		mes "[Cukure]";
		mes "等等……！";
		mes "我甚至想不起上次";
		mes "和男生约会是什么时候了！照这样下去，我还没找到男朋友就要退休了。不——我正值青春年华呢~！";
		emotion ET_PROFUSELY_SWEAT;
		close;
	}
	if ($God1 < $@god_check2) {
		if (god_sl_1 == 0) {
			mes "[Cukure]";
			mes "真不敢相信最近工作这么忙。我连见朋友或购物的时间都没有。";
			next;
			mes "[Cukure]";
			mes "等等……！";
			mes "我甚至想不起上次";
			mes "和男生约会是什么时候了！照这样下去，我还没找到男朋友就要退休了。不——我正值青春年华呢~！";
			emotion ET_PROFUSELY_SWEAT;
			close;
		}
		else if (god_sl_1 == 1) {
			mes "[Cukure]";
			mes "我们研究很久以前诸神遗留下来的神器。更具体地说，我们对诸神使用过的工具感兴趣。";
			next;
			mes "[Cukure]";
			mes "最近研究组里除了负责人以外的许多成员都离开了，所以现在人手不足。";
			next;
			mes "[Cukure]";
			mes "由于人手不足，我们无法继续大多数正在进行的研究项目。说到这个……";
			next;
			mes "[Cukure]";
			mes "你介意让我请";
			mes "像你这样的冒险者";
			mes "帮忙进行研究吗？";
			next;
			mes "[Cukure]";
			mes "我们不会拿你做实验，只是需要你帮忙跑些简单的腿。当然会给你报酬。";
			next;
			switch(select("我有点忙……:好啊，为什么不呢？")) {
			case 1:
				mes "[Cukure]";
				mes "哦，我明白了。";
				mes "如果你遇到适合做临时研究助理的人，能推荐给我们吗？";
				next;
				mes "[Cukure]";
				mes "很抱歉要拜托你这些，但希望你能理解，我们现在真的";
				mes "非常缺人。";
				close;
			case 2:
				cutin "god_kukur02",2;
				mes "[Cukure]";
				mes "真的吗~？！";
				mes "太好了！";
				mes "哈哈哈哈哈！听到这个消息";
				mes "我真高兴！";
				next;
				mes "[Cukure]";
				mes "进去和里面的调查员谈谈。他们都忙得不可开交，肯定需要你的帮助。";
				next;
				mes "[Cukure]";
				mes "哦，等等……";
				mes "我给你一张临时通行证。非常感谢";
				mes "你的帮助~";
				next;
				mes "^3355FF你获得了一张";
				mes "临时";
				mes "通行证。^000000";
				set god_sl_1,2;
				close2;
				break;
			}
		}
		else if (god_sl_1 < 10) {
			cutin "god_kukur03",2;
			mes "[Cukure]";
			mes "管理实验室真的很困难。竞争对手的实验室总想挖走我们的员工，或妨碍我们的研究进展。";
			next;
			mes "[Cukure]";
			mes "而且因为这份工作，我很难享受";
			mes "自己的私人生活……";
			next;
			cutin "god_kukur02",2;
			mes "[Cukure]";
			mes "哈哈哈哈……";
			mes "我在说什么呢？";
			mes "请忘了我刚才说的话。其实没什么大不了的。^333333*叹气……*^000000";
			close2;
		}
		else if (god_sl_1 < 50) {
			mes "[Cukure]";
			mes "啊，谢谢你";
			mes "帮助我们。";
			mes "希望你今后也能继续";
			mes "为我们提供帮助。";
			next;
			mes "[Cukure]";
			mes "虽然我们的研究员有些古怪，但他们都很友善，也没有恶意。";
			next;
			mes "[Cukure]";
			mes "所以如果他们中有人对你有些无礼，希望你能理解。";
			close2;
		}
		else if (god_sl_1 == 50) {
			cutin "god_kukur02",2;
			mes "[Cukure]";
			mes "啊……";
			mes "你真的帮了我们很多。谢谢你所做的一切。";
			next;
			mes "[Cukure]";
			mes "如你所知，我们正在研究能否重现诸神使用过的工具之一——‘斯雷普尼尔’。";
			next;
			mes "[Cukure]";
			mes "不过……";
			mes "目前看来还做不到，至少凭我们现有的技术不行。嗯……";
			next;
			mes "[Cukure]";
			mes "总之，我们会继续研究，希望有一天能实现重现斯雷普尼尔的目标。";
			next;
			mes "[Cukure]";
			mes "多亏了你，我们完成了对斯雷普尼尔的初步研究。现在可以规划更深入的研究了。";
			next;
			mes "[Cukure]";
			mes "差点忘了，这是你协助研究项目的报酬。请稍等";
			mes "一会儿……";
			next;
			mes "[Cukure]";
			mes "啊，在这里。";
			mes "虽然不算贵重，但希望你收下它，聊表谢意。旅途顺利！";
			if ($God1 < $@god_check2)
				set $God1,$God1+1;
			if ($God1 == $@god_check1)
				announce "[斯雷普尼尔]的第一道封印出现了。",bc_all;
			else if ($God1 == $@god_check2) {
				if ($God1 == $@god_check2 && $God2 == $@god_check2 && $God3 == $@god_check2 && $God4 == $@god_check2)
					announce "我们的封印与[斯雷普尼尔]的封印同时解除了。",bc_all;
				else
					announce "[斯雷普尼尔]的第一道封印解除了。",bc_all;
			}
			set god_sl_1,51;
			set .@god_treasure,rand(1,900);
			set .@god_treasure1,rand(1,1000);
			if (checkre(0)) {
				if (.@god_treasure < 101) {
					     if (.@god_treasure1 < 210) getitem 2102,1; //Guard_
					else if (.@god_treasure1 < 420) getitem 2104,1; //Buckler_
					else if (.@god_treasure1 < 630) getitem 2106,1; //Shield_
					else if (.@god_treasure1 < 840) getitem 2108,1; //Mirror_Shield_
					else getitem 2109,1; //Memorize_Book
				}
				else if (.@god_treasure < 201) {
					     if (.@god_treasure1 < 48) getitem 2207,1; //Fancy_Flower
					else if (.@god_treasure1 < 96) getitem 2210,1; //Hair_Band
					else if (.@god_treasure1 < 150) getitem 2213,1; //Cat_Hairband
					else if (.@god_treasure1 < 190) getitem 2215,1; //Flower_Hairband
					else if (.@god_treasure1 < 238) getitem 2217,1; //Biretta_
					else if (.@god_treasure1 < 290) getitem 2223,1; //Turban_
					else if (.@god_treasure1 < 340) getitem 2227,1; //Cap_
					else if (.@god_treasure1 < 348) getitem 2229,1; //Helm_
					else if (.@god_treasure1 < 400) getitem 2231,1; //Gemmed_Sallet_

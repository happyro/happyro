					else if (.@god_treasure1 < 496) getitem 2236,1; //Santa's_Hat
					else if (.@god_treasure1 < 544) getitem 2244,1; //Big_Sis'_Ribbon
					else if (.@god_treasure1 < 592) getitem 2245,1; //Sweet_Gents

-	script	Guard#ep133_11	492,{
	if (!isequipped(2782)) {
		mes "[Capital City Guard]";
		mes "����� �� ������?";
		mes "����� �� ����� ��..!";
		next;
		mes "- 无法与他沟通。-";
		close;	
	}
	if (ep13_3_invite < 5) {
		mes "[Capital City Guard]";
		mes "没有许可的其他种族不得进入城市。";
		mes "请回去。";
		close;
	}
	else if (ep13_3_invite == 5) {
		mes "[Capital City Guard]";
		mes "没有许可的其他种族不得进入城市。";
		mes "请回去。";
		next;
		mes "[Capital City Guard]";
		mes "嗯？你是人类。";
		mes "你通过那条隧道来到这里，是受到拉维尔邀请的吗？";
		next;
		select("是。");
		mes "[Capital City Guard]";
		mes "难怪维哈努斯批准了你。";
		mes "明白了。";
		mes "我批准你进入，并告诉你在埃尔迪卡斯特斯首先该做什么。";
		next;
		mes "[Capital City Guard]";
		mes "先进入要塞，";
		mes "在北方最高处的迪卡斯特斯迪尔登记自己。";
		mes "必须先登记，之后才能自由行动。";
		next;
		mes "[Capital City Guard]";
		mes "从这里向北走就能看到迪尔。";
		mes "不会迷路的。";
		mes "你需要在迪尔公共服务中心找到登记窗口。";
		close2;
		warp "dicastes01",199,41;
		end;
	}
	else if (ep13_3_invite > 5) {
		mes "[Capital City Guard]";
	mes "你要回埃尔迪卡斯特斯吗？";
		next;
	set .@m, select("是。去城堡。:否。") - 1;
		mes "[Capital City Guard]";
	mes "祝你好运。";
		close2;
		if (!.@m) warp "dicastes01",199,41;
		end;
	}
	mes "[Capital City Guard]";
	mes "发生未知情况。案例：" + strnpcinfo(2);
	mes "请联系 GM 咨询。";
	close;
}

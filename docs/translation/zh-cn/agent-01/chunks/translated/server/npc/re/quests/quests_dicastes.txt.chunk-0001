dic_dun01,284,102,5	script	Dirty Vigilante#ep13_3	450,{
	if (!isequipped(2782)) {
		mes "[Vigilante]";
		mes "����� �� �����󢤡��� �� ������ �� �С���.";
		mes "����� �� ����� ��..! ";
		next;
		mes "一句话也听不懂。";
		close;
	}
	if (ep13_3_secret < 6) {
		mes "[Vigilante]";
		mes "嘿！这里不是你这种新手该来的地方。";
		mes "那些蝎子会把你抓走！";
		close;
	}
	if (countitem(6437)) {
		mes "[Vigilante]";
		mes "你需要从洞穴里拿什么吗？";
		next;
		if (select("是。:否。") == 1) {
			mes "[Vigilante]";
			mes "呃，这是什么味道？";
			mes "小心。其他蝎子闻到了蝎子分泌物的气味。";
			next;
			if (select("喷洒香水后进入。:太危险，不进入。") == 1) {
				if (!countitem(6437)) {
					mes "- 你的蝎子香水消失了。-";
					close;
				}
				mes "[Vigilante]";
				mes "好。那祝你好运。小心。";
				delitem 6437,1; //Scaraba_Perfume
				close2;
				warp "dic_dun03",101,142;
				end;
			}
		}
		mes "[Vigilante]";
		mes "请让开，这里很危险。";
		mes "你不知道那些蝎子什么时候会暴走。";
		close;
	}
	mes "[Vigilante]";
		mes "呼，发生什么了？！它们为什么全在我身上？";
	next;
	mes "[Vigilante]";
		mes "我掉进蝎子洞已经够倒霉了，还被这种可怕的^FF0000恶臭^000000浇了一身，现在头都开始疼了！";
	next;
	mes "- 警备员一边拍掉蝎子的痕迹，一边抱怨。";
	close;
}


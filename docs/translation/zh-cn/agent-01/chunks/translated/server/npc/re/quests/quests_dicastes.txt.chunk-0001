manuk,321,182,5	script	Entrance Manager#ep133	450,{
	if (!isequipped(2782)) {
		mes "[Average Galten]";
		mes "�����? �� ����...";
		mes "���� �� ?";
		mes "���..?";
		close;
	}
	if (ep13_3_invite >= 4) {
		mes "[Entrance Manager]";
		mes "你要去首都埃尔迪卡斯特斯吗？";
		next;
		if(select("是。:否。") == 2) {
			mes "[Entrance Manager]";
			mes "那下次请走隧道。";
			close; 
		}
		mes "[Entrance Manager]";
		mes "小心。";
		close2;
		warp "dic_dun01",33,212; 
		end; 
	}
	mes "[Entrance Manager]";
	mes "抱歉。";
	mes "你不是萨帕，所以不能通过。";
	close;
}

dic_dun01,266,113,5	script	Curious Sapha#ep13_3_	449,{
	if (!isequipped(2782)) {
		mes "[Curious Sapha]";
		mes "����� �� ��?";
		next;
		mes "- 一句话也听不懂。-";
		close;
	}
	mes "[Curious Sapha]";
	mes "你好？";
	next;
	switch(select("你在这里做什么？:购买研究物品。:你好！:我想帮助你的研究。")) {
	case 1:
		mes "[Curious Sapha]";
		mes "看到那边那个脏兮兮的警备员了吗？";
		next;
		mes "[Curious Sapha]";
		mes "他掉进蝎子洞后遭到了蝎子的攻击。";
		mes "即使周围还有其他人，他也是唯一被攻击的。";
		next;
		mes "[Curious Sapha]";
		mes "我想他是滑倒并沾上了女王蝎子的分泌物。我以为是意外，所以正在调查。";
		next;
		mes "[Curious Sapha]";
		mes "如果研究结果正确，蝎子对这种气味非常敏感。";
		mes "也可以说它们会因此发狂。简直像失去理智一样……";
		next;
		mes "[Curious Sapha]";
		mes "我来研究女王分泌物成分和蝎子之间的关系。";
		mes "所以我把它制成了方便携带的香水。";
		next;
		mes "[Curious Sapha]";
		mes "也许可以利用这款香水对蝎子的反应推进研究。";
		close;
	case 2:
		if (checkweight(1201,1) == 0) {
			mes "[Curious Sapha]";
		mes "你的物品栏似乎没有足够空间。";
			close;
		}
		if (MaxWeight - Weight < 2000) {
			mes "[Curious Sapha]";
		mes "你的包似乎已经太重了。";
			close;
		}
		mes "[Curious Sapha]";
		mes "你想买蝎子香水？带回家当礼物？";
		mes "嗯，这已经成了稀有香水。";
		next;
		mes "[Curious Sapha]";
		mes "我给你优惠价，每瓶 500 Zeny。不过，尽量别带着它进入蝎子洞。";
		mes "你要多少？最多可以买 100 瓶。";
		next;
		input .@input;
		set .@deal, 500 * .@input;
		if (.@deal == 0) {
			mes "[Curious Sapha]";
			mes "你改变主意了吗？";
			close; 
		}
		if (Zeny < .@deal) {
			mes "[Curious Sapha]";
			mes "你的钱不够。";
			close; 
		}
		mes "[Curious Sapha]";
		mes "要购买"+.@input+"瓶吗？";
		next;
		if(select("是:否") == 2) {
			mes "[Curious Sapha]";
			mes "你改变主意了吗？";
			close;
		}
		set Zeny, Zeny - .@deal;
		getitem 6437,.@input; //Scaraba_Perfume
		mes "[Curious Sapha]";
		mes "给你。蝎子可能会聚集到你身边，所以别在蝎子洞附近使用。";
		close;
	case 3:
		mes "[Curious Sapha]";
		mes "你好？你一定是旅行者。这里很危险，请从这条隧道离开。";
		close;
	case 4:
		mes "[Curious Sapha]";
		mes "你有有用的情报吗？";
		mes "请告诉我！";
		input .@str$;
		next;
		mes "[Curious Sapha]";
		mes "上面写着^0000FF"+.@str$+"^000000。";
		next;
		switch(rand(1,3)) {
		case 1:
			mes "[Curious Sapha]";
			mes "这是很棒的情报！";
			mes "我必须开始研究了。";
			close;
		case 2:
			mes "[Curious Sapha]";
			mes "我已经知道这个情报了，但还是非常感谢你特意赶来告诉我。";
			close;
		case 3:
			mes "[Curious Sapha]";
			mes "嗯……你这么认为吗？";
			mes "我对你的情报有些怀疑。我会再想想。";
			close;
		}
	}
}

sec_in02,16,43,5	script	Scaraba Dungeon Entrance	449,{
	callfunc "F_GM_NPC";
	mes "正在设置副本入口。";
	mes "密码正确后你就可以通过。";
	if (callfunc("F_GM_NPC",1854,0) == 1) {
		set ep13_3_secret,6;
		getitem 2782,1; //Ring_Of_Wise_King
		getitem 6437,2; //Scaraba_Perfume
		mes "设置完成";
	} else
		mes "密码错误";
	close;
}


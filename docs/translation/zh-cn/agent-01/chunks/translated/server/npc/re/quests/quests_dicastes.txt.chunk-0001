-	script	Vigilante#main	-1,{
	if (compare(strnpcinfo(0),"ep133_26")) {
		if (!isequipped(2782)) {
			mes "[Vigilante]";
			mes "����� �� ������?";
			mes "������ �� ������ �� �С���...";
			next;
		mes "警备员说了些什么，然后摇了摇头。";
		mes "他坚定地把盾牌挡在身前，看起来是拒绝的反应。";
			close;
		}
		mes "[Vigilante]";
	mes "曼努克就在前面。";
	mes "你要去曼努克吗？";
		next;
		if (select("是。:否。") == 1) {
			mes "[Vigilante]";
			mes "我会把你送到曼努克。";
			close2;
			warp "manuk",326,180;
			end;
		}
		mes "[Vigilante]";
		mes "祝你好运。";
		close;
	}
	if (!isequipped(2782)) {
		mes "[Vigilante]";
		mes "����� �� ������?";
		mes "������ �� ������ �� �С���...";
		mes "����� �� ����� ��..! ";
		next;
		mes "无法与他沟通。";
		close;
	}
	if (ep13_3_secret < 6) {
	mes "下面的区域很危险，禁止进入。";
	mes "你是客人，所以我不能让你通过。";
	mes "请沿着隧道前往首都。";
		close;
	}
	mes "[Vigilante]";
	mes "你需要从洞穴里拿什么吗？";
	next;
	if (select("是。:否。") == 1) {
		mes "[Vigilante]";
		mes "小心。";
		close2;
		warp "dic_dun02",101,142;
		end;
	}
	mes "[Vigilante]";
	mes "请让开，这里很危险。";
	mes "你不知道那些蝎子什么时候会暴走……";
	close;

}

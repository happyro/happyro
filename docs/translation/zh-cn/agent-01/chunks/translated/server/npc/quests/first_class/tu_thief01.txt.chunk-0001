// Thief Trainer
//============================================================
moc_ruins,66,164,4	script	Thief Trainer#T	4_M_02,{
	mes "[Yierhan]";
	if(Class == Job_Novice){
		mes "嗯……？";
		mes "初心者？";
		mes "还在考虑";
		mes "要选择什么职业……";
		mes "我说得对吗？";
		next;
		mes "[Yierhan]";
		mes "听着，如果你决定成为盗贼——我得说，这是明智选择——来找我谈谈。我会教你入门！";
		close;
	}
	else if (BaseClass == Job_Thief && Upper != 2) {
		if (Class != Job_Thief && tu_thief01 < 8) {
			mes "你在这里做什么？";
			mes "我没什么能教你的！";
			mes "你已经远远超过我了！";
			next;
			mes "[Yierhan]";
			mes "事实上，我觉得你有资格";
			mes "教我一些东西！";
			mes "来吧！我需要新招式！";
			close;
		}
		if(tu_thief01 == 0){
		mes "嘿，伙计。";
		mes "我是伊尔汉。";
		mes "我负责";
			mes "训练新盗贼。";
			next;
			switch(select("Training?:Training? Right now?")){
			case 1:
				mes "[Yierhan]";
				mes "对，训练。有些人天生就会这些，但其他人需要更多帮助。所以这是‘以防万一’的训练。";
				next;
				break;
			case 2:
				mes "[Yierhan]";
			mes "现在？";
			mes "对，现在！";
			mes "不过如果你还没准备好，我可以等。";
				close;
			}
			mes "[Yierhan]";
			mes "好，首先盗贼使用近战攻击，大多数人如此。也有少数喜欢远程弓箭。但我们都擅长速度！";
			next;
			mes "[Yierhan]";
			mes "近战攻击中，哪个属性会提高伤害？如果没跳过初心者训练场，你应该知道。";
			next;
			switch(select("^6B8E23INT^000000:^2F4F2FSTR^000000:^23238EDEX^000000")){
			case 1:
				mes "[Yierhan]";
			mes "你说什么？^6B8E23INT^000000 影响魔法伤害、魔法防御和部分技能。盗贼根本不用魔法！";
				next;
				mes "[Yierhan]";
			mes "你肯定完全跳过初心者训练场了！不过我不怪你。总之，增加攻击伤害的是 ^2F4F2FSTR^000000，明白？";
				next;
				mes "[Yierhan]";
			mes "如果觉得伤害太低，可以把更多属性点投入 ^2F4F2FSTR^000000。STR 提高多少由你决定。";
				getexp 200,100;
				break;
			case 2:
				mes "[Yierhan]";
			mes "没错！想提高伤害，就要把属性点投入 ^2F4F2FSTR^000000。提高 STR 也会增加";
			mes "最大负重上限。";
				next;
				mes "[Yierhan]";
				mes "如果觉得伤害太低，可以把更多属性点投入 ^2F4F2FSTR^000000。STR 提高多少由你决定。";
				next;
				mes "[Yierhan]";
			mes "当然，^23238EDEX^000000 和 LUK 也能提高攻击伤害，但相比 STR 微不足道。我再说一次：^660000微不足道^000000。";
				getexp 400,200;
				break;
			case 3:
				mes "[Yierhan]";
			mes "你说什么？^23238EDEX^000000 影响的是命中率，不是伤害！除非使用弓。否则对伤害提升很小。";
				next;
				mes "[Yierhan]";
				mes "你肯定完全跳过初心者训练场了！不过我不怪你。总之，增加攻击伤害的是 ^2F4F2FSTR^000000，明白？";
				next;
				mes "[Yierhan]";
				mes "如果觉得伤害太低，可以把更多属性点投入 ^2F4F2FSTR^000000。STR 提高多少由你决定。";
				getexp 200,100;
			}
			tu_thief01 = 1;
			specialeffect2 EF_HIT5;
			close;
		}
		else if(tu_thief01 == 1){
			mes "好，属性就讲到这里。";
			mes "我来告诉你盗贼使用的技能。";
			next;
			mes "[Yierhan]";
			mes "去提升技能等级，想学的话再学几个新技能，";
			mes "然后回来这里。";
			tu_thief01 = 2;
			close;
		}
		else if(tu_thief01 == 2){
			mes "好，让我看看你的技能。你知道要根据技能调整战斗策略吧？技能和属性一样重要！";
			next;
			.@chk_th_skill1 = getskilllv("TF_DOUBLE");
			.@chk_th_skill2 = getskilllv("TF_MISS");
			.@chk_th_skill3 = getskilllv("TF_STEAL");
			.@chk_th_skill4 = getskilllv("TF_HIDING");
			.@chk_th_skill5 = getskilllv("TF_POISON");
			.@chk_th_skill6 = getskilllv("TF_DETOXIFY");

			if(.@chk_th_skill1 == 0 && .@chk_th_skill2 == 0 && .@chk_th_skill3 == 0 && .@chk_th_skill4 == 0 && .@chk_th_skill5 == 0 && .@chk_th_skill6 == 0){
				mes "[Yierhan]";
			mes "你还没学会任何技能？技能才是让你区别于初心者和其他人的关键！";
				close;
			}
			if(.@chk_th_skill1 > 0){
				mes "[Yierhan]";
			mes "啊，你学会了";
			mes .@chk_th_skill1+" 级二刀连击。";
			mes "不错！这个技能有机会在一次攻击中攻击两次，";
			mes "真厉害！";
				next;
				mes "[Yierhan]";
			mes "这是被动技能，始终生效且不消耗 SP。二刀连击等级越高，发动双重攻击的次数越多。";
				next;
			}
			if(.@chk_th_skill2 > 0){
				mes "[Yierhan]";
				mes "让我看看……";
				mes .@chk_th_skill2+" 级闪避提升？";
				mes "它会提高闪避率，让你更容易躲开敌人攻击。";
				next;
				mes "[Yierhan]";
				mes "和二刀连击一样，闪避提升是被动技能，不消耗 SP，始终生效。";
				mes "如果不想挨打，这就是你的技能。";
				next;
			}
			if(.@chk_th_skill3 > 0){
				mes "[Yierhan]";
				mes "哇，你学会了";
				mes .@chk_th_skill3+" 级偷窃～";
				mes "这就是赋予我们职业名称的技能！不过不能对人使用……";
				next;
				mes "[Yierhan]";
				mes "可以用偷窃从怪物身上拿走物品。幸运的话能得到好东西。偷窃不会影响怪物掉落率。";
				next;
			}
			if(.@chk_th_skill4 > 0){
				mes "[Yierhan]";
				mes "你学会了";
				mes .@chk_th_skill4+" 级隐匿？";
				mes "必须先将偷窃学到一定等级，才能学习隐匿。";
				next;
				mes "[Yierhan]";
				mes "当然，你可以使用";
				mes "在紧急情况下使用隐匿躲入地下，例如被强敌包围时。不过要小心……";
				next;
				mes "[Yierhan]";
				mes "无论藏得多好，某些怪物仍能找到你。甚至有怪物能把你从隐匿中逼出来！";
				next;
			}
			if(.@chk_th_skill5 > 0){
				mes "[Yierhan]";
				mes "好，我看你学会了";
				mes .@chk_th_skill5+" 级施毒。";
				mes "你喜欢危险，";
				mes "对吧？";
				next;
				mes "[Yierhan]";
				mes "这个攻击技能有机会让敌人中毒一段时间。中毒期间，敌人会持续损失 HP，防御也会降低。";
				next;
				mes "[Yierhan]";
				mes "不过要记住，如果怪物太强，也许无法让它中毒。别乱来。";
				next;
			}
			if(.@chk_th_skill6 > 0){
				mes "[Yierhan]";
				mes .@chk_th_skill6+" 级解毒。";
				mes "既然你费心学了它，";
				mes "一定是谨慎型的人吧。";
				next;
				mes "[Yierhan]";
				mes "学会施毒后才能学习解毒。解毒可以抵消目标身上的中毒效果。";
				next;
			}
			mes "[Yierhan]";
			mes "好吧，如果你想了解";
			mes "其他技能，";
			mes "我可以快速说明。";
			tu_thief01 = 3;
			getexp BaseLevel*30,BaseLevel*15;
			specialeffect2 EF_HIT5;
			close;
		}
		else if(tu_thief01 == 3){
			mes "那么……";
			mes "还有哪些技能";
			mes "想听解释，";
			mes "还是这些";
			mes "你已经知道了？";
			while(1){
				next;
				switch(select("Double Attack:Increase Dodge:Steal:Hiding:Envenom:Detoxify:I know enough.")) {
				case 1:
					mes "[Yierhan]";
					mes "顾名思义，";
					mes "二刀连击有机会让一次攻击打出两击。";
					next;
					mes "[Yierhan]";
					mes "这是被动技能，始终生效且不消耗 SP。二刀连击等级越高，发动双重攻击的次数越多。";
					.@read_d = 1;
					break;
				case 2:
					mes "[Yierhan]";
					mes "闪避提升";
					mes "会大幅提高";
					mes "其他职业没有的";
					mes "闪避率。";
					mes "能完全躲开时，何必";
					mes "硬挨攻击？";
					next;
					mes "[Yierhan]";
					mes "和二刀连击一样，闪避提升是被动技能，不消耗 SP，始终生效。";
					mes "如果不想挨打，这就是你的技能。";
					.@read_f = 1;
					break;
				case 3:
					mes "[Yierhan]";
					mes "偷窃是主动技能，有机会为你拿到";
					mes "免费物品！不过不能对其他人使用。";
					next;
					specialeffect2 EF_STEAL;
					mes "[Yierhan]";
					mes "可以用偷窃从怪物身上拿物品！幸运的话能得到好东西。偷窃不会影响怪物掉落率。";
					.@read_s = 1;
					break;
				case 4:
					mes "[Yierhan]";
					mes "隐匿是让你潜入地下的主动技能。只能隐藏一段时间，也无法移动，但有时总比被发现好！";
					next;
					mes "[Yierhan]";
					mes "当然，你可以在紧急情况下使用";
					mes "隐匿潜入地下，例如被强敌包围时。不过要小心……";
					next;
					mes "[Yierhan]";
					mes "无论藏得多好，某些怪物仍能找到你。甚至有怪物能把你从隐匿中逼出来！";
					.@read_p = 1;
					break;
				case 5:
					mes "[Yierhan]";
					mes "施毒是每个盗贼都该了解的攻击型主动技能。不过这只是我的看法。";
					next;
					mes "[Yierhan]";
					mes "这个攻击技能有机会";
					mes "让敌人在一段时间内中毒。中毒时会持续损失 HP，防御也会降低。";
					mes "记住这一点。";
					.@read_h = 1;
					break;
				case 6:
					mes "[Yierhan]";
					mes "既然盗贼擅长";
					mes "用毒造成伤害，";
					mes "我们也得有办法";
					mes "尝尝";
					mes "自己的药。";
					next;
					mes "[Yierhan]";
					mes "学会施毒后可以学习解毒。解毒能抵消目标身上的中毒效果。";
					.@read_r = 1;
					next;
					specialeffect2 EF_DETOXICATION;
					break;
				case 7:
					mes "[Yierhan]";
					mes "是啊……";
					mes "我也讲累了。接下来进入";
					mes "盗贼训练的下一部分……";
					next;
					mes "[Yierhan]";
					mes "既然你已经是技能专家，我要你提升技能等级后回来，明白？";
					tu_thief01 = 4;
					specialeffect2 EF_HIT5;
					.@total = .@read_d + .@read_f + .@read_s + .@read_p + .@read_h + .@read_r;
					if (.@total)
						getexp (.@total*300),(.@total*100);
					close;
				}
			}
		}
		else if(tu_thief01 == 4){
			mes "好，我们学习了技能，你也练习过了，对吧？最好是这样……";
			next;
			mes "[Yierhan]";
			mes "好，现在进行实战训练。你可以借此了解哪些技能适合哪些情况。";
			next;
			mes "[Yierhan]";
				mes "去给我带来";
			mes "10 根 ^ff0000鸟羽^000000。";
				mes "杀死波利鸟就能得到它们，应该不难。哦，用这个翅膀道具回来。";
			tu_thief01 = 5;
			savepoint "moc_ruins",80,164,1,1;
			getitem 602,1; //Wing_Of_Butterfly
			getexp 100,50;
			specialeffect2 EF_HIT5;
			close2;
			warp "moc_fild12",158,373;
			end;
		}
		else if(tu_thief01 == 5 || tu_thief01 == 6){
			if(countitem(916) < 10){
				mes "嘿，你没有我要求的 10 根 ^ff0000鸟羽^000000！要把学到的东西用起来，明白吗？";
				mes "现在快去做吧！";
				close2;
				warp "moc_fild07",203,38;
				end;
			}
			else {
				mes "好……！";
				mes "干得好，伙计。";
				mes "既然你拿到了这些羽毛，看来你真想成为优秀盗贼。";
				next;
				mes "[Yierhan]";
				mes "希望你继续努力，";
				mes "不断变得更好。";
				mes "永远全力以赴！哦，";
				mes "还有什么问题吗？";
				next;
				if(tu_thief01 == 6){
					switch(select("关于那些痕迹……:不了。")) {
 					case 1:
						mes "[Yierhan]";
					mes "你查到了，嗯？";
					mes "我本来不想告诉你，";
					mes "毕竟你只是个刚成为盗贼的新人，";
					mes "不过……";
						next;
						mes "[Yierhan]";
					mes "南部地区";
					mes "发生过一场";
					mes "战斗，";
						mes "这座城镇的。";
						next;
						mes "[Yierhan]";
						mes "因为发生在深夜，只有少数人知道。至于我，因为公会会议开到很晚，";
						mes "只是碰巧看到了。";
						next;
						mes "[Yierhan]";
						mes "我回到战斗发生的地方，找到痕迹，显示战斗的人向南去了。";
						next;
						mes "[Yierhan]";
						mes "战斗中使用了毒药，";
						mes "我猜有刺客参与，但不能确定。想调查的话，沿着战斗痕迹走。";
						next;
						mes "[Yierhan]";
						mes "呃，不过小心";
						mes "别靠毒药太近！";
						mes "那东西";
						mes "很强！";
						tu_thief01 = 8;
						getitem 1207,1; //Main_Gauche
						getexp 1000,500;
						specialeffect2 EF_HIT5;
						close;
					case 2:
						mes "[Yierhan]";
						mes "好！";
						mes "这样我就少点工作了！";
						mes "好，下次见面时你最好变强。哦，这些东西给你。毕竟你现在是个大盗了。";
						tu_thief01 = 7;
						getitem 1207,1; //Main_Gauche
						getexp 500,200;
						specialeffect2 EF_HIT5;
						close;
					}
				}
				else {
					switch(select("很高兴认识你。:不了。")) {
					case 1:
						mes "[Yierhan]";
						mes "是啊，一起行动很酷。继续这样与怪物战斗，";
						mes "你很快就会成为优秀盗贼。";
						next;
						mes "[Yierhan]";
						mes "而且我很喜欢你，";
						mes "小子，";
						mes "这个给你。";
						mes "拿去吧，它是你的！";
						getexp 500,200;
						break;
					case 2:
						mes "[Yierhan]";
						mes "好！";
						mes "这样我就少点工作了！";
						mes "好，下次见面时你最好变强。哦，这些东西给你。毕竟你现在已经是大盗了。";
						getexp 50,20;
						break;
					}
					tu_thief01 = 7;
					getitem 1207,1; //Main_Gauche
					specialeffect2 EF_HIT5;
					close;
				}
			}
		}
		else if(tu_thief01 == 7){
			mes "[Yierhan]";
			mes "你知道吗……";
			mes "这座城镇的南部";
			mes "曾经发生过";
			mes "一场战斗。";
			mes "就是这样。";
			next;
			mes "[Yierhan]";
			mes "因为发生在深夜，只有少数人知道。至于我，公会会议开到很晚，";
			mes "只是碰巧看到了。";
			next;
			mes "[Yierhan]";
			mes "我回到战斗发生的地方，找到痕迹，显示战斗的人向南去了。";
			next;
			mes "[Yierhan]";
			mes "战斗中使用了毒药，";
			mes "我猜有刺客参与，但不能确定。想调查的话，就沿着战斗痕迹走。";
			next;
			mes "[Yierhan]";
			mes "呃，不过小心，";
			mes "别靠毒药太近！";
			mes "那东西";
			mes "很强！";
			next;
			mes "[Yierhan]";
			mes "嘿，你可能会遇到毒药，记住：";
			mes "绿色药草和绿色药水";
			mes "可以抵抗毒素。还有，";
			mes "红色魔力矿石可以用于毒属性攻击。";
			mes "千万别忘了。";
			next;
			mes "[Yierhan]";
			mes "嘿，如果你决定去调查，";
			mes "一定要格外小心，";
			mes "那里很危险，";
			mes "明白了吗？";
			tu_thief01 = 8;
			getexp 200,100;
			specialeffect2 EF_HIT5;
			close;
		}
		else if(tu_thief01 == 8){
			mes "嘿，朋友。";
			mes "最近还好吗？";
			next;
			mes "[Yierhan]";
			mes "与未知的东西战斗总是很危险。";
			mes "听说附近有外来者炫耀力量，你最好小心。";
			next;
			mes "[Yierhan]";
			mes "冒险时保持谨慎总是明智的。小心怪物，";
			mes "也要小心人类！明白了吗？";
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//

		mes "嗯？！";
		mes "你是谁？打扰我的练习！";
		mes "滚开！";
		close;
	}
	switch(gunst)
	{
		case 0:
			mes "[Vanessa]";
			mes "哈！呀！！";
			mes "无限制格斗！桑博！";
			mes "摔跤！泰拳！";
			mes "潘克拉辛！自由搏击！";
			mes "我要掌握世上所有格斗流派！！";
			next;
			mes "[Vanessa]";
			mes "嗯？";
			mes "你是枪手，对吧？";
			mes "为什么打扰我的锻炼，";
			mes "还站在我旁边？";
			next;
			mes "["+strcharinfo(0)+"]";
			mes "只是看着训练";
			mes "就很开心……";
			mes ".............";
			next;
			mes "[Vanessa]";
			mes "哦！你喜欢武术？";
			mes "过来～我给你来个";
			mes "十字固～";
			next;
			mes "["+strcharinfo(0)+"]";
			mes "不、不用了～";
			mes "没关系～";
			next;
			mes "[Vanessa]";
			mes "什么没关系～";
			mes "过来～！";
			mes "-Bam!Bam!-";
			next;
			mes "["+strcharinfo(0)+"]";
			mes "啊～呃～别这样～";
			mes "啊……啊啊啊～～！！";
			mes "呃啊～";
			mes "-东西破碎的声音-";
			mes "好痛～～";
			mes "*Sobs*~~";
			next;
			mes "[Vanessa]";
			mes "嗯……是不是用力过猛了。";
			mes "嗯～";
			next;
			mes "["+strcharinfo(0)+"]";
			mes "当然了！";
			mes "笨蛋！笨蛋！！";
			mes "*sobs*~";
			next;
			mes "[Vanessa]";
			mes "嗯～嗯～";
			mes "对不起～";
			mes "好啦，好啦，";
			mes "别哭。";
			next;
			mes "["+strcharinfo(0)+"]";
			mes "*sob*~";
			next;
			mes "[Vanessa]";
			mes "好啦～好啦……";
			next;
			mes "["+strcharinfo(0)+"]";
			mes "*sob*~";
			next;
			mes "[Vanessa]";
			mes "住手！啊！";
			next;
			mes "["+strcharinfo(0)+"]";
			mes "........";
			next;
			mes "[Vanessa]";
			mes "好吧，好吧。";
			mes "抱歉发生了这种事";
			mes "如果你收集一些材料，";
			mes "我就为你制作武器……";
			next;
			mes "[Vanessa]";
			mes "我是凡妮莎·路易丝。";
			mes "原本是武术家申请者，";
			mes "但走错了路，";
			mes "被困在制作武器的工作里。";
			mes "天啊～哦我的天～我悲惨的人生～";
			next;
			mes "[Vanessa]";
			mes "现在说正题。";
			mes "我能制作的武器是";
			mes "叫做毁灭者。";
			next;
			mes "[Vanessa]";
			mes "我特意用";
			mes "自己在竞技场使用的招式命名。";
			mes "嘿嘿～";
			mes "拿去～！毁灭者～";
			next;
			mes "["+strcharinfo(0)+"]";
			mes "*抽泣*～请～停下～";
			next;
			mes "[Vanessa]";
			mes "啊，呃……抱歉……";
			mes "制作毁灭者之前";
			mes "需要材料。";
			next;
			mes "[Vanessa]";
			mes "需要相当多的物品，";
			mes "请仔细考虑。";
			next;
			mes "[Vanessa]";
			mes "怎么样？这种机会";
			mes "可不常见。";
			mes "要提出制作请求吗？";
			next;
			switch( select( "Maybe next time.","Okay.") )
			{
				case 1:
					mes "[Vanessa]";
					mes "嗯～是这样啊～";
					mes "这对你来说会是个机会。";
					mes "你会后悔的～";
					mes "下次见～";
					mes "拜～拜～";
					close;
           
				case 2:
					mes "[Vanessa]";
					mes "嗯，好吧。";
					mes "制作毁灭者，";
					mes "需要 50 个废铁板";
					mes "5 Oridecons, 70 Rusty Old Screws";
					mes "和 100,000 Zeny 的费用。";
					mes "必须带来准确材料。明白？";
					set gunst,1;
					close;
			}

		case 1:
			callsub SubDestroyer;
			
		case 2:
			mes "[Vanessa]";
			mes "哦～你回来了？";
			mes "最近怎么样？";
			mes "商店里有新物品。";
			mes "选一个吧。";
			next;
			switch(select( "Destroyer","Slotted Destroyer","Cancel") )
			{
				case 1:
					mes "[Vanessa]";
					mes "是啊，不错。";
					mes "这是普通毁灭者。";
					mes "需要 50 个废铁板，";
					mes "5 Oridecons, 70 Rusty Old Screws,";
					mes "以及 100,000 Zeny 制作。";
					mes "必须带来正确数量的材料。";
					mes "要吗？";
					next;
					switch( select( "Maybe next time.","Okay.") )
					{
               					case 1:
							mes "[Vanessa]";
						mes "什么～来嘛";
						mes "有什么好考虑的？";
						mes "好吧，考虑一下";
						mes "再回来……";
							close;
							case 2:
							callsub SubDestroyer;
					}
							
				case 2:
					mes "[Vanessa]";
					mes "哦～带洞毁灭者～";
					mes "和普通毁灭者不同，";
					mes "我要你找一件我正在收集的稀有物品。";
					mes "然后我会把它给你。";
					next;
					mes "[Vanessa]";
					mes "我在寻找一把 Finger[2]。";
					mes "还需要 5 个奥里德根。";
					mes "必须带来正确数量的材料。";
					mes "你还想要带洞毁灭者吗？";
					next;
					switch( select( "I'll think about it.","OK! I do!") )
					{
               					case 1:
							mes "[Vanessa]";
						mes "什么～来嘛";
						mes "有什么好考虑的？";
						mes "好吧，考虑一下";
						mes "再回来……";
							close;
			
						case 2:
							callsub SubDestroyer_;
			
					}
           
				case 3:
					mes "[Vanessa]";
					mes "嗯～是啊～";
					mes "慢慢来。";
					mes "也许你想和我切磋？";
					close;
			}
	}

SubDestroyer:

	if ((countitem(7319) < 50) || (countitem(7317) < 70) || (countitem(984) < 5))
	{
		mes "[Vanessa]";
		mes "没错，所需材料是 50 个废铁板，";
		mes "5 个神之金属、70 个生锈的老螺丝和 100,000 Zeny。";
		mes "记住必须带来正确数量。";
		close;
	}
	else if(Zeny < 100000)
	{
		mes "[Vanessa]";
		mes "你带来了足够材料，";
		mes "但费用是 100,000。";
		mes "记住这一点。";
		close;
	}
	else if(checkweight(13160,1) != 1)
	{
		mes "[Vanessa]";
		mes "即使我制作好了，你也无法携带。";
		mes "去清理一下背包。";
		close;
	}
	else
	{
		mes "[Vanessa]";
		mes "好～非常好～";
		mes "全部检查完毕～";
		mes "材料和 Zeny 都正好～";
		mes "这是我提前为你制作的毁灭者。";
		mes "好好使用。";
		set Zeny,Zeny-100000;
		delitem 7319,50;
		delitem 984,5;
		delitem 7317,70;
		getitem 13160,1;
		if(gunst == 1) set gunst,2;
		next;
		mes "[Vanessa]";
		mes "以后如果还需要，";
		mes "随时来找我～";
		mes "下次我会施展不同的徒手技巧。";
		close;
	}

SubDestroyer_:

	if ((countitem(1812) < 1) || (countitem(984) < 5))
	{
		mes "[Vanessa]";
		mes "没错，所需材料是 1 把 Finger[2]";
		mes "和 5 个奥里德根。";
		mes "记住，材料数量必须准确。";
		close;
	}
	else if(checkweight(13161,1) != 1)
	{
		mes "[Vanessa]";
		mes "你的背包没有空间。";
		mes "即使我制作好了，";
		mes "你也无法携带。";
		mes "清理背包后再回来。";
		close;
	}
	else
	{
		mes "[Vanessa]";
		mes "好～非常好～";
		mes "全部检查完毕～";
		mes "材料和 Zeny 都正好～";
		mes "这是我提前为你制作的带洞毁灭者。";
		mes "好好使用。";
		delitem 1812,1;
		delitem 984,5;
		getitem 13161,1;
		next;
		mes "[Vanessa]";
		mes "以后如果还需要，随时来找我～";
		mes "下次我会施展不同的徒手技巧。";
		close;
	}
}

que_ng,149,178,4	script	Lab Director	744,{

	if(gun_na == 1){
		if(countitem(1043) > 999 && countitem(932) > 999){
			delitem 1043,1000;
			delitem 932,1000;
			set gun_na,2;
			mes "[N. A]";
			mes "啊，都在这里！我还担心";
			mes "没人能驾驭我制作的";
			mes "^ff0000屠夫^000000呢！";
			next;
			mes "[N. A]";
			mes "好，我把 ^ff0000屠夫^000000 给你。";
			mes "不过我们不免费工作，";
			mes "需要收取费用。";
			mes "此外，你还需要获得";
			mes "塞莲娜女士允许使用屠夫的许可。";
			next;
			mes "[N. A]";
			mes "获得许可后，支付 100,000 Zeny 费用，";
			mes "我就把屠夫交给你。";
			close;
		}else{
			mes "[N. A]";
			mes "你找到 ^ff00001000 个兽人之爪^000000 和 ^ff00001000 个骷髅骨^000000 了吗？";
			mes "如果觉得太难，";
			mes "可以选择放弃。";
			next;
			if(select("I'm not giving up!:I give up...") == 1){
				mes "[N. A]";
				mes "好吧，我相信你。";
				mes "祝你好运。";
				close;
			}else{
				mes "[N. A]";
				mes "你要放弃吗？";
				mes "我承认考试很难，但如果连考试都无法通过，";
				mes "就无法驾驭这把武器。";
				mes "以后可以回来再次挑战。";
				set gun_na,0;
				close;
			}
		}
	}
	else if(gun_na == 2){
		mes "[N. A]";
		mes "我已经得到塞莲娜女士";
		mes "允许你使用";
		mes "屠夫。支付 100,000 Zeny 后即可使用。";
		mes "现在要支付吗？";
		next;
		if(select("Nope.:Yeah.") == 1){
			mes "[N. A]";
			mes "好吧。我等你带钱回来。";
			close;
		}else{
			if(Zeny < 100000){
				mes "[N. A]";
				mes "嗯，你身上的钱不够。";
				mes "带钱回来，好吗？";
				close;
			}
			if(checkweight(13158,1) == 0){
				mes "[N. A]";
		mes "你的负重超限。";
				mes "就算我把武器给你，";
				mes "你也无法携带它。";
				mes "请清理你的背包。";
				close;
			}
			set Zeny,Zeny-100000;
			set gun_na,0;
			getitem 13158,1;

			mes "不，没关系。";
			mes "你也许没有成为枪手，但我觉得你成为了很棒的人。";
			next;
			mes "[Ingrid]";
		mes "真的吗？谢谢～";
		mes "我会尽力的。";
			next;
			mes "[Ingrid]";
		mes "制作地狱火枪，";
		mes "需要 100 个废铁板、10 个奥里德根、50 个生锈螺丝、100 个燃烧心脏和 200,000 Zeny。";
		mes "要制作吗？";
			next;
			switch( select( "I'll think about it.", "Yes, please." ) )
			{
				case 1:
					mes "[Ingrid]";
					mes "啊～我明白了。";
					mes "好吧，考虑一下。";
					mes "决定后再回来。";
					close;

				case 2:
					mes "[Ingrid]";
					mes "我明白了。";
					mes "再说一遍材料。";
					next;
					mes "[Inferno]";
					mes "制作地狱火枪，需要 100 个废铁板、10 个奥里德根、50 个生锈旧螺丝、100 个燃烧心脏和 200,000 Zeny。";
					mes "必须带来正确数量的材料。";
					mes "请不要忘记。";
					set gun_inf,1;
					close;
			}

		case 1:
			callsub SubInferno;

		case 2:
			mes "[Ingrid]";
		mes "你好～你回来了～";
		mes "回来是因为需要地狱火枪吗？";
			next;
			switch( select( "Nah, I'm back just because..","Yes, make me an Inferno." ) )
			{
				case 1:
					mes "[Ingrid]";
					mes "啊～我明白了。";
					mes "好吧，考虑一下。";
					mes "决定后再回来。";
					close;

				case 2:
					callsub SubInferno;
			}
	}

SubInferno:
	if ((countitem(7319) < 100) || (countitem(7317) < 50) || (countitem(984) < 10) || countitem(7097) < 100)
	{
		mes "[Ingrid]";
		mes "没错，所需材料是 100 个废铁板、10 个奥里德根、50 个生锈旧螺丝、100 个燃烧心脏和 200,000 Zeny。";
		mes "必须带来正确数量的材料。";
		mes "请不要忘记。";
		close;
	}
	else if(Zeny < 200000)
	{
		mes "[Ingrid]";
		mes "你带来了足够材料，";
		mes "但带够 Zeny 了吗？";
		mes "制作地狱火枪的价格是 200,000 Zeny。";
		mes "请不要忘记。";
		close;
	}
	else if(checkweight(13162,1) != 1)
	{
		mes "[Ingrid]";
		mes "你携带的物品太多，无法拿走我的作品，所以我不能交给你。";
		mes "准备好接收后再来找我吧。";
		close;
	}
	else
	{
		mes "[Ingrid]";
		mes "看来你带来了正确数量的材料和 Zeny。";
		mes "这是我为你制作的地狱火枪。";
		mes "好好使用。";
		set Zeny,Zeny-200000;
		delitem 7319,100;
		delitem 984,10;
		delitem 7317,50;
		delitem 7097,100;
		getitem 13162,1;
		if(gun_inf == 1) set gun_inf,2;
		close;
	}
}

que_ng,185,180,3	script	Vanessa	726,{

	if(BaseJob != Job_Gunslinger)
	{

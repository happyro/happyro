//===== rAthena Script ======================================= 
//= Warlock Job Quest
//===== By: ================================================== 
//= Muad_Dib, Gepard & L0ne_W0lf
//===== Current Version: ===================================== 
//= 1.5
//===== Compatible With: ===================================== 
//= rAthena Project
//===== Description: ========================================= 
//= [Official Conversion]
//= Job change Quest from Wizard / High Wizard -> Warlock.
//===== Additional Comments: ================================= 
//= 1.0 First version. [Masao]
//= 1.1 Fixed some conversion mistakes, replaced numbers with
//=     constants, added item names in comments.
//= 1.2 Fixed the problem where NPC are not enabled and chamber
//=     will never open for the second try or use.
//= 1.2a Fixed a typo. [Euphy]
//= 1.3 Updated script, optimized. [Euphy]
//= 1.3a Added temporary coordinate fix #distorted_space_1-1. [Euphy]
//= 1.3b Added official coordinates. [Euphy]
//= 1.4 Added GM management function. [Euphy]
//= 1.5 Added VIP features. [Euphy]
//============================================================

-	script	#distorted_space_	-1,{
OnTouch_:
	if (job_wl > 1) {
		mes "- 这里有奇怪的扭曲 -";
		if (strnpcinfo(0) == "#distorted_space_1" && (Class == Job_Warlock || Class == Job_Warlock_T || Class == Job_Baby_Warlock)) {
			close2;
			if (countitem(6153) > 0)
				warp "spl_in02",79,102;
			end;
		}
		next;
		switch(select("伸出手。:无视它。")) {
		case 1:
			mes "- 我伸出手臂，耳边响起激烈的声音，凉爽的波浪包围了我 -";
			close2;
			warp "spl_in02",79,102;
			end;
		case 2:
			mes "- 你无视了扭曲。-";
			close;
		}
	}
	if (BaseLevel > 94 && (strnpcinfo(0) == "#distorted_space_2" || BaseJob == Job_Wizard)) {
		mes "- 这里有奇怪的扭曲 -";
		next;
		switch(select("搜索周围。:无视它。")) {
		case 1:
			mes "- 这里似乎什么也没有。但我确实能感觉到周围有什么……-";
			next;
			switch(select("伸出手臂。:别管它。")) {
			case 1:
				mes "- 我伸出手臂，耳边响起激烈的声音，凉爽的波浪包围了我 -";
				close2;
				warp "spl_in02",79,102;
				end;
			case 2:
				mes "- 你决定不去管它。-";
				close;
			}
		case 2:
			mes "- 你无视了它。-";
			close;
		}
	}
	end;
}
//morocc,103,144,0	duplicate(#distorted_space_)	#distorted_space_1	139,1,1
morocc,95,132,0	duplicate(#distorted_space_)	#distorted_space_1	139,1,1
splendide,141,284,0	duplicate(#distorted_space_)	#distorted_space_2	139,1,1

function	script	F_Warlock	{
	mes "[助手]";
	mes "什么！！！人类！？";
	mes "你是怎么进来的？";
	mes "这里只有特殊大门才能连接！";
	next;
	mes "[助手]";
	mes "我不知道怎么回事……";
	mes "但我们应该在大师发现你之前离开……！";
	next;
	mes "[???]";
	mes "外面是什么声音？";
	mes "我警告过他们，我冥想时要保持安静。";
	next;
	mes "[助手]";
	mes "什么！？";
	mes "大师……";
	mes "没什么……";
	next;
	mes "[大师]";
	mes "哦~ 我面前竟然有个人类。";
	next;
	mes "[助手]";
	mes "哦，你说这个？";
	mes "我正要把它带出去。";
	next;
	mes "[大师]";
	mes "哟！！！";
	next;
	mes "[哟普]";
	mes "没错……！！";
	next;
	mes "[大师]";
	mes "你身后有传送门……这是幻觉吗？";
	next;
	mes "[哟普]";
	mes "对不起！！！";
	mes "是我的错……";
	next;
	mes "[大师]";
	mes "蠢货……";
	mes "等你把人类送走后，我再处理你。";
	next;
	mes "[大师]";
		mes "MushSartas Ir Cyamar";
		mes "UdenLo";
	if (BaseJob == Job_Wizard) {
		next;
		mes "- 绿发妖精吟唱着咒语。-";
		mes "- 我感觉某种特别的东西包围了我。-";
		specialeffect2 EF_DISPELL;
		next;
	mes "[大师]";
	mes "哦，真有意思。";
	mes "人类，你竟敢反抗我？";
		next;
		if (BaseLevel > 98 && JobLevel > 49) {
			select("我不确定。你是谁？");
	mes "[大师]";
			mes "我是^000077术士^000000的首领。";
			mes "‘^000077希拉·埃格诺莉亚^000000’。";
			mes "如果你是魔法师，最好记住我的名字。";
			next;
			select("什么是^000077术士^000000？");
	mes "[埃格诺莉亚大师]";
			mes "哦……你感兴趣吗？";
			next;
	mes "[埃格诺莉亚大师]";
			mes "^000077术士^000000是使用约顿海姆巨人魔法的人。";
			mes "没有其他词语可以准确描述。";
			next;
	mes "[埃格诺莉亚大师]";
			mes "只有强大的魔法才能说明一切。";
			next;
			select("我能成为术士吗？");
	mes "[埃格诺莉亚大师]";
			mes "你？";
			mes "你想成为术士？";
			mes "哈哈哈";
			next;
	mes "[埃格诺莉亚大师]";
			mes "你真有趣。";
			mes "人类想成为术士会很困难。";
			mes "强大的力量会侵蚀你脆弱的身体。";
			next;
	mes "[埃格诺莉亚大师]";
			mes "如果你敢面对死亡，就可以试着成为术士。";
			next;
				switch(select("我需要做什么？:取消。")) {
			case 1:
				if (VIP_SCRIPT) {
					callfunc "VIP_Third_Class";
					set job_wl,2;
					setquest 11106;
					next;
				}
	mes "[埃格诺莉亚大师]";
				mes "你是认真的吗？";
				mes "你渴望力量，对吧，人类。";
				next;
	mes "[埃格诺莉亚大师]";
				mes "变强的强烈渴望会让你的灵魂更加美丽。";
				next;
	mes "[埃格诺莉亚大师]";
				mes "不过，我需要确认你是否合格。";
				next;
	mes "[埃格诺莉亚大师]";
				mes "哟！";
				next;
	mes "[哟普]";
				mes "没错！！";
				next;
	mes "[埃格诺莉亚大师]";
				mes "把这个交给人类。";
				next;
	mes "[埃格诺莉亚大师]";
				mes "去和那个头发奇怪的家伙谈谈。";
				mes "他会告诉你该做什么。";
				set job_wl,2;
				setquest 11106;
				close;
			case 2:
	mes "[埃格诺莉亚大师]";
			mes "很好。";
			mes "你是人类，所以这个给你。";
				set job_wl,1;
				close2;
				warp "splendide",200,100;
				end;
			}
		}
	mes "[大师]";
		mes "你的等级还太低，根本没资格考虑这件事。";
	}
	close2;
	warp "splendide",200,100;
	end;
}

spl_in02,77,107,5	script	Assistant#Warlock1	446,{
	if (job_wl == 0) {
		callfunc "F_Warlock";
		end;
	} else if (job_wl == 1) {
	mes "[哟普]";
		mes "你……我们以前见过。";
		mes "你能想象我被大师训得有多惨吗？！";
		mes "如果你没事找我，就快走！";
		next;
		switch(select("离开。:留下。")) {
		case 1:
	mes "[哟普]";
			mes "别烦我……！";
			close2;
			warp "splendide",200,100;
			end;
		case 2:
	mes "[哟普]";
			mes "什么？！";
			mes "随你便……";
			mes "之后我的大师会处理你。";
			close;
		}
	} else if (job_wl == 2 || job_wl == 3) {
	mes "[哟普]";
		if (job_wl == 2) {
			mes "亲爱的，大师！我的马尾看起来很奇怪吗？！";
			mes "我可是花了很多时间打理它！";
			next;
	mes "[埃格诺莉亚大师]";
			mes "太吵了。";
			mes "我要冥想，";
			mes "照我说的做。";
			next;
	mes "[哟普]";
			mes "嗯……";
			mes "哦，对了！";
			next;
	mes "[哟普]";
			mes "嘿，人类！";
			mes "你想成为";
			mes "术士吗？";
			next;
		}
		if (SkillPoint != 0) {
			mes "首先，在继续之前使用掉所有剩余的职业技能点。";
			set job_wl,3;
			close;
		}
		mes "这是大师的决定，";
		mes "所以告诉我你的选择。";
		next;
	mes "[哟普]";
		mes "我们需要测试你的身体能否承受术士的力量。";
		mes "所以你要收集材料来证明自己。";
		next;
	mes "[哟普]";
		mes "请收集^000077闪耀水晶^000000和^000077巨大布拉迪姆碎片^000000。";
		next;
		callsub L_Quest,1;
		close;
	} else if (job_wl == 4) {
		if (countitem(6152) == 0 || countitem(6151) == 0)
			callsub L_Quest,0;
		else {
	mes "[哟普]";
			mes "我不能在这里进行任务。我需要去实验室。";
			mes "我的实验室位于斯普兰迪的西北部。";
		}
		close;
	} else if (job_wl == 5) {
	mes "[哟普]";
		mes "这块石头制作得很好。";
		mes "请去找我的大师。";
		close;
	} else {
	mes "[哟普]";
		mes "魔法室是用魔法材料创造的。";
		next;
	mes "[哟普]";
		mes "根据原材料和处理方式的不同，合成出的石头形态也不同。";
		next;
	mes "[哟普]";
		mes "但大多数石头都很相似！";
		mes "我们很难轻易区分它们。";
		next;
	mes "[哟普]";
		mes "就连我也不知道它究竟是如何运作的。";
		close;
	}

L_Quest:
	mes "[哟普]";
	mes "狩猎时必须佩戴这些魔法石戒指，才能获得这些物品。";
	mes "你需要佩戴戒指去猎杀纳迦和布拉迪姆魔像。";
	next;
	if (getarg(0)) {
	mes "[哟普]";
		mes "让我们看看你有多强。别忘了佩戴这个。";
		set job_wl,4;
		getitem 2796,1; //Magical_Stone
		getitem 2797,1; //Magical_Stone_
		changequest 11106,11107;
		next;
	}
	mes "[哟普]";
	mes "带着这些石头回来，否则你无法返回！";
	mes "小心！";
	next;
	mes "[哟普]";
	mes "和我大师在一起的那个人会让你出去，去和他谈谈。";
	next;
	mes "[哟普]";
	mes "我的实验室位于斯普兰迪的西北部。收集齐后把它们带给我。";
	return;
}

spl_in02,60,231,5	script	Yoop#Warlock	446,{
	mes "[哟普]";
	if (job_wl < 4) {
		mes "你是谁？";
		mes "离开这里！";
		close;
	} else if (job_wl == 4) {
		mes "你回来了？";
		next;
		switch(select("我带来了材料。:我弄丢了魔法石。:没什么。")) {
		case 1:
	mes "[哟普]";
			if (countitem(6152) == 0 || countitem(6151) == 0) {
				mes "......";
				mes "……在哪里？";
				mes "别烦我！";
				next;
	mes "[哟普]";
				mes "我们需要测试你的身体能否承受术士的力量。";
				mes "所以你要收集材料来证明自己。";
				next;
	mes "[哟普]";
				mes "请收集^000077闪耀水晶^000000和^000077巨大布拉迪姆碎片^000000。";
				next;
	mes "[哟普]";
				mes "狩猎时必须佩戴这些魔法石戒指，才能获得这些物品。";
				mes "你需要佩戴戒指去猎杀纳迦和布拉迪姆魔像。";
				next;
	mes "[哟普]";
				mes "带着这些石头回来，否则你无法返回！";
				mes "小心！";
				close;
			} else if (countitem(6152) && countitem(6151)) {
				if (isequipped(2796) || isequipped(2797)) {
				mes "把魔法石带回来给我。";
					close;
				}
				if (countitem(2796) == 0 || countitem(2797) == 0) {
				mes "看来你没有它？";
				mes "你弄丢了？";
					next;
	mes "[哟普]";
				mes "请找到那块石头后再回来找我。";
					close;
				}
			mes "好了！所有材料都准备好了！";
			mes "我会专心处理这块石头。你能回去找我的大师吗？";
			mes "完成后我会继续下一步。";
				delitem 2796,countitem(2796); //Magical_Stone
				delitem 2797,countitem(2797); //Magical_Stone_
				delitem 6152,countitem(6152); //Glittering_Crystal
				delitem 6151,countitem(6151); //Peice_Of_Great_Bradium
				set job_wl,5;
				changequest 11107,11108;
				close;
			}
		case 2:
	mes "[哟普]";
			mes "什么？！";
			mes "我不是让你再三确认并确保佩戴了吗！";
			next;
  mes "[哟普]";
			mes "请检查是不是放错地方，或者已经装备在身上了。";
			next;
			switch(select("我找到了。:没有。")) {
			case 1:
  mes "[哟普]";
				mes "别逗我！";
				mes "有没有佩戴，一眼就能看出来！";
				close;
			case 2:
				if ((isequipped(2796) == 0 && countitem(2796) == 0) || (isequipped(2797) == 0 && countitem(2797) == 0)) {
					if (countitem(732) > 0) {
						switch(select("给我 3 克拉钻石。:算了吧。")) {
						case 1:
  mes "[哟普]";
							mes "我就不追究你的过错了。";
							mes "请小心保管它。";
							delitem 732,1; //Crystal_Jewel__
							if (isequipped(2796) == 0 && countitem(2796) == 0)
								getitem 2796,1; //Magical_Stone
							if (isequipped(2797) == 0 && countitem(2797) == 0)
								getitem 2797,1; //Magical_Stone_
							close;
						case 2:
  mes "[哟普]";
						mes "证明你的诚意！";
							close;
						}
					}
  mes "[哟普]";
					mes "你怎么能这么说？";
					mes "^000077道歉就行了^000000！";
					mes "如果你给我一颗 3 克拉钻石，也许我能再给你一些石头……";
					close;
				}
  mes "[哟普]";
				if (isequipped(2796) || isequipped(2797)) {
					mes "请检查装备窗口……";
					mes "你确定自己没有吗？";
					close;
				}
				mes "那么你现在手里拿的是什么……？";
				close;
			}
		case 3:
  mes "[哟普]";
			mes "什么……？";
			mes "别烦我，我很忙。";
			close;
		}
	} else {
		mes "我正在专心冥想。";
		mes "这样才能创造魔法。";
		next;
  mes "[哟普]";
		mes "而且……你似乎比普通魔法师更有天赋。";
		mes "也许我成为炼金术士后，会比现在更厉害，你觉得呢？";
		next;
  mes "[哟普]";
		mes "我正在学习，让自己变得更强。";
		next;
  mes "[哟普]";
		mes "如果我进入‘时间与魔法之室’，就能追上你的力量！";
		mes "哈哈哈哈……";
		close;
	}
}

spl_in02,84,103,3	script	Assistant#Warlock2	439,{
	if (job_wl == 0) {
		callfunc "F_Warlock";
		end;
	} else if (job_wl == 1) {
	mes "[助手]";
		mes "人类！你想要什么？";
		close;
	} else if (job_wl < 6) {
	mes "[助手]";
		mes "你现在要找的不是我。";
		close;
	} else if (job_wl == 6) {
		if (checkweight(1201,1) == 0 || MaxWeight - Weight < 3500) {
			mes "你携带的物品太多了。";
			mes "最好减轻负重。";
			close;
		}
  mes "[哟普]";
		mes "测试没那么难。";
		mes "我们可以在魔法室里创造魔法石。";
		next;
  mes "[哟普]";
		mes "小心测试室里的魔物。";
		mes "这些是被术士魔法封印的彩虹红宝石。";
		mes "测试时使用它们。";
		next;
  mes "[哟普]";
		mes "我会带你进入魔法室。";
		set job_wl,7;
		changequest 11109,11110;
		getitem 12384,5; //Rainbow_Ruby_Water
		getitem 12386,5; //Rainbow_Ruby_Wind
		getitem 12387,5; //Rainbow_Ruby_Earth
		getitem 12385,5; //Rainbow_Ruby_Fire
		close2;
		warp "job3_war01",23,20;
		end;
	} else if (job_wl == 7) {

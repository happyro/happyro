morocc,156,70,3	script	Girl#sc00	93,3,3,{
	mes "[Girl]";
	if (BaseJob == Job_Rogue) {
		if (job_sha == 0) {
			if (BaseLevel < 99 || JobLevel < 50) {
				mes "你还没有准备好。";
				close;
			}
			mes "嘿？等等！";
			mes "你不想听个有趣的故事吗？";
			next;
			select("什么故事？");
			mes "[Girl]";
			mes "你最近去过公会吗？";
			mes "最近发生了一些有趣的事。";
			mes "也许有新客人……";
			next;
			mes "[Girl]";
			mes "听说和一种叫暗影追踪者的职业有关。";
			mes "你应该去看看。";
			next;
			mes "[Girl]";
			mes "他们每次来这里，似乎都在执行新任务。";
			mes "不知道他们究竟在做什么任务？";
			set job_sha,1;
			close;
		} else if (job_sha == 1) {
			mes "如果你感兴趣……就去吧！";
			mes "你知道公会在哪里吗？";
			next;
			mes "[Girl]";
			mes "它在帕罗斯灯塔下方的要塞里。";
			mes "唉……";
			mes "你一定要去那里看看！";
			close;
		} else {
			mes "哇，你看起来很忙。";
			mes "你听说有访客来了吗？";
			mes "他们正在寻找宝藏！";
			next;
			mes "[Girl]";
			mes "一定很有趣。";
			mes "我也想试试！";
			close;
		}
	}
	mes "嗯？";
	mes "我没什么东西给你……";
	close;
OnTouch_:
	if (BaseJob == Job_Rogue && BaseLevel > 98 && JobLevel > 49 && job_sha == 0) {
		mes "[Girl]";
		mes "嘿？等等！";
		mes "你不想听个有趣的故事吗？";
		close;
	}
	end;
}

in_rogue,376,100,5	script	Guild Member#sc01	828,{
	if (BaseJob == Job_Rogue) {
		if (job_sha < 2) {
			set @job_sha,0;
		OnDialogue:
			mes "[Vin]";
			mes "啊？这是什么？";
			mes "洛特，你知道这是什么意思吗？";
			next;
			mes "[Lotte]";
			mes "嗯，‘3847147298’，这是我唯一用过的……";
			mes "那么，他们为什么用数字给村子命名？";
			next;
			mes "[Lotte]";
			mes "维恩！这都是废话！";
			next;
			mes "[Vin]";
			mes "什么？";
			next;
			if (BaseLevel > 98) {
				mes "[Scary man]";
			mes "你好？";
				next;
				switch(select("我吗？:抱歉，我很忙……")) {
				case 1:
					mes "[Scary man]";
					mes "是的！就是你！";
					mes "让我自我介绍一下。";
					mes "我叫乌鲁帕。";
					mes "如果你感兴趣，可以过来一下吗？";
					if (@job_sha == 1) {
						set job_sha,1;
						set @job_sha,0;
					}
					close;
				case 2:
					mes "[Scary man]";
			mes "什么？你就这样放弃了？";
			mes "真令人失望……";
					close;
				}
			}
			mes "[Scary man]";
		mes "你应该自己解开这个谜题！";
		mes "但你还是太……弱了。";
			close;
		} else {
			mes "[Vin]";
		mes "是的……";
		mes "只要我敢拿到地图，迟早会自己解开……！";
			close;
		}
	} else if (Class == Job_Shadow_Chaser || Class == Job_Shadow_Chaser_T || Class == Job_Baby_Shadow_Chaser) {
		mes "[Vin]";
	mes "啊！这是暗影追踪者！";
	mes "真难以置信！";
	mes "不过看起来很眼熟，对吧？";
		next;
		mes "[Vin]";
	mes "嗯……";
		mes "..........";
	mes "天啊！我想不起来了……！";
		close;
	}
	mes "[Vin]";
	mes "啊？谁在那里？";
	mes "今天客人真多……";
	close;
}

in_rogue,379,99,1	script	Guild Member#sc02	747,{
	if (BaseJob == Job_Rogue) {
		if (job_sha < 2) {
			set @job_sha,1;
			doevent "Guild Member#sc01::OnDialogue";
			end;
		}
		mes "[Lotte]";
		mes "什么？";
		mes "该死……";
		next;
		mes "[Lotte]";
		mes "我讨厌数字！";
		close;
	} else if (Class == Job_Shadow_Chaser || Class == Job_Shadow_Chaser_T || Class == Job_Baby_Shadow_Chaser) {
		mes "[Lotte]";
		mes "哇！";
		mes "你就是那个人！";
		mes "真是聪明又成熟……";
		next;
		mes "[Lotte]";
		mes "暗影追踪者！";
		mes "哇，我什么时候才能成为暗影追踪者呢？";
		close;
	}
	mes "[Lotte]";
	mes "我不需要任何东西。";
	close;
}

in_rogue,379,101,3	script	Scary Man#sc03	810,{
	if (job_sha == 0) {
		if (BaseJob == Job_Rogue && BaseLevel > 98 && JobLevel > 49) {
			mes "[Scary man]";
		mes "哦，你很有才能嘛？";
		mes "现在我有一个有趣的问题！你想解开它吗？";
			next;
			mes "[Urupa]";
		mes "我叫乌鲁帕。";
		mes "如果你遇到有趣的问题，就来挑战它。";
			set job_sha,1;
			close;
		}
		mes "[Scary man]";
	mes "你有什么事？";
	mes "我和你没什么关系。";
	mes "我不关心你这样的人，只和非凡之人打交道。";
		close;
	} else if (job_sha == 1) {
		if (VIP_SCRIPT) {
			callfunc "VIP_Third_Class";
			set job_sha,2;
			setquest 7160;
			next;
		}
		mes "[Urupa]";
	mes "我们出了一道谜题，还没有人解开。";
	mes "你想解开它吗？";
	mes "这是一段密码。";
	mes "看看吧。";
		next;
	mes "- 这段消息 -";
	mes "- 是用密码写成的。-";
	mes "你的任务似乎就是破解密码……";
		next;
		mes "[Urupa]";
	mes "这就是密码。";
	mes "它只是给密码编号，让消息变得有意义。";
	mes "例如……";
		next;
		callsub L_Code,1;
		mes "[Urupa]";
	mes "现在来看看需要解决的部分。";
	mes "破解密码，然后前往它指示的地方……";
		next;
		callsub L_Code,2;
		next;
		mes "[Urupa]";
	mes "把这些记下来！";
	mes "我就知道你会接受这个冒险！";
		set job_sha,2;
		setquest 7160;
		close;
	} else if (job_sha == 2) {
		mes "[Urupa]";
	mes "还要我再解释一次吗？";
	mes "还是只想要密码？";
		next;
	switch(select("更多解释。:拿到密码。")) {
		case 1:
			callsub L_Code,1;
			mes "[Urupa]";
			mes "现在就看你的了！";
			mes "去吧！出发！";
			close;
		case 2:
			mes "[Urupa]";
			mes "我再给你看一遍密码……";
			next;
			callsub L_Code,2;
			close;
		}
	} else if (job_sha > 2 && job_sha < 31) {
		mes "[Urupa]";
	mes "好，你解开了吗？";
	mes "祝你好运！";
		close;
	} else if (job_sha == 31) {
		mes "[Urupa]";
	mes "你刚刚成为了暗影追踪者。";
	mes "这些谜题是为了筛选合适的人……";
		close;
	}
	mes "[Urupa]";
	mes "没什么特别的？";
	mes "如你所见……我在这里很好！";
	close;
L_Code:
	if (getarg(0) == 1) {
		mes "[Urupa]";
		mes "3511543433";
	mes "这表示斐扬。";
		next;
		mes "[Urupa]";
	mes "这些数字必须两两配对。";
		mes "3511543433";
	mes "35、11、54、34、33 可以拆成 5 对！";
		next;
		mes "[Urupa]";
	mes "所以这些配对代表：";
	mes "35 - P，11 - A，";
	mes "54 - Y，34 - O，33 - N。";
		next;
		mes "[Urupa]";
	mes "把数字排成一行就是这样。";
		mes "33, 34, 35!";
	mes "N、O、P？";
		next;
	} else {
	mes "开始吧！";
		next;
		mes "^4d4dff";
		mes "43231114345243";
		mes "11441531241542";
		mes "2433";
		mes "3542343344154211";
		mes "^000000";
		next;
		mes "[Urupa]";
	mes "你能做到吗？";
	mes "如果你去那里，也许会大吃一惊……";
	}
	return;
}

s_atelier,65,123,5	script	Manager#sc04_prt	903,{
	if (job_sha == 2) {
		mes "[Manager]";
		mes "马克斯在哪里！？";
		mes "该死，周围有这么多陌生人。";
		mes "嘿……";
		next;
		switch(select("展示破解的密码！:……")) {
		case 1:
			mes "[Manager]";
		mes "哇，你破解了？";
		mes "那么，正确答案是什么？";
			next;
			input .@inputstr$;
			if (.@inputstr$ == "shadows atelier in prontera" || .@inputstr$ == "SHADOWS ATELIER IN PRONTERA") {
				mes "[Manager]";
				mes "很好。";
				mes "你答对了。";
				mes "那么，你为什么来到这里？";
				next;
				select("密码说这里就是那个地方……");
				mes "[Manager]";
				mes "所以你就是那个人。";
				mes "请稍等片刻。";
				set job_sha,3;
				close;
			}
			mes "[Manager]";
			mes "记得准确输入破解后的密码。";
			mes "也许你应该再试一次……";
			close;
		case 2:
			mes "[Manager]";
			mes "只允许相关人员进入……";
			mes "你可以去问商店的店员吗？";
			close;
		}
	} else if (job_sha == 3) {
		mes "[Manager]";
		mes "现在让我自我介绍一下！";
		mes "我是格雷厄姆，这座暗影画廊的管理者……";
		next;
	mes "[格雷厄姆]";
		mes "你可能已经猜到了。";
		mes "这里是为盗贼准备的附属设施。";
		mes "我们接收艺术品和其他历史物品。";
		next;
	mes "[格雷厄姆]";
		mes "这些东西都是非法的。";
		mes "就是你们从历史遗迹带来的那些东西……";
		mes "好吧。";
		next;
	mes "[格雷厄姆]";
		mes "所以我们需要知道……";
		mes "特殊密码以及宝藏所在位置等情报。";
		next;
	mes "[格雷厄姆]";
		mes "我们需要你们……";
		mes "所以向盗贼公会寻求了帮助。";
		next;
		select("你们还在哪些地方工作？");
	mes "[格雷厄姆]";
		mes "啊，是的……";
		mes "我们在普隆德拉、朱诺、拉赫和里希塔乐镇都有画廊。";
		mes "明白了吗？";
		next;
	mes "[格雷厄姆]";
		mes "总之……";
		mes "我们都很想知道宝藏在哪里。";
		mes "所以你要用密码进入这些地方。";
		next;
	mes "[格雷厄姆]";
		mes "你看起来就是合适的人选。";
		mes "所以我会把密码给你。";
		mes "请找到宝藏！";
		next;
		switch(select("不可能！:我试试看！")) {
		case 1:
	mes "[格雷厄姆]";
			mes "什么鬼？";
			mes "如果你不帮忙，我就找别人。";
			set job_sha,4;
			close;
		case 2:
	mes "[格雷厄姆]";
			mes "你真有本事！";
			mes "那么，给你……";
			next;
			callsub L_Code,0;
			close;
		}
	} else if (job_sha == 4) {
	mes "[格雷厄姆]";
		mes "现在感兴趣了吗？";
		next;
		switch(select("一点也不。:嗯，我收下。")) {
		case 1:
	mes "[格雷厄姆]";
			mes "该死。";
			close;
		case 2:
	mes "[格雷厄姆]";
			mes "你真挑剔……";
			mes "给你……";
			next;
			callsub L_Code,0;
			close;
		}
	} else if (job_sha == 5) {
	mes "[格雷厄姆]";
		mes "你找到什么了吗？";
		next;
		switch(select("我需要解释。:密码是什么来着？")) {
		case 1:
	mes "[格雷厄姆]";
			mes "你真有本事！";
			next;
			callsub L_Code,1;
	mes "[格雷厄姆]";
			mes "明白了吗？";
			close;
		case 2:
	mes "[格雷厄姆]";
			mes "我已经把密码给你了。";
			mes "真是的……";
			mes "你没有记下来吗？";
			close;
		}
	} else if (job_sha == 6 || job_sha == 7) {
	mes "[格雷厄姆]";
		mes "没什么特别的……？";
		mes "你去过那些地方……？";
		mes "一定有什么线索。";
		next;
		mes "格雷厄姆似乎知道些什么。";
		mes "我最好再去找他。";
		close;
	} else if (job_sha == 8) {
	mes "[格雷厄姆]";
		mes "那么，有进展吗？";
		next;
		select("把钥匙给他看。");
	mes "[格雷厄姆]";
		mes "欺骗！";
		mes "你在骗我！";
		next;
	mes "[格雷厄姆]";
		mes "就这些？";
		mes "只有一把钥匙。";
		mes "真是会骗人！";
		mes "和我想的一样，这是一种宝藏。";
		next;
	mes "[格雷厄姆]";
		mes "你真让我大吃一惊。";
		mes "好吧……";
		mes "密码保存在各个画廊里。";
		next;
	mes "[格雷厄姆]";
		mes "好吧，除了这里还有其他画廊……";
		mes "朱诺和拉赫也有密码……";
		next;
	mes "[格雷厄姆]";
		mes "果然和我猜的一样。";
		mes "其他画廊保存的密码根本不是宝藏……";
		next;
	mes "[格雷厄姆]";
		mes "去拉赫……";
		next;
	mes "[格雷厄姆]";
		mes "找到拉赫的画廊……";
		mes "告诉他们你刚从格雷厄姆那里来，并索要密码。";
		next;
	mes "[格雷厄姆]";
		mes "明白了吗？";
		mes "那就出发吧！";
		set job_sha,9;
		changequest 7165,7166;
		close;
	} else if (job_sha == 9) {
	mes "[格雷厄姆]";
		mes "一共有四座画廊……";
		mes "普隆德拉、拉赫、朱诺和里希塔乐镇。";
		next;
	mes "[格雷厄姆]";
		mes "画廊保存的密码中有一个已经被破解。";
		mes "它只是一把钥匙……";
		next;
	mes "[格雷厄姆]";
		mes "但这是我的猜测。";
		mes "这些密码彼此相连。";
		mes "而且每个密码的用途都不同。";
		next;
	mes "[格雷厄姆]";
		mes "例如……";
		mes "如果一个是钥匙，那么其他的就是需要这把钥匙才能开启的东西。";
		next;
  mes "[格雷厄姆]";

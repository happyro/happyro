yuno,103,225,0	script	Scrutiny Association#5	-1,{
OnInit:
	initnpctimer;
	end;

OnEnable:
	initnpctimer;
	end;

OnTimer7200000:
	stopnpctimer;
	if (($DTS_Result == 0) || ($DTS_Result == 3)) {
		announce "目前，地下城传送服务提供者选举正在所有主要城市举行。感谢您的参与。",bc_all,"0x70dbdb";
	}
	donpcevent "Scrutiny Association#5::OnEnable";
	end;
}

einbroch,248,71,0	script	Scrutiny Association#6	-1,{
OnEnable:
	initnpctimer;
	end;

OnTimer1000:
	announce "地下城传送服务提供者选举的所有选票均已收到并统计完毕。",bc_all,"0x70dbdb";
	end;

OnTimer5000:
	announce "结果现在已经出来了……",bc_all,"0x70dbdb";
	end;

OnTimer10000:
	announce "这次将由酷炫活动公司担任地下城传送服务提供者。",bc_all,"0x70dbdb";
	end;

OnTimer15000:
	announce "非常感谢所有投票并表示支持的人。",bc_all,"0x70dbdb";
	stopnpctimer;
	end;
}


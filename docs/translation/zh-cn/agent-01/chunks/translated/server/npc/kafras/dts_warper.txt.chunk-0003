					mes "各年龄段客户";
					mes "无论老少大小。谢谢~";
					break;
				}
			}
			else {
				mes "[酷酷活动公司投票人员]";
				mes "请记住，我们";
				mes "不接受免费传送券";
				mes "也不发放特殊储备点";
				mes "作为此服务奖励。现在请选择";
				mes "目的地。";
				next;
				switch(select("海洞地牢 3 层 -> 4,000 Zeny:钟楼 3 楼 -> 4,000 Zeny:古城入口 -> 4,000 Zeny:取消")) {
				case 1:
					if (Zeny >= 4000) {
						set Zeny, Zeny-4000;
						cutin "zonda_01",255;
						warp "iz_dun02",234,206;
						end;
					}
					else {
						mes "[酷酷活动公司投票人员]";
						mes "抱歉，你";
						mes "没有足够 Zeny";
						mes "传送到此目的地。";
						mes "传送费为 4,000 Zeny。";
					}
					break;
				case 2:
					if (Zeny >= 4000) {
						set Zeny, Zeny-4000;
						cutin "zonda_01",255;
						warp "c_tower3",64,143;
						end;
					}
					else {
						mes "[酷酷活动公司投票人员]";
						mes "抱歉，你";
						mes "没有足够 Zeny";
						mes "传送到此目的地。";
						mes "传送费为 4,000 Zeny。";
					}
					break;
				case 3:
					if (Zeny >= 4000) {
						set Zeny, Zeny-4000;
						cutin "zonda_01",255;
						warp "glast_01",368,303;
						end;
					}
					else {
						mes "[酷酷活动公司投票人员]";
						mes "抱歉，你";
						mes "没有足够 Zeny";
						mes "传送到此目的地。";
						mes "传送费为 4,000 Zeny。";
					}
					break;
				case 4:
					mes "[酷酷活动公司投票人员]";
					mes "请放心，";
					mes "酷酷活动公司将尽力";
					mes "确保";
					mes "各年龄段客户满意。";
					mes "各年龄段客户";
					mes "无论老少大小。谢谢~";
					break;
				}
			}
		}
		else if ($DTS_Result == 2) {
			mes "[酷酷活动公司投票人员]";
			mes "抱歉，酷酷活动公司目前";
			mes "不提供";
			mes "地下城传送服务";
			mes "因为上次选举结果。请下次";
			mes "投票支持我们，";
			mes "好吗？祝你今天愉快~";
		}
		else {
			mes "[酷酷活动公司投票人员]";
			mes "抱歉，";
			mes "地下城传送服务在选举期间";
			mes "不可用";
			mes "，选举结果公布后恢复。";
			mes "谢谢，祝你愉快。";
		}
		break;
	case 4:
		mes "[酷酷活动公司投票人员]";
		mes "酷酷活动公司一直";
		mes "努力确保";
		mes "客户不仅";
		mes "满意，我们还";
		mes "超越你的最高标准。";
		mes "谢谢，祝你今天愉快。";
		break;
	}
	close2;
	cutin "zonda_01",255;
	end;
}


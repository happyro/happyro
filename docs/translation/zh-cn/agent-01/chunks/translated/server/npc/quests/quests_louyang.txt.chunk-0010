	mes "很久以前，情况";
	mes "完全不同。";
	next;
	mes "[士兵]";
	mes "据说以前怪物总是入侵洛阳！嘿，不过那只是传闻。不过最近流传着很多传闻，我对此很感兴趣……";
	close;
}


lou_in02,77,37,7	script	Hermit	824,{
	if (!QL_REVOL) {
		mes "[孙茂]";
		mes "有志者事竟成。";
		mes "只要我们共同努力，";
		mes "就没有做不到的事。";
		mes "我们没有做不到的事。";
		next;
		mes "[孙茂]";
		mes "你愿意借给我们力量，共同建设更美好的未来吗？愿意加入我们在洛阳进行社会改革的运动吗？";
		next;
		mes "[孙茂]";
		mes "无论你是本地人还是外地人都没关系。只要我们目标相同，创造一个人人平等的美好洛阳。";
		next;
		mes "[孙茂]";
		mes "我的名字……";
		mes "是孙茂。";
		mes "这个邀请可能很突然，但我是行动派。我从你的脸上看出，你也憎恨不公。";
		next;
		switch(select("我该做什么？:我加入你们！:嗯，我只是游客……")) {
		case 1:
			mes "[孙茂]";
			mes "现在我们必须尽可能招募成员。准备好后，我们会发起改变洛阳、甚至改变世界的运动！";
			next;
			mes "[孙茂]";
			mes "不过我们目前没有足够人手执行计划。幸好领主还没有发现我们。";
			next;
			mes "[孙茂]";
			mes "我希望所有人都能理解我们的意图，但城里的人并不团结。这不是我第一次向外地人求助……";
			next;
			mes "[孙茂]";
			mes "我想你明白我们事业的紧迫性，也明白我们需要招募认同目标的人！";
			close;
		case 2:
			mes "[孙茂]";
			mes "哦，今天神明一定站在我这边，把你送到我面前。谢谢你做出重大决定……";
			next;
			mes "[孙茂]";
			mes "那么我会把你的名字刻在这块血之誓约板上。";
			mes "不过在此之前我再问一次：你真的愿意和我们一起经历痛苦与流血吗？";
			next;
			switch(select("不，等等！:我百分之百确定。")) {
			case 1:
				mes "[孙茂]";
				mes "如果你需要时间决定，我理解。决定加入后请回来。毕竟时间在我们这边。";
				close;
			case 2:
				set QL_REVOL,1;
				mes "[孙茂]";
				mes strcharinfo(0)+ "……！";
				mes "你的名字现在刻在血之誓约板上。我们将为洛阳的未来并肩战斗至死！";
				next;
				getpartymember(getcharid(1));
				set @partymember,$@partymembercount;
				if (is_party_leader() == true || !@partymember) {
					mes "[孙茂]";
					mes "现在最重要的是招募更多成员、壮大队伍。请寻找愿意加入战斗的人。";
					next;
		mes "[Sun Mao]";
		mes "不过为避免引起怀疑，每次只能带一名新成员。另外建议不要把朋友组进队伍一起带来。";
					next;
					mes "[Sun Mao]";
				mes "现在我会在这里等你。去寻找希望洛阳拥有更美好未来的人吧！";
					close;
				}
				mes "[孙茂]";
				mes "请帮助在你身后奋斗的人。成员聚集得更多后，我们的同志会告诉你下一步指示。";
				close;
			}
		case 3:
			mes "[Sun Mao]";
			mes "你是……？我明白了，你现在可以离开。不要泄露在这里看到或听到的事情。";
			next;
			mes "[Sun Mao]";
			mes "如果你真的是游客，就别卷入我们的事业。";
			close;
		}
	} else if (is_party_leader() == true) {
		if (QL_REVOL == 9) {
		mes "[孙茂]";
		mes "再次感谢你的辛苦。";
		mes "平安回去吧。";
		mes "一路小心。";
		mes "回去吧。";
			close;
		}
		getpartymember(getcharid(1));
		set @partymember,$@partymembercount;
		if (QL_REVOL < 8) {
			if (@partymember == QL_REVOL +1) {
				if (@partymember != 8) {
					set QL_REVOL,QL_REVOL +1;
					mes "[孙茂]";
					mes "哦，你带来了新同志！欢迎！请在他加入前帮助他理解我们的意图。";
					next;
					mes "[孙茂]";
					switch(QL_REVOL) {
					case 2:
						mes "请再带一位你们都信任的朋友。记住，每次只能往队伍中加入一个人。";
						next;
						mes "[孙茂]";
						mes "否则别人可能发现我们在做什么，从而引发麻烦。";
						close;
					case 3:
						mes "你们三人可以一起为我们的事业行动。请找一名新成员成为第四人，邀请他加入队伍并带到这里。";
						close;
					case 4:
						mes "啊，现在你们有四人了。不过我们必须谨慎地壮大队伍。请找一名新成员加入队伍，只能一名。";
						close;
					case 5:
						mes "现在你们有五人了。不用说，我们仍需要更多人手。请再找一名成员加入队伍后回来。";
						close;
					case 6:
						mes "现在你们有六人了。目前进展不错。再找一个人加入队伍并带来，让我们招募他。";
						close;
					case 7:
						mes "现在你们有七人，但仍缺少人手。请再找一人加入队伍，然后回来。";
						close;
					}
				}
				mes "[孙茂]";
				mes "干得好，你带来了另一位新同志！欢迎！请向他解释我们的目标与事业的正义性，让他完全加入我们。";
				next;
				if (BaseLevel < 50) {
					mes "[孙茂]";
					mes "行动时刻就要到了……";
					next;
					mes "[孙茂]";
					mes "我认可你为我们战斗的誓言，但恐怕你还没准备好执行我安排的任务。";
					next;
					mes "[孙茂]";
					mes "不过我们还有时间。出去和你招募的队员一起训练，积累更多经验。";
					next;
					mes "[孙茂]";
					mes "你们一起训练会比单独训练更快。准备好执行任务后再回来。";
					close;
				}
				mes "[孙茂]";
				mes "终于有八个人了。我相信你们的人手足以执行任务。请仔细听。";
				next;
				mes "[孙茂]";
				mes "如你所知，洛阳的武术组织分为追求正义的组织，以及服务邪恶目的的组织。";
				next;
				mes "[孙茂]";
				mes "最近，一些邪恶组织与腐败官员勾结，企图扩大势力。";
				next;
				mes "[孙茂]";
				mes "腐败官员怀疑我们的火药研究，以调查为借口逮捕了我们的同志、火药专家^3355FF昊辰流^000000。";
				next;
				mes "[孙茂]";
				mes "没有他，我们无法继续火药研究，也无法生产运动所需的火药。必须联系他，让他为我们制作火药。";
				next;
		mes "[孙茂]";
		mes "遗憾的是，官员知道我们许多人的身份，我们无法联系他。但你们是新成员，也是米德加尔特人，他们不知道你们是谁。";
				next;
				mes "[孙茂]";
				mes "你的任务是把这些化学品交给被政府囚禁的同志昊辰流。";
				next;
		mes "[孙茂]";
		mes "政府办公室内不允许携带易燃化学品，所以必须藏好。如果八个人平均分配这些化学品，我们也许能成功！";
				next;
				set QL_REVOL,8;
				getitem 7068,8; //Burn_Tree
				getitem 7096,8; //Cold_Magma
				getitem 7004,8; //Mud_Lump
				mes "[孙茂]";
				mes "给你们。现在把材料平均分给八个人。你们必须充分合作，否则计划会失败。明白了吗？";
				close;
			} else if (@partymember < QL_REVOL +1) {
				mes "[Sun Mao]";
				switch(QL_REVOL) {
				case 1:
					mes "你已经组队了。现在去招募更多追随者吧。暂时只增加一人，免得引起敌人怀疑。";
					close;
				case 2:
					mes "嗯……找不到第三个人加入队伍吗？";
					mes "一定要找可信任的人。小心别被抓住！";
					close;
				case 3:
					mes "嗯……找不到第四个人加入队伍吗？";
					mes "一定要找可信任的人。小心别被抓住！";
					close;
				case 4:
					mes "找不到第五个人加入队伍吗？一定要找可信任的人。小心别被抓住！";
					close;
				case 5:
					mes "找不到第六个人加入队伍吗？一定要找可信任的人。小心别被抓住！";
					close;
				case 6:
					mes "找不到第七个人加入队伍吗？一定要找可信任的人。小心别被抓住！";
					close;
				case 7:
					mes "嗯……找不到第八个人加入队伍吗？";
					mes "一定要找可信任的人。小心别被抓住！";
					close;
				}
			} else {
				mes "[孙茂]";
				mes "糟糕！你带来了不止一名新成员！现在不能继续招募，否则会引起不必要的注意！";
				next;
				mes "[孙茂]";
				switch(QL_REVOL) {
				case 1:
					mes "请确保队伍总共有两人，这样我们才能招募你的朋友。这样看起来更自然。";
					close;
				case 2:
					mes "现阶段我们不能让行动引起不必要的注意！请确保队伍总共有三人，这样才能招募你的朋友。";
					close;
				case 3:
					mes "请确保队伍总共有四人，这样才能招募你的朋友。这样看起来更自然。";
					close;
				case 4:
					mes "请确保队伍总共有五人，这样才能招募你的朋友。这样看起来更自然。";
					close;
				case 5:
				case 6:
					mes "现在你应该明白，每次只能再带一个人。行动前绝不能引起不必要的注意！";
					close;
				case 7:
					mes "现阶段我们不能让行动引起不必要的注意！请确保队伍总共有八人，这样才能招募你的朋友。";
					close;
				}
			}
		} else if (QL_REVOL == 8) {
			if (@partymember == 8) {
				if (countitem(7204) > 7) {
					mes "[孙茂]";
					mes "欢迎回来！看来任务成功完成了！干得好，同志们！";
					next;
					mes "[孙茂]";
					mes "终于，我们有了惩罚敌人的武器——腐败官员和邪恶武术组织！感谢你们的帮助，同志们。";
					next;
					delitem 7204,countitem(7204);
					set ch_make,0;
					set QL_REVOL,9;
					getitem 668,8;
					mes "[孙茂]";
					mes "请拿走这些资金并与队员分享。希望你们再次为我们的事业贡献力量。";
					next;
					mes "[孙茂]";
					mes "再次感谢你的帮助。现在，安全离开吧。";
					close;
				}
				mes "[孙茂]";
				mes "你的任务是带着我交给你和队员们的材料，把它们秘密交给昊辰流。";
				next;
				mes "[孙茂]";
				mes "昊辰流目前被腐败官员囚禁。记住把材料平均分给队员，避免被官员发现。";
				close;
			}
			mes "[孙茂]";
			mes "嗯，你的队员都去哪了？带着全部成员回来见我。";
			next;
			mes "[孙茂]";
			mes "记住要和同志们一起行动。你们中间没有叛徒吧？";
			close;
		}
	} else {
		if (ch_make == 1) {
			set ch_make,0;
		mes "[孙茂]";
		mes "啊……";
		mes "你回来了！";
		mes "哈哈哈哈！";
		mes "哈哈哈哈哈哈！";
			next;
			mes "[孙茂]";
			mes "我要表扬你和同志们在上次任务中的出色表现。想为事业执行其他任务时，随时回来。";
			close;
		}
		mes "[孙茂]";
		mes "记住，队伍的核心是队长。成员必须团结一致才能实现目标。";
		close;
	}
}

lou_in01,43,147,3	script	Gunpowder Expert	750,{
	if (ch_make == 0) {
		getpartymember(getcharid(1));
		set @partymember,$@partymembercount;
		if (!QL_REVOL) {
			mes "[昊辰流]";
			mes "你……";
			mes "你是谁？";
			next;
			mes "[昊辰流]";
			mes "我只信任为洛阳事业奋斗的同志，所以离我远点。宁死不受压迫！洛阳自由！";
			close;
		} else if (@partymember != 8) {
		mes "[昊辰流]";
		mes "孙茂告诉我会有八名米德加尔特人来。";
		mes "不过发生了什么？";
		mes "我很困惑……";
		mes "到底发生了什么？";
			next;
			mes "[昊辰流]";
			mes "孙茂的计划天衣无缝，所以我会严格按照他的安排行动。";
			mes "你要么是在无谓地即兴发挥，要么根本不是我的同志……";
			close;
		 } else if (countitem(7068) && countitem(7096) && countitem(7004)) {
		mes "[昊辰流]";
		mes "啊，我看出是孙茂派你来的。";
		mes "很抱歉你经历了这些麻烦，";
		mes "为了把化学品秘密带给我，同志。";
		mes "谢谢你。";
		mes "你辛苦了。";
			next;
		mes "[昊辰流]";
		mes "给我一点时间，";
		mes "我马上就能制作火药。";
		mes "很快就好。";
		mes "请稍等。";
			next;
			switch(select("制作火药。:取消。")) {
			case 1:
				delitem 7068,1; //Burn_Tree
				delitem 7096,1; //Cold_Magma
				delitem 7004,1; //Mud_Lump
				mes "[昊辰流]";
				mes "我不想你们在士兵检查货物时被抓。最好由一人携带手推车，把火药藏在里面。";
				set ch_make,1;
				getitem 7204,1; //Gunpowder
				close;
			case 2:
				mes "[昊辰流]";
				mes "出……";
				mes "什么问题了吗？！";
				next;
		mes "[Hao Chenryu]";
		mes "我想我们必须";
		mes "格外小心，";
		mes "这里监视很严密。";
		mes "一定要小心。";
		mes "别被发现。";
				close;
			}
		} else {
		mes "[昊辰流]";
		mes "嗯……";
		mes "看来你是我们的人。";
		mes "我看得出来。";
			next;
		mes "[昊辰流]";
		mes "如果你是来取火药的，";
		mes "应该先从队长那里";
		mes "领取化学品。";
		mes "去找你的队长。";
			close;
		}
	} else if (countitem(7204)) {
		mes "[昊辰流]";
		mes "小心！";
		mes "检查时很容易被发现";
		mes "携带火药！";
		mes "把它藏好……！";
		mes "千万别让人看见！";
		mes "藏得仔细些……！";
		close;
	} else {
		mes "[昊辰流]";
		mes "希望你能安全把火药带给孙茂。下次见到他时，请替我道谢。";
		close;
	}
}

lou_in01,45,138,3	script	Soldier#1	825,{
	if (countitem(7204)) {
		mes "[士兵]";
		mes "站住！";
		next;
		mes "[士兵]";
		mes "不允许把火药带出这里。";
		mes "现在回去把它放下，米德加尔特人！快走！";
		close;
	}
	mes "[士兵]";
	mes "在这种地方看到外地人真奇怪。我们和你没什么关系，";
	mes "所以赶快离开。";
	close2;
	warp "lou_in01",82,141;
	end;
}

lou_in01,82,139,7	script	Soldier#2	825,{
	if (countitem(7068) || countitem(7096) || countitem(7004)) {
		mes "[Soldier]";
		mes "抱歉，你携带的某些物品禁止带入。";
		mes "我不能让你进去。";
		close;
	}
	mes "[Soldier]";
	mes "这里没什么特别的，不过你想看看房间的话请自便。";
	close2;

	mes "[药草商人]";
	mes "欢迎光临，这里是普拉菲娜的药草店，只提供最新鲜的药草~！";
	next;
	.@item = select("雪花草:牡丹草:拍打草:世界树灰尘:结束对话")-1;
	if (.@item == 4){
		mes "[药草商人]";
		mes "欢迎随时再来。";
		close;
	}
	mes "[Herb Merchant]";
	switch (.@item){
	case 0:
		mes "雪花草对^3131FF灼烧、出血、深度睡眠、睡眠^000000有特殊效果。";
		break;

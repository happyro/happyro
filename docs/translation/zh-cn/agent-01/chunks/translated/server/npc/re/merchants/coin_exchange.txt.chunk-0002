			"[矛鱼（1小时）] 8 个 E 级硬币/50 个罐头",
			"[金枪鱼（1小时）] 8 个 E 级硬币/50 个罐头",
			"[带鱼（1小时）] 8 个 E 级硬币/50 个罐头",
			"[竹荚鱼（1小时）] 8 个 E 级硬币/50 个罐头",
			"[马兰岛雪蟹（1小时）] 8 个 E 级硬币/50 个罐头",
			"[斑鳗（1小时）] 8 个 E 级硬币/50 个罐头",
			"[带鱼（7天）] 10 个银藤果",
			"[矛鱼（7天）] 10 个银藤果",
			"[竹荚鱼（7天）] 10 个银藤果",
			"[金枪鱼（7天）] 10 个银藤果",
			"[斑鳗（7天）] 10 个银藤果",
			"[马兰岛雪蟹（7天）] 10 个银藤果",
			"结束购买。"
		);
		if (.@i == 13) {
		mes "[流浪商人]";
		mes "那么，下次见。再见。";
			close;
		}
	mes "[流浪商人]";
	mes "你对^0000FF["+.@names$[.@i]+"]^000000感兴趣吗？";
		switch(.@i) {
		case 1: //Spearfish_Box1
		case 8: //Spearfish_Box2
			mes "这是一种随季节变化的鱼，非常美味！";
			mes "不过我说的是食物，真好吃~";
			next;
			mes "[流浪商人]";
			mes "当然，这是^DC143C双手矛^000000。";
			mes "使用连刺或螺旋击时，有很高概率造成出血状态~";
			next;
			mes "[流浪商人]";
			mes "更多详情……螺旋击攻击力提高 100%，灵感攻击力提高 50%；";
			mes "基础等级超过 100 时，额外攻击力 +30。";
			mes "基础攻击力为 220。";
			next;
			break;
		case 2: //Tuna_Box1
		case 10: //Tuna_Box2
			mes "这是一种很受欢迎、用于各种料理的鱼。";
			mes "剑士、商人和服事职业可以把它作为^DC143C钝器^000000使用。";
			next;
			mes "[流浪商人]";
			mes "使用近距离物理攻击时，有很高概率发动晕眩或自动施放狂击。";
			mes "基础攻击力为 180。";
			next;
			mes "[流浪商人]";
			mes "更多详情……基础等级超过 100 时额外攻击力 +20，";
			mes "并有低概率使自己冻结。";
			next;
			break;
		case 3: //Hairtail_Box1
		case 7: //Hairtail_Box2
			mes "这种鱼看起来像一条长腰带。";
			next;
			mes "[流浪商人]";
			mes "这是一把^DC143C双手剑^000000，";
			mes "大多数剑士都可以使用。";
			mes "攻击时暴击伤害增加 50%，CRI + 20。";
			mes "基础攻击力为 220。";
			next;
		mes "[流浪商人]";
			mes "更多详情……基础等级超过 100 时，额外攻击力 +50。";
			next;
			break;
		case 4: //Saurel_Box1
		case 9: //Saurel_Box2
			mes "这是一把^DC143C短剑^000000，魔法攻击力 +100，";
			mes "物理攻击时有一定概率在 7 秒内攻击力 +30。";
			next;
		mes "[流浪商人]";
			mes "更多详情……魔法攻击时有一定概率在 7 秒内魔法攻击力 +20，";
			mes "基础等级超过 100 时，额外魔法攻击力 +10、攻击力 +10。";
			mes "基础攻击力为 160。";
			next;
			break;
		case 5: //Malang_Crab_Box1
		case 12: //Malang_Crab_Box2
			mes "这是一把^DC143C弓^000000，LUK +3，暴击伤害增加 50%，";
			mes "基础等级超过 100 时，远程物理攻击力增加 20%。";
			mes "基础攻击力为 120。";
			next;
		mes "[流浪商人]";
			mes "更多详情……弓手、盗贼和流氓职业可以使用。";
			next;
			break;
		case 6: //Brindle_Eel_Box1
		case 11: //Brindle_Eel_Box2
			mes "这是一把^DC143C弓^000000。";
			mes "因为它富有弹性，";
			mes "我们开始把它当作弓使用。";
			mes "基础攻击力为 180。";
			next;
		mes "[流浪商人]";
			mes "更多详情……远程物理攻击时有一定概率在 5 秒内 AGI +3、ASPD +2。";
			mes "基础等级超过 100 时，远程物理攻击力额外增加 20%。";
			mes "猎人、吟游诗人和舞娘职业可以使用。";
			next;
			break;
		}
		if (.@i < 7)
			setarray .@price[0],8,50,0; // 1 hour items cost 8 Egrade_Coin or 50 Malang_Sp_Can.
		else
			setarray .@price[0],0,0,10; // 7 day items cost 10 Silvervine.
		callfunc "F_mal_coin",1,"[流浪商人]",.@names$[.@i],.@items[.@i],.@price[0],.@price[1],.@price[2];
		next;
	}
}


ecl_in01,66,95,3	script	Armor Merchant Naphara#e::glove	436,{
	if (!checkweight(1301,3)) {
		mes "- 到此为止！！ -";
		mes "- 你携带的物品太多了。 -";
		mes "- 你无法再携带更多物品。 -";
		mes "- 请减轻负重后 -";
		mes "- 再试一次。 -";
		close;
	}
	mes "[护甲商人]";
	mes "你好，这里是纳法拉的高级商品店。";
	mes "你需要什么？";
	next;
	.@choice = select("力量手套:智力手套:敏捷手套:体质手套:灵巧手套:幸运手套") -1;
	mes "[护甲商人]";
	switch(.@choice) {
	case 0: // Str Glove
		mes "^3131FF力量手套^000000";
		mes "^3131FF最大生命值 +100，最大魔法值 +20^000000";
		mes "^3131FFSTR 每增加 10，ATK +1^000000";
		mes "^3131FFSTR 超过 110 时，ATK +1%^000000";
		break;
	case 1:
		mes "^3131FF智力手套^000000";
		mes "^3131FF最大生命值 +100，最大魔法值 +20^000000";
		mes "^3131FFINT 每增加 10，MATK +1^000000";
		mes "^3131FFINT 超过 110 时，MATK +1%^000000";
		break;
	case 2:
		mes "^3131FF敏捷手套^000000";
		mes "^3131FF最大生命值 +100，最大魔法值 +20^000000";
		mes "^3131FFAGI 每增加 10，完全回避 +1^000000";
		mes "^3131FFAGI 超过 110 时，完全回避 +1^000000";
		break;
	case 3:
		mes "^3131FF体质手套^000000";
		mes "^3131FF最大生命值 +100，最大魔法值 +20^000000";
		mes "^3131FFVIT 每增加 10，最大生命值 +50^000000";
		mes "^3131FFVIT 超过 110 时，最大生命值 +1%^000000";
		break;
	case 4:
		mes "^3131FF灵巧手套^000000";
		mes "^3131FF最大生命值 +100，最大魔法值 +20^000000";
		mes "^3131FFDEX 每增加 10，命中 +1^000000";
		mes "^3131FFDEX 超过 110 时，远程攻击力 +1%^000000";
		break;
	case 5:
		mes "^3131FF幸运手套^000000";
		mes "^3131FF最大生命值 +100，最大魔法值 +20^000000";
		mes "^3131FFLUK 每增加 10，暴击 +1^000000";
		mes "^3131FFLUK 超过 110 时，暴击伤害 +1%^000000";
		break;
	}
	mes "^3131FF需求等级：100^000000";
	mes "^3131FF插槽：0^000000";
	mes "^3131FF重量：10^000000";
	mes "是它的特性选项。";
	next;
	mes "[护甲商人]";
	mes "需要 10 个斯普兰迪德硬币。";
	mes "要购买吗？";
	next;
	if (select("购买。:不买。")==1) {
		if (countitem(6081) < 10) {
			mes "[护甲商人]";
			mes "你的硬币似乎不够。";
			close;
		}
		delitem 6081,10; //Splendide_Coin
		getitem (.@choice+2917),1;
		mes "[护甲商人]";
		mes "太好了，它属于你了。谢谢。";
	}
	close;
}

ecl_in01,64,97,5	script	Slot Expert Nattuer#ecl	436,{
	disable_items;
	mes "[插槽专家]";
	mes "我是插槽专家纳图尔。";
	mes "带上我弟弟纳法拉制作的道具和 5 个斯普兰迪德硬币，我就能为你开启一个插槽。";
	next;
	if (select("开启插槽。:算了。") == 2){
		close;
	}
	mes "[插槽专家]";
	mes "开启插槽是极其困难的工序，即使格外小心并使用放大镜，也可能失败。";
	next;
	mes "[插槽专家]";
	mes "当然，如果你的心胸像那片鲜花盛开的土地一样宽广，就不会介意，对吧？要开始吗？";
	next;
	if (select("继续。:算了。") == 2) {
		close;
	}
	mes "[插槽专家]";
	mes "你想为哪个道具开启插槽？";
	next;
	.@choice = select("力量手套:智力手套:敏捷手套:体质手套:灵巧手套:幸运手套");
	.@choice += 2916;
	mes "[插槽专家]";
	mes "最后确认一次。你想要的是" + getitemname(.@choice) + "吗？";
	next;
	if (select("是:否")==2) {
		mes "[插槽专家]";
		mes "确定之后再来找我吧。";
		close;
	}
	if (countitem(.@choice) < 1) {
		mes "[插槽专家]";
		mes "你没有那个道具。确定之后再来找我吧。";
		close;
	}
	if (countitem(6081) < 5) {
		mes "[插槽专家]";
		mes "你的硬币不够。确定之后再来找我吧。";
		close;
	}
	progressbar "0xFFFF00",3;
	mes "[插槽专家]";
	delitem 6081,5; //Splendide_Coin
	.@luckyday = rand(1,100);
	if (.@luckyday % 20){
		emotion ET_THINK;
		delitem .@choice,1;
		mes "糟糕，抱歉，失败了。";
		mes "但我确信下次会成功，我有这种感觉。";
		close;
	}
	emotion ET_BEST;
	delitem .@choice,1;
	getitem (.@choice+6),1;
	mes "我的眼睛都快瞪出来了。";
	mes "不过还是恭喜你，插槽开启成功。";
	close;
}

ecl_in01,33,98,5	script	Herb Merchant Plafina#a	443,{
	if (checkweight(1301,1)==0) {
		mes "- 到此为止！！ -";

		mes "把里面的内容全部读完。";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "这里只是在说明这个咒语。";
		mes "前言可真长。";
		mes "我标记一下这里，";
		mes "下次就能轻松找到";
		mes "调配过程了……";
		mos_nowinter = 16;
		next;
		mes "^0000ff季节魔法^000000：^ff0000永恒之夏^000000";
		mes "首先，把前 3 种材料放入";
		mes "预热过的锅中混合。";
		mes "夜间徘徊者伸出的手臂，";
		mes "植物与动物腐烂后的混合物，";
		mes "以及一个向前走的人身上的肢体，";
		mes "他却想要向后奔跑。";
		mes "第一阶段应该完成了。";
		mes "刚完成这个阶段时，混合物";
		mes "几乎不会出现变化。";
		mes "之后，你必须加入";
		mes "滋养一切生命的液体，并搅拌 20 次。";
		mes "这时你一定会看到";
		mes "它的颜色和气味发生变化。";
		mes "记住，一旦发现";
		mes "有任何不对，就必须停止并重新开始。";
		mes "施展魔法时，";
		mes "遵循这些精确步骤至关重要。";
		mes "接下来要把 2 种材料放入锅中。";
		mes "第一种，是抬头看夜空时";
		mes "能够看到的物体。";
		mes "第二种，是美丽的泥土团，";
		mes "即使浇水也会从指缝间漏走。";
		mes "你应该检查它的气味是否改变。";
		mes "然后充分搅拌 15 次。";
		mes "它的颜色会发生变化。";
		mes "最后的材料必须是";
		mes "含有热量的东西。";
		mes "你必须按照顺序进行。";
		mes "带有太阳属性的石头，";
		mes "海洋球体的脑，";
		mes "激情的器官，";
		mes "以及一块无法切割的石头。";
		mes "放入最后一种材料后，";
		mes "就完成了。";
		mes "必须把溶液洒在";
		mes "你希望影响";
		mes "季节变化的地方。";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "我标记一下这一页，";
		mes "下次就知道从哪里继续读了。";
		close;
	} else if (mos_nowinter == 16) {
		if(select("Read from the preface.:Read from the marked page.") == 1) {
			mes "……因此，这个咒语";
			mes "在我们强大的咒语中尤其出色。";
			mes "通常，魔法被认为是";
			mes "与邪恶签订的契约。";
			mes "但下面的力量并非来自";
			mes "地狱，而是来自自然与人类的精神。";
			mes "我已经告诉过你，这个咒语";
			mes "有如下 2 个特点。";
			mes "第一，它能改变自然现象。";
			mes "与愚蠢学者的想法不同，";
			mes "这个世界由无形而精确的秩序构成。";
			mes "人们称为";
			mes "奇迹的事物，是通过刺激它们";
			mes "或简单改变它们的排列而产生的。";
			mes "大多数改变天气的咒语";
			mes "都属于这一类，";
			mes "并且需要很高的理解力。";
			mes "这个世界的秩序并非简单排列。";
			mes "几乎不可能观察到";
			mes "其中最微小而细致的部分，";
			mes "并完全理解它们的结构。";
			mes "不过，重复已经完成的咒语";
			mes "并没有那么困难。";
			mes "这本厚重的魔法书就是为此而写的。";
			next;
			mes "……第二个特点是：";
			mes "这本咒语书代表着人类的愿望。";
			mes "人类的精神如此强大，";
			mes "有时心中的火焰";
			mes "会具现化并成为现实。";
			mes "现在，练习一个改变天气的咒语。";
			mes "你必须前往潮湿而荒废的地方，";
			mes "准备一锅正在融化的材料，";
			mes "以及施法者的精神。";
			mes "接下来的咒语必须";
			mes "严格按照流程进行。";
			mes "如果发现有什么";
			mes "不对，就必须立即停止。";
			mes "为了防止普通人";
			mes "滥用魔法，";
			mes "材料的描述使用了隐喻，";
			mes "但理解这些隐喻的人就能";
			mes "读懂其中的一切。";
			next;
			mes "^0000ff季节魔法^000000：^ff0000永恒之夏^000000";
			mes "首先，把前 3 种材料放入";
			mes "预热过的锅中混合。";

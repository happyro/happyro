			mes "第一阶段应该完成了。";
			mes "刚完成这个阶段时，混合物";
			mes "几乎不会出现变化。";
			mes "之后，你必须加入";
			mes "滋养一切生命的液体，并搅拌 20 次。";
			mes "这时你一定会看到";
			mes "它的颜色和气味发生变化。";
			mes "记住，一旦发现";
			mes "有任何不对，就必须停止并重新开始。";
			mes "施展魔法时，";
			mes "遵循这些精确步骤至关重要。";
			mes "接下来要把 2 种材料放入锅中。";
			mes "第一种，是抬头看夜空时";
			mes "能够看到的物体。";
			mes "第二种，是美丽的泥土团，";
			mes "即使浇水也会从指缝间漏走。";
			mes "你应该检查它的气味是否改变。";
			mes "然后充分搅拌 15 次。";
			mes "它的颜色会发生变化。";
			mes "最后的材料必须是";
			mes "含有热量的东西。";
			mes "你必须按照顺序进行。";
			mes "带有太阳属性的石头，";
			mes "海洋球体的脑，";
			mes "激情的器官，";
			mes "以及一块无法切割的石头。";
			mes "放入最后一种材料后，";
			mes "就完成了。";
			mes "必须把溶液洒在";
			mes "你希望影响";
			mes "季节变化的地方。";
			close;
		}
		mes "^0000ff季节魔法^000000：^ff0000永恒之夏^000000";
		mes "首先，把前 3 种材料放入";
		mes "预热过的锅中混合。";
		mes "夜间徘徊者伸出的手臂，";
		mes "植物与动物腐烂后的混合物，";
		mes "以及一个向前走的人身上的肢体，";
		mes "他却想要向后奔跑。";
		mes "第一阶段应该完成了。";
		mes "刚完成这个阶段时，混合物";
		mes "几乎不会出现变化。";
		mes "之后，你必须加入";
		mes "滋养一切生命的液体，并搅拌 20 次。";
		mes "这时你一定会看到";
		mes "它的颜色和气味发生变化。";
		mes "记住，一旦发现";
		mes "有任何不对，就必须停止并重新开始。";
		mes "施展魔法时，";
		mes "遵循这些精确步骤至关重要。";
		mes "接下来要把 2 种材料放入锅中。";
		mes "第一种，是抬头看夜空时";
		mes "能够看到的物体。";
		mes "第二种，是美丽的泥土团，";
		mes "即使浇水也会从指缝间漏走。";
		mes "你应该检查它的气味是否改变。";
		mes "然后充分搅拌 15 次。";
		mes "它的颜色会发生变化。";
		mes "最后的材料必须是";
		mes "含有热量的东西。";

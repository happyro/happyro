//----------------------------------------------------------------------------
// Mixing Pot
//----------------------------------------------------------------------------
mosk_in,221,43,0	script	#bowl	HIDDEN_NPC,{
	if (mos_nowinter != 16) end;
	mes "-这是一个非常肮脏的锅。";
	mes "里面有什么东西正在沸腾，";
	mes "芭芭雅嘎可能对它";
	mes "做了什么。";
	mes "好，开始吧。-";
	next;
	setarray .@menu$[0], "蝙蝠翅粉","孢子液","蚱蜢腿","女巫星砂","细砂";
	.@implode$ = implode( .@menu$,":" );
	while( .@nankai < 3 ) {
		mes "-锅里仍有东西在沸腾。";
		mes "我该怎么办？-";
		next;
		switch(select("放入材料。:倒水进去。:搅拌。:完成了！")) {
			case 1:
				.@m = select( .@implode$ ) -1;
				if ((!.@m && .@bat) || (.@m == 1 && .@mush) || (.@m == 2 && .@locker))
					specialeffect EF_POISONHIT;
				else {
					specialeffect EF_SMOKE;
					if (.@m == 0) .@bat++;
					if (.@m == 1) .@mush++;
					if (.@m == 2) .locker++;
					.@maho++;
				}
				if (.@m >= 3)
					specialeffect EF_POISONHIT;
				.@nankai++;
				mes "-我把"+ .@menu$[.@m] +"放进锅里。";
				mes "它的气味发生了轻微变化。-";
				break;
			case 2:
				specialeffect EF_POISONHIT;
				.@nankai++;
				mes "-我往锅里倒入少量水。";
				mes "液体变稀了。";
				mes "没有发生其他显著变化";
				mes "。-";
				break;
			case 3:
				specialeffect EF_POISONHIT;
				.@nankai++;
				mes "-我开始搅拌。";
				mes "用木棍搅拌了几下。";
				mes "没有发生其他显著变化";
				mes "。-";
				break;
			case 4:
				specialeffect EF_POISONATTACK;
				mes "["+strcharinfo(0)+"]";
				mes "我会告诉芭芭雅嘎";
				mes "工作已经完成了。";
				mos_nowinter = 17;
				close;
		}
		next;
	}
	specialeffect EF_BUBBLE;
	mes "-液体发生了变化，";
	mes "现在正冒着泡。";
	mes "它似乎缩小了，";
	mes "但幅度不大。-";
	next;
	mes "-总之，第一步完成了，";
	mes "继续下一阶段吧。-";
	next;
	while( .@nankai < 7 ) {
		mes "-好，我该怎么办？-";
		next;
		switch(select("放入材料。:倒水进去。:搅拌。:完成了！")) {
		case 1:
			.@w = 0;
			.@m = select( implode( .@menu$,":" ) ) -1; 
			if (.@m >= 3) {
				if (.@nankai == 5 || .@nankai == 6) {
					if ((.@m == 3 && .@star) || (.@m == 4 && .@sand))
						specialeffect EF_POISONHIT;
					else {
						specialeffect EF_SMOKE;
						.@maho++;
						if (.@m == 3) .@star++;
						if (.@m == 4) .@sand++;
						.@w = 1;
					}
				} else {
					specialeffect EF_POISONHIT;
					if (.@m == 3) .@star++;
					if (.@m == 4) .@sand++;
				}
				next;
			}
			else
				specialeffect EF_POISONHIT;
			.@nankai++;
			mes "-我把"+ .@menu$[.@m] +"放进锅里。";
			if (.@m <= 2)
				mes "它的气味发生了剧烈变化。-";
			else
				mes "它的"+ ( .@w ? "气味" : "颜色" ) +"发生了轻微变化。-";
			break;
		case 2:
			if (.@nankai == 3) {
				mes "-我往锅里倒入少量水。";
				mes "沸腾声变得更强，仿佛";
				mes "浑浊的液体中有什么东西";
				mes "发生了变化。-";
				specialeffect EF_DRAGONSMOKE;
				.@maho++;
			} else {
				specialeffect EF_POISONHIT;
				mes "-我往锅里倒水，液体变稀了。-";
			}
			.@nankai++;
			break;
		case 3:
			if (.@nankai == 4) {
				mes "["+strcharinfo(0)+"]";
				mes "好，这次我要搅拌它。";
				mes "我应该搅拌几次呢……？";
				next;
				input .@input;
				if (.@input == 20) {
					mes "-必须搅拌 20 次。-";
					next;
					specialeffect EF_WIND;
					mes "-搅拌让它变得";
					mes "更加明亮，";
					mes "气味也变得";
					mes "更容易忍受。";
					.@maho++;
					.@nankai++;
				} else if (!.@input)
					mes "-我不搅拌了。-";
				else if (.@input > 100) {
					mes "-不能搅拌";
					mes "这么多次。";
					mes "让我再想想。-";
				} else {
					mes "-对，必须搅拌 " + .@input + " 次。-";
					next;
					mes "-我用力搅拌。";
					mes "它沸腾了。-";
					.@nankai++;
				}
			} else {
				mes "-咕嘟，咕嘟。-";
				next;
				mes "["+strcharinfo(0)+"]";
				mes "发生变化了？";
				.@nankai++;
			}
			break;
		case 4:
			mes "["+strcharinfo(0)+"]";
			mes "我会告诉芭芭雅嘎";
			mes "已经完成了。";
			mos_nowinter = 17;
			specialeffect EF_POISONATTACK;
			close;
		}
		next;
	}
	mes "-我确定书上说过";
	mes "要等待一段时间。-";
	next;
	mes "............";
	next;
	mes "............";
	next;
	mes "-锅中沸腾的液体气味";
	mes "已经发生了足够的变化。";
	mes "继续下一阶段吧。-";
	next;
	setarray .@menu2$, "女巫星砂","细砂","引爆器","红血","燃烧之心";
	setarray .@menu3$, "女巫星砂","细砂","引爆器","红血","燃烧之心","钻石碎片";
	.@implode2$ = implode( .@menu2$,":" );
	.@implode3$ = implode( .@menu3$,":" );
	while(1) {
		mes "-好，我该怎么办？-";
		next;
		switch(select("放入材料。:倒水进去。:搅拌。:完成了！")) {
			case 1:
				.@w = 0;
				if (.@nankai != 11) {
					.@m = select( .@implode2$ ) -1;
					if ((.@m == 2 && .@nankai == 9) || (.@m == 3 && .@nankai == 8) || (.@m == 4 && .@nankai == 10)) {
						specialeffect EF_SMOKE;
						.@maho++;
					} else {
						specialeffect EF_POISONHIT;
						.@w = 1;
					}
					if (.@m <= 1)
						specialeffect EF_POISONHIT;
					.@nankai++;
				mes "-我把"+ .@menu2$[.@m] +"放进锅里。";
					if (.@m <= 1)
					mes "它的气味发生了轻微变化。-";
					else
					mes ( .@w ? "气味变得更糟了。-" : "气味发生了一点变化。-" );
				} else {
					.@m = select( .@implode3$ ) -1;
					if (.@m != 5)
						specialeffect EF_POISONHIT;
					else {
						.@maho++; 
						specialeffect EF_SMOKE; 
					}
					.@nankai++;
					mes "-我把"+((.@m == 5)?"一块":"那块")+" "+ .@menu3$[.@m] +"放进锅里。";
					if (.@m == 5)
					mes "溶液的颜色发生了变化。-";
					else
					mes "气味变得更糟了。-";
				}
				break;
			case 2:
				.@nankai++;
				mes "-我往锅里倒入少量水。";
				mes "气味变好了一些。-";
				break;
			case 3:
				if (.@nankai == 7) {
					mes "["+strcharinfo(0)+"]";
					mes "好，这次我要搅拌它。";
					mes "我应该搅拌几次呢……？";
					next;
					input .@input;
					if (.@input == 15) {
						mes "-必须搅拌 15 次。-";
						next;
						specialeffect EF_WIND;
						mes "-搅拌让它";
						mes "变得更明亮。-";
						.@maho++;
						.@nankai++;
					} else if (.@input == 0)
						mes "-我不搅拌了。-";
					else if (.@input > 100) {
						mes "-不能搅拌";
						mes "这么多次。";
						mes "让我再想想。-";
					} else {
						mes "-对，必须搅拌 " + .@input + " 次。-";
						next;
						mes "-我用力搅拌。";
						mes "它沸腾了。-";
						.@nankai++;
					}
				} else {
					mes "-咕嘟，咕嘟。-";
					next;
					mes "["+strcharinfo(0)+"]";
					mes "发生变化了？";
					.@nankai++;
				}
				break;
			case 4:
				mes "-看起来工作完成了。";
				mes "我得把这个给芭芭雅嘎看看。-";
				if (.@maho == 12) {
					mos_nowinter = 18;
					specialeffect EF_GASPUSH;
					close;
				}
				specialeffect EF_POISONATTACK;
				mos_nowinter = 17;
				close;
		}
		next;
	}
}

//----------------------------------------------------------------------------
// Center of Town
//----------------------------------------------------------------------------
moscovia,224,190,0	script	#nowinterplz	CLEAR_NPC,{
	if (mos_nowinter != 19) end;
	if (countitem(7765)) {// Yaga_Secret_Medicine
		mes "["+strcharinfo(0)+"]";
		mes "这里一定是";
		mes "城镇中心……";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "好，开始吧！";
		next;
		mes "-我把装有芭芭雅嘎";
		mes "秘密药剂的魔法瓶";
		mes "放了下来。-";
		delitem 7765,1;
		specialeffect EF_BARRIER;
		mos_nowinter = 20;
		changequest 18078,18079;
		next;
		mes "-你感觉自己的";
		mes "身体热了起来。";
		mes "比之前";
		mes "热得多。-";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "我确定季节已经改变了。";
		mes "但我要怎么确认呢？";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "我先去见沙皇。";
		mes "他一定想听听这件事。";
		close;
	}

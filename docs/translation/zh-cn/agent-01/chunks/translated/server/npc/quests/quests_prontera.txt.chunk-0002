			mes "嗯……";
			mes "我很容易晕船，";
			mes "坐飞艇时总是很不舒服，";
			mes "所以一路乘飞艇前往朱诺，";
			mes "简直让我害怕得要命。";
			emotion ET_THINK;
			next;
			mes "[忙碌的男孩]";
			mes "这下我可麻烦了！";
			mes "我从来不会迟到，";
			mes "但这次实在没办法。";
			mes "我什么也做不了！";
			mes "啊，我要丢掉这份工作了！";
			emotion ET_CRY;
			next;
			mes "[忙碌的男孩]";
			mes "等等……你们冒险者";
			mes "经常到处旅行，对吧？";
			mes "如果你要去朱诺，";
			mes "能帮我把这个送过去吗？";
			mes "要是这些书送不出去，";
			mes "我真的会惹上大麻烦……";
			next;
			callsub S_GetBooks;
			mes "[忙碌的男孩]";
			mes "我、我明白了。";
			mes "我知道这本来不关你的事，";
			mes "我知道这不该麻烦你，";
			mes "但我真的已经走投无路了……";
			emotion ET_CRY;
			set prt_curse,2;
			close;
		}
		else if (prt_curse == 3) {
			mes "[忙碌的男孩]";
			mes "啊，拜托你把我交给你的书";
			mes "送给^FF0000卡洛莫夫先生^000000，";
			mes "他应该就在朱诺图书馆附近等候。";
			mes "请把书交到他手上。";
			mes "拜托你了。";
			mes "再次感谢你的帮助~";
			close;
		}
	}
	end;

S_GetBooks:
	if (select("帮助他:不帮助他") == 1) {
		mes "[忙碌的男孩]";
		mes "啊，太感谢你了！";
		mes "你不知道我有多害怕那些飞艇。";
		mes "现在，能请你把这些书送给";
		mes "^FF0000卡洛莫夫先生^000000吗？";
		mes "他就在朱诺图书馆附近等候。";
		mes "可以吗？";
		next;
		mes "[忙碌的男孩]";
		mes "我知道这些书挺重的，";
		mes "但请务必小心保管！总之，";
		mes "谢谢你愿意帮我。";
		mes "拜托你一定要小心。";
		mes "我真的已经走投无路了……";
		set prt_curse,3;
		//setquest 18030;// custom addition to make the script consistent
		getitem 7431,1; //Books
		close;
	}
	return;

S_CheckWeight:
	if ((MaxWeight-Weight) < 2000 || checkweight(1201,1) == 0) {
		mes "^3355FF请等一下！";
		mes "你现在携带的物品太多了。";
		mes "请先使用卡普拉服务，";
		mes "存放一些物品后再回来。^000000";
		mes "请不要携带过多物品。";
		mes "这样就能腾出足够的空间了。";
		close;
	}
	return;
}

yuno,311,195,3	script	Historian#prt01	754,{
	if ((MaxWeight-Weight) < 2000 || checkweight(1201,1) == 0) {
		mes "^3355FF请等一下！";
		mes "你现在携带的物品太多了。";
		mes "请使用卡普拉服务，";
		mes "存放一些物品后再回来。";
		mes "这样就能腾出空间了。";
		mes "请先存放一些物品。^000000";
		close;
	}
	if (prt_curse < 3) {
		mes "[历史学家]";
		mes "朱诺神秘的过去";
		mes "隐藏着一个重大秘密。";
		mes "我敢肯定！想到我的研究";
		mes "正让我越来越接近";
		mes "揭开这个秘密的那一天，";
		mes "我就兴奋不已！";
		next;
		mes "[历史学家]";
		mes "不过我承认，即使是我也不知道还要";
		mes "深入研究多少，才能得到想要的答案。作为历史学家，";
		mes "查明过去的真相是我们的职责，但绝不会轻松。";
		next;
		mes "[历史学家]";
		mes "为了理解过去，亲眼看见";
		mes "过去的真相……";
		mes "哪怕出卖灵魂，";
		mes "我也愿意换取这个机会。";
		close;
	}
	else if (prt_curse == 3) {
		mes "^3355FF你走近时，这位历史学家";
		mes "突然合上手中的书，";
		mes "抬头望向天空，";
		mes "深深地叹了口气，";
		mes "他显得十分紧张，";
		mes "徒劳地试图缓解自己的紧张。^000000";
		next;
		mes "[历史学家]";
		mes "呜啊啊啊啊啊！";
		mes "我的书在哪里？！";
		emotion ET_ANGER;
		next;
		select("你还好吗？");
		mes "[历史学家]";
		mes "呃？哦，抱歉让你看到那一幕。";
		mes "我只是实在太生气了。事情是这样的，";
		mes "我在等普隆德拉送来的研究书籍，";
		mes "但它们到现在还没送到。";
		mes "配送员似乎出了什么问题，";
		mes "我也不知道什么时候才能收到。";
		next;
		mes "[历史学家]";
		mes "实际上，配送员已经迟到很久了。";
		mes "这会严重拖慢我的研究，";
		mes "因为没有新的材料可以研究，";
		mes "我根本无法继续下去。";
		mes "真让人头疼。";
		next;
		if (countitem(7431) > 0) {
			select("请问，你叫什么名字？");
		mes "[历史学家]";
			mes "嗯？我是卡洛莫夫，";
			mes "莱肯贝尔历史研究组的";
			mes "首席学者。";
			mes "你有什么事吗？还是说，";
			mes "你是在这里寻找";
			mes "某个特定的人？";
			next;
		}
		else {
			select("哦，我是替他来送书的。");
			emotion ET_QUESTION;
		mes "[历史学家]";
			mes "啊，真的吗？";
			mes "太好了，你来了！";
			mes "那么，书在哪里？";
			next;
			mes "["+strcharinfo(0)+"]";
			mes "我……";
			mes "我现在";
			mes "没带着它们。";
			next;
		mes "[历史学家]";
			mes "什么……？";
			mes "你不会是说";
			mes "你把它们弄丢了吧！那些";
			mes "书可是无价之宝！";
			mes "你大老远跑来，";
			mes "就只是为了告诉我这个？";
			next;
		mes "[历史学家]";
			mes "好吧，我想你得报告书籍遗失，";
			mes "然后弄几本新的来，";
			mes "把本来应该送到的书补上。";
			mes "现在快去，我还要做研究呢！";
			mes "别再耽搁了。";
			mes "我需要继续研究！";
			close;
		}
		select("没错，我把你的书带来了。");
		mes "[历史学家]";
		mes "什么？但你不是配送员。";
		mes "好吧，让我看看你带来的书。嗯……";
		mes "果然不出我所料：卢恩-";
		mes "米德加尔特王国拥有大量";
		mes "古代资料。";
		mes "真是丰富。";
		next;
		mes "[历史学家]";
		mes "啊，非常感谢你把它们带来。";
		mes "不过从你的穿着来看，";
		mes "我能看出你是一名冒险者。";
		mes "那个本来应该送书来的配送员，";
		mes "到底发生了什么事？";
		next;
		mes "[历史学家]";
		mes "..........？";
		mes "害怕乘飞艇？";
		mes "晕船？嗯，这倒可以理解。";
		mes "那个可怜的孩子，";
		mes "应该提前联系我说明情况的。";
		mes "这样我也能另作安排。";
		next;
		mes "[历史学家]";
		mes "天哪，我已经";
		mes "有一阵子没接待访客了。";
		mes "你愿意留下来聊一会儿吗？";
		mes "先给我一分钟，";
		mes "让我拿杯凉水来~";
		mes "很快就回来。";
		set prt_curse,4;
		delitem 7431,1; //Books
		close;
	}
	else if (prt_curse == 4) {
		mes "[历史学家]";
		mes "啊，那杯水正好让我";
		mes "恢复了精神。让我来";
		mes "给你讲讲我的工作吧。";
		mes "先从一点小事说起。";
		mes "请听我慢慢解释。";
		next;
		mes "[历史学家]";
		mes "我之前可能提过，我叫卡洛莫夫，";
		mes "是莱肯贝尔历史研究组的首席学者。我们";
		mes "最近刚完成了关于施瓦茨瓦尔德共和国的项目。";
		next;
		mes "[历史学家]";
		mes "现在，我们正试图进一步了解";
		mes "卢恩-米德加尔特王国的历史。我们认为";
		mes "它与施瓦茨瓦尔德共和国有关，";
		mes "因为两国位于同一片大陆。";
		mes "这样解释合理吧？";
		mes "至少目前看来是这样。";
		next;
		mes "[历史学家]";
		mes "最终，我们希望关于卢恩-米德加尔特的";
		mes "新研究资料能够为我们理解";
		mes "施瓦茨瓦尔德共和国的过去";
		mes "带来一些新的启示。";
		mes "也许会改变我们现在的认识。";
		mes "这正是研究的意义所在。";
		next;
		mes "[历史学家]";
		mes "包括我在内，莱肯贝尔";
		mes "历史研究组共有^3131FF3 名成员^000000，";
		mes "正在研究卢恩-";
		mes "米德加尔特王国的历史。";
		mes "我们各自负责不同的领域。";
		next;
		select("莱肯贝尔历史研究组？");
		mes "[历史学家]";
		mes "来自卢恩-米德加尔特的冒险者，";
		mes "可能不知道这一点，但莱肯贝尔公司";
		mes "实际上控制着我们的";
		mes "施瓦茨瓦尔德共和国。";
		mes "有人对此憎恨不已，";
		mes "也有人根本不在乎。";
		next;
		mes "[历史学家]";
		mes "总之，莱肯贝尔设立自己的";
		mes "历史研究组，是因为重新发现古代技术";
		mes "一直是它取得成功的关键，至少据我所知如此。";
		mes "至于我个人，我很享受追求知识的过程。";
		next;
		mes "[历史学家]";
		mes "哦，这里有个有趣的事实！";
		mes "你知道卢恩-米德加尔特的";
		mes "统治者头衔，";
		mes "并不总是由同一个家族";
		mes "世代传承吗？";
		next;
		mes "[历史学家]";
		mes "实际上，有几个王族会举办";
		mes "特殊竞赛，来决定";
		mes "哪位王子成为";
		mes "下一任国王。真有意思……";
		mes "你不觉得吗？";
		next;
		select("几个王族？");
		mes "[历史学家]";
		mes "是的，我尽量简短地解释一下。";
		mes "总共有 7 个王族，";
		mes "每个家族都源自";
		mes "建立卢恩-米德加尔特王国的";
		mes "7 位勇士中的一位。";
		mes "他们的后代延续至今。";
		next;
		mes "[历史学家]";
		mes "根据记录，";
		mes "大地之蛇耶梦加得出现了，";
		mes "给整片大陆带来混乱。";
		mes "7 位勇士挺身而出，赶走了巨蛇，拯救了世界。";
		mes "这就是故事的开端。";
		next;
		mes "[历史学家]";
		mes "和平恢复后，";
		mes "7 位勇士建立了卢恩-米德加尔特王国，";
		mes "并选择特里斯坦·格奥博格三世";
		mes "作为王国的第一位统治者。";
		mes "这就是王国的起源。";
		next;
		mes "[历史学家]";
		mes "7 位勇士知道他们的后代";
		mes "未必永远适合统治王国，";
		mes "于是约定每一代都在各家族之间举行竞赛，";
		mes "以防止王权腐败。";
		next;
		emotion ET_PROFUSELY_SWEAT;
		mes "[历史学家]";
		mes "哦……你对历史不太感兴趣，";
		mes "对吧？那么，";
		mes "也许我唱一遍这个传说的古老歌谣，";
		mes "你就能更好地理解了……";
		mes "要不要听听看？";
		next;
		mes "[历史学家]";
		mes "^FF0000*巨大的蛇吞下了大海。*^000000";
		mes "^FF0000*彩虹之鹰吞下了巨蛇。*^000000";
		mes "^FF0000*然后巨鹰筑起了巢。*^000000";
		mes "^FF0000*巢穴建在被吞下的海上。*^000000";
		mes "^FF0000*这就是古老的歌谣。*^000000";
		mes "^FF0000*传说至今仍在流传。*^000000";
		next;
		mes "[历史学家]";
		mes "^333333*咳咳*^000000 如你所见，我";
		mes "完全没有音乐细胞。";
		mes "不过重点是，人们至今仍通过这首歌";
		mes "赞颂 7 位勇士的功绩。";
		mes "知道这些是不是很有意思？";
		mes "这段历史值得记住。";
		set prt_curse,5;
		close;
	}
	else if (prt_curse == 5) {
		mes "[历史学家]";
		mes "抱歉，我刚才讲卢恩-";
		mes "米德加尔特的历史讲得太久，";
		mes "一不小心就说个没完。";
		mes "不过我希望这个故事";
		mes "至少让你觉得有点有趣。";
		mes "下次我会讲得更简短些。";
		next;
		mes "[历史学家]";
		mes "哦！你要回卢恩-米德加尔特王国吗？";
		mes "如果是这样，我想拜托你一件事。";
		mes "能请你把我写好的这份报告";
		mes "送给我在梦罗克的同事吗？";
		mes "她应该就在那座沙漠城市里。";
		next;
		mes "[历史学家]";
		mes "如果你能尽快把报告交给她，";
		mes "那就帮了我大忙。";
		mes "哦，她的名字叫罗达弗里安。";
		mes "我相信你能在那座沙漠城市的";
		mes "某个地方找到她。";
		mes "拜托你了。";
		set prt_curse,6;
		getitem 7342,1; //File01
		//changequest 18030,18031;// custom addition to make the script consistent
		close;
	}
	else if (prt_curse == 6) {
		mes "[历史学家]";
		mes "请在梦罗克找到我的同事";
		mes "罗达弗里安，把报告交给她。";
		mes "你应该能在那里找到她进行研究。";
		mes "她最近一直待在那座城市。";
		mes "记得把报告交给她。";
		next;
		if (select("我会的:我能再听一遍那首歌吗？") == 1) {
		mes "[历史学家]";
			mes "再次感谢你的帮助。";
			mes "这会大大加快我的研究进度，";
			mes "尤其是那些书送来得相当晚……";
			mes "我终于可以继续工作了。";
			mes "这对我来说非常重要。";
			mes "真的很感谢你。";
		}
		else {
		mes "[历史学家]";
			mes "歌？哦，你是说那首赞颂";
			mes "建立卢恩-米德加尔特";
			mes "王国的 7 位勇士的歌吗？";
			mes "当然，让我想想……";
			next;
		mes "[历史学家]";
			mes "^FF0000*巨大的蛇吞下了大海。*^000000";
			mes "^FF0000*彩虹之鹰吞下了巨蛇。*^000000";
			mes "^FF0000*然后巨鹰筑起了巢。*^000000";
			mes "^FF0000*巢穴建在被吞下的海上。*^000000";
			mes "^FF0000*这就是古老的歌谣。*^000000";
			mes "^FF0000*传说至今仍在流传。*^000000";
			next;
		mes "[历史学家]";
			mes "看来你比我想象中更喜欢历史。";
			mes "如果你愿意，我可以给你写一封";
			mes "介绍信或推荐信，";
			mes "送到莱肯贝尔历史研究组。";
			mes "哈哈哈~";
			mes "他们一定会欢迎你的。";
		}
		close;
	}
	else if (prt_curse > 55) {
		mes "[历史学家]";
		mes "啊，距离上次见你已经过了";
		mes "一段时间。罗达弗里安几天前";
		mes "还特意来拜访过我。";
		mes "我觉得她是来炫耀";
		mes "或者威胁我的……";
		mes "真让人摸不着头脑。";
		next;
		mes "[历史学家]";
		mes "那感觉非常不真实。";
		mes "她不停地谈论某个惊人的发现，";
		mes "还说终于要让我认清自己的位置。";
		mes "我以前真不知道她";
		mes "竟然这么争强好胜！";
		mes "她到底想做什么呢？";
		close;
	}
	else {
		mes "[历史学家]";
		mes "呼呼……";
		mes "呼呼……ZZZ……";
		close;
	}
}

morocc_in,45,126,3	script	Historian#prt02	702,{
	if ((MaxWeight-Weight) < 2000 || checkweight(1201,1) == 0) {
		mes "^3355FF请等一下！";
		mes "你现在携带的物品太多了。";
		mes "请使用卡普拉服务，";
		mes "存放一些物品后再回来。";
		mes "这样就能腾出空间了。";
		mes "请先存放一些物品。^000000";
		close;
	}
	if (prt_curse == 6) {
		if (countitem(7342) < 0) {
			mes "^3355FF你似乎把卡洛莫夫的报告弄丢了。";
			mes "你本来应该把它送到这里，";
			mes "交给他的某位同事……";
			mes "现在可怎么办呢？";
			close;
		}
		mes "[历史学家罗达弗里安]";
		mes "哦，这地方怎么会这么热？";
		mes "这对我的皮肤可不好……";
		mes "唉，我真希望自己已经回到";
		mes "施瓦茨瓦尔德共和国的家里了~";
		mes "那里舒服多了。";
		emotion ET_CRY;
		next;
		mes "[历史学家罗达弗里安]";
		mes "你好。";
		mes "请、请问，";
		mes "嗯，我能帮你吗？";
		next;
		select("卡洛莫夫先生派我来的。");
		mes "[历史学家罗达弗里安]";
		mes "卡洛莫夫……？";
		mes "是他？好吧……";
		mes "他为什么派你来";
		mes "找我？";
		next;
		mes "^3355FF你把卡洛莫夫的报告";
		mes "交给了罗达弗里安。^000000";

		mes "[Dracula]";
mes "我们回去吧。我累了，想睡觉。";
npctalk "让我和你一起去吧。我想陪你直到完全恢复。", "Jojo#ilgf01", bc_self;
		next;
		emotion ET_ANGER, getnpcid(0, "King#ilgf02");
		specialeffect EF_PORTAL4, AREA, "King#ilgf02";

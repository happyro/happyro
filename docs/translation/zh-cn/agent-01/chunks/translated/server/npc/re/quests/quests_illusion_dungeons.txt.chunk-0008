	if (ill_vampire == 14 || ill_vampire == 15) {
		mes "[Bomi]";
mes "你不是说要回去报告吗？去出口吧。我在那里闻到了你朋友的气味。";
		close;
	}
	switch( checkquest(14674,PLAYTIME) ) {
	case -1:
		break;
	case 0:
	case 1:
		if (mobcount("gef_d01_i", "ill_vampire_spawn_dracula::OnMobDead") < 1) {
			mes "[Bomi]";
mes "冒险者，谢谢你努力帮助我，但我不想让你太勉强。现在先休息一下吧？";
			next;
			mes "[Bomi]";
mes "黎明后再回来。";
			close;
		}
		mes "[Bomi]";
mes "我现在不在。黎明后再回来。";
		close;
	case 2:
		if (mobcount("gef_d01_i", "ill_vampire_spawn_dracula::OnMobDead") < 1) {
			mes "[Bomi]";
mes "冒险者，欢迎回来。今天也能像往常一样帮我吗？";
			.@npc_name$ = "Bomi";
		}
		else {
			mes "[" + .@player_name$ + "]";
mes "波米不在。她留下了一张字条。";
			.@npc_name$ = "Bomi's Note";
		}
		next;
		mes "[" + .@npc_name$ + "]";
mes "我需要^0000cd10 个哑光排水龙的黏血和 10 个霓虹蘑菇的蘑菇汁^000000。至少狩猎^0000cd5 只哑光排水龙和 5 只霓虹蘑菇^000000就能获得。";
		next;
		mes "[" + .@npc_name$ + "]";
mes "谢谢你的帮助。";
		erasequest 14674;// Time to Digest
		setquest 14671;// Unreliable Fake Blood
		close;
	}
	switch( checkquest(14671,HUNTING) ) {
	case -1:
		//if (mobcount("gef_d01_i", "ill_vampire_spawn_dracula::OnMobDead") > 0) {// unknown text
		mes "[Bomi]";
mes "冒险者，你已经报告过了吗？还要在这里做别的事吗？";
		next;
		mes "[Bomi]";
mes "如果你不忙，能帮我做件事吗？";
		next;
		if (select( "当然。", "我现在有点忙。") == 2) {
			mes "[Bomi]";
mes "哦，是吗？抱歉。也许你可以晚点再来？不，算了。";
			close;
		}
		mes "[Bomi]";
mes "如你所知，我靠用这里找到的材料制作的假血生存。我也在考虑再给德古拉做一些。";
		next;
		mes "[Bomi]";
mes "但这种假血不纯，定期饮用会让毒素在体内积累，直到完全排出前都会让你发疯。";
		next;
		mes "[Bomi]";
mes "不过也许只有我会这样。我是新生吸血鬼，很弱。德古拉活了很久，他一点也不弱。";
		setquest 14671;// Unreliable Fake Blood
		next;
		mes "[Bomi]";
mes "总之，我需要^0000cd10 个哑光排水龙的黏血和 10 个霓虹蘑菇的蘑菇汁^000000。";
		next;
		mes "[Bomi]";
mes "至少狩猎^0000cd5 只哑光排水龙和 5 只霓虹蘑菇^000000就能找到它们。";
		close;
	case 0:
	case 1:
		if (mobcount("gef_d01_i", "ill_vampire_spawn_dracula::OnMobDead") > 0) {
			mes "[" + .@player_name$ + "]";
mes "波米不在。我把这些放在这里就走。";
			next;
			mes "[" + .@player_name$ + "]";
mes "我好像忘了什么。";
			close;
		}
		mes "[Bomi]";
mes "冒险者，你忘了我的请求吗？我需要^0000cd10 个哑光排水龙的黏血和 10 个霓虹蘑菇的蘑菇汁^000000。谢谢。";
		close;
	case 2:
		if (countitem(25268) < 10 || countitem(25269) < 10) {
			if (mobcount("gef_d01_i", "ill_vampire_spawn_dracula::OnMobDead") > 0) {
				mes "[" + .@player_name$ + "]";
mes "波米不在。我把这些放在这里就走。";
				next;
				mes "[" + .@player_name$ + "]";
mes "我好像忘了什么。";
				close;
			}
			mes "[Bomi]";
mes "冒险者，你忘了我的请求吗？我需要^0000cd10 个哑光排水龙的黏血和 10 个霓虹蘑菇的蘑菇汁^000000。谢谢。";
			close;
		}
		if (mobcount("gef_d01_i", "ill_vampire_spawn_dracula::OnMobDead") > 0) {
			mes "[" + .@player_name$ + "]";
mes "波米不在。我把这些放在这里就走。";
			delitem 25268,10;// Sticky_Blood
			delitem 25269,10;// Mushroom_Sap
			erasequest 14671;// Unreliable Fake Blood
			setquest 14674;// Time to Digest
			getexp 500000,500000;
			getitem 25271,1;// Illusion Stone
			close;
		}
		mes "[Bomi]";
mes "冒险者，谢谢你把这些带给我。";
		delitem 25268,10;// Sticky_Blood
		delitem 25269,10;// Mushroom_Sap
		erasequest 14671;// Unreliable Fake Blood
		setquest 14674;// Time to Digest
		getexp 500000,500000;
		getitem 25271,1;// Illusion Stone
		if (mobcount("gef_d01_i", "ill_vampire_spawn_bomi::OnMobDead") < 1 && mobcount("gef_d01_i", "ill_vampire_spawn_dracula::OnMobDead") < 1) {
			if (.bomi_count < 30)
				.bomi_count++;
		}
		next;
		if (.bomi_count == 29) {
			mes "[Bomi]";
mes "顺便说，我告诉过你这种假血的危险。记得吗？它会在我的体内留下毒素。";
			next;
			mes "[Bomi]";
mes "现在我的体内有太多毒素，感觉自己正在变成怪物。";
			next;
			mes "[Bomi]";
mes "我不能像以前那样熬过去了。";
mes "尤其现在还有人需要担心。";
			next;
			mes "[Bomi]";
mes "当我变成怪物时，我希望你阻止我伤害他们。求你帮帮我。";
			next;
			mes "[Bomi]";
mes "那就黎明后再回来。";
			close;
		}
		if (.bomi_count == 30) {
			mes "[Bomi]";
mes "我手头的材料用完了。";
			next;
			mes "[Bomi]";
mes "如果我这样混合后喝下去……";
			specialeffect EF_PHARMACY_OK;
			next;
			disablenpc( "Wizard#ilgf01" );
			specialeffect EF_DEVIL;
			mes "[Bomi]";
mes "糟糕！我的体内有太多毒素。情况越来越危险了！";
			if (mobcount("gef_d01_i", "ill_vampire_spawn_bomi::OnMobDead") < 1 && mobcount("gef_d01_i", "ill_vampire_spawn_dracula::OnMobDead") < 1) {
				.bomi_count = 0;
				donpcevent "ill_vampire_spawn_bomi::OnStart";
			}
			close;
		}
		mes "[Bomi]";
mes "如果我喝下这种毒血大约 30 次，也许会变身？哦，算了。";
		next;
		mes "[Bomi]";
mes "那就黎明后再回来。";
		close;
	}
	end;

OnTouch:
	if (ill_vampire == 7) {
		setpcblock PCBLOCK_NPC, true;
		npctalk "这个和霓虹蘑菇的颜色不同。是新品种吗？我最好小心地采摘……", "", bc_self;
		sleep2 1000;
		setpcblock PCBLOCK_NPC, false;
		unittalk getcharid(3), "" + strcharinfo(0) + "：典型的巫师……等等，那会是乔乔吗？？", bc_self;
	}
	else if (ill_vampire == 12 || ill_vampire == 13) {
		cloakoffnpcself( "Gem#ilgf02" );
		cloakoffnpcself( "Marina#ilgf02" );
		cloakoffnpcself( "Antoine#ilgf02" );
		if (ill_vampire == 13) {
			cloakoffnpcself( "Dracula#ilgf03" );
			cloakoffnpcself( "King#ilgf02" );
			cloakoffnpcself( "Jojo#ilgf01" );
		}
	}
	end;

OnInit:
	// todo: missing questinfo ?

	.@main_completed$ = "isbegin_quest(14666) == 2";
	questinfo( QTYPE_QUEST, QMARK_YELLOW, (.@main_completed$ + " && checkquest(14674,PLAYTIME) == -1 && checkquest(14671,HUNTING) == -1") );
	questinfo( QTYPE_QUEST, QMARK_YELLOW, (.@main_completed$ + " && checkquest(14671,HUNTING) == 2 && countitem(25268) > 9 && countitem(25269) > 9") );
	questinfo( QTYPE_QUEST, QMARK_YELLOW, (.@main_completed$ + " && checkquest(14674,PLAYTIME) == 2") );

	if (strnpcinfo(0) == "Wizard#ilgf001")
		disablenpc();
	end;
}
gef_d01_i,81,135,3	duplicate(Wizard#ilgf01)	Wizard#ilgf001	4_NFCOFFIN,5,5

gef_d01_i,82,132,3	duplicate(dummy_npc)	Mushroom#ilgf01	ILL_BLACK_MUSHROOM
gef_d01_i,86,133,1	duplicate(dummy_cloaked_npc)	Dracula#ilgf01	4_DRACULA


// Boss spawn
gef_d01_i,1,1,5	script	ill_vampire_spawn_bomi	-1,{
	end;
OnStart:
	sleep 1000;
	mapannounce "gef_d01_i", "不好……	我能感觉到毒素正在体内扩散……！", bc_map, 0xFF0000;
	if (mobcount("gef_d01_i", "ill_vampire_spawn_bomi::OnMobDead") < 1 && mobcount("gef_d01_i", "ill_vampire_spawn_dracula::OnMobDead") < 1) {
		monster "gef_d01_i",84,135,"Berserk Bomi",3756,1,"ill_vampire_spawn_bomi::OnMobDead";
	}
	end;
OnMobDead:
	enablenpc( "Wizard#ilgf001" );
	disablenpc( "Dracula#ilgf02" );
	mapannounce "gef_d01_i", "波米陷入了漫长而深沉的睡眠。", bc_map, 0x00ff00;
	mapannounce "gef_d01_i", "愤怒的德古拉：谁敢伤害我的波米？！", bc_map, 0x00ff00;
	sleep 1000;
	if (rand(2) == 1)
		mapannounce "gef_d01_i", "愤怒的德古拉：放开波米！来和我战斗！", bc_map, 0xFF0000;
	else
		mapannounce "gef_d01_i", "愤怒的德古拉：波米需要休息。我来对付你！", bc_map, 0xFF0000;
	killmonster "gef_d01_i", "ill_vampire_spawn_bomi::OnMobDead";
	killmonster "gef_d01_i", "ill_vampire_spawn_dracula::OnMobDead";
	monster "gef_d01_i",0,0,"Angry Dracula",3757,1,"ill_vampire_spawn_dracula::OnMobDead";
	end;
}

gef_d01_i,1,1,5	script	ill_vampire_spawn_dracula	-1,{
	end;
OnMobDead:
	killmonster "gef_d01_i", "ill_vampire_spawn_bomi::OnMobDead";
	killmonster "gef_d01_i", "ill_vampire_spawn_dracula::OnMobDead";
	mapannounce "gef_d01_i", "愤怒的德古拉：波米该醒来了。人类，别忘了你们的承诺！", bc_map, 0x00ff00;
	sleep 2000;
	mapannounce "gef_d01_i", "波米从漫长而深沉的睡眠中苏醒了。", bc_map, 0x00ff00;
	if (mobcount("gef_d01_i", "ill_vampire_spawn_bomi::OnMobDead") < 1) {
		disablenpc( "Wizard#ilgf001" );
		enablenpc( "Wizard#ilgf01" );
        enablenpc "Dracula#ilgf02";
	}
	end;

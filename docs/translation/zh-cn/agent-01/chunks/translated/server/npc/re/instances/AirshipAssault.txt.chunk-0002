1@air2,229,54,5	script	Fenrir#air2	4_F_FENRIR,{
	if ('airship_status != 6)
		end;
	cutin "fenrir_a",2;
	mes "[芬里尔]";
	mes "……这些混蛋没完没了地来。";
	next;
	cutin "h_guardian2",1;
	mes "[?????]";
	mes "果然，我们的直觉没错。跟随邪恶的波动来到这里，收获颇丰。";
	next;
	cutin "h_iris01",2;
	mes "[艾莉丝]";
	mes "……？？谁在那里！！";
	next;
	cutin "h_guardian2",1;
	mes "[?????]";
	mes "让我来介绍……";
	next;
	mes "[?????]";
	mes "希瓦！巴萨拉！拉克希米！";
	mes "我们是无敌的游侠！";
	next;
	cutin "h_guardian1",1;
	mes "[守护女英雄]";
	mes "守护女英雄！！";
	next;
	cutin "h_chaos02",2;
	mes "[混沌]";
	mes "......";
	next;
	cutin "fenrir_a",2;
	mes "[芬里尔]";
	mes "......";
	next;
	cutin "h_guardian1",1;
	mes "[希瓦]";
	mes "嗯？你们是什么反应？大家好像都很冷淡……是不是太夸张了？";
	next;
	mes "[巴萨拉]";
	mes "嗯，不，不。大家只是被我们精彩的登场迷住了。";
	next;
	mes "[拉克希米]";
	mes "没错，没错。英雄登场弄这么大阵仗确实有点过头！！";
	next;
	cutin "h_iris02",2;
	mes "[艾莉丝]";
	mes "噗……";
	mes "噗哈哈哈哈哈哈哈";
	next;
	mes "[艾莉丝]";
	mes "什么？这些笨蛋是谁？！";
	mes "看看他们的衣服！！";
	mes "那是舞台服装吗？他们是明星，不是英雄？";
	next;
	cutin "h_guardian3",1;
	mes "[希瓦]";
	mes "哼。你根本什么都不懂！";
	mes "你知道这些衣服有多贵吗？不懂最新时尚的人就是这样~";
	next;
	mes "[巴萨拉]";
	mes "你们几个！现在不是聊天的时候！让我们消灭邪恶的波动！！";
	next;
	mes "[希瓦]";
	mes "收到，巴萨拉！用迅猛的攻击结束它！！";
	mes "风魔金属手里剑！！喝呀！";
	next;
	cutin "",255;
	mes "- 啪！啪啪！";
	donpcevent instance_npcname("Gremlin#1air2") + "::OnExplosion1";
	next;
	cutin "h_iris01",2;
	mes "[艾莉丝]";
	mes "什么，他们到底是什么……彻头彻尾的笨蛋……";
	next;
	cutin "h_arcana02",2;
	mes "[阿卡娜]";
	mes "哦？哎呀！";
	mes "意外的盟友？";
	mes "这场派对可能会很有趣~";
	next;
	cutin "fenrir_a",2;
	mes "[芬里尔]";
	mes "等等！";
	mes "现在结束这场派对比较好……这是什么？是芙蕾雅派你来的吗？";
	next;
	cutin "h_arcana02",2;
	mes "[阿卡娜]";
	mes "哦，你无所畏惧。";
	mes "区区卑微的人类，竟敢说出芙蕾雅的名字。";
	next;
	cutin "fenrir_a",2;
	mes "[芬里尔]";
	mes "果然，你是芙蕾雅的棋子？";
	next;
	cutin "h_arcana01",2;
	mes "[阿卡娜]";
	mes "……小心。如果你继续这样下去……";
	mes "你会受到神罚！";
	next;
	donpcevent instance_npcname("Gremlin#1air2") + "::OnExplosion1";
	cutin "fenrir_b",2;
	mes "[芬里尔]";
	mes "...!!";
	next;
	cutin "h_arcana02",2;
	mes "[阿卡娜]";
	mes "好~ 我给你们看点好东西。让你们冷静一下。";
	next;
	cutin "fenrir_b",2;
	mes "[芬里尔]";
	mes "难道是……飞龙之息？！！";
	next;
	cutin "h_arcana02",2;
	mes "[阿卡娜]";
	mes "宾果~";
	next;
	cutin "",255;
	mes "[飞龙]";
	mes "呜哦……！！";
	next;
	cutin "fenrir_b",2;
	mes "[芬里尔]";
	mes "不……不！！船！！";
	next;
	enablenpc instance_npcname("Loki#air2");
	specialeffect EF_SUI_EXPLOSION,AREA, instance_npcname("Loki#air2");
	cutin "",255;
	mes "- 轰！！！";
	next;
	cutin "fenrir_a",2;
	mes "[芬里尔]";
	mes "……？！洛基！！";
	next;
	cutin "ep14_roki02",2;
	mes "[洛基]";
	mes "嗯……";
	mes "我的新衣服毁了……";
	next;
	cutin "h_arcana02",2;
	mes "[阿卡娜]";
	mes "哦……你把飞龙之息反弹回来了……真是意外。不过你能挡住这个吗？";
	next;
	cutin "",255;
	mes "[飞龙]";
	mes "呜哦……！！";
	next;
	cutin "ep14_roki02",2;
	mes "[洛基]";
	mes "烦人的害虫……";
	mes "你！我对付一个，你对付另一个……";
	close2;
	cutin "",255;
	if ('airship_status == 6)
		donpcevent instance_npcname("calla#air2") + "::OnStart";
	end;
}


1@air1,88,189,5	script	Iris#2air1	4_F_IRIS,{
	if ('airship_status == 4) {
		cutin "h_chaos02",2;
	mes "[混沌]";
		mes "该死……它们已经到这里了！多亏了你，卢恩引擎才得以守住。";
		next;
		cutin "h_iris01",2;
	mes "[艾莉丝]";
		mes "呃……哦！！有只哥布灵正朝引擎室去！！";
		next;
		cutin "h_chaos03",2;
	mes "[混沌]";
		mes "……！！我们必须阻止它！！";
		next;
		cutin "",255;
	mes "[哥布灵]";
		mes "吱吱……！！";
		if ('airship_status == 4) {
			hideonnpc instance_npcname("Gremlin#2aair1");
			donpcevent instance_npcname("#airshipputmob3") + "::OnStart";
			donpcevent instance_npcname("firecontrol#air2") + "::OnStart";
			'airship_status = 5;
		}
		next;
	}
	if ('airship_status == 5) {
		specialeffect EF_SUI_EXPLOSION,AREA, instance_npcname("Gremlin#2aair1");
		mes "- 啪！啪啪！";
		next;
		cutin "h_iris01",2;
	mes "[艾莉丝]";
		mes "呀！！";
		next;
		cutin "",255;
	mes "[船员]";
		mes "啊！卢恩引擎！！引擎室爆炸了！！消防队！快灭火！！";
		next;
		cutin "h_chaos02",2;
	mes "[混沌]";
		mes "可恶！！这里太危险了！我们先离开！艾莉丝，快！！";
		close2;
		// 'airship_status = 6;// no consequence
		cutin "",255;
		disablenpc instance_npcname("Iris#2air1");
		disablenpc instance_npcname("Chaos#2air1");
		initnpctimer;
	}
	end;
OnTimer1000:
	mapannounce 'map_air1$, "击败敌人后，必须前往飞艇甲板。", bc_map,"0xFFFF00";
	stopnpctimer;
	end;
}


		mes "[Hibba Agip]";
		mes "我们决定将新发现的地方称为魔神殿。";
		mes "其实是第一位侦察员起的名字，后来就沿用了。";
		next;
		mes "[Hibba Agip]";
		mes "我想让你执行魔神殿讨伐任务。";
		mes "这不是命令，而是一份委托；";
		mes "是否接受任务由你决定，风险也由你自行承担。";
		next;
		if (select( "我来做。", "不。" ) == 2) {
			mes "[Hibba Agip]";
		mes "我明白，";
		mes "你不想为了世界和平赌上性命。";
		mes "那就享受活到世界末日吧。";
			close3;
		}
		mes "[Hibba Agip]";
		mes "我就知道选对人了。";
		mes "洛基说，魔神还没有完全恢复";
		mes "封印破裂时受到的伤势。";
		next;
		mes "[Hibba Agip]";
		mes "他还在舔舐伤口，";
		mes "这正是我们对付他的绝佳机会。";
		mes "祝你好运。";
		setquest 7593;// Demon God Subjugation
		close3;
	}
	if (isbegin_quest(7597) == 1) {
		mes "*吹口哨* 干得好！";
		mes "魔神殿怎么样？";
		mes "还是老样子吗？";
		next;
		mes "[Hiva Agip]";
		mes "拿好你的奖励。";
		mes "下次再见。";
		erasequest 7597;// Fall of the False God
		setquest 7598;// Caged God
		getitem 22567,1;// Squad_Prize
		getexp 1000000,500000;
		close3;
	}
	switch( checkquest(7598,PLAYTIME) ) {
	case -1:
		mes "我怎么也想不明白到底发生了什么。";
		mes "自从那个怪物宣称要取代神，这个地方就变得一团糟。";
		next;
		mes "[Hiva Agip]";
		mes "恐怕维度一旦扭曲，就再也无法恢复原状。";
		mes "你能再去一次魔神殿吗？";
		next;
		if (select( "当然。", "不。" ) == 2) {
			mes "[Hiva Agip]";
		mes "我明白了。";
		mes "你已经做得够多了。";
		mes "我会派其他人去。";
			close3;
		}
		mes "[Hiva Agip]";
		mes "魔神殿陷入了永恒的时间循环，";
		mes "就像其他次元裂缝一样。";
		next;
		mes "[Hiva Agip]";
		mes "他拼命想逃离这个世界，却始终徒劳无功。";
		mes "他的那个世界如今只剩下不断重复的地狱般记忆。";
		next;
		mes "[Hiva Agip]";
		mes "探索神殿时祝你好运。如果再次见到梦罗克，就毫不犹豫地再次杀死魔神。";
		mes "他不值得同情。";
		mes "愿神保佑你。";
		if (isbegin_quest(7593) == 0)
			setquest 7593;// Demon God Subjugation
		close3;
	case 0:
	case 1:
		mes "既然主体已经处理完了，我们可以慢慢来。";
		mes "你现在先去休息吧。";
		mes "剩下的交给我们。";
		close3;
	case 2:
		erasequest 7598;// Caged God
		mes "如果不是我已经知道，我真不敢相信你昨天经历了激战。";
		mes "准备好再次战斗了吗？";
		next;
		mes "[Hiva Agip]";
		mes "准备好后告诉我。";
		mes "梦罗克已经消失，但他的神殿仍然存在。";
		mes "这可能与次元裂缝有关。";
		next;
		mes "[Hiva Agip]";
		mes "哦，别担心。我没打算把你派到那里去。";
		mes "哈哈哈哈！";
		close3;
	}
	end;

OnInit:
	questinfo( QTYPE_QUEST2, QMARK_NONE, "BaseLevel >= 160 && ep4_3_mockill > 0 && !isbegin_quest(7593) && !isbegin_quest(7597) && !isbegin_quest(7598)" );
	questinfo( QTYPE_QUEST2, QMARK_NONE, "!isbegin_quest(7598) && !isbegin_quest(7593) && isbegin_quest(7597) == 1" );
	end;
}

moro_vol,110,90,3	script	Adjutant Abidal#14302	4_M_SAGE_C,{
	switch( checkquest(7599,PLAYTIME) ) {
	case -1:
		switch( checkquest(7594,HUNTING) ) {
		case -1:
			if (isbegin_quest(7593) == 1) {
				mes "[Abidal]";
				mes "你正在执行魔神殿讨伐任务吗？";
				mes "那请帮我一个忙。";
				mes "侦察员报告说，那里有一只接触过创世之霜的冰蜘蛛和火狼。";
				next;
				mes "[Abidal]";
				mes "它们和主人梦罗克一样邪恶。";
				mes "请消灭冰蜘蛛和火狼。";
				next;
				if (select( "接受。", "拒绝。" ) == 2) {
					mes "[Abidal]";
					mes "你是害怕自己对付不了它们吗？";
					mes "我理解。";
					mes "它们是很难对付的敌人。";
					close;
				}
				mes "[Abidal]";
				mes "谢谢你。";
				mes "火蜘蛛名为布里纳拉内亚；火狼名为穆斯佩尔斯科尔。";
				mes "请消灭那些魔神的眷属。";
				mes "祝你好运。";
				setquest 7594;// Frost Spider and Fire Wolf
				close;
			}
			mes "[Abidal]";
			mes "你是来帮助我们讨伐魔神的吗？";
			mes "请小心，这里的环境会毫无预兆地不断变化。";
			close;
		case 0:
		case 1:
			mes "[Abidal]";
			mes "根据我的情报，魔神有几个爪牙。";
			mes "我希望你消灭其中最大的威胁。";
			next;
			mes "[Abidal]";
			mes "这不会容易，但我相信你。";
			mes "米德加尔特的未来就托付给你了。";
			close;
		case 2:
			mes "[Abidal]";
			mes "你做到了！";
			mes "我就知道你可以！";
			mes "恭喜！";
			next;
			mes "[Abidal]";
			mes "但恐怕事情还没有结束。";
			mes "我总有一种不祥的预感。";
			mes "抱歉，也许是我想得太多了。";
			next;
			mes "[Abidal]";
			mes "我准备了一点小礼物表示感谢。";
			mes "抱歉，我只能做到这些。";
			mes "谢谢你的辛苦付出。";
			erasequest 7594;// Frost Spider and Fire Wolf
			setquest 7599;// Unending Hunt
			getitem 22567,1;// Squad_Prize
			close;
		}
	case 0:
	case 1:
		mes "[Abidal]";
		mes "你做得很好。去休息吧。";
		close;
	case 2:
		erasequest 7599;// Unending Hunt
		mes "[Abidal]";
		mes "休息好了吗？";
		mes "看起来你休息得不错。";
		mes "那太好了，因为我们正担心魔神殿。我们似乎无法关闭它。";
		next;
		mes "[Abidal]";
		mes "我可能还会请你消灭冰蜘蛛和火狼。";
		mes "魔神殿为什么不会消失呢？";
		close;
	}
	end;

OnInit:
	questinfo( QTYPE_QUEST2, QMARK_NONE, "BaseLevel >= 160 && !isbegin_quest(7594) && !isbegin_quest(7599) && isbegin_quest(7593) == 1" );
	end;
}

moro_vol,111,87,1	script	 Instructor Igrid#14303	4_M_CRU,{
	if (BaseLevel < 140) {
		mes "[Instructor Igrid]";
		mes "你。";
		mes "（摇头）你不行。";
		mes "你太弱了，无法与这些恶魔战斗。";
		mes "回去再训练一阵吧。";
		close;
	}
	switch( checkquest(7582,PLAYTIME) ) {
	case -1:
		switch( checkquest(7581,HUNTING) ) {
		case -1:
			mes "[Instructor Igrid]";
			mes "嘿，幸会。";
			mes "我需要你的帮助。";
			mes "从燃烧盆地涌出的恶魔中，有些实在令人头疼。";
			next;
			mes "[Instructor Igrid]";
			mes "梦罗克转生体也入侵了这里，其中一些尤其强大。";
			mes "我希望你消灭它们。";
			next;
			if (select( "为什么是我？", "没问题。" ) == 1) {
				mes "[Instructor Igrid]";
				mes "嗯，这出乎意料。";
				mes "我以为你来这里是为了保护米德加尔特的和平与繁荣，不是吗？";
				next;
				mes "[Instructor Igrid]";
				mes "也许我太高估你了。";
				mes "好吧，我去问别人。";
				mes "我真的对你很失望。";
				close;
			}
			mes "[Instructor Igrid]";
			mes "你没有让我失望。";
			mes "听着，盆地中央有一座高山。";
			mes "从中心向四个方向各有一只强大的恶魔游荡。";
			next;
			mes "[Instructor Igrid]";
			mes "它们看起来就像袭击梦罗克城的那些转生体，";
			mes "但体型更大，也更强。";
			next;
			mes "[Instructor Igrid]";
			mes "为了顺利完成讨伐任务，";
			mes "请^4d4dff消灭扭曲的梦罗克转生体、燃烧的梦罗克转生体和冻结的梦罗克转生体。^000000";
			mes "拜托你了。";
			setquest 7581;// Eliminating Risks
			close;
		case 0:
		case 1:
			mes "[Instructor Igrid]";
			mes "请^4d4dff消灭扭曲的梦罗克转生体、燃烧的梦罗克转生体和冻结的梦罗克转生体。^000000";
			mes "它们分别驻扎在盆地中心的四个方向。";
			close;
		case 2:
			mes "[Instructor Igrid]";
			mes "你真的消灭了那些强大的恶魔。";
			mes "这应该足以打击其余恶魔的士气。";
			mes "干得好。";
			next;
			mes "[Instructor Igrid]";
			mes "希望你能再回来帮助我。";
			mes "我们一起回家吧，好吗？";
			erasequest 7581;// Eliminating Risks
			setquest 7582;// Daily Cleaning
			getexp 1000000,800000;
			close;
		}
	case 0:
	case 1:
		mes "[Instructor Igrid]";
		mes "你。";
		mes "你是说那些巨大的转生体吗？";
		mes "我已经安排其他冒险者去处理它们了。";
		next;
		mes "[Instructor Igrid]";
		mes "今天你应该休息。明天再回来狩猎吧。";
		close;
	case 2:
		mes "[Instructor Igrid]";
		mes "差不多又到讨伐恶魔的时间了。";
		mes "你不兴奋吗？我可是很兴奋！哈哈！";
		erasequest 7582;// Daily Cleaning
		close;
	}
	end;

OnInit:
	questinfo( QTYPE_QUEST2, QMARK_NONE, "BaseLevel >= 140 && !isbegin_quest(7581) && !isbegin_quest(7582)" );
	end;
}

moro_vol,136,84,3	script	Jeruth Hesranta#ep143	4_MAN_JERUTOO,{
	if (checkweight(1304,3) == 0) {
		mes "你携带的物品太多，无法继续任务。";
		mes "请为背包腾出空间。";
		close;
	}
	cutin "ep13_heslanta.bmp",2;
	mes "[Jeruth Hesranta]";
	if (ep13_3_secret < 22) {
		mes "我是赫斯兰塔，萨帕军队的指挥官。";
		mes "能与人类并肩作战是我的荣幸。";
		close3;
	}
	if (ep13_3_secret < 24) {// custom translation
		mes "没想到会在这里见到你！";
		mes "……虽然发生了很多事，但我还在等你完成我最初交代的事情！";
		next;
		mes "[Jeruth Hesranta]";
		mes "请回来帮助我！";
		close3;
	}
	if (ep13_3_secret == 24) {
		mes "好久不见。";
		mes "你还记得我吗？";
		mes "我们以前在迪尔进行过一次重要的谈话。";
		next;
		select("你为什么在这里？");
		mes "[Jeruth Hesranta]";
		mes "我说服了长老们，让我带军队来到这里。";
		mes "正如你怀疑的那样，阿哈特不是萨帕。";
		next;
		mes "[Jeruth Hesranta]";
		mes "目前只有我知道这件事。";
		mes "其他人几乎都忘了他曾经存在过。";
		next;
		mes "[Jeruth Hesranta]";
		mes "我对他的持续怀疑使我免受阿哈特的催眠。";
		mes "他利用不可言说的能力消失了。";
		next;
		mes "[Jeruth Hesranta]";
		mes "他消失后，我说服长老们加入讨伐魔神的行动。";
		mes "其他萨帕出于种族安全考虑反对我，";
		next;
		mes "[Jeruth Hesranta]";
		mes "但不惜一切代价帮助朋友是我们的天性。";
		mes "所以我把我们最勇敢的加尔滕带到了战场。";
		next;
		mes "[Jeruth Hesranta]";
		mes "长话短说，";
		mes "你不必再为阿哈特工作了。";
		mes "如果你需要贡献证明，之后帮我一个忙，我就给你一张。";
		next;
		mes "[Jeruth Hesranta]";
		mes "你认识切舍尔，对吧？";
		mes "说到他，";
		mes "我无法信任其他人。";
		next;
		mes "[Jeruth Hesranta]";
		mes "在执行计划前，我想先收集关于他的情报。";
		mes "在我再次联系你之前，请务必保证安全。";
		ep13_3_secret = 25;
		ep13_3_ahtdayq = 0;
		if (isbegin_quest(7200) > 0)
			erasequest 7200;// Cheshire's call
		if (isbegin_quest(7201) > 0)
			erasequest 7201;// Removing traces
		getitem 6304,1;// Sapa_Feat_Cert
		delitem 6305, countitem(6305);	// Frozen_Skin_Piece
		delitem 6306, countitem(6306);	// Solid_Bloodstain
		delitem 6307, countitem(6307);	// Suspicious_Magic_Stone
		close3;
	}
	if (ep13_3_secret == 25) {
		if (BaseLevel < 140) {// custom translation
			mes "还记得我们谈过切谢尔吗？";
			mes "他是个敏感人物，所以我不能和其他萨帕谈论他。";
			next;
			mes "[Jeruth Hesranta]";
			mes "但是……你好像不太高兴，";
			mes "回去再多训练一会儿吧。";
			close3;
		}
		mes "还记得我们谈过切谢尔吗？";
		mes "他是个敏感人物，所以我不能和其他萨帕谈论他。";
		mes "我在想……";
		next;
		mes "[Jeruth Hesranta]";
		mes "也许你能帮我确认我的猜疑。";
		next;
		select("什么猜疑？");
		mes "[Jeruth Hesranta]";
		mes "有些东西似乎不属于这片火焰盆地。";
		mes "它们看起来像某种箱子。";
		next;
		mes "[Jeruth Hesranta]";
		mes "那些箱子被魔神的邪恶能量赋予了生命，正在盆地里横冲直撞。";
		mes "现在我很担心……";
		next;
		select("你很担心？");
		mes "[Jeruth Hesranta]";
		mes "它们和迪卡斯特斯的布拉迪姆箱子一模一样。";
		mes "你能消灭它们，帮我确认它们的身份吗？";
		next;
		mes "[Jeruth Hesranta]";
		mes "它们很可能就是切谢尔从迪卡斯特斯偷走的布拉迪姆箱子。";
		mes "如果真是这样，我就能用这些箱子补充军队。";
		next;
		select("还要取回被偷走的布拉迪姆。" );
		mes "[Jeruth Hesranta]";
		mes "没错。因为这次远征完全是我的主意，所以我的军队没有得到多少支援。";
		mes "这只是我的一厢情愿；拿到箱子前我们无法确定。";
		next;
		mes "[Jeruth Hesranta]";
		mes "现在请先猎杀一个箱子，告诉我你从里面发现了什么。";
		mes "我会等你。";
		setquest 7578;// Rampaging Box
		ep13_3_secret = 26;
		close3;
	}
	if (ep13_3_secret == 26) {
		if (checkquest(7578,HUNTING) != 2) {
			cutin "ep13_heslanta.bmp",2;
			mes "[Jeruth Hesranta]";
			mes "只要猎杀 1 个^4d4dff暴走箱^000000，把里面的东西带给我。";
			if (isbegin_quest(7578) == 0)
				setquest 7578;
			close3;
		}
		if (countitem(6392) < 1) {// Bradium_Box
		mes "看来你已经讨伐了暴走箱，";
		mes "但我的真正目的是检查它的内容物。";
		mes "^4d4dff请消灭一个箱子，把从里面找到的物品带给我。^000000";
			close3;
		}
		mes "我猜对了。";
		mes "这么一个有生命的物体竟能自行移动，真令人惊讶。";
		mes "它一定被施加了魔法，你不觉得吗？";
		next;
		mes "[Jeruth Hesranta]";
		mes "这证实了我的猜疑：";
		mes "火焰盆地的那些箱子就是迪卡斯特斯的布拉迪姆箱子。";
		next;
		mes "[Jeruth Hesranta]";
		mes "我不想过分利用你的善意，但希望你继续猎杀这些箱子。";
		mes "至少目前，你是我唯一能信任的人。";
		mes "加尔滕人很勇敢，但他们会想知道布拉迪姆箱子为何出现在这里。";
		next;
		mes "[Jeruth Hesranta]";
		mes "那我就必须把一切告诉他们，";
		mes "从阿哈特开始，而大多数萨帕已经忘了他，这会让事情变得非常复杂。";
		next;
		select("我什么时候开始？");
		mes "[Jeruth Hesranta]";
		mes "现在怎么样？";
		mes "^4d4dff请猎杀那些暴走箱，收集 10 个布拉迪姆箱子。^000000";
		delitem 6392,1;// Bradium_Box
		completequest 7578;// Rampaging Box
		setquest 7579;// Collecting Bradiums
		ep13_3_secret = 27;
		getexp 300000,300000;
		close3;
	}
	switch( checkquest(7580,PLAYTIME) ) {
	case -1:
		switch( checkquest(7579,HUNTING) ) {
		case 0:
			cutin "ep13_heslanta.bmp",2;
			mes "[Jeruth Hesranta]";
		mes "欢迎回来。";
		mes "今天准备好了吗？";
			break;
		case 1:
			cutin "ep13_heslanta.bmp",2;
			mes "[Jeruth Hesranta]";
		mes "暴走箱本身并不可怕，但周围有危险的魔物。请小心。";
			next;
			mes "[Jeruth Hesranta]";
		mes "狩猎顺利！";
			close3;
		case 2:
			if (countitem(6392) < 10) {
		mes "那些装满矿石的箱子竟然会自行移动，真不可思议。";
		mes "也许魔神就是这样招募士兵的。";
				close3;
			}
			cutin "ep13_heslanta.bmp",2;
			mes "[Jeruth Hesranta]";
		mes "干得好。";
		mes "我真不知该如何感谢你。";
		mes "让我把所有布拉迪姆箱子收下吧。";
			next;
			mes "[Jeruth Hesranta]";
		mes "我能感觉到其他人的目光。哈哈。";
		mes "下次再见。";
			delitem 6392, countitem(6392);// Bradium_Box
			erasequest 7579;// Collecting Bradiums
			setquest 7580;// Collecting Every Day
			getexp 800000,800000;
			getitem 6304,1;// Sapa_Feat_Cert
			close3;
		}
		break;
	case 0:
	case 1:
		mes "哈哈，我们现在不急。";
		mes "不知道切谢尔是否知道我们正在夺回他的布拉迪姆箱子。";
		next;
		mes "[Jeruth Hesranta]";
		mes "晚点该给可怜的猫喂什么呢？";
		mes "哦，继续努力收集布拉迪姆箱子吧。";
		break;
	case 2:
		cutin "ep13_heslanta.bmp",2;
		mes "[Jeruth Hesranta]";
		mes "该收集布拉迪姆箱子了。";
		erasequest 7580;// Collecting Every Day
		break;
	}

// Shurank
//============================================================
izlude_in,82,163,3	script	Shurank	733,{
	mes "[Shurank]";
	if(Class == Job_Novice || Class == Job_Baby){
	mes "还在思考";
	mes "未来该做什么，";
	mes "对吧？";
		next;
		mes "[Shurank]";
	mes "如果我可以直说，";
	mes "我建议你走力量之路。";
	mes "成为……剑士。";
		next;
		mes "[Shurank]";
	mes "如果你想将生命赌在剑之道路上，请和左侧的剑士协会代表谈谈。";
		next;
		mes "[Shurank]";
	mes "无论你做什么，";
	mes "我希望你一生无悔。如果你真的成为了剑士，";
	mes "再回来找我……";
		close;
	}
	if(BaseClass == Job_Swordman && (eaclass()&(EAJL_2|EAJL_UPPER|EAJL_THIRD))){
	mes "从你的服装来看，";
	mes "我看得出你是";
		if(Sex == SEX_MALE)
			mes "剑之男子。";
		else
			mes "剑之女子。";
	mes "你的眼睛告诉我，";
	mes "你经历过许多战斗。";
		next;
		mes "[Shurank]";
	mes "我没什么可以教你的了。不过如果认识有潜力的新剑士，请把他们介绍给我。";
		close;
	}
	if(BaseClass != Job_Swordman){
	mes "你好，冒险者。";
	mes "如果你认识";
		mes "新的剑士，";
		mes "请把他们介绍给我。";
		next;
		mes "[Shurank]";
		mes "我的专长是教导刚转职的新手剑士掌握剑士职业基础。";
		next;
		mes "[Shurank]";
		mes "虽然人人都能挥剑很好，";
		mes "但恐怕我没什么能有效教你的。你的职业方法对我来说……";
		mes "太陌生了。";
		close;
	}
	switch(tu_swordman){
	case 23:
		mes "你好，我的朋友。";
		mes "我已经没有更多";
		mes "可以教你的了……";
		next;
		mes "[Shurank]";
		mes "要提高技能，";
		mes "你必须探索广阔世界，经历各种战斗情境，并始终投入训练。";
		close;
	case 22:
		mes "这是我给你的";
		mes "最后一课。";
		mes "请仔细听我说明";
		mes "火焰冲击。";
		next;
		mes "[Shurank]";
		mes "10 级火焰冲击需要 ^5D478B5 级狂击^000000。使用时会对施法者周围敌人造成范围伤害。";
		next;
		mes "[Shurank]";
		mes "被火焰冲击击中的敌人会被火属性攻击击退。之后，你的武器暂时造成额外 20% 火属性伤害。";
		next;
		mes "[Shurank]";
		mes "火焰冲击适合被敌人包围时使用，但也会对施法者造成少量伤害。";
		next;
		set .@chk_magnum, getskilllv("SM_MAGNUM");
		if(.@chk_magnum > 5){
			mes "[Shurank]";
			mes "看来你一直在训练火焰冲击。虽然这是强力技能，但不是每个剑士都适合。不过学会它也没坏处。";
			next;
			mes "[Shurank]";
			mes "这是对你努力的小小奖励。";
			mes "但不要因才能而变得傲慢！";
			set tu_swordman, 23;
			completequest 8228;
			if (checkre(3))
				getexp 186,0;
			else
				getexp 1860,0;
			getitem 1113,1; //Scimiter
			next;
			mes "[Shurank]";
			mes "这就是我能教你的全部剑士技能。希望解答了你对职业和技能的疑问。";
			next;
			mes "[Shurank]";
			mes "至于那个杀人犯，";
			mes "事情已经不在我们手中。目前我们无法有效处理。";
			next;
			mes "[Shurank]";
			mes "不过，我希望你将";
			mes "了解到的信息保密。";
			mes "此事属于高度机密……";
			next;
			mes "[Shurank]";
			mes "总之，不必再担心了。但如果我们需要帮助，我会记得向你求助。";
			next;
			mes "[Shurank]";
			mes "你做得很好。继续训练，达到 ^5D478B职业等级 40^000000 后，就能转为骑士或十字军。";
			next;
			mes "[Shurank]";
			mes "嗯……";
			mes "我们剑士通常不感伤，但很高兴认识你。努力成为出色的剑士吧。";
			close;
		}
		mes "[Shurank]";
		mes "这就是我能教你的全部剑士技能。希望能解答你对职业和技能的疑问。";
		next;
		mes "[Shurank]";
		mes "至于那个杀人犯，事情已经不在我们手中。目前我们无法有效处理。";
		next;
		mes "[Shurank]";
		mes "不过，我希望你将了解到的信息保密。此事属于高度机密……";
		next;
		mes "[Shurank]";
		mes "总之，不必再担心了。但如果我们需要帮助，我会记得向你求助。";
		next;
		mes "[Shurank]";
		mes "你做得很好。继续训练，达到 ^5D478B职业等级 40^000000 后，就能转为骑士或十字军。";
		next;
		mes "[Shurank]";
		mes "嗯……";
		mes "我们剑士通常不感伤，但很高兴认识你。努力成为出色的剑士吧。";
		next;
		mes "[Shurank]";
		mes "离开前请收下这个。";
		mes "希望你在变强的训练中好好利用它。祝你好运。";
		set tu_swordman, 23;
		completequest 8228;
		getitem 1113,1; //Scimiter
		close;
	case 21:
		mes "啊，你回来了。我刚收到";
		mes "迪奎的信。看来你非常努力，也充分利用了这次经历。";
		next;
		mes "[Shurank]";
		mes "现在，我想你会从更多剑士技能知识中获益。先来介绍剑术专精。";
		next;
		mes "[Shurank]";
		mes "剑术专精分为两种：";
		mes "^5D478B单手剑熟练度^000000和";
		mes "^5D478BTwo Handed Sword Mastery^000000. Both";
		mes "它们是被动技能，等级越高，攻击力提升越多。";
		next;
		mes "[Shurank]";
		mes "单手剑专精";
		mes "会提高匕首和单手剑伤害，而双手剑专精会提高双手剑伤害。";
		next;
		set .@chk_hanson, getskilllv("SM_SWORD");
		set .@chk_yangson, getskilllv("SM_TWOHAND");
		if((.@chk_hanson > 9) || (.@chk_yangson > 9)){
			mes "[Shurank]";
			mes "啊，从你使用剑的方式来看，你已经掌握了剑术专精。真让我佩服。";
			next;
			mes "[Shurank]";
			mes "让我把这份小奖励";
			mes "送给你，";
			mes "以表彰";
			mes "你的成就。";
			set tu_swordman, 22;
			changequest 8227,8228;
			if (checkre(3))
				getexp 186,0;
			else
				getexp 1860,0;
			next;
			mes "[Shurank]";
			mes "下次我会继续讲解火焰冲击。";
			mes "准备好学习更多时，我会在这里等你。";
			close;
		}
		mes "[Shurank]";
		mes "下次我会继续讲解火焰冲击。";
		mes "准备好学习更多时，我会在这里等你。";
		set tu_swordman, 22;
		close;
	case 13:
		mes "你应该尽快离开，去吉芬见迪奎。你记得在哪里找到他吧？";
		close;
	case 12:
		mes "那么，你的";
		mes "霸体技能训练";
		mes "进展如何？";
		next;
		set .@chk_endure, getskilllv("SM_ENDURE");
		if(.@chk_endure > 1){
			mes "[Shurank]";
			mes "从你皮肤上闪耀的坚韧光芒，我看出自己问得多余。做得好～";
			set tu_swordman, 13;
			erasequest 8221;
			setquest 8222;
			if (checkre(3))
				getexp 126,0;
			else
				getexp 1260,0;
			next;
			mes "[Shurank]";
			mes "啊，我又有一项任务";
			mes "要交给你。请去吉芬拜访迪奎，看来他有事";
			mes "要请你帮忙。";
			next;
			mes "[Shurank]";
			mes "快去见迪奎，完成他要求的事后再回来找我。";
			close;
		} else {
			mes "[Shurank]";
			mes "嗯……";
			mes "你还没达到要求。";
			mes "在此期间，";
			mes "我鼓励你加倍努力！";
			close;
		}
	case 11:
		mes "那么你学会";
		mes "使用霸体技能了吗？";
		next;
		set .@chk_endure, getskilllv("SM_ENDURE");
		if((.@chk_endure > 0) && (.@chk_endure < 2)){
			mes "[Shurank]";
			mes "看来你知道如何使用霸体。";
			mes "不过复习一下使用要点也无妨……";
			next;
			mes "[Shurank]";
			mes "如你所见，受到伤害会让你痛苦地踉跄，瞬间陷入眩晕。因此快速攻击的敌人很危险，因为难以反击或逃脱。";
			next;
			mes "[Shunrank]";
			mes "发动霸体后可以承受攻击。虽然仍会受伤，但敌人攻击不会造成太大阻碍，你可以反击或逃跑。";
			next;
			mes "[Shurank]";
			mes "当然，霸体不能永远使用。不过，霸体技能等级越高，效果持续时间越长。记住霸体也有技能延迟。";
			next;
			mes "[Shurank]";
			mes "既然你已经学会霸体，我想不必再解释了。你做得很好。";
			erasequest 8221;
			setquest 8222;
			set tu_swordman, 13;
			next;
			mes "[Shurank]";
			mes "啊，我又有一项任务要交给你。请去吉芬拜访迪奎，看来他有事";
			mes "要请你帮忙。";
			next;
			mes "[Shurank]";
			mes "快去见迪奎，完成他要求的事后再回来找我。";
			close2;
			end;
		} else if(.@chk_endure > 1){
			mes "[Shurank]";
			mes "从你皮肤上闪耀的坚韧光芒，我看出自己问得多余。做得好～";
			set tu_swordman, 13;
			erasequest 8221;
			setquest 8222;
			if (checkre(3))
				getexp 126,0;
			else
				getexp 1260,0;
			next;
			mes "[Shurank]";
			mes "啊，我又有一项任务要交给你。请去吉芬拜访迪奎，看来他有事";
			mes "要请你帮忙。";
			next;
			mes "[Shurank]";
			mes "快去见迪奎，完成他要求的事后再回来找我。";
			close;
		} else {
			mes "[Shurank]";
		mes "没有……？";
		mes "我建议你尽快学会。霸体是剑士不可或缺的技能！";
			close;
		}
	case 10:
		mes "现在是时候";
		mes "告诉你我所知道的";
		mes "霸体技能了。";
		next;
		set .@chk_endure, getskilllv("SM_ENDURE");
		if(.@chk_endure == 0){
			mes "[Shurank]";
			mes "如你所见，受到伤害会让你痛苦踉跄，瞬间眩晕。因此快速攻击的敌人很危险，因为难以反击或逃脱。";
			next;
			mes "[Shunrank]";
			mes "发动霸体后可以承受攻击。虽然仍会受伤，但敌人攻击不会造成太大阻碍，你可以反击或逃跑。";
			next;
			mes "[Shurank]";
			mes "当然，霸体不能永远使用。不过霸体等级越高，效果持续时间越长。记住霸体也有技能延迟。";
			next;
			mes "[Shurank]";
			mes "好。现在我希望你训练霸体。";
			mes "如果能承受敌人的攻击，";
			mes "你就能成为伟大的剑士！";
			set tu_swordman, 11;
			changequest 8220,8221;
			close;
		} else if((.@chk_endure > 0) && (.@chk_endure < 2)){
			mes "[Shurank]";
			mes "看来你知道如何使用";
			mes "霸体技能。不过复习一下使用要点也无妨……";
			next;
			mes "[Shurank]";
			mes "如你所见，受到伤害会让你痛苦踉跄，瞬间眩晕。因此快速攻击的敌人很危险，因为难以反击或逃脱。";
			next;
			mes "[Shurank]";
			mes "发动霸体后可以承受攻击。虽然仍会受伤，但敌人攻击不会造成太大阻碍，你可以反击或逃跑。";
			next;
			mes "[Shurank]";
			mes "当然，霸体不能永远使用。不过霸体等级越高，效果持续时间越长。记住霸体也有技能延迟。";
			next;
			mes "[Shurank]";
			mes "既然你已经学会霸体，我想不必再解释了。你做得很好。";
			set tu_swordman, 13;
			erasequest 8221;
			setquest 8222;
			next;
			mes "[Shurank]";
			mes "啊，我又有一项任务要交给你。请去吉芬拜访迪奎，看来他有事";
			mes "要请你帮忙。";
			next;
			mes "[Shurank]";
			mes "快去见迪奎，完成他要求的事后再回来找我。";
			close;
		} else if(.@chk_endure > 1){
			mes "[Shurank]";
			mes "嗯。不过从你皮肤上闪耀的坚韧光芒来看，教你霸体是浪费时间。做得好！";
			set tu_swordman, 13;
			erasequest 8221;
			setquest 8222;
			if (checkre(3))
				getexp 126,0;
			else
				getexp 1260,0;
			next;
			mes "[Shurank]";
			mes "啊，我又有任务要交给你。请去吉芬拜访迪奎，看来他有事";
			mes "要请你帮忙。";
			next;
			mes "[Shurank]";
			mes "快去见迪奎，完成他要求的事后再回来。";
			close;
		}
	case 9:
		mes "那么你有没有继续学习";
		mes "使用挑衅技能？";
		next;
		set .@chk_provoke, getskilllv("SM_PROVOKE");
		if((.@chk_provoke > 4) && (.@chk_provoke < 10)){
			mes "[Shurank]";
			mes "啊，看来你已经相当了解挑衅技能了。让我用这份小礼物奖励你的努力。";
			set tu_swordman, 10;
			if (checkre(3))
				getexp 112,0;
			else
				getexp 1120,0;
			next;
			mes "[Shurank]";
			mes "下次见面时，我会告诉你 ^5D478B霸体^000000 技能。准备学习时再回来找我。";
			close;
		} else if(.@chk_provoke == 10){
			mes "[Shurank]";
			mes "你、你已经掌握";
			mes "挑衅了？真厉害！";
			mes "看来你已经决定";
			mes "成为";
			mes "出色的剑士。";
			mes "这是小小的奖励……";
			set tu_swordman, 10;
			if (checkre(3))
				getexp 126,0;
			else
				getexp 1260,0;
			next;
			mes "[Shurank]";
			mes "下次见面时，我会告诉你 ^5D478B霸体^000000 技能。准备学习时再回来找我。";
			close;
		} else {
			mes "[Shurank]";
			mes "嗯，我认可你的进步，";
			mes "但你还没达到要求。必须更熟练掌握挑衅，";
			mes "我才能继续讲课。";
			close;
		}
	case 8:
		mes "啊，你回来了。";
		mes "那么你的挑衅技能训练";
		mes "进展得";
		mes "怎么样？";
		next;
		set .@chk_provoke, getskilllv("SM_PROVOKE");
		if((.@chk_provoke > 0) && (.@chk_provoke < 5)){
			mes "[Shurank]";
			mes "啊，现在我看得出你会用了。";
			mes "比完全不会使用进步很多。我来复习挑衅的细节。";
			next;
			mes "[Shurank]";
			mes "要有效使用挑衅，必须理解它的作用：";
			mes "挑衅会激怒对手，让他们";
			mes "想攻击你。";
			next;
			mes "[Shurank]";
			mes "被挑衅后，敌人攻击力提高、更加危险，但防御降低，也更容易击败。";
			next;
			mes "[Shurank]";
			mes "理想情况下，可以在敌人足够虚弱时使用挑衅，更快击倒他们。但由你决定。";
			next;
			mes "[Shurank]";
			mes "挑衅等级越高，目标攻击力提升和防御力下降幅度越大。";
			next;
			mes "[Shurank]";
			mes "挑衅是主动技能，会像狂击一样消耗少量 SP。使用时注意不要耗尽 SP。";
			next;
			mes "[Shurank]";
			mes "好，熟练掌握挑衅后再来找我。在那之前继续训练。";
			set tu_swordman, 9;
			close;
		} else if((.@chk_provoke > 4) && (.@chk_provoke < 10)){
			mes "[Shurank]";
			mes "啊，看来你已经相当了解挑衅技能了。让我用这份小礼物奖励你的努力。";
			set tu_swordman, 10;
			if (checkre(3))
				getexp 112,0;
			else
				getexp 1120,0;
			next;
			mes "[Shurank]";
			mes "下次见面时，我会告诉你 ^5D478B霸体^000000 技能的知识。准备学习时再回来找我。";
			close;
		} else if(.@chk_provoke == 10){
			mes "[Shurank]";
			mes "你、你已经掌握";
			mes "挑衅了？真厉害！";
			mes "看来你已经决定";
			mes "成为";
			mes "出色的剑士。";
			mes "这是小小的奖励……";
			set tu_swordman, 10;
			if (checkre(3))
				getexp 126,0;
			else
				getexp 1260,0;
			next;
			mes "下次见面时，我会告诉你 ^5D478B霸体^000000 技能。准备学习时再回来找我。";
			close;
		} else {
			mes "[Shurank]";
			mes "还没学会挑衅吗？作为剑士，至少要会使用挑衅才行！";
			close;
		}

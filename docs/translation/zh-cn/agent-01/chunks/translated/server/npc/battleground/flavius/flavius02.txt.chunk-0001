bat_b02,10,294,3	script	Guillaume Vintenar#b02_a	934,{
	if ($@FlaviusBG2_id1 == getcharid(4)) {
		if ($@FlaviusBG2_Victory == 1)
			callfunc "F_BG_Badge",1,"Guillaume","Flavius";
		else
			callfunc "F_BG_Badge",0,"Guillaume","Flavius";
	}
	bg_leave;
	if (!getbattleflag("feature.bgqueue"))
		warp "bat_room",154,150;
	end;

OnInit:
	disablenpc "Guillaume Vintenar#b02_a";
	end;
}

bat_b02,389,14,3	script	Croix Vintenar#b02_b	934,{
	if ($@FlaviusBG2_id2 == getcharid(4)) {
		if ($@FlaviusBG2_Victory == 2)
			callfunc "F_BG_Badge",1,"Croix","Flavius";
		else
			callfunc "F_BG_Badge",0,"Croix","Flavius";
	}
	bg_leave;
	if (!getbattleflag("feature.bgqueue"))
		warp "bat_room",154,150;
	end;

OnInit:
	disablenpc "Croix Vintenar#b02_b";
	end;
}

bat_b02,1,5,3	script	countdown#bat_b02	844,{
OnInit:
	stopnpctimer;
	end;

OnEnable:
	stopnpctimer;
	initnpctimer;
	end;

OnStop:
	stopnpctimer;
	end;

OnTimer7000:
	mapannounce "bat_b02", "纪尧姆·温特纳·艾克斯尔·罗斯：进攻，摧毁那块水晶！",bc_map,"0xFF9900";
	end;

OnTimer8000:
	mapannounce "bat_b02", "克鲁瓦·温特纳·斯旺德里：纪尧姆虽在努力取胜，但胜利属于我们。让他们见识我们的力量。",bc_map,"0xFF99CC";
	end;

OnTimer1800000:
	mapannounce "bat_b02", "马罗洛七世：纪尧姆·马罗洛、克鲁瓦·马罗洛，以及他们的追随者！",bc_map,"0x99CC00";
	end;

OnTimer1803000:
	mapannounce "bat_b02", "马罗洛七世：双方势均力敌，很难判断哪支队伍更强。",bc_map,"0x99CC00";
	end;

OnTimer1808000:
	mapannounce "bat_b02", "马罗洛七世：这场弗拉维乌斯战斗真浪费时间。我会根据你们的进展决定胜负。",bc_map,"0x99CC00";
	end;

OnTimer1822000:
	mapannounce "bat_b02", "马罗洛七世：如果无法接受结果，就在另一场山谷战斗中再试一次！",bc_map,"0x99CC00";
	end;

OnTimer1825000:
	mapannounce "bat_b02", "艾克斯尔·罗斯、斯旺德里：是，长官。",bc_map,"0x99CC00";
	end;

OnTimer1830000:

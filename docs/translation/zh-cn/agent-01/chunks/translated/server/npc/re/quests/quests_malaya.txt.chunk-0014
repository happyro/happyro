		set malaya_bakona2,14;
		close;
	} else if (malaya_bakona2 == 14) {
		mes "陷阱设在这里。";
		next;
		mes "[Sentimental Worker]";
		mes "先试试陷阱吧！";
		mes "我真好奇会发生什么！";
		mes "一定会很有趣！";
		close;
	}
	end;
}

// Original name: "Bakonawa Introduction Quest Helper#bako1"
sec_in02,10,16,5	script	Bakonawa Intro Helper	543,{
	if (callfunc("F_GM_NPC",1854,0) < 1) {
		mes "海鲜黑豆酱面！";
		close;
	}
	mes "[Briquet Scheme]";
	mes "大胆告诉我你想要什么！";
	next;
	switch(select("重置全部任务:第一项任务结束前:重置支线任务:分发失物:狩猎后")) {
	case 1:
		mes "给你！";
		set malaya_bakona1,0;
		set malaya_bakona2,0;
		for(set .@i,1174; .@i<=1193; set .@i,.@i+1) {
			if (checkquest(.@i) > -1)
				erasequest .@i;
		}
		close;
	case 2:
		mes "[Briquet Scheme]";
		mes "给你！";
		set malaya_bakona1,6;
		for(set .@i,1174; .@i<=1178; set .@i,.@i+1) {
			if (checkquest(.@i) > -1)
				erasequest .@i;
		}
		setquest 1179;
		close;
	case 3:
		mes "[Briquet Scheme]";
		mes "给你！";
		set malaya_bakona2,0;
		for(set .@i,1180; .@i<=1193; set .@i,.@i+1) {
			if (checkquest(.@i) > -1)
				erasequest .@i;
		}
		close;
	case 4:
		mes "[Briquet Scheme]";
		mes "给你！";
		getitem 6520,17; //Lost_Belongings
		close;
	case 5:
		mes "[Briquet Scheme]";
		mes "给你！";
		set malaya_bakona2,8;
		setquest 1187;
		for(set .@i,1178; .@i<=1193; set .@i,.@i+1) {
			if (checkquest(.@i) > -1)
				erasequest .@i;
		}
		close;
	}
}

// Nurse in Port Malaya :: malaya_bang
//============================================================
function	script	F_Malaya_Nurse	{
	if (malaya_bang == 30) {
		mes "[Nurse Las]";
		mes "护符？";
		mes "我觉得你应该找别的东西。";
		cutin "malaya_nurseA01",2;
		callsub L_Warp, getarg(0);
	} else if (malaya_bang == 31) {
		mes "[Nurse Las]";
		mes "护符和一个人？";
		cutin "malaya_nurseA01",2;
		next;
		mes "[Nurse Las]";
		mes "我确实见过护符，但没靠近它，因为感觉不太好。";
		next;
		mes "[Nurse Las]";
		mes "哦！说到护符，那个老妇人在村子周围放了不少，她应该知道吧？";
		mes "我觉得问问她比较好。";
		set malaya_bang,32;
		changequest 11303,11304;
		callsub L_Warp, getarg(0), 1;
	} else if (malaya_bang == 32) {
		mes "[Nurse Las]";
		mes "哦！说到护符，那个老妇人在医院周围放了不少，她应该知道吧？";
		mes "我觉得问问她比较好。";
		cutin "malaya_nurseA01",2;
		callsub L_Warp, getarg(0), 1;
	} else if (malaya_bang == 33) {
		mes "[Nurse Las]";
		mes "萨满……最好去见见她。";
		cutin "malaya_nurseA01",2;
		callsub L_Warp, getarg(0), 1;
	} else if (malaya_bang == 34) {
		mes "[Nurse Las]";
		mes "哦！你一定见过她了。";
		mes "我感觉到一股强大的力量……";
		cutin "malaya_nurseA01",2;
		next;
		select("告诉她护符的事。");
		mes "[Nurse Las]";
		mes "好！我有个主意。";
		mes "把这个贴在二楼门上看到的那个护符上面，怎么样？";
		emotion ET_AHA;
		next;
		mes "[Nurse Las]";
		mes "也许能阻挡它散发的邪恶能量。";
		set malaya_bang,35;
		changequest 11306,11307;
		callsub L_Warp, getarg(0), 1;
	} else if (malaya_bang == 35) {
		mes "[Nurse Las]";
		mes "好！我有个主意。";
		mes "把这个贴在二楼门上看到的那个护符上面，怎么样？";
		emotion ET_AHA;
		cutin "malaya_nurseA01",2;
		next;
		mes "[Nurse Las]";
		mes "也许能阻挡它散发的邪恶能量。";
		callsub L_Warp, getarg(0), 1;
	} else if (malaya_bang == 36) {
		callsub L_Weight;
			mes "[Nurse Maenne]";
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
		mes "*Sigh*...";
		mes "你站在我身后时，我就觉得奇怪……";
		cutin "malaya_nurseB",2;
		next;
		mes "[Nurse Maenne]";
		mes "没想到你会做这种事。";
		emotion ET_THINK;
		next;
		mes "[Nurse Maenne]";
		mes "我们正要进入梦魇的房间，却被扔了出来……";
		next;
		switch(select("梦魇？:梅恩护士？")) {
		case 1:
			callsub L_Bangungot;
			select("梅恩护士");
			callsub L_Maenne;
			break;
		case 2:
			callsub L_Maenne;
			select("梦魇");
			callsub L_Bangungot;
			break;
		}
		callsub L_Incomplete;
		set malaya_bang,42;
		changequest 11308,11309;
		callsub L_Reward;
		callsub L_Warp, getarg(0), 1;
	} else if (malaya_bang == 40) {
		callsub L_Weight;
		if (checkquest(11309,HUNTING) == 2) {
			callsub L_Complete;
			set malaya_bang,41;
			completequest 11309;
			callsub L_Reward;
			callsub L_Warp, getarg(0), 1;
		} else {
			callsub L_Incomplete;
			set malaya_bang,42;
			callsub L_Reward;
			callsub L_Warp, getarg(0);
		}
	} else if (malaya_bang > 40) {
		if (malaya_bang == 42) {
			if (checkquest(11309,HUNTING) == 2) {
				callsub L_Complete;
				set malaya_bang,41;
				completequest 11309;
				callsub L_Warp, getarg(0), 1;
			} else {
				callsub L_Incomplete;
				callsub L_Warp, getarg(0);
			}
		}
		callsub L_Incomplete;
		switch(getarg(0)) {
		case 1:
			next;
				switch(select("进入医院。:退出。")) {
			case 1:
				callsub L_Warp, getarg(0);
			case 2:
				mes "[Nurse Maenne]";
				mes "嗯……";
				close2;
				cutin "",255;
				end;
			}
		case 2:
			callsub L_Warp, getarg(0);
		}
	}
	return;

L_Weight:
	if (checkweight(1201,1) == 0) {
		mes "- 等等！！-";
		mes "- 你的物品太多。-";
		mes "- 无法获得物品。-";
		mes "- 请减轻背包负重 -";
		mes "- 再试一次。-";
		close;
	}
	if (MaxWeight - Weight < 1000) {
		mes "- 等等！！-";
		mes "- 你携带的物品太多。-";
		mes "- 无法获得物品。-";
		mes "- 请减轻背包负重 -";
		mes "- 再试一次。-";
		close;
	}
	return;

L_Warp:
	switch(getarg(0)) {
	case 1:
		close2;
		cutin "",255;
		if (getarg(1,0) == 0)
			warp "ma_dun01",33,110;
		end;
	case 2:
		next;
		switch(select("去外面。:退出。")) {
		case 1:
			close2;
			cutin "",255;
			warp "malaya",58,76;
			end;
		case 2:
			mes "[Nurse Las]";
			mes "啧……";
			close2;
			cutin "",255;
			end;
		}
	}

L_Reward:
	if (!VIP_SCRIPT || vip_status(VIP_STATUS_ACTIVE)) {
		getitem 6499,5; //Ancient_Grudge
		getitem 6497,10; //Lesser_Agimat
	} else {
		getitem 6499,3; //Ancient_Grudge
		getitem 6497,5; //Lesser_Agimat
	}
	getitem 617,1; //Old_Violet_Box
	getexp 1000000,0;
	return;

L_Bangungot:
	mes "[Nurse Maenne]";
	mes "这是在医院里游荡的凶恶魔物。";
	next;
	mes "[Nurse Maenne]";
	mes "嗯……它不完全算魔物……";
	mes "更像诅咒或疾病……";
	next;
	mes "[Nurse Maenne]";
	mes "有传说说它以前是木之妖精。";
	next;
	mes "[Nurse Maenne]";
	mes "不过她杀死医院病人并把他们变成魔物，这一点不会改变。";
	next;
	return;

L_Maenne:
	mes "[Nurse Maenne]";
	mes "我？";
	mes "如你所见，我是这里的新护士。";
	mes "我专门处理‘这种’工作，而不是照顾病人。";
	cutin "malaya_nurseB",2;
	next;
	mes "[Nurse Maenne]";
	mes "哦！";
	mes "梦魇假扮成我？";
	next;
	mes "[Nurse Maenne]";
	mes "看你被吓成那样，它还挺聪明。";
	next;
	mes "[Nurse Maenne]";
	mes "简单来说，我负责处理医院周围的异常现象。";
	next;
	mes "[Nurse Maenne]";
	mes "世界上会发生许多事情。";
	next;
	return;

L_Complete:
	mes "[Nurse Maenne]";
	mes "她扎根于此的程度可能比我想象的更深。";
	mes "我仍能感觉到她的存在。";
	cutin "malaya_nurseB",2;
	next;
	mes "[Nurse Maenne]";
	mes "你杀死的是她的一部分……";
	mes "不过这帮了大忙，因为你同时迷惑并伤害了她。";
	next;
	mes "[Nurse Maenne]";
	mes "这样事情就容易多了。谢谢你。";
	return;

L_Incomplete:
	mes "[Nurse Maenne]";
	mes "如果她和身体分离会更容易，但现在她回到了房间，事情会有点棘手。";
	cutin "malaya_nurseB",2;
	next;
	mes "[Nurse Maenne]";
	mes "当然，你可别想置身事外，毕竟你打扰了我的工作，还把她引回了房间。";
	next;
	mes "[Nurse Maenne]";
	mes "如果你到达二楼的门，我会为你打开通往她房间的小门。";
	mes "之后就交给你了。";
	return;
}

malaya,55,72,4	script	Nurse#ma_n1	569,{
	if (malaya_hi < 20) {
		mes "[Nurse]";
		mes "这个镇上的人对外来者太谨慎了。";
		emotion ET_ANGER;
		cutin "malaya_nurseA01",2;
		next;
		mes "[Nurse]";
		mes "我相信他们有自己的理由，但真希望他们告诉我该如何接近……";
		close2;
		cutin "",255;
		end;
	}
	if (BaseLevel < 100) {
		mes "医院外有个拿着大包的护士。";
		mes "我想我帮不了她。";
		close;
	}
	if (malaya_bang == 0) {
		mes "[Nurse]";
		mes "嘿，等等。你打算进去吗？";
		cutin "malaya_nurseA01",2;
		next;
		switch(select("是。:不。")) {
		case 1:
			mes "[Nurse]";
			mes "哦～太好了！";
			mes "我真的等了一整天，终于有人来了。";
			cutin "malaya_nurseA02",2;
			next;
			switch(select("关于医院:你为什么拦我:无视。")) {
			case 1:
				mes "[Nurse]";
				mes "这家医院是镇上唯一的医院。";
				mes "而且它将是我的新工作地点。";
				cutin "malaya_nurseA03",2;
				next;
				mes "[Nurse]";
				mes "我听说它刚建好，但看起来真可怕……";
				emotion ET_SWEAT;
				next;
				mes "[Nurse]";
				mes "我到这里时也很惊讶。到处都写着‘关闭’！";
				next;
				select("你为什么拦我。");
				mes "[Nurse]";
				mes "我听说这个镇上需要护士，";
				mes "所以拒绝了许多邀请后才来到这里。";
				next;
				mes "[Nurse]";
				mes "我听说他们非常提防外来者……";
				next;
				mes "[Nurse]";
				mes "别说派对了，连一个欢迎我的人都没有！真令人震惊！";
				emotion ET_CRY;
				next;
				mes "[Nurse]";
				mes "更糟的是，我迷路后来到这里，面对的却是一家阴森又上锁的医院！";
				next;
				break;
			case 2:
				mes "[Nurse]";
				mes "我听说这个镇上需要护士，所以拒绝了许多邀请后才来到这里。";
				cutin "malaya_nurseA03",2;
				next;
				mes "[Nurse]";
				mes "我听说他们非常提防外来者……";
				next;
				mes "[Nurse]";
				mes "别说派对了，连一个欢迎我的人都没有！真令人震惊！";
				emotion ET_CRY;
				next;
				mes "[Nurse]";
				mes "更糟的是，我迷路后来到这里，面对的却是一家阴森又上锁的医院！";
				next;
				select("关于医院");
				mes "[Nurse]";
				mes "这家医院是镇上唯一的医院，也将是我的新工作地点。";
				next;
				mes "[Nurse]";
				mes "我听说它刚建好，但看起来真可怕……";
				emotion ET_SWEAT;
				next;
				mes "[Nurse]";
				mes "我到这里时也很惊讶。到处都写着‘关闭’！";
				next;
				break;
			case 3:
				mes "[Nurse]";
				mes "是啊，你一定很忙。";
				mes "哦，好吧。";
				mes "我不打扰你了。别管我。*抽泣*";
				emotion ET_CRY;
				cutin "malaya_nurseA03",2;
				close2;
				cutin "",255;
				end;
			}
			break;
		case 2:
			mes "[Nurse]";
		mes "哦，我明白了……";
			emotion ET_CRY;
			close2;
			cutin "",255;
			end;
		}
		mes "[Nurse]";
		mes "既然你这么说……如果你要进去，能带我一起吗？";
		cutin "malaya_nurseA04",2;
		next;
		mes "[Nurse]";
		mes "门锁着！我的包很重！我的腿也疼得要命。";
		cutin "malaya_nurseA03",2;
		next;
		mes "[Nurse]";
		mes "早知道会这样，我就穿急诊夜班鞋，而不是第一天的鞋了……*抽泣*";
		emotion ET_CRY;
		next;
		switch(select("帮忙。:不帮。")) {
		case 1:
			mes "[Nurse]";
			mes "*Sob*";
			mes "看来这个世界还是值得活下去的。";
			mes "你真是太善良了。";
			emotion ET_CRY;
			next;
			mes "[Nurse Las]";
			mes "我是拉斯，本来应该在这家医院工作。";
			mes "不过看起来，我可能要失业了……";
			next;
			mes "[Nurse Las]";
			mes "我们先想办法进去吧。";
			next;
			mes "[Nurse Las]";
			mes "在那之前……能帮我找点东西包住脚吗？我脚上起了水泡，穿不了鞋。";
			emotion ET_HELP;
			cutin "malaya_nurseA04",2;
			next;
			mes "[Nurse Las]";
		mes "2 个腐烂绷带应该就能包住我的双脚。它们看起来很脏，但上面有一种效果惊人的特殊液体。";
			set malaya_bang,1;
			setquest 11284;
			close2;
			cutin "",255;
			end;
		case 2:
			mes "[Nurse]";

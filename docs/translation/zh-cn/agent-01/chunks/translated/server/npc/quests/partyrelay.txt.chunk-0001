payon,103,113,3	script	Ledrion#payon::RelayLedrion	109,{
	getpartymember(getcharid(1));
	set .@partymembercount,$@partymembercount;
	set .@partyleader, is_party_leader();
	if (checkweight(907,300) == 0) {
		mes "^3355FF等一下！你现在携带的物品太多了。";
		mes "请把多余物品存入卡普拉仓库后再回来。^000000";
		close;
	}
	if ((countitem(7731) > 0) || (countitem(7732) > 0) || (countitem(7735) > 0) || (countitem(7736) > 0) || (countitem(7739) > 0) || (countitem(7740) > 0)) {
		mes "[Ledrion]";
		mes "嗯？恐怕你误解了我之前的话……";
		mes "带来足够的队伍成员前，你还不能来见我。";
		close;
	}
	if ((countitem(7741) > 0) && .@partyleader == true && (getcharid(2) > 0) && (.@partymembercount > 5)) {
		mes "[Ledrion]";
		mes "啊，你带来了罗丝比的最后一张票。";
		mes "现在我确信你和队伍配合得很好。试炼通过得不错！";
		next;
		mes "[Ledrion]";
		mes "你的队伍一定真正理解团队合作的价值。多亏了你，我赢了赌注！";
		mes "呃，更重要的是你们证明了我对你们的信任。";
		next;
		mes "[Ledrion]";
		mes "我为你们的伟大成就感到骄傲。给你……这是应得的奖励！";
		next;
		set .@present,rand(1,7);
		delitem 7741,1; //Mission_Certificate12
		set party_relay,0;
		getitem 644,6; //Gift_Box
		getitem 603,3; //Old_Blue_Box
		if (.@present == 2) {
			getitem 1365,1; //Sabbath
		}
		else if (.@present == 4) {
			getitem 1367,1; //Slaughter
		}
		else if (.@present == 6) {
			getitem 1527,1; //Quadrille
		}
		else {
			getitem 617,3; //Old_Violet_Box
		}
		callfunc "F_PartyRelay_Exp";
		mes "[Ledrion]";
		mes "希望你喜欢！如果用不上，就和公会成员分享吧。";
		mes "想再挑战试炼的话，随时欢迎回来，好吗？";
		next;
		mes "[Ledrion]";
		mes "再次感谢你。我不知道我们是否还会相遇，";
		mes "但我会为你的冒险旅程祈祷。";
		close;
	}
	if (countitem(7741) > 0) {
		mes "[Ledrion]";
		mes "嗯？你的同伴怎么没来？";
		mes "必须带队伍成员来这里，才能继续试炼。";
		close;
	}
	if (party_relay == 23) {
		mes "[Ledrion]";
		mes "你不是应该让队伍中的剑士或法师职业成员把票送给加坦吗？";
		close;
	}
	if ((countitem(7737) > 0) && .@partyleader == true && (getcharid(2) > 0) && (.@partymembercount > 5)) {
		mes "[Ledrion]";
		mes "太好了，你带来了罗丝比的第八张票。";
		mes "你的队伍配合得很好，对吧？通常很难聚集这样一群人……";
		next;
		mes "[Ledrion]";
		mes "请继续努力，完成全部试炼，好吗？";
		mes "这是目前努力的小奖励，也是给公会的第九张票。";
		delitem 7737,1; //Mission_Certificate8
		set party_relay,23;
		getitem 603,3; //Old_Blue_Box
		getitem 617,1; //Old_Violet_Box
		getitem 7738,1; //Mission_Certificate9
		callfunc "F_PartyRelay_Exp";
		next;
		mes "[Ledrion]";
		mes "请把那张票交给公会中的剑士或法师职业角色，";
		mes "让他送到加坦那里。好吗？回头见。";
		close;
	}
	if (countitem(7737) > 0) {
		mes "[Ledrion]";
		mes "嗯？你的同伴怎么没来？必须带队伍成员来这里，才能继续试炼。";
		close;
	}
	if (party_relay == 12) {
		mes "[Ledrion]";
		mes "嗯？你不是应该让队伍中的法师职业成员把票送给加坦吗？";
		close;
	}
	if ((countitem(7733) > 0) && .@partyleader == true && (getcharid(2) > 0) && (.@partymembercount > 5)) {
		mes "[Ledrion]";
		mes "我看到你带来了罗丝比的第四张票。干得好。";
		mes "坚持下去，完成我们安排的全部试炼，好吗？";
		next;
		mes "[Ledrion]";
		mes "这是目前努力的小奖励。请把这张票交给法师职业角色，告诉他送到加坦那里。";
		delitem 7733,1; //Mission_Certificate4
		set party_relay,12;
		getitem 644,3; //Gift_Box
		getitem 603,1; //Old_Blue_Box
		getitem 7734,1; //Mission_Certificate5
		callfunc "F_PartyRelay_Exp";
		close;
	}
	if (countitem(7733) > 0) {
		mes "[Ledrion]";
		mes "嗯？你的同伴怎么没来？必须带队伍成员来这里，才能继续试炼。";
		close;
	}
	if (party_relay == 2) {
		mes "[Ledrion]";
		mes "你还没完成我要求的事，对吧？现在还不是来找我的时候。";
		close;
	}
	if ((BaseLevel > 39) && .@partyleader == true && (getcharid(2) > 0) && (.@partymembercount > 5) && (party_relay == 1)) {
		mes "[Ledrion]";
		mes "正如我之前提到的，我要用任务挑战公会队伍，要求成员之间相互合作。";
		next;
		mes "[Ledrion]";
		mes "这些挑战类似接力赛：我们会要求将物品交给特定职业的成员，再由他替我们送达。";
		next;
		mes "[Ledrion]";
		mes "当然，作为测试管理者，我们也会不时加入小挑战，看看你的队伍有多能干。";
		next;
		mes "[Ledrion]";
		mes "不如试试？参加测试不会损失任何东西，我保证你会从这次小练习中受益。";
		next;
		mes "[Ledrion]";
		mes "嘿！就从你开始！拿着这张票，交给公会中的剑士职业成员，让他送到加坦那里。接力开始了～";
		next;
		set party_relay,2;
		getitem 7730,1; //Mission_Certificate1
		mes "[Ledrion]";
		mes "既然是你开启了接力，之后还要回来找我。别担心，时机到了我们会通知你。";
		close;
	}
	if (.@partyleader == true && (getcharid(2) > 0) && (.@partymembercount > 5) && (party_relay > 0)) {
		mes "[Ledrion]";
		mes "作为队伍队长，你应该始终考虑什么对所有队友最好。";
		close;
	}
	if (.@partyleader == false && (getcharid(2) > 0)) {
		mes "[Ledrion]";
		mes "抱歉，我没什么能提供给你的……除非你组建队伍并成为队长，否则我完全帮不了你……";
		close;
	}
	mes "[Ledrion]";
	mes "啊，很高兴认识你，冒险者。";
	mes "我是莱德里昂，一个聪明、神秘，最重要的是富有的人。";
	mes "没错，我是慈善家。";
	next;
	mes "[Ledrion]";
	mes "我一直努力为卢恩·米德加尔特做出有意义的贡献，这就是我来到这里的原因。";
	mes "像你这样的冒险者很多，但我们遇到了问题。";
	next;
	mes "[Ledrion]";
	mes "许多冒险者选择了贪婪之路，忘记如何与同伴合作。";
	mes "这种自私让我恶心至极！呃！";
	next;
	mes "[Ledrion]";
	mes "我虽然不是冒险者，却有钱做点事情。";
	mes "我为冒险者举办小挑战，鼓励友谊与团队合作。";
	next;
	mes "[Ledrion]";
	mes "请来试试！先说明条件。";
	mes "第一，你必须属于一个至少有6名成员的队伍，例如组队或公会。";
	next;
	mes "[Ledrion]";
	mes "第二，只有队长能开始挑战第一部分。";
	mes "如果你不是队长，请让他来找我参加挑战。";
	next;
	mes "[Ledrion]";
	mes "第三，队伍必须有剑士职业、法师职业、";
	mes "牧师、弓箭手、盗贼和商人职业角色完成你将收到的挑战。";
	next;
	mes "[Ledrion]";
	mes "转生角色也可以。第四，所有队伍成员基础等级必须至少为40。";
	mes "其他事项嘛，你会在途中学到。";
	next;
	mes "[Ledrion]";
	mes "别担心，我不会让你们无缘无故地受苦。";
	mes "我会提供丰厚奖励鼓励你的队伍。要参加吗？";
	next;
	switch(select("当然！:不。")) {
	case 1:
		if ((BaseLevel > 39) && .@partyleader == true && (getcharid(2) > 0) && (.@partymembercount > 5)) {
			mes "[Ledrion]";
			mes "太好了！让我看看……你满足所有要求。看来我要赢赌注了！";
			mes "呃，让我告诉你第一组指示。";
			next;
			set party_relay,1;
			mes "[Ledrion]";
			mes "只是——^666666*咳！*^000000让我清清嗓子……";
			close;
		}
		else {
			mes "[Ledrion]";
			mes "很好！不过在满足所有条件前，你还没准备好接受挑战。";
			mes "完成后再回来，好吗？";
			close;
		}
	case 2:
		mes "[Ledrion]";
		mes "真的吗？相信我，这个小挑战对你很有价值，";
		mes "还能让卢恩·米德加尔特更团结、更有团队精神。这是双赢！";
		close;
	}
}

payon,83,327,3	script	Gatan#payon::RelayGatan	86,{
	if (checkweight(907,300) == 0) {
		mes "^3355FF等一下！你现在携带的物品太多了。请把多余物品存入卡普拉仓库后再回来。^000000";
		close;
	}
	if ((countitem(7732) > 0) || (countitem(7733) > 0) || (countitem(7736) > 0) || (countitem(7737) > 0) || (countitem(7740) > 0) || (countitem(7741) > 0)) {
		mes "[Gatan]";
		mes "嘿，你是不是忘了什么？仔细想想……之前你收到过指示，对吧？";
		close;
	}
	set .@relaytime,gettime(DT_HOUR);
	if (party_relay == 28) {
		mes "[Gatan]";
		mes "我觉得还没轮到你来见我。请让队伍中的盗贼或牧师职业成员把第十张票送给巴菲尔。";
		close;
	}
	if (party_relay == 27) {
		mes "[Gatan]";
		mes "啊，很好！请把这张票交给队伍中的盗贼或牧师职业成员，让他送到巴菲尔。";
		mes "啊，这里还有给你的小奖励～";
		set party_relay,28;
		getitem 7739,1; //Mission_Certificate10
		getitem 610,2; //Leaf_Of_Yggdrasil
		getitem 607,2; //Yggdrasilberry
		callfunc "F_PartyRelay_Exp";
		next;
		mes "[Gatan]";
		mes "好了，完成那件事吧。回头见。";
		close;
	}
	if ((party_relay == 26) && (BaseLevel > (party_relay_lv + 2)) && (.@relaytime >= 14) && (.@relaytime < 17)) {
		mes "[Gatan]";
		mes "太好了，你按我的要求提升了等级。";
		mes "让我找找下一组指示——我发誓就放在附近——稍等……";
		set party_relay,27;
		close;
	}
	else if ((party_relay == 26) && (BaseLevel > (party_relay_lv + 2)) && (.@relaytime >= 18) && (.@relaytime < 21)) {
		mes "[Gatan]";
		mes "太好了，你按我的要求提升了等级。";
		mes "让我找找下一组指示——我发誓就放在附近——稍等……";
		set party_relay,27;
		close;
	}
	if (party_relay == 26) {
		mes "[Gatan]";
		mes "你的任务是再提升3个基础等级。完成后在我的工作时间来见我，好吗？";
		next;
		mes "[Gatan]";
		mes "我不能告诉你确切时间，但我的工作时间在下午……按太平洋标准时间计算。";
		mes "如果你太晚来，我可能不在，好吗？";
		close;
	}
	if ((party_relay == 25) && (BaseLevel > (party_relay_lv + 1)) && (.@relaytime >= 14) && (.@relaytime < 17)) {
		mes "[Gatan]";
		mes "太好了，你按我的要求提升了等级。";
		mes "让我找找下一组指示——我发誓就放在附近——稍等……";
		set party_relay,27;
		close;
	}
	else if ((party_relay == 25) && (BaseLevel > (party_relay_lv + 1)) && (.@relaytime >= 18) && (.@relaytime < 21)) {
		mes "[Gatan]";
		mes "太好了，你按我的要求提升了等级。";
		mes "让我找找下一组指示——我发誓就放在附近——稍等……";
		set party_relay,27;
		close;
	}
	if (party_relay == 25) {
		mes "[Gatan]";
		mes "你的任务是再提升2个基础等级。完成后在我的工作时间来见我，好吗？";
//

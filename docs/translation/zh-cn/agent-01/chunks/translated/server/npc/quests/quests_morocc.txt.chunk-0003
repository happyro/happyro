-	script	Continental Messenger#00::ConMessenger	997,3,3,{
	set .@area$,strnpcinfo(2);
	if (.@area$ == "01") { set .@area$,"Prontera"; }
	else if (.@area$ == "02") { set .@area$,"Geffen"; }
	else if (.@area$ == "03") { set .@area$,"Payon"; }
	else if (.@area$ == "04") { set .@area$,"Alberta"; }
	else if (.@area$ == "05") { set .@area$,"Al De Baran"; }
	if (BaseLevel > 79) {
		mes "[Continental Guard Messenger]";
		mes "日安，"+ strcharinfo(0) +"。情况危急，我们没有时间闲聊，我尽量长话短说。";
		next;
		mes "[Continental Guard Messenger]";
		mes "我是从梦罗克大陆卫队总部派往" + .@area$ + "的使者。我的职责是把这条重要消息传达给尽可能多的知名冒险者。很高兴终于找到你，"+ strcharinfo(0) +"。";
		next;
		select("梦罗克大陆卫队总部？");
		mes "[Continental Guard Messenger]";
		mes "时间不多了，我只能简单说明。";
		next;
		mes "[Continental Guard Messenger]";
		mes "被囚禁在梦罗克地下深处数百年的凶恶恶魔撒旦梦罗克已经复活并逃脱。";
		next;
		mes "[Continental Guard Messenger]";
		mes "撒旦梦罗克的复活彻底摧毁了梦罗克村及其周边地区。";
		next;
		mes "[Continental Guard Messenger]";
		mes "所有的死亡与苦难……和梦罗克及周边发生的一切相比，其他地方简直像天堂。";
		next;
		mes "[Continental Guard Messenger]";
		mes "梦罗克大陆卫队立即组建起来对抗撒旦梦罗克，缓解这场灾难。我来到这里，是为了向卢恩·米德加尔特王国的所有人通报这场灾难。";
		next;
		mes "[Continental Guard Messenger]";
		mes "我们需要你的帮助，"+ strcharinfo(0) +"。我们需要你这样的优秀冒险者，再次封印撒旦梦罗克。";
		next;
		mes "[Continental Guard Messenger]";
		mes "如需更多信息，请去找梦罗克大陆卫队队长。他正在等你，"+ strcharinfo(0) +"。";
		next;
		mes "[Continental Guard Messenger]";
		mes "大陆卫队总部位于梦罗克中央宫殿附近，请尽快去和队长交谈。";
		close;
	}
	else {
		mes "[Continental Guard Messenger]";
		mes "我是梦罗克大陆卫队总部的使者，带着紧急消息来到" + .@area$ + "，要通知卢恩·米德加尔特王国的所有人。";
		next;
		select("梦罗克大陆卫队总部？");
		mes "[Continental Guard Messenger]";
		mes "时间不多了，我只能简单说明。";
		next;
		mes "[Continental Guard Messenger]";
		mes "被囚禁在梦罗克地下深处数百年的凶恶恶魔撒旦梦罗克已经复活并逃脱。";
		next;
		mes "[Continental Guard Messenger]";
		mes "撒旦梦罗克的复活彻底摧毁了梦罗克村及其周边地区。";
		next;
		mes "[Continental Guard Messenger]";
		mes "所有的死亡与苦难……和梦罗克及周边发生的一切相比，其他地方简直像天堂。";
		next;
		mes "[Continental Guard Messenger]";
		mes "梦罗克大陆卫队立即组建起来对抗撒旦梦罗克，缓解这场灾难。我来到这里，是为了向卢恩·米德加尔特王国的所有人通报这场灾难。";
		next;
		mes "[Continental Guard Messenger]";
		mes "我的职责之一是从世界各地招募冒险者，帮助把撒旦梦罗克重新关回牢笼。这并不容易，但他以前曾被击败过。撒旦梦罗克也能再次被封印。";
		next;
		mes "[Continental Guard Messenger]";
		mes "梦罗克村至少有 70% 被撒旦梦罗克复活造成的灾难摧毁。";
		next;
		mes "[Continental Guard Messenger]";
		mes "梦罗克周围的沙漠也被撒旦梦罗克、他强大的分身和爪牙占据，变成了死亡之地。";
		mes "请听从我的警告，除非执行梦罗克大陆卫队组织的任务，否则不要靠近梦罗克地区。";
		close;
	}

OnTouch_:
	if (BaseLevel > 79) {
		mes "[Continental Guard Messenger]";
		mes "你是……"+ strcharinfo(0) +"吗？";
		mes "啊，很好。我有一条非常重要的消息要告诉你。";
		next;
		mes "[Continental Guard Messenger]";
		mes "情况紧急，请仔细听我说。";
		close;
	}
	end;
}

prontera,164,304,3	duplicate(ConMessenger)	Continental Messenger#01	997,3,3

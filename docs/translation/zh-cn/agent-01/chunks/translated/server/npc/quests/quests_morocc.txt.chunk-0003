-	script	Continental Official	-1,{
	if (rebirth_moc_edq > 3) {
		mes "[Continental Guard Official]";
		mes "我代表大陆卫队感谢你的努力。现在，让我看看总部有没有收到你应该知道的消息……";
		next;
		mes "[Continental Guard Official]";
		mes "嗯……";
		next;
		mes "[Continental Guard Official]";
		mes "暂时没有。请继续执行当前任务。再次感谢你。";
		close;
	}
	else if (rebirth_moc_edq == 0) {
		mes "[Continental Guard Official]";
		mes "欢迎来到梦罗克讨伐情报中心。我能为你做什么？";
		next;
		switch(select("这里是做什么的？:我来报名志愿者。:告诉我村子的情况。")) {
		case 1:
			mes "[Continental Guard Official]";
			mes "我驻守在这里，为想报名并帮助大陆卫队对抗撒旦梦罗克的冒险者提供协助。";
			next;
			mes "[Continental Guard Official]";
			mes "我相信你已经知道，撒旦梦罗克的复活威胁着卢恩·米德加尔特王国的和平。如果任由撒旦梦罗克自由行动，整个世界都会被它吞噬。";
			next;
			mes "[Continental Guard Official]";
			mes "大陆卫队正在王国的命令下筹划一系列对策，压制撒旦梦罗克。";
			next;
			mes "[Continental Guard Official]";
			mes "如果你受使者邀请，或对自己的能力有信心，我们鼓励你报名加入大陆卫队，为这片大陆带回和平。";
			close;
		case 2:
			if (BaseLevel > 79) {
				mes "[Continental Guard Official]";
				mes "欢迎你，" + strcharinfo(0) + "。我一直在等你。我想使者已经告诉你我们的情况了。";
				next;
				mes "[Continental Guard Official]";
				mes "我马上处理你的申请，请稍等。";
				next;
				mes "[Continental Guard Official]";
				mes "现在请去和大陆卫队的巴洛克队长交谈。你可以在中央找到他。";
				set rebirth_moc_edq,1;
				setquest 3050;
				close;
			}
			else {
				mes "[Continental Guard Official]";
			mes "我赞赏你的勇气，但要帮助我们，光有勇气还不够。";
				next;
				mes "[Continental Guard Official]";
			mes "撒旦梦罗克是凡人世界中最强大的邪恶。对它来说，夺走你的生命轻而易举。";
				next;
				mes "[Continental Guard Official]";
			mes "我强烈建议你现在先考虑自己的安全。最终决战到来时，我确信没有任何地方会安全。";
				close;
			}
		case 3:
			mes "[Continental Guard Official]";
		mes "如你所见，情况糟糕透顶。撒旦梦罗克的复活给村子及周边地区造成了无法挽回的破坏。";
			next;
			mes "[Continental Guard Official]";
		mes "由于王国向各地派出了大陆卫队使者，许多有能力的冒险者都聚集到了这里，但是……恐怕他们仍不足以打败恶魔。";
			next;
			mes "[Continental Guard Official]";
		mes "请遵守我们的指示，至少在这附近要如此，并暂时远离危险。";
			close;
		}
	}
	else {
		mes "[Continental Guard Official]";
		mes "你的申请已经登记。请去和巴洛克队长交谈。";
		close;
	}
}

morocc,159,113,3	script	Chief Balrog	752,{
	if (rebirth_moc_edq == 0) {
		mes "[Chief Balrog]";
		mes "你来得不是时候，不过很高兴见到你。我是大陆卫队的巴洛克队长。我们被派往梦罗克镇压撒旦梦罗克……需要尽可能多的力量和好运。";
		next;
		mes "[Chief Balrog]";
		mes "抱歉，我正忙着审核这些大陆卫队候选人的申请，没法逐一接待你们这些冒险者。";
		next;
		mes "[Chief Balrog]";
		mes "听着，你最好先和其他人谈谈。其他大陆卫队成员或使者应该更适合帮助你。";
		close;
	}
	else if (rebirth_moc_edq == 1) {
		mes "[Chief Balrog]";
		mes "你来得不是时候，不过很高兴见到你。我是大陆卫队的巴洛克队长。我们被派往梦罗克镇压撒旦梦罗克……需要尽可能多的力量和好运。";
		next;
		mes "[Chief Balrog]";
		mes "看来你有事找我。请尽量简短，因为我没有多少时间，还有很多事情要处理……";
		next;
		switch(select("询问大陆卫队:我想加入大陆卫队。:结束交谈")) {
		case 1:
			mes "[Chief Balrog]";
			mes "只要看看周围，就能明显看到撒旦梦罗克复活造成的破坏。";
			mes "可怕的是，这一切只是因为它逃出了牢笼。想想看，如果任由它自由行动，还会造成多大的破坏……";
			next;
			mes "[Chief Balrog]";
			mes "梦罗克村已经彻底毁灭，撒旦梦罗克如今占据了苏克拉特沙漠。";
			next;
			mes "[Chief Balrog]";
			mes "我毫不怀疑，如果不加阻止，撒旦梦罗克会占领整个米德加尔特大陆。我们必须现在阻止它，不能让全世界遭受灾难。";
			next;
			mes "[Chief Balrog]";
			mes "所以王国命令我们这些精锐士兵组建大陆卫队，并从世界各地招募优秀冒险者，共同对抗撒旦梦罗克。";
			next;
			mes "[Chief Balrog]";
			mes "当然，这会极其困难……我们必须做出牺牲……我甚至不确定能否获胜。但世界的命运危在旦夕，我们必须有所行动。黑暗时代真的降临了……";
			close;
		case 2:
			mes "[Chief Balrog]";
			mes "嗯？你想加入我们，报名成为大陆卫队志愿者吗？";
			next;
			if (BaseLevel > 79) {
				mes "[Chief Balrog]";
				mes "你叫什么名字？" + strcharinfo(0) + "？哦，是的，我听说过你。";
				next;
				mes "[Chief Balrog]";
				mes "嗯，我觉得你还不了解其中的危险。你知道撒旦梦罗克有多强大吗？";
				next;
				mes "[Chief Balrog]";
				mes "如果你不完全理解风险，就无法帮助我们。我见过成千上万鲁莽的冒险者以为凭自己的力量能打败撒旦梦罗克，白白送掉性命。";
				next;
				mes "[Chief Balrog]";
				mes "我们面对的威胁将决定世界的未来，无法团队合作的蠢货只会成为负担，而不是助力。";
				next;
				mes "[Chief Balrog]";
				mes "抱歉，缺乏经验的冒险者只会妨碍我们。希望你能理解。如果你真的想帮助我们，现在请专心训练。";
				next;
				switch(select("结束交谈:再次询问")) {
				case 1:
					close;
				case 2:
					mes "[Chief Balrog]";
					mes "听着，我理解你的热情，但你以为自己能帮助我们就错了。我没有时间详细解释我们共同面对的危险。";
					next;
					mes "[Chief Balrog]";
					mes "撒旦梦罗克和你遇到过的怪物完全不同。最糟糕的情况是你白白送命，但你的错误和无能也可能害死我的士兵。我不能允许这种事发生！";
					next;
					mes "[Chief Balrog]";
					mes "请理解，这是为了你好。去和波利或其他适合你等级的怪物战斗吧。";
					next;
					switch(select("结束交谈:你必须让我加入！")) {
					case 1:
						close;
					case 2:
						mes "[Chief Balrog]";
						mes "唉……你怎么这么固执？难道不明白拒绝就是拒绝吗？我再说最后一次。";
						next;
						mes "[Chief Balrog]";
						mes "我们忙于对抗撒旦梦罗克，没空照顾你这样的新手。你只是在白白送命。";
						next;
						mes "[Chief Balrog]";
						mes "别再烦我了。你只会成为负担。";
						next;
						switch(select("放弃:给我证明自己的机会！")) {
						case 1:
							close;
						case 2:
							mes "[Chief Balrog]";
							mes "嗯？你想要证明自己的机会？";
							next;
							mes "[" + strcharinfo(0) + "]";
							mes "是的，为了加入大陆卫队，我什么都愿意做！";
							next;
							mes "[Chief Balrog]";
							mes "嗯……";
							next;
							mes "[Chief Balrog]";
							mes "有意思。你引起了我的注意。好吧，如果你能替我完成一件事，我也该承认你的实力。";
							next;
							mes "[Chief Balrog]";
							mes "大陆卫队一直在村子和沙漠周边保持最高警戒。我们必须做好准备，以防撒旦梦罗克冲破防线。";
							next;
							mes "[Chief Balrog]";
							mes "士兵需要木柴让篝火燃烧整夜，但我们一直缺少木柴。";
							next;
							mes "[Chief Balrog]";
							mes "我听说熔岩洞窟的怪物拥有永恒之火，可以解决篝火问题。我想让你替我们收集那些火焰。";
							next;
							switch(select("太难了！让我考虑一下！:没问题。")) {
							case 1:
								mes "[Chief Balrog]";
								mes "哼，我就知道。我知道你连这么简单的任务都完成不了。我不该在你身上浪费时间。";
								close;
							case 2:
								mes "[Chief Balrog]";
								mes "很好！带回^0000FF30 个活炭^000000。我会等你回来。";
								set rebirth_moc_edq,2;
								changequest 3050,3051;
								close;
							}
						}
					}
				}
			}
			else {
				mes "[Chief Balrog]";
				mes "什么？你没有真正能派上用场的技能，怎么还会想加入我们？";
				next;
				mes "[Chief Balrog]";

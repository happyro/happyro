			close2;
			warp "morocc",160,61;
			end;
		}
	}
	else if (rebirth_moc_edq == 8) {
		mes "[Continental Guard]";
	mes "啊，你是为大陆卫队效力的冒险者。很高兴见到你。如果需要帮助，尽管问我。";
		next;
		getpartymember getcharid(1), 1, .@partymembercid;
		.@partymembercount = $@partymembercount;
		for (.@i = 0; .@i < .@partymembercount; .@i++) {
			if (convertpcinfo(.@partymembercid[.@i], CPC_ACCOUNT))
				.@onlinemembers++;
		}
		switch(select("进入第一调查区域:进入第二调查区域:返回梦罗克事故现场:取消交谈")) {
		case 1:
			if ((.@onlinemembers > 1) && (countitem(7826) > 0)) {
				mes "[Continental Guard]";
				mes "......";
				next;
				mes "[Continental Guard]";
				mes "是的，我确认你是大陆卫队成员。祝你顺利完成任务。";
				next;
				mes "[Continental Guard]";
				mes "我马上送你去调查区域。请使用区域入口的传送点返回这里。";
				close2;
				warp "moc_fild21",38,193;
				end;
			}
			else if ((.@onlinemembers < 2) && (countitem(7826) > 0)) {
				mes "[Continental Guard]";
				mes "欢迎，大陆卫队成员。我这里有巴洛克队长给你们的特别命令，请听我宣读。";
				next;
				mes "[Continental Guard]";
				mes "‘由于此区域十分危险，现禁止大陆卫队成员独自调查。今后执行任务时，必须组织至少 2 人的队伍。’";
				next;
				mes "[Continental Guard]";
				mes "……你明白了吧？请回到现场，组成至少 2 人的队伍后再回来。谢谢。";
				close;
			}
			else if (countitem(7826) < 1) {
				mes "[Continental Guard]";
				mes "只有持有大陆卫队证书的大陆卫队成员，才可以通过此处。";
				close;
			}
			else {
				close;
			}
		case 2:
			if ((.@onlinemembers > 1) && (countitem(7826) > 0)) {
				mes "[Continental Guard]";
				mes "......";
				next;
				mes "[Continental Guard]";
				mes "是的，我确认你是大陆卫队成员。祝你顺利完成任务。";
				next;
				mes "[Continental Guard]";
				mes "我马上送你去调查区域。请使用区域入口的传送点返回这里。";
				close2;
				warp "moc_fild22",38,193;
				end;
			}
			else if ((.@onlinemembers < 2) && (countitem(7826) > 0)) {
				mes "[Continental Guard]";
				mes "欢迎，大陆卫队成员。我这里有巴洛克队长给你们的特别命令，请听我宣读。";
				next;
				mes "[Continental Guard]";
				mes "‘由于此区域十分危险，现禁止大陆卫队成员独自调查。今后执行任务时，必须组织至少 2 人的队伍。’";
				next;
				mes "[Continental Guard]";
				mes "……所以请回到现场，组成至少 2 人的队伍后再回来。谢谢。";
				close;
			}
			else if (countitem(7826) < 1) {
				mes "[Continental Guard]";
				mes "只有持有大陆卫队证书的大陆卫队成员，才可以通过此处。";
				close;
			}
			else {
				close;
			}
		case 3:
			mes "[Continental Guard]";
			mes "很好。我马上送你去梦罗克村的事故现场。";
			close2;
			warp "morocc",160,61;
			end;
		case 4:
			close;
		}
	}
	else {
		end;
	}

OnTouch:
	mes "[Continental Guard]";
	mes "平民不得进入此处以后的区域。";
	mes "这里极其危险，禁止进入。";
	close;
	end;
}


//= 1.9 Fixed an issue with completequest by adding checkquest. [Kisuka]
//= 2.0 Moved "Dollshoi" and "Ponka-Hontas" NPCs. [Euphy]
//============================================================ 

geffen_in,164,124,4	script	Mage Guildsman	123,{
	if (Upper == 1) {
		if (ADVJOB == Job_High_Wizard || ADVJOB == Job_Professor) {
			if (Class == Job_Novice_High) {
				mes "[魔法师公会成员]";
				mes "哇，好久不见！你不是应该死了吗？";
				next;
				mes "[魔法师公会成员]";
				mes "啊，你一定是重生了。很高兴你回来。";
				next;
				if (!callfunc("F_CanChangeJob")) {
					mes "[魔法师公会成员]";
					mes "抱歉，我不认为你已准备好学习魔法。先去完成基础技能学习吧？";
					next;
					mes "[魔法师公会成员]";
					mes "慢慢来。学得越多，就越准备好重新学习魔法。";
					close;
				}
				mes "[魔法师公会成员]";
				mes "既然你通过过魔法师测试，我不质疑你的资格。你想立即恢复魔法技能，对吧？";
				next;
				skill "NV_TRICKDEAD",0,SKILL_PERM;
				jobchange Job_Mage_High;
				skill "MG_ENERGYCOAT",1,SKILL_PERM;
				mes "[魔法师公会成员]";
				mes "哇，不知为何你看起来比以前好多了。我相信你也会成为更好的魔法师。";
				close;
			}
			else {
				mes "[魔法师公会成员]";
				mes "还有什么需要我帮忙吗？没有的话去测试技能吧。世界在等你~！";
				close;
			}
		}
		else {
			mes "[魔法师公会成员]";
			mes "什么，你对魔法师公会感兴趣？我本不想说，但你不属于这里。";
			next;
			mes "[魔法师公会成员]";
			mes "不知道你为何还站在我面前，但你注定不是魔法师。";
			close;
		}
	}
	mes "[魔法师公会成员]";
	mes "哟，怎么了？";
	next;
	switch(select("我想成为魔法师。:告诉我要求。:没什么。")) {
	case 1:
		mes "[魔法师公会成员]";
		if (BaseJob == Job_Mage) {
			mes "嘿，你没意识到吗？你已经是魔法师了，傻瓜！";
			next;
			mes "[魔法师公会成员]";
			mes "总有一天，当你能用意念制造火焰时，就会意识到体内的力量！";
			close;
		}
		if (BaseJob != Job_Novice) {
			mes "嘿~别闹了。你已有其他职业，不能成为魔法师。";
			close;
		}
		if (job_magician_q == 0) {
			mes "想成为魔法师，嗯……？";
			if (Sex == SEX_MALE)
				mes "嘿，看看你！有点可爱~！但不是我的类型……";
			else {
				mes "哦哦，你真是个大美女~！";
				mes "我喜欢你这样的女孩~";
			}
			next;
			mes "[魔法师公会成员]";
			mes "好，你说想成为魔法师？那请签署魔法师申请。";
			next;
			if (select("报名。:退出。") == 1) {
				mes "[魔法师公会成员]";
				mes "好，在那里签名。哦，你很会拼写。好，你的名字是……" + strcharinfo(0) + ".";
				next;
				mes "[魔法师公会成员]";
				mes "现在是";
				mes "给你测试的时候。";
				switch(rand(0,3)) {
				case 1:
					mes "制作 ^3355FF混合溶液 1 号^000000";
					mes "然后带回来。";
					set job_magician_q,1;
					break;
				case 2:
					mes "制作 ^3355FF混合溶液 2 号^000000";
					mes "然后带回来。";
					set job_magician_q,2;
					break;
				case 3:
					mes "制作 ^3355FF混合溶液 3 号^000000";
					mes "然后带回来。";
					set job_magician_q,3;
					break;
				default:
					mes "制作 ^3355FF混合溶液 4 号^000000";
					mes "然后带回来。";
					set job_magician_q,4;
				}
				next;
				getitem 1092,1; //Empty_Cylinder
				mes "[魔法师公会成员]";
				mes "公会指南书中有必要材料。出发前先查清所需物品。";
				next;
				mes "[魔法师公会成员]";
				mes "收集齐材料后，使用房间中央机器混合溶液。祝你好运！";
				close;
			}
			mes "[魔法师公会成员]";
			mes "什么~？！刚说想成为魔法师就改变主意？！果断一点！";
			close;
		}
		mes "嗯？准备好了吗……？";
		if (!callfunc("F_CanChangeJob")) {
			mes "哦，真遗憾。你还没满足要求。";
			next;
			mes "[魔法师公会成员]";
			mes "先回去将初心者职业等级提升到 9。别忘了回来前还要学会所有基础技能。";
			close;
		}
		mes "" + strcharinfo(0) + "的测试是……";
		if (job_magician_q == 1)
			mes "制作混合溶液 1 号。";
		else if (job_magician_q == 2)
			mes "制作混合溶液 2 号。";
		else if (job_magician_q == 3)
			mes "制作混合溶液 3 号。";
		else
			mes "制作混合溶液 4 号。";
		next;
		mes "[魔法师公会成员]";
		mes "好，让我";
		mes "检查你制作的";
		mes "溶液是否准确……";
		next;
		mes "[魔法师公会成员]";
		if (countitem(1071) == 0 && countitem(1085) == 0 && countitem(1086) == 0 && countitem(1087) == 0 && countitem(1090) == 0) {
			mes "嘿，我要的溶液";
			mes "在哪里……？你不拿给我，我怎么检查？";
			close;
		}
		else {
			if ((job_magician_q == 1 && countitem(1071) == 0) || (job_magician_q == 2 && countitem(1085) == 0) || (job_magician_q == 3 && countitem(1086) == 0) || (job_magician_q == 4 && countitem(1087) == 0)) {
				mes "等等。";
				mes "这不是";
				mes "我要的溶液！";
				next;
				mes "[魔法师公会成员]";
				if (job_magician_q == 1)
					mes "你应该制作混合溶液 1 号并带回来。现在再去试一次。";
				else if (job_magician_q == 2)
					mes "你应该制作混合溶液 2 号并带回来。现在再去试一次。";
				else if (job_magician_q == 3)
					mes "你应该制作混合溶液 3 号并带回来。现在再去试一次。";
				else
					mes "你应该制作混合溶液 4 号并带回来。现在再去试一次。";

				if (countitem(1071) != 0) delitem 1071,1; //Mage_Test_1
				else if (countitem(1085) != 0) delitem 1085,1; //Mage_Test_2
				else if (countitem(1086) != 0) delitem 1086,1; //Mage_Test_3
				else if (countitem(1087) != 0) delitem 1087,1; //Mage_Test_4
				else delitem 1090,1; //Mage_Test_Etc
				close;
			}
		}
		if (countitem(1071) != 0) delitem 1071,1; //Mage_Test_1
		else if (countitem(1085) != 0) delitem 1085,1; //Mage_Test_2
		else if (countitem(1086) != 0) delitem 1086,1; //Mage_Test_3
		else if (countitem(1087) != 0) delitem 1087,1; //Mage_Test_4
		else delitem 1090,1; //Mage_Test_Etc
		mes "嗯。我看得出你很努力。对初学者来说，这已经非常好了。";
		mes "做得好！";
		next;
		mes "[魔法师公会成员]";
		mes "好！很高兴告诉你，你通过了魔法师测试。我马上为你转职！";
		next;
		mes "[魔法师公会成员]";
		mes "*咳咳*";
		mes "恭喜！";
		mes "你现在是魔法师了！";
		next;
		for ( .@quest_id = 1005; .@quest_id <= 1008; .@quest_id++ ) {
			if (isbegin_quest(.@quest_id) == 1)
				completequest .@quest_id;
		}
		callfunc "Job_Change",Job_Mage;
		callfunc "F_ClearJobVar";
		set Zeny,Zeny+50;
		mes "[魔法师公会成员]";
		mes "‘欢迎来到我的世界~’";
		mes "嘿嘿，我只是想这么说。你知道，这是知名电影里的台词~";
		next;
		mes "[魔法师公会成员]";
		mes "既然你和我们一样成为魔法师，就交个朋友吧？";
		close;
	case 2:
		mes "[魔法师公会成员]";
		mes "想成为魔法师吗？";
		if (Sex == SEX_MALE)
			mes "像你这么可爱的人，我很乐意说明要求！";
		else
			mes "像你这么漂亮的女孩，我很乐意说明要求！";
		next;
		mes "[魔法师公会成员]";
		mes "首先，你必须达到初心者职业等级 10，并学会所有基本技能。然后通过魔法师测试。";
		next;
		if (job_magician_q != 0) {
			mes "[魔法师公会成员]";
			mes "你的测试是";
			switch(job_magician_q) {
			case 1:
				mes "为我制作";
				mes "^3355FF混合溶液 1 号^000000";
				mes "然后带回来。";
				if (isbegin_quest(1005) == 0)
					setquest 1005;
				break;
			case 2:
				mes "为我制作";
				mes "^3355FF混合溶液 2 号^000000";
				mes "然后带回来。";
				if (isbegin_quest(1006) == 0)
					setquest 1006;
				break;
			case 3:
				mes "为我制作";
				mes "^3355FF混合溶液 3 号^000000";
				mes "然后带回来。";
				if (isbegin_quest(1007) == 0)
					setquest 1007;
				break;
			default:
				mes "为我制作";
				mes "^3355FF混合溶液 4 号^000000";
				mes "然后带回来。";
				if (isbegin_quest(1008) == 0)
					setquest 1008;
				break;
			}
			next;
			mes "[魔法师公会成员]";
			mes "你可以在公会的指南书中查看制作溶液所需的材料。";
		}
		else {
			mes "[魔法师公会成员]";
			mes "签署申请表后，会告知你需要制作哪种混合溶液。";
		}
		next;
		mes "[魔法师公会成员]";
		mes "准备好成为魔法师后告诉我，好吗？";
		close;
	case 3:
		mes "[魔法师公会成员]";
		mes "没什么……？";
		close;
	}
}

geffen_in,164,112,4	script	Mixing Machine	111,{
	mes "[混合机器]";
	mes "这台机器属于吉芬魔法师公会，仅用于制作魔法溶液。";
	next;
	if (select("使用机器。:取消。") == 1) {
		mes "[混合机器]";
		mes "选择";
		mes "溶液的";
		mes "溶剂。";
		next;
		switch(select("斐扬溶液。:梦罗克溶液。:无溶剂。")) {
		case 1:
			if (countitem(1089) == 0) {
				mes "[混合机器]";
				mes "错误。";
				mes "找不到物品。";
				mes "请重新检查。";
				mes "处理中止。";
				close;
			}
			set .@mixitem2,1;
			break;
		case 2:
			if (countitem(1088) == 0) {
				mes "[混合机器]";
				mes "错误。";
				mes "找不到物品。";
				mes "请重新检查。";
				mes "处理中止。";
				close;
			}
			set .@mixitem2,2;
			break;
		case 3:
			set .@mixitem2,0;
			break;
		}
		while (1) {
			if (.@progress == 2) {
				mes "[混合机器]";
				if (.@mixitem1_1 != 0) mes "杰勒比：" + .@mixitem1_1 + " 个。";
				if (.@mixitem1_2 != 0) mes "柔毛：" + .@mixitem1_2 + " 个。";
				if (.@mixitem1_3 != 0) mes "牛奶：" + .@mixitem1_3 + " 个。";
				if (.@mixitem2 == 0) mes "溶剂：无。";
				if (.@mixitem2 == 1) mes "溶剂：斐扬溶液。";
				if (.@mixitem2 == 2) mes "溶剂：梦罗克溶液。";
				next;
				mes "[混合机器]";
				mes "请选择开始混合，或重新输入要混合的物品数量。";
				next;
				switch(select("开始混合。:重新输入物品数量。:重置。")) {
				case 1:
					mes "[混合机器]";
					mes "请将物品放入混合容器。确认物品数量正确。";
					next;
					mes "[混合机器]";
					mes "物品放入混合容器后，无法调整或恢复。";
					next;
					mes "[混合机器]";
					mes "确认无误后，准备好时按‘混合’按钮。否则按‘取消’按钮。";
					next;
					if (select("按‘混合’按钮。:按‘取消’按钮。") == 1) {
						mes "[混合机器]";
						mes "现在将物品放入混合容器。请稍候。";
						next;
						mes "[混合机器]";
						if (countitem(909) < .@mixitem1_1) {
							mes "杰勒比不足。";
							mes "请重新检查。";
							mes "处理中止。";
							close;
						}
						else if (countitem(914) < .@mixitem1_2) {
							mes "柔毛不足。";
							mes "请重新检查。";
							mes "处理中止。";
							close;
						}
						else if (countitem(519) < .@mixitem1_3) {
							mes "牛奶不足。";
							mes "请重新检查。";
							mes "处理中止。";
							close;
						}
						else if (.@mixitem2 == 1 || .@mixitem2 == 2) {
							if (countitem(1089) == 0 && countitem(1088) == 0) {
								mes "找不到溶液。";
								mes "请重新检查。";
								mes "处理中止。";
								close;
							}
						}
						if (.@mixitem1_1 != 0) delitem 909,.@mixitem1_1; //Jellopy
						if (.@mixitem1_2 != 0) delitem 914,.@mixitem1_2; //Fluff
						if (.@mixitem1_3 != 0) delitem 519,.@mixitem1_3; //Milk
						if (.@mixitem2 == 1) delitem 1089,1; //Payon_Potion
						if (.@mixitem2 == 2) delitem 1088,1; //Morocc_Potion
						mes "物品已准备好。";
						mes "关上盖子。";
						set .@progress,3;
						next;
					}
					break;
				case 2:
					set .@continue,0;
					next;
					break;
				case 3:
					set .@mixitem1_1,0;
					set .@mixitem1_2,0;
					set .@mixitem1_3,0;
					set .@progress,0;
					set .@continue,0;
					mes "[混合机器]";
					mes "重置完成。";
					mes "要重新开始吗？";
					next;
					if (select("是。:否。") == 1)
						break;
					mes "[混合机器]";
					mes "处理中止。";
					mes "谢谢。";
					close;
				}
				if (.@progress == 3) break;
			}
			else if (.@progress == 1) {
				mes "[混合机器]";
				mes "什么也没找到。";
				next;
			}
			mes "[混合机器]";
			mes "选择要混合的物品。";
			while(1) {
				switch(select("杰勒比。:柔毛。:牛奶。:准备混合。")) {
				case 1:
					while(1) {
						input .@input;
						if (.@input > 10000) {
							next;
							mes "[混合机器]";
							mes "错误：物品数量超限。请输入小于 10,000 的数值后重试。";
							next;
						}
						else {
							if (countitem(909) > 0) set .@mixitem1_1,.@mixitem1_1 + .@input;
							set .@progress,2;
							break;
						}
					}
					break;
				case 2:
					while(1) {
						input .@input;
						if (.@input > 10000) {
							next;
							mes "[混合机器]";
							mes "错误：物品数量超限。请输入小于 10,000 的数值后重试。";
							next;
						}
						else {
							if (countitem(914) > 0) set .@mixitem1_2,.@mixitem1_2 + .@input;
							set .@progress,2;
							break;
						}
					}
					break;
				case 3:
					while(1) {
						input .@input;
						if (.@input > 10000) {
							next;
							mes "[混合机器]";
							mes "错误：物品数量超限。请输入小于 10,000 的数值后重试。";
							next;
						}
						else {
						if (countitem(519) > 0) set .@mixitem1_3,.@mixitem1_3 + .@input;
							set .@progress,2;
							break;
						}
					}
					break;

				case 4:
					if (.@progress != 2)
						set .@progress,1;
					set .@continue,1;
					next;
				}
				if (.@continue) break;
			}
		}
		mes "[混合机器]";
		mes "请输入";
		mes "魔法粉末的";
		mes "序列号。";
		next;
		while(1) {
			input .@input;
			if (.@input < 1000 || .@input > 9999) {
				mes "[混合机器]";
				if (.@input == 0) {
					mes "要跳过这个菜单吗？";
					next;
					if (select("是。:否。") == 1) {
						break;
					}
				}
				else {
					mes "序列号无效。";
					mes "请重试。";
					next;
				}

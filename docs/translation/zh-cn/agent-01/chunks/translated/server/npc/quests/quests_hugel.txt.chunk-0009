			mes "你感到温暖、安全、安心。";
			mes "仅仅靠近它，就会带来强烈的舒适感。^000000";
			close;
		} else if (hg_memory == 1) {
			mes "^3355FF不知为何，";
			mes "靠近这棵树时，你感到温暖、安全、安心。";
			mes "仅仅靠近它，就会带来强烈的舒适感。^000000";
			close;

			if (rand(1,5) > 4) {
				mes "- 虫子迅速逃走了。你没能收集到它们的外壳。-";
				specialeffect2 EF_STUNATTACK;
				close;
			}
			mes "- 你成功收集了莫克斯虫外壳。-";
			specialeffect2 EF_VALLENTINE2;
			set hg_tre,hg_tre+1;
			if (hg_tre == 31)
				mes "已收集莫克斯虫外壳：1 个";
			else if (hg_tre == 32)
				mes "已收集莫克斯虫外壳：2 个";
			else if (hg_tre == 33)
				mes "已收集莫克斯虫外壳：3 个";
			else if (hg_tre == 34)
				mes "已收集莫克斯虫外壳：4 个";
			else if (hg_tre == 35)
				mes "已收集莫克斯虫外壳：5 个";
			initnpctimer;
			disablenpc "Moks Bugs#Bug3";
			close;
		case 2:
			mes "- 你决定绕过它们。-";
			close;
		}
	} else if (hg_tre == 35) {
		mes "["+strcharinfo(0)+"]";
		mes "啊……我不想碰虫子这种脏东西！";
		close;
	}

OnTimer20000:
	enablenpc "Moks Bugs#Bug3";
	stopnpctimer;
	end;
}


			close;
		} else {
			mes "^3355FF不知为何，";
			mes "靠近这棵树时，你感到温暖、安全、安心。";
			mes "仅仅靠近它，就会带来强烈的舒适感。^000000";
			close;
		}
	} else {
		mes "^3355FF不知为何，靠近这棵树时，";
		mes "你感到温暖、安全、安心。";
		mes "仅仅靠近它，就会带来强烈的舒适感。^000000";
		close;
	}
}

hugel,191,172,3	script	Manainne	892,1,{
	if (hg_memory == 1) {
		mes "[Manainne]";
		mes "这棵树对镇上每个人都意义重大，";
		mes "我们都有关于这里的特别回忆。";
		mes "但那个伊尔·沙特打算砍掉它建商店……";
		next;
		mes "[Manainne]";
		mes "看到他了吗？那边就是伊尔·沙特。";
		mes "我从没见过这么残酷自私的人！";
		mes "他现在正在勘察土地准备施工……";
		set hg_memory,2;
		changequest 8057,8058;
		close;
	} else if (hg_memory == 2) {
		mes "[Manainne]";
		mes "这棵树对镇上每个人都意义重大，我们都有关于这里的特别回忆。";
		mes "但那个伊尔·沙特打算砍掉它建商店……";
		next;
		mes "[Manainne]";
		mes "看到他了吗？那边就是伊尔·沙特。";
		mes "我从没见过这么残酷自私的人！他现在正在勘察土地准备施工……";
		close;
	} else if (hg_memory == 5) {
		mes "[Manainne]";
		mes "你知道，伊尔·沙特和我以前相处得很好，";
		mes "那时他在和我姐姐卡奈茵约会。";
		mes "他们总是在那棵树下共度时光。很奇怪吧？";
		next;
		mes "[Manainne]";
		mes "后来卡奈茵病得很重，而我们……";
		mes "我们没能救她。她去世后，伊尔·沙特也消失了。";
		mes "直到最近他才回来。";
		next;
		mes "[Manainne]";
		mes "现在伊尔·沙特只是个无情的守财奴……！";
		mes "他完全变了。";
		mes "姐姐要是看到现在的他，肯定会在墓里翻身……";
		set hg_memory,6;
		changequest 8061,8062;
		close;
	} else if (hg_memory == 6) {
		mes "[Manainne]";
		mes "现在伊尔·沙特只是个无情的守财奴……！他完全变了。";
		mes "姐姐要是看到现在的他，肯定会在墓里翻身……";
		close;
	} else if (hg_memory == 7) {
		mes "[Manainne]";
		mes "什么？那是……";
		mes "真令人难以置信。你在尼夫海姆见到了我死去的姐姐？！";
		mes "你一定是在骗我！";
		next;
		mes "[Manainne]";
		mes "我们……别再谈这个了，好吗？";
		mes "我很感激你想阻止伊尔·沙特砍树，";
		mes "但这已经有点太过分了。";
		next;
		set hg_memory,8;
		mes "[Manainne]";
		mes "天啊，谈到尼夫海姆……";
		mes "让我浑身发冷！你、你不觉得冷吗？";
		close;
	} else if (hg_memory == 8) {
		mes "[Manainne]";
		mes "......";
		mes ".........";
		mes "嗯？你……";
		mes "还在这里……？";
		next;
		mes "[Manainne]";
		mes "你、你知道奇怪的是什么吗？天气明明很好，";
		mes "但我……突然觉得好冷。";
		mes "你完全感觉不到，对吧？";
		next;
		mes "[Manainne]";
		mes "我想我可能生病了。我的头好麻，";
		mes "思、思绪也无法集中。";
		mes "这让我害怕……";
		next;
		mes "[Manainne]";
		mes "...!";
		next;
		set hg_memory,9;
		mes "[Manainne]";
		mes "......";
		mes "..........";
		close;
	} else if (hg_memory == 9) {
		mes "[Manainne]";
		mes "……我回来了。真的";
		mes "回来了！哦，好久不见！";
	mes "回来了！哦，好久不见！你好，冒险者，还记得我吗？";
	mes "我是卡奈茵，就是你在尼夫海姆见到的灵魂。让我解释一下……";
		next;
		mes "[Manainne]";
	mes "我的灵魂跟着你来到这里，只能借用妹妹的身体一小会儿，";
	mes "然后和伊尔·沙特谈谈。伊尔·沙特？伊尔·沙特……？";
		next;
		mes "[El Schatt]";
	mes "玛奈茵……？你想干什么？";
	mes "别烦我，我现在很忙……";
		next;
		mes "[Manainne]";
	mes "是……是我，伊尔·沙特，我是卡奈茵。";
	mes "你当然记得我，对吧？听着，我需要——";
		next;
		mes "[El Schatt]";
	mes "玛奈茵……？！我很震惊……";
	mes "你难道不尊重自己的姐姐吗？！真不敢相信你会……马上住手！";
		next;
		set hg_memory,10;
		mes "[El Schatt]";
	mes "看在我尊重你以及我和你姐姐关系的份上，我会忘记你刚才的话。";
	mes "但你再也不许那样叫她的名字！";
		next;
		mes "[Manainne]";
		mes "......";
		mes ".........";
		mes "............";
		close;
	} else if (hg_memory == 10) {
		mes "[Manainne]";
		mes "等等，伊尔·沙特！";
		mes "真的是我，但我只能借妹妹的身体和你说一小会儿。听、听着……";
		next;
		mes "[El Schatt]";
		mes "玛奈茵……不要拿逝者开这种玩笑，尤其她还是卡奈茵。";
		mes "你应该明白！你的尊重都到哪里去了？！";
		next;
		mes "[Manainne]";
		mes "‘如果你是风，我愿成为天空，";
		mes "让你在我的怀抱中自由飞翔……’";
		next;
		mes "[El Schatt]";
		mes "嗯……？！";
		next;
		mes "[Manainne]";
		mes "‘我的灵魂只为你，";
		mes "你是照亮我整个世界的";
		mes "灿烂太阳。’";
		next;
		mes "[El Schatt]";
		mes "你怎么……";
		mes "你怎么知道这些话……？";
		next;
		mes "[Manainne]";
		mes "‘在我的梦里，你的眼睛映照着大海清澈的水……总有一天我会带你去看。’";
		next;
		mes "[Manainne]";
		mes "‘你可爱的脸庞，你迷人的笑容……";
		mes "它们永远留在我心中，我再也不会孤独。’";
		next;
		mes "[El Schatt]";
		mes "玛奈茵……你怎么知道那首歌？";
		next;
		mes "[Manainne]";
		mes "伊尔·沙特……是我，卡奈茵。";
		mes "你专门为我写了这首歌，但在你完成之前我就去世了。";
		next;
		mes "[Manainne]";
		mes "那是你的梦想，对吧？";
		mes "用美妙的音乐让人们快乐？";
		mes "你最终为我完成了我们的歌吗？";
		next;
		mes "[El Schatt]";
		mes "哈哈哈，玛奈茵，好吧。";
		mes "一定是你姐姐把那首歌告诉你的。哈哈……";
		mes "你、你太过分了……请……请住手。";
		next;
		mes "[Manainne]";
		mes "伊尔·沙特……听我说。看着我，我真的是你的卡奈茵。";
		next;
		mes "[El Schatt]";
		mes "卡奈茵……？";
		mes "这太难以置信了。我真的很想相信……";
		mes "真的是你吗？";
		set hg_memory,11;
		close;
	} else if (hg_memory == 11) {
		mes "[Manainne]";
		mes "伊尔·沙特……";
		close;
	} else if (hg_memory == 12) {
		mes "^3355FF玛奈茵无法控制地哭泣，";
		mes "你什么也做不了，无法安慰她。";
		mes "什么都做不了。你必须让她独自面对绝望和难以理解的失落感。^000000";

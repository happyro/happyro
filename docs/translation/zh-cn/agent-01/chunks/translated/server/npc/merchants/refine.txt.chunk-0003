// Ori/Elu Functions
//============================================================
function	script	orimain	{
	if (checkweight(1201,1) == 0) {
		mes "- 等一下！！ -";
		mes "- 你目前携带了 -";
		mes "- 太多物品。-";
		mes "- 请重试 -";
		mes "- 清理背包后。-";
		close;
	}
	.@npc_name$ = getarg(0);
	mes "["+ .@npc_name$ +"]";
	mes "我可以净化你的";
	mes "神之金属原石或";
	mes "铝原石。我需要";
	mes "5 个原石制作";
	mes "1 个纯矿石。";
	next;
	switch(select("制作神之金属:制作铝:询问附魔石")) {
	case 1:
		if (countitem(756) > 4) {
			delitem 756,5;  //Oridecon_Stone
			getitem 984,1; // Oridecon
			mes "["+ .@npc_name$ +"]";
			mes "这是你的神之金属。";
			mes "欢迎随时";
			mes "回来。";
			close;
		}
		else {
			mes "["+ .@npc_name$ +"]";
			mes "你在开玩笑吧？";
			mes "我刚说过需要 5 个神之金属原石才能制作纯神之金属。";
			close;
		}
	case 2:
		if (countitem(757) > 4) {
			delitem 757,5;  //Elunium_Stone
			getitem 985,1; // Elunium
			mes "["+ .@npc_name$ +"]";
			mes "这是你的铝。";
			mes "欢迎随时";
			mes "回来。";
			close;
		}
		else {
			mes "["+ .@npc_name$ +"]";
			mes "你在开玩笑吧？";
			mes "我刚说过需要 5 个铝原石才能制作纯铝。";
			close;
		}
	case 3:
		mes "["+ .@npc_name$ +"]";
		mes "附魔石……？";
		mes "我做石匠 20 年，听说过很多。传说有";
		mes "四种。";
		next;
		mes "["+ .@npc_name$ +"]";
		mes "每种附魔石拥有一种属性：地、风、水或火。";
		next;
		mes "["+ .@npc_name$ +"]";
		mes "锻造时将附魔石与武器结合，武器就会拥有与石头相同的属性。";
		next;
		mes "["+ .@npc_name$ +"]";
		mes "不用说，你需要锻造技能才能制作这种属性武器。";
		close;
	}
}


function	script	phramain	{
	if (checkweight(1201,1) == 0) {
		mes "- 等一下！！ -";
		mes "- 你目前携带了 -";
		mes "- 太多物品。-";
		mes "- 请重试 -";
		mes "- 清理背包后。-";
		close;
	}
	.@npc_name$ = getarg(0);
	mes "["+ .@npc_name$ +"]";
	mes "我出售两种";
	mes "用于淬炼武器的金属。";
	mes "我有供 1 级武器使用的 ^007777普拉康^000000，";
	mes "以及供 2 级武器使用的 ^007777艾姆威泰勒矿石^000000";
	mes "。";
	next;
	switch(select("普拉康 - 200 Zeny:艾姆威泰勒矿石 - 1000 Zeny:询问其他金属")) {
	case 1:
		.@material = 1010;
		.@price = 200;
		break;
	case 2:
		.@material = 1011;
		.@price = 1000;
		break;
	case 3:
		mes "["+ .@npc_name$ +"]";
		mes "其他金属？";
		mes "高等级武器或任何护甲都需要特殊金属。不过，神之金属和铝原石很";
		mes "难找到……";
		close;
	}
	mes "["+ .@npc_name$ +"]";
	mes "你想买多少？";
	mes "不想买请输入数字“0”。";
	next;
	while(1) {
		input .@input;
		if (.@input == 0) {
			mes "["+ .@npc_name$ +"]";
			mes "交易已";
			mes "取消。";
			close;
		}
		else if (.@input < 0 || .@input > 500) {
			mes "["+ .@npc_name$ +"]";
			mes "好，你最多可以";
			mes "购买 500 个。";
			mes "不能更多，";
			mes "明白了吗？很好。";
			next;
		}
		else {
			break;
		}
	}
	.@sell = .@input * .@price;
	if (Zeny < .@sell) {
		mes "["+ .@npc_name$ +"]";
		mes "呃……";
		mes "你没有足够 Zeny 购买";
		mes "";
		mes ""+ .@input +" 个。";
		close;
	}
	if (checkweight(.@material,.@input) == 0) {
		mes "["+ .@npc_name$ +"]";
		mes "嗯……";
		mes "背包空间不足，无法给你物品。把多余物品存入卡普拉仓库后重试吧？";
		close;
	}
	getitem .@material,.@input;
	Zeny = Zeny-.@sell;
	mes "["+ .@npc_name$ +"]";
	mes "给你！";
	mes "感谢";
	mes "惠顾。";
	close;
}


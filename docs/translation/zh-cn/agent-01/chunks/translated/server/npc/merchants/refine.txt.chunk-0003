// Equipment Repair Function
//============================================================
function	script	repairmain	{
	.@repairprice = 5000;
	.@npc_name$ = getarg(0);
	mes "["+ .@npc_name$ +"]";
	mes "你好！";
	mes "想让我";
	mes "修理什么物品吗？";
	mes "物品修理";
	mes "交给我就行！";
	next;
	switch(select("我确实有些物品……:现在没有。")) {
	case 1:
		.@checkitem = 1;
		while (1) {
			if (getbrokenid(.@checkitem) == 0) {
				break;
			}
			.@checkitem = .@checkitem+1;
		}
		.@checkitem = .@checkitem-1;
		if (!.@checkitem) {
			mes "["+ .@npc_name$ +"]";
			mes "哇，真不可思议！";
			mes "你一定把物品保管得很好，没有一件物品损坏！";
			next;
			mes "["+ .@npc_name$ +"]";
			mes "如果大家都像你一样，我就要失业了！！哈哈~！";
			close;
		}
		mes "["+ .@npc_name$ +"]";
		mes "嗯……";
		mes "让我看看……";
		mes "在你的所有物品中，";
		mes "共有 " + .@checkitem + " 件物品损坏。";
		mes "要修理吗？";
		next;
		.@totalcost = .@repairprice*.@checkitem;
		mes "["+ .@npc_name$ +"]";
		mes "每件物品修理费为 " + .@repairprice + " Zeny。修理全部损坏物品需要 " + .@totalcost + " Zeny！要修理这些物品吗？";
		next;
		switch(select("是:否")) {
		case 1:
			if (Zeny < .@totalcost) {
				mes "["+ .@npc_name$ +"]";
				mes "哎呀哎呀……";
				mes "收到修理账单前先看看钱包吧！你的 Zeny 不够，我什么都修不了。";
				close;
			}
			.@checkitem2 = 1;
			while (1) {
				if (getbrokenid(.@checkitem2) == 0) {
					break;
				}
				.@checkitem2 = .@checkitem2+1;
			}
			.@checkitem2 = .@checkitem2-1;
			if (.@checkitem == .@checkitem2) {
				Zeny = Zeny-.@totalcost;
				while (.@checkitem) {
					repair(.@checkitem);
					.@checkitem = .@checkitem-1;
				}
				mes "["+ .@npc_name$ +"]";
				mes "好了！全部完成。以后请稍微小心一点，物品也是有寿命的。";
				close;
			}
			else {
				mes "["+ .@npc_name$ +"]";
				mes "嗯？好像有些不对。等等……装备需要修理的物品后再回来找我。";
				close;
			}
		case 2:
			mes "["+ .@npc_name$ +"]";
			mes "这倒不是我的损失，但让物品一直损坏可不好。你应该尽快修理！";
			close;
		}
	case 2:
		mes "["+ .@npc_name$ +"]";
		mes "呵呵呵……";
		mes "如果没有";
		mes "物品要修理，";
		mes "就没必要";
		mes "来找我。";
		close;
	}
}


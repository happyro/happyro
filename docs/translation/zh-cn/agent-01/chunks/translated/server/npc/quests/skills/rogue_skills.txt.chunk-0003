prt_are01,136,150,0	duplicate(Kienna#1st)	Kienna#2nd	700,1,1
prt_are01,150,138,0	duplicate(Kienna#1st)	Kienna#3rd	700,1,1
prt_are01,163,147,0	duplicate(Kienna#1st)	Kienna#4th	700,1,1
prt_are01,134,140,0	duplicate(Kienna#1st)	Kienna#5th	700,1,1
prt_are01,161,140,0	duplicate(Kienna#1st)	Kienna#6th	700,1,1
prt_are01,161,160,0	duplicate(Kienna#1st)	Kienna#7th	700,1,1
prt_are01,138,159,0	duplicate(Kienna#1st)	Kienna#8th	700,1,1

function	script	F_Kienna	{
	if (ROG_SK == 6) {
		donpcevent "#1stmove::OnDisable";
		mes "[基恩娜]";
		mes "好，在这个";
		mes "练习中，你需要预测";
		mes "我会往哪边移动，并阻挡";
		mes "我的移动，也就是";
		mes "让我无法动弹。准备好~";
		set ROG_SK,7;
		next;
		for(set .@lim_1,0; .@lim_1<10; set .@lim_1,.@lim_1+1) {
			set .@move_1,rand(1,3);
			if (select("挡住她的左边:挡住她的右边:挡住她的退路") == .@move_1) {
				mes "[基恩娜]";
				mes "嗯……？";
				mes "你挡住我了！";
				mes "做得很好~";
				specialeffect EF_POTION1;
				specialeffect2 EF_POTION7;
				set .@suc_1,.@suc_1 + 1;
			}
			else {
				mes "[基恩娜]";
				mes "抱歉，但我没有";
				mes "往那个方向移动。";
				mes "你的阻挡失败了……";
			}
			next;
		}
		mes "[基恩娜]";
		mes "好了，我们在这里";
		mes "结束。你的训练等级是";
		switch(.@suc_1) { 
		case 10:
			mes "训练等级为‘’^0000FFS^000000‘’。";
			mes "这是满分！";
			break;
		case 9:
			mes "训练等级为‘’^0000FFA^000000‘’。";
			mes "你真的很擅长！";
			break;
		case 8:
			mes "训练等级为‘’^0000FFB +^000000‘’。";
			mes "非常值得称赞！";
			break;
		case 7:
			mes "训练等级为‘’^0000FFB^000000‘’。";
			mes "做得很棒~";
			break;
		case 6:
			mes "训练等级为‘’^0000FFC +^000000‘’。";
			mes "还不错，但你";
			mes "只是勉强通过！";
			break;
		case 5:
			mes "训练等级为‘’^FF0000C^000000‘’。";
			break;
		case 4:
			mes "训练等级为‘’^FF0000D+^000000‘’。";
			break;
		case 3:
			mes "训练等级为‘’^FF0000D^000000‘’。";
			break;
		case 2:
			mes "训练等级为‘’^FF0000F^000000‘’。";
			break;
		case 1:
			mes "训练等级为‘’^FF0000F -^000000‘’。";
			break;
		case 0:
			mes "训练等级是……";
			mes "实际上我无法";
			mes "计算出来。发生什么了？！";
		}
		next;
		if (.@suc_1 > 5) {
			mes "[基恩娜]";
			mes "很高兴告诉你，";
			mes "你完成了训练！让我把你";
			mes "送回索尔·格雷格，";
			mes "这样你就能完成";
			mes "^FF0000紧身^000000技能的学习。";
			set ROG_SK,8;
			disablenpc "Kienna#"+getarg(0);
			donpcevent "#1st5min::OnDisable";
			enablenpc "#1strecog";
			close2;
			donpcevent "Waiting Room#rogue10::OnEnable";
			warp "in_rogue",264,124;
			end;
		}
		else {
			mes "[基恩娜]";
			mes "嗯，以这个等级，";
			mes "我不认为你已经";
			mes "准备好完成";
			mes "紧身技能的学习。";
			mes "要再试一次";
			mes "训练吗？";
			next;
			if (select("是！:不用了，谢谢。") == 1) {
				disablenpc "Kienna#"+getarg(0);
				donpcevent "#1stmove::OnEnable";
				set ROG_SK,6;
				warp "prt_are01",150,150;
				end;
			}
			disablenpc "Kienna#"+getarg(0);
			donpcevent "#1st5min::OnDisable";
			enablenpc "#1strecog";
			set ROG_SK,6;
			donpcevent "Waiting Room#rogue10::OnEnable";
			warp "in_rogue",264,124;
			end;
		}
	}
	else if (ROG_SK == 7) {
		mes "[基恩娜]";
		mes "你一定是在练习中途";
		mes "取消了训练。很遗憾，";
		mes "你必须从这项训练的";
		mes "最开始重新进行。";
		set ROG_SK,6;
		close2;
		disablenpc "Kienna#"+getarg(0);
		donpcevent "#1stmove::OnEnable";
		warp "prt_are01",150,150;
		end;
	}
	else if (ROG_SK == 8) {
		mes "[基恩娜]";
		mes "你已经完成了";
		mes "紧身技能的训练。";
		mes "你不再需要";
		mes "我的帮助。";
		close2;
		donpcevent "Waiting Room#rogue10::OnEnable";
		warp "in_rogue",264,124;
		end;
	}
	else {
		mes "[基恩娜]";
		mes "抱歉，但我不认为你";
		mes "应该在这里。";
		mes "如果你迷路了，我送你去";
		mes "盗贼公会吧……";
		close2;
		donpcevent "Waiting Room#rogue10::OnEnable";
		warp "in_rogue",264,124;
		end;
	}

OnInit:
	disablenpc "Kienna#1st";
	disablenpc "Kienna#2nd";
	disablenpc "Kienna#3rd";
	disablenpc "Kienna#4th";
	disablenpc "Kienna#5th";
	disablenpc "Kienna#6th";
	disablenpc "Kienna#7th";
	disablenpc "Kienna#8th";
	end;
}

in_rogue,88,119,3	script	Waiting Room#rogue10	828,{
OnEnable:
	enablenpc "Waiting Room#rogue10";
	enablewaitingroomevent "Waiting Room#rogue10";
	end;

OnInit:
	waitingroom "训练场",10,"Waiting Room#rogue10::OnStartArena",1;
	enablewaitingroomevent "Waiting Room#rogue10";
	end;

OnStartArena:
	warpwaitingpc "prt_are01",150,150;
	disablewaitingroomevent "Waiting Room#rogue10";
	end;
}


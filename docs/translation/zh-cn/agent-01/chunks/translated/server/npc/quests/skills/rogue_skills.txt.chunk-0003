		}
		else if (ROG_SK == 9) {
			mes "[杰伊·格雷格]";
			mes "嗯。你最好";
			mes "和我父亲谈谈，了解";
			mes "更多关于紧身技能的细节。";
			mes "你在盗贼公会的";
			mes "紧急房间见过他吗？";
			close;
		}
		else if (ROG_SK == 12) {
			mes "[杰伊·格雷格]";
			mes "蔡泽培看起来确实是个";
			mes "固执又粗鲁的家伙。";
			mes "但他能创造自己的技能，";
			mes "一定相当聪明。";
			close;
		}
		mes "[杰伊·格雷格]";
		mes "我感觉你将会成为";
		mes "最优秀的盗贼之一，";
		mes "如果你现在还不是的话。";
		close;
	}
	mes "[杰伊·格雷格]";
	mes "自从学会恐吓以来，";
	mes "我变得很爱动手，甚至有点";
	mes "自虐倾向。我的意思是，";
	mes "如果他们用技能攻击你，";
	mes "你就能用同样的技能反击！";
	close;
}


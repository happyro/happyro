			delitem .@Items[.@i], countitem(.@Items[.@i]);
			set Zeny, Zeny + .@zeny_tt;
			//getexp .@exp_tt,0;
			close;
		case 2:
			mes "[莉艾]";
			mes "当然，没问题。";
			mes "想领取奖励时回来找我说话就好，明白了吗？";
			close;
	}
}

tha_t02,231,161,5	script	Entrance Guide	874,{
	mes "[伯雷德]";
	if (thana_tower == 0) {
		mes "你现在位于三楼入口前。只有签约的临时员工";
		mes "才有权限进入该区域。关于莱肯贝尔临时合同的信息，";
		mes "请咨询二楼指南。";
		close;
	}
	mes "这里是通往三楼的道路。";
	mes "只有签约员工可以进入。";
	mes "我能帮你什么？";
	next;
	switch(select("让我去三楼。:塔楼信息。:开始交谈。")) {
	case 1:
		mes "[伯雷德]";
		mes "哦，好吧。让我确认一下你是否在临时工名单上。嗯……";
		mes "啊，你是"+strcharinfo(0)+"，对吧？";
		next;
		mes "[伯雷德]";
		if (getareausers("tha_t02",226,156,236,166) < 5) {
			mes "首先，我们要等至少 5 名临时工集合组成工作组。";
			mes "现在总共有 "+getareausers("tha_t02",226,156,236,166)+" 名临时工在等待进入三楼。";
			next;
			mes "[伯雷德]";
			mes "如果可以，请叫你的朋友到我附近来帮忙。";
			mes "请理解，临时工人数要求是出于各种安全原因。";
			close;
		}
		mes "太好了，你来得正是时候。";
		mes "我们刚好达到至少 5 名临时工的要求，";
		mes "很快就会打开通往三楼的门。";
		next;
		mes "[伯雷德]";
		mes "三楼入口很快就会关闭，请尽快进入。";
		mes "我们必须迅速关门，否则塔里的魔物会进入下层……";
		if (thana_tower > 3) {
			next;
			mes "^4d4dff伯雷德轻轻微笑，只有我注意到了。";
			mes "我点点头，看着他打开大门。^000000";
		}
		close2;
		donpcevent "3rdf_warp#tt::OnEnable";
		end;
	case 2:
		mes "[伯雷德]";
		mes "这扇门是通往三楼的唯一通道。";
		mes "四楼以上的楼层之间只有单向通道，";
		mes "也就是说无法从进入的原路离开。";
		next;
		mes "[伯雷德]";
		mes "你看，五楼及以上楼层受到一种奇怪力量影响，";
		mes "人们无法通过进入楼层的通道原路返回。";
		next;
		mes "[伯雷德]";
		mes "所以如果你上到四楼以上，请务必小心，想办法回来。";
		next;
		mes "[伯雷德]";
		mes "塔顶是十二楼，越往上魔物越强。";
		mes "地形特征也会发生很大变化。";
		next;
		mes "[伯雷德]";
		mes "高层太危险，所以只有至少 5 名临时工在这里集合时，我们才会打开三楼入口。";
		mes "如果人数不足 5 人，你可能需要等待。";
		close;
	case 3:
		if (thana_tower < 3) {
			mes "[伯雷德]";
			mes "...?";
			mes "你有什么问题吗？";
			next;
			if(select("关于开发情况。:酷爱活动公司与莱肯贝尔公司的关系。:没有。") == 3) {
				mes "[伯雷德]";
				mes "保重。";
				close;
			}
			mes "[伯雷德]";
			mes "……嗯，你还真好奇。";
			mes "如果想知道更多，你能帮我一个忙吗？";
			mes "既然你问了我们的机密信息……";
			next;
			if(select("真的吗？别吓我。:直接告诉我吧。:以后再听。") == 3) {
				mes "[伯雷德]";
				mes "如你所愿……";
				mes "保重！";
				close;
			}
			mes "[伯雷德]";
			mes "哈哈，没什么大不了的。";
			mes "我们酷爱活动公司经营许多业务，包括普通活动、副本指南和物品交易。";
			next;
			mes "[伯雷德]";
			mes "虽然公司起步很小，但在莱肯贝尔公司的协助下逐渐壮大。";
			mes "是他们提议共同开发这座塔。";
			next;
			mes "[伯雷德]";
			mes "莱肯贝尔公司只负责挖掘遗迹进行研究。";
			mes "其余部分会改造成观光地，由酷爱活动公司负责经营。";
			next;
			mes "[伯雷德]";
			mes "这是有史以来最大的生意，也会成为非常赚钱的观光景点。";
			mes "但是……";
			next;
			mes "[伯雷德]";
			mes "塔内出现了相当强大的魔物。以前那里从未出现过魔物。";
			mes "事情发生后的第二天……";
			next;
			mes "[伯雷德]";
			mes "……总之，魔物意外出现，引发了一些麻烦……";
			mes "我们和莱肯贝尔公司都受到了冲击。";
			mes "经济方面受到影响，但更严重的是……";
			next;
			mes "[伯雷德]";
			mes "许多参与开发的员工都牺牲自己来到三楼。";
			next;
			mes "[伯雷德]";
			mes "就在我们全力投入这项生意时，那场事故发生了……";
			mes "最终我们与莱肯贝尔公司合并。";
			next;
			mes "[伯雷德]";
			mes "开发暂时搁置。现在只能招募冒险者来消灭魔物……";
			mes "是不是很可笑？";
			next;
			mes "[伯雷德]";
			mes "无论那里发生什么，他们都不会受伤。";
			mes "即使他们无法查明事故根源……";
			next;
			switch(select("哦……:你指的是什么事故？")) {
			case 1:
				mes "[伯雷德]";
				mes "是的，没什么大不了的。哈哈……";
				mes "如果我们继续这样工作，就会知道动物死亡的消息。";
				next;
				mes "[伯雷德]";
				mes "酷爱活动公司被认为是跟随者……";
				mes "他们没有说明死了多少人，也没有说明原因。";
				next;
				mes "[伯雷德]";
				mes "现在你对这件事感到好奇了。";
				mes "他们究竟为何牺牲？";
				next;
				mes "[伯雷德]";
				mes "我说得太多了。抱歉，我不该这样谈论这件事……我只是很在意，仅此而已。";
				set thana_tower, 3;
				close;
			case 2:
				mes "[伯雷德]";
				mes "如果你答应帮我一个忙……";
				next;
				switch(select("好！我答应。:不，我不答应。")) {
				case 1:
					callsub L_Request;
					next;
					mes "["+strcharinfo(0)+"]";
					mes "（到底是什么事故……？";
					mes "也许他之后会告诉我……）";
					close;
				case 2:
					mes "[伯雷德]";
					mes "……没有办法……";
					mes "他们要求你探索内部。你受雇来完成这次探索。";
					close;
				}
			}
		}
		else if (thana_tower == 3) {
			callsub L_Request;
			close;
		}
		else if (thana_tower == 4) {
			mes "[伯雷德]";
			mes "莱肯贝尔公司一定另有目的，因为他们似乎并不太关心这座塔。";
			mes "我想知道他们的意图。";
			next;
			mes "[伯雷德]";
			mes "这座塔被封印，与外界隔绝。我们需要打破封印，探索内部并进行开发。";
			next;
			mes "[伯雷德]";
			mes "我们正在开发三楼和四楼……那里仍有封印。";
			mes "在附近调查也许能找到一些线索。";
			close;
		}
		else if ((thana_tower > 4) && (thana_tower < 9)) {
			mes "[伯雷德]";
			mes "魔法钥匙和那些讯息？……我们绝对还没有掌握塔里的全部秘密……";
			next;
			mes "[伯雷德]";
			mes "是谁制作了封印？……你能继续调查吗？一定会有确凿证据……";
			close;
		}
		else if (thana_tower == 9) {
			mes "[伯雷德]";
			mes "有新的进展吗？";
			next;
			select("我找到了瓦尔蒙特的日志……");
			mes "—你把瓦尔蒙特的日志给他看。";
			mes "伯雷德阅读了日志。—";
			next;
			mes "[伯雷德]";
			mes "……我认得这个。";
			mes "这是智者瓦尔蒙特的全息影像。";
			mes "莱肯贝尔大型研究所的雷根施姆曾经……";
			next;
			mes "[伯雷德]";
			mes "……这不就是他们现在正在寻找的东西吗？！";
			mes "他们的任务不就是找出瓦尔蒙特的研究资料吗……？";
			next;
			mes "[伯雷德]";
			mes "为了协助未完成的研究……他们需要瓦尔蒙特的研究资料……";
			mes "……所以他们的任务不只是调查这座塔。";
			next;
			mes "[伯雷德]";
			mes "他们想得到某种优势……连他们也不知道它在哪里……";
			mes "……总之，这是他们的主要目标之一。";
			next;
			mes "[伯雷德]";
			mes "太棒了。这是智者瓦尔蒙特的遗物，真令人难以置信！";
			mes "现在我们该怎么处理？";
			next;
			mes "[伯雷德]";
			mes "原本我们在塔里发现的一切都由莱肯贝尔公司控制。";
			mes "这本该属于他们，但是……";
			next;
			mes "[伯雷德]";
			mes ""+strcharinfo(0)+"，你愿意保留这个吗？";
			mes "这件事一定要保密。";
			mes "……嗯，就当是对他们的小小报复。";
			next;
			mes "[伯雷德]";
			mes "从这份笔记来看，我猜这座塔里还有几个秘密。";
			mes "在莱肯贝尔发现之前，这个秘密应该由你，"+strcharinfo(0)+"，揭开。";
			next;
			mes "[伯雷德]";
			mes "无论他们获得多少力量……他们都不会知道这座塔的秘密……";
			mes "哈哈……";
			next;
			mes "[伯雷德]";
			mes "……哈哈……我感觉轻松了一些。谢谢。";
			mes "这不算什么，但请收下回礼。";
			next;
			mes "[伯雷德]";
			mes "希望这些东西对你有用，"+strcharinfo(0)+"。";
			next;
			mes "—伯雷德把笔记和一个旧紫色箱子交给你。—";
			mes " ";
			mes "^4d4dff你获得一个旧紫色箱子，";
			mes "以及少量经验值。^000000";
			set thana_tower, 10;
			completequest 7053;
			getexp 120000,10000;
			getitem 617,1; //Old_Violet_Box
			close;
		}
		else {
			mes "[伯雷德]";
			mes "你把秘密保守得很好吗？";
			mes "这座塔顶真的有幻影吗？";
			if (rand(3) == 1) {
				mes "你看起来很累。这不是什么大事，但这是给你的。";
				npcskill "AL_HEAL",11,50,70;
			}
			close;
		}
	}

L_Request:
	mes "[伯雷德]";
	mes "啊，并不难。探索完塔后，把你了解到的一切详细告诉我。";
	next;
	mes "[伯雷德]";
	mes "我无法相信莱肯贝尔公司。许多同事和朋友为他们而死。";
	mes "但莱肯贝尔公司从不公开他们死亡的原因。";
	next;
	mes "[伯雷德]";
	mes "从一开始我们的处境就很糟……";
	mes "除了研究资料，所有开发区域都会变成观光景点……";
	mes "说实话，所有员工都来自酷爱活动公司。";
	next;
	mes "[伯雷德]";
	mes "他们也知道这件事。";
	mes "这项事业需要大量牺牲，也需要愿意承担的人。";
	next;
	mes "[伯雷德]";
	mes "我现在已经不再觉得自己是受害者，但我想知道是什么导致了这些事故……";
	mes "^4d4dff是什么让我们成为受害者……？^000000";
	mes "这就是我想知道的。";
	next;
	mes "[伯雷德]";
	mes "这座塔究竟是什么？";
	mes "他们为什么开发这个危险的地方？为了什么？";
	mes "我的同事难道就该为此丧命吗？";
	next;
	mes "[伯雷德]";
	mes "我真的很想知道。";
	mes "他们为什么必须牺牲自己……请让我知道……";
	next;
	mes "他真的很想知道。";
	mes "他的双手正在颤抖……";
	mes "我没有回答，只是点了点头。";
	set thana_tower, 4;
	setquest 7048;
	return;
}

tha_t02,227,163,0	script	3rdf_warp#tt	45,1,1,{
	end;
OnInit:
	disablenpc "3rdf_warp#tt";
	end;
OnTouch_:
	if (thana_tower == 0) warp "tha_t02",227,158;
	else warp "tha_t03",219,159;
	end;
OnEnable:
	enablenpc "3rdf_warp#tt";
	initnpctimer;
	end;
OnTimer30000:
	stopnpctimer;
	disablenpc "3rdf_warp#tt";
	end;
}

tha_t03,67,70,0	script	Rune Device#tt1	111,4,4,{
	if ((countitem(7421) == 0) && (countitem(7426) == 0)) {
		mes "^3355FF神秘的能量场环绕着机械装置，";
		mes "它的力量阻止你靠近机器。^000000";
		next;
		switch(select("调查它。:我不在乎。")) {
		case 1:
			mes "["+strcharinfo(0)+"]";
			mes "这很神秘……让我调查一下。";
			next;
			mes "^3355FF沿着魔力追踪，你发现符文装置内部包裹着某种东西。^000000";
			next;
			if (Class == Job_Taekwon) {
				mes "^3355FF你用尽全力踢向能量场。它吸收冲击后，伴随着轻柔的‘滋滋’声消散。^000000";
				next;
				goto L_Key;
			}
			else if (getequipweaponlv(EQI_HAND_R) == 4) {
				mes "^3355FF你手持 "+getequipname(EQI_HAND_R)+"，用尽全力砸向能量场。";
				mes "它吸收冲击后，伴随着轻柔的‘滋滋’声消散。^000000";
				next;
				goto L_Key;
			}
			else {
				mes "^3355FF你用武器全力砸向能量场，却无法打破屏障。";
				mes "你可能需要更强大的武器……^000000";
				close;
			}
		case 2:
			mes "^3355FF你决定不再理会这台机器。^000000";
			close;
		}
	}
	mes "你已经从这个符文装置中取得了所需的一切。";
	close;

OnTouch_:
	if ((countitem(7421) == 0) && (countitem(7426) == 0))
		specialeffect EF_LEVEL99_4;
	end;

L_Key:
	specialeffect EF_BRANDISH2;
	mes "打破装置后，外壳碎裂。";
	mes "能量场开始消失，你看到内部的红色物体正是魔力来源。";
	next;
	mes "—你获得了强力的红钥匙。—";
	getitem 7421,1; //Key_Red
	if (thana_tower != 4) close;
	mes "^4d4dff拿起钥匙后，一阵震撼的感觉穿过你的脑海。";
	mes "你看到一道光的幻象……^000000";
	next;
	switch(select("忽略它。:集中注意力。")) {
	case 1:
		mes "^3355FF你决定不再理会这台机器。^000000";
		close;
	case 2:
		mes "你集中注意力看着光。";
		mes "一些文字开始浮现……";
		next;
		mes "^b22222我使用大门封印技术封印了大门和护符石。";
		mes "虽然封印已经生效，但我仍担心它们将来可能破裂。";
		next;
		mes "^b22222某个团体觊觎护符石，随时都可能破坏封印，这让我无法安心。";
		mes "既然封印现在已经破裂，有很多人受伤吗？";
		next;
		mes "^b22222这座塔拥有强大的魔力和大量邪恶。";
		mes "它本身就很危险，但我因为某个人强烈的欲望而将其封印……";
		next;
		mes "^b22222我不建议你继续前进。";
		mes "你将不得不挑战那个可怜的存在，我就是以他的名字命名这座塔。";
		mes "他的灵魂仍在这里安息……";
		next;
		mes "^b22222没人相信我这个疯狂的科学家。";
		mes "虽然我想保守秘密，但必须有人知道真相。";
		mes "所以我制作了这个符文装置，并把讯息藏在里面。";
		next;
		mes "^b22222请证明我的经历并非幻觉。^000000";

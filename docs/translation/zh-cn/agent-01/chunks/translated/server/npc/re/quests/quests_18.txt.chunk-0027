		mes "你明白了吧？";
		close;
	}
	disable_items;
	mes "[Emmet]";
	mes "你好。";
	mes "你有没有 <ITEM>[紫水晶碎片]<INFO>1000405</INFO></ITEM>？";
	mes "我们正在收集水晶。";
	next;
	mes "[Emmet]";
	mes "我们用水晶交换精心制作的^4d4dff防具和附魔^000000。";
	mes "你想做什么？";
	next;
	switch( select( "交换防具", "灰狼附魔" ) ) {
	case 1:
		mes "[Emmet]";
		mes "你带来了许多紫水晶碎片，正如约定？";
		mes "慢慢来，四处看看。";
		close2;
		callshop "barter_ep18_1",1;
		end;
	case 2:
		mes "[Emmet]";
		mes "你有足够的装备和材料附魔吗？";
		mes "我是说紫水晶碎片。";
		mes "请选择要附魔的部位。";
		next;
		switch( select( "铠甲", "披风", "鞋子", "右(R)饰品", "左(L)饰品" ) ) {
		case 1:
			mes "[Emmet]";
			mes "你要附魔铠甲，我明白了。";
			close2;
			item_enchant(1);
			end;
		case 2:
			mes "[Emmet]";
			mes "你要附魔披风，我明白了。";
			close2;
			item_enchant(2);
			end;
		case 3:
			mes "[Emmet]";
			mes "你要附魔鞋子，我明白了。";
			close2;
			item_enchant(3);
			end;
		case 4:
			mes "[Emmet]";
			mes "你要附魔右侧饰品，我明白了。";
			close2;
			item_enchant(4);
			end;
		case 5:
			mes "[Emmet]";
			mes "你要附魔左侧饰品，我明白了。";
			close2;
			item_enchant(5);
			end;
		}
		end;
	}
	end;
}

// item exchange
wolfvill,170,131,3	script	Bamdat#bamdat	4_EP18_GW_OLD02,{
	if (ep18_main < 38) {
		mes "[Bamdatt]";
		mes "我曾是颇有名望的技师。";
		mes "现在很难找到工作……";
		mes "但如果有一天需要我的技能，我随时愿意帮忙。";
		close;
	}
	disable_items;
	mes "[Bamdatt]";
	mes "我听说神殿别墅发生了奇怪变化，对吧？";
	mes "堕落之神曾经过那里……";
	mes "从那里获得的战利品也一定充满虚假信仰。";
	next;
	mes "[Bamdatt]";
	mes "如果你愿意，我可以举行净化仪式，把它们变成充满真正信仰的武器。";
	mes "我的魔法技能也能派上用场。";
	next;
	mes "[Bamdatt]";
	mes "你可以选择基础净化仪式（大幅降低精炼等级），或高级净化仪式（保留大部分精炼等级）。";
	next;
	mes "可以把 +9 精炼的阿杜尔特·皮德武器系列改造成维布图斯·皮德系列。";
	mes "精炼等级下降幅度取决于所选净化仪式。";
	next;
	switch( select( "基础净化仪式", "高级净化仪式", "算了。" ) ) {
	case 1:
		mes "[Bamdatt]";
		mes "愿诸神的祝福与你同在。";
		close2;
		item_reform("Consecrate_Weapon_1");
		end;
	case 2:
		mes "[Bamdatt]";
		mes "愿诸神的祝福与你同在。";
		close2;
		item_reform("Consecrate_Weapon_2");
		end;
	case 3:
		mes "[Bamdatt]";
		mes "嗯？你的能力似乎足以与其他国家的研究员相媲美。";
		close;
	}
	end;
}

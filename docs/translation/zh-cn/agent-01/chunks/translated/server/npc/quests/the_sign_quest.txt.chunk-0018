		mes "挡我的路。";
		next;
		switch(select("好吧，我放你走。:不，你必须被阻止。")) {
		case 1:
			mes "[塞琳]";
			mes "你真的愿意为了我放弃这么多吗？";
			mes "你应该明白，这会让你无法通过诸神安排的考验……";
			next;
			switch(select("为了米德加尔特，我改变主意了。:我明白，而且没关系……")) {
			case 1:
				mes "[塞琳]";
				mes "……我真的不想和你战斗，但我已经走得太远，无法放弃。";
				mes "如果你坚持干涉，我别无选择……";
				next;
				donpcevent "Dark Lord#serin::OnEnable";
				mes "[黑暗领主]";
				mes "^330033无礼的凡人！";
				mes "你真的以为有机会阻止我吗？哼。";
				mes "每个蠢货都必须吸取教训。";
				mes "准备受死吧！^000000";
				set sign_q,134;
				donpcevent "Serin#serin::OnDisable";
				donpcevent "Dark Lord#serin::OnDisable";
				donpcevent "CallMonster#serin::Oncall";
				close;
			case 2:
				mes "[塞琳]";
				mes "我至少可以把你送回米德加尔特，";
				mes "并请求黑暗领主饶你一命。非常感谢你……";
				set sign_q,200;
				getexp (checkre(3))?20000:200000,0;
				set $@sign_w2,0;
				donpcevent "Dark Lord#serin::OnDisable";
				close2;
				warp "umbala",132,203;
				end;
			}

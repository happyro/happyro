que_sign01,197,195,4	script	Serin#witch	90,{
	callfunc "F_UpdateSignVars";
	if (sign_q < 124) {
		mes "[Serin]";
		mes "...";
		mes "......";
		emotion ET_THINK;
		close;
	}
	else if (sign_q == 124) {
		mes "[塞琳]";
		mes "你终于来了。那个女巫一直监视我的一举一动，";
		mes "所以她现在大概已经知道我在做什么了……";
		next;
		select("你为什么要这样做……");
		mes "[塞琳]";
		mes "你不明白被束缚在尼弗尔海姆的可怕经历。";
		mes "我厌倦了呼吸死亡、以绝望为食。";
		mes "我想再次活着！";
		next;
		select("所以你才想召唤黑暗领主……？");
		mes "[塞琳]";
		mes "很遗憾，地狱女士给你的符号只能使用一次。";
		mes "它的力量不足以让我复活，所以召唤黑暗领主是我最后的机会。";
		next;
		select("但如果黑暗领主来到米德加尔特……");
		mes "[塞琳]";
		mes "我很清楚黑暗领主进入生者世界会发生什么。";
		mes "他会摧毁米德加尔特，让成千上万的人死亡。";
		next;
		mes "[塞琳]";
		mes "所以如果我复活而其他人都死了，";
		mes "你可能认为召唤黑暗领主让我的复活毫无意义。";
		mes "但我不在乎。";
		next;
		mes "[塞琳]";
		mes "活着的人不懂得珍惜拥有的一切，所以他们应该受到惩罚。";
		mes "他们都可以去尼弗尔海姆，而我享受阳光的温暖和外界的新鲜空气。所有人都该死……";
		next;
		mes "[塞琳]";
		mes "也许你从未被束缚在尼弗尔海姆，所以不会同情我的处境。";
		mes "但我求你了，别挡我的路，"+strcharinfo(0)+"。";
		next;
		switch(select("我不能让你这样做！:好吧，随你便。")) {
		case 1:
			set sign_q,125;
			close;
		case 2:
			mes "[塞琳]";
			mes "你真的愿意为了我放弃这么多吗？";
			mes "你应该明白，这会让你无法通过诸神安排的考验……";
			next;
			switch(select("为了米德加尔特，我改变主意了。:我明白，而且没关系……")) {
			case 1:
				set sign_q,125;
				close;
			case 2:
				mes "[塞琳]";
				mes "我至少可以把你送回米德加尔特，";
				mes "并请求黑暗领主饶你一命。非常感谢你……";
				set sign_q,200;
				getexp (checkre(3))?20000:200000,0;
				set $@sign_w1,0;
				close2;
				warp "umbala",132,203;
				end;
			}
		}
	}
	else if (sign_q == 125) {
		if (countitem(2643) ==1) {
			mes "[塞琳]";
			mes "如果你以为没有符号我就无法召唤黑暗领主，那你错了。";
			mes "我一直在收集绝望的力量！";
			next;
			mes "[塞琳]";
			mes "你还记得那些你替我帮助的死者后来怎样了吗？";
			mes "即使他们一开始似乎找到了庇护，也无法逃离我深不见底的绝望……";
			next;
			mes "[塞琳]";
			mes "还有那个可怜的小女孩阿拉基娜·安妮？";
			mes "她至今还没意识到自己已经死了！";
			next;
			mes "[塞琳]";
			mes "你给了她希望，但最终无法兑现带她回家的承诺。";
			mes "哦，她一定失望透顶……";
			next;
			mes "[塞琳]";
			mes "没错……你试图帮助他们，却只给他们带来了痛苦，正如我计划的那样。";
			mes "现在我已经有足够的绝望来召唤黑暗领主！";
			next;
			mes "[塞琳]";
			mes "我不想和你战斗，但不能让你阻止我。";
			mes "我已经把灵魂卖给黑暗领主，只为再次成为活人，所以现在不能放弃！";
			mes "我们必须战斗！";
			close2;
			set sign_q,126;
			donpcevent "CallMonster#witch::Oncall";
			donpcevent "Serin#witch::OnDisable";
			end;
		}
		else {
			mes "[塞琳]";
			mes "如果你以为没有符号我就无法召唤黑暗领主，那你错了。";
			mes "我一直在收集绝望的力量！";
			next;
			mes "[塞琳]";
			mes "大多数冒险者不知道，尼弗尔海姆的许多灵魂注定要受苦。";
			mes "这是这个世界的本质，也是平衡规则之一……";
			next;
			mes "[塞琳]";
			mes "请一些冒险者帮助这些灵魂轻而易举。";
			mes "但当他们发现无法帮助这些灵魂时，一切已经太迟！冒险者的失败会加深他们的绝望！";
			next;
			mes "[塞琳]";
			mes "这里的绝望越多，就越能增强我用来召唤黑暗领主的力量！";
			next;
			mes "[塞琳]";
			mes "我不想和你战斗，但不能让你阻止我。";
			mes "我已经把灵魂卖给黑暗领主，只为再次成为活人，所以现在不能放弃！";
			mes "我们必须战斗！";
			close2;
			set sign_q,126;
			donpcevent "CallMonster#witch::Oncall";
			donpcevent "Serin#witch::OnDisable";
			end;
		}
	}
	else if (sign_q == 126) {
		mes "[塞琳]";
		mes "我明白了。很快我就会失去记忆，永远死在尼弗尔海姆。";
		mes "和其他人一样。不过，我能问你一个问题吗？";
		next;
		mes "[塞琳]";
		mes "凭那个符号，你可以命令死者做任何事。";
		mes "为什么不用它命令我放弃？";
		next;
		mes "[Serin]";
		mes "...";
		mes "......";
		mes "..........";
		next;
		mes "[塞琳]";
		mes "我明白了。你眼中的善意告诉了我一切。";
		mes "你想给我另一次机会，但最后我亲手毁掉了你给我的机会。";
		next;
		mes "[塞琳]";
		mes "即使我现在只是一缕灵魂，能遇见你也是我的荣幸。";
		mes "虽然我会失去记忆，但我会努力不忘记你。";
		next;
		mes "[塞琳]";
		mes "你勇敢而善良的记忆，对我来说比生命本身更珍贵。";
		next;
		mes "[塞琳]";
		mes "再见。朋友，祝你旅途顺利……";
		delitem 7308,1; //Witch's_Potion
		set sign_q,127;
		close;
	}
	else if (sign_q == 127) {
		mes "^3355FF你帮助昏迷的塞琳，回到了尼弗尔海姆。^000000";
		close2;
		set sign_q,128;
		set $@sign_w1,0;
		warp "que_sign01",117,137;
		end;
	}
	else if (sign_q == 198) {
		set .@fail_s1,rand(1,1000);
		set .@fail_s2,rand(1,900);
		set .@fail_s3,rand(1,800);
		set .@fail_s4,rand(1,700);
		set .@fail_s5,rand(1,600);
		if (countitem(2643) == 1) {
			if (((sign_sq == 0) && (.@fail_s3 == 356)) || ((sign_sq == 1) && (.@fail_s2 == 356)) || (.@fail_s1 == 356)) {
				delitem 7308,1; //Witch's_Potion
				set sign_q,200;
				mes "[塞琳]";
				mes "虽然你试图阻止我，但我仍不想夺走你的生命。";
				mes "我明白你只是想保护米德加尔特。";
				next;
				mes "[塞琳]";
				mes "但是……我不认为你有勇气通过诸神的考验。";
				mes "请不要再来这里了……";
				next;
				mes "^3355FF塞琳从你那里拿走了 1 瓶女巫药剂。^000000";
				next;
				mes "[塞琳]";
				mes "对不起……";
				mes "但我要用你的女巫药剂帮助我召唤黑暗领主。再见……";
				close2;
				set $@sign_w1,0;
				warp "niflheim",30,156;
				end;
			}

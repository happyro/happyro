				next;
				mes "[姆巴基的基科]";
				mes "可怜的家伙。";
				mes "不要活在谎言里。";
			close;
			}
				mes "[姆巴基的基科]";
				mes "巴里奥不适合锻造工作。";
				mes "所以我们总是请马来亚的锻造铺帮忙。";
				next;
				mes "[姆巴基的基科]";
			mes "巴库纳瓦不喜欢噪音。";
			mes "所以我们才敲打坚固的铸铁大锅。";
			next;
			mes "[姆巴基的基科]";
			mes "精神护符就是我拥有大锅的证明，务必好好交付。明白吗？很好。";
			close;
			}
			if (countitem(6504) < 5) {
			mes "[姆巴基的基科]";
			mes "哦，一定是我订的大锅。";
			mes "但是，它在哪里？你在耍我吗？！";
			close;
			}
			mes "[姆巴基的基科]";
			mes "好，太棒了！非常好。";
		mes "用这个可以进一步激怒巴库纳瓦。";
			next;
				mes "[姆巴基的基科]";
					mes "我用这个交换大锅。";
					mes "听说你在灵魂方面遇到麻烦？拿着它，会帮到你的。";
					delitem 6504, 5; // Cast_Iron_Caldron
					getitem 6503, 5; // Soul_Protection
				setquest 7377;
				erasequest 7376;
				close;
				case 2:
				if (checkquest(7406) == -1) {
				if (checkquest(7407) == -1) {
			mes "[姆巴基的基科]";
			mes "这个村子唯一需要净化的是万泰的食物。";
				mes "没有让你这样的外来者参与的仪式。";
				close;
				}
				mes "[姆巴基的基科]";
				mes "万泰一定饿了。";
				mes "去把它给他。快去。";
				close;
				}
			if ((countitem(523) < 10) || (countitem(6507) < 10)) {
			mes "[姆巴基的基科]";
			mes "要净化看门狗万泰要啃的骨头？";
			mes "我的工作真是越来越有趣了。";
			next;
			mes "[姆巴基的基科]";
			mes "去森林里取^4d4dff10 根邪灵骨^000000和^4d4dff10 瓶圣水^000000，作为净化仪式材料。";
			mes "仪式由我亲自进行。";
			close;
			}
			mes "[姆巴基的基科]";
			mes "这片森林动物的骨头里都有邪灵。";
			mes "恶灵四处作祟，这也是没办法的事……";
			next;
			mes "[姆巴基的基科]";
			mes "这样做，再这样做，在这里和那里……";
			mes "好了。邪灵已经离开，骨头纯净得可以直接啃了。";
			next;
			mes "[姆巴基的基科]";
			mes "现在把它带回给守卫董。";
			mes "万泰吃下这根净化的邪灵骨后会变强。";
			next;
		mes "[姆巴基的基科]";
			mes "而且带着邪灵骨只会伤害你，所以我会把它们全部拿来净化。";
			delitem 6507, countitem(6507); // Evil_Bone
			delitem 523, 10; //Holy_Water
			getitem 6505, 10; //Purified_Bone
	setquest 7407;
	erasequest 7406;
close;
case 3:
mes "[姆巴基的基科]";
	mes "休想！";
		mes "你敢！";
		close;
	}
	end;
	}
	
	ma_fild01,239,253,3	script	Dhong the Guard	570,{
	if (MaxWeight - Weight < 1000 || checkweight(1201,1) == 0) {
		mes "- 携带的物品太多，无法继续任务。-";
		close;
		}
		mes "[董]";
	mes "你好！欢迎来到巴里奥。";
	next;
		if (select("你的工作似乎很辛苦～:看门狗万泰") == 1) {
		mes "[董]";
		mes "一点也不。我只是看守进出这里的人。";
		mes "旅行者才是经历更多辛苦的人。";
		close;
		}
		if (BaseLevel < 100) {
		mes "[董]";
		mes "万泰是条好狗。";
		mes "他可能比你更强。";
		next;
		mes "[董]";
	mes "别介意，但你看起来比万泰啃的骨头原主人还弱。";
	next;
	mes "[董]";
		mes "也就是说，你和我差不多强！哈哈哈哈哈哈！";
		close;
		}
		.@playtime = checkquest(7408, PLAYTIME);
		if (.@playtime == 0 || .@playtime == 1) {
		mes "[董]";
		mes "你带来的骨头让万泰饱餐了一顿。";
		mes "他现在一段时间都会吃饱喝足。这里没人能在侦察方面胜过万泰。";
		next;
	mes "[董]";
		mes "虽然说人不如狗不太好听，但确实有人不如狗。";
		close;
		} else if (.@playtime == 2) {
		erasequest 7408;
		mes "[董]";
		mes "万泰？还是老样子。";
		mes "你这么一说，差不多又到他饿的时候了。";
		next;
		mes "[董]";
		mes "当然，他也吃普通狗粮，但不能没有那些骨头。";
		mes "你明白我的意思吧？";
		mes "*坏笑*……";
		next;
		mes "[董]";
		mes "我和万泰一直等着英雄从森林带来邪灵骨。";
	close;
		} else {
			if (checkquest(7406) != -1) {
			mes "[董]";
			mes "我的意思是，要成为好看门狗，他必须能抵御邪灵。";
			mes "因此他需要吃邪灵骨，但必须先净化才能食用。";
			next;
			mes "[董]";
			mes "你可以从森林里的魔物或动物身上获得邪灵骨。";
			mes "姆巴基的基科会帮你净化。";
		close;
			} else {
				if (checkquest(7407) == 1) {
					if (countitem(6505) < 10) {
					mes "[董]";
					mes "姆巴基的基科要 10 根净化灵骨。";
					mes "他一次至少需要 10 根，当然一天都撑不过去……";
				close;
				}
				mes "[董]";
				mes "嘿，万泰会喜欢这些的！";
				mes "状态都很好……";
				mes "经过神圣仪式净化的邪灵骨……";
				next;
				mes "[董]";
				mes "这就是完美的狗粮！！";
				mes "现在他能感知并探测邪灵，";
				mes "吃下净化骨头后还能获得消灭邪灵的能力。";
				next;
				mes "[董]";
				mes "我敢说他现在是村里最强的生物。";
				mes "当然不是我，我是说万泰。";
				next;
				mes "[董]";
				mes "这是你的奖励。";
				mes "如果你明天还能再帮我们，就太好了。";
				delitem 6505, 10; // Purified_Bone
				setquest 7408;
				erasequest 7407;
					if (!VIP_SCRIPT || vip_status(VIP_STATUS_ACTIVE))
				getitem 6497, 2; // Lesser_Agimat
					else
				getitem 6497, 1; // Lesser_Agimat
				getexp 200000,200000;
					if (!rand(0, 2))
				$malayaNames$[2] = strcharinfo(0);
			close;
				} else {
				mes "[董]";
				mes "万泰不只是看门狗，也是很棒的探测和侦察员。";
				mes "但要做到这些，他需要吃净化灵骨。";
				next;
				mes "[董]";
				mes "如你所见，我无法离开这里，";
				mes "所以想请你为万泰收集骨头……";
				next;
					if (select("好的。:抱歉。") == 2) {
					mes "[董]";
					mes "我明白了。";
					mes "万泰！今天没有零食了……！！";
					next;
					mes "- 看来今天万泰的眼睛更湿润了。-";
					close;
				}
				mes "[董]";
				mes "可以从附近的动物或魔物身上取得骨头。";
				mes "带去给姆巴基的基科净化，然后交给万泰吃。";
				next;
				mes "[董]";
				mes "带 10 根净化灵骨给我们。";
				mes "对了，净化仪式还需要圣水。";
				next;
				mes "[董]";
				mes "慢慢来。";
				mes "看这里，万泰也喜欢。";
				setquest 7406;
				close;
			}
		}
	}
	end;
}


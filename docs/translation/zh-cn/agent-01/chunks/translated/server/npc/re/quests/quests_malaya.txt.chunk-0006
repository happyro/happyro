					mes "我是这里的灵魂引导者，保护着巴里奥的居民和灵魂。";
				mes "我是巴里奥的好领袖，姆巴基的基科。";
				next;
				switch (select("交付铸铁大锅。:请求净化仪式。:用杰勒比换金钱。")) {
				case 1:
				if (checkquest(7376) == -1) {
				if (checkquest(7377) == -1) {
				mes "[姆巴基的基科]";

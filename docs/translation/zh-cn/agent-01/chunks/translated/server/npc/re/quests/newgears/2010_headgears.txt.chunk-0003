			mes "好了，这是成为真正单人游戏专家的";
			mes "最后训练！";
			next;
			mes "[阿洛妮]";
			mes "在天津地下城进行单人游戏的特别训练！";
			mes "为了让训练";
			mes "更加充实，";
			mes "到处走走并消灭";
			mes "^FF000020 20 个纸妖和 40 个火枪手^000000！";
			next;
			switch(select("胡说八道！:出发吧！")) {
			case 1:
				mes "[阿洛妮]";
				mes "当然，我才不在乎。";
				mes "呼呼，呀呀！";
				close;
			case 2:
				mes "[阿洛妮]";
				mes "快点，我的学生！";
				mes "我很任性，";
				mes "所以不知道会";
				mes "给你什么奖励！";
				changequest 1104,1106;
				changequest 1105,1107;
				set hat_1_2009,4;
				close;
			}
		} else {
			mes "[阿洛妮]";
			mes "嗯，还不够。";
			mes "单人游戏没那么容易！";
			mes "去消灭";
			mes "^FF000020 20 个绿女妖和 50 个猫妖^000000！";
			if (checkquest(1104,HUNTING) == 1) {
				erasequest 1104;
				setquest 1108;
			}
			close;
		}
	} else if (hat_1_2009 == 4) {
		if (MaxWeight - Weight < 300) {
			mes "[阿洛妮]";
			mes "带着这么重的包还在外面玩？";
			mes "你真是";
			mes "单人游戏专家！";
			next;
			mes "[阿洛妮]";
			mes "想要奖励的话，先清空你的背包！";
			close;
		}
		if (checkquest(1106,HUNTING) == 2 && checkquest(1107,HUNTING) == 2) {
			mes "[阿洛妮]";
			mes "你终于做到了。";
			mes "我那缺少关爱的学生！";
			mes "你的训练到此结束！";
			next;
			if (gettime(DT_HOUR) < 12) {
				set .@item,5448; //Solo_Play_Box1
				set .@time$,"AM";
			} else {
				set .@item,5449; //Solo_Play_Box2
				set .@time$,"PM";
			}
			if (checkweight(.@item,1) == 0) {
				mes "[阿洛妮]";
				mes "带着这么重的包还在外面玩？";
				mes "你真是";
				mes "单人游戏专家！";
				next;
				mes "[阿洛妮]";
				mes "想要奖励的话，先清空你的背包！";
				close;
			}
			mes "[阿洛妮]";
			mes "给你！这是";
			mes .@time$ + "最有效的单人游戏箱！";
			mes "戴上这个箱子后，";
			mes "你就是最棒的独行者！";
			next;
			mes "[阿洛妮]";
			emotion ET_BEST;
			mes "把眼泪忍回去！";
			mes "呼呼，呀呀！";
			completequest 1106;
			completequest 1107;
			set hat_1_2009,5;
			getitem .@item,1;
			close;
		} else {
			mes "[阿洛妮]";
			mes "嗯嗯，还不够。";
			mes "单人游戏没那么容易！";
			mes "去消灭";
			mes "^FF000020 20 个纸妖和 40 个火枪手^000000！";
			close;
		}
	} else if (hat_1_2009 == 5) {
		mes "[阿洛妮]";
		mes "我是单人游戏专家。";
		mes "总是努力享受独处！";
		next;
		mes "[阿洛妮]";
		mes "呼呼，呀呀！";
		close;
	}
	end;
}

		mes "……进入";
		mes "等候室。";
		next;
		mes "[温莎爵士]";
		mes "……然后测试";
		mes "将开始。";
		next;
		mes "[温莎爵士]";
		mes "……";
		next;
		mes "[温莎爵士]";
		mes "……你必须等待";
		mes "如果有人正在测试。";
		next;
		mes "[温莎爵士]";
		mes "……你可以进入";
		mes "等那个人结束后。";
		next;
		mes "[温莎爵士]";
	mes "……";
		close;
		case 3:
		close2;
	warp "prt_in",80,100;
end;
}
}
	

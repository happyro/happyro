			next;
			mes "[艾米女士]";
			mes "作为骑士没有遇到麻烦吧？我看你做得很好~";
			next;
			mes "[艾米女士]";
			mes "当然~你是普隆德拉骑士团的一员~";
			close;
			}
			else if (BaseClass == Job_Novice) {
			mes "哎呀~多么可爱的小新手！太可爱了！";
			next;
			mes "[艾米女士]";
		mes "嘿嘿……以后有兴趣成为骑士吗？你会成为优秀的骑士~";
		next;
			mes "[艾米女士]";
			mes "记住，你要成为骑士，好吗？答应我？";
			close;
			}
			else {
			mes "欢迎来到普隆德拉骑士团~";
			next;
			mes "[艾米女士]";
			mes "我们这里只有骑士，但希望你在这里过得愉快。嘿嘿~";
			close;
			}
			}

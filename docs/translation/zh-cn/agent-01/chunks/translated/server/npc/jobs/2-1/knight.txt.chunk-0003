		mes "[西拉克斯爵士]";
		mes "那么，";
		mes "这就是";
		mes "我的测试终点。";
		next;
		mes "[西拉克斯爵士]";
		mes "下一项测试请";
		mes "去找";
		mes "温莎爵士。";
		mes "他很安静，";
		mes "但别让这";
		mes "影响你。";
		close;
	}
	
		else if (KNIGHT_Q == 6) {
		mes "哦？";
		mes "你有什么";
		mes "想";
		mes "问我吗？";
		next;
			if (select("我想参加转职测试。:哦，没什么。") == 1) {
			mes "[西拉克斯爵士]";
			mes "嘿……";
			mes "你已经参加过我的测试了，对吧？这里结束了。现在去找温莎爵士吧……";
		close;
		}
		mes "[西拉克斯爵士]";
		mes "嗯……？";
		mes "好吧。";
		mes "只是因为";
		mes "你脸上有那种";
		mes "表情。";
		mes "";
	close;
	}
		else if (KNIGHT_Q == 14) {
		mes "嗯……？";
		mes "你完成了";
		mes "其他人的";
		mes "测试吗？";
		next;
		mes "[西拉克斯爵士]";
		mes "那么，";
		mes "去见";
		mes "队长。我们会一起";
		mes "在那里评估";
		mes "你的表现。";
	close;
	}
		else {
		mes "又见面了。";
		mes "你需要什么吗？";
		mes "抱歉，我现在很忙。去完成剩余测试吧。";
	close;
}
}

	
	prt_in,79,94,4	script	Sir Windsor#knt	733,{
	mes "[温莎爵士]";
	mes "……";
	next;
	mes "[温莎爵士]";
	mes "……";
	mes "…………";
	next;
		mes "[温莎爵士]";
		if (BaseJob != Job_Swordman) {
			if (BaseJob == Job_Knight) mes "保护。";
			else if (BaseClass == Job_Novice) {
		mes "……去外面";
		mes "玩。";
		}
	else mes "……哼。";
	close;
		}
		if (KNIGHT_Q == 0) {
	mes "……什么？";
	close;
		}
		else if (KNIGHT_Q >= 1 && KNIGHT_Q <= 5) {
		mes "……什么？";
			next;
			if (select("我想参加转职测试。:哦，没什么。") == 1) {
			mes "[温莎爵士]";
			mes "……";
			next;
			mes "[温莎爵士]";
			mes "……";
			mes "…………";
			next;
			mes "[温莎爵士]";
		mes "……还没轮到我。";
		close;
		}
		mes "[温莎爵士]";
	mes "……";
	close;
		}
			else if (KNIGHT_Q == 6 || KNIGHT_Q == 7) {
			if (KNIGHT_Q == 6) {
			set .@mes$,"Sir Siracuse sent me to you.:Oh, nothing.";
		mes "……什么？";
		next;
			}
			else {
		set .@mes$,"I want to try again!:……";
		next;
			}
			if (select(.@mes$) == 1) {
			mes "[温莎爵士]";
			mes "……";
			next;
				set KNIGHT_Q,7;
			if (checkquest(9004) != -1) {
			changequest 9004,9005;
			}
			mes "[温莎爵士]";
			mes "……";
			mes "…………";
			next;
				mes "[温莎爵士]";
			if (KNIGHT_Q == 6) 
				mes "……跟我来。";
				else {
				mes "……好吧。";
				next;
			mes "[温莎爵士]";
			mes "……这边。";
			}
			close2;
			if(checkquest(9006) == -1) changequest 9005,9006;
		warp "job_knt",89,101;
		end;
		}
		mes "[温莎爵士]";
	mes "……";
	close;
		}
		else if (KNIGHT_Q == 14) {
		mes "……去和";
	mes "队长交谈。";
	close;
		}
		else {
		mes "……你已经";
	mes "完成了。";
close;
}
}


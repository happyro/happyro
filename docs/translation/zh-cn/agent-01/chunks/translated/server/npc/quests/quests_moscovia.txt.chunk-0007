					mes "我该问她什么？";
					next;
					input .@AnnaInfo$;
					mes "["+strcharinfo(0)+"]";
					mes "安娜，";
					mes ""+.@AnnaInfo$+"?";
					mes "你知道这是什么吗？";
					next;
					if (.@AnnaInfo$ == "Gravity") {
						mes "[安娜]";
						mes "我知道他们有一款叫《RAGNAROK Online 2》的游戏……他们喜欢……我在说什么……对吧？";
					} else if (.@AnnaInfo$ == "Gallina") {
						mes "[安娜]";
						mes "妈妈做的薄烤饼太好吃了！啊，是甜甜的味道！";
						mes "村里每个人都喜欢妈妈做的薄烤饼。嘿嘿。";
					} else if (.@AnnaInfo$ == "Mikhail") {
						mes "[安娜]";
						mes "米海尔是个胆小的笨蛋！";
					} else {
						mes "[安娜]";
						mes "我不知道那是什么。";
					}
					break;
				case 5:
					mes "[安娜]";
					mes "嗯～～～～";
					next;
					mes "- 安娜对我皱起眉头，吐了吐舌头。";
					mes "她不想和我说话。-";
					close;
			}
			next;
		}
	} else if (mos_swan == 3) {
		mes "["+strcharinfo(0)+"]";
		mes "好，我从安娜那里得到了一条线索，现在必须去^3131FF‘黏草树’旅馆^000000。";
		close;
	} else if (mos_swan < 12) {
		mes "[安娜]";
		mes "米海尔又笨、又胆小、又懦弱！";
		close;
	} else if (mos_swan == 25) {
		mes "[安娜]";
		mes "米……海……尔";
		mes "他向妈妈告了我的状……";
		next;
		mes "[加莉娜]";
		mes "安娜！";
		next;
		mes "[安娜]";
		mes "……对不起。";
		close;
	} else if (mos_swan == 100) {
		mes "[安娜]";
		mes "米……海……尔";
		mes "他向妈妈告了我的状……";
		next;
		mes "[加莉娜]";
		mes "安娜！";
		next;
		emotion ET_CRY;
		mes "[安娜]";
		mes "……对不起。";
		close;
	}
	mes "[安娜]";
	mes "……我好无聊。";
	close;
}


// Fire pot + Mikhail
//----------------------------------------------------------------------------
mosk_in,205,268,3	script	Fire pot#mos	HIDDEN_NPC,{
	if (!mos_swan) {
		mes "- 这是用来给房间取暖或烘烤东西的火盆。-";
		close;
	} else if (mos_swan == 1) {
		mes "- 这是加莉娜烤薄烤饼时使用的火盆。";
		mes "看起来已经很久没有使用了。";
		mes "我想应该去问问他的家人，他可能跑到哪里玩去了。-";
		mos_swan = 2;
		close;
	} else if (mos_swan < 11) {
		mes "- 这是加莉娜烤薄烤饼时使用的火盆。";
		mes "看起来很久以前曾经用过。-";
		close;
	} else if (mos_swan == 11) {
		mes "- 这是加莉娜烤薄烤饼时使用的火盆。";
		mes "看起来很久以前曾经用过。-";
		next;
		if(select("检查其他东西:仔细看看") == 1) {
			mes "- 你决定检查其他东西。-";
			close;
		}
		mes "- 你走近火盆，仔细查看。-";
		next;
		mes " .............. ";
		mes " .............. ";
		mes " .............. ";
		mes " .............. ";
		next;
		mes " .............. ";
		mes " .............. ";
		mes " .............. ";
		mes " .............. ";
		mes " .............. ";
		next;
		mes "- 你仔细查看后，发现火盆周围的地上有几片面包！-";
		next;
		switch(select("米海尔在火盆里。:米海尔在火盆附近。:面包片和米海尔之间没有关系。")) {
			case 1:
				mes "["+strcharinfo(0)+"]";
				mes "我终于找到他了。";
				next;
				mes "- 你把手臂伸进火盆的洞里。-";
				next;
				mes "- 有什么东西发出窸窸窣窣的声音。-";
				next;
				mes "- 你压低声音呼唤米海尔。-";
				next;
				mes "["+strcharinfo(0)+"]";
				mes "米-海-尔。";
				next;
				mes "- .......................... -";
				next;
				mes "["+strcharinfo(0)+"]";
				mes "米海尔。";
				mes "我知道你在那里，请出来吧。";
				next;
				mes "- .......................... -";
				next;
				mes "["+strcharinfo(0)+"]";
				mes "你的妈妈和姐姐都很担心你。";
				next;
				mes "[？？？]";
				mes "……喂。";
				next;
				mes "["+strcharinfo(0)+"]";
				mes "?????";
				next;
				mes "[米海尔]";
				mes "……不，我不能……";
				mes "我……会被惩罚……";
				next;
				mes "["+strcharinfo(0)+"]";
				mes "不，你不会被惩罚，米海尔。";
				mes "你的妈妈非常担心你。";
				mes "你的姐姐也是。";
				next;
				mes "["+strcharinfo(0)+"]";
				mes "你是不小心弄坏了妈妈的套娃，对吧？";
				mes "我会把你的失误告诉她。请出来吧。";
				next;
				mes "[米海尔]";
				mes "哦……妈……套娃……";
				mes "不是我弄坏的……不……不只是我！";
				next;
				mes "["+strcharinfo(0)+"]";
				mes "然后呢？";
				next;
				mes "[米海尔]";
				mes "安娜推了我，还撞到了我……";
				mes "但她告诉妈妈是我一个人弄坏的……";
				next;
				mes "["+strcharinfo(0)+"]";
				mes "天啊！明明是你和安娜一起做的，她却把责任全推给你？";
				next;
				mes "[米海尔]";
				mes "是的……";
				next;
				mes "["+strcharinfo(0)+"]";
				mes "你应该出来告诉妈妈真相！走吧，米海尔。";
				next;
				mes "[米海尔]";
				mes "不！不行，我不能！！";
				next;
				mes "- 一只白皙的小手从火盆里伸出来，抓住了你的脚踝。-";
				next;
				mes "[米海尔]";
				mes "不……我怕妈妈会惩罚我……";
				mes "因为奶奶的套娃坏掉了……";
				next;
				mes "["+strcharinfo(0)+"]";
				mes "哎呀。小男孩，别哭了。";
				mes "没关系。我去拿黏合剂把所有碎片粘起来。然后你可以把它带回妈妈那里，向她道歉。";
				next;
				mes "[米海尔]";
				mes "你能……拿到……黏合剂吗？";
				next;
				mes "["+strcharinfo(0)+"]";
				mes "你不相信我吗？";
				mes "好，待在这里。我马上带着黏合剂回来。";
				next;
				mes "- 我得弄清楚制作黏合剂需要什么。";
				mes "我去问问那个^3131FF维克多先生^000000。-";
				mos_swan = 12;
				changequest 18064,18065;
				close;
			case 2:
			mes "- 我想他就在火盆附近。我该去哪里找他？-";
				close;
			case 3:
			mes "- 我想面包片和米海尔没有关系。-";
				close;
		}
	} else if (mos_swan == 12) {
		mes "- 好，第一步是问维克多先生制作黏合剂需要什么。-";
		close;
	} else if (mos_swan == 24) {
		mes "["+strcharinfo(0)+"]";
		mes "嘿，米海尔。我拿到黏合剂了！";
		next;
			mes "[米海尔]";
		mes "……真的吗？你是认真的吗？";
		next;
		donpcevent "Mikhail#mos::OnEnable";
		mes "- 你把从维克多那里拿到的黏合剂交给米海尔。-";
		next;
			mes "[米海尔]";
		mes "哇！太好了！";
		next;
		mes "- 他开始修复破损的套娃，仿佛在拼拼图。-";
		next;
			mes "[米海尔]";
		mes "我做到了！！！！！";
		mes "太感谢你了！！！";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "不客气，哈哈。";
		mes "不过，你能答应我一件事吗？";
		next;
			mes "[米海尔]";
		mes "什么？";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "把套娃带回妈妈那里，并答应我将来要成为勇敢的将军。";
		next;
			mes "[米海尔]";
		mes ".............";
		next;
			mes "[米海尔]";
		mes "好，我答应你！";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "呼呼，你真是个好孩子。";
		next;
			mes "[米海尔]";
		mes "现在我要把这个还给妈妈。";
		donpcevent "Mikhail#mos::OnInit";
		mos_swan = 25;
		delitem 7764,1;// High_Strength_Adhesive
		changequest 18068,18069;
		close;
	}
	mes "- 这是用来给房间取暖或烘烤东西的火盆。-";
	close;
}

mosk_in,202,269,5	script	Mikhail#mos	4_M_RUSCHILD,{
	end;
OnInit:
OnEnable:
	hideonnpc "Mikhail#mos";

}

//----------------------------------------------------------------------------
// Sticky Herb Tree Inn NPCs
//----------------------------------------------------------------------------
mosk_in,135,191,5	script	Landlord#mos	4_F_RUSWOMAN3,{
	mes "[Landlord]";
		mes "哦，欢迎来到‘黏草树’旅馆。";
		mes "这是整个莫斯科比亚最舒适、最安静的地方。";
	next;
	if (mos_swan == 4 || mos_swan == 5) {
		mes "[Landlord]";
		mes "你已经起床了吗？";
		mes "你还年轻，应该已经恢复全部体力了。";
		mes "呵呵呵。";
		next;
		while(1) {
			switch(select("Ask her about the inn:Ask her about Mikhail.:End the conversation")) {
			case 1:
				mes "[Landlord]";
				mes "我们旅馆的名字来自村外的一棵大苹果树。";
				mes "希望旅馆能像密林中那棵与众不同的苹果树一样，成为莫斯科比亚最有名的地方。";
				next;
				break;
			case 2:
				mes "[Landlord]";
				mes "米海尔？";
				mes "啊！你说的是那个可爱的男孩，伊万诺夫先生的儿子？";
				mes "我见过他。他几小时前还在这里。";
				next;
				mes "[Landlord]";
				mes "他脸色苍白，向我要高强度黏合剂。可能弄坏了什么重要的东西。";
				next;
				mes "[Landlord]";
				mes "他紧张得不得了，让我很心疼。他真是个可爱的孩子，我都想收他做儿子了。";
				mes "呵呵呵。";
				next;
				mes "["+strcharinfo(0)+"]";
				mes "那后来怎么样？";
				mes "米海尔拿到黏合剂了吗？";
				next;
				mes "[Landlord]";
				mes "呵呵，我也不太清楚。也许我丈夫知道……";
				mes "他外表不怎么样，但很擅长修理和制作东西！呵呵。";
				next;
				mes "[Landlord]";
				mes "不过他离开莫斯科比亚已经很久了，所以我现在没法问他怎么制作黏合剂……";
				next;
				mes "["+strcharinfo(0)+"]";
				mes "……然后呢？";
				next;
				mes "[Landlord]";
				mes "我让他去那边的酒馆。";
				mes "还告诉他不要喝那些人递给他的东西！";
				mes "因为他是个可爱的孩子！";
				next;
				mes "["+strcharinfo(0)+"]";
				mes "那么，他去那里了吗？";
				next;
				mes "[Landlord]";
				mes "他去了。";
				mes "他是个好孩子，肯定会去的。";
				mes "他真的很温柔。";
				next;
				mes "["+strcharinfo(0)+"]";
				mes "好。谢谢你的回答！";
				next;
				mes "[Landlord]";
				mes "不好意思让你留在这里，不过这样不是更轻松吗？呵呵。";
				mes "天黑后答应我再来这里。呵呵。";
				mos_swan = 7;
				changequest 18061,18062;
				close;
			case 3:
				mes "[Landlord]";
		mes "需要休息时，你会去哪里？";
				next;
				mes "[Landlord]";
		mes "你应该回到‘黏草树’旅馆。好吗？";
		mes "下次我会提供更好的服务。";
				close;
			}
		}
	}
	switch(select("Save", "Stay the night - 5000z", ( mos_swan == 3 ? "Ask her about Mikhail." : "" ))) {
	case 1:
		mes "[Landlord]";
		mes "你的重生点已保存。";
		mes "希望下次还能见到你，呵呵。";
		savepoint "mosk_in",142,189,1,1;
		close;
	case 2:
		if (Zeny > 4999) {
			mes "[Landlord]";
			if (mos_swan == 3) {
				mes "好，我带你去最好的房间。";
				mes "请好好休息，年轻的冒险者。";
			}
			else {
		mes "请住得舒适。";
			}
			break;
		}
		mes "[Landlord]";
		mes "服务费是 5000 Zeny。";
		mes "请确认你有足够的钱支付服务费。";
		close;
	case 3:
		mes "[Landlord]";
		emotion ET_THROB;
		mes "哦～！你看起来真棒！看看这"+((Sex == SEX_MALE)?"结实的肌肉":"白皙的皮肤")+"！";
		mes "不过你看起来很累。是因为长途旅行吗？";
		next;
		mes "[Landlord]";
		mes "我们有一间专门为你准备的房间。"+((Sex == SEX_MALE)?"这是镇上最好的房间。要不要住一晚？":"房间就像公主的闺房一样。");
		mes (Sex == SEX_MALE)?"帅哥，我会收你合理的价格。":"要不要住一晚？漂亮的女士，我可以给你打折。";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "哦，抱歉，我不是来住宿的。";
		mes "我在找一个孩子，有些事想问你……";
		next;
		emotion ET_HUK;
		mes "[Landlord]";
		mes "什么！？！？";
		next;
		mes "[Landlord]";
		mes "喂～你听说过‘有来有往’吗？";
		mes "没有吧？";
		mes "如果你是我的客人，我可以给你想要的东西，但你不是！";
		next;
		mes "[Landlord]";
		mes "如果你答应住一晚，我就告诉你想知道的事。成交吗？";
		next;
		if(select("Refuse.:Stay overnight and get the info. - 5000z") == 1) {
			emotion ET_ANGER;
			mes "[Landlord]";
			mes "那你自己去找消息吧。";
			close;
		}
		if (Zeny < 5000) {
			mes "[Landlord]";
			mes "不行。你的钱不够。";
			mes "走开！我没法给你房间。";
			close;
		}
		mes "[Landlord]";
		mes "哦，天啊！你和看起来一样厉害～";
		mes "好，我马上带你去房间！！";
		next;
		mes "[Landlord]";
		mes "来吧，请带着行李跟我走。";
		mes "哦，让我来拿吧。呵呵呵，你一定累坏了。";
		mes "祝你今晚休息愉快。呵呵呵。";
		mos_swan = 4;
		break;
	}
	close2;
	Zeny = Zeny -5000;
	percentheal 100,100;
	warp "mosk_in",215,181;
	end;
}

mosk_in,141,212,3	script	Pub Owner#mos	4_M_RUSBALD,{
	if ((MaxWeight-Weight) < 2000) {
		mes "- 请停在这里！！-";
		mes "- 你携带的物品太多了。-";
		mes "- 请使用卡普拉服务后-";
		mes "- 再试一次。-";
		close;
	}
	if (mos_swan == 7) {
		mes "[Pub Owner]";
		mes "这里又来了一位旅行者。";
		mes "欢迎来到我们的酒馆。";
		mes "我是^3131FF‘溪流酒馆’^000000的亚历山大。你可以叫我‘萨沙’。";
		next;
		if(select("Ask him about Mikhail.:Order a drink.") == 1) {
			mes "["+strcharinfo(0)+"]";
			mes "萨沙，有个叫‘米海尔’的小男孩来过这里吗？";
			next;
			mes "[Pub Owner]";
			mes "你说的是那个可爱的小男孩吗？他来过这里。";
			mes "他脸色苍白，需要高强度黏合剂。";
			next;
			mes "["+strcharinfo(0)+"]";
			mes "那么你对他说了什么？";
			next;
			mes "[Pub Owner]";
			mes "我不太了解那件事。";
			mes "不过我认识一个可能知道的人，所以把他介绍给了米海尔。";
			next;
			mes "["+strcharinfo(0)+"]";
			mes "那个人是谁？";
			next;
			mes "[Pub Owner]";
			mes "就是那边的维克多。";
			mes "他非常注重细节，所以我们叫他^3131FF‘刺猬维克多’^000000。";
			mes "除了他，没人真正了解这件事。";
			next;
			mes "["+strcharinfo(0)+"]";
			mes "萨沙，非常感谢你！";
			next;
			mes "[Pub Owner]";
			mes "不客气。";
			mos_swan = 8;

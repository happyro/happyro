mosk_in,136,279,3	script	Bed#mos1	HIDDEN_NPC,{
	mes "- 床单和枕头看起来又整洁又柔软，我一躺上去可能马上就会睡着。-";
	if (mos_swan != 11) close;
	next;
	if(select("检查其他东西:仔细看看") == 1) {
		mes "- 你决定之后再检查这张床。-";
		close;
	}
	mes "- 你走近床铺，仔细查看。-";
	next;
	mes " .............. ";
	mes " .............. ";
	mes " .............. ";
	mes " .............. ";
	next;
	mes " .............. ";
	mes " .............. ";
	mes " .............. ";
	mes " .............. ";
	mes " .............. ";
	next;
	mes "- 你什么也没找到。-";
	close;
}

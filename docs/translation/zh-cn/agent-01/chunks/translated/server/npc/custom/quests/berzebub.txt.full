//===== rAthena Script =======================================
//= Berzebub Card Quest
//===== By: ==================================================
//= jabs
//===== Current Version: =====================================
//= 1.1
//===== Compatible With: =====================================
//= rAthena Project
//===== Description: =========================================
//= Quest to get the Berzebub Card
//===== Additional Comments: =================================
//= 1.1 Fixed ingredients. Was too exploitable [Lupus]
//= 1.2 Optimized. [Euphy]
//============================================================

prontera,165,178,8	script	Old Woman	103,{

	setarray .@Items[0],714,25,1061,100,1095,200,618,10,1551,2,1614,1,727,20;
	set .@n$,"[Old Woman]";

	mes .@n$;
	if(BerzQuest == 1) {
		mes "嘿，我记得你！我已经说过这个任务只能完成一次。";
		close; }
	mes "你好，小伙子。我在古城附近采蘑菇时发现了一件很棒的物品。";
	next;
	if(select("继续说:离开")==2) goto M_Leave;

	mes .@n$;
	mes "我从未见过这样的物品。据说它可以插入任何有卡槽的饰品。";
	next;
	mes .@n$;
	mes "如果你对它感兴趣，我会告诉你制作所需的材料。每位玩家只能得到一个，所以完成任务后不能再做。";
	next;
	if(select("详细说说:算了，我不在乎")==2) goto M_Leave;

	mes .@n$;
	mes "我认为这件物品叫 ^FF0000贝尔泽布卡片^000000。它能让你快速施放魔法！";
	next;
	mes .@n$;
	mes "我需要以下所有物品：";
	for(set .@i,0; .@i<getarraysize(.@Items); set .@i,.@i+2) {
		mes " ~ "+.@Items[.@i+1]+"x "+getitemname(.@Items[.@i]);
		if (countitem(.@Items[.@i]) < .@Items[.@i+1]) set .@nr,1; }
	next;
	if(select("我都有了！:我马上去收集")==2) goto M_Leave;

	mes .@n$;
	if (.@nr) {
		mes "你撒谎！快滚去收集那些物品，你这个可怜的摇滚明星。";
		close; }
	for(set .@i,0; .@i<getarraysize(.@Items); set .@i,.@i+2)
		delitem .@Items[.@i], .@Items[.@i+1];
	getitem 4145,1;
	set BerzQuest, 1;
	mes "恭喜！你集齐了所有物品。这是承诺给你的 ^FF0000贝尔泽布卡片^000000。";
	emotion ET_CONGRATULATION;
	close;

M_Leave:
	mes .@n$;
	mes "我手里有这么棒的物品……";
	close;
}

schg_que01,100,75,5	script	Gergath#sch_gd	412,{
	end;

OnInit:
	disablenpc "Gergath#sch_gd";
	end;

OnEnable:
	enablenpc "Gergath#sch_gd";
	specialeffect EF_FORESTLIGHT;
	initnpctimer;
	end;

OnTimer5000:
	mapannounce "schg_que01", "格尔加斯：我亲爱的朋友，你过得怎么样？这是我为你准备的东西。",bc_map,"0xFFFF00";
	end;

OnTimer10000:
	mapannounce "schg_que01", "格尔加斯：你还记得我们年轻时吗？我们每天都像死敌一样争斗。",bc_map,"0xFFFF00";
	end;

OnTimer15000:
	mapannounce "schg_que01", "格尔加斯：无论大人们怎么努力，我们都不打算改变。哈哈。",bc_map,"0xFFFF00";
	end;

OnTimer20000:
	mapannounce "schg_que01", "格尔加斯：但我相信，在内心深处，我们都珍视彼此的友谊。",bc_map,"0xFFFF00";
	end;

OnTimer25000:
	mapannounce "schg_que01", "格尔加斯：我在雷神山失去母亲的遗物后，是你来找我。",bc_map,"0xFFFF00";
	end;

OnTimer30000:
	mapannounce "schg_que01", "格尔加斯：你把母亲的遗物交给我时，我甚至没能说声谢谢。",bc_map,"0xFFFF00";
	end;

OnTimer35000:
	mapannounce "schg_que01", "格尔加斯：即使我已经年老，也始终没能说出口。",bc_map,"0xFFFF00";
	end;

OnTimer40000:
	mapannounce "schg_que01", "格尔加斯：不久前我得知了你的下落。听说你在照顾孤儿？",bc_map,"0xFFFF00";
	end;

OnTimer45000:
	mapannounce "schg_que01", "格尔加斯：请收下这份来自无用朋友的礼物，送给你和你心爱的孩子们。希望你喜欢，哈哈。",bc_map,"0xFFFF00";
	end;

OnTimer50000:
	mapannounce "schg_que01", "格尔加斯：皮埃罗·皮埃尔会帮助你。希望你能借此机会回到过去，和孩子们好好享受时光。",bc_map,"0xFFFF00";
	disablenpc "Gergath#sch_gd";
	stopnpctimer;
	end;
}


prontera,154,136,5	script	Suspicious Coffin#2013HE	801,{
	if (eve_bs < 1) {
		mes "- 这口棺材看起来很可疑。-";
		next;
		switch(select("离开:敲敲。")) {
		case 1:
			mes "- 你带着疑惑离开了。-";
			close;
		case 2:
			mes "- 笃笃笃 -";
			next;
			mes "[???]";
			mes "啊啊啊！！！";
			mes "你……你是谁！！！";
			next;
			mes "- 咔嚓 -";
			mes "- 咚 -";
			next;
			mes "[???]";
			mes "哎哟，我的头！！！";
			next;
			mes "[???]";
			mes "你没事吧？Trick？";
			next;
			mes "[Trick]";
			mes "我没事！";
			mes "这没什么大不了！";
			mes "Treat。";
			next;
			mes "[Treat]";
			mes "你的头在喷出草莓酱！";
			mes "Trick。";
			next;
			mes "[Trick]";
			mes "啊啊啊！";
			mes "呃!!!!";
			mes "我要死了！！！";
			mes "不，不……！！！";
			next;
			mes "[Trick]";
			mes "咳，咳……";
			mes "和你在一起我很开心……虽然时间很短……";
			mes "Treat……";
			next;
			mes "[Trick]";
			mes "我要死了……";
			next;
			mes "[Treat]";
			mes "...";
			next;
			mes "[Treat]";
			mes "Trick.";
			next;
			mes "[Treat]";
			mes "我们不会死……";
			mes "我们以前就死过了。";
			next;
			mes "[Trick]";
			mes "耶，对，没错！";
			next;
			mes "[Trick]";
			mes "我总是忘记，因为我很久以前就死了。";
			next;
			mes "[Trick]";
			mes "哎哟！！！";
			mes "对了!!!!";
			mes "我们不该这样浪费时间！";
			mes "Treat。";
			next;
			mes "[Trick]";
			mes "如果不带着 ^ff9000‘那个’^000000 回主人那里，我们会死的……";
			next;
			mes "[Treat]";
			mes "我们已经死了……";
			mes "Trick。";
			next;
			mes "[Treat]";
			mes "他会一直纠缠我们，直到发脾气为止。";
			next;
			mes "[Trick]";
			mes "啊……不……";
			mes "快点！";
			mes "去找‘那个’吧！";
			mes "Treat。";
			next;
			mes "[Treat]";
			mes "现在……";
			next;
			mes "[Trick]";
			mes "^ff9000呃，啊呜，抽泣，见鬼!!!!!!!!^000000";
			next;
			mes "[Treat]";
			mes "现在出去会被晒死。";
			mes "Trick。";
			next;
			mes "[Trick]";
			mes "这么重要的事你必须提前说啊！！！！！！！！！";
			next;
			mes "[Treat]";
			mes "只有活着时这个世界才美好。";
			next;
			mes "[Trick]";
			mes "嘿！";
			mes "你！";
			next;
			mes "[Trick]";
			mes "你是第一个让我的头喷出草莓酱的人。";
			mes "你会……爱我吗……？";
			next;
			mes "- 砰！-";
			next;
		mes "- 棺材下面又有果酱流出来了。-";
			next;
			mes "[Treat]";
			mes "他有点奇怪，毕竟他流的是草莓酱。";
			mes "Trick……";
			next;
			mes "[Trick]";
			mes "不，Treat。";
			mes "我现在感觉好多了，你能放下那根棍子吗？";
			next;
			mes "[Trick]";
			mes "嘿，你！";
			mes "我不怪你把我的头弄成这样，但你能帮助我们吗？";
			next;
			mes "[Trick]";
			mes "别觉得有压力。";
			mes "草莓酱的事过几天就会恢复。";
			next;
			switch(select("帮助他们。:算了。")) {
			case 1:
				mes "[Trick]";
				mes "哈哈！";
				mes "谢谢！";
				next;
				select("听他们的故事。");
				mes "[Trick]";
				mes "这是秘密……";
				mes "嗯，我们已经死了。";
				next;
				mes "- 轰！-";
				next;
				mes "[Trick]";
				mes "好痛。";
				mes "Treat。";
				next;
				mes "[Trick]";
				mes "我会好好解释，先把棍子放下。";
				next;
				callsub L_Explanation;
				set eve_bs,1;
				setquest 11378;
				close;
			case 2:
				mes "[Trick]";
				mes "糟糕！";
				mes "那我们得出去了，Treat！";
				next;
				mes "[Treat]";
				mes "别担心，Treat。";
				mes "最坏的情况也只是被送回尼夫海姆。";
				close;
			}
		}
	} else if (eve_bs == 1) {
		callsub L_Explanation;
		close;
	} else if (eve_bs == 2) {
		if (isbegin_quest(11378)) {
			mes "[Trick]";
			mes "^ff9000南瓜散落在田野各处。请为 30 人收集有机或无机南瓜，并带给尼夫海姆的糖果厨师。^000000";
			next;
			mes "[Trick]";
			mes "有机南瓜更有价值。";
			mes "效用是普通南瓜的三倍！";
			close;
		} else {
			mes "[Trick]";
			mes "谢谢！我们不会被晒死了！";
			next;
			mes "[Treat]";
			mes "谢谢。";
			next;
			mes "[Trick]";
			mes "如果你不介意，能继续帮忙吗？";
			mes "南瓜蛋糕还不够。";
			next;
			mes "[Trick]";
			mes "上次去那里，我看到堆起来的南瓜蛋糕比城堡还高……我们还要做多少？";
			next;
			switch(select("帮助他们:算了。")) {
			case 1:
				mes "[Trick]";
				mes "^ff9000南瓜散落在田野各处。请为 30 人收集有机或无机南瓜，并带给尼夫海姆的糖果厨师。^000000";
				next;
				mes "[Trick]";
				mes "有机南瓜更有价值。";
				mes "效用是普通南瓜的三倍！";
				setquest 11378;
				close;
			case 2:
				mes "[Trick]";
				mes "糟糕！";
				mes "那我们得出去了，Treat！";
				next;
				mes "[Treat]";
				mes "别担心，Treat。";
				mes "最坏的情况也只是被送回尼夫海姆。";
				close;
			}
		}
	}
	end;

L_Explanation:
	mes "[Trick]";
	mes "我们来自^ff9000‘死者之城’尼夫海姆^000000。";
	next;
	mes "[Trick]";
	mes "^ff9000尼夫海姆万圣节活动所需的南瓜^000000全都消失了。";
	next;
	mes "[Trick]";
	mes "首先我们要再做一个蛋糕，但先生 Hell 喜欢南瓜蛋糕……没有南瓜蛋糕的万圣节就像没有獠牙的吸血鬼……";
	next;
	mes "[Trick]";
	mes "我们来寻找南瓜，因为厨师忙于其他事情，";
	next;
	mes "[Trick]";
	mes "别说寻找了，离开棺材都很危险……";
	next;
	mes "[Trick]";
	mes "^ff9000南瓜散落在田野各处。请为 30 人收集有机或无机南瓜，并带给尼夫海姆的糖果厨师。^000000";
	next;
	mes "[Trick]";
	mes "有机南瓜更有价值。";
	mes "效用是普通南瓜的三倍！";
	return;
}

niflheim,181,173,5	script	Chef Candycon#2013HE	796,{
	set .@pumpum, countitem(6805) + (countitem(6804)*3);
	if (eve_bs == 1) {
		if (.@pumpum > 29) {
			mes "[Chef Candycon]";
			mes "铛~铛~！";
			next;
			mes "[Chef Candycon]";
			mes "呼……这个蛋糕什么时候才能做完？……感觉像永远做不完……";
			next;
			mes "[Chef Candycon]";
			mes "天哪！下次谁再提议做南瓜蛋糕，我就把谁吊在树上。";
			next;
			mes "[Chef Candycon]";
			mes "虽然 Hell 先生喜欢这个，但他不在乎用什么南瓜。他说普通南瓜也行，但是……";
			next;
			mes "[Chef Candycon]";
			mes "他总说这种南瓜不好……只有有机的才好……搞什么，你是厨师吗！？既然这么懂烹饪，为什么不自己做！！";
			next;
			mes "[Chef Candycon]";
			mes "还从不帮我阻止南瓜逃跑，只会装忙？呃！啧~";
			next;
			mes "[Chef Candycon]";
			mes "我的主人！！！";
			mes "人……人类！！";
			mes "呼~（深呼吸）……";
			next;
			mes "[Chef Candycon]";
			mes "活……着……的……人……类……";
			next;
			mes "[Chef Candycon]";
			mes "你……怎……么……来……到……";
			mes "死……者……的……城……镇……";
			mes "尼……夫……海……姆……";
			next;
			mes "[Chef Candycon]";
			mes "这……里……";
			mes "不……适……合……";
			mes "活……着……的……";
			mes "生……物……";
			next;
			select("告诉他南瓜的事。");
			mes "[Chef Candycon]";
			mes ".....南...........瓜.................";
			next;
			mes "[Chef Candycon]";
			mes "它……已……经……";
			mes "结……束……但……";
			mes "又……回……来……了……";
			next;
			mes "[" + strcharinfo(0) + "]";
			mes "你为什么不正常说话？";
			next;
			mes "[Chef Candycon]";
			mes "......";
			next;
			mes "[Chef Candycon]";
			mes "我……我可以吗？？";
			next;
			mes "[Chef Candycon]";
			mes "啊……我不该这样说话……我们的形象制作也出了问题……";
			next;
			mes "[Chef Candycon]";
			mes "这样说话更能吓人……呼……不过我受不了，太闷了。";
			next;
			mes "[Chef Candycon]";
			mes "总之！如果那些南瓜没有逃到米德加尔特，就不会耽误。";
			next;
			mes "[Chef Candycon]";
			mes "显然我们已经死了，很怕阳光。白天搜索的话会变成一堆灰。";
			next;
			mes "[Trick]";
			mes "你知道吗？！怎么能让我们去找南瓜？！";
			next;
			mes "[Chef Candycon]";
			mes "什么？你们日落后可以到处走，还有翅膀和夜视……还有什么？超声波……？!!!!";
			next;
			mes "[Treat]";
			mes "所以我没有离开棺材。";
			next;
			mes "[Trick]";
			mes "啊……？！";
			next;
			mes "[Chef Candycon]";
			mes "天啊，考虑到带回南瓜后的工作，多亏你的努力我们真幸运。";
			next;
			select("交出南瓜。");
			mes "[Chef Candycon]";
			mes "让我看看！对吗？没错，就是这些！稍等。";
			next;
			callsub L_GivePumpkins;
			end;
		} else {
			mes "[Chef Candycon]";
			mes "活……着……的……人……类……";
			next;
			mes "[Chef Candycon]";
			mes "你……怎……么……来……到……";
			mes "死……者……的……城……镇……";
			mes "尼……夫……海……姆……";
			next;
			mes "[Chef Candycon]";
			mes "这……里……";
			mes "不……适……合……";
			mes "活……着……的……";
			mes "生……物……";
			close;
		}
	} else if (eve_bs == 2) {
		if (isbegin_quest(11378)) {
			mes "[Chef Candycon]";
			mes "咦！还有南瓜？？";
			mes "天啊……真的……还剩多少？";
			next;
			mes "[Chef Candycon]";
			mes "好吧，^ff9000我需要全部南瓜^000000！";
			mes "不快点工作就赶不上节日了。";
			next;
		mes "^ff9000*****警告*****^000000";
		mes "^ff9000你将交出全部南瓜，[全部]！^000000";
		mes "^ff9000要继续吗？^000000";
			callsub L_GivePumpkins;
			end;
		} else {
			mes "[Chef Candycon]";
			mes "哟！多亏你的运送，我们日夜都能烤蛋糕。";
			mes "躺在坟墓里可不能保证永远睡着。T.T";
			close;
		}
	} else {
		mes "[Chef Candycon]";
		mes "活……着……的……人……类……";
		next;
		mes "[Chef Candycon]";
		mes "你……怎……么……来……到……";
		mes "死……者……的……城……镇……";
		mes "尼……夫……海……姆……";
		next;
		mes "[Chef Candycon]";
		mes "这……里……";
		mes "不……适……合……";
		mes "活……着……的……";
		mes "生……物……";
		close;
	}
	end;

L_GivePumpkins:
	mes "[Chef Candycon]";
	mes "好吧，^ff9000我需要全部南瓜^000000！";
	mes "不快点工作就赶不上节日了。";
	next;
	mes "^ff9000*****警告*****^000000";
	mes "^ff9000你将交出全部南瓜，[全部]！^000000";
	mes "^ff9000要继续吗？^000000";
	switch(select("交出全部南瓜。:取消。")) {
	case 1:
		set .@pumpum, countitem(6805) + (countitem(6804)*3);
		if (.@pumpum > 29){
			if (countitem(6805)) delitem 6805,countitem(6805); //INORGANIC_PUMPKIN
			if (countitem(6804)) delitem 6804,countitem(6804); //ORGANIC_PUMPKIN
			set eve_bs,2;
			getitem 22669,1; //HALLOWEEN_G_BOX
			erasequest 11378;
			mes "[Chef Candycon]";
			mes "好！挖出南瓜内部，这样~再那样~！";
			next;
			mes "[Chef Candycon]";
			mes "酷！南瓜雕刻得正好！这才是万圣节！没有南瓜灯就不是真正的万圣节！";
			next;
			mes "[Chef Candycon]";
			mes "拿着，这是带来南瓜的奖励！打开看看，里面可能有有趣的东西……";
			close;
		} else {
			mes "[Chef Candycon]";
			mes "糟糕，南瓜在哪里？又逃跑了？";
			mes "天啊……不……你得再去找它们……";
			close;
		}
	case 2:
		mes "[Chef Candycon]";
		mes "呃~~那些南瓜对你没用~~";
		close;
	}
}

niflheim,182,177,3	script	Trick#2013HE	799,{
	if (eve_bs == 1) {
		mes "[Trick]";
		mes "真新鲜，你从棺材外面来的吗？";
		mes "你拿到 30 个南瓜了吗？";
		next;
		mes "[Trick]";
		mes "如果都带来了，就交给那里的厨师。";
		close;
	} else if (eve_bs > 1) {
		mes "[Trick]";
		mes "没有你的帮助会怎样呢~？";
		next;
		mes "[Treat]";
		mes "也许先生，地狱里会烤蝙蝠，而不是南瓜蛋糕。";
		next;
		mes "[Trick]";
		mes "天啊……";
		close;
	} else {
		mes "[Trick]";
		mes "我不需要甜食！！";
		mes "我只会把一切搞砸！哇哈哈哈！";
		close;
	}
	end;
}

niflheim,183,176,3	script	Treat#2013HE	799,{
	if (eve_bs == 1) {
		mes "[Treat]";
		mes "......";
		close;
	} else if (eve_bs > 1) {
		mes "[Treat]";
		mes "做得还好吗……？";
		close;
	} else {
		mes "[Treat]";
		mes "-咯咯笑-";
		close;
	}
}

niflheim,179,168,5	script	Kentucky#2013HE	800,{
	mes "[Kentucky]";
	mes "哦……这些种子的味道真浓。";
	mes "这种种子我想吃多少都行。";
	close;
}

niflheim,177,166,8	script	Chicken#2013HE	800,{
	mes "[Chicken]";
	mes "嘿，Kentucky！！";
	mes "你一个人吃太多了！";
	close;

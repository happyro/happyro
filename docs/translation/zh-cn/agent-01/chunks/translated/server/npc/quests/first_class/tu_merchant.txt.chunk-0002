				mes "我会讲讲金钱攻击技能。现在先让我从这场辛苦的讲课中休息一下。^666666*呼！*^000000";
				close;
			}
		} else {
			mes "不？没关系。";
			mes "如果你连这些简单基础都掌握不了，";
			mes "我也没法继续教你更多，所以快去学习那些技能，好吗？";
			close;
		}
		mes "好了，下次我会讲金钱攻击技能。";
		mes "现在先让我从这场辛苦的讲课中休息一下。^666666*呼！*^000000";
		tu_merchant = 2;
		erasequest 8229;
		setquest 8230;
		close;
	}
	mes "你刚成为商人，对吧？想不想向有经验的同行学习经营基础？";
	next;
	if (select("好啊！:我自己来！") == 1){
		if(getskilllv("MC_INCCARRY") < 4){
			tu_merchant = 1;
			setquest 8229;
			mes "[瓜尼恩]";
			mes callfunc("F_SexMes","干得好，姑娘~！","干得好，小伙子~！");
			mes "不过首先要做的事是！";
			mes "你最好先学习";
			mes "^871F78增加负重上限^000000技能！";
			next;
			mes "[瓜尼恩]";
			mes "如果连要卖的货物都带不了，就不能算真正的商人。技能等级越高，能携带的物品就越多。";
			next;
			mes "[瓜尼恩]";
			mes "把增加负重上限技能提升到 4 级怎么样？";
			mes "之后我们再谈如何成为真正的商人。";
			close;
		} else {
			mes "[瓜尼恩]";
			mes "太好了……！";
			mes "我看你已经把^871F78增加负重上限^000000学到至少 4 级了。真是干劲十足啊！";
			next;
			mes "[瓜尼恩]";
			mes "既然增加负重上限等级已经够高，";
			mes "你的技能窗口里应该出现新技能了：^871F78折扣^000000！";
			next;
			mes "[瓜尼恩]";
			mes "折扣技能以后再说。还有一些基础技能你现在就能学，我先讲那些。别急~";
			next;
			mes "[瓜尼恩]";
			mes "首先是^871F78鉴定物品^000000技能。学会后，你就能^871F78鉴定未知物品^000000。";
			next;
			mes "[瓜尼恩]";
			mes "这个技能和^871F78放大镜^000000完全一样，你不用再花 Zeny 买放大镜。";
			next;
			mes "[瓜尼恩]";
			if(getskilllv("MC_IDENTIFY")){
				mes "我从你的眼神里看出你已经学会鉴定物品了。哈哈，知识本身就是奖励，不过我还是再给你一点额外奖励吧！";
				tu_merchant = 2;
				erasequest 8229;
				setquest 8230;
				getexp 58,11;
				getitem 1351,1; //Battle_Axe
				next;
				mes "[瓜尼恩]";
				mes "好了，下次我会讲金钱攻击技能。";
				mes "现在先让我从这场辛苦的讲课中休息一下。^666666*呼！*^000000";
				close;
			}
			mes "好了，下次我会讲金钱攻击技能。";
			mes "现在先让我从这场辛苦的学习中休息一下。";
			next;
			mes "[瓜尼恩]";
			mes "哦……";
			mes "折扣技能的更多内容";
			mes "以后再告诉你。";
			mes "我总是会忘记这件事！";
			mes "真是的。";
			tu_merchant = 2;
			erasequest 8229;
			setquest 8230;
			close;
		}
	} else {
		mes "[瓜尼恩]";
		mes "你要自己来？";
		mes "哈哈哈，这才有精神！";
		mes "不过我的建议是免费的，听进去一点也不会有坏处。";
		next;
		mes "[瓜尼恩]";
		mes "如果你改变主意，随时来找我。作为商人，你应该知道免费的建议才是最好的！";
		close;
	}
}

// Sagle
//============================================================
prontera,66,111,3	script	Sagle	4_KID01,{
	mes "[赛格尔]";
	if (tu_merchant == 6)
		callsub L_Potions, 390,9;// <Zeny cost>, <next 'tu_merchant' value>
	else if (tu_merchant == 7)
		callsub L_Potions, 410,10;
	else if (tu_merchant == 8)
		callsub L_Potions, 420,10;
	mes "就在嘴边，";
	mes "但我一时想不起来……";
	mes "真是奇怪。";
	next;
	mes "[赛格尔]";
	mes "你知道，就是那家雇佣许多漂亮女士的公司。卡……卡什么来着。总之，听说他们很担心日益激烈的竞争。";
	next;
	mes "[赛格尔]";
	mes "这本来不关我的事，但了解世界正在发生什么总是好的，";
	mes "尤其是可能影响市场的事情。";
	close;

L_Potions:
	.@cost = getarg(0);
	mes "你好，你好~";
	mes "要不要买一些红色药水？";
	mes "旅行时这是必需品，";
	mes "这些红色药水最适合新手冒险家~";
	next;
	mes "[赛格尔]";
	mes "我可以用 ^871F78"+ .@cost +" Zeny^000000 卖给你 10 瓶红色药水。趁还有货，赶快买吧！";
	next;
	switch(select("购买:取消")){
	case 1:
		mes "[赛格尔]";
		mes "太棒了！";
		mes "你真会挑便宜货。给你，10 瓶刚从……药剂师那里拿来的红色药水……";
		if(Zeny < .@cost){
			next;
			mes "[赛格尔]";
			mes "等等，先别急！";
			mes "你买不起这些药水……";
			mes "请先准备足够的钱。";
			mes "等攒够 Zeny 后再回来，";
			mes "好吗？";
			mes "我会给你留着的。";
			close;
		}
		if(MaxWeight - Weight < 71){
			next;
			mes "[赛格尔]";
			mes "等等，先别急！";
			mes "你不可能带得下这么多东西！回去前先把一些物品存进卡普拉仓库吧？";
		} else {
			Zeny = Zeny - .@cost;
			tu_merchant = getarg(1);
			getitem 501,10; //Red_Potion
		}
		close;
	case 2:
		mes "[赛格尔]";
		mes "好吧……";
		mes "不过如果这些药水卖光了，";
		mes "可别来抱怨！";
		mes "到时就没货了。";
		mes "你可要想清楚。";
		close;
	}
}

// Kellion
//============================================================
prontera,93,330,3	script	Kellion	4W_M_01,{
	mes "[凯利恩]";
	if (tu_merchant == 6)
		callsub L_Potions, 400,10;// <Zeny cost>, <next 'tu_merchant' value>
	else if (tu_merchant == 7)
		callsub L_Potions, 390,9;
	else if (tu_merchant == 8)
		callsub L_Potions, 340,10;
	mes "最近听说王室";
	mes "发生了一些事情。";
	next;
	mes "[凯利恩]";
	mes "这可能只是无根据的传闻，但我听说王室成员正因某种未知原因不断去世。";
	next;
	mes "[凯利恩]";
	mes "嗯。";
	mes "真是令人毛骨悚然的消息！";
	mes "希望这完全不是真的，一点都不是……";
	close;

L_Potions:
	.@cost = getarg(0);
	mes "我正在出售";
	mes "10 瓶红色药水，售价 "+ .@cost +" Zeny。";
	mes "要买一些吗？";
	next;
	switch(select("购买:取消")){
	case 1:
		mes "[凯利恩]";
		mes "明智的选择~";
		mes "感谢你光顾";
		mes "我的商店。";
		if(Zeny < .@cost){
			next;
			mes "[凯利恩]";
			mes "哎呀！";
			mes "抱歉，你的 Zeny 不够。我也得想办法维持生意，你懂的吧？";
			close;
		}
		if(MaxWeight - Weight < 71){
			next;
			mes "[凯利恩]";
			mes "……嗯？";
			mes "你最好把一些东西放进卡普拉仓库，已经带不了更多了！";
		} else {
			Zeny = Zeny - .@cost;
			tu_merchant = getarg(1);
			getitem 501,10; //Red_Potion
		}
		close;
	case 2:
		mes "[凯利恩]";
		mes "好吧，听到这个我很遗憾。";
		mes "那我们下次再见。";
		mes "希望你改变主意。";
		mes "欢迎随时回来。";
		close;
	}
}

// Aigie
//============================================================
prt_in,169,11,3	script	Aigie	4_F_03,{
	mes "[艾吉]";
	if (tu_merchant == 6)
		callsub L_Potions, 340,10;// <Zeny cost>, <next 'tu_merchant' value>
	else if (tu_merchant == 7)
		callsub L_Potions, 420,10;
	else if (tu_merchant == 8)
		callsub L_Potions, 390,9;
	mes "钱确实不是一切。要获得幸福，肯定还需要其他重要的东西。";
	next;
	mes "[艾吉]";
	mes "不过，钱有时比我认识的某些人可靠多了。在这个世界上，钱比什么都值得依靠。";
	close;

L_Potions:
	.@cost = getarg(0);
	mes "欢迎光临我的商店。";
	mes "我只是个受环境所迫的年轻女孩，只能在街头以极低的价格卖药水。";
	next;
	mes "[艾吉]";
	mes "善良的冒险家，";
	mes "要不要用 "+ .@cost +" Zeny";
	mes "购买 10 瓶红色药水？";
	next;
	switch(select("购买:取消")){
	case 1:
		mes "[艾吉]";
		mes "太感谢你了。";
		mes "我终于又有钱";
		mes "买食物了……";
		if(Zeny < .@cost){
			next;
			mes "[艾吉]";
			mes "等等，等等！";
			mes "抱歉，你的钱不够。请再准备一些 Zeny 后回来，好吗？";
			close;
		}
		if(MaxWeight - Weight < 71){
			next;
			mes "[艾吉]";
			mes "等等，等等！";
			mes "你已经带不了更多物品了。先把东西存进卡普拉仓库吧？";
		} else {
			Zeny = Zeny - .@cost;
			tu_merchant = getarg(1);
			getitem 501,10; //Red_Potion
		}
		close;
	case 2:
		mes "[艾吉]";
		mes "我明白。";
		mes "不过希望你能看出";
		mes "我给的是非常优惠的价格。";
		mes "低价出售并不容易。";
		mes "^666666*抽泣*^000000";
		close;
	}
}

// Jayon
//============================================================
prontera,247,129,3	script	Jayon	4_M_03,{
	mes "[杰扬]";
	if (tu_merchant == 6)
		callsub L_Potions, 410,10;// <Zeny cost>, <next 'tu_merchant' value>
	else if (tu_merchant == 7)
		callsub L_Potions, 400,10;
	else if (tu_merchant == 8)
		callsub L_Potions, 410,10;
	mes "施瓦茨瓦尔德共和国……";
	mes "那是个非常有趣的国家。有朱诺等几个值得游览的地方。";
	next;
	mes "[杰扬]";
	mes "它们也许不是最好的观光地点，";
	mes "但我相信一定有让冒险家感兴趣的东西。";
	close;

L_Potions:
	.@cost = getarg(0);
	mes "如果你了解过红色药水市场，就知道我的价格最好。我只要 "+ .@cost +" Zeny 就卖 10 瓶红色药水！";
	next;
	switch(select("购买:取消")){
	case 1:
		mes "[杰扬]";
		mes "嘿嘿……！";
		mes "看来你很懂行。";
		mes "你自己就是商人，";
		mes "对吧？";
		mes "眼光不错。";
		mes "我喜欢这样的客人。";
		if(Zeny < .@cost){
			next;
			mes "[杰扬]";
			mes "不过抱歉，朋友。";
			mes "规矩就是规矩。";
			mes "想要这些药水，";
			mes "就得付我的价格。";
			mes "请准备好 Zeny。";
		close;
		}
			if(MaxWeight - Weight < 71){
			next;
			mes "[杰扬]";
			mes "不过抱歉，朋友。我不能让你携带超过负重的东西。";
		mes "有机会时先腾出一些背包空间吧。";
			} else {
			Zeny = Zeny - .@cost;
			tu_merchant = getarg(1);
		getitem 501,10; //Red_Potion
		}
	close;
		case 2:
		mes "[杰扬]";
		mes "只是随便看看，";
		mes "是吧？我明白。";
		mes "但看到真正的优惠时，";
		mes "可要好好把握！";
		mes "机会不会一直等你。";
		close;
	}
}

// Maos
//============================================================
prt_in,251,129,3	script	Maos	4_M_SEAMAN,{
	mes "[毛斯]";
	if (tu_merchant == 6)
		callsub L_Potions, 400,10;// <Zeny cost>, <next 'tu_merchant' value>
	else if (tu_merchant == 7)
		callsub L_Potions, 340,10;
	else if (tu_merchant == 8)
		callsub L_Potions, 420,10;
	mes "我看到太多人辛苦攒下每一分钱，全部存起来……";
	next;
	mes "[毛斯]";
	mes "别误会。为未来投资当然是好事，但钱就是要花的！享受每一刻，这就是我的看法~";
	next;
	mes "[毛斯]";
	mes "而且……";
	mes "生命走到尽头时，";
	mes "你又不能把钱带走，";
	mes "对吧？";
	mes "所以现在就享受吧。";
	close;

L_Potions:
	.@cost = getarg(0);
	mes "不用说了。";
	mes "我知道你想要什么。";
	mes "10 瓶红色药水，对吧？";
	mes "我会以低价卖给你，";
	mes "只要 "+ .@cost +" Zeny~";
	next;
	switch(select("购买:取消")){
	case 1:
		mes "[毛斯]";
		mes "明智的选择！";
		mes "物美价廉！这就是我的商人之道。";
		if(Zeny < .@cost){
			next;
			mes "[毛斯]";
			mes "哦，但你的 Zeny 不够买这些药水。抱歉，我不能亏本卖货，你懂的吧？";
			close;
		}
		if(MaxWeight - Weight < 71){
			next;
			mes "[毛斯]";
			mes "哦，但你的背包似乎没有足够空间携带更多物品。";
		} else {
			Zeny = Zeny - .@cost;
			tu_merchant = getarg(1);
			getitem 501,10; //Red_Potion
		}
		close;
	case 2:
		mes "[毛斯]";
		mes "我不能强迫你购买，但你确实错过了一笔真正的优惠！";
		close;
	}
}

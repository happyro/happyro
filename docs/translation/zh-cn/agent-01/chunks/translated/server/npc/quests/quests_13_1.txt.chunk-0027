			next;
			mes "[Rayan]";
			mes "哈哈……呜哈哈哈！他在呼唤我！现在需要我！";
			next;
			mes "[Rayan]";
			mes "你是琳，对吧？这是你最后一次见到我。哈哈……呜哈哈哈哈！！";
			specialeffect EF_ENTRY,AREA,"Rayan#moc_room2_2";
			donpcevent "Rayan#moc_room2_2::OnDisable";
			next;

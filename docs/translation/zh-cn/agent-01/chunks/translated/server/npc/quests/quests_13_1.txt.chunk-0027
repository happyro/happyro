			next;
			mes "[" + strcharinfo(0) + "]";
			mes "……我带回了日记和其他东西……";
			mes "……呃，抱歉。我忘了带日记！我马上回来。";
			close2;
		}
	}
	else if (mao_morocc2 == 22) {
		mes "[" + strcharinfo(0) + "]";
		mes "现在怎么办？你听到那个声音了……你觉得是撒旦梦罗克吗？";
		next;
		cutin "moc2_rin01",2;
		mes "[Rin]";
		mes "……也许吧。";
		mes "根据较为正常的莱恩告诉我们的情况，看来他体内的另一个人格是撒旦梦罗克强行制造的。";
		next;
		mes "[Rin]";
		mes "撒旦梦罗克一定选中莱恩来破坏封印。他一直从莱恩的内心深处控制他……";
		next;
		mes "[Rin]";
		mes "而且……那个疯狂的莱恩似乎与你的血色黑暗水晶有关。";
		next;
		cutin "moc2_rin02",2;
		mes "[Rin]";
		mes "你来之前我没见过莱恩的这一面；在那之前他一直很合作、很虚弱。";
		next;
		mes "[Rin]";
		mes "原本的莱恩似乎记得被那个疯狂人格控制时发生的一切……";
		next;
		mes "[Rin]";
		mes "得知自己亲手杀死所有同伴后，他陷入震惊。你接近他后，他开始表现异常。我必须把这些记在日记里。";
		next;
		next;
		mes "[Rin]";
		mes "没错。他触摸水晶后彻底改变，仿佛自己变成了撒旦梦罗克。";
		next;
		cutin "moc2_rin03",2;
		mes "[Rin]";
		mes "……可恶。";
		next;
		select("我们现在该怎么办？");
		cutin "moc2_rin02",2;
		mes "[Rin]";
		mes "别担心。我在莱恩身上做了标记，即使他逃走也能追踪。";
		next;
		mes "[Rin]";
		mes "我把他的魔法波长模式编号给你。能把编号交给紫苑吗？剩下的交给她处理。";
		next;
		set .@rotto,rand(1,3);
		if (.@rotto == 1) set .@pattern$,"SDHF92F-SDF";
		else if (.@rotto == 2) set .@pattern$,"VWNM94GVWN90";
		else set .@pattern$,"CM3-TRDFGHE0";
		mes "[Rin]";
		mes "模式编号是……";
		mes "^4d4dff["+.@pattern$+"]^000000";
		mes "一个字符都别漏。好吗？";
		set mao_morocc2,22+.@rotto;
		getitem 6029,1; //Morocc_Tracing_Log
		changequest 7030,7030+.@rotto;
		next;
		mes "[Rin]";
		mes "来，把这本日记带上。别忘了模式编号。确保紫苑收到。";
		close2;
	}
	else if (mao_morocc2 == 23) {
		cutin "moc2_rin01",2;
		mes "[Rin]";
		mes "向灰色幽灵的紫苑报告，并把模式编号交给她。编号是^4d4dff[SDHF92F-SDF]^000000，一个字符都别漏。好吗？";
		close2;
	}
	else if (mao_morocc2 == 24) {
		cutin "moc2_rin01",2;
		mes "[Rin]";
		mes "向灰色幽灵的紫苑报告，并把模式编号交给她。编号是^4d4dff[VWNM94GVWN90]^000000，一个字符都别漏。好吗？";
		close2;
	}
	else if (mao_morocc2 == 25) {
		cutin "moc2_rin01",2;
		mes "[Rin]";
		mes "向灰色幽灵的紫苑报告，并把模式编号交给她。编号是^4d4dff[CM3-TRDFGHE0]^000000，一个字符都别漏。好吗？";
		close2;
	}
	else if ((mao_morocc2 > 25) && (mao_morocc2 < 29)) {
		// Missed
		cutin "moc2_rin01",2;
		mes "[Rin]";
		mes "哎哟，我的头……怎么又回来了？什么……你忘了模式编号？叹气……算了。";
		next;
		mes "[Rin]";
		mes "别再忘了。模式编号是……";
		if (mao_morocc2 == 26) set .@pattern$,"SDHF92F-SDF";
		else if (mao_morocc2 == 27) set .@pattern$,"VWNM94GVWN90";
		else set .@pattern$,"CM3-TRDFGHE0";
		mes "^4d4dff["+.@pattern$+"]^000000。一个字符都别漏。好吗？";
		mes "记住了吗？";
		next;
		mes "[Rin]";
		mes "叹气。那就出发吧……我需要休息……";
		close2;
	}
	else {
		cutin "moc2_rin01",2;
		mes "[Rin]";
		mes "啊～我是病人，需要休息！我不想再做其他事～快走，别烦我～";
		close2;
	}
	cutin "moc2_rin01",255;
	end;

OnInit:
OnDisable:
	disablenpc "Rin#moc_room2_2";
	end;

OnEnable:
	enablenpc "Rin#moc_room2_2";
	end;
}


		mes "- 携带太多物品时无法继续任务。 -";
		close;
	}
	if (mao_morocc2 == 21) {
		if ((countitem(6029) > 0) && (countitem(6027) > 0)) {
			cutin "moc2_rin03",2;
			mes "[Rin]";
			mes "嘿，你回来得正是时候。看看他，真荒唐。";
			next;
			cutin "moc2_dan02",0;
			mes "[Rayan]";
			mes "我知道无论理由多么充分，所作所为都不可原谅。但……*叹气*……现在后悔也太晚了，不是吗？";
			next;
			select("这是谁？");
			cutin "moc2_rin01",2;
			mes "[Rin]";
			mes "你不知道吗？他就是胆敢释放撒旦梦罗克、欺骗所有人并给世界带来灾难的莱恩·摩尔。";
			mes "你知道吗？";
			next;
			mes "[Rin]";
			mes "不仅如此，他还毫不留情地屠杀了自己的同伴！";
			next;
			cutin "moc2_dan02",0;
			mes "[Rayan]";
			mes "……哇啊！我……我亲手杀了他们！*抽泣*……对……对不起……";
			next;
			mes "- 莱恩因恐惧而发抖。他仍无法接受自己杀死了所有同伴。 -";
			next;
			mes "[" + strcharinfo(0) + "]";
			mes "这是怎么回事？他看起来不像我认识的莱恩。";
			next;
			cutin "moc2_rin03",2;
			mes "[Rin]";
			mes "我不知道。这个莱恩似乎和我们认识的完全不同。我想这就是所谓的多重人格障碍。";
			next;
			mes "[Rin]";
			mes "这个莱恩不是策划阴谋的莱恩·摩尔，而是隐藏在他体内的另一人格。";
			next;
			cutin "moc2_rin01",2;
			mes "[Rin]";
			mes "嘿，冷静。慢慢说。";
			next;
			cutin "moc2_dan02",0;
			mes "[Rayan]";
			mes "……是我……我本来只想假装破坏撒旦梦罗克的封印……你不明白吗？那只是演戏！我想让城镇陷入恐慌……";
			next;
			mes "[Rayan]";
			mes "……那会是传播救世主芙蕾雅教义的机会。后来出了问题……";
			next;
			cutin "moc2_rin04",2;
			mes "[Rin]";
			mes "什么？你怎么这么愚蠢？！*叹气*继续。";
			next;
			cutin "moc2_dan02",0;
			mes "[Rayan]";
			mes "我为计划研究文件时意外发现了某样东西。那时我变成了完全不同的人……*抽泣*";
			next;
			mes "[Rayan]";
			mes "……我的计划……我仿佛不再是自己。我真的想释放撒旦梦罗克。我绑架孩子，威胁同伴。";
			next;
			mes "[Rayan]";
			mes "……我掌握了破坏封印、释放撒旦梦罗克的真正仪式……哇……我的头好痛……不，你不能……哇啊！";
			next;
			mes "[Rayan]";
			mes "……可恶……你们这些愚蠢的弱者……我要杀了你们……不……不要！";
			next;
			mes "- 莱恩突然胡言乱语，痛苦地揪起头发。他似乎在抵抗体内的邪恶人格。 -";
			next;
			cutin "moc2_dan02",255;
			switch(select("敲他的头。:打他的肚子。:扇他的脸。")) {
			case 1:
				specialeffect EF_HIT2,AREA,"Rayan#moc_room2_2";
				mes "- 为阻止莱恩发狂，你用日记敲了他的后脑勺。莱恩踉跄后倒地。干得好！ -";
				next;
				break;
			case 2:
				specialeffect EF_HIT4,AREA,"Rayan#moc_room2_2";
				mes "- 为阻止莱恩发狂，你一拳打中他的腹部。莱恩踉跄后倒地……！ -";
				next;
				break;
			case 3:
				specialeffect EF_HIT1,AREA,"Rayan#moc_room2_2";
				mes "- 为阻止莱恩发狂，你用日记扇他的脸。莱恩踉跄后倒地。哇！ -";
				next;
				break;
			}
			mes "- 你的突然暴力举动让血色黑暗水晶从夹克中飞出，沿地面滚向莱恩。 -";
			next;
			cutin "moc2_dan02",0;
			mes "[Rayan]";
			mes "啊……这……这不是……？！";
			specialeffect EF_POISON,AREA,"Rayan#moc_room2_2";
			next;
			mes "[Rin]";
			mes "哇！怎么回事？为什么突然……？！";
			next;
			mes "[" + strcharinfo(0) + "]";
			mes "这是时空现象吗？！为什么……这里没有裂缝？";
			next;
			cutin "moc2_dan01",1;
			mes "[Rayan]";
			mes "哈哈……呜哈哈哈！呜哈哈哈哈！！他来了……我的主人到了！！遵命，主人。我来为你服务！";
			next;
			mes "[Voice from Rayan]";
			mes "^FF0000你们这些渺小的人类！我会恢复全部力量，报复你们把我囚禁在黑暗中数百年！^000000";
			next;
			cutin "moc2_rin04",2;
			mes "[Rin]";
			mes "什么……刚才发生了什么？你是莱恩，还是已经变成别人了？！";
			next;
			cutin "moc2_dan01",0;
			mes "[Rayan]";

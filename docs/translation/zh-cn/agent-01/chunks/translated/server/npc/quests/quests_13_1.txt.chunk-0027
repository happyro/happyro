hu_fild04,235,103,0	script	Heap of Earth#mao2_01	844,4,4,{
	if (checkweight(714,1) == 0) {
		mes "- 携带的物品太多，无法继续任务。-";
		close;
	}
	if (mao_morocc2 == 7) {
		specialeffect EF_LEVEL99_4;
		mes "你在灌木下发现一堆泥土和深深的痕迹，周围有深脚印和洒落的血迹。";
		next;
		mes "这里肯定发生过激烈战斗。脚印旁有折断的树枝，像是有人向后滑倒……";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "我在这附近有种奇怪感觉……像是微弱的魔力……？！没错，我勉强能看到光环。";
		mes "……这是什么？";
		next;
		switch(select("不管它。:仔细看看。")) {
		case 1:
			mes "[" + strcharinfo(0) + "]";
			mes "嗯……这里一定是琳与莱恩帮派战斗的地方。看不到重要的东西。";
			close;
		case 2:
			mes "你仔细观察时，注意到地面上有东西在闪光。";
			next;
			mes "^4d4dff你发现了‘血色黑暗水晶’。^000000";
			next;
			mes "[" + strcharinfo(0) + "]";
			mes "我想这里找不到其他东西了……现在该回去了。希望琳能理解。";
			set mao_morocc2,8;
			getitem 6027,1; //Crystal_Of_Feardoom
			changequest 7016,7017;
			close;
		}
	}
	else if (mao_morocc2 == 8) {
		mes "这里有战斗痕迹和洒落的血迹，还有一堆不合常理的泥土。";
		close;
	}
	else {
		mes "这里有战斗痕迹和洒落的血迹。";
		close;
	}

OnTouch:
	if (mao_morocc2 == 7) {
		specialeffect EF_LEVEL99_4;
	}
	end;
}


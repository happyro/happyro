	next;
	mes "[放松的拉弗莱西亚]";
	mes "它不只是普通的水洼。";
	mes "它拥有强大的";
	mes "治愈伤口的力量。";
	next;
	mes "[放松的拉弗莱西亚]";
	mes "如果想亲自确认，就在浴池里走走。";
	mes "它会慢慢而确实地治愈你的伤口。";
	close;
}


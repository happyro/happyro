}

mora,113,185,4	script	Reading Raffle#ep14_1	516,{
	mes "你看到一只沉浸在阅读中的";
	mes "拉弗莱西亚。";
	next;
	switch(select("看看他在读什么。:别打扰他。")) {
	case 1:
		mes "你很好奇他在读什么，";
		mes "于是悄悄从后面靠近。";
		mes "拉弗莱西亚低声读着书。";
		next;
	mes "[阅读中的拉弗莱西亚]";
		mes "塞伦正要去埃雷梅斯家。";
		mes "他想去那里借用";
		mes "埃雷梅斯的参考书，";
		next;
	mes "[阅读中的拉弗莱西亚]";
		mes "但也希望能见到";
		mes "他美丽的妹妹塞伦。";
		mes "塞伦心跳加速地敲响了埃雷梅斯的门。";
		next;
	mes "[阅读中的拉弗莱西亚]";
		mes "咚！咚！咚！";
		mes "请问，有人在吗？";
		mes "... ... ...";
		mes "他什么也没听到。";
		next;
	mes "[阅读中的拉弗莱西亚]";
		mes "难道家里没人？";
		mes "他又敲了敲门，";
		mes "担心自己会白跑一趟。";
		next;
	mes "[阅读中的拉弗莱西亚]";
		mes "咚！咚！咚！";
		mes "还是没有回应。难道家里没人？";
		mes "他知道这样很不礼貌，";
		mes "但还是决定进去，";
		mes "等埃雷梅斯回家。";
		next;
	mes "[阅读中的拉弗莱西亚]";
		mes "塞伦心跳不已地打开了前门。";
		mes "*吱呀*";
		mes "门没有锁。";
		mes "看来埃雷梅斯暂时不在家。";
		next;
	mes "[阅读中的拉弗莱西亚]";
		mes "塞伦犹豫地走进房子。";
		mes "他踏入房子的瞬间，";
		mes "听到了流水声。";
		next;
	mes "[阅读中的拉弗莱西亚]";
		mes "塞伦突然回过神来，";
		mes "转身准备离开。";
		mes "但就在这时！！";
		next;
	mes "[阅读中的拉弗莱西亚]";
		mes "*砰*";
		mes "浴室门打开了，";
		mes "白色蒸汽中伸出了一只脚。";
		next;
	mes "[阅读中的拉弗莱西亚]";
		mes "看到这一幕，塞伦的心脏差点停止跳动。";
		mes "片刻后，一个人从浴室里走出来，";
		mes "身上只裹着一条毛巾。";
		next;
	mes "[阅读中的拉弗莱西亚]";
		mes "她的身体还被淋浴打湿……";
		next;
	mes "[阅读中的拉弗莱西亚]";
		mes "*倒吸气* 你是谁？你在那里站了多久？真没礼貌。";
		emotion ET_HUK;
		next;
		mes "拉弗莱西亚匆忙合上书。";
		mes "你很好奇接下来会发生什么，";
		mes "但你已经够失礼了，";
		mes "于是只好放弃。";
		close;
	case 2:
		mes "你悄悄离开，";
		mes "不去打扰";
		mes "沉浸在阅读中的拉弗莱西亚。";
		close;
	}
}

mora,99,65,6	script	Banana Rafflesia#ep14_1	516,{
	mes "[Banana Rafflesia]";
	mes "你想要香蕉吗？";

	switch(select("是的。:不用了，谢谢。")) {
	case 1:
		mes "[Banana Rafflesia]";
		mes "如果你能拿到，就拿去吧。";
		mes "成功的话可以免费得到。";
		emotion ET_OK;
		close;
	case 2:
		mes "[Banana Rafflesia]";
		mes "我本来打算免费送给你，";
		mes "但你不要的话也没关系。";
		emotion ET_HNG;
		close;
	}
}


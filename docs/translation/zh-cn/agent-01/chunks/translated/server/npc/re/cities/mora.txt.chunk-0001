mora,140,186,3	script	Raffle Philosopher	517,{
	mes "[Raffle Philosopher]";
	mes "只要给我一点谢礼，我就告诉你一句能帮助你人生的格言。";
	next;
	if(select("给他一点谢礼。:你不能直接告诉我吗？") == 2) {
		mes "[Raffle Philosopher]";
		mes "天下没有免费的午餐。";
		close;
	}
	mes "[Raffle Philosopher]";
		mes "你愿意给我多少？";
		mes "你可以用下面列出的货币支付。";
		mes "输入你愿意支付的金额。不想支付就输入 0。";
	next;
	input .@input;
	if (.@input == 0) {
		mes "[Raffle Philosopher]";
		mes "所以你不想听格言，是吗？";
		close;
	} else if (.@input < 100 || .@input > 1000000) {
		mes "[Raffle Philosopher]";
		mes "你可以支付 ^FF0000100 到 1000000^000000。";
		close;
	} else if (Zeny < .@input) {
		mes "[Raffle Philosopher]";
		mes "你觉得我的时间就值这些吗？";
		close;
	}
	mes "[Raffle Philosopher]";
		mes "我要告诉你的格言是……";
		mes "让我看看……等一下。";
	set Zeny, Zeny-.@input;
	next;
	mes ". . . . . . . . .";
	next;
	mes ". . . . . . . . .";
	next;
	mes ". . . . . . . . .";
	next;
	mes "[Raffle Philosopher]";
		mes "好了！我想这句很适合你。";
	next;
	mes "[Raffle Philosopher]";
	mes strcharinfo(0)+"，我要告诉你的名言是……";
	switch(rand(1,70)) {
	case 1:
		mes "没有什么比做出决定";
		mes "更困难，";
		mes "也因此更珍贵。";
		mes "- 拿破仑·波拿巴 -";
		break;
	case 2:
		mes "有时我们久久凝视正在关闭的门，";
		mes "以至于太晚才发现另一扇门正敞开着。";
		mes "- 亚历山大·格雷厄姆·贝尔 -";
		break;
	case 3:
		mes "如果那么痛苦，你为什么还要继续？";
		mes "答案很简单。";
		mes "因为它让我心跳，";
		mes "因为它让我兴奋。";
		mes "身体也许会受苦，但做一直想做的事，";
		mes "会让我快乐得多。";
		mes "- 韩比雅 -";
		break;
	case 4:
		mes "在改变自己之前，";
		mes "你无法说服任何人。";
		mes "- 高哲宗 -";
		break;
	case 5:
		mes "永远不要后悔自己的选择。";
		mes "- 高美英 -";
		mes "这句话值得记住。";
		mes "希望它能帮助你。";
		mes "愿你找到自己的道路。";
		mes "不要忘记初心。";
		mes "保持勇气。";
		mes "继续前进。";
		mes "未来还有许多可能。";
		mes "请珍惜自己的选择。";
		mes "谢谢聆听。";
		mes "祝你好运。";
		break;

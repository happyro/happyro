mora,52,138,5	script	Mungmung#p	516,{
	mes "[梦梦]";
	mes "我不是旅馆老板！";
	mes "为什么人们一看到我就想付钱？";
	close;
}

mora,160,123,3	script	Nemnem#p	517,{
	mes "[内姆内姆]";
	mes "自从彩虹桥出现裂缝后，";
	mes "我的痛苦越来越严重。";
	mes "年轻人，是你造成的吗？";
	next;
	switch(select("当然是我！:这是不公平的指责！")) {
	case 1:
	mes "[内姆内姆]";
		mes "好~样的！";
		emotion ET_COOL;
		close;
	case 2:
	mes "[内姆内姆]";
		mes "如果不是，那就算了！";
		emotion ET_PROFUSELY_SWEAT, playerattached();
		close;
	}
}

mora,105,104,3	script	Boaster#podo	514,{
	mes "[吹嘘者]";
	mes "所以情况";
	mes "糟糕到了极点。";
	next;
	mes "[拉弗莱西亚]";
	mes "哦~！";
	next;
	mes "[吹嘘者]";
	mes "我无聊得要命，开始哭起来。";
	mes "哭累后，我就睡着了。";
	mes "醒来之后，";
	mes "我比之前";
	mes "更加无聊了！";
	next;
	mes "[拉弗莱西亚]";
	mes "哦，哦！";
	mes "太糟糕了，真是太糟糕了。";
	mes "怎么会发生这种事？！";
	next;
	mes "[吹嘘者]";
	mes "所以情况变得";
	mes "越来越严重了……";
	mes "现在再给我一些硬币。";
	emotion ET_PROFUSELY_SWEAT, playerattached();
	close;
}


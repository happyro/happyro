				mes "尽快完成项目。再次感谢你的帮助。";
				close2;
				cutin "",255;
				end;
			}
			cutin "hu_alex02.bmp",2;
			mes "[Alex]";
			mes "嗯？哦，这些黑暗符文不够。";
			mes "我让你带 5 个来……";
			close2;
			cutin "",255;
			end;
		}
	} else if (hg_odin == 6) {
		cutin "hu_alex02.bmp",2;
		mes "[Alex]";
		mes "……可恶！我好像算错了。也许我真的需要更多。";
		mes "我该怎么办？那个灰发老太婆在想什么？嗯……";
		next;
		emotion ET_HUK;
		cutin "hu_alex03.bmp",2;
		cutin "hu_alex01.bmp",2;
		mes "[Alex]";
		mes "哦、哦！我不知道你在那里！";
		mes "你、你没听到什么奇怪的事吧？哈哈哈哈哈哈！";
		close2;
		cutin "",255;
		end;
	} else if (hg_odin > 11 && hg_odin < 17) {
		cutin "hu_alex03.bmp",2;
		mes "[Alex]";
		mes "什么？那个灰发老太婆给你兼职，却不给报酬？";
		next;
		mes "[Alex]";
		mes "她真无耻！我们没多少钱支付志愿者，";
		mes "但至少应该给他们点东西！她怎么能这样？！";
		mes "哦，呃，先自我介绍一下。";
		next;
		cutin "hu_alex01.bmp",2;
		mes "[Alex]";
		mes "我是亚历克斯·赫尔穆特，负责这次探险。";
		mes "看到那边的家伙了吗？那是我的弟弟朱利安，也在参与挖掘。";
		next;
		cutin "hu_alex02.bmp",2;
		mes "[Alex]";
		mes "作为行动主管，我很惭愧地说挖掘进度落后了。";
		mes "要是隔壁没有那个灰发老太婆就好了！";
		next;
		mes "[Alex]";
		mes "我根本无法和她共事！她善于操纵、贪婪、自私又两面三刀！";
		mes "她来这里一定另有原因……！";
		close2;
		cutin "",255;
		end;
	} else {
		cutin "hu_alex02.bmp",2;
		mes "[Alex]";
		mes "嗯？你需要什么吗？抱歉，我现在帮不了你。";
		mes "我很忙，只想独处一会儿。";
		close2;
		cutin "",255;
		end;
	}
}

hu_in01,14,11,4	script	Laura	70,{
	if (!hg_odin) {
		cutin "hu_laura02.bmp",2;
		mes "[Laura]";
		mes "嗯？你在这里做什么？阿什，阿什！把这个人赶出去！";
		close2;
		cutin "",255;
		warp "hu_in01",15,76;
		end;
	} else if (hg_odin == 1) {
		cutin "hu_laura04.bmp",2;
		mes "[Laura]";
		mes "嗯？哦，你一定是看到我们的招募公告来的，对吧？";
		if (BaseLevel < 60) {
			cutin "hu_laura01.bmp",2;
			mes "让我看看你……哦，你瘦得皮包骨！";
			mes "我不能用你这样的人。";
			close2;
			cutin "",255;
			end;
		}
		mes "我是劳拉·劳伦斯，卢恩-米德加尔兹王国奥丁神殿探险队代表。";
		next;
		mes "[Laura]";
		mes "我的助手阿什·米尔顿就在那边。";
		mes "阿什，打个招呼。";
		next;
		emotion ET_SMILE, getnpcid(0, "Ashe");
		mes "[Ashe]";
		mes "你好！";
		next;
		mes "[Laura]";
		mes "如你所知，我们来这里是为了发掘奥丁神殿的遗物。";
		mes "不过神殿里有强大的生物，像我这样的弱女子无法击败。";
		next;
		cutin "hu_laura01.bmp",2;
		mes "[Laura]";
		mes "你忍心让我这样的柔弱女子独自进去吗？";
		mes "像你这样的人必须替我进去。所以才发布了招募公告。";
		next;
		mes "[Laura]";
		mes "我们实际上无法支付报酬。事实上，我们什么都给不了你。";
		mes "但你是在为自己的国家卢恩-米德加尔兹王国提供巨大帮助。";
		next;
		cutin "hu_laura04.bmp",2;
		mes "[Laura]";
		mes "好好想想！你会做出巨大贡献，帮助我们了解神明向人类显现的时代！";
		next;
		switch(select("算了，忘了吧。:好，我来做！")) {
		case 1:
			cutin "hu_laura01.bmp",2;
			mes "[Laura]";
			mes "等、等等！想想了解神明时代的重要性！";
			mes "如果你不帮我们，还有谁会帮？我们需要共同创造更美好的未来，对吧？";
			next;
			if(select("但你不能付我报酬。:好吧，我来做。") == 1) {
				cutin "hu_laura04.bmp",2;
				mes "[Laura]";
				mes "你说得对。就像我之前说的，我没有东西可以付给你。";
				mes "...............................";
				next;
				cutin "hu_laura01.bmp",2;
				mes "[Laura]";
				mes "可恶！如果项目资金更多，我们就不用靠这种寒酸的招募广告，";
				mes "也能雇到隔壁那些施瓦茨瓦尔德共和国的富家子弟一样的专业人员了！";
				next;
				cutin "hu_laura02.bmp",2;
				mes "[Laura]";
				mes "好吧，是否为我们工作由你决定。";
				mes "只是我很失望，像你这样的人竟然不愿帮忙。";
				mes "你难道一点爱国心都没有吗？";
				close2;
				cutin "hu_laura02.bmp",255;
				end;
			}
			// Allow fall-through into the next case statment as this is a minor bug in aegis.
			//break;
		case 2:
			mes "[Laura]";
			mes "太好了！首先你要去神殿调查区域。";
			mes "去和船夫交谈，他会带你过去，好吗？快去快回！";
			set hg_odin,12;
			setquest 11003;
			close2;
			cutin "hu_laura04.bmp",255;
			end;
		}
	} else if (hg_odin > 1 && hg_odin < 6) {
		mes "["+strcharinfo(0)+"]";
		mes "不好意思，你们在这里做什么？";
		next;
		cutin "hu_laura04.bmp",2;
		mes "[Laura]";
		mes "我们在做什么……？这里是神殿探险队办公室。";
		mes "我们代表卢恩-米德加尔兹王国研究奥丁神殿发现的遗物。";
		next;
			switch(select("关于亚历克斯和朱利安:好，我明白了。")) {
		case 1:
			cutin "hu_laura01.bmp",2;
			mes "["+strcharinfo(0)+"]";
			mes "隔壁房间的亚历克斯和朱利安，";
			mes "也在参加奥丁神殿的探险吗？";
			next;
			cutin "hu_laura02.bmp",2;
			mes "[Laura]";
			mes "……哦。你一定是在工作";
			mes "不过那是施瓦茨瓦尔德共和国有钱孩子的办公室。";
			mes "我根本无法和那个无礼的女孩共事，所以我们分开办公。";
//

			next;
			cutin "hu_laura04.bmp",2;
			mes "[Laura]";
			mes "抱歉，自我介绍一下。我是劳拉·劳伦斯，卢恩-米德加尔兹王国奥丁神殿探险队队长。";
			mes "阿什·米尔顿是这次挖掘的助手。";
			next;
			emotion ET_SMILE, getnpcid(0, "Ashe");
			mes "[Ashe]";
			mes "你好！";
			next;
			mes "[Laura]";
			mes "如果你更愿意为国家效力，不想再为那些有钱的自大鬼工作，";
			mes "就回这里告诉我。";
			close2;
			cutin "hu_laura04.bmp",255;
			end;
		case 2:
			cutin "hu_laura01.bmp",2;
			mes "[Laura]";
			mes "......";
			mes ".........";
			mes "............";
			close2;
			cutin "hu_laura01.bmp",255;
			end;
		}
	} else if (hg_odin == 6) {
		cutin "hu_laura04.bmp",2;
		mes "[Laura]";
		mes "嘿，我认识你……你是隔壁办公室探险队的志愿者，对吧？";
		mes "你来得正好。不如暂时帮帮我们？";
		next;
		cutin "hu_laura01.bmp",2;
		mes "[Laura]";
		mes "简单说，我要你监视那个自大的女孩，施瓦茨瓦尔德共和国办公室的亚历克斯，";
		mes "把她实际在做什么报告给我。";
		next;
		cutin "hu_laura03.bmp",2;
		mes "[Laura]";
		mes "我必须知道……我需要知道他们是否已经发现‘那件东西’。";
		mes "他们不可能先于我们找到它，绝不可能！";
		next;
		cutin "hu_laura04.bmp",2;
		mes "[Laura]";
		mes "总之，把耳朵贴近施瓦茨瓦尔德办公室的门，偷听他们的谈话。你愿意做吗？";
		next;
		cutin "hu_laura02.bmp",2;
		mes "[Laura]";
		mes "...............................";
		mes "当然，你会做的。对吧？";
		next;
		cutin "hu_laura03.bmp",2;
		mes "[Laura]";
		mes "对吧？！";
		next;
		select("好吧好吧，随便。:没问题。:我、我想……！:是，女士！");
		set hg_odin,17;
		completequest 11002;
		setquest 11006;
		cutin "hu_laura04.bmp",2;
		mes "[Laura]";
		mes "很好。现在就去做！";
		close2;
		cutin "hu_laura04.bmp",255;
		end;
	} else if (hg_odin == 12) {
		cutin "hu_laura02.bmp",2;
		mes "[Laura]";
		mes "让船夫带你去奥丁神殿亲自看看。";
		mes "如果你觉得无法应付探险，告诉我就行。";
		close2;
		cutin "hu_laura02.bmp",255;
		end;
	} else if (hg_odin == 13) {
		cutin "hu_laura04.bmp",2;
		mes "[Laura]";
		mes "你已经去过奥丁神殿了吗？";
		mes "我知道那里很可怕，但为了人类的未来，我们必须完成研究。";
		next;
		select("好吧好吧，随便。:我明白了。:您说得对，女士。 ");
		mes "[Laura]";
		mes "那么，你在那里的时候找到什么了吗？";
		next;
		switch(select("杰勒比。:没有。")) {
		case 1:
			cutin "hu_laura01.bmp",2;
			mes "[Laura]";
			mes "杰勒比到处都能找到！";
			mes "我是问你在神殿里有没有发现特别的东西！";
			next;
			break;
		case 2:
			cutin "hu_laura01.bmp",2;
			mes "[Laura]";
			mes "好吧，没关系。";
			mes "我只是让你到处看看，所以没指望你带什么回来。";
			next;
			break;
		}
		cutin "hu_laura04.bmp",2;
		mes "[Laura]";
		mes "总之，你还愿意帮我们吗？我知道说过不能付你报酬，";
		mes "但公平起见，我可以从特别收藏中给你一些东西。怎么样？";
		next;
		switch(select("隔壁房间的人是谁？:嗯……:好！")) {
		case 1:
			cutin "hu_laura01.bmp",2;
			mes "[Laura]";
			mes "哦，他们是施瓦茨瓦尔德共和国的奥丁神殿探险代表。";
			mes "我个人认为他们只是一群有钱的骗子。";
			next;
			cutin "hu_laura03.bmp",2;
			mes "[Laura]";
			mes "还有那个叫亚历克斯的女孩……";
			mes "她看似有礼貌，却总是用鄙视的眼神看人，";
			mes "还带着假笑和我打招呼。我讨厌她！";
			next;
			emotion ET_PROFUSELY_SWEAT, getnpcid(0, "Ashe");
			mes "[Ashe]";
			mes "劳伦斯女士……！请住口！听你这样谈论同事真让人尴尬。";
			next;
			mes "[Laura]";
			mes "同、同事？！才不是！我鄙视那个被宠坏的孩子，";
			mes "她不配拥有那个职位，肯定是她有钱的爸爸买来的！哼！";
			mes "晚点再来，我气死了！";
			close2;
			cutin "hu_laura03.bmp",255;
			end;
		case 2:
			mes "[Laura]";
			mes "如果你改变主意，也许为我工作不是好主意。";
			mes "我相信应该听从直觉，你知道吗？";
			close2;
			cutin "hu_laura04.bmp",255;
			end;
		case 3:
			set hg_odin,14;
			changequest 11003,11004;
			mes "[Laura]";
			mes "这正是我想听的！好吧，请从奥丁神殿带回^3355FF5 个黑暗符文^000000。现在就去，冒险者～";
			close2;
			cutin "hu_laura04.bmp",255;
			end;
		}
	} else if (hg_odin == 14) {
		cutin "hu_laura02.bmp",2;
		mes "[Laura]";
		mes "嗯？你不是有任务要做吗？怎么还在这里？";
		next;
		switch(select("我应该收集什么？:别担心，我这就走。")) {
		case 1:
			mes "[Laura]";
			mes "你应该带给我^3355FF5 个黑暗符文^000000。";
			mes "这次可别忘了！";
			close2;
			cutin "hu_laura02.bmp",255;
			end;
		case 2:
			mes "[Laura]";
			mes "如果可以就快点。因为要和隔壁办公室那些傲慢的富家子弟合作，我已经落后进度了。^333333*叹气……*^000000";
			close2;
			cutin "hu_laura02.bmp",255;
			end;
		}
	} else if (hg_odin == 15) {
		cutin "hu_laura04.bmp",2;
		mes "[Laura]";
		mes "哦，你回来了。你带来的黑暗符文在哪里？";
		next;
		switch(select("呃，我还没有……:就在这里！")) {
		case 1:
			cutin "hu_laura03.bmp",2;
			mes "[Laura]";

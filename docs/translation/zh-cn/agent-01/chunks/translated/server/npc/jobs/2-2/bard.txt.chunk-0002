			next;
			set .@selection,select("请直接帮我转职吧。:如果能给我礼物，我会很感激。");
		}
		if ((.@selection == 1) || (BARD_Q == 5)) {
			if(SkillPoint) {
				cutin "job_bard_aiolo01",2;
				mes "[Lalo]";
				mes "啊……一切都很好，";
				mes "但你还有剩余技能点。去学习剩余技能后再回来。";
				next;
				mes "[Lalo]";
				mes "我要送你一份小礼物……";
				mes "带些树枝来吧。种类不限，";
				mes "但必须是同一种 60 根……";
				close2;
				cutin "job_bard_aiolo01",255;
				end;
			}
			else {
				switch(BARD_Q) {
				case 5:
					if(countitem(1019) > 59) callsub S_ChangeJob,1019,1901;
					else if(countitem(1068) > 59) callsub S_ChangeJob,1068,1903;
					else if(countitem(1067) > 59) callsub S_ChangeJob,1067,1903;
					else if(countitem(1066) > 59) {
						if(JobLevel > 49) callsub S_ChangeJob,1066,1910;
						else callsub S_ChangeJob,1066,1905;
					}
					cutin "job_bard_aiolo01",2;
					mes "[Lalo]";
					mes "嗯？看来你还没准备好所有树枝？";
					mes "你还是想直接转职吗？";
					next;
					if (select("是的，直接帮我转职吧。:不，我去准备树枝。") == 2)
						break;
				default:
					completequest 3003;
					callfunc "Job_Change",Job_Bard;
					callfunc "F_ClearJobVar";		//clears all job variables for the current player
					mes "[Lalo]";
					mes "很好！希望你唱出快乐动听的歌曲。";
					mes "像风与云一样生活吧！";
					next;
					mes "[Lalo]";
					mes "下次再见！";
					close2;
					cutin "job_bard_aiolo01",255;
					end;
				}
			}
		}
		changequest 3003,3004;
		mes "[Lalo]";
		mes "嗯……很好，请带些树枝来。";
		mes "种类不限，但必须是同一种 60 根……";
		next;
		mes "[Lalo]";
		mes "带来后我会送你一份礼物。";
		mes "旅途平安。";
		close2;
		cutin "job_bard_aiolo01",255;
		end;
	}
	cutin "job_bard_aiolo01",2;
	mes "[Lalo]";
	mes "呜~呜~呜~";
	close2;
	cutin "job_bard_aiolo01",255;
	end;

S_ChangeJob:
	completequest 3004;
	callfunc "Job_Change",Job_Bard;
	callfunc "F_ClearJobVar";
	mes "[Lalo]";
	mes "干得好。我会用这个制作转职纪念品。";
	mes "请稍等片刻。";
	next;
	mes "[Lalo]";
	mes "^3355FFScrape Scrape Tang Tang^000000";
	mes "^3355FFSqueak Squeak Scratch Scratch^000000";
	delitem getarg(0),60;
	getitem getarg(1),1;
	next;
	mes "[Lalo]";
	mes "给你，这是纪念品。唱歌时很有用。";
	mes "希望你唱出快乐的歌曲。";
	next;
	mes "[Lalo]";
	mes "下次再见！";
	close2;
	cutin "job_bard_aiolo01",255;
	end;
}


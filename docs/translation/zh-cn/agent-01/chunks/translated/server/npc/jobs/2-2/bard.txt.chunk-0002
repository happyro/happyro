			mes "[Lalo]";
			mes "太棒了！一次就完成！";
			mes "你可以成为优秀的诗人。";
			next;
			mes "[Lalo]";
			mes "嗯……看来你不会成为诗人。";
			mes "可是我想送你";
			mes "纪念品……";

				if(countitem(7301) < 1887 && @lhzhatfailed == 0)
				{
					mes "[Morris]";
					mes "放大镜，确认。";
					mes "流苏不够？确认。";
					set @lhzhatfailed,1;
					next;
				}
				if(countitem(5120) < 1 && @lhzhatfailed == 0)
				{
					mes "[Morris]";
					mes "放大镜，确认。";
					mes "流苏……确认。";
					mes "嗯，你缺少带洞的渔夫帽。";
					mes "就差一点了……";
					set @lhzhatfailed,1;
					next;
				}
				if(Zeny < 1887 && @lhzhatfailed == 0)
				{
					mes "[Morris]";
					mes "放大镜，确认。";
					mes "流苏……确认。";
					mes "带洞渔夫帽，确认。";
					mes "嘿，Zeny呢？！";
					mes "那可是最重要的，呃，资格条件！";
					set @lhzhatfailed,1;
					next;
				}
				if(@lhzhatfailed == 1)
				{
					mes "[Morris]";
					mes "^333333*叹气*^000000你需要^0000FF10个放大镜^000000、^0000FF1887个流苏^000000、^0000FF1顶带洞渔夫帽^000000和^0000FF1,887 Zeny^000000。就这些！";

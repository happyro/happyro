				mes "这是你的知名侦探帽，";
				mes "参加俱乐部活动并宣传时，请自豪地戴着它！";
				delitem 7301,1887;
				delitem 5120,1;
				delitem 611,10;
				set Zeny, Zeny - 1887;
				set DTHATQ,2;
				getitem 5108,1;
				next;
					switch( select( "等等，宣传？", "万岁！" ) )
				{
					case 1:
						mes "[Morris]";
						mes "当然，这不是很明显吗？";
						mes "作为会员，你的职责之一就是赞美俱乐部，";
						mes "让更多人加入并获得自己的知名侦探帽。";
						next;
						mes "[Morris]";
						mes "好了，快去向所有朋友自豪地展示你这顶时髦的新知名侦探帽吧！";
						close;
					case 2:
						mes "[Morris]";
						mes "好了，快去向所有朋友自豪地展示你这顶时髦的新知名侦探帽吧！";
						close;
				}
			case 2:
				mes "[Morris]";
				mes "嗯，你刚刚没通过“尊重测试”。";
				mes "你不配获得佩戴知名侦探帽的荣誉！";
				close;
		}
	}
	else if(DTHATQ == 2)
	{
		mes "[Morris]";
		mes "你是来再获得一顶知名侦探帽的吗？";
		mes "我知道这种时髦头饰很受欢迎。";
		next;
		mes "[Morris]";
		mes "记住，千万不要带来精炼过或插过卡的^FF0000带洞渔夫帽^000000，";
		mes "否则那些强化效果会消失^000000。";
		next;
		mes "[Morris]";
		mes "作为青年侦探俱乐部的骄傲会员，";
		mes "你带齐获得知名侦探帽所需的一切了吗？";
		next;
		switch( select( "我不确定～", "当然！" ) )
		{
			case 1:
				mes "[Morris]";
				mes "什么……？！优秀的侦探必须拥有过目不忘的记忆力，";
				mes "能够回忆细节来破解案件。";
				emotion ET_CRY;
				next;
				mes "[Morris]";
				mes "记住……^0000FF10个放大镜^000000、^0000FF1887个流苏、^0000FF1顶带洞渔夫帽^000000和^0000FF1,887 Zeny^000000。好吗？";
				close;
			case 2:
				mes "[Morris]";
				mes "太好了！现在让我检查你是否带齐了……";
				next;
				set @lhzhatfailed,0;
				if(countitem(611) < 10)
				{
					mes "[Morris]";
					mes "嗯，你的放大镜不够？那可是侦查必不可少的工具。";
					mes "快带着它们回来！";
					set @lhzhatfailed,1;
					next;
				}
				if(countitem(7301) < 1887 && @lhzhatfailed == 0)
				{
					mes "[Morris]";
					mes "放大镜，确认。";
					mes "流苏不够？确认。";
					set @lhzhatfailed,1;
					next;
				}
				if(countitem(5120) < 1 && @lhzhatfailed == 0)
				{
					mes "[Morris]";
					mes "放大镜，确认。流苏……确认。";
					mes "嗯，你缺少带洞的渔夫帽。就差一点了……";
					set @lhzhatfailed,1;
					next;
				}
				if(Zeny < 1887 && @lhzhatfailed == 0)
				{
					mes "[Morris]";
					mes "放大镜，确认。流苏……确认。带洞渔夫帽，确认。";
					mes "嘿，Zeny呢？！那可是最重要的，呃，资格条件！";
					set @lhzhatfailed,1;
					next;
				}
				if(@lhzhatfailed == 1)
				{
					mes "[Morris]";
					mes "记住……";
					mes "^0000FF10 Magnifiers^000000,";
					mes "^0000FF1887 Tassels^000000,";
					mes "^0000FF1 Slotted Bucket Hat^000000";
				mes "以及^0000FF1,887 Zeny^000000。好吗？";
					emotion ET_FRET;
					close;
				}
				mes "[Morris]";
				mes "放大镜，确认。流苏……确认。带洞渔夫帽，确认。还有 Zeny。嘿嘿，完美。";
				next;
				mes "[Morris]";
				mes "太好了！你已经有资格再获得一顶知名侦探帽。恭喜！现在让我收取这些材料和 Zeny……";
				delitem 7301,1887;
				delitem 5120,1;
				delitem 611,10;
				set Zeny, Zeny - 1887;
				set DTHATQ,2;
				getitem 5108,1;
				next;
				mes "[Morris]";
				mes "哈哈哈！这才是我们初级黄金会员应有的表现！";
				mes "成为精英中的精英感觉如何？很棒吧？";
				close;
		}
	}

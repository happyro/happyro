lighthalzen,360,313,3	script	Kid#LhzHat	706,{
	mes "[Kid]";
	if(Sex == SEX_MALE)
		mes "你好，先生！";
	else
		mes "你好，女士！";
	mes "呃，可以请你帮个忙吗？";
	next;
	if(countitem(526) && countitem(7270) && countitem(941) && countitem(10004))
	{
		mes "[Kid]";
		mes "哦！你带来了蜂王浆给我吃，还有制作婴儿奶嘴所需的一切。";
		mes "好，我马上开始。请稍等……";
		next;
		mes "...";
		mes "......";
		next;
		mes "[Kid]";
		mes "天啊。";
		mes "蜂王浆真是太好吃了！";
		mes "现在我可以制作你的婴儿奶嘴了。让我看看……好了，开始吧……";
		next;
		mes "[Kid]";
		mes "完成了！";
		mes "现在你就是自己婴儿奶嘴的自豪拥有者了！";
		mes "希望你满意。旅途注意安全，好吗？";
		delitem 526,1;
		delitem 7270,1;
		delitem 941,1;
		delitem 10004,1;
		getitem 5110,1;
		close;
	}
	switch( select( "What do you need?", "Sorry, kid..." ) )
	{
		case 1:
			mes "[Kid]";
		mes "我妈妈最近生病了，所以我们已经好几天没吃东西。";
		mes "但她不吃饭的话，怎么能好起来呢？";
			emotion ET_CRY;
			next;
			mes "[Kid]";
		mes "所以我想问，你能分给我们一些食物吗？";
			next;
			switch( select( "Help him.", "Refuse to help." ) )
			{
				case 1:
					if(!countitem(526))
					{
						mes "[Kid]";
					mes "如果可以的话，你能找些蜂王浆给我妈妈吗？";
					mes "隔壁老太太说蜂王浆很有营养，生病时能帮助更快恢复。";
						next;
						mes "[Kid]";
					mes "妈妈知道我乞求蜂王浆一定会生气，";
					mes "但蜂王浆太贵了，没有帮助我根本买不起！";
						close;
					}
					mes "[Kid]";
				mes "哦，我可以拿这份蜂王浆吗？";
				mes "它真的能帮助妈妈好起来。太谢谢你了～";
					delitem 526,1;
					next;
					mes "[Kid]";
				mes "嘿，为了报答你，我给你做一个婴儿奶嘴吧？";
				mes "弟弟出生时我学会了制作方法。";
				mes "不过首先需要一些材料……";
					next;
					mes "[Kid]";
				mes "请带来^3131FF1个奶瓶、1个鼻环和1个奶嘴^000000。";
				mes "哦，还要再带一份^3131FF蜂王浆^000000给我～";
					close;
				case 2:
					mes "[Kid]";
				mes "哦……呃，没关系。也许我对你要求太多了。";
				mes "毕竟你几乎不认识我……";
					emotion ET_CRY;
					close;
			}
		case 2:
			mes "[Kid]";
		mes "没、没关系。";
		mes "你一定很忙，甚至没时间听一个小男孩的烦恼……";
			emotion ET_CRY;
			close;
	}
}

einbech,70,222,5	script	Metelle#LhzHat	91,{
	if(countitem(983) && countitem(7267) > 998 && countitem(749) && Zeny > 49999)
	{
		mes "[Metelle]";
		mes "哦，你好，这是什么？";
		mes "你带着1个黑色染料、1朵冰冻玫瑰、999条虎纹内裤，甚至还有50,000 Zeny。";
		mes "这些足够制作冬帽了……";
		next;
		mes "[Metelle]";
		mes "呃，你介意把这些物品给我，让我制作冬帽吗？";
		mes "我自己永远收集不到这些东西……";
		next;
		switch( select( "把物品给她。", "不给她物品。" ) )
		{
			case 1:
				mes "[Metelle]";
				mes "哦，太谢谢你了！";
				mes "我一直想做这顶帽子并戴一次。别担心，我会把它给你～";
				mes "现在请稍等片刻……";
				next;
				mes "[Metelle]";
				mes "让我看看……";
				mes "玫瑰要这样折……";
				mes "小心染料……";
				mes "我把那些平底锅放哪儿了……哦，在这里。";
				next;
				mes "[Metelle]";
				mes "^333333*Whew!*^000000";
				mes "终于完成了！";
				mes "如果你不介意，让我戴一会儿这顶帽子。";
				delitem 983,1;
				delitem 7267,999;
				delitem 749,1;
				set Zeny,Zeny - 50000;
				getitem 5115,1;
				next;
				mes "...";
				mes "......";
				next;
				mes "[Metelle]";
				mes "啊啊啊～";
				mes "感觉……";
				mes "我感到无比自由～";
				mes "和我想象的一模一样。";
				next;
				mes "[Metelle]";
				mes "给你，请收下这顶冬帽。";
				mes "希望你能像我一样喜欢它。";
				mes "好了，旅途注意安全，好吗？";
				close;
			case 2:
				mes "[Metelle]";
				mes "抱歉，我知道自己向刚认识的人提出了很大的请求。";
				mes "希望你能理解我有多想做那顶冬帽……";
				close;
		}
	}
	mes "[Metelle]";
	mes "看看那片蓝天。你不想用自己的翅膀在天空翱翔吗？";
	next;
	mes "[Metelle]";
	mes "当然，这是不可能实现的梦想，";
	mes "但戴上这顶冬帽，至少能享受飞鸟翱翔时感受到的自由。";
	next;
	mes "[Metelle]";
	mes "如果你想要这样的帽子，";
	mes "我需要一些靠自己永远无法获得的物品。";
	next;
	mes "[Metelle]";
	mes "^FF00001 个黑色染料^000000、";
	mes "^FF0000999 条虎纹内裤^000000、";
	mes "^FF00001 朵冰冻玫瑰^000000和";
	mes "^FF000050,000 Zeny^000000。只要你能";
	mes "把它们带给我，我就为你制作冬帽。";
	close;

}

lhz_in02,91,38,5	script	Margaret Mary#LhzHat	90,{

	mes "[Margaret Mary]";
	mes "白玫瑰纯洁而朴素，就像不需要珠宝或华服也能显得高贵美丽的女士。它是送给女士的完美礼物。";
	next;
	switch( select( "Make a Mystic Rose.", "End Conversation." ) )
	{
		case 1:
			if(countitem(731) > 9 && countitem(748) > 2 && countitem(982) && Zeny > 49999)
			{
				mes "[Margaret Mary]";

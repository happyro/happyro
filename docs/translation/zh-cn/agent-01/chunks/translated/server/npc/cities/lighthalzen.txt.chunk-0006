lighthalzen,192,63,4	script	Sergei#zen1	92,{
mes "[Sergei]";
	mes "你知道吗？那边挂着的斧头";
	mes "有一个有趣的故事。";
	mes "想听我讲讲吗？";
	next;
	if (select("好啊。:不用了，谢谢。") == 1) {
	mes "[Sergei]";
	mes "这家武器店的前任老板";
	mes "是个被定罪的连环杀手。";
		mes "他每晚都会拿起那把斧头，";
		mes "残忍地杀害像我这样的";
		mes "美丽女士。";
		next;
		mes "[Sergei]";
		mes "他终于被抓住后，";
		mes "人们用他自己的斧头砍下了他的头。";
		mes "从那以后，据说他的鬼魂";
		mes "仍在这里徘徊，";
		mes "每晚磨利这把斧头。";
		next;
		mes "[Sergei]";
		mes "光是想想就让我起鸡皮疙瘩！";
		mes "而我还得在这里工作！";
		mes "太可怕了！";
		close;
		}
		mes "[Sergei]";
		mes "哦，真令人失望~";
		mes "这可是应景的完美故事。";
		mes "不过仔细想想，";
		mes "那个故事确实挺恐怖的……";
	close;
	}
	

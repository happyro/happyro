	lighthalzen,40,107,4	script	Vergil#zen4	869,{
	mes "[Vergil]";
	mes "今天天气一如既往地好。";
	mes "我真想翘班，";
	mes "跑到外面锻炼。";
	next;
	switch(select("你想去哪儿？:但你不是该去上班吗？:你听说过那个连环杀手吗？")) {
	case 1:
	mes "[Vergil]";
	mes "嗯，那些穿黑西装的家伙，";
mes "还有偶尔闯进城里的暴徒，";
mes "有时会让一个人出门";
mes "变得不太安全。";
	next;
	mes "[Vergil]";
	mes "不过我和朋友打算找天去";
	mes "艾尔帕兰 Turbo Track。";
	mes "上次去的时候，";
	mes "他浪费了好多 Zeny。";
	next;
	mes "[Vergil]";
		mes "他赢到了一种药水作为奖品，";
		mes "还给了我。我喝下后动作";
		mes "变得特别慢。这样的奖品";
		mes "到底算什么啊？！";
		next;
		mes "[Vergil]";
		mes "我觉得我朋友完全被骗了。";
		mes "或者是他骗我喝下去的。";
		mes "他们怎么会想出这么荒唐的奖品！";
		close;
		case 2:
		mes "[Vergil]";
		mes "什——？！我没说要翘班，";
		mes "只是说我想翘！";
		mes "不过为了气你，";
		mes "也许我今天真的不去了！";
		next;
		mes "[Vergil]";
		mes "话说回来，这个项目";
		mes "可不能偷懒。可恶……";
		mes "周末来得也太慢了！";
		close;
		case 3:
		mes "[Vergil]";
		mes "你是说很久以前那个斧头杀人犯？";
		mes "我听说事情其实不是那样。";
		mes "让我想想，故事是怎么说的？";
		next;
		mes "[Vergil]";
		mes "听说有个制作帽子的工匠，";
		mes "就是做溜溜猴帽的那位，";
	mes "不小心做出了人头帽，";
		mes "而不是用怪物制作的帽子。";
		mes "别问我是怎么回事。";
		next;
		mes "[Vergil]";
		mes "对了，我想那位飞艇船长的亲属……";
		mes "他们完全是意外被做成帽子的。";
		mes "据说看起来像驯鹿头，";
		mes "但这也太奇怪了。";
		close;
		}
		}
		

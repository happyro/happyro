	mes "[Diana]";
	mes "嗯……？！";
	mes "太离谱了！";
	mes "别管那个，让我看看";
	mes "角落里的那把长剑。";
	next;
	mes "[Shop Assistant]";
	mes "长剑？";
	mes "啊，那把要";
	mes "39,800 Zeny，女士。";
	next;
	mes "[Diana]";
	mes "哦，价格真不错。";
	mes "我买了！";
	next;
	mes "[Shop Assistant]";
	mes "是的，这把仿制品看起来";
	mes "确实和真正的长剑一模一样，";
	mes "不是吗？虽然不是真武器，";
	mes "但用来拆开最结实的信封";
	mes "也绰绰有余。";
	next;
	mes "[Diana]";
	mes "...";
	mes "......";
	mes "我收回刚才的话。";
	mes "这家店真差劲。";
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	close;
}


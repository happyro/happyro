function	script	Guard_13_1	{
	mes "[Guard]";
	if (ep13_ryu > 19) {
		mes "不许进入。你们都被要求前往卢恩·米德加尔特的次元时间缝隙！";
		next;
		mes "[Guard]";
		mes "去那里吧。这是限制区域。";
		close2;
		warp "lhz_in01",getarg(1),getarg(2);
		end;
	}
	if (ep13_ryu > 8) {
		mes "你是来登记成为三王国成员的吗？";
		next;
		mes "[Guard]";
		mes "进去吧。";
		close;
	}
	else {
		mes "不许进入。";
		if (!getarg(0)) close;
		close2;
		warp "lhz_in01",getarg(1),getarg(2);
		end;
	}
	end;
}


lhz_in01,32,22,3	script	Officer A	109,{
	if (ep13_ryu == 20) {
		mes "[Officer]";
		mes "你为什么不回去？害怕回去吗？呵呵呵！";
		next;
		mes "[Officer]";
		mes "回会议室吧。你的盟友都在那里。呵呵呵！算了，再见。";
		close;
	}
	if (ep13_ryu == 19) {
		mes "[Officer A]";
		mes "那你为什么来找我？怎么了？";
		next;
		mes "[Officer B]";
		mes "有什么事吗？";
		next;
		mes "[Officer A]";
		mes "我想没有。你是来告诉我你要出发执行任务，对吗？";
		next;
		mes "[Officer B]";
		mes "你是西卡兹派来的……对吧？";
		next;
		mes "[Officer A]";
		mes "好，我收到你的报告了。回去吧，祝你好运。";
		next;
		mes "[Officer B]";
		mes "尽力而为";
		mes "……或者做你想做的事……";
		next;
		changequest 10075,10076;
		set ep13_ryu,20;
		mes "[Officer A]";
		mes "回那里去吧。干得好。";
		close;
	}
	if (ep13_ryu == 18) {
		mes "[Officer A]";
		mes "西卡兹真让人无法理解……我也没办法……";
		next;
		mes "[Officer B]";
		mes "他的和平之声只是他自己的方式。三王国为一个使命……没有和平……我们甚至得不到好处。";
		next;
		mes "[Officer A]";
		mes "不能让他们继续这样。虽然我是他们中的首领，却只是个傀儡。";
		next;
		mes "[Officer A]";
		mes "有没有办法改变他们？";
		next;
		mes "[Officer B]";
		mes "如果他们改变，我们就不会惹上麻烦。但他不肯妥协。";
		next;
		mes "[Officer A]";
		mes "那又怎样？我们得不到利益，就什么也不为自己做吗？";
		next;
		mes "[Officer B]";
		mes "还有蒙肯罗。";
		next;
		mes "[Officer A]";
		mes "所以呢……？";
		next;
		mes "[Officer B]";
		mes "和西卡兹一样诚实……和西卡兹一样灵活……但很容易越过他……";
		next;
		mes "[Officer B]";
		mes "不能排除他，那就让蒙肯罗带头。这样更容易！";
		next;
		mes "[Officer A]";
		mes "哦！！";
		mes "好主意。总之……有访客来了。以后再谈。";
		next;
		changequest 10074,10075;
		set ep13_ryu,19;
		mes "[Officer B]";
		mes "呃，你有什么事？";
		close;
	}
	mes "[Officer A]";
	mes "为了自身利益，我们必须抛弃其他王国。";
	close;
}


			mes "-你掷出了骰子。骰子落下、旋转，最后停在那里。-";
			specialeffect2 EF_STUNATTACK;
			next;
			.@rus_dice01 = rand(1,6);
			mes "["+ .@player_name$ +"]";
			mes "让我看看……";
			next;
			emotion .@emo[.@rus_dice01], playerattached();
			mes "["+ .@player_name$ +"]";
			if (.@rus_dice01 == .@tree_dice01) {
				mes "让我看看……哇，成功了！我得到的是 ^0000ff"+ .@rus_dice01 +"^000000！";
				emotion ET_SURPRISE;
				next;
				mes "[幽灵树]";
				mes "你似乎很幸运……";
				.@rususer_score01 = 1;
			} else {
				mes "让我看看………………是 ^0000ff"+ .@rus_dice01 +" ^000000……";
				mes "[幽灵树]";
				mes "呼……";
				emotion ET_SMILE;
			}
			.@rustree_turn01++;
			next;
		}
		if (.@rususer_score01) {
			mes "[幽灵树]";
			mes "啊，我输了，不过很有趣。";
			next;
			mes "[幽灵树]";
			mes "为了这场有趣的游戏，我会遵守约定把扫帚给你。";
			next;
			mes "[幽灵树]";
			mes "你很有趣。如果可以，再和我玩一次吧。把它们拿走。";
			next;
			mes "- ^0000ff你获得了来自斐扬的上等扫帚！！^000000 - ";
			rhea_rus_main = 46;
			// changequest 8174,8175;
			close;
		}
		mes "[幽灵树]";
		mes "咯咯咯，没有人比你更差了。记住，想得到想要的东西就必须赢过我。";
		next;
		mes "["+ .@player_name$ +"]";
		mes "我才不是这样！再来一次！";
		next;
		mes "[幽灵树]";
		mes "好，再玩一次吧。准备好了吗？";
		close;
	} else if (rhea_rus_main == 46) {
		mes "[幽灵树]";
		mes "咯咯咯，你很有趣。如果可以，再和我玩一次吧。";
		close;
	}
	end;
S_Question:
	input .@input$;
	mes "["+ strcharinfo(0) +"]";
	mes ""+ .@input$ +" !!";
	next;
	return ( (.@input$ == getarg(0)) ? 1 : 0 );
}

mosk_dun01,3,3,3	script	Koshei GlobalVar#admin	4_F_RUSCHILD,{
	callfunc "F_GM_NPC";
	mes "[科谢全局变量]";
	mes "请输入密码";
	.@i = callfunc("F_GM_NPC","orchid",1);
	next;
	if (.@i == 0) {
		mes "[科谢全局变量]";
		mes "请输入完全正确的密码。";
		close;
	} else {
		mes "[科谢全局变量]";
		mes "我可以告诉你";
		mes "科谢全局变量";
		mes "$@rus_req02";
		mes "在 mosk_dun01 上";
		mes "当前设置的值。";
		next;
		if ($@rus_req02 == 0) {
			mes "[科谢全局变量]";
			mes "当前全局变量 $@rus_req02 的值为 0";
			next;
		} else if ($@rus_req02 == 1) {
			mes "[科谢全局变量]";
			mes "当前全局变量 $@rus_req02 的值为 1";
			next;
		} else {
			mes "[科谢全局变量]";
			mes "错误";
			close;
		}
		mes "[科谢全局变量]";
		mes "要将全局变量设置为什么值？";
		next;
		switch(select("0:1:取消")) {
		case 1:
			mes "[科谢全局变量]";
			mes "全局变量 $@rus_req02 现在将设置为‘0’";
			$@rus_req02 = 0;
			donpcevent "Koshei#rus47::OnDisable";
			close;
		case 2:
			mes "[科谢全局变量]";
			mes "全局变量 $@rus_req02 现在将设置为‘1’";
			$@rus_req02 = 1;
			donpcevent "Koshei#rus47::OnEnable";
		case 3:
			close;
		}
	}
}

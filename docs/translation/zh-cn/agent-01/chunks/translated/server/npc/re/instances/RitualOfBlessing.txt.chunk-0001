2@mir,88,78,2	script	Isenhonor Walther#eisen2	4_M_1STPRIN1,{
	if ('intruder_count < 3) {
		npctalk "我们没时间聊天！";
		end;
	}
	mes "[伊森霍诺]";
	mes "发生什么了……";
	mes "我们先离开这里。";

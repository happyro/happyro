ama_test,50,100,3	script	Coach#ama	762,15,15,{
	mes "[Coach]";
	mes "呵呵～很好。";
	mes "我在贵宾室看着你。你真是了不起，我非常惊讶。";
	next;
	mes "[Coach]";
	mes "我以为你就是故事里的桃太郎！呵呵呵呵……";
	next;
	switch(select("哎呀，没什么～:真无聊。")) {
	case 1:
		mes "[Coach]";
		mes "……呵呵呵……别太得意。";
		mes "我年轻时像你一样，用小拇指就能碾碎独眼怪。呵呵呵～";
		next;
		mes "[Coach]";
		mes "…………";
		mes "……别那样看我。我只是开玩笑。嗯哼。";
		next;
		changequest 8127,8128;
		mes "[Coach]";
		mes "桃太郎的故事结束了。和最初见到的出版商女士谈谈，就能领取奖励。";
		next;
		mes "[Coach]";
		mes "以后别失去自信。再见。";
		close2;
		donpcevent "Timer#ama::OnDisable";
		warp "amatsu",223,230;
		disablenpc "Coach#ama";
		donpcevent "Assistant#ama::OnReset";
		end;
	case 2:
		mes "[Coach]";
		mes ".....!!!!!!";
		mes "....Hohohoho..";
		mes "你真有趣。好吧，厉害的家伙。想听听我的提议吗？";
		next;
		changequest 8127,8129;
		mes "[Coach]";
		mes "本来现在该送你回去……但是！我很想知道你的实力。嘿嘿～呵呵呵～";
		next;
		mes "[Coach]";
		mes "所以给你一次机会。但如果失败，^3163FF就不能再次挑战。^000000而且任务会很难。";
		next;
		if (select("不用了，我没问题。:放马过来！") == 1) {
			erasequest 8129;
			mes "[Coach]";
			mes "呵呵～我理解……你一定被上一场战斗累坏了。不过那本来会是一场壮观的战斗……";
			next;
			mes "[Coach]";
			mes "桃太郎的故事结束了。和最初见到的出版商女士谈谈，就能领取奖励。";
			next;
			mes "[Coach]";
			mes "以后别失去自信。再见。";
			next;
			setquest 8128;
			warp "amatsu",223,230;
			disablenpc "Coach#ama";
			donpcevent "Timer#ama::OnDisable";
			donpcevent "Assistant#ama::OnReset";
			end;
		}
		mes "[Coach]";
		mes "呵呵呵～我喜欢你的态度。现在是最后一战！让我看看你的实力，我很期待。";
		percentheal 70,0;
		disablenpc "Coach#ama";
		donpcevent "Am Mut#ama::OnEnable";
		close;
	}

OnInit:
	disablenpc "Coach#ama";
	end;

OnTouch_:
	mes "[Coach]";
	mes "轰轰轰！！！锵锵～～～！";
	close;
}


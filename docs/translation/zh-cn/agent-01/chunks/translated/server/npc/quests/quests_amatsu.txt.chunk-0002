	else {
		set .@dokebi_tel,rand(1,4);
		if (.@dokebi_tel == 1) {
			mapannounce "ama_test","！！怪物来袭！！快跑！！",bc_map;
		}
		else if (.@dokebi_tel == 2) {
			mapannounce "ama_test","哎哟，好痛！！！",bc_map;
		}
		else if (.@dokebi_tel == 3) {
			mapannounce "ama_test","可我什么坏事都没做啊～！！",bc_map;
		}
		else if (.@dokebi_tel == 4) {
			mapannounce "ama_test","对不起～～哇啊啊～～",bc_map;
		}
	}
	end;
}


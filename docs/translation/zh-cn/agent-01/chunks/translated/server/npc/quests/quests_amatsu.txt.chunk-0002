ama_in01,162,17,1	script	Sushi Master#ama	765,{
	if (MaxWeight - Weight < 5000) {
		mes "[Magumagu]";
		mes "嘿，你看起来负重很高。走路不困难吗？抱歉，我店里没地方放你的东西。";
		next;
		mes "[Magumagu]";
		mes "先把一部分东西存起来。你为什么带这么多……呵呵呵……";
		close;
	}
	else if (ama_sushi == 4) {
		mes "[Magumagu]";
		mes "每天练习切生鱼片，就能成为寿司大师。别在这里浪费时间，去学习自己擅长的东西。";
		mes " ";
		close;
	}
	else if (fish_r == 1) {
		if (countitem(529) > 9) {
			mes "[Magumagu]";
			mes "哦！太感谢了。来得正好！我正需要它们制作甜点。";
			next;
			mes "[Magumagu]";
			mes "谢谢。虽然不是什么大事，但我会送你本店特色料理鱼片作为回礼。";
			next;
			set fish_r,0;
			erasequest 10036;
			delitem 529,10; //Candy
			getitem 544,15; //Fish_Slice
			mes "[Magumagu]";
			mes "这是15份鱼片。请和朋友一起享用。想念天津町料理的味道时，随时欢迎回来。";
			close;
		}
		mes "[Magumagu]";

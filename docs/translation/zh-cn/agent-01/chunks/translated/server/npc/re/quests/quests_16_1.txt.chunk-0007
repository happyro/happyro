		getexp 700000,700000;
		getitem 6919,10;// TokenOfHonor
		completequest 11420;// Why Should I Prepare for the Banquets?
		ep16_cookbs = 23;
		close3;
	}
	// daily
	switch( checkquest(11425,PLAYTIME) ) {
	case -1:
		if (isbegin_quest(11424) == 1) {
			mes "[Head Chef]";
		mes "现在不是磨蹭的时候！";
		mes "趁食物还没凉，赶快去餐厅！";
			cutin "ep16cook_king_1",2;
			close3;
		}
		mes "[Head Chef]";
	mes "哈哈，我一直在等你！";
		cutin "ep16cook_king_2",2;
		next;
		mes "[Head Chef]";
	mes "别浪费时间，现在就开始烹饪！";
	mes "去空位准备好。";
		cutin "ep16cook_king_1",2;
		if (isbegin_quest(11423) == 0)
			setquest 11423;// Banquet: Griffin Barbecue
		close3;
	case 0:
	case 1:
		mes "[Head Chef]";
	mes "啊！";
	mes "现在休息一下！";
		cutin "ep16cook_king_1",2;
		next;
		mes "[Head Chef]";
	mes "如果我把你逼得太紧，我也会有麻烦！";
		close3;
	case 2:
		mes "[Head Chef]";
	mes "每道菜都有最佳品尝时机，每个人也都有最适合烹饪的时间！";
		cutin "ep16cook_king_2",2;
		erasequest 11425;// Complete Today's Grilled Griffin
		close3;
	}
}

prt_cas,313,199,0	script	#ep16_1	HIDDEN_WARP_NPC,2,2,{
	end;
OnTouch:
	if (ep16_royal < 2) {
		mes "[Head Chef]";
	mes "那边的人！";
	mes "你挡路了！";
		cutin "ep16cook_king_1",2;
		close3;
	}
	if (ep16_cookbs == 13) {
		callsub S_Dish;
		erasequest 11398;// Why Should I Prepare for the Banquets?
		setquest 11399;// Why Should I Prepare for the Banquets?
		ep16_cookbs = 14;
		close3;
	}
	if (isbegin_quest(11423) == 1) {
		callsub S_Dish;
		erasequest 11423;// Banquet: Griffin Barbecue
		setquest 11424;// Banquet: Griffin Barbecue
		close3;
	}
	end;

S_Dish:
	mes "[Head Chef]";
	mes "现在……开始！";
	mes "今天的主菜是特制酱汁烤狮鹫。外皮要酥脆，里面要多汁！";
	cutin "ep16cook_king_1",2;
	next;
	mes "[Head Chef]";
	mes "因为这是宴会上的菜！";
	mes "每道菜的外观和味道都必须完全相同！别忘了！";
	next;
	mes "[Head Chef]";
	mes "仔细看我现在的做法，然后一模一样地做！";
	next;
	mes "[Head Chef]";
	mes "嘿！";
	for ( .@i = 1; .@i <= 6; .@i++ )
		npctalk "Yap!", "Chef#ep16_" + .@i;
	next;
	mes "[Head Chef]";
	mes "哼！";
	for ( .@i = 1; .@i <= 6; .@i++ )
		npctalk "Humph!", "Chef#ep16_" + .@i;
	next;
	mes "[Head Chef]";
	mes "哇！";
	for ( .@i = 1; .@i <= 6; .@i++ )
		npctalk "Whoa!", "Chef#ep16_" + .@i;
	next;
	mes "[Head Chef]";
	mes "砰！";
	for ( .@i = 1; .@i <= 6; .@i++ )
		npctalk "Bam!", "Chef#ep16_" + .@i;
	next;
	mes "[Head Chef]";
	mes "哈哈哈哈！";
	mes "优秀的 DX 烤狮鹫完成了！";
	for ( .@i = 1; .@i <= 6; .@i++ )
		npctalk "谢谢！", "Chef#ep16_" + .@i;
	next;
	mes "[Head Chef]";
	mes "现在把它送到厨房。只剩这一件事了！";
	next;
	mes "[Head Chef]";
	mes "你还在等什么！";
	mes "带着这道菜跑去餐厅！";
	next;
	mes "[Head Chef]";
	mes "皇家厨师必须尽快填满空盘子！";
	return;
}

prt_cas,319,211,3	script	Royal Sauce Master#ep16	4_M_ALCHE_B,{
	if (ep16_royal < 2) {
		mes "[Oriental Oyster]";
		mes "嗯……真香！";
		mes "完美的搭配简直神圣……";
		close;
	}
	if (ep16_cookbs == 2) {
		mes "[Oriental Oyster]";
		mes "什么？";
		mes "酱汁用完了？";
		emotion ET_SURPRISE;
		next;
		mes "[Oriental Oyster]";
		mes "糟糕了！";
		mes "要是迟到了，你不知道主厨会做什么……";
		next;
		mes "[Oriental Oyster]";
		mes "嗯……我需要赶快做酱汁。";
		mes "不好意思，可以请你帮忙吗？";
		next;
		mes "[Oriental Oyster]";
		mes "我的学徒因为踩到酱汁滑倒，被送到医务室了……";
		emotion ET_CRY;
		next;
		mes "[Oriental Oyster]";
		mes "我不能停止搅拌酱汁。听我说名字，把相应的材料带给我。";
		next;
		mes "[Oriental Oyster]";
		ep16_cookbs = 4;
		erasequest 11395;// Why Should I Prepare for the Banquets?
		setquest 11396;// Why Should I Prepare for the Banquets?
		callsub S_Sauce;
	}
	if (ep16_cookbs == 3 || ep16_cookbs == 25) {
		mes "[Oriental Oyster]";
		mes "天啊……";
		mes "材料就是酱汁的生命。";
		mes "绝对不能出错。";
		next;
		mes "[Oriental Oyster]";
		mes "那么，我们从头开始吧！";
		next;
		ep16_cookbs++;
		callsub S_Sauce;
	}
	if (ep16_cookbs == 4 || ep16_cookbs == 6 || ep16_cookbs == 8 || ep16_cookbs == 10 || ep16_cookbs == 26 || ep16_cookbs == 28 || ep16_cookbs == 30 || ep16_cookbs == 32) {
		mes "[Oriental Oyster]";
		mes "把材料带给我！";
		mes "主厨正用一双像要杀人的眼睛盯着我！";
		close;
	}
	if (ep16_cookbs == 5 || ep16_cookbs == 7 || ep16_cookbs == 9 || ep16_cookbs == 25 || ep16_cookbs == 27 || ep16_cookbs == 29 || ep16_cookbs == 31) {
		mes "[Oriental Oyster]";
mes "嗯，很好！";
		next;
		ep16_cookbs++;
		callsub S_Sauce;
	}
	if (ep16_cookbs == 11 || ep16_cookbs == 33) {
		if (ep16_cookbs == 33 && checkweight(1119,3) == 0) {
mes "- 你携带的物品太多。";
mes "请整理物品后再试。-";
			close;
		}
		mes "[Oriental Oyster]";
		mes "哦！";
		mes "很好！";
		mes "多亏了你，我做出了完美的酱汁！";
		mes "现在把它带给主厨！";
		next;
		mes "[Oriental Oyster]";
		mes "看来你很有制作酱汁的天赋。";
		mes "要不要成为酱汁大师？";
		if (ep16_cookbs == 11) {
			erasequest 11396;// Why Should I Prepare for the Banquets?
			setquest 11397;// Why Should I Prepare for the Banquets?
			ep16_cookbs = 12;
		}
		else {
			erasequest 11421;// Banquet: Unexpected Sauce
			setquest 11422;// Complete Today's Sauce
			getitem 6919,4;// TokenOfHonor
			ep16_cookbs = 23;
		}
		close;
	}
	if (ep16_cookbs == 12) {
		mes "[Oriental Oyster]";
mes "哦！";
mes "很好！";
mes "多亏了你，我做出了完美的酱汁！";
		next;
		mes "[Oriental Oyster]";
mes "看来你很有制作酱汁的天赋。";
mes "要不要成为酱汁大师？";
		close;
	}
	if (ep16_cookbs == 23) {
		switch( checkquest(11422,PLAYTIME) ) {// daily
		case -1:
			mes "[Oriental Oyster]";
mes "我就知道你会再来！";
mes "这就是酱汁的魔力！";
			next;
			mes "[Oriental Oyster]";
mes "今天要不要制作一份出色的酱汁？";
			next;
			ep16_cookbs = 26;
			setquest 11421;// Banquet: Unexpected Sauce
			callsub S_Sauce;
		case 0:
		case 1:
			mes "[Oriental Oyster]";
mes "天啊！";
mes "味觉对厨师来说非常重要。";
mes "疲劳时味觉无法正常工作。";
			next;
			mes "[Oriental Oyster]";
mes "你现在看起来很累。";
			next;
			mes "[Oriental Oyster]";
mes "想制作完美酱汁的话，先休息一下。";
			close;
		case 2:
			mes "[Oriental Oyster]";
mes "哦！你来了！";
mes "你休息过了吗？要不要再做一次酱汁？";
			erasequest 11422;// Complete Today's Sauce
			close;
		}
	}
	mes "[Oriental Oyster]";
	mes "希望你不要浪费自己的天赋。";
	mes "要不要成为酱汁大师？";
	close;

S_Sauce:
	mes "[Oriental Oyster]";
	switch( rand(11428,11431) ) {
	case 11428:
		mes "首先，带给我能带来清爽味道的材料。";
		setquest 11428;// Ingredient for the Sauce
		break;
	case 11429:
		mes "带给我能带来嚼劲的材料。";
		setquest 11429;// Ingredient for the Sauce
		break;
	case 11430:
		mes "带给我闪闪发光的材料。";
		setquest 11430;// Ingredient for the Sauce
		break;
	case 11431:
		mes "首先，带给我能带来柔和口感的材料。";
		setquest 11431;// Ingredient for the Sauce
		break;
	}
	close;
}

function	script	check_sauce	{
	.@quest_id = getarg(0);
	.@main_quest = (ep16_cookbs == 4 || ep16_cookbs == 6 || ep16_cookbs == 8 || ep16_cookbs == 10);
	if (.@main_quest || ep16_cookbs == 26 || ep16_cookbs == 28 || ep16_cookbs == 30 || ep16_cookbs == 32) {
		if (isbegin_quest(.@quest_id) > 0) {
			mes "[Oriental Oyster]";
		mes "对！就是这个！";
		mes "带给我！";
			emotion ET_SURPRISE, getnpcid(0, "Royal Sauce Master#ep16");
			ep16_cookbs++;
			erasequest .@quest_id;
			close;
		}
		mes "[Oriental Oyster]";
mes "啊！";
	mes "酱汁毁了！";
		next;
		mes "[Oriental Oyster]";
	mes "现在不能使用这份酱汁了！";
	mes "我们应该从头再来！";
		if (.@main_quest)
			ep16_cookbs = 3;
		else
			ep16_cookbs = 25;
		if (isbegin_quest(11428) > 0)
			erasequest 11428;
		if (isbegin_quest(11429) > 0)
			erasequest 11429;
		if (isbegin_quest(11430) > 0)
			erasequest 11430;
		if (isbegin_quest(11431) > 0)
			erasequest 11431;
		close;
	}
	return;
}


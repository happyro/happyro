prt_cas,302,205,5	script	Dishwasher#ep16_1	4_M_ALCHE_D,{
	if (ep16_cookbs == 21) {
		if (countitem(6935) < 15) {
			mes "[Dishwasher]";
		mes "我又要洗盘子了……一次又一次……";
		mes "永远没完没了！";
			next;
			mes "[Dishwasher]";
		mes "不过，这就是洗碗工的命运！";
			next;
			mes "[Dishwasher]";
		mes "这就是命运！";
		mes "我必须忍耐！";
			next;
			mes "[Dishwasher]";
		mes "请给我！";
		mes "更多要洗的盘子！";
			next;
			mes "[Dishwasher]";
		mes "我会克服的！";
		mes "我的命运！";
			close;
		}
		mes "[Dishwasher]";
		mes "哈哈哈……这是新盘子。";
		mes "我会把它洗得吱吱作响般干净！";
		next;
		mes "[Dishwasher]";
		mes "哦……主厨一直在找你。";
		mes "出什么问题了吗？";
		delitem 6935,15;// Luxurious_Dish
		erasequest 11419;// Why Should I Prepare for the Banquets?
		setquest 11420;// Why Should I Prepare for the Banquets?
		ep16_cookbs = 22;
		close;
	}
	if (ep16_cookbs == 22) {
		mes "[Dishwasher]";
mes "哦……主厨一直在找你。";
mes "出什么问题了吗？";
		close;
	}
	if (ep16_cookbs > 22) {
		switch( checkquest(11427,PLAYTIME) ) {
		case -1:
			if (isbegin_quest(11426) == 0) {
				mes "[Dishwasher]";
mes "哦！你又来帮我了吗？";
mes "干净的盘子是不是也让你感觉干净？";
				next;
				mes "[Dishwasher]";
mes "嗯，我想有这种感觉很正常！";
mes "保持这种精神！请再带 15 个盘子给我洗！";
				next;
				mes "[Dishwasher]";
mes "请小心对待，因为这些是珍贵的盘子！";
				setquest 11426;// Banquet: Washing 15 Dishes
				close;
			}
			if (countitem(6935) < 15) {
				mes "[Dishwasher]";
mes "我又要洗盘子了……一次又一次……";
mes "永远没完没了！";
				next;
				mes "[Dishwasher]";
mes "不过，这就是洗碗工的命运！";
				next;
				mes "[Dishwasher]";
mes "这就是命运！";
mes "我必须忍耐！";
				next;
				mes "[Dishwasher]";
mes "请给我！";
mes "请再带大约 15 个盘子给我洗！";
				next;
				mes "[Dishwasher]";
mes "我会克服的！";
mes "我的命运！";
				close;
			}
			if (checkweight(1119,3) == 0) {
mes "- 你携带的物品太多。";
mes "请整理物品后再试。-";
				close;
			}
			mes "[Dishwasher]";
mes "哈哈哈……这是新盘子。";
mes "我会把它洗得吱吱作响般干净！";
			delitem 6935,15;// Luxurious_Dish
			erasequest 11426;// Banquet: Washing 15 Dishes
			setquest 11427;// Complete Today's Dish Collecting
			getitem 6919,4;// TokenOfHonor
			close;
		case 0:
		case 1:
			mes "[Dishwasher]";
		mes "别太勉强自己。";
		mes "去休息一下，明天再来吧？";
			close;
		case 2:
			mes "[Dishwasher]";
		mes "谢谢你上次帮助我！";
		mes "工作后充分休息很重要。";
			erasequest 11427;// Complete Today's Dish Collecting
			close;
		}
	}
	mes "[Dishwasher]";
	mes "啊！";
	npctalk "啊！", "Dishwasher#ep16_1", bc_self;
	next;
	mes "[Dishwasher]";
	mes "主妇湿疹又在我的右手上发作了！";
	npctalk "主妇湿疹又在我的右手上发作了！", "Dishwasher#ep16_1", bc_self;
	next;
	mes "[Dishwasher]";
	mes "霍德乳霜！";
	mes "请给我霍德乳霜！";
	mes "啊啊啊啊！";
	npctalk "请给我霍德乳霜！", "Dishwasher#ep16_1", bc_self;
	close;
}


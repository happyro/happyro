alberta,246,117,4	script	Voyage log#tur	111,{
	if (rand(2)) {
	mes "[航海日志]";
		mes "凌晨 3:20";
		mes "今晚没有星光，连前方一百米都看不见。船员似乎感觉到空气中的不祥。";
		next;
	mes "[航海日志]";
		mes "同伴脸上流露出恐惧，昨夜无法入睡。希望很快能看到日出……";
		next;
		mes "[航海日志]";
		mes "04:10 ";
	mes "5分钟前，同伴库克因桅杆突然断裂砸中头部而死亡。";
		next;
			mes "[航海日志]";
	mes "推定死亡时间04:07。船撞礁的冲击折断了桅杆，甲板左侧也严重受损。";
		next;
	mes "[航海日志]";
		mes "04:45";
	mes "两名船员修理甲板底部时，被从裂缝潜入的魔物袭击。";
		next;
		mes "[航海日志]";
	mes "两人在袭击中丧生，推定死亡时间04:32。幸运的是船还能漂浮，但必须尽快找到陆地。";
		next;
			mes "[航海日志]";
	mes "甲板受损导致30%的补给损失。照这个速度，很快就会没有食物。";
		next;
	mes "[航海日志]";
		mes "05:23";
	mes "需要绕行的礁石越来越多，也越来越大。不知道什么时候才能找到陆地……";
		next;
		mes "[航海日志]";
	mes "作者：乔尔纳丹·尼利里亚船长";
		close;
	}
	else {
		if (TURTLE == 1) {
			mes "^3355FF纸张破损，粘着海藻和霉斑。这本日志状况很差……^000000";
			next;
			switch(rand(1,3)) {
			case 1:
				mes "^3355FF有些页面之间夹着香蕉叶。上面写着：^000000";
				next;
			mes "[航海日志]";
				mes "O / X 日期";
				mes "刚抵达海底洞穴，我们就疯狂寻找食物。";
				next;
	mes "[航海日志]";
				mes "情况糟糕到皮肤下都能看见骨头。";
				next;
		mes "[航海日志]";
				mes "X / X 日期";
				mes "我们找到了一种水果！外皮黄色，看起来像香蕉！";
				next;
			mes "[航海日志]";
				mes "XO / X 日期";
				mes "虽然不像卢恩·米德加尔特的香蕉，但非常相似。";
				next;
	mes "[航海日志]";
				mes "O / O 日期";
				mes "半夜有人报告，吃了这种食物后感到不适。";
				next;
		mes "[航海日志]";
				mes "OO / O 日期";
				mes "另一名船员贝洛特·贝洛特也出现严重消化不良。";
				next;
			mes "[航海日志]";
				mes "现在很明显，我们吃的食物含有某种毒素。";
				next;
	mes "[航海日志]";
				mes "XO / O 日期";
				mes "第三名出现消化不良的人今天去世了。我们都很担心。";
				next;
		mes "[航海日志]";
				mes "我们发现海底洞穴的动物拒绝吃这些香蕉，证实了我们的怀疑。";
				next;
			mes "[航海日志]";
				mes "OX / O 日期";
				mes "我们决定封存这种有毒水果，却发现它不会腐烂，即使剥掉外皮也一样。";
				next;
	mes "[航海日志]";
				mes "不知道它为何有害、为何永不腐烂，但可能具有医学或科学价值。";
				next;
		mes "[航海日志]";
				mes "在此期间，我们决定把水果埋起来，直到回到艾尔贝塔。";
				next;
			mes "[航海日志]";
				mes "^FF3355tur_dun01^000000";
				mes "^FF3355X : 160 , Y : 81^000000";
				next;
				mes "^3355FF航海日志中有一把刻着骷髅的细钥匙。你拿走了骷髅钥匙，也许以后有用。^000000";
				set TURTLE,2;
				changequest 11029,11030;
				close;
			case 2:
				mes "^3355FF你发现一页纸上有鸟脚形印章，黑色墨水闻起来像水果。^000000";
				next;
	mes "[航海日志]";
				mes "X / OO 日期";
				mes "我们发现其他人来过的证据，我们不是最早找到海底洞穴的人。";
				next;
		mes "[航海日志]";
				mes "至少有一个人在我们之前到过。希望他的记录还在岛上某处。";
				next;
			mes "[航海日志]";
				mes "从明天开始，我们会寻找这些隐藏记录。";
				next;
	mes "[航海日志]";
				mes "O / OO 日期";
				mes "寻找记录很困难。难道最早来这里的人没有记录旅程？";
				next;
		mes "[航海日志]";
				mes "XO / OO 日期";
				mes "我们终于找到了寻找已久的记录。";
				next;
			mes "[航海日志]";
				mes "他的笔记很难找到，因为在我们之前来海底洞穴的只有一个人，而不是团队！";
				next;
	mes "[航海日志]";
				mes "这个男人是被称为“一”的剑士。他的记录讲述了海底洞穴能找到的许多东西。";
				next;
		mes "[航海日志]";
				mes "他的记录写在兽皮上，经久耐用，经过这么久仍然易读。";
				next;
			mes "[航海日志]";
				mes "据他的笔记，海底洞穴分为4层。这里虽然没有人，却有许多由神秘力量驱动的陷阱和装置。";
				next;
	mes "[航海日志]";
				mes "不过可以确定，有某种东西控制着海底洞穴。";
				next;
		mes "[航海日志]";
				mes "为保护记录，船员决定把这份珍贵记录藏在海底洞穴第二层。";
				next;
			mes "[航海日志]";
				mes "在这里寻找……";
				mes "^FF3355tur_dun02^000000";
				mes "^FF3355X : 132 , Y : 251^000000";
				next;
				mes "^3355FF图中有一棵树，根部下方清楚地画着一个小钥匙孔。^000000";
				next;
				mes "^3355FF你获得了^000000^3355FF根部钥匙。^000000";
				set TURTLE,3;
				changequest 11029,11031;
				close;
			case 3:
				mes "^3355FF这几页日志沾满泥土，还有一些页面缺失。^000000";
				next;
	mes "[航海日志]";
				mes "O / XX 日期";
		mes "海底洞穴前所未有的最大宝藏，被封印在某个秘密地点……";
			next;

	mes "整个艾尔贝塔都没有像样的酒馆！不过话说回来，我为什么喝这么多？嗯……";
	next;
	switch(select("告诉我海底洞穴的事:怎么去那里？:别说了")) {
	case 1:
	mes "[龟爷爷]";
		mes "咦……？海底洞穴？";
		next;
		mes "[龟爷爷]";
		mes "那里有很多传说。有人说那里有一座宝藏山。";
		next;
	mes "[龟爷爷]";
		mes "也有人说那里藏着能延长寿命的药水。但没人确切知道。";
		next;
		mes "[龟爷爷]";
		mes "但我确信海底洞穴确实存在，那里一定能找到奇妙的东西。";
		next;
	mes "[龟爷爷]";
		mes "只有心地善良、渴望冒险的人才能去那种地方。";
		next;
		switch(select("^3333FF*叮！*^000000:再告诉我一些，老人家！")) {
		case 1:
			mes "[龟爷爷]";
			mes "哈哈哈～！";
			if (Sex == SEX_MALE)
				mes "我喜欢你眼中的光芒，小伙子！我从那双眼睛里看到了自己的影子。是的……";
			else
				mes "亲爱的，别想隐藏眼中的光芒！你渴望冒险，这点我看得出来……";
			next;
			mes "[龟爷爷]";
			mes "告诉我……你听说过^3355FF乔尔纳丹·尼利里亚^000000吗？他和另外十人真的找到了海底洞穴！";
			next;
			mes "[龟爷爷]";
			mes "^3355FF乔尔纳丹·尼利里亚^000000坚强而有信念。他和船员收集了关于海底洞穴的所有线索。";
			next;
	mes "[龟爷爷]";
			mes "即使了解了所有能知道的事，他们的航行仍依靠对传说真实的希望与信念……";
			next;
			mes "[龟爷爷]";
			mes "漫长艰苦的旅程后，他们的努力得到回报，成功登上海底洞穴！";
			next;
	mes "[龟爷爷]";
			mes "但之后事情变得复杂。据说尼利里亚的船员不知为何很难回家。";
			next;
			mes "[龟爷爷]";
			mes "嘿嘿……想知道更多的话，去艾尔贝塔港口东端吧。那里有位学者了解更多故事。";
			next;
	mes "[龟爷爷]";
			mes "他可能会进一步解释海底洞穴的传说。";
			next;
			mes "[龟爷爷]";
			mes "还有一件事！在学者附近找找他的^3355FF日记^000000。保证很有趣。";
			next;
	mes "[龟爷爷]";
			mes "啊……青春之火！愿风停时梦想仍充满你的船帆～祝你好运！";
			close;
		}
		mes "[龟爷爷]";
		mes "呜……！";
		next;
		mes "[龟爷爷]";
		mes "我知道的不多，但不会和只被贪婪驱使的人说话。回家吧！";
		close;
	case 2:
		if ((MISC_QUEST & 65536) || TURTLE) {
			if(MISC_QUEST & 65536) set TURTLE,0; //now clear the var
			mes "[龟爷爷]";
			mes "嗯……去艾尔贝塔港口东侧，应该能找到老船夫。";
			next;
	mes "[龟爷爷]";
			mes "他叫^3355FF戈坦布鲁^000000，可能知道去海底洞穴的方法。嘿嘿，祝你好运～";
			close;
		}
		mes "[龟爷爷]";
		mes "海底洞穴……？";
		next;
		mes "[龟爷爷]";
		mes "那地方很难找到，更难前往。你确定要去？我很想给建议，但喝太多后头晕得厉害……";
		next;
		mes "[龟爷爷]";
		mes "呵呵呵……去找我认识的胖小水手^3355FF戈坦布鲁^000000吧。他会在艾尔贝塔港口闲逛。";
		next;
		mes "[龟爷爷]";
		mes "告诉他是我让你去的，他会告诉你更多海底洞穴的事，甚至可能知道怎么去～";
		next;
			mes "[龟爷爷]";
		mes "那么……祝你好运～";
		set TURTLE,1;
		setquest 11029;
		close;
	case 3:
	mes "[龟爷爷]";
		mes "哦……都这把年纪了……我还是不明白自己怎么能喝这么多……";
		close;
	}
}

-	script	::Sailor_alberta	-1,{
	if (TURTLE || (MISC_QUEST & 65536)) {
		mes "[戈坦布鲁]";
		mes "嘿……你的眼睛……我看得出你对海底洞穴很好奇。你一定和那个醉老头聊过了！";
		next;
			switch(select("你了解海底洞穴吗？:怎么去那里？:别说了。")) {
		case 1:
			mes "[戈坦布鲁]";
			mes "海底洞穴……？先提醒你，那地方夺走了我同伴的生命。我曾是^3355FF乔尔纳丹·尼利里亚^000000的船员。";
			next;
			mes "[戈坦布鲁]";
			mes "我们想确认传说是否真实，于是抛下一切寻找真相。";
			next;
	mes "[戈坦布鲁]";
			mes "乔尔纳丹·尼利里亚是最伟大的寻宝者之一，从世界各地招募船员。我自豪地说，每位船员都是各自领域的佼佼者。";
			next;
		mes "[戈坦布鲁]";
			mes "我最擅长航海。虽然只有二十岁，仍被邀请加入团队，能与这些伟人平等相处是莫大荣誉。";
			next;
			mes "[戈坦布鲁]";
			mes "我们关于海底洞穴位置的最大线索表明它在艾尔贝塔附近，所以从这里出发。";
			next;
	mes "[戈坦布鲁]";
			mes "我们日夜航行，漂流数周，直到某天被浓雾包围。完全不知道方向，雾也不散。";
			next;
		mes "[戈坦布鲁]";
			mes "但没人后悔，我们继续前进，绝不回头！";
			next;
			mes "[戈坦布鲁]";
			mes "终于珊瑚礁突然出现，无法避开。船严重受损。雾散后，我们发现终于抵达海底洞穴！传说是真的！";
			next;
	mes "[戈坦布鲁]";
			mes "上岸扎营并探索后，我们发现了惊人的事情。";
			next;
		mes "[戈坦布鲁]";
			mes "有人在我们之前到过海底洞穴，但记录从未传到卢恩·米德加尔特。他是伟大的剑术大师，人称^3355FF一^000000。";
			next;
			mes "[戈坦布鲁]";
			mes "据记录，他独自寻找并抵达海底洞穴，但我们找不到他的任何踪迹……";
			next;
	mes "[戈坦布鲁]";
			mes "继续探索后，我们发现那里不仅宝藏丰富，还藏着一件极有价值的物品。";
			next;
		mes "[戈坦布鲁]";
			mes "第一位探险者的记录提到某种惊人的^3355FF宝石碎片^000000。";
			next;
			mes "[戈坦布鲁]";
			mes "他为寻找剑术秘密来到海底洞穴，偶然发现一块他称为世界最美的宝石。";
			next;
	mes "[戈坦布鲁]";
			mes "根据^3355FF一^000000的记录，我们彻底探索了海底洞穴。然而……";
			next;
		mes "[戈坦布鲁]";
			mes "寻找数月仍找不到宝石碎片，最终只能放弃。";
			next;
			mes "[戈坦布鲁]";
			mes "最后我们收拾东西离开，但海上再次遇到浓雾，什么也看不见。";
			next;
	mes "[戈坦布鲁]";
			mes "我们花了一个月穿过雾气，出来后却发现到了海底洞穴另一侧！";
			next;
		mes "[戈坦布鲁]";
			mes "我们绝望了！！反复尝试离开，花了近一年却总回到海底洞穴岸边。";
			next;
			mes "[戈坦布鲁]";
			mes "与浓雾搏斗时同伴一个个死去。最后只有乔尔纳丹、你遇到的醉老头和我回到了艾尔贝塔。";
			next;
	mes "[戈坦布鲁]";
			mes "我们没有屈服于绝望，坚持希望。不过能找到回卢恩·米德加尔特的路纯属幸运。";
			next;
		mes "[戈坦布鲁]";
			mes "这就是我的故事。想知道更多海底洞穴的事，就去艾尔贝塔东港找学者吧。";
			next;
			mes "[戈坦布鲁]";
			mes "嘿嘿……他能告诉你连我都不知道的细节……";
			close2;
			// erasequest 11029;
			end;
		case 2:
	mes "[戈坦布鲁]";
			mes "听完海底洞穴的故事你还不怕？我佩服你！好吧……";
			next;
		mes "[戈坦布鲁]";
			mes "要我带你去的话，收费10,000 Zeny。我是唯一能安全带你往返的领航员。";
			next;
			if (select("龟岛 -> 10,000 Zeny:取消") == 1) {
				if (Zeny > 9999) {
	mes "[戈坦布鲁]";
					mes "好！！你做出了选择！凭我的经验一定能抵达！我欣赏你的勇气！";
					next;
				mes "^3355FF*呜呜*^000000";
					set Zeny, Zeny-10000;
					warp "tur_dun01",157,39;
					close2;
					// erasequest 11029;
					end;
				}
		mes "[戈坦布鲁]";
				mes "嗯……抱歉，你的 Zeny 不够。希望你理解我的专业和经验不能被低估……";
				close;
			}
			mes "[戈坦布鲁]";
			mes "好吧……如果冒险之心再次燃起，我会在这里等你。";
			close;
		case 3:
			mes "[戈坦布鲁]";
			mes "嘿……";
			next;
	mes "[戈坦布鲁]";
			mes "准备好听故事时再回来，好吗？";
			close;
		}
	}
	mes "[戈坦布鲁]";
	mes "啊……！看看那片海洋！一望无际覆盖大地。这不是你见过最美的景色之一吗……";
	close;
}

tur_dun01,165,29,4	script	Sailor#tur2	709,{
	mes "[戈坦布鲁]";
	mes "要回艾尔贝塔吗？";
	next;
	if (select("前往艾尔贝塔:停止交谈") == 1) {
		mes "[戈坦布鲁]";
		mes "嘿嘿……希望你找到了想找的东西。好了，冒险者总有回家的时候……";
		next;
		mes "^3355FF* 呜呜 *^000000";
		if (checkre(0))
			warp "alberta",238,112;
		else
			warp "alberta",241,115;
	}
	close;
}

-	script	::Turtle_Scholar_alberta	-1,{
	mes "[乔尔纳丹·尼利里亚]";
	mes "每个地方都有独特的气味、景色和声音。";
	next;
			mes "[乔尔纳丹·尼利里亚]";
	mes "即使是所有人共享的广阔天空，到了陌生土地也会显得不同。";
	next;
	mes "[乔尔纳丹·尼利里亚]";
	mes "嘿嘿……就像我在海底洞穴的时光。哈哈哈～";
	next;
	switch(select("关于龟岛:你是乔尔纳丹·尼利里亚？！:停止交谈")) {
	case 1:
		mes "[乔尔纳丹·尼利里亚]";
		mes "海底……洞穴……";
		next;
	mes "[乔尔纳丹·尼利里亚]";
		mes "说来可笑，海底洞穴只是因为形状像乌龟才得名。";
		next;
		mes "[乔尔纳丹·尼利里亚]";
		mes "现在海底洞穴被浓雾包围。最初被困时，很多人以为是诅咒或魔法造成的。";
		next;
			mes "[乔尔纳丹·尼利里亚]";
		mes "实际上，雾是自然现象，由海底洞穴海岸洞穴内的瀑布形成。";
		next;
	mes "[乔尔纳丹·尼利里亚]";
		mes "嘿嘿……理解之后真相就很简单。我想困惑和恐惧才是遮蔽判断、遮蔽人生道路的雾。";
		next;
		mes "[乔尔纳丹·尼利里亚]";
		mes "信不信由你，我曾经也害怕海底洞穴的危险。但现在了解大部分秘密后，我怀念那段经历。";
		next;
			mes "[乔尔纳丹·尼利里亚]";
		mes "不过还有一样东西未被发现：^3355FF未知宝石碎片^000000。";
		next;
		mes "[乔尔纳丹·尼利里亚]";
		mes "在找到它之前，我会继续研究、尽可能学习。哈哈哈哈～！";
		close;
	case 2:
	mes "[乔尔纳丹·尼利里亚]";
		mes "嗯……？你听说过我？";
		next;
		mes "[乔尔纳丹·尼利里亚]";
		mes "啊……你应该知道我寻宝的经历，也听说过海底洞穴。";
		next;
			mes "[乔尔纳丹·尼利里亚]";
		mes "如你所见，我现在老了。这把老骨头不如从前。";
		next;
	mes "[乔尔纳丹·尼利里亚]";
		mes "不过也许有一天，研究有了成果，我会再次出发寻找唯一没找到的宝藏……";
		close;
	case 3:
		mes "[乔尔纳丹·尼利里亚]";
		mes "想发现真相时，永远别屈服于绝望。只要不放弃寻找，答案终会出现。";
		next;
			mes "[乔尔纳丹·尼利里亚]";
		mes "...";
		next;
	mes "[乔尔纳丹·尼利里亚]";
		mes "...";
		mes "......";
		next;
		mes "[乔尔纳丹·尼利里亚]";
		mes "对了，我很饿。艾尔贝塔为什么没有好餐馆？！听说昆仑有很棒的点心……";
		close;
	}
}


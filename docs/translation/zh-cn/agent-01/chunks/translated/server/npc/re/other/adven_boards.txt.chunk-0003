					mes "饼干（绿色）(35)";
					mes "玛琳(37)";
					mes "饼干（红色）(37)";
					mes "礼物盒怪(39)";
					mes "波利王(42)";
					mes "雪莉(42)";
					mes "天使波利(77)";
					mes "--------------------------------";
					next;
					mes "<你觉得波利可爱吗？遇到天使波利后会改变想法吗？它喜欢骚扰人。天使波利新手要小心！一定要小心！就这些~——戴兽人面具的探索者葡萄>";
					F_InfoBoard;
					continue;
				case 2:
					mes "[玩具工厂 B2]";
					mes "------------ 怪物 ------------";
					mes "饼干（绿色）(35)";
					mes "饼干（红色）(37)";

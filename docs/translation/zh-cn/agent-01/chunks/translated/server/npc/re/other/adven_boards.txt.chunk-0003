			1191,"魔物箱","需要冒险家的建议。",
			1216,"毒花","外形像九头蛇但能移动，攻击更强。低估它会迅速丧命，请小心。",
			1120,"幽灵波利","变异的巨大波利，和其他波利一起游荡。",
			1143,"木偶娃娃","木偶剧院中的木偶恶魔，普通武器对其灵体无效。^000000",
			1208,"浪人","复活的不死流浪武士，使用精湛剑术，足以将飞虫一分为二。",
			1112,"海盗王德雷克","寻找幻影宝藏却因此丧命的海盗王。强烈遗憾让海盗被诅咒，以不死之身行走于现世，并守护宝藏。" );
		if (.@mo_board == 1) {
			mes "[沉船]";
			mes "沉船没有完全沉入水中，共有 2 层可进入。虽然地图不大，地下城中却有许多怪物，请小心。";
			next;
			while(1) {
				switch( select( "沉船 B1","沉船 B2","取消" ) ) {
				case 1:
					mes "[沉船 B1]";
					mes "------------ 怪物 ------------";
					mes "毒孢子(26)";
					mes "九头蛇(34)";
					mes "低语(34)";
					mes "库克雷(42)";
					mes "海盗骷髅(48)";
					mes "--------------------------------";
					F_InfoBoard;
					continue;
				case 2:
					mes "[沉船 B2]";
					mes "------------ 怪物 ------------";
					mes "九头蛇(34)";
					mes "低语(34)";
					mes "库克雷(42)";
					mes "海盗骷髅(48)";
					mes "魔物箱(56)";
					mes "毒花(85)";
					mes "幽灵波利(90)";
					mes "木偶娃娃(90)";
					mes "浪人(120)";
					mes "--------------------------------";
					next;
					mes "<幽灵波利见到我就逃跑……一定是害羞。沉船前船长也太没礼貌了。噗~！——嫉妒船长帽子的探索者葡萄>";
					F_InfoBoard;
					continue;
				}
				break;
			}
		}
	}
}

comodo,327,177,0	script	Signposts#Comodo East	2_BULLETIN_BOARD,{
	while(1) {
		mes "[海东东洞穴]";
		mes "为了让冒险家轻松环游世界，冒险家收集的信息会公开。请向冒险家小组提供建议，以便修订信息。";
		mes "-- 冒险家小组 --";
		next;
		.@mo_board = callfunc( "F_AvenBoard",
			1068,"九头蛇","海葵怪物，根深深扎在地下，用固定的触手攻击附近生物。",
			1034,"塔拉青蛙","喜欢阴暗潮湿处的青蛙怪物，对新手冒险家来说可能很难对付。",
			1064,"巨齿鲨","用魔法复活的鱼骨怪物，作为不死生物仍保留鱼的习性。",
			1255,"海神","生活在洞穴中的蠕虫怪物，视力很差，只靠嗅觉发现附近猎物。" );		
		if (.@mo_board == 1) {
			mes "[海东东洞穴]";
			mes "海东东洞穴是一条通往帕普奇查森林的隧道。这里因稀有的塔拉青蛙和九头蛇卡片而受欢迎，急需 Zeny 时可以来这里。";
			next;
			mes "[海东东洞穴]";
			mes "------------ 怪物 ------------";
			mes "九头蛇(34)";
			mes "塔拉青蛙(40)";
			mes "巨齿鲨(46)";
			mes "海神(98)";
			mes "--------------------------------";
			next;
			mes "<塔拉青蛙……只是青蛙吧？呃……长得真丑。——喜欢青蛙的探索者葡萄>";
			next;
		}
	}
}

comodo,31,217,0	script	Signposts#Comodo West	2_BULLETIN_BOARD,{
	while(1) {
		mes "[海东西洞穴·卡鲁]";
		mes "为了让冒险家轻松环游世界，冒险家收集的信息会公开。请向冒险家小组提供建议，以便修订信息。";
		mes "-- 冒险家小组 --";
		next;
		.@mo_board = callfunc( "F_AvenBoard",
			1264,"鱼人","野心勃勃、想统治地表世界的鱼人怪物，常见于海底或海滩洞穴。",
			1256,"害虫","来源不明的怪物，会旋转锋利的眼睑攻击。",
			1255,"海神","生活在洞穴中的蠕虫怪物，视力很差，只靠嗅觉发现附近猎物。",
			1148,"美杜莎","头发是蛇的怪物，直视其双眼可能使身体石化。",
			1583,"塔奥群卡","脸大而圆、表情粗野的 MVP 怪物。大多数冒险家会害怕逃跑，但它其实相当强。" );
		if (.@mo_board == 1) {
			mes "[海东西洞穴·卡鲁]";
			mes "这里有美杜莎，直视它的眼睛一定会让你石化。这座洞穴没有其他出口。";
			next;
			mes "[海东西洞穴·卡鲁]";
			mes "------------ 怪物 ------------";
			mes "鱼人(60)";
			mes "害虫(89)";
			mes "海神(98)";
			mes "美杜莎(102)";
			mes "--------------------------------";
			next;
			mes "<塔奥群卡？就是那个大脸怪物？它有多强？很弱……非常弱……哦！！对你来说可能很强。——戏弄人的探索者葡萄>";
			next;
		}
	}
}

comodo,178,354,0	script	Signposts#Comodo North	2_BULLETIN_BOARD,{
	while(1) {
		mes "[海东西北洞穴·鲁安德]";
		mes "为了让冒险家轻松环游世界，冒险家收集的信息会公开。请向冒险家小组提供建议，以便修订信息。";
		mes "-- 冒险家小组 --";
		next;
		.@mo_board = callfunc( "F_AvenBoard",
			1068,"九头蛇","海葵怪物，根深深扎在地下，用固定的触手攻击附近生物。",
			1274,"巨石怪","海东地区可见的石像怪物，会移动附近岩石进行攻击。",
			1279,"三关节","存在了数千年的生物，通常出现在黑暗洞穴中。",
			1278,"钟乳石魔物","进化的魔像怪物，身体覆盖钟乳石，比普通魔像强得多。",
			1255,"海神","生活在洞穴中的蠕虫怪物，视力很差，只靠嗅觉发现附近猎物。" );
		if (.@mo_board == 1) {
			mes "[海东西北洞穴·鲁安德]";
			mes "冒险家可以通过鲁安德洞穴到达乌姆巴拉。只有在这座洞穴里才能见到钟乳石魔物。";
			next;
			mes "[海东西北洞穴·鲁安德]";
			mes "------------ 怪物 ------------";
			mes "九头蛇(34)";
			mes "巨石怪(65)";
			mes "三关节(66)";
			mes "钟乳石魔物(68)";
			mes "海神(98)";
			mes "--------------------------------";
			next;
			mes "<钟乳石魔物？呼~我为什么来这里？啊！对了，我是来乌姆巴拉的！！——路过的探索者葡萄>";
			next;
		}
	}

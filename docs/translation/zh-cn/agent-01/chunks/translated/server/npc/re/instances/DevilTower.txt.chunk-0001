//===== rAthena Script =======================================
//= Devil Tower
//===== Description: =========================================
//= [Walkthrough Conversion]
//= Devil Tower Instance
//===== Changelogs: ==========================================
//= 1.0 First version. [Capuche]
//============================================================

dali02,134,119,5	script	Historian Shep#tnm01	4_F_NOVICE,{
	if (BaseLevel < 130) {
		mes "[谢普]";
		mes "你愿意自愿探索恶魔之塔吗？";
		mes "那里极其危险，所以你的等级至少要达到^4d4dff130 级^000000。";
		next;
		mes "[谢普]";
		mes "变强后再回来，好吗？";
		mes "你明白我的意思吧？";
		close;
	}
	switch( checkquest(7577,PLAYTIME) ) {// daily timer
	case -1:
		break;
	case 0:
	case 1:
		mes "[谢普]";
		mes "这么快就想再次探索吗？";
		mes "你的身体需要从时空旅行中恢复。";
		next;
		mes "[谢普]";
		mes "休息一天，明天再来吧！";
		mes "明白了吗？";
		close;
	case 2:
		mes "[谢普]";
		mes "你休息够了吗？";
		mes "今天轮到我探索了！";
		mes "我一直在等远征队成员到来！";
		erasequest 7577;// Space distortion
		devil_tower_can_reenter = 0;
		devil_tower_enter = 0;
		next;
		mes "！- 注意 -！";
		mes "现在可以重新进入恶魔之塔了。";
		close;
	}
	if (isbegin_quest(7576) > 0) {// instance completed
		mes "[谢普]";
		mes "所以那里似乎发生了时空汇聚？";
		mes "没想到时空旅行真的可能实现。";
		next;
		mes "[谢普]";
		mes "这就是你带回来的全部信息。";
		mes "你做得很好。";
		mes "期待你发现更多东西！";
		setquest 7577;// Space distortion
		erasequest 7568;// Explore the tower
		erasequest 7571;// Tower Expedition
		erasequest 7574;// Thanatos Tower
		erasequest 7576;// Morocc castle seal
		getexp 450000,450000;
		devil_tower_can_reenter = 0;
		devil_tower_enter = 0;
		mes "请明天再来！";
		close;
	}
	if (isbegin_quest(7574) > 0) {// failed after seal
		mes "[谢普]";
		mes "哦，你这么快就回来了……";
		mes "好，我明白发生什么了。";
		next;
		mes "[谢普]";
		mes "这就是你带回来的全部信息。";
		mes "你做得很好。";
		mes "期待你发现更多东西！";
		setquest 7577;// Space distortion
		erasequest 7568;// Explore the tower
		erasequest 7571;// Tower Expedition
		erasequest 7574;// Thanatos Tower
		getexp 300000,300000;
		devil_tower_can_reenter = 0;
		devil_tower_enter = 0;
		mes "请明天再来！";
		close;
	}
	if (isbegin_quest(7571) > 0) {// failed at stair 2 tnm1
		mes "[谢普]";
		mes "哦，你回来了。";
		mes "让我看看……你的意思是这座塔有一条通往恶魔世界的通道。";
		next;
		mes "[谢普]";
		mes "这就是你带回来的全部信息。";
		mes "你做得很好。";
		mes "期待你发现更多东西！";
		setquest 7577;// Space distortion
		erasequest 7568;// Explore the tower
		erasequest 7571;// Tower Expedition
		if (isbegin_quest(7572)) erasequest 7572;// Lucile...?
		if (isbegin_quest(7573)) erasequest 7573;// Magic Swordman Thanatos
		getexp 200000,200000;
		devil_tower_can_reenter = 0;
		devil_tower_enter = 0;
		mes "请明天再来！";
		close;
	}
	switch( checkquest(7568,PLAYTIME) ) {// entrance timer - 1h30 to enter
	case -1:
		mes "[谢普]";
		mes "你愿意自愿探索恶魔之塔吗？我一直在等像你这样的人！";
		next;
		mes "[谢普]";
		mes "终于有人愿意帮我揭开这座塔的秘密了。";
		mes "一直没人报名，我都开始担心了。";
		next;
		mes "[谢普]";
		mes "请把你在塔里发现的一切报告给我。";
		mes "情报越有价值，我支付给你的 Zeny 就越多！";
		next;
		mes "[谢普]";
		mes "那边的拉斐尔学者会用这个时空装置打开次元裂缝。";
		mes "裂缝仍然不稳定，所以你的探索时间会受到限制。";
		next;
		mes "[谢普]";
		mes "如果你意外地被弹回这里，请尽快回来。";
		mes "根据你的速度，你或许还能再次进入，也可能无法进入。";
		next;
		mes "[谢普]";
		mes "但如果时间耗尽，通往高塔的入口就会消失。";
		mes "那么，你愿意报名吗？";
		next;
		if (select( "报名", "不用了" ) == 2) {
		mes "[谢普]";
		mes "哦，那真遗憾。";
		mes "看来我也无能为力。";
		mes "我再去找别人吧……";
			close;
		}
		mes "[谢普]";
		mes "谢谢你。";
		mes "好，召集你的队伍，记得把发现的东西报告给我。";
		next;
		mes "[谢普]";
		mes "^4d4dff探索时间限制是为了你的安全^000000！";
		setquest 7568;// Explore the tower
		close;
	case 0:
	case 1:
		if (devil_tower_can_reenter == 0)// player can re-enter
			break;
		// fall through
	case 2:
		mes "[谢普]";
		mes "你似乎来晚了。";
		mes "你花费的时间太长了。";
		mes ".....";
		mes "你的情报已经无法使用。";
		next;
		mes "[谢普]";
		mes "我们无能为力。";
		mes "以后总会有其他远征机会的。";
		setquest 7577;// Space distortion
		erasequest 7568;
		if (isbegin_quest(7569)) erasequest 7569;// Treat the injured
		if (isbegin_quest(7570)) erasequest 7570;// Destroy the demons
		devil_tower_can_reenter = 0;
		devil_tower_enter = 0;
		close;
	}
		mes "[谢普]";
	mes "首先，你需要在入口处预约队列。";
	mes "拉斐尔学者阿蒂会替你预约。";
	next;
		mes "[谢普]";
	mes "由于次元裂缝仍然不稳定，时间有限。";
	mes "请简短高效地完成探索。";
	next;
		mes "[谢普]";
	mes "奖励会根据你花费的时间而不同。";
	mes "祝你好运！";
	next;
	if (select( "相信我！", "取消预约" ) == 1) {
		mes "[谢普]";
		mes "我相信你能在这些限制下完成任务。";
		mes "我相信你！";
		close;
	}
	if (devil_tower_enter == 1) {
		mes "[谢普]";
		mes "你似乎已经厌倦探索了。";
		mes "^4d4dff如果现在取消，你需要一天后才能再次挑战。^000000";
		mes "这样可以吗？";
		next;
		if (select( "是的，取消。", "等等，别取消！" ) == 2) {
			mes "[Shep]";
		mes "好，那我不取消。";
			close;
		}
		mes "[谢普]";
		mes "真的。";
		mes "那就明天再来吧。";
		setquest 7577;// Space distortion
		erasequest 7568;
		if (isbegin_quest(7569)) erasequest 7569;// Treat the injured
		if (isbegin_quest(7570)) erasequest 7570;// Destroy the demons
		devil_tower_enter = 0;
		devil_tower_can_reenter = 0;
		close;
	}
	mes "[Shep]";
	mes "真的吗？";
	mes "听完这些说明之后还要取消吗？";
	erasequest 7568;// Explore the tower
	close;
}

dali02,137,121,3	script	Magic Scholar Artie#tnm	4_M_FAIRYKID6,{
	.@party_id = getcharid(1);
	if (.@party_id == 0) {
		mes "[阿尔蒂]";
		mes "我们刚离开彩虹桥，一起享受这次旅程吧。";
		mes "不是吗？";
		mes "你是来报名探索的吗？";
		mes "你最好为这次远征召集一支队伍。";
		next;
		mes "[阿尔蒂]";
		mes "不要冒不必要的风险，知道吗？";
		close;
	}
	if (is_party_leader() == false) {
		mes "[阿尔蒂]";
		mes "请带上远征队长。";
		mes "恶魔之塔不是适合独自前往的地方。";
		mes "把负责人也带来。";
		close;
	}
	if (devil_tower_enter == 1) {
		mes "[阿尔蒂]";
		mes "你已经通过连接进入过那里了。";
		mes "还想再次连接空间？我做不到。";
		close;
	}
	switch( checkquest(7568,PLAYTIME) ) {
	case 0:
	case 1:
		break;
	case -1:
	case 2:
		mes "[阿尔蒂]";
		mes "嗯……除非到了指定的探索时间，否则很难连接。";
		mes "更不用说那里也很危险。";
		close;
	}
		mes "[阿尔蒂]";
	mes "你是来报名探索恶魔之塔的吗？";
	mes "要我启动次元装置吗？";
	next;
		mes "[阿尔蒂]";
	mes "快点决定，因为你在那里能停留的时间有限。";
	next;
	if (select( "是，启动装置。", "等一下。" ) == 2) {
		mes "[阿尔蒂]";
		mes "你的探索时间正在减少。";
		mes "时间非常宝贵。";
		mes "你还在等什么？";
		close;
	}
	mes "[Artie]";
	mes "次元装置已启动。";
	mes "如果你足够幸运，就能很快完成这次探索。";
	mes "期待听到你的好消息。";
	instance_create("Devil's Tower");
	close;
}

dali02,141,120,3	script	Dimensional Device#tnm0	PORTAL,{
	if (devil_tower_can_reenter == 1) {// can't re-enter
		mes "[阿尔蒂]";
		mes "喂，喂。";
		mes "现在很难通过装置把你送过去。";
		mes "今天先停止探索，改天再来吧。";
		close;
	}
	switch( checkquest(7568,PLAYTIME) ) {
	case 0:
	case 1:
		break;
	case -1:
	case 2:
		mes "[阿尔蒂]";
		mes "听我说，很抱歉，除了允许的时间外不能进入；恶魔之塔很危险。";
		close;
	}
	mes "[Artie]";
	mes "没错，这就是次元装置。";
	mes "它可以用来进行时空旅行。";
	mes "离开后再想进入会很困难。";
	next;
	mes "[Artie]";
	mes "不过别担心，我可是天才学者~";
	mes "总之，准备好进入了吗？";
	next;
	if (select( "进入装置。", "停止。" ) == 2) {
		mes "[阿尔蒂]";
		mes "好。";
		mes "从你启动装置到现在似乎已经过去很久了。对吧？";
		close;
	}
	.@md_name$ = "Devil's Tower";
	switch( instance_enter(.@md_name$) ) {
	case IE_OTHER:
		mes "发生未知错误。";
		close;
	case IE_NOINSTANCE:
		mes "[谢普]";
		mes "进入前必须先启动次元装置。";
		mes "它似乎还没有启动。";
		next;
		mes "[谢普]";
		mes "请与魔法学者阿蒂交谈，取得启动装置的许可。";
		close;
	case IE_NOMEMBER:
		mes "[阿尔蒂]";
		mes "只有组队远征时才允许探索恶魔之塔。";
		mes "请确认你已经准备好了。";
		close;
	case IE_OK:
		mapannounce "dali02", "队伍成员 " + strcharinfo(0) + " 隶属队伍“" + getpartyname( getcharid(1) ) + "”，进入房间 " + .@md_name$ + "", bc_map,0xFF99;
		// warp "1@tnm1",50,104;
		devil_tower_enter = 1;
		end;
	}
}

dali02,134,112,3	script	#tnmtks01	HIDDEN_WARP_NPC,3,3,{
	end;
OnTouch_:
	disablenpc "#tnmtks01";
	initnpctimer;
	end;
OnTimer1000:
	npctalk "阿尔蒂：嘿，你！研究进展如何？", "Magic Scholar Artie#tnm";
	end;
OnTimer3000:
	npctalk "谢普：你在叫谁嘿你？你只是个灰尘扑扑的小妖精！", "Historian Shep#tnm01";
	end;
OnTimer6000:
	npctalk "阿尔蒂：灰尘扑扑的小什么？告诉你，我的基因比你们猿类优越得多！", "Magic Scholar Artie#tnm";
	end;
OnTimer9000:
	npctalk "谢普：我才不在乎你说什么！就连我们的孩子都比你们这些小妖精大！", "Historian Shep#tnm01";
	end;
OnTimer12000:
	npctalk "谢普：你以为自己是魔法学者就很了不起吗？", "Historian Shep#tnm01";
	end;
OnTimer14000:
	npctalk "阿尔蒂：人类，你什么都不懂。再提醒我一次，谁发现了这座塔的入口？", "Magic Scholar Artie#tnm";
	end;
OnTimer18000:
	npctalk "谢普：*叹气*……是……你。", "Historian Shep#tnm01";
	end;
OnTimer21000:
	npctalk "阿尔蒂：你……？我说话结巴了吗？还有，谁解出了计算连接高塔的次元裂隙的公式？", "Magic Scholar Artie#tnm";
	end;
OnTimer24000:
	npctalk "谢普：是，是你！", "Historian Shep#tnm01";
	end;
OnTimer27000:
	npctalk "阿尔蒂：所以你不再怀疑我有多聪明了，对吧？", "Magic Scholar Artie#tnm";
	end;
OnTimer30000:
	npctalk "谢普：好了，好了。我们需要一名冒险者替我们探索高塔。", "Historian Shep#tnm01";
	end;
OnTimer33000:
	npctalk "谢普：没人自愿参加，因为大家都说太危险了！", "Historian Shep#tnm01";
	end;
OnTimer36000:
	npctalk "阿尔蒂：没人自愿？拜托。发挥你的激励技巧，找个人来。", "Magic Scholar Artie#tnm";
	end;
OnTimer37000:
	emotion ET_KIK, getnpcid(0, "Magic Scholar Artie#tnm");
	end;
OnTimer39000:
	npctalk "谢普：大家好！！！现在招募探索恶魔塔的新成员！", "Historian Shep#tnm01";
	end;
OnTimer42000:
	npctalk "谢普：请来吧！现在有机会亲眼面对臭名昭著的魔王梦罗克的爪牙！", "Historian Shep#tnm01";
	end;
OnTimer45000:
	npctalk "阿尔蒂：你确定这样说合适？也许你的招募策略需要改进……", "Magic Scholar Artie#tnm";
	stopnpctimer;
	enablenpc "#tnmtks01";
	end;
}

// Entrance
1@tnm1,50,104,0	script	#event01	HIDDEN_WARP_NPC,1,1,{
	end;
OnTouch:
	disablenpc instance_npcname("#event01");
	initnpctimer;
	end;
OnTimer2000:
	npctalk "海姆军官：这是紧急情况……进展如何？", instance_npcname("Officer Heim#heim0");
	end;
OnTimer5000:
	npctalk "散兵：下一层就是最高层……但那里有这么多恶魔……", instance_npcname("A tirailleur#tnm01");
	end;
OnTimer6000:
	emotion ET_THINK, getnpcid(0, instance_npcname("Officer Heim#heim0"));
	end;
OnTimer8000:
	npctalk "散兵：以我们的人数不可能突破。", instance_npcname("A tirailleur#tnm01");
	emotion ET_PROFUSELY_SWEAT, getnpcid(0, instance_npcname("A tirailleur#tnm01"));
	end;
OnTimer11000:
	npctalk "海姆军官：现在有多少士兵幸存？支援队什么时候到？", instance_npcname("Officer Heim#heim0");
	end;
OnTimer12000:
	emotion ET_THINK, getnpcid(0, instance_npcname("An aide#tnm02"));
	end;
OnTimer16000:
	npctalk "助手：没有足够的人可以召集……", instance_npcname("An aide#tnm02");
	end;
OnTimer17000:
	npctalk "助手：好消息是恶魔停止攻击了。", instance_npcname("An aide#tnm02");
	end;
OnTimer21000:
	npctalk "海姆军官：我们不能一直困在这里，必须继续前进。恶魔为什么停止攻击？", instance_npcname("Officer Heim#heim0");
	end;
OnTimer24000:
	npctalk "散兵：上面似乎发生了什么事……", instance_npcname("A tirailleur#tnm01");
	end;
OnTimer26000:
	disablenpc instance_npcname("Officer Heim#heim0");
	enablenpc instance_npcname("Officer Heim#heim");
	npctalk "海姆军官：你是谁？", instance_npcname("Officer Heim#heim");
	stopnpctimer;
	end;
}

1@tnm1,57,112,5	script	Officer Heim#heim0	4_TOWER_05,{ end; }

1@tnm1,56,110,3	script	Officer Heim#heim	4_TOWER_05,{
	if (is_party_leader() == false) {
		mes "[海姆军官]";
		mes "是谁把你们带到这里的？";
		mes "我想和一位代表谈谈。";
		close;
	}
	switch('devil_tower) {
	case 0:
		mes "[海姆军官]";
		mes "后援士兵？那你们为什么还站在那里？";
		npctalk "海姆军官：后备士兵？那你为什么只是站在那里？";
		next;
		select("现在吗？");
		if (is_party_leader() == true && 'devil_tower == 0) {
			enablenpc instance_npcname("Healer Fama#feima");
			'devil_tower = 1;
		}
		mes "[法玛治疗师]";
		mes "指挥官，请帮帮我。我一个人做不到~！";
		npctalk "法玛治疗师：指挥官，请帮帮我。我一个人做不到~！", instance_npcname("Healer Fama#feima");
		next;
		mes "[海姆军官]";
		mes "你听到了吗？";
		mes "帮法玛照顾受伤的士兵。";
		mes "法玛会给你急救包，用它帮助伤员。";
		close2;
		setpcblock PCBLOCK_NPC, true;
		npctalk "海姆军官：你听到了吗？";
		sleep2 2000;
		npctalk "海姆军官：帮助法玛照顾受伤的士兵。";
		sleep2 2000;
		npctalk "法玛治疗师：好~你要帮我吗？来这里领取急救包~！";
		setpcblock PCBLOCK_NPC, false;
		end;
	case 1:
		mes "[海姆军官]";
		mes "现在最重要的是协助法玛治疗受伤的士兵。";
		mes "即使环境很糟，也请尽你所能。";
		close;
	default:
		mes "[海姆军官]";
		mes "幸运的是，目前还没有人死亡。";
		mes "我不想看到我的士兵死去。";
		close;
	}
}

1@tnm1,47,109,3	script	Healer Fama#feima	4_TOWER_10,{
	if ('devil_tower == 1) {
		if (countitem(7641) < 1) {
			mes "[法玛治疗师]";
		mes "请用这个急救包治疗伤员。";
		mes "这并不难，按照说明操作就行。";
			next;
			mes "[法玛治疗师]";
		mes "我们的物资不多了，所以我一次只能给你一份。";
		mes "抱歉，用完后请再次来领取。";

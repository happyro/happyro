
OnEnable:
	enablenpc "Prince#eisen1";
	end;

OnDisable:
	disablenpc "Prince#eisen1";
	end;
}

prt_castle,336,202,7	script	Prince#eisen2	983,{
	mes "[Urugen]";
	mes "你说什么？阿鲁姆？";
	mes "嘿！你刚才对我说什么？阿鲁姆？！";
	next;
	mes "[Ahrum]";
	mes "我可以说无数遍！乌鲁根，你一点也不美！一点都不！事实上你长得又丑又下流！";
	next;
	mes "[Urugen]";
	mes "太无礼了！像你这种肮脏的细菌，怎么敢这样对我说话！";
	mes "像你这样的细菌";
	mes "也敢这样对我说话！";
	next;
	mes "[Ahrum]";
	mes "肮脏？没错，我就是肮脏。但这不是我的问题。一切都很肮脏！我再也受不了了！";
	next;
	mes "[Urugen]";
	mes "嗯！我同意你的话，世界确实下流，但你不能把我拉到那个层次！我无法原谅你的话！永远不能！";
	next;
	mes "[Ahrum]";
	mes "如果你不能原谅我又怎样？你能做什么？很好。你要杀我吗？会杀我吗？杀了我？哈哈？只有你自称美丽时，别人才会叫你美丽！";
	next;
	mes "[Urugen]";
	mes "啊！我受不了了！这么低俗的行为和话语……？你根本不是王子。我再也不想面对你！滚出去！";
	next;
	mes "[Ahrum]";
	mes "你没有足够的品质，也没有消灭邪恶的信念。意志上你就是垃圾。我也不想和垃圾待在一起！永远留在你的世界里，别出来！";
	next;
	mes "- 阿赫鲁姆嘟囔着走出房间……-";
	next;
	mes "[Urugen]";
	mes "……你真卑劣。我看错你了。你根本不是有艺术眼光的少数人之一。我完全误解你了。";
	completequest 10021;
	set .@er1,checkquest(10018);
	set .@er2,checkquest(10019);
	set .@er3,checkquest(10020);
	set .@er4,checkquest(10021);
	set .@er5,checkquest(10022);
	if ((.@er1 + .@er2 + .@er3 + .@er4 + .@er5) == 10) {
		setquest 10023;
		set nkprince_eisen,11;
	}
	donpcevent "Prince#eisen2::OnDisable";
	close;

OnInit:
	disablenpc "Prince#eisen2";
	end;

OnEnable:
	enablenpc "Prince#eisen2";
	end;

OnDisable:
	disablenpc "Prince#eisen2";
	end;
}

prt_castle,286,201,7	script	Prince#eisen3	983,{
	mes "[Ahrum]";
	mes "军事狂！混蛋！你以为力量能解决一切吗？你觉得人们在任何情况下都能和平生活吗？！";
	next;
	mes "[Helmut]";
	mes "你现在完全被暴力支配了。";
	mes "按照你的理论，你也没有成为国王的资格！";
	next;
	mes "[Ahrum]";
	mes "是啊，你说得真好。呸！";
	mes "我没有品质！！";
	mes "但你比我更糟！国王候选人？？你只是个战争贩子！";
	next;
	mes "[Helmut]";
	mes "你来这里是为了羞辱我吗？你以为能打败我，艾根·阿鲁姆？！";
	next;
	mes "[Ahrum]";
	mes "战斗？那太可笑了。我不在乎。我只是来把想说的话告诉你，根本不想和你战斗。我要走了！";
	next;
	mes "[Helmut]";
	mes "站住，懦夫！你现在要逃吗？！真是个懦夫！让我们结束这场战斗！";
	next;
	mes "[Ahrum]";
	mes "懦夫……真是个好词。没错，我就是。我走了。拜拜！你比我这个坏懦夫还糟……再见，战争贩子！";
	next;
	mes "- 阿赫鲁姆带着模糊的情绪对恼怒的赫尔穆特咧嘴一笑，然后离开房间。-";
	next;
	mes "[Helmut]";
	mes "真是……一个大恶棍！！！";
	completequest 10022;
	set .@er1,checkquest(10018);
	set .@er2,checkquest(10019);
	set .@er3,checkquest(10020);
	set .@er4,checkquest(10021);
	set .@er5,checkquest(10022);
	if ((.@er1 + .@er2 + .@er3 + .@er4 + .@er5) == 10) {
		setquest 10023;
		set nkprince_eisen,11;
	}
	donpcevent "Prince#eisen3::OnDisable";
	close;

OnInit:
	disablenpc "Prince#eisen3";
	end;

OnEnable:
	enablenpc "Prince#eisen3";
	end;

OnDisable:
	disablenpc "Prince#eisen3";
	end;
}

prt_castle,388,205,6	script	Prince#eisen4	983,{
	mes "[Ahrum]";
	mes "你总是只在乎赌博。不过，为什么不先关心一下周围呢，理查德家的少爷？";
	next;
	mes "[Poe]";
	mes "你现在为什么嘲弄我？至少我觉得我的骰子点数比你高……你不这么认为吗？";
	next;
	mes "[Ahrum]";
	mes "哼！你一直在说骰子。听着，你可以觉得我掷出的点数比你低……但在你掷骰子之前就已经失败了！知道吗？！";
	next;
	mes "[Poe]";
	mes "你在说什么？我听不懂。我要输给谁？我不明白你为什么这么说。";
	next;
	mes "[Ahrum]";
	mes "你不可能知道！那又怎样？！就算知道了，你能做什么？你对一切都过于自负。你以为能把腐烂深重的树培育成健康的树吗？！";
	next;
	mes "[Poe]";
	mes "想说什么就说清楚。你是在宣布失败和败北吗？我的运气有那么糟吗，艾根·阿鲁姆？";
	next;
	mes "[Ahrum]";
	mes "是的，我宣布失败。但不是输给你。你和我一样是个失败者。在处理重要事务前，你已经被环境因素毁掉了。";
	next;
	mes "[Poe]";
	mes "……你到底在说什么？环境？我完全不明白。你从来都说不清楚。";
	next;
	mes "[Ahrum]";
	mes "你最好别理解。如果知道这些，你会失去健康。别在意它……余生都别在意！！";
	next;
	mes "[Poe]";
	mes "等、等一下！看，阿鲁姆！";
	mes "等等！艾根·阿鲁姆！嘿！";
	next;
	mes "- 阿赫鲁姆完全忽视了";
	mes "呼唤他的声音后，带着孤独的神情离开房间。-";
	next;
	mes "[Poe]";
	mes "什么……什么啊，一点也不好玩。";
	mes "我完全搞不懂他。";
	completequest 10018;
	set .@er1,checkquest(10018);
	set .@er2,checkquest(10019);
	set .@er3,checkquest(10020);
	set .@er4,checkquest(10021);
	set .@er5,checkquest(10022);
	if ((.@er1 + .@er2 + .@er3 + .@er4 + .@er5) == 10) {
		setquest 10023;
		set nkprince_eisen,11;
	}
	donpcevent "Prince#eisen4::OnDisable";
	close;

OnInit:
	disablenpc "Prince#eisen4";
	end;

OnEnable:
	enablenpc "Prince#eisen4";
	end;

OnDisable:
	disablenpc "Prince#eisen4";
	end;
}

prt_castle,364,372,1	script	Prince#eisen5	983,{
	mes "[Ahrum]";
	mes "彼得，如果你的工作毫无意义，你会怎么办？";
	next;
	mes "[Peter]";
	mes "……我不知道你在说什么，但没有什么事是毫无意义的。我想你并不了解这一点。";
	next;
	mes "[Ahrum]";
	mes "嗡嗡。你错了。有些事本身就是没有意义的。直白地说，不知道意义的行动就是无意义的……";
	next;
	mes "[Peter]";
	mes "你是想解释清楚吗……？事情变得更复杂了。你到底想说什么？直接告诉我吧。";
	next;
	mes "[Ahrum]";
	mes "……无论我做什么或不做什么，我都只是被某种东西操纵着。更糟的是，我还因此伤害了别人。";
	next;
	mes "[Peter]";
	mes "......";
	next;
	mes "[Ahrum]";
	mes "最糟糕的是，我觉得了解并理解那件事本身后，自己变得胆怯了……";
	next;
	mes "[Ahrum]";
	mes "你也是一样。如果真的想向那个女孩表达感谢，就应该亲自去见她。你做不到，对吧？";
	next;
	mes "[Peter]";
	mes "……阿赫鲁姆，你怎么了？你不是我认识的那个阿赫鲁姆。是什么让你变成这样？";
	next;
	mes "[Ahrum]";
	mes "哼……那件事。什么都不是。毫无意义。现实，仅此而已。和你聊天很愉快。再见，今后就像过去一样生活吧。";
	next;
	mes "[Peter]";
	mes "……艾根·阿赫鲁姆。你……";
	next;
	mes "- 阿赫鲁姆露出阴郁的表情，离开了房间。-";
	next;
	mes "[Peter]";
	mes "......";
	completequest 10019;
	set .@er1,checkquest(10018);
	set .@er2,checkquest(10019);
	set .@er3,checkquest(10020);
	set .@er4,checkquest(10021);
	set .@er5,checkquest(10022);
	if ((.@er1 + .@er2 + .@er3 + .@er4 + .@er5) == 10) {
		setquest 10023;
		set nkprince_eisen,11;
	}
	donpcevent "Prince#eisen5::OnDisable";
	close;

OnInit:
	disablenpc "Prince#eisen5";
	end;

OnEnable:
	enablenpc "Prince#eisen5";
	end;

OnDisable:
	disablenpc "Prince#eisen5";
	end;
}

prt_castle,368,310,1	script	Prince#eisen6	983,{
	mes "[Ernst]";
	mes "哥哥，再说一遍。你刚才说了什么？";
	next;
	mes "[Ahrum]";
	mes "好，我告诉你。这个卢恩·米德加尔特就是垃圾场。你我都在垃圾堆里挣扎，即使无法回收，我们也和它一样。";
	next;
	mes "[Ernst]";
	mes "哥哥，怎么了？你疯了吗？";
	next;
	mes "[Ahrum]";
	mes "疯了？我清醒得很……嗯……我只是受够了这令人作呕的现实，我亲爱的弟弟。";
	next;
	mes "[Ernst]";
	mes "现实？什么现实？你看到了什么？你不像原来的你了。我完全帮不了你！";
	next;
	mes "[Ahrum]";
	mes "我还是原来的我，恩斯特。只是现实很肮脏，我意识到自己被困在污秽里，无法逃脱。";
	next;
	mes "[Ernst]";
	mes "骗子！你总说自己的书里有无限可能！你一直都表现得很骄傲！";
	next;
	mes "[Ahrum]";
	mes "闭嘴。";
	next;
	mes "[Ernst]";
	mes "这很肮脏，也很糟糕。所以我们应该纠正它。我们已经知道这种情况了，你为什么还要这样做！！";
	next;
	mes "[Ahrum]";
	mes "……我告诉过你，别发出声音！";
	next;
	mes "[Ernst]";
	mes "不。腐败是双方同意的，你把我带到这里，而因为你的存在，我可以依靠你！";
	next;
	mes "[Ahrum]";
	mes "闭嘴，闭嘴!!!!!!!!!!!!";
	next;
	mes "[Ernst]";
	mes "......!";
	next;
	mes "[Ahrum]";
	mes "不能接受毫无意义的行动！被污秽操纵令人恶心。我曾经无知，以为自己按意志行动，现在才意识到自己被操纵了！";
	next;
	mes "[Ahrum]";
	mes "国王？！那又怎样？！什么都不是！即使创造新世界，也不会改变任何事！！我们就像戏剧中的角色。一幅画只是某人的意图……只是被画出来的！！对吧？！";
	next;
	mes "[Ernst]";
	mes "你在说什么？我完全听不懂！你是说自己不处于现状吗？是吗？你到底在说什么！";
	next;
	mes "[Ahrum]";
	mes "闭嘴！什么都不知道的话，你连什么时候会被杀都不知道。你还不明白我……啊……！你不该知道这些！";
	next;
	mes "[Ernst]";
	mes "哥……哥哥，你要继续坚持吗？我们的关系就这么短暂吗？";
	next;
	mes "[Ahrum]";
	mes "闭嘴！如果你不满意，就按约定杀了我！你……我……我……！！我不想再谈了，我要回房间！";
	next;
	mes "[Ernst]";
	mes "啊，等一下，哥哥！阿鲁姆！";
	next;
	mes "[Ahrum]";
	mes "我……不知道！国王……你！";
	next;
	mes "-Ahrum blushes";
	mes "并离开房间。他看起来筋疲力尽。-";
	next;
	mes "[Ernst]";
	mes "阿鲁姆……阿鲁姆……";
	changequest 10023,10024;
	set nkprince_eisen,13;
	donpcevent "Prince#eisen6::OnDisable";
	close;

OnInit:
	disablenpc "Prince#eisen6";
	end;

OnEnable:
	enablenpc "Prince#eisen6";
	end;

OnDisable:
	disablenpc "Prince#eisen6";
	end;
}

prt_castle,318,276,0	script	#eisen	45,1,1,{
OnTouch_:
	if ((nkprince_eisen == 4) || (nkprince_eisen == 5)) {
		donpcevent "Prince#another_ern::OnEnable";
		set nkprince_eisen,5;
		warp "prt_castle",318,368;
	}
	else if ((nkprince_eisen == 9) || (nkprince_eisen == 10) || (nkprince_eisen == 11) || (nkprince_eisen == 12)) {
		set .@armkoe,rand(1,4);
		if (.@armkoe == 1) {
			mes "- 你能听到阿赫鲁姆的声音";
			mes "进入他的房间前";
			mes "声音从里面传来。-";
			next;
			mes "[Ahrum]";
			mes "我不具备那种资格。我在如此肮脏的地方长大，曾经那么无知！";
			next;
			mes "[Ahrum]";
			mes "国王的资质是什么？什么又是清廉的政治……？啊啊啊啊啊！！";
			next;
			mes "[" + strcharinfo(0) + "]";
			mes "......";
			close2;
		}
		else if (.@armkoe == 2) {
			mes "- 你能听到阿赫鲁姆的声音";
			mes "进入他的房间前";
			mes "声音从里面传来。-";
			next;
			mes "[Ahrum]";
			mes "骄傲的家族……？有名……";
			mes "出身……？王族……？那到底是什么？";
			next;
			mes "[Ahrum]";
			mes "对恩斯特哥哥来说，我的家族就是罪。我也是罪的一部分。作为家族的一员，家族的罪等同于我的罪。";
			next;
			mes "[Ahrum]";
			mes "我再也……掩盖不了了……恩……我希望连你也……";
			next;
			mes "[" + strcharinfo(0) + "]";
			mes "......";
			close2;
		}
		else if (.@armkoe == 3) {
			mes "- 你能听到阿赫鲁姆的声音";
			mes "在进入他的房间前，";
			mes "声音从里面传来。-";
			next;
			mes "[Ahrum]";
			mes "到头来，我只是被利用……我竭尽全力成为主角，也只是剧本的一部分……";
			next;
			mes "[Ahrum]";
			mes "该死！可恶……！！";
			mes "我无法接受。绝不，绝不！";
			next;
			mes "[Ahrum]";
			mes "我的祖先 ^FF0000施密特^000000……你会如何面对这种情况？不……你也和我一样被别人利用了吗？";
			next;
			mes "[" + strcharinfo(0) + "]";
			mes "......";
			close2;
		}
		else if (.@armkoe == 4) {
			mes "-我能听到阿鲁姆的声音，";
			mes "进入他的房间前";
			mes "声音从里面传来。-";
			next;
			mes "[Ahrum]";
			mes "不，不行……不……在这个阶段，我会成为国王。我不该成为国王……恩……你不该忘记真正国王的意义。";
			next;
			mes "[Ahrum]";
			mes "为了真正国王的出现……今晚我会……为你走入黑暗……啊啊啊啊啊！！！";
			next;
			mes "[" + strcharinfo(0) + "]";
			mes "......";
			close2;
		}
		warp "prt_castle",318,368;
	}
	else if (nkprince_eisen == 13) {
		donpcevent "Prince#another_ern::OnEnable";
		warp "prt_castle",318,368;
	}
	else if (nkprince_eisen == 15) {
		warp "prt_castle",318,309;
	}
	else {
		warp "prt_castle",318,368;
	}
	end;
}


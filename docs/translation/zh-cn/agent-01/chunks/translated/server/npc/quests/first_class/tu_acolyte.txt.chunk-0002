		mes "想出答案。";
		mes "仔细思考，";
		mes "答案自然会出现。";
		tu_acolyte01 = 12;
		close;
	case 13:
		mes "你记得学会祝福后，";
		mes "就能学习神圣保护，";
		mes "对吧？";
		next;
		mes "[阿斯特]";
		mes "打开技能窗口后，你会看到根据神圣保护等级，";
		mes "还可以学习 ^3131FF天使之击^000000 和 ^3131FF天使之护^000000。";
		next;
		mes "[阿斯特]";
		mes "^3131FF天使之击^000000 会提高对不死和恶魔怪物的攻击力，";
		mes "对我们这些侍奉神明、驱逐邪恶的人很有用。";
		next;
		mes "[阿斯特]";
		mes "学会 3 级天使之击后，就能学习 ^3131FF十字驱魔^000000，降低目标不死或幽灵怪物的防御。";
		specialeffect EF_SIGNUM;
		next;
		mes "[阿斯特]";
		mes "^3131FF天使之赐福^000000 会提高队伍成员（包括你自己）的防御力。效果受 VIT 属性影响，VIT 越高，效果越好。";
		specialeffect EF_ANGELUS;
		next;
		mes "[阿斯特]";
		mes "神圣保护的说明";
		mes "就到这里。";
		mes "进入下一课前先休息一下，";
		mes "好吗？我会在这里等着。";
		tu_acolyte01 = 14;
		close;
	case 14:
		mes "现在开始";
		mes "下一课。";
		mes "我们来谈谈";
		mes "^3131FF敏捷提升^000000 技能是";
		mes "治愈技能树的内容。";
		next;
		mes "[阿斯特]";
		mes "学会 3 级 ^3131FF治愈术^000000 后可以学习敏捷提升。顾名思义，敏捷提升会暂时提高目标的 ^3131FF敏捷（AGI）^000000。";
		next;
		mes "[阿斯特]";
		mes "敏捷提升还会增加";
		mes "^3131FFDodge Rate^000000,";
		mes "^3131FF攻击速度^000000，";
		mes "以及 ^3131FF移动速度^000000。";
		next;
		mes "[阿斯特]";
		mes "自己试试看，";
		mes "好吗？";
		tu_acolyte01 = 15;
		npcskill "AL_INCAGI",10,0,0;
		close;
	case 15:
		mes "学会 1 级敏捷提升后，";
		mes "就可以开始学习";
		mes "^3131FFDecrease AGI^000000.";
		next;
		mes "[阿斯特]";
		mes "正如你所料，敏捷下降会减慢敌人，降低其敏捷、移动速度、闪避率和攻击速度。效果与敏捷提升完全相反。";
		tu_acolyte01 = 15;
		next;
		mes "[阿斯特]";
		mes "治愈技能树的最后一项是 ^3131FF治愈^000000。学会 2 级治愈术后即可学习治愈。";
		next;
		mes "[阿斯特]";
		mes "治愈可以移除异常状态，";
		mes "例如 ^3131FF沉默^000000、^3131FF诅咒^000000";
		mes "和 ^3131FF石化诅咒^000000。对不死怪物使用时，治愈反而会";
		mes "对其施加诅咒。";
		specialeffect EF_CURE;
		next;
		mes "[阿斯特]";
		mes "现在请记住，敏捷提升、敏捷下降和";
		mes "治愈技能只能通过学习";
		mes "治愈技能来获得。";
		tu_acolyte01 = 16;
		close;
	case 16:
		mes "你学得真快。";
		mes "我很高兴我们";
		mes "这么快就到这一步了。";
		next;
		mes "[阿斯特]";
		mes "成为服事者后，";
		mes "就可以学习 ^3131FF光猎^000000 技能。";
		next;
		mes "[阿斯特]";
		mes "光猎用于侦测 ^3131FF隐藏的敌人^000000。法师有类似的洞察技能，但只能侦测敌人；光猎会同时侦测并";
		mes "伤害隐藏的敌人。";
		specialeffect EF_RUWACH;
		next;
		mes "[阿斯特]";
		mes "学会光猎后，";
		mes "就能学习 ^3131FF瞬间移动^000000。瞬间移动会将你立刻传送到地图随机位置或保存点。";
		next;
		mes "[阿斯特]";
		mes "学会 2 级瞬间移动后，可以学习 ^3131FF传送之阵^000000，消耗 ^FF00001 蓝色魔力矿石^000000 将你传送到记忆点或保存目的地。";
		next;
		mes "[阿斯特]";
		mes "掌握传送之阵后，可以 ^3131FF记忆三个记忆点^000000。大多数原野或地下城无法保存记忆点，但可以在";
		mes "城镇和部分原野使用 ^FF0000/memo^000000 命令。";
		next;
		mes "[阿斯特]";
		mes "是不是很难理解？";
		mes "只要记住，瞬间移动和传送之阵";
		mes "能让侍奉神明的人";
		mes "快速往返各地。";
		next;
		mes "[阿斯特]";
		mes "我把家和修道院保存为记忆点，所以只要在工作和家之间来回传送即可。";
		next;
		mes "[阿斯特]";
		mes "现在……";
		mes "最后一项技能";
		mes "光猎技能树中的";
		mes "一项技能叫 ^3131FF霸邪之阵^000000。";
		next;
		mes "[阿斯特]";
		mes "霸邪之阵能保护 3×3 格、共 9 格范围内的角色免受^FF0000远程攻击^000000。若与弓箭手或其他弓类使用者组队，请小心不要误挡他们的攻击。";
		specialeffect2 EF_PNEUMA;
		next;
		mes "[阿斯特]";
		mes "有些不死怪物可以远程攻击，";
		mes "所以用霸邪之阵保护自己，再用治愈攻击是不错的策略。";
		next;
		mes "[阿斯特]";
		mes "这节课讲了不少";
		mes "复杂内容。想再听一遍吗？";
		next;
		if(select("再听一遍。:进入下一个主题。")==1){
			mes "[阿斯特]";
			mes "好，";
			mes "让我喘口气～";
		} else {
			mes "[阿斯特]";
			mes "呵呵！";
			mes "真聪明的服事者～";
			tu_acolyte01 = 17;
		}
		close;
	case 17:
		mes "哎呀……！";
		mes "这些东西全都误送给我了！其中一些包裹本来应该";
		mes "送到普隆德拉圣堂！";
		next;
		mes "[阿斯特]";
		mes "能再帮我一个忙吗？请把邮件分别送到这里和普隆德拉教会，";
		mes "我实在没有时间。";
		next;
		mes "[阿斯特]";
		mes "有些邮件似乎比其他的更紧急，请按指定顺序投递。";
		next;
		mes "[阿斯特]";
		mes "第一件包裹给北边的工人，他叫 ^3131FF维纳^000000。下一件给修道院入口附近的 ^3131FF赫德里克^000000。";
		next;
		mes "[阿斯特]";
		mes "第三件来自铁匠公会，给制作武僧武器和护甲的 ^3131FF铁匠^000000。第四件送给隔壁建筑的 ^3131FF卡文牧师^000000。";
		next;
		mes "[阿斯特]";
		mes "最后一件是给 ^3131FF普劳平牧师^000000 的收据，就是告诉你我的那位牧师。";
		mes "给你，信件和包裹……";
		if(MaxWeight - Weight < 2430){
			next;
			mes "[阿斯特]";
			mes "哦……！";
			mes "你的空间似乎不够";
			mes "携带这些东西。";
			mes "先把一些物品放进卡普拉仓库吧？";
		} else {
			tu_acolyte01 = 18;
			getitem 7183,1; //Sister_Letter
			getitem 7181,1; //Receipt_01
			getitem 1081,2; //Merchant_Box_1
			getitem 7148,1; //Mother_Letter
		}
		close;
	case 18:
	case 19:
	case 20:
	case 21:
	case 22:
		mes "好，别忘了";
		mes "信件和包裹的";
		mes "投递顺序，";
		mes "这非常重要。";
		next;
		mes "[阿斯特]";
		mes "第一件给北边的工人 ^3131FF维纳^000000。下一件给修道院入口附近的 ^3131FF赫德里克^000000。";
		next;
		mes "[阿斯特]";
		mes "第三件来自铁匠公会，给制作武僧武器和护甲的 ^3131FF铁匠^000000。第四件送给隔壁建筑的 ^3131FF卡文牧师^000000。";
		next;
		mes "[阿斯特]";
		mes "最后一件是给告诉你我的 ^3131FF普劳平牧师^000000 的收据。好，旅途平安～";
		close;
	case 23:
		mes "啊，你完成了所有投递吗？";
		mes "非常感谢！这么久没见普劳平牧师，感觉怎么样？";
		next;
		mes "[阿斯特]";
		mes "我们一生中会与他人建立关系，而关于他们的记忆会永远留在心中。";
		next;
		mes "[阿斯特]";
		mes "感到孤独时，让那些记忆穿透黑暗的阴霾。在艰难时刻，想起在乎的人就能治愈情感创伤。";
		next;
		mes "[阿斯特]";
		mes "珍惜当下的人才能建立长久关系，也会最先拥抱未来的幸福。记住这一点。";
		next;
		mes "[阿斯特]";
		mes "我感觉你已经成为普劳平牧师的好朋友。希望他也一直是你的好朋友。";
		next;
		mes "[阿斯特]";
		mes "好，那么下次";
		mes "见面时，";
		mes "我会给你";
		mes "最后一课。";
		tu_acolyte01 = 24;
		close;
	case 24:
		mes "最后一项我要教你的技能是 ^3131FF圣水^000000。";
		next;
		mes "[阿斯特]";
		mes "水太常见了，以至于我们忘了它是自然的核心。它很基础，却不可或缺。";
		next;
		mes "[阿斯特]";
		mes "像这样把水放进杯子，集中全部神圣能量……然后……";
		next;
		specialeffect EF_AQUA;
		mes "[阿斯特]";
		mes "圣水";
		mes "诞生！";
		next;
		mes "[阿斯特]";
		mes "这就是制作 ^3131FF圣水^000000 的方法。记住，使用圣水技能时 ^3131FF双脚必须接触水面^000000。";
		next;
			mes "[阿斯特]";
		mes "呵呵～";
		mes "好了，我要教你的";
		mes "就这些。";
		mes "过程也许很辛苦，";
		mes "但你做得很好。";
		next;
			mes "[阿斯特]";
		mes "哦！回到普隆德拉圣堂后，也许能学习秘密技能。不妨去看看。";
		next;
			mes "[阿斯特]";
		mes "别忘了我教你的内容。希望你会怀念我们在美丽花朵间共度的时光。愿神保佑你～";
		tu_acolyte01 = 25;
		if (checkre(3))
			getexp 1000,1000;
		else
			getexp 5000,3000;
		specialeffect2 EF_CONE;
		close;
	}
	mes "如果你和别人发生争执，";
	mes "不妨一起吃顿热乎乎的饭，";
	mes "边吃边把话说开。";
	next;
			mes "[阿斯特]";
	mes "温暖美味的食物下肚后，所有怒气都会像雪一样融化。";
	next;
			mes "[阿斯特]";
	mes "我可不是在开玩笑！";
	mes "如果你碰巧和亲近的人吵架了，这个办法也许有用。我可是根据亲身经历说的。";
	close;
}


// Priest Gardron
//============================================================
monk_in,18,38,6	script	Priest Gardron#tu	4_M_MINISTER,{
	mes "[Priest Gardron]";
	if(tu_acolyte01 == 7){
		if(countitem(7148) >= 1){// Mother_Letter
			mes "Hmm...?";
			mes "那是什么？";
			mes "你有东西要给我吗？";
			next;
			emotion ET_SURPRISE;
			mes "[Priest Gardron]";
			mes "哦！这是家乡母亲寄来的信。年轻的服事，谢谢你把它带给我。";
			next;
			mes "[Priest Gardron]";
			mes "我一直很担心她，";
			mes "尤其是她现在年纪大了，";
			mes "但听说她身体健康，我就放心了。";
			mes "我们真的受到了祝福……";
			delitem 7148,1; //Mother_Letter
			tu_acolyte01 = 8;
		} else {
			mes "Hmm...?";
			mes "那是什么？";
			mes "你有东西要给我？";
			mes "你说是一封信？";
			next;
			mes "[Priest Gardron]";
			mes "嗯，看起来你一定是忘了带，";
			mes "或者把它放在某个地方弄丢了。";
			mes "请再找找看。";
		}
		close;
	} else if(tu_acolyte01 == 8){
		if(countitem((checkre(0)?939:957)) > 4){// Bee_Sting
			mes "哦……！";
			mes "你回来了！";
			mes "让我看看……一、";
			mes "二、三……";
			next;
			mes "[Priest Gardron]";
			mes "非常感谢！";
			mes "你代表修道院做得很棒，";
			mes "不仅如此，";
			mes "你还保护了";
			mes ""+(checkre(0)?"普隆德拉":"斐扬")+"的居民免受危险。";
			mes "愿神保佑你。";
			next;
			mes "[Priest Gardron]";
			mes "愿你永远受到祝福。现在，";
			mes "回到阿斯特修女那里，";
			mes "继续你的服事训练吧。";
			mes "愿神与你同在。";
			mes "一路小心。";
			tu_acolyte01 = 9;
			percentheal 100,100;
			if (checkre(3))
				getexp 1000,1000;
			else
				getexp 2000,2000;
			specialeffect2 EF_CONE;
			//getitem 505,1; //Blue_Potion
			close;
		} else {
			if (checkre(0)) {
				mes "几天前，普隆德拉的一位修女发来电报，";
				mes "说西部原野的黄蜂伤害了居民，";
				mes "所以她请求修道院帮忙处理。";
				mes "我们必须尽快采取行动。";
				next;
				mes "[Priest Gardron]";
				mes "但现在，";
				mes "我们这里也人手不足……";
				mes "所以事情很棘手。";
				next;
				mes "[Priest Gardron]";
				mes "....!";
				emotion ET_SURPRISE;
				next;
				mes "[Priest Gardron]";
				mes "服事"+strcharinfo(0)+"，我可以把这件紧急的事交给你吗？";
				mes "请处理在^FF0000普隆德拉西部原野^000000肆虐的黄蜂。";
				mes "它们给居民带来了麻烦。";
				mes "拜托你了。";
				next;
				mes "[Priest Gardron]";
				mes "我知道你正在接受修行，";
				mes "如果你带回 ^3131FF5 个^000000 ^3131FF蜂针^000000，";
				mes "我会给你一些帮助。";
				next;
				mes "[Priest Gardron]";
				mes "你要去普隆德拉吗？";
				next;
				if(select("去普隆德拉吧！:我准备好后再回来。") == 1) {
					mes "[Priest Gardron]";
					mes "好的，我会把你送到普隆德拉。";
					mes "请处理黄蜂，并带回 5 个蜂针作为证明。";
					mes "主啊，请保护这位服事免受邪恶怪物伤害。";
					close2;
					warp "prontera",116,72;
					end;
				}
			} else {
				mes "刚才斐扬长老给我捎来消息，";
				mes "据说斐扬的居民正在遭受僵尸袭击。";
				next;
				mes "[Priest Gardron]";
				mes "他请求修道院援助，但我们遇到了大问题。";
				mes "这里能处理这种情况的人手快用光了……";
				next;
				mes "[Priest Gardron]";
				mes "....!";
				emotion ET_SURPRISE;
				next;
				mes "[Priest Gardron]";
				mes ""+strcharinfo(0)+",";
				mes "我可以请你";
				mes "负责这项任务吗？";
				mes "请消灭斐扬地下城里的骷髅和僵尸。";
				mes "斐扬地下城一楼。";
				next;
				mes "[Priest Gardron]";
				mes "既然你还在基础训练阶段，";
				mes "带着材料回来时我会帮你。";
				mes "带回 ^3131FF5 个腐朽的指甲^000000。";
				next;
				mes "[Priest Gardron]";
				mes "那么……";
				mes "你要去斐扬吗？";
				next;
				if(select("去斐扬吧！:嗯，我先准备一下。") == 1) {
					mes "[Priest Gardron]";
					mes "很好，很好。";
					mes "我会把你送到那里，";
					mes "去斐扬地下城击杀怪物，带回 5 个腐朽的指甲。愿神保佑你……";
					close2;
					warp "payon",161,58;
					end;
				}
			}
			close;
		}
	}
	mes "愿光明永远";
	mes "照亮黑暗。";
	mes "在艰难时刻，请记住";
	mes "没有希望，";
	mes "就不会有奇迹……";
	close;
}

// Dog
//============================================================
prt_monk,235,245,5	script	Dog#tu	4_DOG01,{
	mes "[Dog]";
	mes "^CDB79EBark bark!";
	mes "Woof woof!^000000";
	next;
	if(tu_acolyte01 == 10){
		while(1) {
			switch(select("给它零食。:抚摸小狗。:结束互动。")){
			case 1:
				.@dog_food++;
				if(.@dog_food > 4){
					mes "[Dog]";
					mes "^CDB79EGrrrrrr...!^000000";
					emotion ET_FRET;
					next;
					mes "^3355FF小狗露出牙齿，";
				mes "露出牙齿，";
				mes "威吓地瞪着你。^000000";
				} else {
					mes "[Dog]";
					mes "^CDB79ERoof roof!^000000";
					emotion ET_THROB;
				}
				break;
			case 2:
				mes "[Dog]";
				mes "^CDB79ERoof roof~^000000";
				emotion ET_THROB;
				break;
			case 3:
				mes "[Dog]";
				mes "^CDB79ERoof roof!^000000";
				break;
			}
			next;
		}
	}
	mes "["+strcharinfo(0)+"]";
	mes "真可爱～！";
	close;
}


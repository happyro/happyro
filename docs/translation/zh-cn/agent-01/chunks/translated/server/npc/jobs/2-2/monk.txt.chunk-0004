			case 2: mes "为你，我的主，为你。"; break;
			case 3: mes "力量降临"; break;
			case 4:
				set .@monk_t,.@monk_t+10;
				mes "让我们的双脚迅速承载";
				break;
			case 5: mes "来自那只手"; break;
			case 6: mes "让我们的双脚迅速承载"; break;
			case 7: mes "向你流淌河流，并"; break;
			case 8: mes "因父及子之名"; break;
			case 9: mes "永远充满灵魂"; break;
			case 10: mes "及圣灵之名。"; break;
			}
			switch(select("为你，我的主，为你。:力量降临:我们将成为牧者，:来自那只手:让我们的双脚迅速承载:向你流淌河流，并:遵从你的命令。我们将:永远充满灵魂:因父及子之名:及圣灵之名。")) {
			case 1: mes "为你，我的主，为你。"; break;
			case 2: mes "力量降临"; break;
			case 3: mes "我们将成为牧者，"; break;
			case 4: mes "来自那只手"; break;
			case 5: mes "让我们的双脚迅速承载"; break;
			case 6: mes "向你流淌河流，并"; break;
			case 7:
				set .@monk_t,.@monk_t+10;
				mes "遵从你的命令。我们将";
				break;
			case 8: mes "永远充满灵魂"; break;
			case 9: mes "因父及子之名"; break;
			case 10: mes "及圣灵之名。"; break;
			}
			switch(select("为你，我的主，为你。:永远充满灵魂:向你流淌河流，并:因父及子之名:及圣灵之名。:力量降临:我们将成为牧者，:让我们的双脚迅速承载:来自那只手:遵从你的命令。我们将")) {
			case 1: mes "为你，我的主，为你。"; break;
			case 2: mes "永远充满灵魂"; break;
			case 3:
				set .@monk_t,.@monk_t+10;
				mes "向你流淌河流，并";
				break;
			case 4: mes "因父及子之名"; break;
			case 5: mes "及圣灵之名。"; break;
			case 6: mes "力量降临"; break;
			case 7: mes "我们将成为牧者，"; break;
			case 8: mes "让我们的双脚迅速承载"; break;
			case 9: mes "来自那只手"; break;
			case 10: mes "遵从你的命令。我们将"; break;
			}
			switch(select("永远充满灵魂:因父及子之名:我们将成为牧者，:为你，我的主，为你。:力量降临:来自那只手:让我们的双脚迅速承载:遵从你的命令。我们将:向你流淌河流，并:及圣灵之名。")) {
			case 1:
				set .@monk_t,.@monk_t+10;
				mes "永远充满灵魂";
				break;
			case 2: mes "因父及子之名"; break;
			case 3: mes "我们将成为牧者，"; break;
			case 4: mes "为你，我的主，为你。"; break;
			case 5: mes "力量降临"; break;
			case 6: mes "来自那只手"; break;
			case 7: mes "让我们的双脚迅速承载"; break;
			case 8: mes "遵从你的命令。我们将"; break;
			case 9: mes "向你流淌河流，并"; break;
			case 10: mes "及圣灵之名。"; break;
			}
			switch(select("力量降临:为你，我的主，为你。:我们将成为牧者，:因父及子之名:让我们的双脚迅速承载:来自那只手:永远充满灵魂:向你流淌河流，并:遵从你的命令。我们将:及圣灵之名。")) {
			case 1: mes "力量降临"; break;
			case 2: mes "为你，我的主，为你。"; break;
			case 3: mes "我们将成为牧者，"; break;
			case 4:
				set .@monk_t,.@monk_t+10;
				mes "因父及子之名";
				break;
			case 5: mes "让我们的双脚迅速承载"; break;
			case 6: mes "来自那只手"; break;
			case 7: mes "永远充满灵魂"; break;
			case 8: mes "向你流淌河流，并"; break;
			case 9: mes "遵从你的命令。我们将"; break;
			case 10: mes "及圣灵之名。"; break;
			}
			switch(select("我们将成为牧者，:为你，我的主，为你。:力量降临:来自那只手:遵从你的命令。我们将:让我们的双脚迅速承载:向你流淌河流，并:永远充满灵魂:因父及子之名:及圣灵之名。")) {
			case 1: mes "我们将成为牧者，"; break;
			case 2: mes "为你，我的主，为你。"; break;
			case 3: mes "力量降临"; break;
			case 4: mes "来自那只手"; break;
			case 5: mes "遵从你的命令。我们将"; break;
			case 6: mes "让我们的双脚迅速承载"; break;
			case 7: mes "向你流淌河流，并"; break;
			case 8: mes "永远充满灵魂"; break;
			case 9: mes "因父及子之名"; break;
			case 10:
				set .@monk_t,.@monk_t+10;
				mes "及圣灵之名。";
				break;
			}
		}
		next;
		mes "[图哈]";
		mes "...";
		next;
		mes "[图哈]";
		mes "嗯……";
		next;
		if (.@monk_t > 90) {
			set MONK_Q,14;
			changequest 3025,3026;
			mes "[图哈]";
			mes "……做得好，完美无缺。你很专心……";
			next;
			mes "[图哈]";
			mes "不过现在还不是放松的时候。你的道路仍很漫长。";
			next;
			mes "[图哈]";
			mes "如我所承诺，现在我会帮助强化你的身体。";
			next;
			mes "集中精神，不要动。";
			next;
			mes "^33CCFF你感觉风环绕全身。^000000";
			next;
			mes "^33CCFF体内的能量正在增长。^000000";
			next;
			mes "[图哈]";
			mes "我能感受到你体内的成长。";
			mes "你现在可以继续前进……";
			next;
			mes "[图哈]";
			mes "……下一阶段由布海负责。";
			next;
			mes "[图哈]";
			mes "祝你旅途顺利。";
			mes "别忘了，他的名字是 ^CC0000布海^000000。";
			close;
		}
		else {
			mes "[图哈]";
			mes "看来你没有专心……想成为武僧就必须认真。";
			next;
			mes "[图哈]";
			mes "也许武僧之路对你太难？";
			mes "想继续就必须认真……";
			next;
			mes "[图哈]";
			mes "我再给你一次机会。";
			next;
			mes "[图哈]";
			mes "如果你不能专心复述我的要求，我不会让你继续在这里训练……";
			close;
		}
	}
	else if (MONK_Q == 14) {
		mes "[图哈]";
		mes "嗯……你忘了该拜访谁吗？";
		next;
		mes "[图哈]";
		mes "连这么简单的事都记不住，我很怀疑你的能力。";
		next;
		mes "[图哈]";
		mes "……你在考验我的耐心吗？";
		next;
		mes "[图哈]";
		mes "你正在耗尽我的耐心……";
		mes "……去找布海吧。";
		close;
	}
	else if (MONK_Q > 14 && BaseJob == Job_Acolyte) {
		mes "[图哈]";
		mes "……为最终测试加油。";
		close;
	}
	else {
		mes "[图哈]";
		mes "绝不让无辜者流血。";
		next;
		mes "[图哈]";
		mes "但恶人的鲜血将如河流般流淌。";
		next;
		mes "[图哈]";
		mes "我们将展开漆黑的翅膀，成为上帝复仇的铁锤。";
		next;
		mes "[图哈]";
		mes "我们将向你流淌河流，永远充满灵魂。";
		next;
		mes "[图哈]";
		mes "因父及子之名, 及圣灵之名。";
		next;
		mes "[图哈]";
		mes "……你不必害怕我……";
		close;
	}
}

prt_monk,57,179,1	script	Boohae#mk	110,{
	if (MONK_Q == 14 && BaseJob == Job_Acolyte) {
		mes "[Boohae]";
		mes "...";
		next;
		mes "[Boohae]";
		mes "......";
		next;
		mes "[Boohae]";
		mes ".........";
		next;
		mes "[Boohae]";
		mes "............";
		next;
		select("...excuse me...?");
		mes "[Boohae]";
		mes "...";
		mes "你打断了我的冥想，我应该打断你的腿……";
		next;
		mes "[Boohae]";
		mes "........";
		mes "我给你机会解释为何打断我。";
		next;
		mes "[Boohae]";
		mes ".....";
		next;
		mes "[Boohae]";
		mes "开始解释吧……否则你很快就得爬行……";
		next;
		if (select("透羽派我来的。:抱歉，没什么事。") == 2) {
			mes "[Boohae]";
			mes "........";
			mes "……你故意打断我，肯定是活腻了……";
			close;
		}
		mes "[Boohae]";
		mes "我明白了……那么，让我看看……";
		next;
		mes "[Boohae]";
		mes "……你的身体似乎……";
		mes "已经强化。很好……";
		next;
		mes "[Boohae]";
		mes "你对图哈做了什么？";
		next;
		switch(select("嗯……这个……啊……:我们宣读了神圣誓言。:他诊断了我的身体状况。")) {
		case 1:
		mes "[Boohae]";
			mes "连简单问题都答不上，你还没准备好。别打扰我祈祷。";
			close;
			case 2:
			mes "[Boohae]";
			mes "... I see...";
		mes "他没为你做任何事吗？";
			next;
			switch(select("嗯……这个……啊……:他诊断了我的身体状况。:他教我如何成为武僧。:他改造了我的身体。")) {
			case 1:
			mes "[Boohae]";
			mes "连简单问题都答不上，你还没准备好。别打扰我祈祷。";
			close;
				case 2:
				mes "[Boohae]";
				mes "那对我来说不重要……别再打扰我，走开！";
				close;
				case 3:
			mes "[Boohae]";
				mes "成为武僧的教诲要在成为武僧后学习。这不是我想找的答案……";
				close;
				case 4:
				mes "[Boohae]";
			mes "很好，你似乎意识到体内有了新力量。那么，我们继续下一步……";
				next;
				break;
				}
				break;
			case 3:
				mes "[Boohae]";
				mes "……你打断我就是为了告诉我这个……？";
				mes "在我打断你的腿前滚开……";
				close;
				}
			mes "[Boohae]";
			mes "好吧……我们有两项测试……选择你想进行的那一项……";
		next;
			if (select("采集蘑菇:马拉松") == 1) {
			set MONK_Q,15;
			changequest 3026,3027;
			mes "[Boohae]";
		mes "嗯……采蘑菇。你是想测试自己的耐力吗？";
		mes "准备好后再回来。";
		close;
		}
		set MONK_Q,16;
		changequest 3026,3028;
			mes "[Boohae]";
			mes "明智的选择。将身体极限推向边界能获得更强的自制力。";
			mes "准备好后再回来。";
			close;
			}
			if (MONK_Q == 15) {
		mes "[Boohae]";
		mes "那么准备好了吗？你只需要坚定的决心。";
		next;
		mes "[Boohae]";
		mes "采集蘑菇测试旨在";
		mes "考验你的耐心。";
		next;
	mes "[Boohae]";
	mes "进入修道院附近的建筑。";
		next;
		mes "[Boohae]";
		mes "其他武僧候选人也会参加同一测试，";
		next;
		mes "[Boohae]";
		mes "人越多，能找到的蘑菇越少。";
		mes "希望你理解，他们和你一样都在考验耐心。";
		close;
		}
		if (MONK_Q == 16) {
		mes "[Boohae]";
		mes "欢迎回来，准备好了吗？你只需要强健的双腿。";
		next;
		mes "[Boohae]";
		mes "马拉松旨在";
		mes "测试你的自制力。";
		next;
	mes "[Boohae]";
	mes "进入修道院附近的建筑。";
		next;
		mes "[Boohae]";
		mes "你只需按要求绕建筑跑足够次数。";
		mes "那么……出发吧。";
		close;
		}
		if (MONK_Q == 17) {
		mes "[Boohae]";
		mes "现在去拜访“托蒙”。我还要说多少次？";
		mes "你现在很疲惫，再继续可能会伤害身体。";
		mes "‘多木’住在这座修道院附近一栋建筑的最深处。";
		close;
		}
		if (MONK_Q > 17 && MONK_Q < 24) {
	mes "[Boohae]";
	mes "...........";
		next;
		mes "-他似乎正在冥想。-";
		close;
		}
		else {
	mes "[Boohae]";
	mes "嗯嗯嗯……！！";
		next;
		mes "-他似乎正在冥想。-";
		close;
		}
		}
	
	prt_monk,199,169,3	script	Door Keeper#mk	746,{
		mes "[Keeper Chorip]";
		mes "……这里是给那些";
		mes "正在接受武僧资格测试的人使用的。";
		next;
		if (MONK_Q == 14) {
	mes "[Keeper Chorip]";
mes "嗯？你刚才说布海？";
next;
mes "[Keeper Chorip]";
	mes "布海喜欢躲在安静的地方，你可能找不到他。比如……角落……";
	close;
	}
	else if (MONK_Q > 14 && MONK_Q < 25) {
	mes "[Keeper Chorip]";
		mes "你的名字是 " + strcharinfo(0) + "?";
		next;
		if (select("是。:否。") == 1) {
		mes "[Keeper Chorip]";
		mes "好，你没问题……进去吧，测试在等你。祝你好运。";
		close;
	}
	mes "[Keeper Chorip]";
		mes "好吧，我知道你是谁……进去吧……测试准备好了。";
		close;
		}
		else {
			mes "[Keeper Chorip]";
		mes "……里面请保持安静。";
			close;
		}
		}
		
		monk_test,329,61,3	script	Bashu#mk	753,{
	if (MONK_Q > 14 && MONK_Q < 25) {
	if (MONK_Q == 15) {
		mes "[Bashu]";
		mes "那么，你想做哪项测试……？";
		next;
	mes "[Bashu]";
mes "听说你选择了蘑菇测试……";
mes "好吧，这是你的选择。";
}
	else if (MONK_Q == 16) {
		mes "[Bashu]";
			mes "你想进入哪间测试大厅？";
			next;
			mes "[Bashu]";
			mes "据我所知，你选择了马拉松测试……";
			mes "好吧，这是你的选择。";
			}
		else {
		mes "[Bashu]";
			mes "你想进入哪间测试大厅？";
			mes "你可以选择想做的测试。";
			next;
			}
			next;
			if (select("忍耐——采集蘑菇:自制力——马拉松") == 1) {
		mes "你决定通过 ^FF0000采集蘑菇^000000 接受耐心测试。";
		close2;
			warp "job_monk",226,175;
			end;
			}
			mes "你决定通过 ^FF0000马拉松^000000 接受自制力测试。";
		close2;
		warp "monk_test",386,387;
		end;
			}
			else {
			mes "[Bashu]";
			mes "欢迎……这里是武僧训练场，圣卡必托利娜修道院。";
		mes "进入后你会见到继承前辈的最年长武僧托蒙，";
		next;
		mes "[Bashu]";
		mes "请注意，不要触碰任何东西。";
		mes "也请避免在托蒙面前大声说话。";
	next;
	mes "[Bashu]";
		mes "希望你在这里度过愉快时光。";
		close;
		}
		}
		
		monk_test,386,388,4	script	Apprentice Monk#mk	110,{
		mes "[武僧学徒]";
		mes "欢……欢迎！";
		mes "这……这里是考验武僧候选人耐心的地方！";
		next;
		mes "[武僧学徒]";
	mes "只……只管跑……";
mes "直到有人叫你停下，";
mes "跑……跑……跑！";
next;
	mes "[武僧学徒]";
	mes "我……我？总有一天我会跑！";
	next;
	mes "[武僧学徒]";
	mes "武……武僧……你要成为……武……武僧吗？";
	next;
	mes "[武僧学徒]";
	mes "你……你确定……不……不会放弃？";
	next;
		if (select("放弃。:继续跑。") == 1) {
		mes "[武僧学徒]";
		mes "" + strcharinfo(0) + "……呃呃……放弃！……马拉松！！你……你没有成为武……武僧的资质！";
		mapannounce "monk_test","" + strcharinfo(0) + "……呃呃……放弃！……马拉松！！你……你没有成为武……武僧的资质！",bc_map;
	close2;
	set MONK_Q,15;
	changequest 3028,3027;
	warp "prt_monk",194,168;
	end;
	}
		mes "[武僧学徒]";
		mes "直到有人叫你停下，";
		mes "跑……跑……跑！";
		close;
		}
		
		monk_test,387,350,0	script	Supervisor#race_monk	45,2,2,{
		OnTouch_:
	if (MONK_Q >= 15 && MONK_Q <= 23) {
	set MONK_Q,MONK_Q+1;
	warp "monk_test",385,388;
	end;
	}
else if (MONK_Q == 24) {
set MONK_Q,25;
changequest 3028,3029;
	mapannounce "monk_test","现在！这是最后一圈！！完成后请去找多木参加下一项测试！",bc_map;
	warp "monk_test",385,388;
		end;
		}
		else if (MONK_Q == 25) {
		mes "[监考员]";
	mes "现在……你可以去拜访托蒙。";
		mes "托蒙在修道院附近建筑最深处的房间。";
		mapannounce "monk_test","恭喜！" + strcharinfo(0) +"！！你完成了马拉松！",bc_map;
		close2;
		warp "prt_monk",194,168;
		end;
	}
	}
		

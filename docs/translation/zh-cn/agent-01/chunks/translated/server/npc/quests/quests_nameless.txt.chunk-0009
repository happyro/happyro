			mes "[多里安]";
			mes "接下来你要操作";
			mes "四个开关，";
			mes "它们分别以红、蓝、黄、";
			mes "绿四种颜色标记。";
			next;
			mes "[多里安]";
			mes "引擎处于 1 档时按";
			mes "^0000FF红色^000000开关。";
			mes "2 档按";
			mes "^0000FF蓝色^000000开关，";
			mes "3 档按^0000FF黄色^000000，";
			mes "4 档按^0000FF绿色^000000。";
			next;
			mes "[多里安]";
			mes "引擎的声音是";
			mes "判断当前档位的依据。";
			mes "你得自己";
			mes "弄清楚，";
			mes "抱歉，";
			mes "我就是这样设计的……";
			next;
			mes "[多里安]";
			mes "啊，还有最后一个提示！";
			mes "如果输入了正确的";
			mes "引擎档位，";
			mes "机器就会顺利启动，";
			mes "即使你多次按下同一个开关";
			mes "也没关系。";
			next;
			mes "[多里安]";
			mes "如果你成功启动了它，";
			mes "请告诉我，";
			mes "这样我就能确认";
			mes "优雅神秘烘干机是否完全正常。";
			mes "现在祝你好运～";
			close;
		case 2:
			mes "[多里安]";
			mes "真的吗？";
			mes "我再解释一遍";
			mes "也没关系。别害羞，";
			mes "不是每个人都是天才～";
			close;
		}
	}
	if (diamond_edq == 11) {
		mes "[多里安]";
		mes "啊，你没能修好";
		mes "优雅神秘烘干机？";
		mes "这很正常：";
		mes "我本来就不是为普通用户设计它的。";
		mes "不如再试一次？";
		changequest 3106,3105;
		set diamond_edq,10;
		close;
	}
	if (diamond_edq == 12) {
		mes "[多里安]";
		mes "啊，我低估你了。";
		mes "你真的修好了";
		mes "优雅神秘";
		mes "烘干机～";
		mes "这证明了我惊人的教学能力。";
		mes "恭喜你！";
		next;
		mes "[多里安]";
		mes "现在你只需要插入损坏的";
		mes "文件";
		mes "并按下开关。";
		mes "很简单，对吧？";
		changequest 3107,3108;
		set diamond_edq,13;
		next;
		mes "[多里安]";
		mes "好了，恐怕我对你的用处";
		mes "已经全部发挥完了。";
		mes "啊，";
		mes "如果还需要你这样的帮手，";
		mes "我会联系你的。";
		mes "再见～";
		close;
	}
	if (diamond_edq > 12) {
		mes "[多里安]";
		mes "啊，你好！";
		mes "最近过得怎么样？";
		mes "需要我的艺术发明吗？";
		mes "还是只是想我了？";

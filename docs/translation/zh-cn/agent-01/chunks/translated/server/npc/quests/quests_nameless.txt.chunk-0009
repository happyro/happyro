-	script	::StrangeMachine_izlude	-1,{
	if (checkweight(907,200) == 0) {
		mes "[多里安]";
		mes "唉，真像个工薪阶层的人：";
		mes "把所有物品都";
		mes "囤起来，";
		mes "像只囤货的老鼠？请把你的";
		mes "物品转移到卡普拉仓库，";
		mes "至少保持一点体面。";
		close;
	}
	if (diamond_edq == 10) {
		set .@bolt_rand,rand(2,5);
		mes "^3355FF这一定是多里安的";
		mes "优雅神秘烘干机。";
		mes "你想做什么？^000000";
		next;
		while(1) {
			set .@switch_sound,rand(1,4);
		switch(select("检查机器:更换引擎:拧紧螺丝:按下开关")) {
			case 1:
				if (.@hit_status == 0) {
					mes "^3355FF这台庞然大物般的";
					mes "机器";
					mes "没有电。^000000";
					next;
				}
				break;
			case 2:
				if (.@engine == 0) {
		mes "^3355FF你用新的原始红宝石";
		mes "替换了红宝石引擎里的";
		mes "原始红宝石。";
					mes "它咔哒一声嵌入";
					mes "引擎核心。^000000";
					next;
					set .@engine,.@engine+1;
				}
				else if (.@engine > 0) {
					mes "^3355FF引擎里的红宝石";
					mes "已经";
					mes "更换过了。^000000";
					next;
				}
				break;
			case 3:
				if (.@engine <  1) {
					mes "^3355FF你可能得先";
					mes "更换引擎里的";
					mes "红宝石。^000000";
					next;
				}
				else if ((.@engine == 1) && (.@bolt < .@bolt_rand)) {
					mes "^3355FF*咔嗒-咔嗒*^000000";
					mes "^3355FF*咔嗒-咔嗒*^000000";
					next;
					set .@bolt,.@bolt+1;
				}
				else if ((.@engine == 1) && (.@bolt == .@bolt_rand)) {
					mes "^3355FF*咔嗒-咔嗒*^000000";
					mes "^0000FF*咔哒*^000000";
					next;
					set .@bolt,.@bolt+1;
					set .@bolt_suc,.@bolt_suc+1;
				}
				else if ((.@engine == 1) && (.@bolt > .@bolt_rand)) {
					mes "^3355FF*咔嗒-咔嗒*^000000";
					mes "^3355FF*咔哒-咔哒-咔哒-轰*^000000";
					next;
					mes "^3355FF你把螺丝拧得太紧了！";
					mes "接合处坏掉了……你应该";
					mes "回去找多里安帮忙。^000000";
					mes "这台机器需要";
					mes "重新修理。";
					changequest 3105,3106;
					set diamond_edq,11;
					close;
				}
				else {
		mes "^3355FF一定是哪里出了问题。";
		mes "你最好";
		mes "从头开始……^000000";
		mes "再试一次吧。";
					close;
				}
				break;
			case 4:
				if ((.@engine <  1) && (.@bolt_suc < 1)) {
					mes "^3355FF你需要更换引擎里的红宝石，";
					mes "并拧紧主螺丝，之后才能";
					mes "操作这些开关。^000000";
					mes "请按正确顺序";
					mes "操作。";
					next;
				}
				else if ((.@engine == 1) && (.@bolt_suc < 1)) {
		mes "^3355FF你需要先拧紧";
		mes "螺丝，才能安全启动引擎。";
		mes "请再试一次。";
					next;
				}
				else if ((.@red >= 1) && (.@blue >= 1) && (.@yellow >= 1) && (.@green >= 1)) {
					mes "^3355FF优雅神秘烘干机发出";
					mes "巨大的嗡鸣，";
					mes "稳定下来后声音";
					mes "逐渐变成平静的";
					mes "低鸣。";
		mes "看来你修好它了！^000000";
					next;
		mes "^3355FF你应该先告诉多里安，";
		mes "这样才能使用";
		mes "这台机器。^000000";
					changequest 3105,3107;
					set diamond_edq,12;
					close;
				}
				else if ((.@engine == 1) && (.@bolt_suc == 1)) {
					if (.@switch_sound == 1) {

							mes "^3355FF*嗖嗖*^000000";
							mes "^3355FF*嗖嗖*^000000";
							next;
							mes "^3355FF机器发出了一些";
							mes "猛烈而紊乱的声音，";
							mes "剧烈振动后突然";
							mes "停止了。";
							mes "开错了";
							mes "开关。你最好去问多里安……";
							changequest 3105,3106;
							set diamond_edq,11;
							close;
						case 1:
							if (.@red  >= 0) {
								mes "^3355FF*嗡嗡嗡*^000000";
								mes "^3355FF*铿锵……！*^000000";
								next;
								mes "^3355FF机器的";
								mes "振动";
								mes "变强了。看来";
								mes "看来你选对了";
								mes "开关。^000000";
								next;
								set .@red,.@red+1;

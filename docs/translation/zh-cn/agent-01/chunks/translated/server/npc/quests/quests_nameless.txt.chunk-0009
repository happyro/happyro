								mes "猛烈而紊乱的声音，";
								mes "剧烈振动后突然";
								mes "停止了。";
								mes "开错了";
								mes "开关。你最好去问多里安……";
								changequest 3105,3106;
								set diamond_edq,11;
								close;
							}
							break;
						}
					}
					else if (.@switch_sound == 2) {
						mes "^3355FF*呼噜呼噜*^000000";
						mes "^3355FF*呼噜呼噜*^000000";
						mes "机器的振动";
						mes "稍微变强了一些。";
						mes "你现在想尝试";

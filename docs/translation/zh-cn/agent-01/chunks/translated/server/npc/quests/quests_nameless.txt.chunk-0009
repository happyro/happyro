				mes "啊，抱歉。";
				mes "[多里安]";
				mes "问我的人太多了，";
				mes "所以我现在只接受漂亮的";
				mes "女学生。别太失望，我知道";
				mes "你还能找到其他人。";
				close;
			}
			else {
				mes "[多里安]";
				mes "小姐，能见到你是我的";
				mes "荣幸：";
				mes "就连月亮都遮住脸，";
				mes "玫瑰也羞愧地";
				mes "竖起荆棘，";
				mes "嫉妒你的美丽。";
				next;
				mes "[多里安]";
				mes "啊！不过，既然我们可以";
				mes "以恋人的身份悠闲相处，";
				mes "为什么还要假装你是我的学生？";
				mes "不是吗——小姐？";
				mes "等等，";
				mes "你要去哪里？";
				close;
			}
		case 3:
			mes "[多里安]";
			mes "我没有足够的时间";
			mes "闲聊，";
			mes "所以请让我专心";
			mes "进行艺术创作，";
			mes "不要再打扰我了。";
			close;
		}
	}
	if (diamond_edq == 7) {
		mes "[多里安]";
		mes "唉，你之前的行为";
		mes "让我感到恶心……";
		mes "不过你那可怜的眼神……";
		mes "是在寻求同情吗？啊，";
		mes "你终究只是凡人。";
		mes "我就原谅你吧。";
		next;
		mes "[多里安]";
		mes "那么好吧。这次请仔细";
		mes "听我说，别再侮辱";
		mes "我的自尊。";
		mes "准备好后，";
		mes "请来和我谈谈。";
		set diamond_edq,6;
		close;
	}
	if (diamond_edq == 9) {
		mes "[多里安]";
		mes "啊，你带齐了修理";
		mes "优雅神秘烘干机的";
		mes "材料吗？";
		mes "让我看看";
		mes "你带来的东西……";
		next;
		if ((countitem(7317) > 19) && (countitem(1002) > 9) && (countitem(999) > 4) && (countitem(723) > 1) && (countitem(716) > 4)) {
		mes "[多里安]";
		mes "啊，做得好。";
		mes "材料";
			mes "都准备好了，现在我可以教你";
			mes "如何修理这台机器。";
			next;
			delitem 7317,20; //Screw
			delitem 1002,10; //Iron_Ore
			delitem 999,5; //Steel
			delitem 723,2; //Cardinal_Jewel
			delitem 716,5; //Red_Gemstone
			changequest 3104,3105;
			set diamond_edq,10;
		mes "[多里安]";
		mes "我预计你会失败";
		mes "几次，不过";
		mes "优雅神秘烘干机";
			mes "的设计非常坚固：";
			mes "即使你故意尝试，";
			mes "也很难在它上面留下划痕。";
			next;
		mes "[多里安]";
		mes "首先，把新的原始红宝石";
		mes "放入红宝石";
		mes "引擎，";
			mes "拧紧接合处的螺丝，直到听到";
			mes "^0000FF咔哒^000000声。再继续拧";
			mes "就会把它弄坏。";
			next;
		mes "[多里安]";
		mes "接下来你要操作";
		mes "四个开关，";
			mes "它们分别以红、蓝、黄、";
			mes "绿四种颜色标记。";
			next;
		mes "[多里安]";
		mes "引擎处于 1 档时按";
		mes "^0000FF红色^000000开关。";
		mes "2 档按";
			mes "^0000FF蓝色^000000开关，";
			mes "3 档按^0000FF黄色^000000，";
			mes "4 档按^0000FF绿色^000000。";
			next;
				mes "[多里安]";
				mes "引擎的声音是判断";
				mes "当前档位的";
				mes "唯一依据。";
				mes "你得自己弄清楚，";
				mes "抱歉，";
				mes "我就是这样设计的……";
			next;
				mes "[多里安]";
				mes "啊，还有最后一个提示！";
				mes "如果输入了正确的";
				mes "引擎档位，";
			mes "机器就会顺利启动，";
			mes "即使你多次按下";
			mes "同一个开关也没关系。";
			next;
				mes "[多里安]";
				mes "如果你成功启动了它，";
				mes "请告诉我，";
				mes "这样我就能确认";
			mes "优雅神秘烘干机是否";
			mes "完全正常。现在祝你好运～";
			close;
		}
		else {
			mes "[多里安]";
			mes "哦？你还缺少一些材料。";
			mes "没关系，";
			mes "我们不着急。";
			mes "如果你忘了，我来提醒你";
			mes "需要带些什么……";
			next;
			mes "[多里安]";
			mes "请准备";
			mes "^FF000020 个生锈的螺丝^000000、";
			mes "^FF000010 个铁矿石^000000、";
			mes "^FF00005 个钢铁^000000、";
			mes "^FF00002 颗红宝石^000000以及";
			mes "^FF000010 颗红色宝石^000000。";
			close;
		}
	}
	if (diamond_edq == 10) {
		mes "[多里安]";
		mes "你已经忘了";
		mes "吗？";
		mes "修理优雅神秘烘干机的说明吗？";
		mes "我不能怪你，毕竟";
		mes "说明确实有点复杂。";
		next;
		switch(select("说明:取消")) {
		case 1:
			mes "[多里安]";
			mes "首先，把新的";
			mes "原始红宝石";
			mes "放入红宝石引擎，";
			mes "拧紧接合处的螺丝，直到听到";
			mes "^0000FF咔哒^000000声。继续拧";

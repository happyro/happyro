				mes "再让他带给我。";
				close;
			}
			else {
				mes "[" + .@name$ + "]";
				mes "我们之间的事务";
				mes "已经结束。如果不忙，";
				mes "不妨帮助你的公会？";
				mes "我确定他们会感激。";
				close;
			}
		}
		else {
			if ((BaseJob == Job_Sage) && (countitem(7240) > 0)) {
				mes "[" + .@name$ + "]";
				mes "我看到你带来了";
				mes "^42426F信任之魂^000000。现在首先要做的是";
				mes "在你和公会成员之间";
				mes "建立信任。";
				mes "多花时间和他们相处。";
				next;
				mes "[" + .@name$ + "]";
				mes "我希望你在回来前";
				mes "先在公会内部建立友好关系。";
				mes "你的公会必须团结一致";
				mes "才能成功。";

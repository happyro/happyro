				}
				if ((BaseLevel > 57) && (BaseLevel < 76)) {
					mes "[" + .@name$ + "]";
					mes "你的考试是";
					mes "变得更强一点！";
					mes "再提升 2 个等级";
					mes "就能通过。";
					mes "怎么样，嗯？";
					delitem 7237,1; //Soul_Of_Partnership
					set guildrelay_q,6;
					close;
				}
				if ((BaseLevel > 75) && (BaseLevel < 94)) {
					mes "[" + .@name$ + "]";
					mes "你的考试是";
					mes "变得更强一点！";
					mes "再提升 1 个等级";
					mes "就能通过。";
					mes "怎么样，嗯？";
					delitem 7237,1; //Soul_Of_Partnership
					set guildrelay_q,7;
					close;
				}
				if (BaseLevel > 93) {
					mes "[" + .@name$ + "]";
				mes "等等，算了！";
				mes "我本来想让你提升基础等级，";
				mes "但你已经足够强了。";
				mes "好吧，你通过了！把这个交给";
				mes "^FF0000猎人^000000或 ^FF0000神射手^000000～";
					delitem 7237,1; //Soul_Of_Partnership
					set guildrelay_q,86;
					getitem 7238,1; //Soul_Of_Correspondence
					close;
				}
			}
			if (((BaseLevel + 2) < (BaseLevel)) && (guildrelay_q == 5)) {
				mes "[" + .@name$ + "]";
				mes "你变强了一点，";
				mes "嗯？好吧，你通过了。";
				mes "拿着这个，交给公会里的";
				mes "^FF0000猎人^000000或 ^FF0000神射手^000000。";
				mes "干得好，回头见。";
				set guildrelay_q,86;
				getitem 7238,1; //Soul_Of_Correspondence
				close;
			}
			if (((BaseLevel + 1) < (BaseLevel)) && (guildrelay_q == 6)) {
				mes "[" + .@name$ + "]";
				mes "你变强了一点，嗯？";
				mes "好吧，你通过了。";
				mes "拿着这个，交给公会里的";
				mes "^FF0000猎人^000000或 ^FF0000神射手^000000。";
				mes "干得好，回头见。";
				set guildrelay_q,86;
				getitem 7238,1; //Soul_Of_Correspondence
				close;
			}
			if ((BaseLevel < (BaseLevel)) && (guildrelay_q == 7)) {
				mes "[" + .@name$ + "]";
				mes "你变强了一点，嗯？";
				mes "好吧，你通过了。";
				mes "拿着这个，交给公会里的";
				mes "^FF0000猎人^000000或 ^FF0000神射手^000000。";
				mes "干得好，回头见。";
				set guildrelay_q,86;
				getitem 7238,1; //Soul_Of_Correspondence
				close;
			}
			if ((guildrelay_q == 5) || (guildrelay_q == 6) || (guildrelay_q == 7)) {
				mes "[" + .@name$ + "]";
				mes "你还不够强，";
				mes "无法通过考试。";
				mes "快去杀些怪物，";
				mes "并获得一些 ^FF0000基础等级^000000。";
				mes "你必须变得更强！";
				close;
			}
			if ((BaseJob == Job_Hunter) && (countitem(7238) > 0)) {
				mes "[" + .@name$ + "]";
				mes "啊，很好，你来了。";
				mes "我对你的请求是：";
				mes "请为了公会";
				mes "捐出你的猎鹰。";
				next;
				switch(select("捐出猎鹰:没门！")) {
				case 1:
					if (checkfalcon()) {
						mes "[" + .@name$ + "]";
					mes "太好了！别担心，";
					mes "你的猎鹰会受到妥善照顾，";
					mes "用于侦察区域";
					mes "和投递邮件。";
					mes "所以我才向你索要。";
						next;
						mes "[" + .@name$ + "]";
					mes "现在请拿上这个";
					mes "灵魂，把它交给";
						mes "尽快交给你的公会会长，";
						mes "好吗？";
						setfalcon;
						delitem 7238,1; //Soul_Of_Correspondence
						set guildrelay_q,85;
						getitem 7239,1; //Soul_Of_Proceeding
						close;
					}
					else {
						mes "[" + .@name$ + "]";
					mes "我很高兴你愿意交出猎鹰，";
					mes "但它现在似乎不在你身边。";
					mes "去找一只，再回来。";
						close;
					}
				case 2:
					mes "[" + .@name$ + "]";
				mes "如果你坚持留下猎鹰，我也没办法。";
				mes "改变主意后再回来吧。";
				mes "除非你配合，否则我帮不了你。";
					close;
				}
			}
			if ((guildrelay_q == 88) && (countitem(7235) > 0)) {
				mes "[" + .@name$ + "]";
			mes "请把冲锋之魂交给";
			mes "^FF0000铁匠^000000或 ^FF0000神工匠^000000。";
			mes "交给其他人没有用。";
				close;
			}
			if (guildrelay_q == 88) {
				mes "[" + .@name$ + "]";
			mes "你没什么";
			mes "要做的吗？";
				mes "为什么不帮助你的公会";
				mes "猎杀怪物？这是向他们展示技能的好机会～";
				close;
			}
			if ((guildrelay_q == 87) && (countitem(7237) > 0)) {
				mes "[" + .@name$ + "]";
				mes "请把协会之魂交给";
				mes "^FF0000炼金术士^000000或 ^FF0000创造者^000000。";
				mes "交给其他人没有用。";
				close;
			}
			if (guildrelay_q == 87) {
				mes "[" + .@name$ + "]";
				mes "嗯。你没什么要做的吗？";
				mes "我想无聊总比忙得不可开交好。";
				mes "算了，你会找到事情做的。";
				close;
			}
			if ((guildrelay_q == 86) && (countitem(7238) > 0)) {
				mes "[" + .@name$ + "]";
				mes "请把协调之魂交给";
				mes "^FF0000猎人^000000或 ^FF0000神射手^000000。";
				mes "交给其他人没有用。";
				close;
			}
			if (guildrelay_q == 86) {
				mes "[" + .@name$ + "]";
				mes "干得好。请先休息一下，";
				mes "之后再回来找我。";
				mes "到那时我会有东西";
				mes "要给你。";
				close;
			}
			if ((guildrelay_q == 85) && (countitem(7239) > 0)) {
				mes "[" + .@name$ + "]";
				mes "请把前进之魂交给你的";
				mes "^FF0000公会会长^000000。";
				mes "交给其他人没有用。";
				close;
			}
			if (guildrelay_q == 85) {
				mes "[" + .@name$ + "]";
				mes "你的猎鹰在公会里";
				mes "帮了很大的忙。";
				mes "嗯？已经想它了？哈哈哈！";
				close;
			}
			mes "[" + .@name$ + "]";
		mes "嗯？什么风把你吹来了？";
		mes "我想我们没什么事要办。";
		mes "是我弄错了吗？";
			close;
		}
	}
	else {
		if (is_guild_leader(.@GID) == true) {
			mes "[" + .@name$ + "]";
		mes "嗯？什么风把你吹来了？";
		mes "如果愿意，尽管慢慢参观。";
			close;
		}
		else {
			mes "[" + .@name$ + "]";
		mes "这里没什么可看的，";
		mes "但欢迎留下参观。";
			mes "如果愿意，可以在这里看看。";
			close;
		}
	}
}

-	script	RelayDummy3::GuildRelay3	754,{
	set .@name$,strnpcinfo(1);
	getmapxy(.@m$,.@x,.@x,BL_NPC);
	set .@GID, GetCastleData(.@m$,1);
	if (checkweight(1201,1) == 0) {
		mes "^3355FF等一下！你";
		mes "你现在携带的物品太多：";
		mes "把多余物品存入卡普拉仓库，";
		mes "然后再回来。^000000";
		close;
	}
	if (.@GID == 0) {
		mes "^3355FF这个疲惫的男人";
		mes "发现你一直盯着他，";
		mes "但选择不理你。这个据点没有其他人，";
		mes "你也没有理由留在这里。^000000";

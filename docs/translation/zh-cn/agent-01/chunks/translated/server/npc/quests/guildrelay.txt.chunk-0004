				if ((.@time > 0201) && (.@time < guildtime)) {
					mes "[" + .@name$ + "]";
					mes "那么你和公会成员";
					mes "好好相处，";
					mes "并有机会真正了解";
					mes "他们是谁？你必须";
					mes "关爱你的同伴。";
					next;
					mes "[" + .@name$ + "]";
					mes "现在你知道建立羁绊";
					mes "有多重要了。请把这个灵魂交给";

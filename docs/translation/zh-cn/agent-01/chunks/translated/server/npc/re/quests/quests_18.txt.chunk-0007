		cloakonnpcself( "Miriam#ep18_wv" );
		cloakonnpcself( "Maram#ep18_wv" );
		end;
	}

	// Quest before the daily quests
	switch( isbegin_quest(11735) ) {
	case 0:
		switch( isbegin_quest(11725) ) {
		case 0:
			mes "[Imril]";
		mes "多亏了你，我才能安全通过^e5555e奥兹迷宫^000000。";
		mes "谢谢你。";
			cutin "ep18_imril_03.png",2;
			next;
			mes "[Imril]";
		mes "过去只要小心，独自旅行并不是什么大问题。但最近越来越难独自行动了。";
			cutin "ep18_imril_02.png",2;
			next;
			mes "[Imril]";
		mes "考虑到村子的现状，我不可能一直有人护送，而且结伴行动容易引人注意，也很危险。";
			cutin "ep18_imril_01.png",2;
			next;
			mes "[Imril]";
		mes "如果能深入调查奥兹迷宫就好了。";
		mes "<FONT SIZE = 14>熔岩的状况……</FONT>";
		mes "<FONT SIZE = 16><B>怪物的分布……</FONT></B>";
			cutin "ep18_imril_02.png",2;
			next;
			mes "[Imril]";
		mes "嗯……";
		mes "冒险者，你很强，有空时能陪我去^e5555e奥兹迷宫^000000吗？";
		mes "这也许是个厚脸皮的请求，但不是每天都有机会遇到像你这样强大的冒险者。";
			next;
		if (select( "现在出发！", "稍后……" ) == 2) {
				mes "[Imril]";
			mes "好！";
			mes "如果你现在很忙，那也没办法。";
				cutin "ep18_imril_02.png",2;
				next;
				mes "[Imril]";
		mes "之后有时间的话，你会陪我去吗？";
				close3;
			}
			mes "[Imril]";
		mes "哇！";
		mes "真的吗？";
		mes "你愿意这样接受我的请求？我太感动了！";
			cutin "ep18_imril_03.png",2;
			next;
			mes "[Imril]";
		mes "那我们先在^e5555e奥兹迷宫入口^000000集合吧！";
		mes "你记得路吧？";
			cutin "ep18_imril_02.png",2;
			setquest 11725;
			close2;
			cutin "",255;
			navigateto("oz_dun01",27,184);
			end;
		case 1:
			mes "[Imril]";
		mes "那些搬运东西或处理熔岩的怪物都是障碍。";
		mes "如果能彻底消灭它们就好了。";
			cutin "ep18_imril_01.png",2;
			close3;
		case 2:
			end;
		}
		end;
	case 1:
		mes "[Imril]";
	mes "啊……";
	mes "我的皮肤感觉刺痛。";
		cutin "ep18_imril_02.png",2;
		next;
		mes "[Suad]";
	mes "是谁穿成这样还敢深入迷宫？";
	mes "你没被活活烤熟，就该心怀感激了！";
		cutin "ep18_suad_03.png",2;
		next;
		mes "[Imril]";
	mes "总之，不管你怎么说！";
		cutin "ep18_imril_02.png",2;
		next;
		mes "[Imril]";
	mes "总之，^e5555e奥兹迷宫的情况正在恶化^000000。";
	mes "^e5555e熔岩区域正在扩大^000000。";
		cutin "ep18_imril_01.png",2;
		next;
		mes "[Imril]";
	mes "照这样下去，留给我们穿过奥兹迷宫的时间不多了。";
		next;
		mes "[Suad]";
	mes "确实，如果熔岩已经扩散到这种程度，就必须尽快想办法。";
		cutin "ep18_suad_03.png",2;
		next;
		mes "[Suad]";
	mes "目前……";
	mes "要派遣工人，就必须减少奥兹迷宫中的怪物数量。";
		next;
		cutin "",255;
		completequest 11735;
		getitem 1000405,20;	// Ep18_Amethyst_Fragment
		getexp 18252408,2000000;
	mes "^4d4dff你获得了良好的评价。^000000";
		add_reputation_points(REPUTATION_EP18, 100);
		if (get_reputation_points(REPUTATION_EP18) >= 1000 && ep18_main == 36) {// Custom implementation: reputation 1000 on wolfvill => player can continue the main quest
			ep18_main = 37;
			setquest 18082;
		}
		close;
	case 2:
		break;
	}
	mes "[Imril]";
	mes "那些搬运行李或处理熔岩的怪物都是障碍。";
	mes "如果能彻底消灭它们就好了。";
	cutin "ep18_imril_01.png",2;
	next;
	mes "[Imril]";
	mes "你觉得怎么样，冒险者？";
	mes "对^e5555e消灭怪物^000000感兴趣吗？";
	cutin "ep18_imril_02.png",2;
	next;

	.@menu$[0] = "奥兹迷宫一楼 [170]";
	if (checkquest(11737,PLAYTIME) == 0 || checkquest(11737,PLAYTIME) == 1)
		.@menu$[0] = "^8C8C8C" + .@menu$[0] + "(待处理)^000000";
	else if (checkquest(11736,HUNTING) == 0 || checkquest(11736,HUNTING) == 1)
		.@menu$[0] = "^8C8C8C" + .@menu$[0] + "(进行中)^000000";

	.@menu$[1] = "奥兹迷宫二楼 [200]";
	if (BaseLevel < 200)
		.@menu$[1] = "^8C8C8C" + .@menu$[1] + "（等级不足）^000000";
	else if (checkquest(11739,PLAYTIME) == 0 || checkquest(11739,PLAYTIME) == 1)
		.@menu$[1] = "^8C8C8C" + .@menu$[1] + "(待处理)^000000";
	else if (checkquest(11738,HUNTING) == 0 || checkquest(11738,HUNTING) == 1)
		.@menu$[1] = "^8C8C8C" + .@menu$[1] + "(进行中)^000000";

	switch( select( .@menu$[0], .@menu$[1], "停止" ) ) {
	case 1:
		switch( checkquest(11737,PLAYTIME) ) {
		case -1:
			break;
		case 0:
		case 1:
			mes "[Imril]";
			mes "你今天做得很好。谢谢你。";
			mes "明天也能帮我吗？";
			cutin "ep18_imril_04.png",2;
			close3;
		case 2:
			erasequest 11737;
			break;
		}
		switch( checkquest(11736,HUNTING) ) {
		case -1:
			mes "[Imril]";
			mes "^e5555e请在奥兹迷宫一楼击败约 20 只" + getmonsterinfo(21295, MOB_NAME) + "。^000000";
			mes "即使怪物数量稍微减少，也会大大帮助穿过迷宫的旅行者。";
			cutin "ep18_imril_03.png",2;
			next;
			if (select( "接受。", "就此停止。" ) == 2) {
				mes "[Imril]";
				mes "为什么~？你很忙吗？";
				cutin "ep18_imril_02.png",2;
				close3;
			}
			mes "[Imril]";
			mes "那回去的路上小心~";
			setquest 11736;
			close3;
		case 0:
		case 1:
			mes "[Imril]";
			mes "^e5555e请在奥兹迷宫一楼击败约 20 只" + getmonsterinfo(21295, MOB_NAME) + "。^000000";
			mes "即使怪物数量稍微减少，也会大大帮助穿过迷宫的旅行者。";
			cutin "ep18_imril_03.png",2;
			close3;
		case 2:
			mes "[Imril]";
			mes "已经完成了吗？";
			mes "真可靠！";
			cutin "ep18_imril_04.png",2;
			erasequest 11736;
			setquest 11737;
			add_reputation_points(REPUTATION_EP18, 30);
			if (get_reputation_points(REPUTATION_EP18) >= 5000)
				.@bonus = 1;
			if (get_reputation_points(REPUTATION_EP18) >= 1000 && ep18_main == 36) {// Custom implementation: reputation 1000 on wolfvill => player can continue the main quest
				ep18_main = 37;
				setquest 18082;
			}
			getitem 1000405,3+.@bonus;	// Ep18_Amethyst_Fragment
			getexp 4364880,3000000;
			close3;
		}
	case 2:
		if (BaseLevel < 200) {
			mes "[Imril]";
			mes "这里仍然太危险了，^ff0000等到大约 200 级后再试吧^000000！";
			close;
		}
		switch( checkquest(11739,PLAYTIME) ) {
		case -1:
			break;
		case 0:
		case 1:
			mes "[Imril]";
			mes "你今天做得很好。谢谢你。";
			mes "明天也能帮我吗？";
			cutin "ep18_imril_04.png",2;
			close3;
		case 2:
			erasequest 11739;
			break;
		}
		switch( checkquest(11738,HUNTING) ) {
		case -1:
			mes "[Imril]";
			mes "请在奥兹迷宫二楼^e5555e击败约 20 只^000000" + getmonsterinfo("EP18_HOT_MOLAR", MOB_NAME) + "。";
			mes "即使怪物数量稍微减少，也会大大帮助穿过迷宫的商贩。";
			cutin "ep18_imril_03.png",2;
			next;
			if (select( "接受", "停止" ) == 2)
				close3;
			mes "[Imril]";
			mes "那就小心前往吧~";
			setquest 11738;
			close3;
		case 0:
		case 1:
			mes "[Imril]";
			mes "请在奥兹迷宫二楼^e5555e击败约 20 只^000000" + getmonsterinfo("EP18_HOT_MOLAR", MOB_NAME) + "。";
			mes "即使怪物数量稍微减少，也会大大帮助穿过迷宫的商贩。";
			cutin "ep18_imril_03.png",2;
			close3;
		case 2:
			mes "[Imril]";
			mes "已经完成了吗？";
			mes "真可靠！";
			cutin "ep18_imril_04.png",2;
			erasequest 11738;
			setquest 11739;
			add_reputation_points(REPUTATION_EP18, 30);
			if (get_reputation_points(REPUTATION_EP18) >= 5000)
				.@bonus = 1;
			if (get_reputation_points(REPUTATION_EP18) >= 1000 && ep18_main == 36) {// Custom implementation: reputation 1000 on wolfvill => player can continue the main quest
				ep18_main = 37;
				setquest 18082;
			}
			getitem 1000405,3+.@bonus;	// Ep18_Amethyst_Fragment
			getexp 11588320,3000000;
			close3;
		}
		end;
	case 3:
		mes "[Imril]";
		mes "为什么~？你很忙吗？";
		cutin "ep18_imril_02.png",2;
		close3;
	}
	end;

OnInit:
	questinfo( QTYPE_QUEST2, QMARK_YELLOW, "isbegin_quest(11724) == 1" );
	questinfo( QTYPE_QUEST2, QMARK_YELLOW, "isbegin_quest(11724) == 2 && isbegin_quest(11725) == 0" );
	questinfo( QTYPE_QUEST2, QMARK_YELLOW, "isbegin_quest(11735) == 1" );

	questinfo( QTYPE_DAILYQUEST, QMARK_YELLOW, "isbegin_quest(11735) == 2 && checkquest(11736,HUNTING) == -1 && (checkquest(11737,PLAYTIME) == -1 || checkquest(11737,PLAYTIME) == 2)" );
	questinfo( QTYPE_QUEST2, QMARK_YELLOW, "isbegin_quest(11735) == 2 && checkquest(11736,HUNTING) == 2" );
	questinfo( QTYPE_DAILYQUEST, QMARK_YELLOW, "isbegin_quest(11735) == 2 && checkquest(11738,HUNTING) == -1 && (checkquest(11739,PLAYTIME) == -1 || checkquest(11739,PLAYTIME) == 2)" );
	questinfo( QTYPE_QUEST2, QMARK_YELLOW, "isbegin_quest(11735) == 2 && checkquest(11738,HUNTING) == 2" );
	end;
}

// Main Quest: Step 35.
wolfvill,180,179,3	script	Village Boy#category	4_M_DST_CHILD,{
	if (ep18_main == 37) {
		mes "[Village Boy]";
	mes "比赛就要开始了。";
	mes "这不是经常举行的小型集会，而是由各地值得信赖的人参加的比赛！";
		next;
		mes "[Village Boy]";
	mes "你应该去<NAVI>[那边]<INFO>wolfvill,144,151,0,101,0</INFO></NAVI>。那里也有冒险者的位置。";
	mes "当然，既然你是冒险者，就是我们可以信赖的人。";
		erasequest 18082;
		setquest 16567;
		ep18_main = 38;
		close;
	}
	if (ep18_main == 38) {
		mes "[Boy]";
	mes "集会就要开始了！不是普通集会，而是比赛！";
	mes "<NAVI>[大家]<INFO>wolfvill,144,151,0,101,0</INFO></NAVI>都聚在那里。冒险者，快去吧！";
		close;
	}
	mes "[Boy]";
	mes "我们村经常举行集会。大家会在那时聚在一起分享意见。";
	mes "但比赛不一样！这是非常重要的场合！";
	next;
	mes "[Boy]";
	mes "当然，不是谁都能参加。";
	mes "听说只有村里值得信赖的人才能加入。";
	next;
	mes "[Boy]";
	mes "冒险者也能参加吗？";
	mes "那就由你自己决定吧，冒险者！";
	close;

OnInit:
	questinfo( QTYPE_QUEST2, QMARK_YELLOW, "isbegin_quest(18082) == 1" );
	end;
}


// Main Quest: Step 36 + 41.
wolfvill,144,151,5	script(CLOAKED)	Suad#1	4_EP18_SUAD,{
	if (getequipid(EQI_HEAD_TOP) != 400127) {	// Ep18_Mini_Elly
		mes "[Mini Elly]";
	mes "把它从包里拿出来。请戴在头上。";
		close;
	}
	if (ep18_main < 38)
		end;
	if (ep18_main == 38) {
		cutin "ep18_suad_01.png",2;
		mes "[Suad]";
	mes "你来得有点晚。不过，没关系。";
	mes "往这边来。集会很快就要开始了。";
		next;
		cutin "ep18_maram_02.png",2;
		mes "[Maram]";
	mes "冒险者，你终于被邀请到这里了，真了不起。";
	mes "当然，我们也希望得到同样的待遇。";
		next;
		cutin "ep18_miriam_02.png",2;
		mes "[Miriam]";
	mes "……胡说。冒险者，别太在意马拉姆的话。";
	mes "这是重要场合。马拉姆，别像平时那样胡闹。";
		next;
		cutin "ep18_maram_03.png",2;
		emotion ET_HUK, getnpcid(0,"Maram#1");
		mes "[Maram]";
	mes "不，米莉娅姆！你这么说听起来像是我做错了什么。";
	mes "哦，好吧，好吧。我会专心的。";
		next;
		cutin "ep18_maram_01.png",2;
		mes "[Maram]";
	mes "虽然有点晚了，但苏阿德是例外，而且距离集会开始还有时间。";
	mes "冒险者，在来参加集会前，先听听大家的意见怎么样？";
		next;
		cutin "ep18_maram_02.png",2;
		mes "[Maram]";
	mes "我觉得参加集会肯定会有帮助……";
	mes "听故事的同时，也请整理一下你作为冒险者的看法。";
		next;
		cutin "ep18_suad_01.png",2;
		mes "[Suad]";
	mes "好啊。这样也不错。";
	mes "如果你听够了，就告诉我。我们开始集会吧。";
		erasequest 16567;
		setquest 16568;
		setquest 16569;
		setquest 16570;
		setquest 16571;
		ep18_main = 39;
		close3;
	}
	if (ep18_main == 39) {
		cutin "ep18_suad_01.png",2;
		mes "[Suad]";
	mes "听够了就告诉我。我会开始集会。";
		close3;
	}
	if (ep18_main == 40) {
		cutin "ep18_suad_01.png",2;
		mes "[Suad]";
	mes "大家都听到了吗？我们这边也准备好了。";
	mes "马上开始集会吧。";
		next;
		mes "[Suad]";
	mes "大家都已经就座。";
	mes "现在开始集会。";
		npctalk "苏阿德：大家都已经就座。现在开始集会。", "Suad#1", bc_self;
		next;
		mes "[Suad]";
	mes "今天我们要讨论今后的应对措施。";
	mes "灰狼村目前的情况并不乐观。";
		next;
		cutin "ep18_suad_03.png",2;
		mes "[Suad]";
	mes "如今无数人正在穿过奥兹峡谷来到村子。";
	mes "相应地，食物和生活必需品的供应严重不足。";
		next;
		mes "[Suad]";
	mes "现在我们必须决定今后的方向。";
		mes "有意见的人请尽管发言。";
		next;
		cutin "",255;
		emotion ET_ANGER, getnpcid(0,"Passionate Youth#Radica");
		mes "[Radical Man]";
		mes "让拉赫的移民尝尝我们的厉害。";
		mes "我们必须摧毁他们的神殿！";
		npctalk "没错！没错！", "Radical Youth#Radical2", bc_self;
		npctalk "我们必须摧毁一切！", "Hot-blooded Youth#Radic", bc_self;
		next;
		mes "[Mini Elly]";
		mes "刚才听故事时我就感觉到了，那些人特别粗暴。";
		mes "仅凭目前的信息，还很难判断是他们的言辞粗暴，还是他们本性如此。";
		next;
		mes "[Native old man]";
		mes "可是我们一直以来不是和平共处吗？";
		mes "突然要摧毁神殿，这是什么胡话，怎么突然闹成这样！";
		npctalk "有些话该说，有些话不能说！", "Timid Old Man#Elder4", bc_self;
		next;
		mes "[Radical Man]";
		mes "我还要在这块巴掌大的土地上躲多久？";
		mes "苏阿德先生不是也说过，与人类相比，我们的资源和土地都很匮乏吗？";
		next;

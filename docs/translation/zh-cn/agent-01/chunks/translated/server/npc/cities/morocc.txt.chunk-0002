	mes "[Armani]";
	mes "到底发生了什么？我们还有可能活下来吗？";
	next;
	switch(select("飞虫之王？！")) {
	case 1:
		mes "[Armani]";
		mes "没错，没错！我说的是龙蝇，所有飞虫的主人！！";
		mes "龙蝇很特别，它住在城镇东北方。";
		next;
		mes "[Armani]";
		mes "它比其他飞虫强大得多。";
		next;
		mes "[Armani]";
		mes "杀死它甚至有机会获得 ^880000发夹^000000！";
		next;
		mes "[Armani]";
		mes "总之，你不觉得魔王梦罗克太残酷了吗？";
		mes "虽然它们不是同一种生物，但一击夺走那只怪物的灵魂，不也很残酷吗？";
		next;
		mes "[Armani]";
		mes "当这可怕的邪恶再次复活时，我们该怎么办！";
		close;
	}
}

moc_ruins,173,70,4	script	Uncle Morocc#moc	48,{
	mes "[Phlanette]";
	mes "梦罗克位于极其干燥的地区，四周都是沙漠。";
	mes "世界上没有比梦罗克更炎热的地方。";
	next;
	mes "[Phlanette]";
	mes "我猜梦罗克这种炎热干燥的气候，是因为那个魔王长久以来被封印在地下深处。";
	next;
	switch(select("告诉我沙漠的事。:结束对话")) {
	case 1:
		mes "[Phlanette]";
		mes "嗯……如果你想知道，我就简单说说沙漠吧。";
		mes "由于年降雨量少、湿度低、蒸发率高，沙漠里几乎没有植被。";
		next;
		mes "[Phlanette]";
		mes "尽管如此，仍有少数顽强的植物能在沙漠中生存并成长。";
		next;
		mes "[Phlanette]";
		mes "遗憾的是，梦罗克周围的一些植物已经变异成怪物。";
		mes "其中一种就是变异仙人掌 Muka……";
		next;
		mes "[Phlanette]";
		mes "不过现在魔王复活了，没人知道梦罗克的生态循环会发生什么变化。";
		close;
	case 2:
		mes "[Phlanette]";
		mes "到处都是！";
		mes "到处都是沙子……";
		mes "哦，我诅咒你，梦罗克的沙漠！！";
		mes "可恶！";
		next;
		mes "[Phlanette]";
		mes "但即使如此，我也不希望它被彻底毁灭……";
		next;
		mes "[Phlanette]";
		mes "为什么总要等它消失后，才懂得珍惜它的价值？";
		close;
	}
}

moc_fild16,199,212,4	script	 Uncle Assassin#moc	55,{
	mes "[Hashisid]";
	mes "……刺客接受训练";
	mes "悄无声息地接近敌人，";
	mes "以及";
	mes "隐藏自己的意图。";
	mes "为此，";
	mes "我们从不";
	mes "直视目标的眼睛。";
	next;
	switch(select("刺客的理念:结束对话")) {
	case 1:
		mes "[Hashisid]";
		mes "那么……";
		mes "我来告诉你吧！";
		mes "刺客……";
		mes "通常被认为是";
		mes "毫无悔意地杀人的";
		mes "潜入者和杀手。";
		next;
		mes "[Hashisid]";
		mes "实际上，";
		mes "刺客一族";
		mes "禁止伤害无辜的人，";
		mes "或者至少，";
		mes "没有正当理由时绝不伤害";
		next;
		mes "[Hashisid]";
		mes "我们的真正使命是暗杀邪恶生物，";
		mes "并利用潜行收集情报，";
		mes "为了整个卢恩-米德加尔特的福祉。";
		close;
	case 2:
		mes "[Hashisid]";
		mes "很久以前，";
		mes "我们的祖先会";
		mes "在执行任务前";
		mes "吸食一种叫作‘Hashish’的烟草。";
		mes "不过我们现在已经不这样做了，";
		mes "因为昆虫或动物类怪物";
		mes "对气味非常敏感。";
		next;
		mes "[Hashisid]";
		mes "我们严禁";
		mes "吸烟或食用";
		mes "任何气味";
		mes "强烈的东西……";
		mes "如果你曾经";
		mes "试着吃那些";
		mes "带香料的臭蒜面包，";
		next;
		mes "[Hashisid]";
		mes "再躲到";
		mes "野猪或狼附近，";
		mes "相信我，";
		mes "你会被撕成碎片。";
		close;
	}
}

moc_fild16,211,254,4	script	Assassin#07rhea_30	118,{
	mes "[La Conte]";
	mes "盗贼晋升为刺客后";
	mes "这是一种非常专业的职业，";
	mes "他们就能采用多种战斗风格。";
	mes "他们的战斗风格。";
	mes "刺客主要有两种战斗风格。";
	mes "他们可以使用双短剑，";
	mes "或使用一套拳刃！";
	next;
	switch(select("拳刃专精:双短剑专精:结束对话")) {
	case 1:
		mes "[La Conte]";
		mes "一套拳刃";
		mes "装备在双手，";
		mes "让刺客能够";
		mes "快速斩击敌人。";
		mes "任何人都能在梦罗克某处";
		mes "买到基础拳刃";
		mes "当然，只有刺客能使用。";
		next;
		mes "[La Conte]";
		mes "右手拳刃";
		mes "通常造成更多伤害，";
		mes "左手拳刃";
		mes "则用于追加攻击。";
		mes "不过拳刃装备在双手，";
		mes "因此无法装备盾牌或额外武器。";
		next;
		mes "[La Conte]";
		mes "与双短剑相比，";
		mes "拳刃攻击速度更快。";
		mes "而且 ^663399音速投掷^000000 技能";
		mes "只能使用拳刃施放。";
		next;
		mes "[La Conte]";
		mes "在 ^663399拳刃修炼 4 级^000000 时";
		mes "可以学习音速投掷。";
		mes "如果你是刺客，";
		mes "这是很实用的技能。";
		next;
		mes "[La Conte]";
		mes "音速投掷是一个";
		mes "连续造成 8 次";
		mes "无属性伤害的技能。";
		close;
	case 2:
		mes "[La Conte]";
		mes "双短剑";
		mes "允许你装备";
		mes "两种不同的短剑";
		mes "同时使用。";
		mes "当然，";
		mes "除了短剑之外也可以装备其他武器，";
		mes "但攻击速度可能会降低。";
		next;
		mes "[La Conte]";
		mes "不过它们可能会";
		mes "缺乏";
		mes "攻击速度。";
		mes "所以我建议使用短剑。";
		mes "另外，如果右手没有短剑，";
		mes "你将无法使用";
		mes "^663399二刀连击^000000 技能。";
		next;
		mes "[La Conte]";
		mes "使用双短剑时，";
		mes "右手短剑会进行二连击";
		mes "右手短剑进行攻击时，";
		mes "左手武器则进行一次攻击。";
		next;
		mes "[La Conte]";
		mes "所以一击就能造成";
		mes "三次打击！";
		mes "你无法反驳";
		mes "这样的伤害！";
		close;
	case 3:
		mes "[La Conte]";
		mes "希望你能善用";
		mes "你手头的";
		mes "武器。";
		mes "记住";
		mes "策略的重要性，";
		mes "以及";
		mes "规划你的攻击。";
		close;
	}
}


moc_fild16,195,281,4	script	Assassin Guardian#1::SinGuard	707,{
	mes "[Assassin Guardian]";
	if(BaseJob == Job_Assassin) {
		mes "欢迎。";
		close;
	}
	set .@temp, rand(1,4);
	if(.@temp == 1) mes "........";
	if(.@temp == 2) mes "嗯……";
	if(.@temp == 3) mes "嗯……你不该来这里……";
	if(.@temp == 4) mes "你擅自闯入禁地……";
	close;
}


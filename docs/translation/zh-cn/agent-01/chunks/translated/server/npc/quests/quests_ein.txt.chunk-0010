		mes "^333333*Cough! Cough!*^000000";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "...";
		mes "我最好";
		mes "赶紧离开";
		mes "他身边！";
		next;
		mes "^3355FF你从希克曼身边逃开了，";
		mes "希克曼倒在地上时，你逃离了他。";
		mes "无论有意还是无意，";
		mes "现在都不该再激怒这位老人。^000000";
		changequest 2071,2072;
		set Shinokas_Quest,2;
		close2;
		cutin "ein_hicman",255;
		end;
	}
	else if (Shinokas_Quest == 2) {
		mes "^3355FFIt'd be best";
		mes "暂时最好不要激怒这位老人。^000000";
		close2;
		cutin "ein_hicman",255;
		end;
	}
	else if (Shinokas_Quest == 10) {
		mes "^3355FF希克曼在椅子上打瞌睡。";
		mes "从他脸上的痛苦表情来看，";
		mes "他似乎正在做噩梦。";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "不好意思……";
		next;
		mes "[Buender Hikeman]";
		mes "嗯……？";
		mes ".........!!";
		mes "哈哈哈哈哈！";
		mes "回来挨打吧，";
		mes "希诺卡斯？！";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "听着……！";
		mes "我不是希诺卡斯，好吗？";
		mes "你怎么能忘记他的长相和年龄？";
		mes "我可年轻多了！";
		next;
		mes "[Buender Hikeman]";
		mes "什么……？";
		next;
		mes "[Buender Hikeman]";
		mes "................";
		emotion ET_SURPRISE;
		next;
		mes "[Buender Hikeman]";
		mes "呃……";
		next;
		mes "[Buender Hikeman]";
		mes "嗯。";
		next;
		if (Sex == SEX_FEMALE) {
			mes "["+strcharinfo(0)+"]";
			mes "还有……";
			mes "我是可爱的女孩！";
			mes "希诺卡斯是男性，";
			mes "而且有点……";
			next;
			mes "[Buender Hikeman]";
			mes "什么……？";
			mes "不可能！";
			next;
			mes "["+strcharinfo(0)+"]";
			mes "...";
			mes "......";
			next;
			mes "[Buender Hikeman]";
			mes "...";
			mes "......";
			next;
		}
		mes "[Buender Hikeman]";
		mes "看来……";
		mes "我犯了一个";
		mes "巨大的错误。";
		next;
		mes "[Buender Hikeman]";
		mes "自从那场事故后，人们都说我变了。也许他们是对的。";
		next;
		mes "[Buender Hikeman]";
		mes "我总是犯同样的错误，";
		mes "也许他们说我老糊涂了是对的。";
		mes "你是专程来澄清这个误会的吗？";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "呃……";
		mes "其实……";
		next;
		switch(select("告诉希克曼希诺卡斯的死讯。:不通知希克曼。")) {
		case 1:
			mes "["+strcharinfo(0)+"]";
			mes "希诺卡斯不久前";
			mes "死在了艾因布洛克。";
			next;
			mes "[Buender Hikeman]";
			mes "什、什么……？";
			next;
			mes "["+strcharinfo(0)+"]";
			mes "希诺卡斯被一些人杀害了。";
			mes "他认为那些人可能就是雇用你们的人。";
			mes "最后，他也遭到了背叛……";
			next;
			mes "[Buender Hikeman]";
			mes "我……";
			mes "我明白了……";
			next;
			mes "["+strcharinfo(0)+"]";
			mes "希诺卡斯或许拿到了一些钱，";
			mes "但余生都躲藏起来，";
			mes "一直被人追杀。";
			next;
			mes "[Buender Hikeman]";
			mes "什么都没有了。";
			mes "我已经没有任何期待。";
			mes "我活着只是为了给朋友们复仇……";
			next;
			mes "[Buender Hikeman]";
			mes "请……";
			mes "回到你来的地方去吧。";
			mes "别管我……";
			next;
			mes "["+strcharinfo(0)+"]";
			mes "...";
			next;
			mes "["+strcharinfo(0)+"]";
			mes "^333333希克曼真的想向希诺卡斯复仇吗？";
			mes "还是因为他们曾是亲密朋友，想听他解释？^000000";
			next;
			mes "["+strcharinfo(0)+"]";
			mes "^333333如果我提到他们找到的是";
			mes "伊米尔之心碎片，希克曼可能也会被追杀，";
			mes "所以我最好什么都别说。^000000";
			next;
			mes "["+strcharinfo(0)+"]";
			mes "^333333那些人为什么如此执着于";
			mes "伊米尔之心碎片？真的值得如此残酷吗？";
			mes "不管他们是谁，动机都不会是好的。";
			close2;
			cutin "ein_hicman",255;
			completequest 2078;
			set Shinokas_Quest,11;
			if (checkre(3)) {
				if (BaseLevel < 70) getexp 30000,30000;
				else if ((BaseLevel > 69) && (BaseLevel < 80)) getexp 40000,40000;
				else if ((BaseLevel > 79) && (BaseLevel < 90)) getexp 70000,70000;
				else getexp 90000,90000;
			} else {
				if (BaseLevel < 70) getexp 100000,80000;
				else if ((BaseLevel > 69) && (BaseLevel < 80)) getexp 300000,100000;
				else if ((BaseLevel > 79) && (BaseLevel < 90)) getexp 500000,300000;
				else getexp 700000,500000;
			}
			end;
		case 2:
			mes "["+strcharinfo(0)+"]";
			mes "是的……";
			mes "没错。";
			mes "我只是想澄清这个误会，";
			mes "让你哪怕稍微平静一点。";
			next;
			mes "[Buender Hikeman]";
			mes "你不用太担心我的压力。";
			mes "我觉得吹过这座城镇的风";
			mes "非常令人放松。";
			next;
			mes "[Buender Hikeman]";
			mes "每当风吹过，视线就会模糊，";
			mes "记忆变得朦胧，所有仇恨也随之飘散。";
			next;
			mes "[Buender Hikeman]";
			mes "没有风的话，我只剩下对^FF0000他的^000000仇恨。";
			mes "也许这是我活着的唯一理由，也许我很孤独，";
			mes "但现在已经没时间自怨自艾了。";
			close2;
			cutin "ein_hicman",255;
			end;
		}
	}
	else {
		mes "^3355FF希克曼在椅子上打瞌睡。";
		mes "从他脸上的痛苦表情来看，";
		mes "他似乎正在做噩梦。";
		cutin "ein_hicman",255;
		close;
	}
}

ein_in01,231,163,7	script	Sick Old Man#ein	849,{
	if (Shinokas_Quest < 2) {
		mes "[Sick Old Man]";
		mes "...!";
		next;
		mes "[Sick Old Man]";
		mes "呜呜～";
		mes "痛死我了！";
		mes "啊——呜啊！";
		mes "我、我的儿子什么时候";
		mes "才会从工厂回来……？！";
		next;
		mes "^3355FF看着老人痛苦地在床上翻滚，";
		mes "你感到非常尴尬。^000000";
		close;
	}
	else if (Shinokas_Quest == 2) {
		mes "[Sick Old Man]";
		mes "...!";
		next;
		mes "[Sick Old Man]";
		mes "呜呜～";
		mes "痛死我了！";
		mes "啊——呜啊！";
		mes "我、我的儿子什么时候";
		mes "才会从工厂回来……？！";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "希……";
		mes "希诺卡斯？";
		next;
		mes "[Sick Old Man]";
		mes "嗯……？";
		mes "不——！我、我叫希诺塔罗斯。";
		mes "你、你认错人了！";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "^333333这一定就是希克曼在艾因贝赫提到的希诺卡斯。";
		mes "嗯……但要怎么让他承认呢？^000000";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "^333333*Ahem!*^000000";
		mes "不好意思……";
		next;
		while(1) {
			if (.@einbech > 6) {
				if (select("你以前听说过^3131FF希克曼^000000吗？:你以前不是住在^3131FF艾因贝赫^000000吗？") == 1) {
					break;
				}
				mes "[Sick Old Man]";
				mes "艾因贝赫……？";
				mes "不！我以前从没住在那里！";
				next;
				mes "^3355FF看来这位老人没有说实话……^000000";
				set .@einbech,0;
				next;
			}
			else {
				switch(select("记得矿井隧道坍塌吗？:你以前不是矿工吗？:你一辈子都住在艾因布洛克吗？")) {
				case 1:
					mes "[Sick Old Man]";
					mes "不——！";
					mes "我不知道你到底在说什么！";
					set .@einbech,.@einbech+1;
					next;
					break;
				case 2:
					mes "[Sick Old Man]";
					mes "不……！";
					mes "你、你为什么会问这种问题？！";
					set .@einbech,.@einbech+1;
					next;
					break;
				case 3:
					mes "[Sick Old Man]";
					mes "是、是的！";
					mes "我在艾因贝——艾因布洛克出生并长大！";
					next;
					mes "^3355FF看来这位老人没有说实话……^000000";
					if (.@einbech > 0) {
						set .@einbech,0;
					}
					next;
					break;
				}
			}
		}
		mes "["+strcharinfo(0)+"]";
		mes "你确定自己对^3131FF希克曼^000000一无所知吗？";
		next;
		mes "[Shinokas]";
		mes "不……！";
		mes "我一生都没见过";
		mes "布恩德·希克曼——";
		next;
		mes "[Shinokas]";
		mes "...";
		mes ".......";
		emotion ET_PROFUSELY_SWEAT;
		next;
		mes "["+strcharinfo(0)+"]";
		mes "我猜对了。";
		mes "你就是希诺卡斯！";
		emotion ET_KIK, playerattached();
		next;
		mes "[Shinokas]";
		mes "可恶！";
		mes "我的身份暴露了！";
		mes "等、等等！你知道多少？！";
		emotion ET_HUK;
		next;
		mes "[Shinokas]";
		mes "是^3131FF他们^000000派你来的吗？";
		mes "^333333*叹气*^000000我想就到此为止了。";
		mes "我到死也无法解开这个秘密。";
		next;
		mes "[Shinokas]";
		mes "好吧。";
		mes "继续说吧。";
		mes "我准备好了……";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "把你知道的关于那起事故的一切告诉我，";
		mes "就是矿井隧道在你和希克曼身边坍塌的那次。";
		next;
		mes "[Shinokas]";
		mes "...?";
		mes "呃……";
		mes "你不是来杀我的？";
		emotion ET_QUESTION;
		next;
		mes "["+strcharinfo(0)+"]";
		mes "不……！";
		mes "我是来查明真相的！";
		next;
		mes "[Shinokas]";
		mes "这意味着……";
		mes "我还有一点时间。";
		mes "这一定是命运！";
		mes "好吧，我告诉你发生了什么。";
		mes "不过那是个很长的故事……";
		changequest 2072,2073;
		set Shinokas_Quest,3;
		close;
	}
	else if (Shinokas_Quest == 3) {
		mes "[Shinokas]";
		mes "你对那起事故了解多少？不，等等，别回答。";
		mes "我不想听。";
		next;
		mes "[Shinokas]";
		mes "我承认。是的，我背叛了朋友。";
		mes "这是不可饶恕的罪孽，会纠缠我直到死去。";
		next;
		mes "[Shinokas]";
		mes "我为了钱出卖朋友，摧毁了那条隧道并杀死了他们。";
		mes "但我想我也被欺骗了。^3131FF他们^000000从没打算履行协议。";
		next;
		mes "[Shinokas]";
		mes "摧毁隧道后，他们盯上了我。";
		mes "我的余生都在被追杀、四处逃亡。";
		mes "那究竟是什么^3131FF矿石^000000，为什么如此重要？";
		next;
		mes "[Shinokas]";
		mes "如果值得为它杀人，我必须进一步了解那种矿石。";
		mes "所以我冒险潜入艾因布洛克。据说类似我们发现的矿石最近被运到了这里。";
		next;
		select("你找到它了吗？");
		mes "[Shinokas]";
		mes "还没有。";
		mes "我每天晚上都在寻找那种矿石。";
		mes "白天，这位好心的铁匠会把我藏起来，躲过那些人。";
		next;
		mes "[Shinokas]";
		mes "但我不会安全太久。";
		mes "听着，我不是圣人，但在死前，";
		mes "我想完成最后一件事，看看这种矿石究竟有多神奇……";
		next;
		select("等等，谁在追杀你？");
		mes "[Shinokas]";
		mes "谁想杀我？就是最初雇用我和朋友挖掘矿石的人。";
		mes "我们以为他们只是普通商人，";
		mes "但……他们很危险。";
		next;
		mes "[Shinokas]";
		mes "所以我把一切都告诉你了，";
		mes "现在你知道我的日子可能所剩无几。";
		mes "请帮老人一个忙，在艾因布洛克寻找那种神秘的矿石。";
		next;
		mes "[Shinokas]";
		mes "我在这座城镇了解到的第一件事，就是最富有的家族是卡佩尔泰因家族。";
		mes "只有富有而强大的人，才可能卷入这么大的事情。";
		next;
		mes "[Shinokas]";
		mes "你能去卡佩尔泰因宅邸寻找那种矿石吗？";
		mes "宅邸就在通往机场的路上，很容易找到。";
		mes "毕竟他们是艾因布洛克最富有的人。";
		next;
		mes "[Shinokas]";
		mes "我太老也太虚弱，无法离开这所房子，而且那些人可能会找到我。";
		mes "如果你能体谅我的处境，请查查卡佩尔泰因家族是否拥有独特的矿石……";
		changequest 2073,2074;
		set Shinokas_Quest,4;
		close;
	}
	else if (Shinokas_Quest == 4) {
		mes "[Shinokas]";
		mes "拜托……";
		mes "查清卡佩尔泰因家族是否藏有某种独特矿石。";
		mes "他们的宅邸就在通往机场的路上。";
		close;
	}
	else if (Shinokas_Quest == 5) {

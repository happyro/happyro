ice_dun02,120,3,0	script	#cave_vos	-1,{
OnInit:
	initnpctimer;
	end;

OnTimer3600000:
		mapannounce "ice_dun02","滚开，你们这些畜生！等我脱身后就把你们烧死！",bc_map,0xFFCE00;
	end;

OnTimer7200000:
		mapannounce "ice_dun02","喂？有人听得到吗？我……我好像被困住了！",bc_map,0xFFCE00;
	end;

OnTimer10800000:
	stopnpctimer;
		mapannounce "ice_dun02","拜托！我动不了！喂？我想我需要帮助！",bc_map,0xFFCE00;
	initnpctimer;
	end;
}

rachel,265,98,3	script	Hamion#aru	930,{
	if (checkweight(908,200) == 0) {
		mes "^3355FF等等！";
		mes "你现在携带的物品太多了。";
		mes "请使用卡普拉服务存放一些物品后再回来。^000000";
		close;
	}
	if (ice_necklace_q < 2) {
		mes "[哈米恩]";
		mes "嗯？你需要什么吗？";
		mes "如果不是什么重要的事，";
		mes "我想继续读我的书。";
		close;
	}
	else if (ice_necklace_q == 2) {
		mes "[哈米恩]";
		mes "嗯？你需要什么吗？";
		mes "如果不是什么重要的事，";
		mes "我想继续读我的书。";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "呃，你认识一位叫马赫奥的法师吗？";
		mes "我应该在这一带寻找他的师父。";
		next;
		mes "[哈米恩]";
		mes "你已经找到他了，";
		mes "因为我就是他的师父。";
		mes "马赫奥怎么了？";
		next;
		mes "[哈米恩]";
		mes "他把自己冻住了？！";
		mes "哈哈哈哈！真是个天才！";
		mes "嗯，我想他还有很多东西要学，";
		mes "至少在性格方面是这样。";
		next;
		mes "[哈米恩]";
		mes "让我看看，让我看看……";
		mes "这本书里应该有答案。嗯……啊！";
		mes "第 42 页！我需要制作一件神器，";
		mes "才能打破那块神秘的冰。嗯。";
		next;
		mes "[哈米恩]";
		mes "你能帮我吗？我需要";
		mes "^4D4DFF5 个粗糙的风^000000、";
		mes "^4D4DFF1 把锤子^000000和";
		mes "^4D4DFF1 个空白卷轴^000000";
		next;
		mes "[哈米恩]";
		mes "你可以在朱诺的贤者学院取得空白卷轴。";
		mes "还有，锤子是武器，";
		mes "不是那些锻造工具。";
		mes "如果可以我也想帮你，但……";
		mes "我只是聪明，并不强壮。";
		set ice_necklace_q,3;
		changequest 2110,2111;
		close;
	}
	else if (ice_necklace_q == 3) {
		if ((countitem(996) < 5) || (countitem(1354) < 1) || (countitem(7433) < 1)) { 
			mes "[哈米恩]";
			mes "我需要制作一件魔法神器，";
			mes "打破困住马赫奥的冰。";
			mes "请你帮帮我好吗？";
			mes "我没办法自己取得那些物品！";
			next;
			mes "[哈米恩]";
			mes "我需要取得";
			mes "^4D4DFF5 个粗糙的风^000000、";
			mes "^4D4DFF1 把锤子^000000和";
			mes "^4D4DFF1 个空白卷轴^000000";
			next;
			mes "[哈米恩]";
			mes "你可以在朱诺的贤者学院取得空白卷轴。";
			mes "还有，锤子是武器，";
			mes "不是那些锻造工具。";
			mes "如果可以我也想帮你，但……";
			mes "我只是聪明，并不强壮。";
			close;
		}
		mes "[哈米恩]";
		mes "太好了，你带来了我需要的一切！";
		mes "不过首先，请确认你只携带";
		mes "你的库存里有 1 把锤子吗？";
		mes "如果你带了不止一把，";
		mes "我可能会拿错锤子。";
		next;
		if (select("让我检查一下。:不用担心，我已经检查过了。") == 1) {
			mes "[哈米恩]";
			mes "好吧，小心总比后悔好！";
			mes "要是马赫奥能像你一样";
			mes "稍微谨慎一点，也许就不会发生这种事了。";
			close;
		}
		mes "[哈米恩]";
		mes "好吧，我相信你。现在开始锻造神器。";
		mes "嗯……让我在第 45 页复习一下。";
		next;
		mes "[哈米恩]";
		mes "开始吧……！";
		next;
		specialeffect2 EF_CONE;
		mes "^3355FF*滋滋滋*^000000";
		next;
		mes "[哈米恩]";
		mes "……好了，现在完成了。";
		mes "拿着这把风之锤，用它解救马赫奥。";
		mes "这把锤子只能使用一次，";
		mes "所以一定要正确地砸碎冰块！";
		delitem 1354,1; //Hammer
		delitem 996,5; //Rough_Wind
		delitem 7433,1; //Scroll
		set ice_necklace_q,4;
		changequest 2111,2112;
		getitem 7569,1; //Hammer_of_Wind
		close;
	}
	else if (ice_necklace_q >= 4) {
		mes "[哈米恩]";
		mes "这里总有歌唱的鸟儿，";
		mes "还有翩翩飞舞的蝴蝶。";
		mes "到处都是它们的身影，";
		mes "真让人放松，";
		mes "是个读书的好地方。";
		close;
	}
}

rachel,113,97,5	script	Mohadian	929,10,10,{
	if (ice_necklace_q == 6) {
		mes "[莫哈迪安]";
		mes "我在附近的酒吧工作，";
		mes "听说过不少关于你的好事。";
		mes "有些客人说你曾进入危险的冰洞，";
		mes "帮助过乌斯蒂拉。";
		next;
		mes "[莫哈迪安]";
		mes "那么，你真的能定期打败";
		mes "里面的雪地魔物吗？";
		mes "如果可以，我有一笔生意想和你谈。";
		next;
		emotion ET_AHA;
		mes "[莫哈迪安]";
		mes "这里的天气又热又潮湿，";
		mes "所以酒吧需要冰块来制作清凉饮料。";
		mes "而冰洞是取得冰块的最佳地点，对吧？";
		next;
		mes "[莫哈迪安]";
		mes "如果你从冰洞带来冰块，";
		mes "我会以每块 375 Zeny 的价格收购。";
		mes "就把它当作自由职业吧。";
		mes "只要你能带来冰块，我就会收购！";
		next;
		mes "[莫哈迪安]";
		mes "你能赚到不少钱，";
		mes "我的客人能享用冰凉饮料，";
		mes "我的生意也会受益。";
		mes "这是一举三得！你觉得呢？";
		next;
		if (select("不用了，谢谢。:当然可以。") == 1) {
		mes "[莫哈迪安]";
			mes "哎呀，真令人失望。";
			mes "我本来很确定这对我们双方都是好事。";
			mes "如果你改变主意，";
			mes "我们就能成为伙伴！";
			close;
		}
		mes "[莫哈迪安]";
		mes "太好了！我需要的冰块来自冰晶之心。";
		mes "你可以在冰洞猎杀雪地魔物取得它们。";
		mes "记住，每个我会支付 375 Zeny！";
		set ice_necklace_q,7;
		close;
	}
	else if (ice_necklace_q == 7) {
		if (countitem(7561) < 1) {
		mes "[莫哈迪安]";
			mes "从冰洞带些冰晶之心给我，";
			mes "我一定会用 Zeny 补偿你。";
			mes "仔细想想，这对我们双方都是很好的交易。";
			close;
		}
		mes "[莫哈迪安]";
		mes "太好了，你带来了冰晶之心！";
		mes "这些冰晶的美丽与纯净，";
		mes "我永远都看不腻。";
		next;
		mes "[莫哈迪安]";
		mes "没错，我甚至可以用它们制作阿鲁纳佩尔兹冰酒。";
		mes "总之，让我看看你带来了多少。";
		next;
		set .@hearts,countitem(7561);
		set .@totalprice,375*.@hearts;
		mes "[莫哈迪安]";
		mes .@hearts +" 个冰晶之心";
		mes "每个 375 Zeny……";
		mes "看来我该付给你";
		mes .@totalprice +" Zeny。给你！";
		mes "和你做生意总是很愉快~";
		delitem 7561,.@hearts; //Glacial Hearts
		set Zeny, Zeny+.@totalprice;
		close;
	}

OnTouch_:
	if (ice_necklace_q == 6) {
		mes "[莫哈迪安]";
		mes "欢迎来到——";
		mes "呃？你好？";
		mes "请问有人吗？";
		close;
	}
	end;
}

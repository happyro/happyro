		mes "……但它的威力是那个的两百倍！没错……";
		mes "它拥有一百万颗爆炸太阳的力量！不过后来……";
		next;
		emotion ET_CRY;
		mes "[马赫奥]";
		mes "威力太强了！";
		mes "地面震动，冰块四处飞溅，";
		mes "而且火焰把我的衣服都点着了！";
		next;
		emotion ET_SPARK, playerattached();
		mes "["+strcharinfo(0)+"]";
		mes "你……";
		mes "你把自己的衣服";
		mes "点着了";
		next;
		cutin "ra_magic2",2;
		mes "[马赫奥]";
		mes "没错，不过不用担心。";
		mes "我很快就用强力的冰冻术";
		mes "把火焰扑灭了！";
		next;
		cutin "ra_magic3",2;
		mes "[马赫奥]";
		mes "现在回想起来……";
		mes "那可能是个错误……";
		next;
		cutin "ra_magic3",2;
		mes "[马赫奥]";
		mes "先不说我自己了。";
		mes "什么高尚的追求让你来到这里，冒险者？";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "我听说你能用魔法";
		mes "打磨这条项链上的宝石，";
		mes "所以特地来找你。";
		next;
		mes "[马赫奥]";
		mes "当然可以，我能让那些宝石";
		mes "闪耀出一百万颗爆炸太阳般的光芒！";
		next;
		mes "[马赫奥]";
		mes "不过得先让我从这块冰里出来。嗯……";
		mes "但普通魔法恐怕";
		mes "无法融化这么多冰。";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "那我们要怎么做";
		mes "才能把你";
		mes "从那里救出来？";
		next;
		mes "[马赫奥]";
		mes "别害怕。我相信我的师父一定知道";
		mes "如何把我从这座冰牢里解救出来。";
		mes "他就在芙蕾雅之泉附近，";
		mes "请代我向他求助！";
		set ice_necklace_q,2;
		changequest 2109,2110;
		close2;
		cutin "",255;
		end;
	}
	else if ((ice_necklace_q == 2) || (ice_necklace_q == 3)) {
		mes "[马赫奥]";
		mes "我的师父也许没有我这样的天赋，";
		mes "但他非常精通魔法。请……";
		mes "向他求助。他应该在芙蕾雅之泉附近读书。";
		close;
	}
	else if (ice_necklace_q == 4) {
		if (countitem(7569) > 0) {
			if (countitem(7572) > 0) {
				mes "[马赫奥]";
				mes "哦，你回来了！";
				mes "我的师父有没有想到";
				mes "打破这座冰牢的办法？";
				next;
			}
			else {
				mes "["+strcharinfo(0)+"]";
				mes "糟糕！我把项链落在城里了！我马上回来！";
				next;
				mes "[马赫奥]";
				mes "嘿，嘿！你不能先把我放出来吗？";
				emotion ET_CRY;
				close;
			}
		}
		else {
			mes "[马赫奥]";
			mes "我的师父也许没有我这样的天赋，";
			mes "但他非常精通魔法。请……";
			mes "向他求助。他应该在芙蕾雅之泉附近读书。";
			close;
		}
		mes "["+strcharinfo(0)+"]";
		mes "他制作了一把魔法锤，";
		mes "据说可以打破这块魔法冰。";
		next;
		mes "[马赫奥]";
		mes "当然可以！";
		mes "我怎么没想到呢？太好了，";
		mes "现在请把我救出来！";
		next;
		mes "^3355FF你紧紧握住风之锤，";
		mes "用尽全力向冰块砸下。^000000";
		next;
		specialeffect EF_TEIHIT3;
		specialeffect EF_FREEZE;
		specialeffect EF_ICECRASH;
		mes "^3355FF*滋滋滋*";
		mes "*哐！*^000000";
		next;
		setnpcdisplay "Man Stuck in Ice#cave",937;
		emotion ET_SURPRISE;
		mes "[马赫奥]";
		mes "终于……！";
		mes "经过这么长时间！我自由了！";
		next;
		specialeffect EF_BEGINSPELL4;
		mes "[马赫奥]";
		mes "现在，这个洞窟里的所有魔物";
		mes "都将尝到世界最强法师的怒火！";
		mes "我要复仇，让那些野兽承受";
		mes "它们施加给我的双倍痛苦！";
		next;
		monster "ice_dun02",108,109,"Snowier",1775,1,"Man Stuck in Ice#cave::OnMyMobDead";
		monster "ice_dun02",114,112,"Snowier",1775,1,"Man Stuck in Ice#cave::OnMyMobDead";
		monster "ice_dun02",126,105,"Snowier",1775,1,"Man Stuck in Ice#cave::OnMyMobDead";
		monster "ice_dun02",121,99,"Snowier",1775,1,"Man Stuck in Ice#cave::OnMyMobDead";
		specialeffect EF_LORD;
		killmonster "ice_dun02","Man Stuck in Ice#cave::OnMyMobDead";
		mes "[马赫奥]";
		mes "哇哈哈哈哈哈哈哈！";
		next;
		mes "[马赫奥]";
		mes "呃，不过首先，我得用魔法";
		mes "清洁你的项链。";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "给你……";
		next;
		mes "[马赫奥]";
		mes "哦！这是矮人制作的，对吧？";
		mes "看来他们又完成了一件杰作。";
		mes "不过真可惜，它已经这么黯淡了。";
		next;
		mes "[马赫奥]";
		mes "让我看看……";
		next;
		specialeffect EF_FROSTWEAPON;
		mes "^3355FF*叮*^000000";
		next;
		mes "[马赫奥]";
		mes "好了，我想我们要在这里分别了。";
		mes "拿着这个，就当作礼物……";
		mes "请不要告诉别人";
		mes "我把自己困在冰里的事，好吗？";
		set ice_necklace_q,5;
		changequest 2112,2113;
		delitem 7569,1; //Hammer_Of_Wind
		delitem 7572,1; //Magic_Necklace
		getitem 7573,1; //Magic_Necklace_
		getitem 7574,4; //Ice_Particle
		close2;
		cutin "",255;
		setnpcdisplay "Man Stuck in Ice#cave",924;
		end;
	}

OnTouch:
	end;

OnTouchNPC: 
	emotion ET_FRET;
	emotion ET_KIK, getattachedrid();
	end;

OnMyMobDead:
	end;
}

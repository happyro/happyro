//= 1.0 First version, Renewal guide.
//= 1.1 Added missing case. [Joseph]
//= 1.2 Navigation system update. [Euphy]
//============================================================ 

ayothaya,203,169,4	script	Ayothaya Guide Noi#01ay	839,{
	if (strnpcinfo(0) == "Ayothaya Guide Noi#01ay")
		set .@n$, "[Noi]";
	else
		set .@n$, "[Noa]";
	mes .@n$;
	mes "你好～";
	mes "欢迎来到 ^8B4513阿由他雅^000000。";
	mes "这座城镇通过一片原始森林与河流相连。";
	mes "这是一个非常宁静的国度。";
	mes "请慢慢四处逛逛吧。";
	F_Navi(.@n$);
	while (1) {
		next;
		switch(select("[ 武器店 ]:[ 道具店 ]:[ 酒馆 ]:[ 神殿 ]:[ 钓鱼点 ]:[ 艾巴克辛 ]:移除小地图标记:取消")) {
		case 1:
			mes .@n$;
			mes F_Navi("武器店","ayothaya,163,90","^0000FF");
			mes "阿由他雅的武器店出售特殊武器。";
			mes "你可以在那里找到很棒的武器。";
			mes "还需要我为你做些什么吗？";
			viewpoint 1,163,90,0,0x0A82FF;
			break;
		case 2:
			mes .@n$;
			mes "我们的居民会在"+F_Navi("道具店","ayothaya,131,86","^006400")+"购买各种商品。";
			mes "你需要的东西在那里都能找到。";
			mes "还需要其他东西吗？";
			viewpoint 1,131,86,1,0xAAFF00;
			break;
		case 3:
			mes .@n$;
			mes "冒险的一部分就是收集情报。";
			mes F_Navi("酒馆","ayothaya,229,72","^008080")+"里聚集了许多旅行者，你可以在那里获得有用的情报。";
			mes "还需要我为你做些什么吗？";
			viewpoint 1,229,72,2,0x008080;
			break;
		case 4:
			mes .@n$;
			mes "想要平静心情，就去"+F_Navi("神殿","ayothaya,208,280","^FF1493")+"祈祷吧。";
			mes "还需要我为你做些什么吗？";
			viewpoint 1,208,280,3,0xFF1493;
			break;
		case 5:
			mes .@n$;
			mes "阿由他雅靠近海滩，所以大多数人都喜欢钓鱼。";
			mes "他们真的很喜欢钓鱼。";
			mes "去"+F_Navi("钓鱼","ayothaya,255,99","^8B4513")+"试着钓一条大鱼吧。";
			mes "还需要我为你做些什么吗？";
			viewpoint 1,255,99,4,0x8B4513;
			break;
		case 6:
			mes .@n$;
			mes "如果你想回家，";
			mes "就去找"+F_Navi("艾巴克辛","ayothaya,151,68","^00BFFF");
			mes "请他送你回去。";
			mes "还需要我为你做些什么吗？";
			viewpoint 1,151,68,5,0x00BFFF;
			break;
		case 7:
			mes .@n$;
			mes "我会移除你小地图上的所有标记。";
			mes "还需要其他东西吗？";
			viewpoint 2,1,1,0,0xFFFFFF;
			viewpoint 2,1,1,1,0xFFFFFF;
			viewpoint 2,1,1,2,0xFFFFFF;
			viewpoint 2,1,1,3,0xFFFFFF;
			viewpoint 2,1,1,4,0xFFFFFF;
			viewpoint 2,1,1,5,0xFFFFFF;
			break;
		case 8:
			mes .@n$;
			mes "旅途愉快～！";
			close;
		}
	}
}
ayothaya,146,86,4	duplicate(Ayothaya Guide Noi#01ay)	Ayothaya Guide Noa#02ay	839

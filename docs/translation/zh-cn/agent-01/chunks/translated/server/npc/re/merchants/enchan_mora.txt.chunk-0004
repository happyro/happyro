	if (countitem(getarg(0)) < 1)
		return 0;
	delitem getarg(0),1;
	set .@i, rand(1,4568);
	if (.@i <= 3168) {
		// Basic combinations
		// (raw: .@i increments by 11)
		setarray .@enchant_slot1[0],4766,4767,4764,4765,4762,4763,4760,4761; //Atk2,Atk3,Critical5,Critical7,Evasion6,Evasion12,Matk1,Matk2
		setarray .@enchant_slot2[0],4720,4721,4710,4711,4750,4751; //Dexterity1,Dexterity2,Inteligence1,Inteligence2,Luck1,Luck2
		setarray .@enchant_slot3[0],4700,4701,4730,4731,4740,4741; //Strength1,Strength2,Agility1,Agility2,Vitality1,Vitality2
		setarray .@enchants[1],
			.@enchant_slot1[rand(getarraysize(.@enchant_slot1))],
			.@enchant_slot2[rand(getarraysize(.@enchant_slot2))],
			.@enchant_slot3[rand(getarraysize(.@enchant_slot3))];
	}
	else if (.@i <= 3179) setarray .@enchants[1],4761,4720,4700; //Matk2 Dexterity1 Strength1
	else if (.@i <= 3181) setarray .@enchants[1],4761,4712,4712; //Matk2 Inteligence3 Inteligence3
	else if (.@i <= 3183) setarray .@enchants[1],4765,4732,4732; //Critical7 Agility3 Agility3
	else if (.@i <= 3185) setarray .@enchants[1],4763,4752,4753; //Evasion12 Luck3 Luck4
	else if (.@i <= 3187) setarray .@enchants[1],4763,4742,4742; //Evasion12 Vitality3 Vitality3
	else if (.@i <= 3189) setarray .@enchants[1],4763,4722,4722; //Evasion12 Dexterity3 Dexterity3
	else if (.@i <= 3191) setarray .@enchants[1],4742,4742,4742; //Vitality3 Vitality3 Vitality3
	else if (.@i <= 3193) setarray .@enchants[1],4761,4722,4722; //Matk2 Dexterity3 Dexterity3
	else if (.@i <= 3195) setarray .@enchants[1],4767,4702,4702; //Atk3 Strength3 Strength3
	else if (.@i <= 3197) setarray .@enchants[1],4763,4732,4732; //Evasion12 Agility3 Agility3
	else if (.@i <= 4568) return 0;

	getitem2 getarg(0),1,1,0,0,0,.@enchants[1],.@enchants[2],.@enchants[3];
	return 1;
}
mora,105,176,4	script	Master Tailor#pa0829	509,{
	disable_items;
	if (checkweight(1201,1) == 0) {
		mes "你携带的物品种类太多，无法进行操作。丢弃一些后再试。";
		close;
	}
	if (MaxWeight - Weight < 1000) {
		mes "你的负重太高，无法进行操作。减轻负重后再试。";
		close;
	}
	if (countitem(6380) < 5 || countitem(15024) < 1) {
		mes "[裁缝大师]";
		mes "经我的手，普通军用垫肩也能变成艺术品。我是裁缝大师凯，用军用垫肩创造艺术。";
		next;
		mes "[裁缝大师]";
		mes "名字不重要。我可以把你的军用垫肩变成艺术品，只要带来^ff000005 枚莫拉硬币和一个军用垫肩^000000。";
		if (countitem(6380)) {
			next;
			mes "[裁缝大师]";
			mes "我手头正好有几个军用垫肩。要买一个吗？价格是 1 枚莫拉硬币，很便宜。";
			next;
			switch(select("下次再说。:现在就买一个。")) {
	 		case 1:
				mes "[裁缝大师]";
				mes "好，我明白了。";
				mes "改变主意后再回来买。";
				close;
			case 2:
				delitem 6380,1; //Mora_Coin
				getitem 15024,1; //Army_Padding
				mes "[裁缝大师]";
				mes "给你。";
				mes "非常漂亮又蓬松。欢迎下次再来。";
				close;
			}
		}
		close;
	}
	mes "[裁缝大师]";
	mes "你是来给军用垫肩添加艺术效果的吗？";
	next;
	switch(select("请详细说明。:是的，我有。")) {
	case 1:
		mes "[裁缝大师]";
		mes "普通军用垫肩不够温暖，摸起来粗糙，外观也不好看。至于艺术价值？几乎没有。";
		next;
		mes "[裁缝大师]";
		mes "不过我会用天鹅绒线刺绣，并为它添加三种选项。";
		next;
		mes "[裁缝大师]";
		mes "带来^8888005 枚莫拉硬币^000000和一个军用垫肩，我们就能一起添加艺术效果！";
		close;
	case 2:
		mes "[裁缝大师]";
		mes "先告诉你一声——无论军用垫肩是全新的还是修补过，我都会按需要处理。";
		next;
		mes "[裁缝大师]";
		mes "所以如果你带着喜欢的修补垫肩，请把它放在安全的地方再回来。";
		next;
		mes "[裁缝大师]";
		mes "还有一点——如果添加艺术效果失败，它会变得无法使用……那时你需要买一个新的。";
		next;
		switch(select("别急，怎么了？:好！开始吧！！")) {
		case 1:
			mes "[裁缝大师]";
			mes "你怎么了？";
			mes "村民们已经让我够忙了。";
			close;
		case 2:
			if (countitem(6380) < 5 || countitem(15024) == 0) {
				mes "[裁缝大师]";
				mes "看来你没有带齐所需物品。";
				next;
				mes "[裁缝大师]";
				mes "你必须带 5 枚莫拉硬币和一个军用垫肩，我才能工作。";
				close;
			}
			if (callfunc("F_Mora_Enchant",15024) == 0) {
				mes "[裁缝大师]";
				mes "哦……";
				mes "真不敢相信我搞砸了。";
				next;
				mes "[裁缝大师]";
				mes "我想一个人待着。走开！";
				close;
			}
			mes "[裁缝大师]";
			mes "我的艺术品看起来很棒。";
			close;
		}
	}
}

mora,123,177,6	script	Pendant Crafter#pa0829	509,{
	disable_items;
	if (checkweight(1201,1) == 0) {
		mes "你携带的物品种类太多，无法进行操作。丢弃一些后再试。";
		close;
	}
	if (MaxWeight - Weight < 1000) {
		mes "你的负重太高，无法进行操作。减轻负重后再试。";
		close;
	}
	if (countitem(6380) < 5 || countitem(2858) == 0) {
		mes "[吊坠工匠]";
		mes "我的工作是打磨守护者吊坠中的宝石，再刻上拥有特殊力量的符号。";
		next;
		mes "[吊坠工匠]";
		mes "这个过程会让守护者吊坠比普通饰品拥有更强的力量。";
		next;
		mes "[吊坠工匠]";
		mes "如果你感兴趣，我可以用^ff000005 枚莫拉硬币^000000加工你的吊坠。当然你必须有守护者吊坠。";
		close;
	}
	mes "[吊坠工匠]";
	mes "你是来升级守护者吊坠的吗？";
	next;
	switch(select("请详细说明。:是的，我有。")) {
	case 1:
		mes "[吊坠工匠]";
		mes "我的工作是打磨守护者吊坠中的宝石，再刻上拥有特殊力量的符号。";
		next;
		mes "[吊坠工匠]";
		mes "这个过程会让守护者吊坠比普通饰品拥有更强的力量。";
		next;
		mes "[吊坠工匠]";
		mes "如果你感兴趣，我可以用^ff000005 枚莫拉硬币^000000加工你的吊坠。当然你必须有守护者吊坠。";
		close;
	case 2:
		mes "[吊坠工匠]";
		mes "先告诉你一声——";
		mes "如果加工已经升级过的守护者吊坠，它会失去原有力量。";
		next;
		mes "[吊坠工匠]";
		mes "更糟的是，它可能失去力量变成普通吊坠。当然，石头不像布料那么容易损坏，所以吊坠本身不会丢失。";
		next;
		switch(select("别急，怎么了？:好！开始吧！！")) {
		case 1:
			mes "[吊坠工匠]";
			mes "不着急时再回来。我总有很多时间。";
			close;
		case 2:
			if (countitem(6380) < 5 || countitem(2858) == 0) {
				mes "[吊坠工匠]";
				mes "看来你没有带齐所需物品。";
				next;
				mes "[吊坠工匠]";
				mes "你必须带 5 枚莫拉硬币和一个守护者吊坠，我才能工作。";
				close;
			}
			if (callfunc("F_Mora_Enchant",2858) == 0) {
				getitem 2858,1; //Pendant_Of_Guardian
				mes "[吊坠工匠]";
				mes "什么~！！";
				mes "到底哪里出问题了！！";
				close;
			}
			mes "[吊坠工匠]";
			mes "看来我成功了！";
			close;
		}
	}
}

mora,134,166,4	script	Bulberry Westhood#pa0829	509,{
	disable_items;
	if (checkweight(1201,1) == 0) {
		mes "你携带的物品种类太多，无法进行操作。丢弃一些后再试。";
		close;
	}
	if (MaxWeight - Weight < 1000) {
		mes "你的负重太高，无法进行操作。减轻负重后再试。";
		close;
	}
	if (countitem(6380) < 5 || countitem(2568) == 0) {
		mes "[布尔贝里·韦斯特胡德]";
		mes "我是布尔贝里·韦斯特胡德，守护优质兜帽的传统。";
		next;
		mes "[布尔贝里·韦斯特胡德]";
		mes "我只处理优质物品——不是市场上随处可见的围巾。";
		next;
		mes "[布尔贝里·韦斯特胡德]";
		mes "如果你有自认为品质足够高的物品，带着^ff000005 枚莫拉硬币^000000来找我。";
		next;
		mes "[布尔贝里·韦斯特胡德]";
		mes "我可以亲手进一步提升它的品质。";
		close;
	}
	mes "[布尔贝里·韦斯特胡德]";
	mes "你有一条洛基围巾 1042 特别版。你真有眼光。可以让我马上加工吗？";
	next;
	switch(select("我不明白。:好的，请开始。")) {
	case 1:
		mes "[布尔贝里·韦斯特胡德]";
		mes "我说过，我只处理优质物品——不是市场上随处可见的围巾。";
		next;
		mes "[布尔贝里·韦斯特胡德]";
		mes "你这条洛基围巾很棒。它是带有洛基纹章的限量版产品！";
		next;
		mes "[布尔贝里·韦斯特胡德]";
		mes "我的专长是用很小的代价唤醒隐藏力量……";
		mes "5 枚莫拉硬币。";
		next;
		mes "[布尔贝里·韦斯特胡德]";
		mes "改变主意后再回来。";
		close;
	case 2:
		mes "[布尔贝里·韦斯特胡德]";
		mes "先告诉你一声——";
		mes "如果加工已经升级过的洛基围巾，它会失去原有力量。";
		next;
		mes "[布尔贝里·韦斯特胡德]";
		mes "更糟的是，它可能失去全部力量，变成普通围巾。";
		next;
		mes "[布尔贝里·韦斯特胡德]";
		mes "当然，洛基围巾是优质物品，所以过程中不会失去围巾本身。";
		next;
		switch(select("先生，下次再说……:我想拥有优质物品！")) {
		case 1:
			mes "[布尔贝里·韦斯特胡德]";
			mes "哈……！";
			mes "明明马上就能拥有最优质的物品，却说‘下次’？随你吧。";
			close;
		case 2:
			if (countitem(6380) < 5 || countitem(2568) == 0) {
				mes "[布尔贝里·韦斯特胡德]";
				mes "看来你没有带齐所需物品。";
				next;
				mes "[布尔贝里·韦斯特胡德]";
				mes "你必须带 5 枚莫拉硬币和一条洛基围巾，才能获得最优质的物品。";
				close;
			}
			if (callfunc("F_Mora_Enchant",2568) == 0) {
				getitem 2568,1; //Muffler_Of_Roki
				mes "[布尔贝里·韦斯特胡德]";
				mes "啊啊啊，这不可能！";
				mes "我的！我的洛基围巾！……";
				next;
				mes "[布尔贝里·韦斯特胡德]";
				mes "哦，请原谅我失态的行为。我太难过了。";
				next;
				mes "[布尔贝里·韦斯特胡德]";
				mes "幸运的是，它仍保持加工前的原状，没有撕裂或拉伸。毕竟是优质物品。哦呵呵~";
				close;
			}
			mes "[布尔贝里·韦斯特胡德]";
			mes "哇~任务完成！";
			close;
		}
	}
}

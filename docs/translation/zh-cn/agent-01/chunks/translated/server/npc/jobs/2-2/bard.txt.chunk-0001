//= [Official Conversion]
//= Job quest for Bard class
//===== Additional Comments: =================================
//= 2.1b Updated to the Official One. [Samuray22]
//= 2.2 Fixed BUG when baby classes weren't able to get a job,
//=	- fixed bug with final prize [Lupus] HAVE TO CHANE ALL ITEMS to numeric IDs
//= 2.3 Updated NPC dialogs and cutins using Aegis 10.3 files. [L0ne_W0lf]
//=	- Fixed error with the present checking. (Lupus beat me to committing)
//=	- Changed the reward checking to use callsub (fixed the flow of the script)
//=	- Optimized and changed the flow of things slightly.
//=	- Temporary character variables "@" are now ".@"
//=	- Fixed some indentation.
//=	- Changed item names to item IDs
//= 2.4 Fixed hang up on bard quest. ($kiN.) [L0ne_W0lf]
//= 2.5 Added Quest Log commands. [Kisuka]
//= 2.6 Removed the need for use of 'goto.' [L0ne_W0lf]
//============================================================

// Ayealo
//============================================================
comodo,226,123,5	script	Wandering Bard	741,{
	if(Upper == 1) {
		mes "[拉洛]";
		mes "注定成为神明的被选中者";
		mes "在这个时代有很多，";
		mes "但他们活着时从未意识到自己的命运。";
		mes "最终只成为普通人……";
		next;
		mes "[拉洛]";
		mes "风与云，请将这段话传给他们，";
		mes "那些追逐衣食住行与财富的人。";
		mes "告诉他们正在浪费时间……";
		mes "告诉他们忘记了人生最重要的目标……";
		close2;
		cutin "job_bard_aiolo01",255;
		end;
	}
	else if(BaseJob != Job_Archer) {
		if(BaseJob == Job_Bard) {
			mes "[拉洛]";
			mes "哦嘿！最近唱歌怎么样？";
			mes "不知道你的嗓音有没有变好。";
			next;
			mes "[拉洛]";
			mes "你没忘记在每个城镇传播好消息吧？";
			mes "也别忘了学习新歌……";
			next;
			mes "[拉洛]";
			mes "永远保持积极态度，记住欢乐的意义。";
			mes "我们的歌曲应该给每个人带来幸福与快乐。";
		}
		else if(Class == Job_Novice) {
			cutin "job_bard_aiolo01",2;
			mes "[拉洛]";
			mes "笼罩我心的悲伤……";
			mes "无法停留……";
			mes "这就是我烦恼的原因吗，";
			mes "这就是我软弱的原因吗，";
			mes "一定是因为我无法忘记你……";
			next;
			mes "[拉洛]";
			mes "哦，抱歉。我专心写歌词所以没看到你。";
			mes "想听我的歌吗？要我为你唱一首吗？";
			next;
			mes "[拉洛]";
			mes "嘿……去问别人吧。";
			mes "我正在创作新歌。";
		}
		else {
			cutin "job_bard_aiolo01",2;
			mes "[拉洛]";
			mes "啦啦啦，啦啦啦。美丽的海洞。";
			mes "总是充满快乐时光~";
			next;
			mes "[拉洛]";
			if (Sex == SEX_MALE) {
				mes "忘掉烦恼~";
				mes "享受一切~";
			}
			else mes "可爱的女士，要跳舞吗~";
			mes "青春不会重来~";
		}
		close2;
		cutin "job_bard_aiolo01",255;
		end;
	}
	else if(BARD_Q == 0) {
		cutin "job_bard_aiolo01",2;
		mes "[拉洛]";
		if (Sex == SEX_MALE) mes "你好！愉快的弓箭手。";
		else mes "你好！美丽的弓箭手小姐。";
		mes "像我这样的流浪者能帮你什么？";
		next;
		switch(select("你的声音很好听。:能为我唱首歌吗？:没什么。")) {
		case 1:
			mes "[拉洛]";
			mes "哈哈哈！当然！";
			mes "只要用快乐的心歌唱，嗓音总会变好。";
			next;
			mes "[拉洛]";
			mes "但对诗人来说，嗓音就是生命。";
			mes "有时嗓音会离你而去，所以要小心。";
			break;

		case 2:
			mes "[拉洛]";
			mes "一首歌……让我想想。";
			mes "好，我想到一首……";
			next;
			mes "[拉洛]";
			mes "我要唱《战争之鼓》。";
			mes "*呃……*咳……呕……啦啦啦……";
			mes "1, 2, 3, 4...";
			next;
			mes "^000088骏马越过地平线的声音";
			mes "遮蔽远方太阳的尘土";
			mes "当千万双眼睛在夜空睁开";
			mes "城堡之火将熊熊燃烧。^000000";
			next;
			mes "^000088我能听见……心脏的跳动。";
			mes "我能感受……血液在血管中奔涌。";
			mes "……以及盔甲的重量。";
			mes "我能看见……我的敌人。^000000";
			next;
			mes "^000088更响，更响，更响……";
			mes "赋予勇士力量！";
			mes "更高，更高，更高……";
			mes "这一天不会重来！^000000";
			next;
			mes "^000088震撼天空，咆哮大地。";
			mes "让我的心再次狂跳！";
			mes "让号角吹响，让城墙回荡。";
			mes "这一刻不会重来！^000000";
			next;
			mes "[拉洛]";
			mes "嗯……这首歌总是很适合演唱。";
			mes "怎么样？你不觉得这首歌很好听吗？";
			next;
			if (select("是的，非常好听。:不，不太好……") == 1) {
				mes "[拉洛]";
				mes "谢谢！你喜欢我的歌，我也很开心。";
				next;
				if (Sex == SEX_MALE && JobLevel > 39) {
					mes "[拉洛]";
					mes "如果更多人四处歌唱就好了……";
					mes "不过现在这样也不错……嗯哼。";
					set BARD_Q,1;
					setquest 3000;
					close2;
					cutin "job_bard_aiolo01",255;
					end;
				}
				mes "[拉洛]";
				mes "如果还想听我的歌，随时问我。";
				close2;
				cutin "job_bard_aiolo01",255;
				end;
			}
			cutin "job_bard_aiolo02",2;
			mes "[拉洛]";
			mes "嗯……我是不是失去感觉了，得更努力。";
			mes "总之……谢谢你聆听。";
			break;

		case 3:
			cutin "job_bard_aiolo02",2;
			mes "[拉洛]";
			mes "喂，遇到诗人却不点歌可不礼貌。";
			mes "不过……看你很着急，也没办法。";
			next;
			mes "[拉洛]";
			mes "狩猎很好……但别忘了偶尔放松。";
			mes "青春短暂，逝去后不会重来……";
			break;
		}
		close2;
		cutin "job_bard_aiolo02",255;
		end;
	}
	else if(BARD_Q == 1) {
		cutin "job_bard_aiolo01",2;
		mes "[Lalo]";
		mes "嘿，弓箭手朋友。";
		mes "像我这样的流浪者能帮你什么？";
		next;
		switch(select("You have a nice voice.:Could you sing for me, please?:Nothing.")) {
		case 1:
			mes "[Lalo]";
			mes "呵呵，你的声音也很好听？";
			mes "想过唱歌吗？";
			next;
			if (select("Of course!:I can't quite possibly...") == 1) {
				mes "[Lalo]";
				mes "哈哈，态度不错。成为诗人就该这样。";
				mes "那我来帮你成为诗人。";
				next;
				mes "[Lalo]";
				mes "不过在那之前……你能带给我一朵花吗？";
				mes "闻到花香我才有教人的感觉。";
				next;
				mes "[Lalo]";
				mes "哪种花都可以，但尽量带我喜欢的。";
				mes "别随便买一朵就算，明白吗？";
				set BARD_Q,2;
				changequest 3000,3001;
				close2;
				cutin "job_bard_aiolo01",255;
				end;
			}
			mes "[Lalo]";
			mes "哈哈，真胆小。";
			mes "别妄自菲薄。";
			next;
			mes "[Lalo]";
			mes "你很有天赋。";
			mes "改变主意后再来。";
			break;

		case 2:
			mes "[Lalo]";
			mes "嗯……看来你有些歌唱天赋？";
			mes "别只点歌……给别人唱歌也很有趣。";
			next;
			mes "[Lalo]";
			mes "试着享受诗人的生活。";
			mes "从一个城镇到另一个城镇，为人们歌唱。听起来很棒吧？";
			break;

		case 3:
			mes "[Lalo]";
			mes "嗯……我不太明白，但享受生活吧。";
			mes "你看起来太紧绷了。";
			next;
			mes "[Lalo]";
			mes "那么~玩得开心~";
			break;
		}
		close2;
		cutin "job_bard_aiolo01",255;
		end;
	}
	else if(BARD_Q == 2) {
		cutin "job_bard_aiolo01",2;
		mes "[Lalo]";
		mes "欢迎！弓箭手朋友。";
		mes "你带花了吗？让我看看。";
		next;
		mes "[Lalo]";
		//Good Flowers
		if (countitem(629) > 0) {
			mes "哦！是歌唱之花！";
			mes "它充满我的回忆……";
			next;
			delitem 629,1; //Singing Flower
			mes "[Lalo]";
			mes "我的朋友柴可夫斯基以前喜欢它。";
			mes "不知道他现在在做什么……";
		}
		else if(countitem(703) > 0) {
			mes "啊……可爱的希奈尔……";
			mes "它没有香味，但确实是朵可爱温和的花。";
			next;
			delitem 703,1; //Hinalle
			mes "[Lalo]";
			mes "我跌倒时，叶子曾给我力量。";
			mes "我很喜欢这朵花，谢谢你。";
		}
		else if(countitem(704) > 0) {
			mes "芦荟……这是稀有的花。";
			mes "你怎么得到的？挺有本事嘛？";
			next;
			delitem 704,1; //Aloe
			mes "[Lalo]";
			mes "叶子很好，芦荟也很美味……";
			mes "但它作为花时最美。";
		}
		else if(countitem(708) > 0) {
			mes "薄荷……有了它就能忘记所有辛劳。";
			mes "这么久后再次见到它真好！";
			next;
			delitem 708,1; //Ment
			mes "[Lalo]";
			mes "听说它可以制作安眠药……";
			mes "不过那样有点浪费……谢谢！";
		}
		else if(countitem(709) > 0) {
			mes "哦，这不是伊西多吗？";
			mes "这是危险却美丽的花……";
			next;
			delitem 709,1; //Izidor
			mes "[Lalo]";
			mes "深紫色很迷人……";
			mes "谢谢，我很喜欢这朵花。";
		}
		else if(countitem(748) > 0) {
			mes "哦，不凋谢的玫瑰，不会枯萎的坚强花朵。";
			mes "送给女朋友很不错。";
			next;
			delitem 748,1; //Witherless_Rose
			mes "[Lalo]";
			mes "像我这样的流浪者收下它没问题吗？";
			mes "哈哈，应该没问题……对吧？";
		}
		else if(countitem(749) > 0 ) {
			mes "冰冻玫瑰……其实不能称为花，";
			mes "但它仍然很美……透明的玫瑰。";
			next;
			delitem 749,1; //Frozen_Rose
			mes "[Lalo]";
			mes "虽然没有香味，仍可以称为花。";
			mes "那我就收下了。";
		}
		else if(countitem(710) > 0) {
			mes "哦，这不是幻觉之花吗？！";
			mes "哇，你怎么得到这么稀有的花！！";
			next;
			delitem 710,1; //Illusion_Flower
			mes "[Lalo]";
			mes "非常感谢，啊……我感觉天堂就在眼前。";
			mes "多么美妙的感觉！我真的很开心！";
		}
		//Bad Flowers
		else if(countitem(712) > 0) {
			cutin "job_bard_aiolo02",2;
			mes "咦？这只是普通的花。";
			mes "我喜欢……但还不够。";
			next;
			mes "[Lalo]";
			mes "你可以从普隆德拉的女孩那里得到这朵花。";
			mes "请带给我另一种花。";
			close2;
			cutin "job_bard_aiolo02",255;
			end;
		}
		else if(countitem(744) > 0) {
			mes "哦不，你带了花束？";
			mes "你不能带这种东西给我。";
			next;
			mes "[Lalo]";
			mes "把它送给毕业的贤者吧。";
			mes "它很适合作为那种礼物……带另一种花来。";
			close2;
			cutin "job_bard_aiolo01",255;
			end;
		}
		else if(countitem(745) > 0) {
			cutin "job_bard_aiolo02",2;
			mes "喂喂……你去参加婚礼了吗？";
			mes "你想让男人拿婚礼花束做什么？";
			next;
			mes "[Lalo]";
			mes "这不适合我。送给女士吧。";
			mes "这不是我想要的花。";
			close2;
			cutin "job_bard_aiolo02",255;
			end;
		}
		else if(countitem(2207) > 0) {
			mes "嗯……华丽之花。";
			mes "它很漂亮……但还不够。";
			next;
			mes "[Lalo]";
			mes "我喜欢有香味又漂亮的花。";
			mes "我不喜欢戴在头上的假花。";
			close2;
			cutin "job_bard_aiolo01",255;
			end;
		}
		else if(countitem(1032) > 0) {
			cutin "job_bard_aiolo02",2;
			mes "……啊，你为什么带来这么难看的东西？";
			mes "你到底有没有在想？";
			next;
			mes "[Lalo]";
			mes "如果你想逗我笑，做得不错……";
			mes "但现在带一朵普通的花来。";
			close2;
			cutin "job_bard_aiolo02",255;
			end;
		}
		else {
			cutin "job_bard_aiolo02",2;
			mes "嗯？什么……你什么都没带。";
			mes "我不是让你带花吗？";
			next;
			mes "[Lalo]";
			mes "好吧……如果你想自己学习，随你。";
			mes "谁都可以出去唱歌。";
			close2;
			cutin "job_bard_aiolo02",255;
			end;
		}
		next;
		cutin "job_bard_aiolo01",2;
		mes "[Lalo]";
		mes "如我所承诺，我会帮你成为诗人。";
		mes "但这并不容易，朋友。哈哈！";
		next;
		mes "[Lalo]";
		mes "学习歌唱需要认识许多人。";
		mes "你还要了解不同村庄发生的事情……";
		next;
		mes "[Lalo]";
		mes "在鲁提耶有个会说话的雪人。";
		mes "去那里带回一份礼物。";
		next;
		set BARD_Q,3;
		changequest 3001,3002;
		set xmas_npc,1;
		mes "[Lalo]";
		mes "如果你和 ^008800杰克·弗罗斯特^000000 成为朋友，就能得到东西。";
		mes "也要和镇民交谈……";
		close2;
		cutin "job_bard_aiolo01",255;
		end;
	}
	else if ((BARD_Q >= 3) || (BARD_Q <= 5)) {
		if (BARD_Q == 3) {
			if(xmas_npc > 10) { //this var is set in LUTIE.TXT
				cutin "job_bard_aiolo01",2;
				mes "[Lalo]";
				mes "旅途怎么样？你认识了很多人吗？";
				mes "你应该学到比礼物更重要的东西。";
				next;
				mes "[Lalo]";
				mes "那么，想试着唱歌吗……？";
				mes "我唱一段短旋律……";
				mes "然后你跟着唱。";
				if(checkquest(3003) == -1) {
					changequest 3002,3003;
				}
				next;
				mes "[Lalo]";
				mes "我开始了。";
				mes "呃嗯*清嗓子*";
				mes "1, 2, 3, 4";
				next;
			}
			else {
				cutin "job_bard_aiolo01",2;
				set xmas_npc,1;
				mes "[Lalo]";
				mes "咦，你还没和他成为朋友？";
				mes "只交谈是不够的。";
				next;
				mes "[Lalo]";
				mes "如果你和 ^008800杰克·弗罗斯特^000000 成为朋友，就能得到东西。";
				mes "也要和村民交谈……";
				close2;
				cutin "job_bard_aiolo01",255;
				end;
			}
		}
		else if (BARD_Q == 4) {
			cutin "job_bard_aiolo01",2;
			mes "[Lalo]";
			mes "嗯……这次你能做得更好，对吧？";
			mes "再试一次，你能做到。";
			next;
			mes "[Lalo]";
			mes "我唱一段……";
			mes "然后你跟着唱。";
			next;
			mes "[Lalo]";
			mes "开始吧。";
			mes "*Ehem*";
			mes "1, 2, 3, 4";
			next;
		}
		if (BARD_Q != 5) {
			set .@bard_s, rand(1,5);
			if (.@bard_s == 1) {
				mes "^3377FF曾有一个人^000000";
				mes "据说是不朽的。";
				mes "他的名字是吉弗里德，";
				mes "英雄吉赫蒙特之子。";
				mes "邪恶巨人帕普纳，";
				mes "变成龙并吃掉了他。";
				next;
				input .@Song$;
				if (.@Song$ != "There was a man") 
					set .@w_point,.@w_point+1;

				mes "^3377FF曾有一个人";
				mes "据说是不朽的。^000000";
				mes "他的名字是吉弗里德，";
				mes "英雄吉赫蒙特之子。";
				mes "邪恶巨人帕普纳，";
				mes "变成龙并吃掉了他。";
				next;
				input .@Song$;

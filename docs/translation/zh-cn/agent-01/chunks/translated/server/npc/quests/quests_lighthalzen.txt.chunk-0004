		mes "^333333嘿嘿嘿嘿……^000000";
		close;
	case 3:
	case 4:
		mes "^3355FF*SHHHHHHUK!*^000000";
		specialeffect EF_STEAL;
		if (Zeny >= 200) {
			set Zeny, Zeny-200;
		}
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "嗯……？";
		mes "我敢肯定";
		mes "这些装满 Zeny 的口袋";
		mes "刚才";
		mes "还要更沉一些……";
		next;
		mes "[?????]";
		mes "^333333嘿嘿嘿嘿……^000000";
		close;
	case 5:
		mes "^3355FF*SHHHHHHUK!*^000000";
		specialeffect EF_STEAL;
		if (Zeny >= 10) {
			set Zeny, Zeny-10;
		}
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "嗯……？";
		mes "什么？！";
		mes "那家伙刚才是不是……？";
		mes "他就是！喂！那家伙";
		mes "偷走了我的钱！";
		next;
		mes "[可疑男子]";
		mes "糟糕！";
		mes "得溜了！";
		mes "有本事就来追我啊，好人——！";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "休想逃！";
		mes "我要把你交给卫兵，";
		mes "你这个扒手！";
		next;
		mes "[可疑男子]";
		mes "不……！对不起！";
		mes "我把钱还给你，";
		mes "现在就放我走吧！";
		mes "糟了！";
		emotion ET_CRY;
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "好吧，算了，";
		mes "但你最好别再过";
		mes "这种犯罪生活了！";
		next;
		mes "[可疑男子]";
		mes "你说得对，那样做";
		mes "确实";
		mes "是我的错。谢谢";
		mes "你放我一马。既然你帮了我，";
		mes "我就卖给你一些我用来";
		mes "快速奔跑的药剂。";
		next;
		mes "[可疑男子]";
		mes "我最多只能卖给你";
		mes "最多";
		mes "三瓶秘密药剂，";
		mes "因为我手里就这么多。";
		mes "每瓶要 15,000 Zeny。";
		mes "怎么样？";
		next;
		switch(select("给我 1 瓶。:给我 2 瓶。:给我 3 瓶。:不用了。")) {
		case 1: set .@number,1; set .@price,15000*1; break;
		case 2: set .@number,2; set .@price,15000*2; break;
		case 3: set .@number,3; set .@price,15000*3; break;
		case 4:
			mes "[可疑男子]";
			mes "嗯……";
			mes "你就这样";
			mes "放我走了？";
			mes "你可真慷慨。";
			mes "谢谢，我很感激。";
			next;
			mes "[可疑男子]";
			mes "总之，我要";
			mes "回去工作了。";
			mes "嘿嘿嘿~";
		}
		if (.@number) {
			if (Zeny < .@price) {
				mes "[可疑男子]";
				mes "呃，既然我要改掉";
				mes "扒窃的毛病，";
				mes "就得作为商人";
				mes "合法赚钱。我很抱歉，朋友，";
				mes "但我不能把这些药剂";
				mes "白送给你！";
				next;
				mes "[可疑男子]";
				mes "总之，我要";
				mes "回去工作了。";
				mes "嘿嘿嘿~";
			}
			else {
				if ((MaxWeight-Weight) < 400) {
					mes "[可疑男子]";
					mes "呃，抱歉，你的物品栏";
					mes "没有足够空间";
					mes "放在物品栏里，";
					mes "装下这些药剂。抱歉，";
					mes "朋友，这笔交易取消了。";
					next;
					mes "[可疑男子]";
					mes "总之，我要";
					mes "回去工作了。";
					mes "嘿嘿嘿~";
				}
				else {
					mes "[可疑男子]";
					if (.@number == 1) {
						mes "只要一瓶？好吧，你";
						mes "可能还真小气，";
						mes "但我确实欠你人情。拿着，";
						mes "希望我们再也不要";
						mes "碰面了！";
					}
					else if (.@number == 2) {
						mes "两瓶啊？没问题。";
						mes "拿好，希望我们";
						mes "永远都别再";
						mes "见面了！拜拜，宝贝~";
					}
					else {

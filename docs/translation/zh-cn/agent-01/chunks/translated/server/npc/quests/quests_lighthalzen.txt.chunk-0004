			mes "^3355FF前方有一个狭窄的";
			mes "矩形卡槽，";
			mes "就在管子前面。^000000";
			next;
			input .@input$;
			if (.@input$ == "Laboratory Permit") {
				if (countitem(2657)) {
					mes "^3355FF你将";
					mes "实验室通行证";
					mes "插入卡槽，地面上";
					mes "的裂缝裂开，";
					mes "人工造成的裂缝";
					mes "露出了一段地下楼梯。^000000";
					next;
					if (select( "下楼", "取消" ) == 1) {
						mes "^3355FF你沿着";
						mes "蜿蜒的长长楼梯";
						mes "走了下去……^000000";
						close2;
						//remove variables that are no longer used.
						lhz_sincube = 0;
						lhz_secret01 = 0;
						lhz_secret02 = 0;
						lhz_secret03 = 0;
						MISC_QUEST = MISC_QUEST | 512;
						warp "lhz_cube",177,13;
						end;
					}
					close;
				}
				mes "^3355FF………………";
				mes "什么也没发生。^000000";
				close;
			}
			mes "^3355FF什么也没发生。^000000";
			close;
		}
		mes "^3355FF你就是在这里";
		mes "获得了^000000椭圆体^3355FF。";
		mes "你环顾管子所在的位置，";
		mes "注意到地面上有一道";
		mes "人工形成的";
		mes "裂缝，";
		mes "似乎可以打开……^000000";
		close;
	}
}

lhz_cube,248,193,0	script	Box#cube1	HIDDEN_NPC,{
	if (lhz_secret01 < 9 && lhz_secret02 < 4 && lhz_secret03 < 3) {
		mes "^3355FF你发现一个盒子，";
		mes "上面有三个形状各异的";
		mes "孔。^000000";
		next;
		select("椭圆孔:立方孔:多边形孔");
		input .@input$;
		mes "^3355FF什么也没发生。^000000";
		close;
	}
	if (lhz_secret01 != 10 || lhz_secret02 != 5 || lhz_secret03 != 4) {
		mes "^3355FF你发现一个盒子，";
		mes "上面有三个形状各异的";
		mes "孔。^000000";
		next;
		switch( select( "椭圆孔", "立方孔", "多边形孔" ) ) {
		case 1:
			if (lhz_secret01 == 9) {
				input .@input$;
				if (.@input$ == "Oval") {
					mes "^3355FF你将椭圆体插入";
					mes "椭圆形的孔中，";
					mes "严丝合缝。^000000";
					lhz_secret01 = 10;
					close;
				}
				mes "^3355FF什么也没发生。^000000";
				close;
			}
			if (lhz_secret01 == 10) {
				mes "^3355FF椭圆形的孔里";
				mes "已经有一个椭圆体了。";
				mes "而且你也没有多余的";
				mes "椭圆体可以使用。^000000";
				close;
			}
			input .@input$;
			mes "^3355FF什么也没发生。^000000";
			close;
		case 2:
			if (lhz_secret02 == 4) {
				input .@input$;
				if (.@input$ == "Cube") {
					mes "^3355FF你将立方体插入";
					mes "立方孔中，";
					mes "它咔哒一声卡到位。";
					mes "你在幼儿园学到的";
					mes "知识终于派上用场了。^000000";
					lhz_secret02 = 5;
					close;
				}
				mes "^3355FF什么也没发生。^000000";
				close;
			}
			if (lhz_secret02 == 5) {
				mes "^3355FF你已经把立方体";
				mes "放进孔里了。";
				mes "你可以把它拿出来";
				mes "再放回去，";
				mes "但那只是在";
				mes "浪费时间。^000000";
				close;
			}
			input .@input$;
			mes "^3355FF什么也没发生。^000000";
			close;
		case 3:
			if (lhz_secret03 == 3) {
				input .@input$;
				if (.@input$ == "Polygon") {
					mes "^3355FF幸运的是，你手中的";
					mes "不起眼的多边形";
					mes "恰好与这个不起眼的";
					mes "多边形孔形状相同。";
					mes "多边形严丝合缝，";
					mes "几乎就像命中注定，";
					mes "仿佛命运安排好了一样。^000000";
					lhz_secret03 = 4;
					close;
				}
				mes "^3355FF什么也没发生。^000000";
				close;
			}
			if (lhz_secret03 == 4) {
				mes "^3355FF多边形已经";
				mes "插入孔中了。";
				mes "相信这就是这个多边形";
				mes "能为你做的一切。^000000";
				close;
			}
			input .@input$;
			mes "^3355FF什么也没发生。^000000";
			close;
		}
	}
	if (lhz_secret01 == 10 && lhz_secret02 == 5 && lhz_secret03 == 4 && lhz_sincube != 10) {
		mes "^3355FF你发现盒子上三个";
		mes "形状各异的孔";
		mes "如今都已经被你插入的";
		mes "物体";
		mes "填满了。^000000";
		next;
		if (select( "打开盒子。", "取消" ) == 1) {
			mes "^3355FF你打开盒子，";
			mes "发现里面有一张";
			mes "标有“实验室通行证”的";
			mes "小卡片。";
			mes "你把这张^000000实验室";
			mes "通行证^3355FF收好，";
			mes "知道之后还会用到它。";
			lhz_sincube = 10;
			getitem 2657,1;// Lab_Passport
		}
		close;
	}
	mes "^3355FF你发现一个打开的盒子，";
	mes "里面曾经装着";
	mes "^000000实验室通行证^3355FF。";
	mes "这个盒子现在对你";
	mes "已经没有用了，";
	mes "但它曾经隐藏的谜题";
	mes "也让你费了一番功夫。^000000";
	close;
}

lhz_cube,250,184,0	script	Door#cube	HIDDEN_NPC,{
	mes "^3355FF你来到一扇";
	mes "通往外面的门前。^000000";
	next;
	if (select( "离开", "取消" ) == 1) {
		warp "lighthalzen",310,302;
		end;
	}
	close;
}

lhz_dun02,224,6,0	script	Exit1#lt	WARPNPC,1,1,{
	end;
OnTouch_:
	if (MISC_QUEST&512) {
		warp "lhz_cube",231,90;
		end;
	}
	mes "^3355FF你发现一条通道，";
	mes "似乎通往某个地方，";
	mes "但你感觉现在";
	mes "还不该进入那里。^000000";
	close;
}


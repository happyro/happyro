//============================================================
lighthalzen,240,216,4	script	Suspicious Guy#lhz_01	4_M_LGTPOOR,2,2,{
	end;

OnTouch_:
	switch(rand(1,3)) {
	case 1:
		mes "^3355FF*SHHHHHHUK!*^000000";
		specialeffect EF_STEAL;
		if (Zeny >= 100) {
			set Zeny, Zeny-100;
		}
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "嗯……？";
		mes "我感觉到什么……";
		mes "不，可能只是";
		mes "我的错觉。";
		next;
		mes "[？？？？？]";
		mes "^333333嘿嘿嘿嘿……^000000";
		close;
	case 2:
		mes "^3355FF*SHHHHHHUK!*^000000";
		specialeffect EF_STEAL;
		if (Zeny >= 200) {
			set Zeny, Zeny-200;
		}
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "嗯……？";
		mes "我敢肯定";
		mes "这些装满 Zeny 的口袋";
		mes "刚才";
		mes "还要更沉一些……";
		next;
		mes "[？？？？？]";
		mes "^333333嘿嘿嘿嘿……^000000";
		close;
	case 3:
		mes "^3355FF*SHHHHHHUK!*^000000";
		specialeffect EF_STEAL;
		if (Zeny >= 10) {
			set Zeny, Zeny-10;
		}
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "嗯……？";
		mes "什么？！";
		mes "那家伙刚才是不是……？";
		mes "他就是！喂！那家伙";
		mes "偷走了我的钱！";
		next;
		mes "[可疑男子]";
		mes "糟糕！";
		mes "得溜了！";
		mes "有本事就来追我啊，好人！";
		next;
		if (rand(1,4) == 1) {
			enablenpc "Suspicious Guy#lhz_03";
			disablenpc "Suspicious Guy#lhz_01";
		}
		else {
			enablenpc"Suspicious Guy#lhz_02";
			disablenpc "Suspicious Guy#lhz_01";
		}
		close;
	}
}


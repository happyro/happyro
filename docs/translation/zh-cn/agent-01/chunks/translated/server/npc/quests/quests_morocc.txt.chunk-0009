				mes "在这里等着。";
				next;
				emotion ET_COMEON;
				mes "[洞穴居民]";
				mes "嘿，贾达！";
				enablenpc "Jaeda#garas1";
				next;
				mes "[洞穴居民]";
				mes "上楼去，告诉伊娃她有客人。";
				disablenpc "Jaeda#garas1";
				next;
				mes "^660000令人惊讶的是，他似乎知道伊娃是谁。你仍然不敢相信她真的存在！这一切太奇怪了。^000000";
				next;
				mes "^660000你能感到内心充满兴奋与期待。也许你就快弄清梦境真正的含义了。^000000";
				enablenpc "Jaeda#garas1";
				next;
				mes "[洞穴居民]";
				mes "嗯……这样啊，我明白了。";
				next;
				disablenpc "Jaeda#garas1";
				mes "[洞穴居民]";
				mes "你可以通过了。上楼去，但想搞什么小动作前最好三思。听懂了吗？";
				next;
				mes "^660000那个表情严肃的男人打量了你一番，然后让到一旁，放你通过。";
				mes "你紧张地握紧拳头，开始走上昏暗的楼梯。^000000";
				set barmunt_crow,9;
				close2;
				warp "cave",82,105;
				end;
			}
		}
	}
	else if (barmunt_crow < 8) {
		mes "[洞穴居民]";
		mes "外人不得越过此处。";
		next;
		mes "^660000他的声音和外表一样严厉而吓人。^000000";
		close2;
		warp "cave",81,92;
	}
	end;
}

cave,85,101,3	script	Jaeda#garas1	401,{
OnInit:
	disablenpc "Jaeda#garas1";
	end;
}

ein_fild01,28,261,0	warp	cave_in1	1,1,cave,97,24
cave,97,21,0	warp	case_out1	1,1,ein_fild01,28,255

cave,86,167,0	warp	zid_in	1,1,cave,77,185
cave,79,180,0	warp	zid_out	3,3,cave,90,162

cave,22,186,3	script	Monsterous Man#zid	999,{
	if (barmunt_crow == 9) {
		mes "^660000你看着一个长得像怪物一样丑陋的男人。";
		mes "他就是你在梦里看到的、和伊娃在一起的男人。当然，他现在老了，脸和皮肤都显露出年龄。^000000";
		next;
		mes "(WHIZZ)";
		next;
		mes "["+ strcharinfo(0) +"]";
		mes "啊……";
		next;
		mes "^660000胸口突然传来一阵疼痛……";
		mes "最近一直咳嗽和打喷嚏，你的肺似乎变得虚弱了许多。^000000";
		next;
		mes "^660000你揉着胸口缓解疼痛，惊讶地盯着他。^000000";
		next;
		mes "^660000幸好，他先开口和你说话。^000000";
		next;
		mes "[怪物般的男子]";
		mes "我的外表让你不舒服吗？";
		next;
		mes "[怪物般的男子]";
		mes "所以，你认识伊娃……嗯？";
		next;
		mes "^660000他的声音很虚弱，仿佛没有足够的力气说话。^000000";
		next;
		mes "["+ strcharinfo(0) +"]";
		mes "呃……阿嚏！";
		specialeffect2 EF_VENOMDUST;
		next;
		mes "["+ strcharinfo(0) +"]";
		mes "你认识一个叫奥利弗·希尔珀特的男人吗？";
		next;
		mes "[怪物般的男子]";
		mes "奥利弗？嗯，我想不认识。";
		mes "他和这些事有什么关系？";
		next;
		mes "^660000你把奥利弗的小说《命运之鸦》交给他，解释了发生在你身上的奇怪事件。^000000";
		next;
		mes "....................";
		next;
		mes "....................";
		mes "....................";
		next;
		mes "....................";
		mes "....................";
		mes "....................";
		next;
		mes "^660000他好奇地眯起眼睛，安静地翻了几页书。把书还给你时，他开口了。^000000";
		next;
		mes "[怪物般的男子]";
		mes "我很惊讶，这本书里的故事……和我的人生很相似。非常相似。";
		next;
		while(1) {
			mes "[齐德]";
			mes "我叫齐德。告诉我你想从我这里得到什么。我想进一步了解这本书。";
			next;
			switch(select("关于洞穴村庄:关于他自己:关于伊娃:结束对话")) {
			case 1:
				mes "[齐德]";
				mes "你注意到我们的村民看起来不一样吗？";
				next;
				mes "[齐德]";
				mes "人类的好奇心带来了伟大的成就和贡献，但知识也有可能超出承受范围。";
				mes "村里的每个人都是逃亡者……我们是那些妄图扮演上帝、追寻禁忌知识并玩弄生命之人所造成后果的受害者。";
				next;
				mes "[齐德]";
				mes "我们只能躲在这里，因为他们太强大，我们无法反抗……我们知道这样并不正确。";
				next;
				break;
			case 2:
				mes "[齐德]";
				mes "我曾经是个普通人，但贫穷让我失去了自尊、自信和身份。";
				mes "我厌倦了每天担心食物，于是自愿成为某项实验的试验对象。";
				mes "我不再担心挨饿，但那天起，我作为‘人类’的生活结束了。";
				next;
				mes "[齐德]";
				mes "起初这里只有我和伊娃，后来其他人加入我们，形成了一个小聚落。";
				mes "现在我是村里最年长的人，也承担着保护大家的重任。";
				next;
				break;
			case 3:
				mes "[齐德]";
				mes "我和伊娃接受实验的实验室并不普通。";
				mes "它是为了测试并复制上帝的创造之力而建造的。";
				next;
				mes "[齐德]";
				mes "他们没能达成目标，还引发了一连串不幸事件，";
				mes "因为他们试图操纵连研究都难以进行的材料。";
				mes "他们相信研究能为人类开启全新的世界……";
				next;
				mes "[齐德]";
				mes "伊娃就是他们中的一员……她虽然不善良，但至少同情因贫困而出卖自己的我。";
				next;
				mes "[齐德]";
				mes "她曾有一个深爱她的男人……";
				mes "他叫塞法基斯，一直支持她的研究。";
				next;
				mes "[齐德]";
				mes "伊娃变成和我一样的变异体后，他……绝望地自杀了……她希望他把她当作试验对象。";
				mes "他明明是最热心的研究者，没人料到他会如此轻易地结束生命。";
				next;
				mes "[齐德]";
				mes "后来有人放火烧了实验室。我想你在梦里见过那一幕。大火彻底烧毁了建筑。";
				next;
				mes "[齐德]";
				mes "在被发现前，我和伊娃成功逃走，之后就在这里定居。毕竟我们不能和普通人混在一起。";
				next;
				mes "[齐德]";
				mes "伊娃设法救下了一个试验对象，他长大后外表像普通人，但实际上是完美的。";
				next;
				mes "[齐德]";
				mes "那个男孩大约十岁时逃走了。我想他进入了青春期……你知道那个年纪的男孩女孩。";
				next;
				mes "[齐德]";
				mes "伊娃无法忘记他，在这座黑暗的洞穴里等他回来。有一阵子他寄来没有地址的信，但后来信不再寄来。那时伊娃消失了。";
				mes "她离开后，我在房间里发现了^3131FF一根巨大的黑色羽毛^000000。";
				next;
				mes "[齐德]";
				mes "我不知道为什么，但是……我相信伊娃已经不在了……";
				next;
				break;
			case 4:
				set .@exitloop,1;
				break;
			}
			if (.@exitloop) break;
		}
		mes "[齐德]";
		mes "嗯……";
		mes "也许奥利弗就是伊娃的孩子……";
		next;
		mes "[齐德]";
		mes "不，他太年轻了，不可能是他，因为那是很久以前的事……";
		next;
		mes "[齐德]";
		mes ".........................";
		next;
		mes "[齐德]";
		mes "我想那只是旧日记忆……我为什么要在意？其他人又为什么要在意？";
		next;
		mes "^660000齐德停止说话，低下了头。沉默片刻后，他再次开口。^000000";
		next;
		mes "[齐德]";
		mes "现在我老得连伊娃和那个男孩都快记不清了。";
		mes "我活着的目的就是保护其他村民。他们还有未来，要生活在这座黑暗的洞穴里。";
		next;
		mes "[齐德]";
		mes "这本书很有意思，但我确定那个叫奥利弗的家伙经历了和你一样的事。";
		next;
		mes "[齐德]";
		mes "即使他和伊娃有关，现在也太迟了，什么都无法为她做。";
		next;
		mes "[齐德]";
		mes "想想吧：即使伊娃或那个男孩还活着，谁能把我们从这座黑暗洞穴中救出去？答案是没人。";
		next;
		mes "[Zid]";
		mes ".................................";
		next;
		mes "[齐德]";
		mes "很抱歉没能帮上太多忙。";
		mes "你最好从梦中醒来，继续自己的生活。";
		mes "……可悲的是，一切不过是一场梦……";
		next;
		mes "[齐德]";
		mes "如果你真的同情我们，请不要让其他人知道我们在哪里。";
		next;
		mes "^660000齐德把头转向一边。你仍不确定这一切是否真的发生过。一切都太不真实了……^000000";
		next;
		mes "^660000和齐德的对话令你感到沮丧，你决定回到梦罗克，忘掉这一切。^000000";
		set barmunt_crow,10;
		changequest 2066,2067;
		close;
	}
	else if (barmunt_crow == 10) {
		mes "齐德似乎对这本书失去了兴趣。";
		mes "你决定把书交给梦罗克的本杰明。";
		close;
	}
	else {
		mes "[怪物般的男子]";
		mes "别看我的脸……";
		close;
	}
}


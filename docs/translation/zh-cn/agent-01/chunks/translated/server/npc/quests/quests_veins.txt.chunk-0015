	next;
	mes "[托尔火山营地士兵]";
	mes "嘿嘿……";
	mes "我等不及要吃晚饭了！";
	close;
}

thor_camp,109,167,3	script	Control Panel#vol	111,{
	if (aru_vol == 17) {
		mes "^3355FF这个控制面板管理着";
		mes "托尔火山营地的主要能源，";
		mes "帮助营地在地下";
		mes "顺利运转。";
		mes "所有设施都由它控制。";
		mes "看起来功能正常。";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "这些管道里流淌着熔岩……";
		mes "我想它们的热量就是营地的能源。";
		mes "真是聪明的想法~";
		mes "难怪这里能一直运转。";
		mes "非常值得研究。";
		next;
		mes "^3355FF控制面板发出轻微的机械声，";
		mes "运行似乎很顺畅。";
		mes "所有东西看起来都在正常工作。";
		mes "没有发现故障。";
		mes "系统状态良好。";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "这里没有问题。";
		mes "我可以回去向那位上校报告了。";
		mes "任务应该完成了。";
		changequest 2124,2125;
		set aru_vol,18;
		close;
	}
	end;
}

thor_camp,150,65,3	script	Dummy#1::VeinsDummy	111,{
	if (aru_vol == 19) {
		mes "^3355FF这是一个训练假人，";
		mes "看起来很耐打。胸口刻着";
		mes "卢恩·米德加尔特王国的徽章。^000000";
		mes "它似乎专门用来承受攻击。";
		mes "训练用具很结实。";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "哇……";
		mes "他们真的很讨厌卢恩·米德加尔特王国……";
		mes "(^333333严格来说，我不该这样做。";
		mes "这算不算叛国？^000000)";
		mes "我还是小心一点。";
		mes "千万别被发现。";
		next;
		mes "[维托上校]";
		mes "我听不见，士兵！";
		mes "声音要洪亮清晰！";
		mes "请大声回答！";
		mes "现在……执行攻击！";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "是，长官！";
		next;
		specialeffect EF_HIT2;
		mes "["+strcharinfo(0)+"]";
		mes "一！";
		next;
		specialeffect EF_HIT2;
		mes "["+strcharinfo(0)+"]";
		mes "二！";
		next;
		specialeffect EF_HIT2;
		mes "["+strcharinfo(0)+"]";
		mes "三！！";
		next;
		specialeffect EF_HIT2;
		mes "["+strcharinfo(0)+"]";
		mes "四！";
		next;
		specialeffect EF_HIT2;
		mes "["+strcharinfo(0)+"]";
		mes "五！！";
		next;
		specialeffect EF_HIT2;
		mes "["+strcharinfo(0)+"]";
		mes "六！！";
		next;
		specialeffect EF_HIT2;
		mes "["+strcharinfo(0)+"]";
		mes "七！！";
		next;
		specialeffect EF_HIT2;
		mes "["+strcharinfo(0)+"]";
		mes "八！！";
		next;
		specialeffect EF_HIT2;
		mes "["+strcharinfo(0)+"]";
		mes "九！";
		next;
		specialeffect EF_HIT2;
		mes "["+strcharinfo(0)+"]";
		mes "十！";
		set aru_vol,20;
		close;
	}
	else if (aru_vol == 20) {
		mes "^3355FF*砰*^000000";
		specialeffect EF_HIT2;
		emotion ET_HUK, playerattached();
		next;
		mes "[维托上校]";
		mes "士兵……";
		mes "我命令你砍假人";
		mes "多少次？";
		mes "你记得吗？";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "10 次，长官！";
		next;
		mes "[维托上校]";
		mes "那你实际上";
		mes "砍了假人";
		mes "多少次？";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "11 次，长官！";
		next;
		mes "[维托上校]";
		mes "不可接受！";
		mes "这次要听清命令，";
		mes "再正确地做一遍！";
		mes "不要再多砍一次。";
		set aru_vol,19;
		close;
	}
}


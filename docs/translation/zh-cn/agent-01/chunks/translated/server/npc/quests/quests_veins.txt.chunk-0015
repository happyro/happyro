ve_in,237,131,1	script	Female Customer#ve1	940,{
	mes "[女顾客]";
	mes "酒保，你的常客里没有";
	mes "几个英俊的年轻人吗？";
	mes "你知道，我最近一直很孤单……";
	mes "真想找个人聊天。";
	next;
	if (Sex == SEX_FEMALE) {
		mes "[酒保]";
		mes "哈哈，这个嘛，";
		mes "我也不太确定……";
		next;
		mes "[酒保]";
		mes "比如……我？";
		next;
		mes "[女顾客]";
		mes "哼……";
		next;
		mes "[酒保]";
		mes "哎呀，别这样！";
		mes "我只是开玩笑~";
		emotion ET_CRY;
		close;
	}
	mes "[酒保]";
	mes "哈哈，这个嘛，";
	mes "我也不太确定……";
	mes "这里这位年轻冒险家怎么样？";
	mes "看起来挺不错的。";
	next;
	mes "["+strcharinfo(0)+"]";
	mes "我吗？";
	emotion ET_PROFUSELY_SWEAT, playerattached();
	next;
	mes "[女顾客]";
	mes "嗯……";
	mes "不是我喜欢的类型。";
	emotion ET_THINK, playerattached();
	close;
}

ve_in,239,107,1	script	Male Customer#ve2	943,{
	mes "[男顾客]";
	mes "那个丑陋的老头凭什么";
	mes "能让姑娘们挽着手臂，";
	mes "我却刚被女朋友甩了，";
	mes "还被所有朋友抛弃了？！";
	mes "朋友们也都抛弃了我！";
	next;
	mes "[男顾客]";

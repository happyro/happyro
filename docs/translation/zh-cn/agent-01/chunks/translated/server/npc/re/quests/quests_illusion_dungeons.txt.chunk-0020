		end;
	}

	// daily
	if ((checkquest(3414,PLAYTIME) == 0 || checkquest(3414,PLAYTIME) == 1) && (checkquest(3416,PLAYTIME) == 0 || checkquest(3416,PLAYTIME) == 1)) {
		mes "[Jerrymon]";
	mes "今天调查所需的东西已经全部齐了，谢谢你！！";
		next;
		mes "[Jerrymon]";
	mes "看来你已经办完事了。要移动到依斯鲁得吗？";
		next;
	if (select( "移动", "不移动" ) == 2) {
			mes "[Jerrymon]";
		mes "如果需要帮助，随时告诉我！";
			close;
		}
		specialeffect EF_MAP_MAGICZONE3;
		mes "[Jerrymon]";
	mes "好吧，嗯！";
		next;
		mes "[Jerrymon]";
	mes "我要过去了~~啊！！";
		specialeffect EF_CASTSPIN2;
		close2;
		warp "izlude",128,54;
		end;
	}
	mes "[Jerrymon]";
	mes "你好，研究进行得很顺利。";
	next;
	mes "[Jerrymon]";
	mes "如果进展顺利，说不定能让连接这里和依斯鲁得的漩涡永久存在！";
	next;
	mes "[Jerrymon]";
	mes "那么，你能再帮我一点忙吗？";
	next;
	mes "[Jerrymon]";
	mes "我还需要更多^4d4dff" + getitemname(25899) + "^000000，另外请你处理那些妨碍研究的^4d4dff深海生物^000000。";
	next;
	switch( select( "好的", "下次再做", "我想回依斯鲁得" ) ) {
	case 1:
		mes "[Jerrymon]";
		mes "谢谢！！你能帮我做件事吗？";
		next;

		switch( checkquest(3414,PLAYTIME) ) {
		case -1:
			switch( isbegin_quest(3413) ) {
			case 0:
				.@menu$[0] = "Collect " + getitemname(25899) + "";
				break;
			case 1:
				if (countitem(25899) < 10)
					.@menu$[0] = "Collecting " + getitemname(25899) + " - In Progress";
				else
					.@menu$[0] = "Collect " + getitemname(25899) + " - Done";
				break;
			case 2:
				end;
			}
			break;
		case 0:
		case 1:
			.@menu$[0] = "^999999" + getitemname(25899) + " Collection - Pending^000000";
			break;
		case 2:
			.@menu$[0] = "Collect " + getitemname(25899) + "";
			break;
		}

		switch( checkquest(3416,PLAYTIME) ) {
		case -1:
			switch( checkquest(3415,HUNTING) ) {
			case -1:
				.@menu$[1] = "Kill Deep Sea Creatures";
				break;
			case 0:
			case 1:
				.@menu$[1] = "Kill sea creatures - In Progress";
				break;
			case 2:
				.@menu$[1] = "Kill Deep Sea Creatures - Done";
				break;
			}
			break;
		case 0:
		case 1:
			.@menu$[1] = "^999999Deep Sea Creatures Killed - Pending^000000";
			break;
		case 2:
			.@menu$[1] = "Kill Deep Sea Creatures";
			break;
		}

		switch( select( .@menu$[0], .@menu$[1], "下次再来。" ) ) {
		case 1:
			switch( checkquest(3414,PLAYTIME) ) {
			case -1:
				break;
			case 0:
			case 1:
				end;	// todo
			case 2:
				erasequest 3414;
				break;
			}
			switch( isbegin_quest(3413) ) {
			case 0:
				mes "[Jerrymon]";
		mes "这里的所有深海生物都会掉落^4d4dff" + getitemname(25899) + "^000000。";
		mes "我现在需要 10 个。";
				next;
				mes "[Jerrymon]";
		mes "那就保重~~！！";
				close2;
				setquest 3413;
				end;
			case 1:
				if (countitem(25899) < 10) {
					mes "[Jerrymon]";
		mes "我需要 10 个^4d4dff" + getitemname(25899) + "^000000。";
					next;
					mes "[Jerrymon]";
		mes "收集齐所有精华后再回来找我！";
					close;
				}
				mes "[Jerrymon]";
	mes "你已经收集齐所有" + getitemname(25899) + "了！！";
				next;
				mes "[Jerrymon]";
	mes "谢谢，我会把它们好好用于研究。";
				close2;
				delitem 25899,10;	// E_Abyss1
				getexp 4441860,3109150;
				erasequest 3413;
				setquest 3414;
				getitem 25271,1;	// IllusionStone
				end;
			case 2:
				end;
			}
			end;
		case 2:
			switch( checkquest(3416,PLAYTIME) ) {
			case -1:
				break;
			case 0:
			case 1:
				end;	// todo
			case 2:
				erasequest 3416;
				break;
			}
			switch( checkquest(3415,HUNTING) ) {
			case -1:
				mes "[Jerrymon]";
	mes "请各击杀 10 只在这里出没的^4d4dff" + getmonsterinfo("ILL_SROPHO", MOB_NAME) + "^000000、^4d4dff" + getmonsterinfo("ILL_DEVIACE", MOB_NAME) + "^000000和^4d4dff" + getmonsterinfo("ILL_MARSE", MOB_NAME) + "^000000。";
				next;
				mes "[Jerrymon]";
				mes "那就保重~~！！";
				close2;
				setquest 3415;
				end;
			case 0:
			case 1:
				mes "[Jerrymon]";
	mes "请各击杀 10 只^4d4dff" + getmonsterinfo("ILL_SROPHO", MOB_NAME) + "^000000、^4d4dff" + getmonsterinfo("ILL_DEVIACE", MOB_NAME) + "^000000和^4d4dff" + getmonsterinfo("ILL_MARSE", MOB_NAME) + "^000000。";
				close;
			case 2:
				mes "[Jerrymon]";
	mes "你已经处理完所有深海生物了，谢谢你的辛苦努力。";
				next;
				mes "[Jerrymon]";
	mes "需要帮助时我会再找你。谢谢！！";
				close2;
				getitem 25271,1;	// IllusionStone
				getexp 4441860,3109150;
				erasequest 3415;
				setquest 3416;
				end;
			}
			end;
		case 3:
			mes "[Jerrymon]";
	mes "我唯一能拜托的人只有你了……";
			next;
			mes "[Jerrymon]";
	mes "如果你改变主意，随时告诉我！！";
			close;
		}
		end;
	case 2:
		mes "[Jerrymon]";
	mes "我会在这里待一阵子，如果你改变主意就告诉我！！";
		close;
	case 3:
		specialeffect EF_MAP_MAGICZONE3;
		mes "[Jerrymon]";
	mes "好吧，嗯！";
		next;
		mes "[Jerrymon]";
	mes "我要过去了~~啊！！";
		specialeffect EF_CASTSPIN2;
		close2;
		warp "izlude",128,54;
		end;
	}
	end;

OnInit:
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "ill_underwater == 5 && checkquest(3411,HUNTING) == -1" );
	questinfo( QTYPE_QUEST2, QMARK_YELLOW, "ill_underwater == 5 && checkquest(3411,HUNTING) == 2" );
	questinfo( QTYPE_QUEST2, QMARK_YELLOW, "isbegin_quest(3412) == 1 && countitem(25899) >= 10" );

	// daily
	questinfo( QTYPE_DAILYQUEST, QMARK_YELLOW, "ill_underwater == 7 && checkquest(3414,PLAYTIME) == -1 && isbegin_quest(3413) == 0" );
	questinfo( QTYPE_DAILYQUEST, QMARK_YELLOW, "isbegin_quest(3413) == 1 && countitem(25899) >= 10" );
	questinfo( QTYPE_DAILYQUEST, QMARK_YELLOW, "checkquest(3414,PLAYTIME) == 2" );

	questinfo( QTYPE_DAILYQUEST, QMARK_YELLOW, "ill_underwater == 7 && checkquest(3416,PLAYTIME) == -1 && checkquest(3415,HUNTING) == -1" );
	questinfo( QTYPE_DAILYQUEST, QMARK_YELLOW, "checkquest(3415,HUNTING) == 2" );
	questinfo( QTYPE_DAILYQUEST, QMARK_YELLOW, "checkquest(3416,PLAYTIME) == 2" );
	end;
}


iz_d04_i,134,223,4	script	Jane#Jane01	1_F_01,{
	if (ill_underwater < 6) {
		mes "[???]";
		mes "你好。";
		next;
		select( "你是西鲁德吗？" );
		mes "[Jane]";
		mes "不，我叫简。";
		next;
		mes "[Jane]";
		mes "西鲁德……？";
		mes "我好像在哪里听过这个名字……";
		close;
	}
	mes "[Jane]";
	mes "你好，看起来你已经在这里待了一段时间……";
	next;
	mes "[Jane]";
	mes "你觉得这里怎么样？这里也很迷人，对吧？";
	next;
	mes "[Jane]";
	mes "我应该回故乡去了……";
	close;
}

iz_d04_i,142,216,4	script	Sunrin#Sun01	4_F_03,{
	if (ill_underwater < 6) {
		mes "[???]";
		mes "你说你在找一个叫西鲁德的人？";
		next;
		mes "[Sunrin]";
		mes "我叫桑琳。";
		next;
		mes "[Sunrin]";
		mes "西鲁德……啊，我好像知道你说的是谁。";
		next;
		mes "[Sunrin]";
		mes "一直往左走，你就能找到他。";
		next;
		mes "[Sunrin]";
		mes "那么，祝你今天愉快！！";
		close;
	}
	mes "[Sunrin]";
	mes "这里的人都是移民和定居者。";
	next;
	mes "[Sunrin]";
	mes "如你所见，深处仍留有文明的痕迹，但这里的每个人都曾是外来者。";
	next;
	mes "[Sunrin]";
	mes "你很快就会习惯的。";
	next;
	mes "[Sunrin]";
	mes "海怪偶尔会发动攻击，不过也就这样了……";
	close;
}

iz_d04_i,125,226,0	script	Sirood#SRD3	HIDDEN_WARP_NPC,4,4,{
	end;
OnTouch:
	if (ill_underwater < 7 && isbegin_quest(3410) == 0)
		cloakoffnpcself( "Sirood#SRD4" );
	end;
}

iz_d04_i,125,226,5	script(CLOAKED)	Sirood#SRD4	1_M_04,{
	if (ill_underwater != 5 && ill_underwater != 6)
		end;
	switch( isbegin_quest(3410) ) {
	case 0:
		mes "[Sirood]";
		mes "你好，冒险者。";
		next;
		mes "- 西鲁德像是在等我一样向我打了招呼。-";
		next;
		mes "[Sirood]";
		mes "看来我发出的消息已经传到依斯鲁得了，太好了……";
		next;
		mes "[Sirood]";
		mes "大约 3 个月前……那天下着雨，还刮着风，我去钓鱼。";
		next;
		mes "[Sirood]";
		mes "钓到第一条鱼后，我想用鱼竿把它拉出来，却不小心绊倒掉进了水里。";
		next;
		mes "[Sirood]";
		mes "我拼命想游出去，却感觉有什么东西用力把我往里面拉。";
		next;
		mes "[Sirood]";
		mes "那东西看起来像漩涡……我以为自己要死了……醒来后，就发现自己到了这里。";
		next;
		mes "[Sirood]";
		mes "我不知道为什么自己不需要呼吸，也不知道为什么不吃东西却不会饿。";
		next;
		mes "[Sirood]";
		mes "观察这里的环境时，我发现偶尔会形成小型漩涡。";
		next;
		mes "[Sirood]";
		mes "我猜那就是把我卷进来的同一种漩涡。";
		next;
		mes "[Sirood]";
		mes "漩涡持续的时间很短。我花了两个月才把刻有我名字的鱼竿放进漩涡。";
		next;
		mes "[Sirood]";
		mes "等待有人发现它……";
		next;
		mes "[Sirood]";
		mes "你是以那根鱼竿为线索找到我的吗？";
		next;
		select( "没错。" );
		mes "[Sirood]";
		mes "啊，那我就放心了……如果你回到岸上时能带我一起走，我会非常感激。";
		next;
		mes "- 我想应该和杰里蒙谈谈如何把西鲁德送回岸上的事。- ";
		close2;
		setquest 3410;
		end;
	case 1:
		mes "[Sirood]";
	mes "冒险者，回到岸上时请带我一起走。";
		close;
	case 2:
		end;
	}
	end;
}

iz_d04_i,146,226,4	script	Nick#Nick01	2_M_SAGE_B,{
	mes "[Nick]";
	mes "怎么样？住在这里值得吗？";

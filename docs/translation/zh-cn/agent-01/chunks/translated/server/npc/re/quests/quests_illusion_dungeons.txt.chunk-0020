iz_d05_i,138,186,5	script	Kena#Kena	4_M_02,{
	if (checkweight(1201,3) == 0) {
		mes "你携带的物品太多了。";
		mes "整理物品后再试吧。";
		close;
	}
	if (BaseLevel < 180)
		end;
	if (ill_underwater < 5)
		end;
	if ((checkquest(3418,PLAYTIME) == 0 || checkquest(3418,PLAYTIME) == 1) && (checkquest(3420,PLAYTIME) == 0 || checkquest(3420,PLAYTIME) == 1)) {
		mes "[Kena]";
		mes "辛苦了。今天好好休息，明天再来吧。";
		close;
	}
	mes "[Kena]";
	mes "你好，冒险者。";
	next;
	mes "[Kena]";
	mes "我听说下层有许多危险的深海生物，但真正来到这里后，才发现它们比想象中更加危险。";
	next;
	mes "[Kena]";
	mes "不久前，一只下层生物来到上层时还引起了很大的骚动。";
	next;
	mes "[Kena]";
	mes "深海生物的数量正在增加。冒险者，可以请你帮忙吗？";
	next;
	if (select( "是", "否" ) == 2) {
		mes "[Kena]";
		mes "糟糕……";
		next;
		mes "[Kena]";
		mes "放任不管会很危险……";
		close;
	}
	mes "[Kena]";
	mes "谢谢，如果你能帮我击退深海生物或鱼人，我会非常感激。";
	next;
	mes "[Kena]";
	mes "你想做什么？";
	next;
	.@menu$[0] = callsub( S_Quest, "击杀深海生物", 3418,3417 );
	.@menu$[1] = callsub( S_Quest, "消灭深海鱼人", 3420,3419 );

	switch( select( .@menu$[0], .@menu$[1], "下次再来。" ) ) {
	case 1:
		switch( checkquest(3418,PLAYTIME) ) {
		case -1:
			break;
		case 0:
		case 1:
			mes "[Kena]";
			mes "今天应该够了，请明天再来吧。";
			close;
		case 2:
			erasequest 3418;
			break;
		}
		switch( checkquest(3417,HUNTING) ) {
		case -1:
			mes "[Kena]";
			mes "请各击杀 10 只^4d4dff" + getmonsterinfo("ILL_SWORD_FISH", MOB_NAME) + "^000000、^4d4dff" + getmonsterinfo("ILL_PHEN", MOB_NAME) + "^000000和^4d4dff" + getmonsterinfo("ILL_KING_DRAMOH", MOB_NAME) + "^000000。";
			next;
			mes "[Kena]";
			mes "这些怪物非常凶猛，一定要小心。";
			next;
			mes "[Kena]";
			mes "谢谢。";
			close2;
			setquest 3417;
			end;
		case 0:
		case 1:
			mes "[Kena]";
			mes "^4d4dff" + getmonsterinfo("ILL_SWORD_FISH", MOB_NAME) + "^000000、^4d4dff" + getmonsterinfo("ILL_PHEN", MOB_NAME) + "^000000和^4d4dff" + getmonsterinfo("ILL_KING_DRAMOH", MOB_NAME) + "^000000。";
			next;
			mes "[Kena]";
			mes "请各击杀 10 只。";
			close;
		case 2:
			mes "[Kena]";
			mes "它们都已经被消灭了，辛苦你了。";
			next;
			mes "[Kena]";
			mes "有时间的话请明天再来。我会等你的。";
			close2;
			getitem 25271,1;	// IllusionStone
			getexp 20107500,14075250;
			erasequest 3417;
			setquest 3418;
			end;
		}
		end;
	case 2:
		switch( checkquest(3420,PLAYTIME) ) {

verus04,171,267,3	script	Rekenber Guard#ver03	4_M_LGTGUARD2,{
	mes "[雷根贝勒警卫]";
	if (Sex == SEX_MALE)
		mes "我讨厌用移动厕所，可我的膀胱似乎憋不了多久。你呢？";
	else
		mes "啊！走开！别靠近我！我要把自己留给未来的新娘！";
	close;
}
verus04,218,217,5	script	Geologist#ver04	4_M_HUGRANFA,{
	mes "[地质学家]";
	mes "嗯，这栋建筑被石墙压垮了。";
	mes "其余部分几乎都被碾成了尘土。";
	next;
	mes "[助手]";
	mes "是的，教授。";
	next;
	mes "[地质学家]";
	mes "与这面石墙相比，村庄所在的地形形成于不同的时期。至少这是我的初步判断。";
	next;
	mes "[助手]";
	mes "是的，教授。";
	next;
	mes "[地质学家]";
	mes "地下村庄似乎不是人工建造的，可我无法想象它是如何自然形成的。你怎么看？";
	next;
	mes "[助手]";
	mes "是的，教授。";
	next;
	mes "[地质学家]";
	mes "……你到底有没有在听我说？";
	next;
	mes "[助手]";
	mes "是的，教授。";
	next;
	mes "[地质学家]";
	mes "唉。";
	mes "我们去吃午饭吧。";
	next;
	mes "[助手]";
	mes "是的，教授！";
	close;
}
verus04,217,216,5	duplicate(Geologist#ver04)	Student#ver05	4_M_HUMAN_01

verus04,50,193,3	script	Scholar#ver06	4_M_HUMERCHANT,{
	mes "[学者]";
	mes "施瓦尔茨瓦尔德或许是米德加尔特三国中科学最先进的国家，但仍远远无法与这里相比。";
	next;
	mes "[学者]";
	mes "朱彼洛斯也是如此。如果这里的科学知识传给施瓦尔茨瓦尔德，它本可以强大得多。";
	next;
	mes "[学者]";
	mes "当然，这是基于我的理论：这里的居民也曾是施瓦尔茨瓦尔德人。";
	close;
}
verus04,127,243,3	script	Pierrot#ver07	4_M_PIERROT,{
	mes "[小丑]";
	mes "被困在这个狭小的地方，我感觉自己快疯了。";
	mes "嘿，要不要我用杂耍球为你占卜今天的运势？";
	next;
	if (select( "好啊。", "不用了，谢谢。" ) == 2)
		close;
	mes "[小丑]";
	mes "好，选一个你喜欢的颜色。";
	mes "你选择的颜色会告诉我你的运势。";
	next;
	.@s = select( "红色", "蓝色", "黄色", "绿色" );
	mes "[小丑]";
	mes "咚、咚、咚！这就是你今天的运势！";
	mes "让我取出球里的运势纸……";
	next;
	mes "[小丑]";
	mes "今天是……";
	next;
	mes "[小丑]";
	switch(.@s) {
	case 1:
		mes "和昨天、前天一样无聊的一天。";
		mes "只有积极思考才能让你摆脱这种低落。微笑并善待他人，也许幸运女神会让你今天开心起来。";
		break;
	case 2:
		mes "啊，你就不该下床。无论走到哪里，麻烦都会跟着你。";
		mes "我强烈建议你今天待在避难所里。睡一觉把霉运睡掉。";
		break;
	case 3:
		mes "不算糟糕的一天，但你得努力才能享受好运。";
		mes "去挖掘现场挖些土吧。也许能找到宝藏。";
		break;
	case 4:
		mes "你一生中最幸运的一天！无论走到哪里，都能收获财富和朋友。";
		mes "也许你会在这里找到埋藏的历史遗物。那一定很棒，对吧？";
		break;
	}
	next;
	mes "[小丑]";
	mes "喜欢我的占卜吗？还是很讨厌？";
	mes "你的未来是可以改变的——你想塑造成什么样都行。";
	mes "别太兴奋，也别太沮丧。只要专注于你的目标。";
	next;
	mes "[小丑]";
	mes "好了，想再占卜时就回来吧。";
	close;
}


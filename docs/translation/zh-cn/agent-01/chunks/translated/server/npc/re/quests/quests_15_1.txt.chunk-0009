verus04,91,252,5	script	Archaeologist#tevt01	4_M_6THPRIN1,10,10,{
	mes "[考古学家]";
	mes "我们有时会聚在一起聊天。";
	mes "分享信息也是工作的一部分。";
	close;

OnTouch_:
	if (.ontalk == 1)
		end;
	.ontalk = 1;
	sleep 3000;
	npctalk "我怀疑维鲁斯城有着特殊的用途。", "Archaeologist#tevt01";
	sleep 5000;
	npctalk "你怎么知道这个地方叫维鲁斯？", "New Excavator#tevt03";
	sleep 5000;
	npctalk "哦，这个名字写在广场各处的里程碑和墙上。", "Civilization Researcher#tevt04";
	sleep 5000;
	npctalk "维鲁斯城、维鲁斯镇、维鲁斯广场……", "Civilization Researcher#tevt04";
	sleep 5000;
	npctalk "还有两个区域无法进入。", "Civilization Researcher#tevt04";
	sleep 5000;
	npctalk "哦，就是那两个需要许可的区域。你知道得真多。", "New Excavator#tevt03";
	sleep 5000;
	npctalk "我只是从在镇上一栋房子里找到的地图上推断出来的。", "Historian#tevt02";
	sleep 5000;
	npctalk "这里由四个区域组成，目前只有镇和广场可以探索。", "Archaeologist#tevt01";
	sleep 5000;
	npctalk "我们最好更加努力，否则探索范围可能只能停留在这里。", "Archaeologist#tevt01";
	sleep 5000;
	npctalk "如果这真是一座规划好的城市，当初的规划是什么？", "New Excavator#tevt03";
	sleep 5000;
	npctalk "艾因贝赫完全是为采矿而建。这座城市或许也有类似的特殊用途。", "Scientist#tevt05";
	sleep 5000;
	npctalk "一定与技术研究和实验有关。", "Scientist#tevt05";
	sleep 5000;
	npctalk "我是从镇上找到的期刊和日记中推断出来的。", "Historian#tevt02";
	sleep 5000;
	npctalk "这些期刊和日记大多属于学者和科学家。", "Historian#tevt02";
	sleep 5000;
	npctalk "关键在于，这个古代文明拥有非常先进的科学。", "Civilization Researcher#tevt04";
	sleep 5000;
	npctalk "它可能根本不属于古代。也可能是某种无法理解的存在。", "Civilization Researcher#tevt04";
	sleep 5000;
	npctalk "我们要解开这个谜团，为人类创造更美好的未来！", "New Excavator#tevt03";
	sleep 5000;
	npctalk "*哼* 最后还不是都归雷根贝勒。", "Scientist#tevt05";
	sleep 5000;
	npctalk "但核心发现和挖掘成果会由所有参与的组织共享。", "New Excavator#tevt03";
	sleep 5000;
	npctalk "我们能做的，就是在当下做好自己最擅长的事。", "Civilization Researcher#tevt04";
	sleep 5000;
	npctalk "但我总觉得雷根贝勒另有目的。我不是不知感恩，只是……", "Historian#tevt02";
	sleep 5000;
	npctalk "现在先专注于眼前吧。", "Historian#tevt02";
	sleep 5000;
	npctalk "除了各自的研究对象，我们把发现的所有信息都分享出来如何？", "Archaeologist#tevt01";
	sleep 5000;
	npctalk "我同意。", "Civilization Researcher#tevt04";
	sleep 1000;
	npctalk "好。", "Scientist#tevt05";
	sleep 5000;
	npctalk "嗯，你们知道今天午餐吃什么吗？", "Scientist#tevt05";
	sleep 3000;
	npctalk "嗯……", "Archaeologist#tevt01";
	sleep 5000;
	npctalk "一些冷冻食品。我打算吃昨天留下的面包。", "Civilization Researcher#tevt04";
	sleep 5000;
	npctalk "唉，雷根贝勒有时真小气。", "Historian#tevt02";
	sleep 5000;
	npctalk "为什么？冷冻食品有什么问题？", "New Excavator#tevt03";
	sleep 5000;
	npctalk "给，尝尝我的。", "Historian#tevt02";
	sleep 5000;
	npctalk "你也可以吃我的。", "Archaeologist#tevt01";
	sleep 5000;
	npctalk "或者我的。", "Scientist#tevt05";
	sleep 3000;
	npctalk "...", "New Excavator#tevt03";
	sleep 5000;
	npctalk "嗯……你们不饿吗？", "New Excavator#tevt03";
	sleep 5000;
	sleep 5000;
	npctalk "难道是因为不冷冻就很难吃吗？", "New Excavator#tevt03";
	sleep 35000;
	.ontalk = 0;
	end;
}

verus04,89,251,5	script	Historian#tevt02	4_TOWER_07,{
	mes "[历史学家]";
	mes "我的工作最辛苦的地方是什么？";

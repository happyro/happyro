verus04,94,251,3	script	Civilization Researcher#tevt04	4_TOWER_16,{
	mes "[文明研究员]";
	mes "我原以为这里是朱彼洛斯的一部分。";
	mes "现在我得重新考虑这个理论了。";
	next;

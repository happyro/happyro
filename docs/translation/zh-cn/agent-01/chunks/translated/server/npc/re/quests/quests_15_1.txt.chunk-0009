	next;
	mes "[挖掘向导]";
	mes "我会带您前往朱彼洛斯内部相连的挖掘现场。";
	next;
	mes "[挖掘向导]";
	mes "内部还有许多向导，";
	mes "迷路时可以很容易找到他们。";
	next;
	mes "[挖掘向导]";
	mes "感谢您为人类发展作出的贡献。祝您好运。";
	close;

OnInit:
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "BaseLevel >= 140 && isbegin_quest(7610) == 0" );
	end;
}


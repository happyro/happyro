			mes "如果我是你，早就离开这里了。你是因为不知道怎么去那里才留在这里，对吧？既然如此，我就告诉你。为了我的救命恩人，这点事我还是能做到的。";
			next;
			mes "[Sleepy meow]";
			mes "如果你去拉萨格，就能在那里找到^4D4DFF[码头]^000000。从那里乘坐前往新世界的船吧。无论你要去哪里，都祝你一切顺利。谢谢你为我做的一切，喵。";
			erasequest 14591;// Secret Ingredient
			delitem 921,5;// Mushroom Spore
			getexp 500,1000;
			navigateto "lasagna",205,325;
			close;
		}
	}
	switch( checkquest(14592,PLAYTIME) ) {
	case -1:
		switch( checkquest(14591,HUNTING) ) {
		case -1:
			mes "[Sleepy meow]";
			mes "冒险者……请救救我……";
			next;
			if (select( "为什么？发生什么事了？", "你说救你是什么意思？" ) == 2) {
				mes "[" + strcharinfo(0) + "]";
				mes "我觉得应该让更有经验的人来处理。我还是个新手。";
				next;
				mes "[Sleepy meow]";
				mes "真冷酷……";
				close;
			}
			mes "[Sleepy meow]";
			mes "这样下去我觉得我要死了……";
			next;
			mes "[" + strcharinfo(0) + "]";
			mes "那到底怎么了？";
			next;
			mes "[Sleepy meow]";
			mes "我爸爸，不对，是厨师，让我去弄些蘑菇孢子之类的东西……";
			next;
			mes "[Sleepy meow]";
			mes "可是你看，阳光。";
			next;
			mes "[Sleepy meow]";
			mes "这样的日子我必须沐浴阳光、睡觉……";
			next;
			mes "[Sleepy meow]";
			mes "这些阳光让我想睡觉，喵……";
			next;
			mes "[Sleepy meow]";
			mes "我一直待在这里，拼命抵抗阳光，等待有人从这里经过，喵。";
			next;
			mes "[Sleepy meow]";
			mes "为了抵抗睡意，我觉得自己快死了，喵。";
			next;
			mes "[Sleepy meow]";
			mes "所以请帮我弄到那些蘑菇孢子，我快不行了，喵。";
			next;
			mes "[Sleepy meow]";
			mes "顺便也打败那些变异蘑菇。我讨厌它们，喵。";
			next;
			mes "[Sleepy meow]";
			mes "我爸爸，不对，是厨师，训练过我进入洞窟，所以他才能让我做这种事，喵。";
			next;
			mes "[Sleepy meow]";
			mes "所以一想到它们，我就气得不得了，喵。";
			next;
			mes "[Sleepy meow]";
			mes "你那是什么眼神？你觉得我很可怜吗，喵？";
			next;
			mes "[Sleepy meow]";
			mes "真没礼貌，不过没关系。你不是唯一这么想的人，喵。";
			next;
			mes "[Sleepy meow]";
			mes "你决定不帮忙也没关系，喵。";
			next;
			mes "[Sleepy meow]";
			mes "就算我抵抗睡意没有死在这里，我爸爸，不对，是厨师，也会杀了我。只因为蘑菇孢子，喵。";
			next;
			mes "[Sleepy meow]";
			mes "那也没关系。我已经复活过很多次了。只要长时间深度睡眠就能复活，喵。";
			next;
			mes "[Sleepy meow]";
			mes "所以，请把它当成……拯救某人的生命……帮帮我嘛……";
			setquest 14591;// Secret Ingredient
			close;
		case 0:
		case 1:
			break;
		case 2:
			if (countitem(921) < 5)
				break;
			mes "[Sleepy meow]";
			mes "冒险者……？你是因为完成了才来叫醒我吗？让我看看……";
			next;
			mes "[Sleepy meow]";
			mes "哇，你真的完成了！你做得太快，我都完全清醒了。你真是个奇才！";
			next;
			mes "[Sleepy meow]";
			mes "你为什么不替我去酒馆烤炉工作？不过我相信你也会讨厌那里的。";
			next;
			mes "[Sleepy meow]";
			mes "明天可能还需要蘑菇孢子之类的东西，所以再来一趟吧。我会赶快把这些送去，然后休息。谢谢！我欠你一个人情。";
			erasequest 14591;// Secret Ingredient
			delitem 921,5;// Mushroom Spore
			setquest 14592;// Resting Time
			getexp 500,1000;
			close;
		}
		mes "[Sleepy meow]";
	mes "你已经完成了吗，喵？";
		next;
		mes "[Sleepy meow]";
	mes "当然没有。这还没完成。你已经忘了吗，喵？";
		next;
		mes "[Sleepy meow]";
	mes "捕捉 10 只变异蘑菇，并带来 5 个蘑菇孢子，喵。";
		next;
		mes "[Sleepy meow]";
	mes "完成后叫醒我。没有理由就别叫醒我，喵。";
		close;
	case 0:
	case 1:
		mes "[Sleepy meow]";
		mes "今天没有更多事情了，你可以走了……";
		next;
		mes "[Sleepy meow]";
		mes "别打扰我的……睡眠……";
		close;
	case 2:
		mes "[Sleepy meow]";
		mes "是冒险者。就是昨天那位冒险者。太好了，今天也请救救我，喵。";
		next;
		mes "[Sleepy meow]";
		mes "好像又来了一个麻烦的鱼糕订单。所以请帮我准备材料。今天我也很忙，正拼命抵抗阳光，喵。";
		next;
		mes "[Sleepy meow]";
		mes "捕捉 10 只变异蘑菇，并带来 5 个蘑菇孢子，喵。";
		next;
		mes "[Sleepy meow]";
		mes "请……帮帮我……";
		erasequest 14592;// Resting Time
		setquest 14591;// Secret Ingredient
		close;
	}

OnInit:
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "!isbegin_quest(14591) && !isbegin_quest(14592) && BaseLevel == 20" );
	end;
}

lasagna,222,187,3	script	Chef#dorcon	4_CAT_CHEF,{
	if (BaseLevel < 6 || BaseLevel > 20) {
		if (checkquest(14592,PLAYTIME) == 2)
			erasequest 14592;

		setarray .@quest_id[0],
			14591,	// Secret Ingredient
			14590,	// Hunter's destination
			14589,	// Sticky ingredient
			14588,	// The Competition
			14546;	// Take care of grass thief

		if (BaseLevel > 20) {	// check / remove quests
			for ( .@i = 0; .@i < 5; .@i++ ) {
				switch( checkquest(.@quest_id[.@i],HUNTING) ) {
				case -1:
					break;
				case 0:
				case 1:
					.@quest_left[.@j] = .@quest_id[.@i];
					.@j++;
					break;
				case 2:
					mes "[Chef]";
					mes "你平安完成了工作。谢谢。";
					next;
					mes "[Chef]";
					mes "你这么有本事，不该一直困在这里工作。要不要去找点别的事？";
					next;
					mes "[Chef]";
					mes "去新世界冒险也不错。如果不是因为工作，我早就离开了。";
					next;
					mes "[Chef]";
					mes "总之，谢谢你的帮助。帮了大忙。";
					erasequest .@quest_id[.@i];
					switch(.@quest_id) {
					case 14546:
						getexp 120,200;
						break;
					case 14588:
						getexp 200,300;
						break;
					case 14589:
						getexp 300,500;
						break;
					case 14590:
						getexp 400,800;
						break;
					case 14591:
						getexp 500,1000;
						break;
					}
					close;
				}
			}
			if (.@j > 0) {
				mes "[Chef]";
				mes "我看得出你正在处理我拜托你的事情。";
				next;
				mes "[Chef]";
				mes "你这么有本事，不该一直困在这里工作。要不要去找点别的事？";
				next;
				mes "[Chef]";
				mes "我还没无耻到要把这样有潜力的年轻人束缚在这里。";
				next;
				mes "[Chef]";
				mes "去新世界冒险也不错。如果不是因为工作，我早就离开了。";
				next;
				mes "[Chef]";
				mes "总之，谢谢你的帮助。帮了大忙。";
				if (isbegin_quest(14592) > 0)
					erasequest 14592;
				for ( .@i = 0; .@i < .@j; .@i++ )
					erasequest .@quest_left[.@i];
				close;
			}
		}
		mes "[Chef]";
		mes "我很忙！忙得不可开交！";
		close;
	}

	setarray .@datas[0],
		10, 14546,	// Take care of grass thief
		14, 14588,	// The Competition
		16, 14589,	// Sticky ingredient
		20, 14590,	// Hunter's destination
		21, 14591;	// Secret Ingredient

	for ( .@i = 0; .@i < 10; .@i += 2 ) {
		if (isbegin_quest(.@datas[.@i+1]) > 0) {	// can't start another quest here
			.@quest_id = .@datas[.@i+1];
			break;
		}
		if (BaseLevel < .@datas[.@i]) {
			.@quest_id = .@datas[.@i+1];
			break;
		}
	}

	switch( checkquest(14592,PLAYTIME) ) {
	case -1:
		switch( checkquest(.@quest_id,HUNTING) ) {
		case -1:
			mes "[Chef]";
			mes "冒险者，能帮我一个小忙吗？我现在有事情要做，但你也看到了，我人手不足。你觉得怎么样？";
			next;
			mes "[Chef]";
			mes "就当是继续训练，请帮帮我。我会给你丰厚的报酬，怎么样？";
			next;
			if (select( "我试试看。", "我很忙。" ) == 2) {
				mes "[" + strcharinfo(0) + "]";
				mes "我现在很忙，之后再做。";
				close;
			}
			mes "[Chef]";
			mes "哦，太感谢了。真是帮了大忙！";
			next;
			mes "[Chef]";
			mes "那么我们直入主题吧。";
			next;
			mes "[Chef]";
			switch(.@quest_id) {
			case 14546:
				mes "所有拉萨格人都喜欢卡鲁纳牛奶，但你知道它是怎么做的吗？卡鲁纳牛奶由充分发酵的卡鲁尼亚克奶和鲜奶制成。";
				next;
				mes "[Chef]";
				mes "配方虽然简单，但要有好味道就需要优质原料。所以我们从自己饲养的奶牛那里取奶。";
				next;
				mes "[Chef]";
				mes "我相信你去过拉维奥尔平原。你一定要从那里过来。";
				next;
				mes "[Chef]";
				mes "你要去的不是哨所。一直向南走会看到十字路口，然后继续向下走。";
				next;
				mes "[Chef]";
				mes "我们的奶牛就在那里吃草。那里的草新鲜又干净，所以牛奶味道极佳。";
				next;
				mes "[Chef]";
				mes "但是草叶蝙蝠和叶子疯人正在吞食牧草。";
				next;
				mes "[Chef]";
				mes "所以请去消灭它们。每种消灭 5 只就够了。";
				next;
				mes "[Chef]";
				mes "全部捕捉后可以来找我，也可以和那里的^4D4DFF[牧羊人]^000000交谈。";
				navigateto "lasa_fild01",353,370;
				next;
				mes "[Chef]";
				mes "报酬都是一样的。准备好了吗？";
				setquest 14546;// Take care of grass thief
				close;
			case 14588:
				mes "你知道制作卡鲁纳牛奶最重要的东西是什么吗？是充分发酵的卡鲁纳奶和鲜奶。";
				next;
				mes "[Chef]";
				mes "卡鲁纳由南桥附近的卡鲁纳大师制作。具体配方是商业秘密，我不能告诉你，但有一点可以说。";
				next;
				mes "[Chef]";
				mes "那就是蜂蜜。拉萨格的田野开满甜美的花，所以我们能收集大量优质蜂蜜。";
				next;
				mes "[Chef]";
				mes "但你知道收集蜂蜜时最大的敌人是什么吗？是野生大黄蜂。";
				next;
				mes "[Chef]";
				mes "它们是痴迷蜂蜜的生物，收集蜂蜜非常在行……由于花朵需要授粉，我们不能彻底消灭它们，但必须控制数量。";
				next;
				mes "[Chef]";
				mes "所以到了时候，我们会雇佣冒险者猎杀野生大黄蜂。";
				next;
				mes "[Chef]";
				mes "你应该试试。10 只大黄蜂不算太大的负担。";
				next;
				mes "[Chef]";
				mes "完成后可以来找我，也可以向在那里收集蜂蜜的^4D4DFF[弗洛林]^000000报告。";
				setquest 14588;// The Competition
				close;
			case 14589:
				mes "求你了。请捕捉罗达青蛙，带给我 5 个黏糊脚！没有它们我做不了布丁！";
				next;
				mes "[Chef]";
				mes "求你了，拜托。";
				next;
				mes "[Chef]";
				mes "请捕捉 10 只罗达青蛙。我一直讨厌它们滑溜溜的皮肤。";
				next;
				mes "[Chef]";
				mes "拿到黏糊脚后可以带给我，也可以交给^4D4DFF[普洛克]^000000。他反正答应会把它们带来。";
				setquest 14589;// Sticky ingredient
				close;
			case 14590:
				mes "我的鱼干串还没送来。一定又是那些沙漠狼。";
				next;
				mes "[Chef]";
				mes "嘿，冒险者，你觉得怎么样？能不能处理那些狼，救救我们的鱼干串？";
				next;
				mes "[" + strcharinfo(0) + "]";
				mes "鱼干串是什么？";
				next;
				mes "[Chef]";
				mes "就是鱼干。它们一个接一个绑在绳子上，所以简称鱼干串。但那些沙漠狼总是把它们吃光，实在令人头疼。";
				next;
				mes "[Chef]";
				mes "请处理那些沙漠狼，救救我们的鱼干串。那是我最喜欢的零食。捕捉 10 只狼，它们就不会再靠近了。";
				next;
				mes "[Chef]";
				mes "完成后可以来找我，也可以向在那里晒鱼的^4D4DFF[渔夫]^000000报告。";
				setquest 14590;// Hunter's destination
				close;
			case 14591:
				mes "你知道酒馆烤炉的招牌菜是什么吗？";
				next;
				mes "[" + strcharinfo(0) + "]";
				mes "卡鲁纳牛奶？";
				next;
				mes "[Chef]";
				mes "不，不。那是最受欢迎的菜。我想说的是……对了！我是说厨师的特色菜。";
				next;
				mes "[Chef]";
				mes "是鱼糕。点它的人不多，所以店里甚至没有现成材料。";
				next;
				mes "[Chef]";
				mes "所以有订单时我们才会立即获取材料。";
				next;
				mes "[Chef]";
				mes "酒馆烤炉有自己的特殊网络，可以在 10 分钟内收到材料。这样顾客就不用无限等待。";
				next;
				mes "[Chef]";
				mes "但你也知道，人生中没有真正的‘永远’。不过，我们总是努力去实现‘永远’。";
				next;
				mes "[Chef]";
				mes "而现在，这份努力正受到挑战。";
				next;
				mes "[" + strcharinfo(0) + "]";
				mes "发生什么事了？";
				next;
				mes "[Chef]";
				mes "你一定听说过拉维奥尔森林里的洞窟。那里有不可名状的东西，也有能成为美味食材的生物。";
				next;
				mes "[Chef]";
				mes "你知道变异蘑菇吗？它们的‘蘑菇孢子’是鱼糕的重要材料。";
				next;
				mes "[Chef]";
				mes "但不知为何，它们和巴西利斯克生活在一起，这给我们造成了严重问题。";
				next;
				mes "[Chef]";
				mes "我们急忙派人去寻找蘑菇孢子，却什么也没找到。一点消息都没有。";
				next;
				mes "[Chef]";
				mes "发出消息已经 15 分钟了，还是没有消息。这一定意味着他又在附近睡着了。";
				next;
				mes "[Chef]";
				mes "我不想求那个瞌睡鬼帮忙，但他是唯一有空的人。";
				next;
				mes "[" + strcharinfo(0) + "]";
				mes "所以你想让我去拿蘑菇孢子，对吧？";
				next;
				mes "[Chef]";
				mes "朋友，你真机灵。是的，请弄些蘑菇孢子来。";
				next;
				mes "[Chef]";
				mes "路上也许可以把变异蘑菇打倒，用来训练。顺便捕捉大约 10 只变异蘑菇。";
				next;
				mes "[" + strcharinfo(0) + "]";
				mes "为什么？";
				next;
				mes "[Chef]";
				mes "你必须熟悉这份工作，这样我才能再次让你工作！";
				next;
				mes "[Chef]";
				mes "你怎么能逼我说这种话？！你真迟钝！快去，出发吧！";
				next;
				mes "[Chef]";
				mes "完成后可以带给我，也可以交给^4D4DFF[睡猫]^000000。还有，别忘了教训他！";
				setquest 14591;// Secret Ingredient
				close;
			}
		case 0:
		case 1:
			switch(.@quest_id) {
			case 14546:
				mes "[Chef]";
				mes "我们的奶牛……应该吃很多美味的东西……请处理 5 只叶子疯人和 5 只草叶蝙蝠。";
				close;
			case 14588:
				mes "[Chef]";
				mes "你必须快点。我们的蜂蜜快用完了。10 只野生大黄蜂！";
				close;
			case 14589:
				mes "[Chef]";
				mes "今天请帮我做些布丁。捕捉 10 只甜罗达青蛙，带给我 5 个黏糊脚！";
				close;
			case 14590:
				mes "[Chef]";
				mes "请保护我的鱼干串。捕捉 10 只猎人沙漠狼，这样应该足以让它们远离鱼干串。";
				close;
			case 14591:
				mes "[Chef]";
				mes "今天能做些鱼糕吗？求你了。请别让我让顾客空手回家。他们可是等了很久才来吃鱼糕的。";
				next;
				mes "[Chef]";
				mes "请捕捉 10 只变异蘑菇，带给我 5 个蘑菇孢子。快点！";
				close;
			}
		case 2:
			switch(.@quest_id) {
			case 14546:
				mes "[Chef]";
				mes "现在我们的奶牛可以吃到很多美味的牧草了。谢谢你。";
				next;
				mes "[Chef]";
				mes "我们的奶牛非常喜欢你。真令人惊讶，因为它们通常很害羞。";
				next;
				mes "[Chef]";
				mes "明天能再帮我一个忙吗？哦，不用马上回答。今晚好好休息，明天再来吧。";
				erasequest 14546;// Take care of grass thief
				setquest 14592;// Resting Time
				getexp 120,200;
				close;
			case 14588:
				mes "[Chef]";
				mes "你安全处理了那些野生大黄蜂。真是太厉害了。";
				next;
				mes "[Chef]";
				mes "厉害到让我想明天再拜托你一件事。弗洛林最近遇到了很多困难。";
				next;
				mes "[Chef]";
				mes "那明天再见！";
				erasequest 14588;// The Competition
				setquest 14592;// Resting Time
				getexp 200,300;
				close;
			case 14589:
				if (countitem(921) < 5) {
					mes "[Chef]";

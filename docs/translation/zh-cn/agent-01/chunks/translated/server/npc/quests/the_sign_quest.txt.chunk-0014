		mes "把石头送来了。太好了，";
		mes "干得不错。我会把消息传给大师，";
		mes "请稍后去找他。";
		mes "辛苦你了。";
		delitem 7181,1; //Receipt_01
		set sign_q,40;
		close;
	}
	else if (sign_q == 40) {
		mes "非常感谢你";
		mes "为我们";
		mes "付出了这么多努力。";
		mes "我们会记住你的帮助。";
		close;
	}
	else if (sign_q == 41) {
		mes "你好。嗯？";
		mes "大师又让你";
		mes "执行其他任务了吗？";
		mes "这么快就有新任务？";
		next;
		switch(select("没有。:你还有其他任务交给我。")) {
		case 1:
	mes "[玛哈特拉]";
			mes "好吧。";
			mes "那我们之后";
			mes "再聊~";
			mes "祝你顺利。";
			close;
		case 2:
	mes "[玛哈特拉]";
			mes "我……我有吗……？";
			mes "大师没有给我";
			mes "留下任何指示。";
			mes "嗯，我知道你可以做什么了！";
			mes "你去帮助^FF0000赛琳^000000吧。她似乎遇到了烦恼……";
			set sign_q,42;
			close;
		}
	}
	else if (sign_q < 51) {
		mes "虽然你可能只是为了呜咽的星光";
		mes "才去做这件事，";
		mes "但我还是非常感谢你的帮助。";
		mes "赛琳是个好女孩，";
		mes "不该一直这么消沉……";
		mes "拜托你了。";
		close;
	}
	else if (sign_q == 51) {
		mes "是的。";
		mes "我听赛琳说了。";
		mes "我不知道她一直在担心弟弟。";
		mes "咳咳……";
		mes "谢谢你帮助她。";
		mes "我会把消息传给大师。";
		next;
		mes "[玛哈特拉]";
		mes "如果没有其他问题，大师会让你通过测试。";
		mes "祝你好运。";
		set sign_q,52;
		close;
	}
	else if (sign_q == 98) {
		mes "我对你非常失望。";
		mes "我们信任你，";
		mes "可你真的让我们失望了。";
		next;
	mes "[玛哈特拉]";
		mes "好吧，我想这就是测试的本质。";
		mes "测试的设计目的就是让最优秀的人";
		mes "才能通过。";
		mes "你还需要继续努力。";
		mes "不要气馁。";
		mes "下次再试。";
		close;
	}
	else {
		mes "希望大师能听我的话，";
		mes "穿得更符合他的身份。";
		mes "即使他认为自己只是商人，";
		mes "他也是这座宅邸的主人！";
		mes "不过请别告诉他这些~";
		mes "我可不想惹麻烦。";
		close;
	}
}

alberta,98,202,5	script	Guard#s10	105,{
	mes "[胡鲁布]";
	mes "欢迎来到";
	mes "阿尔切斯宅邸。";
	if (sign_q < 35) {
		mes "如果你有事要找大师，";
		mes "请告诉我。";
		mes "我会为你通报。";
		close;
	}
	else if (sign_q < 52) {
		mes "如果你有事要找大师，";
		mes "请告诉我。";
		mes "我会为你通报。";
		next;
		switch(select("我想见贝克兰先生。:祝你今天愉快。")) {
		case 1:
	mes "[胡鲁布]";
			mes "啊，你是来";
			mes "找大师的吗？";
			mes "他今天没有外出办事，";
			mes "你应该能见到他。";
			mes "请稍等片刻。";
			mes "我会通知他。";
			close;
		case 2:
	mes "[胡鲁布]";
			mes "啊……";
			mes "祝你今天愉快。";
			mes "请慢走。";
			close;
		}
	}
	else if (sign_q == 97 || sign_q == 98) {
		mes "如果你没有事情，";
		mes "请离开这里。";
		mes "不要在宅邸附近逗留。";
		close;
	}
	else {
		mes "最近大师的心情似乎很好。";
		mes "我想这都要感谢你。";
		mes "你为宅邸带来了好消息。";
		mes "大家都很高兴。";
		close;
	}
}

alberta,43,49,5	script	Poor-looking Merchant	89,{
	callfunc "F_UpdateSignVars";
	mes "[马亨]";
	if (sign_q < 35) {
		mes "为什么……？";
		mes "我家族的财富";
		mes "和声望怎么会";
		mes "一落千丈？";
		mes "这到底是怎么回事？";
		next;
	mes "[马亨]";
		mes "自从阿尔切斯家族来到艾尔贝塔，";
		mes "他们很快就取代了我们，";
		mes "成为这里最大的商家。";
		mes "这是我们最大的耻辱……";
		close;
	}
	else if ((sign_q < 52) || (sign_q ==98)) {
		mes "^333333*叹气……*^000000";
		mes "这到底是怎么发生的？";
		mes "阿尔切斯家族为什么能这么快变得这么富有？";
		mes "我实在想不通。";
		next;
		switch(select("阿尔切斯家族？:你知道贝克兰先生在哪里吗？")) {
		case 1:
	mes "[马亨]";
			mes "我的家族图达家族，";
			mes "过去经营着艾尔贝塔最大的";
			mes "贸易公司。";
			mes "但五十年前阿尔切斯家族来到这里，";
			mes "他们开始在各方面超越我们……";
			mes "我们根本无法竞争。";
			next;
	mes "[马亨]";
			mes "他们简直是金融天才！";
			mes "在贝克兰的领导下，";
			mes "他们的宅邸已经成为艾尔贝塔，";
			mes "甚至可能是整个卢恩-米德加尔特";
			mes "最富有的地方之一……";
			mes "真令人难以置信。";
			close;
		case 2:
	mes "[马亨]";
			mes "贝克兰……？";
			mes "哦，他现在大概在";
			mes "十层楼高的金库里，";
			mes "在钱堆里游泳吧。";
			mes "你知道有钱人是什么样的。";
			mes "我只是开个玩笑。";
			next;
			select(".........");
	mes "[马亨]";
			mes "我、我只是开玩笑！";
			mes "你看到北边那座大宅邸了吗？";
			mes "那就是阿尔切斯宅邸。";
			mes "他现在应该在家。";
			next;
	mes "[马亨]";
			mes "他通常经常出差，";
			mes "但如果你运气好，";
			mes "应该能找到他。";
			mes "祝你好运。";
			close;
		}
	}
	else if (sign_q == 97) {
		mes "为什么……？";
		mes "我家族的财富";
		mes "和声望怎么会";
		mes "一落千丈？";
		mes "这到底是怎么回事？";
		next;
	mes "[马亨]";
		mes "自从阿尔切斯家族来到艾尔贝塔，";
		mes "他们很快就取代了我们，";
		mes "成为这里最大的商家。";
		mes "这是我们最大的耻辱……";
		close;
	}
	else {
		mes "你知道，如果阿尔切斯家族很贪婪，";
		mes "他们其实不会发展到今天这么大。";
		mes "他们为许多社会事业捐助，";
		mes "因此赢得了很多支持。";
		next;
	mes "[马亨]";
		mes "我得承认……";
		mes "他们全家都是";
		mes "金融天才，确实如此。";
		mes "我们没法否认。";
		close;
	}
}

yuno,330,100,4	script	Knight#ss	734,{
	callfunc "F_UpdateSignVars";
	mes "[莱贝赫]";
	if (sign_q < 38) {
		mes "我非常喜欢收藏";
		mes "独特而罕见的物品。";
		mes "就是大多数人一生中";
		mes "只能见到一次的东西。";
		mes "那种物品最有价值。";
		mes "你能理解吗？";
		next;
	mes "[莱贝赫]";
		mes "我通常会通过";
		mes "阿尔切斯贸易公司";
		mes "来扩充收藏。";
		mes "他们的价格不算最低，但服务非常可靠。";
		close;
	}
	else if (sign_q == 38) {
		if (countitem(7049) < 1) {
			mes "请问……";
			mes "你是阿尔切斯贸易公司的人吗？";
			mes "我一直在等我的订单，";
			mes "但他们还没有送来。";
			next;
			switch(select("不，我不是。:他们一定很忙。:是的，我带来了你的订单。")) {
			case 1:
	mes "[莱贝赫]";
				mes "哦，抱歉。";
				mes "是我弄错了。";
				mes "那么，祝你旅途平安。";
				close;
			case 2:
	mes "[莱贝赫]";
				mes "我想你说得对。";
				mes "毕竟朱诺离艾尔贝塔很远。";
				mes "也许只是我";
				mes "太期待这次送货了……";
				close;
			case 3:
	mes "[莱贝赫]";
				mes "真的吗？！";
				mes "太好了！";
				mes "你带来我订的物品了吗？";
				mes "它在哪里？";
				next;
					switch(select("我把它放在某处了。:抱歉，我弄丢了。")) {
				case 1:
	mes "[莱贝赫]";
					mes "哦，好吧。";
					mes "只要你没有弄丢就好。";
					mes "我会在这里等着，";
					mes "请尽快把它带给我。";
					mes "拜托了。";
					close;
				case 2:
	mes "[莱贝赫]";
					mes "什么……？";
					mes "喂，朋友。";
					mes "这可不好笑！";
					mes "你是在开玩笑，对吧？";
					next;
					switch(select("不，我不是在开玩笑。:好吧，你猜对了~")) {
					case 1:
	mes "[莱贝赫]";
						mes "我不敢相信！";
						mes "我要写信给你的老板，";
						mes "贝克兰先生。";
						mes "你觉得怎么样？";
						close;
					case 2:
	mes "[莱贝赫]";
						mes "哦，谢天谢地！";
						mes "我还以为你真的弄丢了！";
						mes "请尽快把它带给我，";
						mes "我会在这里等你。";
						close;
					}
				}
			}
		}
		else {
			set .@signid,getcharid(0,strcharinfo(0));
			set .@sign3, .@signid & 65535;
			set .@sign4, .@signid >> 16;
			set .@sign1,254;
			set .@sign2,0;
			if (!countitem2(7049,1,0,0,.@sign1,.@sign2,.@sign3,.@sign4)) {
				mes "嗯……？";
				mes "一定是哪里弄错了。";
				mes "这不是我订的东西。";
				mes "好吧，我可以等……";
				next;
	mes "[莱贝赫]";
				mes "回去把我真正订的东西带来，";
				mes "好吗？这次别再弄错了。";
				mes "谢谢，我很感激~";
				mes "请尽快回来。";
				close;
			}
			else {
				mes "终于到了！";
				mes "没错，这就是我订的东西。";
				mes "谢谢你送来！";
				next;
	mes "[莱贝赫]";
				mes "这是你的收据。请把它交给贝克兰先生，";
				mes "让他知道你帮我完成得很好。";
				mes "再次感谢！";
				mes "辛苦你了。";
				mes "请收好收据。";
				mes "这能证明你完成了订单。";
				delitem2 7049,1,1,0,0,.@sign1,.@sign2,.@sign3,.@sign4;
				set sign_q,39;
				getitem 7181,1; //Receipt_01
				if (checkre(3)) {
					if (BaseLevel < 60) getexp 100,0;
					else if (BaseLevel < 70) getexp 200,0;
					else if (BaseLevel < 80) getexp 400,0;
					else if (BaseLevel < 90) getexp 700,0;
					else getexp 1100,0;
				} else {
					if (BaseLevel < 60) getexp 1000,0;
					else if (BaseLevel < 70) getexp 2000,0;
					else if (BaseLevel < 80) getexp 4000,0;
					else if (BaseLevel < 90) getexp 7000,0;
					else getexp 11000,0;
				}
				close;
			}
		}
	}
	else if (sign_q == 97) {
		mes "我非常喜欢收藏";
		mes "独特而罕见的物品。";
		mes "就是大多数人一生中";
		mes "只能见到一次的东西。";
		mes "那种物品最有价值。";
		mes "你能理解吗？";
		next;
	mes "[莱贝赫]";
		mes "我通常会通过";
		mes "阿尔切斯贸易公司";
		mes "来扩充收藏。";
		mes "他们的价格不算最低，但服务非常可靠。";
		close;
	}
	else if (sign_q == 98) {
		mes "我对收藏罕见物品很感兴趣。";
		mes "所以我需要寻找这里看不到的东西。";
		next;
	mes "[莱贝赫]";
		mes "通常我会为此使用阿尔切斯贸易公司。";
		mes "虽然价格比我希望的高一些，";
		mes "但他们非常可靠。";
		mes "我相信他们的服务。";
		close;
	}
	else {
		mes "嘿，谢谢你";
		mes "帮我送来订单。";
		mes "它会成为我收藏中";
		mes "很棒的一件物品！";
		next;
	mes "[莱贝赫]";
		mes "寻找独特而古怪的物品";
		mes "确实很困难，但扩充收藏";
		mes "让我感到非常自豪~";
		mes "谢谢你的帮助。";
		close;
	}
}

// The Sign (Part 2)
//============================================================
geffen_in,159,48,5	script	Lonely-looking Woman	711,{
	callfunc "F_UpdateSignVars";
	mes "[布伦达·霍华德]";
	if (sign_q < 54) {
		mes "嗯……";
		mes "今天晚餐做什么好呢？";
		mes "腌卷心菜？";
		mes "我以前学过做法，但一直没机会做……";
		close;
	}
	else if (sign_q == 54) {
		mes "嘿，你到底是谁？";
		mes "你不知道未经邀请进入别人家里很没礼貌吗？";
		mes "而且我正忙着做晚餐，没时间帮助陌生人……";
		next;
		mes "["+ strcharinfo(0) +"]";
		mes "等、等等！";
		mes "我是来找……";
		next;
		input .@input$;
		if (.@input$ != "Engel Howard") {
			mes "[布伦达·霍华德]";
			mes "嗯？";
			mes "你在说";
			mes "什么？";
			next;
	mes "[布伦达·霍华德]";
			mes "嗯……";
			mes "不知道我的腌";
			mes "卷心菜最后会做成什么样？";
			mes "真让人期待。";
			emotion ET_DELIGHT;
			close;
		}
		else {
	mes "[布伦达·霍华德]";
			mes "啊……我明白了。";
			mes "你在找我的丈夫。";
			mes "我丈夫、女儿和我";
			mes "不久前刚从普隆德拉";
			mes "搬到吉芬。";
			next;
	mes "[布伦达·霍华德]";
			mes "我们为了丈夫的事业搬到吉芬。据说这里离他真正需要的某样东西最近。不管那是什么，对他的锻造工作一定非常重要。";
			next;
	mes "[布伦达·霍华德]";
			mes "哦，如果你要找我丈夫，离开前请先和我女儿谈谈。";
			mes "我想她有东西想交给父亲……";
			mes "请帮帮她。";
			set sign_q,55;
			close;
		}
	}
	else if (sign_q < 57) {
		mes "呵呵~！";
		mes "清脆又美味的腌卷心菜~";
		mes "我的孩子很喜欢，上次我做的全被她一个人吃光了。";
		mes "看来今天也要多做一些。";
		close;
	}
	else if (sign_q == 57) {
		mes "啊……";
		mes "你见过我的丈夫了。";
		mes "他过得怎么样？";
		mes "我担心他有没有好好照顾自己……";
		mes "他总是只顾着工作。";
		next;
	mes "[布伦达·霍华德]";
		mes "哦，我实在忍不住担心！";
		mes "谢谢你告诉我他的情况。";
		mes "不过，他应该更经常和我们联系。^333333*叹气*^000000";
		mes "我希望他能平安。";
		emotion ET_THINK;
		close;
	}
	else if (sign_q < 62) {
		if (countitem(7278) > 0) {
			mes "谢谢你把这个带给我。";
			mes "听说他平安、过得不错，我很高兴。";
			mes "虽然他不常回来，";
			mes "但知道他热爱自己的工作就好。";
			mes "请代我向他问好。";
			next;
	mes "[布伦达·霍华德]";
				mes "即便如此，我也该开始让";
				mes "他自己照顾自己了。";
				mes "不能总是担心他。";
				mes "谢谢你来看我。";
				mes "请一路小心。";
				mes "祝你平安。";
				mes "也请把我的问候带给他。";
				mes "我会继续等他回家。";
				mes "希望一切顺利。";
				mes "谢谢你的帮助。";
				mes "再见。";

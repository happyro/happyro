//===== rAthena Script =======================================
//= Central Laboratory
//===== Description: =========================================
//= [Official Conversion]
//= Central Laboratory Instance
//===== Changelogs: ==========================================
//= 1.0 First version. [Capuche]
//= 1.1 Updated to match official script. [Capuche]
//============================================================

verus01,153,155,5	script	Temporary Dimension-mov#pa0829_01	PORTAL,{
	.@party_id = getcharid(1);
	if (.@party_id == 0) {
		mes "[临时次元移动员]";
		mes "没有同伴和你一起吗？即使独自旅行也请先组建队伍。";
		close;
	}
	switch( checkquest(12347,PLAYTIME) ) {
	case -1:
		switch( instance_enter("Central Laboratory") ) {
		case IE_NOMEMBER:
		case IE_NOINSTANCE:
			mes "[临时次元移动员]";
			mes "次元移动通道尚未激活。";
			close;
		case IE_OTHER:
			mes "[临时次元移动员]";
			mes "未知错误。";
			close;
		case IE_OK:
			mapannounce "verus01", "队伍成员 " + strcharinfo(0) + " 正在进入中央实验室（队伍：" + getpartyname(.@party_id) + "）。",bc_map,"0x00FF99";
			setquest 12347;// Trace of Laboratory Access
			end;
		}
		end;
	case 0:
	case 1:
		mes "[临时次元移动员]";
		mes "上次事件仍有残留痕迹。禁止进入。";
		close;
	case 2:
		mes "^0000ff似乎可以使用次元移动员。^000000";
		erasequest 12347;// Trace of Laboratory Access
		close;
	}
}

verus01,149,155,5	script	Civilization Explorer#pa0829_01	4_LGTSCIENCE,{
	if (BaseLevel < 135) {
		mes "[文明探索者]";
		mes "嗯……不知道你能不能派上用场，看来还有空缺！";
		next;
		mes "[文明探索者]";
		mes "变得更强后再回来找我。你应该快到 135 级了！";
		close;
	}
	mes "^ff0000驯服怪物会妨碍这个地下城的进度。请注意。^000000";
	next;
	mes "[文明探索者]";
	switch( isbegin_quest(12346) ) {
	case 0:
		mes "这个区域的古代文明有许多有趣之处。";
		next;
		mes "[文明探索者]";
		mes "观察土层后推测这里有 500 到 600 年历史！";
		mes "但这里挖掘出的许多物品已经远超我们当前的技术。";
		next;
		mes "[文明探索者]";
		mes "找回的记录中也有许多未定义的术语。";
		next;
		select("什么样的未知术语？");
		mes "[文明探索者]";
		mes "^0000ff母体电脑^000000、^0000ff大规模集成芯片^000000，还有什么呢？^0000ff鸡^000000？";
		next;
		mes "[文明探索者]";
		mes "嗯，没错。确实有‘鸡’这个词。我不知道那会是什么技术组合……";
		next;
		mes "[文明探索家]";
		mes "记录中提到了一些似乎在众多技术遗迹中‘扎根’的人。";
		next;
		if (select( "我对这个话题没兴趣。", "有趣。有结果了吗？" ) == 1) {
			mes "[文明探索家]";
			mes "真遗憾。";
			close;
		}
		mes "[文明探索家]";
		mes "我的目标是研究那个时代相关技术的用途，虽然目前发现的东西微不足道。";
		next;
		mes "[文明探索家]";
		mes "如果可以，我想亲自使用次元移动员去看看，但工作太多了。而且我不是冒险者……";
		next;
		mes "[文明探索家]";
		mes "你有没有兴趣前往过去？";
		next;
		mes "[文明探索家]";
		mes "如果发现有趣的物品，能带我参观就更好了。";
		next;
		if (select( "没兴趣。", "好。" ) == 1) {
			mes "[文明探索家]";
			mes "真遗憾。";
			close;
		}
		mes "[文明探索家]";
		mes "你是冒险者。告诉我你的决定。";
		if (isbegin_quest(12346) == 0)
			setquest 12346;// Strange Ancient Science
		break;
	case 1:
		mes "我能如何帮助你？";
		break;
	case 2:
		mes "这次你想做什么？";
		break;
	}
	next;
	if (isbegin_quest(12346) == 1)
		completequest 12346;
	.@party_id = getcharid(1);
	if (.@party_id == 0) {
		mes "[文明探索家]";
		mes "请组建至少 1 人的队伍或加入队伍后再和我谈话。";
		close;
	}
	switch( checkquest(12347,PLAYTIME) ) {
	case -1:
		if (is_party_leader() == false) {
			mes "[文明探索家]";
			mes "啊，你不是队长。带我去见队长！或者把队长带来见我。";
			close;
		}
		if (select( "制造时间裂缝", "取消" ) == 2)
			close;
		if (instance_create("Central Laboratory") < 1) {
			mes "队伍：" + getpartyname( getcharid(1) ) + "";
			mes "队长：" + getpartyleader( getcharid(1) ) + "";
			mes "^0000ff中央实验室^000000 - 未知错误";
			close;
		}
		mes "[文明探索家]";
		mes "时间裂缝打开后，喘口气再和我说话。";
		close;
	case 0:
	case 1:
		mes "[文明探索家]";
		mes "啊，糟糕。";
		mes "次元旅行还有一些残留影响。处于这种状态时无法再次旅行。";
		close;
	case 2:
		mes "^0000ff进入中央实验室的所有痕迹都已抹除。似乎可以和文明探索家交谈。^000000";
		erasequest 12347;// Trace of Laboratory Access
		close;
	}
}

// Entrance
1@lab,104,34,4	script	Probationary researcher#pa0829	4_LGTSCIENCE,{
	if ('switch_enabled == 1) {
		mes "[见习研究员]";
		mes "入口门已经打开了。";
		close;
	}
	if (is_party_leader() == false) {
		mes "[见习研究员]";
		mes "请稍等。我正在和向导确认你是否获得授权。";
		close;
	}
	mes "[见习研究员]";
	mes "你是作为研究项目 32001 的实验助手参加的吗？";
	next;
	if (select( "是。", "不是。" ) == 2) {
		mes "[见习研究员]";
		mes "你似乎来错实验室了。请出去寻求帮助。";
		close;
	}
	mes "[见习研究员]";
	mes "大约需要 5 秒。正在确认访问代码。";
	close2;
	sleep 3000;
	npctalk "见习研究员：访问代码匹配。我会打开门。";
	sleep 6000;
	npctalk "见习研究员：现在可以进入。请注意，无法从另一侧打开这扇门。";
	if ('switch_enabled == 0) {
		'switch_enabled = 1;
		enablenpc instance_npcname("lab_warp#1");
		enablenpc instance_npcname("lab_warp#2");
		enablenpc instance_npcname("lab_warp#3");
		enablenpc instance_npcname("Main Switch#");
		enablenpc instance_npcname("Senior researcher#pa082");
		enablenpc instance_npcname("#eff_nc");
		for ( .@i = 1; .@i <= 8; ++.@i )
			enablenpc instance_npcname( "Switch" + .@i + "#" );
	}
	end;

OnInstanceInit:
	'map_name$ = instance_mapname("1@lab");
	'code_found = 'bool_event = 'switch_enabled = 0;
	for ( .@i = 1; .@i <= 8; .@i++ )
		'switch_position[.@i] = 0;

	// Warps
	disablenpc instance_npcname("lab_warp#1");
	disablenpc instance_npcname("lab_warp#2");
	disablenpc instance_npcname("lab_warp#3");
	disablenpc instance_npcname("lab_warp#4");
	disablenpc instance_npcname("lab_warp#5");

	// Switchs
	disablenpc instance_npcname("Main Switch#");
	disablenpc instance_npcname("Senior researcher#pa082");
	disablenpc instance_npcname("#eff_nc");
	for ( .@i = 1; .@i <= 8; ++.@i )
		disablenpc instance_npcname( "Switch" + .@i + "#" );

	// Experiments
	disablenpc instance_npcname("DR Silvia#pa0829");
	disablenpc instance_npcname("DR Federico#pa0829");
	disablenpc instance_npcname("DR Artemia#pa0829");
	disablenpc instance_npcname("DR Vincent#pa0829");
	disablenpc instance_npcname("#wp01");
	disablenpc instance_npcname("#npc_con01");
	disablenpc instance_npcname("#npc_con03");
	disablenpc instance_npcname("#npc_con05");
	disablenpc instance_npcname("#npc_con06");
	disablenpc instance_npcname("#npc_con07");
	disablenpc instance_npcname("#npc_con08");
	disablenpc instance_npcname("#npc_con10");
	disablenpc instance_npcname("#npc_con11");
	for ( .@i = 1; .@i <= 14; ++.@i )
		hideonnpc instance_npcname("#gen_" + (.@i < 10 ? "0" : "") + .@i);
	disablenpc instance_npcname("lab_warp#end");
	end;
}
// 1@lab,104,34,4	script	Probationary researcher#pa0829_2	4_LGTSCIENCE

// Switchs
1@lab,37,37,3	script	Switch1#	CLEAR_NPC,{
	.@num = charat( strnpcinfo(1),6 );
	setarray .@position$[0], "OFF", "ON";
	mes "[开关 " + .@num + "]";
	mes "开关目前处于" + .@position$[ 'switch_position[.@num] ] + "状态。你要做什么？";
	next;
	'switch_position[.@num] = !( select( "开启","关闭" ) - 1 );
	close;
}
1@lab,39,37,3	duplicate(Switch1#)	Switch2#	CLEAR_NPC
1@lab,41,37,3	duplicate(Switch1#)	Switch3#	CLEAR_NPC
1@lab,43,37,3	duplicate(Switch1#)	Switch4#	CLEAR_NPC
1@lab,46,37,3	duplicate(Switch1#)	Switch5#	CLEAR_NPC
1@lab,48,37,3	duplicate(Switch1#)	Switch6#	CLEAR_NPC
1@lab,50,37,3	duplicate(Switch1#)	Switch7#	CLEAR_NPC
1@lab,52,37,3	duplicate(Switch1#)	Switch8#	CLEAR_NPC

1@lab,34,37,3	script	Main Switch#	CLEAR_NPC,{
	.@string$ = 'switch_position[1] + "" + 'switch_position[2] + "" + 'switch_position[3] + "" + 'switch_position[4] + "" +
		'switch_position[5] + "" + 'switch_position[6] + "" + 'switch_position[7] + "" + 'switch_position[8];
	.@current_code = strtol( .@string$,2 );
	.@code = (gettime(DT_MONTH) + gettime(DT_DAYOFMONTH)) * 5;
	npctalk "今天的访问代码是" + .@code + "，当前输入的代码是" + .@current_code + "。";
	sleep 6000;
	if ('code_found > 0)
		npctalk "门已经打开了。";
	else if (.@current_code != .@code)
		npctalk "代码错误。请重试。";
	else {
		'code_found = 1;
		npctalk "代码正确。正在开门。";
		enablenpc instance_npcname("lab_warp#4");
		enablenpc instance_npcname("lab_warp#5");
		enablenpc instance_npcname("DR Silvia#pa0829");
		enablenpc instance_npcname("DR Federico#pa0829");
		enablenpc instance_npcname("DR Artemia#pa0829");
		enablenpc instance_npcname("DR Vincent#pa0829");
		enablenpc instance_npcname("#wp01");
		donpcevent instance_npcname("#eff_nc") + "::OnStop";
		for ( .@i = 1; .@i <= 8; ++.@i )
			disablenpc instance_npcname( "Switch" + .@i + "#" );
	}
	end;
}

1@lab,45,32,3	script	Senior researcher#pa082	4_LGTSCIENCE,{
	if ('code_found > 0) {
		mes "[高级研究员]";
		mes "门已经打开，现在可以进入。请注意，无法从另一侧打开这扇门。";
		close;
	}
	.@code = (gettime(DT_MONTH) + gettime(DT_DAYOFMONTH)) * 5;
	mes "[高级研究员]";
	mes "看来你是来参加粒子加速实验的。";
	next;
	mes "[高级研究员]";
	mes "今天的访问代码是^0000ff" + .@code + "^000000。";
	mes "代码需要以二进制数字输入。使用我身后的开关输入。";
	next;
	mes "[高级研究员]";
	mes "输入代码后，按下入口附近的主按钮。";
	for ( .@i = 1; .@i <= 8; ++.@i )
		specialeffect EF_STEAL, AREA, instance_npcname("Switch" + .@i + "#");
	close2;
	donpcevent instance_npcname("#eff_nc") + "::OnStart";
	end;
}

1@lab,1,1,0	script	#eff_nc	-1,{
	end;
OnStart:
OnTimer2000:
	specialeffect 203,AREA, instance_npcname("Main Switch#");
	for ( .@i = 1; .@i <= 8; ++.@i )
		specialeffect (203+.@i),AREA, instance_npcname("Switch" + .@i + "#");
	initnpctimer;
	end;
OnStop:
	stopnpctimer;
	end;
}


// Experiments
1@lab,81,84,7	script	DR Silvia#pa0829	4_F_SCIENCE,{
	mes "[西尔维娅博士]";
	mes "实验结束后我想回家，喝冰啤酒，吃炸鸡。";
	next;
	mes "[西尔维娅博士]";
	mes "我快两年没回家了。";
	next;
	mes "^0000ff西尔维娅看着粒子加速器，神情非常疲惫。^000000";
	close;
}

1@lab,80,87,7	script	DR Federico#pa0829	4_LGTSCIENCE,{
	mes "[费德里科博士]";
	mes "这台装置越看越惊人。从未有人制造过如此规模的粒子加速器。";
	next;
	mes "[费德里科博士]";
	mes "这么大的规模，或许能制造小型黑洞……";
	next;
	mes "[费德里科博士]";
	mes "啊，我只是说说而已。这种事情更像灾难而不是实验，哈哈。";
	close;
}

1@lab,80,90,6	script	DR Artemia#pa0829	4_F_SCIENCE,{
	mes "[阿尔忒弥娅博士]";
	mes "看，现实不喜欢有人抓住一根绳子用力拉扯。";
	next;
	mes "[阿尔忒弥娅博士]";
	mes "如此强大的粒子加速可能导致次元扭曲。";
	next;
	mes "[阿尔忒弥娅博士]";
	mes "我有种不好的预感，因为……大自然总会找到办法。";
	close;
}

1@lab,81,93,6	script	DR Vincent#pa0829	4_LGTSCIENCE,{
	mes "[文森特博士]";
	mes "机器完美无缺。不会出问题的！";
	next;
	mes "[文森特博士]";
	mes "阿尔忒弥娅太担心了。总之实验结束后我要去旅行。";
	close;
}

1@lab,80,89,0	script	#wp01	HIDDEN_WARP_NPC,9,9,{
	end;
OnTouch:
	donpcevent instance_npcname("#npc_con01") + "::OnStart";
	disablenpc instance_npcname("#wp01");
	end;
}

// Round 1
1@lab,4,1,3	script	#npc_con01	CLEAR_NPC,{
	end;
OnStart:
	'vincent$ = instance_npcname("DR Vincent#pa0829");
	'federico$ = instance_npcname("DR Federico#pa0829");
	'silvia$ = instance_npcname("DR Silvia#pa0829");
	'artemia$ = instance_npcname("DR Artemia#pa0829");
	'gen_01$ = instance_npcname("#gen_01");
	'gen_02$ = instance_npcname("#gen_02");
	'gen_03$ = instance_npcname("#gen_03");
	'gen_04$ = instance_npcname("#gen_04");
	'gen_05$ = instance_npcname("#gen_05");
	'gen_06$ = instance_npcname("#gen_06");
	'gen_07$ = instance_npcname("#gen_07");
	'gen_08$ = instance_npcname("#gen_08");
	'gen_09$ = instance_npcname("#gen_09");
	'gen_10$ = instance_npcname("#gen_10");
	'gen_11$ = instance_npcname("#gen_11");
	'gen_12$ = instance_npcname("#gen_12");
	'gen_13$ = instance_npcname("#gen_13");
	'gen_14$ = instance_npcname("#gen_14");

	npctalk "费德里科：开始吧。嗯……弗雷萨博士，准备好了吗？", 'federico$;
	sleep 5000;
	npctalk "阿尔忒弥娅：应该是在做最后确认检查。这种规模的实验需要谨慎。", 'artemia$;
	sleep 6000;
	npctalk "西尔维娅：第一次操作成品时必须小心。", 'silvia$;
	sleep 4000;
	npctalk "文森特：啊，希望能快点结束，我好去吃鸡。", 'vincent$;
	sleep 3000;
	npctalk "西尔维娅：啊！我也喜欢！你去的时候叫我。", 'silvia$;
	sleep 6000;
	mapannounce 'map_name$, "?????：啊，啊，一二一二，麦克风测试。", bc_map,0x00ff77;
	sleep 2000;
	npctalk "费德里科：她来了。", 'federico$;
	sleep 2500;
	mapannounce 'map_name$, "?????：粒子加速器项目总负责人，Lona Fresa。", bc_map,0x00ff77;
	sleep 5000;
	mapannounce 'map_name$, "Lona Fresa：当前时间为 " + gettime(DT_MONTH) + " 月 " + gettime(DT_DAYOFMONTH) + " 日，十点过二十五分。", bc_map,0x00ff77;
	sleep 5000;
	mapannounce 'map_name$, "Lona Fresa：在开放空间测试粒子加速对周围环境的影响。", bc_map,0x00ff77;
	sleep 5000;
	npctalk "阿尔忒弥娅：啊……我真的不喜欢这个实验。", 'artemia$;
	sleep 3000;
	mapannounce 'map_name$, "Lona Fresa：实验开始。首席研究员费德里科博士、阿尔忒弥娅、西尔维娅、文森特及助理研究员请注意。", bc_map,0x00ff77;
	sleep 5000;
	'bool_event = true;
	donpcevent instance_npcname("#npc_con03") + "::OnStart";
	npctalk "阿尔忒弥娅：开始吧~", 'artemia$;
	sleep 3000;
	npctalk "文森特：开始旋转发电机。", 'vincent$;
	sleep 3000;
	npctalk "费德里科：发电机转速固定为 10000 RPM。", 'federico$;
	sleep 2500;
	npctalk "西尔维娅：电压仍在容许范围内。", 'silvia$;
	sleep 3000;
	mapannounce 'map_name$, "Lona Fresa：本实验旨在创造此前不存在的新材料。", bc_map,0x00ff77;
	sleep 5000;
	mapannounce 'map_name$, "Lona Fresa：记录员请详细记录催化床安装到加速器后的反应。", bc_map,0x00ff77;
	sleep 6000;
	npctalk "阿尔忒弥娅：正在接触 1 号催化床。", 'artemia$;
	sleep 9000;
	npctalk "西尔维娅：发电机电压不稳定，但仍在容许范围内。", 'silvia$;
	sleep 3000;
	donpcevent instance_npcname("#npc_con03") + "::OnStart2";
	sleep 2000;
	npctalk "西尔维娅：检测到催化床和加速器之间的热量接近容许范围！", 'silvia$;
	sleep 5000;
	npctalk "文森特：加速器正在升温。", 'vincent$;
	sleep 5000;
	npctalk "文森特：320 度。", 'vincent$;
	sleep 5000;
	npctalk "文森特：670 度，升温太快了！", 'vincent$;
	sleep 3000;
	npctalk "文森特：突破 1000 度了！！！！弗雷萨博士！我们必须暂时停止装置！", 'vincent$;
	sleep 3000;
	mapannounce 'map_name$, "Lona Fresa：没问题。", bc_map,0x00ff77;
	sleep 5000;
	npctalk "西尔维娅：问题不简单。温度远远超过了预测数值！", 'silvia$;
	sleep 3000;
	mapannounce 'map_name$, "Lona Fresa：这个问题在预料之中。保持当前状态。", bc_map,0x00ff77;
	sleep 3000;
	npctalk "阿尔忒弥娅：但至少……我之后还能吃鸡。", 'artemia$;
	sleep 5000;
	mapannounce 'map_name$, "MA-4885：主服务器传来情况变化。检测到粒子加速器与催化剂之间出现次元扭曲。", bc_map,0xFFFF00,FW_NORMAL,13;
	sleep 3000;
	npctalk "阿尔忒弥娅：弗雷萨博士！母体电脑情况危险。关闭主电源！", 'artemia$;
	sleep 5000;
	mapannounce 'map_name$, "MA-4885：警报。新的未知生物正从次元夹层接近。", bc_map,0xFFFF00,FW_NORMAL,13;
	sleep 3000;
	npctalk "文森特：发生什么了？谁去关掉那台电脑！", 'vincent$;
	sleep 3000;
	mapannounce 'map_name$, "MA-4885：新的生物体即将从次元夹层传送过来。", bc_map,0xFFFF00,FW_NORMAL,13;
	sleep 5000;
	mapannounce 'map_name$, "MA-4885：剩余 5 秒。", bc_map,0xFFFF00,FW_NORMAL,13;
	sleep 1000;
	mapannounce 'map_name$, "MA-4885：剩余 4 秒。", bc_map,0xFFFF00,FW_NORMAL,13;
	sleep 1000;
	mapannounce 'map_name$, "MA-4885：剩余 3 秒。", bc_map,0xFFFF00,FW_NORMAL,13;
	sleep 1000;
	mapannounce 'map_name$, "MA-4885：剩余 2 秒。", bc_map,0xFFFF00,FW_NORMAL,13;
	sleep 1000;
	mapannounce 'map_name$, "MA-4885：剩余 1 秒。", bc_map,0xFFFF00,FW_NORMAL,13;
	sleep 1000;
	donpcevent instance_npcname("#npc_con05") + "::OnStart";
	mapannounce 'map_name$, "MA-4885：发现无法识别的生物。暂时关闭主电源。", bc_map,0xFFFF00,FW_NORMAL,13;
	sleep 3000;
	'bool_event = false;
	end;
}


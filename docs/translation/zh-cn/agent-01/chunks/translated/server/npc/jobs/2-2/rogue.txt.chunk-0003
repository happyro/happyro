in_rogue,244,39,1	script	Aragham Junior#rg	99,{
	if (ROGUE_Q == 9) {
		mes "[阿拉甘 Jr.]";
		mes "哦，你一定来自";
		mes "盗贼公会……";
		next;
		mes "[阿拉甘 Jr.]";
		mes "我叫";
		mes "阿拉甘二世，";
		mes "沙漠盗贼。";
		mes "准备学习";
		mes "如何成为盗贼了吗？";
		next;
		mes "[阿拉甘 Jr.]";
		mes "作为盗贼，我们的格言是“^0000FF避开强者！恶意对待弱者！^000000”，尤其适用于怪物。";
		next;
		mes "[阿拉甘 Jr.]";
		mes "避开强者！";
		mes "恶意对待弱者！";
		mes "这是条简单规则……";
		next;
		mes "[阿拉甘 Jr.]";
		mes "穿过 ^0000FF地下通道^000000 时记住这一点。尽量一直走到盗贼公会。";
		next;
		mes "[阿拉甘 Jr.]";
		mes "会有一些怪物，但别担心。我知道你很强。那么准备好出发了吗？";
		next;
		if (select("Yes, let's go.:Nah~") == 1) {
			mes "[阿拉甘 Jr.]";
			mes "好……";
			mes "祝你好运。";
			close2;
			warp "in_rogue",15,105;
			set ROGUE_Q,13;
			changequest 2022,2026;
			end;
		}
		mes "[阿拉甘 Jr.]";
		mes "好吧，好吧。";
		mes "慢慢来";
		mes "准备好后回来";
		mes "";
		close;
	}
	else if (ROGUE_Q == 13) {
		mes "[阿拉甘 Jr.]";
		mes "哦，你回来了。";
		mes "我觉得这次你会做得很好。盗贼的另一句格言是“^0000FF失败教会成功^000000”。不过话说回来……";
		next;
		if (select("Re-Test:Cancel") == 1) {
			mes "[阿拉甘 Jr.]";
			mes "祝你好运。";
			close2;
			warp "in_rogue",15,105;
			end;
		}
		mes "[阿拉甘 Jr.]";
		mes "好吧，好吧。";
		mes "慢慢来";
		mes "准备好后回来";
		mes "";
		close;
	}
	else if (BaseJob != Job_Rogue) {
		mes "[阿拉甘 Jr.]";
		mes "嗯……？";
		mes "你是谁？！";
		mes "你不是来自";
		mes "盗贼公会！！";
		next;
		mes "[阿拉甘 Jr.]";
		mes "你是来杀我的，对吧？不！我还不能死！滚开！否则我先杀了你！";
		close;
	}
	else {
		mes "[阿拉甘 Jr.]";
		mes "嘿……";
		mes "什么带你";
		mes "回到这里？";
		mes "你为什么不";
		mes "休息一下";
		mes "离开前？";
		close;
	}
}


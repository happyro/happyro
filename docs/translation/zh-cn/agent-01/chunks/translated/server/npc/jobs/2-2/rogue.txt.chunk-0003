in_rogue,272,135,1	script	Hermanthorn Jr#rg	85,{
	if (ROGUE_Q == 8) {
		mes "[HermanthornJr.]";
		mes "我明白了……";
		mes "你一定来自";
		mes "盗贼公会。";
		mes "你一定是那些";
		mes "史密斯先生不太满意的";
		mes "人之一……";
		next;
		mes "[HermanthornJr.]";
		mes "他发了一通脾气，你把他要的物品都带来了，对吧？看来你仍然很天真。哈哈哈~";
		next;
		mes "[HermanthornJr.]";
		mes "我想他骗你收集那些物品，然后把你交给我。真可悲。";
		next;
		mes "[HermanthornJr.]";
		mes "既然你被他折磨过，我会特别慷慨。给你的测试很简单，非常简单。";
		next;
		mes "[HermanthornJr.]";
		mes "你只需穿过地下通道，一直走回盗贼公会。";
		next;
		mes "[HermanthornJr.]";
		mes "不过有件事要告诉你。在里面要小心，知道吗？";
		next;
		mes "[HermanthornJr.]";
		mes "一群混蛋到处丢树枝、施放魔术……";
		next;
		mes "[HermanthornJr.]";
		mes "嗯……";
		mes "活着回到盗贼公会即可！这就是你要做的全部！";
		set ROGUE_Q,12;
		changequest 2025,2026;
		close;
	}
	else if (ROGUE_Q == 12) {
		mes "[HermanthornJr.]";
		mes "对了，这很重要。进入通道需要密码。开门的四位数字组合是 ^0000FF3019^000000。";
		close;
	}
	else {
		mes "[HermanthornJr.]";
		mes "嗯……？";
		mes "搞什么";
		mes "你在这里做什么。";
		mes "还不快滚？";
		close;
	}
}

in_rogue,270,130,0	script	he_to_rogue#rg	45,1,1,{
OnTouch_:
	mes "^3355FF门锁着。你需要输入四位数字组合才能打开。^000000";
	next;
	input .@input;
	if (.@input < 1 || .@input > 10000) {
		if (ROGUE_Q == 12)
			mes "^3355FF操作失败。请重新输入四位数字组合。^000000";
		else 
			mes "^3355FF请输入四位数字组合。^000000";
		close;
	}
	else if (.@input == 3019) {
		if (ROGUE_Q == 12) {
			mes "^3355FF门";
			mes "已打开。^000000";
			close2;
			warp "in_rogue",10,21;
			set ROGUE_Q,12;
			end;
		}
		else {
			mes "[HermanthornJr.]";
			mes "嗯……";
			mes "我不是告诉过你";
			mes "我改了";
			mes "密码吗？*眨眼*";
			close;
		}
	}
	else {
		mes "^3355FF门";
		mes "仍然锁着。^000000";
		close;
	}
}

in_rogue,200,389,0	script	gen_ro#1	-1,3,3,{
OnTouch_:
	if (BaseJob == Job_Thief) {
		monster "in_rogue",200,389,"Zombie",1015,1,"gen_ro#1::OnMyMobDead";
		monster "in_rogue",201,389,"Zombie",1015,1,"gen_ro#1::OnMyMobDead";
		donpcevent "gen_ro#2::OnDisable";
		donpcevent "gen_ro#3::OnDisable";

		break;
	case 3:
		mes "[" + strcharinfo(0) + "]";
		mes "阿拉贡";
		break;
	case 4:
		mes "[" + strcharinfo(0) + "]";
		mes "莱戈拉斯";
		break;
	}
	switch(select("没有:没:从未:曾经")) {
	case 1: mes "没有"; break;
	case 2: mes "没"; break;
	case 3:
		mes "从未";
		set .@rogue_t,.@rogue_t+10;
		break;
	case 4: mes "曾经"; break;
	}

//===== rAthena Script =======================================
//= Old Blue Box Quest
//===== By ===================================================
//= Celesta, Lupus
//===== Version ==============================================
//= 2.0
//===== Compatible With: ===================================== 
//= rAthena Project
//===== Description: ========================================= 
// [Official Conversion]
//= Old Blue Box quest (?)
//= Officially this quest gave an OBB in exhange for a the
//= required items unlimitedly, however this was changed by
//= Gravity, who claimed this behavior as a bug. 
//= The exact purpose of this quest is undetermined, but
//= Gravity claimed that another quest would eventually
//= branch from this one.
//===== Additional Comments: ================================= 
//= 1.7 Rescripted to Aegis 10.3 standards. [L0ne_W0lf]
//= 1.8 Added missing checkweights. [L0ne_W0lf]
//= 1.9 Moved Morocc NPCs to Morocc Ruins. [L0ne_W0lf]
//= 2.0 Removed unused "name" variable. [L0ne_W0lf]
//============================================================ 

alberta,43,244,0	script	Tourist#thai	99,{
	if (checkweight(1201,1) == 0) {
		mes "- 等一下！ -";
		mes "- 你现在携带的物品太多了。 -";
		mes "- 请减轻负重后再试。 -";
		close;
	}
	if (thai_head >= 1 && thai_head <= 5) {
		switch(thai_head) {
		case 1:
			set .@th_rand,rand(1,100);
			if (.@th_rand > 6 && .@th_rand < 20) {
				mes "[Tourist]";
				mes "...........";
				next;
				mes "[Tourist]";
		mes "你就是那个坏蛋……";
				next;
				mes "[Tourist]";
				mes "...........";
				next;
				mes "[Tourist]";
				mes "...........";
				next;
				mes "[Tourist]";
				mes "...........";
				next;
				mes "[Tourist]";
		mes "不是吗……？";
				next;
				mes "[Tourist]";
				mes "...........";
				next;
				mes "[Tourist]";
				mes "...........";
				next;
				mes "[Tourist]";
				mes "...........";
				next;
				mes "[Tourist]";
		mes "好了好了，你没必要这么刻薄。";
				set thai_head,2;
				close;
			}
			mes "[Tourist]";
			mes "...........";
			next;
			mes "[Tourist]";
		mes "没想到你这么刻薄。走开，我没心情和你说话。";
			close;
		case 2:
			mes "[Tourist]";
			mes "..........";
			next;
			switch(select("你在玩具工厂有事吗？:你不是想去玩具工厂旅游吗？:你为什么来到这里？")) {
			case 1:
				mes "[Tourist]";
				mes "是的。";
				mes "其实……";
				next;
				mes "[Tourist]";
				mes "我想送女朋友一些烤得很好的饼干。";
				mes "可惜在我的故乡梦罗克，没有那种精致食物。";
				next;
				mes "[Tourist]";
				mes "我问过很多商人，他们告诉我只有玩具工厂才有……事情就是这样。";
				next;
				mes "[Tourist]";
				mes "现在我的钱和食物都快用完了……不能再待太久……";
				next;
				if (select("你想让我帮你吗？:那祝你一切顺利。") == 1) {
					set thai_head,3;
					mes "[Tourist]";
					mes "谢天谢地！太谢谢你了。我就知道你会帮我～！";
					next;
					mes "[Tourist]";
					mes "嗯……";
					mes "在谈那个帮助之前……";
					mes "呃，嗯……我现在快饿死了……";
					next;
					mes "[Tourist]";
					mes "可以请你给我一些肉吗？我知道要求太多，";
					mes "但我几乎身无分文，实在没有选择……";
					close;
				}
				set thai_head,1;
				mes "[Tourist]";
				mes ".........";
				mes "听完我的故事，你怎么能这么冷酷？……你真刻薄！";
				close;
			case 2:
				mes "[Tourist]";
				mes "……真的吗？嗯……人们说只有玩具工厂才有烤好的饼干。";
				next;
				mes "[Tourist]";
				mes "我想送女朋友一些烤得很好的饼干。";
				mes "可惜在故乡梦罗克，没有那种精致食物。";
				next;
				mes "[Tourist]";
				mes "我问过很多商人，他们告诉我只有玩具工厂才有……事情就是这样。";
				next;
				mes "[Tourist]";
				mes "现在我的钱和食物都快用完了……不能再待太久……";
				next;
				if (select("你想让我帮你吗？:那祝你一切顺利。") == 1) {
					set thai_head,3;
					mes "[Tourist]";
					mes "谢天谢地！太谢谢你了。我就知道你会帮我～！";
					next;
					mes "[Tourist]";
					mes "嗯……在谈那个帮助之前……呃，嗯……我现在快饿死了……";
					next;
					mes "[Tourist]";
					mes "可以请你给我一些肉吗？我知道要求太多，但我几乎身无分文，实在没有选择……";
					close;
				}
				set thai_head,1;
				mes "[Tourist]";
				mes ".........";
				mes "听完我的故事，你怎么能这么冷酷？……你真刻薄！";
				close;
			case 3:
				mes "[Tourist]";
				mes "有人告诉我只有在艾尔迪巴兰才能找到玩具工厂入口……";
				next;
				mes "[Tourist]";
				mes "所以我找了艾尔迪巴兰后才来到这里……穿过沙漠时差点丢了性命……*抽泣*";
				close;
			}
		case 3:
			if (countitem(517) == 0) {
				mes "[Tourist]";
				mes "我明白……你帮不了我，我能理解。没关系……";
				mes "我也没有资格要求你做什么……";
				mes "但是……";
				next;
				mes "[Tourist]";
				mes "*抽泣*……好……饿……";
				close;
			}
			set .@th_rand,rand(1,100);
			if (.@th_rand > 0 && .@th_rand < 10) {
				if (countitem(517) == 10) {
					mes "[Tourist]";
					mes "啊……谢谢！太谢谢你了！";
					delitem 517,10; //Meat
					next;
				}
				else if (countitem(517) < 10) {
					mes "[Tourist]";
					mes "我很感激你出于善意帮助我，";
					mes "但是……";
					next;
					mes "[Tourist]";
					mes "你这是……小气？！你可以给饿肚子的人更多……再带些肉来！";
					close;
				}
				else if (countitem(517) > 10) {
					mes "[Tourist]";
					mes "我很感激你带来这么多，但……";
					next;
					mes "[Tourist]";
					mes "天啊，你想让我噎死吗？我吃不了这么多！带少一点肉来，好吗？";
					close;
				}
			}
			else if (.@th_rand > 11 && .@th_rand < 80) {
				if (countitem(517) == 20) {
					mes "[Tourist]";
					mes "啊……谢谢！太谢谢你了！";
					delitem 517,20; //Meat
					next;
				}
				else if (countitem(517) < 20) {
					mes "[Tourist]";
					mes "我很感激你出于善意帮助我，但是……";
					next;
					mes "[Tourist]";
					mes "你这是……小气？！再带些肉来！";
					close;
				}
				else if (countitem(517) > 20) {
					mes "[Tourist]";
					mes "我很感激你带来这些，但……";
					next;
					mes "[Tourist]";
					mes "天啊，你想让我噎死吗？我吃不了这么多！带少一点肉来，好吗？";
					close;
				}
			}
			else {
				if (countitem(517) == 40) {
					mes "[Tourist]";
					mes "啊……谢谢！太谢谢你了！";
					delitem 517,40; //Meat
					next;
				}
				else if (countitem(517) < 40) {
					mes "[Tourist]";
					mes "我很感激你出于善意帮助我，但是……";
					next;
					mes "[Tourist]";
					mes "你这是……小气？！再带些肉来！";
					close;
				}
				else if (countitem(517) > 40) {
					mes "[Tourist]";
					mes "天啊，你想让我噎死吗？我吃不了这么多！带少一点肉来，好吗？";
					close;
				}
			}
			set thai_head,4;
			mes "^3355FF他似乎饿了很久。";
			mes "我给的肉他一口气全吃光了。^000000";
			if (countitem(538) > 0) {
			mes "^0000FF……天啊！他没问我就拿走并吃掉了我的饼干！！^000000";
				delitem 538,countitem(538); //Well_Baked_Cookie
			}
			next;
			mes "[Tourist]";
			mes "*呼*……谢谢。终于……我吃饱了。";
			mes "……哦，对了。我的女朋友。";
			next;
			mes "[Tourist]";
			mes "呃……关于我说过的烤饼干？嗯……我知道自己很无礼又自私，";
			mes "但我觉得靠自己找不到。";
			next;
			mes "[Tourist]";
			mes "所以，可以给我带^0000FF20个烤好的饼干^000000吗？";
			next;
			mes "[Tourist]";
			mes "虽然我不该再请求帮助，还要让你费这么多功夫……而我却能安全地待在这里……";
			next;
			mes "[Tourist]";
			mes "我真的想让女朋友开心。为了她脸上的笑容，一切都值得……我不能错过这个机会！";
			next;
			mes "[Tourist]";
			mes "你没有爱过人吗……？你一定能理解这个女人对我的影响！";
			mes "不然我就去卖珠宝……做任何事也不会做这个。";
			next;
			mes "[Tourist]";
			mes "求求你，你比我强壮也没那么娇弱，请带给我^0000FF20个烤好的饼干^000000！";
			mes "我自己根本做不到！！";
			close;
		case 4:
			if (countitem(538) > 19) {
				mes "[Tourist]";
				mes "啊～！！太谢谢你了！！";
				mes "这个世界上真的有很多像你这样的好人。";
				next;
				set thai_head,5;
				delitem 538,20; //Well_Baked_Cookie
				mes "[Tourist]";
				mes "我很感激你为我做的一切……现在我能看到她幸福的笑容了。";
				next;
				mes "[Tourist]";
				mes "嗯，不过我还有一个问题……怎么回梦罗克呢？";
				mes "只要能让我的女孩开心……";
				next;
				mes "[Tourist]";
				mes "……我迟早会想办法。";
				mes "那片沙漠真的很大，你知道吗？";
				close;
			}
			mes "[Tourist]";
			mes "我明白……你帮不了我，我能理解。没关系……我也没有资格要求你做什么……但是……";
			close;
		case 5:
			mes "[Tourist]";
			mes "太谢谢你了！";
			next;
			mes "[Tourist]";
			mes "嗯……我想报答你……";
			mes "你是冒险者……但我没有什么魔法铠甲，也没有你们总拿来玩的卡片……";
			next;
			mes "[Tourist]";
			mes "嗯……我知道了！";
			mes "你迟早想拜访某位智者之类的人，对吧？";
			next;
			mes "[Tourist]";
			mes "去梦罗克拜访我的朋友^649664雅各布^000000，告诉他是我介绍你去的。";
			mes "他知道某位智者的事……不过他自己不是智者……";
			next;
			mes "[Tourist]";
			mes "啊，抱歉，我还没告诉你名字。我叫……";
			mes "^0000FFPandger Mayer^000000.";
			next;
			mes "[Tourist]";
			mes "告诉我的朋友雅各布，是潘杰·梅耶介绍你去的。";
			next;
			mes "[Tourist]";
			mes "所以……你要告诉他：";
			mes "^0000FF潘杰·梅耶向你介绍了我^000000";
			mes "就这样说～";
			mes "^0000FF潘杰·梅耶向你介绍了我^000000";
			mes "^FF0000别忘了～^000000";
			next;
			mes "[Tourist]";
			mes "抱歉我只能这样报答你。";
			mes "有点糟，对吧？";
			next;
			mes "[Tourist]";
			mes "给你，把这个当作额外谢礼。";
			mes "这个小东西在棘手情况下很有用……";
			next;
			mes "[Tourist]";
			mes "希望它能派上用场。";
			if (MaxWeight - Weight < 500) {
				mes "嗯……你携带的东西似乎太多了。要不要我帮你？";
				close;
			}
			set thai_head,6;
			getitem 1205,1; //Cutter_
			next;
			mes "[Tourist]";
			mes "嘿……再次感谢你的帮助。保重，伙计。";
			close;
		}
	}
	else if (thai_head > 5) {
		switch(rand(1,3)) {
		case 1:
			mes "[Tourist]";
			mes "嘿，非常感谢你的帮助。现在我想起来了，我得再次穿过沙漠……*叹气*";
			mes "是的，我最好回去了……";
			next;
			mes "[Tourist]";
			mes "……不管有多难。";
			mes "不过穿过沙漠会很困难……一个人……真糟。";
			close;
		case 2:
			mes "[Tourist]";
			mes "嘿，非常感谢你的帮助……我不确定能否平安回到梦罗克……";
			next;
			mes "[Tourist]";
			mes "但我最好回到女朋友身边。";
			mes "这就是我来这里的目的。";

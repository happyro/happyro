1@gef_in,110,172,0	script	Christopher#1_0et	1_M_SMITH,{
	mes "[ Christopher ]";
	mes "欢迎来到 Christopher 的工坊。";
	mes "锻造所需的一切都能在这里找到。";
	mes "是什么生意";
	mes "让你来找我？";
	next;
	mes "[ Christopher ]";
	mes "为了庆祝节日，我们暂时停下了锻造工作。";
	mes "节日结束后请再来。";
	close;
}

1@gef,129,65,4	script	Point Merchant#gef_m	8_F_GIRL,{
	if (checkweight(1201,1) == 0 || MaxWeight - Weight < 2000) {
		mes "- 请稍等！！-";
		mes "- 你目前携带了 -";
		mes "- 你携带的物品太多了。-";
		mes "- 请减轻负重后 -";
		mes "- 再试一次。-";
		close;
	}
	mes "[ Point Merchant ]";
	mes "你好。我出售巫师使用的 ^FF0000点数^000000 催化剂。你想要什么？";
	next;
	.@i = select("猩红点数 - 200 Zeny:黄绿色点数 - 200 Zeny:靛蓝点数 - 200 Zeny:黄色愿望点数 - 200 Zeny:取消")-1;
	mes "[ Point Merchant ]";
	if (.@i == 4) {
		mes "找不到你需要的东西吗？";
		close;
	}
	setarray .@itemid[0],6360,6363,6361,6362;
	setarray .@color$[0],"Scarlet","Lime Green","Indigo","Yellow Wish";
	mes "你选择了 "+.@color$[.@i]+" 点数。";
	mes "你想要多少？";
	mes "想取消请输入 0。";
	next;
	input .@amount;
	mes "[ Point Merchant ]";
	if (.@amount == 0) {
		mes "你取消了交易。";
		close;
	}
	if (Zeny < .@amount*200) {
		mes "你的钱似乎不够。";
		close;
	}
	if (!checkweight(.@itemid[.@i],.@amount)) {
		mes "库存没有足够空间容纳这么多物品。";
		close;
	}
	Zeny = Zeny-(.@amount*200);
	getitem .@itemid[.@i],.@amount;
	mes "非常感谢。再见~！";
	close;
}

1@gef,127,65,3	script	Universal Rental NPC#gf	8W_SOLDIER,{
	if (ismounting()) {
		message strcharinfo(0),"请先解除坐骑。";
		end;
	} else if ((eaclass()&EAJ_THIRDMASK==EAJ_RANGER) && !countitem(6124)) {
		if (!checkfalcon() && getskilllv("HT_FALCON") && !checkwug()) {
			if(select(" ~ 狼鹰: ~ 野狼")==1) setfalcon;
			else getitem 6124,1; //Wolf's_Flute
		} else getitem 6124,1; //Wolf's_Flute
	} else if ((eaclass()&EAJ_THIRDMASK==EAJ_MECHANIC) && !checkcart() && getskilllv("MC_PUSHCART")) {
		if (!checkmadogear() && getskilllv("NC_MADOLICENCE")) {
				if(select(" ~ 手推车: ~ 魔导机甲")==1) setcart;
			else setmadogear;
		} else setcart;
	} else if (!checkcart() && getskilllv("MC_PUSHCART")) setcart;
	else if (!checkfalcon() && getskilllv("HT_FALCON") && !checkwug()) setfalcon;
	else if (!checkriding() && !checkdragon() && getskilllv("KN_RIDING")) {
		if (eaclass()&EAJ_THIRDMASK==EAJ_RUNE_KNIGHT) setdragon;
		else setriding;
	} else if (!checkmadogear() && getskilllv("NC_MADOLICENCE")) setmadogear;
	else {
		message strcharinfo(0),"你不符合租用条件。";
		end;
	}
	specialeffect2 EF_TEIHIT3;
	end;
}

1@gef,124,65,4	script	Kafra Employee#gef_t	4_F_KAFRA4,{
	cutin "kafra_04",2;
	mes "[Kafra Employee]";
	mes "欢迎~！";
	mes "卡普拉服务";
	mes "永远站在你这边。";
	mes "需要什么帮助？";
	callfunc "F_Kafra",5,5,1,50,0;
}


dali,100,147,3	script	Dimensional Device#gefma	PORTAL,{
	.@n$ = "[次元装置]";
			
		.@ins_geffen_time = checkquest(9316,PLAYTIME);
		
		if ( GeffenTournament < gettimetick(2)) {

			.@party_id = getcharid(1);
			.@p_name$ = getpartyname(.@party_id);
			.@md_name$ = "吉芬魔法大赛";
			
			getpartymember(getcharid(1),0);
			set .@GPPartySize,$@partymembercount;
			
			if( !getcharid(1) || is_party_leader() == false || .@GPPartySize > 1) {
				mes .@n$;
				mes "这是单人副本。请先组建单人队伍再继续。";
				end;
			}
			
			if (!.@party_id) {
				mes .@n$;
				mes "这是单人副本。请先组建单人队伍再继续。";
				end;
			}
				
			switch(select("放弃:^3355FF使用装置^000000")){
			
				case 1:
					mes .@n$;
					mes "你能感觉到装置扭曲了时间。";
					end;
					
				case 2:
					if (BaseLevel < 90) {
						mes .@n$; 
						mes "基础等级必须达到 90 才能继续。";
						end;
					}
						switch(instance_enter(.@md_name$)) {
							case 3:
								mes "发生未知错误。";
								end;
							case 2:
								mes "吉芬魔法大赛副本尚未创建。请先去找 Emmitt White 谈话。";
								end;
							case 1:
								mes "只有登记成员才能进入 "+.@md_name$+" 副本。";
								end;
							case 0:
								mapannounce "dali02",strcharinfo(0)+"所在队伍的成员"+.@p_name$+"正在进入"+.@md_name$+"。",bc_map,"0x00ff99";
								GeffenTournament = gettimetick(2) + 82800;
								if(.@ins_geffen_time != -1) erasequest 9316;
								setquest 9316;
								end;
						}
					end;
			}
		} else if ( GeffenTournament > gettimetick(2) ) {
			mes .@n$;
			mes "看起来现在还不是进入的时机。";
			end;
		}
		end;

}



dali,98,141,3	script	Emmitt White	4_M_KHKYEL,{
	.@n$ = "[ Time Travel Researcher ]";
	
		if (BaseLevel < 90) {
			mes .@n$; 
			mes "基础等级必须达到 90 才能继续。";
			end;
		}
	
	if (checkquest(9309) != -1) {
		mes .@n$,
		"我看到你从大赛回来了。",
		"发现什么有趣的事了吗？";
		next;
		mes .@n$,
		"你向研究员讲述了经历。";
		next;
		mes .@n$,
		"你提供的信息我基本都知道了……";
		next;
		mes .@n$,
		"但我还想知道更多~！",
		"明天还能帮我吗？",
		"我会等着你。";
		next;

				for (.@i = 9284; .@i <= 9314; .@i++) {
					if (checkquest(.@i) != -1) {
						erasequest .@i;
					}
				}
		if (checkquest(9315) != -1)
			changequest 9315,9316;
	}
	
	if (checkquest(9308) != -1) {
		mes .@n$,
		"真不敢相信你赢得了大赛！";
		next;
		mes .@n$,
			"但我还想要更多~！",
			"明天你能帮我吗？",
			"我会等着你。";
		next;

				for (.@i = 9284; .@i <= 9314; .@i++) {
					if (checkquest(.@i) != -1) {
						erasequest .@i;
					}
				}
		if (checkquest(9315) != -1)
			changequest 9315,9316;
	}
	
		getpartymember(getcharid(1),0);
		set .@GPPartySize,$@partymembercount;
		
		if( !getcharid(1) || is_party_leader() == false || .@GPPartySize > 1) {
			mes .@n$;
			mes "这是单人副本。请先组建单人队伍再继续。";
			end;
		}
		
	
	// 23 Hour Cooldown

	if ( GeffenTournament < gettimetick(2) ) {
		.@party_id = getcharid(1);
		.@p_name$ = getpartyname(.@party_id);
		.@md_name$ = "吉芬魔法大赛";

			if (!.@party_id) {
				mes .@n$;
				mes "你必须是队长才能继续。";
				end;
			}
			
		if (is_party_leader() == true){
			mes .@n$; 
			mes "你知道吗？很久以前，吉芬曾举办过魔法大赛。";
			next;
			mes .@n$; 
			mes "我对大赛做了大量研究，但单靠研究仍没获得太多信息。";
			next;
			mes .@n$; 
			mes "我发现这个时间差能帮助研究，实在无法抗拒继续研究的机会。";
			next;
			mes .@n$; 
			mes "现在我找到了你这位冒险者，可以帮助我回到大赛举办的时代。";
			next;
			mes .@n$; 
			mes "请使用次元装置，代我参加魔法大赛。";
			next;
			mes .@n$; 
			mes "你愿意去并告诉我详情吗？";
			next;
			mes .@n$; 
			mes "传送门不稳定，所以你必须单人前往。";
			mes "准备好进入了吗？";
			next;
				switch(select("不:是")){
					case 1:
						mes .@n$;
						mes "改变主意后再回来~！";
						end;
					case 2:
						for (.@i = 9284; .@i <= 9314; .@i++) {
							if (checkquest(.@i) != -1) {
								erasequest .@i;
							}
						}
						
						if (instance_create(.@md_name$) < 0) {
							mes "队伍名称："+.@p_name$;
							mes "队长："+strcharinfo(0);
							mes "^0000ff"+.@md_name$+"^000000——预约失败！";
							end;
						}
						mes .@n$; 
						mes "次元装置已激活。";
						end;
					}
			end;
		} else {
			mes .@n$;
			mes "你必须是队长才能继续。";
			end;
		}

	} else {
		mes .@n$;
		mes "请稍等。";
		mes "必须等计时器结束后才能再次前往。";
		mes " ";
		
		.@time = (GeffenTournament - gettimetick(2));
		.@sec = .@time % 60;
		.@min = (.@time / 60) % 60;
		.@hrs = (.@time / 3600) % 24;

		mes "冷却时间：^3355FF"+(.@hrs < 10 ? "0" : "")+.@hrs+":"+(.@min < 10 ? "0" : "")+.@min+":"+(.@sec < 10 ? "0" : "")+.@sec+"^000000";
		end;
		

			
	}
}


1@gef,122,58,4	script	Receptionist#1_0et	4_M_ARUNA_NFM1,{

	.@n$ = "[大赛接待员]";

	if ( checkquest(9309) != -1 ) {
		mes .@n$;
		mes "芬里尔赢得了今年的魔法大赛！";
		next;
		mes .@n$;
		mes "我是她的忠实粉丝。";
		end;
	}
	
	if ( checkquest(9308) != -1 ) {
		mes .@n$;
		mes "恭喜你成为今年的魔法大赛冠军！";
		end;
	}
		
	if ( 'passtest == 2 ) {
		mes .@n$;
		mes "你想再试一次吗？";
		mes "如果能在 60 秒内杀死沙漠之狼，就能通过测试。";
		next;
		mes .@n$;
		mes "失败会自动从名单中除名，但你可以随时重试。";
		mes "要再参加测试吗？";
		next;
		switch(select("不:是")){
			case 1:
				mes .@n$;
				mes "改变主意后再回来。";
				close;
			case 2:
				mes .@n$;
				mes "进入不收登记费。";
				mes "唯一要求是通过简单测试。";
				next;
				mes .@n$;
				mes "测试很简单。在 60 秒内击败沙漠之狼即可通过。";
				next;
				mes .@n$;
				mes "失败会自动从名单中除名，但你可以随意重试。";
				mes "准备好了吗？";
				next;
				switch(select("不:是")){
					case 1:
						mes .@n$;
						mes "改变主意后再回来。";
						close;
					case 2:
						mes .@n$;
						mes "通过测试后就能参加魔法大赛。";
						mes "那么，开始吧！";
						npctalk "限时 60 秒！准备！开始！";
						erasequest 9292;
						setquest 9293;
						addtimer 60000,instance_npcname("Receptionist#1_0et")+"::OnFail";
						monster instance_mapname("1@gef"),120,62,"--ja--",1106,1,instance_npcname("Receptionist#1_0et")+"::OnTest";
						hideonnpc instance_npcname("Receptionist#1_0et");	
						break;
				}
				end;
		}
		end;
	}
	
	if ( 'passtest == 1 ) {
	
		if ('GMT >= 5){
			mes .@n$;
			mes "魔法大赛即将开始。";
			mes "进入南方的传送门即可参加。";
			next;
			mes .@n$;
			mes "祝你好运！";
			end;
		}

malaya,290,340,3	script	Guard Leader#buwaya	571,{
	if (checkweight(1201,1) == 0 || MaxWeight - Weight < 2000) {
		mes "- 等等！-";
		mes "- 你携带的物品太多。-";
		mes "- 无法获得物品。-";
		mes "- 请清理你的物品 -";
		mes "- 再试一次。-";
		close;
	}
	if (malaya_hi < 20) {
		mes "- 他们一边窃窃私语，一边警惕地看着你。-";
		close;
	}
	if (malaya_buwaya < 10) {
		mes "[Guard Leader]";
		mes "由于梦魇的仆从正在攻击医院，我们忙得不可开交。";
		next;
		mes "[Guard Leader]";
		mes "我们会尽力确保村庄安全，请安心享受在马来亚港的时光。";
		next;
	}
	if (malaya_buwaya == 10) {
		if (select("告诉他布瓦亚的事。:谈话结束。") == 2) {
			close;
		}
		mes "[Guard Leader]";
		mes "布瓦亚？那个无情的生物回来了？";
		next;
		mes "[Guard Leader]";
		mes "这可不是好消息。我们已经派所有人对付梦魇，人员严重不足。";
		next;
		mes "[Guard Leader]";
		mes "村民还得去森林收集水果和蔬菜。";
		next;
		mes "[Guard Leader]";
		mes "嗯……你能帮助马来亚港吗？";
		next;
		if (select("交给我吧！:我自己也很忙。") == 2) {
			mes "[Guard Leader]";
			mes "真的吗？这可不好。如果我们不做些什么，村民的性命都会受到威胁。你这么年轻，怎么能如此无情？所有外来者都像你这样吗？哼！现在的年轻人真不可信。哼。";
			close;
		}
		mes "[Guard Leader]";
		mes "我就知道可以依靠你。";
		next;
		mes "[Guard Leader]";
		mes "很好。我会相信你。";
		mes "为了保护村民居住区，我需要知道布瓦亚可能出现的地方。";
		mes "布瓦亚的巢穴应该是最有可能的地点。";
		next;
		mes "[Guard Leader]";
		mes "到达区域后^3131FF发射烟雾弹^000000。";
		mes "我们会跑到烟雾弹发射的位置。";
		next;
		mes "[Guard Leader]";
		mes "保重，祝你好运。";
		set malaya_buwaya,11;
		erasequest 2276;
		setquest 2277;
	} else if (malaya_buwaya == 11) {
		mes "[Guard Leader]";
		mes "到达区域后^3131FF发射烟雾弹^000000。";
		mes "我们会跑到烟雾弹发射的位置。";
	} else if ((malaya_buwaya == 12) || (malaya_buwaya == 13)) {
		mes "[" + strcharinfo(0) + "]";
		mes "先把埃德带回给托托伊。";
	} else if (malaya_buwaya == 14) {
		mes "[Guard Leader]";
		mes "守卫队长告诉了你布瓦亚洞穴的位置。";
		mes "这不可能。";
		next;
		mes "[Guard Leader]";
		mes "我已经没有多余人手处理布瓦亚了，但我们必须用现有力量做点什么。";
		next;
		mes "[Guard Leader]";
		mes "来，这是我们的感谢。";
		mes "如果你愿意再次帮助对付布瓦亚，请来找我。";
		mes "祝你旅途愉快。";
		set malaya_buwaya,15;
		getexp 1000000, 600000;
		completequest 2280;
	} else {
		set .@hunting, checkquest(2281,HUNTING);
		if (.@hunting == -1) {
			mes "[Guard Leader]";
		mes "听说布瓦亚从森林深处出现了。";
		mes "众所周知，我们所有人手最近都被派去处理攻击医院的梦魇仆从。";
			next;
			mes "[Guard Leader]";
		mes "所以只能请求外来者帮助消灭布瓦亚。";
		mes "据说布瓦亚是有两个头、又强又丑的魔物。你愿意帮我们击败它吗？";
			next;
			if (select("当然。:不要。") == 2) {
				mes "[Guard Leader]";
				mes "布瓦亚是非常危险的魔物。拒绝请求并不可耻。";
				close;
			}
			if (BaseLevel < 130) {
				mes "[Guard Leader]";
				mes "这项任务很危险。";
				mes "如果你想帮忙消灭布瓦亚，必须做好准备。达到 130 级后再回来。";
				close;
			}
			mes "[Guard Leader]";
			mes "传说布瓦亚会绑架人，把他们放进背上的袋子里，之后再吃掉。";
			next;
			mes "[Guard Leader]";
			mes "记住这一点，随时保持警惕。我建议找可靠的同伴帮忙。";
			setquest 2281;
		} else if (.@hunting == 0 || .@hunting == 1) {
			mes "[Guard Leader]";
			mes "布瓦亚的情况进展如何？";
			next;
			if (select("我放弃。:继续战斗。") == 2) {
				mes "[Guard Leader]";
				mes "记住这一点，随时保持警惕。我建议找可靠的同伴帮忙。";
				close;
			}
			mes "[Guard Leader]";
			mes "布瓦亚是非常危险的魔物。拒绝请求并不可耻。";
			erasequest 2281;
		} else if (.@hunting == 2) {
			mes "[Guard Leader]";
			mes "真不敢相信你真的消灭了布瓦亚！";
			mes "你不是普通年轻人，对吧？马来亚港的人现在可以安睡了。";
			next;
			mes "[Guard Leader]";
			mes "干得好。";
			erasequest 2281;
			if (!VIP_SCRIPT || vip_status(VIP_STATUS_ACTIVE))
				getitem 6497,10; //Lesser_Agimat
			else
				getitem 6497,5; //Lesser_Agimat
			getexp 0,600000;
		} else {
			mes "[Guard Leader]";
			mes "在包括巴里奥·马希瓦加在内的整个马来亚港摆脱布瓦亚威胁前，我不会退缩。答应我照顾好自己。";
			erasequest 2281;
		}
	}
	close;
}


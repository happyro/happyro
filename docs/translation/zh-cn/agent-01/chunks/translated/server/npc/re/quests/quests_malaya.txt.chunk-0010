			next;
			mes "[Master of Hunting]";
			mes "据说布瓦亚经过后不会留下任何活物。";
			mes "托托伊真是个幸运的孩子。哇！";
			next;
			mes "[Master of Hunting]";
			mes "布瓦亚沉寂了很久。不知道它是不是在冬眠？嗯。";
			next;
			mes "[Master of Hunting]";
			mes "既然知道有那样的魔物存在，我也该小心。";
			mes "必须告诉村民别走进森林太深处。";
			next;
			mes "[Master of Hunting]";
			mes "请去告诉守卫队长布瓦亚又开始活动了。";
			mes "我会联系其他猎人，想办法消灭布瓦亚。";
			set malaya_buwaya,10;
			disablenpc "#buwaya_soil";
			erasequest 2275;
			setquest 2276;
		}
		close;
	}
	end;
OnInit:
	disablenpc "#buwaya_soil";
	end;
}

-	script	Unknown Trace#buwaya	-1,{
	if (checkweight(1201,1) == 0 || MaxWeight - Weight < 2000) {
		mes "- 等等！-";
		mes "- 你携带的物品太多。-";
		mes "- 无法获得物品。-";
		mes "- 请整理物品后再试。-";
		close;
	}
	if (malaya_buwaya == 7) {
		if (countitem(6519) >= 10) {
		mes "- 你不必再收集样本了。-";
			close;
		}
		mes "- 你看到有什么东西缠在泥土和草里。-";
		next;
		if (rand(1,10) <= 2) {
			mes "- 收集样本散发的恶臭让你感到恶心。-";
			sc_start SC_POISON,5000,0;
			close;
		}
		mes "- 你缓慢而谨慎地收集柔软、微温的物质。-";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "它像母亲的怀抱一样温暖。";
		getitem 6519,1; //Collected_Sample
		disablenpc();
		initnpctimer;
		close;
	}
	end;
OnTimer20000:
	enablenpc();
	stopnpctimer;
	end;
}

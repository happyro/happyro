ma_fild02,312,259,3	script	Dog#buwaya	81,{
	if (malaya_buwaya == 11) {
		mes "[Dog]";
		mes "汪汪！！";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "这里为什么有条狗？";
		next;
		if (select("仔细看看这条狗。:无视它。") == 2) {
			mes "[" + strcharinfo(0) + "]";
			mes "看起来像条走失的狗。";
			close;
		}
		mes "- 你仔细观察脏兮兮的狗，注意到它脖子上有条旧项圈。-";
		next;
		mes "- 项圈上写着‘永远和托托伊在一起’。-";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "你就是埃德？";
		next;
		mes "[Dog]";
		mes "汪汪！";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "你没有被布瓦亚杀死。你这幸运的小狗。我们回主人那里吧。";
		next;
		emotion ET_DELIGHT;
		mes "[Dog]";
		mes "汪汪！！";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "啊，出发前，你知道布瓦亚的巢穴在哪里吗？";
		next;
		mes "[Dog]";
		mes "汪！";
		next;
		mes "- 埃德是只聪明的狗，理解了你的问题，开始朝北方吠叫。-";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "布瓦亚就在那边！";
		mes "那我应该在这里发射烟雾弹。";
		next;
		mes "- 你从物品栏取出烟雾弹，朝天空发射。-";
		next;
		mes "^FF0000- 嗖——^000000";
		enablenpc "Guard#buwayacave";
		specialeffect2 EF_MVP;
		next;
		mes "[Guard]";
		mes "干得漂亮！原来布瓦亚住在这样的偏远地方。我会把消息报告给守卫队长！";
		disablenpc "Guard#buwayacave";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "我应该先把埃德送回托托伊，再去见守卫队长吗？";
		next;
		mes "[Dog]";
		mes "汪汪！";
		set malaya_buwaya,12;
		disablenpc "Dog#buwaya";
		erasequest 2277;
		setquest 2278;
		close;
	} else if (malaya_buwaya == 12) {
		mes "[" + strcharinfo(0) + "]";
		mes "先把埃德带回托托伊，再回去找守卫队长。";
		close;
	}
	end;
OnInit:
	disablenpc "Dog#buwaya";
	end;
}


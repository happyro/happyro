malaya,280,331,4	script	Singing Man#bako1	578,{
	if (malaya_bakona1 < 5) {
		mes "[Singing Man]";
		mes "住在湖里的龙的故事～";
		mes "以及很久以前变成龙的老妇人的故事～";
		next;
		mes "[Singing Man]";
		mes "等待远行异国的儿子，";
		mes "我的儿子会在月亮第 90 次落下时回来。";
		next;
		mes "[Singing Man]";
		mes "月亮第 89 次落下，";
		mes "月亮第 90 次落下，";
		mes "月亮第 191 次落下……";
		next;
		mes "[Singing Man]";
		mes "那个月亮夺走了我的儿子～";
		mes "那个可怕的东西";
		mes "吞掉了我的儿子，";
		mes "我要惩罚那个该死的月亮～";
		next;
		mes "[Singing Man]";
		mes "愤怒的月亮藏起来的那天，";
		mes "整个世界都会被雨水淹没，";
		mes "所有村庄和人们都将在水下死亡～";
		next;
		mes "[Singing Man]";
		mes "老妇人的诅咒让月亮暴怒～";
		mes "除掉老妇人，让月亮平静下来～";
		mes "要是老妇人不在这里就好了，要是她不在这里……";
		next;
		mes "[Singing Man]";
		mes "我听到了传闻～";
		mes "老妇人跳进了湖里～";
		mes "现在变成龙的她会吞掉月亮，";
		mes "很快也会吞掉村庄～";
		close;
	} else {
		mes "[Singing Man]";
		mes "你说传说全是谎言？";
		mes "你是说我的祖先都是骗子和诈骗犯？";
		next;
		mes "[Singing Man]";
		mes "这个村庄建立在古老的传说和历史之上。";
		mes "他们不会被你这样的蠢货说的胡话动摇。";
		close;
	}
}

malaya,275,333,5	script	Singing Woman#bako1	579,{
	if (malaya_bakona1 < 5) {
		mes "[Singing Woman]";
		mes "住在湖里的巴库纳瓦，";
		mes "以及变成龙的老妇人的故事。";
		next;
		mes "[Singing Woman]";
		mes "本应在月亮第 90 次落下后回来的儿子，";
		mes "即使月亮落下数百次也没有回来～";
		mes "月亮吞掉了老妇人的儿子～";
		next;
		mes "[Singing Woman]";
		mes "月亮，月亮，你将承受老妇人的诅咒～";
		mes "整个村庄都被愤怒月亮带来的雨水和洪水笼罩在死亡中～";
		next;
		mes "[Singing Woman]";
		mes "月亮，月亮，请安静平和，";
		mes "老妇人已经离去，不复存在～";
		mes "老妇人淹死在湖里～";
		mes "她会变成巴库纳瓦回来……";
		next;
		mes "[Singing Woman]";
		mes "……吞掉你们，";
		mes "很快惩罚村庄～";
		mes "月亮死去的那天，";
		mes "也是村庄灭亡的那天～";
		close;
	} else {
		mes "[Singing Woman]";
		mes "传说全是谎言？";
		mes "你为什么说这种胡话？";
		mes "难道没有什么值得你保护的吗？";
		next;
		mes "[Singing Woman]";
		mes "可怜的巴库纳瓦……";
		mes "如果她狠狠咬你这种人一口，我会很高兴！";
		close;
	}
}

malaya,290,329,4	script	Frightened Boy#bako1	577,{
	if (malaya_hi < 20) {
		mes "- 他似乎对你有所戒备。-";
		close;
	}
	if (malaya_bakona1 < 5) {
		mes "[Frightened Boy]";
		mes "凶恶的魔物巴库纳瓦很快就会出现，吞掉月亮并向村庄复仇。";
		mes "我好害怕，救救我……";
		close;
	} else {
		mes "[Frightened Boy]";
		mes "巴库纳瓦的传说全是谎言？";
		mes "那就是说巴库纳瓦不存在？";
		mes "那我待会儿要去湖边和朋友玩。";
		mes "你说这全是谎言，对吧？";
		close;
	}
}

malaya,264,338,4	script	Frightened Maiden#bako1	576,{
	if (malaya_hi < 20) {
		mes "- 她似乎对你有所戒备。-";
		close;
	}
	if (malaya_bakona1 < 5) {
		mes "[Frightened Maiden]";
		mes "据说巴库纳瓦讨厌巨大的声响。";
		mes "想活命就敲锅！";
		next;
		switch(select("讨厌巨大声响？:巴库纳瓦是什么？")) {
		case 1:
			mes "[Frightened Maiden]";
			mes "你已经听说老妇人死后变成巴库纳瓦了，对吧？";
			next;
			mes "[Frightened Maiden]";
			mes "传说老妇人的听力非常敏锐，";
			mes "因为她一直专注等待远行儿子归来。";
			next;
			mes "[Frightened Maiden]";
			mes "自然，巴库纳瓦也有敏锐的听力。";
			mes "大家敲锅敲盆就是因为这个。";
			close;
		case 2:
			mes "[Frightened Maiden]";
			mes "那是住在湖里的可怕魔物。";
			mes "我们都害怕得发抖，因为不知道它什么时候会袭击村庄。";
			next;
			mes "[Frightened Maiden]";
			mes "有人说它更执着于吞掉月亮，而不是袭击村庄。";
			mes "如果真是这样，我希望它赶紧吞掉月亮，别来烦我们。";
			close;
		}
	} else {
		mes "[Frightened Maiden]";
		mes "村民现在都讨厌你。";
		mes "你一直说巴库纳瓦的传说是谎言，他们说你比巴库纳瓦更像魔物。";
		close;
	}
}

malaya,272,339,5	script	Old Fortune Teller#bako1	575,{
	if (malaya_hi < 20) {
		mes "- 老算命师似乎对你有所戒备。-";
		close;
	}
	if (malaya_bakona1 < 5) {
		mes "[Old Fortune Teller]";
		mes "你不能憎恨巴库纳瓦。";
		mes "对它的憎恨只会助长它的愤怒，让它变得更强。";
		next;
		mes "[Old Fortune Teller]";
		mes "要平息死去老妇人的愤怒，";
//
//

//===== rAthena Script =======================================
//= Valentine's Day Event (2012)
//===== By: ==================================================
//= Rikimaru
//===== Current Version: =====================================
//= 1.1
//===== Compatible With: =====================================
//= rAthena Project
//===== Description: =========================================
//= The full Valentine's Day NPCs of the Valentine's Day
//= Event 2012 (account-based).
//===== Additional Comments: =================================
//= 1.0 First version. [Rikimaru]
//= 1.1 Standardized and fixed. [Euphy]
//============================================================

mosk_in,21,246,5	script	Pinkamenia	71,{
	set .@n$,"^0000FF[Pinkamenia]^000000";
	if (#V_QUE12==3) {
		set .@LFlowerID,7864;
		setarray .@SweetsID[0],538,558,539,573,559,560,12062,596,597,12414,12319;
		setarray .@SweetsCost[0],1,2,5,10,10,10,15,15,15,20,20;
		mes .@n$;
		mes "你好，"+strcharinfo(0)+"，想买些物品吗？";
		mes "当然，你需要用爱情之花支付！";
		next;
		if(select("好的！","不了，算了。") == 2) close;
		next;
		mes .@n$;
		mes "选择物品。";
		mes "所需爱情之花数量显示在括号内。";
		for(set .@i,0; .@i < getarraysize(.@SweetsID); set .@i,.@i+1)
		set .@menu$, .@menu$+"^00AA00["+.@SweetsCost[.@i]+"]^000000 "+getitemname(.@SweetsID[.@i])+":";
		next;
			set .@choice, select(.@menu$)-1;
		mes .@n$;
		if (countitem(.@LFlowerID) < .@SweetsCost[.@choice]) {
		mes "想要那个就需要更多爱情之花！";
		close;
			}
			mes "确定要用 ^00aa00"+.@SweetsCost[.@choice]+" 朵爱情之花^000000 交换 ^0055FF"+getitemname(.@SweetsID[.@choice])+"^000000 吗？";
		if(select("不，我改变主意了。:是的，交换！") == 1) close;
		set .@new, .@LFlowerID - .@SweetsCost[.@choice];
		if (.@new < 0) set .@new, 0;
		delitem .@LFlowerID, .@SweetsCost[.@choice];
		getitem .@SweetsID[.@choice],1;
		mes "祝你使用愉快！";
		close;
		} else if (#V_QUE12==2) {
		mes .@n$;
	if (countitem(7864) < 15) {
		mes "你必须带来 15 朵爱情之花！";
		close;
			}
			mes "非常感谢你";
		mes "找回我们的花！";
		delitem 7864,15;
		next;
		mes .@n$;
		mes "请收下这个小礼物。";
		mes "‘谢谢’。";
		getexp 500000,400000;
		getitem 617,1;
		getitem 12319,2;
		next;
		mes .@n$;
		mes "如果你得到更多爱情之花，";
		mes "可以在这里交换甜点。";
		mes "很快再见！";
		set #V_QUE12,3;
		close;
		} else if (#V_QUE12==1) {
		mes .@n$;
		mes "请把 +8 蛋糕帽";
	mes "交给站在我旁边的";
		mes "糕点大师！";
		close;
		} else if (BaseLevel >= 45) {
		mes .@n$;
		mes "你好，"+strcharinfo(0)+"，今天是情人节，";
	mes "我们喜欢赠送甜美的巧克力。";
		next;
		mes .@n$;
		mes "问题是我们需要像你这样强大的人帮助，";
		mes "但首先要把 +8 蛋糕帽交给";
		mes "站在我旁边的糕点大师！";
		set #V_QUE12,1;
		close;
		}
		mes .@n$;
		mes "你好，"+strcharinfo(0)+"！";
		close;
		
		OnInit:
		// Unknown item drop rate (currently set at 5%)
		setitemscript 5105,"{ bonus bDex,1; bonus bMaxSP,80; bonus3 bAddMonsterDropItem,7864,RC_DemiHuman,500; }",0;
		end;
	}
	+ 
	
	


	
	
	



	
	
		
		
		mosk_in,21,244,3	script	Baker Extraordinaire	410,{
	set .@n$,"^0000FF[Baker Extraordinaire]^000000";
		if(#V_QUE12==3) {
		mes .@n$;
		mes "和 Pinkamenia 交换爱情之花！";
	close;
		} else if(#V_QUE12==2) {
		mes .@n$;
			mes "带 15 朵爱情之花给 Pinkamenia！";
			close;
			} else if(#V_QUE12==1) { 
			mes .@n$;
			if (getequipid(EQI_HEAD_TOP) == 5024 && getequiprefinerycnt(EQI_HEAD_TOP) >= 8) {
			mes "啊，Pinkamenia 让你带来 +8 蛋糕帽。";
			mes "现在我要把你的 +8 蛋糕帽";
			mes "交换成另一顶蛋糕帽。";
			next;
			mes .@n$;
			delitem 5024,1;
			getitem 5105,1;
			equip 5105;
			mes "现在，如果你戴上新蛋糕帽，";
			mes "半人形怪物就有机会";
			mes "掉落爱情之花！";
			next;
			mes .@n$;
			mes "怪物偷走了我们的花，";
			mes "而我们需要它们制作巧克力。";
			mes "现在把花";
		mes "15 朵爱情花并带来";
			mes "交给 Pinkamenia！";
			set #V_QUE12,2;
		close;
			} else {
			mes "抱歉，但你的蛋糕帽在哪里？";
			mes "+8 Cake Hat? Bring";
			mes "把它交给我，记得要装备它！";
			close;
		}
	} else {
		mes .@n$;
		mes "你好，"+strcharinfo(0)+"！";
		close;
	}
}

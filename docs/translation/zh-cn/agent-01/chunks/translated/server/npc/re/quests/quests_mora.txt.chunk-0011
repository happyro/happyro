		setquest 12244;
		setquest 12253;
		mes "^66006619 岁。乘船从遥远未知之地而来的冒险家。尽管莫拉居民劝阻，他仍穿着薄紧身衣前往迷宫探险，已经失踪 2 个月。";
		mes "即使还活着，也会给救援队添麻烦。^000000";
		set .@n$,"Niger";
		break;
	case 3:
		setquest 12245;
		setquest 12253;
		mes "^660066年龄不详。患有某种精神疾病。独自前往朦胧森林的迷宫，声称要净化那里。他坚持说自己出身高贵，但没人相信。";
		mes "失踪时间：12 年。生还可能性很低。^000000";
		set .@n$,"Messil";
		break;
	case 4:
		setquest 12246;
		setquest 12253;
		mes "^66006651 岁。曾是从世界各地偷取名剑的大盗。";
		mes "晚年经营非法赌场造成大量伤亡，遭到追捕后在迷宫失踪。生还可能性很低。^000000";
		set .@n$,"Noirit";
		break;
	case 5:
		setquest 12247;
		setquest 12253;
		mes "^66006622 岁。飞艇驾驶员的学徒，去莫拉镇休息时喝酒后失踪。";
		mes "据说他在某处签名后逃走了。失踪时间：4 个月。生还可能性很低。^000000";
		set .@n$,"Pajama Sin";
		break;
	case 6:
		setquest 12248;
		setquest 12253;
		mes "^660066年龄不详。黑衣长发女性。为寻找永生前往迷宫森林探险。失踪时间：3 个月。生还可能性很低。^000000";
		set .@n$,"Mendel";
		break;
	case 7:
		setquest 12249;
		setquest 12253;
		mes "^660066约 50 岁。莫拉村现任村长。因欺骗居民中饱私囊被发现后逃往迷宫森林。生死不明。^000000";
		set .@n$,"Milebit";
		break;
	case 8:
		setquest 12250;
		setquest 12253;
		mes "^66006629 岁。身世不明的年轻男子。";
		mes "假装在莫拉创业并融入当地，骗走居民 1200 枚莫拉硬币后逃往迷宫森林。生死不明。^000000";
		set .@n$,"Kunmoon";
		break;
	case 9:
		setquest 12251;
		setquest 12253;
		mes "^66006634 岁。在莫拉与多名女性调情后，从村民手中逃往迷宫森林。生死不明。^000000";
		set .@n$,"Chaihokin";
		break;
	case 10:
		setquest 12252;
		setquest 12253;
		mes "^660066年龄不详。带着村民共同管理的硬币失踪。生还可能性很低。^000000";
		set .@n$,"Tual";
		break;
	}
	next;
	mes "^990099已找到失踪者 "+.@n$+"^000000 的信息。请查看任务窗口了解详情。";
	specialeffect2 EF_STEAL;
	close;
}


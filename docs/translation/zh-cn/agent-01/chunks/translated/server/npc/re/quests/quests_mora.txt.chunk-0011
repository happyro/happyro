mora,118,166,6	script	Knights Chief#mo	525,{
	mes "[邻里骑士团首领]";
	mes "我们是传说中的邻里骑士团，才成立了五分钟！";
	next;
	mes "[邻里骑士团首领]";
	mes "我们有四个首领，却没有一个士兵……";
	mes "真让人头疼！";
	next;
	mes "[其他首领]";
	mes "那些家伙都是士兵，但我是老大！";
	mes "我是首领，我来告诉你该做什么！";
	mes "领导者才是最高职位！";
	mes "你劝我加入骑士团，现在看看变成什么样了！";
	close;
}

mora,116,165,5	script	Knights Boss#mo	524,{
	set .@playtime, checkquest(1119,PLAYTIME);
	if (.@playtime == 0 || .@playtime == 1) {
		mes "[邻里骑士团老大]";
		mes "莫拉硬币用完了。";
		mes "明天再来吧！";
		close;
	} else if (.@playtime == 2)
		erasequest 1119;
	if (checkweight(6380,1) == 0) {
		mes "[邻里骑士团老大]";
		mes "你带了好多东西！";
		mes "为什么不把一些放进我的口袋？";
		close;
	}
	if (countitem(12561) >= 200) {
		mes "[邻里骑士团老大]";
		mes "你带回了 200 个";
		mes "^FF0000神秘种子^000000。";
		mes "你是在听我指挥吗？";
		mes "我真糊涂，";
		mes "一直把陌生人派去跑腿。";
		next;
		mes "[邻里骑士团老大]";
		mes "我会按承诺奖励你。";
		mes "你已经让所有人知道";
		mes "这是邻里骑士团的功劳了吧？";
		setquest 1119;
		delitem 12561,200; //Mysterious_Seed
		getitem 6380,1; //Mora_Coin
		close;
	}
	mes "[邻里骑士团老大]";
	mes "你突然出现，";
	mes "还敢开口要莫拉硬币……真有胆量！";
	mes "你的勇气令人印象深刻！";
	mes "你完全有资格成为邻里骑士团的士兵。";
	next;
	mes "[邻里骑士团老大]";
	mes "士兵，我需要你帮我做件事。";
	mes "去朦胧森林收集 200 个^FF0000神秘种子^000000！";
	next;
	switch(select("是，长官！:我向你挑战！")) {
	case 1:
		mes "[邻里骑士团老大]";
		mes "态度不错，"+strcharinfo(0)+"士兵！";
		mes "回来后我会好好奖励你。";
		next;
		mes "[其他老大]";
		mes "这是我的心意，我是首领！";
		mes "别小看首领！";
		mes "这是我的心意，我是领导者！";
		close;
	case 2:
		mes "[邻里骑士团老大]";
		mes "想决斗就去找首领！";
		mes "这里由我负责招募。";
		mes "咳咳……";
		close;
	}
}

mora,114,163,5	script	Knights Head#mo	522,{
	if (checkweight(6380,1) == 0) {
		mes "[邻里骑士团团长]";
		mes "你带了好多东西！";
		mes "为什么不把一些放进我的口袋？";
		close;
	}
	if (ep14_1_rope < 11) {
		mes "[邻里骑士团团长]";
		mes "听说有个叫‘洛普’的拉斐内";
		mes "在朦胧森林失踪了。";
		mes "我希望邻里骑士团";
		next;
		mes "[邻里骑士团团长]";
		mes "能帮忙解决这件事，";
		mes "但我们现在做不到，";
		mes "因为院子还没打扫完。";
		mes "所以我的意思是，";
		next;
		mes "[邻里骑士团团长]";
		mes "你为什么不代表";
		mes "邻里骑士团去";
		mes "解决这个问题呢？";
		next;
		mes "[邻里骑士团团长]";
		mes "我以骑士团团长的身份保证，";
		mes "等你回来后";
		mes "我会给你更多工作！";
		next;
		mes "[其他团长]";
		mes "我以首领身份批准了。";
		mes "你该感谢我这个老大。";
		mes "你知道这里的领导者才是老大吧？";
		close;
	} else if (ep14_1_rope == 11) {
		mes "[邻里骑士团团长]";
		mes "所以失踪的拉斐内";
		mes "已经死了吗？";
		mes "听到这个消息我很遗憾。";
		mes "我本来可以救他的。";
		next;
		mes "[邻里骑士团团长]";
		mes "听说朦胧森林里还有更多^0000FF洛普的线索^000000。";
		mes "去找回剩下的线索，";
		mes "带回大约 30 个。";
		mes "它们可以做成很棒的纪念品。";
		mes "这也是为了调查真相。";
		next;
		switch(select("这里的工作都是我做的吗？:是，长官！")) {
		case 1:
			mes "[邻里骑士团团长]";
			mes "你注意到了吗？";
			mes "该死！我早该给你安排工作的！";
			close;
		case 2:
			mes "[邻里骑士团团长]";
			mes "看来训练你还是值得的。";
			mes "我为你骄傲，"+strcharinfo(0)+"士兵！";
			next;
			mes "[其他团长]";
			mes "首领，我觉得你会成为很棒的副手。";
			mes "作为老大，我感到很欣慰。";
			mes "作为领导者，看到大家进步我很高兴。";
			set ep14_1_rope,12;
			setquest 1118;
			close;
		}
	} else if (ep14_1_rope == 12) {
		if (countitem(6383) < 30) {
			mes "[邻里骑士团团长]";
			mes "你还没收集到";
			mes "^0000FF洛普的线索^000000吗？";
			mes "我倒觉得挺欣慰，";
			mes "因为这正是我对你的期待。";
			close;
		}
		mes "[邻里骑士团团长]";
		mes "所以你带回了^0000FF洛普的线索^000000。";
		mes "让我看看……";
		mes "拼起来，拼起来。";
		mes "接上，接上。";
		next;
		mes "[洛普的信]";
		mes "……旅行者……遭到袭击……";
		mes "……伪装之下……致命毒药……";
		mes "……村庄……陷入危险……";
		next;
		mes "[邻里骑士团团长]";
		mes "这到底是什么意思？";
		mes "总之，做得好。";
		mes "振作起来，总有一天你会像我一样成为优秀的骑士团团长。";
		next;
		mes "[其他团长]";
		mes "我可不这么认为！";
		mes "这对我们来说太难了。";
		mes "努力也没用。";
		completequest 1118;
		delitem 6383,30; //Clue_Of_Lope
		set ep14_1_rope,13;
		getitem 6380,2; //Mora_Coin
		getexp 1000000,1000000;
		close;
	} else if (ep14_1_rope > 12) {
		mes "[邻里骑士团团长]";
		mes "我们遇到麻烦了。";
		mes "我们已经当腻了骑士。";
		mes "我们在考虑组建";
		mes "一个马戏团。";
		mes "你有兴趣试试走钢丝吗？";
		next;
		switch(select("我可以表演火焰秀。:这太荒唐了。")) {
		case 1:
			mes "[邻里骑士团团长]";
			mes "不行，那不可能。";
			mes "我玩火时烧掉过几栋房子。";
			mes "还是别尝试了。";
			close;
		case 2:
			mes "[邻里骑士团团长]";
			mes "这正是我预料的答案。";
			mes "我真为自己感到骄傲。";
			close;
		}
		close;
	}
	end;
}

mora,112,161,5	script	Knights Leader#mo	523,{
	mes "[邻里骑士团领导者]";
	mes "我是骑士团的领导者——";
	mes "你可以告诉我。";
	mes "你来这里做什么？有工作要交给我们吗？";
	next;
	mes "[其他领导者]";
	mes "什么！我说老大才是老大！";
	mes "不，首领才是最棒的！";
	mes "你们真没礼貌！这里我是团长！";
	emotion ET_PROFUSELY_SWEAT, playerattached();
	close;
}

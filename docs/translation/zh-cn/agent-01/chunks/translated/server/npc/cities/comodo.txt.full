cmd_fild04,188,74,4	script	Zyosegirl#cmd	93,{
	mes "[Zyosegirl]";
	mes "人们叫我海之女士，";
	mes "因为我一直在这里工作，";
	mes "收集蛤蜊和其他海洋生物";
	mes "出售。";
	mes "其实这生活还不错。";
	next;
	mes "[Zyosegirl]";
	mes "能在户外工作很棒，";
	mes "但总有一天我想攒够钱";
	mes "搬到城市。我还年轻，";
	mes "还有想实现的梦想~";
	close;
}

cmd_fild04,248,86,4	script	Ziyaol#cmd	709,{
	mes "[Ziyaol]";
	mes "啊，当渔夫真不错。";
	mes "你只需放松，让鱼自己上钩。";
	mes "当然，毫不费力地捕到这么多鱼，";
	mes "还是需要一些技巧~";
	next;
	mes "[Ziyaol]";
	mes "我喜欢这份工作的悠闲，";
	mes "但总有这样那样的问题。";
	mes "比如那边的女儿，";
	mes "一直唠叨要搬去大城市。";
	next;
	mes "[Ziyaol]";
	mes "她为什么这么想离开我？！";
	mes "但如果不让她走，她会逃跑。";
	mes "我该拿那孩子怎么办？";
	mes "我不能阻止她追逐梦想……";
	close;
}

cmd_fild04,267,137,4	script	Daeguro#cmd	703,{
	mes "[Daeguro]";
	mes "我喜欢在沙滩上玩——";
	mes "沙子柔软、干净又漂亮！";
	mes "但长大后，";
	mes "我想去艾尔贝塔尽情看看！";
	close;
}

cmd_fild07,192,58,4	script	Rahasu#cmd	100,{
	mes "[Rahasu]";
	mes "你好，我是拉哈苏。";
	mes "如果你想了解更多";
	mes "帕罗斯灯塔的信息，";
	mes "我可以为你介绍一些";
	mes "我很乐意告诉你。";
	next;
	if (select("帕罗斯灯塔？：取消") == 1) {
		mes "[Rahasu]";
		mes "许多年来，这座灯塔";
		mes "引导船只靠岸。";
		mes "那是很久以前了；";
		mes "那已经是很久以前的事了，";
		mes "如今灯塔静静矗立，";
		mes "无人使用，却从未被遗忘。";
		next;
		mes "[Rahasu]";
		mes "这里虽然不再是昔日的";
		mes "贸易商业中心，";
		mes "也不再像过去那样繁忙，";
		mes "仍有许多人来到这片区域。";
		mes "我确实很好奇原因……";
		close;
	}
	mes "[Rahasu]";
	mes "嘿，离开前，";
	mes "你真的应该看看";
	mes "灯塔的景色。";
	mes "那景色……令人屏息……";
	close;
}

cmd_fild07,52,280,4	script	Hallosu#cmd	100,{
	mes "[Hallosu]";
	mes "你好，这里是组成帕罗斯灯塔的";
	mes "众多灯塔之一。";
	mes "不过，";
	mes "目前正在翻修，";
	mes "所以不对公众开放。";
	close;
}

cmd_fild07,299,83,4	script	Zain#cmd	100,{
	set .@n$,"["+strnpcinfo(1)+"]";
	mes .@n$;
	mes "要乘坐瑞德鲁斯航线的船吗？";
	mes "你可以乘瑞德鲁斯";
	mes "前往艾尔贝塔";
	mes "或";
	mes "依斯鲁得。";
	next;
	switch(select("艾尔贝塔 - 600 Zeny：依斯鲁得 - 800 Zeny：取消")) {
	case 1:
		if (Zeny < 600) break;
		set Zeny, Zeny-600;
		warp "alberta",192,169;
		end;
	case 2:
		if (Zeny < 800) break;
		set Zeny, Zeny-800;
		if(checkre(0))
			warp "izlude",195,212;
		else
			warp "izlude",176,182;
		end;
	case 3:
		mes .@n$;
		mes "乘船仍是最安全可靠的";
		mes "交通方式之一。";
		mes "欢迎你";
		mes "快来体验";
		mes "瑞德鲁斯航线~";
		close;
	}
	mes .@n$;
	mes "抱歉，你没有足够的";
	mes "Zeny";
	mes "支付乘船费用。";
	close;
}
cmd_fild07,94,134,4	duplicate(Zain#cmd)	Sarumane#cmd	100

cmd_in02,146,180,4	script	Kafra Employee::kaf_comodo2	721,{
	cutin "kafra_07",2;
	mes "[Kafra Misty]";
	mes "欢迎来到";
	mes "卡普拉公司。";
	mes "你知道我们的";
	mes "服务永远";
	mes "站在你这边~";
	next;
	mes "[Kafra Misty]";
	mes "卡普拉公司西部部门";
	mes "承诺提供最高质量的";
	mes "服务，";
	mes "强调可靠性和";
	mes "顾客";
	mes "满意。";
	mes "感谢你的光临~";
	close2;
	cutin "", 255;
	end;
}


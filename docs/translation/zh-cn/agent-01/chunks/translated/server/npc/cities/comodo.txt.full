cmd_in02,73,81,4	script	Martine#cmd	48,{
	mes "[Martine]";
	mes "赌博……？";
	mes "科莫多赌场";
	mes "提供的游戏是";
	mes "比赌博更高级的娱乐。";
	mes "你明白我的意思吗？";
	next;
	mes "[Martine]";
	mes "没错，我在赌场输了所有 Zeny，";
	mes "但我不后悔。";
	mes "我会赚更多钱，";
	mes "然后再全部输掉。";
	mes "我会再赚更多钱，";
	mes "或者我也许会赢一大笔！";
	next;
	mes "[Martine]";
	mes "哇哈哈哈哈~！";
	mes "我只要继续输，";
	mes "直到中大奖！";
	mes "你看，你看？我是在赌概率。";
	mes "总有一天我会赢！";
	close;
}

cmd_in02,48,55,4	script	Scoursege#cmd	51,{
	mes "[Scoursege]";
	mes "该死！那家伙去哪了？";
	mes "他答应轻松把我的钱翻倍！";
	mes "等等。哦，等等。";
	mes "哦……糟了……";
	next;
	mes "[Scoursege]";
	mes "别告诉我我刚被骗走了钱！";
	mes "糟糕！不过我最好还是";
	mes "向有关部门报告，";
	mes "有关部门报告，不管多丢脸……";
	close;
}

cmd_in02,64,43,4	script	Roberto#cmd	709,{
	mes "[Roberto]";
	mes "嘿嘿嘿……";
	mes "真是个容易上当的家伙。";
	mes "我轻易就拿到了他的钱！";
	mes "我甚至没编出";
	mes "多高明的谎言，";
	mes "他就把钱给我了！";
	close;
}

cmd_in02,89,72,4	script	Deniroz#cmd	89,{
	mes "[Deniroz]";
	mes "只要这颗";
	mes "小钢珠";
	mes "落进正确的洞里，";
	mes "我就能中大奖。";
	mes "好，";
	mes "最后再来一次……";
	next;
	mes "[Deniroz]";
	mes "不！不，我差一点就成功了！";
	mes "好，下次一定更接近，对吧？";
	mes "这次真的是最后一次。";
	mes "不，再来一次！好，";
	mes "就、就再一次……";
	mes "我不能放弃。";
	close;
}

cmd_in02,178,92,4	script	Shalone#cmd	101,{
	mes "[Shalone]";
	mes "哦，先生，抱歉，";
	mes "看起来你又输了。";
	mes "也许现在该停手了……";
	mes "你最近的运气";
	mes "真的很差……";
	close;
}

cmd_in02,178,86,4	script	Stonae#cmd	98,{
	mes "[Stonae]";
	mes "不、不……";
	mes "我又输了？！";
	mes "但我不能就这样放弃！";
	mes "我要继续，";
	mes "我要成为赢家";
	mes "离开这里！";
	close;
}

cmd_in02,172,105,4	script	G . J#cmd	86,{
	mes "[G . J]";
	mes "我越想越觉得，";
	mes "通过工作、储蓄和明智投资致富，";
	mes "比依靠巨额头奖";
	mes "更容易，";
	mes "对吧……";
	next;
	mes "[G . J]";
	mes "赌博似乎很有趣，";
	mes "但通过其他方式赚钱更明智。";
	mes "努力工作当然不有趣，";
	mes "但可以用钱赚更多钱，";
	mes "对吧？";
	next;
	mes "[G . J]";
	mes "还要聪明负责地管理钱财——";
	mes "我的意思是，赢来的钱更容易";
	mes "被你全部花掉，";
	mes "对吧？所以你必须始终保持明智……";
	close;
}

cmd_in02,174,126,4	script	Loyar#cmd	83,{
	mes "[Loyar]";
	mes "科莫多赌场的室内设计";
	mes "赏心悦目，干净又简洁。";
	mes "这里的气氛完美，";
	mes "令人感到十分舒适，";
	mes "让我想再玩一会儿。";
	mes "好，走吧！";
	next;
	switch(rand(1,3)) {
	case 1:
		mes "[Loyar]";
		mes "嗯……也许我该早点回家。";
		mes "我还没花完为赌博存的钱，";
		mes "还剩下一些钱，";
		mes "但在外面待太久";
		mes "可不好。";
		close;
	case 2:
		mes "[Loyar]";
		mes "我得承认，这里的气氛";
		mes "既刺激又令人上瘾。";
		mes "即使疲惫，";
		mes "这里的活力";
		mes "也会让人精神振奋，";
		mes "也会感染你，";
		mes "知道吗？";
		next;
		mes "[Loyar]";
		mes "虽然这种地方可能会让";
		mes "有严重赌博问题的人更加沉迷，";
		mes "但在这里赌博";
		mes "比在";
		mes "其他地方要安全一些，";
		mes "肮脏可疑的地方好多了。";
		close;
	case 3:
		mes "[Loyar]";
		mes "等等等等……";
		mes "那家伙为什么下注？";
		mes "真是个菜鸟……";
		mes "呃，我猜你不太了解这个游戏。";
		mes "不过没关系，慢慢学习吧。";
		mes "至于我，我只是个粉丝~";
		next;
		mes "[Loyar]";
		mes "我很喜欢这些游戏，";
		mes "但我更喜欢获胜！";
		mes "不过我足够明智，";
		mes "知道什么时候";
		mes "该停手，";
		mes "不会参加那些高风险游戏。";
		close;
	}
}

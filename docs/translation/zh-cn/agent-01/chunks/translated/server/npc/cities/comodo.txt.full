moc_fild12,35,303,4	script	Serutero#cmd	59,{
	mes "[Serutero]";
	mes "你好，我是塞鲁特罗，";
	mes "守卫通往桑达鲁曼";
	mes "要塞的道路。";
	mes "如果你真的想去那里，";
	mes "我会允许你继续，但要小心危险……";
	next;
	switch(select("我要去那里！：桑达鲁曼要塞？：取消")) {
	case 1:
		mes "[Serutero]";
		mes "你真的要去";
		mes "桑达鲁曼要塞。";
		mes "好吧，祝你好运，";
		mes "小心行事！";
		close2;
		warp "cmd_fild08",331,319;
		end;
	case 2:
		mes "[Serutero]";
		mes "桑达鲁曼要塞现在充满怪物，";
		mes "但曾经是人们居住的";
		mes "省份。";
		mes "不过那里总是遭到";
		mes "入侵和掠夺。";
		next;
		mes "[Serutero]";
		mes "桑达鲁曼居民最终适应了入侵，";
		mes "发展出烟雾信号和防御工事，";
		mes "以抵御战争的破坏。";
		mes "后来，科莫多";
		mes "建成了……";
		next;
		mes "[Serutero]";
		mes "科莫多逐渐增强力量和影响力，";
		mes "最终吞并了桑达鲁曼。";
		mes "越来越多的人";
		mes "从要塞搬到科莫多，";
		mes "直到桑达鲁曼要塞";
		mes "基本被废弃。";
		next;
		mes "[Serutero]";
		mes "桑达鲁曼还剩下一些人，";
		mes "但他们发动了叛乱，";
		mes "一个新政府";
		mes "在那里掌权。";
		mes "怪物趁机接管了一切……";
		next;
		mes "[Serutero]";
		mes "现在桑达鲁曼周围什么都没有。";
		mes "嗯，除了西南方的";
		mes "帕罗斯灯塔，";
		mes "那里可能会吸引";
		mes "想成为流氓的冒险者……";
		close;
	case 3:
		mes "[Serutero]";
		mes "如果旅行累了，";
		mes "可以在 ^3355FF科莫多^000000";
		mes "休息。";
		mes "那里是很受欢迎的旅游景点，";
		mes "特别适合";
		mes "冒险者。";
		close;
	}
}

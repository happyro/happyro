cmd_in02,57,62,4	script	Moo#cmd	109,{
	mes "[Moo]";
	if (rand(1,10) == 1) {
		mes "那些作弊的混蛋！";
		mes "他们再也不敢露脸，";
		mes "否则就得换张脸！";
		mes "哦——抱歉，";
		mes "我没看到你~哈哈哈~";
		close;
	}
	mes "你好，我是穆，";
	mes "科莫多赌场的经理。";
	mes "我们为服务顾客需求";
	mes "感到自豪，";
	mes "会尽力让你的来访难忘。";
	next;
	mes "[Moo]";
	mes "所有客人都可以享受普通游戏区，";
	mes "我们还提供";
	mes "VIP 区，";
	mes "让大赌客体验刺激的高额游戏。";
	next;
	mes "[Moo]";
	mes "我们一直欢迎你的建议，";
	mes "也一直努力改善你在";
	mes "科莫多赌场的";
	mes "体验。";
	close;
}


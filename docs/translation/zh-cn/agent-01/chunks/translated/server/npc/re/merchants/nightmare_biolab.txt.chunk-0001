//===== rAthena Script =======================================
//= Nightmare Biolab NPCs
//===== Description: =========================================
//= [Walkthrough Conversion]
//= Nightmare Biolab exchange NPCs
//  NOTE: The nightmare biolab monsters are currently missing
//  some items used in the file.
//    Silent Energy Particles (ID: 25127)
//    Weak Energy Particles (ID: 25128)
//    Unstable Energy Particles (ID: 25129)
//    Sinister Energy Particles (ID: 25130)
//    Cursed Crystal (ID: 23080)
//===== Changelogs: ==========================================
//= 1.0 First version. [Capuche]
//= 1.1 Added some missing warp points and lore pieces [akaineko]
//= 1.2 Added the new enchant and update the enchant rates [Haydrich]
//============================================================

// Item Functions
//============================================================
function	script	F_Pieces_Of_Sentiment	{	// 22687
	if (strcharinfo(3) == "lhz_dun_n")// usage forbidden on the same map
		return;
	specialeffect2 EF_HIT4;
	.@r = rand(1,23);
	if (.@r == 1)
		warp "lhz_dun_n",140,89;
	else if (.@r == 2)
		warp "lhz_dun_n",75,138;
	else if (.@r == 3)
		warp "lhz_dun_n",198,151;
	else if (.@r == 4)
		warp "lhz_dun_n",200,189;
	else if (.@r == 5)
		warp "lhz_dun_n",87,84;
	else if (.@r == 6)
		warp "lhz_dun_n",201,101;
	else if (.@r == 7)
		warp "lhz_dun_n",230,138;
	else if (.@r == 8)
		warp "lhz_dun_n",239,220;
	else if (.@r == 9)
		warp "lhz_dun_n",162,252;
	else if (.@r == 10)
		warp "lhz_dun_n",99,106;
	else if (.@r == 11)
		warp "lhz_dun_n",40,212;
	else if (.@r == 12)
		warp "lhz_dun_n",140,191;
	else if (.@r == 13)
		warp "lhz_dun_n",164,77;
	else if (.@r == 14)
		warp "lhz_dun_n",124,138;
	else if (.@r == 15)
		warp "lhz_dun_n",28,140;
	else if (.@r == 16)
		warp "lhz_dun_n",78,189;
	else if (.@r == 17)
		warp "lhz_dun_n",137,262;
	else if (.@r == 18)
		warp "lhz_dun_n",115,253;
	else if (.@r == 19)
		warp "lhz_dun_n",140,39;
	else if (.@r == 20)
		warp "lhz_dun_n",240,64;
	else if (.@r == 21)
		warp "lhz_dun_n",131,235;
	else if (.@r == 22)
		warp "lhz_dun_n",34,70;
	else
		warp "lhz_dun_n",176,202;
	delitem 22687,1;
	return;
}

function	script	F_Cursed_Fragment	{	// 23016
	.@r = rand(1,12);
	if (.@r == 1) {
		showscript "我绝不会原谅你……！";
		sc_start SC_ATKPOTION,600000,50;
		sc_start SC_MATKPOTION,600000,50;
	}
	else if (.@r == 2) {
		showscript "谁来帮帮我……";
		sc_start SC_CURSE,10000,0;
	}
	else if (.@r == 3) {
		showscript "住手……好痛……";
		sc_start SC_BLEEDING,5000,0;
	}
	else if (.@r == 4) {
		showscript "这里好冷……";
		sc_start SC_FREEZE,5000,0;
	}
	else if (.@r == 5) {
		showscript "求你了……陪着我……";
		itemskill "AL_TELEPORT",1;
	}
	else if (.@r == 6) {
		showscript "留下来……陪着我……";
		itemskill "AL_TELEPORT",1;
	}
	else if (.@r == 7) {
		showscript "你不该来这里……";
		sc_start SC_STUN,5000,0;
	}
	else if (.@r == 8) {
		showscript "你好……有人在吗……？";
		sc_start SC_BLIND,5000,0;
	}
	else if (.@r == 9) {
		showscript "我好害怕……好害怕……";
		sc_start SC_CONFUSION,10000,0;
	}
	else if (.@r == 10) {
		showscript "亲爱的奥丁……";
		sc_start SC_ASSUMPTIO,100000,5;
		specialeffect2 EF_ASSUMPTIO;
	}
	else if (.@r == 11) {
		showscript "醒醒！";
		percentheal 0,20;
	}
	else {
		showscript "对不起……我现在就离开……谢谢……";
		getitem 6820,1;// Energy_Fragment
	}
	return;
}


// Nightmare Biolab Entrances
lighthalzen,321,218,4	script	Ohno Tohiro#1	4_M_RASWORD,{
	disable_items;
	mes "[Ohno Tohiro]";
	.@r = rand(1,10);
	if (.@r < 6)
		mes "有人让我收集某种研究图表……";
	else if (.@r < 7) {
		mes "- 我听到有人说话 - - 远程通信 -";
		next;
		mes "[Ohno Tohiro]";
		mes "是的……一切进展顺利。";
		mes "报告收集的情况良好。";
		mes "是，长官。";
		next;
		mes "[Ohno Tohiro]";
		mes "我会立即将实验室相关信息作为最高优先级报告上去。";
		mes "是，长官……我会照做。";
		next;
		mes "[Ohno Tohiro]";
		mes "哦，有人来了！晚点再联系你。";
	}
	else {
		mes "[Ohno Tohiro]";
		mes "我的肩上责任重大。";
		mes "我们长久以来的愿望……";
		mes "一步一步，慢慢来……";
	}
	next;
	mes "[Ohno Tohiro]";
	mes "呃……？我没注意到已经有人来了……";
	mes "嗯……嗯……";
	mes "你想从我这里得到什么？";
	while(true) {
		next;
		switch( select( "结束对话。", "询问荣誉墓穴。", "返回荣誉墓穴。", "说明 Zeny 不够。" ) ) {
		case 1:
			mes "[Ohno Tohiro]";
			mes "除了你之外，还有很多冒险者在寻找这条裂缝！";
			mes "如果你改变主意，再回来找我吧！";
			close;
		case 2:
			mes "[Ohno Tohiro]";
			mes "你也听说过通往那个地方的裂缝吧？";
			mes "最近像你这样的冒险者很多！";
			next;
			mes "[Ohno Tohiro]";
			mes "我第一次进入这条裂缝时，你猜怎么着？它通往一个怪物成群出没的地方。";
			next;
			mes "[Ohno Tohiro]";
			mes "我告诉了一位认识的冒险者。他对此表现出很大兴趣！";
			mes "他一直自言自语地说着生物医学研究、实验室之类的话。";
			next;
			mes "[Ohno Tohiro]";
			mes "他一直求我告诉他怎么去那里。我不太想让他知道这条裂缝，因为不想让别人知道。不过我用这个消息换了 100,000 Zeny。";
			next;
			mes "[Ohno Tohiro]";
			mes "没过多久，他遍体鳞伤地回来了。他能活着回来简直是奇迹……太可怕了……";
			mes "不过，他手里拿着几件物品。乍一看，它们强大得连我都害怕。";
			next;
			mes "[Ohno Tohiro]";
			mes "那之后，许多冒险者听到传闻，通过这条裂缝进入了这个危险的地方。我几乎没见过冒险者再从裂缝里出来。从那以后，这里就被称为荣誉墓穴。";
			mes "不过，我也因此赚了些钱。";
			next;
			mes "[Ohno Tohiro]";
		mes "你想知道我为什么能赚钱？";
		mes "是我第一个发现这里的，所以它的所有权也属于我！你有意见吗？";
			next;
			mes "[Ohno Tohiro]";
		mes "嗯嗯……总之，给我 100,000 Zeny。我就为你这样的冒险者打开通往裂缝的门……";
			continue;
		case 3:
			if (Zeny < 100000) {
				mes "[Ohno Tohiro]";
				mes "你的钱不够！";
				mes "这个世界上没有免费的东西！";
				continue;
			}
			mes "[Ohno Tohiro]";
			mes "让我看看……一……二……三。";
			mes "好。既然我收到了 Zeny，就打开裂缝吧。";
			mes "希望你能活着回来……！";
			next;
			if (Zeny >= 100000) {
				Zeny -= 100000;
				warp "lhz_dun_n",100,202;
			}
			end;
		case 4:
			mes "[Ohno Tohiro]";
		mes "什么？你没有足够的 Zeny，却想进去？";
		mes "嗯……那么……你该不会有研究图表吧？";
			next;
			mes "[Ohno Tohiro]";
		mes "嘘，小声点。附近的人可能会听到。你到底有没有？";
			next;
			mes "[Ohno Tohiro]";
		mes "别问我为什么需要它。只要给我 10 张研究图表，我就免费送你去荣誉墓穴。你觉得怎么样？";
			next;
			if (select( "返回上一个菜单。", "交出 10 张研究图表。" ) == 1) {
				mes "[Ohno Tohiro]";
				mes "你还有别的事要找我吗？";
				continue;
			}
			if (countitem(7347) < 10) {
				mes "[Ohno Tohiro]";
			mes "现在看来少了 10 张研究图表。";
			mes "也许你没有从仓库拿出来。";
				next;
				mes "[Ohno Tohiro]";
			mes "你还想从我这里得到什么？";
				continue;
			}
			mes "[Ohno Tohiro]";
		mes "哦……对，就是这个……这正是我需要的……呼呼……";
			next;
			mes "[Ohno Tohiro]";
		mes "我会按约定送你去裂缝。";
		mes "我希望你活着回来。再见！";
			next;
			delitem 7347,10;// Lab_Staff_Record
			warp "lhz_dun_n",100,202;
			end;
		}
	}
}

lighthalzen,320,204,3	script	A kid with black finger	4_F_04,{
	disable_items;
	mes "[Lunar]";
	mes "你在找什么？是在找死者徘徊的地方吗？";
	next;
	mes "[Lunar]";
	mes "如果你想去，我可以带你过去。你需要^0000cd20 20 个感伤碎片和 150K Zeny^000000。";
	next;
	mes "[Lunar]";
	mes "或者你也可以安全地去看感伤，不受死者打扰。那需要^0000cd30 个感伤碎片和 2M Zeny^000000。";
	next;
	mes "[Lunar]";
	mes "你想去哪里？";
	next;
	switch( select( "死者徘徊的地方。", "只能遇见思念。", "那是什么地方？", "我无所谓。" ) ) {
	case 1:
		mes "[Lunar]";
		mes "你都有吧？";
		next;
		if (countitem(22687) < 20 || Zeny < 150000) {
			mes "[Lunar]";
			mes "让我看看。";
			next;
			mes "[Lunar]";
			mes "不够。你需要^0000cd20 个感伤碎片和 150K Zeny^000000。不能免费带你过去。";
			close;
		}
		mes "[Lunar]";
		mes "你都有吧？";
		next;
		mes "[Lunar]";
		mes "很好，你都有。我带你过去。";
		next;
		mes "[Lunar]";
		mes "不过……我是收钱带你过去的……你要小心。";
		next;
		mes "[Lunar]";
		mes "所以……进去后你会看到一台^0000cd看起来像水晶的奇怪机器^000000。";
		next;
		mes "[Lunar]";
		mes "使用这台机器可以恢复 HP。它帮助我活了下来。不过我也不知道它为什么会在那种地方……";
		next;
		mes "[Lunar]";
		mes "我关掉了机器，不让任何人使用，但我会特别允许你使用。";
		next;
		mes "[Lunar]";
		mes "请小心，需要时就使用机器！！";
		delitem 22687,20;// Sentimental Fragment
		Zeny = Zeny - 150000;
		if (isbegin_quest(14683) > 0)
			erasequest 14683;
		setquest 14683;// Mysterious Device
		close2;
		warp "lhz_dun_n",162,254;
		end;
	case 2:
		mes "[Lunar]";
		mes "物品和钱都带齐了吗？";
		next;
		if (countitem(22687) < 30 || Zeny < 2000000) {
			mes "[Lunar]";
			mes "让我看看。";
			next;
			mes "[Lunar]";
			mes "不够。需要^0000cd30 个感伤碎片和 2M Zeny^000000。不能免费带你过去。";
			close;
		}
		mes "[Lunar]";
		mes "很好，你都有。我带你过去。";
		next;
		mes "[Lunar]";
		mes "出口在墙外。";
		next;
		mes "[Lunar]";
		mes "^EE0000另外提醒你，里面无法保存位置，所以如果你下线或断线，就会被传送到保存点。";
		close2;
		delitem 22687,30;
		Zeny = Zeny - 2000000;
		warp "lhz_d_n2",60,44;
		end;
	case 3:
		mes "[Lunar]";
		mes "我挖地找吃的，却发现了更好的东西。";
		next;
		mes "[Lunar]";
		mes "活人无法在那里生存。只有死者在四处徘徊。";
		next;
		mes "[Lunar]";
		mes "有传言说……去那里的人再也没有回来……";
		next;
		mes "[Lunar]";
		mes "我非常害怕，但是……很明显那里是冒险者喜欢去的地方。";
		next;
		mes "[Lunar]";
		mes "我抵达的地方^0000cd就在奇异感伤附近^000000。";
		next;
		mes "[Lunar]";
		mes "因为很多死者想杀我，所以我逃走了。";
		next;
		mes "[Lunar]";
		mes "但后来我迷路了，掉进了一个奇怪的地方。";
		next;
		mes "[Lunar]";
		mes "那里和死者徘徊的地方一样，^0000cd但只有思念存在^000000。太可怕了，所以我马上逃了出来。";
		next;
		mes "[Lunar]";
		mes "只要你给我钱和物品，我就带你过去。";
		next;
		mes "[Lunar]";
		mes "没有他的帮助，你也许会更轻松。";
		close;
	case 4:
		mes "[Lunar]";
		mes "随时来找我吧。反正我们也没什么可失去的。";
		close;
	}
}

lighthalzen,327,216,3	script	Crevice#1	4_CRACK,{
	end;
OnInit:
	initnpctimer;
	end;
OnTimer5000:
	specialeffect EF_AGIUP3;
	end;
OnTimer6000:

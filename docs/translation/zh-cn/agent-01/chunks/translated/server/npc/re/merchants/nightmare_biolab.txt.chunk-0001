// Dungeon exit
lhz_dun_n,96,203,3	script	Dungeon gateway#1	4_CRACK,{
	if (select( "不离开副本。", "离开副本。" ) == 1) {
		mes "- 你在这里还有事情要处理。-";
		close;
	}
	warp "lighthalzen",310,228;
	end;
OnInit:
	initnpctimer;
	end;
OnTimer5000:
	specialeffect EF_AGIUP3;
	end;
OnTimer6000:
	initnpctimer;
	end;
}

// Lighthalzen Exchange NPCs
lighthalzen,319,213,4	script	Veteran Adventurer#JCv2	4_M_MELODY,2,2,{
	disable_items;
	mes "[Veteran Adventurer]";
	mes "哦！你想兑换思念或怨恨碎片吗？";
	next;
	setarray .@items[0],
		6469,200,	// Will of Warrior
		6470,200,	// Blood Thirst
		6471,300;	// Ghost Chill
	.@color$[0] = countitem(6820) < 200 ? "^777777" : "^000000";
	.@color$[1] = countitem(6820) < 300 ? "^777777" : "^000000";
	.@s = select( "听故事。", .@color$[0] + "1 战士意志（200 个能量碎片）", .@color$[0] + "1 嗜血（200 个能量碎片）", .@color$[1] + "1 鬼魂寒气（300 个能量碎片）^000000" ) - 2;
	if (.@s == -1) {
		emotion ET_QUESTION;
		mes "[Veteran Adventurer]";
		mes "你看起来很有空，对吧？不过我最近的生意也很清闲……";
		next;
		mes "[Veteran Adventurer]";
		mes "有一天，公会会长突然来到了我的公会……";
		next;
		mes "[Veteran Adventurer]";
		mes "‘^1F294D我要让所有公会的成员都穿上阵亡士兵的斗篷！！^000000’。";
		next;
		mes "[Veteran Adventurer]";
		mes "如你所知，这件装备需要大量材料，所以所有公会成员只能被困在副本里，被迫工作。";
		next;
		mes "[Veteran Adventurer]";
		mes "谁也不知道最后会走什么运。我下定决心投入挖掘工作，找到了许多稀有碎片。";
		next;
		mes "[Veteran Adventurer]";
		mes "副会长女士让我和其他人交换物品，因为碎片越积越多。";
		next;
		mes "[Veteran Adventurer]";
		mes "当然，交换数量由公会会长决定，他强调说：";
		mes "‘^1F294D低于这个数量我绝不会接受！！^000000’……";
		next;
		emotion ET_HNG;
		mes "[Veteran Adventurer]";
		mes "副会长女士试图把泥土扔进公会会长的眼睛。我们费了很大力气才阻止她。";
		next;
		mes "[Veteran Adventurer]";
		mes "我想如果他把数量调低，我们就能很快处理完。（叹气）……事情就是这样。";
		close;
	}
	.@s *= 2;
	mes "[Veteran Adventurer]";
	mes "^3300661 " + getitemname(.@items[.@s]) + "^000000 可兑换 ^CC3333" + .@items[.@s+1] + " 个能量碎片^000000。";
	next;
	if (select( "交换。", "不交换。" ) == 2) {
		emotion ET_OTL;
		mes "[Veteran Adventurer]";
		mes "什么……？我以为你要交换。";
		close;
	}
	while(true) {
		if (countitem(6820) < .@items[.@s+1]) {
			emotion ET_SORRY;
			mes "[Veteran Adventurer]";
		mes "抱歉。会长下了命令，我也没有选择。你需要" + .@items[.@s+1] + "个物品，如果他不同意，我就不能交换。";
			close;
		}
		delitem 6820, .@items[.@s+1];// Energy Pieces
		getitem .@items[.@s],1;
		mes "[Veteran Adventurer]";
	mes "要继续交换吗？";
		next;
	if (select( "继续交换。", "停止交换。" ) == 2) {
			emotion ET_THANKS;
			mes "[Veteran Adventurer]";
		mes "谢谢……多亏了你，我想会长不会惩罚我了。";
			close;
		}
	}
	end;

OnTouch:
	.@r = rand(4);
	if (.@r == 0)
		npctalk "我想用 1 个战士意志交换 200 个能量碎片。", "", bc_self;
	else if (.@r == 1)
		npctalk "我想用 1 个幽灵寒气交换 300 个能量碎片。", "", bc_self;
	else if (.@r == 2)
		npctalk "我想用 1 个嗜血交换 200 个能量碎片。", "", bc_self;
	else {
		emotion ET_OHNO;
		npctalk "哦……！为什么这么难找到碎片？", "", bc_self;
	}
	end;
}

lighthalzen,312,296,4	script	Bully#JCv2	4_M_LGTPOOR,{

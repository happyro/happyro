<div id="Roulette">
	<div class="body" data-background="basic_interface/roullette/roulletteBG.bmp">
		<div class="titlebar">
			<div class="left">
				<span class="title">轮盘</span>
			</div>
			<div class="right">
				<button class="base close">×</button>
			</div>
			<div class="clear"></div>
		</div>

		<div class="roulette-container">
			<div class="roulette-wheel">
				<div class="wheel-center"></div>
				<div class="wheel-slots">
					<!-- Slots will be generated dynamically -->
				</div>
				<div class="wheel-pointer"></div>
			</div>

			<div class="roulette-info">
				<div class="points-display">
					<span class="label">积分：</span>
					<span class="points-value">0</span>
				</div>

				<div class="buttons-container">
					<button
						class="btn-spin"
						data-background="basic_interface/roullette/StartRoullette_a.bmp"
						data-hover="basic_interface/roullette/StartRoullette_b.bmp"
					>
						<span>旋转</span>
					</button>
					<button class="btn-info">
						<span>信息</span>
					</button>
					<button
						class="btn-close"
						data-background="basic_interface/roullette/GetWinPrize_a.bmp"
						data-hover="basic_interface/roullette/GetWinPrize_b.bmp"
					>
						<span>领取奖励</span>
					</button>
				</div>

				<div class="result-display">
					<span class="result-label">结果：</span>
					<div class="result-item"></div>
				</div>
			</div>
		</div>
	</div>
</div>

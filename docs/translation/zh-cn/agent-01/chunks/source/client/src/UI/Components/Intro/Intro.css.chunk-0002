
/* Range sliders */
#intro input[type='range'] {
	width: 150px;
	accent-color: var(--gold);
}

/* Checkboxes */
#intro .settings-content input[type='checkbox'] {
	accent-color: var(--gold);
}

/* Quality result / volume result */
#intro .quality_result,
#intro .bgmvol_result,
#intro .soundvol_result {
	font-size: 12px;
	color: var(--gold);
	min-width: 40px;
}

/* Clean cache */
#intro .clean {
	display: none;
	padding: 4px 10px;
	background: var(--bg-card);
	border: 1px solid var(--border-dim);
	border-radius: var(--radius-sm);
	color: var(--text-light);
	font-size: 12px;
	transition: border-color 0.2s;
}
#intro .clean:hover {
	border-color: var(--gold);
}
#intro .clean-status {
	color: var(--text-muted);
	font-size: 12px;
	margin-left: 8px;
}

/* ── Server list ── */
#intro .serveredit dl {
	margin: 0;
}
#intro .serveredit dt {
	margin-bottom: 6px;
}
#intro .serveredit dd {
	margin: 0 0 10px 0;
}

#intro .clientinfo {
	background: transparent !important;
	border: 1px solid transparent !important;
	color: var(--gold) !important;
	cursor: pointer;
	text-decoration: underline;
}
#intro .clientinfo:focus {
	cursor: text;
	border: 1px solid var(--gold) !important;
	background: var(--bg-card) !important;
	color: var(--text-light) !important;
	text-decoration: none;
}

#intro .settings-content span {
	vertical-align: top;
	margin-left: 5px;
}

/* Radio buttons */
#intro input[type='radio'] {
	margin: 0;
	width: 15px;
	height: 15px;
	accent-color: var(--gold);
	vertical-align: middle;
	position: relative;
	bottom: 1px;
}

/* Server container */
#intro .servercontainer {
	max-height: 70px;
	overflow-y: auto;
	overflow-x: hidden;
	margin-top: 10px;
	padding-right: 6px;
}
#intro .servercontainer::-webkit-scrollbar {
	width: 6px;
}
#intro .servercontainer::-webkit-scrollbar-track {
	background: var(--bg-void);
	border-radius: 6px;
}
#intro .servercontainer::-webkit-scrollbar-thumb {
	border-radius: 6px;
	background: var(--gold-dark);
}

/* Server list table */
#intro .serverlist {
	border-collapse: collapse;
	width: 100%;
}
#intro .serverlist td {
	text-align: center;
	height: 22px;
	font-size: 12px;
}
#intro .serverlist thead td {
	color: var(--gold-dark);
	font-weight: bold;
	font-size: 11px;
}
#intro .serverlist tbody tr:hover {
	background: rgba(232, 184, 75, 0.06);
}
#intro .servers input {
	background: transparent;
	border: 1px solid transparent;
	cursor: pointer;
	color: var(--text-light);
	text-align: center;
	width: 100%;
	font-size: 12px;
	font-family: inherit;
}
#intro .servers input:focus {
	cursor: text;
	border: 1px solid var(--gold);
	background: var(--bg-card);
	color: var(--text-light);
}

/* Delete button */
#intro .btn_delete {
	width: 20px;
	height: 20px;
	background: rgba(239, 68, 68, 0.15);
	border: 1px solid rgba(239, 68, 68, 0.3);
	border-radius: 4px;
	color: #ef4444;
	font-size: 14px;
	line-height: 18px;
	text-align: center;
	padding: 0;
	transition: background 0.2s;
}
#intro .btn_delete:hover {
	background: rgba(239, 68, 68, 0.3);
}

/* Add server button */
#intro .settings .btn_add {
	margin-top: 10px;
	float: right;
	padding: 5px 14px;
	background: var(--bg-card);
	border: 1px solid var(--border-dim);
	border-radius: var(--radius-sm);
	color: var(--text-light);
	font-size: 12px;
	transition: border-color 0.2s;
}
#intro .settings .btn_add:hover {
	border-color: var(--gold);
	color: var(--gold);
}

/* Save button */
#intro .settings .btn_save {
	display: block;
	width: 200px;
	margin: 24px auto 0;
	padding: 12px 0;
	font-family: 'Cinzel', serif;
	font-size: 13px;
	font-weight: 600;
	letter-spacing: 0.1em;
	text-transform: uppercase;
	color: var(--bg-void);
	background: linear-gradient(135deg, var(--gold-bright), var(--gold), var(--gold-dark));
	border: none;
	border-radius: var(--radius-sm);
	transition:
		transform 0.2s,
		box-shadow 0.3s;
	box-shadow: 0 4px 20px rgba(232, 184, 75, 0.3);
}
#intro .settings .btn_save:hover {
	transform: translateY(-2px);
	box-shadow: 0 6px 30px rgba(232, 184, 75, 0.45);
}
#intro .settings .btn_save:active {
	transform: translateY(0);
}

/* ── Aspect Ratio Fixes ── */
#intro .drop-zone {
	transform: translateX(-50%) scale(var(--cx, 1), var(--cy, 1));
}
#intro .msg {
	transform: translateX(-50%) scale(var(--cx, 1), var(--cy, 1));
}
#intro .btn_play {
	transform: translateX(-50%) scale(var(--cx, 1), var(--cy, 1));
}
#intro .btn_play:hover {
	transform: translateX(-50%) translateY(-2px) scale(var(--cx, 1), var(--cy, 1));
}
#intro .btn_play:active {
	transform: translateX(-50%) translateY(0) scale(var(--cx, 1), var(--cy, 1));
}
#intro .btn_about {
	transform: scale(var(--cx, 1), var(--cy, 1));
}
#intro .btn_about:hover {
	transform: scale(calc(1.1 * var(--cx, 1)), calc(1.1 * var(--cy, 1)));
}
#intro .btn_settings {
	scale: var(--cx, 1) var(--cy, 1);
}
#intro .btn_settings:hover {
	scale: var(--cx, 1) var(--cy, 1);
}
#intro .loading-content {
	transform: translate(-50%, -50%) scale(var(--cx, 1), var(--cy, 1));
}
#intro .about-content,
#intro .settings-content {
	scale: var(--cx, 1) var(--cy, 1);
}

	this.ItemInfo = (function () {
		const count = ((end - fp.tell()) / 57) | 0;
		const out = new Array(count);
		for (let i = 0; i < count; ++i) {
			out[i] = {};
			out[i].index = fp.readShort();
			out[i].ITID = fp.readUShort();
			out[i].type = fp.readUChar();

			out[i].location = fp.readULong();

      bonus bMaxSP,100;
      bonus bMaxHPrate,(.@r/2);
      bonus bMaxSPrate,(.@r/2);
      if (.@r>=7) {
         bonus bAtkRate,7;
         bonus bMatkRate,7;
         if (.@r>=9) {
            bonus2 bMagicAtkEle,Ele_All,10;
            bonus bLongAtkRate,10;
            if (.@r>=11) {
               bonus bFixedCast,-500;
            }
         }
      }
      if (.@g>=ENCHANTGRADE_D) {
         bonus bMRes,50;
         bonus bRes,50;
         if (.@g>=ENCHANTGRADE_C) {
            bonus2 bAddSize,Size_All,10;
            bonus2 bMagicAddSize,Size_All,10;
            if (.@g>=ENCHANTGRADE_B) {
               bonus bPAtk,7;
               bonus bSMatk,7;
               if (.@g>=ENCHANTGRADE_A) {
                  bonus bFixedCast,-500;
               }
            }
         }
      }

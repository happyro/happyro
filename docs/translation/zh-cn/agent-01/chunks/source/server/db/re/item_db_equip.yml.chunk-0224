      .@r = getrefine();
      if (readparam(bStr)>89) {
         bonus bAllStats,1;
         bonus bStr,.@r;
         bonus bMaxHPrate,1;
         bonus bMaxSPrate,1;
      }
      if (readparam(bAgi)>89) {
         bonus bAllStats,1;
         bonus bAgi,.@r;
         bonus bMaxHPrate,1;
         bonus bMaxSPrate,1;
      }
      if (readparam(bVit)>89) {
         bonus bAllStats,1;
         bonus bVit,.@r;
         bonus bMaxHPrate,1;
         bonus bMaxSPrate,1;
      }
      if (readparam(bInt)>89) {
         bonus bAllStats,1;
         bonus bInt,.@r;
         bonus bMaxHPrate,1;
         bonus bMaxSPrate,1;
      }
      if (readparam(bDex)>89) {
         bonus bAllStats,1;
         bonus bDex,.@r;
         bonus bMaxHPrate,1;
         bonus bMaxSPrate,1;
      }
      if (readparam(bLuk)>89) {

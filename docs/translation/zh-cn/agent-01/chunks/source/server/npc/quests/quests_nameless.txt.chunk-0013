	if ((diamond_edq == 22) || (diamond_edq == 23)) {
		mes "^3355FFThere is a tiny";
		mes "switch on the ground";
		mes "near the whiskey barrels.^000000";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "Was this here before?";
		mes "What happens if I press";
		mes "this teeny little switch?";
		next;

			mes "^4D4DFF1 Unripe Apple^000000,";
			mes "^4D4DFF5 Monster's Feed^000000,";
			mes "^4D4DFF1 Empty Bottle^000000, and";
			mes "^4D4DFF1 Yellow Potion^000000.";

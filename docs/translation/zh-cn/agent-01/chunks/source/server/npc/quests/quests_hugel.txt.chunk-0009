			mes "It's almost as if you";
			mes "were in Niflheim...^000000";
			close;
		} else {
			mes "^3355FFFor some reason, you";
			mes "feel very warm, safe,";
			mes "and secure near this";
			mes "tree. Just being near";
			mes "it brings you a sense";

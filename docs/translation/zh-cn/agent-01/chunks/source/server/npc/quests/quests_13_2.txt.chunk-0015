nyd_dun02,1,1,0	script	ep13_nd2f_mng	844,{
	callfunc "F_GM_NPC";
	mes "Enter password.";
	next;
	if (callfunc("F_GM_NPC",1854,0) == 1) {
		mes "Reset Control devices?";
		next;
		switch(select("Yes:No")) {
		case 1:
			donpcevent "ep13_nd2f_mng::OnReset";
			set $@08_ep13nydun02_in,0;
			mes "Done.";
			close;
		case 2:
			mes "Canceled.";
			close;
		}
	} else {
		mes "Invalid.";
		close;
	}


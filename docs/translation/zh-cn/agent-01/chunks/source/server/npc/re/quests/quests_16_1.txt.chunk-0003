prt_cas,25,35,5	script	Skia Nerius#ep16_7690	4_EP16_SKIA,{
	if (ep16_royal == 6) {
		cutin "ep16_nihi_miseria_heine01",2;
		mes "[Nyhill]";
		mes "...Who's there?";
		mes "" + strcharinfo(0) + "...?";
		mes "What are you doing here?";
		next;
		npctalk "...Ha...", "Unstable Nyhill#ep16_7690", bc_self;

2@mir,88,78,2	script	Isenhonor Walther#eisen2	4_M_1STPRIN1,{
	if ('intruder_count < 3) {
		npctalk "We don't have the time to chat!";
		end;
	}
	mes "[Isenhonor]";
	mes "What is going on...";
	mes "We shall leave this place first.";

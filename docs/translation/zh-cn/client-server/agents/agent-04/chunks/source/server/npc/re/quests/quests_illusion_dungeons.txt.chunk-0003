pay_d03_i,81,136,3	script	Villager#ill_moon_3	1_M_ORIENT01,{
	mes "[ Villager ]";
	mes "Are you here to subjugate us?!";
	mes "We've done nothing wrong!";
	mes "Can't you tell from the sacred creatures!";
	next;
	mes "[ Villager ]";
	mes "Ah... The fox lady...";
	close2;
	initnpctimer;
	disablenpc();
	npctalk "H-help!! I don't want to die!";

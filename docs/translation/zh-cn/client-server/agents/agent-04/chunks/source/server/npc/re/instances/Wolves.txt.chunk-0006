	end;
OnTouch:
	if (is_party_leader() == false)
		end;
	.@string$ = replacestr( strnpcinfo(2), "2dms", "" );
	donpcevent instance_npcname("#nyr_puri_mob_2") + "::OnStart" + .@string$;
	end;
}

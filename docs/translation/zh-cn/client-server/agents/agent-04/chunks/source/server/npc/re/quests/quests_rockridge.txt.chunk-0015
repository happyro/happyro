	mes "[Dispatched Nun]";
	mes "They don't want to know or care. You have to be in a pretty bad situation to end up here.";
	close;
}

rockrdg1,310,48,3	script	Erekter#rockc06	4_M_CACTUSCHILD,{
	mes "[Erekter]";
	mes "Erekter wants to become the best netter in the village when he grows up.";
	next;
	npctalk "Oh, wait.", "", bc_self;
	emotion ET_THINK;
	mes "[Erekter]";
	mes "The best netter in the village is Mrs. Soft Feather.";
	next;
	emotion ET_DELIGHT;
	mes "[Erekter]";
	mes "Mm... Then I'll become the second-best netter in the village!";
	close;
}

rockrdg1,308,49,5	script	Soft Feather#rockc09	4_F_CACTUSLADY3,{
	mes "[Soft Feather]";
	mes "Ho ho ho, there's not a single fishing net in the village that hasn't been handled by me.";
	mes "There are others who make good nets, but I'm the one who gives the nets their finishing touch.";
	next;
	mes "[Erekter]";
	mes "I want to learn from you too! I want to become as good at netting as you!";
	next;
	mes "[Soft Feather]";
	mes "Your hands are too soft right now. Go out and play. I'll teach you when your hands become tougher.";
	next;
	npctalk "Yay! I'm going to go tell my friends!", "Erekter#rockc06", bc_self;
	mes "[Soft Feather]";
	mes "Yes, I'll teach you how to net. For now, let me teach you how to make pretty knots with grass blades.";
	close;
}

// GM npc
harboro1,1,1,3	script	Manager#1	CLEAR_NPC,3,0,{
	.@equip_id = getequipid(EQI_ARMOR);
	if (.@equip_id == -1)
		end;

	if (.@equip_id != getiteminfo("Amesha_Spenta", ITEMINFO_ID)) {
		mes "^0000ff[Carrying Limit Helper]^000000";
		mes "^0000ffDo you want to delete all the equipment this character is wearing?^000000";
		mes "^0000ffPPL Removal version.^000000";
		next;
		switch( select( "Quit.", "Delete all." ) ) {
		case 1:
			mes "Deletion aborted.";
			close;
		case 2:
			mes "Some of the items cannot be deleted.";
			close;
		}
		end;
	}

	.@i = callfunc("F_GM_NPC",1854,0);
	if (.@i == -1) {
		mes "The command has been cancelled.";
		close;
	}
	else if (.@i != 0) {
		setarray .@quest_id[0],
			12381,
			12389,
			12403,
			12382,
			12383,
			12384,
			12385,
			12386,
			12387,
			12388,
			12390,
			12391,
			12392,
			12393,
			12394,
			12395,
			12396,
			12398,
			12399,
			12400,
			12401,
			12402,
			12404,
			12405,
			12406,
			12407,
			12408,
			12409;
		.@size = getarraysize(.@quest_id);
		for ( .@i = 0; .@i < .@size; ++.@i ) {
			if (isbegin_quest(.@quest_id[.@i]) > 0)
				erasequest .@quest_id[.@i];
		}
		mes "Reset completed.";
		close;
	}
	end;
}

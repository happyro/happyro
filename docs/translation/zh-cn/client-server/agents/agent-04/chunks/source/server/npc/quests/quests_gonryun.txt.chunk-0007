		mes "I..want to ...talk to...you..";
		mes "but.... sorry....";
		next;
		mes "^0000FFShe seems to have fallen asleep.^000000";
		close;
	}
	else if (b_sword == 27) {
		mes "[Lyroo]";
		mes "uh...umm?";
		if (Sex == SEX_FEMALE)
			mes "Ah....It's you, pretty sister...";
		else
			mes "Ah....It's you, handsome brother...";
		mes "Uhm? what is that you have?";

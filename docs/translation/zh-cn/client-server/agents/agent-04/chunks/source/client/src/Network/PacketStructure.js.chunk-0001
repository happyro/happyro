PACKET.CZ.REQUEST_TIME.prototype.build = function () {
	const ver = this.getPacketVersion();
	const pkt = new BinaryWriter(ver[2]);

	pkt.writeShort(ver[1]);
	pkt.view.setUint32(ver[3], this.clientTime, true);
	return pkt;
};


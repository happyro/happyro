				next;
				soundeffect "loli_ruri_stand.wav",0;
				mes "[??????]";
				mes "...elp....help...";
				close;
			}
			else if (@lhz_ghost == 4) {
				mes "[??????]";
				mes "...................";
				next;
				soundeffect "loli_ruri_stand.wav",0;
				mes "[??????]";
				mes "I...";
				mes "I despise the living.";
				close;
			}
		}
	}
	end;
}


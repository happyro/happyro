// Entrance
1@air1,240,57,3	script	Loki#air1	4_M_ROKI2,{
	if ('airship_status == 0) {
		cutin "ep14_roki02",2;
		mes "[Loki]";
		mes "……幸好这里没有那些讨厌的东西……";
		close3;
	}
	cutin "ep14_roki02",2;
	mes "[Loki]";
	mes "……无论如何我都会守住这里。下到飞艇内部去……！！";
	close3;
}

1@air1,235,57,5	script	Fenrir#air1	4_F_FENRIR,{
	if ('airship_status == 0) {
		cutin "fenrir_a",2;
		mes "[Fenrir]";
		mes "依靠机械的力量在空中飞行……科技的发展真是不可思议。";
		next;
		mes "[Fenrir]";
		mes "但我感觉这里还有某种力量……我认为这艘飞艇不可能只靠科技飞行。";
		close3;
	}
	cutin "fenrir_b",2;
	mes "[Fenrir]";
	mes "我会在这里面对它们。Chaos，和 Iris 一起下到飞艇下层！";
	close3;
}

1@air1,215,67,5	script	Iris#air1	4_F_IRIS,{ end; }
1@air1,214,66,5	duplicate(Iris#air1)	Chaos#air1	4_M_CHAOS

1@air1,217,67,3	script	Captain Ferlock#air1	4_M_REINDEER,{
	if ('airship_status == 0) {
		cutin "h_iris02",2;
		mes "[Iris]";
		mes "哇～太棒了！！风好凉快～！！";
		mes "好耶～我们在天空中飞！而且还是免费的！";
		next;
		mes "[Iris]";
		mes "这艘大船不用魔法就能飞，不是很神奇吗？Chaos？";
		next;
		cutin "h_chaos02",2;
		mes "[Chaos]";
		mes "......";
		next;
		cutin "h_iris02",2;
		mes "[Iris]";
		mes "...?? Chaos?";
		next;
		cutin "h_chaos02",2;
		mes "[Chaos]";
		mes ".....Sage Kadmon..";
		next;
		cutin "h_iris01",2;
		mes "[Iris]";
		mes "你不听我说话，究竟在做什么！！！！";
		next;
		cutin "h_chaos03",2;
		mes "[Chaos]";
		mes "啊！啊啊～！！";
		next;
		cutin "h_iris01",2;
		mes "[Iris]";
		mes "哼！这就是心不在焉的下场！";
		next;
		cutin "h_chaos03",2;
		mes "[Chaos]";
		mes "啊……Iris！！你想杀了我吗～！！";
		next;
		cutin "h_iris01",2;
		mes "[Iris]";
		mes "哼！我才不在乎你死不死……";
		next;
		cutin "fly_felrock2",2;
		mes "[Captain Ferlock]";
		mes "嘿！！不许在船上胡闹！！";
		mes "年轻人就是这样，毫无礼貌！再闹我就把你们全扔下去！！";
		next;
		cutin "h_iris02",2;
		mes "[Iris]";
		mes "哎呀……对了，船长，这艘大飞艇是怎么在天空中飞的？太神奇了！";
		next;
		cutin "fly_felrock2",2;
		mes "[Captain Ferlock]";
		mes "嗯？问得好。";
		mes "如你所见，我们加热大型锅炉把水烧开，再利用蒸汽压力推动活塞，带动齿轮和涡轮，最后让螺旋桨转动。";
		next;
		cutin "h_iris02",2;
		mes "[Iris]";
		mes "呃……原来这就是大船漂浮的原理……神秘感消失了。我还以为会有什么神秘装置……有点失望……";
		next;
		cutin "fly_felrock2",2;
		mes "[Captain Ferlock]";
		mes "没错。这艘大船不可能只靠蒸汽停在天空中，所以使用了名为‘符文引擎’的增幅器。";
		next;
		cutin "h_iris01",2;
		mes "[Iris]";
		mes "符文引擎？那是什么？";
		next;
		cutin "fly_felrock2",2;
		mes "[Captain Ferlock]";
		mes "那是使用魔法石的装置。";
		mes "传说它是破碎心脏坠落的碎片……虽然听起来很荒谬，但这不重要……";
		next;
		mes "[Captain Ferlock]";
		mes "这种石头被称为‘伊米尔之泪’。与蒸汽机等机车引擎连接后，石头释放的符文会增幅能量。";
		next;
		mes "[Captain Ferlock]";
		mes "说实话，一块拇指大小的石头推动这艘船并不夸张。它拥有难以想象的力量。";
		next;
		cutin "h_iris01",2;
		mes "[Iris]";
		mes "那么小的东西……！！！";
		next;
		cutin "ep14_roki02",2;
		mes "[Loki]";
		mes "……嗯？";
		mes "有什么东西朝这边来了……";
		next;
		cutin "",255;
		mes "[Guard]";
		mes "警报！！警报！！7 点钟方向发现大型飞龙部队！！";
		next;
		cutin "fly_felrock2",2;
		mes "[Captain Ferlock]";
		mes "什么？！";
		next;
		cutin "",255;
		mes "[Guard]";
		mes "格、格雷姆林！！格雷姆林从飞龙上降落了！！";
		for ( .@i = 1; .@i <= 8; .@i++ )
			enablenpc instance_npcname("Gremlin#" + .@i + "air1");
		enablenpc instance_npcname("Rotar Zairo#1air1");
		enablenpc instance_npcname("Rotar Zairo#2air1");
		enablenpc instance_npcname("Acidus#1air1");
		enablenpc instance_npcname("Acidus#2air1");
		enablenpc instance_npcname("Wywern#air1");
		'airship_status = 1;
		next;
	}
	if ('airship_status == 1) {
		cutin "h_chaos01",2;
		mes "[Chaos]";
		mes "嗯……这又是什么？";
		next;
		cutin "h_arcana02",2;
		mes "[Arcana]";
		mes "哈哈哈哈～让你久等了！！";
		mes "美丽女巫阿卡娜的空中怪物惊喜秀！！";
		next;
		cutin "h_chaos03",2;
		mes "[Chaos]";
		mes "什、什么秀？";
		next;
		cutin "h_arcana02",2;
		mes "[Arcana]";
		mes "现在……开始吧！格雷姆林们～！！";
		mes "派对时间～！！";
		next;
		cutin "",255;
		mes "[Guard]";
		mes "船、船长！情况严重！";
		mes "格雷姆林遍布整艘船！！";
		next;
		cutin "fly_felrock2",2;
		mes "[Captain Ferlock]";
		mes "什么？！这些是格雷姆林？！";
		mes "你们这些混蛋！！现在就从那里下来！！";
		next;
		cutin "h_iris01",2;
		mes "[Iris]";
		mes "船长，没必要这么激动。";
		mes "格雷姆林只是喜欢摆弄机器的怪物。更何况……";
		next;
		cutin "fly_felrock2",2;
		mes "[Captain Ferlock]";
		mes "你根本不知道自己在说什么！！";
		mes "我们现在在 8000 高空！！哪怕轻微故障也可能导致致命坠毁！";
		next;
		cutin "",255;
		mes "[Guard]";
		mes "啊！！后部 1 号引擎！！";
		mes "……情况严重！它们正前往引擎室！我们必须保护符文引擎！！";
		next;
		cutin "fly_felrock2",2;
		mes "[Captain Ferlock]";
		mes "可恶……我把武器放在哪里了……";
		mes "嘿，人类！！我去船长室找武器时，你们挡住那些麻烦的家伙！！";
		next;
		mes "[Captain Ferlock]";
		mes "尤其不能让它们接近符文引擎！！如果引擎被毁，船就无法继续飞行！！";
		next;
		mes "[Captain Ferlock]";
		mes "可恶……要是我的武器在手就好了……";
		next;
		disablenpc instance_npcname("Captain Ferlock#air1");
		cutin "h_chaos02",2;
		mes "[Chaos]";
		mes "Iris！！我们下到引擎室！Loki 和 Fenrir，守住这里！";
		next;
		cutin "h_iris01",2;
		mes "[Iris]";
		mes "哦……好！那么……走吧！！";
		close2;
		cutin "",255;
		if ('airship_status == 1)
			donpcevent instance_npcname("#airshipputmob1") + "::OnStart";
	}
	end;
}


ecl_tdun03,21,69,5	script	Diary Frog No.3#worm	4_FROG,{
mes "[日记青蛙 3 号]";
	if (ep14_2_profe < 6) {
		mes "Worm 教授把我扔到了这里。";
		mes "他生气时总会把我们扔出去。";
		close;
	}
	if (ep14_2_profe == 6) {
		mes "Worm 教授把我扔到了这里。";
		mes "他生气时总会把我们扔出去。";
		next;
		switch( select("会说话的青蛙？：我想听 Worm 教授的日记。") ) {
mes "[日记青蛙 3 号]";
		case 1:
			mes "我是用来录音的木制青蛙。";
			mes "我是 Worm 教授的杰作。";
			mes "纯粹的孤独能带来这样的发明，不是很神奇吗？";
			close;
		case 2:
			mes "我让你像听真的一样听它。";
			mes "我必须模仿 Worm 教授的声音，所以要先调整喉咙……";
			mes "呃哼……咳咳！";
			next;
mes "[3 号青蛙的真实日记录音]";
			mes "……他真的害怕彩虹桥！";
			mes "他说必须消灭她，因为有一天她会危及自己。";
			mes "那个人确实这么说过！啊啊啊～我想不起他了——那个人！";
			next;
mes "[日记青蛙 3 号]";
			mes "录音到此结束。";
			mes "另一只日记青蛙大概被扔到了塔的一楼。";
			changequest 1223,1224;
			ep14_2_profe = 7;
			close;
		}
	}
	mes "你对日记录音感兴趣吗？";
	mes "我也没什么别的事，要再听一遍吗？";
	next;
	switch( select("其他日记青蛙在哪里？：请再让我听一次。：还有更多吗？") ) {
mes "[日记青蛙 3 号]";
	case 1:
		mes ((ep14_2_profe > 7)?"6号日记青蛙":"另一只日记青蛙")+"可能被扔到了塔的一楼。";
		close;
	case 2:
		mes "我让你像听真的一样听它。";
		mes "我必须模仿 Worm 教授的声音，所以要先调整喉咙……";
		mes "呃哼……咳咳！";
		next;
mes "[3 号青蛙的真实日记录音]";
		mes "……他真的害怕彩虹桥！";
		mes "他说必须消灭她，因为有一天她会危及自己。";
		mes "那个人确实这么说过！啊啊啊～我想不起他了——那个人！";
		close;
	case 3:
		mes "我以前有更多，但不幸的是，我赖以生存的燃料就是录音本身，所以有一部分被消化掉了。";
		mes "我就是这样工作的，没办法。";
		emotion ET_PROFUSELY_SWEAT, playerattached();
		close;
	}
}

ecl_tdun01,23,79,4	script	Diary Frog No. 6#worm	4_FROG,{
	mes "[Diary Frog No.6]";
	if (ep14_2_profe < 7) {
		mes "Worm 教授竟敢把我扔到这里！";
		mes "扔到这个怪物这么多的地方！";
	}
	else if (ep14_2_profe == 7) {
		mes "Worm 教授在找我？";
		mes "我还以为他因为不需要我才把我扔出来！";
		mes "他真的把我扔得很远！";
		next;
		if (select("You look fine.:Please calm down and let me hear the diary.") == 1) {
mes "[日记青蛙 6 号]";
			mes "只有像我一样被抛弃，你才会明白！";
			close;
		}
mes "[日记青蛙 6 号]";
		mes "你为什么对别人的日记感兴趣？";
		mes "如果你帮我一个忙，我就让你听。";
		mes "在 Worm 教授放出的许多怪物中，^FF0000蓝色 Lichtern^000000一直想咬我。";
		next;
mes "[日记青蛙 6 号]";
		mes "我总是生活在焦虑中……谁能想到日记青蛙的生活这么艰难？";
		mes "消灭 15 只^FF0000蓝色 Lichtern^000000后回来，";
		mes "我就让你随意听 Worm 教授的日记。";
		next;
		if (select("That's a tough favor!:I'll get rid of them.") == 1) {
mes "[日记青蛙 6 号]";
			mes "那我就一个字也不提日记！";
			close;
		}
mes "[日记青蛙 6 号]";
		mes "好了，现在上路吧。";
		mes "你知道吧？我拥有的录音就是维持生命的燃料。";
		mes "趁它们还没被消化掉，快一点。";
		changequest 1224,1225;
		ep14_2_profe = 8;
	}
	else if (ep14_2_profe == 8) {
		if (checkquest(1225,HUNTING) == 2) {
			mes "你消灭了 15 只^FF0000蓝色 Lichtern^000000。";
			mes "现在我可以稍微放松了。";
			mes "如我所承诺，我让你听日记。";
			mes "我必须模仿 Worm 教授的声音，所以要先调整喉咙……";
			mes "呃哼……咳咳！";
			next;
mes "[6 号青蛙的真实日记录音]";
			mes "让 Bifrost 沉睡吧。";
			mes "他让我留在这里控制她的睡眠。";
			mes "如果她醒来，就是我的责任。";
			mes "这已经持续几十年了。";
			next;
mes "[6 号青蛙的真实日记录音]";
			mes "气死我了！真烦人！";
			mes "我真想直接把她叫醒！";
			mes "等等……我到底要叫醒谁来着？";
			mes "一只青蛙？这是什么？";
			mes "我需要叫醒你吗？";
			mes "算了，我要把你扔出去！";
			next;
mes "[日记青蛙 6 号]";
			mes "录音到此结束。";
			mes "我就是在那时被一路扔到了这里。";
			next;
mes "[日记青蛙 6 号]";
			mes "另一只日记青蛙应该在塔外的某处。";
			mes "如果没被什么东西带走，你应该很容易找到它。";
			changequest 1225,1226;
			ep14_2_profe = 9;
		}
		else {
			mes "消灭 15 只^FF0000蓝色 Lichtern^000000后回来，";
			mes "我就让你随意听 Worm 教授的日记。";
		}
	}
	else if (ep14_2_profe > 8) {
		mes "要再听一遍日记吗？";
		mes "想听多少遍都可以！";
		next;
		if (select("Where are other Diary Frogs?:Please let me hear it again.") == 1) {
mes "[日记青蛙 6 号]";
			mes "另一只日记青蛙应该在塔外的某处。";
			mes "如果没被什么东西带走，你应该很容易找到它。";
			close;
		}
mes "[日记青蛙 6 号]";
		mes "我会让你清清楚楚地听到！";
		mes "我必须模仿 Worm 教授的声音，所以要先调整喉咙……";
		mes "呃哼……咳咳！";
		next;
mes "[6 号青蛙的真实日记录音]";
		mes "让 Bifrost 沉睡吧。";
		mes "他让我留在这里控制她的睡眠。";
		mes "如果她醒来，就是我的责任。";
		mes "这已经持续几十年了。";
		next;
mes "[6 号青蛙的真实日记录音]";
		mes "气死我了！真烦人！";
		mes "我真想直接把她叫醒！";
		mes "等等……我到底要叫醒谁来着？";
		mes "一二三四五六七八九十一二三四五六七";
		mes "一只青蛙？这是什么？";
		mes "我需要叫醒你吗？";
		next;
mes "[日记青蛙 6 号]";
		mes "算了，我要把你扔出去！";
		mes "录音到此结束。";
		mes "我就是在那时——";
	}
	close;
}

ecl_fild01,173,95,7	script	Diary Frog No. 30#worm	4_FROG,{
	if (ep14_2_profe >= 11) {
		if (select("Where are other Diary Frogs?:Please let me hear it again.") == 1) {
mes "[日记青蛙 30 号]";
			mes "它们要么被怪物吃掉了，要么被扔出去后摔得严重损坏。";
			mes "我想应该没有其他青蛙留下来了。";
			close;
		}
mes "[日记青蛙 30 号]";
		mes "我会用悦耳的声音让你听 Worm 教授的日记。";
		mes "让我先清清嗓子……";
		mes "咳咳……噗哈哈！";
		next;
mes "[30 号青蛙的日记录音]";
		mes "这座塔藏着惊人的秘密！";
		mes "太不可思议了，真是太不可思议了！";
		mes "经过数百年，我终于弄清了一切！怎么会这样！";
		mes "震撼得我连自己知道过的一切都忘了！";
		next;
mes "[30 号青蛙的日记录音]";
		mes "这只该死的青蛙！";
		mes "我气死了，真该把这个扔出去！";
		next;
		mes "看来继续寻找日记记录没有意义了。我应该回去找 Worm 教授。";
		close;	
	}
mes "[日记青蛙 30 号]";
	if (ep14_2_profe < 9) {
		mes "如你所见，我是一只损坏的日记青蛙。";
		mes "Worm 教授把我狠狠地扔到了这么远的地方。";
		mes "我明明什么错都没犯！";
	}
	else if (ep14_2_profe == 9) {
		mes "如你所见，我是一只损坏的日记青蛙。";
		mes "Worm 教授把我狠狠地扔到了这么远的地方。";
		mes "我明明什么错都没犯！";
		next;
		if (select("You look fine.:Please calm down and let me hear the diary.") == 1) {
mes "[日记青蛙 30 号]";
			mes "请过来一下。让我打断你的一条腿。";
			close;
		}
mes "[日记青蛙 30 号]";
		mes "我被扔出来时受了伤，已经没有力气播放日记记录了。";
		mes "为了帮我修复自己，请从花开之地带来10个^FF0000星形蘑菇^000000。";
		next;
		if (select("Just walk it off.:I'll bring them for you.") == 1) {
mes "[日记青蛙 30 号]";
			mes "那我能让你听到的就只有呻吟和哀号了。";
			mes "啊啊啊啊啊！！！";
			close;
		}
mes "[日记青蛙 30 号]";
		mes "^FF0000星形蘑菇^000000可以从盛开花朵之地的花瓣魔物身上获得。";
		next;
mes "[日记青蛙 30 号]";
		mes "你知道吗？";
		mes "我的记录就是维持我生命所需的燃料。";
		mes "如果你回来得太晚，你听到的就只有我的呻吟和哀号。";
		changequest 1226,1227;
		ep14_2_profe = 10;
	}
	else if (ep14_2_profe == 10) {
		if (countitem(6542) < 10) {
			mes "我需要10个^FF0000星形蘑菇^000000。";
			mes "可以从在花开之地游荡的花瓣身上获得。";
			mes "请快一点。";
			mes "趁我还没有失去所有日记记录！";
			close;
		}
		mes "你把10个^FF0000星形蘑菇^000000全带来了。";
		mes "我得先处理伤口，请稍等。";
		next;
mes "[日记青蛙 30 号]";
		mes "啃啃啃";
		mes "咕噜咕噜";
		next;
mes "[日记青蛙 30 号]";
		mes "我感觉好多了。";
		mes "我会用悦耳的声音让你听 Worm 教授的日记。";
		mes "让我先清清嗓子……";
		mes "咳咳……噗哈哈！";
		next;
mes "[30 号青蛙的日记录音]";
		mes "这座塔藏着惊人的秘密！";
		mes "太不可思议了，真是太不可思议了！";
		mes "经过数百年，我终于弄清了一切！怎么会这样！";
		mes "震撼得我连自己知道过的一切都忘了！";
		next;
mes "[30 号青蛙的日记录音]";
		mes "这只该死的青蛙！";
		mes "我气死了，真该把这个扔出去！";
		next;
		mes "看来继续寻找日记记录没有意义了。我应该回去找 Worm 教授。";
		delitem 6542,10;// Star_Shape_Mushroom
		changequest 1227,1228;
		ep14_2_profe = 11;
	}
	close;
}

// Encounter in a Strange Land
//============================================================
mora,103,74,5	script	Expedition Member#tl01	4_M_DST_MASTER,{
	mes "[Expedition Member]";
		mes "我穿过朦胧森林迷宫一路来到这里，只是为了看看艾可拉治。我真的再也不想穿过那个迷宫了。";
	next;
	mes "[Expedition Member]";
	mes "一想到参观伊克拉斯后要回营地，我就觉得害怕。";
	next;
	switch( select("Eclage?:Easy way to return to the camp:pat pat...") ) {
		mes "[Expedition Member]";
	case 1:
		mes "嗯？你还不知道吗？";
		mes "伊克拉斯是拉斐尔人的首都。";
		next;
		mes "[Expedition Member]";
		mes "许多拉斐尔人和旅行者会因为运输货物等各种原因，从伊克拉斯来到摩拉村……";
		next;
		mes "[Expedition Member]";
		mes "既然你已经来到这里，也应该去那里看看。";
		mes "我是说……去观光！！";
		mes "从彩虹桥向北走就能看到了。";
		close;
	case 2:
		mes "嗯？我的意思是，你可以用在迷宫中收集的神秘种子飞过去。";
		mes "你是说，我得从那朵巨大的花上跳下去？";
		next;
		mes "[Expedition Member]";
		mes "所以进去很难，但出来没那么难。";
		mes "我还不知道有这种方法。";
		mes "哈哈，谢谢。";
		close;
	case 3:
		mes "你是在安慰我吗？";
		mes "你真是太好了……";
		close;
	}
}

function	script	EclageinEntrance	{
	if ((isbegin_quest(7411) + isbegin_quest(7412) + isbegin_quest(7413)) == 3) {
		hideoffnpc "Eclage Guard#tl01";
		cutin "minuel01",4;
		mes "[Eclage Guard]";
		mes "打扰一下。";
		mes "这里有来自斯普兰迪德的人吗？";
		next;
		select("我是，但为什么？");
		mes "[Eclage Guard]";
		mes "啊，是你吗？";
		mes "有人想见你。你现在有时间吗？";
		next;
		mes "[Eclage Guard]";
		mes "你不用担心。没有什么可疑或糟糕的事。";
		mes "我们只是想问你一些关于斯普兰迪德的事，请抽点时间给我们。";
		next;
		mes "[Eclage Guard]";
		mes "如果你愿意，我来给你带路。";
		next;
		switch( select("Sure. Let's go.:I don't have time for it right now...") ) {
			mes "[Eclage Guard]";
		case 1:
			mes "那请跟我来。";
			ep14_2_mylord = 4;
			erasequest 7411;
			erasequest 7412;
			changequest 7413,7415;
			close2;
			warp "ecl_in03",244,89;
			break;
		case 2:
			mes "哦，是这样吗？";
			mes "那真遗憾。";
			mes "不过如果你之后有时间，请来拜访我们。";
			next;
			mes "[Eclage Guard]";
		mes "我会在靠近大门的东侧等你。";
			mes "请到那里来找我。";
		mes "期待见到你。";
			ep14_2_mylord = 3;
			erasequest 7411;
			erasequest 7412;
			changequest 7413,7414;
			close2;
			break;
		}
		cutin "",255;
		hideonnpc "Eclage Guard#tl01";
		end;
	}
	return;
}

ecl_in01,32,52,5	script	Traveler Fome#tl01	4_F_DOGTRAVELER,3,3,{
	if (BaseLevel < 99) {
		mes "[Fome]";
		mes "嗯？你也是旅行者吗？";
		mes "你是说，你打算凭那点本事穿越伊克拉斯？";
		mes "你能来到这里简直就是奇迹……";
		close;
	}
	if (ep14_2_mylord == 2 && isbegin_quest(7411) == 1) {
		EclageinEntrance;
		mes "[Fome]";
		mes "哎呀，我是不是说太多了？";
		mes "不过你真的很幸运。";
		mes "如果你告诉他们是来祝贺新任朱恩市长诞生的，就一定能见到伟大的卡尔杜伊。";

que_ng,27,18,3	script	Toshu	709,{
	
	if(BaseClass != Job_Ninja){
		mes "[Toshu]";
		mes "你好吗～";
		mes "年轻的朋友～";
		mes "我是东方三工匠之一，名叫村田东修。";
		next;
		mes "[Toshu]";
		mes "我从海外学会了开槽。";
		mes "正考虑用这项能力赚点钱。";
		next;
		mes "[Toshu]";
		mes "不过你似乎不是我能做生意的那类客人……";
		close;
	}
	mes "[Toshu]";
	mes "你好吗，我年轻的朋友～";
	mes "我是东方三兄弟中负责制作盾牌的老二。";
	mes "人们叫我村田东修。";
	next;
	mes "[Toshu]";
	mes "我从海外学会开槽，所以想用这项能力赚点零花钱。";
	next;
	mes "[Toshu]";
	mes "如果你愿意，带来";
	mes "1 个强化护臂、1 个开槽圆盾";
	mes "和 40,000 Zeny，我就能制作开槽强化护臂。";
	next;
	mes "[Toshu]";
	mes "顺便说一下，开槽强化护臂可能失败并损坏材料，你最好考虑清楚。";
	mes "怎么样？成交吗？";
	next;
	if(select("不，我不想做。:好！就这么办！") == 1){
		mes "[Toshu]";
		mes "Ok.";
		mes "当然，盾牌对你很重要。";
		mes "之后决定继续的话，再来找我。";
		close;
	}else{
		if(countitem(2104) < 1 || countitem(2119) < 1){
			mes "[Toshu]";
		mes "看来你没有带够材料。";
		mes "所需材料是 1 个开槽圆盾、";
		mes "1 个强化护臂和 40,000 Zeny。";
		mes "记得带来正确数量的材料和 Zeny。";
			close;
		}
		if(Zeny < 40000){
			mes "[Toshu]";
		mes "看来你带来了正确数量的材料。";
		mes "但是 Zeny 不够。";
		mes "所需材料是 1 个开槽圆盾、1 个强化护臂和 40,000 Zeny。";
		mes "别忘了带齐。";
			close;
		}
		mes "[Toshu]";
		mes "嗯，材料和 Zeny 都确认了！";
		mes "该开始我的工作了。";
		mes "先提醒你……";
		next;
		mes "[Toshu]";
		mes "制作过程中可能失败，你最好考虑清楚。";
		next;
		mes "[Toshu]";
		mes "即使可能失败，你仍要我制作吗？";
		next;
		if(select("我还是放弃吧，呜……:好！试试看！") == 1){
			mes "[Toshu]";
			mes "Ok.";
			mes "鼓起勇气后再回来试吧。";
			mes "呃呵呵呵呵～";
			close;
		}else{
			mes "[Toshu]";
			mes "好！订单收到了！";
			mes "等 3 秒钟！！";
			mes "叮当～！叮当～！！";
			mes "刷刷～锯锯～";
			next;
			if(countitem(2104) < 1 || countitem(2119) < 1 || Zeny < 40000){
				mes "检测到作弊";
				close;
			}
			delitem 2104,1;
			delitem 2119,1;
			set Zeny,Zeny-40000;

			switch (rand(5)) {
				case 1:
					getitem 12043,1;
					mes "[Toshu]";
					mes "啊啊啊！！！";
					mes "呃……这";
					mes "可不是好消息。";
					mes "盾牌开槽失败了，";
					mes "果然如我所担心。";
					mes "真的很抱歉。";
					mes "吃点这个振作起来吧。";
					close;
					break;
				case 2:
					getitem 12043,1;
					mes "[Toshu]";
					mes "啊啊啊！！！";
					mes "呃……这";
					mes "可不是好消息。";
					mes "盾牌开槽失败了，果然如我所担心。";
					mes "真的很抱歉。吃点这个振作起来吧。";
					close;
					break;
				default:
					getitem 2120,1;
					mes "[Toshu]";
					mes "嗯～～看来一切顺利。";
					mes "这是完成的开槽";
					mes "强化护臂。";
					mes "虽然担心会失败，但我被称为工匠是有原因的，对吧？";
					mes "还需要我时再来找我。";
					close;
					break;
			}
		}
	}
}


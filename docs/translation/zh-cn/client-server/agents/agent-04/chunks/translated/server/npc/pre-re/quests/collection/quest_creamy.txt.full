prt_fild04,356,148,3	script	Laertes#Creamy_Hunt	798,{
	if (checkquest(60122) != -1) {
		if (checkquest(60122,HUNTING) != 2 ) {
			mes "[拉尔忒斯]";
			mes "你已经猎杀 50 只奶油波利了吗？";
			next;
			switch(select("是:否:我想退出")) {
			case 1:
				mes "[拉尔忒斯]";
				mes "嗯，我觉得你还没猎杀 50 只……";
				close;
			case 2:
				mes "[拉尔忒斯]";
				mes "记住，我需要你帮忙猎杀奶油波利，去猎杀 50 只吧。";
				close;
			case 3:
				mes "[拉尔忒斯]";
				mes "你确定要停止猎杀吗？";
				mes "你取得的进度都会被清除。";
				next;
				switch(select("是:否")) {
				case 1:
					mes "[拉尔忒斯]";
					mes "好吧，改变主意后再回来。";
					erasequest 60122;
					close;
				case 2:
					mes "[拉尔忒斯]";
					mes "请猎杀 50 只奶油波利。";
					close;
				}
			}
		}
		else {
			mes "[拉尔忒斯]";
			mes "太厉害了，你完成得真快。";
			getexp 2950,1125;
			erasequest 60122;
			close;
		}
	}
	if (checkquest(60123) != -1) {
		if (checkquest(60123,HUNTING) != 2 ) {
			mes "[拉尔忒斯]";
			mes "你已经猎杀 50 只奶油波利了吗？";
			next;
			switch(select("是:否:我想退出")) {
			case 1:
				mes "[拉尔忒斯]";
				mes "嗯，我觉得你还没猎杀 100 只……";
				close;
			case 2:
				mes "[拉尔忒斯]";
				mes "记住，我需要你帮忙猎杀奶油波利，去猎杀 100 只吧。";
				close;
			case 3:
				mes "[拉尔忒斯]";
				mes "你确定要停止猎杀吗？";
				mes "你取得的进度都会被清除。";
				next;
				switch(select("是:否")) {
				case 1:
					mes "[拉尔忒斯]";
					mes "好吧，改变主意后再回来。";
					erasequest 60123;
					close;
				case 2:
					mes "[拉尔忒斯]";
					mes "请猎杀 100 只奶油波利。";
					close;
				}
			}
		}
		else {
			mes "[拉尔忒斯]";
			mes "太厉害了，你完成得真快。";
			getexp 2950,1125;
			getexp 2950,1125;
			erasequest 60123;
			close;
		}
	}
	if (checkquest(60124) != -1) {
		if (checkquest(60124,HUNTING) != 2 ) {
			mes "[拉尔忒斯]";
			mes "你已经猎杀 150 只奶油波利了吗？";
			next;
			switch(select("是:否:我想退出")) {
			case 1:
				mes "[拉尔忒斯]";
				mes "嗯，我觉得你还没猎杀 150 只……";
				close;
			case 2:
				mes "[拉尔忒斯]";
				mes "记住，我需要你帮忙猎杀奶油波利，去猎杀 150 只吧。";
				close;
			case 3:
				mes "[拉尔忒斯]";
				mes "你确定要停止猎杀吗？";
				mes "你取得的进度都会被清除。";
				next;
				switch(select("是:否")) {
				case 1:
					mes "[拉尔忒斯]";
					mes "好吧，改变主意后再回来。";
					erasequest 60124;
					close;
				case 2:
					mes "[拉尔忒斯]";
					mes "请猎杀 150 只奶油波利。";
					close;
				}
			}
		}
		else {
			mes "[拉尔忒斯]";
			mes "太厉害了，你完成得真快。";
			getexp 2950,1125;
			getexp 2950,1125;
			getexp 2950,1125;
			erasequest 60124;
			close;
		}
	}
	//for minimum level
	if (BaseLevel > 14) {
		//for maximum level
		if (BaseLevel < 45) {
			mes "[拉尔忒斯]";
			mes "早上好！";
			mes "也许你可以帮我？";
			next;
			switch(select("当然:不了")) {
			case 1:
				mes "[拉尔忒斯]";
				mes "我在普隆德拉的一家药店工作。";
				mes "我来这里收集制药材料。";
				next;
				switch(select("收集物品:猎杀奶油波利:取消")) {
				case 1:
					// Item turn in
					mes "[拉尔忒斯]";
					mes "我需要储备足够的 ^FF0000蝴蝶粉末^000000";
					next;
					switch(select("我有蝴蝶粉末:你需要什么？")) {
					case 1:
						/*
						if (checkweight(502,5) == 0) {
							mes "[拉尔忒斯]";
							mes "嘿，你背包里的重量看起来会";
							mes "压垮你。减轻负重后再回来。";
							mes "";
							close;
						}
						*/
						if (countitem(924) > 24) {
							mes "[拉尔忒斯]";
							mes "嘿，再次感谢你。";
							mes "给你，这是答应你的。";
							delitem 924,25; //Powder_Of_Butterfly
							getexp 2950,1125;
							//getitem 502,5; //Orange_Potion
							close;
						}
						else {
							mes "[拉尔忒斯]";
							mes "看来你带的还不够。";
							next;
							mes "[拉尔忒斯]";
							mes "如果你带来 ^FF000025 个蝴蝶粉末^000000，";
							mes "我会给你一些医疗用品。";
							close;
						}
					case 2:
						mes "[拉尔忒斯]";
						mes "如果你带来 ^FF000025 个蝴蝶粉末^000000，";
						mes "我会给你一些医疗用品。";
						close;
					}
				case 2:
					// Kill Count Quest
					mes "[拉尔忒斯]";
					mes "啊，好吧，我想你可以猎杀一些奶油波利来帮我。";
					mes "你想猎杀多少？";
					next;
					switch(select("50 只奶油波利:100 只奶油波利:150 只奶油波利")) {
					case 1:
						mes "[拉尔忒斯]";
						mes "完成任务后回来，我会给你小奖励。";
						setquest 60122;
						close;
					case 2:
						mes "[拉尔忒斯]";
						mes "完成任务后回来，我会给你小奖励。";
						setquest 60123;
						close;
					case 3:
						mes "[拉尔忒斯]";
						mes "完成任务后回来，我会给你小奖励。";
						setquest 60124;
						close;
					}
				case 3:
					mes "[拉尔忒斯]";
					mes "改变主意后请回来。";
					close;
				}
			case 2:
				mes "[拉尔忒斯]";
				mes "改变主意后请回来。";
				close;
			}
		}
		else {
			mes "[拉尔忒斯]";
			mes "早上好！";
			next;
			mes "[拉尔忒斯]";
			mes "我在普隆德拉的一家药店工作";
			mes "我来这里收集制药材料。";
			close;
		}
	}
	else {
		mes "[拉尔忒斯]";
		mes "你的等级太低了！";
		next;
		mes "[拉尔忒斯]";
		mes "去多猎杀一些波利吧！";
		close;
	}
}

		}
		mes "[Dashia]";
		mes "我看出你有收集任务。";
		mes "但是，骷髅骨在哪里？";
		next;
		mes "[Dashia]";
		mes "你还没完成任务，为什么回来了？";
		next;
		mes "[Dashia]";
		mes "你的“骷髅骨”不够……狩猎骷髅即可找到。";
		next;
		mes "[Dashia]";
		mes "想找骷髅的话，最好去位于斐扬北部的弓箭手村地下城 1 楼。";
		break;
	case 2:
		callsub L_Quest,8275;
		if ((countitem(948) > 9) && (countitem(919) > 4)) {
			callsub L_Reward;
			getitem 569,100; //Novice_Potion
			delitem 948,10; //Bear's_Foot
			delitem 919,5; //Animal's_Skin
			getexp 1000,100;
			erasequest 8275;
			close;
		}
		mes "[Dashia]";
		mes "我看出你有收集任务。";
		mes "但是，熊掌皮和动物皮在哪里？";
		next;
		mes "[Dashia]";
		mes "你还没完成任务，为什么回来了？";
		next;
		mes "[Dashia]";
		mes "你必须带来 10 个熊掌皮和 5 个动物皮！";
		mes "你可以从大脚熊获得熊脚皮，从动物身上获得动物皮。";
		next;
		mes "[Dashia]";
		mes "大脚熊出现在吉芬原野北部或斐扬原野东南部。";
		break;
	case 3:
		callsub L_Quest,8276;
		if ((countitem(955) > 19) && (countitem(910) > 19)) {
			callsub L_Reward;
			delitem 955,20; //Worm_Peelings
			delitem 910,20; //Garlet
			getitem 569,100; //Novice_Potion
			getexp 1000,100;
			erasequest 8276;
			close;
		}
		mes "[Dashia]";
		mes "我看出你有收集任务。";
		mes "但是，虫皮和加勒特在哪里？";
		next;
		mes "[Dashia]";
		mes "你必须带来 20 个虫皮和 20 个加勒特才能完成任务。";
		next;
		mes "[Dashia]";
		mes "你可以从‘皮埃尔’、‘安德烈’、‘德尼罗’、‘维塔塔’、‘盗虫’、‘雌盗虫’和‘雄盗虫’身上获得这些物品。";
		next;
		mes "[Dashia]";
		mes "‘Piere’、‘Andre’、‘Deniro’和‘Vitata’位于蚂蚁地狱，那里在梦罗克西南方的圣达尔迈因要塞附近。";
		next;
		mes "[Dashia]";
		mes "‘盗虫’、‘盗虫（雌）’和‘盗虫（雄）’位于普隆德拉下水道。要前往那里，你必须成为普隆德拉下水道讨伐队的志愿者。";
		break;
	case 4:
		callsub L_Quest,8277;
		if ((countitem(942) > 9) && (countitem(1026) > 9) && (countitem(945) > 9)) {
			callsub L_Reward;
			delitem 942,10; //Yoyo_Tail
			delitem 1026,10; //Acorn
			delitem 945,10; //Raccoon_Leaf
			getitem 569,150; //Novice_Potion
			getexp 1000,200;
			erasequest 8277;
			close;
		}
		mes "[Dashia]";
		mes "我看出你有收集任务。";
		mes "但是，悠悠的尾巴、橡果和浣熊叶在哪里？";
		next;
		mes "[Dashia]";
		mes "你还没完成任务，为什么回来了？";
		mes "你必须带来 10 个悠悠尾巴、10 个橡果和 10 个浣熊叶才能完成任务。";
		next;
		mes "[Dashia]";
		mes "你可以从‘悠悠’获得悠悠尾巴，从‘可可’获得橡果，从‘烟尘’获得浣熊叶。";
		next;
		mes "[Dashia]";
		mes "原野附近很容易找到它们，但阿育他亚东部原野是同时猎杀这 3 种怪物的最佳地点。";
		next;
		mes "[Dashia]";
		mes "要前往阿育他亚，最好去艾尔贝塔找‘艾巴克辛’并支付路费。";
		break;
	case 5:
		callsub L_Quest,8278;
		if ((countitem(538) > 4) && (countitem(539) > 0)) {
			callsub L_Reward;
			delitem 538,5; //Well_Baked_Cookie
			delitem 539,1; //Piece_Of_Cake
			getitem 569,150; //Novice_Potion
			getexp 1000,200;
			erasequest 8278;
			close;
		}
		mes "[Dashia]";
		mes "我看出你有收集任务。";
		mes "但是，烤好的曲奇和蛋糕块在哪里？";
		next;
		mes "[Dashia]";
		mes "你还没完成任务，为什么回来了？";
		mes "你必须带来 5 个烤好的曲奇和 1 个蛋糕块才能完成任务。";
		next;
		mes "[Dashia]";
		mes "你可以从穿红色或绿色衣服的‘曲奇’获得烤好的饼干。";
		mes "想获得蛋糕碎片，就去找‘惊骇箱’。";
		next;
		mes "[Dashia]";
		mes "这两种怪物都能在玩具工厂仓库或玩具监控室找到。要去那里，请向艾尔迪巴兰东北部的克劳斯先生询问。";
		break;
	case 6:
		callsub L_Quest,8279;
		if ((countitem(1017) > 4) && (countitem(1018) > 2)) {
			callsub L_Reward;
			delitem 1017,5; //Moustache_Of_Mole
			delitem 1018,3; //Nail_Of_Mole
			getitem 569,150; //Novice_Potion
			getexp 1000,200;
			erasequest 8279;
			close;
		}
		mes "[Dashia]";
		mes "我看出你有收集任务。";
		mes "但是，鼹鼠胡须和鼹鼠爪在哪里？？";
		next;
		mes "[Dashia]";
		mes "你还没完成任务，为什么回来了？";
		mes "你必须带来 5 根鼹鼠胡须和 3 个鼹鼠爪才能完成任务。";
		next;
		mes "[Dashia]";
		mes "这些物品可以从“马丁”获得。";
		mes "马丁可以在妙勒尼废矿找到，但二楼很危险，请小心！";
		next;
		mes "[Dashia]";
		mes "要去那里，请询问吉芬的卡普拉职员，她们可以把你传送过去。";
		break;
	}
	next;
	mes "[Dashia]";
	mes "总之我会在这里等你。完成任务后请回来！";
	close;
L_Quest:
	if (checkquest(getarg(0)) != 1) {
		mes "[Dashia]";
		mes "嗯？确定吗？似乎有问题……";
		next;
		mes "[Dashia]";
		mes "真奇怪。";
		mes "请按“Alt + U”检查任务窗口。";
		close;
	}
	return;
L_Reward:
	mes "[Dashia]";
	mes "哇~你做得非常好！";
	next;
	mes "[Dashia]";
	mes "非常感谢。愿神保佑你！";
	emotion ET_SMILE;
	next;
	mes "[Dashia]";
	mes "哈~！哈~！";
	mes "我会按约定给你奖励。";
	return;
}

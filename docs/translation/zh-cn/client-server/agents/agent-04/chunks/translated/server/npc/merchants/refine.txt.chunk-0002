				mes "[Paul Spanner]";
				mes "你需要 5 个矿石才能加工成 1 个纯化铝。";
				close;
			}
			else {
				delitem 757,5; //Elunium_Stone
				getitem 985,1; //Elunium
				mes "[Paul Spanner]";
				mes "给你。感谢使用我的服务。";
				close;
			}
		case 3:
			mes "[Paul Spanner]";
			mes "有需要尽管告诉我。";
			close;
		}
	case 5:
		mes "[Paul Spanner]";
		mes "有需要尽管告诉我。";
		close;
	}
}


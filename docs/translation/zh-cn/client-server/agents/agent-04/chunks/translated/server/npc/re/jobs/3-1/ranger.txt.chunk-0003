job3_rang02,111,56,3	script	Staff Rust#jr_09	89,{
	if (job_ranger01 == 6) {
		if (countitem(12258) < 1) {
			percentheal 100,0;
			specialeffect2 EF_ABSORBSPIRITS;
			mes "[Staff Rust]";
			mes "我会给你“爆弹胶囊”。";
			mes "只有用完“爆弹胶囊”的人才能再次领取，请记住。";
			if (countitem(6156)) {
				getitem 12258,5; //Bombring_Box
				close;
			}
			next;
			emotion ET_FRET;
			mes "[Staff Rust]";
			mes "任务是……把这些文件交给主管 Caution。他不会收我的东西……";
			setquest 8260;
			getitem 6156, (MaxWeight-Weight-2000)/10; //Approval_Report
			getitem 12258,10; //Bombring_Box
			getitem 569,100; //Novice_Potion
			close;
		}
		mes "[Staff Rust]";
		mes "抱歉，你已经有“爆弹胶囊”，所以我不能再给你。";
		close;
	}
	mes "[Staff Rust]";
	mes "请问你是怎么进来的？";
	next;
	mes "[Staff Rust]";
	mes "如果你不是来参加转职测试的，请离开。";
	close;
OnInit:
	disablenpc "Staff Rust#jr_09";
	end;
OnEnable:
	enablenpc "Staff Rust#jr_09";
	donpcevent "Summon Monster#jr_10::OnEnable";
	donpcevent "Test Supervisor#jr_11::OnEnable";
	end;
OnDisable:
	disablenpc "Staff Rust#jr_09";
	end;
}


		mes "[Sikaiz]";
		mes "我建议你，";
		mes "如果能和里面的生物友好相处，";
		mes "那会是很好的信息来源。";
		mes "我相信你。";
		next;
		mes "[Sikaiz]";
		mes "总结一下。";
		mes "你需要尽可能调查并向我们报告。这并不难。";
		next;
		changequest 10072,10073;
		set ep13_ryu,17;
		mes "[Sikaiz]";

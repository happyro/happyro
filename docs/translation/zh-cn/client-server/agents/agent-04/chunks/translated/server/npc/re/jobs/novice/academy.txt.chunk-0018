
// =============================================================================
// = Archer
// =============================================================================

// - Archer Teacher (Marlbron)
// -----------------------------------------------------------------------------
iz_ac02,65,109,5	script	Archer Teacher#ac	4_M_ARCHER,{
	if (!checkweight(1304,3)) {
		mes "你为什么带这么多东西？找地方卸下后再回来。";
		close;
	}
	if (Class == Job_Archer) {
		if (nov_3_archer == 0) {
			cutin "gnor.bmp", 2;
			mes "[Marlbron]";
			mes "嗯……这是？";
			next;
			mes "[Marlbron]";
			mes "你从未接受过我的训练。";
			mes "那我对你没兴趣。";
			close2;
			cutin "", 255;
			end;
		} else if (nov_3_archer > 0 && nov_3_archer < 9) {
			cutin "gnor.bmp", 2;
			mes "[Marlbron]";
			mes "看来你在斐扬接受了完整教育。";
			next;
			mes "[Marlbron]";
			mes "不过……你也许想学更多。";
			next;
			mes "[Marlbron]";
			mes "无论如何，我没什么能教你的。";
			close2;
			cutin "", 255;
			end;
		} else {
			cutin "gsmi.bmp", 2;
			mes "[Marlbron]";
			mes "啊~你已经成为熟练的弓箭手。";
			next;
			mes "[Marlbron]";
			mes "和初心者时期相比，现在差别很大！";
			next;
			mes "[Marlbron]";
			mes "因为我的教导，你成长得很快！";
			close2;
			cutin "", 255;
			end;
		}
	} else if (Class == Job_Novice) {
		if (isbegin_quest(4269) == 2) {
			if (nov_3_archer == 0) {
				cutin "gsmi.bmp", 2;
				mes "[Marlbron]";
				mes "嗅嗅！这是初心者的气味！";
				mes "很高兴认识你！！！";
				mes "你为什么来这里？";
				next;
				mes "[Marlbron]";
				mes "大部分我都能猜到，嘿嘿嘿～～";
				mes "放轻松，把你想说的都告诉我！";
				next;
				cutin "", 255;
				if (select("我好无聊！陪我玩！", "告诉我弓箭手的事。") == 1) {
					cutin "gbad.bmp", 2;
					mes "[Marlbron]";
					mes "什么？无聊？陪你玩？";
					mes "你以为这里不过是孩子们的游乐场吗？";
					next;
					mes "[Marlbron]";
					mes "无聊的话到处走走，打怪物一拳看看会怎样。";
					close2;
					cutin "", 255;
					end;
				}
				cutin "gsmi.bmp", 2;
				mes "[Marlbron]";
				mes "哎呀～又一只来听我免费课程的小羊。";
				next;
				mes "[Marlbron]";
				mes "弓箭手的要点是用弓从远距离快速攻击敌人。";
				next;
				mes "[Marlbron]";
				mes "唯一问题是身体较弱。";
				mes "不过，只要训练得当就没关系。";
				next;
				while(1) {
					cutin "gnor.bmp", 2;
					mes "[Marlbron]";
					mes "想了解弓箭手什么？我会全部告诉你~";
					mes "听完我的完整讲解～你就能成为优秀的弓箭手。";
					next;
					switch(select("弓箭手属性", "弓箭手技能", "我想成为弓箭手。", "没什么")) {
					case 1:
						cutin "gnor.bmp", 2;
						mes "[Marlbron]";
						mes "你对弓箭手属性感到好奇吗？";
						mes "你知道弓箭手最需要的属性吗？";
						next;
						mes "[Marlbron]";
						mes "那就是^0000cdDex^000000。";
						next;
						mes "[Marlbron]";
						mes "其他职业要提升攻击力应该提高 Str，但弓箭手的能力取决于 Dex 数值。";
						next;
						mes "[Marlbron]";
						mes "一个简单的问题！决定弓箭手攻击力的属性叫什么？";
						next;
						select("Dex！");
						cutin "gsmi.bmp", 2;
						mes "[Marlbron]";
						mes "你答对了~~";
						next;
						cutin "gnor.bmp", 2;
						mes "[Marlbron]";
						mes "如果想了解其他属性的作用，^0000cd按 ALT+Q 打开状态窗口。^000000";
						next;
						mes "[Marlbron]";
						mes "如果对 Dex 以外的属性好奇，可以在那里查看。";
						mes "以后转职后，无论如何都可以重置属性。";
						next;
						mes "[Marlbron]";
						mes "嘿，点这里和那里就行了！";
						next;
						cutin "", 255;
						break;
					case 2:
						cutin "gnor.bmp", 2;
						mes "[Marlbron]";
						mes "嗯。你对技能感兴趣？那我们来学习^0000cd技能^000000。";
						next;
						mes "[Marlbron]";
						mes "我想亲自体验技能比听讲更好，所以把弓箭手技能的体验写进了手册。";
						next;
						mes "[Marlbron]";
						mes "弓箭手有许多非常实用的技能。";
						mes "但遗憾的是，大多数技能只有配合弓箭才能使用，所以你无法体验。";
						next;
						mes "[Marlbron]";
						mes "有一个不需要弓的实用技能……叫作^0000cd集中力提升^000000。";
						next;
						mes "[Marlbron]";
						mes "同时，它还会揭示附近隐藏的敌人。";
						next;
						mes "[Marlbron]";
						mes "想了解更多技能，就按^0000cdALT+S^000000打开技能窗口。";
						next;
						mes "[Marlbron]";
						mes "将鼠标悬停在技能图标上，会显示技能详情。请仔细阅读。";
						next;
						mes "[Marlbron]";
						mes "要使用技能，点击技能窗口中的技能图标，然后将其拖动并登记到^0000cd快捷栏^000000，方便使用。";
						next;
						mes "[Marlbron]";
						mes "你要去一楼找狩猎导师吗？不想去也没关系。";
						next;
						mes "[Marlbron]";
						mes "不过他可以教你许多实用的狩猎技能。";
						mes "<NAVI>^4D4DFF[Battle Trainer Subino]^000000<INFO>iz_ac01,59,83,</INFO></NAVI>";
						mes "你可以去拜访他。";
						// next;
						close2;
						if (isbegin_quest(14158) != 2) {
							setquest 14158;
							completequest 14158;
							getitem 2822,1;// Archer_Manual
						}
						cutin "", 255;
						end;
					case 3:
						cutin "gnor.bmp", 2;
						mes "[Marlbron]";
						mes "你想成为^0000cd弓箭手^000000吗？";
						mes "我们相识还没多久，但要和你道别，我感到很难过。";
						next;
						mes "[Marlbron]";
						mes "让我确认一下，转职前你的职业等级必须达到 10。";
						next;
						if (JobLevel == 10) {
							mes "[Marlbron]";
							mes "转职条件满足！！";
							next;
							mes "[Marlbron]";
							mes "你真的想成为弓箭手吗？";
							next;
							if (select("是，把我转为弓箭手。", "让我再想想。") == 1) {
								mes "[Marlbron]";
								mes "首先，让我向你说明一些转职的事情。";
								next;
								mes "[Marlbron]";
								mes "弓箭手的故乡是有悠久历史的^0000cd斐扬^000000。";
								next;
								mes "[Marlbron]";
								mes "感到疲惫时，你可以去那里。";
								mes "故乡会热情欢迎你。";
								next;
								mes "[Marlbron]";
								mes "弓箭手公会位于^0000cd斐扬弓箭手村北部^000000。";
								next;
								mes "[Marlbron]";
								mes "我会带你到斐扬城门。";
								mes "我很想陪你走完剩下的路，但你必须独自完成。";
								mes "我会告诉你必须记住的路线。";
								next;
								cutin "paymap1.bmp", 3;
								mes "[Marlbron]";
								mes "我会把你送到这里。";
								mes "到达后，你会看到这个^0000cd红色圆圈^000000标记的区域。穿过那里，然后……";
								next;
								cutin "paymap2.bmp", 3;
								mes "[Marlbron]";
								mes "你会抵达斐扬村。";
								mes "沿着^0000cd红色箭头^000000的方向走，就会进入^0000cd弓箭手村^000000。";
								next;
								cutin "paymap3.bmp", 3;
								mes "[Marlbron]";
								mes "到达那里后，前往^0000cd圆圈区域^000000。那里就是^0000cd弓箭手转职公会^000000。";
								mes "明白了吗？很好找，对吧？";
								next;
								cutin "gnor.bmp", 2;
								mes "[Marlbron]";
								mes "有卫星导航，你不用担心迷路。";
								mes "不过，如果仍然担心，可以询问当地的^0000cd导游^000000。";
								next;
								mes "[Marlbron]";
								mes "参观公会后，你可以再来找我。";
								next;
								mes "[Marlbron]";
								mes "那么，祝你成功成为弓箭手。下次见！";
								close2;
								cutin "", 255;
								nov_3_archer = 1;
								setquest 14142;
								warp "pay_fild01", 339, 346;
								end;
							}
							cutin "gnor.bmp", 2;
							mes "[Marlbron]";
							mes "好，重新考虑后再来找我。";
							close2;
							cutin "", 255;
							end;
						} else {
							cutin "gnor.bmp", 2;
							mes "[Marlbron]";
							mes "嗯。你的职业等级还差一点。";
							mes "训练后还会回来吗？";
							next;
							mes "[Marlbron]";
							mes "请前往<NAVI>^4D4DFF[战斗训练师 Subino]^000000<INFO>iz_ac01,59,83,</INFO></NAVI>";
							mes "地点在一楼军械库。";
							close2;
							cutin "", 255;
							end;
						}
					case 4:
						cutin "gnor.bmp", 2;
						mes "[Marlbron]";
						mes "真的吗？那就别偷懒，去训练吧。";
						close2;
						cutin "", 255;
						end;
					}
				}
			} else if (nov_3_archer == 1) {
				cutin "gnor.bmp", 2;
				mes "[Marlbron]";
				mes "你怎么还在这里？不打算成为弓箭手吗？";
				mes "你要选择其他职业吗？";
				close2;
				cutin "", 255;
				end;
			} else {
				cutin "gnor.bmp", 2;
				mes "[Marlbron]";
				mes "怎么样？成为弓箭手感觉如何？";
				mes "俗话说，青出于蓝而胜于蓝。";
				close2;
				cutin "", 255;
				end;
			}
		} else if (isbegin_quest(4269) == 1) {
			cutin "gnor.bmp", 2;
			mes "[Marlbron]";
			mes "你似乎还没有完成学院登记。";
			mes "快去完成登记。";
			close2;
			cutin "", 255;
			end;
		} else {
			cutin "gnor.bmp", 2;
			mes "[Marlbron]";
			mes "你还没填写克里图拉学院的入学申请，就直接来这里了吗？";
			mes "你太着急了。快去一楼申请，然后回来找我。";
			close2;
			cutin "", 255;
			end;
		}
	} else {
		cutin "gbad.bmp", 2;
		mes "[Marlbron]";
		mes "你已经是其他职业了，为什么还在这里窥探？";
		next;
		mes "[Marlbron]";
		mes "别鬼鬼祟祟的，快离开这里！！";
		close2;
		cutin "", 255;
		end;
	}
}

iz_ac02_a,65,109,5	duplicate(Archer Teacher#ac)	Archer Teacher#ac_a	4_M_ARCHER
iz_ac02_b,65,109,5	duplicate(Archer Teacher#ac)	Archer Teacher#ac_b	4_M_ARCHER
iz_ac02_c,65,109,5	duplicate(Archer Teacher#ac)	Archer Teacher#ac_c	4_M_ARCHER
iz_ac02_d,65,109,5	duplicate(Archer Teacher#ac)	Archer Teacher#ac_d	4_M_ARCHER

// =============================================================================
// = Swordsman
// =============================================================================

// - Swordman Trainer (Adric)
// - Teaches the player about the Swordman class.
// -----------------------------------------------------------------------------
iz_ac02,60,51,5	script	Swordman Trainer#ac	4_M_SWORDMAN,{
	if (!checkweight(1301,3)) {
		mes "- Quest cannot be continued due to your overfilled inventory. -";
		close;
	}
	cutin "aca_sword.bmp", 2;
	if (isbegin_quest(4269) != 2) {
		mes "[Trainer Adric]";
		mes "你想了解剑士吗？";
		mes "想参加课程就必须先登记。";
		next;
		mes "[Trainer Adric]";
		mes "去一楼柜台登记吧！";
		cutin "", 255;
		close;
	}
	if (Class == Job_Novice) {
		if (!nov_3_swordman) {
			mes "[Trainer Adric]";
			mes "你想成为剑士？";
			mes "真是个好决定。";
			next;
			mes "[Trainer Adric]";
			mes "用大剑在前线战斗，";
			mes "带来胜利，并以高防御保护伙伴。";
			mes "简单来说，我们就是最强的。";
			next;
			mes "[Trainer Adric]";
			mes "你觉得怎么样？";
			mes "要在这里成为剑士吗？";
			next;
			switch(select("不用了", "我想测试剑士技能！", "现在就让我转职！")) {
			case 1:
				mes "[Trainer Adric]";
				mes "既然你对这个机会没兴趣，";
				next;
				mes "[Trainer Adric]";
				mes "那就去猎杀波利，";
				mes "永远当初心者吧！";
				cutin "", 255;
				close;
			case 2:
				mes "[Trainer Adric]";
				mes "冷静，我们重新开始。";
				mes "首先，我会给你一本^FF0000剑士手册^000000。";
				mes "提问前请仔细阅读。";
				getitem 2819,1;// Swordman_Manual
				nov_3_swordman = 1;
				setquest 1229;
				cutin "", 255;
				close;
			case 3:
				if (JobLevel < 10) {
					mes "[Trainer Adric]";
					mes "如果你想成为剑士，";
					mes "基础等级应达到^00640010^000000，";
					mes "并且初心者技能等级应超过^0064009^000000。";
					next;
					mes "[Trainer Adric]";
					mes "在这里接受指导并按步骤进行。";
					cutin "", 255;
					close;
				} else {
					mes "[Trainer Adric]";
					mes "看来你已经学得够多了。";
					mes "前往剑士公会，";
					mes "继续转职为剑士！";
					next;
					mes "[Trainer Adric]";
					mes "剑士公会位于";
					mes "依斯鲁得广场中心西侧。";
					mes "应该很容易找到。";
					cutin "", 255;
					nov_3_swordman = 4;
					if (isbegin_quest(1230))
						erasequest 1230;
					close;
				}
			}
		} else if (nov_3_swordman == 1) {
			mes "[Trainer Adric]";
			mes "如果你装备了^FF0000剑士手册^000000，";
			mes "就可以体验剑士的基础技能。";
			mes "现在来学习剑士技能的基础知识。";
			next;
			while(1) {
				switch(select("剑士要点", "提高攻击和防御。", "相关属性", "其他剑士职业？", "我已经学够了。")) {
				case 1:
					mes "[Trainer Adric]";
					mes "剑士拥有强健体魄，能轻松承受敌人伤害；组队时还是队伍的领导者和保护者。";
					next;
					continue;
				case 2:
					mes "[Trainer Adric]";
					mes "剑士偏好使用长矛、双手剑，或剑盾组合。";
					next;
					mes "[Trainer Adric]";
					mes "剑士通常拥有很高的活力，因此能够携带大量重量。";
					next;
					continue;
				case 3:
					mes "[Trainer Adric]";
					mes "通常推荐的属性是^0000FFStr^000000、^0000FFAgi^000000、^0000FFVit^000000、^0000FFDex^000000。";
					mes "当然，最终由你自己决定。";
					next;
					mes "[Trainer Adric]";
					mes "^0000FFVit^000000影响^FF0000HP 恢复速度^000000。";
					mes "^0000FFStr^000000影响^FF0000力量和攻击力^000000。";
					mes "^0000FFDex^000000提高^FF0000攻击命中率^000000，";
					next;
					mes "[Trainer Adric]";
					mes "^0000FFAgi^000000提高^FF0000攻击速度^000000和^FF0000闪避率^000000，";
					mes "^0000FFLuk^000000影响^FF0000暴击概率^000000。";
					next;
					continue;
				case 4:
					mes "[Trainer Adric]";
					mes "转职为剑士后，你可以继续转职为^0000FF骑士^000000或^0000FF十字军^000000。";
					next;
					mes "[Trainer Adric]";
					mes "提升力量，同时思考自己要走攻击还是防御路线。";
					mes "这是你应该做的事。";
					next;
					continue;
				case 5:
					break;
				}
				break;
			}
			mes "[Trainer Adric]";
			mes "助理训练师 Neals 可以重新讲解学习材料。";
			mes "记住这一点。";
			nov_3_swordman = 2;
			if (isbegin_quest(1229))
				erasequest 1229;
			setquest 1230;
			cutin "", 255;
			close;
		} else if (nov_3_swordman == 2) {
			if (JobLevel < 10) {
				mes "[Trainer Adric]";
				mes "使用我给你的剑士手册，通过猎杀怪物进行训练。";
				mes "去一楼军械库的战斗教官 Subino 那里。";
				next;
				mes "[Trainer Adric]";
				mes "将职业等级提升到^00640010^000000，并达到^006400初心者技能等级 9^000000，再回来找我。";
				nov_3_swordman = 3;
				if (isbegin_quest(1230))
					erasequest 1230;
				cutin "", 255;
				close;
			} else {
				mes "[Trainer Adric]";
				mes "既然你的职业等级已经足够，";
				mes "就不需要再听课了。";
				next;
				switch(select("那我就不听了。", "但我想继续听。", "我想马上成为剑士！")) {
				case 1:
					mes "[Trainer Adric]";
					mes "你已经超越学习材料，提升了等级。";
					next;
					mes "[Trainer Adric]";
					mes "令人印象深刻。";
					cutin "", 255;
					close;
				case 2:
					mes "[Trainer Adric]";
					mes "没有其他特别的内容可以教你了。";
					mes "只要记住我教你的全部内容，就足够了。";
					next;
					mes "[Trainer Adric]";
					mes "如果需要额外训练，";
					mes "去找战斗教官 Subino，";
					mes "他在一楼军械库。";
					next;

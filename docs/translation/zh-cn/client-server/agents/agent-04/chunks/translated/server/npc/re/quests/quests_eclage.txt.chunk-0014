}


eclage,156,56,3	script	Residence entrance#e_prt	CLEAR_NPC,{
	if (ep14_2_detect) {
		mes "- 它漂浮在半空中，";
		mes "感觉我可以";
		mes "进入其中。-";
		next;
		if (select("不要进入住宅。:进入住宅。") == 1) {
			mes "- 之后再来看看。-";
			close;
		}
		warp "ecl_in04",77,107;
	}
	end;
}


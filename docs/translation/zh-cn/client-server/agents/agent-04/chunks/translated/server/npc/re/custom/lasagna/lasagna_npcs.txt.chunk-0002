		lasagna_quest[0] = 5;
		next;
		mes "！- 注意 -！";
		mes "^4d4dff有时 NPC 会通过导航工具帮助你找到目的地。";
		mes "如有需要可以创建链接。看到[目标]时点击它即可寻路。^000000";
		cutin "navi01.bmp",4;
		next;
		mes "！- 注意 -！";
		mes "^4d4dff点击相应菜单图标打开导航面板。";
		mes "搜索目标，设定目的地，然后点击寻路。";
		mes "系统会生成指向目标位置的箭头。^000000";
		cutin "navi02.bmp",4;
		navigateto "lasagna",168,124;
		close3;
	}
	if (lasagna_quest[0] == 5) {
		mes "[Vigilante Aglio]";
		mes "你面前就是港口村庄拉萨格纳。";
		mes "你应该先把那个箱子送到工具店，对吧？";
		next;
		mes "[Vigilante Aglio]";
		mes "我来告诉你如何到达村庄。";
		mes "跟着地面上刚出现的箭头走。";
		next;
		mes "[Vigilante Aglio]";
		mes "我会紧跟在你后面！";
		mes "别担心我。继续前进。";
		navigateto "lasagna",168,124;
		close;
	}
	mes "[Vigilante Aglio]";
	mes "你还没前往米德加尔特吗？";
	mes "港口偶尔会出问题，但我想这对你来说不成问题。";
	close;
OnInit:
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "isbegin_quest(7712) > 0 && (checkquest(7713,HUNTING) == -1 || checkquest(7713,HUNTING) == 2)" );
	end;
}

lasa_fild01,62,321,3	script	Kid#doram03t	HIDDEN_WARP_NPC,{ end; }

lasa_fild01,132,374,3	script	Sloth#doram	4_DR_KID_01,3,3,{
	if (checkweight(1001,3) == 0) {
		mes "- 等一下！！ -";
		mes "- 你的物品太多了。 -";
		mes "- 这意味着你无法再接收物品。 -";
		mes "- 腾出一些空间 -";
		mes "- 然后再试一次。 -";
		close;
	}
	switch( isbegin_quest(7719) ) {
	case 0:
		mes "[Sloth]";
		mes "嗯……你看起来精力充沛。";
		mes "你看，我胃不舒服。";
		next;
		mes "[Sloth]";
		mes "天气晴朗温暖，但是……";
		mes "我觉得今天糟透了……";
		next;
		mes "[Sloth]";
		mes "我应该拔掉这片药草地里的所有红草……";
		next;
		mes "[Sloth]";
		mes "但在这晴朗天气里我吃得很饱……";
		mes "而且微风习习……";
		next;
		mes "[Sloth]";
		mes "我觉得自己根本爬不起来。";
		mes "但我本该拔红草……";
		mes "如果你来做，我就给你凤尾鱼，好吗？";
		next;
		switch( select( "我来替你拔红草。", "懒虫，快动起来！" ) ) {
		case 1:
			mes "[Sloth]";
			mes "^4d4dff在这里拔 3 株红草并收集 2 株红色药草^000000！";
			next;
			mes "[Sloth]";
			mes "这可能会对你很有帮助！";
			mes "那么，拜托你了。";
			next;
			mes "[Sloth]";
			mes "我会在这里休息，让胃舒服些。";
			setquest 7719;// Time to Digest
			close;
		case 2:
			mes "[Sloth]";
			mes "喵呜……";
			mes "……喵呜……";
			close;
		}
	case 1:
		if (checkquest(7719,HUNTING) != 2) {
			mes "[Sloth]";
			mes "我想要的并不多。";
			mes "只要^4d4dff在这里拔红草并收集 2 株红色药草^000000。就这些。";
			next;
			mes "[Sloth]";
			mes "它们长得太快，不管拔多少次都会继续长。我受够了……";
			close;
		}
		if (countitem(507) < 2) {
			mes "[Sloth]";
			mes "我想要的并不多。";
			mes "只要^4d4dff在这里拔红草并收集 2 株红色药草^000000。就这些。";
			close;
		}
		mes "[Sloth]";
		mes "哦……这个香味！";
		mes "你拔的红色药草正好。";
		next;
		mes "[Sloth]";
		mes "我会像嚼树枝一样吃掉它们并消化。喵！";
		next;
		mes "[Sloth]";
		mes "剩下的药草就作为奖励给你。";
		mes "嚼碎它们，^4d4dff你的 HP 就会恢复。^000000";
		next;
		mes "[Sloth]";
		mes "如果你问春，她会告诉你如何把它们制成效果更强的药剂。";
		next;
		mes "[Sloth]";
		mes "总之，我是知恩图报的猫。";
		mes "这个给你。";
		mes "别惹麻烦。";
		completequest 7719;
		delitem 507,1;// Red Herb
		getitem 11601,20;// Delicious Anchovy
		getitem 12323,10;// Novice Fly Wing
		getitem 12324,10;// Novice Butterfly Wing
		getexp 80,80;
		close;
	case 2:
		mes "[Sloth]";
		mes "我感觉……好累……";
		close;
	}
OnTouch:
	if (isbegin_quest(7719) == 2)
		npctalk "~Growling~", "", bc_self;
	else
		npctalk "Hey, there! Get over here for a minute!", "", bc_self;
	end;
OnInit:
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "!isbegin_quest(7719)" );
	end;
}

lasa_fild01,103,344,3	script	Well-known Troublemaker	4_DR_KID_01,3,3,{
	if (Class != Job_Summoner) {
		mes "[Well-known Troublemaker]";
		mes "人类，你大老远来到这里做什么？";
		mes "滚开！滚开，喵呜！";
		next;
		mes "[Well-known Troublemaker]";
		mes "这里像是一道门户。绝不能也不应该被人类玷污！";
		close;
	}
	switch( isbegin_quest(7721) ) {
	case 0:
		mes "[Well-known Kittie]";
		mes "嘿，朋友！";
		mes "喵呵呵！喵呵呵！你看起来忙忙碌碌的。要去哪里？";
		mes "在我看来，你像是刚翻过山脊的新手冒险者，喵。";
		next;
		mes "[Well-known Kittie]";
		mes "你是不是太弱，无法对付拉萨格纳的杜拉姆？";
		next;
		mes "[Well-known Kittie]";
		mes "你知道怎么使用技能吗？";
		mes "在我看来，你只是个胡闹的新手。";
		next;
		select( "我比你更擅长战斗！", "哇，真的吗？" );
		mes "[Well-known Kittie]";
		mes "喵呵！喵呵！你竟敢不尊重我？";
		mes "要不要和我打个赌？";
		next;
		mes "[Well-known Kittie]";
		mes "我给你整整10分钟，在这里猎杀^4d4dff3只叶子疯兔和2只草叶妖^000000！";
		next;
		mes "[Well-known Kittie]";
		mes "如果你能证明自己的实力，我就不再挡你的路。";
		next;
		switch( select( "接受。", "拒绝。" ) ) {
		case 1:
			mes "[Well-known Kittie]";
			mes "你有 10 分钟。不多不少！";
		mes "^4d4dff3只叶子疯兔和2只草叶妖！^000000";
			setquest 7721;// Cat showoff contest
			close;
		case 2:
			mes "[Well-known Kittie]";
			mes "你要逃跑吗？！";
			mes "胆小的冒险者无法在新大陆生存！";
			close;
		}
	case 1:
		.@quest_hunting = checkquest(7721,HUNTING);
		.@quest_playtime = checkquest(7721,PLAYTIME);
		if (.@quest_playtime < 2 && .@quest_hunting < 2) {
			mes "[Well-known Kittie]";
			mes "请在^4d4dff10分钟^000000内消灭这里的^4d4dff3只叶子疯兔和2只草叶妖^000000！";
			close;
		}
		if (.@quest_playtime == 2 && .@quest_hunting < 2) {
			mes "[Well-known Kittie]";
			mes "喵呵呵！！喵呵呵！！";
			mes "对你来说太难了吗？";
			mes "你觉得怎么样？想再试一次吗？";
			next;
			mes "[Well-known Kittie]";
			mes "太难了吗？";
			mes "狩猎时你会好好使用^4d4dff技能^000000吗？";
			next;
			mes "[Well-known Kittie]";
			mes "按[Alt+S]快捷键或点击对应技能图标，即可^4d4dff打开技能树^000000。";
			next;
			mes "[Well-known Kittie]";
			mes "设置想使用的技能，这样战斗中就能使用。";
			next;
			mes "[Well-known Kittie]";
			mes "^4d4dff手动激活的技能^000000可以^4d4dff放到快捷栏^000000中快速使用。";
			next;
			mes "[Well-known Kittie]";
			mes "……现在你知道如何使用技能了。";
		mes "那么，你打算怎么办？";
			next;
			switch( select( "再试一次。", "我现在就退出！" ) ) {
			case 1:
				mes "[Well-known Kittie]";
				mes "你很有胆量，我喜欢！好吧，再试一次！";
				erasequest 7721;
				setquest 7721;// Cat showoff contest
				close;
			case 2:
				mes "[Well-known Kittie]";
				mes "抱着这种软弱心态，你怎么在新大陆生存？";
				mes "喵呵呵！喵呵呵！我是这里最强的杜拉姆！";
				close;
			}
		}
		if (.@quest_playtime < 2 && .@quest_hunting == 2) {
			mes "[Well-known Kittie]";
			mes "嗯……你很厉害。遇到像你这样能干的杜拉姆，我总觉得受到了挑战。";
		}
		else {
			mes "[Well-known Kittie]";
			mes "时间到了！喵呵呵！！这再次证明我是这里最强的！";
		}
		next;
		mes "[Well-known Kittie]";
		mes "你出色地完成了任务，所以我想反过来帮你。";
		next;
		mes "[Well-known Kittie]";
		mes "对了，你知道^4d4dff技能树^000000是什么吗？我教过你吗？还记得吗？";
		next;
		mes "[Well-known Kittie]";
		mes "按[Alt+S]快捷键或点击对应技能图标，即可^4d4dff打开技能树^000000。";
		next;
		mes "[Well-known Kittie]";
		mes "设置想使用的技能，这样战斗中就能使用。";
		next;
		mes "[Well-known Kittie]";
		mes "^4d4dff手动激活的技能^000000可以^4d4dff放到快捷栏^000000中快速使用。";
		next;
		mes "[Well-known Kittie]";
		mes "……现在你知道如何使用技能了。";
		mes "你应该感谢我。喵呵呵！";
		completequest 7721;// Cat showoff contest
		getexp 120,120;
		close2;
		setpcblock PCBLOCK_NPC, true;
		classchange( 4_DR_AGLIO, "Vigilante Aglio#doram12", bc_self );
		sleep2 1000;
		npctalk "你！你在和另一个无辜的路人打架吗？", "Vigilante Aglio#doram12", bc_self;
		sleep2 2000;
		npctalk "打架？这叫训练！", "Well-known Troublemaker", bc_self;
		sleep2 2000;
		npctalk "闭嘴！你一回村就加入治安队，听见了吗？", "Vigilante Aglio#doram12", bc_self;
		sleep2 2000;
		npctalk "呃，呃……我……呃……我只是自由奔放！仅此而已！", "Well-known Troublemaker", bc_self;
		sleep2 2000;
		npctalk "够了。" + strcharinfo(0) + "，下一个目的地是村里的工具店。我再告诉你怎么走。", "Vigilante Aglio#doram12", bc_self;
		sleep2 2000;
		npctalk "村里再见！", "Vigilante Aglio#doram12", bc_self;
		navigateto "lasagna",168,124;
		sleep2 2000;
		npctalk "你真会胡说。", "Well-known Troublemaker", bc_self;
		classchange( HIDDEN_WARP_NPC, "Vigilante Aglio#doram12", bc_self );
		setpcblock PCBLOCK_NPC, false;
		end;
	case 2:
		mes "[Well-known Kittie]";
		mes "你需要再听一遍说明吗？";
		next;
		mes "[Well-known Kittie]";
		mes "这个世界的生活没有什么特别。";
		mes "你最好熟悉技能树，点击技能图标即可打开。";
		next;
		mes "[Well-known Kittie]";
		mes "战斗杜拉姆专精召唤。";
		mes "专注使用召唤技能，才能赢得战斗。";
		close;
	}

OnTouch:
	if (Class == Job_Summoner && isbegin_quest(7721) == 0)
		npctalk "喵呜？？这是我以前没见过的外地多拉姆吗？", "", bc_self;
	end;

OnInit:
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "isbegin_quest(7716) == 1 && isbegin_quest(7721) != 2" );
	end;
}

lasa_fild01,102,342,7	script	Vigilante Aglio#doram12	HIDDEN_WARP_NPC,{ end; }

-	shop	Cat Paw Shrimp Merchant#shop::doram_shrimp	-1,515:-1,567:-1,11602:-1

lasagna,168,125,3	script	Kid#doram04t	4_DR_KID_01,{
	if (lasagna_quest[0] == 5) {
		if (countitem(1081) > 0) {
			mes "[Kitten]";
			mes "就是这个！！";
			next;
			mes "小猫高高举起别人交给他的箱子，开心地大叫。";
			next;
			mes "[工具商人]";
			mes "等等，这个箱子看起来很眼熟……";
			mes "嘿！这不是我让你送给春的箱子吗？";
			next;
			mes "[Kitten]";
			mes "~咽口水~";
			mes "我现在就走！谢谢你找到箱子！";
			delitem 1081, countitem(1081);// Delivery Box
			completequest 7716;// To the Village!
			getexp 70,70;
			classchange( HIDDEN_WARP_NPC, "", bc_self );
			lasagna_quest[0] = 6;
			next;
			npctalk "...Wow, that was fast.", "Tool Merchant#doram05t", bc_self;
			mes "[工具商人]";
			mes "总之，谢谢你找到箱子。";
			mes "如果有时间，就坐下来和我聊聊。";
			close;
		}
	}
	if (lasagna_quest[0] < 6) {
		mes "[Kitten]";
		mes "他怎么花了这么久……？我很担心。";
		next;
		select("有什么烦恼吗？");
		mes "[Kitten]";
		mes "不，没什么。";
		mes "我可不是那种会随便放弃差事的杜拉姆！";
		next;
		mes "小杜拉姆开始抱怨，暗自注意着身旁的成年杜拉姆。";
		close;
	}
	mes "[Kitten]";
	mes "听说你要前往新大陆。";
	mes "我也想亲自去那里！";
	close2;
	npctalk "你太年轻了！直接加入治安队吧。", "Tool Merchant#doram05t", bc_self;
	end;
OnInit:
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "isbegin_quest(7716) == 1" );
	end;
}

lasagna,165,125,5	script	Tool Merchant#doram05t	4_DR_M_01,{
	if (lasagna_quest[0] == 5) {
		if (countitem(1081) > 0) {
			mes "[Kitten]";
			mes "就是这个！！";
			next;
			mes "小猫高高举起别人交给他的箱子，开心地大叫。";
			next;
			mes "[工具商人]";
			mes "等等，这个箱子看起来很眼熟……";
			mes "嘿！这不是我让你送给春的箱子吗？";
			next;
			mes "[Kitten]";
			mes "~咽口水~";
			mes "我现在就走！谢谢你找到箱子！";
			delitem 1081, countitem(1081);// Delivery Box
			completequest 7716;// To the Village!
			getexp 70,70;
			classchange( HIDDEN_WARP_NPC, "Kid#doram04t", bc_self );
			lasagna_quest[0] = 6;
			next;
			npctalk "...Wow, that was fast.", "", bc_self;
			mes "[工具商人]";
		mes "总之，谢谢你找到箱子。如果有时间，就坐下来和我聊聊。";
			close;
		}
	}
	if (lasagna_quest[0] == 6) {
		if (checkweight(1001,6) == 0) {
			mes "- 等一下！！ -";
			mes "- 你的物品太多了。 -";
			mes "- 这意味着你无法再接收物品。 -";
			mes "- 腾出一些空间 -";
			mes "- 然后再试一次。 -";
			close;
		}
		mes "[工具商人]";
		mes "你一定是来申请新大陆探险的。";
		mes "看来我儿子给你添麻烦了。谢谢你的帮助。";
		next;
		mes "[工具商人]";
		mes "这不算什么，请收下，作为我的感谢。";
		mes "我还给你^4d4dff一套新衣服^000000，方便你换掉脏衣服。";
		next;
		mes "[工具商人]";
		mes "每个村庄都有像我这样的工具商人。";
		mes "你可以通过他们买卖物品。";
		next;
		mes "[工具商人]";
		mes "向^4d4dff治疗师春询问组合工具^000000，她会教你有效使用。";
		mes "把这个带上吧。";
		setquest 7717;// Merchant's Kindness
		getitem 569,50;// Novice Potion
		getitem 12323,10;// Novice Fly Wing
		getitem 12324,10;// Novice Butterfly Wing
		getitem 7059,10;// Free Ticket for Kafra Storage
		getitem 12849,5;// Combination Kit
		getitem 15150,1;// White Shirt [1]
		getexp 50,50;
		lasagna_quest[0] = 7;
		next;
		mes "[工具商人]";
		mes "如果想处理物品，就来找我。明白了吗？";
		next;
		mes "[工具商人]";
		mes "^4d4dff治疗师春的家^000000就在这里正^4d4dff东方^000000。";
		next;
		mes "[工具商人]";
		mes "她忙着测试药草，所以房前堆满了植物和草药。";
		mes "^4d4dff那是一栋摆满花盆的房子。^000000你不会错过的。";
		close;
	}
	if (lasagna_quest[0] == 7) {
		mes "[工具商人]";
		mes "春是个非常聪明的女孩，所有病人都会去找她。";
		next;
		mes "[工具商人]";
		mes "你即将踏上旅程，她会帮上大忙。一定要去见她。";
		next;
		mes "[工具商人]";
		mes "^4d4dff治疗师春的家^000000就在这里正^4d4dff东方^000000。";
		next;
		mes "[工具商人]";
		mes "她忙着测试药草，所以房前堆满了植物和草药。";
		mes "^4d4dff那是一栋摆满花盆的房子。^000000你不会错过的。";
		next;
		mes "[工具商人]";
		mes "你需要什么吗？";
	}
	else {
		mes "[工具商人]";
		mes "欢迎。";
	}
	next;
	if (select( "购买物品。", "出售物品。" ) == 1) {
		mes "[工具商人]";
		mes "需要什么吗？我有基本药水、陷阱、放大镜……应有尽有！";
		close2;
		if ( getbattleflag("feature.barter") ) {
			callshop "tool_shop_lasagna#Extended",1;
		} else {
			callshop "tool_shop_lasagna",1;
		}
		end;
	}
	mes "[工具商人]";
	mes "明智的选择！我就知道你会这么做。最好把不再需要的物品卖掉！";
	close2;
	callshop "tool_shop_lasagna",2;
	end;

OnInit:
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "isbegin_quest(7717) == 1" );
	end;

					if (countitem(970) == 0 || countitem(972) == 0 || countitem(713) == 0 || Zeny < 4000) {
						mes "[化学家莫根斯坦]";
						mes "呵呵呵……不够……不够……哈……哈……去……把剩余材料拿来！！";
						mes "乐趣只能推迟到以后了……嘿嘿嘿";
						close;
					}
					mes "[化学家莫根斯坦]";
					mes "哦哦哦……嘻嘻……对……就是这样……更多……更多……嘻嘻嘻";
					mes "……啊……哈哈……哦哦哦哦哦！！！……！！！！！";
					next;
					if (countitem(970) < 1 || countitem(972) < 1 || countitem(713) < 1) {
						mes "[化学家莫根斯坦]";
						mes "呵呵呵……不够……不够……哈……哈……去……把剩余材料拿来！！";
						close;
					}
					delitem 970,1; //Alchol
					delitem 972,1; //Karvodailnirol
					delitem 713,1; //Empty_Bottle
					set Zeny, Zeny-4000;
					getitem 974,1; //Mixture
					mes "[化学家莫根斯坦]";
					mes "嘻嘻嘻……";
					mes "哈啊……";
					mes "哦？已经完成了吗？！";
					close;
				}
				mes "[化学家莫根斯坦]";
				mes "嘻嘻嘻……!";
				mes "准备好后";
				mes "再回来～";
				mes "嘿……呜嘿嘿嘿……";
				close;
			}
		case 3:
			mes "[化学家莫根斯坦]";
			mes "嘻嘻……嘿嘿嘿嘿……";
			close;
		}
	}
	if (molgenstain == 2) {
		set MISC_QUEST,MISC_QUEST | 4;
		set molgenstain,0;
		mes "[化学家莫根斯坦]";
		mes "嘻嘻嘻……欢迎。嘿嘿嘿……嘻嘻嘻嘻……";
		next;
		mes "[化学家莫根斯坦]";
		mes "啊……？！";
		mes "如果吓到你了真抱歉。只是……我已经很久很久没见过活人了。那么，我能为你做什么？？";
		next;
		if (select("Ask about his research.:Cancel.") == 1) {
			mes "[化学家莫根斯坦]";
			mes "嘻嘻嘻……";
			mes "你一定听说过我的研究传闻。是的！既然你可能已经知道，我就不隐瞒了，反正没什么可隐瞒的。";
			next;
			mes "[化学家莫根斯坦]";
			mes "其实可以说我的研究完成了！天才的研究没有不可能！哇哈哈，只是时间问题！";
			next;
			mes "[化学家莫根斯坦]";
			mes "你还在这里？对了，你想了解我的研究。其实很简单，我只是想发明能融化一切的超级液体！";
			next;
			mes "[化学家莫根斯坦]";
			mes "很有趣吧？无论你多强，都无法破坏石头或钢铁，但我的新液体能融化它们，让它们像腻子一样柔软！";
			next;
			mes "[化学家莫根斯坦]";
			mes "它还不能融化一切，但我发现通过发明可以把以前无法混合的东西结合起来。";
			next;
			mes "[化学家莫根斯坦]";
			mes "只要你愿意，我可以用这种方法制造许多你想象不到的新东西！！";
			next;
			mes "[化学家莫根斯坦]";
			mes "内啡肽正以至少平时 2.1 倍的速度冲向我的脸！啊！我太兴奋了！我……我藏不住了！";
			close;
		}
		close;
	}
	mes "[化学家莫根斯坦]";
	mes "Heeheeheehee...";
	mes "你不是来当实验对象的吧？应该不是。自从我那次“小事故”后就没有了。嘻嘻嘻～！";
	close;
}


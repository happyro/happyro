				cutin "", 255;
				end;
			}
		case 3:
			mes "[忍者向导]";
			mes "......";
			next;
			mes "[忍者向导]";
			mes "如果你没事找我，我没什么可说的。";
			close2;
			cutin "", 255;
			end;
		}
	}
	cutin "", 255;
	end;
}

iz_ac02_a,140,139,5	duplicate(Ninja Guide#ac)	Ninja Guide#ac_a	4_M_NINJA_BLUE
iz_ac02_b,140,139,5	duplicate(Ninja Guide#ac)	Ninja Guide#ac_b	4_M_NINJA_BLUE
iz_ac02_c,140,139,5	duplicate(Ninja Guide#ac)	Ninja Guide#ac_c	4_M_NINJA_BLUE
iz_ac02_d,140,139,5	duplicate(Ninja Guide#ac)	Ninja Guide#ac_d	4_M_NINJA_BLUE


// =============================================================================
// = Enchanting / Upgrading NPCs
// =============================================================================

// - Refinery Owner Han
// -----------------------------------------------------------------------------
izlude,153,126,1	script	Refinery Owner Han#iz	4_M_02,{
	if (!checkweight(1301,1)) {
		mes "- 物品太多，无法继续对话。 -";
		close;
	}
	.@jerun_tutorial = isbegin_quest(5153) + isbegin_quest(5154) + isbegin_quest(5155) + isbegin_quest(5156);
	if (.@jerun_tutorial == 0) {
		mes "[精炼老板韩]";
		mes "你好？我叫 Han，致力于引领卢恩-米德加尔特的下一代精炼文化。";
		next;
		mes "[精炼老板韩]";
		mes "最近才进入这个市场，没有老客户的话很难经营。所以，我只好自己做宣传。";
		next;
		mes "[精炼老板韩]";
		mes "你对^3E86C3精炼^000000强化物品感兴趣吗？";
		next;
		if (select("我没兴趣。", "精炼？能吃吗？") == 1) {
			emotion ET_SORRY;
			mes "[精炼老板韩]";
			mes "啊，抱歉。我遇到一个大忙人。";
			close;
		}
		mes "[精炼老板韩]";
		mes "精炼就是用从怪物等处获得的^3E86C3稀有金属^000000强化装备。";
		next;
		mes "[精炼老板韩]";
		mes "武器精炼后攻击力会提高。如果精炼盾牌，防御力会提升，也能减轻怪物攻击造成的伤害。";
		next;
		mes "[精炼老板韩]";
		mes "现在大概明白了吧？";
		next;
		select("哦……精炼……");
		mes "[精炼老板韩]";
		mes "没错。精炼很好，但可能会上瘾。";
		next;
		mes "[精炼老板韩]";
		mes "我平时不这样做，但会给你一次体验精炼的特别机会。";
		next;
		mes "[精炼老板韩]";
		mes "不管是什么一级武器都可以使用！只要使用那边的^3E86C3瓦格贾克精炼机^000000！！";
		next;
		mes "[精炼老板韩]";
		mes "^I我会为你提供^FD4F02一次免费精炼服务。^000000";
		next;
		select("只有一次？");
		setquest 5153;
		mes "[精炼老板韩]";
		mes "嘿，我也要谋生！别告诉大家我是免费做的，好吗？";
		close;
	} else if (.@jerun_tutorial == 1) {
		mes "[精炼老板韩]";
		mes "你还没有使用瓦格贾克精炼机。";
		next;
		switch(select("精炼机 Wagjak", "为什么叫 Wagjak？", "Anything else I should know?", "Cancel")) {
		case 1:
			mes "[精炼老板韩]";
			mes "精炼机 Wagjak 是我研究 8 年后制造的机器。";
			next;
			mes "[精炼老板韩]";
		mes "我把它用于更贵重的精炼。这是我的私人精炼机。多亏了它，我已经签下了几份合同。";
			close;
		case 2:
			mes "[精炼老板韩]";
			mes "这个名字没特别含义，只是名字。Wagjak！很奇怪对吧？";
			close;
		case 3:
			mes "[精炼老板韩]";
			mes "当然！";
			next;
			mes "[精炼老板韩]";
		mes "不过我相信眼见为实……你懂我的意思吧？别光问，亲自试试看。";
			close;
		case 4:
			close;
		}
	} else if (.@jerun_tutorial == 2) {
		mes "[精炼老板韩]";
		mes "哦哦……你没有服务券……可能已经使用过瓦格贾克了……";
		next;
		mes "[精炼老板韩]";
		mes "希望你对精炼有了基本了解。";
		next;
		select("还有其他需要知道的吗？");
		mes "[精炼老板韩]";
		mes "是的，是的，还有……安全精炼说明和精炼价格……这些小事……";
		next;
		mes "[精炼老板韩]";
		mes "关于^3E86C3武器等级^000000和^3E86C3安全精炼^000000……";
		next;
		setquest 5154;
		mes "[精炼老板韩]";
		mes "可以向出售普拉康和埃姆维泰拉康的^3E86C3Taddae 先生^000000学习。";
		close;
	} else if (.@jerun_tutorial == 3) {
		mes "[精炼老板韩]";
		mes "我建议你去听听 Tadde 先生讲解武器等级和安全精炼。";
		close;
	} else if (.@jerun_tutorial == 4) {
		mes "[精炼老板韩]";
		mes "学得还好吗？他解释得够清楚吗？";
		next;
		mes "[精炼老板韩]";
		mes "我们私下说，有传闻称很多员工在抱怨我。";
		next;
		mes "[精炼老板韩]";
		mes "我派你去那里就是为了了解情况。";
		next;
		select("所以呢？");
		mes "[精炼老板韩]";
		mes "我会把它纳入绩效评价。顺便问一下，Tadde 先生讲得怎么样？";
		next;
		switch(select("非常好。", "还可以。", "马马虎虎。")) {
		case 1:
	mes "[精炼老板韩]";
		mes "他做得很好……";
			next;
			break;
		case 2:
	mes "[精炼老板韩]";
		mes "嗯，是这样吗？我明白了……得记下来……";
			next;
			break;
		case 3:
	mes "[精炼老板韩]";
		mes "嗯……原来如此……我明白了。";
			next;
			break;
		}
	mes "[精炼老板韩]";
		mes "好了！我整理完了……";
		next;
	mes "[精炼老板韩]";
		mes "接下来说明^3E86C3精炼效果^000000和^3E86C3精炼价格^000000。";
		next;
	mes "[精炼老板韩]";
		mes "^3E86C3Locas 先生^000000负责使用 Oridecon 宝石精炼。";
		next;
	mes "[精炼老板韩]";
		mes "去和 Locas 先生谈谈精炼效果和精炼价格。";
		next;
		setquest 5155;
	mes "[精炼老板韩]";
		mes "啊！！这次也要拜托你了。";
		close;
	} else if (.@jerun_tutorial == 5) {
	mes "[精炼老板韩]";
		mes "去找负责用^3E86C3神之金属^000000精炼的^3E86C3Locas 先生^000000，了解精炼效果和精炼价格。";
		close;
	} else if (.@jerun_tutorial == 6) {
	mes "[精炼老板韩]";
		mes "学得还好吗？他解释得够清楚吗？";
		next;
		switch(select("非常好。", "还可以。", "马马虎虎……")) {
		case 1:
	mes "[精炼老板韩]";
		mes "Locas 先生给你解释得很好。";
			next;
			break;
		case 2:
	mes "[精炼老板韩]";
		mes "还可以？嗯……";
			next;
			break;
		case 3:
	mes "[精炼老板韩]";
		mes "哦不……你对他的解释不满意……";
			next;
			break;
		}
	mes "[精炼老板韩]";
		mes "我明白了，我会记下来。";
		next;
	mes "[精炼老板韩]";
		mes "顺便说一句，我已经讲完所有精炼说明了。还有问题吗？";
		next;
		if (select("没有问题了。", "我有一些问题……") == 1) {
	mes "[精炼老板韩]";
		mes "我明白了……不过以防万一……";
			next;
		} else {
	mes "[精炼老板韩]";
		mes "啊，是这样吗？别担心。";
			next;
		}
		mes "[精炼老板韩]";
		mes "如果还有问题，就来找我。我会再次为你详细说明。";
		next;
		mes "[精炼老板韩]";
		mes "这是你学习精炼的报酬。希望今后能经常见到你。";
		next;
		setquest 5156;
		completequest 5156;
		if (Class == Job_Novice)
			getexp 1200,500;
		mes "你学会了精炼知识，并获得卡普拉仓库免费券。";
		getitem 7059,1;// Cargo_Free_Ticket
		close;
	} else if (.@jerun_tutorial == 8) {
		mes "[精炼老板韩]";
		mes "最近过得怎么样？";
		next;
		switch(select("Hi!!", "How is the morale of the employees?", "Question is....", "Cancel")) {
		case 1:
			mes "[精炼老板韩]";
			mes "还好吗？好久没见了……请多来这里精炼。";
			close;
		case 2:
			mes "[精炼老板韩]";
			mes "和以前一样，劳资双方已经达成共识。";
			next;
			mes "[精炼老板韩]";
			mes "我们理解员工的抱怨，也准备了解决方案。";
			next;
			mes "[精炼老板韩]";
			mes "也许正因为如此，我已经听不到他们的其他抱怨了。";
			close;
		case 3:
			mes "[精炼老板韩]";
			mes "你有问题……";
			next;
			mes "[精炼老板韩]";
			mes "不过我一开始什么都没告诉你。";
			next;
			mes "[精炼老板韩]";
			mes "你最好去问问之前见过的工作人员。";
			next;
			mes "[精炼老板韩]";
			mes "关于^FD4F02武器等级^000000和^FD4F02安全精炼^000000，可以询问^142CEBTadde 先生^000000；关于^FD4F02精炼价格^000000和^FD4F02精炼效果^000000，可以询问^142CEBLocas 先生^000000。";
			next;
			mes "[精炼老板韩]";
			mes "他会耐心回答你的。";
			close;
		case 4:
			break;
		}
		close;
	} else {
		mes "[精炼老板韩]";
		mes "一定发生了奇怪的事。如果问题持续，请联系客服。";
		close;
	}

OnInit:
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "BaseLevel <= 20 && !isbegin_quest(5153)" );
	end;
}

izlude_a,153,126,1	duplicate(Refinery Owner Han#iz)	Refinery Owner Han#iz_a	4_M_02
izlude_b,153,126,1	duplicate(Refinery Owner Han#iz)	Refinery Owner Han#iz_b	4_M_02
izlude_c,153,126,1	duplicate(Refinery Owner Han#iz)	Refinery Owner Han#iz_c	4_M_02
izlude_d,153,126,1	duplicate(Refinery Owner Han#iz)	Refinery Owner Han#iz_d	4_M_02

// - 精炼机 Wagjak
// -----------------------------------------------------------------------------
-	script	::izludeWagjak	-1,{
	disable_items;
	mes "[精炼机 Wagjak]";
	mes "-达里特！-";
	mes "瓦格贾克启动……完成。";
	mes "检查用户……完成。";
	mes "选择精炼装备。";
	next;
	setarray .@indices[1], EQI_HEAD_TOP, EQI_ARMOR, EQI_HAND_L, EQI_HAND_R, EQI_GARMENT, EQI_SHOES, EQI_ACC_L, EQI_ACC_R, EQI_HEAD_MID, EQI_HEAD_LOW;
	for(set .@i,1; .@i<=10; set .@i,.@i+1)
		.@menu$ = .@menu$ + ( getequipisequiped(.@indices[.@i]) ? getequipname(.@indices[.@i]): F_getpositionname(.@indices[.@i]) +" - [Unarmed]" ) +":";
	.@part = .@indices[ select(.@menu$) ];
	if (!getequipisequiped(.@part)) {
		mes "[精炼机 Wagjak]";
		mes "^ff0000- 错误编号 000"+.@part+" -^000000";
		mes "未装备物品。";
		close;
	}
	mes "[精炼机 Wagjak]";
	mes "搜索装备信息——完成。";
	next;
	if (!getequipisenableref(.@part)) {
		mes "[精炼机 Wagjak]";
		mes "^FF0000- 错误编号 4444 -^000000";
		mes "此物品无法精炼。";
		close;
	}
	// if (!getequipisidentify(.@part)) {// getequipisidentify command removed 
		// mes "[精炼机 Wagjak]";
		// mes "^FF0000- error number 5555 -^000000";
		// mes "This item has not yet been identified.";
		// close2;
		// enable_items;
		// end;
	// }
	.@refineitemid = getequipid(.@part); // save id of the item
	.@refinerycnt = getequiprefinerycnt(.@part); //save refinery count
	setarray .@card[0], getequipcardid(.@part,0), getequipcardid(.@part,1), getequipcardid(.@part,2), getequipcardid(.@part,3);
	.@itemtype = getiteminfo( .@refineitemid, ITEMINFO_TYPE );

	if (.@refinerycnt >= 10) {
		mes "[精炼机 Wagjak]";
		mes "^FF0000- 错误编号 1010 -^000000";
		mes "当前版本最多只能精炼到 +10。";
		close;
	}
	if (isbegin_quest(5153) == 1) {
		if (getequipweaponlv(.@part) == 1) {
			mes "[精炼机 Wagjak]";
			mes "类型：1 级武器";
			mes "费用：普拉康，1000 Zeny";
			mes "检测到服务使用券，不收取费用。要进行精炼吗？";
			next;
			if (select("精炼。", "不精炼。") == 2) {
				mes "[精炼机 Wagjak]";
				mes "取消精炼。";
				close;
			}
			if (getequippercentrefinery(.@part) < 100) {
				mes "[精炼机 Wagjak]";
				mes "-达里特！-";
				mes "需要用户确认。";
				mes "你正在尝试安全率较低的精炼。如果精炼失败，装备会被破坏。要继续吗？";
				next;
				if (select("精炼。", "不精炼。") == 2) {
					mes "[精炼机 Wagjak]";
					mes "已按照用户要求取消精炼。";
					close;
				}
			}
			// anti-hack
			if (callfunc("F_IsEquipIDHack", .@part, .@refineitemid) || callfunc("F_IsEquipCardHack", .@part, .@card[0], .@card[1], .@card[2], .@card[3]) || callfunc("F_IsEquipRefineHack", .@part, .@refinerycnt))
				close;
			if (getequippercentrefinery(.@part) <= rand(100)) {
				failedrefitem .@part;
				mes "[精炼机 Wagjak]";
				mes "结果：失败";
				mes "精炼失败，装备已被破坏。";
				close;
			} else {
				successrefitem .@part;
				mes "[精炼机 Wagjak]";
				mes "结果：成功";
				mes "恭喜！！精炼成功。";
				completequest 5153;
				next;
				mes "[精炼机 Wagjak]";
				mes "已使用服务券。";
				close;
			}
		}
	}

// Wagjak has different hardcoded prices
//	.@price = getequiprefinecost(.@part, REFINE_COST_NORMAL, REFINE_ZENY_COST);
	.@material = getequiprefinecost(.@part, REFINE_COST_NORMAL, REFINE_MATERIAL_ID);

	if( .@itemtype == IT_ARMOR ){
		.@equip_lv = getequiparmorlv( .@part );
		.@type$ = "Armor";

		switch( .@equip_lv ){
			case 1:
				.@price = 20000;
				break;
			default:
				// TODO:
				close;
		}
	}else if( .@itemtype == IT_WEAPON ){
		.@equip_lv = getequipweaponlv( .@part );
		.@type$ = "Level " + .@equip_lv + " Weapon";

		switch( .@equip_lv ){
			case 1:
				.@price = 1000;
				break;
			case 2:
				set .@price,2000;
				break;
			case 3:
				set .@price,10000;
				break;
			case 4:
				set .@price,20000;
				break;
			default:
				// TODO:
				close;
		}
	}else{
		// TODO:
		close;
	}

	mes "[精炼机 Wagjak]";
	mes "类型："+ .@type$ +"";
	mes "费用："+ getitemname(.@material) +"，"+ .@price +" Zeny";
	mes "将收取以上费用。要进行精炼吗？";
	next;
	if (select("精炼。", "不精炼。") == 2) {
		mes "[精炼机 Wagjak]";
		mes "已按照用户要求取消精炼。";
		close;
	}
	if (getequippercentrefinery(.@part) < 100) {
		mes "[精炼机 Wagjak]";
		mes "-达里特！-";
	mes "需要用户确认。";
	mes "你正在尝试安全率较低的精炼。如果精炼失败，装备会被破坏。要继续吗？";
		next;
		if (select("精炼。", "不精炼。") == 2) {
			mes "[精炼机 Wagjak]";
			mes "已按照用户要求取消精炼。";
			close;
		}
	}
	if (countitem(.@material) > 0 && Zeny >= .@price) {
		delitem .@material, 1;
		Zeny -= .@price;

		// anti-hack
		if (callfunc("F_IsEquipIDHack", .@part, .@refineitemid) || callfunc("F_IsEquipCardHack", .@part, .@card[0], .@card[1], .@card[2], .@card[3]) || callfunc("F_IsEquipRefineHack", .@part, .@refinerycnt)) {
			mes "[精炼机 Wagjak]";
			emotion ET_FRET;
		mes "等一下……";
		mes "你以为我傻吗？！";
		mes "你趁我没注意换了装备！出去！";
			close;
		}
	} else {
		mes "[精炼机 Wagjak]";
		mes "^FF0000- 错误编号 8282 -^000000";
		mes "精炼费用不足。";
		close;
	}
	if (getequippercentrefinery(.@part) <= rand(100)) {
		failedrefitem .@part;
		mes "[精炼机 Wagjak]";
		mes "结果：失败";
		mes "精炼失败，装备已被破坏。";
	} else {
		successrefitem .@part;
		mes "[精炼机 Wagjak]";
		mes "结果：成功";
		mes "恭喜！！精炼成功。";
	}
	close;
}

izlude,153,121,3	duplicate(izludeWagjak)	精炼机 Wagjak::iz	2_MONEMUS
izlude_a,153,121,3	duplicate(izludeWagjak)	精炼机 Wagjak::iz_a	2_MONEMUS
izlude_b,153,121,3	duplicate(izludeWagjak)	精炼机 Wagjak::iz_b	2_MONEMUS
izlude_c,153,121,3	duplicate(izludeWagjak)	精炼机 Wagjak::iz_c	2_MONEMUS
izlude_d,153,121,3	duplicate(izludeWagjak)	精炼机 Wagjak::iz_d	2_MONEMUS

// - Tadde
// -----------------------------------------------------------------------------
izlude,145,122,7	script	Tadde#iz	4_M_04,{
	if (!checkweight(1301,1)) {
		mes "- 由于背包中物品太多，无法继续任务。-";
		close;
	}
	if (isbegin_quest(5154) == 1) {
		mes "[塔德]";
		mes "欢迎。老板让我向你说明^3E86C3武器等级^000000和^3E86C3安全精炼^000000。";
		next;
		mes "[塔德]";
		mes "其实，亲自进行任务时了解这些会更好。不过有问题的话尽管问我。";
		next;
		while(1) {
			switch(select("武器等级", "安全精炼。", "结束提问。")) {
			case 1:

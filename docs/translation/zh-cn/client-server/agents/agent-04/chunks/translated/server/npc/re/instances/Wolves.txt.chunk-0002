2@nyr,37,219,3	script	Miriam#dms201	4_EP18_MIRIAM,5,5,{
	end;
OnTouch:
	// note: player can move
	if ('nyr_main_step != 3 || is_party_leader() == false)
		end;
	'nyr_main_step = 4;
	npctalk "冒险者？", instance_npcname("Miriam#dms201");
	npctalk "冒险者？你为什么在这里？", instance_npcname("Miriam#dms201");
	sleep 2000;
	npctalk "Suad 派我来的。别太担心。", instance_npcname("Miriam#dms201");
	sleep 1000;
	enablenpc instance_npcname("Temple Guard#dms201");
	enablenpc instance_npcname("Temple Guard#dms211");
	enablenpc instance_npcname("Temple Guard#dms221");
	enablenpc instance_npcname("Temple Guard#dms231");
	enablenpc instance_npcname("Temple Guard#dms241");
	sleep 500;
	npctalk "站住！报上身份。", instance_npcname("Temple Guard#dms201");
	npctalk "……看来很难悄悄通过。", instance_npcname("Miriam#dms201");
	end;
}

2@nyr,35,215,7	script	Temple Guard#dms201	4_M_RASWORD,{
	if (is_party_leader() == false) {
		npctalk "谁是队长？";
		end;
	}
	if ('nyr_main_step != 4)
		end;
	mes "[Temple Guard]";
	mes "这里禁止进入。";
	next;
	cutin "ep18_miriam_01.png",2;
	mes "[Miriam]";
	mes "我是 Miriam，高阶牧师 Amal 的女儿。我们跟踪一群可疑的人来到这里……";
	next;
	cutin "",255;
	mes "[Temple Guard]";

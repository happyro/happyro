1@nyr,192,31,3	script	Miriam#dms101	EP18_NPC_MIRIAM,5,5,{
	end;
OnTouch:
	if ('nyr_main_step == 1) {
		navigateto("1@nyr",125,41);
		end;
	}
	if ('nyr_main_step != 0)
		end;

	'nyr_main_step = 1;
	setpcblock PCBLOCK_NPC, true;
	npctalk "冒险者！";
	emotion ET_SURPRISE;
	sleep2 1000;
	navigateto("1@nyr",125,41);
	setpcblock PCBLOCK_NPC, false;
	npctalk "前方是集合点。";
	unitwalk getnpcid(0), 162,31, instance_npcname("Miriam#dms101") + "::OnMove1";
	sleep 2000;
	npctalk "请往这边。";
	end;

OnMove1:
	unitwalk getnpcid(0), 137,31, instance_npcname("Miriam#dms101") + "::OnMove2";
	end;
OnMove2:
	unitwalk getnpcid(0), 128,41, instance_npcname("Miriam#dms101") + "::OnMove3";
	npctalk "就在我面前。";
	end;
OnMove3:
	if ('nyr_main_step != 1)
		end;
	'nyr_main_step = 2;

	npctalk "Suad，情况如何？", instance_npcname("Miriam#dms101");
	npctalk "不许再进入！", instance_npcname("Temple Guard#dms101");
	sleep 1000;
	npctalk "Miriam，冒险者。再往这边一点。", instance_npcname("Suad#dms101");
	sleep 1000;
	npctalk "太过分了！他们把我们当罪犯！", instance_npcname("Kun#dms112");
	npctalk "我们是不是来到了不该来的地方？", instance_npcname("Angry Crowd#dms131");
	sleep 1500;
	npctalk "嘿，那地方是我曾曾祖母的土地！", instance_npcname("Angry Crowd#dms121");
	npctalk "我们完全有权待在这里！", instance_npcname("Angry Crowd#dms161");
	sleep 2000;
	npctalk "对！！别挡路！", instance_npcname("Angry Crowd#dms191");
	npctalk "你们把我们赶走了！", instance_npcname("Angry Crowd#dms181");
	sleep 2000;
	npctalk "就因为我们看起来不像人类？", instance_npcname("Angry Crowd#dms101");
	npctalk "就因为我们看起来好欺负？", instance_npcname("Angry Crowd#dms131");
	sleep 2000;
	npctalk "我们要夺回应有的位置！", instance_npcname("Angry Crowd#dms121");
	npctalk "搞什么！！把土地还给我们！！", instance_npcname("Angry Crowd#dms181");
	sleep 2000;
	npctalk "我们是这片土地长久以来的主人，却被定居者赶走了。", instance_npcname("Angry Crowd#dms101");
	npctalk "谁在阻拦我们？！", instance_npcname("Angry Crowd#dms141");
	sleep 2000;
	npctalk "我们来夺回作为这片土地长期居民的应有位置。", instance_npcname("Angry Crowd#dms101");
	npctalk "非法占据我们土地的人应该离开！", instance_npcname("Angry Crowd#dms191");
	sleep 2000;
	npctalk "不许非法抗议！现在解散！", instance_npcname("Temple Guard#dms101");
	npctalk "谁说我们的抗议是非法的？", instance_npcname("Angry Crowd#dms151");
	npctalk "你们只是随口编说它是非法的？", instance_npcname("Angry Crowd#dms171");
	sleep 2000;
	npctalk "我们的要求如下！", instance_npcname("Angry Crowd#dms101");
	sleep 2000;
	npctalk "第一！我们是这片土地的主人！非法占据它的人必须离开！", instance_npcname("Angry Crowd#dms101");
	npctalk "退后！", instance_npcname("Angry Crowd#dms111");
	npctalk "退后！", instance_npcname("Angry Crowd#dms121");
	npctalk "退后！", instance_npcname("Angry Crowd#dms131");
	npctalk "退后！", instance_npcname("Angry Crowd#dms141");
	npctalk "退后！", instance_npcname("Angry Crowd#dms151");
	npctalk "退后！", instance_npcname("Angry Crowd#dms161");
	npctalk "退后！", instance_npcname("Angry Crowd#dms171");
	npctalk "退后！", instance_npcname("Angry Crowd#dms181");
	npctalk "退后！", instance_npcname("Angry Crowd#dms191");
	sleep 2000;
	npctalk "第二！废除不公平的歧视性政策，承认我们的权利！", instance_npcname("Angry Crowd#dms101");
	npctalk "承认！", instance_npcname("Angry Crowd#dms111");
	npctalk "承认！", instance_npcname("Angry Crowd#dms121");
	npctalk "承认！", instance_npcname("Angry Crowd#dms131");
	npctalk "承认！", instance_npcname("Angry Crowd#dms141");
	npctalk "承认！", instance_npcname("Angry Crowd#dms151");
	npctalk "承认！", instance_npcname("Angry Crowd#dms161");
	npctalk "承认！", instance_npcname("Angry Crowd#dms171");
	npctalk "承认！", instance_npcname("Angry Crowd#dms181");
	npctalk "承认！", instance_npcname("Angry Crowd#dms191");
	end;

OnStartMove2:
	npcspeed 100;
	unitwalk getnpcid(0), 137,31, instance_npcname("Miriam#dms101") + "::OnMove4";
	end;
OnMove4:
	disablenpc instance_npcname("Miriam#dms101");
	end;

OnGuy1:
	disablenpc instance_npcname("Lamacus#dms102");
	end;
OnGuy2:
	disablenpc instance_npcname("Kun#dms112");
	end;
OnGuy3:
	disablenpc instance_npcname("Yopi#dms122");
	end;
}

1@nyr,125,41,3	script	Suad#dms101	4_EP18_SUAD,{
	if (is_party_leader() == false) {
		cutin "ep18_Suad_01.png",0;
		mes "[Suad]";
		mes "队长在哪里？";
		close3;
	}
	if ('nyr_main_step == 2) {
		cutin "ep18_suad_01.png",0;
		mes "[Suad]";
		mes "现在情况不妙。我想……武装守卫正在加强戒备……";
		next;
		select( "看来上面的骚乱问题很严重。" );
		cutin "ep18_miriam_03.png",2;
		mes "[Miriam]";
		mes "或者情报泄露了。否则我们不可能有所准备。";
		next;
		cutin "",255;
		mes "[Temple Guard]";
		mes "禁止继续进入。投降接受逮捕。";
		next;
		mes "[Natives]";
		mes "我们做了什么？我们不该在这里！";
		next;
		mes "[Natives]";
		mes "这是我们的土地！主人想进入自己的土地，凭什么阻拦？";
		next;
		mes "[Natives]";
		mes "是你们非法占据了它！";
		next;
		mes "[Natives]";
		mes "搞什么，还回来！！我们的土地！！";
		next;
		mes "[Native Leader]";
		mes "我们是这片土地长久以来的主人，却被定居者赶出了家园。";
		next;
		mes "[Native Leader]";
		mes "我们来夺回作为这片土地长期居民的应有位置。";
		next;
		mes "[Native Leader]";
		mes "我们的要求如下。";
		next;
		mes "[Native Leader]";
		mes "第一！我们……";
		next;
		npctalk "就是现在。安静地跟我来。", instance_npcname("Lamacus#dms102");
		npcspeed( 50, instance_npcname("Lamacus#dms102") );
		npcspeed( 50, instance_npcname("Kun#dms112") );
		npcspeed( 50, instance_npcname("Yopi#dms122") );
		unitwalk getnpcid(0,instance_npcname("Lamacus#dms102")), 145,34, instance_npcname("Miriam#dms101") + "::OnGuy1";
		sleep2 1000;
		unitwalk getnpcid(0,instance_npcname("Kun#dms112")), 145,32, instance_npcname("Miriam#dms101") + "::OnGuy2";
		unitwalk getnpcid(0,instance_npcname("Yopi#dms122")), 145,31, instance_npcname("Miriam#dms101") + "::OnGuy3";
		cutin "ep18_miriam_03.png",2;
		mes "[Miriam]";
		mes "Suad，你给上面那些闹事的人下达过什么具体指示吗？";
		next;
		cutin "ep18_suad_01.png",0;
		mes "[Suad]";
		mes "没有？为什么？";
		next;
		cutin "ep18_miriam_03.png",2;
		mes "[Miriam]";
		mes "看到那边那些人了吗？他们正在小心移动。那就是在上面发动袭击的那群人。";
		next;
		cutin "ep18_suad_03.png",0;
		mes "[Suad]";
		mes "我没有给你任何指示。你想擅自行动吗？";
		next;
		select( "看来他们正前往神殿。" );
		cutin "ep18_miriam_03.png",2;
		mes "[Miriam]";
		mes "这是一次事先没有讨论过的行动。我已经有前科了，这可不是什么好事，对吧？我得悄悄行动，除此之外也不知道该怎么办……";
		next;
		cutin "ep18_suad_01.png",0;
		mes "[Suad]";
		mes "你要一个人去吗？";
		next;
		cutin "ep18_miriam_03.png",2;
		mes "[Miriam]";
		mes "我只是跟在后面，为什么需要一群人？我一个人就够了。你留在这里，有什么情况我会发信号。";
		next;
		if ('nyr_main_step == 2) {
			'nyr_main_step = 3;
			enablenpc instance_npcname("#dmswp01");
			enablenpc instance_npcname("Miriam#dms201");
		}
		donpcevent instance_npcname("Miriam#dms101") + "::OnStartMove2";
		cutin "ep18_suad_03.png",0;
		mes "[Suad]";
		mes "他们说自己只是在跟随，但谁知道他们可能在做什么。就算没有武器，也可能藏着什么……";
		next;
		unittalk getcharid(3), "" + strcharinfo(0) + " : Let me catch up.";
		mes "[Suad]";
		mes "那就放心了。我不能在这里贸然行动。Miriam 留下了踪迹。现在帮我个忙，沿着踪迹走吧。";
		close2;
		navigateto("1@nyr",179,164);
		cutin "",255;
		end;
	}
	if ('nyr_main_step == 3) {
		cutin "ep18_suad_01.png",0;
		mes "[Suad]";
		mes "小心。";
		close2;
		navigateto("1@nyr",179,164);
		cutin "",255;
		end;
	}
	end;
}


alberta_in,70,51,5	script	Guarnien	4W_M_02,{
	mes "[瓜尔尼恩]";
	if(Class != Job_Merchant){
		mes "你好，陌生人。";
		mes "真希望我能";
		mes "在你的冒险中";
		mes "帮助你……";
		next;
		mes "[瓜尔尼恩]";
		mes "不过我教的东西只对商人有益。 交易和赚钱是我的专长。 如果你有商人朋友，让他们来找我。";
		if(Class == Job_Merchant_High){
			next;









			mes "[瓜尔尼恩]";
			mes "严格来说你是商人，但我一眼就能认出专家。 我看得出你经历过商人生活！";
		}
		close;
	}
	switch(tu_merchant){
	case 17:
		mes "我们甚至无法想象";
		mes "数量之多";
		mes "市场和人们";
		mes "遍布在这个";
		mes "广阔的世界。";
		next;
		mes "[瓜尔尼恩]";
		mes "他们都可能成为客户和商业伙伴。 当然，要由你去认识他们。";
		mes "只要真诚善待遇到的每个人，你就";
		mes "不会有问题。";
		close;
	case 15:
	case 16:
		.@chk_vend = getskilllv("MC_VENDING");
		if (tu_merchant == 15) {
			mes "我想是时候进行";
			mes "最后一课了。";
			mes "我要讲解商人的终极";
			mes "技能： ^871F78露天商店^000000. 请仔细听。";
			next;
			mes "[瓜尔尼恩]";
			mes "露天商店是主动技能，能让你在原地开设自己的商店。露天商店让你可以和其他人真正做生意。";
			next;
			mes "[瓜尔尼恩]";
			mes "不过你只能贩卖手推车里存放的物品，";
			mes "所以必须拥有手推车。每件物品的最高定价是";
			mes "99,990,000 Zeny。";
			next;
			mes "[瓜尔尼恩]";
			mes "总之，你必须先学会手推车技能，才能学习露天商店技能。";
			next;
			mes "[瓜尔尼恩]";
			mes "露天商店技能等级越高，一次能贩卖的物品越多。技能等级 10 时即可精通露天商店。";
			next;
			mes "[瓜尔尼恩]";
			mes "1 级露天商店允许你";
			mes "一次贩卖 3 件物品。每提升一级露天商店技能，一次能贩卖的物品总数就会";
			mes "增加一件。";
			next;
			mes "[瓜尔尼恩]";
			if((.@chk_vend > 3) && (.@chk_vend < 10)){
				mes "不过看来你已经知道了，对吧？既然你这么聪明，这份小奖励就送给你吧~";
				getexp 186,60;
			} else if(.@chk_vend == 10){
				mes "看来我说了多余的话。抱歉，我没注意到你已经精通露天商店技能了……";
				next;
				mes "[瓜尔尼恩]";
				mes "你真是个";
				mes "优秀的学生！";
				mes "请收下这份";
				mes "小奖励，";
				mes "感谢你的努力~";
				getexp 199,69;
			} else {
				mes "最后一项作业是把露天商店技能学到 4 级。当然，完成后我会给你一点奖励。我会等着你，加油吧~";
				tu_merchant = 16;
				erasequest 8239;
				setquest 8240;
				close;
			}
			completequest 8239;
		}
		else {
			mes "那么……";
			mes "你对露天商店";
			mes "了解多少了？";
			next;
			mes "[瓜尔尼恩]";
			if((.@chk_vend > 3) && (.@chk_vend < 10)){
				mes "太好了！";
				mes "你自学得很不错。来，这是你应得的小奖励~";
				getexp 186,43;
			} else if(.@chk_vend == 10){
				mes "哦，我看得出你很认真地想成为商人。你能精通这项技能，我为你感到骄傲！来，你值得这份奖励！";
				getexp 199,69;
			} else {
				mes "嗯……";
				mes "还没学会 4 级露天商店吗？记住，能够贩卖物品是";
				mes "商人的重要特征之一！";
				close;
			}
			completequest 8240;
		}
		tu_merchant = 17;
		next;
		mes "[瓜尔尼恩]";
		mes "啊，你已经掌握商人职业的基础了。继续练习基本原则，比如调查市场价格，就不会有问题。";
		next;
		mes "[瓜尔尼恩]";
		mes "虽然我们做的一切都是为了钱，但千万别忘记顾客的需求，始终以合适又公平的价格出售商品。否则可能没人买你的货！";
		next;
		mes "[瓜尔尼恩]";
		mes "好了，现在没什么可以再教你的了。去外面的世界闯出商人的名号吧。";
		next;
		mes "[瓜尔尼恩]";
		mes "以后想来就来";
		mes "看看我吧。";
		mes "祝你好运~";
		close;
	case 13:
	case 14:
		.@chk_cart = getskilllv("MC_PUSHCART");
		if (tu_merchant == 13) {
			mes "现在来讲讲";
			mes "^871F78手推车^000000。首先，你必须先学会 5 级负重增加，才能学习手推车技能。";
			next;
			mes "[瓜尔尼恩]";
			mes "手推车。技能等级 10 时即可精通。它能让你携带手推车，最多装 100 种、总重量不超过 8,000 的物品。";
			next;
			mes "[瓜尔尼恩]";
			mes "如你所见，这项技能是负重增加技能的进阶版。你可以支付费用，从大多数卡普拉小姐那里租用手推车。";
			next;
			mes "[瓜尔尼恩]";
			mes "租用手推车后，只要不卸下就能一直携带。使用手推车的缺点是移动速度会降到";
			mes "接近一半！很糟糕吧？";
			next;
			mes "[瓜尔尼恩]";
			mes "幸运的是，提升";
			mes "手推车技能等级后，移动速度会逐渐恢复。手推车 10 级时，完全不会降低你的";
			mes "速度！";
			next;
			erasequest 8237;
			.@chk_cart = getskilllv("MC_PUSHCART");
			mes "[瓜尔尼恩]";
			if(.@chk_cart > 3 && .@chk_cart < 10){
				mes "啊，我看出你一直专心学习手推车。虽然移动速度可能还有问题，";
				mes "但应该不算什么大事。";
				mes "做得好~";
				getexp 162,52;
			} else if(.@chk_cart == 10){
				mes "太棒了！你已经";
				mes "精通手推车技能。";
				mes "你确实值得一点奖励~";
				getexp 186,60;
			} else {
				mes "现在不如先把手推车";
				mes "技能学到 4 级？完成后";
				mes "我就能继续";
				mes "下一课。";
				tu_merchant = 14;
				setquest 8238;
				close;
			}
			setquest 8239;
		}
		else {
			mes "那么，你有没有按我的要求";
			mes "把手推车学到";
			mes "4 级？";
			next;
			mes "[瓜尔尼恩]";
			if(.@chk_cart > 3 && .@chk_cart < 10){
				mes "做得好~";
				mes "你一直是个";
				mes "配合的学生。";
				mes "这份小奖励";
				mes "是你努力应得的~";
				getexp 162,52;
			} else if(.@chk_cart == 10){
				mes "太棒了！";
				mes "你不仅精通了手推车技能，还超额完成了。干得漂亮！";
				getexp 186,60;
			} else {
				mes "还没达到要求吗？";
				mes "记住，你需要先学会";
				mes "5 级负重增加，才能学习手推车";
				mes "技能。希望这能帮到你。";
				close;
			}
			erasequest 8238;
			setquest 8239;
		}
		tu_merchant = 15;
		next;
		mes "[瓜尔尼恩]";
		mes "下次我会讲解让商人与其他职业区别开来的技能：^871F78露天商店^000000。千万别错过！";
		close;
	case 11:
	case 12:
		.@chk_over = getskilllv("MC_OVERCHARGE");
		if (tu_merchant == 11) {
			mes "啊，已经准备好";
			mes "学习了吗？好吧，";
			mes "让我来告诉你";
			mes "关于 ^871F78高价买进^000000 的知识。";
			next;
			mes "[瓜尔尼恩]";
			mes "和低价买进一样，高价买进是被动技能，10 级即可精通。因此使用它不需要 SP。";
			next;
			mes "[瓜尔尼恩]";
			mes "高价买进能让你把物品卖给 NPC 商店时获得更多 Zeny。技能等级越高，卖给 NPC 时得到的 Zeny 越多。";
			next;
			mes "[瓜尔尼恩]";
			erasequest 8235;
			.@chk_over = getskilllv("MC_OVERCHARGE");
			if(.@chk_over > 3 && .@chk_over < 10){
				mes "啊，你已经学会 4 级高价买进了。太好了！给你一点小奖励~";
				getexp 126,27;
			} else if(.@chk_over == 10){
				mes "太惊人了！你已经精通高价买进技能！你一定很想要这份奖励吧~";
				getexp 142,33;
			} else {
				mes "我认为你一定要学会这项技能！下一项作业是把高价买进学到 4 级，应该不难。";
				tu_merchant = 12;
				setquest 8236;
				next;
				mes "[瓜尔尼恩]";
				mes "完成后，";
				mes "我们就能讨论";
				mes "更高级的内容。";
				mes "加油~";
				close;
			}
			setquest 8237;
		}
		else {
			mes "那么……";
			mes "学习";
			mes "^871F78高价买进^000000技能";
			mes "进展如何？";
			next;
			mes "[瓜尔尼恩]";
			if(.@chk_over > 3 && .@chk_over < 10){
				mes "干得不错！";
				mes "我看得出你";
				mes "完全按照我的要求完成了。";
				mes "请收下这份小奖励~";
				getexp 126,27;
			} else if(.@chk_over == 10){
				mes "哇……";
				mes "你真的";
				mes "精通高价买进了？";
				mes "太厉害了！你值得一份努力奖励！";
				getexp 142,33;
			} else {
				mes "嗯？你还没";
				mes "把高价买进";
				mes "学到 4 级吗？";
				mes "不用着急，但完成这项小任务前，我没法讲解其他内容。";
				close;
			}
			erasequest 8236;
			setquest 8237;
		}
		tu_merchant = 13;
		next;
		mes "[瓜尔尼恩]";
		mes "下次我会讲解";
		mes "手推车技能。准备好听课吧，手推车是商人最重要的技能之一。";
		close;
	case 10:
		mes "让我看看那些";
		mes "红色药水。你";
		mes "买这些";
		mes "花了多少钱……？";
		next;
		mes "[瓜尔尼恩]";
		mes "啊……！";
		mes "看来……";
		mes "你被骗了！";
		mes "别、别担心，";
		mes "我不会告诉别人的。";
		next;
		mes "[瓜尔尼恩]";
		mes "算了，再厉害的人也会遇到这种事。把它当成一次无价的学习经验吧。";
		next;
		mes "[瓜尔尼恩]";
		mes "现在去普隆德拉，再试着从 NPC 那里以最低价买 10 瓶红色药水吧。";
		tu_merchant = rand(6,8);
		close;
	case 9:
		mes "让我看看那些";
		mes "红色药水。看来你调查了市场，买到了最便宜的！干得好！";
		tu_merchant = 11;
		changequest 8234,8235;
		getexp 112,22;
		next;
		mes "[瓜尔尼恩]";
		mes "好了，下次我们会讲解学会低价买进后可以学习的技能：";
		mes "^871F78Over Charge^000000.";
		close;
	case 6:
	case 7:
	case 8:
		mes "嗯……";
		mes "你会在普隆德拉找到一些 NPC，";
		mes "他们出售 10 瓶红色药水。你的任务";
		mes "是以最低价";
		mes "买下这些药水。";
		next;
		mes "[瓜尔尼恩]";
		mes "首先，你最好调查红色药水的市场价格。还有，务必小心骗子和欺诈！";
		close;
	case 5:
		mes "好了……";
		mes "我想过了，给你一个小挑战。带 10 瓶红色药水来给我！";
		next;
		mes "[瓜尔尼恩]";
		mes "不算太难，但附加条件是，你必须找到以最低价出售红色药水的商人。";
		next;
		mes "[瓜尔尼恩]";
		mes "所以首先要调查红色药水的市场价格。还要小心骗子！如果价格好得不像真的，通常就不是真的。";
		next;
		mes "[瓜尔尼恩]";
		mes "哈哈哈，我把目标说得简单一点。你需要从普隆德拉的 NPC 那里买 10 瓶红色药水。";
		next;
		mes "[瓜尔尼恩]";
		mes "普隆德拉离这里有点远，对吧？我用这个卡普拉传送——不知为何曼秀有很多——现在就送你去。准备好……！";
		next;
		tu_merchant = rand(6,8);
		changequest 8233,8234;
		warp "prontera",155,46;
		end;
	case 3:
	case 4:
		.@chk_disc = getskilllv("MC_DISCOUNT");
		if (tu_merchant == 3) {
			mes "啊，你回来了！";
			mes "现在我要";
			mes "告诉你";
			mes "低价买进技能，对吧？";
			next;
			mes "[瓜尔尼恩]";
			mes "^871F78低价买进^000000技能能让你以更低价格从 NPC 商店购买物品。它是始终生效且不消耗 SP 的^871F78被动技能^000000。";
			next;
			mes "[瓜尔尼恩]";
			mes "低价买进技能在";
			mes "^871F7810 级^000000时精通。技能等级越高，在 NPC 商店购买物品所需支付的价格越低。";
			next;
			mes "[瓜尔尼恩]";
			if(.@chk_disc > 3 && .@chk_disc < 10){
				mes "哦，做得不错。";
				mes "看来你已经把低价买进";
				mes "提升到 4 级了。";
				mes "来，收下这份";
				mes "小奖励~";
				getexp 83,11;
			} else if(.@chk_disc == 10){
				mes "难以置信！";
				mes "你竟然精通了低价买进技能！你真是个好学生，值得一点奖励！";
				getexp 97,18;
			} else {
				mes "好！为了更接近真正的商人，我希望你把低价买进技能学到 4 级。";
				next;
				mes "[瓜尔尼恩]";
				mes "如果能精通当然更好，";
				mes "但你可能更想把时间投入其他技能。";
				next;
				mes "[瓜尔尼恩]";
				mes "不过，讨价还价是商人的必备技能，不能忽视！准备好后再回来找我~";
				tu_merchant = 4;
				erasequest 8231;
				setquest 8232;
				close;
			}
			erasequest 8231;
			setquest 8233;
		}
		else {
			mes "学习低价买进进展如何？我一直说，不能讨价还价就当不了商人！";
			next;
			mes "[瓜尔尼恩]";
			if(.@chk_disc > 3 && .@chk_disc < 10){
				mes "啊，你已经学会";
				mes "如何使用低价买进技能了。";
				mes "很好，这是你努力的小奖励~";
				getexp 83,11;
			} else if(.@chk_disc == 10){
				mes "难以置信！";
				mes "你竟然精通了低价买进技能！你真是个好学生，值得一点奖励！";
				getexp 97,18;
			} else {
				mes "还没达到吗？";
				mes "你应该很快就能完成目标。毕竟这是成为商人的基础之一！";
				close;
			}
			erasequest 8232;
			setquest 8233;
		}
		tu_merchant = 5;
		next;
		mes "[瓜尔尼恩]";
		mes "好了，希望下一课能给你更多挑战。觉得准备好后再回来，好吗？";
		close;
	case 2:
		mes "啊，你回来继续学习了。让我想想要讲什么……对了，玛门特！";
		next;
		mes "[瓜尔尼恩]";
		mes "^871F78玛门特^000000 是一种消耗 Zeny 对目标造成巨大伤害的技能。金钱就是力量！";
		next;
		mes "[瓜尔尼恩]";
		mes "优点是伤害很高且只消耗少量 SP。但缺点是也会消耗你的 Zeny！";
		next;
		mes "[瓜尔尼恩]";
		mes "所以使用过于频繁可能会破产！一定要小心。而且玛门特技能等级越高，攻击力和 Zeny 消耗也越高。";
		next;
		mes "[瓜尔尼恩]";
		.@chk_mam = getskilllv("MC_MAMMONITE");
		if(.@chk_mam > 3 && .@chk_mam < 10){
			mes "啊，我看出你已经试过这项技能了。你用玛门特浪费了多少钱？希望不多。";
			next;
			mes "[瓜尔尼恩]";
			mes "你还很生疏，如果浪费了 Zeny 我会很遗憾。把这个当作补偿收下吧？";
			tu_merchant = 3;
			erasequest 8230;
			setquest 8231;
			getexp 70,12;
			next;
			mes "[瓜尔尼恩]";
			mes "好了，现在可以讲解 ^871F78低价买进^000000 技能了。想听更多时再回来找我，好吗？";
			close;
		} else {
			mes "好了，现在可以讲解 ^871F78低价买进^000000 技能了。想听更多时再回来找我，好吗？";
			tu_merchant = 3;
			erasequest 8230;
			setquest 8231;
			close;
		}
	case 1:
		mes "那么……";
		mes "你有没有按我的要求";
		mes "把负重增加";
		mes "技能学到 4 级？";
		next;
		mes "[瓜尔尼恩]";
		.@chk_soji = getskilllv("MC_INCCARRY");
		if(.@chk_soji > 3 && .@chk_soji < 10){
			mes "啊，看得出你已经学会了。不错！现在你应该能学习 ^871F78低价买进^000000 技能，不过稍后我再教你。";

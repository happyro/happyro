		close2;
		warp "ecl_fild01",100,317;
		end;
	}
	if (BaseLevel < 120) {
		mes "[Fairy Carpenter]";
		mes "桥有点坏了，请小心。";
		emotion ET_CRY;
	}
	else if (ep14_2_oliver == 3) {
		mes "[Fairy Carpenter]";
		mes "这里有些损坏，请小心。";
		mes "否则会一路掉下去。";
		next;
		switch( select("正在进行的工作:桥损坏的原因:算了。") ) {
			mes "[Fairy Carpenter]";
		case 1:
			mes "如你所见，我在做木工。";
			mes "最近来艾可拉治的访客更多了，所以我主要建造桥梁。";
			next;
			mes "[Fairy Carpenter]";
		mes "事实上拉斐尔可以飞，所以桥并非必要，但我们还是在建桥，因为许多访客爬树时摔伤了。";
			close;
		case 2:
			mes "哦，就在刚才，有个人踩空了，摔下去时折断了一根树枝。";
			emotion ET_FRET;
			next;
			mes "[Fairy Carpenter]";
			mes "这里靠近入口，真的需要尽快修好。";
			mes "我正在考虑是立警告牌、收集修理材料，还是叫朋友来帮忙。";
			next;
			if (select("提供帮助。:不提供帮助。") == 2) {
				mes "[Fairy Carpenter]";
				mes "修好前你无法通过这里，请小心。";
				close;
			}
			mes "[Fairy Carpenter]";
			mes "哇！！！";
			mes "你要帮我？！";
			mes "你……你真善良……";
			emotion ET_HUK;
			next;
			mes "[Fairy Carpenter]";
			mes "真不敢相信世上还存在这样的善意……嗯，眼睛出汗了……";
			emotion ET_CRY;
			next;
			mes "[Fairy Carpenter]";
			mes "那请带一座新桥给我修理用？";
			mes "因为其他人可能受伤，在此期间我会用魔法维持这座桥。";
			emotion ET_GO;
			ep14_2_oliver = 4;
			setquest 11312;
			close;
		case 3:
			mes "修好前你无法通过这里，请小心。";
			close;
		}
	}
	else if (ep14_2_oliver == 4) {
		select("用魔法修不好吗？");
		mes "[Fairy Carpenter]";
		mes "嗯，并非不可能，但创造生命的魔法需要大量魔力，不该如此随意使用。";
		next;
		mes "[Fairy Carpenter]";
		mes "如果要形容那有多愚蠢……就像把烤好的美味巧克力蛋糕重新变回面粉。";
		next;
		mes "[Fairy Carpenter]";
		mes "因为损坏部分距离这里约 19 米……";
		next;
		mes "[Fairy Carpenter]";
		mes "啊！我想起来了，以前可以订购准确的长度，但现在因为批量生产，只提供预设长度。";
		next;
		mes "[Fairy Carpenter]";
		mes "为了最大限度保持稳定，最好避免连接多块桥段，";
		next;
		mes "[Fairy Carpenter]";
		mes "而这座坏掉的桥……从这里到那里大约 19 米，预制件有 3 米、5 米和 10 米……";
		emotion ET_PROFUSELY_SWEAT;
		next;
		mes "[Fairy Carpenter]";
		mes "嗯……";
		emotion ET_PROFUSELY_SWEAT;
		next;
		mes "[Fairy Carpenter]";
		mes "嗯……";
		mes "......";
		emotion ET_PROFUSELY_SWEAT;
		next;
		mes "[Fairy Carpenter]";
		mes "……嗯……";
		emotion ET_PROFUSELY_SWEAT;
		next;
		mes "-我看到他头顶冒烟，大概只是我的错觉吧？-";
		emotion ET_PROFUSELY_SWEAT, playerattached();
		next;
		mes "[Fairy Carpenter]";
		mes "哦呵！";
		mes "你觉得呢？";
		emotion ET_SMILE;
		next;
		mes "[Fairy Carpenter]";
		mes "用最少桥段建造 19 米长的桥，需要多少块 3、5、10 米桥段？";
		emotion ET_QUESTION;
		next;
		mes "[Fairy Carpenter]";
		mes "请填写每种长度所需的桥段数量。如果不需要该长度的桥段，请填写 0。";
		input .@inputstr$;
		next;
		if (.@inputstr$ != "002") {
			mes "[Fairy Carpenter]";
		mes "嗯，这样有点……";
		mes "有没有更好的办法？";
			emotion ET_SWEAT;
			close;
		}
		mes "[Fairy Carpenter]";
		mes "嗯，听起来不错，对吧？";
		mes "尤其是不必把它们做得那么笔直。";
		emotion ET_AHA;
		next;
		mes "[Fairy Carpenter]";
		mes "好，去找城外塔附近工作的[Golie]，他会给你新的桥梁组件。";
		ep14_2_oliver = 5;
		changequest 11312,11313;
	}
	else if (ep14_2_oliver == 5) {
		mes "[Fairy Carpenter]";
		mes "去找城外塔附近工作的[Golie]，他会给你新的桥梁组件。";
	}
	else if (ep14_2_oliver == 6) {
		if (countitem(6553) < 2) {// Leaf_Made_Wood
			mes "[Fairy Carpenter]";
			mes "去找城外塔附近工作的[Golie]，他会给你新的桥梁组件。";
			close;
		}
		mes "[Carpenter Fon]";
		mes "哎呀，他还在担心那种事。";
		mes "他没必要这么认真。";
		next;
		mes "[Carpenter Fon]";
		mes "哇！现在不是做这个的时候。我应该快点修好桥，帮助所有掉下去的人。";
		next;
		mes "[Du Lian]";
		mes "啊！";
		mes "谢天谢地！";
		emotion ET_HUK, playerattached();
		emotion ET_HUK;
		cutin "bu_du2",2;
		next;
		mes "[Du Lian]";
		mes "要不是那根树枝，我就完蛋了。";
		next;
		mes "[Mark Esha]";
		mes "我叫你小心！";
		mes "你到底想惹出多大麻烦？";
		cutin "bu_mark4",0;
		next;
		cutin "",255;
		mes "[Carpenter Fon]";
		mes "...";
		emotion ET_SWEAT;
		next;
		mes "["+ strcharinfo(0) +"]";
		mes "...";
		emotion ET_SWEAT, playerattached();
		next;
		mes "[Du Lian]";
		mes "不可能！";
		mes "他们就是之前那些家伙！";
		mes "喂！";
		mes "我以为已经甩掉他们了，但看来没那么容易。";
		cutin "bu_du1",2;
		next;
		mes "[Mark Esha]";
		mes "对不起。";
		mes "自从认识以来，我们一直表现得不好。";
		cutin "bu_mark2",0;
		next;
		cutin "",255;
		mes "[Carpenter Fon]";
		mes "这次我就放过你，但如果再弄坏桥，我就把你关进监狱！";
		mes "你应该知道我自己也很忙。";
		emotion ET_FRET;
		next;
		mes "[Mark Esha]";
		mes "对不起。";
		mes "我会特别小心，请别担心。";
		cutin "bu_mark1",0;
		next;
		mes "[Du Lian]";
		mes "不过跑几步桥就这么容易断，是不是太脆弱了？";
		mes "巨人甚至没法这样拜访艾可拉治……";
		cutin "bu_du3",2;
		next;
		cutin "",255;
		mes "-咔嚓-";
		emotion ET_HUK;
		emotion ET_HUK, playerattached();
		next;
		mes "[Carpenter Fon]";
		mes "......";
		emotion ET_OTL;
		next;
		mes "[Mark Esha]";
		mes "哎呀……";
		cutin "bu_mark4",0;
		next;
		mes "[???]";
		mes "啊……";
		cutin "bu_maggi3",2;
		next;
		mes "[Du Lian]";
		mes "糟糕……";
		cutin "bu_du5",2;
		next;
		mes "[Du Lian]";
		mes "等等！不，这次真的只是意外！";
		mes "你看！";
		mes "连这个警告牌都说桥很危险，必须抓住扶手。";
		next;
		mes "[Du Lian]";
		mes "我只是把手放上去而已！";
		mes "我真的什么也没做！";
		next;
		cutin "",255;
		mes "[Carpenter Fon]";
		mes "......";
		emotion ET_THINK;
		next;
		mes "[Carpenter Fon]";
		mes "唉……";
		emotion ET_FRET;
		next;
		mes "[Carpenter Fon]";
		mes "可恶………………………………";
		mes "....................................";
		mes "............";
		emotion ET_HUK;
		next;
		mes "[Carpenter Fon]";
		mes "你这个捣蛋鬼，滚出去！！！！";
		emotion ET_HUK;
		next;
		mes "[Mark Esha]";
		mes "真的很抱歉。";
		mes "我晚些时候会来帮忙，就算要把这家伙绑在柱子上也行。";
		cutin "bu_mark3",0;
		next;
		cutin "",255;
		mes "[Carpenter Fon]";
		mes "别再回来！";
		mes "永远别回来！！！";
		emotion ET_HUK;
		next;
		mes "[Carpenter Fon]";
		mes "唉……";
		mes "我还以为今天做完工作就能见到朋友……";
		mes "看来今晚又要熬夜了。";
		emotion ET_OTL;
		next;
		mes "[Carpenter Fon]";
		mes "修理规模不大，我应该能想办法处理。";
		mes "唉……";
		emotion ET_CRY;
		next;
		mes "[Carpenter Fon]";
		mes strcharinfo(0) +"，你该去艾可拉治了。";
		mes "沿着这条路走到城市北部即可。";
		emotion ET_OHNO;
		next;
		mes "[Carpenter Fon]";
		mes "进入艾可拉治后就能看到主广场，我相信你很容易从那里的人们口中打听到信息。";
		next;
		mes "[Carpenter Fon]";
		mes "路上能告诉我的朋友 Glasses 我今天去不了吗？";
		next;
		if (countitem(6553) < 2) {
			mes "[Carpenter Fon]";
			mes "可是材料在哪里？";
			mes "我得尽快开始修理……";
			close;
		}
		mes "[Carpenter Fon]";
		mes "我本来要和朋友商量即将到来的生日，但不能一直让他们等，所以真的拜托你了。";
		emotion ET_SORRY;
		delitem 6553,2;// Leaf_Made_Wood
		ep14_2_oliver = 7;
		changequest 11314,11315;
	}
	else if (ep14_2_oliver == 7) {
		mes "[Carpenter Fon]";
		mes "路上能告诉我的朋友 Glasses 我今天去不了吗？";
		next;
		mes "[Carpenter Fon]";
		mes "我本来要和朋友商量即将到来的生日，但不能一直让他们等，所以真的拜托你了。";
		emotion ET_SORRY;
	}
	else {
		mes "[Carpenter Fon]";
		mes "我真想快点见到朋友。";
		emotion ET_CRY;
	}
	close;
}

ecl_fild01,192,94,4	script	Golie#ep14_2	4_M_FAIRYKID,{
	if (checkweight(1201,1) == 0 || (MaxWeight - Weight) < 1000) {
	mes "- 请停在这里！！-";
	mes "- 物品种类太多，-";
	mes "- 无法领取该物品。-";
	mes "- 请减轻负重，-";
	mes "- 然后再试。-";
		close;
	}
	mes "[Golie]";
	if (ep14_2_oliver == 5) {
		mes "据说生命是大自然最伟大的发明，而死亡只是为了获得更多生命的手段。";
		next;
		mes "[Golie]";
		mes "然而，这些由魔法诞生的嫩芽有生命吗？";
		mes "由魔法诞生的桥算死物吗？";
		next;
		mes "[Golie]";
		mes "我花了很多时间从种子培育桥梁，所以看到这么多桥被损坏和替换，会让我很难过。";
		next;
		mes "[Golie]";
		mes "时代正在这样改变吗……？这一定就是我创造这些悲惨命运之物的原因。";
		next;
		mes "[Golie]";
		mes "这种种子以我的名字命名为[Goliath]，是一种能长出两根茎和一片叶子的奇特植物，可用作桥梁。";
		next;
		mes "[Golie]";
		mes "多亏 Goliath，桥梁的迫切需求得到解决，但我担心有一天，利用魔法违背自然规律会带来可怕后果。";
		next;
		mes "[Golie]";
		mes "最近和身边伟大的 Fili 一起工作让我逐渐受到鼓舞，但我保证总有一天一切都会修好。";
		next;
		mes "[Golie]";
		mes "每当你灰心丧气时，试着带着烦恼去找 Fili。你或许会获得新的领悟。";
		mes "而且……嗯……我们闲聊的时候桥已经修好了。";
		next;
		mes "[Golie]";
		mes "好了，现在可以把这个交给 Fon。虽然我知道现在很忙，也请告诉他：‘请更加珍惜地照顾它们。’";
		next;
		mes "[Golie]";
		mes "我最近确实忙着帮助 Fili 工作，但桥梁似乎也坏得太频繁了。";
		ep14_2_oliver = 6;
		getitem 6553,2;// Leaf_Made_Wood
		changequest 11313,11314;
	}
	else if (ep14_2_oliver == 6) {
		if (countitem(6553) < 2) {
			mes "你把材料弄丢了？";
			mes "看你这么忙，我再给你一份，但请小心保管。";
			getitem 6553,2-countitem(6553);// Leaf_Made_Wood
		}
		else {
			mes "好了，现在可以把这个交给 Fon。另外，虽然我知道最近很忙，也请告诉他：‘请更加珍惜地照顾它们。’";
			next;
			mes "[Golie]";
		mes "我最近确实忙着帮助 Fili 工作，但桥梁似乎也坏得太频繁了。";
		}
	}
	else {
		mes "为了培育老树精，";
		mes "从春天开始，大嘴鸟";
		mes "一定会这样鸣叫。";
		next;
		mes "[Golie]";
		mes "为了培育老树精，";
		mes "钟楼里的警报";
		mes "也一定会这样响起。";
		next;
		mes "[Golie]";
		mes "这是米德加尔特的吟游诗人送给我的歌。歌词和自然气息深深打动了我。";
		next;
		mes "[Golie]";
		mes "我也很想听听你知道的歌曲。";
	}
	close;
}

eclage,283,275,4	script	Glaces#ep14_2	4_F_FAIRYKID3,{
	mes "[Glaces]";
	if (ep14_2_oliver < 7) {
		mes "Hm......";
		mes "那些家伙迟到了。";
		mes "我只能猜他们最近忙着应付来访艾可拉治的人，但……";
		next;
		mes "[Glaces]";
		mes "为什么……为什么我有这么多空闲时间……？";
		mes "只有我这么闲吗？";
		mes "真的只有我吗？";
		emotion ET_HUK;
	}
	else if (ep14_2_oliver == 7) {
		mes "嗯……";
		mes "那些家伙迟到了。";
		next;
		mes "["+ strcharinfo(0) +"]";
		mes "请问？";
		next;
		mes "[Glaces]";
		mes "什么事？";
		next;
		mes "[Glaces]";
		mes "Ah...";
		mes "哦……嗯……";
		next;
		mes "[Glaces]";
		mes "嗯……这对我来说有点尴尬……";
		emotion ET_KEK, playerattached();
		next;
		mes "["+ strcharinfo(0) +"]";
		mes "不，我不是这个意思……";
		emotion ET_SWEAT, playerattached();
		next;
		mes "[Glaces]";
		mes "嗯……";
		mes "你看，我已经有男朋友了。";
		mes "天啊。";
		next;
		mes "[Glaces]";
		mes "所以我不喜欢长时间等人。我的人气太高，去哪里都会被注意到。";
		emotion ET_FRET;
		emotion ET_PROFUSELY_SWEAT, playerattached();
		next;
		mes "["+ strcharinfo(0) +"]";
		mes "不，我是说……Fon 先生让我告诉你，他因为工作无法赴约……";
		next;
		mes "[Glaces]";
		mes "...";
		emotion ET_THINK;
		next;
		mes "[Glaces]";
		mes "哦，我明白了。";
		next;
		mes "[Glaces]";
		mes "是啊，我觉得自己应该找个地方躲起来。";
		emotion ET_THINK;
		next;
		mes "[Glaces]";
		mes "总之，Fon 来不了吗？";
		emotion ET_HUK;
		next;
		mes "[Glaces]";
		mes "Moreng 的生日快到了，我们一直见不到面，生日会可能会变得很糟。";
		next;
		mes "[Glaces]";
		mes "Yube 甚至从斯普兰迪德飞来参加 Moreng 的生日……";
		mes "说起来，那家伙去哪儿了？！";
		emotion ET_HUK;
		next;
		mes "[Glaces]";
		mes "是他提议我们在他家见面的。";
		mes "他至少应该在消失前把门打开！";
		emotion ET_HUK;
		next;
		mes "[Glaces]";
		mes "我不能离开这里，因为其他人可能会来。如果你看到一个头上长着黄色橘梗般东西的妖精，请告诉他 Glaces 在找他。";
		next;
		mes "[Glaces]";
		mes "还请告诉他，如果不马上回来，我就把那根梗拔掉。";
		next;
		mes "[Du Lian]";
		mes "太好了！！！";
		mes "这个";
		mes "忙我帮了！";
		mes "交给我吧！";
		emotion ET_HUK;
		emotion ET_HUK, playerattached();
		cutin "bu_du1",2;
		next;
		cutin "",255;
		mes "["+ strcharinfo(0) +"]";
		mes "???";
		next;
		mes "[Mark Esha]";
		mes "嘿！我说过别插手别人的谈话！";
		cutin "bu_mark3",0;
		next;
		mes "[Du Lian]";
		mes "你在说什么？";
		mes "战士的职责就是前往任何需要帮助的地方！";
		cutin "bu_du2",2;
		next;
		mes "[Du Lian]";
		mes "还有你！";
		mes "我们一次又一次遇到你，一定是某种命运！";
		cutin "bu_du1",2;
		next;
		mes "[Du Lian]";
		mes "好！";
		mes "我决定了！";
		cutin "bu_du2",2;
		next;
		mes "[Du Lian]";
		mes "我通常不会这样认可别人，但我允许你成为我的对手！";
		mes "至于比赛——！！";
		mes "那就是帮助这个妖精姑娘 Graces！";

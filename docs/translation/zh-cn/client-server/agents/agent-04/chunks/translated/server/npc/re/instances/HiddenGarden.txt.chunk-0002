	sleep 5000;
	if ('talk_bool) {
		npctalk "CAROTA-88 收到管理员确认，瓦尔蒙特的指示已完美执行。";
		sleep 3000;
		emotion ET_DELIGHT;
		sleep 2000;
		npctalk "在收到进一步命令前，将重复现有工作流程。";
	}
	else {
		npctalk "学习更多培育方法。";
		sleep 3000;
		emotion ET_DELIGHT;
		sleep 2000;
		npctalk "我会积极增加对原本要丢弃的改良作物种子的实验比例。";
	}
	sleep 5000;
	npctalk "谢谢你，[" + 'admin$ + "]回应了评估。";
	sleep 5000;
	if ('talk_bool)
		npctalk "自动人偶进入控制模式，消灭地下鼹鼠。再见。";
	else
		npctalk "我去地下室仓库检查新品种。";
	progressbar_npc "3131FF",4;
	disablenpc();
	npctalk "CAROTA-88 对这次评估做出了不合逻辑的回应。我们会尽快安排检查。", instance_npcname("#BMD000002");
	sleep 3000;
	if ('hidden_garden == 6)
		unitwalk 'guide_id,147,278, instance_npcname("#BMD000002") + "::OnEvent05";
	'npc_is_talking = false;
	end;

OnEvent00:
	npctalk "CAROTA-88 的项目是在这里种植作物并保护它们不受外来者侵扰。你为什么离开了？", instance_npcname("#BMD000002");
	unitwalk 'carota,137,272, instance_npcname("#carota") + "::OnEvent01";
	end;

OnEvent01:
	.@doll$ = instance_npcname("#BMD000002");
	sleep 5000;
	emotion ET_FRET;
	sleep 3000;
	npctalk "目前这里有一名人类管理员。我建议将语言代码改为人类官方语言。", .@doll$;
	sleep 3000;
	emotion ET_FRET;
	sleep 2000;
	progressbar_npc "3131FF",2;
	sleep 1000;
	specialeffect EF_FLOWERCAST;
	sleep 3000;
	npctalk "管理自动人偶太不讲理了！！太过分了！！追捕 5 只鼹鼠时强行召回！！！萝卜毁了！！！";
	sleep 5000;
	npctalk "你还没更新语言包吗？定期更新不是强制的，但很重要。", .@doll$;
	sleep 5000;
	npctalk "CAROTA-88 数据存储容量。语言扩展包负担过重。若不重要，我将返回原本的工作。";
	sleep 5000;
	npctalk "请稍等，CAROTA-88。这里有一名可以进行现场检查的管理员。", .@doll$;
	sleep 5000;
	npctalk "距离上次评估 CAROTA-88 已经过了很久吧？", .@doll$;
	sleep 5000;
	npctalk "CAROTA-88 距离上次研究评估已超过一百万小时。无法保存更多日志。";
	sleep 5000;
	npctalk "CAROTA-88。你不想进行项目评估吗？现在错过这位管理员，就不知道什么时候才能再次进行项目评估了。", .@doll$;
	sleep 5000;
	npctalk "同意自动人偶[" + 'guide_name$ + "]的意见。我想立即进行项目评估。";
	sleep 6000;
	npctalk "那么，打开你的控制面板，联系[" + 'admin$ + "]。CAROTA-88。", .@doll$;
	progressbar_npc "3131FF",2;
	sleep 1000;
	specialeffect EF_FLOWERCAST;
	sleep 2000;
	npctalk "自动人偶 CAROTA-88 控制面板已打开。等待输入……";
	'hidden_garden = 6;
	specialeffect EF_MARKING_USE_CHANGEMONSTER;
	end;

OnAction:
	npcspeed 200;
	switch( 'action ) {
		case 0: .@x = 138; .@y = 266; .@event$ = "OnAction"; break;
		case 1: .@x = 139; .@y = 272; .@event$ = "OnAction"; break;
		case 2: .@x = 135; .@y = 270; .@event$ = "OnAction"; .@effect = true; break;
		case 3: .@x = 140; .@y = 270; .@event$ = "OnAction"; .@effect = true; break;
		case 4: .@x = 135; .@y = 270; .@event$ = "OnAction"; .@effect = true; break;
		case 5: .@x = 138; .@y = 266; .@event$ = "OnAction"; .@effect = true; break;
		case 6: .@x = 140; .@y = 267; .@event$ = "OnAction"; .@effect = true; break;
		case 7: .@x = 139; .@y = 266; .@event$ = "OnAction"; break;
		case 8: .@x = 135; .@y = 267; .@event$ = "OnAction"; .@effect = true; break;
		case 9: .@x = 139; .@y = 271; .@event$ = "OnAction"; .@transform = true; break;
		case 10: .@x = 134; .@y = 272; .@event$ = "OnAction"; break;
		case 11: .@x = 136; .@y = 270; .@event$ = "OnAction"; break;
		case 12: .@x = 134; .@y = 271; .@event$ = "OnAction"; break;
		case 13: .@x = 134; .@y = 267; .@event$ = "OnEvent00"; break;
	}
	'action += 1;
	if (.@effect)
		specialeffect EF_METEORSTORM;
	unitwalk 'carota,.@x,.@y, instance_npcname("#carota")+ "::" + .@event$;
	if (.@transform)
		setnpcdisplay instance_npcname("#carota"),3153;	// EXCAVATOR_ROBOT
	end;

OnTouch:
	if ('hidden_garden == 6) {
		removespecialeffect EF_MARKING_USE_CHANGEMONSTER;
		specialeffect EF_MARKING_USE_CHANGEMONSTER;
		end;
	}
	end;
}


1@herbs,250,280,4	script(DISABLED)	#BMD000003	MD_ASSISTANT,3,3,{
	if ('hidden_garden == 7) {
		'hidden_garden = 8;
		removespecialeffect EF_MARKING_USE_CHANGEMONSTER;
		npcspeed 200;
		'guide_id = getnpcid(0, instance_npcname("#BMD000003"));
		npctalk "这一区域用于研究一种名为南瓜的植物。";
		unitwalk 'guide_id,253,277, instance_npcname("#BMD000003") + "::OnEvent01";
		end;
	}
	end;

OnEvent01:
	unitwalk 'guide_id,253,265, instance_npcname("#BMD000003") + "::OnEvent02";
	end;

OnEvent02:
	unitwalk 'guide_id,251,265, instance_npcname("#BMD000003") + "::OnEvent03";
	end;

OnEvent03:
	npctalk "这里的负责人是 pimp25，一个以此世界生物为模型的自动人偶。";
	specialeffect EF_MARKING_USE_CHANGEMONSTER, AREA, instance_npcname("#pimp25");
	'hidden_garden = 9;
	end;

OnEvent04:
	unitwalk 'guide_id,254,254, instance_npcname("#BMD000003") + "::OnEvent05";
	end;

OnEvent05:
	unitwalk 'guide_id,251,251, instance_npcname("#BMD000003") + "::OnEvent06";
	end;

OnEvent06:
	unitwalk 'guide_id,239,251, instance_npcname("#BMD000003") + "::OnEvent07";
	end;

OnEvent07:
	npctalk "继续前进。";
	enablenpc instance_npcname("#BMD000004");
	for ( .@i = 1; .@i < 4; ++.@i ) {
		enablenpc instance_npcname("#swat_" + .@i);
		hideonnpc instance_npcname("#swat_" + .@i);
	}
	sleep 5000;
	instance_warpall 'map_herbs$,206,288,instance_id();
	sleep 1000;
	removespecialeffect EF_MARKING_USE_CHANGEMONSTER, AREA, instance_npcname("#BMD000004");
	specialeffect EF_MARKING_USE_CHANGEMONSTER, AREA, instance_npcname("#BMD000004");
	disablenpc();
	end;
OnTouch:
	if ('hidden_garden == 7) {
		removespecialeffect EF_MARKING_USE_CHANGEMONSTER;
		specialeffect EF_MARKING_USE_CHANGEMONSTER;
	}
	end;
}

1@herbs,249,268,6	script(DISABLED)	#pimp25	LITTLE_FATUM,3,3,{
	if ('pimp == 0) {
		'pimp = 1;
		npcstop;
	}
	if ('hidden_garden == 9) {
		removespecialeffect EF_MARKING_USE_CHANGEMONSTER;
		while (true) {
			switch( select( "取消。", "你照管这里多久了？", "它们都在这里耕种吗？" ) ) {
			case 1:
				end;
			case 2:
				break;
			case 3:
				npctalk "我的工作是见证生命的诞生与进化！我的研究绝不简单！";
				continue;
			}
			break;
		}
		setpcblock PCBLOCK_NPC, true;
		npctalk "我已经多久没收到瓦尔蒙特的命令了？！";
		sleep2 5000;
		npctalk "大概……大约……已经过去一百多万小时了。之后的设施管理是我自行决定的。";
		sleep2 5000;
		npctalk "pimp。向管理员报告时，必须报告准确的记录时间。", instance_npcname("#BMD000003");
		sleep2 3000;
		npctalk "是这样吗？但 pimp 无法记录超过一百万小时的数据。那会浪费记忆资源！瓦尔蒙特会生气的！";
		sleep2 1000;
		setpcblock PCBLOCK_NPC, false;
		select("你对南瓜种植的研究进展如何？");
		setpcblock PCBLOCK_NPC, true;
		sleep2 1000;
		npctalk "目前正在生长的植物。南瓜在控制人类血管中的钠方面效果显著。";
		sleep2 5000;
		npctalk "这里产的南瓜含糖量高、热量充足。按人类标准非常美味。附近的狗和猫也会吃……";
		sleep2 1000;
		setpcblock PCBLOCK_NPC, false;
		select("它是用食物做的吗？");
		setpcblock PCBLOCK_NPC, true;
		sleep2 1000;
		npctalk "我判断它对各种生物都很有价值。它一直在持续生产、加工和储存。";
		sleep2 5000;
		npctalk "目前年产量约三吨。为便于长期保存，它以干制食品的形式储存在 2 至 6 号仓库中。";
		sleep2 1000;
		setpcblock PCBLOCK_NPC, false;
		select("这些方法都是你决定的吗？");
		setpcblock PCBLOCK_NPC, true;
		sleep2 1000;
		npctalk "pimp 没有自行决策的意志！只有瓦尔蒙特大人知道。";
		sleep2 1000;
		setpcblock PCBLOCK_NPC, false;
		select("有人替你决定研究方向吗？");
		setpcblock PCBLOCK_NPC, true;
		sleep2 1000;
		npctalk "我问过瓦尔蒙特好几次该怎么办，但没有得到回答。";
		sleep2 5000;
		npctalk "由于没有主人下达命令，pimp 开始寻找能发挥研究作用的地方。";
		sleep2 1000;
		setpcblock PCBLOCK_NPC, false;
		select("你找到它了吗？");
		setpcblock PCBLOCK_NPC, true;
		sleep2 1000;
		npctalk "维护这座宅邸需要钱。要花很多钱！";
		sleep2 3000;
		npctalk "仓库里的干南瓜是给冒险者准备的保存食品，会在大陆各地出售。销售收入就是资金来源。";
		sleep2 5000;
		npctalk "钱可以保护宅邸。pimp 会保护这里！所以我才努力种南瓜！";
		sleep2 1000;
		setpcblock PCBLOCK_NPC, false;
		select("真没想到你能独自决定这么多事。");
		setpcblock PCBLOCK_NPC, true;
		sleep2 1000;
		npctalk "我做了决定？我从未得出过这样的推论。";
		sleep2 3000;
		npctalk "......";
		sleep2 2000;
		npctalk "[计算中]";
		progressbar_npc "3131FF",3;
		'hidden_garden = 10;
		setpcblock PCBLOCK_NPC, false;
		npctalk "你让我困惑了！pimp 只应执行被赋予的任务。管理员，请不要再和我说话。";
		sleep 5000;
		npctalk "你说完了吗？这里的对话会被记录为评估数据。我们前往下一个区域吧。", instance_npcname("#BMD000003");
		unitwalk 'guide_id,254,261, instance_npcname("#BMD000003") + "::OnEvent04";
		end;
	}
	if ('hidden_garden > 9)
		npctalk "滚出去！";
	end;

OnWalk:
	npcspeed 150;
	while ('pimp == 0) {
		switch( 'walk ) {
			case 0: .@x = 249; .@y = 268; 'walk = 1; break;
			case 1: .@x = 249; .@y = 259; 'walk = 2; break;
			case 2: .@x = 240; .@y = 259; 'walk = 3; break;
			case 3: .@x = 240; .@y = 268; 'walk = 0; break;
		}
		npcwalkto .@x,.@y;
		sleep 1500;
	}
	end;

OnTouch:
	if ('hidden_garden == 9) {
		removespecialeffect EF_MARKING_USE_CHANGEMONSTER;
		specialeffect EF_MARKING_USE_CHANGEMONSTER;
	}
	end;
}


1@herbs,201,287,4	script(DISABLED)	#BMD000004	MD_ASSISTANT,3,3,{
	if ('hidden_garden == 10) {
		removespecialeffect EF_MARKING_USE_CHANGEMONSTER;
		mes "[" + 'guide_name$ + "]";
		mes "这一区域由三个自动人偶管理。要继续导览吗？";
		next;
		if (select( "取消。", "继续。" ) == 1) {
			mes "[" + 'guide_name$ + "]";
			mes "我会等待进一步指示。";
			close;
		}
		if ('hidden_garden == 10) {
			'hidden_garden = 11;
			npcspeed 200;
			'guide_id = getnpcid(0, instance_npcname("#BMD000004"));
			npctalk "我不知道这里是做什么的，因为我的权限等级无法访问这里。";
			unitwalk 'guide_id,201,285, instance_npcname("#BMD000004") + "::OnEvent01";
		}
		end;
	}
	if ('hidden_garden == 12) {
		removespecialeffect EF_MARKING_USE_CHANGEMONSTER;
		mes "[" + 'guide_name$ + "]";
		mes "有什么我能帮忙的吗？";
		next;
		if (select( "取消。", "那些自动人偶是什么？" ) == 1) {
			mes "[" + 'guide_name$ + "]";
			mes "进入待机模式。";
			close;
		}
		mes "[" + 'guide_name$ + "]";
		mes "自动人偶按用途分类。";
		next;
		mes "[" + 'guide_name$ + "]";
		mes "攻击[" + 'admin$ + "]的单元是 4 型战斗自动人偶的初始版本。它的战斗力相当于 20 名成年人的总和。";
		next;
		mes "[" + 'guide_name$ + "]";
		mes "由于结果出乎意料，我已将信息报告给管理者^0000CD西格玛^000000。临时管理员的战斗能力并非普通人类水平。";
		next;
		select("那是谁？？");
		mes "[" + 'guide_name$ + "]";
		mes "这是这座宅邸中权限最高的三个控制系统之一。";
		close2;
		while(true) {
			if (.@talk && .@talk2)
				.@question$ = "^FF0000Is the security area near here?^000000";
			switch( select( "花园是安全区域吗？", "花园的真正用途是什么？", .@question$, .@teleport$ ) ) {
			case 1:
				setpcblock PCBLOCK_NPC, true;
				sleep2 1000;
				npctalk "花园是安全区域与普通区域的边界。";
				sleep2 5000;
				npctalk "对于拥有足够权限的人来说，这里被划为安全区域。";
				sleep2 3000;
				.@talk = 1;
				break;
			case 2:
				setpcblock PCBLOCK_NPC, true;
				sleep2 1000;
				npctalk "请理解，这是一片缓冲区，用于保护不应被外来者看见的区域。";
				sleep2 5000;
				npctalk "以我的权限等级，禁止访问除此之外的任何信息。";
				sleep2 3000;
				.@talk2 = 1;
				break;
			case 3:
				setpcblock PCBLOCK_NPC, true;
				sleep2 1000;
				npctalk "--- 运行中 ---";
				progressbar_npc "3131FF",3;
				npctalk "[警告] 此信息接近当前权限上限。";
				sleep2 5000;
				npctalk "安全区域就在当前坐标附近。";
				sleep2 3000;
				.@teleport$ = "^FF11FF带我去安全区域。^000000";
				break;
			case 4:
				setpcblock PCBLOCK_NPC, true;
				npctalk "--- 运行中 ---";
				progressbar_npc "3131FF",3;
				npctalk "[警告] 此请求超出了我的权限等级。";
				sleep2 5000;
				npctalk "由于管理员[" + 'admin$ + "]的权限等级过低，你的请求已被拒绝。";
				setpcblock PCBLOCK_NPC, false;
				sleep 5000;
				mapannounce 'map_herbs$, "???：自动人偶对你的反应很新鲜。奇怪的访客。", bc_map, 0xF6D6B6;
				sleep 5000;
				mapannounce 'map_herbs$, "???：你要护送他去安全区域吗？BMD000001。不，我是说自动人偶，[" + 'guide_name$ + "]。", bc_map, 0xF6D6B6;
				sleep 5000;
				npctalk "这个声音的生物波长……";
				sleep 3000;
				mapannounce 'map_herbs$, "不用告诉我自己是谁，倒是很方便。不过，你确定能告诉我之前发生了什么吗？", bc_map, 0xF6D6B6;
				sleep 5000;
				npctalk "你是说安全区域？但以我的权限等级无法进入。";
				sleep 3000;
				mapannounce 'map_herbs$, "那件事已经处理好了。[" + 'guide_name$ + "]，带访客来这里。", bc_map, 0xF6D6B6;
				sleep 5000;
				npctalk "这是我被制造以来第一次遇到这种情况。既然出现了例外，我们会相应修改部分流程。";
				sleep 5000;
				if ('hidden_garden == 12) {
					'hidden_garden = 13;
					npctalk "我带你去安全区域。";
					unitwalk 'guide_id,196,275, instance_npcname("#BMD000004") + "::OnEvent08";
				}
				end;
			}
			setpcblock PCBLOCK_NPC, false;
		}
	}
	end;

OnEvent:
	npctalk "[正在搜索该区域自动人偶的坐标。]";
	progressbar_npc "3131FF",2;
	mapannounce 'map_herbs$, "???：检测到未经授权的外来者入侵。代码类别 063。正在进入识别流程。", bc_map, 0xFF44FF;
	sleep 5000;
	npctalk "看来自动人偶回来了。我觉得它们对管理员并不友好。";
	sleep 5000;
	specialeffect EF_FIREPILLARON2, AREA, instance_npcname("#swat_1");
	sleep 500;
	specialeffect EF_FIREPILLARON2, AREA, instance_npcname("#swat_2");
	sleep 500;
	specialeffect EF_FIREPILLARON2, AREA, instance_npcname("#swat_3");
	hideoffnpc instance_npcname("#swat_1");
	hideoffnpc instance_npcname("#swat_2");
	hideoffnpc instance_npcname("#swat_3");
	setnpcdisplay instance_npcname("#swat_1"),1739;	// G_ALICEL
	setnpcdisplay instance_npcname("#swat_2"),1739;
	setnpcdisplay instance_npcname("#swat_3"),1739;
	sleep 2000;
	npctalk "面部生物识别。正在与数据库中登记的管理员列表进行比对。", instance_npcname("#swat_3");
	sleep 2000;
	npctalk "——无匹配项——", instance_npcname("#swat_1");
	sleep 500;
	npctalk "——无匹配项——", instance_npcname("#swat_2");
	sleep 500;
	npctalk "——无匹配项——", instance_npcname("#swat_3");
	sleep 2000;
	npctalk "压制未经授权的外来者。", instance_npcname("#swat_1");
	sleep 500;
	npctalk "---- 战斗模式 ----", instance_npcname("#swat_2");
	sleep 500;
	npctalk "---- 战斗模式 ----", instance_npcname("#swat_3");
	sleep 500;
	for ( .@i = 1; .@i < 4; ++.@i )
		donpcevent instance_npcname("#swat_" + .@i) + "::OnSummon";
	end;

OnEvent2:
	npctalk "我们前往传送点。请待在我附近。";
	enablenpc instance_npcname("#BMD000005");
	enablenpc instance_npcname("#sigma");
	enablenpc instance_npcname("#omega");
	enablenpc instance_npcname("#kappa");
	enablenpc instance_npcname("#barmund");

	hideonnpc instance_npcname("#omega");
	hideonnpc instance_npcname("#kappa");
	hideonnpc instance_npcname("#barmund");
	for ( .@i = 1; .@i < 4; ++.@i ) {
		enablenpc instance_npcname("#eff_npc" + .@i);
		hideonnpc instance_npcname("#eff_npc" + .@i);
	}
	sleep 5000;
	instance_warpall 'map_herbs$,85,106,instance_id();
	sleep 1000;
	removespecialeffect EF_MARKING_USE_CHANGEMONSTER, AREA, instance_npcname("#BMD000005");
	specialeffect EF_MARKING_USE_CHANGEMONSTER, AREA, instance_npcname("#BMD000005");
	disablenpc();
	end;

OnEvent01:
	npcspeed 200;
	unitwalk 'guide_id,201,281, instance_npcname("#BMD000004") + "::OnEvent02";
	end;

OnEvent02:
	unitwalk 'guide_id,194,281, instance_npcname("#BMD000004") + "::OnEvent03";
	end;

OnEvent03:
	npctalk "不过，既然有 3 个自动人偶负责管理，我可以判断这里有重要用途。";
	unitwalk 'guide_id,196,279, instance_npcname("#BMD000004") + "::OnEvent04";
	end;

OnEvent04:
	unitwalk 'guide_id,196,265, instance_npcname("#BMD000004") + "::OnEvent05";
	end;

OnEvent05:

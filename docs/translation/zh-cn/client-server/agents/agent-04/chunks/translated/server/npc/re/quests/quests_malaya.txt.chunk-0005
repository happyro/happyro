						mes "[潘多伊]";
						mes "... 你说得对...";
						mes "我永远也做不出银刃...";
					mes "放弃吧……我还以为你会鼓励我……我有点失望。";
						close;
					}
					mes "[潘多伊]";
					mes "我就知道可以依靠你！";
					mes "我就知道可以依靠你！";
					mes "请给我10个银手镯。";
					setquest 7393;
					next;
					mes "[潘多伊]";
					mes "潘多伊永远会对你微笑～";
					mes "（咧嘴笑）";
					close;
				} else {
					mes "[潘多伊]";
					mes "银刃！";
					mes "太棒了！精彩！ 一击斩尽邪恶的圣剑……！";
					next;
					mes "[潘多伊]";
					mes "我想靠制作银刃成为知名铁匠。";
					mes "可是我弄不到材料。";
					next;
					mes "[潘多伊]";
					mes "我听说医院里的人戴银手镯作为身份标志。";
					mes "但我到那里后，发现那已经不是我熟悉的医院了。";
					next;
					mes "[潘多伊]";
					mes "你能消灭可怕的爬行怪并拿银手镯给我吗？";
					next;
					if (select("确实！:才不要。") == 2) {
						mes "[潘多伊]";
						mes "... 你说得对...";
					mes "我永远不会制作银刃……";
					mes "那种直白的厌恶表情。你知道吗？我现在也讨厌这个想法了。";
						close;
					}
					mes "[潘多伊]";
					mes "我就知道！";
					mes "教训一下医院里的那些东西……";
					mes "然后带回来，请给我 10 个银手镯。";
					setquest 7393;
					next;
					mes "[潘多伊]";
					mes "潘多伊永远会对你微笑～";
				mes "（咧嘴笑）";
					close;
				}
			}
		case 3:
			mes "[潘多伊]";
			mes "你需要银十字架吗？";
			mes "潘多伊会为你制作！";
			mes "不过我不能凭空创造东西，所以需要一些银。";
			next;
			mes "[潘多伊]";
			mes "我可以用怪物持有的 ^4d4dff2 个银手镯^000000……";
			mes "如果你有银手镯，我可以用它们制作银十字架。";
			next;
				switch(select("制作 1 个银十字架:制作 6 个银十字架:输入数量:退出。")) {
			case 1:
				set .@amount,1;
			case 2:
				if (!.@amount) set .@amount,6;
				if (countitem(6508) < (.@amount * 2)) {
					mes "[潘多伊]";
				mes "你至少需要 " + (.@amount * 2) + " 个银手镯来制作 " + .@amount + " 个银十字架。";
					close;
				}
				set .@time,5;
				break;
			case 3:
				mes "[潘多伊]";
				mes "你需要多少银十字架？";
				mes "一次最多可以制作 50 个。";
				next;
				input .@amount;
				if (.@amount == 0) {
					mes "[潘多伊]";
					mes "不需要银十字架？";
					mes "那我可以休息了。哈哈哈哈～";
					close;
				} else if (.@amount > 50) {
					mes "[潘多伊]";
				mes "一次最多 50 个！";
					close;
				}
				if (countitem(6508) < (2 * .@amount)) {
					mes "[潘多伊]";
				mes "要制作" + .@amount + "个银" + ((.@amount == 1) ? "十字架" : "十字架") + "，至少需要" + (2 * .@amount) + "个银手镯。";
					close;
				}
				set .@time,15;
				break;
			case 4:
				mes "[潘多伊]";
			mes "需要我时我会在这里！";
				close;
			}
			mes "[潘多伊]";
			mes "只需要一会儿。";
			mes "Pandoi 马上就能做好！";
			close2;
			progressbar "0xffff00", .@time;
			delitem 6508, .@amount * 2; //Silver_Bracelet
			getitem 6502, .@amount; // Silver_Cross
			mes "[潘多伊]";
			mes "看看这个！";
			mes "真的很不错。";
			mes "我早该当工匠，而不是铁匠！";
			close;
		}
	}
	end;
}

malaya,326,68,2	script	Pedro the Sailor	100,{
	if (MaxWeight - Weight < 1000 || checkweight(1201,1) == 0) {
		mes "- 无法继续任务。你携带的物品太多。-";
		close;
	}
	if (malaya_hi < 10) {
		mes "[水手佩德罗]";
		mes "哦……这艘船停止服务了。";
		mes "或者说，它无法起航。*窃笑*";
		mes "我看到了幽灵。我想我大限将至。";
		close;
	} else if (malaya_hi == 10) {
		if (checkquest(7352) == 2) {
			mes "- 水手 Pedro 似乎放弃了，但他的目光无法从我身上移开。-";
			close;
		}
		mes "[水手佩德罗]";
		mes "哦，你是……挥挥手就能驱赶幽灵的那个人？！";
		mes "能留下听我说几句吗？！";
		next;
		if (select("抱歉。:好吧。") == 1) {
			mes "[水手佩德罗]";
			mes "哦，坚决的拒绝。";
			mes "你刺穿了我最后一丝希望。";
			mes "也许是我说服力不够……";
			close;
		}
		mes "[水手佩德罗]";
		mes "直说吧，这个镇子是幽灵的巢穴！";
		mes "唉……我当水手很久了，也去过很多地方，但从没遇到过这种事。";
		next;
		mes "[水手佩德罗]";
		mes "你看到那艘船了吗？";
		mes "那是一艘小渡船，但也因为这些该死的幽灵停止服务了！";
		next;
		mes "[水手佩德罗]";
		mes "从外面看还好，但里面全是幽灵，我说真的。";
		mes "不过听说它们害怕你，对吧？";
		next;
		select ("哦，不会吧，你也……:别按我的按钮！");
		mes "[水手佩德罗]";
		mes "我看已经有很多人向你要东西做护符了。";
		mes "我也能排进去吗？";
		next;
		mes "[水手佩德罗]";
		mes "我需要和那边的幽灵进行真诚的交谈。";
		mes "但那股灵力太强，我无法靠近。";
		next;
		mes "[水手佩德罗]";
		mes "…………真是个无聊的故事。";
		mes "而且把你的东西送给别人也不容易。";
		next;
			mes "- 水手 Pedro 似乎放弃了，但他的目光无法从我身上移开。-";
		setquest 7352;
		completequest 7352;
		if ((checkquest(7352) + checkquest(7353) + checkquest(7354) + checkquest(7355) + checkquest(7356) + checkquest(7357)) > 9) {
			next;
			mes "- 已经有很多人向你要这个了。也许最好去和梦巴奇的 Phong 谈谈。-";
			set malaya_hi, 11;
			setquest 7358;
		}
		close;
	} else if (malaya_hi == 11) {
		mes "[水手佩德罗]";
		mes "唉……";
		mes "真尴尬。";
		close;
	} else if (malaya_hi == 12) {
		if (checkquest(7359) != -1) {
			mes "[水手佩德罗]";
			mes "总之，既然我有了它们讨厌的东西……";
			mes "现在正是冲进我的船的时机……！";
			close;
		}
		if (!countitem(523) || !countitem(717)) {
			mes "^4d4dff准备并交出蓝色魔力矿石和圣水。^000000";
			close;
		}
		mes "[水手佩德罗]";
		mes "什么？我能感觉到你手中有清新的东西。那是什么？";
		next;
		mes "[水手佩德罗]";
		mes "你要给我？";
		mes "幽灵会讨厌它？";
		mes "真是个好消息！";
		next;
		mes "[水手佩德罗]";
		mes "我是 Pedro，随时为你效劳！";
		mes "等你解决这里的幽灵，我就乘船前往世界尽头！";
		next;
		mes "- 将圣水和蓝色魔力矿石交给了水手 Pedro。-";
		delitem 717, 1; //Blue_Gemstone
		delitem 523, 1; //Holy_Water
		setquest 7359;
		completequest 7359;
		if ((checkquest(7359) + checkquest(7360) + checkquest(7361) + checkquest(7362) + checkquest(7363) + checkquest(7364)) > 11) {
			mes "- 最后给了水手 Pedro，我想圣物已经够了。-";
			set malaya_hi, 13;
			erasequest 7351;
			setquest 7365;
		}
		close;
	} else if (malaya_hi == 13) {
		mes "[水手佩德罗]";
		mes "总之，既然我有它们讨厌的东西……";
		mes "现在正是冲上我的船的时机……！";
		next;
		mes "-水手 Pedro 看起来下定了决心。-";
		close;
	} else {
		mes "[水手佩德罗]";
		mes "哇……你看到了吗？";
		mes "那些黑色灵魂刚刚出现又消失了。";
		mes "嗯，梦想成真了，对吧？";
		next;
		if (select("提供灵魂保护。:关于渡船") == 1) {
			if ((checkquest(7374) == -1) || (checkquest(7368) == -1)) {
				mes "[水手佩德罗]";
			mes "你之前给我的灵魂护符效果很好。";
			mes "我暂时没问题。";
			mes "还可以继续战斗！";
				close;
			}
			if (!countitem(6503)) {
			mes "^4d4dff没有可交给水手 Pedro 的灵魂护符。^000000";
				close;
			}
			mes "[水手佩德罗]";
		mes "新制作的灵魂护符。";
		mes "好，今天就用这个对付它们。";
			next;
		mes "-把灵魂护符交给了水手 Pedro。-";
			delitem 6503, 1; // Soul_Protection
			erasequest 7368;
			setquest 7382;
			if ((checkquest(7382) + checkquest(7383) + checkquest(7384) + checkquest(7385) + checkquest(7386) + checkquest(7387)) > 5) {
			mes "-最后交给水手 Pedro 后，所有灵魂护符都已送达。-";
				if (malaya_hi == 23) {
					set malaya_hi, 24;
				}
				setquest 7379;
				erasequest 7382;
				erasequest 7383;
				erasequest 7384;
				erasequest 7385;
				erasequest 7386;
				erasequest 7387;
			}
			close;
		}
		if (BaseLevel < 100) {
			mes "[水手佩德罗]";
		mes "嗯……你不记得我说过幽灵吗？";
		mes "渡船里全是幽灵。";
		mes "等等，是一个还是很多？";
			next;
			mes "[水手佩德罗]";
		mes "算了。以你现在的状态，这不可能。";
		mes "是的，你做不到。你会被装进尸袋拖出来。";
			next;
			mes "[水手佩德罗]";
		mes "我不会站在这里等那种事发生。绝不。";
			close;
		}
		if (malaya_diwata == 0) {
			mes "[水手佩德罗]";
		mes "抱歉，我不是说过那边有幽灵吗？";
		mes "因为它们，船无法起航。";
			next;
			mes "[水手佩德罗]";
		mes "那么，这整个幽灵故事是怎么回事？";
		mes "嗯……";
		mes "说来话长……";
			next;
			if (select("我在听。:下次再说。") == 2) {
				mes "[水手佩德罗]";
		mes "我就知道。";
		mes "不过，这故事也没那么无聊。";
		mes "毕竟是幽灵故事。";
				close;
			}
			mes "[水手佩德罗]";
		mes "故事要从我第一次在这里靠岸说起。";
		mes "那是我第一次当班轮管理员，紧张得不得了。";
			next;
			mes "[水手佩德罗]";
		mes "我准备下船时，看到了完全无法相信的东西。";
		mes "黑雾从城镇各处涌向港口。";
			next;
			mes "[水手佩德罗]";
		mes "起初我以为只是浓雾。";
		mes "几天后，我才明白那是什么。";
		mes "那是一群灵魂。";
			next;
			mes "[水手佩德罗]";
		mes "确实是一群令人不快的灵魂。";
		mes "有些在即将起航的渡船周围发出可怕的哀嚎……";
			next;
			mes "[水手佩德罗]";
		mes "那次事件后，那艘船一直停在原地直到今天。";
		mes "为什么？因为它们占据了船！那里闹鬼！";
			next;
			mes "[水手佩德罗]";
		mes "如果不相信我，就亲自去看看。";
		mes "这样你就会相信我。";
			set malaya_diwata, 1;
			setquest 7395;
			close;
		} else if (malaya_diwata == 1) {
			mes "[水手佩德罗]";
		mes "想知道的话，就亲自去看看并登船。";
			close;
		} else if (malaya_diwata == 2) {
			mes "[水手佩德罗]";
		mes "小女孩的灵魂？";
		mes "那些欺负人的幽灵呢？";
		mes "它们来过又走了？";
			next;
			mes "[水手佩德罗]";
		mes "我不明白。";
		mes "也许首领 Mumbaki 知道该怎么办。";
			close;
		} else if (malaya_diwata == 3) {
			mes "[水手佩德罗]";
		mes "嗯……用花祭慰藉灵魂……";
		mes "你想在它平静后听它的故事？";
		mes "那……祝你好运。";
			next;
			mes "[水手佩德罗]";
		mes "渡船要再次起航也没办法。";
		mes "因为那些讨厌的家伙，我无法靠近。";
			next;
			mes "[水手佩德罗]";
		mes "我请求你做这件事，不是因为我嫌麻烦，";
		mes "而是因为我自己确实做不到。";
			close;
		} else if (malaya_diwata == 4) {
			mes "[水手佩德罗]";
		mes "Mumbaki 给花祝福了吗？";
		mes "希望这样有效……";
		mes "祝你好运！！";
			next;
			mes "[水手佩德罗]";
		mes "希望你能成功谈判！";
		mes "我会尽力处理船外那些无礼的家伙。";
			close;
		} else if (malaya_diwata == 5) {
			mes "[水手佩德罗]";
		mes "我明白了。";
		mes "也许渡船又能移动了……";
		mes "谢谢你为我们所做的一切。";
			next;
			mes "[水手佩德罗]";
		mes "那我最好准备起航。";
		mes "虽然不多，但这个给你。";
		mes "如果我们恢复营业，我只收 1000 Zeny 就带你去依斯鲁得。";
			set malaya_diwata, 6;
			erasequest 7399;
			setquest 7401;
			if (!VIP_SCRIPT || vip_status(VIP_STATUS_ACTIVE))
				getitem 6497, 2; // Lesser_Agimat
			else
				getitem 6497, 1; // Lesser_Agimat
			getexp 200000,200000;
			if (!rand(3))
				$malayaNames$[0] = strcharinfo(0);
			close;
		} else {
			.@playtime = checkquest(7401, PLAYTIME);
			if (.@playtime == 0 || .@playtime == 1) {
				mes "[水手佩德罗]";
				mes "想去艾尔帕兰，就乘坐那边的大船。";
				mes "这艘小船去依斯鲁得。";
				mes "费用是 1000 Zeny。";
				next;
				if (select("使用。:太贵了！") == 2) {
					mes "[水手佩德罗]";
					mes "什么？！";
					mes "你乘艾尔帕兰班轮来这里花了多少？！";
					mes "说什么太贵……你以为我在做慈善吗？";
					close;
				}
				if (Zeny < 1000) {
					mes "[水手佩德罗]";
					mes "价格是 1000 Zeny。";
					mes "这我也没办法～";
					close;
				}
				mes "[水手佩德罗]";
				mes "谢谢～";
				mes "趁幽灵回来前出发吧！";
				set Zeny, Zeny - 1000;
				close2;
				warp "izlude",195,180;
				end;
			} else if (.@playtime == 2) {
				erasequest 7401;
				goto L_SetQuest;
			} else {
				if (checkquest(7403) == -1) {
					if (checkquest(7402) == -1) {
						goto L_SetQuest;
					}
					mes "[水手佩德罗]";
					mes "你知道该怎么做。";
					mes "收集花朵，带给 Mumbaki 制作供奉花束。";
					next;
					mes "[水手佩德罗]";
					mes "把花束交给 Diwata 小姐，让她开心起来。";
					mes "……谢谢。";
					close;
				}
				mes "[水手佩德罗]";
				mes "Diwata 平静下来了！";
				mes "在这里我都能感受到变化。";
				mes "我永远欠你人情。";
				next;
				mes "[水手佩德罗]";
				mes "你知道吗？为什么不更经常做这件事？";
				mes "我觉得你有点喜欢做这个。";
				setquest 7401;
				erasequest 7403;
				if (!VIP_SCRIPT || vip_status(VIP_STATUS_ACTIVE))
					getitem 6497, 2; // Lesser_Agimat
				else
					getitem 6497, 1; // Lesser_Agimat
				getexp 200000,200000;
				if (!rand(3))
					$malayaNames$[0] = strcharinfo(0);
				close;
			}
		}
	}
	end;

L_SetQuest:
	mes "[水手佩德罗]";
	mes "啊，问题是……";
	mes "我们现在不能出发……";
	mes "你看，幽灵回来了……";
	mes "我受够这些麻烦了。";
	next;
	mes "[水手佩德罗]";
	mes "我的意思是……Diwata 小姐状态不好，即使有灵魂护符，";
	mes "普通人也无法承受。";
	next;
	if (select("我明白了。那请保重。:花之祭怎么样？") == 1) {
		mes "[水手佩德罗]";
		mes "很高兴你理解。";
		mes "唉……";
		close;
	}
	mes "[水手佩德罗]";
	mes "嗯……那会很不错。";
	mes "如果花朵能让她平静……！";
	mes "祝你好运。";
	setquest 7402;
	close;
}

ma_in01,125,107,3	script	Ghost Diwata	1761,4,4,{
	end;
OnTouch:
	if (malaya_diwata == 0) {
		cutin "malaya_diwata01", 2;
		mes "- 一个诡异的小女孩站在那里。";
		mes "我们的目光相遇时，我脊背发冷，浑身起鸡皮疙瘩。-";
		next;
		mes "[Diwata]";
		mes "你也是来欺负 Diwata 的吗？";
		mes "我不允许！";
		next;
		cutin "", 255;
		mes "- 小女孩发出低沉诡异的声音，眼中闪光后，我被赶了出去。-";
		close;
		warp "malaya", 324, 66;
		end;
	} else if (malaya_diwata == 1) {
		cutin "malaya_diwata01", 2;
		mes "- 一个诡异的小女孩站在那里。";
		mes "我们的目光相遇时，我脊背发冷，浑身起鸡皮疙瘩。-";
		next;

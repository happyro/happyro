	mes "Sirood 回到我们身边了。";
	next;
	mes "[Soup]";
	mes "多亏了你，冒险者。非常感谢。";
	close;
}

izlude,135,51,4	script	Raket#Raket	1_F_MERCHANT_01,{
	if (ill_underwater < 5) {
		mes "[Raket]";
		mes "Sirood 失踪整整 3 个月了。";
		next;
		mes "[Raket]";
		mes "找到了 Sirood 的鱼竿。";
		next;
		mes "[Raket]";
		mes "我也有同感。";
		next;
		select( "你觉得呢？" );
		mes "[Raket]";
		mes "为什么现在才发现？这是不是某人的留言？";
		next;
		select( "看起来说不通。" );
		mes "[Raket]";
		mes "哈……只是我的妄想。今天尤其想念那个孩子。";
		close;
	}
	if (ill_underwater < 7) {
		mes "[Raket]";
		mes "嘿嘿……使出全部力量真难……";
		next;
		mes "[Raket]";
		mes "但为了 Sirood……";
		close;
	}
	mes "[Raket]";
	mes "非常感谢！！";
	next;
	mes "[Raket]";
	mes "现在你可以再次和 Sirood 钓鱼了。";
	next;
	mes "[Raket]";
	mes "我很高兴……";
	close;
}

izlude,132,49,5	script	Gein#Gein	4W_M_01,{
	if (checkweight(1201,3) == 0) {
		mes "你物品太多。";
		mes "请清理物品后再试。";
		close;
	}
	if (BaseLevel < 140) {
		mes "[Gein]";
		mes "哈哈……为什么现在才发现？？";
		mes "不可能，这是……";
		next;
		mes "-我从这个人身上感受到深深的痛苦。等我达到 140 级后再回来吧。-";
		close;
	}
	if (ill_underwater == 0) {
		mes "[Gein]";
		mes "哈哈……为什么现在才发现？";
		mes "不可能，这是……";
		next;
		select( "你有什么烦恼吗？" );
		mes "[Gein]";
		mes "哦，你好……";
		next;
		mes "-他手里拿着鱼竿，显得非常坐立不安。看起来不像是在外面钓鱼。-";
		next;
		mes "[Gein]";
		mes "这根鱼竿属于我的朋友 <FONT COLOR = 4D4DFF><FONT SIZE = 16><B>Sirood</FONT></FONT></B>，他三个月前失踪了。我发现了线索！！！";
		next;
		select( "失踪？" );
		mes "[Gein]";
		mes "是的……Sirood 是钓鱼狂热者，有机会就会来这里钓鱼。";
		next;
		mes "[Gein]";
		mes "受 Sirood 影响，我们也爱上了钓鱼，四个人经常一起度过快乐时光。";
		next;
		mes "[Gein]";
		mes "Sirood 对钓鱼的热情让他甚至在风雨中也邀请我们钓鱼。";
		next;
		mes "[Gein]";
		mes "Sirood 失踪那天正是同样风雨交加的日子。我穿上雨衣去钓鱼。";
		next;
		mes "[Gein]";
		mes "他邀请我们一起出海，但大家都拒绝了。";
		next;
		mes "[Gein]";
		mes "Sirood 独自去钓鱼，从那以后我们就没再见过他……";
		next;
		mes "[Gein]";
		mes "我当时应该阻止你离开……";
		next;
		mes "-Gein 擦去眼泪后重新开始说话。-";
		next;
		mes "[Gein]";
		mes "Sirood 失踪的消息立刻传遍伊兹鲁德。我们投入大量时间和人力进行大规模搜索，却没有找到任何线索。";
		next;
		mes "[Gein]";
		mes "之后我们聚在一起到处寻找 Sirood，但毫无结果，正准备放弃。";
		next;
		mes "[Gein]";
		mes "但是就在刚才！！";
		next;
		mes "[Gein]";
		mes "三个月之后！！！";
		next;
		mes "[Gein]";
		mes "Sirood 的鱼竿浮出了海面。搜索时根本没找到他的物品！";
		next;
		select( "现在冷静下来……你确定这是 Sirood 的鱼竿吗？" );
		mes "[Gein]";
		mes "是的，我确定！这是我一直见过的鱼竿。";
		next;
		mes "[Gein]";
		mes "这根鱼竿是 Sirood 亲手制作的，世上只有这一根。你看，握柄上有他的姓名首字母 S.R.D！！";
		next;
		select( "哦，那为什么现在……" );
		mes "[Gein]";
		mes "我现在又惊讶又震惊，不知道该怎么办。";
		next;
		mes "-但仔细看这根鱼竿，我感觉有些不对。这根木鱼竿在水里浸泡了 3 个月，却仍然完好如初，还泛着一点亮光……-";
		next;
		select( "这根鱼竿是不是有点奇怪？" );
		mes "[Gein]";
		mes "奇怪，这是什么？";
		next;
		mes "[Gein]";
		mes "呃……";
		next;
		mes "[Gein]";
		mes "呃……？？";
		next;
		mes "[Gein]";
		mes "在水里浸泡了 3 个月……却完全没有腐蚀。它一点事也没有？？";
		next;
		mes "[Gein]";
		mes "嗯……它似乎还发出微光……鱼竿好像被涂层包裹了？";
		next;
		mes "-那个看起来是 Gein 朋友、一直听故事的人开口了。-";
		next;
		mes "[Raket]";
		mes "在哪里？我想看看！！怎么了？";
		next;
		mes "[Gein]";
		mes "这根鱼竿……在水里浸泡了 3 个月，却仍以原状被发现，或者说，处于损坏状态。";
		next;
		mes "[Raket]";
		mes "唉……";
		next;
		mes "[Raket]";
		mes "Um...";
		next;
		mes "-Raket 认真端详着鱼竿，然后回答 Gein。-";
		next;
		mes "[Raket]";
		mes "我也不确定？";
		next;
		mes "[Gein]";
		mes "当然！！我不知道，但你愿意吗？";
		next;
		mes "[Raket]";
		mes "嗯……但我认识一个可能了解这根鱼竿的人。";
		next;
		mes "[Gein]";
		mes "谁？";
		next;
		select( "谁？" );
		mes "[Raket]";
		mes "他叫 <FONT COLOR = 4D4DFF><FONT SIZE = 16><B>Jerrymon</FONT></FONT></B>，是一名海洋科学家。我见过我父亲几次。我知道你在普隆德拉东图书馆。";
		next;
		mes "[Gein]";
		mes "啊，啊……那么……嘿，冒险者！！很抱歉第一次见面就这样，但能拜托你一件事吗？我们在伊兹鲁德出不去……";
		next;
		mes "[Gein]";
		mes "请去见 Jerrymon，把这根鱼竿给他看……即使线索很微小……我希望他能知道些什么……";
		next;
		if (select( "好，我们走。", "抱歉，我现在有点忙……" ) == 2) {
			mes "[Gein]";
			mes "不……你确定吗？";
			next;
			mes "[Gein]";
			mes "听完这个令人心碎的故事和神秘线索后，你就这样转身离开吗……";
			close;
		}
		mes "[Gein]";
		mes "唉……谢谢！";
		next;
		mes "[Gein]";
		mes "^4d4dffJerrymon^000000 应该还在普隆德拉的<NAVI>[东图书馆]<INFO>prontera,192,264,</INFO></NAVI>。";
		next;
		mes "[Gein]";
		mes "现在我把这根鱼竿交给你，这是 Sirood 留下的纪念物。谢谢……";
		next;
		mes "[Raket]";
		mes "什么？？？这是纪念物！！你甚至不知道 Sirood 是生是死！！";
		next;
		mes "[Gein]";
		mes "呃……是我说错了，这是 Sirood 留下的鱼竿。请好好保管。";
		next;
		mes "[Raket]";
		mes "我会通过父亲提前告诉 Jerrymon 相关情况！";
		next;
		mes "[Gein & Raket & Soup]";
		mes "谢谢你！！！";
		close2;
		getitem 25898,1;	// Siroods_Fish_Rod
		ill_underwater = 1;
		setquest 3407;
		end;
	}
	if (ill_underwater == 1) {
		mes "[Gein]";
		mes "你可以按照 Raket 的说法，前往普隆德拉的<NAVI>[东图书馆]<INFO>prontera,192,264,</INFO></NAVI>。";
		next;
		mes "[Gein]";
		mes "保重！！希望哪怕能找到最微小的线索……";
		close;
	}
	if (ill_underwater == 2) {
		mes "[Gein]";
		mes "啊，你来了！！！";
		next;
		mes "[Gein]";
		mes "你有 Sirood 的消息吗？";
		next;
		mes "-你转述了从 Jerrymon 那里听到的消息。-";
		next;
		mes "[Gein]";
		mes "啊……我明白了，我以前从没听说过海沟。";
		next;
		mes "[Gein]";
		mes "真不敢相信伊兹鲁德附近有这么大、这么深的海沟……";
		next;
		mes "[Gein]";
		mes "哦，对了，你回来还需要其他东西吗？";
		next;
		select( "除了鱼竿，还有找到其他东西吗？" );
		mes "[Gein]";
		mes "哦，对了！！";
		next;
		mes "[Gein]";
		mes "这是在发现鱼竿的附近，用捞网捞上来的一块东西。";
		next;
		mes "-这就是 Jerrymon 所说的东西。";
		mes "^4d4dff它一定是深渊的精华^000000。-";
		next;
		mes "[Gein]";
		mes "它闪闪发光，感觉和 Sirood 的鱼竿相同，所以我先把它保管起来。";
		mes "这块矿石能帮上忙吗？";
		next;
		select( "谢谢，这会帮大忙。" );
		mes "[Gein]";
		mes "你要回去找 Jerrymon 吗？请小心。";
		close2;
		getitem 25899,1;	// E_Abyss1
		ill_underwater = 3;
		setquest 3408;
		end;
	}
	if (ill_underwater == 3) {
		mes "[Gein]";
		mes "希望 Sirood 能像鱼竿一样完好无损地出现在我们面前……";
		next;
		mes "[Gein]";
		mes "如果有新消息，请告诉我！";
		close;
	}
	if (ill_underwater < 7) {
		mes "[Gein]";
		mes "呵……呵……你好，冒险者，呵……呵……我太累了，动不了了……";
		close;
	}
	mes "[Gein]";
	mes "谢谢你，冒险者。";
	next;
	mes "[Gein]";
	mes "能再次见到 Sirood，简直像做梦一样。";
	close;

OnInit:
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "ill_underwater == 0" );
	questinfo( QTYPE_QUEST2, QMARK_YELLOW, "ill_underwater == 2" );
	end;
}

izlude,132,54,4	script(CLOAKED)	Jerrymon#jerry2	1_M_01,{
	if (ill_underwater < 4)
		end;
	if (ill_underwater == 4) {
		mes "[Jerrymon]";
		mes "啊，你来了！！";
		next;
		mes "[Jerrymon]";
		mes "趁冒险者们到来，我们已经准备就绪。";
		next;
		mes "-Gein 喘着气向两位朋友打招呼。-";
		next;
		mes "[Gein]";
		mes "哈哈哈哈哈哈哈哈哈哈哈……啊，欢迎你，冒险者。";
		next;
		mes "[Gein]";
		mes "我不知道原理是什么，但我按照 Jerrymon 大人的吩咐认真搅拌了！！";
		next;
		mes "[Raket & Soup]";
		mes "嘻……嘻……嘻……啊……你好。";
		next;
		mes "[Jerrymon]";
		specialeffect EF_MAP_MAGICZONE3;
		mes "好了，我们开始吧？";
		next;
		mes "[Jerrymon]";
		mes "漩涡马上就要形成了。";
		next;
		mes "[Jerrymon]";
		mes "我发出信号时，抓住我的手！！";
		next;
		select( "不，等等。你现在就要出发吗？" );
		mes "[Jerrymon]";
		mes "是的，是的，来吧，别想太多！相信我～～！！";
		next;
		mes "[Jerrymon]";
		mes "好了，现在抓住我的手！";
		next;
		specialeffect EF_CASTSPIN2, AREA;
		mes "[Jerrymon]";
		mes "哇！它转啊转啊～～！！";
		close2;
		ill_underwater = 5;
		erasequest 3409;
		specialeffect EF_CASTSPIN2, AREA;
		warp "iz_d04_i",130,227;
		end;
	}
	mes "[Jerrymon]";
	mes "你好！！";
	next;
	mes "[Jerrymon]";
	mes "多亏了你，冒险者，我每天都过得既开心又刺激。";
	next;
	mes "[Jerrymon]";
	mes "你想再去深海吗？我会跟着你！！";
	next;
	if (select( "拜托了", "下次再去" ) == 2) {
		mes "[Jerrymon]";
		mes "好吧……那我等你。";
		close;
	}
	mes "[Jerrymon]";
	specialeffect EF_MAP_MAGICZONE3;
	mes "好。";
	next;
	specialeffect EF_CASTSPIN2;
	mes "[Jerrymon]";
	mes "来吧！我们走～～！！耶！！";
	close2;
	specialeffect EF_CASTSPIN2, AREA;
	warp "iz_d04_i",130,227;
	end;

OnInit:
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "isbegin_quest(3409) == 1" );
	end;
}


iz_d04_i,127,228,4	script	Jerrymon#jerry3	1_M_01,{
	if (checkweight(1201,3) == 0) {
		mes "你物品太多。";
		mes "请清理物品后再试。";
		close;
	}
	if (ill_underwater < 5)
		end;
	if (ill_underwater == 5) {
		switch( checkquest(3411,HUNTING) ) {
		case -1:
			mes "[Jerrymon]";
			mes "哇……这片紫色的海……太棒了！！！";
			next;
			mes "[Jerrymon]";
			mes "不用鳃也能呼吸，没有海水压力，还有以前从没见过的海洋生物……太神奇了！！！";
			next;
			mes "[Jerrymon]";
			mes "值得调查的东西不止一两件，我会忙起来了。";
			mes "哇……太刺激了！！！这是我当海洋学家 14 年来最激动的时刻！";
			next;
			mes "[Jerrymon]";
			mes "噜啦啦啦～～～";
			next;
			select( "哦，嘿，我是来找 Sirood 的……" );
			mes "[Jerrymon]";
			mes "啊，啊……那个，对吧？那应该优先处理。";
			next;
			mes "[Jerrymon]";
			mes "为了把 Sirood 带回岸上，我们还需要 ^4d4dff" + getitemname(25899) + "^000000。问题是如何取得它……";
			next;
			mes "[Jerrymon]";
			mes "我一直在观察这里的深海生物，看到其中一些会散发深渊精华的光芒。";
			mes "它们有时似乎还会威胁我们。";
			next;
			mes "[Jerrymon]";
			mes "这样的话，你能处理一些深海生物吗？也许能从它们那里得到 ^4d4dff" + getitemname(25899) + "^000000。";
			next;
			mes "[Jerrymon]";
			mes "请各击败 10 只 ^4d4dff" + getmonsterinfo("ILL_SROPHO", MOB_NAME) + "^000000、^4d4dff" + getmonsterinfo("ILL_DEVIACE", MOB_NAME) + "^000000 和 ^4d4dff" + getmonsterinfo("ILL_MARSE", MOB_NAME) + "^000000。";
			next;
			if (select( "好", "下次再做" ) == 2) {
				mes "[Jerrymon]";
				mes "好的好的～我会在这里等你！";
				close;
			}
			mes "[Jerrymon]";
			mes "好的好的～我会在这里等你！";
			close2;
			setquest 3411;
			end;
		case 0:
		case 1:
			mes "[Jerrymon]";
			mes "请各击败 10 只 ^4d4dff" + getmonsterinfo("ILL_SROPHO", MOB_NAME) + "^000000、^4d4dff" + getmonsterinfo("ILL_DEVIACE", MOB_NAME) + "^000000 和 ^4d4dff" + getmonsterinfo("ILL_MARSE", MOB_NAME) + "^000000。";
			next;
			mes "[Jerrymon]";
			mes "我会在这里等你。";
			close;
		case 2:
			mes "[Jerrymon]";
			mes "辛苦了，你还带来了 ^4d4dff" + getitemname(25899) + "^000000！！果然，我的预测是正确的。";
			next;
			mes "[Jerrymon]";
			mes "看来只需要大约 10 个 ^4d4dff" + getitemname(25899) + "^000000，就能把 Sirood 带回岸上。";
			next;
			mes "[Jerrymon]";
			mes "你收集好后，我会为你制造漩涡。";
			next;
			mes "[Jerrymon]";
			mes "哦，这是我研究时发现的石头。它看起来像是冒险者能用的东西，请收下。";
			next;
			mes "[Jerrymon]";
			mes "那就小心！";
			close2;
			getitem 25271,2;	// IllusionStone
			ill_underwater = 6;
			erasequest 3411;
			setquest 3412;
			getexp 4441860,3109150;
			end;
		}
		end;
	}
	if (ill_underwater == 6) {
		if (countitem(25899) < 10) {
			mes "[Jerrymon]";
			mes "请带来 ^4d4dff10 个" + getitemname(25899) + "^000000。";
			next;
			mes "[Jerrymon]";
			mes "我也想自己收集，但你看，我实在太弱了。";
			close;
		}
		mes "[Jerrymon]";
		mes "辛苦了！！你带来了 10 个 ^4d4dff" + getitemname(25899) + "^000000。";
		next;
		mes "[Jerrymon]";
		mes "现在要上岸吗？";
		next;
		if (select( "上岸", "现在不上去" ) == 2) {
			mes "[Jerrymon]";
			mes "准备上岸时再来找我！";
			close;
		}
		mes "[Jerrymon]";
		mes "我在等待冒险者时又找到了这个。请收下！！";
		next;
		mes "[Jerrymon]";
		mes "好了，我们把这个凝聚起来……";
		next;
		mes "[Jerrymon]";
		mes "咦……！！";
		next;
		mes "[Jerrymon]";
		mes "现在，冒险者和 Sirood！！你们能帮我吗？？咦！！！！";
		next;
		mes "-Jerrymon 面前出现了巨大的漩涡！-";
		specialeffect EF_MAP_MAGICZONE3;
		next;
		mes "[Jerrymon]";
		mes "那我先过去！！！小心跟上我！";
		specialeffect EF_CASTSPIN2;
		close2;
		delitem 25899,10;	// E_Abyss1
		ill_underwater = 7;
		erasequest 3412;
		if (isbegin_quest(3410) == 1)
			erasequest 3410;
		getitem 25271,2;	// IllusionStone
		getexp 4441860,3109150;
		warp "izlude",128,54;

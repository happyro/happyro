//===== rAthena Script =======================================
//= Advanced Refiner
//===== Description: =========================================
//= [Official Conversion]
//= Refiner that uses Enriched ores to increase upgrade success.
//===== Changelog: ===========================================
//= 1.0 Added Malangdo Refiner "Holink". [Euphy]
//= 1.1 Removed re-roll behavior. [Secret]
//= 1.2 Added db-based material ID [Secret]
//============================================================

// Main NPC :: mal_jerun
//============================================================
malangdo,221,174,6	script	Holink#mal_cash	559,{
	disable_items;
	mes "[Holink]";
	mes "我是喵～铁匠 Holink～";
	mes "精炼大师 Holink～";
	mes "我是从梦罗克学习归来的特别猫咪 Holink～";
	mes "我的女儿为我感到骄傲，Holink～";
	mes "今天要让 Holink～ 精炼什么呢？";
	next;

	setarray .@indices[1], EQI_HEAD_TOP, EQI_ARMOR, EQI_HAND_L, EQI_HAND_R, EQI_GARMENT, EQI_SHOES, EQI_ACC_L, EQI_ACC_R, EQI_HEAD_MID, EQI_HEAD_LOW;
	for (set .@i,1; .@i<=10; set .@i,.@i+1)
		set .@menu$, .@menu$ + ( getequipisequiped(.@indices[.@i]) ? getequipname(.@indices[.@i]) : F_getpositionname(.@indices[.@i]) +"-[Empty]" ) +":";
	set .@part, .@indices[ select(.@menu$) ];

	if (!getequipisequiped(.@part)) {
		mes "[Holink]";
		switch(.@part) {
		case EQI_HEAD_TOP:
			mes "我的老师 Aragam 说过喵～";
			mes "愚蠢是无药可救的……";
			break;
		case EQI_ARMOR:
			mes "这里没什么可看的，喵！！";
			break;
		case EQI_HAND_L:
			mes "喵？您想让我拿这只左手做什么……？";
			break;
		case EQI_HAND_R:
			mes "喵？您想让我拿这只右手做什么……？";
			break;
		case EQI_GARMENT:
			mes "喵？您身上什么都没装备。";
			break;
		case EQI_SHOES:
			mes "喵呜～！别打扰我敏锐的嗅觉，喵～";
			break;
		case EQI_ACC_L:
		case EQI_ACC_R:
			mes "喵？饰品在哪里？";
			break;
		case EQI_HEAD_MID:
		case EQI_HEAD_LOW:
			mes "喵？您说的是其他头部装备吗，喵～？";
			break;
		}
		close;
	}
	if (!getequipisenableref(.@part)) {
		mes "[Holink]";
		mes "连 Aragam 也无法精炼这种东西，喵。";
		close;
	}
	if (getequiprefinerycnt(.@part) >= 10) {
		mes "[Holink]";
		mes "喵～完美的精炼。是 Aragam 做的吗，喵～？";
		close;
	}
	mes "[Holink]";
	.@refineitemid = getequipid(.@part); // save id of the item
	.@itemtype = getiteminfo( .@refineitemid, ITEMINFO_TYPE );
	.@refinerycnt = getequiprefinerycnt(.@part); //save refinery count
	setarray .@card[0], getequipcardid(.@part,0), getequipcardid(.@part,1), getequipcardid(.@part,2), getequipcardid(.@part,3);
// Holink has different hardcoded prices
//	.@price = getequiprefinecost(.@part, REFINE_COST_NORMAL, REFINE_ZENY_COST);
	.@material = getequiprefinecost(.@part, REFINE_COST_NORMAL, REFINE_MATERIAL_ID);

	if( .@itemtype == IT_ARMOR ){
		.@equip_lv = getequiparmorlv( .@part );
		.@type$ = "armor";
		mes "您选择了防具，喵～";

		switch(.@equip_lv) {
			case 1:
				.@price = 15000;
				break;
			default:
				// TODO:
				close;
		}
	}else if( .@itemtype == IT_WEAPON ){
		.@equip_lv = getequipweaponlv( .@part );
		.@type$ = "weapon";

		switch( .@equip_lv ){
			case 1: // Level 1 Weapon
				.@price = 500;
				mes "1 级武器……？";
				break;
			case 2: // Level 2 Weapon
				.@price = 2000;
				mes "喵，2 级武器……？";
				break;
			case 3: // Level 3 Weapon
				.@price = 20000;
				mes "喵喵～～3 级武器～～";
				break;
			case 4: // Level 4 Weapon
				.@price = 50000;
				mes "喵、喵……！4 级武器……！";
				mes "我跟随 Aragam 学习时";
				mes "也只见过两次……喵、喵！！";
				break;
			default:
				// TODO:
				close;
		}
	}else{
		// TODO:
		close;
	}

	mes "这次精炼需要 ^ff9999"+getitemname(.@material)+"^000000 和 ^ff9999"+.@price+"^000000 Zeny，喵～";
	mes "要继续吗，喵～？";
	next;
	if(select("是！！:不！！") == 2) {
		mes "[Holink]";
		mes "喵啊！！";
		mes "您不相信精炼大师 Holink 吗，喵～？";
		close;
	}
	if (getequippercentrefinery(.@part, true) < 100) {
		mes "[Holink]";
		mes "喵！！";
		if (.@type$ == "armor")
			mes "这件防具已经精炼过很多次了，喵。";
		else {
			mes "危险。危险～";
			mes "这件武器已经精炼很多次了，喵～";
			next;
			mes "[Holink]";
		}
		mes "如果继续精炼这件物品，";
		mes "它可能会损坏，喵。";
		next;
		mes "[Holink]";
		mes .@type$+"一旦损坏，您将";
		mes "再也无法使用它，喵。更不用说……当前所有";
		mes "^ff0000卡片和附魔都会消失^000000。";
		mes "还要继续尝试吗，喵～？";
		next;
		if(select("是的，我要继续！！:算了吧！！") == 2) {
			mes "[Holink]";
			mes "喵！明智的选择，喵。";
			mes "但是！！";
			mes "看到您怀疑精炼大师 Holink，我可不高兴，喵～";
			close;
		}
	}
	if (countitem(.@material) == 0 || Zeny < .@price) {
		mes "[Holink]";
		mes "您的材料不够。";
		mes "您需要 ^ff9999"+getitemname(.@material)+"^000000 和 ^ff9999"+.@price+"^000000 Zeny，喵～";
		mes "去收集吧，喵～";
		close;
	}
	delitem .@material,1;
	set Zeny, Zeny-.@price;

	// anti-hack
	if (callfunc("F_IsEquipIDHack", .@part, .@refineitemid) || callfunc("F_IsEquipCardHack", .@part, .@card[0], .@card[1], .@card[2], .@card[3]) ||
		callfunc("F_IsEquipRefineHack", .@part, .@refinerycnt)) {
		mes "[Holink]";
		emotion ET_FRET;
		mes "等一下……";
		mes "您以为我很蠢吗？！";
		mes "您趁我不注意换了装备！快离开这里！";
		close;
	}

	if (getequippercentrefinery(.@part, true) > rand(100)) {
		successrefitem .@part;
		mes "[Holink]";
		mes "喵～喵～喵！精炼真有趣～";
		next;
		emotion ET_CHUP;
		mes "[Holink]";
		mes "完美！！完美，喵！！";
		mes "我是精炼巫师 Aragam 的弟子～";
		mes "Holink！！";
		mes "又是精炼成功的一天，喵！！";
		close;
	}
	failedrefitem .@part;
	mes "[Holink]";
	mes "喵～喵～呀啊！！";
	next;
	switch(rand(1,5)) {
		case 1: emotion ET_CRY; break;
		case 2: emotion ET_PROFUSELY_SWEAT; break;
		case 3: emotion ET_KEK; break;
		case 4: emotion ET_SCRATCH; break;
		case 5: emotion ET_BIGTHROB; break;
	}
	mes "[Holink]";
	mes "喵！！啊啊啊～～！！！！";
	mes "呀啊！！我失败了，喵！！";
	next;
	mes "[Holink]";
	mes "......";
	mes "......";
	mes "全～全都～坏掉了，喵……";
	next;
	mes "[Holink]";
	mes "喵……Aragam 大师曾说过，";
	mes "要从失败中学习……";
	mes "人类，这次失败会成为您未来成功的起点。";
	close;
}

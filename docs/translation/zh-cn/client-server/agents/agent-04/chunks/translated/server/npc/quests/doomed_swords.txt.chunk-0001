prt_in,162,11,2	script	Ghatu#magum	86,{
	if (event_magum == 0) {
		if ((dmdswrd_Q2 & 1) || (dmdswrd_Q2 & 2) || (dmdswrd_Q2 & 4) || (dmdswrd_Q2 & 8) || (dmdswrd_Q2 & 16) || (dmdswrd_Q2 & 32)) {
			mes "[加图]";
			mes "我听说有一位奇怪的";
			mes "铁匠住在";
			mes "派恩森林深处，隐居";
			mes "在那里。他曾经因";
			mes "传奇锻造技艺";
			mes "而闻名……";
			next;
			mes "[加图]";
			mes "传闻他";
			mes "躲在山中";
			mes "因为太多人想将他的才能用于错误的";
			mes "目的。据说他的武器拥有神圣品质……";
			set event_magum,1;
			close;
		}
		mes "[加图]";
		mes "还记得我上次提到的";
		mes "那位铁匠吗？他的武器";
		mes "似乎需求旺盛，";
		mes "需求旺盛，是因为";
		mes "他会用 ";
		mes "极其强大的魔法附魔。";
		next;
		mes "[加图]";
		mes "然而那个人被权贵和压迫者";
		mes "逼迫制造武器，";
		mes "供他们自私不道德地使用。";
		mes "难怪他最终";
		mes "选择隐居……";
		next;
		mes "[加图]";
		mes "真的很令人难过。";
		mes "那位铁匠原本性格随和，";
		mes "直到被迫违背意愿工作，渐渐变得阴郁可怕……";
		mes "";
		mes "";
		next;
		mes "[加图]";
		mes "不过铁匠终究无法放下铁锤。";
		mes "如果你能找到他，也许可以请他为你锻造些什么？";
		mes "";
		mes "";
		mes "";
		set event_magum,5;
		close;

	}
	else if (event_magum == 1) {
		mes "[加图]";
		mes "还记得我上次提到的";
		mes "那位铁匠吗？他的武器";
		mes "似乎很受欢迎，";
		mes "需求旺盛，是因为";
		mes "他会用 ";
		mes "极其强大的魔法附魔。";
		next;
		mes "[加图]";
		mes "然而那个人被";
		mes "被渴望权力和压迫他人的人";
		mes "强迫制造武器，";
		mes "供他们自私不道德地使用。";
		mes "难怪他最终";
		mes "选择隐居……";
		next;
		mes "[加图]";
		mes "真的很悲哀。";
		mes "那位铁匠原本性格随和，";
		mes "直到被迫违背意愿工作。";
		mes "渐渐地，他变得阴沉而可怕……";
		mes "";
		next;
		mes "[加图]";
		mes "不过我想铁匠永远不可能";
		mes "真正放下铁锤。";
		mes "如果你能找到他，或许可以请他";
		mes "为你锻造一些东西？";
		mes "";
		set event_magum,5;
		close;
	}
	mes "[加图]";
	mes "那个神秘的铁匠……";
	mes "我想知道他是怎么制作那些";
	mes "附魔武器的。";
	mes "我听说他可能涉足黑暗艺术，";
	mes "但那似乎不太可能……";
	mes "";
	close;
}

prontera,197,188,2	script	Veeyop#magum	50,{
	if (dmdswrd_Q2 & 1) {
		mes "[Veeyop]";
	mes "你知道，谈到米斯特汀和巴德尔之死……";
	mes "我现在才意识到这故事有多阴森。";
	mes "是的，是的，我知道。";
	mes "";
	mes "";
	mes "";
		close;
	}
	mes "[Veeyop]";
	mes "你听过米斯特汀的传说吗？";
	mes "那是一棵树，唯一能伤害光明之神巴德尔。";
	mes "事实上，只是一根树枝就杀死了他。";
	mes "";
	mes "";
	mes "";
	next;
	mes "[Veeyop]";
	mes "我不确定这是否真实，但听说有人锻造了一把强大的剑，";
	mes "配得上‘米斯特汀’之名。";
	mes "";
	mes "";
	mes "";
	mes "";
	next;
	mes "[Veeyop]";
	mes "世界上只有一个人能锻造米斯特汀。";
	mes "我……我想他以前住在普隆德拉，后来不知为何搬走了。";
	mes "";
	mes "";
	mes "";
	mes "";
	if (event_magum == 1)
		set event_magum,5;
	set dmdswrd_Q2,dmdswrd_Q2 | 1;
	close;
}


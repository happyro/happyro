izlude_in,173,88,2	script	Nain#magum	102,{
	if (dmdswrd_Q2 == 4) {
		mes "[Nain]";
		mes "行刑者再强大也没关系：";
		mes "如果落到我手里，我会立刻销毁。";
		mes "我绝不会冒险让自己被诅咒夺走理智……";
		mes "";
		mes "";
		close;
	}
	mes "[Nain]";
	mes "很久以前，一把剑被用来斩首所有被判死刑的罪犯。";
	mes "那把受诅咒的剑被称为行刑者。";
	mes "";
	mes "";
	mes "";
	mes "";
	next;
	mes "[Nain]";
	mes "行刑者斩杀的罪犯越多，受害者的愤怒与嗜血就越积聚于剑上。";
	mes "剑虽获得强大力量，却被邪恶污染。";
	mes "";
	mes "";
	mes "";
	next;
	mes "[Nain]";
	mes "最后一位使用处刑者的人";
	mes "差点被这把剑夺走心智。";
	mes "他把剑交给一位技艺高超的铁匠，";
	mes "请铁匠毁掉它，拯救了自己的灵魂。";
	next;
	mes "[Nain]";
	mes "这位神秘铁匠";
	mes "再也没有出现在普隆德拉，";
	mes "但传闻说，如果能找到他，";
	mes "他就能重新锻造那把";
	mes "受诅咒的处刑者……";
	if (event_magum == 1)
		set event_magum,5;
	set dmdswrd_Q2,dmdswrd_Q2 | 4;
	close;
}

pay_fild08,218,283,2	script	Mysterious Man#magum	89,{
	if (checkweight(1201,1) == 0) {
		mes "[Mysterious Man]";
		mes "站住。";
		mes "你携带的物品";
		mes "太多了。请把物品";
		mes "存入卡普拉仓库后";
		mes "再来和我说话。";
		mes "";
		close;
	}
	if (event_magum == 0) {
		if ((dmdswrd_Q2 & 1) || (dmdswrd_Q2 & 2) || (dmdswrd_Q2 & 4) || (dmdswrd_Q2 & 8) || (dmdswrd_Q2 & 16) || (dmdswrd_Q2 & 32)) {
			mes "[Mysterious Man]";
		mes "嗯……？";
		mes "你到底";
		mes "在看什么？";
			next;
			if (select("你听说过诅咒之剑吗？:我……我……") == 1) {
				mes "[Mysterious Man]";
				mes "...!";
				mes "我怎么会知道";
				mes "那种事？";
				mes "别来烦我！";
				close;
			}
			mes "[Mysterious Man]";
			mes "...";
			next;
			mes "[Mysterious Man]";
			mes "...";
			mes "......";
			next;
			mes "[Mysterious Man]";
			mes "滚开。";
			close;
		}
		else {
			mes "[Mysterious Man]";
			mes "嗯……？";
			mes "你到底";
			mes "在看什么？";
			next;
			if (select("嗯，呃……:没什么，先生。") == 1) {
				mes "[Mysterious Man]";
				mes "什么……？！";
				next;
				mes "^3355FF这家伙真是";
				mes "太吓人了！^000000";
				close;
			}
			mes "[Mysterious Man]";
			mes "没什么，是吗？";
			mes "嗯，现在我正在看着";
			mes "一个烦人的冒险者！滚出去";
		mes "别来烦我！";


			close;
		}
	}
	else if (event_magum == 1) {
		mes "[神秘男子]";
		mes "嗯……？";
		mes "你到底在看什么？";
		mes "";
		next;
		if (select("Do you happen to be a blacksmith?:No-Nothing!") == 1) {
			mes "[神秘铁匠]";
			mes "哼，你还不算彻底的傻瓜。";
			mes "是的，我曾经锻造，但现在不做普通铁匠的简单工作……";
			mes "";
			mes "";
			mes "";
			mes "";
			close;
		}
		mes "[神秘铁匠]";
		mes "...";
		mes "......";
		next;
		mes "[Mysterious Blacksmith]";
		mes "从我眼前消失。";
		close;
	}
	else if (event_magum == 5) {
		mes "[神秘铁匠]";
		mes "嗯……？";
		mes "你到底在看什么？";
		mes "";
		next;
		if (select("I want you to make me a Doomed Sword.:Er, nothing!") == 1) {
			mes "[神秘铁匠]";
			mes "嗯。我不知道你从哪里听说我，";
			mes "但我想冒险者迟早会找到我。";
			mes "现在，你想拥有哪把诅咒之剑？";
			mes "";
			mes "";
			mes "";
			next;
			switch(select("Mysteltainn.:Grimtooth.:Executioner.:I ch-changed my mind!")) {
			case 1:
				if (dmdswrd_Q2 & 1) {
			mes "[神秘铁匠]";
			mes "你想要……那把剑？";
			mes "别轻易说出它的名字！";
			mes "";
			mes "";
					next;
					mes "[Mysterious Blacksmith]";
					mes "你了解那把剑的诅咒吗？米斯特汀的黑暗力量来自杀死光明之神巴德尔的树枝。";
					mes "让我尽量简短地讲述故事……";
					mes "";
					mes "";
					mes "";
					next;
					mes "[Mysterious Blacksmith]";
					mes "在诸神时代，美丽、纯洁、快乐的巴德尔受到所有生物爱戴，";
					mes "除了诡计之神洛基。";
					mes "";
					mes "";
					mes "";
					next;
					mes "[Mysterious Blacksmith]";
					mes "When Loki, out of jealousy,";
					mes "决定杀死巴德尔时，女神芙蕾雅梦见了他的死亡。";
					mes "她害怕梦境成真，于是向诸神请教。";
					mes "";
					mes "";
					mes "";
					next;
					mes "[Mysterious Blacksmith]";
					mes "为保护巴德尔，诸神让所有生物、物体和自然力量发誓永不伤害他。";
					mes "被询问者都同意发誓。";
					mes "";
					mes "";
					mes "";
					mes "";
					next;
					mes "[Mysterious Blacksmith]";
					mes "宇宙万物中，芙蕾雅唯独忘了让米斯特汀树发誓。";
					mes "她认为它太小太不起眼，不值得询问。";
					mes "";
					mes "";
					mes "";
					next;
					mes "[Mysterious Blacksmith]";
					mes "诸神以为宇宙万物都发誓不伤害巴德尔，";
					mes "便把向这位近乎无敌的神投掷匕首当作消遣。";
					mes "";
					mes "";
					mes "";
					mes "";
					next;
					mes "[Mysterious Blacksmith]";
					mes "然而洛基决心杀死巴德尔，便伪装身份礼貌询问芙蕾雅，";
					mes "世上是否有未发誓不伤害巴德尔的物体。";
					mes "";
					mes "";
					mes "";
					mes "";
					next;
					mes "[神秘铁匠]";
					mes "芙蕾雅毫无察觉，告诉洛基米斯特汀的秘密。";
					mes "下次诸神向巴德尔投掷物体时，洛基带着一根小小的米斯特汀树枝。";
					mes "";
					mes "";
					next;
					mes "[Mysterious Blacksmith]";
					mes "随后洛基进一步施展诡计，骗巴德尔失明的双胞胎兄弟霍德，";
					mes "将树枝扔进巴德尔的心脏。于是光明之神被杀死。";
					mes "";
					mes "";
					mes "";
					mes "";
					next;
					mes "[Mysterious Blacksmith]";
					mes "多年以后，米斯特汀被铸造成你今天熟悉的剑。";
					mes "它的力量被诸神严格禁止。";
					mes "";
					mes "";
					mes "";
					mes "";
					next;
					mes "[Mysterious Blacksmith]";
					mes "不过，如果你愿意为了力量冒险承受剑的诅咒，";
					mes "带来以下物品后我就为你锻造。你会理解的……";
					mes "";
					mes "";
					mes "";
					mes "";
					next;
					mes "[Mysterious Blacksmith]";
					mes "^0099FF1 根嫩枝^000000、^0099FF1 个神之金属^000000、";
					mes "^0099FF1 个洛基的耳语^000000、^0099FF1 个母亲的恶梦^000000和";
					mes "^0099FF1 个盲人的愚行^000000。";
					mes "这就是我需要的。";
					mes "";
					mes "";
					next;
					mes "[Mysterious Blacksmith]";
					mes "我没有要求太多。";
					mes "你只需带来锻剑的原材料，";
					mes "以及证明你资格的神之金属。";
					mes "我会等你回来，冒险者。";
					mes "";
					mes "";
					set dmdswrd_Q2,dmdswrd_Q2 | 8;
					set event_magum,6;
					close;
				}
			mes "[神秘铁匠]";
			mes "只看你一眼我就知道，";
			mes "你对米斯特汀了解不够，无法理解挥舞它的风险。你太嫩了。";
			mes "";
			mes "";
			mes "";
				next;
			mes "[神秘铁匠]";
			mes "如果你还没充分了解它、无法准备好面对后果，";
			mes "我不能冒险为你制造那把诅咒之剑……";
			mes "";
			mes "";
			mes "";
			mes "";
				close;
			case 2:
				if (dmdswrd_Q2 & 2) {
					mes "[神秘铁匠]";
					mes "啊，是的。你一定想知道小小的匕首如何拥有如此力量。";
					mes "很简单，我用禁忌诅咒魔法赋予它毁灭性。";
					mes "";
					mes "";
					mes "";
					next;
					mes "[神秘铁匠]";
					mes "我的诅咒过于强大，若施在金属匕首上，匕首会立刻熔化。";
					mes "食人魔牙齿是唯一能承受诅咒魔法的材料。";
					mes "";
					mes "";
					mes "";
					next;
					mes "[Mysterious Blacksmith]";
					mes "当然，这只是";
					mes "";
					mes "";

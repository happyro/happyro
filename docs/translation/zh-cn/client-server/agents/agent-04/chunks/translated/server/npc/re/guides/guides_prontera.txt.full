//===== rAthena Script =======================================
//= Prontera Guides
//===== Description: =========================================
//= Guides for the city of Prontera.
//===== Changelogs: ==========================================
//= 1.0 Initial release for Renewal [L0ne_W0lf]
//= 1.1 Navigation system update. [Euphy]
//============================================================

prontera,154,187,4	script	Guide#01prontera::GuideProntera	105,{
	cutin "prt_soldier",2;
	mes "[Prontera Guide]";
	mes "欢迎来到^8B4513普隆德拉^000000，";
	mes "美丽的首都——";
	mes "卢恩-米德加尔特王国。";
	mes "需要城市导航帮助吗？";
	F_Navi("[Prontera Guide]");
	next;
	set .@str$,"还要查看其他地点吗？";
	while (1) {
		switch(select("[主要设施]:[商人和助手]:移除小地图标记:取消")) {
		case 1:
			set .@loop,1;
			while (.@loop) {
				switch(select("[工具店]:[武器和防具店]:[铁匠铺]:[教堂]:[骑士办公室]:[旅馆]:[酒馆]:[图书馆]:[普隆德拉城堡]:[职业介绍所]:[市政厅]:上一级菜单")) {
				case 1:
					callsub L_Mark, F_Navi("工具店","prontera,134,221","^B9062F");
					mes .@str$;
					viewpoint 1,134,221,0,0xFF0000;
					next;
					break;
				case 2:
					callsub L_Mark, F_Navi("武器和防具店","prontera,175,220","^0000FF");
					mes .@str$;
					viewpoint 1,175,220,1,0x0A82FF;
					next;
					break;
				case 3:
					callsub L_Mark, F_Navi("铁匠铺","prontera,179,184","^FF5400");
					mes .@str$;
					viewpoint 1,179,184,2,0xFFB400;
					next;
					break;
				case 4:
					mes "[Prontera Guide]";
					mes "普隆德拉"+F_Navi("教堂","prontera,236,316","^006400")+"位于";
					mes "你可以在此转职为服事，";
					mes "它位于普隆德拉最东北方。";
					mes "让我在你的小地图上标记位置。";
					mes .@str$;
					viewpoint 1,236,316,3,0xAAFF00;
					next;
					break;
				case 5:
					mes "[Prontera Guide]";
					mes ""+F_Navi("骑士办公室","prontera,46,345")+"位于";
					mes "你可以在此转职为^7F3300骑士^000000";
					mes "或申请加入^7F3300下水道讨伐队。";
					mes .@str$;
					viewpoint 1,46,345,4,0xD2691E;
					next;
					break;
				case 6:
					callsub L_Mark, F_Navi("旅馆","prontera,203,191","^800080");
					mes .@str$;
					viewpoint 1,204,191,5,0xDA70D6;
					next;
					break;
				case 7:
					callsub L_Mark, "^B9062F酒馆^000000";
					mes "目前只有"+F_Navi("北部","prontera,208,154","^B9062F")+"酒馆";
					mes "在营业。";
					mes .@str$;
					viewpoint 1,208,154,6,0xFF0000;
					viewpoint 1,46,67,7,0xFF0000;
					next;
					break;
				case 8:
					mes "[Prontera Guide]";
					mes "^0000FF图书馆^000000";
					mes "可以在此找到怪物图鉴等有用信息。";
					mes "目前有两座图书馆，";
					mes "一座在"+F_Navi("东北方","prontera,120,264")+"，另一座在"+F_Navi("西北方","prontera,192,264")+"。";
					mes .@str$;
					viewpoint 1,120,264,8,0x0A82FF;
					viewpoint 1,192,264,9,0x0A82FF;
					next;
					break;
				case 9:
					mes "[Prontera Guide]";
					mes F_Navi("普隆德拉城堡","prontera,156,360","^FF5400")+"在这里北方，";
					mes "城堡后门连接着";
					mes "北部普隆德拉原野。";
					mes "让我在你的小地图上标记城堡。";
					mes .@str$;
					viewpoint 1,156,360,10,0xFFB400;
					next;
					break;
				case 10:
					callsub L_Mark, F_Navi("职业介绍所","prontera,133,183","^006400");
					mes .@str$;
					viewpoint 1,133,183,11,0xAAFF00;
					next;
					break;
				case 11:
					mes "[Prontera Guide]";
					mes "让我在你的小地图上标记"+F_Navi("市政厅","prontera,75,91","^7F3300");
					mes "的位置。";
					mes "那里有理发师";
					mes "可以改变你的发色。";
					mes .@str$;
					viewpoint 1,75,91,12,0xD2691E;
					next;
					break;
				case 12:
					set .@loop,0;
					break;
				}
			}
			break;
		case 2:
			set .@loop,1;
			while (.@loop) {
				switch(select("[伊甸园传送员]:[大嘴鸟饲养员]:[骑乘生物管理员]:[魔导机甲管理员]:[大嘴鸟移除员]:[交易商人]:[佣兵公会成员]:[催眠师]:[卡普拉职员]:[Leablem]:[工匠学徒]:[宠物美容师]:上一级菜单")) {
				case 1:
					callsub L_Mark, F_Navi("伊甸园传送员","prontera,124,76","^800080"),1;
					mes .@str$;
					viewpoint 1,124,76,13,0xDA70D6;
					next;
					break;
				case 2:
					mes "[Prontera Guide]";
					mes "这里有两名 ^0000FF大嘴鸟饲养员^000000，";
					mes "一名服务于前往"+F_Navi("西北方","prontera,55,350","^0000FF")+"的 ^0000FF骑士^000000，";
					mes "另一名服务于前往"+F_Navi("东北方","prontera,232,310","^0000FF")+"的 ^0000FF十字军^000000。";
					viewpoint 1,55,350,14,0x0A82FF;
					viewpoint 1,232,310,15,0x0A82FF;
					next;
					break;
				case 3:
					mes "[Prontera Guide]";
					mes F_Navi("骑乘生物管理员","prontera,131,213","^FF5400")+"为";
					mes "^FF5400符文骑士^000000和 ^FF5400皇家卫队^000000提供服务。";
					mes "让我在你的小地图上标记他的位置。";
					mes "请确认标记。";
					mes .@str$;
					viewpoint 1,131,213,16,0xFFB400;
					next;
					break;
				case 4:
					mes "[Prontera Guide]";
					mes F_Navi("魔导机甲管理员","prontera,163,178","^006400");
					mes "为 ^006400机械师^000000";
					mes "提供服务。";
					mes "让我在你的小地图上标记他的位置。";
					mes "请确认标记。";
					mes .@str$;
					viewpoint 1,163,178,17,0xAAFF00;
					next;
					break;
				case 5:
					mes "[Prontera Guide]";
					mes "如果你心爱的大嘴鸟不愿离开你，";
					mes "请和中央喷泉附近的"+F_Navi("大嘴鸟移除员","prontera,125,208","^7F3300");
					mes "谈谈。他会为你提供帮助。";
					mes "请放心。";
					mes .@str$;
					viewpoint 1,125,208,18,0xD2691E;
					next;
					break;
				case 6:
					mes "[Prontera Guide]";
					mes "卢恩商人、天津商人及其他";
					mes F_Navi("交易商人","prontera,178,244","^800080")+"已标记在";
					mes "你的小地图上。";
					mes .@str$;
					viewpoint 1,178,244,19,0xDA70D6;
					next;
					break;
				case 7:
					callsub L_Mark, F_Navi("佣兵公会成员","prontera,35,337","^0000FF"),1;
					mes .@str$;
					viewpoint 1,35,337,20,0x0A82FF;
					next;
					break;
				case 8:
					mes "[Prontera Guide]";
					mes "^FF5400催眠师^000000";
					mes "可以帮助新手冒险者";
					mes "重置技能。";
					mes "他已经搬到普隆德拉东南方的卫星城镇伊兹鲁德。";
					mes "还要查看其他地点吗？";
					mes .@str$;
					//viewpoint 1,146,232,21,0xFFB400;
					next;
					break;
				case 9:
					callsub L_Mark, "^006400卡普拉职员^000000",1;
					mes .@str$;
					viewpoint 1,152,326,22,0xAAFF00;
					viewpoint 1,30,207,23,0xAAFF00;
					viewpoint 1,282,200,24,0xAAFF00;
					viewpoint 1,151,29,25,0xAAFF00;
					viewpoint 1,146,89,26,0xAAFF00;
					next;
					break;
				case 10:
					mes "[Prontera Guide]";
					mes F_Navi("Leablem","prontera,244,169","^0000FF");
					mes "是一名技术员，";
					mes "可以在武器和防具上制作 ^0000FF插槽^000000。";
					mes "听起来很厉害，";
					mes "但并非所有装备都能开槽。";
					mes .@str$;
					viewpoint 1,244,169,27,0x0A82FF;
					next;
					break;
				case 11:
					callsub L_Mark, F_Navi("工匠学徒","prontera,165,60","^800080"),1;
					mes .@str$;
					viewpoint 1,165,60,28,0xDA70D6;
					next;
					break;
				case 12:
					callsub L_Mark, F_Navi("宠物美容师","prontera,218,211"),1;
					mes .@str$;
					viewpoint 1,218,211,29,0xFF0000;
					next;
					break;
				case 13:
					set .@loop,0;
					break;
				}
			}
			break;
		case 3:
			mes "[Prontera Guide]";
			mes "好的，我会移除小地图上的所有标记。";
			mes "还有其他需要我做的吗？";
			viewpoint 2,1,1,0,0xFFFF00;
			viewpoint 2,1,1,1,0x000000;
			viewpoint 2,1,1,2,0xFF0000;
			viewpoint 2,1,1,3,0xFFFF00;
			viewpoint 2,1,1,4,0xFFFF00;
			viewpoint 2,1,1,5,0xFFFF00;
			viewpoint 2,1,1,6,0xFFFF00;
			viewpoint 2,1,1,7,0xFFFF00;
			viewpoint 2,1,1,8,0xFFFF00;
			viewpoint 2,1,1,9,0xFFFF00;
			viewpoint 2,1,1,10,0xFFFF00;
			viewpoint 2,1,1,11,0xFFFF00;
			viewpoint 2,1,1,12,0xFFFF00;
			viewpoint 2,1,1,13,0xFFFF00;
			viewpoint 2,1,1,14,0xFFFF00;
			viewpoint 2,1,1,15,0xFFFF00;
			viewpoint 2,1,1,16,0xFFFF00;
			viewpoint 2,1,1,17,0xFFFF00;
			viewpoint 2,1,1,18,0xFFFF00;
			viewpoint 2,1,1,19,0xFFFF00;
			viewpoint 2,1,1,20,0xFFFF00;
			//viewpoint 2,1,1,21,0xFFFF00;
			viewpoint 2,1,1,22,0xFFFF00;
			viewpoint 2,1,1,23,0xFFFF00;
			viewpoint 2,1,1,24,0xFFFF00;
			viewpoint 2,1,1,25,0xFFFF00;
			viewpoint 2,1,1,26,0xFFFF00;
			viewpoint 2,1,1,27,0xFFFF00;
			viewpoint 2,1,1,28,0xFFFF00;
			viewpoint 2,1,1,29,0xFFFF00;
			next;
			break;
		case 4:
			mes "[Prontera Guide]";
			mes "祝你逗留愉快。";
			close2;
			cutin "prt_soldier",255;
			end;
		}
	}
	end;
L_Mark:
	mes "[Prontera Guide]";
	if (getarg(1,0)) {
		mes "让我标记";
		mes getarg(0);
	} else
		mes "让我在你的小地图上标记"+getarg(0);
	mes "的位置。";
	return;
}
prontera,282,208,2	duplicate(GuideProntera)	Guide#02prontera	105
prontera,29,200,6	duplicate(GuideProntera)	Guide#03prontera	105
prontera,160,29,0	duplicate(GuideProntera)	Guide#04prontera	105
prontera,159,326,4	duplicate(GuideProntera)	Guide#05prontera	105

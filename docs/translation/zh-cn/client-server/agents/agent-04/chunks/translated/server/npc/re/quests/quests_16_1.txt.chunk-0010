		mes "[Isenhonor Walther]";
		mes "你似乎带了很多行李。还好吗？";
		mes "看起来又多又大。";
		next;
		mes "[Isenhonor Walther]";
		mes "减少一些怎么样？";
		close;
	}
	.@name$ = strcharinfo(0);
	if (ep16_wal == 0) {
		mes "[Isenhonor]";
		mes "你一定是冒险者。感谢你访问这个阴郁的地方。";
		next;
		mes "[Isenhonor]";
		mes "我们家族的代表在那边。希望你玩得愉快。";
		close;
	}
	if (ep16_wal == 1) {
		mes "[" + .@name$ + "]";
		mes "你好？";
		next;
		mes "[Isenhonor]";
		mes "你在这里做什么？宴会厅在那边。";
		next;
		mes "[" + .@name$ + "]";
		mes "抱歉，当时没时间和你谈。";
		next;
		mes "[Isenhonor]";
		mes "什么故事？你是说我哥哥因暴力行为被杀的故事？你似乎很想听。希望你别相信那种胡说。";
		next;
		mes "[" + .@name$ + "]";
		mes "哦，好吧……";
		next;
		mes "[Isenhonor]";
		mes "我不相信我哥哥会暴力行事。即使他真的这样做，也一定有^0000cd理由。^000000";
		next;
		mes "[Isenhonor]";
		mes "我哥哥一定是为了某件事才那么做。没人知道真相，但人们似乎相信那些传闻。";
		next;
		mes "[" + .@name$ + "]";
		mes "想为哥哥洗清名誉，就自己调查。";
		next;
		mes "[Isenhonor]";
		mes "我正在努力。但^0000cd我家族的长老不想让我挖出^0000cd那件不光彩的事件^000000^000000。";
		next;
		mes "[Isenhonor]";
		mes "而且无法见到^0000cd恩斯特·乔博格^000000。";
		next;
		mes "[" + .@name$ + "]";
		mes "他不愿意见你吗？";
		next;
		mes "[Isenhonor]";
		mes "不。与他接触的通道都被封锁。";
		next;
		mes "[Isenhonor]";
		mes "^0000cd守护骑士^000000和^0000cd恩斯特·乔博格^000000是唯一知道那天发生什么的人。但根本无法见到他们。我不知道该从哪里开始……";
		next;
		mes "[" + .@name$ + "]";
		mes "守护骑士？你哥哥有守护骑士？";
		next;
		mes "[Isenhonor]";
		mes "是的。沃尔特家族每位成员都有守护骑士。我们家族从事海外贸易，经常乘船旅行。";
		next;
		mes "[Isenhonor]";
		mes "如你所知，水手可不温柔，而且我们经常随身携带钱财，因此常受到威胁。我们都必须带上守护骑士。";
		next;
		mes "[" + .@name$ + "]";
		mes "那么你的守护骑士在哪里，伊森霍诺？";
		next;
		mes "[Isenhonor]";
		mes "我已经受够守护骑士了，因为哥哥的守护骑士抛弃哥哥逃走了。我不想再称他们为守护骑士。";
		next;
		mes "[Isenhonor]";
		mes "背叛主人并逃跑的守护骑士该叫什么？";
		next;
		mes "[" + .@name$ + "]";
		mes "我认为从你的守护骑士入手是个好主意。他们曾一起作为守护骑士工作，他一定知道些什么。";
		next;
		mes "[Isenhonor]";
		mes "我问过他，他说自己什么都不知道。如果知道，他应该在我问之前就告诉我了。";
		mes "他们关系很亲密，经常一起训练。";
		next;
		mes "[Isenhonor]";
		mes "哦，既然他们关系这么好，他也许试图保护朋友。";
		mes "我怎么没想到……";
		next;
		mes "[" + .@name$ + "]";
		mes "让我现在和他谈谈。如果能听到什么就好了。即使什么也听不到，至少也算尝试过。";
		next;
		mes "[Isenhonor]";
		mes "你为什么要费这么大劲？";
		next;
		mes "[" + .@name$ + "]";
		mes "嗯，我有一种预感。作为冒险者，我的直觉告诉我一定有事发生。";
		next;
		mes "[Isenhonor]";
		mes "所有冒险者都这样依靠预感吗？这可能很危险。不能只凭预感行事。";
		next;
		mes "[" + .@name$ + "]";
		mes "所以才叫冒险。冒险者就该去有冒险的地方。";
		next;
		mes "[Isenhonor]";
		mes "我不明白。";
		next;
		mes "[" + .@name$ + "]";
		mes "你可以说这是出于好奇的多管闲事。但我不能对陷入困境的人置之不理。";
		next;
		mes "[Isenhonor]";
		mes "不过我感谢你的帮助。我已经绝望到愿意接受你的好意。但我想你从守护骑士那里也问不出什么。";
		next;
		mes "[Isenhonor]";
		mes "如果你还是想见他，就去^0000cd艾尔帕兰南部的庄园^000000。他应该在那里。";
		next;
		mes "[" + .@name$ + "]";
		mes "那就这样。";
		completequest 14469;// Look around the Walther Family
	setquest 14470;// In Search of the Guardian Knight
		ep16_wal = 2;
		if (achievementinfo(130000, ACHIEVEINFO_COUNT3) == 0)
			achievementupdate(130000, ACHIEVEINFO_COUNT3, 1);
		if (isbegin_quest(7682) == 1 && isbegin_quest(5402) == 2 && isbegin_quest(7683) == 2 && isbegin_quest(7684) == 2 && ep16_wal > 1 && ep16_wig > 1 && ep16_lug > 1 && ep16_gaobs > 1) {
			completequest 7682;// Socializing Starts from an Eye Contact
			setquest 7685;// What Is the Next Thing on the Schedule ?
		}
		close;
	}
	if (ep16_wal < 6) {
		mes "[Isenhonor]";
		mes "冒险者，你在艾尔帕兰和守护骑士见面还顺利吗？我也没抱太大希望……";
		next;
		mes "[Isenhonor]";
		mes "不过，我还是希望能从你那里听到好消息……";
		close;
	}
	if (ep16_wal == 6) {
		if (countitem(6929) < 1) {
			mes "[Isenhonor]";
			mes "冒险者，你回来了。进展如何？";
			next;
			mes "[" + .@name$ + "]";
			mes "是的，我有东西给你……";
			mes "哦？去哪儿了？";
			next;
			mes "[" + .@name$ + "]";
			mes "我一定把它落下了。我去拿给你。";
			close;
		}
		mes "[Isenhonor]";
		mes "你回来了。进展如何？";
		next;
		mes "我告诉他与伊森阿姆的守护骑士见面以及交谈的经过。";
		next;
		mes "[" + .@name$ + "]";
		mes "这是^0000cd信件^000000。";
		next;
		mes "[Isenhonor]";
		mes "这确实是我们家族的印章，也是我哥哥的笔迹。";
		next;
		mes "[Isenhonor]";
		mes "正如你所说，我哥哥的守护骑士一定没有背叛哥哥。";
		next;
		mes "[Isenhonor]";
		mes "哥哥一定是出于某种原因才做了那件事。";
		next;
		mes "[" + .@name$ + "]";
		mes "我现在能做的就只有这些了。";
		next;
		mes "[Isenhonor]";
		mes "我明白了。接下来由我来处理。谢谢你的帮助。";
		next;
		mes "[Isenhonor]";
		mes "需要沃尔特家族帮助时，请随时回来。";
		next;
		mes "[Isenhonor]";
		mes "从今以后，你就是沃尔特家族珍贵的客人，亲爱的冒险者。想要帮助时我随时都会帮你。";
		delitem 6929,1;// Letters_Stamped_Seal
		completequest 14474;// Report to Isenhonor
		getitem 6919,10;// TokenOfHonor
		getexp 1000000,500000;
		ep16_wal = 7;
		close;
	}
	mes "[Isenhonor]";
	mes "根据你带来的信息，我也在收集其他线索。虽然还不够，但我相信总有一天能揭开真相。";
	next;
	mes "[Isenhonor]";
	mes "我已经从艾尔帕兰叫来了 Simon。现在必须尽可能集合所有帮助。";
	next;
	mes "[Isenhonor]";
	mes "真相揭开时，我们会再见。";
	close;
}

alberta,187,147,7	script	Guardian Knight#ep16wal	4_M_KNIGHT_SILVER,{
	.@name$ = strcharinfo(0);
	if (ep16_wal == 2) {
		mes "[" + .@name$ + "]";
		mes "我在找伊森霍诺的守护骑士。在哪里能找到他？";
		next;
		mes "[Simon]";
		mes "我是他的守护骑士。怎么了？他出什么事了吗？";
		next;
		mes "[Simon]";
		mes "我不该留在后方。他还好吗？";
		next;
		mes "[Simon]";
		mes "绑架？受伤？抢劫？坠落？怎么回事？哦，我现在就该去……！";
		next;
		mes "[" + .@name$ + "]";
		mes "冷静。伊森霍诺没事。什么都没发生。我只是来问你一些事。";
		next;
		mes "[Simon]";
		mes "呼，看来不是我家主人叫我。我还是很高兴他没事。";
		next;
		mes "[Simon]";
		mes "你要问我什么？对了，你是谁？";
		next;
		mes "[我简要告诉他在宫殿与 Isenhonor 的谈话内容。]";
		next;
		mes "[Simon]";
		mes "哦，抱歉。我是^0000cdSimon Walther Marshall^000000。";
		next;
		mes "[Simon]";
		mes "很遗憾，我不知道曾是伊森阿姆守护骑士的^0000cdKain Walther Walker^000000在哪里。";
		next;
		mes "[" + .@name$ + "]";
		mes "你们名字里都有 Walther。这有什么特殊原因吗？";
		next;
		mes "[Simon]";
		mes "每位分配给沃尔特家族成员的骑士，都属于沃尔特，并会被赋予 Walther 这个名字。";
		next;
		mes "[Simon]";
		mes "这个名字带来归属感，也让我们为被认可为优秀骑士而自豪。";
		next;
		mes "[" + .@name$ + "]";
		mes "这样啊。对了，你说你对 Kain Walther Walker 一无所知？";
		next;
		mes "[Simon]";
		mes "是的，我不知道。";
		mes "不过……";
		next;
		mes "[" + .@name$ + "]";
		mes "不过……？";
		next;
		mes "[Simon]";
		mes "护送伊森霍诺去王宫时，我从那里的几名骑士听到一则^0000cd奇怪的传闻^000000。";
		next;
		mes "[Simon]";
		mes "他们听说^0000cd一个被关在王宫地下室的小偷^000000喋喋不休地说，他在外国见过沃尔特家族的人。";
		next;
		mes "[Simon]";
		mes "不过因为王室宴会，没有家族成员离开国家。听到这个很奇怪。我觉得那个人可能是^0000cdKain^000000。";
		next;
		mes "[Simon]";
		mes "考虑到事情的重要性，我本想亲自调查。但伊森霍诺命令我回艾尔帕兰，所以我只能回来。";
		next;
		mes "[" + .@name$ + "]";
		mes "地下监狱里的小偷？";
		next;
		mes "[Simon]";
		mes "是的。我不知道他的真名，但地下世界称他为^0000cd大脚^000000。";
		next;
		mes "[Simon]";
		mes "小偷这类轻罪犯通常会被关在别处。但那家伙是在阿鲁纳佩尔兹偷窃时被抓的。";
		next;
		mes "[Simon]";
		mes "由于外交问题，我们接管了他，并把他关进地下监狱。";
		next;
		mes "[Simon]";
		mes "那家伙似乎掌握大陆各地的大量信息。即使他说见过沃尔特家族的人不是真的，我也觉得能从他那里得到有用信息。";
		next;
		mes "[" + .@name$ + "]";
		mes "不管他掌握的信息是真是假，我还是想去见他。谢谢你的消息。";
		next;
		mes "[Simon]";
	mes "回到宫殿后请替我向主人问好。告诉他我会好好守护这里。";
		next;
		mes "[Simon]";
	mes "还要告诉他随时可以叫我，我很乐意去那里保护他。";
		next;
		mes "[" + .@name$ + "]";
	mes "好的，我一定转告他。";
		next;
		mes "[Simon]";
	mes "那就一路平安！";
		erasequest 14470;// In Search of the Guardian Knight
		setquest 14471;// To the Royal Prison
		ep16_wal = 3;
		close;
	}
	if (ep16_wal == 3) {
		mes "[Simon]";
	mes "你去监狱的情况怎么样？";
		next;
		mes "[Simon]";
	mes "你可以去看看被关在^0000cd宫殿地下监狱^000000里的囚犯^0000cdBigfoot^000000。";
		next;
		mes "[Simon]";
	mes "Isenhonor 没再告诉你其他事吗？去普隆德拉时请代我向他问好。";
		close;
	}
	if (ep16_wal > 6) {
		mes "[Simon]";
	mes "亲爱的冒险者！Isenhonor 主人终于叫我了！我很高兴能在附近守护主人。";
		next;
		mes "[" + .@name$ + "]";
	mes "听到这个真好。那你现在在这里做什么？";
		next;
		mes "[Simon]";
	mes "我在等前往伊兹鲁德的船。船一到这里我就会赶过去。";
		next;
		mes "[Simon]";
	mes "我有很多问题想问你，但我想最好还是听主人讲故事。那么亲爱的冒险者，一路平安！";
		close;
	}
	mes "[守护骑士]";
	mes "如果我离开时主人出了什么事……";
	mes "我现在要去普隆德拉吗？";
	next;
	mes "[守护骑士]";
	mes "不，他会生我的气。";
	mes "他总有一天会叫我。就在这里等吧。";
	next;
	mes "[守护骑士]";
	mes "再等一会儿。";
	close;
}

alberta,48,30,7	script	Butler for the Walthers#ep16wal	4_M_MANAGER,{
	if (ep16_wal == 2) {
		mes "[沃尔特家族管家]";
	mes "天气真好。不过这房子感觉空荡又寂寞。";
		next;
		mes "[" + strcharinfo(0) + "]";
	mes "你好？这里是沃尔特家族的庄园吗？";
		next;
		mes "[沃尔特家族管家]";
	mes "是的。你来这里做什么？大家都去了普隆德拉，你现在见不到主人。";
		next;
		mes "[" + strcharinfo(0) + "]";
	mes "Isenhonor 派我来见守护骑士。";
		next;
		mes "[沃尔特家族管家]";
	mes "哦，真的吗？他一直在等 Isenhonor 的召唤！我真为他高兴。";
		next;
		mes "[沃尔特家族管家]";
	mes "Isenhonor 的守护骑士 Simon 在^0000cd伊兹鲁德^000000航船停靠的^0000cd码头^000000附近。";
		next;
		mes "[沃尔特家族管家]";
	mes "他正在那里等候，一旦 Isenhonor 召唤就会尽快前往普隆德拉。";
		next;
		mes "[沃尔特家族管家]";
	mes "去前往伊兹鲁德的船停靠的地方。";
		close;
	}
	mes "[沃尔特家族管家]";
	mes "Alkish 家族的管家 Mahatra Mornen，我再也受不了他的傲慢了。";
	next;
	mes "[沃尔特家族管家]";
	mes "他们不过拥有一座庄园。竟敢称自己是艾尔贝塔最好的家族？他们把沃尔特家族当什么了！";
	next;
	mes "[沃尔特家族管家]";
	mes "他们见到我们时甚至不敢直视。";
	next;
	mes "[沃尔特家族管家]";
	mes "我们的主人太温和了，才会放过他们。真没品。";
	close;
}

prt_pri00,57,119,1	script	Bigfoot#ep16wal	1_M_JOBGUIDER,{
	if (ep16_wal < 3) {
		mes "[Bigfoot]";
	mes "炸鸡、烤土豆、啤酒、新鲜奶酪……哈……我被关在这里后，真想念那些普通菜肴。";
	mes "谁带给我这些，我就嫁给谁。";
		next;
		emotion ET_HUK;
		mes "[Bigfoot]";
	mes "啊！又来了！我好害怕！";
	mes "但只要被关在这里，我就是安全的。";
		close;
	}
	.@name$ = strcharinfo(0);
	if (ep16_wal == 3) {
		mes "[Bigfoot]";
		mes "炸鸡、烤土豆、啤酒、新鲜奶酪……哈……我被关在这里后，真想念那些普通菜肴。";
		next;
		mes "[Bigfoot]";
		mes "谁带给我这些，我就嫁给谁。";
		next;
		emotion ET_HUK;
		mes "[Bigfoot]";
	mes "啊！又来了！我好害怕！但只要被关在这里，我就是安全的。";
		next;
		mes "[" + .@name$ + "]";
		mes "Bigfoot？";
		next;
		emotion ET_FRET;
		mes "[Bigfoot]";
		mes "哦不！我不吃那个！我不想再吃猪饲料了！我可能不是美食家，但我的舌头还没腐烂！";
		next;
		mes "[Bigfoot]";
		mes "给我带些能吃的东西！我知道自己被关在监狱里，但我有权吃点能入口的东西！";
		next;
		mes "[" + .@name$ + "]";
		mes "一定是误会。我不是这里的典狱长。我是来见你的。";
		next;
		mes "[Bigfoot]";
		mes "你不是吗？听到这个我就放心了。这里的食物糟透了。";
		next;
		mes "[Bigfoot]";
		mes "顺便问一下，你是谁？你看起来像冒险者。";
		next;
		mes "[Bigfoot]";
		mes "不过这不重要。你是来问我什么的，对吧？你知道天下没有免费的东西。";
		next;
		emotion ET_SWEAT, playerattached();
		mes "[" + .@name$ + "]";
		mes "……你想要什么？";
		next;
		mes "[Bigfoot]";
		mes "把我弄出去。";
		next;
		mes "[" + .@name$ + "]";
		mes "这超出了我的能力。";
		next;
		mes "[Bigfoot]";
		mes "别这么完美主义。你能来到这里，等级一定很高吧？";
		next;
		mes "[Bigfoot]";
		mes "好吧，我明白了。我本来也知道这个请求很困难。";
		next;
		mes "[Bigfoot]";
		mes "我没指望你会放我出去，只是把想法说出来而已。";
		next;
		mes "[Bigfoot]";
		mes "不过你拒绝得太干脆了。至少可以假装考虑或想一想。";
		next;
		mes "[" + .@name$ + "]";
		mes "那你到底想要什么？";
		next;
		mes "[Bigfoot]";
		mes "当然是钱。价格取决于你想要的信息。";
		next;
		mes "[Bigfoot]";
		mes "我不接受按月分期，只收现金。我只接受两年以上的货币。将来出去后我会把钱花在有意义的地方。";
		next;
		mes "[" + .@name$ + "]";
		mes "我钱不多，但知道该花在哪里。我想我还是拒绝这笔交易吧。再见。";
		next;
		emotion ET_HNG;
		mes "[Bigfoot]";
		mes "嘿！别把玩笑当真。你的朋友不是叫你固执吗？";
		next;
		mes "[Bigfoot]";
		mes "我就知道。你太容易放弃了。你还年轻呢。";
		next;
		mes "[" + .@name$ + "]";

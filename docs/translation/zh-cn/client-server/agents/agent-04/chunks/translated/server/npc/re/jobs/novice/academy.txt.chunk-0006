		mes "有一天，我想到一个好主意。如果遇到强敌时装死……";
		next;
		mes "[Instructor Argos]";
		mes "因为不擅长装死，我面临死亡风险。";
		mes "即使现在回想，那仍然令人心惊……";
		emotion ET_KEK;
		next;
		mes "[Instructor Argos]";
		mes "继续聊吧";
		mes "从那以后，装死对我很有效！";
		next;
		mes "[Instructor Argos]";
		mes "然后……";
		mes "我无法长时间屏住呼吸。";
		mes "那是个问题！";
		mes "聪明的怪物会检查我的呼吸！";
		next;
		mes "[Instructor Argos]";
		mes "所以我必须训练自己长时间屏息。";
		next;
		mes "[Instructor Argos]";
		mes "听起来复杂……但其实很简单。";
		next;
		mes "[Instructor Argos]";
		mes "如果觉得打不过敌人，强敌出现时就倒在地上装死。";
		next;
		mes "[Instructor Argos]";
		mes "我会简单测试你能否屏住呼吸。";
		next;
		mes "[Instructor Argos]";
		mes "屏息 20 秒，然后再和我说话。在时间结束前和我说话，我可不会承认你通过了！";
		next;
		mes "[Instructor Argos]";
		mes "开始！";
		close2;
		setquest 15001;
		end;
	} else if (checkquest(15001,PLAYTIME) == 0) {
		mes "[Instructor Argos]";
		mes "什么？你连 20 秒都屏不住？";
		mes "在学会屏息前，你无法学习这项技能！";
		next;
		mes "[Instructor Argos]";
		mes "再屏息 20 秒！";
		mes "然后和我说话。";
		close2;
		erasequest 15001;
		setquest 15001;
		end;
	} else {
		mes "- 学会了<^ff0000装死^000000>技能。";
		completequest 15001;
		skill "NV_TRICKDEAD", 1, 0;
		skill_nov = 6;
		next;
		mes "[Instructor Argos]";
		mes "好，干得好。";
		mes "如果你有这样的耐心，它会救你。不会有怪物能伤害你。";
		next;
		mes "[Instructor Argos]";
		mes "<^ff0000装死^000000>技能在技能列表中，按 <Alt + S> 可以打开技能列表。别忘了使用它，遇到危险时它会救你。";
		next;
		mes "[Instructor Argos]";
		mes "转职后就不再需要这项技能，所以别舍不得用！需要时就使用，不要犹豫。";
		next;
		mes "[Instructor Argos]";
		mes "我得睡一会儿，别叫醒我。哈欠。";
		close;
	}

OnInit:
	questinfo( QTYPE_QUEST, QMARK_NONE, "Class == Job_Novice && !isbegin_quest(15001)" );
	end;
}

izlude_a,140,260,3	duplicate(Instructor Argos#iz)	Instructor Argos#iz_a	4_M_LIEMAN
izlude_b,140,260,3	duplicate(Instructor Argos#iz)	Instructor Argos#iz_b	4_M_LIEMAN
izlude_c,140,260,3	duplicate(Instructor Argos#iz)	Instructor Argos#iz_c	4_M_LIEMAN
izlude_d,140,260,3	duplicate(Instructor Argos#iz)	Instructor Argos#iz_d	4_M_LIEMAN

// - Academy Receptionist
// - Gives player some basic equipment and starts Academy quests.
// -----------------------------------------------------------------------------
iz_ac01,100,39,5	script	Academy Receptionist#1	4_F_01,{
	if (isbegin_quest(7117) == 1) { erasequest 7117; }
	if (isbegin_quest(7118) == 1) { erasequest 7118; }
	if (isbegin_quest(7119) == 1) { erasequest 7119; }
	if (isbegin_quest(7120) == 1) { erasequest 7120; }
	if (isbegin_quest(7121) == 1) {	erasequest 7121; }
	if (isbegin_quest(7122) == 1) { erasequest 7122; }
	if (isbegin_quest(7123) == 1) {	erasequest 7123; }
	if (isbegin_quest(7124) == 1) {	erasequest 7124; }
	if (isbegin_quest(7126) == 1) {	erasequest 7126; }
	if (isbegin_quest(7127) == 1) {	erasequest 7127; }

	if (isbegin_quest(4269) == 2) {
		mes "[Receptionist]";
		mes "你好，" + strcharinfo(0) +".";
		mes "你今天好吗？";
		mes "我负责在学院为你指引。";
	} else {
		mes "[Receptionist]";
		mes "欢迎来到学院。我负责初心者教育课程的引导和登记。";
	}
	next;
	while(1) {
		mes "[Receptionist]";
		mes "我能为你做什么？";
		next;
		if (isbegin_quest(4269) == 2)
			.@menu$ = ":What's inside and outside the Academy.:Trainer location guide.:End Coversation.";
		else
			.@menu$ = "Register for the Academy:Explanation about the Academy:Location for trainers:Coversation finished";
		switch(select(.@menu$)) {
		case 1:
			if (Class == Job_Novice) {
				if (!checkweight(1301,10)) {
					mes "- 由于携带物品过多，任务无法继续。-";
					close;
				}
				mes "[Receptionist]";
				mes "让我看看……你的名字是……" + strcharinfo(0) + ".";
				mes "我会为你重新登记。";
				mes "你可以自由选择课程，每门课程都有独特特色。";
				next;
				mes "[Receptionist]";
				mes "这是教育课程的基础装备。";
				mes "请好好使用它。";
				mes "请小心，因为不会再次提供。";
				setquest 4269;
				completequest 4269;
				getitem 2352,1;// Novice_Plate
				getitem 2510,1;// Novice_Hood
				getitem 2414,1;// Novice_Boots
				getitem 5055,1;// Novice_Egg_Cap
				getitem 1243,1;// Novice_Knife
				getitem 2112,1;// Novice_Guard
				getitem 18730,1;// Criatura_Academy_Hat
				getitem 6593,1;// Criatura_Hair_Coupon
				getitem 569,300;// Novice_Potion
				next;
				mes "[Receptionist]";
				mes "来访学院是你成为冒险者的第一步。";
				getexp 100,100;
				next;
				mes "[Receptionist]";
				mes "下次见面时，我希望你已经成长了一些。";
				//ConsumeSpecialItem Inspector_Certificate_
				close;
			} else {
				mes "[Receptionist]";
				mes "不是初心者就不能参加教育课程。";
				next;
				mes "[Receptionist]";
				mes "不过，除了角色培养以外的教育课程都可以自由参加。所以你可以逛逛学院和周边地区。";
				close;
			}
		case 2:
			switch(select("一楼有什么", "二楼有什么", "城镇说明", "结束对话")) {
			case 1:
				mes "[Receptionist]";
				mes "一楼有导师讲解米德加尔特的世界。";
				next;
				mes "[Receptionist]";
				mes "首先，在医疗所可以学习如何恢复体力，以及治疗 HP 的技能。";
				next;
				mes "[Receptionist]";
				mes "在军械库可以接受在米德加尔特与怪物战斗的基础训练。";
				next;
				mes "[Receptionist]";
				mes "在餐厅可以练习烹饪，了解烹饪的诸多益处。";
				next;
				break;
			case 2:
				mes "[Receptionist]";
				mes "二楼有训练师，会向你介绍世界上的各种职业。";
				next;
				mes "[Receptionist]";
				mes "听取训练师的介绍，自己决定哪种职业适合你的风格。";
				next;
				break;
			case 3:
				mes "[Receptionist]";
				mes "这座城镇名为‘伊兹鲁德’，是卢恩·米德加尔特王国首都普隆德拉的卫星城和港口城市。";
				next;
				mes "[Receptionist]";
				mes "这座城镇经过重新规划，适合进行初心者教育。";
				next;
				break;
			case 4:
				mes "[Receptionist]";
				mes "如果还需要其他帮助，请来找我。";
				//if (Class == Job_Novice)
					//ConsumeSpecialItem Inspector_Certificate_
				close;
			}
			break;
		case 3:
			while(1) {
				switch(select("游戏机制教程训练师", "一转训练师", "返回上一级菜单", "结束对话")) {
				case 1:
					mes "[Receptionist]";
					mes "用鼠标左键点击要找的训练师姓名，我会为你指引道路。";
					next;
					mes "<NAVI>[治疗师]<INFO>iz_ac01,59,43</INFO></NAVI>，状态恢复训练师";
					mes "<NAVI>[苏比诺]<INFO>iz_ac01,59,83</INFO></NAVI>，战斗训练师";
					mes "<NAVI>[迈因兹]<INFO>iz_ac01,134,47</INFO></NAVI>，异常状态训练师";
					mes "<NAVI>[达库瓦兹]<INFO>iz_ac01,147,47</INFO></NAVI>，料理训练师。";
					mes "<NAVI>[韩]<INFO>izlude,153,126</INFO></NAVI>，精炼训练师。";
					mes "<NAVI>[芒兹]<INFO>izlude,96,125</INFO></NAVI>，附魔训练师。";
					mes "<NAVI>[奶油泡芙]<INFO>iz_ac02,143,55</INFO></NAVI>，职业资质测试。";
					next;
					mes "[Receptionist]";
					mes "这样有帮助吗？";
					next;
					if (select("请稍等。", "我得走了。") == 1) {
						continue;
					} else {
						if (Class == Job_Novice) {
							mes "[Receptionist]";
							mes "我相信下次见面时你会变得更出色。加油~~~";
							//ConsumeSpecialItem Inspector_Certificate_
							close;
						} else {
							mes "[Receptionist]";
							mes "如果还需要其他帮助，请来找我。";
							close;
						}
					}
				case 2:
					mes "[Receptionist]";
					mes "用鼠标左键点击要找的训练师姓名，我会为你指引道路。";
					next;
					mes "剑士训练师 <NAVI>[阿德里克]<INFO>iz_ac02,62,51</INFO></NAVI>";
					mes "服事训练师 <NAVI>[爱丽丝]<INFO>iz_ac02,156,169</INFO></NAVI>";
					mes "弓箭手训练师 <NAVI>[马尔布隆]<INFO>iz_ac02,65,109</INFO></NAVI>";
					mes "魔法师训练师 <NAVI>[查克]<INFO>iz_ac02,148,110</INFO></NAVI> ";
					mes "盗贼训练师 <NAVI>[梅赛尔]<INFO>iz_ac02,52,136</INFO></NAVI>";
					mes "商人训练师 <NAVI>[萨利姆]<INFO>iz_ac02,50,169</INFO></NAVI>";
					mes "忍者训练师 <NAVI>[忍者向导]<INFO>iz_ac02,140,139</INFO></NAVI>";
					mes "神枪手训练师<NAVI>[露莎]<INFO>iz_ac02,142,85</INFO></NAVI>";
					mes "跆拳训练师 <NAVI>[阿朗]<INFO>iz_ac02,70,85</INFO></NAVI>";
					next;
					mes "[Receptionist]";
					mes "这样有帮助吗？";
					next;
					if (select("请稍等。", "我得走了。") == 1) {
						continue;
					} else {
						if (Class == Job_Novice) {
							mes "[Receptionist]";
							mes "我相信下次见面时你会变得更出色。加油~~~";
							//ConsumeSpecialItem Inspector_Certificate_
							close;
						} else {
							mes "[Receptionist]";
							mes "如果还需要其他帮助，请来找我。";
							close;
						}
					}
				case 3:
					break;
				case 4:
					mes "[Receptionist]";
					mes "如果还需要其他帮助，请来找我。";
					// if (Class == Job_Novice)
						//ConsumeSpecialItem Inspector_Certificate_
					close;
				}
				break;
			}
			break;
		case 4:
			mes "[Receptionist]";
			mes "如果还需要其他帮助，请来找我。";
			// if (Class == Job_Novice)
				//ConsumeSpecialItem Inspector_Certificate_
			close;
		}
	}

OnInit:
	questinfo( QTYPE_QUEST, QMARK_NONE, "Class == Job_Novice && !isbegin_quest(4269)" );
	end;
}

iz_ac01_a,100,39,5	duplicate(Academy Receptionist#1)	Academy Receptionist#1_a	4_F_01
iz_ac01_b,100,39,5	duplicate(Academy Receptionist#1)	Academy Receptionist#1_b	4_F_01
iz_ac01_c,100,39,5	duplicate(Academy Receptionist#1)	Academy Receptionist#1_c	4_F_01
iz_ac01_d,100,39,5	duplicate(Academy Receptionist#1)	Academy Receptionist#1_d	4_F_01

// - Trainer Mainz
// - Teaches the player about Status Effects (poison, stun, etc).
// -----------------------------------------------------------------------------
iz_ac01,134,47,5	script	Trainer Mainz#ac	4_M_KY_KNT,4,4,{
	if (!isbegin_quest(4269)) {
		mes "[Mainz]";
		mes "哈啊……";
		mes "这个饭盒该怎么办？";
		close;
	}
	if (isbegin_quest(15000) == 1) {
		if (!checkweight(1201,1) || (MaxWeight - Weight) < 40) {
			mes "- 等一下！！ -";
			mes "- 你的物品栏负重过高 -";
			mes "- 无法再领取物品 -";
			mes "- 请先减轻负重 -";
			mes "- 然后重试 -";
			close;
		}
		mes "[Mainz]";
		mes "准备好学习异常状态了吗？我保证不会再骗你了。毕竟我是‘训练师’，对吧？";
		next;
		mes "[Mainz]";
		mes "首先，我来介绍<^FF0000中毒^000000>。";
		next;
		mes "[Mainz]";
		mes "正如你已经体验过的，中毒时身体会变成紫色，每秒损失少量 HP。";
		next;
		mes "[Mainz]";
		mes "HP 不会永远减少，所以你不会因中毒而死亡。";
		next;
		mes "[Mainz]";
		mes "亲身体验才会相信！我现在让你进入中毒状态。";
		next;
		mes "[Mainz]";
		mes "看看自己处于中毒状态时会发生什么。";
		next;
		sc_start SC_POISON, 30000, 0;
		mes "你现在是——<^FF0000中毒^000000>。";
		next;
		mes "[Mainz]";
		mes "......";
		next;
		sc_end SC_POISON;
		mes "[Mainz]";
		mes "看清中毒状态了吗？经过一段时间后可以自动解毒，但如果遭到攻击，期待自然解毒会很危险。";
		next;
		mes "[Mainz]";
		mes "可以使用<^0022FF绿色药草^000000>、<^0022FF绿色药水^000000>、<^0022FF万能药^000000>和<^0022FF蜂王浆^000000>等解毒剂。";
		next;
		mes "[Mainz]";
		mes "接下来，我来介绍<^FF0000眩晕^000000>。";
		next;
		mes "[Mainz]";
		mes "处于眩晕状态时，星星会在头顶旋转，你基本无法移动，会变得‘毫无防备’。";
		next;
		mes "[Mainz]";
		mes "由于毫无防备，你无法移动、使用技能或道具。";
		mes "所以无法自行恢复。";
		next;
		mes "[Mainz]";
		mes "例外是，修罗可以使用<^0022FF温柔治愈^000000>技能恢复。";
		next;
		mes "[Mainz]";
		mes "可以使用服事的<^0022FF恢复^000000>或大主教的<^0022FF赞美拉穆斯^000000>等技能恢复。";
		next;
		mes "[Mainz]";
		mes "让我展示一下处于眩晕状态时会发生什么！";
		next;
		sc_start SC_STUN, 30000, 0;
		mes "<^FF0000眩晕^000000>。";
		next;
		mes "[Mainz]";
		mes "......";
		next;
		sc_end SC_STUN;
		mes "[Mainz]";
		mes "感觉怎么样？";
		mes "无法移动时是不是觉得很压抑？";
		next;
		mes "[Mainz]";
		mes "想象自己处于那种状态，而怪物正向你冲来……";
		mes "相信我，这种事会发生。";
		emotion ET_KEK;
		next;
		mes "[Mainz]";
		mes "这次我要介绍<^FF0000睡眠^000000>。";
		next;
		mes "[Mainz]";
		mes "处于睡眠状态时，你会睡着，头顶出现 <Zzz>。";
		next;
		mes "[Mainz]";
		mes "和眩晕状态一样，你会毫无防备；不同之处在于，受到敌人攻击后可以恢复。";
		next;
		mes "[Mainz]";
		mes "但在睡眠状态下，被敌人‘暴击’的概率会提高，你会陷入危险并受到严重伤害。";
		next;
		mes "[Mainz]";
		mes "请注意，你无法自行恢复，只能使用服事的<^0022FF恢复^000000>技能。";
		next;
		mes "[Mainz]";
		mes "让我展示一下处于睡眠状态时会发生什么。";
		next;
		sc_start SC_SLEEP, 30000, 0;
		mes "<^FF0000睡眠^000000>。";
		next;
		mes "[Mainz]";
		mes "......";
		next;
		sc_end SC_SLEEP;
		mes "[Mainz]";
		mes "感觉怎么样？想象自己在危险敌人面前睡着，可不好玩吧？";
		next;
		mes "[Mainz]";
		mes "睡眠有助于恢复，但在战斗中不一定是好事。";
		emotion ET_SPARK;
		next;
		mes "[Mainz]";
		mes "最后，我来介绍<^FF0000沉默^000000>。";
		next;
		mes "[Mainz]";
		mes "处于沉默状态时，你无法使用魔法技能，头顶会出现 <……>。";
		next;
		mes "[Mainz]";
		mes "但并非所有攻击都无法进行。沉默时仍可进行普通攻击。";
		next;
		mes "[Mainz]";
		mes "在沉默状态下，你只能进行物理攻击，或使用药水恢复。";
		next;
		mes "[Mainz]";
		mes "可以使用<^0022FF绿色药草^000000>、<^0022FF绿色药水^000000>、<^0022FF万能药^000000>和<^0022FF蜂王浆^000000>等道具恢复。";
		next;
		mes "[Mainz]";
		mes "让我展示一下处于沉默状态时会发生什么。";
		next;
		sc_start SC_SILENCE, 30000, 0;
		mes "<^FF0000沉默^000000>";
		next;
		mes "[Mainz]";
		mes "......";
		next;
		sc_end SC_SILENCE;
		mes "[Mainz]";
		mes "无法使用技能很令人沮丧，对吧？";
		next;
		mes "[Mainz]";
		mes "尤其是依赖技能而非物理攻击的高级职业，在战斗中陷入沉默会受到严重伤害。";
		next;
		mes "[Mainz]";
		mes "此外还有黑暗、冰冻、诅咒、石化、混乱等状态，但我可以让你体验所有这些状态。";
		next;
		mes "[Mainz]";
		mes "希望这些体验能帮助你了解今后在外面会遇到的情况。";
		next;
		mes "[Mainz]";
		mes "想体验异常状态时，请来找我。";
		next;
		mes "[Mainz]";
		mes "作为饭盒事件的赔礼，我会送你一份小礼物。";
		next;
		mes "[Mainz]";
		mes "祝你冒险好运！";
		completequest 15000;
		getitem 512,10;// Apple
		getexp 180,100;
		close;
	} else if (isbegin_quest(4269) && !isbegin_quest(15000)) {
		mes "[Mainz]";
		mes "嘿，说你呢！";
		mes "你是来接受训练的初心者吗？";
		emotion ET_SPARK;
		next;
		mes "[Mainz]";
		mes "我是迈因兹训练师，负责这所学院的教育。";
		next;
		mes "[Mainz]";
		mes "哪门课程？";
		mes "这不重要，我之后会告诉你。";
		next;
		mes "[Mainz]";
		mes "读了这么多、学了这么多，你一定很累了吧？";
		next;
		mes "[Mainz]";
		mes "当然，你确实很累……哦，可怜的孩子。";
		next;
		mes "[Mainz]";
		mes "需要帮助时，有个人可以帮助你。";
		mes "你知道是谁吗？";
		next;
		mes "[Mainz]";
		mes "就是我！";
		next;
		mes "[Mainz]";
		mes "什么意思？";
		mes "意思是我专门为疲惫的你准备了一份特别礼物！";
		next;
		mes "[Mainz]";

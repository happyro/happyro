	if (lasagna_quest[1] == 6)
		specialeffect EF_LOCKON;
	end;
}

// Tali's quest
lasagna,77,263,5	script	Tali#lasa	4_DR_F_02,{
	if (lasagna_quest[1] < 9 || lasagna_quest[1] > 11) {
		mes "[Tali]";
		mes "我得赶紧完成，然后去港口见他！";
		mes "呜啊！";
		close;
	}
	if (lasagna_quest[1] == 9) {
		mes "[Tali]";
		mes "你想做什么？";
		next;
		mes "[Tali]";
		mes "哦！是首领派你来的吗？";
		next;
		mes "[Tali]";
		mes "来！";
		mes "到这边来。";
		next;
		mes "[Tali]";
		mes "嗯……嗯……嗯！好！";
		next;
		mes "[Tali]";
		mes "你去过意大利面森林，对吧？";
		mes "就是这里东边的那片森林。";
		next;
		mes "[Tali]";
		mes "去教训那里的甜罗达青蛙，并把“华丽布料”带给我。";
		next;
		mes "[Tali]";
		mes "让我看看……嗯嗯……嗯……";
		mes "嗯……两个应该够了。";
		erasequest 11443;
		setquest 11444;
		lasagna_quest[1] = 10;
		close;
	}
	if (lasagna_quest[1] == 10) {
		if (countitem(25045) < 2) {
			mes "[Tali]";
			mes "你去过意大利面森林，对吧？";
			mes "就是这里东边的那片森林。";
			next;
			mes "[Tali]";
			mes "去教训那里的甜罗达青蛙，并把“华丽布料”带给我。";
			next;
			mes "[Tali]";
			mes "让我看看……嗯嗯……嗯……";
			mes "嗯……两个应该够了。";
			close;
		}
		mes "[Tali]";
		mes "嗯……";
		mes "你带来的品质不错。";
		delitem 25045,2;// Luxurious Cloth
		erasequest 11444;
		setquest 11445;
		lasagna_quest[1] = 11;
		next;
		mes "[Tali]";
		mes "......";
		next;
		mes "[Tali]";
		mes ".........";
		next;
		mes "[Tali]";
		mes "..................";
		next;
		mes "[Tali]";
		mes "你为什么一直看着我？";
		next;
		mes "[Tali]";
		mes ".........";
		next;
		mes "[Tali]";
		mes "我要用这些做领结。";
		mes "这不算特别重要，但它代表着治安队的标志……";
		next;
		mes "[Tali]";
		mes "领结做好后，会绣上你的名字，挂在治安队办公室的墙上。";
		mes "这就像治安队成员名册。";
		next;
		mes "[Tali]";
		mes "你叫什么名字？";
		next;
		mes "[Tali]";
		mes "" + strcharinfo(0) + "... 真是个好名字。";
		mes "绣名字需要一些时间。";
		mes "完成后我会拿给首领，所以你可以先走了。";
		close;
	}
	if (lasagna_quest[1] == 11) {
		mes "[Tali]";
		mes "绣名字需要一些时间。";
		mes "完成后我会拿给首领，所以你可以先走了。";
		close;
	}
}

lasagna,205,325,5	script	Eggling#dorcon	4_M_MERCAT1,2,2,{
	if (checkweight(1001,1) == 0) {
		mes "[Eggling]";
		mes "看起来太多太大了。删减一些怎么样？";
		close;
	}
	if (lasagna_quest[1] > 0 && lasagna_quest[1] < 12) {
		mes "[Eggling]";
		mes "你不是正在治安队接受训练吗？训练没完成怎么能上船？回去完成训练！";
		close;
	}
	if (lasagna_quest[1] == 12) {
		if (countitem(25046) < 1) {// Boarding Pass
			mes "[Eggling]";
			mes "票。";
			next;
			mes "[" + strcharinfo(0) + "]";
			mes "票？";
			next;
			mes "[Eggling]";
			mes "你没有^0000cd登船许可^000000吗？上船需要它！振作起来！回去拿一张！";
			close;
		}
		if (Class != Job_Summoner) {
			mes "[Eggling]";
			mes "票。";
			next;
			mes "[Eggling]";
			mes "你要上船吗？";
			next;
			if (select( "你在船上有事要办。", "离开。" ) == 2) {
				mes "[Eggling]";
			mes "那就这样吧。";
				close;
			}
			mes "[Eggling]";
			mes "现在上船吧。第一次乘船的话，去见事务长并听取登船说明。";
			delitem 25046,1;// Boarding Pass
			setquest 14545;// To Purser
			completequest 14545;
			setquest 14531;// Everything about Con-Chliina
			lasagna_quest[1] = 13;
			close2;
			warp "conch_in",58,61;
			end;
		}
		mes "[Eggling]";
		mes "票。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "给……";
		next;
		mes "[Eggling]";
		mes "嘿，冒险者！这是你第一次航行吗？";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "是的。";
		next;
		mes "[Eggling]";
		mes "那么，可别给杜拉姆的名声蒙羞，好吗？不过既然你在这里接受过训练，无论身在何处都能发挥作用。祝你好运。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "谢谢。";
		next;
		mes "[Eggling]";
		mes "哦，我想拜托你一件事。能把它交给^0000cd副厨师长^000000吗？你以后还会偶尔乘坐这艘船，对吧？";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "是的。";
		next;
		mes "[Eggling]";
		mes "嗯，嗯。看来你知道这里的规矩。你可以把它交给副厨师长。不过副厨师长有点古怪，交给他时必须说点什么。";
		next;
		mes "[Eggling]";
		mes "你应该把这个扔给他，并说：^0000cd[新手来了！]^000000。他认为杜拉姆第一次航行时应该这样说，才能带来好运。总之，他似乎认定这才是正确的做法。";
		next;
		mes "[Eggling]";
		mes "你明白我的意思吧？";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "是的。";
		next;
		mes "[Eggling]";
		mes "你理解得真快，我喜欢。对了，你叫什么名字？哈哈……";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "我叫" + strcharinfo(0) + "。";
		next;
		mes "[Eggling]";
		mes "原来如此。以后遇到时记得打招呼。把东西交给副厨师长时，务必按我的指示做，明白吗？";
		next;
		mes "[Eggling]";
		mes "有什么想知道的，尽管来找我。上船后记得向^0000cd事务长^000000打招呼。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "好的，谢谢。";
		next;
		mes "[Eggling]";
		mes "好，现在上船吧。";
		delitem 25046,1;// Boarding Pass
		setquest 14531;// Everything about Con-Chliina
		setquest 14545;// To Purser
		completequest 14545;
		getitem 25047,1;// Kahlunac
		lasagna_quest[1] = 13;
		close2;
		warp "conch_in",58,61;
		end;
	}
	callsub S_quest21;
	if (lasagna_quest[1] >= 22 && lasagna_quest[1] < 27) {
		if (Class == Job_Summoner) {
			mes "[Eggling]";
			mes "你这么快就回来了吗？任务怎么样了？";
			next;
			mes "[Eggling]";
			mes "完成任务后再回来！";
			close;
		}
	}
	if (lasagna_quest[1] == 27) {
		if (Class != Job_Summoner) {
			mes "[Eggling]";
			mes "正是时候。雾已经散了，我们很快就能出发。";
			lasagna_quest[1] = 28;
			next;
			// warp in
		}
		else {
			mes "[Eggling]";
			mes "哇，这个小子居然死不了，还回来了。";
			next;
			mes "[" + strcharinfo(0) + "]";
			mes "你想让我死吗？";
			next;
			mes "[Eggling]";
			mes "不是。你不知道吗？这是最近热门歌曲的歌词。拜托，别表现得像来自乡下似的，别人会怎么看我们？总之，你该带来的东西呢？带来了吗？";
			next;
			if (countitem(25049) < 3) {
				mes "[" + strcharinfo(0) + "]";
				mes "还没有。你要多少？";
				next;
				mes "[Eggling]";
				mes "真笨……我叫你带^0000cd3个^000000。我说过是 3 个！可以从^0000cd蛇女^000000那里获得。还要我说多少遍？我觉得我都说了 100 遍了！";
				next;
				mes "[Eggling]";
				mes "在把它带给我之前，你别想上船！";
				close;
			}
			mes "[" + strcharinfo(0) + "]";
			mes "给你。是蛇岩贝。";
			next;
			mes "[Eggling]";
			mes "哈，你挺能干嘛。要不要放弃冒险，来当我的徒弟？我会好好待你的。";
			next;
			mes "[" + strcharinfo(0) + "]";
			mes "我只能拒绝。我可不想永远当个小水手。";
			next;
			mes "[Eggling]";
			mes "什么？你说什么？小水手？嘿！我可不只是小水手，而是负责处理康奇利纳各种杂事的无价之宝！没有我这艘船根本开不了！";
			next;
			mes "[" + strcharinfo(0) + "]";
			mes "哦，我明白了。请原谅我。";
			next;
			mes "[Eggling]";
			mes "你差点把我气疯了。";
			next;
			mes "[" + strcharinfo(0) + "]";
			mes "哦，我明白了。对不起。";
			next;
			mes "[Eggling]";
			mes "不管怎样，谢谢你。我本来没指望你真的带来。我没别的东西可以给你了。外面的世界很危险，拿着这个吧。";
			next;
			mes "[" + strcharinfo(0) + "]";
			mes "鳀鱼？";
			next;
			mes "[Eggling]";
			mes "你知道，拉萨格纳的鳀鱼是最棒的。在外面有钱也买不到。既然我送给你，就收下吧。把你所有的蛇岩贝都给我。";
			next;
			mes "[" + strcharinfo(0) + "]";
			mes "哦，我明白了。谢谢。";
			next;
			mes "[Eggling]";
			mes "进去吧。";
			erasequest 14540;// An errand out of nowhere
			delitem 25049, countitem(25049);// Basilac Clam
			getitem 11601,10;// Delicious Anchovy
			getexp 300,300;
			lasagna_quest[1] = 28;
			close2;
			warp "conch_in",58,61;
			end;
		}
	}
	if (lasagna_quest[1] == 28) {
		mes "[Eggling]";
		mes "哇，这个小子居然死不了，还回来了。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "你想让我死吗？";
		next;
		mes "[Eggling]";
		mes "不是。你不知道吗？这是最近热门歌曲的歌词。拜托，别表现得像来自乡下似的，别人会怎么看我们？";
		next;
		mes "[Eggling]";
		mes "进去吧。";
		close2;
		warp "conch_in",58,61;
		end;
	}
	if (lasagna_quest[1] == 0) {
		mes "[Eggling]";
		mes "你要上^0000cd船^000000吗？";
		if (Class != Job_Summoner)
			.@cost = 2000;
		else
			.@cost = 200;
		.@menu$[0] = "上船";
	}
	else {
		if (Class != Job_Summoner) {
			mes "[Eggling]";
			mes "你要上^0000cd船^000000吗？";
			.@cost = 2000;
			if (lasagna_quest[1] >= 21 && lasagna_quest[1] < 27)
				.@menu$[0] = "你在船上有事要办。";
			else
				.@menu$[0] = "上船";
		}
		else {
			mes "[Eggling]";
			mes "你这个小子，要上船吗？";
			.@cost = 200;
			.@menu$[0] = "上船";
		}
	}
	next;
	if (lasagna_quest[1] == 0 || lasagna_quest[1] >= 29) {
		.@menu$[1] = "前往依斯鲁得 - " + .@cost + "z";
		.@menu$[2] = "前往马兰岛 - " + .@cost + "z";
		mes "[Eggling]";
		mes "还是要前往新大陆的^0000cd依斯鲁得^000000或^0000cd马兰岛^000000？";
		mes "无论去哪里，都要花费^0000cd" + .@cost + " Zeny^000000。";
		next;
	}
	switch( select( .@menu$[0], .@menu$[1], .@menu$[2], "取消" ) ) {
	case 1:
		mes "[Eggling]";
	mes "进去吧。";
		close2;
		warp "conch_in",58,61;
		end;
	case 2:
		if (Zeny < .@cost) {
			mes "[Eggling]";
			mes "你的钱不够。再检查一下吧。";
			close;
		}
		warp "izlude",193,209;
		end;
	case 3:
		if (Zeny < .@cost) {
			mes "[Eggling]";
			mes "你的钱不够。再检查一下吧。";
			close;
		}
		warp "malangdo",213,110;
		end;
	case 4:
		mes "[Eggling]";
		mes "那就这样吧。";
		close;
	}

S_quest21:
	if (lasagna_quest[1] == 21 && Class == Job_Summoner) {
		mes "[Eggling]";
		mes "嘿，你过来。你真的因为我叫你这样做，就把它扔给副厨师长了吗？";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "我只是照你说的做了。";
		next;
		mes "[Eggling]";
		mes "哈！你怎么敢？我说什么你就做什么，真的吗？真是个笨蛋！你这蠢货，留胡子是为了赶时髦吗？你知道我因为你惹上了什么麻烦吗？我还因为你挨骂了！";
		next;
		mes "[Eggling]";
		mes "够了。既然你看起来很抱歉，只要带一个^0000cd蛇岩贝^000000来，我就原谅你。我可是很慷慨的。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "我为什么要……？";
		next;
		mes "[Eggling]";
		mes "你真的想让自己经历人生中最糟糕的航行吗？";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "蛇岩贝是什么？";
		npctalk "这才像话。", "", bc_self;
		next;
		mes "[Eggling]";
		mes "没人知道它是什么。不过所有水手都有。你别再问了，现在就去拿。我给你 10 秒。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "想把它带回来，总得知道去哪里拿。我要去哪里拿？";
		next;
		mes "[Eggling]";
		mes "离开村子后，田地最右边有个洞穴，里面住着令人讨厌的^0000cd蛇女^000000。你可以从它们那里拿到。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "我正好要去那里，能拿到的话就帮你带一些回来。不过我的任务优先。你不会指望我在完成船长交给我的任务前先处理这个吧？";
		next;
		mes "[Eggling]";
		mes "嗯……我不是那个意思……哼……10 秒已经过去了。给我带^0000cd3 个蛇岩贝^000000，一个都不能少。别让任何人知道。要是告诉别人，我会让你后悔。";
		if (isbegin_quest(14540) == 0)
			setquest 14540;// An errand out of nowhere
		close;
	}
	return;

OnTouch:
	callsub S_quest21;
	end;
OnInit:
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "!isbegin_quest(14545)" );
	end;
}

// hall
conch_in,65,58,3	script	Purser#dorcon	4_CAT_ADV1,{
	if (lasagna_quest[1] == 13) {
		if (Class != Job_Summoner) {
			mes "[Purser]";
			mes "欢迎登船。欢迎来到^0000cd康奇利纳^000000。我们会安全地把你送到目的地。不过现在还不能立即出航。";
			npctalk "不过现在还不能立即出航。", "", bc_self;
			next;
			mes "[" + strcharinfo(0) + "]";
			mes "发生什么事了？";
			next;
			mes "[Purser]";
			mes "看看外面的拉萨格纳。";
			npctalk "那里，就在那边。", "", bc_self;
			next;
			mes "[" + strcharinfo(0) + "]";
			mes "我什么也看不见。";
			next;
			mes "[Purser]";
			mes "没错，你什么也看不见。这里有^0000cd浓雾^000000。也不知道现在能不能出发。";
			npctalk "这里有浓雾，不知道能不能出发。", "", bc_self;
			next;
			mes "[" + strcharinfo(0) + "]";
			mes "我赶时间。";
			next;
			mes "[Purser]";
			mes "如果你赶时间，就去见^0000cd船长和大副^000000。是否出航由他们决定。他们在上面的船长室里。";
			npctalk "船长室就在我们前方上面。", "", bc_self;
			erasequest 14531;// Everything about Con-Chliina
			setquest 14547;// Can we set out the sailing?
			lasagna_quest[1] = 14;
			close;
		}
		mes "[Purser]";
		mes "我闻到了什么。是新人的气味……";
		mes "你是？";
		npctalk "告诉我你的名字。", "", bc_self;
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "呃，我叫" + strcharinfo(0) + "。";
		next;
		mes "[Purser]";
		mes "哦，对了。我在名单上看到了你的名字。" + strcharinfo(0) + "。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "是的……很高兴见到你。";
		next;
		mes "[Purser]";
		mes "不用紧张。我相信你已经接受了足够的训练，现在没什么需要做的。去熟悉一下船员和他们的名字吧？";
		npctalk "我感觉以后会经常见到你。", "", bc_self;
		next;
		mes "[Purser]";
		mes "到了一个谁都不认识的地方，同乡杜拉姆可能会成为你最好的朋友。所以我建议你现在尽量多认识一些人。";
		npctalk "同乡杜拉姆可以成为你最好的朋友。", "", bc_self;
		next;
		mes "[Purser]";
		mes "这艘船上除了船长还有 12 位分队长，其他船员也很多。你不必全部认识，先认识重要的人就好。";
		next;
		mes "[Purser]";
		mes "有些人会在船出航前才出现，所以现在先去认识能见到的人吧。首先，你应该去见船长。";
		next;
		mes "[Purser]";
		mes "^0000cd船长室^000000就在那边。船长很重视礼节和礼貌，千万别出错。";
		npctalk "船长室就在楼梯上方。", "", bc_self;
		erasequest 14531;// Everything about Con-Chliina
		setquest 14532;// Greetings to Captain Gamberi
		getexp 200,300;
		lasagna_quest[1] = 14;
		close;
	}

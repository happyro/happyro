//===== rAthena Script =======================================
//= 斐扬 怪物赛s
//===== By: ==================================================
//= L0ne_W0lf
//===== Current Version: =====================================
//= 2.0
//===== Compatible With: =====================================
//= rAthena Project; SVN r12752+
//===== Description: =========================================
//= [Official Conversion]
//= - 斐扬 怪物赛s (Single and Double)
//= - 奖牌 Exchanging, and Monster Track NPCs.
//= - Contains both euRO and iRO dialog.
//===== Additional Comments: =================================
//= 1.0 First version. Please report bugs. [L0ne_W0lf]
//= 1.1 Corrected a minor typo. [L0ne_W0lf]
//= 1.2 Replaced effect numerics with constants. [L0ne_W0lf]
//= 1.3 Ei'felle now gives Exercise. (Bugreport:4092) [L0ne_W0lf]
//= 1.4 Fixed call to a non-existant event. [L0ne_W0lf]
//= 1.5 Updated Dialog. [L0ne_W0lf]
//= 1.6 Updated experience rewards. [L0ne_W0lf]
//= 1.7 Optimization, -4000 lines (more can still be done). [Euphy]
//= 1.8 Optimized.
//=     Fixed 奖牌兑换员 (Dual Race) disappears accordingly. [Joseph] 
//= 1.9 Updated RE/Pre-RE EXP. [Euphy]
//= 2.0 Added GM management NPC. [Euphy]
//= 2.1 Fixed prize in dual race and optimization. [Capuche]
//============================================================

// 怪物赛 - 单人怪物赛
//============================================================
hugel,51,61,0	script	#race_timer1-1	-1,{
OnEnable:
	enablenpc "#race_timer1-1";
OnInit:
	$@mon_time_1_1 = 2;
	initnpctimer;
	end;

OnTimer10000:
	mapannounce "hugel","单人怪物赛即将开始，欢迎大家踊跃参加！",bc_map,"0x87ceeb";
	end;
OnTimer30000:
	mapannounce "hugel","单人怪物赛场入口已开放。",bc_map,"0x87ceeb";
	$@mon_time_1_1 = 1;
	donpcevent "Race Progress Timer::OnEnable";
	end;
OnTimer90000:
	mapannounce "hugel","单人怪物赛场已开放，请参赛者尽快进入。",bc_map,"0x87ceeb";
	end;
OnTimer210000:
	mapannounce "hugel","单人怪物赛场入口即将关闭，请参赛者现在入场。",bc_map,"0x87ceeb";
	end;
OnTimer270000:
	mapannounce "hugel","单人怪物赛场入口即将关闭。",bc_map,"0x87ceeb";
	end;
OnTimer272000:
	mapannounce "hugel","请在入口关闭前进入赛场。",bc_map,"0x87ceeb";
	end;
OnTimer330000:
	mapannounce "hugel","比赛现在开始。错过本次机会的玩家请下次再来～！",bc_map,"0x87ceeb";
	$@mon_time_1_1 = 0;
	disablenpc "#race_timer1-1";
	stopnpctimer;
	end;
}

p_track01,58,0,0	script	Race Progress Timer	-1,{
OnEnable:
	initnpctimer;
	enablenpc "Race Progress Timer";
	for ( .@c = 1; .@c < 7; .@c++ ) {
		.@line = rand(1,70);
		enablenpc "starting#"+.@c;
		enablenpc "Tire"+.@c+"#1";
		if ( .@line <= 10 ) {
			.@tired = rand(50,60);
			enablenpc "Luk"+.@c+"#5";
			enablenpc "Luk"+.@c+"#6";
		} else if ( .@line <= 30 ) {
			.@tired = rand(40,60);
			enablenpc "Luk"+.@c+"#5";
			if (.@tired >= 50) enablenpc "Tire"+.@c+"#2";
		} else if ( .@line <= 40 ) {
			.@tired = rand(30,50);
			enablenpc "Luk"+.@c+"#1";
			enablenpc "Tire"+.@c+"#2";
			if ( .@tired < 40 ) enablenpc "Tire"+.@c+"#3";
		} else if (.@line <= 50) {
			.@tired = rand(20,40);
			enablenpc "Luk"+.@c+"#1";
			enablenpc "Luk"+.@c+"#2";
			enablenpc "Tire"+.@c+"#2";
			enablenpc "Tire"+.@c+"#3";
			if (.@tired < 30) enablenpc "Tire"+.@c+"#4";
		} else if (.@line <= 60) {
			.@tired = rand(10,30);
			for ( .@i = 1; .@i <= 3; .@i++ )
				enablenpc "Luk"+.@c+"#"+.@i;
			for ( .@i = 2; .@i <= 4; .@i++ )
				enablenpc "Tire"+.@c+"#"+.@i;
			if ( .@tired < 20) enablenpc "Tire"+.@c+"#5";
		} else if (.@line <= 70) {
			.@tired = rand(0,20);
			for ( .@i = 1; .@i <= 4; .@i++ )
				enablenpc "Luk"+.@c+"#"+.@i;
			for ( .@i = 2; .@i <= 5; .@i++ )
				enablenpc "Tire"+.@c+"#"+.@i;
			if (.@tired < 10) enablenpc "Tire"+.@c+"#6";
		}
		setd "$@mr_1_luk"+.@c, .@line;
		setd "$@mr_1_tire"+.@c, .@tired;
	}
	end;
OnTimer1000:
	enablenpc "售票员#single";
	end;
OnTimer7000:
	mapannounce "p_track01","欢迎来到怪物赛场。",bc_map,"0xffb6c1";
	end;
OnTimer10000:
	mapannounce "p_track01","如有疑问，欢迎随时向服务台咨询。",bc_map,"0xffb6c1";
	end;
OnTimer120000:
	mapannounce "p_track01","单人怪物赛将在 3 分钟后开始。",bc_map,"0xffb6c1";
	end;
OnTimer123000:
	mapannounce "p_track01","如需下注，请向售票员咨询。",bc_map,"0xffb6c1";
	end;
OnTimer240000:
	mapannounce "p_track01","单人怪物赛即将开始。",bc_map,"0xffb6c1";
	end;
OnTimer243000:
	mapannounce "p_track01","如需下注，请向售票员咨询。",bc_map,"0xffb6c1";
	end;
OnTimer300000:
	mapannounce "p_track01","怪物赛已经开始。祝各位参赛者好运。",bc_map,"0xffb6c1";
	$@monster_race = 0;
	disablenpc "售票员#single";
	for ( .@i = 1; .@i <= 6; .@i++ )
		donpcevent "Runner No. "+.@i+"#"+.@i+"::OnEnable";
	stopnpctimer;
	end;

OnDisable:
OnInit:
	disablenpc "Race Progress Timer";
	end;
}

p_track01,73,22,1	script	售票员#single	899,{
	mes "[售票员]";
	mes "欢迎来到";
	mes "怪物赛 Arena.";
	mes "如果你想参加";
	mes "参加 ^3131FF单人怪物赛^000000，";
	mes "请从列表中选择 1 只";
	mes "怪物（共 6 只）。";
	next;
	if (!checkweight("Spawn",200)) {
		mes "[售票员]";
		mes "等等……";
		mes "我现在不能给你";
		mes "任何东西。";
		mes "你携带的物品";
		mes "太多了……";
		close;
	}
	.@m = select ("Monster Status", "Monster 1", "Monster 2", "Monster 3", "Monster 4", "Monster 5", "Monster 6") - 1;
	if (.@m == 0) {
		for ( .@i = 1; .@i <= 6; .@i++ )
			mes "怪物 "+.@i+" [^CC6600幸运^000000：" + getd("$@mr_1_luk"+.@i) + "] [^EE0000HP^000000：" + getd("$@mr_1_tire"+.@i) + "]";
		close;
	} else {
		if ($@mon_time_1_1 == 1) {
			if (monster_race_1) {
				mes "[售票员]";
				mes "你选择了";
				mes "怪物 ^FF0000"+ monster_race_1 +"^000000 参加单人怪物赛。";
				mes "单人怪物赛.";
				mes "比赛开始时间";
				mes "很快会公布，";
				mes "请耐心等待，谢谢。";
				close;
			}
			mes "[售票员]";
			mes "你选择了怪物 "+.@m+"吗？";
			mes "好的，请等待";
			mes "比赛开始公告。";
			mes "如果你选择的怪物";
			mes "获胜，请使用这张券兑换奖励。";
			getitem 7514,1; //Monster_Ticket
			monster_race_1 = .@m;
			close;
		}
		mes "[售票员]";
		mes "抱歉，怪物赛";
		mes "正在进行中。";
		mes "如果你想参加, then please wait 参加 next race.";
		close;
	}

OnInit:
	disablenpc "售票员#single";
	end;
}

-	script	Runner_main	-1,{
OnEnable:
	emotion ET_SURPRISE;
	enablenpc();
	getmapxy(.@m$,.@x,.@y,BL_NPC);
	setarray .@mob[1], 1725,1726,1727,1728,1730,1729;
	.@n = atoi( strnpcinfo(2) );
	monster "p_track01",58,.@y,"The "+ callfunc("F_GetNumSuffix",.@n) +" Racer",.@mob[.@n],1,strnpcinfo(0)+"::OnMyMobDead";
	end;

OnDisable:
	disablenpc();
	killmonster "p_track01",strnpcinfo(0)+"::OnMyMobDead";
	end;

OnTouchNPC:
	.@n = atoi( strnpcinfo(2) );
	$@monster_race = .@n;
	for ( .@i = 1; .@i <= 6; .@i++ ) {
		if (.@n == .@i) continue;
		donpcevent "Runner No. "+.@i+"#"+.@i+"::OnDisable";
	}
	sleep 1000;
	mapannounce "p_track01","胜者诞生了……！",bc_map,"0x33FF66";
	sleep 1000;
	mapannounce "p_track01","怪物 "+.@n+" 赢得了本场比赛！",bc_map,"0x33FF66";
	sleep 4000;
	mapannounce "p_track01","如果你下注的怪物 "+.@n+" 获胜，请向奖牌兑换员领取奖励！",bc_map,"0x33FF66";
	sleep 2000;
	mapannounce "p_track01","请注意，每场比赛结束后只有 5 分钟可以领取奖牌。",bc_map,"0x33FF66";
	sleep 1000;
	donpcevent "奖牌兑换员#single::OnEnable";
	donpcevent strnpcinfo(0)+"::OnDisable";
	killmonster "p_track01",strnpcinfo(0)+"::OnMyMobDead";
	end;
	
OnInit:
	if (strnpcinfo(2) != "" )
		disablenpc();
	end;
}
p_track01,30,38,0	duplicate(Runner_main)	Runner No. 1#1	-1,1,0
p_track01,30,36,0	duplicate(Runner_main)	Runner No. 2#2	-1,1,0
p_track01,30,34,0	duplicate(Runner_main)	Runner No. 3#3	-1,1,0
p_track01,30,32,0	duplicate(Runner_main)	Runner No. 4#4	-1,1,0
p_track01,30,30,0	duplicate(Runner_main)	Runner No. 5#5	-1,1,0
p_track01,30,28,0	duplicate(Runner_main)	Runner No. 6#6	-1,1,0

p_track01,67,45,5	script	奖牌兑换员#single	845,{
	if (!checkweight("Spawn",200)) {
		mes "[奖牌兑换员]";
		mes "抱歉，我不能";
		mes "给你奖牌，";
		mes "请先腾出更多";
		mes "背包空间。";
		close;
	}
	if (countitem("Monster_Ticket")) {// 7514
		mes "[奖牌兑换员]";
		mes "你好～";
		mes "如果你在最近的比赛中下注了";
		mes "获胜怪物，";
		mes "就可以在这里用比赛券兑换";
		mes "你的比赛券，换取";
		mes "一些奖牌。";
		next;
		mes "[奖牌兑换员]";
		mes "请记住，你只能";
		mes "在比赛结束后立即用获胜的";
		mes "比赛券兑换奖牌只能在比赛";
		mes "奖牌还可以交给斐扬的 Wayne";
		mes "兑换物品。";
		mes "结束后立即进行，奖牌可在斐扬兑换物品。";
		next; 
		if ($@monster_race) {
			if (monster_race_1 == $@monster_race) {
				mes "[奖牌兑换员]";
				mes "哦，恭喜你，";
				mes "你持有获胜的";
				mes "单人怪物赛券！那么";
				mes "你想兑换你的";
				mes "要用赛跑券兑换奖牌吗？";
				next;
				if (select("好的，请兑换。:不用了，谢谢。") == 2) {
					mes "[奖牌兑换员]";
					mes "嗯，你确定吗？你";
					mes "只能兑换获胜的";
				mes "赛跑券兑换奖牌";
					mes "比赛券，而且时间很短。如果弄错了，";
					mes "请尽快重新询问我。";
					close;
				}
				mes "[奖牌兑换员]";
				mes "让我看看你的赛跑券……";
				mes "哦！恭喜你，";
				mes "你赢了！可以告诉我名字吗？";
				next;
				input .@input$;
				if (.@input$ == strcharinfo(0)) {
					.@insa = rand(1,1000);
					mes "[奖牌兑换员]";
					mes "啊，"+strcharinfo(0)+"。";
					mes "你可以用这张";
					mes "赛跑券兑换奖牌，";
					mes "现在请输入赛跑券兑换";
					mes "号码。你的兑换号码是";
					mes "^FF0000" + .@insa + "^000000。";
					next;
					input .@input;
					if (!.@input) {
						mes "[奖牌兑换员]";
						mes "哦？你不想";
						mes "兑换你的";
						mes "获胜赛跑券吗？";
						close;
					} else if (.@input == .@insa) {
						mes "[奖牌兑换员]";
						mes "谢谢！你输入了";
						mes "正确的号码……";
						mes "一切看起来都";
						mes "没问题。好了！";
						next;
						mes "[奖牌兑换员]";
						mes "现在请收下你的";
						mes "奖牌! You can";
						mes "你可以用它们向";
						mes "斐扬的 Wayne 兑换一些";
						mes "兑换有趣的物品。谢谢～";
						delitem 7514,1; //Monster_Ticket
						monster_race_1 = 0;
						getitem 7515,4; //Marvelous_Medal
						close;
					}
					mes "[奖牌兑换员]";
					mes "抱歉，看来";
					mes "你输入了";
					mes "错误的赛跑券号码。";
					mes "过一会儿再";
					mes "回来可以吗？";
					close;
				}
				mes "[奖牌兑换员]";
				mes "这是什么……？";
				mes "好像出了问题……";
				mes "你是不是输入了错误的名字？";
				mes "请检查你的名字，";
				mes "然后再试一次。";
				close;
			}
			mes "[奖牌兑换员]";
			mes "你可能没有下注";
			mes "上一场比赛的获胜怪物，";
			mes "但希望你";
			mes "下次好运～";
			close;
		}
	}
	mes "[奖牌兑换员]";
	mes "你好～";
	mes "如果你在最近的比赛中下注了";
	mes "获胜怪物，";
	mes "就可以在这里用比赛券兑换";
	mes "你的比赛券，换取";
	mes "一些奖牌。";
	next;
	mes "[奖牌兑换员]";
	mes "请记住，你只能";
	mes "在比赛结束后立即用获胜的";
	mes "比赛券兑换奖牌只能在比赛";
	mes "奖牌还可以交给斐扬的 Wayne";
	mes "兑换物品。";
	mes "结束后立即进行，奖牌可在斐扬兑换物品。";
	close;

OnEnable:
	enablenpc "奖牌兑换员#single";
	emotion ET_SURPRISE;
	initnpctimer;
	end;

OnTimer1000:
	mapannounce "p_track01","怪物赛结束！恭喜所有获胜者！",bc_map,"0xFFFF00";
	end;
OnTimer4000:
	mapannounce "p_track01","如果你下注了获胜怪物，请将赛跑券交给奖牌兑换员。",bc_map,"0xFFFF00";
	end;
OnTimer7000:
	mapannounce "p_track01","你有 5 分钟向奖牌兑换员兑换获胜券。",bc_map,"0xFFFF00";
	end;
OnTimer10000:
	mapannounce "p_track01","5 分钟后所有赛跑券失效，请获胜者立即领取奖励。",bc_map,"0xFFFF00";
	end;
OnTimer13000:
	mapannounce "p_track01","请在 5 分钟结束前离开赛场，谢谢。",bc_map,"0xFFFF00";
	end;
OnTimer240000:
	mapannounce "p_track01","注意，我们很快将准备下一场比赛……",bc_map,"0xFFFF00";
	end;
OnTimer243000:
	mapannounce "p_track01","我们将在 1 分钟后关闭赛场以准备下一场比赛。",bc_map,"0xFFFF00";
	end;
OnTimer246000:
	mapannounce "p_track01","上一场比赛的参赛者请尽快离开赛场。",bc_map,"0xFFFF00";
	end;
OnTimer249000:
	mapannounce "p_track01","感谢你的配合。",bc_map,"0xFFFF00";
	end;
OnTimer252000:
	mapannounce "p_track01","希望你喜欢怪物赛场，欢迎下次再来～",bc_map,"0xFFFF00";
	$@mr_1_luk1 = $@mr_1_tire1 = 0;
	for ( .@i = 1; .@i <= 6; .@i++ ) {
		for ( .@j = 1; .@j <= 6; .@j++ ) {
			disablenpc "Tire"+.@i+"#"+.@j;
			disablenpc "Luk"+.@i+"#"+.@j;
		}
		enablenpc "Luk1#"+.@i;
		enablenpc "Tire1#"+.@i;
		setd "$@mr_1_luk"+.@i,0;
		setd "$@mr_1_tire"+.@i,0;
	}
	end;
OnTimer300000:
	donpcevent "#race_timer1-1::OnEnable";
	$@monster_race = 0;
	mapwarp "p_track01","hugel",63,73;
	end;

OnTimer342000:
	stopnpctimer;
OnInit:
	disablenpc "奖牌兑换员#single";
	end;
}

p_track01,76,36,1	script	离场向导#single	798,{
	mes "[离场向导]";
	mes "如果你有获胜的赛跑";
	mes "券，请务必";
	mes "你现在兑换奖牌。";
	mes "下一场比赛开始后所有赛跑券都会";
	mes "失效。";
	next;
	mes "[离场向导]";
	mes "如果你想离开";
	mes "赛场，我可以带你";
	mes "到外面。现在要";
	mes "离开赛场吗？";
	next;
	if (select("Yes:No") == 2) {
		mes "[离场向导]";
		mes "好的。";
		mes "准备好后";
		mes "告诉我";
		mes "即可离开。";
		close;
	}
	if (!countitem(7514)) {
		mes "[离场向导]";
		mes "感谢你的";
		mes "光临，希望你";
		mes "很快再次";
		mes "来访～";
	} else {
		mes "[离场向导]";
		mes "按照规定，";
		mes "离开前我必须收走你的";
		mes "赛跑券 before you leave.";
		mes "感谢你的 your patronage,";
		mes "希望你在";
		mes "在这里的怪物赛场度过愉快时光。";
		delitem 7514,1; //Monster_Ticket
	}
	monster_race_1 = 0;
	close2;
	warp "hugel",63,73;
	end;
}

hugel,58,72,6	script	埃卡尔·埃尔伯德#single	798,{
	mes "[埃卡尔·埃尔伯德]";
	mes "欢迎来到 biggest";
	mes "景点——";
	mes "怪物赛 Arena.";
	mes "今天我能帮你什么？";
	next;
	if (select("怪物赛 Info:Enter 怪物赛") == 1) {
		mes "[埃卡尔·埃尔伯德]";
		mes "怪物赛s originated from";
		mes "简单的儿童游戏，";
		mes "可爱的宠物互相赛跑，后来发展成成人";
		mes "也喜爱的活动，因此我们在斐扬建造了赛场。";
		next;
		mes "[埃卡尔·埃尔伯德]";

		next;
		mes "[Clever]";
		mes "我希望你使用希尔的裂隙工具，与过去的埃特兰和拉斐尔人见面。";
		next;
		mes "[Clever]";
		mes "即使是琐碎的事情也没关系。我只希望你详细记录一切，然后回来告诉我。";
		changequest 12292,12293;
		ep14_2_etran = 29;
	}
	else if (ep14_2_etran > 28 && ep14_2_etran < 42) {
		mes "我希望你使用希尔的裂隙工具，与过去的埃特兰和拉斐尔人见面。";
		next;
		mes "[Clever]";
		mes "即使是琐碎的事情也没关系。我只希望你详细记录一切，然后回来告诉我。";
	}
	else if (ep14_2_etran == 42) {
		mes "你来了。";
		next;
		mes "[Clever]";
		mes "是的，希尔的研究有好的结果吗？";
		next;
		select("告诉他发生的事情。 ");
		mes "[Clever]";
		mes "是的，我明白了。";
		mes "正如预想的那样，两位年轻多纳斯埃特兰和罗伯特的牺牲造就了今天的伊克拉斯。现在可以确定，官方历史记录有误。";
		next;
		mes "[Clever]";
		mes "太谢谢你了。"+ strcharinfo(0) +"，如果不是你，我不可能实现长久以来的愿望。";
		next;
		mes "[Clever]";
		mes "哦，等等……两位朋友又重聚了，对吧？";
		next;
		select("我不确定。:我相信他们很快会这么做，对吧？");
		mes "[Clever]";
		mes "是的，我想我们现在还无法知道。";
		next;
		mes "[Clever]";
		mes "好吧，我想那已经不重要了！";
		mes "我感觉自己完成了一件真正重要的事！我们唱歌吧？！";
		next;
		cutin "EP14_etran1",1;
		mes "^000099我能从聪明的笑容中看到埃特兰的脸。这一定是他感受到喜悦的缘故。^000000";
		next;
		cutin "",255;
		mes "[Clever]";
		mes "谢谢你一直听我说。多亏了你，出狱后我就能满怀信心地把许多事情记录进历史。作为回报，我会祈祷家园树赐福。";
		next;
		getexp 200000,120000;
		ep14_2_etran = 43;
		mes "^000099你从聪明那里获得家园树的祝福，得到经验值和职业经验值。^000000";
	}
	else
		mes "^000099聪明正在认真地把内容抄写到纸上。^000000";
	close;
}

ecl_in04,109,215,3	script	Hiel#pa0829	4_M_FAIRYSCHOLAR,{
	disable_items;
	if (checkweight(1201,1) == 0 || (MaxWeight - Weight) < 10000) {
		mes "物品种类似乎太多了。减少种类后再试一次吧。";
		close;
	}
	mes "[Hiel]";
	if (ep14_2_etran < 9) {
		mes "据说家园树叶片的长度为X，平均值为m，标准差为4。如果P(m<X<a)=0.3413……（喃喃自语）";
		next;
		mes "^0000ff看来我完全听不懂他说的话。我们离开这里吧。^000000";
	}
	else if (ep14_2_etran == 9) {
		mes "嗯？人类旅行者为什么会来到我的房间？这不是任何人都能进入的房间。";
		next;
		select("有人介绍我来这里见你。 ");
		mes "[Hiel]";
		mes "哦~有人介绍你来找我？是谁？你最好说清楚，否则我会把你赶出去。";
		next;
		input .@inputstr$;
		if (.@inputstr$ == "Clever") {
			mes "["+ strcharinfo(0) +"]";
			mes .@inputstr$ + "介绍我（"+ strcharinfo(0) +"）来找你。";
			next;
			mes "[Hiel]";
			mes "哦，真的吗？给我一点时间。我先做完手头的事再回来。";
			ep14_2_etran = 11;
			close;
		}
		else {
			mes "[Hiel]";
			mes "我不认识那个人！你很可疑！";
			close2;
			warp "eclage",152,91;
			end;
		}
	}
	else if (ep14_2_etran == 11 || ep14_2_etran == 12) {
		if (ep14_2_etran == 11) {
			mes "我不太相信你能和不善交际的聪明正常交谈，但姑且先相信你。那么，他告诉你什么了？";
			while (1) {
				next;
				switch( select("Forget this conversation.:关于塞内特国王父亲的故事:关于塞内特国王纵火的故事:参谋长助理的真名:附近区域的次元裂隙") ) {
					mes "[Hiel]";
				case 1:
					mes "真没意思。我很忙，你还是走吧。";
					close;
				case 2:
					mes "我对这里关于王族的传闻不太感兴趣。";
					continue;
				case 3:
					mes "我甚至不知道这些八卦对我有什么用。这就是你和聪明谈的全部内容吗？";
					continue;
				case 4:
					mes "现任副参谋长的名字不是真的吗？";
					next;
					mes "[Hiel]";
					mes "就算这样，那和我有什么关系？我还是继续研究吧。";
					continue;
				case 5:
				}
				break;
			}
			mes "哦~你真会找有趣的话题。正如聪明可能告诉你的，我房间里有一块次元裂隙碎片。";
			next;
			mes "^000099希尔异常兴奋地向我展示了一个装满碎石的奇怪容器，并连续讲了30分钟。^000000";
			next;
			mes "^000099这和聪明带来的烦恼完全是另一个层次。我得想办法阻止他没完没了地说话……^000000";
			next;
			while (1) {

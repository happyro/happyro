				if ($@job_rune_test1 == 0) {
					if (Weight < 4001) {
						set $@job_rune_test1,1;
						sc_start SC_INCINT,300000,40;
						getitem 12389,30; //Runstone_Storm
						getitem 12390,30; //Runstone_Millennium
						if (checkquest(3220) > -1) erasequest 3220;
						setquest 3220;
						warp "job3_rune02",38,40;
						end;
					}
						mes "[符文骑士维尔皮诺]";
					mes "你能使用的武器总重量必须在 400 以内。提供的符文石为 30 枚仅攻击符文石和 30 枚仅防御符文石。";
					next;
						mes "[符文骑士维尔皮诺]";
					mes "你携带的其他物品应交给中央的卡普拉员工保管。";
					close;
				}
				// Custom translation
					mes "[符文骑士维尔皮诺]";
				mes "看来测试室里已经有申请者。";
				next;
					mes "[符文骑士维尔皮诺]";
				mes "请耐心等待轮到你。";
				close;
			}
			mes "[符文骑士维尔皮诺]";
			mes "等等，我会收回之前提供的所有符文石。测试用符文石有使用限制。";
			if (countitem(12388)) delitem 12388,countitem(12388); //Runstone_Crush
			if (countitem(12389)) delitem 12389,countitem(12389); //Runstone_Storm
			if (countitem(12390)) delitem 12390,countitem(12390); //Runstone_Millennium
			next;
			mes "[符文骑士维尔皮诺]";
			mes "我会准备新的符文石，准备好后再和我谈。";
			close;
		} else if (job_rune_edq == 21) {
			mes "[符文骑士维尔皮诺]";
			mes "你成功通过了之前的测试。";
			next;
			if (countitem(12388)+countitem(12389)+countitem(12390) == 0) {
				mes "[符文骑士维尔皮诺]";
				mes "你需要参加的所有测试都结束了。回去告诉 Tigris 队长测试结果，然后感受重生为符文骑士的深切喜悦。";
				next;
				mes "[符文骑士维尔皮诺]";
				mes "恭喜！";
					mes "那么，我该去看看剩下的候选人了。";
				set job_rune_edq,22;
				changequest 3218,3219;
				close;
			}
			mes "[符文骑士维尔皮诺]";
			mes "等等，我会收回之前提供的所有符文石。测试用符文石有使用限制。";
			if (countitem(12388)) delitem 12388,countitem(12388); //Runstone_Crush
			if (countitem(12389)) delitem 12389,countitem(12389); //Runstone_Storm
			if (countitem(12390)) delitem 12390,countitem(12390); //Runstone_Millennium
			next;
			mes "[符文骑士维尔皮诺]";
			mes "我需要重新使用这些未用的符文石。收回所有测试符文石后再和我谈。";
			close;
		}
	}
	mes "一名从头到脚穿着黑衣、令人感到寒冷的符文骑士正瞪着我。";
	close;
}


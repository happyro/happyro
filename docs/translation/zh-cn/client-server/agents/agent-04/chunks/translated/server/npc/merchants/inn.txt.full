	//======================== Veins ====================================
	ve_in,157,219,5	script	Inn Master#Receptionist	709,{
	mes "[Inn Master]";
		mes "你好～欢迎来到 Veins 最舒适的旅馆～";
		next;
		switch(select("保存:休息 -> 5000 Zeny:退出")) {
		case 1:
		mes "[Inn Master]";
		mes "你的重生点已保存在 Veins。祝你逗留愉快～";
	savepoint "ve_in",157,209,1,1;
		close;
		case 2:
			mes "[Inn Master]";
			if(Zeny < 5000){
			mes "抱歉，你的钱似乎不够入住。";
			mes "服务费是 5,000 Zeny。";
			close;
		}
		mes "住得愉快～";
		close2;
		set Zeny,Zeny - 5000;
		percentheal 100,100;
		warp "ve_in",184,228;
		end;
	case 3:
		mes "[Inn Master]";
		mes "欢迎再次光临。";
		close;
	}
}

//======================== Brasilis =================================
bra_in01,27,24,3	script	Hotel Keeper#bra1	478,{
	mes "[Hotel Keeper]";
	mes "欢迎来到美丽的巴西利斯酒店。";
	next;
	switch(select("保存:休息 -5000 Zeny:取消")) {
	case 1:
		mes "[Hotel Keeper]";
		mes "要在巴西利斯酒店保存重生点吗？";
		next;
		switch(select("不用了，谢谢。:当然。")) {
		case 1:
			mes "[Hotel Keeper]";
			mes "好吧，祝你住得愉快。";
			close;
		case 2:
			mes "[Hotel Keeper]";
			mes "你的重生点已保存在旅馆。希望你在巴西利斯住得愉快。";
			savepoint "bra_in01",144,69,1,1;
			close;
		}
		end;
	case 2:
		if (Zeny > 4999) {
			mes "[Hotel Keeper]";
			mes "我会带你去一间很棒的房间。";
			close2;
			if (Zeny < 5000)
				end;
			Zeny -= 5000;
			percentheal 100,100;
			warp "bra_in01",144,69;
			end;
		}
		mes "[Hotel Keeper]";
			mes "抱歉，每晚服务费是 5,000 Zeny。";
	case 3:
		close;
	}
}

//======================== Einbroch =================================
ein_in01,206,224,3	script	Hotel Employee#ein	855,{
	mes "[Hotel Employee]";
	mes "你好，欢迎来到";
	mes "艾因布罗克旅馆。我们的员工";
	mes "一直努力为客人提供最高标准的";
	mes "清洁、服务和便利～";
	mes "";
	mes "";
	next;
	if (kain_ticket == 5) {
		mes "[Hotel Employee]";
		mes "你是在找";
		mes "Defru Ark 先生吗？";
		mes "哦，对了，他提过";
		mes "正在等机场送来的包裹。";
		mes "现在让我查一下信息……";
		mes "";
		next;
		mes "[Hotel Employee]";
		mes "啊，找到了。";
		mes "Defru Ark 先生";
		mes "住在 201 号房。";
		next;
	}
	else {
		switch(select("保存:休息 - 5,000 Zeny:取消")) {
		case 1:
			mes "[Hotel Employee]";
			mes "你的重生点";
			mes "已保存在";
			mes "艾因布罗克旅馆。";
			mes "谢谢，欢迎";
			mes "再次光临。";
			close2;
			savepoint "ein_in01",200,224,1,1;
			end;
		case 2:
			if (Zeny > 4999) {
				mes "[Hotel Employee]";
				mes "谢谢。";
				mes "请享受";
				mes "你的休息～";
				close2;
				set Zeny, Zeny-5000;
				percentheal 100,100;
				warp "ein_in01",272,167;
				end;
			}
			else {
				mes "[Hotel Employee]";
			mes "抱歉，住宿费是";
			mes "5,000 Zeny。下次请确认";
			mes "带够 Zeny，";
			mes "好吗？";
			mes "";
				close;
			}
		case 3:
			mes "[Hotel Employee]";
			mes "谢谢，";
			mes "欢迎再次光临～";
			close;
		}
	}
	mes "[Hotel Employee]";
	mes "祝你今天愉快。";
	close;
}

//======================= Inn Function ==============================
function	script	F_InnMaid	{
	.@npc_name$ = getarg(0);

	mes .@npc_name$;
	mes "欢迎来到";
	mes getarg(1) + ".";
	mes "有什么可以帮你？";
	next;
	switch(select("保存:休息 -> 5000 Zeny:取消")) {
	case 1:
		mes .@npc_name$;
		mes "你的重生点";
		mes "已保存。";
		mes "谢谢，";
		mes "欢迎再次光临。";
		savepoint getarg(2),getarg(3),getarg(4),1,1;
		close;
	case 2:
		mes .@npc_name$;
		if(Zeny < 5000){
			mes "抱歉，服务费是 5,000 Zeny。下次入住请确保带够钱，好吗？";
			close;
		}
		mes "谢谢。";
		mes "希望你";
		mes "休息愉快～";
		close2;
		set Zeny,Zeny - 5000;
		percentheal 100,100;
		return;
	case 3:
		close;
	}
}

		//====================== Lighthalzen =================================
			lhz_in02,230,284,4	script	Hotel Employee#01	86,{
			mes "[Hotel Employee]";
			mes "欢迎来到皇家巨龙，";
			mes "这里提供最优质的住宿和服务。";
			next;
		switch(select("保存点:休息 - 5,000 Zeny:取消")) {
		case 1:
		savepoint "lhz_in02",209,275,1,1;
		mes "[Hotel Employee]";
		mes "谢谢，你的重生点已保存于皇家巨龙。";
		close;
		case 2:
		if(Zeny < 5000) {
		mes "[Hotel Employee]";
		mes "抱歉，入住需要 5,000 Zeny。";
		close;
		}
	set Zeny,Zeny - 5000;
		mes "[Hotel Employee]";
		mes "谢谢～希望你在皇家巨龙住得愉快。";
		close2;
		warp "lhz_in02",219,150;
	percentheal 100,100;
npcskill "AL_BLESSING",10,99,99;
end;
case 3:
mes "[Hotel Employee]";
mes "谢谢，祝你今天愉快。";
	close;
	}
}


mjolnir_01,293,20,3	script	Nutters#Coco_Hunt	779,{
	if (checkquest(60113) != -1) {
		if (checkquest(60113,HUNTING) != 2 ) {
			mes "[纳特斯]";
			mes "你已经猎杀 50 只可可了吗？";
			next;
			switch(select("是:否:我想退出")) {
			case 1:
				mes "[纳特斯]";
				mes "嗯，我觉得你还没猎杀 50 只……";
				close;
			case 2:
				mes "[纳特斯]";
				mes "记住，我需要你帮忙猎杀可可，去猎杀 50 只吧。";
				close;
			case 3:
				mes "[纳特斯]";
				mes "你确定要停止猎杀吗？";
				mes "你取得的进度都会被清除。";
				next;
				switch(select("是:否")) {
				case 1:
					mes "[纳特斯]";
					mes "好吧，改变主意后再回来。";
					erasequest 60113;
					close;
				case 2:
					mes "[纳特斯]";
					mes "请猎杀 50 只可可。";
					close;
				}
			}
		}
		else {
			mes "[纳特斯]";
			mes "太厉害了，你完成得真快。";
			getexp 3600,3905;
			erasequest 60113;
			close;
		}
	}
	if (checkquest(60114) != -1) {
		if (checkquest(60114,HUNTING) != 2 ) {
			mes "[纳特斯]";
			mes "你已经猎杀 50 只可可了吗？";
			next;
			switch(select("是:否:我想退出")) {
			case 1:
				mes "[纳特斯]";
				mes "嗯，我觉得你还没猎杀 100 只……";
				close;
			case 2:
				mes "[纳特斯]";
				mes "记住，我需要你帮忙猎杀可可，去猎杀 100 只吧。";
				close;
			case 3:
				mes "[纳特斯]";
				mes "你确定要停止猎杀吗？";
				mes "你取得的进度都会被清除。";
				next;
				switch(select("是:否")) {
				case 1:
					mes "[纳特斯]";
					mes "好吧，改变主意后再回来。";
					erasequest 60114;
					close;
				case 2:
					mes "[纳特斯]";
					mes "请猎杀 100 只可可。";
					close;
				}
			}
		}
		else {
			mes "[纳特斯]";
			mes "太厉害了，你完成得真快。";
			getexp 3600,3905;
			getexp 3600,3905;
			erasequest 60114;
			close;
		}
	}
	if (checkquest(60115) != -1) {
		if (checkquest(60115,HUNTING) != 2 ) {
			mes "[纳特斯]";
			mes "你已经猎杀 150 只可可了吗？";
			next;
			switch(select("是:否:我想退出")) {
			case 1:
				mes "[纳特斯]";
				mes "嗯，我觉得你还没猎杀 150 只……";
				close;
			case 2:
				mes "[纳特斯]";
				mes "记住，我需要你帮忙猎杀可可，去猎杀 150 只吧。";
				close;
			case 3:
				mes "[纳特斯]";
				mes "你确定要停止猎杀吗？";
				mes "你取得的进度都会被清除。";
				next;
				switch(select("是:否")) {
				case 1:
					mes "[纳特斯]";
					mes "好吧，改变主意后再回来。";
					erasequest 60115;
					close;
				case 2:
					mes "[纳特斯]";
					mes "请猎杀 150 只可可。";
					close;
				}
			}
		}
		else {
			mes "[纳特斯]";
			mes "太厉害了，你完成得真快。";
			getexp 3600,3905;
			getexp 3600,3905;
			getexp 3600,3905;
			erasequest 60115;
			close;
		}
	}
	//for minimum level
	if (BaseLevel > 17) {
		//for maximum level
		if (BaseLevel < 60) {
			mes "[纳特斯]";
			mes "我、我好像就是找不到。";
			mes "讨厌的可可把橡果全藏起来了。";
			mes "你能帮帮我吗？";
			next;
			switch(select("当然:不了")) {
			case 1:
				mes "[纳特斯]";
				mes "哦，太好了！我一看就知道可以指望你！";
				next;
				switch(select("收集物品:猎杀可可:取消")) {
				case 1:
					// Item turn in
					mes "[纳特斯]";
					mes "你能帮我找 ^00CE0025 个橡果^000000吗？";
					mes "如果你能做到，我会给你丰厚奖励。";
					next;
					switch(select("我有 25 个橡果:请下次再来？")) {
					case 1:
						/*
						if (checkweight(502,5) == 0) {
							mes "[纳特斯]";
							mes "嘿，你背包里的重量看起来会";
							mes "压垮你。减轻负重后再回来。";
							mes "";
							close;
						}
						*/
						if (countitem(1026) > 24) {
							mes "[纳特斯]";
							mes "太好了，你找到了它们藏在哪里。";
							mes "给我给我！！！";
							next;
							mes "[纳特斯]";
							mes "哦，对了，抱歉，我只是喜欢烤橡果。嗯。";
							mes "这是我答应你的。";
							delitem 1026,25; //Acorn
							getexp 3600,3905;
							//getitem 502,5; //Orange_Potion
							close;
						}
						else {
							mes "[纳特斯]";
							mes "我的 ^00CE00橡果^000000 呢？";
							mes "嘿，我不是在开玩笑，别想瞒着我。";
							close;
						}
					case 2:
						mes "[纳特斯]";
						mes "我需要 ^00CE0025 个橡果^000000。";
						close;
					}
				case 2:
					// Kill Count Quest
					mes "[纳特斯]";
					mes "啊，好吧，我想你可以猎杀一些可可来帮我。";
					mes "你想猎杀多少？";
					next;
					switch(select("50 只可可:100 只可可:150 只可可")) {
					case 1:
						mes "[纳特斯]";
						mes "完成任务后回来，我会给你小奖励。";
						setquest 60113;
						close;
					case 2:
						mes "[纳特斯]";
						mes "完成任务后回来，我会给你小奖励。";
						setquest 60114;
						close;
					case 3:
						mes "[纳特斯]";
						mes "完成任务后回来，我会给你小奖励。";
						setquest 60115;
						close;
					}
				case 3:
					mes "[纳特斯]";
					mes "改变主意后请回来。";
					close;
				}
			case 2:
				mes "[纳特斯]";
				mes "改变主意后请回来。";
				close;
			}
		}
		else {
			mes "[纳特斯]";
			mes "你太强了，不该和这些东西战斗！";
			close;
		}
	}
	else {
		mes "[纳特斯]";
		mes "你太弱小，无法替我对付这些东西。";
		mes "你能变强一些再回来吗？";
		close;
	}
}

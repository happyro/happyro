prt_in,94,172,4	script	Karian#job_min3	480,{
	if (job_min == 27) {
		if (checkweight(1201,1) == 0 || MaxWeight - Weight < 3500) {
			mes "旅行途中会获得很多物品。请减轻负重。";
			close;
		}
		mes "[Karian]";
		if (SkillPoint != 0) {
			mes "啊～！你知道自己还有技能点吗？";
			mes "快去处理一下。";
			close;
		}
		if (BaseLevel < 99 || JobLevel < 50) {
			mes "啊～！你的等级看起来比以前低。";
			mes "你是怎么降级的？";
			close;
		}
		if (ismounting()) {
			mes "请卸下坐骑宠物后再试一次！";
			close;
		}
		if (BaseJob != Job_Bard) {
			mes "嗯？";
			close;
		}
		mes "很抱歉骗了你。";
		mes "写在这张纸上的歌……";
		next;
		mes "[Karian]";
		mes "我真的很想找到朋友留下的文章。";
		mes "但我一个人找不到。";
		next;
		mes "[Karian]";
		mes "我把它交给了朋友，但他一直珍藏着……";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "是你把它交给他的吗？";
		mes "等一下！";
		mes "你究竟是谁？";
		next;
		mes "[Maestro Song]";
		mes "没错！我就是“歌之大师”！";
		mes "很惊讶吗！？";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "......";
		next;
		mes "[Maestro Song]";
		mes "这是我送给你的礼物。";
		next;
		mes "[Maestro Song]";
		mes "你也是我的朋友。";
		set job_min,100;
		jobchange roclass(eaclass()|EAJL_THIRD);
		completequest 11154;
		getitem 5751,1; //Minstrel_Song_Hat
		getitem 2795,1; //Green_Apple_Ring
		close;
	} else if (job_min > 99) {
		switch(select("交谈。:离开。")) {
		case 1:
			mes "[Maestro Song]";
			mes "“卡里安”这个名字？";
			mes "是他给我的。";
			next;
			mes "[Maestro Song]";
			mes "他说听到我的歌时，心里会感到温暖。";
			mes "“卡里安加”意味着热空气。";
			next;
			mes "[Maestro Song]";
			mes "他喜欢唱歌……";
			next;
			mes "[Maestro Song]";
			mes "而且他确实很擅长歌唱？";
			next;
			mes "[Maestro Song]";
			mes "啊！如果你不介意，我想在朱诺和你合影，可以吗？";
			next;
			mes "[Maestro Song]";
			mes "我想留下一件能让我记住你的东西。";
			close;
		case 2:
			mes "[Maestro Song]";
			mes "回头见。";
			mes "真的很开心。";
			close2;
			warp "prontera",156,99;
			end;
		}
	}
	mes "[Karian]";
	mes "你是怎么进来的？";
	close;
}

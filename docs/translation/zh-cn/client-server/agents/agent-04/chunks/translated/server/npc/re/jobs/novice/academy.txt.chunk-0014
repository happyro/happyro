// - Lady Harvesting Herbs
// -----------------------------------------------------------------------------
pay_fild08,153,83,1	script	Lady Harvesting Herbs#2	1_F_ORIENT_02,{
	mes "[Lady]";
	mes "东边有个叫斐扬的城镇。沿着南边的远路走，甚至还能到达艾尔帕兰。";
	next;
	mes "[Lady]";
	mes "斐扬是座很棒的城市。在那里可以转职为弓箭手或跆拳道家，还有不错的地下城。有时间请去看看。";
	emotion ET_SMILE;
	close;
}


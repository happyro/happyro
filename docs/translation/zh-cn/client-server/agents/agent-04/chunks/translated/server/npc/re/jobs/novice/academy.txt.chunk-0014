// =============================================================================
// = Job NPCs
// =============================================================================

//= Cream Puff
//= Gives the player a personality test to determine the class they should be.
//==============================================================================
iz_ac02,143,55,3	script	Cream Puff#ac	4_M_KID1,{
	cutin "choucream_n.bmp", 2;
	if (Class == Job_Novice) {
		emotion ET_QUESTION;
		mes "[Cream Puff]";
		mes "你是初心者，对吧？";
		next;
	} else {
		emotion ET_OHNO;
		mes "[Cream Puff]";
		mes "对已经有职业的人来说，职业适性测试毫无意义。";
		close2;
		cutin "", 255;
		end;
	}
	mes "[Cream Puff]";
	mes "你还没决定职业吗？";
	next;
	if (select("没有……你怎么知道？", "我决定了。") == 2) {
		cutin "choucream_d.bmp",2;
		emotion ET_OHNO;
		mes "[Cream Puff]";
			mes "你已经决定了吗？好吧。";
		next;
		mes "[Cream Puff]";
			mes "我本来想让你参加职业适性测试玩玩的……";
		close2;
		cutin "", 255;
		end;
	}
	cutin "choucream_e.bmp",2;
	emotion ET_SPARK;
	mes "[Cream Puff]";
	mes "哦，那就好。";
	mes "^0000FF职业适性测试^000000是什么？";
	mes "我还剩下一本书。想试试吗？我不能保证一定有帮助，但会很有趣。";
	next;
	while(1) {
		switch(select("Class aptitude test?", "参加职业适性测试。", "停止。")) {
		case 1:
			cutin "choucream_n.bmp",2;
			mes "[Cream Puff]";
			mes "职业适性测试会根据你的回答分析性格和能力，并推荐适合的职业。";
			next;
			mes "[Cream Puff]";
			mes "测试分为三种，每种有 30 分钟完成时间。";
			next;
			emotion ET_QUESTION;
			mes "[Cream Puff]";
			mes "如果你有空闲时间，又还没决定职业……不如参加这个测试？";
			next;
			continue;
		case 2:
			break;
		case 3:
			cutin "choucream_d.bmp",2;
			emotion ET_HNG;
			mes "[Cream Puff]";
			mes "好吧，再见。";
			close2;
			cutin "", 255;
			end;
		}
		break;
	}
	cutin "choucream_e.bmp",2;
	mes "[Cream Puff]";
	mes "我们开始吧？";
	next;
	mes "[Cream Puff]";
	mes "第一类问题是针对特定情况采取行动。";
	next;
	mes "夜幕中，你正走在普隆德拉的街道上，突然听到有人尖叫。";
	next;
	mes "‘啊啊啊！！别伤害我～’";
	next;
	mes "你跑到现场，看到有人被混混包围。混混们因你的突然出现而大吃一惊。";
	next;
	mes "面对这种情况，你会怎么做？";
	next;
	switch(select("对付混混", "施放魔法。", "呼叫卫兵。", "向他们扔石头。")) {
	case 1:
		.@question_01$ = "你轻松制服了他们。";
		.@swordman_p = .@swordman_p + 1;
		.@taekwon_p = .@taekwon_p + 1;
		.@ninja_p = .@ninja_p + 1;
		break;
	case 2:
		.@question_01$ = "你对他们施放了魔法。";
		.@magician_p = .@magician_p + 1;
		break;
	case 3:
		.@question_01$ = "你呼救后，卫兵赶来帮助你。";
		.@acolyte_p = .@acolyte_p + 1;
		break;
	case 4:
		.@question_01$ = "你巧妙地向混混们扔石头。";
		.@archer_p = .@archer_p + 1;
		.@gunslinger_p = .@gunslinger_p + 1;
		break;
	}
	mes ""+.@question_01$+"";
	next;
	mes "收拾完混乱后，你走近被袭击的人。";
	mes "你觉得被混混包围的人是男是女？";
	next;
	if (select("男性", "女性") == 1) {
		.@question_02_01$ = "他";
		.@question_02_02$ = "儿子";
	} else {
		.@question_02_01$ = "她";
		.@question_02_02$ = "女儿";
	}
	mes "你遇到混混的情况是这样的：";
	next;
	mes "你发现"+.@question_02_01$+"是艾尔帕兰某个富裕家庭的"+.@question_02_02$+"，混混们在"+.@question_02_01$+"替家族办事时发动了袭击。";
	next;
	mes "他在办什么事？";
	next;
	switch(select("递送重要物品", "递送小纪念品", "传递消息")) {
	case 1:
		.@swordman_p = .@swordman_p + 1;
		.@archer_p = .@archer_p + 1;
		.@magician_p = .@magician_p + 1;
		break;
	case 2:
		.@thief_p = thief_p + 1;
		.@taekwon_p = .@taekwon_p + 1;
		break;
	case 3:
		.@acolyte_p = .@acolyte_p + 1;
		break;
	}
	mes "由于你的勇敢，"+.@question_02_01+"成为了你的朋友，并决定去旅行。";
	mes ""+.@question_02_01+"要去哪里？";
	next;
	switch(select("首都普隆德拉", "山城斐扬", "港口城市艾尔帕兰", "魔法都市吉芬", "卫星城市依斯鲁得", "沙漠城市梦罗克", "工业城市艾因布洛克", "自然之乡天津町", "花园城市胡格尔")) {
	case 1:
		.@acolyte_p = .@acolyte_p + 1;
		break;
	case 2:
		.@taekwon_p = .@taekwon_p + 1;
		break;
	case 3:
		.@merchant_p = .@merchant_p + 1;
		break;
	case 4:
		.@magician_p = .@magician_p + 1;
		break;
	case 5:
		.@swordman_p = .@swordman_p + 1;
		break;
	case 6:
		.@thief_p = .@thief_p + 1;
		break;
	case 7:
		.@gunslinger_p = .@gunslinger_p + 1;
		break;
	case 8:
		.@ninja_p = .@ninja_p + 1;
		break;
	case 9:
		.@archer_p = .@archer_p + 1;
		break;
	}
	mes "你玩得很开心。你觉得会发生什么事吗？";
	next;
	if (select("会发生:不会发生。") == 1) {
		.@thief_p = .@thief_p + 1;
		.@swordman_p = .@swordman_p + 1;
		.@ninja_p = .@ninja_p + 1;
		.@taekwon_p = .@taekwon_p + 1;
		.@magician_p = .@magician_p + 1;
		.@thief_p = .@thief_p + 1;
	} else {
		.@acolyte_p = .@acolyte_p + 1;
		.@merchant_p = .@merchant_p + 1;
		.@gunslinger_p = .@gunslinger_p + 1;
	}

				mes "请将";
				mes "服务之魂交给";
				mes "^FF0000十字军^000000或^FF0000圣骑士^000000。";
				mes "你已经知道了，";
				mes "对吧？请尽快";
				mes "送达。";
				close;
			}
			if (guildrelay_q == 98) {
				mes "[" + .@name$ + "]";
				mes "嗯。你需要等待";
				mes "合适的行动时机。";
				mes "何不暂时帮助";
				mes "你的公会？";
				close;
			}
			if ((guildrelay_q == 96) && (countitem(7250) > 0)) {
				mes "[" + .@name$ + "]";
				mes "请将";
				mes "荣耀之魂交给";
				mes "^FF0000武僧^000000或^FF0000宗师^000000。";
				mes "你已经知道了，";
				mes "对吧？请尽快";
				mes "送达。";
				close;
			}
			if (guildrelay_q == 96) {
				mes "[" + .@name$ + "]";
				mes "我看得出你有";
				mes "成为伟大领袖的潜力。";
				mes "务必不要浪费它，带领";
				mes "你的公会";
				mes "尽善尽美。";
				close;
			}
			if ((guildrelay_q == 97) && (countitem(7251) > 0)) {
				mes "[" + .@name$ + "]";
				mes "你需要将";
				mes "^FF0000胜利之魂^000000";
				mes "交给公会会长。";
				mes "请确保它";
				mes "尽快送达。";
				close;
			}
			if (guildrelay_q == 97) {
				mes "[" + .@name$ + "]";
				mes "你是一位知名探险家，";
				mes "我看出你有潜力";
				mes "完成更多";
				mes "伟大的事情。不过，";
				mes "我怀疑这里还有什么";
				mes "能让你做的。";
				close;
			}
			mes "[" + .@name$ + "]";
			mes "嗯。你不该来这里。";
			mes "何不去找些";
			mes "有意义的事情";
			mes "去做？这里没有";
			mes "适合你的事，我保证。";
			close;
		}
	}
	else {
		if (is_guild_leader(.@GID) == true) {
			mes "[" + .@name$ + "]";
			mes "你可能是公会会长，";
			mes "但你和我";
			mes "没有关系。";
			mes "抱歉。";
			next;
			mes "[" + .@name$ + "]";
			mes "不过，我想";
			mes "你来这里是想看看";
			mes "真正的公会如何运作。";
			mes "如果是这样，欢迎";
			mes "留下观察。";
			close;
		}
		else {
			mes "[" + .@name$ + "]";
			mes ".........................";
			next;
			mes "[" + .@name$ + "]";
			mes ".........................";
			next;
			mes "[" + .@name$ + "]";
			mes "你来这里做什么？";
			mes "我好像以前没见过";
			mes "你。嗯。";
			close;
		}
	}
}


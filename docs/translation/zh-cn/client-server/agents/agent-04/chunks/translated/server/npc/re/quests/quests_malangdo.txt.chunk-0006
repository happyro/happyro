		mes "- 水灌满后很重。 -";
		specialeffect EF_POTION8;
		delitem 6431,1; //Bucket
		getitem 6432,1; //Full_Bucket
		close;
	case 2:
		mes "- 没有取到水。 -";
		close;
	}
}

mal_dun01,133,125,5	script	Star Candy#mal	552,{
	if (ma_tomas == 19) {
		mes "[星星糖]";
		mes "....";
		mes ".....";
		mes "......";
		next;
		mes "[比斯科特]";
		mes "无礼！你怎么能这样和珍贵的星星糖说话！";
		next;
		mes "[比斯科特]";
		mes "你和那些平时来的人不一样……";
		mes "不过你看起来也很奇怪。";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "?!";
		mes "你会说话！";
		emotion ET_HUK, playerattached();
		next;
		mes "[比斯科特]";
		mes "什么？";
		mes "你从没见过我说话吗？";
		mes "你怎么了？";
		next;
		mes "[比斯科特]";
		mes "既然我能和你交谈，你似乎比那些愚蠢的家伙好多了。";
		mes "我学会了他们的语言，他们却听不懂。";
		next;
		mes "[比斯科特]";
		mes "我们珍贵的星星糖默默支撑着他们，他们却这样对待她。";
		mes "他们根本不懂得表达感谢！";
		emotion ET_ANGER, getnpcid(0, "Biscuit#mal");
		next;
		select("Support?");
		mes "[比斯科特]";
		mes "总之！";
		mes "对他们好也没用。";
		mes "他们不知道星星糖有多努力。";
		next;
		mes "[比斯科特]";
		mes "这座岛原本属于她，但她躲避风暴来到这里时，那些猫突然掉到了岛上。";
		next;
		mes "[比斯科特]";
		mes "因为这里的地面太软，星星糖被卡在中间，事情就变成了这样。";
		next;
		mes "[比斯科特]";
		mes "其实不管那些糟糕的事，她都能脱身，但她担心有人受伤，所以支撑着地面。";
		next;
		mes "[比斯科特]";
			mes "啊，啊……";
		mes "多么美丽的心灵……";
		next;
		mes "[比斯科特]";
		mes "有一次她感到不舒服稍微动了动，看到那些猫惊慌失措。从那以后她再也没动过，我担心她是不是不舒服。";
		next;
		mes "[比斯科特]";
		mes "星星糖这样牺牲自己，那些家伙却只为自己在她周围立柱子。";
		mes "Hewww!!!";
		emotion ET_ANGER, getnpcid(0, "Biscuit#mal");
		next;
		mes "[比斯科特]";
		mes "他们和她说话，却无视和她说话的我。";
		mes "我一点也不喜欢他们！！！";
		next;
		mes "- 和德沃尔博士所说的不同，比斯科特说话非常流利。 -";
		next;
		mes "- 我觉得最好尽快把这件事告诉德沃尔博士。 -";
		set ma_tomas,20;
		changequest 11226,11227;
		close;
	}
	mes "[星星糖]";
	mes "....";
	mes ".....";
	mes "......";
	close;
}

-	script	#skin_mal	-1,{
	set .@index, atoi(strnpcinfo(2));
	switch(.@index) {
		case 29: set .@str$,"dry"; break;
		case 30: set .@str$,"prickly"; break;
		case 31: set .@str$,"chapped"; break;
		case 32: set .@str$,"hard"; break;
		default:
			mes "发生错误。";
			close;
	}
	if (ma_tomas != .@index) {
		mes "- 我很抱歉这层皮肤 -";
		mes "- 变得如此"+.@str$+"。-";
		close;
	}
	if (!countitem(6433) || !countitem(6432)) {
		mes "- 你需要 -";
		mes "- 一把清洁刷 -";
		mes "- 和一桶水。-";
		close;
	}
	mes "- 把水倒在"+.@str$+"的皮肤上。-";
	delitem 6432,1; //Full_Bucket
	getitem 6431,1; //Bucket
	next;
	if (rand(1,2) == 1)
		set .@menu$,"Brush.:Stop.:";
	else
		set .@menu$,":Stop.:Brush.";
	switch(select(.@menu$)) {
	case 1:
	case 3:
		mes "- 把水倒在 -";
		mes "- "+.@str$+"的皮肤上 -";
		mes "- 并把它刷干净。-";
		specialeffect EF_BUBBLE;
		if (rand(1,3) > 1)
			close;
		next;
		mes "- "+.@str$+"的皮肤变得 -";
		mes "- 柔软而湿润。-";
		switch(rand(1,50)) {
		case 7:
			next;
			mes "[星星糖]";
			mes "呼呼呼～";
			mes "好痒。";
			break;
		case 21:
			next;
			mes "[星星糖]";
			mes "你真是个善良的人。";
			break;
		case 29:
			next;
			mes "[星星糖]";
			mes "因为我无法移动，所以站起来是最困难的事。";
			break;
		case 30:
			next;
			mes "[星星糖]";
			mes "啊～感觉真好～";
			mes "我痒了好久。";
			break;
		case 49:
			next;
			mes "[星星糖]";
			mes "非常感谢。";
			break;
		default:
			set ma_tomas, ma_tomas+1;
			if (.@index == 32)
				changequest 11234,11235;
			close;
		}
		cutin "ma_starcandy",2;
		set ma_tomas, ma_tomas+1;
		if (.@index == 32)
			changequest 11234,11235;
		close2;
		cutin "",255;
		end;
	case 2:
		mes "- 所有的水 -";
		mes "- 都渗入了地面。-";
		close;
	}
}
mal_dun01,143,137,0	duplicate(#skin_mal)	Dry Skin#29	111
mal_dun01,131,150,0	duplicate(#skin_mal)	Prickly Skin#30	111
mal_dun01,116,144,0	duplicate(#skin_mal)	Chapped Skin#31	111
mal_dun01,120,129,0	duplicate(#skin_mal)	Hard Skin#32	111

malangdo,190,167,7	script	Portali#mal	546,{
	if (ma_tomas < 100) {
		mes "[Portali]";
	mes "我没什么事要交给不成熟的家伙！";
		close;
	}
	mes "[Portali]";
	mes "嗯……";
	mes "虽然你是人类，却有猫的气味……";
	next;
	mes "[Portali]";
	mes "但是……你想回我的故乡吗？";
	mes "我可以用新发现的技能送你去米德加兹大陆！";
	mes "这不是免费的。我需要罐头食品！";
	next;
	switch(select("出发。:不去。:价格？")) {
	case 1:
		if (countitem(12636) < 4) {
			mes "[Portali]";
			mes "没有罐头你要去哪里……？";
			close;
		}
		switch(select("卢恩-米德加兹:施瓦茨瓦尔德共和国:阿鲁纳佩尔茨王国")) {
		case 1:
			switch(select("普隆德拉:梦罗克:艾尔贝塔:艾尔迪巴兰:斐扬:吉芬")) {
				case 1: callsub L_Warp,"Prontera",4,"prontera",155,111;
				case 2: callsub L_Warp,"Morocc",4,"morocc",159,255;
				case 3: callsub L_Warp,"Alberta",4,"alberta",95,66;
				case 4: callsub L_Warp,"Al De Baran",4,"aldebaran",126,120;
				case 5: callsub L_Warp,"Payon",4,"payon",198,135;
				case 6: callsub L_Warp,"Geffen",4,"geffen",120,100;
			}
		case 2:
			switch(select("艾因布洛克:莱茵哈特:朱诺:胡格尔")) {
				case 1: callsub L_Warp,"Einbroch",6,"einbroch",229,196;
				case 2: callsub L_Warp,"Lighthalzen",6,"lighthalzen",214,150;
				case 3: callsub L_Warp,"Juno",6,"yuno",157,220;
				case 4: callsub L_Warp,"Hugel",6,"hugel",95,121;
			}
		case 3:
			switch(select("拉赫:维因斯")) {
				case 1: callsub L_Warp,"Rachel",5,"rachel",138,113;
				case 2: callsub L_Warp,"Veins",5,"veins",212,144;
			}
		}
	case 2:
		mes "[Portali]";
		mes "好……";
		close;
	case 3:
		mes "[Portali]";
		mes "卢恩-米德加兹需要 3 个！";
		mes "施瓦茨瓦尔德需要 6 个，阿鲁纳佩尔茨需要 5 个。";
		mes "施瓦茨瓦尔德是禁忌魔法之国，阿鲁纳佩尔茨似乎受到了诅咒！";
		close;
	}
	end;
L_Warp:
	if (countitem(12636) < getarg(1)) {
		mes "[Portali]";
		mes "没有罐头你要去哪里……？";
		close;
	}
	mes "[Portali]";
	mes "那么就去"+getarg(0)+"～";
	delitem 12636,getarg(1); //Malang_Sp_Can
	close2;
	warp getarg(2),getarg(3),getarg(4);
	end;
}

// Malangdo Island :: mal_ppl
//============================================================
malangdo,137,200,6	script	Pipielle	549,{
	if (MaxWeight - Weight < 1000) {
		mes "你的负重太高，无法继续。减轻负重后再回来。";
		close;
	}
	if (checkweight(1201,1) == 0) {
		mes "你的物品栏太满，无法继续。整理物品后再回来。";
		close;
	}
	if (BaseLevel < 60) {
		mes "[Pipielle]";
		mes "哇，天气真好。你也喜欢这样的天气吗？不过我现在得工作了。";
		next;
		mes "[Pipielle]";
		mes "如果你是更强的冒险者，我就会请你帮忙了……";
		next;
		mes "^770099这只猫正在做某项工作，但她要求帮助者等级达到 60 级以上。^000000";
		close;
	}
	set .@fish_ss1$, "What are you doing?";
	if (countitem(6451) > 29)
		set .@fish_ss2$, "I caught a lot of strange fishes!";
	else
		set .@fish_ss2$, (30-countitem(6451))+" of ^bbbbbbUnidentified Fish are required.^000000";
	if (ma_tomas == 100)
		set .@fish_ss3$, "I met an Admiral Tomas...";
	mes "[Pipielle]";
	mes "你能过来为我打开背包吗？";
	next;
	switch(select(.@fish_ss1$,.@fish_ss2$,.@fish_ss3$)) {
	case 1:
		mes "[Pipielle]";
		mes "这里有许多美丽的鱼。所以站在这里时，我感觉自己的心在跳动。";
		next;
		select("我觉得自己的心跳加快了……");
		mes "[Pipielle]";
		mes "你怎么只知道吃！我的心跳可不只是为了食物。";
		next;
		mes "[Pipielle]";
		mes "我以前在人类大学学习，还在那里学会了说话，所以别把我当普通动物。";
		next;
		mes "[Pipielle]";
		mes "我是研究鱼类的学者。";
		mes "研究鱼对猫来说很重要。";
		next;
		select("你的研究进展如何？");
		mes "[Pipielle]";
		mes "我曾是托马斯海军上将的好朋友，但自从来到这里，我们的船就没有再出海。";
		next;
		mes "[Pipielle]";
		mes "船员们似乎很孤独。";
		next;
		mes "[Pipielle]";
		mes "大学的一位学者来这里研究我们，发现有一只猫已经会说他的语言，觉得很不可思议。";
		mes "所以他一直帮我教其他猫。";
		next;
		select("所以我才能听懂所有猫说话吗？");
		mes "[Pipielle]";
		mes "没错！";
		mes "在那位学者到来之前，我是少数能和人类交谈的猫之一。";
		next;
		mes "[Pipielle]";
		mes "总之，我现在正在收集样本研究这里的怪物。希望你能帮我。";
		next;
		if(select("我能怎么帮你？:我必须拒绝。") == 2) {
			mes "[Pipielle]";
			mes "哦，好吧。改变主意后请再来。";
			close;
		}
		mes "[Pipielle]";
		mes "章鱼和下水道地下城里有一种叫 Pouring 的怪物，它正在吃掉所有的鱼。";
		next;
		mes "[Pipielle]";
		mes "它在冬天突然出现。消灭它后，你能收集未鉴定的鱼样本吗？";
		next;
		mes "[Pipielle]";
		mes "可以从 Pouring 怪物那里获得未鉴定的鱼，请收集 30 个。";
		close;
	case 2:
		if (countitem(6451) > 29) {
			//saveppl Unknown_Fish
			delitem 6451,30; //Unknown_Fish
			mes "[Pipielle]";
			mes "哦，谢谢你！我会收下这些样本。";
			next;
			mes "[Pipielle]";
			mes "我想给你点东西，但最后一件已经缺货，所以我先把你的名字记下来。";
			next;
			mes "[Pipielle]";
			mes "即使相隔很远，我也能给你带来好消息，但这只有在我非常幸运时才办得到……";
			close;
		}
		mes "[Pipielle]";
		mes "抱歉，请收集 30 个未鉴定的鱼样本。";
		close;
	case 3:
		mes "[Pipielle]";
		mes "哦，你见到托马斯海军上将了……他怎么样？";
		next;
		if(select("他看起来很温柔:他看起来很糟糕") == 2) {
			mes "[Pipielle]";
		mes "嗯……";
		mes "坦白说，我是托马斯海军上将的忠实粉丝。你能为自己的话负责吗？";
			next;
			if(select("开玩笑的！:没错，他真的很糟糕！") == 2) {
				mes "[Pipielle]";
				mes "真的吗？";
				mes "好吧，这确实取决于个人喜好……";
				close;
			}
		}
		mes "[Pipielle]";
		mes "真的吗？";
		mes "我就知道你会这么说。";
		next;
		mes "[Pipielle]";
		mes "托马斯海军上将是传奇人物，曾带领我们所有人航行到这座岛。我想那是我人生中最幸福的时刻。";
		next;
		mes "[Pipielle]";
		mes "请多帮助他。值得信任的人并不多。这是我的私人请求。";
		next;
		mes "[Pipielle]";
		mes "这是感谢你照顾托马斯海军上将的小礼物。";
		set ma_tomas,101;
		getitem 6422,200; //Egrade_Coin
		mes "^0000ff获得 200 枚 E 级硬币。^000000";
		close;
	}
}

// Help the Bad Cats in Danger :: mal_bad_guys
//============================================================
malangdo,175,206,3	script	Gobonge#ml	561,{
	if (checkweight(1201,1) == 0) {
		mes "- 携带物品过多，无法继续下一步。-";
		close;
	}
	if (checkquest(1152,PLAYTIME) == 0) {
		mes "[Gobonge]";
		mes "嗯，调查还不够。";
		mes "我们需要回到基础。";
		mes "明天再来吧。";
		mes "我可能又会像平时一样";
		mes "胃痛。";
		close;
	} else if (checkquest(1152,PLAYTIME) == 1) {
		erasequest 1152;
		set malang_bad_guys,0;
	} else if (checkquest(1152,PLAYTIME) == 2) {
		completequest 1152;
		erasequest 1152;
		set malang_bad_guys,0;
	}
	if (BaseLevel < 60) {
		mes "[Gobonge]";
		mes "你是来帮忙";
		mes "还是来寻求帮助的？";
		mes "你看起来好弱，哈哈……";
		mes "去多猎杀一些波利吧！";
		close;
	}
	if (malang_bad_guys == 0) {
		mes "[Gobonge]";
		mes "你愿意听我的悲伤吗？";
		next;
		switch(select("当然愿意。:不，我不愿意。")) {
		case 1:
			mes "[Gobonge]";
			mes "这是个悲伤的故事。";
			mes "和往常一样，我打开袋子，";
			mes "想给奇怪的猫看。";
			mes "结果发生了意外。";
			next;
			mes "[Gobonge]";
			mes "里面有很多罐头。";
			mes "我因为形状不同以为是新的，";
			mes "结果却是坏罐头！";
			mes "我吃太多了，马上就上床，";
			mes "所以什么也做不了……";
			mes "肚子好痛。";
			next;
			mes "[Gobonge]";
			mes "顺便说，你的……";
			mes "衣服很漂亮。";
			mes "我不能让你走，";
			mes "这让我非常难受！";
			emotion ET_CRY;
			next;
			switch(select("你活该受苦！:需要帮助吗？")) {
			case 1:
				mes "[Gobonge]";
				mes "你说得对！";
				close;
			case 2:
				mes "[Gobonge]";
				mes "你知道什么是关怀。";
				mes "请找到那个坏供应商，";
				mes "替我们向敌人复仇！";
				next;
					switch(select("不，我不想做！:是的，我会做！")) {
				case 1:
					mes "[" + strcharinfo(0) + "]";
					mes "为了马来岛的和平，";
					mes "你就永远躺在床上吧。";
					next;
					mes "[Gobonge]";
					mes "我会的！";
					mes "等我痊愈后，我会先让你获得安宁！";
					close;
				case 2:
					mes "[Gobonge]";
					mes "好，你能做到吗？";
					mes "敌人一定在我们拿到货物的码头附近。";
					mes "我们应该让他们帮助照顾猫的健康！";
					setquest 1145;
					set malang_bad_guys,1;
					close;
				}
			}
		case 2:
			mes "[Gobonge]";
			mes "你为什么在这里！";
			mes "我平时会用你的眼泪刻下些什么……";
			mes "不如把你的袋子留在这里吧！";
			mes "这样我就能帮你。";
			emotion ET_CRY;
			close;
		}
	} else if (malang_bad_guys == 1) {
		mes "[Gobonge]";
		mes "敌人一定在我们拿到货物的码头附近。";
		mes "我们应该让他们帮助照顾猫的健康！";
		mes "请去那里调查。";
		mes "不要忘记任务。";
		close;
	} else if (malang_bad_guys > 1 && malang_bad_guys < 7) {
		mes "[Gobonge]";
		mes "我因为缺少禁忌的坏活动而";
		mes "感到非常疲惫。";
		mes "";
		mes "";
		close;
	} else if (malang_bad_guys == 7) {
		if (countitem(6426) > 29) {

		mes "可能使用了毒药。";
		mes "但毒药必须";
		mes "来自";
		mes "卢恩-米德加尔特王国之外……";
		next;
		mes "[玛丽安娜]";
		mes "是啊……";
		mes "制作那些";
		mes "蛇鳞标记的材料";
		mes "有些甚至";
		mes "无法在米德加尔特大陆";
		mes "找到。";
		next;
		mes "[玛丽安娜]";
		mes "我们没时间了。";
		mes "听着，你可以确认是否有人中毒";
		mes "通过将黄色宝石与绿色药水混合，";
		mes "然后把溶液洒在尸体上。";
		mes "";
		next;
		mes "[玛丽安娜]";
		mes "如果使用了毒药，";
		mes "溶液会与尸体反应。";
		mes "但如果谋杀后";
		mes "过去太久，";
		mes "这种方法不会有效。";
		mes "最好尽快尝试……";
		set prt_curse,25;
		close;
	}

OnInit:
	disablenpc "Marjana#poison";
	end;

OnEnable:
	enablenpc "Marjana#poison";
	end;
}

morocc,45,103,0	script	#prtcurse	-1,2,2,{
OnTouch:
	if (prt_curse == 25) {
		mes "["+strcharinfo(0)+"]";
		mes "嗯，我最好复习";
		mes "已知事实，以便更好地";
		mes "专注于";
		mes "调查。让我看看～";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "很久以前，巨蛇";
		mes "耶梦加得威胁人类。";
		mes "七名战士在乔治三世带领下击败耶梦加得，";
		mes "但耶梦加得在败亡时诅咒了乔治家族血脉。";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "从那以后，诅咒会在幼年杀死";
		mes "乔治家族的";
		mes "长子王子。";
		mes "然而这一代的所有王子";
		mes "都被杀害。";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "根据我从";
		mes "刺客那里得知的，";
		mes "第一位王子死于诅咒，";
		mes "另外两位可能";
		mes "死于中毒。";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "如果使用毒药，很可能";
		mes "使用者是来自";
		mes "卢恩-米德加尔特王国之外";
		mes "的刺客。是的，";
		mes "这就是我知道的一切。";
		mes "";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "现在历史学家罗达弗里安";
		mes "在等我告诉她";
		mes "那首歌的歌词，而班普神父也在等";
		mes "我从刺客公会得到的信息。我该怎么办？";
		next;
		if (select("去找罗达弗里安:去找班普神父") == 1) {
			mes "["+strcharinfo(0)+"]";
			mes "嗯，现在去找罗达弗里安更方便。";
			mes "她比班普神父近得多，";
			mes "所以我想先去和她谈谈。";
			mes "我这就出发。";
			mes "先去找她吧。";
			set prt_curse,30;
			//changequest 18041,18042;
			close;
		}
		mes "["+strcharinfo(0)+"]";
		mes "嗯，去见班普神父并调查王子的尸体更重要。";
		mes "我最好马上前往普隆德拉。";
		mes "不能再耽搁了。";
		mes "得尽快查明真相。";
		mes "我现在就走。";
		set prt_curse,50;
		//changequest 18041,18043;
		close;
	}
}

prt_in,162,99,4	script	Librarian#curse	67,{
	if (checkweight(1201,1) == 0) {
		mes "^3355FF请等一下！";
		mes "你现在携带了太多物品。";
		mes "请使用卡普拉服务存放部分物品后，";
		mes "再回来找我。";
		mes "这样就能腾出负重空间。";
		mes "谢谢你的配合。";
		close;
	}
	if (prt_curse == 3) {
		if (countitem(7431) < 1) {
			mes "[图书管理员]";
			mes "使用图书馆的书籍后，";
			mes "请务必将它们放回正确的位置。";
			mes "我们没有足够的人手整理这么多书……";
			mes "请不要把书随处乱放。";
			mes "谢谢。";
			next;
			if (select("报告书籍遗失:结束对话") == 1) {
				mes "[图书管理员]";
				mes "哦，你弄丢了一些书吗？";
				mes "请写下书名，并支付 700 Zeny 的罚金。";
				mes "之后我们会提供替代副本。";
				mes "请如实登记。";
				mes "谢谢你的合作。";
				mes "请尽快处理。";
				next;
				if (Zeny > 699) {
					mes "[图书管理员]";
					mes "好的，给你。";
					mes "请收下这些替代副本，";
					mes "下次尽量不要再弄丢了。谢谢。";
					mes "请妥善保管。";
					mes "祝你阅读愉快。";
					set Zeny, Zeny-700;
					getitem 7431,1; //Books
					close;
				}
				mes "[图书管理员]";
				mes "嗯……";
				mes "请尽快带着 700 Zeny 回来，";
				mes "支付遗失书籍的罚金。";
				mes "在那之前无法办理补书。";
				mes "请不要忘记。";
				close;
			}
			mes "[图书管理员]";
			mes "在图书馆内请保持安静。";
			mes "感谢你的配合。请勿打扰其他读者。";
			mes "祝你使用愉快。请安静阅读。";
			close;
		}
		else {
			mes "[图书管理员]";
			mes "当图书管理员可不轻松。";
			mes "人们总把书散得到处都是，";
			mes "却又希望它们整齐有序。";
			mes "唉，书也总是莫名其妙地丢失……";
			mes "真让人头疼。";
			mes "请大家爱护书籍。";
			next;
			mes "[图书管理员]";
			mes "当你不得不收拾他们留下的";
			mes "烂摊子时，才会发现";
			mes "人们究竟可以多么马虎。";
			mes "请替我们多考虑一下。这样大家都会轻松些。谢谢。";
			mes "请爱护图书。";
			close;
		}
	}
	else {
		mes "[图书管理员]";
		mes "当图书管理员可不轻松。";
		mes "人们总把书散得到处都是，";
		mes "却又希望它们整齐有序。";
		mes "唉，书也总是莫名其妙地丢失……";
		mes "真让人头疼。";
		mes "请大家爱护书籍。";
		next;
		mes "[图书管理员]";
		mes "当你不得不收拾他们留下的";
		mes "烂摊子时，才会发现";
		mes "人们究竟可以多么马虎。";
		mes "请替我们多考虑一下。这样大家都会轻松些。谢谢。";
		mes "请爱护图书。";
		close;
	}
}

			mes "她一直很有名";
			mes "经常这样做，还会哭着";
			mes "向我求助。对吧？";
			next;
			mes "["+strcharinfo(0)+"]";
			mes "很奇怪";
			mes "……她说大门";
			mes "应该会自动修复";
			mes "但最近一直没有。";
			mes "她的行为也很奇怪。";
			mes "";
			next;
			mes "["+strcharinfo(0)+"]";
			mes "她谈到神殿历史、";
			mes "安全系统如何";
			mes "建造。她还提到你，";
			mes "所以我觉得你可能知道。";
			mes "";
			mes "";
			next;
			mes "[帕诺女祭司]";
			mes ".........";
			set ra_tem_q,11;
			close3;
		}
	}
	else if (ra_tem_q == 11) {
		mes "["+strcharinfo(0)+"]";
		mes "我想起来了……！";
		mes "大门关闭时我在那里，听到有人用与你完全相同的声音";
		mes "低声说了某句话，";
		mes "用魔法打开大门！这到底是怎么回事？";
		mes "";
		mes "";
		next;
		mes "[帕诺女祭司]";
		mes "......";
		mes ".........";
		mes "............";
		next;
		mes "[帕诺女祭司]";
		mes "......";
		mes ".........";
		mes "............";
		mes "我们……我的意思是……";
		next;
		cutin "ra_fano01",2;
		mes "[帕诺女祭司]";
		mes "内玛和我都是伟大炼金术师的后代。";
		mes "";
		mes "他们曾进行长期宗教朝圣，";
		mes "最后来到这里。";
		mes "他们建造了这座神殿和安全系统。";
		mes "";
		next;
		mes "[帕诺女祭司]";
		mes "从某种意义上说，这座神殿";
		mes "是祖先的陵墓。祖先离开";
		mes "卢恩-米德加尔特，约一千年前";
		mes "建造了拉赫城。";
		mes "";
		next;
		mes "[帕诺女祭司]";
		mes "几代以来，许多炼金术师离开";
		mes "卢恩-米德加尔特并定居这里，";
		mes "将沙漠变成绿地。";
		mes "";
		mes "这座神殿本应成为";
		mes "抵御入侵者的避难所。";
		next;
		mes "[帕诺女祭司]";
		mes "我的祖先设计神殿安全系统，";
		mes "需要特殊许可";
		mes "才能进入神殿。";
		mes "";
		mes "但入侵者从未出现，";
		mes "我们也就不需要许可证了。";
		next;
		mes "[帕诺女祭司]";
		mes "特殊许可证被处理掉了，";
		mes "但自动安全系统仍留在大门上，";
		mes "以防万一。现在我听说";
		mes "安全系统出现了故障。";
		next;
		cutin "ra_fano03",2;
		mes "[帕诺女祭司]";
		mes "不过，那是不可能的。";
		mes "即使以今天的标准来看，";
		mes "这个系统也设计得十分完善。";
		mes "前段时间我在礼拜堂祈祷时，";
		mes "发现了导致大门出问题的原因。";
		next;
		mes "[帕诺女祭司]";
		mes "突然灯熄灭了，";
		mes "我只能勉强看清周围。";
		mes "正当我准备出去时，";
		mes "我听到楼梯处传来声响。";
		next;
		cutin "ra_fano02",2;
		mes "[帕诺女祭司]";
		mes "据我所知，有人正在把某种东西";
		mes "从圣地运出去。";
		mes "不过我不知道那里存放着什么。";
		mes "我也不是高级女祭司。";
		next;
		mes "[帕诺女祭司]";
		mes "我不确定自己是否想知道那里有什么。";
		mes "我听到的声音像是可怕的怪物嚎叫，";
		mes "实在令人恐惧。";
		next;
		mes "[帕诺女祭司]";
		mes "我惊慌地跑到前方的桌子旁，";
		mes "念出祖先传下来的秘密密码，";
		mes "打开了大门。";
		next;
		cutin "ra_fano01",2;
		mes "[帕诺女祭司]";
		mes "你看，祖先在大门中加入了";
		mes "秘密密码和声音识别功能，";
		mes "以防处理掉神殿许可证后";
		mes "发生什么意外。";
		next;
		mes "[帕诺女祭司]";
		mes "大门表现异常的真正原因";
		mes "不是它坏了，";
		mes "而是有人偷偷进出圣地。";
		next;
		mes "[帕诺女祭司]";
		mes "无论他们是谁，";
		mes "一定是在使用旧神殿许可证";
		mes "来掩盖行踪。现在，";
		mes "你已经知道全部真相了。";
		next;
		cutin "ra_fano01",2;
		mes "[帕诺女祭司]";
		mes "你最好别泄露从我这里听到的事。";
		mes "否则我们肯定都会没命。";
		mes "失陪了，我得回去工作。";
		set ra_tem_q,12;
		close3;
	}
	cutin "ra_fano02",2;
	mes "[帕诺女祭司]";
	mes "这里是神圣的地方。";
	mes "请注意言行，尊重那些";
	mes "专程来此礼拜的人。";
	close3;

L_Lottery:
	if(checkweight(607,1) == 0){
		cutin "ra_fano02",2;
		mes "[帕诺女祭司]";
		mes "你现在携带的物品太多了。";
		mes "如果我给你又大、又重、又碍事的东西，";
		mes "你打算怎么办？";
		mes "先把杂物存进仓库吧。";
		close3;
	}
	mes "[帕诺女祭司]";
	mes "开始吧。";
	mes "兴奋吗？嗯……";
	mes "我一次只能兑换一张彩票。";
	mes "这张彩票的奖励是……";
	next;
	cutin "ra_fano02",2;
	if (countitem(7570) > 0) {
		mes "[帕诺女祭司]";
		mes "^FF0000这个^000000。它在我们的仓库里放了一段时间，";
		mes "希望你能接受它，作为神殿的感谢。";
		mes "愿芙蕾雅因你的慷慨而向你微笑……";
		delitem 7570,1;
		set .@bonus_donate,rand(100);
		if (.@bonus_donate == 99) {
			set .@bonus_donate2,rand(100);
			if (.@bonus_donate2 > 0 && .@bonus_donate2 < 11) getitem 616,1;		//Old Card Album 0.1%
			else if (.@bonus_donate2 > 10 && .@bonus_donate2 < 31) getitem 617,1;	//Old Violet Box 0.2%
			else if (.@bonus_donate2 > 30 && .@bonus_donate2 < 61) getitem 603,1;	//Old Blue Box 0.3%
			else getitem 607,1; //Yggdrasil Berry 0.4+%
		}
		else if (.@bonus_donate > 88 && .@bonus_donate < 96) getitem 644,1;	//Gift Box 7%
		else if (.@bonus_donate > 76 && .@bonus_donate < 89) getitem 607,1;	//Yggdrasil Berry 12%
		else if (.@bonus_donate > 65 && .@bonus_donate < 77) getitem 505,1;	//Blue Potion 11%
		else if (.@bonus_donate > 57 && .@bonus_donate < 66) getitem 604,1;	//Dead Branch 8%
		else if (.@bonus_donate > 45 && .@bonus_donate < 58) getitem 608,1;	//Yggdrasil Seed 12%
		else if (.@bonus_donate > 5 && .@bonus_donate < 11) getitem 518,1;	//Honey 5%
		else if (.@bonus_donate > 0 && .@bonus_donate < 6) getitem 526,1;	//Royal Jelly 5%
		else getitem 547,1; //Condensed White Potion 39%
		close3;
	}
	mes "[帕诺女祭司]";
	mes "你……";
	mes "没有可以兑换的彩票。";
	if ($rachel_donate > 9999) {
		mes "我们现在不发放彩票，";
		mes "不过你可以向朋友要一张。";
	}
	else {
		mes "捐赠 Zeny 后，";
		mes "可以从神殿入口的内玛女祭司那里获得。";
	}
	next;
	cutin "ra_fano03",2;
	mes "[帕诺女祭司]";
	mes "愿芙蕾雅与你同在。";
	close3;

L_End:
	close2;
	cutin "",255;
	end;
}

ra_temin,134,128,3	script	Pope's Office Guard#rac::raofficeguard	926,{
	if ((ra_tem_q == 15) && (countitem(7561) > 39)) {
		mes "[教皇办公室守卫]";
		mes "嗯？你带了什么？哦，你收集了";
		mes "40个冰心，还带来了大祭司的推荐信？";
		mes "真令人佩服。";
		next;
		mes "[教皇办公室守卫]";
		mes "我想我知道你为何而来。";
		mes "谢谢你把这些带给我，";
		mes "我会让你进去见教皇。";
		mes "欢迎你，勇敢的"+strcharinfo(0)+"。";
		close2;
		set ra_tem_q,16;
		delitem 7561,40; //Ice_Heart
		end;
	}
	else if (ra_tem_q == 16) {
		mes "[教皇办公室守卫]";
		mes "教皇正在里面等你，";
		mes "请别让她等太久。";
		close;
	}
	else if (MISC_QUEST & 8192) {
		if ((aru_em == 15) || (aru_em == 21)) {
			mes "- 内伦让我去教皇办公室拜访教皇…… -";
			close;
		}
		else {
			mes "[教皇办公室守卫]";
			mes "抱歉，外来者通常不允许";
			mes "在没有特殊授权的情况下";
			mes "拜访教皇。";
			close;
		}
	}
	else {
		mes "[教皇办公室守卫]";
		mes "抱歉，教皇现在正在主持礼拜。";
		mes "请在礼拜结束后再回来。";
		close;
	}
}


		next;
		mes "[尼伦]";
		mes "他们一定做了什么，或者它回来了……";
		mes "这可能满足查看^4d4dff王室过去记忆^000000封印部分的条件……";
		next;
		select("你是说那些知道真相的人？");
		mes "[尼伦]";
		mes "是的，我是这个意思。如果这就是开启封印的关键真相，";
		mes "我们带回了一条重要信息。";
		next;
		mes "[尼伦]";
		mes "我们没有保护，也没有带走那件东西……";
		mes "但我们现在知道真相了。它会打破文件的封印……";
		next;
		mes "[尼伦]";
		mes "随着王室秘密揭露，我们会得到谜题缺失的碎片。";
		mes "哈哈哈，而你就是这一切的中心，亲爱的！";
		next;
		select("别这样叫我！");
		mes "[尼伦]";
		mes "那又怎样？";
		mes "从现在起我们每天都会见面，对吧？";
		unittalk getcharid(3), "" + strcharinfo(0) + " : ......Phew..", bc_self;
		next;
		mes "[尼伦]";
		mes "那么，我们回去吧？";
		mes "我们在这里的任务暂时完成了！";
		next;
		mes "[尼伦]";
		mes "回去吧！";
		mes "在不属于我们时代的地方待太久不会有好事。";
		next;
		mes "[尼伦]";
		mes "那么，准备好！";
		mes "三！";
		sleep2 2000;
		mes "二！";
		sleep2 1000;
		mes "一！";
		close2;
		warp "prt_lib",88,80;
		end;
	}
	if (ep16_royal > 23) {
		mes "[尼伦]";
		mes "哈哈哈，我现在喜欢这里了。";
		mes "亲爱的，你现在想让我做什么？";
		next;
		if (select( "连接意识之室", "返回" ) == 2) {
			mes "[尼伦]";
			mes "如你所愿！";
			close2;
			warp "prt_lib_q",89,43;
			end;
		}
		switch( checkquest(7706,PLAYTIME) ) {
		case -1:
			switch( checkquest(7705,HUNTING) ) {
			case -1:
				mes "[尼伦]";
				mes "你接到海涅家族的任务了吗？";
				mes "好像不是这样。";
				next;
				mes "[尼伦]";
				mes "嘿，这真是辛苦活！";
				mes "有任务时再去那里，好吗？";
				next;
				mes "[尼伦]";
				mes "看到我眼下的黑眼圈了吗？";
				mes "我会按你想做的去做，但是！";
				next;
				mes "[尼伦]";
				mes "这太过分了。";
				mes "我们不能过多改变过去的事件。";
				mes "那些人现在一定已经知道了。";
				next;
				mes "[尼伦]";
				mes "嗯，我想解释也没用……";
				next;
				mes "[尼伦]";
				mes "如果他们完全不知道就好了。";
				mes "这可能会变成对他们的另一种折磨，啧啧……";
				next;
				mes "[尼伦]";
				mes "因此，作为尽职的公务员！";
				mes "有任务时我就会打开大门。";
				next;
				mes "[尼伦]";
				mes "为什么？";
				mes "因为我累了——";
				close;
			case 0:
			case 1:
				if (getcharid(1) == 0 || is_party_leader() == false) {
					mes "^4d4dff这是纪念活动。";
				mes "只有队长可以进行纪念活动。组队后再试。^000000";
					close;
				}
				mes "[尼伦]";
				mes "那么去意识之室看看发生了什么。";
				mes "因为我要再次强行连接扭曲的时空，";
				mes "可能必须用尽全力维持它！";
				next;
				mes "[尼伦]";
				mes "请活着平安回来——";
				next;
				if (select( "现在连接。", "不要去。" ) == 2) {
					mes "[尼伦]";
				mes "哈哈，太迟了也不好……";
					close;
				}
				if (instance_create("Room of Consciousness") < 0) {
					mes "[尼伦]";
				mes "哦……效果不太好。";
				mes "等等，呼……让我重新积蓄力量……";
					next;
					mes "[尼伦]";
				mes "……我会让它成功的，等一下。";
					close;
				}
				mes "[尼伦]";
				mes "哇！通往下个区域的大门启动了！";
				mes "那么，我们进去吧！";
				cloakoffnpcself( "Swaying Space#evt_gate02" );
				close;
			case 2:
				mes "[尼伦]";
				mes "哈，既然我们的工作完成了，你要去向斯托尔茨大公报告，对吧？";
				mes "哈哈，今天就到这里——";
				next;
				mes "[尼伦]";
				mes "呼，维持它真难。太难了。";
				close;
			}
		case 0:
		case 1:
			mes "[尼伦]";
			mes "嗯……恐怕很难。";
			mes "即使是我这样的天才魔法师也有极限。毕竟我也是人。";
			next;
			mes "[尼伦]";
			mes "连接多个次元没有听起来那么容易。";
			mes "请体谅我一下！";
			next;
			mes "[尼伦]";
			mes "等狂暴的魔力流稳定后再做吧——？？？？";
			close;
		case 2:
			erasequest 7706;// Nillem Is Not Almighty
			mes "[尼伦]";
			mes "嗯……要不要先清理一下周围？";
			mes "等等，我准备一下。";
			next;
			mes "[尼伦]";
			mes "不会花太久，请稍等。";
			close;
		}
	}
}

prt_lib_q,88,90,1	script	Swaying Space#evt_gate02	4_ENERGY_RED,{
	if (checkquest(7706,PLAYTIME) > 0 || checkquest(7705,HUNTING) > 1) {
		mes "扭曲空间附近可以感受到不安的魔力流。";
		mes "强行连接的裂隙完成使命后消失了。";
		cloakonnpcself( "Swaying Space#evt_gate02" );
		close;
	}
	if (getcharid(1) == 0 || is_party_leader() == false) {// solo instance
		mes "^4d4dff只有队长可以进入副本[意识之室]。^000000";
		close;
	}
	if ((ep16_royal == 19 && isbegin_quest(7700) == 1) || (ep16_royal > 19 && (checkquest(7705,HUNTING) == 0 || checkquest(7705,HUNTING) == 1))) {
		mes "你可以移动到过去存放伊米尔之心碎片的地方。";
		next;
		if (select( "Enter.", "Do not enter." ) == 2) {
			mes "[尼伦]";
			mes "嗯，我刚刚强行撕开并连接了这些空间。";
			mes "因为我是天才，这种事当然做得到！";
			close;
		}
		if (getcharid(1) == 0 || is_party_leader() == false) {
			mes "^4d4dff只有队长可以进入副本[意识之室]。^000000";
			close;
		}
		switch( instance_enter("Room of Consciousness") ) {
		case IE_OTHER:
			mes "[尼伦]";
			mes "哦，魔力的流动似乎不太稳定。";
			mes "嗯，我们晚点再试？";
			close;
		case IE_NOINSTANCE:
			mes "[尼伦]";
			mes "嗯，强行连接太难了吗？";
			mes "等一下。";
			close;
		case IE_NOMEMBER:
			mes "^4d4dff这是通过纪念活动进行的事件。";
			mes "只有队长可以进入。^000000";
			close;
		case IE_OK:
			mapannounce strnpcinfo(4), "队伍成员" + strcharinfo(0) + "进入了队伍“" + getpartyname( getcharid(1) ) + "”的意识之室。", bc_map,0xFF99,FW_NORMAL,12;
			//warp "1@mir",101,10;
			end;
		}
	}
	end;
OnInit:
	cloakonnpc();
	end;
}


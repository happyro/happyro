// Left side
prt_cas,213,177,5	script	Royal Chef#ep16_1	1_ETC_01,4,4,{
	if (ep16_royal >= 2) {
		if (ep16_cookbs == 0)
			callsub S_Text;
	}
	if (ep16_cookbs == 1) {
		mes "[王室厨师]";
		mes "主厨一直在等你，现在已经怒火中烧！";
		mes "现在就去厨房！";
		close;
	}
	if (ep16_cookbs > 22) {
		mes "[王室厨师]";
		mes "我每天都忙得团团转！";
		mes "最近见的人太多，连熟人的脸都分不清了。";
		next;
		mes "[王室厨师]";
		mes "抱歉造成了误会。";
		mes "主厨一直催得太紧了……哈哈……";
		emotion ET_PROFUSELY_SWEAT;
		close;
	}
	mes "[王室厨师]";
	mes "我每天都忙得团团转！";
	mes "最近见的人太多，连熟人的脸都分不清了。";
	close;

S_Text:
	mes "[王室厨师]";
	mes "嘿，你！我一直在找你！";
	mes "你在这里做什么？";
	emotion ET_SURPRISE;
	next;
	mes "[王室厨师]";
	mes "主厨一直在等你，现在已经怒火中烧！";
	mes "现在就去厨房！";
	ep16_cookbs = 1;
	setquest 11394;// Call of the Royal Head Chef
	close;

OnTouch:
	if (ep16_cookbs == 0 && ep16_royal >= 2)
		callsub S_Text;
	end;
}

// Kitchen
prt_cas,309,200,5	script	Royal Head Chef#ep16_1	4_EP16_COOK,{
	if (ep16_royal < 2 || ep16_cookbs == 0) {
		mes "[主厨]";
		mes "啊！";
		mes "这位特别助手厨师什么时候才到？";
		emotion ET_FRET;
		cutin "ep16cook_king_1",2;
		close3;
	}
	if (ep16_cookbs == 1) {
		mes "[主厨]";
		mes "啊！";
		mes "这位特别助手厨师什么时候才到？";
		emotion ET_FRET;
		cutin "ep16cook_king_1",2;
		next;
		mes "[主厨]";
		mes "当然！";
		mes "宴会的食物完美无缺！";
		next;
		mes "[主厨]";
		mes "更多！";
		mes "更多！";
		mes "更多！";
		mes "还要更多！";
		mes "我要满足客人！";
		next;
		mes "[主厨]";
		mes "我不能让人生中如此华丽的宴会就这样结束！";
		mes "应该更加华丽！";
		mes "不，要华丽得多！";
		next;
		mes "[主厨]";
		mes "嗯……";
		mes "如果不奇迹般奢华、无与伦比地华丽，我就不会满足！";
		emotion ET_FRET;
		next;
		cutin "",255;
		mes "[王室厨师学徒]";
		mes "主厨！";
		mes "主厨，有客人找你……";
		next;
		mes "[主厨]";
		mes "你迟到了！";
		mes "连一秒钟都不能浪费，你怎么能迟到！";
		emotion ET_FRET;
		cutin "ep16cook_king_1",2;
		next;
		mes "[主厨]";
		mes "我本来要把你派到波利牧场一周！";
		mes "但今天是特殊日子，所以之后再惩罚你！";
		next;
		select("询问情况。");
		mes "[主厨]";
		mes "现在这不是最重要的事！";
		mes "别说了，让宴会变得更加华丽吧！";
		next;
		mes "[主厨]";
		mes "去空地准备烹饪！";
		next;
		mes "[主厨]";
		mes "准备好一块狮鹫肉后……你需要浇上酱汁……什么？";
		mes "酱汁……呃？";
		emotion ET_SURPRISE;
		next;
		mes "[主厨]";
		mes "等一下！";
		mes "酱汁不见了！难以置信！";
		mes "没有酱汁我们什么也做不了！";
		next;
		mes "[主厨]";
		mes "你！新来的助手！";
		mes "去向东方牡蛎酱汁大师拿酱汁！";
		emotion ET_HELP;
		next;
		mes "[主厨]";
		mes "现在！快！";
		mes "快点！";
		erasequest 11394;// Call of the Royal Head Chef
		setquest 11395;// Why Should I Prepare for the Banquets?
		ep16_cookbs = 2;
		close3;
	}
	if (ep16_cookbs < 12) {
		mes "[主厨]";
		mes "酱汁还没准备好吗？";
		mes "去向东方牡蛎酱汁大师拿酱汁！";
		emotion ET_HELP;
		cutin "ep16cook_king_1",2;
		next;
		mes "[主厨]";
		mes "现在！快！";
		mes "快点！";
		close3;
	}
	if (ep16_cookbs == 12) {
		mes "[主厨]";
		mes "哦！";
		mes "大师制作的绝妙味道！";
		mes "完美！";
		cutin "ep16cook_king_1",2;
		next;
		mes "[主厨]";
		mes "现在开始烹饪！";
		mes "去空地准备。";
		erasequest 11397;// Why Should I Prepare for the Banquets?
		setquest 11398;// Why Should I Prepare for the Banquets?
		ep16_cookbs = 13;
		close3;
	}
	if (ep16_cookbs == 13) {
		mes "[主厨]";
		mes "现在开始烹饪！";
		mes "去空地准备。";
		cutin "ep16cook_king_1",2;
		close3;
	}
	if (ep16_cookbs == 14) {
		mes "[主厨]";
		mes "现在把这个送到厨房。只剩这一件事了！";
		cutin "ep16cook_king_1",2;
		next;
		mes "[主厨]";
		mes "你还在等什么！";
		mes "带着这道菜跑去餐厅！";
		next;
		mes "[主厨]";
		mes "王室厨师必须尽快填满空盘子！";
		close3;
	}
	if (ep16_cookbs < 22) {
		mes "[主厨]";
		mes "啊啊啊！";
		mes "烹饪的意志！";
		mes "女王的意志！";
		cutin "ep16cook_king_1",2;
		next;
		mes "[主厨]";
		mes "凭借我炽热的精神！";
		mes "我要做出最棒的菜！";
		close3;
	}
	if (ep16_cookbs == 22) {
		if (checkweight(1119,3) == 0) {
			mes "- 你携带的物品太多。";
			mes "请整理背包后再试。-";
			close;
		}
		mes "[主厨]";
		mes "啊啊啊啊！";
		mes "对不起！";
		emotion ET_SORRY;
		cutin "ep16cook_king_1",2;
		next;
		mes "[主厨]";
		mes "我以为你是应该来的新助手厨师。给你添麻烦了，抱歉！";
		next;
		mes "[主厨]";
		mes "我已经训斥了把你带来的那个人，英雄。请原谅我们！";
		next;
		mes "[主厨]";
		mes "不过，你似乎真的很有烹饪天赋！";
		mes "烤狮鹫！";
		mes "真好吃！";
		next;
		mes "[主厨]";
		mes "希望还能再次和你一起烹饪！";
		cutin "ep16cook_king_2",2;

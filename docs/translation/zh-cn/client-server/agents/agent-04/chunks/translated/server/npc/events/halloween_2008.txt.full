//===== rAthena Script =======================================
//= iRO Halloween (2008)
//===== By: ==================================================
//= Kisuka
//===== Current Version: =====================================
//= 1.1
//===== Compatible With: =====================================
//= rAthena Project
//===== Description: =========================================
//= iRO Halloween (2008)
//= Run away from the zombies for tickets.
//= Redeem tickets for prizes.
//===== Notes: ===============================================
//= You must enable the event monsters in mob_db2.
//===== Additional Comments: =================================
//= 1.0 First version. [Kisuka]
//= 1.1 Some small changes. [Kisuka]
//============================================================

payon,162,176,4	script	Halloween Magician#iRO08	704,{
	if (Hallow08 < 1) {
		mes "[Halloween Magician]";
		mes "Kkkkkkkkk!";
		mes "今年万圣节我有一个考验运气和敏捷的特别活动。";
		mes "你感兴趣吗？";
		next;
		mes "[Halloween Magician]";
		mes "来吧！别胆小！";
		mes "收集足够的票就能换好奖品！";
		mes "怎么样？";
		next;
		goto MainMenu;
	}
	if (Hallow08Kill == 1) {
		mes "[Halloween Magician]";
		mes "你是胆小鬼吗？！";
		mes "你明明想再试一次……";
		mes "你知道规则吗？";
		next;
		set Hallow08Kill,0;
		if(select("是，我知道。:不，我不知道。") == 2) {
			goto Rules;
		}
		goto Participate;
	}
	if (Hallow08Kill == 2) {
		mes "[Halloween Magician]";
		mes "哦，做得好！你没事！";
		mes "和僵尸一起玩很有趣吧？";
		mes "你知道，僵尸也曾是人！";
		mes "Ha!";
		mes "Kkkkkkk.";
		next;
		getitem 7941,1;
		set Hallow08Kill,0;
		mes "[Halloween Magician]";
		mes "正如我承诺的，";
		mes "你可以用万圣节票兑换酷炫物品。";
		close;
	}
	if (Hallow08 > 0) {
		mes "[Halloween Magician]";
		mes "你想再听一遍规则，还是直接继续……";
		next;
		goto MainMenu2;
	}

		Rules:
			mes "[Halloween Magician]";
			mes "这个村庄就像虚拟的斐扬。";
			mes "僵尸和食尸鬼四处游荡，南边有三个出口，但只有一个有效。";
			mes "要由你找出正确的出口。";
			next;
			mes "[Halloween Magician]";
			mes "不能使用技能杀死食尸鬼或僵尸。";
			mes "还有一件事……";
			mes "你不该忘记……";
			next;
			mes "[Halloween Magician]";
			mes "所有参加者都不能穿戴装备。";
			mes "把物品放进仓库，重量为‘0’后再回来。";
			next;
			mes "[Halloween Magician]";
			mes "哦，还有一件事！";
			mes "不能骑大嘴鸟或使用手推车。";
			mes "如果有，我会在你进入前移除。明白了吗？";
			next;
			mes "[Halloween Magician]";
			mes "记住，三个出口中随机只有一个有效，僵尸和食尸鬼无法杀死，你也不能穿戴任何东西。";
			next;
			if (Hallow08 > 0) {
			mes "[Halloween Magician]";
				mes "嘿……";
				mes "准备好后再回来。";
				close;
				} else {
			goto MainMenu;
				}
			
Participate:
		mes "[Halloween Magician]";
			mes "好，你准备好了。";
			mes "让我检查你的重量。";
			next;
			if (Weight > 0) {
			mes "[Halloween Magician]";
				mes "天哪！";
				mes "哪里都有害群之马。";
				next;
				mes "[Halloween Magician]";
				mes "你以为我没注意到你的重量超过‘0’吗？";
				mes "你超重了……";
				close;
				} else {
			mes "[Halloween Magician]";
				mes "你看起来可以出发，重量也刚好。";
				next;
				mes "[Halloween Magician]";
				mes "工作太忙了，我很疲惫。";
				next;
				mes "[Halloween Magician]";
				mes "我有时会忘记送你进去……";
				next;
				mes "[Halloween Magician]";
				mes "希望你平安回来。";
				close2;
				if (Hallow08 < 1) {
				set Hallow08,1;
					}
				set Hallow08Kill,1;
				set @Hallow08Warp, rand(1,3);
				percentheal -98,0;
				setriding 0;
				setcart 0;
				warp "evt_zombie",155,246;
				end;
				}
			
TicketExchange:
		mes "[Halloween Magician]";
			mes "你想用票兑换奖品？";
			mes "干得好！咯咯咯！";
			next;
			mes "[Halloween Magician]";
			mes "我告诉你可以兑换哪些物品。";
			next;
			mes "[Halloween Magician]";
			mes "5 张票兑换南瓜派。";
			mes "20 张票兑换南瓜头。";
			mes "50 张票兑换旧蓝箱。";
			mes "70 张票兑换旧紫箱。";
			mes "200 张票兑换旧卡册。";
			next;
			mes "[Halloween Magician]";
			mes "你想兑换什么？";
			next;
			switch(select("南瓜派:南瓜头:旧蓝箱:旧紫箱:旧卡册")) {
			case 1:
			if (countitem(7941) < 5) {
				goto NotEnough;
					} else {
				delitem 7941,5;
					getitem 12192,1;
					goto Enough;
					}
				break;
				case 2:
			if (countitem(7941) < 20) {
				goto NotEnough;
					} else {
				delitem 7941,20;
					getitem 5134,1;
					goto Enough;
					}
				break;
				case 3:
			if (countitem(7941) < 50) {
				goto NotEnough;
					} else {
				delitem 7941,50;
					getitem 603,1;
					goto Enough;
					}
				break;
				case 4:
			if (countitem(7941) < 70) {
				goto NotEnough;
					} else {
				delitem 7941,70;
					getitem 617,1;
					goto Enough;
					}
				break;
				case 5:
			if (countitem(7941) < 200) {
				goto NotEnough;
					} else {
				delitem 7941,200;
					getitem 616,1;
					goto Enough;
					}
				}
			
NextTime:
		mes "[Halloween Magician]";
			mes "好的，到时见。";
			mes "Kkkkkkkk.";
			close;
			
MainMenu:
		menu "向我说明规则。",Rules,"我想参加。",Participate,"我想用票券兑换奖励。",TicketExchange,"我下次再来。",NextTime;
		
MainMenu2:
		menu "现在把我送回去！",Participate,"请告诉我规则",Rules,"我想用票券兑换奖励。",TicketExchange,"我下次再来。",NextTime;
		
NotEnough:
	mes "[Halloween Magician]";
		mes "你的票券不够！";
		mes "你连数都不会吗？";
		mes "请带足正确数量的票券再来。";
		close;
		
Enough:
	mes "[Halloween Magician]";
		mes "给你。";
		mes "还需要……";
		mes "其他东西吗？";
		next;
		if (Hallow08 == 1) {
		goto MainMenu2;
			} else {
		goto MainMenu;
			}
		}
//

evt_zombie,16,142,1	script	zombiewarp001	45,2,2,{
OnTouch:
	if (@Hallow08Warp == 1) {
		set Hallow08Kill,2;
		specialeffect EF_BASH;
		warp "payon",28,142;
	}
	end;
}

evt_zombie,122,27,1	script	zombiewarp002	45,2,2,{
OnTouch:
	if (@Hallow08Warp == 2) {
		set Hallow08Kill,2;
		specialeffect EF_BASH;
		warp "payon",121,40;
	}
	end;
}

evt_zombie,267,89,1	script	zombiewarp003	45,2,2,{
OnTouch:
	if (@Hallow08Warp == 3) {
		set Hallow08Kill,2;
		specialeffect EF_BASH;
		warp "payon",253,95;
	}
	end;
}

evt_zombie,0,0	monster	Zombie	3000,150
evt_zombie,0,0	monster	Ghoul	3001,80
evt_zombie,0,0	monster	Zombie Master	3002,20

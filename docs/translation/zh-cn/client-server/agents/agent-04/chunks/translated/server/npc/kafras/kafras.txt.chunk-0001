//===== rAthena Script ======================================= 
//= Kafras (Cities/Dungeons/Fields)
//===== By: ================================================== 
//= Joseph
//===== Current Version: ===================================== 
//= 1.1b
//===== Compatible With: ===================================== 
//= rAthena Project
//===== Description: =========================================
//= Argument settings for callfunc "F_Kafra":
//=  arg(0): 0 - Default Kafra message
//=          1 - Niflhiem Kafra message
//=          2 - Guild Kafra message
//=  arg(1): 1 - Disable teleport menu 
//=  arg(2): 1 - Disable info menu
//=  arg(3): Cost of Storage service
//=  arg(4): Cost of Rent a Pushcart service
//===== Additional Comments: ================================= 
//= 0.x Previous Authors: 
//=     - L0ne_W0lf, kobra_k88, Samuray22, Evera, Lupus
//= 1.0 Merged and cleaned up Kafras. [Joseph]
//= 1.1 Added Izlude RE coordinates. [Euphy]
//= 1.1a Fixed Pre-RE Call and some leftovers. [Lemongrass]
//= 1.1b Enabled saving in Izlude duplicates (RE). [Euphy]
//============================================================ 

// Aldebaran
//============================================================
aldeba_in,96,181,4	script	Kafra Service	113,{
	cutin "kafra_05",2;
	mes "[卡普拉·莱拉]";
	mes "嗯……？";
	mes "哦，欢迎来到";
	mes "卡普拉公司";
	mes "总部。你需要";
	mes "什么吗？";
	next;
	switch(select("Save:Use Storage:Rent a Pushcart:Cancel")) {
	case 1:
		mes "[卡普拉·莱拉]";
		mes "你的复活点已经";
		mes "保存在这里，即";
		mes "卡普拉公司";
		mes "总部。谢谢。";
		next;
		savepoint "aldeba_in",96,179,1,1;
		mes "[卡普拉·莱拉]";
		mes "请使用遍布";
		mes "米德加尔特各地的";
		mes "卡普拉服务。感谢";
		mes "你访问卡普拉公司总部。";
		mes "";
		close2;
		break;
	case 2:
		if (Zeny < 20) {
			mes "[卡普拉·莱拉]";
			mes "不好意思，但看起来";
			mes "你没有";
			mes "支付20 Zeny仓库访问费";
			mes "……";
			close3;
		}
		mes "[卡普拉·莱拉]";
		mes "虽然这里主要用于";
		mes "卡普拉员工培训";
		mes "和行政工作，";
		mes "";
		mes "我还是会为你打开仓库。";
		next;
		set Zeny, Zeny-20;
		set RESRVPTS, RESRVPTS + (20/5);
		mes "[卡普拉·莱拉]";
		mes "以后如果想使用卡普拉服务，";
		mes "请向当班卡普拉员工咨询。";
		mes "感谢你的惠顾。";
		mes "";
		mes "";
		callfunc("F_CheckKafCode");    //check your storage password, if set
		close2;
		openstorage;
		break;
	case 3:
		mes "[卡普拉·莱拉]";
		mes "很抱歉，我现在不当班。";
		mes "我也想帮你，但手头没有可用的手推车。";
		mes "请找其他卡普拉员工帮忙吧。";
		mes "";
		mes "";
		mes "";
		next;
		mes "[卡普拉·莱拉]";
		mes "卡普拉员工遍布米德加尔特大陆，";
		mes "在艾尔迪巴兰城外就能找到很多。";
		mes "";
		mes "";
		mes "";
		close2;
		break;
	case 4:
		mes "[卡普拉·莱拉]";
		mes "^666666*呼……*^000000";
		mes "太好了，我现在正好在休息。";
		mes "你选择‘取消’真是明智。";
		mes "";
		mes "";
		mes "";
		close2;
		break;
	}
	cutin "",255;
	end;
}

aldebaran,143,119,4	script	Kafra Employee::kaf_aldebaran	113,{
	cutin "kafra_05",2;
	callfunc "F_KafSet";
	mes "[卡普拉员工]";
	mes "卡普拉公司始终致力于";
	mes "为你提供便利的服务。";
	mes "我能为你做些什么？";
	callfunc "F_Kafra",5,0,1,20,600;
	savepoint "aldebaran",143,109,1,1;
	callfunc "F_KafEnd",0,1,"in the city of Al De Baran";
}


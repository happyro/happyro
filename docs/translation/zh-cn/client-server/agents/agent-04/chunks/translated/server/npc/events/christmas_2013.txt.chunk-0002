		mes "糟糕，我竟然说出声了！";
		next;
		set .@cu_bre, rand(1,10);
		if (.@cu_bre < 3) {
			mes "[Angry Woman]";
			mes "什么？你刚才说什么？我们该分手？你怎么能这样说？！做错一切的人明明是你！好吧，分手吧！我受够了！";
			set xmas2013_01, xmas2013_01 + 2;
			hideonnpc "Frightened Man#xmas";
			hideonnpc "Angry Woman#xmas";
			initnpctimer;
			next;
			mes "[Frightened Man]";
			mes "不，我不是这个意思……好吧，就这样！我也受够了，受够你一直抱怨！今天就结束吧！！";
			next;
			mes "- 成功拆散一对情侣！！";
			mes "- 2 分！";
		} else if (.@cu_bre > 7) {
			mes "[Angry Woman]";
			mes "什么？……你刚才说什么？我们该分手？";
			if (xmas2013_01 > 0)
				set xmas2013_01, xmas2013_01 - 1;
			hideonnpc "Frightened Man#xmas";
			hideonnpc "Angry Woman#xmas";
			initnpctimer;
			next;
			mes "[Angry Woman]";
			mes "真不敢相信你能这么强硬！我仿佛又爱上你了！";
			next;
			mes "[Angry Woman]";
			mes "亲爱的，能再强硬地说一次吗？";
			next;
			mes "[Frightened Man]";
			mes "嗯？好……那就……结束吧！！！";
			next;
			mes "[Angry Woman]";
			mes "哈哈哈哈！你太棒了！再说一次！快说！";
			next;
			mes "[Frightened Man]";
			mes "分手吧！我要离开你！！";
			next;
			mes "[Angry Woman]";
			mes "哈哈哈哈哈哈！耶！你最棒！";
			next;
			mes "- ……这些人不正常。";
			mes "- 失败，扣 1 分！";
		} else {
			set xmas2013_01, xmas2013_01 + 1;
			hideonnpc "Frightened Man#xmas";
			hideonnpc "Angry Woman#xmas";
			initnpctimer;
			mes "[Angry Woman]";
			mes "什么？……你刚才说什么？我们该分手？";
			next;
			mes "[Angry Woman]";
			mes "……我想我们现在都太激动了。以后再谈吧……";
			next;
			mes "[Frightened Man]";
			mes "嗯……啊，是的，你说得对……再见，安全回家……";
			next;
			mes "- 破坏约会，获得 1 分！";
		}
	mes "-当前情侣拆散点数为 " + xmas2013_01 + "。";
		close;
	} else if (isbegin_quest(15056) == 1 && xmas2013_01 > 4) {
		mes "-情侣拆散点数";
		mes "-现在超过 5 分。";
		mes "-我该回去找联盟指挥官 Cliff。";
		close;
	}
	end;
OnTimer100000:
	hideoffnpc "Frightened Man#xmas";
	hideoffnpc "Angry Woman#xmas";
	stopnpctimer;
	end;

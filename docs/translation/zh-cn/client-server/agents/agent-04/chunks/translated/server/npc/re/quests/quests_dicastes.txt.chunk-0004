dic_in01,158,188,3	script	Jarute HesLanta#ep133_2	451,{
	if (!isequipped(2782)) {
		mes "[贾鲁特·赫斯兰塔]";
		mes "����� �� ������?";
		mes "������ �� ������ �� �С���...";
		mes "����� �� ����� ��..!";
		next;
		mes "无法和他交流。";
		mes "萨帕大臣看起来绝望。";
		mes "他做出放弃般的手势。";
		next;
		select("他是在让我离开吗？:还是他也不知道？");
		mes "我跟随大臣的手势，大臣叹气并点了点头。";
		close2;
		warp "dic_in01",144,188;
		end;
	}
	if (ep13_3_secret < 19) {
		mes "[赫斯兰塔]";
		mes "你来自米德加尔特远征队。";
		mes "我听说过很多你在这里活动的故事。";
		next;
		mes "[赫斯兰塔]";
		mes "啊，有点远，对吧？";
		mes "这个房间和走廊之间有一堵看不见的墙。";
		mes "不过我当然可以自由走动。";
		next;
		mes "[赫斯兰塔]";
		mes "没有什么会威胁迪尔，但我们还是设置了这堵墙以防万一。";
		mes "顺便说，这不是魔法，而是由磁场制造的。";
		next;
		mes "[赫斯兰塔]";
		mes "哦不，我说太多了。";
		mes "抱歉。来这里的人不多，我有些兴奋。";
		next;
		mes "[赫斯兰塔]";
		mes "你是来帮助阿哈特的吗？";
		mes "哈哈……祝你好运。";
		close;
	}
	else if (ep13_3_secret == 19 || ep13_3_secret == 20) {
		if (ep13_3_secret == 19) {
			mes "[赫斯兰塔]";
			mes "抱歉突然把你带到这里。";
			mes "但我想确认一个人。";
			next;
			mes "[赫斯兰塔]";
			mes "贾鲁特……阿哈特在你看来是什么样的人？";
			next;
			set .@m, select("我不明白你的问题。:我的主人。") - 1;
			if (.@m) {
				mes "[赫斯兰塔]";
				mes "……嗯……？";
				mes "是吗？看来是我弄错了。";
				mes "抱歉。";
				next;
				mes "赫斯兰塔因我的回答而烦恼。";
				mes "他的表情复杂而阴沉。";
				set ep13_3_secret, 20;
				close;
			}
			mes "[赫斯兰塔]";
			mes "我换个说法。";
			mes "你发现阿哈特有什么奇怪之处吗？";
			next;
			select("你为什么问？");
			mes "[赫斯兰塔]";
			mes "因为我不信任阿哈特。";
			mes "阿哈特身上有太多奇怪之处。";
			next;
			select("你可以这么说吗？");
		}
		else if (ep13_3_secret == 20) {
			mes "[赫斯兰塔]";
			mes "啊，抱歉。";
			mes "你出不去吗？";
			mes "这是设计如此。";
			mes "我送你出去。";
			next;
			select("我刚才是在开玩笑。");
			mes "[" + strcharinfo(0) + "]";
			mes "我也想了解阿哈特。";
			mes "我想和你谈谈他。";
			mes "但我这样说话时，你不是太没有防备了吗？";
			next;
		}
		mes "[赫斯兰塔]";
		mes "那么，你是阿哈特的仆人？";
		mes "那也很奇怪。";
		mes "阿哈特为什么会让非萨帕当仆人？";
		mes "你为什么侍奉阿哈特？";
		next;
		select("如果我伤害你呢？");
		mes "[赫斯兰塔]";
		mes "有本事就试试。";
		mes "我的办公室很特殊，你无法离开这里。";
		mes "也不会有人进来帮你。";
		next;
		mes "[赫斯兰塔]";
		mes "不过这个房间对任何人开放。";
		mes "如果你有伤害我的坏心思，勇敢的加尔滕斯会来";
		mes "给你一个教训。";
		next;
		mes "[赫斯兰塔]";
		mes "还有一件事。如果事情这样发展，你和阿哈特都没有胜算。";
		next;
		mes "[赫斯兰塔]";
		mes "我现在正拿生命冒险，";
		mes "为了揭露阿哈特的身份。";
		mes "萨帕不惧怕死亡。";
		next;
		mes "[赫斯兰塔]";
		mes "如果我死在你手中，";
		mes "只要能揭露真相，我就没有遗憾。";
		next;
		select("好了，停下。");
		mes "[赫斯兰塔]";
		mes "现在你明白了。";
		mes "我再问一次。";
		mes "你发现阿哈特有什么可疑之处吗？";
		next;
		mes "[赫斯兰塔]";
		mes "阿哈特几乎不见除拉维尔之外的任何人。";
		mes "但他允许你去见他，说明一定发生了什么。";
		next;
		select("他对我施了法术。");
		mes "[赫斯兰塔]";
		mes "催眠？他为什么要这么做？";
		mes "等等，这意味着你受阿哈特的法术控制……！！";
		mes "Oh no!";
		next;
		select("不是！:不是那样！");
		mes "[" + strcharinfo(0) + "]";
		mes "我没有被法术控制！";
		mes "我只是装出来的。我也在调查阿哈特！";
		next;
		mes "[赫斯兰塔]";
		mes "嗯？什么意思？";
		mes "你现在是在演戏吗？";
		next;
		mes "你拿出在裂缝附近发现的痕迹。";
		mes "并开始解释阿哈特命令你做的事。";
		next;
		mes "[赫斯兰塔]";
		mes "……你经历了那些……";
		mes "他很奇怪。";
		mes "我只以为他是避开诅咒的萨帕同僚。";
		mes "原来一切都始于裂缝。";
		next;
		select("他是人类。");
		mes "[" + strcharinfo(0) + "]";
		mes "迪卡斯特斯最近才允许人类访问。";
		mes "为什么人类会取代萨帕贾鲁特的位置？";
		next;
		mes "[赫斯兰塔]";
		mes "人类？";
		mes "他是萨帕，而且是非常美丽高贵的萨帕。";
		mes "我们第一次在裂缝旁发现他时，都有同样的想法。";
		next;
		mes "[赫斯兰塔]";
		mes "唯一避开诅咒的萨帕。";
		mes "因为阿哈特不使用布拉迪姆。";
		mes "我们的族人会因这个诅咒僵硬而死，";
		mes "但他纤细、优雅而美丽。";
		next;
		mes "[赫斯兰塔]";
		mes "这里北方的大地裂开时伴随着巨大的轰鸣和明亮的光。";
		mes "这位美丽的萨帕就在裂缝旁被发现。";
		next;
		mes "[赫斯兰塔]";
		mes "他不是迪卡斯特斯的萨帕。";
		mes "我们把他带给睿智的拉维尔，由他作出判断。";
		next;
		mes "[赫斯兰塔]";
		mes "我们为躲避神的诅咒来到这里，";
		mes "却发现了一位幸运地没有被诅咒的朋友。";
		next;
		mes "[赫斯兰塔]";
		mes "阿哈特获得拉维尔的信任后，一步步爬到了今天的位置。";
		mes "他的工作能力惊人。";
		mes "他是完美的萨帕。";
		set ep13_3_secret, 21;
		next;
		mes "说完这些，赫斯兰塔陷入沉思。";
		close;
	}

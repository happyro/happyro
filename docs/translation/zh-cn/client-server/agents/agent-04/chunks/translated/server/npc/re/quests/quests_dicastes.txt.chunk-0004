			mes "向 GM 请求帮助。";
			close2;
		}
	}
	cutin "",255;
	end;
}

dic_in01,300,280,5	script	Minister Ahat#ep133_21	493,{
	// if ((GetInventoryRemainCount 1301 3 == 2) || (GetInventoryRemainCount 1301 3 == 3)) {
	if ((MaxWeight - Weight) < 1000) {
		mes "- 物品太多，无法继续任务。 -";
		close;
	}
	if (ep13_3_secret < 13) {
		mes "[大臣阿哈特]";
		mes "谁？";
		mes "我不记得允许你进来。";
		close2;

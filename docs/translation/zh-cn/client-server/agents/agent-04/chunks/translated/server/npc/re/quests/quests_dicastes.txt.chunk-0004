		end;
	}
	else if (ep13_3_secret == 13) {
		mes "你一靠近阿哈特，就有人";
		mes "按下你的头，强迫你鞠躬。";
		soundeffect "wander_man_move.wav",0;
		SC_Start SC_Blind,60000,0;
		next;
		mes "[响亮的声音]";
		mes "没关系，Cheshire。";
		mes "你是来见我的吗？";
		next;
		mes "[响亮的声音]";
		mes "抬起头，靠近一些。";
		mes "交谈应该保持眼神接触。";
		next;
		cutin (Sex == SEX_MALE?"ep13_ahat_f":"ep13_ahat_m"),2;
		mes "听到阿哈特的声音，你抬起头，";
		mes "看到面前有一个穿着高级萨帕服饰的人类。";
		SC_End SC_Blind;
		emotion ET_HUK, playerattached();
		set ep13_3_secret, 14;
		erasequest 7198;
		close2;
	}
	else if (ep13_3_secret == 14) {
		cutin (Sex == SEX_MALE?"ep13_ahat_f":"ep13_ahat_m"),2;
		mes "[阿哈特]";
		mes "惊讶吗？";
		mes "因为我看起来和你一样是人类？";
		next;
		select("你不是萨帕？：人类？！！！！！：好漂亮……！！：真帅……！");
		mes "[阿哈特]";
		mes "哈哈哈……没关系。";
		mes "我理解你无法不为我的外表惊讶。";
		mes "我在你眼里是什么样？";
		next;
		mes "[阿哈特]";
		mes "完美男性？";
		mes "完美女性？";
		mes "都无所谓。";
		next;
		mes "[阿哈特]";
		mes "你眼前看到的不是我。";
		mes "谎言中的谎言。";
		mes "摇曳倒影中的幻象。";
		next;
		mes "[阿哈特]";
		mes "只是你固定观念中的记忆影像……";
		mes "深入你的内心。";
		next;
		mes "阿哈特的声音悦耳地在你耳边回响。";
		mes "他说出的每个音节都作用于你的身体。";
		next;
		mes "你看到远处有人平静地对你微笑……";
		next;
		mes "[柔和的声音]";
		mes "谁是主人？";
		next;
		mes "- 阿哈特似乎正在施放强力法术。";
		mes "这可能才是他的真正能力。-";
		next;
		select("住手！:恶魔走开！");
		mes "[阿哈特]";
		mes "……无用的抵抗……";
		mes "不过偶尔这样也挺有趣。";
		mes "我随时都可以对你施法。";
		next;
		mes "[阿哈特]";
		mes "现在……抬头看着我的眼睛……";
		mes "....";
		next;
		while (.@ahtlove < 4) {
			set .@ahtlove, .@ahtlove + 1;
			mes "- 阿哈特再次试图催眠你。";
			mes "他一定是反复这样做，把自己抹去了。-";
			next;
			if (.@ahtlove == 1) {
				select("用意志力克服。");
				mes "[阿哈特]";
				mes "有趣。";
				mes "你不觉得吗，柴郡？";
				mes "哈哈哈。欲擒故纵……这会很有趣……";
				next;
			}
			else if (.@ahtlove == 2) {
				select("你闭上眼睛……");
				mes "[阿哈特]";
				mes "不，不……你不能闭眼。";
				mes "柴郡。";
				next;
				mes "- 命令一下达，";
				mes "阿哈特的助手就来让你盯着阿哈特。-";
				next;
			}
			else if (.@ahtlove == 3) {
				select("试着唱首歌。");
				mes "[阿哈特]";
				mes "人类真有趣。";
				mes "但你得听我的，所以我会让你安静一会儿。";
				next;
				mes "[阿哈特]";
				mes "抵抗没有用。";
				mes "一切交给我就好。";
				next;
			}
			else {
				select("试着扭动身体。");
				mes "[阿哈特]";
				mes "有趣。";
				mes "你不觉得吗，柴郡？";
				mes "哈哈哈。欲擒故纵……这会很有趣……";
				next;
				mes "[阿哈特]";
				mes "别这样，你看起来很可怜。";
				mes "放松，让自己沉浸在我的法术中。";
				next;
			}
		}
		mes "[阿哈特]";
		mes "你在抵抗。";
		mes "看来你不是随便来这里的。";
		mes "看看你能坚持多久。";
		next;
		mes "[阿哈特]";
		mes "你的主人是谁？";
		next;
		if (select("假装被法术控制。:那你告诉我") == 1) {
				mes "- 你开始装作被催眠。";
				mes "阿哈特看起来很满意。-";
			next;
		}
		else {
			mes "[" + strcharinfo(0) + "]";
				mes "你！！！";
				mes "我爱你！";
				mes "我愿意为你而死！";
			next;
				mes "- 你开始装作被催眠。-";
			next;
			mes "[阿哈特]";
			mes "........ ah, no.";
				mes "没必要自杀。";
				mes "现在你已经被我的法术控制。";
			mes "....";
			next;
		}
				mes "[阿哈特]";
		mes "你对我来说是谁？";
		next;
		if (select("脚凳！:忠诚的仆人。") == 1) {
				mes "[阿哈特]";
		mes "我不需要脚凳。";
		mes "过一会儿再谈。";
		}
		else {
				mes "[阿哈特]";
		mes "我明白了。";
		mes "你是我忠诚的仆人。";
		mes "我的手和脚。";
		}
		set ep13_3_secret, 15;
		close2;
	}
	else if (ep13_3_secret == 15) {
		cutin (Sex == SEX_MALE?"ep13_ahat_f":"ep13_ahat_m"),2;
		mes "[阿哈特]";
		mes "我忠诚的邪恶仆人。";
		mes "靠近一些。";
		next;
		if (select("我在做什么？:遵命。") == 1) {
			mes "[阿哈特]";
			mes "你真顽固。";
			mes "我的法术对你不起作用？";
			mes "还是法术被破坏了……";
			mes "或者是你还没有恢复力量。";
			next;
			mes "- 阿哈特再次施放强力法术。-";
			next;
			mes "[阿哈特]";
			mes "你的主人是谁？";
			next;
			select("我的主人是阿哈特。 ");
		}
		mes "[阿哈特]";
		mes "很好。现在允许你自由进出。";
		mes "从现在起你为我工作。";
		next;
		mes "[阿哈特]";
		mes "这是你的第一个任务。";
		mes "迪卡斯特斯南方出现了次元裂缝。你知道吗？";
		next;
		mes "[阿哈特]";
		mes "裂缝周围有许多痕迹。";
		mes "你的任务是找到并消除这些痕迹。";
		next;
		mes "[阿哈特]";
		mes "柴郡，把任务详情告诉他。";
		mes "^4d4dff我还没有完全醒来，施法让我非常疲惫。^000000";
		next;
		mes "[阿哈特]";
		mes "现在你要向纳迦族说明我们见过面。";
		mes "告诉他们我看起来像萨帕，而且总是在办公室独自工作。";
		next;
		mes "[阿哈特]";
		mes "绝对不要提到柴郡。";
		mes "柴郡从来不在这里。";
		mes "从现在起你必须听从柴郡的命令。";
		mes "现在就走。";
		next;
		mes "- 阿哈特还没有察觉任何事情。";
		mes "他似乎相信自己的法术已经完成。-";
		set ep13_3_secret, 16;
		close2;
	}
	else if (ep13_3_secret == 16) {
		cutin (Sex == SEX_MALE?"ep13_ahat_f":"ep13_ahat_m"),2;
		mes "[阿哈特]";
		mes "从现在起你必须听从柴郡的命令。";
		mes "现在就走。";
		next;
		mes "- 阿哈特还没有察觉任何事情。";
		mes "他似乎相信自己的法术已经完成。-";
		close2;
	}
	else if (ep13_3_secret == 17) {
		cutin (Sex == SEX_MALE?"ep13_ahat_f":"ep13_ahat_m"),2;
		mes "[阿哈特]";
		mes "柴郡的命令对未来计划很重要。";
		mes "不要犯错，也绝不要留下能追查到我的痕迹。";
		mes "这是你主人的命令。";
		close2;
	}
	else if (ep13_3_secret == 18) {
		cutin (Sex == SEX_MALE?"ep13_ahat_f":"ep13_ahat_m"),2;
		mes "[阿哈特]";
		mes "你有话要说吗？";
		mes "你在裂缝区域做得很好。";
		next;
		select("那是什么？");
		mes "[阿哈特]";
		mes "嗯……";
		mes "你现在不需要知道。";
		mes "也许永远都不需要知道。";
		mes "Ho ho.";
		next;
		mes "[阿哈特]";
		mes "你的剑会指向哪里……";
		mes "在你得知真相的那一天……";
		mes "我累了，现在离开。";
		next;
		mes "[阿哈特]";
		mes "我仍然是迪卡斯特斯的贾鲁特，有堆积如山的工作。";
		mes "毕竟只靠一条面包很难满足所有人。";
		next;
		mes "[阿哈特]";
		mes "这是对你功劳的奖励。";
		mes "不是什么贵重东西，但希望你喜欢。";
		set ep13_3_secret, 19;
		getitem 2790,1; //Bradium_Brooch
		close2;
	}
	else {
		cutin (Sex == SEX_MALE?"ep13_ahat_f":"ep13_ahat_m"),2;

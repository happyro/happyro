		mes "你是 Ernon 派来的，对吧？";
			next;
			mes "[Distribution Chief Avrandi]";
		mes "你带来的物品我收到了。";
			next;
			setquest 5368;
			mes "[Distribution Chief Avrandi]";
		mes "嗯？你要拿回去？那可是很麻烦的。";
			close;
		default:
			mes "[Distribution Chief Avrandi]";
		mes "你经历了很多啊。";
			close;
		}
	}
	// unknown text
	end;
}


un_bk_q,279,294,4	script	Transportation Executive Ernon#EP15.2MR	4_M_LGTMAN,{
	callfunc( "F_time_limit_recorder", .@cooldown_status_day );
	if (.@cooldown_status_day[0] == 1) {
		mes "[Transportation Executive Ernon]";
		mes "事故发生前，我们曾把日用品或研究工具运送到这里。";
		next;
		mes "[Transportation Executive Ernon]";
		mes "即使作为这里的工作人员，也经常要外出到其他地方工作。";
		close;
	}
	if (.@cooldown_status_day[1] == 1) {
		emotion 1;
		mes "[Transportation Executive Ernon]";
		mes "什么？！发生什么了吗？机械师和设施管理人员看起来很忙。";
		close;
	}
	if (.@cooldown_status_day[2] == 1) {
		emotion 21;
		mes "[Transportation Executive Ernon]";
		mes "呀~你尝过葡萄吗？";
		next;
		mes "[Transportation Executive Ernon]";
		mes "能在这样的地下避难设施里种出新鲜葡萄，不是很棒吗？";
		close;
	}
	if (.@cooldown_status_day[3] == 1) {
		mes "[Transportation Executive Ernon]";
		mes "有些人突然攻击别人。";
		next;
		mes "[Transportation Executive Ernon]";
		mes "到底发生了什么？";
		close;
	}
	if ((.@cooldown_status_day[0] + .@cooldown_status_day[1] + .@cooldown_status_day[2] + .@cooldown_status_day[3] + .@cooldown_status_day[4]) == 0) {// start Day 5
		emotion 1;
		mes "[Transportation Executive Ernon]";
		mes "从昨天开始广播就在谈这件事，所以你知道大致情况吧？";
		next;
		mes "[Transportation Executive Ernon]";
		mes "污染物正在进入防空洞内部，因此决定把所有物资转移到化学物质专家发现的未污染区域 Z-2。";
		next;
		mes "[Transportation Executive Ernon]";
		mes "由于那些瘦弱的研究员帮不上忙，所以请求冒险者协助搬运货物。";
		next;
		mes "[Transportation Executive Ernon]";
		mes "好——先把货物运到 Z-2 区域。";
		next;
		mes "[Transportation Executive Ernon]";
		mes "回去时经过机械仓库，那里有个叫 Al 的人。告诉他";
		next;
		emotion 29;
		mes "[Transportation Executive Ernon]";
		mes "^0000FF你们这些笨蛋！！别再用愚蠢的机器浪费材料！！^000000";
		next;
		select("嗯？");
		mes "[Transportation Executive Ernon]";
		mes "不明白？去机械仓库告诉 Al。";
		next;
		emotion 29;
		mes "[Transportation Executive Ernon]";
		mes "^0000FF你们这些笨蛋！！别再用愚蠢的机器浪费材料！！^000000";
		next;
		if (isbegin_quest(5370) == 1)
			erasequest 5370;
		setquest 5366;
		setquest 5367;
		mes "[Transportation Executive Ernon]";
		mes "记得准确使用每个助词，百分之百传达我的感受。";
		close;
	}
	if (.@cooldown_status_day[4] == 1) {
		.@quest_day_5 = isbegin_quest(5367) + isbegin_quest(5368) + isbegin_quest(5369);
		switch(.@quest_day_5) {
		case 1:
			mes "[Transportation Executive Ernon]";
			mes "先把货物运到 Z-2 区域。";
			next;
			mes "[Transportation Executive Ernon]";
			mes "回去时到机械仓库告诉 Al";
			next;
			emotion 29;
			mes "[Transportation Executive Ernon]";
		mes "^0000FF你们这些笨蛋！！别再用愚蠢的机器浪费材料！！^000000??替我处理后回来。";
			close;
		case 2:
			mes "[Transportation Executive Ernon]";
		mes "你把货物送到 Z-2 区域了吗？";
			next;
			mes "[Transportation Executive Ernon]";
		mes "哦！我不是还请求了另一件事吗？你把消息传给机械师了吗？";
			next;
		select("还没有……");
			mes "[Transportation Executive Ernon]";
		mes "啊……我该怎么办……大部分货物都搬走了，我要去吗？";
			next;
			mes "[Transportation Executive Ernon]";
		mes "如果就这样放着，那些只懂机器以外一窍不通的笨蛋可能会动那些珍贵零件……";
			next;
			mes "[Transportation Executive Ernon]";
		mes "我们该怎么办？我去吗？还是你想回去？";
			next;
			if (select( "回去。", "不回去。" ) == 1) {
				mes "[Transportation Executive Ernon]";
				mes "好。回去吧。";
				close;
			}
			mes "[Transportation Executive Ernon]";
		mes "是吗？机械仓库好像有点远。";
			next;
			mes "[Transportation Executive Ernon]";
		mes "我们差不多完成了，我会赶紧收尾再走。这是工作的报酬。";
			next;
			if (isbegin_quest(5367) > 0)
				erasequest 5367;
			if (isbegin_quest(5368) > 0)
				erasequest 5368;
			if (isbegin_quest(5369) > 0)
				erasequest 5369;
			setquest 5370;
			ep15_2_memory = 0;
			getexp 500000,500000;
			mes "- 小圆胶囊渗入了皮肤。感觉经验正在积累。";
			next;
			mes "[Transportation Executive Ernon]";
		mes "虽然我们能否在污染物中生存还不确定，";
			next;
			mes "[Transportation Executive Ernon]";
		mes "首席研究员让我们充分补偿卷入爆炸的冒险者。";
			next;
			mes "[Transportation Executive Ernon]";
		mes "不过不用担心。";
			close;
		case 3:
			mes "[Transportation Executive Ernon]";
		mes "你准确传达了我的感受，对吧？";
			next;
			mes "[Transportation Executive Ernon]";
		mes "他们现在应该学聪明了。不会再浪费珍贵零件了，对吧？";
			next;
			mes "[Transportation Executive Ernon]";
		mes "给！这是工作的报酬。";
			next;
			for ( .@i = 5367; .@i < 5370; .@i++ ) {
				if (isbegin_quest(.@i) > 0)
					erasequest .@i;
			}
			if (ep15_2_memory == 0)
				getexp 750000,500000;
			else
				getexp 750000,1000000;
			ep15_2_memory = 0;
			setquest 5370;
			mes "- 小圆胶囊渗入了皮肤。感觉经验正在积累。";
			next;
			mes "[Transportation Executive Ernon]";
		mes "虽然我们能否在污染物中生存还不确定，";
			next;
			mes "[Transportation Executive Ernon]";
		mes "首席研究员让我们充分补偿卷入爆炸的冒险者。";
			next;
			mes "[Transportation Executive Ernon]";
		mes "不过不用担心。";
			close;
		default:
			mes "[Transportation Executive Ernon]";
		mes "虽然我们能否在污染物中生存还不确定，";
			next;
			mes "[Transportation Executive Ernon]";
		mes "首席研究员让我们充分补偿卷入爆炸的冒险者。";
			next;
			mes "[Transportation Executive Ernon]";
		mes "不过不用担心。";
			close;
		}
	}
	// unknown text
	end;
}

un_bk_q,72,53,4	script	Distribution Chief Avrandi#EP15.2MR	4_M_TWTEAMAN,{
	callfunc( "F_time_limit_recorder", .@cooldown_status_day );
	if (.@cooldown_status_day[0] == 1) {
		emotion 54;
		mes "[Distribution Chief Avrandi]";
		mes "幸好我们提前撤到了防空洞内部。";
		next;
		mes "[Distribution Chief Avrandi]";
		mes "如果没能撤离……我们可能已经不在这里了。";
		close;
	}
	if (.@cooldown_status_day[1] == 1) {
		emotion 1;
		mes "[Distribution Chief Avrandi]";
		mes "出什么问题了吗？";
		next;
		mes "[Distribution Chief Avrandi]";
		mes "刚才设施管理人员还在匆忙奔走。";
		close;
	}
	if (.@cooldown_status_day[2] == 1) {
		emotion 23;
		mes "[Distribution Chief Avrandi]";
		mes "天啊？！你吃了新鲜葡萄？为什么我没吃到？为什么？";
		close;
	}
	if (.@cooldown_status_day[3] == 1) {
		emotion 40;
		mes "[Distribution Chief Avrandi]";
		mes "这里真安静。你问为什么？";
		next;
		mes "[Distribution Chief Avrandi]";
		mes "很少有人来到这么深的地方。";
		close;
	}
	if (.@cooldown_status_day[4] == 1) {

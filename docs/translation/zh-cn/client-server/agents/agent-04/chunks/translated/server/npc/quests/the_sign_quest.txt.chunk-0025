		if (.@r < 680) F_SealFail; }
	else if (countitem(1363)) {
		if (.@r < 660) F_SealFail; }
	else if (countitem(1530)) {
		if (.@r < 500) F_SealFail; }
	else {
		mes "^3355FF你手中的武器";
		mes "现在看来根本无法打破这个封印。你肯定需要更";
		mes "强大的武器……^000000";
		close;
	}
	if (getarg(1,0)) {
		mes "^3355FF获得最后一块";
		mes "阿格布罗达灵魂后，四块灵魂碎片发出奇异光芒，升到空中并合成为";
		mes "一颗透明宝石。^000000";
		next;
		mes "^3355FF宝石飘落";
		mes "到你伸出的";
		mes "手中，你听到它的声音";
		mes "直接传入你";
		mes "心灵深处……^000000";
		next;
		mes "[Agrboda's Soul]";
		mes "^333333我……";
		mes "我要把我的灵魂";
		mes "交给你。请带我";
		mes "去见死者女王……^000000";
		delitem 7306,3; //Fragment_Of_Soul
		set sign_q,117;
		getitem 7307,1; //Whisper_Of_Soul
	}
	else {
		mes "^3355FF你击打封印后，";
		mes "封印裂开，神秘光芒涌出。你在封印内部发现了一件奇特物品……^000000";
		next;
		mes "^3355FF你获得了";
		mes "一件^6E7B8B";
		mes "灵魂碎片^3355FF。^000000";
		getitem 7306,1; //Fragment_Of_Soul
	}
	return;
}


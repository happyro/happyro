// Turtle Quest
//============================================================
alberta,91,70,4	script	Kinsey#tur	89,{
	mes "[Kinsey]";
	mes "在这里想喝杯烈酒要做什么？艾尔贝塔根本没有好酒吧！";
	next;
	mes "[Kinsey]";
	mes "这里酒吧的酒虽然次等，但气氛确实很棒。";
	next;
	mes "[Kinsey]";
	mes "那里的老头总讲海底洞窟的故事！但不知道他真的去过，还是只是喝醉了。";
	next;
	if (select("^3333FF*ting!*^000000:Sounds fun~") == 1) {
		mes "[Kinsey]";
		mes "哇……";
		mes "我一提海底洞窟你的眼睛就亮了！嗯，再说一次。";
		next;
		mes "[Kinsey]";
		mes "*Ahem*";
		mes "‘海-龟";
		mes "岛。’";
		next;
		mes "["+ strcharinfo(0) +"]";
		mes "^3333FF*ting!*^000000";
		next;
		mes "[Kinsey]";
		mes "啊……";
		mes "你一定是冒险者。看来你很想了解那里，对吧？";
		next;
		mes "[Kinsey]";
		mes "去酒吧附近找找那个老头吧。他通常醉醺醺、说些胡话，但也许有话告诉你。";
		next;
		mes "[Kinsey]";
		mes "哦，我以前进过他的房间。他会把与海底洞窟故事有关的信放在桌上。";
		next;
		mes "[Kinsey]";
		mes "但如果他让你买酒，别答应。他好像有三个额外的肝脏，会把你喝到破产。";
		close;
	}
	mes "[Kinsey]";
	mes "听他的故事确实挺酷，但如果能在更好的酒吧听就更棒了。";
	next;
	mes "[Kinsey]";
	mes "他们连‘布吉曼’都没有，更别说‘可可波’了。越来越难找到那些高级特色饮料。";
	close;
}


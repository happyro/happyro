	mes "[可怕的家伙]";
	mes "他们随意进出，甚至闯入别人的房间……";
	mes "肯定会造成伤害。";
	close;
}

mal_in02,109,62,4	script	Picky Crew#nyaong03	545,{
	mes "[挑剔的家伙]";
	mes "不要在大厅里奔跑！";
	mes "有人到处抓挠，害得我的毛都掉了！";
	mes "到处都是抓痕！";
	close;
}

// Cat Gamers :: mal_gamer
//============================================================
mal_in01,31,210,2	script	Cat Gamers Director	549,{
	if (MaxWeight - Weight < 1000) {
		mes "你的背包太重，无法继续。减轻负重后再回来。";
		close;
	}
	if (checkweight(1201,1) == 0) {
		mes "你的背包太满，无法继续。清理空间后再回来。";
		close;
	}
	if (BaseLevel < 60) {
		mes "一只看起来温顺的猫正在自言自语。";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "你好……猫先生……";
		next;
		mes "猫瞥了你一眼，仿佛没看见你似的继续低声自语。";
		next;
		mes "看来你还不值得交谈。";
		close;
	}
	if (malang_gamer == 0) {
		mes "一只看起来温顺的猫正在自言自语。";
		next;
		mes "[猫咪玩家协会会长]";
		mes "天啊！连续输了10场……";
		emotion ET_OHNO;
		next;
		mes "[猫咪玩家协会会长]";
		mes "我们是‘猫咪玩家协会’。";
		mes "但我们一直输，完全不知道为什么！";
		next;
		mes "[猫咪玩家协会会长]";
		mes "我们必须找出连败的原因。";
		set malang_gamer,1;
		next;
		mes "你对猫的故事产生了兴趣。继续听下去吧。";
		close;
	} else if (malang_gamer == 1) {
		mes "[猫咪玩家协会会长]";
		mes "原因，对！";
		mes "这可能是其中之一。";
		next;
		mes "[猫咪玩家协会会长]";
		mes "^DD2234丢掉了太多分！^000000";
		mes "没错，无论得多少分，";
		mes "只要丢掉太多分，我们还是会输。";
		next;
		mes "[猫咪玩家协会会长]";
		mes "另一个原因，嗯！";
		mes "这可能和前一个原因有关。";
		mes "完全没有^DD2234激烈的下注^000000。";
		next;
		mes "[猫咪玩家协会会长]";
		mes "其他队会押注他们认为能赢的比赛，不自信时就少下注。";
		mes "看来我们以前不知道。";
		next;
		mes "[猫咪玩家协会会长]";
		mes "嗯，这会是原因吗？";
		mes "不知为何，^DD2234比赛前夕有玩家消失^000000，我想这可能影响了我们的比赛精神。";
		next;
		mes "[猫咪玩家协会会长]";
		mes "嗯……所以我们连败的原因是，";
		mes "丢掉太多分；";
		mes "激进下注；";
		mes "以及玩家消失？";
		set malang_gamer,2;
		next;
		mes "看来那只看起来温和的猫思考完了。打断这场对话吧。";
		close;
	} else if (malang_gamer == 2) {
		mes "[猫咪玩家协会会长]";
		mes "既然我知道原因了，";
		mes "应该有解决办法。";
		emotion ET_SCRATCH;
		next;
		select("嗯……猫先生……" );
		mes "[猫咪玩家协会会长]";
		mes "是谁？人类？你是人类？";
		next;
		mes "[猫咪玩家协会会长]";
		mes "... ... ... ...";
		next;
		mes "[猫咪玩家协会会长]";
		mes "哦！是的！没错！";
		mes "我记得听说";
		mes "最近开始有人类经过这里。";
		next;
		mes "[猫咪玩家协会会长]";
		mes "见到你真好！！";
		mes "对了，你叫什么名字？";
		emotion ET_SURPRISE;
		next;
		mes "["+strcharinfo(0)+"]";
		mes "我叫"+strcharinfo(0)+"，猫先生。";
		next;
		mes "[猫咪玩家协会会长]";
		mes "哦，^0000FF"+strcharinfo(0)+"^000000。";
		mes "我能帮你什么？";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "其实我听说你连续输掉 10 场比赛，所以想帮你……";
		next;
		mes "[猫咪玩家协会会长]";
		mes "嗯，你没必要这样直接指出来……";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "弱点说出来后，就不再是弱点了。";
		emotion ET_BEST, playerattached();
		next;
		mes "[猫咪玩家协会会长]";
		mes "哈哈哈，我喜欢这句话。";
		mes "我应该记住，";
		mes "再告诉我的孩子们。嘿~";
		next;
		if (Sex == SEX_FEMALE)
			setarray .@sex$[0],"Mr.","boy";
		else
			setarray .@sex$[0],"Miss","girl";
		mes "[猫咪玩家协会会长]";
		mes "我喜欢你，"+.@sex$[0]+" "+strcharinfo(0)+"。你愿意帮我们摆脱连输 10 场的低谷吗？呵呵~";
		next;
		switch(select("抱歉，我是笨蛋"+.@sex$[1]+"。:当然，我是酷炫的"+.@sex$[1]+"。")) {
		case 1:
			mes "[猫咪玩家协会会长]";
			mes "看来我看错你了~";
			mes "怎么会有人称自己为笨蛋。";
			mes "现在我看出你有多笨了。";
			mes "再见~";
			emotion ET_SCRATCH;
			close;
		case 2:
			mes "[猫咪玩家协会会长]";
			mes "哇。我很尊敬你，"+strcharinfo(0)+"。";
			mes "请帮我一个忙。";
			mes "请去见勤劳的猫管理员，问问我们队伍最近的状态。";
			set malang_gamer,3;
			setquest 5058;
			next;
			mes "[猫咪玩家协会会长]";
			mes "猫管理员应该就在附近~";
			close;
		}
	} else if (malang_gamer == 3) {
		mes "[猫咪玩家协会会长]";
		mes "请去见勤劳的猫管理员，";
		mes "问问我们队伍最近的状态。";
		mes "猫管理员应该就在附近~";
		close;
	} else if (malang_gamer == 4) {
		mes "[猫咪玩家协会会长]";
		mes "好，好。那么猫管理员怎么说最近的氛围？~";
		emotion ET_QUESTION;
		next;
		mes "你把猫管理员说的话原原本本告诉他。";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "猫管理员说……";
		next;
		mes "[猫咪玩家协会会长]";
		mes "别犹豫……把一切告诉我~";
		emotion ET_QUESTION;
		next;
		mes "["+strcharinfo(0)+"]";
		mes "嗯……玩家猫咪们害怕你……";
		next;
		mes "[猫咪玩家协会会长]";
		mes "什么……你说什么？";
		emotion ET_HUK;
		next;
		mes "猫玩家主管似乎受到了打击。让他花点时间冷静。";
		set malang_gamer,5;
		erasequest 5059;
		setquest 5060;
		close;
	} else if (malang_gamer == 5) {
		if (checkquest(5060,PLAYTIME) == 0 || checkquest(5060,PLAYTIME) == 1) {
			mes "猫玩家主管似乎受到了打击。让他花点时间冷静。";
			close;
		}
		mes "[猫咪玩家协会会长]";
		mes "不可能！";
		mes "没有比我更温柔的猫了！";
		emotion ET_CRY;
		next;
		mes "[猫咪玩家协会会长]";
		mes "我真的那么可怕吗？";
		mes "那些逃离训练的玩家也害怕我吗？";
		emotion ET_PROFUSELY_SWEAT;
		next;
		mes "[猫咪玩家协会会长]";
		mes "不可能吧？呵呵呵呵~";
		next;
		mes "- 他紧张地笑了。-";
		next;
		mes "[猫咪玩家协会会长]";
		mes "这是真的吗？";
		next;
		mes "[猫咪玩家协会会长]";
		mes strcharinfo(0)+"，你能帮我吗？";
		mes "有 4 个玩家说太累而逃离训练。";
		mes "你能查查他们是不是因为我才逃走的吗？呵呵呵~";
		emotion ET_QUESTION;
		next;
		mes "[猫咪玩家协会会长]";
		mes "他们叫 Eryu、Stew、Ketchup 和 Eff。";
		mes "他们应该就在附近。";
		next;
		mes "[猫咪玩家协会会长]";
		mes "请找到他们全部~";
		mes "但别问得太直接！好吗？";
		mes "温和地问他们~";
		mes "好吗？要！温和！";
		next;
		mes "[猫咪玩家协会会长]";
		mes "感谢你的帮助，"+strcharinfo(0)+"。嘿~";
		set malang_gamer,6;
		erasequest 5060;
		setquest 5061;
		close;
	} else if (malang_gamer == 6) {
		if (checkquest(5062) == 2 && checkquest(5063) == 2 && checkquest(5064) == 2 && checkquest(5065) == 2) {
			mes "[猫咪玩家协会会长]";
			mes "嘿~看来这座城镇里有些人类在欺骗猫咪。";
			next;
			mes "[猫咪玩家协会会长]";
			mes "欺骗无辜猫咪有什么好处？~";
			emotion ET_KIK;
			next;
			mes "["+strcharinfo(0)+"]";
			mes "是的，我觉得你说得对。";
			emotion ET_SCRATCH, playerattached();
			next;
			mes "[猫咪玩家协会会长]";
			mes "哦，你见过 Eryu、Stew、Ketchup 和 Eff。";
			mes "再次见到你真好。嘿~";
			mes "非常感谢你的努力~嘿~";
			next;
			mes "[猫咪玩家协会会长]";
			mes "那么他们说了什么？";
			mes "他们真的觉得我可怕吗？";
			next;
			mes "你把 Eryu、Stew、Ketchup 和 Eff 的话告诉猫玩家主管。";
			next;
			mes "["+strcharinfo(0)+"]";
			mes "他们觉得你在训练中逼得太紧，所以害怕你。";
			next;
			mes "[猫咪玩家协会会长]";
			mes "什么？真的吗？";
			next;
			mes "猫玩家主管似乎再次受到了打击。最好给他更多时间冷静。";
			set malang_gamer,7;
			erasequest 5061;
			setquest 5060;
			close;
		}
		mes "[猫咪玩家协会会长]";
		mes "他们叫 Eryu、Stew、Ketchup 和 Eff。";
		mes "他们应该就在附近。";
		next;
		mes "[猫咪玩家协会会长]";
		mes "请找到他们全部~";
		mes "但别问得太直接！好吗？";
		mes "温和地问他们~";
		mes "好吗？要！温和！";
		next;
		mes "[猫咪玩家协会会长]";
		mes "感谢你的帮助，"+strcharinfo(0)+"。嘿~";
		close;
	} else if (malang_gamer == 7) {
		if (checkquest(5060,PLAYTIME) == 0 || checkquest(5060,PLAYTIME) == 1) {
			mes "猫玩家主管似乎再次受到了打击。最好给他更多时间冷静。";
			close;
		}
		mes "[猫咪玩家协会会长]";
		mes "好，我明白了。";
		mes "我果然是一只可怕的猫。";
		mes "这不可能！！嘿~";
		next;
		mes "[猫咪玩家协会会长]";
		mes "我必须改变可怕猫咪的形象。嘿~";
		next;
		mes "[猫咪玩家协会会长]";
		mes "这就是我现在的任务，";
		mes "这样我们的队伍才能提升";
		mes "比赛表现。嘿~";
		next;
		mes "[猫咪玩家协会会长]";
		mes "请去见我们的猫管理员，";
		mes "了解我该如何改变";
		mes "我这副可怕猫咪的形象。嘿~";
		next;
		mes "[猫咪玩家协会会长]";
		mes "嘿~我会非常感谢你的帮助，"+strcharinfo(0)+"~。";
		set malang_gamer,8;
		erasequest 5060;
		setquest 5066;
		close;
	} else if (malang_gamer == 8) {
		mes "[猫咪玩家协会会长]";
		mes "请询问我们的猫咪会长，看看如何改变这张可怕的猫咪画像。";
		mes "Heh~";
		next;
		mes "[猫咪玩家协会会长]";
		mes "嘿～请帮帮我，";
		mes strcharinfo(0)+"! Heh~";
		close;
	} else if (malang_gamer == 9) {
		mes "[猫咪玩家协会会长]";
		mes "You came back!! Heh~";
		mes "那么，我们的猫咪会长说了什么？";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "猫管理员让我准备一个箱子。";
		next;
		mes "[猫咪玩家协会会长]";
		mes "箱子？嘿~当然，为什么不？";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "你要问这是做什么的吗？";
		next;
		mes "[猫咪玩家协会会长]";
		mes "嗯，"+strcharinfo(0)+"和猫管理员交谈时，我稍微偷听了一下。嘿~";
		emotion ET_SMILE;
		next;
		mes "["+strcharinfo(0)+"]";
		mes "............";
		next;
		mes "[猫咪玩家协会会长]";
		mes "现在我需要询问玩家，看看他们真正的感受。";
		mes "嘿~明天再来怎么样？";
		mes "嘿~等我看完他们真诚的请愿信，再决定该怎么办。嘿~";
		set malang_gamer,10;
		erasequest 5067;
		setquest 5068;
		close;
	} else if (malang_gamer == 10) {
		if (checkquest(5068,PLAYTIME) == 0 || checkquest(5068,PLAYTIME) == 1) {
			mes "[猫咪玩家协会会长]";
			mes "还在收到请愿信。嘿~";
			next;
			mes "[猫咪玩家协会会长]";
			mes "不知道他们真正想说什么~嘿~";
			close;
		}
		mes "[猫咪玩家协会会长]";
		mes "嘿~请愿信收集完毕~";
		mes "嘿~看看他们写了什么？";
		next;
		mes "阅读中……~";
		next;
		mes "[猫咪玩家协会会长]";
		mes "嘿~让我看看……‘笨猫领……导……’";
		emotion ET_FRET;
		next;
		mes "- 把纸揉成一团 -";
		mes "猫玩家主管把纸揉皱后扔掉了。";
		next;
		mes "[猫咪玩家协会会长]";
		mes "嘿~拿错纸了。";
		mes "再读一封……嘿~";
		next;
		mes "~阅读中~";
		next;
		mes "[猫咪玩家协会会长]";
		mes "嘿~来了。";
		mes "‘我不喜欢反复和同一批队员玩。";
		mes "请挑选新的队员，";
		mes "或者给我找个练习伙伴。’";
		next;
		mes "[猫咪玩家协会会长]";
		mes "嘿~我明白了。";
		mes "我可以积极看待。";
		mes "嘿~继续看下一封。";
		emotion ET_OK;
		next;
		mes "~阅读中~";
		next;
		mes "[猫咪玩家协会会长]";
		mes "嘿~";
		mes "‘我们需要更多点心~给我们更多点心~’";
		next;
		mes "[猫咪玩家协会会长]";
		mes "嘿~这封听起来也很有建设性。";
		mes "嘿~请愿信还不错吧……嘿~";
		emotion ET_OK;
		next;
		mes "阅读中……~";
		next;
		mes "[猫咪玩家协会会长]";
		mes "嘿~";
		mes "‘前辈们在欺负我。帮帮我……’";
		next;
		mes "[猫咪玩家协会会长]";
		mes "嘿~我们的队伍绝对";
		mes "像一个家庭~有人";
		mes "在这里玩闹呢。嘿~";
		emotion ET_SURPRISE;
		next;
		mes "阅读中……~";
		next;
		mes "[猫咪玩家协会会长]";
		mes "嘿~只有 4 封信！";
		mes "还包括一封恶作剧信……";
		mes "嘿~";
		next;
		mes "[猫咪玩家协会会长]";
		mes "看来大家的队伍生活都很满意~嘿~";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "不……其实不是……";
		next;
		mes "箱子后面堆着大量信件，但猫玩家主管不想承认问题。";
		next;
		mes "[猫咪玩家协会会长]";
		mes "嘿~";
		mes "嘿，"+strcharinfo(0)+"。你说什么？嘿~";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "没什么！请继续。";
		next;
		mes "[猫咪玩家协会会长]";
		mes "嘿~因为这些玩家的愿望，";
		mes "我想请你帮个忙，"+strcharinfo(0)+"……";
		mes "嘿~";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "什么事？";
		next;
		mes "[猫咪玩家协会会长]";
		mes "你愿意成为我们玩家的练习伙伴吗？";
		mes "嘿~我强烈觉得你，"+strcharinfo(0)+"，值得信任。嘿~";
		next;
		switch(select("不用了，朋友！:好，我来做！")) {
		case 1:
			mes "[猫咪玩家协会会长]";
			mes "嘿~你要拒绝我吗？嘿~";
			next;
			mes "[猫咪玩家协会会长]";
			mes "我好伤心。伤心~嘿~";
			mes "没想到你这样的人会拒绝，"+strcharinfo(0)+"。";
			mes "不过，还是给你一些硬币~";
			mes "嘿~";
			emotion ET_CRY;
			next;
			mes "[猫咪玩家协会会长]";
			mes "我们猫玩家协会永远欢迎你，"+strcharinfo(0)+"，成为客座成员。";
			mes "嘿~";
			set malang_gamer,11;
			erasequest 5068;
			getitem 6422,100; //Egrade_Coin
			next;
			mes "[猫咪玩家协会会长]";
			mes "嘿~改变主意后请回来。";
			close;
		case 2:
			mes "[猫咪玩家协会会长]";
			mes "嘿~明智的选择。";
			mes "我就知道你会帮助我们猫玩家……嘿~";
			emotion ET_BEST;
			next;
			mes "[猫咪玩家协会会长]";
			mes "嘿~谢谢你的帮助。";
			mes "嘿~这是一些硬币，作为小礼物……嘿~";
			mes "去买点好东西吧。嘿~";
			next;

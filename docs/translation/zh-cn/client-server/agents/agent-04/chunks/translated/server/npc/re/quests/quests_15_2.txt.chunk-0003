			cutin "bu_maggi4.bmp",2;
			next;
			mes "[马克]";
		}
		mes "先冷静下来……仔细观察周围也许更好。";
		cutin "bu_mark1.bmp",0;
		next;
		mes "[Du]";
		mes "好……好……好的！";
		mes "这……这……这些东西……没……没什么……";
		cutin "bu_du5.bmp",2;
		next;
		mes "[阿尔夫]";
		mes "那我们分头观察，发现有价值的东西时发信号。";
		cutin "bu_alp1.bmp",2;
		next;
		mes "[Du]";
		mes "等……等等！！";
		mes "这里很危险，一起行动不是更好吗？";
		cutin "bu_du5.bmp",2;
		next;
		mes "[Du]";
		mes "嘿！";
		mes "看！";
		mes "别丢下我！";
		mes "喂！！！";
		next;
		mes "[Du]";
		mes "等等我！！！！";
		if (ep15_2_bslast == 2) {
			completequest 11382;
			setquest 11383;// Vestige
			ep15_2_bslast = 3;
		}
		close3;
	}

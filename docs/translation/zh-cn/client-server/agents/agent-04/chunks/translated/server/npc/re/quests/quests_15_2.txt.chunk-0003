		next;
		mes "[弗鲁特]";
		mes "我在想……";
		mes "我在这里很忙，还没能下到据说就在下方的地下掩体。";
		cutin "EP15_2_fru_2.bmp",2;
		next;
		mes "[弗鲁特]";
		mes "你想去吗？";
		next;
		mes "[弗鲁特]";
		mes "有人告诉你所有调查点并不常见，对吧？";
		next;
		mes "[弗鲁特]";
		mes "我也不是要你免费工作！";
		mes "带回有趣结果就有奖励！";
		next;
		mes "[弗鲁特]";
		mes "你觉得呢？";
		next;
		if (select( "退出。", "去做。" ) == 1) {
			mes "[弗鲁特]";
			mes "呃……";
			cutin "EP15_2_fru_1.bmp",2;
			close3;
		}
		mes "[弗鲁特]";
		mes "耶！！！";
		mes "往里走一点，应该会有人给你带路。";
		next;
		mes "[弗鲁特]";
		mes "我期待你带回很多有趣的东西。";
		// completequest 11381;	// completed officially
		erasequest 11381;// Vestige
		setquest 11382;// Vestige
		ep15_2_bslast = 2;
		close3;
	}
	if (ep15_2_bslast == 2) {
		mes "[弗鲁特]";
		mes "耶！！！";
		mes "往里走一点，应该会有人给你带路。";
		cutin "EP15_2_fru_2.bmp",2;
		next;
		mes "[弗鲁特]";
		mes "我期待你带回很多有趣的东西。";
		close3;
	}
	if (ep15_2_bslast < 9) {
		mes "[弗鲁特]";
		mes "怎么样，调查有进展吗？";
		mes "虽然是地下掩体，规模可不小！";
		cutin "EP15_2_fru_3.bmp",2;
		next;
		mes "[弗鲁特]";
		mes "不会弄丢吗？";
		close3;
	}
	if (checkweight(1119,3) == 0) {
		mes "- 你携带的物品太多，无法继续任务。-";
		close;
	}
	if (checkquest(11380,HUNTING) == 2) {
		mes "[弗鲁特]";
		mes "啊啊啊！！！";
		mes "太棒了！！！";
		cutin "EP15_2_fru_2.bmp",2;
		next;
		mes "[弗鲁特]";
		mes "然后呢？然后呢？";
		mes "快说！告诉我更多！！！";
		erasequest 11380;// Last Room
		getexp 200000,0;
		getitem 6827,1;// Normal_Parts
		getitem 6828,1;// Gravity_Parts
		close3;
	}
	mes "[弗鲁特]";
	mes "嗯……还有更有趣的吗？";
	cutin "EP15_2_fru_1.bmp",2;
	next;
	if (select( "交易物品。", "退出。" ) == 1) {
		mes "[弗鲁特]";
		mes "我会用装备交换 17 个完整机器组件！";
		next;
		switch( select( "逃逸芯片", "损坏芯片 1", "损坏芯片 2" ) ) {
		case 1:
			mes "[弗鲁特]";
			mes "逃逸芯片 is HIT + 50, FLEE + 50, MSP - 50%";
			next;
			mes "[弗鲁特]";
			mes "与损坏芯片 1 和损坏芯片 2 一起装备时，可以获得无限移动加速。";
			next;
			mes "[弗鲁特]";
			mes "ATK 和 MATK + 50。如果头盔精炼达到 9，则 MSP + 50%、MHP + 10%。";
			.@item_id = 18997;	// Riot_Chip
			break;
		case 2:
			mes "[弗鲁特]";
			mes "损坏芯片 1 的 STR +4。与损坏芯片 2 一起装备时，STR +8、INT +8。";
			.@item_id = 28326;	// Broken_Chip_1
			break;
		case 3:
			mes "[弗鲁特]";
			mes "损坏芯片 2 的 INT +4。与损坏芯片 1 一起装备时，STR +8、INT +8。";
			.@item_id = 28327;	// Broken_Chip_2
			break;
		}
		next;
		if (select( "Exchange", "退出。" ) == 1) {
			if (countitem(6827) < 17) {
				mes "[弗鲁特]";
				mes "不够！！！";
				close3;
			}
			delitem 6827,17;// Normal_Parts
			getitem .@item_id,1;
			close3;
		}
		// continue
	}
	mes "[弗鲁特]";
	mes "这不是你想要的吗？";
	close3;
}

un_bunker,100,96,3	script	Mark#Bunker Entrance	4_M_BLUEMAN,{

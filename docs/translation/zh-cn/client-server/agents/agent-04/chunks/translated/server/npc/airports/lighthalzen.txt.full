lhz_airport,143,43,5	script	Airport Staff#lhz_air1a::lhz_airport1	90,{
	mes "[Airport Staff]";
	mes "欢迎来到";
	mes "莱茵哈特机场，";
	mes "这里提供直达";
	mes "艾因布罗克、朱诺和胡格尔的航班。";
	next;
	if (select("登上飞艇:取消") == 1) {
		mes "[Airport Staff]";
		mes "登乘费为";
		mes "1,200 Zeny，但使用";
		mes "免费飞艇票即可";
		mes "免除费用。";
		next;
		if (select("是:否") == 1) {
			if (countitem(7311) > 0) {
				delitem 7311,1; //Free_Flying_Ship_Ticket
				warp "lhz_airport",148,51;
				end;
			}
			if (Zeny >= 1200) {
				set Zeny, Zeny - 1200;
				warp "lhz_airport",148,51;
				end;
			}
			mes "[Airship Staff]";
			mes "抱歉，您没有足够的 Zeny";
			mes "支付 1,200 Zeny 的";
			mes "登乘费用。";
			close;
		}
	}
	mes "[Airport Staff]";
	mes "谢谢，欢迎下次再来。";
	mes "祝您今天愉快～";
	close;
	}

lhz_airport,158,43,5	duplicate(lhz_airport1)	Airship Staff#lhz_air1b	90
lhz_airport,126,43,5	duplicate(lhz_airport1)	Airship Staff#lhz_air1c	90

lhz_airport,143,49,3	script	Arrival Staff#lhz_air2a::lhz_airport2	90,{
mes "[Arrival Staff]";
	mes "欢迎来到莱茵哈特机场。";
	mes "如果您刚从航班抵达，";
	mes "请让我带您前往主航站楼；否则请";
	mes "登上出发的飞艇前往目的地。";
	next;
	if (select("前往主航站楼:取消") == 1) {
	mes "[Arrival Staff]";
		mes "进入主航站楼后，登上飞艇需要再次付费。";
		mes "只有在莱茵哈特是您的目的地时，";
		mes "才应该离开这里。要";
		mes "前往主航站楼吗？";
		next;
		if (select("是:否") == 1) {
		warp "lhz_airport",142,40;
			end;
			}
		}
	mes "[Arrival Staff]";
	mes "好的，谢谢您的光临，";
	mes "祝您旅途愉快～";
	close;
	}
	
	lhz_airport,126,51,3	duplicate(lhz_airport2)	Arrival Staff#lhz_air2b	90
lhz_airport,158,50,3	duplicate(lhz_airport2)	Arrival Staff#lhz_air2c	90

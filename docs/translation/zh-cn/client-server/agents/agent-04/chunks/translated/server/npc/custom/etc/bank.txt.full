//===== rAthena Script ======================================= 
//= Banker Script 
//===== By: ================================================== 
//= Syrus22 (1.0)
//===== Current Version: ===================================== 
//= 2.0
//===== Compatible With: ===================================== 
//= rAthena Project
//===== Description: ========================================= 
//= An account wide Banker to store Zeny
//===== Additional Comments: ================================= 
//= Syrus22 - There's an optional transaction fee at the top of
//= the script. To use it simply change the first set command
//= to set the cost variable to whatever you want the fee to be.
//= Version 2.0: Optimized and brought the script up to standard. [Jguy]
//============================================================ 

prontera,132,217,5	script	Banker	109,{
	set @cost,500;
	mes "[Banker]";
	mes "欢迎来到普隆德拉第一银行。今天我能为您做些什么？";
	next;
	switch(select("我想存款。:我想取款。:我目前的余额是多少？:取消")) {
	case 1:
		mes "[Banker]";
		mes "好的……您想存入多少？单次最多可存入 999,999 Zeny。";
		next;
		if (@cost > 0) {
			mes "[Banker]";
			mes "请注意，所有交易都会收取 " +@cost + " Zeny 手续费！";
			next;
		}
		input @deposit;
		if (@deposit < 1) {
			mes "请输入有效的存款金额。";
			close;
		}
		else if (@deposit > Zeny) {
			mes "您似乎没有足够的 Zeny 存入这笔金额！";
			close;
		}
		else if (@deposit > (Zeny - @cost)) {
			mes "您需要准备 " + @cost + " Zeny 来支付手续费！";
			close;
		}
		else {
			set Zeny,Zeny - @deposit;
			set Zeny,Zeny - @cost;
			set #bankstorage,#bankstorage + @deposit;
			mes "[Banker]";
			mes "非常感谢……您的 Zeny 会得到妥善保管。";
			close;
		}
	case 2:
		mes "[Banker]";
		mes "好的……您想取出多少？单次最多可取出 999,999 Zeny。";
		next;
		if (@cost > 0) {
			mes "[Banker]";
			mes "另外请注意，所有交易都会收取 " +@cost + " Zeny 的手续费！";
			next;
		}
		input @withdrawl;
		if (@withdrawl < 1) {
			mes "请不要胡闹。请输入有效的取款金额。";
			close;
		}
		else if (@withdrawl > #bankstorage) {
			mes "您的账户中只有 ^00FF00" + callfunc("F_InsertComma",#bankstorage) +"^000000 Zeny！";
			close;
		}
		else if ((@cost > Zeny) && ((Zeny + @withdrawl) > @cost)) {
			mes "[Banker]";
			mes "您目前没有足够的 Zeny 支付手续费。要从取款金额中直接扣除手续费吗？";
			next;
			switch(select("好的。:不用了，谢谢")){
			case 1:
				mes "[Banker]";
				mes "将从您的取款金额中扣除 " + @cost + " 以支付手续费……";
				set @withdrawl,@withdrawl - @cost;
				set #bankstorage,#bankstorage - @cost;
				set @cost,0;
				next;
				set Zeny,Zeny - @cost;
				set Zeny,Zeny + @withdrawl;
				set #bankstorage,#bankstorage - @withdrawl;
				mes "[Banker]";
				mes "这是您的 Zeny。祝您今天愉快。";
				close;
			case 2:
				mes "[Banker]";
				mes "好的……欢迎下次再来。";
				close;
			}
		}
		else {
			set Zeny,Zeny - @cost;
			set Zeny,Zeny + @withdrawl;
			set #bankstorage,#bankstorage - @withdrawl;
			mes "[Banker]";
			mes "这是您的 Zeny。祝您今天愉快。";
			close;
		}
	case 3:
		mes "[Banker]";
		mes "嗯……让我查一下记录。";
		next;
		mes "*翻找纸张声*";
		next;
		mes "[Banker]";
		mes "您当前账户中有 " + callfunc("F_InsertComma",#bankstorage) + " Zeny。";
		close;
	case 4:
		mes "[Banker]";
		mes "好的……欢迎下次再来。";
		close;
	}
}

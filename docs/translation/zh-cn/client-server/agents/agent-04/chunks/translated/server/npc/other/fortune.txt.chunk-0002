			mes "[Lhimetorra]";
			mes " 用更多真诚和体贴接近他们。 ";
			break;
		}
		next;
		mes "[Lhimetorra]";
		mes " 你寻求了恋爱建议。 ";
		mes " 即使你不满意，也请冷静考虑，并努力寻找真正的幸福。 ";
		cutin "",255;
		next;
		mes "[Lhimetorra]";
		mes " 那么…… ";
		close;
	//=================================================================Assets? ===
	case 2:
		mes "[Lhimetorra]";

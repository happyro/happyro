			break;
		case 73:
			mes " 最可怕的不是锤子或尖角，而是支撑沉重身躯的巨腿。没人能承受那双腿的一击。那个人可能也隐藏着最危险的一面。 ";
			next;
			mes "[Lhimetorra]";

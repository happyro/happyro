		.@card_1_money = rand(1,73);
		if (.@card_1_money < 5) cutin "가이아스카드",4;			// Giearth Card
		else if (.@card_1_money < 10) cutin "더스티네스카드",4;	// Dustiness Card
		else if (.@card_1_money < 13) cutin "드라큐라카드",4;		// Dracula Card
		else if (.@card_1_money < 16) cutin "드레이크카드",4;		// Drake Card
		else if (.@card_1_money < 20) cutin "마리나카드",4;		// Marina Card
		else if (.@card_1_money < 24) cutin "마리오네트카드",4;	// Marionette Card
		else if (.@card_1_money < 29) cutin "메두사카드",4;		// Medusa Card
		else if (.@card_1_money < 33) cutin "바포메트카드",4;		// Baphomet Card
		else if (.@card_1_money < 37) cutin "샌드맨카드",4;		// Sandman Card
		else if (.@card_1_money < 41) cutin "소희카드",4;		// Sohee Card
		else if (.@card_1_money < 45) cutin "스켈워커카드",4;		// Skel Worker Card
		else if (.@card_1_money < 50) cutin "스켈나이트카드",4;	// Khalitzburg Card
		else if (.@card_1_money < 54) cutin "아누비스카드",4;		// Anubis Card
		else if (.@card_1_money < 58) cutin "오크로드카드",4;		// Orc Lord Card
		else if (.@card_1_money < 62) cutin "잭카드",4;			// Jakk Card
		else if (.@card_1_money < 66) cutin "조커카드",4;		// Joker Card
		else if (.@card_1_money < 70) cutin "호드카드",4;		// Hode Card
		else cutin "황소카드",4; // Minorous Card
		
		mes "[Lhimetorra]";
		switch(.@card_1_money) {
		case 1:
			mes " 你必须努力才能变得富有。别想其他事情……专注于目标并为之付出努力。 ";
			next;
			mes "[Lhimetorra]";
			mes " 那么祝你好运，尽力而为。 ";
			break;
		case 2:
			mes " 非常稀有的东西可能会来到你身边。金矿自古以来就是许多人的梦想，而你的金矿就在眼前。 ";
			next;
			mes "[Lhimetorra]";
			mes " 总而言之，一大笔财富就在眼前。我很期待。 ";
			break;
		case 3:
			mes " 胃袋里一定藏着秘密宝藏。你的口袋里或许也有些什么。 ";
			next;
			mes "[Lhimetorra]";
			mes " 你是否在对别人隐瞒什么？应该把它们丢掉，否则可能带来厄运。 ";
			break;
		case 4:
			mes " 卡片说你不该太贪心，否则可能自掘坟墓。 ";
			next;
			mes "[Lhimetorra]";
			mes " 你可能不喜欢这话，但应该接受卡片的建议……！ ";
			break;
		case 5:// Dustiness Card
			mes " 你知道蛾子的翅膀上有无数粉末吗？蛾子象征财富，因为它能像收集翅膀上的粉末一样积累财富。 ";
			next;
			mes "[Lhimetorra]";
			mes " 年轻人，你会积累很多财富。 ";
			break;
		case 6:
			mes " 你必须努力才能富有。别想其他事情，只要专注目标并付出努力就会有帮助。 ";
			next;
			mes "[Lhimetorra]";
			mes " 祝你好运，尽力而为。 ";
			break;
		case 7:

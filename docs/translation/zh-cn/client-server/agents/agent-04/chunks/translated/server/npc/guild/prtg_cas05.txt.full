// Treasure Room Exit
//============================================================
prtg_cas05,281,176,0	script	#Lever_PR05	111,{
	mes " ";
	mes "这里有一个小拉杆。要拉动它吗？";
	next;
	if(select("拉动。:不拉。") == 1) {
		close2;
		warp "prtg_cas05",36,38;
		end;
	}
	close;
}


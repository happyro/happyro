// Pintados Festival :: malaya_pintados
//============================================================
/*
Description
-----------
The Pintados Festival begins when players have accumulated 1000 Lesser Agimats,
1000 Silver Crosses, and 300 dyestuffs, and lasts for 7 days. During that time,
players are able to create a tattoo.

Global Variables
----------------
$malaya_pintados_00  - Festival time limit, in 30-minute intervals. (range: 0~344)
$malaya_pintados_01  - Number of Lesser Agimats collected. (range: 0~1000)
$malaya_pintados_02  - Number of Silver Crosses collected. (range: 0~1000)
$malaya_pintados_03  - Number of dyestuffs collected. (range: 0~300)
$malaya_pintados_04$ - Last player to create a tattoo.
*/

ma_fild01,1,1,4	script	Pintados Manager#pin	894,{
	if (callfunc("F_GM_NPC",1854,0) == 1) {
		mes "宾果！";
		next;
	} else {
		mes "发生错误。";
		close;
	}
	mes "你好，我是 Pintados 节庆管理员。请选择项目。";
	mes "时间值：("+$malaya_pintados_00+"/344)";
	mes "小护符值：("+$malaya_pintados_01+"/1,000)";
	mes "十字架值：("+$malaya_pintados_02+"/1,000)";
	mes "染料值：("+$malaya_pintados_03+"/300)";
	mes "最近的纹身师："+$malaya_pintados_04$;
	next;
	switch(select("东药按钮？开始与结束:详情按钮？调整数值:开始计时器:结束计时器")) {
	case 1:
		mes "这是东药控制按钮。";
		mes "可以设置节庆的开始或结束值。";
		next;
		switch(select("开始 Pintados 节庆:结束 Pintados 节庆:开启 NPC:关闭 NPC")) {
		case 1:
			set $malaya_pintados_00,1;
			donpcevent "Pintados Manager#pin::OnEnable";
			mes "开始 Pintados 节庆。";
			close;
		case 2:
			donpcevent "Pintados Manager#pin::OnDisable";
			mes "结束 Pintados 节庆。";
			close;
		case 3:
			donpcevent "Pintados Manager#pin::OnEnableNPC";
			mes "添加 NPC。";
			close;
		case 4:
			donpcevent "Pintados Manager#pin::OnDisableNPC";
			mes "移除 NPC。";
			close;
		}
	case 2:
		mes "调整全局数值。请选择要调整的值。";
		next;
		while(1) {
			switch(select("Complete Adjustment:Time ("+$malaya_pintados_00+"):Lesser Agimat ("+$malaya_pintados_01+"):Silver Cross ("+$malaya_pintados_02+"):Dyestuffs ("+$malaya_pintados_03+")")) {
			case 1:
				mes "全局调整完成。";
				close;
			case 2:
				mes "调整时间 [0～344]";
				mes "全局每 30 分钟增加 1。";
				mes "1 - 49 -> 第1天";
				mes "50 - 98 -> 第2天";
				mes "99 - 147 -> 第3天";
				mes "148 - 196 -> 第4天";
				mes "197 - 245 -> 第5天";
				mes "246 - 294 -> 第6天";
				mes "295 - 343 -> 第7天";
				mes "全局值 1 = 1 小时。";
				next;
				input .@input;
				if (.@input < 0 || .@input > 344)
					close;
				set $malaya_pintados_00, .@input;
				break;
			case 3:
				mes "调整小护符累计值。";
				mes "数值可在 0 到 1000 之间调整。";
				next;
				input .@input;
				if (.@input < 0 || .@input > 1000)
					close;
				set $malaya_pintados_01, .@input;
				break;
			case 4:
				mes "调整银十字架累计值。";
				mes "数值可在 0 到 1000 之间调整。";
				next;
				input .@input;
				if (.@input < 0 || .@input > 1000)
					close;
				set $malaya_pintados_02, .@input;
				break;
			case 5:
				mes "调整染料累计值。";
				mes "数值可在 0 到 300 之间调整。";
				next;
				input .@input;
				if (.@input < 0 || .@input > 300)
					close;
				set $malaya_pintados_03, .@input;
				break;
			}
			mes "时间值：（"+$malaya_pintados_00+"/344）";
			mes "Lesser Agimat Value: ("+$malaya_pintados_01+"/1,000)";
			mes "Cross Value: ("+$malaya_pintados_02+"/1,000)";
			mes "Dyestuffs Value: ("+$malaya_pintados_03+"/300)";
			mes "这是当前数值。要调整吗？";
			next;
		}
	case 3:
		initnpctimer;
		break;
	case 4:
		stopnpctimer;
		break;
	}
	end;

// Moved to individual NPCs for smoother processing.
OnInit:
	if ($malaya_pintados_00 > 0) {
		// donpcevent "Pintados Manager#pin::OnEnableNPC";
		initnpctimer;// unoffical fix
	}
	end;

OnTimer1800000:
	if ($malaya_pintados_00 > 0 && $malaya_pintados_00 < 344) {
		set $malaya_pintados_00,$malaya_pintados_00+1;
		initnpctimer;
	} else {
		set $malaya_pintados_00,0;
		donpcevent "Pintados Manager#pin::OnDisable";
	}
	end;
OnEnable:
	initnpctimer;
	donpcevent "Pintados Manager#pin::OnEnableNPC";
	announce "‘Pintados 节庆’将在奇妙村举行一周。",bc_all,"0xFB9D04",FW_NORMAL,12;
	end;
OnDisable:
	stopnpctimer;
	set $malaya_pintados_00,0;
	set $malaya_pintados_01,0;
	set $malaya_pintados_02,0;
	set $malaya_pintados_03,0;
	donpcevent "Pintados Manager#pin::OnDisableNPC";
	announce "‘Pintados 节庆’圆满结束。",bc_all,"0xFB9D04",FW_NORMAL,12;
	end;
OnEnableNPC:
	set .@str$, "::OnEnable";
OnDisableNPC:
	if (.@str$ == "")
		set .@str$, "::OnDisable";
	donpcevent "Tourist#pin01"+.@str$;
	donpcevent "Tourist#pin02"+.@str$;
	donpcevent "Tourist#pin03"+.@str$;
	donpcevent "Young Tattooist#pin04"+.@str$;
	donpcevent "Tourist#pin05"+.@str$;
	donpcevent "Drumming Young Man#pin06"+.@str$;
	donpcevent "Drumming Young Man#pin07"+.@str$;
	donpcevent "Drumming Young Man#pin08"+.@str$;
	donpcevent "Beat Catching Boy#pin09"+.@str$;
	donpcevent "Beat Catching Boy#pin10"+.@str$;
	donpcevent "Beat Catching Boy#pin11"+.@str$;
	end;
}

ma_fild01,179,260,2	script	Festival Helper Boy#pin	577,{
	if (checkweight(1201,1) == 0 || MaxWeight - Weight < 1000) {
		mes "由于携带物品过多，无法继续。";
		close;
	}
	if ($malaya_pintados_00 == 0) {
		if ($malaya_pintados_01 > 999 && $malaya_pintados_02 > 999 && $malaya_pintados_03 > 299) {
			set $malaya_pintados_00,1;
			donpcevent "Pintados Manager#pin::OnEnable";
			emotion ET_THROB;
			mes "[Isco]";
			mes "许多冒险者帮忙找回了我带回村子的节庆物品。";
			next;
			emotion ET_DELIGHT;
			mes "[Isco]";
			mes "嘿嘿……现在我们可以举办‘^7A96E0Pintados 节庆^000000’了。";
			close;
		}
		// fall through
	} else {
		mes "[Isco]";
		mes "嘿嘿……热闹的‘^7A96E0Pintados 节庆^000000’正在举行。";
		next;
		if ($malaya_pintados_00 > 0 && $malaya_pintados_00 < 50) {
			emotion ET_DELIGHT;
			mes "[Isco]";
			mes "今天是‘^7A96E0Pintados 节庆^000000’第一天。节庆持续 7 天，玩得开心。";
			close;
		} else if ($malaya_pintados_00 > 49 && $malaya_pintados_00 < 99) {
			mes "[Isco]";
			mes "哦！你知道吗？";
			mes "村里的纹身师只在‘^7A96E0Pintados 节庆^000000’期间绘制纹身。";
			close;
		} else if ($malaya_pintados_00 > 98 && $malaya_pintados_00 < 148) {
			mes "[Isco]";
			mes "今天是‘^7A96E0Pintados 节庆^000000’第三天。";
			next;
			mes "[Isco]";
			mes "村民说，名叫"+$malaya_pintados_04$+"的冒险者在节庆上纹了身。";
			close;
		} else if ($malaya_pintados_00 > 147 && $malaya_pintados_00 < 197) {
			mes "[Isco]";
			mes "村民们说，名叫"+$malaya_pintados_04$+"的冒险者在节庆上纹了身。";
			next;
			mes "[Isco]";
			mes "纹身师很吓人，不会随便给人纹身，所以那位冒险者一定很特别。";
			close;
		} else if ($malaya_pintados_00 > 196 && $malaya_pintados_00 < 246) {
			mes "[Isco]";
			mes "名叫"+$malaya_pintados_04$+"的冒险者在村里很有名。";
			next;
			mes "[Isco]";
			mes "你见过^FF8440Bakonawa^000000吗？那是传说会吞下月亮的怪物。据说它非常凶猛。";
			close;
		} else if ($malaya_pintados_00 > 245 && $malaya_pintados_00 < 295) {
			emotion ET_CRY;
			mes "[Isco]";
			mes "真遗憾。许多冒险者帮忙举办‘^7A96E0Pintados 节庆^000000’，现在只剩一天了。";
			close;
		} else {
			emotion ET_CRY;
			mes "[Isco]";
			mes "天哪！今天已经是‘^7A96E0Pintados 节庆^000000’最后一天。真不敢相信庆典就要结束了。";
			close;
		}
	}
	emotion ET_CONFUSE;
	mes "[Isco]";
	mes "糟糕。节庆要结束了，我们该怎么办？";
	next;
	switch(select("What is it?:How many did you collect?:Brought back a lost belonging.")) {
	case 1:
		mes "[Isco]";
		mes "自古以来，奇妙村一直举办传统节庆，";
		mes "名为‘^7A96E0Pintados 节庆^000000’。";
		next;
		emotion ET_OTL;
		mes "[Isco]";
		mes "我想这次赶不上节庆了。";
		next;
		select("为什么？");
		mes "[Isco]";
		mes "我奉马来港之命，带着 1000 个小护符、1000 个银十字架和 300 份染料回村。";
		next;
		mes "[Isco]";
		mes "但^FF8440Bongisungisu^000000突然出现，把物品从我这里抢走了。";
		next;
		select("Are you hurt?");
		emotion ET_OHNO;
		mes "[Isco]";
		mes "幸好没有。";
		next;
		mes "[Isco]";
		mes "但我遇到了大麻烦。没有那些物品就无法举办‘^7A96E0Pintados 节庆^000000’。我该怎么办？";
		close;
	case 2:
		mes "[Isco]";
		mes "许多冒险者正在帮忙，但目前只收集到……";
		next;
		mes "[Isco]";
		mes "目前有小护符"+$malaya_pintados_01+"、银十字架"+$malaya_pintados_02+"、染料"+$malaya_pintados_03+"。";
		next;
		emotion ET_OHNO;
		mes "[Isco]";
		mes "唉……距离开始‘^7A96E0Pintados 节庆^000000’还缺少材料。";
		close;
	case 3:
		set .@str$, (Sex == SEX_MALE)?"Bro":"Sis";
		break;
	}
	emotion ET_THROB;
	mes "[Isco]";
	mes "哦~真的吗？哇！";
	mes "谢谢你！"+strcharinfo(0)+"，"+.@str$+"！！";
	mes "嘿嘿。你带来了什么？";

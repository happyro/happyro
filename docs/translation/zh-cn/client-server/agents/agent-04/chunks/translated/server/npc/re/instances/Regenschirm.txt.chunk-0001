1@rgsr,1,1,0	script	#171_rgsr_control	HIDDEN_WARP_NPC,{
	end;

OnInstanceInit:
	'map$ = instance_mapname("1@rgsr");
	'rgsr = 'activate = 0;
	deletearray 'rescued;
	deletearray 'rsgr_c;

	disablenpc instance_npcname("Researcher#rgsr_ev_0");
	disablenpc instance_npcname("Access Controller#rgsr");
	disablenpc instance_npcname("#rgsr_touch_mob_0");
	disablenpc instance_npcname("#rgsr_touch_mob_1");
	disablenpc instance_npcname("#rgsr_warp_0");
	disablenpc instance_npcname("Est#rgsr");
	disablenpc instance_npcname("Rebellion Crew#rgsr_dum01");
	disablenpc instance_npcname("Aas#rgsr3");
	disablenpc instance_npcname("Goni#rgsr");
	disablenpc instance_npcname("Est#rgsr2");
	disablenpc instance_npcname("Central Room#rgsr");
	disablenpc instance_npcname("Restrained Specimen#rgsr");
	disablenpc instance_npcname("Control Device#rgsr0");
	disablenpc instance_npcname("Control Device#rgsr1");
	disablenpc instance_npcname("Control Device#rgsr2");
	disablenpc instance_npcname("Control Device#rgsr3");
	disablenpc instance_npcname("Aas#rgsr4");
	end;

OnEvent01:
	enablenpc instance_npcname("#rgsr_touch_mob_0");
	enablenpc instance_npcname("#rgsr_touch_mob_1");
	donpcevent instance_npcname("#rgsr_mob_1") + "::OnSummon";
	end;

OnEvent02:
	enablenpc instance_npcname("#rgsr_warp_0");
	donpcevent instance_npcname("#rgsr_mob_2") + "::OnSummon";
	end;

OnEvent03:
	enablenpc instance_npcname("Restrained Specimen#rgsr");
	enablenpc instance_npcname("Control Device#rgsr0");
	enablenpc instance_npcname("Control Device#rgsr1");
	enablenpc instance_npcname("Control Device#rgsr2");
	enablenpc instance_npcname("Control Device#rgsr3");
	end;

OnEvent04:
	if ('rgsr == 13) {
		'rgsr = 14;
		donpcevent instance_npcname("#rgsr_boss") + "::OnSummon";
	}
	end;
}

1@rgsr,123,42,5	script	Oscar#rgsr	4_M_LGTGUARD,{
	mes "[Oscar]";
	mes "船长偷偷进入了控制面板室。";
	mes "轻声行动。";
	close;
}

1@rgsr,131,58,3	script	Aas#rgsr	4_EP17_AS,{
	cutin "ep171_as02",1;
	mes "[Aas]";
	mes "门通常由安保系统锁定，所以我必须留在那里操作控制器。";
	mes "如你所见，大多数入口已经被封锁。";
	mes "你好。";
	next;
	mes "[Aas]";
	mes "逐一处理需要一些时间。";
	mes "我会通过对讲机继续帮助你。";
	next;
	mes "[Aas]";
	mes "你必须穿过餐厅才能到达走廊。";
	mes "Est 将独自执行行动。";
	next;
	mes "[Aas]";
	mes "如果发生骚动，可能是 Est 引起的。继续前先去确认她的情况。";
	next;
	mes "[Aas]";
	mes "冒险者，你现在该走了。我会继续确保安保控制器安全。";
	mes "里面可能关押着研究员。";
	next;
	mes "[Aas]";
	mes "请优先考虑他们的安全。";
	mes "现在出发吧。";
	close2;
	if ('rgsr == 0) {
		'rgsr = 1;
		donpcevent instance_npcname("#171_rgsr_control") + "::OnEvent01";
	}
	warp 'map$,127,67;
	end;
}

1@rgsr,60,138,0	script	Access Controller#rgsr	4_ENERGY_WHITE,{
	enablenpc instance_npcname("Researcher#rgsr_ev_0");
	if ('rgsr == 2) {
		'rgsr = 3;
		npctalk "请求通信。";
		sleep2 2750;
		npctalk "正在分析信号。";
		sleep2 2750;
		npctalk "正在启动语音传输……";
		sleep2 2750;
		npctalk "接通了吗？我是 Aas。";
		sleep2 2750;
		npctalk "我已经控制了部分安保系统，但还没有完全访问权限。";
		sleep2 2750;
		npctalk "除非发生重大骚动，否则警报和安保设备不会启动。";
		sleep2 2750;
		npctalk "我觉得你应该打开这扇门，进入走廊。";
		sleep2 2750;
		npctalk "让一名被拘研究员把手放在装置上。";
		sleep2 2750;
		npctalk "……*滋*……";
		sleep2 2750;
		npctalk "语音传输结束。";
		sleep2 2750;
		hideonnpc();
		enablenpc();
		npctalk "研究员：介意我打开门吗？",instance_npcname("Researcher#rgsr_ev_0");
		'rgsr = 4;
	}
	end;
}

1@rgsr,59,132,7	script	Researcher#rgsr_ev_0	4_M_NFMAN,{
	if ('rgsr == 4 && 'activate == 0) {
		'activate = 1;
		mes "[Researcher]";
		mes "生物识别扫描仍在运行，我会留在这里保持门开启。";
		mes "如果你赶时间，请先走……";
		dispbottom "Control : Identity confirmed.";
		donpcevent instance_npcname("#171_rgsr_control") + "::OnEvent02";
		close2;
		sleep2 800;
		npctalk "Researcher : ...huh... what the hell is this...";
		end;
	}
}

1@rgsr,36,211,3	script	Est#rgsr	4_F_ESTLOVELOY,{
	if ('rgsr < 7) {
		cutin "ep162_est03",2;
		mes "[Est]";
		mes "是你清除了外面的毒气吗？";
		mes "你来得正是时候。";
		mes "因为毒气，门被强制锁上了！";
		next;
		cutin "ep162_est01",2;
		mes "[Est]";
		mes "Aas 还需要一段时间才能破解控制器并释放毒气。";
		mes "我本来打算自己做的。";
		next;
		cutin "ep162_est02",2;
		mes "[Est]";
		mes "这里的守卫穿着和我们之前看到的心灵猎手一样的衣服。";
		mes "我觉得自己无法独自救出所有研究员。";
		next;
		mes "[Est]";
		mes "看来我们已经把大多数人聚集到这里了。";
		mes "我们来制定下一步策略。";
		next;
		cutin "ep162_est01",2;
		mes "[Est]";
		mes "另一边有实验室，那里可能一团糟。";
		mes "不知道会不会发生一场大战。";
		next;
		mes "[Est]";
		mes "从现在起，反叛军特种部队将优先救援被拘研究员。";
		mes "明白的话，快行动！";
		next;
		mes "[Est]";
		mes "好，冒险者，找到通信设备并联系 Aas。";
		next;
		mes "[Est]";
		mes "你必须打开私人实验室的入口。";
		if ('rgsr == 4)
			'rgsr = 5;
		close3;
	}
	cutin "ep162_est02",2;
	mes "[Est]";
	mes "嗯。我们先集中营救人质。";
	mes "去找 Aas 说过的安保卫兵房间。";
	close3;
}

1@rgsr,26,219,0	script	Access Controller#rgsr2	4_ENERGY_WHITE,{
	if ('rgsr < 5) {
		mes "代码未激活。";
		mes "通信已终止。";
		close;
	}
	if ('rgsr == 5) {
		mes "语音传输已连接。";
		close2;
		if ('rgsr == 5)
			'rgsr = 6;
		npctalk "等待通信回应……";
		sleep2 2750;
		npctalk "Aas：Est 指挥官？我们关闭了大厅门锁，但发生什么问题了？";
		sleep2 2750;
		npctalk "Aas：哦，是你这位冒险者。我向你报告一下。我还没有完全接管安保控制系统。";
		sleep2 2750;
		npctalk "Aas：看来还需要一些时间，但我已经控制了大部分监控模块。";
		sleep2 2750;
		npctalk "Aas：大部分敌军都在大厅和休息区，所以实验室区域的守卫较少。";
		sleep2 2750;
		npctalk "Aas：不过，为了确保中央控制室安全，你必须经过检测到许多实验对象的卫兵房间。";
		sleep2 2750;
		npctalk "Aas：优先确保实验室安全，然后是卫兵房间……*咔*";
		sleep2 2000;
		npctalk "Est：嗯，刚才那是什么？",instance_npcname("Est#rgsr");
		if ('rgsr == 6)
			'rgsr = 7;
		end;
	}
	if ('rgsr < 7)
		end;
	else {
		mes "代码未激活。";
		mes "通信已终止。";
		close;
	}
}

1@rgsr,235,44,5	script	Aas#rgsr2	4_EP17_AS,{
	if ('rgsr == 7) {
		for (.@i = 0; .@i < 3; .@i++) {
			if (!'rescued[.@i])
				.@miss++;
		}
		if (.@miss) {
			cutin "ep171_as02",2;
			mes "[Aas]";
			mes "嘿，你检查完所有实验室了吗？";
			mes "请确认是否还有被拘研究员。";
			close3;
		}
		cutin "ep171_as02",1;
		mes "[Aas]";
		mes "备用万能钥匙还在。";
		mes "没有它，我就无法控制安保系统。你还好吗？";
		next;
		mes "[Aas]";
		mes "现在你只需要检查中央房间。";
		mes "你说心灵猎手？";
		mes "来自 Schlein 的叛徒已经逃走。";
		next;
		mes "[Aas]";
		mes "我们的重点就是那个房间。";
		mes "大致就是这样。";
		mes "Est 在哪里？";
		next;
		cutin "16go_01",0;
		mes "[Goni]";
		mes "... ... ...";
		next;
		cutin "ep171_as02",1;
		mes "[Aas]";
		mes "你还必须继续寻找所有研究员吗？";
		mes "这是必要的，我明白了。";
		next;
		mes "[Aas]";
		mes "冒险者，我们前往中央房间。";
		mes "在那里和我会合。";
		close2;
		cutin "",255;
		if ('rgsr == 7) {
			enablenpc instance_npcname("Central Room#rgsr");
			'rgsr = 8;
			disablenpc instance_npcname("#rgsr_mob_2");
		}
		end;
	}
	cutin "ep171_as02",1;
	mes "[Aas]";
	mes "冒险者，我们前往中央房间。";
	mes "在那里和我会合。";
	close3;
}

1@rgsr,235,143,5	script	Detained Researcher#rgsr_q01	4_F_SCIENCE,{
	if (!'rescued[0]) {
		mes "[Researcher]";
		mes "我的……我的研究……材料……";
		mes "他们全拿走了！";
		mes "他们把一切都拿走了！";
		next;
		cutin "16go_01",0;
		mes "[Goni]";
		mes "... ... ...";
		next;
		cutin "",255;
		npctalk "我要活下去！谢谢你！";
		mes "哦，你是来保护我的吗？";
		mes "我跟你走，谢谢！";
		next;
		mes "[Researcher]";
		mes "哦，你是来保护我的吗？";
		mes "我跟你走，谢谢！";
		'rescued[0] = 1;
		close2;
		disablenpc();
	}
	end;
}

1@rgsr,237,108,3	script	Detained Researcher#rgsr_q02	4_LGTSCIENCE,{
	if (!'rescued[1]) {
		mes "[Researcher]";
		mes "我还以为他们把所有疯子都赶出去了……";
		mes "我就这样撞到了后脑勺。";
		mes "啧。";
		next;
		mes "[Researcher]";
		mes "你是来救我们的吗？";
		mes "带我离开这里！";
		mes "我们无法逃跑，因为他们在门外释放了毒气！";
		next;
		mes "[Researcher]";
		mes "是的，我对心灵猎手略知一二，我会把一切告诉你！";
		next;
		cutin "ep162_est02",2;
		mes "[Est]";
		mes "啊？你还有更多信息要分享吗？";
		mes "要不要和我出去慢慢谈？";
		next;
		cutin "ep162_est01",2;
		mes "[Est]";
		mes "我把这家伙带出去，你去看看其他房间。";
		'rescued[1] = 1;
		close2;
		cutin "",255;
		disablenpc();
	}
	end;
}

1@rgsr,237,71,3	script	Detained Researcher#rgsr_q03	4_F_FRUIT,{
	if (!'rescued[2]) {
		mes "[Researcher]";
		mes "请帮帮我！";
		mes "我干了这么多活，却没有拿到报酬！";
		next;
		mes "[Researcher]";
		mes "Schlein，Schlein 在哪里？";
		mes "他是叛徒！";
		mes "我亲眼看见他杀了卫兵……";
		next;
		select("冷静下来。");
		mes "[Researcher]";
		mes "现在安全吗？";
		mes "我很高兴能被 Rekenber 雇用，但这么大的公司到底怎么了……";
		next;
		mes "[Researcher]";
		mes "你说什么？反叛军要来救我们？";
		mes "我不能直接跟你一起逃走吗？";
		next;
		mes "[Researcher]";
		mes "哦……你是侦察队的一员？";
		mes "好吧。我会等救援队。";
		mes "很多人打破窗户逃走了……";
		next;
		mes "[Researcher]";
		mes "哦，你已经知道了。";
		mes "好吧。我现在会安静等待。";
		mes "不过你的制服真帅。";
		'rescued[2] = 1;
		close;
	}
	mes "[Researcher]";
	mes "我知道。我知道。";
	mes "如果我在这里等，反叛军会来救我吗？";
	mes "那我就没事了。";
	next;
	mes "[Researcher]";
	mes "不过，你的制服真的很帅。";
	close;
}

1@rgsr,241,51,0	script	Scattered Documents#rgsr	4_ENERGY_BLUE,{
	if (isbegin_quest(7863) == 0) {
		mes "这是 Enterprise 安保队伍的名单。";
		mes "有些被圈了起来……有些被划掉了。";
		next;
		cutin "ep171_as01",2;
		mes "[Aas]";
		mes "被圈起来的可能是同意被招募的人……";
		mes "我的队伍就是旁边标着 X 的那一组。";
		next;
		mes "[Aas]";
		mes "这是一份佣兵合同……";
		mes "这是袭击当天的大致计划。";
		mes "真不敢相信事情会发展到这一步……";
		next;
		mes "[Aas]";
		mes "这是故意要激怒我。";
		mes "这次不会得逞。我会追查到底。";
		next;
		mes "[Aas]";
		mes "我最好把它带回去交给 Tess 分析。";
		setquest 7863;
		close3;
	}
	mes "我已经拿到这里的数据了。";
	mes "这里没什么可看的了。";
	close;

OnInstanceInit:
	questinfo(QTYPE_CLICKME,QMARK_YELLOW,"isbegin_quest(7863) == 0");
	end;
}

1@rgsr,125,157,0	script	Central Room#rgsr	4_ENERGY_BLUE,{
	if ('rgsr == 8) {
		'rgsr = 9;
		enablenpc instance_npcname("Aas#rgsr3");
		enablenpc instance_npcname("Goni#rgsr");
		enablenpc instance_npcname("Est#rgsr2");
		npctalk "我迟到了吗？",instance_npcname("Aas#rgsr3");
		sleep2 1800;
		npctalk "不，你来得正是时候。",instance_npcname("Est#rgsr2");
		end;
	}
	mes "装置无法运行。";
	close;
}

1@rgsr,128,157,3	script	Aas#rgsr3	4_EP17_AS,{
	if ('rgsr > 13)
		end;
	if ('rgsr == 9) {
		'rgsr = 10;
		.@aas$ = instance_npcname("Aas#rgsr3");
		.@gonie$ = instance_npcname("Goni#rgsr");
		.@erst$ = instance_npcname("Est#rgsr2");
		npctalk "Aas：中央房间似乎是空的。我进去检查一下。",.@aas$;
		sleep2 3000;
		npctalk "Aas：我先把研究员带离这里，可以吗？",.@erst$;
		sleep2 3000;
		npctalk "Aas：是的，系统没有检测到其他情况。按照目前的进展，敌人都已经被控制。",.@aas$;
		sleep2 3000;
		npctalk "Est：你还在害怕别的东西吗？我已经要回去了！",.@erst$;
		sleep2 3000;
		npctalk "Goni：……我也是。",.@gonie$;
		sleep2 3000;
		npctalk "Est：实验室里还剩几个研究员，我去把他们带来。我会等着。",.@erst$;
		sleep2 3000;
		npctalk "Est：好，Goni。你先去主大厅确保道路安全。我带其他人去会议室。",.@erst$;
		sleep2 3000;
		npctalk "Goni：*点头*",.@gonie$;
		sleep2 3000;
		disablenpc instance_npcname("Goni#rgsr");
		disablenpc instance_npcname("Est#rgsr2");
		npctalk "Aas：那么冒险者，我们去看看中央房间。",.@aas$;
		if ('rgsr == 10)
			'rgsr = 11;
		end;
	}
	cutin "ep171_as02",1;
	mes "[Aas]";
	mes "中央房间就在前面。";
	next;
	if (select("进入。:等待。") == 2) {
		mes "[Aas]";
		mes "准备好后请告诉我。";
		mes "不知道为什么，门关得很紧；保持通道需要一些时间。";
		next;
		mes "[Aas]";
		mes "根据安保系统确认，里面没有检测到任何东西……";
		mes "不过我还是想确认一下房间内部。";
		close3;
	}
	mes "[Aas]";
	mes "我首先要关闭自动上锁装置，然后马上跟上。";
	if ('rgsr == 11) {
		'rgsr = 12;
		donpcevent instance_npcname("#171_rgsr_control") + "::OnEvent03";
	}
	close2;
	cutin "",255;
	warp 'map$,126,164;
	end;
}

1@rgsr,124,152,5	script	Goni#rgsr	4_M_GONY,{

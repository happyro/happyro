//===== rAthena Script =======================================
//= Instance: Villa of High Priest.
//===== Description: =========================================
//- [Walkthrough conversion]
//- Part of the Episode 18 main quest.
//===== Changelogs: ==========================================
//= 1.0 First version. [Capuche]
//============================================================

// Main Quest: Step 61.
oz_dun01,219,117,5	script(CLOAKED)	Ira#c12_01	4_M_BRZ_JACI,{
	if (ep18_main == 54) {
		.@md_name$ = "High Priest's Villa";

		mes "[Ira]";
		mes "别墅的入口？钥匙就在入口处。";
		mes "那里施加了某种传送魔法。";
		mes "准备好了吗？要我带你去别墅吗？";
		next;
		mes "[Ira]";
		mes "还有……我们不知道里面会发生什么。";
		mes "如果你有同伴，建议一起前往。";
		next;
		switch( select( "申请‘" + .@md_name$ + "'.", "进入‘" + .@md_name$ + "'." ) ) {
		case 1:
			if (getcharid(1) == 0 || is_party_leader() == false) {
				mes "^4d4dff这是纪念活动。";
				mes "必须由队长申请纪念地下城。^000000";
				close;
			}
			mes "[Ira]";
			mes "那么让我护送你。";
			if (instance_create(.@md_name$) < 0) {
				mes "队伍：" + getpartyname(getcharid(1)) + "";
				mes "队长：" + strcharinfo(0) + "";
				mes "^0000ff" + .@md_name$ + " ^000000- 未知错误";
				close;
			}
			close;
		case 2:
			switch( instance_enter(.@md_name$) ) {
			case IE_OTHER:
				mes "[Ira]";
				mes "^ff0000发生未知错误。^000000";
				close;
			case IE_NOINSTANCE:
				mes "[Ira]";
				mes "嗯？请确认队长是否申请了进入别墅？";
				close;
			case IE_NOMEMBER:
				mes "[Ira]";
				mes "^ff0000只有队伍成员可以进入纪念地下城。^000000";
				close;
			case IE_OK:
				mapannounce "oz_dun01", "" + strcharinfo(0) + " from the " + getpartyname( getcharid(1) ) + "'s party has entered the " + .@md_name$ + ".", bc_map, 0xFF99;
				// warp "1@adv",123,17;
				end;
			}
		}
	}
	end;
}


// Censor Bar
//============================================================
rachel,91,273,8	script	?	930,{
	if (countitem(983) > 0 && countitem(7111) > 99 && countitem(938) > 98 && Zeny > 99999) {
		mes "[？]";
		mes "咯咯笑……是我的伙伴吧？";
		mes "那么，你带齐我要求的东西了吗？";
		mes "太好了，现在我可以制作帮助你";
		mes "隐藏身份的物品！咯咯笑……";
		next;
		mes "- 嗡嗡 嗡嗡 咔哒 咔哒 -";
		mes "- 摸索 摸索 摸索 摸索 -";
		mes "- 嗡嗡 嗡嗡 咔哒 咔哒 -";
		mes "- 摸索 摸索 摸索 摸索 -";
		next;
		mes "[？]";
		mes "……嘿，别从我肩后偷看。";
		mes "我不想和你分享";
	mes "";
	mes "";
	mes "";
	mes "";
	mes "";
	mes "";
	mes "";
	mes "";
	mes "";
	mes "";
	mes "";
	mes "";
	mes "";
	mes "";
	mes "";
	mes "";
	mes "";
	mes "";
	mes "";
	mes "";
	mes "";
	mes "";
	mes "";
	mes "";
	mes "";
	mes "";
	mes "";
	mes "";
	mes "";
	mes "";
	mes "";
	mes "";
	mes "";
	mes "";
	mes "";
	mes "";
	mes "";
	mes "";
		mes "";
		mes "";
		mes "";
		mes "";
		mes "";
		mes "";
		next;
		mes "- 嗡嗡 嗡嗡 咔哒 咔哒 -";
		mes "- 摸索 摸索 摸索 摸索 -";
		mes "- 嗡嗡 嗡嗡 咔哒 咔哒 -";
		mes "- 摸索 摸索 摸索 摸索 -";
		next;
		delitem 983,1; //Black_Dyestuffs
		delitem 7111,100; //Smooth_Paper
		delitem 938,99; //Sticky_Mucus 
		set Zeny,Zeny-100000;
		getitem 5175,1; //Anonimity_Request
		mes "[？]";
	mes "呼……完成了。制作并不难，不过……";
	mes "嘻嘻，重要的是你现在可以隐藏身份了。拿去吧。";
	mes "希望这面具能帮你躲开敌人。啊哈哈哈！";
		close;
	}
	mes "[？]";
	mes "……不行！你可别想查出我的身份！";
	mes "你甚至不许和我说话！";
	mes "嘘——！别让敌人知道我在哪里！";
	next;
	mes "[？]";
	mes "嗯？你是个善良的人。";
	mes "你正在逃避什么，";
	mes "想隐藏自己的身份，对吧？";
	mes "嗯……我猜对了……嘻嘻。";
	next;
	mes "[？]";
	mes "好吧，我应该对同伴友善。";
	mes "虽然不能向你透露身份，";
	mes "但我可以帮你安全躲开敌人。";
	next;
	mes "[？]";
	mes "带给我 ^FF00001 个黑色染料^000000、";
	mes "^FF0000100 张油纸^000000、^FF000099 个黏液^000000，";
	mes "以及 ^FF0000100,000 Zeny^000000。";
	mes "这样我就会帮你，嘻嘻。";
	next;
	mes "[？]";
	mes "你现在可以走了。";
	mes "我们总能互相帮助。";
	mes "收集完所有材料后，";
	mes "别让任何人发现，悄悄回来。嘻嘻。";
	close;
}

// Feather Beret
//============================================================
rachel,152,131,3	script	Sakjul	928,{
	if (countitem(5172) > 0 && countitem(7063) > 99 && countitem(982) > 0) {
		mes "[Sakjul]";
		mes "太好了，你带齐了制作^FF0000羽毛贝雷帽^000000的材料！";
		mes "作为劳动奖励，我会亲自制作这顶帽子。";
		next;
		mes "[Sakjul]";
		mes "站在我旁边，庄严地观看制作过程。";
		mes "保持正直，站直身体，";
		mes "目视前方！";
		next;
		mes "[Sakjul]";
		mes "如果不按我说的做，";
		mes "^FF0000帽子制作可能会失败！";
		mes "如果制作失败，所有材料都会消失，";
		mes "我不会为你的错误负责！^000000";
		next;
		mes "- THUD THUD -";
		mes "- THUD THUD -";
		mes "- THUD THUD -";
		mes "- BOOM -";
		next;
		mes "- THUD THUD -";
		mes "- THUD THUD -";
		mes "- THUD THUD -";
		mes "- BOOM -";
		next;
		set .@result,rand(1,10);
		if (.@result == 4) {
			delitem 5172,1; //Beret 
			delitem 7063,100; //Soft_Feather 
			delitem 982,1; //White_Dyestuffs
			mes "[Sakjul]";
			mes "帽子确实做出来了，";
			mes "但我不能让它落入别人手中！";
			mes "羽毛贝雷帽的关键是贝雷帽与羽毛的精准角度，";
			mes "但这顶帽子的角度有点歪，质量太差，称不上我的作品！";
			next;
			mes "[Sakjul]";
			mes "我理解你对结果很遗憾。";
			mes "不过别太失望，再试一次！";
			mes "世上没有不可能，你一定能做到！";
			next;
			mes "[Sakjul]";
			mes "现在振作起来！";
			mes "你已经做过一次了，";
			mes "再做一次不会困难。";
			mes "明白的话，去重新收集材料吧！";
			close;
		}
		delitem 5172,1; //Beret 
		delitem 7063,100; //Soft_Feather 
		delitem 982,1; //White_Dyestuffs
		getitem 5170,1; //Feather_Beret 
		mes "[Sakjul]";
		mes "太好了，我做成功了！看看羽毛与贝雷帽的美妙协调，";
		mes "搭配得恰到好处。";
		mes "我得说，这顶帽子如今是年轻人的必需品。";
		next;
		mes "[Sakjul]";
		mes "这顶帽子是用你的材料做的，";
		mes "所以它属于你。";
		mes "好好保管它，做一个优秀、自信的人。";
		close;
	}
	mes "[Sakjul]";
	mes "站直身体，保持紧张感！";
	mes "控制自己，正直行动！";
	mes "这才是受人尊敬的男子作风！";
	mes "现在的年轻人太软弱娇嫩了。";
	mes "年轻冒险者，你同意吗？";
	next;
	if (select("是，先生！:不。") == 1) {
		mes "[Sakjul]";
		mes "啊！我喜欢你的回答！";
		mes "最近很难见到像你这样自律的年轻人。";
		mes "不过你还没达到我期望的自律程度！";
		mes "嗯……对了，也许 ^FF0000羽毛贝雷帽^000000";
		mes "能让你看起来更自律。";
		next;
		mes "[Sakjul]";
		mes "我喜欢你的态度。";
		mes "因此，只要你带来材料，";
		mes "我愿意为你制作羽毛贝雷帽。明白吗？";
		next;
		mes "[Sakjul]";
		mes "材料是 ^FF00001 顶贝雷帽^000000、^FF0000100 根柔软羽毛^000000，";
		mes "以及 ^FF00001 个白色染料^000000。";
		mes "记住全部材料，并带来准确数量！";
		next;
		mes "[Sakjul]";
		mes "感谢我的提议，";
		mes "这顶帽子会让你更威严优雅！";
		mes "明白的话，马上去收集材料吧！";
		close;
	}
	mes "[Sakjul]";
	mes "我听不见！你的声音里没有自信！";
	mes "带着这种软弱态度，怎么在残酷世界生存？";
	mes "现在就振作起来！";
	close;
}

// Valkyrie Helm
//============================================================
hugel,147,103,3	script	Ghenirhemin	897,{
	if (moza_valkylie == 5) {
		set .@val2,rand(1,10);
		if (.@val2 == 3) {
			specialeffect EF_LIGHTSPHERE;
			mes "[Ghenirhemin]";
			mes "材料仍在融合。";
			next;
			mes "[Ghenirhemin]";
			mes "嗯？！哦……哦？！这不是……";
			mes "这不是……？！";
			next;
			specialeffect EF_FORESTLIGHT2;
			mes "[Ghenirhemin]";
			mes "啊……哈哈哈，成功了！成功了！";
			mes "女武神头盔……我们复原了女武神头盔，";
			mes "这件荣耀的神圣铠甲！";
			mes "啊……这意味着……？";
			next;
			mes "[Ghenirhemin]";
			mes "我们正在书写新的历史！";
			mes "没错，我们刚刚开始书写新的历史。";
			next;
			mes "[Ghenirhemin]";
			mes "非常感谢你给我参与此事的机会。";
			mes "我相信天上的祖先看到女武神头盔成功复原一定会很高兴。";
			mes "哈哈哈哈哈！";
			next;
			mes "[Ghenirhemin]";
			mes "请收下这顶头盔。";
			mes "正如我承诺的，它属于你。";
			mes "请为自己感到骄傲，";
			mes "不要用邪恶行为玷污这顶头盔。";
			next;
			set moza_valkylie,0;
			getitem 5171,1; //Valkyrie_Helm
			mes "[Ghenirhemin]";
			mes "愿上帝保佑这位书写新历史的冒险者。";
			mes "我，盖尔赫明，祈祷他安全踏上新的历史旅程。";
			close;
		}
		specialeffect EF_LIGHTSPHERE;
		mes "[Ghenirhemin]";
		mes "材料仍在融合。";
		close;
	}
	else if (moza_valkylie == 4) {
		set .@val,rand(1,10);
		if (.@val == 7) {
			mes "[Ghenirhemin]";
			mes "............";
			next;
			specialeffect EF_LIGHTSPHERE;
			mes "[Ghenirhemin]";
			mes "哦……哦？它们……刚刚开始融合了！";
			mes "看这耀眼的光！";
			mes "我……我不敢相信";
			mes "瓦尔哈拉竟然会发生这种事！";
			next;
			set moza_valkylie,5;
			mes "[Ghenirhemin]";
			mes "我们现在见证了神的恩典……啊……";
			close;
		}
		mes "[Ghenirhemin]";
		mes "……再等一会儿吧。";
		close;
	}
	else if (moza_valkylie == 3) {
		set moza_valkylie,4;
		mes "[Ghenirhemin]";
		mes "别焦虑了，好吗？";
		mes "放松等待吧。";
		mes "从某种意义上说，我们正在举行神圣仪式，";
		mes "不会因为你这个人类想快一点就加速。";
		close;
	}
	else if (moza_valkylie == 2 && Zeny > 9999999 && countitem(4219) > 0 && countitem(4114) > 0 && countitem(4177) > 0 && countitem(4259) > 0 && countitem(4212) > 0 && countitem(4073) > 0 && countitem(4112) > 0 && countitem(4081) > 0 && countitem(4251) > 0 && countitem(4166) > 0 && countitem(7511) > 999 && countitem(7563) > 999) {
		mes "[Ghenirhemin]";
		mes "嗯……材料很难收集，你却全部带来了，真让我佩服。很辛苦吧？";
		mes "哈哈，看你的脸就知道了。干得好，我的朋友，做得好。";
		next;
		mes "[Ghenirhemin]";
		mes "现在请把它们交给我。";
		mes "如果把它们放在一起，";
		mes "它们一定会凭借神秘力量融合成头盔。";
		next;
		if (select("把物品交给他。:不交给他物品。") == 1) {
			mes "[Ghenirhemin]";
			mes "太好了。现在只要等待它们融合成一体。";
			next;
			delitem 4219,1; //Sageworm_Card
			delitem 4114,1; //Argiope_Card
			delitem 4177,1; //Dryad_Card
			delitem 4259,1; //Wooden_Golem_Card
			delitem 4212,1; //Bon_Gun_Card
			delitem 4073,1; //Pirate_Skel_Card
			delitem 4112,1; //Marduk_Card
			delitem 4081,1; //Hode_Card
			delitem 4251,1; //Elder_Card
			delitem 4166,1; //Nightmare_Terror_Card
			delitem 7511,1000; //Rune_Of_Darkness
			delitem 7563,1000; //Bloody_Rune
			set Zeny,Zeny-10000000;
			set moza_valkylie,3;
			mes "[Ghenirhemin]";
			mes "想到好结果，我现在紧张得不得了。哈哈哈哈。";
			close;
		}
		mes "[Ghenirhemin]";
		mes "?";
		close;
	}
	else if (moza_valkylie == 2) {
		mes "[Ghenirhemin]";
		mes "请带给我";
		mes "^FF00001 Sage Worm Card, 1Argiope Card,";
		mes "^FF00001 Dryad Card, 1 Wooden Golem Card,";
		mes "^FF00001 Bongun Card, 1 Pirate Skeleton Card,";
		mes "^FF00001 Marduk Card, 1 Hode Card,";
		mes "^FF00001 Elder Card, 1 Nightmare Terror Card,^000000";
		next;
		mes "[Ghenirhemin]";
		mes "^FF00001,000 Rune of the Darkness,";
		mes "^FF00001,000 Bloody Rune,";
		mes "^FF0000and the helm price, 10,000,000 zeny^000000.";
		next;
		mes "[Ghenirhemin]";
		mes "考虑到你即将获得神圣力量，";
		mes "这个价格很合理，对吧？";
		next;
		set moza_valkylie,2;
		mes "[Ghenirhemin]";
		mes "准备好钱和材料后再谈吧。";
		mes "我现在累坏了，已经很久没说这么多话了。";
		mes "失陪。";
		close;
	}
	else if (moza_valkylie == 1) {
		mes "[Ghenirhemin]";
		mes "你现在一定很惊讶。";
		mes "这很容易理解。";
		mes "如果你去过许多地方、听过许多故事，就会知道这是什么。";
		mes "没错，这是 ^FF0000女武神头盔^000000。";
		next;
		mes "[Ghenirhemin]";
		mes "只允许超越极限的男人佩戴的传奇头盔。";
		mes "被不可思议力量祝福的神圣铠甲。";
		mes "现在相信我的故事是真的了吧？";
		next;
		mes "[Ghenirhemin]";
		mes "经过这么多年，它的力量已经减弱，";
		mes "但你仍能感受到头盔的神圣。";
		mes "你不觉得吗？";
		next;
		mes "[Ghenirhemin]";
		mes "嗯……我没有资格佩戴这顶头盔。";
		mes "所以如果找到适合它的人，";
		mes "我会毫不犹豫地交给他。";
		next;
		mes "[Ghenirhemin]";
		mes "当然，我不能无偿送出这么贵重的东西。";
		mes "你懂的。也许我会考虑给你，";
		mes "因为你似乎比别人富有，而且我能感受到你身上的特殊气场。";
		next;
		mes "[Ghenirhemin]";
		mes "那么，你觉得呢？";
		mes "我看人的眼光很准。";
		mes "我觉得你能完全复原女武神头盔，";
		mes "并发挥它的全部潜力。";
		next;
		if (select("Sure.:No, thanks.") == 1) {
			mes "[Ghenirhemin]";
			mes "你果然是个有野心的年轻人。";
			mes "这确实是很大的优势。";
			mes "好吧，从现在起我会告诉你我知道的。";
			mes "仔细听。";
			next;
			mes "[Ghenirhemin]";
			mes "首先，我们必须完全恢复头盔的力量。";
			mes "为此要寻找拥有神秘力量的怪物卡片。";
			next;
			mes "[Ghenirhemin]";
			mes "还不止这些。我们不能把怪物卡片直接粘在头盔上。";
			mes "因此需要一种力量，把卡片与头盔融合为一体。";
			next;
			mes "[Ghenirhemin]";
			mes "古代符文最适合提供这种力量，尤其需要黑暗符文和血腥符文。";
			mes "也许是因为它们封印的黑暗力量和血腥黏着力？只是我的猜测，哈哈哈！";
			next;
			mes "[Ghenirhemin]";
			mes "成功恢复头盔力量后，你需要从我这里购买头盔。";
			mes "正如我之前说的，我不会无偿送出如此贵重的东西。";
			mes "这也能证明你有资格成为头盔的主人。";
			next;
			mes "[Ghenirhemin]";
			mes "基本上，你需要带给我……";
			mes "啊，需要带来的东西很多。";
			mes "建议你写下来并记住。";
			next;
			mes "请带给我";
			mes "^FF00001 张贤者蠕虫卡、1 张艾吉欧蜈蚣卡、";
			mes "1 张树精卡、1 张木乃伊犬卡、";
			mes "1 张邦古卡、1 张海盗骷髅卡、";
			mes "1 张玛杜克卡、1 张泥人卡、";
			mes "1 张长老卡、1 张梦魇恐惧卡。^000000";
			next;
			mes "[Ghenirhemin]";
			mes "^FF00001,000 个黑暗符文、";
			mes "1,000 个血腥符文，";
			mes "以及头盔价格 10,000,000 Zeny^000000。";
			next;
			mes "[Ghenirhemin]";
			mes "考虑到你即将获得神圣力量，这个价格很合理，对吧？";
			next;
			set moza_valkylie,2;
			mes "[Ghenirhemin]";
			mes "准备好钱和材料后再谈吧。";
			mes "我现在累坏了，已经很久没说这么多话了。失陪。";
			close;
		}
		mes "[Ghenirhemin]";
		mes "哈哈，我明白这不是容易的选择。";
		mes "慢慢考虑，我的朋友。";
		mes "如果你仍不想要头盔，我尊重你的决定。";
		close;
	}
	else if (Zeny > 9999999) {
		mes "[Ghenirhemin]";
		mes "嗯……你看起来像个贫穷的流浪者，";
		mes "但身上似乎带着巨额财富。";
		mes "看来老话说得对：";
		mes "‘不要以貌取人。’";
		next;
		mes "[Ghenirhemin]";
		mes "你也许能理解我的故事。";
		mes "想听听我的长篇故事吗？";
		mes "也许你会觉得有趣，";
		mes "但我保证绝不会让你感到无聊。";
		next;
		if (select("听。:不听。") == 1) {
			mes "[Ghenirhemin]";
			mes "好，让我介绍一下自己。";
			mes "我叫盖尔赫明。";
			mes "我和其他人没什么不同，";
			mes "如果说唯一的优势，";
			mes "就是比他们稍微有钱一点。哈哈哈。";
			next;
			mes "[Ghenirhemin]";
			mes "不过这些钱不是我赚来的，";
			mes "而是继承了祖先的财富，";
			mes "他们都是天赋异禀的商人。";
			mes "我感谢他们留下这笔巨额财富。";
			next;
			mes "[Ghenirhemin]";
			mes "事实上，我很惭愧地告诉你，";
			mes "我不知道祖先究竟做了什么才积累这么多财富。";
			mes "也许有人经商，有人是伟大的艺术家……";

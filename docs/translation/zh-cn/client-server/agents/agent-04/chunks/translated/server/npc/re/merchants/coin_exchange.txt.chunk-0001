//= [Official Conversion]
//= Renewal coin redemption NPCs.
//===== Additional Comments: =================================
//= 1.0 First version. [Euphy/Lemongrass]
//= 1.1 Added remaining Malangdo traders. [Euphy/Lemongrass]
//= 1.2 Added Eclage traders (not fully complete). [Euphy]
//= 1.3 Completed Eclage Traders. [Dastgir]
//============================================================

// Malangdo
//============================================================
malangdo,220,167,5	script	Coin Exchanger CX-1	564,{
	if (checkweight(1201,1) == 0) {
		mes "您携带的物品种类太多。减少物品后再继续吧。";
		close;
	}
	if (MaxWeight - Weight < 10000) {
		mes "您携带的物品太重，无法继续。减轻负重后再试吧。";
		close;
	}
	mes "[Coin Exchanger CX-1]";
	mes "欢迎来到 CX-1。您可以将硬币兑换为高级或低级硬币。";
	next;
	setarray .@coins[1],
		6417, //Silvervine
		6418, //Agrade_Coin
		6419, //Bgrade_Coin
		6420, //Cgrade_Coin
		6421, //Dgrade_Coin
		6422; //Egrade_Coin
	.@menu$ = "Stop:";
	for(.@i = 1; .@i<=6; .@i++) {
		if (countitem(.@coins[.@i]))
			.@menu$ = .@menu$ + getitemname(.@coins[.@i]) + ":";
		else
			.@menu$ = .@menu$ + "^aaaaaa"+getitemname(.@coins[.@i])+" (None)^000000:";
	}
	.@i = select(.@menu$);
	switch(.@i) {
	case 1:
		mes "[Coin Exchanger CX-1]";
		mes "感谢您的光临。";
		close;
	default:
		.@coin = .@coins[.@i-1];
		.@coin_select = .@i-1;
		break;
	}
	if (countitem(.@coin) == 0) {
		mes "[Coin Exchanger CX-1]";
		mes "您选择了没有持有的硬币。";
		mes "感谢您的光临。";
		close;
	}
	mes "[Coin Exchanger CX-1]";
	mes "----兑换比率----";
	mes "高级兑换 - 30 换 10";
	mes "低级兑换 - 10 换 30";
	mes "------------------------";
	mes "^ff3333兑换时会根据当前市场价格收取手续费。^000000";
	next;
	setarray .@exchange_name$[0],"higher","lower";
	setarray .@exchange_rate[0],30,10;
	setarray .@exchange_loss[0],rand(1,4),rand(1,2); // Amount deducted per exchange.
	setarray .@exchange_id[0],.@coins[.@coin_select-1],.@coins[.@coin_select+1];
	if (.@exchange_id[0] == .@coins[1]) .@exchange_id[0] = 0; // Cannot exchange for Silvervine.
	.@menu$ = "Stop:";
	for(.@i = 0; .@i<2; .@i++) {
		if (.@exchange_id[.@i] == 0)
			.@menu$ = .@menu$ + "^ff3333Unavailable exchange to "+.@exchange_name$[.@i]+" coin^000000:";
		else if (countitem(.@coin) < .@exchange_rate[.@i])
			.@menu$ = .@menu$ + "^aaaaaaExchange to "+.@exchange_name$[.@i]+" coin (null)^000000:";
		else
			.@menu$ = .@menu$ + "Exchange to "+.@exchange_name$[.@i]+" coin - "+getitemname(.@coin)+" ("+.@exchange_rate[.@i]+" needed):";
	}
	.@i = select(.@menu$)-2;
	if (.@i == -1) {
		mes "[Coin Exchanger CX-1]";
		mes "感谢您的光临。";
		close;
	}
	if (.@exchange_id[.@i] == 0) {
		mes "[Coin Exchanger CX-1]";
		mes "这种硬币无法兑换为"+.@exchange_name$[.@i]+"硬币。";
		mes "感谢您的光临。";
		close;
	}
	if (countitem(.@coin) < .@exchange_rate[.@i]) {
		mes "[Coin Exchanger CX-1]";
		mes "您的硬币不足，无法兑换为"+.@exchange_name$[.@i]+"硬币。";
		mes "感谢您的光临。";
		close;
	}
	.@exchange_total = .@exchange_rate[(!.@i)] - .@exchange_loss[(!.@i)];
	delitem .@coin, .@exchange_rate[.@i];
	getitem .@exchange_id[.@i], .@exchange_total;
	mes "[Coin Exchanger CX-1]";
	mes "已收取 ^003399"+.@exchange_rate[.@i]+"^000000 个 ^003399"+getitemname(.@coin)+"^000000。";
	mes "兑换为 ^003399"+.@exchange_name$[.@i]+"硬币^000000，扣除 ^003399"+.@exchange_loss[(!.@i)]+"^000000 个后，剩余 ^003399"+.@exchange_total+"^000000 个。";
	close;
}

malangdo,218,165,5	script	Special Vending Machine	562,{
	if (checkweight(1201,1) == 0) {
		mes "您携带的物品种类太多。减少物品后再继续吧。";
		close;
	}
	if (MaxWeight - Weight < 10000) {
		mes "您携带的物品太重，无法继续。减轻负重后再试吧。";
		close;
	}
	mes "[Special Vending Machine]";
	mes "欢迎来到 CX-82。您有银藤果，可以购买拥有特殊能力的马郎多特产。";
	next;
	callsub L_AddItem, //DisplayName,ItemID,Cost
		"Seagod's Protection [23 hours]",16740,4,
		"Seagod's Protection [7 days]",16763,12,
		"Seagod's Protection [15 days]",16764,24,
		"Octopus Hunting Stick [23 hours]",16765,2,
		"Octopus Hunting Stick [3 days]",16766,5,
		"Octopus Hunting Stick [7 days]",16767,10,
		"Premium Lubricant",6441,56,
		"Ordinary Lubricant",6440,36,
		"Sillit Pong",6443,192;
L_AddItem:
	.@menu$ = "Explanation:";
	for(.@i = 0; .@i<getargcount(); .@i += 3)
		.@menu$ = .@menu$ + getarg(.@i)+":";
	.@i = select(.@menu$)-2;
	if (.@i == -1) {
		mes "[Special Vending Machine]";
		mes "海神的保护是在特定期间进入下水道纪念副本所需的物品。";
		next;
		mes "[Special Vending Machine]";
		mes "章鱼狩猎棒是在特定期间进入下水道纪念副本所需的物品。";
		next;
		mes "[Special Vending Machine]";
		mes "高级和普通润滑剂用于分离装备与卡片。带着任一物品去找专家 Jeremy，他会说明效果详情。";
		next;
		mes "[Special Vending Machine]";
		mes "Sillit Pong 是用于分离带 MVP 卡片插槽的特殊物品。高级和普通润滑剂无法分离 MVP 卡片。";
		close;
	}
	.@cost = getarg(.@i*3+2);
	mes "[Special Vending Machine]";
	mes "您选择了 ^005500"+getarg(.@i*3)+"^000000。购买需要 ^005500"+.@cost+"^000000 个银藤果。";
	next;
	if (countitem(6417) < .@cost)
		.@ven_menu$ = "^999999Silvervine Fruit (missing "+(.@cost - countitem(6417))+")^000000";
	else
		.@ven_menu$ = "Purchase - Silvervine Fruit (have "+countitem(6417)+")";
	switch(select("停止:"+.@ven_menu$)) {
	case 1:
		mes "[Special Vending Machine]";
		mes "感谢您的光临。";
		close;
	case 2:
		if (countitem(6417) < .@cost) {
			mes "[Special Vending Machine]";
			mes "银藤果不足。";
			mes "交易结束。";
			mes "感谢您的光临。";
			close;
		}
		mes "[Special Vending Machine]";
		mes "交易完成。感谢您的光临。";
		delitem 6417,.@cost; //Silvervine
		getitem getarg(.@i*3+1),1;
		close;
	}
}

malangdo,236,179,5	script	Dark Merchant K	554,{
	if (checkweight(1201,1) == 0) {
		mes "您的背包似乎太满了。清理一些物品后再试吧。";
		close;
	}
	if (MaxWeight - Weight < 1000) {
		mes "您的背包现在太重了。清理一些物品后再回来。";
		close;
	}
	mes "[Merchant K]";
	mes "感谢您的交易。";
	mes "我们将 ^ff000010 枚 C 级硬币^000000兑换为 ^3333ff1 枚莫拉硬币^000000。现在开始吗？";
	next;
	setarray .@coin_amount[0],10,100,500,1000;
	while(1) {
		.@menu$ = "";
		for(.@i = 0; .@i<getarraysize(.@coin_amount); .@i++) {
			if (countitem(6420) >= .@coin_amount[.@i])
				.@menu$ = .@menu$ + "兑换 "+(.@coin_amount[.@i]/10)+" 枚莫拉硬币:";
			else
				.@menu$ = .@menu$ + "^aaaaaa兑换 "+(.@coin_amount[.@i]/10)+" 枚莫拉硬币（不足）^000000:";
		}
		.@i = select(.@menu$+"Quit")-1;
		if (.@i == getarraysize(.@coin_amount)) {
			mes "[Merchant K]";
			mes "下次再兑换吧。";
			close;
		}
		if (countitem(6420) < .@coin_amount[.@i]) {
			mes "[Merchant K]";
			mes "兑换需要 ^ff0000"+.@coin_amount[.@i]+"^000000 枚 C 级硬币，但您现在似乎不够。";
			close;
		}
		delitem 6420,.@coin_amount[.@i]; //Cgrade_Coin
		getitem 6380,.@coin_amount[.@i]/10; //Mora_Coin
		mes "[Merchant K]";
		mes "已收到 ^003399"+.@coin_amount[.@i]+"^000000 枚 C 级硬币。"; //FIXME: Dialogue.
		mes "已兑换为 ^003399"+(.@coin_amount[.@i]/10)+"^000000 枚莫拉硬币。";
		next;
		mes "[Merchant K]";
		mes "要继续吗？";
		next;
	}
}

malangdo,233,180,3	script	Dark MachineTX100	564,{
	if (checkweight(1201,1) == 0) {
		mes "您的背包似乎太满了。清理一些物品后再试吧。";
		close;
	}
	if (MaxWeight - Weight < 1000) {
		mes "您的背包现在太重了。清理一些物品后再回来。";
		close;
	}
	mes "[Dark Machine TX100]";
	mes "感谢您访问 TX100。您可以将硬币兑换为更高或更低等级的硬币。";
	next;
	mes "[Dark Machine TX100]";
	mes "低等级硬币每次最多可兑换 500 枚，高等级硬币每次最多可兑换 99 枚。";
	next;
	setarray .@coins[1],
		6417, //Silvervine
		6418, //Agrade_Coin
		6419, //Bgrade_Coin
		6420, //Cgrade_Coin
		6421, //Dgrade_Coin
		6422; //Egrade_Coin
	.@menu$ = "Quit:";
	for(.@i = 1; .@i<=6; .@i++) {
		if (countitem(.@coins[.@i]))
			.@menu$ = .@menu$ + getitemname(.@coins[.@i])+" (have "+countitem(.@coins[.@i])+"):";
		else
			.@menu$ = .@menu$ + "^aaaaaa"+getitemname(.@coins[.@i])+" (None)^000000:";
	}
	.@i = select(.@menu$)-1;
	if (.@i == 0) {
		mes "[Dark Machine TX100]";
		mes "感谢您的光临。";
		close;
	}
	.@coin = .@coins[.@i];
	setarray .@exchange_name$[0],"higher","lower";
	setarray .@exchange_id[0],.@coins[.@i-1],.@coins[.@i+1];
	if (.@exchange_id[0] == .@coins[1]) .@exchange_id[0] = 0; // Cannot exchange for Silvervine.
	if (.@i > getarraysize(.@coins)) {
		mes "[Dark Machine TX100]";
		mes "您选择了无效菜单。";
		mes "操作中止。感谢您的光临。";
		close;
	}
	if (countitem(.@coin) == 0) {
		mes "[Dark Machine TX100]";
		mes "您选择了没有持有的硬币。";
		mes "操作中止。感谢您的光临。";
		close;
	}
	mes "[Dark Machine TX100]";
	mes "----兑换比率----";
	mes "高级硬币 - 3 换 1";
	mes "低级硬币 - 1 换 3";
	mes "---------------------";
	mes "^ff3333兑换硬币时会收取少量商店手续费。^000000";
	next;
	.@menu$ = "Quit:";
	if (.@exchange_id[0] == 0)
		.@menu$ = .@menu$ + "^ff3333Cannot exchange to higher level coin^000000:";
	else {
		if (countitem(.@coin) >= 99)
			.@menu$ = .@menu$ + "Exchange 99 "+getitemname(.@coin)+" into higher level coin:";
		else
			.@menu$ = .@menu$ + "^aaaaaaExchange to higher level coin (Not enough)^000000:";
	}
	if (.@exchange_id[1] == 0)
		.@menu$ = .@menu$ + "^ff3333Cannot exchange to lower level coin^000000:";
	else {
		if (countitem(.@coin) > 500)
			.@menu$ = .@menu$ + "Exchange 500 "+getitemname(.@coin)+" into lower level coin:";
		else if (countitem(.@coin))
			.@menu$ = .@menu$ + "Exchange "+countitem(.@coin)+" "+getitemname(.@coin)+" into lower level coin:";
		else
			.@menu$ = .@menu$ + "^aaaaaaExchange to lower level coin (Not enough)^000000:";
	}
	.@i = select(.@menu$)-2;
	if (.@i == -1) {
		mes "[Dark Machine TX100]";
		mes "感谢您的光临。";
		close;
	}
	if (.@exchange_id[.@i] == 0) {
		mes "[Dark Machine TX100]";
		mes "这种硬币无法兑换为"+.@exchange_name$[.@i]+"等级硬币。";
		mes "操作中止。感谢您的光临。";
		close;
	}
	if ((.@i == 0 && countitem(.@coin) < 100) || (.@i == 1 && countitem(.@coin) == 0)) {
		mes "[Dark Machine TX100]";
		mes "您的硬币不足，无法兑换为"+.@exchange_name$[.@i]+"等级硬币。";
		mes "操作中止。感谢您的光临。";
		close;
	}
	if (countitem(.@exchange_id[.@i]) > 28000) {
		mes "[Dark Machine TX100]";
		mes "您持有的"+.@exchange_name$[.@i]+"等级硬币太多。减少后再回来。";
		close;
	}
	switch(.@i) {
	case 0:
		.@payment_amount = 99;
		.@reward_amount = .@payment_amount/3;
		.@coin_text$ = "High";
		break;
	case 1:
		.@payment_amount = (((countitem(.@coin) > 500))?500:countitem(.@coin));
		.@reward_amount = .@payment_amount*3;
		.@coin_text$ = "Low";
		break;
	}
	.@fee = rand(1,3);
	delitem .@coin, .@payment_amount;
	getitem .@exchange_id[.@i], .@reward_amount - .@fee;
	mes "[Dark Machine TX100]";
	mes "收到 ^003399"+getitemname(.@coin)+"^000000 共 ^003399"+.@payment_amount+"^000000 枚。";
	mes "已兑换为 ^003399"+(.@reward_amount-.@fee)+"^000000 枚 ^003399"+.@coin_text$+"等级硬币^000000，并扣除 ^003399"+.@fee+"^000000 枚手续费。";
	close;
}

malangdo,175,145,4	script	Can Agency Guard	549,{
	if (checkweight(1201,1) == 0) {
		mes "您携带的物品太多。整理物品种类后再试吧。";
		close;
	}
	if (MaxWeight - Weight < 1000) {
		mes "您携带的物品太重，无法继续。减轻负重后再试吧。";
		close;
	}
	mes "[Can Agency Guard]";
	mes "嘿，您……见过附近的^0000ff马郎多猫罐头^000000吗？";
	next;
	switch(select("您为什么问？:哦，您是指这些吗？")) {
	case 1:
		mes "[Can Agency Guard]";
		mes "嗯。";
		mes "罐头机构最近收到了一些关于它们的可疑情报……";
		next;
		mes "[Can Agency Guard]";
		mes "马郎多特产罐头生产线上出现了大量次品。这些本应丢弃的产品似乎流入了零售商手中。";
		next;
		mes "[Can Agency Guard]";
		mes "它们其实很难与普通产品区分，但外包装上明显写着^0000ff马郎多猫罐头^000000。";
		next;
		mes "[Can Agency Guard]";
		mes "次品正在市场上流通，我们的职责是回收它们。您见过有人持有我描述的东西吗？";
		next;
		mes "[Can Agency Guard]";
		mes "如果发现有人出售这些产品，请来告诉我。";
		close;
	case 2:
		if (countitem(12633) == 0) {
			mes "[Can Agency Guard]";
			mes "嗯？我没看到您有^0000ff马郎多猫罐头^000000。找到后别忘了带给我……";
			close;
		}
		break;
	}
	mes "[Can Agency Guard]";
	mes "马郎多猫罐头是次品。让我把它兑换成 3 枚 E 级硬币，怎么样？";
	next;
	switch(select("我不兑换:^0000ff1^000000 罐头 -> ^0000ff3^000000 枚 E 级硬币:^0000ff10^000000 罐头 -> ^0000ff30^000000 枚 E 级硬币:^0000ff100^000000 罐头 -> ^0000ff300^000000 枚 E 级硬币:兑换我拥有的全部")) {
	case 1:
		mes "[Can Agency Guard]";
		mes "嗯，我不会永远待在这里。想兑换的话趁我还在时来找我。";
		close;
	case 2:
		.@check = 1;
		.@count = 1;
		break;
	case 3:
		.@check = 10;
		.@count = 10;
		break;
	case 4:
		.@check = 100;
		.@count = 100;
		break;
	case 5:
		.@check = 1;
		.@count = countitem(12633);
		break;
	}
	if (countitem(12633) < .@check) {
		if (.@check == 1) {
			mes "[Can Agency Guard]";
			mes "嗯？我没看到您有^0000ff马郎多猫罐头^000000。找到后别忘了带给我……";
			close;
		} else {
			mes "[Can Agency Guard]";
			mes "嗯？您的数量似乎不足，无法兑换……确定数量后再来找我。";
			close;
		}
	}
	//
	delitem 12633,.@count; //Malang_Cat_Can
	getitem 6422,.@count*3; //Egrade_Coin
	mes "[Can Agency Guard]";
	mes "已将 "+.@count+" 个马郎多猫罐头兑换为 "+(.@count*3)+" 枚 E 级硬币。请查收。";
close;
}

function	script	F_mal_coin	{

// Initial dialogue and checks:
	// -- callfunc "F_mal_coin",0,"[<NPC Name>]",<NPC ID>;
	.@npc_name$ = getarg(1);
		if (getarg(0) == 0) {
			if (getarg(2) != 2 && BaseLevel < 50) {
			mes .@npc_name$;
			mes "啊哈～";
			mes "想买这些东西的话，";
			mes "等您长大一些后";
			mes "再来找我吧。";
			mes "这些东西对孩子来说";
			mes "太贵了～";
		close;
		}
		mes .@npc_name$;
		mes "很高兴见到您～～";
		mes "没错，就是我！";
		mes "我出售特殊物品，";
		mes "只有在喵喵岛才能见到！";
		next;
		mes .@npc_name$;
		mes "怎么样？还在等什么？";
		mes "不来看看";
		mes "我这里有哪些东西吗？";
		next;
		switch(getarg(2)) {
			case 1:
			mes "[Wandering Merchant]";
			mes "哦～";
			mes "这些是租赁物品，请确认您要的是 ^0000FF1 小时^000000 还是 ^0000FF7 天^000000 版本。";
			next;
		break;
			case 2:
		break;
			case 3:
			mes "[Roving Merchant]";
			mes "顺便告诉您，";
			mes "母猪虫、海星、鱿鱼干和飞鱼都是可使用 1 小时的物品。";
			next;
		break;
		}
		mes .@npc_name$;
		mes "那么，现在要看看我这里的东西吗？";
		next;
		switch(select("是:否")) {
			case 1:
				if (checkweight(1201,1) == 0) {
				mes .@npc_name$;
				mes "您的背包里似乎有太多物品。";
				mes "腾出空间后再回来～";
			close;
			}
				if (MaxWeight - Weight < 2500) {
				mes .@npc_name$;
				mes "您似乎超重了。";
				mes "减轻负重后再回来～";
			close;
			}
			mes .@npc_name$;
			mes "好好看看吧～～～";
			next;
		return;
			case 2:
			mes .@npc_name$;
			mes "那么，下次再见。";
			mes "再见。";
		close;
	}
}

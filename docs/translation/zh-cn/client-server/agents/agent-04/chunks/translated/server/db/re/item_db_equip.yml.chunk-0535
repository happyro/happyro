    Locations:
      Both_Hand: true
    WeaponLevel: 5
    EquipLevelMin: 215
    Refineable: true
    Gradable: true
    Script: |
      .@g = getenchantgrade();
      .@r = getrefine();
      bonus bAtkRate,5;
      bonus bCon,2;
      bonus2 bSkillAtk,"NW_ONLY_ONE_BULLET",5;
      if (.@r>=5) {
         bonus2 bSkillAtk,"NW_ONLY_ONE_BULLET",10;
         if (.@r>=7) {
            bonus bLongAtkRate,5;
            if (.@r>=9) {
               bonus2 bSkillAtk,"NW_ONLY_ONE_BULLET",10;
               if (.@r>=10) {
                  bonus bAspdRate,10;
                  if (.@r>=11) {
                     bonus bLongAtkRate,15;
                     bonus2 bSkillAtk,"NW_ONLY_ONE_BULLET",5;
                  }
               }
            }
         }
      }
      if (.@g>=ENCHANTGRADE_D) {
         bonus bLongAtkRate,10;
         if (.@g>=ENCHANTGRADE_C) {
            bonus2 bAddSize,Size_All,10;
            if (.@g>=ENCHANTGRADE_B) {
               bonus2 bAddRace,RC_All,10;
               if (.@g>=ENCHANTGRADE_A) {
                  bonus2 bAddEle,Ele_All,10;
               }
            }
         }
      }

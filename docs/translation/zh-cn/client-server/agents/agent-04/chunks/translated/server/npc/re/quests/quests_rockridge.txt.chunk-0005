		mes "我的意思是，";
		mes "公司想榨干矿井的全部价值，";
		mes "约翰尼也知道这一点。他想用矿石作为免罪筹码。";
		next;
		mes "[" + .@player_name$ + "]";
		mes "但沃普警长不想这样。";
		mes "他想让约翰尼被公开绞死。";
		mes "他不想用一堆矿石换一个罪犯获释。";
		next;
		select("把矿石给他看。");
		mes "[" + .@player_name$ + "]";
		mes "我带来了这个，以防你不相信我。";
		mes "很漂亮，对吧？";
		mes "我们发现了新的矿脉，位置保密。";
		next;
		npctalk "不……这意味着我们一直待在这里都是白费力气。", "", bc_self;
		mes "[" + .@player_name$ + "]";
		mes "这座废矿井你们爱怎么处理都行。";
		next;
		mes "[" + .@player_name$ + "]";
		mes "好吧，我换个说法。";
		mes "你可以放弃约翰尼，自己领导帮派。";
		mes "那个懦夫科斯特洛一回大陆，我就会成为新市长。";
		next;
		mes "[" + .@player_name$ + "]";
		mes "如果你是帮派首领，我愿意和你做生意。";
		mes "想想你的未来。";
		next;
		mes "[" + .@player_name$ + "]";
		mes "你想和我们分享这座矿井的利润。";
		mes "是约翰尼先背叛了你。";
		mes "还有什么好考虑的？";
		npctalk "我需要和其他人谈谈……", "", bc_self;
		next;
		mes "[阿尔伯特·福特]";
		mes "如果他真的背叛了我们，我们要亲自惩罚他。";
		mes "其他人也需要知道真相。";
		next;
		mes "[阿尔伯特·福特]";
		mes "我需要时间。";
		sleep2 2000;
		unittalk .@account_id, "" + .@player_name$ + "：我们没时间了。约翰尼会花钱买通关系逃出监狱。", bc_self;
		mes "……好吧，我们不会再担心那个叛徒了。";
		next;
		mes "[阿尔伯特·福特]";
		mes "但在解决掉他之前，我不会告诉你矿石的位置。";
		mes "那些该死的矿石就是我们陷入这场麻烦的原因。";
		next;
		mes "[阿尔伯特·福特]";
		mes "现在滚吧。";
		next;
		select("抱歉，可以给我一缕你的鬃毛吗？");
		mes "[阿尔伯特·福特]";
		mes "为什么？你在打什么鬼主意？";
		unittalk .@account_id, "" + .@player_name$ + "：沃普警长想要它作为我们谈判的证据。", bc_self;
		next;
		mes "[阿尔伯特·福特]";
		mes "那个混账警长，";
		mes "连自己人都信不过，是吧？";
		mes "哼。";
		mes "给你。";
		mes "现在，滚！";
		next;
		mes "[阿尔伯特·福特]";
		mes "下次见面时，我们就在约翰尼的葬礼上见，明白了吗？";
		getitem 25249,1;// Mane_Of_Cow
		erasequest 7802;// Hear Me Out 2
		setquest 7803;// Happy for Broken Trust
		rock_main_quest = 14;
		close2;
		cloakonnpcself();
		end;
	}
	if (rock_main_quest == 14 && countitem(25249) < 1) {
		mes "[阿尔伯特·福特]";
		mes "这次又有什么事？";
		mes "那个叛徒出什么事了吗？";
		next;
		select("可以再给我一缕你的鬃毛吗？");
		mes "[阿尔伯特·福特]";
		mes "你把我给你的那根弄丢了吗？";
		mes "这让我更怀疑信任你的决定是否正确。";
		mes "我们没时间争论。";
		next;
		mes "[阿尔伯特·福特]";
		mes "给，拿去吧。";
		getitem 25249,1;// Mane_Of_Cow
		close2;
		cloakonnpcself();
		end;
	}
	if (rock_main_quest == 20 && checkquest(7807,HUNTING) == 2) {
		if (countitem(25278) < 5 || countitem(25283) < 5) {
			mes "（我没有足够的棕色围巾和强盗围巾来威胁阿尔伯特·福特。）";
			unittalk .@account_id, "" + .@player_name$ + "：我只是路过，之后再来。", bc_self;
			next;
			mes "[Albert Ford]";
			mes "什么？什么事？";
			mes "没事就别来找我！";
			close2;
			cloakonnpcself();
			end;
		}
		mes "[Albert Ford]";
		mes "这次又有什么事？";
		mes "我很忙。";
		next;
		select("Did something happen inside the mine?");
		mes "[Albert Ford]";
		mes "是的。我派去巡逻的几个人没有回来，还有我们的一些矿石……";
		npctalk "……等等。", "", bc_self;
		next;
		mes "[Albert Ford]";
		mes "那个箱子！";
		mes "你就是小偷！";
		mes "我们的谈判怎么了？";
		mes "约翰尼自由了吗？";
		next;
		select("Huh? No.");
		mes "[" + .@player_name$ + "]";
		mes "你为什么会这么想？";
		mes "他确实告诉了我们矿石的位置，但我们还没有履行约定。";
		next;
		mes "[" + .@player_name$ + "]";
		mes "他以为你死了，所以才说出了位置。";
		mes "如果他出来后发现你还活着，你就有麻烦了，对吧？";
		next;
		mes "[" + .@player_name$ + "]";
		mes "别担心。约翰尼逃不过法律制裁。";
		mes "沃普警长决心把他绞死。";
		next;
		mes "[" + .@player_name$ + "]";
		mes "对了，我想我不会成为下一任市长。";
		mes "我来就是为了告诉你这件事。";
		next;
		mes "[" + .@player_name$ + "]";
		mes "至于我说过要和你分享矿井利润的事，我不记得了。";
		mes "我大概只是顺着谈话随口说的。";
		next;
		npctalk "原来你一直在耍我们！", "", bc_self;
		mes "[Albert Ford]";
		mes "你到底对我们做了什么？";
		mes "听完这些，你觉得我们会原谅你吗？";
		next;
		mes "[Albert Ford]";
		mes "什么？要绞死老大？";
		mes "我们要绞死你们？你们所有人！";
		mes "你们这些狡猾的混蛋！";
		next;
		mes "[Albert Ford]";
		mes "我们会袭击你们的村子，把它夷为平地！";
		next;
		unittalk .@account_id, "" + .@player_name$ + "：你确定要这么做？", bc_self;
		mes "[Albert Ford]";
		mes "你这次又想做什么？";
		next;
		specialeffect EF_HIT2;
		sleep2 2000;

		if (countitem(25278) >= 5 && countitem(25283) >= 5) {
			delitem 25283,5;// BrownMuffler
			delitem 25278,5;// BanditsScarf
			for ( .@i = 0; .@i < 5; ++.@i ) {
				getfreecell("rockrdg2",.@x,.@y,295,309,4,4);
				makeitem 25283,1, "rockrdg2", .@x,.@y;// BrownMuffler
				getfreecell("rockrdg2",.@x,.@y,296,309,4,4);
				makeitem 25278,1, "rockrdg2", .@x,.@y;// BanditsScarf
			}
			npctalk "你在做什么？这到底是什么？！", "", bc_self;
			mes "[Albert Ford]";
			mes "等等！……你！";
			mes "你对我的人做了什么？";
			next;
			select("Your threat is not going to work.");
			unittalk .@account_id, "" + .@player_name$ + "：你们在冒险者中已经相当出名了。", bc_self;
			mes "[" + .@player_name$ + "]";
			mes "想来的话就来村子吧。";
			mes "你还没踏进洛克里奇就会死。";
			next;
			mes "[" + .@player_name$ + "]";
			mes "阿尔伯特，你对我们已经没用了，但我暂时不会杀你。";
			mes "祝你长命百岁。";
			next;
			specialeffect EF_SCREEN_QUAKE;
			npctalk "你们这些卑鄙的混蛋！我不会原谅你们！", "", bc_self;
			mes "[Albert Ford]";
			mes "哼，我们也许输掉了这场战斗，";
			mes "但就算矿井对我们没用，我们也不会还给你们！";
			mes "最后笑到的还是我们！";
			erasequest 7807;// Ace up Our Sleeve
			setquest 7808;// Case Solved
			rock_main_quest = 21;
			close2;
			cloakonnpcself();
		}
		end;
	}
    npctalk "我要杀了你们！把你们全都杀掉！", "", bc_self;
	end;
OnInit:
	cloakonnpc();
	end;
}


// Cacturon quest
rockrdg1,341,133,3	script	Mrs. Cacturon#rrrem01	4_M_CACTUSLADY,{
	if (rock_main_quest < 22) {
		mes "[Mrs. Cacturon]";
		mes "我很确定以前没见过你。是什么风把你吹到这个村子来的？";
		close;
	}
	if (checkweight(1301,3) == 0) {
		mes "[Mrs. Cacturon]";
		mes "我很确定以前没见过你。你背着一个很重的袋子。怎么，风这么大，需要带点东西防止自己被吹走吗？";
		next;
		mes "[Mrs. Cacturon]";
		mes "……我开玩笑的。不过你最好把袋子减减重。除非你要养活一家人，否则带这么多东西只会碍事。";
		close;
	}
	if (isbegin_quest(16078) != 2) {// first time
		.@player_name$ = strcharinfo(0);
		switch( checkquest(16078,HUNTING) ) {
		case -1:
			mes "[Little Lecter]";
			mes "耶，妈妈回来了！妈妈，你买果汁了吗？我的龙舌兰口味果汁！";
			emotion ET_DELIGHT, getnpcid(0, "Little Lecter#rrrem02");
			next;
			mes "[Little Lecter]";
			mes "咦？妈妈，你摔倒受伤了吗？衣服为什么这么脏？";
			emotion ET_QUESTION, getnpcid(0, "Little Lecter#rrrem02");
			next;
			mes "[Mrs. Cacturon]";
			mes "是的，我回来了。嗯，莱克特，我有件事要告诉你。";
			next;
			mes "[Mrs. Cacturon]";
			mes "……对不起，莱克特，但今天没有龙舌兰口味果汁。";
			emotion ET_THINK;
			next;
			mes "[Little Lecter]";
			mes "咦？为什么？我以为你今天去了洛克里奇市场。";
			mes "爷爷说你会带龙舌兰口味果汁回来。我等了一整天。哇！";
			next;
			mes "[" + .@player_name$ + "]";
			mes "（这里真吵。发生什么事了吗？）";
			next;
			mes "[Mrs. Cacturon]";
			mes "因为，莱克特……别哭了。聪明的仙人掌孩子可不会这么轻易哭鼻子！";
			next;
			if (select( "Hello. Is there a problem?", "Ignore it." ) == 2) {
				mes "[" + .@player_name$ + "]";
				mes "（我最好别插手。我已经厌倦替别人收拾烂摊子了。）";
				close;
			}
			mes "[" + .@player_name$ + "]";
			mes "打扰一下，出什么事了吗？";
			next;
			mes "[Mrs. Cacturon]";
			mes "我们只是在处理一点家庭问题。你是谁？我看得出来你不是本地人。";
			next;
			mes "[" + .@player_name$ + "]";
			mes "我是冒险者。我想知道你们是否需要帮助。";
			next;
			mes "[Mrs. Cacturon]";
			mes "冒险者？千里迢迢来到洛克里奇？";
			mes "……那么，你能听我说说吗？我想请你帮个忙。";
			next;
			mes "[Little Lecter]";
			mes "哇！我的龙舌兰口味果汁！哇！";
			emotion ET_CRY, getnpcid(0, "Little Lecter#rrrem02");
			next;
			mes "[Mrs. Cacturon]";
			mes "今天我从洛克里奇市场回来的路上遭到了郊狼袭击。";
			next;
			mes "[Mrs. Cacturon]";
			mes "我拼尽全力保护买来的东西。除了儿子喜欢的龙舌兰饮料粉，大部分东西都保住了。";
			next;
			mes "[" + .@player_name$ + "]";
			mes "龙舌兰饮料粉？";
			emotion ET_QUESTION, playerattached();
			next;
			mes "[Mrs. Cacturon]";
			mes "那是龙舌兰口味的饮料粉。";
			mes "使用方便，味道和真正的龙舌兰汁很相似。年轻的仙人掌都喜欢这种饮料。";
			next;
			mes "[Mrs. Cacturon]";
			mes "不过对我来说太甜了。好了，这不重要。";
			mes "陌生的冒险者，你能帮我找回丢在荒地里的龙舌兰饮料粉吗？";
			next;
			mes "[Mrs. Cacturon]";
			mes "既然如此，也请顺便帮忙减少一下^0000CD郊狼^000000的数量吧。帮我猎杀^0000CD30^000000只。";
			next;
			mes "[Mrs. Cacturon]";
			mes "^0000CD龙舌兰饮料粉^000000一套有7包。我把整套都弄丢了，我想你也很难找到完整的一套。只要能找到^0000CD5包^000000我就很满足了。";
			next;
			if (select( "Sure, I can do that.", "I'd love to help, but..." ) == 2) {
				mes "[" + .@player_name$ + "]";
				mes "抱歉。我很想帮忙，但我自己也有一堆事情要处理。";
				next;
				mes "[Mrs. Cacturon]";
				mes "我明白。最近每个人都有一堆事情要处理。";
				close;
			}
			mes "[" + .@player_name$ + "]";
			mes "好，我可以做到。你希望我^0000CD找到5包龙舌兰果汁粉并猎杀30只郊狼^000000，对吧？";
			next;
			mes "[Mrs. Cacturon]";
			mes "是的。谢谢你。";
			mes "我不认为你能找到全部7包。至少有几包现在肯定已经破损洒掉了。";
			next;
			mes "[Mrs. Cacturon]";
			mes "只要带来^0000CD5包龙舌兰果汁粉^000000就够了。这样就能让我的儿子开心。";
			mes "^FF0000它们可能被埋在地里、被人捡走，或者被郊狼找到。^000000";
			next;
			mes "[Mrs. Cacturon]";
			mes "狩猎时请留意周围，好吗？谢谢。";
			setquest 16078;// Peace of the Family
			close;
		case 0:
		case 1:
			if (countitem(25246) < 5) {
				mes "[Mrs. Cacturon]";
				mes "陌生的冒险者。我请你猎杀^0000CD30只郊狼^000000。进展如何？";
				mes "谢谢你为我做这些事，也谢谢你找到^0000CD5包果汁粉^000000。要不是你，事情会困难得多。谢谢。";
				close;
			}
			mes "[Mrs. Cacturon]";
			mes "你找到的龙舌兰果汁粉比我想象的还多。谢谢你，陌生的冒险者。";
			mes "我不想继续麻烦你，但你能猎杀^0000CD30^000000只^0000CD郊狼^000000吗？";
			close;
		case 2:
			if (countitem(25246) < 5) {
				mes "[Mrs. Cacturon]";
				mes "谢谢你帮我猎杀郊狼。对了，你没在它们附近看到^0000CD果汁粉包装^000000吗？";
				mes "里面应该还剩一些果汁粉。如果你能找到5包，我会很感激。";
				close;
			}
			mes "[Little Lecter]";
			mes "这是龙舌兰口味果汁吗？你是特意帮我找到的吗？太棒了！莱克特现在就想喝！";
			next;
			mes "[Mrs. Cacturon]";
			mes "莱克特，你应该先谢谢冒险者。";
			next;
			mes "[" + .@player_name$ + "]";
			mes "我想他忙着搅拌果汁，没听见你的话。没关系，我帮忙也不是为了得到感谢。他一定很喜欢。";
			next;
			mes "[Little Lecter]";
			mes "是的，我非常喜欢！嘿嘿！谢谢你！";
			emotion ET_SMILE, getnpcid(0, "Little Lecter#rrrem02");
			next;
			mes "[Mrs. Cacturon]";
			mes "唉……";
			emotion ET_SCRATCH;
			next;
			mes "[" + .@player_name$ + "]";
			mes "他很开心。你为什么叹气？";
			next;
			mes "[Mrs. Cacturon]";
			mes "看着他开心地喝那种假果汁，让我想起了小时候喝过的真正的龙舌兰汁。";
			next;
			mes "[Mrs. Cacturon]";
			mes "那不是工厂生产的粉末。制作真正的龙舌兰汁需要很多时间和精力，所以我们只有特殊场合才喝。";
			next;
			mes "[Mrs. Cacturon]";
			mes "那时候，全家人会聚在一起制作龙舌兰汁。我们还会烤用龙舌兰叶包裹的牛排，有时远方的亲戚也会来拜访我们，一起奏乐跳舞直到深夜。";
			next;
			mes "[Mrs. Cacturon]";
			mes "我小时候过得很开心，可我的孩子从未体验过那些。如今大家都太忙了，没时间聚在一起，也没时间整夜唱歌跳舞。";
			next;
			mes "[Mrs. Cacturon]";
			mes "但我们仙人掌一族会尽力保存传统，把它们传授给孩子们。";
			next;
			mes "[Mrs. Cacturon]";
			mes "啊，我说得太多了。抱歉占用了你的时间，冒险者。";
			mes "谢谢你。请收下这个。虽然不是什么贵重东西，但希望你喜欢。";
			emotion ET_PROFUSELY_SWEAT;
			next;
			mes "[Mrs. Cacturon]";
			mes "如果你不忙，能回来再猎杀一些郊狼吗？最近的郊狼比以前更多了。它们和我们一样属于自然的一部分，但已经威胁到了我们的安全。";
			next;
			mes "[Mrs. Cacturon]";
			mes "我也许无法给儿子真正的龙舌兰汁，但至少想有能力买他想要的东西。";
			next;
			mes "[Mrs. Cacturon]";
			mes "从今天开始，如果你每天都能帮忙，我会非常感激。";
			mes "如果你能再帮我一段时间，我真的会很感激。你让我更努力地为儿子创造更好的生活。";
			emotion ET_SMILE;
			delitem 25246,5;// Juice_Package
			completequest 16078;// Peace of the Family
			setquest 16079;// Back for More Coyotes Tomorrow
			getitem 25250,2;// Coin_Of_Rr
			getexp 55560,52710;
			close;
		}
	}
	switch( checkquest(16079,PLAYTIME) ) {
	case -1:
		break;
	case 0:
	case 1:
		mes "[Mrs. Cacturon]";
		mes "你需要偶尔停下手头的事观察周围，否则会错过重要细节。";
		next;
		mes "[Mrs. Cacturon]";
		mes "和往常一样，我很感谢你的帮助，但你需要早上再回来。谢谢。";
		close;
	case 2:
		erasequest 16079;// Back for More Coyotes Tomorrow
		break;
	}
	switch( checkquest(16080,HUNTING) ) {
	case -1:
		mes "陌生的冒险者，谢谢你回来。";
		mes "你是来帮我猎杀郊狼的，对吧？";
		next;
		if (select( "Yes.", "No, I came to talk." ) == 2) {
			mes "[Mrs. Cacturon]";
			mes "你今天没有平时那么忙，对吧？";
			mes "多亏了你，我自己也没那么忙了。";
			next;
			mes "[Mrs. Cacturon]";
			mes "有事情可做是一种福气。";
			mes "我们早上醒来，用劳动回报自然的恩赐，晚上再上床睡觉。";
			emotion ET_DELIGHT;
			next;
			mes "[Mrs. Cacturon]";
			mes "但当然，你也需要休息，就像现在这样。整天工作却不休息，会让生活变得乏味。";
			close;
		}
		mes "[Mrs. Cacturon]";
		mes "和往常一样，请帮我猎杀^0000CD30只郊狼^000000。";
		mes "每天晚上，它们成群出现，不停吠叫，仿佛在说我们永远也无法摆脱它们。";
		next;
		mes "[Mrs. Cacturon]";
		mes "但我相信每天一点小小的改变，最终也能带来巨大的差异。";
		mes "而你让这一切成为可能。谢谢你。";
		setquest 16080;// Hunting Coyotes Again
		close;
	case 0:
	case 1:
		mes "[Mrs. Cacturon]";
		mes "我请你猎杀30只郊狼。你猎杀了多少？";
		mes "如果你累了，就先休息一下。我不想让我的请求成为你的负担。";
		close;
	case 2:
		mes "[Mrs. Cacturon]";
		mes "你狩猎回来了。我没有给你添麻烦吧？";
		mes "请尽可能经常猎杀郊狼。如果你打算常来这里，它们对你来说也会和对我们一样麻烦。";
		next;
		mes "[Mrs. Cacturon]";
		mes "这是我能做到的最好程度。希望你喜欢。请允许我代表家人感谢你的帮助。";
		erasequest 16080;// Hunting Coyotes Again
		setquest 16079;// Back for More Coyotes Tomorrow
		getitem 25250,2;// Coin_Of_Rr
		getexp 55560,52710;
		close;
	}
	end;
OnInit:
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "rock_main_quest == 22 && (!isbegin_quest(16078) || (checkquest(16078,HUNTING) == 2 && countitem(25246) >= 5))" );
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "rock_main_quest == 22 && checkquest(16080,HUNTING) == 2" );
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "rock_main_quest == 22 && checkquest(16079,PLAYTIME) == 2" );
	end;
}

rockrdg1,339,134,3	script	Little Lecter#rrrem02	4_M_CACTUSCHILD,{
	if (isbegin_quest(16078) == 2) {
		mes "[Little Lecter]";
		mes "我喜欢龙舌兰口味果汁。我想每天都喝。";
		next;
		mes "[Little Lecter]";
		mes "龙舌兰汁？你是说我最喜欢的龙舌兰口味果汁吗？";
		close;
	}
	switch( checkquest(16078,HUNTING) ) {
	case -1:
		mes "[Little Lecter]";
		mes "妈妈说她会带龙舌兰口味果汁给我。我的龙舌兰口味果汁……";
		close;
	case 0:
	case 1:
		mes "[Little Lecter]";
		mes "哇！哇！我的龙舌兰口味果汁！";
		mes "*抽泣* 我还要等几天才能喝到龙舌兰口味果汁？莱克特不想等……等……呜呜！";
		emotion 28, getnpcid(0,"Little Lecter#rrrem02");
		close;
	case 2:
		if (countitem(25246) < 5) {
			mes "[Little Lecter]";
			mes "哇！哇！我的龙舌兰口味果汁！";
			mes "*抽泣* 我还要等几天才能喝到龙舌兰口味果汁？莱克特不想等……等……呜呜！";
			emotion 28;
			close;
		}
		mes "[Little Lecter]";
		mes "哇，龙舌兰口味果汁！谢谢你，冒险者！";
		mes "你能和我妈妈说说吗？她同意之前我不能喝。";
		emotion 18;
		close;
	}

		mes "‘Beholder’，你的意见呢？";
		mes "";
		next;
		disablenpc "[Huey]";
		mes "[Beholder]";
		mes "我不喜欢课程分数。但不知为何，测试整体通过了。我接受这个人。";
		next;
		mes "[Guildmaster]";
		mes "嗯……";
		mes "看来大家都同意。很好，我也不反对 "+strcharinfo(0)+"……";
		next;
		switch(ASSIN_Q) {
		case 8:
			mes "[Guildmaster]";
			mes "虽然你被个人复仇驱使，希望训练后能放下它……";
			next;
			break;
		case 9:
			mes "[Guildmaster]";
			mes "虽然你现在最关心的是发财，我相信你会追求更伟大的目标……";
			next;
			break;
		case 10:
			mes "[Guildmaster]";
			mes "你渴望环游世界，希望能在旅途中找到真正的自我……";
			next;
			break;
		case 11:
			mes "[Guildmaster]";
			mes "你似乎很了解刺客。我想孤独带来的挫折不会难倒你……";
			next;
			break;
		case 12:
			mes "[Guildmaster]";
			mes "你对金钱有些执迷，但我相信你能克服。";
			next;
			mes "[Guildmaster]";
			mes "虽然现在我不信任你，但会给你一个机会……";
			next;
			break;
		case 13:
			mes "[Guildmaster]";
			mes "虽然你只是肤浅地迷恋刺客，我相信你迟早会认识到刺客职业的真正价值。";
			next;
			break;
		case 14:
			mes "[Guildmaster]";
			mes "你是少数追求更高技能的人之一，希望你迟早明白精神修炼的重要性。";
			next;
			break;
		case 15:
			mes "[Guildmaster]";
			mes "迟早你会找到可以奉献自己的新目标……";
			next;
			break;
		case 16:
			mes "[Guildmaster]";
			mes "我知道有些人只在意体能训练，";
			mes "但我相信你会在他们中脱颖而出……";
			next;
		}
		switch(ASSIN_Q3) {
		case 1: // player Job Level was above 48
			mes "[Guildmaster]";
			mes "我说得太多了。请选一件武器作为礼物。";
			next;
			mes "[Guildmaster]";
			mes "你可以选择 Jur、Katar、Main Gauche 或 Gladius。作为大师，我都喜欢。";
			next;
			switch(select("Jur:Katar:Main Gauche:Gladius")) {
			case 1:
				mes "[Guildmaster]";
				mes "Jur……";
				mes "不错的选择。给你，希望它能好好服务于你。";
				getitem 1251,1; //Jur_
				break;
			case 2:
				mes "[Guildmaster]";
				mes "Katar……给你。虽然用过，但我知道它会很好用。";
				mes "";
				mes "";
				mes "";
				mes "";
				getitem 1253,1; //Katar_
				break;
			case 3:
				mes "[Guildmaster]";
				mes "我明白了。你想使用双手。拿着你的 Main Gauche。";
				getitem 1208,1; //Main_Gauche_
				break;
			case 4:
				mes "[Guildmaster]";
				mes "Gladius……";
				mes "它曾称霸刺客武器市场。请好好使用我的 Gladius。";
				getitem 1220,1; //Gladius_
			}
			ASSIN_Q3 = 3;
			next;
			break;
		case 2: // player Job Level was below 48
			mes "[Guildmaster]";
			mes "我说得太多了。先收下这个。";
			mes "";
			next;
			switch(rand(1,5)) {
			case 1:
				getitem 1207,1; //Main_Gauche
				break;
			case 2:
				getitem 1250,1; //Jur
				break;
			case 3:
				getitem 1216,1; //Stiletto
				break;
			case 4:
				getitem 1201,1; //Knife
				break;
			case 5:
				getitem 1252,1; //Katar
			}
			ASSIN_Q3 = 3;
		}
		mes "[Guildmaster]";
		mes "我给你一枚信物。请回到入口找凶相的刺客专家 Huey。";
		next;
		mes "[Guildmaster]";
		mes "Huey 收到信物后会将你转职为刺客。";
		next;
		mes "[Guildmaster]";
		mes ""+strcharinfo(0)+"，你选择成为刺客。愿你学会我们的方式，成为他人的高尚榜样。";
		if (checkre(0))
			savepoint "morocc",100,100,1,1;
		else
			savepoint "moc_ruins",79,99,1,1;
		getitem 1008,1; //Frozen_Heart
		ASSIN_Q = 17;
		changequest 8006,8007;
		next;
		mes "[Guildmaster]";
		mes "好了，你们都回到岗位。我也会把你送回入口。走吧……";
		disablenpc "[Huey]";
		disablenpc "[Khai]";
		disablenpc "[The Anonymous One]";
		disablenpc "[Barcardi]";
		disablenpc "[Beholder]";
		disablenpc "[Thomas]";
		disablenpc "[Gayle Maroubitz]";
		close2;
		warp "in_moc_16",17,19;
		end;
	}
	else if (ASSIN_Q == 17) {
		mes "[Guildmaster]";
		mes "嗯……？";
		mes "你怎么进来的……？";
		next;
		mes "[Guildmaster]";
		mes "你已经完成测试。去试着取得^006699遗忘项链^000000，之后就能转职。";
		close2;
		warp "in_moc_16",17,19;
		end;
	}
	else if (ASSIN_Q > 7 && ASSIN_Q < 17) {
		ASSIN_Q = 7;
		mes "[Guildmaster]";
		mes "搞什么？你在流程中按了‘取消’。到底想不想转职？";
		next;
		mes "[Guildmaster]";
		mes "^666666*Sigh...*^000000";
		mes "好，我们重新开始。这次不听话就别想活着离开。明白吗？";
		close;
	}
	else {
		mes "[Guildmaster]";
		mes "嗯？你怎么进来的？";
		next;
		mes "[Guildmaster]";
		mes "你已经完成测试，把^006699遗忘项链^000000交给凶相的家伙，就能转职！";
		close2;
		warp "in_moc_16",17,19;
		end;
	}
}

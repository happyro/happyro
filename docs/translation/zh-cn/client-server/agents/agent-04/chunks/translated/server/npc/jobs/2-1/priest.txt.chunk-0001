//= [Official Conversion]
//= Job Change quest for Priest class.
//===== Additional Comments: ================================= 
//= Fully working.  Changed the way Priests enter the test room to help Acos.
//= Must use this with the included Acolyte quest to work properely.
//= 1.3 Added Baby Class support, fixed 3 wrong constants bugs [Lupus]
//= 1.5 Fixed possible EXP abuse [Lupus]
//= 1.6 Added a func which prevent advanced classes passing
//=     2nd Job Quests again. It also guides adv classes where
//=     to go. [Lupus]
//= 2.0 Changed numbers to constants. [Vicious]
//= 2.1 Merged JFunc [Lupus]
//= 2.1a Fixed typo [KarLaeda]
//= 2.2 Rescripted to Aegis 10.3 standards. [L0ne_W0lf]
//= 2.3 Several bugfixes with the help of Barron-Monster. [L0ne_W0lf]
//= 2.3a More bug fixes. [L0ne_W0lf]
//= 2.4 Changed Marthilda to Mathilda. [L0ne_W0llf]
//= 2.4a Deleted unused variables. [Samuray22]
//= 2.4b Corrected a Typo error ";;". [Samuray22]
//= 2.5 Added Quest Log commands. [Kisuka]
//= 2.6 Removed the need for use of 'goto.' [L0ne_W0lf]
//==========================================================

prt_church,16,41,4	script	High Bishop#prst	60,{
	// Uncomment the following 'if' statement to allow High Priests to assist Acolytes with the job change quest.
	// Officially High Priests are blocked from helping by an indiscriminate check if you are a transcended character.
	//if (Class == Job_High_Priest) set .@AllowHPAssist,1;
	if (Upper == 1 && .@AllowHPAssist != 1) {
			mes "[保罗主教]";
			mes "嗯……？";
			mes "啊，我感受到你是去过英灵殿的战士。重生的你……我们会在这里照看你。";
			next;
			mes "[保罗主教]";
			mes "不要让邪恶征服你的灵魂。 你拥有足够的勇气和力量克服最艰难的处境。 愿上帝祝福你……";
			close;
	}
	if (BaseJob != Job_Acolyte) {
		if (BaseJob == Job_Priest) {
			mes "[保罗主教]";
			mes "啊……";
			if (Sex == SEX_MALE)
				mes "很高兴再次见到你，兄弟 " + strcharinfo(0) + ". 神的恩典再次让我们相遇。";
			else
				mes "很高兴再次见到你，姐妹 " + strcharinfo(0) + ". 神的恩典让你再次来到我面前。";
			next;
			mes "[保罗主教]";
			mes "我很高兴看到你继续引导上帝的孩子走在正确的道路上。今天有什么我能帮你的吗？";
			next;
				switch(select("你的身体好吗？:我想帮助这位服事。:神父，我需要你的帮助。")) {
			case 1:
				mes "[保罗主教]";
				mes "谢谢你的关心。我很好，身体健康。请代我向你的兄弟姐妹问好。";
				next;
				mes "[保罗主教]";
				mes "记住，我们是上帝在尘世的使者。 永远记得我们必须帮助他人。";
				close;
			case 2:
				mes "[保罗主教]";
				mes "啊，这是个好主意。 帮助年轻服事也应是牧师的优先事项。";
				next;
				mes "[保罗主教]";
				mes "不过，有些事情服事必须独自完成。所有服事都必须亲自完成神圣测试。";
				next;
				mes "[保罗主教]";
				mes "希望你能在第二项测试——精神训练中帮助你的服事朋友。";
				next;
				mes "[保罗主教]";
				mes "你需要带来 ^0000FF1 串念珠^000000，才能陪同服事进行精神训练。如果你有念珠，我现在就能送你去测试区域。";
				next;
				mes "[保罗主教]";
				mes "你愿意在精神训练期间帮助他吗？";
				next;
				if (select("我愿意。:请等我一下。") == 1) {
					if (countitem(2608) > 0) {
						mes "[保罗主教]";
						mes "现在我会把你送到服事训练场。请代我向彼得兄弟问好……";
						next;
						mes "[保罗主教]";
						mes "希望你能帮助这位服事成为牧师。";
						close2;
						warp "job_prist",26,178;
						end;
					}
					mes "[保罗主教]";
				mes "遗憾的是你没有带 ^0000FF念珠^000000。要进入测试区域，你必须带一串念珠。";
					close;
				}
				mes "[保罗主教]";
				mes "我明白了，不用着急。别忘了带 ^0000FF念珠^000000……";
				close;
			case 3:
				mes "[保罗主教]";
				mes "你必须坚强。要有信仰，因为上帝爱着你。我祈祷你身体的伤口早日痊愈……";
				next;
				percentheal 90,0;
				mes "[保罗主教]";
				mes "上帝，请照看你可怜的孩子。帮助他们克服艰辛与困难，振作他们的精神……";
				next;
				percentheal 0,90;
				mes "[保罗主教]";
				mes "希望我的祈祷减轻了你的痛苦。现在请继续前行，传播上帝的讯息。愿上帝与你同在……";
				close;
			}
		}
		else if (BaseClass == Job_Novice) {
			mes "[保罗主教]";
			mes "愿上帝";
			if (Sex == SEX_MALE)
				mes "与你同在，兄弟。";
			else
				mes "与你同在，姐妹。";
			next;
			mes "[保罗主教]";
			mes "你现在位于";
			mes "圣所。";
			mes "是什么带你来到这里？";
			next;
			switch(select("我想成为服事。:我想成为牧师。:其实没什么。")) {
			case 1:
				mes "[保罗主教]";
				mes "哦，我明白了……";
				mes "如果你想成为服事，请去另一间房。";
				break;
			case 2:
				mes "[保罗主教]";
				mes "哦，我明白了。不过成为牧师前必须先成为服事。请去另一间房。";
				break;
			case 3:
				mes "[保罗主教]";
				mes "请把这里当作自己的家。在世上没有比这座圣所更安全的地方。";
				break;
			}
			next;
			mes "[保罗主教]";
		mes "愿上帝祝福你。";
			close;
		}
		else {
			mes "[保罗主教]";
		mes "愿上帝";
			if (Sex == SEX_MALE)
			mes "与你同在，兄弟。";
			else
				mes "与你同在，姐妹。";
			next;
			mes "[保罗主教]";
			mes "是什么带你来到";
			mes "普隆德拉圣所？";
			next;
			switch(select("关于牧师的信息。:没什么。")) {
			case 1:
				mes "[保罗主教]";
				mes "牧师有权执行和主持宗教仪式。";
				next;
				mes "[保罗主教]";
				mes "你必须先作为服事接受充分训练，才能晋升为牧师。";
				next;
				mes "[保罗主教]";
				mes "当服事职业等级达到 40 级时，你就能申请牧师测试。";
				next;
				mes "[保罗主教]";
				mes "通过测试后，你将能使用更强大的技能，有效对付恶魔和不死生物……";
				next;
				mes "[保罗主教]";
				mes "凭借你的全部能力，你将在城镇和地下城中发挥重要作用。";
				next;
				mes "[保罗主教]";
				mes "作为牧师，我们的职责和义务是奉献自己帮助他人，不求回报。";
				next;
				mes "[保罗主教]";
				mes "帮助他人时，不应期待别人以同样方式对待我们。成为伟大的牧师是你的选择和责任，不是别人的。";
				next;
				mes "[保罗主教]";
				mes "不过，接受帮助的人也应保持礼貌。你应该树立杰出榜样，但作为人也要有自己的界限。";
				next;
				mes "[保罗主教]";
				mes "希望我已经充分说明了这个职业。如果想更多了解我们的生活方式，不妨出去和其他牧师谈谈。";
				next;
				break;
			case 2:
				mes "[保罗主教]";
				mes "请把这里当作自己的家。在世上没有比普隆德拉圣所更安全的地方。";
				next;
				break;
			}
			mes "[保罗主教]";
			mes "那么……";
			mes "愿上帝";
			mes "祝福你。";
			close;
		}
	}
	if (PRIEST_Q == 0) {
		mes "[保罗主教]";
		mes "愿上帝祝福";
		if (Sex == SEX_MALE)
			mes "你，兄弟。";
		else
			mes "你，姐妹。";
		mes "是什么带你";
		mes "来到我这里？";
		next;
		switch(select("我想成为牧师。:神父，你好吗？")) {
		case 1:
			mes "[保罗主教]";
			mes "我明白了。你想成为牧师。上帝会因你的决定而喜悦，并赐福于你。";
			next;
			mes "[保罗主教]";
			mes "我是保罗·塞万提斯主教，负责普隆德拉教区。";
			mes "很高兴见到像你这样热忱且虔诚敬神的人。";
			next;
			mes "[保罗主教]";
			mes "如果决心成为牧师，就必须接受几项测试。只有职业等级达到 40 的服事才有资格参加。";
			next;
			mes "[保罗主教]";
			mes "如果满足条件，我建议你先申请牧师转职。现在要申请吗？";
			next;
			if (select("是的。:我需要考虑一下……") == 1) {
				if (JobLevel < 40) {
					mes "[保罗主教]";
					mes "你还没有资格成为牧师。请到外面的世界增长阅历。";
					next;
					mes "[保罗主教]";
					mes "作为服事，你还有许多需要学习的东西。不过，我期待很快再次见到你。";
					close;
				}
				if (SkillPoint) {
					mes "[保罗主教]";
					mes "你还有剩余技能点。";
					mes "强烈建议你在申请牧师转职测试前用完所有技能点。";
					close;
				}
				set PRIEST_Q,1;
				setquest 8009;
					mes "[保罗主教]";
				if (Sex == SEX_MALE)
					mes "现在我来说明牧师的三项试炼。这些磨难会带来许多痛苦，但希望你能完成它们，兄弟 " + strcharinfo(0) + "。";
				else
					mes "现在我来说明牧师的三项试炼。这些磨难会带来许多痛苦，但希望你能完成它们，姐妹 " + strcharinfo(0) + "。";
				next;
				mes "[保罗主教]";
				mes "第一项试炼是朝圣，你要按特定顺序拜访三位苦行牧师。";
				next;
				mes "[保罗主教]";
				mes "第二项试炼是精神训练。你必须抵抗恶魔和不死生物的诱惑。";
				next;
				mes "[保罗主教]";
				mes "最终试炼中，你要承诺对上帝的虔诚，也会被考验牺牲自己的意愿。";
				next;
				mes "[保罗主教]";
				mes "职业等级达到 50 的服事可免除第一项朝圣试炼，因为他们已经展现了热忱与虔诚。";
				next;
				if (JobLevel == 50) {
					mes "[保罗主教]";
					mes "我看得出你为达到职业等级 50 付出了巨大努力。你一直是上帝忠诚的仆人。";
					next;
					mes "[保罗主教]";
					mes "现在你可以直接进行第二项试炼：精神训练。训练时可以带一名牧师同行。";
					next;
					mes "[保罗主教]";
					mes "我毫不怀疑你能独自做好。不过，有已经成为牧师的兄弟或姐妹协助会更容易。";
					next;
					set PRIEST_Q,5;
					changequest 8009,8011;
					mes "[保罗主教]";
					mes "那么，你准备好进行精神训练了吗？";
					next;
					if (select("我准备好了。:请等我一下。") == 1) {
						mes "[保罗主教]";
						mes "很好。我会把你送到训练场。到达后请和负责训练的彼得兄弟交谈。";
						next;
						warp "job_prist",24,180;
						end;
					}
					mes "[保罗主教]";
					mes "没问题，不用着急。";
					mes "愿上帝赐予你克服恐惧的力量……";
					close;
				}
				mes "[保罗主教]";
				mes "那么，我来告诉你朝圣时拜访苦行牧师的顺序。";
				next;
				mes "[保罗主教]";
				mes "首先，请拜访鲁巴卡巴拉神父，";
				mes "他在普隆德拉遗迹";
				mes "的东北方。";
				next;
				mes "[保罗主教]";
				mes "其次，请拜访玛蒂尔达修女。她位于";
				mes "摩洛克附近、普隆德拉西南方。";
				next;
				mes "[保罗主教]";
				mes "第三位要拜访的牧师是洋介神父。他在普隆德拉西北方的田野。";
				next;
				mes "[保罗主教]";
				mes "那么，祝你旅途平安。如有问题，请询问塞西莉亚修女。";
				next;
				mes "[保罗主教]";
				mes "朝圣回来后，我会告诉你";
				mes "下一项测试。";
				next;
				mes "[保罗主教]";
				mes "愿上帝";
				mes "祝福你……";
				changequest 8009,8010;
				close;
			}
			mes "[保罗主教]";
		mes "请慢慢来。";
		mes "我们随时欢迎你。";
			mes "愿上帝祝福你……";
			close;
		case 2:
			mes "[保罗主教]";
		mes "我明白了……";
		mes "我过得很好，";
		mes "身体也很健康。";
		mes "谢谢你的关心。";
			next;
			mes "[保罗主教]";
			if (Sex == SEX_MALE)
				mes "希望你继续作为上帝的仆人执行使命，兄弟。";
			else
				mes "希望你继续作为上帝的仆人执行使命，姐妹。";
			next;
			mes "[保罗主教]";
		mes "希望我们还会";
		mes "再次相遇。";
			mes "愿上帝祝福你……";
			close;
		}
	}
	else if (PRIEST_Q == 1) {
		mes "[保罗主教]";
		mes "可以问问你为什么还在这里吗？你没忘记朝圣吧？";
		next;
		if (select("Sorry father, I need to check the order.:No no no, not at all.") == 1) {
			mes "[保罗主教]";
			mes "啊，我明白了。我再告诉你朝圣顺序，希望你旅途平安。";
			next;
			mes "[保罗主教]";
			mes "首先，去见鲁巴卡巴拉神父。他在普隆德拉遗迹东北方。";
			next;
			mes "[保罗主教]";
			mes "然后记得去见玛蒂尔达修女。她在摩洛克城附近、普隆德拉西南方。";
			next;
			mes "[保罗主教]";
			mes "最后请寻找洋介神父。他在普隆德拉西北方的田野。";
			next;
			mes "[保罗主教]";
		mes "那么，我会为你的平安旅程祈祷。如果想了解更多，请询问塞西莉亚修女。";
			next;
			mes "[保罗主教]";
		mes "朝圣回来后，我会告诉你下一项测试。";
			next;
			mes "[保罗主教]";
			mes "愿上帝祝福你……";
			close;
		}
		mes "[保罗主教]";
	mes "我明白了。不过如果有问题，可以去问塞西莉亚修女。她会解答你的疑问。";
		next;
		mes "[保罗主教]";
	mes "那么，我会为你的平安旅程祈祷。愿上帝祝福你……";
		close;
	}
	else if (PRIEST_Q == 2) {
		mes "[保罗主教]";
	mes "我看你已经与鲁巴卡巴拉神父见面回来了。他近况如何？他一直独自待在那里，我很担心他的健康……";
		next;
		mes "[保罗主教]";
	mes "接下来你应该去见玛蒂尔达修女。我会等你平安回来。";
		close;
	}
	else if (PRIEST_Q == 3) {
		mes "[保罗主教]";
	mes "我看你已经完成与玛蒂尔达修女的会面回来了。她在炎热干燥的沙漠中冥想了很久。";
		next;
		mes "[保罗主教]";
	mes "最后，你该去见洋介神父了。他正在普隆德拉西北方某片田野进行苦修。请找到他后再回到我这里。";
		close;
	}
	else if (PRIEST_Q == 4) {
		set PRIEST_Q,5;
		changequest 8010,8011;
		mes "[保罗主教]";
		mes "你完成了";
		mes "朝圣。";
		mes "恭喜你。";
		next;
		mes "[保罗主教]";
		mes "现在该开始精神训练了。如我之前所说，你可以带一名牧师在训练中帮助你。";
		next;
		mes "[保罗主教]";
		mes "虽然他们不能在整个测试过程中帮助你，但至少能在精神训练中提供协助。";
		next;
		mes "[保罗主教]";
		mes "那么，你准备好进行";
		mes "精神训练了吗？";
		next;
		if (select("我准备好了。:请等我一下。") == 1) {
			mes "[保罗主教]";
			mes "很好。我会把你送到训练场。到达后请和负责训练的彼得兄弟交谈。";
			next;
			warp "job_prist",24,180;
			end;
		}
		mes "[保罗主教]";
		mes "没问题，";
		mes "不用着急。";
		mes "愿上帝赐予你";
		mes "克服恐惧的力量……";
		close;
	}
	else if (PRIEST_Q == 5) {
		mes "[保罗主教]";
		mes "你对精神训练很有信心。我们开始吧？";
		next;
		if (select("I'm ready.:Give me a minute.") == 1) {
			mes "[保罗主教]";
			mes "很好。我会把你送到训练场。到达后请和负责训练的彼得兄弟交谈。";
			next;
			warp "job_prist",24,180;
			end;
		}
		mes "[保罗主教]";
		mes "没问题，";
		mes "不用着急。";
		mes "愿上帝赐予你";
		mes "克服恐惧的力量……";
		close;
	}
	else if (PRIEST_Q == 6) {
		mes "[保罗主教]";
		mes "你看起来疲惫不堪。不过成为牧师后，你必须承受更多苦难。";
		next;
		mes "[保罗主教]";
		mes "为了梦想，请忍受这些试炼。再挑战一次精神训练吧？";
		next;
		if (select("I'll try again.:Give me a minute.") == 1) {
			mes "[保罗主教]";
			mes "很好。我会把你送到训练场。请向彼得兄弟寻求帮助。";
			next;
			warp "job_prist",24,180;
			end;
		}
		mes "[保罗主教]";
		mes "没问题，";
		mes "不用着急。";
		mes "愿上帝赐予你";
		mes "克服恐惧的力量……";
		close;
	}
	else if (PRIEST_Q == 7) {
		mes "[保罗主教]";
		mes "我很高兴你顺利完成精神训练。恭喜你，你现在有资格被称为牧师了。";
		next;
		mes "[保罗主教]";
		mes "现在，你必须和塞西莉亚修女一起向上帝宣誓虔诚。不要紧张……";
		next;
		mes "[保罗主教]";
		mes "只需诚实回答，聆听在你心中轻声诉说的上帝之声。";
		next;
		mes "[保罗主教]";
		mes "那么……";
		mes "我会在这里";
		mes "等你回来。";
		close;
	}
	else if (PRIEST_Q == 8) {
		mes "[保罗主教]";
		mes "嗯？你还没有宣誓……？没有对上帝誓言的坚定信念，你随时可能受到邪恶诱惑。";
		next;
		mes "[保罗主教]";
		mes "你应该去找塞西莉亚修女，向上帝承诺你的虔诚。带着荣誉回来，聆听在你心中轻声诉说的上帝之声。";
		close;
	}
	else if (PRIEST_Q == 9) {
		if (SkillPoint) {
			mes "[保罗主教]";
			mes "你还有剩余技能点。请使用技能点提升技能后再回来找我。";
			close;
		}
		mes "[保罗主教]";
		mes "恭喜你完成了所有牧师必须经历的试炼。现在就让我把你晋升为牧师。";
		
		
		
		next;

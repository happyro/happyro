airplane_01,238,154,3	script	Airship Captain#01	4_M_REINDEER,{
	cutin "fly_felrock",2;
	mes "[塔洛克]";
	mes "我是塔洛克，";
	mes "这艘飞艇的";
	mes "飞艇的船长。你有";
	mes "问题吗？";
	next;
	if (lght_air >= 0 && lght_air <= 3 || lght_air == 7) {
		.@question$ = "How does this Airship fly?";
	} else if (lght_air == 4) {
		.@question$ = "I handed the letter to Captain Ferlock.";
	} else if (lght_air == 5) {
		.@question$ = "You finished reading the letter?";
	} else if (lght_air == 6) {
		.@question$ = "Already finished reading?";
	}
	switch (select("Y-you're a reindeer?!", .@question$, "No, not really.")) {
	case 1:
		mes "[塔洛克]";
		mes "嗯？哦，那个";
		mes "我们驯鹿是自豪的种族，";
		mes "喜欢环游世界。想想";
		mes "圣诞老人麾下的";
		mes "驯鹿，就很明显了。";
		mes "";
		next;
		mes "[塔洛克]";
		mes "无论是否是驯鹿，";
		mes "我赢得了这艘船的";
		mes "船长职位";
		mes "以及船员的忠诚。";
		mes "我们会尽力";
		mes "确保你的飞行安全。";
		break;
	case 2:
		mes "[塔洛克]";
		if (lght_air == 1) {
			if (BaseLevel <= 59) {
				mes "嗯……？";
				mes "你之前不是问过吗？";
				mes "总之抱歉，我仍不能告诉你这个秘密。";
				mes "";
				mes "";
				break;
			} else {
				mes "嗯……？你之前不是问过吗？";
				mes "只是好奇，还是确实想知道？";
				mes "";
				mes "";
				next;
				switch (select("No, not really...:Yes, I really want to know!")) {
				case 1:
					mes "[塔洛克]";
					mes "哈哈哈~";
					mes "也许有一天你会弄清楚这艘飞艇如何悬浮飞行。";
					mes "";
					mes "";
					mes "";
					break;
				case 2:
					mes "[塔洛克]";
					mes "说实话，飞艇飞行的秘密只有船长有权知道。";
					mes "所以我不该告诉你。";
					mes "";
					mes "";
					mes "";
					mes "";
					next;
					mes "[塔洛克]";
					mes "但我从未信任上层管理，所以对他们没有忠诚。";
					mes "如果你先帮我个小忙，我倒不介意告诉你机密。";
					mes "";
					mes "";
					mes "";
					mes "";
					next;
					switch (select("Let me think about it.:Sure.")) {
					case 1:
						mes "[塔洛克]";
						mes "好吧。不过别担心，我不会让你做无法应付的事。决定后再回来，好吗？";
						mes "";
						mes "";
						mes "";
						mes "";
						break;
					case 2:
						setquest 8032;
						lght_air = 2;
						mes "[塔洛克]";
						mes "哈、哈哈！我已经喜欢上你了！";
						mes "事情是这样的，我有个弟弟，也是飞艇船长，总在旅行，很少见面。";
						mes "";
						mes "";
						mes "";
						mes "";
						next;
						mes "[塔洛克]";
						mes "能把这封信交给我弟弟费尔洛克吗？";
						mes "记得带着他的回信回来，好吗？谢谢你，冒险者。";
						mes "";
						mes "";
						mes "";
						mes "";
						next;
						mes "[塔洛克]";
						mes "哦，见到我弟弟后请帮帮他。他会亲自解释。";
						mes "";
						mes "";
						mes "";
						mes "";
						next;
						mes "^3131FF你收到塔洛克船长给弟弟费尔洛克船长的信。^000000";
						mes "";
						mes "";
						mes "";
						mes "";
						break;
					}
					break;
				}
			}
		} else if (lght_air == 4) {
			lght_air = 5;
			changequest 8034,8035;
			mes "哦！";
			mes "他回复你了？真的吗？！";
			mes "其实我没抱太大希望……";
			mes "请等一下，我读读他的信。";
			mes "";
			mes "";
		} else if (lght_air == 5) {
			lght_air = 6;
			mes "嗯……哈哈哈~！";
			mes "这家伙真是个情圣！";
			mes "但他的真心被职责束缚。";
			mes "你觉得呢？呵呵呵。";
			mes "";
			mes "";
			next;
			mes "^3131ff他继续读信。^000000";
			mes "";
		} else if (lght_air == 6) {
			mes "好了，我读完了。";
			mes "虽然我理解他，但我们的观点完全不同。不过我们都无所畏惧。";
			mes "";
			mes "";
			mes "";
			next;
			mes "[塔洛克]";
			mes "哦，我差点忘了。";
			mes "我来告诉你想知道的事。";
			mes "";
			next;
			mes "[塔洛克]";
			mes "飞艇悬浮的秘密是……";
			mes "点燃大型锅炉，水经过锅炉产生蒸汽，";
			mes "推动活塞、齿轮和涡轮。";
			mes "";
			mes "";
			mes "";
			next;
			mes "[塔洛克]";
			mes "这会带动螺旋桨。";
			mes "就这样。明白了吗？";
			mes "";
			next;
			select("嗯？就这些？没有更多了吗？");
			mes "[塔洛克]";
			mes "哈哈哈！";
			mes "我只是为了让你容易理解才粗略解释。";
			mes "你还是不满意？我已经用人人都懂的简单话说了。";
			mes "";
			next;
			mes "[塔洛克]";
			mes "显然，只有蒸汽";

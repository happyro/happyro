			mes "一定是出了某种";
			mes "错误。也许你应该回";
			mes "商人公会";
			mes "说明情况，";
			mes "解决这个问题？";
			close2;
			cutin "",255;
			end;
		}
		if (job_merchant_q == 4)
			set job_merchant_q,6;
		else if (job_merchant_q == 3)
			set job_merchant_q,5;
		mes "[卡普拉职员]";
		mes "再次感谢你";
		mes "费心";
		mes "处理这些事情～";
		close2;
		cutin "",255;
		end;
	}
	else {
		mes "[卡普拉职员]";
		mes "欢迎来到";
		mes "卡普拉公司，";
		mes "我们始终为你提供";
		mes "贴心服务～";
		next;
		mes "[卡普拉职员]";
		mes "如你所见，";
		mes "剑士协会";
		mes "已搬到伊兹鲁德，那里是";
		mes "普隆德拉的卫星城。";
		mes "目前我们提供前往伊兹鲁德的传送服务，";
		mes "费用为 600 Zeny。";
		next;
		if (select("Use:Cancel") == 1) {
			if (Zeny < 600) {
				mes "[卡普拉职员]";
				mes "抱歉，你";
				mes "没有足够的 Zeny";
				mes "支付传送服务费用。";
				close2;
				cutin "",255;
				end;
			}
			set Zeny, Zeny-600;
			set RESRVPTS, RESRVPTS + 37;
			cutin "",255;
			warp "izlude",94,103;
			end;
		}
		close2;
		cutin "",255;
		end;
	}
}

//izlu2dun,106,58,4	script	Kafra Employee#mer	116,{
function	script	F_MercKafra	{
	if ((job_merchant_q == 6 || job_merchant_q == 5) && (job_merchant_q2 == 8 || job_merchant_q2 == 7)) {
		mes "[卡普拉职员]";
		mes "哦，你好～";
		mes "嗯，你来这里";
		mes "有什么特别的原因";
		mes "吗？";
		close2;
		cutin "",255;
		end;
	}
	else if (job_merchant_q == 4 || job_merchant_q == 3) {
		mes "[卡普拉职员]";
		mes "是商人公会的";
		mes "货物吗？";
		mes "哦，是的，请把它";
		mes "放在那边……";
		if (countitem(1081) == 1 || countitem(1082) == 1 || countitem(1091) == 1) {
			mes "你搬了这么久";
			mes "一定很累吧！";
		}
		else {
			mes "等、等等。你没有带来吗？";
			mes "包裹在哪里？";
			close2;
			cutin "",255;
			end;
		}
		next;
		mes "[卡普拉职员]";
		mes "现在让我检查";
		mes "序列号……";
		if (job_merchant_q2 == 7 && countitem(1081) != 0) {
			mes "3318702。没错，这就是";
			mes "我们订购的货物。哦，";
			mes "别忘了这张收据！";
			delitem 1081,1; //Merchant_Box_1
			getitem 1079,1; //Merchant_Voucher_7
		}
		else if (job_merchant_q2 == 8 && countitem(1082) != 0) {
			mes "3543625。没错，这就是";
			mes "我们订购的货物。哦，";
			mes "别忘了这张收据！";
			delitem 1082,1; //Merchant_Box_2
			getitem 1080,1; //Merchant_Voucher_8
		}
		else {
			mes "嗯？等等，这是";
			mes "错误的包裹。我们订购的货物";
			if (job_merchant_q2 == 7)
				mes "序列号是 3318702，肯定不是这个。";
			else if (job_merchant_q2 == 8)
				mes "序列号是 3543625，肯定不是这个。";
			else
				mes "序列号应为 3318702 或 3543625。";
			close2;
			cutin "",255;
			end;
		}
		if (job_merchant_q == 4)
			set job_merchant_q,6;
		else if (job_merchant_q == 3)
			set job_merchant_q,5;
		next;
		if (countitem(1072) != 0 && quest_alb_01 == 0) {
			select("This is from Chief Mahnsoo of the Merchant Guild...");
			delitem 1072,1; //Delivery_Message
			set quest_alb_01,1;
			mes "[卡普拉职员]";
			mes "哦～！这是";
			mes "Mahnsoo 寄来的信！谢谢你，";
			mes "我一直很想收到他的消息。";
			mes "他最近怎么样，还好吗？";
			mes "";
			mes "我等不及要读了……";
			next;
			mes "[卡普拉职员]";
			mes "哦，谢谢你";
			mes "费心";
			mes "把这些东西";
			mes "送来。这不是什么特别的东西，";
			mes "但请收下。";
			mes "那么，下次见～";
			getitem 513,3; //Banana
		}
		else {
			mes "[卡普拉职员]";
			mes "再次感谢你";
			mes "费心";
			mes "处理这些事情～";
		}
		close2;
		cutin "",255;
		end;
	}
	return;
}

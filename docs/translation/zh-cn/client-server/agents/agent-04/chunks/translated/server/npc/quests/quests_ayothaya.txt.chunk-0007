		next;
		mes "[通敦商人]";
		mes "你想";
		mes "再买些辣椒吗？";
		next;
		if (select("No, thanks.:Yes, please.") == 1) {
			mes "[通敦商人]";
			mes "再见～";
			close;
		}
		if (Zeny > 1999) {
			if (MaxWeight - Weight > 1199) {
				set Zeny, Zeny-2000;
				getitem 7286,30; //Chilli
				mes "[通敦商人]";
				mes "谢谢，";
				mes "欢迎再来！";
				close;
			}
			mes "[通敦商人]";
			mes "糟糕……";
			mes "看起来";
			mes "你携带了";
			mes "太多东西";
			mes "。";
			next;
			mes "[通敦商人]";
			mes "如果你没有";
			mes "空间存放，";
			mes "我什么也给不了你！";
			close;
		}
		mes "[通敦商人]";
		mes "嗯……？";
		mes "现在看来，";
		mes "你似乎没有足够";
		mes "的钱购买";
		mes "所需物品。";
		close;
	}
	mes "[通敦商人]";
	mes "你好！";
	mes "以前吃过辣椒吗？";
	next;
	mes "[通敦商人]";
	mes "虽然外表很小，";
	mes "味道却很强烈。 而且又辣又呛，吃的时候要小心。";
	next;
	mes "[通敦商人]";
	mes "阿育他雅人喜欢味道独特、辛辣刺激的食物。 阿育他雅料理会使用辣椒、大蒜、生姜和香菜。";
	next;
	mes "[通敦商人]";
	mes "我在卖辣椒，";
	mes "如果你需要，";
	mes "请来找我～";
	close;
}

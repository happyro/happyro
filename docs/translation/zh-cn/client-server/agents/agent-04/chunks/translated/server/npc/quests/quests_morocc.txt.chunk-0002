			mes "[老板]";
			mes "你要什么……？";
			mes "我刚告诉你";
			mes "我只供应两种";
			mes "饮料。想喝";
			mes "水就应该";
			mes "去别处。";
			close;
		}
	case 2:
		if (mao_request == 1) {
			if (BaseClass == Job_Assassin) {
				mes "[老板]";
				mes "任务……";
				mes "你不觉得有点晚了吗？";
				mes "所有请求都取消了，你没事可做了。";
			mes "此外，最重要的是，城市修复工作才是当前最紧急的事情。";
				close;
			}
			else {
				mes "[老板]";
				mes "嗯？";
				next;
			select("向他出示推荐信。");
				if (countitem(7416) > 0) {
					mes "[老板]";
					mes "啊……我觉得你来得有点晚。";
				mes "如果你是为了发给各公会的请求而来，我没什么可说的。";
					mes "抱歉让你白跑一趟。";
					close;
				}
				else {
					mes "[老板]";
					mes "你在说什么？";
					next;
					mes "[老板]";
					mes "................你现在看起来太可疑了。";
					mes " ";
					mes "小伙子们，把这家伙赶出去！！";
					next;
					mes "[Drinking Boys]";
				mes "- 是，老板！";
					next;
				mes "- 你被赶出了这里。-";
					close2;
					warp "morocc",45,106;
					end;
				}
			}
		}
		else {
			if (BaseClass == Job_Assassin) {
				mes "[老板]";
				mes "让我猜猜。你还没有从这里接到任务，对吧？";
				mes "顺便问一下，你喜欢这里吗？";
				next;
				mes "[老板]";
				mes "你知道，我有点……";
				mes "真的很喜欢我这间小酒馆……";
				mes "这里会进行一些秘密交易……";
				next;
				mes "[老板]";
				mes "如果你愿意，我可以向公会会长推荐你接任务。";
				mes "在那之前，你得专心训练。";
				mes "训练之余……为什么不喝一杯呢？";
				mes "放松一下吧。";
				mes "这里的酒很不错。";
				mes "欢迎随时来。";
				close;
			}
			else {
				mes "[老板]";
				mes "任务……？";
				mes "拜托，你在说什么？";
				mes "别再胡说了，";
				mes "点杯饮料喝吧。";
				mes "放松一点。";
				close;
			}
		}
	case 3:
		mes "[老板]";
		mes "嗯……";
		close;
	}
}

que_job01,49,49,5	script	Tao#dan_09	877,{
	if (BaseClass == Job_Assassin) {
		mes "[Tao]";
		mes "欢迎，喵～";
		mes "最近怎么样，喵？";
		next;
		if (prt_curse == 24) {
			switch(select("玛丽安娜在吗？:我是来见你的，陶。")) {
			case 1:
				mes "[Tao]";
				mes "她在你左边的房间里，喵～";
				mes "不过，你怎么知道她在这里，喵？";
				close;
			case 2:
				mes "[Tao]";
			mes "这里不是玩耍的地方，喵……";
			mes "……嘿，你那样盯着我看很尴尬，喵……";
				close;
			}
		}
		else {
			mes "[Tao]";
		mes "这一切都是因为那个叫莱扬·莫尔，还是莫尔……什么来着的家伙吗？";
		mes "……喵……";
			next;
			mes "[Tao]";
		mes "唉，你没事做就快走，喵？！";
		mes "你知道这里禁止进入，喵。";
		mes "反正你也进不了那个房间，喵～";
			next;
			mes "[Tao]";
		mes "或者……你可以……哦，谁知道呢，喵……";
		mes "陶再也不想看守大门了，喵～喵～";
			close;
		}
	}
	else {
		mes "[Tao]";
		mes "怎么了，喵！";
		next;
		switch(select("所以只有你一个小家伙吗？:你到底怎么了？！:嘿，别喵喵叫了？！")) {
		case 1:
			mes "[Tao]";
			mes "你在说什么，喵！";
			mes "陶是最伟大的守门人！";
			mes "可别小看我，喵！";
			next;
			mes "[Tao]";
			mes "看来你是有目的来的，但别妄想得到我的帮助，喵！！";
			mes "你以为我会傻到告诉你";
			mes "大师和玛丽安娜就在右边房间里吗？喵、喵、喵～～";
			close;
		case 2:
			mes "[Tao]";
			mes "你因为我是守门人就看不起我吗？！";
			mes "咕噜噜……";
			next;
			mes "[Tao]";
			mes "趁现在还能走，快滚出去！！！！";
			close;
		case 3:
			mes "[Tao]";
			mes "喵，喵。";
			mes "说来话长，喵。";
			mes "那天，陶真的很想要一条大蝴蝶结，喵。";
			next;
			mes "[Tao]";
			mes "于是我出去寻找野玫瑰，喵……";
			mes "……喵？等等，我为什么要讲这个故事，喵？！";
			next;
			mes "[Tao]";
			mes "咕噜噜！";
			mes "你到底是谁！";
			next;
			mes "[Tao]";
			mes "滚出去，喵！！！";
			close;
		}
	}
}

que_job01,51,55,0	script	que_job01#room_1	45,1,1,{


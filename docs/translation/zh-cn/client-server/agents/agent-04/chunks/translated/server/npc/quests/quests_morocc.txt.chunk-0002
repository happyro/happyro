moc_fild20,354,183,3	script	Continental Guard#01::MocConGuard	707,3,3,{
	if ((rebirth_moc_edq == 0) && (rebirth_moc_edq < 4)) {
		mes "[Continental Guard]";
		mes "此处禁止平民继续前进。";
		mes "这里极其危险，因此限制进入。";
		next;
		switch(select("结束对话:询问发生了什么")) {
		case 1:
			close;
		case 2:
			mes "[Continental Guard]";
			mes "你不知道吗？撒旦摩洛克已经复活，逃出了原本被囚禁的梦罗克村。";
			next;
			mes "[Continental Guard]";
			mes "他的复活给村庄和周围沙漠造成了无法弥补的损害，现在他已经转移到了苏克拉特沙漠。";
			next;
			mes "[Continental Guard]";
			mes "我们奉普隆德拉王国的命令驻守这里，阻止除梦罗克讨伐队成员之外的平民进入该区域。";
			next;
			mes "[Continental Guard]";
			mes "如果想了解更多信息，建议你去梦罗克村的事故现场，找负责那里的大陆警卫。";
			next;
			switch(select("结束对话:询问警卫位置")) {
			case 1:
				close;
			case 2:
				mes "[Continental Guard]";
				mes "你要找的警卫就在梦罗克村中心搭建的营地里。";
				next;
				mes "[Continental Guard]";
				mes "如果你愿意，我可以直接送你过去。";
				next;
				switch(select("不用，谢谢。:请送我过去。")) {
				case 1:
					mes "[Continental Guard]";
					mes "我明白了。那么为了安全，请尽快离开这个危险区域。";
					close;
				case 2:
					mes "[Continental Guard]";
					mes "很好。我马上送你去梦罗克村事故现场。";
					close2;
					warp "morocc",160,61;
					end;
				}
			}
		}
	}
	else if ((rebirth_moc_edq > 3) && (rebirth_moc_edq < 8)) {
		mes "[Continental Guard]";
		mes "此处禁止平民继续前进。";
		mes "这里极其危险，因此限制进入。";
		next;
		switch(select("结束对话:进入原野调查:前往梦罗克事故现场")) {
		case 1:
			close;
		case 2:
			if ($@re_moc < 3) {
				getpartymember getcharid(1), 1, .@partymembercid;
				.@partymembercount = $@partymembercount;
				for (.@i = 0; .@i < .@partymembercount; .@i++) {
					if (convertpcinfo(.@partymembercid[.@i], CPC_ACCOUNT))
						.@onlinemembers++;
				}
				if ((.@onlinemembers > 1) && (countitem(7826) > 0)) {
					mes "[Continental Guard]";
					mes "......";
					next;
					mes "[Continental Guard]";
					mes "是的，我确认你是大陆警卫成员。祝你顺利完成任务。";
					next;
					mes "[Continental Guard]";
					mes "我马上送你去原野。请使用原野入口的传送点返回这里。";
					close2;
					warp "moc_fild21",38,193;
					end;
				}
				else if ((.@onlinemembers < 2) && (countitem(7826) > 0)) {
					mes "[Continental Guard]";
					mes "欢迎，大陆警卫成员。巴洛格队长有一份特别命令给你们，我来为你宣读。";
					next;
					mes "[Continental Guard]";
					mes "‘由于该区域十分危险，现禁止大陆警卫成员单独调查。今后执行任务时，必须组成至少 2 人的队伍。’";
					next;
					mes "[Continental Guard]";
					mes "……你明白了吧？请回到现场，并组成至少 2 人的队伍后再回来。谢谢。";
					close;
				}
				else if (countitem(7826) < 1) {
					mes "[Continental Guard]";
					mes "只有持有大陆警卫证书的大陆警卫成员，才可以通过这里。";
					close;
				}
				else {
					close;
				}
			}
			else {
				mes "[Continental Guard]";
				mes "总部下令封锁这里，因为梦罗克原野检测到了异常时空现象。";
				next;
				mes "[Continental Guard]";
				mes "我们必须等现象结束后，才能让你继续调查。";
				close;
			}
		case 3:
			mes "[Continental Guard]";
			mes "很好。我马上送你去梦罗克村事故现场。";
			mes "";
			mes "";

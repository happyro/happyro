//===== rAthena Script =======================================
//= Veins Quests
//===== Description: =========================================
//= [Official Conversion]
//= Collection of Veins Quests 
//= Stone Quest:
//= - Help an Old Man with his job.
//= - Dialog obtained from iRO.
//= - Variable in use: veins_stone (max 8)
//= Spy Quest:
//= - Help prove (or disprove) a bard's innocence.
//= - Dialog obtained from iRO.
//= - Variable in use: que_sch (max 26)
//= Siblings Quest:
//= - Help a boy save his little sister.
//= - Dialog partially obtained from iRO.
//= - Variable in use: rachel_camel (max 25)
//= Thor Volcano Base Quest:
//= - Missing addition to High Priest Zhed to start quest.
//= - Infiltrate Thor Volcano Base. What is Arunafeltz up to?
//= - Variable in use: rachel_camel (max 27)
//===== Changelog: =========================================
//= 1.0 First version, Added Veins Stone quest. [L0ne_W0lf]
//= 1.1 Added Veins Spy Quest. [L0ne_W0lf]
//= 1.2 Added Veins Siblings Quest. [L0ne_W0lf]
//=     Added Veins Thor Volcano Base Quest NPC. [L0ne_W0lf]
//=     Start NPC is missing, but will be added when I get it.
//= 1.3 Fixed two typos small in Asbar. [L0ne_W0lf]
//= 1.3a More fixes to some of the Base quest NPCs. [L0ne_W0lf]
//= 1.4 Added missing checkweights. [L0ne_W0lf]
//= 1.4a Corrected a typo error ";;". [Toms]
//= 1.5 Added Nameless Island quest addition. [L0ne_W0lf]
//= 1.5a Corrected a couple typos in Nameless Addition. [L0ne_W0lf]
//= 1.6 Replaced effect numerics with constants. [L0ne_W0lf]
//= 1.7 Moved a couple NPCs related to the Spy quest. [L0ne_W0lf]
//= 1.8 Fixed some typos and confusing condition checks. [L0ne_W0lf]
//= 1.9 Added quest log entries for:
//=     - Siblings Quest
//=     - Thor Volcano Base Quest
//= 2.0 Removed level requirement. (bugreport:4678) [L0ne_W0lf]
//= 2.1 Added missing changequest (3071-3076). [Joseph]
//= 2.2 Moved "Wincing Old Man" to pre-re/re coordinates. [Euphy]
//= 2.3 Fixed incorrect use of 'close'. [Joseph]
//= 2.4 Updated RE/Pre-RE EXP. [Euphy]
//= 2.5 Added GM management NPC and quest log support. [Euphy]
//= 2.6 Commented custom quest log support for Nameless Island Access Quest [Everade]
//============================================================

// Stone Quest :: veins_stone
//============================================================
-	script	::WincingOldMan_veins	-1,{
	if ((MaxWeight - Weight) < 2000 || checkweight(1201,1) == 0) {
		mes "- 请稍等！-";
		mes "- 你当前携带了 -";
		mes "- 太多物品。-";
		mes "- 请先回来 -";
		mes "- 把一些物品存入卡普拉仓库。-";
		close;
	}
	if (veins_stone == 0) {
		mes "[扎巴鲁]";
		mes "我的背疼死了";
		mes "整天弯腰";
		mes "捡石头……";
		mes "疼痛……难以忍受！";
		next;
		switch(select("用膝盖弯腰:天啊，有多严重？")) {
		case 1:
			mes "[扎巴鲁]";
			mes "小毛孩！";
			mes "我没问你";
			mes "的建议！别";
			mes "对老人说教！";
			close;
		case 2:
			mes "[扎巴鲁]";
			mes "哦，疼得厉害，几乎";
			mes "残废。但我别无选择，我需要";
			mes "";
			mes "收集足够的石头填补";
			mes "这个缺口，才能";
			mes "拿到报酬。啊，该死！";
			next;
			mes "[扎巴鲁]";
			mes "如果我赚不到足够钱";
			mes "支付孙女的药费，";
			mes "";
			mes "我就买不起";
			mes "孙女的药！";
			mes "那太可怕了！啊！";
			next;
			select("我能帮忙吗？");
			mes "[扎巴鲁]";
			mes "谢谢你的好意，";
			mes "但不用，我必须自己做。";
			mes "";
			mes "男人必须有尊严……";
			next;
			mes "^333333*咔*^000000";
			next;
			mes "[扎巴鲁]";
			mes "啊！我的背……！";
			mes "这完全";
			mes "出乎意料！";
			mes "求你！求你，";
			mes "看在芙蕾雅的份上，";
			mes "帮帮我！";
			next;
			select("我来帮你。");
			mes "[扎巴鲁]";
			mes "谢谢！";
			mes "非常感谢！";
			next;
			select("你想让我做什么？");
			mes "[扎巴鲁]";
			mes "哎哟哎哟！哦……好……";
			mes "看到那些深色的";
			mes "石头插在地里吗？";
			mes "那就是我需要";
			mes "捡的。现在别急着";
			mes "搬石头……";
			next;
			mes "[扎巴鲁]";
			mes "我请城里另一位老人";
			mes "阿布萨尔";
			mes "制作帮助我背部的东西，";
			mes "他本来会帮我，只要我给他——";
			mes "";
			mes "啊！我的背！好痛！";
			next;
			mes "[扎巴鲁]";
			mes "疼死我了！而且在我";
			mes "要说完重要信息的";
			mes "句子时，尤其";
			mes "疼得厉害——";
			mes "啊啊啊！快去找阿布萨尔！";
			mes "快点！";
			next;
			while(1) {
				mes "[扎巴鲁]";
				mes "等等，等等……";
				mes "也许在身体被";
				mes "阵阵疼痛折磨之前，";
				mes "我可以回答你几个问题。";
				mes "来……";
				mes "至少试试看吧。";
				next;
				switch(select("这些石头是怎么回事？:老人在哪里？:没什么。")) {
					case 1:
						mes "[扎巴鲁]";
						mes "我们使用这些深色";
						mes "石头，是因为它们";
						mes "漂亮又容易加工。";
						mes "它们算是这座城镇的特产。";
						mes "我靠采集这些方便的石头";
						mes "获得报酬。";
						next;
						mes "[扎巴鲁]";
						mes "我们可以把它们卖给游客，";
						mes "甚至还有使用这些石头的工厂。";
						mes "不过，城里人并不是";
						mes "靠这些石头";
						mes "发大财的。";
						mes "";
						next;
						mes "[扎巴鲁]";
						mes "我们所有人仍然";
						mes "只能勉强维持生计……";
						next;
						break;
					case 2:
						mes "[扎巴鲁]";
						mes "阿布萨尔？他在";
						mes "工具店里。你不会找不到他的……";
						mes "只要找那个";
						mes "眼神疯狂的人！";
						mes "";
						next;
						break;
					case 3:
						mes "[扎巴鲁]";
						mes "谢谢你的帮助。";
						mes "如果在工具店找不到阿布萨尔，";
						mes "那就去酒馆看看。啊——！";
						mes "";
						mes "";
						set veins_stone,1;
						close;
				}
			}
		}
	}
	else if (veins_stone == 1) {
		mes "[扎巴鲁]";
		mes "谢谢你的帮助。";
		mes "如果在工具店找不到阿布萨尔，";
		mes "那就去酒馆看看。啊——！";
		mes "";
		mes "";
		close;
	}
	else if ((veins_stone > 1) && (veins_stone < 4)) {
		mes "[扎巴鲁]";
		mes "天啊，阿布萨尔真是";
		mes "挑剔。不过，尽力弄到";
		mes "他想要的东西吧。";
		mes "否则他不会帮我的！";
		mes "除此之外，他其实";
		mes "也不是坏人……";
		close;
	}
	else if (veins_stone == 4) {
		mes "[扎巴鲁]";
		mes "哦，太好了，你回来了！";
		mes "你带来";
		mes "阿布萨尔为我制作的东西了吗？";
		next;
		select("是的，在这里……");
		mes "[扎巴鲁]";
		mes "所以这就是他";
		mes "说的东西？";
		mes "它要怎么用……啊！";
		mes "原来如此！拉动把手，";
		mes "棍子的那一端";
		mes "就能捡起东西！";
		next;
		mes "[扎巴鲁]";
		mes "太棒了！我再也不用";
		mes "弯腰捡石头了！嘿，";
		mes "他一定为这项实用的发明";
		mes "感到非常自豪～";
		mes "我都能想象他得意的样子。";
		mes "";
		next;
		mes "[扎巴鲁]";
		mes "嗯，他把这个交给你之后";
		mes "有没有说什么？我只是好奇。";
		mes "";
		next;
		select("这张字条……");
		mes "[扎巴鲁]";
		mes "哦……我还以为他";
		mes "会把那件事忘得一干二净。";
		mes "现在知道了真是松了口气。";
		mes "他真是太好了。";
		mes "";
		next;
		mes "[扎巴鲁]";
		mes "我不太好意思再拜托你……";
		mes "但你介意";
		mes "再帮我";
		mes "一次吗？";
		next;
		select("嗯？是什么？");
		mes "[扎巴鲁]";
		mes "别担心，不难。你只要把我收集的石头";
		mes "送到城里的工厂就行了。";
		mes "就在机场或飞艇附近，";
		mes "大概是那里。不会花很久时间。";
		mes "";
		mes "";
		set veins_stone,5;
		close;
	}
	else if (veins_stone > 4 && veins_stone < 7) {
		mes "[扎巴鲁]";
		mes "再次感谢你的帮助！";
		mes "阿布萨尔把这个东西";
		mes "叫什么来着？触觉……";
		mes "伸缩……该死……";
		mes "名字为什么这么长？";
		mes "总之，它很有用～";
		close;
	}
	else if (veins_stone == 7) {
		mes "[扎巴鲁]";
		mes "哦，你回来了！";
		mes "真的非常感谢";
		mes "你一直以来的帮助。我没有";
		mes "多少钱，也知道你没期待";
		mes "奖励，但我想";
		mes "送你一件东西。";
		next;
		mes "[扎巴鲁]";
		mes "啊，在这里。我采集石头时";
		mes "找到了这些东西。听说冒险者";
		mes "会觉得它们有用。总之，";
		mes "希望你喜欢这些石头……";
		mes "";
		set veins_stone,8;
		getexp (checkre(3))?30000:300000,0;
		getitem 985,3; //Elunium
		close;
	}
	else if (veins_stone > 7) {
		mes "[扎巴鲁]";
		mes "多亏了你和阿布萨尔，";
		mes "我可怜的背最近";
		mes "一点也不疼了。";
		mes "我这个年纪，应该";
		mes "更好地照顾自己……";
		close;
	}
}

ve_in,169,310,6	script	Strange Old Man#ve	121,{
	if (veins_stone == 0) {
		mes "[阿布萨尔]";
		mes "哇哈哈哈！";
		mes "等……等完成之后，我就……";
		mes "哇哈哈哈哈哈哈哈！";
		close;
	}
	else if (veins_stone == 1) {
		mes "[阿布萨尔]";
		mes "马上就要完成了。现在只要";
		mes "把这里转一下……";
		mes "";
		next;
		if (select("打扰一下……:……") == 1) {
			mes "[阿布萨尔]";
			mes "什么？！谁敢";
			mes "打扰我？！不、不！";
			mes "看！看看你做了什么！";
			mes "你把事情搞砸了！";
			next;
			specialeffect EF_LORD;
			percentheal -30,0;
			next;
			mes "[阿布萨尔]";
			mes "!@#$%#@#$!*～";
			mes "F$#@#%^^^&&!";
			close2;
			warp "ve_in",262,309;
			end;
		}
		mes "[阿布萨尔]";
		mes "哦，不……";
		next;
		specialeffect EF_ASPERSIO;
		next;
		mes "[阿布萨尔]";
		mes "怎么会……？！";
		mes "不！我又失败了！";
		mes "该、该死啊啊啊——";
		next;
		mes "[阿布萨尔]";
		mes "嗯？你是……";
		mes "你想要什么？";
		next;
		select("哦，我、我是……");
		mes "[阿布萨尔]";
		mes "直说吧。告诉我";
		mes "你想要什么，不是你的";
		mes "名字。快点，你没看到";
		mes "我正忙着吗？";
		next;
		if (select("我……对不起。:我是来找扎巴鲁先生的……") == 1) {
			mes "[阿布萨尔]";
			mes "要不是你打断我！";
			mes "那样的话";
			mes "我早就已经……";
			mes "唉！回去工作！";
			close;
		}
		mes "[阿布萨尔]";
		mes "扎巴鲁？那是什么……";
		mes "哦，算了。我想起来了";
		mes "他让我做什么。你把";
		mes "所有材料都带来了吗？";
		mes "";
		next;
		if (select("是的:什么材料……？") == 1) {
			mes "[阿布萨尔]";
			mes "太好了，我们可以开始——";
			mes "";
			mes "骗子。你甚至不知道";
			mes "应该给我带什么，对吧？！";
			mes "滚出去！";
			mes "";
			close2;
			warp "ve_in",262,309;
			end;
		}
		mes "[阿布萨尔]";
		mes "当然。我反正没告诉他";
		mes "我需要什么材料。嘿嘿！现在，";
		mes "我要你带来这些东西。";
		mes "听好了，明白吗？快点。";
		mes "";
		next;
		mes "[阿布萨尔]";
		mes "^4D4DFF5 个食人树根^000000、";
		mes "^4D4DFF2 个冰心^000000和";
		mes "^4D4DFF5 个钢铁^000000。你不快点回来，";
		mes "我就不会帮你。我还有";
		mes "正在进行的项目！";
		mes "";
		set veins_stone,2;
		close;
	}
	else if (veins_stone == 2) {
		if (countitem(999) > 4 && countitem(1033) > 4 && countitem(7561) > 1) {
			mes "[阿布萨尔]";
			mes "很好，你终于";
			mes "把东西全带来了。";
			mes "我正要放弃你了，";
			mes "所以算你走运！";
			mes "";
			next;
			mes "[阿布萨尔]";
			mes "给我一点时间。";
			mes "你不用等很久，";
			mes "就能看到";
			mes "我的伟大发明！";
			delitem 999,5; //Steel
			delitem 1033,5; //Root_Of_Maneater
			delitem 7561,2; //Ice_Heart
			set veins_stone,3;
			close2;
			specialeffect EF_FIRESPLASHHIT;
			end;
		}
		mes "[阿布萨尔]";
		mes "搞什么鬼？";
		mes "快把";
		mes "^4D4DFF5 个食人树根^000000、";
		mes "^4D4DFF2 个冰心^000000和";
		mes "^4D4DFF5 个钢铁^000000带来！你以为";
		mes "我是在玩吗？！";
		close;
	}
	else if (veins_stone == 3) {
		mes "[阿布萨尔]";
		mes "给你……";
		mes "我不知道你是否欣赏";
		mes "发明，但这就是";
		mes "触觉伸缩";
		mes "夹具释放";
		mes "机构！";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "触……什么……？";
		next;
		mes "[阿布萨尔]";
		mes "...............................";
		mes "你可以用这个";
		mes "从远处捡起东西。";
		next;
		mes "[阿布萨尔]";
		mes "总之，你回去见扎巴鲁时，";
		mes "告诉他他不再欠我";
		mes "任何东西了。他会……";
		mes "他会明白我的意思……";
		mes "";
		set veins_stone,4;
		close;
	}
	mes "[阿布萨尔]";
	mes "是‘触觉伸缩";
	mes "夹具释放机构’。";
	mes "这有什么难理解的？";
	mes "哼！我知道了！";
	mes "一定是教育";
	mes "制度的问题！都怪他们！";
	close;
}

ve_in02,37,28,4	script	Factory Manager	898,{
	if (veins_stone && veins_stone < 5) {
		mes "[米伦]";
		mes "嘿，这里只有员工可以进入！";
		mes "天啊，我们没有写着这句话的标牌吗？";
		mes "我们应该弄一个……";
		mes "总之，离开这里。";
		close2;
		warp "veins",269,221;
		end;
	}
	else if (veins_stone == 5) {
		mes "[米伦]";
		mes "嘿，这里只有员工";
		mes "可以进入！";
		mes "天啊，我们没有";
		mes "写着这句话的标牌吗？";
		mes "我们应该弄一个……";
		mes "总之，离开这里。";
		next;
		if (select("对不起。:我带来了这些……") == 1) {
			mes "[米伦]";
			mes "你很抱歉，";
			mes "我明白了。嗯……";
			mes "你还不离开吗？";
			close;
		}
		mes "[米伦]";
		mes "嗯？这个姓名";
		mes "标签？扎巴鲁？等等……";
		mes "你肯定不是他！";
		next;

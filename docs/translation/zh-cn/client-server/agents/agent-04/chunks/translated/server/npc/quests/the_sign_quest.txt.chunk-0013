
-	script	Soldier#s11_	-1,{
	callfunc "F_UpdateSignVars";
	mes "[Maruin]";
	if (sign_q < 49) {
		mes "欢迎来到";
		mes "普隆德拉城堡。";
		mes "请小心";
		mes "别迷路了。";
		next;
		mes "[Maruin]";
		mes "哎呀……";
		mes "我好累啊~！";
		mes "简直精疲力竭~";
		mes "要是能有点";
		mes "提神的东西就好了……";
		close;
	}
	else if (sign_q == 49) {
		if ((countitem(7044) < 1) && (countitem(7183) < 1)) {
			mes "欢迎来到";
			mes "普隆德拉城堡。";
			mes "请小心";
			mes "别迷路了。";
			next;
			mes "[Maruin]";
			mes "哎呀……";
			mes "我好累啊~！";
			mes "简直精疲力竭~";
			mes "要是能有点";
			mes "提神的东西就好了……";
			close;
		}
		else {
			mes "欢迎来到";
			mes "普隆德拉城堡。";
			mes "请小心";
			mes "别迷路——";
			next;
			mes "[Maruin]";
			mes "那是什么？";
			mes "你是来找";
			mes "我妹妹的？呃，发生了";
			mes "什么事吗……？";
			next;
			select("糟糕，她让你送来了生日礼物。");
			mes "[Maruin]";
			mes "生日……？";
			mes "你在说什——";
			mes "哦，今天是我的生日。";
			mes "哈！我完全忘了！";
			next;
			mes "[Maruin]";
			mes "谢谢你大老远";
			mes "跑到这里来";
			mes "给我送礼物！";
			mes "哇，我真想知道她";
			mes "今年送了我什么？";
			next;
			emotion ET_SURPRISE;
			mes "[Maruin]";
			mes "这、这是——！";
			mes "哦，糟糕。对了。";
			mes "她一直担心";
			mes "我最近太累了。不过";
			mes "她知道";
			mes "维戈格拉到底是什么吗……？";
			next;
			mes "[Maruin]";
			mes "算了，重要的是";
			mes "她的心意。";
			mes "不过说真的，这东西";
			mes "我也不是非要不可。";
			mes "我的意思是，我有，你懂的，";
			mes "女朋友——你懂我意思。";
			next;
			mes "[Maruin]";
			mes "我想回报你";
			mes "但我正在执勤，";
			mes "所以只能";
			mes "帮你恢复体力。";
			mes "按规定我不该这么做，";
			mes "但没人会说什么。";
			delitem 7044,1; //Vigorgra
			delitem 7183,1; //Sister_Letter
			set sign_q,50;
			percentheal 100,100;
			next;
			mes "[Maruin]";
			mes "好吧，谢谢你的";
			mes "信和";
			mes "男性补充剂吧。";
			mes "我会给我妹妹捎个口信。";
			mes "祝你旅途";
			mes "顺利，好吗？";
			close;
		}
	}
	else if (sign_q == 97 || sign_q == 98) {
		mes "欢迎来到";
		mes "普隆德拉城堡。";
		mes "请小心";
		mes "别迷路了。";
		next;
		mes "[Maruin]";
		mes "哎呀……";
		mes "我好累啊~！";
		mes "简直精疲力竭~";
		mes "要是能有点";
		mes "提神的东西就好了……";
		close;
	}
	else {
		mes "哦，嗨，最近";
		mes "过得怎么样？谢谢你";
		mes "再次帮助";
		mes "我妹妹，我们";
		mes "真的非常感激。";
		if (Sex == SEX_MALE) {
			if (rand(1,5) == 5) {
				next;
				mes "[Maruin]";
				mes "哦……";
				mes "只告诉你我一个人，";
				mes "那个维戈格拉";
				mes "真的很有用！";
				mes "那东西太神奇了！";
			}
		}
		close;
	}
}

alde_alche,169,162,7	script	Alchemist#sign	749,{
	callfunc "F_UpdateSignVars";
	mes "[Melkaba]";
	if (sign_q < 46) {
		mes "大多数炼金术士都在寻找";
		mes "贤者之石，但在我看来，他们的目标太过短浅。还有更重要的研究";
		mes "值得为了科学和人类福祉而进行……";
		next;
		switch(select("……：那么你在研究什么？")) {
		case 1:
			mes "[Melkaba]";
			mes "说到底，";
			mes "贤者之石可能";
			mes "只是个简单的传闻。";
			mes "毕竟，成千上万的";
			mes "炼金术士已经";
			mes "尝试制造它却失败了。";
			close;
		case 2:
			mes "[Melkaba]";
			mes "我在研究什么？";
			mes "嗯，我的专长是……";
			mes "不一样的。你非要";
			mes "知道的话，这是秘密~";
			mes "要是有人知道";
			mes "我的研究……";
			close;
		}
	}
	else if (sign_q == 46) {
		mes "呃……？";
		mes "你需要什么？";
		mes "如果不重要，";
		mes "请离开我的";
		mes "实验室！";
		next;
		switch(select("维戈格拉？：哦，对不起。")) {
		case 1:
			mes "[Melkaba]";
			mes "什么？！谁告诉你";
			mes "我能做那个的？！";
			mes "哦，算了。我想";
			mes "你是想让我准备一些。";
			mes "现在告诉我……";
			mes "你为什么想要它？";
			next;
			switch(select("不，我不要！：我需要维戈格拉……给一个朋友。")) {
			case 1:
				mes "[Melkaba]";
				mes "你这个不成熟的家伙——！";
				mes "你大老远跑来";
				mes "就是为了烦我？";
				mes "别把你的";
				mes "丢脸事带到我的实验室！";
				close;
			case 2:
				mes "[Melkaba]";
				mes "哦，对了。";
				mes "你的朋友。";
				mes "我明白了。";
				mes "完全明白。";
				next;
				mes "[Melkaba]";
				mes "既然你知道";
				mes "我的秘密研究，";
				mes "只要你不告诉别人，我就帮你个忙！";
				mes "";
				mes "当然，我不能免费";
				mes "给你维戈格拉……";
				next;
				mes "[Melkaba]";
				mes "现在记下来，";
				mes "这些是我需要的";
				mes "材料，用来";
				mes "制作一瓶维戈格拉。";
				next;
				mes "[Melkaba]";
				mes "^ff00001薄荷";
				mes "20蜂蜜";
				mes "10蜂王浆";
				mes "30熊掌皮";
				mes "1希纳蕾叶片";
				mes "1空瓶。^000000";
				next;
				mes "[Melkaba]";
				mes "好了。";
				mes "现在去";
				mes "把这些";
				mes "材料带来。我会";
				mes "稍后再见。";
				set sign_q,47;
				close;
			}
		case 2:
			mes "[Melkaba]";
			mes "不用";
			mes "道歉。不过";
			mes "如果你能让我";
			mes "安静工作，";
			mes "我会很感激。";
			close;
		}
	}
	else if (sign_q == 47) {
		mes "嗯……";
		mes "那么你是否";
		mes "带齐了";
		mes "制作";
		mes "维戈格拉所需的一切……？";
		next;
		switch(select("还没有……：是的。")) {
		case 1:
			mes "[Melkaba]";
			mes "好吧，让我";
			mes "提醒你";
			mes "需要";
			mes "带给我的东西，以免";
			mes "你已经忘了……";
			next;
			mes "[Melkaba]";
			mes "^ff00001薄荷";
			mes "20蜂蜜";
			mes "10蜂王浆";
			mes "30熊掌皮";
			mes "1希纳蕾叶片";
			mes "1空瓶。^000000";
			next;
			mes "[Melkaba]";
			mes "慢慢来……";
			mes "反正最后，";
			mes "有需要的";
			mes "是你自己。";
			close;
		case 2:
			mes "[Melkaba]";
			mes "太好了……！";
			mes "现在让我检查";
			mes "你是否已经";
			mes "准备好了一切……";
			next;
			mes "[Melkaba]";
			if ((countitem(526) < 10) || (countitem(518) < 20) || (countitem(948) < 30) || (countitem(520) < 1) || (countitem(708) < 1) || (countitem(713) < 1)) {
				mes "嗯，你还";
				mes "缺少一些";
				mes "材料。听好了，";
				mes "我需要你取得……";
				next;
				mes "[Melkaba]";
				mes "^ff00001薄荷";
				mes "20蜂蜜";
				mes "10蜂王浆";
				mes "30熊掌皮";
				mes "1希纳蕾叶片";
				mes "1空瓶。^000000";
				close;
			}
			else {
				mes "干得好。";
				mes "东西都齐了。";
				mes "好吧，就这一次";
				mes "我会为你制作一瓶";
				mes "维戈格拉。";
				next;
				mes "[Melkaba]";
				mes "如果你再来问我，";
				mes "我不会再理你！";
				mes "而且我要收取";
				mes "10000 Zeny。";
				next;
				mes "[Melkaba]";
				if (Zeny < 10000) {
					mes "嗯……";
					mes "看来你";
					mes "没有足够的Zeny";
					mes "现在也没关系，";
					mes "我可以等你";
					mes "把钱带来。";
				}
				else {
					mes "好吧，我现在";
					mes "收取你的费用。";
					mes "考虑到维戈格拉的";
					mes "诸多好处，";
					mes "这并不算";
					mes "昂贵。";
					next;
					mes "^3355FF梅尔卡巴把";
					mes "所有材料";
					mes "放入试管，";
					mes "开始通过一些奇怪的";
					mes "电子设备";
					mes "进行处理。^000000";
					next;
					mes "……";
					mes "…………";
					next;
					mes "……";
					mes "…………";
					mes "………………";
					next;
					mes "[Melkaba]";
					if (rand(1,100) < 98) {
						specialeffect EF_PHARMACY_OK;
						mes "啊！成功了！";
						mes "足够一辈子用的";
						mes "维戈格拉！我知道这只是";
						mes "一瓶，但这东西";
						mes "药效非常强！";
						next;
						set Zeny, Zeny-10000;
						delitem 526,10; //Royal_Jelly
						delitem 518,20; //Honey
						delitem 948,30; //Bear's_Foot
						delitem 520,1; //Leaflet_Of_Hinal
						delitem 708,1; //Ment
						delitem 713,1; //Empty_Bottle
						set sign_q,48;
						getitem 7044,1; //Vigorgra
						mes "[Melkaba]";
						mes "嗯，记住";
						mes "一次不要服用太多";
						mes "可不能让你";
						mes "血压";
						mes "飙升~";
						close;
					}
					else {
						specialeffect EF_PHARMACY_FAIL;
						delitem 526,10; //Royal_Jelly
						delitem 518,20; //Honey
						delitem 948,30; //Bear's_Foot
						delitem 520,1; //Leaflet_Of_Hinal
						delitem 708,1; //Ment
						delitem 713,1; //Empty_Bottle
						mes "失败了？！";
						mes "当然，混合物";
						mes "太剧烈了，甚至";
						mes "机器也承受不住！抱歉，";
						mes "你能再把材料";
						mes "带来制作维戈格拉吗？";
						close;
					}
				}
			}
		}
	}
	else if (sign_q == 97) {
		mes "大多数炼金术士都在寻找";
		mes "贤者之石，但在我看来，他们的目标太过短浅。还有更重要的研究";
		mes "值得为了科学和人类福祉而进行……";
		next;
		switch(select("……：那么你在研究什么？")) {
		case 1:
			mes "[Melkaba]";
			mes "说到底，";
			mes "贤者之石可能";
			mes "只是个简单的传闻。";
			mes "毕竟，成千上万的";
			mes "炼金术士已经";
			mes "尝试制造它却失败了。";
			close;
		case 2:
			mes "[Melkaba]";
			mes "我在研究什么？";
			mes "嗯，我的专长是……";
			mes "不一样的。你非要";
			mes "知道的话，这是秘密~";
			mes "要是有人知道";
			mes "我的研究……";
			close;
		}
	}
	else if (sign_q == 98) {
		mes "大多数炼金术士都在寻找";
		mes "贤者之石，但在我看来，他们的目标太过短浅。还有更重要的研究";
		mes "值得为了科学和人类福祉而进行……";
		next;
		switch(select("……：那么你在研究什么？")) {
		case 1:
			mes "[Melkaba]";
			mes "说到底，";
			mes "贤者之石可能";
			mes "只是个简单的传闻。";
			mes "毕竟，成千上万的";
			mes "炼金术士已经";
			mes "尝试制造它却失败了。";
			close;
		case 2:
			mes "[Melkaba]";
			mes "我在研究什么？";
			mes "嗯，我的专长是……";
			mes "不一样的。你非要";
			mes "知道的话，这是秘密~";
			mes "要是有人知道";
			mes "我的研究……";
			close;
		}
	}
	else {
		mes "维戈格拉是";
		mes "现代科学的";
		mes "奇迹，";
		mes "但如果不小心，";
		mes "它造成的伤害可能";
		mes "大于益处！";
		close;
	}
}

alberta_in,114,178,5	script	Refined Steward	109,{
	callfunc "F_UpdateSignVars";
	mes "[Mahatra]";
	if (sign_q < 37) {
		mes "欢迎来到 the";
		mes "阿尔切斯宅邸。";
		mes "阿尔切斯家族是";
		mes "阿尔伯特";
		mes "最受尊敬的家族。";
		next;
		mes "[Mahatra]";
		mes "我是马哈特拉·莫尔南，";
		mes "这个家族的管家。";
		mes "有需要尽管问我，";
		mes "我会";
		mes "尽力";
		mes "帮助你。";
		close;
	}
	else if (sign_q == 37) {
		mes "啊，是的，主人告诉我";
		mes "你会负责";
		mes "一项紧急递送任务。请把它交给";
		mes "一位名叫";
		mes "^3355FFLeibech^000000的人。";
		next;
		mes "[Mahatra]";
		mes "找到他可能很难，";
		mes "因为他";
		mes "周游世界。";
		mes "啊，我听说";
		mes "他人在某个其他国家……";
		next;
		mes "[Mahatra]";
		mes "现在我要给你的物品";
		mes "是";
		mes "独一无二的。别弄丢";
		mes "否则你会失去主人宠爱……";
		next;
		mes "^3355FF马哈特拉给了你";
		mes "一块独特的石头，上面";
		mes "刻着你的名字。^000000";
		set sign_q,38;
		getnameditem 7049,strcharinfo(0);
		close;
	}
	else if (sign_q == 38 || (sign_q == 39 && countitem(7181) < 1)) {
		mes "你还没把";
		mes "石头送到吗？请";
		mes "好好保管，它非常";
		mes "稀有。别使用或弄丢它。";
		mes "在送达之前！";
		mes "现在请保重……";
		close;
	}
	else if (sign_q == 39) {
		mes "啊，你回来了。";
		mes "看来你已经";

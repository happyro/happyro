1@exsh,90,148,3	script(CLOAKED)	Hyunrok#sh1	4_EXJOB_HYUN_ROK,{
	if ('step == 6) {
		setpcblock( PCBLOCK_NPC, true );
		.@npc_a$ = instance_npcname("Chulho#sh_c2");
		.@npc_b$ = instance_npcname("Kisul#sh_k2");
		.@npc_c$ = instance_npcname("??????#sh_y2");
		.@npc_d$ = instance_npcname("Kwang Saeng#sh_t2");
		.@npc_e$ = instance_npcname("Admiral Lee Daegam#sh_y2");

		npctalk "玄禄：哲虎、基瑟尔，你们回来了。";
		cutin "ex_sh_hyunrok01.png",2;
		cloakoffnpc( .@npc_a$ );
		cloakoffnpc( .@npc_b$ );
		sleep2 2000;
		npctalk "哲虎：原来你在这里！", .@npc_a$;
		emotion ET_BLABLA, getnpcid(0,.@npc_a$);
		cutin "ex_sh_chulho01.png",2;
		sleep2 2000;
		npctalk "哲虎：我找你很久了！", .@npc_a$;
		sleep2 2000;
		npctalk "玄禄：我想我只离开了一会儿。";
		cutin "ex_sh_hyunrok01.png",2;
		sleep2 2000;
		npctalk "玄禄：但你旁边的那个人是……？";
		sleep2 2000;
		npctalk "玄禄：你怎么进到这里的？";
		sleep2 2000;
		npctalk "哲虎：你在说什么！", .@npc_a$;
		emotion ET_SMILE, getnpcid(0,.@npc_a$);
		cutin "ex_sh_chulho01.png",2;
		sleep2 2000;
		npctalk "哲虎：这个人和我一样是老虎！", .@npc_a$;
		cutin "ex_sh_chulho03.png",2;
		emotion ET_HUK, playerattached();
		sleep2 2000;
		npctalk "玄禄：你在说什么？";
		emotion ET_PROFUSELY_SWEAT;
		cutin "ex_sh_hyunrok01.png",2;
		sleep2 2000;
		npctalk "玄禄：他不是像我们一样的森林居民，他是森林外的人，是森林外的人。";
		sleep2 2000;
		npctalk "基瑟尔：哈哈哈哈哈！!!", .@npc_b$;
		cutin "ex_sh_kisul01.png",2;
		emotion ET_SMILE, getnpcid(0,.@npc_b$);
		sleep2 2000;
		npctalk "基瑟尔：我就觉得奇怪，你竟然不知道？！", .@npc_b$;
		cutin "ex_sh_kisul02.png",2;
		sleep2 2000;
		npctalk "哲虎：什么？！", .@npc_a$;
		cutin "ex_sh_chulho02.png",2;
		emotion ET_HUK, getnpcid(0,.@npc_a$);
		sleep2 2000;
		npctalk "哲虎：他闻起来和我一样！！！", .@npc_a$;
		sleep2 2000;
		npctalk "玄禄：虽然他和你哲虎有些相似……";
		cutin "ex_sh_hyunrok01.png",2;
		sleep2 2000;
		npctalk "哲虎：啊啊啊！！！", .@npc_a$;
		cutin "ex_sh_chulho02.png",2;
		sleep2 2000;
		npctalk "玄禄：总之，我认为住在森林外的人应该回到外面去。";
		cutin "ex_sh_hyunrok01.png",2;
		sleep2 2000;
		npctalk "玄禄：那些打扰森林的人又靠近了。";
		sleep2 2000;
		npctalk "玄禄：我们不能坐视不理。";
		sleep2 2000;
		npctalk "基瑟尔：啊~", .@npc_b$;
		cutin "ex_sh_kisul01.png",2;
		sleep2 2000;
		npctalk "基瑟尔：你又想做什么麻烦事吗？", .@npc_b$;
		emotion ET_SLEEPY, getnpcid(0,.@npc_b$);
		sleep2 1000;
		cutin "",255;
		cloakoffnpc( .@npc_e$ );
		sleep2 2000;
		npctalk "李大监军：我们在哪里？", .@npc_e$;
		emotion ET_STARE_ABOUT, getnpcid(0,.@npc_e$);
		sleep2 2000;
		npctalk "李大监：光生，我觉得你走得太深了，不如把这件事交给你的仆人？", .@npc_e$;
		emotion ET_SCRATCH, getnpcid(0,.@npc_e$);
		sleep2 3000;
		npctalk "李大监军：这到底是什么！", .@npc_e$;
		emotion ET_HUK, getnpcid(0,.@npc_e$);
		sleep2 2000;
		npctalk "李大监军：野兽为什么穿着衣服？", .@npc_e$;
		sleep2 2000;
		npctalk "玄禄：你怎么能如此无礼！！！";
		cutin "ex_sh_hyunrok01.png",2;
		sleep2 2000;
		cutin "",255;
		npctalk "李大监军：糟糕！", .@npc_e$;
		emotion ET_HUK, getnpcid(0,.@npc_e$);
		sleep2 2000;
		npctalk "李大监军：长角的人！！！", .@npc_e$;
		sleep2 1000;
		cloakoffnpc( .@npc_d$ );
		sleep2 2000;
		npctalk "光生：哦！！！！", .@npc_d$;
		emotion ET_COOL, getnpcid(0,.@npc_d$);
		sleep2 2000;
		npctalk "光生：我终于找到了！！！", .@npc_d$;
		sleep2 2000;
		npctalk "光生：无人能够进入的深邃森林中的神秘野兽！！！！", .@npc_d$;
		sleep2 2000;
		npctalk "光生：能在我眼前永垂不朽的传说动物，只要切下并加工那些角！！！！", .@npc_d$;
		emotion ET_SEXY, getnpcid(0,.@npc_d$);
		sleep2 2000;
		npctalk "玄禄：退后！！！你竟敢！";
		cutin "ex_sh_hyunrok01.png",2;
		sleep2 2000;
		cutin "",255;
		npctalk "光生：嘿嘿嘿！！！", .@npc_d$;
		sleep2 2000;
		npctalk "光生：森林里的野兽阻止不了我！", .@npc_d$;
		emotion ET_KIK, getnpcid(0,.@npc_d$);
		sleep2 2000;
		npctalk "光生：因为服下我的药的动物只能听从我的命令。", .@npc_d$;
		sleep2 2000;
		npctalk "李大监：啊啊啊！！！", .@npc_e$;
		sleep2 350;
		cloakonnpc( .@npc_e$ );
		cloakoffnpc( .@npc_c$ );
		emotion ET_HUK, getnpcid(0,.@npc_a$);
		emotion ET_HUK, getnpcid(0,.@npc_b$);
		emotion ET_HUK, playerattached();
		emotion ET_SURPRISE;
		sleep2 2000;
		npctalk "??????：太过分了！！！", .@npc_c$;
		emotion ET_FRET, getnpcid(0,.@npc_c$);
		sleep2 2000;
		npctalk "玄禄：啊啊！！";
		cutin "ex_sh_hyunrok01.png",2;
		sleep2 2000;
		npctalk "玄禄：我的天！！！";
		sleep2 2000;
		npctalk "哲虎：啊啊啊！！！太恶心了！！！！！", .@npc_a$;
		emotion ET_PROFUSELY_SWEAT, getnpcid(0,.@npc_a$);
		cutin "ex_sh_chulho02.png",2;
		emotion ET_HUK, getnpcid(0,.@npc_a$);
		sleep2 2000;
		npctalk "哲虎：我也会变成那样吗！！！", .@npc_a$;
		sleep2 2000;
		npctalk "基瑟尔：冷静，待在那里。", .@npc_b$;
		cutin "ex_sh_kisul03.png",2;
		sleep2 2000;
		npctalk "基瑟尔：事情比我想象的更有趣。", .@npc_b$;
		cutin "ex_sh_kisul01.png",2;
		emotion ET_KIK, getnpcid(0,.@npc_b$);
		sleep2 2000;
		npctalk "哲虎：现在不是坐视不理的时候！", .@npc_a$;
		cutin "ex_sh_chulho02.png",2;
		sleep2 2000;
		npctalk "哲虎：如果我也变成那样的怪物怎么办！", .@npc_a$;
		sleep2 2000;
		npctalk "基瑟尔：好了，先让怪物睡着，再继续说吧。", .@npc_b$;
		cutin "ex_sh_kisul02.png",2;
		sleep2 2000;
		cloakonnpc( .@npc_a$ );
		cloakonnpc( .@npc_b$ );
		cloakonnpc( .@npc_c$ );
		cloakonnpc( .@npc_d$ );
		cutin "",255;
		setpcblock( PCBLOCK_NPC, false );
		disablenpc();
		mapannounce 'map_1exsh$, "??????：啊啊啊！！！", bc_map, 0xB7EE,FW_NORMAL,16;
		mapannounce 'map_1exsh$, "??????：呃啊！！！！", bc_map, 0xB7EE,FW_NORMAL,16;
		if ('step == 6)
			donpcevent instance_npcname("doram_job_change_mob_3") + "::OnStart";
		end;
	}
	end;
}



						mes "我好在今天的日程中查找。";
						mes "请稍等。";
						next;
						switch( select( ""+strcharinfo(0)+"" ) )
						{
							case 1:
								break;
						}
						mes "[Hes O'Neil]";
						mes ""+strcharinfo(0)+"?";
						mes "抱歉，我在名单上找不到你的名字。";
						mes "只有预约过才能拜访总统。";
						mes "感谢你的配合。";
						mes "请改日再来。";
						mes "祝你顺利。";
						close;

					case 2:
						mes "[Hes O'Neil]";
						mes "非常抱歉，但总统事务繁忙，";
						mes "只能抽时间接见预约过的人。";
						mes "请不要继续等待。";
						mes "感谢理解。";
						mes "下次再来吧。";
						close;
				}

			case 3:
				mes "[Hes O'Neil]";
				mes "这里是重要的政府建筑，";
				mes "请注意某些区域由卫兵监控，";
				mes "访客不得进入。";
				mes "请遵守规定。";
				mes "感谢配合。";
				mes "祝你愉快。";
				close;
		}
	}
	else if(lhz_boss == 16)
	{
		if(!countitem(7342))
		{
			mes "[Hes O'Neil]";
			mes "嗯？我以为总统应该给你某种文件，";
			mes "难道是我弄错了？让我想想……";
			mes "请稍等片刻。";
			mes "我会确认情况。";
			mes "不要着急。";
			close;
		}
		mes "[Hes O'Neil]";
		mes "你好，我能帮你什么吗？";
		mes "请告诉我你的需求。";
		next;
		switch( select( "I brought this." ) )
		{
			case 1:
				break;
		}
		mes "[Hes O'Neil]";
		mes "啊，这就是我需要的文件夹。";
		mes "很抱歉麻烦你，";

				mes "我最好继续";
				mes "听听还能了解什么";
				mes "……）";
				next;
				mes "[??????]";
				mes "^333333你为什么让我";
				mes "来到如此";
				mes "危险的地方……？^000000";
				next;
				mes "^3355FF那是……^000000";
				mes "那是 ^660000盖尔斯坦^3355FF 的声音！^000000";
				next;
				mes "[????]";
				mes "^666666发生了意外，";
				mes "所以计划突然改变。现在听……^000000";
				mes "";
				next;
				mes "^3355FF突然，两个";
				mes "声音变得更低，";
				mes "两个男人彼此用";
				mes "几乎听不见的沙哑低语交谈。^000000";
				mes "";
				next;
				mes "[????]";
				mes "^666666....";
				mes "……关系……";
				mes "……生意……卡普拉……^000000";
				next;
				mes "[盖尔斯坦]";
				mes "^333333哦，听起来";
				mes "非常紧急。";
				mes "但这里不适合";
				mes "讨论。";
				mes "我们去更";
				mes "安全的地方。^000000";
				next;
				mes "[????]";
				mes "^666666没问题。^000000";
				mes "........................";
				next;
				mes "........................";
				mes ".....................";
				mes "..................";
				next;
				mes "^3355FF另一个声音……";
				mes "不管属于谁，";
				mes "人已经走了！这里";
				mes "发生了什么？^000000";
				set lhz_boss,2;
				setquest 12015;
				close;
		}
	}
}
yuno_fild04,165,245,4	script	Dismal Guy	4_M_ORIENT02,{
	if(lhz_boss < 8)
	{
		mes "[古沙尔]";
		mes "选择，选择。";
		mes "有时很难做决定，";
		mes "当你不清楚哪一个";
		mes "能带来最大收益时。";
		mes "";
		next;
		mes "[古沙尔]";
		mes "我认为生活中的大多数好事";
		mes "都有代价，";
		mes "但通常值得。";
		mes "我的意思是，";
		mes "没有代价的东西";
		mes "就没有价值，对吧？";
		close;
	}
	else if(lhz_boss == 8)
	{
		mes "[古沙尔]";
		mes "好吧，选择";
		mes "你的“毒药”。我有";
		mes "两种不同";
		mes "红蓝药剂。你要喝哪种？";
		mes "";
		next;
		switch( select( "????","Red Tonic","Blue Tonic" ) )
		{
			case 1:
				mes "[古沙尔]";
				mes "不做决定就不会";
				mes "采取行动。";
				mes "而不行动就什么都不会发生。";
				mes "";
				mes "";
				mes "来吧，别无聊～";
					close;
				case 2:
				mes "[古沙尔]";
				mes "红色吗？我喜欢";
				mes "你的风格。不过，";
				mes "是不是有东西";
				mes "想先给我看看？";
				next;
						switch( select( "哦，对了！","你在说什么？" ) )
				{
					case 1:
						if(!countitem(7348))
						{
							mes "[古沙尔]";
							mes "嘿……嗯……";
							mes "你不是应该带着";
							mes "某种秘密物品吗？";
							mes "如果不是秘密，我早就告诉你是什么了。";
							mes "别再装糊涂。";
							mes "快拿出来吧。";
							close;
						}
						mes "^3355FF你潇洒地亮出会员卡，";
						mes "古沙尔满意地点了点头。^000000";
						mes "看来身份得到了确认。";
						mes "接下来等待指示。";
						next;
						mes "[古沙尔]";
						mes "对，就是这个。很好，";
						mes "你就是我一直在等的人。";
						mes "好，给我一点时间……";
						mes "我马上说明任务。";
						mes "请耐心等待。";
						set lhz_boss,9;
						close;
					case 2:
						mes "[古沙尔]";
						mes "什么？！天啊，我差点犯了大错。";
						mes "抱歉，我以为你是别人。";
						mes "请不要介意。";
						mes "我会重新确认身份。";
						close;
				}

			case 3:
				mes "[古沙尔]";
				mes "蓝色的……？嗯。";
				mes "这应该不是你要的那张。";
				mes "不过，如果你真是我想的那个人……是吗？";
				mes "请再确认一下。";
				mes "别拿错了。";
				close;
		}
	}
	else if(lhz_boss == 9)
	{
		mes "[古沙尔]";
		mes "首先，你应该知道雷根贝勒公司为什么是我们的死敌。";
		mes "你知道它实际上控制着施瓦茨瓦尔德共和国吗？";
		mes "这是我们行动的根本原因。";
		mes "请牢记这一点。";
		mes "不要低估他们。";
		mes "他们非常危险。";
		next;
		mes "[古沙尔]";
		mes "他们强大到操纵经济、媒体甚至国家政治。";
		mes "当然还有其他公司，但与他们相比根本不值一提。";
		mes "他们控制了一切。";
		mes "人民只能被迫服从。";
		mes "我们必须改变现状。";
		mes "这就是我们的使命。";
		next;
		mes "[古沙尔]";
		mes "雷根贝勒公司……";
		mes "他们甚至通过贿赂政客，";
		mes "让其他公司都受其控制，";
		mes "推动他们想要的法案。";
		mes "这根本不是一个真正的共和国……";
		mes "人民没有选择。";
		next;
		mes "[古沙尔]";
		mes "我们组织‘秘密之翼’的最终目标，";
		mes "是摧毁雷根贝勒公司，";
		mes "让施瓦茨瓦尔德共和国";
		mes "真正实现独立。";
		mes "这是艰巨的任务。";
		mes "但我们绝不会放弃。";
		next;
		mes "[古沙尔]";
		mes "幸运的是，施瓦茨瓦尔德共和国的新总统魏尔斯特拉斯先生支持我们的事业。";
		mes "他正与我们合作发动革命，";
		mes "推翻雷根贝勒公司。";
		mes "我们必须谨慎行动。";
		mes "任何失误都可能带来灾难。";
		mes "请牢记这一点。";
		next;
		mes "[古沙尔]";
		mes "你的任务是拜访总统，";
		mes "带回他掌握的任何情报。";
		mes "记住，由于他的身份，";
		mes "你只能在指定时间见到他。";
		mes "务必遵守时间。";
		mes "不要引起怀疑。";
		set lhz_boss,10;
		close;
	}
	else if(lhz_boss == 10)
	{
		mes "[古沙尔]";
		mes "我希望你现在明白‘秘密之翼’的最终目标。";
		mes "无论如何，你必须见到总统";
		mes "卡尔·特奥多尔·魏尔斯特拉斯。";
		mes "这是非常重要的任务。";
		mes "不要失败。";
		next;
		mes "[古沙尔]";
		mes "要见这样重要的人并不容易，";
		mes "把秘密之翼会员卡交给他的秘书，";
		mes "这样应该不会遇到太多麻烦。";
		mes "保持礼貌。";
		mes "不要泄露组织信息。";
		mes "这点非常重要。";
		next;
		mes "[古沙尔]";
		mes "由于他的日程安排，";
		mes "你只能在^FF0000晚上 8 点到 11 点^000000，";
		mes "以及^FF0000上午 11 点到下午 2 点（PST）^000000见他。";
		mes "朋友，祝你任务顺利。";
		mes "现在出发吧。";
		set lhz_boss,11;
		changequest 12017,12018;
		close;
	}
	else
	{
		mes "[古沙尔]";
		mes "雷根贝勒……";
		mes "我一定会亲眼看着你毁灭，";
		mes "哪怕这是我最后要做的事！";
		mes "绝不原谅你们。";
		close;
	}
}
yuno_pre,69,20,4	script	Secretary#1	4_F_LGTGIRL,{
	if(lhz_boss < 11)
	{
		mes "[Hes O'Neil]";
		mes "您好，我能为您做什么？";
		mes "请说明来意。";
		next;
		switch( select( "Oh. I'm fine, thanks.","I want to meet the president~","W-who are you...?" ) )
		{
			case 1:
				mes "[Hes O'Neil]";
				mes "这里是重要的政府建筑，";
				mes "请注意某些区域由卫兵监控，";
				mes "访客不得进入。";
				mes "请遵守规定。";
				mes "感谢配合。";
				mes "祝你愉快。";
				close;

			case 2:
				mes "[Hes O'Neil]";
				mes "魏尔斯特拉斯总统？";
				mes "你今天预约了会面吗？";
				mes "请出示预约信息。";
				next;
				switch( select( "Yes","No" ) )
				{
					case 1:
						mes "[Hes O'Neil]";
						mes "好的，让我查一下。";
						mes "请告诉我你的名字，";
						mes "我好在今天的日程中查找。";
						mes "请稍等。";
						next;
						switch( select( ""+strcharinfo(0)+"" ) )
						{
							case 1:
								break;
						}
						mes "[Hes O'Neil]";
						mes ""+strcharinfo(0)+"?";
						mes "抱歉，我在名单上找不到你的名字。";
						mes "只有预约过才能拜访总统。";
						mes "感谢你的配合。";
						mes "请改日再来。";
						mes "祝你顺利。";
						close;

					case 2:
						mes "[Hes O'Neil]";
						mes "非常抱歉，但总统事务繁忙，";
						mes "只能抽时间接见预约过的人。";
						mes "请不要继续等待。";
						mes "感谢理解。";
						mes "下次再来吧。";
						close;
				}

			case 3:
				mes "[Hes O'Neil]";
				mes "嗯……？";
				mes "我是施瓦茨瓦尔德共和国总统的";
				mes "私人秘书，";
				mes "如果你是这个意思的话。";
				mes "有什么事吗？";
				mes "请说明来意。";
				close;
		}
	}
	else if(lhz_boss < 16)
	{
		mes "[Hes O'Neil]";
		mes "您好，我能为你做什么？";
		mes "请说明来意。";

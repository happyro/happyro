ba_maison,357,291,3	script	Cleaning Robot#jh5_1	4_EP17_CLEANER_W,{
	if (isbegin_quest(16453) == 1) {
		cutin "ep172_omega",2;
		mes "- 接待区稍远处，一台清洁机器人瘫在阴影里。它似乎已经在这里很久了。-";
		next;
		mes "- 我把它翻过来，发现它因卡着一个小纸信封而停止。 -";
		next;
		mes "- 信封上是雷根贝勒的图案吗？这些东西为什么在这里？-";
		next;
		mes "- 我小心取出信封，避免撕破。 -";
		close2;
		cutin "",255;
		erasequest 16453;
		end;
	}
	cutin "ep172_omega",2;
	mes "- ......? -";
	close3;

OnInit:
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "isbegin_quest(16453) == 1" );
	end;
}

ba_maison,106,65,0	script	#ep172_main_evt01	HIDDEN_WARP_NPC,3,3,{
	end;
OnTouch:
	if (ep17_2_main == 25) {
		cloakoffnpcself( "Rookie#ep172_m_rk01" );
		cloakoffnpcself( "Manager#ep172_m_ap0" );
		end;
	}
	end;
}

ba_maison,116,67,5	script(CLOAKED)	Rookie#ep172_m_rk01	4_M_ROOKIE,{
	if (ep17_2_main == 25) {
		setpcblock PCBLOCK_NPC, true;
		sleep2 2000;
		npctalk "期待你的合作。", "Manager#ep172_m_ap0", bc_self;
		sleep2 2000;
		cloakonnpcself( "Manager#ep172_m_ap0" );
		setpcblock PCBLOCK_NPC, false;
		select( "怎么了？" );
		cutin "16loo_01",0;
		mes "[Rookie]";
		mes "是关于宅邸里的入侵者。";
		mes "另一位宅邸管理员也被心灵猎手损坏了。";
		next;
		mes "[Rookie]";
		mes "这次也是通信先中断，管理员一定在安保人员察觉前就遭到了攻击。";
		next;
		cutin "16loo_03",0;
		mes "[Rookie]";
		mes "Alpha 说我们可以修好任何损坏的东西，但还有更大的问题……";
		next;
		mes "[Rookie]";
		mes "被黑客入侵的自动人偶会立即与网络断开以防止污染，前提是 Alpha 拥有强大信号。";
		next;
		mes "[Rookie]";
		mes "连识别码也损坏了。";
		mes "Alpha 说我们必须对付那种自动人偶。";
		next;
		mes "[Rookie]";
		mes "如果有自动人偶攻击我们，我们当然会消灭它。";
		mes "Alpha 要我带回它的‘核心’。";
		next;
		select( "Core?" );
		cutin "16loo_01",0;
		mes "[Rookie]";
		mes "就是它们胸口的那个。我想这是修复自动人偶的唯一方法。";
		mes "如果能回收核心，我会很高兴……";
		next;
		mes "[Rookie]";
		mes "那些人到底什么时候来？";
		mes "我有点沮丧，因为一个幻影成员都没找到。";
		next;
		mes "[Rookie]";
		mes "白天找不到他们藏在哪里……";
		mes "我想他们日落后才行动，但各方面都遇到了麻烦。";
		next;
		mes "[Rookie]";
		mes "总之，Alpha 说我们必须处理无法识别识别码的自动机器人并回收核心。";
		mes "你愿意和我一起去吗？";
		next;
		cloakoffnpcself( "Elyumina#ep172_m_el01" );
		cloakoffnpcself( "Rebellion#ep172_m_rb01" );
		sleep2 200;
		npctalk "新兵，你在哪里！！原来你在这里！！", "Elyumina#ep172_m_el01", bc_self;
		sleep2 1500;
		npctalk "惊喜！", "", bc_self;
		cutin "ep171_elyumina02",2;
		mes "[Elyumina]";
		mes "那些家伙真疯狂！你到底为什么要这样对我？叛徒？你这个叛徒？";
		mes "你觉得被敌人称为叛徒是对的吗？";
		next;
		cutin "16loo_03",0;
		mes "[Rookie]";
		mes "嗯……Mina？你能不咬人就和别人说话吗？";
		mes "我听不懂你说什么？你刚才说的是人类语言吗？";
		next;
		cutin "ep171_elyumina02",2;
		mes "[Elyumina]";
		mes "哈！就是这样吗？";
		mes "嘿，你为什么总把我一个人留下？";
		mes "即使我刻薄又爱讽刺，也别丢下我！拜托，你明白吗？";
		next;
		cutin "",255;
		select( "发生了什么？" );
		mes "[Rebellion]";
		mes "送餐来的管理员突然改变了，攻击了 Elyumina。";
		mes "幸运的是，我在客人名单上，管理员立刻恢复了正常状态，";
		next;
		mes "[Rebellion]";
		mes "管理员用手中的托盘狠狠打中 Elyumina 的头，发出巨响。";
		npctalk "我还以为你看见生菜飞向你了。", "Rebellion#ep172_m_rb01", bc_self;
		next;
		cutin "16loo_02",0;
		mes "[Rookie]";
		mes "我从 Alpha 那里听过类似的故事，没想到竟然是你。";
		mes "如果你在事件发生后马上告诉我就好了。";
		mes "你还好吗？";
		next;
		cutin "ep171_elyumina02",2;
		mes "[Elyumina]";
		mes "很好？你亲身经历过吗？那还不是全部！你这个没心没肺的混蛋！";
		mes "还有那个打扫花园的管理员，突然袭击了我！";
		mes "它一直说‘杀了叛徒’！";
		npctalk "你这个混蛋，我的安全怎么办！", "Elyumina#ep172_m_el01", bc_self;
		next;
		cutin "16loo_02",0;
		mes "[Rookie]";
		mes "啊哈哈哈……别太激动，总之。";
		mes "我正要去检查，看，这位冒险者会和我一起去。";
		next;
		mes "[Rookie]";
		mes "我们要回收 Alpha 提到的被入侵管理员的核心。";
		mes "你为什么不回去和其他反叛军待在一起？";
		npctalk "我总有事情要做！", "Rebellion#ep172_m_rb01", bc_self;
		next;
		cutin "ep171_elyumina03",2;
		mes "[Elyumina]";
		mes "你，我现在要回去了。";
		mes "别空手回来，听见了吗！";
		mes "我得找个安全的地方！";
		next;
		cloakonnpcself( "Elyumina#ep172_m_el01" );
		cloakonnpcself( "Rebellion#ep172_m_rb01" );
		cutin "16loo_02",0;
		mes "[Rookie]";
		mes "没办法。我担心 Elyumina 的安全。";
		mes "我也担心 Alpha 提到的那些失去识别码的管理员。";
		next;
		mes "[Rookie]";
		mes "我们先回收核心吧？如果找到‘损坏的管理员’，就回收它的核心。";
		next;
		mes "[Rookie]";
		mes "我去北部区域查看，你可以检查南部区域。";
		next;
		mes "[Rookie]";
		mes "我们在道路东端的湖边集合并完成任务。";
		mes "那么，我先出发了。";
		ep17_2_main = 26;
		setquest 18002;
		close2;
		cutin "",255;
		cloakonnpcself();
		end;
	}
	end;

OnInit:
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "ep17_2_main == 25" );
	end;
}

ba_maison,118,68,3	duplicate(dummy_cloaked_npc)	Manager#ep172_m_ap0	4_EP17_MASTER_A

ba_maison,303,141,3	script	Elena Bolkova#ep172_eln	4_F_ELENA,{
	if (checkweight(1000103,10) == 0) {
		mes "你携带的物品太多，无法继续任务。";
		mes "请清理背包后再试。";
		close;
	}
	if (ep17_2_main == 27) {
		cutin "162elena_01",2;
		mes "[Elena Bolkova]";
		mes "嘿，冒险者，这边来。你找到什么结果了吗？";
		next;
		select( "为什么，Elena？" );
		cutin "162elena_02",2;
		mes "[Elena Bolkova]";
		mes "Lucky 请我帮个忙。";
		mes "Elyumina 似乎又遭到攻击。";
		mes "当时我碰巧在附近，不知怎么把她从困境中救了出来。";
		next;
		select( "把核心展示给她。" );
		cutin "162elena_01",2;
		mes "[Elena Bolkova]";
		mes "你发现什么异常了吗？";
		mes "我已经搜查了宅邸许多地方，但都一无所获。";
		next;
		mes "[Elena Bolkova]";
		mes "什么，你也是这样吗？";
		mes "这些家伙怎么避开我们的眼睛，不断制造麻烦？";
		mes "真让人烦。";
		close2;
		sleep2 1000;
		cutin "",255;
		setpcblock PCBLOCK_NPC, true;

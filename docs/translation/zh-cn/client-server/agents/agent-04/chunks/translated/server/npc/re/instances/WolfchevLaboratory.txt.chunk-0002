// Instance Creation
//============================================================
lhz_dun04,151,276,3	script	Researcher#memo	4_LGTSCIENCE,{
	if ((MaxWeight - Weight) < 1000 || !checkweight(1201, 1)) {
		mes "^FF0000你拥有太多物品，无法继续。^000000";
		close;
	}
	.@quest_time = checkquest(5112, PLAYTIME);
	.@killed_bosses = true;
	for(.@quest_id = 5113; .@quest_id <= 5125; .@quest_id++) {
		if (checkquest(.@quest_id, HUNTING) <= 1)
			.@killed_bosses = false;
	}
	if (lght_duk01 < 6) {
		mes "[Researcher]";
		mes "什么！你来这里有事吗？";
		next;
		if (select("有事！！", "呃……没有……") == 1) {
			mes "[Researcher]";
			mes "别再盯着别人的实验室看，走你的路吧。";
			close;
		}
		mes "[Researcher]";
		mes "别在这里徘徊，走吧。好吗？咳咳。";
		close;
	} else if (lght_duk01 == 6) {
		mes "看来实验生物无法靠近实验室，就像沃尔切夫说的。";
		next;
		mes "["+ strcharinfo(0) +"]";
		mes "嘿，有办法阻止那些生物吗？你应该知道些什么，毕竟是你制造了它们！";
		next;
		mes "[Wolfchev]";
		mes "呃……我没想到它们会那样失控……";
		next;
		mes "[Wolfchev]";
		mes "这一切到底怎么回事？";
		next;
		mes "[Wolfchev]";
		mes "呃……我觉得它们会毁掉我的整个实验室！";
		next;
		emotion ET_BLABLA, playerattached();
		mes "["+ strcharinfo(0) +"]";
		mes "嘿！沃尔切夫！！";
		next;
		mes "[Wolfchev]";
		mes "你！？嘿，请阻止它们！";
		mes "这些生物^9f6077在相同职业领域中有机地联系在一起^000000。";
		next;
		mes "[Wolfchev]";
		mes "其中有一只特殊生物处于它们的^46B951首领位置^000000……";
		mes "如果你能停用那只生物，四处走动的所有^A1BB44从属生物^000000都会立即停止移动。";
		next;
		mes "["+ strcharinfo(0) +"]";
		mes "首领生物？";
		mes "喂！沃尔切夫！那只^46B951首领生物^000000在哪里？";
		next;
		mes "[Wolfchev]";
		mes "在……实验室里面……它现在应该已经醒了。毁掉我一生的研究很令人难过，但我再也无法忍受了……";
		next;
		mes "["+ strcharinfo(0) +"]";
		mes "我怎么进入沃尔切夫的实验室？";
		next;
		mes "[Wolfchev]";
		mes "哦……等等！";
		mes "我会帮你进去。";
		next;
		mes "[Wolfchev]";
		mes "好消息是，尽管奴隶生物会同时苏醒，首领生物并不会。";
		next;
		erasequest 5111;
		lght_duk01 = 7;
		for(.@i = 5113; .@i <= 5125; .@i++)
			setquest .@i;
		mes "[Wolfchev]";
		mes "但仍然很危险，因为我们不知道它们何时会逃出来。";
		mes "所以请准备好队伍成员，处理那些首领生物。 I'm not sure how long this place can hold.";
		close;
	} else if (lght_duk01 > 6) {
		if (getcharid(1) > 0) {
			mes "[Wolfchev]";
			mes "你们准备好了吗？如果你是队长，我会准备入口。";
			next;
			switch(select("有什么警告吗？", "进入实验室", "不要进入")) {
			case 1:
				mes "[Wolfchev]";
				mes "我不知道按下紧急警报会造成这种问题。管理系统似乎已经切换到紧急模式。";
				next;
				mes "[Wolfchev]";
				mes "实验室里设置了太多系统，我甚至无法确定现在这些系统被改成什么样了。";
				next;
				mes "[Wolfchev]";
				mes "啊！如果紧急系统启动，只有队长才能控制一切。我明白这压力很大。";
				next;
				mes "[Wolfchev]";
				mes "顺便提醒你，请不要出于好奇随便触碰东西。我不想让你受伤。";
				close;
			case 2:
				if (.@quest_time == 0) {
					mes "[Wolfchev]";
					mes "抱歉，你现在似乎还不能进入实验室。稍后再回来好吗？ The system is kind of tricky you know.";
					close;
				} else {
					//if (.@quest_time == 2)
						//recall_completequest 5112;
					if (isbegin_quest(5112))
						erasequest 5112;
					if (!.@killed_bosses) {
						if (lght_duk01 == 9) {
							mes "[Wolfchev]";
							mes "你回来了，咔哈哈。";
							next;
							mes "[Wolfchev]";
							mes "你离开后，我一直在修理一些系统部件。然后突然发生了奇怪的事。";
							next;
							mes "["+ strcharinfo(0) +"]";
							mes "那是什么？";
							next;
							mes "[Wolfchev]";
							mes "你处理掉的那些首领生物开始自行再生了……";
							next;
							mes "["+ strcharinfo(0) +"]";
							mes "什么……怎么可能……？！";
							next;
							mes "[Wolfchev]";
							mes "我也完全不知所措……但不该发生这种事……";
							next;
							mes "["+ strcharinfo(0) +"]";
							mes "... .... ...";
							next;
							mes "[Wolfchev]";
							mes "如你所见，你是我唯一能信任的人。你和你的队伍能再次帮我停用那些生物吗？";
							next;
							if (select("I am not sure", "Why not") == 1) {
								mes "[Wolfchev]";
								mes "我明白了。我理解你为什么犹豫，也不想再逼你。但我还是不明白你为什么想去那里，";
								next;
							} else {
								for(.@i = 5113; .@i <= 5125; .@i++) {
									setquest .@i;
								}
								lght_duk01 = 10;
								mes "[Wolfchev]";
								mes "非常感谢。"+strcharinfo(0)+"";
								mes "我会马上帮你进入实验室。";
								next;
							}
						} else {
							mes "[Wolfchev]";
							mes "嗯……那些首领生物又再生了……";
							next;
							mes "[Wolfchev]";
							mes "你能再帮我一次吗？";
							next;
							if (select("I am not sure", "Why not") == 1) {
								mes "[Wolfchev]";
								mes "我明白了。我理解你为什么犹豫，也不想再逼你。但我还是不明白你为什么想去那里，";
								next;
							} else {
								for(.@i = 5113; .@i <= 5125; .@i++) {
									setquest .@i;
								}
								lght_duk01 = 10;
								mes "[Wolfchev]";
								mes "谢谢你，"+strcharinfo(0)+"。";
								mes "你想快点进去，对吧？";
								next;
							}
						}
					}
				}
				if (is_party_leader() == true) {
					if (instance_create("Wolfchev's Laboratory") < 0) {
						mes "[Wolfchev]";
						mes "嗯……实验室入口系统有点奇怪。能等我检查一下系统吗？";
						close;
					}
					mes "[Wolfchev]";
					mes "请稍等……";
					next;
					mes "沃尔切夫开始控制某些设备。";
					next;
					progressbar "FF00FF", 2;
					mes "[Wolfchev]";
					mes "好了！我已经标记 lan entering system code as";
					mes "^0000ff"+ strcharinfo(1) +"^000000 party leader's name ^0000ff"+ strcharinfo(0) +"^000000!!.";
					next;
					mes "[Wolfchev]";
					mes "现在你的队伍可以自由通过入口。";
					close;
				} else {
					mes "[Wolfchev]";
					mes "你不是^0000ff队长^000000，对吗？请去找队长。";
					close;
				}
			case 3:
				mes "[Wolfchev]";
				mes "还需要准备？拜托，我们没那么多时间。";
				close;
			}
		} else {
			mes "[Wolfchev]";
			mes "你想一个人去吗？那是自杀！ Our lab entering system is not as easy as you thinkz`.";
			close;
		}
	} else {
		mes "[Wolfchev]";
		mes "哇！发生了奇怪的事。如果继续这样，也许我们该换个办法……";
		close;
	}
}

lhz_dun04,147,279,0	script	Laboratory Entrance#memo	CLEAR_NPC,{
	if ((MaxWeight - Weight) < 1000 || !checkweight(1201, 1)) {
		mes "^FF0000你拥有太多物品，无法继续。^000000";
		close;
	}
	.@lhz_time = checkquest(5112, PLAYTIME);
	if (lght_duk01 < 7) {
		mes "上面写着：";
		mes "‘^0000FF仅限实验室成员^000000’";
		close;
	}
	if (.@lhz_time == -1) {
		mes "这里是通往沃尔切夫实验室的入口。入口上方传来某种嚎叫声。";
		next;
		if (select("Go inside", "Think one more time") == 2) {
			mes "你停止进入沃尔切夫的实验室。";
			close;
		}
		if (instance_enter("Wolfchev's Laboratory") != IE_OK) {  // probably missing failure cases
			mes "^FF0000Warning^000000";
			mes ""+ strcharinfo(0) +". . .";
			mes "^FF0000Unregistered personnel^000000";
			next;
			pushpc 0, 10;
			percentheal -5,0;
			specialeffect EF_AUTOCOUNTER;
			specialeffect2 EF_BASH;
			mes "你被实验室入口系统的攻击击伤了。";
			close;
		}
		mapannounce "lhz_dun04","实验室入口系统：队伍 ["+ strcharinfo(1) +"] 成员 ["+ strcharinfo(0) +"] 获准进入……",bc_map,"0x0DF297";
		setquest 5112;
		//warp "1@lhz", 45, 148;
		close;
	} else if (.@lhz_time == 0) {
		mes "滴哩——滴——滴——滴——";
		next;
		mes ""+ strcharinfo(0) +". . .";
		mes "^FF0000Forbidden personnel^000000";
		next;
		mes "系统拒绝了你的进入请求。";
		close;
	} else if (.@lhz_time >= 1) {
		mes "滴哩——滴——滴——滴——";
		next;
		//if (.@lhz_time == 2)
			//recall_completequest 5112;
		erasequest 5112;
		mes ""+ strcharinfo(0) +". . .";
		mes "^FF0000Access denial has been deactivated.^000000";
		close;
	} else {
		mes "^FF0000Error! Error!^000000";
		mes "^FF0000Please try again.^000000";
		close;
	}
}

// The Lab No.1 : System 1_1
//============================================================
1@lhz,35,108,4	script	Lab1#1_1	CLEAR_NPC,{
	end;

OnInstanceInit:
	initnpctimer;
	end;

OnDisable:
	stopnpctimer;
	end;

OnType_02:
	donpcevent instance_npcname("Manual Sheet#1_1")+"::OnEnable";
	donpcevent instance_npcname("Valve#1_2")+"::OnEnable";
	donpcevent instance_npcname("Valve#1_3")+"::OnEnable";
	mapannounce instance_mapname("1@lhz"),"[Security System] the persons concerned, access with the emergency access method.",bc_map,"0xff9977";
	end;

OnTimer1000:
	mapannounce instance_mapname("1@lhz"),"[Security System] This is a warning notice! Warning notice! Intruder Detected.",bc_map,"0xff9977";
	end;

OnTimer2000:
	mapannounce instance_mapname("1@lhz"),"[Security System] In 5 seconds, The Lab No.1's security system will be activated.",bc_map,"0xff9977";
	end;

OnTimer7000:
	donpcevent instance_npcname("MobCtrl1#mob01")+"::OnEnable";
	end;
}

// The Lab No.1 Monster Control
//============================================================
1@lhz,37,108,4	script	MobCtrl1#mob01	CLEAR_NPC,{
	end;

OnEnable:
	.@map$ = instance_mapname("1@lhz");
	mapannounce .@map$,"[Security System] Security system Activated !! Experimental animals are released. The persons concerned have to evacuate.",bc_map,"0xff9977";
	areamonster .@map$,35,159,50,169,"Starving Lab animal",2242,rand(10,15),instance_npcname(strnpcinfo(0))+"::OnMyMobDead";
	initnpctimer;
	end;

OnDisable:
	killmonster instance_mapname("1@lhz"),instance_npcname(strnpcinfo(0))+"::OnMyMobDead";
	end;

OnTimer180000:
	stopnpctimer;
	if (mobcount(instance_mapname("1@lhz"), instance_npcname(strnpcinfo(0))+"::OnMyMobDead") < 1) {
		donpcevent instance_npcname("Lab1#1_1")+"::OnType_02";
		mapannounce instance_mapname("1@lhz"),"[Security System] The Lab No.1's security system has been stopped.",bc_map,"0xff9977";
	} else {
		initnpctimer;
	}
	end;

OnMyMobDead:
	if (mobcount(instance_mapname("1@lhz"), instance_npcname(strnpcinfo(0))+"::OnMyMobDead") < 1) {
		donpcevent instance_npcname("Lab1#1_1")+"::OnType_02";
		mapannounce instance_mapname("1@lhz"),"[Security System] The Lab No.1's security system has been stopped.",bc_map,"0xff9977";
		stopnpctimer;
	}
	end;
}

// Emergency Access Valve Manual
//============================================================
1@lhz,39,168,0	script	Manual Sheet#1_1	CLEAR_NPC,{
	mes "地板上散落着阀门操作手册。";
	next;
	if (is_party_leader() == true) {
		mes "你，这位队长，开始阅读手册。";
		next;
		mes "[Emergency Access Valve Manual]";
		switch(lght_duk02) {
		case 0:
			switch(rand(1,6)) {
			case 1:

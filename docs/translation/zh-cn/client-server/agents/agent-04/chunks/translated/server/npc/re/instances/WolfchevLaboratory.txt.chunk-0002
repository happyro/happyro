			mes "- 打他让他醒来 -";
			next;
			specialeffect EF_DARKBREATH;
			emotion ET_STARE_ABOUT;
			mes "["+ strcharinfo(0) +"]";
			mes "嘿，伙计！总之先离开这里！有没有它们到不了的地方？";
			next;
			mes "[Wolfchev]";
			mes "糟糕……那我的……我的实验室……去我的实验室……";
			next;
			mes "["+ strcharinfo(0) +"]";
			mes "你的实验室？好，在哪里？";
			next;
			mes "[Wolfchev]";
			mes "在北边……离这里不远……";
			next;
			erasequest 5110;
			setquest 5111;
			lght_duk01 = 6;
			mes "去 12 点钟方向的‘^0000FF沃尔切夫的实验室^000000’……";
			close;
		} else {
			emotion ET_CONFUSE;
			mes "沃尔切夫很困惑，也不知道该怎么办，因为怪物也在攻击他。";
			close;
		}
	} else if (lght_duk01 == 6) {
		mes "去 12 点钟方向的‘^0000FF沃尔切夫的实验室^000000’……";
		close;
	}
	end;
}


//===== rAthena Script =======================================
//= Hunter Job Quest
//===== By: ==================================================
//= EREMES THE CANIVALIZER (Aegis)Translated by yoshiki (Aegis)
//= Converted by kobra_k88
//= Further bugfixed and tested by Lupus
//===== Current Version: =====================================
//= 3.7
//===== Compatible With: =====================================
//= rAthena Project
//===== Description: =========================================
//= [Official Conversion]
//= Job Change quest for Hunter class.
//===== Additional Comments: =================================
//= 0.5 Fully working.
//= 0.6 Changed global variable names to unique ones.
//= 0.7 - 0.8 Updates for rAthena +Knight2,Crusader2 fix
//= 0.9 Fixed items quest fork bug [Lupus]
//= 1.0 Fixed items quest bug: added extra condition [Lupus]
//= 1.1 Fixed skillpoints check bug [Lupus]
//= 1.2 Fixed an exploit, thanks to nonox [celest]
//= 1.3 Added Baby Class support [Lupus]
//= 1.5 Fixed possible EXP abuse [Lupus]
//= 1.6 Added a func which prevent advanced classes passing
//=     2nd Job Quests again. It also guides adv classes where
//=     to go. [Lupus]
//= 1.6a Infinite Arrows exploit fix (thanx to Lorky, that
//= reported the bug) [Lupus]
//= 1.7 Moved the Job QUest to Hugel [Poki#3]
//= 2.0 Changed numbers to constants. [Vicious]
//= 2.1 Removed Duplicates [Silent]
//= 2.2 Merged JFunc, fixed missing dialogues [Lupus]
//= 2.2a Fixed Sharon resetting the test2 item set [Lupus]
//= 2.3a 7 official sets of Demon Hunter,thx to Dr.Evil [Lupus]
//= 2.4a Added missing next;, missing NPC names [Lupus]
//= 2.5 "strcharinfo" -> "strcharinfo(0)" [FlavioJS]
//= 2.6 Fixed 3rd Test. [Samuray22]
//	-Changed Timers from 3 to 1 minute.
//	-Changed "Job Change Monsters".
//	-Thanks to ultradamage.
//= 2.7 Rescripted to Aegis 10.3 standards. [L0ne_W0lf]
//= 2.8 Several bugfixes with the help of Barron-Monster. [L0ne_W0lf]
//= 2.9 Corrected NPC names to fall within proper restrictions. [L0ne_W0lf]
//= 2.9a Deleted unused variables. [Samuray22]
//= 3.0 Fixed a small typo, "jo" instead of "Job". [L0ne_W0lf]
//= 3.0a Corrected a Typo error ";;". [Samuray22]
//= 3.1 Now uses enable and disable waitingroomevent. [L0ne_W0lf]
//= 3.2 Fixes a bug where the timer was stopped causing the [L0ne_W0lf]
//=     test to freeze. (bugreport:1099)
//= 3.3 Added missing next. [L0ne_W0lf]
//= 3.4 Corrected some Issues with the Waiting Room. (bugreport:1890) [Samuray22]
//=     Deleted a Unnecesary Next; on Hunter Guildsman#hnt. (bugreports:1665,2239,2179)
//= 3.5 Added Quest Log commands. [Kisuka]
//= 3.6 Removed the need for use of 'goto.' [L0ne_W0lf]
//= 3.7 Modified the quest to renewal. [Vali] (Thanks to Muad_Dib for the necessary info).
//============================================================

// Notices in the old Hunter Guild.
//============================================================
in_hunter,99,99,4	script	Hunter Info#hnt::HntNotice	727,{
	mes "============ 通知 ============";
	mes "猎人转职地点已迁移至施瓦尔兹瓦德共和国的^ff0000赫ugel^000000。";
	next;
	mes "现在可以使用赫ugel 航空服务，请乘坐飞空艇前往。";
	next;
	mes "新的转职地点位于 ^ff0000 赫ugel 208 222 ^000000。";
	next;
	mes "^804000（你发现通知末尾写着一行小字。）^000000";
	mes " ";
	mes " ";
	mes " ";
	mes "我，这里的猎鹰饲养员，也已经搬走了。";
	close;
	}
//
//
//
//
//
//
//
	//
		//
		//
		//
		//
		//
		//
		//
	//
	//
		//
		//
		//
		
		pay_fild10,148,252,3	duplicate(HntNotice)	Job Change Location#hu	857
		
		// Actual Job quest start
		//============================================================
		hu_in01,386,373,4	script	Hunter Guildsman#hnt	727,{
	if (Upper == 1) {
	mes "[Hunter Sherin]";
		mes "哦，你过得好吗？好久不见了，对吧？";
		next;
		mes "[Hunter Sherin]";
	mes "……等等。";
	mes "哎呀！抱歉，我发誓以前见过你。嗯，真奇怪。";
		close;
		}
		if (BaseJob == Job_Archer && JobLevel < 40) {
		mes "[Hunter Guildsman]";
	mes "嗯？你还没有作为弓箭手接受足够训练。要成为猎人，必须先积累一定弓箭手经验。";
	next;
		mes "[Hunter Guildsman]";
		mes "出去再训练一阵。准备成为猎人前，职业等级至少要达到 40。当然，想继续训练也可以。";
		next;
	mes "[Hunter Guildsman]";
	mes "下次见～";
		close;
		}
		if (SkillPoint) {
	mes "[Hunter Sherin]";
	mes "不使用所有技能点就不能转职。申请转职前请用完技能点～";
		close;
		}
		if (BaseClass == Job_Novice) {
	mes "[Hunter Guildsman]";
	mes "你是……初心者？哇，你还有很长的路要走。这里没什么能帮你的。";
		close;
		}
		else if (BaseClass == Job_Swordman) {
		mes "[Hunter Guildsman]";
	mes "你选择了剑之道。我尊重你刀刃的力量。当然，远距离时你总不能把剑扔向敌人吧？";
	close;
		}
		else if (BaseClass == Job_Mage) {
		mes "[Hunter Guildsman]";
		mes "你使用魔法？能够操纵神秘力量一定很棒。";
	close;
	}
		else if (BaseClass == Job_Acolyte) {
		mes "[Hunter Guildsman]";
		mes "哦，侍奉神的人！很高兴认识你。来这里的这类人可不多～嘿嘿。";
		close;
	}
	else if (BaseClass == Job_Merchant) {
		mes "[Hunter Guildsman]";
		mes "哦……";
		mes "生意进展如何？";
		close;
		}
		else if (BaseClass == Job_Thief) {
		mes "[Hunter Guildsman]";
	mes "啊？！";
	mes "这里没有值得偷的东西，也没有值得杀的人！！";
		close;
			}
			else if (BaseJob == Job_Dancer || BaseJob == Job_Bard) {
			mes "[Hunter Guildsman]";
			mes "呼……有时当猎人真的很辛苦，你知道……";
			mes "你喜欢波希米亚式生活吗？我真羡慕你拥有这么多自由……";
			close;
		}
		else if (BaseJob == Job_Hunter) {
			mes "[Hunter Sherin]";
			mes "哦～"+strcharinfo(0)+"！！";
			mes "好久不见～怎么来这里了？你的猎鹰跑了吗？";
			next;
			mes "[Hunter Sherin]";
			mes "公会目前没有正式通知，希望你不是专程为此而来……";
			close;
			}
			else if (BaseJob == Job_Archer) {
			if (HNTR_Q == 17 && countitem(1007) == 0) {
			mes "[Hunter Sherin]";
			mes "嗯……我听说你通过了测试。但你没有证明成果所需的‘智慧项链（穿透）’。";
			next;
			mes "[Hunter Sherin]";
			mes "我会让你转职，但无论如何都必须带回‘智慧项链（穿透）’。";
			close;
			}
			else if (HNTR_Q == 17 && countitem(1007) > 0) {
			mes "[Hunter Sherin]";
			mes "哦……？";
			mes "你通过了职业测试？！";
			mes "恭喜～！！";
			next;
			mes "[Hunter Sherin]";
			mes "那么，";
			mes "现在就把你的职业";
				mes "改为猎人～";
			next;
				delitem 1007,1; // Penetration
			mes "[Hunter Sherin]";
		mes "锵锵～恭喜！";
		mes "你当猎人的样子真棒！！";
			.@joblvl = JobLevel;
				completequest 4013;
				callfunc "Job_Change",Job_Hunter;
				callfunc "F_ClearJobVar";		// clears all job variables for the current player
				next;
				mes "[Hunter Sherin]";
					mes "成为高尚的人，做我们猎人公会称职的代表。作为猎人展现你对自然的热爱～";
					next;
					mes "[Hunter Sherin]";
					mes "另外，这是对你努力的小奖励。当然是我送的～";
					if (.@joblvl > 49)
					getitem 1718,1; //Hunter_Bow
					else
					getitem 1710,1; //CrossBow
					close;
					}
					else if (HNTR_Q == 0 || HNTR_Q == 1) {
					if (HNTR_Q == 0) {
					mes "[Hunter Guildsman]";
					mes "哦，你是弓箭手！看来你训练得够多了……你是来成为猎人的，对吧？";
					next;
					switch( select( "是的，我就是为此而来。", "转职有什么要求？", "……我还不想转职。" ) ) {
					case 1:
					mes "[Hunter Guildsman]";
					mes "嘿嘿～";
					mes "我猜对了！让我把你列入候选名单。";
						next;
						mes "[Hunter Guildsman]";
						mes "嗯……从面试开始。稍等放松，不用担心，我会准备好一切～";
						next;
						mes "^3355FF*Gathers and flips through papers*^000000";
					next;
					mes "^3355FF*Rummage rummage*^000000";
						next;
					mes "[Hunter Guildsman]";
					mes "啊！";
					mes "面试问题来了～首先，我叫 Sherin。很高兴认识你！";
					next;
					mes "[Hunter Sherin]";
					mes "那么，";
				mes "我们开始吗？";
					next;
					if (select( "是～现在开始。", "不，我稍后再来。") == 2) {
					mes "[Hunter Sherin]";
					mes "好吧……";
					mes "准备好后再回来～";
					close;
					}
					if (isbegin_quest(4000) == 0)
					setquest 4000;
					mes "[Hunter Sherin]";
					mes "仔细听我描述的情景。提问时选择答案。很简单，对吧？";
					next;
					mes "[Hunter Sherin]";
					mes "我只是想知道你如何看待人生，以及为什么想成为猎人，不用紧张。";
					break;
					case 2:
					mes "[Hunter Guildsman]";
					mes "转职要求？";
					mes "第一……你必须是弓箭手。";
				next;
					mes "[Hunter Guildsman]";
					mes "第二……职业等级至少 40。";
					next;
					mes "[Hunter Guildsman]";
				mes "第三……带齐公会要求的所有物品。稍后再担心。";
			next;
			mes "[Hunter Guildsman]";
				mes "第四……通过公会测试。如果你接受了足够的弓箭手训练，就应该能通过～";
				close;
				case 3:
			mes "[Hunter Guildsman]";
			mes "好吧，下次见～";
			close;
			}
			}
			else if (HNTR_Q == 1) {
			mes "[Hunter Sherin]";
			mes "欢迎回来……！";
			mes "那么开始面试吧。这次请仔细思考每个问题的答案。";
			}
			next;
			mes "[Hunter Sherin]";
				mes "那么，我们开始。";
			next;
				mes "[Hunter Sherin]";
			mes "你是弓箭手，不知道该去哪里狩猎。你会怎么做？";
			next;
			switch( select( "大声喊叫询问去哪里。", "安静询问路过的人。", "独自游荡寻找地点。" ) ) {
			case 2:
			case 3:
			.@hunter_t += 10;
			default:
			break;
			}
			mes "[Hunter Sherin]";
			mes "你决定了狩猎地点，要在苏克拉特沙漠狩猎 Hodes。";
				next;
			mes "[Hunter Sherin]";
				mes "但你在斐扬！！";
			mes "你要怎么去沙漠？";
			next;
			switch( select( "请牧师打开免费传送门。", "使用卡普拉服务。", "和朋友一起走。" ) ) {
			case 2:
			case 3:
			.@hunter_t += 10;
			default:
			break;
			}
			mes "[Hunter Sherin]";
			mes "附近没有牧师，也没有朋友陪你走。你必须使用卡普拉服务，但没有 Zeny！";
			next;
				mes "[Hunter Sherin]";
			mes "你会如何赚到需要的 Zeny？";
				next;
			switch( select( "到处乞讨。", "出售不需要的物品。", "在附近原野狩猎。" ) ) {
			case 2:
			case 3:
			.@hunter_t += 10;
			default:
			break;
			}
			mes "[Hunter Sherin]";
			mes "你终于抵达苏克拉特沙漠，却发现 Hodes 太强，无法独自狩猎。";
			next;
				mes "[Hunter Sherin]";
			mes "你打算如何解决？";
			next;
			if (select( "从山顶攻击 Hode。", "回城。", "攻击别人的 Hode。" ) == 2)
			.@hunter_t += 10;
				mes "[Hunter Sherin]";
			mes "假设你狩猎 Hodes 遇到困难回到城里。现在 HP 用尽，附近恰好有牧师。你会如何请求治疗？";
			next;
			if (select( "可以请你治疗吗？", "请治疗。", "治疗我。" ) == 1)
			.@hunter_t += 10;
			mes "[Hunter Sherin]";
			mes "这次你在整理背包时发现了稀有物品。你出去出售，看到许多商店和聊天室。";
			next;
			mes "[Hunter Sherin]";
			mes "出售物品的最佳方式是什么？";
			next;
			switch( select( "对所有人大声喊。", "开聊天室等待。", "看看是否有人想要。" ) ) {
				case 2:
			case 3:
				.@hunter_t += 10;
			default:
			break;
			}
			mes "[Hunter Sherin]";
			mes "等待时，有人在乞求物品和 Zeny。你该怎么办？";
				next;
			if (select("给他一些物品和 Zeny。", "无视并离开。", "告诉他适合狩猎的地方。") == 1)
			.@hunter_t += 10;
			mes "[Hunter Sherin]";
			mes "现在你决定独自前往迷宫。";
			next;
			mes "[Hunter Sherin]";
			mes "但路上遇到迷路的人。你该怎么办？";
			next;
			switch( select( "告诉他方向。", "带他去目的地。", "无视。" ) ) {
			case 1:
			case 2:
				.@hunter_t += 10;
			default:
				break;
			}
			mes "[Hunter Sherin]";
			mes "遇到迷路者后，你决定继续狩猎。就在这时，你发现有人正在攻击 Boss！";
			next;
			mes "[Hunter Sherin]";
			mes "你该怎么办？";
			next;
			if (select( "观察，求助时再攻击。", "攻击看看会怎样。", "直接回城。" ) == 1)
				.@hunter_t += 10;
			mes "[Hunter Sherin]";
			mes "一天狩猎后你筋疲力尽。该回城了。";
			next;
			mes "[Hunter Sherin]";
			mes "但这是什么！？你发现地上有件昂贵物品！你该怎么处理？";
			next;
			switch( select( "捡起来占为己有。", "设法寻找失主。", "直接走过。" ) ) {
			case 2:
			case 3:
				.@hunter_t += 10;
			default:
				break;
			}
			mes "[Hunter Sherin]";
			mes "好，测试到此结束！";
			next;
			if (.@hunter_t == 100) {
				HNTR_Q = 2;
				changequest 4000,4001;
				mes "[Hunter Sherin]";
				mes "做得好！你的答案显示出正确的人生观。你绝对具备成为猎人的品质～";
				next;
				mes "[Hunter Sherin]";
				mes "很高兴告诉你，你通过了面试～现在去角落那个人那里确认转职测试所需物品～";
				close;
			}
			else if (.@hunter_t == 90) {
				HNTR_Q = 2;
				changequest 4000,4001;
				mes "[Hunter Sherin]";
				mes "你的分数并不完美，但我还是让你通过。不知道公会长会怎么想。";
				next;
				mes "[Hunter Sherin]";
				mes "记住基本礼仪。接下来的测试加油，让我开心，好吗？";
				close;
			}
			HNTR_Q = 1;
			mes "[Hunter Sherin]";
			mes "嗯……这样不行。不懂基本礼仪就不能成为猎人。";
			next;
			mes "[Hunter Sherin]";
			mes "再想想你如何回答问题。想珍惜自然，必须先珍惜与他人的关系。";
			next;
			mes "[Hunter Sherin]";
			mes "这样你才能与自然和他人更融洽。这种和谐造就优秀猎人。";
			close;
		}
		else if (HNTR_Q > 2 && HNTR_Q < 10) {
			mes "[Hunter Sherin]";
			mes "把物品交给恶魔猎人，就是这里最左边的那个人～";
			next;
			mes "[Hunter Sherin]";
			if (Sex == SEX_MALE)
				mes "决定成为猎人后，答应来看我。我想看看猎人的你，一定很帅！！";
			else
				mes "决定成为猎人后来看我，好吗？你很漂亮，不过……成为猎人会更漂亮。嘿嘿～";
			close;
		}
		else if (HNTR_Q == 2) {
			mes "[Hunter Sherin]";
			mes "????";
			next;
			mes "[Hunter Sherin]";
			mes "没找到恶魔猎人？他就在最左边！嘿嘿～";
			next;
			mes "[Hunter Sherin]";
			mes "我想看你成为猎人……！哇～你一定很棒，快点吧！";
			close;
		}
		mes "[Hunter Sherin]";
		mes "嗯，我想你应该去找别人，不是我。比如外出办事的公会长。";
		next;
		mes "[Hunter Sherin]";
		mes "听说他在斐扬中央宫殿……或者弓箭手村，去那里找找吧。";
		close;
	}
	mes "[Hunter Guildsman]";
	mes "嗯？你作为弓箭手训练不够。要成为猎人，先积累更多弓箭手经验。";
	next;
	mes "[Hunter Guildsman]";
	mes "那么再训练一些。职业等级必须至少 40。当然可以更高。下次见～";
	close;
}

hu_in01,382,382,4	script	Guild Receptionist#hnt	732,{
	if (HNTR_Q == 2) {
		mes "[Guild Receptionist]";
		mes "你好。他们称我为……^660000恶魔猎人^000000。我负责处理申请。你的名字是"+strcharinfo(0)+"，对吧？";
		next;
		if (select( "是的，没错。", "不是～～（嘻嘻嘻）" ) == 2) {
			mes "[Demon Hunter]";
			mes "嘿，别胡闹。";
			mes "你的名字是"+strcharinfo(0)+"，对吧？";
			next;
			if (select("是……", "嘿嘿，我一直说不是～～") == 2) {
				mes "[Demon Hunter]";
				mes "想耍小把戏就离开。你没意识到自己在戏弄^660000恶魔猎人^000000吗？！";
				close2;
				warp "hugel",208,223;
				end;
			}
		}
		mes "[Demon Hunter]";
		mes "好。这些是测试所需物品。我们会提供测试用箭矢，所以需要你收集制作材料。";
		next;
		mes "[Demon Hunter]";
		mes "我们遇到一些财务问题。让我们看看，还缺这些物品……";
		next;
		if (checkre(0) == true)
			.@i = 1;
		switch( rand(1,7) ) {
		case 1:
			// Insect_Feeler/Claw_Of_Desert_Wolf, Wooden_Block, White_Herb
			setarray .@items[0], (.@i?928:7030),5, 1019,5, 509,3, 3;
			changequest 4001,4002;
			break;
		case 2:
			// Bill_Of_Birds, Skel_Bone, Green_Herb
			setarray .@items[0], 925,3, 932,5, 511,3, 4;
			changequest 4001,4003;
			break;
		case 3:
			// Colorful_Shell/Posionous_Canine, Animal's_Skin, Red_Herb
			setarray .@items[0], (.@i?1013:937),3, 919,3, 507,5, 5;
			changequest 4001,4004;
			break;
		case 4:
			// Horn/Dokkaebi_Horn, Poison_Spore/Piece_Of_Egg_Shell, Fluff
			setarray .@items[0], (.@i?947:1021),3, (.@i?7033:7032),3, 914,10, 6;
			changequest 4001,4005;

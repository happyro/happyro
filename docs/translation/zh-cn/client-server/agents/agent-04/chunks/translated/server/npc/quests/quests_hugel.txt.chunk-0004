lhz_in03,193,28,3	script	Makkie	83,{
	if (hg_bio == 4) {
		mes "[Makkie]";
		mes "你好，今天我能";
		mes "帮你什么吗？";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "你好，我来取一些";
		mes "红色植物茎粉给多诺。";
		mes "这件事其实很重要。";
		mes "请尽快交给我。";
		next;
		mes "[Makkie]";
		mes "啊，我明白了。他一定需要它";
		mes "来为莫里芬和西莉亚配药，";
		mes "对吧？好，稍等一下。";
		mes "等待时可以放松一下，到处看看……";
		mes "我马上准备。";
		next;
		mes "^3355FF麦基把粉末筛进袋子里。";
		mes "你看到桌上有一张照片，";
		mes "照片中的麦基、多诺和莫里芬";
		mes "都穿着白色实验服。^000000";
		mes "他们看起来很年轻。";
		next;
		mes "[Makkie]";
		mes "哦，那张照片？那是多诺、莫里芬";
		mes "和我为雷根贝勒公司";
		mes "工作时拍的。";
		mes "他们看起来很古怪，但真的是好人，相信我。";
		mes "我们曾经很亲密。";
		next;
		mes "[Makkie]";
		mes "是的，我以前其实在多诺手下工作。";
		mes "他是基因工程部门的主管，";
		mes "而莫里芬负责其他研究。";
		mes "那段日子真的很美好。";
		mes "我至今仍然怀念。";
		next;
		mes "[Makkie]";
		mes "突然间，我、多诺以及所有在他手下工作的人";
		mes "都被解雇了！当时我刚入职，";
		mes "所以很久之后才从别人那里";
		mes "知道我们被解雇的原因。";
		mes "那真是令人费解。";
		next;
		mes "[Makkie]";
		mes "原来雷根贝勒的基因实验室发生了火灾，";
		mes "可能还是人为纵火。";
		mes "多诺承担了全部责任，";
		mes "但所有为他工作的人都知道那不是他做的。";
		mes "真相至今仍不明。";
		next;
		mes "[Makkie]";
		mes "所以我们才做起了现在的工作。";
		mes "奇怪的是，莫里芬也在同一时间消失。";
		mes "自从雷根贝勒时期后，";
		mes "我就不知道他发生了什么……";
		mes "直到最近才再次见到他。";
		next;
		mes "[Makkie]";
		mes "总之，莫里芬再次出现时，";
		mes "正好需要我们制作的药。";
		mes "我真希望自己也有像多诺或莫里芬这样的好朋友。";
		mes "他们两个关系很亲密。";
		mes "真令人羡慕。";
		next;
		mes "[Makkie]";
		mes "是啊，多诺确实是个好人。";
		mes "他甚至帮我找到了这份工作～";
		mes "总之，如果你见到他，或去看望莫里芬，";
		mes "请替我向他们问好。";
		mes "给，这是红色植物茎粉。";

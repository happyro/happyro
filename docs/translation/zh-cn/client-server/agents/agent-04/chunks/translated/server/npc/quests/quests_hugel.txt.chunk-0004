hugel,70,137,5	script	Shede	879,{
	cutin "siide1.bmp",2;
	if (hg_tre == 0) {
		mes "[Shede]";
		mes "耶～你是在和我说话吗？耶！";
		mes "嘿，你来自别的城市吗？哇，很高兴见到你！";
		emotion ET_SURPRISE;
		next;
		mes "[Shede]";
		mes "机场建成后，胡格尔一直忙着接待游客和冒险者。";
		mes "看到胡格尔变得这么拥挤，我有点惊讶，";
		mes "但我觉得这对小镇是好事。";
		next;
		mes "[Shede]";
		mes "同时，我还有许多客人要招待……";
		mes "事实上，我连聊天的时间都没有，呵呵呵。";
		next;
		switch(select("要我帮你吗？:我不打扰你了。")) {
		case 1:
			mes "[Shede]";
			mes "哦～你真好！非常感谢～";
			mes "那我可以拜托你一件事吗？";
			emotion ET_THROB;
			next;
			mes "[Shede]";
			switch(rand(1,3)) {
			case 1:
				mes "霍伦叔叔的生日快到了，";
				mes "所以我想为他做\"^3131FF蘑菇风味饼干^000000\"。";
				mes "遗憾的是，我缺少最重要的材料：蘑菇。";
				next;
				cutin "siide2.bmp",2;
				mes "[Shede]";
				mes "普通蘑菇的味道不够好，";
				mes "但只生长在胡格尔的\"^3131FF莫克斯蘑菇^000000\"香气诱人。";
				mes "加入饼干后，能大幅提升风味。";
				next;
				mes "[Shede]";
				mes "请从\"^3131FF莫克斯蘑菇^000000\"中收集\"^3131FF5 份莫克斯蘑菇汁^000000\"好吗？";
				mes "胡格尔附近的田野里能找到蘑菇。";
				mes "请尽快把蘑菇汁带回来！";
				set hg_tre,10;
				close2;
				cutin "",255;
				end;
			case 2:
				mes "事实上，我和阿杰特正在竞争胡格尔最佳饼干师的称号。";
				next;
				mes "[Shede]";
				mes "成为最棒的饼干师并不容易。";
				mes "人人都能拥有最好的材料和烹饪工具，";
				mes "但这不代表就能成为最佳饼干师。";
				next;
				mes "[Shede]";
				mes "你必须学会协调自己的技能和感觉，";
				mes "才能做出最美味的饼干。";
				next;
				cutin "siide2.bmp",2;
				mes "[Shede]";
				mes "我敢说我的饼干是最棒的。";
				mes "不过，阿杰特也是专业的饼干师。";
				next;
				mes "[Shede]";
				mes "烘焙时一听到她的名字，";
				mes "我就紧张得手发抖，";
				mes "甚至会量错材料的分量。";
				mes "这就说明她的饼干有多厉害。";
				next;
				mes "[Shede]";
				mes "不过我是一名自豪的饼干师，";
				mes "内心有个声音告诉我";
				mes "我绝不会输给她！";
				mes "你听到了吗？";
				mes "听到我作为饼干师的斗志了吗？";
				next;
				mes "[Shede]";
				mes "过一阵子我要和她竞争";
				mes "胡格尔最佳饼干师的称号。";
				mes "所以我一直努力练习，争取赢过她！";
				next;
				mes "[Shede]";
				mes "成为最佳饼干师的路上有许多阻碍。";
				mes "但你看，我还在这里，活蹦乱跳！我绝不会放弃！";
				mes "今天我要挑战制作^FF0000蛤蜊饼干^000000！";
				mes "我要做出酸爽独特的味道。我相信一定会大获成功！";
				next;
				mes "[Shede]";
				mes "去海滩时，";
				mes "你会在渡船附近找到蛤蜊。";
				mes "请从蛤蜊身上收集^3131FF5 个蛤蜊肉^000000。";
				mes "请快一点！";
				set hg_tre,20;
				close2;
				cutin "",255;
				end;
			case 3:
				mes "事实上，我爱上了一位绅士。";
				mes "我觉得现在是时候让他知道";
				mes "我对他的感情了。";
				next;
				cutin "siide2.bmp",2;

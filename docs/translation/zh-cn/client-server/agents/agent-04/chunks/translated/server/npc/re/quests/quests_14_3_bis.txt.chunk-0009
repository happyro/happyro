		mes "[Doom Prayers Leader]";
		mes "你是懦夫！";
		mes "我再次命令你。";
		next;
		mes "[Doom Prayers Leader]";
		mes "带来在毁灭之地游荡的怪物之血。";
		mes "我会饮下它并悬浮，引导你们走向真正的信仰！";
		next;
		mes "[Guard]";
		mes "他指的是^FF0000怪物之血^000000";
		mes "来自^0000FF火焰弗里尔多拉斯^000000和^0000FF火焰沙人^000000。";
		mes "我想 30 瓶就够了。";
		next;
		if (select( "不，我一点也不在乎！", "我去收集怪物之血。") == 1) {
			mes "[Doom Prayers Leader]";
			mes "我就知道你会答应！";
			mes "我能感觉到你害怕见证毁灭之神的恩典。";
			next;
			mes "[Doom Prayers Leader]";
			mes "别烦我，滚开！";
			mes "毁灭就是祝福！";
			close;
		}
		mes "[Doom Prayers Leader]";
		mes "现在去带怪物之血给我！";
		mes "去猎杀那些可恶的^0000FF火焰弗里尔多拉斯^000000和^0000FF火焰沙人^000000，带 30 瓶^FF0000怪物之血^000000给我。";
		next;
		mes "[Doom Prayers Leader]";
		mes "这是危险的任务。";
		mes "你想逃跑我能理解。";
		mes "如果你真的不听我的劝告，那就随你的便吧。";
		mes "哇哈哈哈！";
		completequest 1271;	// Flaming Basin and Doom Prayers
		setquest 1272;	// Flaming Basin and Doom Prayers
		ep14_3_fall_bless = 9;
		close;
	}
	if (ep14_3_fall_bless == 9) {
		if (countitem(6694) < 29) {
			mes "[Doom Prayers Leader]";
			mes "现在去带怪物之血给我！";
			mes "去猎杀那些可恶的^0000FF火焰弗里尔多拉斯^000000和^0000FF火焰沙人^000000，带 30 瓶^FF0000怪物之血^000000给我。";
			next;
			mes "[Doom Prayers Leader]";
			mes "这是危险的任务。";
			mes "你想逃跑我能理解。";
			mes "如果你真的不听我的劝告，那就随你的便吧。";
			mes "哇哈哈哈！";
			close;
		}
		mes "[Doom Prayers Leader]";
		mes "异教徒，你一定太闲了：你真的带来了所有^FF0000怪物之血^000000。";
		next;
		mes "[Doom Prayers Leader]";
		mes "看啊！";
		mes "我会喝下它，用力量让自己悬浮！";
		next;
		mes "[Doom Prayers Leader]";
		mes "*咕噜咕噜*";
		next;
		mes "[Doom Prayers Leader]";
		mes "*Slosh Slosh*";
		next;
		mes "[Doom Prayers Leader]";
		mes "*Guzzle Guzzle*";
		next;
		mes "[Doom Prayers Leader]";
		mes "*嗝*";
		next;
		mes "[Doom Prayers Leader]";
		mes "*Rumble*";
		next;
		mes "[Doom Prayers Leader]";
		mes "...";
		mes "呃……";
		emotion 4;
		next;
		mes "他的脸色变得苍白。";
		mes "你闻到一股像腹泻的气味。";
		next;
		mes "他尴尬地抿紧嘴唇。";
		emotion 28;
		delitem 6694,30;// Monster_Blood
		completequest 1272;	// Flaming Basin and Doom Prayers
		setquest 1273;	// Flaming Basin and Doom Prayers
		ep14_3_fall_bless = 10;
		close;
	}
	if (ep14_3_fall_bless < 12) {
		mes "他被一团恶臭包围，沉默不语。";
		next;
		mes "他的副官愤怒地指着你。";
		mes "你应该和他谈谈。";
		close;
	}
	if (ep14_3_fall_bless == 12) {
		mes "[Doom Prayers Leader]";
		mes "唉，世界又没毁灭。";
		mes "我真想现在回家换条干净内裤……";
		next;
		mes "[Doom Prayers Leader]";
		mes "我会等待下一场自然灾害，召集更多信徒召唤毁灭之神！";
		next;
		mes "[Doom Prayers Leader]";
		mes "不过多亏了你，这场意外震撼了所有人，也让他们认清了自己的位置。";
		next;
		mes "[Doom Prayers Leader]";
		mes "我的信徒开始怀疑对我的信仰，已经好几个月没交会费了。";
		mes "我应该奖励你的帮助。";
		next;
		mes "[Doom Prayers Leader]";
		mes "希望你能参加我们的下一次集会，再次创造奇迹。";
		completequest 1275;	// Flaming Basin and Doom Prayers
		ep14_3_fall_bless = 13;
		getexp 2000000,0;
		close;
	}
	mes "[Doom Prayers Leader]";
	mes "不过多亏了你，这场意外震撼了所有人，也让他们认清了自己的位置。";
	next;
	mes "[Doom Prayers Leader]";
	mes "希望你能参加我们的下一次集会，再次创造奇迹。";
	close;

OnInit:
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "BaseLevel >= 150 && isbegin_quest(1270) == 0 && isbegin_quest(1297) == 1 && ep14_3_fall_bless == 6" );
	end;
}

moro_vol,95,195,3	script	Doom Prayers Second-in-command#bl	4_F_BELIEVER01,{
	if (checkweight(1301,3) == 0) {
		mes "- 由于携带物品过多，无法继续对话。-";
		close;
	}
	if (ep14_3_fall_bless < 10) {
		mes "[Doom Prayers Second-in-command]";
		mes "毁灭祈祷者！";
		mes "更加努力地祈祷！";
		mes "毁灭就是祝福！";
		next;
		mes "[Doom Prayers]";
		mes "毁灭就是祝福！";
		mes "毁灭就是祝福！";
		close;
	}
	if (ep14_3_fall_bless == 10) {
		mes "[Doom Prayers Second-in-command]";
		mes "毁灭祈祷者，不要慌！保持冷静！";
		next;
		mes "[Doom Prayers Second-in-command]";
		mes "审判很快就会开始，我们将获得祝福。";
		mes "我们将无所缺乏！";
		next;
		mes "[Doom Prayers Second-in-command]";
		mes "让我们一起祈祷，打开祝福之门！";
		mes "毁灭就是祝福！";
		next;
		mes "[Doom Prayers]";
		mes "毁灭就是祝福！";
		mes "毁灭就是祝福！";
		next;
		mes "[Doom Prayers Second-in-command]";
		mes "哦，我看见光了！";
		mes "只要我手里有 30 个^FF0000火焰石像鬼的石牙^000000和 30 个^FF0000火焰弗里尔多拉斯的后颈肉^000000就好了！";
		next;
		mes "[Doom Prayers Second-in-command]";
		mes "高耸的祝福之门会出现在我们面前，为我们敞开！";
		next;
		mes "[Doom Prayers]";
		mes "哦！";
		next;
		mes "[Doom Prayers Second-in-command]";
		mes "毁灭祈祷者，向前冲，摧毁沿途一切，用赤手空拳无畏地攻击那些危险怪物！";
		next;
		mes "[Doom Prayers Second-in-command]";
		mes "带 30 个^FF0000火焰石像鬼的石牙^000000和 30 个^FF0000火焰弗里尔多拉斯的后颈肉^000000给我。";
		next;
		if (select( "不，我一点也不在乎！", "我会带来。" ) == 1) {
			mes "[Doom Prayers Second-in-command]";
			mes "听好了，毁灭祈祷者！";
			mes "那个无情的异教徒根本不在乎我们。";
			mes "真是太好了！";
			next;
			mes "[Doom Prayers Second-in-command]";
			mes "现在用赤手空拳猎杀那些可恶的怪物，把材料带给我！";
			next;
			mes "[Doom Prayers Second-in-command]";
			mes "就算连波利都打不过也别害怕；";
			mes "我知道你心里和巴风特一样强大！";
			emotion 19, playerattached();
			close;
		}
		mes "[Doom Prayers Second-in-command]";
		mes "好了，毁灭祈祷者！";
		mes "再给这个异教徒一次获得祝福的机会！";
		next;
		mes "[Doom Prayers Second-in-command]";
		mes "现在带 30 个^FF0000火焰石像鬼的石牙^000000和 30 个^FF0000火焰弗里尔多拉斯的后颈肉^000000给我。";
		completequest 1273;	// Flaming Basin and Doom Prayers
		setquest 1274;	// Flaming Basin and Doom Prayers
		ep14_3_fall_bless = 11;
		close;
	}
	if (ep14_3_fall_bless == 11) {
		if (countitem(6695) < 30 || countitem(6696) < 30) {
			mes "[Doom Prayers Second-in-command]";
			mes "现在带 30 个^FF0000火焰石像鬼的石牙^000000和 30 个^FF0000火焰弗里尔多拉斯的后颈肉^000000给我。";
			close;
		}
		mes "[Doom Prayers Second-in-command]";
		mes "哦，毁灭祈祷者，欢呼吧——我们终于集齐了所有材料！";
		mes "毁灭就是祝福！";
		next;
		mes "[Doom Prayers]";
		mes "毁灭就是祝福！";
		mes "毁灭就是祝福！";
		next;
		mes "[Doom Prayers Second-in-command]";
		mes "让我们一起祈祷，打开祝福之门！";
		next;
		mes "[Doom Prayers]";
		mes "毁灭就是祝福！";
		mes "毁灭就是祝福！";
		next;
		mes "[Doom Prayers]";
		mes "...";
		next;
		mes "[Doom Prayers]";
		mes "!!!";
		next;
		mes "[Doom Prayers]";
		mes "呀——！";
		mes "呜啊！呃！";
		specialeffect EF_SUI_EXPLOSION, AREA, "Doom Prayers Leader#bl";
		specialeffect EF_SUI_EXPLOSION;
		specialeffect EF_SUI_EXPLOSION, AREA, "Doom Prayer#bl1";
		specialeffect EF_SUI_EXPLOSION, AREA, "Doom Prayer#bl2";
		specialeffect EF_SUI_EXPLOSION, AREA, "Doom Prayer#bl3";
		specialeffect EF_SUI_EXPLOSION, AREA, "Doom Prayer#bl4";
		specialeffect EF_SUI_EXPLOSION, AREA, "Doom Prayer#bl5";
		specialeffect EF_SUI_EXPLOSION, AREA, "Doom Prayer#bl6";
		specialeffect EF_SUI_EXPLOSION, AREA, "Doom Prayer#bl7";
		specialeffect EF_SUI_EXPLOSION, AREA, "Doom Prayer#bl8";
		specialeffect EF_SUI_EXPLOSION, AREA, "Doom Prayer#bl9";
		specialeffect EF_SUI_EXPLOSION, AREA, "Doom Prayer#bl0";
		specialeffect EF_SUI_EXPLOSION, AREA, "Doom Prayer#bl11";
		specialeffect EF_SUI_EXPLOSION, AREA, "Doom Prayer#bl12";
		next;
		mes "[Doom Prayers]";
		mes "呀——！";
		mes "世界真的要毁灭了！";
		mes "我们要死了！呀——！";
		specialeffect EF_SUI_EXPLOSION, AREA, "Doom Prayers Leader#bl";
		specialeffect EF_SUI_EXPLOSION;
		specialeffect EF_SUI_EXPLOSION, AREA, "Doom Prayer#bl1";
		specialeffect EF_SUI_EXPLOSION, AREA, "Doom Prayer#bl2";
		specialeffect EF_SUI_EXPLOSION, AREA, "Doom Prayer#bl3";
		specialeffect EF_SUI_EXPLOSION, AREA, "Doom Prayer#bl4";
		specialeffect EF_SUI_EXPLOSION, AREA, "Doom Prayer#bl5";
		specialeffect EF_SUI_EXPLOSION, AREA, "Doom Prayer#bl6";
		specialeffect EF_SUI_EXPLOSION, AREA, "Doom Prayer#bl7";
		specialeffect EF_SUI_EXPLOSION, AREA, "Doom Prayer#bl8";
		specialeffect EF_SUI_EXPLOSION, AREA, "Doom Prayer#bl9";
		specialeffect EF_SUI_EXPLOSION, AREA, "Doom Prayer#bl0";
		specialeffect EF_SUI_EXPLOSION, AREA, "Doom Prayer#bl11";
		specialeffect EF_SUI_EXPLOSION, AREA, "Doom Prayer#bl12";
		next;
		mes "无论毁灭之神是否真的存在，这群狂热分子都没有他们以为的那么特别。";
		mes "你应该再去和毁灭祈祷者首领谈谈。";
		delitem 6695,30;// ToothOfFlameGolem
		delitem 6696,30;// ToothOfFlameFrilldora
		completequest 1274;	// Flaming Basin and Doom Prayers
		setquest 1275;	// Flaming Basin and Doom Prayers
		ep14_3_fall_bless = 12;
		close;
	}
	mes "[Doom Prayers Second-in-command]";
	mes "呜……我好害怕……";
	mes "要是我一个人，我早就逃跑了。";
	mes "太可怕了。我还要再哭一会儿……";
	close;
}


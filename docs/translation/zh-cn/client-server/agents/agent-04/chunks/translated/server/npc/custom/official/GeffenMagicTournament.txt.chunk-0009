					attachrid('gmt_account_id);
					cutin "fenrir_a.bmp", 2;
mes "[Fenrir]", "你还好吗？", "这些小混混到底从哪里冒出来的？"; next;
					cutin "", 255;
mes "[Magic Academy Student]", "谢谢你帮我。", "你是谁？"; next;
					cutin "fenrir_a.bmp", 2;
mes "[Fenrir]", "我是 Fenris Fenrir。"; next;
					mes "[Fenrir]", "谢谢你，" + strcharinfo(0) + "。", "要不是"+('sex?"他":"她"')+"出现，情况会更糟。"; next;
					cutin "", 255;
mes "[Magic Academy Student]", "非常感谢你，" + strcharinfo(0) + "。", "你救了我。"; next;
					cutin "fenrir_a.bmp", 2;
mes "[Fenrir]", "现在很少能遇到像" + strcharinfo(0) + "这样的人了。", "你是个好人。"; next;
					mes "[Fenrir]", "我正和 Loki 前往报名参加吉芬魔法大赛。"; next;
mes "[Fenrir]", "我感觉你也会报名，" + strcharinfo(0) + "。", "希望能在大赛决赛见到你。"; next;
					cutin "ep14_roki01.bmp", 2;
mes "[Loki]", "哦，是吗？", "" + strcharinfo(0) + " 要报名？", "真有意思。"; next;
mes "[Loki]", "我有一张多余的魔法增益卷轴。", "送给你当礼物。";
					sc_start4 SC_GEFFEN_MAGIC2, 3600000, 5, 0, 0, 0, 10000, 1;

		case 17: npctalk "吉芬恶霸：你！你有多少 Zeny？", instance_npcname("Geffen Bully#1"); break;
		case 20: npctalk "魔法学院学生：什么……嗯？", instance_npcname("Magic Academy Student#22"); break;
		case 23: npctalk "吉芬恶霸：我说得不清楚吗？你有多少 Zeny！你这个笨蛋！", instance_npcname("Geffen Bully#2"); break;
		case 27: npctalk "魔法学院学生：我没有 Zeny……我只是学生……", instance_npcname("Magic Academy Student#22"); break;
		case 30: npctalk "吉芬恶霸：非要我把 Zeny 从你身上打出来吗？！", instance_npcname("Geffen Bully#3"); break;
		case 33: npctalk "魔法学院学生：呃……我说了，我没有 Zeny！", instance_npcname("Magic Academy Student#22"); break;

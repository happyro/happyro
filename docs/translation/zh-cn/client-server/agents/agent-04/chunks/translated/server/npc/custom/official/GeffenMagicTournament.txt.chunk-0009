				case 36: npctalk "吉芬恶霸：哦，哦！该走了！", instance_npcname("Geffen Bully#1"); break;
				case 38: npctalk "吉芬恶霸：求你……饶我一命……", instance_npcname("Geffen Bully#2"); break;

		ep17_2_bath = 5;
		erasequest 17366;
		setquest 17367;
		close2;
		cutin "",255;
		cloakonnpcself( "Rookie#172ba02" );
		end;
	}
	if (ep17_2_bath == 5) {
		cutin "ep172_beta",0;
		mes "[神殿]";
		mes "你的队伍去了<NAVI>[休息室]<INFO>ba_bath,203,58,0,101,0</INFO></NAVI>。";
		close2;
		cutin "",255;
		cloakonnpcself( "Rookie#172ba02" );
		end;
	}
	if (ep17_2_bath == 6) {
		cutin "ep172_beta",0;
		mes "[神殿]";
		mes "寻找生物进展如何？";
		close3;
	}
	if (ep17_2_bath < 12) {
		cutin "ep172_beta",0;
		mes "[神殿]";
		mes "你不是正在行动中吗？";
		close3;
	}
	cutin "ep172_beta",0;
	mes "[神殿]";
	mes "使用浴场有什么不便吗？";
	close3;

OnTouch:
	if (ep17_2_bath == 1) {
		cloakoffnpcself( "Rookie#172ba02" );
		cloakoffnpcself( "Denny#172ba02" );
		cloakoffnpcself( "Molar#172ba02" );
		cloakoffnpcself( "Canine#172ba02" );
		cloakoffnpcself( "Danae#172ba02" );
		cloakoffnpcself( "Magenta#172ba02" );
		cloakoffnpcself( "Cyan#172ba02" );
		end;
	}
	if (ep17_2_bath == 4) {
		cloakoffnpcself( "Rookie#172ba02" );
		end;
	}
	end;

OnInit:
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "isbegin_quest(17363) == 1" );
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "isbegin_quest(17366) == 1" );
	end;
}

ba_bath,162,43,5	duplicate(dummy_cloaked_npc)	Danae#172ba02	4_F_REBELLION2
ba_bath,163,39,7	duplicate(dummy_cloaked_npc)	Canine#172ba02	4_F_REBELLION3
ba_bath,163,43,5	duplicate(dummy_cloaked_npc)	Denny#172ba02	4_M_REBELLION3
ba_bath,167,40,1	duplicate(dummy_cloaked_npc)	Magenta#172ba02	4_M_GUNSLINGER2
ba_bath,165,40,7	duplicate(dummy_cloaked_npc)	Molar#172ba02	4_M_REBELLION
ba_bath,163,41,7	duplicate(dummy_cloaked_npc)	Cyan#172ba02	4_F_REBELLION3

ba_bath,166,42,3	script(CLOAKED)	Rookie#172ba02	4_M_ROOKIE,{
	if (ep17_2_bath < 4) {
		cutin "16loo_01",2;
		mes "[菜鸟]";
		mes "可以吗？我会从这里的神殿拿蓝图。冒险者，请前往<NAVI>[锅炉房]<INFO>ba_bath,286,68,0,101,0</INFO></NAVI>，让他们关闭锅炉。我很快就追上你。";
		close3;
	}
	end;
}

// Sidequest quest : Exploring bathhouse - Step 3
// Daily : Boiler's request
ba_bath,286,68,5	script	Boiler#172ba02	4_EP17_BASIC_B,{
	if (checkweight(1201,3) == 0) {
		mes "你携带的物品太多，无法继续对话。";
		mes "请清理背包后再试。";
		close;
	}
	if (ep17_2_bath == 2) {
		cutin "ep172_beta",1;
		mes "[锅炉]";
		mes "呃，人类客人不该随便进来。这里并不牢固。";
		next;
		cutin "",255;
		select( "我有东西要检查。" );
		cutin "ep172_beta",1;
		mes "[锅炉]";
		mes "嗯……我无法阻止你。但要小心管道，碰错地方会融化皮肤。";
		mes "但这有什么意义？我们没有太多时间。";
		next;
		cutin "",255;
		select( "请关闭锅炉。" );
		mes "[锅炉]";
		mes "锅炉？^000CD已经停了^000000，对吧？真奇怪。蒸汽还在冒？锅炉没有工作吗？看这里，我是在它停止时检查的。";
		mes "是因为水还没冷却吗？总之，我已经关掉锅炉了。";
		next;
		cloakonnpcself();
		cloakoffnpcself( "Boiler#172ba03" );
		cutin "",255;
		mes "[锅炉]";
		mes "我觉得这应该很完美。哦……不完美，但有用。";
		next;
		cloakonnpcself( "Boiler#172ba03" );
		cloakoffnpcself();
		cutin "ep172_beta",1;
		mes "[锅炉]";
		mes "你来这里的路上常见这个吗？";
		next;
		cutin "",255;
		select( "不，我从没见过。" );
		cutin "ep172_beta",1;
		mes "[锅炉]";
		mes "嗯……我在来这里的路上捡到它，看起来像自动人偶的配件。外面有很多人偶，我以为到处都是。我本来想捡起来修理。";
		next;
		mes "[锅炉]";
		mes "顺便说，损坏的人偶仍在无序出现。为什么修好损坏的自动人偶后，坏人偶还会出现？错误会自我复制吗？";
		mes "我甚至无法好好清理。但无论如何必须做。谢谢你。";
		npctalk "我经常清理，但它们太多了。", "Sweep#172ba02", bc_self;
		next;
		mes "[锅炉]";
		mes "……你不走吗？我已经关掉锅炉了。你不是为此来的吗？";
		next;
		cutin "",255;
		select( "这是自动人偶吗？" );
		cutin "ep172_beta",1;
		mes "[锅炉]";
		mes "什么？怪物？";
		next;
		cutin "ep172_beta",2;
		mes "[清扫]";
		mes "我不这么认为。如果真是这样，你没想过我们会先发现吗？";
		next;
		cutin "ep172_beta",1;
		mes "[锅炉]";
		mes "外面的那些东西都是入侵者造成的……他们想让事情变成这样。";
		npctalk "邪恶的入侵者。他们摧毁了许多设施，甚至摧毁了我们中的一些人。我们正在恢复一切。", "", bc_self;
		next;
		cutin "",255;
		select( "你觉得怪物怎么样？" );
		cutin "ep172_beta",1;
		mes "[锅炉]";
		mes "也许是^0000CD锅炉里的幽灵^000000。";
		next;
		cutin "ep172_beta",2;
		mes "[清扫]";
		mes "你在说什么？";
		next;
		cutin "ep172_beta",1;
		mes "[锅炉]";
		mes "幽灵。你不知道什么是幽灵吗？你了解它吗，" + strcharinfo(0) + "？那是已经死去、没有实体却四处飘荡的东西。";
		mes "这里发生的事和幽灵人类所说的非常相似。";
		next;
		cutin "",255;
		select( "那么，幽灵的身份……" );
		cutin "ep172_beta",1;
		mes "[锅炉]";
		mes "嗯……我不认为是你想的那样。啊~我以为是人类幽灵。但不，我觉得那是我来之前负责这里的自动人偶。";
		mes "当时它是小型浴池锅炉，经常因为浴池太多而装满水，无法承受高压。";
		next;
		mes "[锅炉]";
		mes "总之，我修理时它爆炸了，另一只自动人偶被烧毁。也许就是那只人偶。";
		mes "不知道那只人偶的数据是否以某种未知方式刻在这台锅炉里。";
		next;
		mes "[锅炉]";
		mes "没人使用时，这台锅炉有时会自行移动，但我想过去自动人偶的数据仍在，并继续执行命令。";
		mes "这样就能解释无形的声音和噪音了。你也会因为冒出的蒸汽看到奇怪的形状。";
		next;
		cutin "",255;
		select( "真可怕。" );
		cutin "ep172_beta",1;
		mes "[锅炉]";
		mes "真可怕。这里的阀门以为它只是一台锅炉。可怕吗？阀门，看看这里。";
		next;
		cutin "ep172_omega",4;
		mes "[阀门]";
		mes "哔——";
		next;
		cutin "ep172_beta",2;
		mes "[清扫]";
		mes "锅炉幽灵，你觉得这合理吗？可能是因为我们还没发现问题，也可能是因为我们是自动人偶。";
		next;
		mes "[清扫]";
		mes "我们认为一定缺少什么，因为我们无法像人类客人一样听到声音或感受迹象。";
		next;
		mes "[清扫]";
		mes "但最后我们甚至没有注意到问题的存在。由于人偶的局限，我们可能永远找不到问题。";
		mes "所以我建议和客人一起寻找问题。";
		next;
		mes "[清扫]";
		mes "说实话，因为很久没有客人，我们不知道哪里奇怪。直到人类客人到来，注意人类和自动人偶的差异不是很合理吗？";
		next;
		mes "[清扫]";
		mes "我听说人类发展出了感官和情感，以及将它们结合起来的思考能力。";
		mes "我们只收集信息并得出结论，但人类不同。听说你们会汇集个人经历、思想和想象来得出结论。";
		next;
		mes "[清扫]";
		mes "希望我们能解决这个问题。";
		next;
		cutin "ep172_beta",0;
		mes "[锅炉]";
		mes "锅炉已经关闭。请告诉<NAVI>[其他客人]<INFO>ba_bath,270,94,0,101,0</INFO></NAVI>，让他们自由搜查。";
		ep17_2_bath = 3;
		erasequest 17364;
		setquest 17365;
		getitem 1000103,7;
		getexp2 260267,0;
		close3;
	}
	if (ep17_2_bath == 3) {
		cutin "ep172_beta",2;
		mes "[锅炉]";
		mes "Sweep，去见<NAVI>[其他客人]<INFO>ba_bath,270,94,0,101,0</INFO></NAVI>。我得盯着锅炉。如果发现什么，就回来告诉我，因为我很好奇。";
		close3;
	}
	if (ep17_2_bath < 13) {
		cutin "ep172_beta",2;
		mes "[锅炉]";
		mes "去别的地方看看比待在这里更好。";
		close3;
	}

	// Daily : Boiler's request
	if (isbegin_quest(17375) == 0) {
		npctalk "也许完成了！", "Valve#172ba01", bc_self;
		cloakonnpcself( "Valve#172ba01" );
		sleep2 1000;
		cutin "ep172_beta",2;
		mes "[锅炉]";
		mes "你对什么感到好奇？有什么想问我们的吗？";
		next;
		cutin "",255;
		if (select( "锅炉……", "关于药草……" ) == 2) {
			cutin "ep172_beta",2;
			mes "[锅炉]";
		mes "药草？你对浴池使用的药草感到好奇吗？为什么？是不喜欢浴池的水吗？";
			next;
			cutin "",255;
		select( "我很喜欢。" );
			cutin "ep172_beta",2;
			mes "[锅炉]";
		mes "你就是因为这个来的吗？";
			close3;
		}
		cutin "ep172_beta",2;
		mes "[锅炉]";
		mes "锅炉？你对锅炉感到好奇吗？为什么？你打算偷走锅炉吗？";
		next;
		cutin "",255;
		select( "偷锅炉？" );
		cutin "ep172_beta",2;
		mes "[锅炉]";
		mes "哦，我说错了吗？入侵者对锅炉和供应系统很感兴趣。他们瞒着我偷走了另一台锅炉。";
		mes "但是，" + strcharinfo(0) + "似乎对此不感兴趣。我只是想知道你是否想拿走锅炉。如果我错了就算了。";
		next;
		mes "[锅炉]";
		mes "但入侵者会用它做什么？你觉得他们打算建露天浴池吗？";
		mes "嗯……我真不知道他们能用锅炉做什么。你们人类能用它制造什么吗？你有主意吗，" + strcharinfo(0) + "？";
		next;
		cutin "",255;
		select( "他们还做了什么？" );
		cutin "ep172_beta",2;
		mes "[锅炉]";
		mes "嗯……我喜欢泡澡，但我更着迷于锅炉。他们似乎对净化设施感兴趣。";
		next;
		mes "[锅炉]";
		mes "我正兴奋地想解释锅炉，却不知道他们会偷走它。我真的不知道。人类是不是以随心所欲出名？";
		next;
		mes "[锅炉]";
		mes "" + strcharinfo(0) + "，你也是凭冲动行动吗？我还不太了解人类。还有很多东西需要知道。这就是我做准备的方式。我不会再让他们偷走它。";
		next;
		mes "[锅炉]";
		mes "比如，我的主人泡澡时说水很凉，但我自己泡时却热得不得了。是我把温度设错了吗？确实设错了，但对他来说不是。";
		next;
		mes "[锅炉]";
		mes "但他说很凉。这是什么意思？是我弄错了吗？";
		next;
		mes "[锅炉]";
		mes "还有，如果把这些干叶子泡在热水里，叶子的成分就会出来。但仅此而已。";
		mes "不过不知为何这对健康有益，所以我们在每个浴池里放草药叶。人类用皮肤呼吸吗？还是从皮肤喝水？";
		next;
		mes "[锅炉]";
		mes "人类喜欢泡在浴池里。为什么？";
		next;
		mes "[锅炉]";
		mes "哦，还有一件事！为什么要把磨碎的海藻放进浴池，再把水涂到脸上？";
		next;
		mes "[锅炉]";
		mes "我很好奇，就自己试了，但不知道有什么用。也许是因为我是自动人偶？";
		next;
		mes "[锅炉]";
		mes "如果我像人类一样拥有五感，也许能更理解人类。主人为什么没给我们这些？";
		next;
		cloakoffnpcself( "Valve#172ba01" );
		cutin "ep172_omega",4;
		mes "[阀门]";
		mes "都完成了。现在你得喝掉。";
		next;
		cutin "ep172_beta",2;
		mes "[锅炉]";
		mes "我不喝。没人会喝。";
		next;
		cutin "ep172_omega",4;
		mes "[阀门]";
		mes "还没准备好吗？不能喝一点吗？挤出来就能得到很多精华。";
		next;
		cutin "ep172_beta",2;
		mes "[锅炉]";
		mes "阀门，人类不是茶包。记住，我已经说过很多次了。";
		next;
		cloakonnpcself( "Valve#172ba01" );
		cloakoffnpcself( "Valve#172ba02" );
		cutin "ep172_omega",4;
		mes "[阀门]";
		mes "你只要把水煮好就行。";
		next;
		mes "[阀门]";
		mes "提高温度会更好。";
		cloakonnpcself();
		cloakoffnpcself( "Boiler#172ba03" );
		next;
		cutin "ep172_beta",2;
		mes "[锅炉]";
		mes "我不是叫你别碰锅炉吗。";
		next;
		specialeffect EF_PIERCE, AREA, "Valve#172ba02";
		mes "- 啊！-";
		next;
		mes "[锅炉]";
		mes "住手，过来这里。";
		next;
		cloakonnpcself( "Valve#172ba02" );
		cloakoffnpcself( "Valve#172ba01" );
		cloakonnpcself( "Boiler#172ba03" );
		cloakoffnpcself();
		mes "[锅炉]";
		mes "暂时安静一会儿也好。";
		next;
		cutin "",255;
		select( "看起来很危险，但处理……" );
		cutin "ep172_beta",2;
		mes "[锅炉]";
		mes "为什么要浪费！修好后仍然有用。你要是报废阀门，我和谁一起工作？我不喜欢陌生人。";
		next;
		cutin "",255;
		select( "你为什么不修好它？" );
		cutin "ep172_beta",2;
		mes "[锅炉]";
		mes "因为我不能放下锅炉不管？入侵者弄坏了锅炉和阀门，没时间修理。";
		next;
		mes "[锅炉]";
		mes "我一个人，而锅炉房需要两人运行，可现在只剩我。没时间修它。我可以把它送到别处，但担心他们会重写数据。";
		mes "没那么严重，我可以慢慢修。阀门没那么糟，只是偶尔碰到锅炉。我不太了解人类，但很了解草药和锅炉。";
		next;
		mes "[锅炉]";
		mes "但我还是得修好它。";
		mes "嗯……" + strcharinfo(0) + "？你有空吗？";
		next;
		cutin "",255;
		select( "为什么？" );
		cutin "ep172_beta",2;
		mes "[锅炉]";
		mes "如果有空，请帮帮我。我缺人手。阀门和锅炉都需要修理，但我一个人，其他人偶也很忙。";
		mes "真希望我有两个。哇……那不是很好吗？如果有两个我，这里会是最棒的锅炉房。";
		next;
		mes "[锅炉]";
		mes "我会请 Alpha 克隆我。不知道能不能做到，但按逻辑来说有两个我会更高效。";
		mes "不过现在能怎么办？没有另一个我。只能求助。所以有空请帮帮我。";
		next;
		cutin "",255;
		if (select( "I'll help you.", "I have to go take a bath." ) == 2) {
			cutin "ep172_beta",2;
			mes "[锅炉]";
			mes "真的吗？那我也没办法。你看起来也很累，我给你送些恢复用的草药。再见。";
			close3;
		}
		cutin "ep172_beta",2;
		mes "[锅炉]";
		mes "谢谢。那么你能处理 20 个^0000CD损坏的自动人偶^000000吗？我还需要 5 个^0000CD损坏的自动人偶零件^000000。";
		next;
		cutin "",255;
		select( "Sure." );
		cutin "ep172_beta",2;
		mes "[锅炉]";
		mes "好，那就拜托了。";
		setquest 17375;
		completequest 17375;
		setquest 17376;
		close3;
	}
	cutin "ep172_beta",2;
	mes "[锅炉]";
	mes "今天怎么来这里了？哦，是来工作的吗？";
	next;
	.@playtime = checkquest(17377,PLAYTIME);
	.@hunting = checkquest(17376,HUNTING);

	if (.@playtime == 0 || .@playtime == 1)
		.@menu$ = "^C0C0C0Help on work - Cooldown^000000";
	else if (.@hunting == 0 || .@hunting == 1)
		.@menu$ = "^C0C0C0Help on work - On Progress^000000";
	else
		.@menu$ = "Help on work";

	if (select( .@menu$, "I came to say hello." ) == 2) {
		mes "[锅炉]";
		mes "是啊，我不知道你为什么来。这里没有变化，我们还在处理锅炉。";
		close3;
	}
	if (.@playtime == 0 || .@playtime == 1) {
		mes "[锅炉]";
		mes "嗯……我听说人类工作过度很容易坏掉。请去休息，天亮后再回来。";
		close3;
	}
	switch( .@hunting ) {
	case -1:
		if (select( "Let me handle it.", "I'l like to take a break today." ) == 2) {
			mes "[锅炉]";
			mes "真奇怪。我以为你来找我就是想工作，对吧？好吧，我明白了。";
			close3;
		}
		mes "[锅炉]";
		mes "怎么会有这么真诚的人类？那么今天也请处理 20 个^0000CD损坏的自动人偶^000000，并带来 5 个^0000CD损坏的自动人偶零件^000000。";
		setquest 17376;
		if (isbegin_quest(17377) == 1)
			erasequest 17377;
		close3;
	case 0:
	case 1:
		mes "[锅炉]";
		mes "工作完成了吗？";
		next;
		mes "[锅炉]";
		if (countitem(1000231) < 5) {
			mes "在哪里？我们需要 5 个损坏的自动人偶零件。我觉得你的背包有洞，应该检查一下。";
			close3;
		}
		mes "你处理了 20 个损坏的自动人偶吗？你哪里受伤了吗？";
		close3;
	case 2:
		if (countitem(1000231) < 5) {
			mes "[锅炉]";
			mes "在哪里？我们需要 5 个损坏的自动人偶零件。我觉得你的背包有洞，应该检查一下。";
			close3;
		}
		mes "[锅炉]";
		mes "工作完成了吗？";
		next;
		mes "[锅炉]";
		mes "你带来了很多。好吧，我用这张巴米尔票券交换。谢谢。";
		erasequest 17376;
		setquest 17377;
		delitem 1000231,5;
		getitem rand(100147,100149),1;
		getitem 1000103,2;
		getexp 834974,584500;
		close3;
	}
	end;

OnInit:
	// Sidequest quest : Exploring bathhouse
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "isbegin_quest(17364) == 1" );

	// Daily
	questinfo( QTYPE_DAILYQUEST, QMARK_YELLOW, "isbegin_quest(17374) == 2 && checkquest(17376,HUNTING) == -1 && checkquest(17377,PLAYTIME) == -1" );
	questinfo( QTYPE_DAILYQUEST, QMARK_YELLOW, "checkquest(17377,PLAYTIME) == 2" );
	questinfo( QTYPE_QUEST2, QMARK_YELLOW, "checkquest(17376,HUNTING) == 2 && countitem(1000231) >= 5" );
	end;
}


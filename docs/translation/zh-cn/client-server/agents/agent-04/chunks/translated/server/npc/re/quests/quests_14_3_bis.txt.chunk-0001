//===== rAthena Script =======================================
//= Flame Basin Quests
//===== Description: =========================================
//= [Official Conversion]
//= Quests NPCs from Flame Basin
//===== Changelogs: ==========================================
//= 1.0 First version. Thanks to Dia from https://www.divine-pride.net/ ! [Capuche]
//= 1.1 Added Dimensional Travel Quest. [Capuche]
//= 1.2 Added Flaming Basin and Doom Prayers quests. [Capuche]
//============================================================

moro_vol,94,110,5	script	Guardian Nidhogg#143nyd01	4_F_NYDHOG,{
	mes "[Nidhogg]";
	if (ep4_3_mockill == 0) {
		mes "我们很快会面对决定性战争。";
		mes "我会尽力履行守护者职责。";
		cutin "ep14_nyd04.bmp",2;
		next;
		mes "[Nidhogg]";
		mes "我正在准备礼物，弥补过去对你的冒犯。";
		close3;
	}
	if ($ep143_3_expbuff == 1) {
		mes "希望你喜欢我的礼物。伊格德拉希尔的祝福不会永远持续，";
		mes "但至少足够你和队伍在战斗中得到帮助。";
		cutin "ep14_nyd04.bmp",2;
		close3;
	}
	if (ep4_3_mockill == 1 && countitem(6715) > 0) {
		mes "哦，这是他的一块灵魂碎片。";
		mes "他注定永远在自己心中创造的世界里游荡。";
		mes "复仇已经完成，但结果没有我想象的那么令人满意。";
		cutin "ep14_nyd01.bmp",2;
		next;
		mes "[Nidhogg]";
		mes "我可以要这块灵魂碎片吗？";
		mes "作为交换，我会给你和你的队伍";
		mes "我能给出的最大礼物。";
		cutin "ep14_nyd03.bmp",2;
		next;
		if (select( "交出灵魂碎片。", "拒绝。" ) == 2) {
			mes "[Nidhogg]";
			mes "小心恶魔之神对你的负面影响。";
			cutin "ep14_nyd04.bmp",2;
			close3;
		}
		if ($ep143_3_expbuff == 1) {
			mes "[Nidhogg]";
			mes "哦，你已经获得伊格德拉希尔的祝福。";
			mes "这件事下次再说吧。";
			cutin "ep14_nyd01.bmp",2;
			close3;
		}
		cutin "ep14_nyd04.bmp",2;
		mes "[Nidhogg]";
		mes "谢谢。";
		mes "愿伊格德拉希尔祝福你。";
		delitem 6715,1;// P_Of_Evil_Soul
		$ep143_3_expbuff = 1;
		$ep143_3_exptime = 0;
		ep4_3_mockill = 2;
		announce "尼德霍格：愿伊格德拉希尔祝福恶魔之神的讨伐者 " + strcharinfo(0) + " 及其他人。", bc_all, "0xFF0000";
		donpcevent "Loki#1432loki01::OnEventOn";
		next;
		mes "^4d4dff干得好，消灭了恶魔之神摩洛克。服务器经验率提高 10%，持续约 1 小时。^000000";
		close3;
	}
	mes "我不明白；";
	mes "我非常想把他从这个世界清除，";
	mes "但内心却感到空虚。";
	cutin "ep14_nyd02.bmp",2;
	next;
	mes "[Nidhogg]";
	mes "这一定就是";
	mes "这就是人们一夜之间失去工作时的感受。";
	cutin "ep14_nyd01.bmp",2;
	next;
	mes "[Nidhogg]";
	mes "至少我存够了钱";
	mes "这样一段时间没有工作也没关系。";
	cutin "ep14_nyd04.bmp",2;
	close3;

OnEventOn:
	if ($ep143_3_expbuff == 1) {
		initnpctimer;
		setbattleflag( "quest_exp_rate", getbattleflag("quest_exp_rate") + 10 );
		setbattleflag( "base_exp_rate", getbattleflag("base_exp_rate") + 10 );
		setbattleflag( "job_exp_rate", getbattleflag("job_exp_rate") + 10 );
	}
	end;
OnTimer60000:
	if ($ep143_3_exptime < 60) {
		$ep143_3_exptime++;
		initnpctimer;
	}
	else
		donpcevent "Guardian Nidhogg#143nyd01::OnStop";
	end;
OnStop:
	stopnpctimer;
	if ($ep143_3_expbuff == 1) {
		$ep143_3_expbuff = 0;
		$ep143_3_exptime = 0;
		setbattleflag( "quest_exp_rate", getbattleflag("quest_exp_rate") - 10 );
		setbattleflag( "base_exp_rate", getbattleflag("base_exp_rate") - 10 );
		setbattleflag( "job_exp_rate", getbattleflag("job_exp_rate") - 10 );
	}
	end;
OnInit:
	if ($ep143_3_expbuff == 1)
		initnpctimer;
	end;
OnInterIfInitOnce:
	if ($ep143_3_expbuff == 1)
		donpcevent "Guardian Nidhogg#143nyd01::OnEventOn";
	end;
}

moro_vol,97,110,3	script	Loki#1432loki01	4_M_ROKI2,{
	cutin "ep14_roki01.bmp",2;
	mes "[Loki]";
	mes "事情还没有真正开始；";
	mes "只有当他的真面目暴露时才会开始。";
	close3;

OnEventOn:
	initnpctimer;
	end;
OnTimer5000:
	announce "由于击败了摩洛克，你获得了持续 1 小时的额外 10% 服务器经验奖励。", bc_all, "0xFF0000";
	end;
OnTimer11500:
	announce " ", bc_all, "0xFF0000";
	end;
OnTimer12000:
	donpcevent "Guardian Nidhogg#143nyd01::OnEventOn";
	stopnpctimer;
	end;
}

moro_vol,98,107,3	script	Magic Scholar#143avt01	4_M_FAIRYAVANT,{
	if (checkweight(1304,3) == 0) {
		mes "你携带的物品太多，无法继续任务。";
		mes "请在物品栏中腾出空间。";
		close;
	}
	cutin "avant01.bmp",1;
	if (ep14_2_mylord < 33) {
		mes "[Magic Scholar]";
		mes "别烦我。";
		mes "如果你是来为我的实验捐献身体，可以留下。";
		mes "否则滚！";
		close3;
	}
	if (ep14_2_mylord == 33) {
		mes "[Avant]";
		mes "新手，你来做什么？";
		mes "你像其他人一样来嘲笑我的悲惨吗？";
		next;
		select( "你为什么在这里？", "你后悔自己做过的事吗？" );
		mes "[Avant]";
		mes "*Snort*";
		mes "这是尊严问题。";
		mes "我承认我的行为让同胞陷入危险。";
		next;
		cutin "avant02.bmp",1;
		mes "[Avant]";
		mes "我想说，我这么做是为了弥补自己的过错，";
		mes "正如所有人希望相信的那样。*冷笑*";
		next;
		mes "[Avant]";
		mes "但如果对自己诚实，";
		mes "我这么做是为了报复把我当工具的 Shnaim 和摩洛克。";
		next;
		mes "[Avant]";
		mes "我打算在一切结束后成为最后站着的人。";
		ep14_2_mylord = 34;
		close3;
	}
	if (BaseLevel < 140) {
		mes "[Avant]";
		mes "我不需要弱者。";
		mes "变强后再回来。";
		close3;
	}
	switch( checkquest(7584,PLAYTIME) ) {
	case -1:
		if (isbegin_quest(7583) == 1) {// Collecting Mana
			if (countitem(6708) > 2) {
				mes "[Avant]";
				mes "不错，新手。";
				mes "把魔力结晶给我。";
				mes "干得好。";
				delitem 6708, countitem(6708);// Mana_crystal
				erasequest 7583;// Collecting Mana
				setquest 7584;// Unending Battle
				getexp 350000,350000;
				close3;
			}
			mes "[Avant]";
			mes "菜鸟，击败那些强大的恶魔后，你会找到魔力结晶。";
			mes "我要你带给我，";
			mes "至少一次带三颗。明白了吗？";
			close3;
		}
		if (checkquest(7581,HUNTING) == 0 || checkquest(7581,HUNTING) == 1) {
			mes "[Avant]";
			mes "嘿，新手。";
			mes "你看到那些巨大的恶棍了吗？";
			mes "如果你狩猎那些扭曲、";
			next;
			mes "[Avant]";
			mes "炽热和冰冻的转生体，就会找到魔力结晶。";
			mes "这些结晶是从宝珠中窃取的部分魔力，";
			mes "正是它们让那些小恶魔变得如此强大。";
			next;
			mes "[Avant]";
			mes "我要你";
			mes "消灭它们，把魔力结晶带给我。";
			mes "别想把结晶私藏：它们对你没用。";
			next;
			mes "[Avant]";
			mes "三个转生体，所以是三颗魔力结晶。";
			mes "至少把它们带给艾尔帕兰的 Kardui。";
			setquest 7583;// Collecting Mana
			close3;
		}
		mes "[Avant]";
		mes "嗯，我不知道这么少的魔力也能产生";
		mes "如此强大的力量。";
		mes "肮脏的恶魔。";
		close3;
	case 0:
	case 1:
		mes "[Avant]";
		mes "希望你下次讨伐时还能回来。";
		close3;
	case 2:
		mes "[Avant]";
		mes "人类联盟很快会派出恶魔讨伐队。离开前过来一趟。";
		mes "你想收集魔力，对吧？";
		erasequest 7584;
		close3;
	}
	end;

OnInit:
	questinfo( QTYPE_QUEST2, QMARK_NONE, "BaseLevel >= 140 && ep14_2_mylord > 33 && !isbegin_quest(7583) && !isbegin_quest(7584) && isbegin_quest(7581) == 1" );
	end;
}

moro_vol,95,108,7	script	Hishieh#143hisie01	4_M_FARIY_HISIE,{
	cutin "hisie01.bmp",0;
	mes "[Hishieh]";
	if (ep14_2_mylord < 15) {
		mes "你是人类联盟的人吗？";
		mes "我不记得曾请求过你的帮助。";
		next;
		mes "[Hishieh]";
		mes "如果发生什么事，我会通知你的总司令 Hibba Agip。";
		close3;
	}
	if (ep14_2_mylord < 33) {
		mes "我们真的能在这里了解恶魔之神的真相吗？";
		mes "里面充满了我从未见过的生物。";
		next;
		mes "[Hishieh]";
		mes "真诡异……";
		close3;
	}
	if (ep14_2_mylord == 33) {
		mes "所有坏事的始作俑者真的藏在这里，对吧？";
		mes "真令人兴奋！";
		next;
		mes "[Hishieh]";
		mes "哦，我为什么会在这里？";
		mes "我是替 Kar 来的。";
		mes "他不能离开艾可拉治，因为宝珠无法继续为这里供应魔力。";
		next;
		mes "[Hishieh]";
		mes "我们的首要任务是伊格德拉希尔和她的守护者。";
		mes "而且我们绝不能失去新任市长。";
		next;
		cutin "hisie04.bmp",0;
		mes "[Hishieh]";
		mes "我说服了长老们，让我指挥军队，";
		mes "但我仍然只是名义上的指挥官。";
		next;
		select("Avant 怎么了？");
		cutin "hisie02.bmp",0;
		mes "[Hishieh]";
		mes "Hm...";
		mes "我们正在利用他的知识。";
		mes "我们本可以杀了他，但那样太便宜他了。";
		next;
		mes "[Hishieh]";
		mes "我想这算是一种复仇吧，嗯？";
		mes "毕竟，他唯一的过错就是太热爱自己的科学。";
		next;
		mes "[Hishieh]";
		mes "连长老们也承认他的才能，决定救他一命。";
		mes "最重要的是……";
		next;
		mes "[Hishieh]";
		mes "(Lowering his voice)";
		mes "没有其他人知道宝珠的魔力被偷了。";
		mes "在其他人看来，Avant 只负责我和 Kar。";
		next;
		mes "[Hishieh]";
		mes "Avant 就在那边。想问问题的话可以去找他。";
		mes "哈哈。";
		close3;
	}
	switch( checkquest(7600,PLAYTIME) ) {
	case -1:
		switch( checkquest(7595,HUNTING) ) {
		case -1:
			if (isbegin_quest(7593) == 1) {
				mes "恶魔之神神殿？好吧，如果你在那里发现宝珠逸散的魔力，能处理一下吗？";
				mes "我不知道魔力现在会呈现什么形态，但你不会把它误认成其他东西。";
				next;
				mes "[Hishieh]";
				mes "如果你发现宝珠逸散的魔力，请攻击并驱散它。";
				mes "它会自行回到伊格德拉希尔和宝珠那里。";
				mes "你能帮我们吗？";
				next;
				if (select( "乐意效劳。", "抱歉。" ) == 2) {
					cutin "hisie02.bmp",0;
					mes "[Hishieh]";
					mes "别担心。";
					mes "我会找别人帮忙。";
					mes "没事的。";
					close3;
				}
				mes "[Hishieh]";
				mes "我欠你太多了，";
				mes "不知道该如何报答你。";
				mes "谢谢。";
				next;
				mes "[Hishieh]";
				mes "请释放 3 个闪耀魔力、3 个生命魔力和 3 个大地魔力。";
				mes "我就拜托你了。";
				mes "听到了吗？一定要平安回来。";
				setquest 7595;// Wandering Orb Magic
				close3;
			}
			mes "Avant 比任何人都更了解宝珠的魔力。";
			mes "连 Kar 和我都几乎无法忍受 Avant，但他确实需要你的帮助。";
			next;
			mes "[Hishieh]";
			mes "这不仅是收集宝珠魔力的问题，也关系到恶魔之神。";
			mes "我的大多数族人还不知道宝珠的核心魔力被偷走了。";
			next;
			cutin "hisie02.bmp",0;
			mes "[Hishieh]";
			mes "我希望继续隐瞒下去。";
			mes "请帮助我们。";
			mes "Kar 和我真的需要你。";
			close3;
		case 0:
		case 1:
			mes "你只要击打并驱散恶魔之神神殿中移动的魔力球。";
			mes "这样魔力就会回到伊格德拉希尔。";
			next;
			mes "[Hishieh]";
			mes "如果你发现凝固且不动的魔力，";
			mes "只要触碰它并吸收即可。";
			next;
			mes "[Hishieh]";
			mes "它对我们已经没有用，但你可以用它";
			mes "来对抗恶魔。";
			close3;
		case 2:
			cutin "hisie04.bmp",0;
			mes "干得好！";
		mes "我感觉到魔力正在回归。";
			mes "你做得很好。Kar 一定会很兴奋！";
			next;
			cutin "hisie01.bmp",0;
			mes "[Hishieh]";
			mes "这不算什么，但我想送给你。";
			mes "希望你喜欢。";
		mes "大量魔力已经从宝珠中逸散出来。";
			next;
			mes "[Hishieh]";
		mes "如果你打算再次进入恶魔之神神殿，请寻找更多魔力球。";
			mes "你现在应该去休息。";
			erasequest 7595;// Wandering Orb Magic
			setquest 7600;// Promising Tomorrow
			getitem 22567,1;// Squad_Prize
			getexp 1000000,500000;
			close3;
		}
	case 0:
	case 1:
		mes "宝珠逸散的魔力球还没有全部回收，";
		mes "但我们正在取得进展。";
		mes "如果你明天能回来再次帮助我们，我会非常感激。";
		close3;
	case 2:
		erasequest 7600;// Promising Tomorrow
		mes "如果你打算再次进入恶魔之神神殿，我想拜托你一件事。";
		mes "是的，还是我之前拜托你的事：";
		mes "归还魔力。";
		next;
		mes "[Hishieh]";
		mes "如果你想帮助我们，再来和我谈谈。";
		close3;
	}
	end;

OnInit:
	questinfo( QTYPE_QUEST2, QMARK_NONE, "BaseLevel >= 160 && ep14_2_mylord > 33 && !isbegin_quest(7595) && !isbegin_quest(7600) && isbegin_quest(7593) == 1" );
	end;
}

moro_vol,108,88,5	script	Commander Hibba Agip#14301	4_M_REDSWORD,{
	cutin "ep13_captin_edq.bmp",2;
	mes "[Hibba Agip]";
	if (ep14_3_mors01 == 0 || BaseLevel < 160) {
		mes "这个地方诡异得难以理解。";
		mes "摩洛克就在这里某处。";
		next;
		mes "[Hibba Agip]";
		mes "这里确实阴森得足以让他这样的人徘徊。";
		mes "那些东西一定是从梦罗克沙漠拖来的，然后被他的邪恶能量污染。";
		next;
		mes "[Hibba Agip]";
		mes "唉……";
		mes "前方还有漫长曲折的道路。";
		mes "...";
		next;
		mes "[Hibba Agip]";
		mes "唉。";
		mes "需要你的时候我会叫你。";
		mes "在那之前，专心活下去。";
		close3;
	}
	if (ep4_3_mockill == 0) {
		if (isbegin_quest(7597) == 1) {
			mes "啊，我们的英雄回来了！";
			mes "哇哈哈哈，我们终于到达探险终点了！";
			mes "干得好！";
			mes "我谨代表全人类感谢你。";
			next;
			mes "[Adjutant Abidal]";
			mes "你真了不起！";
			mes "你拯救了世界！";
			mes "之后我要回家了……";
			next;
			mes "[Hiva Agip]";
			mes "Abidal，够了！";
			mes "你是想立旗吗？！";
			next;
			mes "[Hiva Agip]";
			mes "这不算什么，但我想送给你。";
			mes "感谢你的服务。";
			mes "哈哈。";
			mes "我终于可以睡觉了！";
			next;
			mes "[Hiva Agip]";
			mes "等等，我感觉你周围有不祥的东西……";
			mes "天啊，这是什么？！";
			mes "你是想让自己的灵魂被恶魔之神吞噬吗？！";
			next;
			mes "[Hiva Agip]";
			mes "把它给我，我会帮你结晶。";
			mes "我还想让你去见拉斐尔营地的那位守护者女士。";
			mes "她也许知道这件事。";
			ep4_3_mockill = 1;
			erasequest 7597;// Fall of the False God
			setquest 7598;// Caged God
			getitem 22567,1;// Squad_Prize
			getitem 6715,1;// P_Of_Evil_Soul
			getexp 1000000,500000;
			close3;
		}
		if (isbegin_quest(7593) == 1) {
			mes "恶魔之神神殿位于中央山丘的洞穴中。";
			mes "一棵树挡住了神殿入口。";
			next;
			mes "[Hibba Agip]";
			mes "那个被称为守护者的紫色女士说她很快会去那里。";
			mes "你应该找到她。";
			close3;
		}
		mes "幸会。";
		mes "我听说那座黑暗洞窟里的道路已经清理出来了。";
		mes "有时我觉得这个被诅咒的盆地是活的。";
		next;
		mes "[Hibba Agip]";
		mes "你聪明又有能力。我没必要解释为什么告诉你这些，对吧？";
		mes "别担心。我已经派出了先遣队。";
		next;
		mes "[Hibba Agip]";
		mes "高兴起来吧，同志！";
		mes "我们的危险旅程很快就要结束了！";
		mes "而你将是结束这一切的人。";
		next;

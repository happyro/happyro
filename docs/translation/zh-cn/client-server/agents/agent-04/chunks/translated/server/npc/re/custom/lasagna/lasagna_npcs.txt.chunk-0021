
// in E_F
conch_in,59,91,5	script	Passenger#dorcon04	4_F_ALCHE_A,{
	setpcblock PCBLOCK_NPC, true;
	npctalk "要去米德加尔特？这是我第一次来拉萨格纳，真的很棒！所以我打算永远住在这里。我找到了住处，也签好了文件！", "", bc_self;
	sleep2 2000;
	npctalk "我要去米德加尔特收拾东西。这里真的很棒。", "", bc_self;
	setpcblock PCBLOCK_NPC, false;
	end;
}

// in_I_J
conch_in,97,96,5	script	Merchant#dorcon01	4_M_MERCAT2,{
	setpcblock PCBLOCK_NPC, true;
	npctalk "从这捆货物就能看出来吧？我不是菜鸟冒险者，而是到处旅行做买卖的商人。", "", bc_self;
	sleep2 2000;
	npctalk "我听说新世界没有伊格德拉希尔，所以那里很稀有。我要试着拿去卖。", "", bc_self;
	sleep2 2000;
	npctalk "如果还有其他能卖的东西，我也会买一些带去那里卖。我要成为百万富翁。", "", bc_self;
	setpcblock PCBLOCK_NPC, false;
	end;
}

// in_N_M
conch_in,135,91,5	script	Passenger#dorcon01	4_CAT_ADV2,{
	npctalk "新世界的人找我做什么？", "", bc_self;
	end;
}
conch_in,135,93,5	script	Passenger#dorcon03	4_DR_TORTEL,{
	setpcblock PCBLOCK_NPC, true;
	npctalk "这是你第一次乘坐康奇利纳号吗？训练结束后我曾乘这艘船去新世界。那时的食物非常好，所以……", "", bc_self;
	sleep2 2000;
	npctalk "我一登陆新世界就立刻回船上了。我太喜欢那里的食物……", "", bc_self;
	setpcblock PCBLOCK_NPC, false;
	end;
}
conch_in,137,98,3	script	Passenger#dorcon02	4_DR_F_01,{
	setpcblock PCBLOCK_NPC, true;
	npctalk "这是我第一次去新世界，我非常兴奋。你决定到那里后先做什么了吗？我想先去雷神山脉！", "", bc_self;
	sleep2 2000;
	npctalk "我在《新世界新冒险者指南》上看到它的那一刻，就发誓一定要去！听说那里的风景美极了！", "", bc_self;
	setpcblock PCBLOCK_NPC, false;
	end;
}

// in_P_O
conch_in,169,70,3	script	Crewman#dorcon02	4_CAT_SAILOR2,{
	setpcblock PCBLOCK_NPC, true;
	npctalk "米德加尔特已经被发现了，不知道外面是否还有其他地方。那里从未有人去过，也不在地图上。", "", bc_self;
	sleep2 2000;
	npctalk "你觉得有这样的地方吗？", "Crewman#dorcon03", bc_self;
	sleep2 2000;
	npctalk "在被发现之前，我们根本不知道米德加尔特存在。我确信外面还有我们不知道的地方。", "", bc_self;
	sleep2 2000;
	npctalk "你觉得它也在寻找我们吗？", "Crewman#dorcon03", bc_self;
	sleep2 2000;
	npctalk "哦，光是想到它我的心就怦怦直跳。", "", bc_self;
	setpcblock PCBLOCK_NPC, false;
	end;
}
conch_in,166,68,6	script	Crewman#dorcon03	4_CAT_SAILOR1,{
	setpcblock PCBLOCK_NPC, true;
	npctalk "你知道吗，我觉得斯泰罗大副也许能找到一条地图上没有的通往新世界的航线。", "", bc_self;
	sleep2 2000;
	npctalk "确实，如果它存在，我们总有一天能找到并乘船前往！", "Crewman#dorcon02", bc_self;
	sleep2 2000;
	npctalk "我应该长久留在康奇利纳号上，见证我们发现新大陆的时刻。", "", bc_self;
	setpcblock PCBLOCK_NPC, false;
	end;
}

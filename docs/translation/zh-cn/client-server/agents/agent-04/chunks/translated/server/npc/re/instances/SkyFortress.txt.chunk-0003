// Cursed Knight
1@sthc,16,132,4	script	Sky Fortress Treasure Box	CLEAR_NPC,{
	mes "- 你找到了 -";
	mes "- 闪耀的宝箱。 -";
	next;
	if (select( "打开宝箱。", "不要打开宝箱。" ) == 2) {
		mes "- 如果打开宝箱， -";
		mes "- 里面一定有好东西。 -";
		close;
	}
	if (is_party_leader() == false) {
		mes "- 除队长以外的人 -";
		mes "- 似乎无法打开宝箱。 -";
		close;
	}
	if (checkweight(2655,1) == 0) {
		mes "- 里面装满了物品 -";
		mes "- 所以无法打开。 -";
		close;
	}
	mes "- 宝箱正在打开 -";
	mes "- 某种东西突然 -";
	mes "- 出现在面前。 -";
	specialeffect EF_SILENT_BREEZE;
	specialeffect EF_LOCKON;
	unittalk getcharid(3), "" + strcharinfo(0) + "：你可能碰错了什么……";
	disablenpc instance_npcname("Sky Fortress Treasure Box");
	stopnpctimer;
	donpcevent instance_npcname("Immortal Cursed Knight#") + "::OnEvent";
	close;
OnStart:
	enablenpc instance_npcname("Sky Fortress Treasure Box");
	initnpctimer;
	end;
OnTimer8000:
	specialeffect EF_LIGHTSPHERE2;
	end;
OnTimer9000:
	initnpctimer;
	end;
}

1@sthc,16,129,4	script	Immortal Cursed Knight#	4_AS_BLOODY_KNIGHT,{
	end;
OnEvent:
	enablenpc instance_npcname("Immortal Cursed Knight#");
	sleep 2000;
	npctalk "不朽诅咒骑士：什么入侵者想唤醒我……";
	sleep 2000;
	npctalk "不朽诅咒骑士：觊觎要塞宝藏的小偷必将毁灭……";
	sleep 2000;
	disablenpc instance_npcname("Immortal Cursed Knight#");
	monster 'sthc_map$,16,129,"Immortal Cursed Knight",3474,1, instance_npcname("Immortal Cursed Knight#") + "::OnKnightB";	// AS_BLOODY_KNIGHT
	'cursed_knight = $@mobid[0];
	initnpctimer;
	end;
OnTimer2000:
	if (mobcount('sthd_map$, instance_npcname("Immortal Cursed Knight#") + "::OnKnightB") < 1) {
		stopnpctimer;
		'cursed_knight = 0;
		mapannounce 'sthc_map$, "斯特凡·杰克·欧内斯特·沃尔夫：倒下了……不朽诅咒骑士……悲伤……要杀死……入侵者……", bc_map,0xEBFF;
		end;
	}
	if ('cursed_knight > 0) {
		.@r = rand(30);
		if (.@r == 0)
			unittalk 'cursed_knight, "不朽诅咒骑士：荣耀归于 Bijou！入侵者死！";
		else if (.@r == 1)
			unittalk 'cursed_knight, "不朽诅咒骑士：凡人面对不朽骑士不过是一把灰烬！";
		else if (.@r == 2)
			unittalk 'cursed_knight, "不朽诅咒骑士：我不能……我似乎无法控制这股力量！";
	}
	end;
OnTimer3000:
	initnpctimer;
	end;
OnKnightB:
	end;
}

// Wind Ghost
1@sthc,16,54,4	script	Wind Ghost in Experiment	CLEAR_NPC,{
	if (select( "检查试管。", "不要检查试管。" ) == 2) {
		mes "- 我确定里面有某种 -";
		mes "- 极其可怕的东西。 -";
		close;
	}
	if (is_party_leader() == false) {
		mes "- 除队长以外的人 -";
		mes "- 似乎无法操作试管。 -";
		close;
	}
	mes "- 试管正在打开 -";
	mes "- 某种东西突然 -";
	mes "- 出现在面前。 -";
	specialeffect EF_SILENT_BREEZE;
	specialeffect EF_LOCKON;
	unittalk getcharid(3), "" + strcharinfo(0) + "：这……这是什么？", bc_self;
	donpcevent instance_npcname("Immortal Wind Ghost#01") + "::OnEvent";
	stopnpctimer;
	disablenpc instance_npcname("Wind Ghost in Experiment");
	close;
OnStart:
	enablenpc instance_npcname("Wind Ghost in Experiment");
	initnpctimer;
	end;
OnTimer8000:
	specialeffect EF_LIGHTSPHERE2;
	end;
OnTimer9000:
	initnpctimer;
	end;
}

1@sthc,15,49,4	script	Immortal Wind Ghost#01	4_AS_WIND_GHOST,{
	end;
OnEvent:
	enablenpc instance_npcname("Immortal Wind Ghost#01");
	sleep 2000;
	npctalk "不朽风之鬼：愚蠢的人类……你在祈求死亡……";
	sleep 2000;
	npctalk "不朽风之鬼：体内沸腾的力量……感觉真好……";
	sleep 2000;
	disablenpc instance_npcname("Immortal Wind Ghost#01");
	monster 'sthc_map$,15,49,"Immortal Wind Ghost",3475,1, instance_npcname("Immortal Wind Ghost#01") + "::OnWindDead";	// AS_WIND_GHOST
	'wind_ghost = $@mobid[0];
	initnpctimer;
	end;
OnTimer2000:
	if (mobcount('sthd_map$, instance_npcname("Immortal Wind Ghost#01") + "::OnWindDead") < 1) {
		stopnpctimer;
		'wind_ghost = 0;
		mapannounce 'sthc_map$, "斯特凡·杰克·欧内斯特·沃尔夫：实验……变强了……不朽风之鬼……死了……所有人都得死……", bc_map,0xEBFF;
		end;
	}
	if ('wind_ghost > 0) {
		.@r = rand(30);
		if (.@r == 0)
			unittalk 'wind_ghost, "不朽风之幽灵：我感觉体内充满了更多力量……";
		else if (.@r == 1)
			unittalk 'wind_ghost, "不朽风之幽灵：我会慢慢杀死你……从你的肺部深处开始……";
		else if (.@r == 2)
			unittalk 'wind_ghost, "不朽风之幽灵：胆敢反抗我的人类只有死亡在等待……";
	}
	end;
OnTimer3000:
	initnpctimer;
	end;
OnWindDead:
	end;
}



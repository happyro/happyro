// Treasure Room Exit
//============================================================
gefg_cas05,149,107,0	script	#lever_G05	111,{
	mes " ";
	mes "这里有一个小拉杆。要拉动它吗？";
	next;
	if(select("拉动。:不拉。") == 1) {
		close2;
		warp "gefg_cas05",70,53;
		end;
	}
	close;
}


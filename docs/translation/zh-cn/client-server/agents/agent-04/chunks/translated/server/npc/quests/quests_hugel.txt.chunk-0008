			mes "- *咔嚓 咔嚓* -";
			mes "- *咔嚓 咔嚓* -";
			mes "- *咔嚓 咔嚓* -";
			specialeffect2 EF_CONE;
			next;
			if (rand(1,5) > 4) {
				mes "- 你笨手笨脚弄坏了蘑菇，采集失败。-";
				specialeffect2 EF_STUNATTACK;
				close;
			}
			mes "- 你成功采集了蘑菇。-";
			specialeffect2 EF_VALLENTINE2;
			set hg_tre,hg_tre+1;
			if (hg_tre == 11)
				mes "已收集莫克蘑菇溶液：1个";
			else if (hg_tre == 12)
				mes "已收集莫克蘑菇溶液：2个";
			else if (hg_tre == 13)
				mes "已收集莫克蘑菇溶液：3个";
			else if (hg_tre == 14)
				mes "已收集莫克蘑菇溶液：4个";
			else if (hg_tre == 15)
				mes "已收集莫克蘑菇溶液：5个";
			initnpctimer;
			disablenpc "Moks Mushrooms#Mush1";
			close;
		case 2:
			mes "- 你决定路过。-";
			close;
		}
	} else if (hg_tre == 15) {
		mes "["+strcharinfo(0)+"]";
		mes "我想这样就够了。";
		close;
	}

OnTimer20000:
	enablenpc "Moks Mushrooms#Mush1";
	stopnpctimer;
	end;
}


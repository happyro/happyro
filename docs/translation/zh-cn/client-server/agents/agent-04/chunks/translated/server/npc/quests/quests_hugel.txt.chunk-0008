hu_fild06,155,309,1	script	Moks Bugs#Bug1	1053,{
	if (hg_tre > 29 && hg_tre < 35) {
		mes "- 你在灌木丛中发现了棕色的大莫克斯虫。 -";
		next;
		switch(select("Catch them.:Pass.")) {
		case 1:
			mes "- 你紧张地把手伸向莫克斯虫。-";
			next;
			mes "- *Whizz Whizz*-";
			next;
			mes "- *Whizz Whizz Bzzzz* -";
			mes "- *Whizz Whizz*-";
			next;
			mes "- *Whizz Whizz Bzzzz* -";
			mes "- *Whizz Whizz*-";
			mes "- *Whizz Whizz*-";
			specialeffect2 EF_CONE;
			next;
			if (rand(1,5) > 4) {
				mes "- 虫子迅速逃走了。你收集虫壳失败。 -";
				specialeffect2 EF_STUNATTACK;
				close;
			}
			mes "- 你成功收集了莫克斯虫壳。 -";
			specialeffect2 EF_VALLENTINE2;
			set hg_tre,hg_tre+1;
			if (hg_tre == 31)
				mes "已收集莫克斯虫壳：1 个";
			else if (hg_tre == 32)
				mes "已收集莫克斯虫壳：2 个";
			else if (hg_tre == 33)
				mes "已收集莫克斯虫壳：3 个";
			else if (hg_tre == 34)
				mes "已收集莫克斯虫壳：4 个";
			else if (hg_tre == 35)
				mes "已收集莫克斯虫壳：5 个";
			initnpctimer;
			disablenpc "Moks Bugs#Bug1";
			close;
		case 2:
			mes "- 你决定路过。-";
			close;
		}
	} else if (hg_tre == 35) {
		mes "["+strcharinfo(0)+"]";
		mes "啊……我才不想碰虫子这种脏东西！";
		close;
	}

OnTimer20000:
	enablenpc "Moks Bugs#Bug1";
	stopnpctimer;
	end;
}


		}
		close;
	}
	if (illusion_frozen == 1) {
		if (countitem(25309) < 10) {
			mes "[^0000ffZeith^000000]";
			mes "我们需要 10 根干树枝。看看洞穴里的干土堆。";
			close;
		}
		.@pc_name$ = strcharinfo(0);
		delitem 25309,10;	// Dry_Branch
		erasequest 15110;// Fighting Ice with Fire
		setarray .@list[0],
			15111,	// Hunt Furious Ice Titans
			15117,	// Hunt Furious Gazetis
			15118,	// Hunt Furious Snowiers
			15119;	// Hunt Hard Icicles
		.@quest_id = .@list[ rand(getarraysize(.@list)) ];
		setquest .@quest_id;
		illusion_frozen = 2;
		mes "[^0000ffZeith^000000]";
		mes "你带来了所有干树枝。哦，我们还没自我介绍，对吧？";
		mes "我是 Zeith，这位是？";
		next;
		mes "[^ff0000Vrid^000000]";
		mes "呃，你会把我们烧死的。";
		next;
		mes "[^0000ffZeith^000000]";
		mes "唉，我是 Vrid。";
		mes "你叫什么名字？";
		next;
		if (.@quest_15116 == 2) {
			mes "^ff0000他们又问了我的名字，好像不记得我一样。事情有些奇怪，但我还是再次告诉了他们我的名字。^000000";
			next;
		}
		select("-" + .@pc_name$ + ".");
		mes "[^0000ffZeith^000000]";
		mes "" + .@pc_name$ + ". 真是个好名字。";
		mes "现在点燃树枝，试着融化冰。先试着融化我朋友周围的冰吧？";
		next;
		mes "[^ff0000Vrid^000000]";
		mes "咕，为什么你这么邪恶？";
		mes "不，别这样！我宁愿死！";
		next;
		mes "[^0000ffZeith^000000]";
		mes "……唉。好吧，我来做。";
		mes "你能点燃树枝放在我周围吗？";
		mes "不过提醒你一下，";
		mes "尽量别放得太近。";
		next;
		mes "^ff0000我点燃干树枝放在他周围。过了一段时间，冰看起来却没有融化。^000000";
		next;
		mes "[^0000ffZeith^000000]";
		mes "也许这冰是魔法形成的。";
		mes "它没有融化。";
		mes "Vrid，你什么都没说。快想点什么！";
		next;
		mes "[^ff0000Vrid^000000]";
		mes "啧啧。你们太简单了，以为火能融化这样的冰。没用，对吧？我们要跳出框框思考。试试用冰打败冰！";
		next;
		mes "[^ff0000Vrid^000000]";
		mes "我想可以利用这里怪物的寒冷能量打破冰。";
		next;
		mes "[^0000ffZeith^000000]";
		if (.@quest_15116 == 2)
			mes "……那太荒谬了。";
		else
			mes "……真可笑。";
		mes "不过我们要怎么利用它们的冰冷能量？";
		next;
		mes "[^ff0000Vrid^000000]";
		mes "听着。";
		switch(.@quest_id) {
		case 15111:
			mes "Vrid 的报告：狂暴冰巨人！";
			next;
			mes "[^ff0000Vrid^000000]";
			mes "根据调查，狂暴冰巨人像空气中的尘埃一样微小。";
		mes "它们只是因为身上长着冰柱才看起来很大。";
			next;
			mes "[^ff0000Vrid^000000]";
			mes "想象它们多么不舒服、多么寒冷！";
			mes "" + .@pc_name$ + "";
			mes "我要你把它们从身体上长出的冰柱中解放出来。";
			break;
		case 15117:
			mes "Vrid 的报告：狂暴 Gazetis！";
			next;
			mes "[^ff0000Vrid^000000]";
			mes "根据调查，Gazetis 曾是冰巨人。他们太好奇这个洞穴，把头伸进去后脖子碎裂了。现在他们在洞穴里徘徊，寻找自己的身体。";
			next;
			mes "[^ff0000Vrid^000000]";
		mes "它们很吓人，对吧？每次我看它们，都像是在喃喃自语，";
			next;
			mes "[^ff0000Vrid^000000]";
			mes "" + .@pc_name$ + "";
		mes "请帮助它们，让它们不必再寻找自己的身体。";
			break;
		case 15118:
		mes "Vrid 的报告：狂暴雪怪！";
			next;
			mes "[^ff0000Vrid^000000]";
		mes "根据我的调查，狂暴雪怪原本是喜欢和人打招呼的温顺生物。";
		mes "被忽视太多次后，它们变得怨恨。现在它们假装友善，";
		mes "但一旦靠近就会攻击人。真让人心疼……";
			next;
			mes "^ff0000Zeith 难以置信地瞪着 Vrid。^000000";
			next;
			mes "[^ff0000Vrid^000000]";
			mes "" + .@pc_name$ + "";
		mes "请教它们别再偷偷摸摸。";
			break;
		case 15119:
		mes "Vrid 的报告：坚硬冰柱！";
			next;
			mes "[^ff0000Vrid^000000]";
		mes "根据我的调查，这些冰柱经历了很多。";
			next;
			select("- 比如什么？");
			mes "[^ff0000Vrid^000000]";
		mes "首先，它们是……嗯……呃……";
			next;
			mes "^ff0000Vrid 皱眉、叹气并挠了挠头，然后说道……^000000";
			next;
			mes "[^ff0000Vrid^000000]";
		mes "冰柱就是冰柱。它们又没有人生故事，对吧？";
			next;
			mes "[^0000ffZeith^000000]";
		mes "你终于说了句有道理的话。";
			next;
			mes "[^ff0000Vrid^000000]";
			mes "Berome";
		mes "也许你该帮它们创造自己的故事。";
			next;
			mes "[^0000ffZeith^000000]";
		mes "……也可能不是。";
			break;
		}
		next;
		mes "[^ff0000Vrid^000000]";
		mes "同时你会吸收它们释放的寒冷能量。回来抱抱我们，也许你体内的寒冷能量能打破困住我们的冰。听起来合理吧？";
		next;
		mes "[^0000ffZeith^000000]";
		mes "不，完全不合理。";
		mes "你说的一切听起来都很牵强。";
		next;
		mes "[^0000ffZeith^000000]";
		mes "但是……唉，我想不出更好的办法。";
		switch(.@quest_id) {
		case 15111:
			mes "我们试试你的建议。冒险者，能猎杀 10 只狂暴冰巨人后回来吗？";
			break;
		case 15117:
			mes "我们试试你的建议。冒险者，能猎杀 10 只狂暴 Gazetis 后回来吗？";
			break;
		case 15118:
			mes "我们试试你的建议。冒险者，能猎杀 10 只狂暴雪怪后回来吗？";
			break;
		case 15119:
			mes "我们试试你的建议。冒险者，能猎杀 10 只坚硬冰柱后回来吗？";
			break;
		}
		next;
		mes "[^ff0000Vrid^000000]";
		mes "不，别猎杀它们！你得帮助它们！";
		next;
		mes "[^0000ffZeith^000000]";
		mes "唉，随便吧。请帮助它们。";
		close;
	}
	if (illusion_frozen == 2) {
		if (isbegin_quest(15111))	// Hunt Furious Ice Titans
			.@quest_id = 15111;
		else if (isbegin_quest(15117))	// Hunt Furious Gazetis
			.@quest_id = 15117;
		else if (isbegin_quest(15118))	// Hunt Furious Snowiers
			.@quest_id = 15118;
		else if (isbegin_quest(15119))	// Hunt Hard Icicles
			.@quest_id = 15119;
		else
			end;

		if (checkquest(.@quest_id,HUNTING) != 2) {
			switch (.@quest_id) {
			case 15111:
				mes "[^0000ffZeith^000000]";
			mes "在洞穴内猎杀 10 只狂暴冰巨人后回来。";
				close;
			case 15117:
				mes "[^0000ffZeith^000000]";
			mes "在洞穴内猎杀 10 只狂暴 Gazetis 后回来。";
				close;
			case 15118:
				mes "[^0000ffZeith^000000]";
			mes "在洞穴内猎杀 10 只狂暴雪怪后回来。";
				close;
			case 15119:
				mes "[^0000ffZeith^000000]";
			mes "在洞穴内猎杀 10 只坚硬冰柱后回来。";
				close;
			}
		}
		mes "[^ff0000Vrid^000000]";
		mes "看，我就说吧！";
		mes "这位冒险者现在正散发出巨大的寒冷能量！";
		next;
		mes "[^0000ffZeith^000000]";
		mes "……这家伙只是很冷吧？";
		next;
		mes "[^ff0000Vrid^000000]";
		mes "现在来抱我们？不，先抱我。然后我周围的冰就会裂开并闪光，就像童话里一样！";
		next;
		mes "^ff0000我按 Vrid 的要求抱住了他。^000000";
		mes "";
		mes "^ff0000光芒闪过！^000000";
		mes "^ff0000不，等等。那只是冰反射了环境光。^000000";
		mes "^ff0000什么也没发生。^000000";
		next;
		mes "[^ff0000Vrid^000000]";
		mes "（牙齿打颤）冷……好冷。离我远点！你太冷了！";
		next;
		mes "[^0000ffZeith^000000]";
		mes "我就知道这是个愚蠢的想法！我不该听你的蠢故事！也不该跟你进这个洞穴！";
		next;
		if (.@quest_15116 == 2)
			.@menu$ = "我已经知道故事了。我应该……跳过。";
		.@s = select( "- 什么蠢故事？", .@menu$ );
		mes "[^ff0000Vrid^000000]";
		mes "这不蠢！";
		mes "这是真的！";
		if (.@s == 1) {
			mes "Vrid 的报告：";
			mes "冰洞的秘密！";
			next;
			mes "[^0000ffZeith^000000]";
			mes "唉……";
			next;
			mes "[^ff0000Vrid^000000]";
			mes "根据调查，这个洞穴曾是地下王国，完全由黄金构成，就像黄金国一样！";
			next;
			mes "^ff0000Zeith 翻了个白眼，但 Vrid 无视他继续说道。^000000";
			next;
			mes "[^ff0000Vrid^000000]";
			mes "国王担心盗贼越来越多，这时一名年轻战士赶来赶走了所有入侵者。国王大喜，把女儿嫁给了战士。";
			next;
			mes "[^ff0000Vrid^000000]";
			mes "但后来发现他的女婿也是盗贼。他最终带着王国最珍贵的宝藏逃走了。";
			next;
			mes "[^ff0000Vrid^000000]";
			mes "愤怒的国王冻结了洞穴并召唤强大的怪物，让任何人都不敢再入侵王国。很悲惨，对吧？？";
			next;
			mes "[^ff0000Vrid^000000]";
			mes "当然，我不是为了宝藏才来这里。我们碰巧在附近，我只是想来看看。";
			next;
			mes "[^0000ffZeith^000000]";
			mes "你第一次不是这么告诉我的。反正我从没相信那个蠢故事。我只是好奇才跟进来，现在完全后悔了。";
		}
		next;
		mes "[^ff0000Vrid^000000]";
		mes "哈哈，现在只剩一件事可试了。那就是……";
		next;
		mes "[^0000ffZeith^000000]";
		mes "拜托，别再想蠢主意了！";
		next;
		mes "[^ff0000Vrid^000000]";
		mes "有时直接的方法最好。试着一直打冰直到它裂开。先试试 Zeith 的，请。";
		next;
		mes "[^0000ffZeith^000000]";
		mes "所以要靠蛮力了吗？你想让我先来？胆小鬼！唉……请温柔点？不，拿出你的全力吧！";
		erasequest .@quest_id;
		setquest 15112;	// Direct Approach
		illusion_frozen = 3;
		cloakonnpcself( "Zeith#frozen01" );
		if (mobcount("ice_d03_i", "Zeith#frozen02::OnZeithDead") < 1)
			monster "ice_d03_i",155,42,"Zeith",3798,1, "Zeith#frozen02::OnZeithDead";	// ILL_FROZEN_GC
		close;
	}
	end;
}

ice_d03_i,155,43,3	script(CLOAKED)	Zeith#frozen02	4_M_GUILLOTINE,{
	if (illusion_frozen == 3) {
		if (checkquest(15112,HUNTING) == 2) {
			mes "[^0000ffZeith^000000]";
			mes "……我不敢相信成功了。";
			next;
			mes "[^ff0000Vrid^000000]";
			mes "成功是因为我是天才！Zeith，你应该感谢我！";
			next;
			mes "[^0000ffZeith^000000]";
			mes "（哼气）";
			mes "看看你还能得意多久。";
			mes "" + strcharinfo(0) + "";
			mes "我们把他留在这里";
			mes "然后出去！";
			next;
			mes "[^ff0000Vrid^000000]";
			mes "什么？嘿，等等！等等！拜托，Zeith！我以为我们的友情比这更牢固！";
			next;
			mes "[^0000ffZeith^000000]";
			mes "……唉。你真幸运，我太善良了，不会把你留在这里。";
			mes "我身体还是太僵硬，动不了。你也照顾一下他，好吗？？";
			erasequest 15112;	// Direct Approach
			setquest 15113;		// Direct Approach
			illusion_frozen = 4;
			cloakonnpcself( "Vrid#frozen01" );
			if (mobcount("ice_d03_i", "Vrid#frozen02::OnVridDead") < 1)
				monster "ice_d03_i",150,42,"Vrid",3797,1, "Vrid#frozen02::OnVridDead";	// ILL_FROZEN_KN
			close;
		}
		end;
	}
	if (illusion_frozen == 4) {
		if (checkquest(15113,HUNTING) != 2) {
			mes "[^0000ffZeith^000000]";
			mes "现在我们需要帮助 Vrid。请把他从冰里救出来。";
			if (mobcount("ice_d03_i", "Vrid#frozen02::OnVridDead") < 1)
				monster "ice_d03_i",150,42,"Vrid",3797,1, "Vrid#frozen02::OnVridDead";	// ILL_FROZEN_KN
			close;
		}
		cloakoffnpcself( "Vrid#frozen02" );
		mes "[^ff0000Vrid^000000]";
		mes "呼，谢谢！";
		mes "你挺厉害。";
		mes "谢谢你，" + strcharinfo(0) + "！";
		next;
		mes "[^0000ffZeith^000000]";
		mes "我们离开这里吧。";
		mes "我不想再被冻住！";
		next;
		mes "[^ff0000Vrid^000000]";
		mes "等等。我们是战士？不能让敌人为对我们做的事付出代价后就离开！";
		next;
		mes "[^0000ffZeith^000000]";
		mes "复仇？";
		mes "你想再被冻住吗？";
		next;
		select("- 什么复仇？你们到底是怎么被冻住的？");
		mes "[^0000ffZeith^000000]";
		mes "唉……这个笨蛋碰了不该碰的东西。";
		next;
		mes "[^ff0000Vrid^000000]";
		mes "拜托，我只是想帮忙！";
		next;
		mes "[^0000ffZeith^000000]";
		mes "帮谁？在我看来，那怪物根本不需要帮助！";
		next;
		mes "[^ff0000Vrid^000000]";
		mes "听着。";
		mes "Vrid 的报告：奇怪的蜥蜴！";
		next;
		mes "[^ff0000Vrid^000000]";
		if (isbegin_quest(15116) == 2)
			.@r = rand(3);
		switch(.@r) {
		case 0:// it seems likely to be the default text when 15116 uncompleted
			mes "正如我之前说的，这个洞穴曾是王国，国王养了一只宠物蜥蜴。国王愤怒地冻结洞穴时，这只蜥蜴也变成了可怕的冰怪物。";
			next;
			mes "[^ff0000Vrid^000000]";
			mes "现在它在洞穴里徘徊，渴望主人的爱。不是很悲惨吗？我只是想给它想要的爱，它却因此惩罚我！";
			break;
		case 1:
			mes "正如我之前说的，这个洞穴曾是王国，国王养了一只宠物蜥蜴。有一天，蜥蜴走出王国想看看外面的世界，却迷路了。国王非常生气，于是诅咒了它。";
			next;
			mes "[^ff0000Vrid^000000]";
			mes "那只被诅咒的蜥蜴在洞穴里徘徊，仍然想去外面。不是很悲惨吗？我只是想解放它，结果它把我冻成了冰块！";
			break;
		case 2:
			mes "它的真名？叫什么来着？？好像是 Ktulla。有人告诉过我，拉赫的大主教雇了这只蜥蜴，监视封印在洞穴里的男孩。";
			next;
			mes "[^ff0000Vrid^000000]";
			mes "但那个故事太不现实又无聊，不值得记住。蜥蜴就是蜥蜴，对吧？";
			next;
			mes "[^0000ffZeith^000000]";
		mes "你问我的话，这是你讲过的所有故事里最可信的一个。";
			break;
		}
		next;
		mes "[^0000ffZeith^000000]";
		mes "你到底从哪里听来这些？为什么你的故事每次都在变？";
		next;
		mes "[^0000ffZeith^000000]";
		mes "唉，总之那只蜥蜴确实在洞穴里。如果想见它，就在 30 秒内按下洞穴中央的 4 个封印宝珠。这样它就会现身。";
		next;
		mes "[^0000ffZeith^000000]";
		mes "但那只蜥蜴非常强。我建议你组队战斗。";
		next;
		mes "[^0000ffZeith^000000]";
		mes "很高兴遇到你，";
		mes "" + strcharinfo(0) + "。";
		mes "希望我们能再次见面。";
		next;
		if (isbegin_quest(15116) == 0) {
			mes "^ff0000他们向我道别后开始消失。很快什么都没留下，仿佛他们从未存在过。这一切只是梦吗？^000000";
			setquest 15116;// Clear the Illusion of the Frozen
			completequest 15116;
			illusion_frozen = 5;
		}
		else {
			mes "^ff0000他们向我道别后开始消失。看来这个洞穴陷入了无限时间循环。^000000";
			next;
			mes "^ff0000但里面发生的事件并不总是相同。难道洞穴内的时空仍在扭曲？我也会受到影响吗？^000000";
		}
		erasequest 15113;// Direct Approach
		setquest 15115;// Vrid and Zeith
		getexp 1200000,1200000;
		getitem 25271,3;	// IllusionStone
		cloakonnpcself( "Vrid#frozen02" );
		cloakonnpcself( "Zeith#frozen02" );
		close;
	}
	end;

OnZeithDead:
	if (illusion_frozen == 3) {
		cloakonnpcself();
		specialeffect EF_ICECRASH;
	}
	end;
}

ice_d03_i,150,43,5	script(CLOAKED)	Vrid#frozen01	4_M_FROZEN_KN,{
	if (illusion_frozen == 3) {
		if (checkquest(15112,HUNTING) == 2) {
			cloakoffnpcself( "Zeith#frozen02" );
			mes "[^ff0000Vrid^000000]";
			mes "真的成功了！嘿，Zeith！你还好吗？";
			close;
		}
		mes "[^ff0000Vrid^000000]";
		mes "看看能不能打破他周围的冰。如果成功了，也请把我从冰里救出来。";
		if (mobcount("ice_d03_i", "Zeith#frozen02::OnZeithDead") < 1)
			monster "ice_d03_i",155,42,"Zeith",3798,1, "Zeith#frozen02::OnZeithDead";	// ILL_FROZEN_GC
		close;
	}
	end;
}

ice_d03_i,150,43,5	script(CLOAKED)	Vrid#frozen02	4_M_KNIGHT_BLACK,{
	end;
OnVridDead:
	if (illusion_frozen == 4) {
		cloakonnpcself();
		specialeffect EF_ICECRASH;
	}
	end;
}

ice_d03_i,137,38,3	script	Heap of Dry Soil#frozen1	4_SOIL,{
	if (illusion_frozen == 1) {
		if (checkweight(1201,1) == 0 || (MaxWeight - Weight) < 2000) {
			mes "我携带了太多种物品。应该先减轻负重。";
			close;
		}
		if (countitem(25309) >= 10) {
			mes "我已经有需要的树枝了。应该回去找 Zeith 和 Vrid。";
			close;
		}
		mes "我检查了土堆，寻找树枝。";
		next;
		progressbar "00000000",5;
		disablenpc();
		initnpctimer;
		if (rand(100) < 10)
			mes "这个土堆里面什么都没有。";
		else {
			getitem 25309,1;
			mes "我找到了 1 根^006400干树枝^000000。";
		}
		close;
	}
	end;

OnTimer30000:
	stopnpctimer;
	enablenpc();
	end;
}

//===== rAthena Script ======================================= 
//= Advance Class jobchanger after kRO Normals.
//===== By: ==================================================
//= Nana
//= finished, optimized and tested by Lupus
//===== Current Version: ===================================== 
//= 1.3
//===== Compatible With: ===================================== 
//= rAthena Project
//===== Description: ========================================= 
//= Advance Class jobchanger after kRO Normals.
//===== Additional Comments: ================================= 
//= 1.1 Made all into functions, additional checks, etc. [Lupus]
//= 1.2 Made numbers into constants. [Vicious]
//= 1.3 Now saves/restores all the quest skills [Lupus]
//============================================================ 

valkyrie,44,55,5	script	Sniper#Valkyrie	727,{
	if (ADVJOB == 0 || Upper != 1) {
		set .@karma_d,rand(1,10);
		if (.@karma_d > 4) {
			mes "[Sniper]";
			mes "恭喜。";
			mes "向勇士致敬！";
			close;
		}
		mes "[Sniper]";
		mes "一箭。";
		mes "一击必杀。";
		mes "一旦培养出这种战斗方式的";
		mes "视野，";
		mes "就没有那么难了。";
		mes "";
		close;
	}
	else if (ADVJOB == Job_Sniper && Class == Job_Archer_High && JobLevel > 39) {
		mes "[Sniper]";
		mes "这个世界需要";
		mes "像您这样的强大弓箭手。";
		mes "您准备好承担";
		mes "这份重大责任了吗？";
		next;
		mes "[Sniper]";
		mes "您愿意迈出下一步，";
		mes "成为一名狙击手吗？";
		next;
		if (select("不。:是。") == 1) {
		mes "[Sniper]";
			mes "准备好后，";
			mes "随时欢迎回来。";
			mes "向勇士致敬！";
			close;
			}
		if (SkillPoint) {
		mes "[Sniper]";
			mes "您仍然可以学习更多技能。请在回来找我之前";
			mes "用完所有剩余技能点。";
			close;
			}
		jobchange Job_Sniper;
		set ADVJOB,0;
		mes "[Sniper]";
		mes "恭喜！";
		mes "成为狙击手后，";
		mes "只要邪恶爪牙";
		mes "出现在您的视线中，";
		mes "它们就永远不得安宁！";
		mes "";
		close;
		}
	mes "[Sniper]";
	mes "欢迎来到";
	mes "英灵殿，";
	mes "荣耀之厅。";
	next;
	mes "[Sniper]";
	mes "请在这里";
	mes "好好休息。";
	mes "向勇士致敬！";
	close;
	}
	//
//

					next;
					mes "[Shorty]";
					mes "有些地下城只能通过特殊任务进入，所以也要收集信息，好吗？";
					next;
					mes "[Shorty]";
					mes "不如先试试地下水道？剑士公会一直在招募人员，听说那里很适合新手冒险者积累经验。";
					break;
				case 3:
					mes "[Shorty]";
					mes "有许多纪念地下城、梦魇地下城、幻影地下城……等等。";
					next;
					mes "[Shorty]";
					mes "^0000cd纪念地下城^000000";
					mes "除了普通地下城，还有特殊地下城。据说它们是由这个世界中未知的力量创造的特殊场所。";
					next;
					mes "[Shorty]";
					mes "许多经验丰富的冒险者会去那里，不过据说也有一些地方等级较低，稍加训练就能到达。比如兽人村或拉赫……";
					next;
					mes "[Shorty]";
					mes "据说它们位于村庄和普通原野中，许多地方都被称为次元裂缝。";
					next;
					mes "[Shorty]";
					mes "^0000cd梦魇地下城^000000";
					mes "据说那里的挑战远比普通地下城困难，连怪物也和我们熟悉的不同。如果发现地下城时有可疑的人说能把你送到更困难的地方，不妨试试看。" ;
					next;
					mes "[Shorty]";
					mes "^0000cd幻影地下城^000000";
					mes "没人知道这些地下城究竟是什么样的地方。我想它们就像梦境或幻想。这里只有一种特殊的石头，大家都为了它而战。据说这种石头可以兑换强力武器。 ";
					break;
				case 4:
					mes "[Shorty]";
					mes "好了吗？那我再四处看看，然后回到袋子里。";
					close;
				}
				next;
			}
			end;
		case 4:
			while(1) {
				mes "[Shorty]";
				mes "那么，你想了解哪些基础信息？";
				mes "基础信息请参阅 <URL>[指南]<INFO>http://ro.gnjoy.com/guide/systeminfo/,1024,768</INFO></URL>。";
				next;
				switch( select( "队伍", "公会与氏族", "冶炼", "附魔", "家庭", "聊天" ) ) {
				case 1:
					mes "[Shorty]";
					mes "有时你会想和朋友一起行动：一起在地下城战斗、享受冒险，或者只是坐下来聊天。";
					next;
					mes "[Shorty]";
					mes "那就组队一起做。";
					next;
					mes "[Shorty]";
					mes "按下 ^0000cdAlt+Z 键^000000即可打开队伍窗口。均分狩猎经验时，^0000cd队伍成员之间的等级差^000000必须小于或等于 15。";
					next;
					mes "[Shorty]";
					mes "点击底部聊天窗口左侧的圆圈，就能指定聊天对象，也可以只向队伍成员发送消息，非常方便。";
					break;
				case 2:
					mes "[Shorty]";
					mes "有时你会想加入某个团体，与他人建立羁绊。这时只要加入 ^0000cd公会或氏族^000000 即可。";
					next;
					mes "[Shorty]";
					mes "公会最大的特色是争夺据点，也被称为攻城战。";
					next;
					mes "[Shorty]";
					mes "你可以接受邀请加入已经成立的公会，也可以购买公会办公室出售的城堡核心来创建公会。";
					next;
					mes "[Shorty]";
					mes "除了归属感，公会还拥有公会专属技能、专用仓库等各种福利。";
					next;
					mes "[Shorty]";
					mes "详情请参阅";
					mes "<URL>[公会指南]<INFO>http://ro.gnjoy.com/guide/systeminfo/systemGuild1.asp,1024,768</INFO></URL>";
					next;
					mes "[Shorty]";
					mes "如果加入公会有负担，^0000cd氏族^000000会是不错的选择。虽然不像公会那样容易与他人建立亲密关系，但氏族也有各种福利。";
					next;
					mes "[Shorty]";
					mes "^0000cd普隆德拉中央喷泉左下角的建筑^000000就是氏族总部，可以去看看。";
					break;
				case 3:
					mes "[Shorty]";
					mes "想让装备变强吗？那就去各个城镇寻找 ^0000cd精炼师^000000。";
					next;
					mes "[Shorty]";
					mes "精炼需要特殊物品和 Zeny，具体取决于装备的类型和等级。";
					next;
					mes "[Shorty]";
					mes "请注意，精炼有安全等级。超过特定等级继续精炼时，装备可能会损坏。祝你好运。";
					next;
					mes "[Shorty]";
					mes "对了，除了各城镇的精炼师，我听说 ^0000cd<Item Mall>^000000 的精炼成功率更高。";
					next;
					mes "[Shorty]";
					mes "如果你感兴趣，可以去各城镇的 ^0000cd<现金商店指南>^000000，那里会为你指路。";
					break;
				case 4:
					mes "[Shorty]";
					mes "如果想让装备更强，或赋予它特殊能力，不妨试试 ^0000cd附魔^000000。";
					next;
					mes "[Shorty]";
					mes "主要负责附魔的地方有 ^0000cd<马来岛>、<Item Mall>^000000，和主要城镇中的 ^0000cd<Seyablem>、<Leyablem>^000000。";
					next;
					mes "[Shorty]";
					mes "从特定地下城或区域获得的装备，只能在该区域进行 ^0000cd附魔^000000。";
					next;
					mes "[Shorty]";
					mes "不过，并非所有装备都能附魔，请仔细确认条件。";
					break;
				case 5:
					mes "[Shorty]";
					mes "你确定想和另一个人共度余生吗？那就可以组建一个 ^0000cd家庭^000000。";
					next;
					mes "[Shorty]";
					mes "^0000cd你可以和喜欢的人结婚^000000，也可以收养一名 ^0000cd孩子^000000。你也可以被另一对夫妻收养为孩子。";
					next;
					mes "[Shorty]";
					mes "据说结婚后可以获得特殊的家庭技能。";
					next;
					mes "[Shorty]";
					mes "如果你想结婚，可以去普隆德拉教堂或拉萨格纳婚礼会场。结婚前需要准备一些用品。普隆德拉教堂只为人类举办婚礼。";
					next;
					mes "[Shorty]";
					mes "收养要求已婚夫妻等级达到 70 级以上，被收养者必须是初心者或一转职业。";
					next;
					mes "[Shorty]";
					mes "普隆德拉区政府的家庭科可以购买婚礼所需物品，也可以咨询家庭相关事项。有需要的话就去看看吧。";
					next;
					mes "[Shorty]";
					mes "详情请参阅";
					mes "<URL>[家庭]<INFO>http://ro.gnjoy.com/guide/systeminfo/systemLovers1.asp,1024,768</INFO></URL>。";
					break;
				case 6:
					mes "[Shorty]";
					mes "你能看到底部的消息窗口吗？在这里输入消息就能和其他人聊天，也可以发送其他类型的消息。";
					next;
					mes "[Shorty]";
					mes "如果想和少数既不是队伍成员也不是公会成员的人聊天，可以打开聊天窗口。";
					next;
					mes "[Shorty]";
					mes "按下 ^0000cdAlt+C 键^000000即可打开聊天窗口，还可以设置参与人数上限和密码。";
					break;
				}
				next;
			}
			end;
		case 5:
			mes "[Shorty]";
			mes "好了吗？那我再四处看看，然后回到袋子里。";
			close;
		}
		end;
	case 8:
		mes "[Shorty]";
		mes "啊！！！我是肖蒂！我主人的名字是什么？";
		next;
		select( "主人？" );
		mes "[Shorty]";
		mes "你遇到的第一个人应该叫主人。";
		next;
		select( "你是说老师吗？" );
		mes "[Shorty]";
		mes "对，就是这样。我是加拉帕戈·肖蒂，很会说话。";
		next;
		select("你为什么在这里？" );
		mes "[Shorty]";
		mes "萨尔蒂！萨尔蒂是我的朋友。我来这里就是为了见萨尔蒂。所以你必须带我去见萨尔蒂。";
		next;
		mes "[Shorty]";
		mes "那我们走吧！";
		close;
	case 9:
		mes "[Shorty]";
		mes "什么……？主人……？什么？要分道扬镳？就在这里？现在？你认真的吗？";
		next;
		mes "[Shorty]";
		mes "有什么让你不满意的吗？是我在袋子里不够安静吗？哦，原来你不喜欢这个……那我也没办法。";
		next;
		mes "[Shorty]";
		mes "你不带我去 ^0000cd萨尔蒂^000000 那里吗？如果你带我去，萨尔蒂一定会感谢你。我也会向你道谢，因为萨尔蒂懂得感恩。";
		next;
		if (select( "我们各走各的吧。", "在那之前我们一起走吧。" ) == 2) {
			mes "[Shorty]";
			mes "好的，说得好，主人。就算我卡在袋子里，也会马上出来。";
			next;
			mes "[Shorty]";
			mes "让我们再互相帮助一阵子，好吗？";
			close;
		}
		mes "[Shorty]";
		mes "是的，主人真是铁石心肠。那也没办法了。我想我们的关系就到此为止。";
		next;
		mes "[Shorty]";
		mes "不管你怎么想，我很享受和你一起度过的时光。";
		next;
		mes "[Shorty]";
		mes "保重身体，祝你一切顺利。希望主人不会忘记曾经有加拉帕戈陪伴过你。";
		next;
		mes "[Shorty]";
		mes "那么，主人，再见。再见！";
		switch( isbegin_quest(14693) ) {
		case 0:
			setquest 14693;
			completequest 14693;
			break;
		case 1:
			completequest 14693;
			break;
		case 2:
			break;
		}
		if (isbegin_quest(14694) > 0)
			erasequest 14694;
		delitem 23278,1;	// HelpmeShorty
		close;
	}
}

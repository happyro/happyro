prt_church,185,106,3	script	Father Bamph	60,{
	if (prt_curse == 13) {
		mes "[班普神父]";
		mes "欢迎来到";
		mes "普隆德拉教会。";
		mes "请放松身心，";
		mes "让你的心灵";
		mes "在这神圣的大厅中";
		mes "得到安宁。";
		next;
		select("交给他草药袋。");
		if (countitem(7432) < 1) {
			mes "["+strcharinfo(0)+"]";
			mes "啊！";
			mes "我把那个装草药的袋子";
			mes "放到哪里去了？";
			close;
		}
		mes "[班普神父]";
		mes "请问……";
		mes "你为什么要把";
		mes "这袋草药交给我？";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "是这样的，有位住在";
		mes "妙尔尼尔山的女士想让我";
		mes "把这个交给你。呃，她";
		mes "有个叫卡努的儿子？";
		next;
		mes "[班普神父]";
		mes "哦，你一定见过";
		mes "邦妮·英布莉亚。";
		mes "我很久没见到她了。";
		mes "请问她现在过得怎么样？";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "哦……";
		mes "我想她还好。";
		mes "但她看起来真的……";
		mes "我也说不清，像是很痛苦……";
		next;
		mes "[比库斯神父]";
		mes "很好！如果她做了那种事后";
		mes "还能开心放松，";
		mes "就连上帝也不会原谅她！";
		mes "她应该在痛苦中度过";
		mes "余生！";
		next;
		mes "[班普神父]";
		mes "比库斯神父，你怎么能";
		mes "说这种话？";
		mes "她已经尽力阻止那件事了！";
		mes "我们应该怜悯她所承受的痛苦。";
		mes "你的同情心到哪里去了？";
		next;
		mes "[比库斯神父]";
		mes "哼！别跟我谈同情心！";
		mes "难道不是你最先推荐";
		mes "让她主持驱魔仪式的吗？";
		mes "你没忘记这件事吧？";
		next;
		mes "[班普神父]";
		mes "......";
		mes ".........";
		mes "............";
		next;
		mes "[比库斯神父]";
		mes "哈！";
		next;
		select("关于邦妮·英布莉亚");
		mes "[班普神父]";
		mes "这个嘛……";
		mes "我不知道……";
		mes "我不知道是否应该";
		mes "把那件事告诉你……";
		next;
		mes "[比库斯神父]";
		mes "你知道吗？邦妮让这位冒险者";
		mes "来这里帮忙，说明她";
		mes "信任这个人。而且，我们需要有人";
		mes "替我们完成这项任务。";
		if (Sex == SEX_MALE)
			mes "这项任务。为什么不是他？";
		else
			mes "这项任务。为什么不是她？";
		next;
		mes "[班普神父]";
		mes "你的话听起来确实有道理，";
		mes "比库斯神父。";
		mes "那么，冒险者，请给我机会";
		mes "告诉你一件非常重要的事。";
		mes "但你绝不能告诉其他人……";
		set prt_curse,14;
		delitem 7432,1; //Leather_Pouch
		close;
	}
	else if (prt_curse == 14) {
		mes "[班普神父]";
		mes "我接下来要告诉你的事";
		mes "必须保密。";
		mes "你知道耶梦加得吗？";
		mes "它是由神洛基与女巨人";
		mes "安格尔波达所生的";
		mes "巨蛇。";
		next;
		mes "[班普神父]";
		mes "耶梦加得是一头邪恶的";
		mes "野兽。在神魔之间持续千年的";
		mes "战争结束后，它开始攻击人类。";
		mes "它给世界带来了巨大的混乱";
		mes "与无尽的苦难……";
		next;
		mes "[班普神父]";
		mes "最后，盖博格家族的第一代";
		mes "特里斯坦与另外六名战士";
		mes "一起击败了耶梦加得，";
		mes "但那是在它杀死他敬爱的父亲之后。";
		next;
		mes "[班普神父]";
		mes "特里斯坦后来成为";
		mes "卢恩·米德加兹王国的第一任国王，";
		mes "但他的家族承受了";
		mes "耶梦加得在败亡前施下的诅咒。";
		next;
		mes "[班普神父]";
		mes "直到今天……";
		mes "^FF0000盖博格家族的每一位";
		mes "长子都会英年早逝^000000。那就是";
		mes "耶梦加得的诅咒，";
		mes "也是王室的秘密。";
		emotion ET_HUK, playerattached();
		next;
		mes "["+strcharinfo(0)+"]";
		mes "什么……？！";
		mes "这是真的吗？！";
		mes "难道没有办法";
		mes "对抗这个可怕的诅咒吗？！";
		next;
		mes "[班普神父]";
		mes "请小声一点。";
		mes "是的，王室必须承受这种";
		mes "痛苦确实令人惋惜。";
		mes "但多年来尝试过的所有驱魔";
		mes "仪式都失败了……";
		next;
		mes "[班普神父]";
		mes "虽然情况看起来毫无希望，";
		mes "特里斯坦三世国王仍再次尝试驱除诅咒。";
		mes "遵照他的命令，最优秀的神父与驱魔师";
		mes "全都被召集了起来。";
		next;
		mes "[班普神父]";
		mes "他们进行了一系列测试，";
		mes "选拔最优秀的神父与驱魔师";
		mes "来解除诅咒。最后，^3131FF邦妮·英布莉亚^000000被选中";
		mes "主持驱魔仪式。";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "等等，但你提到过";
		mes "发生了意外。";
		mes "那是否意味着她在执行";
		mes "驱魔仪式时失败了？";
		next;
		mes "[班普神父]";
		mes "是的，很不幸。";
		mes "神父与驱魔师聚集到";
		mes "秘密仪式场地后，";
		mes "结果死去的不是一位王子，";
		mes "而是三位。";
		next;
		mes "[比库斯神父]";
		mes "虽然我们都发誓要保守";
		mes "这件事的秘密，";
		mes "邦妮·英布莉亚仍承担了";
		mes "死亡事件的全部责任。";
		mes "所以她才会自我流放，";
		mes "离开王国。";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "什么……？";
		mes "这……";
		mes "太疯狂了！";
		next;
		mes "[比库斯神父]";
		mes "我知道这是个很长的故事，";
		mes "而且有点复杂。";
		mes "请听听接下来";
		mes "我们想请你做的事……";
		emotion ET_THINK;
		set prt_curse,15;
		close;
	}
	else if (prt_curse == 15) {
		mes "[班普神父]";
		mes "现在你应该知道，";
		mes "那天死去的所有王子";
		mes "身上都有奇怪的印记。";
		mes "看起来就像他们的身体";
		mes "正在长出蛇鳞。";
		emotion ET_SURPRISE, playerattached();
		next;
		mes "["+strcharinfo(0)+"]";
		mes "等等，他们长出了蛇鳞？";
		mes "这听起来就像我正在调查的";
		mes "那首歌的其中一个版本。";
		mes "我想那是关于卢恩·米德加兹王国起源的歌。";
		next;
		mes "[班普神父]";
		mes "等等，那首歌？";
		mes "嗯，我看不出它们有什么关系。";
		mes "让我想想，歌词是怎么唱的？";
		mes "彩虹……鹰……";
		mes "啊！我想起来了！";
		next;
		mes "[班普神父]";
		mes "巨蛇吞下了大海。";
		mes "彩虹之鹰吞下了巨蛇。";
		mes "然后鹰筑起了巢。";
		mes "巢建在被吞下的大海之上。";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "嗯……";
		mes "我听过同一首歌的";
		mes "另一个版本。";
		mes "歌词是这样的……";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "巨蛇吞下了大海。";
		mes "彩虹之鹰吞下了巨蛇。";
		mes "然后蛇鳞长在鹰的身上，";
		mes "它慢慢死去了。";
		next;
		mes "[班普神父]";
		mes "天啊。我小时候从父亲那里";
		mes "学会了这首歌。不过，你的版本";
		mes "似乎揭示了盖博格家族的秘密诅咒。";
		mes "请告诉我，你在哪里听到那首歌的？";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "我最初是从一位历史学家那里";
		mes "听到这个版本的，后来发现";
		mes "邦妮·英布莉亚也知道。";
		mes "呃，有什么问题吗？";
		next;
		mes "[班普神父]";
		mes "如果那些歌词被传播出去，";
		mes "王室诅咒的秘密可能会";
		mes "暴露给公众。你能否再去";
		mes "和邦妮·英布莉亚谈谈，";
		mes "帮助我们调查？";
		next;
		mes "[班普神父]";
		mes "如果可以，请试着查明";
		mes "诅咒与歌曲之间是否有关，";
		mes "或者她是否记得驱魔失败后";
		mes "发生过什么事……";
		set prt_curse,16;
		//changequest 18034,18035;
		close;
	}
	else if (prt_curse == 16) {
		mes "[班普神父]";
		mes "请去妙尔尼尔山拜访";
		mes "邦妮·英布莉亚，调查那首歌，";
		mes "以及尝试驱除耶梦加得诅咒后";
		mes "发生了什么事。";
		close;
	}
	else if (prt_curse == 17) {
		mes "[班普神父]";
		mes "啊，你和邦妮·英布莉亚";
		mes "谈过了吗？";
		mes "请告诉我你是否";
		mes "发现了什么新情况。";
		next;
		mes "^3355FF你把邦妮·英布莉亚说过的";
		mes "一切都告诉了他，包括在";
		mes "秘密仪式场地发现";
		mes "红色宝石碎片的事。^000000";
		next;
		mes "[班普神父]";
		mes "红色宝石？神圣的场所里";
		mes "不该有这种东西。嗯，";
		mes "这件事比表面看起来更复杂。";
		mes "我们最好现在就开始调查真相。";
		next;
		mes "[班普神父]";
		mes "跟我来，冒险者，";
		mes "去王室的秘密仪式场地。";
		mes "只要使用藏在书架里的开关，";
		mes "我会在那里和你会合。";
		set prt_curse,18;
		mes "";

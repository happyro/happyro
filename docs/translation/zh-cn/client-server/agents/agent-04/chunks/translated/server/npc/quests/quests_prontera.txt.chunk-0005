		mes "[邦妮·英布莉亚]";
		mes "我开始唱这首歌";
		mes "让自己分心，";
		mes "即使它与";
		mes "耶梦加得诅咒有关。";
		next;
		mes "[邦妮·英布莉亚]";
		mes "你知道吗，现在想想";
		mes "我记得听说过，驱魔失败后";
		mes "";
		mes "女仆在清理";
		mes "秘密仪式场地时发现一块";
		mes "红色宝石碎片。";
		emotion ET_SURPRISE, playerattached();
		next;
		mes "[邦妮·英布莉亚]";
		mes "我一直觉得这";
		mes "有点奇怪。";
		mes "我想调查，";
		mes "但后来我因失败被";
		mes "普隆德拉教会";
		mes "解雇了……";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "红色宝石的";
		mes "碎片？";
		mes "也许……也许这是有人";
		mes "破坏驱魔仪式的证据！";
		mes "";
		next;
		mes "[邦妮·英布莉亚]";
		mes "发生的事很悲惨，";
		mes "但如果那真相，";
		mes "我会感觉好很多。即使";
		mes "驱魔被破坏，";
		mes "我们也无法改变过去……";
		mes "";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "^333333（嗯……";
		mes "我最好回普隆德拉教会";
		mes "";
		mes "告诉班普神父";
		mes "这个消息。）^000000";
		set prt_curse,17;
		//changequest 18035,18036;
		close;
	}
	else if (prt_curse == 17) {
		mes "[邦妮·英布莉亚]";
		mes "带着这种愧疚生活";
		mes "真的很难。";
		mes "";
		mes "我受训帮助";
		mes "人，而不是杀人！";
		next;
		mes "^3355FF你试图安慰";
		mes "邦妮·英布莉亚片刻，";
		mes "然后回到";
		mes "普隆德拉教会。^000000";
		close;
	}
	else if (prt_curse == 35 || prt_curse == 44 || prt_curse == 54) {
		mes "^3355FF你告诉邦妮·英布莉亚";
		mes "王子的死亡不是她的错，驱魔可能被破坏。";
		mes "";
		mes "但你没有说出毒药等细节。^000000";
		next;
		mes "[邦妮·英布莉亚]";
		mes "真的吗……？";
		mes "哦，我太高兴了！我以为要";
		mes "一生隐居，带着";
		mes "可怕的羞耻。谢谢你！";
		mes "";
		mes "";
		next;
		mes "[邦妮·英布莉亚]";
		mes "卡努将能够";
		mes "和同龄的孩子们见面……";
		mes "我们终于可以过上";
		mes "正常的生活了。真是太好了……";
		next;
		mes "[邦妮·英布莉亚]";
		mes "但是等等……";
		mes "那么王子们到底是";
		mes "怎么死的？";
		mes "据我记得，他们身上";
		mes "没有任何伤口……";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "呃，这个我也不清楚，";
		mes "但班普神父和比库斯神父";
		mes "正在负责调查，";
		mes "他们会尽力查明真相。";
		next;
		mes "[邦妮·英布莉亚]";
		mes "我明白了。我相信他们，";
		mes "毕竟他们都是优秀的神父。";
		mes "虽然我的失败或许能被原谅，";
		mes "但我仍然担心王室……";
		mes "现在我能做的只有祈祷。";
		next;
		mes "[邦妮·英布莉亚]";
		mes "总之，我保证不会把";
		mes "我知道的这件事告诉公众。";
		mes "如果你以后再来这座山，";
		mes "希望你能顺便来看看我们。";
		next;
		mes "[邦妮·英布莉亚]";
		mes "你不知道你带来的消息";
		mes "对我来说有多么重要。";
		mes "我终于可以摆脱";
		mes "这份沉重的罪恶感了……";
		mes "谢谢你，善良的冒险者～";
		if (prt_curse == 35) {
			set prt_curse,36;
			//completequest 18050;
		} else if (prt_curse == 44) {
			set prt_curse,45;
			//completequest 18049;
		} else {
			next;
			mes "^3355FF现在，你可以回去找";
			mes "驻扎在梦罗克的历史学家";
			mes "罗达弗里安了。^000000";
			set prt_curse,55;
			//changequest 18049,18051;
		}

		close;
	}
	else if (prt_curse == 36) {
		mes "[邦妮·英布莉亚]";
		mes "愿您施以恩典与慈悲，";
		mes "怜悯可怜的灵魂，";
		mes "保护王室……";
		mes "请用您的光祝福我们，";
		mes "愿您的智慧指引我们……";
		close;
	}
	else if (prt_curse == 45) {
		mes "[邦妮·英布莉亚]";
		mes "我想我们已经太习惯";
		mes "妙尔尼尔山的和平";
		mes "与宁静了。即使欢迎我们";
		mes "回到普隆德拉，离开这里";
		mes "也并不容易……";
		close;
	}
	else if (prt_curse > 54) {
		mes "[邦妮·英布莉亚]";
		mes "非常感谢你";
		mes "帮助调查王子们的事情。";
		mes "如果没有你的努力，";
		mes "我恐怕再也不会知道";
		mes "幸福是什么了。";
		close;
	}
	else {
		mes "[邦妮·英布莉亚]";
		mes "^333333*叹气……*^000000";
		close;
	}
}



mid_campin,376,120,0	script	Research Official#ep131	754,3,3,{
OnTouch_:
	if (checkweight(1201,1) == 0 || MaxWeight - Weight < 3500) {
		mes "[United Research Official]";
		mes "你怎么带着这么多东西？";
		mes "你是在训练什么吗？";
		close;
	}
	if (ep13_ryu > 99 || ep13_start > 99) {
		if (ep13_1_rhea < 1) {
			mes "[United Research Official]";
		mes "嗯……嗯……";
			next;
			mes "[United Research Official]";
		mes "哦！你好！";
		mes "你一定是来自米德加尔特的冒险者。";

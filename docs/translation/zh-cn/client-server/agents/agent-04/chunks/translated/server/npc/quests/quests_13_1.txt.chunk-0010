			mes "我会和远征管理层进一步讨论。";
			mes "感谢你提供宝贵信息。";
			completequest 2158;
			getexp (checkre(3))?90000:70000,0;
			close;
		}
		else if (checkquest(2158) == -1) {
			mes "["+strcharinfo(0)+"]";
			mes "哦，没什么。";
			mes "抱歉打扰了。";
			close;
		}
		else {
			if (checkquest(2159) == 1) {
			mes "- 你向卫兵队长报告了在魔怒克地区遇到树巨人的事。 -";
				next;
				mes "[Captain]";
				mes "这听起来非常重要。";
				mes "现在下结论还太早，但我们可能必须派调查队前往该地区。";
				next;
				mes "[Captain]";
				mes "我会和远征管理层进一步讨论。";
				mes "感谢你提供宝贵信息。";
				completequest 2159;
				getexp (checkre(3))?90000:70000,0;
				close;
			}
			else {
				mes "["+strcharinfo(0)+"]";
				mes "哦，没什么。";
				mes "抱歉打扰了。";
				close;
			}
		}
	}
}


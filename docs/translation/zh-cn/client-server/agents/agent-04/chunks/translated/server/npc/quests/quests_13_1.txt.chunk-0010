			set ep13_animal,5;
			changequest 2149,2150;
			close;
		}
		else if (ep13_animal == 5) {
			if (checkquest(2150,HUNTING) == 2) {
				mes "[植物学家]";
				mes "欢迎回来！感觉如何？";
				mes "很棒，对吧？";
				next;
				mes "[植物学家]";
				mes "在联合远征营地右侧，";
				mes "有一片被咆哮暴风雪包围的土地。";
				next;
				mes "[植物学家]";
				mes "而在另一边，";
				mes "有一片宁静的绿色土地";
				mes "可以享受大自然温暖的拥抱。";
				next;
				mes "[植物学家]";
				mes "两个完全不同的世界共存";
				mes "于相距不远的地方。";
				mes "还有哪里能一眼看到如此惊人的对比？";
				next;
				mes "[植物学家]";
				mes "我想知道这个世界的所有秘密。";
				next;
				mes "[植物学家]";
				mes "我太兴奋了，根本藏不住！";
				mes "*Pant Pant*";
				mes "*Pant Pant*";
				next;
				select("这是多么神秘的世界！");
				mes "[植物学家]";
				mes "是的……";
				mes "哦，对了！";
				mes "其实我是来研究这种奇特现象的。";
				next;
				mes "[植物学家]";
				mes "为了了解环境条件，";
				mes "包括温度和湿度，";
				mes "5.....并检查植物的种类和生长，";
				mes "我在这里安装了几台特殊环境测量仪";
				mes "。";
				next;
				mes "[植物学家]";
				mes "不幸的是，一些邪恶怪物";
				mes "不断破坏珍贵的测量仪";
				mes "用它们的 ^3131FF邪恶圆环^000000！";
				next;
				mes "[植物学家]";
				mes "罪魁祸首叫做角鸮。";
				mes "请你教训它们，让它们别再破坏我的设备。";
				next;
				mes "[植物学家]";
				mes "去猎杀 ^3131FF10 只^000000，给它们一个教训吧！祝你好运！";
				set ep13_animal,6;
				changequest 2150,2151;
				close;
			}
			else {
				mes "[植物学家]";
				mes "现在先过左边的桥，和那里的守卫交谈后继续前进。";
				mes "一群美丽女孩会欢迎你。希望你喜欢和她们交谈，也许能理解自然的奥秘。";
				close;
			}
		}
		else if (ep13_animal == 6) {
			if (checkquest(2151,HUNTING) == 2) {
				mes "[植物学家]";
				mes "希望角鸮已经吸取教训，不再碰我的特殊环境测量仪。";
				next;
				mes "[植物学家]";
				mes "哦，卡里尔，你离开时，我从一台完好的研究机器那里收到了一份有趣报告。";
				next;
				mes "[植物学家]";
				mes "报告显示，灰色沃土原本的天气寒冷干燥，就像右侧的土地。";
				next;
				mes "[植物学家]";
				mes "这意味着有人人工培育了左侧土地。";
				next;
				mes "[植物学家]";
				mes "你记得在田野各处看到奇怪的蘑菇形建筑吗？";
				mes "我怀疑那是能把荒地变成绿色沃土的环境净化器。";
				next;
				mes "[植物学家]";
				mes "我带你看看。";
				mes "请拿着这根腐烂植物茎，";
				mes "我会在另一侧左桥旁的环境净化器处等你。";
				set ep13_animal,7;
				getitem 6035,1; //Decaying_Stem
				changequest 2151,2152;
				close;
			}
			else {
				mes "[植物学家]";
				mes "角鸮正在破坏我的特殊环境测量仪！";
				mes "请让它们见识米德加尔特人的力量！";
				close;
			}
		}
		else if (ep13_animal > 6) && (ep13_animal < 10) {
			mes "[植物学家]";
			mes "我会在另一侧左桥旁的环境净化器处等你。";
			close;
		}
		else {
			mes "[植物学家]";
			mes "我已经向上级提交报告。";
			mes "还没收到回复，但他们读完报告后一定和我一样兴奋。呜呼！";
			close;
		}
	}
}

mid_camp,336,171,1	script	Camp Guard#man1	852,{
	mes "[Camp Guard]";
	mes "站住！";
	mes "你即将进入尚未完全探索的区域。";
	mes "只有米德加尔特联合组织和驻军授权的研究员、探险家才能进入危险区。";
	if (ep13_ryu < 100 && ep13_start < 100)
		close;
	next;
	switch(select("I want to enter the next area.:I want to stay.")) {
	case 1:
		mes "[Camp Guard]";
		mes "在外面请小心。";
		mes "遇到威胁或奇怪现象，请立即向驻军报告。";
		close2;
		switch(atoi(charat(strnpcinfo(2),3))) {
		case 1:
			if (ep13_animal == 1)
				set ep13_animal,2;
			warp "man_fild01",36,235;
			break;
		case 2:
			warp "spl_fild02",379,143;
			break;
		case 3:
			warp "spl_fild02",380,217;
			break;
		}
		end;
	case 2:
		mes "[Camp Guard]";
		mes "不，你不能进去。请返回远征营地。";
		close;
	}
}

man_fild01,92,230,3	script	Frozen Tree#evt_lumis	111,1,1,{
	if (ep13_animal == 11) {
		mes "["+strcharinfo(0)+"]";
		mes "咚咚。你在这里吗？";
		next;
		mes "- 树顶附近有什么东西发出巨响。 -";
		next;
		mes "[Rumis Block]";
		mes "……哦，对了。没错！";
		mes "怪物盯着我，所以我不假思索地爬上了这棵树！";
		mes "我现在怎么下去？";
		next;
		mes "[Rumis Block]";
		mes "等等，从这里能看得很清楚。";
		mes "留在这里研究怪物应该更安全、更方便。";
		next;
		mes "[Rumis Block]";
		mes "……我正在观察传闻中的生物希尔斯里翁。";
		mes "它全身覆盖柔软的毛，让我想起空中飘落的冰花。";
		mes "……哦，抱歉，我只是在自言自语。";
		next;
		mes "[Rumis Block]";
		mes "我会在这棵树上观察希尔斯里翁。"+strcharinfo(0)+"，能帮我收集 ^3131FF希尔斯里翁之角^000000 吗？";
		next;
		mes "[Rumis Block]";
		mes "它们的角可能拥有特殊力量，我想拿来进一步研究。";
		mes "……5 根就够了。";
		set ep13_animal,12;
		changequest 2154,2155;
		close;
	}
	else if (ep13_animal == 12) {
		if (countitem(6032) < 5) {
			mes "[Rumis Block]";
			mes "我想研究希尔斯里翁之角。请带 5 根给我，好吗？";
			close;
		}
		else {
			mes "[Rumis Block]";
			mes "...*Shiver*...";
			next;
			mes "[Rumis Block]";
			mes "...*Shiver*...";
			mes "...*Shiver*...";
			next;
			mes "[Rumis Block]";
			mes "...*Shiver*...";
			mes "...*Shiver*...";
			mes "...*Shiver*...";
			next;
			mes "[Rumis Block]";
			mes "啊！你回来了！";
			mes "呼……";
			next;
			mes "[Rumis Block]";
			mes "你没事吧？它们的獠牙看起来又尖又亮……";
			mes "哦对，你是这方面的专家。哈哈哈，我不用再担心你了。";
			next;
			mes "[Rumis Block]";
			mes "你带来希尔斯里翁之角了吗？";
			mes "你手里的就是那些角？";
			next;
			mes "[Rumis Block]";
			mes "Oh...";
			next;
			mes "[Rumis Block]";
			mes "Ho...";
			next;
			mes "[Rumis Block]";
			mes "嗯，看起来只是带螺旋纹的普通角。";
			mes "米德加尔特有这种角的怪物多得很。";
			next;
			mes "[Rumis Block]";
			mes "不过我仍不知道希尔斯里翁如何使用它们的角。";
			next;
			mes "[Rumis Block]";
			mes "如果视力不好，它们也许会用角当触角，或者……我知道你不想听我的猜测。抱歉。";
			next;
			mes "[Rumis Block]";
			mes "今天就到这里吧。多亏了你，我现在有信心下次独自来到这棵树。";
			next;
			mes "[Rumis Block]";
			mes "回营地吧，好吗？我有事要和你商量。";
			set ep13_animal,13;
			delitem 6032,5; //Horn_Of_Hilsrion
			changequest 2155,2156;
			close;
		}
	}
	end;
}


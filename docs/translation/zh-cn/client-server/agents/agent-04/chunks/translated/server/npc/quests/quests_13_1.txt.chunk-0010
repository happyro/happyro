spl_fild02,34,223,5	script	Small Fairy#spl	442,{
	if (BaseLevel > 69) {
		if (checkquest(2158) == -1) {
		mes "你发现灌木丛中有个小生物在飞。";
		mes "它背后有一对小翅膀……";
		mes "是妖精！";
			next;
			emotion ET_FRET;
			mes "[Small Fairy]";
			mes "RLGHLRXLA TKANTLFDMS";
			mes "WJACK TNAHRDNJSDMFH";
			mes "WLSGHKWND !!";
			next;
		mes "妖精注意到你，露出惊讶的表情。";
		mes "它在说什么，但你听不懂。";
			next;
		mes "你应该尽快向联合远征队报告。";
		mes "也许远征队的卫兵队长是合适的报告对象。";
			setquest 2158;
			close;
		}
	}
	emotion ET_FRET;
	if (!isequipped(2782) && ep13_2_rhea < 100) {
		mes "[Small Fairy]";
		mes "RLGHLRXLA TKANTLFDMS";
		mes "WJACK TNAHRDNJSDMFH";
		mes "WLSGHKWND !!";
		next;
		mes "惊讶的妖精在对你说话，但你听不懂妖精语言。";
		close;
	} else {
		mes "[Small Fairy]";
		mes "你是谁？！你在寻找萨帕吗！？";
		close;
	}
}


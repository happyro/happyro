//===== Current Version: ===================================== 
//= 1.1
//===== Compatible With: ===================================== 
//= rAthena Project
//===== Description: ========================================= 
//= [Official Conversion]
//= Guides for the city of Al De Baran.
//===== Additional Comments: ================================= 
//= 1.0 First version, Renewal guide.
//= 1.1 Navigation system update. [Euphy]
//=     Optimized.
//============================================================ 

aldebaran,139,63,4	script	Guide#01aldebaran::GuideAldearan	105,{
	cutin "prt_soldier",2;
	mes "[Al De Baran Guide]";
	mes "欢迎来到^8B4513艾尔迪巴兰^000000，";
	mes "这座边境城市。";
	mes "需要我帮您导航吗？";
	F_Navi("[Al De Baran Guide]");
	next;
	set .@str$,"还想查看其他地点吗？";
	while (1) {
		switch(select("[ 主要设施 ]:[ 商人和助手 ]:移除小地图标记:取消")) {
		case 1:
			set .@loop,1;
			while (.@loop) {
				switch(select("[ 卡普拉总部 ]:[ 炼金术士公会 ]:[ 钟楼 ]:[ 旅馆和工具店 ]:[ 修理和购买装备 ]:[ 酒馆 ]:返回上级菜单")) {
				case 1:
					callsub L_Mark, F_Navi("卡普拉总部","aldebaran,61,229","^B9062F");
					mes .@str$;
					viewpoint 1,61,229,0,0xFF0000;
					next;
					break;
				case 2:
					callsub L_Mark, F_Navi("炼金术士公会","aldebaran,60,60","^0000FF");
					mes .@str$;
					viewpoint 1,60,60,1,0x0A82FF;
					next;
					break;
				case 3:
					callsub L_Mark, F_Navi("钟楼","aldebaran,139,133","^FF5400");
					mes .@str$;
					viewpoint 1,139,133,2,0xFFB400;
					next;
					break;
				case 4:
					mes "[Al De Baran Guide]";
					mes "我来标记";
					mes F_Navi("旅馆和工具店","aldebaran,197,70","^006400")+"建筑";
					mes "已标记在您的小地图上。";
					mes .@str$;
					viewpoint 1,197,70,3,0xAAFF00;
					next;
					break;
				case 5:
					mes "[Al De Baran Guide]";
					mes "如果您想";
					mes F_Navi("购买或修理装备","aldebaran,197,70","^7F3300")+"，";
					mes "那么这里就是您要去的地方。";
					mes .@str$;
					viewpoint 1,72,197,4,0xD2691E;
					next;
					break;
				case 6:
					callsub L_Mark, F_Navi("酒馆","aldebaran,231,106","^800080");
					viewpoint 1,231,106,5,0xDA70D6;
					next;
					break;
				case 7:
					set .@loop,0;
					break;
				}
			}
			break;
		case 2:
			set .@loop,1;
			while (.@loop) {
				switch(select("[ 伊甸园传送员 ]:[ 卡普拉职员 ]:[ 克劳斯先生 ]:[ 厨师助手 ]:返回上级菜单")) {
				case 1:
					callsub L_Mark, F_Navi("伊甸园传送员","aldebaran,133,119","^B9062F");
					mes .@str$;
					viewpoint 1,133,119,6,0xFF0000;
					next;
					break;
				case 2:
					callsub L_Mark, "^0000FF卡普拉职员^000000";
					viewpoint 1,143,119,7,0x0A82FF;
					next;
					break;
				case 3:
					mes "[Al De Baran Guide]";
					mes "克劳斯先生可以将您传送到";
					mes F_Navi("卢迪","aldebaran,168,168","^006400")+"。";
					mes "让我在您的小地图上";
					mes "标记他的位置。";
					mes .@str$;
					viewpoint 1,168,168,8,0xAAFF00;
					next;
					break;
				case 4:
					callsub L_Mark, F_Navi("厨师助手","aldebaran,165,107","^7F3300");
					mes .@str$;
					viewpoint 1,165,107,9,0xD2691E;
					next;
					break;
				case 5:
					set .@loop,0;
					break;
				}
			}
			break;
		case 3:
			mes "[Al De Baran Guide]";
			mes "好的，我会移除您小地图上的所有标记。";
			mes "还有其他需要我帮忙的吗？";
			viewpoint 2,1,1,0,0xFFFF00;
			viewpoint 2,1,1,1,0x000000;
			viewpoint 2,1,1,2,0xFF0000;
			viewpoint 2,1,1,3,0xFFFF00;
			viewpoint 2,1,1,4,0xFFFF00;
			viewpoint 2,1,1,5,0xFFFF00;
			viewpoint 2,1,1,6,0xFFFF00;
			viewpoint 2,1,1,7,0xFFFF00;
			viewpoint 2,1,1,8,0xFFFF00;
			viewpoint 2,1,1,9,0xFFFF00;
			next;
			break;
		case 4:
			mes "[Al De Baran Guide]";
			mes "好的，那么";
			mes "祝您在这里过得愉快！";
			close2;
			cutin "prt_soldier",255;
			end;
		}
	}
	end;
L_Mark:
	mes "[Al De Baran Guide]";
	mes "让我标记";
	mes getarg(0);
	mes "在您小地图上的位置。";
	return;
}
aldebaran,243,143,2	duplicate(GuideAldearan)	Guide#02aldebaran	105
aldebaran,135,243,4	duplicate(GuideAldearan)	Guide#03aldebaran	105
aldebaran,36,135,6	duplicate(GuideAldearan)	Guide#04aldebaran	105

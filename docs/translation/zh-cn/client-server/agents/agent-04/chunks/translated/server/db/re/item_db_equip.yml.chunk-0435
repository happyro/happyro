  - Id: 480415
    AegisName: Gaebolg_Manteau
    Name: 盖博尔格斗篷
    Type: Armor
    Weight: 1600
    Defense: 142
    Slots: 1
    Locations:
      Garment: true
    ArmorLevel: 2
    EquipLevelMin: 245
    Refineable: true
    Gradable: true
    Script: |
      .@g = getenchantgrade();
      .@r = getrefine();
      bonus bPow,3;
      bonus bCon,3;
      bonus bAtkRate,(.@r/2);
      bonus bDef,10*(.@r/2);
      if (.@r>=7) {
         bonus bDelayrate,-5;
         if (.@r>=9) {
            bonus bLongAtkRate,5;
            bonus bShortAtkRate,5;
            if (.@r>=10) {
               bonus bPAtk,3;
               bonus bBaseAtk,20;
               if (.@r>=12) {
                  bonus bDelayrate,-5;
               }
            }
         }
      }
      if (.@g>=ENCHANTGRADE_D) {
         bonus bPAtk,2;
         bonus bAtkRate,3;
         if (.@g>=ENCHANTGRADE_C) {
            bonus bPAtk,3;
            if (.@g>=ENCHANTGRADE_B) {
               bonus bPAtk,5;
               bonus bAtkRate,2;
               if (.@g>=ENCHANTGRADE_A) {
                  bonus bDelayrate,-5;
                  bonus bPAtk,7;
                  bonus bAtkRate,4;
               }
            }
         }
      }

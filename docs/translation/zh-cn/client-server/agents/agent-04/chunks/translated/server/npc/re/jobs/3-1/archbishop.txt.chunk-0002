		next;
		mes ".............................";
		mes ".........................";
		mes ".....................";
		next;
		mes "^3131FF[Priest Dayan]^000000";
		mes "^3131FF第三条道路是喜悦之道。^000000";
		mes "^3131FF当你摆脱痛苦，心灵承受的苦难会减少；帮助并安慰他人时，你会体验生命的喜悦。^000000";
		next;
		mes "^3131FF[Priest Dayan]^000000";
		mes "^3131FF他们也会祝福你，因为你是克服苦难的喜悦存在。这称为洒水祈福。^000000。";
		mes "^3131FF你必须怀着感激饮下圣水，接受洒水祈福。^000000";
		next;
		mes "^3131FF[Priest Dayan]^000000";
		mes "^3131FF你正在饮用圣水。^000000";
		next;
		if (countitem(523) == 0) {
			mes "[" + strcharinfo(0) + "]";
			mes "糟糕！我忘了带圣水！";
			close;
		}
		mes "- 你恭敬地举起圣水，将杯子放到唇边。 -";
		next;
		mes "- * 洒水祈福！* -";
		specialeffect2 EF_ASPERSIO;
		next;
		specialeffect2 EF_RECOVERY;
		mes ".............................";
		next;
		mes ".............................";
		mes ".........................";
		next;
		mes ".............................";
		mes ".........................";
		mes ".....................";
		next;
		mes "^3131FF[Priest Dayan]^000000";
		mes "^3131FF最后一条道路是光明之道^000000。^000000.";
		mes "^3131FF你受到万物祝福，因此从一切罪孽中解脱。^000000";
		next;
		mes "^3131FF[Priest Dayan]^000000";
		mes "^3131FF你重生为光，唱响爱你的喜悦与灵魂之荣耀。^000000";
		next;
		mes "- 你深吸一口气，开始唱荣耀颂。";
		mes "赫瓦格密尔之泉响起和弦般的声音，瀑布声让你感到神清气爽。-";
		specialeffect2 EF_GLORIA;
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "～海姆达尔的后裔聚集在世界树尤克特拉希尔的梣树下。～";
		mes "～栖息在枝头的库尔丹鸟带给我整个世界的智慧。～";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "～库尔丹狼保护我免受世间一切威胁。～";
		specialeffect2 EF_GLORIA;
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "～巴拉斯卡夫的众生，从座位上起身吧。全世界都在欢呼。～";
		mes "～光明之父、智慧的诗人，为我歌唱。～";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "～闪耀玻璃的众生，赐予我神圣的预言。～";
		specialeffect2 EF_GLORIA;
		next;
		mes "- 歌曲结束后，你感到轻盈而强大，内心充满虔诚。-";
		specialeffect2 EF_BLESSING;
		specialeffect2 EF_RESURRECTION;
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "真令人振奋。";
		mes "我想该回去找 Dayan 牧师了。";
		set job_arch,3;
		close2;
		warp "umbala",138,219;
		end;
	} else if (job_arch == 3) {
		mes "[" + strcharinfo(0) + "]";
		mes "歌曲结束了。该回去找 Dayan 牧师了。";
		close2;
		warp "umbala",138,219;
		end;
	}
	end;
}

hu_in01,205,204,7	script	Praying Nun#benew	79,{
	if (job_arch == 4) {
		mes "- 一位修女闭着眼睛，低声念着像祷告一样的话。 -";
		next;
		if(select("和她交谈。:保持安静。") == 2) {
			mes "- 你不想打扰她。-";
			close;
		}
		mes "[" + strcharinfo(0) + "]";
		mes "呃，你好，修女？";
		next;
		mes "[Vinue]";
		mes "啊，欢迎。";
		mes "还没到礼拜的时间……";
		mes "你是来祈祷的吗，"+(Sex == SEX_MALE?"兄弟":"姐妹")+"？";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "我从普隆德拉的 Dayan 牧师那里来问候你。";
		next;
		mes "[Vinue]";
		mes "啊，是 Dayan 牧师。";
		mes "他还好吗？";
		mes "他虽然年纪大了，但很可爱。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "他说上次见你时你似乎很悲伤，所以很担心。";
		mes "他请你进行一次神圣朝圣。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "乌姆巴拉拥有自然的生命力！";
		next;
		mes "[Vinue]";
		mes "啊……";
		mes "他非常善良。你也是，"+(Sex == SEX_MALE?"兄弟":"姐妹")+"。";
		next;
		mes "[Vinue]";
		mes "但别担心。";
		mes "我只是因为噩梦有点累。";
		next;
		mes "[Vinue]";
		mes "邪恶一直在窥视我们的灵魂。";
		mes "如果你对祈祷漠不关心，邪恶就绝不会错过机会。";
		next;
		if(select("梦？什么样的梦？：你的灵魂应该没事。") == 2) {
			mes "[Vinue]";
			mes "哦，但你错了。";
			mes "我的灵魂可能最危险。";
			mes "谢谢你带来口信。";
			mes "我要继续祈祷了。";
			close;
		}
		mes "[Vinue]";
		mes "那是……";
		mes "其实从我被任命那天起就开始做噩梦。";
		next;
		mes "[Vinue]";
		mes "起初，梦见女武神悲伤地身处黑暗。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "女武神？";
		next;
		mes "[Vinue]";
		mes "是啊……";
		mes "她在漆黑的房间里哭泣。";
		mes "像被剪掉翅膀的鸟一样垂落着。";
		next;
		mes "[Vinue]";
		mes "但随着时间过去，梦变得更加可怕。现在女武神被锁链捆住，最后被砸得粉身碎骨。";
		next;
		mes "[Vinue]";
		mes "多么残酷的景象！我突然无法正常呼吸，然后惊醒。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "看着女武神死去，一定是折磨人的梦。";
		next;
		mes "[Vinue]";
		mes "这只是噩梦吗？";
		mes "还是你认为这是预兆？";
		next;
		mes "[Vinue]";
		mes "我一直想在奥丁神殿祈祷，让噩梦消失。但那座神殿很久以前就成了邪恶的巢穴。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "神殿？";
		mes "没人试过压制邪恶吗？";
		next;
		mes "[Vinue]";
		mes "遗憾的是，我是个不会驱魔的修女……";
		mes "胡戈尔的居民不熟悉冒险，只能对眼前的景象目瞪口呆。";
		next;
		mes "[Vinue]";
		mes "最近由于奥丁神殿的开发，那里人很多，但情况并不好。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "这个梦和奥丁神殿里的邪恶有关吗？";
		next;
		mes "[Vinue]";
		mes "嗯……这个嘛。";
		mes "我没有办法查明。";
		mes "我没有别的办法，只能祈祷。";
		next;
		if(select("我来替你调查。:我和你一起祈祷。") == 2) {
			mes "[Vinue]";
			mes "谢谢你。";
			mes "我会祈祷黑暗远离这里。";
			mes "希望你在胡戈尔的节日里玩得开心。";
			close;
		}
		mes "[Vinue]";
		mes "是吗？";
		mes "可是里面很可怕！";
		mes "里面有很多恶魔！";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "但我不能假装看不见陷入困境的修女吧？";
		mes "我是经历过无数苦修的牧师！";
		mes "交给我吧。";
		next;
		mes "[Vinue]";
		mes "啊……我好担心……";
		mes "我永远不会忘记你的热心。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "怎么去奥丁神殿？";
		next;
		mes "[Vinue]";
		mes "教堂右边有渡船。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "好，等我的好消息吧！";
		next;
		mes "[Vinue]";
		mes "我会祈祷你平安归来。";
		mes "也希望奥丁赐予你庇护。";
		set job_arch,5;
		changequest 2189,2190;
		close;
	} else if ((job_arch > 4) && (job_arch < 100)) {
		mes "[Vinue]";
		mes "我会祈祷你平安归来。";
		close;
	}
	mes "[Vinue]";
	mes "我感觉神清气爽。";
	mes "一定是好消息吧？";
	mes "感谢诸神。";
	close;
}

odin_tem02,282,263,0	script	#find_val	139,3,3,{
OnTouch:
	if ((job_arch > 4) && (job_arch < 100))
		hideoffnpc "Valkyrie Illusion#arch";
	end;
}

odin_tem02,281,275,3	script	Valkyrie Illusion#arch	403,{
	if ((job_arch > 4) && (job_arch < 100)) {
		mes "你看到一位面露绝望的女武神。";
		next;
		switch(select("触摸女武神的幻影。:转身离开。")) {
		case 1:
			mes "你靠近女武神幻影查看时失去了意识。";
			close2;
			specialeffect2 EF_CLOAKING;
			warp "job3_arch01",29,29;
			hideonnpc "Valkyrie Illusion#arch";
			end;
		case 2:
			mes "你因恐惧转身避开女武神的幻影。";
			close2;
			hideonnpc "Valkyrie Illusion#arch";
			end;
		}
	}
	end;
OnInit:
	hideonnpc "Valkyrie Illusion#arch";
	end;
}

job3_arch01,29,34,3	script	Valkyrie#arch	403,{
	if (checkweight(1201,1) == 0 || (MaxWeight - Weight) < 2000) {
		mes "- 请稍等！！-";
		mes "- 你携带的物品太多，-";
		mes "- 无法获得新的物品。-";
		mes "- 请卸下部分物品，-";
		mes "- 然后再来接受挑战。-";
		close;
	}
	if ((BaseLevel != 99) || (JobLevel < 50) || (BaseJob != Job_Priest)) {
		warp "odin_tem02",282,263;
		end;
	}
	if (getmercinfo(1)) {
		mes "[Valkyrie]";
		mes "如果想和我交谈，必须先^3131FF取消与所有佣兵的契约^000000。";
		close;
	}
	if (SkillPoint) {
		mes "不使用全部技能点就无法继续。请在继续前用完所有技能点～";
		close;
	}
	if (Class != Job_Priest && Class != Job_High_Priest && Class != Job_Baby_Priest) {
		warp "odin_tem02",282,263;
		end;
	} else if (Class != Job_Arch_Bishop && Class != Job_Arch_Bishop_T && Class != Job_Baby_Arch_Bishop) {
		if (job_arch < 5) {
			warp "odin_tem02",282,263;
			end;
		} else if (job_arch == 5) {
			mes "[Valkyrie]";
			mes "天界传来笛声，但不会飞的鸟只能爬行，最后在地上被碾得粉碎。";
			mes "啊，我好怨恨！好后悔！";
			next;
			mes "- 女武神捂住脸，随后发现了你，用威胁的目光盯着你。-";
			next;
			mes "[Valkyrie]";
			mes "你是作为凡人痛苦生活的海姆达尔后裔，为什么会在这里？";
			mes "你是来嘲笑我悲惨的命运吗？";
			next;
			mes "[" + strcharinfo(0) + "]";
			mes "怎么会！";
			mes "但我确实是为你而来。";
			next;
			mes "[Valkyrie Anguhilde]";
			mes "……我？";
			mes "当然，我留在米德加尔特，但我们受着无法在这个世界共存的命运枷锁。";
			next;
			mes "[Valkyrie Anguhilde]";
			mes "原来如此，你的目标是进入英灵殿吗？";
			mes "如果是这样，那你来错地方了。";
			next;
			mes "[Valkyrie Anguhilde]";
			mes "我已经被逐出阿斯加德。";
			mes "我的职责是保护这座小岛，不让人类从诸神手中夺走它，可我连这样做的力气都没有。";
			next;
			mes "[" + strcharinfo(0) + "]";
			mes "不是那种问题。";
			mes "但有人察觉到你的痛苦处境，把我派到了这里。";
			next;
			mes "[Valkyrie Anguhilde]";
			mes "哈哈！你要帮助我？！";
			next;
			mes "[Valkyrie Anguhilde]";
			mes "...................";
			next;
			mes "- 女武神狠狠地瞪着你。-";
			next;
			mes "[Valkyrie Anguhilde]";
			mes "事实上，我现在的身体什么也做不了。";
			next;
			mes "[Valkyrie Anguhilde]";
			mes "人类，回答我。你是真心来帮助我的吗？";
			next;
			if(select("是:否") == 2) {
				mes "[Valkyrie Anguhilde]";
				mes "我就知道不能相信人类！";
				close2;
				warp "odin_tem02",282,263;
				end;
			}
			mes "[Valkyrie Anguhilde]";
			mes "好吧……";
			mes "我没有独自支撑的力量，只能相信你。";
			next;
			mes "[Valkyrie Anguhilde]";
			mes "我曾是普通的女武神，按照奥丁的命令带领士兵前往英灵殿。";
			next;
			mes "[Valkyrie Anguhilde]";
			mes "但我伤害了奥丁的狼之一弗雷奇，因此被逐出阿斯加德，失去女武神的力量，只能奉命保护这座岛。";
			next;
			mes "[Valkyrie Anguhilde]";
			mes "我蒙受了耻辱。这座岛是奥丁和诸神的重要神殿。";
			mes "我努力保护这个圣地。";
			next;
			mes "[Valkyrie Anguhilde]";
			mes "但有一天，恶魔开始在这座岛上扩大影响。";
			mes "我不知道它们为何来到这里，也不知道来自何处。";
			next;
			mes "[Valkyrie Anguhilde]";
			mes "它们围攻神殿，我独自与它们战斗，耗尽了力量。";
			next;
			mes "[Valkyrie Anguhilde]";
			mes "圣殿被恶魔玷污。";
			mes "我还要受这种耻辱的命运折磨多久！";
			next;
			mes "[Valkyrie Anguhilde]";
			mes "凡人，你叫什么名字？";
			next;
			mes "[" + strcharinfo(0) + "]";
			mes "我的名字是" + strcharinfo(0) + "。";
			next;
			mes "[Valkyrie Anguhilde]";
			mes "" + strcharinfo(0) + ",";
			mes "你说过想帮助我，对吧？虽然这让我蒙羞，但我还是要请求你的帮助。";
			next;
			mes "[Valkyrie Anguhilde]";
			mes "这里看起来像是人类建造的。实际上，它是一座重要的纪念碑，也是诸神历史的一部分。";
			next;
			mes "[Valkyrie Anguhilde]";
			mes "我已经失去所有力量，身体也被封印，无法保护神殿。";
			mes "你必须尽快向英灵殿传信，请求女武神的帮助。";
			next;
			select("我该怎么做？");
			mes "[Valkyrie Anguhilde]";
			mes "在^3131FF神殿顶部^000000，你可以用^3131FF黄金笛^000000联系她们。";
			next;
			mes "[Valkyrie Anguhilde]";
			mes "我会给你一张用古老语言写成的卷轴。";
			mes "卷轴中记录着我的化身。";
			mes "^3131FF离开这里后，你可以用那张卷轴召唤女武神。^000000";
			next;
			mes "[Valkyrie Anguhilde]";
			mes "召唤我的化身后，你必须找到一支^3131FF破损的笛子^000000。";
			mes "它可能散落在神殿各处……";
			next;
			mes "[Valkyrie Anguhilde]";
			mes "你要前往神殿顶部，从化身那里收集所有破损的笛子。";
			mes "之后我会处理这件事。";
			next;
			mes "[Valkyrie Anguhilde]";
			mes "通过^FF0000ALT+点击^000000，化身会在你移动或攻击时提供帮助。";
			mes "但要小心化身倒下。";
			next;
			mes "[Valkyrie Anguhilde]";
			mes "准备好继续前进后，再来和我交谈。";
			mes "这会是一段漫长的旅程……";
			set job_arch,6;
			close;
		} else if (job_arch == 6) {
			if ($@archbs == 0) {
				set $@archbs,1;
				mes "[Valkyrie Anguhilde]";
				mes "" + strcharinfo(0) + "，你已经准备好开始苦修之路了吗？";
				next;
				if (getmapusers("job3_arch02") > 0) {
					mes "[Valkyrie Anguhilde]";
					mes "嗯，现在有人正在神殿里与恶魔战斗。";
					mes "请稍等，我去确认那个人是谁。";
					set $@archbs,0;
					close;
				}
				mes "[Valkyrie Anguhilde]";
				mes "好。现在我送你过去。";
				mes "^FF0000到那里后，必须用卷轴召唤我的替身^000000。别忘了。";
				set $@archbs,0;
				close2;
				nude;
				if (countitem(2798))
					delitem 2798,countitem(2798); //Will_Of_Exhausted_Angel
				donpcevent "start#arch::OnEnable";
				set job_arch,7;
				changequest 2190,2191;
				warp "job3_arch02",119,49;
				hideonnpc "Valkyrie#arch";
				end;
			}
			mes "[Valkyrie Anguhilde]";
			mes "我正在和另一个人交谈，请稍等。";
			close;
		} else if (job_arch == 7) {
			if (countitem(12381)) delitem 12381,countitem(12381); //ValkyrieA_Scroll
			if (countitem(12382)) delitem 12382,countitem(12382); //ValkyrieB_Scroll
			if ($@archbs == 0) {
				set $@archbs,1;
				mes "[Valkyrie Anguhilde]";
				mes "人类，你还好吗？";
				mes "事情没有我想象的那么容易。";
				mes "你要再次挑战吗？";
				next;
				if (getmapusers("job3_arch02") > 0) {
					set $@archbs,0;
					mes "[Valkyrie Anguhilde]";
					mes "嗯，现在有人正在神殿里与恶魔战斗。";
					mes "请稍等，我去确认那个人是谁。";
					close;
				}
				set $@archbs,0;
				mes "[Valkyrie Anguhilde]";
				mes "好。现在我送你过去。";
			mes "^FF0000到那里后，必须用卷轴召唤我的替身^000000。";
				mes "通过^FF0000ALT+点击^000000，化身会在你移动或攻击时提供帮助。";
				mes "但要小心化身倒下。";
				close2;
				nude;
				if (countitem(2798))
					delitem 2798,countitem(2798); //Will_Of_Exhausted_Angel
				donpcevent "start#arch::OnEnable";
				set job_arch,7;
				warp "job3_arch02",119,49;
				hideonnpc "Valkyrie#arch";
				end;
			}
			mes "[Valkyrie Anguhilde]";
			mes "我正在和另一个人交谈，请稍等。";
			close;
		}
	}
	end;
OnBc:
	set $@archbs,0;
	mapannounce "job3_arch01","女武神：我觉得有人在神殿里倒下了。我能听到恶魔令人不快的笑声。",bc_map,"0xFFCE00";
	hideoffnpc "Valkyrie#arch";
	end;
}

job3_arch02,119,49,0	script	#arch_1_start	139,6,6,{
OnTouch:
	if (countitem(12381) == 0)
		getitem 12381,1; //ValkyrieA_Scroll
	mapannounce "job3_arch02","化身低语：我感觉好沉重！放我出去！",bc_map,"0xFFCE00";
	disablenpc "#arch_1_start";

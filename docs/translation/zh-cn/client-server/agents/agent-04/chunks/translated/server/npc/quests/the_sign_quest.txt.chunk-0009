			mes "我不认为你会知道！";
			set .@npc_p,.@npc_p+1;
		}
		else {
			donpcevent "Jesqurienne#sign::OnOmg";
			mes "[杰斯库里恩]";
			mes "我……";
			mes "等等，";
			mes "我知道这个……";
			mes "（哦，糟糕！）";
		}
		next;
		if (.@npc_p > .@user_p) {
			mes "[杰斯库里恩]";
			mes "哦？真意外。";
			mes "我领先。我知道悬念";
			mes "一定让你";
			mes "很煎熬，但我很确定";
			mes "赢家会是";
			mes "我我我我～";
		}
		else if (.@npc_p == .@user_p) {
			mes "[杰斯库里恩]";
			mes "你在抄";
			mes "我的答案？因为";
			mes "我们现在不可能";
			mes "打平……";
		}
		else {
			mes "[杰斯库里恩]";
			mes "我……";
			mes "我一定比想象中";
			mes "醉得更厉害，";
			mes "不然怎么会落后……";
		}
		next;
		switch(rand(1,3)) {
		case 1:
			mes "[艾伦]";
			mes "6. 1 个空瓶的";
			mes "正确重量是多少？";
			mes "";
			next;
			if (select("1:2:3") == 2) set .@user_p,.@user_p+1;
			break;
		case 2:
			mes "[艾伦]";
			mes "6. 选择";
			mes "印度鱼排物品的正确防御值。";
			mes "";
			next;
			if (select("0:1:2:3") == 4) set .@user_p,.@user_p+1;
			break;
		case 3:
			mes "[艾伦]";
			mes "6. 1 个空瓶的";
			mes "城市是？";
			mes "";
			next;
			if (select("Al De Baran:Alberta:Comodo:Izlude") == 2) set .@user_p,.@user_p+1;
			break;
		}
		if (rand(1,10) < 9 ) {
			donpcevent "Jesqurienne#sign::OnHo";
			mes "[杰斯库里恩]";
			mes "^333333*叹气……*^000000";
			mes "简单的问题，";
			mes "简单的答案。";
			mes "你答对了吗？";
			set .@npc_p,.@npc_p+1;
		}
		else {
			donpcevent "Jesqurienne#sign::OnOmg";
			mes "[杰斯库里恩]";
			mes "等、等等……！";
			mes "我知道这题的";
			mes "答案！让我";
			mes "想想……";
			mes "";
		}
		next;
		if (.@npc_p > .@user_p) {
			mes "[杰斯库里恩]";
			mes "哦，看看。";
			mes "我的分数比你高。";
			mes "我知道追上我一定很";
			mes "令人沮丧";
			mes "。";
		}
		else if (.@npc_p == .@user_p) {
			mes "[杰斯库里恩]";
			mes "嗯……？";
			mes "你怎么作弊的？！";
			mes "你和我同分";
			mes "一定不可能！";
		}
		else {
			mes "[杰斯库里恩]";
			mes "我不明白。";
			mes "你的分数更高——";
			mes "我不……你怎么……为什么会这样？";
		}
		next;
		switch(rand(1,3)) {
		case 1:
			mes "[艾伦]";
			mes "7. 51乘以15，除以3，再加5等于多少？";
			next;
			if (select("250:255:260:265") == 3) set .@user_p,.@user_p+1;
			break;
		case 2:
			mes "[艾伦]";
			mes "7. 4560除以4，再除以2，加3等于多少？";
			next;
			if (select("573:574:575:576") == 1) set .@user_p,.@user_p+1;
			break;
		case 3:
			mes "[艾伦]";
			mes "7. 3102加500，再加4，除以6等于多少？";
			next;
			if (select("600:601:602") == 2) set .@user_p,.@user_p+1;
			break;
		}
		if (rand(1,10) < 9 ) {
			donpcevent "Jesqurienne#sign::OnHo";
			mes "[杰斯库里恩]";
			mes "数学？我的脑子就是计算器！";
			mes "Ho ho ho~!";
			set .@npc_p,.@npc_p+1;
		}
		else {
			donpcevent "Jesqurienne#sign::OnOmg";
			mes "[杰斯库里恩]";
			mes "什么——？！为什么所有数学题都用文字写，而不是传统的数字和符号？！回答我——！！";
		}
		next;
		if (.@npc_p > .@user_p) {
			mes "[杰斯库里恩]";
			mes "啊，我告诉过你我现在领先吗？让我提醒你一下，免得我忘了。呵呵呵呵～！";
		}
		else if (.@npc_p == .@user_p) {
			mes "[杰斯库里恩]";
			mes "就是这样。我不明白你的分数怎么会和我一样。你是不是用了什么办法获得额外分数？！";
		}
		else {
			mes "[杰斯库里恩]";
			mes "没有其他解释了！你一定用了小抄！但你把它藏在哪里？";
		}
		next;
		switch(rand(1,2)) {
		case 1:
			mes "[艾伦]";
			mes "8. 选择离朱诺物品升级处最近的建筑。";
			next;
			if (select("酒馆:魔物图书馆:工具店:武器店") == 4) set .@user_p,.@user_p+1;
			break;
		case 2:
			mes "[艾伦]";
			mes "8. 选择不会造成属性伤害的猎人陷阱技能。";
			next;
			if (select("阔剑地雷:冰冻陷阱:冲击波陷阱:地雷") == 3) set .@user_p,.@user_p+1;
			break;
		}
		if ( rand(1,10) < 9 ) {
			donpcevent "Jesqurienne#sign::OnHo";
			mes "[杰斯库里恩]";
			mes "哈哈～！这太简单了！";
			set .@npc_p,.@npc_p+1;
		}
		else {
			donpcevent "Jesqurienne#sign::OnOmg";
			mes "[杰斯库里恩]";
			mes "呃……为什么我不知道这题？！";
		}
		next;
		if (.@npc_p > .@user_p) {
			mes "[杰斯库里恩]";
			mes "我知道你在想，世上怎么会有这么聪明的人。";
			mes "嗯，我的智慧大概平衡了世上其他人的愚蠢……";
		}
		else if (.@npc_p == .@user_p) {
			mes "[杰斯库里恩]";
			mes "我们的分数怎么会一样？不……不……";
			mes "想想，杰斯库里恩……时间旅行不可能。";
			mes "但你为什么要为了测验答案进行时间旅行？";
		}
		else {
			mes "[杰斯库里恩]";
			mes "我……不明白。你、你怎么会赢？我的现实观开始……";
		}
		next;
		switch(rand(1,2)) {
		case 1:
			mes "[艾伦]";
			mes "9. 哪种魔物会从火属性短剑受到最多伤害？";
			next;
			if (select("短剑哥布灵:钉锤哥布灵:晨星哥布灵:铁锤哥布灵") == 4) set .@user_p,.@user_p+1;
			break;
		case 2:
			mes "[艾伦]";
			mes "9. 选择对法师技能‘石化术’免疫的魔物。^FFFFFFaaaaaa aaaaaaa aaaaaa aaaaaaa aaaaaaaaa^000000";
			next;
			if (select("长老树精:邪恶德鲁伊:木莲:马克") == 2) set .@user_p,.@user_p+1;
			break;
		}
		if ( rand(1,10) < 9 ) {
			donpcevent "Jesqurienne#sign::OnHo";
			mes "[杰斯库里恩]";
			mes "啊……我轻松通过了这个测验挑战！你是不是很辛苦？";
			set .@npc_p,.@npc_p+1;
		}
		else {
			donpcevent "Jesqurienne#sign::OnOmg";
			mes "[杰斯库里恩]";
			mes "啊……？我不明白自己为什么不知道这题……";
		}
		next;
		if (.@npc_p > .@user_p) {
			mes "[杰斯库里恩]";
			mes "哇哈哈哈！";
			mes "只剩一道题了！你必须答对，否则我会永远叫你笨蛋！";
		}
		else if (.@npc_p == .@user_p) {
			mes "[杰斯库里恩]";
			mes "我们平局？！糟糕……我最好答对最后一题。（希望你答错！）";
		}
		else {
			mes "[杰斯库里恩]";
			mes "我正在输？！";
			mes "我们已经到最后一道题了？！";
		}
		next;
		switch(rand(1,2)) {
		case 1:
			mes "[艾伦]";
			mes "10. 选择与其他 NPC 外貌不同的那一个。";
			next;
			if (select("普隆德拉霍尔格伦:普隆德拉玩偶商人:伊斯鲁得肉商:梦罗克肉商") == 3) set .@user_p,.@user_p+1;
			break;
		case 2:
			mes "[艾伦]";
			mes "10. 选择初心者职业无法装备的物品。";
			next;
			if (select("葬礼帽:脚镣:木铠甲:内裤") == 3) set .@user_p,.@user_p+1;
			break;
		}
		if ( rand(1,10) < 9 ) {
			donpcevent "Jesqurienne#sign::OnHo";
			mes "[杰斯库里恩]";
			mes "和往常一样，我把最后一道题答对了～";
			set .@npc_p,.@npc_p+1;
		}
		else {
			donpcevent "Jesqurienne#sign::OnOmg";
			mes "[杰斯库里恩]";
			mes "啊……刚才的问题是什么来着？不——我错过了！";
		}
		next;
		mes "[艾伦]";
		mes "好了，测验结束！现在我要公布参赛者的结果……";
		next;
		mes "[艾伦]";
		mes "嗯……";
		mes ""+ strcharinfo(0) +":";
		mes ""+.@user_p+" points!";
		next;
		mes "[艾伦]";
		mes "杰斯库里恩……";
		mes ""+.@npc_p+" points!";
		next;
		if (.@npc_p > .@user_p) {
			set sign_q,23;
			emotion ET_KIK;
			mes "[杰斯库里恩]";
			mes "哇哈哈哈！我赢了！我就知道！呵呵呵呵呵～";
		}
		else if (.@npc_p == .@user_p) {
			set sign_q,24;
			mes "[杰斯库里恩]";
			mes "平局？！好吧，我很佩服。";
			mes "我承认，你比我想象中聪明……";
		}
		else {
			set sign_q,24;
			mes "[杰斯库里恩]";
			mes "不……！我无法相信……";
		}
		next;
		mes "[艾伦]";
		mes "谢谢你参与！";
		mes ".......................";
		mes "...........................";
		mes "好了，继续喝酒！";
		close;
	}
	else {
		emotion ET_HUK;
		mes "天哪……！要么是啤酒眼镜太紧，";
		mes "要么你就是我一生见过最美丽的女人！";
		next;
		if (Sex == SEX_MALE) {
			select("呃，我是男的……");
			emotion ET_CRY;
			mes "[艾伦]";
			mes "不、不会吧……！";
			mes "也许我明天还要上课，";
			mes "应该少喝点酒……";
		}
		else {
			select("谢谢你～");
			emotion ET_BEST;
			mes "[艾伦]";
			mes "啊，是的。你的风格、你美妙的身材，";
			mes "你的一切都很美！而且你还很聪明！";
			next;
			emotion ET_BIGTHROB;
			mes "[艾伦]";
			mes "我当然知道！我不仅教课，";
			mes "空闲时还是测验挑战大师～";
			mes "你真是一颗宝石……";
		}
		close;
	}
OnSmile:
	emotion ET_SMILE;
	end;
}

cmd_in02,88,51,4	script	Strange Guy#sign	806,{
	callfunc "F_UpdateSignVars";
	mes "[Dearles]";
	if (sign_q < 25) {
		mes "不……！该死，又来了！我的好运什么时候才开始？";
		next;
		mes "[Dearles]";
		mes "嘿，你看起来像是想从我这里得到什么。";
		if (Zeny < 10000) {
			mes "哼！你很穷！";
			emotion ET_HNG;
			mes "看来你也没什么钱～！像你这种厚脸皮的寄生虫，就该被我这种人教训！";
			percentheal -10,0;
			close;
		}
		else {
			mes "看来你有多余的 Zeny！我就自己拿来借用一点吧！^FF0000嗖！^000000";
			set Zeny, Zeny-10000;
			specialeffect EF_COIN;
			close;
		}
	}
	else if (sign_q == 25) {
		mes "不……！该死，又来了！我的好运什么时候才开始？";
		next;
		switch(select("打扰一下……:只是路过。")) {
		case 1:
			mes "[Dearles]";
			mes "什么事？！我没心情和陌生人聊天，直说吧～！";
			next;
			switch(select("哦，没什么。:我是来找梅兹的……？")) {
			case 1:
				mes "[Dearles]";
				mes "什么……？你打扰我，害我无缘无故输掉比赛？";
				mes "我要把你打个半死！砰砰砰！";
				close2;
				percentheal -100,0;
				soundeffect "effect\\sign_noise.wav",1;
				percentheal -99,0;
				warp "comodo",122,100;
				end;
			case 2:
				mes "[Dearles]";
				mes "哦，你是来找呜咽星光的？如果想参加我的测试，费用是30,000 Zeny。接受还是离开，明白吗？";
				next;
				mes "[Dearles]";
				mes "如果你付不起，我就不和你浪费时间。";
				mes "把费用当作测试前置条件吧，用来筛掉无关人员。";
				set sign_q,26;
				close;
			}
		case 2:
			mes "[Dearles]";
		mes "糟糕……！我快破产了！";
		mes "但我得赢回所有钱！不工作的话，怎么才能快速弄到钱……";
		mes "";
		mes "";

}

ecl_in01,48,97,1	script	Combat Laphine#143_9	4_F_FAIRYSOLDIER,{
	mes "[Combat Laphine]";
	mes "我决定参军时一定是疯了。唉，真理之门为什么要建得那么高？";
	close;
}

ecl_in01,46,102,3	script	Commander Laphine#143_1	4_M_FAIRYSOLDIER,5,5,{
	mes "[Commander Laphine]";
	mes "必须将邪恶扼杀在萌芽。";
	mes "你们是来自米德加尔特大陆的不速之客。";
	next;
	mes "[Commander Laphine]";
	mes "如果你会给我们或世界树带来毁灭，我们绝不会犹豫与你战斗。";
	close;

OnTouch_:
	if (.talk == 0) {
		.talk = 1;
		npctalk "指挥官：士兵们，终于到了运用训练成果的时候！";
		sleep 2000;
		npctalk "Argh!", "Combat Laphine#143_4";
		npctalk "Argh!", "Combat Laphine#143_5";
		npctalk "Argh!", "Combat Laphine#143_6";
		npctalk "Ah!", "Combat Laphine#143_7";
		npctalk "Argh!", "Combat Laphine#143_8";
		npctalk "Argh!", "Combat Laphine#143_9";
		sleep 2000;
		npctalk "指挥官：刚才是谁在呜咽？";
		sleep 3000;
		npctalk "指挥官：别让斯普兰迪德前进基地的同伴失望！";
		sleep 3000;
		npctalk "指挥官：集中注意力！我们要消灭恶魔之神！";
		sleep 2000;
		npctalk "Yeah, yeah.", "Combat Laphine#143_7";
		sleep 2000;
		npctalk "...", "Combat Laphine#143_4";
		npctalk "Ah...", "Combat Laphine#143_5";
		npctalk "...", "Combat Laphine#143_6";
		npctalk "...", "Combat Laphine#143_8";
		sleep 3000;
		npctalk "指挥官：啊，我突然看不见了……";
		.talk = 0;
	}
	end;
}

ecl_in01,37,90,3	script	Magic Scholar Lemony#14	4_F_FAIRY2,{
	mes "[Lemony]";
	mes "你读过最新一期《真理之门》杂志吗？";
	mes "上面真的介绍了 Avant 的新传送器吗？";
	next;
	mes "[Armandi]";
	mes "是的，只是基本原理和与人类相关的信息。";
	mes "我没完全理解。";
	next;
	mes "[Lemony]";
	mes "不知道这是否意味着阿凡特终于决定追求自己的研究兴趣。";
	next;
	mes "[Lemony]";
	mes "嘿，人类。";
	mes "你刚才在偷听我们吗？不过我们也没在讨论什么秘密。";
	next;
	mes "[Lemony]";
	mes "哦，对了。你也要去那里吗？";
	mes "你知道，创造了部分时空次元裂隙的恶魔之神藏身处最近被发现了。";
	next;
	mes "[Lemony]";
	mes "好奇的话就用那边通往藏身处的传送器。";
	mes "那里会有精彩景象。";
	mes "哦，顺便说，你可能会丢掉性命。*咯咯*";
	next;
	mes "[Armandi]";
	mes "莱蒙尼，你真的该改善一下自己的性格。";
	mes "啧，啧。";
	close;
}

ecl_in01,35,89,6	script	Magic Scholar Armandi#1	4_M_FAIRYKID6,{
	mes "[Armandi]";
	mes "希望次元装置不会给世界带来沉重代价。";
	mes "顺便说，阿凡特总是让我惊叹。";
	next;
	mes "[Lemony]";
	mes "啊，我讨厌那家伙。";
	next;
	mes "[Armandi]";
	mes "阿凡特也许令人反感，";
	mes "但他最擅长自己的工作。";
	next;
	mes "[Lemony]";
	mes "这一点我同意。";
	mes "只有他能造出这种传送器。";
	mes "不过，他为什么要帮助市长？";
	next;
	mes "[Armandi]";
	mes "我问他时，他含糊地说了些关于忏悔的话。";
	mes "我只能猜测这和市长的出生有关。";
	next;
	mes "[Armandi]";
	mes "我本想多问一些，但他傲慢地看着我。";
	mes "唉，真不公平，这种混蛋竟被认为是魔法科学领域的佼佼者。";
	next;
	mes "[Lemony]";
	mes "你总可以努力学习，超过他。";
	close;
}


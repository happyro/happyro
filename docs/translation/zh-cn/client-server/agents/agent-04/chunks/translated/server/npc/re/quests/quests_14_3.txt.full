moro_vol,91,105,1	script	Eclage Teleporter#143_1	PORTAL,{
	mes "[Dophe]";
	mes "这座传送器连接至艾可拉治。";
	mes "行动结束后它会被摧毁，但目前我们离不开它。";
	next;
	mes "使用传送器前往艾可拉治。";
	next;
	if (select( "前往艾可拉治。", "取消。" ) == 2) {
		mes "不要使用传送器。";
		close;
	}
	mes "前往艾可拉治。";
	close2;
	warp "ecl_in01",38,96;
	end;
}

ecl_in01,38,98,1	script	Interdimensional Device#ecl	PORTAL,{
	if (ep14_3_newerabs < 10) {
		mes "[Eclage Guard]";
		mes "这座传送器连接至最近发现的恶魔之神藏身处。";
		mes "只有获准进入藏身处的人才能使用。";
		close;
	}
	mes "这座传送器连接至最近发现的恶魔之神藏身处。";
	mes "你想使用它吗？";
	next;
	if (select( "前往恶魔之神藏身处。", "Quit." ) == 2) {
		mes "不要使用传送器。";
		close;
	}
	mes "使用传送器前往恶魔之神的藏身处。";
	close2;
	warp "moro_vol",91,102;
	end;
}

ecl_in01,40,96,3	script	Eclage Guard#143_6	4_M_FAIRYSOLDIER,{
	mes "[Eclage Guard]";
	mes "我能帮你什么？";
	next;
	switch( select( "那座传送器是什么？", "这里为什么这么拥挤？", "恶魔之神的藏身处？", "再见。" ) ) {
	case 1:
		mes "[Eclage Guard]";
		mes "它连接着最近发现的恶魔之神藏身处。";
		mes "这是经过科学设计的，可以将使用者直接送到藏身处所在的次元裂隙。";
		next;
		mes "[Eclage Guard]";
		mes "许多战士已经前往藏身处。";
		mes "只要摩洛克存在，伊格德拉希尔就不安全。我要加入远征队。";
		close;
	case 2:
		mes "[Eclage Guard]";
		mes "原来恶魔之神从摩洛克逃来，藏在我们的维度。";
		mes "必须处理掉他，要么将他驱逐回自己的领域，要么消灭他。";
		next;
		mes "[Eclage Guard]";
		mes "想加入讨伐恶魔之神的远征队，就使用这座传送器。";
		mes "它会直接把你送到远征营地。";
		close;
	case 3:
		mes "[Eclage Guard]";
		mes "你知道次元裂隙，对吧？最近发现裂隙由多个维度通道组成。";
		mes "现在我们可以利用那些通道探索裂隙内部。";
		next;
		mes "[Eclage Guard]";
		mes "裂隙原本是恶魔之神为了逃跑而创造的，";
		mes "所以人们认为调查裂隙就能找到他。";
		next;
		mes "[Eclage Guard]";
		mes "确实如此；最终发现了他的藏身处。";
		mes "主要在中央巨山附近发现他的踪迹和恶魔士兵。";
		next;
		mes "[Eclage Guard]";
		mes "如果你想了解更多详情，就去现场看看。";
		mes "使用那边的传送器即可。";
		close;
	case 4:
		mes "[Eclage Guard]";
		mes "愿伊格德拉希尔祝福你。";
		close;
	}
}


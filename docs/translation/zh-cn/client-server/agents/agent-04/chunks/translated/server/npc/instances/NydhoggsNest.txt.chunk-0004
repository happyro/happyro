2@nyd,202,324,5	script	World Tree Yggdrasil#2F	437,3,3,{
	mes "[World Tree Yggdrasil]";
	mes "谢谢你。你是人类和拉斐内族的救世主。";
	next;
	mes "[World Tree Yggdrasil]";
	mes "你击败了尼德霍格之影。但……它并未永远消失，只是力量陷入沉睡。";
	next;
	mes "[World Tree Yggdrasil]";
	mes "但你为我们赢得了大量时间。这太好了。";
	next;
	mes "[World Tree Yggdrasil]";
	mes "请向斯普兰迪德和马努克的负责人报告此事。";
	next;
	mes "[World Tree Yggdrasil]";
	mes "正如你所见，世界树的衰弱并不是萨帕族或拉斐内族的过错。一切都是因为守护者之影……";
	next;
	mes "[World Tree Yggdrasil]";
	mes "守护者的疯狂……由我们未知的力量造成……你必须把这告诉所有人。";
	next;
	mes "[World Tree Yggdrasil]";
	mes "现在……让我护送你离开被诅咒的巢穴。";
	next;
	switch(select("请让我出去。:我想再看看。")) {
	case 1:
		'ins_nyd2 = 0;
		// ins_nyd2 = 0;
		set ins_nyd,203;
		//setquest 3135;
		warp "nyd_dun02",98,196;
		end;
	case 2:
		mes "[World Tree Yggdrasil]";
	mes "是这样吗……如果你想离开，我会在附近。";
		close;
	}

OnInstanceInit:
OnDisable:
	disablenpc instance_npcname("World Tree Yggdrasil#2F");
	end;

OnEnable:
	enablenpc instance_npcname("World Tree Yggdrasil#2F");

1@nyd,213,277,5	script	Murdered Yggdrasilid#1F	437,5,5,{
	if ('ins_nyd2 == 0) {
		mes "当微光进入你的心，一道声音在脑中响起。";
		next;
		mes "[World Tree World Tree Yggdrasil]";
		mes "一切都结束了……守护者的仆人……快离开这里。";
		next;
		while(1) {
			switch(select("你是谁？:你是什么意思？")) {
			case 1:
				mes "[World Tree World Tree Yggdrasil]";
				mes "我……我是世界树 Yggdrasil，尼德霍格守护者的仆人，也是领导拉斐内族的大神官。";
				next;
				mes "[World Tree World Tree Yggdrasil]";
				mes "所以你不是拉斐内族的女祭司……你怎么进来的？不，没时间回答了。";
				next;
				mes "[World Tree World Tree Yggdrasil]";
				mes "快……离开……趁还来得及离开这里。";
				next;
				break;
			case 2:
				mes "[World Tree World Tree Yggdrasil]";
				mes "守护者……守护者出了问题。我不知道是什么让他变成这样。";
				next;
				mes "[World Tree World Tree Yggdrasil]";
				mes "这……这里已经不再是世界树 Yggdrasil 守护者的巢穴。";
				next;
				mes "[World Tree Yggdrasil]";
				mes "黑暗控制了守护者，摧毁了所有生物……这里已成为魔物的诅咒之家。";
				next;
				mes "[World Tree Yggdrasil]";
				mes "现在邪恶的尼德霍格之影正在这里肆虐……";
				next;
				mes "[World Tree Yggdrasil]";
				mes "现在还不算太晚，快离开……把这里的事告诉拉斐内族……告诉艾尔帕兰指挥官……";
				next;
				mes "[World Tree Yggdrasil]";
				mes "我的灵魂……被困在这里。现在我只能信任你们。";
				next;
				set .@exit,1;
			}
			if (.@exit) break;
		}
		select("尼德霍格之影？");
		mes "[World Tree Yggdrasil]";
		mes "守护者尼德霍格……他不在巢穴。";
		next;
		mes "[World Tree Yggdrasil]";
		mes "他……不知为何抛弃自己的影子离开了。";
		next;
		mes "[World Tree Yggdrasil]";
		mes "留下的只有丑陋的尼德霍格守护者之影……那个正在发疯的影子。";
		next;
		mes "[World Tree Yggdrasil]";
		mes "影子吸干世界树 Yggdrasil 的所有养分，得不到更多后发疯了。现在他想要这片土地。";
		next;
		mes "[World Tree Yggdrasil]";
		mes "一旦影子离开这里，从其他世界树窃取力量，就会造成巨大毁灭，世界将变成地狱。";
		next;
		mes "[World Tree Yggdrasil]";
		mes "你必须……把这件事告诉艾尔帕兰指挥官，并制定计划。只有他们……";
		next;
		select("我们没有其他办法了吗？");
		mes "[World Tree Yggdrasil]";
		mes "以我们现在的力量……不可能击败守护者。";
		next;
		mes "[World Tree Yggdrasil]";
		mes "但发疯的不是守护者，而是他的黑暗影子……也许我们能把他困在这里……";
		next;
		mes "[World Tree Yggdrasil]";
		mes "你愿意接受这项任务吗？即使要付出生命？";
		next;
		if(select("交给我们吧。:我们做不到。") == 2)
			close;
		mes "[World Tree Yggdrasil]";
		mes "感谢你的决定。我会用剩余力量打开通往守护者巢穴的道路。";
		next;
		mes "[World Tree Yggdrasil]";
		if (is_party_leader() == true) {
			mes "守护者巢穴就在北方巨大世界树 Yggdrasil 旁的瀑布后。圣域防御机制会立即启动。";
			next;
			mes "[World Tree Yggdrasil]";
			mes "击败尼德霍格所有守护者，穿过瀑布进入巢穴……在那里阻止尼德霍格之影。";
			next;
			mes "[World Tree Yggdrasil]";
			mes "大门很快会打开。去击败所有守护者……必须在 30 分钟内杀光它们……";
			next;
			mes "[World Tree Yggdrasil]";
		mes "30 分钟……这是我力量的极限。请快一点。";
			next;
			mes "[World Tree Yggdrasil]";
			mes "还有……小心……小心影子的力量。";
			'ins_nyd2 = ins_nyd2 = 1;
			donpcevent instance_npcname("ins_nyd_1f_timer")+"::OnEnable";
			donpcevent instance_npcname("nyd_call_mon_1")+"::OnEnable";
			close;
		} else {
			mes "守护者巢穴就在北方巨大世界树 Yggdrasil 旁的瀑布后。防御机制会立即启动。";
			next;
			mes "[World Tree Yggdrasil]";
			mes "击败尼德霍格的所有守护者，穿过瀑布进入巢穴……在那里阻止尼德霍格之影。";
			next;
			mes "[World Tree Yggdrasil]";
			mes "大门很快会打开。去击败所有守护者……必须在大门打开前的 30 分钟内杀光它们……";
			next;
			mes "[World Tree Yggdrasil]";
			mes "30 分钟……这是我力量的极限。请快一点。";
			next;
			mes "[World Tree Yggdrasil]";
			mes "还有……小心……小心影子的力量。";
			close;
		}
	} else if ('ins_nyd2 == 1) {
		mes "[World Tree Yggdrasil]";
		mes "守护者巢穴就在北方巨大世界树 Yggdrasil 旁的瀑布后。防御机制会立即启动。";
		next;
		mes "[World Tree Yggdrasil]";
		mes "击败尼德霍格的所有守护者，穿过瀑布进入巢穴……在那里阻止尼德霍格之影。";
		next;
		mes "[World Tree Yggdrasil]";
		mes "大门很快会打开。去击败所有守护者。";
		close;
	} else if ('ins_nyd2 == 2) {
		mes "[World Tree Yggdrasil]";
		mes "守护者巢穴就在北方巨大世界树 Yggdrasil 旁的瀑布后。";
		next;
		mes "[World Tree Yggdrasil]";
		mes "使用你的力量……摧毁邪恶的影子……";
		next;
		mes "[World Tree Yggdrasil]";
		mes "这……就是我能为你做的一切……";
		close;
	} else {
		mes "[World Tree Yggdrasil]";
		mes "想玷污守护者神圣圣域的人……滚出去。";
		warp "mid_camp",100,100;
	}
	end;

OnTouch:
	if ('ins_nyd2 == 0) {
		mes "拉斐内族的女人在这里做什么……";
		next;
		mes "发生什么事了？我们去看看。";
		close;
	}
	end;

OnInstanceInit: // Temporary fix for @reloadscript.
	set 'ins_nyd2,0;
	end;
}


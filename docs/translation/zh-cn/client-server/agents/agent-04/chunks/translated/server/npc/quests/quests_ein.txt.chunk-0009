		mes "但敲击表面后，";
		mes "你听到令人沮丧的";
		mes "空洞声。看来它";
		mes "缺少了一些零件……^000000";
		close;
	}
	end;
}

ein_in01,46,197,3	script	Conveyor#ins	111,{
	if (EinFactory == 7 || EinFactory == 8) {
		if (isbegin_quest(8023) == 1)
			changequest 8023,8024;

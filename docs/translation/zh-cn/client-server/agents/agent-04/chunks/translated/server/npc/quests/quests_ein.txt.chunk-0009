		mes "机械臂似乎也没有足够力量";
		mes "承受它搬运的负载。";
		mes "传送带上的螺丝看起来";
		mes "松动且已经生锈。^000000";
		close;
	}
	end;
}

ein_in01,100,266,3	script	Pipe#ins	111,{
	if (EinFactory == 9 || EinFactory == 10) {
		if (isbegin_quest(8025) == 1)
			changequest 8025,8026;
		set EinFactory,10;
		mes "^3355FF检查这根管道";
		mes "没有花太长时间。";
		mes "它因为长时间";
		mes "承受过大的压力，";
		mes "已经膨胀并磨损。";
		mes "还没爆炸真是奇迹。";
		mes "需要立即处理。";
		close;
	}
	end;
}

ein_in01,95,239,3	script	Conveyor#ins2	111,{
	if (EinFactory == 11 || EinFactory == 12) {
		if (isbegin_quest(8027) == 1)
			changequest 8027,8028;
		set EinFactory,12;
		mes "^3355FF这条传送带似乎";
		mes "和较小的那条有类似问题。";
		mes "它的运动笨拙、";
		mes "不稳定而且无力，";
		mes "几乎所有螺丝都生锈了。^000000";
		mes "应该尽快维修。";
		close;
	}
	end;
}

// Administrator NPC used to rig the invasion in Einbroch.
sec_in02,127,86,3	script	Factory Quest Test	851,{
	set .@i, callfunc("F_GM_NPC",8028,0,0,9000);
	if (.@i == -2) {
		mes "[Test1]";
		mes "呜呀～";
		close;
	} else if (.@i == -1) {
		mes "[Test1]";
		mes "要取消吗～？";
		mes "现在还可以返回。";
		close;
	} else if (.@i == 0) {
		mes "[Test1]";
		mes "哇……";
		mes "那实在";
		mes "太不对劲了！";
		close;
	} else {
		mes "[Test1]";
		mes "工厂任务的";
		mes "全局变量当前值";
		mes "是";
		mes "is... ^3355FF" + z + "^000000.";
		mes "要修改吗？";
		next;
		switch(select("0:10:Invade")) {
		case 1:
			mes "[Test1]";
			mes "好……！";
			mes "已经";
			mes "改成‘0’。";
			set $EinPolution,0;
			close;
		case 2:
			mes "[Test2]";
			mes "好……！";
			mes "已经";
			mes "改成‘10’。";
			set $EinPolution,10;
			close;
		case 3:
			donpcevent "Einbroch Smog Alert::OnEnable";
			close;
		}
	}
}

// Murder Quest :: ein_main_tre
//============================================================ 
einbech,165,105,7	script	Buender Hikeman#ein	847,{
	cutin "ein_hicman",2;
	if (Shinokas_Quest == 0) {
		mes "[Buender Hikeman]";
		mes "...";
		mes "......";
		next;
		mes "[Buender Hikeman]";
		mes "...";
		mes "......";
		mes "……你……";
		emotion ET_QUESTION, playerattached();
		next;
		mes "[Buender Hikeman]";
		mes "...";
		mes "......";
		mes "……你……";
		mes "……住手……";
		next;
		mes "[Buender Hikeman]";
		mes "...";
		mes "......";
		mes "……你……";
		mes "……住手……";
		mes "……你这个^FF0000混蛋^000000！";
		next;
		mes "[Buender Hikeman]";
		mes "啊啊啊啊啊！！";
		next;
		mes "^3355FF老人看到你后似乎";
		mes "有些恼怒。遗憾的是，";
		mes "他的尖叫和喃喃自语";
		mes "完全无法理解。^000000";
		mes "他已经神志不清。";
		next;
		mes "[Buender Hikeman]";
		mes "就是^FF0000你^000000！";
		mes "都是你的责任！";
		mes "你夺走了我的一切";
		mes "！！";
		next;
		switch(select("‘你在说什么？’:不理他。")) {
		case 1:
			mes "[Buender Hikeman]";
			mes "你竟敢……";
			mes "你竟敢这样对我，";
			mes "毁掉我生命中的";
			mes "所有幸福！";
			next;
			mes "[Buender Hikeman]";
			mes "该死的……";
			mes "你怎么敢";
			mes "厚颜无耻地装作";
			mes "什么都没发生？！";
			mes "^333333*C-cough Cough...*^000000";
			next;
			break;
		case 2:
			mes "[Buender Hikeman]";
			mes "等……等等！";
			mes "我说等等！";
			mes "^333333*Cough!*^000000";
			close2;
			cutin "ein_hicman",255;
			end;
		}
		mes "[Buender Hikeman]";
		mes "你竟然邪恶到";
		mes "可以轻易忘记";
		mes "你对我们的生活做了什么？";
		mes "你已经忘了";
		mes "你在艾音贝赫";
		mes "做过的事吗？！";
		next;
		mes "[Buender Hikeman]";
		mes "那已经是很久以前的事，";
		mes "但我永远不会忘记。";
		mes "这个小镇虽然不大，";
		mes "却充满了";
		mes "心地温暖的人……";
		next;
		mes "[Buender Hikeman]";
		mes "我、哈尔托普、阿努托、";
		mes "马斯卡伦特……我们都是朋友，";
		mes "被那位大商人雇来";
		mes "在矿井里";
		mes "挖掘矿石。";
		next;
		mes "[Buender Hikeman]";
		mes "然后还有你！我们所有人";
		mes "组成了";
		mes "最棒的采矿队伍！";
		mes "直到我们发现了";
		mes "^FF0000它^000000。";
		next;
		mes "[Buender Hikeman]";
		mes "没错……";
		mes "那种神秘的矿石";
		mes "闪耀着";
		mes "绚丽的光芒。";
		next;
		mes "[Buender Hikeman]";
		mes "但我们本该知道";
		mes "^3131FFUngoliant^000000会在那种矿石附近。";
		mes "我们本该意识到";
		mes "其中的危险……";
		mes "可是已经太迟了。";
		next;
		mes "[Buender Hikeman]";
		mes "我们把发现报告给雇主，";
		mes "然后矿石就消失了。";
		mes "他一定把它送到了某处，";
		mes "那已经不是我们的事了。";
		mes "我们也没有多问。";
		next;
		mes "[Buender Hikeman]";
		mes "之后生活暂时恢复了正常。";
		mes "但有一天你向我们大喊，";
		mes "说你在矿井里发现了";
		mes "另一种特别而神秘的";
		mes "矿石。";
		mes "我们赶去查看。";
		next;
		mes "[Buender Hikeman]";
		mes "但当我们过去检查";
		mes "你挖出的洞时，";
		mes "你知道我们发现了";
		mes "什么吗……？！";
		next;
		switch(select("Ungoliant?:A mysterious ore, right?:Nothing...?")) {
		case 1:
			mes "[Buender Hikeman]";
			mes "你不记得";
			mes "发生什么了吗？那时你";
			mes "对我们做了什么？！";
			next;
			break;
		case 2:
			mes "[Buender Hikeman]";
			mes "你不记得";
			mes "发生什么了吗？那时你";
			mes "对我们做了什么？！";
			next;
			break;
		case 3:
			mes "[Buender Hikeman]";
			mes "没错……";
			mes "什么都没有。";
			next;
			break;
		}
		mes "[Buender Hikeman]";
		mes "洞里什么都没有！";
		mes "空空如也！";
		next;
		mes "[Buender Hikeman]";
		mes "然后你指着我们身后的墙，";
		mes "尖叫说 Ungoliant 要来了！";
		mes "我们惊慌失措，";
		mes "开始挖掘逃生通道！";
		mes "只能拼命向外挖。";
		next;
		mes "[Buender Hikeman]";
		mes "我记得你脸上的表情很奇怪。我当时以为你很悲伤，但现在我确定你被贪婪吞噬了！我们信任你，你却背叛了我们！^FFFFFF ^000000";
		next;
		mes "[Buender Hikeman]";
		mes "当我们终于砸开";
		mes "最后一道墙时，周围的一切";
		mes "开始坍塌。我们是";
		mes "隧道坍塌后仅存的";
		mes "两个幸存者。";
		next;
		mes "[Buender Hikeman]";
		mes "后来我才知道……";
		mes "这一切都是你计划好的。";
		setquest 2071;
		set Shinokas_Quest,1;
		close2;
		cutin "ein_hicman",255;
		end;
	}
	else if (Shinokas_Quest == 1) {
		mes "[Buender Hikeman]";
		mes "混蛋！";
		mes "我受够了";
		mes "你的谎言！";
		next;
		switch(select("我不是你想的那个人！:你是怎么在事故中活下来的？")) {
		case 1:
			mes "[Buender Hikeman]";
			mes "哈……！";
			mes "你以为我会这么轻易";
			mes "忘记那个人的脸吗，";
			mes "就是他";
			mes "毁了我的生活？！";
			mes "我绝不会忘记。";
			next;
			break;
		case 2:
			break;
		}
		next;
		mes "[Buender Hikeman]";
		mes "我醒来时，";
		mes "正趴在那条黑暗隧道的";
		mes "废墟中。";
		mes "浑身都是尘土。";
		next;
		mes "[Buender Hikeman]";
		mes "然后我发现……";
		mes "你知道我发现了什么。";
		next;
		mes "[Buender Hikeman]";
		mes "^333333*Cough Cough*^000000";
		mes "是我朋友们的尸体！";
		mes "哈尔托普、阿努托、马斯卡伦特！";
		mes "他们都是优秀的人，也是我最好的朋友。";
		mes "可是你在哪里？！";
		next;
		mes "[Buender Hikeman]";
		mes "到处都找不到你的身体。";
		mes "我搜遍隧道，最后";
		mes "爬到了外面，";
		mes "在那里被发现时已经昏迷。";
		mes "没人知道你去了哪里。";
		next;
		mes "[Buender Hikeman]";
		mes "我真是太蠢了。";
		mes "都是因为那块矿石！";
		mes "你为了那东西杀害了我们的";
		mes "朋友，毁掉了";
		mes "我的人生！";
		next;
		mes "[Buender Hikeman]";
		mes "而现在……";
		mes "你从藏身处";
		mes "再次出现。";
		mes "你想从我这里得到什么？";
		mes "你还想夺走";
		mes "什么？！";
		next;
		switch(select("我不是你想的那个人！:我想道歉。")) {
		case 1:
			mes "[Buender Hikeman]";
			mes "别再撒谎了！";
			mes "你再次出现";
			mes "勾起了我的仇恨！";
			mes "我永远不会";
			mes "忘记那一天！";
			next;
			break;
		case 2:
			mes "[Buender Hikeman]";
			mes "哈哈……";
			mes "道歉？";
			mes "伤害已经";
			mes "造成了……";
			next;
			break;
		}
		mes "[Buender Hikeman]";
		mes "现在对你来说太迟了。";
		mes "为了我的朋友们，";
		mes "我要复仇！";
		mes "你必须付出代价！";
		next;
		mes "[Buender Hikeman]";
		mes "准备受死吧！";
		mes "^3131FFShinokas^000000!!!!";
		next;
		mes "[Buender Hikeman]";
		mes "...!";
		mes "^333333*Cough! Cough!*^000000";
		mes "不——！不、不是现在……";

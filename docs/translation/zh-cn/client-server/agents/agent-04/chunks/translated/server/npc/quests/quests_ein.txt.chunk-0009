		mes "但仔细检查后，你发现它";
		mes "会发出奇怪的摩擦声，";
		mes "表面还有几颗螺丝松动。";
		mes "需要尽快维修。";
		close;
	}
	end;
}

ein_in01,62,258,3	script	Main Control Panel#ins	111,{
	if (EinFactory == 5 || EinFactory == 6) {

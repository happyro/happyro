	mes "啊，抱歉，我说太多了";
	mes "关于自己的问题……";
	next;
	switch(select("你人手不足吗？:不用，没关系。")) {
	case 1:
		mes "[泽尔梅托]";
		mes "是的！";
		mes "我没有足够的人手";
		mes "检查";
		mes "工厂机器并";
		mes "确定";
		mes "问题所在。";
		next;
		mes "[泽尔梅托]";
		mes "这是很耗时的";
		mes "任务，我想亲自做。";
		mes "但在这和管理";
		mes "工人之间，";
		mes "我没有足够的人手，时间实在不够……";
		next;
		switch(select("我可以帮你。:继续加油。")) {
		case 1:
			mes "[泽尔梅托]";
			mes "你能帮我？";
			mes "我知道这种事";
			mes "要求太过分，";
			mes "但我会接受任何帮助";
			mes "别人提供的。我真的";
			mes "很绝望。";
			next;
			mes "[泽尔梅托]";
			mes "好，我让你";
			mes "检查工厂里的机器";
			mes "一台一台地检查。";
			mes "我们必须知道";
			mes "哪些需要维修";
			mes "哪些运行正常。";
			next;
			mes "[泽尔梅托]";
			mes "首先，找到第 ^FF0000二个控制";
			mes "面板^000000 并确认它的";
			mes "状态。我相当确定它";
			mes "很久以前就坏了，但";
			mes "确认一下也没坏处。";
			mes "你应该很容易找到。";
			next;
			setquest 8017;
			set EinFactory,1;
			mes "[泽尔梅托]";
			mes "检查完后回来报告，";
			mes "这样我才能告诉你";
			mes "下一台该检查的机器。";
			mes "再次感谢你";
			mes "愿意帮忙。";
			mes "辛苦了。";
			close;
		case 2:
			mes "[泽尔梅托]";
			mes "唉，也只能这样过活。";
			mes "^333333*叹气*^000000 我能忍受";
			mes "我能忍受这些，";
			mes "但希望上级能考虑改善";
			mes "这里的工作环境……";
			close;
		}
	case 2:
		mes "[泽尔梅托]";
		mes "谢谢你的";
		mes "好意。";
		mes "请不要";
		mes "把我刚才告诉你的事";
		mes "告诉任何人。";
		close;
	}
}

ein_in01,49,232,3	script	2nd Control Panel#ins	111,{
	if (EinFactory == 1 || EinFactory == 2) {
		if (isbegin_quest(8017) == 1)
			changequest 8017,8018;
		set EinFactory,2;
		mes "^3355FF这是泽尔梅托让你检查的";
		mes "第二个控制面板。";
		mes "看起来完全坏了：螺丝";
		mes "不见了，铁盖也被掰开，";
		mes "露出里面纠缠成团的电线。^000000";
		close;
	}
	end;
}

ein_in01,108,217,3	script	3rd Pressure Governor#1	111,{
	if (EinFactory == 3 || EinFactory == 4) {

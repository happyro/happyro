que_thor,145,66,3	script	Guard#vol::VeinsGuard	939,{
	if (aru_vol == 11) {
		mes "[守卫]";
		mes "只有获得授权的人员才能进入这里。";
		mes "请表明身份！";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "我是吉奥主任手下的研究生，";
		mes "在维因斯地质研究所工作。";
		mes "能请你帮我给这份温度报告盖章吗？";
		next;
		mes "[守卫]";
		mes "哦，我明白了。不过我不负责盖章。";
		mes "进去找萨赫迪帮忙吧。";
		mes "他就在火车站南边的飞艇那里。";
		changequest 2120,2121;
		set aru_vol,12;
		close2;
		warp "thor_camp",248,190;
		end;
	}
	else if ((aru_vol > 11) && (aru_vol < 24)) {
		mes "[守卫]";
		mes "哦，你就是研究所的那个学生。";
		mes "我想我们近期不会收到报告。";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "哦，我们刚发现使用的仪器有故障，";
		mes "所以必须修改报告。";
		next;
		mes "[守卫]";
		mes "你的工具第一次就坏了？好吧，好吧，";
		mes "我能理解。你可以通过了。";
		close2;
		warp "thor_camp",248,190;
		end;
	}
	mes "[守卫]";
	mes "你是谁？！";
	close;
}


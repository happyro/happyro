			mes "表面温度。^000000";
			mes "";
			next;
			mes "^3131FF哔——哔——哔——^000000";
			next;
			mes "^3131FF当前温度：2300 ThT^000000";
			next;
			mes "^3355FF你把温度记录在报告中。^000000";
			changequest 2117,2118;
			set aru_vol,9;
			next;
			mes "["+strcharinfo(0)+"]";

thor_camp,250,104,3	script	Sahedi#vol	934,{
	if ((MaxWeight-Weight) < 2000 || checkweight(1201,1) == 0) {
		mes "^3355FF请稍等！";
		mes "你现在携带了";
		mes "太多物品。";
		mes "请先回来，";
		mes "使用卡普拉服务";
		mes "存放部分物品。^000000";
		close;
	}
	if (aru_vol == 12) {
		mes "[萨赫迪]";
		mes "抱歉，我不认识你。这里只有获得授权的人员才能进入，";
		mes "如果你没有理由来这里……";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "我是吉奥主任手下的研究生，";
		mes "在维因斯地质研究所工作。";
		mes "能请你帮我给这份温度报告盖章吗？";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "呃，吉奥现在生病了，";
		mes "所以让我替他填写并提交报告。";
		next;
		mes "[萨赫迪]";
		mes "啊，原来这就是他的报告这次迟到的原因。";
		mes "听到这个我很遗憾。";
		mes "我还以为他只是把时间浪费在";
		mes "女人和酒上……";
		next;
		mes "[萨赫迪]";
		mes "让我看看……";
		next;
		emotion ET_HUK;
		mes "[萨赫迪]";
		mes "天啊！温度为什么这么高？！";
		mes "过去也收到过几份类似报告，但……";
		mes "这……情况有多糟？";
		next;
		emotion ET_PROFUSELY_SWEAT, playerattached();
		mes "["+strcharinfo(0)+"]";
		mes "哦……哦，不！";
		mes "糟糕！如果高于正常值……";
		mes "可能会很严重？";
		next;
		mes "[萨赫迪]";
		mes "我该怎么办？";
		mes "要拉响警报吗？我不……";
		mes "我不想死！";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "你最好先冷静下来。";
		mes "我会在营地周围看看，";
		mes "所以暂时别说会让其他人恐慌的话。";
		next;
		mes "[萨赫迪]";
		mes "好吧……";
		mes "请去看看这个营地能否躲过灾难。";
		changequest 2121,2122;
		set aru_vol,13;
		delitem 7342,1; //File01
		close;
	}
	else if ((aru_vol > 12) && (aru_vol < 23)) {
		mes "[萨赫迪]";
		mes "那么，我们有危险吗？";
		mes "这座火山看起来很快会喷发吗？";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "哦，我还没有调查完。";
		mes "请再等一会儿好吗？";
		next;
		mes "[萨赫迪]";
		mes "好，好。记得替我彻底检查火山里的一切，好吗？";
		close;
	}
	else if (aru_vol == 23) {
		mes "[萨赫迪]";
		mes "那么，我们有危险吗？";
		mes "这座火山看起来很快会喷发吗？";
		next;
		while(1) {
			if (select("是:否") == 1) {
				mes "["+strcharinfo(0)+"]";
				mes "我想我瞒不过你……这座火山最近的活动";
				mes "确实……令人不安。";
				next;
				break;
			}
			else {
				mes "^3355FF等等……你应该利用这个情况。";
				mes "这可能是你介入两国冲突的机会！^000000";
				next;
				mes "^3355FF你也许无法阻止战争，";
				mes "但可以用自然灾害的威胁分散他们的注意力……^000000";
				next;
			}
		}
		emotion ET_HUK;
		mes "[萨赫迪]";
		mes "啊？你是认真的吗？";
		mes "托尔火山要喷发？！我、我们必须赶快离开这里！";
		mes "这会是一场灾难，就像过去发生的那样！";
		next;
		emotion ET_SPARK, playerattached();
		mes "["+strcharinfo(0)+"]";
		mes "是的，我同意。很可能会发生爆炸……";
		mes "并造成大量附带损害。";
		next;
		mes "[萨赫迪]";
		mes "我们的情况有多危险？";
		mes "我们有多少时间撤离？";
		next;
		emotion ET_SPARK, playerattached();
		mes "["+strcharinfo(0)+"]";
		mes "嗯……呃……";
		mes "根据我的数据……";
		mes "分析结果……未来三十天内";
		mes "喷发概率为75%。";
		next;
		mes "[萨赫迪]";
		mes "什么？！我们必须立即向大祭司报告！艾特拉！";
		next;
		enablenpc "Aitra#vol";
		mes "[艾特拉]";
		mes "是，长官！";
		next;
		mes "[萨赫迪]";
		mes "这是紧急情况。";
		mes "尽快把这条消息带给大祭司。";
		mes "离开前别忘了收拾好你的东西。";
		next;
		mes "[艾特拉]";
		mes "啊？";
		mes "……是，长官。";
		next;
		disablenpc "Aitra#vol";
		mes "[萨赫迪]";
		mes "哦，这简直是噩梦……";
		mes "请把报告交给你的主任吉奥。";
		mes "希望他能给出应对这场灾难的建议……";
		changequest 2128,60211;
		set aru_vol,24;
		getitem 7342,1; //File01
		close;
	}
	mes "[萨赫迪]";
	mes "啊，我忙得不可开交！";
	close;
}



ve_in,281,214,3	script	Bookshelf#vol	111,{
	if ((MaxWeight-Weight) < 2000 || checkweight(1201,1) == 0) {
		mes "^3355FF请稍等！";
		mes "你现在携带了";
		mes "太多物品。";
		mes "请先回来，";
		mes "使用卡普拉服务";
		mes "存放部分物品。^000000";
		close;
	}
	if (aru_vol == 8) {
		if (countitem(7342) == 0) {
			mes "^3355FF你在书架上的书之间";
			mes "发现一捆随意";
			mes "夹着的报告。^000000";
			mes "";
			getitem 7342,1; //File01
			close;
		}
		mes "^3355FF书架上有许多";
		mes "散乱的书和";
		mes "笔记本，";
		mes "放得到处都是。^000000";
		close;
	}
	else if ((aru_vol > 8) && (aru_vol < 25)) {
		mes "^3355FF书架上有许多";
		mes "散乱的书和";
		mes "笔记本，";
		mes "放得到处都是。^000000";
		close;
	}
	else if (aru_vol == 25) {
		mes "^3355FF书架上有许多";
		mes "散乱的书和";
		mes "笔记本，";
		mes "放得到处都是。^000000";
		next;
		mes "^3355FF快速查看后，";
		mes "你注意到";
		mes "乔说过的灰紫色盒子。你闭上";
		mes "眼睛伸手进入";
		mes "乔的紫色物品盒。^000000";
		mes "";
		next;
		changequest 60212,60213;
		set aru_vol,26;
		set .@box_box,rand(1,20);
		if (.@box_box < 7) {
			getitem 12104,1; //Random_Quiver
		}
		else if ((.@box_box > 6) && (.@box_box < 9)) {
			getitem 661,1; //Sway_Apron
		}
		else if ((.@box_box > 8) && (.@box_box < 20)) {
			getitem 12027,5; //Giggling_Box
		}
		else {
			getitem 12103,1; //Bloody_Dead_Branch
		}
		getexp (checkre(3))?100000:800000,0;
		mes "^3355FF你已经尽力了。";
		mes "";
		mes "现在是时候";
		mes "回去找大祭司泽德。^000000";
		close;
	}
	mes "^3355FF书架上有许多";
	mes "散乱的书和";
	mes "笔记本，";
	mes "放得到处都是。^000000";
	close;
}

thor_v01,37,234,3	script	Hot Land Surface#1	111,{
	if (aru_vol == 8) {
		if ((countitem(7704) > 0) && (countitem(7342) > 0)) {
			mes "^3355FF你使用高温计检查";

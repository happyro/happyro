comodo,180,153,4	script	Sonotora#1	90,{
	mes "[雅典娜·索诺托拉]";
	mes "听说";
	mes "著名的舞蹈学校";
	mes "科莫多的舞蹈学校";
	mes "很快就要开学了。";
	next;
	mes "[雅典娜·索诺托拉]";
	mes "啊……";
	mes "成为聚光灯下的";
	mes "首席舞者！";
	next;
	mes "[雅典娜·索诺托拉]";
	mes "我也想报名，";
	mes "但要求";
	mes "太严格了，不知道";
	mes "是否该试试看……";
	close;
}

comodo,193,151,4	script	Bor Robin#1	86,{
	mes "[博尔·罗宾]";
	mes "啊…….";
		mes "首席舞者";
	mes "首席舞者！";
	mes "我能亲眼看着她们成为舞者……！";
	next;
	mes "[博尔·罗宾]";
	mes "身为男人真是太好了！";
	mes "这个时代万岁！科莫多剧院万岁！";
	next;
	mes "[博尔·罗宾]";
		mes "嗯？";
	mes "你也想";
	mes "去吗？";
	mes "这是观看舞者转职测试的好机会。";
	next;
	if (select("Go to the Job Change Area:Cancel") == 1) {
		mes "[博尔·罗宾]";
		mes "耶～～";
		mes "我们走！";
		close2;
		warp "job_duncer",70,49;
		end;
	}
	mes "[博尔·罗宾]";
	mes "呃……";
	mes "既然你不想";
	mes "陪我一起去，";
	mes "那我也没办法。";
	close;
}

job_duncer,43,93,4	script	Aile#da	724,{
	if (Upper == 1) {
		mes "[艾尔]";
		mes "一二三四，";
		mes "二二三四，";
		mes "三四，三四，";
		mes "一二三四。";
		mes "嗯？";
		next;
		mes "[艾尔]";
		mes "抱歉，你这样盯着我看，打断了我的练习。";
		next;
		mes "[艾尔]";
		mes ".......";
		mes "……嘿，我以前见过你吗？";
		next;
		mes "[艾尔]";
		mes "呃……";
		mes "奇怪，我想不起在哪里见过你。";
		close2;
		cutin "",255;
		end;
	}
	if (BaseJob != Job_Archer) {
		if (BaseJob == Job_Bard) {
			cutin "job_dancer_eir01",2;
			mes "[艾尔]";
			mes "欢迎~！";
			mes "如果你有新歌，";
			mes "请告诉我。我们的演出总是需要新音乐来搭配。";
			close2;
			cutin "",255;
			end;
		}
		else if (BaseJob == Job_Dancer) {
			cutin "",2;
			mes "[艾尔]";
			mes "欢迎~！";
			mes "最近过得";
			mes "怎么样？";
			mes "很多人喜欢";
			mes "你的演出吗？";
			close2;
			cutin "",255;
			end;
		}
		cutin "job_dancer_eir03",2;
		mes "[艾尔]";
		mes "欢——嗯？";
		mes "嘿，只有获准人员才能来这里。不是谁都能进入舞蹈学校。";
		next;
		mes "[艾尔]";
		mes "想观看的话，为什么不去城里的舞台呢？";
		close2;
		cutin "",255;
		end;
	}
	if (DANC_Q == 0 && Sex == SEX_FEMALE && BaseJob == Job_Archer) {
		cutin "job_dancer_eir01",2;
		mes "[艾尔]";
		mes "欢迎~！";
		mes "这里就是";
		mes "‘科莫多舞蹈学校’，";
		mes "我们教授来自不同国家的舞蹈，为世界各地的旅行者提供娱乐。";
		next;
		mes "[艾尔]";
		mes "我们也为有志成为舞者的人提供机会，让他们在卢恩·米德加尔兹王国成名！在聚光灯下跳舞听起来很棒吧？";
		next;
		mes "[艾尔]";
		mes "我得先说明，我们学校招生很严格。看起来没有舞者天赋的学生，我们不会接受。";
		next;
		cutin "job_dancer_eir02",2;
		mes "[艾尔]";
		mes "你觉得怎么样？";
		mes "想报名吗？只需在申请表上填写几项内容，再来上几次课试试就行。";
		next;
		cutin "job_dancer_eir01",2;
		mes "[艾尔]";
		mes "那么你想";
		mes "做什么呢~？";
		next;
		if (select("Fill out the application.:I'll pass.") == 1) {
			if (JobLevel > 39) {
				cutin "job_dancer_eir02",2;
				mes "[艾尔]";
				mes "选得好！！";
				mes "就在那边填写申请表吧。";
				next;
				mes "...";
				next;
				mes "...";
				mes "......";
				next;
				mes "^3355FF*Shuffle Shuffle*^000000";
				next;
				cutin "job_dancer_eir01",2;
				mes "[艾尔]";
				mes "你的名字是";
				mes "" + strcharinfo(0) + "?";
				mes "哇！真好听的名字！等一下，我得拿给校长看，你过一会儿再回来，好吗？";
				close2;
				cutin "",255;
				set DANC_Q,1;
				setquest 7000;
				end;
			}
			else {
				cutin "job_dancer_eir01",2;
				mes "[艾尔]";
				mes "嗯……";
				mes "看来你还不够资格入学。";
				mes "你至少需要职业等级 40。";
				next;
				mes "[艾尔]";
				mes "希望你达到要求后";
				mes "再来申请。";
				mes "";
				mes "";
				close2;
				cutin "",255;
				end;
			}
		}
		cutin "job_dancer_eir01",2;
	mes "[艾尔]";
	mes "哎呀~";
	mes "再考虑一下吧。";
	mes "改变主意的话，";
	mes "别忘了回来。";
		close2;
		cutin "",255;
		end;
	}
	else if (Sex == SEX_MALE) {
		cutin "job_dancer_eir03",2;
		mes "[艾尔]";
		mes "欢——嗯？";
		mes "嘿，这里只允许获准人员进入。想唱歌的话，去考虑成为诗人吧。";
		next;
		mes "[艾尔]";
		mes "不是所有弓箭手";
		mes "都能成为舞者。";
		mes "至少不先改变性别是不行的~";
		close2;
		cutin "",255;
		end;
	}
	else if (DANC_Q == 1) {
		cutin "job_dancer_eir01",2;
		mes "[艾尔]";
		mes "很好。";
		mes "既然你已经报名，我来告诉你上课需要带些什么。";
		next;
		mes "[艾尔]";
		mes "我们有些物资短缺，不过反正你自己也会用到。把它们当作学费的一部分，不必太担心。";
		next;
		set .@item_nd,rand(1,10);
		if (.@item_nd > 0 && .@item_nd < 3) {
			set DANC_Q,2;
			changequest 7000,7001;
			mes "[艾尔]";
			mes "首先是^CD688910,000 Zeny^000000学费。然后需要^CD688920个黏稠液体^000000擦鞋。";
			next;
			mes "[艾尔]";
			mes "再带^CD68893个杰勒比结晶^000000和^CD68895瓶红色药水^000000做药膏。当然还需要一双^CD6889鞋子^000000。";
			next;
			mes "[艾尔]";
			mes "再说一次，需要：";
			mes "^CD688910,000 Zeny^000000、";
			mes "^CD688920个黏稠液体^000000、";
			mes "^CD68893个杰勒比结晶^000000、";
			mes "^CD68895瓶红色药水^000000和";
			mes "^CD68891双鞋子^000000。";
		}
		else if (.@item_nd == 4) {
			set DANC_Q,3;
			changequest 7000,7002;
			mes "[艾尔]";
			mes "首先是^CD688910,000 Zeny^000000学费。再带^CD68895个蚯蚓皮^000000擦地板，当然还要一双^CD6889长靴^000000。";
			next;
			mes "[艾尔]";
			mes "再说一次，需要：";
			mes "^CD688910,000 Zeny^000000、";
			mes "^CD68895个蚯蚓皮^000000和";
			mes "^CD68891双长靴^000000。";
		}
		else {
			set DANC_Q,4;
			changequest 7000,7003;
			mes "[艾尔]";
			mes "首先是^CD688910,000 Zeny^000000学费。再带^CD68892个蛤蜊壳^000000做服装，以及^CD68895瓶黄色药水^000000和^CD688920个杰勒比结晶^000000治疗脚伤。";
			next;
			mes "[艾尔]";
			mes "还要带^CD688910根黑色头发^000000制作演出用假发，当然还要一双^CD6889凉鞋^000000。再说一次，需要……";
			next;
			mes "[艾尔]";
			mes "^CD688910,000 Zeny^000000、";
			mes "^CD68892个蛤蜊壳^000000、";
			mes "^CD68895瓶黄色药水^000000、";
			mes "^CD688920个杰勒比结晶^000000、";
			mes "^CD688910根黑色头发^000000和";
			mes "^CD6889凉鞋^000000。";
		}
		next;
		mes "[艾尔]";
		mes "收集齐所需物品后再回来，我们就可以开始上课了，好吗？";
		close2;
		cutin "",255;
		end;
	}
	else if (DANC_Q >= 2 && DANC_Q <= 4) {
		switch(DANC_Q) {
		case 2: 
			setarray .@item[0], 938,909,501,2403;
			setarray .@count[0], 20,3,5,1;
			break;
		case 3: 
			setarray .@item[0], 1055,2405;
			setarray .@count[0], 5,1;
			break;
		case 4: 
			setarray .@item[0], 965,503,909,1020,2401;
			setarray .@count[0], 2,5,20,10,1;
			break;
		}
		set .@size, getarraysize(.@item);
		for( set .@i, 0; .@i < .@size; set .@i,.@i+1 ) {
			if( countitem(.@item[.@i]) < .@count[.@i] ) {
				break;
			}
		}
		if( .@i == .@size && Zeny > 9999 ) {
			cutin "job_dancer_eir02",2;
			mes "[艾尔]";
			mes "哦……！";
			mes "你把东西";
			mes "都带来了！";
			mes "那么好，";
			mes "让我收下你的";
			mes "学费。";
			next;
			cutin "job_dancer_eir01",2;
			set Zeny, Zeny-10000;
			mes "[艾尔]";
			mes "接下来去找负责面试的^CD6889比茹^000000。她有几件事要问你。";
			set DANC_Q,5;
			if(checkquest(7001) != -1) {
				changequest 7001,7004;
			}
			else if(checkquest(7002) != -1) {
				changequest 7002,7004;
			}
			else {
				changequest 7003,7004;
			}
			close2;
			cutin "",255;
			end;
		}
		else {
			cutin "job_dancer_eir01",2;
			mes "[艾尔]";
			mes "嗯……？";
			mes "你还没把";
			mes "东西带齐吗？";
			mes "我提醒你一下，";
			mes "下次把需要的带来。";
			mes "";
			next;
			mes "[艾尔]";
			mes "需要带来……";
			mes "^CD688910,000 Zeny^000000,";
			if (DANC_Q == 2) {
				mes "^CD6889"+.@count[0]+" "+getitemname(.@item[0])+"^000000,";
				mes "^CD6889"+.@count[1]+" "+getitemname(.@item[1])+"^000000,";
				mes "^CD6889"+.@count[2]+" "+getitemname(.@item[2])+"^000000 和";
				mes "^CD6889"+.@count[3]+" "+getitemname(.@item[3])+"^000000。";
			}
			else if (DANC_Q == 3) {
				mes "^CD6889"+.@count[0]+" "+getitemname(.@item[0])+"^000000 和";
				mes "^CD6889"+.@count[1]+" "+getitemname(.@item[1])+"^000000。";
			}
			else {
				mes "^CD6889"+.@count[0]+" "+getitemname(.@item[0])+"^000000,";
				mes "^CD6889"+.@count[1]+" "+getitemname(.@item[1])+"^000000,";
				mes "^CD6889"+.@count[2]+" "+getitemname(.@item[2])+"^000000、";
				mes "^CD6889"+.@count[3]+" "+getitemname(.@item[3])+"^000000 和";
				mes "^CD6889"+.@count[4]+" "+getitemname(.@item[4])+"^000000。";
			}
			close2;
			cutin "",255;
			end;
		}
	}
	else if (DANC_Q == 5) {
		cutin "job_dancer_eir01",2;
		mes "[艾尔]";
		mes "嗯……？";
		mes "你找不到";
		mes "";
		mes "^CD6889比茹^000000？";
		next;
		mes "[艾尔]";
		mes "你得和她谈谈，因为她负责面试。别担心，她应该就在舞蹈学校的某处。";
		close2;
		cutin "",255;
		end;
	}
	else if (DANC_Q > 5) {
		cutin "job_dancer_eir01",2;
		mes "[艾尔]";
		mes "我期待着";
		mes "精彩的演出~";
		mes "";
		close2;
		cutin "",255;
		end;
	}
	else {
		cutin "job_dancer_eir03",2;
		mes "[艾尔]";
		mes "欢——嗯？";
		mes "嘿，这里只允许";
		mes "获准人员";
		mes "进入。";
		next;
		mes "[艾尔]";
		mes "想观看的话请保持安静，不要打扰表演者。这里每个人都在努力练习，想成为优秀的舞者。";
		close2;
		cutin "",255;
		end;
	}
}

job_duncer,95,93,4	script	Bijou#da	101,{
	if (SkillPoint) {
		mes "[比茹]";
		mes "你还有技能点没用完，";
		mes "不能转职。";
		mes "用完剩余技能点后";
		mes "再回来。";
		close;
	}
	if (BaseJob != Job_Archer) {
		if (BaseJob == Job_Bard) {
			mes "[比茹]";
			mes "欢迎~";
			mes "哦，诗人！有新歌要展示吗？我们的舞蹈总是需要音乐伴奏。";
			close;
		}
		else if (BaseJob == Job_Dancer) {
			mes "[比茹]";
			mes "哎呀……！";
			mes "欢迎回来~";
			next;
			mes "[比茹]";
			mes "最近过得";
			mes "怎么样？";
			mes "很多人一定喜欢看";
			mes "你跳舞。你享受";
			mes "聚光灯下的感觉吗？";
			mes "";
			close;
		}
		mes "[比茹]";
		mes "哎呀~";
		mes "你似乎长途跋涉来看我的表演。";
		next;
		mes "[比茹]";
		mes "抱歉，我已经退休了。现在专心训练新舞者。去中央舞台就能看到我的学生们~";
		close;
	}
	else if (DANC_Q < 5) {
		mes "[比茹]";
		mes "哎呀~";
		mes "你也想";
		mes "成为舞者，";
		mes "对吧？";
		next;
		mes "[比茹]";
		mes "我知道你很兴奋，但第一步是填写申请表。去舞台左侧，艾尔会帮助你。";
		close;
	}
	else if (DANC_Q > 4 && DANC_Q < 7) {
		if (DANC_Q == 5) {
			mes "[比茹]";
			mes "哎呀~";
			mes "你也想";
			mes "成为舞者，";
			mes "对吧？";
			next;
			mes "[比茹]";
			mes "天、天哪！";
			mes "看看你肚子上的赘肉！";
			mes "不过不算多，很快就能减掉。尤其是由我负责训练的话~";
			next;
			mes "[比茹]";
			mes "不过……";
			mes "完美身材的标准";
			mes "和我年轻时相比";
			mes "确实变了。总之……";
			mes "";
			next;
			mes "[比茹]";
			mes "让我们开始面试。";
			mes "我只会问几个简单的问题，";
			mes "所以不用担心~";
			mes "";
			mes "";
			next;
			mes "[比茹]";
			mes "好……";
			mes "开始吧。";
			next;
		}
		else {
			mes "[比茹]";
			mes "哦，你回来了~";
			mes "又学习了一些吗？";
			mes "这次试着";
			mes "通过测试，好吗？";
			next;

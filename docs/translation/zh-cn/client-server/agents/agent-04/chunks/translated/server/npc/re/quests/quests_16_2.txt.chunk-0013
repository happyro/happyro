		next;
		cutin "16loo_03.bmp",0;
		mes "[Rookie]";
		mes "很明显。我的家人经营旧货店。你知道，这个地区的铁消耗量很大。有人开玩笑说，他们会趁你闭眼时偷走你的勺子。";
		npctalk "但那只是玩笑。他们其实不会偷任何东西。", "Rookie#16nego02", bc_self;
		sleep2 300;
		npctalk "是的，我知道。", "", bc_self;
		next;
		cutin "16loo_01.bmp",0;
		mes "[Rookie]";
		mes "通常他们使用从矿井挖出的铁。但因为无法满足需求，也会消耗大量废铁。我们家买入铁再转卖。";
		next;
		cutin "16lei_02.bmp",2;
		mes "[Lazy]";
		mes "那你没能帮助他们吗？";
		npctalk "没错。", "Rookie#16nego02", bc_self;
		next;
		cutin "16loo_03.bmp",0;
		mes "[Rookie]";
		mes "我的兄弟们帮助父母。你看，我个子很小，小时候还经常生病。";
		next;
		cutin "16lei_03.bmp",2;
		mes "[Lazy]";
		mes "哦，所以他们把你当成没用的孩子？";
		npctalk "你去过我家？你怎么这么了解？", "Rookie#16nego02", bc_self;
		next;
		cutin "16loo_03.bmp",0;
		mes "[Rookie]";
		mes "我别无选择。";
		next;
		cutin "16lei_03.bmp",2;
		mes "[Lazy]";
		mes "我不同意。每个人都有不同的能力，你一定擅长某件事，只是还没早点发现。总之，后来发生了什么？";
		next;
		cutin "16loo_01.bmp",0;
		mes "[Rookie]";
		mes "家人忽视我，所以我决定离开家，寻找自己能做的事。";
		next;
		cutin "16lei_01.bmp",2;
		mes "[Lazy]";
		mes "做得好。如果你留在那里，可能就会变成一个没用的人。";
		npctalk "你真聪明又睿智。", "", bc_self;
		next;
		cutin "16loo_03.bmp",0;
		mes "[Rookie]";
		mes "后来我遇到了 Gonie，来到了这里。但我发现自己在这里也无事可做。";
		npctalk "Gonie？就是那个浑身是血的人？", "", bc_self;
		next;
		cutin "16lei_02.bmp",2;
		mes "[Lazy]";
		mes "这里的每个人都是怪物。看看 Gonie，他浑身是血，差点死掉，但仍然活着。事实是其他人都非同寻常，而你很普通。";
		next;
		cutin "16loo_01.bmp",0;
		mes "[Rookie]";
		mes "但我达不到这里的要求。每当我拿起枪，眼睛就疼，手也发抖。我无法正确瞄准目标……";
		npctalk "这是缺乏自信。", "", bc_self;
		npctalk "我想是吧。训练时我没有问题。", "Rookie#16nego02", bc_self;
		next;
		cutin "16lei_01.bmp",2;
		mes "[Lazy]";
		mes "所以你负责这里的家务？";
		next;
		cutin "16loo_02.bmp",0;
		mes "[Rookie]";
		mes "不是家务。算是清理工作？";
		next;
		cutin "",255;
		cloakoffnpcself( "Senior#16nego01" );
		cloakoffnpcself( "Senior#16nego02" );
		cloakoffnpcself( "Senior#16nego03" );
		cloakoffnpcself( "Senior#16nego04" );
		mes "[Senior]";
	mes "嘿，Rookie。你为什么把那些混蛋带来？他们到处乱晃，让我们丢脸！Rookie，你是政府的间谍吗？";
		emotion ET_FRET, getnpcid(0, "Senior#16nego01");
		npctalk "They've been everywhere!", "Senior#16nego01", bc_self;
		next;
		mes "[Senior]";
	mes "我们快死的时候政府都无视我们！我们绝不会帮助他们！";
		emotion ET_ANGER, getnpcid(0, "Senior#16nego02");
		npctalk "Over my dead body!", "Senior#16nego02", bc_self;
		next;
		mes "[Senior]";
	mes "你忘了我们为什么躲在这里吗？";
		emotion ET_FRET, getnpcid(0, "Senior#16nego03");
		npctalk "我永远不会忘记那一天！", "Senior#16nego03", bc_self;
		next;

				mes "还要有理解艺术的能力！";
				mes "你应该已经具备全部条件了。";
				next;
				select("那么什么是大师之刷？");
				mes "[Dumk]";
				mes "啊？";
				mes "那是一把掌握黑暗艺术的大师之刷。";
				mes "现在我们正在寻找能够成为影子追踪者的人。";
				next;
				mes "[Dumk]";
				mes "这是一种游戏。";
				mes "如果有人想成为影子追踪者，";
				mes "我们就会启动寻找这把刷子的流程。";
				next;
				mes "[Dumk]";
				mes "我们设置了这些代码，确保你能跳出框架思考。";
				mes "玩得开心吗？";
				close;
			case 2:
				mes "[Dumk]";
				mes "你决定了！";
				mes "就你而言，你可以掌握用颜料进行心理战的艺术！";
				mes "创造出的艺术既美丽又危险。";
				next;
				mes "[Dumk]";
				mes "我们用颜料作为法术媒介。";
				mes "我们利用它驾驭人们不同的情感，并在他们最脆弱时加以利用。";
				next;
				mes "[Dumk]";
				mes "例如，这种力量可以制造黑洞，让敌人消失。";
				next;
				mes "[Dumk]";
				mes "所以如果你想拥有这种力量，就必须具备艺术才能。";
				next;
				mes "[Dumk]";
				mes "在时尚方面你必须成为潮流引领者！";
				mes "还要有理解艺术的能力！";
				mes "你应该已经具备全部条件了。";
				next;
				mes "[Dumk]";
				mes "你认真完成了任务并找到了刷子。";
				mes "所以你有资格成为影子追踪者。";
				next;
				mes "[Dumk]";
				mes "恭喜。";
				mes "欢迎来到你的新生活。";
				jobchange roclass(eaclass()|EAJL_THIRD);
				getitem 6121,1; //Makeover_Brush
				getitem 6122,1; //Paint_Brush
				set job_sha,32;
				getitem 2795,1; //Green_Apple_Ring
				getitem 5750,1; //Shadow_Handicraft
				next;
				mes "[Dumk]";
				mes "这是时尚的制服。";
				mes "它采用豹纹和羽毛的图案。";
				mes "时尚界会震惊。";
				next;
				mes "[Dumk]";
				mes "这只暗影孔雀是我亲自设计的。";
				mes "要制作能体现我艺术感的东西实在太难了。";
				mes "至于这一部分……";
				next;
				mes "Dumk 一直谈论时尚、艺术感、颜料和感觉。";
				mes "他显然沉浸在自己的世界里。";
				next;
				select("关于这把刷子……");
				mes "[Vicente]";
				mes "啊，我来解释。";
				mes "我们需要绘画工具。";
				next;
				mes "[Vicente]";
				mes "化妆刷用于脸部绘画。";
				mes "你可以从工作场所取得颜料。";
				next;
				mes "[Vicente]";
				mes "画笔用于绘制大面积。";
				mes "画笔也可以从工作场所取得。";
				next;
				mes "[Vicente]";
				mes "你不记得工作场所的位置吗？";
				mes "朱诺、普隆德拉、拉赫和莱茵哈特。";
				next;
				mes "[Vicente]";
				mes "需要颜料就去找助手。";
				mes "^4d4dff如果你没有工具，可以使用技能所需的颜料。^000000";
				next;
				mes "[Vicente]";
				mes "恭喜你成为我们的一员。";
				close;
			case 3:
				mes "[Dumk]";
				mes "什么？";
				mes "为什么不呢？";
				mes "你不想成为影子追踪者吗？";
				mes "我可以教你很多绘画知识。";
				next;
				mes "[Dumk]";

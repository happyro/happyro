				next;
				mes "[Dumk]";
				mes "我们利用它驾驭人们不同的情感，并在他们最脆弱时加以利用。";
				next;
				mes "[Dumk]";
				mes "对敌人的效果类似魔法。";
				next;
				mes "[Dumk]";

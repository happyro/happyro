tur_dun03,38,209,1	script	Blue Flame#sc_f01	802,{
	if (job_sha == 5) {
		mes "蓝色火焰正在轰鸣。";
		mes "解读出的代码意味着……";
		next;
		input .@inputstr$;
		set .@dap01$, "blue fire in turtle island third floor";
		set .@dap02$, "BLUE FIRE IN TURTLE ISLAND THIRD FLOOR";
		if (.@inputstr$ != .@dap01$ && .@inputstr$ != .@dap02$) {
			mes "["+strcharinfo(0)+"]";
			mes "刚才是什么？";
			mes "看来我得确保不使用大写字母。";
			close;
		}
		mes "["+strcharinfo(0)+"]";
		mes "^4d4dff"+.@inputstr$+"^000000";
		mes "它显然指向这里。";
		next;
		mes "火焰开始变大时，你只需低声说出这句话。";
		next;
		mes "[Unknown voice]";
		mes "嗯？有人来了吗？";
		mes "你就是想要我的宝藏的人？";
		mes "但你的限制已经解除了。";
		next;
		mes "火焰正在说话。";
		mes "那声音像蛇一样。";
		mes "蓝色火焰中间有两只大理石般的眼睛。";
		next;
		select("捡起来。");
		mes "[Unknown voice]";
		mes "你很着急。";
		mes "哈哈哈，人类通常就是这样。";
		mes "他们看不见真相。";
		next;
		mes "[Unknown voice]";
		mes "你呢？";
		mes "我不认为你会伤害这团蓝色火焰。";
		mes "它是唯一拥有两只……的火焰。";
		next;
		select("你是谁？");
		mes "[欺骗之影]";
		mes "我？我是欺骗。";
		mes "我嘲笑愚蠢的人。";
		mes "我在他们背后大笑。";
		mes "哈哈哈哈……";
		next;
		mes "蓝色火焰正在变大并翻滚。";
		mes "它们似乎有关联。";
		set job_sha,6;
		setquest 7164;
		if (checkquest(7161) >= 0) erasequest 7161;
		if (checkquest(7162) >= 0) erasequest 7162;
		if (checkquest(7163) >= 0) erasequest 7163;
		close;
	} else if (job_sha == 6) {
		if (checkquest(7164,HUNTING) == 2) {
			mes "蓝色火焰似乎受到了限制。";
			mes "你感觉不到之前那种法术翻滚的效果了。";
			next;
			select("捡起弹珠。");
			mes "捡起它们后，你感觉身体变轻了。";
			set job_sha,7;
			erasequest 7164;
			close2;
			warp "job3_sha01",22,82;
			end;
		}
		mes "火焰仍在强大的法术作用下翻滚。";
		mes "你必须切断与它的联系。";
		close;
	} else if (job_sha == 7) {
		mes "蓝色火焰似乎受到了限制。";
		mes "你感觉不到之前那种法术翻滚的效果了。";
		next;
		select("捡起弹珠。");
		mes "捡起它后，你感觉身体变轻了。";
		close2;
		warp "job3_sha01",22,82;
		end;
	}
	mes "火焰正在翻滚。";
	close;
}

ice_dun02,206,223,1	script	Red Flame#sc_f02	802,{
	if (job_sha < 11) {
		mes "未知的红色火焰正在轰鸣。";
		close;
	} else if (job_sha > 10 && job_sha < 14) {
		mes "红色火焰正在轰鸣。";
		mes "它变成了一个黑衣女人。";
		next;
		mes "[Woman in black]";
		mes "你能听见我吗？";
		mes "呼呼。";
		mes "你能看见我吗？";
		next;
		mes "[Woman in black]";
		mes "你就是被选中的人？";
		mes "你会知道的。";
		mes "有一个灵魂和我相同。";
		next;
		mes "[Woman in black]";
		mes "我是影子。";
		mes "一个流浪的影子。";
		mes "悲伤的灵魂。";
		mes "没有真相的幻影。";
		next;
		mes "[幻象之影]";
		mes "你想要什么？";
		mes "想要宝藏吗？";
		mes "那就把它捡起来。";
		mes "撕裂我的灵魂，";
		mes "展现真相。";
		set job_sha, job_sha+3;
		setquest 7171;
		close;
	} else if (job_sha == 14 || job_sha == 15 || job_sha == 16) {
		if (checkquest(7171,HUNTING) == 2) {
			mes "你无法从火焰中感受到灵魂。";
			mes "靠近时，由于黑暗你看不清楚。";
			close2;
			warp "job3_sha01",22,33;
			end;
		}
		mes "[幻象之影]";
		mes "呼呼。";
		mes "怎么了？";
		mes "你没找到我灵魂的一半？";
		mes "呼呼……";
		next;
		mes "[幻象之影]";
		mes "啊，快点让我安息吧。";
		mes "我想安静地死去。";
		mes "我想放弃虚假的生活。";
		next;
		mes "[幻象之影]";
		mes "呼呼……";
		mes "虚假的影子消失后，你就能看见真相。";
		mes "请撕碎虚假，让盲目者看见光芒……";
		mes "不留任何痕迹……";
		close;
	}
	mes "火焰正在翻滚。";
	mes "冰之光让你看不清楚。";
	close;
}

niflheim,230,276,1	script	Red Flame#sc_f03	802,{
	if (job_sha < 21) {
		mes "那是神秘的火焰。";
		mes "看起来像诅咒。";
		mes "离它远点。";
		close;
	}
	else if (job_sha == 21) {
		mes "["+strcharinfo(0)+"]";
		mes "Haled 告诉我的诗指向尼弗海姆。";
		mes "那里有一团看起来像乌龟岛和冰洞火焰的火焰。";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "生命之树根部的尽头。";
		mes "所有生灵的眼泪。";
		mes "所有死者的印记。";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "他们是我们，却又不是我们。";
		next;
		mes "[Someone's voice]";
		mes "他们是我们，却又不是我们。";
		next;
		mes "[Someone's voice]";
		mes "被遗忘的黑夜居民……";
		next;
		select("是谁在演奏？");
		mes "[Someone's voice]";
		mes "是谁在演奏绝望的华尔兹？";
		mes ".....";
		next;
		mes "[Someone's voice]";
		mes "哈……";
		mes "你来到这里挖掘死亡的秘密。";
		mes "你能为我演奏死亡的华尔兹吗？";
		next;
		mes "[Someone's voice]";
		mes "我不想受到束缚，";
		mes "也不想带着死者的印记。";
		next;
		mes "[愉悦之影]";
		mes "我是影子。";
		mes "我展现世间最极致的快乐。";
		mes "让你不愿从梦中醒来的幻象。";
		next;
		mes "[愉悦之影]";
		mes "灵魂被冰冷的锁链缠住，";
		mes "我无法看见梦境，";
		mes "影子失去了本应永恒的快乐。";
		next;
		mes "[愉悦之影]";
		mes "请帮帮我。";
		mes "给我一双手，";
		mes "让我逃离这里！";
		next;
		mes "[愉悦之影]";
		mes "你能用双手扼杀我吗？";
		mes "我的感官另一端";
		mes "正喘息着寻求空气。";
		next;
		mes "[愉悦之影]";
		mes "那是我活着的证据。";
		mes "那是我跨过界线的证据。";
		mes "伴随生命的开始，";
		mes "也是最后的快乐。";
		next;
		mes "[愉悦之影]";
		mes "让我看看";
		mes "甜美的死亡。";
		next;
		mes "火焰正在熄灭。";
		mes "你应该处理快乐之影。";
		set job_sha,22;
		erasequest 7174;
		setquest 7175;
		close;
	} else if (job_sha == 22) {
		if (checkquest(7175,HUNTING) == 2) {
			mes "你无法从火焰中感受到灵魂。";
			mes "靠近时，由于黑暗你看不清楚。";
			set job_sha,23;
			erasequest 7175;
			close2;
			warp "job3_sha01",73,87;
			end;
		}
		mes "你能感受到火焰中强大的灵魂。";
		mes "你应该处理快乐之影。";
		close;
	} else if (job_sha == 23 || job_sha == 24) {
		mes "你无法从火焰中感受到灵魂。";
		mes "靠近时，由于黑暗你看不清楚。";
		close2;
		warp "job3_sha01",73,87;
		end;
	}
	mes "那里有一团火焰。";
	mes "你什么也感觉不到。";
	close;
}


			getitem 6266,1; //Cheat_Key
			setquest 7165;
			close;
		}
		mes "- 你输入了答案，-";
		mes "- 但没有效果。-";
		mes "- 你失败了。-";
		close;
	}
	mes "你不必留在这里。";
	next;
	if(select("出去。:留在这里。") == 1)
		warp "tur_dun03",40,201;
	close;
}


			mes "你现在携带的物品太多。";
			mes "请使用卡普拉服务存放物品后再回来。^000000";
			close;
		}
	if (countitem(1097) > 0) {
	mes "[Oholy]";
		mes "天哪！你把书带回来了！";
		mes "魔鬼没有为难你吧？";
		mes "很高兴你平安回来。";
		next;
		mes "[Oholy]";
		mes "作为回报，我要唱一首书中的颂歌。";

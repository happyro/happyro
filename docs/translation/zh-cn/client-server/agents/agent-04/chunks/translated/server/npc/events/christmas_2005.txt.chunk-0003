			set christ_carol05,1;
			close;
			case 4:
			mes "[Oholy]";
			mes "圣诞帽！！";
			mes "你知道真正的圣诞帽";
			mes "和魔物戴的完全不同吗？！";
			mes "听说鲁蒂有位匿名设计师制作了所有圣诞帽。";
			next;
			mes "[Oholy]";
			mes "还有关于假圣诞老人 Antonio 的传闻。";
		mes "许多冒险者追捕过他，但他凭圣诞装束从未被抓住。";
			next;
			mes "[Oholy]";
			mes "也许他的帽子和衣服有特殊功能……";
			mes "也许那位匿名设计师还住在鲁蒂。";
			mes "你不如去拜访他，请他制作一顶新圣诞帽？";
			next;
			mes "[Oholy]";
			mes "这是 Oholy 的最新头条。";
			mes "是不是很惊人？";
			emotion ET_SMILE;
			close;
			case 5:
			mes "[Oholy]";
			mes "哎呀，我也在想同样的事……哦，呵呵呵。";
			mes "算了，不只是我，很多人今年圣诞节都这么想。";
			next;
			mes "[Oholy]";
			mes "我听到一个奇怪传闻，";
			mes "那些人正在今年圣诞节策划什么。";

		// Deviruchi functions
		function	script	F_carol_devi	{
		if (christ_carol05 == 1) {
		mes "[Deviruchi]";
		mes "嘿嘿，人类！！";
		mes "不想出卖灵魂，和我签订有利契约吗？";
		emotion ET_CHUP;
		next;
		mes "["+ strcharinfo(0) +"]";
		mes "喂，你！小恶魔！！！";
		mes "真是个淘气鬼！！！抓到你了！";
		next;
		mes "-你迅速抓住了-";
		mes "-小恶魔的后颈-";
		next;
			switch(rand(1,4)) {
			case 1:
			mes "[Deviruchi]";
			mes "你在做什么！？";
			mes "人类？";
			mes "现在就放开我……！";
			emotion ET_HUK;
			emotion ET_HUK, playerattached();
			next;
			mes "-小恶魔迅速逃走了-";
			mes "-^4d4dff小恶魔离开后，-";
			mes "-那里留下了一张破旧的纸。^000000-";
			mes "-读读这张纸吧。-";
			enablenpc getarg(1);
			disablenpc getarg(0);
			next;
			mes "["+ strcharinfo(0) +"]";
			mes "鲁道夫……如果……雾……";
			mes "雪橇……驯鹿……";
			mes "嗯，我想我知道需要什么了。";
			mes "回去找 Oholy 女士吧。";
			set christ_carol05,2;
		getitem 1097,1; //Worn_Out_Page
			close;
			case 2:
			mes "[Deviruchi]";
			mes "你在做什么！？";
			mes "人类？";
			mes "现在就放开我……！";
			emotion ET_HUK;
			emotion ET_HUK, playerattached();
			next;
			mes "-小恶魔迅速逃走了-";
			mes "-并喃喃说了些什么。-";
			enablenpc getarg(1);
			disablenpc getarg(0);
			next;
			mes "-你现在被诅咒了！！！-";
			sc_start SC_Curse,5000,0;
		emotion ET_HUK, playerattached();
			close;
			case 3:
			mes "[Deviruchi]";
			mes "你在做什么！？";
			mes "人类？";
			mes "现在就放开我……！";
			emotion ET_HUK;
			emotion ET_HUK, playerattached();
			next;
			mes "-小恶魔迅速逃走了-";
			mes "-并喃喃说了些什么。-";
			enablenpc getarg(1);
			disablenpc getarg(0);
			next;
			mes "-你现在失明了！！！-";
			sc_start SC_Blind,5000,0;
		emotion ET_HUK, playerattached();
			close;
			case 4:
			mes "[Deviruchi]";
			mes "你在做什么！？";
			mes "人类？";
			mes "现在就放开我……！";
			emotion ET_HUK;
			emotion ET_HUK, playerattached();
			next;
			mes "-小恶魔迅速逃走了-";
			mes "-并喃喃说了些什么。-";
			enablenpc getarg(1);
			disablenpc getarg(0);
			next;
			mes "-你现在中毒了！！！-";
			sc_start SC_Poison,5000,0;
		emotion ET_HUK, playerattached();
	close;
	}
		}
		else {
		mes "[Deviruchi]";
		mes "嘿嘿，人类！！";
		mes "不想出卖灵魂，和我签订有利契约吗？";
		emotion ET_HUK;
		next;
		mes "["+ strcharinfo(0) +"]";
		mes "喂，你！小恶魔！！！";
		mes "真是个淘气鬼！！！抓到你了！";
		next;
		mes "-你迅速抓住了-";
		mes "-小恶魔的后颈-";
		next;
		mes "[Deviruchi]";
		mes "你在做什么！？";
		mes "人类？";
		mes "现在就放开我……！";
		emotion ET_HUK;
		emotion ET_HUK, playerattached();
		next;
		mes "-小恶魔迅速逃走了-";
		mes "-并喃喃说了些什么。-";
		mes "-你的身体突然漂浮起来。-";
		close2;
		warp getarg(2),getarg(3),getarg(4);
	end;
}
}

	function	script	F_carol_devi2	{
	mes "[Deviruchi]";
	mes "嘿嘿，人类！！";
	mes "不想出卖灵魂，和我签订有利契约吗？";

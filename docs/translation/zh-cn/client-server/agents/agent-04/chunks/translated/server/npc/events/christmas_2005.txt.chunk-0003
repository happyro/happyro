			mes "所以我决定通过唱圣诞颂歌、挨家挨户给孩子送礼物，";
			mes "祝大家圣诞快乐，但不幸的是，";
			mes "邪恶的魔鬼撕走了我的颂歌书！！！";
			next;
			mes "[Oholy]";
			mes "我还有很多房子要拜访。";
			mes "没听到颂歌的孩子们很失望，我感到很难过。";
			next;
			menu "……我能帮你吗？",-;
			mes "[Oholy]";
			mes "天哪！你是认真的吗？";
			mes "哦？嘘……你能听见吗？";
			mes "每个孩子都会感激你的善意。";
			emotion ET_SMILE;
			mes "别害怕。我不会要求你创作新的圣诞颂歌。";
			next;
			mes "[Oholy]";
			mes "如果你愿意，我们没有时间浪费。";
			mes "让我们继续前进，给孩子们带去希望！";
			next;
			mes "[Oholy]";
			mes "请把圣诞颂歌书带回来，"+strcharinfo(0)+"。";
			mes "那个小魔鬼应该还在城里，毕竟事情才发生几分钟。";
			next;
			mes "[Oholy]";
			mes "请小心，因为你要对付魔鬼。";
			mes "祝你好运！！！";
			mes " ";

einbech,217,82,3	script	Lazy#16nego03	4_M_LAZY,{
	if (terra_gloria_main == 13) {
		cutin "16lei_01.bmp",2;
		mes "[懒猫]";
		mes "你现在到了吗？";
		npctalk "你比我想象的慢。", "", bc_self;
		unittalk getcharid(3), "" + strcharinfo(0) + "：嘿！我一直在抬着一个昏迷的人！", bc_self;
		next;
		mes "[懒猫]";
		mes "放下你带来的东西。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "啊……";
		cloakoffnpcself( "Gonie#16nego02" );
		unittalk getcharid(3), "" + strcharinfo(0) + "：哦，我现在感觉活过来了。", bc_self;
		npctalk "你把疼痛夸大了。", "", bc_self;
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "我在哪里？这里没人。";
		next;
		cutin "16lei_02.bmp",2;
		mes "[懒猫]";
		mes "你知道多少就能看到多少。所以我总是很累。所有人都想让我看他们。";
		npctalk "我之后会看的。", "", bc_self;
		next;
		cutin "16lei_01.bmp",2;
		mes "[懒猫]";
		mes "总之，我们进去。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "那么，我在哪里？";
		next;
		cutin "16lei_03.bmp",2;
		mes "[懒猫]";
		mes "你话太多了！我说过我们没多少时间。之后再听我的解释。站在这里前面的人已经察觉到我并进去了。我们不知道他们会准备什么。";
		unittalk getcharid(3), "" + strcharinfo(0) + "：你真是个喜欢事后解释的人！", bc_self;
		next;
		emotion ET_SWEAT, playerattached();
		mes "[" + strcharinfo(0) + "]";
		mes "等等，我们要把他留在这里？";
		next;
		cutin "16lei_02.bmp",2;
		mes "[懒猫]";
		mes "是。有问题吗？这会有问题吗？";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "你说我们应该带伤员来这里。然后又让我一路把他搬来。现在你要把他丢在这里？";
		unittalk getcharid(3), "" + strcharinfo(0) + "：我可是一路把他抬到这里来的。不是吗？", bc_self;
		sleep2 300;
		npctalk "你想说什么都行。我不怕你。", "", bc_self;
		next;
		cutin "16lei_03.bmp",2;
		mes "[懒猫]";
		mes "别担心他。他不会死。人类没那么容易死。我还活着就是证据。";
		unittalk getcharid(3), "" + strcharinfo(0) + "：那算什么样的人生……？", bc_self;
		next;
		emotion ET_SWEAT, playerattached();
		mes "[" + strcharinfo(0) + "]";
		mes "问题不在这里。";
		next;
		cutin "16lei_01.bmp",2;
		mes "[懒猫]";
		mes "来，进去。我们没多少时间。我们进去说。你不好奇里面有什么吗？";
		npctalk "我好奇！我好奇！我想知道！", "", bc_self;
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "我们得看到某些东西才能进去。";
		next;
		cutin "16lei_01.bmp",2;
		mes "[懒猫]";
		mes "看这里。这里有入口。这是^0000cd隐藏在海滩墙壁中的入口^000000。很可疑。我们进去看看里面有什么。";
		erasequest 14597;// Corner of Einbech
		setquest 14598;// Invisible entrance
		terra_gloria_main = 14;
		close2;
		cloakonnpcself( "Lazy#16nego03" );
		cutin "",255;
		end;
	}
	if (terra_gloria_main == 14) {
		cutin "16lei_01.bmp",2;
		mes "[懒猫]";
		mes "你在做什么？进来！";
		close2;
		cutin "",255;
		cloakonnpcself( "Lazy#16nego03" );
		end;
	}
	end;
OnInit:
	cloakonnpc();
	end;
}


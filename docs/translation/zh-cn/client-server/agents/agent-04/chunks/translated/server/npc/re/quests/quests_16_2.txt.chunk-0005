rebel_in,21,45,5	script	Lazy#16nego04	4_M_LAZY,{
	if (terra_gloria_main == 14) {
		cutin "16lei_02.bmp",2;
		mes "[懒猫]";
		mes "哎哟！店里看起来比外面小。柱子后面有空间吗？";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "这是枪械店吗？";
		unittalk getcharid(3), "" + strcharinfo(0) + "：我们为什么在枪械店里……？我已经有武器了。", bc_self;
		next;
		mes "[店主]";
		mes "真正的客人？";
		emotion ET_HUK, getnpcid(0, "Eri#16nego01");
		npctalk "我说过会有客人来的。", "Nemi#16nego01", bc_self;
		sleep2 300;
		npctalk "我还以为只是有人停下来问路。", "Eri#16nego01", bc_self;
		next;
		cutin "",255;
		mes "[店主]";
		mes "欢迎。这是^0000cd克拉纳·内米耶里^000000，我们经营各种枪械。";
		next;
		mes "[店主]";
		mes "四处看看，告诉我有没有你要找的东西。";
		npctalk "我们不是得叫里面的人吗？", "Nemi#16nego01", bc_self;
		sleep2 300;
		npctalk "Calm down. Be cool.", "Eri#16nego01", bc_self;
		next;
		cutin "16lei_01.bmp",2;
		mes "[懒猫]";
		mes "是啊……希望我们有你要找的东西。";
		next;
		mes "[店主]";
		mes "顺便问一下……你怎么找到我们的？这是一家只有少数人光顾的小店。";
		npctalk "你在说什么？", "Eri#16nego01", bc_self;
		next;
		mes "[懒猫]";
		mes "我想买一把自卫枪。有人向我推荐了这家店。";
		next;
		emotion ET_SWEAT, getnpcid(0, "Nemi#16nego01");
		mes "[店主]";
		mes "是谁……？";
		next;
		cutin "16lei_02.bmp",2;
		mes "[懒猫]";
		mes "如果我告诉你那个人是谁，你会怎么办？";
		next;
		cutin "16lei_01.bmp",2;
		mes "[懒猫]";
		mes "哇，这看起来很酷。这是握法吗？";
		next;
		mes "[店主]";
		mes "先生，那东西很精密，不该随便触碰。";
		npctalk "请把手从那里移开。", "Eri#16nego01", bc_self;
		next;
		cutin "16lei_03.bmp",2;
		mes "[懒猫]";
		mes "不是你让我随便看吗？这也太小了！真的能发射子弹？看看这里的灰尘，你们大概做不下去了。";
		next;
		mes "[店主]";
		mes "哦……那可是本店最畅销的产品之一。";
		emotion ET_ANGER, getnpcid(0, "Nemi#16nego01");
		next;
		cutin "16lei_02.bmp",2;
		mes "[懒猫]";
		mes "这是畅销品？我可以想象这家店的质量了。";
		next;
		mes "[店主]";
		mes "你说什么？现在是在侮辱我的枪吗？";
		npctalk "我再也不拿了！别烦我！", "Nemi#16nego01", bc_self;
		emotion ET_ANGER, getnpcid(0, "Nemi#16nego01");
		next;
		mes "[懒猫]";
		mes "不，我不是那个意思。不过你要这么理解，那就是侮辱。";
		next;
		mes "[店主]";
		mes "冷静，内米。他是客人。";
		npctalk "Sir.", "Eri#16nego01", bc_self;
		next;
		cutin "16lei_01.bmp",2;
		mes "[懒猫]";
		mes "嗯……这个看起来不错。多少钱？";
		next;
		mes "[店主]";
		mes "340 万 Zeny。";
		next;
		cutin "16lei_03.bmp",2;
		mes "[懒猫]";
		mes "这点钱只够买零食。给我一把。";
		unittalk getcharid(3), "" + strcharinfo(0) + "：什么零食会这么贵？", bc_self;
		next;
		mes "[店主]";
		mes "这是展示品，我们需要下单。订单太多，你得等八个月。能等吗？";
		next;
		cutin "16lei_02.bmp",2;
		mes "[懒猫]";
		mes "脾气急的不是我，我看是你。";
		npctalk "我可以等八个月。", "", bc_self;
		sleep2 300;
		unittalk getcharid(3), "" + strcharinfo(0) + "：你是在进行心理战吗？", bc_self;
		next;
		emotion ET_ANGER, getnpcid(0, "Nemi#16nego01");
		mes "[店主]";
		mes "冷静，内米。";
		next;
		cutin "16lei_03.bmp",2;
		mes "[懒猫]";
		mes "别看这些，给我看看你们真正卖的东西。比如^0000cd穿风的快速研磨机^000000？";
		unittalk getcharid(3), "" + strcharinfo(0) + "：Grinder 是子弹的名字吗？", bc_self;
		next;
		mes "[店主]";
		mes "嘿，你到底是谁？";
		npctalk "我一眼就认出来了！", "Nemi#16nego01", bc_self;
		sleep2 300;
		npctalk "Calm down! We shouldn't look suspicious!", "Eri#16nego01", bc_self;
		sleep2 500;
		unittalk getcharid(3), "" + strcharinfo(0) + "：看你的反应，它不像是子弹的名字。", bc_self;
		next;
		cutin "16lei_01.bmp",2;
		mes "[懒猫]";
		mes "看不出来吗？我是游客，这是我的秘书。";
		next;
		emotion ET_SWEAT, playerattached();
		mes "[" + strcharinfo(0) + "]";
		mes "秘书，秘书……？";
		unittalk getcharid(3), "" + strcharinfo(0) + "：我是你的秘书吗……！！？", bc_self;
		sleep2 300;
		npctalk "如果你不喜欢那个词，叫奴隶怎么样？", "", bc_self;
		sleep2 500;
		unittalk getcharid(3), "" + strcharinfo(0) + "：嘿，你太过分了！", bc_self;
		next;
		mes "[店主]";
		mes "哪个游客会特意来到什么都没有的矿村武器店？你从哪里来？";
		next;
		mes "[懒猫]";
		mes "我刚从朱诺来。那里真是太~棒了。";
		next;
		mes "[店主]";
		mes "回去吧。我们没有你想要的东西。";
		npctalk "就算我们有，也不会卖给你。", "Nemi#16nego01", bc_self;
		next;
		cutin "16lei_02.bmp",2;
		mes "[懒猫]";
		mes "你要赶我们走？内米耶里先生，不能这样。";
		emotion ET_HNG;
		next;
		mes "[店主]";
		mes "我为什么不能赶你走？在我叫人之前滚开。";
		next;
		cutin "16lei_03.bmp",2;
		mes "[懒猫]";
		mes "你最好看看外面是谁。他的名字是……^0000cd戈尼^000000，对吧？";
		unittalk getcharid(3), "" + strcharinfo(0) + " : Who?", bc_self;
		next;
		mes "[店主]";
		mes "你在说什么？";
		emotion ET_QUESTION, getnpcid(0, "Nemi#16nego01");
		next;
		mes "[懒猫]";
		mes "出去自己看看。";
		next;
		mes "[店主]";
		mes "如果你耍这种拙劣的把戏，我不会容忍你。";
		cloakonnpcself( "Nemi#16nego01" );
		next;
		cutin "16lei_02.bmp",2;
		mes "[懒猫]";
		mes "他一个人能把他搬走吗？";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "倒下的那个人是这里的吗？";
		unittalk getcharid(3), "" + strcharinfo(0) + "：你怎么知道他的名字？", bc_self;
		next;
		cutin "16lei_01.bmp",2;
		mes "[懒猫]";
		mes "你不知道吗？所以我们才费力把他搬到这里。看吧，他很快就会使用魔法。";
		unittalk getcharid(3), "" + strcharinfo(0) + "：他是魔法师吗？", bc_self;
		sleep2 300;
		npctalk "原来你……不，没什么。", "", bc_self;
		sleep2 500;
		unittalk getcharid(3), "" + strcharinfo(0) + "：什么！怎么了？为什么不说了？", bc_self;
		next;
		cloakoffnpcself( "Nemi#16nego01" );
		cloakoffnpcself( "Gonie#16nego03" );
		mes "[店主]";
		mes "啊……";
		next;
		emotion ET_HUK, getnpcid(0, "Eri#16nego01");
		mes "[店主]";
		mes "天啊。戈尼！发生了什么！";
		next;
		mes "[店主]";
		mes "艾莉，去把^0000cd拉奇^000000带来。";
		next;
		cutin "16lei_03.bmp",2;
		mes "[懒猫]";
		mes "拉奇？";
		emotion ET_QUESTION;
		next;
		cloakonnpcself( "Eri#16nego01" );
		mes "[店主]";
		mes "嘿，你对这家伙做了什么？";
		next;
		cutin "16lei_03.bmp",2;
		mes "[懒猫]";
		mes "我们确实做了点事。他差点死了，我们让他活着并一路带到这里。干得不错吧。";
		next;
		mes "[店主]";
		mes "你不是为了把他当人质才伤害他的吗？";
		unittalk getcharid(3), "" + strcharinfo(0) + "：你把我当成什么样的恶棍了！", bc_self;
		sleep2 300;
		npctalk "冒险者，冷静。让我来处理。保存你的体力。", "", bc_self;
		next;
		cutin "16lei_02.bmp",2;
		mes "[懒猫]";
		mes "我为什么要把抓来的人质交给你？如果你真的不知道发生了什么，就叫醒他问问。如果我们没伤害他，你会怎么办？";
		next;
		mes "[懒猫]";
		mes "你会感到尴尬、抱歉又羞愧。你还抬得起头吗？";
		next;
		cutin "16lei_03.bmp",2;
		emotion ET_STARE;
		mes "[懒猫]";
		mes "你为什么这么怀疑我们？够了。没多少恶棍会拿伤员来骗人。";

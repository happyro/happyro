		next;
		emotion ET_CRY;
		specialeffect EF_DEVOTION, AREA, "Lazy#16nego02";
		sleep2 800;
		specialeffect EF_RESURRECTION, AREA, "Collapsed person#16nego";
		sleep2 1000;
		specialeffect EF_REVIVE, AREA, "Collapsed person#16nego";
		sleep2 1000;
		specialeffect EF_HO_UP, AREA, "Collapsed person#16nego";
		mes "[" + strcharinfo(0) + "]";
		mes "哇……你是秘密特工，还会治疗？";
		unittalk getcharid(3), "" + strcharinfo(0) + "：你现在看起来不一样了。", bc_self;
		next;
		cutin "16lei_01.bmp",2;
		mes "[懒猫]";
		mes "哦，经历这么多事后，你应该什么都会。";
		next;
		cutin "16lei_02.bmp",2;
		mes "[懒猫]";
		mes "我擅长各种技艺和手工。我真是个伟大的人。";
		npctalk "我真可爱～", "", bc_self;
		emotion ET_CHUP;
		specialeffect EF_HEARTCASTING, AREA, "Lazy#16nego02";
		next;
		cutin "16lei_01.bmp",2;
		mes "[懒猫]";
		mes "他不会马上醒来，但至少能保住性命。如果我们晚来一步，他就死定了。";
		next;
		cutin "16lei_03.bmp",2;
		mes "[懒猫]";
		mes "你在做什么？抬着他。";
		unittalk getcharid(3), "" + strcharinfo(0) + "：我该这么做吗？", bc_self;
		sleep2 500;
		npctalk "那我来？既然你是能在包里装三万种物品的冒险者，就该由你抬着他。", "", bc_self;
		sleep2 500;
		unittalk getcharid(3), "" + strcharinfo(0) + "：你从哪里听来的谣言……", bc_self;
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "我们要抬着他？我以为我们在执行秘密任务。";
		next;
		cutin "16lei_01.bmp",2;
		mes "[懒猫]";
		mes "我们^0000cd必须带着他^000000。无论发生什么都要带上这个人。他会成为我们进入基地的通行证。";
		unittalk getcharid(3), "" + strcharinfo(0) + "：通行证？", bc_self;
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "这个人是谁？";
		next;
		cutin "16lei_03.bmp",2;
		mes "[懒猫]";
		mes "问得好。但时间不够，之后再解释。我们必须在他死前把他送到。";
		unittalk getcharid(3), "" + strcharinfo(0) + "：所以你只是勉强让他活着？", bc_self;
		erasequest 14596;// Follow the trails
		setquest 14597;// Corner of Einbech
		terra_gloria_main = 13;
		viewpoint 1,217,82,1,0x4D4DFF00;
		close2;
		cutin "",255;
		navigateto( "einbech",217,82,NAV_NONE,1 );
		cloakonnpcself( "Lazy#16nego02" );
		cloakonnpcself( "Collapsed person#16nego" );
		end;
	}
	if (terra_gloria_main == 13) {
		cutin "16lei_01.bmp",2;
		mes "[懒猫]";
		mes "你在做什么？我让你跟着我。";
		close2;
		cutin "",255;
		viewpoint 1,217,82,1,0x4D4DFF00;
		navigateto( "einbech",217,82,NAV_NONE,1 );
		cloakonnpcself( "Lazy#16nego02" );
		cloakonnpcself( "Collapsed person#16nego" );
		end;
	}
	end;

OnInit:
	cloakonnpc "Lazy#16nego02";
	end;
}


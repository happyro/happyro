						mes "[Carocc]";
						mes "如果需要更多地图帮助，请点击这里的<NAVI>[Hun]<INFO>izlude,122,207</INFO></NAVI>";
						mes "是的，就是写着[Hun]的部分。";
						next;
						mes "！- 信息 -！";
						mes "^4d4dff对话中的图标 <NAVI>[Hun]<INFO>izlude,122,207</INFO></NAVI> 表示";
						mes "这是导航路线链接。";
						cutin "navi01.bmp", 4;
						next;
						mes "！- 信息 -！";
						mes "在目标中选择任务后按信息^4d4dff，";
						mes "会出现指向目标位置的箭头和导航帮助。";
						cutin "navi02.bmp", 4;
						next;
						cutin "", 255;
						mes "[Carocc]";
						mes "总之，我的朋友会帮你登记进入学院";
						mes "希望这能帮助你的旅程";
						close;
					}
				} else if (isbegin_quest(7472) == 1) {
					mes "[Carocc]";
					mes "如果你愿意，可以马上踏入世界。";
					mes "不过，我建议你先参观学院。";
					next;
					mes "[Carocc]";
					mes "独自在世界上生活很孤独。";
					mes "学院里有可以成为终身伙伴的人。";
					next;
					mes "[Carocc]";
					mes "我的朋友 Hun 会在学院入口附近。";
					mes "如果你不知道路，我会再指给你。";
					viewpoint 1,122,207,0,0x4d4dff;
					next;
					mes "[Carocc]";
					mes "如果需要更多地图帮助，请点击这里的<NAVI>[Hun]<INFO>izlude,122,207</INFO></NAVI>";
					mes "对，就是写着‘Hun’的那一部分。";
					next;
					mes "！- 信息 -！";
					mes "^4d4dff对话中的图标 <NAVI>[Hun]<INFO>izlude,122,207</INFO></NAVI> 表示";
					mes "这是导航路线链接。";
					cutin "navi01.bmp", 4;
					next;
					mes "！- 信息 -！";
					mes "在目标中选择任务后按信息^4d4dff，";
					mes "会出现指向目标位置的箭头和导航帮助。.";
					cutin "navi02.bmp", 4;
					next;
					cutin "", 255;
					mes "[Carocc]";
					mes "总之，我的朋友会帮你登记进入学院.";
					mes "希望这能帮助你的旅程.";
					close;
				} else {
					mes "[Carocc]";
					mes "哦，" + strcharinfo(0) + "！";
					mes "还在勤奋努力吗？";
					mes "我也一直很忙。";
					mes "我在修理船。";
					next;
					mes "[Carocc]";
					mes "修理完成后我就会出发。";
					mes "到时前往^4d4dff灯塔的航线会开放。";
					mes "期待吧。";
				}
			} else {
				if (!isbegin_quest(7472)) {
					mes "[Carocc]";
					mes "你好？";
					mes "你第一次来依斯鲁得吗？";
					next;
					switch(select("你好？", "让我上船！", "我不知道该做什么。")) {
					case 1:
						mes "[Carocc]";
						mes "你看起来强壮能干！";
						mes "我喜欢你这样能干的人！";
						mes "愿你一直像现在这样健康强壮。";
						break;
					case 2:
						mes "[Carocc]";
						mes "我通常前往^4d4dff灯塔。";
						mes "不过我因为一些问题正在休息。";
						next;
						mes "[Carocc]";
						mes "如果要去阿尔伯特或巴亚兰岛，和下一位水手交谈。";
						break;
					case 3:
						mes "[Carocc]";
						mes "嗯？你说不知道该做什么。";
						mes "既然你在依斯鲁得，为什么不参观^4d4dff克里图拉学院^000000？";
						next;
						mes "[Carocc]";
						mes "依斯鲁得有一所为你这样的新晋冒险者设立的学院。";
						mes "我的朋友在那里工作，我会介绍你认识他。";
						next;
						mes "[Carocc]";
						mes "他通常会在学院入口附近与新冒险者交谈。";
						mes "去亲自见见他。";
						next;
						if (!isbegin_quest(7473)) {
							mes "[Carocc]";
							mes "他的名字是^4d4dffHun^000000";
							mes "我会在地图上标记他的位置，你去见见他吧。";
							setquest 7472;
							viewpoint 1,122,207,0,0x4d4dff;
							next;
							mes "！- 信息 -！";
							mes "^4d4dff 小地图在屏幕右上角。";
							mes "可以用 + 放大、- 缩小。NPC 的路点会标记在上面。^000000";
							next;
							mes "！- 信息 -！";
							mes "从^4d4dff卡洛克船长^000000处接到任务。";
							mes "任务内容可以在任务信息窗口中查看。";
							next;
							mes "！- 信息 -！";
							mes "按^4d4dffAlt + U^000000键打开任务窗口。";
							next;
							mes "[Carocc]";
							mes "如果需要更多地图帮助，请点击这里的<NAVI>[Hun]<INFO>izlude,122,207</INFO></NAVI>";
							mes "是的，就是写着[Hun]的部分。";
							next;
							mes "！- 信息 -！";
					mes "^4d4dff对话中的图标 <NAVI>[Hun]<INFO>izlude,122,207</INFO></NAVI> 表示";
							mes "这是导航路线链接。";
							cutin "navi01.bmp", 4;
							next;
							mes "！- 信息 -！";
							mes "在目标中选择任务后按信息^4d4dff，";
							mes "会出现指向目标位置的箭头和导航帮助。";
							cutin "navi02.bmp", 4;
							next;
							cutin "", 255;
							mes "[Carocc]";
							mes "总之，我的朋友会帮你登记进入学院";
							mes "希望这能帮助你的旅程";
							close;
						} else {
							select("我知道你说的是谁。 ");
							mes "[Carocc]";
							mes "那就不用担心了。";
							mes "他会带你认识学院。";
							next;
							mes "[Carocc]";
							mes "好。我来给你指路。你再试一次。";
							mes "顺便说一句，我告诉过你他的名字吗？他的名字是^4d4dffHun^000000";
							viewpoint 1,122,207,1,0x4d4dff;
							next;
							mes "！- 信息 -！";
							mes "^4d4dff 小地图在屏幕右上角。";
							mes "可以用 + 放大、- 缩小。NPC 的路点会标记在上面。^000000";
							next;
							mes "[Carocc]";
							mes "如果需要更多地图帮助，请点击这里的<NAVI>[Hun]<INFO>izlude,122,207</INFO></NAVI>";
							mes "是的，就是写着[Hun]的部分。";
							next;
							mes "！- 信息 -！";
					mes "^4d4dff对话中的图标 <NAVI>[Hun]<INFO>izlude,122,207</INFO></NAVI> 表示";
							mes "这是导航路线链接。";
							cutin "navi01.bmp", 4;
							next;
							mes "！- 信息 -！";
							mes "在目标中选择任务后按信息^4d4dff，";
							mes "会出现指向目标位置的箭头和导航帮助。";
							cutin "navi02.bmp", 4;
							next;
							cutin "", 255;
							mes "[Carocc]";
							mes "总之，我的朋友会帮你登记进入学院";
							mes "希望这能帮助你的旅程";
							close;
						}
					}
				} else if (isbegin_quest(7472) == 1) {
					mes "[Carocc]";
					mes "啊，是你。";
					mes "这个人也决定在克里图拉学院登记。";
					mes "这对你来说或许是个好缘分。希望你们能成为好朋友。";
					next;
					cutin "nov_lumin01.bmp", 0;
					mes "[Lumin]";
					mes ".........";
					next;
					cutin "", 255;
					mes "[Carocc]";
					mes "如果你愿意，可以马上踏入世界。";
					mes "不过，我建议你先参观学院。";
					next;
					mes "[Carocc]";
					mes "独自在世界上生活很孤独。";
					mes "学院里有可能成为你一生伙伴的人。";
					next;
					mes "[Carocc]";
					mes "我的朋友<NAVI>[Hun]<INFO>izlude,122,207</INFO></NAVI>会在学院入口附近。";
					mes "如果你不知道路，我会再指给你。";
					viewpoint 1,122,207,1,0x4d4dff;
					next;
					mes "[Carocc]";
					mes "那么，祝你好运！";
					close;
				} else {
					mes "[Carocc]";
					mes "哦，我们又见面了。";
					mes "你是不是需要船？";
					mes "我通常会前往帕罗斯港。";
					mes "以后如果要去帕罗斯，就来找我。";
				}
			}
		}
	} else {
		if (isbegin_quest(7471) == 2 || isbegin_quest(7472) > 0) {
			mes "[Carocc]";
			mes "好久不见！";
			mes "看你的表情，应该过得不错。";
			next;
			switch(select("Take me to Pharos Lighthouse", "To Alberta", "Talk")) {
			case 1:
				mes "[Carocc]";
				mes "你要去梦罗克南岸的法罗斯灯塔吗？";
				mes "费用是 2800 Zeny。船员需要报酬，所以费用不能协商。";
				next;
				if (select("前往法罗斯灯塔！", "取消") == 1) {
					if (Zeny > 2799) {
						mes "[Carocc]";
						mes "让我们迎着风扬帆远行。";
						Zeny -= 2800;
						close2;
						warp "cmd_fild07", 92, 129;
						end;
					} else {
						mes "[Carocc]";
						mes "抱歉，你的船费不够。";
						mes "我需要 2800z 才能出航。";
					}
				} else {
					mes "[Carocc]";
					mes "好。";
					mes "顺便问一句，你知道这件事吗？";
					mes "^4d4dffThere's a Rogue hideout at Pharos Lighthouse^000000.";
					mes "你已经知道了吗？";
				}
				break;
			case 2:
				mes "[Carocc]";
				mes "我还以为你知道我只去法罗斯？";
				mes "去问那边的水手，他经常去那里。";
				next;
				mes "[Carocc]";
				mes "还有很多其他船会前往艾尔贝塔和拜亚兰岛。";
				break;
			case 3:
				mes "[Carocc]";
				mes "嗯。看到你和其他从我身边经过的冒险者平安，我就满足了。";
				next;
				mes "[Carocc]";
				mes "Lumin 应该也过得很好。";
				mes "明明只是在海上见过你，我却觉得你像自己的孩子，这是为什么呢？";
				break;
			}
		} else {
			mes "[Carocc]";
			mes "我是 Carocc，这艘船的船长。";
			mes "你需要船吗？";
			next;
			if (select("法罗斯灯塔 - 2800z", "不需要。") == 1) {
				if (Zeny > 2799) {
					mes "[Carocc]";
					mes "让我们迎着风扬帆远行。";
					Zeny -= 2800;
					close2;
					cutin "", 255;
					warp "cmd_fild07", 92, 129;
					end;
				} else {
					mes "[Carocc]";
					mes "抱歉，你的船费不够。";
					mes "我需要 2800z 才能出航。";
				}
			} else {
				mes "[Carocc]";
				mes "那就下次再用吧。";
			}
		}
	}
	close2;
	cutin "", 255;
	end;

OnInit:
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "Class == Job_Novice && BaseLevel <= 14 && !isbegin_quest(7472) && !isbegin_quest(7473)" );
	end;

OnTouch:
	if (Class == Job_Novice && BaseLevel < 15 && !isbegin_quest(4269))
		emotion ET_SURPRISE;
	else
		emotion ET_SMILE;
	end;
}

izlude_a,198,213,3	duplicate(Captain Carocc#iz)	Captain Carocc#iz_a	4_M_REINDEER,5,5
izlude_b,198,213,3	duplicate(Captain Carocc#iz)	Captain Carocc#iz_b	4_M_REINDEER,5,5
izlude_c,198,213,3	duplicate(Captain Carocc#iz)	Captain Carocc#iz_c	4_M_REINDEER,5,5
izlude_d,198,213,3	duplicate(Captain Carocc#iz)	Captain Carocc#iz_d	4_M_REINDEER,5,5

// - Criatura Academy Staff
// - Teaches the player about the Inventory.
// -----------------------------------------------------------------------------
izlude,122,207,3	script	Criatura Academy Staff#0	4_M_KHKYEL,3,3,{
	if (!checkweight(1304,3)) {
		mes "由于背包已满，无法继续任务。";
		mes "整理背包后再继续任务。";
		close;
	}
	viewpoint 2,122,207,1,0xFFFFFF;
	if (Class == Job_Novice && BaseLevel < 15) {
		if (isbegin_quest(7472) == 1) {
			mes "[Hun]";
			mes "哦……你一定就是 Carocc 提到的冒险者。";
			mes "我不知道你的故乡在哪里，但米德加尔特是开始人生旅程的好地方。";
			next;
			mes "[Hun]";
			mes "看到新冒险者踏上旅程真令人高兴。";
			mes "你一定累了。要喝点什么吗？";
			completequest 7472;
			getexp 200,0;
			setquest 7473;
			getitem 531,1;// Apple_Juice
			next;
			mes "[Hun]";
			mes "点击屏幕左上方的‘物品’图标即可打开物品窗口。";
			next;
			mes "[Hun]";
			mes "物品会按照用途自动分为‘消耗品’、‘装备’、‘其他’和‘个人’。";
			mes "系统会根据用途自动分类，";
			next;
			mes "[Hun]";
			mes "你可以^4d4dff双击想使用的物品^000000，";
			mes "也可以将它拖到^4d4dff装备窗口后使用^000000。";
			next;
			cutin "tutorial03.bmp", 4;
			mes "！- 信息 -！";
				mes "^4d4dff双击物品即可使用或装备。";
			mes "可以使用快捷键 Alt+E 打开物品窗口。";
			next;
			mes "！- 信息 -！";
				mes "^4d4dff按 Alt+Q 可以查看已装备的物品。";
			mes "物品也可以拖到你想装备的位置。";
			next;
			cutin "", 255;
			mes "[Hun]";
			mes "要查看单个物品的详细信息，请^4d4dff右键点击^000000该物品。";
			mes "你可以查看物品的详细信息。";
			next;
			cutin "tutorial04.bmp", 4;
			mes "！- 信息 -！";
				mes "^4d4dff右键点击物品图标^4d4dff 会显示物品详细信息。";
			next;
			mes "！- 信息 -！";
				mes "^4d4dff选中其他玩家后，可以在弹出的社交窗口中与他们交易或组队。";
			next;
			cutin "", 255;
			mes "[Hun]";
			mes "现在请^4d4dff喝下我给你的苹果汁^000000。";
			close;
		} else {
			if (!isbegin_quest(7473)) {
				mes "[Hun]";
				mes "嘿，你好。";
				mes "休息一会儿吧。";
				next;
				mes "[Hun]";
				mes "看到新冒险者踏上旅程真令人高兴。";
				mes "休息时想喝点什么吗？";
				setquest 7473;
				getitem 531,1;// Apple_Juice
				next;
				mes "[Hun]";
				mes "右键点击左上角^4d4dff基本物品窗口中的物品图标^000000，即可查看物品详细信息。";
				next;
				mes "[Hun]";
				mes "物品会按照用途自动分为‘消耗品’、‘装备’、‘其他’和‘个人’。";
				mes "系统会根据用途自动分类，";
				next;
				mes "[Hun]";
				mes "你可以^4d4dff双击想使用的物品^000000，";
				mes "也可以将它拖到^4d4dff装备窗口后使用^000000。";
				next;
				mes "[Hun]";
				mes "要查看单个物品的详细信息，请^4d4dff右键点击^000000该物品。";
				mes "你可以查看物品的详细信息。";
				next;
				cutin "tutorial04.bmp", 3;
				mes "！- 信息 -！";
				mes "右键点击物品图标^4d4dff即可查看物品详细信息。";
				next;
				mes "！- 信息 -！";
				mes "选择其他玩家后，^4d4dff可以通过弹出的社交窗口与他们交易或组队。";
				next;
				cutin "", 255;
				mes "[Hun]";
				mes "现在请^4d4dff喝下我给你的苹果汁^000000。";
				close;
			} else if (isbegin_quest(7473) == 1) {
				if (countitem(531) > 0) {
					mes "[Hun]";
					mes "在背包中使用我给你的苹果汁。";
					mes "之后我们再谈。";
					close;
				} else {
					if (isbegin_quest(4269) > 0) {
						mes "[Hun]";
						mes "味道怎么样？";
						mes "酸甜可口，对吧？虽然效果不算强，但也有治疗作用。";
						next;
						mes "[Hun]";
						mes "我想多给你一些，可那已经是最后一瓶了。";
						mes "总之，这里有一些药水。开始战斗后会派上用场。";
						completequest 7473;
						getitem 569,30;// Novice_Potion
						getexp 200,0;
						next;
						mes "[Hun]";
						mes "克里图拉学院是为未来积累经验的好地方。";
						mes "我不是因为在这里工作才这么说。";
						next;
						mes "[Hun]";
						mes "我是认真的……哈哈。";
						close;
					} else {
						mes "[Hun]";
						mes "味道怎么样？";
						mes "酸甜可口，对吧？虽然效果不算强，但也有治疗作用。";
						next;
						mes "[Hun]";
						mes "我想多给你一些，可那已经是最后一瓶了。";
						mes "总之，这里有一些药水。开始战斗后会派上用场。";
						completequest 7473;
						getitem 569,30;// Novice_Potion
						getexp 200,0;
						next;
						mes "[Hun]";
						mes "你接下来打算做什么？";
						mes "找到住的地方了吗？";
						next;
						switch(select("I need help with that", "Anything will do really.", "Don't worry.")) {
						case 1:
							mes "[Hun]";
							mes "不过话说回来。";
							mes "独自在陌生地方生活很辛苦。";
							mes "所以才有克里图拉学院。";
							next;
							mes "[Hun]";
							mes "Carocc 大概也是因为同样的原因把你介绍给我。";
							mes "虽然我只是这里的工作人员，但可以带你参观。";
							next;
							mes "[Hun]";
							mes "沿着这条路向北走，你就能看到";
					mes "<NAVI>[学院建筑]<INFO>iz_ac01,100,39</INFO></NAVI>。";
							mes "任何人都可以入学，好好利用这个机会吧。";
							next;
							emotion ET_SURPRISE, getnpcid(0, "Information Staff#"+strnpcinfo(2));
							mes "[Information Staff]";
							mes "抱歉打扰一下。";
							mes "但^4d4dff如果你需要位置资讯，请问我。^000000";
							next;
							mes "[Information Staff]";
							mes "Hun 提供的资讯有限。";
							close;
						case 2:
							mes "[Hun]";
							mes "你真乐观。";
							mes "如果需要帮助，随时可以来克里图拉学院。";
							next;
							mes "[Hun]";
							mes "入学没有要求，也不需要付费，这会对你很有帮助。";
							mes "沿这条路向北走，你会找到";
						mes "<NAVI>[学院建筑]<INFO>iz_ac01,100,39</INFO></NAVI>。";
							next;
							mes "[Hun]";
							mes "如果有更多像你这样的冒险者，未来会更加光明。";
							mes "哈哈哈哈。";
							next;
							emotion ET_SURPRISE, getnpcid(0, "Information Staff#"+strnpcinfo(2));
							mes "[Information Staff]";
							mes "抱歉打扰一下。";
							mes "但^4d4dff如果你需要位置资讯，请问我。^000000";
							next;
							mes "[Information Staff]";
							mes "Hun 提供的资讯有限。";
							close;
						case 3:
							mes "[Hun]";
							mes "你已经安排好计划了？";

	lighthalzen,162,304,7	script	Rekenber Guard Drew#li	868,{
	mes "[Rekenber Guard Drew]";
	mes "伙计，看看这个～";
	mes "卡普拉小姐的官方精装照片。现在……";
	mes "吊袜带多了 20%！";
	emotion ET_DELIGHT;
	next;
	mes "[Rekenber Guard Tan]";
	mes "所以她们都戴着吊袜带？";
	mes "哇，连戴眼镜的女孩也戴？";
	mes "这是我今天听到的最好消息！";
	emotion ET_HUK, getnpcid(0, "Rekenber Guard Tan#li");
	next;
	mes "[Rekenber Guard Drew]";
	mes "好吧伙计，这些是限量收藏品，";
	mes "所以每一张都值";
	mes "300,000 Zeny。我的意思是，我还有";
	mes "额外一套，不过我不知道你是否想买——";
	next;
	mes "[Rekenber Guard Tan]";
	mes "我全要了。";
	mes "等等，除了那个年轻女孩的。";
	mes "把她的写真放在身边";
	mes "让我觉得……";
	mes "对，对，还是算了。";
close;
}


	lhz_in02,147,222,3	script	Officer Guo#06::off_guo	85,{
	mes "[Officer Guo]";
	mes "告诉我……！";
	mes "告诉我……！！";
	mes "承认是你做的！！";
	next;
	mes "[Suspect]";
	mes "可恶！";
	mes "我一直告诉你";
	mes "我没有罪！";
	next;
mes "[Officer Guo]";
mes "^333333*叹气……*^000000";
next;
mes "[Suspect]";
mes "你在浪费时间。";
	mes "放我走吧。";
	next;
	mes "[Officer Guo]";
	mes "那么……";
	mes "你母亲好吗？";
	next;
	mes "[Suspect]";
	mes "不关你的事！";
	mes "我想她很好。";
	next;
	mes "[Officer Guo]";
	mes "你上次见她是什么时候？";
	next;
	mes "[Suspect]";
	mes "我刚告诉过你，";
	mes "不关你的事……！";
next;
mes "[Officer Guo]";
mes "你知道，动物王国里的母亲";
	mes "都会本能地照顾幼崽。";
	mes "人类也不例外。";
	mes "你的母亲一定担心得要命。";
	next;
	mes "[Suspect]";
	mes "...";
	mes "天哪……";
	mes "你开始";
mes "让我毛骨悚然了。";
next;
mes "[Officer Guo]";
	mes "人类有件有趣的事。";
	mes "他们似乎天生爱撒谎，";
	mes "即使知道会被抓住也一样。";
	mes "但和所有动物一样，";
	mes "他们本能地害怕疼痛……";
	next;
	mes "[Suspect]";
	mes "不、不……";
mes "你一定是在……";
mes "你在虚张声势。";
mes "对吧？";
	next;
	mes "[Officer Guo]";
	mes "不。";
	mes "你才在虚张声势。";
	mes "告诉我……！";
	mes "告诉我……！！";
	mes "承认是你做的！！";
	close;
	}
	
	lhz_in02,142,222,6	duplicate(off_guo)	Suspect#6	870
	

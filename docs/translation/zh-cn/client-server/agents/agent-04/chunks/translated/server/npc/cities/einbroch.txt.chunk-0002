	ein_in01,31,217,3	script	Cendadt#ein	851,{
	mes "[Cendadt]";
	mes "这家工厂有很多东西";
	mes "需要马上修理！";
	mes "我真惊讶它居然还在运转！";
	next;
	mes "[Cendadt]";
	mes "幸运的是，我听说有些";
	mes "无私的冒险者一直捐赠材料，";
	mes "帮助这家工厂避免崩溃……";
	mes "或者更糟的下场。";
	mes "不过那只是传闻。";
	next;
	mes "[Cendadt]";
	mes "^666666*叹气*^000000";
	mes "即使这是真的，";
	mes "这里也没有人能做什么。";
	mes "没人有勇气挑战这个体制，";
	mes "你明白吧？";
	next;
	mes "[Cendadt]";
	mes "我……";
	mes "我最好赶快";
	mes "回去工作，";
	mes "免得惹上麻烦……";
	close;
}

	ein_in01,113,211,3	script	Teinz#ein	851,{
	mes "[Teinz]";
	mes "只要你给我钱，";
	mes "我就给你当奴隶！";
	mes "什么我都愿意做！";
	mes "只要钱给够，让我脱光都行。";
	next;
	mes "[Teinz]";
	mes "只要你付给我应得的报酬，";
	mes "你交代的任何任务我都会努力完成。";
	mes "采矿确实辛苦，";
	mes "但只要 Zeny 不断进账，";
	mes "我就很开心。嘿嘿嘿～";
	close;
	}
	
	ein_in01,48,220,5	script	Lowe#ein	851,{
	mes "[Lowe]";
	mes "...";
	mes "......";
	next;
	mes "[Lowe]";
mes "...";
mes "......";
mes ".........";
	next;
	mes "[Lowe]";
	mes "喂，你为什么";
	mes "那样看着我？工作时间";
	mes "不许闲聊。";
	mes "要是坎普提发现你，";
	mes "你会受罚的……";
	next;
	mes "[Lowe]";
	mes "等等……";
	mes "你不是这里的工人。";
	mes "抱歉，冒险者，";
	mes "那种反应已经是我的老习惯了。";
	close;
	}
	
	ein_in01,87,237,5	script	Dinje#ein	850,{
	mes "[Dinje]";
	mes "你知道像我这样的女人";
	mes "为什么必须在这家工厂工作吗？";
	mes "我来告诉你……";
	next;
	mes "[Dinje]";
	mes "我那懒惰的丈夫格辛，";
	mes "就躺在地上什么也不做！";
	mes "所以我必须工作养活我们！";
	next;
	mes "[Dinje]";
	mes "如果想攒够钱，";
	mes "将来变得富有强大，";
mes "我们一秒钟都不能休息。";
mes "你明白吗？";
next;
	mes "[Dinje]";
	mes "显然我丈夫不明白！";
	mes "他怎么会不知道现实世界是怎样的？！";
	mes "喂，要是他还不赶快醒来，";
	mes "替我踹他几脚！";
	close;
	}
	
	ein_in01,84,218,3	script	Tsuen#ein	851,{
	mes "[Tsuen]";
	mes "曾经有一段时间，";
	mes "我梦想成为像你一样的冒险者。";
	mes "但那已经是很久以前的事了……";
	next;
	mes "[Tsuen]";
	mes "现在我只是工厂经理。";
	mes "虽然工作不算出色，";
	mes "但我还算满意。";
	mes "我相信大家都喜欢";
	mes "我负责监管的产品……";
	next;
	mes "[Tsuen]";
	mes "也许我的人生注定如此，";
	mes "尽管这不是我的计划。";
	mes "但总有一天机会来临，";
	mes "我会离开这里周游世界！";
	next;
	mes "[Tsuen]";
mes "我希望有一天能在";
mes "广阔的世界与你相遇，";
mes "并以冒险者同伴的身份向你问候。";
	close;
	}
	
	ein_in01,103,239,1	script	Gesin#ein	849,{
	mes "[Gesin]";
	mes "Arrrgh!";
	mes "真让我受不了！";
	mes "我为什么非得有钱不可？";
	mes "量入为出地生活有什么不好？";
	next;
	mes "[Gesin]";
	mes "我对现在的生活方式";
	mes "没有任何不满，";
	mes "可那个管家婆不这么想。";
	mes "她为什么如此执着于";
	mes "财富和权力？";
	next;
	mes "[Gesin]";
	mes "不管怎样，我想帮她，";
mes "但我站不起来！我筋疲力尽，";
mes "身体也已经超负荷了。";
mes "我一点力气都没有。";
	next;
	mes "[Gesin]";
	mes "太糟糕了～";
	mes "我应该好好休息，";
	mes "而不是操心赚钱……";
	close;
	}
	
	ein_in01,33,275,1	script	Pevtatin#ein	848,{
	mes "[Pevtatin]";
	mes "天哪！";
	mes "我压力太大了！";
	mes "自从搬来这里，";
	mes "就一直忙个不停！";
	next;
	mes "[Pevtatin]";
	mes "工作很辛苦，老板还已经";
	mes "讨厌我了！我搬来这里";
	mes "可不是为了这些！不过工资还不错，";
	mes "看来我只能再忍耐一阵子。";
	next;
	mes "[Pevtatin]";
	mes "开始吧……！";
mes "嘿哟！";
mes "嘿哟～！";
close;
	}
	
	ein_in01,36,204,3	script	Rombell#ein	851,{
	mes "[Rombell]";
	mes "工厂经营良好、利润丰厚，";
	mes "这当然很棒，";
	mes "但我仍有一个主要担忧。";
	next;
	mes "[Rombell]";
	mes "这里造成的污染太可怕了！";
	mes "这些机器整天排放有毒气体！";
	mes "空气不可能长久保持安全……";
	next;
	mes "[Rombell]";
mes "我是说，我们现在呼吸的空气";
mes "已经相当污浊，情况只会越来越糟。";
mes "我们该如何解决这个问题？";
	close;
	}
	
	ein_in01,64,271,3	script	Vonstein#ein	855,{
	mes "[Vonstein]";
	mes "盯着这锅沸腾的";
	mes "炽热金属液体，";
	mes "让我心里很舒服。";
	mes "那东西仿佛能熔化一切！";
	next;
	mes "[Vonstein]";
	mes "想象一下用那东西";
	mes "覆盖整条街的人！哇哈哈——";
	mes "啊，抱歉，我只是在胡说八道！";
	mes "开个玩笑而已～";
	close;
	}
	
	ein_in01,49,202,3	script	Dorf#ein	851,{
	mes "[Dorf]";
mes "机器真是太方便了。";
mes "看看这个装置，";
mes "轻松就能完成";
	mes "我一个人很难做的工作。";
	next;
	mes "[Dorf]";
	mes "这才叫科技！";
	mes "制造这种东西当然需要";
	mes "精力和金钱，但这关我什么事？";
	next;
	mes "[Dorf]";
mes "只要这该死的东西";
mes "继续按我想要的方式运转，";
mes "我就没有任何问题！";
	close;
	}
	
	ein_in01,68,209,5	script	Khashurantze#ein	852,{
	mes "[Khashurantze]";
	mes "抱歉，你需要特殊许可";
	mes "才能进入这里。";
	mes "请你现在离开。";
	close2;
	warp "einbroch",179,63;
	end;
	}
	
	ein_in01,85,261,3	script	Zherin#ein	851,{
	mes "[Zherin]";
	mes "我负责管理这座";
	mes "装满沸腾岩浆的高炉。";
	next;
	mes "[Zherin]";
	mes "虽然这工作不需要体力劳动，";
	mes "但仍然相当累人。";
mes "我必须一直保持专注，";
mes "压力真的很大。";
next;
	mes "[Zherin]";
	mes "不过我为自己的工作自豪，";
	mes "因为我负责保障员工安全。";
	mes "总之别靠炉子太近，";
	mes "不小心被烫伤可不好！";
	close;
	}
	
	ein_in01,43,252,3	script	Canphotii#ein	852,{
	mes "[Canphotii]";
	mes "快点，快点！";
	mes "加快速度！";
	mes "谁工作太慢就要受罚！";
	next;
	mes "[Canphotii]";
	mes "你听不懂吗？！";
	mes "现在回到岗位继续工作！";
	mes "等等，你是员工吗？";
	mes "不是的话就别在这里闲逛！";
	next;
	mes "[Canphotii]";
mes "你本来不该进得来的！";
mes "真不敢相信他们竟放你进来！";
mes "这需要严厉的纪律处分！";
	close;
	}
	

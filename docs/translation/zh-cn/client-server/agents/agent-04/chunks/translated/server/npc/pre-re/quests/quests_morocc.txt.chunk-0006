		mes "[" + strcharinfo(0) + "]";
		mes "（作为国王候选人，他似乎性格彬彬有礼）";
		next;
		while(1) {
			mes "- 好了，提问吧。-";
			next;
			switch(select("backgroud first.:I want to know your spirit of nationalism.: Your habbit and tastes.:I will be back.")) {
			case 1:
				mes "[恩斯特]";
				mes "我从小接受王室教育长大。 我没有和别人认真争吵过，但也算不上很有礼貌。";
				next;
				mes "[恩斯特]";
				mes "人们以为我胆小，是因为我不想被他人排斥。";
				next;
				mes "[恩斯特]";
				mes "当然，也有一个例外……艾根。";
				next;
				mes "[恩斯特]";
				mes "艾根·阿鲁姆就是例外。 他虽然不礼貌，却能用确切的确认让别人理解。";
				next;
				mes "[恩斯特]";
				mes "我认为这是很棒的能力，应该学习。但这不仅关乎结果，也关乎礼仪。我们必须做好该做的事。";
				next;
				mes "[恩斯特]";
				mes "对我来说，过程和结果同等重要。阿鲁姆教会我不要轻视结果。";
				break;
			case 2:
				mes "[恩斯特]";
				mes "成为国王时的民族主义精神？";
				next;
				mes "[恩斯特]";
				mes "你可能认为国王的力量无限，但作为一个人，它也有局限。";
				next;
				mes "[恩斯特]";
				mes "普通民众和杰出人士都参与社会治理。汇聚智慧比独自做事更容易。";
				next;
				mes "[恩斯特]";
				mes "阿鲁姆会帮助我弥补不足。不只是阿鲁姆，所有大臣、内阁成员和民众都是我的老师。";
				next;
				mes "[恩斯特]";
				mes "除了阿鲁姆，我还有许多老师，这是我的幸运。 这对我的国家也有好处。";
				next;
				break;
			case 3:
				mes "[恩斯特]";
				mes "我没有特别的习惯。 我只是喜欢学习和读书。";
				next;
				mes "[恩斯特]";
				mes "我也喜欢和阿鲁姆交谈。 阿鲁姆很聪明，总能提出我可以采纳的新想法。";
				next;
				mes "[恩斯特]";
				mes "说实话，我更喜欢和阿鲁姆一起钓鱼。不过王国事务太多，我们没有时间。";
				next;
				mes "[恩斯特]";
				mes "我们约好登基后去钓鱼……到时再看……";
				next;
				mes "[恩斯特]";
				mes "嗯……够了吗？";
				next;
				break;
			case 4:
				mes "[恩斯特]";
				mes "好，那么回头见。";
				if (nkprince_eisen == 1) {
					set nkprince_eisen,3;
				}
				else {
					set nkprince_eisen,2;
				}
				completequest 10006;
				set .@prin1,checkquest(10005);
				set .@prin2,checkquest(10006);
				set .@prin3,checkquest(10007);
				set .@prin4,checkquest(10008);
				set .@prin5,checkquest(10009);
				set .@prin6,checkquest(10010);
				set .@prin7,checkquest(10011);
				if ((.@prin1 + .@prin2 + .@prin3 + .@prin4 + .@prin5 + .@prin6 + .@prin7) == 14) {
					setquest 10012;
				}
				close;
			}
		}
	}
}

prt_castle,163,319,0	script	#twonoble	-1,3,3,{
OnTouch:
	if (nkprince_eisen == 7) {
		donpcevent "Young Noble#valter::OnEnable";
		donpcevent "Aged Noble#rihart::OnEnable";
		mes "[年长贵族]";
		mes "你不必担心。";
		mes "只要我的艾根·阿鲁姆当选国王，理查德家族就会成为第二大贵族。";
		next;
		mes "[理查德家族成员]";
		mes "呵呵，阿鲁姆已经是最受欢迎、最有影响力的候选人。若能实现这一点就太好了。";
		next;
		mes "[沃尔特家族成员]";
		mes "虽然阿鲁姆是强力候选人，但盖博尔格王子也以德行闻名。最好确认清楚。";
		next;
		mes "[沃尔特家族成员]";
		mes "那么，你参与了毒害恩斯特王子的计划吗？";
		next;
		mes "[理查德家族成员]";
		mes "当然。就算验尸也查不出来……你不必担心。";
		next;
		mes "[沃尔特家族成员]";
		mes "恩斯特王子死后，阿鲁姆就会当选，然后……";
		next;
		mes "[理查德家族成员]";
		mes "两大家族将共同领导这个国家，呵呵呵。";
		next;
		mes "[沃尔特家族成员]";
		mes "你一定知道沃尔特和盖博尔格做过什么。两大家族一直掌控着国家。";
		next;
		mes "[理查德家族成员]";
		mes "七大家族中最弱的盖博尔格家族，通过与施密特和沃尔特结盟取得了权力。";
		next;
		mes "[沃尔特家族成员]";
		mes "是的，所以沃尔特与盖博尔格的联合非常完美。而且阿鲁姆和恩斯特……显然是施密特与海因里希的再现。";
		next;
		mes "[沃尔特家族成员]";
		mes "因此沃尔特家族和盖博尔格家族不能共存。他们共存只会带来毁灭，就像过去一样。";
		next;
		mes "[理查德家族成员]";
		mes "谢谢。该走了。所有知道过去的人都会否认与阿鲁姆或恩斯特勾结。";
		next;
		mes "[沃尔特家族成员]";
		mes "总之，我们还有一点时间。务必保守秘密，不要告诉任何人。";
		next;
		mes "[理查德家族成员]";
		mes "是的。为了卢恩·米德加尔兹的荣耀。";
		next;
		mes "[沃尔特家族成员]";
		mes "卢恩·米德加尔兹的全部荣耀……";
		mes "嗯？";
		next;
		emotion ET_SURPRISE;
		mes "[沃尔特家族成员]";
		mes "安静……有人来了。";
		mes "好……保重。";
		next;
		mes "[理查德家族成员]";
		mes "没关系……";
		donpcevent "Young Noble#valter::OnDisable";
		donpcevent "Aged Noble#rihart::OnDisable";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "（沃尔特是阿鲁姆的姓。";
		mes "理查德是波伊的姓。）";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "（这是两大家族的阴谋吗？真见鬼……）";
		changequest 10016,10017;
		set nkprince_eisen,8;
		close;
	}
}


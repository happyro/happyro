prt_castle,314,371,0	script	Prince#another_ern	985,{
	if (nkprince_eisen == 13) {
		mes "[Ahrum]";
		mes "我告诉过你，我不想当国王，也没打算改变主意！";
		next;
		mes "[恩斯特]";
		mes "哥哥！我不知道你为何如此痛苦！你就这么软弱吗？！";
		next;
		mes "[Ahrum]";
		mes "痛苦？我吗……啊……看起来是这样？是的。压力很大……呵呵呵……哈哈哈！！";
		next;
		mes "[恩斯特]";
		mes "哥哥，阿鲁姆……？";
		next;
		mes "[Ahrum]";
		mes "……只有我能逃走吗……总之，我是个不合格的人……呵呵。但我已经做了决定。";
		next;
		mes "[Ahrum]";
		mes "Ernst.";
		next;
		mes "[恩斯特]";
		mes "是……？是？";
		next;
		mes "[Ahrum]";
		mes "拿着这个。";
		next;
		mes "- 唰。-";
		next;
		mes "- 阿鲁姆随手把巴泽拉尔扔给恩斯特。-";
		next;
		mes "[恩斯特]";
		mes "呃……？这是怎么回事……？沃尔特家族的巴泽拉尔？为什么？";
		next;
		mes "[Ahrum]";
		mes "时机正好，连见证人也在！恩斯特，你还清楚记得我们的约定吧？";
		next;
		mes "[恩斯特]";
		mes "什么？约定？见证人……？啊……真、真的吗……";
		next;
		mes "[Ahrum]";
		mes "真的。就是现在。";
		next;
		mes "[恩斯特]";
		mes "胡说！你觉得我能对你下手吗？！";
		next;
		mes "[Ahrum]";
		mes "蠢货！成为国王就该果断行动。我没有当国王的机会。腐败地活着，比被你杀死更糟……";
		next;
		mes "[恩斯特]";
		mes "但、但是你可以继续这样活着！就当什么都没发生。你只需恢复原状。哥哥，让我帮你。告诉我你隐藏的一切……";
		next;
		mes "[Ahrum]";
		mes "真是愚蠢！你觉得自己像国王吗？！现在是在同情我吗？你应该理智一点！否则没有资格成为国王候选人！";
		next;
		mes "[恩斯特]";
		mes "可、可是！";
		next;
		mes "[Ahrum]";
		mes "争论没有用！我别无选择。如果你不理智地一味坚持，就不该成为国王。";
		next;
		mes "[Ahrum]";
		mes "呃？！哥哥？！";
		next;
		mes "（匕首刺入声）";
		specialeffect EF_HIT2;
		set nkprince_eisen,14;
		donpcevent "Prince#another_ern::OnDisable";
		donpcevent "Prince#another_ern1::OnEnable";
		close;
	}
	if (nkprince_eisen == 5) {
		mes "[Ahrum]";
		mes "无论谁成为国王，";
		mes "让我们互相帮助，";
		mes "把卢恩·米德加尔兹建设成世界上最好的国家。";
		next;
		mes "[恩斯特]";
		mes "我们能做到。";
		mes "不，我们一定能做到。哥哥和我一起，一定能做到。";
		next;
		mes "[Ahrum]";
		mes "但是，如果我要统治或帮助你，而我却腐败了……你要亲手杀了我。";
		next;
		mes "[Ahrum]";
		mes "反过来我也会杀你，明白吗？所以永远不要迷失，也别忘了你的决心。";
		next;
		mes "[恩斯特]";
		mes "哥哥，你想得太糟了。";
		mes "这种事不会发生，所以……";
		mes "别这样说。";
		next;
		mes "[Ahrum]";
		mes "这只是个假设。";
		mes "别太当真。";
		next;
		mes "[恩斯特]";
		mes "好吧，好吧，别误会。";
		mes "我一直为了哥哥和王国行事，以后也会如此。";
		mes "";
		next;
		emotion ET_SURPRISE;
		mes "[Ahrum]";
		mes "啊，评估者来了。";
		mes "你怎么突然出现？我和恩斯特正聊到一半。";
		next;
		mes "[恩斯特]";
		mes "怎么了，哥哥？我们没说什么坏事，只是在坚定我们的决心。";
		next;
		mes "[Ahrum]";
		mes "你来得正好。";
		mes "我们刚决定，如果其中一人腐败，";
		mes "另一人就杀了他。";
		mes "";
		next;
		mes "[恩斯特]";
		mes "哥哥？！";
		next;
		mes "[Ahrum]";
		mes "请务必成为这份约定的见证人。你不能拒绝，因为从某些方面说，这对你的工作很有好处，对吧？";
		next;
		mes "[恩斯特]";
		mes "哥、哥哥，你太强势了。评估者也该有自己的立场和意见。";
		next;
		mes "[Ahrum]";
		mes "你还是这么软弱。我又没强迫他做难事！管他呢？沉默就是肯定答复！我的提议成功了！我们的约定也成立了！";
		next;
		mes "[恩斯特]";
		mes "哈啊……哈哈……评估者，很抱歉冒犯你。对不起，但这份约定不可能实现。别把这当真……你懂的……等猪会飞了再说……~";
		next;
		mes "[恩斯特]";
		mes "现在我回房间了。评估者，继续努力。";
		donpcevent "Prince#another_ern::OnDisable";
		set nkprince_eisen,6;
		close;
	}

OnInit:
	disablenpc "Prince#another_ern";
	end;

OnEnable:
	enablenpc "Prince#another_ern";
	end;

OnDisable:
	disablenpc "Prince#another_ern";
	end;
}

prt_castle,314,372,0	script	Prince#another_ern1	985,{
	if (nkprince_eisen == 14) {
		mes "[恩斯特]";
		mes "哥、哥哥……？你说过会杀我……你只是想让我杀你吗……？哥、哥哥……？";
		next;
		mes "[Ahrum]";
		mes "呵呵……不是。我只是想杀你……就这样……干得好，恩斯特……这是合法的自卫，杀死恶徒……对吧？";
		next;
		mes "[恩斯特]";
		mes "哥、哥哥……现在还不晚！去找医生还能救回来！";
		next;
		mes "[Ahrum]";
		mes "太晚了……重要器官被刺穿后……我怎么可能活着，甚至怎么可能复活……我不需要活着。";
		next;
		mes "[恩斯特]";
		mes "哥、哥哥……你怎么能这样？！";
		next;
		mes "[Ahrum]";
		mes "再见，我的弟弟……成为国王，改变这个国家。你……你做得到……咳……";
		next;
		mes "[恩斯特]";
		mes "……哥哥……哥哥……为什么……你的表情为何如此满足？为什么……哥哥……";
		next;
		mes "[Ahrum]";
		mes "呵呵……你不必知道。顺便说，你遵守了约定……你应该成为国王……但如果你迷失，我会随时从地狱回来杀了你！！";
		next;
		mes "[恩斯特]";
		mes "我……我不知道！我不知道发生了什么！";
		next;
		mes "[Ahrum]";
		mes "你不必知道……你只需明白我做出了牺牲。为了让我的死有意义，你要成为好国王。这是我的信念……就这样……咳！别忘了我的话……咳咳。";
		next;
		mes "[恩斯特]";
		mes "笨蛋……傻瓜……";
		next;
		mes "[Ahrum]";
		mes "啊……评估者，你知道该做什么吗？谨慎言辞。关于你看到、听到的一切……不能把经历全部告诉调查员。";
		next;
		mes "[Ahrum]";
		mes "恩斯特在这里杀死了一个恶徒……我没有机会……他果断行动，因此有资格成为国王……";
		next;
		mes "[Ahrum]";
		mes "如果你错误地处理这件事，我的死就毫无价值……咳……明白吗？";
		next;
		switch(select("... Okay I will follow your will...:......")) {
		case 1:
			mes "[" + strcharinfo(0) + "]";
			mes "……好吧，我会遵从你的意愿。别担心……";
			next;
			break;
		case 2:
			mes "[" + strcharinfo(0) + "]";
			mes "......";
			next;
			mes "[Ahrum]";
		mes "无知……是积极的……这意味着……我的提议……成功了……";
			next;
			break;
		}
		mes "[Ahrum]";
		mes "现在……我可以安详地死去了……非常……感谢你们……";
		next;
		mes "[恩斯特]";
		mes "哥哥……";
		next;
		mes "[Ahrum]";
		mes "那么，永别了……再见……抱歉……现在不能去钓鱼了。";
		next;
		mes "[恩斯特]";
		mes "哥……哥哥？";
		next;
		mes "[Ahrum]";
		mes "......";
		next;
		mes "[恩斯特]";
		mes "哥……哥哥！";
		next;
		mes "[Ahrum]";
		mes "......";
		next;
		mes "[恩斯特]";
		mes "哥哥啊啊啊啊啊！！！";
		next;
		set nkprince_eisen,15;
		set nk_prince,7;
		donpcevent "Prince#another_ern1::OnDisable";
		changequest 10024,10025;
		close2;
		warp "prt_castle",318,273;
		end;
	}

OnInit:
	disablenpc "Prince#another_ern1";
	end;

OnEnable:
	enablenpc "Prince#another_ern1";
	end;

OnDisable:
	disablenpc "Prince#another_ern1";
	end;
}

prt_castle,272,372,1	script	Prince#eisen1	983,{
	mes "[Ahrum]";
	mes "蠢货。你永远不会成为国王。你一生都不会……明白吗？你这个废物成瘾者！！";
	next;
	mes "[Erich]";
	mes "……我没想成为国王，但脏话让我很不舒服。你突然怎么了？";
	next;
	mes "[Ahrum]";
	mes "我只是受够你了。像你这样的混蛋也能当国王候选人？想到王位继承我就恶心。";
	next;
	mes "[Erich]";
	mes "是的，这没什么错。但我是尼洛斯家族的代表，无法忍受你的侮辱。";
	next;
	mes "[Erich]";
	mes "你的家族知道你的疯狂行为吗？你正在毁掉自己的名声和家族名誉。";
	next;
	mes "[Ahrum]";
	mes "……！是……我才不在乎。不……连我的存在也不在乎！咯咯……哈哈哈哈！";
	next;
	mes "[Ahrum]";
	mes "是的，你我都不合格！哈哈哈哈！！这个该死的成瘾者揭示了真相！是的，哈哈哈哈哈！！";
	next;
	mes "[Erich]";
	mes "……疯子混蛋。滚开，我不想再和你说话。";
	next;
	mes "[Ahrum]";
	mes "是的，我这就走。家族耻辱？！！哈哈哈……家族是什么！！咯咯咯！！真有趣！";
	next;
	mes "- 阿鲁姆似乎失去了理智，走向门口。-";
	next;
	mes "[Erich]";
	mes "……疯了。";
	completequest 10020;
	set .@er1,checkquest(10018);
	set .@er2,checkquest(10019);
	set .@er3,checkquest(10020);
	set .@er4,checkquest(10021);
	set .@er5,checkquest(10022);
	if ((.@er1 + .@er2 + .@er3 + .@er4 + .@er5) == 10) {
		setquest 10023;
		set nkprince_eisen,11;
	}
	donpcevent "Prince#eisen1::OnDisable";
	close;

OnInit:
	disablenpc "Prince#eisen1";
	end;

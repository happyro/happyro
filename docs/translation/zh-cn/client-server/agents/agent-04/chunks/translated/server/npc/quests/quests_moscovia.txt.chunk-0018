			mes "[露莎卡]";
			mes "……你还活着……";
			mes "我的凝视没有……";
			mes "你在这里做什么……？";
			close;
		} else if (rhea_rus_main == 8) {
			if (rhea_rus_hair < 2) {
				mes "[露莎卡]";
				mes "……你还活着……";
				mes "我的凝视没有……";
				mes "你在这里做什么……？";
				close;
			} else if (rhea_rus_hair == 2) {
				if (getequipid(EQI_SHOES) != 2429 && getequipid(EQI_SHOES) != 2430) {
					mes "["+ strcharinfo(0) +"]";
			mes "……嗯，我是不是忘了穿什么……？";
					close;
				}
				mes "……你还活着……";
				mes "我的凝视没有……";
				mes "你在这里做什么……？";
				next;
				mes "[露莎卡]";
				mes "水之女神的夜晚。";
				mes "你没听说过露莎卡的凝视能杀人吗？ 如果你没有‘圣水’，肯定已经死了。";
				next;
			select("我是冒险者，而且……");
				mes "[露莎卡]";
				mes "……冒险家……？";
				mes "那么你是从另一个大陆而非莫斯科比亚来的……？";
				next;
				mes "["+ strcharinfo(0) +"]";
				mes "我来自卢恩·米德加尔特。";
				next;
				mes "[露莎卡]";
			mes "……卢恩……米德加兹……";
			mes "几天前，我的恋人去了卢恩-米德加兹……你能替我找到他吗？我想和他说话……";
				next;
				mes "[露莎卡]";
			mes "……我不知道为什么，但我不记得自己是如何成为露莎卡的。醒来时，我正躺在河底。";
				next;
				mes "[露莎卡]";
			mes "我忘记了一切，却没有忘记他。他的笑容和温暖的手。我记得关于他的一切。";
				next;
				mes "[露莎卡]";
			mes "我在河底看着他。他总是坐在河边，望着沼泽，眼神非常悲伤。";
				next;
				mes "[露莎卡]";
			mes "看着他悲伤让我很痛苦，却无法与他相见。普通人看到露莎卡的凝视会立即死亡……";
				next;
				mes "[露莎卡]";
			mes "我每天都看见他来到沼泽，听见他的哀悼，也听见他要去卢恩-米德加兹的决心。";
				next;
				mes "[露莎卡]";
			mes "冒险者，你能替我找到他吗？我无法离开这片沼泽。求你，替我找到他好吗？";
				next;
				mes "[露莎卡]";
			mes "我不想让他回来，也不想再见到他。但请告诉他，我希望他停止痛苦，幸福地生活。";
				next;
				mes "[露莎卡]";
			mes "我成为了露莎卡，但没关系。我并不悲伤。然而，我能感受到环绕着我的河流中他的悲伤。我为此感到难过。";
				next;
				mes "[露莎卡]";
			mes "请找到他，告诉他我没事，让他不要再痛苦……";
				next;
				mes "["+ strcharinfo(0) +"]";
			mes "我在哪里能找到他？";
				next;
				mes "[露莎卡]";
			mes "他离开的那晚说要去卢恩-米德加兹的首都。我不确定他是否还在那里……";
				next;
			if(select("好，我会去做。:我不认为自己做得到……") == 2) {
					mes "["+ strcharinfo(0) +"]";
				mes "卢恩-米德加兹很大！我不认为自己做得到。";
					next;
					mes "["+ strcharinfo(0) +"]";
				mes "我们无能为力。放弃吧。";
					next;
					mes "[露莎卡]";
				mes "啊……但是……";
					emotion ET_CRY;
					donpcevent "Lusalka#rus23::OnDisable";
					close;
				}
				mes "[露莎卡]";
			mes "啊！太谢谢你了！他的名字是‘^0000ff伊戈尔^000000’。啊，把这些耳环交给他。这是他送给我的礼物。";
				next;
			mes "- ^0000ff我收到了^000000 -";
			mes "- ^0000ff金色耳环^000000 -";
			mes "- ^0000ff来自露莎卡！^000000 -";
				rhea_rus_hair = 3;
				// changequest 8149,8150;
				donpcevent "Lusalka#rus23::OnDisable";
				close;
			} else if (rhea_rus_hair > 2 && rhea_rus_hair < 7) {
				mes "[露莎卡]";
				mes "他的名字是‘伊戈尔’……他去了卢恩-米德加兹的首都。把我的金色耳环交给他。";
				next;
				mes "[露莎卡]";
				mes "还有，请告诉他停止痛苦，幸福地生活。这是我的请求。";
				close;
			} else if (rhea_rus_hair == 7) {
				if (getequipid(EQI_SHOES) != 2429 && getequipid(EQI_SHOES) != 2430) {
					mes "["+ strcharinfo(0) +"]";
					mes "……嗯，我是不是忘了穿什么……？";
					close;
				}
				mes "[露莎卡]";
				mes "你见到他了吗？他怎么样？";
				next;
				mes "["+ strcharinfo(0) +"]";
				mes "这是伊戈尔的消息。";
				mes "他说记得和你在一起的每一刻，仍然爱着你。";
				next;
				mes "["+ strcharinfo(0) +"]";
				mes "他会在满月前回到莫斯科比亚，希望与你见面。他告诉我，他会变得足够坚强，不再让你痛苦。";
				next;
				mes "[露莎卡]";
				mes "伊戈尔……";
				next;
				mes "[露莎卡]";
				mes "非常感谢你。我真的很感激。";
				mes "我要如何感谢你？告诉我有什么能为你做的。";
				next;
				mes "["+ strcharinfo(0) +"]";
				mes "我可以请你帮个忙吗？";
				next;
				mes "[露莎卡]";
				mes "如果我能做到，我会帮你。";
				next;
				mes "["+ strcharinfo(0) +"]";
				mes "如果可以的话！！";
				mes "……我需要你的一些头发。";
				next;
				mes "[露莎卡]";
				mes "……咦，头发？就这些吗？";
				next;
				mes "["+ strcharinfo(0) +"]";
				mes "其实不止这些。";
				mes "我需要 2 缕！";
				next;
				mes "[露莎卡]";
				mes "啊，哈哈哈。";
				mes "这就是你想要的吗？呼呼，想拿多少就拿吧。";
				next;
				mes "- 露莎卡剪下一些 -";
				mes "- 她的头发 -";
				mes "- 用锋利的指甲 -";
				next;
				mes "[露莎卡]";
				mes "给你，我的头发……？！";
				mes "啊啊啊啊啊！？！？！";
				sc_start SC_CURSE,60000,0;
				specialeffect2 EF_LORD;
				emotion ET_HUK, playerattached();
				percentheal -30,0;
				next;
				mes "["+ strcharinfo(0) +"]";
				mes "那、那是什么！？";
				mes "谁在那里？！";
				next;
				mes "[Voice unidentified]";
				mes "别以为你成功把我封在这个牢笼里了，蠢货！";
				mes "你永远阻止不了我！！！";
				mes "哈哈哈哈！！！";
				next;
				mes "["+ strcharinfo(0) +"]";
				mes "你、你是谁！？啊啊！！";
				sc_start SC_BLIND,10000,0;
				rhea_rus_hair = 8;
				// // completequest 8150;
				// completequest 8153;
				donpcevent "Lusalka#rus23::OnDisable";
				close;
			} else if (rhea_rus_hair > 7) {
				mes "["+ strcharinfo(0) +"]";
				mes "……？！你是什么？沼泽幽灵吗？";
				next;
				mes "[露莎卡]";
				mes "..........................";
				next;
				mes "- 绿色的东西似乎张嘴想说些什么，却很快闭上嘴，用悲伤的眼神看着你 -";
				close;
			}
			mes "["+ strcharinfo(0) +"]";
			mes "……？！你是什么？沼泽幽灵？";
			next;
			mes "[露莎卡]";
			mes "..........................";
			next;
			mes "- 绿色的东西似乎张嘴想说什么，但很快又闭上，用悲伤的眼睛看着你 -";
			close;
		}
		end;
	}
			mes "- 当露莎卡注视你时，你失去了意识 -";
	specialeffect2 EF_FLASHER;
	percentheal -60,0;
	donpcevent "Lusalka#rus23::OnDisable";
	close;

OnEnable:
	initnpctimer;
	enablenpc "Lusalka#rus23";
	end;

OnTimer300000:
OnDisable:
	stopnpctimer;
OnInit:
	disablenpc "Lusalka#rus23";
	end;
}


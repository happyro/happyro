moc_pryd04,126,120,0	script	Soldier#rus26	4_M_RUSMAN1,{
	if (rhea_rus_main < 8) {
		mes "[A gloomy looking soldier]";
		mes "............................";
		close;
	} else if (rhea_rus_main == 8) {
		if (rhea_rus_hair < 5) {
			mes "[A gloomy looking soldier]";
			mes "............................";
			close;
		} else if (rhea_rus_hair == 4 || rhea_rus_hair == 5) {
			.@player_name$ = strcharinfo(0);
			if (getequipid(EQI_SHOES) != 2429 && getequipid(EQI_SHOES) != 2430) {
				mes "["+ .@player_name$ +"]";
				mes "……嗯，我是不是忘了穿什么……？";
				close;
			}
			mes "[A gloomy looking soldier]";
			mes "............................";
			next;
			mes "[A gloomy looking soldier]";
			mes "……我不知道你是谁。离我远点。我不想说话……";
			next;
			mes "["+ .@player_name$ +"]";
		mes "这里很危险，到处都是凶猛的怪物。";
			next;
			mes "[A gloomy looking soldier]";
		mes "……很好。让它们来吧。我想一个人死在这里。";
			next;
			mes "["+ .@player_name$ +"]";
		mes "你、你是伊戈尔吗？你在说什么？你疯了吗？";
			next;
			mes "["+ .@player_name$ +"]";
		mes "你知道你的恋人正在承受多少痛苦吗？";
			next;
			mes "[A gloomy looking soldier]";
		mes "我的……恋人……？";
			next;
			mes "["+ .@player_name$ +"]";
		mes "我带来了她的消息。她说不要再痛苦，要幸福地生活……";
			next;
			mes "["+ .@player_name$ +"]";
		mes "你越痛苦，她就越陷入悲伤。别以为只有你一个人在受苦……";
			next;
			mes "[A gloomy looking soldier]";
		mes "……斯维特兰娜？！";
		mes "等等，怎么可能……？她……我怎么知道她真的和你说过话？！";
			next;
		mes "-^0000ff 你一言不发地 ^000000-";
		mes "-^0000ff 把露莎卡的 ^000000-";
		mes "-^0000ff 金色耳环交给他 ^000000-";
			next;
			mes "[A gloomy looking soldier]";
		mes "这、这是斯维特兰娜的……？！";
		mes "你、你是怎么做到的！？";
			next;
			mes "["+ .@player_name$ +"]";
		mes "我偶然遇见了她。她在莫斯科比亚的沼泽中成为了露莎卡。";
			next;
			mes "["+ .@player_name$ +"]";
		mes "她说你不会相信我，所以把这对耳环作为证据交给我……这是你送给她的礼物。";
			next;
			mes "[A gloomy looking soldier]";
		mes "这是真的吗？";
		mes "她真的成为露莎卡了吗？";
			next;
			mes "[A gloomy looking soldier]";
		mes "那是在莫斯科比亚严冬即将结束时……她……没有意识到沼泽的冰已经开始融化……";
			next;
			mes "[A gloomy looking soldier]";
		mes "那时已经太晚了，她脚下的冰面裂开，掉进了冰冷的沼泽。";
			next;

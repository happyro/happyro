prontera,228,279,3	script	Wanderer#rus24	4_M_RUSMAN2,{
	if (rhea_rus_main < 8) {
		mes "[来自异乡的流浪者]";
		mes "嘿，这里有这么多冒险者。难怪这里是卢恩-米德加兹王国的首都！";
		next;
		mes "[来自异乡的流浪者]";
		mes "有空时来找我吧！这里的天气甚至比故乡最好的夏天还宜人。";
		close;
	} else if (rhea_rus_main == 8) {
		if (rhea_rus_hair < 3) {
			mes "[来自异乡的流浪者]";
			mes "嘿，这里有这么多冒险者。难怪这里是卢恩-米德加兹王国的首都！";
			next;
			mes "[来自异乡的流浪者]";
			mes "有空时来找我吧！这里的天气甚至比故乡最好的夏天还宜人。";
			close;
		} else if (rhea_rus_hair == 3) {
			if (getequipid(EQI_SHOES) != 2429 && getequipid(EQI_SHOES) != 2430) {
				mes "["+ strcharinfo(0) +"]";
			mes "……嗯，我是不是忘了穿什么……？";
				close;
			}
			mes "[来自异乡的流浪者]";
		mes "嘿，这里有这么多冒险者。难怪这里是卢恩-米德加兹王国的首都！";
			next;
			mes "[来自异乡的流浪者]";
		mes "有空时来找我吧！这里的天气甚至比故乡最好的夏天还宜人。";
			next;
			mes "["+ strcharinfo(0) +"]";
		mes "故乡？";
		mes "不好意思，我想问一下，你来自莫斯科比亚吗？";
			next;
			mes "[来自异乡的流浪者]";
		mes "哦，你怎么知道的？";
		mes "你以前去过那里吗？";
			next;
			mes "["+ strcharinfo(0) +"]";
		mes "啊，是的，我去过那里……";
		mes "顺便说，重要的是……你是不是……";
			next;
			input .@input$;
			if (.@input$ == "Igor") {
				mes "["+ strcharinfo(0) +"]";
		mes "啊，是的，我去过那里……";
		mes "顺便说，重要的是……你是不是……"+.@input$+"？";
				next;
			} else {
				mes "["+ strcharinfo(0) +"]";
		mes "啊，是的，我去过那里……";
		mes "顺便说，重要的是……你是不是……"+.@input$+"？";
				next;
				mes "[来自异乡的流浪者]";
		mes "嗯，不。";
		mes "我从没听过那个名字。";
				close;
			}
			mes "[来自异乡的流浪者]";
		mes "嗯，不。不过，这个名字听起来很熟悉。";
			next;
			mes "[来自异乡的流浪者]";
		mes "啊，对了！我怎么会忘记？";
			emotion ET_AHA;
			next;
			mes "[来自异乡的流浪者]";
		mes "我们一起从莫斯科比亚来到这里。他自称 Igg。我和他一起来的，但很久以前就分开了。他因为无法忘记失去的恋人而悲伤。";
			next;
			mes "["+ strcharinfo(0) +"]";
		mes "啊，那一定是伊戈尔。";
		mes "我正在找他！";
		mes "你知道他现在在哪里吗？";
			next;
			mes "[来自异乡的流浪者]";
		mes "嗯，我不知道他";
		mes "确切在哪里。";
		mes "不过，他曾告诉我";
		mes "想去一个沙漠。";
		mes "也许你可以去那里找找。";
			rhea_rus_hair = 4;
			// changequest 8150,8151;
			close;
		} else if (rhea_rus_hair > 3 && rhea_rus_hair < 7) {
			mes "[来自异乡的流浪者]";
		mes "他自称 Igg。我和他一起来的，但很久以前就分开了。他因为无法忘记失去的恋人而悲伤。";
			next;
			mes "[来自异乡的流浪者]";
		mes "嗯，我不知道他";
		mes "确切在哪里。";
		mes "不过，他曾告诉我";
		mes "想去一个沙漠。";
		mes "也许你可以去那里找找。";
			close;
		}
	}
	mes "[来自异乡的流浪者]";
	mes "我应该去哪里？你和他一起去过什么地方？";
	next;
	mes "[来自异乡的流浪者]";
	mes "想起来后告诉我。";
	close;
}


morocc,165,82,0	script	Morocc Villager#rus25	1_M_02,{
	if (rhea_rus_main < 8) {
		mes "[Morocc Villager]";
		mes "嗯，最近越来越多冒险者定居这里，很难分辨谁是村民、谁是冒险者。";
		next;
		mes "[Morocc Villager]";
		mes "但像我这样的本地人能分辨出来。";
		close;
	} else if (rhea_rus_main == 8) {
		if (rhea_rus_hair < 4) {
			mes "[Morocc Villager]";
			mes "嗯，最近越来越多冒险者定居这里，很难分辨谁是村民、谁是冒险者。";
			next;
			mes "[Morocc Villager]";
			mes "但像我这样的本地人能分辨出来。";
			close;
		} else if (rhea_rus_hair == 4) {
			if (getequipid(EQI_SHOES) != 2429 && getequipid(EQI_SHOES) != 2430) {
				mes "["+ strcharinfo(0) +"]";
			mes "……嗯，我是不是忘了穿什么……？";
				close;
			}
			mes "[Morocc Villager]";
			mes "嗯，最近越来越多冒险者定居这里，很难分辨谁是村民、谁是冒险者。";
			next;
			mes "[Morocc Villager]";
			mes "但像我这样的本地人能分辨出来。";
			next;
			mes "[Morocc Villager]";
			mes "正如我所说，我喜欢这个村子。沙漠很热，卡普拉职员更热！！！*咳* *咳咳*！！";
			next;
			mes "[Morocc Villager]";
			mes "啊，但别误会！我咳嗽不是因为卡普拉职员。呃，是天气太热了……对……";
			next;
			mes "["+ strcharinfo(0) +"]";
			mes "……";
			mes "你到底在说什么？我在找一个人。";
			next;
			mes "[Morocc Villager]";
			mes "这里有这么多冒险者，我怎么记得所有人？你有那个人的外貌或特征吗？任何能帮我回忆的描述都行。";
			next;
			mes "["+ strcharinfo(0) +"]";
			mes "嗯……我不知道他长什么样，但他来自一个叫莫斯科比亚的地方。";
			next;
			mes "[Morocc Villager]";
			mes "啊，你说的是那个总是很悲伤、穿着古怪的男人吗？我就觉得他的口音不像本地人……";
			next;
			mes "[Morocc Villager]";
			mes "他几天前还在这里，但后来去了金字塔。我之后再也没见过他。我说那里很危险，可他还是去了。";
			next;
			mes "[Morocc Villager]";
			mes "没错，那一定就是你要找的人。我仿佛还能看见他阴郁的脸……那个可怜的悲伤男人。";
			rhea_rus_hair = 5;
			// changequest 8151,8152;
			close;
		} else if (rhea_rus_hair > 4 && rhea_rus_hair < 7) {
			mes "[Morocc Villager]";
			mes "他几天前还在这里，但后来去了金字塔。我之后再也没见过他。我说那里很危险，可他还是去了。";
			next;
			mes "[Morocc Villager]";
			mes "没错，那一定就是你要找的人。我仿佛还能看见他阴郁的脸……那个可怜的悲伤男人。";
			close;
		}
	}
	mes "[Morocc Villager]";
	mes "村里有许多旅行者，看见他们让我觉得很开心。虽然我人在这里，却感觉自己环游了全世界。";
	close;
}


	mes "有^4d4dff拉弗乐奇诺、莫拉臀茶、莫拉柑橘和莫拉莓^000000。商品可能售罄。";
		next;
		if (select("查看物品。:取消。") == 1) {
			mes "[Cocktail Master]";
			mes "如果什么都没有，说明卖完了。明天再来。";
			close2;
			callshop "para_mora10";
			end;
		}
		mes "[Cocktail Master]";
		mes "感谢你来访。";
		close;
	} else { // holiday
		mes "[Cocktail Master]";
		mes "想购买特别的莫拉饮料吗？";
		mes "很遗憾，我们只在周末制作饮料。请在^4d4dff周五、周六或周日^000000再来。";
		mes "石榴，卖这个和那个。";
		close;
	}
}


// Forge
// Hans of the miner coalition
paramk,49,103,3	script	Hans #ref01	1_M_SIGNMCNT,{
	if ($event_paramk > 3) {
		mes "[Hans]";
		mes "我们出售联盟开采的金属矿石。";
		mes "如果你需要铁、钢、煤或铁矿石，请看看。";
		next;
		if (select("查看矿石。:取消。") == 1) {
			mes "[Hans]";
			mes "如果这里什么都没有，就说明卖完了。";
			mes "我们每天开采铁、钢、煤和铁矿石，明天再来吧。";
			close2;
			callshop "para_ref10";
			end;
		}
		mes "[Hans]";
		mes "铁、钢、煤等基础金属每天都会补货。";
		mes "请记住这一点。";
		close;
	} else { // holiday
		mes "[Hans]";
		mes "今天休息。";
		mes "我正要去矿山。";
		mes "需要什么就明天再来。";
		close;
	}
}

// Dus the Smith
paramk,53,104,3	script	Dus the Smith#ref02	2_M_OLDBLSMITH,{
	if ($event_paramk > 3) {
		mes "[Dus the Smith]";
	mes "这里有奥利德奥、铝和砧。";
	mes "数量不多，但都是手工制作的。";
		next;
		if (select("查看物品。:取消。")) {
			mes "[Dus the Smith]";
		mes "不确定还剩多少。";
		mes "如果有剩余，请购买。";
			close2;
			callshop "para_ref20";
			end;
		}
		mes "[Dus the Smith]";
	mes "稀有矿石难以获得，也很难精炼。";
	mes "所以库存有限。";
		close;
	} else { // holiday
		mes "[Dus the Smith]";
	mes "啊，客人？";
	mes "抱歉，今天不卖矿石。";
		next;
		mes "[Dus the Smith]";
	mes "你看，这些东西很难制作。";
	mes "你问我们卖什么？";
	mes "啊，我们这里卖奥利德奥、铝和砧。";
		next;
		mes "[Dus the Smith]";
	mes "需要稀有矿石或砧，就在周末来吧。";
	mes "周六下午晚些时候最合适。";
		close;
	}
}



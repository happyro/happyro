// Aurora
paramk,69,102,3	script	Aurora#jew01	4_F_02,{
	if ($event_paramk > 0) {
		mes "[Aurora]";
		mes "欢迎~";
		mes "这里是“宝石之雨”。我们出售纯金以及玫瑰石等未切割宝石！";
		mes "我们出售黄金、蛋白石、金云母、白云母等。";
		mes "它们稀有且难以获得，所以价格昂贵！";
		next;
		switch (select("查看物品。:出售物品。:取消。")) {
		case 1:
			mes "[Aurora]";
			mes "如果什么都看不到，就说明全部售罄了！";
			mes "感谢光临~！";
			close2;
			callshop "para_jew10";
			end;
		case 2:
			mes "[Aurora]";
			mes "我们会以合理价格收购。";
			close2;
			callshop "para_fod01",2;
			end;
		case 3:
			mes "[Aurora]";
			mes "我们经营黄金、金云母、玛瑙和绿松石等商品。";
			mes "但未切割宝石很稀有。";
			next;
			mes "[Aurora]";
			mes "我们从矿山采购，但供应有限~";
			mes "每周都会补货，时机合适的话……也许能买到？哈哈。";
			close;
		}
	} else { // holiday
		mes "[Aurora]";
		mes "啊，抱歉你今天来了。";
		mes "我们的市场集团周三不营业。";
		mes "我们需要时间补货、检查库存，当然也需要休息。";
		next;
		mes "[Aurora]";
		mes "如果你明天来，我们很乐意提供能让武器更强大的各种商品！";
		close;
	}
}



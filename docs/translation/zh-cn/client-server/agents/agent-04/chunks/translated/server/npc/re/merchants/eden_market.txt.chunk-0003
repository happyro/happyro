	next;
	mes "[Jeffrey]";
	mes "我做了几道菜让抱怨的客人闭嘴，但事情失控了！";
	close;

OnTimer30000:
	npctalk "我说清楚！我不是厨师！别等着上菜！我不会再做任何菜了！";
	initnpctimer;
	end;

OnInit:
	initnpctimer;
	end;
}


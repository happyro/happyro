// Sobok the Cook
paramk,127,88,3	script	Sobok the Cook#fd01	4_M_CHNCOOK,{
	mes "[Sobok]";
	mes "我叫 Sobok，来自 Sobokru，伊甸市场集团的主餐馆。";
	mes "要点餐吗？每道菜 3000 Zeny，周末特餐 5000 Zeny。";
	next;
	switch( select("鹅汤。:通心粉。:周末特餐。:取消。") ) {
	case 1:
		.@hp = 100;
		.@sp = 0;
		.@zeny = 3000;
		.@talk$ = "鹅汤会为你解毒并恢复生命。";
		break;
	case 2:
		.@hp = 0;
		.@sp = 100;
		.@zeny = 3000;
		.@talk$ = "通心粉会让你精神焕发。";
		break;
	case 3:
		.@hp = 100;
		.@sp = 100;
		.@zeny = 5000;
		.@talk$ = "身心的完美组合。";
		break;
	case 4:
		mes "[Sobok]";
	mes "有空再来。";
		close;
	}
	mes "[Sobok]";
	mes .@talk$;
	next;
	if (select("是:否") == 2)
		close;
	if (Zeny < .@zeny) {
		mes "[Sobok]";
	mes "你以为可以免费吃吗？？";
		close;
	}
	mes "[Sobok]";
	mes "很好吃，对吧？";
	Zeny -= .@zeny;
	percentheal(.@hp, .@sp);
	close;
}


// Cafe Mora
// Pomegranate
paramk,75,86,3	script	Pomegranate#mora01	4_F_RAFLE_PK,{
	mes "[Pomegranate]";
	mes "来吧，快点！";
	mes "问这是哪里？这里是永远营业的莫拉咖啡馆。";
	mes "石榴卖这个，也卖那个。";
	next;
	switch (select("查看商店。:你为什么这样说话？:还有别的吗？")) {
	case 1:
		mes "[Pomegranate]";
		mes "有！莫拉村的树液！";
		mes "卖！牛肉吐司。";
		mes "好吃。牛肉吐司。很多。好~";
		mes "石榴！";
		close2;
		callshop "para_mora01",1;
		end;
	case 2:
		mes "[Pomegranate]";
		mes "你不懂莫拉语。";
		mes "石榴。懂。人类语言。";
		mes "石榴，太厉害了。";
		mes "学习过。非常努力！";
		close;
	case 3:
		mes "[Pomegranate]";
		mes "出售。老板。周五、周六、周日。";
		mes "好吃。鲜榨水果。莫拉最好！";
		close;
	}
}

// Cocktail Master
paramk,65,86,3	script	Cocktail Master#mora01	4_M_RAFLE_VI,{

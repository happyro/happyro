// Port Malaya Transportation
//============================================================
// Old coordinates: alberta (237,71)
alberta,196,202,3	script	Optamara Crew#alberta	100,{
	mes "[Optamara Crew]";
	mes "嘿，你好！";
	mes "前往马来港需要10,000 Zeny。感兴趣吗？";
	next;
	switch(select("关于马来港。：前往马来港。：取消。")) {
	case 1:
		mes "[Optamara Crew]";
		mes "马来港是一个小村庄，从阿尔伯特向西南航行即可抵达。";
		next;
		mes "[Optamara Crew]";
		mes "之前村里有些问题，我没能去那里，但现在似乎都解决了！";
		next;
		mes "[Optamara Crew]";
		mes "我不太确定，但那是个像舒适温馨公园一样的村庄。";
		next;
		mes "[Optamara Crew]";
		mes "我差点就不再回到舒适的阿尔伯特了。";
		next;
		mes "[Optamara Crew]";
		mes "我相信你到了马来港也会有同样感受。";
		close;
	case 2:
		if (Zeny < 10000) {
			mes "[Optamara Crew]";
			mes "天哪！！";
			mes "你不知道那里离这里多远。当然不是免费的。请带10,000 Zeny回来。抱歉！";
			close;
		}
		mes "[Optamara Crew]";
		mes "太好了！";
		mes "出发前往马来港！！";
		set Zeny, Zeny-10000;
		close2;
		warp "malaya",271,55;
		end;
	case 3:
		mes "[Optamara Crew]";
		mes "现在的冒险者都一副很忙的样子。有时间再来，我们可以一起去马来港。";
		close;
	}
}

malaya,276,55,4	script	Optamara Crew#malaya	100,{
	if (malaya_hi < 10) {
		mes "[Optamara Crew]";
		mes "我想村子仍然很忙。参观完了吗？总有船开往阿尔伯特。";
		next;
	} else if (malaya_hi < 20) {
		mes "[Optamara Crew]";
		mes "我想是某位无名冒险者帮村民解决了烦恼。耶！要回阿尔伯特吗？";
		next;
	} else {
		mes "[Optamara Crew]";
		mes "要和我一起回阿尔伯特吗？";
		next;
	}
	switch(select("返回。：不返回。")) {
	case 1:
		mes "[Optamara Crew]";
		mes "太好了！我们现在就出发去艾尔贝塔！！";
		close2;
		warp "alberta",192,217;
		end;
	case 2:
		mes "[Optamara Crew]";
		mes "没关系。想回阿尔伯特时再来这里。";
		close;
	}
}

// Generic Port Malaya NPCs
//============================================================
ma_in01,30,94,4	script	Inn Keeper#ma	583,{
	if (malaya_hi < 10) {
		mes "[Inn Keeper]";
		mes "哦呀！来参观吗？";
		mes "真不巧。村子现在有点混乱，所以我暂时歇业。抱歉。";
		close;
	} else if (malaya_hi < 20) {
		mes "[Inn Keeper]";
		mes "你就是村民们谈论的冒险者？多亏了你，我重新开了旅馆。谢谢。";
		next;
	} else {
		mes "[Inn Keeper]";
		mes "欢迎。";
		mes "这里是马来港最好的旅馆“城市小屋”。";
		next;
	}
	mes "[Inn Keeper]";
	mes "来休息吗？住宿费是5,000 Zeny。";
	next;
	switch(select("寄存。：住宿。- 5,000z：取消。")) {
	case 1:
		mes "[Inn Keeper]";
		mes "寄存成功。下次见。";
		savepoint "ma_in01",43,98,1,1;
		close;
	case 2:
		if (Zeny < 5000) {
			mes "[Inn Keeper]";
			mes "抱歉，你的钱似乎不够。";
			close;
		}
		mes "[Inn Keeper]";
		mes "希望你住得愉快。";
		close2;
		set Zeny, Zeny-5000;
		percentheal 100,100;
		warp "ma_in01",43,98;
		end;
	case 3:
		close;
	}
}

-	script	Unidentified Creature#i	-1,{
	end;
OnInit:
	switch(atoi(strnpcinfo(2))) {
		case 1: setarray .@npc$,"01","02","03","04"; break;
		case 5: setarray .@npc$,"05","06","07","08"; break;
		case 9: setarray .@npc$,"09","10","11"; break;
		default: end;
	}
	set .@size, getarraysize(.@npc$);
	set .@rand, rand(.@size);
	for(set .@i,0; .@i<.@size; set .@i,.@i+1)
		donpcevent "Unidentified Creature#"+.@npc$[.@i]+"::"+((.@i == .@rand)?"OnEnable":"OnDisable");
	end;
OnEnable:
	enablenpc();
	end;
OnDisable:
	disablenpc();
	end;
OnBingx2:
	switch(atoi(strnpcinfo(2))) {
		case 1: setarray .@npc$,"02","03","04"; break;
		case 5: setarray .@npc$,"06","07","08"; break;
		case 9: setarray .@npc$,"10","11"; break;
	}
	set .@size, getarraysize(.@npc$);
	set .@rand, rand(.@size);
	for(set .@i,0; .@i<.@size; set .@i,.@i+1)
		donpcevent "Unidentified Creature#"+.@npc$[.@i]+"::"+((.@i == .@rand)?"OnEnable":"OnDisable");
	donpcevent strnpcinfo(0)+"::OnDisable";
	end;
OnTouch_:
	if (getcharid(1)) {
		if ($ma_name04$ == strcharinfo(0) || $ma_name05$ == strcharinfo(0) || $ma_name06$ == strcharinfo(0)) {
			donpcevent strnpcinfo(0)+"::OnBingx2";
			mes "未确认的生物瞥见你，脸红后消失了。";
			close;
		}
		if (rand(1,5)%2) {
			switch(atoi(strnpcinfo(2))) {
				case 1: set $ma_name04$,strcharinfo(0); break;
				case 5: set $ma_name05$,strcharinfo(0); break;
				case 9: set $ma_name06$,strcharinfo(0); break;
			}
		}
		donpcevent strnpcinfo(0)+"::OnBingx2";
		mes "未确认的生物瞥见你后消失了。";
		close;
	}
	donpcevent strnpcinfo(0)+"::OnBingx2";
	mes "未确认的生物看了你一眼就跑开了。";
	close;
}
ma_fild01,74,367,6	duplicate(Unidentified Creature#i)	Unidentified Creature#01	572,2,2
ma_fild02,282,41,4	duplicate(Unidentified Creature#i)	Unidentified Creature#05	572,2,2
ma_scene01,195,92,4	duplicate(Unidentified Creature#i)	Unidentified Creature#09	572,2,2

-	script	Unidentified Creature#j	-1,{
	end;
OnEnable:
	enablenpc();
	end;
OnDisable:
	disablenpc();
	end;
OnBingx2:
	switch(atoi(strnpcinfo(2))) {
		case 2: setarray .@npc$,"01","03","04"; break;
		case 3: setarray .@npc$,"01","02","04"; break;
		case 4: setarray .@npc$,"01","02","03"; break;
		case 6: setarray .@npc$,"05","07","08"; break;
		case 7: setarray .@npc$,"05","06","08"; break;
		case 8: setarray .@npc$,"05","06","07"; break;
		case 10: setarray .@npc$,"09","11"; break;
		case 11: setarray .@npc$,"09","10"; break;
	}
	set .@size, getarraysize(.@npc$);
	set .@rand, rand(.@size);
	for(set .@i,0; .@i<.@size; set .@i,.@i+1)
		donpcevent "Unidentified Creature#"+.@npc$[.@i]+"::"+((.@i == .@rand)?"OnEnable":"OnDisable");
	donpcevent strnpcinfo(0)+"::OnDisable";
	end;
OnTouch_:
	set .@i, atoi(strnpcinfo(2));
	if (.@i%4 == 2) {
		if (is_party_leader() == true)
			set .@pass,1;
	} else if (.@i%4 == 3) {
		if (checkquest(4229,PLAYTIME) > -1 && checkquest(9223,PLAYTIME) > -1 && checkquest(12278,PLAYTIME) > -1)
			set .@pass,1;
	} else if (.@i%4 == 0) {
		if (rand(1,100)%10 == 7)
			set .@pass,1;
	}
	if (.@pass) {
		if ($ma_name04$ == strcharinfo(0) || $ma_name05$ == strcharinfo(0) || $ma_name06$ == strcharinfo(0)) {
			donpcevent strnpcinfo(0)+"::OnBingx2";
			mes "未确认的生物瞥见你，脸红后消失了。";
			close;
		}
		if (rand(1,5)%2) {
			switch(.@i) {
			case 2:
			case 3:
			case 4:
				set $ma_name04$,strcharinfo(0);
				break;
			case 6:
			case 7:
			case 8:
				set $ma_name05$,strcharinfo(0);
				break;
			case 10:
			case 11:
				set $ma_name06$,strcharinfo(0);
				break;
			}
		}
		donpcevent strnpcinfo(0)+"::OnBingx2";
		mes "未确认的生物瞥见你后消失了。";
		close;
	}
	donpcevent strnpcinfo(0)+"::OnBingx2";
	mes "未确认的生物看了你一眼就跑开了。";
	close;
}

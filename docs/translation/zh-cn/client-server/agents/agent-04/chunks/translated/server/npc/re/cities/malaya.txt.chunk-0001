malaya,227,311,4	script	Grandma#ma01	575,{
	if (malaya_hi < 10) {
		mes "[奶奶]";
		mes "你不是本地人？请照顾好自己。";
		next;
		mes "[Grandma]";
		mes "我很担心，因为我的儿媳怀孕了。希望一切顺利。";
		close;
	} else if (malaya_hi < 20) {
		mes "[Grandma]";
		mes "我听说有个外乡人在帮助村子。";
		next;
		mes "[Grandma]";
		mes "那我的儿媳就安全了。";
		close;
	}
	if (rand(1,3) == 2) {
		mes "[Grandma]";
		mes "听说有个叫"+getd("$ma_name0"+rand(1,6)+"$")+"的人一直跟着米奥嫩叔叔。";
		next;
		mes "[Grandma]";
		mes "我会为他们的禁忌之爱加油。";
		close;
	}
	mes "[奶奶]";
	mes "我很担心怀孕的儿媳。希望米奥嫩叔叔不会打扰她。";
	next;
	select("米奥嫩叔叔？");
	mes "[奶奶]";
	mes "不是本地人？让我告诉你为什么连你这样的外乡人也要小心。";
	next;
	mes "[奶奶]";
	mes "米奥嫩叔叔是很久以前住在马来港的女人。她嫁给了一个好男人，还生了孩子。";
	next;
	mes "[奶奶]";
	mes "但幸福不会永远持续，对吧？孩子因意外流产了……";
	next;
	mes "[奶奶]";
	mes "她因失去孩子而悲伤多日，最终去世。";
	next;
	select("真是悲伤的故事。");
	mes "[奶奶]";
	mes "从那以后，米奥嫩叔叔开始以灵体出现，带走村里孕妇的孩子。";
	next;
	mes "[奶奶]";
	mes "如果你夜里在马来港徘徊……";
	next;
	mes "[奶奶]";
	mes "听到滴滴或哇哇声，要小心，那是米奥嫩叔叔翅膀扇动的声音。";
	close;
}

malaya,189,263,4	script	Drumming Young Man#ma02	578,{
	if (malaya_hi < 10) {
		emotion ET_HUK;
		mes "[Drumming Young Man]";
		mes "呃……就像上次一样……";
		next;
		emotion ET_HUK;
		mes "[Drumming Young Man]";
		mes "月亮被吞掉的时候。啊！";
		close;
	} else if (malaya_hi < 20) {
		mes "[Drumming Young Man]";
		mes "我想村子是被一位无名冒险者拯救的。";
		next;
		emotion ET_OHNO;
		mes "[Drumming Young Man]";
		mes "呼……我还以为巴科纳瓦又出现了。";
		close;
	}
	if (rand(1,3) == 2) {
		mes "[Drumming Young Man]";
		mes getd("$ma_name0"+rand(1,6)+"$")+" 据说阻止了巴贡纳瓦吞下月亮。很厉害吧？我松了口气。";
		close;
	}
	mes "[打鼓的年轻人]";
	mes "在马来港，巴科纳瓦也被称为“吞月怪物”。";
	next;
	mes "[打鼓的年轻人]";
	mes "但我知道巴科纳瓦也会“吞人”。";
	next;
	select("呼！那不是很危险吗？");
	emotion ET_KIK;
	mes "[打鼓的年轻人]";
	mes "哈哈哈。有办法阻止巴科纳瓦吞人。";
	next;
	mes "[打鼓的年轻人]";
	mes "是的，即使是已经吞下六个月亮的最可怕魔物，也有弱点。";
	next;
	select("哇，是什么？");
	mes "[打鼓的年轻人]";
	mes "它对噪音很敏感，所以在它要吞下月亮时！！";
	next;
	mes "[打鼓的年轻人]";
	mes "那就是你的机会！！什么声音都可以！！无论是大锅、铜钹、鼓、锅还是煎锅，只管不停制造噪音。";
	next;
	mes "[Drumming Young Man]";
	mes "这样巴科纳瓦就会受到惊吓，吐出月亮逃走！";
	next;
	mes "[Drumming Young Man]";
	mes "随身带一面鼓吧。你会发现它很方便。";
	close;
}

malaya,270,59,4	script	Port Guard#ma03	570,{
	if (malaya_hi < 10) {
		emotion ET_PROFUSELY_SWEAT;
		mes "[港口卫兵]";
		mes "村子最近一团混乱。我这样离开岗位真的没问题吗？";
		close;
	} else if (malaya_hi < 20) {
		emotion ET_STARE_ABOUT;
		mes "[港口卫兵]";
		mes "村子现在稍微稳定了些，但你晚上走动时还是要小心。";
		close;
	}
	if (rand(1,3) == 2) {
		mes "[港口卫兵]";
		mes getd("$ma_name0"+rand(1,6)+"$")+" 据说被布瓦亚抓住后还能活着逃脱。这个人一定很强。";
		close;
	}
	emotion ET_HUK;
	mes "[港口卫兵]";
	mes "什么！！港口一切正常！！";
	next;
	mes "[港口卫兵]";
	mes "嗯？你不是船长？吓我一跳。可恶！啊，对了！我收到了一份给旅客的官方文件。";
	next;
	select("什么文件？");
	mes "[港口卫兵]";
	mes "上面说旅客晚上在村里行走时要小心魔物。";
	next;
	mes "[港口卫兵]";
	mes "布瓦亚不常来村子，但有时会在夜里把人抓进它们携带的箱子里。";
	next;
	mes "[港口卫兵]";
	mes "嗯？！这里还说，有一种叫沃克沃克的魔物经常在夜里来村子，应该避开它。";
	next;
	switch(select("我明白了。:有什么办法防止它们来吗？")) {
	case 1:
		mes "[港口卫兵]";
		mes "晚上要小心！";
		close;
	case 2:
		mes "[港口卫兵]";
		mes "据说如果被抓进布瓦亚携带的箱子，可以攻击箱内布瓦亚的弱点。";
		next;
		mes "[港口卫兵]";
		mes "从远处听到沃克沃克翅膀扇动时，你应该跑进最近的建筑。";
		next;
		emotion ET_SCRATCH;
		mes "[港口卫兵]";
		mes "但如果扇动声很小，或者什么也听不到，那就做好迎战准备，祈求好运吧。";
		close;
	}
}

malaya,88,252,4	script	Little Girl#ma04	576,{
	if (malaya_hi < 10) {
		mes "[小女孩]";
		mes "我很害怕，但必须去森林拜访精灵。";
		close;
	} else if (malaya_hi < 20) {
		mes "[小女孩]";
		mes "嘿嘿。爸爸说，等村子平静下来后我就能去森林拜访精灵。";
		close;
	}
	if (rand(1,3) == 2) {
		set .@name$, getd("$ma_name0"+rand(1,6)+"$");
		mes "[小女孩]";
		mes "刚才"+.@name$+"来给我讲了一个有趣的故事。";
		next;
		mes "[小女孩]";
		mes "‘我在院子里种了一对梨树。’";
		mes "嘿嘿。很有趣吧？"+.@name$+"看起来是个有趣的人。";
		close;
	}
	mes "[小女孩]";
	mes "爸爸说，只要和森林里的精灵成为朋友，我就不会得皮肤病。";
	next;
	select("这是什么精灵？");
	mes "[小女孩]";
	mes "恩坎托！恩坎托精灵住在森林里的大树或岩石中。有男精灵和女精灵……";
	next;
	mes "[小女孩]";
	mes "但男精灵更漂亮。这是为什么呢？";
	close;
}

malaya,219,92,6	script	Little Kid#ma05	577,{
	if (malaya_hi < 10) {
		mes "[小孩子]";
		mes "妈妈说外面很危险，不让我出去玩。为什么？";
		close;
	} else if (malaya_hi < 20) {
		mes "[小孩子]";
		mes "妈妈说我可以玩，但只能在马来港玩。";
		next;
		mes "[小孩子]";
		mes "嘿嘿。不过我从没想过离开马来港。";
		close;
	}
	if (rand(1,3) == 2) {
		mes "[小孩子]";
		mes "我听说有人在神奇村拿走了杰杰灵的帽子。";
		next;
		mes "[小孩子]";
		mes "为什么有人要偷魔物的帽子？"+getd("$ma_name0"+rand(1,6)+"$")+"一定是走投无路了。";
		next;
		mes "[小孩子]";
		mes "等等！这本来应该是秘密。嘘！请假装没听见。";
		close;
	}
	mes "[小孩子]";
	mes "我觉得有人正在偷走村子里的所有帽子。";
	next;
	mes "[小孩子]";
	mes "妈妈昨天洗的帽子不见了。邻居的帽子几天前也不见了。";
	next;
	mes "[小孩子]";
	mes "嗯……你觉得是杰杰灵拿走的吗？";
	next;
	mes "[小孩子]";
	mes "我去神奇村拜访朋友，他说看到杰杰灵戴着那顶失踪的帽子……";
	close;
}

				mes "……我现在到底在做什么……";
				close;
			}
			if (rand(1,4) == 2) {
				mes "- 你挖开一堆泥土 -";
				mes "- 并挖出 "+ .@color$ +" 宝石 -";
				setquest 8240+.@num;
				getitem 7574+.@num,1;
				close;
			}
			else {
				mes "- 你挖开一堆泥土时，-";
				mes "- 盗虫袭击了你！ -";
				donpcevent "Half-buried Gem#"+ .@num +"::OnDisable";
				next;
				mes "["+ strcharinfo(0) +"]";
				mes "这到底是什么？！？！？！";
				close;
			}
		}
		else {
			mes "- 小土堆 -";
			mes "- 你从这里挖出了"+ .@color$ +" 宝石 -";
			close;
		}
	}
	else {
		mes "- 小土堆 -";
		mes "- 你从这里挖出了"+ .@color$ +" 宝石 -";
		close;
	}
	end;
}


man_in01,372,221,5	script	Scientist#lifeguard	449,{
	if ((isequipped(2782) == 1) && (ep13_2_rhea == 100)) {
		mes "[救生博士]";
		if (ep13_2_tre == 0) {
			mes "最近我的皮肤似乎变得很干燥。";
			next;
			mes "[救生博士]";
			mes "不知道是寒冷天气导致，还是慢性病恶化。";
			mes "我们注射钙矿没多久，为什么会这样。";
			next;
			mes "[救生博士]";
			mes "呼……我们害怕这种事……生活真艰难。";
			next;
			select("A chronic disease?:Bradium?");
			mes "[救生博士]";
			mes "我们萨帕，是赫韦格尔密尔的后裔，在尤弥尔之血的洪流中幸存并重建了巨人族。";
			next;
			mes "[救生博士]";
			mes "不知为何，我们患上慢性病，身体会像老树一样逐渐干燥硬化。";
			next;
			mes "[救生博士]";
			mes "我认为这是被众神放血的尤弥尔的诅咒。";
			next;
			mes "[救生博士]";
			mes "但我们不能坐等死亡慢慢逼近并灭绝全族。";
			next;
			mes "[救生博士]";
			mes "为治愈这种罕见疾病，最聪明的萨帕不断研究。";
			next;
			mes "[救生博士]";
			mes "他们发现注射埋在约顿海姆周围的精炼布拉迪姆，可以延缓疾病进展。";
			next;
			mes "[救生博士]";
			mes "因此萨帕巨人在矿场周围建立城镇，以便获取布拉迪姆。";
			next;
			mes "[救生博士]";
			mes "埋藏的钙矿数量似乎足够。";
			mes "但为部族永恒繁荣、制造这种不治之症的疫苗，我们必须继续研究。";
			next;
			mes "[救生博士]";
			mes "布拉迪姆是我们的生命根基。";
			mes "但埋藏的布拉迪姆终会耗尽，所以科学家必须为后代寻找替代品。";
			next;
			mes "[救生博士]";
			mes "最近我们得知人类世界米德加尔特有各种矿物。";
			next;
			mes "[救生博士]";
			mes "如今名为米德加尔特的世界";
			mes "对我们像圣地，";
			mes "能带来";
			mes "改变的风。";
			next;
			mes "[救生博士]";
			mes "与米德加尔特接触";
			mes "一定是赫韦格尔密尔的引导，";
			mes "对我们这些";
			mes "封闭社会的萨帕来说。";
			next;
			mes "[救生博士]";
			mes "我会得出能令他满意的";
			mes "结果！";
			set ep13_2_tre,1;
			close;
		}
		else if ((ep13_2_tre == 1) || (ep13_2_tre == 100)) {
			if (checkweight(1201,1) == 0) {
				mes "看来你携带的东西太多。";
				mes "把一些物品存起来再回来吧。";
				close;
			}
			set .@dayq_chk,checkquest(2182,PLAYTIME);
			if ((.@dayq_chk == 0) || (.@dayq_chk == 1)) {
				mes "萨帕的未来取决于你。";
				mes "现在暂时不需要你的帮助。";
				close;
			}
			else {
				erasequest 2182;
				switch(rand(1,3)) {
					case 1: setarray .@rand_dayq$[0],"Mt. Mjolnir","10","2"; break;
					case 2: setarray .@rand_dayq$[0],"Abyss Lake","5","3"; break;
					case 3: setarray .@rand_dayq$[0],"Thor Volcano","5","4"; break;
				}
				mes "最近，一位来自施瓦茨瓦尔德的人看到我们研究钙矿，送给我一小块家乡矿物。";
				next;
				mes "[救生博士]";
				mes "现在还不能确定，";
				mes "但这种矿物似乎有许多有趣特性。";
				next;
				mes "[救生博士]";
				mes "我越研究这种矿物，越发现它";
				mes "和约顿海姆的矿物不同。";
				mes "它一定能帮助制造新疫苗！";
				next;
				mes "[救生博士]";
				mes "但矿物数量太少，";
				mes "无法准备实验。";
				next;
				mes "[救生博士]";
				mes "你说自己来自米德加尔特，对吧？能再带一些那种矿物给我吗……";
				next;
				mes "[救生博士]";
				mes "他说矿物来自";
				mes "^FF0000"+.@rand_dayq$[0]+"^000000.";
				mes "我想 ^FF0000"+.@rand_dayq$[1]+"^000000 就够了。";
				next;
				mes "[救生博士]";
				mes "我给你这个便携工具箱。";
				mes "里面有探测器和挖矿用的小锤子。";
				next;
				mes "[救生博士]";
				mes "拿着它，应该能帮助你";
				mes "收集我需要的矿物。";
				set ep13_2_tre,atoi(.@rand_dayq$[2]);
				setquest 2179+(atoi(.@rand_dayq$[2])-2);
				getitem 6076,1; //Portable_Toolbox
				close;
			}
		}
		else if (ep13_2_tre == 2 || ep13_2_tre == 3 || ep13_2_tre == 4) {
			if ((ep13_2_tre == 2 && countitem(6077) > 9) || (ep13_2_tre != 2 && countitem(6077) > 4)) {
				mes "哦！没错，就是这些！";
				mes "这些已经够了！";
				next;
				mes "[救生博士]";
				mes "非常感谢你的帮助。";
				next;
				mes "[救生博士]";
				mes "这是马努克硬币。";
				mes "虽然不多，但收集更多后可以从我们的商人处购买物品。";
				next;
				mes "[救生博士]";
				mes "如果想为萨帕帮助我的研究，随时来找我。";
				mes "你能提供任何帮助我都很高兴。";
				set .@stone_chk,countitem(6077);
				set .@stoneelse_chk,countitem(6078);
				delitem 6077,.@stone_chk; //Rough_Mineral
				delitem 6078,.@stoneelse_chk; //Stone_Fragments
				delitem 6076,1; //Portable_Toolbox
				getitem 6080,3; //Manuk_Coin
				//getexp 0,(checkre(3))?70000:700000; //iRO only
				changequest 2179+(ep13_2_tre-2),2182;
				set ep13_2_tre,100;
				close;
			}
			else {
				mes "萨帕的未来取决于你。";
				mes "祝你好运。";
				close;
			}
		}
		else {
			mes "嗯……";
			close;
		}
	}
	else {
		mes "[Scientist]";
		mes "Pdh doud pjfdd";
		mes "fo pdi Wrdpp doff";
		mes "WosNuffremu Ha TurAshTi";
		mes "SeGothShar An AshDur";
		mes "UorVeLars No Ador";
		close;
	}
}

function	script	find_13_2	{
	switch (getarg(0)) {
		case 0: setarray .@Check[0],2,10; set .@str$,"Mt. Mjolnir"; break;
		case 1: setarray .@Check[0],3,5; set .@str$,"Abyss Lake"; break;
		case 2: setarray .@Check[0],4,5; set .@str$,"Thor Volcano"; break;
	}
	if (ep13_2_tre != .@Check[0] || countitem(6076) != 1 || countitem(6077) >= .@Check[1]) end;
	mes "- 刚抵达"+.@str$+"。我想可以用便携工具箱里的矿物探测器找到矿物。 -";
	next;
	switch(select("Check current location.:Do nothing.")) {
		case 1:
			mes "- 你按下探测器按钮。 -";
			next;
			mes "[Mineral Detector]";
			mes "哔哔——";
			if (getarg(1)) return;
			next;
			mes "- 什么也没找到。 -";
			close;
		case 2:
			mes "- 你决定什么也不做。 -";
			close;
	}
}

-	script	mjo_no_find	-1,{
	end;


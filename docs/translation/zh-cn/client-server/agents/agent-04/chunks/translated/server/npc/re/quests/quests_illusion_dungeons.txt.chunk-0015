	end;
OnTouch:
	if (ill_turtle == 5 || ill_turtle == 6 || ill_turtle > 10)
		cloakoffnpcself( "Archeologist Leiphen#illtur02" );
	end;
}

tur_d04_i,26,167,5	script	Archeologist Leiphen#illtur02	2_M_ALCHE,{
	.@account_id = getcharid(3);
	.@player_name$ = strcharinfo(0);

	if (ill_turtle == 5) {
		unittalk .@account_id, "" + .@player_name$ + "：Leiphen 博士！你就是考古学家 Leiphen，对吧？", bc_self;
		mes "- ^424242那个人……我终于找到他了。^000000 -";
		next;
		emotion ET_SURPRISE, .@account_id;
		mes "[Archeologist Leiphen]";
		mes "天哪……人类，真人类？真正的人类？";
		mes "感谢神！谢谢你。我以为我要死在这里！";
		npctalk "考古学家 Leiphen：你怎么知道是我？", "", bc_self;
		sleep2 1000;
		unittalk .@account_id, "" + .@player_name$ + "：Aylvar 派我来找你。我是冒险者 " + .@player_name$ + "。", bc_self;
		next;
		mes "[Archeologist Leiphen]";
		mes "呼……如果没有 Aylvar 和 " + .@player_name$ + "，我可能已经死了。";
		mes "^FF0000我几天无法睡觉^000000和进食。我一直在四处游荡。";
		next;
		sleep2 1000;
		emotion ET_QUESTION, .@account_id;
		unittalk .@account_id, "" + .@player_name$ + "：我听说你失踪了半天……", bc_self;
		mes "-^424242好几天？真奇怪。^000000-";
		next;
		npctalk "考古学家 Leiphen：这座龟岛不是我们所知道的那座龟岛。", "", bc_self;
		mes "[Archeologist Leiphen]";
		mes "你听说 Aylvar 的消息了吗？我听到时有些犹豫。";
		mes "……Aylvar 对这里的判断是对的。";
		next;
		mes "[Archeologist Leiphen]";
		mes "我想研究很多东西，但现在最好先回去。";
		mes "我筋疲力尽，也没有工具进行充分推理。最好准备好后再回来。";
		next;
		unittalk .@account_id, "" + .@player_name$ + "：还要回到这里？", bc_self;
		mes "[Archeologist Leiphen]";
		mes "当然我必须回来。这是一个能发现龟岛历史新事实的地方。";
		next;
		unittalk .@account_id, "" + .@player_name$ + "：……你果然是个执着的学者。", bc_self;
		emotion ET_HNG;
		mes "[Archeologist Leiphen]";
		mes "我就当你是在夸我。";
		next;
		unittalk .@account_id, "" + .@player_name$ + "：那么你现在要回去吗？我带你出去……", bc_self;
		sleep2 1000;
		npctalk "Archeologist Leiphen : Stomach growling...", "", bc_self;
		emotion ET_SWEAT;
		mes "[Archeologist Leiphen]";
		mes "嗯……";
		mes "抱歉我饿了……现在动不了。";
		mes "如果可以，能在附近狩猎一些怪物吗？";
		next;
		sleep2 500;
		unittalk .@account_id, "" + .@player_name$ + "：你要我去狩猎？", bc_self;
		sleep2 1000;
		npctalk "考古学家 Leiphen：经过漫长的研究考察，我才能在调查地点吃上几顿饭。", "", bc_self;
		mes "[Archeologist Leiphen]";
		mes "本质上是乌龟，我可以吃，但无法独自狩猎，所以一直饿到现在……";
		mes "这里的怪物比我们熟悉的龟岛怪物强得多。拜托了？";
		next;
		if (select( "你想要哪种怪物？", "我觉得还是走吧。" ) == 1) {
			mes "[Archeologist Leiphen]";
			mes "……对不起，我动不了了。";
			mes "你能带我出去吗？";
			unittalk .@account_id, "" + .@player_name$ + "：……你要我狩猎多少只魔物？", bc_self;
		}
		else {
			mes "[Archeologist Leiphen]";
		mes "嗯，如果狩猎魔物太麻烦……你可以把我带出去……";
			unittalk .@account_id, "" + .@player_name$ + "：我去狩猎魔物。", bc_self;
		}
		emotion ET_FRET, .@account_id;
		next;
		mes "[Archeologist Leiphen]";
		mes "谢谢你接受。嗯，我觉得最好把这些魔物看作与龟岛不同的魔物。";
		next;
		mes "[Archeologist Leiphen]";
		mes "^0000CD" + getmonsterinfo("ILL_PERMETER", MOB_NAME) + "、" + getmonsterinfo("ILL_SOLIDER", MOB_NAME) + "、" + getmonsterinfo("ILL_FREEZER", MOB_NAME) + "、" + getmonsterinfo("ILL_HEATER", MOB_NAME) + "。^0000CD各 10 只。^000000拜托了。";
		mes "还有 ^0000CD肉^000000，^0000CD10 个^000000。";
		next;
		mes "[Archeologist Leiphen]";
		mes "同时我会生火。";
		mes "呼……我突然感到很吃力。我是考古学家，不是冒险故事里的英雄。";
		ill_turtle = 6;
		erasequest 16100;	// Stranger on Turtle Island 4
		setquest 16101;	// Emergency food procurement 1
		setquest 16102;	// Emergency food procurement 2
		close;
	}
	if (ill_turtle == 6) {
		if (checkquest(16101,HUNTING) != 2 || checkquest(16102,HUNTING) != 2 || countitem(7564) < 10) {
			npctalk "考古学家 Leiphen：哦，你回来了。我一直在等。", "", bc_self;
			unittalk .@account_id, "" + .@player_name$ + "：……真糟糕。Leiphen，猎到的魔物肉全都腐烂了。", bc_self;
			mes "[Archeologist Leiphen]";
			mes "糟糕……火没生好。我不能烧掉书或工具。";
			next;
			unittalk .@account_id, "" + .@player_name$ + "：无论猎多少，我得到的都是腐肉。", bc_self;
			mes "[Archeologist Leiphen]";
			mes "不会吧……全部？";
			mes "^0000CD" + getmonsterinfo("ILL_PERMETER", MOB_NAME) + "、" + getmonsterinfo("ILL_SOLIDER", MOB_NAME) + "、" + getmonsterinfo("ILL_FREEZER", MOB_NAME) + "、" + getmonsterinfo("ILL_HEATER", MOB_NAME) + "，^000000全部吗？";
			next;
			mes "[Archeologist Leiphen]";
			mes "……那么，让我先拿 ^0000CD10 个" + getitemname(7564) + "^000000 试试，^0000CD拜托了^000000。";
			mes "不嚼点东西吞下去，我就动不了……";
			npctalk "考古学家 Leiphen：或者你可以把我带出去……", "", bc_self;
			sleep2 1500;
			unittalk .@account_id, "" + .@player_name$ + "：让我再去多狩猎一些。", bc_self;
			close;
		}
		npctalk "考古学家 Leiphen：哦，你回来了，" + .@player_name$ + "。", "", bc_self;
		mes "[Archeologist Leiphen]";
		mes "糟糕。没有可燃物……所以无法生火。";
		next;
		sleep2 1000;
		unittalk .@account_id, "" + .@player_name$ + "：我按种类猎杀了魔物，但得到的全是腐肉。我只带来了" + getitemname(7564) + "。", bc_self;
		mes "[Archeologist Leiphen]";
		mes "真奇怪。你猎杀的是活着的魔物，为什么只得到腐肉？";
		mes "我不能烹饪腐肉，但可以试着吃！";
		sleep2 1500;
		npctalk "考古学家 Leiphen：嚼着……呸……？？！", "", bc_self;
		sleep2 2000;
		unittalk .@account_id, "" + .@player_name$ + "：糟糕，你还好吗？", bc_self;
		next;
		emotion ET_CRY;
		mes "[Archeologist Leiphen]";
		mes "呃……我吃不下。对不起……你白忙了……";
		next;
		mes "[Archeologist Leiphen]";
		mes "这里除了我和你没有别人，对吧？我在这里待了好几天，^FF0000却没见过任何人^000000。";
		mes "如果还有其他人，我可以请他们帮忙。";
		next;
		unittalk .@account_id, "" + .@player_name$ + "：嗯，我在这里见过一些人。", bc_self;
		sleep2 500;
		emotion ET_HUK;
		npctalk "Archeologist Leiphen : Really? Some people?", "", bc_self;
		mes "[Archeologist Leiphen]";
		mes "你见过其他人？哦，你应该早点告诉我。在哪里见到的？我们现在去谈谈吧！";
		mes "我想问他们一些事！";
		next;
		sleep2 500;
		unittalk .@account_id, "" + .@player_name$ + "：你说要我把你带出去……？", bc_self;
		sleep2 1000;
		unittalk .@account_id, "" + .@player_name$ + "：但是那里有些奇怪的人。我不确定我们能不能交谈……", bc_self;
		mes "[Archeologist Leiphen]";
		mes "我现在没事了！走吧！";
		next;
		mes "[Archeologist Leiphen]";
		mes "即使无法交谈，我也能通过观察人们的生活方式推断出一些事情。";
		mes "好，我们走！请带路！去最近的地方！";
		next;
		emotion ET_SCRATCH, .@account_id;
		mes "-^424242我不是说交谈那部分，不过还是走吧。";
		mes "去最近的地方……^FF0000去找那位饥饿的^424242女士。^000000-";
		delitem 7564,10;	// Rotten_Meat
		ill_turtle = 7;
		erasequest 16101;	// Emergency food procurement 1
		erasequest 16102;	// Emergency food procurement 2
		setquest 16103;	// The Secret of Strangers
		close;
	}
	if (ill_turtle == 7) {
		npctalk "考古学家 Leiphen：你说最近的地方就在这里附近？我没事了。带路吧！", "", bc_self;
		end;
	}
	if (ill_turtle > 10) {
		switch( isbegin_quest(16106) ) {
		case 0:
			npctalk "考古学家 Leiphen：如果 " + .@player_name$ + " 能安抚纠缠的灵魂，我希望有一天能和它们谈谈。谈谈这里……", "", bc_self;
			end;
		case 1:
			npctalk "考古学家 Leiphen：你好，" + .@player_name$ + "。", "", bc_self;
			mes "[Archeologist Leiphen]";
		mes "你今天又来了。";
			next;
			unittalk .@account_id, "" + .@player_name$ + "：你总是在这里。", bc_self;
			mes "[Archeologist Leiphen]";
		mes "正如我告诉你的，在找到这里的秘密前我不会离开。";
		mes "你是来找 Narin 的吗？";
			next;
			npctalk "考古学家 Leiphen：嗯，吃饭和睡觉的问题在艾尔帕兰解决了。我找到了不错的住处。", "", bc_self;
			sleep2 1000;
			unittalk .@account_id, "" + .@player_name$ + "：你没有课吗？", bc_self;
			mes "[Archeologist Leiphen]";
		mes "呃，我没告诉你。我正在休一年的假。";
			next;
			emotion ET_SWEAT, .@account_id;
			emotion ET_DELIGHT, .@account_id;
			unittalk .@account_id, "" + .@player_name$ + "：好吧……我们一起走？", bc_self;
			mes "[Archeologist Leiphen]";
		mes "走吧！";
			completequest 16106;	// A memory that should not be forgotten 1
			setquest 16107;	// A memory that should not be forgotten 2
			close;
		case 2:
			npctalk "考古学家 Leiphen：你要去龟岛见 Narin 吗？快走吧！", "", bc_self;
			end;
		}
		end;
	}
	end;

OnInit:
	cloakonnpc();

	questinfo( QTYPE_QUEST, QMARK_YELLOW, "ill_turtle == 5" );
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "ill_turtle == 6 && checkquest(16101,HUNTING) == 2 && checkquest(16102,HUNTING) == 2 && countitem(7564) > 9" );

	// daily
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "isbegin_quest(16106) == 1" );
	end;
}



// Warps
beach_dun2,248,254,4	script	#IL_Luanda	4_ENERGY_BLUE,{
	mes "这是一座散发柔和蓝光的图腾。";
	next;
	if (select( "触摸它", "离开" ) == 2)
		end;
	if (BaseLevel < 160) {
		mes "-你的等级太低，无法进入该区域。";
		close;
	}
	warp "com_d02_i",249,243;
	end;
}

com_d02_i,254,243,0	warp2	IL_Luanda#Luanda	1,1,beach_dun2,249,243


// Reward npc
com_d02_i,241,255,4	script	Defense Manager Luanda#Lu	4_M_THAIONGBAK,{
	if (BaseLevel < 160)	// shouldn't happen
		end;
	if (checkweight(1201,3) == 0) {
		mes "-你携带的物品太多，无法继续。-";
		close;
	}
	if (ill_luanda == 0) {
		emotion ET_QUESTION;
		mes "[Luanda]";
		mes "你是谁？";
		next;
		mes "[Luanda]";
		mes "啊！啊！啊！";
		mes "我听说他们因为没有足够人手保卫村子，所以雇佣冒险者。我想那就是你吧？";
		next;
		mes "[Luanda]";
		mes "对了，我是不是在哪里见过你？你的脸看起来莫名熟悉。";
		next;
		mes "[Luanda]";
		mes "糟糕，我没资格比较相似的脸……我们是双胞胎。哈哈哈。";
		next;
		mes "[Luanda]";
		mes "要不要打个招呼？很高兴见到你。我是 Luanda，这座洞窟的防卫负责人。";
		next;
		mes "[Luanda]";
		mes "简单任务我们准备了委托板，你可以在那里找到任务并向我报告。";
		next;
		mes "[Luanda]";
		mes "任务本身不必太难，你只需在洞窟里巡查，处理魔物或带回魔物产物。";
		next;
		mes "[Luanda]";
		mes "既然村子雇用了你，希望你努力工作，减轻一些负担。最近真的很辛苦。拜托了。";
		next;
		ill_luanda = 1;
		emotion ET_KIK;
		mes "[Luanda]";
		mes "那么，祝你玩得开心。冒险者。";
		close;
	}
	if (ill_luanda == 2) {	// first time (walk near any shadow npc)
		mes "[Luanda]";
		mes "怎么了，冒险者？";
		next;
		mes "你告诉 Luanda 你看到的奇怪闪光。";
		next;
		emotion ET_SCRATCH;
		mes "[Luanda]";
		mes "奇怪的闪光？如你所说，这确实是奇怪的现象。";
		next;
		mes "[Luanda]";
		mes "我在村子里生活了很久，却从没听说过这种现象。我猜它最近才开始发生。";
		next;
		mes "[Luanda]";
		mes "我不是一个人住在村里，如果有人见过，早就传开了。但这是我第一次听说，看来我的猜测没错。";
		next;
		mes "[Luanda]";
		mes "它可能很危险，所以如果你发现它，为什么不避开呢？没必要冒险。";
		next;
		ill_luanda = 3;
		getexp 1120000,650000;
		erasequest 5847;
		mes "你向 Luanda 报告并获得了经验。";
		close;
	}
	if (ill_luanda == 5) {	// MONDAY vortex 153/33
		mes "[Luanda]";
		mes "怎么了，冒险者？";
		next;
		mes "你告诉 Luanda 你遇到并交谈过的三个年轻人。";
		next;
		emotion ET_SURPRISE;
		mes "[Luanda]";
		mes "呃……什么？！你见到了我和几个长得像我兄弟的年轻人。";
		next;
		mes "[Luanda]";
		mes "看来那是很久以前的事了。不像 Mao，我的记性不太好。";
		next;
		mes "[Luanda]";
		mes "我隐约记得。我和兄弟去狩猎前，确实警告过一个遇到的陌生人。";
		next;
		mes "[Luanda]";
		mes "在城里见到陌生人并不稀奇，所以记忆很模糊，但我确实记得。";
		next;
		mes "[Luanda]";
		mes "真有趣。如果你说的是真的，那不就意味着你过去和我交谈过吗？";
		next;
		mes "[Luanda]";
		mes "啊！说起来，你还记得我们第一次见面吗？我不是说过自己习惯当冒险者吗？";
		next;
		mes "[Luanda]";

		mes "我听说你在宫殿广场施展";
		mes "巫术……";
		mes "所以我让学者";
		mes "调查天气。";
		next;
		mes "[迪米特里首相]";
		mes "天气观测结果显示";
		mes "温度变化正在减小，";
		mes "最高温度现在稳定。";
		mes "";
		next;
		mes "[迪米特里首相]";
		mes "我不知道这意味着什么，但";
		mes "我决定承认事实。";
		mes "";
		next;
		mes "[迪米特里首相]";
		mes "亲爱的沙皇已经知道。";
		mes "我完成了报告。";
		mes "去告诉他。";
		close;
	}
	if (mos_whale_edq < 16) {
		mes "[迪米特里首相]";
		mes "你是外国旅行者。这里是莫斯科比亚宫殿，亚历克谢三世沙皇的居所。在这里尽心礼貌并不为过。";
		close;
	} else if (mos_whale_edq == 16) {
		mes "[迪米特里首相]";
		mes "旅行者，你为什么来到沙皇宫殿？";
		next;
		if(select("只是看看。:去见亲爱的沙皇。") == 1) {
			mes "[迪米特里首相]";
			mes "如果是这样……请谨慎参观，不要打扰沙皇。";
			next;
			mes "[迪米特里首相]";
			mes "莫斯科比亚欢迎你这样的旅行者！";
			next;
			mes "[迪米特里首相]";
			mes "太好了，亲爱的沙皇很喜欢听有趣的故事。";
			close;
		}
		mes "[迪米特里首相]";
		mes "你是来见亲爱的沙皇吗？请提前告诉我来意。";
		next;
		if(select("I'd like to say hello.:I have an adventure story for him.") == 1) {
			mes "[迪米特里首相]";
			mes "我会直接告诉他。你不必担心如何面对沙皇。";
			close;
		}
		mes "[迪米特里首相]";
		mes "我想知道你经历过什么……沙皇会很高兴听你的故事。";
		next;
		mes "[迪米特里首相]";
		mes "我会让你进入。如果沙皇满意你的故事，会给你丰厚奖励。";
		mos_whale_edq = 17;
		close;
	} else if (mos_whale_edq == 17) {
		mes "[迪米特里首相]";
		mes "我已经通报你了，";
		mes "去直接和他谈吧。";
		close;
	} else if (mos_whale_edq > 17 && mos_whale_edq < 35) {
		mes "[迪米特里首相]";
		mes "现在亲爱的沙皇需要休息。";
		mes "你应该履行职责，去寻找鲸鱼岛。";
		close;
	} else if (mos_whale_edq == 35 || mos_whale_edq == 38) {
		mes "[迪米特里首相]";
		mes "啊！你回来了。";
		mes "我会立即请求他见你。";
		close;
	} else if (mos_whale_edq == 39) {
		mes "[迪米特里首相]";
		mes "我不想再听你糟糕的";
		mes "表演了，出去吧。";
		close;
	} else if (mos_whale_edq == 40) {
		mes "[迪米特里首相]";
		mes "怎么了？亲爱的沙列正在休息。";
		mes "没特别的事就出去。";
		close;
	} else if (mos_whale_edq == 41) {
		mes "[迪米特里首相]";
		mes "你的古斯里演奏太感人了。";
		mes "令人难忘！下次来请再演奏。";
		close;
	}
	mes "[迪米特里首相]";
	mes "你是外国旅行者。这里是";
	mes "亚历克谢三世沙皇的宫殿。";
	mes "请保持礼貌，不要无礼。";
	close;
}

//----------------------------------------------------------------------------
// Island Trigger - Docks
//----------------------------------------------------------------------------
moscovia,136,46,4	script	Find#ship	CLEAR_NPC,4,4,{
	end;

OnTouch:
	if (mos_whale_edq < 35) end;
	mes "-你从码头眺望大海，";
	mes "突然意识到";
	mes "你有鲸鱼岛的记忆。-";
	next;
	mes "["+strcharinfo(0)+"]";
	mes "要去鲸鱼岛吗？";
	next;
	if(select("前往鲸鱼岛。:留在这里。") == 1) {
		if (isequipped(2707)) {
			soundeffect "mos_gusli2.wav",0;
			mes "-你的手慢慢放在古斯里上，";
			mes "开始演奏……";
			mes "想起";
			mes "年长陌生人演奏的旋律……-";
			next;
			mes "[村民]";
			mes "有什么东西从海中升起了！！！";
			next;
			mes "[村庄青年]";
			mes "什么……那是什么……？？";
			next;
			mes "[Mr. Ibanoff]";
			mes "哦呵呵呵……那是鲸鱼";
			mes "岛……！！！总有一天我也要去！哈哈哈。";
			next;
			warp "mosk_fild01",95,93;
		} else {
			mes "["+strcharinfo(0)+"]";
			mes "天啊……我竟然忘了";
			mes "装备古斯里。";
			next;
			mes "["+strcharinfo(0)+"]";
			mes "年长陌生人说，如果我想再次去鲸鱼岛，";
			mes "就应该在这里演奏古斯里……";
			}
		close;
		}
	mes "["+strcharinfo(0)+"]";
	mes "我下次再来也行。";
	mes "现在我还有其他事要做。";
	close;
	}


mosk_ship,81,110,0	script	#findship	CLEAR_NPC,5,5,{
OnEnable:
enablenpc "#findship";
	initnpctimer;
	end;
	
OnTimer300000:
stopnpctimer;
	OnInit:
$@mos1_edq = 0;
	disablenpc "#findship";
	end;
	
OnTouch:
if (mos_whale_edq == 12) {
	mes "呜哇啊啊啊啊啊";
		next;
		mes "[Mr. Ibanoff]";
		mes "嘿，"+strcharinfo(0)+"！看！";
		mes "很危险！快躲起来！快！";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "";
		mes "那……那是……";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "有什么……有什么东西升起来了……";
		next;
		mes "[Mr. Ibanoff]";
		mes "小心！"+strcharinfo(0)+"！";
		mes "啊……那……那是……什么……";
		mos_whale_edq = 13;
		if (isbegin_quest(18108))
			changequest 18108,18109;
		close2;
		warp "mosk_fild01",95,93;
	}
	end;
}

-	script	Baehideun#main	-1,{
OnInit:
	disablenpc();
	end;

OnEnable:
	enablenpc();
	.@c = charat(strnpcinfo(0),9);
	if (checkre(0)) {
		switch (.@c) {
			case 1: setarray .@m, 89,112,1551,85,110,1579; break;// G_MARSE, G_HYDRA
			case 2: setarray .@m, 89,112,1425,80,110,1254,83,114,1254,85,110,1425; break;// G_OBEAUNE, RAGGLER
			case 3: setarray .@m, 85,111,1451,89,112,1543,90,106,1543; break;// G_MERMAN, G_KAPHA
			case 4: setarray .@m, 85,111,1069,89,112,1543,90,106,1543; break;// SWORD_FISH, G_KAPHA
		}
	}
	else {
		switch (.@c) {
			case 1: setarray .@m, 89,112,1425,85,110,1425; break;// G_OBEAUNE, G_OBEAUNE
			case 2: setarray .@m, 89,112,1425,80,110,1426,83,114,1426,85,110,1425; break;// G_OBEAUNE, G_MARC
			case 3:
			case 4: setarray .@m, 85,111,1451,89,112,1543,90,106,1543; break;// G_MERMAN, G_KAPHA
		}
	}
	for (.@i = 0; .@i < getarraysize(.@m); .@i += 3)
		monster "mosk_ship",.@m[.@i],.@m[.@i+1],"Sea Monster",.@m[.@i+2],1,strnpcinfo(0)+"::OnMyMobDead";
	initnpctimer;
	end;

OnTimer300000:
	killmonster "mosk_ship",strnpcinfo(0)+"::OnMyMobDead";
OnDisable:
	$@mos1_edq = 0;
	stopnpctimer;
	disablenpc();
	end;

OnMyMobDead:
	if (!mobcount("mosk_ship",strnpcinfo(0)+"::OnMyMobDead")) {
		$@mos1_edq = 0;
		mes "[Mr. Ibanoff]";
		mes "现在所有魔物都消失了，";
		mes "我们就能再次启航";
		mes "可以正常航行了。";
		.@c = charat(strnpcinfo(0),9);
		switch (.@c) {
			case 1:
			case 2: break;
			case 3: mos_whale_edq = 11; break;
			case 4: mos_whale_edq = 26; break;
		}
		donpcevent strnpcinfo(0)+"::OnDisable";
		close;
	}
	end;
}
mosk_ship,2,2,4	duplicate(Baehideun#main)	Baehideun1#ship	-1
// mosk_ship,3,3,4	duplicate(Baehideun#main)	Baehideun2#ship	-1
mosk_ship,5,5,4	duplicate(Baehideun#main)	Baehideun3#ship	-1
mosk_ship,15,15,4	duplicate(Baehideun#main)	Baehideun4#ship	-1

// Help Mikhail :: mos_swan & mos_swan_pt2
//============================================================

//----------------------------------------------------------------------------
// Gallina - Starting Point
//----------------------------------------------------------------------------
function	script	F_MOS_1	{
	mes "[Gallina]";
	mes "哦，他到底在哪里？";
	mes "我要好好教训他。";
	mes "He's timid like Dad.";
	next;
	mes "[Anna]";
	mes "Mikhail，他是个胆小鬼，爱哭鬼。";
	mes "Mikhail，他是个胆小鬼，爱哭鬼。";
	next;
	mes "[Gallina]";
		mes "都是因为你没照顾好弟弟。所以你来打扫房子，Anna？";
	next;
	emotion ET_CRY, getnpcid(0, "Anna#mos");
	mes "[Anna]";
	mes "Oh, my................";
	next;
	if(select("和她交谈。:直接走过。") == 2) {
		mes "[Gallina]";
		mes "我担心他正在什么地方惹麻烦……";
		close;
	}
	mes "["+strcharinfo(0)+"]";
	mes "你好？";
	next;
	mes "[Gallina]";
	mes "Oh, God!";
		mes "我没看到你在那里。抱歉！";
	mes "你想买一张松饼，对吧？";
		mes "抱歉，我们还没准备好开店。";
	next;
	mes "["+strcharinfo(0)+"]";
	mes "不，没关系。";
		mes "有什么我能帮忙的吗？发生什么事了？";
	next;
	mes "[Gallina]";
	mes "Oh, well...";
		mes "我不在家的时候，儿子 Mikhail 把我们的套娃弄坏了。";
		mes "他怕我惩罚他，所以逃走了。";
	next;
	mes "[Gallina]";
	mes "这孩子真胆小！";
		mes "我怀疑他将来能不能成为伟大的将军。";
	next;
	mes "[Gallina]";
		mes "他以前这个时候已经回家了。";
		mes "我担心他出了什么意外。";
	next;
	mes "["+strcharinfo(0)+"]";
	mes "你看起来很焦虑。我想帮你找到儿子。";
	next;
	mes "[Gallina]";
	mes "你说我焦虑？";
		mes "我只是焦急地等他回家。";
		mes "……这样我就能惩罚他做过的事。";
	next;
	mes "[Gallina]";
	mes "拒绝你的好意也不好。";
	mes "你能帮我找 Mikhail 吗？";
	next;
	if(select("I was not serious.:Yes, I will!") == 1) {
		mes "[Gallina]";
		mes "你真坏！我没心情开玩笑。";
		close;
	}
	mes "[Gallina]";
	mes "Oh, God, You're so kind";
	mes "Mikhail 是个很胆小的孩子。我想他没有离开村子。";
	mes "那就请把他带来～";
	mos_swan = 1;
	setquest 18060;
	close;
}

mosk_in,144,279,5	script	Gallina#mos	4_F_RUSWOMAN1,{
	if (!mos_swan) {
		callfunc("F_MOS_1");
	} else if (mos_swan == 1) {
		mes "[Gallina]";
		mes "Mikhail，我胆小的儿子一定还在这个村子里。";
		mes "如果他像父亲一样害羞胆小，我很抱歉。";
		close;
	} else if (mos_swan < 25) {
		mes "["+strcharinfo(0)+"]";
		mes "Mikhail 还没来吗？";
		next;
		mes "[Gallina]";
		mes "不，他到底在哪里？";
		close;
	} else if (mos_swan == 25) {
		mes "[Gallina]";
		mes "他带着粗略粘好的套娃回来，然后就离开了……";
		next;
		mes "[Gallina]";
		mes "抱歉，我之前对那个小男孩太严厉了。";
		mes "他用自己的方式尽了最大努力。";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "没关系。你会成为小男孩的好妈妈。哈哈。";
		next;
		mes "[Gallina]";
		mes "是的。我相信我会的。呵呵……";
		mes "Anna，我女儿犯了错，把责任全推给弟弟。我也会惩罚她。";
		next;
		mes "[Gallina]";
		mes "我很感谢你的努力。你去了危险的地方寻找我的儿子";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "我经常这样，嘿嘿。";
		next;
		mes "[Gallina]";
		mes "我没什么东西能奖励你，不过……我可以告诉你如何制作美味的松饼！";
		next;
		mes "[Gallina]";
		mes "我现在得工作了，不过 Larissa 会告诉你。她是我们的女仆。";
		mes "她真是个好厨师。";
		next;
		mes "[Gallina]";
		mes "莫斯科比亚的松饼非常美味！";
		mes "做一次试试，我保证你会喜欢。";
		next;
		mes "[Gallina]";
		mes "好了，我得去工作了！";
		mes "哪天我会给你做我的松饼。以后请再来拜访。";
		mos_swan = 100;
		completequest 18069;
		getexp (checkre(3))?90000:1000000,0;
		close;
	}
	mes "[Gallina]";
	mes "我总是在尝试准备新的菜肴。";
	mes "你觉得‘世界上最辣的辣椒松饼’怎么样？";
	mes "我想那一定很棒！";
	close;
}

//----------------------------------------------------------------------------
// Anna - Sister
//----------------------------------------------------------------------------
mosk_in,148,274,1	script	Anna#mos	4_F_RUSCHILD,{
	if (!mos_swan) {
		callfunc("F_MOS_1");
	} else if (mos_swan == 1) {
		mes "[Anna]";
		mes "Mikhail，他是个胆小鬼，爱哭鬼。";
		mes "Mikhail，他是个胆小鬼，爱哭鬼。";
		close;
	} else if (mos_swan == 2) {
		mes "[Anna]";
		mes "你为什么在这里？";
		next;
		while(1) {
			switch(select("询问 Mikhail 可能藏在哪里:询问他们的关系:询问情况:询问其他事情:结束对话")) {
				case 1:
					mes "["+strcharinfo(0)+"]";
					mes "Mikhail 在哪里？";
					mes "你知道他在哪里吗？";
					next;
					emotion ET_MERONG;
					mes "[Anna]";
					mes "如果我知道，我早就找到他了，你这个笨蛋。";
					next;
					emotion ET_SWEAT, playerattached();
					mes "["+strcharinfo(0)+"]";
					mes "哈哈哈，你说得对。";
					break;
				case 2:
					mes "["+strcharinfo(0)+"]";
					mes "你和弟弟的关系怎么样？";
					next;
					mes "[Anna]";
					mes "Mikhail 总是跟在我身后，求我读书给他听！";
					mes "而且他太爱哭了。";
					mes "真让我恼火。";
					mes "他只想和我玩。所以他没有朋友。";
					next;
					mes "["+strcharinfo(0)+"]";
					mes "你看起来很勇敢。";
					mes "我能理解你母亲为什么担心他。";
					break;
				case 3:
					mes "["+strcharinfo(0)+"]";
					mes "Mikhail 打碎你母亲的套娃时，你在做什么？";
					next;
					mes "[Anna]";
					mes "我当时在那里。";
					next;
					mes "["+strcharinfo(0)+"]";
					mes "哦，是吗？";
					next;
					mes "[Anna]";
					mes "父母外出时，他们让我照顾 Mikhail。";
					mes "我不想这么做，但我是他的姐姐，所以我在他旁边读书。";
					next;
					mes "[Anna]";
					mes "他开始缠着让我读书给他听，后来又说饿了来烦我！";
					next;
					mes "[Anna]";
					mes "我被他烦得不行，假装没听到继续读书。我想这让他生气了，所以他打碎了套娃。";
					next;
					mes "[Anna]";
					mes "他闯了祸就哭起来！";
					mes "真是个胆小的孩子……";
					mes "（咯咯笑）";
					next;
					mes "[Anna]";
					mes "我告诉他要在妈妈回来前把碎片粘起来，所以 Mikhail 去拿^3131FF胶水^000000了，但还没回来。";
					next;
					mes "["+strcharinfo(0)+"]";
					mes "在哪里能拿到？";
					mes "你为什么不和他一起去？";
					next;
					mes "[Anna]";
					mes "你觉得我们小孩会知道吗？";
					mes "是他打碎的，就该自己去拿东西！";
					mes "妈妈说他应该自己完成工作，才能成为伟大的将军。";
					next;
					mes "["+strcharinfo(0)+"]";
					mes "你完全不知道他可能在哪里吗？";
					next;
					mes "[Anna]";
					mes "不知道。";
					next;
					mes "["+strcharinfo(0)+"]";
					mes "有没有和他亲近的人？";
					next;
					emotion ET_HNG;
					mes "[Anna]";
					mes "（咯咯笑）他是个笨蛋，没有朋友。";
					mes "不过在村民中，^3131FF‘黏草树’旅馆的老板娘^000000一直很疼爱 Mikhail。";
					next;
					mes "[Anna]";
					mes "我也不知道了。";
					next;
					mes "- Anna 吐了吐舌头。-";
					next;
					mes "["+strcharinfo(0)+"]";
					mes "这是唯一的线索，我想我该去^3131FF‘黏草树’旅馆^000000看看？";
					if (mos_swan == 2) {
						mos_swan = 3;
						changequest 18060,18061;
					}
					break;
				case 4:
					mes "["+strcharinfo(0)+"]";

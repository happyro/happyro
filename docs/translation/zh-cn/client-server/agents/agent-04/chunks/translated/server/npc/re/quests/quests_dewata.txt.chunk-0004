dew_fild01,127,240,4	script	Gatti#weapon	813,{
	if (checkweight(1201,1) == 0 || MaxWeight - Weight < 10000) {
		mes "- 站住！！ -";
		mes "-你携带的物品太多，没有足够的背包空间领取奖励。-";
		mes "-请腾出更多背包空间后再回来接受挑战。-";
		close;
	}
	if (BaseLevel < 60) {
		mes "[Gatti]";
		mes "我到底在哪里？这里每个人都躲着我。";
		close;
	}
	if (dew_weapon == 0) {
		mes "[Gatti]";
		mes "嘿，年轻的"+((Sex == SEX_MALE)?"小伙子":"姑娘")+"～你是本地人吗？";
		next;
		select("不，我不是。");
		mes "[Gatti]";
		mes "我想问";
		mes "你一个问题。";
		mes "这里是什么地方？";
		next;
		mes "-他似乎在询问岛屿的名字。-";
		next;
		input .@island_name$;
		next;
		mes "["+strcharinfo(0)+"]";
		mes "这里叫"+ .@island_name$ +". 怎么了？";
		next;
		if (.@island_name$ == "Dewata Island") {
			mes "[Gatti]";
			mes "这是杜瓦塔岛？你确定是杜瓦塔岛？";
			next;
			mes "[Gatti]";
		mes "哈哈哈哈哈哈哈哈……！！！";
			next;
			mes "-老人听到岛名后像疯了一样大笑。你决定稍后再问。-";
			set dew_weapon,1;
			close;
		} else {
			mes "[Gatti]";
			mes "是这样吗…… "+ .@island_name$ +"? "+ .@island_name$ +"... "+ .@island_name$ +"... "+ .@island_name$ +"...";
			next;
			mes "-老人无奈地深深叹了口气，继续说了下去。-";
			next;
			mes "[Gatti]";
			mes "该死……我的计划毁了。我投入全部财产才来到这里，却失败了。现在什么也做不了，我的船也毁了。";
			next;
			mes "-老人开始哭泣。-";
			mes "-你觉得尴尬，赶紧离开。-";
			close;
		}
	} else if (dew_weapon == 1) {
		select("嗯……先生……");
		mes "[Gatti]";
		mes "咳……咳……";
		next;
		mes "[Gatti]";
		mes "哦……抱歉~抱歉。 我终于抵达杜瓦塔岛，太高兴了。";
		next;
		mes "[Gatti]";
		mes "这不是个简短的故事。哦！我得先自我介绍。我是铁匠大师 Gatti，也是冒险者。";
		next;
		mes "[Gatti]";
		mes "我找到了一张神秘武器蓝图，但不记得具体是什么时候得到的。";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "武器蓝图？";
		next;
		mes "[Gatti]";
		mes "是的！我四处旅行寻找武器材料，但是……";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "但是？";
		next;
		mes "[Gatti]";
		mes "我到处都找不到最后一种材料。";
		next;
		mes "[Gatti]";
		mes "我本来要放弃了，但蓝图上的小字写着它可以在杜瓦塔岛找到。";
		next;
		mes "[Gatti]";
		mes "不知道为什么有人把这么重要的事写在小字里。总之，读到后我倾尽财产寻找那座岛。";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "哦……是这样吗？";
		next;
		mes "[Gatti]";
		mes "这座岛很奇怪。我一周前来到这里，所有人都在躲着我。";
		next;
		mes "[Gatti]";
		mes "上周真是艰难，但你告诉我这里是杜瓦塔岛，救了我一命。";
		mes "谢谢你告诉我，也谢谢你在正确的时间路过这里。";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "呃……不用谢。";
		next;
		mes "[Gatti]";
		mes "嗯……我的船遇到了一点失事问题，不过这不重要。";
		next;
		mes "[Gatti]";
		mes "既然知道这里是杜瓦塔岛，我该去寻找这把伟大武器的材料了。";
		next;
		mes "[Gatti]";
		mes "... ... ... ... ...";
		next;
		if (dew_legend < 9) {
			mes "[Gatti]";
			mes "啊！我正在寻找的材料是科莫多皮革。";
			next;
			mes "["+strcharinfo(0)+"]";
			mes "科莫多皮革？";
			next;
			mes "[Gatti]";
			mes "是的。蓝图上写着，只有少数获得德瓦塔本地人认可的人，才有资格对抗科莫多龙。";
			next;
			mes "[Gatti]";
			mes "要对抗科莫多龙，你必须获得本地人的认可。我想这认可很难得到。";
			next;
			mes "["+strcharinfo(0)+"]";
			mes "当然，一定很难……";
			next;
			mes "[Gatti]";
			mes "我想拜托你一件事。如果你先获得认可，请别忘了来找我。";
			close2;
			setquest 5052;
			set dew_weapon,2;
			end;
		}
		mes "[Gatti]";
		if(Sex == SEX_FEMALE)
		mes "姑娘，你拥有强大的能量。";
		else
		mes "你拥有强大的能量。";
	mes "你在这座岛上见过叫作科莫多龙的魔物吗？";
		next;
		select("见过。" );
		mes "[Gatti]";
		mes "哦！真的吗？";
		mes "能遇到你真幸运。事情进展得很顺利。";
		next;
		mes "[Gatti]";
		mes "你能帮帮我吗？";
		next;
		mes "[Gatti]";
		mes "我寻找的武器材料是^0000FF科莫多皮革^000000。带 100 个给我，我会为你制作一件华丽的武器。";
		setquest 5053;
		set dew_weapon,3;
		next;
		mes "[Gatti]";
		mes "我听说科莫多龙是非常强大的魔物。请小心。";
		close;
	} else if (dew_weapon == 2) {
		if (dew_legend < 9) {
			mes "[Gatti]";
			mes "你获得本地人的认可了吗？";
			next;
			mes "[Gatti]";
			mes "... .... ...";
			next;
			mes "[Gatti]";
			mes "我想还没有。我到处打听，却找不到获得本地人认可的方法。不知道什么时候才能完成这件武器。";
			next;
			mes "[Gatti]";
			mes "如果你比我先获得认可，请千万别忘了来找我。";
			close;
		}
		mes "[Gatti]";
	mes "那么，你获得本地人的认可了吗？";
		next;
		mes "[Gatti]";
		mes "... .... ...";
		next;
		mes "[Gatti]";
		mes "哦，是的！终于。";
		if (Sex == SEX_FEMALE)
			mes "姑娘，你也拥有强大的能量。";
		else
			mes "你也拥有强大的能量。";
		mes "你终于获得本地人的认可了吗？";
		next;
		select("是的。" );
		mes "[Gatti]";
		mes "哦！正如我所料！";
		mes "遇到你真幸运。一切进展得很顺利。";
		next;
		mes "[Gatti]";
		mes "我知道自己没资格要求你，但这样的相遇就是命运……";
		next;
		mes "-Gatti 喃喃自语。-";
		next;
		mes "[Gatti]";
		mes "我一直渴望的武器材料是^0000FF科莫多皮革^000000。请给我 100 个。";
		next;
		mes "[Gatti]";
		mes "我迫不及待想制作蓝图中的武器。";
		changequest 5052,5053;
		set dew_weapon,3;
		next;
		mes "[Gatti]";
		mes "拜托了，趁我的热情还没有消退。";
		next;
		mes "[Gatti]";
		mes "哦！科莫多龙是非常强大的魔物，请务必小心。";
		close;
	} else if (dew_weapon == 3) {
		if (countitem(6403) > 99) {
			mes "[Gatti]";
			mes "看你的步伐，你一定带来了 100 个科莫多皮革。交给我吧。";
			delitem 6403,100;
			erasequest 5053;
			set dew_weapon,4;
			next;
			mes "-Gatti 从你手中接过科莫多皮革。-";
			close;
		} else if (countitem(6403)) {
			mes "[Gatti]";
			mes "这就是科莫多皮革。不过还不够。";
			next;
			mes "[Gatti]";
			mes "我知道这是在拜托你，但我需要 100 个。";
			close;
		} else {
			mes "[Gatti]";
			mes "科莫多龙非常强大，请小心。回来时别忘了带 100 个科莫多皮革。";
			close;
		}
	} else if (dew_weapon == 4) {
		mes "[Gatti]";
		mes "哦～看看这个。多么坚韧……又柔软。";
		next;
		mes "[Gatti]";
		mes "科莫多皮革是最棒的材料。";
		next;
		mes "[Gatti]";
		mes "嗯，我该怎么加工它？";
		next;
		mes "[Gatti]";
		mes "嗯……这样吗？";
		next;
		mes "[Gatti]";
		mes "还是那样？对！就是这样！";
		next;
		mes "-铁匠大师 Gatti 正兴致勃勃地加工你带来的皮革，制作武器。-";
		mes "-请稍等一会儿。-";
		set dew_weapon,5;
		close;
	} else if (dew_weapon == 5) {
		mes "["+strcharinfo(0)+"]";
		mes "那个……Gatti？";
		next;
		mes "[Gatti]";
		mes "哦！抱歉，抱歉！这皮革太有趣了。";
		next;
		mes "[Gatti]";
		mes "我用你带来的皮革做了一个剑柄。";
		next;
		mes "[Gatti]";
		mes ".... .... .... ....";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "剑柄？";
		next;
		mes "[Gatti]";
		mes "你不知道剑柄是什么？那就是武器的握把。";
		next;
		mes "-Gatti 展示了一个看起来像武器握把的东西。-";
		next;
		mes "[Gatti]";
		mes "我试着按照蓝图制作，但还需要更多材料。";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "真的吗？";
		next;
		mes "[Gatti]";
		mes "... ... ... ...";
		next;
		mes "[Gatti]";
		mes "是的……老实说，我尝试不同做法时浪费了很多材料。";
		next;
		mes "[Gatti]";
		mes "我知道要求很多，但你能再给我 100 个科莫多皮革、20 个钢铁和 10 个神之金属吗？";
		next;
		mes "[Gatti]";
		mes "我会为你制作有史以来最棒的武器。";
		setquest 5054;
		set dew_weapon,6;
		getitem 6404,1; //Caress_H
		next;
		mes "[Gatti]";
		mes "哦！我差点忘了。别忘了带上我刚为你制作的剑柄。";
		next;
		mes "[Gatti]";
		mes "武器必须有握把。";
		close;
	} else if (dew_weapon == 6) {
		disable_items;
		mes "[Gatti]";
		mes "你已经带齐所有材料了吗？";
		mes "你也很好奇完成的武器吗？哈哈。";
		next;
		mes "[Gatti]";
		mes ".... .... ....";
		next;
		if (countitem(6403) < 100 || countitem(999) < 20 || countitem(984) < 10 || countitem(6404) < 1) {
			mes "[Gatti]";
			mes "嗯……我还需要更多。如果我的船没有毁掉，我本可以自己取得，但……";
			next;
			mes "-Gatti 自言自语。-";
			next;
			mes "[Gatti]";
			mes "我需要 100 个科莫多皮革、20 个钢铁和 10 个神之金属。";
			next;
			mes "[Gatti]";
			mes "如果你全部带来，我会制作最棒的武器。";
			close;
		}
		mes "[Gatti]";
		mes "太好了！材料够了。请稍等。";
		next;
		specialeffect2 EF_REPAIRWEAPON;
		next;
		emotion ET_PROFUSELY_SWEAT;
		next;
		mes "[Gatti]";
		mes "我完成了武器制作。根据蓝图，它叫作 Caress。";
		next;
		mes "[Gatti]";
		mes "每次查看这张蓝图，我都会发现新的东西。";
		next;
		mes "[Gatti]";
		mes "现在我已经学会制作这件武器了，需要时随时来找我。";

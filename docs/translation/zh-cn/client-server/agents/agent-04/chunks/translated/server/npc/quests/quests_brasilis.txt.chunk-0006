brasilis,315,334,5	script	Shaman#nk	4_F_BRZ_INDOLD,{
	.@iara_re = checkquest(4135,PLAYTIME);
	if ((.@iara_re == 0) || (.@iara_re == 1)) {
		mes "";
		mes "";
		mes "";
		mes "";
		mes "我还在准备。";
		mes "现在不需要你的帮助。";
		mes "请稍后再来……";
		close;
	}
	else {
		if (checkquest(4135) > 1) erasequest 4135;
		.@iara_q = checkquest(4133);
		if ((.@iara_q == 0) || (.@iara_q == 1)) {
		mes "";
		mes "";
		mes "";
		mes "";
			mes "为了阻止伊拉诱惑部族，";
			mes "我们需要净化药水……";
			next;
			mes "[Anori]";
			mes "你带来制作净化药水的材料了吗？";
			next;
			if ((countitem(950) > 19) && (countitem(7172) > 9) && (countitem(1054) > 2)) {
				mes "[Anori]";
				mes "嗯……材料似乎够了。";
				mes "我会制作能削弱伊拉力量的药水。";
				next;
				mes "[Anori]";
				mes "让我把这个磨碎……";
				mes "再混入那个……";
				mes "然后加入魔法……";
				next;
				setquest 4135;
				erasequest 4133;
				setquest 4134;
				completequest 4134;
				delitem 950,20; //Heart_Of_Mermaid
				delitem 7172,10; //Leopard_Talon
				delitem 1054,3; //Lip_Of_Ancient_Fish
				getitem 11517,2; //Puri_Potion
				mes "[Anori]";
				mes "好了，完成了。";
				mes "拿着这个。";
				mes "它会让伊拉暂时停止";
				mes "在洞穴中的训练。";
				next;
				mes "[Anori]";
				mes "请阻止威胁部族安全的伊拉。";
				close;
			}
			else {
				mes "[Anori]";
				mes "你带来的材料还不够。";
				mes "这些材料无法制作净化药水。";
				close;
			}
		}
		else {
			if (BaseLevel < 40) {
				mes "[Anori]";
				mes "啊……我们需要强大的冒险者。";
				mes "部族正面临巨大威胁。";
				close;
			}
			.@re_q = checkquest(4134);
			if (.@re_q == 2) {
				mes "[Anori]";
				mes "你就是……";
				mes "来取净化药水的";
				mes "冒险者……";
				next;
				mes "[Anori]";
				mes "也许是因为净化药水……";
				mes "之后伊拉停止诱惑族人，但效果没持续多久。";
				next;
				mes "[Anori]";
				mes "能再取得和之前一样的材料吗……";
				mes "我需要你的力量。";
				next;
				switch(select("不。:好，我会做。")) {
				case 1:
					mes "[Anori]";
					mes "这个，啊……";
					mes "没有其他办法了。";
					close;
				case 2:
					mes "[Anori]";
					mes "你真的很勇敢！";
					mes "我代表部族向你致谢。";
					next;
					mes "[Anori]";
					mes "材料和之前一样。";
					mes "只要取得^ff000020 个人鱼之心、";
					mes "10 个豹爪和";
					mes "3 个远古嘴唇^000000，";
					mes "我就用部族传承的秘方制作净化邪灵的药水。";
					next;
					mes "[Anori]";
					mes "部族的命运取决于你。";
					mes "请尽快取得材料。";
					mes "我会在这里准备制作净化药水。";
					setquest 4133;
					close;
				}
			}
			else {
				mes "[Anori]";
				mes "这里出现了一些我以前没见过的人。";
				mes "这是个好兆头……";
				next;
				mes "[Anori]";
				mes "嘿，你……";
				mes "能听我讲一会儿吗？";
				mes "我们的部族遇到紧急情况。";
				next;
				if(select("不。:好。") == 1) {
					mes "[Anori]";
					mes "你真冷酷……";
					mes "看起来不是会帮忙的人。";
					mes "继续走你的路吧。";
					close;
				}
				mes "[Anori]";
				mes "谢谢，我遇到了善良的人。";
				mes "这是部族秘密，";
				mes "不能告诉任何人。";
				next;
				mes "[Anori]";
				mes "最近部族里的年轻人正在失踪。";
				mes "整个部族都受到威胁。";
				next;
				mes "[Anori]";
				mes "很可能是因为叫伊拉的女巫。";
				mes "她是水妖，在瀑布后的洞穴里诱惑年轻族人的心。";
				next;
				mes "[Anori]";
				mes "我该如何阻止这些年轻人？";
				mes "但我发现了制作净化药水的方法，可以逆转伊拉法术的效果。";
				next;
				mes "[Anori]";
				mes "这种药水在部族中代代相传。";
				mes "净化药水拥有清除邪灵的力量。";
				next;
				mes "[Anori]";
				mes "如果你能取得材料，";
				mes "我就为你制作净化药水。";
				mes "能帮我吗？";
				next;
				switch(select("不。:好，我能做到。")) {
				case 1:
					mes "[Anori]";
					mes "嗯……";
					mes "那么，好吧。";
					mes "改变主意后可以再来找我。";
					next;
					mes "[Anori]";
					mes "别把刚才听到的事告诉任何人。";
					mes "有点丢脸……";
					close;
				case 2:
					mes "[Anori]";
					mes "哦！你确实是部族的救世主。";
					mes "我代表部族向你致谢。";
					next;
					mes "[Anori]";
					mes "我们需要这些。";
					mes "都是附近能取得的。";
					mes "记清楚。";
					next;
					mes "[Anori]";
					mes "^ff0000 20 Hearts of Mermaids";
				mes "10 个豹爪";
				mes "3 个远古嘴唇^000000";
					mes "这些就是所需的全部材料。";
					next;
					mes "[Anori]";
					mes "取得这些后，我会用部族传承的秘方制作净化邪灵的药水。";
					setquest 4133;
					next;
					mes "[Anori]";
					mes "部族的命运取决于你。";
					mes "希望你快点行动。";
					mes "此刻村里的男人还在被诱惑、逐渐消失……";
					close;
				}
			}
		}
	}
}

bra_dun02,157,74,5	script	Iara#nk	4_F_BRZ_WOMAN,2,2,{
	if (countitem(11517) > 0) {
		mes "[" + strcharinfo(0) + "]";
		mes "要使用净化药水吗？";
		next;
		switch(select("Yes.:No.")) {
		case 1:
			specialeffect EF_MAPPILLAR;
			mes "[Iara]";
			mes "啊……这道光……";
			mes "就像从我心底净化邪念。";
			next;
			mes "[Iara]";
			mes "终于可以忘记溺水时施加在自己身上的诅咒。";
			next;
			mes "[Iara]";
			mes "你觉得我能重生为善良的水妖吗？";
			next;
			specialeffect EF_GHOST;
			mes "[Iara]";
			mes "啊……谢谢你帮我暂时恢复意识。";
			mes "但是……诅咒伴随我太久了。";
			mes "快离开我。";
			delitem 11517,1; //Puri_Potion
			if (checkre(0)) {
				percentheal 100,100;
				sc_start SC_INCFLEE,3600000,20;
				sc_start SC_INCCRI,3600000,10;
			}
			else
				sc_start SC_INCCRI,3600000,7;
			consumeitem 12043; //Str_Dish03
			consumeitem 12063; //Dex_Dish03
			consumeitem 12058; //Agi_Dish03
			consumeitem 12053; //Vit_Dish03
			consumeitem 12048; //Int_Dish03
			consumeitem 12068; //Luk_Dish03
			next;
			mes "[Iara]";
			mes "啊啊～……";
			specialeffect EF_DEVIL;
			next;
			mes "[Iara]";
			mes "诅咒太强，我无法继续压制。";
			mes "趁你还安全，快离开。";
			close;
		case 2:
			mes "[" + strcharinfo(0) + "]";
		mes "（我想还是别理她。）";
			close;
		}
	}
	else {
		mes "[Iara]";
		mes "啊啊啊啊啊啊啊啊啊啊啊啊啊。";
		mes "呃呃呃呃呃呃呃呃呃呃呃呃呃。";
		mes "哦哦哦哦哦哦哦哦哦哦哦哦哦。";
		if (rand(1,2) == 1)
			sc_start SC_CURSE,60000,0;
		else
			sc_start SC_CONFUSION,60000,0;
		next;
		mes "[" + strcharinfo(0) + "]";
	mes "呃！这奇怪的声音是什么？";
		close;
	}
	end;

OnTouch:
	if (countitem(11517) < 1) {
		mes "[Iara]";
		mes "啊啊啊啊啊啊啊啊啊啊啊啊啊。";
		mes "呃呃呃呃呃呃呃呃呃呃呃呃呃。";
		mes "哦哦哦哦哦哦哦哦哦哦哦哦哦。";
		if (rand(1,2) == 1)
			sc_start SC_CURSE,60000,0;
		else
			sc_start SC_CONFUSION,60000,0;
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "呃！这奇怪的声音是什么？";
		close;
	}
	end;
}

bra_fild01,188,301,5	script	Native Warrior#nk	4_M_BRZ_INDIAN,{
	mes "[Native Warrior]";
	mes "啊……即使在梦里也不会忘记的脸。";
	next;
	mes "[Native Warrior]";
	mes "她什么时候会再次从瀑布出来……？";
	next;
	if ((checkquest(4133) >= 0) || (checkquest(4134) >= 0)) {
		mes "[" + strcharinfo(0) + "]";
		mes "（这……这家伙是谁？）";
	}
	else {
		mes "[" + strcharinfo(0) + "]";
		mes "（这家伙永远无法摆脱伊拉的诅咒……）";
	}
	close;
}

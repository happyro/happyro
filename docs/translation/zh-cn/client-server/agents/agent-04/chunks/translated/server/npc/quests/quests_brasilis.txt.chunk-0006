				warp "bra_in01",138,176;
				end;
			case 2:
				mes "你放弃进入。";
				close;
			}
		}
		else {
			mes "[管理员]";
			mes "我能为你做什么？";
			next;
			select("I need to use the bathroom.");
			mes "[管理员]";
			mes "抱歉，里面正在装修，目前关闭。";
			mes "请使用另一个。";
			next;
			switch(select("But I forgot something inside.:Give up.")) {
			case 1:
				mes "[管理员]";
				mes "那太糟糕了。";
				mes "但经理命令我阻止任何人进入洗手间，所以我必须服从。";
				next;
				select("It's such a hot day!");
				mes "[管理员]";
				mes "巴西利斯一直很热，但今天热得离谱。";
				mes "也许我需要喝椰子汁降温。";
				close;
			case 2:
				mes "你放弃进入。";
				close;
			}
		}
	}
	else if (brazil_ghost > 6) {
		mes "[管理员]";
		mes "嘿，谢谢你之前给的椰子，真的让我凉快多了。";
		close;
	}
	else {
		mes "[管理员]";
		mes "是我的错觉吗？今天是不是前所未有地热！";
		close;
	}
}

bra_in01,12,185,0	script	inbathroom#bra	WARPNPC,1,1,{
OnTouch_:
	if (brazil_ghost > 6)
		warp "bra_in01",138,176;
	else {
		mes "入口被封锁了。";
		close;
	}
	end;
}

bra_in01,138,174,0	warp	outbathroom#bra	1,1,bra_in01,12,183

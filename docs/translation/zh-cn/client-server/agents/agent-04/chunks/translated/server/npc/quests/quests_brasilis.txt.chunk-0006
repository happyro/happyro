bra_fild01,323,136,1	script	Pipe#brafild	CLEAR_NPC,{
	if (brazil_ghost > 6) {
		mes "你看到一根生锈的管道，似乎连接着丛林地下。";
		next;
		switch(select("Examine it:Ignore.")) {
		case 1:
			mes "你从管道缝隙游入，被突然涌来的水流冲走。";
			close2;
			warp "bra_in01",206,182;
			end;
		case 2:
			mes "可能很危险，最好别贸然行动。";
			close;
		}
	}
	else {
		mes "你看到一根生锈的管道，似乎连接着丛林地下。";
		close;
	}
}


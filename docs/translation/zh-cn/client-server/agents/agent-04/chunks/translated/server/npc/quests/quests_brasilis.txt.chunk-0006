bra_in01,206,188,1	script	Open Manhole#todunbra	CLEAR_NPC,{
	if (brazil_ghost == 7) {
		enablenpc "Ghost#bra_end";
	mes "";
	mes "";
	mes "";
	mes "";
	mes "";
	mes "";
		mes "";
		mes "";
		mes "";
		mes "我是多年前在丛林游荡时死去的幽灵。";
		next;
		mes "[Ghost]";
		mes "我在丛林发现一条管道，循着男人的声音来到这里。";
		next;
		mes "[Ghost]";
		mes "我在黑暗中徘徊时也在那里弄伤了一只眼睛。";
		next;
		mes "[Ghost]";
		mes "我在下水道徘徊数日，终于找到连接博物馆厕所的管道尽头。我不断呼救，却没人回应。";
		next;
		mes "[Ghost]";
		mes "你终于回应了我的呼救，但已经太晚。谢谢你至少来查看，至今没人愿意来。";
		next;
		mes "[Ghost]";
		mes "下水道尽头有许多危险生物。";
		mes "不过你看起来很勇敢，那里怪物应该难不倒你。";
		next;
		mes "[Ghost]";
		mes "看来我终于可以安息了。";
		mes "谢谢你，朋友。";
		brazil_ghost = 8;
		//completequest 2208;
		completequest 60355;
		if (VIP_SCRIPT && vip_status(VIP_STATUS_ACTIVE))
			getexp 135000,0;
		else
			getexp 90000,0;
		disablenpc "Ghost#bra_end";
		close;
	}
	warp "bra_dun01",87,47;
	end;
}



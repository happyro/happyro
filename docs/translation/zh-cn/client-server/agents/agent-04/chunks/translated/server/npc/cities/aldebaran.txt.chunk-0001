aldebaran,113,70,4	script	Forger Munster#alde	48,{
	mes "[蒙斯特]";
	mes "我家以前住在吉芬，所以学习锻造、最终成为铁匠似乎是顺理成章的事。后来，我们终于搬到了这座城市，";
	mes "艾尔帕兰。";
	next;
	if (select("关于^3355FF装备精炼^000000:退出") == 1) {
		mes "[蒙斯特]";
		mes "父亲曾是吉芬著名的铁匠，他教了我许多装备锻造知识。";
		next;
		mes "[蒙斯特]";
		mes "其中一个基本原则是，物品精炼成功率取决于武器等级。";
		next;
		mes "[蒙斯特]";
		mes "1级武器可安全精炼至+7，2级武器可安全精炼至+6，3级武器可安全精炼至+5。";
		next;
		mes "[蒙斯特]";
		mes "4级武器可较安全地精炼至+4，防具也能安全精炼至+4。但如果装备精炼失败，它就会被摧毁！";
		close;
	}
	mes "[蒙斯特]";
	mes "嗯……";
	mes "如果有机会，去看看父亲在艾尔帕兰的工坊吧。容我这么说，他是位相当有才华的铁匠。";
	close;
}

aldebaran,64,104,4	script	Smithing Guy#alde	55,{
	mes "[夸特罗]";
	mes "你听说有位著名铁匠从吉芬搬到这里了吗？";
	next;
	if (select("著名铁匠？:结束对话") == 1) {
		mes "[夸特罗]";
		mes "据我所知，他能为你精炼武器和防具。武器精炼后，攻击力会提高。";
		next;
		mes "[夸特罗]";
		mes "1级武器每精炼一级增加2点攻击力，2级武器每级增加3点攻击力。";
		next;
		mes "[夸特罗]";
		mes "3级武器每级增加5点攻击力，4级武器每级增加7点攻击力。";
		close;
	}
	mes "[夸特罗]";
	mes "那位铁匠的家人住在这里。他的妻子体弱多病，需要服用生长在艾尔帕兰附近的药草。";
	next;
	mes "[夸特罗]";
	mes "他们还有一个孝顺的儿子，总在帮忙打理家业。我相信那孩子长大后会像父亲一样成为优秀的铁匠。";
	close;
}

aldebaran,49,93,4	script	Young Man#alde	83,{
	mes "[米勒]";
	mes "4级武器不是很酷吗！";
	mes "真不敢相信世上存在";
	mes "如此强大的武器！";
	next;
	mes "[米勒]";
	mes "它们在公开市场上很少见，不过如果你能击败首领怪物，就有很低的概率获得。";
	close;
}

aldebaran,81,61,4	script	Shell Gathering Lady#ald	101,{
	mes "[乔安妮]";
	mes "我喜欢在海边收集贝壳，既有趣又令人放松~";
	next;
	if (select("收集贝壳？:结束对话") == 1) {
		mes "[乔安妮]";
		mes "看到沙地或泥水坑里冒出气泡时，试着挖一下地面。也许能在地下找到贝壳！";
		next;
		mes "[乔安妮]";
		mes "你听说过";
		mes "琥珀甲虫吗？";
		mes "那种带壳怪物";
		mes "相当厉害~";
		next;
		mes "[乔安妮]";
		mes "它通常出没在普隆德拉西部地区附近的海滩。毫无准备就攻击它，可能会惹上麻烦。";
		next;
		mes "[乔安妮]";
		mes "琥珀甲虫";
		mes "非常强！";
		mes "所以要小心！";
		close;
	}
	mes "[乔安妮]";
	mes "琥珀甲虫";
	mes "非常强！";
	mes "所以要小心！";
	close;
}

aldebaran,46,129,4	script	Canal Guy#alde	97,{
	mes "[巴拿马]";
	mes "艾尔帕兰以运河之都闻名世界。水道为我们美丽的城市增添了优雅而浪漫的气息。";
	next;
	switch(select("关于运河:结束对话")) {
	case 1:
		mes "[巴拿马]";
		mes "运河是用于通行、";
		mes "运输或灌溉的人工水道。";
		next;
		mes "[巴拿马]";
		mes "不过这里的运河只是装饰。需要运输东西时，我们直接使用卡普拉公司的传送服务！";
		close;
		break;
	case 2:
		mes "[巴拿马]";
		mes "希望你在艾尔帕兰过得愉快。";
		close;
		break;
	}
}

aldebaran,67,154,4	script	Forest Guy#alde	98,{
	mes "[Isenberg]";
	mes "妙勒尼山脉和斐扬森林。";
	mes "这两个地方都";
	mes "很难穿越。";
	next;
	switch(select("妙勒尼山脉？:斐扬森林……？:结束对话")) {
	case 1:
		mes "[Isenberg]";
		mes "要从普隆德拉或吉芬来到这里，必须穿越妙勒尼山脉。";
		next;
		mes "[Isenberg]";
		mes "如果你没有使用卡普拉传送服务，徒步走到了这里，";
		mes "那可真了不起！";
		next;
		mes "[Isenberg]";
		mes "妙勒尼山脉非常陡峭，到处都是凶猛好斗的怪物。因此独自穿越那里总是很危险。";
		close;
	case 2:
		mes "[Isenberg]";
		mes "如果想前往艾尔贝塔或斐扬城，必须先穿越斐扬森林。";
		next;
		mes "[Isenberg]";
		mes "斐扬森林像一座曲折复杂的迷宫，很容易迷路。如果不集中注意力记住路线，可能会一直困在那片危险之地。";
		next;
		mes "[Isenberg]";
		mes "弓箭手之村斐扬建在陡峭崎岖的森林深处，以抵御外来入侵。看来这是个不错的决定。";
		close;
	case 3:
		mes "[Isenberg]";
		mes "环绕这座城镇的巨大山脉";
		mes "阻挡了外来者进入。";
		mes "这或许正是我们能够";
		mes "保留美丽运河和神秘炼金术，";
		mes "不受外界影响的部分原因。";
		close;
	}
}

aldebaran,90,170,4	script	Slot Guy#alde	47,{
	mes "[埃普希尔]";
	mes "有些武器或防具带有插槽，可以嵌入从怪物身上获得的卡片。";
	next;
	switch(select("关于插槽数量:卡片与插槽的关系:结束对话")) {
	case 1:
		mes "[埃普希尔]";
		mes "怪物掉落的物品通常比NPC商店出售的普通武器或防具拥有更多插槽。";
		next;
		mes "[埃普希尔]";
		mes "可以认为，同类物品中插槽越多，价值也越高。";
		close;
	case 2:
		mes "[埃普希尔]";
		mes "卡片一旦嵌入插槽就无法取出。因此把卡片嵌入武器或防具时请务必小心。";
		next;
		mes "[埃普希尔]";
		mes "此外，将鼠标移到物品栏或露天商店窗口中的装备上时，物品名称后会以括号显示插槽数量。";
		next;
		mes "[埃普希尔]";
		mes "例如，拥有1个插槽的盾牌在鼠标悬停时会显示为“盾牌 [1]”。";
		next;
		mes "[埃普希尔]";
		mes "你也可以右键点击物品，在物品说明窗口下方的卡片插槽区域查看插槽数量。";
		close;
	case 3:
		mes "[埃皮希尔]";
		mes "你曾从怪物身上获得过卡片吗？";
		close;
	}
}

aldebaran,117,181,4	script	Phracon Guy#alde	48,{
	mes "[Joy]";
	mes "最低等级的1级武器需要一种名为^3355FF普拉昆^000000的金属才能精炼。";
	next;
	switch(select("关于普拉昆:普拉昆的建议:结束对话")) {
	case 1:
		mes "[Joy]";
		mes "普拉昆是一种相当常见的金属，在米德加尔特大陆各地都能找到。";
		next;
		mes "[Joy]";
		mes "虽然它不如其他金属坚固，但很容易找到。你可以击杀怪物获得普拉昆，也可以在城镇的锻造商店购买。";
		next;
		mes "[Joy]";
		mes "当你开始使用更高等级的武器、不再需要普拉昆时，还可以把它卖成Zeny！";
		close;
	case 2:
		mes "[Joy]";
		mes "听说很多怪物身上都有普拉昆，击杀后就会掉落。何不去狩猎它们呢？";
		next;
		mes "[Joy]";
		mes "应该不会太难。我曾击杀小野猪后捡到一块普拉昆！实在急需的话，也可以去锻造商店购买。";
		close;
	case 3:
		mes "[Joy]";
		mes "祝你顺利找到普拉昆！";
		close;
	}
}

aldebaran,121,231,4	script	Alchemy Guy#alde	49,{
	mes "[切米尔]";
	mes "作为二转职业之一，炼金术士能够运用艾尔帕兰古代流传的知识，将多种材料制成物品。";
	next;
	switch(select("关于斐扬炼金术:炼金术的定义:……:结束对话")) {
	case 1:
		mes "[切米尔]";
		mes "大多数人不知道，斐扬曾发展出一种东方炼金术。";
		next;
		mes "[切米尔]";
		mes "斐扬的炼金术士能用不同材料制造黄金。不过，斐扬炼金术的发展始终不及艾尔帕兰。";
		next;
		mes "[切米尔]";
		mes "斐扬缺少炼金材料，人们对这个领域的兴趣也逐渐消退。如今，只有在艾尔帕兰才能学习炼金术。";
		next;
		mes "[切米尔]";
		mes "但我仍忍不住想，斐扬炼金术从世上消失后，究竟有多少秘密随之失传……";
		close;
	case 2:
		mes "[切米尔]";
		mes "炼金术士专攻化学研究，以各种事物创造有用的物品。";
		next;
		mes "[切米尔]";
		mes "听说他们还能制造各种药水，甚至召唤某些怪物！看来这门学问有许多巧妙用途。";
		close;
	case 3:
		mes "[切米尔]";
		mes "你觉得无聊了，对吧？";
		mes "好吧，那我来讲讲怪物卡片和物品插槽。";
		mes "如果你曾得到怪物卡片，应该已经知道，";
		next;
		mes "[切米尔]";
		mes "怪物卡片只能嵌入";
		mes "符合其装备位置要求的物品。";
		mes "例如，假设你得到了一张波利卡片。";
		next;
		mes "[切米尔]";
		mes "右键点击卡片后，你会看到";
		mes "它的能力是LUK+2、完全回避+1，";
		mes "装备位置则是“防具”。";
		next;
		mes "[切米尔]";
		mes "如果试图把这张卡片嵌入多插槽的匕首，";
		mes "操作不会成功，因为这张卡片只能嵌入";
		mes "防具类物品。";
		next;
		mes "[切米尔]";
		mes "城镇商店出售的防具";
		mes "几乎都没有插槽。";
		mes "这意味着你只能通过";
		mes "狩猎怪物获得带插槽的防具。";
		next;
		mes "[切米尔]";
		mes "啊，我来告诉你怎样把卡片嵌入物品。";
		mes "如果想把卡片嵌入正在装备的防具，";
		mes "必须先卸下防具。";
		mes "然后双击想使用的卡片。";
		mes "之后会显示可以嵌入该卡片的防具列表。";
		next;
		mes "[切米尔]";
		mes "并不复杂，对吧？";
		close;
	case 4:
		mes "[切米尔]";
		mes "谈到卢恩-米德加尔特的炼金术，";
		mes "就不能不提艾尔帕兰炼金术士公会！";
		mes "炼金术士万岁！";
		close;
	}
}

aldebaran,86,228,4	script	Little Kid#alde	62,{
	mes "[贝贝]";
	mes "不久前，我带着宠物小野猪去妙勒尼山脉散步。它叫努克努克！";
	mes "我们遭到了袭击，不过幸好没有受伤。";
	next;
	switch(select("遭到袭击？:关于妙勒尼山脉:结束对话")) {
	case 1:
		mes "[贝贝]";
		mes "我正沿着狭窄小路行走，突然一株巨大丑陋的植物袭击了我和努克努克！";
		next;
		mes "[贝贝]";
		mes "我吓了一跳，只能和努克努克逃跑。我朝它扔石头，但似乎没能伤到它。它一定非常强！";
		next;
		mes "[贝贝]";
		mes "最令我吃惊的是，袭击我的植物竟是一朵长着人脸的巨大花朵！看到它们一定要小心，非常危险！";
		close;
	case 2:
		mes "[贝贝]";
		mes "妙勒尼山脉的美景令人着迷，但那里到处都是危险怪物！";
		next;
		mes "[贝贝]";
		mes "那里有花朵、昆虫、蜜蜂、蝴蝶和飞蛾，体型大得足以杀死粗心的人！";
		next;
		mes "[贝贝]";
		mes "不过，大多数怪物在你不先动手时不会伤害你。但有些怪物一看见你就会攻击！";
		close;
	case 3:
		mes "[贝贝]";
		mes "对了，我的努克努克在哪里……？";
		mes "努克努克！出来吧！";
		close;
	}
}

aldebaran,159,242,4	script	Insect Guy#alde	119,{
	mes "[Stromme]";
	mes "即使对强大的剑士来说，妙勒尼山脉的昆虫也是不小的威胁。交战前必须了解敌人！";
	next;
	if (select("关于昆虫:结束对话") == 1) {
		mes "[Stromme]";
		mes "蜜蜂、蝴蝶和飞蛾看似简单，但绝不能低估它们。";
		next;
		mes "[Stromme]";
		mes "这些昆虫历经演化，能够反击像你们冒险家这样的威胁！";
		next;
		mes "[Stromme]";
		mes "那里还有肉食性昆虫，例如蜘蛛、螳螂，以及像千足虫一样的蜘蛛怪。";
		next;
		mes "[Stromme]";
		mes "这些怪物发生了变异，对某些等级的人来说过于强大。尤其要提防蜘蛛怪。";
		next;
		mes "[Stromme]";
		mes "幸好它们视力很差，只要保持安全距离经过，它们就不会注意到你。";
		close;
	}
	mes "[Stromme]";
	mes "无论昆虫看起来多么无害漂亮，";
	mes "都要小心，不要触碰它们。";
	mes "它们外表无辜，力量却异常强大。";
	mes "不要小看妙勒尼山脉的生物。";
	close;
}

aldebaran,60,70,4	script	Sylvia#alde	69,{
	mes "[Sylvia]";
	mes "我从普隆德拉千里迢迢来到这里，因为听说卡普拉总部就在艾尔帕兰某处。";
	next;
	mes "[Sylvia]";
	mes "它应该不难找，但我很不擅长认路。不管怎么努力，总是会迷路！";
	next;
	mes "[Sylvia]";
	mes "更糟的是，我把放大镜忘在普隆德拉了。现在只能找人帮我鉴定这些武器！";
	next;
	if (select("鉴定？:那真不错。") == 1) {
		mes "[Sylvia]";
		mes "怪物掉落的装备无法立刻穿戴。";
		next;
		mes "[Sylvia]";
		mes "右键点击物品栏中的可装备物品，会看到它处于未鉴定状态，需要进行鉴定。该怎么办呢？";
		next;
		mes "[Sylvia]";
		mes "这种时候就得使用^3355FF放大镜^000000！";
		next;
		mes "[Sylvia]";
		mes "即使队伍里没有铁匠、炼金术士或商人，也能鉴定装备！当然，每次使用都会消耗一个放大镜……";
		close;
	}
	mes "[Sylvia]";
	mes "嘿……";
	mes "你刚才说话时，语气里是不是带着一点讽刺？";
	close;
}

aldebaran,93,80,4	script	Issei#alde	48,{
	mes "[Issei]";
	mes "艾尔帕兰是个美妙的地方，拥有浪漫的运河和古典建筑。我最喜欢和美丽的女友一起漫步城中。";
	next;
	if (select("你有女朋友？:结束对话。") == 1) {
		mes "[Issei]";
		mes "嘿……";
		mes "这有那么难以置信吗？！去问任何人都行！她真的存在！不过有时候，只是偶尔，她会对武器和防具兴奋过头。";
		next;
		mes "[Issei]";
		mes "我的意思是，她不享受浪漫晚餐，反而一直念叨怪物掉落的装备比商店出售的品质更高……";
		next;
		mes "[Issei]";
		mes "怪物掉落的装备通常插槽更多又怎样？！我连波利都打不过！";
		next;
		mes "[Issei]";
		mes "你也看得出来，";
		mes "我是个恋爱中的人，";
		mes "不是战士。";
		close;
	}
	mes "[Issei]";
	mes "所以，你不会觉得我很蠢吧？";
	close;
}

aldebaran,180,46,4	script	Joo Jahk#alde	88,{
	mes "[Joo Jahk]";
	mes "我是来自";
	mes "森林之城斐扬的";
	mes "游客。";
	next;
	mes "[Joo Jahk]";
	mes "艾尔帕兰的气温很凉爽，大概是因为水道。你觉得运河里的水能喝吗？";
	next;
	mes "[Joo Jahk]";
	mes "不过对我来说已经太迟了，因为我已经喝了一些。还是有点担心……";
	next;
	if (select("继续。:结束对话。") == 1) {
		mes "[Joo Jahk]";
		mes "我在米德加尔特旅行时，曾听一位高阶法师说，物理攻击和无属性魔法无法伤害念属性怪物。";
		next;
		mes "[Joo Jahk]";
		mes "知道这一点也许会派上用场。与怪物战斗时，一定要牢记技能和武器属性的重要性。";
		close;
	}
	mes "[Joo Jahk]";
	mes "话说回来，我喝的水味道确实不错。希望里面没有什么太奇怪的东西……";
	close;
}

aldebaran,212,122,4	script	Citizen#alde	97,{
	mes "[加文]";
	mes "欢迎！";
	mes "艾尔帕兰";
	mes "城镇";
	mes "欢迎你！";
	next;
	mes "[加文]";
	mes "好吧，这可能有些夸张。毕竟只有我一个人在欢迎你。";
	mes "你好！";
	next;
	if (select("现在说说怪物吧。:结束对话。") == 1) {
		mes "[加文]";
		mes "怪物……？";
		mes "我们是不是有点跑题了？啊，你一定是冒险家！";
		next;
		mes "[加文]";
		mes "满脑子都是工作，对吧？好吧，我最近确实看见过一只怪物……";
		next;
		mes "[加文]";
		mes "啊，我想起来了！就在几天前，我看到一只外形非常有趣的怪物！那是一只长着天使翅膀的波利！";
		next;
		mes "[加文]";
		mes "我发誓！它和一群普通波利在妙勒尼山脉附近跳来跳去。我觉得它就像它们的首领。";
		close;
	}
	mes "[加文]";
	mes "啊唔……";
	mes "别因为欢迎你的只有一个人而太失望！";
	close;
}


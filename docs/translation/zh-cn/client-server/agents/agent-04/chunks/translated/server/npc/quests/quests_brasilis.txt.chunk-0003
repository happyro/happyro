		mes "它不容易出现，即使对当地人来说也是神秘的花, 所以巴西利斯人相信找到它的人会获得巨大幸运。";
		next;
		mes "[卡门]";
		mes "作为植物学家，我一直在这里寻找幸运之花 但正如我所料，它还没有出现。";
		next;
		mes "[卡门]";
		mes "我相信只要坚持，这朵花会展现美丽光辉。";
		next;
		mes "[卡门]";
		mes "Ah, 如果你想进一步了解睡莲故事，去找一个叫玛尔塔的人。";
		mes "她很聪明，知道巴西利斯的许多故事。";
		brazil_regia = 1;
		setquest 2201;
		close;
	}
	else if (brazil_regia == 1) {
		mes "[卡门]";
		mes "Ah, 如果你想进一步了解睡莲故事，去找一个叫玛尔塔的人。";
		mes "她很聪明，知道巴西利斯的许多故事。";
		close;
	}
	else if (brazil_regia == 9) {
		mes "- 你向卡门展示莲花，谈论目前的故事。-";
		next;
		mes "[卡门]";
		mes "哇！！你的经历真精彩。";
		mes "所以～～～睡莲生活在巴西利斯深处，对吧？";
		mes "我会自己再次寻找它，绝不放弃！！";
		next;
		mes "[卡门]";
		mes "我很感激遇见你。";
		mes "睡莲一定真的是幸运之花。哈哈哈";
		brazil_regia = 10;
		completequest 2207;
		if (VIP_SCRIPT && vip_status(VIP_STATUS_ACTIVE))
			getexp 75000, checkre(0)?15000:0;
		else
			getexp 50000, checkre(0)?10000:0;
		close;
	}
	else {
		mes "[卡门]";
		mes "这里的气候为植物学提供了不同于世界其他地区的特殊案例。";
		next;
		mes "[卡门]";
		mes "这里的植物枝干强壮，清晰而多彩。";
		mes "这里的植物非常巨大，存在感十足。";
		next;
		mes "[卡门]";
		mes "这是植物学家的梦想。";
		close;
	}
}

bra_in01,142,27,5	script	Marta#bra	4_F_BRZ_INDOLD,{
	if (brazil_regia == 1) {
		mes "[Brasilis Boy]";
		mes "奶奶！那个人身上有奇怪的味道。";
		next;
		mes "[Marta]";
		mes "这个人不是本地人。";
		mes "向客人问好。";
		next;
		mes "[Brasilis Boy]";
		mes "嘿嘿～你好！！";
		mes "我叫卡卡！！";
		mes "你叫什么？";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "我是"+strcharinfo(0)+"。";
		next;
		mes "[Brasilis Boy]";
		mes "外来者的名字真奇怪！";
		mes "没关系！继续聊天就会成为朋友！打起精神！";
		next;
		mes "[Marta]";
		mes "嘿嘿……";
		mes "那么，你为什么来到这里，陌生人～？";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "听说你知道很多故事，是真的吗？";
		next;
		mes "[Kaka]";
		mes "哇！你怎么知道我奶奶知道很多故事，太厉害了～？";
		mes "奶奶既聪明又善良，我听过很多故事。";
		next;
		mes "[Marta]";
		mes "嘿嘿。卡卡每天晚上都听故事，他很喜欢我的故事。";
		mes "卡卡总问许多好奇的问题，让我很开心。这就是纯粹的幸福。";
		next;
		mes "[Marta]";
		mes "好，卡卡，邀请客人参加今天的小聚会吧？";
		next;
		mes "[Kaka]";
		mes "好的，奶奶～！！";
		next;
		mes "[Marta]";
		mes "嘿～你想听什么特别的故事？";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "关于神秘睡莲的？";
		next;
		mes "[Marta]";
		mes "睡莲……";
		mes "那是很久很久以前的事。";
		next;
		mes "[Marta]";
		mes "在巴西利斯建立之前，";
		mes "有个与巨大瀑布和丛林为友的部族，整日与大自然相伴。";
		next;
		mes "[Marta]";
		mes "部族首领有个漂亮女儿，名叫‘奈亚’。";
		next;
		mes "[Marta]";
		mes "奈亚像卡卡一样喜欢听故事，她的母亲每天晚上给她讲自然和神灵的故事。";
		next;
		mes "[Kaka]";
		mes "哇，她和我一样！";
		mes "她一定很漂亮……嘿嘿。";
		next;
		mes "[Marta]";
		mes "据她母亲说……";
		mes "如果天上的月亮爱上地上的女子，就会把她变成星星，让他们永远在一起。";
		next;
		mes "[Marta]";
		mes "奈亚听完故事后，去问父亲这是否是真的。";
		next;
		mes "[Kaka]";
		mes "那么，他怎么说？";
		next;
		mes "[Marta]";
		mes "^3131FF“亲爱的，月亮奈亚是最勇敢的人之一。但他不能再拥有新娘了。所以你不能成为星星……抱歉～”^000000";
		next;
		mes "[Kaka]";
		mes "奈亚想成为月亮的新娘吗？";
		next;
		mes "[Marta]";
		mes "是的，卡卡。想想月亮多么美丽神秘，正是女孩的理想。";
		next;
		mes "[Kaka]";
		mes "但月亮不再迎娶人类？奈亚后来怎么样了？";
		next;
		mes "[Marta]";
		mes "奈亚是个善良的女孩。";
		next;
		mes "[Marta]";
		mes "尽管父母试图阻止，她仍每天晚上去森林见月亮。";
		mes "可惜无论她多努力，月亮都没有回应。";
		next;
		mes "[Marta]";
		mes "一天，她来到山顶想离月亮更近，在湖边休息。";
		next;
		mes "[Marta]";
		mes "就在那时……奈亚看到了。";
		mes "月亮的光芒美丽地洒在波光粼粼的湖面。";
		next;
		mes "[Kaka]";
		mes "我知道，只是月亮倒映在水面上，对吧？！";
		next;
		mes "[Marta]";
		mes "是的，但对她而言，那景象让她毫不犹豫跳进湖中，最终溺水。";
		next;
		mes "[Kaka]";
		mes "哦，不。";
		next;
		mes "[Marta]";
		mes "月亮也从天空注视着她。";
		mes "他感到悲伤并怜悯她，于是决定把她变成美丽的花，感谢她的爱。";
		next;
		mes "[Marta]";
		mes "这就是人们称为巴西利斯水花的神秘花朵的故事。";
		mes "奈亚花白天呈淡白色，夜晚因与月亮的爱变成红色。";
		next;
		mes "[Kaka]";
		mes "好悲伤，但也很美！";
		next;
		mes "[Marta]";
		mes "你觉得呢，陌生人？";
		mes "喜欢这个故事吗？";
		mes "想听别的故事就来找我。";
		mes "如果不介意，陪我孙子玩一会儿吧。呵呵。";
		brazil_regia = 2;
		close;
	}
	else if (brazil_regia > 1) {
		mes "[Kaka]";
		mes "我奶奶忙部族事务有点累了！";
		mes "你改天再来好吗？";
		close;
	}
	else {
		mes "[Marta]";
		mes "你不是这里的人。";
		mes "我能感觉到奇怪的大地气息。";
		next;
		mes "[Marta]";
		mes "但你的眼睛闪耀着力量。";
		mes "你的全身散发着精神和意志。";
		next;
		mes "[Marta]";
		mes "继续努力，未来一定会成为伟大的人。";
		close;
	}
}
bra_in01,145,27,3	duplicate(Marta#bra)	Brasilis Boy#bra	472

brasilis,270,145,5	script	Brasilis Girl#bra	4_F_BRZ_INDIAN,5,5,{
	if (!checkweight(1201,1)) {
		mes "- 等一下！！ -";
		mes "- 你携带的物品太多 -";
		mes "- 无法再获得物品。 -";
		mes "- 减轻负重后 -";
		mes "- 再试一次。 -";
		close;
	}
	if (brazil_regia == 2) {
		mes "[Distant Sound]";
		mes "贾丝拉！！！";
		mes "你又要去哪儿？！！";
		mes "回来～拜托！！";
		next;
		mes "[Brasilis Girl]";
		mes "妈妈，我必须出去！！";
		next;
		mes "[Distant Sound]";
		mes "不行～！！你不能去！！";
		next;
		mes "[Brasilis Girl]";
		mes "天啊……今天也失败了。";
		next;
		mes "[Brasilis Girl]";
		mes "......";
		mes "怎么了？你为什么看我？";
		mes "我不想当表演女孩！！出去！！";
		next;
		if(select("没什么，抱歉。:怎么了？") == 1) {
			mes "[Brasilis Girl]";
			mes "我好难过！！！";
			close;
		}
		mes "[Brasilis Girl]";
		mes "不关你的事。";
		mes "你只是个外来者！";
		next;
		if(select("真没礼貌！:我只是想帮忙。") == 1) {
			mes "[Brasilis Girl]";
			mes "我没礼貌关你什么事？？！！";
			close;
		}
		mes "["+strcharinfo(0)+"]";
		mes "我只是路过，但也许能帮你。你觉得呢？";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "这样的相遇也许不只是巧合。";
		next;
		mes "[Brasilis Girl]";
		mes "......................";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "嗯，能告诉我你的名字吗？";
		next;
		mes "[Brasilis Girl]";
		mes "贾……";
		mes "贾丝拉。";
		mes "我叫贾丝拉。";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "好听的名字～";
		mes "贾丝拉，发生什么了？";
		next;
		mes "[Jasira]";
		mes ".............";
		next;
		mes "[Jasira]";
		mes "我必须见‘贾西’，但出不去……";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "贾西是谁？";
		mes "你的……恋人？";
		next;
		emotion ET_HUK;
		mes "[Jasira]";
		mes "恋……恋……恋人？？！！";
		mes "不可能～";
		next;
		mes "[Jasira]";
		mes "如果他是我的恋人就好了……但是……";
		next;
		mes "[Jasira]";
		mes "贾西是……";
		mes "伟大的月亮。";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "月亮？";
		mes "也许……你说的是故事里的月亮？";
		next;
		mes "[Jasira]";
		mes "没错！";
		mes "亲爱的贾西就是天上的月亮！";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "你为什么这么想？";
		next;
		mes "[Jasira]";
		mes "因为贾西很美，最重要的是他在照顾巴西利斯的睡莲。";
		next;
		emotion ET_HUK, playerattached();
		mes "["+strcharinfo(0)+"]";
		mes "巴西利斯睡莲？？！！";
		mes "那不是独特的花吗？";
		next;
		mes "[Jasira]";
		mes "没错。这是非常神秘、难以寻找的花。";
		mes "但贾西周围有许多睡莲。";
		mes "所以我相信贾西就是月亮。";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "贾西在哪里？";
		next;
		mes "[Jasira]";
		mes "他在丛林深处。";
		mes "如你所见我很虚弱，所以一直待在家里。但以前我强壮到可以离开村子。";
		next;
		mes "[Jasira]";
		mes "我在丛林里闲逛时摔倒了，就在那里见到了他。";
		mes "他非常友善，帮我疗伤并带我回家。";
		mes "那真是段美好时光。";
		next;
		mes "[Jasira]";
		mes "回家后，父母惩罚了我。";
		mes "我理解他们为什么担心，但我非常想念贾西！";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "恢复体力后再去见他怎么样？";
		next;
		mes "[Jasira]";
		mes ".................";
		mes "我现在就想见他……";
		next;
		if(select("帮助贾丝拉。:无视她。") == 2) {
			mes "["+strcharinfo(0)+"]";
			mes "抱歉，我帮不了你。振作起来！";
			next;
			mes "[Jasira]";
			mes "哭泣……";
			close;
		}
		mes "["+strcharinfo(0)+"]";
		mes "贾丝拉，我来这里寻找巴西利斯睡莲。";
		mes "你不觉得是命运让我们相遇吗？";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "如果告诉我如何找到贾西，我就能帮你。";
		next;
		mes "[Jasira]";
		mes "真的吗？但我不知道具体怎么去。我只是四处闲逛时遇到了他。";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "你什么都想不起来吗？";
		mes "知道什么就告诉我。";
		next;
		mes "[Jasira]";
		mes "让我想想……我在瀑布附近闲逛，掉进水里，然后被吸到某处。";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "很好，总比没有线索强！我会找类似的地方。";
		next;
		mes "[Jasira]";
		mes "我告诉了你情报，你能帮我个忙吗？";
		mes "很简单……";
		next;
		mes "[Jasira]";
		mes "我想送他美味的水果。";
		mes "贾西住的地方很舒适，但附近没有食物……看到好吃的水果他一定会开心！";
		next;
		mes "[Jasira]";
		mes "给他 10 根香蕉，告诉他我很想他。";
		mes "抱歉之前无视你。拜托，只有你能帮我！";
		brazil_regia = 3;
		changequest 2201,2202;
		close;
	}
	else if ((brazil_regia == 3) || (brazil_regia == 4)) {
		mes "[Jasira]";
		mes "遇到贾西后，给他 10 根香蕉。";
		mes "让我想想……我在瀑布附近闲逛，掉进水里，被吸到了某处。";
		next;
		mes "[Jasira]";
		mes "如果找不到路，就去瀑布，问问巴西利斯村的孩子。";
		mes "听说有个孩子以前去过奇怪的地方，也许和我去的是同一处！";
		close;
	}
	else if (brazil_regia == 5) {
		mes "[Jasira]";
		mes "你见到贾西了吗？";
		mes "有提到我吗？";
		mes "没有？呃？笨蛋！真是的～！";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "嘿，姑娘～你的脾气真急。";
		mes "我确实见过他，还和他谈起了你！";
		next;
		mes "[Jasira]";
		mes "真的吗？";
		mes "他说了什么？";
		mes "他还记得我吗？";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "我说你有一颗非常善良的心～";
		mes "我还告诉他，等你身体好些后会去见他。";
		next;
		mes "[Jasira]";
		mes "Yeahhhhh!!";
		mes "谢谢！你比我想象的更可靠。";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "总之，我在找一种棕色、外壳坚硬的水果。";
		mes "里面有汁液，还能当杯子用。";
		next;
		mes "[Jasira]";
		mes "笨蛋！你是说椰子吧？！";
		mes "巴西利斯到处都是。";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "Thanks Jasira!";
		brazil_regia = 6;
		changequest 2204,2205;
		close;
	}
	else if ((brazil_regia == 6) || (brazil_regia == 7)) {
		mes "[Jasira]";
		mes "我应该自己照顾好身体！";
		mes "不能永远躺在床上。你说对吧？";
		close;
	}
	else if (brazil_regia == 8) {
		mes "[Jasira]";
		mes "嗯？你怎么又回来了？";
		next;
		mes "- 你把 Jasi 要你转告的话告诉她 -";
		next;
		mes "[Jasira]";
		mes "Oh... really?";
		mes "Did he say that?";
		mes "Gosh! Gosh!!!";
		mes "Kkkkkaaaaa - !!";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "多亏了你，我才能得到一朵花。";
		mes "非常感谢！！";
		next;
		mes "[Jasira]";
		mes "哇哦。真漂亮。";
		next;
		mes "[Jasira]";
		mes "啊……能让我看一会儿吗？";
		next;
		mes "[Jasira]";
		mes "Surprise~!!";
		mes "你离开时我一直在制作这顶帽子，现在加上睡莲就完成了！";
		next;
		mes "[Jasira]";
		mes "我知道，我知道！我最厉害……";
		delitem 7553,1; //Lotus_Flower - untradable
		brazil_regia = 9;
		changequest 2206,2207;
		setarray .@card[0],4195,4177,4188; //Leaf_Cat_Card, Dryad_Card, Leib_Olmai_Card
		getitem2 5302,1,1,0,0,.@card[rand(3)],0,0,0; //Lotus_Flower_Hat
		close;
	}
	else if (brazil_regia > 8) {
		mes "[Jasira]";
		mes "我只需要再变强一点！";
		mes "不能永远躺在床上。我的 Jasi 还在等我～";
		close;
	}
	else {
		mes "[Distant Sound]";
		mes "Jasira!!!";
		mes "你又要去哪儿？！！";
		mes "请回来～！！";
		next;
		mes "[Brasilis Girl]";
		mes "妈妈，求你了～！";
		mes "让我走吧！";
		close;
	}
	end;

OnTouch:
	if (brazil_regia == 2)
		emotion ET_FRET;
	end;
}

bra_dun02,67,205,5	script	Recluse#bra	4_M_BRZ_JACI,3,3,{
	if (brazil_regia == 3) {
		mes "[Recluse]";
		mes "哦，我已经很久没见过其他人了。";
		next;

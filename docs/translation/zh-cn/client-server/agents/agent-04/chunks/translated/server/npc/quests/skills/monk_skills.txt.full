prt_monk,270,198,3	script	Apprentice Monk#qsk_mo	753,{
	if (BaseJob == Job_Monk) {
		if (MONK_SK == 7) {
			mes "[武僧]";
			mes "花时间";
			mes "思考你最重要的";
			mes "目标、最高";
			mes "优先级，从不浪费。";
			mes "不要混淆实现手段";
			mes "和你想达成的目标。";
			close;
		}
		if (MONK_SK == 6 && getskilllv("MO_KITRANSLATION") == 0) {
			mes "[武僧]";
			mes "你忘记了施展";
			mes "的基础";
			mes "精神传承？";
			mes "怎么会……？";
			next;
			mes "[武僧]";
			mes "啊，我明白了。";
			mes "你超越了曾经";
			mes "限制你的";
			mes "限制，成为了";
			mes "宗师。我很抱歉";
			mes "低估了你。";
			next;
			mes "[武僧]";
			mes "很好。能帮助你重新学习";
			mes "精神传承技能是我的荣幸。";
			mes "同时你可能会重新学会";
			mes "残酷掌。";
			next;
			mes "[武僧]";
			mes "现在保持安静放松，";
			mes "让我施展特殊";
			mes "指压治疗，把技能写入";
			mes "你的神经系统和";
			mes "运动记忆……";
			mes "";
			next;
			mes "^3355FF*嗒嗒嗒嗒嗒嗒嗒嗒-嗒嗒嗒嗒嗒嗒嗒嗒-";
			mes "嗒嗒嗒嗒嗒嗒嗒嗒-嗒嗒嗒嗒嗒嗒嗒嗒-";
			mes "嗒嗒嗒嗒嗒嗒嗒嗒-嗒嗒嗒嗒嗒嗒嗒嗒-";
			mes "嗒嗒嗒嗒嗒嗒* *戳*^000000";
			set MONK_SK,7;
			skill "MO_KITRANSLATION",1,SKILL_PERM;
			skill "MO_BALKYOUNG",1,SKILL_PERM;
			next;
			mes "[武僧]";
			mes "完成了。请继续使用这些";
			mes "特殊技能促进";
			mes "世界和平与和谐。";
			mes "";
			mes "再见，朋友。";
			close;
		}
		if (MONK_SK > 2) {
			mes "[武僧]";
			mes "花时间";
			mes "思考你最重要的";
			mes "目标、最高";
			mes "优先级，从不浪费。";
			mes "不要混淆实现手段";
			mes "和你想达成的目标。";
			next;
			mes "[武僧]";
			mes "啊，我想请你帮个忙。";
			mes "请不要告诉别人";
			mes "我教过你精神传承。";
			mes "我不想花时间给太多人";
			mes "教授这项技能……";
			mes "";
			close;
		}
		if (MONK_SK == 2) {
			if (Weight == 0) {
				mes "[武僧]";
				mes "啊，做得好。我看你已经";
				mes "学会了最重要的东西，";
				mes "";
				mes "无私。";
				mes "现在我相信你不会";
				mes "滥用我教给你的东西。";
				next;
				mes "[武僧]";
				mes "我的测试看起来可能太严格，";
				mes "但没有正确的纪律，就不可能学会";
				mes "精神传承。凡事都一样，所有领悟都要以准备和预备为先。";
				mes "";
				next;
				mes "[武僧]";
				mes "现在放松一会儿。";
				mes "我会用指压治疗";
				mes "训练你的神经系统，";
				mes "让身体记住精神传承";
				mes "所需的能量流动和动作。";
				mes "";
				next;
				mes "^3355FF*嗒……嗒*";
				mes "*嗒……嗒*";
				mes "*嗒嗒嗒*^000000";
				next;
				mes "^3355FF*嗒嗒嗒*";
				mes "*嗒嗒嗒*";
				mes "*嗒……嗒嗒*^000000";
				next;
				mes "^3355FF*嗒嗒嗒嗒嗒嗒嗒嗒-嗒嗒嗒嗒嗒嗒嗒嗒-";
				mes "嗒嗒嗒嗒嗒嗒嗒嗒-嗒嗒嗒嗒嗒嗒嗒嗒-";
				mes "嗒嗒嗒嗒嗒嗒嗒嗒-嗒嗒嗒嗒嗒嗒嗒嗒-";
				mes "嗒嗒嗒嗒嗒嗒* *戳*^000000";
				next;
				mes "[武僧]";
				mes "完成了。你现在已经";
				mes "能够使用精神传承。啊，对了，";
				mes "我从未真正给这项技能命名，";
				mes "但见过它的其他武僧通常都这样称呼它。";
				mes "";
				next;
				mes "[武僧]";
				mes "记住，这项技能的吟唱时间和技能延迟";
				mes "都很长，所以要谨慎使用。";
				mes "这项技能可以消耗 40 SP，";
				mes "将一个气弹交给队伍中的一名";
				mes "成员。";
				next;
				mes "[武僧]";
				mes "你练习后会更好地理解";
				mes "这项技能的用法。请记住，";
				mes "有时可能必须战斗，";
				mes "但战斗只是达成目的的手段，";
				mes "而不是目的本身。";
				mes "";
				set MONK_SK,3;
				skill "MO_KITRANSLATION",1,SKILL_PERM;
				next;
				mes "[武僧]";
				mes "我们的技能不应被用来流血。";
				mes "如果你能超越冲突，";
				mes "就会明白战斗没有意义，";
				mes "也没有价值。愿和平";
				mes "与你同在，我的朋友。";
				mes "";
				close;
			}
			else {
				mes "[武僧]";
				mes "你学会无私的";
				mes "意义了吗？";
				mes "当你放下贪婪";
				mes "和世俗的欲望，";
				mes "就准备好接受我的教导了。";
				close;
			}
		}
		if (MONK_SK == 1) {
			mes "[武僧]";
		mes "战斗毫无意义。";
		mes "超越冲突和差异，";
		mes "认识到万物皆为一体。";
		mes "约束你的心，";
		mes "真相就会显现。";
		mes "";
			next;
			mes "[武僧]";
		mes "嗯？你为何来拜访我？啊，原来";
		mes "你想学习我开发的技能。我的同伴说得对：";
		mes "想学这项技能的人越来越多了。";
		mes "";
			next;
			mes "[武僧]";
		mes "不要误会我。";
		mes "力量与正义、智慧与行动";
		mes "确实必须保持平衡。可是，";
		mes "来访者中有太多渴望力量、嗜血的人。";
		mes "";
			next;
			mes "[武僧]";
		mes "为了公平起见，我会";
		mes "给你一次机会。向我证明";
		mes "你会将我教给你的技能";
		mes "用于和平与正义。证明";
		mes "你没有自私之心。";
		mes "";
			set MONK_SK,2;
			close;
		}
	}
	mes "[武僧]";
	mes "战斗毫无意义。";
	mes "超越冲突和差异，";
	mes "认识到万物皆为一体。";
	mes "约束你的心，";
	mes "真相就会显现。";
	mes "";
	close;
}

monk_test,316,69,5	script	Monk#qsk_mo	823,{
	if (BaseJob == Job_Monk) {
		if (MONK_SK == 6) {
			mes "[武僧]";
			mes "你是怎么说服那个武僧";
			mes "教你";
			mes "精神传承？ It'd";
			mes "推广我们的两项专长技能当然很好，";
			mes "但这个世界可能还没有准备好。";
			close;
		}
		if (MONK_SK == 5) {
			mes "[武僧]";
			mes "首先，残酷掌需要将你的";
			mes "内在力量转化为";
			mes "外在力量。然后，";
			mes "把所有力量集中到掌心。做错的话你会爆炸。";
			next;
			mes "[武僧]";
			mes "这项技能会造成剧烈疼痛，";
			mes "消耗 20 SP 甚至 10 HP。它会";
			mes "击退魔物并有机会使其昏迷，";
			mes "但只有目标魔物会受到伤害。";
			mes "";
			next;
			mes "[武僧]";
			mes "如果你对其他玩家使用这项技能，";
			mes "会造成一定伤害，";
			mes "但不会击退目标附近的其他玩家。";
			mes "明白了吗？";
			mes "";
			next;
			mes "[武僧]";
			mes "总之，继续练习这些原则，";
			mes "你就能掌握残酷掌。";
			mes "既然你已经学会精神传承，";
			mes "就一定能做到。";
			mes "";
			mes "";
			set MONK_SK,6;
			skill "MO_BALKYOUNG",1,SKILL_PERM;
			next;
			mes "[武僧]";
			mes "好了，我们的课程完成了。";
			mes "希望你使用新技能";
			mes "为正义而战，";
			mes "对抗邪恶。暂时再见，";
			mes "我的朋友。";
			mes "";
			close;
		}
		if (MONK_SK == 4 && countitem(905) > 19 && countitem(711) > 2) {
			mes "[武僧]";
			mes "那是什么……？";
			mes "你已经学会了";
			mes "精神传承技能？";
			mes "我猜你接下来想学";
			mes "残酷掌。对吗？";
			mes "";
			next;
			mes "[武僧]";
			mes "嗯，你的实力足以轻松击败";
			mes "许多曼陀罗魔花。";
			mes "好吧，你似乎准备好了。过一会儿再回来，";
			mes "这样我就能完成准备工作。";
			mes "";
			delitem 905,20; //Stem
			delitem 711,3; //Shoot
			set MONK_SK,5;
			close;
		}
		if (MONK_SK == 4) {
			mes "[武僧]";
			mes "那是什么……？";
			mes "你已经学会了";
			mes "精神传承技能？";
			mes "我猜你接下来想学";
			mes "残酷掌。对吗？";
			mes "";
			next;
			mes "[武僧]";
			mes "正如我之前告诉你的，";
			mes "你必须征服曼陀罗魔花，";
			mes "以证明你在力量和慈悲方面";
			mes "具备学习残酷掌的资格。";
			mes "";
			mes "";
			next;
			mes "[武僧]";
			mes "战斗吧，保护那些被凶猛的";
			mes "曼陀罗魔花恐吓的无辜者。";
			mes "如果你带来^FF000020 个茎^000000和";
			mes "^FF00003 个新芽^000000，";
			mes "我就认可你能力的证明。";
			next;
			mes "[武僧]";
			mes "现在明白了吗？";
			close;
		}
		if (MONK_SK == 3) {
			mes "[武僧]";
			mes "你是来学习残酷掌的吗？";
			mes "要是事情真有那么简单就好了。";
			mes "要满足你的要求，";
			mes "我们面前有两个障碍。";
			mes "";
			next;
			mes "[武僧]";
			mes "首先，你必须事先学会";
			mes "精神传承技能。让那位武僧";
			mes "教给你会很困难，";
			mes "甚至完全不可能。";
			mes "";
			mes "";
			next;
			mes "[武僧]";
			mes "其次，你需要通过我的";
			mes "力量小测试，让我确认";
			mes "你的身体能够承受使用";
			mes "残酷掌所涉及的强大力量。";
			mes "";
			mes "";
			next;
			mes "[武僧]";
			mes "嗯，我知道曼陀罗魔花";
			mes "一直在威胁旅行者，";
			mes "所以如果你能证明自己一直在猎杀它们，";
			mes "就能证明你值得学习";
			mes "残酷掌。";
			mes "";
			next;
			mes "[武僧]";
			mes "如果你能设法说服那位武僧";
			mes "教你施展精神传承，";
			mes "我就会要求你带来";
			mes "猎杀曼陀罗魔花获得的^FF000020 个茎^000000和";
			mes "^FF00003 个新芽^000000。";
			mes "";
			next;
			mes "[武僧]";
			mes "当然，如果你不先学会";
			mes "精神传承技能，";
			mes "完成我的测试也没有意义。";
			mes "祝你好运……";
			mes "";
			set MONK_SK,4;
			close;
		}
		if (MONK_SK == 1) {
			mes "[武僧]";
		mes "有一位隐居的和平主义武僧";
		mes "可以传授精神传承。可是，";
		mes "他很固执，拒绝了许多想向他学习的人。";
		mes "";
		mes "";
			next;
			mes "[武僧]";
		mes "如果你能说服他";
		mes "教给你这项技能就好了，";
		mes "因为一个人不可能学会";
		mes "如何施展这项技能。";
		mes "真是太可惜了……";
		mes "";
			close;
		}
		if (MONK_SK == 0) {
			mes "[武僧]";
		mes "没有正义的力量不会长久。";
		mes "没有力量的正义无法维持。";
		mes "力量不等于正义，";
		mes "但真正的正义可以成为";
		mes "获得力量的手段。";
		mes "";
			next;
			mes "[武僧]";
		mes "永远记住这个真理。";
		mes "正义与力量、慈悲与强大，";
		mes "智慧与行动都是相辅相成的，";
		mes "相互配合，必须始终";
		mes "保持和谐平衡。";
			next;
			mes "[武僧]";
		mes "一些技能也是如此。";
		mes "我开发了一项";
		mes "力量的纯粹体现，";
		mes "残酷掌！";
		mes "然而，没有互补技能来平衡它，";
		mes "这项技能就毫无用处。";
			next;
			mes "[武僧]";
		mes "与我的技能互补的技能";
		mes "叫作精神传承，只能由一位武僧";
		mes "传授。然而，他认为其他人不配，";
		mes "所以拒绝教给他们。";
		mes "";
			next;
			mes "[武僧]";
		mes "虽然我告诉过他应该推广";
		mes "那项技能的教导，但我必须尊重他的决定。";
		mes "不过，如果你想学习新技能，";
		mes "可以试着和他谈谈。";
			set MONK_SK,1;
			next;
			mes "[武僧]";
		mes "要找到他，只要去找那个";
		mes "总是宣扬战斗空虚意义的";
		mes "武僧就行了。那就是他。";
		mes "";
			close;
		}
	}
	mes "[武僧]";
	mes "没有正义的力量不会长久。";
	mes "没有力量的正义无法维持。";
	mes "力量不等于正义，";
	mes "但真正的正义可以成为";
	mes "获得力量的手段。";
	mes "";
	close;
}


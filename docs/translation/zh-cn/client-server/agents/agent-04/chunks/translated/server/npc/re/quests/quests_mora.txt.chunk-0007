				mes "你收集的样本属于普通物种。";
				emotion ET_PROFUSELY_SWEAT;
				next;
				mes "[拉弗尔研究员]";
				mes "一定是因为有太多种生物";
				mes "待在浴池里。";
				next;
				mes "[拉弗尔研究员]";
				mes "抱歉，请重新收集样本。";
			mes "这次是 "+.@str$[1]+"……没错。";
				mes "请带来 "+.@str$[0]+" 样本。";
				erasequest 5023;
				setquest .@quest;
				close;
			}
			mes "[拉弗尔研究员]";
			mes "太好了！这些样本肯定";
			mes "来自神秘生物。";
			next;
			mes "[拉弗尔研究员]";
			mes "根据分析，";

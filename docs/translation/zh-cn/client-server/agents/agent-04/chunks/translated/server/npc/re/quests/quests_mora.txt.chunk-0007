		mes "你来了？终于，";
		mes "实验结果全部出来了。";
		mes "想看看结果吗？";
		next;
		switch(select("Actually, I don't want to.:Look at the results.")) {
		case 1:
			mes "[拉弗尔研究员]";
			mes "想得好。其实，普通人看这个可能会头疼。";
			mes "我想现在是给你奖励的时候了，";
			mes "感谢你一直以来的帮助。";
			next;
			mes "[拉弗尔研究员]";
			mes "实验前我和你谈过奖励吗？";
			mes "我说过你不会后悔帮忙……";
			next;
			break;
		case 2:
			mes "[拉弗尔研究员]";
			mes "你对结果好奇？真的吗？？？";
			mes "好，给你。";
			next;
			callsub L_ShowReport;
			mes "[拉弗尔研究员]";
			mes "附近没有火山";
			mes "过去也没有火山记录，";
			mes "但水温却这么高……";
			mes "很令人惊讶，对吧？";
			next;
			mes "[拉弗尔研究员]";
			mes "成分是……没错。";
			mes "确实有对人类有益的物质。";
			mes "但也有一些物质";
			mes "对我们拉弗尔，";
			mes "或其他种族来说是致命的。";
			next;
			mes "[拉弗尔研究员]";
			mes "如果观察导电率，";
			mes "它明显高于普通水。";
			mes "我的理论是，";
			mes "这一定是神秘力量的来源。";
			mes "我就是这么想的。";
			mes "总之。";
			next;
			mes "[拉弗尔研究员]";
			mes "浴池水中存在科学无法解释的东西……";
			mes "以那只未确认生物为例。";
			mes "一条鱼能生活在";
			mes "这么温暖的水中，";
			mes "不是很奇怪吗？";
			next;
			mes "[拉弗尔研究员]";
			mes "我对研究结果和结论不满意。";
			mes "我想最终，";
			mes "它仍会是个谜……";
			next;
			mes "[拉弗尔研究员]";
			mes "我想现在是给你奖励的时候了，";
			mes "感谢你一直以来的帮助。";
			next;
			mes "[拉弗尔研究员]";
			mes "实验前我和你谈过奖励吗？";
			mes "我说过你不会后悔帮忙……";
			next;
			break;
		}
		mes "[拉弗尔研究员]";
		mes "我一直在想你想要什么";
		mes "作为奖励……然后感到";
		mes "有点……悲伤。";
		next;
		mes "[拉弗尔研究员]";
		mes "... ... ... ...";
		next;
		mes "[拉弗尔研究员]";
		mes "我们一起进行这些项目的短暂时光里，";
		mes "我把你派到了各处。";
		mes "一定很辛苦，但你从未抱怨。";
		mes "和我以前遇到的其他人不同，";
		mes "你从未偷懒。";
		next;
		mes "[拉弗尔研究员]";
		mes "我想我已经喜欢上你了，";
		mes "所以说再见让我很难过……";
		next;
		mes "[拉弗尔研究员]";
		mes "不过还是谢谢你。我研究了一段时间，";
		mes "但从没遇到过像你这样优秀的研究助手。";
		next;
		if (MaxWeight - Weight < 100 || checkweight(1092,1) == 0) {
			mes "[拉弗尔研究员]";
			mes "嗯？对了……";
			mes "你携带的东西太多。";
			mes "难道是因为你也在为";
			mes "分别而悲伤？";
			next;
			mes "[拉弗尔研究员]";
			mes "带着这么多东西，我无法给你奖励！";
			close;
		}
		mes "[拉弗尔研究员]";
		mes "我人生中最好的研究助手……";
		mes "就是你，"+strcharinfo(0)+"！！！";
		set ep14_1_muk,15;
		completequest 5028;
		getexp 1000000,4000000;
		getitem 6380,30; //Mora_Coin
		next;
		mes "[拉弗尔研究员]";
		mes "如果我们再次偶遇，";
		mes "再一起做研究项目吧。";
		close;
	} else if (ep14_1_muk == 15) {
		mes "[拉弗尔研究员]";
		mes "嗯？不是吗……？你来这里做什么？";
		next;
		mes "[拉弗尔研究员]";
		mes "难道你突然想看看";
		mes "研究报告？？？";
		next;
		switch(select("查看报告。:我只是来打招呼。")) {
		case 1:
			mes "[拉弗尔研究员]";
			mes "我以前没给你看过吗？";
			next;
			mes "[拉弗尔研究员]";
			mes "... ... ... ...";
			emotion ET_THINK;
			next;
			mes "[拉弗尔研究员]";
			mes "也许我确实没给你看过。";
			mes "抱歉。你这么想看，";
			mes "所以特意回来找我吗？";
			mes "很好，给你。";
			next;
			while(1) {
				callsub L_ShowReport;
				mes "[拉弗尔研究员]";
				mes "这就是";
				mes "莫拉村神秘浴池的报告。";
				mes "还想再看吗？";
				emotion ET_QUESTION;
				next;
				switch(select("再看一次。:不再看。")) {
				case 1:
					mes "[拉弗尔研究员]";
					mes "当然……如你所愿！！";
					next;
					break;
				case 2:
					mes "[拉弗尔研究员]";
					mes "再见。随时欢迎，";
					mes "想再看结果时就来。";
					mes "这里永远欢迎你。";
					close;
				}
			}
		case 2:
			mes "[拉弗尔研究员]";
		mes "哦，你是来打招呼的。我明白了。";
		mes "好久不见，"+strcharinfo(0)+"。";
			next;
			mes "[拉弗尔研究员]";
		mes "我一直说，选你当研究助手真是幸运。";
		mes "想再看结果时，";
		mes "随时都可以来。";
		mes "这里永远欢迎你。";
			close;
		}
	} else {
		mes "[拉弗尔研究员]";
	mes "嗯？我是 Inffle 研究员。";
	mes "你是谁？";
		close;
	}
	end;
L_ShowReport:
	mes "[实验结果]";
	mes "*** 研究员 - Inffle";
	mes "*** 研究助手 - "+strcharinfo(0);
	mes " ";
	mes "<研究主题>";
	mes "*** 莫拉村浴池";
	mes " ";
	mes "<目标>";
	mes "调查浴池水的神秘力量";
	mes "并找出更好利用";
	mes "这种水的方法。";
	mes " ";
	mes "<方法>";
	mes "1. 获取未确认的 DNA 样本。";
	mes "获取未确认 DNA 的样本，";
	mes "并收集更多样本进一步研究。";
	mes " ";
	mes "2. 对未确认 DNA 进行比较分析";
	mes "得出结论，该 DNA 属于";
	mes "生活在浴池水中的未确认生物。";
	mes "其成分组合结果";
	mes "来自旗鱼 DNA。";
	mes " ";
	mes "3. 研究村子周围的水洼";
	mes "从村子周围的四个水洼中，";
	mes "确认测试物质";
	mes "均匀分布在水洼中。";
	mes "推测四个水洼";
	mes "组合并产生";
	mes "神秘力量。";
	mes " ";
	mes "<材料分析>";
	mes "*** 温度 ***** 33.5��";
	mes "*** PH ************ 9.8";
	mes "*** 固体残留物 *** 176";
	mes "*** K+ ************ 0,23";
	mes "*** Ca++ ********** 1.83";
	mes "*** Cl- *********** 26.2";
	mes "*** 碳酸氢根 ********* 31.0";
	mes "*** H2S *********** 1.7";
	mes "*** Na++ ********** 51.9";
	mes "*** Mg+ *********** 0.03";
	mes "*** SO4- ********** 5.0";
	mes "*** F ************* 12.8";
	mes "*** 二氧化硅 ********** 23.9";
	mes "*** Li ************ 0.06";
	mes "*** CO3+ ********** 22.8";
	mes "*** Sr ************ 0.04";
	mes "*** Ge ************ 0.004";
	mes "*** 总固体 ****** 165";
	mes "*** 电导率 **** 500";
	mes "*** 经度 ********** 4.6";
	next;
	return;
L_CheckWeight:
	if (MaxWeight - Weight < 100 || checkweight(1092,1) == 0) {
		mes "[拉弗尔研究员]";
		mes "你携带的物品太多。";
		mes "我无法给你样本管。";
		mes "减轻负重后再回来吧。";
		close;
	}
	return;
}

mora,114,79,0	script	Black Shadow#ep14_muk	844,{
	if (checkweight(1201,1) == 0 || MaxWeight - Weight < 500) {
		mes "^FF0000- 警告信息 -";
		mes "- 等一下！！-";
		mes "- 你携带了太多物品-";
		mes "- 无法再接收物品。-";
		mes "- 请减轻负重-";
		mes "- 再试一次。-^000000";
		close;
	}
	if (BaseLevel < 100) {
		mes "有什么东西从头到脚打量你，然后嘲笑着消失了。";
		close2;
		donpcevent "Black Shadow#ep14_muk::OnDisable";
		end;
	}
	set .@playtime, checkquest(5029,PLAYTIME);
	if (.@playtime == 0 || .@playtime == 1) {
		mes "你看到一个黑洞。你表现出兴趣后，某种东西迅速消失在黑洞中。";
		close2;
		donpcevent "Black Shadow#ep14_muk::OnDisable";
		end;
	} else if (.@playtime == 2)
		erasequest 5029;
	if (ep14_1_goki == 30) {
		if (checkquest(5030) == -1 && checkquest(5031) == -1 && checkquest(5032) == -1 && checkquest(5033) == -1 && checkquest(5034) == -1) {
			mes "[Unidentified creature]";
			mes "啊啊啊！！！";
			mes "你为什么打扰我。";
			mes "别再欺负我。";
			next;
			if(select("Bully anyway.:I'll stop.") == 1) {
				emotion ET_CRY;
				set ep14_1_goki,0;
				close2;
				donpcevent "Black Shadow#ep14_muk::OnDisable";
				end;
			}
			mes "[Unidentified creature]";
			mes "你……很好。";
			mes "大家都叫我怪物。";
			mes "打我。欺负我。我累了。";
			next;
			mes "[Fishee]";
			mes "我叫 Fishee。";
			mes "爸爸给我取的名字。";
			next;

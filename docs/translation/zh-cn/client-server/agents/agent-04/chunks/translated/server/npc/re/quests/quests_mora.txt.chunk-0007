		next;
		mes "[拉弗尔研究员]";
		mes "现在我要用这些样本";
		mes "进行研究，";
		mes "观察这些水洼";
		mes "与浴池之间的关系。";
		next;
		if (checkweight(6380,4) == 0) {
			mes "[拉弗尔研究员]";
			mes "我知道你做了很多……";
			mes "但你携带的东西太多。";
			mes "虽然我想给你零花钱，但做不到。";

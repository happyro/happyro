		close;
	} else if (ep14_1_muk == 14) {
		if (checkquest(5028,PLAYTIME) == 0 || checkquest(5028,PLAYTIME) == 1) {
			mes "[拉弗尔研究员]";
			mes "什么？你来了？嗯……";
			next;
			mes "[拉弗尔研究员]";
			mes "但样本研究还没完成。";
			mes "这是为了得出最终结果的实验，";

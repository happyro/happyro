//===== rAthena Script =======================================
//= Nightmarish Jitterbug
//===== Description: =========================================
//= [Walkthrough Conversion]
//= Nightmarish Jitterbug Instance
//===== Changelogs: ==========================================
//= 1.0 First version. [Capuche]
//= 1.0.1 Fix Cutin Aigu. [mazvi]
//============================================================

moc_para01,26,95,5	script	Roel#sara	4_M_ROEL,{
	cutin "roel01",0;
	if (BaseLevel < 120) {
		mes "[罗尔]";
		mes "我们正在寻找能加入全新冒险的冒险者。如果你的等级符合接受 IGU 任务的要求，就有资格参加。";
		close3;
	}
	switch( isbegin_quest(13183) ) {// Nightmarish Jitterbug: Completed
	case 0:
		switch( isbegin_quest(13181) ) {// Nightmarish Jitterbug
		case 0:
			mes "[罗尔]";
			mes "我是 Roel，白翼公会的新成员。Roter 让我四处寻找 Newoz，我找到了一些关于他下落的线索。";
			next;
			mes "[罗尔]";
			mes "招募公会新人！加入我们寻找前任会长 Newoz 的行动！感兴趣吗？";
			next;
			if (select( "是。", "不。" ) == 1) {
				cutin "roel02",0;
				mes "[罗尔]";
				mes "真是艰难的任务。我从世界这头找到那头，却连他的影子都没找到。";
				next;
				cutin "roel01",0;
				mes "[罗尔]";
				mes "我试着寻找他的踪迹，但毫无结果。";
				next;
				mes "[罗尔]";
				mes "Newoz 是个热衷冒险的家伙，从不在一个地方久留；很多人声称见过他，却没人记得他去了哪里。";
				next;
				mes "[罗尔]";
				mes "过了一阵子，我只好放弃追踪他。那只是在浪费时间。";
				next;
				mes "[罗尔]";
				mes "我把目光转向异世界，在那里遇到了一些目击者。他们带我去了最后一次见到 Newoz 的地方。";
				next;
				mes "[罗尔]";
				mes "整个过程非常痛苦。要不是 Runane，我们不可能记住他最后出现的位置，也不可能从那里出来。";
				next;
				mes "[罗尔]";
				mes "如果你有兴趣加入，请和 Runane 谈谈。前方有精彩的冒险。";
				setquest 13181;// Nightmarish Jitterbug
			}
			close3;
		case 1:
			mes "[罗尔]";
			mes "如果你有兴趣加入，请和 Runane 谈谈。";
			close3;
		case 2:
			cutin "roel03",0;
			mes "[罗尔]";
			mes "这是我成为白翼成员后的第一次冒险。我迫不及待想开始下一次！";
			erasequest 13181;
			setquest 13183;// Nightmarish Jitterbug: Completed
			completequest 13183;
			getexp 1500000,500000;
			close3;
		}
		end;
	case 1:
	case 2:
		switch( isbegin_quest(13181) ) {
		case 0:
			mes "[罗尔]";
			mes "你觉得 Shaloshi 现在在哪里？ 我们遇到 Shaloshi 的空间陷入时间循环，不断重复同样的事件。";
			next;
			mes "[罗尔]";
			mes "Mingmin 认为这种现象与次元裂缝和 Shaloshi 的能力有关。";
			next;
			mes "[罗尔]";
			mes "我不太明白她的意思，但 Runane 说，通往她记忆地点的传送门依据的是时间，而不是空间。";
			next;
			mes "[罗尔]";
			mes "如果你愿意，可以回到过去体验同样的事件。要再次踏上冒险吗？";
			next;
			if (select( "是。", "不。" ) == 1) {
				mes "[罗尔]";
				mes "这次在充满不可理解谜团的地方，你也许会有不同的体验。请让 Runane 为你打开传送门。";
				next;
				mes "[罗尔]";
				mes "这次，也许你不用离开 Shaloshi。";
				setquest 13181;// Nightmarish Jitterbug
			}
			close3;
		case 1:
			mes "[罗尔]";
			mes "准备好了吗？如果没有信心，也可以放弃。";
			next;
			if (select( "不。", "放弃。" ) == 1) {
				mes "[罗尔]";
				mes "就是这种精神！";
				close3;
			}
			erasequest 13181;
			close3;
		case 2:
			cutin "roel03",0;
			mes "[罗尔]";
			mes "冒险总是很有趣。成为一名出色的冒险者，好吗？";
			erasequest 13181;
			getexp 1500000,500000;
			close3;
		}
	}
}

moc_para01,29,95,5	script	Runane#sara	4_F_RUNAIN,{
	cutin "lunain01",0;
	if (BaseLevel < 120) {
		mes "[Runane]";
		mes "^ff0000你必须达到 120 级。^000000";
		close3;
	}
	if (isbegin_quest(13181) != 1) {
		mes "[Runane]";
		mes "^ff0000如果你想使用我的次元传送门，必须先和 Roel 谈谈。传送门不是对所有人开放的。^000000";
		close3;
	}
	.@party_id = getcharid(1);
	.@md_name$ = "Nightmarish Jitterbug";
	if (.@party_id < 1) {
		mes "[Runane]";
		mes "^ff0000进入这个副本前，你必须组建或加入至少 1 人的队伍。^000000";
		close3;
	}
	switch( checkquest(13182,PLAYTIME) ) {
	case -1:
		break;
	case 0:
	case 1:
		mes "[Runane]";
		mes "^ff0000最近一次进入后 20 小时内无法使用此次元传送门。^000000";
		close3;
	case 2:
		mes "[Runane]";
		mes "传送门现在可以使用。";
		erasequest 13182;// Nightmarish Jitterbug: Waiting
		close3;
	}
	if (is_party_leader() == true)
		.@menu$ = "打开次元传送门。";
	switch( select( .@menu$, "进入" + .@md_name$ + "。", "取消。" ) ) {
	case 1:
		if (instance_create(.@md_name$) < 0) {
			mes "队伍名称：" + getpartyname( getcharid(1) );
			mes "队长：" + strcharinfo(0);
			mes "^0000ff" + .@md_name$ + " ^000000- 创建失败！";
			close3;
		}
		mes "[Runane]";
		mes "^ff0000正在准备次元传送门……^000000";
		mes "^ff0000请稍候。^000000";
		close3;
	case 2:
		switch( instance_enter(.@md_name$) ) {
		case IE_NOMEMBER:
			close3;
		case IE_NOINSTANCE:
			if (is_party_leader() == false) {
				mes "[Runane]";
				mes "正在传送……";
				next;
				mes "[Runane]";
				mes "^ff0000请注意，最近一次进入后 23 小时内无法再次使用此传送门。^000000";
				next;
			}
			mes "[Runane]";
			mes "^ff0000你的队长还没有创建时间裂缝。^000000";
			close3;
		case IE_OTHER:
			mes "发生未知错误。";
			close3;
		case IE_OK:
			setquest 13182;// Nightmarish Jitterbug: Waiting
			mapannounce "moc_para01", "" + strcharinfo(0) + " of the party, " + getpartyname( getcharid(1) ) + ", is entering the " + .@md_name$ + ".", bc_map, 0xFF99;
			specialeffect2 EF_READYPORTAL2;
			specialeffect2 EF_PORTAL2;
			// warp "1@jtb",16,17;
			end;
		}
	case 3:
		cutin "",255;
		end;
	}
}


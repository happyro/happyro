// Room 1 : Entrance
1@jtb,28,30,5	script	Newoz#01	4_M_NEWOZ,{
	if ('room != 1 || is_party_leader() == false) {
		cutin "nines02",0;
		mes "[Newoz]";
		mes "我们的冒险还没开始，我已经饿了。";
		close3;
	}
	if (select( "交谈。", "快点。" ) == 2 && isbegin_quest(13183) == 2) {
		mes "一边赶路，一边努力回忆。";
		if ('room == 1 && is_party_leader() == true) {
			if ('additionnal_option) {// officially not disabled when choose hurry
				disablenpc instance_npcname("Roel#01");
				disablenpc instance_npcname("Melody-Jack#01");
				disablenpc instance_npcname("Arang#01");
				disablenpc instance_npcname("Lagi#01");
				disablenpc instance_npcname("Aigu#01");
				disablenpc instance_npcname("Mingmin#01");
				disablenpc instance_npcname("Runane#01");
				disablenpc instance_npcname("Gelka#01");
				disablenpc instance_npcname("Roter#01");
				disablenpc instance_npcname("Newoz#01");
			}
			donpcevent 'jitterbug_main$ + "::OnNextIs2";
		}
		close;
	}
	.@roel$ = instance_npcname("Roel#01");
	.@melody$ = instance_npcname("Melody-Jack#01");
	.@arang$ = instance_npcname("Arang#01");
	.@lagi$ = instance_npcname("Lagi#01");
	.@aigu$ = instance_npcname("Aigu#01");
	.@mingmin$ = instance_npcname("Mingmin#01");
	.@runane$ = instance_npcname("Runane#01");
	.@gelka$ = instance_npcname("Gelka#01");
	.@roter$ = instance_npcname("Roter#01");

	cutin "nines02",0;
	mes "[Newoz]";
	mes "看来大家都到了。";
	npctalk "Newoz: 看来大家都到了。";
	emotion ET_DELIGHT;
	next;
	cutin "rote03",0;
	mes "[Roter]";
	mes "I told you, Newoz. We can't just let this go.";
	npctalk "Roter：我说过了，Newoz。我们不能就这样算了。", .@roter$;
	emotion ET_FRET, getnpcid(0,.@roter$);
	next;
	if ('room == 1 && is_party_leader() == true)
		donpcevent 'jitterbug_main$ + "::OnNextIs2";
	cutin "min02",0;
	mes "[Mingmin]";
	mes "考虑到我们在你身上浪费的时间和金钱，你应该被喂一篮毒蘑菇。";
	npctalk "Mingmin: 考虑到我们在你身上浪费的时间和金钱，你应该被喂一篮毒蘑菇。", .@mingmin$;
	next;
	cutin "nines04",0;
	emotion ET_DELIGHT;
	mes "[Newoz]";
	mes "我会解释一切。别再提毒蘑菇了，我根本不能吃蘑菇。";
	npctalk "Newoz: 我会解释一切。别再提毒蘑菇了，我根本不能吃蘑菇。";
	next;
	cutin "igu05",2;
	mes "[Aigu]";
	mes "Newoz，你除了肉什么都不能吃。唉，看到你平安真好。";
	npctalk "Aigu：Newoz，你除了肉什么都不能吃。唉，看到你平安真好。", .@aigu$;
	next;
	cutin "gelca03",0;
	mes "[Gelka]";
	mes "你就是大名鼎鼎的 Newoz！很高兴认识你。我师父告诉过我许多你的伟大事迹……";
	npctalk "Gelka：你就是大名鼎鼎的 Newoz！很高兴认识你。我师父告诉过我许多你的伟大事迹……", .@gelka$;
	next;
	cutin "rote03",0;
	mes "[Roter]";
	mes "够了。他只是个没有方向感的笨蛋。";
	npctalk "Roter: 够了。他只是个没有方向感的笨蛋。", .@roter$;
	next;
	cutin "arang02",2;
	mes "[Arang]";
	mes "哇，Newoz！你的眼睛看起来比以前更肿了。";
	npctalk "Arang：哇，Newoz！你的眼睛看起来比以前更肿了。", .@arang$;
	next;
	cutin "nines02",0;
	mes "[Newoz]";
	mes "你好，Arang。Arirang 怎么样？嘿。你怎么会来这里？";
	npctalk "Newoz：你好，Arang。Arirang 怎么样？嘿。你怎么会来这里？";
	next;
	cutin "rote03",0;
	mes "[Roter]";
	mes "Newoz，你知道自己失踪多久了吗？我们甚至招募了新的公会成员来找你，而且……";
	npctalk "Roter：Newoz，你知道自己失踪多久了吗？我们甚至招募了新的公会成员来找你，而且……", .@roter$;
	next;
	cutin "lunain01",0;
	mes "[Runane]";
	mes "嗨，很高兴认识你。能亲自见到著名的 Newoz 是我的荣幸。";
	npctalk "Runane: 嗨，很高兴认识你。能亲自见到著名的 Newoz 是我的荣幸。", .@runane$;
	next;
	cutin "roel01",2;
	mes "[罗尔]";
	mes "H-hello, my name is Roel. Runane and I've joined the guild together. Nice to meet you.";
	npctalk "Roel：你、你好，我叫 Roel。我和 Runane 一起加入了公会。很高兴认识你。", .@roel$;
	next;
	cutin "rote02",0;
	mes "[Roter]";
	mes "根据公会条例第 8 条，我现在是公会会长，而你只是成员。";
	npctalk "Roter: 根据公会条例第 8 条，我现在是公会会长，而你只是成员。", .@roter$;
	next;
	cutin "nines02",0;
	mes "[Newoz]";
	mes "哦，恭喜，会长。";
	npctalk "Newoz: 哦，恭喜，会长。";
	next;
	cutin "rote01",0;
	emotion ET_THINK, getnpcid(0,.@roter$);
	mes "[Roter]";
	mes "……这不是我预想的反应。你一点也不生气吗？";
	npctalk "Roter：……这不是我预想的反应。你一点也不生气吗？", .@roter$;
	next;
	cutin "",255;
	emotion ET_THINK, getnpcid(0,.@melody$);
	mes "[Melody-Jack]";
	mes "你期待什么？他脑子里只有冒险、魔物和宝藏。";
	npctalk "Melody-Jack：你期待什么？他脑子里只有冒险、魔物和宝藏。", .@melody$;
	next;
	cutin "nines01",0;
	mes "[Newoz]";
	mes "啊，这里有鬼吗？还是我听错了？";
	npctalk "Newoz：啊，这里有鬼吗？还是我听错了？";
	next;
	emotion ET_THINK, getnpcid(0,.@melody$);
	cutin "",255;
	mes "[Melody-Jack]";
	mes "...";
	npctalk "Melody-Jack: ...", .@melody$;
	next;
	cutin "nines01",0;
	mes "[Newoz]";
	mes "呼，是你啊 Jack。好久不见，各位。";
	npctalk "Newoz：呼，是你啊 Jack。好久不见，各位。";
	next;
	emotion ET_THINK, getnpcid(0,.@melody$);
	cutin "",255;
	mes "[Melody-Jack]";
	mes "现在不是闲聊的时候。我从你们站着的地面，也就是我藏身的地方，感受到了一些东西。";
	npctalk "Melody-Jack：现在不是闲聊的时候。我从你们站着的地面，也就是我藏身的地方，感受到了一些东西。", .@melody$;
	next;
	cutin "arang03",2;
	mes "[Arang]";
	mes "Jack，你就是因为这个才像胆小鬼一样躲起来的吗？";
	npctalk "Arang：Jack，你就是因为这个才像胆小鬼一样躲起来的吗？", .@arang$;
	next;
	emotion ET_THINK, getnpcid(0,.@melody$);
	cutin "",255;
	mes "[Melody-Jack]";
	mes "像我这样的老练盗贼，自然会藏在潜在敌人的领地里。";
	npctalk "Melody-Jack：像我这样的老练盗贼，自然会藏在潜在敌人的领地里。", .@melody$;
	next;
	mes "[Melody-Jack]";
	mes "我才不是因为角色图还没准备好才躲起来的！";
	npctalk "Melody-Jack：我才不是因为角色图还没准备好才躲起来的！", .@melody$;
	next;
	cutin "min02",0;
	mes "[Mingmin]";
	mes "我同意 Jack 的看法。这个地方的一切——从空气到土壤——都在尖叫着说它不自然。";
	npctalk "Mingmin：我同意 Jack 的看法。这个地方的一切——从空气到土壤——都在尖叫着说它不自然。", .@mingmin$;
	next;
	cutin "ragi01",2;
	mes "[Lagi]";
	mes "难道是超自然现象？";
	npctalk "Lagi：难道是超自然现象？", .@lagi$;
	next;
	cutin "nines01",0;
	mes "[Newoz]";
	mes "或者是异世界现象。";
	npctalk "Newoz：或者是异世界现象。";
	next;
	cutin "min02",0;
	mes "[Mingmin]";
	mes "...";
	npctalk "Mingmin: ...", .@mingmin$;
	next;
	cutin "nines01",0;
	mes "[Newoz]";
	mes "你就是 Lagi，对吧？我喜欢你的思考方式。以后真想和你合作一次。";
	npctalk "Newoz：你就是 Lagi，对吧？我喜欢你的思考方式。以后真想和你合作一次。";
	next;
	cutin "lunain02",0;
	mes "[Runane]";
	mes "I've joined this guild to meet you, Newoz. Do you have a girlfriend?";
	npctalk "Runane：我加入这个公会就是为了见你，Newoz。你有女朋友吗？", .@runane$;
	next;
	cutin "igu05",2;
	mes "[Aigu]";
	mes "你敢——我先看上他的！";
	npctalk "Aigu：你敢——我先看上他的！", .@aigu$;
	next;
	cutin "lunain03",0;
	mes "[Runane]";
	mes "I don't think he knows that. Do you, Newoz?";
	npctalk "Runane：我觉得他不知道这件事。对吧，Newoz？", .@runane$;
	next;
	cutin "igu04",2;
	mes "[Aigu]";
	mes "这个嘛，我没有……";
	npctalk "Aigu：这个嘛，我没有……", .@aigu$;
	next;
	cutin "lunain01",0;
	mes "[Runane]";
	mes "*哼* 那他就是公平竞争对象了！";
	npctalk "Runane：*哼* 那他就是公平竞争对象了！", .@runane$;
	next;
	cutin "gelca02",0;
	mes "[Gelka]";
	mes "呃，话题好像已经变成……";
	npctalk "Gelka：呃，话题好像已经变成……", .@gelka$;
	next;
	cutin "ragi03",2;
	mes "[Lagi]";
	mes "她转换话题的速度，比阿克劳斯施放敏捷提升还快。";
	npctalk "Lagi：她转换话题的速度，比阿克劳斯施放敏捷提升还快。", .@lagi$;
	next;
	cutin "arang02",0;
	mes "[Arang]";
	mes "她们是在争夺 Newoz 吗？我也要参加！";
	npctalk "Arang：她们是在争夺 Newoz 吗？我也要参加！", .@arang$;
	next;
	cutin "min02",0;
	mes "[Mingmin]";
	mes "……抱歉打扰你们，但我觉得那边有东西。";

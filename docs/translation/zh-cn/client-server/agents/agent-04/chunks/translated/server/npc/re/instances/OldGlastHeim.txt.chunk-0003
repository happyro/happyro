1@gl_k,1,1,0	script	#talkinstance3	HIDDEN_WARP_NPC,{
	end;
OnStart:
	initnpctimer;
	'npc_himelmez2$ = instance_npcname("Himelmez#2");
	'npc_heinrich4$ = instance_npcname("Heinrich#4");
	end;
OnTimer3000:
	npctalk "希梅尔梅兹：看来你要么很幸运，要么很强，才能走到这里。", 'npc_himelmez2$;
	end;
OnTimer6000:
	npctalk "希梅尔梅兹：但这无所谓。", 'npc_himelmez2$;
	end;
OnTimer9000:
	npctalk "希梅尔梅兹：你们都会死在这里。", 'npc_himelmez2$;
	end;
OnTimer12000:
	npctalk "海因里希：希梅尔梅兹！我们不会让你逃走！", 'npc_heinrich4$;
	end;
OnTimer15000:
	npctalk "希梅尔梅兹：哈哈哈，先担心你自己吧。你以为这里只有我？", 'npc_himelmez2$;
	end;
OnTimer18000:
	npctalk "瓦尔蒙特：海因里希阁下！我感觉有强大而奇怪的东西来了！", instance_npcname("Varmundt#2");
	end;
OnTimer21000:
	npctalk "海因里希：什么……这些是！", 'npc_heinrich4$;
	end;
OnTimer24000:
	npctalk "希梅尔梅兹：我的新玩具会陪你们玩，我先走了。", 'npc_himelmez2$;
	end;
OnTimer27000:
	npctalk "希梅尔梅兹：再会~希望哪天还能见到你，海因里希。", 'npc_himelmez2$;
	end;
OnTimer28000:
	disablenpc 'npc_himelmez2$;
	end;
OnTimer31000:
	npctalk "海因里希：瓦尔蒙特阁下！帮助那些冒险者。我去追希梅尔梅兹！", 'npc_heinrich4$;
	end;
OnTimer32000:
	disablenpc 'npc_heinrich4$;
	end;
OnTimer35000:
	mapannounce 'map_name$[0], "骑士圣所深处传来回声。", bc_map,0xFFFFFF;
	end;
OnTimer38000:
	donpcevent instance_npcname("#ghmemorialmob04") + "::OnStart";
	stopnpctimer;
	'npc_himelmez2$ = 'npc_heinrich4$ = "";
	end;
}


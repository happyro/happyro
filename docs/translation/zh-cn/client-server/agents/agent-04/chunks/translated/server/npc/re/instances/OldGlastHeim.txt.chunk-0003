2@gl_k,1,1,0	script	#talkinstance5	HIDDEN_WARP_NPC,{
	end;
OnStart:
	initnpctimer;
	'npc_heinrich$ = instance_npcname("Heinrich#21");
	'npc_varmundt$ = instance_npcname("Varmundt#21");
	end;
OnTimer3000:
	npctalk "海因里希：这座城堡以前没有这个结构！", 'npc_heinrich$;
	end;
OnTimer6000:
	npctalk "瓦尔蒙特：这是希梅尔梅兹的封闭空间。我们封锁了每个区域和通道。", 'npc_varmundt$;
	end;
OnTimer9000:
	npctalk "海因里希：我们试过摧毁它，但它非常坚固。", 'npc_heinrich$;
	end;
OnTimer12000:
	npctalk "瓦尔蒙特：退后。让我试着驱散魔法。", 'npc_varmundt$;
	end;
OnTimer15000:
	specialeffect EF_LORD,AREA, instance_npcname("#Servanton_effect");
	disablenpc instance_npcname("#Servanton_effect");
	end;
OnTimer18000:
	npctalk "瓦尔蒙特：我觉得那部分封闭空间已经崩塌了。", 'npc_varmundt$;
	end;
OnTimer21000:
	npctalk "瓦尔蒙特：我从未见过这个封闭空间。", 'npc_varmundt$;
	end;
OnTimer24000:
	npctalk "瓦尔蒙特：希梅尔梅兹把石链藏在不死者体内。", 'npc_varmundt$;
	end;
OnTimer27000:
	npctalk "瓦尔蒙特：也许封闭空间就是靠这些石链维持的。", 'npc_varmundt$;
	end;
OnTimer30000:
	npctalk "瓦尔蒙特：若想破坏它，必须杀死一个拥有石链的人。", 'npc_varmundt$;
	end;
OnTimer33000:
	npctalk "瓦尔蒙特：但我们无法辨认谁拥有石链，所以必须净化一切。", 'npc_varmundt$;
	end;
OnTimer36000:
	npctalk "海因里希：这是不可原谅的行为。", 'npc_heinrich$;
	end;
OnTimer39000:
	npctalk "海因里希：我已经消灭了所有士兵，甚至更多……", 'npc_heinrich$;
	end;
OnTimer42000:
	npctalk "瓦尔蒙特：指挥官……", 'npc_varmundt$;
	end;
OnTimer45000:
	npctalk "瓦尔蒙特：指挥官！你必须坚强。", 'npc_varmundt$;
	end;
OnTimer48000:
	npctalk "瓦尔蒙特：我们的敌人不是人类。", 'npc_varmundt$;
	end;
OnTimer51000:
	npctalk "瓦尔蒙特：即使你否认，他们也永远不会变回人类。", 'npc_varmundt$;
	end;
OnTimer54000:
	npctalk "海因里希：……", 'npc_heinrich$;
	end;
OnTimer57000:
	npctalk "瓦尔蒙特：那么，走吧。", 'npc_varmundt$;
	end;
OnTimer60000:
	npctalk "瓦尔蒙特：你们休息一下，跟着我们。", 'npc_varmundt$;
	end;
OnTimer63000:
	npctalk "瓦尔蒙特：战斗可能很艰难，保持坚强。", 'npc_varmundt$;
	end;
OnTimer66000:
	npctalk "瓦尔蒙特：好了，海因里希，是时候开始了。", 'npc_varmundt$;
	end;
OnTimer69000:
	mapannounce 'map_name$[1], "中央走廊西侧打开了传送门。", bc_map,0xFFFF00;
	disablenpc 'npc_varmundt$;
	disablenpc 'npc_heinrich$;
	stopnpctimer;
	'npc_varmundt$ = 'npc_heinrich$ = "";
	enablenpc instance_npcname("#22 Control");
	enablenpc instance_npcname("#22 Control2");
	end;
}


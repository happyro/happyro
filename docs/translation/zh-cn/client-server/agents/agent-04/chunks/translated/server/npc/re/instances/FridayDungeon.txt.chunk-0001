//===== rAthena Script =======================================
//= Friday Memorial Dungeon
//===== Description: =========================================
//= [Walkthrough Conversion]
//= Friday Memorial Dungeon
//===== Changelogs: ==========================================
//= 1.0 Initial release [Everade]
//= 1.1 Clean-up [Capuche]
//============================================================

gef_tower,57,170,3	script	Marry Jay	4_F_JOB_BLACKSMITH,{
	if (BaseLevel < 130) {
		mes "[玛丽·杰伊]";
		mes "你的基础等级太低，达到 130 级后再来。";
		close;
	}
	mes "^ff0000在地下城内进行怪物处理（例如驯服怪物）不会计入进度，请注意。^000000";
	next;
	.@day = gettime(DT_DAYOFWEEK);
	if (.@day != FRIDAY) {
		mes "[玛丽·杰伊]";
		mes "哦，好奇的旁观者？我是玛丽·杰，负责星期中的星期五。";
		next;
		select( "什么时候开放？" );
		mes "[玛丽·杰伊]";
		mes "地下城开放时间：";
		mes "^0000FF星期五 00:00 ~ 星期五 23:59^000000";
		next;
		mes "[玛丽·杰伊]";
		mes "希望星期五到来时能见到你~";
		close;
	}
	.@md_name$ = "Friday Dungeon";

	switch(checkquest(12379,PLAYTIME)) {
	case -1:
		break;
	case 0:
	case 1:
		mes "[玛丽·杰伊]";
		mes "抱歉，进入" + .@md_name$ + "的时间已经结束。";
		mes "请先休息，等待副本再次开放。";
		close;
	case 2:
		erasequest 12379;
		mes "[玛丽·杰伊]";
		mes "冷却时间结束了。";
		mes "你可以再次进入纪念地下城。";
		close;
	}
	mes "[玛丽·杰伊]";
	mes "你来得正是时候。";
	mes "纪念地下城刚好准备开放。";
	mes "现在要进入吗？";
	next;

	if (is_party_leader() == true)
		.@menu$ = "Prepare Friday Memorial";

	switch( select( .@menu$, "进入星期五纪念地下城", "取消" ) ) {
	case 1:
		instance_create(.@md_name$);
		mes "[玛丽·杰伊]";
		mes "纪念地下城已创建。";
		mes "现在可以进入了。";
		close;
	case 2:
		switch( instance_enter(.@md_name$) ) {
		case IE_NOMEMBER:
			if (is_party_leader() == true)
				end;
			mes "只有队伍成员可以进入该纪念地下城。";
			close;
		case IE_NOINSTANCE:
			if (is_party_leader() == true) {
				mes "没有登记的纪念副本。";
				close;
			}
			mes "星期五纪念地下城不存在。";
			mes "你的队长尚未创建纪念地下城。";
			close;
		case IE_OTHER:
			mes "发生未知错误。";
			close;
		case IE_OK:
			mes "[玛丽·杰伊]";
			mes "出发吧！";
			mapannounce "gef_tower", "队伍中的" + strcharinfo(0) + "正在进入" + .@md_name$ + "。", bc_map, 0xFF99;
			if (isbegin_quest(12379) < 1)
				setquest 12379;
			end;
		}
		end;
	case 3:
		mes "[玛丽·杰伊]";
		mes "你还没准备好吗？";
		mes "看来也没办法了。";
		close;
	}
	end;
}

//Instance
1@md_gef,185,81	monster	Shining Plant	1083,1,1800000,900000

1@md_gef,110,129,6	script	Marry Jay#0_1	4_F_JOB_BLACKSMITH,{
	if (is_party_leader() == false)
		end;
	mes "[玛丽·杰伊]";
	mes "在开始设置这里的环境前，你可以选择合适的难度。";
	mes "我可以替你选择，但每个人应根据自己的能力做决定。";
	next;
	switch( select( "取消", "LV130 ~ 199", "LV200 + " ) ) {
	case 1:
		close;
	case 2:
		//MinLevel, Lich Lord, Nightmare, Jakk, Ghoul, Drainliar
		'hard = 0;
		setarray 'mob[0],130,3658,3660,3662,3664,3666;
		break;
	case 3:
		if (BaseLevel < 200) {
			mes "[玛丽·杰伊]";
			mes "你的基础等级低于 200，无法选择此难度。";
			close;
		}
		'hard = 1;
		setarray 'mob[0],200,3659,3661,3663,3665,3667;
		break;
	}
	if (BaseLevel < 'mob[0]) {
		mes "[玛丽·杰伊]";
		mes "你的基础等级太低，无法选择此项；需要达到" + 'mob[0] + "级或更高。";
		close;
	}
	close2;
	npctalk "现在，这里就要变成狩猎场了。我会出去并关上前门。";
	sleep 4000;
	npctalk "祝你好运~";
	sleep 3000;
	if ('step == 0) {
		'step = 1;
		donpcevent instance_npcname("md_gef_mobs_spawn") + "::OnStart";
		disablenpc();
		enablenpc instance_npcname("The Stranger#cadaver");
		enablenpc instance_npcname("Bizzare Sculpture#boss");
	}
	end;
}

1@md_gef,1,1,6	script	md_gef_mobs_spawn	-1,{
	end;
OnStart:
	.@npc_name$ = instance_npcname("md_gef_mobs_spawn");
	monster 'map_md_gef$,0,0,"Nightmare",'mob[2],20, .@npc_name$ + "::OnNightmareDead";
	monster 'map_md_gef$,0,0,"Jakk",'mob[3],30, .@npc_name$ + "::OnJakkDead";
	monster 'map_md_gef$,0,0,"Ghoul",'mob[4],30, .@npc_name$ + "::OnGhoulDead";
	monster 'map_md_gef$,0,0,"Drainliar",'mob[5],20, .@npc_name$ + "::OnDrainliarDead";
	end;

OnNightmareDead:
	callsub( S_Mob, 'mob[2], "Nightmare", "OnNightmareDead" );
OnJakkDead:
	callsub( S_Mob, 'mob[3], "Jakk", "OnJakkDead" );
OnGhoulDead:
	callsub( S_Mob, 'mob[4], "Ghoul", "OnGhoulDead" );
OnDrainliarDead:
	callsub( S_Mob, 'mob[5], "Drainliar", "OnDrainliarDead" );

S_Mob:
	'count++;
	if (('count % 100) == 0) {
		'rand_chest++;
		if ('rand_chest > 4)
			'rand_chest = 1;
		// Treasure Chest Spawn
		donpcevent instance_npcname("#fd_box" + 'rand_chest) + "::OnStart";
	}
	sleep 10000;
	monster 'map_md_gef$,0,0, getarg(1), getarg(0),1, instance_npcname("md_gef_mobs_spawn") + "::" + getarg(2);
	end;

OnInstanceInit:
	'step = 0;
	'hard = 0;
	'count = 0;
	'rand_chest = 0;
	'freestones = 0;
	'boss_actv = 0;
	'map_md_gef$ = instance_mapname("1@md_gef");
	end;
}


1@md_gef,110,129,6	script(DISABLED)	Mary Juj#0_2	4_F_JOB_BLACKSMITH,{
	npctalk "你好。";
	end;
}

1@md_gef,183,222,5	script(DISABLED)	The Stranger#cadaver	4_TOWER_11,{
	mes "这是一具陌生人的尸体。";
	mes "也许他在这里寻找宝藏时徘徊而死。";
	next;
	if (select( "冷静", "调查尸体" ) == 1) {
		mes "你尊重死者，决定不打扰尸体。";
		close;
	}
	mes "看着口袋里潦草写下的纸条，这位冒险者的名字似乎是沃尔特。";
	next;
	mes "[Adventurer's Log]";
	mes "我叫沃尔特。留给未来来访的冒险者，希望你们不要再犯同样的错误。";
	next;
	mes "[Adventurer's Log]";
	mes "第一天，我好奇地把手放在附近奇怪雕像的石板上。";
	mes "……我唤醒了本不该唤醒的东西。";
	next;
	mes "[Adventurer's Log]";
	mes "现在复活的古代国王正在我面前徘徊。";
	mes "也许他没有前世的记忆。";
	mes "有一点可以确定，他会杀了我。";
	next;
	mes "[Adventurer's Log]";
	mes "给未来会来到这里的冒险者：希望你们不要犯和我一样的错误。";
	mes "如果看到可疑的石板，不要表现出兴趣，直接走过去。";
	next;
	mes "[Adventurer's Log]";
	mes "再说一次，绝对不要触碰石板，无论它多么诱人。";
	if ('freestones != 0)
		close;
	next;
	mes "几块工艺石从他的身体上掉落下来。它们大概是在探索这里时收集的。";
	close2;
	if ('freestones == 0) {
		'freestones = 1;
		if ('hard == 1)
			.@num = rand(7,9);
		else
			.@num = rand(5,7);
		for ( .@i = 0; .@i < .@num; ++.@i )
			makeitem 25235,1, 'map_md_gef$, rand(181,183), rand(221,224);
	}
	end;
}

1@md_gef,199,73,0	script(DISABLED)	Bizzare Sculpture#boss	CLEAR_NPC,{
	if ('count < 100) {
		mes "这是一座堆满灰尘的奇怪雕像。我没看到任何可疑之处。";
		close;
	}
	if ('boss_actv >= 1) {
		mes "工艺石被强大力量熔入了插槽。";
		mes "看来插槽暂时无法使用。";
		close;
	}
	mes "不知何时，积尘散开了，雕像下方的石板上露出 10 个空洞。";
	next;
	mes "这 10 个空洞似乎都能完美嵌入工艺石。";
	next;
	if (select( "Ignore", "Try inserting craft stones" ) == 1)
		end;
	if (countitem(25235) < 10) {
		mes "工艺石被强大力量熔入了插槽。";
		mes "看来插槽暂时无法使用。";
		close;
	}
	mes "将工艺石插入空洞后，它会发出耀眼的光并融化。";
	next;
	delitem 25235,10;
	specialeffect EF_ANGELUS;

	if (rand(1,10) == 10) {
		mes "我周围的空气似乎发生了变化。";
		instance_announce 0, "Lord of the Dead: Who Awakened Me? I will meet you in person and ask you why.", bc_map, "0xFFFF00";
		if ('boss_actv == 0) {
			'boss_actv = 1;
			monster 'map_md_gef$,210,110,"Lich King",'mob[1],1;
		}
	}
	else {
		mes "但没有其他事情发生。";
		close2;
		if ('boss_actv == 0) {
			disablenpc();	// Disable NPC for 5 minutes when MVP didn't spawn.
			initnpctimer;
		}
		end;
	}
	close;

OnTimer300000:
	stopnpctimer;
	enablenpc();
	end;
}


// Treasure Chest Reward
1@md_gef,212,212,3	script(DISABLED)	#fd_box1	4_TREASURE_BOX,{
	specialeffect EF_COIN;
	disablenpc();
	stopnpctimer;
	sleep 500;

	if ('hard == 1)
		.@num = rand(7,9);
	else
		.@num = rand(5,7);

	.@npc_name$ = strnpcinfo(2);

	if (.@npc_name$ == "fd_box1") {
		for ( .@i = 0; .@i < .@num; ++.@i )
			makeitem 25235,1, 'map_md_gef$, rand(210,214), rand(210,214);
	}
	if (.@npc_name$ == "fd_box2") {
		for ( .@i = 0; .@i < .@num; ++.@i )
			makeitem 25235,1, 'map_md_gef$, rand(188,192), rand(54,58);
	}
	if (.@npc_name$ == "fd_box3") {
		for ( .@i = 0; .@i < .@num; ++.@i )
			makeitem 25235,1, 'map_md_gef$, rand(47,51), rand(55,59);
	}
	if (.@npc_name$ == "fd_box4") {
		for ( .@i = 0; .@i < .@num; ++.@i )
			makeitem 25235,1, 'map_md_gef$, rand(42,46), rand(209,213);
	}
	end;

OnStart:
	enablenpc();
	instance_announce 0, "A treasure chest appeared somewhere in the dungeon. It'll disappear after a while, so let's find it.", bc_map, "0xff5500";
	initnpctimer;
	end;
OnTimer180000:	//3min before chest disappears
	disablenpc();
	stopnpctimer;
	end;
}
1@md_gef,190,56,3	duplicate(#fd_box1)	#fd_box2	4_TREASURE_BOX
1@md_gef,49,57,3	duplicate(#fd_box1)	#fd_box3	4_TREASURE_BOX
1@md_gef,44,211,3	duplicate(#fd_box1)	#fd_box4	4_TREASURE_BOX


//Merchant
gef_tower,57,167,3	script	Amateur Collector#pa0829	1_F_01,{
	disable_items;
	function F_equip_menu;
	function F_enchant;

	if (checkweight(1201,1) == 0) {
		mes "你拥有的物品种类太多。请清理物品栏。";
		close;
	}
	if (MaxWeight - Weight < 10000) {
		mes "无法继续，因为你携带了太多重物。请清理背包以降低总重量。";
		close;
	}
	mes "[Amateur Collector]";
	mes "如果你带来" + mesitemlink(25235, false) + "，我就能为你的饰品附加绝妙效果！";
	next;
	switch( select( "What can you do with the Crafting Stone?", "饰品附魔", "重置附魔" ) ) {
	case 1:
		mes "[Amateur Collector]";
		mes "我用自己的手艺交换副本里的珍贵石头。我还是初学者，但技术还算过得去。";
		mes "请多多关照。";
		next;
		if (select( "I've heard this before.", "I'm listening." ) == 1) {
			mes "[Amateur Collector]";
			mes "是这样吗？";
			close;
		}
		mes "[Amateur Collector]";
		mes "使用工艺石，我可以为你的饰品附加能力。";
		next;
		mes "[Amateur Collector]";
		mes "我需要 10 个" + mesitemlink(25235, false) + "和 100,000 Zeny。";
		mes "附魔过程不会失败。";
		next;
		mes "[Amateur Collector]";
		mes "但是，^0000FF如果饰品有随机选项，附魔后随机选项会被移除。^000000";
		next;
		select( "Anything else?" );
		mes "[Amateur Collector]";
		mes "饰品上的卡片在附魔后仍会保留。";
		next;
		mes "[Amateur Collector]";
		mes "可以重置，但我不能说自己经验丰富。";
		mes "我的成功率是：";
		mes "皇家戒指：80%";
		mes "其他饰品：20%";
		next;
		mes "[Amateur Collector]";
		mes "^0000FFIf the accessory has a random option, the random option will be removed after initialization.^000000";
		close;
	case 2:
		.@type = 1;
		.@type_name$ = "enchant";
		break;
	case 3:
		.@type = 2;
		.@type_name$ = "reset";
		break;
	}

	.@slot = F_equip_menu();
	.@equip_id = getequipid(.@slot);
	setarray .@equip_card[0], getequipcardid(.@slot,0), getequipcardid(.@slot,1), getequipcardid(.@slot,2), getequipcardid(.@slot,3);
    copyarray .@card[0], .@equip_card[0], 4;
	
	switch( .@equip_id ) {
	case 0:
		mes "[Amateur Collector]";
		mes "请装备饰品。";
		close;
	case 28483:
	case 2601:
	case 2602:
	case 2603:
	case 2605:
	case 2607:
	case 2608:
	case 2609:
	case 2610:
	case 2611:
	case 2612:
	case 2613:
	case 2614:
	case 2615:
	case 2616:
	case 2617:
	case 2618:
	case 2619:
	case 2620:
	case 2621:
	case 2622:
	case 2623:
	case 2625:
	case 2626:
	case 2627:

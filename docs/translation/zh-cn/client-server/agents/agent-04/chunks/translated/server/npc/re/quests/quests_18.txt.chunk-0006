// Main Quest: Step 32.
gw_fild01,37,105,5	script(CLOAKED)	Imril#ep18_gw	4_EP18_IMRIL,{
	if (ep18_main == 33) {
		mes "[伊姆里尔]";
		mes "为什么。";
		cutin "ep18_imril_01.png",2;
		next;
		mes "[玛拉姆]";
		mes "别一个人去，帮帮我们。";
		cutin "ep18_maram_01.png",2;
		next;
		mes "[伊姆里尔]";
		mes "不带外来者是我们的^e5555e规矩^000000。";
		mes "即使你求助，我也无能为力。";
		cutin "ep18_imril_02.png",2;
		npctalk "我能有什么力量。", "Imril#ep18_gw", bc_self;
		next;
		mes "[玛拉姆]";
		mes "嗯……";
		cutin "ep18_maram_03.png",2;
		next;
		mes "[玛拉姆]";
		mes "那去村里叫^e5555e苏阿德^000000怎么样？";
		cutin "ep18_maram_02.png",2;
		next;
		mes "[玛拉姆]";
		mes "因为带了外来者，我想连我也不被允许进入村庄。";
		cutin "ep18_maram_01.png",2;
		npctalk "Help me...", "Maram#ep18_gw", bc_self;
		next;
		mes "[伊姆里尔]";
		mes "^e5555e苏阿德^000000对这件事很敏感。";
		mes "你应该提前告诉他。";
		cutin "ep18_imril_02.png",2;
		npctalk "他会非常生气的。", "Imril#ep18_gw", bc_self;
		next;
		mes "[玛拉姆]";
		mes "这次我还没来得及说，事情就乱了。";
		mes "你大概知道现在的^e5555e拉赫尔局势^000000。";
		cutin "ep18_maram_01.png",2;
		next;
		mes "[伊姆里尔]";
		mes "所以我才去^e5555e菲音斯^000000购买物资。";
		cutin "ep18_imril_02.png",2;
		next;
		mes "[伊姆里尔]";
		mes "他之前帮过我，我欠他人情，所以我会去问^e5555e苏阿德^000000。";
		mes "但别抱太大希望。";
		cutin "ep18_imril_03.png",2;
		next;
		mes "[玛拉姆]";
		mes "明白了。";
		cutin "ep18_maram_01.png",2;
		npctalk "谢谢。", "Maram#ep18_gw", bc_self;
		next;
		mes "[玛拉姆]";
		mes "" + strcharinfo(0) + "，看来要进入村庄，我们需要见到并说服^e5555eSuad^000000。";
		mes "不过不知道他是否愿意见我们……";
		next;
		mes "[玛拉姆]";
		mes "先等^e5555e苏阿德^000000到来吧。";
		erasequest 11722;
		setquest 11723;
		ep18_main = 34;
		close2;
		cloakonnpcself( "Imril#ep18_gw" );
		cutin "",255;
		end;
	}
	end;

OnInit:
	questinfo( QTYPE_QUEST2, QMARK_YELLOW, "isbegin_quest(11722) == 1" );
	end;
}

// Main Quest: Step 34.
// + Quest: Investigation of Oz Labyrinth. Step 1 + 13 (final).
wolfvill,143,114,5	duplicate(dummy_cloaked_npc)	Maram#ep18_wv	4_EP18_MARAM
wolfvill,145,114,5	duplicate(dummy_cloaked_npc)	Miriam#ep18_wv	4_EP18_MIRIAM

wolfvill,143,113,5	script	Imril#ep18_wv	4_EP18_IMRIL,{
	if (checkweight(1000405,20) == 0) {
		mes "- 请稍等！！-";
		mes "- 你目前携带的物品-";
		mes "- 太多了。-";
		mes "- 请先减轻负重-";
		mes "- 后再试。-";
		close;
	}
	if (ep18_main < 35)
		end;
	if (ep18_main == 35) {
		mes "[伊姆里尔]";
		mes "<FONT SIZE = 14>嘿！</FONT>";
		mes "你真的进来了，对吧？";
		cutin "ep18_imril_03.png",2;
		next;
		mes "[伊姆里尔]";
		mes "我已经传达了消息。";
		mes "但^e5555e苏阿德^000000不允许外来者进入村庄！";
		cutin "ep18_imril_02.png",2;
		next;
		mes "[米里亚姆]";
		mes "这大概说明村里的情况不太好。";
		cloakoffnpcself( "Miriam#ep18_wv" );
		cloakoffnpcself( "Maram#ep18_wv" );
		cutin "ep18_miriam_03.png",2;
		next;
		mes "[艾莉]";
		mes "在这种环境中自给自足很困难。";
		mes "连树都像岩石一样坚硬。";
		mes "或者它们根本不是树，而是岩石？";
		cutin "ep172_beta.bmp",2;
		next;
		mes "[玛拉姆]";
		mes "如果能得到外界一点帮助，我想情况会改善。";
		cutin "ep18_maram_01.png",2;
		next;
		mes "[伊姆里尔]";
		mes "如果能这样就好了。";
		mes "苏阿德虽然没说，但他一定已经考虑这件事很久了。";
		cutin "ep18_imril_01.png",2;
		npctalk "因为他是个责任感很强的人。", "Imril#ep18_wv", bc_self;
		next;
		mes "[玛拉姆]";
		mes "看来" + strcharinfo(0) + "帮忙购买物品很有效！";
		cutin "ep18_maram_02.png",2;
		next;
		mes "[玛拉姆]";
		mes "^e5555e他们可能会说只有获取物资时才允许进入，^000000但一旦发现你是^e5555e值得信任的人^000000，或许会安心一些。";
		cutin "ep18_maram_01.png",2;
		next;
		mes "[玛拉姆]";
		mes "那么，我们先和^e5555e村民们^000000谈谈吧？";
		next;

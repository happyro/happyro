gw_fild01,35,102,5	script	Maram#ep18_gw	4_EP18_MARAM,{
	if (ep18_main == 32) {
		mes "[露营者]";
		mes "万岁~~~";
		mes "偶尔这样露营也不错~~~";
		next;
		mes "[玛拉姆]";
		mes "<FONT SIZE = 14><B>是我！我！</FONT></B>";
		cutin "ep18_maram_01.png",2;
		next;
		cutin "",255;
		mes "[露营者]";
		mes "你？";
		mes "我们认识吗？";
		next;
		mes "[玛拉姆]";
		mes "你在说什么？";
		cutin "ep18_maram_01.png",2;
		next;
		mes "[米里亚姆]";
		mes "带来^e5555e外来者^000000就会得到这种反应吗？";
		cloakoffnpcself( "Miriam#ep18_gw" );
		cutin "ep18_miriam_03.png",2;
		next;
		mes "[玛拉姆]";
		mes "Ah...";
		cutin "ep18_maram_01.png",2;
		next;
		mes "[伊姆里尔]";
		mes "那我先走了。";
		cloakoffnpcself( "Imril#ep18_gw" );
		cutin "ep18_imril_02.png",2;
		next;
		mes "[玛拉姆]";
		mes "<FONT SIZE = 14><B>糟糕！！伊姆里尔，等一下！！！！</FONT></B>";
		cutin "ep18_maram_01.png",2;
		erasequest 11721;
		setquest 11722;
		ep18_main = 33;
		close3;
	}
	if (ep18_main == 33) {
		mes "[玛拉姆]";
		mes "Ah...";
		cutin "ep18_maram_01.png",2;
		next;
		mes "[伊姆里尔]";
		mes "那我先走了。";
		cloakoffnpcself( "Imril#ep18_gw" );
		cutin "ep18_imril_02.png",2;
		next;
		mes "[玛拉姆]";
		mes "<FONT SIZE = 14><B>糟糕！！伊姆里尔，等一下！！！！</FONT></B>";
		cutin "ep18_maram_01.png",2;
		close3;
	}
	if (ep18_main == 34) {
		mes "[玛拉姆]";
		mes "Suad 迟到了……";
		mes "如果她根本不来怎么办？";
		cutin "ep18_maram_01.png",2;
		next;
		mes "[米里亚姆]";
		mes "我们应该回拉赫。";
		mes "如果信任已经破裂，^e5555e我们可能再也无法进入村庄。^000000";
		cutin "ep18_miriam_03.png",2;
		next;
		mes "[玛拉姆]";
		mes "但如果继续这样，村里的人只会遭受更多痛苦。";
		mes "必要的话，甚至可以寻求外来者的帮助……";
		cutin "ep18_maram_01.png",2;
		next;
		mes "[米里亚姆]";
		mes "你不明白。";
		cutin "ep18_miriam_03.png",2;
		npctalk "你们和我们既相同又不同。", "Miriam#ep18_gw", bc_self;
		next;
		mes "[玛拉姆]";
		mes "...";
		cutin "ep18_maram_03.png",2;
		next;
		mes "[玛拉姆]";
		mes "我也……想理解……你们……";
		npctalk "对不起……", "Maram#ep18_gw", bc_self;
		next;
		mes "[米里亚姆]";
		mes "...";
		cutin "ep18_miriam_03.png",2;
		npctalk "说这种话，我才应该道歉。", "Miriam#ep18_gw", bc_self;
		next;
		mes "[苏阿德]";
		mes "不经过商量就带外来者来……";
		mes "看在过去的关系上，我来听你最后的借口，你该庆幸。";
		cutin "ep18_suad_03.png",2;
		cloakoffnpcself( "Suad#ep18_gw" );
		next;
		mes "[玛拉姆]";
		mes "苏阿德！";
		mes "一声不吭把外来者带到村口是我的鲁莽！";
		cutin "ep18_maram_02.png",2;
		next;
		mes "[玛拉姆]";
		mes "但这些人值得信任，母亲可以把重要任务交给他们！";
		mes "不用担心，不会发生坏事！";
		cutin "ep18_maram_01.png",2;
		next;
		mes "[苏阿德]";
		mes "尼伦真的信任你到可以让你处理任务吗？";
		mes "就算得到尼伦的信任又怎样？";
		cutin "ep18_suad_03.png",2;
		npctalk "这毫无意义！", "Suad#ep18_gw", bc_self;
		next;
		mes "[苏阿德]";
		mes "<FONT SIZE = 14>尼伦甚至不知道你在这里运送物资。</FONT>";
		next;
		mes "[玛拉姆]";
		mes "那是……";
		cutin "ep18_maram_01.png",2;
		npctalk "确实如此，但是……", "Maram#ep18_gw", bc_self;
		next;
		mes "[米里亚姆]";
		mes "别嘲笑苏阿德。";
		cutin "ep18_miriam_03.png",2;
		npctalk "别再说了！", "Miriam#ep18_gw", bc_self;
		next;
		mes "[苏阿德]";
		mes "我没有嘲笑。";
		mes "我只是在陈述事实……";
		cutin "ep18_suad_03.png",2;
		next;
		mes "[米里亚姆]";
		mes "如果是事实，^e5555e那拉赫尔就再也没人卖东西给我们，^000000我们会这样饿死。";
		cutin "ep18_miriam_03.png",2;
		npctalk "这不是我们想要的，对吧？", "Miriam#ep18_gw", bc_self;
		next;
		mes "[玛拉姆]";
		mes "你可以从菲音斯或其他村庄购买物资，但^e5555e能通过奥兹迷宫的人越来越少。^000000";
		cutin "ep18_maram_01.png",2;
		npctalk "连 Imril 也陷入了危险。", "Maram#ep18_gw", bc_self;
		next;
		mes "[玛拉姆]";
		mes "现在，^e5555e有战斗技能就能杀怪通过，^000000但以后可能不只是战斗技能的问题；^e5555e整个迷宫可能会被熔岩封锁。^000000";
		next;
		mes "[玛拉姆]";
		mes "到那时，能帮忙的人甚至无法走到这里。";
		npctalk "到那时就太迟了！", "Maram#ep18_gw", bc_self;
		next;
		mes "[玛拉姆]";
		mes "如果能实现母亲要求的^e5555e原住民和移民之间的调解，^000000我们就能再用桥渡过奥兹峡谷！";
		next;
		mes "[苏阿德]";
		mes "调解？看来尼伦又有一个梦幻般的想法。";
		mes "就像^e5555e灰色孩子^000000出现时一样。";
		cutin "ep18_suad_03.png",2;
		npctalk "看来 Niren 又有了一个梦幻般的想法。", "Suad#ep18_gw", bc_self;
		next;
		mes "[米里亚姆]";
		mes "但多亏了那件事，我们避免了饥饿，现在还能帮助村里的孩子。";
		cutin "ep18_miriam_03.png",2;
		next;
		mes "[苏阿德]";
		mes "好吧。";
		mes "那就给他们一个机会。";
		mes "就像尼伦曾给我们机会一样。";
		cutin "ep18_suad_03.png",2;
		npctalk "我放弃了那个机会，逃走了……", "Suad#ep18_gw", bc_self;
		next;
		mes "[米里亚姆]";
		mes "什么？";
		cutin "ep18_miriam_03.png",2;
		npctalk "你就这么轻易允许这件事吗？", "Miriam#ep18_gw", bc_self;
		next;
		mes "[玛拉姆]";
		mes "真的吗？！";
		cutin "ep18_maram_02.png",2;
		next;
		mes "[玛拉姆]";
		mes "认真的吗？";
		cutin "ep18_miriam_03.png",2;
		npctalk "老实说，我没抱太大期望！", "Maram#ep18_gw", bc_self;
		next;
		mes "[苏阿德]";
		mes "怎么了？";
		mes "那是什么反应。";
		cutin "ep18_suad_03.png",2;
		npctalk "Then go back!!", "Suad#ep18_gw", bc_self;
		next;
		mes "[玛拉姆]";
		mes "不~不~";
		mes "谢谢~";
		cutin "ep18_maram_02.png",2;
		next;
		mes "[玛拉姆]";
		mes "那就在苏阿德改变主意前去^e5555e村庄^000000吧！";
		cutin "ep18_maram_01.png",2;
		next;
		mes "[玛拉姆]";
		mes "进去后讨论细节。";
		erasequest 11723;
		setquest 11724;
		ep18_main = 35;
		close2;
		cutin "",255;
		cloakonnpcself( "Miriam#ep18_gw" );
		cloakonnpcself( "Suad#ep18_gw" );
		warp "wolfvill",152,113;
		end;
	}
	if (ep18_main == 35) {
		mes "[玛拉姆]";
		mes "那就在苏阿德改变主意前赶紧去^e5555e村庄^000000吧！";
		cutin "ep18_maram_01.png",2;
		next;
		mes "[玛拉姆]";
		mes "进去后讨论细节。";
		close2;
		cutin "",255;
		warp "wolfvill",152,113;
		end;
	}
	mes "[玛拉姆]";
	mes "呼~";
	mes "我们试着生个篝火什么的？";
	cutin "ep18_maram_01.png",2;
	close3;

OnInit:
	questinfo( QTYPE_QUEST2, QMARK_YELLOW, "isbegin_quest(11721) == 1" );
	questinfo( QTYPE_QUEST2, QMARK_YELLOW, "isbegin_quest(11723) == 1" );
	end;
}

gw_fild01,36,103,5	duplicate(dummy_cloaked_npc)	Miriam#ep18_gw	4_EP18_MIRIAM

// Main Quest: Step 27.
ra_fild11,354,235,3	script	Merchant#ep18_rachel	4_EP18_MERCHANT,{
	if (ep18_main == 28 || ep18_main == 29) {
		mes "[伪装的玛拉姆]";
		mes "从现在起，请护送" + strcharinfo(0) + " 与 Miriam 和 Tamarin 一起前往西边的^e5555e奥兹峡谷^000000。";
		cutin "ep18_merchant.png",2;
		next;
		mes "[伪装的玛拉姆]";
		mes "考虑到情况，我们不能带所有人一起走，所以我会送他们回去再跟上。";
		next;
		mes "[伪装的玛拉姆]";
		mes "为了不暴露目的地，最好换个地方，把人们送回去。";
		if (ep18_main == 28) {
			erasequest 11716;
			setquest 11717;
			ep18_main = 29;
		}
		close2;
		cutin "",255;
		navigateto("ra_fild10",179,176);
		end;
	}
	mes "[商人]";
	mes "风很大……";
	cutin "ep18_merchant.png",2;
	close3;

OnInit:
	questinfo( QTYPE_QUEST2, QMARK_YELLOW, "isbegin_quest(11716) == 1" );
	end;
}


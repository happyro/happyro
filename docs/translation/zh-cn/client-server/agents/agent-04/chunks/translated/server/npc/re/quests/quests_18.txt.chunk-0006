
// Main Quest: Step 26.
rachel,41,132,3	script	Box#ep18_procurement4	4_WOODBOX,{
	if (ep18_main == 27) {
		mes "[商人伦西亚]";
		mes "那么请确认订购的物品是否正确……";
		next;
		select( "交出账单。" );
		mes "[商人伦西亚]";
		mes "啊～";
		mes "数量正好！";
		mes "谢谢！";
		mes "下次再使用我们的服务~！";
		next;
		mes "[玛拉姆]";
		mes "在你离开前，" + strcharinfo(0) + "，我们来^e5555e检查门外的路线^000000。";
		cutin "ep18_maram_01.png",2;
		erasequest 11715;
		setquest 11716;
		ep18_main = 28;
		close2;
		cutin "",255;
		navigateto("ra_fild11",354,235);
		end;
	}
	if (ep18_main == 28) {
		mes "[玛拉姆]";
		mes "在你离开前，" + strcharinfo(0) + ", let's ^e5555e检查门外的路线^000000.";
		cutin "ep18_maram_01.png",2;
		close2;
		cutin "",255;
		navigateto("ra_fild11",354,235);
		end;
	}
	end;

OnInit:
	questinfo( QTYPE_QUEST2, QMARK_YELLOW, "isbegin_quest(11715) == 1" );
	end;
}


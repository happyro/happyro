	lighthalzen,220,244,3	script	Samnang#zen2	863,{
	mes "[Samnang]";
mes "^333333*Sigh...*^000000";
mes "年纪越大，行动就越困难。";
mes "老人家这样也很正常，对吧？";
next;
	mes "[Samnang]";
	mes "前几天，几个穿黑西装的混混";
	mes "大喊让我让路。";
	mes "当然，我没能及时走开。";
	mes "你猜他们对我做了什么？";
	next;
	mes "[Samnang]";
	mes "他们打了我。";
	mes "正中肚子！";
	mes "我知道自己没有怀孕，";
	mes "但这不是重点。";
	mes "绝不能打女人，尤其是老人！";
	close;
	}
	
	lighthalzen,261,112,3	script	Ruth#zen4	862,{
	mes "[Ruth]";
	mes "亲爱的，在美丽阳光下";
	mes "和你待在一起不是很棒吗？";
	mes "这正适合我们的约会。啊～";
	next;
	mes "[Ruth]";
mes "和你在一起我好幸福。";
mes "我感觉自己都要被幸福融化了。";
mes "哦，我太爱你了，Oyoung。";
	next;
	mes "[" + strcharinfo(0) + "]";
	mes "哇……";
	mes "这对情侣真的";
	mes "沉浸在";
	mes "幸福云端了，对吧？";
	close;
	}
	
	lighthalzen,259,108,7	script	Oyoung#zen14	869,{
	mes "[Oyoung]";
	mes "姑娘，你看起来像是";
	mes "感染了爱情病毒。";
	mes "但这种病只有一种处方，哦耶……";
	next;
	mes "[Oyoung]";
	mes "你需要每天补充";
	mes "O-YOUNG 维生素。";
	mes "你的嘴唇看起来像缺乏维生素。";
	mes "我最好帮你补充一下～";
	next;
	mes "[" + strcharinfo(0) + "]";
	mes "我的天！";
	mes "我不知道更令人震惊的是——";
	mes "他居然用了这种台词，";
	mes "还是这台词真的奏效了……";
	close;
	}
	
	lighthalzen,233,121,3	script	Kariya#li_01	72,{
	mes "[Kariya]";
mes "我想 ‘Lighthalzen’ 应该是‘光之顶峰’的意思，";
mes "不过听说这座城市其实是以某个人命名的。";
mes "谁知道呢？";
	next;
	mes "[Kariya]";
	mes "不过这个名字很适合施瓦尔兹瓦德共和国";
	mes "最富有、最豪华的城市。";
	mes "你喜欢这里吗？";
	close;
	}
	

lighthalzen,233,82,5	script	Sung#A	716,{
mes "[Sung]";
	mes "我长大后想成为伟大的人，";
	mes "让人们为我立雕像，";
	mes "就像那边的雕像一样。";
	next;
	mes "[Sung]";
	mes "那时人们会说：‘嘿，那座雕像，";
	mes "那家伙一定很伟大！’";
	mes "光是想想就让我感觉真好！";
	next;
	mes "[Sung]";
	mes "就这么办。我会尽快长大。";
	mes "哦，我还要长得高大英俊，";
	mes "这样我的雕像会更帅。";
	mes "对，对，好主意，Sung……";
	close;
	}

lighthalzen,89,73,3	script	Sameer#zen15	854,{
mes "[Sameer]";
	mes "这座城里恩爱的情侣太多了。";
	mes "搂搂抱抱、亲亲吻吻、";
	mes "还要亲热。这……";
	mes "实在令人反感。";
	next;
	mes "[Sameer]";
	mes "我真不敢相信每天在家附近";
	mes "看到的这些不雅行为。";
mes "他们难道不知道不该在公共场合";
mes "如此亲热吗？！";
next;
	mes "[Sameer]";
	mes "幸好我是世界的道德堡垒。";
	mes "事实上我不需要女人。";
	mes "我只需要船模型、";
	mes "青春小说和多米诺骨牌。";
	next;
	mes "[Sameer]";
	mes "我完全适应良好，所以当我要求当局";
	mes "以不雅行为逮捕情侣时，他们应该听我的！";
	mes "牵手。他们不觉得羞耻吗？！";
	close;
	}
	
	lighthalzen,45,59,7	script	Janice#zen03	863,{
	mes "[Janice]";
	mes "糟糕，我好像又迷路了。";
	mes "这里的道路太让人困惑了！";
	mes "我住了这么久，";
	mes "还是找不到路……";
	close;
	}
	
	lighthalzen,66,94,3	script	Elmer Keays#li_03	866,{
mes "[Elmer Keays]";
mes "像这样和你并肩走路，";
mes "让我想起过去的日子。";
mes "那时人人都羡慕我身边有如此美丽的女人。嘿嘿～";
	next;
	mes "[Elmer Keays]";
	mes "亲爱的，你仍是我这双老眼中";
	mes "最珍贵的景色。";
	mes "能和你在一起我真幸运。";
	emotion ET_CHUP, getnpcid(0, "Margie Keays#li_02");
	emotion ET_CHUPCHUP;
	close;
	}
	
	lighthalzen,65,94,5	script	Margie Keays#li_02	863,{
	mes "[Margie Keays]";
	mes "亲爱的，今天的天气";
	mes "真好真舒服。";
	mes "我很高兴我们决定";
	mes "一起散步～";
	close;
	}
	
	lighthalzen,78,120,3	script	Maivi#zen1	862,{
	mes "[Maivi]";
	mes "...";
	next;
	mes "[Maivi]";
mes "...";
mes "......";
next;
mes "[Maivi]";
	mes "啊……";
	mes "我刚睡了个好觉。";
	mes "这么好的天气总能让我放松。";
	mes "这里的空气真干净，";
	mes "不像艾音布罗克～";
	next;
	mes "[Maivi]";
	mes "这清洁 pristine 的环境";
	mes "全要感谢 Rekenber Corporation。";
	mes "他们如今用科技做到的事真不可思议，";
		mes "对吧？啊，真安宁～";
		close;
		}
		

	lighthalzen,230,182,4	script	Klaubis#zen3	866,{
mes "[Klaubis]";
mes "请问你是游客吗？";
mes "欢迎来到 Lighthalzen！";
	mes "这座城市应有尽有，";
	mes "不过有时会太安静、太平淡。";
	next;
	switch(select("你在这里住很久了吗？:我同意。:你听说过连环杀手吗？")) {
	case 1:
	mes "[Klaubis]";
	mes "是的，我们家族从曾祖父那代起";
	mes "就一直住在这座城市。";
	mes "算起来，我家已经在这里";
	mes "生活了大约两百年。";
	next;
	mes "[Klaubis]";
	mes "你会惊讶于有多少人留在故乡。";
	mes "即使离开，也总能回来。";
	mes "如果不能回来，就不算故乡了，对吧？";
close;
case 2:
mes "[Klaubis]";
	mes "是的，这里的气氛有时很沉闷。";
	mes "不过 Lighthalzen 仍有许多美景，";
	mes "到处看看吧～";
	close;
	case 3:
	mes "[Klaubis]";
	mes "你是说连环斧头杀人狂？";
mes "我以为那只是老鬼故事。";
mes "嗯，武器店里的女士";
mes "应该更了解那件事……";
	close;
	}
	}
	
	lighthalzen,232,156,3	script	Sigmund#zen3	869,{
	mes "[Sigmund Ting]";
mes "你知道我注意到什么吗？";
mes "贫民窟边境的守卫有时会分心。";
mes "我趁他们不注意时";
	mes "直接翻过了围栏！";
	next;
	mes "[Sigmund Ting]";
	mes "但进了贫民窟后我很无聊。";
	mes "那里确实没什么可做。";
	mes "这让我想知道……为什么要守着它？";
	close;
	}
	
	lighthalzen,190,134,5	script	Joyce#zen	862,{
	mes "[Joyce]";
	mes "我能感受到你渴望的目光，";
	mes "它在我心底让心跳越来越快，";
	mes "充满炽热激情～";
	close;
}

lighthalzen,191,134,3	script	Dan Song#zen2	869,{
	mes "[Dan Song]";
	mes "你的双眼……";
	mes "纯洁又深邃，";
	mes "像闪烁的光之池。";
	mes "太美了……";
	close;
	}

lighthalzen,115,159,3	script	Collins#zen1	866,{
mes "[Collins]";
	mes "我真希望儿子能加入";
	mes "Rekenber Corporation。";
	mes "他们肯定提供 Lighthalzen 最好的工作。";
	next;
	mes "[Collins]";
	mes "虽然他们是大型企业，";
	mes "但几乎不可能被录用。";
	mes "人们到底怎样才能进去工作呢？";
	close;
	}
	
	lighthalzen,77,157,5	script	Villagomez#li_01	866,{
	mes "[Villagomez]";
mes "我只是出门理个发，";
mes "现在却迷路了。天哪，希望";
mes "家人不会一直等我。^333333*叹气……*^000000";
	close;
	}
	
	lighthalzen,125,68,5	script	Kemp#zen13	97,{
	mes "[Kemp]";
	mes "你见过那边大企业的员工吗？";
	mes "我觉得他们不知为何";
	mes "都有点不正常。";
	next;
	mes "[Kemp]";
	mes "我自己没去过，";
	mes "但那里所有员工";
	mes "似乎都发生了奇怪的事。";
	close;
	}
	
lighthalzen,138,50,7	script	Mauro#zen3	847,{
mes "[Mauro]";
mes "这座城的年轻人一点也不尊重长辈。";
	mes "我这么多年辛苦建设这座城市，";
	mes "得到的就是这种回报？";
	next;
	mes "[Mauro]";
	mes "呸！如果没有我们，";
	mes "Lighthalzen 不会像今天这样繁荣！";
	mes "那些孩子不知道他们的奢华生活";
	mes "全都归功于我们……";
	close;
	}
	
	lighthalzen,132,103,5	script	Sefith#li_01	734,{
	mes "[Sefith]";
	mes "英俊外表，聪明才智。";
mes "优秀礼仪，坚毅阳刚的下巴，";
mes "锐利而摄人的双眼。激情与魅力完美平衡。";
mes "这都是女士们想要的优点。";
	next;
	mes "[Sefith]";
	mes "不过别再说我了。";
	mes "让我们谈谈 Lighthalzen 其他男人有多可怜。";
	mes "他们的魅力根本无法与我相提并论～";
	close;
	}
	
	lighthalzen,239,64,5	script	Jade#zen2	862,{
	mes "[Jade]";
	mes "我听说外面有一个奇怪的王国，";
	mes "基本由魔法和剑统治，";
	mes "冒险者在那里为更大的善而战。";
	next;
	mes "[Jade]";
	mes "你来自卢恩-米德加尔特吗？";
	mes "你怎么看我们这座";
	mes "拥有先进科技和经济的城市？嗯……";
	next;
	mes "[Jade]";
	mes "总有一天我想去你来的地方。";
	mes "听起来既奇幻又浪漫……";
	close;

moc_ruins,123,154,0	script	Young Man#moc01	99,{
	mes "[Young Man]";
	mes "城镇完全毁了，但那座巨大的三角建筑毫发无伤。也许受到某种特殊力量保护。";
	next;
	mes "[Young Man]";
	mes "你知道……梦罗克西北角那些巨大的三角建筑，我们称之为金字塔……";
	next;
	mes "[Young Man]";
	mes "那些建筑已经存在了数千年。没人知道何时、为何建造，也没人知道是谁建造的。";
	next;
	mes "[Young Man]";
	mes "我们只知道那些奇怪建筑里住着大量魔物。你最好远离那些危险的地方。";
	next;
	mes "[Young Man]";
	mes "金字塔里的魔物对人类身上的甜腻气味非常敏感……";
	close;
}

moc_ruins,128,153,0	script	Grampa#moc	61,{

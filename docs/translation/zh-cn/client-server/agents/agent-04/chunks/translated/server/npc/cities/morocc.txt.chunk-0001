}

morocc,268,287,3	script	Volunteer - Morocc#04	727,{
	mes "[Morocc Volunteer]";
	mes "情况已经很糟，我们甚至无法请求更多支援。";
	mes "这一定是卢恩-米德加尔特历史上最糟糕的灾难。";

moc_ruins,121,116,4	script	Picky Lady#moc	66,{
	mes "[Syvia]";
	mes "卢恩-米德加尔特的原野到处都是危险魔物……但你得承认，其中很多真的超可爱！";
	mes "比如杀死孢子后，它会吐舌头……";
	next;
	mes "[Syvia]";
	mes "或者小小的 Picky 有时会戴着小蛋壳……？";
	next;
	mes "[Syvia]";
	mes "我不敢相信发生了这一切……我们的城镇曾有那些可爱的小魔物，而不是沉睡着那种凶恶可怕的邪恶！呼……";
	next;
	mes "[Syvia]";
	mes "我好害怕……我只想看着那些可爱的小波利，让自己安心……";
	next;
	switch(select("What about Angeling?:How about Ghostring?:Quit Conversation")) {
	case 1:
		mes "[Syvia]";
		mes "哦！天使波利就像波利，只是长着天使翅膀！当然，我不知道它们能不能真的飞……";
		next;
		mes "[Syvia]";
		mes "天使波利很少见，但在普隆德拉南边某个原野的大群波利中可以找到。";
		mes "天使波利是拥有圣属性的高级魔物，因此免疫大多数魔法，但中性或暗属性攻击除外。";
		next;
		mes "[Syvia]";
		mes "嘿嘿～你不觉得我很了解波利吗？我太喜欢它们了。";
		next;
		mes "[Syvia]";
		mes "嘿嘿……波利……嘻……";
		close;
	case 2:
		mes "[Syvia]";
		mes "幽灵波利是邪恶的幽灵波利。它很少见，但在普隆德拉南边某个原野的大群波利中可以找到。";
		next;
		mes "[Syvia]";
		mes "幽灵波利是拥有幽灵属性的高级魔物，可以抵御所有物理攻击。";
		mes "只有魔法或带有特定属性的武器才能对它造成伤害。";
		next;
		mes "[Syvia]";
		mes "嘿嘿～你不觉得我很了解波利吗？我太喜欢它们了～";
		next;
		mes "[Syvia]";
		mes "嘿嘿……波利……嘻嘻……";
		close;
	case 3:
		mes "[Syvia]";
		mes "嘿嘿……波利……嘻嘻……";
		close;
	}
}

moc_ruins,155,107,4	script	Ant Man#moc	47,{
	mes "[Akira]";
	mes "喂，你穿越沙漠了吗？";
	next;
	mes "[Akira]";
	mes "穿过沙漠，向北约一张地图、向东三张地图，就能找到蚂蚁地狱入口。";
	next;
	mes "[Akira]";
	mes "蚂蚁地狱有两个入口。进入后，蜿蜒洞窟的地下第一层和第二层彼此相连。";
	next;
	mes "[Akira]";
	mes "我很想知道灾难后入口变成什么样，但我出不去……如果你听到任何消息，请告诉我。";
	next;
	switch(select("About 'Ant Hell':About Ants:End Conversation")) {
	case 1:
		mes "[Akira]";
		mes "那洞窟确实是危险的地狱，又黏又糟……共有两层地下区域。";
		mes "向东走，直到看到连接斐扬森林的桥。";
		next;
		mes "[Akira]";
		mes "在桥前一张地图向北走即可找到蚂蚁地狱入口，不过我不确定它还在不在。";
		close;
	case 2:
		mes "[Akira]";
		mes "蚂蚁地狱里到处都是蚂蚁魔物。你会发现它们按不同名字分类……";
		next;
		mes "[Akira]";
		mes "Andre 最弱，Piere 普通，Deniro 是最强的蚂蚁。记住这些，选择适合自己等级的对手。";
		next;
		mes "[Akira]";
		mes "Andre 是象牙色，Piere 是黄绿色，红色的是 Deniro。";
		mes "它们外表差异很大，很容易与普通蚂蚁 Bitata 区分。";
		next;
		mes "[Akira]";
		mes "哦，那些蚂蚁像波利一样贪婪，会试图偷走你的物品，记住这一点。";
		next;
		mes "[Akira]";
		mes "如果你能在不受撒旦干扰的情况下穿越沙漠……";
		close;
	case 3:
		mes "[Akira]";
		mes "还有一个叫 Guias 的老人，土地之灵。他很难对付。";
		next;
		mes "[Akira]";
		mes "蚂蚁的利齿和强颚需要小心，但那个老爷爷的铲土技术也很强，同样要提防。";
		next;
		mes "[Akira]";
		mes "……我在说什么呢？梦罗克魔王都复活了，还有什么好怕的？呵……呵呵……";
		close;
	}
}

moc_ruins,143,43,4	script	Assassin Boy#moc	118,{

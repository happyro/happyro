morocc,150,120,5	script	Soldier - Morocc#01::MocSoldier	707,3,3,{
	mes "[Morocc Soldier]";
	mes "喂，你！站住。";
	next;
	mes "[Morocc Soldier]";
	mes "这里是限制区域。你不能再往前了！";
	close;

OnTouch_:
	mes "[Morocc Soldier]";
	mes "喂，你！站住。";
	next;
	mes "[Morocc Soldier]";
	mes "这里是限制区域。你不能再往前了！";
	close;
}

morocc,202,244,0	script	Volunteer - Morocc#01	745,{
	mes "[Morocc Volunteer]";
	mes "那场可怕的灾难摧毁了整个梦罗克后，卢恩-米德加尔特王国召集我们志愿者帮助重建。";
	next;
	mes "[Morocc Volunteer]";
	mes "事情如此重要，大家都很谨慎，但总有人意识不到情况，你不觉得吗？";
	close;
}

morocc,88,133,3	script	Volunteer - Morocc#02	748,{
	mes "[Morocc Volunteer]";
	mes "我们……工作多得做不完……";
	next;
	mes "[Morocc Volunteer]";
	mes "无论多努力，工作都像永远做不完！！！";
	mes "卢恩-米德加尔特的居民！！请伸出援手！！";
	next;
	mes "[Morocc Volunteer]";
	mes "哈……呼……呃……";
	close;
}

morocc,202,110,0	script	Volunteer - Morocc#03	730,{

	switch(select("?????:Where I can find the Assassin clan?:End Conversation")) {
	case 1:
		mes "[Slayer Kid]";
		mes "我听说刺客练习悄无声息地杀人……";
		next;
		mes "[Slayer Kid]";
		mes "我三年前离开家，一直在寻找他们的秘密基地……";
		mes "他们真的那么神出鬼没吗？！";
		next;
		mes "[Slayer Kid]";
		mes "嗯……现在也许太迟了……";
		mes "既然城镇都毁了……接下来发生什么我也不在乎了……";
		close;
	case 2:
		mes "[Slayer Kid]";
		mes "你知道吗……";
		mes "看来根本找不到。";
		next;
		mes "[Slayer Kid]";
		mes "我听说离开城镇向东两张地图，再向南两张地图，就能找到它……";
		next;
		mes "[Slayer Kid]";
		mes "‘幻影塔’是苏克拉特沙漠的主建筑，据说会在这场可怕的沙尘暴中出现！但我还没找到它。";
		next;
		mes "[Slayer Kid]";
		mes "如果你找到他们，且族长认为你合格，就能成为刺客！至少我是这么想的……";
		next;
		mes "[Slayer Kid]";
		mes "我听说最酷的刺客是刺客十字军！不过那更神秘～除非你是伟大的盗贼，否则见不到他们！";
		next;
		mes "[Slayer Kid]";
		mes "可是……梦罗克毁灭时他们到底在做什么？！！！";
		close;
	case 3:
		mes "[Slayer Kid]";
		mes "刺客是盗贼的进阶职业，专精中性和毒属性攻击。";
		next;
		mes "[Slayer Kid]";
		mes "他们也非常隐秘！听说能隐匿身形，让任何人都看不见！";
		next;
		mes "[Slayer Kid]";
		mes "可是……梦罗克毁灭时他们到底在做什么？！！！";
		close;
	}
}

moc_ruins,173,141,4	script	Dimitri#moc	49,{
	mes "[Dimitri]";
	mes "梦罗克沙漠是米德加尔特平均温度最高的地方。在沙漠中央坐到沙子上前最好三思，否则屁股会被烤焦。";
	next;
	switch(select("About the desert sands:About the remedy for Fatigue:End Conversation")) {
	case 1:
		mes "[Dimitri]";
		mes "……我的意思是……";
		mes "看起来应该全烧焦了，但其实没有！";
		next;
		mes "[Dimitri]";
		mes "需要时可以坐下休息，屁股不会烧着。我想梦罗克的沙子导热性没那么强。";
		next;
		mes "[Dimitri]";
		mes "所以每个人都能在沙漠中央恢复 HP 和 SP。";
		next;
		mes "[Dimitri]";
		mes "现在想想，梦罗克平均温度异常高，也许是因为撒旦被封印在其中。";
		close;
	case 2:
		mes "[Dimitri]";
		mes "恢复！";
		mes "药水就是用来做这个的！";
		mes "红色药水价格便宜，一直很受欢迎，尽管只能恢复少量 HP。";
		next;
		mes "[Dimitri]";
		mes "去金字塔附近的绿洲时，试试这瓶冰凉药水……";
		mes "是啊……你很需要它……但现在情况不妙……";
		close;
	case 3:
		mes "[Dimitri]";
		mes "有时‘牛奶’会从‘大嘴鸟的蛋’里出来。";
		mes "我不明白牛奶怎么会从鸟蛋里出来……";
		next;
		mes "[Dimitri]";
		mes "我不是科学家，但这怎么可能？";
		mes "牛奶是和蛋一起包装的，还是以某种方式进去的？";
		mes "算了……现在不是想这个的时候。";
		close;
	}
}

moc_ruins,174,120,4	script	Fly Man#moc	54,{
	mes "[Armani]";
	mes "哦，哇——！";
	next;
	mes "[Armani]";
	mes "我……我真的看到了……蝇王一眨眼就被打成碎片……";
	next;

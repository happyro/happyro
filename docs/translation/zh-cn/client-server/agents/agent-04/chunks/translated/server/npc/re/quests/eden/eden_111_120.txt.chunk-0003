						mes "[Mingmin]";
						mes "我还听说那个蓝帽子家伙成了公会会长。想象那个笨蛋当会长，呵呵呵。";
					}
					continue;
				case 2:
					if (para_110lv01 < 5) {
						cutin "min01",0;
						mes "我研究怪物，尤其是它们的特征、性格、脾脏、地点和与其他怪物的关系等等。";
					}
					else if (para_110lv01 == 5) {
						cutin "min03",0;
						mes "研究这些魔法物品不只是把它们拿在手里。";
						next;
						mes "[Mingmin]";
						mes "目前计划是这样：从神秘之角提取的魔力由碎片和螺丝压缩。 然后输入写在血色书页上的古代信息。";
						next;
						mes "[Mingmin]";
						mes "我希望制造某种小型手持存储装置。";
						next;
						mes "[Mingmin]";
						mes "完成这项研究我就会发财！我确定。";
					}
					else {
						cutin "min01",0;
		mes "你还记得我之前提到的个人研究吗？即使我努力开发，也并不容易……";
						next;
						mes "[Mingmin]";
						mes "我试图制作可以握在手里的魔法装置。";
						next;
						mes "[Mingmin]";
						mes "不，我不能放弃。我一定会做出来。";
					}
					continue;
				case 3:
					if (para_110lv01 < 5) {
						cutin "min02",0;
						mes "橙色蘑菇？我不知道。";
					}
					else if (para_110lv01 == 5) {
						cutin "min01",0;
						mes "别担心。好吧，也许该担心，因为蘑菇可能正在你体内生长。如果你帮我研究，我会把它清除。拖得越久就越危险。";
					}
					else {
						cutin "min02",0;
						mes "……橙色香菇黏菌？";
						next;
						mes "[Mingmin]";
						mes "让我看看。这可能很危险。";
						next;
						mes "[Mingmin]";
						mes "你帮我研究，所以让我也帮你！我会清除你的蘑菇孢子感染。";
						next;
						mes "[Mingmin]";
						mes "......";
						next;
						cutin "min03",0;
						mes "[Mingmin]";
						mes "...hee hee...";
						emotion ET_SMILE;
						next;
						mes "[Mingmin]";
						mes "哼，你太天真了。你信了吗？黏糊糊的蘑菇在你体内生长？哈哈哈";
						next;
						mes "[Mingmin]";
						mes "只是玩笑。朋友间的小玩笑。";
						next;
						mes "[Mingmin]";
						mes "如果你感到沮丧，我很抱歉。你让事情变得太容易了……";
						next;
						emotion ET_SMILE;
						mes "[Mingmin]";
						mes "你比我想象的更有趣。别担心，那种蘑菇不存在。";
					}
					continue;
				case 4:
					if (para_110lv01 == 5) {
						cutin "min01",0;
						mes "请帮助我，有太多东西要研究。";
					}
					else {
						cutin "min02",0;
					mes "希望你玩得开心。";
					}
				}
				break;
			}
		}
	}
	close2;
	cutin "",255;
	end;

S_Quest:
	if (isbegin_quest(getarg(0)))
		erasequest getarg(0);
	setquest getarg(1);
	if (getarg(2,0))
		getexp getarg(2),getarg(3);
	return;
S_Hunting:
	.@total = getargcount();
	for ( .@i = 0; .@i < .@total; .@i += 3 ) {
		.@quest_id = getarg(.@i);
		switch( checkquest(.@quest_id,HUNTING) ) {
		case -1:
			if (checkquest(.@quest_id+1) > -1)
				erasequest (.@quest_id+1);
			continue;
		case 2:
			mes "[Mingmin]";
			mes "你完成了关于"+ getarg(.@i+2) +". 谢谢。";
			getexp 700000,getarg(.@i+1);
			break;
		case 0:
		case 1:
			mes "[Mingmin]";
			mes "我会把"+ getarg(.@i+2) +"研究从委托列表中删除。";
		}
		erasequest .@quest_id;
		next;
	}
	return;
S_Gathering:
	.@quest_id = getarg(0);
	if (isbegin_quest(.@quest_id) > 0) {
		if (getarg(5,0))
			.@count_item2 = countitem(getarg(5));
		mes "[Mingmin]";
		if (countitem(getarg(3)) >= getarg(4) && .@count_item2 >= getarg(6,0)) {
			if (.@count_item2)
				mes "你完成了关于"+ getitemname(getarg(3)) +"和"+ getitemname(getarg(5)) +"的研究。谢谢。";
			else
				mes "你完成了关于"+ getitemname(getarg(3)) +". 谢谢。";
			delitem getarg(3),getarg(4);
			if (getarg(5,0))
				delitem getarg(5),getarg(6);
			getexp 700000,getarg(1);
		}
		else {
			if (getarg(5,0))
				mes "我会把"+ getitemname(getarg(3)) +"和"+ getitemname(getarg(5)) +"研究从委托列表中删除。";
			else
				mes "我会把"+ getitemname(getarg(3)) +"研究从委托列表中删除。";
		}
		erasequest .@quest_id;
		next;
	}
	else if (isbegin_quest(.@quest_id+1) > 0)
		erasequest (.@quest_id+1);
	return;
}

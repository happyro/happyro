		close;
	}
	if (checkweight(1201,1) == 0) {
		mes "你的背包太满，无法继续。清理空间后再回来。";
		close;
	}
	for(set .@i,5074; .@i<=5090; set .@i,.@i+1) {
		if (checkquest(.@i) > -1) {
			mes "[塞尔]";
			mes "嘿，^0000FF"+strcharinfo(0)+"^000000。你还没有完成我们拜托的事。答应的事就要做到。";
			next;
			mes "[塞尔]";
			mes "啊！！完成后请让那边的猫咪玩家协会会长确认。";
			close;
		}
	}
	if (malang_gamer < 20) {
		if (countitem(2872)) {
			mes "[塞尔]";
			mes "你看起来是第一次来！你从哪里得到证书的？我猜是有人弄丢的。";
			close;
		}
		mes "[塞尔]";
		mes "猜拳是很严肃的游戏。我们的练习伙伴什么时候来？";
		close;
	}
	if (!isequipped(2872)) {
		mes "[塞尔]";
		mes "哦，^0000FF"+strcharinfo(0)+"^000000？想玩猜拳吗？";
		next;
		mes "[塞尔]";
		mes "... ... ...";
		next;
		mes "[塞尔]";
		mes "你的猫咪玩家证书呢？看起来没什么，但没有它就不能玩这个游戏！";
		next;
		mes "[塞尔]";
		mes "请去拿证书。";
		close;
	}
	if (checkquest(5070,PLAYTIME) == 0 || checkquest(5070,PLAYTIME) == 1) {
		mes "[塞尔]";
		mes "已经是明天了吗？我觉得还没有！你不会看时间吗？";
		close;
	} else if (checkquest(5070,PLAYTIME) == 2)
		erasequest 5070;
	mes "[塞尔]";
	mes "哦，^0000FF"+strcharinfo(0)+"^000000？想玩猜拳吗？";
	next;
	switch(select("Play the game.:Say hi.:Ask about the game rules.")) {
	case 1:
		mes "[塞尔]";
		mes "好主意。";
		next;
		break;
	case 2:
		mes "[塞尔]";
		mes "哦！好吧，你好？不过为什么是现在？";
		next;
		mes "[塞尔]";
		mes "啊……你很无聊吗？要不要和我玩一局？";
		next;
		mes "[塞尔]";
		mes "嘿，你！别忽视猜拳游戏！！";
		mes "我见过很多人在这个游戏里被打得落花流水！！";
		next;
		mes "[塞尔]";
		mes "如果不想落得和他们一样，就记住我的话！～";
		close;
	case 3:
		mes "[塞尔]";
		mes "你连这个游戏怎么玩都不知道吗？";
		mes "让我好好教你。";
		next;
		mes "[塞尔]";
		mes "剪刀胜过布，";
		emotion ET_SCISSOR;
		emotion ET_WRAP, playerattached();
		next;
		mes "[塞尔]";
		mes "布胜过石头，";
		emotion ET_WRAP;
		emotion ET_ROCK, playerattached();
		next;
		mes "[塞尔]";
		mes "石头胜过剪刀。";
		emotion ET_ROCK;
		emotion ET_SCISSOR, playerattached();
		next;
		mes "[塞尔]";
		mes "明白了吗？";
		next;
		mes "[塞尔]";
		mes "你必须和我进行5场比赛。";
		mes "平局就重赛！！";
		next;
		mes "[塞尔]";
		mes "如果你赢我3次，我会送你礼物。明白？";
		next;
		mes "[塞尔]";
		mes "好吧，那就走开。";
		close;
	}
	setarray .@rps$[0], "石头", "剪刀", "布";
	setarray .@emote[0], ET_ROCK, ET_WRAP, ET_SCISSOR;
	setarray .@count$[0],"第一","第二","第三","第四","最后";
	while(1) {
		mes "[塞尔]";
		mes .@count$[.@match]+"场比赛~~";
		if (.@tie) {
			mes "结果平局，再来一局。";
			set .@tie,0;
		}
		mes "尽力而为！";
		next;
		mes "[Ser & "+strcharinfo(0)+"]";
		mes "石头！剪刀！布！";
		next;

		set .@pc,  select("Rock:Paper:Scissors")-1;
		set .@npc, rand(3);
		emotion .@emote[.@pc], playerattached();
		emotion .@emote[.@npc];
		mes "["+strcharinfo(0)+"] "+.@rps$[.@pc];
		mes "--------------------------------";
		mes "[Ser] "+.@rps$[.@npc];
		if (.@pc == .@npc) {
			set .@tie,1;
			set .@result$, "嗯，我们平局。再来一局。";
		} else if ((.@pc == 0 && .@npc == 2) || (.@pc == 1 && .@npc == 0) || (.@pc == 2 && .@npc == 1)) {
			set .@match, .@match+1;
			set .@win, .@win+1;
			set .@result$, "我输了！";
		} else {
			set .@match, .@match+1;
			set .@loss, .@loss+1;
			set .@result$, "所以我赢了！！";
		}
		next;
		mes "[塞尔]";
		mes "你出了"+.@rps$[.@pc]+"，我出了"+.@rps$[.@npc]+"～";
		mes .@result$;
		next;
		if (.@match == 5) break;
	}
	mes "[塞尔]";
	mes "5 场比赛全部结束！！";
	next;
	mes "[塞尔]";
	mes "嗯……让我看看……";
	mes "我赢了"+.@loss+"次，而你，"+strcharinfo(0)+",赢了"+.@win+"次，对吧？";
	next;
	if (.@win > .@loss) {
		mes "[塞尔]";
		mes strcharinfo(0)+" 赢得了比赛。";
		next;
		mes "Ser 突然变得有礼貌了。";
		next;
		mes "[塞尔]";
		mes "比赛很精彩。我很欣赏你对游戏的热情。所以我想把珍贵的罐头作为礼物送给你。";
		next;
		switch(select("我不需要！:谢谢。")) {
		case 1:
			mes "[塞尔]";
			mes "拿着吧！！听我的～";
			break;
		case 2:
			mes "[塞尔]";
			mes "你很有礼貌。不过遗憾的是，这就是我能给你的全部。";
			break;
		}
		next;
		mes "[塞尔]";
		mes "再见～明天再来练习吧～";
		if (.@win == 5) {
			mes "哦！你赢了全部 5 场比赛。这些额外罐头给你。";
			getitem 12636,10; //Malang_Sp_Can
		} else
			getitem 12636,5; //Malang_Sp_Can
		setquest 5070;
		close;
	}
	mes "[塞尔]";
	mes strcharinfo(0)+"输了。哈……哈……";
	next;
	mes "Ser 变得非常傲慢。";
	next;
	mes "[塞尔]";
	mes "你想和我玩吗？Ser？凭你的技术？喵？";
	next;
	mes "[塞尔]";
	mes "什么？礼物？你输了还好意思要礼物？多练习！！努力！！没错，我该让你这样做！！";
	next;
	setquest 5070;
	switch(rand(1,13)) {
	case 1:
		setquest 5074;
		mes "[塞尔]";
		mes "嗯。你知道一种叫 Phen 的鱼吗？知道吗？看起来很好吃吧？";
		next;
		mes "- Chrub -";
		mes "Ser 擦掉嘴角的口水。";
		next;
		mes "[塞尔]";
		mes "去捕捉 30 条 Phen。再给我 10 条鱼尾。交给我们的猫咪会长，他会用它们做出美味料理。";
		close;
	case 2:
		setquest 5075;
		mes "[塞尔]";
		mes "最近我感到无力，身上的负担也太重了。我应该照顾好自己的健康。";
		next;
		mes "[塞尔]";
		mes "现在该吃些健康食品了。";
		next;
		mes "[塞尔]";
		mes "带50个Marse和25瓶牛奶给我们的猫咪玩家会长。他非常了解健康食品。";
		close;
	case 3:
		setquest 5076;
		mes "[塞尔]";
		mes "嗯……我们确实有个对手，你知道的。他们是‘狗与华尔兹’，他们一来就什么都不顺。";
		next;
		mes "[塞尔]";
		mes "我想让你欺负他们，但那应该违法……所以至少去骚扰长得像他们的怪物吧。什么目标好呢？";
		next;
		mes "[塞尔]";
		mes "哦，狗头人中的弓箭手！！我最讨厌它们。去骚扰 30 只狗头人弓箭手，然后向猫咪玩家协会会长报告。";
		close;
	case 4:
		setquest 5077;
		mes "[塞尔]";
		mes "赢得比赛最重要的是什么？是速度。我们该怎么做才能更快？";
		next;
		mes "[塞尔]";
		mes "我一直在想……对我们猫来说，最好的办法当然是捕捉老鼠。";
		next;
		mes "[塞尔]";
		mes "你知道Cramp吧？就是那种蓝色的胖家伙……请捕捉10只，然后向我们的猫咪玩家会长报告。";
		close;
	case 5:
		setquest 5078;
		mes "[塞尔]";
		mes "啊……我想吃鸟类料理。哪一种最好吃？";
		next;
		mes "[塞尔]";
		mes "挑剔？啊！它太小了。秃鹰怎么样？我不确定……大嘴鸟？";
		next;
		mes "[塞尔]";
		mes "好！请捕捉 50 只大嘴鸟，交给猫咪玩家协会会长。今晚我们要举办鸟肉料理派对。";
		close;
	case 6:
		setquest 5079;
		mes "[塞尔]";
		mes "我在比赛前太紧张了。紧张时我发挥不好，需要在比赛开始前找点东西冷静下来。";
		next;
		mes "[塞尔]";
		mes "哦！对了！毛线！我小时候常玩毛线。加入‘猫咪玩家协会’后就再也没法放松了。";
		next;
		mes "[塞尔]";
		mes "请给我20个毛线。为什么是20个？还有很多猫也有同样的问题。我们的会长会帮你处理。";
		close;
	case 7:
		setquest 5080;
		mes "[塞尔]";
		mes "最近我们的会长似乎想削减开支。还是管理者在占便宜？";
		next;
		mes "[塞尔]";
		mes "玩家们平时的零食减少了。你去弄 30 条鼠尾，交给猫咪玩家协会会长。";
		next;
		mes "[塞尔]";
		mes "这样我们就能知道管理者是不是贪心。";
		close;
	case 8:
		setquest 5081;
		mes "[塞尔]";
		mes "我最近状态低迷。我无法以百分之百的状态参加比赛。";
		next;
		mes "[塞尔]";
		mes "这种时候我们需要柠檬。";
		next;
		mes "[塞尔]";
		mes "请给我5个柠檬。别忘了，我需要5个柠檬……我们的猫咪玩家会长应该知道怎么处理它们。";
		close;
	case 9:
		setquest 5082;
		mes "[塞尔]";
		mes "马朗岛是猫咪生活的好地方。不过我们玩游戏时会变得非常热。";
		next;
		mes "[塞尔]";
		mes "我们玩得尽兴时会热得发疯，很难忍受。你知道我们猫咪有多容易歇斯底里，对吧？";
		next;
		mes "[塞尔]";
		mes "请给我们10个冰块或10个冰淇淋。我们的猫咪玩家会长应该知道怎么处理它们。";
		close;
	case 10:
		setquest 5083;
		mes "[塞尔]";
		mes "我看你也需要休息一下。放松一会儿吧。去村子周围散散步怎么样？一定要去哦~！";
		next;
		mes "[塞尔]";
		mes "不过只是在村子周围散步也没意思。嗯……对了！！你为什么不去见一只叫 Eryu 的猫？";
		next;
		mes "[塞尔]";
		mes "哦！见到那只猫时，记得说‘回来’。这是口令。别忘了告诉我们的会长我一直和你在一起！！";
		close;
	case 11:
		setquest 5085;
		mes "[塞尔]";
		mes "我看你也需要休息一下。放松一会儿吧。去村子周围散散步怎么样？一定要去哦~！";
		next;
		mes "[塞尔]";
		mes "不过只是在村子周围散步也没意思。嗯……对了！！你为什么不去见一只叫 Stew 的猫？";
		next;
		mes "[塞尔]";
		mes "哦！见到那只猫时，记得说‘回来’。这是口令。别忘了告诉我们的会长我一直和你在一起！！";
		close;
	case 12:
		setquest 5087;
		mes "[塞尔]";
		mes "我看你也需要休息一下。放松一会儿吧。去村子周围散散步怎么样？一定要去哦~！";
		next;
		mes "[塞尔]";
		mes "不过只是在村子周围散步也没意思。嗯……对了！！你为什么不去见一只叫 Ketchup 的猫？";
		next;
		mes "[塞尔]";
		mes "哦！见到那只猫时，记得说‘回来’。这是口令。别忘了告诉我们的会长我一直和你在一起！！";
		close;
	case 13:
		setquest 5089;
		mes "[塞尔]";
		mes "我看你也需要休息一下。放松一会儿吧。去村子周围散散步怎么样？一定要去哦~！";
		next;
		mes "[塞尔]";
		mes "不过只是在村子周围散步也没意思。嗯……对了！！你为什么不去见一只叫 Eff 的猫？";
		next;
		mes "[塞尔]";
		mes "哦！见到那只猫时，记得说‘回来’。这是口令。别忘了告诉我们的会长我一直和你在一起！！";
		close;
	}
}

mal_in01,86,222,4	script	Paa#gamer	544,{
	if (MaxWeight - Weight < 1000) {
		mes "你的物品栏太重，无法继续。减轻负重后再回来。";
		close;
	}
	if (checkweight(1201,1) == 0) {
		mes "你的背包太满，无法继续。清理空间后再回来。";
		close;
	}
	for(set .@i,5074; .@i<=5090; set .@i,.@i+1) {
		if (checkquest(.@i) > -1) {
			mes "[帕阿]";
			mes "你还没有完成我们拜托你的事，喵。一诺千金，你知道的，喵。";
			next;
			mes "[帕阿]";
			mes "完成后，请去让那边的猫咪玩家会长检查一下，喵。";
			close;
		}
	}
	if (malang_gamer < 20) {
		if (countitem(2872)) {
			mes "[帕阿]";
			mes "你看起来像是第一次来，喵！你从哪里拿到证书的，喵？我猜是有人弄丢了，喵。";
			close;
		}
		mes "[帕阿]";
		mes "我们的练习伙伴什么时候来喵？我好无聊喵。";
		close;
	}
	if (!isequipped(2872)) {
		mes "[帕阿]";
		mes "哦，^0000FF"+strcharinfo(0)+"^000000，喵？想玩猜拳游戏吗，喵？";
		next;
		mes "[帕阿]";
		mes "... ... ...";
		next;
		mes "[帕阿]";
		mes "你的猫咪玩家证书呢，喵？看起来没什么，但没有它就不能玩这个游戏，喵！";
		next;
		mes "[帕阿]";
		mes "去拿证书，喵。";
		close;
	}
	if (checkquest(5070,PLAYTIME) == 0 || checkquest(5070,PLAYTIME) == 1) {
		mes "[帕阿]";
		mes "我们每天只能玩一次，喵。明天再来，喵。";
		close;
	} else if (checkquest(5070,PLAYTIME) == 2)
		erasequest 5070;
	mes "[帕阿]";
	mes "哦，^0000FF"+strcharinfo(0)+"^000000，喵？想玩猜拳游戏吗，喵？";
	next;
	switch(select("Play the game.:Say hi.:Ask about the game rules.")) {
	case 1:
		mes "[帕阿]";
		mes "好主意，喵。";
		next;
		break;
	case 2:
		mes "[帕阿]";
		mes "你好喵～见到你真好喵～";
		next;
		mes "[帕阿]";
		mes "其他游戏只有一名猫咪玩家。但猜拳有两名。你想知道为什么吗，喵？";
		next;
		mes "[帕阿]";
		mes "帕很善良，喵。所以我来告诉你故事，喵。";
		next;
		mes "[帕阿]";
		mes "塞尔是我的双胞胎哥哥。我先出生，但他总说自己是哥哥，喵。不过我不会和塞尔争，喵。我是个好弟弟，喵。";
		next;
		mes "[帕阿]";
		mes "总之，我和塞尔是有名的职业游戏猫兄弟，喵。大家都认识我们，喵。";
		next;
		mes "[帕阿]";
		mes "你可以尽情崇拜我，喵。我允许你这么做，喵。";
		close;
	case 3:
		mes "[帕阿]";
		mes "你想知道怎么玩这个游戏吗，喵？我会教你的，因为我是善良的猫，喵~";
		next;
		mes "[帕阿]";
		mes "你看起来没那么笨，喵。所以克制关系的部分就跳过吧，喵。";
		next;
		mes "[帕阿]";
		mes "你必须和我玩5场喵。如果平局，就再玩一场，喵。";
		next;
		mes "[帕阿]";
		mes "如果你赢3次，我就送你礼物喵～猫咪玩家会长是这么说的，喵。";
		next;
		mes "[帕阿]";
		mes "就是这些，喵~但这不是简单的游戏，喵。请尊重游戏，喵~";
		close;
	}
	setarray .@rps$[0], "Rock", "Paper", "Scissors";
	setarray .@emote[0], ET_ROCK, ET_WRAP, ET_SCISSOR;
	setarray .@count$[0],"First","Second","Third","Fourth","Last";
	while(1) {
		mes "[帕阿]";
		mes .@count$[.@match]+"场比赛~~喵。";
		if (.@tie) {
			mes "结果是平局，所以再玩一场，喵。";
			set .@tie,0;
		}
		mes "尽你所能，喵！";
		next;
		mes "[Ser & "+strcharinfo(0)+"]";
		mes "石头！纸！剪刀！";
		next;

		set .@pc,  select("Rock:Paper:Scissors")-1;
		set .@npc, rand(3);
		emotion .@emote[.@pc], playerattached();
		emotion .@emote[.@npc];
		mes "["+strcharinfo(0)+"] "+.@rps$[.@pc];
		mes "--------------------------------";
		mes "[Ser] "+.@rps$[.@npc];
		if (.@pc == .@npc) {
			set .@tie,1;
			set .@result$, "Hmm, we are even. Let's play again meow.";
		} else if ((.@pc == 0 && .@npc == 2) || (.@pc == 1 && .@npc == 0) || (.@pc == 2 && .@npc == 1)) {
			set .@match, .@match+1;
			set .@win, .@win+1;
			set .@result$, "I lost meow!";
		} else {
			set .@match, .@match+1;
			set .@loss, .@loss+1;
			set .@result$, "So I win meow!!";
		}
		next;
		mes "[帕阿]";
		mes "你出了"+.@rps$[.@pc]+"，我出了"+.@rps$[.@npc]+"~";
		mes .@result$;
		next;
		if (.@match == 5) break;
	}
	mes "[帕阿]";
	mes "喵！！5场比赛全部结束喵！！";

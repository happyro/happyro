		mes "[德弗里斯]";
		mes "在等待公会回复时，你可以看看德米·卡尔贝琳的工作场所。";
		close;
	} else if (job_gen == 76) {
		mes "[德弗里斯]";
		mes "波波！";
		mes "我有好消息告诉你！";
		next;
		if (checkweight(1201,2) == 0 || MaxWeight - Weight < 2000) {
			mes "- 等一下！！ -";
			mes "- 你目前携带了 -";
			mes "- 太多物品。 -";
			mes "- 请重试 -";
			mes "- 减轻负重后。 -";
			close;
		}
		mes "[德弗里斯]";
		if (BaseJob != Job_Alchemist || BaseLevel < 99 || JobLevel < 50) {
			mes "哦，看起来你还没准备好听。";
			close;
		}
		if (checkcart()){
			mes "先卸下沉重又脏的手推车，它不适合这个快乐时刻。";
			close;
		}
		if (SkillPoint != 0) {
			mes "但你似乎还留恋之前的研究。";
			close;
		}
		mes "炼金术士公会寄来了一封信。";
		mes "我读给你听，波波！";
		next;
		mes "<亲爱的德弗里斯小姐：>";
		mes "<我们非常了解你最近展现出的杰出活动。>";
		next;
		mes "<德弗里斯小姐>";
		mes "这个人也来自我的家乡。";
		next;
		mes "<我听说你的研究成果即将进入商业应用，这是个好消息。>";
		mes "<我相信这会给其他炼金术士带来很大的启发。>";
		next;
		mes "<说起来，你还附上了一篇论文？>";
		mes "<那是名为"+strcharinfo(0)+"的炼金术士发现的一种能让植物超速生长的新植物。>";
		next;
		mes "<我和炼金术士公会的许多成员都对此非常感兴趣。>";
		next;
		mes "<我们期待看到更多研究论文和成果，尤其是听到这个消息的其他基因研究者。>";
		next;
		mes "<德弗里斯小姐>";
		mes "<我认为"+strcharinfo(0)+"拥有成为基因研究者所需的能力和才华。>";
		next;
		mes "<请尽快告诉"+strcharinfo(0)+"，今后我们期待其作为基因研究者做出杰出成果。>";
		next;
		mes "<炼金术士公会为德弗里斯小姐、德米·卡尔贝琳小姐和"+strcharinfo(0)+"这些才华横溢的人感到骄傲。>";
		mes "<我们也希望你今后继续结出丰硕成果。>";
		next;
		mes "[德弗里斯]";
		if (ismounting()) {
			mes "你正骑着坐骑，";
			mes "所以无法转职。";
			mes "请卸下坐骑后重试！";
			close;
		}
		mes "恭喜你，波波！";
		mes "从现在起你就是基因研究者！！";
		jobchange roclass(eaclass()|EAJL_THIRD);
		set job_gen,77;
		getitem 5752,1; //Midas_Whisper
		getitem 2795,1; //Green_Apple_Ring
		next;
		mes "[德弗里斯]";
		mes "正如公会信中所说，我也期待你精彩的活动。";
		mes "一起努力，成为最优秀的基因研究者！";
		close;
	} else if (job_gen == 77) {
		mes "[德弗里斯]";
		mes "波波，你想加入我的爱奥尔良俱乐部吗？这是一个喜欢饼干的俱乐部。当然，我们不会想对查尔斯·奥尔良做奇怪的事。";
		close;
	}
	mes "[德弗里斯]";
	mes "我对你来说那么漂亮吗？为什么那样盯着我？";
	close;
}

job3_gen01,83,72,3	script	Delivery Box#generic	111,{
	mes "- 这里有一个大箱子。 -";
	if (job_gen == 2) {
		next;
		switch(select("打开箱子。:查看地址。:什么都不做。")) {
		case 1:
			mes "- 箱子里有几袋精心包装的饼干。 -";
			next;
			switch(select("取出一袋饼干。:什么都不做。")) {
			case 1:
				mes "- 你从箱子里取出了一袋饼干。 -";
				set job_gen,3;
				close;
			case 2:
				mes "你什么也没做。";
				close;
			}
		case 2:
			mes "[寄件人：卢恩·米德加尔特王国，普隆德拉，查尔斯·奥尔良]";
			mes "[收件人：施瓦茨瓦尔德共和国，丽赫乐森，德弗里斯]";
			close;
		case 3:
			mes "你什么也没做。";
			close;
		}
	}
	close;
}

job3_gen01,12,56,3	script	Plant Guide#generic	111,{
	mes "<世界上最简单的炼金术>";
	mes "作者：鲍勃·罗斯。";
	next;
	switch(select("动物:植物:矿物:其他")) {
	case 1:
		mes "……使用动物进行炼金，任何人都能轻松练习。";
		mes "你可以把想使用的动物放在白色托盘上，想象想要制作的东西，然后练习炼金术。";
		mes "非常简单。";
		next;
		mes "……用于炼金的动物可能会因被不计后果的炼金术士捕捉而濒临灭绝。";
		mes "所以我就不提它们了。";
		close;
	case 2:
		mes "……使用植物炼金的指南很容易遵循，即使小孩子也能做到。";
		mes "你可以把植物放在桌上，将它们打碎或切开，用简单工具连接起来，然后进行炼金。";
		mes "那真是非凡的方法。";
		next;
		mes "……常用于炼金的植物有比比草、外部长满尖刺但内部柔软的穆卡树，以及生长速度很快却寄生于生物的博奇藤。";
		if (job_gen == 6)
			set job_gen,7;
		close;
	case 3:
		mes "……使用矿物进行炼金，是初学者觉得相当容易的方法。";
		mes "你可以把想要的矿物放进精美的盒子，随意哼唱一首歌两遍，然后练习炼金术。";
		mes "那真是简单的方法。";
		next;
		mes "……普拉康是炼金术中常用的矿物，价格也不高。";
		close;
	case 4:
		mes "……炼金术是世界上最简单的事。";
		mes "这位作者每周都会在学生面前展示钴蓝色炼金术，总能得到他们热烈的掌声。";
		mes "我相信你读完这本书的那一刻，就会爱上炼金术的世界。";
		close;
	}
}

// QuestID,PlantName,Description{,Part?}
function	script	Genetic_Job_Plant	{
	if (job_gen == 7) {
		if (isbegin_quest(getarg(0)) == 0) {
			mes "- "+getarg(2)+" -";
			next;
			switch(select("把它用作材料。:不用。")) {
			case 1:
				if (getarg(3,0)) set .@str$,"some of the ";
				mes "- 你获得了"+.@str$+getarg(1)+"。 -";
				setquest getarg(0);
				close;
			case 2:
				mes "- 这种植物看起来不适合作为实验样本。 -";
				close;
			}
		}
		mes "- 你已经获得过"+getarg(1)+"。 -";
		close;
	} else if (job_gen == 6) {
		mes "与这种植物相关的信息，可以在柜子里的植物指南中找到。";
		close;
	}
	mes "- "+getarg(2)+" -";
	close;
}


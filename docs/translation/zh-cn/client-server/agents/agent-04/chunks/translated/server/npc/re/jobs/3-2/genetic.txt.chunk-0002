job3_gen01,91,48,3	script	Demi Calberine#gen	982,{
	mes "[德米·卡尔贝琳]";
	if (job_gen < 62) {
		mes "嗯~ 那颗螺栓去哪儿了？";
		close;
	} else if (job_gen == 62) {
		mes "哦，那辆蓝色手推车~";
		mes "装上画一样的火炮~";
		mes "和我可爱的宝贝一起~";
		mes "想永远发射火炮~~";
		next;
		mes "[德米·卡尔贝琳]";
		mes "呃~ 螺栓去哪儿了？";
		mes "螺丝怎么不够？我不是最近才订购过新的吗？";
		next;
		select("你好~？");
		mes "[德米·卡尔贝琳]";
		mes "哦，天哪~？";
		mes "你什么时候……你是谁？";
		next;
		mes "[德米·卡尔贝琳]";
		mes "天啊！";
		mes "嘿！请帮帮我！";
		next;
		mes "[德米·卡尔贝琳]";
		mes "我今天必须完成订购的迷你火炮，但找不到零件！";
		next;
		mes "[德米·卡尔贝琳]";
		mes "呃~ 我想它们应该掉在这附近。";
		mes "我只需要 10 个！得先把其他零件组装起来……你能帮帮我吗？！";
		changequest 2216,2217;
		set job_gen,63;
		close;
	} else if (job_gen > 62 && job_gen < 74) {
		mes "啊，糟糕，糟糕~~~";
		mes "你找到零件了吗？还没有？你答应过的，请快一点！";
		close;
	} else if (job_gen == 74) {
		mes "用这辆手推车火力不够，那就这样安装吧……";
		next;
		select("我拿到零件了。");
		mes "[德米·卡尔贝琳]";
		mes "哦，天哪！";
		mes "你吓死我了！！";
		mes "哦，这些是我丢失的螺丝和螺栓吗？";
		mes "你在哪里找到的？";
		next;
		select("是你让我找的！");
		mes "[德米·卡尔贝琳]";
		mes "哦？真的吗？";
		mes "我让你找的吗？呵呵呵呵呵。";
		mes "我甚至不知道自己在想什么。";
		next;
		mes "[德米·卡尔贝琳]";
		mes "请稍等。";
		mes "我很快就能用这些完成。";
		next;
		mes "- 咔嚓 咔嚓 咔嚓 -";
		next;
		mes "[德米·卡尔贝琳]";
		mes "好了，我把火炮接到手推车上了……现在测试一下性能吧？";
		next;
		mes "- 嘶嘶…… -";
		next;
		mes "- 砰！砰！砰！砰！ -";
		next;
		mes "[德米·卡尔贝琳]";
		mes "太棒了！成功！";
		mes "呼。你帮了我大忙。";
		mes "非常感谢。";
		next;
		mes "[德米·卡尔贝琳]";
		mes "对了，你为什么来这里？";
		mes "你是来订购什么东西的吗？";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "我是基因研究者申请人。";
		mes "我听说你很了解便携式迷你火炮之类的东西。";
		next;
		mes "[德米·卡尔贝琳]";
		mes "没错，我处理各种各样的火炮。";
		mes "现在有人想改装手推车，所以我一直在为他们的手推车安装迷你火炮等附加功能。";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "手推车改装？";
		next;
		mes "[德米·卡尔贝琳]";
		mes "没错，你下坡时难道不想冲出去吗？";
		mes "你难道没觉得拖着那辆普通的旧手推车很无聊吗？";
		next;
		mes "[德米·卡尔贝琳]";
		mes "手推车不再只是用来储物的车。";
		mes "你可以在手推车上装一门火炮，让它帮助你提升攻击力。";
		next;
		mes "[德米·卡尔贝琳]";
		mes "德弗里斯小姐似乎正在楼下研究幼稚的实验。";
		mes "我不明白那些研究论文为什么这么受欢迎。";
		emotion ET_HNG;
		next;
		mes "[德米·卡尔贝琳]";
		mes "看看这门迷你小火炮。";
		mes "这是世界上最小、最轻的火炮。";
		mes "这是我做的，是不是很可爱？耶~";
		emotion ET_COOL;
		next;
		select("可以改装我的手推车吗？");
		mes "[德米·卡尔贝琳]";
		mes "很遗憾，只有基因研究者才能改装手推车。";
		mes "这是炼金术士公会的规定，我也没办法。";
		next;
		mes "[德米·卡尔贝琳]";
		mes "但别失望。";
		mes "你也可以成为基因研究者！";
		mes "呵呵呵。";
		next;
		mes "[德米·卡尔贝琳]";
		mes "而且，手推车改装也不是随便哪辆车都能做。";
		mes "只能改装经过长期打磨、通过质量认证的手推车。";
		next;
		mes "[德米·卡尔贝琳]";
		mes "在成为基因研究者之前，只要有时间就应该练习手推车技巧。";
		mes "直到你的肌肉能与手推车强力协调，让它移动得优美，";
		next;
		mes "[德米·卡尔贝琳]";
		mes "如果你愿意，^FF0000我可以告诉你一个很好的训练地点。^000000";
		mes "^FF0000德弗里斯不会太喜欢那里^000000，但那是最好的地方。哈哈。";
		next;
		mes "[德米·卡尔贝琳]";
		mes "练习一下挥动你的手推车怎么样？";
		mes "至少挥动手推车^FF0000100^000000次，就能消除压力，也能把手推车打磨得足够好。";
		next;
		mes "[德米·卡尔贝琳]";
		mes "好了，我得为下一份订单工作了。";
		mes "需要训练时随时来找我。";
		mes "需要改装手推车时，我会帮助你。";
		next;
		mes "- 咔啦 -";
		next;
		mes "- 这是什么？我感觉地板好像少了一块。 -";
		set job_gen,75;
		changequest 2217,2223;
		close2;
		warp "job3_gen01",23,32;
		end;
	} else if (job_gen == 75) {
		if (checkquest(2223,HUNTING) == 2) {
			mes "看来德弗里斯小姐发现我把你放进她的孢子围栏了。";
			mes "你杀掉那些孢子后，再看看她的表情，一定很有趣。";
			close;
		}
		mes "唉，你还没练习完吗？";
		mes "你想进入孢子围栏吗？";
		next;
		switch(select("是。:否。")) {
		case 1:
			mes "[德米·卡尔贝琳]";
			mes "尽情挥动你的手推车吧~";
			close2;
			warp "job3_gen01",23,32;
			end;
		case 2:
			mes "[德米·卡尔贝琳]";
			mes "真遗憾！我本想看看德弗里斯小姐生气的脸。";
			close;
		}
	} else if (job_gen > 75) {
		mes "看来德弗里斯小姐发现我把你放进她的孢子围栏了。";
		mes "你杀掉那些孢子后，再看看她的表情，一定很有趣。";
		close;
	}
}

-	script	Scattered Stuff#gen	-1,{
	if (job_gen > 62 && job_gen < 74) {
		mes "- 地板上散落着很多东西，实验室一片混乱。 -";
		next;
		mes "- 你找到了一小块金属碎片。 -";
		set job_gen, job_gen+1;
		specialeffect EF_BASH;
		disablenpc();
		initnpctimer;
		close;
	} else if (job_gen == 74) {
		mes "- 我想零件都收集齐了。 -";
		close;
	}
	end;
OnTimer7000:
	enablenpc();
	stopnpctimer;
	end;
}

	} else if (job_novice_q == 5) {
		if (getskilllv("NV_FIRSTAID") > 0) {
			mes "[Jinha]";
			mes "你好！";
			mes "我负责教你[急救]技能。";
			mes "Brade 教官让你学习它，对吧？";
			next;
			mes "[Jinha]";
			mes "哇……太棒了！";
			mes "你已经知道急救技能。";
			mes "看来没什么可教你的。";
			next;
			mes "[Jinha]";
			mes "很好。你的教官是之前管理方的 Cecil 吗？";
			mes "你已经学会急救，我可以确认。";
			next;
			mes "[Jinha]";
			mes "那么，你可以直接进入课程的下一步。";
			mes "回到 Brade 教官那里。";
			set job_novice_q,6;
			close;
		} else {
			mes "[Jinha]";
			mes "你好！";
			mes "我能帮你什么？";
			next;
			select("我想学习使用[急救]技能。");
			mes "[Jinha]";
			mes "没错。";
			mes "急救是在危险时将 SP 转换为 HP 的技能。";
			next;
			mes "[Jinha]";
			mes "恢复量很少。";
			mes "但它能防止你被致命一击击晕。";
			specialeffect2 EF_BEGINSPELL6;
			specialeffect2 EF_SPELLBREAKER;
			next;
			mes "[Jinha]";
			mes "你可以点击基本窗口中的^4d4dff技能^000000按钮打开技能窗口。";
			mes "快捷键是^4d4dffALT + S^000000。";
			mes "要试试技能吗？";
			skill "NV_FIRSTAID",1,SKILL_PERM;
			set skill_nov,3; // Has future uses - do not remove! [Euphy]
			set job_novice_q,6;
			next;
			mes "[Jinha]";
			mes "很好，现在你知道如何使用急救技能了，接下来要进入下一步。";
			mes "回到 Brade 教官那里，向他展示你在这里学到的东西。";
			close;
		}
	} else if (job_novice_q == 6) {
		mes "[Jinha]";
		mes "你不是已经学过急救技能了吗？";
		mes "让 Brade 教官确认一下。";
		mes "如果不知道怎么去，我可以送你过去。";
		next;
		switch(select("我自己没问题。:请把我送到他那里。")) {
		case 1:
			mes "[Jinha]";
			mes "非常好！";
			mes "这才是正确的态度！";
			mes "你将来会成为伟大的冒险者。";
			close;
		case 2:
			mes "[Jinha]";
			mes "我会把你送到 Brade 教官那里。";
			close2;
			warp strnpcinfo(4),100,100;
			end;
		}
	} else {
		mes "[Jinha]";
		mes "我能为你做什么？";
		mes "下一节课程将在西室继续。";
		mes "继续前往西室。";
		close;
	}
}
new_1-2,115,120,3	duplicate(NvJinha)	Jinha#nv1	59
new_2-2,115,120,3	duplicate(NvJinha)	Jinha#nv2	59
new_3-2,115,120,3	duplicate(NvJinha)	Jinha#nv3	59
new_4-2,115,120,3	duplicate(NvJinha)	Jinha#nv4	59
new_5-2,115,120,3	duplicate(NvJinha)	Jinha#nv5	59

// People/Services in Ragnarok
//============================================================
-	script	Chocolat#newbe06::NvChocolat	-1,{
	if (job_novice_q < 7) {
		mes "[Chocolat]";
		mes "嗯？奇怪。";
		mes "让我看看你的训练生证件。";
		next;
		if (job_novice_q < 2) {
			mes "[Chocolat]";
			mes "哦，真的吗……";
			mes "你参加过之前的训练场课程。";
			mes "训练场现在由新管理方负责。";
			next;
			mes "[Chocolat]";
			mes "如果想参加基础课程，";
			mes "应该回去找 Brade 教官。";
			next;
			mes "[Chocolat]";
			mes "或者你也可以直接开始理论训练。";
			mes "你想做什么？";
			next;
			switch(select("送我去基础训练。:开始理论训练。")) {
			case 1:
				mes "[Chocolat]";
				mes "好的。";
				mes "我会送你去 Brade 教官那里。";
				mes "Brade 教官会开始你的基础训练。";
				close2;
				warp strnpcinfo(4),100,100;
				end;
			case 2:
				mes "[Chocolat]";
				mes "我会告诉你在城镇会遇到的人。";
				mes "城镇里有各种各样的人，了解其中一些会很有帮助。";
				next;
				mes "[Chocolat]";
				mes "城镇里有很多人，但其中这些人最值得了解。";
				next;
				mes "[Chocolat]";
				mes "他们是站在我身后的[卡普拉]员工，以及他们的竞争公司[酷暑企业]。";
				mes "第一次来到城镇时，你应该和信息[向导]交谈。";
				next;
				mes "[Chocolat]";
				mes "那么，就听听他们各自的介绍吧。";
				mes "先和[卡普拉]员工交谈。";
				set job_novice_q,8;
				setquest 7121;
				next;
				mes "^4d4dff- 你收到了巧克力的任务。";
				mes "请查看任务信息窗口。-^000000";
				close;
			}
		} else {
			mes "[Chocolat]";
			mes "你还在进行基础课程。";
			mes "应该回去找 Brade 教官或 Jinha。";
			next;
			mes "[Chocolat]";
			mes "如果不知道怎么找他们，我可以送你去 Brade 教官那里。怎么样？";
			next;
			switch(select("我自己去。:你能替我送去吗？")) {
			case 1:
				mes "[Chocolat]";
				mes "好的。从右侧的门出去。";
				close;
			case 2:
				mes "[Chocolat]";
				mes "好的。";
				mes "回头见。";
				close2;
				warp strnpcinfo(4),100,100;
				end;
			}
		}
	} else if (job_novice_q == 7) {
		mes "[Chocolat]";
		mes "我会告诉你在城镇会遇到的人。";
		mes "城镇里有各种各样的人，了解其中一些会很有帮助。";
		next;
		mes "[Chocolat]";
		mes "城镇里有很多人，但其中这些人最值得了解。";
		next;
		mes "[Chocolat]";
		mes "他们是站在我身后的[卡普拉]员工，以及他们的竞争公司[酷暑企业]。";
		mes "第一次来到城镇时，你应该和信息[向导]交谈。";
		next;
		mes "[Chocolat]";
		mes "那么，就听听他们各自的介绍吧。";
		mes "先和[卡普拉]员工交谈。";
		set job_novice_q,8;
		setquest 7121;
		close;
	} else if (job_novice_q == 8) {
		mes "[Chocolat]";
		mes "来，和站在我身后的这些人谈谈。";
		mes "先从我身后的[卡普拉]员工开始。";
		close;
	} else if (job_novice_q == 9) {
		mes "[Chocolat]";
		mes "你已经了解很多卡普拉服务了吧？";
		mes "从现在起，你可以使用卡普拉服务。";
		next;
		mes "[Chocolat]";
		mes "训练期间，如果想直接去城镇，可以使用卡普拉服务。";
		mes "不过一旦离开训练中心，就再也回不来了。";
		next;
		mes "[Chocolat]";
		mes "接下来是卡普拉的竞争对手——[酷暑企业]员工！";
		mes "[酷暑企业]员工专门负责活动。";
		mes "那么，你为什么不亲自和他谈谈？";
		close;
	} else if (job_novice_q == 10) {
		mes "[Chocolat]";
		mes "在[卡普拉]和[酷暑企业]之后，是信息[向导]。";
		mes "他们看似不起眼，但关键时刻能帮你大忙。";
		next;
		mes "[Chocolat]";
		mes "我把普隆德拉城的信息向导带来了。";
		mes "问问他在城镇里具体做什么。";
		close;
	} else if (job_novice_q == 11) {
		mes "[Chocolat]";
		mes "信息[向导]的说明怎么样？";
		mes "最后是关于使用[旅馆]。";
		mes "每个城镇都有旅馆。";
		next;
		mes "[Chocolat]";
		mes "支付少量费用即可在旅馆或酒店休息。";
		mes "在那里休息可以完全恢复 HP 和 SP。";
		mes "用一下也不会吃亏，对吧？";
		next;
		mes "[Chocolat]";
		mes "除了这些人，还有许多商人出售各种物品，去看看吧。";
		set job_novice_q,12;
		completequest 7121;
		getexp 1800,20;
		getitem 7059,20; //Cargo_Free_Ticket
		getitem 7060,30; //Warp_Free_Ticket
		next;
		mes "[Chocolat]";
		mes "你完成了我交给你的所有任务。";
		mes "作为奖励，我会给你卡普拉仓库和传送服务的免费券。";
		mes "它们会派上用场。";
		next;
		mes "[Chocolat]";
		mes "我的任务就到这里。";
		mes "现在是实战时间！";
		next;
		mes "[Chocolat]";
		mes "实战训练由 Brade 教官负责，你之前见过他。";
		mes "我会送你去实战训练场。";
		close2;
		set .@map$, "new_"+charat(strnpcinfo(4),4)+"-3";
		savepoint .@map$,96,21,1,1;
		warp .@map$,96,21;
		end;
	} else {
		mes "[Chocolat]";
		mes "迷路了吗？";
		next;
		switch(select("不，我只是看看:是的，请送我去战斗训练场")) {
		case 1:
			mes "[Chocolat]";
			mes "好，需要我重新指路时";
			mes "再回来找我。";
			close;
		case 2:
			mes "[Chocolat]";
			mes "我会送你去实战训练场。";
			close2;
			set .@map$, "new_"+charat(strnpcinfo(4),4)+"-3";
			savepoint .@map$,96,21,1,1;
			warp .@map$,96,21;
			end;
		}
	}
}
new_1-2,33,172,4	duplicate(NvChocolat)	Chocolat#nv1	96
new_2-2,33,172,4	duplicate(NvChocolat)	Chocolat#nv2	96
new_3-2,33,172,4	duplicate(NvChocolat)	Chocolat#nv3	96
new_4-2,33,172,4	duplicate(NvChocolat)	Chocolat#nv4	96
new_5-2,33,172,4	duplicate(NvChocolat)	Chocolat#nv5	96

-	script	Kafra Employee#newbe07::NvKafra	-1,{
	if (job_novice_q < 8) {
		mes "[Kafra Employee]";
		mes "你好。";
		mes "我想还没轮到我。";
		mes "请先和‘巧克力’谈谈。";
		close;
	} else if (job_novice_q == 8) {
		mes "[Kafra Employee]";
		mes "你好。";
		mes "我受卡普拉总部派遣来帮助训练生。";
		mes "卡普拉公司是米德加尔特大陆历史悠久、规模最大的公司。";
		mes "对你们冒险者来说，与我们保持联系很重要。";
		next;
		mes "[Kafra Employee]";
		mes "我来介绍你最常使用的卡普拉服务：[保存]、[仓库]和[传送]服务。";
		next;
		mes "[Kafra Employee]";
		mes "和卡普拉员工交谈并请求保存服务后，";
		mes "你在战斗中被击败后的复活地点就会改变。";
		next;
		mes "[Kafra Employee]";
		mes "你的复活点永远是最后保存的位置。使用蝴蝶翅膀会回到上次保存的地方。";
		mes "这项服务免费，随时都可以使用保存服务。";
		next;
		callsub L_Services,2; //Storage
		next;
		callsub L_Services,3; //Teleport
		set job_novice_q,9;
		next;
		mes "[Kafra Employee]";
		mes "想听其他说明吗？";
		next;
		while(1) {
			set .@select, select("关于保存:关于仓库:关于传送:关于手推车:不用了。 ");
			if (.@select == 5) {
				mes "[Kafra Employee]";
				mes "希望我的说明令你满意。";
				mes "以上就是卡普拉服务。";
				close;
			}
			callsub L_Services, .@select;
			next;
		}
	} else {
		mes "[Kafra Employee]";
		mes "Kafra Service at your service.";
		mes "我能为你做什么？";
		next;
		mes "[Kafra Employee]";
		mes "使用传送服务前，我先提醒你。";
		mes "如果传送到村庄，";
		mes "^4d4dff你永远无法回到初心者训练场。^000000";
		mes "请记住这一点。";
		next;
		switch(select("传送服务:关于卡普拉服务")) {
		case 1:
			mes "[Kafra Employee]";
			mes "那么，你要直接去城镇。";
			mes "我先简单介绍一下。";
			mes "^4d4dff普隆德拉是卢恩·米德加尔特王国的首都，旁边就是伊兹鲁德。^000000";
			next;
			mes "[Kafra Employee]";
			mes "^4d4dff梦罗克是沙漠城市，你可以在那里转职为盗贼或刺客。^000000";
			mes "^4d4dff斐扬是山中村落，靠近弓箭手村。^000000";
			mes "^4d4dff吉芬是魔法之城。想成为魔法师就去那里。^000000";
			next;
			mes "[Kafra Employee]";
			mes "^4d4dff艾尔帕兰是港口城市，商人公会就在那里。^000000";
			mes "如果想乘船去某处，也必须先经过艾尔帕兰。";
			mes "请选择想传送到的城镇。";
			next;
			switch(select("普隆德拉:梦罗克:斐扬:艾尔帕兰:吉芬")) {
			case 1:
				mes "[Kafra Employee]";
				mes "卢恩·米德加尔特的首都，普隆德拉。";
				mes "我会送你去普隆德拉。";
				mes "愿芙蕾雅祝福你的旅程。";
				callfunc "F_NvErase";
				close2;
				savepoint "prontera",117,72,1,1;
				warp "prontera",150,50;
				end;
			case 2:
				mes "[Kafra Employee]";
				mes "沙漠城市，梦罗克……";
				mes "它已经失去了昔日的荣耀……";
				mes "此刻不要失去心中的梦想。";
				callfunc "F_NvErase";
				close2;
				savepoint "morocc",150,99,1,1;
				warp "morocc",155,110;
				end;
			case 3:
				mes "[Kafra Employee]";
				mes "嗯，你想成为弓箭手？";
				mes "我们去斐扬吧。";
				mes "愿芙蕾雅祝福你。";
				callfunc "F_NvErase";
				close2;
				savepoint "payon",70,100,1,1;
				warp "payon",166,67;
				end;
			case 4:
				mes "[Kafra Employee]";
				mes "港口城市，艾尔帕兰。";
				mes "米德加尔特大陆所有贸易的中心城市。";
				mes "想体验其他文明，就必须先访问艾尔帕兰。";
				callfunc "F_NvErase";
				close2;
				savepoint "alberta",30,232,1,1;
				warp "alberta",114,58;
				end;
			case 5:
				mes "[Kafra Employee]";
				mes "魔法之城！";
				mes "吉芬塔矗立在吉芬城中央，景色很美。";
				mes "我会把你送到吉芬喷泉附近。";
				mes "愿芙蕾雅女神祝福你！";
				callfunc "F_NvErase";
				close2;
				savepoint "geffen",119,37,1,1;
				warp "geffen",122,65;
				end;
			}
		case 2:
			mes "[Kafra Employee]";
			mes "我来介绍卡普拉服务。";
			mes "你想了解哪项服务";
			mes "？";
			next;
			while(1) {
				set .@select, select("关于保存:关于仓库:关于传送:关于手推车:不用了。");
				if (.@select == 5) {
					mes "[Kafra Employee]";
					mes "希望我的说明令你满意。";
					mes "以上就是卡普拉服务。";
					close;
				}
				callsub L_Services, .@select;
				next;
			}
		}
	}
	end;

L_Services:
	switch(getarg(0)) {
	case 1:
		mes "[Kafra Employee]";
		mes "在战斗中被击败时，";
		mes "你可以在使用这项服务保存的位置复活。";
		mes "如果在各村庄的卡普拉处保存，";
		mes "就可以在保存过的村庄复活。";
		next;
		mes "[Kafra Employee]";
		mes "保存位置永远是你最后保存的地方，";
		mes "使用蝴蝶翅膀，";
		mes "可以直接传送到保存点。";
		mes "请放心使用这项服务。";
		break;
	case 2:
		mes "[Kafra Employee]";
		mes "接下来介绍仓库服务。";
		mes "你可以在任何城镇方便地存取物品。";
		next;
		mes "[Kafra Employee]";
		mes "不需要立即使用的物品没必要全部带在身上。";
		mes "请使用我们的仓库，安全保管物品。";
		next;
		mes "[Kafra Employee]";
		mes "我们方便的仓库服务";
		mes "会向顾客收取少量费用，各城镇的费用有所不同。";
		mes "不过，你必须";
		mes "至少达到^3355FF基础技能等级 6^000000";
		mes "才能使用仓库。";
		next;
		mes "[Kafra Employee]";
		//mes "There are 3 different item sections of the Storage into which items are organized: Consumable, Equipment and Etc.";
		mes "仓库分为 7 个物品分类：消耗品、卡普拉（道具商城）、防具、武器、弹药、卡片和其他。";
		next;

		// VIP System messages.
		if (MIN_STORAGE != MAX_STORAGE) {
			mes "[Kafra Employee]";
			mes "卡普拉仓库最多有 "+MIN_STORAGE+" 个物品栏位，也就是最多存放 "+MIN_STORAGE+" 种不同物品。";
			next;
			mes "[Kafra Employee]";
			mes "如果拥有高级订阅，卡普拉仓库最多有 "+MAX_STORAGE+" 个物品栏位！";
			mes "不过请注意，装备类物品每件占用一个栏位。";
			mes "卡普拉仓库最多可存放 30,000 件物品。";
			next;
		} else {
			mes "[Kafra Employee]";
			mes "卡普拉仓库最多有 "+MAX_STORAGE+" 个物品栏位，也就是最多存放 "+MAX_STORAGE+" 种不同物品。";
			next;
		}

		mes "[Kafra Employee]";
		mes "同一账号的所有角色共享这个仓库。";
		mes "各城镇的仓库费用可能不同。";
		mes "使用仓库服务时请记住这一点。";
		break;
	case 3:
		mes "[Kafra Employee]";
		mes "我们还提供传送服务，让长途移动更加方便。";
		next;
		mes "[Kafra Employee]";
		mes "凭借资深传送师的技能，";
		mes "你的旅途会更安全、更舒适。";
		mes "另外请记住，每个城镇可传送到的地点都不同。";
		next;
		mes "[Kafra Employee]";
		mes "为了永远支持你，";
		mes "我们一直努力工作，";
		mes "偿还顾客对我们的信任。";
		break;
	case 4:
		mes "[Kafra Employee]";
		mes "卡普拉公司提供手推车租赁服务";
		mes "服务对象是从事商业活动的顾客。";
		mes "最初，这项手推车租赁服务仅由";

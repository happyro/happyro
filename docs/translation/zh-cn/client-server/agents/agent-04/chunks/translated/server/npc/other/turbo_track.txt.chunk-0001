-	script	Master#tt_main	-1,{
	function	RName;
OnEnable:
	set .@w$,callfunc("F_tt");
	enablenpc "Master#"+.@w$;
	initnpctimer;
	end;

OnDisable:
	set .@w$,callfunc("F_tt");
	stopnpctimer;
	disablenpc "Master#"+.@w$;
	end;

OnTimer7000:
	mapannounce strnpcinfo(4),"欢迎来到极速赛。",bc_map,"0x33FF66";
	end;

OnTimer9000:
	mapannounce strnpcinfo(4),"比赛将持续 15 分钟，至少要有一人完成全程。",bc_map,"0x33FF66";
	end;

OnTimer11000:
	mapannounce strnpcinfo(4),"希望你全力以赴。",bc_map,"0x33FF66";
	end;

OnTimer13000:
	mapannounce strnpcinfo(4),"5 秒倒计时后比赛开始。请大家在起点线后就位。",bc_map,"0x33FF66";
	end;

OnTimer15000:
	mapannounce strnpcinfo(4),"倒计时即将开始。",bc_map,"0x33FF66";
	end;

OnTimer17000:
	mapannounce strnpcinfo(4),"- 5 -",bc_map,"0x33FF66";
	end;

OnTimer18000:
	mapannounce strnpcinfo(4),"- 4 -",bc_map,"0x33FF66";
	end;

OnTimer19000:
	mapannounce strnpcinfo(4),"- 3 -",bc_map,"0x33FF66";
	end;

OnTimer20000:
	mapannounce strnpcinfo(4),"- 2 -",bc_map,"0x33FF66";
	end;

OnTimer21000:
	mapannounce strnpcinfo(4),"- 1 -",bc_map,"0x33FF66";
	end;

OnTimer22000:
	mapannounce strnpcinfo(4),"- 0 -",bc_map,"0x33FF66";
	end;

OnTimer23000:
	set .@w$,callfunc("F_tt");
	mapannounce strnpcinfo(4),"现在！比赛开始！冲冲冲！！",bc_map,"0x33FF66";
	disablenpc "No_Unfair_Start#"+.@w$+"-1";
	disablenpc "No_Unfair_Start#"+.@w$+"-2";
	if (strnpcinfo(4) == "turbo_n_1") set $@start_time,gettimetick(0);
	end;

OnTimer30000:
	mapannounce strnpcinfo(4),"记住这是 15 分钟的比赛。15 分钟后所有人都会被传送离开赛道。",bc_map,"0x33FF66";
	end;

OnTimer83000:
	mapannounce strnpcinfo(4),"还剩 14 分钟。",bc_map,"0x33FF66";
	end;

OnTimer143000:
	mapannounce strnpcinfo(4),"还剩 13 分钟。",bc_map,"0x33FF66";
	end;

OnTimer203000:
	mapannounce strnpcinfo(4),"还剩 12 分钟。",bc_map,"0x33FF66";
	end;

OnTimer263000:
	mapannounce strnpcinfo(4),"还剩 11 分钟。",bc_map,"0x33FF66";
	end;

OnTimer323000:
	mapannounce strnpcinfo(4),"还剩 10 分钟。",bc_map,"0x33FF66";
	end;

OnTimer383000:
	mapannounce strnpcinfo(4),"还剩 9 分钟。",bc_map,"0x33FF66";
	end;

OnTimer443000:
	mapannounce strnpcinfo(4),"还剩 8 分钟。",bc_map,"0x33FF66";
	end;

OnTimer503000:
	mapannounce strnpcinfo(4),"还剩 7 分钟。",bc_map,"0x33FF66";
	end;

OnTimer563000:
	mapannounce strnpcinfo(4),"还剩 6 分钟。",bc_map,"0x33FF66";
	end;

OnTimer623000:
	mapannounce strnpcinfo(4),"还剩 5 分钟。",bc_map,"0x33FF66";
	end;

OnTimer683000:
	mapannounce strnpcinfo(4),"还剩 4 分钟。",bc_map,"0x33FF66";
	end;

OnTimer743000:
	mapannounce strnpcinfo(4),"还剩 3 分钟。",bc_map,"0x33FF66";
	end;

OnTimer803000:
	mapannounce strnpcinfo(4),"还剩 2 分钟。",bc_map,"0x33FF66";
	end;

OnTimer863000:
	mapannounce strnpcinfo(4),"还剩 1 minute left.",bc_map,"0x33FF66";
	end;

OnTimer893000:
	mapannounce strnpcinfo(4),"还剩 30 秒。",bc_map,"0x33FF66";
	end;

OnTimer903000:
	mapannounce strnpcinfo(4),"还剩 20 秒。",bc_map,"0x33FF66";
	end;

OnTimer913000:
	mapannounce strnpcinfo(4),"还剩 10 秒。",bc_map,"0x33FF66";
	end;

OnTimer918000:
	mapannounce strnpcinfo(4),"还剩 5 秒。",bc_map,"0x33FF66";
	end;

OnTimer919000:
	mapannounce strnpcinfo(4),"还剩 4 秒。",bc_map,"0x33FF66";
	end;

OnTimer920000:
	mapannounce strnpcinfo(4),"还剩 3 秒。",bc_map,"0x33FF66";
	end;

OnTimer921000:
	mapannounce strnpcinfo(4),"还剩 2 秒。",bc_map,"0x33FF66";
	end;

OnTimer922000:
	mapannounce strnpcinfo(4),"还剩 1 second left.",bc_map,"0x33FF66";
	end;

OnTimer923000:
	mapannounce strnpcinfo(4),"时间到！",bc_map,"0x33FF66";
	end;

OnTimer925000:
	mapannounce strnpcinfo(4),"比赛结束。",bc_map,"0x33FF66";
	end;

OnTimer927000:
	set .@w$,callfunc("F_tt");
	mapannounce strnpcinfo(4),"[所有人将被传送到等候室。]",bc_map,"0x33FF66";
	mapwarp strnpcinfo(4),"turbo_room",71,89;
	disablenpc "Broadcast#"+.@w$;
	donpcevent "Master#"+.@w$+"::OnDisable";
	if (strnpcinfo(4) == "turbo_n_1") {
		donpcevent "Solo Mode#n1::OnEnable";
	} else {
		donpcevent RName(.@w$)+"::OnEnable";
	}
	enablenpc "No_Unfair_Start#"+.@w$+"-1";
	enablenpc "No_Unfair_Start#"+.@w$+"-2";
	donpcevent "snake#"+.@w$+"::OnReset";
	donpcevent "hunting#"+.@w$+"::OnReset";
	disablenpc "bing2#"+.@w$;
	disablenpc "Winner Helper#TBT_"+.@w$;
	enablenpc "#cos_"+.@w$+"_end";
	enablenpc "Notice_Maker1#TBT_"+.@w$;
	enablenpc "Notice_Maker3#TBT_"+.@w$;
	enablenpc "Notice_Maker4#TBT_"+.@w$;
	enablenpc "Disposable_Switch#"+.@w$;
	disablenpc "Flasher_Exit_1#"+.@w$;
	disablenpc "Flasher_Exit_2#"+.@w$;
	end;
	
OnInit:
	set .@w$,callfunc("F_tt");
	disablenpc "Master#"+.@w$;
	end;
	
	function	RName	{
		.@string$ = getarg(0);
		.@s = ( getstrlen(.@string$) > 2 ? substr(.@string$,1,2) : charat(.@string$,getstrlen(.@string$)-1) );
		set .@rn$,((compare(strnpcinfo(4),"_e_"+.@s))?"Expert mode":"Normal mode")+" - "+.@s+" person";
		return .@rn$;
	}
}

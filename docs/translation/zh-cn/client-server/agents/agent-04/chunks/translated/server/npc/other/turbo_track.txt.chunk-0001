-	script	Broadcast#tt_main	-1,{
OnEnable:
	set .@w$,callfunc("F_tt");
	enablenpc "Broadcast#"+.@w$;
	initnpctimer;
	end;

OnTimer2000:
	mapannounce strnpcinfo(4),"你现在位于 Waiting Room where you can check your items and prepare for the race.",bc_map,"0x33FF66";
	end;

OnTimer7000:
	mapannounce strnpcinfo(4),"你将在 30 秒后被传送到起点线。",bc_map,"0x33FF66";
	end;

OnTimer10000:
	mapannounce strnpcinfo(4),"请确认你携带了合适的装备和物品。",bc_map,"0x33FF66";
	end;

OnTimer15000:
	mapannounce strnpcinfo(4),"30 秒倒计时即将开始。",bc_map,"0x33FF66";
	end;

OnTimer17000:
	mapannounce strnpcinfo(4),"30 秒剩余。",bc_map,"0x33FF66";
	end;

OnTimer27000:
	mapannounce strnpcinfo(4),"20 秒剩余。",bc_map,"0x33FF66";
	end;

OnTimer37000:
	mapannounce strnpcinfo(4),"10 秒剩余。",bc_map,"0x33FF66";
	end;

OnTimer42000:
	mapannounce strnpcinfo(4),"5 秒剩余。",bc_map,"0x33FF66";
	end;

OnTimer43000:
	mapannounce strnpcinfo(4),"4 秒剩余。",bc_map,"0x33FF66";
	end;

OnTimer44000:
	mapannounce strnpcinfo(4),"3 秒剩余。",bc_map,"0x33FF66";
	end;

OnTimer45000:
	mapannounce strnpcinfo(4),"2 秒剩余。",bc_map,"0x33FF66";
	end;

OnTimer46000:
	mapannounce strnpcinfo(4),"1 秒剩余。",bc_map,"0x33FF66";
	end;

OnTimer47000:
	mapannounce strnpcinfo(4),"你很快将被传送到起点线。",bc_map,"0x33FF66";
	end;

OnTimer49000:
	set .@w$,callfunc("F_tt");
	enablenpc "Point Give-Away Guy#"+.@w$;
	donpcevent "Master#"+.@w$+"::OnEnable";
	end;

OnTimer50000:
	set .@w$,callfunc("F_tt");
	donpcevent "snake#"+.@w$+"::OnEnable";
	donpcevent "hunting#"+.@w$+"::OnEnable";
	if (strnpcinfo(4) != "turbo_n_1") enablenpc "bing#"+.@w$;
	end;

OnTimer57000:
	set .@w$,callfunc("F_tt");
	disablenpc "Point Give-Away Guy#"+.@w$;
	end;

OnInit:
	set .@w$,callfunc("F_tt");
	disablenpc "Broadcast#"+.@w$;
	end;
}

turbo_e_4,298,167,3	script	Helper#tt_main	124,{
	mes "[助手]";
	mes "你现在位于";
	mes "等候室。30 秒后你将被";
	mes "引导至起点线，";
	mes "请利用这段时间准备";
	mes "物品";
	mes "和装备。谢谢。";
	close;
}

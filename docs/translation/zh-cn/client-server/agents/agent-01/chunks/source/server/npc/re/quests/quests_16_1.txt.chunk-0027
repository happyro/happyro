		mes "Thanks to your contribution, the position of the guild has been strengthened.";
		next;
		cutin "sc_vicente03.bmp",2;
		mes "[Vicente]";
		mes "I guess you will be the hero of the palace.";
		mes "I am glad to see you well.";
		close3;
	}
	cutin "sc_vicente01",2;
	mes "[Vicente]";
	mes "Hum... Did we meet at Criatura?";
	next;
	cutin "sc_vicente02",2;
	mes "[Vicente]";
	mes "I have dealt with too many people...";
	mes "Your face seemed familiar...";
	next;
	cutin "sc_vicente03",2;
	mes "[Vicente]";
	mes "Well whatever.";
	mes "Are you enjoying the banquet?";
	close3;
}


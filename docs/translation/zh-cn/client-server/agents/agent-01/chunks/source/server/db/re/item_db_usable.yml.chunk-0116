    Name: Invitation of Darkness
    Type: Usable
    Buy: 10
    Weight: 10
    Script: |
      .@rnd = rand(1,3);
      if (.@rnd == 1) {
         specialeffect2 EF_DEVIL;
         warp "niflheim",193,186;
      }
      else if (.@rnd == 2) {
         heal -500,-1000;
         sc_start SC_STUN,3000,0;
      }
      else {
         specialeffect2 EF_DEVIL;
         warp "niflheim",347,255;
      }

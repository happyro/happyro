services:
  database:
    image: ${MARIADB_IMAGE}
    container_name: happyro-mariadb
    environment:
      MARIADB_ROOT_PASSWORD: ${MARIADB_ROOT_PASSWORD}
      MARIADB_DATABASE: ${DB_MAIN_DATABASE}
      MARIADB_USER: ${DB_USER}
      MARIADB_PASSWORD: ${DB_PASSWORD}
      HAPPYRO_LOG_DATABASE: ${DB_LOG_DATABASE}
      HAPPYRO_INTERSERVER_USER: ${INTERSERVER_USER}
      HAPPYRO_INTERSERVER_PASSWORD: ${INTERSERVER_PASSWORD}
    command:
      - --character-set-server=utf8mb4
      - --collation-server=utf8mb4_unicode_ci
      - --skip-name-resolve
    ports:
      - ${DB_BIND_IP}:${DB_PORT}:3306
    volumes:
      - ${DB_DATA_DIR}:/var/lib/mysql
      - ${SERVER_SQL_DIR}:/opt/rathena/sql:ro
      - ./init/20-happyro-databases.sh:/docker-entrypoint-initdb.d/20-happyro-databases.sh:ro
    healthcheck:
      test: ["CMD-SHELL", "MYSQL_PWD=$$MARIADB_PASSWORD mariadb-admin ping --host=127.0.0.1 --user=$$MARIADB_USER --silent"]
      interval: 2s
      timeout: 5s
      retries: 60
    restart: unless-stopped

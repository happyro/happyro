
/* Overlay */
.overlay {
	position: absolute;
	display: none;
	white-space: nowrap;
	z-index: 900;
	height: 13px;
	padding: 5px;
	background: rgba(0, 0, 0, 0.7);
	color: white;
	text-shadow: 1px 1px black;
}

/* Detail view (right side) */
.detail-view {
	position: absolute;
	top: 0;
	right: 0px;
	width: 328px;
	height: 405px;
	overflow-y: auto;
	background-size: 100% 100%;
	padding-left: 12px;
	font-size: 10px;
}

.detail-view .d-title {
	font-weight: bold;
	color: #2e519c;
	height: 35px;
	line-height: 35px;
	align-items: center;
	display: flex;
}

.detail-view .d-stamp {
	position: absolute;
	top: 5px;
	right: 10px;
	width: 64px;
	height: 54px;
}

.detail-view .d-desc {
	color: #6699ff;
	height: 57px;
	width: 200px;
}

.detail-view .d-goals {
	padding-left: 10px;
	padding-top: 10px;
	height: 190px;
	color: #2e519c;
}

.detail-view .d-goal-item {
	margin-bottom: 4px;
}

.detail-view .d-goal-item::before {
	content: '◆';
	color: #2e519c;
	margin-right: 5px;
}

/* Reward Area */
.d-reward {
	display: flex;
	flex-direction: row;
	gap: 5px;
	width: 100%;
	height: 80px;
	margin-left: -10px;
	justify-content: center;
	align-items: center;
}

.d-rewards-slot {
	width: 62px;
	height: 62px;
	position: relative;
}

.d-reward-item {
	position: absolute;
	top: 19px;
	left: 19px;
	width: 24px;
	height: 24px;
	background-repeat: no-repeat;
	pointer-events: none;
}

.detail-view .d-claim-btn {
	position: absolute;
	bottom: 10px;
	left: 90px;
	width: 148px;
	height: 20px;
	text-align: center;
}

/* Scrollbar area */
.scrollbar {
	position: absolute;
	top: 0;
	right: 2px;
	width: 15px;
	height: 320px;
}

      .@v = readparam(bVit);
      .@l = readparam(bLuk);
      .@i = readparam(bInt);
      bonus bStr,3*(.@i/18);
      bonus bAgi,3*(.@l/18);
      bonus bVit,3*(.@d/18);
      bonus bInt,3*(.@s/18);
      bonus bDex,3*(.@v/18);
      bonus bLuk,3*(.@a/18);
      bonus bMaxHPrate,(.@d/18);
      bonus bFlee2,(.@a/18);
      bonus bVariableCastrate,-(.@v/18);
      bonus bDelayrate,-(.@i/18);
      bonus2 bIgnoreDefClassRate,Class_All,15*(.@l/18);
      bonus2 bIgnoreMdefRaceRate,RC_All,15*(.@s/18);

			type: '3D',
			spriteName: '\xb1\xbc\xb6\xd2\xbf\xac\xb1\xe2',

			duplicate: 10,
			timeBetweenDupli: 1000,

			duration: 10000,
			alphaMax: 0.8,
			fadeOut: true,
			fadeIn: false,

			poszStart: 0,
			poszEnd: 20,
			poszSmooth: false,

			posxStartRand: 0,
			posxEndRand: 3,
			posxSmooth: true,

			sizeStart: 70,
			sizeEnd: 300,
			sizeSmooth: true,

			angle: -90,
			toAngle: 0,
			rotate: true,
			rotateWithCamera: true,
			repeat: true,
			delayFrame: 100,

			param0_Func: function (e, v) {
				e.posxEnd = 0.5 + v * 0.01;
				e.size = e.size * (1 + Math.sin(v * 0.5) * 0.5);
			},

			param1_Func: function (e, v) {
				if (v < 5) {
					e.alpha = 1.0;
				}
				e.alpha = e.alpha * (0.9 + Math.random() * 0.1);
			}
		}
	],


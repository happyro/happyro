         else if (BaseClass == Job_Merchant || BaseClass == Job_Archer || BaseClass == Job_Gunslinger) {
            bonus bFlee,15;
            bonus bLongAtkRate,3;
         }
         else if (BaseClass == Job_Mage || BaseClass == Job_Acolyte || BaseClass == Job_Ninja || BaseJob == Job_Soul_Linker) {
            bonus bMatk,15;
            bonus bMaxSPrate,2;
            bonus bHealPower,3;

	width: 4px;
}

#CashShop #cart-list::-webkit-scrollbar-thumb {
	background-color: rgba(0, 0, 0, 0.2);
	border-radius: 4px;
}

#CashShop .panel-cart .panel-cart-footer .use-free-points {
	border: none;
	background: transparent;
	-moz-appearance: textfield;
	appearance: textfield;
	text-align: right;
	font-size: 9px;
	max-width: 45px;
}

#CashShop .panel-cart .panel-cart-footer .use-free-points::-webkit-outer-spin-button,
#CashShop .panel-cart .panel-cart-footer .use-free-points::-webkit-inner-spin-button {
	-webkit-appearance: none;
	margin: 0;
}

#CashShop .panel-cart .panel-cart-footer > table tr {
	height: 15px;
}

#CashShop .panel-cart .panel-cart-footer > table tr td.txt {
	width: 60%;
	text-align: left;
}

#CashShop .panel-cart .panel-cart-footer > table tr td.value {
	width: 40%;
	text-align: right;
}

#CashShop .panel-cart .panel-cart-footer .cart-footer-action {
	padding: 0px 10px;
}

#CashShop .panel-cart .panel-cart-footer .cart-footer-action button {
	width: 154px;
	height: 23px;
	margin-left: 5px;
	margin-top: 4px;
	border: none;
	background: transparent;
}

#CashShop .panel-cart .panel-cart-footer .cart-footer-action .total-price {
	width: 100%;
	color: #fff;
	height: 18px;
	margin-top: 4px;
	font-weight: bold;
	line-height: 25px;
	text-align: center;
}

#CashShop #cart-list .items .item .delete-item {
	position: absolute;
	width: 7px;
	height: 7px;
	top: 3px;
	right: 4px;
	background-size: cover;
}

#CashShop .item-desc-top {
	height: 20px;
}

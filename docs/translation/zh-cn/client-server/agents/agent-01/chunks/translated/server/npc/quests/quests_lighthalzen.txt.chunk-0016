		mes "这座政府大楼。";
		mes "感谢你的配合。";
		close2;
		nude;
		warp "yuno_pre",83,22;
		end;
	}
	else if(lhz_boss == 11 || lhz_boss == 12)
	{
		if(lhz_boss == 12) set @visit_pre,rand(1,10);
		if(@visit_pre == 7)
		{
			mes "[？？？？？]";
			mes "我明白了。";
			mes "那么……";
			next;
			mes "[？？？？？？？？]";
			mes "嗯……";
			mes "明白了……";
			mes "…………";
			next;
			enablenpc "A Fine Gentleman";
			next;
			mes "[？？？？？]";
			mes "………………";
			next;
			mes "[卫兵]";
			mes "啊，凯什纳尔先生。";
			mes "您要离开了吗？";
			next;
			mes "[凯什纳尔]";
			mes "是的，我也该离开了。";
			mes "啊，能请问";
			mes "这位";
			if(Sex == SEX_MALE) mes "年轻先生是？";
			else mes "漂亮小姐是？";
			next;
			mes "[卫兵]";
			mes "凯什纳尔先生，";
			mes "这位是"+strcharinfo(0)+"。";
			mes ""+strcharinfo(0)+"，请允许我";
			mes "为你介绍埃里丹·凯什纳尔。";
			next;
			mes "[凯什纳尔]";
			mes "很高兴认识你。";
			mes "那么，恕我失陪，";
			mes "我还有些事务要处理。";
			mes "祝你今天愉快~";
			next;
			mes "[卫兵]";
			mes "请慢走，";
			mes "凯什纳尔先生。";
			set lhz_boss,13;
			disablenpc "A Fine Gentleman";
			close;

		}
		mes "[卫兵]";
		mes "请稍等片刻。";
		mes "总统目前";
		mes "正在接见另一位客人。";
		mes "感谢你的耐心等待。";
		if(lhz_boss == 11) set lhz_boss,12;
		close;
	}
	else if(lhz_boss == 13)
	{
		mes "[卫兵]";
		mes "现在你可以进去";
		mes "与总统交谈了。";
		mes "并与总统";
		mes "谢谢你一直等到现在。";
		next;
		switch( select( "Thank you.","Who was that gentleman...?" ) )
		{
			case 1:
				if(Sex == SEX_MALE) mes "一位先生"+strcharinfo(0)+"";
				else
				{
					if(getpartnerid()) mes "一位夫人"+strcharinfo(0)+"";
					else mes "一位小姐"+strcharinfo(0)+"";
				}
				mes "已经到了，现在想见您。";
				next;
				mes "……";
				next;
				mes "[总统先生]";
				mes "哦，你来得真早！";
				mes "抱歉，请你";
				mes "再等一分钟好吗？";
				next;
				mes "[卫兵]";
				mes "是，先生。";
				mes "很抱歉，请你等到";
				mes "总统准备好之前";
				mes "总统准备好，可以吗？";
				close;

			case 2:
				mes "[卫兵]";
				mes "哦，凯什纳尔先生是";
				mes "雷根贝勒公司的政府谈判代表。";
				mes "他是政府谈判代表，";
				mes "他经常来拜访总统，";
				mes "讨论各种问题。";
				set lhz_boss,14;
				close;
		}
	}
	else
	{
		mes "[卫兵]";
		mes "你好。";
		mes "你可以进去";
		mes "见总统了。";
		close2;
		warp "yuno_pre",78,69;
		end;
	}
}

yuno_pre,96,69,2	script	A Fine Gentleman	4_M_SAGE_A,{

OnInit:
	disablenpc "A Fine Gentleman";
	end;
}

yuno_pre,69,79,4	script	Mr. President	4_M_PRESIDENT,{

	if(checkweight(7342,1) != 1)
	{
		mes "- 请稍等！ -";
		mes "- 你目前携带的物品 -";
		mes "- 太多了。 -";
		mes "- 请减轻负重 -";
		mes "- 后再试一次。 -";
		close;
	}
	cutin "lhz_karl.bmp",2;
	if(lhz_boss < 11)
	{
		mes "[卡尔]";
		mes "你是怎么进来的？";
		mes "请立即离开这里！";
		mes "卫兵……！";
		close2;
		cutin "",255;
		warp "yuno_pre",83,22;
	}
	else if(lhz_boss == 14)
	{
		mes "[卡尔]";
		mes "啊，欢迎~";
		mes "我知道你来这里";
		mes "一定遇到了不少麻烦。";
		mes "一路上一定很辛苦。";
		mes "终于见到你，";
		mes "我很高兴。";
		next;
		mes "[卡尔]";
		mes "我相信加尔斯坦已经告诉过你，";
		mes "“秘密之翼”成立的目的";
		mes "就是推翻邪恶的雷根贝勒公司。";
		mes "我们希望结束它的统治。";
		mes "现在，你一定有一些问题";
		mes "想问我……";
		next;
L_Mission:
		switch( select( "Secret Wing's Background","Rekenber's Purpose","Secret Wing's Goal","Details about my mission","I'm ready for my mission." ) )
		{
			case 1:
				mes "[卡尔]";
				mes "雷根贝勒长期以来";
				mes "一直没有受到制衡。";
				mes "它已经统治了很久。";
				mes "我国民众对其统治不满，";
				mes "但由于国家缺乏团结，";
				mes "人民什么也做不了。";
				next;
				mes "[卡尔]";
				mes "但有一天，有人联系了我，";
				mes "他们声称也和我一样";
				mes "反对雷根贝勒公司。";
				mes "他们与我的想法相同。";
				mes "后来我才知道，他们来自";
				mes "卡普拉公司。";
				next;
				mes "[卡尔]";
				mes "显然，他们正面临";
				mes "酷事件公司的激烈竞争，";
				mes "那是一场激烈的竞争。";
				mes "而这家公司实际上";
				mes "得到了雷根贝";
				mmes "勒公司的支持。";
				next;
				mes "[卡尔]";
				mes "我们决定集中资源，";
				mes "对付这个共同的敌人。";
				mes "我们将它视为共同的敌人。";
				mes "不久后，更多志同道合者";
				mes "加入了我们的事业，";
				mes "我们成立了“秘密之翼”。";
				next;
				mes "[卡尔]";
				mes "你也许应该知道，";
				mes "我们与卡普拉公";
				mmes "司的直接联系人";
				mes "是^FF0000第三保";
				mmes "安队^000000。哦，";
				mes "你还有其他问题吗？";
				next;
				goto L_Mission;

			case 2:
				mes "[卡尔]";
				mes "公司确实是为了赚钱而存在，";
				mes "但雷根贝勒公司";
				mes "远比普通公司邪恶。";
				mes "他们实际上想统治整";
				mmes "个米德加尔特大陆。";
				next;
				mes "[卡尔]";
				mes "事实上";
				mmes "，那家公司的董事长";
				mes "一直笼罩在神秘之中。";
				mes "虽然我是总统，";
				mes "但要给他传递一条消息，";
				mes "我都要经历重重困难。";
				next;
				mes "[卡尔]";
				mes "这令人沮丧，";
				mes "但我们确实不知道";
				mes "他们真正的目标和计划。";
				mes "现在，你还有";
				mmes "其他问题吗？";
				next;
				goto L_Mission;

			case 3:
				mes "[卡尔]";
				mes "“秘密之翼”唯一的目标";
				mes "就是摧毁雷根贝勒公司，";
				mes "让施瓦尔茨瓦德共和国";
				mes "摆脱他们的压迫。";
				next;
				mes "[卡尔]";
				mes "当然，我们知道";
				mes "这需要时间";
				mmes "和大量牺牲";
				mes "才能实现。现在，";
				mes "你还有其他问题吗？";
				next;
				goto L_Mission;

			case 4:
				mes "[卡尔]";
				mes "啊，关于你的";
				mmes "下一个任务。";
				mes "如果你没有其他问题，";
				mes "我可以告诉你";
				mes "一些任务详情。";
				mes "准备好后告诉我。";
				next;
				goto L_Mission;

			case 5:
				mes "[卡尔]";
				mes "很好，那么。";
				mes "你的任务不会太难，";
				mes "但非常紧急，";
				mes "所以你必须";
				mmes "尽快完成。";
				mes "明白了吗？";
				next;
				switch( select( "Wait, I have one more question!","Yes sir, Mr. President." ) )
				{
					case 1:
						mes "[卡尔]";
						mes "嗯？我以为你";
						mes "没有其他问题了。";
						mes "不过，我还是可以";
						mes "回答我能回";
						mmes "答的问题。";
						next;
						goto L_Mission;

					case 2:
						mes "[卡尔]";
						mes "很高兴听到你这么说。";
						mes "好，给我一点时间";
						mes "找出这份文件，";
						mes "然后我再说明任务。";
						set lhz_boss,15;
						close2;
						cutin "",255;
						end;
				}
		}
	}
	else if(lhz_boss == 15)
	{
		mes "[卡尔]";
		mes "现在，你必须先前往";
		mes "艾尔迪巴兰的卡普拉总部，";
		mes "并与名为^FF0000贝妮";
		mmes "丝^000000的人见面。";
		mes "她会告诉你下一个任务的全部内容。";
		next;
		mes "[卡尔]";
		mes "小心，不要随意提及";
		mes "“秘密之翼”或";
		mes "你与我们的合作，";
		mes "否则可能危及";
		mmes "我们的目标。";
		mes "快去，时间非常宝贵。";
		next;
		mes "[卡尔]";
		mes "啊，差点忘了，";
		mes "请在离开前替我把这份文件夹";
		mes "带给^FF0000赫丝·";
		mmes "奥尼尔女士^000000。";
		mes "非常感谢。";
		set lhz_boss,16;
		getitem 7342,1; //File01
		changequest 12018,12019;
		close2;
		cutin "",255;
		end;
	}
	else if(lhz_boss < 21)
	{
		mes "[卡尔]";
		mes "快去完成";
		mes "贝妮丝交给你的任务。";
		mes "她就在艾尔迪巴兰的";
		mes "卡普拉总部。";
		mes "这是非常紧急的";
		mmes "高优先级任务……";
		close2;
		cutin "",255;
		end;
	}
	else if(lhz_boss == 21)
	{
		if(!countitem(7343))
		{
			mes "[卡尔]";
			mes "嗯？我正等着你";
			mes "把重要文件带回来。";
			mes "请快一点";
			mmes "，我们整个组织";
			mes "都处于危险之中！";
			close2;
			cutin "",255;
			end;
		}
		mes "[卡尔]";
		mes "啊，你来了。";
		mes "干得好，我听说";
		mes "任务成功了。";
		mes "至少官方记录上是成功的。";
		mes "………………………………………";
		next;
		mes "[卡尔]";
		mes "可怜的、亲爱的";
		mes "贾吉亚。为什么是他？";
		mes "命运一定要如此残酷";
		mes "而无情吗";
		mmes "？我仍不敢相信他已经离开。";
		mes "就在上周，我们还……";
		next;
		mes "[卡尔]";
		mes "抱歉。你并不太了解他，";
		mes "但所有认识他";
		mmes "的人都爱戴他。";
		mes "我可以自豪地这么说。";
		mes "让、让我查";
		mmes "一下文件……";
		delitem 7343,1;
		set lhz_boss,22;
		close2;
		cutin "",255;
		end;
	}
	else if(lhz_boss == 22)
	{
		if(rand(1,5) == 3)
		{
			mes "[卡尔]";
			mes "嗯，我彻底审";
			mmes "阅了这份文件，";
			mes "发现其中有一些重要线索，";
			mes "但仍不足以成为";
			mes "真正打击雷根贝";
			mmes "勒的确凿证据。";
			next;
			mes "[卡尔]";
			mes "不过，根据这份文件，";
			mes "雷根贝勒有一名研究员";
			mes "名叫希诺卡斯";
			mmes "，突然失踪了。";
			mes "显然，他知";
			mmes "道某种秘密。";
			next;
			mes "[卡尔]";
			mes "幸运的是";
			mmes "，我的手下报告说";
			mes "在艾音布罗克某处发现了";
			mes "希诺卡斯的踪迹。";
			mes "他肯定就在那里。";
			mes "但他究竟在隐藏什么？";
			next;
			mes "[卡尔]";
			mes "如果想对雷根贝";
			mmes "勒造成持久打击，";
			mes "我们就必须了解他的秘密。";
			mes "你的下一个任务";
			mmes "是找到希诺卡斯。";
			mes "祝你好运。";
			next;
			mes "[卡尔]";
			mes "请务必快一点。";
			mes "我不希望敌人在我";
			mmes "们让希诺卡斯开口前";
			mes "先找到他。";
			changequest 12022,12023;
			if(Shinokas_Quest == 11) set lhz_boss,24;
			else set lhz_boss,23;
			close2;
			cutin "",255;
			end;
		}
		mes "[卡尔]";
		mes "抱歉，但分析这份文件中的";
		mes "信息需要很长时间。";
		mes "而、而且贾吉亚为了拿到它";
		mes "牺牲了自己";
		mmes "。^333333*叹";
		mmes "气*^000000 贾吉亚……";
		next;
		mes "[卡尔]";
		mes "你先休息一下吧，";
		mes "我来仔细阅";
		mmes "读这份文件。";
		mes "希望很快就能看完……";
		close2;
		cutin "",255;
		end;
	}
	else if(lhz_boss == 23)
	{
		if(Shinokas_Quest == 11)
		{
			mes "[卡尔]";
			mes "尤弥尔之心碎片？";
			mes "他们想收集";
			mmes "的就是这个？";
			mes "他们打算拿这";
			mmes "么危险的东西";
			mes "做什么？！";
			next;
			mes "[卡尔]";
			mes "嗯，这个新情报";
			mes "带来了新的问题。";
			mes "幸运的是";
			mmes "，提供希诺卡斯情报的";
			mes "间谍又给了我们一条新线索。";
			next;
			mes "[卡尔]";
			mes "我们最近得知，";
			mes "希诺卡斯成功进入了";
			mes "雷根施莱姆秘密档案馆——一座隶属雷根贝勒的研究所。";
			mes "这就是他能了解到这么多";
			mes "相关信息的原因。";
			next;
			mes "[卡尔]";
			mes "进入这个档案馆";
			mes "会非常困难且危险，";
			mes "所以我希望";
			mmes "你去见一位";
			mes "在里希塔乐附近的";
			mes "卡普拉公司人员。";
			next;
			mes "[卡尔]";
			mes "别担心……";
			mes "她会知道你是谁，";
			mes "也知道该如";
			mmes "何帮助你。";
			set lhz_boss,26;
			completequest 12023;
			setquest 12024;
			close2;
			cutin "",255;
			end;
		}
		mes "[卡尔]";
		mes "我们还不知道希诺卡斯的";
		mes "情报究竟能带来多大帮助，";
		mes "但它或许会成为重要线索。";

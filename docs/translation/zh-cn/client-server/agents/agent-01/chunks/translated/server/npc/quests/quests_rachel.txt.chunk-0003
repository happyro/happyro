	mes "罗根？我来这里是为了——";
		next;
	mes "[可疑男子]";
	mes "哈！没想到这么简单！";
	mes "这是我赚过的最容易的钱！哇哈哈哈！";
	mes "小子，你该死了！";
		next;
	mes "[可疑男子]";
	mes "喝呀！";
		percentheal -50,0;
		next;
	mes "^3355FF这个可疑男子用飞刀刺伤了你，";
	mes "随后又掷出另一把，但被你躲开。";
	mes "你迅速反击，阻止他继续伤害你。^000000";
		next;
	mes "[可疑男子]";
	mes "啊！我……";
	mes "看来我低估你了！冒险者，";
	mes "你正面交手时比被偷袭时强多了！";
		next;
		mes "["+strcharinfo(0)+"]";
	mes "喂，你到底是谁？！你是罗根吗？";
	mes "你就是绑架菲比的人吗？";
		next;
		mes "[可疑男子]";
		mes "什么——？我没有绑架任何人！";
		mes "我根本不认识菲比！";
		mes "我只是受雇杀你，";
		mes "把你的尸体带给客户。";
		mes "事情和我想的不一样。";
		next;
		mes "[可疑男子]";
		mes "文森特吩咐我杀掉所有询问罗根的人，";
		mes "那似乎是他编造的名字。";
		mes "我叫莫根。天啊……我还以为你是坏人。";
		next;
		mes "[莫根]";
		mes "喂，跟我说清楚。你是不是偷了什么贵重东西，";
		mes "比如红色宝石之类的？";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "嗯？不是！文森特是派我来找偷走宝石的人，";
		mes "并替他取回宝石的！";
		next;
		mes "[莫根]";
		mes "看来他把我们都算计了，伙计。真卑鄙。";
		mes "抱歉，如果我知道真相，就不会这么做了。";
		mes "他为什么要这样操纵我们？";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "我不知道……";
		mes "我要去找文森特，让他解释清楚一切。";
		set lost_boy,7;
		changequest 8093,8094;
		close;
	}
	else if (lost_boy == 7) {
		mes "[莫根]";
		mes "看来他把我们都算计了，伙计。真卑鄙。";
		mes "如果我知道真相，就不会这么做了。";
		mes "他为什么要这样操纵我们？";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "我不知道……我要去找文森特，让他解释清楚一切。";
		close;
	}
}

rachel,263,32,3	script	Kid#ra_in01	931,{
	if (lost_boy < 7) {
		mes "[孩子]";
		mes "别烦我！";
		close;
	}
	else if (lost_boy == 8) {
		mes "^3355FF你看到这个男孩后口袋里闪过一道亮光。";
		mes "也许他身上有文森特要你取回的宝石。^000000";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "喂，你。";
		mes "你一定是菲比，对吧？";
		next;
		mes "[孩子]";
		mes "嗯？";
		mes "那又怎样？";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "你父亲派我来找你。";
		next;
		mes "[菲比]";
		mes "不！别碰我！";
		mes "我没有父亲！";
		mes "他对我来说已经死了！";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "不管怎样，我需要拿回你藏在口袋里的宝石。";
		mes "我知道它真正属于泽德先生。";
		mes "如果不拿回去，你父亲会有麻烦。";
		next;
		mes "[菲比]";
		mes "哈！你是说‘文森特先生’！";
		mes "我才不在乎！这正是我拿走它的原因！";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "哦，是吗？你觉得珍妮女士会怎么想？";
		mes "你觉得她听到这些会高兴吗？";
		next;
		mes "[菲比]";
		mes "……………………………………";
		mes "……所以你知道我们的家庭秘密了？";
		mes "好吧，我把它给你。但我是为了妈妈，不是为了他！";
		next;
		mes "^3355FF菲比小心地从口袋里取出闪亮的红宝石，";
		mes "不情愿地把它交给你。^000000";
		next;
		mes "[菲比]";
		mes "先说好，我没打算回家！";
		mes "至少现在不回去。";
		mes "但请告诉妈妈我没事，让她别担心。";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "好，我会告诉你妈妈。";
		mes "但你应该尽快回到他们身边。";
		mes "你父亲为了替你隐瞒，承担了很大风险。";
		next;
		mes "[菲比]";
		mes "哼！我……我才不在乎！";
		next;
		mes "^3355FF看来你暂时无法强迫菲比回家，";
		mes "所以你应该把这颗红宝石带回给文森特。^000000";
		set lost_boy,9;
		changequest 8095,8096;
		close;
	}
	else if (lost_boy == 9) {
		mes "[菲比]";
		mes "我……我还没准备好回家。";
		mes "告诉文森特先生，我不为自己的行为道歉，明白吗？！";
		next;
		mes "^3355FF看来你暂时无法强迫菲比回家，";
		mes "所以你应该把这颗红宝石带回给文森特。^000000";
		close;
	}
	else {
		mes "["+strcharinfo(0)+"]";
		mes "你应该别再惹麻烦，听父母的话。";
		next;
		mes "[菲比]";
		mes "你又不是我的老板！管好你自己！真是的！";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "如果你的行为给这么多人带来麻烦，";
		mes "我就不能只管自己的事！";
		mes "你得更负责任一些！";
		next;
		mes "[菲比]";
		mes "嗯呜……";
		mes "天啊……好吧。";
		close;
	}
}

// Bruspetti Quest (Perequisite: Lighthalzen "Friendship" quest) :: rachel_ryu
//============================================================ 
ra_in01,235,194,5	script	Katinshuell	931,{
	if (rach_vice > 21) {
		mes "[卡廷舒尔]";
		mes "如果我当初自首……";
		mes "如果我努力为罪行赎罪，";
		mes "我和布鲁斯佩蒂也许还有机会……";
		close;
	}
	else if ((rach_vice == 21) && (countitem(1201) > 0)) {
		mes "[卡廷舒尔]";
		mes "请……请别管我。";
		mes "因为我过去做的蠢事，我失去了所爱的女人。";
		mes "如果你想举报我，那就去吧……";
		delitem 1201,1; //Knife
		set rach_vice,22;
		changequest 8121,8122;
		close;
	}
	else if (rach_vice == 21) {
		mes "[卡廷舒尔]";
		mes "我想这是我必须背负的罪孽。";
		mes "它已经毁掉了我获得真正幸福的机会。布鲁斯佩蒂……";
		close;
	}
	else if ((rach_vice == 20) && (countitem(1201) > 0)) {
		mes "[卡廷舒尔]";
		mes "我想已经没有理由继续隐瞒了……";
		mes "你现在应该已经猜到重要的事情了……";
		next;
		mes "[卡廷舒尔]";
		mes "我曾是里希塔乐的保安，";
		mes "主要负责看守富人区与贫民窟之间的边界。";
		next;
		mes "[卡廷舒尔]";
		mes "我奉命杀掉一个经常往返贫民窟和富人区的人。";
		mes "他是个有钱人家的孩子……其实罪不至死。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "......";
		mes ".........";
		next;
		mes "[卡廷舒尔]";
		mes "我因此得到了一大笔钱。起初我以为只是在执行工作。";
		mes "法律站在我这边，但那个男孩的血怎么也洗不掉……";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "......";
		mes ".........";
		next;
		mes "[卡廷舒尔]";
		mes "我害怕杀他，但动手之后，罪恶感和折磨变得无法忍受！";
		mes "我再也睡不着……所以我不得不离开里希塔乐。";
		set rach_vice,21;
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "......";
		mes ".........";
		next;
		mes "[卡廷舒尔]";
		mes "布鲁斯佩蒂得知我当年的所作所为后受到了打击。";
		mes "我唯一深爱的人……她无法承受真相。";
		mes "从我口中听到真相后，她疯了……";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "......";
		mes ".........";
		next;
		mes "[卡廷舒尔]";
		mes "我没能阻止她……";
		mes "我挣扎着想救她，但她还是在芙蕾雅之泉溺亡。";
		mes "她就这样永远离开了我的生活。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "......";
		mes ".........";
		next;
		mes "[卡廷舒尔]";
		mes "我杀了人后来到这里，想开始新生活，重新做人，";
		mes "却间接害死了我所爱的女人。为什么，神啊？！为什么？！";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "......";
		mes ".........";
		next;
		mes "[卡廷舒尔]";
		mes "你现在满意了吗？";
		mes "我告诉你真相后，你是不是感觉好多了？！";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "......";
		mes ".........";
		next;
		mes "[卡廷舒尔]";
		mes "………………………………………";
		mes "天啊！我的人生真糟糕！";
		close;
	}
	else if (rach_vice == 21) {
		mes "[Katinshuell]";
		mes "^333333*Pant pant*^000000";
		mes "这么多年……我以为";
		mes "自己可以逃走……";
		mes "但那些声音仍然";
		mes "萦绕着我……哈哈哈……";
		close;
	}
	else if ((rach_vice == 20) && (countitem(1201) > 0)) {
		mes "[卡廷舒尔]";
		mes "我……";
		mes "我不值得这样！";
		mes "你为什么一直用这些问题逼我？";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "布鲁斯佩蒂在芙蕾雅之泉质问你时发生了什么？";
		mes "她究竟在里希塔乐得知了你的什么事？";
		next;
		mes "[卡廷舒尔]";
		mes "我……我没必要告诉你任何事！";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "你怎么能这么说？！";
		mes "我刚读了布鲁斯佩蒂的日记，";
		mes "她得知了关于你的可怕事情，";
		mes "而且涉及一把刀……就像这把。";
		next;
		mes "[Katinshuell]";
		mes ".........!";
		mes ".............";
		mes "不——！对不起，这都是我的错！我当时走投无路！";
		mes "你不明白我过去怎么生活，你不——！";
		set rach_vice,21;
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "嗯……？";
		mes "卡廷舒尔先生？";
		close;
	}
	else if ((rach_vice == 19) || (rach_vice == 20)) {
		mes "[卡廷舒尔]";
		mes "我……我不值得这样！";
		mes "你为什么一直用这些问题逼我？";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "布鲁斯佩蒂在芙蕾雅之泉质问你时发生了什么？";
		mes "她究竟在里希塔乐得知了你的什么事？";
		next;
		mes "[卡廷舒尔]";
		mes "我……我没必要告诉你任何事！";
		set rach_vice,20;
		changequest 8120,8121;
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "(^333333他还在抵抗……我怎样才能让他说出真相？^000000)";
		close;
	}
	else if (rach_vice == 18) {
		mes "[" + strcharinfo(0) + "]";
		mes "让我看看……";
		mes "这篇记录很有意思。";
		mes "内容全都和卡廷舒尔有关。";
		next;
		mes "- Date: OOXX -";
		mes "我非常爱他，但每当我问起他的过去，";
		mes "他总是转移话题。";
		mes "难道他在对我隐瞒什么？";
		next;
		mes "- Date: OOXX -";
		mes "是另一个女人吗？我忍不住感到嫉妒！";
		mes "我一定要弄清楚。";
		mes "所以我决定去里希塔乐看看能查到什么。";
		next;
		mes "- Date: OOXO -";
		mes "亲爱的日记，";
		mes "今天我刚得知可怕的真相……";
		mes "我必须让他向我承认。";
		mes "希望这一切之后我们仍能在一起……";
		next;
		mes "- Date: OOXO -";
		mes "但我不知道自己能否承受！";
		mes "我爱的男人……我无法想象他竟会";
		mes "用刀……我只是想吐。";
		next;
		mes "- Date: OOXO -";
		mes "我计划明天在芙蕾雅之泉见他。";
		mes "现在我忍不住用不同的眼光看他，但不管怎样……";
		mes "他仍是我真正爱着的男人。";
		next;
		mes "- Date: OOXO -";
		mes "希望下次写日记时能带来好消息……";
		mes "就这样祈祷吧。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "嗯，原来是这样";

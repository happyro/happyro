alberta,196,133,4	script	Bard#job_min	486,{
	if (job_min == 0) {
		if (BaseJob == Job_Bard && BaseLevel > 98 && JobLevel > 49) {
			mes "[吟游诗人]";
			mes "天籁之声在我耳边回荡，如同流浪的风，";
			next;
			mes "[吟游诗人]";
			mes "即使闭上双眼、捂住耳朵，我仍能听见某处传来的声音，";
			next;
			mes "[吟游诗人]";
			mes "它诱使疲惫的船员沉沉睡去，仿佛置身梦境之国。";
			next;
			mes "[女孩]";
			mes "啊！！太棒了！！";
			next;
			mes "[男孩]";
			mes "再来一首！！再来一首！！！";
			next;
			mes "[路过的老人]";
			mes "咿——那不是真正的歌曲……";
			next;
			mes "["+strcharinfo(0)+"]";
			mes "鼓掌。";
			mes "我能感受到节奏。";
			mes "能再听一首吗？";
			next;
			mes "[吟游诗人]";
			mes "嗯？看你的装扮，我觉得你很擅长唱歌。为什么不唱一首给我们听？";
			next;
			mes "["+strcharinfo(0)+"]";
			mes "??!!";
			next;
			mes "[吟游诗人]";
			mes "哈哈哈！只是开玩笑。你当真了吗？哈哈。";
			next;
			mes "["+strcharinfo(0)+"]";
			mes "...";
			next;
			mes "[卡里安]";
			mes "抱歉~别生气……";
			mes "我叫卡里安，只是在四处旅行。";
			next;
			mes "[卡里安]";
			mes "你想去什么地方吗？艾尔贝塔很适合旅行。";
			next;
			mes "[卡里安]";
			mes "但出海时必须小心。如果遇到塞壬，她迟早会杀死你。";
			next;
			mes "[卡里安]";
			mes "没有男人能在听到^f57d7d塞壬之声^000000后活下来。";
			next;
			mes "["+strcharinfo(0)+"]";
			mes "我是"+strcharinfo(0)+"。";
			mes "你来艾尔贝塔旅行吗？";
			next;
			mes "[卡里安]";
			mes "嗯……我不是想离开……";
			mes "...";
			next;
			mes "[卡里安]";
			mes "是的！我在寻找^f57d7d歌之大师^000000。";
			next;
			mes "["+strcharinfo(0)+"]";
			mes "^f57d7d‘歌之大师’^000000，指的是传说中的诗人吗？";
			next;
			mes "[卡里安]";
			mes "没错。根据我听到的传闻，他是一位富有的贵族。";
			mes "除此之外，我无法得到更多信息。";
			next;
			mes "["+strcharinfo(0)+"]";
			mes "为什么无法得到更多信息？";
			next;
			mes "[卡里安]";
			mes "嗯？";
			mes "所以我才试着去普隆德拉……";
			mes "呃……";
			next;
			mes "[卡里安]";
			mes "如果你感兴趣，为什么不帮我查查^f57d7d‘歌之大师’^000000在哪里？";
			next;
			if(select("好。:不了。") == 2) {
				mes "["+strcharinfo(0)+"]";
				mes "我没兴趣。";
				next;
				mes "[卡里安]";
				mes "是吗？那也没办法。回头见~";
				close;
			}
			if (VIP_SCRIPT) {
				callfunc "VIP_Third_Class";
				set job_min,1;
				setquest 11135;
				next;
			}
			mes "["+strcharinfo(0)+"]";
			mes "好，我会帮忙。";
			set job_min,1;
			setquest 11135;
			next;
			mes "[卡里安]";
			mes "独自旅行很好，但有时也会想身边有朋友。";
			next;
			mes "[卡里安]";
			mes "那么，"+strcharinfo(0)+"，你能在^f57d7d普隆德拉^000000收集一些^f57d7d‘歌之大师’的情报^000000吗？";
			mes "因为我在艾尔贝塔还有事情要调查。";
			next;
			mes "[卡里安]";
			mes "调查结束后请回到这里。";
			close;
		}
		mes "[吟游诗人]";
		mes "出海时必须小心。如果被塞壬迷住，她迟早会杀死你。";
		next;
		mes "[吟游诗人]";
		mes "没有男人能在听到^f57d7d塞壬之声^000000后活下来。";
		close;
	} else if (job_min == 1) {
		mes "[卡里安]";
		mes "独自旅行很好，但有时也会想身边有朋友。";
		next;
		mes "[卡里安]";
		mes "那么，"+strcharinfo(0)+"，你能在^f57d7d普隆德拉^000000收集一些^f57d7d‘歌之大师’的情报^000000吗？";
		mes "因为我在艾尔贝塔还有事情要调查。";
		next;
		mes "[卡里安]";
		mes "调查结束后请回到这里。";
		close;
	} else if (job_min > 1 && job_min < 4) {
		mes "[卡里安]";
		mes "你能在^f57d7d普隆德拉^000000收集一些^f57d7d‘歌之大师’的情报^000000吗？";
		mes "因为我在艾尔贝塔还有事情要调查。";
		next;
		mes "[卡里安]";
		mes "调查结束后请回到这里。";
		close;
	} else if (job_min == 4) {
		mes "[卡里安]";
		mes strcharinfo(0)+"！你已经去过普隆德拉了吗？得到有用的情报了吗？";
		next;
		mes "[卡里安]";
		mes "嗯~真的吗？我觉得这些还不够……";
		next;
		mes "[卡里安]";
		mes "呼呼~不过我从艾尔贝塔的几位船长那里得到了一些有用情报。";
		next;
		mes "[卡里安]";
		mes "听说有一艘船上曾有一位能成为^f57d7d歌之大师^000000的人。";
		mes "几年前，那艘船前往^f57d7d胡格尔^000000。";
		next;
		mes "[卡里安]";
		mes "那艘船已经不存在了，所以我需要乘飞艇……";
		mes "这是我第一次乘飞艇。";
		next;
		mes "[卡里安]";
		mes "嗯……总之，我们在依斯鲁得的飞艇处见。";
		set job_min,5;
		changequest 11138,11139;
		close;
	} else if (job_min == 100) {
		mes "[卡里安]";
		mes "天籁之声在我耳边回荡，如同流浪的风，";
		next;
		mes "[吟游诗人]";
		mes "即使闭上双眼、捂住耳朵，我仍能听见某处传来的声音，";
		next;
		mes "[吟游诗人]";
		mes "它诱使疲惫的船员沉沉睡去，仿佛置身梦境之国。";
		next;
		mes "[卡里安]";
		mes "啊！！！"+strcharinfo(0)+"，好久不见！";
		mes "什么？我为什么在这里？";
		next;
		mes "[卡里安]";
		mes "嗯？让我离开这里？";
		next;
		mes "[歌之大师]";
		mes "想见我的时候就来找我。";
		mes "有空就过来聊聊天吧。";
		next;
		switch(select("接受。:拒绝。")) {
		case 1:
			mes "[歌之大师]";
			mes "你去过有趣的地方吗？我很期待听你说！";
			close2;
			warp "prt_in",101,174;
			end;
		case 2:
			mes "[歌之大师]";
			mes "那下次再来吧。";
			close;
		}
	}
	mes "[吟游诗人]";
	mes "天籁之声在我耳边回荡，如同流浪的风，";
	next;
	mes "[吟游诗人]";
	mes "即使闭上双眼、捂住耳朵，我仍能听见某处传来的声音，";
	next;
	mes "[吟游诗人]";
	mes "它诱使疲惫的船员沉沉睡去，仿佛置身梦境之国。";
	close;
}

prontera,141,97,4	script	Warmhearted woman	701,{
	mes "[热心女士]";
	if (job_min == 1) {
		mes "歌之大师？我以前没听过这个名字。";
		next;
		mes "[热心女士]";
		mes "他是传说中的诗人吗？我不知道他是谁，不过想必是个伟大的人？";
		next;
		mes "[热心女士]";
		mes "啊！去问^f57d7d城堡门口附近戴眼镜的男人^000000关于歌曲的事。";
		mes "他正在制作一本百首名曲集~";
		next;
		mes "[热心女士]";
		mes "他一定知道那本书的事情。";
		set job_min,2;
		changequest 11135,11136;
		close;
	} else if (job_min == 2) {
		mes "啊！去问^f57d7d城堡门口附近戴眼镜的男人^000000关于歌曲的事。";
		mes "他正在制作一本百首名曲集~";
		next;
		mes "[热心女士]";
		mes "他一定知道那本书的事情。";
		close;
	}
	mes "我听说^f57d7d城堡门口附近戴眼镜的男人^000000正在制作百首名曲集~";
	close;
}

prontera,140,331,6	script	Glasses-wearing Man	883,{
	mes "[戴眼镜的男人]";
	if (job_min == 2) {
		mes "你说歌之大师？我不了解他的生活细节，但听说他写了很棒的歌曲。";
		next;
		mes "[戴眼镜的男人]";
		mes "我不明白一个在富裕环境中长大的男孩怎么能写出这样的歌。";
		next;
		mes "[戴眼镜的男人]";
		mes "他仍在旅行，但最近我们没听到他的新歌。";
		next;
		mes "[戴眼镜的男人]";
		mes "所以我们很担心。";
		next;
		mes "[戴眼镜的男人]";
		mes "最好去问^f57d7d站在工具店前的女人^000000。";
		set job_min,3;
		changequest 11136,11137;
		close;
	} else if (job_min == 3) {
		mes "最好去问^f57d7d站在工具店前的女人^000000。";
		close;
	}
	mes "百首名曲！！";
	mes "想成为宫廷乐师的人都应该知道这件事！";
	next;
	mes "[戴眼镜的男人]";
	mes "这本书完成后我就发财了！哈哈！！";
	close;
}

prontera,146,218,4	script	Woman#job_min	90,{
	if (job_min == 3) {
		mes "[女人]";
		mes "你知道歌之大师是谁吗？我想他一定就是我的小儿子。";
		next;
		mes "[女人]";
		mes "几年前他出海了，但再也没有回来。";
		next;
		mes "[女人]";
		mes "他很喜欢唱歌，但我们不让他唱。";
		next;
		mes "[女人]";
		mes "他的父亲不喜欢他唱歌。";
		next;
		mes "[女人]";
		mes "所以他打碎了家里所有乐器……太可怕了。";
		mes "我的小儿子在哪里……呜。";
		next;
		mes "—我已经得不到更多有用情报了。—";
		mes "—我要回艾尔贝塔和那位吟游诗人谈谈。—";
		set job_min,4;
		changequest 11137,11138;
		close;
	} else if (job_min == 4) {
		mes "—我已经得不到更多有用情报了。—";
		mes "—回艾尔贝塔和那位吟游诗人谈谈。—";
		close;
	}
	mes "[女人]";
	mes "我的小儿子在哪里……呜。";
	close;
}

airplane,222,67,6	script	Karian#job_min1	486,{
	mes "[卡里安]";
	mes "好！！！！！！！！！！";
	next;
	mes "[卡里安]";
	mes "请别管我。我感到恶心。";
	next;
	mes "[卡里安]";
	mes "呃……";
	if (job_min == 5) {
		set job_min,6;
		changequest 11139,11140;
		close2;
		warp "hu_in01",267,8;
		end;
	}
	close;
}

hu_in01,267,5,3	script	Karian#job_min2	486,{
	mes "[卡里安]";
	if (job_min == 6) {
		mes "呃啊，好痛苦。我再也不想有这种感觉了。";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "你没事吧？";
		next;
		mes "[卡里安]";
		mes "……不……";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "我没事。我要去镇上打听情报，你可以休息。";
		next;
		mes "[卡里安]";
		mes "抱歉，呕！我还是很难受……";
		mes "你可以从^f57d7d酒吧^000000得到有用情报。呜……";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "你不用告诉我所有事情，我能自己处理。";
		next;
		mes "[Karian]";
		mes "...";
		set job_min,7;
		changequest 11140,11141;
		close;
	} else if (job_min == 7) {
		mes "抱歉……呜！你可以从^f57d7d酒吧^000000得到有用情报。呜……";
		close;
	} else if (job_min == 8) {
		mes "呜……你得到什么了吗？";
		next;
		mes "—卡里安看起来状态很不好。—";
		mes "—你可以从酒吧里的男人那里得到情报。—";
		close;
	} else if (job_min == 9) {
		mes "呜……";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "你感觉怎么样？";
		next;
		mes "[卡里安]";
		mes "呜……好多了。";
		next;
		mes "[卡里安]";
		mes "你得到什么了吗？抱歉我没法更好地帮助你。";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "没关系。我在酒吧遇到一个男人，他说自己拿到了‘歌之大师’的歌曲。";
		next;
		mes "[卡里安]";
		mes "酒吧？你得到了一首歌？……呕……";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "嘿！你真的没事吗？";
		next;
		mes "[卡里安]";
		mes "我不是晕机，只是想起了不好的回忆。那么，你听到了什么？";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "我听到一首叫^f57d7d‘金属之声’^000000的歌。";
		next;
		mes "[卡里安]";
		mes "什么？！？！？！？！你听到了那首歌？！";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "为什么？你知道那首歌吗？";
		next;
		mes "[卡里安]";
		mes "啊……是、是的……";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "嗯……";
		next;
		mes "[卡里安]";
		mes "我以前见过他。他的声音很棒……";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "是的。我听到那首歌时昏了过去。";
		next;
		mes "[卡里安]";
		mes "他的歌声拥有毁灭性的力量。而且他……还有什么？";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "啊！！";
		mes "^f57d7d‘歌之大师’^000000去了^f57d7d塔纳托斯塔^000000。";
		mes "我不知道他为什么去那里。";
		next;
		mes "[卡里安]";
		mes "真的吗？我必须去那里！";
		set job_min,10;
		changequest 11142,11143;
		close;
	} else if (job_min == 10) {
		mes "你在做什么？我们去塔纳托斯塔吧。";
		close;
	}
	mes "当然乘飞艇很方便，但有时走路也不错。";
	next;
	mes "[卡里安]";
	mes "这不是因为我的病。";
	close;
}


//===== rAthena Script =======================================
//= iRO 2008 Christmas Event
//===== By: ==================================================
//= Kisuka
//===== Current Version: =====================================
//= 1.1
//===== Compatible With: =====================================
//= rAthena Project
//===== Description: =========================================
//= iRO Christmas Event. (2008)
//= Create Music Box and Cake.
//= Play card game with Santa.
//= Create Santa Suits.
//=
//= NOTE: Must enable X-mas08 mobs in mob_db2.
//===== Additional Comments: =================================
//= 1.0 First version. [Kisuka]
//= 1.1 Fixed some issues, revamped the whole script. [Kisuka]
//============================================================

// Caroller - Music Box
//============================================================
prontera,226,306,4	script	Caroller#iROxmas08	79,{
	if (iROxmas08carol < 1 || iROxmas08carol == 3) {
		if (iROxmas08carol == 3) {
			mes "[Caroller]";
			mes "铃儿响叮当！铃儿响叮当！一路响个不停！";
			mes "哦，乘着一匹马拉的雪橇多么有趣，嘿！";
			next;
			mes "[Caroller]";
			mes "圣诞快乐！";
			mes "嘿！你！想到圣诞节时会想到什么？";
			next;
		} else {
			mes "[Caroller]";
			mes "铃儿响叮当！铃儿响叮当！一路响个不停！";
			next;
			specialeffect EF_GLORIA;
			mes "[Caroller]";
			mes "哦，乘着一匹马拉的雪橇多么有趣！";
			next;
			mes "[Caroller]";
			mes "圣诞快乐！";
			if (Sex == SEX_MALE) {
				mes "嘿，男孩！想到圣诞节时会想到什么";
			} else {
				mes "嘿，女孩！想到圣诞节时会想到什么";
			}
			mes "？";
			next;
		}
		switch(select("圣诞老人:礼物盒:颂歌:圣诞服装:假圣诞老人 Antonio")) {

			case 1:
				mes "[Caroller]";
				mes "圣诞老人！";
				mes "你真天真！！";
				mes "啊！";
				next;
				mes "[Caroller]";
				mes "告诉你一个秘密！";
				mes "据说圣诞老人全年都住在某个村庄。";
				next;
				mes "[Caroller]";
				mes "但是现在！！！";
				mes "在这个圣诞季节！！";
				mes "你们可以在卢恩-米德加尔特的五个村庄之一见到圣诞老人！";
				next;
				mes "[Caroller]";
				mes "如果赢得圣诞老人的认可，就能得到礼物。你愿意试试吗？";
				next;
				emotion ET_SMILE;
				mes "[Caroller]";
				mes "颂歌手的最新消息！哈！";
				mes "这不是大新闻吗？";
				close;

			case 2:
				mes "[Caroller]";
				mes "礼物盒？！好啊！";
				mes "在头顶打开礼物不是很刺激吗！！";
				next;
				mes "[Caroller]";
				mes "总之，你知道吗……";
				mes "有个坏蛋假圣诞老人从好圣诞老人那里抢走了一些礼物！";
				next;
				mes "[Caroller]";
				mes "而且他给礼物施了坏魔法，让它们变成了怪物！";
				next;
				emotion ET_SMILE;
				mes "[Caroller]";
				mes "颂歌手的最新消息！哈！";
				mes "很惊人吧？";
				close;

			case 3:
				if (iROxmas08carol == 3) {
					mes "[Caroller]";
					mes "啊，音乐盒很有用。";
					next;
					mes "[Caroller]";
					mes "虽然不能像计划那样在村里一起演奏，但你带着它也很酷。";
					next;
					mes "[Caroller]";
					mes "我们想一起享受颂歌……希望得到水晶碎片！";
					next;
					mes "[Caroller]";
					mes "如果你能得到 ^0000FF歌唱水晶碎片^000000，请交给我好吗？";
					next;
					select("为什么不呢？当然可以。 ");
					if (countitem(6092) < 6) {
						mes "[Caroller]";
						mes "好的，请给我。";
						next;
						mes "[Caroller]";
						mes "如果你能得到 ^0000FF歌唱水晶碎片^000000，请交给我好吗？";
						close;
					} else {
						mes "[Caroller]";
						mes "哇，你真的有。";
						next;
						mes "[Caroller]";
						mes "我可以给你烤蛋糕，还能把你的名字刻在蛋糕上！";
						next;
						if (select("不用了，谢谢。:请把名字刻上去。") == 2) {
							mes "[Caroller]";
							mes "谢谢你的帮助！";
							next;
							mes "[Caroller]";
							mes "巨大的世界里住着许多人！";
							mes "许多人希望听到颂歌，但我总是缺少水晶碎片。";
							next;
							mes "[Caroller]";
							mes "如果你能得到 ^0000FF歌唱水晶碎片^000000，请交给我好吗？";
							next;
							emotion ET_SMILE;
							delitem 6092,6;
							getnameditem 12354,strcharinfo(0);
							mes "[Caroller]";
							mes "这个圣诞季节，请关心身边的人！";
							close;
						} else {
							mes "[Caroller]";
							mes "哦！";
							mes "真害羞！";
							next;
							mes "[Caroller]";
							mes "总之，非常感谢你的帮助。";
							next;
							mes "[Caroller]";
							mes "巨大的世界里住着许多人！";
							mes "许多人希望听到颂歌，但我总是缺少水晶碎片。";
							next;
							mes "[Caroller]";
							mes "如果你能得到 ^0000FF歌唱水晶碎片^000000，请交给我好吗？";
							next;
							emotion ET_SMILE;
							delitem 6092,6;
							getitem 12354,1;
							mes "[Caroller]";
							mes "这个圣诞季节，请关心身边的人！";
							close;
						}
					}
				}
					mes "[Caroller]";
					mes "你了解圣诞节！";
					mes "说到圣诞节……";
					mes "……就是颂歌！！！";
					mes "我一直在等待";
					mes "圣诞节到来！";
					next;
					mes "[Caroller]";
					mes "但这里不像以前那样到处传唱颂歌，我们感受不到圣诞气氛。";
					next;
					mes "[Caroller]";
					mes "所以我在普隆德拉安装了歌唱水晶……";
					next;
					mes "[Caroller]";
					mes "但那个混蛋 Antonio 把水晶弄坏了！";
					next;
					mes "[Caroller]";
					mes "Antonio 对礼物盒施法后，它们变成了怪物，怪物吃掉了水晶碎片！";
					next;
					mes "[Caroller]";
					mes "我非常绝望，因为歌唱水晶是村庄里许多孩子的希望。";
					next;
					if (select("没有其他办法唱颂歌了吗？:你可以在姜饼城听颂歌。") == 2) {
						mes "[Caroller]";
						mes "然后一辈子每个圣诞节都待在那里？";
						next;
						mes "["+strcharinfo(0)+"]";
						mes "什么？你是什么意思？";
						next;
						mes "[Caroller]";
						mes "哦，没什么。";
						mes "啊……";
						close;
					}
					mes "[Caroller]";
					mes "也许给村庄制作点唱机很难，但音乐盒应该可以。";
					next;
					mes "[Caroller]";
					mes "我们需要被怪物吃掉的 ^0000FF歌唱水晶碎片^000000。";
					next;
					mes "[Caroller]";
					mes "请带来 ^0000FF6 个歌唱水晶碎片^000000，就能得到礼物奖励！";
					next;
					mes "[Caroller]";
					mes "听起来很酷，对吧！！";
					next;
					select("........................");
					mes "[Caroller]";
					mes "……你为什么那样盯着我？";
					next;
					mes "[Caroller]";
					mes "你在想我们的计划总是被破坏，对吧？";
					next;
					mes "[Caroller]";
					mes "我知道我们不太擅长控制局面，但奖励很不错，对吧？";
					next;
					select("........................");
					mes "[Caroller]";
					mes "嘿，我们对你很好……";
					next;
					select("........................");
					mes "[Caroller]";
					mes "你对我太残忍了！";
					mes "坏！坏！";
					next;
					mes "[Caroller]";
					mes "求你了，为了孩子们的希望！！！";
					mes "请从 ^0000FF暴走礼物盒^000000 中带来 6 个歌唱水晶碎片！";
					next;
					emotion ET_OK;
					mes "[Caroller]";
					mes "它们确实和名字一样凶猛。";
					mes "拜托了！";
					set iROxmas08carol,1;
					close;

			case 4:
				mes "[Caroller]";
				mes "圣诞服装！！";
				mes "你知道吗，怪物现在穿的圣诞服装不是真的！";
				next;
				mes "[Caroller]";
				mes "这里的传闻是，姜饼城的设计师制作了这些服装。";
				next;
				mes "[Caroller]";
				mes "每年冒险者都会挑战假圣诞老人 Antonio，但他的帽子和服装让人根本追不上！";
				next;
				mes "[Caroller]";
				mes "它们里面有什么特殊能力吗？";
				mes "圣诞村里还有那位设计师……去请她制作那套服装怎么样？";
				next;
				emotion ET_SMILE;
				mes "[Caroller]";
				mes "颂歌手的最新消息！哈！";
				mes "很热门，对吧？";
				close;


			case 5:
				mes "[Caroller]";
				mes "A-N-T-O-N-I-O！！！";
				mes "听说这个 Antonio 和以前很不一样。";
				next;
				mes "[Caroller]";
				mes "据说他以前逃离人群后，现在已经想通了。";
				next;
				mes "[Caroller]";
				mes "而且听说他不再孤单了……";
				next;
				emotion ET_SMILE;
				mes "[Caroller]";
				mes "颂歌手的最新消息！哈！";
				mes "很热门，对吧？";
				close;
		}
	}
	
	if (iROxmas08carol == 1) {
		if (countitem(6092) < 6) {
			mes "[Caroller]";
			mes "也许给村庄制作点唱机很难，但音乐盒应该可以。";
			next;
			mes "[Caroller]";
			mes "我们需要被怪物吃掉的 ^0000FF歌唱水晶碎片^000000。";
			next;
			mes "[Caroller]";
			mes "请带来 ^0000FF6 个歌唱水晶碎片^000000，就能得到礼物奖励！";
			next;
			mes "[Caroller]";
			mes "为了这个世界的所有孩子！！！";
			mes "请从 ^0000FF暴走礼物盒^000000 中带来 ^0000FF歌唱水晶碎片^000000！";
			next;
			emotion ET_OK;
			mes "[Caroller]";
			mes "小心！";
			mes "它们确实和名字一样凶猛。";
			mes "保重！！！";
			close;
		} else {
			specialeffect EF_GLORIA;
			mes "[Caroller]";
			mes "别哭，别哭！";
			mes "你哭的话圣诞老人不会给你礼物。";
			next;
			mes "[Caroller]";
			select("我拿到了！");
			mes "[Caroller]";
			mes "哇，你拿到了！";
			mes "它们真凶猛，对吧？";
			mes "很高兴再次见到你。";
			next;
			mes "[Caroller]";
			mes "我们一起数吧！";
			mes "…… ……";
			mes "六个！！";
			next;
			mes "[Caroller]";
			mes "好！我们可以用水晶碎片制作音乐盒了。";
			next;
			mes "[Caroller]";
			mes "我们会放大水晶碎片的声音，让它从音乐盒中传出。";
			next;
			mes "[Caroller]";
			mes "你知道，就像点唱机一样的音乐盒！";
			next;
			mes "[Caroller]";
			mes "它很方便，随身携带就能在任何地方听到美妙颂歌。";
			mes "听起来很酷吧！？";
			next;
			mes "[Caroller]";
			mes "所以还需要一些材料。";
			mes "^0000FF木材 10 个、铁匠锤 1 个、朱比利 1 个、黏液 10 个、3 克拉钻石 1 个^000000！";
			next;
			delitem 6092,6;
			emotion ET_OK;
			set iROxmas08carol,2;
			mes "[Caroller]";
			mes "这些都是必需品。";
			mes "很简单吧？";
			close;
		}
	}
	
	if (iROxmas08carol == 2) {
		if (countitem(1019) < 10 || countitem(1005) < 1 || countitem(7312) < 1 || countitem(938) < 10 || countitem(732) < 1) {
			mes "[Caroller]";
			mes "我们可以用歌唱水晶碎片制作音乐盒。";
			mes "它很方便，随时都能听到颂歌。很酷吧？";
			next;
			mes "[Caroller]";
			mes "所以还需要一些材料。";
			mes "^0000FF木材 10 个、铁匠锤 1 个、朱比利 1 个、黏液 10 个、3 克拉钻石 1 个^000000！";
			next;
			emotion ET_OK;
			mes "[Caroller]";
			mes "这就是全部需求。";
			mes "很简单吧？";
			close;
		} else {
			specialeffect EF_GLORIA;
			mes "[Caroller]";
			mes "铃儿响叮当，铃儿响叮当，";
			mes "一路响个不停！";
			mes "哦，乘着一匹马拉的";
			mes "开……放……雪橇多么有趣！！！";
			next;
			mes "[Caroller]";
			mes "哇！";
			mes "你回来了！";
			mes "把所有材料带来了吗？";
			next;
			mes "[Caroller]";
			mes "很好！";
			mes "别犹豫！开始制作音乐盒吧。";
			next;
			mes "[Caroller]";
			specialeffect EF_REPAIRWEAPON;
			mes "铁匠锤敲打木材……我们塑造框架。";
			next;
			mes "[Caroller]";
			//(effect - stones from ground?)
			mes "用歌唱水晶碎片做柱子，用钻石作装饰，用黏液当胶水。";
			next;
			mes "[Caroller]";
			specialeffect EF_HIT2;
			mes "现在……";
			mes "用朱比利装饰……";
			next;
			mes "[Caroller]";
			specialeffect EF_SUFFRAGIUM;
			mes "最后一步……！";
			mes "赋予它生命！";
			next;
			mes "[Caroller]";
			mes "完成了！！！";
			next;
			mes "[Caroller]";
			mes "太酷了！很可爱吧！！？！";
			next;
			mes "[Caroller]";
			mes "你完成了我的要求，我会按承诺送你礼物。";
			next;
			mes "[Caroller]";
			mes "第一份是这个音乐盒。";
			mes "请把音乐盒带到各个村庄播放！";
			next;
			mes "[Caroller]";
			mes "另一份礼物是按照你名字形状制作的圣诞蛋糕！";
			mes "我做了这个名字形状的蛋糕！";
			next;
			mes "[Caroller]";
			mes "别担心，味道很好。";
			next;
			emotion ET_OK;
			getitem 2784,1;
			getnameditem 12354,strcharinfo(0);
			delitem 1019,10;
			delitem 1005,1;
			delitem 7312,1;
			delitem 938,10;
			delitem 732,1;
			set iROxmas08carol,3;
			mes "[Caroller]";
			mes "非常感谢。";
			mes "圣诞快乐！";
			mes "祝你节日愉快！";
			close;
		}
	}
}

// Santa Claus - Card Game
//============================================================
-	script	Santa Claus#iROxmas08::08santa	718,{
	mes "[Santa Claus]";
	mes "哇！你今年是淘气还是乖巧？";
	mes "那么，想到圣诞节时你会想到什么？";
	next;
	switch(select("唱颂歌:圣诞老人:礼物盒:圣诞服装:其实没什么……")) {
	
	case 1:
		mes "[Santa Claus]";
		mes "唱颂歌！很好！";
		mes "甜美的颂歌总能让圣诞节更加快乐！！！";
		next;
		mes "[Santa Claus]";
		mes "没错，颂歌把欢乐传遍全世界。";
		close;

	case 2:
		mes "[Santa Claus]";
		if (Sex == SEX_MALE) {
			mes "吼吼吼！真是个乖男孩！";
		} else {
			mes "吼吼吼！真是个乖女孩！";
		}
		next;
		mes "[Santa Claus]";
		mes "但要小心到处游荡的假圣诞老人。";
		mes "你听说过每年圣诞节入侵村庄的 Antonio 吗？";
		next;
		mes "[Santa Claus]";
		mes "他偷走了我的礼物，还袭击玩具工厂和姜饼城原野附近的冒险者。";
		next;
		mes "[Santa Claus]";
		mes "坏圣诞老人毁了我们好圣诞老人的名声！";
		mes "世界圣诞老人组织认为这是严重情况。";
		close;
	
	case 3:
		mes "[Santa Claus]";
		mes "礼物盒！听起来不错！";
		mes "圣诞早晨醒来打开礼物盒真令人兴奋！！！";
		next;
		mes "[Santa Claus]";
		mes "但现在礼物很少，因为圣诞老人 Antonio 偷走了我的礼物袋。";
		next;
		mes "[Santa Claus]";
		mes "许多冒险者试图追上他，但他很难抓住。";
		next;
		mes "[Santa Claus]";
		mes "让那些冒险者去抓他吧，我有个小游戏给你。";
		next;
		mes "[Santa Claus]";
		mes "如果你赢了我，我会送你一份小礼物！";
		next;
		mes "[Santa Claus]";
		mes "想和我玩个游戏吗？";
		next;
		if (select("不用了，谢谢。:好啊。") == 1) {
			mes "[Santa Claus]";
			mes "啊，别害怕。";
			mes "即使你今年有点淘气，我也不会往袜子里塞煤炭。";
			next;
			mes "[Santa Claus]";

1@os_b,146,221,7	script	Ridsh#171_os_2	4_F_LEEDSH,{
	if ('seal_os != 3)
		end;
	cutin "ep162_rds04",2;
	mes "[里德什]";
	mes "啊！";
	npctalk "里德什：啊！";
	next;
	.@est$ = instance_npcname("Est#171_os_0");
	hideoffnpc .@est$;
	sleep2 500;
	specialeffect EF_BLASTMINEBOMB,AREA,instance_npcname("#171_sos_dummy_6");
	sleep2 500;
	disablenpc instance_npcname("#171_sos_dummy_6");
	specialeffect EF_BLASTMINEBOMB,AREA,instance_npcname("#171_sos_dummy_7");
	cutin "ep162_est01",2;
	mes "[Est]";
	mes "Oh...";
	mes "我正忙着呢，你们在这里做什么？";
	npctalk "埃斯特：我正忙着呢，你们在这里做什么？",.@est$;
	disablenpc instance_npcname("#171_sos_dummy_7");
	next;
	cutin "ep162_est02",2;
	mes "[Est]";
	mes "请回去优雅地享用你们的茶吧。";
	npctalk "埃斯特：请回去优雅地享用你们的茶吧。",.@est$;
	next;
	cutin "ep162_rds02",2;
	mes "[里德什]";
	mes "什么！";
	mes "你们到底是怎么偷偷溜进来的？";
	npctalk "里德什：什么！你们到底是怎么偷偷溜进来的？";
	next;
	cutin "ep162_est02",2;
	mes "[Est]";
	mes "这只是例行监视。";
	mes "哪怕闭眼一秒，也可能发生意外。";
	npctalk "埃斯特：这只是例行监视。",.@est$;
	sleep2 2000;
	npctalk "埃斯特：哪怕闭眼一秒，也可能发生意外。",.@est$;
	next;
	cutin "ep162_rds02",2;
	mes "[里德什]";
	mes "你凭什么认为我们需要你的帮助？";
	npctalk "里德什：你凭什么认为我们需要你的帮助？";
	next;
	cutin "ep162_est02",2;
	mes "[Est]";
	mes "你们刚才不是已经这么做了吗？";
	mes "我应该没有听错吧？";
	next;
	disablenpc instance_npcname("Cotnes#171_os_2");
	.@cot$ = instance_npcname("Cotnes#171_os_3");
	hideoffnpc .@cot$;
	cutin "ep162_ctn01",2;
	mes "[科特内斯]";
	mes "你们两个真是的~";
	mes "请别再吵了。";
	npctalk "科特内斯：你们两个真是的~请别再吵了。",.@cot$;
	next;
	disablenpc instance_npcname("Dien#171_os_3");
	.@dien$ = instance_npcname("Dien#171_os_4");
	hideoffnpc .@dien$;
	cutin "ep162_dn03",2;
	mes "[迪恩]";
	mes "你们怎么总是这样争吵？";
	npctalk "迪恩：你们怎么总是这样争吵？",.@dien$;
	next;
	cutin "ep162_ctn01",2;
	mes "[科特内斯]";
	mes "我都快兴奋死了~我老了，也厌倦争吵了。";
	npctalk "科特内斯：我都快兴奋死了~我老了，也厌倦争吵了。",.@cot$;
	next;
	cutin "ep162_dn03",1;
	mes "[迪恩]";
	mes "是这样吗？";
	npctalk "迪恩：是这样吗？",.@dien$;
	next;
	cutin "ep162_ctn01",2;
	mes "[科特内斯]";
	mes "是啊~";
	mes "我厌倦争吵了，回去工作吧。";
	mes "现在道路已经畅通了。";
	npctalk "科特内斯：是啊~我厌倦争吵了，回去工作吧。现在道路已经畅通了。",.@cot$;
	close2;
	cutin "",255;
	if ('seal_os == 3) {
		'seal_os = 4;
		donpcevent instance_npcname("#171_sealedos_control") + "::OnEvent05";
	}
	end;
}

1@os_b,259,360,5	script	Dien#171_os_5	4_F_DIENE,{
	if ('seal_os != 4)
		end;
	cutin "ep162_dn03",2;
	mes "[迪恩]";
	mes "终于……";
	mes "只要穿过这扇门……";
	next;
	cutin "ep162_est01",2;
	mes "[埃斯特]";
	mes "趁他们还没集结更多兵力，我们现在回去吧。";
	next;
	cutin "ep162_dn03",2;
	mes "[迪恩]";
	mes "打扰一下。";
	next;
	cutin "ep162_est01",2;
	mes "[埃斯特]";
	mes "?";
	next;
	cutin "ep162_rds01",2;
	mes "[里德什]";
	mes "怎么了？";
	next;
	cutin "ep162_dn03",2;
	mes "[迪恩]";
	mes "天啊，天啊！";
	mes "我们该怎么办！";
	next;
	cutin "ep162_rds04",2;
	mes "[里德什]";
	mes "怎么了，发生什么事？";
	next;
	cutin "ep162_dn03",2;
	mes "[迪恩]";
	mes "我好像把它落下了。";
	next;
	cutin "ep162_rds01",2;
	mes "[里德什]";
	mes "落下了什么？";
	next;
	cutin "ep162_dn03",2;
	mes "[迪恩]";
	mes "我的护身符！";
	mes "不带在身边我会很不安。";
	next;
	cutin "ep162_rds04",2;
	mes "[里德什]";
	mes "没有它你不是一直都没事吗？！";
	next;
	cutin "ep162_dn03",2;
	mes "[迪恩]";
	mes "...";
	next;
	cutin "ep162_rds01",2;
	mes "[里德什]";
	mes "啊……抱歉……";
	mes "好吧。";
	next;
	mes "[里德什]";
	mes "我们打开最后一扇门时，能请你回^FF0000克拉纳·内米耶里^000000一趟吗？";
	next;
	mes "[里德什]";
	mes "反正我也要联系几个人，而且迪恩拿回护身符前哪里都不会去。";
	next;
	mes "[里德什]";
	mes "姐姐，告诉我它在哪里。";
	next;
	cutin "ep162_dn02",2;
	mes "[迪恩]";
	mes "哦！";
	mes "真的非常感谢你，";
	next;
	mes "[迪恩]";
	mes "那里太远了，我很难自己拿回来……";
	mes "请帮我这个忙。";
	next;
	cutin "ep162_dn01",2;
	mes "[迪恩]";
	mes "^FF0000回我的房间，在窗户左侧、花瓶旁边找一个箱子。";
	next;
	mes "[迪恩]";
	mes "我们就在这里，应该很容易拿到。";
	next;
	cutin "ep162_rds05",2;
	mes "[里德什]";
	mes "哦！";
	mes "我们不该告诉他们我们在哪里吗？";
	if (isbegin_quest(11600) == 1) {
		completequest 11600;
		setquest 11601;
		getitem 25669,25;
		getexp 600000,600000;
	}
	close2;
	warp "ein_fild03",258,267;
	end;

OnInstanceInit:
	questinfo(QTYPE_QUEST,QMARK_YELLOW,"isbegin_quest(11600) == 1");
	end;
}


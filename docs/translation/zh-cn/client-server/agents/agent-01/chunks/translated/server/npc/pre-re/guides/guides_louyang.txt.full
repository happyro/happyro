louyang,213,213,3	script	Soldier#BA::LouGuide	825,{
	mes "[士兵]";
	mes "欢迎来到洛阳，";
	mes "这座拥有悠久而";
	mes "多彩历史的城市。";
	next;
	mes "[士兵]";
	mes "最近我们开辟了海上航线，";
	mes "方便与外国进行";
	mes "友好交流。";
	mes "欢迎各国旅客。";
	next;
	mes "[士兵]";
	mes "洛阳除了丰富的历史，还以各种特产闻名。你能在这里发现许多本地独有的东西。";
	next;
	mes "[士兵]";
	mes "请慢慢游览，";
	mes "尽情享受在洛阳的旅程。";
	mes "祝你玩得开心。";
	next;
	switch(select("询问建筑位置。:清除小地图上的所有标记。:取消。")) {
	case 1:
		mes "[士兵]";
		mes "你想去哪里？";
		next;
		switch(select("龙城:医生办公室:市政厅:武器商店:道具商店:酒馆:取消")) {
		case 1:
			mes "[士兵]";
			mes "龙城位于^FF3355+^000000，所有贵族包括领主都住在那里。";
			next;
			mes "[士兵]";
			mes "你是外地人，最好先去拜访我们的领主。";
			viewpoint 1,218,255,2,0xFF3355;
			break;
		case 2:
			mes "[士兵]";
			mes "我们有一位医术高超的医生。";
			mes "她的办公室在^CE6300+^000000。";
			next;
			mes "[士兵]";
			mes "据说没有她治不好的病。";
			mes "不过这话是真是假，我可不敢保证。";
			viewpoint 1,263,94,3,0xCE6300;
			break;
		case 3:
			mes "[士兵]";
			mes "市政厅是联邦政府办公的地方。";
			mes "它位于^A5BAAD+^000000。";
			next;
			mes "[士兵]";
			mes "如果遇到问题，";
			mes "可以和市政厅的工作人员";
			mes "谈谈。";
			viewpoint 1,309,80,4,0xA5BAAD;
			break;
		case 4:
			mes "[士兵]";
			mes "武器商店位于^55FF33+^000000。";
			next;
			mes "[士兵]";
			mes "你能看到洛阳经验丰富的";
			mes "铁匠们锻造的";
			mes "精美武器。";
			mes "一定会让你大开眼界。";
			viewpoint 1,145,174,5,0x55FF33;
			break;
		case 5:
			mes "[士兵]";
			mes "道具商店位于^3355FF+^000000。";
			next;
			mes "[士兵]";
			mes "知己知彼，百战不殆！";
			mes "提前准备总比事后后悔安全。去看看他们的补给吧？";
			mes "旅行时会派上用场。";
			viewpoint 1,135,98,6,0x3355FF;
			break;
		case 6:
			mes "[士兵]";
			mes "旅途中累了，我建议你去酒馆。它位于^00FF00+^000000。";
			next;
			mes "[士兵]";
			mes "酒馆是认识其他游客的好地方，";
			mes "也能听到一些有用的消息。";
			viewpoint 1,280,167,7,0x00FF00;
			break;
		case 7:
			mes "[士兵]";
			mes "如果想清除小地图上的所有标记，";
			mes "请从菜单选择‘清除小地图上的所有标记。’";
		}
		break;
	case 2:
		viewpoint 2,218,255,2,0xFF00FF;
		viewpoint 2,263,94,3,0xFF00FF;
		viewpoint 2,309,80,4,0xFF00FF;
		viewpoint 2,145,174,5,0xFF00FF;
		viewpoint 2,135,98,6,0xFF00FF;
		viewpoint 2,280,167,7,0xFF00FF;
		mes "[士兵]";
		mes "好了，我已经清除小地图上的所有标记。";
		break;
	case 3:
		mes "[士兵]";
		mes "有时自己探索也很有趣。";
		mes "偶尔也可以自己去探索。";
		mes "路上小心。";
	}
	close;
}

louyang,160,175,3	duplicate(LouGuide)	Soldier#BB	825

louyang,224,104,3	script	Representative#lou	818,{
	mes "[代表]";
	mes "欢迎来到洛阳，";
	mes "这片古老土地拥有";
	mes "充满勇者传说的";
	mes "悠久历史。";
	next;
	mes "[代表]";
	mes "我们现在开辟了海上航线，方便外国旅客和文化交流，让所有人受益。";
	next;
	mes "[代表]";
	mes "洛阳以丰富的历史闻名，";
	mes "也有许多本国独有的特产。请慢慢游览，享受在这里的时光。";
	next;
	switch(select("询问建筑位置。:清除小地图上的所有标记。:取消。")) {
	case 1:
		set .@compass_check,1;
		mes "[代表]";
		mes "你想去哪里？";
		next;
		switch(select("龙城:医生办公室:市政厅:武器商店:道具商店:酒馆:取消")) {
		case 1:
			mes "[代表]";
			mes "龙城位于^FF3355+^000000，所有贵族包括领主都住在那里。";
			next;
			mes "[代表]";
			mes "你是外地人，最好先去拜访我们的领主。";
			viewpoint 1,218,255,2,0xFFFF33;
			break;
		case 2:
			mes "[代表]";
			mes "我们有一位医术高超的医生。";
			mes "她的办公室在^CE6300+^000000。";
			next;
			mes "[代表]";
			mes "据说没有她治不好的病。";
			mes "不过这话是真是假，我可不敢保证。";
			viewpoint 1,263,94,3,0xFFCE63;
			break;
		case 3:
			mes "[代表]";
			mes "市政厅是联邦政府办公的地方。";
			mes "它位于^A5BAAD+^000000。";
			next;
			mes "[代表]";
			mes "如果遇到问题，";
			mes "可以和市政厅的工作人员";
			mes "谈谈。";
			viewpoint 1,309,80,4,0xFF00FF;
			break;
		case 4:
			mes "[代表]";
			mes "武器商店位于^55FF33+^000000。";
			next;
			mes "[代表]";
			mes "你能看到洛阳经验丰富的";
			mes "铁匠们锻造的";
			mes "精美武器。";
			mes "一定会让你大开眼界。";
			viewpoint 1,145,174,5,0xFF55FF;
			break;
		case 5:
			mes "[代表]";
			mes "道具商店位于^3355FF+^000000。";
			next;
			mes "[代表]";
			mes "知己知彼，百战不殆！";
			mes "提前准备总比事后后悔安全。去看看他们的补给吧？";
			mes "旅行时会派上用场。";
			viewpoint 1,135,98,6,0xFF3355;
			break;
		case 6:
			mes "[代表]";
			mes "旅途中累了，我建议你去酒馆。它位于^00FF00+^000000。";
			next;
			mes "[士兵]";
			mes "酒馆是认识其他游客的好地方，";
			mes "也能听到一些有用的消息。";
			viewpoint 1,280,167,7,0xFF00FF;
			break;
		case 7:
			mes "[代表]";
			mes "如果想清除小地图上的所有标记，";
			mes "请从菜单选择‘清除小地图上的所有标记。’";
		}
		break;
	case 2:
		viewpoint 2,218,255,2,0xFF00FF;
		viewpoint 2,263,94,3,0xFF00FF;
		viewpoint 2,309,80,4,0xFF00FF;
		viewpoint 2,145,174,5,0xFF00FF;
		viewpoint 2,135,98,6,0xFF00FF;
		viewpoint 2,280,167,7,0xFF00FF;
		mes "[代表]";
		mes "完成！小地图上的所有标记都已清除。";
		break;
	case 3:
		mes "[代表]";
		mes "我明白你想探索洛阳，亲自看看这里的风景。";
		mes "那么，路上小心！";
		break;
	}
	close;
}

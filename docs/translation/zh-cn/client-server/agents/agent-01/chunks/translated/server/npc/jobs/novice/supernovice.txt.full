//= Super Novice Job Change Npc
//= Super Novice Cart Rental Npc
//= Some Other Useless Super Novice Npc
//===== Additional Comments: ================================= 
//= 1.9 Rescripted to the Aegis 10.3 Standars. [Samuray22]
//= 2.0 Rescripted again, this time using an iRO base. [L0ne_W0lf]
//= 2.1 Swapped use of baseclass for basejob. [L0ne_W0lf]
//= 2.2 Added Quest Log commands. [Kisuka]
//= 2.3 NPC "Esseray" calls Ex. Super Novice script when enabled. [Euphy]
//= 2.4 Added an Ex. Super Novice dialog check. [Euphy]
//============================================================ 

aldeba_in,223,167,3	script	Tzerero#sn	709,{
	if (BaseJob == Job_Super_Novice) {
		mes "[特泽罗]";
		mes "我相信你很享受";
		mes "超级初心者的生活？啊，";
		mes "很好很好……正如我所料。";
		mes "确实，平庸之光正在你体内耀眼闪烁……";
		next;
		mes "[特泽罗]";
		mes "我鼓励你像";
		mes "金木尚先生那样生活……";
		mes "成为万事通……";
		mes "……却样样不精。";
		close;
	}
	if (countitem(938) > 29 && countitem(907) > 29 && SUPNOV_Q == 1) {
		delitem 938,30; //Sticky_Mucus
		delitem 907,30; //Resin
		mes "[特泽罗]";
		mes "啊，你带来了我要求的";
		mes "物品！";
		mes "你证明了自己";
		mes "值得加入我们的";
		mes "超级初心者协会。";
		next;
		mes "[特泽罗]";
		mes "那么，如约我会";
		mes "将你的职业变成";
		mes "^3355FF超级初心者——^000000嗯？";
		mes "你身后那是什么？";
		next;
		select("嗯？:那是什么？");
		mes "^3355FF你回头看，但……";
		mes "那里什么也没有。";
		mes "这里一定有古怪！^000000";
		next;
		completequest 6010;
		callfunc "F_ClearJobVar";
		getitem 2339,1; //G_Strings
		if (Upper==0) jobchange Job_Super_Novice;
		if (Upper==2) jobchange Job_Super_Baby;
		mes "[特泽罗]";
		mes "哇哈！骗到你了！";
		mes "怎么样……喜欢我的玩笑吗？";
		mes "算了，忘了吧……";
		next;
		mes "[特泽罗]";
		mes "还有什么理由会让";
		mes "像我这样的成年男子";
		mes "随身携带";
		mes "一条内裤。";
		next;
		mes "[特泽罗]";
		mes "重要的是……";
		mes "你已加入尊贵的";
		mes "超级初心者行列。";
		next;
		mes "[特泽罗]";
		mes "把这条内裤当作礼物吧……";
		mes "据说这件衣物";
		mes "曾被金木尚先生穿过，";
		mes "这位传奇协会创始人年轻时";
		mes "努力追求";
		mes "卓越的平庸。";
		next;
		mes "[特泽罗]";
		mes "出去享受";
		mes "超级初心者的新生活！勇敢前行";
		mes "帮助普通人，";
		mes "同时也成为普通人！";
		mes "";
		close;
	}
	if (SUPNOV_Q == 1) {
		mes "[特泽罗]";
		mes "嗯？忘了我";
		mes "想要什么吗？好吧，";
		mes "我再告诉你一次。";
		mes "请这次记住";
		mes "……";
		next;
		mes "[特泽罗]";
		mes "我要你带来";
		mes "^FF000030 30 个黏液^000000 和";
		mes "^FF000030 树脂^000000。";
		close;
	}
	if (BaseJob == Job_Novice && Upper != 1) {
		mes "[特泽罗]";
		mes "……嗯？";
		mes "停下。";
		mes "让我看看你。";
		next;
		mes "[特泽罗]";
		mes ".....";
		mes ".......";
		mes ".........";
		emotion ET_THINK;
		next;
		mes "[特泽罗]";
		mes "我看见";
		mes "平庸之光";
		mes "在你体内闪耀……";
		next;
		mes "[特泽罗]";
		mes "何不加入我们，";
		mes "年轻的初心者？加入我们";
		mes "学习";
		mes "成为平庸者的";
		mes "微妙伟大……";
		next;
		mes "[特泽罗]";
		mes "接受我的提议……";
		mes "脱下你的";
		mes "棕色尘土衣物";
		mes "蜕变为……";
		next;
		mes "[特泽罗]";
		mes "……^CE6300超级初心者^000000。";
		next;
		switch(select("接受他的提议。:拒绝他的提议。:仔细听。")) {
		case 1:
			if (!callfunc("F_CanChangeJob")) {
				mes "[特泽罗]";
				mes "嗯……但你真的";
				mes "理解";
				mes "从弱点中";
				mes "发现力量的价值吗？你必须";
				mes "向我证明你";
				mes "是真正的平庸者。";
				next;
				mes "[特泽罗]";
				mes "以初心者身份生活……";
				mes "当你";
				mes "掌握";
				mes "基础技能后回来……";
				mes "在平庸中成长，";
				mes "成为 10 级初心者……";
				close;
			}
			if (BaseLevel < 45) {
				mes "[特泽罗]";
				mes "嗯……但你真的";
				mes "珍视平凡冒险者的";
				mes "轻松生活吗？";
				mes "向我证明你不";
				mes "渴求力量……";
				next;
				mes "[特泽罗]";
				mes "平凡地生活……";
				mes "成为 45 级初心者……";
				mes "那时你就能加入我们……";
				close;
			}
			mes "[特泽罗]";
			mes "我能从你的眼中看到";
			mes "你决心";
			mes "过简单生活……";
			next;
			mes "[特泽罗]";
			mes "只有真正明智的人才能";
			mes "看出普通和平凡";
			mes "是最好的";
			mes "生活方式。";
			next;
			mes "[特泽罗]";
			mes "不过，我们不会接纳";
			mes "任何人加入协会。";
			mes "你必须先通过我们的";
			mes "资格测试。";
			next;
			mes "[特泽罗]";
			mes "测试中，你必须";
			mes "带来一些物品，它们";
			mes "由普通、";
			mes "不起眼的怪物掉落。";
			next;
			mes "[特泽罗]";
			mes "嗯嗯嗯……";
			mes "^FF000030黏液^000000";
			mes "以及 ^FF00003030 个树脂^000000，";
			mes "^000000正好可以测试你";
			mes "对抗弱小敌人的能力。";
			next;
			mes "[特泽罗]";
			mes "另外，数字 30";
			mes "很重要。它不";
			mes "特别……只是";
			mes "一个普通数字。";
			mes "哈哈哈哈哈~";
			next;
			set SUPNOV_Q,1;
			setquest 6010;
			mes "[特泽罗]";
			mes "祝你好运，朋友。";
			close;
		case 2:
			mes "[特泽罗]";
			mes "哎呀……我想";
			mes "简单生活的价值";
			mes "对你来说很难";
			mes "理解。没关系……";
			mes "你的人生由你自己决定。";
			next;
			mes "[特泽罗]";
			mes "但如果你有一天看见";
			mes "平凡之光，欢迎";
			mes "随时来找我";
			mes "……";
			next;
			mes "[特泽罗]";
			mes "随着初心者俱乐部";
			mes "越来越受欢迎，";
			mes "获得更多追随者，";
			mes "我们可能会考虑使用";
			mes "更难的测试……";
			close;
		case 3:
			mes "[特泽罗]";
			mes "初心者协会由";
			mes "传奇的";
			mes "金木尚先生创立……也许他是";
			mes "我们这一代最伟大的人。";
			next;
			mes "[特泽罗]";
			mes "他意识到";
			mes "世界上有许多苦难，";
			mes "尤其是";
			mes "米德加尔特";
			mes "普通人……";
			next;
			mes "[特泽罗]";
			mes "他从遇到的不同人们那里";
			mes "学会许多技能，";
			mes "但因为他不";
			mes "在一个地方久留，";
			mes "他成为万事通";
			mes "……却样样不精。";
			next;
			mes "[特泽罗]";
			mes "通过分担";
			mes "普通人的痛苦，他";
			mes "也成为其中一员……";
			mes "最伟大的普通";
			mes "人。";
			next;
			mes "[特泽罗]";
			mes "协会成员";
			mes "努力像金木尚先生一样生活。";
			mes "金木尚先生正是如此，按照";
			mes "他留下的原则……";
			close;
		}
	}
	else {
		if (BaseJob == Job_Super_Novice) {
			mes "[特泽罗]";
			mes "作为超级初心者，";
			mes "你喜欢简单地生活";
			mes "吗？我相信你";
			mes "一定很享受~";
			next;
			mes "[特泽罗]";
			mes "请成长为超级初心者，";
			mes "帮助普通人，";
			mes "同时成为";
			mes "其中一员……";
			next;
			mes "[特泽罗]";
			mes "我鼓励你";
			mes "在超级初心者之道上成长，";
			mes "并以";
			mes "过着";
			mes "极其";
			mes "平凡的生活为榜样。";
			close;
		}
		mes "[特泽罗]";
		mes "你好，我是特泽罗，";
		mes "伟大初心者协会的";
		mes "非官方执行董事。";
		mes "初心者协会。";
		next;
		mes "[特泽罗]";
		mes "嗯……你似乎远";
		mes "高于普通人。";
		mes "是的，你绝对更";
		mes "比起普通，你更‘非凡’";
		mes "‘普通……’";
		next;
		mes "[特泽罗]";
		mes "*叹气* 我想你";
		mes "无法理解";
		mes "我们的生活方式、";
		mes "平凡中的微妙伟大。但";
		mes "没关系。";
		mes "";
		next;
		mes "[特泽罗]";
		mes "世界上有成千上万";
		mes "不同的人，所以我会试着";
		mes "接受";
		mes "所有差异。";
		mes "希望你也能做到。";
		close;
	}
}

aldeba_in,216,169,5	script	Esseray#sn	86,{
	if (Class == Job_Super_Novice_E || Class == Job_Super_Baby_E) {
		mes "[埃瑟雷]";
		mes "你！比以前更强。";
		mes "我就知道你能通过测试~";
		close;
	}
	if (BaseJob == Job_Super_Novice) {
		if (checkre(0))
			callfunc "Esseray_Ex";
		mes "[埃瑟雷]";
		mes "嗯？嘿，你是";
		mes "伟大初心者协会成员，";
		mes "对吧？这不是";
		mes "最棒的协会吗？！";
		next;
		mes "[埃瑟雷]";
		mes "平凡地生活，";
		mes "遵循";
		mes "金木尚先生的原则……";
		mes "做普通人真好！";
		next;
		mes "[埃瑟雷]";
		mes "让我们尽量";
		mes "正常地生活！";
		mes "顺便说，我是";
		mes "第一号成员，";
		mes "当然是在特泽罗先生";
		mes "领导下！";
		close;
	}
	if (BaseJob == Job_Novice && Upper != 1) {
		mes "[埃瑟雷]";
		mes "哈~你还不了解";
		mes "如何做普通人！";
		mes "何不加入我们的初心者";
		mes "协会？这是世界上最棒的协会~";
		next;
		mes "[埃瑟雷]";
		mes "没错，超级初心者";
		mes "是最棒的角色！";
		mes "哈哈哈哈哈哈！";
		close;
	}
	else {
		mes "[埃瑟雷]";
		mes "呸~！你比普通人";
		mes "更优秀……甚至可能";
		mes "是“特别”的。";
		mes "真遗憾！不过……";
		mes "希望你仍然";
		mes "积极生活。";
		close;
	}
}

aldebaran,54,238,5	script	Kafra Employee#sn	117,{
	if (BaseJob == Job_Super_Novice) {
		mes "[卡普拉员工]";
		if (Sex == SEX_MALE)
			mes "你好，超级初心者先生~";
		else
			mes "你好，超级初心者女士。";
		mes "其他卡普拉员工不让你租车，";
		mes "你一定很失望。";
		mes "";
		mes "";
		mes "不过现在别担心……";
		next;
		mes "[卡普拉员工]";
		mes "我会通过提供手推车";
		mes "来支持你们……";
		next;
		mes "[卡普拉员工]";
		mes "^3355FF*低声说*^000000";
		mes "^555555我本不该这样做，";
		mes "因为这违反我们的";
		mes "公司政策。但我很";
		mes "同情超级初心者，";
		mes "……所以我来了。^000000";
		next;
		mes "[卡普拉员工]";
		mes "总之，要租手推车吗？服务费是 1,900 Zeny。";
		next;
		if (select("租用手推车。:取消。") == 1) {
			mes "[卡普拉员工]";
			mes "哦，是这样的……";
			mes "你学会“手推车”";
			mes "技能吗？我可以租给你";
			mes "手推车，但如果没学会";
			mes "推动它，";
			mes "只是在浪费 Zeny。";
			next;
			mes "[卡普拉员工]";
			mes "务必先学会“手推车”";
			mes "技能。";
			next;
			if (select("租用手推车。:取消。") == 1) {
				if (checkcart()) {
					mes "[卡普拉员工]";
					mes "哦，你已经装备手推车了。";
					close;
				}
				if (Zeny >= 1899) {
					set RESRVPTS, RESRVPTS + 190;
					set Zeny, Zeny-1900;
					if (getskilllv("MC_PUSHCART") > 0) setcart;
					mes "[卡普拉员工]";
					mes "感谢使用我的服务。";
					mes "虽然我这样做可能";
					mes "对其他卡普拉员工来说不合规，";
					mes "但我坚信这是";
					mes "为顾客做正确的事。";
					close;
				}
				else {
					mes "[卡普拉员工]";
					mes "抱歉，你没有足够的 Zeny。服务费为 1,900 Zeny。";
					close;
				}
			}
			mes "[卡普拉员工]";
			mes "欢迎再次光临。";
			mes "感谢使用我的服务。";
			close;
		}
		mes "[卡普拉员工]";
		mes "欢迎再次光临。";
		mes "感谢使用我的服务。";
		close;
	}
	mes "[卡普拉员工]";
	mes "祝你……哎呀……！";
	mes "我想我无法提供你想要的";
	mes "服务……";
	mes "请去找其他卡普拉员工。";
	mes "我为给你带来不便";
	mes "深表歉意……";
	close;
}


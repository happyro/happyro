				mes "[Phong in Mumbaki]";
				mes "不是已经做好了吗？";
				mes "你手里拿的是什么？";
				mes "为什么还站在这里？去把那些花送出去。";
				close;
			}
			if ((countitem(6509) < 3) || (countitem(6510) < 3) || (countitem(6511) < 3)) {
				mes "[Phong in Mumbaki]";
				mes "要去迪瓦塔？";
				mes "你需要神秘之花、优雅之花和美丽之花各 3 朵，明白吗？";
				mes "花准备好后我就制作。";
				close;
			}
			mes "[Phong in Mumbaki]";
			mes "迪瓦塔不过是个女人。";
			mes "而你每天去找她也真够奇怪的。";
			next;
			mes "[Phong in Mumbaki]";
			mes "嘿，花束在这里。";
			mes "用你的灵魂献上供奉，祈愿今天有所收获。";
			delitem 6509, 3; // Mysterious_Flower
			delitem 6510, 3; // Elegant_Flower
			delitem 6511, 3; // Beautiful_Flower
			getitem 6506, 1; // Memorial_Bouquet
			close;
		}
	}
}

malaya,169,350,5	script	Imelda#malaya	475,{
	if (MaxWeight - Weight < 1000 || checkweight(1201,1) == 0) {
		mes "- 无法继续任务。你携带的物品太多了。-";
		close;
	}
	if (malaya_hi < 10) {
		mes "[Imelda]";
		mes "……嗯。";
		close;
	} else if (malaya_hi < 20) {
		mes "[Imelda]";
		mes "……";
		mes "还不错。";
		mes "我会盯着你的。看看你在这个镇上能做得怎么样……*轻笑*";
		next;
		mes "- 她是个相当烦人的小女孩。-";
		close;
	} else if (malaya_hi == 20) {
		mes "[Imelda]";
		mes "你不就是那个用廉价的外国圣物赢得村民好感的英雄吗？";
		mes "有什么事？";
		next;
		select ("你想制作传统的精神护符？");
		mes "[Imelda]";
		mes "是的。我祖父找到了方法。";
		mes "我要制作它。";
		next;
		mes "[Imelda]";
		mes "这是我的工作，不是别人的。";
		mes "保护传统就是我的职责。";
		next;
		switch (select("是这样吗？:祝你好运！")) {
		case 1:
			if (BaseLevel < 100) {
				mes "[Imelda]";
				mes "当然。";
				mes "向像你这样……弱小的人求助，可不是什么好主意。";
				next;
				mes "[Imelda]";
				mes "收集材料没听起来那么容易。";
				mes "也许等你变强后可以，但现在不行，永远不行。";
				close;
			}
			mes "[Imelda]";
			mes "那又怎样？你要去收集材料？";
			mes "好吧，我接受你的提议。";
			next;
			select ("……？！");
			mes "[Imelda]";
			mes "既然你这么想帮我，为什么一开始不说？";
			mes "或者去问我的祖父？";
			next;
			mes "[Imelda]";
			mes "既然你这么热衷于制作精神护符，";
			mes "我也只能放弃了，不是吗？";
			next;
			mes "[Imelda]";
			mes "现在需要的材料是^4d4dff6 根削尖竹子、6 袋盐和 6 个银十字架^000000。";
			next;
			mes "[Imelda]";
			mes "你必须在西北海滩自己制作盐。";
			mes "那里有我挖好的盐坑。";
			next;
			mes "[Imelda]";
			mes "去武器店找潘多伊制作银十字架。";
			mes "他答应帮我做一些。";
			next;
			mes "[Imelda]";
			mes "削尖竹子可以在巴里奥或附近的森林取得。";
			mes "都记住了吗？";
			next;
			mes "[Imelda]";
			mes "现在是证明你实力的时候了！";
			set malaya_hi, 21;
			setquest 7366;
			close;
		case 2:
			mes "[Imelda]";
			mes "没错。";
			mes "我会保护村庄！";
			next;
			mes "[" + strcharinfo(0) + "]";
			mes "我还没见过用那些材料制作的精神护符呢！";
			mes "真有意思～";
			mes "我相信你一定能做好～";
			mes "哈哈哈哈～";
			next;
			mes "[Imelda]";
			mes "别烦我，走开！";
			close;
		}
	} else if (malaya_hi == 21) {
		if ((countitem(6501) < 6) || (countitem(6500) < 6) || (countitem(6502) < 6)) {
			mes "[Imelda]";
			mes "如果你带齐制作精神护符的所有材料，我就认可你的能力！";
			next;
			mes "[Imelda]";
			mes "在西北海滩制作盐，巴里奥·马希瓦加生长着竹子。";
			mes "请潘多伊制作银十字架。";
			mes "别忘了每样收集 6 个。";
			close;
		}
		mes "[Imelda]";
		mes "……哦……天啊，你真的收集齐了？";
		mes "你比我想的要强。";
		mes "这可完全不是在夸你！";
		next;
		mes "[Imelda]";
		mes "现在我要举行神圣仪式，制作传统精神护符。";
		mes "把材料给我！仪式期间别来打扰我！";
		set malaya_hi, 22;
		delitem 6500, 6; // Sharp_Bamboo
		delitem 6501, 6; // Salt_Bag
		delitem 6502, 6; // Silver_Cross
		erasequest 7366;
		setquest 7367;
		close;
	} else if (malaya_hi == 22) {
		.@playtime = checkquest(7367, PLAYTIME);
		if (.@playtime == 0 || .@playtime == 1) {
			mes "伊梅尔达正在进行仪式，气氛虔诚，和她之前破口大骂时完全不同。";
			mes "最好别打扰她。";
			close;
		} else if (.@playtime == 2) {
			mes "[Imelda]";
			mes "还在这里？";
			mes "当然，你想看看我的精神护符比那个廉价圣物好多少。";
			next;
			mes "[Imelda]";
			mes "好吧。";
			mes "现在把这些精神护符交给大家！";
			mes "你完全有资格这么做！";
			mes "*咯咯笑*";
			next;
			mes "尽管她的逻辑和活力都很荒唐，你还是拿到了精神护符。";
			mes "把它们交给村民吧。";
			set malaya_hi, 23;
			getitem 6503, 6; // Soul_Protection
			erasequest 7367;
			setquest 7368;
			setquest 7369;
			setquest 7370;
			setquest 7371;
			setquest 7372;
			setquest 7373;
			setquest 7374;
			close;
		} else {
			mes "[Imelda]";
			mes "别打扰仪式，走开。";
			mes "请等我制作精神护符。";
			setquest 7367;
			close;
		}
	} else if (malaya_hi == 23) {
		mes "[Imelda]";
		mes "名单上列着需要精神护符的人。";
		mes "去把新的精神护符交给他们。";
		next;
		mes "[Imelda]";
		mes "像你这么善良的人一定会做到，对吧？";
		mes "*坏笑*";
		close;
	} else if (malaya_hi == 24) {
		mes "[Imelda]";
		mes "……你真的做了我拜托的事？";
		mes "你知道吗？我放弃了。";
		mes "我还以为你甜言蜜语拿到东西后就会离开这个镇子……";
		next;
		mes "[Imelda]";
		mes "我为自己的无礼道歉。";
		mes "……这是道歉礼物。";
		next;
		mes "[Imelda]";
		mes "如果你能帮我，我会很高兴，因为精神护符每天都需要制作。";
		set malaya_hi, 25;
		erasequest 7374;
		erasequest 7379;
		setquest 7375;
		if (!VIP_SCRIPT || vip_status(VIP_STATUS_ACTIVE))
			getitem 6497, 2; // Lesser_Agimat
		else
			getitem 6497, 1; // Lesser_Agimat
		getexp 200000,200000;
		if (rand(2))
			$malayaNames$[0] = strcharinfo(0);
		close;
	} else {
		mes "[Imelda]";
		mes "你好。";
		mes "你喜欢马来亚的风景吗？";
		mes "在吉普尼上和朋友聊天很惬意。";
		next;
		switch (select("我来帮你制作精神护符。:爱与精神护符属于所有人。")) {
		case 1:
			if (checkquest(7380) > -1) {
				if ((countitem(6501) < 6) || (countitem(6502) < 6) || (countitem(6500) < 6)) {
					mes "[Imelda]";
					mes "制作精神护符需要的材料是";
					mes "盐袋、银十字架和削尖竹子，各 6 个。";
					next;
					mes "[Imelda]";
					mes "盐来自西北海滩，银十字架找潘多伊，削尖竹子在巴里奥附近取得。";
					close;
				}
				mes "[Imelda]";
				mes "没错，你收集得很准确。谢谢你的帮助。";
				next;
				mes "[Imelda]";
				mes "如果你明天还能再帮忙就好了。这是给你的辛苦费。";
				delitem 6500, 6; // Sharp_Bamboo
				delitem 6501, 6; // Salt_Bag
				delitem 6502, 6; // Silver_Cross
				erasequest 7380;
				setquest 7381;
				if (!VIP_SCRIPT || vip_status(VIP_STATUS_ACTIVE))
					getitem 6497, 2; // Lesser_Agimat
				else
					getitem 6497, 1; // Lesser_Agimat
				getexp 200000,200000;
				close;
			} else {
				.@playtime = checkquest(7381, PLAYTIME);
				if ((.@playtime == 0) || (.@playtime == 1)) {
					mes "[Imelda]";
				mes "谢谢你的好意，但今天的材料够了。需要更多时我会找你。";
					close;
				} else if (.@playtime == 2) {
					mes "[Imelda]";
				mes "你来得正好。今天制作精神护符的材料用完了。";
				mes "现在能去收集吗？";
					erasequest 7381;
					next;
					switch (select("好的。:我需要准备一下。")) {
					case 1:
						mes "[Imelda]";
						mes "那就和往常一样。";
				mes "请带来 6 个盐袋、银十字架和削尖的竹子。";
						setquest 7380;
						close;
					case 2:
						mes "[Imelda]";
						mes "……我明白了。";
					mes "我会等着。";
						close;
					}
				} else {
					mes "[Imelda]";
				mes "真是个好消息。你知道制作精神护符需要什么吗？";
				mes "当然，你已经不是第一次了……";
					next;
					mes "[Imelda]";
				mes "那就交给你了。";
					mes "请带来 6 个盐袋、银十字架和削尖的竹子。";
					setquest 7380;
					close;
				}
			}
		case 2:
			if (checkquest(7374) != -1) {
				if (checkquest(7379) == -1) {
					mes "[Imelda]";
				mes "请把这些新的精神护符交给村民。你知道他们是谁，对吧？";
					close;
				}
				mes "[Imelda]";
			mes "他们不能永远依赖这些精神护符……";
			mes "拥有像你这样坚强的意志会好得多。";
				next;
				mes "[Imelda]";
			mes "坚强的精神充满光明。";
			mes "黑暗之物无法接近这耀眼的光。";
				next;
				mes "[Imelda]";
			mes "今天就到这里吧。非常感谢。";
				setquest 7375;
				erasequest 7374;
				erasequest 7379;
				if (!VIP_SCRIPT || vip_status(VIP_STATUS_ACTIVE))
					getitem 6497, 2; // Lesser_Agimat
				else
					getitem 6497, 1; // Lesser_Agimat
				getexp 200000,200000;
				if (rand(2))
					$malayaNames$[0] = strcharinfo(0);
				close;
			} else {
				.@playtime = checkquest(7375, PLAYTIME);
				if (.@playtime == 0 || .@playtime == 1) {
					mes "[Imelda]";
					mes "之前发放的精神护符仍然有效。";
					mes "现在没关系。";
					close;
				} else if (.@playtime == 2) {
					mes "[Imelda]";
					mes "我正想着你什么时候会来。";
					mes "今天能帮忙把精神护符交给大家吗？";
					erasequest 7375;
					next;
					if (select("当然。:今天不行。") == 2) {
						mes "[Imelda]";
						mes "好吧。";
						mes "今天不如在马来亚散散步？";
						mes "当然，途中还是会遇到一些鬼魂。";
						close;
					}
					if ((checkquest(7381) == 0) || (checkquest(7381) == 1)) {
						mes "[Imelda]";
						mes "非常感谢。";
						mes "全部发完后再回来。";
						setquest 7374;
						setquest 7368;
						setquest 7369;
						setquest 7370;
						setquest 7371;
						setquest 7372;
						setquest 7373;
						getitem 6503, 6; // Soul_Protection
						close;
					} else {
						mes "[Imelda]";
					mes "谢谢你的关心，但我材料用完了，没法制作。";
					mes "真遗憾，不是吗？";
					mes "希望有人愿意帮我收集。";
						close;
					}
				} else {
					mes "[Imelda]";
					mes "你平静下来了吗？我在这里都能感受到你的安宁。";
					mes "你愿意把多余的时间花在我身上吗？";
					next;
					mes "[Imelda]";
					mes "能帮我把这些精神护符交给村民吗？";
					next;
					switch (select("好。:今天不行。") == 2) {
						mes "[Imelda]";
						mes "好吧。";
						mes "今天不如在马来亚散散步？";
						mes "当然，途中还是会遇到一些鬼魂。";
						close;
					}
					if ((checkquest(7381, PLAYTIME) == 0) || (checkquest(7381, PLAYTIME) == 1)) {
						mes "[Imelda]";
						mes "非常感谢。";
						mes "全部发完后再回来。";
						setquest 7374;
						setquest 7368;
						setquest 7369;
						setquest 7370;
						setquest 7371;
						setquest 7372;
						setquest 7373;
						getitem 6503, 6; // Soul_Protection
						close;
					} else {
						mes "[Imelda]";
					mes "谢谢你的关心，但我材料用完了，没法制作。";
					mes "真遗憾，不是吗？";
					mes "希望有人愿意帮我收集。";
						close;
					}
				}
			}
			break;
		}
	}
	end;
}

malaya,181,353,5	script	Old Man Nardo#malaya	574,{
	if (MaxWeight - Weight < 1000 || checkweight(1201,1) == 0) {
		mes "- 携带的物品太多，无法继续任务。-";
		close;
	}
	if (malaya_hi < 10) {
		mes "[Old Man Nardo]";
		mes ".......";
		mes "看来你不是这里的人。我没什么好说的。";
		close;
	} else if (malaya_hi == 10) {
		if (checkquest(7353) == 2) {
			mes "[Old Man Nardo]";
			mes "帮帮我这个可怜的老人怎么样？";
			mes "哪怕只是你衣服的袖子也行，给我一些你的活力。";
			next;
			mes "[Old Man Nardo]";
			mes "你知道，我的时间不多了……";
			mes "帮我安详地走完最后一程。";
			close;
		} else {
			mes "[Old Man Nardo]";
			mes "你……你！！";
			mes "你就是那个拥有强大精神、能击退黑暗鬼魂的年轻人？！";
			mes "能不能……分一些你的精神给我？";
			next;
			mes "[Old Man Nardo]";
			mes "镇上调皮的鬼魂让我睡不好，天下雨时我的背也会痛。";
			next;
			mes "[Old Man Nardo]";
			mes "请把你奇妙的精神分给我一些。";
			mes "给我一颗你的纽扣怎么样？";
			next;
		mes "- 因为你能击退鬼魂，受困扰的村民都想要你的物品。-";
			setquest 7353;
			completequest 7353;
			if ((checkquest(7352) + checkquest(7353) + checkquest(7354) + checkquest(7355) + checkquest(7356) + checkquest(7357)) > 9) {
				next;
			mes "- 已经有很多人向你提出同样请求。也许最好去和姆巴基的丰格谈谈。-";
				set malaya_hi, 11;
				setquest 7358;
			}
			close;
		}
	} else if (malaya_hi == 11) {
		mes "[" + strcharinfo(0) + "]";
		mes "现在去找他的话，他会把我的纽扣都扒走。";
		mes "必须先和姆巴基商量！";
		close;
	} else if (malaya_hi == 12) {
		if (checkquest(7360) != -1) {
			mes "[Old Man Nardo]";
			mes "老实说，我不相信这个圣物有什么能力。";
			mes "它只是让人安心。";
			next;
			mes "[Old Man Nardo]";
			mes "不过现在我对你改观了。仅仅因为是外来者就排斥他人，似乎不太好。";
			mes "抱歉之前无视了你。";
			close;
		}
		if (!countitem(523) || !countitem(717)) {
		mes "^4d4dff准备并交出蓝色魔力矿石和圣水。^000000";
			close;
		}
		mes "[Old Man Nardo]";
		mes "那么，你改变主意，愿意分享你的精神了吗？";
		next;
		select("交出准备好的物品。");
		mes "[Old Man Nardo]";
		mes "啊……谢谢你。";
		mes "现在我可以安心一阵子了……";
		mes "……平静总是好事。是的。";
		next;
		mes "- 你把圣水和蓝色魔力矿石交给了纳尔多老人。-";
		delitem 717, 1; //Blue_Gemstone
		delitem 523, 1; //Holy_Water
		setquest 7360;
		completequest 7360;
		if ((checkquest(7359) + checkquest(7360) + checkquest(7361) + checkquest(7362) + checkquest(7363) + checkquest(7364)) > 11) {
			mes "- 随着最后一位老人收到圣物，足够数量的圣物已经分发完毕。-";
			set malaya_hi, 13;
			erasequest 7351;
			setquest 7365;
		}
		close;
	} else if ((malaya_hi > 12) && (malaya_hi < 20)) {
		mes "[Old Man Nardo]";
		mes "老实说，我不相信这个圣物有什么能力。";
		mes "它只是让人安心。";
		next;
		mes "[Old Man Nardo]";
		mes "你有时间时，能帮我一件事吗？";
		mes "我现在没事……我是说以后。";
//
//
//
//
//
//
//
//
//

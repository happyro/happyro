			mes "[Bouy]";
		mes "不过他们还没有回来。";
		mes "他们现在一定快用完布拉迪姆了。";
		mes "这可不妙。";
			next;
			mes "[Bouy]";
		mes "最糟糕的情况是，他们可能根本回不了村子。";
			next;
			mes "[" + strcharinfo(0) + "]";
		mes "还有别的办法吗？";
			next;
			mes "[Bouy]";
		mes "精炼大型布拉迪姆矿石需要很多时间，但小块布拉迪姆会快得多。";
			next;
			mes "[Bouy]";
		mes "这片区域到处都能收集布拉迪姆矿石，但精炼小块的效果较差。";
			next;
			mes "[Bouy]";
		mes "你可以从附近的魔物身上轻松收集^f57d7d布拉迪姆碎片^000000。";
			next;
			mes "[Bouy]";
		mes "大约^f57d7d30 个布拉迪姆碎片^000000就足够分给 6 个人。";
			set ep13_3_bra, 6;
			changequest 11173,11174;
			close;
		}
		else if (ep13_3_bra == 6) {
			if (countitem(6319) > 29) {
				mes "[Bouy]";
				mes "你带回布拉迪姆了。";
				mes "我是文克尼克，不擅长战斗，所以一直在等加尔滕斯回来。非常感谢。";
				next;
				mes "[Bouy]";
				mes "手工精炼布拉迪姆碎片比使用机器快得多。我只需要两小时就能完成。"; //Official: "an hour", but gives 2-hour quest.
				next;
				mes "[Bouy]";
				mes "请去休息吧，我要开始工作了。";
				delitem 6319,30; //Small_Bradium
				changequest 11174,11175;
				set ep13_3_bra, 7;
				close;
			}
			mes "[Bouy]";
			mes "这片区域到处都能收集布拉迪姆矿石，但精炼小块的效果较差。";
			next;
			mes "[Bouy]";
			mes "你可以从附近的魔物身上轻松收集^f57d7d布拉迪姆碎片^000000。";
			next;
			mes "[Bouy]";
			mes "大约^f57d7d30 个布拉迪姆碎片^000000就足够分给 6 个人。";
			close;
		}
		else if (ep13_3_bra == 7) {
			if (checkquest(11175,PLAYTIME) > 1) {
				mes "[Bouy]";
				mes "完成了！";
				mes "我很久没做手工了，虽然有点紧张，但我觉得做得不错。";
				mes "请把这些带给他们。";
				set ep13_3_bra, 8;
				changequest 11175,11176;
				close;
			}
			mes "[Bouy]";
			mes "我还在工作，请再休息一会儿。";
			close;
		}
		mes "[Bouy]";
	mes "萨帕无法生存，除非持续摄取布拉迪姆。";
	mes "所以我们需要在村子各处设置注入布拉迪姆的空间。";
		next;
		mes "[Bouy]";
	mes "但在村外工作的人无法经常回来补充布拉迪姆，所以我们提供便携式布拉迪姆。";
		next;
		mes "[Bouy]";
	mes "不过最近马努克地区的布拉迪姆开采出了问题，我们的补给短缺，已经没有足够的可以发放了。";
		next;
		mes "[Bouy]";
	mes "所以许多在村外工作的皮欧姆都回来领取更多补给，";
		next;
		mes "[Bouy]";
	mes "而运输所花的时间拖慢了工作进度。";
		next;
		mes "[Bouy]";
	mes "说实话，运输时间单独看没什么，但最终会累积起来。";
		next;
		mes "[Bouy]";
	mes "我们称之为^f57d7d奶油效应^000000。";
		close;
	}
	mes "[Bouy]";
	mes "⊂⊆￢ ⊃ ∪∝∽ ⊂"; 
	mes "∽∪⊆ ⊃";
	mes "∋∽∋ ∫";
	close;
}

// Sapha's Visit
//============================================================
-	script	Expedition#ep133_is	-1,{
	if (ep13_3_invite) {
		if (compare(strnpcinfo(1),"Maha")) {
			mes "[Maha]";
			mes "不过我确实觉得萨帕族过于友善，几乎不自然。";
			mes "应该没事吧。";
			close; 
		}
		mes "[Ben]";
		mes "没什么奇怪的！";
		mes "我也想像你一样，受到许多人的尊敬。";
		next;
		mes "[Ben]";
		mes "如果我在这里好好工作，也能去拜访萨帕，对吧？";
		close; 
	}
	mes "[Ben]";
	mes "嗯。嘿，玛哈，";
	mes "你觉得呢？";
	mes "你觉得他为什么在这里？";
	next;
	mes "[Maha]";
	mes "不知道。没兴趣。";
	next;
	mes "[Ben]";
	mes "你不觉得那家伙很奇怪吗？";
	mes "加入探险队前，我从没见过他的种族。";
	next;
	mes "[Maha]";
	mes "啊，真的吗？";
	mes "那就只有你这么觉得。";
	mes "他在这里一定有原因。";
	next;
	mes "[Ben]";
	mes "................";
	mes "才不是呢……";
	next;
	mes "[Maha]";
	mes "他们可能很快会发布公告。";
	mes "我们只要等公告就行。";
	mes "公告会给我们答案。";
	next;
	if(select("是什么？:保持安静听着。") == 2) {
		mes "[Ben]";
		mes "Hmm...";
		mes "也许是真的，但你是不是想太多了？";
		next;
		mes "[Maha]";
		mes "我不喜欢惹麻烦。";
		mes "我只听从命令。";
		mes "而且没什么异常。";
		next;
		mes "[Maha]";
		mes "据我所知，";
		mes "那个被称为萨帕的树状巨人种族很友善。";
		mes "不会有麻烦的，放松吧。";
		close;
	}
	mes "[Ben]";
	mes "嗯？你听到我们说话了吗？";
	mes "其实没什么，或者说有点什么……";
	mes "所以……";
	next;
	mes "[Ben]";
	mes "派往马努克的研究队员刚回来。";
	mes "但是……";
	next;
	select("但是？");
	mes "[Ben]";
	mes "嗯……他们带着一名马努克使者回来了！";
	mes "……马努克的萨帕。";
	next;
	if (select("他在哪里？！:这是绝密情报吗？！") == 1) {
		mes "[Ben]";
	mes "他现在就在指挥中心。";
	mes "我们应该去那里。";
		close;
	}
	mes "[Ben]";
	mes "请等一下。";
	mes "没有命令要求限制或保密。";
	mes "而且看起来他们是在进行正式访问。";
	next;
	mes "[Ben]";
	mes "现在去指挥中心，也许能了解到一些情况。";
	mes "去找^4d4dff艾罗^000000看看。";
	close;
}
mid_camp,220,246,5	duplicate(Expedition#ep133_is)	Expedition Guard Ben	930
mid_camp,223,246,4	duplicate(Expedition#ep133_is)	Expedition Guard Maha	868

mid_campin,93,114,3	script	Guard Aello#ep133_is03	967,{
	if (ep13_ryu > 99 || ep13_start > 99) {
		if (ep13_3_invite == 0) {
			mes "[Aello]";
			mes "啊，是你。来得正好。";
			mes "我有急事要告诉你。";
			next;
			mes "[Aello]";
			mes "你知道马努克的使者在这里吗？";
			mes "不算什么大秘密，不过……";
			next;
			mes "[Aello]";
			mes "马努克的萨帕想和你谈谈。";
			mes "阿吉夫说探险队的任何人都能见他，不过……";
			mes "我认为应该让经验更丰富的人去。";
			next;
			mes "[Aello]";
			mes "我了解你的能力，";
			mes "也信任你。";
			mes "代表团在二楼右侧的房间里。";
			next;
			mes "[Aello]";
			mes "门前会有卫兵，";
			mes "告诉他你获得了许可即可。";
			mes "他对人类感兴趣，所以交谈时尽量礼貌。";
			set ep13_3_invite, 1;
			setquest 7182;
			close;
		}
		else if (ep13_3_invite == 1) {
			mes "[Aello]";
			mes "就是二楼右侧的房间。";
			mes "房间前有卫兵。";
			mes "告诉他你获得了许可，他就会放你通过。";
			next;
			mes "[Aello]";
			mes "尽量不要透露不必要的信息，";
			mes "只聊些无关紧要的话题。";
			close;
		}
		mes "[Aello]";
		mes "我就知道可以依靠你。";
		mes "你的行动会极大帮助我们拓展领地。";
		close;
	}
	mes "[Aello]";
	mes "我只对灰色真空探险队中";
	mes "最有能力且值得信任的人感兴趣。";
	next;
	mes "[Aello]";
	mes "不过……你是这里的新面孔。";
	mes "嗯……抱歉，你还不行。";
	mes "你得先熟悉这个营地。";
	close;
}

mid_campin,111,120,3	script	Soldier#ep133_is04	852,{
	if (ep13_3_invite == 1) {
		mes "[Soldier]";
		mes "抱歉，这个房间目前禁止访客进入。";
		next;
		if (select("我获得了许可。:是这样吗？") == 1) {
			mes "[Soldier]";
			mes "你有许可？";
			mes "你叫什么名字？";
			mes "谢谢。";
			mes "原来你是" + strcharinfo(0) + "。";
			next;
			mes "[Soldier]";
			mes "你现在可以进去了。";
			close2;
			warp "mid_campin",165,126;
			end;
		}
		mes "[Soldier]";
		mes "没有艾罗的许可，你不能进入。";
		mes "没有例外。";
		close;
	}
	else if (ep13_3_invite > 1) {
		mes "[Soldier]";
		mes "你回来了。";
		mes "你现在和萨帕使者熟悉了吗？";
		mes "我们对你寄予厚望。";
		close2;
		warp "mid_campin",165,126;
		end;
	}
	mes "[Soldier]";
	mes "抱歉。";
	mes "这个房间禁止访客进入。";
	close;
}

function	script	eldicastes_c	{
	switch(getarg(0)) {
		case 1:
			mes "[Hound]";
			mes "我们继续吧……";
			mes "虽然细节已经确定了。";
			next;
			mes "[Vyhannus]";
			mes "啊，对了。";
			mes "我说到哪里了？";
			mes "啊，对了。";
			mes "迪卡斯特斯！";
			mes "迪卡斯特斯是萨帕的首都。";
			next;
			mes "[Vyhannus]";
			mes "一座宛如白雪中闪耀宝石的城市。";
			mes "马努克最初是为开采布拉迪姆而建立的村子。";
			mes "现在迪卡斯特斯已经发展成萨帕的家园。";
			next;
			mes "[Vyhannus]";
			mes "拉维尔拥有迪卡斯特斯的全部权力，";
			mes "并根据马努克的报告作出决定。";
			next;
			mes "[Vyhannus]";
			mes "你们是诞生于不同世界的善良种族，";
			mes "感谢你们的善意，";
			mes "感谢你们帮助并与我们合作。";
			next;
			mes "[Vyhannus]";
			mes "萨帕的代表拉维尔";
			mes "想邀请人类前往迪卡斯特斯，";
			mes "萨帕的首都。";
			next;
			select("邀请？参观？城市？！:亨德，你这是什么意思？");
			mes "[Hound]";
			mes "就是他说的那样。";
			mes "我们的探险队已经帮助萨帕一段时间了。";
			mes "为他们的生存收集布拉迪姆，或者";
			next;
			mes "[Hound]";
			mes "消灭威胁他们的凶猛野兽。";
			mes "…… ……";
			next;
			mes "[Hound]";
			mes "所以作为回报，他们正式邀请我们参观首都。";
			mes "这就是我一直挑选探险队成员，派往萨帕首都迪卡斯特斯的原因。";
			next;
			select("……你的意思是……");
			mes "[Vyhannus]";
			mes "是的。";
			mes "他就是这个意思。";
			mes "阿吉夫离开前也同意了。";
			mes "" + strcharinfo(0) + "，你受邀了。";
			next;
			mes "[Vyhannus]";
			mes "你善良且尊重他人，";
			mes "礼貌、值得信赖，而且最重要的是性格有趣。";
			next;
			mes "[Vyhannus]";
			mes "你非常合适，拉维尔也会认可。";
			mes "所以我才来到这里。";
			next;
			mes "[Vyhannus]";
			mes "我邀请你前往我们的首都迪卡斯特斯。";
			mes "" + strcharinfo(0) + "";
			next;
			select("真没想到。" );
			mes "[Hound]";
			mes "你现在不是应该已经习惯意外了吗？";
			mes "别这样……你又不是新手……哈哈。";
			next;
			mes "[Hound]";
			mes "如果要走，现在就最好。";
			mes "准备好出发后再来找我。";
			mes "我会告诉你任务内容。";
			set ep13_3_invite, 3;
			close;
		case 2:
			mes "[Vyhannus]";
			mes "先去马努克见总护卫阿瓦兰奇。";
			mes "阿瓦兰奇是加尔滕斯，所以会全副武装。";
			mes "你不会认错他的。";
			next;
			mes "[Vyhannus]";
			mes "告诉阿瓦兰奇你是城市的客人，他就会让你通过前往迪卡斯特斯的道路。";
			next;
			mes "[Vyhannus]";
			mes "没有他的批准你无法通过，所以一定要取得许可。";
			mes "有我的推荐，他会让你通过。";
			next;
			mes "[Vyhannus]";
			mes "我有点期待。";
			mes "不知道我们未来的会面会带来什么。";
			mes "只希望不会像半夜的暴风雪一样。";
			set ep13_3_invite, 4;
			changequest 7182,7183;
			close;
		case 3:
			mes "[Hound]";
			mes "我叫亨德。";
			mes "你是应艾罗的请求来的吗？";
			next;
			select("是的。他让我来见萨帕。" );
			mes "[Hound]";
			mes "好。你应该可以和他交谈，对吧？";
			mes "我们先自我介绍吧？";
			mes "这位是……";
			mes ""+strcharinfo(0)+"...";
			next;
			mes "[Vyhannus]";
			mes "我叫维哈努斯。";
			mes strcharinfo(0)+"……？";
			mes "很高兴见到你。";
			next;
			if(select("我也是。:树妖魔物！")==1) {
				mes "[Vyhannus]";
				mes "真不可思议。";
				mes "就像亨德一样，你们人类制作的戒指……";
				mes "就像智慧之戒。";
			}
			else {
				mes "[Hound]";
				mes "你在说什么？";
				mes "太无礼了！";
				next;
				mes "[Vyhannus]";
				mes "哦，魔物？";
				mes "真是新鲜。";
				mes "亨德，没关系。你们人类真有趣。";
				next;
			}
			mes "[Vyhannus]";
			mes "我们直接进入正题吧？";
			mes "我来这里的原因……";
			next;
			mes "[Someone's voice]";
			mes "不好意思，请等一下。";
			enablenpc "Hibba Agip#ep133_is07";
			next;
			mes "[Hound]";
			mes "指挥官！";
			mes "你这么快就来了。";
			mes "发生什么事了吗？";
			emotion ET_HUK, getnpcid(0, "Hound#ep133_is06");
			next;
			mes "[Hibba Agip]";
			mes "嗯？没什么。";
			mes "有什么事吗？";
			mes "你说想派一个值得信任的人，对吧？";
			mes "我想看看艾罗选来的人。";
			next;
			mes "[Hibba Agip]";
			mes "嗯……啊。";
			mes "是你吗？";
			mes "我明白了，和艾罗说的一样。";
			mes "如果是你，我想我们可以放心了。";
			next;
			select("你这是什么意思？");
			mes "[Vyhannus]";
			mes "所以……事情是这样的。";
			mes "过去萨帕和人类之间存在许多差异。";
			next;
			mes "[Vyhannus]";
			mes "你们的种族突然出现后，我们担心会和你们成为敌人，";
			mes "也害怕你们的能力。";
			next;
			mes "[Vyhannus]";
			mes "但你尊重我们萨帕，";
			mes "还为马努克做了许多事。";
			mes "我们开始认识到人类是善良的。";
			next;
			mes "[Hibba Agip]";
			mes "是的，我们付出了努力。";
			mes "我们也试着保持中立。";
			mes "因为作为第三方加强友谊，总比在冲突中选边站更好。";
			next;
			mes "[Hound]";
			mes "嗯……";
			mes "我想也不算完全错误……";
			next;
			mes "[Vyhannus]";
			mes "（维哈努斯微笑）";
			mes "我们已经向拉维尔提到你们人类。";
			mes "拉维尔是辉煌的^4d4dff迪卡斯特斯^000000最高长老。";
			next;
			select("迪卡斯特斯？:拉维尔？");
			mes "[Hibba Agip]";
			mes "啊，抱歉打断你们。";
			mes "我现在得走了。";
			mes "亨德，我认可他。";
			mes "我想他会做得很好。";
			next;
			mes "[Hibba Agip]";
			mes "那就这么定了。";
			mes "还有……对了，你。";
			mes "之后请去隔壁房间见检查员。";
			mes "明白了吗？";
			next;
			mes "[Hibba Agip]";
			mes "我现在要走了。";
			mes "维哈努斯？我之后会再来看你。";
			mes "你和维哈努斯谈完后，应当^4d4dff去见多哈检查员^000000。";
			mes "那么大家再见。";
			set ep13_3_invite, 2;
			set ep13_3_secret, 1;
			setquest 7185;
			next;
			disablenpc "Hibba Agip#ep133_is07";
			emotion ET_PROFUSELY_SWEAT, getnpcid(0, "Hound#ep133_is06");
			emotion ET_PROFUSELY_SWEAT, getnpcid(0, "Sapha from Manuk");
		mes "希巴·阿吉普说完想说的话后，迅速离开了房间。";
		mes "首先，听听维哈努斯的故事吧。";
			close;
		}
}

mid_campin,168,128,3	script	Sapha from Manuk	451,{

					mes "我会把这门课程视为完成。";
					mes "顺便问问，偷窃到底是什么？";
						next;
						switch(select("Stealing other's items!", "Stealing monster's items!", "Stealing other's enemy!", "Don't know.")) {
						case 1:
	mes "[文森特]";
	mes "错了！那样做太可怕了。";
	mes "你不能到处偷别人的东西。";
							cutin "sc_vicente02.bmp", 2;
							next;
							break;
						case 2:
	mes "[文森特]";
	mes "正确！";
	mes "你的记性不错。";
							cutin "sc_vicente03.bmp", 2;
							next;
							break;
						case 3:
	mes "[文森特]";
	mes "你喜欢做那种事？";
	mes "那样做太可怕了。";
							next;
							break;
						case 4:
							break;
						}
						cutin "sc_vicente01.bmp", 2;
	mes "[文森特]";
	mes "没错，我们偷窃魔物的物品。";
	mes "技能等级和命中率越高，成功率也越高。";
						next;
	mes "[文森特]";
	mes "总之，我的课程到此结束。";
	mes "如果想继续学习，由于你的等级太高，已经没有办法了。";
						setquest 7484;
						completequest 7484;
						close2;
						cutin "", 255;
						end;
					} else if (isbegin_quest(7484) == 1) {
						if (countitem(7049) > 0) {
							cutin "sc_vicente01.bmp", 2;
	mes "[文森特]";
	mes "哦，太好了！";
	mes "把石头留作纪念吧。";
							completequest 7484;
							getexp 800,0;
							next;
	mes "[文森特]";
	mes "总之，你的能力足够继续了。";
	mes "去和梅赛尔谈谈。";
							close2;
							cutin "", 255;
							end;
						} else {
							cutin "sc_vicente01.bmp", 2;
	mes "[文森特]";
	mes "嗯，这是关于使用手册学习盗贼技能的事。";
	mes "顺便说一下，这本手册只适用于等级 12 以下的体验。";
							next;
	mes "[文森特]";
	mes "原本计划实际练习^4d4dff偷窃魔物物品^000000技能，";
	mes "但你只需了解它是什么……无需实际练习。";
							next;
	mes "[文森特]";
						mes "我会把这门课程视为完成。";
						mes "顺便问问，偷窃到底是什么？";
							next;
							switch(select("Stealing other's items!", "Stealing monster's items!", "Stealing other's enemy!", "Don't know.")) {
							case 1:
	mes "[文森特]";
		mes "错了！那样做太可怕了。";
		mes "你不能到处偷别人的东西。";
								cutin "sc_vicente02.bmp", 2;
								next;
								break;
							case 2:
	mes "[文森特]";
		mes "正确！";
		mes "你的记性不错。";
								cutin "sc_vicente03.bmp", 2;
								next;
								break;
							case 3:
	mes "[文森特]";
		mes "你喜欢做那种事？";
		mes "那样做太可怕了。";
								next;
								break;
							case 4:
								break;
							}
							cutin "sc_vicente01.bmp", 2;
	mes "[文森特]";
		mes "没错，我们偷窃魔物的物品。";
		mes "技能等级和命中率越高，成功率也越高。";
							next;
	mes "[文森特]";
		mes "总之，我的课程到此结束。";
		mes "如果想继续学习，由于你的等级太高，已经没有办法了。";
							setquest 7484;
							completequest 7484;
							close2;
							cutin "", 255;
							end;
						}
					}
				}
				if (!isbegin_quest(7484)) {
					cutin "sc_vicente01.bmp", 2;
	mes "[文森特]";
					mes "嗯，什么？";
					mes "你是在说用手册学习盗贼技能吗？";
					mes "首先，装备盗贼手册。";
					next;
	mes "[文森特]";
					mes "你可以双击^4d4dff要装备的物品^000000，或将其拖到装备窗口。";
					next;
	mes "[文森特]";
					mes "然后打开技能窗口，在‘杂项’标签中可以找到新增技能。";
					mes "还可以把技能设置到快捷栏。";
					next;
	mes "[文森特]";
					mes "其中有一项技能叫^4d4dff偷窃^000000。";
					next;
	mes "[文森特]";
					mes "这里有一项任务。";
					mes "你看到装饰用的波利笼了吗？";
					mes "使用偷窃技能从波利身上偷取^4d4dff一块石头。^000000";
					next;
	mes "[文森特]";
					mes "偷窃有可能失败，所以不要放弃。";
					mes "祝你好运。";
					setquest 7484;
					npcskill "AL_BLESSING", 10, 60, 60;
					percentheal 0,100;
					close2;
					cutin "", 255;
					end;
				} else if (isbegin_quest(7484) == 1) {
					if (countitem(7049) > 0) {
						cutin "sc_vicente01.bmp", 2;
	mes "[文森特]";
		mes "哦，太好了！";
		mes "把石头留作纪念吧。";
						completequest 7484;
						getexp 800,0;
						next;
	mes "[文森特]";
					mes "总之，这已经足够作为技能练习，我们的课程到此结束。";
					mes "如果还没完成维尔哈塞尔先生的任务，就继续完成吧。";
						close2;
						cutin "", 255;
						end;
					} else {
						cutin "sc_vicente01.bmp", 2;
	mes "[文森特]";
					mes "从波利身上偷取一块石头。";
					mes "很有趣吧？";
						next;
					if (select("它没有给我石头。", "我不做了。") == 1) {
	mes "[文森特]";
						mes "嗯？所有波利的石头都被偷走了？";
						mes "我会再次召唤波利，你再试一次。";
							donpcevent "#nbacStone01::OnReset";
							donpcevent "#nbacStone02::OnReset";
							donpcevent "#nbacStone03::OnReset";
							npcskill "AL_BLESSING", 10, 60, 60;
							percentheal 0,100;
							close2;
							cutin "", 255;
							end;
						} else {
	mes "[文森特]";
						mes "嗯，是这样吗？";
						mes "看来你不适合这项技能。";
						mes "明白了，任务现在取消。";
							erasequest 7484;
							close2;
							cutin "", 255;
							end;
						}
					}
				} else {
					cutin "sc_vicente01.bmp", 1;
	mes "[文森特]";
					mes "啊啊。无聊，无聊……";
					mes "现在我明白大师为什么逃跑了。";
					mes "我想回家。";
					next;
					cutin "gc_verkhasel01.bmp", 2;
	mes "[维尔哈塞尔]";
					mes "我也是。";
					mes "梅赛尔……她到底怎么想的……";
					next;
	mes "[露明]";
					mes "嗯……她擅自离队了吗？";
					cutin "nov_lumin01.bmp", 0;
					next;
					cutin "gc_verkhasel01.bmp", 2;
	mes "[维尔哈塞尔]";
					mes "你在开玩笑吗？！";
					mes "你宁愿去执行送命的任务吗！？！";
					next;
					cutin "sc_vicente01.bmp", 2;
	mes "[文森特]";
					mes "啊……我不喜欢这样。";
					mes "我更愿意像平常一样坐在工坊里鉴定珠宝……";
					next;
					cutin "gc_mayssel03.bmp", 1;
					mes "[Mayssel]";
					mes ".... .. ..";
					mes "我会接受维尔哈塞尔的愿望。";
					mes "别担心，呵呵呵……";
					next;
					cutin "", 255;
					mes "气氛变得阴沉了。";
					mes "我该离开这里吗？";
					close;
				}
			} else {
				cutin "sc_vicente01.bmp", 2;
	mes "[文森特]";
				mes "你做得很好。";
				mes "希望有一天还能再见到你。";
				next;
	mes "[文森特]";
				mes "啊，顺便说一下，我在里希塔乐镇经营一家小工坊。";
				mes "以后有机会来找我。";
				next;
	mes "[文森特]";
				mes "也许我不会忘记你……";
				mes "哈哈……";
				close2;
				cutin "", 255;
				end;
			}
		}
	} else {
		if (!isbegin_quest(4269)) {
			cutin "sc_vicente01.bmp", 2;
	mes "[文森特]";
				mes "你不是克里图拉学院的学生。";
				mes "如果想进一步了解这个职业，最好先注册为学院学生。";
			next;
	mes "[文森特]";
				mes "不过只有初心者可以注册……";
			close2;
			cutin "", 255;
			end;
		} else {
			if (Class == Job_Thief) {
				cutin "sc_vicente03.bmp", 2;
	mes "[文森特]";
				mes "哦，你已经成为优秀的盗贼了。";
				mes "以后想不想成为暗影追踪者？";
				next;
	mes "[文森特]";
				mes "这是由技艺精湛的精英盗贼晋升而来的高级职业。";
				next;
	mes "[文森特]";
				mes "职业等级 40 以上的盗贼随时都可以转职为流氓。";
				mes "幸运的是，依斯鲁得码头有前往帕罗斯灯塔的航行服务！！";
				next;
				cutin "gc_verkhasel02.bmp", 0;
	mes "[维尔哈塞尔]";
				mes "首先，礼貌地问问你能不能成为流氓吧？";
				mes "如果申请成为刺客，又会怎样呢？";
				next;
				cutin "sc_vicente03.bmp", 2;
	mes "[文森特]";
				mes "哈哈。你喜欢血腥的工作？";
				next;
				cutin "sc_vicente04.bmp", 2;
	mes "[文森特]";
				mes "哈哈……冷静……";
				mes "别对每件小事都反应过度……";
				next;
				cutin "", 255;
			mes "气氛变得非常紧张。";
				close2;
				cutin "", 255;
				end;
			} else {
				cutin "sc_vicente03.bmp", 2;
	mes "[文森特]";
			mes "欢迎来到克里图拉学院。";
			mes "我在这里向想成为盗贼的人教授基础知识。";
				next;
	mes "[文森特]";
			mes "换句话说，我负责指导想成为盗贼的初心者。";
			mes "哈哈……";
				close2;
				cutin "", 255;
				end;
			}
		}
	}

OnInit:
	questinfo( QTYPE_QUEST, QMARK_NONE, "!isbegin_quest(7481) && isbegin_quest(7480) == 1" );
	questinfo( QTYPE_QUEST, QMARK_NONE, "!isbegin_quest(7484) && isbegin_quest(7483) == 1" );
	end;
}

iz_ac02_a,49,134,5	duplicate(Vicente#ac)	Vicente#ac_a	4_M_HUMAN_02
iz_ac02_b,49,134,5	duplicate(Vicente#ac)	Vicente#ac_b	4_M_HUMAN_02
iz_ac02_c,49,134,5	duplicate(Vicente#ac)	Vicente#ac_c	4_M_HUMAN_02
iz_ac02_d,49,134,5	duplicate(Vicente#ac)	Vicente#ac_d	4_M_HUMAN_02

// - Verkhasel
// - Teaches the player about the Thief class.
// -----------------------------------------------------------------------------
iz_ac02,55,134,3	script	Verkhasel#ac	4_M_GUILLOTINE,{
	if (isbegin_quest(4269) > 0 && Class == Job_Novice) {
		if (!isbegin_quest(7480)) {
	mes "[维尔哈塞尔]";
			mes "什么？你打扰到我了。";
			cutin "gc_verkhasel01.bmp", 0;
			close2;
			cutin "", 255;
			end;
		} else if (isbegin_quest(7480) == 1) {
			if (!isbegin_quest(7482)) {
	mes "[维尔哈塞尔]";
				mes "嘿嘿，嘿嘿，这可不是开玩笑。";
				mes "梅赛尔的课程……";
				mes "你叫我来就是为了这种讨厌的事？";
				cutin "gc_verkhasel01.bmp", 0;
				next;
				select("……继续工作？");
	mes "[露明]";
				mes "真遗憾。那个人很可怕。";
				mes "但只要我和你在一起，就不用怕他。";
				cutin "nov_lumin02.bmp", 2;
				next;
	mes "[维尔哈塞尔]";
				mes "你这次又在说什么？";
				mes "一开始，卢……你不该在这里……";
				cutin "gc_verkhasel01.bmp", 0;
				next;
				cutin "nov_lumin01.bmp", 2;
	mes "[露明]";
				mes "……我是谁？";
				mes "助手……教官？";
				next;
				cutin "gc_verkhasel02.bmp", 0;
	mes "[维尔哈塞尔]";
				mes "啧……";
				mes "那么，你对哪一个感兴趣？";
				next;
				cutin "gc_verkhasel01.bmp", 0;
				.@ok_chk = 0;
				while(1) {
					switch(select("二刀连击", "施毒", "回避率提升与隐匿", "关于你", "够了。")) {
					case 1:
	mes "[维尔哈塞尔]";
						mes "你可能已经知道，盗贼的主要武器是短剑。";
						mes "盗贼的特色是用短剑发动^4d4dff二刀连击^000000。";
						next;
	mes "[维尔哈塞尔]";
						mes "如果攻击力不足，它可以在一定程度上弥补。";
						mes "还有其他问题吗？";
						.@ok_chk = .@ok_chk + 1;
						next;
						continue;
					case 2:
	mes "[维尔哈塞尔]";
						mes "有一项叫^4d4dff施毒^000000的技能，可以用毒素使敌人中毒，";
						mes "还有一项叫^4d4dff解毒^000000的技能，可以解除中毒状态。";
						next;
	mes "[维尔哈塞尔]";
						mes "中毒状态会呈现漂亮的紫色，很容易辨认。";
						next;
	mes "[维尔哈塞尔]";
						mes "如果你中毒，毒素会迅速降低生命力，";
						mes "要立即解毒或服用解毒药水。";
						next;
	mes "[维尔哈塞尔]";
						mes "如果你对毒药更感兴趣，也许可以成为刺客。";
						mes "他们正式将毒药作为武器。";
						mes "下一个！";
						.@ok_chk = .@ok_chk + 1;
						next;
						continue;
					case 3:
	mes "[维尔哈塞尔]";
						mes "盗贼会训练^4d4dff回避率提升^000000技能。";
						mes "通过闪避攻击，让敌人无计可施。";
						next;
	mes "[维尔哈塞尔]";
						mes "与其挨打后忍耐，防御较低的盗贼更适合迅速闪避。";
						mes "因此不能忽视敏捷 [AGI]。";
						next;
	mes "[维尔哈塞尔]";
						mes "^4d4dff隐匿^000000是用于躲避的技能。";
						mes "成功后，其他人就看不到你。";
						next;
	mes "[维尔哈塞尔]";
						mes "啊，俗话说你骗不了鬼……你会被邪恶发现。";
						mes "敏感的昆虫也能察觉到你……";
						next;
	mes "[维尔哈塞尔]";
						mes "除此之外，它也适合用来躲避紧急情况。";
						mes "转职为流氓或刺客等高级职业后，还能学习更多有用的技能。";
						.@ok_chk = .@ok_chk + 1;
						next;
						continue;
					case 4:
	mes "[维尔哈塞尔]";
						mes "我？我是十字斩首者的首领。";
						mes "......";
						next;
						cutin "nov_lumin01.bmp", 2;
	mes "[露明]";
						mes "作为刺客，我是执行组成员，负责惩罚违法者。";
						mes "顺便说一下，维尔哈塞尔的主要武器是拳刃。";
						next;
						select("你怎么知道？");
	mes "[露明]";
						mes "那是我的希望。";
						cutin "nov_lumin03.bmp", 2;
						next;
						cutin "gc_verkhasel01.bmp", 0;
	mes "[维尔哈塞尔]";
						mes "哦……聪明的小子~~";
						mes "够了，露。";
						mes "还有问题吗？";
						next;
						continue;
					case 5:
						if (.@ok_chk == 0) {
	mes "[维尔哈塞尔]";
							mes "你可以从一个敌人身上偷取一件物品。";
							mes "停在这里让我很惭愧，但被忽视更糟……";
							next;
						} else {
	mes "[维尔哈塞尔]";
							mes "好。";
							mes "看在你没有忽视我的份上，我们现在结束课程吧。";
							next;
						}
						break;
					}
					break;
				}
				cutin "gc_verkhasel01.bmp", 0;
	mes "[维尔哈塞尔]";
					mes "老实说，我不认为你需要知道盗贼技能的详细内容。";
					mes "只要知道有这类技能就够了……";
				next;
	mes "[维尔哈塞尔]";
					mes "我的意思是，现在这样就够了。";
				setquest 7482;
				close2;
				cutin "", 255;
				end;
			} else {
				cutin "gc_verkhasel01.bmp", 0;
	mes "[维尔哈塞尔]";
					mes "还有其他好奇的事情吗？";
					mes "完成梅赛尔的课程后，我会回答你。";
				next;
	mes "[维尔哈塞尔]";
					mes "我的意思是她知道答案。";
					mes "梅赛尔会替你解答。";
				next;
				cutin "nov_lumin01.bmp", 2;
	mes "[露明]";
					mes "懒家伙。";
					mes "说实话……你真烦。";
				next;
				cutin "gc_verkhasel02.bmp", 0;
	mes "[维尔哈塞尔]";
					mes "……你……";
					mes "啧……我不知道敌人是谁……";
				close2;
				cutin "", 255;
				end;
			}
		} else {
			if (isbegin_quest(7483) == 1) {
				if (BaseLevel > 12) {
					if (!isbegin_quest(7485)) {
						cutin "gc_verkhasel01.bmp", 0;
	mes "[维尔哈塞尔]";
						mes "技能的实际体验任务？";
						mes "要进行体验，你的等级太高了。";
						mes "我无法使用指导流程。";
						next;
	mes "[维尔哈塞尔]";
						mes "原本我会让你用施毒猎杀波利。";
						mes "但如果不能使用技能，就没办法了……";
						next;
	mes "[维尔哈塞尔]";
						mes "施毒是让敌人中毒的技能。";
						mes "即使没有使它中毒，也可以利用毒素特性造成伤害。";
						next;
	mes "[维尔哈塞尔]";

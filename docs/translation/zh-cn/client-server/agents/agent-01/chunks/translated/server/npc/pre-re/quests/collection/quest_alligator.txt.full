cmd_fild01,362,256,3	script	Cuir#Gator_Hunt	106,{
	if (checkquest(60119) != -1) {
		if (checkquest(60119,HUNTING) != 2 ) {
			mes "[库伊尔]";
			mes "你完成猎杀 50 只鳄鱼了吗？";
			next;
			switch(select("是:否:我想放弃")) {
			case 1:
				mes "[库伊尔]";
				mes "嗯，我不认为你已经猎杀了 50 只……";
				close;
			case 2:
				mes "[库伊尔]";
				mes "记住，我需要帮助猎杀鳄鱼，请去猎杀 50 只。";
				close;
			case 3:
				mes "[库伊尔]";
				mes "确定要停止猎杀吗？";
				mes "你取得的所有进度都会被删除";
				next;
				switch(select("是:否")) {
				case 1:
					mes "[库伊尔]";
					mes "好吧，改变主意后再回来。";
					erasequest 60119;
					close;
				case 2:
					mes "[库伊尔]";
					mes "请猎杀 50 Alligators.";
					close;
				}
			}
		}
		else {
			mes "[库伊尔]";
			mes "真棒，你完成得很快。";
			getexp 68950,43300;
			erasequest 60119;
			close;
		}
	}
	if (checkquest(60120) != -1) {
		if (checkquest(60120,HUNTING) != 2 ) {
			mes "[库伊尔]";
			mes "你完成猎杀 50 只鳄鱼了吗？";
			next;
			switch(select("是:否:我想放弃")) {
			case 1:
				mes "[库伊尔]";
				mes "嗯，我不认为你已经猎杀了 100 只……";
				close;
			case 2:
				mes "[库伊尔]";
				mes "记住，我需要帮助猎杀鳄鱼，请去猎杀 100 只。";
				close;
			case 3:
				mes "[库伊尔]";
				mes "确定要停止猎杀吗？";
				mes "你取得的所有进度都会被删除";
				next;
				switch(select("是:否")) {
				case 1:
					mes "[库伊尔]";
					mes "好吧，改变主意后再回来。";
					erasequest 60120;
					close;
				case 2:
					mes "[库伊尔]";
					mes "请猎杀 100 Alligators.";
					close;
				}
			}
		}
		else {
			mes "[库伊尔]";
			mes "真棒，你完成得很快。";
			getexp 68950,43300;
			getexp 68950,43300;
			erasequest 60120;
			close;
		}
	}
	if (checkquest(60121) != -1) {
		if (checkquest(60121,HUNTING) != 2 ) {
			mes "[库伊尔]";
			mes "你完成猎杀 150 只鳄鱼了吗？";
			next;
			switch(select("是:否:我想放弃")) {
			case 1:
				mes "[库伊尔]";
				mes "嗯，我不认为你已经猎杀了 150 只……";
				close;
			case 2:
				mes "[库伊尔]";
				mes "记住，我需要帮助猎杀鳄鱼，请去猎杀 150 只。";
				close;
			case 3:
				mes "[库伊尔]";
				mes "确定要停止猎杀吗？";
				mes "你取得的所有进度都会被删除";
				next;
				switch(select("是:否")) {
				case 1:
					mes "[库伊尔]";
					mes "好吧，改变主意后再回来。";
					erasequest 60121;
					close;
				case 2:
					mes "[库伊尔]";
					mes "请猎杀 150 Alligators.";
					close;
				}
			}
		}
		else {
			mes "[库伊尔]";
			mes "真棒，你完成得很快。";
			getexp 68950,43300;
			getexp 68950,43300;
			getexp 68950,43300;
			erasequest 60121;
			close;
		}
	}
	//for minimum level
	if (BaseLevel > 44) {
		//for maximum level
		if (BaseLevel < 81) {
			mes "[库伊尔]";
			mes "你看起来是强壮的冒险者！";
			next;
			mes "[库伊尔]";
			mes "我被派来减少鳄鱼数量，但仅凭我很难完成任务。你愿意帮我吗？";
			next;
			switch(select("好的:不了")) {
			case 1:
			mes "[库伊尔]";
				mes "你可以猎杀鳄鱼或为我收集物品。你想做哪种？";
				next;
				switch(select("收集物品:猎杀鳄鱼:取消")) {
				case 1:
				// Item turn in
				mes "[库伊尔]";
					mes "如果你能带来 ^00CC0020鳄鱼皮^000000，我就帮你变得更强。";
					next;
					switch(select("我有鳄鱼皮:鳄鱼咬人！")) {
					case 1:
					/*
					if (checkweight(503,10) == 0) {
						mes "[库伊尔]";
						mes "嘿，看起来你背上的重量快把你压垮了。";
						mes "减轻一些负重后再回来吧。";
						mes "";
							close;
							}
							*/
						if (countitem(7003) > 19) {
						mes "[库伊尔]";
						mes "谢谢你的 ^00CE0020鳄鱼皮^000000！";
							mes "希望你能继续帮我收集这些皮。";
							mes "全世界的护甲制作者都在争相收购它们。";
							delitem 7003,20; //Anolian_Skin
							getexp 68950,43300;
							//getitem 503,10; //Yellow_Potion
							close;
							}
							else {
						mes "[库伊尔]";
						mes "我一眼就能认出鳄鱼皮，可我没看到 ^00CE0020鳄鱼皮^000000。";
							close;
							}
							case 2:
						mes "[库伊尔]";
					mes "我需要 ^00CE0020鳄鱼皮^000000。";
						close;
						}
						case 2:
					// Kill Count Quest
				mes "[库伊尔]";
					mes "啊，好。我想你可以通过猎杀鳄鱼来帮我。";
					mes "你想猎杀多少只？";
					next;
					switch(select("50 只鳄鱼:100 只鳄鱼:150 只鳄鱼")) {
					case 1:
					mes "[库伊尔]";
					mes "完成任务后回来，我会给你一份小奖励。";
						setquest 60119;
						close;
						case 2:
						mes "[库伊尔]";
					mes "完成任务后回来，我会给你一份小奖励。";
						setquest 60120;
						close;
						case 3:
						mes "[库伊尔]";
					mes "完成任务后回来，我会给你一份小奖励。";
						setquest 60121;
						close;
						}
						case 3:
					mes "[库伊尔]";
				mes "如果你改变主意，请再回来。";
					close;
					}
					case 2:
				mes "[库伊尔]";
			mes "如果你改变主意，请再回来。";
				close;
				}
				}
			else {
		mes "[库伊尔]";
		mes "你对这个任务来说太强了，我需要完好的皮，不是被炸烂的！";
			next;
			close;
			}
			}
		else {
	mes "[库伊尔]";
	mes "你确实很勇敢，但如果继续向东，勇敢就会变成愚蠢。";
		mes "等你更强一些，也许我们就能做生意。";
		close;
		}
		
	}
//

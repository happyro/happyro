OnTouch_:
	set .@sub$,callfunc("F_Okolnir");
	if (countitem(7839)) {
		mes "传送门响应水晶钥匙。";
		delitem 7839,1; //Crystal_Key
		close2;
		warp "que_q"+.@sub$,114,158;
		end;
	}
	mes "需要水晶钥匙才能启动传送门。";
	close;
}

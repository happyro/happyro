				mes "[Shede]";
				mes "所以我决定烘焙一种特别的饼干，叫作……";
				mes "……^3131FF恶魔饼干^000000！";
				next;
				mes "["+strcharinfo(0)+"]";
				mes "恶魔饼干？";
				next;
				cutin "siide1.bmp",2;
				mes "[Shede]";
			mes "没错，恶魔饼干。";
			mes "走出胡格后，你会在灌木丛里找到\"^3131FF莫克斯虫^000000\"。";
			mes "它们在这个季节繁殖，所以肚子里满是虫卵。";
				next;
				mes "[Shede]";
			mes "把它们的外壳炖煮，再用汤汁揉面，";
			mes "就能做出新鲜酥脆的饼干。";
				next;
				cutin "siide2.bmp",2;
				mes "[Shede]";
			mes "恶魔饼干非常美味，据说神秘的酥脆口感和甜味会让食客陶醉，";
			mes "甚至在不知不觉间把他们引向地狱。";
			mes "啊～希望他会喜欢……";
				next;
				cutin "siide1.bmp",2;
				mes "[Shede]";
			mes "可以请你帮我烤饼干吗？我需要 5 个莫克斯虫外壳～";
				next;
				mes "["+strcharinfo(0)+"]";
			mes "‘……我搞不懂……她到底是爱他还是恨他？’";
				emotion ET_THINK, playerattached();
				set hg_tre,30;
				close2;
				cutin "",255;
				end;
			}
		case 2:
			mes "[Shede]";
			mes "不，没关系。我正好需要休息一下，呵呵！";
			close2;
			cutin "",255;
			end;
		}
	} else if (hg_tre > 9 && hg_tre < 15) {
		mes "[Shede]";
		mes "可以请你从\"^3131FF莫克斯蘑菇^000000\"收集\"^3131FF5 份莫克斯蘑菇汁^000000\"吗？";
		mes "你可以在胡格附近的田野找到蘑菇。";
		mes "希望你能尽快把蘑菇汁带回来！";
		close2;
		cutin "",255;
		end;
	} else if (hg_tre > 19 && hg_tre < 25) {
		mes "[Shede]";
		mes "请从渡船的捕鱼陷阱里捡回\"^3131FF5 个蛤蜊^000000\"。";
		mes "希望你能尽快带回来！";
		close2;
		cutin "",255;
		end;
	} else if (hg_tre > 29 && hg_tre < 35) {
		mes "[Shede]";
		mes "请从胡格外带回\"^3131FF5 个莫克斯虫外壳^000000\"。";
		mes "希望你能尽快带回来！";
		close2;
		cutin "",255;
		end;
	} else if (hg_tre == 15) {
		mes "[Shede]";
		mes "哦！你比我想的更早回来。";
		mes "现在我可以为霍伦叔叔烤蘑菇味饼干了。";
		mes "非常感谢你。";
		emotion ET_SMILE;
		set hg_tre,40;
		close2;
		cutin "",255;
		end;
	} else if (hg_tre == 25) {
		mes "[Shede]";
		mes "哦！你比我想的更早回来。";
		mes "现在我可以烤出最棒的饼干，和阿杰特一较高下了！";
		mes "非常感谢你。";
		emotion ET_SMILE;
		set hg_tre,40;
		close2;
		cutin "",255;
		end;
	} else if (hg_tre == 35) {
		mes "[Shede]";
		mes "哦！你比我想的更早回来。";
		mes "现在我可以烤恶魔饼干，向那位先生告白了。";
		mes "非常感谢你。";
		emotion ET_SMILE;
		next;
		mes "["+strcharinfo(0)+"]";
		mes "（如果他知道她用了什么材料做饼干，）";
		mes "（我很确定他至少会记住她的脸，以后好躲着她……）’";
		emotion ET_THINK, playerattached();
		set hg_tre,40;
		close2;
		cutin "",255;
		end;
	} else if (hg_tre == 40) {
		if (lhz_boss == 44 && lhz_curse > 30) {
			mes "[Shede]";
			mes "你见过赫里科先生吗？";
			mes "他是住在胡格旅馆的孤独老人。";
			next;
			mes "[Shede]";
			mes "如果你有时间，不妨去陪陪他？";
			mes "我知道他会很感激的。";
			set hg_tre,41;
			close2;
			cutin "",255;
			end;
		} else {
			mes "[Shede]";
			mes "那么，你喜欢胡格吗？";
			mes "这是个和平的村庄，对吧？";
			close2;
			cutin "",255;
			end;
		}
	} else if (hg_tre == 41) {
		mes "[Shede]";
		mes "赫里科先生行动不便，所以通常待在房间里。";
		mes "请去陪陪他，我知道他会很感激的。";
		close2;
		cutin "",255;
		end;
	} else {
		mes "[Shede]";
		mes "那么，你喜欢胡格吗？";
		mes "这是个和平的村庄，对吧？";
		close2;
		cutin "",255;
		end;
	}
}

hu_in01,256,40,3	script	Herico	897,{
	if (checkweight(7342,1) != 1) {
		mes "[Herico]";
		mes "你不如先放下肩上的负担，再回来吧？";
		close;
	}
	cutin "heri1.bmp",2;
	if (hg_tre < 41) {
		mes "[Herico]";
		mes "今天天气真好。*叹气*但我的身体疼得太厉害，无法出门……";
		close2;
		cutin "",255;
		end;
	} else if (hg_tre == 41) {
		mes "[Herico]";
		mes "今天天气真好。*叹气*但我的身体疼得太厉害，无法出门……";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "你好！";
		next;
		mes "[Herico]";
		mes "谢德？";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "哦，你好。谢德小姐让我带你来这里。很高兴见到你，我是^3131FF"+strcharinfo(0)+"^000000。";
		next;
		mes "[Herico]";
		mes "啊，你好。我听说最近镇上建了机场。你来自别的城市吗？";
		mes "我喜欢新鲜事物……虽然不喜欢这股冷风。";
		mes "你喜欢胡格吗？";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "这是个和平美丽的村庄，不过我能感觉到它正在变化。";
		mes "每个人看起来都很快乐，和其他地区的人很不一样。";
		mes "所以我觉得自己来到了另一片土地。";
		next;
		mes "[Herico]";
		mes "每个人都有烦恼，也同时拥有幸福。";
		mes "你一定去过这个国家的许多城市，";
		mes "并独自领悟了许多事情。";
		mes "我说得对吗？";
		next;
		switch(select("是的，你说得对。:我不太确定。:不对。")) {
		case 1:
			cutin "heri2.bmp",2;
			mes "[Herico]";
			mes "我觉得自己的感觉仍然很敏锐。";
			mes "人的眼睛会告诉我很多事情。";
			next;
			cutin "heri1.bmp",2;
			mes "[Herico]";
			mes "你的眼睛告诉我，你对在胡格看到的一切既钦佩又惊讶，";
			mes "这对你来说是完全不同的体验。";
			next;
			mes "[Herico]";
			mes "胡格人不会质问任何人。";
			mes "这是村子不成文的规定。";
			mes "所以我才能毫无忧虑地在这里休息。";
			next;
			mes "[Herico]";
			mes "不过看到你，我突然想回忆一下从未对任何人说起的过去。";
			mes "如果你不介意，可以听我一会儿吗？";
			next;
			mes "[Herico]";
			mes "也许我们能从彼此的故事中学到些什么。";
			set hg_tre,42;
			close2;
			cutin "",255;
			end;
		case 2:
			mes "[Herico]";
			mes "那么我想这个国家没有给你留下深刻印象。";
			mes "哈哈，好吧，没关系。";
			close2;
			cutin "",255;
			end;
		case 3:
			mes "[Herico]";
			mes "哦，是吗？";
			mes "哈哈，抱歉我只是随便猜测。";
			close2;
			cutin "",255;
			end;
		}
	} else if (hg_tre == 42) {
		mes "[Herico]";
		mes "嗯……能再告诉我一次你的名字吗？";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "是的，我叫^3131FF"+strcharinfo(0)+"^000000。";
		next;
		mes "[Herico]";
		mes "^3131FF"+strcharinfo(0)+"^000000，我有许多有趣的故事想告诉你。";
		mes "不过在讲故事之前，我想问你一件事。你介意吗？";
		next;
		mes "[Herico]";
		mes "如你所见，自从胡格建起机场，许多陌生人进出村子。";
		mes "这或许是好变化，能让更多人知道胡格的存在。";
		mes "不过我对机场和飞艇有种不好的感觉。";
		mes "我不认为这个国家扩展航线只是为了运输。";
		next;
		mes "[Herico]";
		mes "你知道吗，机场建成后，越来越多人开始乘渡船。";
		mes "你看不出我怀疑的理由吗？";
		next;
		mes "[Herico]";
		mes "请查明飞艇和那座岛的秘密。";
		mes "之后我会告诉你我的故事。";
		mes "希望你尽力找出真相。";
		set hg_tre,43;
		close2;
		cutin "",255;
		end;
	} else if (hg_tre == 43) {
		if (hg_odin == 60) {
			mes "[Herico]";
			mes "欢迎回来。我一直迫不及待地等着听你发现的秘密。";
			mes "现在请告诉我你查到了什么。";
			next;
			mes "- 你告诉他在奥丁神殿看到和听到的一切， -";
			mes "- 包括巨人、伊米尔之心和雷根贝勒。 -";
			next;
			cutin "heri3.bmp",2;
			mes "[Herico]";
			mes "雷根贝勒……原来他们的势力已经扩展到胡格这个小村庄了。";
			next;
			mes "["+strcharinfo(0)+"]";
			mes "你了解他们吗？";
			next;
			mes "[Herico]";
			mes "当然，我太了解他们了。";
			next;
			mes "[Herico]";
			mes "............";
			next;
			cutin "heri1.bmp",2;
			mes "[Herico]";
			mes "非常感谢你的努力。";
			mes "恐怕你的危险旅程还没有结束。";
			next;
			mes "[Herico]";
			mes "好了，现在该告诉你我的故事了。";
			mes "希望你会喜欢。";
			set hg_tre,44;
			close2;
			cutin "",255;
			end;
		} else {
			mes "[Herico]";
			mes "请查明飞艇和岛屿的秘密。";
			mes "之后我会告诉你我的故事。";
			mes "希望你尽力找出真相。";
			close2;
			cutin "",255;
			end;
		}
	} else if (hg_tre == 44) {
		mes "[Herico]";
		mes "嗯……我不知道该从哪里开始。";
		next;
		mes "[Herico]";
		mes "如你所知，我们有一种仿生机器，叫作^FF0000守护者^000000。";
		mes "我们用守护者保护重要设施，避免无谓的杀戮。";
		next;
		mes "[Herico]";
		mes "你想过古时候没有守护者时，人们如何保护重要设施吗？";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "也许他们雇佣许多人来做这件事？";
		next;
		mes "[Herico]";
		mes "是的，你说得对。很长一段时间，施瓦茨瓦尔德共和国都有";
		mes "^3131FF佣兵^000000，过去他们用生命换取丰厚报酬，负责处理所有脏活。";
		next;
		mes "[Herico]";
		mes "雷根贝勒成功发明并推广守护者后，他们失去了工作。";
		mes "守护者本为人类而造，但对佣兵来说却是最糟糕的事情。";
		next;
		mes "[Herico]";
		mes "由于工作被守护者取代，他们发动了名为^FF0000佣兵叛乱^000000的反抗。";
		next;
		mes "[Herico]";
		mes "佣兵叛乱得到了公众的强烈响应。";
		mes "然而，他们选择^3131FF暴力手段^000000战斗，";
		mes "而不是以有说服力的方式争取公众，因此失去了信任。";
		mes "换句话说，他们犯下致命错误，输掉了这场斗争。";
		next;
		mes "[Herico]";
		mes "叛乱失败后，幸存者便从历史中消失了。";
		next;
		cutin "heri3.bmp",2;
		mes "[Herico]";
		mes "不仅如此，他们还在^FF0000贤者瓦尔蒙特的出生地^000000与守护者交战，";
		mes "那里可是我们引以为傲的国宝！";
		mes "房屋在战斗中彻底毁坏，从那以后没人知道瓦尔蒙特贤者的下落。";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "瓦尔蒙特贤者……！";
		next;
		cutin "heri1.bmp",2;
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
		mes "[Herico]";
		mes "哦……我当时一定非常难过。";
		next;
		mes "[Herico]";
		mes "老实说，瓦尔蒙特贤者也要为守护者负责一部分。";
		mes "你知道，是他创造了守护者的动力核心。";
		next;
		mes "[Herico]";
		mes "佣兵因他发明守护者而向瓦尔蒙特贤者复仇，听起来很荒谬。";
		mes "不过他们的工作被守护者取代，这种反应也可以理解。";
		next;
		mes "[Herico]";
		mes "一切结束后我才听说佣兵叛乱，所以没能为瓦尔蒙特贤者做任何事。";
		mes "他消失了，我从出生地找到的线索也仅此而已……所以……";
		mes "我来到胡格，在这里定居。";
		next;
		mes "[Herico]";
		mes "我曾试图从他的实验室找到哪怕一点文件……";
		mes "但一切都不见了……嗯？等等，我刚想起一件非常重要的事！";
		next;
		mes "[Herico]";
		mes "他的研究文件都去哪了？";
		mes "难道是佣兵拿走了，或者……把它们处理掉了？";
		next;
		mes "[Herico]";
		mes "可恶！我真蠢！";
		mes "怎么没早点想到这一点？";
		next;
		mes "[Herico]";
		mes ""+strcharinfo(0)+"，现在你能看出我想告诉你什么了吗？";
		mes "我需要花些时间回忆事故的一切，";
		mes "但你必须明白，这件事极其重要。";
		next;
		mes "[Herico]";
		mes "佣兵叛乱当时是个重大事件。";
		mes "希望至少有一名新闻记者还记得那场叛乱。";
		next;
		mes "[Herico]";
		mes "请前往里希塔乐镇，找到还记得叛乱的新闻记者。";
		mes "找到后问问他是否知道叛乱幸存者的下落，";
		mes "这样你就能查明瓦尔蒙特贤者及其研究文件发生了什么。";
		set hg_tre,45;
		close2;
		cutin "",255;
		end;
	} else if (hg_tre == 45) {
		mes "[Herico]";
		mes "请前往里希塔乐镇，找到还记得叛乱的新闻记者。";
		mes "找到后问问他是否知道叛乱幸存者的下落，";
		mes "这样你就能查明瓦尔蒙特贤者及其研究文件发生了什么。";
		close2;
		cutin "",255;
		end;
	} else if (hg_tre > 45 && hg_tre < 49) {
		mes "[Herico]";
		mes "最近过得怎么样？";
		close2;
		cutin "",255;
		end;
	} else if (hg_tre == 49) {
		mes "[Herico]";
		mes "你找到瓦尔蒙特贤者的研究文件了吗？";
		next;
		cutin "",255;
		mes "["+strcharinfo(0)+"]";
		mes "嗯，关于那些文件……";
		next;
		switch(select("我把它们吃了。:雷根贝勒已经拿走了。")) {
		case 1:
			mes "我把它们吃了。";
			next;
			mes "[Herico]";
			mes "哈哈哈！真有趣！";
			next;
			mes "["+strcharinfo(0)+"]";
			mes "不，一点也不好笑。";
			next;
			mes "[Herico]";
			mes ".................";
			next;
			mes "[Herico]";
			mes "那就……把它们吐出来！";
			percentheal -5,0;
			specialeffect2 EF_HIT4;
			next;
			mes "[Herico]";
		mes "吐出来！";
			percentheal -5,0;
			specialeffect2 EF_HIT4;
			next;
			mes "[Herico]";
		mes "我说，把它们吐出来——！";
			percentheal -5,0;
			specialeffect2 EF_HIT4;
			next;
			mes "["+strcharinfo(0)+"]";
		mes "呃……我只是开玩笑……";
			next;
			cutin "heri2.bmp",2;
			mes "[Herico]";
		mes "哈哈，前半段很有趣，";
		mes "但后半段有点吓人，你知道吗？";
			emotion ET_THINK;
			emotion ET_CRY, playerattached();
			next;
			mes "[Herico]";
		mes "那么告诉我，他的研究文件都在哪里？";
			next;
			mes "["+strcharinfo(0)+"]";
		mes "雷根贝勒已经拿走了。";
			next;
			break;
		case 2:
		mes "雷根贝勒已经拿走了。";
			next;
			break;
		}
		cutin "heri3.bmp",2;
		mes "[Herico]";
		mes "...........................";
		next;
		cutin "heri1.bmp",2;
		mes "[Herico]";
		mes "果然如此。";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "你有什么打算？";
		next;
		mes "[Herico]";
		mes "首先，我想告诉你我的真实身份。";
		mes "我现在可能是个时日无多的老人，";
		mes "但我过去曾在瓦尔蒙特贤者的指导下，";
		mes "于雷根施姆实验室的^3131FF伊米尔之心仿制研究部门^000000工作。";
		emotion ET_HUK, playerattached();
		next;
		cutin "heri2.bmp",2;
		mes "[Herico]";
		mes "你看起来非常惊讶。";
		next;
		cutin "heri1.bmp",2;

mes "这很可疑。老实告诉我。";
mes "我不会生气。你从一开始只需要星尘碎片，对吧？";
			next;
			emotion ET_PROFUSELY_SWEAT;
			mes "[Arivero Yurhik]";
mes "不！你把我当成什么混蛋了？看着我的眼睛！";
			next;
mes "他气成那样非常可疑。不过我决定一笑置之。";
		}
		next;
		emotion ET_KIK;
		mes "[Arivero Yurhik]";
mes "虽然发生了一点小插曲，但现在还有两台禁传设备要摧毁。";
mes "既然我们找到了安装在朱诺的禁传设备位置和属性，现在就可以出发。";
		next;
		mes "[Arivero Yurhik]";
mes "朱诺禁传设备的坐标是 206 224。";
mes "它具有风属性。我们的特工会给我们粗糙的风，所以到了那里就能摧毁它。";
		next;
		mes "[Arivero Yurhik]";
mes "请带 4 个大地之恩来朱诺。它们的属性与风属性相反。";
		next;
		delitem 1000,1;// Star Crumb
		erasequest 5734;	// Core materials are always a problem
		setquest 5735;	// To Yuno
		yurhik_quest = 8;
		mes "[Arivero Yurhik]";
mes "朱诺见。";
		close2;
		cloakonnpcself( "Arivero Yurhik#TFQ02" );
		end;
	}
	end;
OnInit:
	cloakonnpc();
	end;
}

rebel_in,78,63,6	script	Rebellion leader#TFQ15	4_M_RUPERT,{
	if (yurhik_quest == 10) {
		mes "[" + strcharinfo(0) + "]";
mes "啊！先生，我说的不是这个……你只是向反叛军首领简要报告了和维罗一起做的事。";
		next;
		mes "[Rebellion leader]";
mes "你完成了这么重大的任务吗？";
mes "但很奇怪。最近从没人向我报告过有这样的任务。";
		next;
		mes "[" + strcharinfo(0) + "]";
mes "没有任务？那我完成的任务算什么？";
		next;
		mes "[Rebellion leader]";
mes "我也很好奇。我知道你执行任务回来后很疲惫，但请详细告诉我任务经过。";
		next;
mes "你向反叛军首领讲述了和维罗一起摧毁施瓦尔茨瓦尔德禁传设备时发生的事。";
		next;
		mes "[Rebellion leader]";
mes "阿里维罗·尤希克……正如你所说，那名枪手的姓氏似乎和这里的诺娅相同。";
		next;
		mes "[Rebellion leader]";
mes "但据我所知，克拉纳·尼米尔没有一个叫阿里维罗·尤希克的枪手……";
		next;
		mes "[" + strcharinfo(0) + "]";
mes "糟糕？！我不明白……虽然他突然在艾因布洛克消失了，但他确实和我一起执行任务……";
		next;
		mes "[Rebellion leader]";
mes "等等！冷静下来听我说。";
mes "那个叫阿里维罗的年轻人告诉你他是诺娅的弟弟，对吧？";
		next;
mes "我点了点头。";
		next;
		mes "[Rebellion leader]";
mes "我强烈感觉你遇到的阿里维罗就是诺娅的弟弟，尽管诺娅的弟弟小时候已经在事故中去世了。";
		next;
		mes "[" + strcharinfo(0) + "]";
mes "真的吗？！你说他死了……？";
		next;
		mes "[Rebellion leader]";
mes "这个世界上有很多我们无法解释的事。";
		next;
		mes "[Rebellion leader]";
mes "好了！事情就是这样。";
		next;
		mes "[Rebellion leader]";
mes "我不能再告诉你更多，因为这是诺娅的个人信息。不要再谈这个了。顺便说……";
		next;
		mes "[Rebellion leader]";
mes "你做得很好。也许你们两个人都很出色？";
mes "你们两个摧毁了施瓦尔茨瓦尔德的所有禁传设备。";
mes "虽然任务开始得不寻常，但无疑是了不起的成就。";
		next;
		mes "[Rebellion leader]";
mes "因为这不是正式任务，我不能给你丰厚奖励。但这仍然是了不起的成就。";
		next;
		completequest 5737;	// Clana Namieri
		getitem 25155,10;// Swz_Honor_Token
		getexp 1000000,4000000;
		yurhik_quest = 11;
		mes "[Rebellion leader]";
mes "就把这当作你辛苦工作的补偿吧。";
		next;
		cloakonnpcself( "Rebellion leader#TFQ15" );
mes "反叛军首领就这样消失了。";
mes "我到底经历了什么？";
mes "我会记住这次留下许多疑问的任务。";
		close;
	}
	end;
OnInit:
	cloakonnpc();
	end;
}


einbech,212,212,6	script	Arivero Yurhik#TFQ04	4_M_GUNSLINGER,{
	if (yurhik_quest == 2) {
		if (countitem(994) < 1) {
			mes "[Arivero Yurhik]";
mes "欢迎，朋友。你带来我请求的火属性物品了吗？";
			next;
			mes "[Arivero Yurhik]";
mes "还没有吗？请带来充满火属性的物品。";
			close;
		}
		mes "[Arivero Yurhik]";
mes "欢迎，朋友。你带来我请求的火属性物品了吗？";
		next;
		mes "[Arivero Yurhik]";
mes "火焰之心？";
mes "哦，火焰之心？我听说它是拥有强大火属性的物品。";
		next;
		mes "[Arivero Yurhik]";
mes "要试试吗？让我看看。这似乎就是特工告诉我们的地方。现在要把你带来的火焰之心打碎……";
		next;
		cloakoffnpcself( "Teleport Prohibition equipment#1" );
		specialeffect EF_FLAMELAUNCHER, AREA, "Teleport Prohibition equipment#1";
		mes "[Arivero Yurhik]";
mes "好~太棒了。成功了。";
mes "设备出现了。糟糕！趁设备消失前，启动你带来的装置……";
		next;
		mes "[Arivero Yurhik]";
mes "虽然只是模糊的理论，但成功了。";
mes "朋友，我们来摧毁它吧？";
		next;
		specialeffect EF_SUI_EXPLOSION, AREA, "Teleport Prohibition equipment#1";
		npctalk "Bang!", "Teleport Prohibition equipment#1", bc_self;
		sleep2 2000;
		specialeffect EF_SUI_EXPLOSION, AREA, "Teleport Prohibition equipment#1";
		npctalk "Bang!", "Teleport Prohibition equipment#1", bc_self;
		sleep2 2000;
		specialeffect EF_SUI_EXPLOSION, AREA, "Teleport Prohibition equipment#1";
		npctalk "Bang!", "Teleport Prohibition equipment#1", bc_self;
		sleep2 2000;
		specialeffect EF_SUI_EXPLOSION, AREA, "Teleport Prohibition equipment#1";
		mes "[Arivero Yurhik]";
mes "什么？为什么它毫发无伤？";
mes "我以为刚才的攻击已经够强了……";
		next;
		emotion ET_THINK;
		mes "[Arivero Yurhik]";
		mes ". . . . . .";
		next;
		mes "[Arivero Yurhik]";
mes "哦！难道是……？朋友，这台设备具有火属性。什么属性与火相反？";
		next;
		mes "[" + strcharinfo(0) + "]";
mes "水。";
		next;
		mes "[Arivero Yurhik]";
mes "就是这个！！水！！水属性。";
mes "用水属性攻击它，设备就会被摧毁。朋友，带来具有强大水属性的物品。";
		next;
		delitem 994,1;// Flame Heart
		erasequest 5729;	// To Einbech
		setquest 5730;	// Things that can destroy the device
		yurhik_quest = 3;
		mes "[Arivero Yurhik]";
mes "显然不止需要一个。请带来几个。我会守在这里，防止设备消失。";
		close;
	}
	if (yurhik_quest == 3) {
		emotion ET_QUESTION;
		mes "[Arivero Yurhik]";
mes "欢迎，朋友。你带来我请求的水属性物品了吗？";
		next;
		if (countitem(995) < 1) {
			mes "[Arivero Yurhik]";
mes "还没有吗？";
mes "我们需要具有强大水属性的物品。";
			close;
		}
		if (countitem(995) < 3) {
			mes "[Arivero Yurhik]";
mes "神秘冰冻？它确实是具有强大水属性的物品。没错，神秘冰冻足够用于我们的目的。但一两个还不够。";
mes "我想至少需要三个。";
			close;
		}
		mes "[Arivero Yurhik]";
mes "神秘冰冻？它确实是具有强大水属性的物品。没错，神秘冰冻足够用于我们的目的。试试看吧。";
		next;
		specialeffect EF_FROSTWEAPON;
		specialeffect EF_SUI_EXPLOSION, AREA, "Teleport Prohibition equipment#1";
		npctalk "Bang!", "Teleport Prohibition equipment#1", bc_self;
		sleep2 2000;
		specialeffect EF_FROSTWEAPON;
		specialeffect EF_SUI_EXPLOSION, AREA, "Teleport Prohibition equipment#1";
		npctalk "Bang!", "Teleport Prohibition equipment#1", bc_self;
		sleep2 2000;
		specialeffect EF_FROSTWEAPON;
		specialeffect EF_SUI_EXPLOSION, AREA, "Teleport Prohibition equipment#1";
		npctalk "Bang!", "Teleport Prohibition equipment#1", bc_self;
		sleep2 2000;
		specialeffect EF_LORD, AREA, "Teleport Prohibition equipment#1";
		cloakonnpcself( "Teleport Prohibition equipment#1" );
		sleep2 1000;
		mes "[Arivero Yurhik]";
mes "太好了！我们摧毁了设备。";
		next;
		mes "[Arivero Yurhik]";
mes "干得好，朋友。";
mes "虽然摧毁了设备，但还残留一些魔力。因此，这个区域暂时无法传送。";
		next;
		mes "[Arivero Yurhik]";
mes "不过最终还是会恢复传送。";
		next;
		delitem 995,3;// Mystic Frozen
		erasequest 5730;	// // Things that can destroy the device
		setquest 5731;	// // Clana Namieri
		yurhik_quest = 4;
		mes "[Arivero Yurhik]";
mes "我们摧毁了禁传设备。现在回克拉纳·尼米尔吧。";
		close2;
		cloakonnpcself( "Arivero Yurhik#TFQ04" );
		end;
	}
	end;
OnInit:
	cloakonnpc();
	end;
}


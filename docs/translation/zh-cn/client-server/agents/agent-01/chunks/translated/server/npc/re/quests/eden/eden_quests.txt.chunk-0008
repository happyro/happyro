		if (select( "是。", "否。" ) == 2) {
			mes "[Margaret]";
			mes "哦，是我弄错了。";
			close;
		}
		mes "[Margaret]";
		mes "你好。";
		mes "哦，你是来接受乌尔教官的训练的。";
		next;
		mes "[Margaret]";
		mes "好吧，我现在遇到了一点状况，所以请乌尔教官借助他的任务来帮忙。";
		next;
		select("什么状况？");
		mes "[Margaret]";
		mes "是的。";
		mes "找到迈恩，照他说的做。";
		next;
		mes "[Margaret]";
		mes "我们派他去做一件事，但他到现在还没完成，所以我猜他要么临阵退缩了，要么失败了。";
		next;
		mes "[Margaret]";
		mes "你能在斯普兰迪德原野找到他吗？";
		next;
		mes "[Margaret]";
		mes "请找到他，弄清楚他到底在做什么。";
		para_2nd01 = 23;
		erasequest 7233;//  Advanced Training at Ash Vacuum
		setquest 7234;// Margaret's favor
	}
	else if (para_2nd01 < 27) {
		mes "你能找到那两兄弟吗？";
		mes "弄清楚他们到底怎么了。";
	}
	else if (para_2nd01 == 27) {
		mes "怎么样了？！";
		next;
		mes "- 你向她讲述了米鲁和迈恩的事。 -";
		next;
		mes "[Margaret]";
		mes "嗯？哦，什么？";
		mes "这不太……";
		mes "好吧，我去处理他们。";
		next;
		mes "[Margaret]";
		mes "不管怎样，捕虫草和食人花的证明已经收集到了。";
		next;
		mes "[Margaret]";
		mes "你的训练结束了，回去和乌尔教官谈谈吧。";
		para_2nd01 = 29;
		erasequest 7234;// Margaret's favor
		setquest 7237;// Report to Instructor Ur
	}
	else if (para_2nd01 == 29) {
		mes "不管怎样，捕虫草和食人花的证明已经收集到了。";
		next;
		mes "[Margaret]";
		mes "你的训练结束了，回去和乌尔教官谈谈吧。";
	}
	else
		mes "……";
	close;
}

// man_fild01,43,234,3	script	Dispatched Instructor#2nd02	4_DST_SOLDIER,{
man_fild01,43,234,3	script	Dispatched Instructor#07	4_DST_SOLDIER,{
	mes "[Meeru]";
	if (para_2nd01 < 23) {
		mes "你觉得我会输！";
		mes "...?";
		mes "全都是……你是谁？！";
		mes "迈恩是个傀儡？";
		mes "他派你来监视我！？";
		next;
		mes "[Meeru]";
		mes "什么？不是这样吗？";
		mes "... ...";
		mes "迈恩没有派你来，对吧？";
	}
	else if (para_2nd01 == 23) {
		mes "你觉得我会输！";
		mes "...?";
		mes "全都是……你是谁？！";
		mes "迈恩是个傀儡？";
		mes "他派你来监视我！？";
		next;
		mes "[Meeru]";
		mes "什么？不是这样吗？";
		mes "... ...";
		mes "迈恩没有派你来，对吧？";
		mes "那你为什么在这里？";
		next;
		select("玛格丽特派我来的");
		mes "[Meeru]";
		mes "啊，玛格丽特！";
		mes "迈恩和玛格丽特总是因为我的胜利捉弄我——！";
		mes "真是的……";
		next;
		select( "发生了什么？", "你赢了什么？" );
		mes "[Meeru]";
		mes "一切都始于他们的争吵。";
		mes "玛格丽特被要求为我们两人侦察，就像你现在做的事。";
		next;
		mes "[Meeru]";
		mes "迈恩说他强大到足以击败任何魔物。";
		mes "所以我坚持让他去营地东边或西边证明给我看。";
		next;
		mes "[Meeru]";
		mes "迈恩只是放了句狠话，气呼呼地闹了一通，却什么也没做。";
		next;
		mes "[Meeru]";
		mes "总之，玛格丽特不相信他，便挑战他击杀 1 只捕虫草。";
		next;
		mes "[Meeru]";
		mes "所以现在因为那次争吵，我得请人去猎杀 1 只捕虫草。";
		next;
		mes "[Meeru]";
		mes "猎杀 1 只并不难，去这里东边的原野杀掉一只吧。";
		para_2nd01 = 24;
		setquest 7235;// Nepenthes Hunt
	}
	else if (para_2nd01 == 24) {
		if (checkquest(7235,HUNTING) == 2) {
			mes "嗯，我看到了。";
			mes "早知道就该让你多猎杀几只。";
			next;
			mes "[Meeru]";
			mes "总之，你证明了自己比迈恩吹嘘的还要强。";
			next;
			mes "[Meeru]";
			mes "总之，这是给你的小奖励。";
			next;
			mes "[Meeru]";
			mes "我会留在这里监督其他人猎杀捕虫草。也许我会让他们多猎杀几只，谁知道呢。";
			para_2nd01 = 25;
			erasequest 7235;// Nepenthes Hunt
			getexp 50000,50000;
		}
		else {
			mes "猎杀捕虫草对你来说太难了吗？";
			mes "你看起来脸色不太好。";
			mes "好吧，我来治疗你！";
			npcskill "AL_HEAL",10,99,60;
			percentheal 0,100;
		}
	}
	else if (para_2nd01 == 25)
		mes "我会留在这里监督其他人猎杀捕虫草。也许我会让他们多猎杀几只，谁知道呢。";
	else {
		mes "出什么问题了吗？";
		mes "那只捕虫草给你添麻烦了……";
		mes "……咳咳。";
	}
	close;
}

// spl_fild02,377,149,3	script	Dispatched Instructor#2nd02	4_M_DST_MASTER,{
spl_fild02,377,149,3	script	Dispatched Instructor#08	4_M_DST_MASTER,{
	mes "[Mine]";
	if (para_2nd01 < 25) {
		mes "残酷的世界啊。";
		mes "...";
		mes "你就这样路过了。";
		mes "事情怎么会变成这副惨状。";
	}
	else if (para_2nd01 == 25) {
		mes "残酷的世界啊……";
		mes "...";
		mes "你是谁？";
		next;
		if (select( "玛格丽特派我来的。", "嗯，我在这里……" ) == 1) {
			mes "[Mine]";
			mes "咦？谁！";
			mes "我明白了。已经到那个时候了吗？";
			mes "这件事真难办。";
			mes "我正陷入危机！";
		}
		else {
			mes "[Mine]";
			mes "哦，所以你不是自愿来的，是吗？";
			mes "那你干嘛还要来？";
			next;
			mes "[Mine]";
			mes "你不想待在这里，对吧？";
			mes "我猜是玛格丽特没找别人，而是派你来了。";
			mes "算了，总之我正陷入危机！";
		}
		next;
		mes "[Mine]";
		mes "好吧，我不想承认，但你得帮我一把。";
		next;
		mes "[Mine]";
		mes "我只是抱怨了几句，也不至于被他们派到这里来吧！";
		next;
		mes "[Mine]";
		mes "他们对我这种普通人要求太高了。";
		next;
		mes "[Mine]";
		mes "好吧，事情是这样的。";
		mes "我本该去猎杀那些食人花，一共 5 只。";
		mes "但你会替我完成，对吧？";
		next;
		mes "[Mine]";
		mes "我保证会给你不错的东西。";
		mes "谢谢。";
		para_2nd01 = 26;
		setquest 7236;// Pinguicula Hunt
	}
	else if (para_2nd01 == 26) {
		if (checkquest(7236,HUNTING) == 2) {
			mes "太好了！";
			mes "现在我可以回营地了，然后……";
			next;
			mes "[Mine]";
			mes "我是说，你能告诉玛格丽特一切都完成了吗？";
			next;
			mes "[Mine]";
			mes "别担心，她不会介意的。我回去继续做自己的事。这是你的奖励。";
			para_2nd01 = 27;
			erasequest 7236;// Pinguicula Hunt
			getexp 50000,50000;
		}
		else {
			mes "快去猎杀 5 只食人花。";
			mes "你到底是怎么来到这里的？";
			next;
			mes "[Mine]";
			mes "你不是在冒充真正的冒险者吧？";
			npcskill "AL_HEAL",10,99,60;
			percentheal 0,100;
		}
	}
	else if (para_2nd01 == 27) {
		mes "玛格丽特在营地总能如愿以偿。";
		mes "别担心，我很快就回去。";
	}
	else
			mes "……";
	close;
}

moc_para01,111,83,3	script	Blacksmith Thorn#2nd10	2_M_OLDBLSMITH,{
	if (checkweight(2571,5) == 0) {
	mes "- 你的背包中物品太多，无法继续 -";
		close;
	}
	mes "[Thorn]";
	if (!callfunc("F_HasEdenGroupMark")) {
		mes "嗯，你是伊甸园成员吗？";
		mes "必须成为我们的成员才能使用我的服务。";
		close;
	}
	mes "怎么了？";
	next;
	switch( select( "强化装备", "私人委托", "给我新装备。" ) ) {
		mes "[Thorn]";
	case 1:
		if (para_2nd01 < 6) {
			mes "嗯，强化装备。";
			mes "我可不会随便为任何人做这种事。";
			mes "首先要接受更高程度的训练，你完成伊甸园训练了吗？";
			next;
			mes "[Thorn]";
			mes "你还没有觉醒。";
			mes "先完成乌尔教官安排的任务，我就帮你强化装备。";
			next;
			mes "[Thorn]";
			mes "在那之前我不会帮你！";
		}
		else if (para_2nd04 == 3) {
			mes "想强化你的装备吗？";
			mes "我会随机提升新伊甸园装备的属性。";
			next;
			mes "[Thorn]";
			mes "那么你想强化哪件装备？";
			next;
			switch( select( "伊甸园斗篷 II", "伊甸园铠甲 IV", "伊甸园战靴 IV" ) ) {
				case 1: callsub S_Enchant,2571,"Manteau";// Para_Team_Manteau2
				case 2: callsub S_Enchant,15031,"Armor";// Para_Team_Armor
				case 3: callsub S_Enchant,2473,"Boots";// Para_Team_Boots4
			}
		}
		else {
			mes "完成我的私人委托后，我才会强化你的装备。";
			next;
			mes "[Thorn]";
			mes "我只是想确认你值得使用我的服务。";
		}
		close;
	case 2:
		if (para_2nd02 < 2) {
			mes "你开始执行乌尔教官的委托了吗？";
			mes "我只为值得的人提供服务。";
			next;
			mes "[Thorn]";
			mes "而且在完成那些任务前，你也没有我能强化的装备。";
		}
		else if (para_2nd04 == 0) {
			mes "很高兴你来了。";
			mes "作为铁匠，我一直需要铁制材料。";
			next;
			mes "[Thorn]";
			mes "当然，最后会有奖励……";
			mes "所以……";
			next;
			mes "[Thorn]";
			if (BaseLevel < 80) {
				mes "给我带些材料来。";
				mes "我需要 20 个铁矿石和 10 个铁。";
			}
			else {
				mes "给我带些材料来。";
				mes "带来 20 个废铁板。";
				.@add = 1;
			}
			mes "这些东西应该不难找，你能马上带来吗？";
			next;
			switch( select( "没问题。", "我不想去。" ) ) {
				mes "[Thorn]";
			case 1:
				mes "谢谢你。";
				mes "慢慢来，我会等着。";
				para_2nd04 = 1 + .@add;
				setquest (7238 + .@add);// Errands for Thorn (easy/hard)
				close;
			case 2:
				mes "咦……？";
				mes "看来你太忙了，没法帮我。";
				close;
			}
		}
		else if (para_2nd04 == 1 || para_2nd04 == 2) {
			if (para_2nd04 == 1) {
				setarray .@item[0],1002,998;// Iron_Ore, Iron
				setarray .@amount[0],20,10;
				setarray .@countitem[0],countitem(1002),countitem(998);
				.@string$ = "我让你带来 20 个铁矿石和 10 个铁。";
			}
			else {
				.@item[0] = 7319;
				.@amount[0] = 20;
				.@countitem[0] = countitem(7319);
				.@add = 1;
				.@string$ = "我让你带来 20 个废铁板。";
			}
			if (.@countitem[0] >= .@amount[0] && .@countitem[1] >= .@amount[1]) {
				mes "让我猜猜……";
				mes "你带来了品质最好的材料。";
				mes "很好。";
				next;
				mes "[Thorn]";
				mes "我总是需要更多铁制材料。";
				mes "这次不给你普通奖励，我会给你一件高级装备。";
				next;
				mes "[Thorn]";
				mes "如果以后有需要强化的装备，再来找我。";
				delitem .@item[0],.@amount[0];
				if (.@countitem[1])
					delitem .@item[1],.@amount[1];
				para_2nd04 = 3;
				erasequest (7238 + .@add);
				setquest 7240;
			}
			else {
				mes .@string$;
				mes "我很确定这并不难。";
			}
		}
		else if (para_2nd04 == 3) {
			mes "好了，就是这样。";
			mes "今天就到这里。";
			mes "现在你可以让我强化装备，我会帮你完成。";
			next;
			mes "[Thorn]";
			mes "如果你有这些装备，就带来给我。";
			mes "伊甸园斗篷 II、伊甸园铠甲 IV、伊甸园战靴 IV。";
		}
		else if (para_2nd04 == 4) {
			if (checkquest(7241,PLAYTIME) == 0) {
				mes "晚点再来吧。";
				mes "你得先等一段时间。";
			}
			else {
				mes "嗯……";
				mes "我们要做什么……哦，别担心。";
				mes "晚点再来找我。";
				erasequest 7241;// Errands for Thorn timer
				para_2nd04 = 0;
			}
		}
		close;
	case 3:
		if (para_2nd02 < 1) {
			mes "乌尔教官不允许我这样做。";
			mes "别来烦我。";
		}
		else if (para_2nd02 == 1) {
			mes "好吧，我给你装备。";
			mes "我会给你值得自豪的优质护甲和装备。";
			next;
			mes "[Thorn]";
			mes "现在，^4d4dff请确认背包中有足够的空位。^000000";
			next;
			if (select( "让我整理背包。", "我有空位。" ) == 1) {
				mes "[Thorn]";
				mes "那就去整理吧。";
				mes "腾出背包空间，这样才能领取武器、战靴和其他装备。";
				close;
			}
			mes "[Thorn]";
			if (BaseJob == Job_Knight || BaseJob == Job_Crusader) {
				callsub L_Select,"单手剑、双手剑或长矛。",
					1197,"伊甸园屠杀者 III","双手剑，攻击力 200",
					13434,"伊甸园军刀 III","单手剑，攻击力 185",
					1434,"伊甸园长矛 I","单手，攻击力 165";
			}
			else if (BaseJob == Job_Assassin) {
				callsub L_Select,"你可以选择短剑或拳刃。",
					13066,"伊甸园短剑 III","短剑，魔法攻击力 +80，攻击力 165",
					1289,"伊甸园拳刃 I","拳刃，攻击力 155";
			}
			else if (BaseJob == Job_Rogue || BaseClass == Job_Novice)
				getitem 13066,1;// P.Dagger III
			else if (BaseJob == Job_Alchemist || BaseJob == Job_Blacksmith) {
				callsub L_Select,"你可以选择钝器、军刀或斧头。",
					16014,"伊甸园钝器 III","钝器，攻击力 172",// P_Mace3
					13434,"伊甸园军刀 III","剑，攻击力 185",//P.Saber III
					1391,"伊甸园斧头 I","斧头，攻击力 195"; //P.Two-Handed Axe I
			}
			else if (BaseJob == Job_Wizard)
				getitem 1658,1;// P.Staff III
			else if (BaseJob == Job_Sage) {
				callsub L_Select,"",
					1658,"伊甸园法杖 III","法杖，魔法攻击力 +170，智力 +4，攻击力 60", //P.Staff III
					1583,"伊甸园魔法辞典 I","书，魔法攻击力 +100，攻击力 135"; //P.Book I
			}
			else if (BaseJob == Job_Priest) {
				callsub L_Select,"",
					1658,"伊甸园法杖 III","法杖，魔法攻击力 +170，智力 +4，攻击力 60", //P.Staff III
					1583,"伊甸园魔法辞典 I","书，魔法攻击力 +100，攻击力 135", //P.Book I
					16014,"伊甸园钝器 III","钝器，攻击力 172"; //P.Mace III
			}
			else if (BaseJob == Job_Monk) {
				callsub L_Select,"",
					1831,"伊甸园拳套 I","拳套，攻击力 120", //P.Knuckle I
					16014,"伊甸园钝器 III","钝器，攻击力 172"; //P.Mace III
			}
			else if (BaseJob == Job_Hunter)
				getitem 18106,1;// P.Bow III
			else if (BaseJob == Job_Bard) {
				callsub L_Select,"",
					18106,"伊甸园弓 III","弓，攻击力 140", //P.Bow III
					1931,"伊甸园吉他 I","吉他，攻击力 125"; //P.Guitar I
			}
			else if (BaseJob == Job_Dancer) {
				callsub L_Select,"",
					18106,"伊甸园弓 III","弓，攻击力 140", //P.Bow III
					1986,"伊甸园鞭子 I","鞭子，攻击力 125"; //P.Tail I
			}
			else if (Class == Job_Ninja) {
				callsub L_Select,"",
					13066,"伊甸园短剑 III","短剑，魔法攻击力 +80，攻击力 165", //P.Dagger III
					13310,"伊甸园风魔手里剑 I","风魔手里剑，魔法攻击力 +50，攻击力 170"; //P.Huuma Suriken I
			}
			else if (Class == Job_Star_Gladiator)
				getitem 1583,1; //P.Book I
			else if (Class == Job_Soul_Linker) {
				callsub L_Select,"",
					13066,"伊甸园短剑 III","短剑，魔法攻击力 +80，攻击力 165", //P.Dagger III
					1658,"伊甸园法杖 III","法杖，魔法攻击力 +170，智力 +4，攻击力 60"; //P.Staff III
			}
			else if (Class == Job_Gunslinger)
				getitem 13114,1; //P.Revolver III
			else if (Class == Job_Summoner)
				getitem 26101,1; //P.Foxtail III
			else {
				mes "嗯，你符合领取装备的条件。";
				mes "是的，我明白。";
				next;
				mes "[Thorn]";
				mes "不过好像出了点问题，我也不清楚是什么……";
				close;
			}
			para_2nd02 = 2;
			getitem 18514,1;// Paradise Hat II
			getitem 2571,1;// Paradise Mantle II
			getitem 2473,1;// Paradise Boots IV
			getitem 15031,1;// Paradise Uniform IV
			mes "这是你的装备。";
			mes "我也会把这套装备配套的其他物品给你。";
		}
		else if (para_2nd02 == 2) {
			mes "你可以强化我给你的装备。";
			mes "武器专家 BK 在伊甸园总部，他能帮你强化。";
			next;
			mes "[Thorn]";

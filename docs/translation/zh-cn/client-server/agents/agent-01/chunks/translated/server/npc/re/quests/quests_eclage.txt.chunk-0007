	else if (ep14_2_big == 14) {
		mes "发生什么事了？你查到什么了吗？";
		next;
		select("他们让我把这个交给你。");
		mes "[乌哈里]";
		mes "嗯……";
		next;
		mes "[乌哈里]";
		if (countitem(6547)) {
//		if (countitem(7347)) {// Lab_Staff_Record
			mes "这是……^0000cd研究报告^000000。我的哥哥，他一定看过这个，然后……";
			next;
			mes "[乌哈里]";
			mes "可是，嗯……这个……还有其他报告吗？";
			next;
			mes "["+ strcharinfo(0) +"]";
			mes "没有，那是他们交给我的唯一一份。";
			next;
			mes "[乌哈里]";
			mes "哦……真遗憾……";
			mes "好吧，我得更深入地分析它。我需要一些^0000cd时间^000000。";
			delitem 6547,1;// Stained_Research_Book
			//delitem 7347,1;// Lab_Staff_Record
			ep14_2_big = 15;
			changequest 14128,14131;
		}
		else {
			mes "嗯……你带来的是什么？";
			next;
			mes "["+ strcharinfo(0) +"]";
			mes "啊！什么……！？";
			mes "它去哪儿了？";
			next;
			mes "["+ strcharinfo(0) +"]";
			mes "我一定是在来的路上把它弄丢了。";
			next;
			mes "["+ strcharinfo(0) +"]";
			mes "我会把它带给你的。";
		}
	}
	else if (ep14_2_big == 15) {
		if (checkquest(14131,PLAYTIME) == 0) {
			mes "我还在查阅报告。这份报告非常复杂，所以还需要更多时间。";
			close;
		}
		mes "太好了，你来得正是时候。";
		next;
		mes "[乌哈里]";
		mes "我研究了这份报告，但还是不太明白它究竟在说明什么。";
		mes "这里写着所需材料，可它们很难收集，使用方法也有些难以理解……";
		next;
		mes "[乌哈里]";
		mes "他们为什么要使用高阶拉斐恩的翅膀碎片和萨法的头发？";
		next;
		mes "[乌哈里]";
		mes "不但很难得到它们，获取它们的方法也非常残酷……";
		next;
		select("你哥哥的体格是……");
		mes "[乌哈里]";
		mes "你具体是什么意思？";
		next;
		mes "["+ strcharinfo(0) +"]";
		mes "他的身体更大，像萨法一样发着蓝光，翅膀也比普通拉斐恩的大得多。";
		next;
		mes "[Wuhari]";
		mes "不知道这是不是^0000cd融合两个种族独特特征的方法^000000……";
		next;
		mes "[乌哈里]";
		mes "但即使是为了自己的实验，我哥哥也需要某人的翅膀和头发……他真的会……";
		next;
		mes "["+ strcharinfo(0) +"]";
		mes "根据你哥哥的说法，他是从一名高阶拉斐恩那里得到这些材料的。";
		next;
		mes "[乌哈里]";
		mes "越研究就越觉得奇怪……光是想到要做这种事……";
		next;
		mes "[乌哈里]";
		mes "不管怎样，为了找到恢复我哥哥身体的方法，我必须研究这个。";
		mes "真希望说明能写得更详细一些。";
		next;
		mes "["+ strcharinfo(0) +"]";
		mes "那我再去问问你哥哥？";
		next;
		mes "[乌哈里]";
		mes "那大概没用。我哥哥一定也用这些说明做过实验，但他一定是因为失败才变成那样。";
		next;
		mes "[乌哈里]";
		mes "要准确理解这些说明，我们必须^0000cd找到提供这份报告的拉斐恩^000000。";
		next;
		switch( select("这太不确定了。:我去找那个拉斐恩吗？") ) {
			mes "[乌哈里]";
		case 1:
			mes "是的，我知道。所以我才请"+ strcharinfo(0) +"你帮忙。";
			mes strcharinfo(0) +"你经验丰富，也具备必要的技能。";
			next;
			mes "[乌哈里]";
			mes "但我想这还是太勉强了。";
			mes "一定让你很为难……";
			emotion ET_CRY;
			ep14_2_big = 16;
			erasequest 14131;
			close;
		case 2:
			mes "这正是我想拜托你的事！";
			mes "哇，你身经百战的直觉真是厉害。";
			next;
			mes "[乌哈里]";
			mes "无论如何，真的非常感谢！";
			mes "看来我又要依靠你了！谢谢！";
			next;
			mes "[乌哈里]";
			mes "首先，请去找到那个拉斐恩，问问如何让他的身体恢复原状。还要问清楚这份报告当初为什么会交给我哥哥。";
			next;
			mes "[乌哈里]";
			mes "最好先询问^0000cd村里的人^000000。";
			ep14_2_big = 17;
			changequest 14131,14133;
			close;
		}
	}
	else if (ep14_2_big == 16) {
		mes strcharinfo(0) +"，你要帮我吗？";
		next;
		switch( select("帮助他人很重要。:不了，我只是路过。") ) {
			mes "[Wuhari]";
		case 1:
			mes "太感谢你了！！！";
			mes "太棒了！这个世界还没有让我失望！我知道这请求太过分了……";
			next;
			mes "[Wuhari]";
			mes "请找到那个拉斐恩，问问如何让他的身体恢复原状。还要问清楚这份报告当初为什么会交给我哥哥。";
			next;
			mes "[Wuhari]";
			mes "最好先询问^0000cd村里的人^000000。";
			ep14_2_big = 17;
			setquest 14133;
			close;
		case 2:
			mes "真的吗？";
			mes "可是我现在有点忙。";
			close;
		}
	}
	else if (ep14_2_big > 16 && ep14_2_big < 24)
		mes "你找到那个高阶拉斐恩了吗？";
	else if (ep14_2_big == 24) {
		mes "你找到那个高阶拉斐恩了吗？";
		next;
		mes "["+ strcharinfo(0) +"]";
		mes "嗯……那个拉斐恩^0000cd已经死了。^000000";
		next;
		mes "[乌哈里]";
		mes "什么？他死了？";
		next;
		mes "- 最好不要告诉他武胡鲁的事 -";
		next;
		mes "["+ strcharinfo(0) +"]";
		mes "我去他最后出现的地方时，他已经死了。";
		mes "难道是王宫察觉有人在进行危险的研究，于是派人来处理了吗？";
		next;
		mes "[乌哈里]";
		mes "有可能……";
		next;
		mes "[乌哈里]";
		mes "可他们为什么偏偏把那项研究交给我哥哥？";
		next;
		mes "["+ strcharinfo(0) +"]";
		mes "也许他们利用了他对自己体格的自卑，以及他卓越的才智。";
		next;
		mes "["+ strcharinfo(0) +"]";
		mes "如果他成功了，他们可能会为了不可告人的目的，把低阶拉斐恩也牵扯进来。";
		next;
		mes "[乌哈里]";
		mes "啊，太可怕了……";
		next;
		mes "["+ strcharinfo(0) +"]";
		mes "对你哥哥来说，失败或许反而更好。";
		mes "虽然这对他来说很不幸。";
		next;
		mes "[乌哈里]";
		mes "难道我哥哥他……";
		next;
		mes "[乌哈里]";
		mes "不，我相信一定有办法。";
		mes "无论如何我都要恢复他的身体，就算只能靠自己。";
		next;
		mes "["+ strcharinfo(0) +"]";
		mes "有什么我能帮忙的吗？";
		next;
		mes "[乌哈里]";
		mes "你已经帮了我这么多……既然如此，我再拜托你一件事。这可能是最后一件了。";
		next;
		mes "[乌哈里]";
		mes "这份研究报告中的所有^0000CD材料^000000都很难由我独自收集。"+ strcharinfo(0) +"我想请你帮忙。";
		next;
		mes "[乌哈里]";
		mes "我需要的材料是^0000CD以下各一份：拉斐恩的翅膀碎片、萨法的头发、卡沃代尼罗、纯化布拉迪姆、黑暗符文、血之符文^000000。";
		next;
		mes "[乌哈里]";
		mes "我能信任的只有你，"+ strcharinfo(0) +"。谢谢。";
		ep14_2_big = 25;
		changequest 14140,14141;
	}
	else if (ep14_2_big == 25) {
		mes "你把所有材料都带来了吗？";
		next;
		if (select("我全都带来了。:分别是什么来着？") == 2) {
			mes "[乌哈里]";
			mes "我需要的材料是^0000cd以下各一份：拉斐恩的翅膀碎片、萨法的头发、卡沃代尼罗、纯化布拉迪姆、黑暗符文、血之符文 ^000000。";
			close;
		}
		mes "["+ strcharinfo(0) +"]";
		mes "当然！";
		next;
		mes "[Wuhari]";
		if (!countitem(6548) || !countitem(6545) || !countitem(972) || !countitem(6090) || !countitem(7511) || !countitem(7563)) {
			mes "嗯……你说材料在哪里，"+ strcharinfo(0) +"？";
			mes "没有它们我没法继续工作。";
			close;
		}
		mes "一定很不容易吧！太感谢你了！";
		next;
		mes "[乌哈里]";
		mes "我会用这些材料继续研究。";
		next;
		mes "[乌哈里]";
		mes "谢谢你一路以来对我的帮助。";
		next;
		mes "[乌哈里]";
		mes "这不算什么，只是我的一点谢意。";
		next;
		mes "[乌哈里]";
		mes "祝你今后一切顺利，"+ strcharinfo(0) +"。";
		delitem 6548,1; //Piece_Of_Lapine_Wing
		delitem 6545,1; //Firm_Hair
//		delitem 6548,1; //Piece_Of_Lapine_Wing
//		delitem 1020,1; //Long_Hair
		delitem 972,1; //Karvodailnirol
		delitem 6090,1; //Purified_Bradium
		delitem 7511,1; //Rune_Of_Darkness
		delitem 7563,1; //Bloody_Rune
		ep14_2_big = 26;
		erasequest 14141;
		getexp 300000,0;
		getitem 6081,5; //Splendide_Coin
	}
	else if (ep14_2_big == 26)
		mes "研究还在继续。如果有一线希望，我一定会紧紧抓住，可现在还找不到。";
	close;
}

ecl_in02,149,117,4	script	Wuhuru#eclbig	4_M_FAIRYFREAK,{
	WeightBigQuest;
	if (ep14_2_big < 2) {
		mes "[可疑男子]";
		mes "......";
	}
	else if (ep14_2_big == 2) {
		mes "["+ strcharinfo(0) +"]";
		mes "嗯……打扰一下。";
		mes "我在找一个人。";
		next;
		mes "[可疑男子]";
		mes "......";
		next;
		mes "["+ strcharinfo(0) +"]";
		mes "你好？";
		next;
		mes "[可疑男子]";
		mes "......";
		next;
		mes "["+ strcharinfo(0) +"]";
		mes "你听得到吗？";
		mes "打扰一下！";
		next;
		mes "[可疑男子]";
		mes "......";
		next;
		mes "["+ strcharinfo(0) +"]";
		mes "这家伙是谁？";
		ep14_2_big = 3;
		setquest 14119;
	}
	else if (ep14_2_big == 3) {
		mes "["+ strcharinfo(0) +"]";
		mes "打扰一下。你听得到吧？";
		next;
		mes "[可疑男子]";
		mes "......";
		next;
		mes "["+ strcharinfo(0) +"]";
		mes "我不是坏人。我只是在这座监狱里找一个人。";
		next;
		mes "[可疑男子]";
		mes "......";
		next;
		mes "["+ strcharinfo(0) +"]";
		mes "啊！真让人恼火！！！";
		next;
		mes "[可疑男子]";
		mes "......";
		next;
		mes "- 可疑男子似乎完全不想说话 -";
		ep14_2_big = 4;
		changequest 14119,14120;
	}
	else if (ep14_2_big == 4) {
		mes "["+ strcharinfo(0) +"]";
		mes "喂，别人问你话，至少回答一下吧？！";
		next;
		mes "[Suspicious man]";
		mes "......";
		next;
		mes "["+ strcharinfo(0) +"]";
		mes "......";
		next;
		mes "[Suspicious man]";
		mes "......";
		next;
		mes "["+ strcharinfo(0) +"]";
		mes "......";
		next;
		mes "[Suspicious man]";
		mes "......";
		next;
		mes "["+ strcharinfo(0) +"]";
		mes "我只是想把这个交给他！";
		next;
		mes "["+ strcharinfo(0) +"]";
		mes "就是这个！这个东西！";
		mes "对吧？你看得见吗？就是这个！！！";
		ep14_2_big = 5;
		changequest 14120,14121;
	}
	else if (ep14_2_big == 5) {
		if (!countitem(6546)) {
//		if (!countitem(7148)) {// Mother_Letter
			mes "[可疑男子]";
			mes "你说你有什么？";
			next;
			mes "- 到处都找不到那封信 -";
			close;
		}
		mes "[可疑男子]";
		mes "一……封信……？";
		next;
		mes "["+ strcharinfo(0) +"]";
		mes "没错！一封信！我正想把它交给他！";
		next;
		mes "["+ strcharinfo(0) +"]";
		mes "你知道武胡鲁是谁吗？";
		next;
		mes "[可疑男子]";
		mes "武……胡鲁……？那是……";
		next;
		mes "["+ strcharinfo(0) +"]";
		mes "看来^0000cd你就是武胡鲁^000000。你的弟弟让我把这封^0000cd信^000000交给你。";
		mes "不过我没想到会用这种方式送到。";
		next;
		mes "[武胡鲁]";
		mes "谢……谢你。";
		next;
		mes "- 你留下武胡鲁独自阅读信件 -";
		delitem 6546,1;// Younger_Bro_Letter
//		delitem 7148,1;// Mother_letter
		ep14_2_big = 6;
		changequest 14121,14122;
		erasequest 14118;
	}
	else if (ep14_2_big > 5) {
		mes "[武胡鲁]";
		if (ep14_2_big == 6) {
			mes "我、我不敢相信自己竟然这样对待弟弟……乌哈里还好吗？";
			mes "啊……我都做了些什么……？";
			next;
			mes "[武胡鲁]";
			mes "既然你见过乌哈里，就能看出我原本不是这个样子。我和弟弟的体格^0000cd特别矮小^000000，即使在低阶拉斐恩中也是如此。";
			next;
			mes "[武胡鲁]";
			mes "所以在重视外表的拉斐恩中，我们总是忍不住感到自卑。";
			next;
			mes "[武胡鲁]";
			mes "由于体格不如别人，我们总是在家学习。多亏如此，我们变得比别人聪明得多。";
			next;
			mes "[武胡鲁]";
			mes "有一天，一名叫^0000cd姆瓦里迪卡^000000的高阶拉斐恩来拜访我。";
			mes "他说自己是研究设施的成员，想让我帮助他们进行一项秘密研究。";
			next;
			mes "[武胡鲁]";
			mes "那时他给了我一份研究报告，里面有说明和所需材料。";
			mes "那是一项^0000cd强化体格，让拉斐恩变得更强壮、更美丽^000000的研究。";
			next;
			mes "[武胡鲁]";
			mes "我立刻答应了。对我来说，这显然是获得认可的机会。没有理由犹豫。";
			mes "而且，如果我能找到让自己变大的方法……";
			next;
			mes "[武胡鲁]";
			mes "他要求我不能泄露任何相关信息。所以我遵从了他的所有要求。";
			mes "连我最信任的弟弟，我都没有告诉。";
			next;
			mes "[武胡鲁]";
			mes "我不知道那究竟是好是坏……";
			next;
			mes "[武胡鲁]";
			mes "无论如何，经过大量研究，我终于得到了结果。";
			mes "但我们手头没有实验对象。";
			next;
			mes "[武胡鲁]";
			mes "所以我让自己成为实验对象。";
			mes "结果你也看到了……";
			next;
			mes "[武胡鲁]";
			mes "实验一失败，那个拉斐恩就立刻抽身离开了。";
			mes "我试着独自处理一切，但最后还是落到了这里。";
			next;
			mes "[武胡鲁]";
			mes "拥有这副身体后，我才意识到自己宁愿变回原来矮小的身体。";
			mes "现在的我就是个怪物。";
			next;
			mes "[武胡鲁]";
			mes "我并不想变成这样……是我的贪念太过分了。";
			next;
			mes "[武胡鲁]";
			mes "要是我早点知道……";
			next;
			mes "[武胡鲁]";
			mes "抱歉，我说得太多了。";
			mes "不管怎样，我想自己已经没法离开这里了。";
			next;
			mes "[武胡鲁]";
			mes "如果你能离开这里，能请你告诉我弟弟，让他想办法帮我恢复原状吗？";
			next;
			mes "[武胡鲁]";
			mes "我的弟弟比我矮小，但一直都比我聪明。";
			next;
			mes "[武胡鲁]";
			mes "拜托你了。";
			ep14_2_big = 7;
			changequest 14122,14123;
		}
		else if (ep14_2_big == 7 || ep14_2_big == 8)
			mes "拜托你了。";
		else if (ep14_2_big < 23) {
			mes "你见过乌哈里了吗？太好了。";
			mes "即使在这座监狱里，我终于也能稍微安心一点了。";
			next;
			mes "[武胡鲁]";
			mes "今天这间牢房格外温暖。";
		}
		else if (ep14_2_big == 23) {
			mes "有好消息吗？";
			next;
			select("我在野外看到了拉斐恩的尸体。");
			mes "[武胡鲁]";
			mes "……拉斐恩的尸体？";
			next;
			mes "["+ strcharinfo(0) +"]";
			mes "^0000cd那是一名高阶拉斐恩的尸体。^000000他的样子很像那个委托你进行研究的拉斐恩。";
			next;
			mes "["+ strcharinfo(0) +"]";
			mes "我还遇到一个人，他在你被关进这里之前，亲眼见过另一名更高大的拉斐恩追赶那名拉斐恩。";
			next;
			mes "["+ strcharinfo(0) +"]";
			mes "后来他被杀了。";
			next;
			mes "[武胡鲁]";
			mes "你想说什么？";
			mes "你是在说我是杀人犯吗？";
			next;
			select("你因为愤怒杀了他吗？");
			mes "[武胡鲁]";
			mes "就算我……承认自己是杀人犯……又有什么意义？";
			next;
			mes "[武胡鲁]";
			mes "无论如何，我都被困在这副身体里……";
			next;
			mes "[武胡鲁]";
			mes "你看，是他骗了我！";
			next;
			mes "[武胡鲁]";
			mes "他让我相信研究的目标是让拉斐恩变得更美、更强，甚至把我安排成实验对象！";
			next;
			mes "[武胡鲁]";
			mes "实验一失败，他就逃跑了！";
			next;
			mes "[武胡鲁]";
			mes "他直到临死前才告诉我真相。";
			next;
			mes "[武胡鲁]";
			mes "他的真正目的，是向上级证明^000cd自己的研究能力货真价实^000000。";
			next;
			mes "[武胡鲁]";
			mes "他说自己甚至没有研究实验内容，也没有检查那些材料。";
			next;
			mes "[武胡鲁]";
			mes "而且他还用卑鄙的手段获得了萨法的头发！";
			next;
			mes "[武胡鲁]";
			mes "后来王宫发现了这项研究的手段，追捕我们，并以参与项目为由逮捕了我。";
			next;

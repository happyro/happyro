		if (checkweight(607,1) == 0) {
			mes "- 再次交谈前必须减轻";
			mes "负重 -";
			close;
		}
		mes "[Daughter Luen]";
		mes "我告诉了父母";
		mes "以及其他所有人。";
		next;
		mes "[Daughter Luen]";
		mes "我的男朋友就是那个人。";
		mes "我早就知道这件事了。";
		mes "但是我不能告诉父母，因为他们一旦知道真相，";
		mes "就会更加反对他……";
		next;
		mes "[Daughter Luen]";
		mes "不过，真的非常感谢你在身体和精神上帮助我们两人。";
		mes "这是我的一点小小心意。";
		mes "再次谢谢你。";
		ep14_2_detect = 11;
		changequest 9236,9237;
		getitem 6081,1; //Splendide_Coin
		getexp 300000,150000;
	}
	else {
		mes "[Daughter Luen]";
		mes "真的非常感谢你帮助我们";
		mes "解决身体和精神上的困难。";
		mes "再次谢谢你。";
	}
	close;
}

ecl_in04,85,110,3	script	Father Dames#eclage	4_M_FAIRYSOLDIER,{
	if (ep14_2_detect < 1) {
		mes "[Father Dames]";
		mes "呵呵，居然发生了这种事。";
	}
	else if (ep14_2_detect == 1) {
		mes "[Father Dames]";
		mes "这种事情还是第一次";
		mes "发生在我们身上。";
	}
	else if (ep14_2_detect == 2) {
		if (isbegin_quest(9227) == 1) {
			mes "["+ strcharinfo(0) +"]";
			mes "想必你也听说了，为了查出这起事件的窃贼，我要开始询问你。";
			mes "请你尽力配合。";
			next;
			mes "["+ strcharinfo(0) +"]";
			mes "我不会重复提问，";
			mes "请认真回答。";
			next;
			select("你从哪里回来？");
			mes "[Father Dames]";
			mes "我刚和朋友见完面，";
			mes "正准备回家。";
			next;
			mes "[Father Dames]";
			mes "我和他聊了聊女儿。";
			mes "也聊了聊我的妻子。";
			mes "还聊了聊人生。";
			next;
			mes "[Father Dames]";
			mes "然后我回到家，";
			mes "却发现家里一片狼藉。";
			mes "我的妻子和女儿都受到了很大打击。";
			mes "而你倒在地上不省人事。";
			next;
			.@menu = select("他是怎样的朋友？:你们还聊了别的事吗？");
			switch(.@menu) {
			case 1:
				mes "[Father Dames]";
				mes "他并不是特别刻薄或坏的人。";
				next;
				mes "[Father Dames]";
				mes "虽然他有点不成熟，";
				mes "不管年纪多大都是如此……";
				mes "往好处说，他活得很年轻；往坏处说，他就是个不成熟的家伙。";
				next;
				mes "[Father Dames]";
				mes "除此之外，";
				mes "他完全不会惹麻烦。";
				mes "他就是这样的朋友。";
				break;
			case 2:
				mes "[Father Dames]";
				mes "其实……";
				mes "就在不久前，";
				mes "那家伙请我";
				mes "帮他一个忙……";
				next;
				mes "[Father Dames]";
				mes "他说自己急需";
				mes "一笔钱……";
				mes "希望我能帮帮他……";
				next;
				mes "[Father Dames]";
				mes "可是我自己也没有钱，";
				mes "而且朋友之间谈钱";
				mes "也不太合适，";
				mes "所以我向他道歉，";
				mes "请他吃了顿饭后";
				mes "就送他离开了。";
				next;
				mes "[Father Dames]";
				mes "除此之外，";
				mes "我看不出他有什么";
				mes "可疑之处……";
				break;
			}
			next;
			.@menu2 = select("他以前可疑过吗？:事件发生后你怀疑他吗？");
			switch(.@menu2) {
			case 1:
				mes "[Father Dames]";
				mes "老实说，";
				mes "我怀疑我的妻子。";
				mes "她最近总是在抱怨";
				mes "各种鸡毛蒜皮的小事。";
				next;
				mes "[Father Dames]";
				mes "不管我说什么，她不是说‘不’，就是说‘我不喜欢’。";
				mes "也没有什么特别的理由，她只是为了反对我而";
				mes "反对我。";
				next;
				mes "[Father Dames]";
				mes "最近她总是要这要那，还会因为各种事情发火。";
				mes "真是让人受够了。";
				break;
			case 2:
				mes "[Father Dames]";
				mes "被偷的东西是我妻子的项链……";
				mes "那是我送给她的项链。";
				next;
				mes "[Father Dames]";
				mes "家里被盗时，我真的很担心。";
				mes "但当我发现被偷的是那条项链……";
				mes "我想起了妻子不久前对我说的话。";
				next;
				mes "[Father Dames]";
				mes "她说她想要一条新项链。";
				mes "我告诉她下个生日会买一条给她……";
				mes "可她还是生气了。";
				mes "不知道最后发生这种事，是不是和那件事有关。";
				break;
			}
			next;
			select("谢谢你的坦诚回答。");
			mes "[Father Dames]";
			mes "没什么。";
			mes "希望我的回答";
			mes "能帮到你。";
			next;
			mes "[Father Dames]";
			mes "要是我们能尽快";
			mes "抓到那个窃贼，";
			mes "那就太好了。";
			changequest 9227,9228;
			setquest (9241 +.@menu + 2*.@menu2);// 9244-9247
			close;
		}
	}
	else if (ep14_2_detect == 3 || ep14_2_detect == 4) {
		mes "[Father Dames]";
		mes "看来你正在进行现场调查。";
		mes "希望你能";
		mes "全力以赴。";
	}
	else if (ep14_2_detect <= 7) {
		mes "[Father Dames]";
		mes "看来你还在继续调查。";
		mes "你也打算";
		mes "去询问我的朋友吗？";
	}
	else if (ep14_2_detect == 8 || ep14_2_detect == 9) {
		mes "[Father Dames]";
		mes "调查";
		mes "进行得怎么样了？";
	}
	else if (ep14_2_detect == 10)
		end;
	else if (ep14_2_detect == 11) {
		if (checkweight(607,1) == 0) {
			mes "- 再次交谈前必须减轻";
			mes "负重 -";
			close;
		}
		mes "[Father Dames]";
		mes "我从克鲁扬那里";
		mes "听说了大部分事情。";
		next;
		mes "[Father Dames]";
		mes "真是令人震惊……";
		mes "不过从某些方面来说，";
		mes "我也能理解他为什么这么做。";
		next;
		mes "[Father Dames]";
		mes "谢谢你一直以来";
		mes "帮助我们。";
		mes "你为我们经历了很多。";
		next;
		mes "[Father Dames]";
		mes "我知道从今以后";
		mes "该由我们自己";
		mes "解决这些事情了……";
		next;
		mes "[Father Dames]";
		mes "这个给你。";
		mes "再次谢谢你，";
		mes "希望你今后的工作";
		mes "一切顺利。";
		ep14_2_detect = 12;
		changequest 9237,9238;
		getitem 607,1; //Yggdrasilberry
		getexp 300000,150000;
	}
	else {
		mes "[Father Dames]";
		mes "再次谢谢你，";
		mes "希望你今后的工作";
		mes "一切顺利。";
	}
	close;
}

ecl_in04,77,104,5	script	Mother Rosa#eclage	4_F_MORAFINE1,{
	if (ep14_2_detect == 2) {
		if (isbegin_quest(9228) == 1) {
			mes "["+ strcharinfo(0) +"]";
			mes "想必你也听说了，为了查出这起事件的窃贼，";
			mes "我要开始询问你。";
			mes "请你尽力配合。";
			next;
			mes "["+ strcharinfo(0) +"]";
			mes "我不会重复提问，请认真回答。";
			next;
			select("你从哪里回来？");
			mes "[Mother Rosa]";
			mes "我其实不太信任你，";
			mes "但为了我的项链，";
			mes "我还是会和你谈谈。";
			next;
			mes "[Mother Rosa]";
			mes "我在附近的商店";
			mes "逛了逛，看看有没有";
			mes "应该买的东西。";
			next;
			mes "[Mother Rosa]";
			mes "没有看到什么喜欢的东西，";
			mes "所以就直接回家了。";
			mes "就是这样。";
			next;
			.@menu = select("你为什么直接进屋？:有没有什么可疑之处？");
			switch (.@menu) {
			case 1:
				mes "[Mother Rosa]";
				mes "我第一次看到你";
				mes "倒在那里时，简直";
				mes "吓得魂不附体，甚至想，";
				mes "只要你还活着，";
				mes "我就得想办法救你！";
				mes "我没那么坏，你知道吗！";
				next;
				mes "[Mother Rosa]";
				mes "可是如今的世界，哪有那么简单？";
				mes "现在意外这么多！";
				mes "像我这样柔弱的家庭主妇，真的什么也做不了！";
				next;
				mes "[Mother Rosa]";
				mes "所以我先走进屋里，";
				mes "打算和家人一起";
				mes "把你扶起来！";
				mes "可我一进屋，";
				mes "就发现家里乱成一团，";
				mes "简直像被抢过一样！";
				next;
				mes "[Mother Rosa]";
				mes "门口还躺着一个人！";
				mes "家里又被洗劫一空！";
				mes "我害怕得";
				mes "不敢出去扶你！";
				mes "你明白了吗？";
				break;
			case 2:
				mes "[Mother Rosa]";
				mes "我进屋时，";
				mes "除了房间很乱以外，";
				mes "没有发现别的事！";
				next;
				mes "[Mother Rosa]";
				mes "那么多东西，为什么偏偏";
				mes "偷走我的项链……？";
				mes "那个窃贼为什么不";
				mes "干脆把那条没用的";
				mes "狗偷走！";
				next;
				mes "[Mother Rosa]";
				mes "越想越让人生气！";
				mes "......";
				mes "............";
				mes "对不起……我只是没来由地";
				mes "拿你撒气了……";
				next;
				mes "[Mother Rosa]";
				mes "总之，我不觉得有什么";
				mes "特别的地方。";
				break;
			}
			next;
			.@menu2 = select("你怀疑谁吗？:还有别的东西不见了吗？");
			switch (.@menu2) {
			case 1:
				mes "[Mother Rosa]";
				mes "不确定。";
				mes "虽然我丈夫对我很冷淡，但他不是坏人。";
				mes "我那个不争气的女儿不听我的话，不肯和男朋友分手。";
				mes "但她还是个好女孩……";
				next;
				mes "[Mother Rosa]";
				mes "而且我们家也不是";
				mes "堆满贵重物品，";
				mes "那条项链只是我";
				mes "真正珍爱的";
				mes "一件宝物……";
				next;
				mes "[Mother Rosa]";
				mes "被偷的就是它！";
				mes "肯定不是我的家人！";
				mes "我绝不可能怀疑他们！";
				mes "绝对不会！";
				break;
			case 2:
				mes "[Mother Rosa]";
				mes "我们家没有什么特别贵重的东西。";
				next;
				mes "[Mother Rosa]";
				mes "其实那条项链也不算";
				mes "特别昂贵。只是它对我来说";
				mes "有着多重";
				mes "意义……";
				next;
				mes "[Mother Rosa]";
				mes "很明显，那条项链";
				mes "并不值多少钱。";
				mes "就算拿去卖……";
				mes "我想也卖不了多少。";
				mes "我完全不明白为什么会被偷。";
				break;
			}
			next;
			select("谢谢你的坦诚回答。");
			mes "[Mother Rosa]";
			mes "我真的希望……";
			mes "你能找到我的项链。";
			next;
			mes "[Mother Rosa]";
			mes "那条项链是";
			mes "我丈夫送给我的……";
			mes "所以对我来说";
			mes "非常重要。";
			changequest 9228,9229;
			setquest (9245 +.@menu + 2*.@menu2);// 9248-9251
			ep14_2_detect = 3;
		}
		close;
	}
	if (ep14_2_detect == 12) {
		if (checkweight(607,2) == 0) {
			mes "- 再次交谈前必须减轻";
			mes "负重 -";
			close;
		}
		mes "[Mother Rosa]";
		mes "......";
		mes "我听说了事情的全部经过。";
		next;
		mes "[Mother Rosa]";
		mes "我本来就不太喜欢克鲁扬，但我对女儿更加失望。";
		next;
		mes "[Mother Rosa]";
		mes "其实我一直很怀疑……";
		mes "尽管如此，我还是衷心感谢你的帮助。";
		next;
		mes "[Mother Rosa]";
		mes "但是……";
		mes "结果发现";
		mes "克鲁扬和我的女儿";
		mes "都没有那条项链。";
		mes "想到这一点我还是很难过。";
		next;
		mes "- 我小心地把项链交给 -";
		mes "- 罗莎 -";
		mes "- 并告诉她项链被发现的地点 -";
		next;
		mes "[Mother Rosa]";
		mes "原来如此……我不知道它";
		mes "会在那种地方。";
		mes "你早就找到了它，为了查明事情背后的真相，";
		mes "却一直把这件事藏到现在。";
		mes "我没想到你会如此深思熟虑……";
		next;
		mes "[Mother Rosa]";
		mes "我真的";
		mes "无话可说。";
		mes "非常非常感谢你。";
		next;
		mes "[Mother Rosa]";
		mes "我没有什么好东西……";
		mes "如果你不介意，";
		mes "请收下这点谢意。";
		mes "非常非常感谢你。";
		ep14_2_detect = 13;
		changequest 9238,9239;
		getitem 6081,1;// Splendide_Coin
		getitem 607,1;// Yggdrasilberry
		getexp 300000,150000;
		close;
	}
	mes "[Mother Rosa]";
	if (ep14_2_detect < 1)
		mes "天啊，怎么会这样……？";
	else if (ep14_2_detect == 1) {
		mes "我从没想过";
		mes "我们家会被盗！";
	}
	else if (ep14_2_detect == 3 || ep14_2_detect == 4) {
		mes "你要进行现场调查吗？";
		mes "太好了，尽管去调查吧！";
	}
	else if (ep14_2_detect >= 5 && ep14_2_detect <= 7) {
		mes "你会认真进行";
		mes "调查的，对吧？";
	}
	else if (ep14_2_detect == 8 || ep14_2_detect == 9) {
		mes "调查进行得";
		mes "还顺利吗……？";
		mes "不知为何，我总觉得……无法相信……";
	}
	else {
		mes "我真的";
		mes "无话可说。";
		mes "非常非常感谢你。";
	}
	close;
}


eclage,164,102,3	script	Cruyan#eclage	4_M_FAIRYKID,{
	if (ep14_2_detect < 3 || (ep14_2_detect >= 10 && ep14_2_detect <= 12)) end;
	if (ep14_2_detect == 5 && isbegin_quest(9231) == 1) {
		mes "["+ strcharinfo(0) +"]";
		mes "你好。";
		mes "你就是刚才来过家里的";
		mes "露恩的男朋友吧？";
		next;
		mes "[Cruyan]";
		mes "啊。";
		mes "...";
		mes "是的，没错。";
		mes "那你是……";
		next;
		mes "["+ strcharinfo(0) +"]";
		mes "我是负责";
		mes "调查这起案件的侦探。";
		mes "我有几个问题要问，希望你能配合。";
		next;
		select("十分钟前你在哪里？");
		mes "[Cruyan]";
		if (checkweight(607,1) == 0) {
			mes "你的物品太重了，";
			mes "让我无法确认自己的不在场证明。";
			mes "请减轻";
			mes "负重后再回来。";
			close;
		}
		mes "当时我在繁花之地。";
		mes "我听说那里的魔物";
		mes "越来越多，";
		mes "所以就去清理了一些，顺便锻炼身体。";
		next;
		mes "[Cruyan]";
		mes "项链不是我偷的！";
		next;
		mes "[Cruyan]";
		mes "无论如何我都会找到那条项链，把它带回给妈妈！";
		next;
		select("发生过什么特别的事吗？");

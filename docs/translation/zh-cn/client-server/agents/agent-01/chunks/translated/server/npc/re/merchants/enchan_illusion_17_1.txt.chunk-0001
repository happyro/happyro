sp_cor,152,158,4	script	Butterfly Merchant#sp_cor	4_M_ORIENT01,{
	mes "[蝴蝶商人]";
	mes "嘿，很高兴见到你。";
	mes "我在出售" + getitemname(100903) + "，要买吗？";	// Teleport_Ep17_01
	close2;
	callshop "shop_sp_cor";
	end;
}

sp_cor,136,156,3	script	Grace Operator#ext162	4_M_REPAIR,{
	mes "[恩典操作员]";
	mes "你好。";
	mes "我们有可以用" + mesitemlink( 25723 ) + "交换的^4d4dff恩典^000000装备。";
	mes "我会根据你的职业引导你交换物品。";
	close2;
	switch( eaclass() & EAJ_THIRDMASK ) {
	case EAJ_RUNE_KNIGHT:
		.@str$ = "JOB_RUNE_KNIGHT";
		break;
	case EAJ_WARLOCK:
		.@str$ = "JOB_WARLOCK";
		break;
	case EAJ_RANGER:
		.@str$ = "JOB_RANGER";
		break;
	case EAJ_ARCH_BISHOP:
		.@str$ = "JOB_ARCH_BISHOP";
		break;
	case EAJ_MECHANIC:
		.@str$ = "JOB_MECHANIC";
		break;
	case EAJ_GUILLOTINE_CROSS:
		.@str$ = "JOB_GUILLOTINE_CROSS";
		break;
	case EAJ_ROYAL_GUARD:
		.@str$ = "JOB_ROYAL_GUARD";
		break;
	case EAJ_SORCERER:
		.@str$ = "JOB_SORCERER";
		break;
	case EAJ_MINSTRELWANDERER:
		.@str$ = "JOB_MINSTREL";
		break;
	case EAJ_SURA:
		.@str$ = "JOB_SURA";
		break;
	case EAJ_GENETIC:
		.@str$ = "JOB_GENETIC";
		break;
	case EAJ_SHADOW_CHASER:
		.@str$ = "JOB_SHADOW_CHASER";
		break;
	default:
		switch( Class ) {
		case JOB_SUPER_NOVICE_E:
		case JOB_SUPER_BABY_E:
		case JOB_HYPER_NOVICE:
			.@str$ = "JOB_SUPER_NOVICE_E";
			break;
		case JOB_KAGEROU:
		case JOB_OBORO:
		case JOB_BABY_KAGEROU:
		case JOB_BABY_OBORO:
		case JOB_SHINKIRO:
		case JOB_SHIRANUI:
			.@str$ = "JOB_KAGEROU";
			break;
		case JOB_REBELLION:
		case JOB_BABY_REBELLION:
		case JOB_NIGHT_WATCH:
			.@str$ = "JOB_REBELLION";
			break;
		case JOB_SUMMONER:
		case JOB_BABY_SUMMONER:
		case JOB_SPIRIT_HANDLER:
			.@str$ = "JOB_SUMMONER";
			break;
		case JOB_STAR_EMPEROR:
		case JOB_BABY_STAR_EMPEROR:
		case JOB_STAR_EMPEROR2:
		case JOB_BABY_STAR_EMPEROR2:
		case JOB_SKY_EMPEROR:
		case JOB_SKY_EMPEROR2:
			.@str$ = "JOB_STAR_EMPEROR";
			break;
		case JOB_SOUL_REAPER:
		case JOB_BABY_SOUL_REAPER:
		case JOB_SOUL_ASCETIC:
			.@str$ = "JOB_SOUL_REAPER";
			break;
		default:
			end;
		}
		break;
	}
	callshop "shop_ext171_" + .@str$;
	end;
}

// Enchanting Supply Exchange NPC - Official iRO Conversion
sp_cor,108,130,5	script	Rebellion#rm171_7	4_F_REBELLION3,{
	if (isbegin_quest(17019) == 0) {
		mes "[叛乱者]";
		mes "叛乱者目前正在使用这栋建筑。";
		mes "还有周围的几栋建筑。";
		next;
		mes "[叛乱者]";
		mes "我们已经很久没有这么忙了。";
		mes "虽然我不喜欢和总统及公司合作，但忙于某件事的感觉仍然不错。";
		close;
	}
	if (isbegin_quest(16353) < 2) {
		mes "[叛乱者]";
		mes "所以你收到了消息。队长们正在里面开会。应该是埃琳娜·沃尔科娃队长叫你来的。";
		mes "……我正准备叫她，但她已经来了。";
		cloakoffnpcself( "Elena Volkova#rm171_0" );
		npctalk "埃琳娜·沃尔科娃：啊，我一直在找你，冒险者。", "Elena Volkova#rm171_0", bc_self;
		if (isbegin_quest(16352) == 0)
			setquest 16352;
		close;
	}
	if (isbegin_quest(16360) < 2) {
		mes "[叛乱者]";
		mes "叛乱者目前正在使用这栋建筑。";
		mes "还有周围的几栋建筑。";
		next;
		mes "[叛乱者]";
		mes "我们已经很久没有这么忙了。";
		mes "虽然我不喜欢和总统及公司合作，但忙于某件事的感觉仍然不错。";
		close2;
		if (isbegin_quest(16352) == 1)
			erasequest 16352;
		end;
	}
	mes "[叛乱者]";
	mes "你带来损坏的武器了吗？想见那个科学罪犯吗？他就在里面。要我叫他出来吗？";
	mes "还是你有事找我？我可以交换武器改造装置和防具改造模块。";
	cloakoffnpcself( "Elyumina#rm171_4" );
	npctalk "叛乱者：嘿，罪犯。有人找你。", "Rebellion#rm171_7", bc_self;
	npctalk "伊露米娜：好了好了！我来了！你们真可悲，没有我只能拿豆袋战斗。", "Elyumina#rm171_4", bc_self;
	next;
	switch (select("见伊露米娜。", "申请武器改造装置。", "申请防具改造模块。")) {
	case 1:
		mes "[叛乱者]";
		mes "好好聊吧。";
		mes "我们花了很久才说服他，但他最终同意改造武器和防具。他很擅长这件事，每天都在工作。";
		close;
	case 2:
		npctalk "伊露米娜：什么？如果只是让我像雕像一样站在这里，你们干嘛叫我？你们这些混蛋！", "Elyumina#rm171_4", bc_self;
		if (checkweight(1201,3) == 0) {
			mes "[叛乱者]";
			mes "要武器改造装置吗？需要 5 个" + mesitemlink( 25723 ) + "或 1,000,000 Zeny。";
			mes "你的背包满了。请先腾出空间。";
			close;
		}
		mes "[叛乱者]";
		mes "要武器改造装置吗？需要 5 个" + mesitemlink( 25723 ) + "或 1,000,000 Zeny。";
		mes "想要武器的话，可以和伊露米娜谈。";
		next;
		if (select("申请武器改造装置（物理）。", "申请武器改造装置（魔法）。") == 1) {
			// .@item_id = 23773;	// EP17_1_SPC02
			.@group = IG_EP17_1_SPC02;
			setarray .@ids[0],23776,23777,23778;
		} else {
			// .@item_id = 23774;	// EP17_1_SPC03
			.@group = IG_EP17_1_SPC03;	// EP17_1_SPC03
			setarray .@ids[0],23779,23780,23781;
		}
		mes "[叛乱者]";
		mes "我可以随机给你" + mesitemlink( .@ids[0] ) + "、";
		mes mesitemlink( .@ids[1] ) + "、";
		mes "或" + mesitemlink( .@ids[2] ) + "。";
		mes "你有哪一种材料，5 个科尔核心还是 1,000,000 Zeny？";
		next;
		disable_items;
		switch (select("5 个科尔核心", "1,000,000 Zeny")) {
		case 1:
			if (checkweight(1201,3) == 0) {
				mes "[叛乱者]";
				mes "好像出了问题。请确认背包有足够空间，并且带齐交换材料。";
				close;
			}
			if (countitem(25723) < 5) {
				mes "[叛乱者]";
				mes "科尔核心不足。请重新检查背包。";
				close;
			}
			delitem 25723,5;	// EP17_1_EVT39
			break;
		case 2:
			if (checkweight(1201,3) == 0) {
				mes "[叛乱者]";
				mes "好像出了问题。请确认背包有足够空间，并且带齐交换材料。";
				close;
			}
			if (Zeny < 1000000) {
				mes "[叛乱者]";
				mes "Zeny 不足。请重新检查钱包。";
				close;
			}
			Zeny -= 1000000;
		}
		// consumeitem .@item_id;
		getgroupitem(.@group);
		mes "[叛乱者]";
		mes "我把手头最好的给你了。";
		mes "想精炼的话，旁边的 <NAVI>[铁罐]<INFO>sp_cor,106,136,0,101,0</INFO></NAVI> 可以帮助你。";
		close;
	case 3:
		npctalk "伊露米娜：什么？如果只是让我像雕像一样站在这里，你们干嘛叫我？你们这些野蛮人！", "Elyumina#rm171_4", bc_self;
		mes "[叛乱者]";
		mes "要防具改造模块吗？需要 30 个" + mesitemlink( 25669 ) + "和 5 个" + mesitemlink( 25723 ) + "。";
		if (checkweight(1201,3) == 0) {
			mes "你的背包满了。请先腾出空间。";
			close;
		}
		mes "获得的种类会随机决定。";
		next;
		if (select("申请防具改造模块。", "取消。") == 2) {
			mes "[叛乱者]";
			mes "想要防具改造模块时随时来找我。";
			close;
		}
		disable_items;
		if (countitem(25669) < 30 || countitem(25723) < 5) {
			mes "[叛乱者]";
			mes "每个模块需要 30 个神秘组件和 5 个科尔核心。你没有带齐，请检查。";
			close;
		}
		if (checkweight(1201,3) == 0) {
			mes "[叛乱者]";
			mes "好像出了问题。请确认背包有足够空间，并且带齐交换材料。";
			close;
		}
		mes "[叛乱者]";
		mes "我给你一个防具改造模块。";
		mes "想精炼的话，旁边的 <NAVI>[铁罐]<INFO>sp_cor,106,136,0,101,0</INFO></NAVI> 可以帮助你。";
		delitem 25669,30;	// EP17_1_EVT02
		delitem 25723,5;	// EP17_1_EVT39
		// consumeitem 23775;	// EP17_1_SPC04
		getgroupitem(IG_EP17_1_SPC04);
		close;
	}
	end;

OnInit:
	questinfo (QTYPE_QUEST, QMARK_YELLOW, " isbegin_quest(17019) == 1 && isbegin_quest(16352) == 0 ");
	end;
}

// Equipment Exchange NPC - Official iRO Conversion
sp_cor,111,130,3	script	Elyumina#rm171_4	4_EP17_ELYUMINA,{
	if (isbegin_quest(16360) < 2) {
		cutin "ep171_elyumina02",0;
		mes "[伊露米娜]";
		mes "啊！我正要专心研究，你为什么一直叫我？我很忙，好吗？无聊的话就去带更多损坏的武器来！";
		close2;
		cloakonnpcself( "Elyumina#rm171_3" );
		cutin "",255;
		end;
	}
	if (checkweight(28136,2) == 0) {
		cutin "ep171_elyumina03",0;
		mes "[伊露米娜]";
		mes "你不是来要武器或防具的吗？你的背包满了。我没时间等你翻背包。之后再来。";
		next;
		mes "- 背包已满。请腾出空间后再来和我谈话。-";
		close3;
	}
	cutin "ep171_elyumina01",0;
	mes "[伊露米娜]";
	mes "有什么重要的事，竟然要打断我的研究？最好真的很重要。";
	next;
	cutin "",255;
	switch (select("申请 OS 武器。", "申请幻影防具。")) {
	case 1:
		cutin "ep171_elyumina01",0;
		mes "[伊露米娜]";
		mes "OS 武器？带来 1 个" + mesitemlink( 25668 ) + "和 50 个" + mesitemlink( 25669 ) + "，我就处理。";
		mes "我会从手头的种类中随便给你一个。为什么要让你挑？";
		next;
		cutin "",255;
		if (select("交换 OS 武器。", "查看可用列表。") == 2) {
			cutin "ep171_elyumina03",0;
			mes "[伊露米娜]";
			mes "啧啧。我说过我做的都很好。你真的非挑不可吗？好吧，听好了。";
			next;
			mes "[伊露米娜]";
			mes "单手剑：" + mesitemlink( 13493 );
			mes "双手剑：" + mesitemlink( 21047 );
			mes "法杖：" + mesitemlink( 26151 );
			mes "书：" + mesitemlink( 28629 );
			mes "斧：" + mesitemlink( 28136 );
			mes "钝器：" + mesitemlink( 16088 );
			mes "弓：" + mesitemlink( 18178 );
			mes "弩：" + mesitemlink( 18179 );
			mes "拳刃：" + mesitemlink( 28038 );
			mes "拳套：" + mesitemlink( 1862 );
			mes "狙击步枪：" + mesitemlink( 28253 );
			mes "短剑：" + mesitemlink( 28755 );
			mes "弓：" + mesitemlink( 18180 );
			mes "长枪：" + mesitemlink( 32019 );
			mes "钝器：" + mesitemlink( 16089 );
			close3;
		}
		disable_items;
		if (countitem(25668) < 1 || countitem(25669) < 50) {
			cutin "ep171_elyumina03",0;
			mes "[伊露米娜]";
			mes "我说过，带来 1 件损坏的武器和 50 个神秘组件。别人说话时要听。";
			close3;
		}
		if (checkweight(28136,2) == 0) {
			cutin "ep171_elyumina03",0;
			mes "[伊露米娜]";
			mes "……什么？出问题了。";
			mes "当然不是我的问题，是你的。检查背包是否已满，或材料是否齐全。";
			close3;
		}
		cutin "ep171_elyumina04",0;
		mes "[伊露米娜]";
		mes "好了。想要另一个就带更多损坏的武器和神秘组件来。";
		mes "都是因为你，我才被关在这里修玩具。你能处理好吧？";
		delitem 25668,1;	// EP17_1_EVT01
		delitem 25669,50;	// EP17_1_EVT02
		// consumeitem 23772;	// EP17_1_SPC01
		getgroupitem(IG_EP17_1_SPC01);
		close3;
	case 2:
		cutin "ep171_elyumina04",0;
		mes "[伊露米娜]";
		mes "想要幻影防具就带来 50 个" + mesitemlink( 25723 ) + "。我会给你一件。";
		mes "让我看看……哦，我什么时候做了这么多种类？好吧，我今天很慷慨。你想要什么？";
		next;
		cutin "",255;
		switch (select("幻影防具", "幻影引擎翼", "幻影腿", "幻影助推器", "幻影战斗芯片")) {
		case 1:
			setarray .@item[0],15376,15377;
			break;
		case 2:
			setarray .@item[0],20933,20934;
			break;
		case 3:
			setarray .@item[0],22196,22197;
			break;
		case 4:
			setarray .@item[0],32207,32208;
			break;
		case 5:
			setarray .@item[0],32209,32210;
			break;
		}
		cutin "ep171_elyumina01",0;
		mes "[伊露米娜]";
		mes mesitemlink( .@item[0] );
		mes mesitemlink( .@item[1] );
		mes "要哪一个？";
		next;
		cutin "",255;
		.@id = .@item[ select( getitemname(.@item[0]), getitemname(.@item[1]) ) -1 ];
		cutin "ep171_elyumina04",0;
		mes "[伊露米娜]";
		mes "好，是" + getitemname(.@id) + "，对吧？真的要用它交换 50 个科尔核心吗？";
		next;
		cutin "",255;
		if (select( "交换。", "不交换。" ) == 2) {
			cutin "ep171_elyumina03",0;
			mes "[伊露米娜]";
			mes "嘿，你在开玩笑吗？我可是好心帮忙！";
			close3;
		}
		disable_items;
		if (countitem(25723) < 50) {
			cutin "ep171_elyumina02",0;
			mes "[伊露米娜]";
			mes "嘿，你在开玩笑吗？你的科尔核心不够！我可是好心帮忙！";
			enable_items;
			close3;
		}
		cutin "ep171_elyumina04",0;
		mes "[伊露米娜]";
		mes "给你，这件" + getitemname(.@id) + "。我敢说这是你拥有过的最好防具。你真的该感激我。";
		delitem 25723,50;	// EP17_1_EVT390
		getitem .@id,1;
		enable_items;
		close3;
	}
	end;

OnInit:
	cloakonnpc();
	end;
}

// Illusion Enchanter - Walkthrough Conversion
sp_cor,106,136,3	script	RS26#illusion_enchant	4_SYS_MSG,{
	if(!checkweight(1201,1) || (MaxWeight - Weight) < 1000){
		mes "你携带的物品数量太多，无法继续对话。";
		mes "请整理物品后再试。";
		close;
	}
	disable_items;
	mes "[RS26]";
	mes strcharinfo(0)+".";
	mes "欢迎，欢迎！";
	next;
	switch (select("探索装置。:附魔幻影防具。:附魔幻影引擎翼。:附魔幻影腿。:附魔幻影饰品【右】。:附魔幻影饰品【左】")) {
	case 1:
		mes "^0000FF# 我是最新的全息技术，能完美呈现自然反应和动作。#^000000";
		next;
		mes "[RS26]";
		mes "我的技术只能在未来城市找到。我是 RS26，一台雷根贝勒机器人。";
		npctalk "叛乱者：哦，没有模块那台机器毫无用处。","Rebellion#171_cor_merchant",bc_self;
		next;
		mes "[RS26]";
		mes "带来装有强化模块的幻影装备，我就能按你的要求升级。";
		next;
		mes "[RS26]";
		mes "这些模块适用于标准装备，不会摧毁物品。但升级次数会因装备不同而变化。";
		next;
		mes "[RS26]";
		mes "需要帮助时再回来找我~";
		close;
	case 2:
		.@part = EQI_ARMOR;
		.@index = 0;
		setarray .@id,15376,15377;
		break;
	case 3:
		.@part = EQI_GARMENT;
		.@index = 1;
		setarray .@id,20933,20934;
		break;
	case 4:
		.@part = EQI_SHOES;
		.@index = 3;
		setarray .@id,22196,22197;
		break;
	case 5:
		.@part = EQI_ACC_R;
		.@index = 2;
		setarray .@id,32207,32209;
		break;
	case 6:
		.@part = EQI_ACC_L;
		.@index = 2;
		setarray .@id,32208,32210;
		break;
	}
	switch (select("取消。:普通等级。:稀有等级。:独特等级。:传说等级。")) {
	case 1:
		mes "[RS26]";
		mes "我就停在这里。";
		close;
		
	case 2:
		.@min = 25670;
		.@max = 25677;
		break;
		
	case 3:
		.@min = 25678;
		.@max = 25692;
		break;
		
	case 4:
		.@min = 25693;
		.@max = 25699;
		break;
		
	case 5:
		.@min = 25700;
		.@max = 25705;
		break;
	}
	.@menu$ = "Cancel.:";
	for(.@i = .@min; .@i < (.@max + 1); .@i++){
		.@module_id[getarraysize(.@module_id)] = .@i;
		.@item_name$ = getitemname(.@i);
		.@item_name$ = replacestr(.@item_name$,"Modification Module (","");
		.@item_name$ = replacestr(.@item_name$,")","");
		.@menu$ += (!countitem(.@i) ? "^AAAAAA":"") + .@item_name$ + (!countitem(.@i) ? "^000000:":":");
	}

//===== rAthena Script =======================================
//= Arrow Quivers
//===== By: ==================================================
//= Muad_Dib (Prometheus Project); L0ne_W0lf
//===== Current Version: =====================================
//= 1.1
//===== Compatible With: =====================================
//= rAthena Project
//===== Description: =========================================
//= [Official Conversion]
//= Turns arrows into Arrow Quivers.
//= Breakdown of Subroutine "S_BuyQuiver"
//= arg(0): Type of Arrow to be packaged (item ID).
//= arg(1): How many of each 'getarg(0)' arrow per quiver.
//= arg(2): The cost of making a 'getarg(0)' quiver.
//= arg(3): The quiver given by the NPC (item ID).
//===== Additional Comments: =================================
//= 1.0 Added Mora NPC. [Euphy]
//= 1.1 Updated to match the official scripts. [Euphy]
//= 1.2 Update regarding the Barter Shop [JohnnyPlayy, Capuche]
//============================================================

// Mora :: ep14_1_tre
//============================================================
mora,106,117,3	script	Quiver Maker#mora	4_M_RAFLE_GR,{
	if (checkweight(1201,1) == 0) {
		mes "[箭袋制作师]";
		mes "你携带的东西太多了。";
		mes "清理一些背包空间再回来，我会告诉你有趣的事。";
		close;
	}
	if (MaxWeight - Weight < 2000) {
		mes "[箭袋制作师]";
		mes "你似乎被这些东西累坏了。";
		mes "清理一些背包空间再回来，我会告诉你有趣的事。";
		close;
	}
	mes "[箭袋制作师]";
	mes "莫拉村民问箭袋有什么用。他们根本不懂世事。";
	mes "难怪他们对箭袋一无所知——整天只会在叶子上涂果酱。";
	next;
	if (getbattleflag("feature.barter")) {
		.@menu$ = "我想要箭";
	}
	switch( select("请给我制作箭袋。", .@menu$, "什么是箭袋？") ) {
	case 1:
		if (getbattleflag("feature.barter")) {
			mes "[箭袋制作师]";
			mes "终于有人懂得箭袋的真正价值了。我会为懂得它价值的人制作。";
			close2;
			callshop "Quiver_Archer", 1;
			end;
		}
		mes "[箭袋制作师]";
		mes "终于有人欣赏箭袋了！";
		mes "我能制作精灵箭袋和狩猎箭袋。";
		mes "你需要哪一种？";
		next;
		switch(select("精灵箭袋:狩猎箭袋:我不需要箭袋。")) {
		case 1: callsub S_BuyQuiver,1773,500,500,12575; //Arrow_Of_Elf_Cntr
		case 2: callsub S_BuyQuiver,1774,500,500,12576; //Hunting_Arrow_Cntr
		case 3:
			mes "[箭袋制作师]";
			mes "你可以从我旁边的工具商那里购买箭。";
			close;
		}
		end;
	case 2:
		if (getbattleflag("feature.barter")) {
			mes "[箭袋制作师]";
			mes "我不卖普通箭。这些是只能在这里购买的工艺箭。你应该懂得它的价值吧？";
			close2;
			callshop "Catch_Arrows", 1;
		}
		end;
	case 3:
		mes "[箭袋制作师]";
		mes "箭可能又细又轻，但携带成百上千支箭就像扛着整根木头。";
		next;
		mes "[箭袋制作师]";
		mes "有了箭袋，就能把箭装进去，节省重量和空间。";
		mes "如果你感兴趣，我可以为你缝制一个。";
		close;
	}
	end;

S_BuyQuiver:
	.@item_req = getarg(0);
	.@req_amount = getarg(1);
	if (countitem(getarg(0)) < .@req_amount) {
		mes "[箭袋制作师]";
		mes "带来至少 "+ .@req_amount +" 个"+ getitemname(.@item_req) +"，我就给你制作箭袋。";
		close;
	}
	mes "[箭袋制作师]";
	mes "哦，我看到你手里有"+ getitemname(.@item_req) +"！";
	mes "想使用箭袋吗？真的很方便！";
	mes "如果你感兴趣，我可以用 "+ .@req_amount +" 支箭交换一个箭袋，费用是 ^FF3131"+getarg(2)+" Zeny^000000。";
	next;
	switch(select("交换你拥有的所有箭:只要一个箭袋:不交换")) {
	case 1:
		set .@arrows, countitem(.@item_req);
		set .@quiver, .@arrows / .@req_amount;
		set .@arrows_used, .@quiver * .@req_amount;
		set .@arrow_zeny01, .@quiver * getarg(2);
		mes "你拥有的箭数量：^3131FF"+.@arrows+"^000000";
		mes "可获得的箭袋数量：^3131FF"+.@quiver+"^000000";
		mes "交换所需 Zeny：^3131FF"+.@arrow_zeny01+" Zeny^000000";
		next;
		mes "交换吗？";
		next;
		if(select("交换:不交换") == 2) {
			mes "[箭袋制作师]";
			mes "嘿，你不会怀疑我的手艺吧？";
			close;
		}
		break;
	case 2:
		set .@quiver, 1;
		set .@arrows_used, .@req_amount;
		set .@arrow_zeny01, getarg(2);
		set .@zeny_mes,1;
		break;
	case 3:
		mes "[箭袋制作师]";
		mes "嘿，你不会怀疑我的手艺吧？";
		close;
	}
	if (Zeny < .@arrow_zeny01) {
		mes "[箭袋制作师]";
		if (.@zeny_mes == 1)
			mes "我说过只收人类货币，你还不愿意花钱吗？";
		else
			mes "你不会真以为能白拿到杰作吧？";
		close;
	}
	mes "[箭袋制作师]";
	mes "嘿，给你。";
	mes "有^3131FF一件事你需要知道^000000——记住它。";
	mes "^FF0000负重超过 70% 时无法使用箭袋。^000000";
	mes "最好记住，否则之后可能会遇到麻烦。";
	set Zeny, Zeny-.@arrow_zeny01;
	delitem .@item_req,.@arrows_used;
	getitem getarg(3),.@quiver;
	close;
}

//= Basic Shops
//============================================================

//= Arrows
-	marketshop	Catch_Arrows	HIDDEN_NPC,1773:5:-1,1774:5:-1

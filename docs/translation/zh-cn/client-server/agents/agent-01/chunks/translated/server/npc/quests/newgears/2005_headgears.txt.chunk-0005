
gl_prison1,100,48,5	script	Rybio#LhzHat	1201,{
	if(ZLMASKQ == 2)
	{
		mes "[Rybio]";
		mes "我通常一看到你们人类，就会";
		mes "冲上去疯狂砍杀，不过今天";
		mes "我没那个心情，所以给你一次";
		mes "逃命的机会。";
		mes "给你一次逃命的机会。";
		mes "好好把握吧。";
		next;
		switch( select( "谈谈芬达克。", "逃命吧。" ) )
		{
			case 1:
				mes "[Rybio]";
				mes "什么——？你认识我认识的那个";
				mes "芬达克？真奇怪。不过，他和泽洛托斯";
				mes "似乎有某种关系。";
				mes "我也说不清楚那是什么……";
				mes "嗯，是爱情？";
				mes "大概吧。";
				next;
				mes "[Rybio]";
				mes "总之，芬达克最近一直";
				mes "表现得非常奇怪。我想泽洛托斯";
				mes "爱他爱到了虐待他的地步，";
				mes "让他现在害怕人类。";
				mes "她对他的伤害太深了。";
				mes "所以他如今害怕人类。";
				next;
				mes "[Rybio]";
				mes "嗯。你知道什么能帮忙吗？";
				mes "黑暗水晶碎片。对人类来说";
				mes "毫无价值，但黑暗生物吃下它，";
				mes "就会唤醒更多内心的恶魔。";
				mes "听起来很可怕吧？";
				mes "确实挺吓人的。";
				next;
				mes "[Rybio]";
				mes "芬达克个头很大，行为却像个彻头彻尾的懦夫，";
				mes "你最好让他吃下^3131FF369个黑暗水晶碎片^000000。别";
				mes "担心，米德加尔特各地应该都能找到。";
				next;
				mes "[Rybio]";
				mes "不过我不明白，像你这样的";
				mes "人类为什么要帮助我们中的";
				mes "一个。你到底想得到什么？";
				mes "这样做对你有什么好处？";
				set ZLMASKQ,3;
				close;
			case 2:
				mes "[Rybio]";
				mes "没错！";
				mes "快跑，离开这里！";
				mes "如果你跑得不够快，";
				mes "我可能会吃了你，人类！";
				mes "……嗯……大概不会。";
				close;
		}
	}
	else if(ZLMASKQ == 3)
	{
		mes "[Rybio]";
		mes "我不明白，像你这样看似英勇的";
		mes "冒险家，为什么要帮助芬达克？";
		mes "是泽洛托斯勒索你了吗？";
		mes "还是发生了什么别的事？";
		mes "她是不是威胁你了？";
		next;
		mes "[Rybio]";
		mes "你可以让他";
		mes "吃下^3131FF369个黑暗水晶碎片^000000，";
		mes "唤醒沉睡在他体内的恶魔，";
		mes "这样或许就能帮到他。";
		mes "你明白我的意思吧？";
		mes "就这么简单。";
		close;
	}
	else if(ZLMASKQ == 4)
	{
		mes "[Rybio]";
		mes "给他喂了那么多";
		mes "黑暗水晶碎片也没用？";
		mes "那应该万无一失才对！天啊，";
		mes "芬达克的内心恶魔到底";
		mes "出了什么问题？！真是的……";
		mes "这可真让人头疼。";
		next;
		mes "[Rybio]";
		mes "嗯，我不知道你还能试什么。";
		mes "也许可以想办法激励他。";
		mes "用逆向心理学？";
		mes "和人类讨论这些真奇怪。";
		mes "哈哈哈~";
		mes "真是不可思议。";
		set ZLMASKQ,5;
		close;
	}
	else if(ZLMASKQ == 5)
	{
		mes "[Rybio]";
		mes "芬达克看起来很强悍，不过我想";
		mes "他也不算彻底邪恶。没错。";
		mes "我们怪物也不是全都邪恶。";
		mes "我们怪物并不全是坏蛋……";
		mes "只是大多数都很坏。";
		close;
	}
}

airport,148,41,3	script	Freight Manager#toast	852,{
	mes "[Kirishu]";
	mes "哎呀……";
	mes "快到午餐时间了，";
	mes "但他还没过来。";
	mes "去哪儿了——哦！";
	mes "你好，欢迎来到艾因布洛克~";
	next;
	if (isequipped(5107) || countitem(5107)) {
		mes "[Kirishu]";
		mes "等等，那是脆吐司！";
		mes "你一定是帮助过我朋友卡西斯的人。";
		mes "我欠你一个人情，";
		mes "没有你的帮助，我就没午餐可吃了！";
		mes "真是太感谢你了！";
		next;
		mes "[Kirishu]";
		mes "听说卡西斯最近生意";
		mes "遇到了麻烦，不过我相信他能";
		mes "熬过去。我只是不知道他为什么";
		mes "这么久还没到。";
		mes "我要饿死了！";
		close;
	}
	else {
		mes "[Kirishu]";
		mes "你要去朱诺吗？如果要去，";
		mes "我想请你帮个忙。";
		mes "或者你需要我帮你";
		mes "找找这座城市的路？";
		mes "我可以给你指路。";
		mes "需要帮忙吗？";
		next;
		switch(select("好，我要去朱诺。","我需要帮助找路！","取消。")) {
			case 1:
				mes "[Kirishu]";
				mes "如果你要去朱诺，又不忙的话，";
				mes "能替我去拜访一位叫卡西斯的";
				mes "糕点师吗？";
				mes "他是我的老朋友，";
				mes "我有点担心他。";
				mes "请帮我去看看他。";
				next;
				mes "[Kirishu]";
				mes "通常他都会在这个时候准时";
				mes "给我们送午餐，";
				mes "但午餐还没到，";
				mes "我忍不住想：‘发生什么事了？’";
				next;
				mes "[Kirishu]";
				mes "当然，如果说我的担心里没有";
				mes "饥饿的因素，那就是在撒谎。";
				mes "总之，有时间的话，你可以在";
				mes "朱诺的面包店找到卡西斯。";
				mes "谢谢你，冒险家。";
				close;
			case 2:
				mes "[Kirishu]";
				mes "首先，走到机场外面，";
				mes "你可以找到指南员，";
				mes "他们能告诉你艾因布洛克";
				mes "所有重要的景点和去处。";
				mes "有任何问题都可以问他们。";
				mes "他们会为你提供帮助。";
				next;
				mes "[Kirishu]";
				mes "如果你想在乘坐飞艇前后休息，";
				mes "可以使用二楼的乘客休息室。";
				mes "这里很安静，也很舒适。";
				mes "记住这个小提示吧~";
				mes "下次旅行时会派上用场。";
				mes "祝你旅途愉快。";
				next;
				mes "[Kirishu]";
				mes "你还有什么问题";
				mes "想趁现在问我吗？";
				mes "我会尽量回答。";
				next;
				switch(select("我能和你合影吗？","关于艾因布洛克","不用了，谢谢。")) {
					case 1:
						mes "[Kirishu]";
						mes "什么？";
						mes "我不常听到这种请求，";
						mes "不过拍一张照片应该";
						mes "也没什么坏处。";
						mes "那就拍一张吧。";
						mes "请站到我旁边。";
						next;
						cutin "ein_soldier.bmp",1;
						mes "[Kirishu]";
						mes "茄子~";
						close2;
						cutin "",255;
						end;
					case 2:
						mes "[Kirishu]";
						mes "你知道吗，很难相信艾因布洛克";
						mes "这么快就成了工业重镇。";
						mes "我想这是因为大家需要";
						mes "在艾音贝赫开采的矿石。";
						mes "这些矿石支撑着城市的发展。";
						mes "真是令人惊叹。";
						next;
						mes "[Kirishu]";
						mes "虽然艾音贝赫和艾因布洛克";
						mes "谁也离不开谁，但艾音贝赫的状况";
						mes "比艾因布洛克差得多。";
						mes "你去过的话，就知道我是什么意思。";
						mes "简直太悲惨了。";
						next;
						mes "[Kirishu]";
						mes "这座城市的大部分繁荣都归功于";
						mes "工厂的生产力。";
						mes "工厂带来巨大财富的同时，";
						mes "也带来了污染问题。";
						mes "我们必须认真面对这些问题。";
						mes "否则城市会受到伤害。";
						next;
						mes "[Kirishu]";
						mes "如果听到烟雾警报，";
						mes "你应该尽快跑到安全的地方！";
						mes "污染程度很高时待在户外";
						mes "是很危险的！";
						mes "千万不要在外面逗留。";
						mes "请务必注意安全！";
						close;
					case 3:
						mes "[Kirishu]";
						mes "那么，祝你在艾因布洛克";
						mes "旅行愉快。";
						mes "希望你在这里玩得开心。";
						close;
				}
			case 3:
				mes "[Kirishu]";
				mes "祝你在艾因布洛克玩得开心，";
				mes "冒险家。";
				mes "希望你在施瓦茨瓦尔德共和国的";
				mes "旅途一切愉快。";
				mes "欢迎下次再来。";
				close;
		}
	}
}

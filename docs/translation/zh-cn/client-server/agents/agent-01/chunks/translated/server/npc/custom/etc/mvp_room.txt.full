//===== rAthena Script =======================================
//= Private MVP & Branch Room
//===== By: ==================================================
//= AnnieRuru
//===== Current Version: =====================================
//= 1.0
//===== Compatible With: =====================================
//= rAthena Project
//===== Description: =========================================
//= Allows players to rent an MVP room for personal use,
//= or for a party or guild.
//===== Additional Comments: =================================
//= 1.0 First version, edited. [Euphy]
//============================================================

prontera,148,174,5	script	Private MVP Room	100,{
	mes "[私人 MVP 房间]";
	mes "请选择私人 MVP 房间。";
	if ( getvariableofnpc( .rentcost, "MVP Summoner" ) )
		mes "租用房间 "+ getvariableofnpc( .timeout, "MVP Summoner" ) +" 分钟需要 "+ callfunc("F_InsertComma", getvariableofnpc( .rentcost, "MVP Summoner" ) ) +" Zeny。";
	else
		mes "房间只能使用 "+ getvariableofnpc( .timeout, "MVP Summoner" ) +" 分钟。";
	mes " ";
	for ( .@i = 1; .@i <= 8; .@i++ )
		if ( getvariableofnpc( .renttime[.@i], "MVP Summoner" ) )
			mes "房间 #"+ .@i +" = "+ .color$[ .type[.@i] ] + .whoinuse$[.@i] +"^000000";
	next;
	.@room = select(
		"MVP 房间 1 ["+ getmapusers("06guild_01") +"]",
		"MVP 房间 2 ["+ getmapusers("06guild_02") +"]",
		"MVP 房间 3 ["+ getmapusers("06guild_03") +"]",
		"MVP 房间 4 ["+ getmapusers("06guild_04") +"]",
		"MVP 房间 5 ["+ getmapusers("06guild_05") +"]",
		"MVP 房间 6 ["+ getmapusers("06guild_06") +"]",
		"MVP 房间 7 ["+ getmapusers("06guild_07") +"]",
		"MVP 房间 8 ["+ getmapusers("06guild_08") +"]");
	if ( getvariableofnpc( .renttime[.@room], "MVP Summoner" ) ) {
		if ( .inuseid[.@room] == getcharid( .type[.@room] ) ) {
			warp "06guild_0"+ .@room, 0,0;
			close;
		} else {
			mes "[私人 MVP 房间]";
			mes "这个房间已被";
			mes .color$[ .type[.@room] ] + .whoinuse$[.@room] +"^000000.";
			mes "预订，请选择其他房间。";
			close;
		}
	}
	mes "[私人 MVP 房间]";
	mes "预订此房间用于……";
	next;
	set .@type, select( "我的队伍成员", "我的公会成员", "个人账号使用" );
	if ( !getcharid(.@type) ) {
		mes "[私人 MVP 房间]";
		mes "你没有"+( ( .@type == 1 )? "队伍" : "公会" )+"。";
		close;
	}
	else if ( Zeny < getvariableofnpc( .rentcost, "MVP Summoner" ) ) {
		mes "你没有足够的 Zeny 租用房间。";
		close;
	}
	else if ( getvariableofnpc( .renttime[.@room], "MVP Summoner" ) ) {
		mes "[私人 MVP 房间]";
		mes "抱歉，别人比你更快登记了这个房间。";
		close;
	}
	for ( .@i = 1; .@i <= 8; .@i++ ) {
		if ( ( getvariableofnpc( .renttime[.@i], "MVP Summoner" ) ) && .@type == .type[.@i] && getcharid(.@type) == .inuseid[.@i] ) {
			mes "[私人 MVP 房间]";
			mes "你已经租用了房间 #"+ .@i +"，请使用那个房间。";
			close;
		}
	}
	set .type[.@room], .@type;
	set .inuseid[.@room], getcharid(.@type);
	set .whoinuse$[.@room], strcharinfo( ( .@type == 3 )? 0 : .@type );
	Zeny -= getvariableofnpc( .rentcost, "MVP Summoner" );
	warp "06guild_0"+ .@room, 0,0;
	killmonsterall "06guild_0"+ .@room;
	donpcevent "MVP Summoner#"+ .@room +"::OnEnterMap";
	close;
OnInit:
	.color$[1] =  "^EE8800"; // party color
	.color$[2] =  "^70CC11"; // guild color
	.color$[3] =  "^0000FF"; // account color
	end;
}

-	script	MVP Summoner	-1,{
	mes "[MVP 召唤师]";
	mes "剩余时间：" + callfunc( "Time2Str", .renttime[ atoi( strnpcinfo(2) ) ] + .timeout * 60 );
	mes "你好，需要什么服务？";
	next;
	switch ( select(.menu$) ) {
	case 1:
		mes "[MVP 召唤师]";
		if ( mobcount( "this", strnpcinfo(3)+"::OnMobDead" ) ) {
			mes "附近有怪物时无法提供治愈服务。";
			close;
		}
		sc_end SC_STONE;
		sc_end SC_SLOWDOWN;
		sc_end SC_FREEZE;
		sc_end SC_SLEEP;
		sc_end SC_CURSE;
		sc_end SC_SILENCE;
		sc_end SC_CONFUSION;
		sc_end SC_BLIND;
		sc_end SC_BLEEDING;
		sc_end SC_DECREASEAGI;
		sc_end SC_POISON;
		sc_end SC_HALLUCINATION;
		sc_end SC_STRIPWEAPON;
		sc_end SC_STRIPARMOR;
		sc_end SC_STRIPHELM;
		sc_end SC_STRIPSHIELD;
		sc_end SC_CHANGEUNDEAD;
		sc_end SC_ORCISH;
		sc_end SC_BERSERK;
		sc_end SC_SKE;
		sc_end SC_SWOO;
		sc_end SC_SKA;
		percentheal 100,100;
		specialeffect2 EF_HEAL;
		mes "你已经完全恢复。";
		close;
	case 2:
		if ( mobcount( "this", strnpcinfo(3)+"::OnMobDead" ) ) {
			mes "[MVP 召唤师]";
			mes "附近有怪物时无法召唤其他 MVP。";
			close;
		} else if ( .mvpcost ) {
			mes "[MVP 召唤师]";
			mes "召唤 MVP 的费用是 "+ callfunc( "F_InsertComma", .mvpcost ) +" Zeny。";
			next;
			set .@menu, select(.mvpid_menu$) -1;
			mes "[MVP 召唤师]";
			if ( Zeny < .mvpcost ) {
				mes "你没有足够的 Zeny 召唤 MVP。";
				close;
			}
		} else {
			set .@menu, select(.mvpid_menu$) -1;
			mes "[MVP 召唤师]";
		}
		mes "请做好准备。";
		close2;
		if ( Zeny < .mvpcost ) end;
		Zeny -= .mvpcost;
		monster "this", 0, 0, "--ja--", .mvpid[.@menu], 1, strnpcinfo(3)+"::OnMobDead";
		end;
	case 3:
		if ( mobcount( "this", strnpcinfo(3)+"::OnMobDead" ) ) {
			mes "[MVP 召唤师]";
			mes "附近有怪物时无法召唤其他小 Boss。";
			close;
		} else if ( .bosscost ) {
			mes "[MVP 召唤师]";
			mes "召唤小 Boss 的费用是 "+ callfunc( "F_InsertComma", .bosscost ) +" Zeny。";
			next;
			set .@menu, select(.bossid_menu$) -1;
			mes "[MVP 召唤师]";
			if ( Zeny < .bosscost ) {
				mes "你没有足够的 Zeny 召唤小 Boss。";
				close;
			}
		} else {
			set .@menu, select(.bossid_menu$) -1;
			mes "[MVP 召唤师]";
		}
		mes "请做好准备。";
		close2;
		if ( Zeny < .bosscost ) end;
		Zeny -= .bosscost;
		monster "this", 0, 0, "--ja--", .bossid[.@menu], 1, strnpcinfo(3)+"::OnMobDead";
		end;
	case 4:
		if ( mobcount( "this", strnpcinfo(3)+"::OnMobDead" ) > 0 ) {
			mes "[MVP 召唤师]";
			mes "附近有怪物时无法提供这项服务。";
			close;
		}
		close2;
		callshop "MVP room#branch", 1;
		end;
	case 5:
		mes "[MVP 召唤师]";
		mes "你确定要离开这个房间吗？";
		next;
		if ( select( "是:否") == 1 )
			warp .respawnmap$, .respawnx, .respawny;
		close;
	case 6:
		mes "[MVP 召唤师]";
		if ( getmapusers( strcharinfo(3) ) > 1 ) {
			mes "房间里还有其他玩家。请确保自己是房间内最后一个成员，再使用此选项。";
			close;
		}
		mes "你确定要放弃这个房间吗？";
		if ( .rentcost )
			mes "再次进入此房间需要重新付费。";
		next;
		if ( select( "是", "否" ) == 2 ) close;
		awake strnpcinfo(0);
		end;
	}
	close;

OnMobDead:
	end;

OnEnterMap:
	.@id = atoi( strnpcinfo(2) );
	.renttime[.@id] = gettimetick(2);
	sleep .timeout * 60000;
	mapwarp strnpcinfo(4), .respawnmap$, .respawnx, .respawny;
	.renttime[.@id] = 0;
	killmonsterall strnpcinfo(4);
	end;

OnInit:
	if ( !getstrlen( strnpcinfo(2) ) ) {

//	Config ---------------------------------------------------------------------------------------

	// Room rental time, in minutes.
	// When time runs out, all players inside the room will be kicked out.
	// Do NOT set this to zero!
	set .timeout, 60;

	set .rentcost, 100000;	// Zeny cost for renting a room (0 = free)
	set .mvpcost, 100000;	// Zeny cost to summon an MVP (0 = free)
	set .bosscost, 50000;	// Zeny cost to summon a boss monster (0 = free)

	//	Options setting inside MVP room
	set .@menu[1], 1;	// Turn Heal option On/Off
	set .@menu[2], 1;	// Turn MVP Summoning On/Off
	set .@menu[3], 1;	// Turn Mini boss Summoning On/Off
	set .@menu[4], 0;	// Sell items (branches) On/Off (see shop below, before the mapflags)

	// Respawn point when players leave the room
	set .respawnmap$, "prontera";
	set .respawnx, 150;
	set .respawny, 174;

	setarray .mvpid[0],
		1511,//	Amon Ra
		1647,// Assassin Cross Eremes
		1785,//	Atroce
		1630,//	Bacsojin
		1039,//	Baphomet
		1874,//	Beelzebub
		1272,//	Dark Lord
		1719,//	Datale
		1046,//	Doppelgangger
		1389,//	Dracula
		1112,//	Drake
		1115,//	Eddga
		1418,//	Evil Snake Lord
		1871,//	Fallen Bishop
		1252,//	Garm
		1768,//	Gloom Under Night
		1086,//	Golden Thief Bug
		1885,//	Gopinich
		1649,// High Priest Magaleta
		1651,// High Wizard Katrinn
		1832,//	Ifrit
		1492,//	Incantation Samurai
		1734,//	Kiel D-01
		1251,//	Knight of Windstorm
		1779,//	Ktullanux
		1688,//	Lady Tanee
		1646,// Lord Knight Seyren
		1373,//	Lord of Death
		1147,//	Maya
		1059,//	Mistress
		1150,//	Moonlight Flower
		1087,//	Orc Hero
		1190,//	Orc Lord
		1038,//	Osiris
		1157,//	Pharaoh
		1159,//	Phreeoni
		1623,//	RSX 0806
		1650,// Sniper Shecil
		1583,//	Tao Gunka
		1708,//	Thanatos
		1312,//	Turtle General
		1751,//	Valkyrie Randgris
		1685,// Vesper
		1648,// Whitesmith Harword
		1917,// Wounded Morocc
		1658;//	Ygnizem

	setarray .bossid[0],
		1096,// Angeling
		1388,// Archangeling
		1795,// Bloody Knight
		1830,// Bow Guardian
		1839,// Byorgue
		1309,// Cat O' Nine Tail
		1283,// Chimera
		1302,// Dark Illusion
		1198,// Dark Priest
		1582,// Deviling
		1091,// Dragon Fly
		1093,// Eclipse
		1205,// Executioner
		1783,// Galion
		1592,// Gangster
		1120,// Ghostring
		1259,// Gryphon
		1720,// Hydro
		1090,// Mastering
		1289,// Maya Purple
		1262,// Mutant Dragon
		1203,// Mysteltainn
		1870,// Necromancer
		1295,// Owl Baron
		1829,// Sword Guardian
		1204,// Tirfing
		1089,// Toad
		1092,// Vagabond Wolf
		1765;// Valkyrie

//	Config Ends ------------------------------------------------------------------------

		if ( !.timeout ) set .timeout, 60;
		.menu$ = ( .@menu[1] ? "治疗" : "" ) +":" ;
		.menu$ = .menu$ + ( .@menu[2] ? "召唤 MVP" : "" ) +":";
		.menu$ = .menu$ + ( .@menu[3] ? "召唤小 Boss" : "" ) +":";
		.menu$ = .menu$ + ( .@menu[4] ? "购买树枝" : "" ) +":";
		.menu$ = .menu$ + "离开房间:放弃房间";
		if ( .@menu[2] ) {
			.@size = getarraysize( .mvpid );
			for ( .@i = 0; .@i < .@size; .@i++ )
				.mvpid_menu$ = .mvpid_menu$ + getmonsterinfo( .mvpid[.@i], MOB_NAME ) +":";
		}
		if ( .@menu[3] ) {
			.@size = getarraysize( .bossid );
			for ( .@i = 0; .@i < .@size; .@i++ )
				.bossid_menu$ = .bossid_menu$ + getmonsterinfo( .bossid[.@i], MOB_NAME ) +":";
		}
	}
	else {
		mapannounce strnpcinfo(4), "管理员已刷新服务器。请重新登记此房间。", bc_map;
		mapwarp strnpcinfo(4), .respawnmap$, .respawnx, .respawny;
	}
	end;
}


		mes "书架上摆满研究日志。";
		close;
	}
	mes "每一页都用机械语言书写。";
	next;
	mes "-Ve 博士似乎在策划什么阴谋，生命与机械的结合逐渐令她疯狂，她把工厂改造成堡垒，还有她的灵魂与机器人……";
	next;
	mes "-总之情况越来越危险了。为了以防万一，应该研究从 Charleston 2 逃脱的方法。";
	next;
	mes "背面是无法理解的机械语言。";
	close;
}

1@mcd,142,74,5	script	#Research Journal 02	CLEAR_NPC,{
	if (isbegin_quest(13186) == 0) {
		mes "书架上摆满研究日志。";
		close;
	}
	mes "每一页都用机械语言书写。";
	next;
	mes "-每当 Charleston 2 的操作系统重置，就会出现另一种人格，数据与技术的结合实在难以解释……";
	next;
	mes "-我真的成功创造出人类了吗？机器人，我无法断言。我理解人类吗？";
	next;
	mes "-那不重要。现在能看到她，我最好的朋友、我的宝贝 Lily……我很开心。";
	next;
	mes "背面是无法理解的机械语言。";

	mes "我希望自己能更像你们这些冒险者。";
	mes "像你们这样的人似乎从不放弃，";
	mes "无论遇到什么障碍。";
	mes "但我真的无能为力……";
	next;
	mes "[Klitzer]";
	mes "我甚至无法见到自己爱的人。";
	mes "我们差异太大，已经不可能在一起了……";
	close;
}

ein_in01,21,147,3	script	Megass#EIN	853,3,3,{
	end;

OnTouch_:
	if ((EIN_LOVERQ == 4) && (EIN_LOVERQ == 5)) {
		mes "[Megass]";
	mes "又是你？！你想从我这里得到什么？！";
		next;
		mes "[Megass]";
	mes "卫兵……！把这家伙的脸拖过车道，";
	mes "不停地打他的肚子，直到他吐不出任何东西！";
		close2;
		percentheal -90,0;
		warp "einbroch",112,245;
		end;
	}
	if ((EIN_LOVERQ == 3) && (countitem(1901) > 0)) {
		mes "[Megass]";
		mes "那是……";
		mes "那是我女儿的小提琴。";
		mes "我在她十六岁生日时送给她的……";
		next;
		mes "[Megass]";
		mes "擅闯我家已经够糟了，";
		mes "居然还偷我女儿卡拉的东西？！";
		mes "你越界了，小混蛋！卫兵！过来！";
		next;
		mes "[Megass]";
		mes "你们给我狠狠教训这个蠢货，";
		mes "把他肚子里的东西全打出来！";
		mes "确保这个小混蛋醒来时，已经不是今天了！";
		delitem 1901,1; //Violin
		set EIN_LOVERQ,4;
		changequest 8077,8078;
		percentheal -90,0;
		close2;
		warp "einbroch",112,245;
		end;
	}
	mes "[Megass]";
	mes "你竟敢……";
	mes "像你这样的流浪汉也敢踏进我家？！";
	mes "不可理喻！";
	next;
	mes "[Megass]";
	mes "立刻离开，";
	mes "否则我就向当局举报你擅闯民宅！";
	next;
	warp "einbroch",112,245;
	close;
}

ein_in01,31,151,3	script	Satra#ein	850,{
	if (EIN_LOVERQ > 12) {
		mes "[Satra]";
		mes "我知道我的宅邸奢华壮丽，";
		mes "对大多数平民来说，接近任何一位卡佩尔泰因都是荣幸。";
		next;
		mes "[Satra]";
		mes "不过克利策没必要如此胆怯。";
		mes "告诉那个可怜孩子，他已经赢得了与我交谈的荣幸。";
		close;
	}
	if ((EIN_LOVERQ == 12) && (countitem(1003) > 9)) {
		mes "[Satra]";
	mes "呵呵呵呵～";
	mes "欢迎，冒险者。";
	mes "我很喜欢和你聊天。";
	mes "来点开胃菜？";
		next;
		mes "[Satra]";
	mes "哦！你这样可没法享用食物！";
	mes "你的手脏得可怕！能告诉我原因吗？";
		next;
		mes "[Satra]";
	mes "啊～";
	mes "我太兴奋了，差点忘了";
	mes "又拜托你带煤炭给我！";
	mes "真抱歉～";
		next;
		mes "[Satra]";
	mes "你给我带来了这么多煤炭，";
	mes "我相信你比艾因贝赫那些懒散的农民勤劳多了。";
	mes "谢谢你如此努力地赢得我的好感。";
		next;
		mes "[Satra]";
	mes "嗯，你说什么？";
	mes "这些煤炭是别人提供的，你只是负责运送？";
	mes "那么真正收集它们的人是谁？";
		next;
		input .@input$;
		if (.@input$ == "Klitzer") {
			mes "[Satra]";
			mes "啊，克利策？";
			mes "不得不说，这是个非常朴素的名字。";
			mes "但又如此熟悉……";
			next;
			mes "[Satra]";
			mes "啊，我想起来了，有个名叫克利策的混混一直纠缠我女儿。";
			mes "也许就是同一个人。嗯……";
			next;
			mes "[Satra]";
			mes "我记得他衣着邋遢，完全没有礼仪可言。";
			mes "他显然又蠢又胆小，但现在我看出他是真诚的。";
			next;
			mes "[Satra]";
			mes "或许不能马上让他和女儿交往，";
			mes "但我会邀请他来喝茶。";
			mes "如果卡拉喜欢他，那他一定很特别。";
			next;
			mes "[Satra]";
			mes "对一个卑微农民来说，这一定像梦想成真！";
			mes "竟然要和克利策喝茶。姑娘们会怎么说？";
			mes "啊，不过我确实嫁给了那个笨拙的梅加斯～";
			next;
			delitem 1003,10; //Coal
			set EIN_LOVERQ,13;
			changequest 8084,8085;
			mes "[Satra]";
			mes "总之，下次见到克利策时，请告诉他尽快来拜访我。";
			mes "还有提醒他为这个特别场合穿得得体些。呵呵呵呵呵～";
			close;
		}
		else {
			mes "[Satra]";
			mes "你说什么？";
			mes .@input$ + "? Oh my...";
			mes "我想我可能听错了。呵呵呵呵～";
			close;
		}
	}
	if (EIN_LOVERQ == 12) {
		mes "[Satra]";
		mes "呵呵呵呵～欢迎，冒险者。";
		mes "我很喜欢和你聊天。来点开胃菜？";
		next;
		mes "[Satra]";
		mes "啊……看来你忘了带^FF0000煤炭^000000。";
		mes "虽然是个愚蠢的错误，但我愿意原谅。";
		close;
	}
	if ((EIN_LOVERQ == 11) && (countitem(1003) > 9)) {
		mes "[Satra]";
		mes "你好～最近你的来访真令人愉快，勇敢的冒险者。";
		next;
		mes "[Satra]";
		mes "继续向我展现你的感激与忠诚，";
		mes "很快你就会成为我最受宠的平民。呵呵呵呵～";
		next;
		mes "[Satra]";
		mes "我相信你已经注意到艾因布洛克和艾因贝赫之间的紧张关系。";
		mes "这确实很遗憾。";
		next;
		mes "[Satra]";
		mes "艾因布洛克越来越富裕，艾因贝赫越来越贫困，富人便开始鄙视穷人。";
		mes "我想穷人自然也开始怨恨富人。";
		next;
		mes "[Satra]";
		mes "可以说两个城镇都在试图利用对方，";
		mes "但很明显艾因布洛克始终占据上风。";
		next;
		mes "[Satra]";
		mes "事实上，由于两座城市的裂痕，";
		mes "我们的家族从小就被教导不要和艾因贝赫人来往。";
		next;
		mes "[Satra]";
		mes "我认为住在艾因贝赫的大多数人都是苦工，";
		mes "但这不代表我不会给他们证明价值的机会。";
		next;
		delitem 1003,10; //Coal
		set EIN_LOVERQ,12;
		mes "[Satra]";
		mes "如果他们证明自己值得，";
		mes "我为什么要剥夺卑微者接受我恩惠的机会？呵呵呵呵～";
		next;
		mes "[Satra]";
		mes "哦，真美味！";
		mes "如果你想再次拜访我，别忘了带些煤炭。再见～";
		close;
	}
	if (EIN_LOVERQ == 11) {
		mes "[Satra]";
		mes "你好～最近你的来访真令人愉快，勇敢的冒险者。";
		next;
		mes "[Satra]";
		mes "哦，抱歉！我想你只是来观光，";
		mes "或者在执行某种冒险者任务。对吗？";
		next;
		mes "[Satra]";
		mes "我很了解你，知道你不会无礼到不带^FF0000煤炭^000000就来聊天。呵呵呵呵～";
		close;
	}
	if ((EIN_LOVERQ == 10) && (countitem(1003) > 9)) {
		mes "[Satra]";
		mes "^333333*Titter~*^000000";
		mes "哎呀，这不是我勇敢的冒险者吗？呵呵呵呵～";
		next;
		mes "[Satra]";
		mes "天哪！你为什么带着那么多脏煤炭？";
		mes "真是个可怜的穷人。";
		next;
		mes "[Satra]";
		mes "哦，天啊，我差点忘了～";
		mes "我真是糊涂！";
		mes "我谨代表卡佩尔泰因家族再次接受你的小礼物。";
		next;
		mes "[Satra]";
		mes "让我分享一些关于我们可爱的艾因布洛克的历史。";
		mes "曾经这里只有采矿村庄艾因贝赫。";
		mes "你可以想象那是多久以前。";
		next;
		mes "[Satra]";
		mes "不过，艾因贝赫开采的矿物和矿石需要加工精炼，";
		mes "工厂都建在附近的工业区，后来那里发展成了艾因布洛克。";
		next;
		mes "[Satra]";
		mes "如今艾因布洛克的每位市民都很富有，";
		mes "这里的生活水平也众所周知地高于艾因贝赫。";
		next;
		delitem 1003,10; //Coal
		set EIN_LOVERQ,11;
		mes "[Satra]";
		mes "天哪，我想该喝茶了～";
		mes "下次想见我时，记得再带一份煤炭礼物。再见～";
		close;
	}
	if (EIN_LOVERQ == 10) {
		mes "[Satra]";
		mes "^333333*Titter~*^000000";
		mes "哎呀，这不是我勇敢的冒险者吗？呵呵呵呵～";
		next;
		mes "[Satra]";
		mes "抱歉，你必须先证明自己值得与我交谈。";
		mes "不如再送些煤炭来吧。";
		mes "^FF0000Coals^000000, mmm?";
		next;
		mes "[Satra]";
		mes "毕竟，除了这样，我无法知道你是否珍惜我屈尊与你交谈的时间。呵呵呵呵～";
		close;
	}
	if ((EIN_LOVERQ == 9) && (countitem(1003) > 9)) {
		mes "[Satra]";
		mes "哎呀，你已经带来煤炭了？真是积极～";
		next;
		mes "[Satra]";
		mes "我谨代表卡佩尔泰因家族，忽略你的卑微身份，";
		mes "大方地接受你的小礼物。呵呵呵呵～";
		next;
		mes "[Satra]";
		mes "冒险者，你来自艾因贝赫吗？";
		mes "啊，卢恩-米德加尔兹王国！我去过你的国家。";
		mes "那里很古朴，斐扬也非常美丽。";
		next;
		delitem 1003,10; //Coal
		set EIN_LOVERQ,10;
		changequest 8083,8084;
		mes "[Satra]";
		mes "好吧，我会想办法利用这些。";
		mes "恐怕我向你要的礼物不太实用。煤炭通常怎么用？";
		mes "啊，我有个新奇的主意！";
		next;
		mes "[Satra]";
		mes "如果梅加斯举办一场下层阶级喜欢的社交活动，";
		mes "一定会非常狂野吧？比如‘烧烤’，对吗？";
		next;
		mes "[Satra]";
		mes "总之，如果你再带些煤炭来，我会更喜欢你，";
		mes "你也会得到我的恩宠。呵呵～";
		close;
	}
	if (EIN_LOVERQ == 9) {
		mes "[Satra]";
		mes "一位四处游历的冒险者……？";
		mes "真是令人愉悦！";
		mes "你一定冒着生命危险躲过我丈夫，";
		mes "才能欣赏我家的迷人景色。呵呵呵呵～";
		next;
		mes "[Satra]";
		mes "既然你是如此独特的客人，";
		mes "我就赐予你独特的荣誉，屈尊与你交谈，冒险者。";
		next;
		mes "[Satra]";
		mes "艾因贝赫存在的意义，就是为我的家族提供煤炭和矿产。";
		mes "这是自然法则：工人必须由少数被选中的人领导。";
		next;
		mes "[Satra]";
		mes "看到那些工人妄想达到我们这样的社会地位，真是可笑又有趣。呵呵呵呵～";
		next;
		mes "[Satra]";
		mes "哦，我已经很久没和下层阶级的人说话了！";
		mes "这种禁忌感真令人兴奋！";
		next;
		mes "[Satra]";
		mes "好了，冒险者，我们的闲聊到此为止。";
		mes "我甚至允许你吹嘘自己曾和萨特夫人交谈过。";
		next;
		mes "[Satra]";
		mes "如果你还想让我再次与你交谈，";
		mes "就证明你比其他苦工更值得接受我的恩典。";
		next;
		mes "[Satra]";
		mes "哦，我有个绝妙的主意！为什么不带些^990000煤炭^000000给我？";
		mes "对你来说并非不可能，但这任务需要付出一些努力。";
		next;
		mes "[Satra]";
		mes "再见，冒险者～";
		close;
	}
	if (EIN_LOVERQ == 8) {
		mes "[Satra]";
		mes "一位四处游历的冒险者……？";
		mes "真是令人愉悦！";
		mes "你一定冒着生命危险躲过我丈夫";

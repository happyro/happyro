		mes "其他反叛军成员已经在寻找入口。如果不介意，能去看看他们吗？";
		mes "也许你会发现什么。";
		erasequest 7852;
		setquest 7853;
		next;
		mes "[新兵]";
		mes "废弃矿井在这道屏障后面。小心。";
		close3;
	}
	if (isbegin_quest(7853) == 1) {
		cutin "16loo_01",2;
		mes "[新兵]";
		mes "其他反叛军成员已经在寻找入口。如果不介意，请去找他们，冒险家。";
		mes "也许你会发现什么。";
		next;
		mes "[新兵]";
		mes "废弃矿井在这道屏障后面。小心。";
		close3;
	}
	if (isbegin_quest(7857) == 1) {
		cutin "16loo_03",2;
		mes "[新兵]";
		mes "嘿……你找到瞭望塔和小洞了吗？";
		mes "小洞小到人类根本无法通过？哈哈……";
		mes "真遗憾。";
		next;
		cutin "16loo_01",2;
		mes "[新兵]";
		mes "如果能利用那个小洞，我的努力不就白费了吗？";
		mes "别失望！";
		mes "我终于打开这扇门了。";
		next;
		mes "[新兵]";
		mes "这个按钮能打开门，但一松手门就会关上。";
		mes "这是不是意味着一个人无法到达另一边？";
		next;
		mes "[新兵]";
		mes "即使两个人一起过来……";
		mes "这可真麻烦。";
		mes "看起来这装置就是为了把人丢进去而造的。";
		next;
		select("Throwing in?");
		mes "[新兵]";
		mes "有个地方也有类似的装置。";
		mes "监狱。牢房。是关押囚犯的地方……这里到底是什么？！";
		mes "怎么回事？我们在罪犯营地吗？";
		next;
		mes "[新兵]";
		mes "不，不是这样。如果是那种设施，特斯不可能不知道。";
		mes "总之，现在你先进去吧。";
		next;
		select("I hear suspicious sounds...");
		mes "[新兵]";
		mes "怎么样？啊！我听到了。那是奇怪的惨叫声吗？看来其他成员已经进去了。";
		mes "你去另一边时，我会留在这里操作开关。";
		next;
		mes "[新兵]";
		mes "你也要和其他人会合吗？";
		mes "如果找到声音来源、看到怪物或其他异常情况，请告诉我！";
		completequest 7857;
		setquest 7858;
		next;
		cutin "16loo_02",2;
		mes "[新兵]";
		mes "想出来时，在另一边“咚咚咚”敲三下铁门。";
		mes "我会从这边开门。";
		mes "当然也可以用魔法出来……哈哈。";
		close3;
	}
	if (isbegin_quest(7858) < 2) {
		if (checkquest(7858,HUNTING) != 2) {
			cutin "16loo_01",2;
			mes "[新兵]";
			mes "其他反叛军成员已经进去了。";
			mes "我们不能放着他们不管。";
			mes "小心。";
			close3;
		}
		mes "[新兵]";
		mes "哇……里面发生了什么？";
		mes "你看起来筋疲力尽……";
		next;
		select("魔物出来了。");
		mes "[新兵]";
		mes "怪物！？";
		mes "向埃琳娜报告！然后回到子弹上的猫那里向特斯汇报！";
		next;
		mes "[新兵]";
		mes "你觉得怪物能从小缝隙里出来吗？";
		mes "我会留在这里，稍后和埃琳娜一起回来！";
		close3;
	}
	cutin "16loo_01",2;
	mes "[新兵]";
	mes "突然有这么多工作真不错……但我一个人做不完……";
	close3;

OnInit:
	questinfo(QTYPE_QUEST,QMARK_YELLOW,"isbegin_quest(7852) == 1");
	questinfo(QTYPE_QUEST,QMARK_YELLOW,"isbegin_quest(7857) == 1");
	end;
}

sp_rudus,304,266,3	script	Rebellion Crew#171_rudus01	4_M_REBELLION3,{
	if (isbegin_quest(7853) == 1 && isbegin_quest(7854) == 0) {
		mes "[反叛军成员]";
		mes "怎么样？你也参与这次行动吗？";
		mes "虽然我住在艾因布洛克，";
		mes "这还是我第一次见到这里。";
		next;
		select("怎么了？");
		mes "[反叛军成员]";
		mes "看看这里，不觉得奇怪吗？";
		mes "这是运输矿石的铁路，但他们在上面建了屏障。";
		mes "甚至连门都没有。";
		next;
		mes "[反叛军成员]";
		mes "起初我以为这面墙是用来隔开冶炼厂和矿井的……";
		mes "但我觉得并不是这样？";
		next;
		select("结界是之后才形成的吗？");
		mes "[反叛军成员]";
		mes "确实。";
		mes "可是，已经关闭的矿井和工厂为什么还需要屏障？";
		mes "而且这种结构通常用于监狱。";
		next;
		mes "[反叛军成员]";
		mes "我不知道这面墙的用途，但它不是工厂运营时建造的。";
		next;
		mes "[反叛军成员]";
		mes "我会再仔细看看，之后和你会合。";
		mes "请告诉幸运。";
		setquest 7854;
		if (isbegin_quest(7854) == 1 && isbegin_quest(7855) == 1 && isbegin_quest(7856) == 1) {
			erasequest 7854;
			erasequest 7855;
			erasequest 7856;
			completequest 7853;
			setquest 7857;
		}
		close;
	}
	if (isbegin_quest(7853) == 1) {
		mes "[反叛军成员]";
		mes "我还得再看看。";
		close;
	}
	npctalk "呃……这些奇怪的声音快让我疯了。","",bc_self;
	end;

OnInit:
	questinfo(QTYPE_QUEST,QMARK_YELLOW,"isbegin_quest(7853) == 1 && isbegin_quest(7854) == 0");
	end;
}


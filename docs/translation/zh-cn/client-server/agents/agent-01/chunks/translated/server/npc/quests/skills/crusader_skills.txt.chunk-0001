geffen,110,117,3	script	Ford#11	752,{
	if (BaseJob == Job_Crusader) {
		if (CRUS_SK == 8 && getskilllv("CR_SHRINK") == 0) {
	mes "[福特]";
			mes "嘿，好久不见~";
			mes "你甚至已经成为了圣骑士。";
			mes "你一定忘了如何使用";
			mes "缩小术，所以我马上教你……";
			mes "好了！";
			mes "现在你会使用了。";
			set CRUS_SK,10;
			skill "CR_SHRINK",1,SKILL_PERM;
			close;
		}

		else if (CRUS_SK == 0) {
	mes "[福特]";
			mes "该死！怎么这么久？";
			mes "啊，你终于来了！";
			mes "快，把你带来的";
			mes "^FF0000报告^000000给我看看！";
			mes "请让我看看。";
			next;
			mes "["+ strcharinfo(0) +"]";
			mes "请问……？";
			mes "哦，你一定是";
			mes "把我认成别人了。";
			mes "我真的不知道";
			mes "你在说什么。";
			next;
	mes "[福特]";
			mes "什么？！你不是驻扎在";
			mes "吉芬南部的卫兵？";
			mes "糟糕，真是抱歉，";
			mes "我只是看你穿得像";
			if (Upper == 1)
				mes "圣骑士……";
			else
				mes "十字军……";
			next;
			mes "["+ strcharinfo(0) +"]";
			mes "抱歉……";
			mes "发生什么事了？";
			mes "出什么问题了吗？";
			mes "我是名叫"+ strcharinfo(0) +"的冒险者。";
			next;
	mes "[福特]";
			mes "我是莱斯利·福特，";
			mes "我是普隆德拉十字军卫队的指挥官。";
			mes "很高兴认识你。";
			mes "普隆德拉十字军卫队的指挥官。";
			mes "我们的职责是保护冒险者";
			mes "我们承担着保护人民的责任。";
			mes "和市民免受邪恶魔物的侵害。";
			mes "这是我们的使命。";
			mes "绝不能松懈。";
			mes "我们必须时刻保持警惕。";
			next;
	mes "[福特]";
			mes "最近哥布林无故暴力袭击的事件";
			mes "这让我们的守卫非常担忧。";
			mes "突然增加，给我们带来不少麻烦。";
			mes "这已经影响了附近地区的安全。";
			mes "我们的巡逻队本应向我";
			mes "报告它们的活动情况。";
			mes "但今天的报告还没有送到。";
			mes "我对此非常担心。";
			next;
	mes "[福特]";
			mes "不过，今天的报告还没送来，";
			mes "我开始担心巡逻队是不是出了事。";
			mes "遗憾的是，我的职责不允许我";
			mes "我不能离开这里。";
			mes "离开岗位去调查。";
			mes "我只能留在这里等消息。";
			mes "我会继续等待巡逻队的报告。";
			mes "情况越来越紧急了。";
			next;
	mes "[福特]";
			mes "我已经走投无路了，";
			mes "情况真的非常紧迫。";
			mes "只能向外界求助。";
			mes "既然你也是十字军，";
			mes "能请你帮我一把吗？";
			mes "拜托你了。";
			mes "请不要拒绝。";
			mes "我真的需要你的援助。";
			next;
			switch(select("好。:抱歉，但我很忙……")) {
			case 1:
	mes "[福特]";
				mes "太好了，非常感谢！";
				mes "现在请去寻找驻扎在";
				mes "吉芬南部的^0000FF斯劳蒂^000000，";
				mes "把他的报告交给我。";
			mes "你的帮助让我松了一口气……";
			mes "这件事就拜托你了。";
				set CRUS_SK,1;
				close;
			case 2:
	mes "[福特]";
				mes "嗯，我明白了。";
				mes "我不知道你现在有什么要事，";
				mes "但如果当前任务不紧急，";
				mes "请再考虑一下……";
				close;
			}
			close;
		}
		else if (CRUS_SK == 1) {
	mes "[福特]";
			mes "请在吉芬南部寻找";
			mes "那一带很危险，请小心。";
			mes "^0000FF斯劳蒂^000000，";
			mes "他会把哥布林巡逻报告";
			mes "交给你，再由你带给我。";
			mes "请尽快回来。";
			mes "不要耽搁。";
			close;
		}
		else if (CRUS_SK == 2) {
	mes "[福特]";
			mes "等等，你已经见过斯劳蒂，";
			mes "却还没拿到他的报告？";
			mes "请回去找他，";
			mes "把报告带给我。";
			mes "我必须马上采取行动。";
			mes "我必须马上阅读！";
			mes "这份报告可能关系到很多人的性命。";
			mes "这件事非常重要！";
			close;
		}
		else if (CRUS_SK == 3) {
	mes "[福特]";
			mes "啊，你回来了！";
			mes "斯劳蒂怎么样？";
			mes "一切还好吗？";
			mes "请告诉我巡逻队的情况。";
			next;
			mes "["+ strcharinfo(0) +"]";
			mes "给，这是我尽快带来的报告！";
			mes "你最好快点读。";
			mes "我离开时情况看起来";
			mes "相当糟糕……";
			mes "情况比我想象的更严重。";
			mes "请马上采取行动。";
			next;
	mes "[福特]";
			mes "天哪，纸上全是血！让我看看……";
			mes "糟糕，这是紧急情况！";
			mes "我必须向阿尔加爵士报告，";
			mes "并立即请求支援！";
			mes "我必须马上派出援军。";
			mes "不能再拖了！";
			next;
			mes "["+ strcharinfo(0) +"]";
			mes "等等，我们得处理斯劳蒂的伤势。";
			mes "他被哥布林打伤了，";
			mes "我觉得他的情况很严重。";
			mes "不能把他丢在那里。";
			mes "必须救他。";
			mes "不能再浪费时间。";
			next;
	mes "[福特]";
			mes "哥布林……？";
			mes "糟糕，你需要特殊解毒剂，";
			mes "可以从亚瑟神父那里取得，";
			mes "用来治疗这些哥布林使用的";
			mes "毒刃造成的中毒。";
			mes "快去找他。";
			mes "我会等你带回消息。";
			mes "我会在这里等待你的消息。";
			next;
	mes "[福特]";
			mes "我去请求支援，";
			mes "你去^0000FF普隆德拉教堂^000000，";
			mes "向^0000FF亚瑟^000000神父取得哥布林毒解毒剂。";
			mes "如果不快点，";
			mes "斯劳蒂可能就来不及了——！";
			mes "请务必尽快行动。";
			set CRUS_SK,4;
			close;
		}
		else if (CRUS_SK == 4) {
	mes "[福特]";
			mes "请尽快从^0000FF亚瑟神父^000000那里取得哥布林毒解毒剂，";
			mes "他在^0000FF普隆德拉教堂^000000。斯劳蒂的性命现在就靠你了。";
			mes "不要再耽搁。";
			mes "快点行动。";
			mes "快去快回。";
			mes "时间不多了。";
			mes "解毒剂必须马上送到。";
			close;
		}
		else if (CRUS_SK == 5) {
	mes "[福特]";
			mes "你已经见过亚瑟神父了？很好，";
			mes "现在快去从他那里取得解毒剂。";
			mes "没有解毒剂，斯劳蒂会慢慢痛苦地死去！";
			close;
		}
		else if (CRUS_SK == 6) {
	mes "[福特]";
			mes "你已经见过亚瑟神父了？很好，";
			mes "现在请赶快从他那里取得解毒剂。";
			mes "没有解毒剂，斯劳蒂会慢慢痛苦地死去！";
			mes "一定要快！";
			mes "时间不多了。";
			mes "别让他失去生命。";
			mes "一定要把解毒剂送到。";
			close;
		}
		else if (CRUS_SK == 7) {
	mes "[福特]";
			mes "太好了，你从亚瑟神父那里拿到了解毒剂！";
			mes "你做得很好。";
			mes "现在赶快把它给驻扎在吉芬南部的斯劳蒂服下。";
			mes "快点，每一秒都很重要！";
			close;
		}
		else if (CRUS_SK == 8) {
	mes "[福特]";
			mes "听说你成功救了斯劳蒂。";
			mes "对此我永远心怀感激。";
			mes "普隆德拉十字军卫队需要更多";
			mes "像你这样的人……";
			next;
	mes "[福特]";
			mes "我知道你们冒险者";
			mes "通常不愿加入这类组织，";
			mes "但这里永远欢迎你的帮助。";
			mes "希望有一天还能再见到你。";
			mes "请务必保重。";
			mes "愿你平安归来。";
			mes "我们会记住你的功劳。";
			next;
	mes "[福特]";
			mes "再次感谢你，";
			mes "祝你旅途平安。现在，";
			mes "就此告别，"+ strcharinfo(0) +"。";
			mes "后会有期。";
			mes "十字军卫队永远感谢你。";
			close;
			}
		else if (CRUS_SK == 10) {
	mes "[福特]";
			mes "嘿，好久不见~";
			mes "你应该多来看看。";
			mes "如果你真的感兴趣，";
			mes "可以加入我的部队。";
			mes "我们很需要像你这样";
			mes "有本事的人。";
			close;
			}
		else {
	mes "[福特]";
			mes "太好了，你从亚瑟神父那里拿到了解毒剂！";
			mes "现在赶快把它给驻扎在吉芬南部的斯劳蒂服下。";
			mes "快点，每一秒都很重要！";
			close;
			}
	}
	else {
	mes "[福特]";
		mes "啊，你好。";
		mes "抱歉我现在无法";
		mes "帮助你，冒险者，";
		mes "但我有非常紧急的事情要处理。";
		mes "请允许我先告辞……";
		close;
	}
}

gef_fild13,297,242,3	script	Soldier#277	751,{
	if (BaseJob == Job_Crusader) {
		if (Upper == 1 && getskilllv("CR_SHRINK")) {
			if (CRUS_SK == 8) {
	mes "[斯劳蒂]";
				mes "嘿，朋友，好久不见。";
				mes "我的伤还需要恢复，";
				mes "所以如果你想学习缩小术，";
				mes "就去找福特爵士，好吗？";
			mes "他会教你的。";
			mes "记得认真学习。";
				mes "别忘了。";
				close;
			}
			else if (CRUS_SK == 10) {
	mes "[斯劳蒂]";
				mes "缩小术用得怎么样？";
				mes "希望它像救过我一样，";
				mes "也救过你很多次。";
				mes "那么，下次再见，"+ strcharinfo(0) +"~";
				mes "祝你一路顺利。";
				mes "保重。";
				close;
			}
		}
		if (CRUS_SK == 1) {
	mes "[士兵]";
			mes "啊啊啊啊！";
			mes "我、我的腿！";
			mes "伤口正在恶化。";
			mes "到底发生了什么，";
			mes "他们对我的腿做了什么？！";
			mes "好痛！";
			next;
			mes "["+ strcharinfo(0) +"]";
			mes "发、发生什么事了？";
			mes "你被袭击了吗？";
			next;
	mes "[士兵]";
			mes "是、是的，我正在例行巡逻，";
			mes "准备向福特爵士报告，";
			mes "却被这些哥布林袭击了！";
			mes "我得警告上级！";
			mes "他们要袭击吉芬了！";
			mes "快去通知他们！";
			next;
			mes "["+ strcharinfo(0) +"]";
			mes "我刚刚和福特爵士谈过！";
			mes "你一定是斯劳蒂，对吧？";
			mes "他派我来看看你发生了什么！";
			mes "我来帮你。";
			next;
	mes "[斯劳蒂]";
			mes "太、太及时了！";
			mes "听着，你必须把这份报告交给他。";
			mes "里、里面有巡逻详情，";
			mes "还有紧急的支援请求。";
			mes "呃！我们没时间了！";
			mes "快去！";
			next;
			mes "["+ strcharinfo(0) +"]";
			mes "等等……！";
			mes "那你怎么办？";
			mes "你受伤了……";
			next;
	mes "[斯劳蒂]";
			mes "我可不能因为自己";
			mes "让救援延误！";
			mes "快把报告交给福特爵士！走！";
			mes "现在，只要我能把报告从我——";
			mes "啊！不、不行……";
			mes "我的腿动不了了……";
			next;
			mes "["+ strcharinfo(0) +"]";
			mes "^333333(他痛苦地扭动着，";
			mes "甚至无法把报告交给我。";
			mes "我最好带一瓶红色药水给他，";
			mes "缓解他的痛苦……)^000000";
			set CRUS_SK,2;
			close;
		}
		else if (CRUS_SK == 2) {
			if (countitem(501) > 0) {
				mes "["+ strcharinfo(0) +"]";
					mes "来，请拿着这瓶";
					mes "红色药水。";
					mes "也许能帮上忙……";
				next;
	mes "[斯劳蒂]";
					mes "哦，谢天谢地！";
					mes "啊！把它倒进伤口！";
					mes "这、这烧得好厉害！";
					mes "那些哥布林一定用涂了毒的东西";
					mes "割伤了我！";
					mes "好痛！";
				next;
	mes "[斯劳蒂]";
					mes "啊……啊……";
					mes "血还没有止住，";
					mes "但至少好一些了。";
					mes "来，拿上这份报告，";
					mes "把它交给福特爵士。快走！";
					mes "拜托你了！";
				next;
					mes "^3355FF你收到了斯劳蒂的巡逻报告。";
					mes "其中几页沾满了";
					mes "他伤口流出的鲜血。^000000";
				delitem 501,1; //Red_Potion
				set CRUS_SK,3;
				close;
			}
			else {
	mes "[斯劳蒂]";
				mes "快、快拿上这份报告！";
				mes "让我把它交给你，然后——";
				mes "啊啊啊！我、我动不了了！";
				mes "这……太痛了！";
				next;
				mes "["+ strcharinfo(0) +"]";
				mes "^333333(我最好带一瓶红色药水给他，";
				mes "否则不弄伤他的情况下，";
				mes "我根本拿不到那份报告！)";
				close;
			}
		}
		else if (CRUS_SK == 3) {
	mes "[斯劳蒂]";
			mes "我们没时间了！";
			mes "快把我的报告";
			mes "尽快交给福特爵士！";
			mes "拜托了！";
			close;
		}
		else if (CRUS_SK == 4) {
	mes "[斯劳蒂]";
			mes "啊啊啊——！";
			mes "我、我的腿！";
			mes "全身开始痛、痛起来了！";
			next;
			mes "^3355FF斯劳蒂昏了过去，";
			mes "看来腿上的伤让他";
			mes "承受了更多痛苦。^000000";
			close;
		}
		else if (CRUS_SK == 5) {
	mes "[斯劳蒂]";
			if (Upper == 1) {
				mes "啊啊啊——！";
				mes "我、我的腿！";
				mes "全身开始痛、痛起来了！";
				next;
				mes "^3355FF斯劳蒂昏了过去，";
				mes "看来腿上的伤让他";
				mes "承受了更多痛苦。^000000";
			}
			else {
				mes "........";
				mes ".........";
				next;
				mes "^3355FF斯劳蒂仍然昏迷不醒。";
				mes "如果不立即治疗伤势，";
				mes "他会死。";
				mes "你必须尽快帮助他。^000000";
			}
			close;
		}
		else if (CRUS_SK == 6) {
	mes "[斯劳蒂]";
			mes "........";
			mes ".........";
			next;
		mes "^3355FF斯劳蒂仍然昏迷不醒。";
		mes "如果不立即治疗伤势，";
		mes "他会死。";
		mes "你必须尽快帮助他。^000000";
			close;
		}
		else if (CRUS_SK == 7) {
			set .@rand,rand(1,5);
			if (.@rand == 1 || .@rand == 5) {
				mes "^3355FF你小心地把哥布林毒解毒剂";
				mes "倒进斯劳蒂的嘴里。";
				mes "他的喉咙努力吞咽解毒剂，";
			mes "最终成功服下了它。^000000";
			mes "解毒剂开始发挥作用。";
				next;
				mes "^3355FF奇迹般地，哥布林造成的伤口";
				mes "开始迅速愈合。^000000";
				next;
	mes "[斯劳蒂]";
				mes "哦，发、发生什么了？";
				mes "我……我真的还活着吗？";
				mes "嘿，是你！一定是你救了我！";
				mes "我还以为自己肯定要死了！";
				mes "太感谢你了！";
				next;
				mes "["+ strcharinfo(0) +"]";
				mes "幸好我及时赶到了。福特爵士";
				mes "让我去找亚瑟神父制作解毒剂，";
				mes "这样才能救你。";
				mes "还有，我已经把你的报告交给福特爵士了。";
				mes "任务完成了。";
			mes "你可以安心休息。";
			mes "很快就会恢复。";
				next;
	mes "[斯劳蒂]";
				mes "太好了！现在让我教你一项特殊技能作为回报，";
				mes "这是普隆德拉十字军卫队开发的技能。";
				mes "正是靠这项技能，我才在哥布林袭击中活了下来。";
			mes "你准备好学习了吗？";
			mes "这项技能会帮助你战斗。";
				next;

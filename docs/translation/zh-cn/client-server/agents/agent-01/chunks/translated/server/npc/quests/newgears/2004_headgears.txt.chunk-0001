// Black Cat Ears
//============================================================
payon,115,131,3	script	Neko Neko#1	725,{
	disable_items;
	if (checkweight(1201,1) == 0) {
		mes "- 等一下！ -";
		mes "- 你现在携带的物品太多了。 -";
		mes "- 请先把部分物品存入卡普拉仓库后再试。 -";
		close;
	}
	if (countitem(2213) > 0 && countitem(983) > 0 && countitem(914) > 199 && Zeny > 9999) {
		mes "[Neko Neko]";
		mes "嘿？你把材料都带来了～";
		mes "好，给我一点时间。";
		next;
		mes "[Neko Neko]";
		mes "*挤压 挤压 砰砰砰 敲敲 刮擦 刮擦*";
		mes "*抓挠 抓挠 敲敲 敲敲 敲敲*";
		next;
		mes "[Neko Neko]";
		mes "*挤压 挤压 砰砰砰 敲敲 刮擦 刮擦*";
		mes "*抓挠 抓挠 敲敲 敲敲 敲敲*";
		next;
		mes "[Neko Neko]";
		mes "呼！给你。";
		mes "现在你可以戴上属于自己的黑猫耳朵了～";
		delitem 2213,1; //Cat_Hairband
		delitem 983,1; //Black_Dyestuffs
		delitem 914,200; //Fluff
		set Zeny, Zeny-10000;
		getitem 5057,1; //Ear_Of_Black_Cat
		next;
		mes "[Neko Neko]";
		mes "谢谢你使用我的服务～！";
		close;
	}
	mes "[Neko Neko]";
	mes "嗯……？";
	mes "请问？";
	mes "我认识你吗……？";
	mes "哦，我知道你为什么来找我了。嘿嘿～！";
	next;
	mes "[Neko Neko]";
	mes "你想知道我头上这对小巧可爱的黑猫耳朵是从哪儿来的，对吧？我就知道！哈哈哈～！";
	next;
	mes "[Neko Neko]";
	mes "这是我自己做的。";
	mes "如果你愿意，花一点小钱我也可以为你做一对。嘿嘿嘿～";
	next;
	mes "[Neko Neko]";
	mes "只要带来1个^FF0000猫咪发带^000000、";
	mes "1个^FF0000黑色染料^000000、200个^FF0000绒毛^000000，";
	mes "以及^FF000010,000 Zeny^000000！";
	next;
	mes "[Neko Neko]";
	mes "^FF0000请记住，如果带来的物品插过卡片或进行过精炼，制作后物品的附加能力会消失。请务必注意。";
	close;
}

// X Hairpin, Band Aid, Flower Hairpin
//============================================================
geffen,129,148,3	script	Argen#1	779,{
	disable_items;
	if (checkweight(1201,1) == 0) {
		mes "[Argen]";
	mes "嘿～你怎么带了这么多物品？";
	mes "介意分一些给我吗？";
		close;
	}
	emotion ET_SCRATCH;
	mes "[Argen]";
	mes "天啊～";
	mes "我好无聊～！";
	mes "要是我会更多悠悠球技巧就好了，那样就能真正给女士们留下深刻印象。";
	next;
	mes "[" + strcharinfo(0) + "]";
	mes "给女士们留下印象……？";
	next;
	emotion ET_SURPRISE;
	if (Sex == SEX_MALE) {
		mes "[Argen]";
		mes "没错，老兄。女孩子喜欢两样东西：小巧可爱的礼物，还有潇洒的男士。";
		next;
		mes "[Argen]";
		mes "可爱的礼物我已经搞定了。与其花钱买真正的礼物，我会做这些小发夹。";
		next;
		mes "[Argen]";
		mes "至于潇洒嘛？我有这个悠悠球……";
		next;
		mes "[Argen]";
		mes "嘿，你看起来也不喜欢在女孩身上浪费钱。我理解。愿意的话，我可以做个发夹让你送给^FF3333女士们^000000。";
		next;
		mes "[Argen]";
		mes "你只要带来制作材料就行。如果发夹是给你自己的，我也完全支持。";
	}
	else {
		mes "[Argen]";
		mes "哇～！是位女士……";
		mes "哇，你真可爱！这样吧……";
		next;
		mes "[Argen]";
		mes "既然你这么可爱，我就为你做一个漂亮的小发夹。你只要带来材料就行。";
		next;
		mes "[Argen]";
		mes "告诉我你对哪种发夹感兴趣吧。";
	}
	next;
	emotion ET_SMILE;
	switch(select("^3131FFX 发夹^000000:^3131FF创可贴^000000:^3131FF花朵发夹^000000:不用了，谢谢。")) {
	case 1:
		if (countitem(2294) > 0 && countitem(7220) > 399) {
			mes "[Argen]";
			mes "X 发夹！";
			mes "不错的选择～！";
			next;
			emotion ET_SURPRISE;
			mes "[Argen]";
			mes "啊……对了。";
			mes "关于星星……";
			mes "^CE3100如果使用已升级的星辰制作此物品，所有升级都会丢失。你能接受吗？^000000";
			next;
			switch(select("我不介意。:我稍后再来。")) {
			case 1:
				mes "[Argen]";
				mes "好，开始工作吧。";
				next;
				mes "^3131FF * Scrape Scrape * ^000000";
				mes "^3131FF * Scrape Scrape * ^000000";
				next;
				emotion ET_BEST;
				mes "[Argen]";
				mes "好了，完成了！";
				mes "你觉得怎么样？很酷吧？";
				delitem 2294,1; //Star_Dust
				delitem 7220,400; //Ectoplasm
				getitem 5079,1; //Crossed_Hair_Band
				next;
				break;
			case 2:
				mes "[Argen]";
				mes "没问题，慢慢来。";
				close;
			}
		}
		else {
			mes "[Argen]";
			mes "哦～";
			mes "你想要^3131FFX 发夹^000000？很简单！";
			next;
			mes "[Argen]";
			mes "我需要^FF00001个星星^000000和^FF0000400个灵魂精华^000000。";
			mes "准备好后告诉我！";
			close;
		}
		break;
	case 2:
		if (countitem(970) > 0 && countitem(930) > 499) {
			mes "[Argen]";
			mes "创可贴，是吗？";
			mes "知道了！等一下，马上就好。";
			next;
			mes "^3131FF * Scrape Scrape * ^000000";
			mes "^3131FF * Scrape Scrape * ^000000";
			next;
			emotion ET_BEST;
			mes "[Argen]";
			mes "*呼～！*";
			mes "完成了！";
			mes "很酷吧？";
			delitem 970,1; //Alchol
			delitem 930,500; //Rotten_Bandage
			getitem 5063,1; //Plaster
			next;
		}
		else {
			mes "[Argen]";
			mes "啊，^3131FF创可贴^000000！";
			mes "它很适合伪装伤口或遮住秃斑。想逃课时带一个很方便。";
			next;
			mes "[Argen]";
			mes "带来^FF00001个酒精^000000和^FF0000500个烂绷带^000000！";
			mes "准备好后告诉我，好吗？";
			close;
		}
		break;
	case 3:
		if (countitem(2269) > 0 && countitem(999) > 9 && Zeny > 19999) {
			mes "[Argen]";
			mes "你想要花朵发夹～？";
			mes "好，给我一点时间。";
			next;
			mes "^3131FF - Scrape Scrape - ^000000";
			mes "^3131FF - Scrape Scrape - ^000000";
			next;
			emotion ET_BEST;
			mes "[Argen]";
			mes "啊……完成了！";
			mes "看起来很漂亮！对了，这根多余的树枝送给你。";
			delitem 2269,1; //Centimental_Flower
			delitem 999,10; //Steel
			set Zeny, Zeny-20000;
			getitem 5061,1; //Flower_Hairpin
			getitem 905,1; //Stem
			next;
		}
		else {
			mes "[Argen]";
			mes "你想要^3131FF花朵发夹^000000！";
			mes "我发现可爱女孩喜欢叼着花走来走去，我总是想“什么～？”后来我有了个好主意！";
			next;
			mes "[Argen]";
			mes "某种^3131FF花朵发夹^000000不是会很受女孩欢迎吗？我试着做了一个，女性朋友们似乎很喜欢。";
			next;
			mes "[Argen]";
			mes "这比把花戴在兽人战士宠物身上好多了。天啊，那些家伙看起来真吓人～";
			next;
			mes "[Argen]";
			mes "如果你想要，我就做一个。不过我的服务要收些版权费。把花固定在发夹上可不容易。";
			next;
			mes "[Argen]";
			mes "这需要高超技巧。";
			next;
			mes "[Argen]";
			mes "所以，请带来^FF00001朵浪漫之花^000000、^FF000010个钢铁^000000";
			mes "以及^3131FF20,000 Zeny^000000！明白了吗？酷～";
			close;
		}
		break;
	case 4:
		mes "[Argen]";
		mes "我支持。";
		mes "想要什么发夹就再回来吧。我会拿着悠悠球，在这里保持^FF3333潇洒^000000。";
		close;
	}
	emotion ET_WRAP;
	mes "[Argen]";
	mes "想要更多发夹就尽管来找我。虽然看起来很懒，但我确实喜欢为女士们制作东西。回头见～！";
	close;
}

// Hot-blooded Headband
//============================================================
yuno,300,188,5	script	Zhenbolt#1	753,{
	disable_items;
	if (checkweight(1201,1) == 0) {
		mes "- 等一下！ -";
		mes "- 你现在携带的物品太多了。 -";
		mes "- 请先把部分物品存入卡普拉仓库后再试。 -";
		close;
	}
	if (countitem(7216) > 299 && countitem(7097) > 299 && countitem(2211) > 0 && countitem(982) > 0) {
		mes "[Zhenbolt]";
		mes "这是什么？！";
		mes "你已经带来了我要求的一切！干得好，英雄～！我马上开始工作……";
		next;
		mes "[Zhenbolt]";
		mes "...";
		next;
		mes "[Zhenbolt]";
		mes "......";
		next;
		mes "[Zhenbolt]";
		mes "......*Cling*";
		next;
		mes "[Zhenbolt]";
		mes "拿着这个……";
		mes "它叫^FF0000热血头带^000000，是我战斗精神的象征！戴上它，任何事都无法阻挡你！";
		delitem 7216,300; //Red_Scarf
		delitem 7097,300; //Burning_Heart
		delitem 2211,1; //Bandana
		delitem 982,1; //White_Dyestuffs
		getitem 5070,1; //Headband_Of_Power
		next;
		mes "[Zhenbolt]";
		mes "现在，出发！";
		mes "把你的战斗精神释放到世间的恶徒身上吧！";
		close;
	}
	mes "[Zhenbolt]";
	mes "我……";
	mes "名叫^FF0000真波特^000000！！";
	next;
	if (select("你就是真波特！？:天啊，是传真波特！") == 1) {
		mes "[Zhenbolt]";
		mes "没错，就是我，击败过一万亿以上敌人的正义狂暴飓风英雄：真波特！";
		next;
		mes "[Zhenbolt]";
		mes "我从你的眼中看到了纯洁而热情的战斗之心！";
		next;
		mes "[Zhenbolt]";
		mes "就这么决定了！带来以下物品，我就把让恶徒畏惧的真波特著名战斗象征交给你。";
		next;
		mes "[Zhenbolt]";
		mes "带给我……";
		mes "300 ^FF0000Red Muffler^000000,";
		mes "300 ^FF0000Burning Heart^000000,";
		mes "1 个 ^FF0000头巾^000000和 1 个 ^FF0000白色染料^000000。";
		mes "这就是我需要的全部。";
		next;
		mes "[Zhenbolt]";
		mes "冒险者，快点回来！";
		mes "我期待你创造伟业！";
		close;
	}
	mes "[Zhenbolt]";
	mes "没错。";
	mes "我就是真波特。";
	mes "力量战士！";
	mes "狂热激情的";
	mes "旋转风暴！";
	next;
	mes "[Zhenbolt]";
	mes "从你的眼中，我看出你经历过许多战斗。能活到现在，你一定知道胜利的秘诀……";
	next;
	mes "[Zhenbolt]";
	mes "纯粹、无拘无束的愤怒！";
	mes "战斗要靠活力与热情取胜！";
	next;
	mes "[Zhenbolt]";
	mes "既然你理解这个根本，我就认可你为正义永恒斗争中的盟友！";
	mes "我将把令邪恶之心恐惧的象征赐予你……";
	next;
	mes "[Zhenbolt]";
	mes "带给我";
	mes "300 ^FF0000Red Muffler^000000,";
	mes "300 ^FF0000Burning Heart^000000,";
		mes "1 个 ^FF0000头巾^000000和 1 个 ^FF0000白色染料^000000。";
	mes "这就是我需要的全部。";
	next;
	mes "[Zhenbolt]";
	mes "带来那些物品……";
	mes "你也能成为战斗传奇……";
	close;
}

// Red Ribbon
//============================================================
prontera,165,232,3	script	Nephia#1	744,{
	disable_items;
	if (checkweight(1201,1) == 0) {
		mes "- 等一下！ -";
		mes "- 你现在携带的物品太多了。 -";
		mes "- 请先把部分物品存入卡普拉仓库后再试。 -";
		close;
	}
	if (countitem(2244) > 0 && countitem(2209) > 0 && countitem(10007) > 0) {
		mes "[Nephia]";
		mes "哦……";
		mes "你带来了所有缎带！我迫不及待要为你系一条新缎带，装饰你^FF66CC美丽的头发^000000！";
		next;
		mes "[Nephia]";
		mes "...";
		next;
		mes "[Nephia]";
		mes "......";
		next;
		mes "[Nephia]";
		mes ".......*Cling*";
		next;
		mes "[Nephia]";
		mes "就是这样～！完成了！戴上它，你一定会看起来特别可爱。";
		delitem 2244,1; //Big_Sis'_Ribbon
		delitem 2209,1; //Ribbon_
		delitem 10007,1; //Silk_Ribbon
		getitem 5083,1; //Red_Tailed_Ribbon
		next;
		mes "[Nephia]";
		mes "希望哪天我们能一起为对方梳头！那一定会非常有趣吧？";
		close;
	}
	mes "[Nephia]";
	mes "哇～";
	mes "好漂亮的头发！抱歉，我就是喜欢漂亮发型和饰品！";
	next;
	mes "[Nephia]";
	mes "哦～！你知道怎样能让头发更可爱吗？我觉得用一条大红缎带扎起来，你会变得超级^FF66CC可爱^000000！";
	next;
	if (Sex == SEX_MALE) {
		if (select("呃，女士，我是男的。:^FF66CC哦～！你说得对！^000000") == 1) {
			mes "["+ strcharinfo(0) +"]";
			mes "女士，你没看出来我是男的吗？";
			next;
			mes "[Nephia]";
			mes "呜呜……";
			mes "但你戴上一定会很^FF66CC漂亮～！^000000";
			next;
			mes "["+ strcharinfo(0) +"]";
			mes "这是……";
			mes "我听过的最糟糕的";
			mes "恭维话。";
			close;
		}
		mes "["+ strcharinfo(0) +"]";
		mes "哦哦～！";
		mes "听起来不错！";
		next;
		mes "[Nephia]";
		mes "天啊！我就是这么想的！嘿～！如果你愿意，我现在就可以帮你系上缎带！";
		next;
		mes "[Nephia]";
		mes "哦！请带来1条^FF0000大缎带^000000、1条^FF0000带洞缎带^000000和1条^FF0000丝绸缎带^000000！";
		next;
		mes "[Nephia]";
		mes "哦，我差点忘了！";
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
		mes "^FF0000如果带来精炼过或插卡的物品，制作新物品后卡片和精炼效果都会消失。请务必记住！^000000";
		next;
		mes "[Nephia]";
		mes "哦，快点快点！我等不及要装饰你的头发了！";
		close;
	}
	else {
		if (select("不用了，谢谢。:^FF66CC哦～！你说得对！^000000") == 1) {
			mes "["+ strcharinfo(0) +"]";
			mes "呃……";
			mes "不用了，谢谢。";
			next;
			mes "[Nephia]";
			mes "啊啊啊～";
			mes "你这么可爱，戴上后一定会变得超级漂亮！";
			close;
		}
		mes "["+ strcharinfo(0) +"]";
		mes "哦哦～！";
		mes "听起来不错！";
		next;
		mes "[Nephia]";
		mes "天啊！我就是这么想的！嘿～！如果你愿意，我现在就可以帮你系上缎带！";
		next;
		mes "[Nephia]";
		mes "哦！为此我需要1条^FF0000大缎带^000000、1条^FF0000带洞缎带^000000和1条^FF0000丝绸缎带^000000！";
		next;
		mes "[Nephia]";
		mes "哦，我差点忘了！";

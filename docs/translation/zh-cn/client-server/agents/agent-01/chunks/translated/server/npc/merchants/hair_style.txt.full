		// Roving Hair Dresser
		// ============================================================
		alberta,33,141,7	script	Roving Hair Dresser	87,{
		mes "[鲁伊·维肖普]";
		mes "那个维罗妮卡……";
		mes "哈！还最佳理发师，真是胡说。";
		mes "她根本不是最佳理发师……";
		mes "...";
		mes "我才是！";
		next;
		mes "[鲁伊·维肖普]";
		mes "我，鲁伊·维肖普，让所有头皮";
		mes "都成为画布";
		mes "等待变成";
		mes "壮丽的艺术品~！";
		next;
		switch(select("你是谁？:请帮我做发型！:……")) {
		case 1:
		mes "[鲁伊·维肖普]";
		mes "你难道不知道我鲁伊";
		mes "·维肖普是剪刀大师";
		mes "和头发雕塑家，是";
		mes "远超时代的艺术家吗？！";
		mes "不过，我想像你这样的冒险者";
		mes "不会知道……";
		next;
		mes "[鲁伊·维肖普]";
		mes "作为头发雕塑家，我很高兴";
		mes "把";
		mes "为他人做发型的至高恩惠";
		mes "以合理价格。";
		next;
		mes "[鲁伊·维肖普]";
		mes "不过最近，我偶然";
		mes "听说某个新手竟敢";
		mes "自称";
		mes "理发师。";
		next;
		mes "[鲁伊·维肖普]";
		mes "于是有一天我去了那里，";
		mes "假装顾客。";
		mes "看到无聊、";
		mes "毫无生气的发型，我";
		mes "大为震惊……";
		next;
		mes "[鲁伊·维肖普]";
		mes "很容易看出她的";
		mes "技能（或者说没有技能）是";
		mes "笑话。她让伟大而光荣的";
		mes "理发";
		mes "行业蒙羞。";
		mes "彻底的耻辱！";
		next;
		mes "[鲁伊·维肖普]";
	mes "但最糟糕的是……";
		mes "她强迫顾客在";
			mes "理发前选择发型！";
			mes "";
			next;
			mes "[鲁伊·维肖普]";
		mes "有才华的理发师不会这样";
			mes "工作！她应该";
			mes "知道哪种发型";
			mes "适合顾客，而不必";
			mes "询问他们！";
			next;
			mes "[鲁伊·维肖普]";
			mes "如果你决定";
			mes "做发型，别想";
			mes "去找她。";
			mes "来找我";
			mes "吧。我保证我";
			mes "比她强得多。";
			next;
			mes "[鲁伊·维肖普]";
			mes "明白了吗？我是说，别让她";
			mes "毫无必要地毁掉你的头发！";
		mes "如果你想要那么糟糕的发型，";
		mes "找个剑士把你的头发砍掉";
		mes "也行~！";
		close;
		case 2:
		if(BaseLevel < 60) {
		mes "[鲁伊·维肖普]";
		mes "嗯，我得说，你现在的";
		mes "发型最适合你。相信我，我懂。";
		close;
		} else if(Zeny < 199800) {
		mes "[鲁伊·维肖普]";
		mes "啊，我看出你能在眼前发现";
			mes "天才了。鉴于你的好品味，";
			mes "我只收取服务费用。";
			next;
			mes "[鲁伊·维肖普]";
			mes "只需支付 199,800 Zeny 的小费用。";
			mes "要知道我收这么少是在帮你大忙。";
			mes "毕竟，我的艺术可是无价的。";
			close;
			}
			mes "[鲁伊·维肖普]";
			mes "好吧，我会收取我的";
			mes "现在收取 199,800 Zeny 的服务费。";
			next;
			mes "[鲁伊·维肖普]";
			mes "如果你现在不想做，虽然我不明白为什么，";
			mes "你可以让那个愚蠢的理发师";
			mes "在你身上施展她笨拙的手艺……";
			next;
			if(select("不，请帮我理发。:嗯，我改变主意了。") ==1 ) {
			mes "[鲁伊·维肖普]";
			mes "好~的~！";
			mes "现在开始吧~！";
			next;
		mes "[鲁伊·维肖普]";
		mes "呜哦哦~哦哦！！";
		next;
		mes "[鲁伊·维肖普]";
		mes "呜啊啊~啊啊！！";
		next;
		mes "[鲁伊·维肖普]";
		mes "瞧！";
		next;
	mes "[鲁伊·维肖普]";
		mes "哦，太棒了~真惊艳！";
		mes "又一件维肖普杰作~";
		mes "我又一次超越了自己。";
		mes "如此独特又有才华的发型！";
		mes "没错，我是最棒的！呜哈哈哈哈！";
		set Zeny, Zeny-199800;
		setlook 1,rand(1,19);
		setlook 6,rand(1,8);
	close;
}
mes "[Rui Vishop]";
mes "呸！好吧！这是你的决定。";
mes "不过以后别怪我！";
	mes "总有一天你会醒来，发现";
	mes "自己很丑，并后悔没有让我";
	mes "为你头上的每一缕头发";
	mes "施展天才造型。";
	close;
	case 3:
	mes "[Rui Vishop]";
	mes "什么？真遗憾！";
	mes "你要让那个……那个";
	mes "冒牌理发师毁掉你的发型！？";
	mes "我敢肯定，天堂都在为人类的无知";
	mes "流下怜悯的泪水……";
	close;
		}
		}
		
		
		lhz_in02,91,155,5	script	Assistant Beautician#li	862,{
		mes "[Assistant Beautician]";
		mes "哇？！天哪，";
		mes "你吓到我了！";
		mes "你在做什么？！";
		emotion ET_HUK;
		next;
		mes "[Assistant Beautician]";
		mes "哦！呃，是客人！";
		mes "你、你、你、你好！";
		mes "有什么我能帮忙的吗？";
	next;
		switch(select("你做什么？:请帮我换发型。:夏米王子是谁？")) {
			case 1:
			mes "[Assistant Beautician]";
			mes "哦！我？我是";
			mes "美容师助手，";
			mes "每天努力训练，";
			mes "希望能成为";
			mes "真正的专业人士！";
			next;
		mes "[Assistant Beautician]";
		mes "是的，我训练时为老板";
			mes "做各种杂活。";
			mes "有时他让我干得很辛苦。";
			mes "其实我最好赶紧回去工作，免得他生气！";
			close;
			case 2:
			if (BaseLevel < 60) {
			mes "[Assistant Beautician]";
			mes "我？……不行，";
			mes "我很想帮忙，但是我还在训练，";
			mes "要是把小孩子的头发弄坏，";
			mes "我可负不起责任！";
			close;
			}
			else if ((Zeny < 250000)) {
			mes "[Assistant Beautician]";
			mes "嗯……我只是助手，";
			mes "但我下班后一直学习发型设计。";
			mes "如果你愿意，带来 250,000 Zeny，";
			mes "我会尽力帮你换发型~";
			next;
			mes "[Assistant Beautician]";
			mes "如果你能给我这次机会，我会很感激！";
		mes "老板还不认为我能为真人做造型，";
		mes "所以我的实践经验不多！";
			next;
			mes "[Assistant Beautician]";
			mes "我知道我能把你的头发做好！";
			mes "只是……如果弄坏了请理解。";
			mes "不会太糟的，我保证~";
			close;
			}
			else {
			mes "[Assistant Beautician]";
			mes "你真的愿意";
				mes "给我练习的机会？";
				mes "哦，我太爱你了！好的，";
				mes "材料费用需要 250,000 Zeny。";
				mes "可以吗？";
				next;
				switch(select("当然~:我再想想……")) {
				case 1:
				mes "[Assistant Beautician]";
				mes "太好了！现在请选择";
					mes "1 到 23 号发型。";
					mes "嗯，如果要取消，";
					mes "请输入 0。";
					next;
					input .@input;
				if (.@input == 0) {
				mes "[Assistant Beautician]";
					mes "呜呜……";
					mes "看来你还是不信任我……";
					close;
					}
					else if ((.@input < 1) || (.@input > 23)) {
					mes "[Assistant Beautician]";
				mes "嗯？我不是让你输入";
				mes "一个介于";
				mes "应该是从‘1’到‘23’吧？我又做错了什么";
					mes "这次又错了吗？嗯……";
					close;
					}
					else {
						mes "[Assistant Beautician]";
							mes "所以这就是你想让我";
						mes "尝试制作的";
							mes "发型吗？";
					if (Sex == SEX_MALE) {
					if (.@input < 10)
						cutin "hair_m_0"+.@input+".BMP",4;
							else
						cutin "hair_m_"+.@input+".BMP",4;
							}
					else {
					if (.@input < 10)
					cutin "hair_f_0"+.@input+".BMP",4;
					else
						cutin "hair_f_"+.@input+".BMP",4;
					}
						next;
						switch(select("是的，试试吧~:取消。")) {
						case 1:
						break;
						case 2:
					mes "[Assistant Beautician]";
				mes "哦哦，一定有";
				mes "你喜欢的发型，对吧？嗯……";
				close3;
				}
				}
				mes "[Assistant Beautician]";
				mes "太好了，你终于选好了！";
				mes "什么，你选的是哪一个来着？";
				mes "啊，找到了，找到了！";
				mes "哈哈！没问题！";
				mes "现在开始造型！";
				next;
				nude;
				mes "[Assistant Beautician]";
				mes "呜哇啊啊！";
				next;
				mes "[Assistant Beautician]";
				mes "呀！噗哇！";
				next;
				mes "[Assistant Beautician]";
				mes "哇啊！";
				mes "糟糕！";
				mes "等等，我可以……";
				mes "我能修好！";
				next;
				set .@style_r,rand(1,23);
				set .@color_r,rand(1,8);
				mes "[Assistant Beautician]";
				mes "^333333*喘、喘、喘*^000000";
				next;
				set Zeny, Zeny-250000;
				setlook VAR_HEAD,.@style_r;
				setlook VAR_HEADPALETTE,.@color_r;
					mes "[Assistant Beautician]";
					mes "哇哈哈哈！成功！";
				if (.@input == .@style_r) {
				mes "那么……你喜欢";
					mes "新发型吗？我很喜欢！";
					}
					else {
					mes "什么……？这不是";
				mes "你想要的？糟糕……嗯……";
				mes "下次我一定能";
				mes "做得更好！对吧！";
				}
				next;
				mes "[Assistant Beautician]";
				mes "哦，你真是个";
				mes "愿意帮我的好人！";
				mes "谢谢使用我的服务，欢迎再来~";
			emotion ET_CHUP;
				close3;
				case 2:
				mes "[Assistant Beautician]";
				mes "嗯？哦不，你要退出？";
				mes "好吧，我想你也不信任我";
				mes "帮你做发型……";
				mes "你……你是对的。";
			close;
		}
	}
		case 3:
		mes "[Assistant Beautician]";
		mes "夏米王子？";
		mes "他只有在发型设计方面";
		mes "才是天才！";
		mes "我只是他的学徒，但也许有一天";
		mes "我也能成为时尚界的一股力量！";
		close;
	}
}


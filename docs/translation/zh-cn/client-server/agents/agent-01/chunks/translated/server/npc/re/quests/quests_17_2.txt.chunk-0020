	end;

OnInit:
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "isbegin_quest(18019) == 1" );
	questinfo( QTYPE_DAILYQUEST, QMARK_YELLOW, "isbegin_quest(18019) == 2 && checkquest(18023,PLAYTIME) == -1 && checkquest(18022,HUNTING) == -1" );
	questinfo( QTYPE_DAILYQUEST, QMARK_YELLOW, "checkquest(18023,PLAYTIME) == 2" );
	questinfo( QTYPE_QUEST2, QMARK_YELLOW, "checkquest(18022,HUNTING) == 2" );
	end;
}



// Water Garden instance - Step 1
ba_pw02,42,267,5	script	Lensis#jh_ba	20629,{
	if (ep17_2_main < 9) {
		mes "[Lensis]";
		mes "未登记为访客的用户将被视为敌人。";
		next;
		mes "- 存在尚未完成的前置任务。-";
		close;
	}
	if (ep172_watergarden == 0) {
		cloakoffnpcself( "Elyumina#jh_ba1" );
		cutin "ep171_elyumina01",2;
		mes "[Elyumina]";
		mes "我刚刚意识到自己的想法错了。这个叫瓦尔蒙特的人不是很厉害吗？";
		mes "没想到这里有这么美丽的自动人偶。我真该早点来。";
		npctalk "伊露米娜：如果我早知道，就不会被抓住了。", "Elyumina#jh_ba1", bc_self;
		emotion ET_SURPRISE, getnpcid(0,"Elyumina#jh_ba1");
		next;
		mes "[Elyumina]";
		mes "真美丽，这种连接形式让核心实体可以通过集中式网络控制，自由操纵遍布宅邸的子对象……";
		next;
		cutin "ep171_elyumina04",2;
		mes "[Elyumina]";
		mes "但它的运行方式又突出了子对象的个性。";
		mes "真有趣。我想知道它是用什么机器运行的。";
		emotion ET_BIGTHROB, getnpcid(0,"Elyumina#jh_ba1");
		next;
		cloakoffnpcself( "Rookie#jh_ba1" );
		cloakoffnpcself( "Lazy#jh_ba1" );
		cutin "16loo_03",2;
		mes "[Rookie]";
		mes "你看起来很开心。不过我不知道是什么让你开心。";
		emotion ET_SWEAT, getnpcid(0,"Rookie#jh_ba1");
		next;
		mes "[Rookie]";
		mes "无论如何要小心。这片薄铁板正下方流着近乎有毒的污水。";
		next;
		cutin "16lei_02",2;
		mes "[Lazy]";
		mes "我想你太专注于新机器和自动人偶，根本听不到我们说话。你就像拿到新玩具的孩子，犯罪科学家女士。";
		next;
		cutin "ep171_elyumina01",2;
		mes "[Elyumina]";
		mes "你是管理这里的自动人偶吗？可以和你谈一会儿吗？";
		mes "别担心，我不是可疑人物。";
		emotion ET_DELIGHT, getnpcid(0,"Elyumina#jh_ba1");
		next;
		cutin "16lei_02",2;
		mes "[Lazy]";
		mes "它更像人，而不是自动人偶。";
		mes "什么？等等，这个自动人偶看起来有点奇怪。犯罪科学家女士，小心……";
		next;
		cutin "ep172_beta",2;
		mes "[Lensis]";
		mes "已识别。确认入侵者，开始立即排除。";
		next;
		cloakonnpcself( "Elyumina#jh_ba1" );
		cutin "ep171_elyumina03",2;
		mes "[Elyumina]";
		mes "等等，等一下。我有正式许可……啊！";
		specialeffect EF_ICECRASH, AREA, "Elyumina#jh_ba1";
		emotion ET_HUK, getnpcid(0,"Elyumina#jh_ba1");
		next;
		cloakonnpcself( "Rookie#jh_ba1" );
		cutin "16loo_03",2;
		mes "[Rookie]";
		mes "哦，好危险！";
		emotion ET_HUK, getnpcid(0,"Rookie#jh_ba1");
		next;
		cloakoffnpcself( "Elyumina#jh_ba1" );
		cloakoffnpcself( "Rookie#jh_ba1" );
		cutin "ep171_elyumina03",2;
		mes "[Elyumina]";
		mes "呃！咳咳咳！";
		mes "啊！这到底是什么？我差点死了！真不敢相信你们用这么漂亮的方式攻击。你们全身都湿了！";
		emotion ET_KEK, getnpcid(0,"Elyumina#jh_ba1");
		next;
		mes "[Elyumina]";
		mes "你知道不能只凭漂亮就被原谅吧？世界没那么简单！……呃，这是什么头痛？";
		next;
		cutin "16loo_01",2;
		mes "[Rookie]";
		mes "……差一点就酿成灾难了。";
		mes "这个人和我们一起。我不是入侵者。阿尔法说你可以和她交流，但你为什么这么做？";
		npctalk "拉吉：生气的语气有点奇怪。你真的没事吗？", "Lazy#jh_ba1", bc_self;
		next;
		cutin "ep172_beta",2;
		mes "[Lensis]";
		mes "网络检查，自动纠错。正在重新确认数据包……";
		mes "啊，我确认了。";
		mes "……不过，超过 62% 的入侵者都有类似行为模式，所以我把你当成了入侵者。";
		next;
		cutin "16loo_03",2;
		mes "[Lazy]";
		mes "那 38% 去哪里了？";
		next;
		cutin "16loo_03",2;
		mes "[Rookie]";
		mes "别开这种玩笑，Lazy！";
		mes "你知道米娜已经不再是幻影了。";
		next;
		cutin "ep171_elyumina03",2;
		mes "[Elyumina]";
		mes "等等，我有点奇怪……头很痛，开始头晕恶心了。";
		next;
		cutin "16loo_03",2;
		mes "[Rookie]";
		mes "怎么办？这里的污水流向实验室，所以几乎有毒。";
		mes "真不敢相信你掉进了乍看就很糟糕的水里。";
		emotion ET_THINK, getnpcid(0,"Rookie#jh_ba1");
		next;
		cutin "",255;
		select( "你不应该去看医生吗？" );
		cutin "16loo_01",2;
		mes "[Rookie]";
		mes "这是个好主意。冒险者，你能先进入<NAVI>[宅邸]<INFO>ba_maison,169,270,0,101,0</INFO></NAVI>，告诉他们准备医疗设施吗？";
		mes "我和 Lazy 会照顾艾莉乌米娜，很快跟上。";
		next;
		cutin "",255;
		if (select( "交给我吧！", "拒绝。" ) == 2) {
			cutin "16loo_01",2;
			mes "[Rookie]";
			mes "冒险者，你不会还以为米娜是幻影吧？";
			mes "毕竟你已经收到了米娜亲手制作的武器和模块！";
			close3;
		}
		cutin "16loo_01",2;
		mes "[Rookie]";
		mes "谢谢你，冒险者！我马上就来。";
		mes "啊，米娜。她的脸色发青，对吧？冒险者，请告诉他们尽快准备！";
		navigateto("ba_maison",169,270);
		close2;
		cutin "",255;
		ep172_watergarden = 1;
		setquest 16427;
		cloakonnpcself( "Elyumina#jh_ba1" );
		cloakonnpcself( "Rookie#jh_ba1" );
		cloakonnpcself( "Lazy#jh_ba1" );
		end;
	}
	cutin "ep172_beta",2;
	mes "[Lensis]";
	mes "你好，访客。欢迎来到污水处理厂。";
	next;
	mes "[Lensis]";
	mes "这里是实验室污水排放的区域，接触皮肤或误食都非常危险，可能立即致死，所以建议所有人远离。";
	next;
	mes "[Lensis]";
	mes "如果你需要毒药，我可以提供……";
	close3;

OnInit:
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "ep17_2_main >= 9 && ep172_watergarden == 0" );
	end;
}

ba_pw02,45,267,3	script(CLOAKED)	Elyumina#jh_ba1	4_EP17_ELYUMINA,{
	emotion ET_DELIGHT;
	npctalk "艾莉乌米娜：我刚意识到自己的想法错了。这个叫瓦尔蒙特的人不是很厉害吗？", "", bc_self;
	cloakonnpcself();
	end;
}

ba_pw02,50,264,3	script(CLOAKED)	Rookie#jh_ba1	4_M_ROOKIE,{
	npctalk "新手：我不知道自己怎么会和这两个人在一起。", "", bc_self;
	cloakonnpcself();
	end;
}

ba_pw02,48,262,1	script(CLOAKED)	Lazy#jh_ba1	4_M_LAZY,{
	npctalk "Lazy：嗯，这里有点难呼吸。", "", bc_self;
	cloakonnpcself();
	end;
}


// Water Garden instance - Step 2
ba_maison,169,270,5	script	Need#jh_ba	4_EP17_BASIC_B,{
	if (ep172_watergarden == 1) {
		cutin "ep172_beta",2;
		mes "[Need]";
		mes "哇~你是访客！";
		mes "你好。我一直在等访客到来。";
		emotion ET_SURPRISE;
		next;
		mes "[Need]";
		mes "你希望我先做什么？准备餐点？休息？洗澡？";
		mes "我会为你准备一切。告诉我就行。";
		next;
		select( "我需要医疗设施。" );
		cutin "ep172_beta",2;
		mes "[Need]";
		mes "啊，啊啊啊！亲爱的访客，你受伤了吗？哪里？怎么伤的？有多严重？！";
		mes "我马上准备医疗设备和休息区！";
		emotion ET_KEK;
		next;
		select( "不，不是那样……" );
		cloakoffnpcself( "Rookie#jh_ba2" );
		cloakoffnpcself( "Lazy#jh_ba2" );
		cloakoffnpcself( "Elyumina#jh_ba2" );
		cutin "16loo_01",2;
		mes "[Rookie]";
		mes "你的脸色像泥土一样。你连路都走不稳……必须换掉湿衣服。";
		mes "我相信冒险者会马上准备好医疗设施让你接受治疗。振作起来。";
		next;
		cutin "ep171_elyumina03",2;
		mes "[Elyumina]";
		mes "呃……感觉好奇怪。啊，我能看到流动的机器和螺丝组成的河……";
		next;
		cutin "16lei_03",2;
		mes "[Lazy]";
		mes "你在看什么？我觉得这不正常。犯罪科学家，你还好吗？";
		next;
		cutin "ep172_beta",2;
		mes "[Need]";
		mes "嗯？是入侵者，入侵者！";
		mes "别担心，我不会让他们伤害你。我会呼叫安保支援！";
		next;
		cutin "ep171_elyumina03",2;
		mes "[Elyumina]";
		mes "哦……我现在感觉好一点了。入侵者什么的。只要穿过那条河就行了，啊哈哈哈……";
		next;
		cutin "16loo_03",2;
		mes "[Rookie]";
		mes "等等，等一下。她和我们一起。";
		mes "我们需要诊断和治疗。请你尽快。";
		next;
		cutin "ep172_beta",2;
		mes "[Need]";
		mes "不需要诊断。我已经知道发生了什么。";
		mes "你接触了污水处理厂排出的污染污水，对吧？";
		next;
		mes "[Need]";
		mes "你接触了来自实验室的危险化学物质……";
		mes "基本上，你的生命有危险！";
		npctalk "艾莉乌米娜：不，我不是为了接触才这么做的。我说的是真的。", "Elyumina#jh_ba2", bc_self;
		next;
		mes "[Need]";
		mes "哦，你可以理解为自己染上了毒瘾。";
		mes "嗯，那可是大问题~";
		next;
		cutin "16loo_01",2;
		mes "[Rookie]";
		mes "‘嗯，那可是大问题~’，这算什么大问题！";
		mes "有没有办法解决？";
		npctalk "Lazy：嗯，聊得很愉快。不过，你根本不是这种情况吧？", "Lazy#jh_ba2", bc_self;
		next;
		cutin "ep172_beta",2;
		mes "[Need]";
		mes "亲爱的访客。她不是访客。你是入侵者，对吧？";
		mes "我们不能给予入侵者和访客同样的待遇。";
		next;
		cutin "ep171_elyumina03",2;
		mes "[Elyumina]";
		mes "是的，是的。我想也是。好吧，别管它了……";
		mes "因为只要放着不管，它就会自行死去。再见了，我心爱的机器们，我先走一步。";
		next;
		cutin "16loo_01",2;
		mes "[Rookie]";
		mes "你说得太过分了。拜托，有没有办法？";
		mes "你曾经是幻影，不代表永远是幻影。虽然你仍然要为自己的罪付出代价，也必须接受这一点。";
		next;
		cutin "ep172_beta",2;
		mes "[Need]";
		mes "如果你知道入侵者毁掉了我们多少珍贵的成果，就不会这样说了。";
		npctalk "Lazy：是啊，她看起来仍像幻影，但和幻影略有不同。只有一点点。", "Lazy#jh_ba2", bc_self;
		npctalk "艾莉乌米娜：只是一点点……请不要把我和那些笨蛋归为一类好吗？", "Elyumina#jh_ba2", bc_self;
		next;
		cutin "16loo_02",2;
		mes "[Rookie]";
		mes "我别无选择，只能使用这个方法。";
		mes "好吧，^0000CD作为瓦尔蒙特的访客来到这里的佣兵！！！^000000";
		mes "我想救这个人。告诉我该怎么做！";
		next;
		cutin "ep171_elyumina03",2;
		mes "[Elyumina]";
		mes "……你为什么这么做？我在说什么？当然，我是伟大的艾莉乌米娜，但你……";
		next;
		cutin "ep172_beta",2;
		mes "[Need]";
		mes "那个……如果你这么说……";
		mes "你可以使用来自水之庭院的材料^0000CD银叶乳突草 的叶子^000000制作解毒剂。那是主人为了这个目的培育的。";
		next;
		mes "[Need]";
		mes "不过，我不知道园丁会不会让你进去。";
		next;
		cutin "16loo_01",2;
		mes "[Rookie]";
		mes "这些信息足够了。因为这个人的生命正处于危险中！你说的是<NAVI>[水之庭院]<INFO>ba_maison,239,47,0,101,0</INFO></NAVI>，对吧？";
		mes "我们走，自己去确认。";
		close2;
		cutin "",255;
		ep172_watergarden = 2;
		erasequest 16427;
		setquest 16428;
		cloakonnpcself( "Rookie#jh_ba2" );
		cloakonnpcself( "Lazy#jh_ba2" );
		cloakonnpcself( "Elyumina#jh_ba2" );
		end;
	}
	if (ep172_watergarden == 2) {
		cutin "ep172_beta",2;
		mes "[Need]";
		mes "你可以使用来自<NAVI>[水之庭院]<INFO>ba_maison,239,47,0,101,0</INFO></NAVI>的材料^0000CD银叶乳突草 的叶子^000000制作解毒剂。那是主人为了这个目的培育的。";
		close2;
		cutin "",255;
		navigateto("ba_maison",239,47);
		end;
	}
	cutin "ep172_beta",2;
	mes "[Need]";
	mes "花园里的仓鼠什么都吃。";
	mes "不过你不能攻击仓鼠。";
	next;
	mes "[Need]";
	mes "哦，清洁机器人？当然，有些管理员这么叫它，但是……";
	mes "我叫它仓鼠。我在书上读到，只要勤劳地捡起东西放进嘴里，就算是仓鼠。而且仓鼠比清洁机器人可爱，对吧？";
	close3;

OnInit:
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "ep17_2_main >= 10 && isbegin_quest(16427) == 1" );
	end;
}

ba_maison,177,268,3	script(CLOAKED)	Rookie#jh_ba2	4_M_ROOKIE,{
	npctalk "新手：啊，米娜太虚弱了，我还不习惯~！", "", bc_self;
	cloakonnpcself();
	end;
}
ba_maison,174,266,3	script(CLOAKED)	Elyumina#jh_ba2	4_EP17_ELYUMINA,{
	npctalk "艾莉乌米娜：我现在好像好一点了。被这样讨厌时，发生什么都无所谓了……", "", bc_self;
	cloakonnpcself();
	end;
}

ba_maison,176,270,3	script(CLOAKED)	Lazy#jh_ba2	4_M_LAZY,{
	npctalk "Lazy：我从没见过犯罪科学家女士这么消沉。", "", bc_self;
	cloakonnpcself();
	end;
}


// Water Garden instance - Step 3
ba_maison,234,51,5	script	Elyumina#jh_ba3	4_EP17_ELYUMINA,{
	if (checkweight(1000103,20) == 0) {	// (custom)
		mes "^008800等一下！！";
		mes "你携带的物品太多，无法再获得物品。减轻负重后再试。^000000";
		close;
	}
	if (ep172_watergarden == 2) {
		cutin "ep171_elyumina01",2;
		mes "[Elyumina]";
		mes "..............................,";
		next;
		cutin "ep171_elyumina03",2;
		mes "[Elyumina]";
		mes "该死……难道我要害怕这样死去吗！";
		mes "啧，湿掉的东西很难晾干。";
		close2;
		cutin "",255;
		cloakonnpcself();
		end;
	}
	if (ep172_watergarden == 3) {
		switch( checkquest(16429,HUNTING) ) {
		case -1:
			break;
		case 0:
		case 1:
			cloakoffnpcself( "Elyumina#jh_ba3" );
			cloakoffnpcself( "Rookie#jh_ba3" );
			cloakoffnpcself( "Lazy#jh_ba3" );
			cutin "ep171_elyumina03",2;
			mes "[Elyumina]";
			mes "我头晕……别摇我。";
			mes "我走不了，就算勉强自己也走不了。跟着去只会给你添麻烦。";
			next;
			cutin "16lei_02",2;
			mes "[Lazy]";
			mes "……哇，你居然会在意？犯罪科学家女士，真让人意外。";
			next;
			cutin "ep171_elyumina02",2;
			mes "[Elyumina]";
			mes "闭嘴！没必要为笨蛋费心！";
			mes "反正我会在这里休息。我连一条腿都动不了。";
			next;
			cutin "16loo_01",2;
			mes "[Rookie]";
			mes "我需要照看米娜，所以会留在这里，冒险者。";
			next;
			cutin "16lei_01",2;
			mes "[Lazy]";
			mes "我不负责战斗。那么冒险者，你有什么请求吗？";
			next;
			select( "独自去水之庭院是命运吗……" );
			cutin "16loo_03",2;
			mes "[Rookie]";
			mes "抱歉，冒险者。和其他冒险者组队怎么样？";
			close2;
			cutin "",255;
			cloakonnpcself( "Elyumina#jh_ba3" );
			cloakonnpcself( "Rookie#jh_ba3" );
			cloakonnpcself( "Lazy#jh_ba3" );
			end;
		case 2:
			cutin "ep171_elyumina03",2;
			mes "[Elyumina]";
			mes "呃，我好像一时失去了理智，回过神就看到了世界末日！";
			mes "啊，这快把我逼疯了。喂，解毒剂什么时候完成？";
			emotion ET_KEK;
			close2;
			cutin "",255;
			cloakonnpcself();
			end;
		}
		// fall through
	}
	else if (ep172_watergarden == 4) {
		cloakoffnpcself( "Elyumina#jh_ba3" );
		cloakoffnpcself( "Rookie#jh_ba3" );
		cloakoffnpcself( "Lazy#jh_ba3" );
		select( "交出解毒剂。" );
		cutin "ep171_elyumina03",2;
		mes "[Elyumina]";
		mes "……这是什么？";
		mes "哦……原来如此。是解毒剂。";
		next;
		cutin "16loo_03",2;
		mes "[Rookie]";
		mes "很抱歉让你独自受苦。我们本该陪着你。";
		next;
		cutin "ep171_elyumina01",2;
		mes "[Elyumina]";
		mes "……谢谢你。";
		next;
		cutin "16lei_03",2;
		mes "[Lazy]";
		mes "嗯，我听不清。请大声点。";
		next;

//============================================================
que_house_s,83,47,3	script	Magic Board#homun_s	857,{
	playbgm "26.mp3"; // Everlasting Wanderers
	callfunc "F_HomMutateInfo","[Magic Board Posts]";
	mes "[Magic Board Posts]";
	mes ":: 研究^0000FF生命体^000000";
 	mes ":: 真是太有趣了。";
	mes ":: 做一个总是享受";
	mes ":: 自己研究成果的";
	mes ":: 炼金术士吧。";
	next;
	mes "[Magic Board Posts]";
	mes ":: 对了，Viorel……";
	mes ":: 关于你说的";
	mes ":: 昨天那件事……";
	mes "::";
	mes "::";
	next;
	mes "--------------------------";
	mes "其余内容似乎是私信，已被封存。";
	close2;
	if (checkquest(4157) > -1) {
		setquest 4158;
		erasequest 4157;
	}
	end;
}

function	script	F_HomMutateInfo	{
	.@npc_name$ = getarg(0);
	mes .@npc_name$;
	mes ":: 变异后的^0000FF生命体^000000能力";
	mes ":: 显然超越了";
	mes ":: 之前的状态。";
	mes ":: 此外，它的外观";
	mes ":: 也会随之进化。";
	next;
	mes .@npc_name$;
	mes ":: 新类型^0000FF生命体^000000的外观";
	mes ":: 可以根据不同物种";
	mes ":: 进行分类。";
	mes ":: 同一物种的生物";
	mes ":: 通常拥有相似的";
	mes ":: 外观。";
	next;
	mes .@npc_name$;
	mes ":: 通过生命体变异系统获得的";
	mes ":: ^0000FF生命体^000000的类别、外观和";
	mes ":: 能力";
	mes ":: 如下所示：";
	next;
	cutin "Mer_Eira_Card",3;
	mes .@npc_name$;
	mes ":: 五种形态中的第一种";
	mes ":: 叫作^FF4800Eira^000000。";
	mes ":: 美丽而优雅。";
	next;
	mes .@npc_name$;
	mes ":: ^FF4800Eira^000000使用";
	mes ":: ^006400风属性^000000魔法攻击和";
	mes ":: 支援技能。";
	mes ":: 它甚至能够";
	mes ":: 复活";
	mes ":: 倒下的主人。";
	next;
	mes .@npc_name$;
	mes ":: ^FF4800Eira^000000吃";
	mes ":: ^0000FF小雪花^000000。";
	mes ":: 只吃这么少的东西";
	mes ":: 也能生存，真令人惊讶。";
	mes ":: ^0000FF小雪花^000000可以从";
	mes ":: ^005DFF驯兽商人^000000处购买。";
	next;
	cutin "",255;
	cutin "Mer_Sera_Card",3;
	mes .@npc_name$;
	mes ":: 五种形态中的第二种";
	mes ":: 叫作^FF4800Sera^000000。";
	mes ":: 它看起来和^FF0000Mistress^000000一样，";
	mes ":: 但不会逃跑。";
	next;
	mes .@npc_name$;
	mes ":: ^FF4800Sera^000000";
	mes ":: 专精于^006400毒属性攻击^000000。";
	mes ":: 此外，它还会使用";
	mes ":: 以毒为媒介的独特支援技能。";
	next;
	mes .@npc_name$;
	mes ":: ^FF4800Sera^000000吃";
	mes ":: ^0000FF苹果布丁^000000。";
	mes ":: 它喜欢甜食。";
	mes ":: ^0000FF苹果布丁^000000可以从";
	mes ":: ^005DFF驯兽商人^000000处购买。";
	next;
	cutin "",255;
	cutin "Mer_Dieter_Card",3;
	mes .@npc_name$;
	mes ":: 五种形态中的第三种";
	mes ":: 是^FF4800Dieter^000000。";
	mes ":: 它外表独特，";
	mes ":: 性格却很温和。";
	next;
	mes .@npc_name$;
	mes ":: ^FF4800Dieter^000000使用";
	mes ":: ^FF0000火属性^000000攻击和";
	mes ":: 支援技能。";
	mes ":: 它和外表一样脆弱……";
	mes ":: 呃，可靠。";
	next;
	mes .@npc_name$;
	mes ":: ^FF4800Dieter^000000吃";
	mes ":: ^0000FF大细胞^000000。";
	mes ":: ^0000FF大细胞^000000可以从";
	mes ":: ^005DFF驯兽商人^000000处购买。";
	next;
	cutin "",255;
	cutin "Mer_Bayeri_Card",3;
	mes .@npc_name$;
	mes ":: 五种形态中的第四种";
	mes ":: 是^FF4800Bayeri^000000。";
	mes ":: Bayeri拥有";
	mes ":: 独角兽的形态。";
	next;
	mes .@npc_name$;
	mes ":: 它拥有强力的冲刺技能，";
	mes ":: 并使用^006400圣属性^000000魔法。";
	mes ":: 遗憾的是，";
	mes ":: 它不让你骑。";
	mes ":: 不是所有四足生物";
	mes ":: 都能骑。";
	next;
	mes .@npc_name$;
	mes ":: ^FF4800Bayeri^000000吃";
	mes ":: ^0000FF新鲜植物^000000。";
	mes ":: 无论多么饥饿，";
	mes ":: 它都不会吃腐烂的植物。";
	mes ":: ^0000FF新鲜植物^000000可以从";
	mes ":: ^005DFF驯兽商人^000000处购买。";
	next;
	cutin "",255;
	cutin "Mer_Eleanor_Card",3;
	mes .@npc_name$;
	mes ":: 五种形态中的最后一种";
	mes ":: 是^FF4800Eleanor^000000。";
	mes ":: 它外表女性化，";
	mes ":: 还拥有出色的物理技能。";
	next;
	mes .@npc_name$;
	mes ":: ^FF4800Eleanor^000000";
	mes ":: 会在战斗中依次使用";
	mes ":: ^006400打击或擒抱攻击^000000。";
	mes ":: 真是令人惊叹。";
	next;
	mes .@npc_name$;
	mes ":: ^FF4800Eleanor^000000吃";
	mes ":: ^0000FF小孩的饺子^000000。";
	mes ":: 别把它和普通";
	mes ":: 饺子搞混了。";
	mes ":: ^0000FF小孩的饺子^000000可以从";
	mes ":: ^005DFF驯兽商人^000000处购买。";
	next;
	cutin "",255;
	return;
}

// Books
//============================================================
que_house_s,13,52,3	script	Open Book#01homun_s	111,{
	switch(rand(1,7)) {

			mes "[Viorel]";
			mes "太棒了！";
			mes "我们继续吧。";
			next;
			specialeffect2 EF_BASH;
			mes "[Viorel]";
			mes "现在集中精神~！";
			mes "你需要……";
			mes "……集中精神。";
			next;
			specialeffect2 EF_PROVIDENCE;
			mes "[Viorel]";
			mes "很好。快完成了！";
			next;
			specialeffect2 EF_SUI_EXPLOSION;
			set Zeny, Zeny - 50000;
			hommutate .@Homunculus;
			break;
		case 2:
			emotion ET_SCRATCH;
			mes "[Viorel]";
			mes "那么，你选择的是不稳定变异流程。";
			mes "你相信命运吗？";
			mes "说真的……";
			mes "你真的想继续";
			mes "这个随机结果的流程吗？";
			next;
			if(select("继续。（随机变异）:取消。") == 2) {
				playbgm "33.mp3"; // Yuna Song
				mes "[Viorel]";
				mes "我明白了。";
				mes "再多花点时间考虑吧。";
				close;
			}
			emotion ET_THINK;
			mes "[Viorel]";
			mes "嗯……";
			mes "探索知识的道路";
			mes "充满了惊喜。";
			mes ".......";
			next;
			emotion ET_SMILE;
			mes "[Viorel]";
			mes "哈哈。";
			mes "嘿，我感觉自己像个铁匠！";
			mes "现在继续吧。";
			next;
			specialeffect2 EF_BASH;
			mes "[Viorel]";
			mes "现在集中精神~！";
			mes "你需要……";
			mes "……集中精神。";
			next;
			specialeffect2 EF_PRESSURE;
			mes "[Viorel]";
			mes "再集中一点精神！";
			next;
			specialeffect2 EF_PROVIDENCE;
			mes "[Viorel]";
			mes "很好。快完成了！";
			next;
			specialeffect2 EF_SUI_EXPLOSION;
			hommutate;
			break;
		}
		erasequest 4160;
		erasequest 4154;
		emotion ET_DELIGHT;
		playbgm "64.mp3"; // One Fine Day
		mes "[Viorel]";
		mes "好了，变异完成。";
		mes "呼……刚才很紧张吧？";
		next;
		mes "[Viorel]";
		mes "还记得^005DFFKellasus^000000说过的话吗？";
		mes "在真相的门口……";
		mes "我们必须亲自看清";
		mes "通往真相的道路。";
		next;
		mes "[Viorel]";
		mes "^0000FF" + strcharinfo(0) + "^000000,";
		mes "我认识你";
		mes "还没多长时间，";
		mes "但我感觉";
		mes "你一定会成就一番大事业。";
		next;
		mes "[Viorel]";
		mes "祝你的冒险顺利。";
		mes "希望你的新^FF4800生命体^000000能在你的照料下茁壮成长。";
		next;
		mes "[Viorel]";
		mes "还有，别忘了。";
		mes "我们的研究";
		mes "才刚刚开始~！";
		close;
	} else {
		for(set .@i,4154; .@i<=4160; set .@i,.@i+1) {
			if (checkquest(.@i) > -1)
				erasequest .@i;
		}
		mes "[Viorel]";
		mes "既然工作都完成了，请你离开吧。";
		mes "我需要休息一下。";
		close2;
		warp "job3_gen01",12,47;
		end;
	}
}

que_house_s,80,42,3	script	Jeyna#homun_s	558,{
	if (checkquest(4156) > -1) {
		playbgm "28.mp3"; // You're in Ruins
		emotion ET_SURPRISE;
		mes "[Jeyna]";
		mes "欢迎。";
		mes "我刚收到^005DFFViorel^000000的消息，知道你要来。";
		next;
		emotion ET_SCRATCH;
		mes "[Jeyna]";
		mes "对了……";
		mes "他是不是说服你做了什么……？";
		mes "他确实很会说话。";
		next;
		mes "[Jeyna]";
		mes "因为炼金术士都是些不善交际的人，所以他需要这项本事。";
		emotion ET_OHNO;
		next;
		mes "[Jeyna]";
		mes "总之~";
		mes "^0000FF"+strcharinfo(0)+"^000000和^005DFFViorel^000000看起来真是臭味相投。";
		next;
		emotion ET_SMILE;
		mes "[Jeyna]";
		mes "哈哈哈~别介意。";
		mes "我觉得这是好事。";
		mes "对了。";
		mes "你是来进行^FF4800生命体^000000变异的。";
		next;
		mes "[Jeyna]";
		mes "我准备期间，";
		mes "你不妨看看那块板子？";
		mes "^006400生命体变异系统^000000有^0000FF5种不同类型^000000的新变异。";
		next;
		emotion ET_SURPRISE, getnpcid(0, "Magic Board#homun_s");
		mes "[Jeyna]";
		mes "你的^FF4800生命体^000000可以变异成5种形态中的任意一种。";
		next;
		emotion ET_AHA;
		mes "[Jeyna]";
		mes "让我看看……";
		mes "^006400生命体变异系统^000000包含普通^0000FF生命体^000000的新进化形态。";
		mes "变异后，之前学会的技能也都会保留。";
		next;
		mes "[Jeyna]";
		mes "换句话说……";
		mes "即使把魔法型的^FF4800Vanilmirth^000000变成战斗型，";
		mes "像肆虐这样的技能也会";
		mes "^006400保留并且在变异后仍可使用^000000。";
		next;
		emotion ET_SURPRISE, getnpcid(0, "Magic Board#homun_s");
		mes "[Jeyna]";
		mes "看看我身后的魔法板，再自己做决定吧。";
		close2;
		setquest 4157;
		erasequest 4156;
		end;
	} else if (checkquest(4157) > -1) {
		emotion ET_QUESTION;
		mes "[Jeyna]";
		mes "看看我身后右边的板子。";
		close2;
		emotion ET_SURPRISE, getnpcid(0, "Magic Board#homun_s");
		end;
	} else if (checkquest(4158) > -1) {
		playbgm "28.mp3"; // You're in Ruins
		disable_items;
		mes "[Jeyna]";
		mes "好了，我也准备好了。";
		mes "现在要逆转流程，我需要处于胚胎形态的生命体。";
		next;
		callsub L_CheckHomunculus;
		if (checkweight(6415,1) == 0) {
			mes "[Jeyna]";
			mes "但是，";
			mes "你的背包没有足够空间携带^0000FF胚胎^000000。";
			mes "请留出足够的背包空间后再回来。";
			next;
			mes "[Jeyna]";
			mes "请回到^8B4513实验室^000000。";
			mes "清理背包后，你可以在^8B4513实验室^000000找到^005DFFViorel^000000。";
			next;
			mes "[Jeyna]";
			mes "清理完背包后，请让^005DFFViorel^000000把你送回这里。";
			mes "快去清理背包吧~！";
			close2;
			warp "job3_gen01",12,47;
			end;
		}
		mes "[Jeyna]";
		mes "现在差不多该做决定了。";
		mes "要通过生命体变异系统变异成新的^0000FF生命体^000000，";
		mes "你需要先经过退化流程，让生命体恢复到^0000FF胚胎^000000状态。";
		next;
		mes "[Jeyna]";
		mes "还有……";
		mes "^006400流程完成前，你无法使用召唤生命体技能。^000000";
		mes "不会花太久时间，所以别到处乱跑。";
		next;
		mes "[Jeyna]";
		mes "那么，请做决定吧。";
		mes "你要继续使用新的^0000FF生命体变异系统^000000吗？";
		next;
		switch(select("是的，我要继续。:我还需要考虑。")) {
		case 1:
			if (checkhomcall() == 1) {
				mes "[Jeyna]";
				mes "哦，等一下。";
				mes "要继续变异，你必须先让处于气化状态的生命体苏醒。";
				next;
				mes "[Jeyna]";
				mes "完成后再回来吧。";
				close;
			}
			emotion ET_BEST;
			mes "[Jeyna]";
			mes "考虑得很好。";
			mes "像我们这样的炼金术士，不能害怕挑战。";
			next;
			playbgm "01.mp3"; // Title
			mes "[Jeyna]";
			mes "现在请你集中精神。";
			next;
			specialeffect2 EF_ABSORBSPIRITS;
			mes "[Jeyna]";
			mes "我们需要……";
			mes "再稳定一点。";
			mes ".......";
			next;
			specialeffect2 EF_CURE;
			mes "[Jeyna]";
			mes "过一会儿，^FF4800生命体^000000就会恢复到胚胎状态。";
			next;
			specialeffect2 EF_HOLYHIT;
			mes "[Jeyna]";
			mes "变成特殊的胚胎……";
			next;
			callsub L_CheckHomunculus;
			specialeffect2 EF_BLESSING;
			morphembryo;
			setquest 4159;
			erasequest 4158;
			emotion ET_DELIGHT;
			mes "[Jeyna]";
			mes "呼~全部完成了。";
			mes "嗯，它的状态有点奇怪。";
			next;
			emotion ET_SMILE;
			mes "[Jeyna]";
			mes "应该没问题。";
			mes "别弄丢那个^0000FF奇异胚胎^000000。";
			mes "还有……";
			next;
			mes "[Jeyna]";
			mes "流程结束前，不要转职或做类似的事情。";
			mes "否则，^0000FF"+strcharinfo(0)+"^000000你可能会失去对生命体拥有的全部能力。";
			next;
			mes "[Jeyna]";
			mes "一直集中精神让我累了。";
			mes "我去喝杯水。";
			close;
		case 2:
			playbgm "28.mp3"; // You're in Ruins
			emotion ET_OHNO;
			mes "[Jeyna]";
			mes "也许一开始我就不该问。";
			close;
		}
	} else if (checkquest(4159) > -1 || checkquest(4160) > -1) {
		playbgm "28.mp3"; // You're in Ruins
		mes "[Jeyna]";
		mes "^005DFFViorel^000000会完成变异流程。";
		mes "现在该说再见了。";
		next;
		mes "[Jeyna]";
		mes "虽然相处时间很短，但很高兴认识你。";
		mes "我们以后还会再见的。";
		next;
		mes "[Jeyna]";
		mes "祝你好运~！";
		close2;
		setquest 4160;
		erasequest 4159;
		warp "que_house_s",19,42;
		end;
	} else {
		if (checkquest(4154) > -1)
			erasequest 4154;
		mes "[Jeyna]";
		mes "喂，你是怎么进来的？";
		mes "请出去。我正在换衣服~！";
		close2;
		warp "job3_gen01",12,47;
		end;
	}
	end;
L_CheckHomunculus:
	if (gethominfo(6) < 99 || (gethominfo(1) < 6009 || gethominfo(1) > 6016)) { // Not level 99+ evolved Homunculus
		mes "[Jeyna]";
		mes "喂，等等。";
		mes "^FF4800生命体^000000的状态不符合要求。";
		mes "真险。";
		next;
		mes "[Jeyna]";
		mes "要使用生命体变异系统";
		mes "变成新的";
		mes "^FF4800生命体^000000，";
		mes "^006400生命体必须达到99级以上并完成进化^000000。";
		next;
		mes "[Jeyna]";
		mes "准备好后再来找^005DFFViorel^000000。";
		mes "那就回头见~！";
		close2;
		erasequest 4154;
		erasequest 4158;
		warp "job3_gen01",12,47;
		end;
	}
	return;
}


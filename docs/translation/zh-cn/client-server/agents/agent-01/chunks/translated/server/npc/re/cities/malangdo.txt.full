// Malangdo Transportation :: malangdo_go
//============================================================
-	script	Dolangmal	-1,{
	if (checkquest(5091) == -1) {
		mes "[多朗马尔]";
		mes "嘿~！你好，人类~我是多朗马尔先生。咔咔咔~";
		next;
		mes "[多朗马尔]";
		mes "我们奉命带你前往猫咪的天堂——^A2314B马兰多^000000。";
		next;
		mes "[多朗马尔]";
		set .@s$,"要不要去^A2314B马兰多^000000？";
		switch(atoi(strnpcinfo(2))) {
			case 1: mes "怎么样？拥挤的普隆德拉不错，但为什么不去我们的猫咪天堂^A2314B马兰多^000000？"; break;
			case 2: mes "为什么不去^A2314B马兰多^000000？那里比只有朴实巫师的格芬更好。"; break;
			case 3: mes "斐扬空气清新也不错，但为什么不去像猫咪天堂^A2314B马兰多^000000这样的好地方？"; break;
			case 4: mes .@s$+"美丽安静的地方比钟声嘈杂的艾尔贝塔更好。"; break;
			case 5: mes .@s$+"美丽安静的地方比炎热多沙尘暴的梦罗克更好。"; break;
			case 6: mes .@s$+"美丽的地方比充满书籍和头痛的朱诺更好。"; break;
			case 7: mes .@s$+"复杂的地方比安静得可怕的拉赫更好。"; break;
			case 8: mes .@s$+"安全的地方比危险的里希塔乐镇更好。"; break;
			case 9: mes .@s$+"这个海边地方的气味比满是青草味的莫拉更好。"; break;
		}
		next;
		if(select("不去:^A2314B马兰多^000000~走吧~走吧~") == 1) {
			mes "[多朗马尔]";
			mes "什么！？你不想去^A2314B马兰多^000000？切！";
			next;
			mes "[多朗马尔]";
			mes "你真烦人。不去的话，干嘛来找我……不过……";
			next;
			mes "[多朗马尔]";
			mes "^9E1837托马斯上将^000000说要绑架人类……不对……礼貌地带他们来？";
			next;
			mes "[多朗马尔]";
			mes "总之，我记住你了。想去的时候告诉我。";
			close;
		}
		mes "[多朗马尔]";
		mes "好！我喜欢你的态度，充满热情。";
		next;
		mes "[多朗马尔]";
		mes "在你前往^A2314B马兰多^000000前，我先给你一些警告。";
		next;
		mes "[多朗马尔]";
		mes "第一！！抵达^A2314B马兰多^000000后，当然要通知^9E1837托马斯上将^000000你已到达。";
		next;
		mes "[多朗马尔]";
		mes "否则走过黑暗街道时，可能会被可怕的野猫袭击。";
		next;
		mes "[Dolangmal]";
		mes "第二！！^A2314B马兰多^000000绝对是我们的猫咪岛，虽然也对人类开放。";
		next;
		mes "[Dolangmal]";
		mes "我们有自己的个性……不……不……因为我们是猫，请像对待猫一样尊重我们。";
		next;
		mes "[Dolangmal]";
		mes "下一条是……";
		next;
		mes "多朗马尔继续讲了数百条警告。";
		next;
		mes "[Dolangmal]";
		mes "好了！警告就是这些！！很简单……对吧？记住了吗？";
		next;
		switch(select("记住他的警告:记不住")) {
		case 1:
			mes "[Dolangmal]";
			mes "好！不要一口咬两只老鼠。^9E1837托马斯上将^000000位于^A2314B马兰多船只中央^000000。";
			next;
			mes "[Dolangmal]";
			mes "别忘了通知他你的到达。";
			next;
			mes "[Dolangmal]";
			mes "好吧。去猫咪的天堂^A2314B马兰多^000000吧~";
			setquest 5091;
			completequest 5091;
			warp "malangdo",217,85;
			close;
		case 2:
			mes "[Dolangmal]";
			mes "什么！？连这么简单的规则都记不住？切！";
			next;
			mes "[Dolangmal]";
			mes "你真烦人。记不住的话，刚才为什么不告诉我？我都告诉你了……不过……";
			next;
			mes "[Dolangmal]";
			mes "^9E1837托马斯上将^000000说要绑架人类……不对……应该礼貌地带他们来？";
			next;
			mes "[Dolangmal]";
			mes "总之，我记住你了。想去的时候告诉我。";
			close;
		}
	}
	mes "[Dolangmal]";
	mes "嗯？你一定是上次那个人……？好吧。你去过^A2314B马兰多^000000了吗？";
	next;
	switch(select("再次带我去^A2314B马兰多^000000:我去过了")) {
	case 1:
		mes "[Dolangmal]";
		mes "我很想送你去，但政策不允许。很难把去过^A2314B马兰多^000000的人再次送去。";
		next;
		mes "[Dolangmal]";
		mes "大致就是这样……这应该是第 53 条规则……";
		next;
		mes "[Dolangmal]";
		mes "其实，我告诉你第 53 条规则吧。我是只宽容的猫。";
		next;
		mes "[Dolangmal]";
		mes "想回到^A2314B马兰多^000000，就在伊兹鲁德或艾尔贝塔乘船。";
		next;
		mes "[Dolangmal]";
		mes "享受愉快的海上旅程后，你就会抵达猫咪的天堂^A2314B马兰多^000000。";
		next;
		mes "[Dolangmal]";
		mes "很简单吧！那么，再见~";
		close;
	case 2:
		mes "[Dolangmal]";
		mes "怎么样？喜欢吗？我就知道。咔咔咔~";
		next;
		mes "[Dolangmal]";
		mes "啊！我只是想确认一下……";
		next;
		mes "[Dolangmal]";
		mes "再问一次，想回^A2314B马兰多^000000的话，你知道在伊兹鲁德或艾尔贝塔哪里乘船吗？";
		next;
		mes "[Dolangmal]";
		mes "嗯~你这么聪明，应该知道吧。下次见~";
		close;
	}
}
prontera,114,77,6	duplicate(Dolangmal)	Dolangmal#1	553
geffen,109,61,6	duplicate(Dolangmal)	Dolangmal#2	553
payon,200,106,4	duplicate(Dolangmal)	Dolangmal#3	553
aldebaran,170,104,4	duplicate(Dolangmal)	Dolangmal#4	553
morocc,168,275,4	duplicate(Dolangmal)	Dolangmal#5	553
yuno,165,122,4	duplicate(Dolangmal)	Dolangmal#6	553
rachel,121,126,4	duplicate(Dolangmal)	Dolangmal#7	553
lighthalzen,254,83,5	duplicate(Dolangmal)	Dolangmal#8	553
mora,57,150,4	duplicate(Dolangmal)	Dolangmal#9	553

-	script	::Odgnalam	-1,{
	mes "这只猫正在温暖的"+((strnpcinfo(2) == "albe")?"艾尔贝塔":"伊兹鲁德")+"阳光下睡觉。";
	next;
	if(select("让他睡吧:和他说话") == 1) close;
	mes "[Odgnalam]";
	mes "喵？嗯？";
	next;
	if (ep13_yong1 == 0) {
		set .@price,1000;
		set .@s1$,"Huh! You are so annoying. Let me send you to ^A2314BMalangdo^000000 for ^0000FF1000 Zeny^000000.";
		set .@s2$,"Money? Where is the money? You can't go anywhere without the money. Shame on you.";
	} else if (ep13_yong1 < 60) {
		set .@price,999;
		set .@s1$,"You have a little relationship with fleet of cat. I'll give you special discount price ^0000FF999 Zeny^000000 to ^A2314BMalangdo^000000, because you have relationship with fleet.";
		set .@s2$,"Where is the money? You don't have a sense of honor.";
	} else if (ep13_yong1 > 59 && ep13_yong1 < 80) {
		set .@price,500;
		set .@s1$,"You gave several help to our cat's fleet so let me give you special that with 50% discount price ^0000FF500 Zeny^000000. I'll send you to ^A2314BMalangdo^000000.";
		set .@s2$,"You don't have any money for paying 50% discount price? I can't believe it.";
	} else {
		mes "[Odgnalam]";
		mes "你是猫咪舰队的英雄。你的事迹在我们之间是传奇。";
		next;
		mes "[Odgnalam]";
		mes "既然你是猫咪舰队的英雄，我就免费送你去^A2314B马兰多^000000。";
		next;
		if(select("送我去马兰多！:不去了。") == 1) {
			mes "[Odgnalam]";
			mes "旅途舒适……好了，出发~";
			warp "malangdo",217,85;
		}
		close;
	}
	mes "[Odgnalam]";
	mes .@s1$;
	next;
	if(select("送我去马兰多！:不去了。") == 2) close;
	if (Zeny < .@price) {
		mes "[Odgnalam]";
		mes "钱呢？钱在哪里？没有钱哪儿也去不了。真丢脸。";
		close;
	}
	set Zeny, Zeny - .@price;
	mes "[Odgnalam]";
	mes "我马上送你过去。出发~";
	warp "malangdo",217,85;
	close;
}
alberta,200,151,4	duplicate(Odgnalam)	Odgnalam#albe	554
izlude,182,218,4	duplicate(Odgnalam)	Odgnalam#iz	554	// Old coordinates: (182,192)
izlude_a,182,218,4	duplicate(Odgnalam)	Odgnalam#iz_a	554
izlude_b,182,218,4	duplicate(Odgnalam)	Odgnalam#iz_b	554
izlude_c,182,218,4	duplicate(Odgnalam)	Odgnalam#iz_c	554
izlude_d,182,218,4	duplicate(Odgnalam)	Odgnalam#iz_d	554

malangdo,219,86,4	script	Kong#malang	545,{
	mes "[Kong]";
	mes "在马兰多玩得开心吗？";
	mes "舰队提供前往伊兹鲁德和艾尔贝塔的服务。";
	next;
	if (ep13_yong1 == 0) {
		set .@price,1000;
		set .@s1$, "1000 zeny";
		set .@s2$, "Have a nice day in Malangdo.";
		set .@no_money$, "It is difficult for free.";
		set .@yes_money$, "Have a nice trip.";
		mes "[Kong]";
		mes "船费只有 1000 Zeny，你想去哪里？";
		next;
	} else if (ep13_yong1 < 60) {
		set .@price,999;
		set .@s1$,"999 zeny";
		set .@s2$, "Have a full of fortune day in Malangdo...";
		set .@no_money$, "It is difficult even though you have a relationship with the fleet.";
		set .@yes_money$, "Thanks, have a wonderful trip.";
		mes "[Kong]";
		mes "你与我们的舰队有联系。享受 999 Zeny 特价。你想去哪里？";
		next;
	} else if (ep13_yong1 > 59 && ep13_yong1 < 80) {
		set .@price,500;
		set .@s1$,"500 zeny";
		set .@s2$, "There are full of fortune and jackpot in Malangdo.";
		set .@no_money$, "Oh my god. You don't have 500 zeny? It is difficult for free.";
		set .@yes_money$, "Have a nice trip and come again.";
		mes "[Kong]";
		mes "哇~你为舰队贡献良多。好吧！！特别折扣价 500 Zeny。你想去哪里？";
		next;
	} else {
		set .@price,0;
		set .@s1$,"Free for the hero of our fleet!!";
		set .@s2$, "No one objects to the hero of our fleet staying in Malangdo...";
		mes "[Kong]";
		mes "啊……你是我们猫咪舰队的传奇英雄。";
		next;
		mes "[Kong]";
		mes "我们不能向舰队英雄收费。你的目的地是哪里？";
		next;
	}
	set .@i, select("- Izlude destination --- "+.@s1$+":- Alberta destination --- "+.@s1$+":- Stay on Malangdo");
	mes "[Kong]";
	if (.@i == 3) {
		mes .@s2$;
		close;
	}
	if (ep13_yong1 > 80) {
		mes "旅途舒适。";
		if (.@i == 1)
			warp "izlude",195,212; // Old coordinates: (194,180)
		else
			warp "alberta",192,150;
		close;
	}
	if (Zeny < .@price) {
		mes .@no_money$;
		close;
	}
	set Zeny, Zeny - .@price;
	mes .@yes_money$;
	if (.@i == 1)
		warp "izlude",195,212;
	else
		warp "alberta",192,150;
	close;
}

// Generic Malangdo NPCs :: malang_tre
//============================================================
malangdo,147,117,3	script	Innkeeper#malang	554,{
	mes "你看到一只懒猫站在椅子上。";
	mes "你猜这就是旅馆老板。";
	next;
	switch(select("嗯……我能在这里休息吗？:嘘……我能在这里保存吗？:离开。")) {
	case 1:
		mes "[Innkeeper]";
		mes "咦？";
		mes "呃，当然可以，只要给我 ^FF00005 个马兰岛罐头^000000。";
		next;
		switch(select("给你。:算了。")) {
		case 1:
			if (countitem(12636) > 4) {
				delitem 12636,5; //Malang_Sp_Can
				percentheal 100,100;
				specialeffect2 EF_HEALSP;
				mes "[Innkeeper]";
				mes "现在放松吧。";
				emotion ET_CHUP;
				next;
				warp "malangdo",140,121;
				close;
			}
			mes "[Innkeeper]";
			mes "这里不是慈善机构。";
			close;
		case 2:
			mes "[Innkeeper]";
			mes "想放松时告诉我。";
			close;
		}
	case 2:
		mes "[Innkeeper]";
		mes "地点已保存。我们以后常联系，哈哈~";
		savepoint "malangdo",142,118,1,1;
		close;
	case 3:
		mes "[Innkeeper]";
		mes "有时你就是该放松一下。";
		next;
		mes "- 哇，这真是世上最懒的猫。-";
		close;
	}
	close;
}

malangdo,151,120,3	script	Minstrel#mal	479,{
	mes "[Minstrel]";
	mes "那只懒猫让我也想睡一整天。";
	next;
	mes "[Minstrel]";
	mes "他让生活看起来如此简单。";
	close;
}

malangdo,149,120,5	script	Wanderer#mal	485,5,1,{
	mes "[Wanderer]";
	mes "住在这里的猫都精力充沛。";
	mes "它们让我想跳一整天舞，这很奇怪吗？";
	mes "啦滴哒滴哒~！";
	close;
OnTouch:
	switch(rand(5)) {
	case 0:
		soundeffect "ring_of_nibelungen.wav",0;
		break;
	case 1:
		soundeffect "dont_forget_me_not.wav",0;
		break;
	case 2:
		soundeffect "humming.wav",0;
		break;
	case 3:
		soundeffect "assassin_of_sunset.wav",0;
		break;
	case 4: 
		emotion ET_DELIGHT;
		emotion ET_DELIGHT, getnpcid(0, "Minstrel#mal");
		break;
	}
	end;
}

malangdo,216,168,3	script	Cat Trainer#mal1	558,0,8,{
	emotion ET_COOL;
	mes "[Cat Trainer]";
	mes "哦哦~它们柔软蓬松的尾巴和软毛~";
	mes "我受不了了，这就是天堂~~！！";
	next;
	emotion ET_KIK;
	mes "[Cat Trainer]";
	mes "我的秘密王牌^FF0000猫薄荷果实^000000能让马兰多所有猫成为我的奴隶~哈哈！";
	next;
	select("^FF0000Silvervine Fruit^000000?");
	mes "[Cat Trainer]";
	mes "这是非常稀有的物品！";
	mes "我也很难弄到。";
	mes "但这些可爱的猫无法抵抗它~";
	next;
	select("在哪里能得到^FF0000猫薄荷果实^000000？");
	mes "[Cat Trainer]";
	mes "我自己都很难弄到，为什么要告诉你？";
	mes "就算给我全世界的 Zeny，我也不会告诉你~！";
	next;
	emotion ET_KIK;
	mes "[Cat Trainer]";
	mes "马兰多的猫都是我的~！";
	mes "呜哈哈哈哈~";
	mes "有足够的^FF0000猫薄荷果实^000000，我就能成为马兰多女王~哦哦哦！！！";
	close;
OnTouch:
	emotion ET_SPARK;
	end;
}

malangdo,164,203,3	script	Cat Trainer#mal2	853,{
	emotion ET_COOL;
	mes "[猫咪训练师]";
	mes "哦哦~它们柔软蓬松的尾巴和软毛~";
	mes "我受不了了，这就是天堂~~！！";
	next;
	emotion ET_KIK;
	mes "[猫咪训练师]";
	mes "这就是我的小秘密，叫作";
	mes "^FF0000猫薄荷果实^000000。它能让";
	mes "马兰多的猫成为我的";
	mes "奴隶~呜哈哈哈哈~！";
	next;
	select("^FF0000猫薄荷果实^000000？");
	mes "[猫咪训练师]";
	mes "嗯，难怪你不知道。";
	mes "这些马兰多的猫无法抵抗它。";
	mes "不过它太稀有了，你就别费心寻找。";
	next;
	select("在哪里能得到^FF0000猫薄荷果实^000000？");
	mes "[猫咪训练师]";
	mes "其实很简单。你只要……";
	next;
	mes "[猫咪训练师]";
	mes "嘿，你差点让我说出秘密。";
	next;
	emotion ET_KIK;
	mes "[猫咪训练师]";
	mes "总有一天这些猫会属于我。";
	mes "我可以成为马兰多的国王~哦哦~！";
	close;
}

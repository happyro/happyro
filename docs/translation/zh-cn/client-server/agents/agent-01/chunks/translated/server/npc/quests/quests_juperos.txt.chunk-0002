			mes "别忘了我拜托你的事。";
			mes "如果你在朱佩洛斯找到任何具有历史意义的东西，";
			mes "请尽快带给我，我会很感激。";
			close;
		}
	case 10:
		mes "[Fayruz]";
		mes "哦，你好，"+strcharinfo(0)+"……";
		mes "这次是什么风把你吹到朱诺图书馆来了？";
		next;
		switch(select("我又找到一块透明板。:其实只是来参观。")) {
		case 1:
			if (countitem(7352) || countitem(7353) || countitem(7354) || countitem(7355)) {
				mes "[Fayruz]";
				mes "嗯，我们利用你之前给我的透明板已经取得了尽可能多的进展，";
				mes "不过证据越多越能支持我的理论。";
				next;
				mes "[Fayruz]";
				mes "我非常感谢你一直努力帮助我。";
				mes "请收下这个，算是我的谢意。";
				mes "你真是太棒了，"+strcharinfo(0)+"……";
				if (countitem(7352)) delitem 7352,1;
				else if (countitem(7353)) delitem 7353,1;
				else if (countitem(7354)) delitem 7354,1;
				else delitem 7355,1;
				getitem 644,1;
				close;
			}
			mes "[Fayruz]";
			mes "嗯……？";
			mes "看起来你没有带来另一块透明板。";
			mes "你确定不是放错地方了吗？";
			close;
		case 2:
			mes "[Fayruz]";
			mes "啊，我明白了。多亏你的帮助，我的论文取得了很大进展。";
			mes "冒险者，我真的很感谢你为我所做的一切。";
			close;
		}
	}

function Func_JupHist {

	lighthalzen,182,102,3	script	Lucius#zen5	866,{
	if (Zeny < 90000) {
	mes "[Lucius]";
	mes "你好，年轻人~";
	mes "愿意捐款帮助饥饿的人吗？";
	next;
	if (select("好的。：不用了，谢谢。") == 1) {
	mes "[Lucius]";
mes "你可以捐赠 1 至 30,000 Zeny，";
mes "用于帮助穷人、喂养饥饿的孩子。";
mes "要取消请输入‘0’。";
	next;
		input .@input;
		if (.@input > 30000 || .@input < 0) {
		mes "[Lucius]";
		mes "年轻人，请输入 1 至 30,000 的数值";
		mes "来捐赠给需要帮助的人。";
		close;
		}
			else if (.@input == 0) {
			mes "[Lucius]";
			mes "真令人失望，不过我相信你有理由。";
			mes "等你有能力帮助穷人时，欢迎随时回来。";
			close;
			}
			mes "[Lucius]";
			mes "非常感谢";
			mes "感谢你捐赠 "+ .@input +" Zeny。";
				mes "我保证这笔钱会用于帮助贫困者。";
				next;
				if (Zeny < .@input) {
				mes "[Lucius]";
				mes "不过我有点失望。";
				mes "像你这样的冒险者应该尽可能多捐一些……";
			close;
			}
				set Zeny, Zeny-.@input;
				set $donatedzeny,$donatedzeny + .@input;
				mes "[Lucius]";
				mes "到目前为止，我收到总计 " + $donatedzeny + " Zeny 的捐款。";
				mes "很高兴看到世上仍有善良慷慨的人。";
				if ($donatedzeny > 260000) {
				next;
				mes "[Lucius]";
			mes "这些应该足够送给贫困救济组织。";
			mes "冒险者，请收下这份小礼物以表谢意。";
			mes "年轻人，愿你平安，保重。";
			set $donatedzeny,0;
			getitem 603,1; //Old_Blue_Box
			getitem 12016,1; //Speed_Up_Potion
			}
			close;
			}
				mes "[Lucius]";
				mes "我明白。不过请记住，";
				mes "发自内心的付出会得到十倍回报。";
				mes "当然，回报不总是立刻显现。";
				close;
				}
			mes "[Lucius]";
			mes "你好，年轻人~";
			mes "你看起来相当富裕。钱当然很好，";
			mes "但要小心不要沉迷其中。";
			next;
			mes "[Lucius]";
			mes "有机会时，请向那些";
			mes "比你不幸得多的人展示慷慨。";
			close;
			}
				

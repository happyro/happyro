hu_in01,387,245,0	script	Allen Schuwell	849,2,2,{
	if (BaseLevel > 49) {
		if (hg_herb == 0) {
			mes "[Allen]";
			mes "*Groooooan~*";
			mes "啊，我的背好痛……";
			mes "还有我的胃……为什么";
			mes "我必须这样受苦，";
			mes "而别人却能过着幸福奢华的生活？";
			next;
			mes "[Allen]";
			mes "我只有儿子这一个家人。";
			mes "他以前是个乖巧听话的孩子，";
			mes "但现在我怀疑他还关心父亲吗！";
			mes "我让那个懒孩子赶紧把药带来……";
			next;
			mes "[Allen]";
			mes "但他担心父亲的痛苦吗？！不！";
			mes "我敢说他正和那些不成器的混混朋友鬼混！";
			mes "啊！疼痛加剧了！我……我需要药！";
			next;
			mes "[Allen]";
			mes "哦！我能明显感觉到病情加重了！";
			mes "冒险者，请帮帮病人吧？";
			mes "请找到我的儿子波斯特尔，告诉他把药带来！";
			next;
			switch(select("好的。:不，抱歉。")) {
			case 1:
				mes "[Allen]";
				mes "非、非常感谢！";
				mes "请向东走出城镇，应该就能找到波斯特尔。";
				mes "告诉他我现在需要‘科尔本 A’！";
				set hg_herb,1;
				setquest 8053;
				next;
				mes "[Allen]";
				mes "还要告诉他，如果他不改过自新……";
				mes "我可能会和亲生儿子断绝关系！";
				mes "如果他不爱父亲，在我眼里他就已经死了！";
				close;
			case 2:
				mes "[Allen]";
				mes "我……我不明白……！";
				mes "你怎么能让病人独自受苦？";
				mes "我、我急需帮助！";
				mes "不！求你别走！";
				close;
			}
		} else if (hg_herb == 2) {
			mes "[Allen]";
			mes "波斯特尔……我的儿子……";
			mes "你为什么抛弃我？";
			mes "我躺在死亡边缘，";
			mes "那孩子甚至不来看父亲！";
			next;
			mes "[Allen]";
			mes "但你……我可以依靠你。";
			mes "即使在里希塔乐镇，我也找不到像你这样可靠的人。";
			mes "这次我决定教训那个不成器的儿子。";
			mes "你能再帮我一次吗？";
			next;
			mes "[" +strcharinfo(0)+ "]";
			mes "等等，等等……";
			mes "里希塔乐镇？";
			mes "你以前住在那里吗？";
			next;
			mes "[Allen]";
			mes "呃？嗯，那只是我的口头禅。";
			mes "你知道的，就像举个例子。";
			mes "我、我——^333333*咳嗽！*^000000哦，不好了。";
			mes "我的^333333*咳！*^000000胰腺！还是肝脏！";
			mes "我又发作了！";
			next;
			mes "[" +strcharinfo(0)+ "]";
			mes "......";
			mes ".........";
			mes "............";
			next;
			mes "[Allen]";
			mes "哦，一切都变得好黑！";
			mes "求、求你了，如果你有一点怜悯，";
			mes "哪怕一点人性，能给我一瓶白色药水吗？";
			next;
			switch(select("给予白色药水:无视")) {
			case 1:
				if (!countitem(504)) {
					mes "[Allen]";
					mes "哦……不好了……！你也没有白色药水？！";
					mes "那、那我该怎么办——？！救救我，";
					mes "请尽快带一瓶白色药水来！^333333*咳嗽！*^000000";
					close;
				} else {
					delitem 504,1; //White potion
					mes "[Allen]";
					mes "哦，谢谢你！";
					mes "好、好痛……";
					mes "白色药水一定能帮忙。";
					mes "一、一定要有效！";
					next;
					mes "["+strcharinfo(0)+"]";
					mes "......";
					mes ".........";
					mes "............";
					next;
					mes "[Allen]";
					mes "啊，这个……*呼*";
					mes "非常感谢。现在我只要等儿子把药带来。";
					mes "等等，要是他花太久才到呢？不、不，要是……";
					next;
					mes "[Allen]";
					mes "要、要是波斯特尔带药来之前我又胃溃疡发作呢？！";
					mes "我可能撑不过去！冒、冒险者，请陪在我身边直到儿子回来，好吗？求、求你了？";
					next;
					set hg_herb,3;
					changequest 8054,8055;
					mes "[" +strcharinfo(0)+ "]";
					mes "......";
					mes ".........";
					mes "............";
					close;
				}
			case 2:
				mes "[Allen]";
				mes "等、等等！你、你要看着我死吗？";
				mes "不！^333333*咳嗽*^000000啊！瘟疫！";
				mes "诅咒你们两家！";
				close;
			}
		} else if (hg_herb == 3) {
			mes "[Allen]";
			mes "*喘气* 我……我能";
			mes "感觉到了！我好像又要";
			mes "发生中子攻击！啊，已经影响到";
			mes "我神经系统里的所有中子了！";
			next;
			mes "[Allen]";
			mes "抬、抬不起来……";
			mes "腿和手指……";
			mes "但是……必须……拿到……";
			mes "''Withstander'' medicine...";
			mes "从……抽屉……救、救救我！";
			mes "冒险者！救、救命～！";
			set hg_herb,4;
			// changequest 8055,8056;
			close;
		} else if (hg_herb == 4) {
			mes "[Allen]";
			mes "不……！";
			mes "隧道尽头有光！";
			mes "求你了，冒险者！靠、靠近我一点！";
			mes "别让我走进那道光！";
			close;
		} else if (hg_herb == 6) {
			mes "^3355FF你交出了";
			mes "你给艾伦服用维特斯坦德药水，";
			mes "他很快就把药喝光了。^000000";
			next;
			mes "[Allen]";
			mes "血液……循环……";
			mes "血液……流过四肢……思绪……";
			mes "逐渐清晰……恢复……";
			next;
			mes "[Allen]";
			mes "啊，多、多么令人安心。看来我还能活过今天。";
			mes "非、非常感谢你……";
			set hg_herb,7;
			close;
		} else if (hg_herb == 7) {
			mes "[Allen]";
			mes "我……我不行了……！";
			mes "我几乎无法呼吸！";
			mes "冒、冒险者，我又需要你了！";
			mes "请、请靠近我！我、我想我需要心肺复苏！";
			close;
		} else if (hg_herb == 9) {
			mes "^3355FF你又给艾伦服用了一剂";
			mes "维特斯坦德。^000000";
			next;
			if (rand(1,3) == 3) {
				mes "[Allen]";
				mes "哦……谢谢你……";
				mes "我感觉好多了。";
				mes "我的儿子波斯特尔应该很快就会来。";
				mes "谢谢你一直耐心陪着我……";
				set hg_herb,10;
				close;
			}
			mes "[Allen]";
			mes "哦……谢谢你……";
			mes "你、你真是天使，简直就是弗洛伦斯·南丁格尔。";
			mes "请陪我直到儿子回来。";
			mes "你不会现在抛下这个病人吧？";
			next;
			mes "[" +strcharinfo(0)+ "]";
			mes "(^333333你的儿子波斯特尔最好快点来！^000000)";
			set hg_herb,7;
			close;
		} else if (hg_herb == 10) {
			mes "[Allen]";
			mes "啊！我的韧带！";
			mes "疼得厉害！";
			mes "哦，不好了！我想我的骨头感染了！";
			mes "救救我，求你了！";
			next;
			donpcevent "Postell Schuwell#D::OnEnable";
			mes "[Allen]";
			mes "哦……";
			mes "我的儿子……！";
			mes "波、波斯特尔！";
			next;
			mes "[Postell]";
			mes "呃……嗨，爸爸。";
			mes "我把你急需的药带来了。";
			specialeffect EF_CHANGECOLD,AREA,"Postell Schuwell#D";
			next;
			mes "[Allen]";
			mes "谢天谢地……";
			mes "快、快给我！";
			mes "^333333*Gulp gulp gulp*^000000";
			next;
			mes "[Allen]";
			mes "等、等等……";
			mes "不对劲。邦科尔 A";
			mes "不是这个味道……";
			emotion ET_SWEAT, getnpcid(0, "Postell Schuwell#D");
			next;
			mes "[Postell]";
			mes "邦科尔 A……？";
			mes "我以为你说想要科尔本 A？";
			next;
			mes "[Allen]";
			mes "亲生儿子竟然骗我！你想耍我吗，波斯特尔？！";
			mes "我告诉过你要拿邦科尔 A！";
			next;
			mes "[" +strcharinfo(0)+ "]";
			mes "(^333333等等……艾伦说的确实是科尔本 A……^000000)";
			next;
			mes "[Postell]";
			mes "好吧，我想是我弄错了。爸爸，我马上回来带你要的药。";
			mes "不会花很久，别为此操心。";
			close2;
			set hg_herb,11;
			disablenpc "Postell Schuwell#D";
			emotion ET_SWEAT, playerattached();
			emotion ET_SWEAT;
			end;
		} else if (hg_herb == 11) {
			mes "[Allen]";
			mes "*抽泣*我早该知道";
			mes "波斯特尔其实真的关心我。";
			mes "我真希望自己从未在里希塔乐镇生病……";
			mes "这样我们都不会受苦……";
			next;
			mes "[Allen]";
			mes "别担心，冒险者。";
			mes "我没有忘记你。请看看药品抽屉，喜欢什么就拿什么吧～";
			set hg_herb,12;
			changequest 8055,8056;
			close;
		} else if (hg_herb == 12) {
			mes "[Allen]";
			mes "别担心，冒险者。";
			mes "我没有忘记你。请看看药品抽屉，喜欢什么就拿什么吧～";
			close;
		} else if (hg_herb == 13) {
			mes "[Allen]";
			mes "你找到我放在药品抽屉里的旧蓝盒了吗？";
			mes "东西不算贵重，但希望你喜欢。";
			mes "就当作我对你帮助的感谢吧～";
			close;
		} else {
			mes "[Allen]";
			mes "*Groooooan~*";
			mes "啊，我的背好痛……";
			mes "还有我的胃……为什么我必须这样受苦，";
			mes "而别人却能过着幸福奢华的生活？";
			close;
		}
	} else {
		mes "[Allen]";
		mes "*Groooooan~*";
	mes "啊，我的背好痛……";
	mes "还有我的胃……为什么我必须这样受苦，";
	mes "而别人却能过着幸福奢华的生活？";
		close;
	}

OnTouch_:
	if (hg_herb == 4) {
		mes "[Allen]";
		mes "^333333*Cough cough!*^000000";
		mes "维、维特斯坦德……！";
		mes "我需要维、维特斯坦德！";
		mes "求、求你！^333333*咳咳！*^000000";
		set hg_herb,5;
		donpcevent "#DrawerOpener::OnEnable";
		close;
	} else if (hg_herb == 7) {
		mes "[Allen]";
		mes "^333333*Whew*^000000";
		mes "我……我又能呼吸了！";
		mes "但、但要是我再次发作呢？！";
		mes "请、请再给我一剂维特斯坦德，以防万一！";
		set hg_herb,8;
		donpcevent "#DrawerOpener::OnEnable";
		close;
	}
	
}

hu_in01,385,247,5	script	Postell Schuwell#D	97,{
	mes "[Postell]";
	mes "嘿，呃……";
	mes "我正在忙着做事。";
	close;

OnInit:
	disablenpc "Postell Schuwell#D";
	end;

OnEnable:
	enablenpc "Postell Schuwell#D";
	initnpctimer;
	end;

OnTimer100000:
	disablenpc "Postell Schuwell#D";
	stopnpctimer;
	end;
}

hu_fild06,34,123,3	script	Postell Schuwell	97,{
	if (hg_herb == 1) {
		mes "[Postell]";
		mes "我很喜欢住在胡格。";
		mes "空气清新，水质干净，大家都友善亲切。";
		mes "我还能奢求什么呢？";
		next;
		mes "[Postell]";
		mes "哦，怎么了？";
		mes "我爸爸要我给他带药？";
		mes "又来？他很久以前确实病得很重，";
		mes "但现在我就不太确定了。";
		next;
		mes "[Postell]";
		mes "我的意思是，我很确定他的病都是心因性的。";
		mes "而且我担心他服用的药会让人上瘾，你知道吗？";
		next;
		switch(select("但你父亲需要你！:会让人上瘾？")) {
		case 1:
			mes "[Allen's Voice]";
			mes "是啊，我想你说得对。";
			mes "即使我觉得他疯了，也不同意他的做法，";
			mes "至少也该表现出我关心爸爸。";
			mes "他说需要什么药？";
			next;
			mes "[Postell]";
			mes "‘科尔本 A’？好吧，";
			mes "我最好确认它对他来说是安全的。";
			mes "谁知道呢，那东西可能让他更糟。";
			mes "总之，我会尽快带给他。";
			next;
			mes "[Postell]";
			mes "嘿，能帮我个忙，确保我爸爸别再惹出麻烦吗？";
			mes "如果你能做到，我会非常感激。";
			set hg_herb,2;
			changequest 8053,8054;
			close;
		case 2:
			mes "[Postell]";
			mes "是啊，就像他对药上瘾一样。";
			mes "所以我才尽量让他少吃一点！";
			mes "老实说，我觉得他已经喝太多药了……";

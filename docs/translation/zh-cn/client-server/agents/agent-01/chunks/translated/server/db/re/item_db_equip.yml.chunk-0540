      if (BaseLevel>=210) {
         bonus bAtkRate,7;
         bonus bBaseAtk,70;
      }
      if (BaseLevel>=220) {
         bonus2 bSkillAtk,"NW_THE_VIGILANTE_AT_NIGHT",5;
      }
      if (BaseLevel>=230) {
         bonus2 bAddSize,Size_All,10;
      }
      if (.@r>=7) {
         bonus bLongAtkRate,10;
         if (.@r>=9) {
            bonus2 bSkillAtk,"NW_THE_VIGILANTE_AT_NIGHT",10;
            if (.@r>=10) {
               bonus bDelayrate,-10;
               if (.@r>=11) {
                  bonus2 bSkillAtk,"NW_THE_VIGILANTE_AT_NIGHT",10;
               }
            }
         }
      }
      if (.@g>=ENCHANTGRADE_D) {
         bonus bLongAtkRate,15;
         if (.@g>=ENCHANTGRADE_C) {
            bonus2 bSkillAtk,"NW_THE_VIGILANTE_AT_NIGHT",5;
            if (.@g>=ENCHANTGRADE_B) {

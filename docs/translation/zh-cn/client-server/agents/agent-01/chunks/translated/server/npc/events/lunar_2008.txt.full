//===== rAthena Script =======================================
//= Lunar New Year Event (2008)
//===== By: ==================================================
//= L0ne_W0lf
//===== Current Version: =====================================
//= 1.1
//===== Compatible With: =====================================
//= rAthena Project
//===== Description: =========================================
//= iRO Lunar New Year event; Year of the Rat. (2008)
//= Kill Cramps, Taruus, and Matrins to retrieve "Rice Pouches"
//= in return for various rice-themed foods, envelopes, and
//= a "New year Doll" egg. Rates are guessed.
//=
//= Cramp, Tarou, and Matrin drops altered, Uncomment in
//= mob_db2 to enable. [required]
//=
//= Miss Lunar NPC uses the sprite 4_f_nacoruri, which isn't
//= standard in kRO's data files. If you're having problems
//= or are unsure if your client supports that sprite, an
//= alternate NPC header has been included.
//===== Additional Comments: =================================
//= 1.0 First version. [L0ne_W0lf]
//= 1.1 Added missing checkweights. [L0ne_W0lf]
//============================================================

payon_in01,193,30,4	script	Rice Mill Grandma#rat	78,{
	mes "[Rice Mill Grandma]";
	if (!lunar_rat) {
		mes "那些肮脏的小东西！";
		mes "到处乱窜，";
		mes "还从我这里偷东西！";
		mes "要是它们没那么快就好了……";
		next;
		select("怎么了？");
		mes "[Rice Mill Grandma]";
		mes "哦，我正在制作年糕和糕点";
		mes "庆祝新年，但这些动物";
		mes "一直偷走我准备的米袋。";
		next;
		select("米袋？");
		mes "[Rice Mill Grandma]";
		mes "是的，我儿子需要米袋";
		mes "把米放进臼里捣碎，但没有米";
		mes "我就做不了糕点。你觉得";
		mes "能帮我吗？";
		next;
		if (select("当然。:我根本不认识你。") == 1) {
		set lunar_rat,1;
		mes "[" + strcharinfo(0)+"]";
		mes "当然。";
		mes "我能做什么？";
		next;
		mes "[Rice Mill Grandma]";
			mes "你能抓住偷走我米袋的动物吗？";
			mes "就是那些蓝白色的老鼠";
			mes "和讨厌的小鼹鼠。";
			next;
			select("没问题。");
			mes "[" + strcharinfo(0)+"]";
			mes "没问题。";
			mes "我会抓住那些动物，";
			mes "把找到的米袋带回来。";
			next;
			mes "[Rice Mill Grandma]";
			mes "哦，谢谢你！";
			mes "祝你抓住那些害虫好运~";
			close;
			}
			mes "[Rice Mill Grandma]";
			mes "我……嗯……";
			mes "确实如此，但我本打算";
			mes "送你一些好东西作为帮助的回报。";
			mes "我知道你不是坏人，所以……";
			close;
			}
			else if ((lunar_rat >= 1 && lunar_rat <= 2) || lunar_rat == 4) {
			if (countitem(7770) >= 1 && lunar_rat == 2) {
			mes "哦，那是我儿子做的甜米吗？";
		mes "可以给我吗？";
		mes "请在这里等一会儿，";
		mes "我会给你做些糕点~";
		delitem 7770,1; //Sweet_rice
		set lunar_rat,3;
		close;
		}
		else if (lunar_rat == 4) {
		if (countitem(7770) >= 1) {
	mes "哦，那是我儿子做的甜米吗？";
	mes "可以给我吗？";
		mes "请在这里等一会儿，";
			mes "我会给你做些糕点~";
			delitem 7770,1; //Sweet_rice
			set lunar_rat,5;
			close;
			}
			mes "哦，米袋都去哪儿了？";
			mes "我们还需要它们制作更多年糕……";
			close;
		}
		else if (countitem(7869) < 1 && lunar_rat <= 2) {
			mes "哦，那些蓝白色老鼠可能偷走了米袋，";
				mes "那些鼹鼠大概也拿走了一些。";
				mes "真是讨厌的小东西，对吧？";
				close;
				}
				mes "哦，那是我的米袋吗？抱歉，";
				mes "但我的髋部疼得厉害……";
				mes "你能帮个忙，";
				mes "替我把它送给儿子吗？";
			set lunar_rat,2;
			close;
			}
			else if (lunar_rat == 3 || lunar_rat == 5) {
			set .@reward,rand(1,100);
		if (.@reward <= 5) {
		if (lunar_rat == 3) {
			getitem 9038,1; // New_Year_Doll_Egg
			set lunar_rat,4;
			}
			else if (lunar_rat == 5) {
			getitem 668,1; // Red_Envelope
			}
			}
		else if (.@reward >= 6 && .@reward <= 10) getitem 12198,2; // Lucky_Rice_Cake
		else if (.@reward >= 11 && .@reward <= 30) getitem 12195,3; // Plain_Rice_Cake
		else if (.@reward >= 31 && .@reward <= 40) getitem 12196,2; // Hearty_Rice_Cake
		else if (.@reward >= 41 && .@reward <= 55) getitem 12123,2; // Honey_Pastry
		else if (.@reward >= 56 && .@reward <= 70) getitem 12122,2; // Sesame_Pastry
		else if (.@reward >= 71 && .@reward <= 80) getitem 12124,2; // Rainbow_Cake
		else if (.@reward >= 81 && .@reward <= 90) getitem 12198,2; // Korean_Rice_Cake
		else if (.@reward >= 91 && .@reward <= 100) getitem 12197,3; // Salty_Rice_Cake
		// After getting the egg there is a chance to get an envelope with each turn in
	if (rand(1,20) <= 5 && lunar_rat == 4) getitem 668,1; // Red_Envelope
	// Set the quest accordingly for repeat turn-ins.
		if (lunar_rat == 3) set lunar_rat,2;
		else if (lunar_rat == 5) set lunar_rat,4;
			mes "这远不足以回报你";
				mes "为我所做的一切，但请收下";
				mes "我刚做的糕点。请享用~";
			next;
			mes "[Rice Mill Grandma]";
				mes "谢谢你的甜米！";
			mes "如果你再带来一些，";
		mes "我一定会为你做美味的东西，好吗？";
		close;
		}
		}
		+ 
		
		
		
		
		
		
		
		
		
		
		
		
		
		
		
		
		
		
		
		
		
		
	



	
	
		
		
		
		
		
		
	
	
		
		
		
		
		
		
		
	payon,215,127,4	script	Rice Mill Man#rat	54,{
	mes "[Rice Mill Man]";
		if (!lunar_rat) {
			mes "真让人心痛……";
			mes "妈妈花了这么多时间为新年准备米，";
			mes "却全被老鼠和害虫偷走了！";
			close;
			}
			else if (lunar_rat == 1) {
			mes "我听母亲说";
		mes "你在帮助她。";
		mes "她是位可爱的老太太，对吧？";
		mes "如果你找到米袋，";
		mes "可以交给她";
		mes "先检查它们。";
		close;
		}
		else if (lunar_rat >= 2) {
		if (countitem(7869) < 1) {
		mes "如果你带来米袋，";
		mes "我就能把米捣成甜米。";
		mes "你是来帮助我母亲的，对吧？";
		mes "谢谢，我真的很感激。";
		close;
		}
		mes "哦，你从我母亲那里带来了米袋？";
		mes "等我一下，我马上把米";
		mes "捣成米糊。";
		next;
		mes "[Rice Mill Man]";
		mes "呼！哈！嘿呀！";
		mes "呜沙！呜沙！";
	mes "咔——！";
mes "呜沙！";
next;
mes "[Rice Mill Man]";
mes "完成了。来，这些甜米";
	mes "可以做成糕点了。";
	mes "能请你把它带给我母亲吗？";
		delitem 7869,1; //Rice_Pouch
		getitem 7770,1; //Sweet_Rice
		close;
		}
		}
		
	//payon,126,113,4	script	Miss Lunar#rat	862,{
	payon,126,113,4	script	Miss Lunar#rat	719,{
		mes "[Lunar]";
		if ((MaxWeight-Weight) < 3000 || checkweight(1201,1) == 0) {
		mes "哦，抱歉，你携带的东西太多，";
		mes "我们无法做生意。";
		mes "能否把一些物品存进卡普拉仓库？";
		close;
	}
	if (lunar_rat < 4) {
		mes "我想赚够钱买那枚";
		mes "大大的新月银别针。";
		mes "所以要尽可能多卖这些麻薯！";
		close;
		}
		else if (lunar_rat >= 4) {
		mes "哦，你好！我在卖用甜米制作的";
		mes "特制年糕。你可以自己吃，";
		mes "也可以喂给宠物新年娃娃。";
		next;
		mes "[Lunar]";
		mes "总之，我正在出售";
		mes "10 个麻糬，售价 3,000 Zeny";
			mes "想买一些尝尝吗？";
				next;
				if (select("是:否") == 1) {
				if (Zeny >= 3000) {
				set Zeny,Zeny-3000;
				getitem 554,10; // Mojji
				mes "[Lunar]";
				mes "谢谢，祝你新年快乐！";
			mes "请再来~";
			close;
			}
			mes "[Lunar]";
			mes "哦，抱歉，你现在";
			mes "没有足够的 Zeny……";
		close;
		}
		mes "[Lunar]";
		mes "哦，好吧。如果你或朋友";
		mes "之后还想要麻薯，";
		mes "我会在这里。再见~";
		close;
	}
}

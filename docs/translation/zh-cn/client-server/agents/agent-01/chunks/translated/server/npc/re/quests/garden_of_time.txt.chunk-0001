function	script	F_mesnavi	{
	return "<NAVI>[" + getarg(0) + "]<INFO>" + getarg(1) + "," + getarg(2) + "," + getarg(3) + ",0,101,0</INFO></NAVI>";
}

// Warps
xmas_fild01,158,246,2	script	Dimensional barrier#got1	GATE_SKYBLUE,2,2,{
	// Fallthrough
OnTouch:
	warp "t_garden",116,47;
	end;

OnInit:
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "BaseLevel >= 250 && isbegin_quest(12592) == 0" );
	end;
}

t_garden,111,36,2	script	Dimensional Barrier#got2	GATE_SKYBLUE,2,2,{
	// Fallthrough
OnTouch:
	warp "xmas_fild01",150,240;
	end;
}

// t_garden,118,66,0	script	#wp01	HIDDEN_WARP_NPC,3,1,{	// (NPC name is not unique)
t_garden,118,66,0	script	#wp01_t_garden	HIDDEN_WARP_NPC,3,1,{
	end;
OnTouch:
	specialeffect2 EF_FLOWERCAST;
	setpcblock PCBLOCK_NPC, true;
	sleep2 500;
	setpcblock PCBLOCK_NPC, false;
	if (BaseLevel < 250)
		warp "xmas_fild01",150,240;
	else
		warp "t_garden",118,79;
	end;
}

// t_garden,118,72,0	script	#wp02	HIDDEN_WARP_NPC,3,1,{	// (NPC name is not unique)
t_garden,118,72,0	script	#wp02_t_garden	HIDDEN_WARP_NPC,3,1,{
	end;
OnTouch:
	specialeffect2 EF_FLOWERCAST;
	setpcblock PCBLOCK_NPC, true;
	sleep2 500;
	setpcblock PCBLOCK_NPC, false;
	if (BaseLevel < 250)
		warp "xmas_fild01",150,240;
	else
		warp "t_garden",118,61;
	end;
}


// Quest starter
t_garden,116,47,0	script	#life_wp11	HIDDEN_WARP_NPC,2,2,{
	end;
OnTouch:
	if (BaseLevel < 250)
		end;
	if (isbegin_quest(12592) == 0) {
		removespecialeffect 1145, AREA, "Oscar#life";
		cloakoffnpcself( "Oscar#life" );
		cloakoffnpcself( "Leticia#life" );
		cloakoffnpcself( "Rigel#life" );
		specialeffect 1145, AREA, "Oscar#life";
		end;
	}
	end;
}
	
t_garden,114,49,6	script(CLOAKED)	Leticia#life	4_4JOB_LETICIA,{
	mes "^0000ff她正在向奥斯卡解释事情，所以没有注意你。^000007";
	close;
}

t_garden,118,49,3	script(CLOAKED)	Rigel#life	4_CS_RIGEL,{
	mes "^0000ff他们似乎正专注于奥斯卡和莱蒂西亚的故事。^000007";
	close;
}

t_garden,119,46,2	script(CLOAKED)	Oscar#life	4_ED_OSCAR,{
	if (BaseLevel < 250)
		end;
	if (isbegin_quest(12592) == 0) {
		emotion ET_THROB;
		mes "^0000ff奥斯卡似乎正在和某人交谈。^000000";
		next;
		if (select( "退出并离开", "在旁边偷听。" ) == 1) {
			mes "^0000ff当然，偷听就是这样。^000000";
			close;
		}
		cutin "OSCAR03.bmp",2;
		mes "[奥斯卡]";
		mes "所以，你的意思是我偶然在卢迪附近发现裂缝，进来后找到了这座花园？";
		next;
		cutin "4job_leticia_01.png",2;
		mes "[莱蒂西亚]";
		mes "没错！";
		next;
		cutin "OSCAR03.bmp",2;
		mes "[奥斯卡]";
		mes "你为什么要这么做，莱蒂西亚？";
		next;
		cutin "4job_leticia_04.png",2;
		mes "[莱蒂西亚]";
		mes "为什么！这里不是看起来很有用吗？漂亮的花园和无法辨认的宅邸！太完美了，奥斯卡！";
		next;
		cutin "OSCAR03.bmp",2;
		mes "[奥斯卡]";
		mes "你不明白，莱蒂西亚。你发现了裂缝，但我想问的是，为什么不将它熄灭就叫我来这里。";
		next;
		cutin "4job_leticia_05.png",2;
		mes "[莱蒂西亚]";
		mes "嗯……确实，摧毁它太浪费了。";
		next;
		cutin "OSCAR03.bmp",2;
		mes "[奥斯卡]";
		mes "你因为浪费就没有摧毁它~然后呢？";
		next;
		cutin "4job_leticia_02.png",2;
		mes "[莱蒂西亚]";
		mes "奥斯卡，你一直没有合适的住处，到处流浪。无论你人多好，也不该这样随便自愿帮忙！";
		next;
		cutin "OSCAR09.bmp",2;
		mes "[奥斯卡]";
		mes "Huh?";
		next;
		cutin "rigel_halfeyes02.png",2;
		mes "[里格尔]";
		mes "莱蒂西亚是在请求你别再像无家可归的人一样，买一栋像样的房子，过星座般的生活。一直无视别人的话可不好。";
		next;
		cutin "OSCAR07.bmp",2;
		mes "[奥斯卡]";
		mes "无家可归……我有那么糟吗？你就是这样看我的，莱蒂西亚？";
		next;
		cutin "4job_leticia_02.png",2;
		mes "[莱蒂西亚]";
		mes "就连很久以前来到这片大陆的参宿四，也已经有了自己的房子！奥斯卡这样没有住处到处流浪，太不合理了！";
		next;
		cutin "OSCAR04.bmp",2;
		mes "[奥斯卡]";
		mes "好吧，我明白你的意思了。我还得想想如何妥善处理……";
		next;
		cutin "rigel05.png",2;
		mes "[里格尔]";
		mes "根据我的观察，有几处不稳定的次元通道，但似乎并不太危险。莱蒂西亚说得有道理。";
		next;
		cutin "rigel_halfeyes02.png",2;
		mes "[里格尔]";
		mes "我和莱蒂西亚应该能为不稳定的次元通道找到合适用途。你觉得呢，莱蒂西亚？";
		next;
		cutin "4job_leticia_05.png",2;
		mes "[莱蒂西亚]";
		mes "我同意，里格尔！我想给花园中央附近的不稳定区域施加地牢形式的限制，就能让它稳定下来。这件事交给我！";
		next;
		cutin "rigel_halfeyes02.png",2;
		mes "[里格尔]";
		mes "花园北部的花园不稳定，并与另一个次元相连。我会在那里处理一些事情。";
		next;
		cutin "OSCAR05.bmp",2;
		mes "[奥斯卡]";
		mes "哇，没想到你们两个相处得这么好。不会是提前计划好的吧？";
		next;
		cutin "rigel_halfeyes01.png",2;
		mes "[里格尔]";
		mes "那不重要，奥斯卡。你对中央宅邸有什么感觉吗？";
		next;
		cutin "OSCAR01.bmp",2;
		mes "[奥斯卡]";
		mes "哦，你说‘那个’？我感觉很清楚。";
		next;
		cutin "rigel_halfeyes02.png",2;
		mes "[里格尔]";
		mes "这似乎涉及^0000ff时间^000000，所以我和莱蒂西亚都无能为力。奥斯卡，你能做到，对吧？";
		next;
		cutin "OSCAR07.bmp",2;
		mes "[奥斯卡]";
		mes "唉……这是我的责任，无论成败我都应该去。";
		next;
		cutin "4job_leticia_05.png",2;
		mes "[莱蒂西亚]";
		mes "那么，我们先去维护花园吧。附近有个正在偷听的冒险者，一起去正好！";
		next;
		select( "什么？我也去？" );
		cutin "4job_leticia_04.png",2;
		mes "[莱蒂西亚]";
		mes "这不是明摆着的吗？既然你听到了这里的故事，应该已经知道发生了什么。别废话，跟我进花园。";
		setquest 12592;
		completequest 12592;
		setquest 12593;
		setquest 12594;
		setquest 12618;
		close2;
		cutin "",255;
		cloakonnpcself( "Oscar#life" );
		cloakonnpcself( "Leticia#life" );
		cloakonnpcself( "Rigel#life" );
		end;
	}
	end;

OnInit:
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "BaseLevel >= 250 && isbegin_quest(12592) == 0" );
	end;
}


// A. Quests to access dungeons
// t_garden,118,91,0	script	#wp01	HIDDEN_WARP_NPC,2,2,{	// (NPC name is not unique)
t_garden,118,91,0	script	#wp01_t_garden_1	HIDDEN_WARP_NPC,2,2,{
	end;
OnTouch:
	if (isbegin_quest(12592) == 2) {
		cloakoffnpcself( "Leticia#life2" );	// note: always uncloaked at this point
		end;
	}
	end;
}

t_garden,118,91,6	script(CLOAKED)	Leticia#life2	4_4JOB_LETICIA,{
	if (isbegin_quest(12593) == 1) {
		cutin "4job_leticia_02.png",2;
		mes "[莱蒂西亚]";
		mes "那座宅邸内部的时间流动与现在不同。因此我们不知道奥斯卡何时能完全修复宅邸。";
		next;
		cutin "4job_leticia_01.png",2;
		mes "[莱蒂西亚]";
		mes "但我们不能坐以待毙。而且根据来过这里的精灵所说，似乎还有其他事情要做。";
		next;
		cutin "4job_leticia_05.png",2;
		mes "[莱蒂西亚]";
		mes "我听说原本守护这里的精灵，被不知为何变得凶暴的同伴赶了出去。";
		next;
		cutin "4job_leticia_04.png",2;
		mes "[莱蒂西亚]";
		mes "可能是因为能量流动不稳定，自然属性被扭曲，精灵也变得凶暴。据说它们暂时在花园西北方休息。";
		next;
		cutin "4job_leticia_04.png",2;
		mes "[莱蒂西亚]";
		mes "据它们所说，原因是来自与这里相连次元的外来精灵，所以最好减少那些外来者的数量。";
		next;
		cutin "4job_leticia_01.png",2;
		mes "[莱蒂西亚]";
		mes "我需要你的帮助。我要收集东西两侧的能量流来制造大门，我们走吧。";
		completequest 12593;
		setquest 12595;
		setquest 12596;
		close3;
	}
	if (isbegin_quest(12595) == 1 || isbegin_quest(12596) == 1) {
		cutin "4job_leticia_01.png",2;
		mes "[莱蒂西亚]";
		mes "并非所有出口都已启动。启动东西两侧的出口后再来找我。";
		close3;
	}
	if (isbegin_quest(12620) == 0) {
		cutin "4job_leticia_01.png",2;
		setpcblock PCBLOCK_NPC, true;
		sleep2 500;
		setpcblock PCBLOCK_NPC, false;
		cutin "4job_leticia_05.png",2;
		mes "[莱蒂西亚]";
		mes "我们把附近请求帮助的精灵都聚集起来，集中在中央广场西北方。它们真的很吵。";
		next;
		cutin "4job_leticia_03.png",2;
		mes "[莱蒂西亚]";
		mes "它们可能只是在等你到来。帮不帮它们由你决定，但帮助精灵不会有损失。我建议至少去一次。";
		setquest 12620;
		close3;
	}
	cutin "4job_leticia_01.png",2;
	mes "[莱蒂西亚]";
	mes "你试过和精灵交谈吗？和它们成为朋友不会有坏处。";
	close3;

OnInit:
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "isbegin_quest(12593) == 1" );
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "isbegin_quest(12620) == 0 && isbegin_quest(12595) == 2 && isbegin_quest(12596) == 2" );
	end;
}

t_garden,82,92,0	script	#life_wp2	HIDDEN_WARP_NPC,3,3,{
	end;
OnTouch:
	switch( isbegin_quest(12595) ) {
	case 0:
		end;
	case 1:
		cutin "4job_leticia_01.png",2;
		mes "[莱蒂西亚]";
		mes "好了，这就够了。它会打开通往时间封印上不洁能量所在之处的通道。";
		next;
		cutin "4job_leticia_02.png",2;
		mes "[莱蒂西亚]";
		mes "准备好了吗？向前伸手，盯着封印，仿佛要把我给予你的力量集中到封印上。";
		// close2;
		next;
		select( "伸手并注视封印" );
		setpcblock PCBLOCK_NPC, true;
		cutin "",255;
		specialeffect2 EF_BEGINSPELL_N3;
		sleep2 2500;
		specialeffect EF_LORD, AREA, "Passage of Time#1";
		sleep2 1500;
		specialeffect EF_BAKU, AREA, "Passage of Time#1";
		sleep2 1000;
		specialeffect EF_THUNDERSTORM2, AREA, "Passage of Time#1";
		cloakoffnpcself( "Passage of Time#1" );
		sleep2 1000;
		setpcblock PCBLOCK_NPC, false;
		if (isbegin_quest(12596) == 1) {
			cutin "4job_leticia_04.png",2;
			mes "[莱蒂西亚]";
			mes "那么，我们也打开另一个吧。前往这扇门对面的地点。";
			completequest 12595;
			close3;
		}
		cutin "4job_leticia_04.png",2;
		mes "[莱蒂西亚]";
		mes "比你想象的简单，对吧？这样一来，在奥斯卡完成宅邸前，就能阻止奇怪的家伙涌入花园，真让人安心。";
		next;
		cutin "4job_leticia_01.png",2;
		mes "[莱蒂西亚]";
		mes "既然你已经帮过我，从现在起每天都要和我一起工作。没什么大不了的，减少这里通道下方地牢里的不洁之物吧。";
		next;
		select( "我好像以前听过这句话" );
		cutin "4job_leticia_03.png",2;
		mes "[莱蒂西亚]";
		mes "你嘀咕什么？有什么不满吗？";
		next;
		select( "没有。" );
		cutin "4job_leticia_05.png",2;
		mes "[莱蒂西亚]";
		mes "我想已经完成了。到中央广场来，我们谈谈下一步。";
		completequest 12595;
		close3;
	case 2:
		cloakoffnpcself( "Passage of Time#1" );
		end;
	}
	end;

OnInit:
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "isbegin_quest(12595) == 1" );
	end;
}

// t_garden,78,92,2	script(CLOAKED)	Passage of Time#1	GATE_SKYBLUE,2,2,{	// unknown OnTouch effect (NPC unreachable)
t_garden,78,92,2	script(CLOAKED)	Passage of Time#1	GATE_SKYBLUE,{
	if (isbegin_quest(12595) != 2)
		end;
	if (isbegin_quest(12596) != 2) {
		cutin "4job_leticia_01.png",2;
		mes "[莱蒂西亚]";
		mes "并非所有出口都已启动。启动东西两侧的出口后再来找我。";
		close3;
	}
	switch( select( "遗忘的记忆，区域 1，6 点钟方向", "遗忘的记忆，区域 1，中央", "遗忘的记忆，区域 1，10 点钟方向" ) ) {
	case 1:
		warp "for_dun01",159,35;
		break;
	case 2:
		warp "for_dun01",101,136;
		break;
	case 3:
		warp "for_dun01",62,266;
		break;
	}
	end;
}


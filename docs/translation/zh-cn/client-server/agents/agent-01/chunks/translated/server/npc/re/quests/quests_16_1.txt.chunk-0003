prt_cas,104,240,5	script	Skia Nerius#ep16_02	4_EP16_SKIA,{
	if (ep16_royal < 4) {
		if (isbegin_quest(7684) == 0) {
			npctalk "......", "Skia Nerius#ep16_02", bc_self;
			end;
		}
		cutin "ep16_skia_nerius01",0;
		mes "[Skia]";
	mes "伊温。";
	mes "你觉得宴会怎么样？";
	mes "这是我第一次参加这样的宴会，所以有点紧张……";
		next;
		mes "[Skia]";
	mes "也不是说我从没参加过宴会……";
	mes "该怎么解释呢？";
		next;
		cutin "ep16_spica_nerius01",2;
		mes "[Spica]";
	mes "你不用解释。";
	mes "这只是家事。";
		next;
		cutin "ep16_skia_nerius01",0;
		mes "[Skia]";
	mes "对。";
	mes "请原谅我絮叨。";
	mes "对不起。";
		close3;
	}
	if (ep16_royal == 4)
		F_banquet_main_4_spica();
	if (ep16_royal == 5) {
		cutin "ep16_skia_nerius01",0;
		mes "[Skia]";
		mes "尼希尔一定离开宴会厅了。";
		mes "他应该去了王室别墅。我们往那边走。";
		close3;
	}
	if (ep16_royal >= 6) {
		cutin "ep16_skia_nerius02",0;
		mes "[Skia]";
	mes "糟糕的事好像接连不断。";
		close3;
	}
}

prt_cas,106,240,3	script	Spica Nerius#ep16_02	4_EP16_SPICA,{
	if (ep16_royal < 4) {
		if (isbegin_quest(7684) == 0) {
		npctalk "……打扰了。", "Spica Nerius#ep16_02", bc_self;
			end;
		}
		mes "[Spica]";
	mes "你是来享受宴会的，对吧？";
	mes "你拜访过其他家族了吗？";
		cutin "ep16_spica_nerius01",2;
		next;
		mes "[Spica]";
	mes "平时几乎不可能见到他们。你能正式拜访他们，真是个好机会。";
	mes "他们甚至正在等你……";
		next;
		mes "[Spica]";
	mes "真是一次成功的社交亮相！";
	mes "机会难得，不要错过。";
		next;
		mes "[Spica]";
	mes "谁也不知道会发生什么！";
		close3;
	}
	if (ep16_royal == 4)
		F_banquet_main_4_spica();
	if (ep16_royal == 5) {
		mes "[Spica]";
		mes "嗯？你还在这里。我还以为你去追海涅家族的大人了。";
		cutin "ep16_spica_nerius05",2;
		next;
		select("你不是回房间了吗？");
		mes "[Spica]";
		mes "我只是推了妹妹一把。";
		mes "我很好奇斯基亚会有什么反应。";
		mes "……你不去跟着他吗？";
		next;
		cutin "ep16_spica_nerius02",2;
		mes "[Spica]";
		mes "我有预感大事就要发生了。";
		mes "你最好跟上那位大人，确认他没事。";
		mes "记住，这是我的建议。";
		close3;
	}
	if (ep16_royal >= 6) {
		cutin "ep16_spica_nerius02",2;
		mes "[Spica]";
		mes "我不喜欢最近事情的发展。";
		mes "……我想我快要压不住了。";
		close3;
	}
}

prt_cas,108,240,3	script	Crux Findel#ep16_02	4_EP16_CRUX,{
	if (ep16_royal < 4) {
		if (isbegin_quest(7684) == 0) {
			npctalk "......", "Crux Findel#ep16_02", bc_self;
			end;
		}
		cutin "ep16_crux_findel01.bmp",2;
		mes "[Crux]";
		mes "不用在意我。";
		mes "我只是个护卫。";
		close3;
	}
	if (ep16_royal == 4) {
		cutin "ep16_crux_findel01",2;
		mes "[Crux]";
		mes "我们又见面了。";
		mes "小姐一直在等你。";
		close3;
	}
	if (ep16_royal == 5) {
		cutin "ep16_crux_findel01",2;
		mes "[Crux]";
		mes "我正在考虑小姐下达的命令。";
		mes "我需要离开她身边去调查……";
		next;
		mes "[Crux]";
		mes "坦白说，把她一个人留下让我很不安。";
		next;
		cutin "ep16_spica_nerius03",0;
		mes "[Spica]";
		mes "我不是小孩子，你知道的。";
		mes "还是说我让你想起了在河岸奔跑的女儿？";
		next;
		cutin "ep16_crux_findel02",2;
		mes "[Crux]";
		mes "女儿？";
		mes "哈哈哈，真有趣。";
		mes "不过说实话，你看起来不像那个年纪。";
		next;
		mes "[Crux]";
		mes "你可能又会被那些孩子攻击。";
		next;
		cutin "ep16_spica_nerius04",0;
		mes "[Spica]";
		mes "哼！谁能胜过你呢？";
		mes "你不用担心我。";
		close3;
	}
	if (ep16_royal >= 6) {
		cutin "ep16_crux_findel01",2;
		mes "[Crux]";
		mes "我想我们暂时回不了本家了。";
		mes "不过，这也许反而是件好事。";
	npctalk "……哦，太好了。真是件好事。", bc_self;
		close3;
	}
	end;
OnInit:
	cloakonnpc "Nyhill M. Heine#ep16_02";
	cloakonnpc "Violeta#ep16_02";
	cloakonnpc "Royal Chamberlain#ep16_02";
	end;
}

prt_cas,183,164,0	script	#ep16_evt_7689	HIDDEN_WARP_NPC,2,3,{
	end;
OnTouch:
	if (ep16_royal == 5) {
		.@name$ = strcharinfo(0);
		.@char_id = getcharid(0);
		unittalk getcharid(3), "" + .@name$ + "：……嗯？谁来了？", bc_self;
		setpcblock PCBLOCK_NPC, true;
		sleep2 2000;
		cloakoffnpcself( "#ep16_7689_01" );
		cloakoffnpcself( "#ep16_7689_02" );
		npctalk "进展如何？", "#ep16_7689_02", bc_self;
		sleep2 2000;
		npctalk "嗯……虽然没有达到预期，但我似乎已经有线索了。", "#ep16_7689_01", bc_self;
		sleep2 3000;
		npctalk "不错。", "#ep16_7689_01", bc_self;
		sleep2 3000;
		npctalk "才过了一会儿……", "#ep16_7689_02", bc_self;
		sleep2 3000;
		npctalk "药效非常好。哈哈……正如我听说的，那位大人完全无法抵抗。", "#ep16_7689_01", bc_self;
		sleep2 1000;
		unittalk getcharid(3), "" + .@name$ + " : (Lord?)", bc_self;
		sleep2 3000;
		npctalk "现在该怎么办？", "#ep16_7689_02", bc_self;
		sleep2 3000;
		npctalk "把他留在那里吧。他们会以为他只是喝醉了一点。", "#ep16_7689_01", bc_self;
		sleep2 3000;
		npctalk "那么，我们为大事件做准备吧。", "#ep16_7689_01", bc_self;
		sleep2 1000;
		cloakonnpcself( "#ep16_7689_01" );
		cloakonnpcself( "#ep16_7689_02" );
		cloakoffnpcself( "Skia Nerius#ep16_7689" );
		npctalk "你找到尼希尔了吗？", "Skia Nerius#ep16_7689", bc_self;
		sleep2 1000;
		unittalk getcharid(3), "" + .@name$ + "：什么？！", bc_self;
		sleep2 2000;
		npctalk "你为什么这么惊讶？你在看什么？", "Skia Nerius#ep16_7689", bc_self;
		sleep2 3000;
		npctalk "对了，就要开始了。尼希尔去哪儿了？", "Skia Nerius#ep16_7689", bc_self;
		sleep2 3000;
		npctalk "尼希尔会在那间房里吗？他说因为爷爷大公爵，他不喜欢待在王室别墅。", "Skia Nerius#ep16_7689", bc_self;
		sleep2 3000;
		npctalk "我们进那间房吧！", "Skia Nerius#ep16_7689", bc_self;
		if (ep16_royal == 5) {
			setquest 7690;// Where Is Nyhill?
			erasequest 7689;// Find Nyhill
			ep16_royal = 6;
		}
		sleep2 3000;
		setpcblock PCBLOCK_NPC, false;
		cloakonnpcself( "Skia Nerius#ep16_7689" );
	}
	end;
OnInit:
	cloakonnpc "Skia Nerius#ep16_7689";
	cloakonnpc "#ep16_7689_02";
	cloakonnpc "#ep16_7689_01";

	questinfo( QTYPE_QUEST, QMARK_NONE, "isbegin_quest(7690) == 1" );
	end;
}

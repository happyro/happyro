//===== rAthena Script =======================================
//= BattleGround System - KvM Item Dealer
//===== Description: =========================================
//= [Official Conversion]
//= Kreiger Von Midgard Battleground Point redemption NPC
//= * NOTE * 
//= KvM Does NOT use items, but a character variable to
//= keep track of points. This NPC when talked to will
//= convert already-given tokens and convert them to points.
//= under the player variable kvm_point.
//===== Changelogs: ==========================================
//= 1.0 First Version. [L0ne_W0lf]
//============================================================

bat_room,151,144,3	script	KVM Logistic Officer#a	734,{
	if (countitem(6376)) {// KVM_Badge
		set .@pointstoadd,countitem(6376);
		delitem 6376,.@pointstoadd;
		set kvm_point,kvm_point+.@pointstoadd;
		mes "[后勤人员]";
		mes "我看到的是 "+getitemname(6376)+" 吗？";
		mes "我们不再接受这种货币，";
		mes "但我可以为你兑换，";
		mes "所以你有 "+.@pointstoadd+" 个 "+getitemname(6376)+"？";
		mes "好了，你现在有 ^580080"+ kvm_point +"^000000 KVM 点数。";
		next;
	}
	if (checkweight(1201,1) == 0) {
		mes "- 请稍等！！ -";
		mes "- 你当前携带了 -";
		mes "- 太多物品。 -";
		mes "- 请稍后再试 -";
		mes "- 减轻负重后。 -";
		close;
	}
	mes "[后勤人员]";
	mes "你好？";
	mes "我负责发放 KVM 点数奖励物品。";
	mes "请仔细选择你想兑换的奖励。";
	mes "兑换后无法撤销。";
	mes "如有疑问，可以先查看目录。";
	mes "物品一旦选错无法撤销，";
	mes "请务必小心。";
	mes "请选择下一步。";
	next;
	set .@name$,strcharinfo(0);
		switch(select("阅读 KVM 目录。：购买 KVM 物品。：确认 KVM 点数。：KVM 奖励说明。：KVM 点数说明。")) {
		case 1:
		mes "[后勤人员]";
		mes "这是 KVM 物品目录。";
		mes "每件武器需要 2,000 点，";
		mes "每件防具需要 10 至 1,200 点。";
		mes "选择奖励时请务必小心。";
		close2;
		readbook 11017,1;
	end;
		case 2:
	mes "[后勤人员]";
		mes "你想查看哪些物品？";
		mes "物品的详细规格请参阅";
		mes "^3131FF目录^000000。";
		next;
		switch(select("武器:防具/饰品:量产防具/饰品:普及型防具/饰品")) {
		case 1:
	mes "[后勤人员]";
			mes "你选择了武器类别。";
			mes "请选择子类别。";
			next;
			switch(select("短剑/剑/长矛:法杖/钝器/斧/手里剑:弓/拳刃/乐器/鞭子:书/拳套:左轮/步枪/格林机枪/榴弹发射器")) {
			case 1:
	mes "[后勤人员]";
				mes "你选择了短剑/剑/长矛类别。";
				mes "请选择子类别。";
				next;
				switch(select("短剑：单手剑：双手剑：单手矛：双手矛")) {
				case 1: callsub PurchaseItem,13042,0,1; //Krieger_Dagger1 
				case 2:
	mes "[后勤人员]";
					mes "你选择了“单手剑”类别。";
					mes "有 3 把单手剑：荣耀火焰剑、荣耀细剑和荣耀圣复仇者。";
					mes "如需详情，请参阅 KVM 目录。";
					mes "请选择其中一项。";
					next;
					switch(select("荣耀火焰剑：荣耀细剑：荣耀圣复仇者")) {
					case 1: callsub PurchaseItem,13416,0,0; //Krieger_Onehand_Sword1
					case 2: callsub PurchaseItem,13417,0,0; //Krieger_Onehand_Sword2
					case 3: callsub PurchaseItem,13418,0,0; //Krieger_Onehand_Sword3
					}
				case 3: callsub PurchaseItem,1187,0,1; //Krieger_Twohand_Sword1
				case 4: callsub PurchaseItem,1426,0,1; //Krieger_Onehand_Spear1
				case 5: callsub PurchaseItem,1486,0,1; //Krieger_Twohand_Spear1
				}
			case 2:
	mes "[后勤人员]";
				mes "你选择了杖/钝器/斧/手里剑类别。";
				mes "请选择子类别。";
				next;
				switch(select("杖：钝器：单手斧：双手斧：手里剑")) {
				case 1:
	mes "[后勤人员]";
					mes "你选择了“杖”类别。";
					mes "有 3 根法杖：双手武器荣耀毁灭法杖、单手荣耀奥术杖和荣耀治疗法杖。";
					mes "如需详情，请参阅 KVM 目录。";
					mes "请选择其中一项。";
					next;
					switch(select("荣耀毁灭法杖：荣耀奥术杖：荣耀治疗法杖")) {
					case 1: callsub PurchaseItem,2002,0,0; //Krieger_Twohand_Staff1
					case 2: callsub PurchaseItem,1640,0,0; //Krieger_Onehand_Staff1
					case 3: callsub PurchaseItem,1641,0,0; //Krieger_Onehand_Staff2
					}
				case 2: callsub PurchaseItem,1546,0,1; //Krieger_Onehand_Mace1
				case 3: callsub PurchaseItem,1310,0,1; //Krieger_Onehand_Axe1
				case 4: callsub PurchaseItem,1382,0,1; //Krieger_Twohand_Axe1
				case 5: callsub PurchaseItem,13307,0,1; //Krieger_Huuma_Shuriken1
				}
			case 3:
	mes "[后勤人员]";
				mes "你选择了弓/拳刃/乐器/鞭子类别。";
				mes "请选择子类别。";
				next;
				switch(select("弓：拳刃：乐器：鞭子")) {
				case 1: callsub PurchaseItem,1743,0,1; //Krieger_Bow1
				case 2:
	mes "[后勤人员]";
					mes "你选择了“拳刃”类别。";
					mes "有 2 把拳刃：荣耀血咆哮和荣耀爪刃。";
					mes "如需详情，请参阅 KVM 目录。";
					mes "请选择其中一项。";
					next;
					switch(select("荣耀血咆哮：荣耀爪刃")) {
					case 1: callsub PurchaseItem,1281,0,0; //Krieger_Katar1
					case 2: callsub PurchaseItem,1282,0,0; //Krieger_Katar2
					}
				case 3: callsub PurchaseItem,1927,0,1; //Krieger_Instrument1
				case 4: callsub PurchaseItem,1981,0,1; //Krieger_Whip1
				}
			case 4:
	mes "[后勤人员]";
				mes "你选择了书/拳套类别。";
				mes "请选择子类别。";
				next;
				switch(select("书：拳套")) {
				case 1:
	mes "[后勤人员]";
					mes "你选择了“书”。";
					mes "有 2 本书：荣耀石碑和荣耀天启。";
					mes "如需详情，请参阅 KVM 目录。";
					mes "请选择其中一项。";
					next;
					switch(select("荣耀石碑：荣耀天启")) {
					case 1: callsub PurchaseItem,1576,0,0; //Krieger_Book1
					case 2: callsub PurchaseItem,1577,0,0; //Krieger_Book2
					}
				case 2:
	mes "[后勤人员]";
					mes "你选择了“拳套”类别。";
					mes "有 2 个拳套：荣耀之爪和荣耀之拳。";
					mes "如需详情，请参阅 KVM 目录。";
					mes "请选择其中一项。";
					next;
					switch(select("荣耀之爪：荣耀之拳")) {
					case 1: callsub PurchaseItem,1826,0,0; //Krieger_Knuckle1
					case 2: callsub PurchaseItem,1827,0,0; //Krieger_Knuckle2
					}
				}
			case 5:
	mes "[后勤人员]";
				mes "你选择了左轮/步枪/枪/榴弹发射器类别。";
				mes "请选择子类别。";
				next;
				switch(select("左轮：步枪：格林机枪：霰弹枪：榴弹发射器")) {
				case 1: callsub PurchaseItem,13110,0,1; //Krieger_Pistol1
				case 2: callsub PurchaseItem,13176,0,1; //Krieger_Rifle1
				case 3: callsub PurchaseItem,13177,0,1; //Krieger_Gatling1
				case 4: callsub PurchaseItem,13178,0,1; //Krieger_Shotgun1
				case 5: callsub PurchaseItem,13179,0,1; //Krieger_Launcher1
				}
			}
		case 2:
	mes "[后勤人员]";
			mes "你选择了防具/饰品类别。";
			mes "请选择子类别。";
			next;
			switch(select("防具：披风：鞋子：饰品")) {
			case 1: callsub PurchaseItem,2394,1,2; //Krieger_Suit1
			case 2: callsub PurchaseItem,2549,2,2; //Krieger_Muffler1
			case 3: callsub PurchaseItem,2444,3,2; //Krieger_Shoes1
			case 4: callsub PurchaseItem,2772,4,2; //Krieger_Ring1
			}
		case 3:
	mes "[后勤人员]";
			mes "你选择了量产防具/饰品类别。";
			mes "请选择子类别。";
			next;
			switch(select("量产防具：量产鞋子：量产饰品")) {
			case 1: callsub PurchaseItem,2395,5,3; //Krieger_Suit2
			case 2: callsub PurchaseItem,2445,6,3; //Krieger_Shoes2
			case 3: callsub PurchaseItem,2773,7,3; //Krieger_Ring2
			}
		case 4:
	mes "[后勤人员]";
			mes "你选择了普及型防具/饰品类别。";
			mes "请选择子类别。";
			next;
			switch(select("普及型防具：普及型鞋子：普及型饰品")) {
			case 1: callsub PurchaseItem,2396,8,4; //Krieger_Suit3
			case 2: callsub PurchaseItem,2446,9,4; //Krieger_Shoes3
			case 3: callsub PurchaseItem,2774,10,4; //Krieger_Ring3
			}
		}
	case 3:
	mes "[后勤人员]";
		mes ""+ .@name$ +"，你当前拥有 ^580080"+ kvm_point +"^000000 点 KVM 点数。";
		close;
	case 4:
	mes "[后勤人员]";
		mes "KVM 奖励有 3 个类别：武器/防具/饰品。";
		next;
	mes "[后勤人员]";
		mes "每件武器奖励需要 2,000 KVM 点数。";
		mes "有 3 种防具奖励，分别需要 840/630/580 点。";
		mes "每件饰品奖励需要 1,200 点。";
		next;
	mes "[后勤人员]";
		mes "克里格武器是 4 级武器，可以升级并拥有特殊效果：屠杀、毁灭和祝福。";
		next;
	mes "[后勤人员]";
		mes "穿戴全部 3 件防具后，可以获得特殊套装选项。";
		mes "克里格饰品奖励与奖章一起装备时，也会获得特殊套装奖励。";
		next;
	mes "[后勤人员]";
		mes "最后还有量产型防具和饰品奖励。";
		mes "等级高于 60 的玩家可以装备量产型防具，普及型防具也有等级限制。";
		close;
	case 5:
	mes "[后勤人员]";
		mes "在克里格·米德加德（KVM）中获胜、失败或平局都能获得 KVM 点数。";
		mes "可以使用这些点数获得特殊奖励。";
		close;
	}

PurchaseItem:
	// Pricing for Weapon, Suit1, Muffler1, Shoes1, Ring1m Suit2, Shoes2, Ring2, Suit3, Shoes3, Ring3
	setarray .@prices[0],2000,840,630,580,1200,120,70,200,15,10,30;

	.@item_id = getarg(0);
	.@req_setting = getarg(1);
	.@item_type = getarg(2);

	mes "[后勤人员]";

	if (!.@item_type)
		mes "你选择了 ^ff0000"+ getitemname(.@item_id) +"^000000.";
	else if (.@item_type == 1)
		mes "只有一件"+ callfunc("F_GetWeaponType",.@item_id) +"："+ getitemname(.@item_id) +"。";
	else if (.@item_type == 2) {
		mes "你选择了“"+ callfunc("F_GetArmorType",.@item_id) +"”。";
		mes "等级超过 80 的玩家可装备：^ff0000"+ getitemname(.@item_id) +"^000000。";
	}
	else if (.@item_type == 3) {
		mes "你选择了“量产"+ callfunc("F_GetArmorType",.@item_id) +"”。";
		mes "只有一件量产"+ callfunc("F_GetArmorType",.@item_id) +"：^ff0000"+ getitemname(.@item_id) +"^000000。";
	}
	else if (.@item_type == 4) {
		mes "你选择了“普及型"+ callfunc("F_GetArmorType",.@item_id) +"”。";
		mes "只有一件普及型"+ callfunc("F_GetArmorType",.@item_id) +"：^ff0000"+ getitemname(.@item_id) +"^000000。";
	}

	if (!.@req_setting)
		mes "需要 ^0000ff2,000^000000 KVM 点数，"+ .@name$ +"，你的点数为：^580080"+ kvm_point +"^000000。";
	else if (.@req_setting == 4)
		mes "需要 ^0000ff1,200^000000 KVM 点数，"+ .@name$ +"，你的点数为：^580080"+ kvm_point +"^000000。";
	else
		mes "需要 ^0000ff"+ .@prices[.@req_setting] +"^000000 KVM 点数，"+ .@name$ +"，你的点数为：^580080"+ kvm_point +"^000000。";

	mes "你确定要这个物品吗？";
	next;
	switch(select("不，我不买。：是的，我要购买。")) {
	case 1:
	mes "[后勤人员]";
		mes "你选择了“不购买”。";
		mes "购买物品时请注意，购买后不予退款。";
		break;
	case 2:
		if (kvm_point >= .@prices[.@req_setting]) {
			kvm_point = kvm_point -.@prices[.@req_setting];
			getitem .@item_id,1;
	mes "[后勤人员]";
			mes "你购买了"+ getitemname(.@item_id) +"。";
			if (!.@req_setting)
				mes "你的 KVM 点数减少了 ^0000ff"+ .@req_setting +"^000000 点，现在为 ^580080"+kvm_point+"^000000。";
			if (.@req_setting == 4)
				mes "你的 KVM 点数减少了 ^0000ff1,200^000000 点，现在为 ^580080"+kvm_point+"^000000。";
			else
				mes "你的 KVM 点数减少了 ^0000ff"+ .@prices[.@req_setting] +"^000000 点，现在为 ^580080"+kvm_point+"^000000。";
		}
		else {
	mes "[后勤人员]";
			if (!.@req_setting)
				mes "购买此物品需要 ^0000ff2,000^000000 KVM 点数。";
			else if (.@req_setting == 4)
				mes "购买此物品需要 ^0000ff1,200^000000 KVM 点数。";
			else
				mes "购买此物品需要 ^0000ff"+ .@prices[.@req_setting] +"^000000 KVM 点数。";
			mes "但你当前的 KVM 点数为：^580080"+ kvm_point +"^000000。";
			mes "点数不足，无法购买。";
			mes "点数足够后请再来。";
		}
	}
	close;
}

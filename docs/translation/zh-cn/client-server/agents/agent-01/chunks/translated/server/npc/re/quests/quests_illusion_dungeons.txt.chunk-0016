com_d02_i,121,95,4	script(CLOAKED)	Karu#LuE02	4_M_THAIONGBAK,{
	if (ill_luanda == 6) {
		npctalk "卡鲁……今天狩猎怎么样？", "Asudem#LuE02", bc_self;
		mes "[Asudem]";
		mes "卡鲁……今天狩猎怎么样？";

		next;
		mes "[Luanda]";
		mes "这不算什么秘密，但我的每个兄弟都有神秘的能力。";
		next;
		mes "[Luanda]";
		mes "以卡鲁哥哥为例，他即使从远处也能准确看清事物……";
		next;
		mes "[Luanda]";
		mes "老幺玛鲁拥有过目不忘的记忆力，还能读懂对手的想法……";
		next;
		mes "[Luanda]";
		mes "我不一定总是正确，但我能看见未来。啊！我的能力不止这些。";
		next;
		mes "[Luanda]";
		mes "我能看见人们的善恶能量。至于冒险者……";
		next;
		mes "[Luanda]";
		mes "我能感受到无法触碰的善良能量。所以我更加痛苦。";
		next;
		mes "[Luanda]";
		mes "回到原来的话题，我之所以绘制壁画，是因为有一天我梦见村庄被烧毁。";
		next;
		mes "[Luanda]";
		mes "许多怪物来到镇上，人们因此痛苦地哭喊……";
		next;
		mes "[Luanda]";
		mes "做完那场地狱般的梦后，我看见自己把当天发生的事记录在洞窟壁画上。";
		next;
		mes "[Luanda]";
		mes "哈哈，别太担心。梦里的事还没有发生。";
		next;
		mes "[Luanda]";
		mes "你知道吗？如果我提前画好壁画，梦中看见的未来会改变吗？";
		next;
		mes "[Luanda]";
		mes "一个我从未在梦中见过的冒险者正在帮助我们，所以我相信我们能改变未来。";
		next;
		ill_luanda = 10;
		getexp 1120000,650000;
		erasequest 5847;
		mes "向露伊娜报告并获得了经验。";
		close;
	}
	if (ill_luanda == 11) {// THURSDAY vortex 228/91
		mes "[Luanda]";
		mes "怎么了，冒险者？";
		next;
		mes "向露伊娜讲述了独自训练的毛的情况。";
		next;
		mes "[Luanda]";
		mes "毛那家伙……你一定想了很多事情。";
		next;
		mes "[Luanda]";
		mes "卡鲁哥哥和嫂子分开居住，我们仍然住在一起，但我觉得他并不太在意妹妹。";
		next;
		mes "[Luanda]";
		mes "据说我做了痛苦的梦后失去了理智，但不知为何我的不安……";
		next;
		mes "[Luanda]";
		mes "看来他被毛的情绪影响了。也许因为他的能力，他经常被别人的情感左右……";
		next;
		mes "[Luanda]";
		mes "他……正在训练变强……即使不能变强……也已经足够了……";
		next;
		emotion ET_THANKS;
		mes "[Luanda]";
		mes "谢谢你。多亏你，我了解了毛的烦恼。";
		next;
		ill_luanda = 12;
		getexp 1120000,650000;
		erasequest 5847;
		mes "向露伊娜报告并获得了经验。";
		close;
	}
	if (ill_luanda == 13) {// FRIDAY vortex 208/130
		mes "[Luanda]";
		mes "怎么了，冒险者？";
		next;
		mes "向露伊娜讲述了有人从洞窟取走东西的事。";
		next;
		mes "[Luanda]";
		mes "你也看到了。我想我们以前谈过。在我的梦里，我看见怪物进入村子。";
		next;
		mes "[Luanda]";
		mes "为了应对那一刻，村里的战士把老人和弱者疏散到这里，并把物资储存在洞窟各处。";
		next;
		mes "[Luanda]";
		mes "这些确实是应急物资。最好永远用不上，但……";
		next;
		mes "[Luanda]";
		mes "你还不了解世界如何运作。发现什么的话，直接无视就好。";
		next;
		ill_luanda = 14;
		getexp 1120000,650000;
		erasequest 5847;
		mes "向露伊娜报告并获得了经验。";
		close;
	}
	if (ill_luanda == 15) {// (re)MONDAY vortex 153/33
		mes "[Luanda]";
		mes "怎么了，冒险者？";
		next;
		mes "向露伊娜讲述了与村民和村长见面的故事。";
		next;
		mes "[Luanda]";
		mes "你真的来查看之前发生的事了。虽然没有梦中看到的破坏那么严重，但损失仍然很大。";
		next;
		mes "[Luanda]";
		mes "一想到那天，我的心就很痛。就在哥哥们离开时，突然……";
		next;
		mes "[Luanda]";
		mes "不过，作为村里最优秀长者的村长很冷静，所以似乎受到的损失较少。谢谢你告诉我这些。";
		next;
		ill_luanda = 16;
		getexp 1120000,650000;
		erasequest 5847;
		mes "向露伊娜报告并获得了经验。";
		close;
	}
	if (ill_luanda == 17) {// SATURDAY vortex 42/215
		mes "[Luanda]";
		mes "怎么了，冒险者？";
		next;
		mes "向露伊娜讲述了与匆忙跑向某处的兄弟们相遇的故事。";
		next;
		mes "[Luanda]";
		mes "你一定见过我和兄弟们狩猎归来的那天。村子发生了大灾难，那已经是第二天了。";
		next;
		mes "[Luanda]";
		mes "唔……如果我和兄弟们没有清空村子……人们就不会被怪物带走……";
		next;
		mes "[Luanda]";
		mes "如果那样的话……我的嫂子也……";
		next;
		select( "这不是你的错。" );
		mes "[Luanda]";
		mes "我知道。不是因为我和兄弟们……但是……那天……我们……只是很遗憾。";
		next;
		select( "你最好先冷静下来。" );
		mes "[Luanda]";
		mes "冒险者，你让我看到了原本不会看到的东西。我只能告诉你我记得的事……";
		next;
		ill_luanda = 18;
		getexp 1120000,650000;
		erasequest 5847;
		mes "向露伊娜报告并获得了经验。";
		close;
	}
	if (ill_luanda == 19) {// (re)THURSDAY vortex 228/91
		mes "[Luanda]";
		mes "怎么了，冒险者？";
		next;
		mes "向露伊娜讲述了看到卡鲁和阿苏德姆的故事。";
		next;
		mes "[Luanda]";
		mes "... ... ...";
		next;
		mes "[Luanda]";
		mes "卡……卡鲁哥哥……哥哥。";
		mes "所以你才把自己关在西边的洞窟里。";
		next;
		mes "[Luanda]";
		mes "我无法帮助防守村子，对自己感到很自责。";
		next;
		mes "[Luanda]";
		mes "你的心情……我甚至无法想象嫂子的心情……唉……你的悲伤……";
		next;
		mes "[Luanda]";
		mes "这里的情况解决后，我会去寻找哥哥。他一定独自承受着痛苦和悲伤。";
		next;
		mes "[Luanda]";
		mes "我的心也一样痛，但如果你知道老幺正因能力而苦恼……我必须做好准备。谢谢你，冒险者。";
		next;
		ill_luanda = 20;
		getexp 1120000,650000;
		erasequest 5847;
		mes "向露伊娜报告并获得了经验。";
		close;
	}
	if (ill_luanda == 21) {	// SUNDAY vortex 263/72
		mes "[Luanda]";
		mes "怎么了，冒险者？";
		next;
		mes "向露伊娜讲述了关于陌生人的故事。";
		next;
		mes "[Luanda]";
		mes "听起来像是以村子为目标的乌坦或巨石怪物之间的对话。";
		next;
		mes "[Luanda]";
		mes "跟随强大的首领？最近我觉得这些家伙的行动有序得令人不安……";
		next;
		mes "[Luanda]";
		mes "看来出现了一个领导它们的怪物。";
		next;
		mes "[Luanda]";
		mes "真丢脸。即使现在，我们也只能阻挡它们。";
		next;
		mes "[Luanda]";
		mes "现在不是悲伤的时候。我们需要加强防御并采取其他措施。";
		next;
		mes "[Luanda]";
		mes "强大的首领本身也是问题……但传说中流传下来的力量？我以前从没听过这种故事。";
		next;
		mes "[Luanda]";
		mes "我猜这就是怪物攻击村子的原因，但我必须告诉村长并展开调查。";
		next;
		emotion ET_THANKS;
		mes "[Luanda]";
		mes "你刚才讲的故事很有帮助。谢谢你，冒险者。";
		next;
		ill_luanda = 22;
		getexp 1120000,650000;
		erasequest 5847;
		mes "向露伊娜报告并获得了经验。";
		close;
	}
	if (isbegin_quest(5848) == 1 && countitem(25638) > 2) {
		delitem 25638,3;	// Token_Of_Bigstone
		erasequest 5848;
		setquest 5849;
		.@amount = 1;
	}
	if (isbegin_quest(5850) == 1 && countitem(25633) > 2) {
		delitem 25633,3;	// Token_Of_Wootan
		erasequest 5850;
		setquest 5851;
		.@amount += 1;
	}
	if (checkquest(5852,HUNTING) == 2) {
		erasequest 5852;
		setquest 5853;
		.@amount += 1;
	}
	if (checkquest(5854,HUNTING) == 2) {
		erasequest 5854;
		setquest 5855;
		.@amount += 1;
	}
	if (.@amount > 0) {
		getitem 25271, .@amount;	// IllusionStone
		getexp (4300000 * .@amount), (2800000 * .@amount);
		emotion ET_THANKS;
		mes "[Luanda]";
		if (.@amount > 1)
			mes "即使只完成一个请求也很不容易，但你完成了 " + .@amount + " 个……真的很厉害。";
		else
			mes "每一个请求都很重要。一次又一次地感谢你。";
		mes "你辛苦了。";
		close;
	}
	mes "[Luanda]";
	mes "怎么了，冒险者？";
	next;
	switch( select( "这里没有请求吗？", "这个洞窟是什么？", "为什么怪物会入侵？" ) ) {
	case 1:
		mes "[Luanda]";
		mes "镇上招募的任务有单独的请求板。";
		next;
		mes "[Luanda]";
		mes "啊！注意你的精神。这里位于战场中央，所以出于安全考虑，我把请求板设在角落。";
		next;
		mes "[Luanda]";
		mes "有时你无法立刻完成请求板上的任务，但没有具体时限，所以不用着急。";
		close;
	case 2:
		mes "[Luanda]";
		mes "冒险者，你对什么都很好奇。";
		next;
		mes "[Luanda]";
		mes "从战略上说，露伊娜洞窟是镇子北边唯一的出口。";
		next;
		mes "[Luanda]";
		mes "所以我们在这里防御怪物的攻击。";
		next;
		select( "露伊娜洞窟？露伊娜？" );
		mes "[Luanda]";
		mes "啊！你注意到了吗？是的，我也叫露伊娜。村里的长者说……";
		next;
		mes "[Luanda]";
		mes "据说三胞胎是以村里的洞窟命名的，分别叫卡鲁、露伊娜和毛。";
		next;
		mes "[Luanda]";
		mes "我小时候邻居朋友会稍微取笑我，但我不抱怨这个名字。";
		next;
		mes "[Luanda]";
		mes "我听说它们是以村子的守护者命名的。我为此感到自豪。";
		close;
	case 3:
		mes "[Luanda]";
		mes "这对我们来说也非常令人困惑。如果知道原因，我们早就把东西收起来了。";
		next;
		mes "[Luanda]";
		mes "这里不是食物充足的城镇，我不认为怪物有什么特别的理由要盯上这里。";
		next;
		mes "[Luanda]";
		mes "但我们能怎么办？我们只是住在这里，而怪物不断来袭，所以只能一边抵挡它们一边生活。";
		close;
	}
	end;

OnInit:
	questinfo( QTYPE_QUEST2, QMARK_YELLOW, "isbegin_quest(5847) == 1" );
	end;
}


// Shadow npcs and main quest related
com_d02_i,1,1,1	script	com_d02_i_init_shadow_npc	-1,{
	end;
OnInit:
OnHour00:	// updated every 3h at a fixed time
OnHour03:
OnHour06:
OnHour09:
OnHour12:
OnHour15:
OnHour18:
OnHour21:
	setarray .@num[1],1,2,3,4,5,6,7;
	.@today = gettime(DT_DAYOFWEEK);
	.@today = (.@today == 0 ? 7 : .@today);	// SUNDAY - 0
	deletearray .@num[.@today],1;
	deletearray .@num[ rand(1,6) ],1;	// note: should the previous enabled vortex be taken into account?

	for ( .@i = 1; .@i < 6; ++.@i )
		disablenpc "Shimmer#Lu0" + .@num[.@i];
	end;
}

// MONDAY
com_d02_i,153,33,1	script	Shimmer#Lu01	1_SHADOW_NPC,7,7,{
	specialeffect EF_M07;
	end;
OnTouch:
	if (ill_luanda == 1) {	// first time (any 1_SHADOW_NPC trigger it)
		mes "这是一道奇异的闪光，你很可能会被吸进去。";
		next;
		ill_luanda = 2;
		setquest 5847;
		mes "这似乎是无法忽视的现象。我必须和防卫负责人露伊娜谈谈。";
		close;
	}
	if (ill_luanda == 3) {
		cloakoffnpcself( "First Young#LuE01" );
		cloakoffnpcself( "Second Young#LuE01" );
		cloakoffnpcself( "Third Young#LuE01" );
		end;
	}
	if (ill_luanda == 4) {
		cloakoffnpcself( "Second Young#LuE01" );
		end;
	}
	if (ill_luanda == 14) {
		cloakoffnpcself( "Chief#LuE06" );
		cloakoffnpcself( "Villager#LuE061" );
		cloakoffnpcself( "Villager#LuE062" );
		cloakoffnpcself( "Villager#LuE063" );
		end;
	}
	end;
}

com_d02_i,152,40,6	script(CLOAKED)	Second Young#LuE01	4_M_THAIONGBAK,{
	if (ill_luanda == 3) {
		npctalk "哥哥？准备好了吗？你要马上离开吗？时间不多了。", "", bc_self;
		mes "[Second Young]";
		mes "哥哥？准备好了吗？你要马上离开吗？时间不多了。";
		next;
		npctalk "是的，正如二哥所说，我们最好快点出发。我感觉不太好。", "First Young#LuE01", bc_self;
		mes "[First Young]";
		mes "是的，正如二哥所说，我们最好快点出发。我感觉不太好……";
		next;
		npctalk "哈哈哈，只有一天而已。有什么大不了的？嗯？！", "Third Young#LuE01", bc_self;
		mes "[Third Young]";
		mes "哈哈哈，只有一天而已。有什么大不了的？嗯？！";
		next;
		npctalk "哥哥们，那边有人。是陌生人？", "Third Young#LuE01", bc_self;
		mes "[Third Young]";
		mes "哥哥们，那边有人。是陌生人？";
		next;
		npctalk "看起来是陌生人？如果我没记错，我在附近没见过那张脸。", "Third Young#LuE01", bc_self;
		mes "[Third Young]";
		mes "看起来是陌生人？如果我没记错，我在附近没见过那张脸。";
		next;
		npctalk "如果老幺的记忆没错，就是这样。这个年纪还在这里当陌生人很奇怪。", "First Young#LuE01", bc_self;
		mes "[First Young]";
		mes "如果老幺的记忆没错，就是这样。这个年纪还在这里当陌生人很奇怪。";
		next;
		npctalk "哥哥，我觉得你没有危险。现在不是时候。哥哥，我们先走吧。", "", bc_self;
		mes "[Second Young]";
		mes "哥哥，我觉得你没有危险。现在不是时候。哥哥，我们先走吧。";
		next;
		npctalk "我很快就追上来。", "", bc_self;
		mes "[Second Young]";
		mes "我很快就追上来。";
		next;
		npctalk "看二哥的表情，那个陌生人似乎有话要说？老幺，我们先走。", "First Young#LuE01", bc_self;
		mes "[First Young]";
		mes "看二哥的表情，那个陌生人似乎有话要说？老幺，我们先走。";
		next;
		npctalk "保重。别迟到……", "First Young#LuE01", bc_self;
		mes "[First Young]";
		mes "保重。别迟到……";
		next;
		cloakonnpcself( "First Young#LuE01" );
		sleep2 500;
		cloakonnpcself( "Third Young#LuE01" );
		npctalk "好的，哥哥。", "", bc_self;
		mes "[Second Young]";
		mes "好的，哥哥。";
		next;
		npctalk "嘿，陌生人，看我一会儿。", "", bc_self;
		mes "[Second Young]";
		mes "嘿，陌生人，看我一会儿。";
		ill_luanda = 4;
		close;
	}
	if (ill_luanda == 4) {
		npctalk "你？难道感觉不到善意吗？你到底在做什么？", "", bc_self;
		mes "[Second Young]";
		mes "你？难道感觉不到善意吗？你到底在做什么？";
		next;
		select( "你在说什么？" );
		npctalk "我能看见。嗯……但你看不见。", "", bc_self;
		mes "[Second Young]";
		mes "我能看见。嗯……但你看不见。";
		next;
		npctalk "我告诉你，是因为我从你身上感受到善意。马上离开这里。", "", bc_self;
		mes "[Second Young]";
		mes "我告诉你，是因为我从你身上感受到善意。马上离开这里。";
		next;
		npctalk "很多怪物很快会来到这个镇子。别白白送命，离开这里。", "", bc_self;
		mes "[Second Young]";
		mes "很多怪物很快会来到这个镇子。别白白送命，离开这里。";
		next;
		cloakonnpcself();
		ill_luanda = 5;
		setquest 5847;
		mes "年轻人说完后消失了。他一定是追上了先走的兄弟们。他到底在做什么？";
		next;
		mes "我应该向露伊娜先生询问发生了什么吗？";
		close;
	}
	end;
}


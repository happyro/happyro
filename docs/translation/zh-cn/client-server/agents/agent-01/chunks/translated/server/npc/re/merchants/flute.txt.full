// Falcon Flute :: falcon_flute
//============================================================
-	script	Falcon Flute Trader::fflute	-1,{
	mes "[猎鹰笛商人]";
	if (BaseJob == Job_Hunter) {
		mes "需要猎鹰吗？";
		mes "有了魔法笛子，你可以在任何地方召唤猎鹰！";
		next;
		mes "[猎鹰笛商人]";
		mes "很神奇，对吧？哈哈哈！";
		next;
		mes "[猎鹰笛商人]";
		mes "我为什么卖这些猎鹰笛？";
		mes "因为我完全不知道它们怎么用。";
		mes "哈哈哈！";
		next;
		mes "[猎鹰笛商人]";
		mes "当然，你需要技能 ^ff0000猎鹰精通^000000。";
		mes "我没有这项技能，所以不知道如何操控猎鹰。";
		mes "照这样下去，我可能永远都没有猎鹰。";
		next;
		mes "[猎鹰笛商人]";
		mes "但我不能免费给你！";
		mes "我也要吃饭，得赚钱啊！";
		next;
		mes "[猎鹰笛商人]";
		mes "如果你需要猎鹰笛，我可以卖 12,500 Zeny。会不会太贵？";
		next;
		if (eaclass()&EAJL_THIRD) {
			mes "[猎鹰笛商人]";
			mes "不过对游侠，我有特别价 10,000 Zeny！";
			set .@price,10000;
			next;
		} else
			set .@price,12500;
		if(select("不买:购买猎鹰笛") == 1) {
			mes "[猎鹰笛商人]";
			mes "真遗憾。需要的话再回来！";
			close;
		}
		if (Zeny >= .@price) {
			if (countitem(12848) >= 1) {
				mes "[猎鹰笛商人]";
				mes "看来你已经有猎鹰笛了！";
				mes "别担心，小朋友，买过猎鹰笛后不必再次购买，";
				mes "因为猎鹰笛使用后不会消失，很棒吧？";
				close;
			}
			mes "[猎鹰笛商人]";
			mes "来，拿着这支笛子。";
			mes "有了它，你可以在任何地方吹哨召唤猎鹰。";
		  	set Zeny, Zeny - .@price;
			getitem 12848,1; //Falcon_Flute
			next;
			mes "[猎鹰笛商人]";
			mes "提醒一下。";
			mes "使用它需要技能 ^ff0000猎鹰精通^000000！";
			close;
		}
		mes "[猎鹰笛商人]";
		mes "抱歉，你的钱不够买猎鹰笛，钱够了再回来！";
		close;
	}
	if (BaseJob == Job_Archer) {
		mes "你好，年轻人！";
		mes "现在我帮不了你，";
		mes "等你成为优秀的猎人、学会正确操控猎鹰后再回来吧？";
		close;
	}
	mes "今天真是美好的一天，不是吗？";
	close;
}
hu_in01,386,306,3	duplicate(fflute)	Falcon Flute Trader#fft	51
pay_arche,91,134,3	duplicate(fflute)	Falcon Flute Trader#fft2	51

// Wolf Flute :: job_ranger
//============================================================
tur_dun01,89,170,5	script	Expert Flute Crafter	59,{
	if (Class == Job_Ranger || Class == Job_Ranger_T || Class == Job_Baby_Ranger) {
		if (countitem(6124)) {
			mes "[专业笛子工匠]";
			mes "你手里的狼笛是我用木头制作的。";
			mes "狼笛丢了就回来找我吧！";
			next;
			mes "[专业笛子工匠]";
			mes "这支笛子只有我能制作。";
			mes "再做一支对我来说只是小事！！";
			close;
		}
		mes "[专业笛子工匠]";
		mes "需要什么吗？";
		mes "一支新的狼笛？";
		next;
		switch(select("请给我一支新的狼笛。:不用了。")) {
		case 1:
			if (countitem(7150) && Zeny >= 100000) {
				mes "[专业笛子工匠]";
				mes "你带齐材料了吗？";
				mes "哇！你的材料都不错！";
				mes "这就够了。";
				next;
				mes "[专业笛子工匠]";
				mes "这是新的狼笛。";
				mes "希望你已经准备好使用它。";
				delitem 7150,1; //Bamboo_Cut
				set Zeny, Zeny-100000;
				getitem 6124,1; //Wolf's_Flute
				close;
			}
			mes "[专业笛子工匠]";
			mes "想制作新的狼笛，就带来 ^4d4dff1 根竹子和 100,000 Zeny。^000000";
			next;
			mes "[专业笛子工匠]";
			mes "^4d4dff竹子可从卡帕或唐卡拉卡获得。^000000";
			close;
		case 2:
			mes "[专业笛子工匠]";
			mes "如果你不召唤狼，就不需要狼笛。";
			mes "改变主意后可以回来找我。";
			mes "对吧？";
			close;
		}
	}
	mes "[专业笛子工匠]";
	mes "咦？你不是游侠？";
	mes "那这支笛子对你完全没用！";
	close;
}

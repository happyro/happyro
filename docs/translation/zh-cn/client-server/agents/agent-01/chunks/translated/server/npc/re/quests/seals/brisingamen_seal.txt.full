//===== rAthena Script ======================================= 
//= God Item Quest - Brisingamen Seal
//===== Description: ========================================= 
//= [Official Conversion]
//= Quest for breaking the seal of Brisingamen.
//===== Changelogs: ==========================================
//= 1.0 Renewal script update for ep16.1 [Capuche]
//============================================================

prt_cas,372,74,0	script	Personnel Record#hidden	HIDDEN_NPC,{
	if ($God2 < $@god_check1) {
		mes "[图书管理员]";
		mes "你在做什么？";
		mes "别碰任何东西！";
		close;
	}
	if ($God3 >= $@god_check2) {
		mes "[图书管理员]";
		mes "你在做什么？";
		mes "别碰任何东西！";
		close;
	}
	if (god_brising == 26) {
		mes "[" + strcharinfo(0) + "]";
		mes "我应该从";
		mes "上次停下的地方";
		mes "继续读……";
		next;
		mes "["+ strcharinfo(0) +"]";
		mes "嗯……？";
		mes "底部这里的";
		mes "标记是什么？";
		mes "某种秘密？";
		next;
		mes "["+ strcharinfo(0) +"]";
		mes "难怪图书管理员";
		mes "说话前似乎有所犹豫。嗯。";
		mes "现在看看……";
		next;
		set .@bookrand,rand(1,3);
		if (.@bookrand == 1) {
		mes "[人事记录]";
			mes "^663300第二小队的洛温在事件发生 3 天后回到了自己的分队。随后举行了审判，她被判定犯有奉命作战时逃跑的罪行。^000000";
			next;
			mes "[人事记录]";
			mes "^663300尽管罪行严重，她只是被逐出十字军，并被强行剥夺了获得的神圣力量……^000000";
			next;
			mes "[" + strcharinfo(0) + "]";
			mes "她被迫离开十字军了？！太荒谬了！";
			next;
			mes "["+ strcharinfo(0) +"]";
			mes "他们是想判她死刑吗？这也太残酷了。她一定受到了羞辱……";
			next;
			mes "[人事记录]";
			mes "^663300事件发生两年后，远征队发现了生锈的盔甲碎片和一把断剑";
			mes "以及一些属于";
			mes "洛温·艾伦伦的物品。^000000";
			next;
			mes "[人事记录]";
			mes "^663300然而，这条信息";
			mes "属于高度机密。官方记录称，洛温·艾伦伦在任务中死亡。^000000";
			next;
			mes "[" + strcharinfo(0) + "]";
			mes "他们认为她给十字军带来了";
			mes "耻辱？";
			mes "听起来真是一团糟。";
			mes "我要不要再去见她？";
			next;
			mes "[图书管理员]";
			mes "^666666*哈欠……*^000000";
			mes "搞什么……";
			mes "你是谁！";
			mes "滚出去";
			mes "！";
			set god_brising,30;
			close2;
			warp "prt_cas",349,68;
			end;
			}
		else {
		mes "[图书管理员]";
			mes "^666666*哈欠……*^000000";
			mes "搞什么……";
			mes "你是谁！";
			mes "滚出去";
			mes "！";
			close2;
			warp "prt_cas",349,68;
			end;
			}
		}
	else if (god_brising == 25) {
	mes "^3355FF图书管理员打瞌睡时，你从书架上取下了这本书。根据十字军人事记录，只有一名新兵叫洛温·艾伦伦。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "洛温·艾伦伦……";
		mes "第 2 小队成员……";
		mes "年龄 22 岁……";
		mes "女性……";
		next;
		mes "["+ strcharinfo(0) +"]";
		mes "成了逃犯？";
		mes "这和图书管理员告诉我的";
		mes "信息";
		mes "不一样！";
		next;
		set .@bookrand,rand(1,3);
		if (.@bookrand == 1) {
		mes "[" + strcharinfo(0) + "]";
		mes "我应该从";
			mes "上次停下的地方";
			mes "继续读……";
			next;
			mes "[" + strcharinfo(0) + "]";
			mes "嗯……？";
			mes "底部这里的";
			mes "标记是什么？";
			mes "某种秘密？";
			next;
			mes "[" + strcharinfo(0) + "]";
			mes "难怪图书管理员";
			mes "说话前似乎有所犹豫。嗯。";
			mes "现在看看……";
			next;
			mes "[人事记录]";
			mes "^663300第二小队的洛温在事件发生 3 天后回到了自己的分队。随后举行了审判，她被判定犯有奉命作战时逃跑的罪行。^000000";
			next;
			mes "[人事记录]";
			mes "^663300尽管罪行严重，她只是被逐出十字军，并被强行剥夺了获得的神圣力量……^000000";
			next;
			mes "[" + strcharinfo(0) + "]";
			mes "她被迫离开十字军了？！太荒谬了！";
			next;
			mes "[" + strcharinfo(0) + "]";
			mes "他们是想判她死刑吗？这也太残酷了。她一定受到了羞辱……";
			next;
			mes "[人事记录]";
			mes "^663300事件发生两年后，远征队发现了生锈的盔甲碎片和一把断剑";
			mes "以及一些属于";
			mes "洛温·艾伦伦的物品。^000000";
			next;
			mes "[人事记录]";
			mes "^663300然而，这条信息";
			mes "属于高度机密。官方记录称，洛温·艾伦伦在任务中死亡。^000000";
			next;
			mes "[" + strcharinfo(0) + "]";
			mes "他们认为她给十字军带来了";
			mes "耻辱？";
			mes "听起来真是一团糟。";
			mes "我要不要再去见她？";
			next;
			mes "[图书管理员]";
			mes "^666666*哈欠……*^000000";
			mes "搞什么……";
			mes "你是谁！";
			mes "滚出去";
			mes "！";
			set god_brising,30;
			close2;
			warp "prt_cas",349,68;
			end;
			}
			else {
			mes "[图书管理员]";
			mes "^666666*哈欠……*^000000";
		mes "搞什么……";
			mes "你是谁！";
			mes "滚出去";
			mes "！";
			set god_brising,26;
			next;
			mes "["+ strcharinfo(0) +"]";
			mes "（糟糕……！";
			mes "我没能";
			mes "读完了！）";
			close2;
			warp "prt_cas",349,68;
			end;
			}
			}
			else  {
		mes "[图书管理员]";
	mes "你在这里做什么？";
	mes "别碰任何东西！";
		close;
		}
		}
		//
	//
//


	next;
	set .@i, select(
		"小型阿吉玛特（^FF0000"+(($malaya_pintados_01 > 999)?"已收集":(1000 - $malaya_pintados_01)+" 个缺少")+"^000000）："+
		"银十字架（^FF0000"+(($malaya_pintados_02 > 999)?"已收集":(1000 - $malaya_pintados_02)+" 个缺少")+"^000000）："+
		"染料（^FF0000"+(($malaya_pintados_03 > 299)?"已收集":(300 - $malaya_pintados_03)+" 个缺少")+"^000000）"
	);
	switch(.@i) {
	case 1:
		set .@item,6497; //Lesser_Agimat
		set .@name$,"小型阿吉玛特";
		set .@total,1000;
		break;
	case 2:
		set .@item,6502; //Silver_Cross
		set .@name$,"银十字架";
		set .@total,1000;
		break;
	case 3:
		setarray .@items[0],975,976,978,979,980,981,982,983;
		set .@name$,"染料";
		set .@total,300;
		break;
	}
	mes "[Isco]";
	mes "哇！"+.@str$+"你带来了"+.@name$+"！";
	next;
	mes "[Isco]";
	mes "等等。一……二……";
	if (getd("$malaya_pintados_0"+.@i) >= .@total) {
		mes "呃……哦？我需要的"+.@name$+"已经齐了。"+.@str$+"！不过还是谢谢你的帮助。";
		close;
	}
	if (.@i < 3) {
		mes "我还缺"+(.@total - getd("$malaya_pintados_0"+.@i))+" 个"+.@name$+"。你带来了多少？";
		next;
		switch(select("一个？！:输入数量。")) {
		case 1:
			set .@amount,1;
			mes "[Isco]";
			mes "嘿嘿……你带回了一个。";
			next;
			break;
		case 2:
			mes "[Isco]";
			mes "嘿嘿……我不擅长数字，超过 50 就糊涂。你要给我多少？";
			next;
			input .@amount;
			if (.@amount < 1 || .@amount > 50) {
				mes "[Isco]";
				mes "唉～我糊涂了！数字奇怪时我数不清。";
				close;
			}
			break;
		}
		if (countitem(.@item) < .@amount) {
			mes "[Isco]";
			mes "唉～"+.@str$+"！"+getitemname(.@item)+"在哪里？";
			close;
		}
	} else {
		mes "我还缺"+(.@total - getd("$malaya_pintados_0"+.@i))+" 份染料。你带来了哪种染料？";
		next;
		for(set .@j,0; .@j<getarraysize(.@items); set .@j,.@j+1)
			set .@menu$, .@menu$+getitemname(.@items[.@j])+" (^FF0000"+countitem(.@items[.@j])+"^000000):";
		set .@item, .@items[select(.@menu$)-1];
		if (countitem(.@item) == 0) {
			mes "[Isco]";
			mes "唉～你没有"+getitemname(.@item)+"。";
			close;
		}
		mes "[Isco]";
		mes .@str$+"！你有"+countitem(.@item)+" 个"+getitemname(.@item)+"，能给我多少？";
		next;
		switch(select("输入数量:全部")) {
		case 1:
			mes "[Isco]";
			mes "嘿嘿……我不擅长数字，超过 50 就糊涂。你要给我多少？";
			next;
			input .@amount;
			if (.@amount < 1 || .@amount > 50) {
				mes "[Isco]";
				mes "唉～我说过我不擅长数字。";
				close;
			}
			break;
		case 2:
			set .@amount, countitem(.@item);
			break;
		}
		if (countitem(.@item) < .@amount) {
			mes "[Isco]";
			mes "唉……我还缺"+getitemname(.@item)+"。";
			close;
		}
	}
	delitem .@item,.@amount;
	setd "$malaya_pintados_0"+.@i, getd("$malaya_pintados_0"+.@i)+.@amount;
	set .@amount_left, .@total - getd("$malaya_pintados_0"+.@i);
	mes "[Isco]";
	mes "嘿嘿……谢谢。"+.@str$+"！";
	if (.@amount_left <= 0)
		mes "哇！我们需要的"+.@name$+"全部收集齐了。太好了～！";
	else
		mes "我还需要"+.@amount_left+" 个"+.@name$+"。";
	close;
}

ma_fild01,172,223,6	script	Tattooist#pin	574,{
	if (checkweight(1201,1) == 0 || MaxWeight - Weight < 1000) {
		mes "无法继续，因为你携带的物品太多。";
		close;
	}
	emotion ET_QUESTION;
	mes "[Tattooist]";
	mes "你为什么想要纹身？";
	next;
	switch(select("纹身是什么？:我好奇纹身的效果。:我需要纹身。")) {
	case 1:
		mes "[Tattooist]";
		mes "据说强大魔物的纹身能提升持有者的能力。";
		next;
		select("太棒了。怎样才能得到？");
		mes "[Tattooist]";
		mes "绘制纹身是非常神圣的工作。";
		next;
		mes "[Tattooist]";
		mes "需要 10 个古代怨念，在我绘制纹身时保护我。";
		next;
		mes "[Tattooist]";
		mes "需要 1 个强大魔物外形的玩偶。";
		next;
		mes "[Tattooist]";
		mes "最后还需要 1 个灵魂碎片，把强大魔物的能量注入纹身。";
		next;
		select("你会画哪种纹身？");
		mes "[Tattooist]";
		mes "我能画 3 种纹身。";
		next;
		mes "[Tattooist]";
		mes "梦魇护符纹身：来自马来亚港古老巨树的强大魔物。";
		next;
		mes "[Tattooist]";
		mes "巴库纳瓦护符纹身：能够吞下月亮的巨大魔物。";
		next;
		mes "[Tattooist]";
		mes "布瓦亚护符纹身：会绑架人类的巨大鳄鱼。";
		next;
		select("在哪里能得到灵魂碎片和玩偶？");
		mes "[Tattooist]";
		mes "这些强力物品可以从布瓦亚、梦魇和巴库纳瓦本身取得，但绝非易事。";
		next;
		mes "[Tattooist]";
		mes "这项神圣工作不是每天都有。只有在‘^7A96E0皮纳达斯节^000000’期间才绘制纹身。";
		close;
	case 2:
		mes "[Tattooist]";
		mes "你对哪种纹身的效果感兴趣？";
		next;
		while(1) {
			switch (select("梦魇护符纹身:布瓦亚护符纹身:巴库纳瓦护符纹身:我没有问题。")) {
			case 1:
				mes "[Tattooist]";
				mes "制作需要 10 个古代怨念、1 个梦魇灵魂碎片和 1 个梦魇玩偶。";
				next;
				mes "[Tattooist]";
				mes "梦魇护符纹身蕴含马来亚港古老巨树的能量。";
				next;
				mes "[Tattooist]";
				mes "使治疗他人的效果提高 4%，受到他人治疗的效果提高 7%。";
				next;
				break;
			case 2:
				mes "[Tattooist]";
				mes "制作需要 10 个古代怨念、1 个布瓦亚灵魂碎片和 1 个布瓦亚玩偶。";
				next;
				mes "[Tattooist]";
				mes "布瓦亚护符纹身蕴含巨大鳄鱼的能量。";
				next;
				mes "[Tattooist]";
				mes "MATK 提高 7%，固定咏唱时间减少 7%。";
				next;
				break;
			case 3:
				mes "[Tattooist]";
				mes "制作需要 10 个古代怨念、1 个巴库纳瓦灵魂碎片和 1 个巴库纳瓦玩偶。";
				next;
				mes "[Tattooist]";
				mes "巴库纳瓦护符纹身蕴含能够吞下月亮的巨大魔物的能量。";
				next;
				mes "[Tattooist]";
				mes "ATK 提高 7%，ASPD 提高 10%。";
				next;
				break;
			case 4:
				mes "[Tattooist]";
				mes "看来你已经了解全部内容了。祝你旅途愉快。";
				close;
			}
			mes "[Tattooist]";
			mes "你还想了解其他纹身的效果吗？";
			next;
		}
	case 3:
		break;
	}
	if ($malaya_pintados_00 == 0) {
		mes "[Tattooist]";
		mes "绘制纹身的神圣工作只在‘^7A96E0皮纳达斯节^000000’期间进行。抱歉，现在还没到节日。";
		close;
	}
	mes "[Tattooist]";
	mes "你来得正是时候，现在正值‘^7A96E0皮纳达斯节^000000’。";
	next;
	mes "[Tattooist]";
	mes "没有比神圣的‘^7A96E0皮纳达斯节^000000’更适合绘制纹身的时间了。";
	next;
	mes "[Tattooist]";
	mes "节日持续时间不长，我该开始绘制了。你需要哪种纹身？";
	next;
	switch(select("我再想想。:梦魇护符纹身:布瓦亚护符纹身:巴库纳瓦护符纹身")) {
	case 1:
		mes "[Tattooist]";
		mes "希望你享受‘^7A96E0皮纳达斯节^000000’。";
		close;
	case 2:
		set .@tattoo,2911; //Bangungot_Tattoo
		set .@doll,6517; //Bangungot_Doll
		set .@spirit,6524; //Bangungot_Spirit_Piece
		set .@name$,"梦魇";
		break;
	case 3:
		set .@tattoo,2907; //Buwaya_Tattoo
		set .@doll,6518; //Buwaya_Doll
		set .@spirit,6525; //Buwaya_Spirit_Piece
		set .@name$,"布瓦亚";
		break;
	case 4:
		set .@tattoo,2910; //Bakonawa_Tattoo
		set .@doll,6516; //Bakonawa_Doll
		set .@spirit,6523; //Bakonawa_Spirit_Piece
		set .@name$,"巴库纳瓦";
		break;
	}
	if (countitem(6499) < 10 || countitem(.@spirit) == 0 || countitem(.@doll) == 0) {
		mes "[Tattooist]";
		mes "我想你缺少材料。";
		mes "制作^EE1D11"+.@name$+"护符纹身^000000需要 10 个古代怨念、1 个"+.@name$+"灵魂碎片和 1 个"+.@name$+"玩偶。";
		close;
	}
	emotion ET_SPARK;
	mes "[Tattooist]";
	mes "材料充满神圣能量。我相信用它们能制作出优秀的纹身。";
	next;
	mes "[Tattooist]";
	mes "如果想让纹身完美，请勿在我绘制神圣纹身时打扰。";
	next;
	mes "纹身师把古代怨念放在工作区域周围。";
	next;
	specialeffect EF_FLAMELAUNCHER,AREA,"Ancient Grudge#01";
	specialeffect EF_FLAMELAUNCHER,AREA,"Ancient Grudge#02";
	specialeffect EF_FLAMELAUNCHER,AREA,"Ancient Grudge#03";
	specialeffect EF_FLAMELAUNCHER,AREA,"Ancient Grudge#04";
	specialeffect EF_FLAMELAUNCHER,AREA,"Ancient Grudge#05";
	mes "古代怨念亮了起来，工具开始发光。他满意地看着发光的工具和材料。";
	next;
	mes "然后"+.@name$+"凝视着玩偶，仿佛要把每个细节都记在脑中。";
	next;
	if(select("你不开始吗？:…………") == 1) {
		emotion ET_FRET;
		delitem 6499,5; //Ancient_Grudge
		mes "[Tattooist]";
		mes "哦，不，你把它毁了。";
		mes "我不能为不懂艺术的你绘制纹身。你可以拿回剩余材料。";
		next;
		mes "取回 5 个古代怨念、"+.@name$+"玩偶和"+.@name$+"灵魂碎片。";
		close;
	}
	emotion ET_STARE;
		mes "他是想用眼神把玩偶融化吗？";
	next;
	specialeffect EF_SONICBLOWHIT;
		mes "他缓缓闭眼又睁眼，仿佛要把玩偶牢记脑中，然后举起发光工具开始绘制。";
	next;
		mes ""+.@name$+"纹身几乎瞬间完成。";
	next;
	emotion ET_FRET;
		mes "但他一直盯着图案的每个角落，似乎不喜欢某些细节。";
	next;
	if(select("我觉得很好。:…………") == 1) {
		emotion ET_FRET;
		emotion ET_ANGER;
		delitem 6499,5; //Ancient_Grudge
		mes "[Tattooist]";
		mes "呃！我说过不要打扰！";
		next;
		mes "纹身师恼怒地撕碎了图案。";
		next;
		mes "[Tattooist]";
		mes "我无法继续。下次再说吧。你可以拿回剩余材料。";
		next;
		mes "取回 5 个古代怨念、"+.@name$+"玩偶和"+.@name$+"灵魂碎片。";
		close;
	}
	mes "他长时间凝视图案，然后满意地微笑点头。";
	next;
	mes "看来他对"+.@name$+"图案很满意。";
	next;
	emotion ET_HUM;
	mes "但现在他只是盯着天空，什么也不做。他在等什么？";
	next;
	if(select("什么时候完成？:…………") == 1) {
		emotion ET_FRET;
		emotion ET_ANGER;
		delitem 6499,5; //Ancient_Grudge
		mes "[Tattooist]";
		mes "呃！我说过不要打扰！";
		next;
		mes "纹身师恼怒地撕碎了图案。";
		next;
		mes "[Tattooist]";
		mes "我无法继续。下次再说吧。你可以拿回剩余材料。";
		next;
		mes "取回 5 个古代怨念、"+.@name$+"玩偶和"+.@name$+"灵魂碎片。";
		close;
	}
	emotion ET_THINK;
	mes "[Tattooist]";
	mes ".";
	next;
	mes "[Tattooist]";
	mes ". .";
	next;
	mes "[Tattooist]";
	mes ". . .";
	next;
	emotion ET_THINK;
	mes "[Tattooist]";
	mes ". . . .";
	next;
	mes "[Tattooist]";
	mes ". . . . .";
	next;
	mes "[Tattooist]";
	mes ". . . . . .";
	next;
	mes "[Tattooist]";
	mes ". . . . . . .";
	next;
	emotion ET_SPARK;
	mes "纹身师凝视天空一会儿后双眼发亮，接着用双手捏碎了"+.@name$+"灵魂碎片。";
	next;
	specialeffect EF_DETOXICATION;
	mes .@name$+"灵魂碎片碎成粉末，纹身师的双手发出光芒。";
	next;
	if(select("你为什么捏碎碎片……:…………") == 1) {
		delitem 6499,5; //Ancient_Grudge
		delitem .@spirit,1;
		emotion ET_FRET;
		emotion ET_ANGER;
		mes "[Tattooist]";
		mes "呃！我说过不要打扰！";
		next;
		mes "他手上的光芒消退，盯着双手片刻后恼怒地撕碎了图案。";
		next;
		mes "[Tattooist]";
		mes "我差一点就完成杰作，却被你毁了。我心情很差，你可以拿回剩余材料。";
		next;
		mes "取回 5 个古代怨念和玩偶。";
		close;
	}
	mes "他双手捧起粉末，然后吹到图案上。";
	next;
	specialeffect EF_FLAMELAUNCHER,AREA,"Ancient Grudge#01";
	specialeffect EF_FLAMELAUNCHER,AREA,"Ancient Grudge#02";
	specialeffect EF_FLAMELAUNCHER,AREA,"Ancient Grudge#03";
	specialeffect EF_FLAMELAUNCHER,AREA,"Ancient Grudge#04";
	specialeffect EF_FLAMELAUNCHER,AREA,"Ancient Grudge#05";
	mes "所有古代怨念开始燃烧，随后"+.@name$+"图案上的光芒消退。";
	next;
	specialeffect EF_LIGHTSPHERE;
	mes "图案上方的光芒闪烁。";
	next;
	mes "光芒消退，"+.@name$+"图案不再是之前的简单图案。";
	next;
	mes ""+.@name$+"图案看起来仿佛……活了。";
	next;
	mes "纹身师终于满意了，脸上满是笑容。";
	next;
	emotion ET_SMILE;
	mes "[Tattooist]";
	mes "哈哈，效果太棒了。";
	next;
	delitem 6499,10; //Ancient_Grudge
	delitem .@spirit,1;
	delitem .@doll,1;
	getitem .@tattoo,1;
	set $malaya_pintados_04$, strcharinfo(0);
	mes "[Tattooist]";
	mes "抱歉让你等了这么久。但一切值得，因为我很久没做出品质这么高的纹身了。";
	next;
	mes "[Tattooist]";
	mes "你等待的^EE1D11"+.@name$+"护符纹身^000000完成了。";
	next;
	mes "[Tattooist]";
	mes "希望你享受‘^7A96E0皮纳达斯节^000000’。";
	close;
}

ma_fild01,171,224,0	script	Ancient Grudge#01	139,{ end; }
ma_fild01,173,224,0	duplicate(Ancient Grudge#01)	Ancient Grudge#02	139
ma_fild01,173,223,0	duplicate(Ancient Grudge#01)	Ancient Grudge#03	139
ma_fild01,172,222,0	duplicate(Ancient Grudge#01)	Ancient Grudge#04	139
ma_fild01,171,223,0	duplicate(Ancient Grudge#01)	Ancient Grudge#05	139

ma_fild01,192,200,8	script	Tourist#pin01	58,{
	mes "[Tourist]";
	mes "我从远方赶来，放下一切只为享受‘皮纳达斯节’。";
	next;
	mes "[Tourist]";
	mes "我不后悔来这里，但是……";
	next;
	mes "[Tourist]";
	mes "经历这么多才得到的纹身，我却不喜欢。";
	next;
	mes "[Tourist]";
	mes "我在光下看过了，但我觉得纹身师弄错了。";
	next;
	mes "[Tourist]";
	mes "这毁了我的整个旅程。";
	next;
	mes "[Tourist]";
	mes "啧！";
	close;
OnInit:
	if (!$malaya_pintados_00)
		disablenpc "Tourist#pin01";
	end;
OnEnable:
	enablenpc "Tourist#pin01";
	end;
OnDisable:
	disablenpc "Tourist#pin01";
	end;
}

ma_fild01,211,200,6	script	Tourist#pin02	775,{
	mes "[Tourist]";
	mes "我听说了‘皮纳达斯节’，特地从昆仑赶来。";
	next;
	mes "[Tourist]";
	mes "以防你误会，我脸上的是面具，不是纹身。";
	close;
OnInit:
	if (!$malaya_pintados_00)
		disablenpc "Tourist#pin02";
	end;
OnEnable:
	enablenpc "Tourist#pin02";
	end;
OnDisable:
	disablenpc "Tourist#pin02";
	end;
}

ma_fild01,251,205,2	script	Tourist#pin03	824,{
	mes "[Tourist]";
	mes "嘿，听我说。这不是我想要的纹身。";
	next;
	mes "[Tourist]";
	mes "我要求巴库纳瓦纹身，但越看越觉得这是梦魇纹身。";
	next;
	mes "[Tattooist]";
	mes "不……你说你想要那个。别这么难缠。";
	next;
	mes "[Tourist]";
	mes "你不知道顾客就是上帝吗？嗯？你想要坏名声吗？";
	next;
	mes "[Tattooist]";
	mes "呃……真不敢相信。";
	close;
OnInit:
	if (!$malaya_pintados_00)
		disablenpc "Tourist#pin03";
	end;
OnEnable:
	enablenpc "Tourist#pin03";
	end;
OnDisable:
	disablenpc "Tourist#pin03";
	end;
}

ma_fild01,249,206,6	script	Young Tattooist#pin04	582,{
	mes "[Tattooist]";
	mes "啊……我没法和这样的顾客合作。";
	next;
	mes "[Tattooist]";
	mes "我要说多少次，你明明说想要梦魇纹身。";
	next;
	mes "[Tattooist]";

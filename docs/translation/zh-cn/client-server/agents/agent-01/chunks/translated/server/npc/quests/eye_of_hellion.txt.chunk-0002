			mes "违背意愿的亡魂。";
			next;
			mes "[Sir Chilias'Tyus]";
			mes "但是……现在不是感伤的时候。";
			mes "为了我的祖父，";
			mes "我必须立刻封印";
			mes "赫利昂宝石的力量！";
			next;
			mes "[Sir Chilias'Tyus]";
			mes "蠕动的黑暗，";
			mes "迷失在炼狱的灵魂，";
			mes "我给予你安慰，给予你和平。";
			mes "为绝望者，为无耻者，";
			mes "我指引通往天堂的道路……";
			specialeffect EF_BEGINSPELL;
			next;
			mes "[Sir Chilias'Tyus]";
			mes "不要悲伤，";
			mes "让喜悦降临。不要愤怒，";
			mes "让爱降临。迷失的灵魂";
			mes "现在将找到";
			mes "自己的道路……";
			specialeffect EF_BEGINSPELL6;
			next;
			mes "[Sir Chilias'Tyus]";
			mes "光明与希望……";
			mes "天堂与大地……";
			mes "驱散黑暗。";
			specialeffect EF_SANCTUARY;
			next;
			mes "[Sir Chilias'Tyus]";
			mes "我做到了。";
			mes "经过这么多";
			mes "漫长岁月，我终于做到了。";
			mes "多亏了你的帮助。";
			next;
			mes "[Sir Chilias'Tyus]";
			mes "请收下这朵";
			mes "尼罗玫瑰，它能";
			mes "抑制宝石的力量。";
			mes "我相信你会保守秘密并保护它。";
			mes "来自被贪婪驱使的人。";
			delitem 7332,1; //Slate
			delitem 7337,countitem(7337); //Eye_Of_Hellion
			set HELLIONQ,69;
			getitem 2658,1; //Nile_Rose_
			getitem 603,1; //Old_Blue_Box
			getexp (checkre(3))?120000:1200000,0;
			next;
			mes "[Sir Chilias'Tyus]";
			mes "谢谢你，善良的";
			mes "冒险者。感谢你为我祖父的灵魂带来和平，";
			mes "也感谢你努力守护世界和平。";
			mes "你是真正的英雄。";
			next;
		mes "^3355FF你获得了";
			mes "封印赫利昂宝石的";
			mes "尼罗玫瑰。";
			mes "赫利昂之眼通过奇异力量";
			mes "赋予你一些经验。^000000";
			close;
		}
		else if (countitem(7332) > 0) {
			mes "[Sir Chilias'Tyus]";
			mes "终于，我们拥有了一切。";
			mes "石板和赫利昂宝石。";
			mes "现在我终于可以用";
			mes "这只手镯永久封印";
			mes "它的力量了……";
			next;
			mes "[Sir Chilias'Tyus]";
			mes "蠕动的黑暗，迷失在炼狱的灵魂，";
			mes "我给予你安慰与和平。";
			mes "为绝望者，为无耻者，";
			mes "我指引通往天堂的道路……";
			specialeffect EF_BEGINSPELL;
			next;
			mes "[Sir Chilias'Tyus]";
			mes "不要悲伤，";
			mes "让喜悦降临。不要愤怒，";
			mes "让爱降临。迷失的灵魂";
			mes "现在将找到道路……";
			specialeffect EF_BEGINSPELL6;
			next;
			mes "[Sir Chilias'Tyus]";
			mes "光明与希望……";
			mes "天堂与大地……";
			mes "驱散黑暗。";
			specialeffect EF_SANCTUARY;
			next;
			mes "[Sir Chilias'Tyus]";
			mes "我做到了。";
			mes "经过这么多年，";
			mes "我终于做到了。多亏你的帮助。";
			next;
			mes "[Sir Chilias'Tyus]";
			mes "请收下这朵尼罗玫瑰，";
			mes "它能抑制宝石的力量。";
			mes "我相信你会保守秘密，";
			mes "保护它不被贪婪者觊觎。";
			delitem 7332,1; //Slate
			set HELLIONQ,70;
			getitem 2658,1; //Nile_Rose_
			getexp (checkre(3))?100000:1000000,0;
			next;
			mes "[Sir Chilias'Tyus]";
			mes "谢谢你，善良的";
			mes "冒险者。感谢你为我祖父的灵魂带来和平，";
			mes "也感谢你努力守护世界和平。";
			mes "你是真正的英雄。";
			close;
		}
		mes "[Sir Chilias'Tyus]";
		mes "完整的石板在哪里？";
		mes "我们需要它来取出赫利昂宝石，";
		mes "才能封印宝石的力量！";
		close;
	}
	else if (HELLIONQ > 68 && HELLIONQ < 71) {
		if (countitem(7337) > 0) {
			mes "[Sir Chilias'Tyus]";
			mes "好久不见。你有好好遵守和我的约定吗？";
			mes "请小心保管，";
			mes "防止其中的邪恶力量释放。";
			next;
			mes "[Sir Chilias'Tyus]";
			mes "你还持有赫利昂之眼。";
			mes "我能看到你眼中的痛苦。";
			mes "让我减轻你的负担，这样更好。";
			delitem 7337,countitem(7337); //Eye_Of_Hellion
			next;
			mes "[Sir Chilias'Tyus]";
			mes "愿上帝保佑你。";
			close;
		}
		mes "[Sir Chilias'Tyus]";
		mes "好久不见。你有好好遵守和我的约定吗？";
		mes "请小心保管，防止其中的邪恶力量释放。";
		close;
	}
	mes "[Sir Chilias'Tyus]";
	mes "... ... ...";
	close;

OnTouch_:
	if (HELLIONQ == 57 && countitem(7334) > 0) {
		specialeffect2 EF_HEAL2; 
		specialeffect EF_HEAL2;
		mes "^3355FF你持有的一块石板碎片";
		mes "你持有的物品开始";
		mes "发光，仿佛正在";
		mes "回应什么……^000000";
		close;
	}
	end;
}

prontera,269,326,3	script	Clanux Heffron#hellion	50,{
	if ((MaxWeight-Weight) < 2000 || checkweight(1201,1) == 0) {
		mes "^3355FF站住！";
		mes "你携带的物品太多，背包空间不足，无法领取奖励。请腾出空间后再回来接受挑战。";
		close;
	}
	if (HELLIONQ < 36) {
		mes "[Clanux Heffron]";
		mes "这张地图怎么回事？！";
		mes "我什么都找不到！";
		mes "找个东西怎么会";
		mes "这么难？";
		close;
	}
	else if (HELLIONQ == 36) {
		mes "[" + strcharinfo(0) + "]";
		mes "不好意思，请问你是";
		mes "克兰努克斯·赫弗伦吗？";
		next;
		mes "[Clanux Heffron]";
		mes "你是谁，";
		mes "到底想做什么？哦……";
		mes "奇利亚斯派来的？";
		mes "他想要什么？";
		next;
		if (select("He wants me to help you.:He wants you to help me.") == 1) {
			mes "[Clanux Heffron]";
			mes "所以他派了一个";
			mes "助手来，嗯？好吧……";
			mes "既然他给了我这个线索，";
			mes "而我花了这么久";
			mes "到现在还没有成果，我也不怪他。";
			next;
			mes "[Clanux Heffron]";
			mes "既然他派你来帮助我，";
			mes "那我可以把一切告诉你。";
			mes "关于他让我寻找的线索，";
			mes "目前我只找到两个。";
			mes "但我无法理解它们……";
			next;
			mes "[Clanux Heffron]";
			mes "让我看看，有这把";
			mes "断剑和这个";
			mes "奇怪的齿轮。";
			mes "这些线索是什么意思？！";
			mes "老人有没有给你";
			mes "什么提示来帮助我？";
			next;
			if (select("Where did you find these?:No, I'm sorry.") == 1) {
				mes "[Clanux Heffron]";
				mes "哦，这些是我在普隆德拉找到的。";
				mes "那个老家伙藏得很隐蔽。";
				mes "不过我不觉得你能找到什么，";
				mes "但你能去旧剑士训练场";
				mes "看看有没有更多线索吗？";
				next;
				mes "[Clanux Heffron]";
				mes "天啊，那个赫利昂宝石";
				mes "一定很值钱，";
				mes "否则老人不会费尽周折";
				mes "把线索藏起来。";
				mes "天啊，我真想要……";
				set HELLIONQ,39;
				close;
			}
			mes "[Clanux Heffron]";
			mes "什么……？那你为什么";
			mes "还来帮我？嗯，那个老家伙";
			mes "一定不够信任我，";
			mes "但我也不能";
			mes "怪他。好吧……";
			next;
			mes "[Clanux Heffron]";
			mes "如果你要帮我，";
			mes "去普隆德拉的旧剑士训练场";
			mes "搜查一下。我不太相信，";
			mes "但也许我漏掉了什么。";
			mes "快去！";
			set HELLIONQ,39;
			close;
		}
		mes "[Clanux Heffron]";
		mes "帮你……？帮你找";
		mes "赫利昂宝石的位置？";
		mes "算了吧，伙计！既然我们要争夺";
		mes "同一个奖品，";
		mes "我为什么要帮你？！";
		set HELLIONQ,38;
		close;
	}
	else if (HELLIONQ == 38) {
		mes "[Clanux Heffron]";
		mes "嘿，你为什么一直";
		mes "烦我？！快去";
		mes "自己去寻找赫利昂宝石的线索，";
		mes "你这个混蛋！现在滚出去！";
		next;
		if (select("W-wait! Let's work together!:Fine. I don't need your help!") == 1) {
			mes "[Clanux Heffron]";
			mes "合作，嗯？你";
			mes "通常我会告诉你";
			mes "像月球漫步者一样离开，";
			mes "直接算了，但我得承认";
			mes "独自处理这事";
			mes "并不顺利……";
			next;
			mes "[Clanux Heffron]";
			mes "好吧。";
			mes "先在普隆德拉的旧剑士";
			mes "训练场仔细搜查。";
			mes "那里也许留下了一些线索……";
			set HELLIONQ,39;
			close;
		}
		mes "[" + strcharinfo(0) + "]";
		mes "好吧。";
		mes "我不需要";
		mes "你的帮助！";
		next;
		mes "[Clannux Heffron]";
		mes "才怪！";
		mes "你会回来的！";
		mes "……他们总是";
		mes "回来。";
		close;
	}
	else if (HELLIONQ == 39) {
		mes "[Clanux Heffron]";
		mes "听着伙计，我在普隆德拉旧剑士训练场";
		mes "发现了这把断剑，绝对是线索。";
		mes "你应该能找到";
		mes "也许还有别的东西……";
		close;
	}
	else if (HELLIONQ == 40) {
		mes "[Clanux Heffron]";
		mes "嘿，你搜完了吗？";
		mes "找到什么了吗？";
		next;
		if (select("什么也没有……:其实，我找到了这个。") == 1) {
			mes "[" + strcharinfo(0) + "]";
			mes "^333333（这家伙真是个混蛋！";
			mes "我最好不要分享任何新信息，";
			mes "以防他还不知道这些。^000000";
			next;
			mes "[" + strcharinfo(0) + "]";
			mes "我……我没能";
			mes "找到任何像线索的东西。";
			mes "抱歉，我让你失望了……";
			next;
			mes "[Clanux Heffron]";
			mes "糟糕！好吧，如果你";
			mes "回去找老人，告诉他我在旧剑士";
			mes "训练场找到一把断剑，";
			mes "还在工具店找到这个齿轮。";
			next;
			mes "[Clanux Heffron]";
			mes "我目前找到的线索";
			mes "完全没有意义！";
			mes "所以如果可以，说服他";
			mes "再给我一些提示。";
			mes "把这个交给老人，";
			mes "证明是我找到的，好吗？";
			set HELLIONQ,41;
			getitem 7093,1; //Wheel
			next;
			mes "[Clanux Heffron]";
			mes "我知道的就这些。";
			mes "现在你最好";
			mes "自己去寻找";
			mes "这些线索……";
			close;
		}
		mes "[Clanux Heffron]";
		mes "所以你找到的是这个？";
		mes "嗯，我更困惑了。好吧。";
		mes "我在剑士训练场";
		mes "找到一把断剑。";
		next;
		mes "[Clanux Heffron]";
		mes "哦，我还在附近的工具店";
		mes "找到这个旧齿轮。";
		mes "来，拿着。也许你";
		mes "会更幸运。";
		mes "弄清它的含义。";
		next;
		mes "[Clanux Heffron]";
		mes "不过一旦你";
		mes "发现任何新东西，";
		mes "就来告诉我！";
		mes "这是命令，明白吗？";
		set HELLIONQ,41;
		getitem 7093,1; //Wheel
		close;
	}
	else if (HELLIONQ == 41) {
		mes "[Clanux Heffron]";
		mes "嘿……我不是告诉过你";
		mes "去检查工具店，看看";
		mes "有没有我漏掉的东西吗？";
		mes "现在就去！这是命令！";
		close;
	}
	else if (HELLIONQ == 42) {
		mes "[Clanux Heffron]";
		mes "什么……？我不知道";
		mes "那种东西竟然会藏在";
		mes "训练中，我漏掉了。";
		mes "哦，所以蔬菜女士给了你密码？";
		next;
		mes "[Clanux Heffron]";
		mes "嗯，我完全搞不懂那个密码。";
		mes "看来只能把这个给你了，";
		mes "这是我从工具店找到的齿轮线索。";
		next;
		mes "[Clanux Heffron]";
		mes "我的意思是，你一直很幸运，";
		mes "所以你会";
		mes "也许就能找到";
		mes "这个奇怪谜题背后的答案。";
		mes "但你也得告诉我答案！";
		next;
		mes "[Clanux Heffron]";
		mes "好，现在拿上你的齿轮";
		mes "离开这里。你越早找到线索，";
		mes "我就越早得到赫利昂宝石。";
		set HELLIONQ,43;
		getitem 7093,1; //Wheel
		close;
	}
	else if (HELLIONQ == 43) {
		mes "[Clanux Heffron]";
		mes "嘿，快去检查工具店，";
		mes "弄清密码的含义！";
		mes "也许那台奇怪的机器";
		mes "就是整个谜题的一部分？不……";
		close;
	}
	else if (HELLIONQ == 44) {
		mes "[Clanux Heffron]";
		mes "嘿……";
		mes "你在工具店";
		mes "发现新东西了吗？";
		next;
		if (select("Pretend that nothing happened.:Share what you learned.") == 1) {
			mes "[" + strcharinfo(0) + "]";
			mes "没有……";
			mes "我什么也没找到";
			mes "新的线索。我想";
			mes "只能回到";
			mes "奇利亚斯·泰尤斯那里，";
			mes "除非你知道些什么……";
			next;
			mes "[Clanux Heffron]";
			mes "呸！";
			mes "真没用！";
			mes "你到底算什么";
			mes "助手，嗯？";
			close;
		}
		mes "[" + strcharinfo(0) + "]";
		mes "我把那个齿轮放进";
		mes "工具店的奇怪机器，";
		mes "然后出现了某种数字键盘。";
		mes "可是……我不知道密码是什么。卡住了！";
		next;
		mes "[Clanux Heffron]";
		mes "是吗？哈！既然简单部分完成了，";
		mes "我自己来破解那个秘密密码！";
		mes "哈哈哈！赫利昂宝石马上就是我的了！";
		close;
	}
	else if (HELLIONQ == 45) {
		mes "[Clanux Heffron]";
		mes "嘿，有什么";
		mes "新消息要报告吗？";
		mes "还有，你从工具店";
		mes "那台奇怪的机器上";
		mes "了解到什么了吗？";
		next;
		if (select("只告诉他一点点。:不告诉他。") == 1) {
			mes "[" + strcharinfo(0) + "]";
			mes "我把那个齿轮放进";
			mes "工具店的奇怪机器，";
			mes "然后出现了某种数字键盘。可是……";
			next;
			mes "[" + strcharinfo(0) + "]";
			mes "^333333（等等，我不能相信这个";
			mes "家伙！）^000000 我把能想到的每个密码";
			mes "都输入了，";
			mes "但什么也没发生！";
			mes "我好像卡住了……";
			next;

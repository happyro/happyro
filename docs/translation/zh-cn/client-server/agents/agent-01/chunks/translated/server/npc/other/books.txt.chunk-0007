prt_in,162,68,4	script	Vending Guide#pront	HIDDEN_NPC,{
	mes "^FF0000[新手摆摊指南]^000000";
	mes "想开一家自己的商店，";
	mes "把物品卖给其他玩家赚取 Zeny 吗？";
	next;
	mes "";
	if (select("是的，我想开店！:合上书本。") == 1) {
		mes "^FF0000[新手摆摊指南]^000000";
		mes "首先，只有部分职业可以开设商店。";
		mes "作为商人、铁匠或炼金术师，";
		mes "你必须先学习 ^009933负重上限 5 级^000000，";
		mes "然后学习 ^009933手推车^000000 技能。";
		next;
		mes "";
		mes "";
		mes "^FF0000[新手摆摊指南]^000000";
		mes "学会手推车技能后，";
		mes "就可以向卡普拉员工租用手推车。";
		mes "装备手推车后，只要不主动卸下，";
		mes "它就不会消失。";
		next;
		mes "";
		mes "";
		mes "^FF0000[新手摆摊指南]^000000";
		mes "不过，装备手推车会降低移动速度。";
		mes "继续为 ^009933手推车^000000 技能投入技能点，";
		mes "就能恢复部分移动速度。";
		next;
		mes "";
		mes "";
		mes "^FF0000[新手摆摊指南]^000000";
		mes "接下来这部分非常重要。";
		mes "如果想出售手推车里的物品，";
		mes "必须先将 ^009933手推车^000000 学到 3 级，";
		mes "这样才能学习 ^009933露天商店^000000，";
		mes "并出售手推车里的物品。";
		next;
		mes "";
		mes "";
		mes "^FF0000[新手摆摊指南]^000000";
		mes "请记住，只有手推车里的物品";
		mes "才能通过露天商店技能出售。";
		mes "按下 ‘^009933Alt^000000’ 和 ‘^009933W^000000’ 键，";
		mes "打开名为‘租用手推车物品’的手推车窗口。";
		next;
		mes "";
		mes "^FF0000[新手摆摊指南]^000000";
		mes "你可以把物品从背包窗口拖放到手推车窗口。";
		mes "也可以点击装备窗口里的‘^009933物品^000000’按钮，";
		mes "使用 (^009933Alt^000000 + ^009933Q^000000) 打开手推车窗口。";
		next;
		mes "";
		mes "";
		mes "";
		mes "^FF0000[新手摆摊指南]^000000";
		mes "现在使用露天商店技能。";
		mes "屏幕上会弹出两个窗口：^009933可出售物品^000000 和 ^009933开设商店^000000。";
		next;
		mes "";
		mes "^FF0000[新手摆摊指南]^000000";
		mes "把物品从 ^009933可出售物品^000000 窗口";
		mes "拖放到 ^009933开设商店^000000 窗口。";
		mes "然后在 ^009933开设商店^000000 窗口中";
		mes "设置价格并为商店命名。";
		next;
		mes "";
		mes "";
		mes "^FF0000[新手摆摊指南]^000000";
		mes "确认物品和价格后，点击‘确定’按钮。";
		mes "^009933我的商店^000000窗口就会出现。";
		mes "恭喜你，现在可以出售物品了！";
		next;
		mes "";
		mes "";
		mes "^FF0000[新手摆摊指南]^000000";
		mes "关闭 ^009933我的商店^000000 窗口后，商店也会关闭。";
		mes "你可以在 ^009933我的商店^000000 窗口查看物品价格，";
		mes "销售记录会显示在聊天窗口中。";
		next;
		mes "";
		mes "";
		mes "";
		mes "^FF0000[新手摆摊指南]^000000";
		mes "物品全部售出后，商店会自动关闭。";
		next;
		mes "";
		mes "^FF0000[新手摆摊指南]^000000";
		mes "超级初心者可以学会开设商店所需的全部技能，";
		mes "但没有卡普拉员工愿意向他们出租手推车。";
		mes "要是他们能找到可以租用手推车的地方就好了……";
	}
	close;
}


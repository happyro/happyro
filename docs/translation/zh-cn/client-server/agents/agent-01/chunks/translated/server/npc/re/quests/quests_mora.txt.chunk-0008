					case 7: set .@str$,"不明生物以闪电般的速度冲来，但你用大肚子轻松挡住了。你的肚子堪称世界级。HP 只减少一半。"; break;
					// Not blocked.
					case 2: set .@str$,"你想用肥硕的屁股挡住冲撞，却没挡住，还被撞中了难以启齿的部位。"; break;
					case 4: set .@str$,"你想用大肚子挡住冲撞，但肚子还不够大，无法吸收冲击。"; break;
					case 6: set .@str$,"你想交叉双臂挡住冲撞，却感受到一股惊人的力量。"; break;
					case 8: set .@str$,"你想挡住冲撞，但毫无作用。"; break;
					case 9: set .@str$,"你想用强壮的双手挡住冲撞，但毫无作用。"; break;
					case 10: set .@str$,"你想用结实的双脚挡住冲撞，但疼痛让你彻底清醒了。"; break;
				}
				mes .@str$+" 受到 ^FF0000["+.@n_damage+"]^000000 点伤害。";
				next;
				break;
			case 3:
				if (.@defend == 2 || .@defend == 4 || .@defend == 6 || .@defend == 8) {

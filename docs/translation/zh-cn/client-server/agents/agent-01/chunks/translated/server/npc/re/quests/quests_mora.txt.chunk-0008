			mes "... ... ... ... ...";
			next;
			mes "他似乎在胡言乱语。";
			next;
			mes "[菲希]";
			mes "欺负。好玩。每天。";
			mes "我说话。还是欺负。";
			next;
			mes "[菲希]";
			mes "你……好。帮菲希？";
			next;
			if(select("不帮忙。:帮忙。") == 1) {
				emotion ET_CRY;
				set ep14_1_goki,0;
				close2;
				donpcevent "Black Shadow#ep14_muk::OnDisable";
				end;
			}
			mes "[菲希]";
			mes "你很好。好！";
			next;
			mes "[菲希]";
			mes "我以前不住这里。";
			mes "我住在水洼。";
			mes "水洼。住那里。";
			next;
			mes "[菲希]";
			mes "我奇怪地睡着。";
			mes "有一天醒来。";
			mes "来到这里，浴场。";
			next;
			mes "[菲希]";
			mes "不知道怎么回家。";
			mes "我只能住在这里。";
			mes "我长大了。洞变小。";
			mes "进不去了。";
			next;
			mes "[菲希]";
			mes "我想念家人。我想见家人。";
			mes "你很好。帮我看看家人怎么样。";
			mes "带消息给我。好。";
			next;
			select("我怎么知道谁是你的家人？");
			mes "[菲希]";
			mes "我们鱼很笨。";
			mes "很笨。但知道家人的名字。";
			next;
			mes "[菲希]";
			mes "家人知道菲希的名字。家人会来。";
			next;
			mes "[菲希]";
			mes "拜托。在水洼。";
			mes "告诉我家人是否平安。";
			setquest 5030+rand(4); //5030,5031,5032,5033
			close;
		} else if (checkquest(5030) > -1 || checkquest(5031) > -1 || checkquest(5032) > -1 || checkquest(5033) > -1) {
			mes "[菲希]";
			mes "拜托。在水洼。";
			mes "告诉我家人是否平安。";
			next;
			mes "[菲希]";
			mes "你忘了我的名字？";
			next;
			if(select("请再告诉我你的名字！:我知道你的名字。") == 1) {
				mes "[菲希]";
				mes "你的记性像鱼。";
				mes "笨。我来说。";
				mes "我的名字是菲希，菲希！！";
				next;
			}
			mes "[菲希]";
			mes "拜托。在水洼。";
			mes "告诉我家人是否平安。";
			close;
		} else if (checkquest(5034) > -1 && checkquest(5034) < 2) {
			if (MaxWeight - Weight < 100 || checkweight(5792,1) == 0) {
				mes "[菲希]";
				mes "你带了很多东西。";
				mes "我给你。";
				mes "清空背包再回来。";
				close;
			}
			mes "[菲希]";
			mes "你告诉我家人平安。谢谢。";
			mes "我知道谢谢。鱼的说法。";
			mes "谢……不知道这个词。";
			next;
			select("也许……奖励？");
			mes "[菲希]";
			mes "是的。就是那个。你很好。";
			mes "聪明。给你奖励。";
			mes "我知道谢谢。鱼的说法。";
			next;
			mes "[菲希]";
			mes "这个是我从浴场捡到的。";
			mes "不，是有人留下的。";
			mes "……好人。我给你。";
			completequest 5034;
			getitem 5792,1; //Fish_Pin
			close;
		} else if (checkquest(5034) == 2) {
			mes "[菲希]";
			mes "你……我看到了。感觉。我看到了。";
			mes "你……名字？";
			next;
			input .@inputstr$;
			mes "[菲希]";
			mes .@inputstr$+" 做。";
			mes "不知道。不记得……";
			mes "你……是谁？";
			close;
		}
	}
	set .@weapon$, ((getequipisequiped(EQI_HAND_R))?getequipname(EQI_HAND_R):"赤手空拳");
	set .@pc_hp, 200;
	set .@npc_hp, 200;
	setarray .@skills$[0],"腹部拳击","头槌","扭来扭去","螺旋拳","含糊嘟囔";
	mes "不明生物正在攻击。你要怎么做？";
	next;
	while(1) {
		switch(select("用武器攻击。:使用技能攻击。:用牙齿攻击。:害怕地逃跑。")) {
		case 1: // Weapon
			set .@p_damage,10;
			set .@pc_attack, rand(1,10);
			mes "["+strcharinfo(0)+"的攻击]";
			switch(.@pc_attack) {
			// Miss.
			case 3:
				mes "你试图用最近高价买来的 ^FF0000["+.@weapon$+"]^000000 攻击，但不明生物迅速躲开了。";
				break;
			case 6:
				mes "你误用霍尔格伦扔给你的 ^FF0000["+.@weapon$+"]^000000 攻击不明生物，但它预判攻击并躲开了。";
				break;
			case 9:
				mes "你用珍贵的 ^FF0000[+"+.@weapon$+"+]^000000 攻击不明生物，但它后退躲开了攻击。";
				break;
			// Hit.
			default:
				specialeffect EF_HIT1;
				set .@npc_hp, .@npc_hp - .@p_damage;
				switch(.@pc_attack) {
					case 1: set .@str$,"你用珍贵的 ^FF0000["+.@weapon$+"]^000000 攻击不明生物。武器刺穿了它的身体。"; break;
					case 2: set .@str$,"你误用霍尔格伦扔给你的 ^FF0000["+.@weapon$+"]^000000 攻击不明生物。砰的一声，它的身体摇晃起来。"; break;
					case 4: set .@str$,"你试图用最近高价买来的 ^FF0000["+.@weapon$+"]^000000 攻击。砰的一声击中了不明生物的身体。"; break;
					case 5: set .@str$,"你用借来的 ^FF0000["+.@weapon$+"]^000000 攻击不明生物，武器却脱手飞出，刺进了它的身体。"; break;
					case 7: set .@str$,"你用珍贵的 ^FF0000["+.@weapon$+"]^000000 攻击不明生物，仿佛武器已成为身体的一部分。"; break;
					case 8: set .@str$,"你用幸运的 ^FF0000["+.@weapon$+"]^000000 攻击不明生物。"; break;
					case 10: set .@str$,"你用朋友的 ^FF0000["+.@weapon$+"]^000000 攻击不明生物。"; break;
				}
				mes .@str$+" 造成了 ^FF0000["+.@p_damage+"]^000000 点伤害。";
				break;
			}
			next;
			break;
		case 2: // Skill
			set .@p_damage,20;
			set .@pc_attack, rand(1,6);
			set .@skillname$, .@skills$[rand(5)];
			mes "["+strcharinfo(0)+"的攻击]";
			switch(.@pc_attack) {
			// Miss.
			case 2:
				mes "你使用技能 ^0000FF["+.@skillname$+"]^000000，但无法集中精神，没能正确施展技能。";
				break;
			case 4:
				mes "你竭尽全力使用技能 ^0000FF["+.@skillname$+"]^000000，但不明生物轻松躲开并嘲笑了你。";
				break;
			case 6:
				mes "你使用技能 ^0000FF["+.@skillname$+"]^000000 攻击，但不明生物从视野中消失，技能施展失败。";
				break;
			// Hit.
			default:
				specialeffect EF_BASH;
				set .@npc_hp, .@npc_hp - .@p_damage;
				switch(.@pc_attack) {
					case 1: set .@str$, "攻击迅猛无比，不明生物惊得动弹不得。"; break;
					case 3: set .@str$, "不明生物试图躲闪，但你预判了它的动作并准确瞄准。"; break;
					case 5: set .@str$, "你的技能划出完美的抛物线，准确击中了不明生物。"; break;
				}
				mes "你使用技能 ^0000FF["+.@skillname$+"]^000000 攻击不明生物。"+.@str$+" 造成了 ^FF0000["+.@p_damage+"]^000000 点伤害。";
				break;
			}
			next;
			break;
		case 3: // Tooth
			set .@p_damage,50;
			set .@pc_attack, rand(1,10);
			mes "["+strcharinfo(0)+"的攻击]";
			if (.@pc_attack == 4 || .@pc_attack == 7) {
				specialeffect EF_HIT1;
				set .@npc_hp, .@npc_hp - .@p_damage;
				mes "你用精心护理的牙齿狠咬不明生物，直到牙齿陷进它的肉里。造成了 ^FF0000["+.@p_damage+"]^000000 点伤害。";
			} else
				mes "你用钢铁般的牙齿咬向不明生物，但受惊的它躲开了，并用奇怪的眼神盯着你。";
			next;
			break;
		case 4: // Run
			mes "你害怕不明生物，试图逃跑。";
			next;
			mes "["+strcharinfo(0)+"的逃跑]";
			if (rand(1,2) == 1) {
				mes "幸运的是，不明生物没有追上来。";
				close;
			} else {
				mes "你试图逃跑时被不明生物发现并遭到攻击。逃跑失败。";
				next;
				specialeffect2 EF_HIT1;
				mes "不明生物用尾巴猛击你。疼得你眼泪都流了出来。受到 ^FF000010^000000 点伤害。";
				set .@pc_hp, .@pc_hp - 10;
				next;
				// Unofficial check, but it's needed here.
				callsub L_CheckPCAlive, .@pc_hp;
			}
			break;
		}
		if (.@npc_hp <= 0) {
			mes "你赢了。不明生物失去了意识。";
			next;
			if (checkquest(5016) > -1 && countitem(6385) == 0) {
				mes "你要怎么做？";
				next;
				select("寻找研究工具。");
				if (checkweight(6385,1) == 0) {
					mes "你试图寻找研究工具，";
					mes "但携带的物品太多了。";
					mes "最好减轻负重";
					mes "再回来。";
					close2;
					donpcevent "Black Shadow#ep14_muk::OnDisable";
					end;
				}
				mes "找到了研究员拉佛勒斯的^0000FF研究工具^000000。";
				set ep14_1_goki, ep14_1_goki+1;
				getitem 6385,1; //Research_Tool_Bag
				setquest 5029;
				next;
				mes "不明生物醒来，消失在黑暗的洞穴中。";
				close2;
				donpcevent "Black Shadow#ep14_muk::OnDisable";
				end;
			} else if (checkquest(5017) > -1) {
				mes "你要怎么欺负它？";
				next;
				input .@inputstr$;
				mes "你用^0000FF"+.@inputstr$+"^000000欺负不明生物。";
				next;
				setquest 5029;
				switch(ep14_1_muk) {
				case 3:
					mes "你欺负了不明生物。这还挺有趣。";
					break;
				case 4:
					mes "你第二次欺负了不明生物。这确实很有意思。";
					break;
				case 5:
					mes "你第三次欺负了不明生物。虽然有趣，但该停手了。";
					changequest 5017,5018;
					break;
				}
				set ep14_1_muk, ep14_1_muk+1;
				set ep14_1_goki, ep14_1_goki+1;
				close2;
				donpcevent "Black Shadow#ep14_muk::OnDisable";
				end;
			} else {
				mes "你要怎么做？";
				next;
				if(select("检查不明生物的身体。:离开。") == 2) {
					setquest 5029;
					set ep14_1_goki, ep14_1_goki+1;
					close2;
					donpcevent "Black Shadow#ep14_muk::OnDisable";
					end;
				}
				if (rand(1,30) == 7) {
					if (checkweight(6380,1) == 0) {
						mes "检查不明生物身体时，你的手指碰到了什么。虽然很幸运，但因负重过高，无法获得一枚^0000FF莫拉硬币^000000。";
						set ep14_1_goki, ep14_1_goki+1;
						setquest 5029;
						close2;
						donpcevent "Black Shadow#ep14_muk::OnDisable";
						end;
					}
					mes "检查不明生物身体时，你的手指碰到了什么。真幸运。获得了一枚^0000FF莫拉硬币^000000。";
					set ep14_1_goki, ep14_1_goki+1;
					getitem 6380,1; //Mora_Coin
					setquest 5029;
					next;
					mes "不明生物醒来，消失在黑暗的洞穴中。";
				} else {
					mes "你刚碰到不明生物的身体，它便醒来并消失在黑暗的洞穴中。";
					set ep14_1_goki, ep14_1_goki+1;
					setquest 5029;
				}
				close2;
				donpcevent "Black Shadow#ep14_muk::OnDisable";
				end;
			}
		}
		mes "[ 当前进度 ]";
		mes strcharinfo(0)+" HP = "+.@pc_hp;
		mes "不明生物 HP = "+.@npc_hp;
		next;
		mes "[不明生物的攻击]";
		set .@npc_attack, rand(1,3);
		switch(.@npc_attack) {
		case 1:
			set .@n_damage,10;
			mes "不明生物喷出一股洗澡水。";
			break;
		case 2:
			set .@n_damage,20;
			mes "不明生物高速向你冲来，似乎想使出头槌。";
			break;
		case 3:
			set .@n_damage,50;
			mes "不明生物露着牙齿向你冲来，似乎想咬你。";
			break;
		}
		next;
		mes "你要怎么做？";
		next;
		switch(select("……:躲闪。:格挡。:受不了了。逃跑。")) {
		case 1:
			switch(.@npc_attack) {
			case 1:
				specialeffect2 EF_ICEARROW;
				mes "你站着不动。水柱正中你的脸，头脑顿时清醒。受到 ^FF0000["+.@n_damage+"]^000000 点伤害。";
				break;
			case 2:
				specialeffect2 EF_BASH;
				mes "你站着不动。不明生物的头槌正中你，头脑顿时清醒。受到 ^FF0000["+.@n_damage+"]^000000 点伤害。";
				break;
			case 3:
				specialeffect2 EF_HIT1;
				mes "你呆站着不动。不明生物靠近后狠狠咬住你，头脑顿时清醒。受到 ^FF0000["+.@n_damage+"]^000000 点伤害。";
				break;
			}
			set .@pc_hp, .@pc_hp - .@n_damage;
			next;
			break;
		case 2:
			switch(.@npc_attack) {
			case 1:
				set .@miss, rand(1,5);
				mes "[不明生物的攻击]";
				switch(.@miss) {
				// Miss.
				case 1:
					mes "不明生物向你喷出水柱，但你侧身轻松躲开了。";
					break;
				case 3:
					mes "不明生物向你喷出水柱，但你一边挖鼻孔一边躲开了。";
					break;
				// Hit.
				default:
					specialeffect2 EF_ICEARROW;
					set .@pc_hp, .@pc_hp - .@n_damage;
					switch(.@miss) {
						case 2: set .@str$,"脸"; break;
						case 4: set .@str$,"腹部"; break;
						case 5: set .@str$,"手臂"; break;
					}
					mes "水柱正中你的"+.@str$+"。受到 ^FF0000["+.@n_damage+"]^000000 点伤害。";
					break;
				}
				next;
				break;
			case 2:
				set .@miss, rand(1,10);
				mes "[不明生物的攻击]";
				switch(.@miss) {
				// Miss.
				case 1:
					mes "不明生物冲向你试图使出头槌，但这种攻击还难不倒你。";
					break;
				case 3:
					mes "不明生物冲向你试图使出头槌，但你微微移动便躲开了攻击。";
					break;
				case 5:
					mes "不明生物冲向你试图使出头槌，但你一边挖鼻孔一边躲开了攻击。";
					break;
				case 7:
					mes "不明生物冲向你试图使出头槌，但你轻松躲开了攻击。";
					break;
				// Hit.
				default:
					specialeffect2 EF_BASH;
					set .@pc_hp, .@pc_hp - .@n_damage;
					switch(.@miss) {
						case 2: set .@str$,"砰的一声，你感到一阵剧痛。"; break;
						case 4: set .@str$,"砰！你的后背似乎快撑不住了。"; break;
						case 6: set .@str$,"不明生物的攻击击中了你的肩膀。"; break;
						case 8: set .@str$,"这一击如箭一般迅疾。"; break;
						case 9: set .@str$,"这一击又快又准。"; break;
						case 10: set .@str$,"砰的一声，它击中了你的手。"; break;
					}
					mes "不明生物冲向你并使出头槌。"+.@str$+" 受到 ^FF0000["+.@n_damage+"]^000000 点伤害。";
					break;
				}
				next;
				break;
			case 3:
				set .@miss, rand(1,10);
				mes "[不明生物的攻击]";
				switch(.@miss) {
				// Miss.
				case 1:
					mes "不明生物露着牙齿向你冲来，但你冷笑着躲开了攻击。";
					break;
				case 3:
					mes "不明生物露着牙齿向你冲来，但你稍稍移动便躲开了攻击。";
					break;
				case 5:
					mes "不明生物露着牙齿向你冲来，但你一边伸懒腰一边躲开了攻击。";
					break;
				case 7:
					mes "不明生物露着牙齿向你冲来，但你一边数 Zeny 一边躲开了攻击。";
					break;
				case 8:
					mes "不明生物露着牙齿向你冲来，但你轻巧地躲开了攻击。";
					break;
				case 9:
					mes "不明生物露着牙齿向你冲来，但你冷笑着躲开了攻击。";
					break;
				// Hit.
				default:
					specialeffect2 EF_HIT1;
					set .@pc_hp, .@pc_hp - .@n_damage;
					switch(.@miss) {
						case 2: set .@str$,"腿，锋利的牙齿刺进了你的腿。"; break;
						case 4: set .@str$,"手臂，锋利的牙齿刺进了你的手臂。"; break;
						case 6: set .@str$,"脚趾，你觉得脚趾快被咬断了。"; break;
						case 10: set .@str$,"手指，你觉得手指快被咬断了。"; break;
					}
					mes "不明生物露着牙齿向你冲来，咬住了你的"+.@str$+" 受到 ^FF0000["+.@n_damage+"]^000000 点伤害。";
					break;
				}
				next;
				break;
			}
			break;
		case 3:
			set .@defend, rand(1,10);
			switch(.@npc_attack) {
			case 1:
				if (.@defend == 3 || .@defend == 6) {
					set .@n_damage, .@n_damage / 2;
					specialeffect2 EF_GUARD;
				} else
					specialeffect2 EF_ICEARROW;
				set .@pc_hp, .@pc_hp - .@n_damage;
				mes "["+strcharinfo(0)+"的防御]";
				switch(.@defend) {
					// Blocked.
					case 3: set .@str$,"你用结实的屁股挡住水柱。感觉很清爽。HP 只减少一半。"; break;
					case 6: set .@str$,"你用强壮的双手挡住水柱。手有点刺痛。HP 只减少一半。"; break;
					// Not blocked.
					case 1: set .@str$,"你想用结实的屁股挡住水柱，但太迟了。"; break;
					case 2: set .@str$,"你想用大肚子挡住水柱，但毫无作用。"; break;
					case 4: set .@str$,"你想用合拢的双手挡住水柱，但不明生物瞄准了别处。"; break;
					case 5: set .@str$,"你想用强壮的双手挡住水柱，但失败了。"; break;
					case 7: set .@str$,"你想交叉双臂挡住水柱，却把手臂交叉错了。"; break;
					case 8: set .@str$,"你想用岩石般坚硬的脑袋挡住水柱，但没能成功。"; break;
					case 9: set .@str$,"你想用结实的肌肉挡住水柱，但没能成功。"; break;
					case 10: set .@str$,"你想用强壮的双脚挡住水柱，但白费力气。"; break;
				}
				mes .@str$+" 受到 ^FF0000["+.@n_damage+"]^000000 点伤害。";
				next;
				break;
			case 2:
				if (.@defend == 1 || .@defend == 3 || .@defend == 5 || .@defend == 7) {
					set .@n_damage, .@n_damage / 2;
					specialeffect2 EF_GUARD;
				} else
					specialeffect2 EF_BASH;
				set .@pc_hp, .@pc_hp - .@n_damage;
				mes "["+strcharinfo(0)+"的防御]";

// Drooping Cat, Smokie Leaf, Lazy Smokie, Blue Fish
//============================================================
morocc,273,79,4	script	Educated Traveller	99,{
	disable_items;
	if ((MaxWeight-Weight) < 5000 || checkweight(1201,1) == 0) {
		mes "- 等一下！ -";
		mes "- 你的负重过高，无法从这个 NPC 获得更多物品。 -";
		mes "- 请先把部分物品存入卡普拉仓库后再试。 -";
		close;
	}
	if (countitem(7030) > 0) {
		mes "[Lee Hester]";
		mes "嗯……？";
		mes "你身上那是什么？";
		mes "啊，是沙漠之狼的爪子～！";
		next;
		mes "[Lee Hester]";
		mes "只有在沙漠旅行很久才能得到它。像你这样的人一定也欣赏我故乡的美丽。";
		next;
		mes "[Lee Hester]";
		mes "啊哈哈哈～";
		mes "如果你在梦罗克沙漠待过足够久，一定也懂得高品质遮阳帽的价值。";
		next;
		mes "[Lee Hester]";
		mes "这样吧。我研究动物学到了很多，只要给我正确材料，我就为你做一顶^3355FF真正棒的帽子^000000。";
		next;
		mes "[Lee Hester]";
		mes "记住……";
		mes "如果给我的装备插过卡或精炼过，^ff0000制作完成后其中的精炼效果和卡片都会消失。^000000请务必注意。";
		next;
		switch(select("垂耳猫:烟斗草:懒洋洋的狸猫:蓝鱼:那……好吧。")) {
		case 1:
			if (countitem(2233) > 0 && countitem(983) > 0 && countitem(7206) > 299) {
				mes "[Lee Hester]";
				mes "啊……";
				mes "你把材料都带来了。";
				mes "太好了！给我一点时间制作“垂耳猫”。";
				next;
				mes "*Scratch scratch...*";
				next;
				mes "*Scratch scratch...*";
				mes "*Tap tap...*";
				next;
				mes "*Scratch scratch...*";
				mes "*Tap tap...*";
				mes "*Scratch scratch...*";
				next;
				mes "^3355FF嗯……";
				mes "这听起来不像制作帽子的声音……^000000";
				next;
				mes "[Lee Hester]";
				mes "哦，别担心。马上就完成了。";
				next;
				mes "*嗖嗖嗖……*";
				next;
				mes "*嗖嗖嗖……*";
				mes "*Chomp chomp...*";
				next;
				mes "*嗖嗖嗖……*";
				mes "*Chomp chomp...*";
				mes "*Chikachikachoom*";
				next;
				mes "[Lee Hester]";
				mes "给你。*呼～*";
				mes "这是你自己的“垂耳猫”帽子，蕴含科学原理！另外，沙漠之狼的爪子能留给我吗？嘿嘿，谢谢～";
				delitem 2233,1; //Circlet_
				delitem 983,1; //Black_Dyestuffs
				delitem 7206,300; //Black_Kitty_Doll
				delitem 7030,1; //Claw_Of_Desert_Wolf
				getitem 5058,1; //Drooping_Kitty
				emotion ET_DELIGHT;
				close;
			}
			else {
				mes "[Lee Hester]";
				mes "要不要我为你做一顶……";
				mes "“垂耳猫”？";
				mes "听我说，把猫做成帽子其实很有道理……";
				next;
				mes "[Lee Hester]";
				mes "我在朱诺图书馆读《欢乐儿童科学》时看到，所有猫无论野生还是家养，都是掌握节省能量技巧的猎手。";
				next;
				mes "[Lee Hester]";
				mes "经过长时间在阳光下打盹，它们发展出能在任何地方、任何情况下睡觉的完美姿势：懒猫垂耳。";
				next;
				mes "[Lee Hester]";
				mes "没有这顶帽子的启发，人类根本不可能模仿这种特殊的猫科技能！";
				next;
				mes "[Lee Hester]";
				mes "即使你没能模仿猫咪打盹时的垂耳姿势，至少它能遮住头顶的阳光。";
				next;
				mes "[Lee Hester]";
				mes "我需要的材料是：1个^ff0000带洞头箍^000000、1个^ff0000黑色染料^000000和300个^ff0000黑猫玩偶^000000。";
				next;
				mes "[Lee Hester]";
				mes "带齐这些材料后，我马上为你制作垂耳猫。";
				close;
			}
		case 2:
			if (countitem(945) > 599) {
				mes "[Lee Hester]";
				mes "啊……";
				mes "你把材料都带来了。";
				mes "太好了！给我一点时间组装“烟斗草”。";
				next;
				mes "*Scratch scratch...*";
				next;
				mes "*Scratch scratch...*";
				mes "*Tap tap...*";
				next;
				mes "*Scratch scratch...*";
				mes "*Tap tap...*";
				mes "*Scratch scratch...*";
				next;
				mes "^3355FFHmm...";
				mes "这听起来不像制作帽子的声音……^000000";
				next;
				mes "[Lee Hester]";
				mes "哦，别担心。马上就完成了。";
				next;
				mes ".........";
				next;
				mes "*嗖嗖嗖……*";
				next;
				mes "*嗖嗖嗖……*";
				mes "*Chomp chomp...*";
				next;
				mes "*嗖嗖嗖……*";
				mes "*Chomp chomp...*";
				mes "*P-peeeeeeeeep*";
				next;
				mes "[Lee Hester]";
				mes "给你。*呼～*";
				mes "这是你自己的“烟斗草”帽子，蕴含科学原理！沙漠之狼的爪子能留给我吗？嘿嘿，谢谢～";
				delitem 945,600; //Raccoon_Leaf
				delitem 7030,1; //Claw_Of_Desert_Wolf
				getitem 5064,1; //Leaf_Headgear
				emotion ET_SURPRISE;
				close;
			}
			else {
				mes "[Lee Hester]";
				mes "要不要……";
				mes "“烟斗草”？";
				next;
				mes "[Lee Hester]";
				mes "我知道，把一大片叶子戴在头上听起来不实用。但听我说，其实很有道理。";
				next;
				mes "[Lee Hester]";
				mes "你有没有发现，炎热天气穿白色会凉快很多，穿黑色却会暖和很多？";
				next;
				mes "[Lee Hester]";
				mes "经过深思熟虑并阅读朱诺的《欢乐儿童科学》杂志，我发现黑色吸收阳光和热量，而白色会反射它们。";
				next;
				mes "[Lee Hester]";
				mes "所以……";
				mes "如果你身上没有颜色会怎样？如果我^333333*咳咳*^000000的假说正确，隐形时就不会感到热！";
				next;
				mes "[Lee Hester]";
				mes "因此我制作了这片浣熊叶，试图模仿狸猫不可思议的隐形能力。";
				next;
				mes "[Lee Hester]";
				mes "它……";
				mes "还没按我想的那样发挥作用。不过它是一大片叶子！可以提供遮阴。";
				next;
				mes "[Lee Hester]";
				mes "制作它我只需要……";
				mes "600 ^ff0000Raccoon Leaf^000000.";
				mes "虽然奇怪，但我需要很多小叶子才能做出一片大叶子。";
				close;
			}
		case 3:
			if (countitem(1026) > 999 && countitem(7065) > 99 && countitem(945) > 9) {
				mes "[Lee Hester]";
				mes "啊……";
				mes "你把材料都带来了。";
				mes "太好了！给我一点时间制作“懒洋洋的狸猫”帽子。";
				mes "....";
				next;
				mes "*Scratch scratch...*";
				next;
				mes "*Scratch scratch...*";
				mes "*Tap tap...*";
				next;
				mes "*Scratch scratch...*";
				mes "*Tap tap...*";
				mes "*Scratch scratch...*";
				next;
				mes "^3355FFHmm...";
				mes "这听起来不像制作帽子的声音……^000000";
				next;
				next;
				mes "[Lee Hester]";
				mes "哦，别担心。马上就完成了。";
				next;
				mes ".........";
				next;
				mes "*嗖嗖嗖……*";
				next;
				mes "*嗖嗖嗖……*";
				mes "*Chomp chomp...*";
				next;
				mes "*嗖嗖嗖……*";
				mes "*Chomp chomp...*";
				mes "*Glunk.*";
				next;
				mes "[Lee Hester]";
				mes "给你。*呼～*";
				mes "这是你自己的“懒洋洋的狸猫”帽子，蕴含科学原理！沙漠之狼的爪子能留给我吗？嘿嘿，谢谢～";
				delitem 1026,1000; //Acorn
				delitem 7065,100; //Sea_Otter_Leather
				delitem 945,10; //Raccoon_Leaf
				delitem 7030,1; //Claw_Of_Desert_Wolf
				getitem 5084,1; //Lazy_Raccoon
				emotion ET_SMILE;
				close;
			}
			else {
				mes "[Lee Hester]";
				mes "要不要我做……";
				mes "“懒洋洋的狸猫”？";
				next;
				mes "[Lee Hester]";
				mes "我知道，把浣熊戴在头上听起来很荒谬，但听我说，其实很有道理。";
				next;
				mes "[Lee Hester]";
				mes "我从朱诺图书馆的《欢乐儿童科学》杂志中了解到，不同颜色会吸收或反射阳光。";
				next;
				mes "[Lee Hester]";
				mes "炎热天气穿一种颜色会更暖，穿另一种颜色会更凉。";
				next;
				mes "[Lee Hester]";
				mes "所以我想……如果我没有颜色会怎样？";
				next;
				mes "[Lee Hester]";
				mes "众所周知，隐形或全裸时身上都没有颜色。我已经做过裸体实验，结果悲惨又可怜……";
				next;
				mes "[Lee Hester]";
				mes "现在我在研究隐形。我试过用人形大小的烟斗草来隐形，但还没成功。所以我想到……";
				next;
				mes "[Lee Hester]";
				mes "如果我把狸猫和自己连接起来，它隐形时我会不会也隐形？";
				next;
				mes "[Lee Hester]";
				mes "我还没试过，因为狸猫很重，我得先锻炼颈部肌肉，才能把狸猫绑在头上。";
				next;
				mes "[Lee Hester]";
				mes "所以在进行真正实验前，我当然需要一只练习用狸猫戴在头上。";
				next;
				mes "[Lee Hester]";
				mes "这就是我发明“懒洋洋的狸猫”帽子的经过。";
				next;
				mes "[Lee Hester]";
				mes "我需要的材料是……";
				mes "1000 个^ff0000橡果^000000，";
	mes "100 个^ff0000海獭毛皮^000000和";
				mes "10 片^ff0000浣熊叶^000000。";
				close;
			}
		case 4:
			if (countitem(624) > 0 && countitem(959) > 299 && countitem(551) > 49 && countitem(1023) > 0 && countitem(938) > 99) {
				mes "[Lee Hester]";
				mes "啊……";
				mes "你把材料都带来了。";
				mes "太好了！给我一点时间用这些鱼制作“蓝鱼”帽子。";
				next;
				mes "*Scratch scratch...*";
				next;
				mes "*Scratch scratch...*";
				mes "*Tap tap...*";
				next;
				mes "*Scratch scratch...*";
				mes "*Tap tap...*";
				mes "*Scratch scratch...*";
				next;
				mes "^3355FFHmm...";
				mes "这听起来不像制作帽子的声音……^000000";
				next;
				mes "[Lee Hester]";
				mes "哦，别担心。马上就完成了。";
				next;
				mes "*嗖嗖嗖……*";
				next;
				mes "*嗖嗖嗖……*";
				mes "*Chomp chomp...*";
				next;
				mes "*嗖嗖嗖……*";
				mes "*Chomp chomp...*";
				mes "*Wataaaaa~!*";
				next;
				mes "[Lee Hester]";
				mes "给你。*呼～*";
				mes "这是你自己的“蓝鱼”帽子，蕴含科学原理！沙漠之狼的爪子能留给我吗？嘿嘿，谢谢～";
				delitem 624,1; //Rotten_Fish
				delitem 959,300; //Rotten_Scale
				delitem 551,50; //Shusi
				delitem 1023,1; //Fish_Tail
				delitem 938,100; //Sticky_Mucus
				delitem 7030,1; //Claw_Of_Desert_Wolf
				getitem 5065,1; //Fish_On_Head
				emotion ET_AHA;
				close;
			}
			else {
				mes "[Lee Hester]";
				mes "啊！我想到啦！";
				mes "要不要我为你做一顶……";
				mes "“蓝鱼”帽子？";
				next;
				mes "[Lee Hester]";
				mes "我知道把鱼戴在头上听起来不太妙，但听我说，其实很有道理。";
				next;
				mes "[Lee Hester]";
				mes "我在朱诺图书馆读《欢乐儿童科学》时，看到动物感到炎热时会在阳光下打盹。";
				next;
				mes "[Lee Hester]";
				mes "于是我想……";
				mes "不在阳光下打盹的动物一定从不觉得热？";
				next;
				mes "[Lee Hester]";
				mes "我决定用一种不怕阳光、永远不会屈服于阳光力量的完美生物来做帽子。";
				next;
				mes "[Lee Hester]";
				mes "我立刻开始工作，列出所有不在阳光下打盹的动物，再删掉我不喜欢的，尤其是名字很长的。";
				next;
				mes "[Lee Hester]";
				mes "最后名单上只剩三种生物：鸸鹋、长颈鹿和鱼。";
				next;
				mes "[Lee Hester]";
				mes "首先删掉鸸鹋，因为大家都说我拼错了。众所周知，长颈鹿帽子看起来很荒谬。所以我当然选择了鱼。";
				next;
				mes "[Lee Hester]";
				mes "朋友，这就是我发明“蓝鱼”帽子的经过。";
				next;
				mes "[Lee Hester]";
				mes "我需要的材料是：^ff00001条腐烂的鱼、300个腥臭鳞片、50个寿司、1条鱼尾^000000以及^ff0000100个黏稠液体^000000。";
				close;
			}
		case 5:
			mes "[Lee Hester]";
			mes "哦……我明白了。";
			mes "虽然有点失望，但你大概已经有能遮阳的漂亮帽子了。改变主意的话，我会在这里。";
			close;
		}
	}
	else {
		mes "[Lee Hester]";
		mes "今天不是个";
		mes "美好的日子吗？";
		next;
		mes "[Lee Hester]";
		mes "很美……";
		mes "但热得惊人。";
		mes "我住在这里，当然知道。不过没有什么比得上梦罗克的日落。";
		next;
		mes "[Lee Hester]";
		mes "这么多不同动物能生活在沙漠里真是神奇。我一直在朱诺图书馆读书，研究动物的习性……";
		next;
		mes "[Lee Hester]";
		mes "试图揭开动物王国应对高温的秘密。";
		next;
		mes "[Lee Hester]";
		mes "希望你在梦罗克过得愉快。如果怀疑动物的特殊能力，就想想能在严酷梦罗克沙漠中生存的雄伟沙漠之狼。";
		emotion ET_WRAP;
		close;
	}
}

// Kitsune Mask
//============================================================
pay_dun03,48,84,4	script	Nine Tails#Kitsune Mask	1180,1,1,{
	end;

OnInit:
	disablenpc "Nine Tails#Kitsune Mask";
	end;

OnTouch_:
	mes "[九尾狐]";
	mes "呜！呜呜！";
	mes "呜！呜呜！";
	next;
	if (select("摇头:点头") == 1) {
		mes "[九尾狐]";
		mes "呜！呜呜！";
		close2;
		set getvariableofnpc(.MyMobs1,"SpawnManager#Kitsune"),1;
		switch(rand(1,25)) {
		case 1: set .@x,118;	set .@y,66;	break;
		case 2: set .@x,103;	set .@y,194;	break;

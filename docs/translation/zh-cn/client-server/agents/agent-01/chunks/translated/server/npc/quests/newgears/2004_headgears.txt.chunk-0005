		mes "[Muscle Man]";
		mes "好，事情是这样的。";
		mes "带来^0000FF3000个时钟指针^000000和^0000FF1个尖叫先生^000000。";
		next;
		mes "[Muscle Man]";
		mes "有了这些，我至少能继续研究一段时间。正如我说的，我会用这个超棒的^0000FF闹钟面具^000000交换这些材料！";
		next;
		mes "[Muscle Man]";
		mes "现在！出发吧！";
		mes "让我们把对肌肉的热爱传播到全世界！";
		close;
	}
	mes "[Muscle Man]";
	mes "哦～！抱歉！！";
	mes "我一定是不小心绷紧了这条光荣的二头肌。";
	next;
	mes "[Muscle Man]";
	mes "我都忘了自己的身体有多么令人屏息。没关系，慢慢来，尽情享受视觉盛宴……";
	next;
	mes "[Muscle Man]";
	mes "不过听着，我需要：^0000FF3000个时钟指针^000000和^0000FF1个尖叫先生^000000。";
		mes "以便继续我的研究。";
	next;
	mes "[Muscle Man]";
	mes "正如我说的，我会用这个很酷的^0000FF闹钟面具^000000交换材料，还可以为你摆任何姿势。";
	next;
	mes "[Muscle Man]";
	mes "现在！出发吧！";
	mes "让我们把对肌肉的热爱传播到全世界！";
	close;

OnTimer4000:
	specialeffect EF_FLASHER;
	setnpcdisplay "Muscle Man#Alarm Mask", 748;
	disablenpc " #Alarm Mask Man1";
	disablenpc " #Alarm Mask Man2";
	disablenpc " #Alarm Mask Man3";
	disablenpc " #Alarm Mask Man4";
	specialeffect EF_CLAYMORE,AREA," #Alarm Mask Man1";
	specialeffect EF_CLAYMORE,AREA," #Alarm Mask Man2";
	specialeffect EF_CLAYMORE,AREA," #Alarm Mask Man3";
	specialeffect EF_CLAYMORE,AREA," #Alarm Mask Man4";
	stopnpctimer;
	end;
}


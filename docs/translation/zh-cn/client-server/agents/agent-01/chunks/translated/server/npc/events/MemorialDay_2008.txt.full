// Lauds
//============================================================
prontera,182,214,4	script	Lauds#Memorial	58,{
	if (Memorial08 < 1) {
		mes "[Mad Sago Lauds]";
		mes "嘿，哟！";
		mes "你在那里做什么！？";
		next;
		mes "[Mad Sago Lauds]";
		mes "你知道今天是什么日子吗！？";
		mes "这是非常重要的日子！";
		mes "必须牢记的重要日子！";
		next;
		mes "[Mad Sago Lauds]";
		mes "这是什么！？";
		emotion ET_SURPRISE;
		next;
		mes "[Mad Sago Lauds]";
		mes "你的毛巾呢！？";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "我的什么？";
		next;
		mes "[Mad Sago Lauds]";
		mes "没有毛巾，你怎么去旅行！？";
		next;
		mes "[Mad Sago Lauds]";
		mes "如果你以为这只是普通节日，我就不浪费口舌了。";
		mes "但如果你想向伟大的士兵致敬，我会帮你做好准备。";
		next;
		if (select("我想是吧……:你疯了吗？") == 2) {
			mes "[Mad Sago Lauds]";
			mes "好吧，那就毫无准备地去吧！";
			next;
			mes "[Mad Sago Lauds]";
			mes "^FF0000你会后悔的！^000000";
			close;
		}
		mes "[Mad Sago Lauds]";
		mes "太好了！";
		mes "那就仔细听我说。";
		next;
		mes "[Mad Sago Lauds]";
		mes "向阵亡士兵致敬前，必须装备妥当。";
		mes "没有毛巾你会迷路！";
		mes "把材料带给我，我就能为你制作毛巾。";
		next;
		mes "[Mad Sago Lauds]";
		mes "听好了。";
		mes "带来 ^FF000030 个布料和 20 个绒毛^000000。";
		set Memorial08,1;
		close;
	}

	else if (Memorial08 == 1) {
		if (countitem(1059) < 30 || countitem(914) < 20) {
			mes "[Mad Sago Lauds]";
			mes "这些是什么？还不够？！";
			mes "*叹气* 我真的要再告诉你一次吗？！";
			mes "带来 ^FF000030 个布料和 20 个绒毛^000000。";
			close;
		} else {
			mes "***疯狂萨戈·劳兹似乎在自言自语***";
			next;
			mes "[Mad Sago Lauds]";
			mes "那么，你带来毛巾材料了吗？";
			next;
			mes "[Mad Sago Lauds]";
			mes "很好，你把材料都带来了。";
			mes "我会按承诺为你制作记忆毛巾。";
			mes "请稍等。";
			next;
			mes "[Mad Sago Lauds]";
			mes "给你！";
			delitem 1059,30;
			delitem 914,20;
			getitem 6025,1;
			getnameditem 6025,strcharinfo(0);
			set Memorial08,2;
			close;
		}
	}
	
	else if (Memorial08 == 2) {
		mes "[Mad Sago Lauds]";
		mes "啊，你现在有一条蓬松的新毛巾了，我还在上面写了你的名字。";
		next;
		mes "[Mad Sago Lauds]";
		mes "你想踏上旅程，向纪念日致敬吗？";
		next;
		if (select("当然。:不了，我很忙。") == 2) {
			mes "[Mad Sago Lauds]";
			mes "如果有人决定在你家穿过一条公路，可别哭着来找我！";
			close;
		}
		mes "[Mad Sago Lauds]";
		mes "很好。顺便问问，你知道毛巾是做什么的吗？";
		next;
		mes "[Mad Sago Lauds]";
		mes "看来你只是带着它，却不明白它的意义。";
		mes "真遗憾！去和^FF0000普隆德拉的 Grast^000000 谈谈吧。";
		set Memorial08,3;
		close;
	}

	else if (Memorial08 == 3) {
		mes "[Mad Sago Lauds]";
		mes "你还在这里做什么？";
		mes "我叫你去和普隆德拉的 Grast 谈谈！";
		close;
	}

	else if (Memorial08 == 4 || Memorial08 == 5 || Memorial08 == 6) {
		mes "[Mad Sago Lauds]";
		mes "去帮助 Grast，然后再回来。";
		close;
	}

	else if (Memorial08 == 7) {
		mes "[Mad Sago Lauds]";
		mes "哦，你把它们全带来了。";
		mes "哈哈哈！";
		mes "哈哈哈哈哈哈！！！！咳咳";
		next;
		mes "[Mad Sago Lauds]";
		mes "请交给我。顺便谢谢你的辛劳。";
		mes "你从旅程中学到什么了吗？";
		mes "现在去参观普隆德拉 12 点方向的纪念牌。";
		next;
		mes "[Mad Sago Lauds]";
		mes "你说你刚才去过那里是什么意思？";
		next;
		mes "[Mad Sago Lauds]";
		mes "什么？为什么把垃圾给我！";
		mes "那些物品对我完全没用。";
		mes "你应该去纪念牌那里！";
		set Memorial08,8;
		close;
	}

	else if (Memorial08 == 8) {
		mes "[Mad Sago Lauds]";
		mes "别再试图把垃圾给我！";
		mes "去普隆德拉 12 点方向的纪念牌，开始你的旅程！";
		close;
	}
	
	else if (Memorial08 >= 9) {
		set .@RandomMsg, rand(1,5);
		if (.@RandomMsg == 1) {
			mes "[Mad Sago Lauds]";
			mes "不要惊慌！";
			emotion ET_SURPRISE;
			close;
		}
		else if (.@RandomMsg == 2) {
			mes "[Mad Sago Lauds]";
			mes "人生……就像葡萄柚。";
			mes "它橙色又柔软，里面有几颗籽，有些人早餐吃半个。";
			close;
		}
		else if (.@RandomMsg == 3) {
			mes "[Mad Sago Lauds]";
			mes "这个故事本来有重点，但暂时从编年史家的脑中溜走了。";
			close;
		}
		else if (.@RandomMsg == 4) {
			mes "[Mad Sago Lauds]";
			mes "42!";
			close;
		}
		else if (.@RandomMsg == 5) {
			mes "[Mad Sago Lauds]";
			mes "以为只靠土豆就能解决重大问题，是个错误。";
			close;
		}
	}
}
		
// Memorial Plaque
//============================================================
prontera,153,286,4	script	Memorial Plaque#Memorial	857,{
	if (Memorial08 < 8) {
		mes "[" + strcharinfo(0) + "]";
		mes "- 这是一块布满灰尘的旧纪念牌。-";
		close;
	}
	
	else if (Memorial08 == 8) {
		mes "[" + strcharinfo(0) + "]";
		mes "-这是一块落满灰尘的旧牌匾。-";
		mes "‘这一定就是 Lauds 说的东西。’";
		mes "‘用毛巾把它擦干净吧。’";
		next;
		set Memorial08,9;
		getexp 93750,43750;
		goto L_CleanPlaque;
	}
	
	else if (Memorial08 >= 9) {
		goto L_CleanPlaque;
	}
	
	L_CleanPlaque:
		mes "- 你看到清洁后的纪念牌上有一段话。-";
		next;
		mes "-虽然没有雕刻的大理石纪念他们，-";
		mes "-也没有铭刻的石碑记录他们的功绩，-";
		mes "-但他们的记忆将与他们所敬爱的土地一样长存。-";
		mes "-丹尼尔·韦伯斯特-";
		if (Memorial08 == 9) {
			getexp 93750,43750;
		}
		next;
		mes "-还有另一段话。-";
		next;
		mes "-我也许没有去到原本想去的地方，-";
		mes "-但我想我最终到达了应该到达的地方。-";
		mes "-道格拉斯·亚当斯。-";
		if (Memorial08 == 9) { 
			getexp 93750,43750;
		}
		next;
		mes "-这是最后一段话。-";
		next;
		mes "-真正的英雄主义非常冷静，毫不戏剧化。-";
		mes "-它不是不惜一切代价超越他人的冲动，-";
		mes "-而是不惜一切代价服务他人的冲动。-";
		mes "-阿瑟·阿什-";
		if (Memorial08 == 9) { 
			getexp 93750,43750;
			set Memorial08,10;
		}
		close;
}

// Grast
//============================================================
prontera,150,270,4	script	Grast#Memorial	900,{
	if (Memorial08 < 3) {
		mes "[Grast]";
		mes "纪念日既悲伤又光荣。";
		mes "不知道还有多少人记得他们……";
		close;
	}
	
	else if (Memorial08 == 3) {
		mes "[Grast]";
		mes "哦，那不是记忆毛巾吗？";
		mes "很高兴遇到理解纪念日意义的人。";
		next;
		mes "[Grast]";
		mes "了解我们今天庆祝什么非常重要，你说对吗？";
		next;
		mes "[Grast]";
		mes "如果想踏上纪念日致敬之旅，请带来我要求的材料。";
		next;
		mes "[Grast]";
		mes "请带来 ^FF0000红色药水、绿色药水、觉醒药水和蝴蝶翅膀各一个^000000。";
		mes "我会等你回来。";
		set Memorial08,4;
		close;
	}

	else if (Memorial08 == 4) {
		if (countitem(501) < 1 || countitem(506) < 1 || countitem(656) < 1 || countitem(602) < 1) {
			mes "[Grast]";
			mes "糟糕，你没有带齐材料。";
			mes "请确认你带来了";
			mes "^FF0000红色药水、绿色药水、觉醒药水和蝴蝶翅膀各一个^000000。";
			next;
			mes "[Grast]";
			mes "之后还要带来更多材料。";
			mes "如果觉得收集全部材料负担太重，";
			mes "我可以提供所有材料。";
			next;
			if (select("我去收集剩下的。:把材料给我。") == 2) {
				goto L_GiveUp;
			}
			goto L_Continue;
		} else {
			mes "[Grast]";
			mes "哦，你带来了我要求的材料。";
			next;
			mes "[Grast]";
			mes "嗯，你还需要一些东西……";
			next;
			mes "[Grast]";
			mes "请带来 ^FF0000陷阱、世界树叶、蓝色魔力矿石、水晶镜、肉和胡萝卜各一个^000000。";
			mes "我会等你回来。";
			set Memorial08,5;
			close;
		}
	}
	
	else if (Memorial08 == 5) {
		if (countitem(1065) < 1 || countitem(610) < 1 || countitem(717) < 1 || countitem(747) < 1 || countitem(517) < 1 || countitem(515) < 1) {
			mes "[Grast]";
			mes "糟糕，你没有带齐材料。";
			mes "请确认你带来了";
			mes "^FF0000陷阱、世界树叶、蓝色魔力矿石、水晶镜、肉和胡萝卜各一个^000000。";
			next;
			mes "[Grast]";
			mes "之后还要带来更多材料。";
			mes "如果觉得收集全部材料太辛苦，我可以提供所有材料。";
			next;
			if (select("我去收集剩下的。:把材料给我。") == 2) {
				goto L_GiveUp;
			}
			goto L_Continue;
		} else {
			mes "[Grast]";
			mes "哦，你带来了我要求的一切。";
			mes "嗯，我想你还需要一点东西。";
			next;
			mes "[Grast]";
			mes "请带来 ^FF0000宠物孵化器、爆竹、波利玩偶和花束各一个^000000。";
			set Memorial08,6;
			close;
		}
	}
	
	else if (Memorial08 == 6) {
		if (countitem(643) < 1 || countitem(12018) < 1 || countitem(741) < 1 || countitem(745) < 1) {
			mes "[Grast]";
			mes "糟糕，你没有带齐材料。";
			mes "请确认你带来了";
			mes "^FF0000宠物孵化器、爆竹、波利玩偶和花束各一个";
			next;
			mes "[Grast]";
			mes "这是最后一批材料。";
			mes "如果觉得收集全部材料太辛苦，我可以提供所有材料。";
			next;
			mes "[Grast]";
			mes "不过如果我提供全部材料，就不必感谢你的服务了。";
			mes "由你决定，"+strcharinfo(0)+"。";
			next;
			if (select("我去收集剩下的。:把材料给我。") == 2) {
				goto L_GiveUp;
			}
			goto L_Continue;
		} else {
			mes "[Grast]";
			mes "你带来我要求的材料了吗？";
			mes "啊，谢谢你的辛劳，你把它们全带来了。";
			next;
			mes "[Grast]";
			mes "希望你在收集材料时学到宝贵的一课。";
			mes "我想送你一份小礼物，感谢你的服务。";
			next;
			mes "[Grast]";
			mes "看，我两只手里各有一份不同的礼物。";
			mes "最好是两份都给你，但……";
			mes "你想测试一下运气吗，"+strcharinfo(0)+"？";
			next;
			mes "[Grast]";
			mes "好，你想选哪只手？";
			next;
			if (select("左手。:右手。") == 2) {
				mes "[Grast]";
				mes "你选了我的右手。";
				mes "这是给你的礼物。";
				mes "现在请把这些材料带给 Lauds。";
				set Memorial08, 7;
				getitem 617,1;
				close;
			}
			mes "[Grast]";
			mes "你选了我的左手。";
			mes "这是给你的礼物。";
			mes "现在请把这些材料带给 Lauds。";
			set Memorial08, 7;
			getitem 12109,1;
			close;
		}
	}
	
	else if (Memorial08 == 7) {
		mes "[Grast]";
		mes "你见过 Lauds 了吗？";
		mes "希望你记住，自由和幸福建立在战争中牺牲的数千条生命之上。";
		close;
	}

	else if (Memorial08 >= 8) {
		mes "[Grast]";
		mes "毛巾大概是冒险者能拥有的最实用物品。";
		close;
	}

	L_GiveUp:
		mes "[Grast]";
		mes "哦，我明白了。你最近很忙吧？";
		mes "没问题，我会给你全部物资……";
		next;
		mes "[Grast]";
		mes "给你。";
		mes "我把所有物品压缩成更紧凑的形态。";
		mes "额外服务的谢意以后再说吧。";
		mes "请把它们带给 Lauds。";
		set Memorial08,7;
		getitem 7126,1;
		next;
		mes "[Grast]";
		mes "顺便说一句，他遭遇了不幸的事故，精神有些失常。";
		mes "即使他开始胡言乱语，也请不要惊慌。";
		close;
	
	L_Continue:
		mes "[Grast]";
		mes "这是个好主意。";
		mes "那我会等你回来。";
		close;
}

				mes "唉……真遗憾：你失败了。";
				next;
				mes "[Claytos Verdo]";
				mes "但我会再给你一次参加笔试的机会，";
				mes "努力学习后再回来。";
			}
			else {
				mes "真遗憾：你失败了。";
				next;
				mes "[Claytos Verdo]";
				mes "但我会再给你一次机会，";
				mes "更加努力学习后再回来。";
			}
		}
		close;
	}
	else if (SAGE_Q == 5) {
		mes "欢迎回来。";
		mes "这次努力学习了吗？";
		next;
		mes "[Claytos Verdo]";
		mes "笔试条件与上次相同。我会出 20 道题。";
		mes "每答对一题得 5 分，达到 80 分即可通过测试。";
		next;
		set sage_m2,rand(1,3);
		mes "[Claytos Verdo]";
		mes "好，不必等待。";
		mes "立即回答，否则我会让你再次失败。";
		set SAGE_Q,5;
		goto L_AskQuestions;
		end;
	}
	else if (SAGE_Q == 6) {
		mes "你还想要什么？！想再参加测试吗？";
		mes "你已经通过了！";
		next;
		mes "[Claytos Verdo]";
		mes "去找赫尔墨斯教授参加实践考试。";
		mes "快去！";
		close;
	}
	else if (SAGE_Q == 15) {
		mes "嘿嘿，看来你的论文完成了。";
		mes "但我不负责那部分测试。";
		next;
		mes "[Claytos Verdo]";
		mes "把论文提交给凯隆院长。";
		mes "他会决定你是否有资格毕业。";
		close;
	}
	else {
		mes "我太忙，没空负责笔试。";
		mes "之后再回来，我会抽时间交谈。";
		close;
	}
}

//Practical Examination Professer
yuno_in03,169,180,3	script	Practical Examination P	755,{
		mes "[赫尔墨斯·特里斯]";
	if (BaseJob != Job_Mage) {
		if (BaseJob == Job_Sage) {
			mes "欢迎。最近过得怎么样？";
			mes "看来你经历了不少艰难时刻……从外表就能看出来。";
			next;
		mes "[赫尔墨斯·特里斯]";
			mes "我知道探索危险地区很辛苦，但这会帮助你获得更多知识。";
			mes "书本知识永远比不上实践经验。";
			next;
		mes "[赫尔墨斯·特里斯]";
			mes "不过，独自深入地牢非常危险。";
			mes "最好找值得信赖的同伴。";
		}
		else if (BaseJob == Job_Novice) {
			mes "嘿嘿，这不是可爱的小初心者吗？";
			next;
		mes "[赫尔墨斯·特里斯]";
			mes "在卢恩-米德加尔特大陆，有许多尚未完全探索的未知地点和物品。";
			mes "怪物、神秘物品和神话英雄……";
			next;
		mes "[赫尔墨斯·特里斯]";
			mes "将来要不要考虑成为贤者？";
			mes "你会喜欢研究这个世界。";
			next;
		mes "[赫尔墨斯·特里斯]";
			mes "如果你决定这么做，我们会再见。";
			mes "保重，小家伙。";
		}
		else {
			mes "欢迎来到斯维切尔比尔魔法学院。";
			next;
		mes "[赫尔墨斯·特里斯]";
			mes "贤者更像学者，而不是魔法师。";
			mes "作为队伍成员，我们非常有用且强大。";
			next;
		mes "[赫尔墨斯·特里斯]";
			mes "下次试着和贤者组队。";
			mes "贤者带来的智慧会对队伍大有帮助……";
		}
		close;
	}
	if (SAGE_Q >= 0 && SAGE_Q <= 3) {
		mes "我是负责实践考试的赫尔墨斯教授。";
		mes "你是贤者职业的候选人吗？";
		next;
		mes "[赫尔墨斯·特里斯]";
		mes "先登记申请并参加笔试。";
		close;
	}
	else if (SAGE_Q == 4 || SAGE_Q == 5) {
		mes "我是负责实践考试的赫尔墨斯教授。";
		mes "你是贤者职业的候选人吗？";
		next;
		mes "[赫尔墨斯·特里斯]";
		mes "先通过克莱托斯教授的笔试。";
		mes "然后我会负责你。";
		close;
	}
	else if (SAGE_Q == 6) {
		mes "欢迎，你刚通过笔试，对吧？";
		mes "现在是实践考试时间。";
		next;
		mes "[赫尔墨斯·特里斯]";
		mes "这项考试没有困难或特别之处。";
		mes "只要在时限内杀死所有怪物。";
		next;
		mes "[赫尔墨斯·特里斯]";
		mes "与其听我讲 100 遍，不如亲自体验。";
		mes "怎么样？准备参加考试了吗？";
		next;
		if (select("是的。:抱歉，请给我一点时间。") == 1) {
			set SAGE_Q,7;
		mes "[赫尔墨斯·特里斯]";
			mes "很好，马上开始。";
			mes "尽力而为，安全回来！";
			close2;
			warp "job_sage",50,154;
			end;
		}
		set SAGE_Q,7;
		mes "[赫尔墨斯·特里斯]";
		mes "不用急……慢慢来，准备好再回来。";
		close;
	}
	else if (SAGE_Q == 7) {
		mes "再次欢迎！这次准备充分了吗？";
		mes "这不难。全力以赴，好吗？";
		next;
		mes "[赫尔墨斯·特里斯]";
		mes "准备好了吗？";
		next;
		if (select("是的。:抱歉，请给我一点时间。") == 1) {
		mes "[赫尔墨斯·特里斯]";
			mes "很好，马上开始。";
			mes "尽力而为，安全回来！";
			close2;
			warp "job_sage",50,154;
			end;
		}
		mes "[赫尔墨斯·特里斯]";
		mes "不用急……慢慢来，准备好再回来。";
		close;
	}
	else if (SAGE_Q == 8) {
		mes "干得好~既然你也通过了实践考试……";
		mes "我接受你的入学申请。";
		next;
		mes "[赫尔墨斯·特里斯]";
		mes "现在要决定你学习的科目……";
		mes "让我看看你的笔试成绩和实践考试用时。";
		next;
		mes "[赫尔墨斯·特里斯]";
		mes "嗯，嗯……我明白了。";
		mes "嗯……我觉得你可以。";
		next;
		switch(rand(1,3)) {
		case 1:
			set SAGE_Q,9;
			changequest 2046,2047;
		mes "[赫尔墨斯·特里斯]";
			mes "现在你将学习世界树。";
			mes "据说世界树是这个世界的生命之源。";
			next;
		mes "[赫尔墨斯·特里斯]";
			mes "这是很好的科目，能帮助我们认识世界的变化及其发展方向。";
			mes "去讲堂找萨菲恩教授求助。";
			next;
			mes "[赫尔墨斯·特里斯]";
			mes "祝你好运。";
			close;
		case 2:
			set SAGE_Q,11;
			changequest 2046,2048;
			mes "[赫尔墨斯·特里斯]";
			mes "现在你将学习怪物。";
			mes "这门研究旨在学习并了解大陆各处存在的生物。";
			next;
			mes "[赫尔墨斯·特里斯]";
			mes "这是很好的科目，会帮助你成为经验丰富的贤者。";
			mes "去怪物博物馆找卢修斯教授求助。";
			next;
			mes "[赫尔墨斯·特里斯]";
			mes "祝你好运。";
			close;
		case 3:
			set SAGE_Q,13;
			changequest 2046,2049;
			mes "[赫尔墨斯·特里斯]";
			mes "现在你将学习具有特定属性的魔法技能。";
			mes "这门研究旨在更好理解日常使用的基础魔法技能。";
			next;
			mes "[赫尔墨斯·特里斯]";
			mes "这是很好的科目，能帮助你深入理解魔法真理。";
			mes "去人体学实验室找阿贝西教授求助。";
			next;
			mes "[赫尔墨斯·特里斯]";
			mes "祝你好运。";
			close;
		}
	}
	else if (SAGE_Q == 9) {
		mes "嗯？你没听懂我的话吗？";
		mes "我让你研究世界树。";
		next;
		mes "[赫尔墨斯·特里斯]";
		mes "去讲堂找萨菲恩教授求助。";
		close;
	}
	else if (SAGE_Q == 11) {
		mes "嗯？你没听懂我的话吗？";
		mes "我让你研究怪物。";
		next;
		mes "[赫尔墨斯·特里斯]";
		mes "去怪物博物馆找卢修斯教授求助。";
		close;
	}
	else if (SAGE_Q == 13) {
		mes "嗯？你没听懂我的话吗？";
		mes "我让你研究具有特定属性的魔法。";
		next;
		mes "[赫尔墨斯·特里斯]";
		mes "去向阿贝西教授求助。他在身体学实验室。";
		close;
	}
	else if (SAGE_Q == 15) {
		mes "你在这里做什么？你不是应该去找凯隆院长吗？";
		mes "不过，让我看看你的论文也没坏处……";
		next;
		mes "[赫尔墨斯·特里斯]";
		mes "不过还是算了。去见凯隆院长吧。";
		close;
	}
	else {
		mes "抱歉，我现在很忙……";
		mes "有问题就去找我给你安排的教授。";
		close;
	}
}

yuno_in03,62,176,2	script	History Professor#sa	109,{
	mes "[Saphien Layless]";
	if (BaseJob != Job_Mage) {
		if (BaseJob == Job_Sage) {
			mes "我认识你吗？你是我的学生之一？";
			mes "不过没关系。不从学院毕业就不能成为贤者……";
			next;
			mes "[Saphien Layless]";
			mes "无论如何，必须研究过去，才能更好理解现在并预测……未来。";
			mes "这句话包含了世界的全部真理。";
			next;
			mes "[Saphien Layless]";
			mes "我想你走在正确的道路上……";
			mes "总有一天你会回望此刻，意识到它改变了你的人生。";
		}
		else if (BaseJob == Job_Novice) {
			mes "初心者？初心者为什么来这里？";
			next;
			mes "[Saphien Layless]";
			mes "你的生活有许多可能……";
			mes "你想怎样度过一生？";
			next;
			mes "[Saphien Layless]";
			mes "无论决定成为什么，一切都取决于你的选择。";
			mes "愿神祝福你，选择最适合自己的道路……";
		}
		else {
			mes "欢迎，我负责学院的历史研究。";
			next;
			mes "[Saphien Layless]";
			mes "我们所知的世界源于历史记录中的事件。正是历史塑造了今天的世界。";
			mes "因此，了解过去才能更好理解现在和……未来。";
			next;
			mes "[Saphien Layless]";
			mes "回顾你的过去。";
			mes "你会看到未来的道路……";
		}
		close;
	}
	if (SAGE_Q == 9) {
		if (SAGE_Q2 == 0) {
			mes "欢迎，" + strcharinfo(0) + "。很高兴见到你。";
			mes "我叫萨菲恩·莱利斯，接下来一段时间由我负责你的课程。";
			next;
			mes "[Saphien Layless]";
			mes "你学习的主题是世界树。";
			mes "那么……你知道世界树是什么吗？";
			next;
			switch(select("是的，我很清楚。:不，我不知道。")) {
			case 1:
				mes "[Saphien Layless]";
				mes "那么，世界树是什么？";
				mes "请回答。";
				next;
				switch(select("一种恢复道具的名称。:世界的生命之源。:骗你的，我撒谎了。")) {
				case 1:
					mes "[Saphien Layless]";
					mes "错了，" + strcharinfo(0) + "，扣 10 分。";
					mes "那只是世界树的恩赐之一。";
					next;
					mes "[Saphien Layless]";
					mes "世界树是一棵为这个世界提供生命之源的树。";
					break;
				case 2:
					mes "[Saphien Layless]";
					mes "没错。世界树，也就是所谓的‘世界树’，";
					mes "是这个世界生命之源的名字。";
					break;
				case 3:
					mes "[Saphien Layless]";
					mes "真是的……不知道就直说。";
					mes "顺便说，" + strcharinfo(0) + "，你因撒谎和答错扣 10 分。";
					break;
				}
				next;
				break;
			case 2:
				mes "[Saphien Layless]";
				mes "好吧，我本以为你至少知道一点世界树……";
				mes "世界树是这个世界生命之源的树。";
				next;
				break;
			}
			mes "[Saphien Layless]";
			mes "开始课程前，我需要一些辅助物品。";
			mes "这样能更好理解世界树。";
			next;
			mes "[Saphien Layless]";
			mes "只要和世界树有关，什么都行。";
			mes "树的种子或果实都可以。我知道很难找，但请试试。";
			next;
			set SAGE_Q2,1;
			changequest 2047,2050;
			mes "[Saphien Layless]";
			mes "准备好辅助物品后，我们就开始课程。";
			mes "请回来。";
			close;
		}
		else {
			if (countitem(607) > 0) {
				mes "[Saphien Layless]";
				mes "哦，你带来了吗？太好了！";
				mes "你带来了世界树果实！";
				next;
				mes "[Saphien Layless]";
				mes "好，现在开始上课。";
				mes "仔细听，我不允许课堂上打瞌睡。";
				next;
			}
			else if (countitem(608) > 0) {
				mes "[Saphien Layless]";
				mes "嗯，准备好上课了吗？让我看看……";
				mes "哦！你带来了世界树种子？";
				next;
				mes "[Saphien Layless]";
				mes "很好。现在开始上课。";
				mes "仔细听，我不允许课堂上打瞌睡。";
				next;
			}
			else if (countitem(610) > 0) {
				mes "[Saphien Layless]";
				mes "嗯，准备好上课了吗？让我看看……";
				mes "世界树叶……";
				next;
				mes "[Saphien Layless]";
				mes "这个物品可以在艾尔迪巴兰购买！你一点努力都没做。";
				mes "所以，" + strcharinfo(0) + "，扣 10 分。";
				next;
				mes "[Saphien Layless]";
				mes "好，现在开始上课。";
				mes "仔细听，不准课堂上打瞌睡或偷懒。";
				next;
			}
			else {
				mes "[Saphien Layless]";
				mes "嗯？你还没准备好上这节课！";
				mes "我说过要带来和世界树有关的物品。";
				next;
				mes "[Saphien Layless]";
				mes "准备好后告诉我。";
				mes "不用担心迟到，我们教授就是拿工资等人的。";
				close;
			}
			mes "[Saphien Layless]";
			mes "这个世界的根源世界树是一棵巨树。";
			mes "它扎根于卢恩-米德加尔特大陆，枝叶直达天空。";
			next;
			mes "[Saphien Layless]";
			mes "大陆之外有一片海洋，巨蛇耶梦加得盘踞其中。";
			mes "我们所知的世界由三处组成：阿斯加德、中庭和乌特加德。";
			next;
			mes "[Saphien Layless]";
			mes "乌特加德是泰坦居住的地方。";
			next;
			mes "[Saphien Layless]";
			mes "中庭是人类居住的地方。";
			next;
			mes "[Saphien Layless]";
			mes "阿斯加德则是众神居住的地方……";
			mes "扎根于卢恩-米德加尔特大陆中央的白蜡树，就是世界树。";
			next;
			mes "[Saphien Layless]";
			mes "这片大陆诞生于尤弥尔之心，世界树用三根树根抓住大陆使其保持完整。";
			mes "这些树根延伸到三个不同地方。";
			next;
			mes "[Saphien Layless]";
			mes "第一根树根通往众神居住的阿斯加德，";
			mes "那里是我们人类尚未探索或体验的地方。";
			next;
			mes "[Saphien Layless]";
			mes "第二根树根通往巨人居住的约顿海姆。";
			mes "我们从神话和传说中无数次听到这个名字。";
			next;
			mes "[Saphien Layless]";
			mes "第三根树根通往尼弗尔海姆。";
			mes "据说那里被浓厚的黑雾覆盖。";
			next;
			mes "[Saphien Layless]";
			mes "世界树种子、世界树果实和世界树叶等物品，";
			mes "都被认为是世界树的一部分。";
			next;
			mes "[Saphien Layless]";
			mes "据说世界树果实有迷人的香气，";
			mes "可以一次恢复全部 HP 和 SP。";
			next;
			mes "[Saphien Layless]";
			mes "世界树种子有花香和坚果味，据说可以";
			mes "一次恢复一半 HP 和 SP。";
			next;
			mes "[Saphien Layless]";
			mes "充满生命力的世界树叶据说可以";
			mes "复活死者，将他们带回这个世界。";
			next;
			mes "[Saphien Layless]";
			mes "最后……如果将来你偶然发现通往阿斯加德的道路，";
			mes "希望你能找到世界树。";
			next;
			mes "[Saphien Layless]";
			mes "尽管世界树的故事只存在于神话传说中，";
			mes "我们贤者仍有义务发现世界树的真相。";
			next;
			mes "[Saphien Layless]";
			mes "今天的课程到此结束。";
			mes "请记录今天学到的内容，并尽量记住。";
			next;
			mes "[Saphien Layless]";
			mes "下一节课你要写一篇关于世界树的论文……";
			mes "请带来以下物品准备上课。";
			next;
			mes "[Saphien Layless]";
			mes "^3355FF1 根鸟羽毛^000000，用作笔，";
			mes "^3355FF1 1 张兽皮^000000，用作纸张，";
			mes "^3355FF1 1 根树枝^000000，用于装订书籍，";
			mes "^3355FF1 1 瓶鱿鱼墨水^000000，用作墨水，";
			mes "^3355FF1 1 个空瓶^000000，用来装鱿鱼墨水。";
			next;
			set SAGE_Q2,0;
			set SAGE_Q,10;
			changequest 2050,2051;
			mes "[Saphien Layless]";
			mes "准备好这些物品后，我会帮你写论文。";
			mes "期待与你一起上下一节课。";
			close;
		}
	}
	else if (SAGE_Q == 10) {
		if (countitem(916) > 0 && countitem(919) > 0 && countitem(1019) > 0 && countitem(1024) > 0 && countitem(713) > 0) {
			delitem 916,1; //Feather_Of_Birds
			delitem 919,1; //Animal's_Skin

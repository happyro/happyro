	else if (ep13_3_secret == 21) {
		mes "[赫斯兰塔]";
		mes "啊，抱歉。";
		mes "我刚才在思考。";
		mes "裂缝……催眠……还有你给我看的证据。";
		next;
		mes "[赫斯兰塔]";
		mes "我不知道你为什么认为阿哈特是人类，";
		mes "这也可能是他法术的一部分。";
		next;
		mes "[赫斯兰塔]";
		mes "他施放法术的原因……";
		mes "是为了清理裂缝附近的痕迹。";
		mes "而且他选择了非萨帕族的你……";
		next;
		mes "[赫斯兰塔]";
		mes "因为我们萨帕族不能知道裂缝的痕迹。";
		mes "也就是说，阿哈特正在……";
		mes "^4d4dff清理从裂缝开始的痕迹^000000。";
		next;
		select("从裂缝中抹去他自己的痕迹！！");
		mes "[赫斯兰塔]";
		mes "是的。";
		mes "他在试图掩盖与裂缝有关的某件事。";
		mes "但那究竟是什么？";
		next;
		mes "[赫斯兰塔]";
		mes "阿哈特最初在裂缝附近被发现时，^4d4dff没有任何记忆^000000。";
		mes "这不是很奇怪吗？";
		next;
		mes "[赫斯兰塔]";
		mes "听完你的故事，我越来越怀疑了。";
		mes "但我无法认同这个故事的原因是……";
		next;
		mes "[赫斯兰塔]";
		mes "阿哈特是纯粹的。";
		mes "他确实在为萨帕族和迪卡斯特斯工作。";
		next;
		select("那你为什么要调查阿哈特？");
		mes "[赫斯兰塔]";
		mes "阿哈特忠诚于萨帕族，也为萨帕族群做出了出色的工作，但是……";
		next;
		mes "[赫斯兰塔]";
		mes "拉维尔受到其他萨帕族的信任和爱戴，";
		mes "正把迪卡斯特斯的权力集中到一个地方。";
		next;
		mes "[赫斯兰塔]";
		mes "权力集中到了阿哈特身上。";
		mes "而权力本应在各部门之间均匀分配。";
		next;
		mes "[赫斯兰塔]";
		mes "这样大家才能互相监督和检查……";
		mes "各自尽力，不走上错误的道路，";
		mes "我们才能共同生活下去。";
		next;
		mes "[赫斯兰塔]";
		mes "但如果权力集中到一个地方并被错误使用呢？";
		mes "所有行政事务都由阿哈特决定。那他只要点头或摇头，就能做些什么？";
		next;
		mes "[赫斯兰塔]";
		mes "我害怕的就是这个。";
		mes "他很美丽，但美丽往往伴随着荆棘。";
		next;
		mes "[赫斯兰塔]";
		mes "阿哈特渐渐成为了中心。";
		mes "如果他手里拿的不是面包，而是一把剑……";
		mes "……";
		next;
		mes "[赫斯兰塔]";
		mes "我太感情用事了。";
		mes "抱歉。";
		mes "听了你的故事后，我的思绪变得很复杂。";
		next;
		select("你知道切希尔吗？");
		mes "[赫斯兰塔]";
		mes "你是说那个助手？";
		mes "我知道，但大多数萨帕族不知道。";
		mes "阿哈特身边的每个人都知道切希尔。";
		next;
		mes "[赫斯兰塔]";
		mes "^4d4dff切希尔是阿哈特带来的猫族^000000。";
		mes "阿哈特照顾受伤的切希尔，并把他带在身边。";
		mes "这里到处都有猫，所以我们没太在意他。";
		next;
		mes "[赫斯兰塔]";
		mes "因为这片土地是他们的第二故乡。";
		mes "其他地方也许还生活着别的猫族。";
		mes "但他总是用头巾遮住脸，因为他的外表和萨帕族不同。";
		next;
		mes "[赫斯兰塔]";
		mes "不过，你为什么问这个？";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "没什么。";
		mes "我只是个人有些好奇。";
		mes "你现在打算做什么？";
		next;
		mes "[赫斯兰塔]";
		mes "我会继续监视阿哈特。";
		mes "直到我知道真相为止。";
		next;
		mes "赫斯兰塔思考时，你试着总结刚才和他的谈话。";
		next;
		while (1) {
			if (.@yes == 5) {
				mes "[" + strcharinfo(0) + "]";
				mes "总结一下。";
				mes "偷走报告的人是切希尔。";
				mes "切希尔是阿哈特的仆人，他们和裂缝有关。";
				mes "他们试图在裂缝处隐藏某件事或某个人，";
				mes "而裂缝是邪恶领主梦罗克创造的！";
				next;
				mes "[" + strcharinfo(0) + "]";
				mes "阿哈特就是邪恶领主？";
				mes "不……";
				mes "这难以置信。";
				next;
				mes "[" + strcharinfo(0) + "]";
				mes "我必须回远征营地向多哈报告！";
				set ep13_3_secret, 22;
				setquest 7203;
				close;
			}
			else if (.@yes == 0) {
				mes "[" + strcharinfo(0) + "]";
				mes "首先，报告的罪魁祸首是……";
				next;
					switch (select("切希尔:阿哈特:BK")) {
					case 1:
						mes "[" + strcharinfo(0) + "]";
						mes "是切希尔。";
						mes "切希尔是猫族。";
						mes "他戴头巾是为了遮住耳朵。";
						set .@yes, .@yes + 1;
						break;
					case 2:
						mes "[" + strcharinfo(0) + "]";
						mes "阿哈特？不可能是他。";
						mes "阿哈特与目击者提供的信息不符。";
						mes "我们重新想想。";
						break;
					case 3:
						mes "[" + strcharinfo(0) + "]";
						mes "BK？";
						mes "胡说。";
						mes "我们重新想想。";
						break;
				}
				next;
			}
			else if (.@yes == 1) {
				mes "[" + strcharinfo(0) + "]";
				mes "切希尔为什么要偷走报告？";
				next;
				if (select("不知道。:让三国之间的冲突恶化") == 1) {
					mes "[" + strcharinfo(0) + "]";
					mes "目前我们不知道真正的原因。";
					mes "但切希尔能从中得到什么？";
				}
				else {
					mes "[" + strcharinfo(0) + "]";
					mes "为了挑起三国之间的冲突？";
					mes "切希尔能从中得到什么？";
				}
				set .@yes, .@yes + 1;
				next;
			}
			else if (.@yes == 2) {
				mes "[" + strcharinfo(0) + "]";
				mes "切希尔的主人是阿哈特。";
				mes "所以他的一切行动都是为了……";
				next;
				if (select("切希尔在自行策划。:一定是阿哈特在命令他。") == 1) {
					mes "[" + strcharinfo(0) + "]";
					mes "切希尔自作主张？";
					mes "你确定吗？";
				}
				else {
					mes "[" + strcharinfo(0) + "]";
					mes "是的，一定是阿哈特命令他的。";
					mes "但阿哈特为什么要这么做？";
					mes "为了三国冲突？还是为了报告内容？";
					set .@yes, .@yes + 1;
				}
				next;
			}
			else if (.@yes == 3) {
				mes "[" + strcharinfo(0) + "]";
				mes "我们想想阿哈特。";
				mes "阿哈特来自裂缝。";
				mes "在那之前没有任何记录。";
				next;
				mes "[" + strcharinfo(0) + "]";
				mes "他还试图抹去裂缝附近发现的所有痕迹。";
				mes "而阿哈特想要消灭……";
				next;
				if (select("阿哈特自己。:因为裂缝而针对梦罗克？") == 1) {
					mes "[" + strcharinfo(0) + "]";
					mes "是的，阿哈特可能就是他自己的痕迹。";
					mes "萨帕族想隐藏某件事，所以才雇用了我，";
					mes "一个不属于任何势力、可以被当作傀儡来替他们做脏活的人。";
				}
				else {
					mes "[" + strcharinfo(0) + "]";
					mes "虽然有些夸张，但我们不能排除邪恶领主梦罗克。";
					mes "因为裂缝正是邪恶领主梦罗克亲手创造的。";
				}
				set .@yes, .@yes + 1;
				next;
			}
			else if (.@yes == 4) {
				mes "[" + strcharinfo(0) + "]";
				mes "阿哈特、裂缝，还有梦罗克……";
				mes "我能看出他们之间有关联，但无法确定具体是什么。";
				mes "而在远征报告中……";
				next;
				if (select("三国冲突的内容……:关于邪恶领主梦罗克的内容……") == 1) {
					mes "[" + strcharinfo(0) + "]";
					mes "里面有关于三国冲突的内容……";
					mes "但是……我觉得这些对不上？";
					mes "我们再想想。";
				}
				else {
					mes "[" + strcharinfo(0) + "]";
					mes "是的，有一份由紫苑带领的追踪队报告。";
					mes "内容是关于邪恶领主梦罗克的。";
					set .@yes, .@yes + 1;
				}
				next;
			}
			else {
				mes "[" + strcharinfo(0) + "]";
				mes "糟糕，我不知道。";
				mes "我们再想想。";
				set .@yes, 0;
				next;
			}
		}
	}
	else if (ep13_3_secret == 22) {
		cutin "ep13_heslanta",2;
		mes "[赫斯兰塔]";
		mes "你做出了决定。";
		mes "你现在打算做什么？";
		mes "如果可以，请帮助阿哈特并密切留意他。";
		next;
		mes "[赫斯兰塔]";
		mes "一旦他成为威胁，我会做好与他对峙的准备。";
		mes "这是我现在能做的最好选择。";
		next;
		mes "[赫斯兰塔]";
		mes "我只希望不要发生悲伤的事。";
		mes "……";
		next;
		mes "[赫斯兰塔]";
		mes "抱歉占用了你的时间。我现在送你出去。";
		mes "今天和你交谈很愉快。";
		next;
		switch (select("我也是。")) {
		}
		mes "[赫斯兰塔]";
		mes "让我们对这次会面保密，好吗？";
		mes "哈哈哈。";
		close2;
		warp "dic_in01",144,188;
		cutin "",255;
		end;
	}
	set .@yessay, rand(1,3);
	if (.@yessay == 1) {
		mes "[赫斯兰塔]";
		mes "今天工作太多，我非常疲惫。";
		mes "拉维尔只能偏袒阿哈特，因为这些事都是他一个人完成的。";
		next;
		mes "[赫斯兰塔]";
		mes "我也必须尽力。";
		mes "我不想在任何方面输给阿哈特。";
		mes "我是说，各个方面。";
		close;
	}
	else if (.@yessay == 2) {
		mes "[赫斯兰塔]";
		mes "阿哈特有时会和切希尔一起散步。";
		mes "他们不会走远，但经常在黎明时分去乔尔希森林。";
		next;
		mes "[赫斯兰塔]";
		mes "如果你运气好，就能看到他散步。";
		mes "如果能满足你的好奇心，切希尔散步时穿的是便服。";
		close;
	}
	mes "[赫斯兰塔]";
	mes "你总是忙忙碌碌的。";
	mes "我一直在监视阿哈特。";
	mes "你觉得我是不是做得太过分了？";
	next;
	mes "[赫斯兰塔]";
	mes "不，我希望是我错了。";
	mes "但这种莫名的不安让我更加怀疑阿哈特。";
	next;
	mes "[赫斯兰塔]";
	mes "开始怀疑某个人是很悲惨、很难过的事。";
	mes "如果永远无法和任何人分享这份悲伤，就更糟了。";
	next;
	if (select("你没事。:那现在放弃吧。") == 1) {
		mes "[赫斯兰塔]";
		mes "真的吗？";
		mes "我感觉好多了。";
		mes "这就叫宠溺，对吧？";
		close;
	}
	mes "[赫斯兰塔]";
	mes "抱歉。";
	mes "我一定占用了你很多时间。";
	mes "我必须变得更坚强。";
	close;
}

dicastes01,223,190,1	script	Calyon#pa8029	453,{
	if (checkweight(1201,1) == 0) {
		mes "你拥有的物品种类太多了。减少物品种类后再试吧。";
		close;
	}
	if (MaxWeight - Weight < 1000) {
		mes "由于物品太重，无法继续。减轻负重后再试吧。";
		close;
	}
	if (!isequipped(2782)) {
		mes "……";
		mes "……";
		next;
		mes "你什么都听不懂，我实在没信心和你说话。";
		close;
	}
	if (ep13_3_invite < 6) {
		mes "即使你试图交谈，萨帕族也与你保持距离。看来他叫来了加尔滕守卫。该走了。";
		close;
	}
	mes "[Calyon]";
	if (BaseLevel < 80) {
		mes "哈哈，训练得更好后再回来吧。我没有适合你的委托。";
		close;
	}
	if (checkquest(12163,PLAYTIME) == 2) {
		mes "去行动部找^800080运输部第一科经理^000000结算委托，再回来。";
		close;
	} else if (checkquest(12163,PLAYTIME) != -1) {
		mes "今天的工作结束了。你可以回行动部向^800080运输部第一科经理^000000报告。祝你好运。";
		close;
	}
	mes "欢迎。";
	mes "你来这里做什么？";
	next;
	if(select("请向我说明委托。", "请给我一个委托。") == 1) {
		mes "[Calyon]";
		mes "运输部第一科和第二科";
		mes "会带来";
		mes "这里没有的";
		mes "稀有物品。";
		next;
		mes "[Calyon]";
		mes "这是一个重要部门，";
		mes "也是获取丰富物资的";
		mes "关键部门，";
		mes "主要物资来自米德加尔特大陆。";
		next;
		mes "[Calyon]";
		mes "准备好后";
		mes "随时来找我。";
		close;
	}
	mes "[Calyon]";
	mes "最后，我有一项委托给你。这件事很重要，所以请你集中精神。";
	next;
	set .@calyonrequest,rand(1,11);
	mes "[Calyon]";
	if (.@calyonrequest == 1) {
		setquest 12139;
		setquest 12163;
		mes "最近，大臣正在寻找米德加尔特的特产——不凋零的玫瑰。";
		mes "不知道是不是要当礼物，但有人见过他把它戴在头上炫耀。";
		next;
		mes "[Calyon]";
		mes "所以……我知道这个要求有些困难，但请带给我 1 朵不凋零的玫瑰。这只是你我之间的事。";
		next;
		mes "你接到了名为^800080品味的尊重^000000的委托。";
	} else if (.@calyonrequest == 2) {
		setquest 12137;
		setquest 12163;
		mes "工业研究中心正在研究高效提炼钙矿的方法，但总是缺少测试材料。";
		next;
		mes "[Calyon]";
		mes "我听说冒险者之城有商人出售玻璃管。我需要 4 个。";
		next;
		mes "你接到了名为^800080实验工具^000000的委托。";
	} else if (.@calyonrequest == 3) {
		setquest 12138;
		setquest 12163;
		mes "酒馆老板说他想送礼物给所有常来的萨帕族客人。";
		next;
		mes "[Calyon]";
		mes "但他不知道该送什么。如果你在米德加尔特看到有趣的礼物，能带回 5 个吗？";
		next;
		mes "你接到了名为^800080精美礼物样本^000000的委托。";
	} else if (.@calyonrequest == 4) {
		setquest 12140;
		setquest 12163;
		mes "这是酒馆老板的委托。他说不能给常客使用一次性的叶盘。";
		next;
		mes "[Calyon]";
		mes "他想要 15 个米德加尔特产的坚固白瓷。";
		next;
		mes "你接到了名为^800080常客礼遇^000000的委托。";
	} else if (.@calyonrequest == 5) {
		setquest 12141;
		setquest 12163;
		mes "我有一个私人请求。我听说米德加尔特有一种圆形透明工艺品。";
		mes "我想那叫玻璃珠。";
		next;
		mes "[Calyon]";
		mes "这里也有类似的制品，但比不上那里的精致球体。";
		mes "请给我拿 10 个。";
		next;
		mes "你接到了名为^800080特殊包裹^000000的委托。";
	} else if (.@calyonrequest == 6) {
		setquest 12142;
		setquest 12163;
		mes "嗯……我不知道该怎么说。大臣正在请求米德加尔特的玩偶。";
		mes "我不知道那是什么，但既然是大臣要的，一定有非常重要的用途。";
		next;
		mes "[Calyon]";
		mes "请带回 15 个。";
		next;
		mes "你接到了名为^800080危险委托^000000的委托。";
	} else if (.@calyonrequest == 7) {
		setquest 12143;
		setquest 12163;
		mes "我听说这里很多同事都在追捧一种潮流，那是用米德加尔特的鸟嘴制作的音乐饰品。";
		next;
		mes "[Calyon]";
		mes "我想在行动部大楼内分发。";
		mes "你能买回 50 个吗？";
		next;
		mes "你接到了名为^800080奇怪潮流^000000的委托。";
	} else if (.@calyonrequest == 8) {
		setquest 12144;
		setquest 12163;
		mes "酒馆老板说想用一种叫蛤蜊壳的东西装饰酒馆。";
		mes "请带回大约 50 个。";
		next;
		mes "[Calyon]";
		mes "我不知道他会怎么使用，但他认识了许多冒险者后，品味确实很独特。";
		next;
		mes "你接到了名为^800080未知用途^000000的委托。";
	} else if (.@calyonrequest == 9) {
		setquest 12145;
		setquest 12163;
		mes "我们没有自己的料理，但许多冒险者似乎很享受饮食的乐趣。";
		mes "所以酒馆老板需要为新料理准备盘子。";
		next;
		mes "[Calyon]";
		mes "他要 20 个螃蟹壳。";
		mes "我不知道你能在哪里找到，但……祝你好运。";
		next;
		mes "你接到了名为^800080异世界料理^000000的委托。";
	} else if (.@calyonrequest == 10) {
		setquest 12146;
		setquest 12163;
		mes "我认为米德加尔特最有用的物品是斯凯尔。";
		next;
		mes "[Calyon]";
		mes "用斯凯尔填补建筑物的裂缝或洞口，再混合研磨的加勒结涂抹上去，就能快速简单地修缮建筑。";
		mes "你能带回 30 个吗？";
		next;
		mes "你接到了名为^800080填补裂缝^000000的委托。";
	} else if (.@calyonrequest == 11) {
		setquest 12147;
		setquest 12163;
		mes "加勒结是建筑维护材料。";
		mes "它是建筑中最重要的材料之一。";
		next;
		mes "[Calyon]";
		mes "在有加勒结之前，我们会研碎并使用扎贡，但现在很难找到。";
		mes "请带回 40 个。";
		next;
		mes "你接到了名为^800080黏合材料^000000的委托。";
	}
	mes "打开^800080任务窗口^000000即可查看委托详情和报告对象。";
	close;
}


			mes "不可能让它飞起来。因此使用一种叫^ff0000符文机关^000000的放大器。";
			next;
			select("呃？什么是符文机关？");
			mes "[Tarlock]";
			mes "那是以魔法石为能源的装置。不过我不知道具体原理……大概因为当时没认真听，细节忘了。";
			next;
			mes "[Tarlock]";
			mes "我只记得能量通过安装在蒸汽机上的符文时会被放大。";
			next;
			mes "[Tarlock]";
			mes "事实上，这艘飞艇全靠魔法石提供的力量漂浮，毫不夸张。它的力量非常强。";
			next;
			specialeffect2 EF_MAPPILLAR;
			mes "[Tarlock]";
			mes "明白了吗？我休息一会儿。读写那些长信让我很累。";
			completequest 8035;
			lght_air = 7;
			if (checkre(3))
				getexp 20000,1000;
			else
				getexp 200000,10000;
		} else if (lght_air == 7) {
			mes "我不是教过你了吗？这么长的故事我不想再讲！";
		} else if (lght_air == 2 || lght_air == 3) {
			mes "哈哈哈！别担心，把信送给我弟弟费洛克，再带回他的回复，我就告诉你飞艇如何飞行。";
		} else {
			mes "哈哈哈！飞艇怎么飞？很神奇吧？虽然这是秘密，但我保证不奇怪也不危险。";
			lght_air = 1;
		}
		break;
	case 3:
		mes "[Tarlock]";
		mes "好了。感谢乘坐我们的飞艇，祝你旅途愉快。";
		break;
	}
	close2;
	cutin "",255;
	end;
}

//----------------------------------------------------------------------------
// Captain Ferlock :: lght_ymir
//----------------------------------------------------------------------------
airplane,236,163,5	script	Airship Captain#03	4_M_REINDEER,{
	cutin "fly_trock.bmp",2;
	mes "[Ferlock]";
	if (hg_ma1 == 3 || hg_ma1 == 4) {
		mes "欢迎乘坐飞艇。我是费洛克船长。今天有什么我能帮你的吗？";
		next;
		select("我在寻找一个叫蒂埃里的男人。");
		mes "[Ferlock]";
		mes "蒂埃里？我不认识这个人。至少可以保证他不是我的员工。";
		next;
		select("能让我查看乘客名单记录吗？");
		mes "[Ferlock]";
		mes "抱歉，我不能向未获授权的人透露此类个人信息。";
		if (hg_ma1 == 3) close;
		next;
		mes "- 你解释寻找蒂埃里的原因时，费洛克船长认真听着。 -";
		next;
		mes "[Ferlock]";
		mes "嗯……我明白情况。但我不能向未获授权的人公开乘客名单……";
		next;
		mes "[Ferlock]";
		mes "*叹气*……看来规则总有一天会被打破……好，我让你查看乘客名单。请稍等。";
		next;
		mes "- 费洛克船长取出一本厚书，在第一页空白处写下“蒂埃里”。字迹慢慢消失，书页开始自行翻动。 -";
		next;
		mes "- 书页停在写有“蒂埃里”名字的一页。 -";
		next;
		mes "[Ferlock]";
		mes "哈哈，你一定很惊讶吧？这是魔法书，不用翻页就能找到指定页面。施瓦尔茨共和国人就是这样把魔法融入生活。";
		next;
		mes "[Ferlock]";
		mes "这是老朋友送我的……不过现在不重要。";
		next;
		mes "[Ferlock]";
		mes "让我看看，蒂埃里……是的，他约一个月前乘坐飞艇，前往胡格尔，是胡格尔航线最早的乘客之一。";
		next;
		mes "[Ferlock]";
		mes "哦，你说他擅长研究？我想起来了，就是那个人！";
		next;
		mes "[Ferlock]";
		mes "那是胡格尔航线开通的第一天。前往胡格尔时，一群龙袭击了飞艇。我们毫无准备，情况极其危险。";
		next;
		mes "[Ferlock]";
		mes "都是我的错，因为我知道龙是人们不敢去胡格尔的原因之一。我真蠢，竟没考虑为船员准备应对龙袭击的方案。";
		next;
		mes "[Ferlock]";
		mes "龙严重损坏飞艇，我们差点坠落。那名年轻人挺身而出修好了飞艇，仿佛早有预料。我很确定救了我们的人就是蒂埃里。";
		next;
		mes "[Ferlock]";
		mes "当时我不明白他为何悲伤消沉，现在我知道原因了。很高兴我决定帮你找到这个了不起的人。你可以去告诉他的未婚妻他在哪里。";
		next;
		mes "[Ferlock]";
		mes "见到他时请代我问候。";
		changequest 8045,8046;
		hg_ma1 = 5;
	} else if (hg_ma1 == 5)
		mes "请告诉他的未婚妻他在哪里。";
	else if (lght_air == 7 && lhz_heart == 11) {
		mes "啊，谢谢你来。我想问你为什么调查伊米尔之心碎片。只是好奇，还是有特殊原因？";
		next;
		switch(select("Just curious...:Well, there's someone I need to help...")) {
		case 1:
			mes "[Ferlock]";
			mes "只是好奇……？我不知道满足好奇心是否值得你承担这些风险。以后要更加小心……";
			break;
		case 2:
			mes "[Ferlock]";
			mes "我不该如此信任你，但既然你帮助过我和弟弟，我相信你是无私的冒险者。好吧。";
			next;
			mes "[Ferlock]";
			mes "如果你保证不泄露我告诉你的事，我可以告诉你符文石和伊米尔之心碎片的秘密。";
			next;
			select("我保证……");
			mes "[Ferlock]";
			mes "好，我希望你守信。你已经知道飞艇由符文石驱动，那是伊米尔之心碎片的仿制品。";
			next;
			mes "[Ferlock]";
			mes "符文石虽然不如真正的伊米尔之心碎片，但可以大量制造。真正的碎片很难找到或有效复制。";
			next;
			mes "[Ferlock]";
			mes "你可能已经猜到了，所有符文石都在艾因布洛克实验室制造，用于飞艇。现在明白了吗？";
			next;
			select("等等，什么是瓦尔蒙特计划？");
			mes "[Ferlock]";
			mes "瓦尔蒙特计划延续了伟大贤者瓦尔蒙特发起的项目。他从小就被誉为不可思议的天才。";
			next;
			mes "[Ferlock]";
			mes "然而无论学术成就多高——甚至成为朱诺大学的终身教授——瓦尔蒙特始终无法资助自己的研究。";
			next;
			mes "[Ferlock]";
			mes "最终他接受雷根贝勒公司的资助，开发能源。为他们工作的成果就是发明符文石。";
			next;
			mes "[Ferlock]";
			mes "但公众不应知道符文石由瓦尔蒙特发明。如今他在完善制造工艺前失踪了。";
			next;
			mes "[Ferlock]";
			mes "因此现在的符文石不稳定，过一段时间就会失效。瓦尔蒙特计划旨在修正缺陷，完善伊米尔之心复制技术……";
			next;
			mes "[Ferlock]";
			mes "呃，总之，这就是我今天去艾因布洛克实验室的原因。我的符文石快耗尽了，所以去拿一块充满能量的。";
			next;
			mes "[Ferlock]";
			mes "^333333*Phew...*^000000";
			mes "让我喘口气再继续，好吗？是的，还有一点……";
			lhz_heart = 12;
			break;
		}
	} else if (lght_air == 7 && lhz_heart == 12) {
		mes "现在，"+strcharinfo(0)+"，你一定想知道我为什么告诉你这些。我认为有人想偷走飞艇上的符文石。";
		next;
		mes "[Ferlock]";
		mes "你注意到攻击我弟弟飞艇的格林姆林和邪眼了吗？信不信由你，格林姆林通常无害又顽皮。";
		next;
		mes "[Ferlock]";
		mes "格林姆林的翅膀天生不足以飞行。但如果有人将黑暗意志植入它们，力量就会指数增长。";
		next;
		mes "[Ferlock]";
		mes "格林姆林通常不会主动攻击人类，也会躲避人群，但现在被控制来偷飞艇的符文石。";
		next;
		mes "[Ferlock]";
		mes "控制格林姆林的人还派出邪眼魔物，监视进展并观察我们的抵抗。";
		next;
		mes "[Ferlock]";
		mes "我和弟弟一直调查此事，但目前所知不多。我的飞艇只执行国内航班，尚未遭到攻击。";
		next;
		mes "[Ferlock]";
		mes "我弟弟的飞艇专营国际航班，还遭到格林姆林入侵，所以我们猜测攻击者来自施瓦尔茨共和国之外。";
		next;
		mes "[Ferlock]";
		mes "总之，这就是我知道的全部。请保密，发现新情况就告诉我。";
		next;
		mes "[Ferlock]";
		mes "如果我查到控制格林姆林、偷走符文石的人使用黑暗意志，我会告诉你。";
		next;
		mes "[Ferlock]";
		mes "是谁派这些魔物入侵飞艇？他们为什么想要符文石？嗯……冒险者，暂时再见。";
		close2;
		specialeffect2 EF_ABSORBSPIRITS;
		completequest 8043;
		lhz_heart = 13;
		if (checkre(3))
			getexp 70000,40000;
		else
			getexp 700000,400000;
		cutin "",255;
		end;
	} else if (lght_air == 7 && lhz_heart == 13) {
		mes "我得忙于船长职责和符文石盗窃未遂案的调查。希望之后还能再见。保重。";
	} else {
		mes "嘿，欢迎登上飞艇。我是这趟航班的船长费洛克。有什么能帮你？";
		next;
		if (lght_air == 2)
			.@question2$ = "Give him Tarlock's Letter.";
		else if (lght_air == 3)
			.@question2$ = "Here are the items I've found.";
		switch(select("How does this Airship fly?", .@question2$, "Cancel.")) {
		case 1:
			mes "[Ferlock]";
			mes "抱歉，我不能提供那种机密信息。这关系到飞艇的安全。";
			break;
		case 2:
			if (lght_air == 2) {
				changequest 8032,8033;
				lght_air = 3;
				mes "^3131FF你把塔洛克的信交给费洛克船长，";
				mes "他的弟弟塔洛克写给他的信。^000000";
				next;
				mes "[Ferlock]";
				mes "哦，这是我弟弟写的？谢谢你替他带来。给我一点时间读完，好吗？";
				next;
				mes "[Ferlock]";
				mes "...";
				mes "原来他一直在做这个。哈哈哈，真有趣。能收到塔洛克的消息总是很好。抱歉让你久等。";
				next;
				mes "[Ferlock]";
				mes "弟弟信里写了些日常琐事，还提到想归还借我的东西。不过他把东西弄丢了……";
				next;
				mes "[Ferlock]";
				mes "原来那些偶尔袭击他飞艇的可恶格林姆林偷走了我的东西，所以他希望你帮我找回。";
				next;
				mes "[Ferlock]";
				mes "是的，他特别提到，在你猎杀那些魔物并找回我的东西前，不要把回信给你。抱歉，但是……";
				mes "看来你欠哥哥一个人情，对吧？";
				next;
				mes "[Ferlock]";
				mes "如果你愿意帮我，能找回我的";
				mes "^ff00002 个黑暗意志^000000和";
				mes "^ff00002 个带刺果实^000000带回来吗？";
				next;
				mes "[Ferlock]";
				mes "攻击塔洛克飞艇的魔物应该拿着它们。冒险者，拜托你帮忙。提前谢谢，祝你好运～";
			} else if (lght_air == 3) {
				if (countitem(7340) >= 2 && countitem(576) >= 2) {// Will_Of_Darkness, Prickly_Fruit
					delitem 7340, 2;
					delitem 576, 2;
					changequest 8033,8034;
					lght_air = 4;
					mes "[Ferlock]";
					mes "太好了！终于拿回东西了！不过我不知道塔洛克为什么想要它们。请把回信带给塔洛克，好吗？";
					next;
					mes "[Ferlock]";
					mes "再次感谢你的帮助！如果没有你，我恐怕再也见不到这些东西了～";
					next;
				mes "^3355FF你获得了";
					mes "^0000FF费洛克船长写给哥哥塔洛克船长的信。^000000";
				} else {
					mes "[Ferlock]";
					mes "哦，抱歉，你似乎还缺少东西。请去找齐它们。";
					mes "^ff00002 个黑暗意志^000000和";
					mes "^ff00002 个带刺果实^000000？谢谢，";
				mes "勇敢的冒险者～";
				}
			}
			break;
		case 3:
			mes "[Ferlock]";
			mes "希望你享受飞艇之旅，";
			mes "祝你旅途愉快。";
			break;
		}
	}
	close2;
	cutin "",255;
	end;
}


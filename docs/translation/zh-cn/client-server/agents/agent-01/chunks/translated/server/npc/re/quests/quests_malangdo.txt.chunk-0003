		mes "马兰岛真是特别的岛屿，喵～";
		mes "字面意义上来说，这里的地面很柔软。";
		next;
		mes "[Geologist Mali]";
	mes "我跟着集团去过很多地方，却从没见过像马兰岛这样柔软的地面。";
	mes "如果不小心按压地面……";
	mes "它有一种魔力，会让你不停地重复按压。";
		next;
		mes "[Geologist Mali]";
		mes "这种柔软又黏糊的感觉……";
		mes "哈哈～会让人上瘾……";
		emotion ET_SHY;
		next;
		mes "[Geologist Mali]";
		mes "哎呀！！";
		mes "我差点就沉进这片柔软里了，喵～！！！";
		emotion ET_HUK;
		next;
		mes "[Geologist Mali]";
		mes "虽然它有让人失去理智的风险，但它帮助纳维号没有解体，喵～";
		next;
		mes "[Geologist Mali]";
		mes "顺便说，这里没有特殊属性，只是由普通土壤构成的，喵～";
		next;
		mes "[Geologist Mali]";
		mes "而且！！";
		mes "这么柔软的地面怎么会^0000FF裂开^000000呢，喵～！";
		emotion ET_HUK;
		next;
		mes "[Geologist Mali]";
		mes "如果^0000FF裂缝继续扩大，地下支撑可能会坍塌^000000，喵……";
		next;
		mes "[Geologist Mali]";
		mes "虽然有很多人来修复裂缝，但感觉还是不够，喵～";
		next;
		mes "[Geologist Mali]";
		mes "所以我们接受志愿服务申请，喵～";
		mes "虽然是志愿服务，但并不是免费的。想来时请随时来找我，喵～";
		next;
		switch(select("帮助修理。:结束谈话。")) {
		case 1:
			mes "[Geologist Mali]";
			mes "咳咳！！！";
			mes "在这个艰难的世界里，竟有如此美丽的年轻人！！！";
			mes "每当遇到像你这样的人，我就觉得活着真好，喵～";
			emotion ET_CRY;
			next;
			mes "[Geologist Mali]";
			mes "请听^6666cc我的助手鲍勃^000000详细说明，喵～";
			mes "离开这里，去^6666cc右边的房间^000000看看，喵～";
			set ma_tomas,14;
			setquest 11221;
			close;
		case 2:
			mes "[Geologist Mali]";
		mes "呜呼呼。";
		mes "我～会～等～你～的～～";
			emotion ET_BIGTHROB;
			close;
		}
	} else if (ma_tomas == 14) {
		mes "[Geologist Mali]";
	mes "咳咳！！！";
	mes "在这个艰难的世界里，竟有如此美丽的年轻人！！！";
	mes "每当遇到像你这样的人，我就觉得活着真好，喵～";
		emotion ET_CRY;
		next;
		mes "[Geologist Mali]";
	mes "请听^6666cc我的助手鲍勃^000000详细说明，喵～";
	mes "离开这里，去^6666cc右边的房间^000000看看，喵～";
		close;
	} else if (ma_tomas == 15 || ma_tomas == 16) {
		mes "[Geologist Mali]";
	mes "裂缝修理得顺利吗，喵？";
	mes "别太勉强自己，喵～";
	mes "如果身体变差就不好了，喵～";
		close;
	} else if (ma_tomas == 17) {
		mes "[Geologist Mali]";
	mes "啊！鲍勃把你的出色工作夸得天花乱坠，喵～";
	mes "下次有机会也请再帮助我们，喵～";
		emotion ET_BEST;
		next;
		mes "[Linguist Devore]";
	mes "海星研究顺利结束了，你不用再做这么辛苦的工作了，所以我制作了这个！";
	mes "呜呜！！！";
		emotion ET_CRY, getnpcid(0, "Linguist Devore#mal");
		next;
		mes "[Geologist Mali]";
	mes "哦哦！德沃尔博士，你在说什么呀，喵～！！！！";
	mes "我完全不这么认为，喵～！！！";
		emotion ET_HUK;
		next;
		mes "[Geologist Mali]";
	mes "大家都知道你，德沃尔博士，一直在努力研究，喵～！！！";
	mes "你已经尽力了，所以自信一点，喵～！";
		set ma_tomas,18;
		completequest 11224;
		setquest 11225;
		setquest 11243;
		getitem 6422,20; //Egrade_Coin
		close;
	} else if (ma_tomas > 99) {
		if (checkquest(11240) > -1 || checkquest(11241) > -1) {
			mes "[Geologist Mali]";
			mes "请听^6666cc我的助手鲍勃^000000详细说明，喵～。";
			mes "离开这里，去^6666cc右边的房间^000000看看，喵～";
			close;
		} else if (checkquest(11242) > -1) {
			mes "[Geologist Mali]";
			mes "啊！鲍勃把你的出色工作夸得天花乱坠，喵～";
			mes "下次有机会也请再帮助我们，喵～";
			changequest 11242,11243;
			getitem 6422,4; //Egrade_Coin
			close;
		} else {
			if (checkquest(11243,PLAYTIME) == 0 || checkquest(11243,PLAYTIME) == 1) {
				mes "[Geologist Mali]";
				mes "别太勉强自己，喵～";
				mes "如果身体变差就不好了，喵～";
				close;
			}
			if (checkquest(11243,PLAYTIME) == 2)
				erasequest 11243;
			mes "[Geologist Mali]";
			mes "今天还有很多修理工作要做！";
			mes "这似乎不是容易解决的事，喵～";
			next;
			switch(select("我来帮忙。:我不做了。")) {
			case 1:
				mes "[Geologist Mali]";
				mes "请听^6666cc我的助手鲍勃^000000详细说明，喵～";
				mes "离开这里，去^6666cc右边的房间^000000看看，喵～";
				setquest 11240;
				close;
			case 2:
				mes "[Geologist Mali]";
				mes "那么请休息吧，喵～";
				mes "下次有机会再见，喵～";
				close;
			}
		}
	}
	mes "[Geologist Mali]";
	mes "这种柔软又黏糊的感觉……";
	mes "哈哈～会让人上瘾……";
	emotion ET_SEXY;
	close;
}

mal_in02,140,94,0	script	Bob#mal	553,{
	if (ma_tomas < 14) {
		mes "[Bob]";
		mes "你汪汪！汪！汪！我喵！喵！喵！";
		mes "我喜欢美味鱼肉榨成的果汁，喵～";
		emotion ET_DELIGHT;
		close;
	} else if (ma_tomas == 14) {
		// Dialogue in repeatable quest is identical.
		// Uses a variable to determine the quest mode.
		set @mal_bob_q,1;
	L_Quest1:
		set .@i, @mal_bob_q;
		set @mal_bob_q,0;
		mes "[Bob]";
		mes "你汪汪！汪！汪！我喵！喵！喵！";
		mes "我喜欢美味鱼肉榨成的果汁，喵～";
		emotion ET_DELIGHT;
		next;
		mes "[Bob]";
		mes "啊啊啊！！！！！！！！！";
		mes "你是来做志愿服务的吗？！";
		emotion ET_HUK;
		next;
		if (checkweight(1201,1) == 0) {
			mes "[Bob]";
			mes "嗯……做志愿服务时要让身心都轻松！";
			mes "你身上的东西似乎太多了，先减轻负重吧～";
			close;
		}
		if (MaxWeight - Weight < 1000) {
			mes "[Bob]";
			mes "嗯……做志愿服务时要让身心都轻松！";
			mes "你身上似乎有很多重物，先减轻负重吧～";
			close;
		}
		switch(select("是。:不。")) {
		case 1:
			mes "[Bob]";
			mes "咳咳……";
			mes "感动！！！";
			mes "我太感动了！！！";
			mes "感动的心在我胸中起舞！！！";
			emotion ET_HUK;
			next;
			mes "[Bob]";
			mes "我曾经轻视他人，对人类抱有偏见！！！";
			mes "我感觉自己要流出鳞片眼泪了！！！！";
			mes "感动！！！";
			mes "感动飞马飓风！！！";
			emotion ET_HUK;
			next;
			select("够了！告诉我怎么修复裂缝。" );
			mes "[Bob]";
		mes "啊！";
			next;
			mes "[Bob]";
			mes "呼……";
			mes "我太激动了，竟然对第一次见面的人无礼。";
			next;
			mes "[Bob]";
			mes "修复裂缝其实很简单。";
			mes "只要这个^0000FF修理工具箱^000000，谁都能轻松完成！";
			next;
			mes "[Bob]";
			mes "用这种灰白色黏土混合物填补缺口，再用订书机修复裂缝。";
			mes "其他工具的用法你已经知道了，我就不解释了。";
			next;
			mes "[Bob]";
			mes "啊，对了……";
			mes "^0000ff你可能会不小心掉进裂缝的空隙里，请小心。^000000";
			if (.@i == 1) {
				set ma_tomas,15;
				changequest 11221,11222;
			} else
				changequest 11240,11241;
			getitem 6434,1; //Fix_Kit
			close;
		case 2:
			mes "[Bob]";
		mes "啊，对了……";
		mes "我明白了……";
		mes "真失望……";
		mes "呼呼嘘嘘～";
			emotion ET_OTL;
			close;
		}
	} else if (ma_tomas == 15) {
	L_Quest2:
		if (checkweight(1201,1) == 0) {
		mes " - 注意！！ -";
		mes " - 由于你携带的物品太多 - ";
		mes " - 无法获得物品。 - ";
		mes " - 请减轻负重 - ";
		mes " - 再试一次。 - ";
			close;
		}
		if (MaxWeight - Weight < 1000) {
		mes " - 注意！！ -";
		mes " - 由于你的物品太重 - ";
		mes " - 无法获得物品。 - ";
		mes " - 请减轻负重 - ";
		mes " - 再试一次。 - ";
			close;
		}
		mes "[Bob]";
		mes "修复裂缝其实很简单。";
		mes "只要这个^0000FF修理工具箱^000000，谁都能轻松完成！";
		if (countitem(6434) == 0)
			getitem 6434,1; //Fix_Kit
		next;
		mes "[Bob]";
		mes "用这种灰白色黏土混合物填补缺口，再用订书机修复裂缝。";
		mes "其他工具的用法你已经知道了，我就不解释了。";
		next;
		mes "[Bob]";
		mes "啊，对了……";
		mes "^0000ff你可能会不小心掉进裂缝的空隙里，请小心。^000000";
		close;
	} else if (ma_tomas == 16) {
		mes "[Bob]";
		mes "咳咳~~~~~~~~~~~~~~~~~~~~~~";
		mes "太完美了！";
		emotion ET_BEST;
		next;
		mes "[Bob]";
		mes "黏合剂填得恰到好处！！";
		mes "完美的订书机手艺！！";
		mes "令人无话可说的精彩收尾！！";
		next;
		mes "[Bob]";
		mes "感动！";
		mes "神秘！";
		mes "震撼！";
		emotion ET_HUK;
		next;
		mes "[Bob]";
		mes "你确实做得非常好！！！";
		mes "我会告诉马里博士！";
		if (countitem(6434) > 0)
			delitem 6434,1; //Fix_Kit
		set ma_tomas,17;
		changequest 11223,11224;
		close;
	} else if (ma_tomas > 99) {
		if (checkquest(11240) > -1) {
			set @mal_bob_q,2;
			goto L_Quest1;
		} else if (checkquest(11241) > -1)
			goto L_Quest2;
	}
	mes "[Bob]";
	mes "你汪汪！汪！汪！我喵！喵！喵！";
	mes "我喜欢美味鱼肉榨成的果汁，喵～";
	emotion ET_DELIGHT;
	close;
}

-	script	Crack#mal0	-1,{
	if (.off) end;	// Official script uses a 1-second timer to disable cracks. Added to prevent abuse.
	if (ma_tomas == 15 || checkquest(11241) > -1) {
		if (countitem(6434) < 1) {
			mes "- 要修复裂缝 -";
			mes "- 你需要修理工具箱。 -";
			close;
		}
		set .@ma_cr1, rand(1,10);
		if (.@ma_cr1 < 5) {
			mes "- 地面有些裂缝。 -";
			mes "- 使用了订书机。 -";
			set .off,1;
			donpcevent "Crackt"+substr(strnpcinfo(2),3,getstrlen(strnpcinfo(2))-1)+"#mal::OnEnable";
			close;
		} else if (.@ma_cr1 == 7) {
			mes "- 裂缝从中央张开，-";
			mes "- 地面变得柔软 -";
			mes "- 你瞬间就会 -";
			mes "- 被吸进地面。 -";
			close2;
			warp "mal_dun01",0,0;
			end;
		} else {
			while (1) {
				switch(select("修复裂缝。:使用订书机。")) {
				case 1:
					switch(rand(1,3)) {
					case 1:
						mes "- 混合两种颜色的 -";
						mes "- 黏合剂并仔细涂在 -";
						mes "- 裂缝上。 -";
						break;
					case 2:
						mes "- 使用丰满的海鞘 -";
						mes "- 填补裂缝空隙。-";
						break;
					case 3:
						mes "- 使用滑溜的海参 -";
						mes "- 填补裂缝空隙。-";
						break;
					}
					next;
					break;
				case 2:
					mes "- 用订书机修复了裂缝 -";
					mes "- 而且修得很好。 -";
					next;
					mes "- 裂缝似乎 -";
					mes "- 已经填好了。 -";
					next;
					if (rand(1,3) == 2) {
						mes "- 回去报告这件事吧。 -";
						if (ma_tomas == 15) {
							set ma_tomas,16;
							changequest 11222,11223;
						}
						if (checkquest(11241) > -1) {
							changequest 11241,11242;
						}
					} else {
						mes "- 去寻找 -";
						mes "- 其他裂缝吧。 -";
					}
					set .off,1;
					donpcevent "Crackt"+substr(strnpcinfo(2),3,getstrlen(strnpcinfo(2))-1)+"#mal::OnEnable";
					close;
				}
			}
		}
	}
	mes "- 我能看到裂缝。 -";
	mes "- 看起来仍然 -";
	mes "- 没有足够的支撑。 -";
	close;
OnEnable:
	enablenpc();
	end;
OnDisable:
	set .off,0;
	disablenpc();
	end;
}

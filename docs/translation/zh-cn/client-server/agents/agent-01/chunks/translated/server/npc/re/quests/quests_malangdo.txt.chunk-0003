mal_in02,181,55,3	script	Brie#mal	545,{
	if (ma_tomas < 6) {
		mes "[Brie]";
		mes "抱歉，我现在不想和你说话。请让我一个人静静。";
		close;
	} else if (ma_tomas == 6) {
		mes "[Brie]";
		mes "抱歉，会长。";
		next;
		mes "[Brie]";
		mes "虽然星星糖支撑着马兰岛的地面，";
		mes "但我们完全不明白它的目的或原因。";
		mes "难道我们只能期待什么也找不到吗？";
		next;
		mes "[President of Meeting]";
		mes "正如德沃尔博士所说，他还在研究，所以最好等待结果……";
		next;
		mes "[Brie]";
		mes "如果星星糖离开，而你只是一直等待，你会怎么办？";
		mes "马兰岛可能会沉没。我不能就这样在这里干等。";
		next;
		mes "[President of Meeting]";
		mes "但是，布里，我们知道除了等待别无他法。";
		mes "上次星星糖试图让支撑物立起来时，似乎受到了惊吓并移动过多，结果产生了巨大的裂缝。";
		next;
		mes "[Geologist Mali]";
		mes "而且，^0000FF星星糖所在的位置承担着这座岛的支柱作用，即使在她周围设置支柱，中心似乎也会下沉^000000，喵～";
		next;
		mes "[Geologist Mali]";
		mes "由于这个巨大地下空间的特性，如果中心坍塌，我们无法预料接下来会发生什么。因此研究人员认为应尽可能谨慎处理，喵～";
		next;
		mes "[Brie]";
		mes "...";
		next;
		mes "[President of Meeting]";
		mes "我们知道里坎的伤势可能影响世界树果实的交易，所以别太担心。";
		next;
		mes "[President of Meeting]";
		mes "至于那件事，我们会和首领托马斯商量并制定计划。";
		next;
		mes "[Brie]";
	mes "是的……";
		next;
		mes "[President of Meeting]";
		mes "好了，我们暂时休息一下吧。";
		mes "过了一会儿，塞缪尔把海藻和金枪鱼带到了这里。";
		set ma_tomas,7;
		completequest 11214;
		setquest 11215;
		close;
	} else if (ma_tomas == 7) {
		mes "[Brie]";
		mes "什么？！";
		mes "如果你只是唠叨，我不会听。";
		next;
		switch(select("关于里坎。:我不说了。")) {
		case 1:
			mes "[Brie]";
			mes "至于我父亲？";
			mes "他是这座岛上负责世界树果实的人。";
			next;
			mes "[Brie]";
			mes "在双腿从地震中恢复前，他只能做按下烘干机按钮之类的小事。";
			mes "世界树果实的数量大幅减少了。";
			next;
//

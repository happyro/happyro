in_rogue,359,177,0	script	#killershow01	-1,{
OnInit:
	disablenpc "#killershow01";
	end;

OnEnable:
	enablenpc "#killershow01";
	initnpctimer;
	end;

OnDisable:
	stopnpctimer;
	disablenpc "#killershow01";
	end;

OnTimer1000:
	enablenpc "Killer#Rogueguild";
	end;

OnTimer120000:
	disablenpc "Killer#Rogueguild";
	end;

OnTimer150000:
	disablenpc "Killer#Rogueguild";
	disablenpc "#killershow01";
	end;
}

in_rogue,357,174,2	script	Killer#Rogueguild	705,1,1,{
OnInit:
	disablenpc "Killer#Rogueguild";
	end;

OnTouch_:
	if (ROG_SK == 10) {
		specialeffect2 EF_CHANGECOLD;
		specialeffect EF_CHANGEWIND;
		specialeffect2 EF_LIGHTSPHERE;
		set ROG_SK,11;
		mes "[杀手]";
		mes "你、你对我做了什么？！";
		mes "动、动不了了！";
		next;
		mes "[海嘉拉·格雷格]";
		mes "哦？没想到你这么快就能施放封闭空间！";
		mes "太厉害了，真是太厉害了！";
		mes "现在正是你掌握这个技能的好机会……";
		next;
		mes "[海嘉拉·格雷格]";
		mes "现在注意听。";
		mes "我要你练习预测对手的移动意图。";
		mes "观察这个杀手的气场，你应该能看出他打算往哪个方向移动。";
		next;
		mes "[海嘉拉·格雷格]";
		mes "如果他打算向左移动，气场会是白色。";
		mes "向右移动时会变成黄色，";
		mes "后退时则是浅红色。";
		next;
		setarray .@Effects[1],EF_CHANGECOLD,EF_CHANGEWIND,EF_CHANGEEARTH;
		for(set .@lim_1,0; .@lim_1<10; set .@lim_1,.@lim_1+1) {
			set .@move_1,rand(1,3);
			specialeffect .@Effects[.@move_1];
			if (select("挡住他的左路:挡住他的右路:挡住他的退路") == .@move_1) {
				mes "^3355FF杀手仍然无法移动，看起来非常困惑！";
				mes "你现在完美地使用了封闭空间技能！^000000";
				specialeffect EF_POTION1;
				specialeffect2 EF_POTION7;
			}
			else {
				mes "^3355FF等等——！";
				mes "不知为什么，你感觉那不是杀手此刻移动的方向。";
				mes "你自然地修正了自己的动作。^000000";
			}
			next;
		}
		mes "^3355FF你成功取回了传奇人物蔡泽培撰写的无价技能书。^000000";
		close2;
		disablenpc "Killer#Rogueguild";
		donpcevent "#killershow01::OnDisable";
		end;
	}
	else if (ROG_SK == 11) {
		mes "[杀手]";
		mes "嗷……";
		mes "还、还是……";
		mes "动、动不了！";
		close2;
		disablenpc "Killer#Rogueguild";
		donpcevent "#killershow01::OnDisable";
		end;
	}
	end;
}

in_rogue,355,179,0	script	Haijara Greg#rogueguild	46,{
	if (BaseJob == Job_Rogue) {
		if (ROG_SK == 12 && Upper == 1) {
			mes "[海嘉拉·格雷格]";
			mes "嗯？啊，是超越后导致的失忆吗？";
			mes "那么我来教你这个技能。";
			mes "再次施放封闭空间技能。";
			specialeffect2 EF_LIGHTSPHERE;
			skill "RG_CLOSECONFINE",1,SKILL_PERM;
			set ROG_SK,13;
			close;
		}
		else if (ROG_SK == 13 && Upper == 1) {
			mes "[海嘉拉·格雷格]";
			mes "是影舞者吗？";
			mes "记住要用你的能力对付那些值得追踪的敌人。";
			mes "祝你好运，冒险者。";
			close;
		}
		else {
			if (ROG_SK < 1) {
				mes "[海嘉拉·格雷格]";
				mes "你、你是怎么找到这里的？";
				mes "我以为这个避难室即使是盗贼也无法进入！";
				next;
				mes "[海嘉拉·格雷格]";
				mes "这可不妙！";
				mes "他们迟早会找到我……";
				close;
			}
			else if (ROG_SK == 1) {
				mes "[海嘉拉·格雷格]";
				mes "你、你是谁？";
				mes "你是怎么进来的？报上名来！";
				next;
				if (select("我无意伤害你！:把我们要的东西交出来！") == 1) {
					mes "[海嘉拉·格雷格]";
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
					mes "不……？";
					mes "那么……你为什么来这里？";
					mes "你找到我绝非偶然。";
					next;
					if (select("我是来帮助你的。:哦，其实我不是来找你的。") == 1) {
						mes "[海嘉拉·格雷格]";
						mes "嗯……好吧，我想";
						if (Upper == 1)
							mes "我可以信任同为影舞者的你";
						else
							mes "我可以信任同为盗贼的你";
						mes "来帮助我摆脱困境。盗亦有道。";
						mes "好吧。你听说过蔡泽培的传说吗？";
						next;
							if (select("没有:听说过") == 1) {
								mes "[海嘉拉·格雷格]";
								mes "100 年前，蔡泽培是第一个超越自身极限的人。";
								mes "他也是第一个选择不同道路、而非遵循原本职业路线的人。";
							next;
							mes "[海嘉拉·格雷格]";
							mes "他原本是武僧，但超越后不知为何成为了影舞者。";
							mes "他保留武僧的蓄气技能知识，并将其改造成盗贼可用的技能。";
							next;
							mes "[海嘉拉·格雷格]";
							mes "蔡泽培把这种新盗贼技能的基础记录在一本书里，";
							mes "我很幸运地得到了它。但我刚拿到书，就开始遭到勒索……";
							next;
							mes "[海嘉拉·格雷格]";
							mes "有些无耻之徒会不择手段把书从我手里夺走。";
							mes "我能理解，因为我和儿子们都从泽培的著作中学到了新技能。";
							next;
							mes "[海嘉拉·格雷格]";
							mes "不过我时间不多了，那些人迟早会找到我。";
							mes "你愿意帮助我和我的儿子们吗？";
							next;
							if (select("当然！:抱歉，我很忙。") == 1) {
								mes "[海嘉拉·格雷格]";
								mes "哦，非常感谢你！";
								mes "听着，我不能冒险被发现，";
								mes "所以请把这封信带给我最小的儿子^FF0000路易斯·格雷格^000000。快点，时间不多了！";
								set ROG_SK,2;
								close;
							}
							mes "[海嘉拉·格雷格]";
							mes "我……我明白了。";
							mes "但请你想想，如果不是你，我还能相信谁来帮我？";
							close;
						}
						mes "[海嘉拉·格雷格]";
						mes "那么你应该知道我手上这本技能书的价值。";
						mes "不过有些人为了得到它会不择手段地追捕我。";
						mes "你愿意帮我吗？";
						next;
						if (select("当然！:抱歉，我很忙。") == 1) {
							mes "[海嘉拉·格雷格]";
							mes "哦，非常感谢你！";
							mes "我不能冒险被发现，请把这封信带给我最小的儿子^FF0000路易斯·格雷格^000000。";
							mes "快点，时间不多了！";
							set ROG_SK,2;
							close;
						}
						mes "[海嘉拉·格雷格]";
						mes "我……我明白了。";
						mes "但请你想想，如果不是你，我还能相信谁来帮我？";
						close;
					}
					mes "[海嘉拉·格雷格]";
					mes "嗯……？";
					mes "这似乎不太可能，不过我想还是姑且相信你。";
					mes "那么，希望你能找到离开这里的路。";
					close;
				}
				mes "[海嘉拉·格雷格]";
				mes "我明白了。既然如此。";
				mes "我就展示你如此渴望的技能……";
				mes "^FF0000封闭空间^000000！";
				specialeffect EF_CHANGECOLD;
				specialeffect2 EF_CHANGEWIND;
				next;
				mes "[海嘉拉·格雷格]";
				mes "哼。现在你无力反抗，正好让我施放^FF0000背刺^000000！";
				specialeffect2 EF_COMBOATTACK5;
				percentheal -95,0;
				next;
				mes "[海嘉拉·格雷格]";
				mes "现在滚出去。别再让我看到你贪婪的脸。";
				mes "你该庆幸我没有杀你！";
				set ROG_SK,1;
				close;
			}
			else if (ROG_SK == 2) {
				mes "[海嘉拉·格雷格]";
				mes "我们没时间了……请尽快把这封信带给我最小的儿子^FF0000路易斯^000000！";
				mes "你可以在盗贼公会、^FF0000小霍尔格伦^000000附近找到他。";
				close;
			}
			else if (ROG_SK == 3) {
				mes "[海嘉拉·格雷格]";
				mes "路易斯让你去找^FF0000托尔^000000？他在盗贼公会、^FF0000小赫尔曼索恩^000000附近，对吧？";
				mes "抱歉让你一个个去找我的儿子……我知道这很麻烦。";
				close;
			}
			else if (ROG_SK == 4) {
				mes "[海嘉拉·格雷格]";
				mes "啊，你在找^FF0000杰伊^000000？";
				mes "他就在盗贼公会这里的^FF0000小安东尼奥^000000附近，至少通常在那里。";
				close;
			}
			else if (ROG_SK == 5) {
				mes "[海嘉拉·格雷格]";
				mes "哦，你回来了！还带来了杰伊的信。";
				mes "很好，让我看看他写了什么……";
				set ROG_SK,6;
				next;
				mes "[海嘉拉·格雷格]";
				mes "啊，好消息！他已经联系盗贼公会请求额外保护，并通知了守卫。";
				mes "我终于可以稍微放松了。没人敢招惹盗贼。";
				next;
				mes "[海嘉拉·格雷格]";
				mes "非常感谢你的帮助。要不是你，我可能会永远躲藏。";
				mes "作为回报，我让你有机会学习蔡泽培的秘密技能。";
				next;
				mes "[海嘉拉·格雷格]";
				mes "请和^FF0000托尔^000000谈谈，告诉他我允许你学习我教给所有儿子的技能。";
				mes "他一定会答应。";
				close;
			}
			else if (ROG_SK == 6) {
				mes "[海嘉拉·格雷格]";
				mes "请让托尔教你蔡泽培的盗贼秘密技能。";
				mes "要知道，这个简陋的避难室里没有足够设备让我教你。";
				close;
			}
			else if (ROG_SK == 7) {
				mes "[海嘉拉·格雷格]";
				mes "嗯……？你不是应该正在训练学习那个技能吗？";
				mes "请和托尔谈谈并完成训练。";
				close;
			}
			else if (ROG_SK == 8) {
				mes "[海嘉拉·格雷格]";
				mes "你完成训练了？啊，真不错。";
				mes "不过你应该先和托尔谈谈……";
				close;
			}
			else if (ROG_SK == 9) {
				mes "[海嘉拉·格雷格]";
				mes "哦，你回来了！听说你已经完成训练，准备了解封闭空间的应用。";
				next;
				mes "[海嘉拉·格雷格]";
				mes "哇！什么——？！停下！请、请阻止那个人！";
				mes "不能让他偷走那本书！";
				specialeffect EF_COMBOATTACK5;
				donpcevent "Killer#Rogueguild::OnEnable";
				set ROG_SK,10;
				close;
			}
			else if (ROG_SK == 10) {
				mes "[海嘉拉·格雷格]";
				mes "那个人刚偷走了封闭空间技能书！";
				mes "拜托！别让他逃走！那本书价值连城！";
				donpcevent "#killershow01::OnEnable";
				close;
			}
			else if (ROG_SK == 11) {
				donpcevent "Killer#Rogueguild::OnDisable";
				donpcevent "#killershow01::OnDisable";
				mes "^3355FF你把蔡泽培撰写的技能书还给了海嘉拉。^000000";
				next;
				mes "[海嘉拉·格雷格]";
				mes "非常感谢你的帮助。如果你想了解封闭空间的详细信息，我可以继续说明。";
				next;
				if (select("好的，请说。:不用了，谢谢。") == 1) {
					mes "[海嘉拉·格雷格]";
					mes "你应该知道，封闭空间能使靠近你的敌人无法移动。";
					mes "不过对玩家和魔物使用时有些细节差异。";
					next;
					mes "[海嘉拉·格雷格]";
					mes "封闭空间类似武僧的蓄气技能，";
					mes "但只会限制敌人的移动，不会限制攻击能力。";
					next;
					mes "[海嘉拉·格雷格]";
					mes "除了封闭空间持续期间只能使用一次的背刺，";
					mes "我们可以在封闭空间状态下使用任何技能。";
					next;
					mes "[海嘉拉·格雷格]";
					mes "受到封闭空间影响的敌人可以使用苍蝇翅膀、蝴蝶翅膀、瞬间移动或隐匿逃脱。";
					mes "不过攻城战期间只有隐匿有效。";
					next;
					mes "[海嘉拉·格雷格]";
					mes "因此，在公会战攻城期间，封闭空间会非常有用，";
					mes "前提是目标没有使用隐匿技能逃脱。";
					next;
					mes "[海嘉拉·格雷格]";
					mes "除了 Boss 魔物以外，封闭空间会使魔物无法移动 10 秒，";
					mes "为盗贼组队狩猎带来新的可能。";
					next;
					mes "[海嘉拉·格雷格]";
					mes "关于封闭空间我能告诉你的就这些。";
					mes "希望你能通过练习进一步了解这个技能，";
					mes "成为像蔡泽培一样伟大的传奇。";
					set ROG_SK,12;
					skill "RG_CLOSECONFINE",1,SKILL_PERM;
					specialeffect2 EF_LIGHTSPHERE;
					close;
				}
					mes "[海嘉拉·格雷格]";

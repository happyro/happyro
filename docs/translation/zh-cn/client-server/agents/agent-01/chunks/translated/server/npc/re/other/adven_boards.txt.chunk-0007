			1026,"穆纳克","死去女孩的灵魂寄宿在尸体中，使其变成僵尸怪物。它会吸食附近生物的血液。",
			1129,"火焰精灵","外形如鬼火的火焰怪物。它的来源不明。",
			1381,"灰熊","栖息在熔岩流经地区的熊。毛皮看起来像在燃烧，深受毛皮爱好者欢迎。",
			1037,"侧蛇","独眼蛇。它会把尾巴当作头部来迷惑敌人。",
			1306,"莱布奥尔迈","性情极其凶猛的熊。身上布满与其他生物战斗留下的伤疤。",
			1517,"精怪","看起来像老虎玩偶的怪物，会像狗一样吠叫。",
			1516,"米高","沙怪。会制造沙柱进行攻击。",
			1514,"朱波隆","看起来像一条龙形面具，节日期间或许能发现它。",
			1519,"绿妖","可爱的小个子女武者，实际上被成熟女武者的灵魂附身。",
			1512,"姚君","僵尸怪物，似乎颇为精通武术。",
			1513,"毛怪","穿着人类服装的邪恶猫妖，像人类一样用两条腿走路，并用手中的扇子攻击。",
			1518,"白素贞","这个 MVP 怪物用美貌引诱附近的冒险家，有些冒险家会被它的尖叫迷住。" );
		if (.@mo_board == 1) {
			mes "[洛阳地下城]";
			mes "洛阳地下城由 3 层组成，这里的怪物往往会以数量压倒冒险家。进入前请做好准备。";
			next;
			while(1) {
				switch( select( "洛阳地下城 - 水龙宫","洛阳地下城 - 皇陵","洛阳地下城 - 皇陵内部","取消" ) ) {
				case 1:
					mes "[洛阳地下城 - 水龙宫]";
					mes "------------ 怪物 ------------";
					mes "火焰精灵(66)";
					mes "灰熊(66)";
					mes "侧蛇(70)";
					mes "精怪(80)";
					mes "米高(83)";
					mes "莱布奥尔迈(87)";
					mes "--------------------------------";
					F_InfoBoard;
					continue;
				case 2:
					mes "[洛阳地下城 - 皇陵]";
					mes "------------ 怪物 ------------";
					mes "魔物箱(56)";
					mes "穆纳克(58)";
					mes "朱波隆(82)";
					mes "姚君(87)";
					mes "--------------------------------";
					F_InfoBoard;
					continue;
				case 3:
					mes "[洛阳地下城 - 皇陵内部]";
					mes "------------ 怪物 ------------";
					mes "朱波隆(82)";
					mes "绿妖(82)";

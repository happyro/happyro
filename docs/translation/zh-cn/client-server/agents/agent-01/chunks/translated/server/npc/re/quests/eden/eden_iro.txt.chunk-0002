		callsub L_Exchange,12208,2,12411,1;
		break;
	case 3:
		callsub L_Exchange,12411,4,14545,1;
		break;
	case 4:
		callsub L_Exchange,12312,3,14545,2;
		break;
	case 5:
		mes "[兑换机器]";
		mes "我可以用 1 个海盗船长服装兑换 1 本战斗手册 X3。";
		next;
		if (countitem(19619) == 0) {
			mes "[兑换机器]";
			mes "你没有海盗船长服装帽，无法进行兑换。";
			close;
		}
		next;
		if(select("是，给我吧！:不，先等等。") == 2)
			close;
		// Unofficial dialogue.
		mes "[兑换机器]";
		mes "你把所需物品放进机器……";
		next;
		mes "[兑换机器]";
		mes "机器返还给你一件物品！";
		delitem 19619,1; //C_Corsair
		getitem 14545,1; //Battle_Manual_X3
		close;
	case 6:
		close;
	}

//callsub L_Exchange,<Insert Item>,<Amount>,<Return Item>,<Amount>
L_Exchange:
	mes "[兑换机器]";
	mes "你想要多少个"+getitemname(getarg(2))+"？";
	mes "最多可以给你 60 个。";
	mes "输入 0 取消。";
	next;
	input .@amount;
	if (.@amount == 0) {
		mes "[兑换机器]";
		mes "已取消。";
		close;
	} else if (.@amount < 0 || .@amount > 60) {
		mes "[兑换机器]";
		mes "我说过最多只能 60 个。";
		close;
	}
	mes "[兑换机器]";
	mes "总共是"+.@amount+"个"+getitemname(getarg(2))+"。";
	mes "正确吗？";
	next;
	if(select("是，给我吧！:不，先等等。") == 2)
		close;
	set .@cost, getarg(1) * .@amount;
	set .@total_amount, getarg(3) * .@amount;
	if (countitem(getarg(0)) < .@cost) {
		mes "[兑换机器]";
		mes "你没有足够的"+getitemname(getarg(0))+"进行兑换。";
		close;
	}
	delitem getarg(0),.@cost;
	getitem getarg(2),.@total_amount;
	close;
}

// Merry Badger
//============================================================
moc_para01,13,22,4	script	Merry Badger#xch	882,{
	disable_items;
	mes "[快乐獾]";
	mes "你好！我是快乐獾，受雇负责兑换^00CC00伊甸园功勋徽章^000000！";
	next;
	mes "[快乐獾]";
	mes "我可以收取你的功勋徽章并给你有用的物品，也可以收取你的物品并给你伊甸园功勋徽章。";
	mes "随着获得更多授权，我能提供更多兑换项目，所以来伊甸园集团时一定要记得找我。";
	next;
	// switch( select( "Redeem Badges", "Trade in FOR badges", "Exchange Rates", "15 Job Manuals - 1 JM Box", "Sky Fortress Tickets", "Weekly Special" ) ) {// Sky Fortress Tickets meaningless without the instance
	switch( select( "兑换徽章", "用物品兑换徽章", "兑换比例", "15 本职业手册 - 1 个职业手册箱", "", "每周特惠" ) ) {
	case 1:
		setarray .@menu_list$[0],
			"4 个伊甸园功勋徽章兑换 10 个 KVM 徽章",
			"4 个伊甸园功勋徽章兑换 10 个勇气勋章",
			"4 个伊甸园功勋徽章兑换 10 个勇猛勋章", 
			"8 个伊甸园功勋徽章兑换 1 个重置石",
			"5 个伊甸园功勋徽章兑换战斗手册增益",
			"5 个伊甸园功勋徽章兑换职业战斗手册增益",
			"10 个伊甸园功勋徽章兑换高级战斗手册增益",
			"20 个伊甸园功勋徽章兑换 3 倍战斗手册增益",
			"5 个伊甸园功勋徽章兑换口香糖增益", 
			"10 个伊甸园功勋徽章兑换高级口香糖增益",
			"",	// "5 EMB for Miracle Buff" (item doesn't exist in db)
			"1 个伊甸园功勋徽章兑换世界树叶",
			"",	// "5 EMB for Rental Wing of Beelzebub" (item doesn't exist in db)
			"5 个伊甸园功勋徽章兑换租赁缰绳",
			"5 个伊甸园功勋徽章兑换 20 个蓝色药草",
			"齐格弗里德的纹章",
			"现在不要";
		.@menu$ = implode( .@menu_list$, ":" );
		while(1) {
			mes "[快乐獾]";
			mes "当然，我现在有几种徽章兑换选项！";
			next;
			switch( select(.@menu$) ) {
			case 1:// "4 EMB for 10 KVM Badge"
				callsub L_Exchange,4,6376,10;// KVM_Badge
				break;
			case 2:// "4 EMB for 10 Bravery Medals"
				callsub L_Exchange,4,7828,10;// BF_Badge1
				break;
			case 3:// "4 EMB for 10 Valor Medals"
				callsub L_Exchange,4,7829,10;// BF_Badge2
				break;
			case 4:// "8 EMB for 1 Reset Stone"
				callsub L_Exchange,8,6320,1;// Premium_Reset_Stone
				break;
			case 5:// "5 EMB for Battle Manual Buff"
				callsub L_Exchange,5,12208,1;// Battle_Manual
				break;
			case 6:// "5 EMB for Job Battle Manual Buff"
				callsub L_Exchange,5,14592,1;// Job_Manual50
				break;
			case 7:// "10 EMB for HE Battle Manual Buff"
				callsub L_Exchange,10,12411,1;// HE_Battle_Manual
				break;
			case 8:// "20 EMB for 3X Battle Manual Buff"
				callsub L_Exchange,20,14545,1;// Battle_Manual_X3
				break;
			case 9:// "5 EMB for Bubblegum Buff"
				callsub L_Exchange,5,12210,1;// Bubble_Gum
				break;
			case 10:// "10 EMB for HE Bubblegum Buff"
				callsub L_Exchange,10,12412,1;// HE_Bubble_Gum
				break;
			case 11:// "5 EMB for Miracle Buff"
				.@item_id = 22819;
				if (countitem(6495) < 5) {
					mes "[快乐獾]";
					mes "你没有足够的^00CC00伊甸园功勋徽章^000000。我们重新开始！";
					break;
				}
				mes "[快乐獾]";
				mes "好，我可以用你^0066CC5 个伊甸园功勋徽章^000000兑换^ff0000" + getitemname(.@item_id) + "^000000。";
				mes "要兑换吗？";
				next;
				if (select("是", "否") == 2) {
					mes "[快乐獾]";
					mes "我明白了，看看你是否想要别的东西！";
					break;
				}
				mes "[快乐獾]";
				mes "给你！还想要什么？";
				delitem 6495, 5;// Para_Logro_Badge
				consumeitem .@item_id;
				break;
			case 12:// "1 EMB for Yggdrasil Leaf"
				callsub L_Exchange,1,610,1;// Leaf_Of_Yggdrasil
				break;
			case 13:// "5 EMB for Rental Wing of Beelzebub"
				.@item_id = 14645;
				if (countitem(6495) < 5) {
					mes "[快乐獾]";
					mes "你的^00CC00伊甸园功勋徽章^000000不够。重新开始吧！";
					break;
				}
				mes "[快乐獾]";
				mes "好的，我可以用你^0066CC5 个伊甸园功勋徽章^000000兑换^ff0000" + getitemname(.@item_id) + "^000000。";
				mes "要兑换吗？";
				next;
				if (select("是", "否") == 2) {
					mes "[快乐獾]";
					mes "我明白了，看看你是否想要别的东西！";
					break;
				}
				mes "[快乐獾]";
				mes "给你！还想要什么？";
				delitem 6495, 5;// Para_Logro_Badge
				rentitem .@item_id, 604800;	// 7 days
				break;
			case 14:// "5 EMB for Rental Halter Lead"
				callsub L_Exchange,5,17162,1;// Boarding_Halter_Box7
				break;
			case 15:// "5 EMB for 20 Blue Herbs"
				callsub L_Exchange,5,510,20;// Blue_Herb
				break;
			case 16:// Token of Siegfried
				if (vip_status(VIP_STATUS_ACTIVE) == false) {
					mes "[快乐獾]";
					mes "VIP 服务会向所有 VIP 用户提供这些物品！";
					close;
				}
				// custom from here
				.@date = gettime(DT_YYYYMMDD);
				if (.@date <= eden_iro_token_date) {
					mes "[快乐獾]";
					mes "你今天已经领取过纹章了！";
					close;
				}
				mes "[快乐獾]";
				mes "给你！还想要什么？";
				eden_iro_token_date = .@date;
				getitem 7621,10;// Token_Of_Siegfried
				close;
			case 17:// Nothing Now
				mes "[快乐獾]";
				mes "太棒了！";
				mes "如果你想兑换伊甸园功勋徽章，随时来找我！";
				close;
			}
			next;
		}
	case 2:
		mes "[快乐獾]";
		mes "目前可兑换的种类有限，但这些可以兑换 1 个伊甸园功勋徽章！";
		next;
		switch( select( "其他物品", "装备", "取消" ) ) {
		case 1:
			while(1) {
				if (select( "5 个旧紫色箱子", "什么都不要" ) == 2) {
					mes "[快乐獾]";
					mes "太棒了！";
					mes "如果你想兑换伊甸园功勋徽章，随时来找我！";
					close;
				}
				while(1) {
					if (countitem(617) < 5) {
						mes "[快乐獾]";
						mes "你没有足够的物品兑换 1 个伊甸园功勋徽章。重新开始吧！";
						break;
					}
					mes "[快乐獾]";
					mes "好，我可以用^0000CC5 个旧紫色箱子^000000兑换^CC00001 个伊甸园功勋徽章^000000。要兑换吗？";
					next;
					if (select( "是", "否" ) == 2) {
						mes "[快乐獾]";
						mes "我明白了，看看你是否想要别的东西！";
						break;
					}
					else {
						mes "[快乐獾]";
						mes "给你！还想要什么？";
						delitem 617,5;// Old_Violet_Box
						getitem 6495,1;// Para_Logro_Badge
						next;
					}
				}
				next;
			}
		case 2:
			while(1) {
				mes "[快乐獾]";
				mes "我会拿走你物品栏最上面的物品！请确认最上面的物品不是你不想兑换的东西。";
				next;
				switch( select( "巨大脸虫蛇皮", "巨大脸虫蛇皮 [1]", "什么都不要" ) ) {
				case 1:
					.@item_req = 20717;// FaceWorm_Skin
					.@item_name$ = "巨大脸虫蛇皮";
					.@amount_reward = 5;
					break;
				case 2:
					.@item_req = 20718;// FaceWorm_Skin_
					.@item_name$ = "巨大脸虫蛇皮 [1]";
					.@amount_reward = 7;
					break;
				case 3:
					mes "[快乐獾]";
					mes "太棒了！";
					mes "如果你想兑换伊甸园功勋徽章，随时来找我！";
					next;
					mes "[快乐獾]";
					mes "没关系，想看看我提供什么就问我！";
					close;
				}
				while(1) {
					if (countitem(.@item_req) < 1) {
						mes "[快乐獾]";
						mes "你没有足够的物品兑换 1 个伊甸园功勋徽章。重新开始吧！";
						break;
					}
					mes "[快乐獾]";
					mes "好，我可以提供^ff0000" + .@amount_reward + " 个伊甸园功勋徽章^000000，换取^00ff00" + .@item_name$ + "^000000。要兑换吗？";
					next;
					if (select( "是", "否" ) == 2) {
						mes "[快乐獾]";
						mes "我明白了，看看你是否想要别的东西！";
						break;
					}
					delitem .@item_req, 1;
					getitem 6495, .@amount_reward;// Para_Logro_Badge
					mes "[快乐獾]";
					mes "给你！还喜欢什么？";
					next;
				}
				next;
			}
		case 3:
			mes "[快乐獾]";
			mes "没关系，想看看我提供什么就问我！";
			close;
		}
	case 3:
		mes "[快乐獾]";
		mes "这些就是我会用你的^00CC00伊甸园功勋徽章^000000兑换给你的物品！";
		mes "好的，我有一项 3 个功勋徽章的特惠。本周我会提供^00CC0040 个光粒^000000、^00CC0040 个火药^000000、^0000CC3 个伊西多尔^000000、^00CC0010 个多刺果^000000、^0000CC1 个曼陀罗花盆^000000和^00CC003 个古老树枝^000000。";
		mes "^00CC002 个伊甸园功勋徽章^000000 = ^0000CC10 个 KVM 徽章^000000";
		mes "^00CC002 个伊甸园功勋徽章^000000 = ^0000CC10 个勇气勋章^000000";
		mes "^00CC002 个伊甸园功勋徽章^000000 = ^0000CC10 个勇猛勋章^000000";
		mes "^00CC005 个伊甸园功勋徽章^000000 = ^0000CC5 个中型生命药水^000000";
		mes "^00CC005 个伊甸园功勋徽章^000000 = ^0000CC5 个生命保险^000000";
		mes "^00CC005 个伊甸园功勋徽章^000000 = ^0000CC5 个齐格弗里德的纹章^000000";
		mes "^00CC007 个伊甸园功勋徽章^000000 = ^0000CC1 本职业战斗手册^000000";
		mes "^00CC008 个伊甸园功勋徽章^000000 = ^0000CC1 个重置石^000000";
		next;
		mes "[快乐獾]";
		mes "这些物品可以兑换^00CC001 个伊甸园功勋徽章^000000！";
		mes "^0000CC5 个旧紫色箱子^000000";
		close;
	case 4:
		mes "[快乐獾]";
		mes "他们强迫我提供这个，但你值得拥有！";
		mes "要用 15 本职业手册兑换 1 个可交易的 10 本职业手册箱吗？";
		mes "我知道 15 不等于 10，但箱子很贵，你懂的。";
		next;
		if (countitem(14592) < 15) {
			mes "[快乐獾]";
			mes "你没有 15 本以上职业手册，无法兑换 1 个箱子！";
			close;
		}
		// custom dialogue below
		if (select("是", "否") == 2) {
			mes "[快乐獾]";
			mes "太棒了！";
			mes "如果你想兑换伊甸园功勋徽章，随时来找我！";
			close;
		}
		mes "[快乐獾]";
		mes "太棒了，还想要什么？";
		delitem 14592,15; //Job_Manual50
		getitem 13990,1; //Job_Manual50_Box
		close;
	case 5:
		mes "[快乐獾]";
		mes "我也不太明白原因，但我有一叠优惠券要出售。";
		mes "要用 25 个伊甸园功勋徽章兑换 1 张副本票吗？如果你是 VIP，票券有效时间会长很多！";
		next;
		if (select( "是", "否" ) == 2) {
			mes "[快乐獾]";
			mes "我明白了，看看你是否想要别的东西！";
			close;
		}
		if (countitem(6495) < 25) {
			mes "[快乐獾]";
			mes "你的徽章不够！";
			close;
		}
		delitem 6495,25;
		if (vip_status(VIP_STATUS_ACTIVE))
			getitem 17570,1;// Sky Fortress Ticket 3 Hour Box
		else
			getitem 17569,1;// Sky Fortress Ticket 1 Hour Box
		mes "[快乐獾]";
		mes "给你！还想要什么？";
		close;
	case 6:
		while(1) {
			mes "[快乐獾]";
			mes "每周特惠是……";
			next;
			mes "[快乐獾]";
			mes "好的，我有一项 3 个功勋徽章或 1,000,000 Zeny 的特惠。本周我会提供^00CC0040 个光粒^000000、40 个火药^000000、^0000CC3 个伊西多尔^000000";
			mes "^00CC0010 个多刺果^000000、^0000CC1 个曼陀罗花盆^000000和^00CC003 个古老树枝^000000。";
			next;
			switch( select( "徽章", "Zeny", "否" ) ) {
			case 1:
				if (countitem(6495) < 3) {
					mes "[快乐獾]";
					mes "你的^00CC00伊甸园功勋徽章^000000不够。重新开始吧！";
					next;
					continue;
				}
				delitem 6495,3; //Para_Logro_Badge
				break;
			case 2:
				if (Zeny < 1000000) {
					mes "[快乐獾]";
					mes "你的^00CC00Zeny^000000不够。重新开始吧！";
					next;
					continue;
				}
				Zeny -= 1000000;
				break;
			case 3:
				mes "[快乐獾]";
				mes "我明白了，看看你是否想要别的东西！";
				close;
			}
			getitem 7938,40;// Light_Granule
			getitem 6244,40;// Gun_Power
			getitem 709,3;	// Izidor
			getitem 576,10;	// Prickly_Fruit
			getitem 6217,1;	// Mandragora_Flowerpot
			getitem 7939,3;	// Elder_Branch
			mes "[快乐獾]";
			mes "给你！还想要什么？";
			next;
		}
	}
	end;

//callsub L_Exchange,<badge cost>,<item id>,<amount>;
L_Exchange:
	if (countitem(6495) < getarg(0)) {
		mes "[快乐獾]";
		mes "你的^00CC00伊甸园功勋徽章^000000不够。重新开始吧！";
		return;
	}
	mes "[快乐獾]";
	mes sprintf("好的，我可以用你^0066CC%d 个伊甸园功勋徽章^000000兑换^ff0000%s^000000。",
				callfunc("F_InsertPlural",getarg(2),getitemname(getarg(1))), getarg(0));
	mes "要兑换吗？";
	next;
	if (select("是", "否") == 2) {
		mes "[快乐獾]";
		mes "我明白了，看看你是否想要别的东西！";
		return;
	}
	mes "[快乐獾]";
	mes "给你！还想要什么？";
	delitem 6495, getarg(0); //Para_Logro_Badge
	getitem getarg(1),getarg(2);
	return;
}

// Kafra Stacker
//============================================================
moc_para01,41,169,2	script	Kafra Stacker#eden	749,{
	if (checkweight(1201,1) == 0 || MaxWeight - Weight < 2000) {
		mes "- 请稍等！-";
		mes "- 你目前携带的物品 -";
		mes "- 重量太高了。-";
		mes "- 请稍后再来。-";
		mes "- 先把一些物品存入卡普拉仓库。-";
		close;
	}
	mes "[托马]";
	mes "我可以把你无法堆叠的卡普拉消耗品";
	mes "整齐地整理成堆叠物品！";
	next;
	mes "[托马]";
	mes "请理解，我每次只能";
	mes "整理 10 组物品，";
	mes "所以请继续和我交谈，直到";
	mes "每种物品都有 1 组为止！";
	next;
	while(1) {
		if(select("开始吧！:算了。") == 2)
			break;
		// Something strange goes on here, haven't quite figured it out...
		mes "[托马]";
		mes "已经整理好 10 组了！";
		mes "还要继续吗？";
		next;
	}
	mes "[托马]";
	mes "那好，回头见。";
	close;
}

// Code Redeemer
//============================================================
moc_para01,38,162,2	script	Code the Redeemer#Give1	405,{
	if (checkweight(1201,1) == 0 || MaxWeight - Weight < 2000) {
		mes "^0000ff请留步！";
		mes "你携带的物品太多，物品栏没有足够空间领取奖励。请腾出更多物品栏空间后再来接受挑战。^000000";
		close;
	}
	mes "[兑换员科德]";
	mes "欢迎你，"+strcharinfo(0)+"！";
	mes "我一直在等你。";
	next;
	mes "[兑换员科德]";
	mes "我是各种物品的发放员，";
	mes "像你这样的冒险者可以在网站上";
	mes "购买这些物品，";
	mes "或通过活动获得它们。";
	next;
	mes "[兑换员科德]";
	mes "^0000FF如果列表为空，";
	mes "就表示你还没有";
	mes "从购买网站购买物品，或输入";
	mes "对应的序列码。^000000";
	next;

	// If you have a code redemption system, write your SQL queries here.
	select("");

	close;
}

}

prt_cas_q,93,129,3	script	Queen#ep16_1	4_EP16_EGEO,{
	if (ep16_royal == 2 && ep16_gaobs == 0)
		callfunc("F_geoborg_text");
	if (ep16_gaobs == 1) {
		mes "[凯瑟琳·D·吉奥博格女王]";
		mes "欢迎。";
		mes "我是凯瑟琳·D·吉奥博格女王。";
		cutin "ep16gao_2",2;
		next;
		mes "[凯瑟琳·D·吉奥博格女王]";
		mes "如果我的骑士给你添了麻烦，我很抱歉。";
		mes "他们最近有点敏感，请理解。";
		emotion ET_SORRY;
		cutin "ep16gao_1",2;
		next;
		cutin "",255;
		if (select( "询问吉奥博格家族。", "离开房间。" ) == 2) {
			mes "[凯瑟琳·D·吉奥博格女王]";
			mes "我明白了。";
			mes "还有其他问题时随时回来。";
			cutin "ep16gao_1",2;
			next;
			mes "[凯瑟琳·D·吉奥博格女王]";
			mes "宴会厅正在为你们这些英雄举办宴会，请尽情享受。";
			cutin "ep16gao_2",2;
			close3;
		}
		mes "[凯瑟琳·D·吉奥博格女王]";
		mes "我们吉奥博格家族是开创这个世界的特里斯坦一世的后裔。我们家族世代诞生了许多国王和骑士。";
		cutin "ep16gao_1",2;
		next;
		mes "[凯瑟琳·D·吉奥博格女王]";
		mes "在举行的第一次皇家议会中，第四王子恩斯特被选为候选人。不过由于几起事件，他这次放弃了在皇家议会中的职位。";
		next;
		select("几起事件是什么意思？");
		mes "[凯瑟琳·D·吉奥博格女王]";
		mes "哦……我说漏嘴了。";
		mes "那些事件有点难以告诉你。";
		mes "你就当没听见吧。";
		cutin "ep16gao_3",2;
		next;
		mes "[凯瑟琳·D·吉奥博格女王]";
		mes "你来到了这里，但我没什么能告诉你的。";
		cutin "ep16gao_1",2;
		next;
		mes "[凯瑟琳·D·吉奥博格女王]";
		mes "还有问题的话，可以问这里的杰拉德和马丁。";
		mes "有紧急事务在身，没法多陪你，请见谅。";
		completequest 11400;// The Geoborgs
		setquest 11401;// The Geoborgs
		if (achievementinfo(130000, ACHIEVEINFO_COUNT6) == 0)
			achievementupdate(130000, ACHIEVEINFO_COUNT6, 1);
		ep16_gaobs = 2;
		if (isbegin_quest(7682) == 1 && isbegin_quest(5402) == 2 && isbegin_quest(7683) == 2 && isbegin_quest(7684) == 2 && ep16_wal > 1 && ep16_wig > 1 && ep16_lug > 1 && ep16_gaobs > 1) {
			completequest 7682;// Socializing Starts from an Eye Contact
			setquest 7685;// What Is the Next Thing on the Schedule ?
		}
		close3;
	}
	if (ep16_gaobs == 2) {
		mes "[凯瑟琳·D·吉奥博格女王]";
		mes "你来到了这里，但我没什么能告诉你的。";
		cutin "ep16gao_1",2;
		next;
		mes "[凯瑟琳·D·吉奥博格女王]";
		mes "还有问题的话，可以问这里的杰拉德和马丁。";
		mes "有紧急事务在身，没法多陪你，请见谅。";
		close3;
	}
	if (ep16_gaobs > 5 && ep16_gaobs < 14) {
		mes "[凯瑟琳·D·吉奥博格女王]";
		mes "你是说恩斯特王子？";
		mes "怎么了？";
		cutin "ep16gao_1",2;
		next;
		mes "[凯瑟琳·D·吉奥博格女王]";
		mes "他会来这里道早安，有时帮我工作，有时做其他事情。";
		cutin "ep16gao_2",2;
		next;
		mes "[凯瑟琳·D·吉奥博格女王]";
		mes "自从宴会开始后，他就把工作带到别处去了。";
		next;
		mes "[凯瑟琳·D·吉奥博格女王]";
		mes "他可能在宴会厅的某处。";
		close3;
	}
	if (ep16_gaobs == 14) {
		mes "[凯瑟琳·D·吉奥博格女王]";
		mes "你还没见过恩斯特王子吗？";
		mes "他刚来过，又出去了……";
		cutin "ep16gao_1",2;
		next;
		mes "[凯瑟琳·D·吉奥博格女王]";
		mes "我很担心我们家族的代表这样四处闲逛。";
		next;
		select("告诉她你听到的事。");
		mes "[凯瑟琳·D·吉奥博格女王]";
		mes "哦……";
		mes "亲爱的英雄，请别太在意这种传闻。";
		cutin "ep16gao_3",2;
		next;
		mes "[凯瑟琳·D·吉奥博格女王]";
		mes "这是我们吉奥博格家族应该自己解决的问题。";
		close3;
	}
	switch( rand(1,3) ) {
	case 1:
		mes "[凯瑟琳·D·吉奥博格女王]";
		mes "要在皇家议事厅使用最高品质的墨台？";
		mes "是书记员负责记录一切。为什么要买没人会用的奢侈品……";
		emotion ET_FRET;
		cutin "ep16gao_3",2;
		close3;
	case 2:
		mes "[凯瑟琳·D·吉奥博格女王]";
		mes "我的礼服已经够穿一辈子了。为什么还要继续制作……";
		mes "削减开支！";
		emotion ET_FRET;
		cutin "ep16gao_1.bmp",2;
		close3;
	case 3:
		mes "[凯瑟琳·D·吉奥博格女王]";
		mes "嗯……马洛尔王国的贸易请求……";
		mes "我应该尽快派使者处理……";
		cutin "ep16gao_2.bmp",2;
		close3;
	}
}

// Hall
prt_cas,73,244,5	script	Scarlet Jaha#ep16_1	1_F_LIBRARYGIRL,{
	if (ep16_gaobs < 3) {
		mes "[斯嘉丽·贾哈]";
		mes "哦，亲爱的冒险者，我能帮你什么？";
		emotion ET_SMILE;
		close;
	}
	if (ep16_gaobs == 3) {
		mes "[斯嘉丽·贾哈]";
		mes "哦，亲爱的冒险者，我能帮你什么？";
		emotion ET_SMILE;
		next;
		select("询问吉奥博格家族。");

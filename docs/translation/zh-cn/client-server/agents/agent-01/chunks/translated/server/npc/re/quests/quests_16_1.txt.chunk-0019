			5412,	// [Repeat]Warrior Discipline-Intangible
			5413;	// [Repeat]Warrior Discipline-Dragon
		.@size = getarraysize( .@quest_list );
		while( isbegin_quest(.@quest_list[.@i]) == 0 && .@i < .@size ) .@i++;

		if (.@i == .@size) {
			mes "[理查德伯爵]";
			mes "不知道你对训练奖励满意吗。";
			next;
			mes "[理查德伯爵]";
			mes "目前很难给你更高的报酬。请把它当作兼职工作来做。";
			next;
			mes "[理查德伯爵]";
			mes "这对你来说可能很明显。不过你训练得越多，理查德家族获得的利益就越多。我们愿意为此付费。";
			close3;
		}
		mes "[理查德伯爵]";
		mes "哦！你一定正在参加训练。感觉训练怎么样？";
		next;
		mes "[理查德伯爵]";
		.@r = rand(1,10);
		if (.@r == 1) {
			emotion 29;
			mes "我年轻时也参加过训练。这让我想起了美好的往事。";
		}
		else if (.@r == 2) {
			emotion 20;
			mes "这里有各种训练项目。请选择想参加的项目。嗯，冒险者通常会选择他们惯常做的事。";
		}
		else if (.@r == 3) {
			emotion 0;
			mes "放松警惕就会发生事故。一定要时刻小心。";
		}
		else if (.@r == 4) {
			emotion 33;
			mes "我认为战士最重要的是挑战精神。挑战自我，迈向更高层次……这是最重要的事。";
		}
		else if (.@r == 5) {
			emotion 21;
			mes "战士之歌曾在普隆德拉酒馆很受欢迎。最近听不到它，我很遗憾。";
		}
		else {
			.@r = rand(1,6);
			if (.@r == 1) emotion 58;
			else if (.@r == 2) emotion 59;
			else if (.@r == 3) emotion 60;
			else if (.@r == 4) emotion 61;
			else if (.@r == 5) emotion 62;
			else
				emotion 63;
			mes "你喜欢赌博吗？那种紧张感是不是让你感觉像战场上的战士？";
		}
		close3;
	}
}

// GM NPC
prt_cas_q,120,100,4	script	Helper for the Royal Richard#EP161DY	4_M_6THPRIN2,{
	if (callfunc("F_GM_NPC",1854,0,1,9999) < 1)
		end;
	mes "[理查德王室助手]";
	mes "请选择要使用的服务。";
	next;
	switch( select( "设置任务开始", "重置冷却时间。", "重置任务", "查看当前状态" ) ) {
	case 1:
		mes "[理查德王室助手]";
		mes "已设置为开始理查德家族任务。";
		next;
		select("设置");
		if (isbegin_quest(7681) == 0)
			setquest 7681;
		if (isbegin_quest(7681) == 1)
			completequest 7681;
		if (isbegin_quest(7682) == 0)
			setquest 7682;
		if (isbegin_quest(7682) == 1)
			completequest 7682;
		mes "[理查德王室助手]";
		mes "完成";
		close;
	case 2:
		mes "[理查德王室助手]";
		mes "重置理查德家族战斗训练的冷却时间。";
		next;
		select("设置");
		if (isbegin_quest(5414) > 0)
			erasequest 5414;
		mes "[理查德王室助手]";
		mes "完成";
		close;
	case 3:
		mes "[理查德王室助手]";
		mes "重置所有理查德相关任务。";
		next;
		select("设置");
		mes "[理查德王室助手]";
		for ( .@quest_id = 5402; .@quest_id <= 5414; ++.@quest_id ) {
			if (isbegin_quest(.@quest_id) > 0)
				erasequest .@quest_id;
			mes "" + .@quest_id + " 删除";
		}
		next;
		mes "[理查德王室助手]";
		mes "完成";
		close;
	case 4:
		mes "[理查德王室助手]";
		mes "7681(" + isbegin_quest(7681) + ")/7682(" + isbegin_quest(7682) + ")";
		mes "5402(" + isbegin_quest(5402) + ")/5403(" + isbegin_quest(5403) + ")";
		mes "5404(" + checkquest(5404,HUNTING) + ")/5405(" + checkquest(5405,HUNTING) + ")/5406(" + checkquest(5406,HUNTING) + ")/5407(" + checkquest(5407,HUNTING) + ")";
		mes "5408(" + checkquest(5408,HUNTING) + ")/5409(" + checkquest(5409,HUNTING) + ")/5410(" + checkquest(5410,HUNTING) + ")/5411(" + checkquest(5411,HUNTING) + ")";
		mes "5412(" + checkquest(5412,HUNTING) + ")/5413(" + checkquest(5413,HUNTING) + ")/5414(" + checkquest(5414,PLAYTIME) + ")";
		close;
	}
	end;
}

function	script	F_geoborg_text	{
	mes "[马丁护卫]";
	mes "那里！站住！";
	mes "请接受安全检查。";
	npctalk "那里！站住！", "Bodyguard#ep16_1_g", bc_self;
	emotion ET_SURPRISE, getnpcid(0, "Bodyguard#ep16_1_m");
	emotion ET_SURPRISE, getnpcid(0, "Bodyguard#ep16_1_g");
	next;
	mes "[马丁护卫]";
	mes "请把身份证明和随身物品放在桌上，面向墙站好……";
	next;
	mes "[杰拉德护卫]";
	mes "马丁！你在做什么？";
	mes "别对房间里的客人无礼！我说过了。";
	emotion ET_HUK, getnpcid(0, "Bodyguard#ep16_1_g");
	next;
	mes "[马丁护卫]";
	mes "这是为了女王的安全。";
	next;
	mes "[杰拉德护卫]";
	mes "你靠近女王是为了安全，不是为了无礼地赶走客人。";
	emotion ET_ANGER, getnpcid(0, "Bodyguard#ep16_1_g");
	next;
	mes "[马丁护卫]";
	mes "王宫现在这么混乱。抱着这种随便的想法，怎么保护女王！";
	next;
	mes "[杰拉德护卫]";
	mes "帝国法令期间我们也无能为力！";
	next;
	mes "[马丁护卫]";
	mes "现在帝国法令应该只是……";
	emotion ET_THINK, getnpcid(0, "Bodyguard#ep16_1_m");
	next;
	mes "[女王]";
	mes "外面真吵。";
	cutin "ep16gao_1",2;
	next;
	cutin "",255;
	mes "[杰拉德护卫]";
	mes "啊！陛下！";
	mes "非常抱歉。";
	mes "这里有一位客人。";
	setquest 11400;// The Geoborgs
	ep16_gaobs = 1;
	emotion ET_SURPRISE, getnpcid(0, "Bodyguard#ep16_1_g");
	close;
}

prt_cas_q,81,131,0	script	#ep16_1Geoborg	HIDDEN_WARP_NPC,5,5,{
	end;
OnTouch:
	if (ep16_royal == 2 && ep16_gaobs == 0)
		callfunc("F_geoborg_text");
	end;
}

// Geoborg
prt_cas_q,87,132,6	script	Bodyguard#ep16_1_m	4_M_JOB_KNIGHT1,{
	if (ep16_royal == 2 && ep16_gaobs == 0)
		callfunc("F_geoborg_text");
	if (ep16_gaobs == 1) {
		mes "[杰拉德护卫]";
		mes "务必礼貌接待女王。";
		close;
	}
	if (ep16_gaobs == 2) {
		mes "[马丁护卫]";
		mes "我有东西给你。请和这里的杰拉德谈谈。";
		close;
	}
	if (ep16_gaobs == 4 || ep16_gaobs == 5) {
		mes "[马丁护卫]";
		mes "不知道为什么，斯嘉丽和利迪恩长期关系不佳。";
		next;
		mes "[马丁护卫]";
		mes "她们年龄相近，如果能成为朋友就好了……";
		mes "不过她们的性格都很强势。";
		next;
		mes "[马丁护卫]";
		mes "当然，斯嘉丽看起来年轻好几倍。";
		mes "据说这是贾哈家族的特征。";
		close;
	}
	if (ep16_gaobs > 6 && ep16_gaobs <= 13) {
		mes "[马丁护卫]";
		mes "恩斯特告诉我他要去宴会厅。";
		mes "不知道他还在那里吗。";
		close;
	}
	if (ep16_gaobs == 14) {
		mes "[马丁护卫]";
		mes "哈……";
		close;
	}
	mes "[马丁护卫]";
	mes "你还有其他事吗？";
	close;
}


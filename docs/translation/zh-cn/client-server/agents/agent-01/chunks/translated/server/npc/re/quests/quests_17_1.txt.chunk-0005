	}
	if (isbegin_quest(17012)) {
		mes "[Gray]";
		mes "快去<NAVI>[文件存储室]<INFO>lhz_in01,32,264,0,000,0</INFO></NAVI>，趁没人注意到你之前赶快。";
		close;
	}
	mes "[Gray]";
	mes "你没有别的事要做吗？";
	close;

OnInit:
	questinfo(QTYPE_QUEST,QMARK_YELLOW,"isbegin_quest(17011) == 1");
	end;
}

lhz_in01,32,264,5	script	Staff#171_lhzin4	4_M_HUMAN_02,{
	if (isbegin_quest(17012) == 1) {
		mes "[Staff]";
		mes "你好，这里是文件存储室。";
		next;
		cloakoffnpc "Lazy#171_lhzin4",getcharid(0);
		cloakoffnpc "Kaya Tos#171_lhzin4",getcharid(0);
		cloakoffnpc "Aas#171_lhzin4",getcharid(0);
		mes "[Staff]";
		mes "啊！我明白了。你在找帕特里克·考夫曼的调职记录？";
		npctalk "这里的书香真好闻。我的梦想是成为图书管理员。以后我应该去做这个。";
		unittalk getcharid(3),strcharinfo(0) + " : I don't that would fit you...",bc_self;
		next;
		cutin "ep171_kaya01",0;
		mes "[Kaya]";
		mes "是的，所以我们才来这里。找到我们要找的东西了吗？";
		next;
		cutin "",255;
		mes "[Staff]";
		mes "帕特里克·考夫曼。调职代码 12-4332。";
		next;
		mes "[Staff]";
		mes "他原本在设施维护部门工作，后来调往了新的设施。";
		mes "上面写着主任麦克唐纳亲自来到这里，提交了一份调职人员名单。";
		next;
		cutin "ep171_kaya01",0;
		mes "[Kaya]";
		mes "那份名单还在吗？";
		next;
		cutin "",255;
		mes "[Staff]";
		mes "哦，那个？等一下……";
		next;
		mes "[Staff]";
		mes "哦，在这里。我找到了。";
		next;
		cutin "ep171_kaya01",0;
		mes "[Kaya]";
		mes "黛西，请你比较一下名单。";
		next;
		cutin "16lei_02",2;
		mes "[Lazy]";
		mes "嗯……两份名单上的名字有很多重叠。我预料到了……但还是有点困惑。";
		next;
		cutin "ep171_kaya01",0;
		mes "[Kaya]";
		mes "考夫曼还在麦克唐纳的实验室工作吗？";
		next;
		cutin "",255;
		mes "[Staff]";
		mes "嗯……实际上，有些设施维护员工在实验室外工作。";
		mes "帕特里克来自同一个部门，所以他可能也是这样。";
		next;
		cutin "ep171_kaya01",0;
		mes "[Kaya]";
		mes "我听说至少一年内不允许调职人员，但考夫曼为什么会被调走？";
		next;
		cutin "",255;
		mes "[Staff]";
		mes "嗯……这里有这样做的理由。收到实验室的请求后，我们就会批准。这是最高优先级。";
		next;
		cutin "ep171_kaya01",0;
		mes "[Kaya]";
		mes "那么考夫曼现在在哪里？";
		next;
		cutin "",255;
		mes "[Staff]";
		mes "正如我之前所说，我日夜不停地工作……这里有很多实验室，我不确定哪些还在运作。";
		next;
		mes "[Staff]";
		mes "我们不会记录总部内部所有人的行程和动向。不过我听说过不少消息。";
		mes "详细记录可能在他所在的实验室，或者其他实验室里。";
		next;
		cutin "16lei_01",2;
		mes "[Lazy]";
		mes "他的假期怎么样？休息得好吗？";
		npctalk "要是我在这里工作，肯定会累得没法休息。","Lazy#171_lhzin4",bc_self;
		next;
		cutin "",255;
		mes "[Staff]";
		mes "假期……他已经用完了所有假期。嗯……他在年末开车离开了。";
		npctalk "哦~他直到年末都没能休息。莱肯贝尔真是个特别的地方~","Lazy#171_lhzin4",bc_self;
		npctalk "绝对不是！","Aas#171_lhzin4",bc_self;
		next;
		cutin "16lei_02",2;
		mes "[Lazy]";
		mes "他假期去了哪里？我已经知道答案了，但这里有人不相信我。";
		npctalk "告诉我他做了什么~","Lazy#171_lhzin4",bc_self;
		next;
		cutin "",255;
		mes "[Staff]";
		mes "我们不干涉员工如何度过私人时间，也不管他们去哪里。";
		next;
		cutin "ep171_kaya01",0;
		mes "[Kaya]";
		mes "再确认一件事。马库斯·霍尔兹曼在名单上。他现在在哪里工作？";
		next;
		cutin "",255;
		mes "[Staff]";
		mes "让我看看，马库斯·霍尔兹曼？等一下……";
		progressbar_npc "00FF00",1;
		next;
		mes "[Staff]";
		mes "嗯，霍尔兹曼去了辛克莱的实验室。";
		next;
		cutin "16lei_02",2;
		mes "[Lazy]";
		mes "他也用完了所有假期吗？";
		next;
		cutin "",255;
		mes "[Staff]";
		mes "是的……他在年末开车离开，用完了所有假期……";
		next;
		cutin "ep171_kaya01",0;
		mes "[Kaya]";
		mes "实验室在哪里？";
		next;
		cutin "",255;
		mes "[Staff]";
		mes "让我看看……实验室在艾音布罗克外围区域的外侧。";
		mes "麦克唐纳实验室位于艾音布罗克山脉的^0000FF第 01 区—95-146 段^000000，辛克莱实验室位于艾音布罗克山脉的第 11 区—45-156 段。";
		next;
		cutin "16lei_02",2;
		mes "[Lazy]";
		mes "就是这样。当然，我也知道答案，但还是问你一下：帕特里克和马库斯还在雷根贝勒工作吗？";
		next;
		cutin "",255;
		mes "[Staff]";
		mes "当然。他们工作就会获得报酬。要是离开，就拿不到钱了，对吧？";
		next;
		cutin "16lei_02",2;
		mes "[Lazy]";
		mes "当然，这是常识~";
		npctalk "……","Kaya Tos#171_lhzin4",bc_self;
		npctalk "我们真的要再讨论这个吗？","Aas#171_lhzin4",bc_self;
		unittalk getcharid(3),strcharinfo(0) + " : Don't worry, he will tire himself out after a while.",bc_self;
		next;
		cutin "16lei_01",2;
		mes "[Lazy]";
		mes "现在去这些新实验室吧。那里可能还能查到更多信息。";
		next;
		select("我们要怎么做？");
		cutin "16lei_03",2;
		mes "[Lazy]";
		mes "我们可以一起去。我们就是为此来到这里的。";
		next;
		cutin "ep171_as01",0;
		mes "[Aas]";
		mes "不如节省时间，之后再共享信息？我们分头行动，在指定地点再次会合。";
		next;
		cutin "16lei_01",2;
		mes "[Lazy]";
		mes "好主意。那我和你一起去辛克莱的实验室。";
		mes "冒险者和贵宾去麦克唐纳的实验室。调查完成后，我们在麦克唐纳实验室会合。";
		next;
		cutin "ep171_as02",0;
		mes "[Aas]";
		mes "为什么？为什么我要和你去？我和副总统一起回去不是更好吗？";
		next;
		cutin "16lei_02",2;
		mes "[Lazy]";
		mes "你忘了吗？副总统希望这次行动尽可能公正。";
		mes "你会相信我和冒险者的调查结果吗？";
		npctalk "我就是不值得信任的典型~","Lazy#171_lhzin4",bc_self;
		next;
		cutin "16lei_03",2;
		mes "[Lazy]";
		mes "你想给副总统怀疑我们的理由吗？我们不能这样做。";
		npctalk "有护卫在，应该不会太难。","Lazy#171_lhzin4",bc_self;
		next;
		cutin "ep171_kaya01",0;
		mes "[Kaya]";
		mes "我同意黛西的想法。这最合理。";
		next;
		cutin "ep171_as02",0;
		mes "[Aas]";
		mes "副总统！我来这里就是为了保护您！";
		next;
		cutin "ep171_kaya01",0;
		mes "[Kaya]";
		mes "我不会再说第二遍。";
		npctalk "好吧……","Aas#171_lhzin4",bc_self;
		next;
		cutin "16lei_01",2;
		mes "[Lazy]";
		mes "我们现在走。你前往<NAVI>[麦克唐纳实验室]<INFO>ein_fild01,95,146,0,000,0</INFO></NAVI>，完成后等我们。";
		completequest 17012;
		setquest 17013;
		next;
		cutin "",255;
		mes "[Staff]";
		mes "请看一下。如果需要什么，告诉我！";
		close2;
		cloakonnpc "Lazy#171_lhzin4",getcharid(0);
		cloakonnpc "Kaya Tos#171_lhzin4",getcharid(0);
		cloakonnpc "Aas#171_lhzin4",getcharid(0);
		end;
	}
	if (isbegin_quest(17013) == 1) {
		mes "[Staff]";
		mes "<NAVI>[麦克唐纳实验室]<INFO>ein_fild01,95,146,0,000,0</INFO></NAVI>位于艾因布洛克外围区域。请小心，那里很危险。";
		close;
	}
	mes "[Staff]";
	mes "如果要找文件或书，请去接待处询问工作人员。";
	close;

OnInit:
	questinfo(QTYPE_QUEST,QMARK_YELLOW,"isbegin_quest(17012) == 1");
	end;
}

rgsr_in,161,85,3	script	Laboratory Staff#171_rgsrin	4_LGTSCIENCE,{
	if (isbegin_quest(17009) == 1) {
		mes "[Staff]";
		mes "这里禁止外人进入，请离开。";
		next;
		cloakoffnpc "Lazy#171_rgsrin",getcharid(0);
		cloakoffnpc "Kaya Tos#171_rgsrin",getcharid(0);
		cloakoffnpc "Aas#171_rgsrin",getcharid(0);
		cutin "16lei_01",2;
		mes "[Lazy]";
		mes "你好。你们这么忙，连什么时候有人死了都不知道？到底发生了什么？你不觉得这是大事吗？";
		next;
		cutin "",255;
		mes "[Staff]";
		mes "大家请出来。";
		next;
		cutin "ep171_as01",0;
		mes "[Aas]";
		mes "你好，梅德。我一直期待再次见到你。";
		next;
		cutin "",255;
		mes "[Med]";
		mes "阿斯？天啊，真的是你吗，阿斯？你还好吗？你来这里做什么？你要去审问那个背叛我们、投靠另一边的人吗？";
		npctalk "我没那么容易放弃。","Lazy#171_rgsrin",bc_self;
		unittalk getcharid(3),strcharinfo(0) + "：你真是天生的。",bc_self;
		next;
		mes "[Med]";
		mes "你要逮捕这些叛徒，残酷地拷问他们，让他们说出所有罪行吗？";
		mes "这就像间谍小说！";
		npctalk "哦哦！这里还有人的想象力很丰富。","Lazy#171_rgsrin",bc_self;
		next;
		cutin "ep171_as01",0;
		mes "[Aas]";
		mes "我不是为此而来。你见过一名叫帕特里克·考夫曼的设施维护员工吗？他现在在哪里？";
		next;
		cutin "",255;
		mes "[Med]";
		mes "帕……谁？帕特里克·考夫曼？那是谁？我不知道……哦！你问过<NAVI>[萨米]<INFO>rgsr_in,12,46,0,000,0</INFO></NAVI>了吗？";
		mes "萨米应该知道更多。他负责这里的人力。你去见见他吧。";
		next;
		cutin "ep171_kaya01",0;
		mes "[Kaya]";
		mes "谢谢你的帮助。继续重建这座实验室吧。";
		next;
		cutin "",255;
		mes "[Med]";
		mes "你愿意告诉我你是谁吗？";
		next;
		cutin "16lei_02",2;
		mes "[Lazy]";
		mes "这些人甚至不认识自己效力的副总统。";
		next;
		cutin "",255;
		mes "[Med]";
		mes "啊！！原来是您，非常抱歉！我会尽力的！";
		next;
		cutin "16lei_01",2;
		mes "[Lazy]";
		mes "我们现在应该去<NAVI>[这里]<INFO>rgsr_in,12,46,0,000,0</INFO></NAVI>~";
		completequest 17009;
		setquest 17010;
		close2;
		cutin "",255;
		cloakonnpc "Lazy#171_rgsrin",getcharid(0);
		cloakonnpc "Kaya Tos#171_rgsrin",getcharid(0);
		cloakonnpc "Aas#171_rgsrin",getcharid(0);
		end;
	}
	if (isbegin_quest(17010) == 1) {
		mes "[Med]";
		mes "如果想了解更多，请在入口询问<NAVI>[萨米]<INFO>rgsr_in,12,46,0,101,0</INFO></NAVI>。";
		close;
	}
	mes "[Staff]";
	mes "这里禁止外人进入，请离开。";
	close;

OnInit:
	questinfo(QTYPE_QUEST,QMARK_YELLOW,"isbegin_quest(17009) == 1");
	end;
}

rgsr_in,12,46,7	script	Staff#171_rgsrin	4_M_04,{
	if (isbegin_quest(17010) == 1) {
		mes "[Staff]";
		mes "你来这里做什么？没有预约就不能进入。";
		next;
		cloakoffnpc "Lazy#171_rgsrin2",getcharid(0);
		cloakoffnpc "Kaya Tos#171_rgsrin2",getcharid(0);
		cloakoffnpc "Aas#171_rgsrin2",getcharid(0);
		cutin "ep171_as01",0;
		mes "[Aas]";
		mes "嘿，萨米。能问你几个问题吗？";
		next;
		cutin "",255;
		mes "[Sammy]";
		mes "阿斯？你来这里做什么……？";
		next;
		cutin "16lei_01",2;
		mes "[Lazy]";
		mes "下午好。我们想问你几个问题。";
		next;
		cutin "",255;
		mes "[Sammy]";
		mes "你想问我什么？";
		next;
		cutin "16lei_01",2;
		mes "[Lazy]";
		mes "这位是和我们一起来的副总统。";
		next;
		cutin "",255;
		mes "[Sammy]";
		mes "副总统？";
		next;
		cutin "ep171_as01",0;
		mes "[Aas]";
		mes "是的，这位是副总统卡娅·托斯。";
		next;
		cutin "ep171_kaya01",0;
		mes "[Kaya]";
		mes "很高兴见到你，我是卡娅·托斯。";
		next;
		cutin "",255;
		mes "[Sammy]";
		mes "天啊，副总统。您怎么会来这种地方……哦，您想知道什么？";
		next;
		cutin "16lei_01",2;
		mes "[Lazy]";
		mes "哇，态度变得真快。我们只要说出那两个神奇的词：副总统。";
		mes "太容易了。";
		unittalk getcharid(3),strcharinfo(0) + " : It does look a little to easy.",bc_self;
		next;
		mes "[Lazy]";
		mes "看来我以后应该多用用这招？";
		unittalk getcharid(3),strcharinfo(0) + " : Then you'll be caught Lazy.",bc_self;
		next;
		cutin "ep171_kaya01",0;
		mes "[Kaya]";
		mes "我想知道帕特里克·考夫曼在哪里。他是被派到这里的设施维护员工。";
		next;
		cutin "",255;
		mes "[Sammy]";
		mes "帕……帕特里克·考夫曼……帕特里克……嗯……啊！我想起来了！";
		sleep2 1000;
		specialeffect EF_DA_SPACE,AREA,"Pat#171_rgsrin";
		specialeffect EF_DA_SPACE,AREA,"Laboratory Staff#171_rgsrin2";
		cloakoffnpc "Pat#171_rgsrin",getcharid(0);
		cloakoffnpc "Laboratory Staff#171_rgsrin2",getcharid(0);
		sleep2 1500;
		npctalk "下周你就要加入新的实验室了。搬走后别太孤单。","",bc_self;
		sleep2 2000;
		npctalk "为什么？我喜欢这里。","Pat#171_rgsrin",bc_self;
		sleep2 2000;
		npctalk "你生病了吗……或者有什么特别的疾病吗？","Laboratory Staff#171_rgsrin2",bc_self;
		sleep2 2000;
		npctalk "不，我的身体很强壮。","Pat#171_rgsrin",bc_self;
		sleep2 2000;
		cloakonnpc "Pat#171_rgsrin",getcharid(0);
		cloakonnpc "Laboratory Staff#171_rgsrin2",getcharid(0);
		next;
		mes "[Sammy]";
		mes "……然后他就被派到了另一间实验室。";
		next;
		cutin "ep171_kaya01",0;
		mes "[Kaya]";
		mes "至少一年内不应该调动新员工，你为什么总是要求增加人手？";
		next;
		cutin "",255;
		mes "[Sammy]";
		mes "是吗……？为什么会派这么多人来？我^0000FF从没要求增加大楼里的人手^000000。有人来到这里时，我以为他们只是调职。";
		next;
		cutin "",255;
		mes "[Sammy]";
		mes "所以帕特来到这里时，我以为他也是调职。尤其当时因为新研究设施，维护和后勤部门的队伍……";
		mes "^0000FF经常调动人员。^000000";
		npctalk "所以我才不知道这件事。","Aas#171_rgsrin2",bc_self;
		next;
		cutin "ep171_kaya01",0;
		mes "[Kaya]";
		mes "调职后的实验室在哪里？";
		next;
		cutin "",255;
		mes "[Sammy]";
		mes "我不知道确切位置。";
		mes "应该在^0000FF艾因布洛克外围区域^000000的某处。我听说很多新设施会进行无法在城市里完成的危险实验，所以把人手派到了外面。";
		next;
		mes "[Sammy]";
		mes "但是……也许……调职还有别的原因？到底……";
		mes "那些人后来怎么样了？";
		next;
		cutin "16lei_03",2;
		mes "[Lazy]";
		mes "新的实验室……我没能调查到。那是一间需要很多人手的新实验室，但我找不到它。你觉得呢？能闻到我们越来越接近真相了吗？";
		unittalk getcharid(3),strcharinfo(0) + " : It's very surprising.",bc_self;
		npctalk "对吧？而且真没礼貌。","Lazy#171_rgsrin2",bc_self;
		next;
		cutin "ep171_kaya01",0;
		mes "[Kaya]";
		mes "这肯定不在我收到的文件里。上面只提到离职和少量调职，所有细节都被省略了。";
		next;
		cutin "16lei_03",2;
		mes "[Lazy]";
		mes "他们是故意那样写的，";
		mes "足够多疑的人就能看出真相。";
		next;
		mes "[Lazy]";
		mes "也许有人不想让你知道真相，故意删去了那些细节。否则原始文件中应该会有记录。";
		npctalk "他们真是有条理。","Lazy#171_rgsrin2",bc_self;
		next;
		cutin "ep171_kaya02",0;
		mes "[Kaya]";
		mes "新的设施……我必须查出它在哪里。也许还有更多我们不知道的事。";
		next;
		cutin "16lei_02",2;
		mes "[Lazy]";
		mes "你一直说个不停。如果有人死了，我必须亲眼确认。";
		next;
		cutin "ep171_kaya01",0;
		mes "[Kaya]";
		mes "我们从<NAVI>[办公室]<INFO>lhz_in01,80,210,0,000,0</INFO></NAVI>再获取些信息吧。";
		next;
		cutin "16lei_01",2;
		mes "[Lazy]";
		mes "你要去人力资源部吗？";
		mes "我已经去过那里了。";
		next;
		cutin "ep171_as01",1;
		mes "[Aas]";
		mes "你对这家企业调查得有多深入？";
		next;
		cutin "16lei_02",2;
		mes "[Lazy]";
		mes "哦不~你还认为我是骗子。";
		mes "你还能在哪里找到像我这么值得信任的人？";
		next;
		select("你刚才说什么？");
		cutin "16lei_03",2;
		mes "[Lazy]";
		mes "这里的一名员工说，我的一个远房亲戚去世了，留下了一大笔遗产。";
		mes "我没能联系上他，所以来到这里寻找留给我的东西。";
		next;
		select("你相信他？");
		cutin "16lei_02",2;
		mes "[Lazy]";
		mes "为什么不信？冒险者你有亲戚吗？我不知道……";
		mes "浪漫与刺激，嘿嘿。我们一直在等待这个梦想成真。";
		unittalk getcharid(3),strcharinfo(0) + " : Why look at people with such eyes.",bc_self;
		next;
		cutin "ep171_as01",1;
		mes "[Aas]";
		mes "哦……";
		unittalk getcharid(3),strcharinfo(0) + " : Your eyes are glowing!",bc_self;
		next;
		cutin "16lei_01",2;
		mes "[Lazy]";
		mes "你的护卫懂什么浪漫吗？";
		next;
		cutin "ep171_kaya01",0;
		mes "[Kaya]";
		mes "没时间说这些了，我们走。";
		completequest 17010;
		setquest 17011;
		close2;
		cutin "",255;
		cloakonnpc "Lazy#171_rgsrin2",getcharid(0);
		cloakonnpc "Kaya Tos#171_rgsrin2",getcharid(0);
		cloakonnpc "Aas#171_rgsrin2",getcharid(0);
		end;
	}
	if (isbegin_quest(17011) == 1) {

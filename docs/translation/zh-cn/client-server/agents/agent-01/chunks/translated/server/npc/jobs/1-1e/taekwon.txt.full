//===== rAthena Script =======================================
//= Taekwon Job Quest
//===== Description: =========================================
//= [Official Conversion]
//= Taekwon Job Change Quest
//===== Changelogs: ==========================================
//= 1.0 Replaced previous TK Job Quest with this one [Tsuyuki]
//= 1.1 Rewrote to the Aegis Standars. [Samuray22]
//= 1.2 Fixed position the npc is facing. [Kisuka]
//= 1.3 Added Quest Log commands. [Kisuka]
//= 1.4 Removed use of 'goto', and fixed some indentation. [L0ne_W0lf]
//= 1.5 Split into renewal [Lemongrass]
//============================================================

-	script	Phoenix::PhoenixTKJobChange	-1,{
	if(Upper == 2) {
		mes "[Phoenix]";
		mes "你好，孩子。";
		close;
	} else if(Class == Job_Taekwon) {
		mes "[Phoenix]";
		mes "你的训练进行得";
		mes "如何？随着你的";
		mes "技巧变得更加";
		mes "精湛或华丽，";
		mes "永远不要忘记你";
		mes "始终可以依靠基础。";
		close;
	} else if(Class > Job_Novice) || (Class == Job_Novice && TK_Q == 0) {
		mes "[Phoenix]";
		mes "这片土地。我们曾经";
		mes "美丽的世界如今已被";
		mes "邪恶污染：有太多";
		mes "人类被黑暗";
		mes "腐化，也有太多怪物";
		mes "威胁无辜者……";
		next;
		mes "[Phoenix]";
		mes "这个世界肆虐的灾祸";
		mes "对普通人类来说太过";
		mes "沉重，他们无法";
		mes "独自抵抗如此";
		mes "压倒性的危机。然而，人";
		mes "必须立志挑战逆境。";
		next;
		mes "[Phoenix]";
		mes "因此，我致力于";
		mes "让自己变得更强。";
		mes "我一直训练以实现";
		mes "启蒙，钻研一种磨炼身心的技艺，";
		mes "并希望与世界分享。";
		next;
		mes "[Phoenix]";
		mes "我也许无法独自改变";
		mes "世界，但我不会停止";
		mes "训练自己的";
		mes "精神与身体。";
		mes "我知道答案";
		mes "终会到来……";
		next;
		if (Class != Job_Novice) {
			mes "[Phoenix]";
			mes "尊贵的冒险者：";
			mes "如果你认识任何";
			mes "尚未选择人生道路、";
			mes "请把他推荐给我。";
			mes "如果他感兴趣，";
			mes "我可以传授我的技艺……";
			close;
		}
		mes "[Phoenix]";
		mes "如果你还没有决定";
		mes "今后要走的人生";
		mes "道路，请考虑成为";
		mes "我的技艺传承者。";
		mes "这并不容易，但会带给你强大的力量……";
		next;
		if(select("好的，我加入你。","不用了，谢谢。") == 1) {
			if(!callfunc("F_CanChangeJob")) {
				mes "[Phoenix]";
				mes "真遗憾！";
				mes "你还没有准备好";
				mes "在我的指导下开始训练，";
				mes "以你目前的";
				mes "职业等级还不够。达到职业等级 9 或更高后再回来。";
				close;
			}
			mes "[Phoenix]";
			mes "很好……我接受你";
			mes "成为我的学生。开始";
			mes "训练时，必须先";
			mes "锻炼你的身体，";
			mes "才能施展将要学习的";
			mes "技能。";
			next;
			if(BaseLevel > 19) {
				mes "[Phoenix]";
				mes "嗯。我看得出你已经";
				mes "进行了充分的身体";
				mes "新手训练。很好。现在准备";
				mes "精神训练。深呼吸，";
				mes "准备好后告诉我。";
				set TK_Q, 2;
				setquest 6001;
				close;
			}
			mes "[Phoenix]";
			mes "心灵不一定";
			mes "受身体限制，但若不融合身心，";
			mes "就永远无法发挥真正潜力。去获得 ^FF00001 个";
			mes "基础等级^000000，然后回来。";
			next;
			set TAEK_Q, BaseLevel;
			set TK_Q, 1;
			setquest 6000;
			mes "[Phoenix]";
			mes "我知道这对新手来说";
			mes "并不容易，但你必须";
			mes "为这份职业的";
			mes "艰辛做好准备。下次见面时，";
			mes "我期待你变得更强";
			mes "。";
			close;
		}
		mes "[Phoenix]";
		mes "我明白。人生有许多道路，但你一次只能选择其中一条。我希望你以自己的方式";
		mes "以自己的方式追求";
		mes "启蒙吧，冒险者。";
		close;
	}
	switch(TK_Q) {
	case 1:
		if(BaseLevel > TAEK_Q) {
			set TK_Q, 2;
			changequest 6000,6001;
			mes "[Phoenix]";
			mes "很好。我感觉到你";
			mes "更加契合自己的";
			mes "内在力量。这是";
			mes "提升等级的自然结果。";
			mes "我们可以继续";
			mes "下一阶段的训练了。";
			close;
		}
		mes "[Phoenix]";
		mes "你必须再获得 ^FF00001 个";
		mes "基础等级^000000，以证明你";
		mes "能够承受这份职业";
		mes "带来的艰辛。永远不要";
		mes "忽视训练。";
		close;
	case 2:
		mes "[Phoenix]";
		mes "作为精神训练，";
		mes "我会问你一系列";
		mes "问题来考验你的精神。";
		mes "放松。尽可能诚实地";
		mes "回答。你的意志和";
		mes "信念将受到考验。";
		next;
		mes "[Phoenix]";
		mes "作为我的技艺传承者，";
		mes "在战斗中迅速";
		mes "做出最佳决定的能力";
		mes "是必需的。现在";
		mes "开始提问。";
		next;
		mes "[Phoenix]";
		mes "当你遇到";
		mes "巨大困难时，通常";
		mes "会如何应对？";
		next;
		switch(select( "正面迎击。:想办法避开。:重新整队并分析问题。")) {
		case 1:
			mes "[Phoenix]";
			mes "是的，这正是我想要的";
			mes "答案。即使你一开始无法";
			mes "解决问题，我们也能从";
			mes "这种坚定的决心中受益。";
			mes "不要让任何障碍";
			mes "阻挡你。";
			next;
			mes "[Phoenix]";
			mes "即使失败，只有当你";
			mes "全力以赴时，才能从";
			mes "经历中学习。";
			mes "敷衍的尝试很少带来";
			mes "有益的结果。";
			mes "丰硕成果。";
			next;
			mes "[Phoenix]";
			mes "既然你已经理解";
			mes "意志的重要性，我们将";
			mes "继续";
			mes "下一个问题。";
			next;
			break;
		case 2:
			mes "[Phoenix]";
			mes "蠢货！逃避挑战，";
			mes "你怎么能成熟？恐惧";
			mes "有时是能救命的";
			mes "健康反应，但真正的";
			mes "懦弱令人鄙夷。";
			mes "真正的懦弱令人鄙夷。";
			next;
			mes "[Phoenix]";
			mes "听到你这样说";
			mes "让我失望。不要再";
			mes "对我说这种话。";
			mes "嗯。思考勇气与懦弱的";
			mes "含义，然后";
			mes "再来和我说话。";
			close;
		case 3:
			mes "[Phoenix]";
			mes "重新整队？被击败后这样做";
			mes "是有好处的。";
			mes "但最好在遇到问题时";
			mes "就正面面对。";
			mes "你不会总有";
			mes "重新整队的余裕。";
			next;
			mes "[Phoenix]";
			mes "问题可以预测";
			mes "并分析，但我认为";
			mes "立即撤退并不明智。";
			mes "思考你的恐惧，";
			mes "以及你定义的";
			mes "失败。然后回来找我。";
			close;
		}
		mes "[Phoenix]";
		mes "旅途中，你会";
		mes "遇到许多有着不同";
		mes "背景和观点的人。";
		mes "不可避免地，你会";
		mes "遇到一个";
		mes "无法理解其生活方式的人。";
		next;
		mes "[Phoenix]";
		mes "同样，那个人也";
		mes "无法理解你的";
		mes "生活方式。当你们的观点";
		mes "发生冲突并引发激烈争执时，";
		mes "你会如何回应？";
		next;
		switch( select("无论如何坚持我是对的:无视冲突的观点:接受差异并从中学习")) {
		case 1:
			mes "[Phoenix]";
			mes "拥有自己的观点很重要。";
			mes "但是，你必须认识到";
			mes "自己可能错了，";
			mes "相反的观点";
			mes "也可能有道理。";
			next;
			mes "[Phoenix]";
			mes "不存在唯一正确的";
			mes "答案，真理之光";
			mes "可以呈现多种色彩。";
			mes "自然就是如此。";
			mes "把想法强加给别人是";
			mes "一种压迫行为。";
			next;
			mes "[Phoenix]";
			mes "不要把自己限制";
			mes "在单一观点中，也不要";
			mes "因固守单一真理而";
			mes "扼杀成长。";
			mes "思考这一点，然后";
			mes "再来和我谈谈。";
			close;
		case 2:
			mes "[Phoenix]";
			mes "与他人相处很重要，";
			mes "但如果没有自己的";
			mes "独特贡献、";
			mes "思想和观点，";
			mes "你无法为世界带来价值。";
			mes "你独特的贡献、";
			next;
			mes "[Phoenix]";
			mes "尊重自己和他人的前提下，";
			mes "理想的冲突是";
			mes "拓展你对世界理解的";
			mes "绝佳机会，";
			mes "正如他人眼中的";
			mes "世界一样。";
			next;
			mes "[Phoenix]";
			mes "思考与自我和他人";
			mes "建立和谐的理念。";
			mes "与自我和他人建立和谐。";
			mes "然后回来找我。";
			close;
		case 3:
			mes "[Phoenix]";
			mes "很好。你必须看清";
			mes "差异的真实面貌，也要";
			mes "也要以优雅和真诚的态度";
			mes "以优雅和真诚的态度";
			mes "接受对自己观点的批评，";
			mes "认真思考。";
			next;
			mes "[Phoenix]";
			mes "不可能了解";
			mes "世上的一切。";
			mes "不可能理解";
			mes "每种观点。但这不代表";
			mes "你不理解的观点";
			mes "就毫无价值。";
			next;
			mes "[Phoenix]";
			mes "与你意见不同的人";
			mes "可能拥有";
			mes "你不知道的答案。";
			mes "在你脆弱时，";
			mes "这个人可能成为你";
			mes "最大的帮助。记住这一点。";
			next;
		}
		mes "[Phoenix]";
		mes "我对你给出的";
		mes "答案很满意。";
		mes "请思考我们";
		mes "讨论的内容。";
		mes "心情平静后，";
		mes "再来和我谈谈。";
		set TK_Q, 3;
		changequest 6001,6002;
		close;
	case 3:
		mes "[Phoenix]";
		mes "你感到平静安宁了吗？我会问你一个非常重要的问题。";
		mes "请诚实回答。";
		next;
		mes "[Phoenix]";
		mes "^FF0000你是否准备好献身于我将传授的特殊技艺，并维护其哲学的尊严？";
		next;
		if( select( "Yes.","No.") == 1) {
			mes "[Phoenix]";
			mes "很好。你不再只是学生。现在，你被赋予 ^FF0000跆拳道^000000 门徒的力量与责任。";
			next;
			mes "[Phoenix]";
			mes "“Taekwon”意为“拳打脚踢”，“Do”意为“技艺”。这门武术专注于使用拳脚的技巧。";
			next;
			mes "[Phoenix]";
			mes "请用这门修行磨炼身心，学习最适合你的技巧。永远不要懈怠训练，或给跆拳道蒙羞。";
			next;
			completequest 6002;
			callfunc "Job_Change",Job_Taekwon;
			callfunc "F_ClearJobVar";
			getitem 2101,1; // Guard[0]
			mes "[Phoenix]";
			mes "你还年轻，我想你会需要一个职业称号。嗯，既然如此，你";
			if(Sex == SEX_FEMALE) {
				mes "现在是 ^FF0000跆拳道女孩^000000。";
			} else {
				mes "现在是 ^FF0000跆拳道男孩^000000。";
			}
			mes "是的，听起来不错。";
			next;
			mes "[Phoenix]";
			mes "请收下这套训练服和护卫装备，好好使用这些礼物。旅行和训练时，向他人介绍我们的技艺，也从他们那里学习。";
			next;
			mes "[Phoenix]";
			mes "现在是时候踏上自己的旅程，寻找新的挑战来增强力量了。作为跆拳道修行者，请自豪地前行……";
			next;
			mes "[Phoenix]";
			mes "很好。祝你好运。希望将来还能再见到你，"+strcharinfo(0)+"。";
			close;
		}
		mes "[Phoenix]";
		mes "嗯，也许你还没准备好从学生成为正式门徒。准备好后，再来和我谈谈。";
		close;
	}
}

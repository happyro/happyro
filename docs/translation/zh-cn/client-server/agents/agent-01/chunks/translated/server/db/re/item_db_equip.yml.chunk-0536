         bonus2 bMagicAtkEle,Ele_Ghost,25;
         bonus2 bSkillAtk,"WL_SOULEXPANSION",40;
         if (.@r>=9) {
            bonus5 bAutoSpell,"MG_SOULSTRIKE",5,150,BF_LONG|BF_WEAPON,1;

//===== rAthena Script =======================================
//= White Day Event Script
//===== By: ==================================================
//= 1.0a Muad_Dib (Prometheus Project)
//===== Current Version: =====================================
//= 1.0a
//===== Compatible With: =====================================
//= rAthena Project; RO Episode 6+
//===== Description: =========================================
//= Sells candy, candy cane and well baked cookie.
//===== Additional Comments: =================================
//= 07/06/05 : Added 1st Version. [Muad_Dib]
//= Converted to rAthena format by Dr.Evil
//============================================================

alberta,188,64,4	script	Sugar	91,{
	set @maplenum,0;
	set @mapleItemID,0;
	set @maplePrice,0;
	set @maplePriceT,0;
	mes "[Sugar]";
	mes "欢迎！";
	mes "甜点有多美味？";
	mes "我的老师……";
	mes "艾尔贝塔的甜点工匠";
	mes "制作了坚硬的甜点。";
	next;
	mes "[Sugar]";
	mes "这是亲爱的人送的。";
	mes "作为回礼……";
	mes "真心就像";
	mes "礼物的甜味一样。";
	next;
	menu "请给我！",-,"我不需要。",M_END,"老师。",M_L1;

	mes "[Sugar]";
	mes "好的！";
	mes "请从菜单中选择。";
	mes "数量有限，";
	mes "最多只能带走 ^ff0000 5 个^000000。";
	next;
	menu "糖果",-,"拐杖糖",L0_2,"烤得很好的曲奇",L0_3;
	
set @maplePrice,3000;
	set @mapleItemID,529;
	mes "[Sugar]";
	mes "这是糖果，价格是";
	mes "3000 Zeny each.";
	mes "你想买多少？";
	next;
	goto L_INPUT;
	L0_2:
set @maplePrice,4000;
	set @mapleItemID,530;
	mes "[Sugar]";
	mes "这是拐杖糖，价格是";
	mes "4000 Zeny each.";
	mes "你想买多少？";
	next;
	goto L_INPUT;
	L0_3:
set @maplePrice,2000;
	set @mapleItemID,538; 
	mes "[Sugar]";
	mes "这是烤得很好的饼干，价格是";
	mes "2000 Zeny each.";
	mes "你想买多少？";
	next;
	
L_INPUT:
input @maplenum;
	if (@maplenum > 5) goto L_ERROR;
	if (@maplenum == 0) goto M_END;
	set @maplePriceT,@maplePrice*@maplenum;
	if (Zeny < @maplePriceT) goto L_ERROR2;
	set Zeny,Zeny- @maplePriceT;
	getitem @mapleItemID,@maplenum;
	mes "[Sugar]";
	mes "谢谢！！！";
	mes "这些甜点真的很好吃。";
	mes "因为我的甜点老师是世界第一！";
	mes "虽然你可以自己吃，";
	mes "但别吃太多，会变胖。";
	mes "请保重！！！";
	close;
	
M_L1:
mes "[Sugar]";
	mes "是的。";
	mes "我的老师是";
	mes "甜点工匠 Kuberu 先生。";
	mes "他在两位大师指导下制作甜点，";
	mes "也获准独自训练。";
	next;
	mes "[Sugar]";
	mes "虽然他似乎在出售甜点……";
	mes "但他现在在哪里？";
	mes "我也不知道。";
	close;
	
L_ERROR:
mes "[Sugar]";
	mes "???";
	mes "看来你的听力有问题。";
	mes "我再说一次？";
	mes "你只能购买";
	mes "^ff0000 5 pieces^000000 at once.";
	next;
	goto L_INPUT;
	
L_ERROR2:
mes "[Sugar]";
	mes "???";
	mes "嗯……看来你的钱不够";
	mes "完成购买。";
	mes "请先确认自己的钱。";
	close;
	
M_END:
mes "[Sugar]";
	mes "真的……你可能会后悔。";
	mes "如果改变主意，";
	mes "我就在这里。";
	mes "祝你今天愉快！";
	close;
	}
//

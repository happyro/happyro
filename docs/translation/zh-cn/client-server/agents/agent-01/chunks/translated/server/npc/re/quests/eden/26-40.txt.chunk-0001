//===== rAthena Script =======================================
//= Eden Group Quests - Mission [26 - 40]
//===== By: ==================================================
//= L0ne_W0lf
//===== Current Version: =====================================
//= 1.4
//===== Compatible With: =====================================
//= rAthena Project
//===== Description: =========================================
//= Repetable Quests for Players between Baselevel 26 - 40.
//===== Additional Comments: =================================
//= 1.0 First Version.
//= 1.1 Some little optimization here and there. [Masao]
//= 1.2 Optimized. [Euphy]
//= 1.3 Added support to Para_Team_Mark_ in Eden Group. [Ragno]
//= 1.4 Added use of F_HasEdenGroupMark function. [Ragno]
//============================================================

moc_para01,38,38,3	script	Mission [26 - 40]	857,{
	if (!callfunc("F_HasEdenGroupMark")) {
		mes "你不是符合资格的成员，无法使用公告栏。";
				close;
//
	}
	mes "[26～40级任务公告栏]";
	mes "- 公告栏上有许多任务。 -";
	next;
	if ((BaseLevel < 26) || (BaseLevel > 40)) {
		mes "你的等级不符合资格，无法使用公告栏。";
		close;
	}
	switch(select("狩猎任务:配送任务:收集任务:护送任务")) {
	case 1:
		mes "[狩猎任务公告栏]";
		mes "- 狩猎任务详情 -";
		mes "- 都写在公告栏上。 -";
		next;
		switch(select("狩猎毒魔菇:狩猎狸猫:狩猎长老树精（需30级以上）:狩猎可可:狩猎塔拉蛙（需38级以上）")) {
			case 1: callsub L_Quest,8266,0,"狩猎毒魔菇","Sponiac","Geffen","狩猎 10 只毒魔菇";
			case 2: callsub L_Quest,8267,0,"狩猎狸猫","Sponiac","Geffen","狩猎 10 只狸猫";
			case 3: callsub L_Quest,8268,30,"狩猎长老树精","Sponiac","Geffen","狩猎 10 只长老树精";
			case 4: callsub L_Quest,8269,35,"狩猎可可","Sponiac","Geffen","狩猎 10 只可可";
			case 5: callsub L_Quest,8270,38,"狩猎塔拉蛙","Sponiac","Geffen","狩猎 10 只塔拉蛙";
		}
	case 2:
		mes "[配送任务公告栏]";
		mes "- 配送任务详情 -";
		mes "- 都写在公告栏上。 -";
		next;
		switch(select("配送杀虫剂:配送蜂蜜:配送毛毯（需35级以上）")) {
			case 1: callsub L_Quest,8271,0,"配送杀虫剂","Dieshin Man","Morocc Ruins","从迪辛那里取得‘杀虫剂’，配送到斐扬东南方";
			case 2: callsub L_Quest,8272,0,"配送蜂蜜","Dieshin Man","Morocc Ruins","从迪辛那里取得‘蜂蜜’，配送到圣卡皮托利纳修道院西方";
			case 3: callsub L_Quest,8273,35,"配送毛毯","Dieshin Man","Morocc Ruins","从迪辛那里取得毛毯，配送到鲁提耶南方的原野";
		}
	case 3:
		mes "[收集任务公告栏]";
		mes "- 收集任务详情 -";
		mes "- 都写在公告栏上。 -";
		next;
		switch(select("收集骨头:收集动物皮:收集虫皮（需30级以上）:收集尾巴（需32级以上）:收集曲奇（需35级以上）:收集胡须（需35级以上）")) {
			case 1: callsub L_Quest,8274,0,"收集骨头","Dashia","Payon","收集 10 个‘骷髅骨’，交给达希娅";
			case 2: callsub L_Quest,8275,0,"收集动物皮","Dashia","Payon","收集 10 个‘熊脚皮’和 5 个‘动物皮’，交给达希娅";
			case 3: callsub L_Quest,8276,30,"收集虫皮","Dashia","Payon","收集 20 个‘蠕虫皮’和 20 个‘加勒结晶’，交给达希娅";
			case 4: callsub L_Quest,8277,32,"收集尾巴","Dashia","Payon","收集 10 个‘悠悠的尾巴’、10 个‘橡实’和 10 个‘浣熊叶’，交给达希娅";
			case 5: callsub L_Quest,8278,35,"收集曲奇","Dashia","Payon","收集 5 个‘烤得恰到好处的曲奇’和 1 个‘蛋糕的一角’，交给达希娅";
			case 6: callsub L_Quest,8279,35,"收集胡须","Dashia","Payon","收集 5 根‘鼹鼠胡须’和 3 个‘鼹鼠爪’，交给达希娅";
		}
	case 4:
		mes "[护送任务公告栏]";
		mes "目前公告栏上没有登记护送任务。";
		close;
	}
	end;
L_Quest:
	//QuestID,ReqLvl,Quest,Client,Loc,Desc
	.@string$ = getarg(2);
	if (BaseLevel < getarg(1,26)) {
		mes "你的等级不符合要求，无法接受‘"+ .@string$ +"’任务。";
		close;
	}
	mes "["+ .@string$ +"！！]";
	mes "委托人："+getarg(3);
	mes "委托地点："+getarg(4);
	mes "任务内容："+getarg(5);
	mes " ";
	mes "要接受这个任务吗？";
	next;
	if(select("不，我不接受。:是，我接受。") == 1) {
		mes "你拒绝了‘"+ .@string$ +"’任务。";
		close;
	}
	if (checkquest(getarg(0)) > -1) mes "你已经在进行这个任务了。";
	else {
		setquest getarg(0);
		mes "你接受了‘"+ .@string$ +"’任务。";
	}
	mes "完成任务后可以从委托人那里领取奖励。";
	next;
	mes "如需了解详情，请按‘Alt + U’，在任务窗口中查看更多信息。";
	close;
}

geffen,103,42,5	script	Sponiac	99,{
	if (checkweight(1201,1) == 0 || (MaxWeight - Weight) < 3500) {
		mes "[斯波尼亚克]";
		mes "你为什么带着这么多物品？";
		mes "你是在参加训练课程之类的吗？";
		close;
	}
	mes "[斯波尼亚克]";
	mes "啦～啦～啦～啦～";
	mes "啦～嗯？";
	next;
	mes "[斯波尼亚克]";
	mes "哇，你一定是新手吧？";
	mes "真是一张天真无邪的脸！哈～哈哈哈。";
	emotion ET_KIK;
	next;
	mes "[斯波尼亚克]";
	mes "别到处闲逛浪费时间了，去外面狩猎怎么样？";
	next;
	if(select("我现在就要走了。:我接到了狩猎任务。") == 1) {
		mes "[斯波尼亚克]";
		mes "哦，那就这样吧。你自己看着办。";
		mes "拜～拜。";
		close;
	}
	mes "[斯波尼亚克]";
	mes "哦，你是伊甸园的成员？";
	mes "你接到了什么任务？";
	next;
	switch(select("狩猎毒魔菇:狩猎狸猫:狩猎长老树精:狩猎可可:狩猎塔拉蛙")) {
		case 1: callsub L_Quest,8266,"狩猎毒魔菇",1000,0,100,"你可以在吉芬地下城一楼或普隆德拉东北方找到毒魔菇。其他地方也有，不过你自己去找吧。";
		case 2: callsub L_Quest,8267,"狩猎狸猫",1000,0,100,"你可以在吉芬东北方和西北方找到狸猫。哦，艾尔帕兰东边的原野也很适合找它们。";
		case 3: callsub L_Quest,8268,"狩猎长老树精",1000,100,110,"你可以在吉芬东北方、斐扬东边和普隆德拉西南方找到长老树精。";
		case 4: callsub L_Quest,8269,"狩猎可可",1000,200,150,"你可以在斐扬东边、普隆德拉西南方和艾尔帕兰东边的原野找到可可。";
		case 5: callsub L_Quest,8270,"狩猎塔拉蛙",1500,300,200,"你可以在科莫多东边的洞穴或乌龟岛找到塔拉蛙。";
	}
	end;
L_Quest:
	//QuestID,Quest,BExp,JExp,PotionAmt,Desc
	.@quest_id = getarg(0);
	if (checkquest(.@quest_id) == 1) {
		if (checkquest(.@quest_id,HUNTING) == 2) {
			mes "[斯波尼亚克]";
			mes getarg(1)+"!";
			mes "哇，没想到你真的完成了那个任务。我都快放弃了。不过你做得很好，谢谢你！";
			next;
			mes "[斯波尼亚克]";
			mes "我委托了这个任务，而你完成得非常出色。";
			mes "我会按照约定给你奖励。";
			next;
			mes "[斯波尼亚克]";
			mes "给你。非常感谢。愿神保佑你！";
			getitem 569,getarg(4); //Novice_Potion
			getexp getarg(2),getarg(3);
			erasequest .@quest_id;
			close;
		}
		mes "[斯波尼亚克]";
		mes "哦，你说得对。";
		next;
		mes "[斯波尼亚克]";
		mes "不过你还没有完成任务。现在为什么来找我？你还没完成任务！";
		mes "完成任务后我才会给你奖励。明白了吗？";
		next;
		mes "[斯波尼亚克]";
		mes getarg(5);
		mes "按‘Ctrl + ~’键可以查看世界地图。";
		next;
		mes "[Sponiac]";
		mes "总之，我会在这里等你。完成任务后请回来！";
		close;
	}
	mes "[斯波尼亚克]";
	mes "嗯？你确定吗？好像哪里不对……";
	next;
	mes "[斯波尼亚克]";
	mes "真奇怪。";
	mes "请按‘Alt + U’检查任务窗口。";
	close;
}

moc_ruins,173,55,3	script	Dieshin Man	89,{
	if (checkweight(1201,1) == 0 || (MaxWeight - Weight) < 3500) {
		mes "[Dieshin Man]";
		mes "你为什么带着这么多物品？";
		mes "你是在参加训练课程之类的吗？";
		close;
	}
	mes "[Dieshin Man]";
	mes "呼呼～～我们是配送员～";
	mes "我们的速度比飞行还快～！";
	next;
	mes "[Dieshin Man]";
	mes "欢迎～欢迎！";
	mes "我们是最快的配送公司，迪辛公司。";
	next;
	mes "[Dieshin Man]";
	mes "有什么可以帮你的吗？";
	next;
	if(select("我不需要帮助。:我接到了配送任务。") == 1) {
		mes "[Dieshin Man]";
		mes "哦，那就这样吧。你自己看着办。拜～！";
		close;
	}
	mes "[Dieshin Man]";
	mes "哦，你是伊甸园的成员？";
	mes "你接到了什么任务？";
	next;
	switch(select("配送杀虫剂。:配送蜂蜜。:配送毛毯。")) {
		case 1: callsub L_Quest,8271;
		case 2: callsub L_Quest,8272;
		case 3: callsub L_Quest,8273;
	}
	end;
L_Quest:
	if (checkquest(getarg(0)) != 1) {
		mes "[Dieshin Man]";
		mes "嗯？你确定吗？好像哪里不对……";
		next;
		mes "[Dieshin Man]";
		mes "真奇怪。";
		mes "请按‘Alt + U’检查任务窗口。";
		close;
	}
	if (countitem(6218) > 0) {
		mes "[Dieshin Man]";
		mes "等等，但你已经有一个配送箱了。";
		next;
		mes "[Dieshin Man]";
		mes "我们不能让你同时配送两个箱子。请先完成当前配送。";
		next;
		mes "[Dieshin Man]";
		mes "如果你忘了配送地点，请按‘Alt + U’查看任务窗口。";
		close;
	}
	switch(getarg(0)) {
	case 8271:
		mes "[Dieshin Man]";
		mes "啊哈！我想起来了！";
		mes "杀虫剂？一定是斐扬东南方的动物学家订购的。";
		break;
	case 8272:
		mes "[Dieshin Man]";
		mes "啊哈！我想起来了！";
		mes "蜂蜜？一定是普隆德拉东北方圣卡皮托利纳修道院西边的昆虫学家订购的。";
		break;
	case 8273:
		mes "[Dieshin Man]";
		mes "哦，对了！";
		mes "毛毯！一定是鲁提耶原野南方的生物学家订购的。";
		next;
		mes "[Dieshin Man]";
		mes "向艾尔帕兰东北方的克劳斯先生询问，就可以前往鲁提耶。";
		break;
	}
	next;
	mes "[Dieshin Man]";
	mes "迪辛公司的宗旨是提供最快、最可靠的配送服务。请不要耽搁，马上送去吧。";
	next;
	mes "[Dieshin Man]";
	mes "如果你忘了配送地点，请按‘Alt + U’查看任务窗口。";
	getitem 6218,1; //Disin_Delivery_Box
	close;
}

pay_fild07,83,89,7	script	Zoologist	89,{
	if (checkweight(1201,1) == 0 || (MaxWeight - Weight) < 3500) {
		mes "[Zoologist]";
		mes "你为什么带着这么多物品？";
		mes "你是在参加训练课程之类的吗？";
		close;
	}
	mes "[Zoologist]";
	mes "你听说过一种叫大脚熊的魔物吗？";
	mes "它看起来像一只红毛熊，肩膀上有一道‘X’形伤疤。";
	next;
	mes "[Zoologist]";
	mes "根据最近的研究，苍蝇和大脚熊之间存在共生关系。";
	next;
	mes "[Zoologist]";
	mes "我正在研究这件事，试图证明这个理论。因此我打算消灭大脚熊附近的苍蝇，观察它的反应。";
	next;
	if(select("……我没兴趣。:这是杀虫剂。") == 1) {
		mes "[Zoologist]";
		mes "哦，我需要杀虫剂才能继续研究。";
		close;
	}
	if (checkquest(8271) != 1) {
		mes "[Zoologist]";
		mes "嗯？";
		mes "你不是迪辛的配送员？";
		next;
		mes "[Zoologist]";
		mes "我正在等待一份特殊配送。";
		close;
	}
	if (countitem(6218) > 0) {
		mes "[Zoologist]";
		mes "哦哦！没错！就是那个！";
		next;
		mes "[Zoologist]";
		mes "那就是我订购的杀虫剂！你是迪辛派来的，对吧？";
		next;
		mes "[Zoologist]";
		mes "我等它很久了！";
		mes "快给我！";
		next;
		mes "[Zoologist]";
		mes "它比我想象中到得快多了。我想马上测试！";
		next;
		mes "[Zoologist]";
		mes "做得好，干得漂亮！非常感谢！这是给你的小礼物。";
		delitem 6218,1; //Disin_Delivery_Box
		erasequest 8271;
		getitem 569,100; //Novice_Potion
		getexp 1000,0;
		close;
	}
	mes "[Zoologist]";
		mes "谢谢你的好意。";
		mes "不过，你带来了什么？";
	next;
	mes "[Zoologist]";
		mes "嗯，我还以为迪辛又快又准确，没想到你送来的是空箱子。真令人失望。";
	next;
	mes "[Zoologist]";
		mes "请把我订购的东西带来，迪辛会把货物交给你。";
	close;
}

prt_fild03,30,254,3	script	Entomologist	83,{
	if (checkweight(1201,1) == 0 || (MaxWeight - Weight) < 3500) {
		mes "[昆虫学家]";
		mes "你为什么带着这么多物品？";
		mes "你是在参加训练课程之类的吗？";
		close;
	}
	mes "[昆虫学家]";
	mes "你听说过独角虫吗？";
	mes "它像一只昆虫，拥有光滑的黑色外皮，头上还有一只巨大的角。";
	next;
	mes "[Entomologist]";
	mes "最近的研究表明，这种魔物可以用蜂蜜驯服和训练。";
	next;
	mes "[Entomologist]";
	mes "我正在研究这件事，试图证明这个理论。因此我打算在它经常经过的地方设置蜂蜜陷阱，观察它的反应。";
	next;
	if(select("……我没兴趣。:这是蜂蜜。") == 1) {
		mes "[昆虫学家]";
		mes "哦，我需要蜂蜜才能继续研究。";
		close;
	}
	if (checkquest(8272) != 1) {
		mes "[Entomologist]";
		mes "嗯？";
		mes "你不是迪辛的配送员？";
		next;
		mes "[Entomologist]";
		mes "我正在等待一份特殊配送。";
		close;
	}
	if (countitem(6218) > 0) {
		mes "[Entomologist]";
		mes "哦哦！没错！就是那个！";
		next;
		mes "[Entomologist]";
		mes "那就是我订购的蜂蜜！你是迪辛派来的，对吧？";
		next;
		mes "[Entomologist]";
		mes "我等它很久了！";
		mes "快给我！";
		next;
		mes "[Entomologist]";
		mes "它比我想象中到得快多了。我想马上测试！";
		next;
		mes "[Entomologist]";
		mes "做得好，干得漂亮！非常感谢！这是给你的小礼物。";
		delitem 6218,1; //Disin_Delivery_Box
		erasequest 8272;
		getitem 569,100; //Novice_Potion
		getexp 1000,0;
		close;
	}
	mes "[Entomologist]";
		mes "谢谢你的好意。";
		mes "不过，你带来了什么？";
	next;
	mes "[Entomologist]";
		mes "嗯，我还以为迪辛又快又准确，没想到你送来的是空箱子。真令人失望。";
	next;
	mes "[Entomologist]";
		mes "请把我订购的东西带来，迪辛会把货物交给你。";
	close;
}

xmas_fild01,92,57,3	script	Biologist	97,{
	if (checkweight(1201,1) == 0 || (MaxWeight - Weight) < 3500) {
		mes "[生物学家]";
		mes "你为什么带着这么多物品？";
		mes "你是在参加训练课程之类的吗？";
		close;
	}
	mes "[生物学家]";
	mes "你听说过波利亚吗？";
	mes "它看起来和普通波利一样，但有独特的特征。";
	next;
	mes "[Biologist]";
	mes "波利看到地上的物品就会偷走。不过波利亚对掉落物毫无兴趣。所以我很好奇，既然它们和波利是同类魔物，为什么波利亚完全不在意收集物品呢？";
	next;
	mes "[Biologist]";
	mes "不过，这里实在冷得要命。";
	next;
	if(select("……我没兴趣。:毛毯在这里。") == 1) {
		mes "[生物学家]";
		mes "嗯，随你吧。不过要小心！这里很滑。";
		close;
	}
	if (checkquest(8273) != 1) {
		mes "[生物学家]";
		mes "嗯？";
		mes "你不是迪辛的配送员？";
		next;
		mes "[Biologist]";
		mes "我正在等待一份特殊配送。";
		close;
	}
	if (countitem(6218) > 0) {
		mes "[Biologist]";
		mes "哦哦！没错！就是那个！";
		next;
		mes "[Biologist]";
		mes "那就是我订购的毛毯！你是迪辛派来的，对吧？";
		next;
		mes "[Biologist]";
		mes "我等它很久了！";
		mes "快给我！";
		next;
		mes "[Biologist]";
		mes "它比我想象中到得快多了。我想马上测试！";
		next;
		mes "[Biologist]";
		mes "做得好，干得漂亮！非常感谢！这是给你的小礼物。";
		delitem 6218,1; //Disin_Delivery_Box
		erasequest 8273;
		getitem 569,100; //Novice_Potion
		getexp 1000,0;
		close;
	}
	mes "[Biologist]";
		mes "谢谢你的好意。";

izlude,131,116,4	script	Bulletin Board#5	837,{
	mes "[伊兹鲁德：卫星城]";
	mes "欢迎来到伊兹鲁德，普隆德拉的卫星城。伊兹鲁德为支援普隆德拉防御、容纳不断增长的人口而建。";
	next;
	mes "[伊兹鲁德：卫星城]";
	mes "景点包括允许冒险者转职剑士的剑士协会大楼，以及伊兹鲁德北方的战斗区域。";
	next;
	mes "[伊兹鲁德：卫星城]";
	mes "在码头可以乘船前往 ^123972艾尔贝塔^000000 或 ^2F0400海洞岛^000000。";
	next;
	mes "[伊兹鲁德：卫星城]";
	mes "从伊兹鲁德向西北是 ^6D6FE0普隆德拉^000000，向南是 ^1F3A11斐扬^000000。";
	mes "祝你在符文米德加尔特王国旅途愉快。";
	close;
}
//
//
	
	gef_tower,55,142,5	script	Bulletin Board#21	837,{
	mes "[吉芬地牢]";
	mes "^6B1312注意！^000000"; 
	mes "吉芬地牢由 3 层组成";
	mes "新冒险者不宜贸然进入。";
	mes "主要怪物包括";
	mes "^6B1312猎蝇^000000、^6B1312梦魇^000000 和 ^6B1312杰克^000000。";
	mes "梦魇和杰克只出现在这里。";
	next;
	mes "[吉芬地牢]";
	mes "在地牢第 2 层，";
	mes "^6B1312兽人英雄^000000 与 ^6B1312德古拉^000000";
	mes "会毫无预警出现。";
mes "第 3 层会在特定时间出现最强 Boss 之一的 ^6B1312墨菲斯托^000000。";
close;
}
	
	yuno_fild03,37,143,5	script	Bulletin Board#24	837,{
	mes "[熔岩地牢：诺格路]";
	mes "^6B1312注意！^000000";
	mes "诺格路充满危险生物。";
	mes "仅限经验丰富的冒险者进入。";
	next;
	mes "[熔岩地牢：诺格路]";
	mes "本地牢主要怪物是";
	mes "^6B1312卡浩^000000 和 ^6B1312梦魇恐惧者^000000。";
mes "请务必小心。";
close;
}
	
	mjolnir_02,76,362,5	script	Bulletin Board#10	837,{
	mes "[煤矿]";
	mes "^6B1312注意！^000000";
	mes "煤矿共有 3 层，根据楼层不同，适合新手和经验丰富的冒险者。";
	next;
	mes "[煤矿]";
mes "第 3 层怪物常成群攻击，避免被包围。这里是矿区，地底深处能找到许多矿石。";
close;
}
	
	moc_fild19,107,101,5	script	Bulletin Board#20	837,{
	mes "[斯芬克斯]";
	mes "^6B1312注意！^000000";
	mes "斯芬克斯共有 5 层。";
	mes "这个地牢适合训练";
	mes "经验丰富的冒险者。";
	next;
	mes "[斯芬克斯]";
	mes "斯芬克斯里栖息着许多";
	mes "具有攻击性的怪物，如果不慎";
	mes "被它们包围，";
	mes "建议立刻逃跑。";
	next;
	mes "[斯芬克斯]";
	mes "第 5 层的首领";
	mes "怪物 ^6B1312法老王^000000 会在特定时间出现。";
	mes "请务必";
mes "全力驱魔。";
close;
}
	
	aldebaran,136,133,5	script	Bulletin Board#19	837,{
	mes "[Clock Tower]";
	mes "^6B1312注意！^000000";
	mes "只有经验丰富的冒险者";
	mes "才应考虑进入钟楼。钟楼共有 8 层：";
	mes "地下 4 层，地上 4 层。";
	next;
	mes "[Clock Tower]";
	mes "钟楼的主要怪物是时钟、警报器和";
	mes "巴风特。请当心巡逻的钟楼";
	mes "守卫者。";
	next;
	mes "[Clock Tower]";
	mes "钟楼里的道路";
	mes "曲折复杂，请务必小心，";
	mes "避免";
	mes "迷路。";
	close;
}

gef_fild10,69,340,5	script	Bulletin Board#3	837,{
	mes "[Orc Dungeon]";
	mes "^6B1312注意！^000000";
	mes "兽人地下洞窟共有 2 层。这里的怪物单独看并不强，但会成群攻击。请小心。";
	next;
	mes "[Orc Dungeon]";
	mes "只有在这个地牢里才能遇到兽人骷髅、泽诺克和兽人僵尸。";
	next;
	mes "[Orc Dungeon]";
	mes "这里的大多数怪物都是不死族，圣属性武器会大有帮助。";
	next;
	mes "[Orc Dungeon]";
	mes "如果你没有圣属性武器且队伍中有服事，服事的洒水祈福技能会非常有用。";
	close;
}

xmas,147,311,5	script	Bulletin Board#23	837,{
	mes "[Toy Factory]";
	mes "^6B1312注意！^000000";
	mes "玩具工厂共有 2 层。";
	mes "这个地牢对新手冒险者来说并不难探索，";
	mes "但会在特定时间生成 3 只危险的首领怪物。";
	next;
	mes "[Toy Factory]";
	mes "第 1 层会遇到首领怪物 ^6B1312天使波利^000000。";
	mes "第 2 层会遇到 2 只危险的首领怪物：";
	mes "^6B1312暴风骑士^000000 和 ^6B1312哈提^000000。探索时请保持警惕。";
	mes "顺带一提，^6B1312惊骇森灵^000000、^6B1312巡航者^000000 和 ^6B1312饼干^000000 只会出现在这个地牢。";
	close;
}

pay_arche,39,134,5	script	Bulletin Board#08	837,{
	mes "[Payon Cave]";
	mes "^6B1312注意！^000000";
	mes "斐扬洞窟共有 5 层，充满不死族和恶魔怪物。小心第 3、4 层成群的九尾狐。";
	next;
	mes "[Payon Cave]";
	mes "第 5 层会在特定时间出现美丽却可怕的首领怪物 ^6B1312月夜猫^000000。接近时务必格外小心。";
	close;
}

moc_ruins,61,164,5	script	Bulletin Board#27	837,{
	mes "[Pyramids]";
	mes "^6B1312注意！^000000";
	mes "金字塔共有 7 层，地上 4 层，其余在地下。";
	mes "前几层适合新手冒险者探索，但越往深处走，遇到的怪物就越强。";
	next;
	mes "[Pyramids]";
	mes "第 1 层有盗贼公会，人们可以在那里转职为盗贼。";
	mes "第 4 层会在特定时间出现首领怪物 ^6B1312奥西里斯^000000。";
	mes "地下第 3 层会在特定时间出现 ^6B1312阿蒙·拉^000000。";
	close;
}

prt_fild05,278,220,5	script	Bulletin Board#16	837,{
	mes "[Culvert]";
	mes "下水道共有";
	mes "4 层，是新手冒险者";
	mes "进行训练的好地方。";
	next;
	mes "[Culvert]";
	mes "要进入下水道，你";
	mes "必须在普隆德拉";
	mes "骑士团自愿担任怪物";
	mes " exterminator。记住，";
	mes "这里的怪物可能会";
	mes "成群攻击。";
	next;
	mes "[Culvert]";
	mes "在普隆德拉下水道的第 4 层，";
	mes "你可能会遇到首领怪物";
	mes "^6B1312黄金盗虫^6B1312^000000。新手冒险者";
	mes "应当";
	mes "保持谨慎。";
	close;
}

ba_in01,15,147,3	script	Elyumina#ep172_elmn02	4_EP17_ELYUMINA,{
	if (checkweight(1201,3) == 0) {
		mes "由于持有的物品太多，无法继续任务。";
		mes "请整理背包后再试。";
		close;
	}
	if (ep17_2_main == 28) {
		cutin "ep171_elyumina01",2;
		mes "[Elyumina]";
		mes "现在你安全了，接下来只要追那些叛徒到底。";
		mes "哈哈哈哈哈！！我会成为活到最后的胜利者。";
		close3;
	}
	if (ep17_2_main == 29) {
		if (countitem(7110) < 10 || countitem(7326) < 10) {
			cutin "ep171_elyumina04",2;
		mes "[Elyumina]";
		mes "嗯～模块模块～嗯～";
		mes "核心核心～嗯～";
		mes "你在做什么？为什么没带我说的材料来？";
			close3;
		}
		cutin "ep171_elyumina04",2;
		mes "[Elyumina]";
		mes "很好，很好～嗯。";
		mes "如果在这里这样做……";
		next;
		mes "[Elyumina]";
		mes "杰作就诞生了！";
		mes "只要发出信号，接收器就会～";
		next;
		specialeffect EF_GUIDEDATTACK, AREA, "Eisen Werner#ep172_eiz2";
		mes "[Elyumina]";
		mes "抓得好！";
		mes "现在带着这个，去追捕残余的心脏猎人和叛徒。";
		next;
		select( "我一个人？" );
		cutin "ep171_elyumina03",2;
		mes "[Elyumina]";
		mes "我拿着追踪器，你一个人能做到吗？";
		mes "真不敢相信我竟然被这家伙抓住了。";
		mes "这对伟大的伊留米娜来说真是耻辱。";
		next;
		cutin "162elena_01",0;
		mes "[Elena Bolkova]";
		mes "嗯，如果没有其他人一起去，我怎么样？";
		mes "或者艾丝特。";
		mes "上次行动你不是和艾丝特一起吗？";
		next;
		select( "艾丝特在哪里？" );
		mes "[Elena Bolkova]";
		mes "她大概就在前厅。";
		mes "你来的时候没看到她吗？";
		mes "我也会趁机把他们处理掉，之后再来找你。";
		next;
		mes "[Elena Bolkova]";
		mes "艾丝特很擅长头脑风暴。哈哈哈哈。";
		mes "去和艾丝特见面吧。";
		delitem 7110,10;
		delitem 7326,10;
		ep17_2_main = 30;
		erasequest 18015;
		setquest 18016;
		getitem 1000092,1; //Elyumina Tracker
		getitem 1000103,10;
		getexp 1031336,0;	// getbaseexp_ratio?
		close3;
	}
	if (ep17_2_main == 32) {
		cutin "ep171_elyumina01",2;
		mes "[Elyumina]";
		mes "我听说了消息。那些混蛋。";
		mes "不过，所有重要的幻影成员都逃走了，这是真的吗？";
		next;
		mes "[Elyumina]";
		mes "你们像老鼠一样躲起来，晚上偷偷行动，对吧？";
		mes "让我们看看他们能逃多远。";
		close3;
	}
	cutin "ep171_elyumina04",2;
	mes "[Elyumina]";
	mes "*窃笑*，我会去找那些叛徒。";
	mes "冒险者，*窃笑*";
	close3;

OnInit:
	questinfo( QTYPE_QUEST2, QMARK_YELLOW, "isbegin_quest(18015) == 1 && countitem(7110) >= 10 && countitem(7326) >= 10" );
	end;
}

ba_in01,51,157,3	script	Est#ep172_est01	4_F_ESTLOVELOY,{
	if (ep17_2_main == 30) {
		cutin "ep162_est01",2;
		mes "[Est]";
		mes "冒险者，那是什么？";
		next;
		cutin "ep162_est02",2;
		mes "[Est]";
		mes "哦……能告诉你幻影和心脏猎人在哪里的追踪器？";
		mes "有点吸引人。";
		next;
		mes "[Est]";
		mes "根据他们目前的行动，他们似乎会在太阳落山后于黑暗中活动。";
		mes "我们等太阳落山，再悄悄开始行动。";
		next;
		cutin "ep162_est01",2;
		mes "[Est]";
		mes "今天我会大幅减少夜间巡逻，让他们从洞穴里爬出来。";
		mes "我会让宅邸外看起来空无一人。";
		next;
		mes "[Est]";
		mes "我会把行动告诉管理人员。";
		mes "晚上别在花园里乱逛，会很危险。";
		next;
		mes "[Est]";
		mes "这显然是个陷阱，但我不认为他们会放过这个机会。";
		next;
		mes "[Est]";
		mes "如果你没有异议，我们就按计划进行。";
		mes "你应该为行动做好准备。";
		mes "准备好后和我说一声。";
		ep17_2_main = 31;
		erasequest 18016;
		setquest 18017;
		close3;
	}
	if (ep17_2_main == 31) {
		switch( checkquest(18017,HUNTING) ) {
		case -1:
			end;	// shouldn't happen
		case 0:
		case 1:
			if (getcharid(1) < 1) {
				mes "^0000CD这是一个纪念副本。^000000";
				mes "请创建队伍后再试。";
				mes "^0000CD可以使用 /organize 队伍名称命令创建队伍。^000000";
				close;
			}
			cutin "ep162_est01",2;
			mes "[Est]";
			mes "我们走吧？";
			next;
			.@md_name$ = "暮光花园";
			if (select( "创建“" + .@md_name$ + "”。", "进入“" + .@md_name$ + "”。" ) == 1) {
				if (!is_party_leader()) {
					mes "^4D4DFF这里是纪念副本。";
					mes "你必须是队长才能创建纪念副本。^000000";
					close3;
				}
				if (instance_create(.@md_name$) == -3)
					dispbottom "由于已有运行中的副本，副本“" + .@md_name$ + "”预约失败。";
				cutin "ep162_est01",2;
				mes "[Est]";
				mes "那么，我们悄悄行动吧。";
				close3;
			}
			if (instance_enter(.@md_name$) == IE_OK) {
				mapannounce "ba_in01", "" + strcharinfo(0) + " 所在的队伍“" + getpartyname( getcharid(1) ) + "”正在进入" + .@md_name$ + "。", bc_map, "0x00FF99";
				end;
			}
			cutin "ep162_est01",2;
			mes "[Est]";
			mes "再等一会儿再出去吧……不能大意。";
			close3;
		case 2:
			cutin "ep162_est03",2;
			mes "[Est]";
			mes "我们把囚犯交给阿尔法了。";
			mes "顺便说一句，我准备了一个制造骚动的陷阱，用来抓捕非干部成员。";
			next;
			cutin "ep162_est01",2;
			mes "[Est]";
			mes "他们可没那么容易抓……";
			mes "阿尔法要继续调查飞艇机库，你去那里看看吧。";
			next;
			mes "[Est]";
			mes "现在先休息一下吧。";
			mes "唉……你做得很好。";
			ep17_2_main = 32;
			erasequest 18017;
			setquest 18018;
			delitem 1000092,1;
			next;
			mes "[Est]";
			mes "哦，我也会拿走雷达。";
			mes "寻找其他成员时会派上用场。";
			close3;
		}
		end;
	}
	if (ep17_2_main == 32) {
		cutin "ep162_est01",2;

}

ba_in01,20,145,3	script	Elena Bolkova#ep172_eln_	4_F_ELENA,{
	if (ep17_2_main == 28) {
		cutin "162elena_02",2;
		mes "[Elena Bolkova]";
		mes "哦，你在这里啊，走这边。幸运还没来吗？";
		next;
		cloakoffnpcself( "Rookie#ep172_rk02" );
		cutin "16loo_01",1;
		mes "[Rookie]";
		mes "不，不，我也在这里。是不是迟到了一会儿？";
		mes "我刚才和阿尔法聊了一会儿。";
		next;
		mes "[Rookie]";
		mes "那是谁？";
		next;
		cutin "162elena_01",2;
		mes "[Elena Bolkova]";
		mes "一条大鱼？";
		mes "看着吧，这两个人一起演戏一定很有意思。";
		next;
		cutin "ep16_eisen01",0;
		mes "[Eisen]";
		mes "喂，这和我们说好的不一样。";
		mes "这是谁？";
		next;
		select( "就是你提到的科尔那家伙。" );
		cutin "ep16_eisen02",0;
		mes "[Eisen]";
		mes "这个小子？我想不起来了……？";
		mes "你在骗我吗？";
		next;
		cutin "ep171_elyumina02",2;
		mes "[Elyumina]";
		mes "你凭什么这样对我？！";
		mes "你是那些混蛋的走狗吗？";
		next;
		cutin "ep171_elyumina03",2;
		mes "[Elyumina]";
		mes "明明是他们先背叛我，却反过来叫我叛徒。";
		mes "你和那些混蛋是一伙的吗？";
		next;
		cutin "ep16_eisen03",0;
		mes "[Eisen]";
		mes "真不敢相信，这是幻影吗？";
		mes "不，你真的是幻影的成员吗？";
		next;
		cutin "ep171_elyumina04",2;
		mes "[Elyumina]";
		mes "你到底在说什么？！我根本不是幻影的人，为什么要把我关在这里！";
		mes "我该怎么办，你竟然认不出伟大的伊留米娜。想让我敲你的脑袋吗？";
		next;
		cutin "ep16_eisen01",0;
		mes "[Eisen]";
		mes "喂，反叛军，我要你把这家伙换成一个会好好说话的人。";
		mes "如果想从我这里得到情报，就带一个像样的幻影成员来。";
		next;
		cutin "ep171_elyumina02",2;
		mes "[Elyumina]";
		mes "什么，你刚才是害怕了吗？";
		mes "喂，我已经告诉你我是幻影成员了。你知道我做这件事有多少年了吗？";
		next;
		cutin "162elena_01",2;
		mes "[Elena Bolkova]";
		mes "（看，很有趣吧？看他们那样争吵。）";
		next;
		cutin "16loo_01",1;
		mes "[Rookie]";
		mes "（你觉得这是内部纷争吗？话说回来，你说他是上次行动中研究设施的负责人吧？他怎么会被我们抓住？）";
		next;
		cutin "ep16_eisen01",0;
		mes "[Eisen]";
		mes "你缺少一样重要的东西，你没有“芯片”！";
		mes "如果检测到“芯片”，我根本不会来到这里，也不会遇到你这种骗子。";
		next;
		mes "[Eisen]";
		mes "幻影是一个联盟，但也像一种思想体系。正式成员的身体里会植入“芯片”，用来识别你这样的叛徒。";
		next;
		mes "[Eisen]";
		mes "除非你体内有那块“芯片”，否则你就不是幻影的一员。现在明白了吗，小鬼。";
		next;
		cutin "ep171_elyumina04",2;
		mes "[Elyumina]";
		mes "哦？听到了吗，菜鸟？这东西叫“芯片”。";
		mes "这个蠢货把一切都说出来了。";
		mes "该死的混蛋，他们把我一个人丢下了。";
		mes "也就是说，身处这一切中心的我，只是个棋子，对吧？";
		next;
		cutin "ep16_eisen03",0;
		mes "[Eisen]";
		mes "等……等等……！";
		next;
		cutin "ep171_elyumina04",2;
		mes "[Elyumina]";
		mes "现在才摆出那副蠢样是不是太晚了？";
		mes "你是自封的幻影精英成员吗？";
		mes "菜鸟！我要把这个从他脖子上扯下来，做一个追踪那些“芯片”的追踪器！";
		next;
		mes "[Elyumina]";
		mes "好！就这么办！向叛徒复仇！混乱！毁灭！复仇！坠落吧！";
		close2;
		setpcblock PCBLOCK_NPC, true;
		npctalk "菜鸟！用那边的东西！", "Elyumina#ep172_elmn02", bc_self;
		sleep2 1500;
		npctalk "什么？现在？", "Rookie#ep172_rk02", bc_self;
		specialeffect EF_GRIMTOOTH, AREA, "Rookie#ep172_rk02";
		specialeffect EF_NPC_STOP, AREA, "Eisen Werner#ep172_eiz2";
		npctalk "这是什么……！呃……", "Eisen Werner#ep172_eiz2", bc_self;
		sleep2 1000;
		npctalk "给我昏过去，混蛋！", "Elyumina#ep172_elmn02", bc_self;
		sleep2 1000;
		specialeffect EF_HIT4, AREA, "Eisen Werner#ep172_eiz2";
		sleep2 1000;
		setpcblock PCBLOCK_NPC, false;
		cutin "ep171_elyumina01",2;
		mes "[Elyumina]";
		mes "你竟敢耍我？";
		mes "你竟敢无视伟大的伊留米娜，胆子不小嘛？";
		next;
		cutin "162elena_02",2;
		mes "[Elena Bolkova]";
		mes "呜哈哈哈哈哈!!!!";
		mes "不，我看到了什么？！！！";
		mes "我以为我们的团队合作很棒，没想到还不如敌人？";
		next;
		cutin "16loo_02",1;
		mes "[Rookie]";
		mes "我知道。";
		mes "米娜，你现在打算做什么？";
		next;
		cutin "ep171_elyumina04",2;
		mes "[Elyumina]";
		mes "为了保证我的研究权，我要做一个你会喜欢的东西。";
		mes "不，我只是无法忍受仅仅因为是叛徒就这样被骚扰，对吧？";
		next;
		mes "[Elyumina]";
		mes "我要研究植入这家伙体内的“芯片”，制作一个能对这种“芯片”产生反应的追踪器。";
		mes "以前我就做过保护自己免受那些心脏猎人侵害的东西。";
		next;
		cutin "ep171_elyumina01",2;
		mes "[Elyumina]";
		mes "如果不是为了保护自己的性命，我也不会做到这一步。";
		mes "总之，我拆这家伙身上的东西时，请帮我拿些需要的材料来。这家伙叫什么来着，艾森？";
		next;
		cutin "16loo_01",0;
		mes "[Rookie]";
		mes "你需要什么材料？";
		next;
		cutin "ep171_elyumina01",2;
		mes "[Elyumina]";
		mes "10 个荧光液体、10 把破损的剑，还有一些模块……";
		next;
		cutin "16loo_01",0;
		mes "[Rookie]";
		mes "需要那么多吗？希望你没在想什么蠢主意。我会去科尔拿模块。";
		mes "冒险者，你能帮我们拿荧光液体和破损的剑吗？";
		next;
		mes "[Rookie]";
		mes "我想我在污水处理厂见过荧光液体，抓住黑色的心脏猎人侦察兵就能拿到。";
		next;
		cutin "162elena_01",2;
		mes "[Elena Bolkova]";
		mes "那我会留在这里保护这里，等他醒来后，总得有人留下来再把他打昏吧？";
		mes "你们两个交给我就好。不用担心这里。";
		ep17_2_main = 29;
		erasequest 18014;
		setquest 18015;
		close2;
		cutin "",255;
		npctalk "菜鸟：那我先回来了！", "Rookie#ep172_rk02", bc_self;
		sleep2 2000;
		removespecialeffect EF_NPC_STOP, SELF, "Eisen Werner#ep172_eiz2";
		cloakonnpcself( "Rookie#ep172_rk02" );
		end;
	}
	if (ep17_2_main == 30) {
		cutin "162elena_01",2;
		mes "[Elena Bolkova]";
		mes "艾丝特大概就在前厅。";
		mes "你先去见艾丝特，我之后再加入。";
		close3;
	}
	if (isbegin_quest(18019) > 0) {
		cutin "162elena_01",2;
		mes "[Elena]";
		mes "哦，艾森·维尔纳在哪里？";
		mes "他被泰丝带走了。看来他们要自己审问他。";
		next;
		mes "[Elena]";
		mes "他余生都会被关在某个地方。";
		mes "伊留米娜本来也会这样。伊留米娜还真幸运，对吧？";
		next;
		mes "[Elena]";
		mes "不用担心这里。我会保护好它。";
		close3;
	}
	cutin "162elena_01",2;
	mes "[Elena Bolkova]";
	mes "不用担心这里。我会好好守着。";
	close3;

OnInit:
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "isbegin_quest(18014) == 1" );
	end;
}


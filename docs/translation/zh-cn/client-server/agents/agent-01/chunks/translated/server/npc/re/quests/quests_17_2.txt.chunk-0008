		mes "（这家伙为什么会对那个感兴趣？看起来他是迟到了，来这里和同伴会合……如果能好好谈谈，不就能知道其他人在哪里了吗？）";
		next;
		cutin "ep16_eisen01",0;
		mes "[Eisen]";
		mes "你为什么这么安静？已经把他们处理掉了吗？";
		next;
		select( "她目前被关押着。" );
		mes "[Eisen]";
		mes "真的？那就带我去那里。";
		mes "我不想再在这个破花园里到处闲逛了。";
		npctalk "（嘿嘿。等我和同伴会合，就立刻收拾你们。）";
		next;
		cutin "162elena_01",2;
		mes "[Elena Bolkova]";
		mes "你看起来很傲慢嘛。";
		mes "我不知道你在打什么主意，不过我，埃琳娜·博尔科娃，会带你过去。";
		next;
		cutin "ep16_eisen02",0;
		mes "[Eisen]";
		mes "我愿意跟你走。";
		next;
		cutin "162elena_01",2;
		mes "[Elena Bolkova]";
		mes "真是个奇怪的家伙。我带他一起走。菜鸟大概也在那里。";
		next;
		cutin "162elena_02",2;
		mes "[Elena Bolkova]";
		mes "嗯？我要把这家伙带到哪里？";
		mes "啊，去旅馆。我们现在把那里当作监狱。";
		mes "跟我来。另外，我会把所有核心也带走。";
		ep17_2_main = 28;
		erasequest 18013;
		setquest 18014;
		delitem 1000226,countitem(1000226);
		getitem 1000103,10;
		getexp 515668,0;	// getbaseexp_ratio?
		close2;
		cutin "",255;
		cloakonnpcself();
		cloakonnpcself( "Eisen Werner#ep172_eiz" );
		end;
	}
	if (ep17_2_main == 28) {
		cutin "162elena_01",2;
		mes "[Elena Bolkova]";
		mes "旅馆见。";
		close2;
		cutin "",255;
		cloakonnpcself();
		end;
	}
	cutin "162elena_01",2;
	mes "[Elena Bolkova]";
	mes "我正在观察周围，看看有没有潜伏的敌人。";
	mes "这个地方有很多死角。";
	close3;

OnInit:
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "isbegin_quest(18013) == 1" );
	end;
}


			mes "今天去哪里冒险了？";
			mes "这些都是冒险故事吗？！";
			mes "如果不是，那就……";
			next;
			mes "[Charo]";
			mes "你可能是来参加指南针竞赛的，就像我们喵喵勇气队的大金枪鱼一样！！";
			mes "喵！";
			close;
		case 1:
			mes "[Charo]";
			mes "嗯，霍姆尼亚和喵森对我来说太难了。";
			mes "...?";
			mes "我是说那本书对我来说太难了。";
			close;
		case 2:
			mes "[Charo]";
			mes "你知道拉托有多喜欢你找到的那幅画吗？";
			mes "他把画装裱起来挂在墙上了！";
			mes "喵~";
			next;
			mes "[Charo]";
			mes "我想念故乡。";
			mes "不过马兰多也是我的故乡。";
			mes "只要我们大家一起待在这里，我就很满足了~";
			close;
		}
	}
}

malangdo,214,204,3	script	[Meow Team] Rosy#nya_09	559,{
	if (nyadven < 2) {
		mes "一只白毛小猫正在努力摆弄那台奇怪的机器。";

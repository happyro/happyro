		next;
		mes "[Rosy]";
		mes "算了吧！";
		mes "这台机器就不会坏吗？";
		close;
	}
}

malangdo,215,201,3	script	[Meow Team] Roku#nya_10	553,{
	if (checkweight(1201,1) == 0 || MaxWeight - Weight < 4000) {
		mes "- 你的物品太多，无法继续这个任务。 -";
		close;
	}
	if (nyadven < 2) {
		mes "一只黑毛小猫正在帮助忙碌的白猫。";
		mes "这台机器可能坏了。";
		close;
	} else if (nyadven == 2) {
		mes "[Roku]";
		mes "哦？你就是给我们玻璃珠的人。";
		mes "非常感谢。";
		mes "查罗看起来很开心，我也很高兴。";
		close;
	} else if (nyadven == 3) {
		mes "[Roku]";
		mes "查罗很喜欢。";
		mes "一定会很有趣。";
		close;
	} else if (nyadven == 4) {
		mes "[Roku]";
		mes "查罗已经等了很久。";
		mes "给查罗……";
		close;
	}
	mes "[Roku]";
	mes "你有什么要告诉我的吗？";
	next;
	switch(select("报告竞赛结果。:挑战竞赛。:没什么。")) {
	case 1:
		if (countitem(6428) == 0) {
			mes "[Roku]";
			mes "咕比，没有确认印章和卡片。";
			mes "这样下去你会遇到麻烦的。";
			close;
		}
		if (nyadven02 == 27) {
			mes "[Roku]";
			mes "做得好。";
			mes "你真聪明。";
			mes "这是给你的礼物。";
			mes "明天请再来。";
			next;
			mes "[Roku]";
			mes "查罗很喜欢你。";
			mes "你来的话，他会很开心。";
			delitem 6428,1; //Bravery_Card_A
			set nyadven02,29;
			getitem 6422,3; //Egrade_Coin
			getexp 20000,20000;
			erasequest 7244;
			erasequest 7245;
			close;
		} else if (nyadven02 == 28) {
			mes "[Roku]";
			mes "失败了……";
			mes "……对你来说太难了吗？";
			mes "不过每天只能参加一次竞赛。";
			delitem 6428,1; //Bravery_Card_A
			erasequest 7244;
			erasequest 7245;
			next;
			switch(select("再给我一次机会！:好吧，明天再试。")) {
			case 1:
				if (countitem(12636) == 0) {
					mes "[Roku]";
					mes "嗯……嗯……这个嘛……";
					mes "如果你带来一罐马兰罐，";
					mes "我就再给你一次机会。";
					close;
				}
				mes "[Roku]";
				mes "好吧。你想用 1 罐马兰罐换一张冒险卡吗？";
				next;
				switch(select("换取冒险卡 A。:算了。")) {
				case 1:
					if (countitem(6428)) {
						mes "[Roku]";
						mes "你已经有了？";
						close;
					}
					mes "[Roku]";
					mes "这是你的冒险卡。";
					mes "初始指南针，启动！";
					delitem 12636,1; //Malang_Sp_Can
					getitem 6428,1; //Bravery_Card_A
					set nyadven02,0;
					if (checkquest(7257) > -1)
						erasequest 7257;
					close;
				case 2:
					mes "[Roku]";
					mes "好吧，明天再来。";
					close;
				}
			case 2:
				mes "[Roku]";
				mes "好吧，明天再来。";
				close;
			}
		} else if (nyadven02 == 29) {
			mes "[Roku]";
			mes "你今天已经报告过结果了。";
			mes "对吧？";
			close;
		} else if (nyadven02 < 27) {
			mes "[Roku]";
			mes "你太心急了。";
			mes "你甚至还没完成竞赛。";
			mes "竞赛还在进行中。";
			close;
		} else {
			mes "[Roku]";
			mes "结果有点奇怪，不过……";
			mes "这既不是完成的竞赛，也不是未完成的竞赛。";
			next;
			mes "[Roku]";
			mes "这是机器造成的吗？";
			mes "这次竞赛就作废吧。";
			delitem 6428,1; //Bravery_Card_A
			set nyadven02,0;
			erasequest 7244;
			erasequest 7245;
			close;
		}
	case 2:
		if (nyadven02 == 28) {
			mes "[Roku]";
			mes "你失败了吗？";
			mes "想再试一次吗？";
			mes "我会删除失败结果的报告。";
		} else {
			if (checkquest(7257,PLAYTIME) == 0 || checkquest(7257,PLAYTIME) == 1) {
				mes "[Roku]";
				mes "不，还不行。";
				mes "嘟噜嘟噜竞赛每天只能参加一次。";
				mes "参加得太频繁，机器会坏掉的。";
				close;
			}
			mes "[Roku]";
			mes "我知道你要参加嘟噜嘟噜竞赛。";
			mes "我已经删除了你上次的报告。";
		}
		if (checkquest(7257) > -1)
			erasequest 7257;
		next;
		mes "[Roku]";
		mes "你需要冒险卡才能再次挑战。";
		mes "想用 1 罐马兰罐换一张冒险卡吗？";
		next;
		switch(select("购买冒险卡。:就到此为止吧。")) {
		case 1:
			if (countitem(6428)) {
				mes "[Roku]";
				mes "你已经有了？";
				close;
			}
			if (countitem(12636) == 0) {
				mes "[Roku]";
				mes "没有免费的东西。";
				mes "你需要一罐马兰罐。";
				close;
			}
			mes "[Roku]";
			mes "这是你的冒险卡。";
			mes "初始指南针，启动！";
			delitem 12636,1; //Malang_Sp_Can
			getitem 6428,1; //Bravery_Card_A
			set nyadven02,0;
			close;
		case 2:
			mes "[Roku]";
			mes "好吧。";
			close;
		}
	case 3:
		mes "[Roku]";
		mes "你真奇怪。";
		close;
	}
}

malangdo,212,204,0	script	Beginning Compass#nya_02	844,{
	if (countitem(6428) == 0) {
		mes "这里有一台奇怪的机器。";
		mes "孩子们说这是喵喵勇气队的嘟噜嘟噜指南针。";
		close;
	}
	if (nyadven02 < 11) {
		mes "铁锅里装着马兰多地图，还有一个卡片插槽。";
		mes "插入卡片后，红色按钮和锅里的地图会亮起来。";
		mes "按下按钮似乎就能启动。";
		next;
		switch(select("现在启动。:稍后启动。")) {
		case 1:
			mes "按下按钮后，卡片弹了出来，地图也亮起了灯。";
			if (rand(20) < 10) {
				callsub L_Viewpoint,1,1;
				mes "游戏已经开始了！";
				set nyadven02,11;
				setquest 7244;
				close;
			} else {
				callsub L_Viewpoint,2,1;
				mes "游戏已经开始了！";
				set nyadven02,21;
				setquest 7245;
				close;
			}
		case 2:
			mes "稍后再来挑战吧。";
			close;
		}
	} else if (nyadven02 >= 11 && nyadven02 <= 15) {
		callsub L_Viewpoint,1,(nyadven02-10);
		close;
	} else if (nyadven02 >= 21 && nyadven02 <= 25) {
		callsub L_Viewpoint,2,(nyadven02-20);
		close;
	} else if (nyadven02 == 16 || nyadven02 == 26) {
		mes "插入卡片后按下按钮，就会显示目的地。";
		mes "目的地就在岛中央甲板的上方！";
		close;
	}
	mes "这是嘟噜嘟噜指南针中的初始指南针。";
	mes "嘟噜嘟噜竞赛就从这枚指南针开始。";
	close;

// callsub L_Viewpoint,<order number>,<start index>;
L_Viewpoint:
	.@index = getarg(1);
	switch(getarg(0)) {
	case 1: // Order 1: Red, Blue, Yellow, Green, White
		setarray .@Colors$[1],"^FF0000","^0000FF","^FFFF00","^00FF00","^cccccc";
		setarray .@Text$[1],"红","蓝","黄","绿","白";
		if (.@index <= 1)
			viewpoint 1,213,89,0,0xFF0000;
		if (.@index <= 2)
			viewpoint 1,128,103,1,0x0000FF;
		if (.@index <= 3)
			viewpoint 1,73,253,2,0xFFFF00;
		if (.@index <= 4)
			viewpoint 1,153,146,3,0x00FF00;
		viewpoint 1,111,178,4,0xcccccc;
		break;
	case 2: // Order 2: Yellow, Blue, White, Green, Red
		setarray .@Colors$[1],"^FFFF00","^0000FF","^cccccc","^00FF00","^FF0000";
		setarray .@Text$[1],"黄","蓝","白","绿","红";
		if (.@index <= 1)
			viewpoint 1,73,253,0,0xFFFF00;
		if (.@index <= 2)
			viewpoint 1,128,103,1,0x0000FF;
		if (.@index <= 3)
			viewpoint 1,111,178,2,0xcccccc;
		if (.@index <= 4)
			viewpoint 1,153,146,3,0x00FF00;
		viewpoint 1,213,89,4,0xFF0000;
		break;
	}
	for(set .@i,1; .@i<=5; set .@i,.@i+1)
		set .@str$, .@str$+((.@i >= .@index)?.@Colors$[.@i]:"")+.@Text$[.@i]+" ";
	if (.@index > 1)
		mes "插入卡片并按下红色按钮后，通往目的地的路线亮了起来。";
	mes "顺序是 "+.@str$+"^000000。";
	return;
}

-	script	#malangdo_compass	-1,{
	if (countitem(6428) == 0) {
		mes "这里有一台奇怪的机器。";
		mes "这是喵喵勇气队的嘟噜嘟噜指南针。";
		close;
	}
	set .@index, atoi(strnpcinfo(2));
	switch(.@index) {
	case 1:
		setarray .@var[0],11,25;
		set .@color$,"red";
		break;
	case 2:
		setarray .@var[0],12,22;
		set .@color$,"blue";
		break;
	case 3:
		setarray .@var[0],13,21;
		set .@color$,"gold";
		break;
	case 4:
		setarray .@var[0],14,24;
		set .@color$,"green";
		break;
	case 5:
		setarray .@var[0],15,23;

			setquest 7246;
			next;
			mes "[Charo]";
			mes "大侦探和他的朋友会在纳维号附近。";
			close;
		case 2:
			mes "[Charo]";
			mes "天啊，大侦探和纳维号……";
			close;
		}
	} else if (nyadven > 5 && nyadven < 12) {
		mes "[Charo]";
		mes "大侦探和他的朋友会在纳维号附近。";
		close;
	} else if (nyadven == 12) {
		mes "[Charo]";
		mes "我一直在等你……~";
		mes "呼，我急忙赶来，都喘不过气了。";
		mes "哼……喵……";
		next;
		mes "[Charo]";
		mes "你没有什么东西要给我看吗？";
		mes "快让我看看！";
		mes "拿出来！";
		next;
		if (countitem(6430) < 6) {
			mes "[Charo]";
			mes "什么？你没有带着吗？";
			mes "不可能。";
			mes "你明明应该把它带来了……";
			next;
			mes "[Rosy]";
			mes "怎么会这样？";
			mes "这幅画对我们来说非常重要。";
			mes "请把它还给我们。";
			close;
		}
		mes "[Charo]";
		mes "对，就是这个！";
		mes "这是我们的……";
		mes "可是，要怎么把碎片拼起来？";
		next;
		mes "[Rosy]";
		mes "还需要木板和胶水才能拼起来。";
		mes "要是就这样送出去，也太麻烦了！";
		next;
		mes "[Roku]";
		mes "拉托，看起来他很高兴。";
		mes "他会理解的。";
		next;
		mes "[Charo]";
		mes "真的吗……？";
		mes "没有拉托，就没有喵喵队和我们。";
		mes "只把画的碎片送给他，我觉得有点过意不去，可是……";
		next;

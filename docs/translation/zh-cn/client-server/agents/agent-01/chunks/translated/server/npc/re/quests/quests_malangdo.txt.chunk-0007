			mes "[Gobonge]";
		mes "是浣熊让我们肚子痛的吗？";
		mes "可恶的浣熊！";
		mes "一想到这件事，我的肚子又痛了！";
		mes "好吧，我就展示一次实力，";
		mes "我可以下床。";
			next;
			mes "[Gobonge]";
		mes "我需要时间集中精力应付肚子痛。";
		mes "你现在可以走了！";
			erasequest 1151;
			set malang_bad_guys,8;
			getitem 12636,20; //Malang_Sp_Can
			delitem 6427,1; //Bad_Can_Sack
			delitem 6426,30; //Bad_Can
			close;
		}
		mes "[Gobonge]";
	mes "你怎么知道坏罐头的来源？";
	mes "你现在有时间慢慢处理这件事吗？";
		emotion ET_CRY;
		close;
	} else if (malang_bad_guys == 8) {
		mes "[Gobonge]";
		mes "巡逻队长想尽快回到";
		mes "坏家伙们的世界。";
		mes "我想让你先去安抚他。";
		mes "怎么样？";
		next;
		switch(select("真麻烦，我不干了。:好的，我会去！")) {
		case 1:
			mes "[Gobonge]";
			mes "哈哈，你觉得这话很糟糕。";
			mes "我希望你成为我们的一员。";
			next;
			mes "[Gobonge]";
			mes "抱歉，但你现在该走了，";
			mes "这样我才能集中精力应付肚子痛。";
			setquest 1152;
			set malang_bad_guys,9;
			close;
		case 2:
			mes "[Gobonge]";
			mes "好吧，那我就有时间";
			mes "集中精力应付肚子痛了。";
			setquest 1153;
			set malang_bad_guys,10;
			close;
		}
	} else if (malang_bad_guys == 9) {
		mes "[Gobonge]";
		mes "嗯，调查还不够。";
		mes "我们得回到最基本的问题。";
		mes "明天再来吧。";
		mes "我可能还会像往常一样";
		mes "肚子痛。";
		close;
	} else if (malang_bad_guys > 9 && malang_bad_guys < 12) {
		mes "[Gobonge]";
		mes "去和巡逻队长一起找乐子吧！";
		close;
	} else if (malang_bad_guys == 12) {
		mes "[Gobonge]";
		mes "你代替我们做了坏事。";
		mes "听起来不错吧？";
		mes "这就是老师眼中的好学生吗？";
		emotion ET_SWEAT;
		next;
		mes "[Gobonge]";
		mes "你值得获得奖励！";
		mes "我还需要多休息一会儿，";
		mes "所以明天再调查吧！";
		erasequest 1155;
		setquest 1152;
		set malang_bad_guys,13;
		getitem 6422,5; //Egrade_Coin
		close;
	} else if (malang_bad_guys == 13) {
		mes "[Gobonge]";
		mes "明天再来吧。";
		mes "我可能还会像往常一样";
		mes "肚子痛。";
		close;
	}
OnEnable:
	enablenpc "Gobonge#ml";
	close;
OnDisable:
	disablenpc "Gobonge#ml";
	close;
}


malangdo,125,147,3	script	Patrol Leader#ml	545,{
	if (checkweight(1201,1) == 0) {
		mes "- 携带的物品太多，无法进行下一步。-";
		close;
	}
	if (malang_bad_guys < 10) {
		mes "[Patrol Leader]";
		mes "最近这里出现了坏罐头，";
		mes "请小心它们的流通，";
		mes "务必提高警惕。";
		close;
	} else if (malang_bad_guys == 10) {
		mes "[Patrol Leader]";
		mes "所以你要代替躺在床上的";
		mes "毛团帮派做坏事吗？";
		mes "一定会很刺激！";
		mes "真让人兴奋……";
		next;
		mes "[Patrol Leader]";
		mes "戈邦吉和他的朋友们";
		mes "最喜欢在闪耀珊瑚区域";
		mes "折磨^0000FF红色艾鲁玛^000000。";
		next;
		mes "[Patrol Leader]";
		mes "折磨 20 只^0000FF红色艾鲁玛^000000一段时间后，";
		mes "向我报告。";
		mes "我会以巡逻队长的身份训斥你！";
		next;
		switch(select("巡逻队长为什么喜欢这样？:振作起来！！")) {
		case 1:
			mes "[Patrol Leader]";
			mes "这就是我喜欢做的事！";
			close;
		case 2:
			mes "[Patrol Leader]";
			mes "我期待你做出各种坏事。";
			erasequest 1153;
			setquest 1154;
			set malang_bad_guys,11;
			close;
		}
	} else if (malang_bad_guys == 11) {
		if (checkquest(1154,HUNTING) == 2) {
			mes "[Patrol Leader]";
			mes "哇，你把^0000FF红色艾鲁玛^000000折磨得真惨！";
			mes "你的表现令我印象深刻。";
			next;
			mes "[Crime Prevention Staff]";
			mes "队长，我们又有工作了，对吧？";
			emotion ET_CRY;
			emotion ET_CRY, getnpcid(0, "Crime Prevention Staff#ml");
			next;
			mes "[Patrol Leader]";
			mes "藏起你的眼泪，留着以后再哭！";
			mes "找到坏事线索时，";
			mes "你应该在犯罪现场哭！";
			emotion ET_CRY;
			emotion ET_CRY, getnpcid(0, "Crime Prevention Staff#ml");
			next;
			mes "[Patrol Leader]";
			mes "调查结束后我会训斥你！";
			mes "现在去找戈邦吉。";
			erasequest 1154;
			setquest 1155;
			set malang_bad_guys,12;
			close;
		}
		mes "[Patrol Leader]";
		mes "在星光珊瑚区域内，";
		mes "折磨 20 只^0000FF红色艾鲁玛^000000一段时间后，";
		mes "向我报告。";
		mes "我会以巡逻队长的身份训斥你！";
		close;
	}
	mes "[Patrol Leader]";
	mes "调查结束后我会训斥你！";
	mes "现在去找戈邦吉";
	mes "。";
	close;
}


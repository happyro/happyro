malangdo,171,163,3	script	Awfully Suspious Dealer	543,{
	if (malang_bad_guys < 4) {
		mes "[Awfully Suspious Dealer]";
		mes "我们不卖那些东西了，去找别的商人吧！";
		close;
	} else if (malang_bad_guys == 4) {
		mes "[Awfully Suspious Dealer]";
		mes "坏罐头？";
		mes "这里有很多工作，";
		mes "就不能抽点时间聊聊吗？";
		next;
		switch(select("看起来很可疑？:我知道这里的一切！")) {
		case 1:
			mes "[Awfully Suspious Dealer]";
			mes "我和你是一条船上的人！";
			close;
		case 2:
			mes "[Awfully Suspious Dealer]";
			mes "...";
			mes "你搜过飞艇诺亚的休息室吗？";
			mes "...";
			next;
			mes "[Awfully Suspious Dealer]";
			mes "看起来不是正确的地方~";
			mes "去做别的事吧~！";
			next;
		mes "你需要搜查飞艇诺亚的休息室吗？";
			erasequest 1148;
			setquest 1149;
			set malang_bad_guys,5;
			close;
		}
	} else if (malang_bad_guys == 5) {
		mes "[Awfully Suspious Dealer]";
		mes "想在飞艇诺亚附近搜查戈赞吉，";
		mes "就像骑着技能";
		mes "拿平底锅一样，是件蠢事。";
		mes "我不建议这么做。";
		close;
	} else if (malang_bad_guys == 6) {
		if (countitem(6427) == 0) {
			mes "[Awfully Suspious Dealer]";
			mes "你搜过飞艇诺亚的休息室吗？";
			mes "但手里还是空空如也。";
			mes "我都说了什么也没有。";
			mes "...";
			next;
			mes "[Awfully Suspious Dealer]";
			mes "……一定有什么东西……";
			close;
		}
		mes "[Awfully Suspious Dealer]";
		mes "哦！那是^0000FF一袋坏罐头^000000，对吧？";
		mes "你从哪里弄到的？真厉害！";
		next;
		switch(select("别装作不知道！:得让我们的老大看看！")) {
		case 1:
			mes "[Awfully Suspious Dealer]";
			mes "看起来真棒。";
			mes "没有更多了吗？";
			emotion ET_DELIGHT;
			close;
		case 2:
			mes "[Awfully Suspious Dealer]";
			mes "放轻松！";
			mes "让我们只和自己人一起欢笑享乐吧。";
			next;
			mes "[Awfully Suspious Dealer]";
			mes "老实说，我是浣熊欢呼队的一员。";
			mes "一群无家可归的浣熊";
			mes "组成了黑市团伙。";
			mes "把那群猫赶走后，";
			mes "我会把这里变成浣熊欢呼队的总部。";
			next;
			switch(select("你是老大吗？:让我弄清楚坏罐头的用途。:能按你的计划进行吗？")) {
			case 1:
				mes "[Awfully Suspious Dealer]";
				mes "这是个令人感激的误会，";
				mes "我只是个小成员。";
				mes "我不知道老大是谁。";
				close;
			case 2:
				mes "[Awfully Suspious Dealer]";
				mes "那个……";
				mes "是用来当食物的……";
				mes "请别再问了！";
				close;
			case 3:
				mes "[Awfully Suspious Dealer]";
				mes "你瞧不起浣熊欢呼队吗？";
				mes "看好了！岛上的星星糖果们，";
				mes "我会让它们肚子痛，";
				mes "吃下大量坏罐头。";
				mes "你不期待吗？";
				next;
				mes "[Awfully Suspious Dealer]";
				mes "我不能亲手让它们吃下去，";
				mes "但对于闪耀珊瑚区域里、以星星糖果为食的生物，";
				mes "我还是会用坏罐头喂它们。";
				mes "你一定会看到惊人的反应，等着吧！";
				next;
				mes "情况很严重。";
				mes "一旦那些猫发现了，";
				mes "你可能会陷入混乱。";
				mes "我们先收回位于";
				mes "闪耀珊瑚区域的坏罐头。";
				erasequest 1150;
				setquest 1151;
				set malang_bad_guys,7;
				close;
			}
		}
	} else if (malang_bad_guys == 7) {
		mes "[Awfully Suspious Dealer]";
		mes "请忘了我告诉你的事。";
		mes "拜托了……";
	mes "你在闪耀珊瑚区域拿到";
		mes "30 个坏罐头后，";
		mes "不要告诉那些猫，";
		mes "也不要报告这件事！";
		close;
	}
	mes "[Awfully Suspious Dealer]";
	mes "所以你把一切都报告了？";
	mes "...";
	mes "现在该开始新的生活了，";
	mes "属于毛团帮派的新生活……";
	close;
}


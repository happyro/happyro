			}
			mes "[伊恩·阿特纳德]";
			mes "如果你不是来工作的，就离开吧。";
			mes "你会分散我的注意力。";
			return;
		}
		if (countitem(6749) < 20) {// Power_Control_Device
			mes "总是这样。";
			mes "是^4d4dff 20 个能量控制装置^000000。";
			mes "既然我们已经走到这一步，我想把事情做好，所以尽量别搞砸。";
			return;
		}
		mes "你又做对了。";
		mes "……";
		mes "你在看什么？";
		mes "放下你带来的东西，然后离开。";
		next;
		mes "[伊恩·阿特纳德]";
		mes "……这次我会好好使用它，不把它弄坏。";
		mes "我们也慢慢开始修复吧。";
		delitem 6749, countitem(6749);// Power_Control_Device
		erasequest 7615;// Core Collection
		setquest 7616;// Core Collection - Down
		getexp 1500000,1000000;
		return;
	case 0:
	case 1:
		mes "我们现在正在研究它。";
		mes "实验可能会让它失去作用。";
		mes "总之我现在很忙，别来打扰我。";
		return;
	case 2:
		erasequest 7616;// Core Collection - Down
		mes "我们以前回收的能量控制装置全都坏了。";
		mes "它们无法承受这些实验。";
		mes "现在这些也是一样。";
		next;
		cutin "verus_ian04.bmp",2;
		mes "[伊恩·阿特纳德]";
		mes "阿奎恩也是如此。";
		mes "……因为她无法承受……";
		mes "……呼……";
		return;
	}
	end;

OnInit:
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "!isbegin_quest(7616) && ep15_1_atnad > 16" );
	end;
}

//- Wandering Bard Quest
verus03,129,21,5	script	Wandering Bard#ep15	1_M_BARD,{
function checkstatusquest;

	if (BaseLevel < 99) {
		mes "[流浪诗人]";
		mes "这里非常危险，";
		mes "最好离开这里，";
		mes "前方即将面临";
		mes "极其致命的危险。";
		close;
	}
	mes "[流浪诗人]";
	if (isbegin_quest(4295) == 2) {// Wandering Bard
		mes "我已经把";
		mes "想告诉你的一切都说了。";
		mes "希望我们能在别的地方再次相遇。";
		next;
		mes "[流浪诗人]";
		mes "在那之前，";
		mes "请保重。";
		mes "我要去别的地方，";
		mes "寻找新的故事来讲述。";
		mes "你走你的路，我走我的路。";
		close;
	}

	switch( checkquest(4296,PLAYTIME) ) {
	case -1:
		break;
	case 0:
	case 1:
		mes "我现在没有故事可讲。";
		mes "我正努力让自己的思绪休息一下。";
		mes "你不如先去";
		mes "休息一会儿？";
		close;
	case 2:
		erasequest 4296;
		break;
	}

	setarray .@quest_id[0],
		4297,	// Bard's Story: Some Corporation
		4298,	// Bard's Story: The President
		4299,	// Bard's Story: a Scholar in Juno
		4300,	// Bard's Story: a Mad Scientist
		4301,	// Bard's Story: Hugel
		4302;	// Bard's Story: Odin Temple
	.@size_quest_id = getarraysize(.@quest_id);

	for ( .@i = 0; .@i < .@size_quest_id; .@i++ ) {
		switch( isbegin_quest(.@quest_id[.@i]) ) {
		case 0:
			.@quest_undone[.@size_undone] = .@quest_id[.@i];
			.@size_undone++;
			continue;
		case 1:
			break;
		case 2:
			.@total += 2;
			continue;
		}
		break;
	}

	if (.@i < .@size_quest_id) {
		mes "冒险者，";
		mes "你带来了";
		mes "什么故事？";
		next;
		if (checkstatusquest(.@quest_id[.@i]) == 0) {
			mes "^ff0000你还没有满足完成任务的条件。^000000";
			next;
			if (select( "提交任务。", "结束对话。" ) == 2) {
				mes "[流浪诗人]";
				mes "请保重。";
				close;
			}
			mes "[流浪诗人]";
			mes "也许你还没有准备好";
			mes "接受那项任务。";
			next;
			mes "[流浪诗人]";
			mes "晚点再来，";
			mes "我会准备好新的故事。";
			mes "暂时再见。";
			erasequest .@quest_id[.@i];
			if (.@quest_id[.@i] == 4297)	// actually this quest is the only one to give a delay
				setquest 4296;// Take a Break
			close;
		}
		mes "- 讲述你的故事。 -";
		next;
		mes "[流浪诗人]";
		switch( .@quest_id[.@i] ) {
		case 4297:
			mes "也许事情比这更复杂，";
			mes "但我们已经无从得知，";
			mes "因为现在已经太晚了。";
			next;
			mes "[流浪诗人]";
			mes "你的故事让我心情低落，";
			mes "而且我本来心情就不好。";
			mes "不过至少很高兴看到你平安回来。";
			break;
			case 4298:
		mes "施瓦茨瓦尔德似乎";
			mes "分裂成了";
			mes "各种政治派系。";
			mes "政治阴谋对";
			mes "我这样的流浪艺人没什么意义。";
			next;
			mes "[流浪诗人]";
			mes "不过我为你感到骄傲：";
			mes "你结识了总统，";
			mes "还替他完成了秘密任务。";
			mes "我也很高兴看到你平安回来。";
			break;
			case 4299:
		mes "学者真是奇怪的人。";
			mes "我无法理解";
			mes "研究这种东西有什么乐趣。";
			next;
			mes "[流浪诗人]";
			mes "当然，对某些人来说，";
			mes "我寻找新故事";
			mes "听起来毫无意义。";
			mes "但只要有你这样的好奇冒险者";
			mes "陪我消磨时间，我就不在乎。";
			next;
			mes "[流浪诗人]";
			mes "欢迎回来。";
			mes "我很喜欢你这次的故事。";
			break;
			case 4300:
		mes "只有神知道";
			mes "谁是对的，";
			mes "谁是错的。";
			mes "我相信那些科学家也是如此。";
			next;
			mes "[流浪诗人]";
			mes "如果你问我，";
			mes "我说不清哪一方对、哪一方错。";
			mes "你能说清吗？";
			next;
			mes "[流浪诗人]";
			mes "欢迎回来。";
			mes "我很喜欢你这次的故事。";
			break;
			case 4301:
		mes "科技进步并不总意味着";
			mes "旧事物的毁灭。";
			mes "科技无法独自前进。";
			mes "医学和生命研究";
			mes "也是如此。";
			next;
			mes "[流浪诗人]";
			mes "嗯，";
			mes "至少我是这么听说的。";
			mes "……就当我没说。";
			next;
			mes "[流浪诗人]";
			mes "普通大众";
			mes "只喜欢听圆满的结局，";
			mes "所以让我们关注";
			mes "故事积极的一面，";
			next;
			mes "[流浪诗人]";
			mes "欢迎回来。";
			mes "而不是";
			mes "黑暗、";
			mes "令人沮丧的一面。";
			break;
			case 4302:
		mes "我不确定同样的事情";
			mes "是否会发生在";
			mes "这个挖掘现场，";
			mes "因为连我都能感觉到危险的阴影笼罩着这里。";
			next;
			mes "[流浪诗人]";
			mes "至于你遇到的最后那个人，";
			mes "嗯……";
			next;
			mes "[流浪诗人]";
			mes "没什么。我根本不该说出来。";
			next;
			mes "[流浪诗人]";
			mes "我们只能看着";
			mes "各派互相勾心斗角，";
			mes "并祈求";
			mes "最好的结果。";
			mes "作为吟游诗人，我的职责就是把消息传给大众。";
			next;
			mes "[流浪诗人]";
			mes "很高兴看到你平安回来。";
			mes "也谢谢你";
			mes "带来这么宝贵的故事。";
			break;
			}
		next;
		mes "[流浪诗人]";
		if (.@total == 10) {
		mes "唉，我不想这么说，";
			mes "但这恐怕是我们最后一次";
			mes "分享彼此的故事了。";
			mes "谢谢你告诉我那些有趣的故事。";
			next;
			mes "[流浪诗人]";
			mes "请收下这个。";
			mes "希望";
			mes "它对你有用。";
			mes "希望我们能在别的地方再次相遇。";
			completequest .@quest_id[.@i];
			setquest 4295;// Wandering Bard
			completequest 4295;
			getitem 12263,5;// Comp_Battle_Manual
			next;
			mes "[流浪诗人]";
			mes "我必须离开，";
			mes "去寻找新的故事。";
			mes "你走你的路，我走我的路。";
			mes "请保重。";
			close;
			}
		completequest .@quest_id[.@i];
		setquest 4296;// Take a Break
		mes "请给我一点时间。";
		mes "我想根据你刚才讲的故事";
		mes "创作一首新歌。";
		next;
		mes "[流浪诗人]";
		mes "在此期间，你应该休息并重新整顿。";
		close;
		}
	.@r = rand(.@size_undone);
	setquest .@quest_undone[.@r];
	mes "听听我的故事吧。";
	next;
	mes "[流浪诗人]";
	switch( .@quest_undone[.@r] ) {
	case 4297:
	mes "在科学胜过魔法的";
		mes "施瓦茨瓦尔德共和国，";
		mes "有一家由人类组成的巨型企业";
		next;
		mes "[流浪诗人]";
		mes "据说正在进行研究，";
		mes "目的既高尚又令人怀疑。";
		mes "你知道";
		mes "这家企业紧闭的大门后发生了什么吗？";
		next;
		mes "[流浪诗人]";
		mes "你应该";
		mes "进一步调查那家企业正在做什么。";
		mes "请小心。";
		close;
		case 4298:
	mes "你认识";
		mes "施瓦茨瓦尔德共和国的总统吗？";
		mes "通常，像你我这样的普通人";
		mes "根本不敢想象能见到那样的大人物，";
		next;
		mes "[流浪诗人]";
		mes "但据说只要";
		mes "在利塔尔泽找到他的联络人就能见到。";
		mes "你不仅能见到总统，";
		mes "还可以开启新的冒险。";
		next;
		mes "[流浪诗人]";
		mes "去找他的联络人，";
		mes "其他事情自然会水到渠成。";
		mes "谁知道呢？";
		mes "也许人生中的冒险正在等待你。";
		close;
		case 4299:
	mes "不知道这些研究人员";
		mes "都是从哪里来的。";
		mes "他们一定";
		mes "来自世界各地，";
		mes "寻求发现未知事物的刺激。";
		next;
		mes "[流浪诗人]";
		mes "我认为最勇敢的人";
		mes "就是学者和研究人员，";
		mes "比如朱诺图书馆的那些人……";
		next;
		mes "[流浪诗人]";
		mes "哦，说到朱诺图书馆，";
		mes "我知道那里有位学者";
		mes "也在进行类似的研究，";
		mes "就是，";
		mes "整天观察奇怪的东西。";
		next;
		mes "[流浪诗人]";
		mes "你应该";
		mes "去和那位学者谈谈。";
		mes "他也许会让你看到全新的世界。";
		close;
		case 4300:
	mes "这些人";
		mes "是在互相帮助吗？";
		next;
		mes "[流浪诗人]";
		mes "据说朱诺有一位疯狂的科学家，";
		mes "有一群人正在";
		mes "试图阻止他的危险研究。";
		next;
		mes "[流浪诗人]";
		mes "我认为这种说法有失偏颇。";
		mes "也许科学家是理智的，";
		mes "而那些人才很危险。";
		mes "谁知道呢？换作是我，我会远离他们双方。";
		close;
		case 4301:
	mes "学者啊。他们的研究底线在哪里？";
		mes "像你我这样的漂泊者";
		mes "不必操心世界，我很庆幸如此。";
		next;
		mes "[流浪诗人]";
		mes "在胡格尔，有一位学者";
		mes "据说沉迷于危险的实验。";
		mes "我想让你去弄清楚";
		mes "他追求的究竟是什么：";
		mes "幸福，还是空洞的野心。";
		close;
		case 4302:
	mes "很久以前我也见过同样的景象，";
		mes "那时";
		mes "奥丁神殿";
		mes "刚刚被发现。";
		next;
		mes "[流浪诗人]";
		mes "哦，这让我想起";
		mes "那个故事，";
		mes "关于与奥丁神殿有关的两个人——不，三个人。";
		next;
		mes "[流浪诗人]";
		mes "不知道胡格尔还留着";
		mes "招募挖掘者的告示牌吗。";
		mes "你能去看看吗？";
		mes "回来后我想听听那些挖掘者背后的故事。";
		close;
		}
	end;
	
function checkstatusquest {
switch( getarg(0) ) {
	case 4297:
	if (lhz_curse >= 31)// Cursed Spirit Quest
		return true;
			break;
		case 4298:
	if (lhz_boss >= 43)// President Quest
		return true;
			break;
		case 4299:
	if (yuno_hist >= 10)// Juperos Ruins History Quest
		return true;
			break;
		case 4300:
	if (metto_q >= 9)// Metto Quest
		return true;
			break;
		case 4301:
	if (hg_bio >= 9)// Biological Weapon Quest
		return true;
			break;
		case 4302:
	if (hg_odin >= 60)// Odin Temple Excavation Quest
		return true;
			break;
		}
	return false;
	}
}

//- Police Quests
verus04,133,212,4	script	Police Chief Kesler#EP15_1	2_M_SWORDMASTER,{
if (checkweight(1301,1) == 0) {
	mes "- 你携带的物品太多，无法继续。 -";
		close;
		}
	.@playtime_5318 = checkquest(5318,PLAYTIME);	// Come Back Tomorrow
	.@quest_5309 = isbegin_quest(5309);				// Police Chief's Request
	if (.@playtime_5318 == 2) {
	erasequest 5318;
		mes "[凯斯勒警察局长]";
		mes "很高兴见到你。我是凯斯勒，幻影之塔警察局局长。";
		emotion ET_DELIGHT;
		}
	else {
	mes "[凯斯勒警察局长]";
		mes "欢迎来到幻影之塔警察局。";
		emotion ET_PROFUSELY_SWEAT;
		}
	next;
	if (countitem(6753) < 1)// Sign_Of_Destruction
	.@menu$[0] = "在幻影之塔需要注意什么";
		else
	.@menu$[1] = "我带来了末日代币。";
		switch( select( "幻影之塔警察局？", "有什么我能帮忙的吗？", .@menu$[0], .@menu$[1], "没什么。" ) ) {
	case 1:
	emotion ET_SCRATCH;
		mes "[凯斯勒警察局长]";
		mes "哦，你想了解^4E9867幻影之塔警察局^000000吗？谢谢你。很少有人对我们的工作感兴趣。";
		next;
		mes "[凯斯勒警察局长]";
		mes "你可能会疑惑，这个新地方为什么需要警察单位。嗯，这是有原因的。";
		next;
		select("什么原因？");
		mes "[凯斯勒警察局长]";
		mes "你听说过^F8081E末日祈祷团^000000吗？";
		next;
		emotion ET_FRET;
		mes "[凯斯勒警察局长]";
		mes "他们是宣扬世界末日的邪教组织，以神的名义进行破坏。";
		next;
		mes "[凯斯勒警察局长]";
		mes "他们最近才出现在幻影之塔，却已经造成了巨大破坏，所以学者和佣兵组织了这个警察单位。";
		next;
		mes "[凯斯勒警察局长]";
		mes "^F8081E末日祈祷团^000000主要出没于^82ABE9维鲁斯中央广场^000000。遇到他们时，尽管给他们一点教训。";
		next;
		emotion ET_SMILE;
		mes "[凯斯勒警察局长]";
		mes "哈哈，我们人手不足。";
		close;
		case 2:
	if (isbegin_quest(5309) == 0) {
		mes "[凯斯勒警察局长]";
			if (BaseLevel < 140) {
			mes "我理解你的热情，但现在应该专心训练。";
				next;
				emotion ET_SORRY;
				mes "[凯斯勒警察局长]";
				mes "幻影之塔比你想象的更危险。";
				close;
				}
			if (.@playtime_5318 == 0 || .@playtime_5318 == 1) {
			mes "谢谢你愿意帮忙，但我们自己能应付。";
				close;
				}
			if (isbegin_quest(5304) == 0) {
			emotion ET_HUK;
				mes "抱歉，你说什么？";
				next;
				select("有什么我能帮忙的吗？");
				//

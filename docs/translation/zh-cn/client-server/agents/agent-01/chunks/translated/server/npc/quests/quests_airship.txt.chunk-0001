// Airship Ticket Quest :: ein_tre
//============================================================

//----------------------------------------------------------------------------
// Kain Himere
//----------------------------------------------------------------------------
airplane,47,61,7	script	Crewman	4_M_ZONDAOYAJI,{
	mes "[Kain Himere]";
	if (kain_ticket == 4) {
		mes "啊……在这里！";
		next;
		mes "[Kain Himere]";
		mes "几天前，一位来自艾因布洛克的客人把它落在飞艇上。他打电话说无法回来取，但住在艾因布洛克酒店。";
		next;
		mes "[Kain Himere]";
		mes "我知道请求很奇怪，但你能把它送到艾因布洛克酒店的德弗鲁·阿克吗？回来后我会报答你。";
		next;
		setquest 2079;
		kain_ticket = 5;
		mes "^3355FF凯恩·海默尔给了你一个小盒子。^000000";
		close;
	}
	mes "欢迎乘坐飞艇～有问题或需要帮助，请随时询问我或其他船员。";
	next;
	if (kain_ticket == 0 || kain_ticket == 1) {
		switch(select("关于飞艇……", "留下评论" )) {
		case 1:
			mes "[Kain Himere]";
			kain_ticket++;
			if (kain_ticket == 1) {
				mes "这是你第一次飞行吗？紧张很正常。我来这里工作前也一样。不过这艘飞艇很神奇，科学真是不可思议……";
				next;
				mes "[Kain Himere]";
				mes "开发飞艇技术的学者说，只需一小块伊米尔之心，就能产生让飞艇飞行的力量。太不可思议了……";
				next;
				mes "[Kain Himere]";
				mes "科学研究让施瓦尔茨共和国的生活更轻松舒适，就像魔法研究改变了卢恩·米德加尔特王国的生活。";
			}
			else {
				mes "想听更多飞艇的事？嗯，我知道的不多，让我想想……";
				next;
				mes "[Kain Himere]";
				mes "据说一家大型企业经营这艘飞艇，并涉足各种行业。";
				next;
				mes "[Kain Himere]";
				mes "飞艇是国家交通工具，高层一定赚了很多钱。真疯狂。";
			}
			close;
		case 2:
			mes "[Kain Himere]";
			mes "想对服务留下评论？告诉我留言，我会报告给上级。取消请输入“0”。";
			next;
			input .@comment$;
			if (.@comment$ == "kafra") {
				mes "[Kain Himere]";
				mes "卡、卡普拉……？嗯，也许还是别上报了……";
				emotion ET_FRET;
			} else if (.@comment$ == "0") {
				mes "[Kain Himere]";
				mes "如果对服务有有益的批评，随时欢迎留言。";
			} else {
				mes "["+strcharinfo(0)+"]";
				mes .@comment$+".";
				next;
				mes "[Kain Himere]";
				mes "嗯……我明白了。我会尽快把留言转给上级。非常感谢。";
			}
			close;
		}
	} else if (kain_ticket == 2 || kain_ticket == 3) {
		if (kain_ticket == 3) {
			mes "[Kain Himere]";
			mes "哦，你好吗？不介意的话，你这次要去哪里？";
		} else {
			select("关于飞艇……");
			next;
			mes "[Kain Himere]";
			mes "你真的想了解飞艇的一切，对吧？抱歉，我知道的就这么多。";
			next;
			mes "[Kain Himere]";
			mes "如果想知道更多，就去朱诺学习成为贤者，自己研究飞艇吧……";
			next;
			mes "[Kain Himere]";
			mes "^666666*Sob...*^000000";
			mes "抱、抱歉……";
			mes "^666666*Sniff*^000000";
			next;
			switch(select("搞什么……？:怎么了？")) {
			case 1:
				mes "[Kain Himere]";
				mes "对、对不起……太失礼了。祝你旅途平安，谢谢乘坐飞艇！^333333*抽泣*^000000";
				close;
			case 2:
				mes "[Kain Himere]";
				mes "抱歉，这是个很长的故事。而且你不会理解……";
				next;
				select("我有时间听你慢慢说。");
				mes "[Kain Himere]";
				mes "好吧，我还是说出来吧。故事始于我年轻时住在艾因贝赫。";
				next;
				mes "[Kain Himere]";
				mes "那时我脾气暴躁，但做矿工总能让我平静。和朋友们一起、手握矿镐，把生命交给矿井。是的……";
				next;
				mes "[Kain Himere]";
				mes "工作可能危险，但辛苦而诚实。连接艾因贝赫矿脉的矿井曾是小镇的一切，但后来情况变了……";
				next;
				mes "[Kain Himere]";
				mes "工厂开始兴起，矿石被运到烟囱永不停转的地方。更多矿工进了工厂，矿井变得更加冷清……";
				next;
				mes "[Kain Himere]";
				mes "但我太喜欢这份工作，一直坚持到事故发生。现在右臂无法像过去那样使用，只好辞去矿工工作……";
				next;
				select("听到这些我很难过。");
				next;
				mes "[Kain Himere]";
				mes "是的……事故让我崩溃，那可能是我一生中最糟糕的几年。";
				next;
				mes "[Kain Himere]";
				mes "我无法想象没有采矿的生活，失去了对生活的热情。我开始酗酒，疏远家人。我真傻……";
				next;
				mes "[Kain Himere]";
				mes "我至今难以相信妻子当时多么支持我。即使我跌入低谷，她仍安慰我，还找工作养活我和女儿。";
				next;
				mes "[Kain Himere]";
				mes "^666666*抽泣*^000000 她去世后我才";
				mes "她去世后我才意识到她承受了多少痛苦。更糟的是，我找工作时不得不把女儿留给邻居……";
				next;
				mes "[Kain Himere]";
				mes "我多年在城镇间流浪，过着放纵生活，直到重新振作。最终我成了飞艇船员。";
				next;
				mes "[Kain Himere]";
				mes "我失去家人已经二十年。女儿就在某处，但我甚至不记得她的名字……";
				next;
				select("你试过找她吗？");
				mes "[Kain Himere]";
				mes "我去过邻居曾住的房子，但他们几年前就搬走了。";
				mes "我完全不知道她在哪里。但我不配见她，我是个糟糕的父亲！";
				next;
				mes "[Kain Himere]";
				mes "^666666*抽泣*^000000 抱歉让你";
				mes "让你听了这么多，真抱歉。但谢谢你愿意倾听。你要去哪里？";
				break;
			}
		}
		next;
		switch(select("Einbroch:Juno")) {
		case 1:
			kain_ticket = 4;
			mes "["+strcharinfo(0)+"]";
			mes "我要去艾因布洛克。";
			next;
			mes "[Kain Himere]";
			mes "太好了……！如果你不介意，可以帮我一个忙吗？先让我找到那个包裹……";
			close;
		case 2:
			kain_ticket = 3;
			mes "["+strcharinfo(0)+"]";
			mes "我要去朱诺。";
			next;
			mes "[Kain Himere]";
			mes "啊，我明白了……我有东西要送到艾因布洛克。祝你旅途愉快。谢谢你倾听。";
			close;
		}
	} else if (kain_ticket > 4 && kain_ticket < 10) {
		mes "[Kain Himere]";
		mes "哦，你好！现在有点忙，不过你送到——哦！等等，抱歉！先生——！";
		next;
		mes "^3355FFKain seems too";
		mes "现在太忙，没法和你说话……^000000";
	} else if (kain_ticket == 10) {
		mes "[Kain Himere]";
		mes "欢迎回到飞艇。那个小盒子安全送到了吗？";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "不幸的是，他不在。我把盒子还给你。";
		next;
		mes "[Kain Himere]";
		mes "哦……现在该怎么办？算了，抱歉让你费这么多功夫。";
		next;
		switch(select("Casually mention Miner's Song", "Suavely mention Tarsha")) {
		case 1:
			mes "["+ strcharinfo(0) +"]";
			mes "说到盒子和送货，你听过《矿工之歌》吗？";
			next;
			mes "[Kain Himere]";
			mes "''Miner's Song...''";
			mes "我怀念在矿井工作时唱它。年轻时我经常唱。";
			next;
			mes "[Kain Himere]";
			mes "我唱得太多了，甚至让小女儿和我一起唱～";
			mes "（但她叫什么名字？！）";
			break;
		case 2:
			mes "["+ strcharinfo(0) +"]";
			mes "^333333*Cough cough*";
			mes "*Cou--TARSHA--Cough*^000000";
			next;
			mes "[Kain Himere]";
			mes "什么……？等等。塔莎……为什么这个名字让我感觉如此熟悉？";
			break;
		}
		next;
		mes "["+strcharinfo(0)+"]";
		mes "你知道吗……我在艾因布洛克遇到一个唱《矿工之歌》的小女孩，似乎是她母亲塔莎教她的。";
		next;
		mes "[Kain Himere]";
		mes "有趣。不过通常只有矿工知道那首歌。这和我有关吗？";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "这个女孩的母亲塔莎从父亲那里学会这首歌，而她父亲可能是矿工。但他多年前神秘失踪了……";
		next;
		mes "[Kain Himere]";
		mes "可怜的女孩……！她父亲就这样离开她？！为什么，她简直像……";
		next;
		mes "[Kain Himere]";
		mes "等等……天啊……教塔莎唱歌的矿工可能就是……^0000FF我^000000。";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "现在还不能确定。你有什么能证明自己是塔莎父亲的东西吗？";
		next;
		mes "[Kain Himere]";
		mes "嗯……离开小镇前，我把一些东西埋在艾因贝赫的一棵树下。记不清具体位置，但我妻子的日记应该在那里。";
		next;
		mes "[Kain Himere]";
		mes "妻子在日记里记录了一切，应该写过足够多关于女儿的事，可以确认塔莎是不是我失散多年的女儿。";
		next;
		mes "[Kain Himere]";
		mes "我不能离开飞艇，你能帮我找到日记，确认塔莎是否与我有血缘关系吗？如果你能帮忙，我会非常感激……";
		changequest 2081,2082;
		kain_ticket = 11;
	} else if (kain_ticket == 11 || kain_ticket == 12) {
		mes "[Kain Himere]";
		mes "你能找到我妻子的日记，确认塔莎是不是女儿吗？日记应该埋在艾因贝赫的一棵树下。";
	} else if (kain_ticket == 13) {
		mes "^3355FF你最好完成凯恩的";
		mes "先找到他妻子的日记并与塔莎见面，再去找他。^000000";
	} else if (kain_ticket == 14) {
		if (countitem(7276) == 1) {// Picture_Letter
			mes "^3355FF你把他妻子的日记";
			mes "把日记交给凯恩，告诉他塔莎就是女儿，她已幸福结婚，并在艾因布洛克做发明家。^000000";
			next;
			mes "^3355FF凯恩的眼中泛起泪光";
			mes "他含泪而泣，整个身体因无法抑制的喜悦而颤抖。";
			next;
			mes "[Kain Himere]";
			mes "她一定吃了很多苦……但她一点也不恨我。";
			next;
			mes "[Kain Himere]";
			mes "拉谢尔？你能看见我吗？我真的可以这么幸福吗？对不起，我的爱人……^666666*抽泣*^000000";
			next;
			mes "[Kain Himere]";
			mes "谢谢你的帮助，年轻人。请收下这个作为谢礼。";
			next;
			mes "[Kain Himere]";
			mes "我知道这不多，但这是我能给你的全部。愿神保佑你为我所做的一切～";
			completequest 2085;
			kain_ticket = 15;
			delitem 7276,1;// Picture_Letter
			getitem 7311,4;// Free_Flying_Ship_Ticket
		} else {
			mes "^3355FFHmmm...";
		mes "最好带着收到的涂鸦信去找凯恩。^000000";
		}
	} else {
		mes "[Kain Himere]";
		mes "哦，朋友，最近好吗？我过得很好，尤其是你帮我找到了女儿。祝你旅途愉快～";
	}
	close;

			next;
			mes "["+ strcharinfo(0) +"]";
			mes "嘿嘿嘿，你可以相信我。接下来是“生命之水”。";
			next;
			mes "- 我把“生命之水”倒在玛丽亚身上 -";
			next;
		} else {
			mes "["+ strcharinfo(0) +"]";
			mes "好，接下来是“生命之水”。";
			next;
			mes "- 我把生命之水 -";
			mes "- 倒在玛丽亚僵硬的身体上 -";
			next;
		}
		mes "- !! -";
		specialeffect EF_RESURRECTION,AREA,"Maria Morebna#rus46";
		next;
		mes "[灰狼]";
		mes "成功了！！";
		next;
		mes "[玛丽亚·莫布雷娜]";
		mes "啊，我……？！";
		mes "你救了我。我真的很感激。谢谢你帮助我们对抗科谢。";
		next;
		mes "[玛丽亚·莫布雷娜]";
		mes "还有你，灰狼……谢谢你在我无助时保护我。";
		next;
		mes "[玛丽亚·莫布雷娜]";
		mes "科谢没有被完全摧毁。不过他的力量已经减弱，封印他的力量应该不难，也不会把我一起封印。";
		next;
		mes "[玛丽亚·莫布雷娜]";
		mes "科谢和我被魔法绑定。如果一方的力量被封印，另一方也必须被封印。";
		next;
		mes "[玛丽亚·莫布雷娜]";
		mes "但原本的封印随着时间减弱，科谢得以逃出囚禁。这就是我请求你把我救出来的原因。";
		next;
		mes "[玛丽亚·莫布雷娜]";
		mes "他察觉到我想逃离，于是在这里等待任何愿意帮助我的人。我从没料到会这样……";
		next;
		mes "[玛丽亚·莫布雷娜]";
		mes "总之，我非常感谢你所做的一切。";
		next;
		mes "[玛丽亚·莫布雷娜]";
		mes "请收下这份微薄的奖励，希望它能帮助勇敢的冒险者。愿神明保佑你的旅途。";
		// completequest 8180;
		next;
		mes "[玛丽亚·莫布雷娜]";
		mes "我已经很久没有感受阳光、清风和青草的气息了。真的非常感谢。";
		rhea_rus_main = 52;
		// completequest 8171;
		.@rus_food = rand(1,6);
		switch (rand(1,6)) {
			case 1: getitem 12093,1; break;// Dex_Dish08
			case 2: getitem 12088,1; break;// Agi_Dish08
			case 3: getitem 12073,1; break;// Str_Dish08
			case 4: getitem 12078,1; break;// Int_Dish08
			case 5: getitem 12083,1; break;// Vit_Dish08
			case 6: getitem 12098,1; break;// Luk_Dish08
		}
		if (checkre(3)) {
			if (BaseLevel < 56) getexp 1300,350;
			else if (BaseLevel < 61) getexp 2460,615;
			else if (BaseLevel < 66) getexp 4242,1060;
			else if (BaseLevel < 71) getexp 6489,1622;
			else if (BaseLevel < 76) getexp 16491,4123;
			else if (BaseLevel < 81) getexp 27629,6907;
			else if (BaseLevel < 86) getexp 34041,8510;
			else if (BaseLevel < 91) getexp 41846,10462;
			else if (BaseLevel < MAX_LEVEL) getexp 88814,22204;
			else getitem 617,1; //Old_Violet_Box
		} else {
			if (BaseLevel < 56) getexp 13000,3500;
			else if (BaseLevel < 61) getexp 24600,6150;
			else if (BaseLevel < 66) getexp 42420,10605;
			else if (BaseLevel < 71) getexp 64892,16223;
			else if (BaseLevel < 76) getexp 164908,41227;
			else if (BaseLevel < 81) getexp 276292,69073;
			else if (BaseLevel < 86) getexp 340408,85102;
			else if (BaseLevel < 91) getexp 418460,104615;
			else if (BaseLevel < 99) getexp 888140,222035;
			else getitem 617,1; //Old_Violet_Box
		}
		donpcevent "Gray Wolf#rus05::OnDisable";
		donpcevent "Maria Morebna#rus46::OnDisable";
		close;
	} else if (rhea_rus_main > 51) {
		mes "[女孩的声音]";
		mes "……科谢是不朽的，总有一天一定会再次出现……";
		next;
		mes "[女孩的声音]";
		mes "那时我会对付他。我会利用等待的时间训练自己，等他回来时变得更强……";
		next;
		mes "[女孩的声音]";
		mes "感谢你为我和我的村庄尽了最大努力。我永远不会忘记你的善意。";
		next;
		mes "[女孩的声音]";
		mes "啊，有空去找巴巴雅嘎。她似乎有话要告诉你。";
		next;
		mes "[女孩的声音]";
		mes "照顾好自己。你最好离这里远点，因为科谢可能会把你的力量据为己有，呵呵。";
		close;
	}

OnInit:
	$@rus_req02 = 0;
	end;

OnEnable:
	enablenpc "Wall#rus04";
	end;

OnDisable:
	disablenpc "Wall#rus04";
	end;

OnMyMobDead:
	donpcevent "Koshei#rus47::OnDisable";
	$@rus_req02 = 0;
	// stopnpctimer;
		announce "不朽的科谢：咯咯咯，你这个受诅咒的人类……我绝不会放弃！！！我们走着瞧，最后看谁还能笑！！！",bc_map,0xCE3131;
	end;
}

//----------------------------------------------------------------------------
// Koshei, The Immortal
//----------------------------------------------------------------------------
mosk_dun01,5,5,0	script	Koshei#rus47	-1,0,0,{
	end;
OnInit:
	disablenpc "Koshei#rus47";
	end;

OnEnable:
	initnpctimer;
	enablenpc "Koshei#rus47";
	end;

OnDisable:
	stopnpctimer;
	disablenpc "Koshei#rus47";
	end;

OnTimer3000:
		mapannounce "mosk_dun01","不朽的科谢：我会杀死所有打扰我的人！！弱小的人类，在恐惧中哭泣吧！！！",bc_map,0xCE3131;
	end;

OnTimer63000:
		mapannounce "mosk_dun01","不朽的科谢：你们这些虫子，不过是一群怪物……挡我路的人都会遭到我的诅咒！！",bc_map,0xCE3131;
	end;

OnTimer150000:
		mapannounce "mosk_dun01","不朽的科谢：人类！在恐惧中哭泣吧！！哈哈哈哈哈哈哈哈！！！",bc_map,0xCE3131;
	end;

OnTimer300000:
	stopnpctimer;
	initnpctimer;
	end;
}


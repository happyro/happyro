//----------------------------------------------------------------------------
// The Blacksmith (Golden Key)
//----------------------------------------------------------------------------
moscovia,178,127,0	script	The Blacksmith#rus06	1_M_SMITH,{
	if ((MaxWeight-Weight) < 3500) {
		mes "[铁匠]";
		mes "你为什么带这么多东西？";
		mes "你是在训练什么吗？";
		close;
	}
	if (rhea_rus_main < 6) {
		mes "[铁匠]";
		mes "哈哈哈~";
		mes "天气真好！对吧？";
		mes "非常适合野餐。";
		next;
		mes "[铁匠]";
		mes "不过，我听说有些人在村子附近岛上的森林里迷路了。到底怎么回事？";
		close;
	} else if (rhea_rus_main == 6) {
		mes "[铁匠]";
		mes "哈哈哈~";
		mes "天气真好！对吧？";
		mes "非常适合野餐。";
		next;
		mes "[铁匠]";
		mes "不过，我听说有些人在村子附近岛上的森林里迷路了。到底怎么回事？";
		next;
		select("打扰一下……");
		mes "["+ strcharinfo(0) +"]";
		mes "请问，你听说过知道如何制作‘^0000ff黄金钥匙^000000’的制钥师吗？";
		next;
		mes "[铁匠]";
		mes "嗯，你是冒险者？是谁告诉你‘^0000ff黄金钥匙^000000’的？";
		next;
		mes "["+ strcharinfo(0) +"]";
		mes "啊，其实……";
		next;
		mes "- 你告诉他 -";
		mes "- 玛丽亚·莫布雷娜 -";
		mes "- 和灰狼的事情 -";
		next;
		mes "[铁匠]";
		mes "那么……“^0000ff黄金钥匙^000000”的制作者。";
		mes "你问我这件事真是幸运。";
		next;
		mes "["+ strcharinfo(0) +"]";
		mes "你、你什么意思……？";
		next;
		mes "[铁匠]";
		mes "我是镇上唯一知道制作‘^0000ff黄金钥匙^000000’所需材料的人！哈哈哈！";
		next;
		mes "[铁匠]";
		mes "我猜你以为收集材料很容易，对吧？";
		next;
		mes "["+ strcharinfo(0) +"]";
		mes "喂，我可没这么说……";
		next;
		mes "[铁匠]";
		mes "哈哈哈~";
		mes "这需要很多努力。";
		mes "如果你选择踏上旅程，";
		mes "前方会有漫长的道路。";
		next;
		mes "[铁匠]";
		mes "你的靴子会磨损，";
		mes "在这趟旅程结束后。";
		mes "你觉得怎么样？";
		mes "想试试吗？";
		next;
		mes "["+ strcharinfo(0) +"]";
		mes "当然！我必须帮助玛丽亚！";
		next;
		mes "[铁匠]";
		mes "哈哈哈！我喜欢你！好，先带^0000ff25 个钢铁^000000来。";
		mes "我不会离开，收集好后回来找我。";
		next;
		mes "["+ strcharinfo(0) +"]";
		mes "好，这是制作“黄金钥匙”需要的第一样东西，对吧？";
		next;
		mes "[铁匠]";
		mes "哈哈哈~我保证，带^0000ff25 个钢铁^000000回来后我会解释。";
		mes "先去收集钢铁吧。";
		rhea_rus_main = 7;
		// changequest 8140,8141;
		close;
	} else if (rhea_rus_main == 7) {
		if (countitem(999) > 24) {// Steel
			mes "[铁匠]";
			mes "哦哦哦，比我预想的快！";
			next;
			mes "[铁匠]";
			mes "好，那就在这里等着。";
			next;
			mes "- 他熔化钢铁 -";
			mes "- 开始把它锻造成 -";
			mes "- 某种东西！！-";
			next;
			mes "[铁匠]";
			mes "哈哈哈~这不是我最好的作品，";
			mes "但也够用了。";
			mes "给你！";
			next;
			mes "["+ strcharinfo(0) +"]";
			mes "啊？！这是？！！";
			next;
			mes "[铁匠]";
			mes "坚固的钢铁靴！";
			next;
			mes "["+ strcharinfo(0) +"]";
			mes "黄金的！！………………………………";
			mes "…………………………嗯，什么？";
			next;
			mes "[铁匠]";
			mes "哈哈哈~我不是告诉过你吗？前方有漫长旅程，这双靴子会帮助你。";
			next;
			mes "[铁匠]";
			mes "当靴子磨损时，你就知道旅程快结束了。";
			next;
			mes "[铁匠]";
			mes "^ff0000收集“黄金钥匙”材料时必须一直穿着这双靴子。^000000";
			next;
			mes "[铁匠]";
			mes "好，我告诉你需要收集哪些材料。只要带给我，随时都能制作钥匙。";
			next;
			mes "[铁匠]";
			mes "制作钥匙需要^0000ff 2 个诅咒红宝石、3 个黄金、1 个红色戒指、2 根露莎卡的头发、10 根黄金线^000000。";
			// changequest 8141,8142;
			next;
		mes "[铁匠]";
			mes "好了，你知道现在该做什么了。我会在这里等着。";
			mes "哈哈哈~";
			mes "别忘了穿上这些！";
			delitem 999,25;// Steel
			rhea_rus_main = 8;
			// changequest 8138,8139;
			if (BaseClass == Job_Merchant || BaseClass == Job_Swordman || BaseClass == Job_Thief || BaseClass == Job_Archer)
				getitem 2429,1;// Iron_Boots01
			else
				getitem 2430,1;// Iron_Boots02
			close;
		}
		mes "[铁匠]";
		mes "你在做什么？首先，你必须给我^0000ff25 个钢铁^000000。";
		next;
		mes "[铁匠]";
		mes "你越快给我材料，就越快能帮助玛丽亚·莫布雷娜。";
		close;
	} else if (rhea_rus_main == 8) {
		if (countitem(724) > 1 && countitem(969) > 2 && countitem(7877) && countitem(7878) > 1 && countitem(7879) > 9) {// Cardinal_Jewel_, Gold, Red_Ring, Lusalka_Hair, Golden_Thread
			if (rhea_rus_ring > 8 && rhea_rus_hair > 8 && rhea_rus_quiz > 29) {
				if (getequipid(EQI_SHOES) != 2429 && getequipid(EQI_SHOES) != 2430) {
					mes "["+ strcharinfo(0) +"]";
					mes "……嗯，我是不是忘了穿什么……？";
					close;
				}
		mes "[铁匠]";
				mes "所以，你把所有材料都收集齐了。我真不敢相信。";
				mes "你一直努力到靴子都磨损了，对吧？";
				next;
				mes "["+ strcharinfo(0) +"]";
				mes "是啊，整天穿钢铁靴走路可不舒服！";
				next;
		mes "[铁匠]";
				mes "哈哈哈~好，干得漂亮。";
				mes "嗯……你寻找材料时，我也在寻找能制作钥匙的制钥师！";
				next;
				mes "["+ strcharinfo(0) +"]";
				mes "我记得你说过你知道怎么制作钥匙？";
				next;
		mes "[铁匠]";
				mes "嗯……我知道材料，也知道谁能制作钥匙。所以我会告诉你去哪里找制钥匙的人。可以吗？";
				next;
				mes "["+ strcharinfo(0) +"]";
				mes "当然！我必须知道这个人的位置。";
				next;
		mes "[铁匠]";
				mes "好，仔细听。制钥匙的人住在森林深处的一间小屋里。";
				next;
		mes "[铁匠]";
				mes "啊，等等。脱下你的铠甲。我需要给你施加保护魔法，明白吗？别误会，这只是简单的保护魔法！";
				nude;
				next;
		mes "[铁匠]";
				mes "巴哈拉姆——等等，那是别的东西……";
				next;
		mes "[铁匠]";
				mes "'^ff0000Spellshield Protection^000000.";
				specialeffect2 EF_ABSORBSPIRITS;
				next;
		mes "[铁匠]";
				mes "这个魔法能保护你免受制钥师可能施加的诅咒。记住魔法的咒语。因为我只是个铁匠，效果不会持续太久。";
				next;
		mes "[铁匠]";
				if (countitem(2429))
					delitem 2429,1;
				else if (countitem(2430))
					delitem 2430,1;
				else {
					mes "森林里很危险。进去后一定要小心！";
					mes "啊，还有你的钢铁靴……？";
					next;
		mes "[铁匠]";
					mes "它们在哪里？";
					close;
				}
				mes "森林里很危险。进去后一定要小心！";
				mes "啊，你应该已经不再需要那双钢铁靴了。祝你好运！";
				rhea_rus_main = 9;
				// changequest 8142,8158;
				close;
			}
		}
		mes "[铁匠]";
		mes "制作钥匙需要^0000ff2颗诅咒红宝石、3块金块、1枚红色戒指、2根露莎卡的头发、10根金线^000000。";
		next;
		switch(select("红色戒指？:露莎卡的头发？:金线？")) {
			case 1:
		mes "[铁匠]";
				mes "红色戒指拥有强大的附魔力量。我以前有一枚，但已经把它作为礼物送给朋友瓦西里了。";
				next;
		mes "[铁匠]";
				mes "我觉得让他还给我不太合适。所以，你得去问问他愿不愿意把它给你。";
				break;
			case 2:
		mes "[铁匠]";
				mes "据说在婚礼前溺水身亡的新娘会变成水之妖精露莎卡。";
				mes "你必须找到露莎卡的头发。";
				next;
		mes "[铁匠]";
				mes "我听说最近有个年轻姑娘失踪了。";
				mes "这实在很不幸，但是……";
				mes "她可能就是露莎卡……";
				next;
		mes "[铁匠]";
				mes "她的母亲正在村里的某处请求大家帮忙寻找失踪的女儿。";
				break;
			case 3:
		mes "[铁匠]";
				mes "金线是用黄金通过特殊的纺车技术制作的。我不清楚具体做法，但我知道谁会做。";
				next;
		mes "[铁匠]";
				mes "去找一个叫马罗兹卡的人。他是唯一知道如何用纺车制作金线的人。";
				next;
		mes "[铁匠]";
				mes "玛丽亚应该知道他在哪里。";
				break;
		}
		next;
		mes "[铁匠]";
		mes "啊，还有……你还留着我做的靴子吧？^ff0000没有它们，你什么钥匙材料都拿不到，我发誓。你必须穿上它们。^000000";
		next;
		mes "[铁匠]";
		mes "好了，你现在知道该怎么做了。我会在这里等你。";
		close;
	} else if (rhea_rus_main == 9) {
		mes "[铁匠]";
		mes "制钥师住在森林深处的一间小屋里。";
		next;
		mes "[铁匠]";
		mes "这个人并非普通人。据说制钥师的话语能够给人施加诅咒。";
		next;
		mes "[铁匠]";
		mes "别忘了那个咒语：^ff0000Spellshield Protection。^000000";
		close;
	} else if (rhea_rus_main > 9 && rhea_rus_main < 52) {
		mes "[铁匠]";
		mes "他就在森林深处的小屋里。金钥匙的制作者就住在那里。";
		next;
		mes "[铁匠]";
		mes "金钥匙能够解救玛丽亚。祝你好运！";
		close;
	} else if (rhea_rus_main > 51) {
		mes "[铁匠]";
		mes "我听说了那个消息。你做得很好。";
		next;
		mes "[铁匠]";
		mes "啊，住在那间小屋附近的人想见你。她似乎有话要告诉你。";
		close;
	}
}

//----------------------------------------------------------------------------
// Vassili Grandpapa (Red Ring)
//----------------------------------------------------------------------------
moscovia,206,81,0	script	Vassili Grandpapa#rus07	4_M_05,{
	if ((MaxWeight-Weight) < 3500) {
		mes "[Vassili Grandpapa]";
		mes "你为什么带着这么多东西？";
		mes "你是在为某件事训练吗？";
		close;
	}
	if (rhea_rus_main < 8) {
		mes "[Vassili Grandpapa]";
		mes "嗯，你是冒险者吗？你觉得这里怎么样？";
		next;
		mes "["+ strcharinfo(0) +"]";
		mes "还不错。";
		mes "这里的天气很好！";
		next;
		mes "[Vassili Grandpapa]";
		mes "虽然现在莫斯科比亚的天气不错，但严酷的冬季可不是个好地方。";

schg_dun01,5,5,1	script	Event controller#sch_gd	81,{
	if (callfunc("F_GM_NPC",1854,0) < 1) {
		mes "密码错误。";
		close;
	} else {
		mes "我能帮你什么？";
		next;
		switch(select("重置。:不用了，谢谢。")) {
		case 1:
			mes "完成。";
			donpcevent "Monster Controler1#sch::OnControler1#sch_gd";
			donpcevent "Monster Controler1#sch::OnControler1#sch_gd";
			disablenpc "Dwarf#sch_gd";
			set $@gdeventv_s1,0;
			set $@gdeventv_s2,0;
			set $@gdevents_s$,"";
			close;
		case 2:
			mes "再见~";
			close;
		}
	}
}

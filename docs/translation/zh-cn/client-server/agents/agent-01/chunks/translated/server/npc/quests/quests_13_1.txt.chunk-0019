			next;
			mes "[Staff Officer Abidal]";
			mes "三国之间为任命指挥官人选存在明显的权力斗争。";
			next;
			mes "[Staff Officer Abidal]";
			mes "最后他们只能选择不属于任何国家、却有才能领导远征的阿吉普指挥官。";
			next;
			mes "[Staff Officer Abidal]";
			mes "我们这些指挥官、伊格里德和我都不习惯领导工作，处理各种事情很困难。*叹气*";
			next;
			mes "[Staff Officer Abidal]";
			mes "远征队成员正在研究灰色幽灵，寻找可能的生物，并研究对大陆发展有益的事物。";
			next;
			mes "[Staff Officer Abidal]";
			mes "四处看看，你会发现许多人需要帮助。享受在异世界的逗留，有问题随时问我。";
			close;
		case 2:
			mes "[Staff Officer Abidal]";
			mes "远征仍处于初期，没有取得重大成果，所以需要你这样的冒险者帮助。";
			next;
			mes "[Staff Officer Abidal]";
			mes "看看营地，你会发现许多帮助我们的机会。我们欢迎每一份帮助。";
			close;
		case 3:
			mes "[Staff Officer Abidal]";
			mes "目前只发现了灰色幽灵的少数真相。";
			next;
			mes "[Staff Officer Abidal]";
			mes "我们知道异世界存在半人族，但光是弄清时空裂缝的本质就忙不过来，更别说深入研究半人族。";
			next;
			mes "[Staff Officer Abidal]";
			mes "遇到那个种族时请小心。谁知道呢？他们可能对其他种族极其敌视。";
			next;
			mes "[Staff Officer Abidal]";
			mes "另外，夜间营地外会出现未知生物，也要小心。";
			close;
		case 4:
			close;
		}
	}
	else if (ep13_1_edq == 1) {
		mes "[Staff Officer Abidal]";
		mes "哦，欢迎回来。抱歉这样麻烦你，我不太方便在那里和你谈。";
		next;
		mes "[Staff Officer Abidal]";
		mes "事实上我想请你帮个忙。以你的成就，你正适合做这件事。";
		next;
		mes "[Staff Officer Abidal]";
		mes "我代表远征队给你一项任务。你愿意接受吗？";
		next;
		switch(select("Yes.:No.")) {
		case 1:
			mes "[Staff Officer Abidal]";

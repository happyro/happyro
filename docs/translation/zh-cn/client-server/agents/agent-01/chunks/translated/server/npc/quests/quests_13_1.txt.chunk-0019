		case 1:
			mes "[Staff Officer Abidal]";
			mes "米德加尔特远征队由三国和佣兵协会的探险家组成，负责探索灰色幽灵。";
			next;
			mes "[Staff Officer Abidal]";
			mes "我身后的希巴·阿吉普是指挥官。他看似不可靠，却拥有丰富的探索知识和经验。";
			next;
			mes "[Staff Officer Abidal]";
			mes "还有许多助手和学者支持远征。";
			next;

lighthalzen,309,263,3	script	Man#ep162_02	1_M_01,{
	if (terra_gloria_main != 5)
	npctalk "嘿，你在看什么？走开！", "", bc_self;
	else {
		setpcblock PCBLOCK_NPC, true;
		unittalk getcharid(3), "" + strcharinfo(0) + " : Bruno?", bc_self;
		sleep2 1000;
	npctalk "你是谁？为什么叫我？", "", bc_self;
		sleep2 1000;
		cloakoffnpcself( "Suspicious mercenary#ep" );
	npctalk "我们有麻烦了。", "Suspicious mercenary#ep", bc_self;
		sleep2 2000;
	npctalk "……心脏……心之猎人！心之猎人为什么会在这里？！", "", bc_self;
		sleep2 2000;
		npctalk ".....", "Suspicious mercenary#ep", bc_self;
		sleep2 2000;
	npctalk "该死！他骗了我！嘿，你救救我！你想要多少钱我都给你。", "", bc_self;
		sleep2 2000;
		npctalk "......", "Suspicious mercenary#ep", bc_self;
		sleep2 2000;
	npctalk "现在，去死吧。", "Suspicious mercenary#ep", bc_self;
		sleep2 500;
		cloakoffnpcself( "Skia#ep162_04" );
		cloakoffnpcself( "Crux#ep162_02" );
		specialeffect EF_NPC_STOP, AREA, "Suspicious mercenary#ep";
		specialeffect EF_HIT3, AREA, "Suspicious mercenary#ep";
		sleep2 300;
	npctalk "不……真遗憾……", "Suspicious mercenary#ep", bc_self;

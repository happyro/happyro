lighthalzen,177,294,5	duplicate(dummy_cloaked_npc)	Man#ep162_01	1_M_01
lighthalzen,179,293,1	duplicate(dummy_cloaked_npc)	Scientist#ep162_01	4_LGTSCIENCE

lighthalzen,186,293,0	script	#ep162_evt01	HIDDEN_WARP_NPC,2,2,{
	end;
OnTouch:
	if (terra_gloria_main == 4) {
		setpcblock PCBLOCK_NPC, true;
		unittalk getcharid(3), "" + strcharinfo(0) + " : .....! Those people?!", bc_self;
		sleep2 1000;
		cloakoffnpcself( "Man#ep162_01" );
		cloakoffnpcself( "Scientist#ep162_01" );
		npctalk "我们不是已经办完事了吗？", "Scientist#ep162_01", bc_self;
		sleep2 3000;
		npctalk "你为什么大老远来这里叫我？", "Scientist#ep162_01", bc_self;
		sleep2 3000;
		npctalk "……我只是为了钱，但遇到了意外情况。", "Man#ep162_01", bc_self;
		sleep2 3000;
		npctalk "我现在很为难。你不想让我被抓，对吧？", "Man#ep162_01", bc_self;
		sleep2 3000;
		npctalk "……我可以再给你钱，只要钱是你想要的。", "Scientist#ep162_01", bc_self;
		sleep2 3000;
		npctalk "就这样。从今以后，我不能再住在施瓦尔兹瓦尔德或卢恩·米德加兹了。", "Man#ep162_01", bc_self;
		sleep2 3000;
		npctalk "……所以我还需要拿些钱。谢谢你的理解。", "Man#ep162_01", bc_self;
		sleep2 3000;
		npctalk "这里眼线太多了，在南边贫民窟等着。我很快会派人过去。", "Scientist#ep162_01", bc_self;
		sleep2 3000;
		npctalk "你必须亲自来。", "Man#ep162_01", bc_self;
		sleep2 3000;
		npctalk "我明白了。现在走，别让其他人看见你。", "Scientist#ep162_01", bc_self;
		sleep2 3000;
		npctalk "我会等。", "Man#ep162_01", bc_self;
		sleep2 1000;
		cloakonnpcself( "Man#ep162_01" );
		sleep2 1000;
		npctalk "喂，把他赶走。", "Scientist#ep162_01", bc_self;
		sleep2 2000;
		npctalk "是。", "Man#ep162_01", bc_self;
		sleep2 1000;
		unittalk getcharid(3), "" + strcharinfo(0) + " : (Who was that person? I only heard a voice.)", bc_self;
		sleep2 2000;
		npctalk "……他本该守规矩。太多和太少一样糟糕。", "Scientist#ep162_01", bc_self;
		erasequest 7732;// Searching the suspect
		setquest 7733;// Pursuit!
		terra_gloria_main = 5;
		sleep2 3000;
		setpcblock PCBLOCK_NPC, false;
		cloakonnpcself( "Scientist#ep162_01" );
		unittalk getcharid(3), "" + strcharinfo(0) + " : I must tell Skia about this and head to the slum right away!", bc_self;
		end;
	}
}


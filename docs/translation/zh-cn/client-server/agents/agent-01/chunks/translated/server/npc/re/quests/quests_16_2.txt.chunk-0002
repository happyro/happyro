		mes "[Skia]";
		mes "我偶尔会感到心脏附近刺痛，心跳也比平时快。有时明明没有发烧，却会觉得身体发热。";
		next;
		cutin "ep16_skia_nerius03.bmp",0;
		mes "[Skia]";
		mes "这是因为宴会太多，训练不足吗？我的健康可能出了问题。";
		next;
		select( "一直都有这种感觉吗？", "什么时候最严重？" );
		cutin "ep16_skia_nerius01.bmp",0;
		mes "[Skia]";
		mes "不是一直……";
		mes "最近……哦！是在艾因布洛克旅馆等那位冒险者的时候……";
		next;
		mes "[Skia]";
		mes "当我问他能不能使用移动卷轴时……";
		next;
		mes "[Skia]";
		mes "当他让我在这个房间里等一会儿时……";
		next;
		select("谁让你等的？");
		cutin "ep16_skia_nerius04.bmp",0;
		mes "[Skia]";
		mes "是尼希尔。他说处理完所有事情后就会来。";
		mes "...";
		mes "啊！我的心脏又跳得好快！";
		mes "我到底怎么了……";
		next;
		if (select( "……心脏病。", "也许是爱情？" ) == 1) {
			mes "[Spica]";
			mes "……什么？心脏病？";
		}
		else {
			mes "[Spica]";
			mes "……爱情？？";
		}
		cutin "ep16_spica_nerius01.bmp",1;
		next;
		cloakoffnpcself( "Spica Nerius#ep162_01" );
		npctalk "你能慢慢告诉我吗？", "Spica Nerius#ep162_01", bc_self;
		mes "斯基亚向斯皮卡讲述了自己的症状。";
		next;
		cutin "ep16_spica_nerius03.bmp",1;
		mes "[Spica]";
		mes "天啊！斯基亚！";
		mes "你喜欢尼希尔王子的什么？";
		mes "是他英俊的脸吗？";
		next;
		cutin "ep16_skia_nerius01.bmp",0;
		mes "[Skia]";
		mes "哦，什么？";
		mes "你为什么一直提到尼希尔？";
		mes "那位英雄也问过我同样的问题……";
		next;
		cutin "ep16_spica_nerius06.bmp",1;
		mes "[Spica]";
		mes "好了，姐姐。";
		mes "你刚才提到的，全都是和尼希尔王子在一起的时刻。";
		mes "................";
		next;
		cutin "ep16_spica_nerius05.bmp",1;
		mes "[Spica]";
		mes "果然不出我所料……";
		mes "我们以后再谈这件事。";
		mes "哦……要是母亲知道了，你可就麻烦了。";
		next;
		cutin "",255;
		mes "[Bel]";
		mes "格兰兹王子到了。";
		next;
		cloakoffnpcself( "Kronecker G. Heine#ep162" );
		mes "[Kronecker]";
		mes "嗯，尼里乌斯家的尊贵女儿们也在这里。";
		mes "首先，" + strcharinfo(0) + "，我是来向你表达谢意的。";
		cutin "ep16_kronecker_granz_heine.bmp",2;
		next;
		mes "[Kronecker]";
		mes "多亏你的支持，我们保住了王室传统，也避开了恶意之人的卑鄙手段。";
		next;
		mes "[Kronecker]";
		mes "尼希尔在过程中确实有些越界，但我们已经洗刷了家族的耻辱。";
		next;
		cutin "ep16_spica_nerius01.bmp",1;
		mes "[Spica]";
		mes "王子，我们不是已经在会议上结束讨论了吗？";
		mes "多亏王子，你在与施瓦茨瓦尔德政府的贸易中获得了优势。";
		next;
		cutin "ep16_kronecker_granz_heine.bmp",2;
		mes "[Kronecker]";
		mes "……没错。";
		mes "虽然弗里茨和我也参与其中，但尼希尔在内政方面做得相当不错。";
		next;
		cutin "ep16_spica_nerius01.bmp",1;
		mes "[Spica]";
		mes "王子。你还是不愿接受他，对吗？";
		next;
		cutin "ep16_kronecker_granz_heine.bmp",2;
		mes "[Kronecker]";
		mes "不是那样。";
		mes "我也在这次事件中学到了很多。";
		mes "这是意料之外的结果。";
		next;
		mes "[Kronecker]";
		mes "仔细想想，我没有给尼希尔任何机会。他可能因此很难过。";
		mes "……总之……他一定很难过。";
		next;
		mes "[Kronecker]";
		mes "多亏这次事件，海涅家族学到了很多。";
		mes "我们现在只希望住院的彼得能够醒来。";
		next;
		mes "[Kronecker]";
		mes "嗯，先不谈私事了。";
		mes "我让" + strcharinfo(0) + "过来是为了补偿你，";
		next;
		mes "[Kronecker]";
		mes "考虑到你为我们所做的一切，这份奖励可能微薄了些。";
		mes "……但请收下。";
		next;
		mes "[Kronecker]";
		mes "你可以继续以客人的身份享受此前的一切，我们已经同意了。";
		mes "因为你一直对我们抱有真诚的信任。";
		getitem 6919,10;	// TokenOfHonor
		getexp 500000,500000;
		completequest 7741;// Let's return
		terra_gloria_main = 24;
		next;
		mes "[Kronecker]";
		mes "那么就让你们年轻人继续聊天吧。";
		mes "回头见。";
		next;
		cutin "ep16_spica_nerius01.bmp",1;
		mes "[Spica]";
		mes "回头见。我会联系你的。";
		npctalk "我会等着你。", "Kronecker G. Heine#ep162", bc_self;
		next;
		cloakonnpcself( "Kronecker G. Heine#ep162" );
		mes "[Spica]";
		mes "Skia?";
		mes "不如和我安静地聊一会儿？";
		mes "看来大多数事情都安排好了。现在我要带着可怜的妹妹离开了。";
		next;
		cutin "ep16_skia_nerius03.bmp",0;
		mes "[Skia]";
		mes "啊……英雄。";
		mes "下次请再来尼里乌斯家族做客！";
		next;
		cutin "ep16_spica_nerius01.bmp",1;
		mes "[Spica]";
		mes "顺便说一句，我收到了^4d4dff菲洛庞特斯^000000的信。";
		mes "他让你去^4d4dff维尔纳实验室入口^000000找他。别忘了去拜访。";
		next;
		mes "[Spica]";
		mes "我不知道他为什么让我当联络人。真是个勇敢的年轻人。";
		mes "之后再见。";
		close2;
		setpcblock PCBLOCK_NPC, true;
		cutin "",255;
		npctalk "现在，把关于奈利乌斯的一切告诉我！", "Spica Nerius#ep162_01", bc_self;
		sleep2 2000;
		npctalk "你为什么一直谈论奈利乌斯……", "Skia Nerius#ep162_01", bc_self;
		sleep2 2000;
		npctalk "看啊！你的脸又红了！这到底……", "Spica Nerius#ep162_01", bc_self;
		sleep2 2000;
		unittalk getcharid(3), "" + strcharinfo(0) + " : ....", bc_self;
		sleep2 2000;
		setpcblock PCBLOCK_NPC, false;
		cloakonnpcself( "Skia Nerius#ep162_01" );
		cloakonnpcself( "Spica Nerius#ep162_01" );
		end;
	}
	end;

OnInit:
	cloakonnpc "Nihil M. Heine#ep162_01";
	cloakonnpc "Spica Nerius#ep162_01";
	cloakonnpc "Skia Nerius#ep162_01";
	end;
}


// Lighthalzen airport
lhz_airport,187,40,6	duplicate(dummy_cloaked_npc)	Skia#ep162_03	4_EP16_SKIA

lhz_airport,189,39,3	script	Crux#ep162_01	4_EP16_CRUX,{
	if (terra_gloria_main < 3) {
		cutin "ep16_crux_findel03.bmp",1;
		mes "[Crux]";
		mes "哦，你好。";
		mes "很高兴在这里见到你。";
		mes "我？我只是在执行夫人交给我的任务。";
		sleep2 300;
		cutin "ep16_crux_findel02.bmp",1;
		close2;
		cutin "",255;
		npctalk "我得赶快完成，然后回去……", "", bc_self;
		end;
	}
	if (terra_gloria_main == 3) {
		cutin "ep16_crux_findel01.bmp",2;
		mes "[Crux]";
		mes "啊，你到了？";
		mes "你一个人来的吗？";
		mes "我听说斯基亚也会来……";
		next;
		cloakoffnpcself( "Skia#ep162_03" );
		npctalk "我在这里！", "Skia#ep162_03", bc_self;
		mes "[Crux]";
		mes "哦！你到了。";
		mes "海涅家的王子命令我来，所以我到了利塔尔泽。你觉得那个人会出现吗？";
		cutin "ep16_crux_findel03.bmp",2;
		next;
		cutin "ep16_skia_nerius01.bmp",0;
		mes "[Skia]";
		mes "我想会的。";
		mes "那个曾经当过侍从的人……你不是在报告里写过，他正试图联系某人吗？";
		next;
		mes "[Crux]";
		mes "是的。";
		mes "我以为他在寻找侍从背后的人。";
		mes "他还要求更多报酬。";
		cutin "ep16_crux_findel01.bmp",2;
		next;
		cutin "ep16_skia_nerius01.bmp",0;
		mes "[Skia]";
		mes "根据尼希尔的说法，侍从背后的人很可能在利塔尔泽。";
		mes "可能在这里，也可能在艾因布洛克。但尼希尔说，那些人应该会讨厌烟雾弥漫的城市。";
		next;
		mes "[Crux]";
		mes "嗯，真的吗？";
		mes "那么他背后的人可能身居高位或拥有权力，也可能很富有。";
		cutin "ep16_crux_findel01.bmp",2;
		next;
		cutin "ep16_skia_nerius01.bmp",0;
		mes "[Skia]";
		mes "嗯。总之，我们要做的就是在利塔尔泽找到那个人。";
		mes "那我们知道他的相貌和穿着吗？";
		next;
		mes "[Crux]";
		mes "一个外表整洁、浅棕色头发垂至肩膀的男人。";
		mes "他的名字叫布鲁诺……这是个很普通的名字，可能是假名。";
		cutin "ep16_crux_findel01.bmp",2;
		next;
		mes "[Crux]";
		mes "我会调查利塔尔泽南部，这位女士会调查百货商店和旅馆附近。";
		mes "冒险者，请搜索^4d4dff北部和东北部地区^000000。";
		next;
		mes "[Crux]";
		mes "一旦发现什么，^4d4dff请在中央百货商店前集合，我们互相交换情报^000000。";
		mes "现在赶快行动吧。";
		next;
		cutin "ep16_skia_nerius01.bmp",0;
		mes "[Skia]";
		mes "哦，对了。";
		mes "克鲁克斯……你真是个好演员。";
		mes "回头见。";
		mes "你也是，英雄！";
		erasequest 7731;// Secret Action
		setquest 7732;// Searching the suspect
		terra_gloria_main = 4;
		close2;
		cloakonnpcself( "Skia#ep162_03" );
		cutin "",255;
		end;
	}
	if (terra_gloria_main == 4) {
		mes "[Crux]";
		mes "我会调查包括机场在内的利塔尔泽南部。";
		mes "冒险者，请负责北部和东北部地区。";
		cutin "ep16_crux_findel01.bmp",1;
		next;
		mes "[Crux]";
		mes "一旦发现什么，^4d4dff请在中央百货商店前集合，我们互相交换情报^000000。";
		close3;
	}
	if (terra_gloria_main == 5) {
		mes "[Crux]";
		mes "真的吗？他去了贫民窟？";
		mes "这下麻烦了。";
		mes "无论如何，我会和这位女士跟上你。";
		mes "冒险者，请先去那里。";
		cutin "ep16_crux_findel03.bmp",1;
		close3;
	}
	if (terra_gloria_main == 6) {
		cutin "ep16_crux_findel01.bmp",1;
		mes "[Crux]";
		mes "你是说……布鲁诺？";
		mes "乘坐飞艇会很困难，所以我们分头行动。";
		next;
		mes "[Crux]";
		mes "不用担心我，我们会在宫殿再见。";
		mes "请代我向斯皮卡女士问好。";
		close3;
	}
	if (terra_gloria_main == 7) {
		cutin "ep16_crux_findel03.bmp",1;
		mes "[Crux]";
		mes "你不是要去朱诺吗？";
		close3;
	}
	if (terra_gloria_main == 8) {
		cutin "ep16_crux_findel01.bmp",1;
		mes "[Crux]";
		mes "我在利塔尔泽旅馆有约。";
		mes "走吧。";
		close3;
	}
	cutin "ep16_crux_findel01.bmp",1;
	mes "[Crux]";
		mes "我不想这样把你留在这里太久……";
		mes "……但我别无选择。";
	next;
	cutin "ep16_crux_findel02.bmp",1;
	mes "[Crux]";
		mes "这就是你想要的。";
	close3;

OnInit:
	questinfo( QTYPE_QUEST, QMARK_NONE, "isbegin_quest(7731) == 1" );
	end;
}

// Lighthalzen
lighthalzen,202,167,5	script	Skia#ep162_n	4_EP16_SKIA,{
	if (terra_gloria_main < 4) {
		npctalk "嗯~他到底在哪里……", "", bc_self;
		end;
	}
	if (terra_gloria_main == 4) {
		cutin "ep16_skia_nerius01.bmp",0;
		mes "[Skia]";
		mes "到目前为止，我还没有看到可疑的人！";
		mes "但我很快就会找到他。";
		mes "不知道为什么，但我对此深信不疑。";
		mes "他一定就在这里！";
		close3;
	}
	if (terra_gloria_main == 5) {
		cutin "ep16_skia_nerius01.bmp",0;
		mes "他一定去了贫民窟！";
		mes "我们必须想办法到那里。";
		next;
		mes "[Skia]";
		mes "我会告诉克鲁克斯。请你先追那个家伙。";
		close3;
	}
	if (terra_gloria_main == 6) {
		cutin "ep16_skia_nerius01.bmp",0;
		mes "[Skia]";
		mes "我们现在回宫殿吧。";
		mes "克鲁克斯抓住了那个叫布鲁诺的家伙。";
		close3;
	}
	cutin "ep16_skia_nerius01.bmp",0;
	mes "[Skia]";
		mes "我一直想以游客身份参观这里，从没想过会以这种方式来到这里。";
		mes "真是座奇妙的城市。";
	close3;
}


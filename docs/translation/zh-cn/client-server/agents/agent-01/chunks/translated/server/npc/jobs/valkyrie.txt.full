		valkyrie,48,86,4	script	Valkyrie#	811,{
		if (ADVJOB != 0 || Upper == 1) {
		mes "[女武神]";
		mes "欢迎";
		mes "来到英灵殿，";
		mes "荣誉之厅。";
		next;
		mes "[女武神]";
		mes "请让自己";
		mes "舒适地";
			mes "待在这里。";
			mes "向勇士致敬！";
			close;
			}
			else if (BaseLevel > 98 && JobLevel > 49 && Class >= Job_Knight && Class <= Job_Crusader2) {
			mes "[女武神]";
			mes "欢迎";
			mes "来到英灵殿，";
			mes "荣誉之厅。";
			next;
			mes "[女武神]";
			mes "现在你将结束";
			mes "当前生命，";
			mes "开始全新生命。";
			mes "向勇士致敬！";
			next;
			if (Weight > 0 || Zeny > 0 || checkcart() != 0 || checkfalcon() != 0 || checkriding() != 0) {
		mes "[女武神]";
		mes "开始前你必须做几件事。你必须";
			mes "先清空身心。你必须";
			mes "清空身心。";
			mes "放下";
			mes "所有私欲，荣耀便会到来……";
			next;
			mes "[女武神]";
			mes "你无法将任何东西带入来世。物品、Zeny、宠物和手推车都必须留下。";
			next;
			mes "[女武神]";
			mes "准备好后";
				mes "请回来找我，";
				mes "勇敢的冒险者。";
				close2;
				warp "yuno_in02",93,205;
				end;
				}
				else {
				mes "[女武神]";
				mes "我看出你已经";
			mes "摆脱了";
			mes "世俗牵挂，";
			mes ""+ strcharinfo(0) +".";
			next;
			mes "[女武神]";
			mes "这是值得赞赏的态度。为了人类放下所有个人欲望。";
			next;
			if (SkillPoint) {
			mes "[女武神]";
			mes "嗯……我感觉你还有";
			mes "未了的牵挂或";
			mes "未完成的事情。";
			mes "处理好当前生命中的事务，";
			mes "为今生画上句号。";
			close2;
			warp "yuno_in02",93,205;
			end;
			}
			mes "[女武神]";
			mes "现在，让我移除你所有";
			mes "当前记忆……";
			mes "但你仍能记住";
			mes "今生最荣耀的";
			mes "时刻。";
			next;
			mes "[女武神]";
			mes "第一，";
			mes "我会请";
			mes "乌尔德女神移除";
			mes "你当前所有";
			mes "记忆。";
			next;
			mes "[女武神]";
			mes "第二，";
			mes "我会请";
			mes "维尔丹蒂女神保存";
			mes "并记录今生最荣耀的时刻。";
			next;
			mes "[女武神]";
			mes "第三，";
			mes "我会请";
			mes "斯库尔德女神";
			mes "引导你走向";
			mes "来世。";
			next;
			mes "[女武神]";
			mes "一……";
			callfunc "F_ClearJobVar";
			next;
			mes "[女武神]";
			mes "一……";
			mes "二……";
			next;
			mes "[Valkyrie]";
			mes "一……";
			mes "二……";
			mes "三。";
			set ADVJOB, Class+Job_Novice_High; //memo the target 3rd Job ID
			if(ADVJOB == Job_Lord_Knight2) set ADVJOB,Job_Lord_Knight;
			if(ADVJOB == Job_Paladin2) set ADVJOB,Job_Paladin;
			jobchange Job_Novice_High;
			resetlvl(1);
			set MISC_QUEST,MISC_QUEST & ~1024;//<-reset Skill Reset Event
			skill "NV_FIRSTAID",1,SKILL_PERM;
			skill "NV_TRICKDEAD",1,SKILL_PERM;
			completequest 1000;
			next;
			mes "[Valkyrie]";
				mes "恭喜。";
				mes "你现在重生";
				mes "为全新生命。";
			mes "请收下这些小礼物";
			mes "为新的冒险做准备。";
				getitem 1202,1; //Knife_
			getitem 2302,1; //Cotton_Shirt_
			next;
				mes "[Valkyrie]";
			mes "愿乌尔德女神赐予你的解放成为祝福。愿维尔丹蒂记录的记忆永远荣耀你。";
			next;
				mes "[Valkyrie]";
			mes "我祈祷斯库尔德女神引导的新生命比上一世更加荣耀。";
			close2;
			switch (ADVJOB) {
				case 4008:
			case 4015:
			if (checkre(0)) warp "izlude",129,97;
				else warp "izlude",94,103;
			break;
				case 4009:
			case 4016:
			warp "prontera",273,354; break;
		case 4010:
	case 4017:
	warp "geffen",120,60; break;
		case 4011:
		case 4019:
		warp "alberta",116,57; break;
		case 4012:
		case 4020:
		case 4021:
		warp "payon",69,100; break;
		case 4013:
		case 4018:
		warp "morocc",154,50; break;
	default:
warp "yuno_in02",93,205; break;
}
end;
	}
		}
			else {
			mes "[Valkyrie]";
			mes "欢迎";
			mes "来到英灵殿，";
			mes "荣誉之厅。";
			next;
			mes "[Valkyrie]";
			mes "遗憾的是，你尚未获邀来到这里。请立即离开。向勇士致敬！";
			close2;
			warp "yuno_in02",93,205;
			end;
			}
			}
			
			yuno_in02,88,164,5	script	Metheus Sylphe#Library	742,{
			if (BaseLevel > 98 && JobLevel > 49 && Class >= Job_Knight && Class <= Job_Crusader2) {
			if (valkyrie_Q == 0) {
				mes "[Metheus Sylphe]";
					mes "欢迎来到斯维切尔比尔魔法学院图书馆。";
					mes "我想你是来这里阅读《尤弥尔之书》。";
					next;
					mes "[Metheus Sylphe]";
					mes "遗憾的是，原书已随时间损坏。目前只允许公众阅读副本。";
					next;
				mes "[Metheus Sylphe]";
				mes "此外，为了保存原版《尤弥尔之书》，我们接受希望阅读副本者的捐赠。";
				next;
				mes "[Metheus Sylphe]";
			mes "建议的";
			mes "捐赠金额为";
			mes "1,285,000 zeny.";
			next;
			if (select("捐赠。:取消。") == 1) {
		if (Zeny >= 1285000) {
		set Zeny, Zeny-1285000;
		set valkyrie_Q,1;
		mes "[Metheus Sylphe]";
	mes "谢谢，你的捐赠将用于公益。现在可以进去阅读这本书了。";
	close;
	}
	mes "[Metheus Sylphe]";
	mes "遗憾的是你现在没有足够的 Zeny。请确认资金后再回来。";
close;
}
mes "[Metheus Sylphe]";
	mes "慢慢来，享受旅途。";
		close;
		}
		mes "[Metheus Sylphe]";
		mes "再次感谢你的慷慨捐赠。请随意阅读《尤弥尔之书》的副本。";
		close;
		}
		mes "[Metheus Sylphe]";
			mes "欢迎来到斯维切尔比尔魔法学院图书馆。";
			mes "这里有无数书籍，请慢慢浏览。";
			close;
		}
		
		yuno_in02,93,207,1	script	Book of Ymir	111,{
		if (ADVJOB != 0 || Upper == 1) {
		mes "[The Book of Ymir]";
		mes "……荣誉之厅的入口向已经迈入下一世的人开放，帮助英雄决定目标，并能带他们前往世界各处。";
	next;
	mes "[The Book of Ymir]";
		mes "荣誉之厅为英雄准备了一切。据说现实中无法实现的愿望，都能在荣誉之厅实现。";
			next;
			if (select("停止阅读。:继续阅读。") == 1) {
			mes "[The Book of Ymir]";
			mes ".....";
			close;
			}
			mes "[The Book of Ymir]";
			mes "有条被遗忘的道路通往最接近天堂的荣誉之厅。普通人永远无法发现这里……";
			close2;
			warp "valkyrie",48,8;
			end;
			}
			else if (BaseLevel > 98 && JobLevel > 49 && Class >= Job_Knight && Class <= Job_Crusader2) {
			if (valkyrie_Q != 0) {
			mes "[The Book of Ymir]";
			mes "……因此，古代英雄总是痛苦，";
			mes "因为他们知道自己终究是凡人，";
			mes "终将离开这个世界……";
			next;
			mes "[The Book of Ymir]";
			mes "没有任何文件、歌曲或民间传说";
			mes "记载死后的生活。不过我最近发现了一卷关于女武神的古老卷轴……";
			next;
			mes "[The Book of Ymir]";
			mes "女武神……";
			mes "传说中的守护天使。";
			mes "诸神黄昏的天使。";
			next;
			mes "[The Book of Ymir]";
			mes "拥有强大力量和勇气的冒险者";
			mes "将由女武神带到英灵殿，也就是荣誉之厅。";
			mes "在那里，他们将获得新生。";
			next;
			mes "[The Book of Ymir]";
			mes "重生后，他们会作为更伟大的英雄再次生活，";
			mes "照亮世界。疲惫的身体将充满能量……";
			next;
			mes "[The Book of Ymir]";
			mes "他们的灵魂将借助尤弥尔之心获得能力。然而，尤弥尔之心在卢恩-米德加尔特战争后彻底毁灭，散落世界各地。";
			next;
			mes "[The Book of Ymir]";
			mes "经过很长时间，我找到了一小部分";
			mes "尤弥尔之心碎片。但仅凭科学测试";
			mes "无法确认女武神和英灵殿的故事是否真实。";
			next;
			mes "[The Book of Ymir]";
			mes "因此我留下这份记录，希望未来有人";
			mes "能确认女武神和英灵殿确实存在……";
				next;
			set valkyrie_Q,2;
			if(checkquest(1000) == -1) {
			setquest 1000;
			}
			mes "[The Book of Ymir]";
			mes "让英雄获得新生，";
		mes "保护世界免受危险。然后……";
		close;
		}
		mes "[The Book of Ymir]";
	mes "...";
	close;
	}
	mes "[The Book of Ymir]";
mes "...";
close;
}
	
		yuno_in05,49,43,1	script	Heart of Ymir	111,{
	if (BaseLevel > 98 && JobLevel > 49 && Class >= Job_Knight && Class <= Job_Crusader2) {
	if (valkyrie_Q == 2) warp "valkyrie",48,8;
}
end;
}
	
		valkyrie,44,33,5	script	Teleporter	124,{
		if (Upper != 1) {
			set .@karma_d,rand(1,10);
			if (.@karma_d > 4) {
			mes "[Teleporter]";
			mes "恭喜。";
		mes "向战士致敬！";
		close;
		}
		mes "[Teleporter]";
		mes "请不要触摸";
		mes "任何展品。";
		mes "..........";
	close;
	}
		else {
		mes "[Teleporter]";
		mes "尊贵的客人，";
		mes "你想去哪里？";
		next;
		switch(select("普隆德拉:梦罗克:斐扬:吉芬:艾尔贝塔:伊兹鲁德:艾尔迪巴兰:科莫多:朱诺")) {
		case 1: callsub S_Warpchar,"prontera",116,72;
		case 2: callsub S_Warpchar,"morocc",156,46;
		case 3: callsub S_Warpchar,"payon",69,100;
		case 4: callsub S_Warpchar,"geffen",120,39;
		case 5: callsub S_Warpchar,"alberta",117,56;
			case 6:
			if (checkre(0)) callsub S_Warpchar,"izlude",129,97;
		else callsub S_Warpchar,"izlude",94,103;
		case 7: callsub S_Warpchar,"aldebaran",91,105;
		case 8: callsub S_Warpchar,"comodo",209,143;
		case 9: callsub S_Warpchar,"yuno",328,101;
	}
}
	S_WarpChar:
	mes "[Teleporter]";
	mes "旅途愉快。";
	close2;
	savepoint getarg(0),getarg(1),getarg(2),1,1;
	warp getarg(0),getarg(1),getarg(2);
end;
}


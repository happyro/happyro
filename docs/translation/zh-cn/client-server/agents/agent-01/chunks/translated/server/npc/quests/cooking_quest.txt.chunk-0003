		mes "还要照顾牛阳。";
		mes "那么，保重～";
		next;
		cutin "nyuang_3",2;
		emotion ET_SMILE, getnpcid(0, "Child with Cat#cook");
		mes "[带猫的孩子]";
		mes "喵哈哈哈～";
		mes "喵哈哈哈～";
		mes "(喵，喵～)";
		next;
		cutin "job_black_hucke02",255;
		emotion ET_DELIGHT, getnpcid(0, "Wickebine#cook");
		donpcevent "Wickebine#cook::OnDisable";
		next;
		emotion ET_THINK;
		emotion ET_THINK, getnpcid(0, "Child with Cat#cook");
		mes "[查尔斯·奥尔良]";
		mes "......";
		next;
		cutin "orleans_6",0;
		mes "[查尔斯·奥尔良]";
		mes "啊……";
		mes "那才是真正的";
		mes "女士……威克宾夫人……";
		goto L_End;
	}
	else if (cooking_q == 10) {
		cutin "orleans_5",0;
		mes "[查尔斯·奥尔良]";
		mes "这件事一直让我困扰，";
		mes "殿下已经";
		mes "失踪很久了。";
		mes "为什么";
		mes "没人知道他在哪里？";
		next;
		cutin "orleans_4",0;
		cutin "orleans_3",0;
		mes "[查尔斯·奥尔良]";
		mes "睿智仁慈的";
		mes "特里斯坦三世国王绝不会";
		mes "抛弃他的臣民。";
		mes "我真心希望他没有遭遇";
		mes "什么严重的事……";
		next;
		cutin "orleans_6",0;
		mes "[查尔斯·奥尔良]";
		mes "难道我们敬爱的国王";
		mes "会有敌人吗？";
		mes "他为";
		mes "卢恩·米德加尔特王国";
		mes "以及全世界做的";
		mes "只有好事！";
		next;
		mes "[查尔斯·奥尔良]";
		mes "我无法想象像他这样伟大的人";
		mes "会陷入什么麻烦。";
		mes "每当有人说他藏在";
		mes "施瓦茨瓦尔德共和国时，";
		mes "我就忍不住发笑";
		mes "……";
		next;
		emotion ET_GO;
		mes "[查尔斯·奥尔良]";
		mes "赞美";
		mes "卢恩·米德加尔特王国的荣耀！";
		mes "特里斯坦三世国王万岁！";
		goto L_End;
	}
	else if (cooking_q == 11) {
		cutin "orleans_5",0;
		emotion ET_THINK;
		mes "[查尔斯·奥尔良]";
		mes "哦，我非常需要";
		mes "休息一下。除非你";
		mes "有极其重要的事要问，";
		mes "否则请让我";
		mes "休息一会儿～";
		next;
		switch(select("我想学习更多食谱。:你为谁做饭？:抱歉打扰你了……")) {
		case 1:
			cutin "orleans_7",0;
			mes "[查尔斯·奥尔良]";
			mes "你想学习更多";
			mes "食谱吗？我想你应该";
			mes "再借一本";
			mes "食谱吧。在那之前，";
			mes "请先归还你正在学习的食谱，";
			mes "好吗？";
			next;
			mes "[查尔斯·奥尔良]";
			mes "现在输入 1 至 5 的等级，";
			mes "选择想借的食谱。";
			mes "这里还有";
			mes "更高级的书，";
			mes "但我不外借。";
			mes "输入 0 取消。";
			next;
			input .@new_book;
			if (.@new_book < 0 || .@new_book > 5) {
				cutin "orleans_5",0;
				mes "[查尔斯·奥尔良]";
				mes "嗯……";
				mes "我让你输入";
				mes "等级";
				mes "1 到 5 级。";
				mes "这些是";
				mes "我会借给学生的唯一食谱。";
				goto L_End;
			}
			else if (.@new_book == 0) {
				cutin "orleans_5",0;
				mes "[查尔斯·奥尔良]";
				mes "你改变主意了吗？";
				mes "我建议你先学习";
				mes "手头已有的食谱，";
				mes "再尝试";
				mes "新东西。";
				goto L_End;
			}
			mes "[查尔斯·奥尔良]";
			mes "所以你想借";
			mes "等级 " + .@new_book + " 食谱，对吧？";
			mes "请告诉我";
			mes "要归还给我的食谱";
			mes "等级，好吗？";
			next;
			input .@old_book;
			if (.@old_book < 0 || .@old_book > 5) {
				mes "[查尔斯·奥尔良]";
				mes "一定是哪里";
				mes "弄错了——我只借出";
				mes "等级 1 到 5 的食谱。嗯，等你记起";
				mes "来";
				mes "你有哪本食谱后，";
				mes "再来问我，好吗？";
				goto L_End;
			}
			else if (.@old_book == 0) {
				cutin "orleans_5",0;
				mes "[查尔斯·奥尔良]";
				mes "你改变主意了吗？";
				mes "我建议你先学习";
				mes "手头已有的食谱，";
				mes "再尝试";
				mes "新东西。";
				goto L_End;
			}
			else if (.@old_book == .@new_book) {
				cutin "orleans_4",0;
				mes "[查尔斯·奥尔良]";
				mes "等等，等等……";
				mes "为什么要借";
				mes "你已经拥有的";
				mes "那本食谱？";
				mes "我猜你是";
				mes "弄错了吧？";
				goto L_End;
			}
			else {
				if (countitem(7471+.@old_book) < 1) {
					mes "[查尔斯·奥尔良]";
					mes "等等，等等……";
					mes "你说要归还的那本书";
					mes "怎么不在你手上？";
					mes "先把它找回来，";
					mes "然后";
					mes "我才能再借一本食谱给你。";
					goto L_End;
				}
				cutin "orleans_2",0;
				mes "[查尔斯·奥尔良]";
				switch(.@old_book) {
				case 1:
					mes "啊，你已经完成";
					mes "等级 1 食谱了。";
					mes "很好，这意味着你已准备好";
					mes "现在";
					mes "从基础中的基础毕业。接下来，";
					mes "食谱会更难……";
					break;
				case 2:
					mes "那么，你觉得";
					mes "等级 2 食谱怎么样？";
					mes "家常菜也许很简单，";
					mes "但它";
					mes "但厨师绝不能";
					mes "忽视它。";
					break;
				case 3:
					mes "啊，已经完成等级 3";
					mes "食谱了吗？里面的食谱";
					mes "很适合烹饪浪漫晚餐。";
					mes "总有一天会派上用场，";
					mes "你知道我的意思。";
					break;
				case 4:
					mes "你完成了等级 4 食谱。";
					mes "这可不简单！你得";
					mes "使用";
					mes "使用非常奇特的材料";
					mes "才能做出美味料理！";
					break;
				case 5:
					mes "你完成等级 5 食谱了？干得好。";
					mes "大多数初学者";
					mes "甚至";
					mes "都走不到这一步。我想";
					mes "你会想复习一些";
					mes "更简单的食谱吧～";
					break;
				}
				next;
			}
			cutin "orleans_1",0;
			mes "[查尔斯·奥尔良]";
			mes "现在，在借给你我心爱的";
			mes "食谱之前，有个小小的";
			mes "借阅";
			mes "条件需要你满足。";
			next;
			if (.@new_book == 1) {
				cutin "orleans_7",0;
				mes "[查尔斯·奥尔良]";
				mes "我小时候，";
				mes "家里穷困到只能靠";
				mes "剩菜生活。";
				mes "那时候连";
				mes "魔物饲料都是上等";
				mes "美味。";
				next;
				mes "[查尔斯·奥尔良]";
				mes "那时父亲总会给我们";
				mes "南瓜。我小时候吃腻了，";
				mes "但现在它会唤起";
				mes "我对";
				mes "那些天真岁月的回忆。";
				next;
				mes "[查尔斯·奥尔良]";
				mes "这样如何？";
				mes "如果你带来 10 个南瓜，";
				mes "我就借给你一本";
				mes "等级 1 食谱。";
				if (countitem(535) > 9) {
					next;
					if (select("交出 10 个南瓜和当前食谱:取消") == 1) {
						cutin "orleans_6",0;
						mes "[查尔斯·奥尔良]";
						mes "太好了，你带来了";
						mes "10 个南瓜！我迫不及待";
						mes "想品尝这些";
						mes "童年时每天";
						mes "体验过的味道。";
						next;
					}
					else {
						mes "[查尔斯·奥尔良]";
						mes "啊，我多么怀念";
						mes "南瓜的味道！";
						mes "啊，好怀念啊～";
						goto L_End;
					}
				}
				else goto L_End;
			}
			else if (.@new_book== 2) {
				cutin "orleans_7",0;
				mes "[查尔斯·奥尔良]";
				mes "今天我想喝一杯茶。当然，";
				mes "喝茶不能没有";
				mes "饼干或曲奇。请带来";
				mes "给我";
				mes "5 块烤得恰到好处的曲奇，";
				mes "就能借我的等级 2 食谱。";
				if (countitem(538) > 4) {
					next;
					if (select("交出曲奇和当前食谱:取消") == 1) {
						cutin "orleans_6",0;
						mes "[查尔斯·奥尔良]";
						mes "哦，你带来的曲奇";
						mes "比我预想的";
						mes "快多了！";
						mes "太好了，我可以泡茶、";
						mes "放松，然后享用";
						mes "美味点心了～";
						next;
					}
					else {
						mes "[查尔斯·奥尔良]";
						mes "哦……";
						mes "我得赶紧喝茶……";
						mes "很快";
						mes "但没有烤得恰到好处的曲奇";
						mes "可以享用，体验就不完整～";
						goto L_End;
					}
				}
				else goto L_End;
			}
			else if (.@new_book== 3) {
				cutin "orleans_7",0;
				mes "[查尔斯·奥尔良]";
				mes "你知道天津町的特色";
				mes "料理吗？我最近";
				mes "一直很想吃。";
				mes "请带来 5 份寿司，";
				mes "我就借给你一本";
				mes "等级 3 食谱，好吗？";
				if (countitem(551) > 4) {
					next;
					if (select("交出寿司和当前食谱:取消")) {
						cutin "orleans_6",0;
						mes "[查尔斯·奥尔良]";
						mes "哦，看起来真新鲜！";
						mes "摆盘也很棒！一定是";
						mes "出色的厨师";
						mes "制作的！";
						next;
					}
					else {
						mes "[查尔斯·奥尔良]";
						mes "啊，寿司……";
						mes "这是少数几种";
						mes "我不太会";
						mes "制作的东西。";
						mes "你能相信吗？";
						goto L_End;
					}
				}
				else goto L_End;
			}
			else if (.@new_book== 4) {
				cutin "orleans_7",0;
				mes "[查尔斯·奥尔良]";
				mes "哦，我最近想吃";
				mes "昆仑料理。";
				mes "能带些美味的包子给我吗？";
				mes "带来";
				mes "5 个就很好。这样我会";
				mes "借给你我的等级 4 食谱。";
				if (countitem(553) > 4) {
					next;
					if (select("交出包子和当前食谱:取消") == 1) {
						cutin "orleans_6",0;
						mes "[查尔斯·奥尔良]";
						mes "太好了，你真的";
						mes "带来了！这些包子";
						mes "看起来特别";
						mes "美味！我等不及";
						mes "要尝一口了！";
						next;
					}
					else {
						mes "[查尔斯·奥尔良]";
						mes "哦……";
						mes "我已经很久";
						mes "没尝过";
						mes "那美味的包子了。";
						mes "我本想自己做，";
						mes "但不知道秘诀！";
						goto L_End;
					}
				}
				else goto L_End;
			}
			else if (.@new_book== 5) {
				cutin "orleans_7",0;
				mes "[查尔斯·奥尔良]";
				mes "最近，我的储藏室";
				mes "急需嫩芽。";
				mes "它们是美味的食材，";
				mes "不可忽视的健康价值。带来";
				mes "10 个给我，就能";
				mes "借到等级 5 食谱。";
				if (countitem(711) > 9) {
					next;
					if (select("交出嫩芽和当前食谱:退出") == 1) {
						cutin "orleans_6",0;
						mes "[查尔斯·奥尔良]";
						mes "天啊，这些嫩芽";
						mes "品质真高！";
						mes "看起来这么好，";
						mes "我相信你";
						mes "甚至可以生吃！";
						next;
					}
					else {
						mes "[查尔斯·奥尔良]";
						mes "我很快就要用那些";
						mes "嫩芽做菜，";
						mes "所以如果你能帮这个小忙，";
						mes "我会很感激～";
						goto L_End;
					}
				}
				else goto L_End;
			}

			if (.@old_book == 1) delitem 7472,1; //Cookbook01
			else if (.@old_book == 2) delitem 7473,1; //Cookbook02
			else if (.@old_book == 3) delitem 7474,1; //Cookbook03
			else if (.@old_book == 4) delitem 7475,1; //Cookbook04
			else if (.@old_book == 5) delitem 7476,1; //Cookbook05
			if (.@new_book == 1) {
				delitem 535,10; //Pumpkin
				getitem 7472,1; //Cookbook01
			}
			else if (.@new_book== 2) {
				delitem 538,5; //Well_Baked_Cookie
				getitem 7473,1; //Cookbook02
			}
			else if (.@new_book== 3) {
				delitem 551,5; //Shusi
				getitem 7474,1; //Cookbook03
			}
			else if (.@new_book== 4) {
				delitem 553,5; //Bun
				getitem 7475,1; //Cookbook05
			}
			else if (.@new_book== 5) {
				delitem 711,10; //Shoot
				getitem 7476,1; //Cookbook05
			}
			mes "[查尔斯·奥尔良]";
			mes "好，正如承诺的，";
			mes "这是你要的食谱。";
			mes "请";
			mes "好好保管——别卖掉、";
			mes "别弄丢，别做类似的事。";
			mes "祝你烹饪顺利～";
			goto L_End;

		case 2:
			cutin "orleans_3",0;
			mes "[查尔斯·奥尔良]";
			mes "你是什么意思，";
			mes "‘我该为谁做饭？’";
			mes "这是个奇怪的问题，";
			mes "答案很简单。我是";
			mes "必须将更多艺术";
			mes "带到世上的艺术家。";
			next;
			cutin "orleans_3",0;
			mes "[查尔斯·奥尔良]";
			mes "等等，等等……";
			mes "你和玛德琳·朱说过话吗？";
			mes "她没说什么";
			mes "在外面";
			mes "奇怪的话吧？";
			mes "如果说了，别理她！";
			next;
			cutin "orleans_6",0;
			mes "[查尔斯·奥尔良]";
			mes "不，没什么";
			mes "特别的理由";
			mes "能解释我最近";
			mes "创作料理杰作的热情";
			mes "为何重新燃起……";
			goto L_End;

		case 3:
			cutin "orleans_5",0;
			mes "[查尔斯·奥尔良]";
			mes "请别为此";
			mes "担心。现在";
			mes "让我休息一下～";
			goto L_End;

		}
	}
	else {
		mes "[查尔斯·奥尔良]";
		mes "我的天！";
		mes "发生了";
		mes "错误！";
		goto L_End;
	}

L_End:
	close2;
	cutin "",255;
	end;
}

-	script	Madeleine Chu#cook_	-1,{
	if (MaxWeight - Weight < 2000) {
		mes "[朱美德琳]";
		mes "抱歉，你现在";
		mes "携带了太多物品。";
		mes "请把多余物品放进";
		mes "卡普拉仓库，";
		mes "然后再来找我，好吗？";
		close2;
		//EnableItemMove
		end;
	}
	if (cooking_q == 0) {
		mes "[朱美德琳]";
		mes "哦，你好～";
		mes "我是玛德琳·朱，";
		mes "厨师学徒，";

// Warp portal into Kiehl's 'Room'
// - Anyone can enter
// - After 30-40 seonds this NPC should be disabled.
//----------------------------------------------------------------------------
kh_mansion,27,27,0	script	Kiehl_Room_Warp	45,2,2,{
OnTouch_:
	warp "kh_kiehl01",10,31;
	end;

OnEnable:
	initnpctimer;
	specialeffect EF_SUMMONSLAVE;
	end;

OnTimer30000:
	stopnpctimer;
	specialeffect EF_SUMMONSLAVE;
	disablenpc "Kiehl_Room_Warp";
	end;

OnInit:
	disablenpc "Kiehl_Room_Warp";
	end;
}

//============================================================================
// Rosimier NPCs and other Related NPCs
//============================================================================

//----------------------------------------------------------------------------
// Odd Grandma
//----------------------------------------------------------------------------
yuno,257,140,4	script	Odd Grandma	846,{
	if (KielHyreQuest < 54) {
		mes "[Grandma]";
		mes "你去哪了，";
		mes "亲爱的？你在哪里？";
		mes "你在哪里，我的小宝贝？";
		close;
	}
	else if (KielHyreQuest == 54) {
		mes "[Grandma]";
		mes "摇篮曲……";
		mes "说晚安……";
		mes "安静，小宝贝……";
		mes "快快睡觉～";
		next;
		switch(select("你在做什么？:嗯，我没看到婴儿……")) {
		case 1:
			mes "[Grandma]";
			mes "哦？我的宝宝一直哭，";
			mes "怎么也睡不着。她需要休息，";
			mes "这样我才能去工作。";
			mes "房子太乱了，";
			mes "老板会不高兴的……";
			set KielHyreQuest,56;
			next;
			select("嗯，我没看到婴儿……");
			mes "[Grandma]";
		mes "什么，她说得对——";
		mes "好了，亲爱的，你在做什么？";
		mes "别在我们的朋友面前";
		mes "调皮！嘘，乖一点，";
		mes "我的小姑娘。";
			//GetHEALTHSTATE VAR_CURSE 30
			close;
		case 2:
			mes "[Grandma]";
		mes "你在做什么……？";
		mes "哦，看看这个。";
		mes "你让我的小姑娘";
				mes "亲爱的哭声！嘘，";
				mes "安静，小 ^0000FF阿莉西亚^000000。";
				mes "快快睡觉～";
			close;
		}
	}
	else if ((KielHyreQuest >= 56) && (KielHyreQuest < 60)) {
		mes "[Grandma]";
		mes "阿莉西亚……？！";
		mes "阿莉西亚，你去哪了？";
		mes "你本该";
		mes "早就回家了！";
		if (countitem(7500) < 1) { 
			close;
		}
		else {
			next;
			switch(select("Allysia? Isn't she...")) {
			case 1:
				cutin "kh_ellisia_port",1;
				mes "^3355FF你把阿莉西亚的肖像";
				mes "肖像交给老妇人。^000000";
				next;
				cutin "",255;
				mes "[Grandma]";
			mes "哦，你知道";
				mes "阿莉西亚？她失踪了！";
				mes "她昨天离开家后";
				mes "一直没回来！你、你能告诉我她在哪里吗？！";
				close;
			}
		}
	}
	else if (KielHyreQuest >= 60) {
		mes "[Grandma]";
		mes "别担心，阿莉西亚……";
		mes "妈妈永远会在这里陪你。";
		mes "不用悲伤……";
		close;
	}
}

//----------------------------------------------------------------------------
// Old Lady; gives you the key to the Rosimier Mansion
//----------------------------------------------------------------------------
yuno,250,132,0	script	Old Lady#kh	711,{
	if (KielHyreQuest < 56) {
		mes "[Old Lady]";
		mes "哦，我的腿和背";
		mes "酸痛。这把老骨头";
		mes "全身都疼……";
		close;
	}
	else if (KielHyreQuest == 56) {
		if (checkweight(7498,1) == 0) {
				mes "^3355FF请稍等……";
			mes "你现在携带的物品太多，";
			mes "需要先腾出更多背包空间……^000000";
			close;
		}
		mes "[Old Lady]";
		mes "天啊，我讨厌这种天气！";
		mes "让我想起自己已经老了！";
		mes "真让我骨头发冷！";
		next;
		switch(select("......:Do you know that grandma?")) {
		case 1:
			mes "[Old Lady]";
			mes "该死！要是年轻时没有";
			mes "经历那么多冒险，";
			mes "也许我年老时";
			mes "就不会这么受苦！";
			close;
		case 2:
			mes "[Old Lady]";
			mes "哦……是的。她是我最好朋友";
			mes "^3355FF阿莉西亚^000000 的母亲。自从她自杀后，";
			mes "事情就变了。";
			mes "就不一样了。她的母亲";
			mes "失去了理智……";
			next;
			select("Was ^3355FFAllysia^000000...?");
			mes "[Old Lady]";
			mes "哦，阿莉西亚是个美丽的女孩。";
			mes "很多男人都想追求她，尤其是";
			mes "英俊的詹姆斯·罗西米尔。";
			mes "我记得听说他们要结婚……";
			next;
			mes "[Old Lady]";
			mes "我为她感到高兴！";
			mes "但突然之间，";
			mes "她自杀了。嗯，";
			mes "大家都这么说。";
			mes "直到今天，我仍不确定";
			mes "究竟发生了什么。";
			next;
			select("等等，詹姆斯·罗西米尔是谁？");
			mes "[Old Lady]";
			mes "哦，詹姆斯属于朱诺最古老、最富有的家族之一。";
			mes "一切本来都很顺利，但阿莉西亚死后不久，";
			mes "那个家族就破产了。";
			next;
			mes "[Old Lady]";
			mes "现在由城市管理他们的";
			mes "旧宅邸。不知为何，";
			mes "他们决定把罗西米尔宅邸的";
			mes "万能钥匙";
			mes "交给我保管。";
			next;
			select("我可以借用万能钥匙吗？");
			mes "[Old Lady]";
			mes "我本不该把它交给任何人，";
			mes "但我看得出你真心为阿莉西亚着想。";
			next;
			mes "[Old Lady]";
			mes "不过，你必须确保在市政厅的人";
			mes "向我要之前把钥匙还给我。";
			mes "那么，希望你能找到";
			mes "想找的东西。";
			getitem 7498,1; //Rosimier_Key
			set KielHyreQuest,58;
			close;
		}
	}

	else if ((KielHyreQuest == 58) &&
		(countitem(7499) < 1) || 
		(countitem(7500) < 1) || 
		(countitem(7501) < 1) || 
		(countitem(7502) < 1)) {
		mes "[Old Lady]";
		mes "请快点找到你在";
		mes "罗西米尔宅邸寻找的东西。";
		mes "否则我可能会惹上麻烦。";
		mes "市政厅的人";
		mes "来向我要钥匙……";
		close;
	}

	else if ((KielHyreQuest == 58) &&
		(countitem(7499) == 1) && 
		(countitem(7500) == 1) && 
		(countitem(7501) == 1) && 
		(countitem(7502) == 1)) {
		mes "[Old Lady]";
		mes "哦，你搜完";
		mes "宅邸了吗？";
		mes "很令人沮丧，对吧？";
		mes "债权人很久以前";
		mes "基本把一切都搜刮干净了。";
		next;
		select("阿莉西亚为什么……？");
		mes "[Old Lady]";
		mes "我知道詹姆斯";
		mes "和阿莉西亚相爱，";
		mes "并承诺娶她。";
		mes "但据说他的家族已经";
		mes "安排他与另一位女性订婚。";
		next;
		mes "[Old Lady]";
		mes "时间流逝，他被迫娶了未婚妻。";
		mes "阿莉西亚深受打击。";
		mes "我想也许那就是她……你知道的……";
		next;
		mes "[Old Lady]";
		mes "听着，如果你想了解";
		mes "想更多了解发生了什么，";
		mes "我建议你去和住在那里的";
		mes "^3355FF渔夫^000000谈谈。";
		mes "^3355FF在基尔学院南边。^000000";
		next;
		mes "[Old Lady]";
		mes "就是他在河里发现了";
		mes "阿莉西亚的尸体，";
		mes "所以他可能更清楚";
		mes "当时发生了什么。";
		delitem 7498,1; //Rosimier_Key 
		set KielHyreQuest,60;
		close;
	}
	else if (KielHyreQuest >= 60) {
		mes "[Old Lady]";
		mes "没错，要下雨了。";
		mes "我的骨头能感觉到。";
		close;
	}
}


//----------------------------------------------------------------------------
// Warp portal into Rosimier Mansion
//----------------------------------------------------------------------------
yuno,273,141,0	script	Rosimmir_Entrance	45,2,2,{
OnTouch_:
	if (countitem(7498) < 1) {
		mes "那座宅邸似乎";
		mes "已经被时间摧毁。";
		mes "不过，如果有正确的钥匙，";
		mes "这扇门看起来";
		mes "仍然可以使用。";
		close;
	}
	else {
		warp "kh_rossi",20,92;
	}
	end;
}

//----------------------------------------------------------------------------
// Rosimier Mansion, first floor; Table
//----------------------------------------------------------------------------
kh_rossi,23,23,0	script	Table#khr2	111,{
	if (checkweight(7499,1) == 0) {
		mes "^3355FF请稍等……";
		mes "你携带的物品太多，";
		mes "背包空间不足。";
		mes "所以你现在需要先腾出更多";
		mes "背包空间……^000000";
		close;
	}
	if (KielHyreQuest < 58) {
		mes "^3355FF这里没有";
		mes "对你很重要的物品。^000000";
		close;
	}
	else if (KielHyreQuest < 60) {
		if (countitem(7499) < 1) {
			cutin "kh_family_port",1;
			mes "^3355FF你检查桌子，";
			mes "并在打开的抽屉里找到";
			mes "一幅带框肖像。^000000";
			getitem 7499,1; //Family_Portrait
		}
		else {
			mes "^3355FF桌子的打开抽屉";
			mes "这张桌子现在空了。^000000";
		}
	}
	else{
		mes "^3355FF这里是";
		mes "你获得了";
		mes "罗西米尔家族肖像。";
		mes "抽屉现在空了。^000000";
		close;
	}
	close2;
	cutin "",255;
	end;
}


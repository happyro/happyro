			mes "父子之间";
			mes "一定发生了什么！现在告诉我，";
			mes "到底发生了什么？";
			next;
			mes "[??????]";
			mes "我不知道你多了解这个国家，";
			mes "但雷根贝勒参与其中这一事实";
			mes "足以说明他们不是好人。";
			mes "告诉我你知道的一切！";
			next;
		case 1:
			mes "^3355FF你把所知道的";
			mes "^3355FF关于基尔的全部事情告诉了老妇人。^000000";
			mes "^3355FF每当提到艾莉时，";
			mes "^3355FF你的声音都因悲伤而颤抖。^000000";
			mes "^3355FF";
			next;
			mes "[??????]";
			mes "我明白了，我明白了……";
			mes "那个可怜的女孩……所以……";
			mes "你参与此事只是巧合？";
			mes "既然如此，我想请你";
			mes "帮助我们的调查。";
			next;
			switch(select("Okay:......")) {
			case 2:
				mes "[??????]";
			mes "如果你不合作，";
			mes "我无法保证你的安全，";
			mes "冒险者。";
				next;
				mes "["+strcharinfo(0)+"]";
			mes "嗯？什么……？";
			mes "那是什么意思？";
				mes "你在威胁我吗？";
				next;
				select("照她说的做吧。 ");
			case 1:
				mes "[??????]";
				mes "很好。";
				mes "我是米切尔·莱拉探员。";
				mes "从现在起，你为施瓦茨瓦尔德共和国工作！";
				set KielHyreQuest,52;
				close;
			}
		}
	}
	else if (KielHyreQuest == 52) {
		mes "[Mitchell]";
		mes "我有一些新信息。";
		mes "朱诺有一位老妇人，";
		mes "三十年前认识一名叫阿莉西亚的女人。";
		next;
		mes "[Mitchell]";
		mes "关键在于，三十年前的阿莉西亚";
		mes "自杀身亡，却与基尔·海伊尔的秘书";
		mes "长得一模一样，而她也";
		mes "名叫阿莉西亚。";
		next;
		mes "[Mitchell]";
		mes "这巧合太大了。";
		mes "我要你去朱诺调查。";
		mes "完成后和基尔·海伊尔的管家谈谈，";
		mes "他会把你送到我这里。";
		next;
		mes "[Mitchell]";
		mes "是的，我知道。";
		mes "那个人其实为我工作。";
		mes "准备去朱诺时告诉我，";
		mes "你可以登上联邦飞艇。";
		set KielHyreQuest,54;
		close;
	}
	else if (KielHyreQuest == 54) {
		mes "[Mitchell]";
		mes "准备好了吗？";
		mes "我会让你登上";
		mes "联邦飞艇，";
		mes "前往朱诺，";
		mes "尽快完成任务。";
		next;
		switch(select("Yes:No")) {
		case 1:
			mes "[Mitchell]";
		mes "祝你好运。完成任务后，";
		mes "记得向基尔·海伊尔的管家报告，";
		mes "这样他才能把你送到我这里。";
			close2;
			warp "yuno",54,209;
			end;
		case 2:
			mes "[Mitchell]";
		mes "慢慢来……";
		mes "但请记住";
			mes "我可不是有耐心的女人！";
			close;
		}
	}
	else if (KielHyreQuest == 64) {
		mes "[Mitchell]";
		mes "啊，你回来了。";
		mes "调查有什么";
		mes "结果要报告？";
		next;
		mes "[Mitchell]";
		mes ".....................";
		mes "啊，我明白了。干得好。";
		mes "去和基尔·海伊尔谈谈，";
		mes "用你了解到的他的过去";
		mes "当面对质？好好审问他。";
		next;
		mes "[Mitchell]";
		mes "戴上这个隐藏式麦克风，";
		mes "这样遇到危险时我们能派人支援。";
		mes "我希望你查清基尔的真实身份，";
		mes "以及他与雷根贝勒的关系。";
		set KielHyreQuest,68;
		next;
		warp "kh_mansion",83,50;
		end;
	}
	else if (KielHyreQuest >= 68) {
		mes "[Mitchell]";
		mes "你现在";
		mes "不该离开了吗？";
		next;
		warp "kh_mansion",83,50;
		end;
	}
}


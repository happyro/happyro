// Boss room 1
1@adv,127,356,3	script(DISABLED)	Illusion Bagot#bagot01	4_EP18_BAGOT,{
	npctalk "真有趣。";
	end;
}

1@adv,121,355,5	script(DISABLED)	Yus Amal#jus01	4_M_RACHOLD,{
	if ('adv_step != 25)
		end;
	if (is_party_leader() == false) {
	mes "[青年]";
		mes "别碰我！这是亵渎！";
		npctalk "青年：别碰我！亵渎之物！";
		close;
	}
	.@bagot01$ = instance_npcname("Illusion Bagot#bagot01");
	.@demigod$ = instance_npcname("Twisted God#demigod");
	.@shulang02$ = instance_npcname("Schulang#shulang02");
	.@miriam04$ = instance_npcname("Miriam#miriam04");

	mes "[阿玛尔]";
	mes "这些可恶的异教徒竟然来到这里。";
	mes "但这无关紧要。";
	mes "你很快就会跪在至高神明面前。";
	npctalk "阿莫尔：这些可恶的异教徒竟然来到这里。但你很快就会跪在至高神明面前。";
	next;
		mes "[阿玛尔]";
	mes "我要向傲慢的奥丁仆从展示奇迹。";
	mes "巴戈特，请继续仪式。";
	npctalk "阿莫尔：我要向傲慢的奥丁仆从展示奇迹。巴戈特，请继续仪式。";
	next;
			mes "[阿玛尔]";
	mes "他们将亲眼见证芙蕾雅的奇迹。";
	mes "跪在神的脚下，作为神的仆从重生吧！";
	npctalk "阿莫尔：他们将亲眼见证芙蕾雅的奇迹。跪下，作为神的仆从重生吧！";
	next;
	cutin "ep18_bagot_01.png",2;
	mes "[巴戈特]";
	mes "哇……你的说法真鼓舞人心。不过，";
	mes "我既然做了承诺就会遵守。明白吗？";
	npctalk "巴戈特：哇……你的说法真鼓舞人心。不过我既然做了承诺就会遵守。", .@bagot01$;
	next;
	cutin "ep18_bagot_03.png",2;
		mes "[巴戈特]";
	mes "首先，你就是那位冒险者吗？";
	mes "要看看我的作品吗？";
	mes "你也能体验从窑中取出精美陶器的感觉。";
	npctalk "巴戈特：你就是那位冒险者吗？要看看我的作品吗？", .@bagot01$;
	close2;

	setpcblock PCBLOCK_NPC, true;
	npctalk "巴戈特：能马上确认实验结果真棒。", .@bagot01$;
	specialeffect EF_DQ9_CHARGE3, AREA, .@demigod$;
	sleep2 500;
	specialeffect EF_SCREEN_QUAKE, AREA, .@demigod$;
	sleep2 1000;
	specialeffect EF_BEGINSPELL_YB, AREA, .@demigod$;
	// enablenpc .@demigod$;
	cloakoffnpc .@demigod$;	// cloakoffnpc to display effect on rAthena
	setpcblock PCBLOCK_NPC, false;

			mes "[巴戈特]";
	mes "哒哒~科学与魔法的精髓就在这里！";
	mes "我会让神明形态的存在降临！";
	npctalk "巴戈特：哒哒~科学与魔法的精髓就在这里！", .@bagot01$;
	next;
				mes "[巴戈特]";
	mes "让神明降临到容器上，对这根棒子来说毫无问题！";
	npctalk "巴戈特：让神明降临到容器上，对这根棒子来说毫无问题！", .@bagot01$;
	next;
	cutin "ep18_demifreya.png",1;
	mes "[被称为神的存在]";
	mes "....";
	npctalk "被称为神的存在：……", .@demigod$;
	next;
				mes "[阿玛尔]";
	mes "哦……哦哦……！美丽的芙蕾雅……！你是我的神吗？";
	npctalk "阿莫尔：哦……哦哦……！美丽的芙蕾雅……！你是我的神吗？";
	next;
	mes "^4d4dff所谓的神圣存在看起来像成年版的教皇。^000000";
	mes "^4d4dff它的根本用途，是作为女神芙蕾雅降临此世的容器。^000000";
	next;
	select( "难道是教皇？！" );
	unittalk getcharid(3), "" + strcharinfo(0) + " : Could it be the Pope?!";
	cutin "ep18_bagot_02.png",2;
					mes "[巴戈特]";
	mes "那是什么声音？";
	mes "不管巴戈特多坏，也不至于捉弄教皇！";
	npctalk "巴戈特：那是什么声音？", .@bagot01$;
	next;
	cutin "ep18_bagot_03.png",2;
						mes "[巴戈特]";
	mes "你怎么敢对我的杰作无礼？！";
	mes "你害怕我创造神明降临容器的能力吗？";
	npctalk "巴戈特：你害怕我创造神明降临容器的能力吗？", .@bagot01$;
	next;
	cutin "",255;
					mes "[阿玛尔]";
	mes "哦……哦哦……！我美丽的女神芙蕾雅……！";
	npctalk "阿莫尔：哦……哦哦……！我美丽的女神芙蕾雅……！";
	next;
	cutin "ep18_bagot_02.png",2;
	mes "[巴戈特]";
	mes "你没听我说。那么是什么？哦~！对，奇迹。只要向我展示奇迹，对吧？";
	npctalk "巴戈特：你没听我说。那么是什么？哦~！对，奇迹。", .@bagot01$;
	next;
	cutin "ep18_demifreya.png",1;
		mes "[被称为神的存在]";
	mes ".....";
	npctalk "被称为神的存在：……", .@demigod$;
	next;
			mes "[被称为神的存在]";
	mes ".....";
	sleep2 500;
	mes "我";
	npctalk "被称为神的存在：..我..", .@demigod$;
	sleep2 1000;
	mes "..a..";
	npctalk "被称为神的存在：..啊..", .@demigod$;
	sleep2 1000;
	mes "k..";
	npctalk "被称为神的存在：咳……", .@demigod$;
	close2;
	cutin "",255;

	setpcblock PCBLOCK_NPC, true;
	sleep2 1500;
	specialeffect EF_DQ9_CHARGE3, AREA, .@shulang02$;
	sleep2 1000;
	specialeffect EF_BEGINSPELL_YB, AREA, .@shulang02$;
	cloakoffnpc .@shulang02$;
	sleep2 2500;
	npctalk "巴戈特：什么？你救了他？见到祭司了吗？巴戈特说了什么？我就说是可能的。", .@bagot01$;
	sleep2 1500;
	setpcblock PCBLOCK_NPC, false;

	cutin "ep18_bagot_03.png",2;
	mes "[巴戈特]";
	mes "证据在这里。奇迹~";
	mes "老祭司。既然我按约召唤了你的神，我就带走^4d4dff心脏^000000。";
	npctalk "巴戈特：既然我按约召唤了你的神，我就带走心脏。", .@bagot01$;
	next;
	mes "[巴戈特]";
	mes "希望你永远活着~";
	npctalk "巴戈特：希望你永远活着~", .@bagot01$;
	next;
	cutin "",255;
						mes "[阿玛尔]";
	mes "卑微的仆人见证了神的奇迹！";
	npctalk "阿莫尔：卑微的仆人见证了神的奇迹！";
	next;
	cutin "ep18_bagot_01.png",2;
	mes "[巴戈特]";
	mes "你到底有没有在听？";
	mes "舒朗有点浪费，不过他的角色到此结束。";
	npctalk "巴戈特：你到底有没有在听？舒朗有点浪费，不过他的角色到此结束。", .@bagot01$;
	next;
	cutin "ep18_bagot_03.png",2;
	mes "[巴戈特]";
	mes "同时我遵守了诺言，让你带着^4d4dff强烈的味道^000000活下去。";
	mes "我走了~冒险者？再见~！";
	npctalk "巴戈特：我遵守了诺言，让你带着‘强烈的味道’活一阵子。冒险者？再见~！", .@bagot01$;
	close2;
	cutin "",255;

	setpcblock PCBLOCK_NPC, true;
	disablenpc .@bagot01$;
	npctalk "阿莫尔：哦……芙蕾雅！请惩罚这些异教徒！";
	sleep2 2500;

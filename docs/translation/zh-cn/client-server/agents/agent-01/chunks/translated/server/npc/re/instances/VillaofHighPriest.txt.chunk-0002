



1@adv,182,144,4	script(DISABLED)	Miriam#miriam03	EP18_NPC_MIRIAM,{
	if ('adv_step < 17)
		end;
	if ('adv_step == 17) {
	mes "[米丽娅姆]";
		mes "你找到了钥匙。";
		mes "看来别墅的几名员工被困在里面。";
		mes "我会守在这里，你进去吧。";
		cutin "ep18_miriam_01.png",0;
		close2;
		cutin "",255;
		if ('adv_step == 17) {
			'adv_step = 18;
			enablenpc instance_npcname("#right_room_in");
			enablenpc instance_npcname("#right_room_out");
			enablenpc instance_npcname("Villa Employee#ex21");
			enablenpc instance_npcname("Villa Employee#ex22");
			enablenpc instance_npcname("Villa Employee#ex23");
		}
		end;
	}
	if ('adv_step == 18) {
		npctalk "米丽娅姆：我会守住入口，请搜索房间内部。";
		end;
	}
	if ('adv_step == 19) {
		mes "[米丽娅姆]";
		mes "这样下去，这些人都会被处置。";
		mes "必须在更多心猎人进来前疏散他们。";
		cutin "ep18_miriam_01.png",0;
		next;
			mes "[米丽娅姆]";
		mes "那么，礼拜堂的调查就交给冒险者。";
		mes "我会带那些人撤离。";
		mes "拜托了。";
		npctalk "米丽娅姆：里面的人。我护送你们，我们出去。", instance_npcname("Miriam#miriam03");
		close2;
		cutin "",255;
		disablenpc instance_npcname("Miriam#miriam03");
		end;
	}
	end;
}

1@adv,202,145,3	script(DISABLED)	Villa Employee#ex21	4_F_SHABBY,{
	npctalk "别墅员工：请让我离开这里……", instance_npcname("Villa Employee#ex21");
	end;
}

1@adv,204,143,3	script(DISABLED)	Villa Employee#ex22	4_M_RACHMAN2,{
	if ('adv_step == 18) {
	mes "[别墅员工]";
		mes "你要销毁证据吗！杀人犯！";
		mes "嗯？";
		next;
		mes "[别墅员工]";
		mes "你！你是来救我们的，对吧？";
		mes "我在外面听到的声音是米丽娅姆，对吧？";
		next;
			mes "[别墅员工]";
		mes "调查礼拜堂！这里肯定有可疑之处！";
		mes "什么？宴会厅关闭了吗？";
		next;
				mes "[别墅员工]";
		mes "这是侧门的钥匙。";
		mes "离开房间后可以打开正前方的门。";
		mes "这是我送餐常用的门，所以有备用钥匙。";
		next;
					mes "[别墅员工]";
		mes "请救救我们。";
		mes "我们没有犯任何罪。";
		next;
		mes "你获得了 ^4d4dff备用钥匙^000000。";
		if ('adv_step == 18)
			'adv_step = 19;
		close;
	}
	npctalk "别墅员工：你可以用备用钥匙开门。", instance_npcname("Villa Employee#ex22");
	end;
}

1@adv,210,140,6	script(DISABLED)	Villa Employee#ex23	4_M_RACHMAN1,{
	npctalk "别墅员工：我们真的要死了吗？", instance_npcname("Villa Employee#ex23");
	end;
}

1@adv,173,142,0	script	Locked Door#key03	4_POINT_YELLOW,{
	if ('adv_step < 19) {
		mes "牢牢锁住的门。";
		mes "上面有一个小钥匙孔。";
		unittalk getcharid(3), "" + strcharinfo(0) + " : I need a key.";
		close;
	}
	mes "我使用了备用钥匙。";
	progressbar "4D4DFF",2;
	if ('adv_step != 19)
		close;
	'adv_step = 20;
	disablenpc instance_npcname("Locked Door#key03");
	enablenpc instance_npcname("#center_room_in");
	enablenpc instance_npcname("#center_room_out");
	donpcevent instance_npcname("adv_center") + "::OnStart";
	close;
}


		emotion ET_QUESTION, getnpcid(0, "Mojo#ilgf");
		mes "[Mojo]";
		mes "你为什么看着我？";
		npctalk "这和我无关。", "Mojo#ilgf", bc_self;
		next;
		mes "[Grimm]";
		mes "一些法师决定建造属于自己的象牙塔。他们在大陆各处寻找，最终选中了这些地下墓穴上方的土地。";
		next;
		mes "[Grimm]";
		mes "那就是悲剧的开始。";
		emotion ET_ANGER, getnpcid(0, "Mojo#ilgf");
		npctalk "天啊，又来了。", "Mojo#ilgf", bc_self;
		next;
		mes "[Grimm]";
		mes "据说所有哺乳动物的好奇心都和食欲一样强，但法师……是最糟糕的。";
		npctalk "说教够了。快点说重点。", "Mojo#ilgf", bc_self;
		sleep2 500;
		npctalk "万事都有因果。冒险者不知道起因，怎么理解事情的经过？";
		next;
		mes "[Grimm]";
		mes "总之，这些法师建造了吉芬塔后，注意到地下墓穴里偶尔出现的亵渎生物。";
		next;
		mes "[Grimm]";
		mes "他们进行各种实验，想了解令死者复活的特殊能量。";
		npctalk "他们只是做研究。", "Mojo#ilgf", bc_self;
		sleep2 500;
		npctalk "只是研究？他们差点把整片大陆变成亵渎的繁殖场！";
		next;
		mes "[Grimm]";
		mes "而且还不止如此，那些法师使用魔法复制了复活过程。";
		next;
		mes "[Grimm]";
		mes "结果彻底失控。环绕地下墓穴的特殊能量爆炸，使埋葬其中的所有死者复活。";
		next;
		mes "[Grimm]";
		mes "那些傲慢的法师越界了！他们竟想扮演神明！";
		next;
		emotion ET_ANGER, getnpcid(0, "Mojo#ilgf");
		mes "[Mojo]";
		mes "嘿，我也是法师之一，不会让你这样说我的前辈！";
		next;
		mes "[Grimm]";
		mes "我只是在说真话，怎么能算诽谤？";
		npctalk "只从你的角度讲述，就不是真相！", "Mojo#ilgf", bc_self;
		next;
		mes "[Grimm]";
		mes "你觉得呢，冒险者？你会把重要任务交给如此鲁莽的人吗？";
		next;
		select("……不会。");
		mes "[Mojo]";
		mes "等等，冒险者。你还没听过我的说法。";
		npctalk "下判断前必须听取双方的说法！", "Mojo#ilgf", bc_self;
		next;
		mes "[Mojo]";
		mes "我们知道研究对象可能很危险，所以会尽力小心。";
		npctalk "显然这次光尽力还不够。";
		sleep2 500;
		npctalk "你为什么这么说？我说的是我的前辈！", "Mojo#ilgf", bc_self;
		next;
		mes "[Mojo]";
		mes "我的前辈或许过于热衷研究塔下的东西，但正是这份热情让吉芬成长为如今的魔法之城。";
		next;
		mes "[Mojo]";
		mes "卢恩·米德加尔特被大陆最强的两个国家阿鲁纳佩尔兹和施瓦茨瓦尔德夹在中间，魔法力量正是让它们不敢妄动的原因。";
		next;
		mes "[Grimm]";
		mes "这也是教会没有继续追究此事的唯一原因，";
		next;
		mes "[Grimm]";
		mes "尽管这改变不了你唤醒死者的事实。";
		npctalk "格林神父，你能别插嘴吗？", "Mojo#ilgf", bc_self;
		sleep2 500;
		npctalk "我不能。你在扭曲事实来美化自己。";
		next;
		mes "[Mojo]";
		mes "好奇心是我们生命的燃料，是发展的种子。冒险者，你会因为新世界危险就犹豫不去吗？";
		next;
		select("如果会，我就不是冒险者了。");
		mes "[Mojo]";
		mes "在这一点上，我们法师和你们冒险者一样。我就知道你会理解我。";
		emotion ET_OK, getnpcid(0, "Mojo#ilgf");
		next;
		mes "[Mojo]";
		mes "你听到了，格林神父。现在把笔记本给我看看。";
		next;
		mes "[Grimm]";
		mes "不。冒险者，你同意她不值得信任。";
		next;
		mes "[Mojo]";
		mes "你也同意好奇心的价值。";
		next;
		select("那么，这到底是怎么回事？");
		mes "[" + strcharinfo(0) + "]";
		mes "我听过你们双方的说法，但你们都没告诉我究竟在争什么。";
		next;
		mes "[Grimm]";
		mes "哦，抱歉。卢恩·米德加尔特教会会定期派神父到这些地下墓穴维持和平。";
		next;
		mes "[Grimm]";
		mes "我就是其中之一，在你找到我们前不久捡到了一本^0000cd笔记本^000000。";
		next;
		select("笔记本？");
		mes "[Grimm]";
		mes "是的。看起来属于一名吉芬塔法师。封面上写着^0000cd波米^000000，我想那是主人的名字。";
		next;
		mes "[Mojo]";
		mes "但我的同僚中没人叫这个名字。我读过这本书，她听起来确实曾是我们的一员。但^0000cd现在不是了^000000。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "现在不是了？";
		next;
		emotion ET_OK, getnpcid(0, "Mojo#ilgf");
		mes "[Mojo]";
		mes "你很敏锐，冒险者。没错。我向公会确认过，确实有个叫波米的人。不过她有一天突然消失了。";
		npctalk "而且那已经是很久很久以前的事了。", "Mojo#ilgf", bc_self;
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "你觉得这本笔记本属于她？但为什么会在这里？";
		next;
		mes "[Mojo]";
		mes "这也是我们最初的问题。但读过书里的内容后，那个问题已经不重要了。";
		next;
		mes "[Grimm]";
		mes "里面写的东西令人不安，但更严重的是……你必须亲自阅读。只是不要打开^0000cd最后一页^000000。";
		next;
		mes "[Mojo]";
		mes "所以你允许这位冒险者阅读，却不允许我看。";
		npctalk "你知道这叫歧视吧？你应该感到羞愧！", "Mojo#ilgf", bc_self;
		next;
		mes "[Grimm]";
		mes "请看一看。";
		erasequest 14652;// Detailed Account 01
		setquest 14653;// Detailed Account 02
		ill_vampire = 2;
		close;
	}
	if (ill_vampire == 2) {
	mes "我把手放在格林神父拿着的书上。周围的空气突然闪烁起来，我感到一阵眩晕。我小心地打开笔记本。";
		next;
		mes "[Daily Journal]";
	mes "我又一次在学习新法术时昏倒了。";
	mes "低体力和不足的魔力一直是问题。我以为可以用魔法弥补孱弱的体质。当然，那也需要最低限度的体力，可我连那点体力都没有。";
	mes "我太累了……";
		next;
		mes "[Daily Journal]";
	mes "我看见索菲亚喝魔力药水。也许药水能解决我一直寻找身体支持的问题。";
	mes "不知道有没有能改善身体状况的特殊药水。这样我终于能变强了。";
		next;
		mes "[Daily Journal]";
	mes "我找到的所有药水都没能改善孱弱的体质。它们只能增强已有的力量。";
	mes "也许我该自己尝试调配体力和魔力药水。";
		next;
		mes "[Daily Journal]";
	mes "我在图书馆阅读吉芬塔历史时，了解了塔下的地下墓穴。";
	mes "死者是如何复活的？是什么生命力让他们继续行动？";
	mes "我需要进入地下墓穴的许可。明天去调查吧。";
		next;
		mes "[Daily Journal]";
	mes "死者不会说话。我从他们那里什么也问不出来。";
	mes "到处都能找到实验痕迹。我的某些同僚一定在我之前来过。";
	mes "我今天特别累。今晚早点睡吧。";
		next;
		mes "[Daily Journal]";
	mes "地下墓穴里的蝙蝠吸食僵尸的血，大概是因为没有其他东西可吃。";
	mes "我每天都要花大部分精力抵挡嗜血蝙蝠。如果不待在出口附近，我会被杀死。";
	mes "我累了。";
		next;
		mes "[Daily Journal]";
	mes "今天我在地下墓穴里听到奇怪的声音。僵尸和蝙蝠异常安静。";
	mes "也许明天应该深入地下墓穴，在怪物躲避那声音时探索。";
		next;
	mes "这是最后一篇记录。我把手从笔记本上移开，格林神父合上了笔记本。";
		erasequest 14653;// Detailed Account 02
		setquest 14654;// Detailed Account 03
		ill_vampire = 3;
		close;
	}
	if (ill_vampire == 3) {
		mes "[" + strcharinfo(0) + "]";
		mes "这本笔记本既是^0000cd日记，也是研究日志^000000。";
		next;
		mes "[Grimm]";
		mes "没错。它记录了主人如何研究那些亵渎生物，以^0000cd制作体力和魔力增强剂^000000。";
		next;
		select("有意思。");
		emotion ET_OK, getnpcid(0, "Mojo#ilgf");
		mes "[Mojo]";
		mes "确实。我的公会很想研究这本笔记本。同一时代的大多数记录都已经遗失。";
		npctalk "我也很想亲自读读。", "Mojo#ilgf", bc_self;
		next;
		mes "[Grimm]";
		mes "笔记本的内容并不是令我警惕的原因。你触摸它时，难道没有察觉某种^0000cd奇怪能量^000000？";
		next;
		mes "[Grimm]";
		mes "这本书由主人的精神能量维持，并将凝视它的人拉入^0000cd其中的世界^000000。";
		next;
		mes "[Mojo]";
		mes "所以我才那么想看看笔记本。我想知道它如何容纳一个世界，以及为什么现在才被发现。";
		npctalk "所以请让我看看。弄清楚后我会还给你。", "Mojo#ilgf", bc_self;
		next;
		mes "[Grimm]";
		mes "法师，你别插手！这本笔记本会把人带到未知的地方。而入口就在最后一页。";
		npctalk "哦，你现在甚至懒得叫我的名字了。", "Mojo#ilgf", bc_self;
		next;
		mes "[Grimm]";
		mes "我检查过，没有发现恶意意图。我认为它的主人只是^0000cd需要帮助完成未竟之事^000000。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "所以你们是在争论谁该去那个地方？";
		next;
		mes "[Grimm]";
		mes "不。我小组的其他成员和两名法师已经在那里了，只是还没有回来。";
		npctalk "所以我说了，我会把他们带回来。我比看起来更强，可以独自完成。", "Mojo#ilgf", bc_self;
		sleep2 500;
		npctalk "不，我宁愿等他们回来。";
		next;
		select("我去怎么样？");
		mes "[Grimm]";
		mes "你？嗯，你比这位小姐可靠，但你确定吗？";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "我想报答你治好了我。而且听了你们双方的话，我觉得还是我去比较好。要我把你的同伴带回来吗？";
		next;
		mes "[Grimm]";
		mes "不。我只希望你^0000cd找到他们^000000并确认他们平安。如果他们需要帮助，请帮助他们。如果他们有话带给我，请告诉我。";
		npctalk "带我一起去！", "Mojo#ilgf", bc_self;
		next;
		mes "[Grimm]";
		mes "我也想和你一起去，但我的小组需要我留在这里。";
		npctalk "*瞥了莫乔一眼*";
		sleep2 500;
		npctalk "你为什么盯着我？", "Mojo#ilgf", bc_self;
		next;
		mes "[Grimm]";
		mes "我不能把笔记本交给她。如果发生什么事，里面的人可能无法回来。";
		next;
		emotion ET_ANGER, getnpcid(0, "Mojo#ilgf");
		mes "[Mojo]";
		mes "够了！格林神父，放下那本书。我们来战斗！";
		sleep2 500;
		npctalk "*哼* 我为什么要那么做？你只会带着它逃跑。";
		next;
		mes "[Mojo]";
		mes "那我要和冒险者一起去！";
		next;
		mes "[Grimm]";
		mes "不行。你留在我身边。别碰那本书。";
		next;
		emotion ET_CRY, getnpcid(0, "Mojo#ilgf");
		mes "[Mojo]";
		mes "你为什么这样对我？我对你做了什么？";
		next;
		mes "[Grimm]";
		mes "乔乔哥哥让我绝不能让你碰这本书。你不记得了吗？";
		npctalk "他真的很担心你。";
		next;
		mes "[Mojo]";
		mes "不，我不记得。宝石姐姐回来后，我要告你的状！";
		npctalk "你尽管去。";
		next;
		mes "[Grimm]";
		mes "现在，冒险者。准备好后告诉我。";
		erasequest 14654;// Detailed Account 03
		setquest 14655;// I'm Ready
		ill_vampire = 4;
		close;
	}
	if (ill_vampire < 15) {
		mes "[Grimm]";
		mes "要进入笔记本吗？准备好了吗？";
		next;
		if (select( "是。送我进去。", "不。" ) == 2) {
			mes "[Grimm]";
			mes "没问题。准备好后告诉我。";
			close;
		}
		mes "[Grimm]";
		mes "那么，让我打开它。";
		next;
		mes "我把手放在笔记本上，格林神父将它翻到最后一页。突然我的视线变得模糊，身体仿佛被传送到了某处。";
		if (ill_vampire == 4) {
			erasequest 14655;// I'm Ready
			setquest 14656;// Finding Father Grimm's Colleagues
			ill_vampire = 5;
		}
		close2;
		warp "gef_d01_i",114,216;
		end;
	}
	if (ill_vampire == 15) {
		mes "[Grimm]";
		mes "听我的，否则你随时可以回塔里。";
		next;
		emotion ET_MERONG, getnpcid(0, "Mojo#ilgf");
		mes "[Mojo]";
		mes "不！";
		next;
		select("你们两个还在争吵吗？");
		mes "[Mojo]";
		mes "啊，你回来了！那里怎么样？";
		next;
		mes "[Grimm]";
		mes "很高兴你平安回来。里面的人都还好吗？";
		npctalk "请快告诉我们。我迫不及待想知道！", "Mojo#ilgf", bc_self;
		next;
		mes "我向格林神父和莫乔转述了笔记本世界里发生的事，并告诉他们其他人决定留下监视吸血鬼。";
		next;
		emotion ET_SPARK, getnpcid(0, "Mojo#ilgf");
		mes "[Mojo]";
		mes "哇，同一个地方却位于另一个存在层面！我以前从没听说过！它是怎么运作的？这本笔记本一定与此有关。";
		next;
		mes "[Mojo]";
		mes "还有理解人类的吸血鬼？天哪！";
		next;
		mes "[Mojo]";
		mes "我不能留在这里。格林神父，我必须进去。请让我去！";
		npctalk "把笔记本给我。", "Mojo#ilgf", bc_self;
		next;
		mes "[Grimm]";
		mes "不，绝不。别伸手乱碰。";
		npctalk "啊！你为什么这么固执？我不该遭受这种待遇！", "Mojo#ilgf", bc_self;
		next;
		mes "[Grimm]";
		mes "冒险者，谢谢你替我们进入那个神秘的地方。如果你能去看望我的同伴，偶尔带回他们的消息，我会非常感激。";
		next;
		mes "[Mojo]";
		mes "我也能做到，你知道的。只要给我一个机会！";
		npctalk "莫乔妹妹，请别插手。", "", bc_self;
		next;
		mes "[Grimm]";
		mes "冒险者，谢谢你。如果想^0000cd再次进入笔记本^000000，随时来找我。";
		completequest 14666;// Warden's Role
		getexp 2000000,2000000;
		ill_vampire = 16;
		getitem 25271,5;// Illusion Stone
		close;
	}
	if (ill_vampire == 16) {
		mes "[Grimm]";
		mes "冒险者，要进入笔记本吗？";
		next;
		if (select( "是。", "不。" ) == 2) {
			mes "[Grimm]";
			mes "没问题。准备好后告诉我。";
			close;
		}
		mes "[Grimm]";
		mes "祝你好运。";
		close2;
		warp "gef_d01_i",114,216;
		end;
	}
	end;

OnInit:
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "ill_vampire == 0 && BaseLevel >= 130" );
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "isbegin_quest(14666) == 1" );
	end;
}

gef_d01_i,94,133,0	script	#illcon01	HIDDEN_WARP_NPC,5,5,{
	end;
OnTouch:
	if (ill_vampire == 5) {
		if (strnpcinfo(0) == "#ilgf01")
			specialeffect2 EF_BIG_PORTAL;
	}
	else if (ill_vampire == 6) {
		.@char_id = getcharid(0);
		cloakoffnpcself( "Priest#ilgf01" );
		for ( .@i = 3; .@i < 10; ++.@i )
			cloakoffnpcself( "Marina#ilgf0" + .@i );
	}
	else if (ill_vampire == 7) {
		.@char_id = getcharid(0);
		cloakoffnpcself( "Undead#ilgf06" );
		cloakoffnpcself( "Wizard#ilgf06" );
		cloakoffnpcself( "Wizard#ilgf07" );

		cloakoffnpcself( "Wizard#ilgf08" );
		cloakoffnpcself( "Nameless Catacomb#ilgf01" );

		cloakoffnpcself( "Wizard#ilgf09" );
		cloakoffnpcself( "Wizard#ilgf10" );

		cloakoffnpcself( "Wizard#ilgf11" );

		cloakoffnpcself( "Wizard#ilgf12" );
		cloakoffnpcself( "Wizard#ilgf13" );
		cloakoffnpcself( "Nameless Catacomb#ilgf02" );

		cloakoffnpcself( "Wizard#ilgf14" );
		cloakoffnpcself( "Wizard#ilgf15" );
		cloakoffnpcself( "Nameless Catacomb#ilgf03" );

		cloakoffnpcself( "Wizard#ilgf16" );
		cloakoffnpcself( "Wizard#ilgf17" );

		cloakoffnpcself( "Wizard#ilgf18" );
		cloakoffnpcself( "Someone's Dream#ilgf18" );

		cloakoffnpcself( "Wizard#ilgf19" );
		cloakoffnpcself( "Wizard#ilgf20" );
		cloakoffnpcself( "Undead#ilgf05" );

		cloakoffnpcself( "Undead#ilgf02" );
		cloakoffnpcself( "Undead#ilgf03" );
		cloakoffnpcself( "Undead#ilgf04" );
		cloakoffnpcself( "Wizard#ilgf21" );
		cloakoffnpcself( "Wizard#ilgf22" );

		cloakoffnpcself( "Wizard#ilgf23" );
		cloakoffnpcself( "Fast Undead#ilgf01" );

		cloakoffnpcself( "Wizard#ilgf24" );
		cloakoffnpcself( "Shining Mushroom#ilgf01" );

		cloakoffnpcself( "Wizard#ilgf25" );
		cloakoffnpcself( "Wizard#ilgf26" );
		cloakoffnpcself( "Undead#ilgf01" );

		cloakoffnpcself( "Wizard#ilgf27" );
		cloakoffnpcself( "Wizard#ilgf28" );
	}
	else if (ill_vampire == 10) {
		cloakoffnpcself( "Dracula#ilgf02" );
		cloakoffnpcself( "King#ilgf01" );
		cloakoffnpcself( "Wizard#ilgf02" );
	}
	else if (ill_vampire == 12 || ill_vampire == 13) {
		.@char_id = getcharid(0);
		cloakoffnpcself( "Gem#ilgf02" );
		cloakoffnpcself( "Marina#ilgf02" );
		cloakoffnpcself( "Antoine#ilgf02" );
		if (ill_vampire == 13) {
			cloakoffnpcself( "Dracula#ilgf03" );
			cloakoffnpcself( "King#ilgf02" );
			cloakoffnpcself( "Jojo#ilgf01" );
		}
	}
	if (ill_vampire > 13) {
		cloakoffnpcself( "King#ilgf01" );
		cloakoffnpcself( "Wizard#ilgf02" );
		cloakoffnpcself( "Dracula#ilgf02" );
	}
	end;
}

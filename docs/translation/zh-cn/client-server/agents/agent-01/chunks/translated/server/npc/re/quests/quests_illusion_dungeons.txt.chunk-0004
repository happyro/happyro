gef_d01_i,112,228,5	script	Marina#ilgf01	4_F_MONK,{
	mes "[Marina]";
	mes "要离开吗？";
	next;
	if (select( "是。", "不。" ) == 2) {
		mes "[Marina]";
		mes "我明白了。想离开时告诉我。";
		close;
	}
	mes "[Marina]";
	mes "你这么急着离开，发生什么事了吗？";
	close2;
	warp "gef_dun01",133,219;
	end;
}

gef_d01_i,116,228,3	script	Antoine#ilgf01	4_GEFFEN_01,{
	if (checkweight(501,1) == 0 || (MaxWeight - Weight) < 1000) {
		mes "[Antoine]";
	mes "你确定能带走那么多东西吗？为什么不减轻负重？";
		close;
	}
	if (ill_vampire < 6) {
		mes "[Antoine]";
	mes "宝石姐姐，请听我说！";
		close;
	}
	if (ill_vampire == 6) {
		mes "[Antoine]";
	mes "我担心那两个人。他们应该没事，对吧？";
		close;
	}
	if (ill_vampire == 7) {
		mes "[Antoine]";
	mes "你找到乔乔了吗？他在哪里？朱比莉去治疗他的伤口了。";
		close;
	}
	if (ill_vampire < 16) {
		mes "[Antoine]";
	mes "这里有这么多想研究的东西，我都不知道从哪里开始。天哪，看看那只梦魇！";

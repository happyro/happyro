//===== rAthena Script =======================================
//= Treasure Hunter Quests
//===== By: ==================================================
//= Fredzilla
//===== Current Version: =====================================
//= 1.4
//===== Compatible With: =====================================
//= rAthena Project
//===== Description: =========================================
//= Start for Treasure hunter quests
//===== Additional Comments: =================================
//= Event_THQS - Used to check if you have already registered
//= #Treasure_Token - used to keep track of tokens
//= 1.0 - Straight conversionof Aegis NPC file
//= 1.1 Added time penalty to prevent get quests to often [Lupus]
//= 1.2 Fixed not working penalty, added anti-cheat [Lupus]
//= 1.3 Changed some bad RGB Codes. (bugreport:211) [Samuray22]
//= 1.4 Fixed typos. (bugreport:2607) [Kisuka]
//============================================================

yuno_in01,112,151,6	script	Quest Manager	62,{
	mes "[寻宝者公会成员]";
	mes "欢迎来到寻宝者公会，"+strcharinfo(0)+"。";
	next;
	if (On_Quest == 0) goto N_NewQuest;
		mes "[寻宝者公会成员]";
	mes "听着，"+strcharinfo(0)+"，一次只能接一个任务，除非放弃，否则应该完成任务。";
	mes "放弃任务会损失 ^FF00002500 Zeny^000000。";
	next;
	menu "不，我绝不会放弃任务！",-,"是的，我太没用了……支付 2500 Zeny",N_PayZeny;
			mes "[寻宝者公会成员]";
	mes "很好，回去继续努力吧。";
	close;
N_PayZeny:
	if (Zeny < 2500) goto N_ZenyFail;
	set one_qset, 0;
	set two_qset, 0;
	set three_qset, 0;
	set four_qset, 0;
	set five_qset, 0;
	set six_qset, 0;
	set seven_qset, 0;
	set eight_qset, 0;
	set nine_qset, 0;
	set ten_qset, 0;
	set On_Quest, 0;
	set Zeny,Zeny-2500;
	//add time delay penalty. You can get another quest after 2 - 3 hours. [Lupus]
	set #THQ_DELAY, (GetTime(DT_YEAR)*12*31*24+GetTime(DT_MONTH)*31*24+GetTime(DT_DAYOFMONTH)*24+GetTime(DT_HOUR)+rand(2,3));
	mes "[寻宝者公会成员]";
	mes "看到有人放弃任务真令人难过……";
	mes "你应该感到羞愧。";
	emotion ET_ANGER;
	close;

N_ZenyFail:
		mes "[寻宝者公会成员]";
	mes "真可悲，你连 ^FF00002500 Zeny^000000 都没有。";
	close;

N_NewQuest:
	if (Event_THQS == 0) goto N_Signup;
	//checking if time penalty is over [Lupus]
	if (#THQ_DELAY > (GetTime(DT_YEAR)*12*31*24 + GetTime(DT_MONTH)*31*24 + GetTime(DT_DAYOFMONTH)*24 + GetTime(DT_HOUR)) ) goto L_NoQuestsForYet;
			mes "[寻宝者公会成员]";
	mes "啊，欢迎寻宝者同伴。";
	mes "你目前有 ^FF0000"+#Treasure_Token+"^000000 个寻宝代币！！！";
	mes "想让我给你分配任务吗？";
	next;
	menu "是的，请给我任务。",-,"抱歉，今天没时间。",N_NoTime;
	
	mes "[寻宝者公会成员]";
	mes "好，让我看看今天能给你什么任务。";
	mes "^FF0000这种颜色^000000的任务名表示难度更高，但奖励更好。";
	next;
	set #THQ_DELAY,(GetTime(DT_YEAR)*12*31*24+GetTime(DT_MONTH)*31*24+GetTime(DT_DAYOFMONTH)*24+GetTime(DT_HOUR) + 1); //you can get another quest after 1 hour [Lupus]
	emotion ET_BEST;
	if(@treasure_job==0) set @treasure_job,rand(1,10); //doesn't allow cheaters to pick any quest they want
	if(@treasure_job==2) goto N_JobList2;
	if(@treasure_job==3) goto N_JobList3;
	if(@treasure_job==4) goto N_JobList4;
	if(@treasure_job==5) goto N_JobList5;
	if(@treasure_job==6) goto N_JobList6;
	if(@treasure_job==7) goto N_JobList7;
	if(@treasure_job==8) goto N_JobList8;
	if(@treasure_job==9) goto N_JobList9;
	if(@treasure_job==10) goto N_JobList10;
	goto N_JobList1; //if(@treasure_job==1)

N_NoTime:
		mes "[寻宝者公会成员]";
	mes "好吧，也许下次吧，"+strcharinfo(0)+"。";
	emotion ET_SCRATCH;
	close;

N_Signup:
			mes "[寻宝者公会成员]";
	mes "恐怕你必须先登记加入公会，才能执行任务！";
	emotion ET_SORRY;
	close;

L_NoQuestsForYet:
	mes "[寻宝者公会成员]";
	mes "恐怕现在还没有适合你的任务。";
	mes "请在 "+ (#THQ_DELAY - (GetTime(DT_YEAR)*12*31*24+GetTime(DT_MONTH)*31*24+GetTime(DT_DAYOFMONTH)*24+GetTime(DT_HOUR)) )+" 小时后再来。";
	emotion ET_SORRY;
	close;

L_QuestGiven:
	set On_Quest,1;
	set @treasure_job,0; //next time u get random quest
	close;

///////Job list 1///////
N_JobList1:
		mes "[寻宝者公会成员]";
	mes "好，这里有几个可以完成的任务。";
	next;
	menu "迷路的老人。",-,"主人需要弓。",N_MasterBow,"悬赏名单。",N_HitList,"^FF0000悲伤的寡妇。^000000",N_SadWidow;
			mes "[寻宝者公会成员]";
	mes "^FF0000迷路的老人^000000";
	mes "^FF0000------------^000000";
	mes "这是个简单但报酬不高的任务。";
	mes " ";
	mes "一位妻子来请我们寻找丈夫，她似乎经常来，反复请求我们寻找他。";
	next;
	mes "[寻宝者公会成员]";
	mes "但他似乎总在同一个地方，不用怎么找，去普隆德拉西 1、北 1 的山里看看。";
	set one_qset,1;
	goto L_QuestGiven;

N_MasterBow:
		mes "[寻宝者公会成员]";
	mes "^FF0000主人需要弓^000000";
	mes "^FF0000--------------------^000000";
	mes "只是一次包裹投递，没什么大不了的。";
	mes " ";
	mes "把这个交给帕扬外弓箭手村的弓箭手。";
	getitem 1072,1; //Delivery_Box
	set one_qset,2;
	goto L_QuestGiven;

N_HitList:
			mes "[寻宝者公会成员]";
	mes "^FF0000悬赏名单^000000";
	mes "^FF0000------------^000000";
	mes "这个任务能让你体验战斗。";
	mes " ";
	mes "有位农夫的庄稼一直被 ^FF0000盗虫、波利和疯兔^000000 吃掉。这是需要你完成的清单。他在普隆德拉东边等你。";
	next;
	mes "[寻宝者公会成员]";
	mes "去东边狠狠教训那些小混蛋吧。完成清单后直接丢掉，但不会再得到另一份！";
	set one_qset,3;
	goto L_QuestGiven;

N_SadWidow:
	mes "^FF0000悲伤的寡妇^000000";
	mes "^FF0000*************^000000";
	mes "这是另一个可能报酬不错的任务。";
	mes " ";
	mes "普隆德拉有位年长寡妇，丈夫最近死于怪物袭击。她请求公会成员到普隆德拉墓地和她谈谈。";
	set one_qset,4;
	goto L_QuestGiven;

///////Job list 2///////
N_JobList2:
		mes "[寻宝者公会成员]";
	mes "好，这里有几个可以完成的任务。";
	next;
	menu "奇怪的信",-,"给杰拉米亚的拳刃",N_JurJeramiah,"养蜂人的蜂蜜",N_BeeHunny,"^FF0000流浪汉^000000",N_WanderMan;

	mes "^FF0000奇怪的信^000000";
	mes "^FF0000------------------^000000";
	mes "我对这个任务了解不多。";
	mes " ";
	mes "昨天有个怪人来这里，让我把这封 ^FF0000奇怪的信^000000 交给梦罗克的一位女士。我们不会多问，所以由你负责投递。";
	mes "那位女士在梦罗克，名叫艾丽卡。";
	getitem 1072,1; //Delivery_Message
	set two_qset, 1;
	goto L_QuestGiven;

N_JurJeramiah:
	mes "^FF0000给杰拉米亚的拳刃^000000";
	mes "^FF0000----------------^000000";
	mes "标准投递任务。";
	mes " ";
	mes "杰拉米亚向武器店订购了特殊拳刃。你的任务是把它送到刺客神殿。";
	getitem 1998,1; //Jeramiah's_Jur
	set two_qset,2;
	goto L_QuestGiven;

N_BeeHunny:
	mes "^FF0000养蜂人的蜂蜜^000000";
	mes "^FF0000-----------------^000000";
	mes "沼泽里的怪人需要你的帮助。";
	mes " ";
	mes "普隆德拉^FF0000南 1、西 1^000000 的森林里有个怪人，他需要你的帮助。";
	set two_qset,3;
	goto L_QuestGiven;

N_WanderMan:
	mes "^FF0000流浪者^000000";
	mes "^FF0000**************^000000";
	mes "帕扬有位女士急需帮助。";
	mes " ";
	mes "帕扬有位叫莫莉的女士，请尽快去找她。她寄来的信听起来像有人要杀她。";
	set two_qset,4;
	goto L_QuestGiven;

///////Job list 3///////
N_JobList3:
			mes "[寻宝者公会成员]";
	mes "好，这里有几个可以完成的任务。";
	next;
	menu "该死的小妖精！",-,"包裹投递",N_Delivery1,"普隆德拉下水道",N_ProntCulvert,"^FF0000煤矿麻烦^000000",N_CoalMine;
	mes "^FF0000该死的小妖精！^000000";
	mes "^FF0000------------^000000";
	mes "你去过地狱吗？";
	mes " ";
	mes "^FF0000蚂蚁地狱^000000外有个人想见你，建议你快点过去。";
	set three_qset,1;
	goto L_QuestGiven;

N_Delivery1:
	mes "^FF0000包裹投递^000000";
	mes "^FF0000----------------^000000";
	mes "标准投递任务。";
	mes " ";
	mes "这个任务需要把神秘箱子交给 ^FF0000位于艾尔帕兰和朱诺之间桥上的弗兰克^000000。";
	getitem 1082,1; //Delivery_Box_
	set three_qset,2;
	goto L_QuestGiven;

N_ProntCulvert:
	mes "^FF0000普隆德拉下水道^000000";
	mes "^FF0000----------------^000000";
	mes "虫子，到处都是！";
	mes " ";
	mes "^FF0000普隆德拉下水道^000000失控了！报名成为志愿者，清理部分下水道。";
	next;
	mes "我知道它们似乎无穷无尽，但你杀得越多就越有帮助。报名后，下水道里会有骑士给你任务。";
	set three_qset,3;
	goto L_QuestGiven;

N_CoalMine:
	mes "^FF0000煤矿的麻烦^000000";
	mes "^FF0000************************^000000";
	mes "卢恩-米德加尔特的乐趣……呃……麻烦从不会停止。";
	mes " ";
	mes "最近煤矿发生了事故。一个巨大裂缝释放出一些不死族邪恶德鲁伊。";
	next;
	mes "邪恶德鲁伊开始把工人变成不死族。我们不知道原因，也不想知道。请联系煤矿外叫鲁道夫的人。";
	set three_qset,4;
	goto L_QuestGiven;

///////Job list 4///////
N_JobList4:
	mes "[寻宝者公会成员]";
	mes "好，这里有几个可以完成的任务。";
	next;
	menu "僵尸袭击",-,"神秘巫师",N_MWizard,"糟糕！",N_Shoot,"^FF0000神石^000000",N_Emp;
	mes "^FF0000僵尸袭击^000000";
	mes "^FF0000-------------^000000";
	mes "不死族入侵了帕扬洞穴！";
	mes " ";
	mes "我记得帕扬洞穴曾经很安全，但现在被不死僵尸占据了！请联系^FF0000帕扬洞穴外的弗洛拉^000000并帮助她。";
	set four_qset,1;
	goto L_QuestGiven;

N_MWizard:
	mes "^FF0000神秘巫师^000000";
	mes "^FF0000-------------^000000";
	mes "必须把法杖原型交给巫师泽德。";
	mes " ";
	mes "巫师泽德想试用一把未命名的新法杖原型。你的任务是把它交给他。泽德通常在朱诺附近活动。";
	getitem 1999,1; //Zed's_Staff
	set four_qset,2;
	goto L_QuestGiven;

N_Shoot:
	mes "^FF0000糟糕！^000000";
	mes "^FF0000----------^000000";
	mes "一个小女孩遇到了麻烦。";
	mes " ";
	mes "一个叫达茜的小女孩遇到麻烦，她在^FF0000普隆德拉喷泉东边^000000。";
	set four_qset,3;
	goto L_QuestGiven;

N_Emp:
	mes "^FF0000神石^000000";
	mes "^FF0000********^000000";
	mes "这是个奇怪的任务，我了解不多。";
	mes " ";
	mes "^FF0000普隆德拉公会大厅^000000有人要求见我们的成员，他叫齐霍尔。";
	set four_qset,4;
	goto L_QuestGiven;

///////Job list 5///////
N_JobList5:
		mes "[寻宝者公会成员]";
	mes "好，这里有几个可以完成的任务。";
	next;
	menu "荒野之地",-,"金字塔第一部分",N_PyrPRT1,"先想清楚",N_Thinkfirst,"^FF0000不太友好的幽灵^000000",N_Ghost;
	mes "^FF0000荒野之地^000000";
	mes "^FF0000-----------^000000";
	mes "对有些人简单，对另一些人非常困难。";
	mes " ";
	mes "一个叫利辛的人想给你任务，你可以在普隆德拉北面的^FF0000隐藏神殿^000000里找到他。";
	set five_qset,1;
	goto L_QuestGiven;

N_PyrPRT1:
	mes "^FF0000金字塔第一部分^000000";
	mes "^FF0000---------^000000";
	mes "很有趣，因为没人知道这些东西究竟是怎么造出来的。";
	mes " ";
	mes "据说金字塔开始出现不死族活动。金字塔外有人在等你。他没有留下名字，但要求你尽快前往。";
	set five_qset,2;
	goto L_QuestGiven;

N_Thinkfirst:
	mes "^FF0000先想清楚^000000";
	mes "^FF0000--------------^000000";
	mes "听起来又是那种迷糊女孩的任务……";
	mes " ";
	mes "吉芬附近的金发女孩达茜要你把这些花送给她。我不明白为什么有人会给自己送花……";
	getitem 744,1; //Bouquet
	set five_qset,3;
	goto L_QuestGiven;

N_Ghost:
	mes "^FF0000不太友好的幽灵^000000";
	mes "^FF0000*************************^000000";
	mes "没人说过卡斯珀私下里是个好人。";
	mes " ";
	mes "吉芬塔 3 楼的巫师想和你谈谈城市地下的古代遗迹。";
	set five_qset,4;
	goto L_QuestGiven;

///////Job list 6///////
N_JobList6:
			mes "[寻宝者公会成员]";
	mes "好，这里有几个可以完成的任务。";
	next;
	menu "给盗贼的包裹",-,"金字塔第二部分",N_PyrPRT2,"特殊投递",N_Delivery2,"^FF0000吉芬尼亚^000000",N_Gef;
	mes "^FF0000给盗贼的包裹^000000";
	mes "^FF0000------------------^000000";
	mes "真讽刺。";
	mes " ";
	mes "把这个箱子送到盗贼公会。";
	getitem 1083,1; //Delivery_Box__
	set six_qset,1;
	goto L_QuestGiven;

N_PyrPRT2:
	mes "^FF0000金字塔第二部分^000000";
	mes "^FF0000----------------^000000";
	mes "这个三角区域又有不死族活动！";
	mes " ";
	mes "和金字塔入口外的人谈谈，他似乎还有另一个任务给你。";
	set six_qset,2;
	goto L_QuestGiven;

N_Delivery2:
	mes "^FF0000特殊投递^000000";
	mes "^FF0000----------------^000000";
	mes "我们大多时候都在运送包裹，这次也没什么不同。";
	mes " ";
	mes "把这个箱子交给路提名叫奇拉赫的小女孩，绝对不要打开！她应该在圣诞老人附近。";
	getitem 1083,1; //Delivery_Box__
	set six_qset,3;
	goto L_QuestGiven;

N_Gef:
	mes "^FF0000吉芬尼亚^000000";
	mes "^FF0000********^000000";
	mes "吉芬的孩子们最近做着奇怪的噩梦。";
	mes " ";
	mes "我们认为吉芬地下的遗迹导致了问题。去吉芬塔内找叫祖祖的巫师接任务。";
	set six_qset,4;
	goto L_QuestGiven;

///////Job list 7///////
N_JobList7:
	mes "[寻宝者公会成员]";
	mes "好，这里有几个可以完成的任务。";
	next;
	menu "苹果汁",-,"投递",N_Delivery3,"^FF0000黄金盗虫^000000",N_GTB,"^FF0000邪恶海盗^000000",N_EvilPirates;
	mes "^FF0000苹果汁^000000";
	mes "^FF0000-----------^000000";
	mes "美味的苹果汁谁能拒绝呢。";
	mes " ";
	mes "普隆德拉广场喷泉北边有个小女孩，去和她谈谈。";
	set seven_qset,1;
	goto L_QuestGiven;

N_Delivery3:
	mes "^FF0000投递^000000";
	mes "^FF0000--------^000000";
	mes "包裹太多，时间太少。";
	mes " ";
	mes "把这个箱子交给艾尔贝塔叫查尔斯的人。";
	getitem 1082,1; //Delivery_Box_
	set seven_qset,2;
	goto L_QuestGiven;

N_GTB:
	mes "^FF0000黄金盗虫^000000";
	mes "^FF0000****************^000000";
	mes "普隆德拉下水道再也不一样了……";
	mes " ";
	mes "据报告，黄金盗虫在下水道底层到处跑。去和下水道里的骑士谈谈。";
	set seven_qset,3;
	goto L_QuestGiven;

N_EvilPirates:
	mes "^FF0000邪恶海盗^000000";
	mes "^FF0000************^000000";
	mes "一艘幽灵船冲上了依斯鲁得外岛的海岸。";
	mes " ";
	mes "一位女刺客在幽灵船外等你，有任务交给你。据报告，邪恶的不死海盗潜伏在船内。";
	set seven_qset,4;
	goto L_QuestGiven;

///////Job list 8///////
N_JobList8:
		mes "[寻宝者公会成员]";
	mes "好，这里有几个可以完成的任务。";
	next;
	menu "香蕉汁",-,"另一次投递",N_Delivery4,"我丢失的珠子",N_LostBeeds,"^FF0000巴风特！^000000",N_Bapho;
	mes "^FF0000香蕉汁^000000";
	mes "^FF0000------------^000000";
	mes "有些人觉得恶心，有些人却觉得美味。";
	mes " ";
	mes "普隆德拉广场喷泉北边有个小女孩，去和她谈谈。";
	set eight_qset,1;
	goto L_QuestGiven;

N_Delivery4:
	mes "^FF0000另一次投递^000000";
	mes "^FF0000----------------^000000";
	mes "箱子投递需求很高，懒人太多了。";
	mes " ";
	mes "把这个包裹交给梦罗克叫克莱的人。";
	getitem 1081,1; //Delivery_Box
	set eight_qset,2;
	goto L_QuestGiven;

N_Bapho:
	mes "^FF0000巴风特！^000000";
	mes "^FF0000*********^000000";
	mes "他藏在神殿里，注视并守护着那里。";
	mes " ";
	mes "传闻山羊人潜伏在隐藏神殿里。神殿中还有个叫扎克的人，需要你帮助对付这个名为巴风特的山羊人。";
	set eight_qset,3;
	goto L_QuestGiven;

N_LostBeeds:
	mes "^FF0000我丢失的珠子^000000";
	mes "^FF0000-------------^000000";
	mes "哦，太好了，我闻到了愚蠢的味道……";
	mes " ";
	mes "帕扬有个小女孩想和你谈谈，她叫芙洛尔。真是个蠢名字，哈哈哈。";
	set eight_qset,4;
	goto L_QuestGiven;

///////Job list 9///////
N_JobList9:
			mes "[寻宝者公会成员]";
	mes "好，这里有几个可以完成的任务。";
	next;
	menu "臭箱子",-,"帕扬洞穴",N_PayonC,"^FF0000苏伊到处都是！^000000",N_Sohee,"^FF0000月光花^000000",N_Moonlight;
	mes "^FF0000臭箱子^000000";
	mes "^FF0000----------^000000";
	mes "天啊，请快把这个弄走。";
	mes " ";
	mes "天啊，闻起来像有人死在里面。把它带到吉芬魔法学校，快点，气味熏得我眼睛都疼了！！！";
	getitem 1082,1; //Delivery_Box_
	set nine_qset,1;
	goto L_QuestGiven;

N_Sohee:
	mes "^FF0000苏伊到处都是！^000000";
	mes "^FF0000******************^000000" ;
	mes "嗯……一个叫杰克的人想在弓箭手公会和你谈谈。";
	mes " ";
	mes "我们只知道，帕扬以前发生过一场怪火，烧毁了旧学校。";
	next;
	mes "奇怪的是，里面的孩子似乎没有死于火焰。";
	mes "去和帕扬某处的小女孩谈谈。";
	set nine_qset,2;
	goto L_QuestGiven;

N_Moonlight:
	mes "^FF0000月光花^000000";
	mes "^FF0000****************^000000" ;
	mes "嗯……一个叫杰克的人想在弓箭手公会和你谈谈。";

				mes "[柯肯娜]";
				mes "你把翅膀弄丢了？";
				mes "给，这是我最后一片。";
				mes "快去救那个迷路的孩子！";
				set sign_sq,4;
				getitem 7309,1; //Wing_Of_Crow
				close;
			}
			else {
				mes "[柯肯娜]";
				mes "我刚才不是把翅膀给你了吗？";
				mes "快去救那个困在尼弗尔海姆的可怜孩子！";
				close;
			}
		}
		else if (sign_sq < 6) {
			mes "[柯肯娜]";
			mes "嗯……";
			mes "如果你在尼弗尔海姆没有重要事情要做，";
			mes "最好回到生者的世界……";
			close;
		}
		else if (sign_sq == 6) {
			mes "[柯肯娜]";
			mes "你已经用翅膀救出那个可怜的迷路孩子了吗？";
			next;
			mes "[柯肯娜]";
			mes "什么……？！";
			mes "没有效果？不可能！";
			mes "等等，让我想想。到底哪里出错了？";
			set sign_sq,7;
			close;
		}
		else if (sign_sq == 7) {
			mes "[柯肯娜]";
			mes "好吧。现在我明白翅膀为什么对那个可怜女孩无效了……";
			next;
			mes "[柯肯娜]";
			mes "她太年幼，甚至不知道自己已经死了。";
			mes "真是悲惨，但她没有办法离开这里……";
			set sign_sq,8;
			close;
		}
		else {
			mes "[柯肯娜]";
			mes "当人们不完全了解自己的处境时，就更愿意冒险一试。";
			close;
		}
	}
	else if (sign_q < 88) {
		mes "[柯肯娜]";
		mes "当人们不完全了解自己的处境时，";
		mes "就更愿意冒险一试。";
		close;
	}
	else if (sign_q == 88) {
		if (countitem(2642) > 0) {
		mes "[柯肯娜]";
		mes "正如我所料，这一切背后另有原因。";
		mes "现在你也许知道自己在哪里，但明白死者为何在这里吗？";
			next;
		mes "[柯肯娜]";
		mes "这个世界属于没能证明勇气的战士。";
		mes "记住，你加入他们的行列还不算太迟。";
			next;
		mes "[柯肯娜]";
		mes "尼弗尔海姆由亡者女王统治。";
		mes "她有时会穿着闪亮铠甲巡行。";
		mes "所有看到她的人都会被那威严的形象震慑。";
			next;
			mes "[柯肯娜]";
			mes "现在……我要你向亡者女王索要九界之符。";
			next;
			select("那是什么？");
			mes "[柯肯娜]";
			mes "这个符号代表女王的权威和她统治死者的绝对权利。";
			mes "但现在我还不能解释为什么需要它。";
			next;
			mes "[柯肯娜]";
			mes "你把女王的符号带来后，我会告诉你原因。";
			mes "请保守秘密，不要告诉任何人是我让你带来的。";
			next;
			switch(select("好，我明白了。:我要怎么取得符号？")) {
			case 1:
				set sign_q,89;
				close;
			case 2:
				mes "[柯肯娜]";
				mes "强行夺取符号是不可能的。就连诸神也不会考虑与亡者女王战斗。";
				next;
				mes "[柯肯娜]";
				mes "你必须赢得女王的好感，才有机会得到九界之符。";
				next;
				mes "[柯肯娜]";
				mes "传闻亡者女王正在寻找失踪的母亲安格尔波达。";
				mes "如果你能找到安格尔波达被封印的地方……";
				next;
				mes "[柯肯娜]";
				mes "以后想见我，就走这座城堡二楼肖像右侧的^FF0000秘密通道^000000，"+strcharinfo(0)+"。";
				set sign_q,92;
				next;
				mes "[柯肯娜]";
				mes "如果你通过钢琴来找我，我可能会把你误认为需要引导离开尼弗尔海姆的人类。";
				mes "所以别忘了使用那条通道。";
				close;
			}
		}
		else {
			mes "[柯肯娜]";
			mes "你需要我的帮助吗？我知道我是尼弗尔海姆少数同情凡人的人之一，但我自己也有问题要处理……";
			next;
			switch(select("没事，抱歉！:发生了什么……？")) {
			case 1:
			mes "[柯肯娜]";
				mes "...";
				mes "哼……";
				emotion ET_HNG;
				close;
			case 2:
				mes "[柯肯娜]";
				mes "最近我发现两本法术书不见了。";
				mes "里面有些威力强大的法术，落入无能之手可能造成灾难……";
				next;
				mes "[柯肯娜]";
				mes "我很确定它们是被偷的。";
				mes "如果你能从小偷那里帮我取回，我会非常感激。";
				mes "这样我就能专心帮助你了。";
				next;
				mes "[柯肯娜]";
				mes "还有，下次来见我时，请使用城堡二楼肖像右侧的通道。";
				set sign_q,90;
				close;
			}
		}
	}
	else if (sign_q == 89) {
		mes "[柯肯娜]";
		mes "……嗯？你有什么要问我的吗？";
		next;
		select("我要怎么取得符号？");
		mes "[柯肯娜]";
		mes "强行夺取符号是不可能的。就连诸神也不会考虑与亡者女王战斗。";
		next;
		mes "[柯肯娜]";
		mes "你必须赢得女王的好感，才有机会得到九界之符。";
		next;
		mes "[柯肯娜]";
		mes "传闻亡者女王正在寻找失踪的母亲安格尔波达。";
		mes "如果你能找到安格尔波达被封印的地方……";
		next;
		mes "[柯肯娜]";
		mes "以后想见我，就走这座城堡二楼肖像右侧的通道。";
		set sign_q,92;
		close;
	}
	end;
}

que_sign01,45,227,4	script	Queen of the Dead	856,{
	callfunc "F_UpdateSignVars";
	mes "[地狱女士]";
	if (sign_q < 117) {
		mes "^8C1717你想在没有邀请的情况下觐见亡者女王？无礼的凡人！回到你该去的地方！^000000";
		close2;
		percentheal -100,0;
		end;
	}
	else if (sign_q == 117) {
		mes "^8C1717甘格拉蒂告诉我，你就是引导母亲灵魂来到我身边的凡人。^000000";
		next;
		mes "[地狱女士]";
		mes "^8C1717不要害怕我，米德加尔特的英雄。";
		mes "你赢得了亡者女王的好感，可以向我请求任何合理的奖励。^000000";
		next;
		select("九界之符……");
		mes "[地狱女士]";
		mes "^8C1717真正的九界之符不能随意赠送或借出。";
		mes "不过我感受到了你的目的，会给你一个只够使用一次的符号。^000000";
		next;
		mes "[地狱女士]";
		mes "^8C1717用我给你的符号，你可以命令死者执行你的意志。";
		mes "不过记住，使用一次后它的力量就会耗尽。^000000";
		next;
		mes "[地狱女士]";
		mes "^8C1717我还决定授予你一项特别许可。";
		mes "勇敢的英雄，你现在可以自由取用我宅邸喷泉里的水。^000000";
		next;
		mes "^3355FF你获得了九界之符。^000000";
		delitem 7307,1; //Whisper_Of_Soul
		set sign_q,118;
		getitem 7305,1; //Authority_Of_Nine_World
		close;
	}
	else if (sign_q < 142) {
		mes "^8C1717你好，凡人。务必明智地使用符号的力量。";
		mes "你必须承担由此产生的后果……^000000";
		close;
	}
	else if (sign_q == 142) {
		mes "^8C1717啊。你就是叫"+strcharinfo(0)+"的凡人，对吧？";
		mes "没错，我知道你。^000000";
		next;
		mes "[地狱女士]";
		mes "^8C1717我一直想见你，因为我感受到你身上有某种熟悉的东西。";
		mes "你是否持有特别的物品？^000000";
		next;
			switch(select("神之符:哭泣星光")) {
		case 1:
			mes "[地狱女士]";
			mes "^8C1717神之符……？嗯，不是我感受到的东西。";
			mes "实际上是完全不同的东西……^000000";
			close;
		case 2:
			mes "[地狱女士]";
			mes "^8C1717没错，就是它！";
			mes "我没想到凡人会持有如此有趣的神器。^000000";
			next;
			mes "[地狱女士]";
			mes "^8C1717作为尼弗尔海姆的女王，我命令你把哭泣星光借给我！";
			mes "别害怕，我会很快归还。凡人一定费了很大力气才得到它……^000000";
			next;
			switch(select("请拿去……:不、不！别拿走！")) {
			case 1:
				mes "[地狱女士]";
				mes "^8C1717谢谢你，凡人。现在我会让你看看真正有趣的东西……^000000";
				delitem 7178,1; //Star's_Sob
				set sign_q,143;
				close;
			case 2:
				mes "[地狱女士]";
				mes "^8C1717哈哈哈！你真有趣，凡人！";
				mes "没想到你竟敢拒绝尼弗尔海姆的女王！哈哈哈！^000000";
				next;
				mes "[地狱女士]";
				mes "^8C1717我并不以仁慈闻名，但既然你是我偏爱的凡人，我不会杀你。";
				mes "不过，惹我不高兴可不是明智之举~^000000";
				close2;
				warp "niflheim",29,154;
				end;
			}
		}
	}
	else if (sign_q == 143) {
		mes "^8C1717作为这个世界的女王，我不习惯劳动。";
		mes "不过给我一点时间，让我完成这件无价神器，凡人。^000000";
		next;
		specialeffect EF_GLASSWALL;
		next;
		specialeffect EF_NAPALMBEAT;
		next;
		specialeffect EF_FIREPILLARBOMB;
		next;
		specialeffect EF_LORD;
		next;
		mes "[地狱女士]";
		mes "^8C1717完成了。这就是你们人类称为哭泣星光的物体的真正形态。^000000";
		next;
		set sign_q,144;
		getitem 7025,1; //Lucifer's_Lament
		mes "[地狱女士]";
		mes "^8C1717你们也许称它为神之泪，但请记住，人类所知的历史可能与真相不同。^000000";
		next;
		mes "[地狱女士]";
		mes "^8C1717换句话说，关于诸神及其敌人的古老传说，在代代相传时可能被混淆和扭曲了。^000000";
		next;
		mes "[地狱女士]";
		mes "^8C1717凡人，我现在只能告诉你这些。传说的真相就由你来发现……^000000";
		close;
	}
	else {
		mes "^8C1717你好，凡人。生者的世界就那么无聊乏味吗？";
		mes "哈哈哈！尼弗尔海姆永远会为你保留位置。^000000";
		close;
	}
}

niflheim,146,241,0	script	Depressing Man	735,{
	callfunc "F_UpdateSignVars";
	if (sign_q < 80) {
		mes "[????]";
		mes "别烦我，恶棍！我现在不想交谈。";
		close;
	}
	else if (sign_q < 87) {
		mes "[????]";
		mes "别只根据外表评判别人。试着深入内心，寻找他们心中的真相。";
		close;
	}
	else if (sign_q == 87) {
		if (countitem(2642) > 1) {
			mes "[格恩]";
			mes "你在找什么？一定是克拉尤派你来的。";
			mes "好吧，我们直入主题。";
			next;
			mes "[格恩]";
			mes "那么，你为什么想成为瓦尔基里的选民？";
			next;
			switch(select("证明我的勇气:为了荣誉:帮助他人")) {
			case 1:
				if (sign_sq > 2) set sign_sq,0;
				else set sign_sq,sign_sq+1;
			case 2:
				break;
			}
			mes "[格恩]";
			mes "好吧……克拉尤告诉你我为什么在这里了吗？";
			next;
			switch(select("是:没有")) {
			case 1:
				mes "[格恩]";
				mes "很好，那么你已经知道该做什么了。现在去见尼弗尔海姆的女巫。";
				next;
				mes "[格恩]";
				mes "私下说一句，如果你要和塞琳打交道，务必小心……";
				set sign_q,88;
				close;
			case 2:
			mes "[格恩]";
			mes "你知道，我以前也是冒险者。事实上，我曾为接受诸神的考验来到尼弗尔海姆。";
			mes "然而我失败了，最终被束缚在这个世界……";
				next;

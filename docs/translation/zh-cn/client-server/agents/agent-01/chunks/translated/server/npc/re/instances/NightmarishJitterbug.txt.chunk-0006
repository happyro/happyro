	mes "我不介意良性竞争，但我更喜欢友谊，无论它能维持多久。";
	close3;
}


// Room 18
1@jtb,198,282,5	script	Shaloshi#18	4_F_SHALOSH,{
	if ('room != 18 || is_party_leader() == false) {
		cutin "shaloshi01",0;
		mes "[夏洛希]";
		mes "Ferre 不会咬我。";
		close3;
	}
	if (select( "Talk.", "Hurry." ) == 2 && isbegin_quest(13183) == 2)
		mes "一边赶路一边努力回忆。";
	else {
		.@runane$ = instance_npcname("Runane#18");
		.@roel$ = instance_npcname("Roel#18");

		emotion ET_THINK;
		cutin "shaloshi01",0;
		mes "[夏洛希]";
		mes "洛尔和露安娜受伤了。";
		npctalk "Shaloshi: 洛尔和露安娜受伤了。";
		next;
		cutin "lunain04",2;
		mes "[露安娜]";
		mes "我没事。我不是叫你小心吗，小家伙！";
		npctalk "Runane: 我没事。我不是叫你小心吗，小家伙！", .@runane$;
		next;
		cutin "roel04",0;
		emotion ET_SORRY, getnpcid(0,.@roel$);
		mes "[洛尔]";
		mes "对不起。我不会再让你失望了。";
		npctalk "Roel: 对不起。我不会再让你失望了。", .@roel$;
		next;
		cutin "shaloshi01",0;
		mes "[夏洛希]";
		mes "她虽然不高兴，但对他还是很好。";
		npctalk "Shaloshi: 她虽然不高兴，但对他还是很好。";
		next;
		emotion ET_THROB, getnpcid(0,.@roel$);
		cutin "roel03",0;
		mes "[洛尔]";
		mes "（她真善良！）";
		npctalk "Roel: （她真善良！）", .@roel$;
		next;
		cutin "lunain02",2;
		mes "[露安娜]";
		mes "别把这当成别的什么——只是照看孩子！";
		npctalk "Runane: 别把这当成别的什么——只是照看孩子！", .@runane$;
		next;
		emotion ET_THINK;
		cutin "shaloshi01",0;
		mes "[夏洛希]";
		mes "她脸红了。";
		npctalk "Shaloshi: 她脸红了。";
		next;
		cutin "lunain01",2;
		mes "[露安娜]";
		mes "我一点都不喜欢你。";
		npctalk "Runane: 我一点都不喜欢你。", .@runane$;
		next;
		cutin "shaloshi01",0;
		mes "[夏洛希]";
		mes "在艾古和露安娜之前，";
		npctalk "Shaloshi: 在艾古和露安娜之前，";
		next;
		mes "[夏洛希]";
		mes "Ferre 们先出现了。";
		npctalk "Shaloshi: Ferre 们先出现了。";
		next;
		cutin "roel01",0;
		mes "[洛尔]";
		mes "Ferre？";
		npctalk "Roel: Ferre？", .@roel$;
		next;
		cutin "shaloshi01",0;
		mes "[夏洛希]";
		mes "它们会发出“ferre、ferre”的声音，所以我叫它们 Ferre。";
		npctalk "Shaloshi: 它们会发出“ferre、ferre”的声音，所以我叫它们 Ferre。";
		next;
		mes "[夏洛希]";
		mes "它们只会呱呱叫。";
		npctalk "Shaloshi: 它们只会呱呱叫。";
		next;
		mes "[夏洛希]";
		mes "它们是我的朋友，不会咬我或伤害我。";
		npctalk "Shaloshi: 它们是我的朋友，不会咬我或伤害我。";
		next;
		cutin "roel01",0;
		mes "[洛尔]";
		mes "但现在……";
		npctalk "Roel: 但现在……", .@roel$;
		next;
		cutin "lunain04",2;
		emotion ET_HNG, getnpcid(0,.@runane$);
		mes "[露安娜]";
		mes "听着，人类和怪物不可能成为朋友。至少我是这么想的。";
		npctalk "Runane: 听着，人类和怪物不可能成为朋友。至少我是这么想的。", .@runane$;
		next;
		cutin "shaloshi01",0;
		mes "[夏洛希]";
		mes "不可能成为朋友。";
		npctalk "Shaloshi: 不可能成为朋友。";
		next;
		cutin "lunain03",2;
		mes "[露安娜]";
		mes "没错。你听我的时候我更喜欢你。";
		npctalk "Runane: 没错。你听我的时候我更喜欢你。", .@runane$;
		next;
		cutin "roel03",0;
		mes "[洛尔]";
		mes "那我成为你的朋友怎么样？";
		npctalk "Roel: 那我成为你的朋友怎么样？", .@roel$;
		next;
		emotion ET_SCRATCH, getnpcid(0,.@runane$);
		cutin "lunain02",2;
		mes "[露安娜]";
		mes "别把气氛弄得这么尴尬！我们年纪差不多，已经是朋友了。";
		npctalk "Runane: 别把气氛弄得这么尴尬！我们年纪差不多，已经是朋友了。", .@runane$;
		next;
		cutin "shaloshi03",0;
		mes "[夏洛希]";
		mes "(不可能成为朋友。)";
		npctalk "Shaloshi: (不可能成为朋友。)";
	}
	if ('room == 18 && is_party_leader() == true)
		donpcevent 'jitterbug_main$ + "::OnNextIs19";
	close3;
}

1@jtb,203,281,4	script	Runane#18	4_F_RUNAIN,{
	cutin "lunain02",2;
	mes "[露安娜]";
	mes "真正的朋友不需要宣告友谊，他们会在不知不觉中成为朋友。";
	close3;
}

1@jtb,199,278,8	script	Roel#18	4_M_ROEL,{
	cutin "roel03",0;
	mes "[洛尔]";
	mes "我没事。至少我能保护夏洛希。保护某人的感觉很好。";
	close3;
}


// Room 19
1@jtb,28,377,5	script	Newoz#19	4_M_NEWOZ,{
	if ('room != 19 || is_party_leader() == false) {
		cutin "nines01",0;
		mes "[纽沃兹]";
		mes "我们应该找到她。";
		close3;
	}
	if (select( "Talk.", "Hurry." ) == 2 && isbegin_quest(13183) == 2)
		mes "一边赶路一边努力回忆。";
	else {
		.@aigu$ = instance_npcname("Aigu#19");
		.@mingmin$ = instance_npcname("Mingmin#19");
		.@roter$ = instance_npcname("Roter#19");
		.@melody$ = instance_npcname("Melody-Jack#19");
		.@arang$ = instance_npcname("Arang#19");

		cutin "nines01",0;
		emotion ET_THINK;
		mes "[纽沃兹]";
		mes "奇怪……气氛变了。";
		npctalk "Newoz: 奇怪……气氛变了。";
		next;
		cutin "min02",0;
		mes "[明敏]";
		mes "空气的味道变了，事物看起来也不那么……清晰。";
		npctalk "明敏：空气的气味变了，事物也变得不那么清晰。", .@mingmin$;
		next;
		cutin "rote01",2;
		mes "[罗特尔]";
		mes "看起来像在水下，但我没有这种感觉。";
		npctalk "Roter: 看起来像在水下，但我没有这种感觉。", .@roter$;
		next;
		emotion ET_HUM, getnpcid(0,.@melody$);
		cutin "",255;
		mes "[旋律·杰克]";
		mes "我告诉你们，我们一直在同一个地方兜圈子。";
		npctalk "Melody-Jack: 我告诉你们，我们一直在同一个地方兜圈子。", .@melody$;
		next;
		cutin "min02",0;
		mes "[明敏]";
		mes "我同意。而且这片空地既不狭窄，也不宽敞。";
		npctalk "Mingmin: 我同意。而且这片空地既不狭窄，也不宽敞。", .@mingmin$;
		next;
		cutin "nines01",0;
		mes "[纽沃兹]";
		mes "你觉得继续深入没有意义吗？";
		npctalk "Newoz: 你觉得继续深入没有意义吗？";
		next;
		cutin "min02",0;
		mes "[明敏]";
		mes "不。我只是说环境变化太剧烈了，几乎像躁郁症患者的情绪波动。";
		npctalk "Mingmin: 不。我只是说环境变化太剧烈了，几乎像躁郁症患者的情绪波动。", .@mingmin$;
		next;
		mes "[明敏]";
		mes "不知道为什么，事物正在失去形状，仿佛逐渐消失。";
		npctalk "Mingmin: 不知道为什么，事物正在失去形状，仿佛逐渐消失。", .@mingmin$;
		next;
		emotion ET_THINK, getnpcid(0,.@melody$);
		cutin "",255;
		mes "[旋律·杰克]";
		mes "与此同时，我感知到的异质能量越来越强。这可不妙。";
		npctalk "Melody-Jack: 与此同时，我感知到的异质能量越来越强。这可不妙。", .@melody$;
		next;
		cutin "min02",0;
		mes "[明敏]";
		mes "我感觉有什么东西会伴随着巨响出现在我们眼前。";
		npctalk "Mingmin: 我感觉有什么东西会伴随着巨响出现在我们眼前。", .@mingmin$;
		next;
		cutin "arang02",0;
		mes "[阿朗]";
		mes "希望是强大的怪物！";
		npctalk "Arang: 希望是强大的怪物！", .@arang$;
		next;
		emotion ET_X, getnpcid(0,.@aigu$);
		cutin "igu01",0;
		mes "[艾古]";
		mes "希望你猜错了。";
		npctalk "Aigu: 希望你猜错了。", .@aigu$;
		next;
		cutin "ragi02",2;
		mes "[拉吉]";
		mes "我就先让你们继续……";
		npctalk "Lagi: 我就先让你们继续……", instance_npcname("Lagi#19");
		next;
		cutin "nines02",0;
		mes "[纽沃兹]";
		mes "怪物？";
		npctalk "Newoz: 怪物？";
		next;
		cutin "rote01",2;
		mes "[罗特尔]";
		mes "在怪物出现前，我会先杀了你们两个。";
		npctalk "Roter: 在怪物出现前，我会先杀了你们两个。", .@roter$;
		next;
		cutin "gelca04",2;
		mes "[格尔卡]";
		mes "师父，求你了！";
		npctalk "Gelka: 师父，求你了！", instance_npcname("Gelka#19");
		next;
		cutin "arang02",0;
		mes "[阿朗]";
		mes "你们看到夏洛希了吗？她在哪里？";
		npctalk "Arang: 你们看到夏洛希了吗？她在哪里？", .@arang$;
		next;
		cutin "igu04",0;
		mes "[艾古]";
		mes "哦，你说得对！";
		npctalk "Aigu: 哦，你说得对！", .@aigu$;
		next;
		cutin "min02",0;
		mes "[明敏]";
		mes "...";
		npctalk "Mingmin: ...", .@mingmin$;
		next;
		emotion ET_THINK, getnpcid(0,.@melody$);
		cutin "",255;
		mes "[旋律·杰克]";
		mes "...";
		npctalk "Melody-Jack: ...", .@melody$;
		next;
		cutin "nines03",0;
		mes "[纽沃兹]";
		mes "我们应该找到她。";
		npctalk "Newoz: 我们应该找到她。";
	}
	if ('room == 19 && is_party_leader() == true)
		donpcevent 'jitterbug_main$ + "::OnNextIs20";
	close3;
}


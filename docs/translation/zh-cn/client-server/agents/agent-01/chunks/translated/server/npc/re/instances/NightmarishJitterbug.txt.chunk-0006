		unittalk getcharid(3), "" + strcharinfo(0) + " : You don't even know if I have one.";
		cutin "igu05",0;
		mes "[艾古]";
		mes "哦，抱歉，我都快哭出来了。";
		npctalk "Aigu: 哦，抱歉，我都快哭出来了。", .@aigu$;
		break;
	case 2:
		jitterbug_options &= ~4;
		unittalk getcharid(3), "" + strcharinfo(0) + " : My love is unrequited.";
		cutin "igu01",0;
		mes "[艾古]";
		mes "单相思很痛苦。最好在它伤害你之前放手。";
		npctalk "Aigu: 单相思很痛苦。最好在它伤害你之前放手。", .@aigu$;
		break;
	case 3:
		jitterbug_options |= 4;
		areamonster 'map_jtb$,183,301,220,272, "--ja--", 3108,1;	// no label
		unittalk getcharid(3), "" + strcharinfo(0) + " : We're happy.";
		mes "[艾古]";
		mes "你是认真的吗？连你这样的人都找到爱情了。那我呢？！";
		npctalk "Aigu: 你是认真的吗？连你这样的人都找到爱情了。那我呢？！", .@aigu$;
		break;
	}
	next;
	cutin "igu01",0;
	mes "[艾古]";
	mes "我不介意良性竞争，但我更喜欢友谊，无论它能维持多久。";
	npctalk "Aigu: 我不介意良性竞争，但我更喜欢友谊，无论它能维持多久。", .@aigu$;
	next;
	cutin "",255;
	mes "[露安娜]";
	mes "暂时休战吧。但别误会，只要纽沃兹露出破绽，他就是我的。";
	npctalk "Runane: 暂时休战吧。但别误会，只要纽沃兹露出破绽，他就是我的。", .@runane$;
	next;
	cutin "shaloshi03",0;
	mes "[夏洛希]";
	mes "（朋友……竞争……）";
	npctalk "Shaloshi: （朋友……竞争……）";
	next;
	cutin "igu01",0;
	mes "[艾古]";
	mes "除非我死了！";
	npctalk "Aigu: 除非我死了！", .@aigu$;
	close3;
}


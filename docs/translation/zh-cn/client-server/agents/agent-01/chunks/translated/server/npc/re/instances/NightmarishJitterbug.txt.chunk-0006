	mes "[旋律·杰克]";
	mes "纽沃兹从来不懂得委婉。";
	close;
}

1@jtb,30,373,4	script	Roter#19	4_M_ROTERT,{
	cutin "rote01",0;
	mes "[罗特尔]";

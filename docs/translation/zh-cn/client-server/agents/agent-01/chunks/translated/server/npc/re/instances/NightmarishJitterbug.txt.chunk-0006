	close3;
}

1@jtb,25,373,5	script	Mingmin#19	4_F_GENETIC,{
	cutin "min02",0;
	mes "[明敏]";
	mes "在事情变得失控前，我们最好找出口。";
	close3;
}

1@jtb,24,376,5	script	Aigu#19	4_F_IU,{
	cutin "igu05",0;
	mes "[艾古]";
	mes "纽沃兹对冒险的热情又过头了。不过我不能说我讨厌这一点。";
	close3;
}

1@jtb,26,380,5	script	Arang#19	4_F_TAEKWON,{
	cutin "arang03",0;
	mes "[阿朗]";
	mes "希望这些怪物能像跆拳道任务中的波利一样可爱又无害。";
	close3;
}

1@jtb,31,380,4	script	Lagi#19	4_M_RAGI,{
	cutin "ragi01",0;
	mes "[拉吉]";
	mes "他们总是在争吵，但看起来像好朋友，对吧？";
	close3;
}

1@jtb,33,376,4	script	Gelka#19	4_F_GELKA,{
	cutin "gelca01",0;
	mes "[格尔卡]";
	mes "我努力练习，这样在危险时刻才能大放异彩。";
	close3;
}


// Room 20 (menu affects the boss encounter in the next room)
1@jtb,105,377,5	script	Roel#20	4_M_ROEL,{
	if ('room != 20 || is_party_leader() == false) {
		cutin "roel01",0;
		mes "[洛尔]";
		mes "我的一个朋友曾在伊兹鲁德给我安排过相亲。";
		next;
		mes "[洛尔]";
		mes "我们交换了几封信，第一封互相介绍，第二封约定见面。";
		next;
		cutin "roel04",0;
		mes "[洛尔]";
		mes "她没有回复我的第二封信。我不知道为什么。";
		close3;
	}
	if (select( "Talk.", "Hurry." ) == 2 && isbegin_quest(13183) == 2) {
		mes "一边赶路一边努力回忆。";
		if ('room == 20 && is_party_leader() == true) {
			donpcevent 'jitterbug_main$ + "::OnNextIs21";
			if (jitterbug_options & 8)
				areamonster 'map_jtb$,182,387,219,354, "--ja--", 3108,1;	// no label
		}
		close3;
	}
	.@gelka$ = instance_npcname("Gelka#20");
	cutin "gelca01",2;
	mes "[格尔卡]";
	mes "场景 8：英雄被敌人包围。洛尔，我们来编排今天练习的动作，好吗？";
	npctalk "Gelka: 场景 8：英雄被敌人包围。洛尔，我们来编排今天练习的动作，好吗？", .@gelka$;
	next;
	cutin "roel01",0;
	emotion ET_SURPRISE;
	mes "[洛尔]";
	mes "格尔卡，准备好！";
	npctalk "Roel: 格尔卡，准备好！";
	next;
	emotion ET_COMEON, getnpcid(0,.@gelka$);
	cutin "gelca01",2;
	mes "[格尔卡]";
	mes "格尔卡式精神力量！钢铁体魄！";
	npctalk "Gelka: 格尔卡式精神力量！钢铁体魄！", .@gelka$;
	specialeffect EF_GUMGANG,AREA, .@gelka$;
	next;
	emotion ET_COMEON;
	cutin "roel02",0;
	mes "[洛尔]";
	mes "坚不可摧的防御！洛尔式守护！";
	npctalk "Roel: 坚不可摧的防御！洛尔式守护！";
	specialeffect EF_KEEPING;
	next;
	cutin "gelca01",2;
	mes "[洛尔与格尔卡]";
	mes "交叉！！！";
	npctalk "Gelka: 交叉！！！", .@gelka$;
	npctalk "Roel: 交叉！！！";
	specialeffect EF_POTION_BERSERK;
	specialeffect EF_POTION_BERSERK,AREA, .@gelka$;
	next;
	cutin "roel03",0;
	mes "[洛尔与格尔卡]";
	mes "最后堡垒！";
	npctalk "Roel: 最后堡垒！";
	npctalk "Gelka: 最后堡垒！", .@gelka$;
	specialeffect EF_SHIELDBOOMERANG;
	specialeffect EF_BOTTOM_BASILICA,AREA, .@gelka$;
	specialeffect EF_SHIELDCHARGE;
	specialeffect EF_GLASSWALL,AREA, .@gelka$;
	specialeffect EF_GLASSWALL;
	specialeffect EF_GUARD;
	specialeffect EF_ANGELUS,AREA, .@gelka$;
	specialeffect EF_ANGELUS;
	next;
	cutin "roel03",0;
	mes "[洛尔]";
	mes "天啊，格尔卡，你太棒了！";
	npctalk "Roel: 天啊，格尔卡，你太棒了！";
	if ('room == 20 && is_party_leader() == true)
		donpcevent 'jitterbug_main$ + "::OnNextIs21";
	next;
	cutin "gelca01",2;
	if (select( "确实很棒！", "你只是为了耍帅才编出这些话的！" ) == 1) {
		jitterbug_options &= ~8;
		unittalk getcharid(3), "" + strcharinfo(0) + " : Awesome, indeed!";
		cutin "gelca03",2;
		mes "[格尔卡]";
		mes "我向最优秀的人学到了东西。";
		npctalk "Gelka: 我向最优秀的人学到了东西。", .@gelka$;
		next;
		cutin "roel02",0;
		mes "[洛尔]";
		mes "希望你也能教教我，罗特尔。";
		npctalk "Roel: 希望你也能教教我，罗特尔。";
		next;
		cutin "gelca01",2;
		mes "[格尔卡]";
		mes "特殊技能的关键就在名字。喊出威风的名字就足以震慑敌人。";
		npctalk "Gelka: 特殊技能的关键就在名字。喊出威风的名字就足以震慑敌人。", .@gelka$;
	}
	else {
		jitterbug_options |= 8;
		areamonster 'map_jtb$,182,387,219,354, "--ja--", 3108,1;	// no label
		unittalk getcharid(3), "" + strcharinfo(0) + " : You just made up those words to look cool!";
		cutin "gelca02",2;
		mes "[格尔卡]";
		mes "你真是个扫兴的人，知道吗？";
		npctalk "Gelka: 你真是个扫兴的人，知道吗？", .@gelka$;
		next;
		cutin "roel04",0;
		mes "[洛尔]";
		mes "我们练习得很刻苦。";
		npctalk "Roel: 我们练习得很刻苦。";
		next;
	}
	next;
	cutin "",255;
	mes "- 他们沉浸在讨论新的特殊技能。-";
	close3;

alberta,129,59,3	script	Guildsman#2	49,3,3,{

	if(checkweight(7416,1) != 1)
	{
		mes "^3355FF等一下！";
		mes "你现在携带的物品";
		mes "太多了。请使用卡普拉服务";
		mes "存放一些物品后再回来。^000000";
		close;
	}
	if(!(BaseLevel > 59))
	{
		mes "[Guildsman]";
		mes "你听说了吗？";
		mes "最近梦罗克";
		mes "发生了什么？";
		mes "似乎有大事发生……";
		close;
	}
	if(!(Class == Job_Soul_Linker || BaseClass == Job_Merchant))
	{
		mes "[Guildsman]";
		mes "天啊，这里有这么多";
		mes "商人。";
		mes "哇……希望我能";
		mes "找到要找的人……";
		close;
	}
	if(!mao_request)
	{
		if (Class == Job_Soul_Linker)
		{
			mes "[Guildsman]";
			mes "^71637D站住！";
			mes "我有个提议";
			mes "给你，听好了！^000000";
			mes " ";
			mes "……不，你又来了！";
			mes "该死，滚出我的脑子！";
			next;
			mes "[Guildsman]";
			mes "^71637D闭嘴，这很重要！^000000";
			mes " ";
			mes "不，你闭嘴，这是";
			mes "我的身体！听着，";
			mes "给我一点控制权！";
			next;
			mes "[" + strcharinfo(0) + "]";
			mes "我……我能感觉到";
			mes "你体内有两个不同的灵魂。";
			mes "我不介意听你们说话，";
			mes "但如果你们一直说，";
			mes "我会搞糊涂的……";
			next;
			mes "[Guildsman]";
			mes "好吧，随便。";
			mes " ";
			mes "^71637D好吧，刺客公会";
			mes "公会正在为一项任务";
			mes "寻找外部援助。";
			mes "是非常重要的事。^000000";
			next;
			mes "[Guildman]";
			mes "^71637D他们受某人委托";
			mes "委托人……嗯……你知道的……^000000";
			mes " ";
			mes "……调查失踪的孩子？";
			mes "^71637D对，对，就是这个。^000000";
			next;
			mes "[Guildman]";
			mes "^71637D总之，这是相当";
			mes "重大任务，所以刺客";
			mes "公会正在寻求";
			mes "帮助。我觉得你很适合";
			mes "代表灵魂链接者，";
			mes "所以决定选你。^000000";
			next;
			mes "[Guildsman]";
			mes "^71637D所以，去帮助刺客公会吧！^000000";
			mes " ";
			mes "等等，别忘了";
			mes "推荐信！";
			mes " ";
			mes "^71637D哦，对了！来，拿着这个！^000000";
			set mao_request,1;
			getitem 7416,1;
			next;
			mes "[Guildsman]";
			mes "好了，我按你说的做了。";
			mes "你现在可以离开我的身体了……";
			mes " ";
			mes "^71637D呃，我会考虑的。^000000";
			mes " ";
			mes "不要啊啊啊！求你了～！";
			close;
		}
		else if((BaseJob == Job_Merchant) || (BaseJob == Job_Merchant_High))
		{
			mes "[Guildsman]";
			mes "哎呀，这不是";
			mes ""+ strcharinfo(0) +". Hey,";
			mes "请稍等一下好吗？";
			mes "我有一条消息要给你，";
			mes "来自商人公会。";
			next;
			mes "[Guildsman]";
			mes "我不知道为什么，";
			mes "但刺客公会一直在向";
			mes "商人公会的人请求帮助。";
			mes "你能代表我们去帮助他们吗？";
			next;
			mes "[Guildsman]";
			mes "我想他们是在为";
			mes "某位委托人调查";
			mes "梦罗克失踪的儿童。";
			mes "如果你想帮助他们，";
			mes "就需要这封推荐信，好吗？";
			set mao_request,1;
			getitem 7416,1;
			close;
		}
		else if((Class == Job_Blacksmith) || (Class == Job_Whitesmith))
		{
			mes "[Guildsman]";
			mes "哦，"+ strcharinfo(0) +"……！";
			mes "终于遇到你，我太高兴了。";
			mes "知道这很突然，但铁匠";
			mes "公会在梦罗克有项任务";
			mes "要交给你。";
			next;
			mes "[Guildsman]";
			mes "你看，刺客公会";
			mes "正式请求我们协助";
			mes "调查最近梦罗克";
			mes "失踪的儿童。来，拿着这封推荐信……";
			next;
			mes "[Guildsman]";
			mes "既然刺客公会";
			mes "请求帮助，我毫不怀疑这会是";
			mes "一项非常困难的任务。";
			mes "如果打算参与，";
			mes "你应该做好准备……";
			set mao_request,1;
			getitem 7416,1;
			close;
		}
		else if((Class == Job_Alchemist) || (Class == Job_Creator))
		{
			mes "[Guildsman]";
			mes "嘿，" + strcharinfo(0) + "？";
			mes "我有炼金术士";
			mes "公会给你的消息。";
			mes "嗯，与其说是消息，";
			mes "不如说是命令。";
			mes "真幸运能找到你。";
			next;
			mes "[Guildsman]";
			mes "刺客公会";
			mes "正式请求我们公会";
			mes "协助调查梦罗克";
			mes "失踪儿童的任务，";
			mes "他们希望我们派人……就是你！";
			next;
			mes "[Guildsman]";
			mes "或者……至少，你是";
			mes "炼金术士公会想派出的";
			mes "代表之一。那你为什么不去？";
			mes "为了孩子们。好好想想。";
			next;
			mes "[Guildsman]";
			mes "拿着这封推荐信，";
			mes "尽快前往梦罗克。";
			mes "连刺客公会都需要帮助，";
			mes "肯定意味着大麻烦……";
			set mao_request,1;
			getitem 7416,1;
			close;
		}
	}
	else if(mao_request == 1)
	{
		if (Class == Job_Soul_Linker)
		{
			mes "[Guildsman]";
			mes "^71637D很好，你回来了！这个";
			mes "那家伙一直打断我，";
			mes "让我没法告诉你重要的事。";
			mes " ";
			mes "^000000你在说什么？";
			mes "那是你自己活该！";
			next;
			mes "[Guildsman]";
			mes "^71637D你知道梦罗克里面的绿洲，";
			mes "梦罗克？在那里的西边，";
			mes "你会找到刺客公会的联系人。^000000";
			mes " ";
			mes "就……这样？";
			next;
			mes "[Guildsman]";
			mes "你现在可以离开我的";
			mes "身体了吗？！和你共享身体";
			mes "正在毁掉我的生活！";
			mes " ";
			mes "^71637D好吧。那么我该去哪儿？";
			mes "我要走了吗？你需要我！^000000";
			close;
		}
		else if((BaseJob == Job_Merchant) || (BaseJob == Job_Merchant_High))
		{
			mes "[Guildsman]";
			mes "所以你要代表商人";
			mes "帮助刺客公会？太好了！";
			mes "你可以在梦罗克绿洲";
			mes "西侧的一间小屋旁，";
			mes "与联系人会面。";
			next;
			mes "[Guildsman]";
			mes "嘿，祝你好运，";
			mes "小心点，好吗？";
			mes "我觉得他们交给你的";
			mes "任务背后";
			mes "一定有大事……";
			close;
		}
		else if((Class == Job_Blacksmith) || (Class == Job_Whitesmith))
		{
			mes "[Guildsman]";
			mes "那么，你决定代表铁匠";
			mes "帮助刺客公会了吗？";
			mes "请在梦罗克绿洲西侧";
			mes "与联系人会面。祝你好运～";
			close;
		}
		else if((Class == Job_Alchemist) || (Class == Job_Creator))
		{
			mes "[Guildsman]";
			mes "啊，我差点忘了告诉你，";
			mes "刺客公会的联系人";
			mes "会在梦罗克绿洲";
			mes "西侧等你。";
			next;
			mes "[Guildsman]";
			mes "请尽力帮助";
			mes "刺客公会，";
			mes "代表炼金术士";
			mes "完成任务，";
			mes "并小心麻烦……";
			close;
		}
	}
	else if(((mao_request > 2) && (mao_request < 27)) || ((mao_request > 102) && (mao_request < 125)))
	{
		if (Class == Job_Soul_Linker)
		{
			mes "[Guildsman]";
			mes "^71637D执行任务时要小心……";
			mes "这一切背后一定";
			mes "发生了大事，我知道。";
			mes "留意周围。嗯，祝你好运！";
			close;
		}
		else if((BaseJob == Job_Merchant) || (BaseJob == Job_Merchant_High))
		{
			mes "[Guildsman]";
			mes "你和刺客们合作得";
			mes "还顺利吗？";
			mes "这是好消息，也是我们";
			mes "展示商人力量的好机会！";
			mes "不过，仍要保持警惕。";
			close;
		}
		else if((Class == Job_Blacksmith) || (Class == Job_Whitesmith))
		{
			mes "[Guildsman]";
			mes "我相信你给了刺客们";
			mes "很大帮助。保持警惕：";
			mes "这一切背后似乎有";
			mes "强大的势力……";
			close;
		}
		else if((Class == Job_Alchemist) || (Class == Job_Creator))
		{
			mes "[Guildsman]";
			mes "听说你和刺客们";
			mes "相处融洽，我很高兴。";
			mes "一起合作，我相信无论任务是什么，";
			mes "你们都能完成。";
			close;
		}
	}
	else
	{
		if (Class == Job_Soul_Linker)
		{
			mes "[Guildsman]";
			mes "嘿，是你！";
			mes "看来你完成任务后，";
			mes "那个灵魂就离开了我的身体。";
			mes "我还以为那家伙永远不会走……";
			mes "不管他生前是谁。";
			next;
			mes "[Guildsman]";
			mes "不过，要不是你，";
			mes "那个灵魂永远不会平静，";
			mes "我可能会永远和他困在一起！";
			mes "所以……谢谢你，伙计。";
			close;
		}
		else if((BaseJob == Job_Merchant) || (BaseJob == Job_Merchant_High) || (Class == Job_Blacksmith) || (Class == Job_Whitesmith))
		{
			mes "[Guildsman]";
			mes "天气晴朗宁静，";
			mes "但空气中的寂静";
			mes "让人不安。";
			mes "仿佛……我觉得";
			mes "很快会发生";
			mes "什么不可思议的事，你知道吗？";
			close;
		}
		else if((Class == Job_Alchemist) || (Class == Job_Creator))
		{
			mes "[Guildsman]";
			mes "啊，今天真是好天气……";
			mes "不过有时我希望";
			mes "能发生什么大事，";
			mes "打破这种单调。";
			close;
		}
	}

OnTouch:
	if(checkweight(7416,1) != 1)

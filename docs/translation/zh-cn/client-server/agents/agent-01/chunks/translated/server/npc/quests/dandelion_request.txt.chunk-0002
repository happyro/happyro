		mes "关于梦罗克失踪儿童报告的";
		mes "消息。听说有人";
		mes "雇佣了刺客公会";
		mes "调查这些案件。";
		next;
		mes "[Nun]";
		mes "因为事情非常严重，";
		mes "刺客公会甚至请求";
		mes "普隆德拉教会协助，";
		mes "所以我希望你在这次任务中帮助刺客";
		mes "公会。";
		next;
		mes "[Nun]";
		mes "不过，我认为";
		mes "刺客公会的委托人";
		mes "可能另有目的，";
		mes "所以也请你留意，看看";
		mes "他们的委托人是否值得信任。";
		next;
		mes "[Nun]";
		mes "请尽快前往梦罗克。";
		mes "到达后，你需要主教的";
		mes "推荐信，";
		mes "现在就带上吧。";
		set mao_request,1;
		getitem 7416,1;
		close;
	}
	else if(mao_request == 1)
	{
		mes "[Nun]";
		mes "这次任务中，你需要";
		mes "在梦罗克绿洲西侧";
		mes "一间小屋附近";
		mes "与刺客公会的联系人会面。";
		mes "真不知道他们为什么选那里？";
		next;
		mes "[Nun]";
		mes "通常，普隆德拉教会的代表";
		mes "会直接拜访刺客公会。";
		mes "小心，刺客们";
		mes "一定是因为特殊情况，才会格外保密……";
		close;
	}
	else if((mao_request > 2 && mao_request < 27) || (mao_request > 102 && mao_request < 125))
	{
		mes "[Nun]";
		mes "看到你和刺客公会";
		mes "合作顺利，我很高兴。";
		mes "他们的行事方式";
		mes "与普隆德拉教会不同，";
		mes "但我仍然非常尊敬他们。";
		next;
		mes "[Nun]";
		mes "记住，你在这次行动中";
		mes "代表普隆德拉教会，";
		mes "所以一定要向刺客们";
		mes "展现最好的一面，好吗？";
		close;
	}
	else
	{
		mes "[Nun]";
		mes "虽然现在是和平时期，";
		mes "但我仍无法摆脱";
		mes "挥之不去的焦虑。";
		mes "仿佛某个重大事件";
		mes "就在地平线彼端……";
		close;
	}


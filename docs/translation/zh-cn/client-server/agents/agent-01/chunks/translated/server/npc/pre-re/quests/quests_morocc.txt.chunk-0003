			close;
		next;
		switch(select("是。:否。")) {
		case 1:
			set .@prin1,checkquest(10005);
			set .@prin2,checkquest(10006);
			set .@prin3,checkquest(10007);
			set .@prin4,checkquest(10008);
			set .@prin5,checkquest(10009);
			set .@prin6,checkquest(10010);
			set .@prin7,checkquest(10011);
			if (.@prin1 + .@prin2 + .@prin3 + .@prin4 + .@prin5 + .@prin6 + .@prin7 == 14) {
				mes "[调查员]";
				mes "很好。";
				mes "我喜欢听到王子的消息。";
				completequest 10004;
				setquest 10004;
			} else {
				mes "[调查员]";
				mes "你确定吗？";
				mes "请确认所有王子的情况。";
			}
			close;
		case 2:
			set .@prin1,checkquest(10005);
			set .@prin2,checkquest(10006);
			set .@prin3,checkquest(10007);
			set .@prin4,checkquest(10008);
			set .@prin5,checkquest(10009);
			set .@prin6,checkquest(10010);
			set .@prin7,checkquest(10011);
			if (.@prin1 + .@prin2 + .@prin3 + .@prin4 + .@prin5 + .@prin6 + .@prin7 == 14) {
				mes "[调查员]";
				mes "别害羞。我相信你已经完成了。";
				completequest 10004;
				setquest 10004;
			} else {
				mes "[调查员]";
				mes "我对所有王子的调查完成了。";
			}
			close;
		}
	}
}

prt_castle,272,375,4	script	Prince	881,{
	if (nk_prince > 6) {
		mes "-痴迷于制作";
		mes "锁和钥匙。-";
		close;
	}
	if (checkquest(10020) == 2) {
		mes "[埃里希]";
		mes "……我的运气真差！";
		mes "但他坚持要腐化我，明知会发生什么……";
		close;
	}
	else if (checkquest(10020) == 0 || checkquest(10020) == 1) {
		mes "[埃里希]";
		mes "最近我运气很差……只有骚扰不断发生……";
		close;
	}
	if (nk_prince < 5) {
		mes "[王子]";
		mes "你是谁？";
		mes "我认为你没有资格";
		mes "进入这个房间。";
		next;
		mes "[王子]";
		mes "我命令你离开";
		mes "我的视线。";
		close;
	}
	else if (nk_prince == 5) {
		mes "[王子]";
		mes "你是谁？";
		mes "一定有人告诉你隐藏入口的存在。除非……你是冒险者鉴定员？";
		next;
		select("是的，我是。");
		mes "[王子]";
		mes "是吗……那帮我个忙。我是尼里乌斯家族的嫡子。我叫埃里希，你可以称我埃里希王子。";
		next;
		mes "[埃里希]";
		mes "我的全名是……";
		next;
		mes "[埃里希]";
		mes "够了。";
		mes "你可以向我的仆人询问我的信息。我要休息了。";
		set nk_prince,6;
		completequest 10011;
		set .@prin1,checkquest(10005);
		set .@prin2,checkquest(10006);
		set .@prin3,checkquest(10007);
		set .@prin4,checkquest(10008);
		set .@prin5,checkquest(10009);
		set .@prin6,checkquest(10010);
		set .@prin7,checkquest(10011);
		if ((.@prin1 + .@prin2 + .@prin3 + .@prin4 + .@prin5 + .@prin6 + .@prin7) == 14) {
			setquest 10012;
		}
		close;
	}
	else {
		mes "[埃里希]";
		mes "……我的良心！";
		mes "它不太好用……";
		next;
		mes "-他似乎痴迷于关心其他一切。-";
		close;
	}
}

prt_castle,274,372,4	script	Servant#hans	48,{
	if (checkquest(10020) == 2) {
		mes "[汉斯]";
		mes "啊……嗯……我……";
		mes "我……非常抱歉！";
		mes "我……我好像对鉴定员犯了大错！";
		next;
		mes "[汉斯]";
		mes "我的王子没有做错任何事，但无论如何，我为一切向你道歉！";
		close;
	}
	else if (checkquest(10020) == 0 || checkquest(10020) == 1) {
		mes "没完没了……-";
		mes "-我一有反应他就紧张。他的行为让我感到同情。-";
		close;
	}
	if (nk_prince == 6) {
		mes "[汉斯]";
		mes "您好，先生。";
		mes "我叫汉斯，是埃里希王子的侍从。";
		next;
		mes "[汉斯]";
		mes "我能为您做些什么？";
		next;
		switch(select("埃里克王子让我来见你。:没什么。")) {
		case 1:
			mes "[汉斯]";
			mes "埃里希王子吗……？";
			next;
			select("我想听听关于他的故事。" );
			mes "[汉斯]";
			mes "啊，我明白了。";
			mes "坦白说，埃里希王子对统治并没有太大兴趣。";
			next;
			mes "[汉斯]";
			mes "他每天写日记。婚礼当天，他写道：“今天没发生什么特别的事”。他不关心时事，也不关心人际关系。";
			next;
			mes "[汉斯]";
			mes "他喜欢制作锁。";
			mes "他很古怪，对吧？";
			mes "有点像小丑。";
			next;
			mes "[汉斯]";
			mes "他也不喜欢华丽的服装，甚至没带礼服来这里。一到这里就沉浸在制作锁和钥匙中。";
			next;
			mes "[汉斯]";
			mes "我不知道该如何向您形容……关于他没有什么特别可说的。您看到什么就评价什么吧……";
			next;
			mes "[汉斯]";
			mes "我只能说这些了。";
			mes "嗯……～";
			next;
			emotion ET_SURPRISE;
			mes "[汉斯]";
			mes "啊，王子！";
			mes "您会割伤手指的！";
			next;
			mes "[埃里希]";
			mes ".........";
			next;
			mes "[汉斯]";
		mes "……嗯，他甚至听不见……";
			mes "哦哦哦……";
			next;
			mes "[" + strcharinfo(0) + "]";
			mes "......";
			close;
		case 2:
			mes "[汉斯]";
		mes "您见过其他王子了吗？";
			next;
			mes "[汉斯]";
		mes "就算您问些什么，现在也不会从他那里听到特别的回答。";
			close;
		}
	}
	else {
		mes "[汉斯]";
		mes "你好？";
		mes "你是新来的冒险者鉴定员吗？";
		close;
	}
}

prt_castle,339,202,3	script	Prince#urgen	989,{
	if (nk_prince > 6) {
		mes "[Urugen]";
		mes "……一点也不美。";
		mes "让我很不舒服……";
		close;
	}
	if (checkquest(10021) == 2) {
		mes "[Urugen]";
		mes "我非常不高兴。嘿，你在看什么？出去！";
		next;
		mes "[Urugen]";
		mes "我美丽的身体现在状态不好，今天不想让任何人看。";
		close;
	}
	else if (checkquest(10021) == 0 || checkquest(10021) == 1) {
		mes "[Urugen]";
		mes "……什么？你刚才……";
		mes "对我说了什么……？嗯？";
		close;
	}
	if (nk_prince < 5) {
		mes "[王子]";
		mes "呼呜呜呜呜";
		mes "这个位置不适合你。";
		next;
		mes "[王子]";
		mes "能离我多远就离多远。";
		close;
	}
	else if (nk_prince > 4) {
		mes "[王子]";
		mes "啦～啦啦啦啦～啦啦啦～";
		mes "你就是负责观察我、评鉴我的人吗？";
		next;
		mes "[王子]";
		mes "你注视的水仙花叫乌鲁根，在维格纳家族中盛开。";
		next;
		mes "[Urugen]";
		mes "我通常不让任何人听到我美丽的声音，但这次为你提供特别服务。";
		next;
		mes "[Urugen]";
		mes "听好了……";
		mes "让我用";
		mes "清澈美丽、令人难忘的声音回答你。";
		next;
		while(1) {
			switch(select("我想了解你的身世。:告诉我你对国家的看法。:你的爱好或品味是什么？:让我离开。")) {
			case 1:
				mes "[Urugen]";
				mes "我从小就英俊的脸庞";
				mes "引来男人的嫉妒和女人没完没了的求婚。我对此感到厌烦，所以选择远离人群。";
				next;
				mes "[Urugen]";
				mes "我这美丽的人";
				mes "偶尔也不该承受这种事。";
				next;
				mes "[Urugen]";
				mes "我逐渐变得胆怯。我对男人和女人都感到敬畏，不论性别取向。";
				set .@p_a,1;
				next;
				break;
			case 2:
				mes "[Urugen]";
				mes "人们应该做自己该做的事，这是国家发展的动力。对我而言，我的存在本身就足以贡献国家。";
				next;
				mes "[Urugen]";
				mes "像我这样华丽的国王存在于世，就是人民的光、生活的希望与意义。";
				set .@p_b,1;
				next;
				break;
			case 3:
				mes "[Urugen]";
				mes "当然是保养身体。人类应该追求美，这很自然，对吧？";
				next;
				mes "[Urugen]";
				mes "凡事都有例外，比如你出现在这座宫廷里。能不能离我再远一点？你的气味让我几乎无法呼吸。";
				set .@p_c,1;
				next;
				break;
			case 4:
				mes "[Urugen]";
				mes "你的精神一定很坚强。看了我这么久的美貌，居然还没有失去精神。";
				if (.@p_a + .@p_b + .@p_c == 3) {
					completequest 10009;
				}
				completequest 10011;
				set .@prin1,checkquest(10005);
				set .@prin2,checkquest(10006);
				set .@prin3,checkquest(10007);
				set .@prin4,checkquest(10008);
				set .@prin5,checkquest(10009);
				set .@prin6,checkquest(10010);
				set .@prin7,checkquest(10011);
				if ((.@prin1 + .@prin2 + .@prin3 + .@prin4 + .@prin5 + .@prin6 + .@prin7) == 14) {
					setquest 10012;
				}
				close;
			}
		}
	}
}

prt_castle,289,201,3	script	Prince#helmut	991,{
	if (nk_prince > 6) {
		mes "[Helmut]";
		mes "真是个笨蛋。我早该杀了他。现在轻松多了。";
		close;
	}
	if (checkquest(10022) == 2) {
		mes "[Helmut]";
		mes "该死……可恶！";
		mes "沃尔特的初心者！！";
		mes "我该怎么应对这种压力？该死！见鬼！";
		close;
	}
	else if (checkquest(10022) == 0 || checkquest(10022) == 1) {
		mes "- 他满脸通红，";
		mes "这一点明显写在他的脸上。-";
		close;
	}
	if (nk_prince < 5) {
		mes "[Helmut]";
		mes "你不该来这里！";
		mes "不能离我远点吗！";
		close;
	}
	else if (nk_prince > 4) {
		mes "[Helmut]";
		mes "你是新来的鉴定员吗？我已经受够这么多访客了！直接说正题吧！";
		next;
		mes "- 我该从什么话题开始？-";
		next;
		switch(select("你的背景……:你的抱负……:你对国家的看法……:我想先见见其他人。")) {
		case 1:
			mes "[Helmut]";
			mes "不知道别人会怎样，但你的问题让我很紧张。我不该这样，可我没有别的看法！";
			next;
			mes "[Helmut]";
			mes "我是王子；你要是抱怨，就自己当王子吧！这种提问让我厌烦。";
			next;
			mes "[" + strcharinfo(0) + "]";
			mes "............";
			mes "好，我明白了。请问吧……";
			next;
			mes "[Helmut]";
			mes "我是罗伊恩堡的赫尔穆特。";
			mes "我喜欢在战场上闻到血腥味，也喜欢节庆活动。";
			next;
			mes "[Helmut]";
			mes "我讨厌拘泥礼节，也讨厌多说话。至于抱负？等我成为……国王……要做什么？这个问题我被问过很多次。";
			next;
			mes "[Helmut]";
			mes "成为国王后，我会强化军队，统一大陆后征服整个大陆；消灭所有危害人民的怪物！";
			next;
			mes "[Helmut]";
		mes "~咳咳~！我的喉咙痛！我已经很久没用嗓子了。~咳咳~！";
			next;
			mes "[Helmut]";
			mes "嘿，卡尔本！";
			mes "拿啤酒来！啤酒！";
			next;
			mes "[Helmut]";
			mes "你还站在那里做什么？我没什么要说的了！退下！";
			next;
			mes "[" + strcharinfo(0) + "]";
			mes "......";
			completequest 10010;
			set .@prin1,checkquest(10005);
			set .@prin2,checkquest(10006);
			set .@prin3,checkquest(10007);
			set .@prin4,checkquest(10008);
			set .@prin5,checkquest(10009);

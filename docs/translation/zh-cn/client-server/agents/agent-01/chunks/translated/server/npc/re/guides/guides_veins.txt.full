veins,210,345,5	script	Veins Guide#veins01::GuideVeins	934,{
	mes "[维茵斯向导]";
	mes "感谢你穿越漫天沙尘。欢迎来到^8B4513维茵斯^000000，峡谷村。";
	mes "如果你第一次使用向导服务，不妨先查看‘公告’菜单？";
	F_Navi("[维茵斯向导]");
	next;
	while (1) {
		switch(select("[ 神殿 ]:[ 旅馆 ]:[ 酒馆 ]:[ 武器店 ]:[ 工具店 ]:[ 机场 ]:[ 地质研究所 ]:[ 酷炫活动公司员工 ]:移除小地图标记:取消")) {
		case 1:
			mes "[维茵斯向导]";
			mes F_Navi("神殿","veins,197,256")+"总有弗蕾亚女神化身的信徒在祈祷。";
			mes "它位于维茵斯北侧。";
			mes "还要查看其他地点吗？";
			viewpoint 1,197,256,0,0xFF0000;
			next;
			break;
		case 2:
			mes "[维茵斯向导]";
			mes "你可以在"+F_Navi("旅馆","veins,110,278")+"中消除旅途疲劳。旅馆位于维茵斯西北侧。";
			mes "还要查看其他地点吗？";
			viewpoint 1,110,278,1,0xFF4500;
			next;
			break;
		case 3:
			mes "[维茵斯向导]";
			mes "想和维茵斯居民聊天，就去维茵斯的"+F_Navi("酒馆","veins,150,215")+"吧。";
			mes "酒馆位于维茵斯西侧。";
			mes "还要查看其他地点吗？";
			viewpoint 1,150,215,2,0xDAA520;
			next;
			break;
		case 4:
			mes "[维茵斯向导]";
			mes "你必须学会保护自己。";
			mes "维茵斯的"+F_Navi("武器店","veins,150,175")+"以合理价格出售优质武器。";
			mes "它位于维茵斯西侧。";
			mes "还要查看其他地点吗？";
			viewpoint 1,150,175,3,0x008000;
			next;
			break;
		case 5:
			mes "[维茵斯向导]";
			mes "旅行必需品！去城镇中央的维茵斯"+F_Navi("工具店","veins,230,161")+"看看吧。";
			mes "还要查看其他地点吗？";
			viewpoint 1,230,161,4,0x0000FF;
			next;
			break;
		case 6:
			mes "[维茵斯向导]";
			mes "维茵斯的"+F_Navi("机场","veins,273,287")+"目前只用于货运。";
			mes "还要查看其他地点吗？";
			viewpoint 1,273,287,5,0x000080;
			next;
			break;
		case 7:
			mes "[维茵斯向导]";
			mes "你对地质学感兴趣吗？";
			mes "如果感兴趣，请前往";
			mes F_Navi("地质研究所","veins,150,175")+"，它位于武器店二楼。";
			mes "还要查看其他地点吗？";
			viewpoint 1,150,175,6,0x800080;
			next;
			break;
		case 8:
			mes "[维茵斯向导]";
			mes "我会标记";
			mes F_Navi("酷炫活动公司员工","veins,209,127","^808080")+"的位置";
			mes "在你的小地图上。";
			mes "还要查看其他地点吗？";
			viewpoint 1,209,127,7,0x808080;
			next;
			break;
		case 9:
			mes "[维茵斯向导]";
			mes "好的，我会移除你小地图上的所有标记。";
			mes "还有其他我能帮你的吗？";
			viewpoint 2,197,256,0,0xFFFFFF;
			viewpoint 2,110,278,1,0xFFFFFF;
			viewpoint 2,150,215,2,0xFFFFFF;
			viewpoint 2,150,175,3,0xFFFFFF;
			viewpoint 2,230,161,4,0xFFFFFF;
			viewpoint 2,273,287,5,0xFFFFFF;
			viewpoint 2,150,175,6,0xFFFFFF;
			viewpoint 2,209,127,7,0xFFFFFF;
			next;
			break;
		case 10:
			mes "[维茵斯向导]";
			mes "旅途平安！";
			close;
		}
	}
}
veins,189,101,5	duplicate(GuideVeins)	Veins Guide#veins02	934

}

prt_cas,97,229,7	script	Instructor Igrid#ep16	4_M_CRU,{
	mes "[伊格丽德教官]";
	mes "如果他们真的想为我们做些什么，就该让我们休息。";
	mes "只有不在前线工作的人才喜欢这种活动。这是真的。";
	close;
}


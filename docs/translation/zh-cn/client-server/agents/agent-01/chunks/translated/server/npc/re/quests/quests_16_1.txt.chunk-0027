		cutin "sc_vicente03.bmp",2;
		mes "[Vicente]";
		mes "我想你会成为王宫的英雄。";
		mes "很高兴看到你平安无事。";
		close3;
	}
	cutin "sc_vicente01",2;
	mes "[Vicente]";
	mes "嗯……我们在克里图拉见过吗？";
	next;
	cutin "sc_vicente02",2;
	mes "[Vicente]";
	mes "我接触过太多人了……";
	mes "你的脸似乎很熟悉……";
	next;
	cutin "sc_vicente03",2;
	mes "[Vicente]";

prt_cas,91,237,3	script	Ekinasia#ep16_etc01	1_F_SIGNZISK,{
	if (mao_morocc2 > 99) {
		mes "[Ekinasia]";
		mes "你也受邀参加宴会了。";
		mes "嗯，想想也不奇怪……";
		next;
		mes "[Lin]";
		mes "哦，你还活着！";
		mes "很高兴在这里见到你。你过得一定不错！";
		next;
		mes "[Ekinasia]";
		mes "说起来，小子也在这里。";
		mes "他遇到了公会的人，去见他们了……";
		next;
		mes "[Lin]";
		mes "嗯……然后他被其中一个奇怪的家伙带去了餐厅。";
		mes "你可以去打个招呼。";
		next;
		mes "[Ekinasia]";
		mes "这是久违的宴会。我们还是好好享受吧。";
		close2;
		npctalk "好，好！", "Lin#ep16_etc02", bc_self;
		end;
	}
	npctalk "距离上次举办这样的王室宴会已经有一段时间了。", "Ekinasia#ep16_etc01", bc_self;
	setpcblock PCBLOCK_NPC, true;
	sleep2 3000;
	setpcblock PCBLOCK_NPC, false;
	npctalk "我们偶尔需要这样放松一下。", "Ekinasia#ep16_etc01", bc_self;
	end;
}


prt_cas,78,255,3	script	Mayssel#ep16_etc05	4_F_MAYSEL,{
	if ((eaclass()&EAJ_THIRDMASK) == EAJ_GUILLOTINE_CROSS) {
		setpcblock PCBLOCK_NPC, true;
		cutin "gc_mayssel01.bmp",1;
		sleep2 100;
		cutin "gc_mayssel02.bmp",1;
		sleep2 100;
		cutin "gc_mayssel03.bmp",1;
		sleep2 200;
		cutin "gc_mayssel04.bmp",1;
		sleep2 200;
		cutin "gc_mayssel05.bmp",1;
		sleep2 200;
		cutin "gc_mayssel04.bmp",1;
		sleep2 100;
		cutin "gc_mayssel03.bmp",1;
		sleep2 100;
		cutin "gc_mayssel02.bmp",1;
		sleep2 100;
		setpcblock PCBLOCK_NPC, false;
		cutin "gc_mayssel01.bmp",1;
		mes "[Mayssel]";
	mes "你是谁……？";
		next;
		mes "[Mayssel]";
	mes "……哦……我记得你曾来找我们转职。";
	mes "我们还推荐你成为公会代表。";
		next;
		mes "[Mayssel]";
	mes "很高兴看到你已经成长。";
	mes "永远不要忘记双手将要沾染的鲜血有多沉重。";
		close3;
	}
	cutin "gc_mayssel01",1;
	mes "[Mayssel]";
	mes "你一定也受邀参加宴会了。";
	mes "我们也是。";
	next;
	mes "[Mayssel]";
	mes "王宫这样向公众开放很罕见。尽情享受吧。";
	close3;
}

prt_cas,78,252,2	script	Verkhasel#ep_etc06	4_M_GUILLOTINE,{
	if ((eaclass()&EAJ_THIRDMASK) == EAJ_GUILLOTINE_CROSS) {
		cutin "gc_verkhasel01.bmp",2;
		mes "[Verkhasel]";
		mes "……我不喜欢这种拥挤的地方，但执行任务时也没办法。";
		sleep2 200;
		cutin "gc_verkhasel02.bmp",2;
		sleep2 200;
		cutin "gc_verkhasel01.bmp",2;
		next;
		mes "[Verkhasel]";
	mes "你也在这里。";
	mes "嗯，我想你本来就该在这里。";
		next;
		mes "[Verkhasel]";
	mes "……真麻烦。";
		close2;
		cutin "",255;
	}
	npctalk "我现在想回去。", "Verkhasel#ep_etc06", bc_self;
	setpcblock PCBLOCK_NPC, true;
	sleep2 3000;
	npctalk "……你不能回去。", "Mayssel#ep16_etc05", bc_self;
	sleep2 3000;
	setpcblock PCBLOCK_NPC, false;
	npctalk "你已经把这点说得很清楚了，哈哈哈哈！", "Vicente#ep16_etc07", bc_self;
	end;
}

prt_cas,76,254,5	script	Vicente#ep16_etc07	4_M_HUMAN_02,{
	if ((eaclass()&EAJ_THIRDMASK) == EAJ_SHADOW_CHASER) {

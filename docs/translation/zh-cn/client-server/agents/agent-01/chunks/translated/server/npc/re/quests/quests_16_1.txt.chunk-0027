			mes "[Furniture Deliveryman]";
			mes "你来了。如果再晚一点，我就要渴坏了，会非常生气。";
			next;
			mes "[Furniture Deliveryman]";
			mes "你手上好像是空的。";
			mes "你忘了吗？我说过要^0000cd3 3 个" + getitemname(6254) + "^000000。";
			next;
			emotion ET_HNG;
			mes "[Furniture Deliveryman]";
			mes "没有它们我不会放过你！绝不！我要告诉大家，有个冒险者诬陷无辜的人！哼！";
			close;
		}
		.@name$ = strcharinfo(0);
		mes "[Furniture Deliveryman]";
		mes "你来了。如果再晚一点，我的肚子就要饿坏了，我会非常生气。";
		next;
		mes "[" + .@name$ + "]";
		mes "嗯，拿到它们可不容易。给你。";
		next;
		emotion ET_SMILE;
		mes "[Furniture Deliveryman]";
		mes "让我看看！哦，就是这个！配上好酒和牛头肉片怎么样？这种天作之合绝不会让你失望！";
		next;
		mes "[Furniture Deliveryman]";
		mes "味道和 10 年前一样！我现在完全恢复了疲劳！一点也不累了！所有压力都消失了！";
		next;
		mes "[" + .@name$ + "]";
		mes "哦，看起来真好吃。我之后应该尝尝。总之，你还知道箱子的其他事吗？";
		next;
		emotion ET_FRET;
		mes "[Furniture Deliveryman]";
		mes "我们还要继续谈这个吗？我享用美酒和肉时别聊这种事。我的马车进来时很重，出去时却轻如羽毛。";
		next;
		mes "[Furniture Deliveryman]";
		mes "如果你觉得可疑，就去问大门卫兵。他检查过我的马车。";
		next;
		mes "[" + .@name$ + "]";
		mes "嗯……";
		next;
		mes "[Furniture Deliveryman]";
		mes "哦，好吧。对了……";
		next;
		mes "[" + .@name$ + "]";
		mes "对了？";
		next;
		mes "[Furniture Deliveryman]";
		mes "你见过那家的公主吗？你一定见过。她是不是让你觉得可疑？我能从人的脸看出性格。她似乎隐藏着什么，说不定会在背后捅你一刀。";
		next;
		mes "[" + .@name$ + "]";
		mes "根据外表评判别人，不就是偏见吗？";
		next;
		emotion ET_SCRATCH;
		mes "[Furniture Deliveryman]";
		mes "你说得对。我很抱歉。不过确实有人这么说。无风不起浪。";
		mes "不对？好吧。也许没有火也会有烟。";
		next;
		mes "[" + .@name$ + "]";
		mes "据我观察，卡特琳不是那种人。";
		next;
		mes "[Furniture Deliveryman]";
		mes "好吧，如果不是那样就算了。总之，我离开房间时箱子还在原处。如果你没别的事，就可以走了。";
		next;
		mes "[" + .@name$ + "]";
		mes "失陪了。";
		delitem 6254,3;// Beef Head
		erasequest 14485;// I Am Upset
		setquest 14486;// I Heard the Story
		ep16_wig = 14;
		close;
	}
	if (ep16_wig == 14) {
		mes "[Furniture Deliveryman]";
		mes "亲爱的冒险者，你怎么又来了？你不是说要回宫殿吗？";
		next;
		mes "[Furniture Deliveryman]";
		mes "还有什么事要问我？还是要和我一起喝酒？";
		next;
		mes "[Furniture Deliveryman]";
		mes "我不介意。";
		close;
	}
	mes "[Furniture Deliveryman]";
	mes "我应该赚够钱开一家自己的店。老板只让我送家具，从来不教我怎么制作。";
	next;
	mes "[Furniture Deliveryman]";
	mes "切割和搬运工作会累断我的腰。";
	mes "哦，我的腰好痛。";
	close;
}


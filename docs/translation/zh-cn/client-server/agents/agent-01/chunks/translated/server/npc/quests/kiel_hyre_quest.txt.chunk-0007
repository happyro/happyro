//----------------------------------------------------------------------------
// Beautiful Lady "Allysia"
//----------------------------------------------------------------------------
kh_school,122,186,4	script	Beautiful Lady#kh6	894,{
	if (checkweight(7496,1) == 0) {
		mes "^3355FF请稍等……";
		mes "你现在携带的物品太多了，";
		mes "请先腾出更多^000000物品栏空间……";
		close;
	}
	cutin "kh_ellisia",2;
	if (KielHyreQuest < 38) {
		mes "[??????]";
		mes "这里是私人领地。请立即离开！";
		close2;
		cutin "kh_ellisia",255;
		warp "yuno_fild08",73,172;
		end;
	}
	else if (KielHyreQuest <= 38) {
		mes "[Allysia]";
		mes "原型艾莉的朋友，欢迎你。";
		mes "如你所料，我需要你的帮助。";
		mes "基尔·海伊尔被关在这座工厂的某处。";
		next;
		mes "[Allysia]";
		mes "请务必尽快找到基尔·海伊尔并救出他！";
		next;
		switch(select("这是什么工厂？:^FF0000基尔·海伊尔^000000怎么了？")) {
		case 1:
			mes "[Allysia]";
			mes "这座工厂属于基尔·海伊尔基金会的秘密产业，";
			mes "专门制造人形机器人。包括我和学院所有学生在内，";
			mes "其实都是机器人，并非人类。";
			next;
			mes "[Allysia]";
			mes "基尔·海伊尔基金会的最终目标是开发能够帮助人类社会的高级机器人。";
			mes "作为机器人，我们可以执行对人类来说过于危险或困难的任务。";
			break;
		case 2:
			mes "[Allysia]";
			mes "^3355FF基尔^000000一直在对人形机器人进行异常改造。";

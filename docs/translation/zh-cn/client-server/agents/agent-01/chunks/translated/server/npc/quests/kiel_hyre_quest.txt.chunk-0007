//----------------------------------------------------------------------------
// Beautiful Lady and Beautiful Lady copies.
//----------------------------------------------------------------------------
kh_school,119,149,4	script	Beautiful Lady#kh1::BeatifulLadyKHQ1	894,{
	cutin "kh_ellisia",2;
	if (KielHyreQuest < 40) {
		mes "[Allysia]";
		mes "嗯？我不认识你。基尔·海伊尔只允许艾莉和";
		mes "一位可能帮助她的可信朋友进入这个区域。";
		next;
		mes "[Allysia]";
		mes "我看不到^FF0000艾莉^000000。她也遭到袭击了吗？";
		mes "你是^FF0000艾莉的朋友^000000吗？";
		next;
		mes "[Allysia]";
		mes "我在附近看不到艾莉。";
		mes "只有证明自己是艾莉的朋友，才能让你进去。";
		mes "你有什么可以作为证明的东西吗？";
		next;
		switch(select("黄色钥匙卡:蓝色钥匙卡:金钥匙:雕刻按钮:……？")) {
		default:
			break;
		case 3:
			mes "[Allysia]";
			mes "啊，这不是基尔·海伊尔交给艾莉的钥匙吗？";
			mes "我相信你一直在帮助她。";
			mes "我一直在等你，请让我带你去我的房间。";
			close2;
			cutin "",255;
			warp "kh_school",120,180;
			end;
		case 4:
			mes "[Allysia]";
			mes "那、那是基尔的印章！";
			mes "他派你来抓我的吗？！";
			mes "我不会冒这个险！";
			close2;
			cutin "",255;
			monster "kh_school",117,144,"Bomb",1745,1;
			monster "kh_school",117,144,"Bomb",1745,1;
			monster "kh_school",117,144,"Bomb",1745,1;
			monster "kh_school",117,144,"Bomb",1745,1;
			end;
		case 5:
			mes "[Allysia]";
			mes "......";
			mes "........";
			mes "...........";
			close2;
			cutin "",255;
			end;
		}
		mes "[Allysia]";
		mes "嗯？这不能证明艾莉真的信任你……";
		close2;
		cutin "",255;
		end;
	}
	else if (KielHyreQuest >= 40) {
		mes "[Allysia]";
		mes "请跟我来。";
		close2;
		cutin "",255;
		warp "kh_school",120,180;
		end;
	}
}


kh_school,117,149,4	script	Beautiful lady#kh2::BeatifulLadyKHQ2	894,{
	end;
}

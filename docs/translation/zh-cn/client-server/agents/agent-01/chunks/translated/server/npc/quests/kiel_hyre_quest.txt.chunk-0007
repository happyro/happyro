
		}
	}
}

//----------------------------------------------------------------------------
// Cottage interior, stair case; Sword hilt
//----------------------------------------------------------------------------
kh_vila,136,68,0	script	Sword Hilt#kh	111,{
	if ((KHCottagePoem1 < 3) || (KHCottagePoem2 < 2) && (KielHyreQuest < 30)) {
		mes "^3355FF四把造型精美的剑摆放在四座";
		mes "看起来阴森可怖的蛇雕像旁。^000000";
		close;
	}
	else if ((KHCottagePoem1 <= 4) || (KHCottagePoem2 <= 2) && (KielHyreQuest < 30)) {
		mes "^3355FF四把造型精美的剑摆放在四座";
		mes "看起来阴森可怖的蛇雕像旁。等等！";
		mes "它们也许和你之前读到的诗有关……";
		next;
		switch(select("不可能！:当然！")) {
		case 1:
			mes "^3355FF不可能……";
			mes "一定只是巧合……^000000";
			close;
		case 2:
			mes "^3355FF当然！你看！";
			mes "每座蛇雕像的头顶都有一个洞，";
			mes "看起来足以插入旁边的装饰剑……^000000";
			next;
			switch(select("忽略:插入装饰剑")) {
			case 1:
				mes "^3355FF不可能……一定只是巧合……^000000";
				close;
			case 2:
				if (KHCottagePoem1 != 4) {
					mes "^3355FF拔不出来……这把剑一定被锁在里面，";
					mes "或者被某种奇怪的力量封印了！^000000";
					close;
				}
				else {
					mes "^3355FF请把每把剑插入正确的蛇雕像。";
					mes "首先请选择要插入第一把剑的蛇。^000000";
					next;
					switch(select("第一条蛇:第二条蛇:第三条蛇:第四条蛇")) {
					default:
						break;
					case 2:
						set .@KHSwords,.@KHSwords+1;
						break;
					}
					next;
					mes "^3355FF现在请选择要插入第二把剑的蛇。^000000";
					next;
					switch(select("第一条蛇:第二条蛇:第三条蛇:第四条蛇")) {
					default:
						break;
					case 4:
						set .@KHSwords,.@KHSwords+1;
						break;
					}
					next;
					mes "^3355FF接下来请选择要插入第三把剑的蛇。^000000";
					next;
					switch(select("第一条蛇:第二条蛇:第三条蛇:第四条蛇")) {
					case 1:
						set .@KHSwords,.@KHSwords+1;
						break;
					default:
						break;
					}
					next;
					mes "^3355FF最后请选择要插入第四把剑的蛇。^000000";
					next;
					switch(select("第一条蛇:第二条蛇:第三条蛇:第四条蛇")) {
					default:
						break;
					case 3:
						set .@KHSwords,.@KHSwords+1;
						break;
					}

					if (.@KHSwords == 4) {
						mes "^3355FF你的耳边突然充满低沉的嗡鸣声，";
						mes "身心仿佛都被卷走了……^000000";
						set KHCottagePoem1,5;
						set KHCottagePoem2,3;
						close2;
						warp "kh_vila",178,72;
						end;
					}

					else {
						mes "^3355FF什么也没发生……";
						mes "你大概没有把剑插入正确的蛇。";
						mes "先把剑取回，之后再试一次吧。^000000";
						close;
					}
				}
			}
		}
	}
	else if ((KHCottagePoem1 == 5) && (KHCottagePoem2 == 3) || (KielHyreQuest >= 30)) {
		mes "^3355FF这里有一条通往秘密实验室的隐藏通道。^000000";
		next;
		switch(select("进入:取消")) {
		case 1:
			warp "kh_vila",178,72;
			end;
		case 2:
			close;
		}
	}
}

//----------------------------------------------------------------------------
// Cottage interior, Secret Room; left test tube
//----------------------------------------------------------------------------
kh_vila,179,68,0	script	Test Tube#khp2	111,{
	mes "^3355FF试管里装着一名穿着基尔·海伊尔学院制服的年轻人。";
	mes "不知为何，你感觉以前在哪里见过他。^000000";
	close;
}


//----------------------------------------------------------------------------
// Cottage interior, Secret Room; Right test tube
//----------------------------------------------------------------------------
kh_vila,185,68,0	script	Test Tube::TestTubeKHQ2	111,{
	if (KielHyreQuest > 28) {
		mes "^3355FF试管里关着一个相貌古怪、干瘪的老人。^000000";
		close;
	}
	else if (KielHyreQuest == 28) {
		mes "^3355FF试管里关着一个相貌古怪、干瘪的老人。";
		mes "试管正下方有一个小红按钮。^000000";
		next;
		switch(select("按下按钮:进一步调查")) {
		case 1:
			mes "[???]";
			mes "你、你好……？听得到我吗？";
			mes "我不认识你……不过……也许我忘了？";
			mes "等等，如果你是我的朋友，";
			mes "你应该知道该怎么称呼我，对吧？";
			mes "你知道我是谁吗？";
			next;
			input .@KHInput$;
			if (.@KHInput$ == "little lost devil") {
				mes "[???]";
				mes "嘿……嘿嘿……";
				mes "他知道……喂，你一定要记住这些数字，好吗？";
				mes "别、别忘了，它们很重要……";
				mes "^FF00004^000000、^FF00007^000000、^FF00007^000000、^FF00002^000000、^FF00009^000000、^FF00006^000000、^FF00001^000000。就是这些……";
				next;
				mes "^3355FF4772961^000000";
				mes "^3355FF这些数字^000000";
				mes "^3355FFthose numbers^000000";
				mes "^3355FFpossibly mean?^000000";
				//KHCottagePoem1 and KHCottagePoem2 no longer needed-- deleting
				set KHCottagePoem1,0;
				set KHCottagePoem2,0;
				set KielHyreQuest,30;
				close;
			}
			else {
				mes "[???]";
				mes "不……不对……";
				mes "我不认为我们是朋友。不……";
				close;
			}
		case 2:
			mes "^3355FF再调查一下";
			mes "先再仔细调查一下这个区域。^000000";
			close;
		}
	}
	else if (KielHyreQuest >= 30) {
		if ((countitem(7491) > 0) && (countitem(7492) > 0)){
			mes "^3355FF数字 4772961^000000";
			mes "数字4772961是什么意思？";
			mes "目前你已经找到了这里需要的全部线索，";
			mes "回去找艾莉吧。^000000";
			close;
		}
		else {
			mes "^3355FF数字 4772961^000000";
			mes "数字4772961是什么意思？";
			mes "现在最好继续搜索这座小屋，寻找更多线索……^000000";
			close;
		}
	}
	end;
}


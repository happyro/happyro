//----------------------------------------------------------------------------
// Robotic's Factory; Heavy Door
//----------------------------------------------------------------------------
kh_dun01,235,48,0	script	Heavy Door#kh1::HeavyDoorKHQ1	111,{
	if (KielHyreQuest < 38) {
		mes "^3355FF面前有一扇又大又重的门。^000000";
		next;
		switch(select("打开门:取消")) {
		case 1:
			input .@KHInput$;
			mes "^3355FF你使尽全力想打开门，";
			mes "你使尽全力想打开门，";
			mes "却无法让它移动分毫。^000000";
			close;
		case 2:
			mes "^3355FF你决定暂时不管这扇门，";
			mes "等想出打开它的方法再说。^000000";
			close;
		}
	}
	else if ((KielHyreQuest >= 38) && (KielHyreQuest < 46)) {
		mes "^3355FF面前有一扇又大又重的门。^000000";
		next;
		switch(select("打开门:取消")) {
		case 1:
			input .@KHInput$;
			if (.@KHInput$ == "Blue Keycard") {
				mes "^3355FF你成功打开了门。";
				close2;
				warp "kh_school",119,144;
				end;
			}
			else {
				mes "^3355FF你使尽全力想打开门，";
				mes "却无法让它移动分毫。^000000";
				close;
			}
		case 2:
			mes "^3355FF你决定暂时不管这扇门，";
			mes "等想出打开它的方法再说。^000000";
			close;
		}
	}
	else {
		mes "^3355FF这是一扇异常沉重且紧闭的门，";
		mes "光靠蛮力无法打开。^000000";
		close;
	}
}


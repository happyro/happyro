//===== rAthena Script =======================================
//= Sarah and Fenrir
//===== Description: =========================================
//= [Walkthrough Conversion]
//= Sarah and Fenrir Instance
//===== Changelogs: ==========================================
//= 1.0 First version. [Capuche]
//============================================================

dali02,97,142,3	script	Professor Bernhard#a1	4_LGTSCIENCE,{
	if (BaseLevel < 145) {
		mes "- 达到 145 级或更高等级后才能继续。-";
		close;
	}
	switch( checkquest(9336,PLAYTIME) ) {
	case -1:
		switch( isbegin_quest(9335) ) {
		case 0:// First time doing instance
			mes "[伯恩哈德教授]";
			mes "我叫伯恩哈德教授，是施瓦尔茨瓦德最优秀的武器研究者。";
			next;
			mes "[伯恩哈德教授]";
			mes "经过无尽研究，我制作了各种武器，但总觉得缺少什么，于是找到了古代文献。";
			mes "研究过程中，我发现了次元装置。";
			next;
			mes "[伯恩哈德教授]";
			mes "我还意识到，制作更强大、更优秀的武器需要辉煌过去的遗物。";
			mes "所以……我需要你……";
			next;
			mes "[伯恩哈德教授]";
			if (is_party_leader() == false) {
				mes "作为真正教授，完成强大武器是我的夙愿！";
				mes "为此，我们需要曾出现在芬里尔与莎拉过去战斗中的巨人碎片。";
				next;
				mes "[伯恩哈德教授]";
				mes "我不能离开岗位。";
				mes "需要一名能替我带回碎片的战士……";
				mes "你看起来很有能力。";
				next;
				mes "[伯恩哈德教授]";
				mes "我会和你的队长继续讨论，而不是和你。";
				close;
			}
			mes "我需要一名能替我带回巨人碎片的战士……";
			mes "你看起来很有能力。";
			next;
			mes "[伯恩哈德教授]";
			mes "你觉得怎么样？";
			mes "愿意前往过去带回巨人碎片吗？";
			mes "我保证给予充分报酬。";
			next;
			if (select( "不", "是" ) == 1) {
				mes "[伯恩哈德教授]";
				mes "改变主意后再来找我。";
				close;
			}
			mes "[伯恩哈德教授]";
			mes "我已将次元装置设定到芬里尔与莎拉曾战斗的过去古城。";
			mes "运行时间不长，快去快回。";
			instance_create("Fenrir and Sarah");
			close;
		case 1:
			mes "[伯恩哈德教授]";
			mes "你成功带回巨人碎片了吗？";
			mes "你一定经历了许多危险，谢谢你的努力。";
			next;
			mes "[伯恩哈德教授]";
			mes "你冒着生命危险取得碎片，我当然不会白拿！";
			if (sarah_fenrir == 0) {
				mes "我会从过去研究中偶然获得的遗物里，给你一只看起来很有用的耳环。";
				next;
				mes "- 莎拉的左耳环 -";
				mes "可用于 1 级治愈术";
				mes "- 莎拉的右耳环 -";
				mes "可用于 1 级瞬间移动";
				next;
				.@s = select( "莎拉的左耳环", "莎拉的右耳环" ) - 1;
			}
			mes "[伯恩哈德教授]";
			mes "把巨人碎片交给我的首席助手，我会通过附魔让耳环同样变得强大。";
			next;
			mes "[伯恩哈德教授]";
			mes "收集的巨人碎片越多，效果越好。";
			mes "不过，运行次元装置所需的能量供应并不稳定。";
			next;
			mes "[伯恩哈德教授]";
			mes "一周后次元装置能量补充完毕，再来找我。";
			mes "我需要你再次寻找巨人碎片。";
			erasequest 9335;// Search for shards of Gigantes
			setquest 9336;// Go back to Professor Bernhard
			if (isbegin_quest(9337) > 0)
				erasequest 9337;// Wrapping up the Adventure
			if (sarah_fenrir == 0) {
				sarah_fenrir = 1;
				getitem (28310+.@s),1;
			}
			close;
		case 2:
			end;
		}
	case 0:
	case 1:
		mes "[伯恩哈德教授]";
		mes "制作强大武器需要巨人碎片。";
		mes "开启次元装置需要大量能量，能量积累后再回来。";
		close;
	case 2:
		mes "[伯恩哈德教授]";
		mes "我一直在等。";
		mes "一切进展如何？";
		mes "你离开期间，我成功积累了次元能量。";
		mes "我们可以再次开启次元装置。";
		next;
		mes "[伯恩哈德教授]";
		mes "作为真正教授，完成强大武器是我的夙愿！";
		mes "为此需要曾出现在芬里尔与莎拉过去战斗中的巨人碎片。";
		next;
		mes "[伯恩哈德教授]";
		mes "因为我不能离开岗位，";
		mes "需要一名能替我带回碎片的战士。";
		mes "我想你可以再次帮助我……";
		next;
		mes "[伯恩哈德教授]";
		mes "好了，准备工作全部完成。";
		mes "你能再次回到过去带回巨人碎片吗？";
		mes "我保证给予充分报酬。";
		if (is_party_leader() == true) {
			next;
			if (select( "不", "是" ) == 1) {
				mes "[伯恩哈德教授]";
				mes "我将次元装置设定到芬里尔与莎拉曾经所在的过去古城。";
				mes "持续时间不长，快去快回。";
				close;
			}
			instance_create("Fenrir and Sarah");
		}
		close;
	}
}

dali02,99,148,3	script	Dimensional Device#XX1	PORTAL,{
	if (BaseLevel < 145) {
		mes "- 你必须达到 145 级或以上。";
		mes "看来可以进入。";
		close;
	}
	switch( checkquest(9336,PLAYTIME) ) {
	case -1:
		break;
	case 0:
	case 1:
		mes "- 次元装置已关闭。";
		mes "看来无法进入。-";
		close;
	case 2:
		break;
	}
	if (isbegin_quest(9335) > 0) {
		mes "- 次元装置已关闭。";
		mes "看来无法进入。-";
		close;
	}
	if (select( "不进入装置。", "进入时间装置" ) == 1) {
		if (getcharid(1) > 0) {
			mes "- 次元装置";
			mes "似乎会扭曲时空 -";
			close;
		}
		mes "- 这里有一股潮湿的气息。-";
		close;
	}
	.@md_name$ = "Fenrir and Sarah";
	switch( instance_enter(.@md_name$) ) {
	case IE_OTHER:
		mes "发生未知错误。";
		close;
	case IE_NOINSTANCE:
		mes "芬里尔与莎拉纪念副本不存在。";
		mes "队长尚未创建纪念副本。";
		close;
	case IE_NOMEMBER:
		mes "只有队伍成员才能进入纪念副本。";
		close;
	case IE_OK:
		mapannounce "dali02", "队伍成员 " + strcharinfo(0) + " 所在队伍 " + getpartyname( getcharid(1) ) + " 正在进入芬里尔与莎拉纪念副本。", bc_map,0xFF99,FW_NORMAL,12;
		setquest 9335;// Search for shards of Gigantes
		if (isbegin_quest(9336) > 0)
			erasequest 9336;
		// warp "1@glast",367,304;
		end;
	}
}

dali02,93,146,6	script	Assistant Professor#a1	4_M_REPAIR,{
	if (sarah_fenrir == 0)
		end;
	disable_items;
	mes "[首席助手]";
	mes "教授提起过你。";
	mes "教授让我充分补偿你冒着生命危险带回巨人碎片的努力。";
	next;
	switch( select( "附魔耳环。", "购买耳环", "结束对话" ) ) {
	case 1:
		mes "[首席助手]";
		mes "我们在考古遗址发现的莎拉耳环一定有很大潜力。";
		next;
		switch( select( "附魔莎拉耳环", "初始化莎拉耳环附魔", "结束对话" ) ) {
		case 1:
			mes "[首席助手]";
			mes "一只耳环最多可以附魔 2 次。";
			mes "你想附魔哪只耳环？";
			next;
			switch( select( "莎拉的左耳环", "莎拉的右耳环", "退出" ) ) {
			case 1:
				.@sarah_item_id = 28310;
				.@sarah_earring$ = "左";
				break;
			case 2:
				.@sarah_item_id = 28311;
				.@sarah_earring$ = "右";
				break;
			case 3:
				mes "[首席助手]";
				mes "如果你想附魔";
				mes "莎拉的耳环，";
				mes "请再来找我。";
				close;
			}
			mes "[首席助手]";
			mes "必须装备物品才能附魔。";
			mes "你想附魔哪个栏位？";
			next;
			if (select( "左栏位", "右栏位" ) == 1) {
				.@part = EQI_ACC_L;
				.@column$ = "左";
				.@bonus_size = 4;		// 4 possibilities
				.@bonus_chance = 20;	// 20% per possibility
			}
			else {
				.@part = EQI_ACC_R;
				.@column$ = "右";
				.@bonus_size = 6;		// 6 possibilities
				.@bonus_chance = 10;	// 10% per possibility
			}
			.@equip_id = getequipid(.@part);
			if (.@equip_id != .@sarah_item_id) {
				mes "[首席助手]";
				mes "要附魔，必须装备莎拉的" + .@sarah_earring$ + "耳环。";
				close;
			}
			setarray .@card[0], getequipcardid(.@part,0), getequipcardid(.@part,1), getequipcardid(.@part,2), getequipcardid(.@part,3);
			if (.@card[2] > 0) {// 2 enchants
				mes "[首席助手]";
				mes "已经完全附魔的莎拉耳环不能再次附魔。";
				close;
			}
			if (.@card[3] > 0) {// 1 enchant
				mes "[首席助手]";
				mes "莎拉耳环目前在第 4 槽处于附魔状态。";
				.@slot = 3;
			}
			else {// none enchant
				mes "[首席助手]";
				mes "莎拉耳环目前处于未附魔状态。";
				.@slot = 4;
			}
			next;
			mes "[首席助手]";
			mes "你想在第 " + .@slot + " 槽附魔哪种能力？";
			next;
			switch( select( "CRI 或暴击", "专家弓手或闪避", "节约或 MATK", "攻击延迟或技能延迟" ) ) {
			case 1:
				setarray .@bonus[0],
					4863,	// Fatal1
					4864,	// Fatal2
					4939,	// Critical2
					4940,	// Critical3
					4941,	// Critical4
					4865;	// Fatal3
				mes "[首席助手]";
				mes "已选择 CRI 或暴击附魔槽 " + .@slot + "。";
				break;
			case 2:
				setarray .@bonus[0],
					4832,	// Expert_Archer1
					4833,	// Expert_Archer2
					4942,	// Dodge1
					4943,	// Dodge2
					4944,	// Dodge3
					4834;	// Expert_Archer3
				mes "[首席助手]";
				mes "已选择专家弓手或闪避附魔槽 " + .@slot + "。";
				break;
			case 3:
				setarray .@bonus[0],
					4945,	// Thrift1
					4946,	// Thrift2
					4897,	// Matk3p
					4898,	// Matk4p
					4947,	// Thrift3
					4899;	// Matk5p
				mes "[首席助手]";
				mes "已选择节约或 MATK 附魔槽 " + .@slot + "。";
				break;
			case 4:
				setarray .@bonus[0],
					4869,	// Attack_Delay_1
					4872,	// Attack_Delay_2
					4948,	// Skill_Delay1
					4949,	// Skill_Delay2
					4950,	// Skill_Delay3
					4873;	// Attack_Delay_3
				mes "[首席助手]";
				mes "已选择攻击延迟或技能延迟附魔槽 " + .@slot + "。";
				break;
			}
			next;
			mes "[首席助手]";
			mes "一次附魔需要 4 个巨人碎片。";
			next;
			mes "[首席助手]";
			mes "附魔是高风险过程，莎拉耳环可能会被破坏。";
			mes "你还要继续吗？";
			next;
			if (select( "不", "是" ) == 1) {
				mes "[首席助手]";
				mes "想清楚后再来找我！";
				close;
			}
			if (countitem(6803) < 4) {
				mes "[首席助手]";
				mes "巨人碎片不够。";
				mes "一次附魔需要 4 个巨人碎片。";
				close;
			}
			mes "[首席助手]";
			mes "很好。我开始附魔了！";
			mes "祝你好运~！";
			next;
			mes "[首席助手]";
			mes "啊啊啊！！";
			next;
			progressbar "000000",5;
			specialeffect2 EF_MAGICALATTHIT;
			specialeffect2 EF_POTION2;
			delitem 6803,4;// Shard of Gigantes

			// anti-hack
			if (callfunc("F_IsEquipIDHack", .@part, .@equip_id) || callfunc("F_IsEquipCardHack", .@part, .@card[0], .@card[1], .@card[2], .@card[3]))
				close;

			delequip .@part;
			.@r = rand(100);
			for ( .@i = 0; .@i < .@bonus_size && (.@bonus_chance * (.@i+1)) < .@r; .@i++ );
			if (.@i == .@bonus_size) {
				specialeffect2 EF_CRASHEARTH;
				specialeffect2 EF_MAXPOWER;
				mes "[首席助手]";
				mes "遗憾……它被……";
				mes "破坏了……";
				mes "呼……";
				mes "附魔不是容易的事……";
				close;
			}
			.@card[.@slot-1] = .@bonus[.@i];
			specialeffect2 EF_ANGEL2;
			getitem2 .@sarah_item_id,1,1,0,0,.@card[0],.@card[1],.@card[2],.@card[3];
			mes "[首席助手]";
			mes "附魔完成！";
			close;
		case 2:
			mes "[首席助手]";
			mes "你想初始化哪只耳环？";
			next;
			switch( select( "莎拉的左耳环", "莎拉的右耳环", "退出" ) ) {
			case 1:
				.@sarah_item_id = 28310;
				.@sarah_earring$ = "左";
				break;
			case 2:
				.@sarah_item_id = 28311;
				.@sarah_earring$ = "右";
				break;
			case 3:
				mes "[首席助手]";
				mes "想初始化莎拉耳环的附魔，请再来找我。";
				close;
			}
			mes "[首席助手]";
			mes "初始化莎拉耳环附魔需要 1 个巨人碎片。";
			next;
			if (countitem(6803) < 1) {
				mes "[首席助手]";
				mes "巨人碎片不够。";
				mes "初始化需要巨人碎片。";
				close;
			}
			mes "[首席助手]";
			mes "必须装备物品才能初始化。";
			mes "你想初始化哪个栏位的耳环？";
			next;
			if (select( "左栏位", "右栏位" ) == 1) {
				.@part = EQI_ACC_L;
				.@column$ = "左";
			}
			else {
				.@part = EQI_ACC_R;
				.@column$ = "右";
			}
			.@equip_id = getequipid(.@part);
			setarray .@card[0], getequipcardid(.@part,0), getequipcardid(.@part,1), getequipcardid(.@part,2), getequipcardid(.@part,3);
			if (.@equip_id == -1) {
				mes "[首席助手]";
				mes "要初始化附魔，相关栏位必须装备物品。";
				close;
			}
			if (.@equip_id != .@sarah_item_id) {
				mes "[首席助手]";
				mes "要初始化附魔，相关栏位必须装备莎拉耳环。";
				close;
			}
			if (getequipcardid(.@part,3) < 1) {
				mes "[首席助手]";
				mes "未附魔的莎拉耳环无法初始化。";
				close;
			}
			mes "[首席助手]";
			mes "你选择了莎拉" + .@sarah_earring$ + "耳环的" + .@column$ + "栏位。";
			mes "初始化后无法恢复已消失的能力。";
			mes "还要继续吗？";
			next;
			if (select( "不", "是" ) == 2) {
				mes "[首席助手]";
				mes "好的。开始初始化。";
				next;
				progressbar "000000",5;
				specialeffect2 EF_MAGICALATTHIT;
				specialeffect2 EF_POTION2;
				specialeffect2 EF_ANGEL2;
				delitem 6803,1;// Shard of Gigantes

				// anti-hack
				if (callfunc("F_IsEquipIDHack", .@part, .@equip_id) || callfunc("F_IsEquipCardHack", .@part, .@card[0], .@card[1], .@card[2], .@card[3]))
					close;

				delequip .@part;
				getitem .@sarah_item_id,1;
				mes "[首席助手]";
				mes "初始化完成。";
				mes "需要帮助时再来找我。";
			}
			close;
		case 3:
			mes "[首席助手]";
			mes "想给莎拉耳环附魔，请再来找我。";
			close;
		}
	case 2:
		mes "[首席助手]";
		mes "这只独特稀有的耳环与古城有关，是我和教授考古时发现的。";
		next;
		mes "[首席助手]";
		mes "我认为它过去曾由莎拉佩戴，似乎能发挥强大的潜力。";
		next;
		mes "[首席助手]";
		mes "你为教授带回巨人碎片，我特别用 1 个碎片与你交换。";
		next;
		mes "[首席助手]";
		mes "- 莎拉的左耳环 -";
		mes "可用于 1 级治愈术";
		mes "- 莎拉的右耳环 -";
		mes "可用于 1 级瞬间移动";
		mes "-----------------------";
		mes "你想要哪一个？";
		next;
		.@s = select( "莎拉的左耳环", "莎拉的右耳环", "结束对话" ) - 1;
		if (.@s < 2) {
			if (countitem(6803) < 1) {
				mes "[首席助手]";
				mes "巨人碎片不够。";
				mes "你需要带来碎片，我才能和你交易。";
				close;
			}
			delitem 6803,1;// Shard of Gigantes
			getitem (28310+.@s),1;
		}
		mes "[首席助手]";
		mes "伯恩哈德教授是我最尊敬的教授。";
		mes "你有尊敬的人吗？";
		close;
	case 3:
		mes "[首席助手]";
		mes "教授提起过你。";
		mes "教授让我充分补偿你冒着生命危险带回巨人碎片的努力。";
		close;
	}
}

1@glast,360,295,0	script	#glast_event_1	HIDDEN_WARP_NPC,8,8,{
	end;

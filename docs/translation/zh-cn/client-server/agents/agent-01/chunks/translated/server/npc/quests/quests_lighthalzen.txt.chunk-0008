			mes "我没有，我发誓";
			mes "我以自己的生命发誓，";
			mes "我绝不会把这个地方的";
			mes "任何事情说出去！求求你，";
			mes "看在神的份上！";
			next;
			mes "[？？？？]";
			mes "你的命……？";
			mes "抱歉，这还不够。";
			mes "你早该知道的。";
			next;

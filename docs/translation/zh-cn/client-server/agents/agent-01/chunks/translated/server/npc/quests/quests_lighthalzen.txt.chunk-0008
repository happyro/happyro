		else if ((lhz_curse > 0) && (lhz_curse < 26)) {
			mes "………………";
			next;
			soundeffect "tao_gunka_stand.wav",0;
			sc_start SC_Blind,60000,0;
			mes "………………";
			next;
			mes "[？？？？]";
			mes "哦，听说你想离开，";
			mes "我真的很遗憾。你确定";
			mes "没有什么办法";
			mes "我们可以做些什么";
			mes "来改变你的想法吗？";
			next;
			mes "[？？？]";
			mes "嗯，我在考虑提前退休，";
			mes "多花些时间";
			mes "陪伴家人。但我绝不会";
			mes "谈论公司，";
			mes "也不会谈论它的，嗯，";
			mes "秘密。";
			next;
			mes "[？？？？]";
			mes "我非常欣赏";
			mes "你的诚实与真诚。";
			mes "你为我们做得非常出色，";
			mes "对你多年来为公司";
			mes "付出的奉献，我实在";
			mes "不知该如何感谢。";
			next;
			mes "[？？？]";
			mes "谢谢您，先生。";
			next;
			mes "[？？？？]";
			mes "现在让你离开公司";
			mes "将会是巨大的损失。";
			mes "但你遭遇了那场";
			mes "可怕的事故，";

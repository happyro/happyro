lhz_que01,21,31,5	script	#li_Varmunt	4_M_SAGE_C,{
	if (countitem(7345) > 0) {
		if (lhz_curse == 12) {
			mes "[??]";
			mes "瓦尔蒙特博士，";
			mes "你终于同意";
			mes "加入我们了。欢迎！";
			next;
			emotion ET_SWEAT;
			mes "[Varmunt]";
			mes "嗯，我不知道自己是否认同";
			mes "这家公司的政策，";
			mes "但你们提出的项目";
			mes "似乎是千载难逢的机会，";
			mes "所以……";
			next;
			emotion ET_BEST, getnpcid(0, "#li_researcher");
			mes "[？？]";
			mes "说实话，这个项目";
			mes "只有在你的合作下";
			mes "才能成功。我们需要";
			mes "你的天才，也会提供";
			mes "你所需要的一切。";
			next;
			mes "[Varmunt]";
			mes "你过奖了。";
			mes "当然，我会";
			mes "尽力而为。只是";
			mes "这笔交易听起来";
			mes "好得令人难以置信……";
			next;
			mes "............";
			next;
			soundeffect "loli_ruri_stand.wav",0;
			mes ".................";
			next;
			soundeffect "loli_ruri_stand.wav",0;
			mes "...................";
			next;
			soundeffect "loli_ruri_stand.wav",0;
			mes ".....................";
			next;
			mes ".......................";
			next;
			mes "[？？]";
			mes "太惊人了。你提前完成了";
			mes "大多数人认为不可能的事。";
			mes "这是模拟的尤弥尔之心！";
			mes "这一定会推动飞艇";
			mes "的发展，";
			mes "和守护者的发展~！";
			next;
			mes "[Varmunt]";
			mes "我还是难以相信你们";
			mes "真的做到了。这对科学而言";
			mes "是巨大的飞跃，即使这个模拟品";
			mes "不如真正的尤弥尔之心强大。";
			next;
			mes "[？？]";
			mes "来吧，我们必须庆祝一下！";
			mes "我们到外面为你";
			mes "举杯庆祝！哈哈~";
			next;
			mes "………………";
			next;
			soundeffect "loli_ruri_stand.wav",0;
			mes ".................";
			next;
			soundeffect "loli_ruri_stand.wav",0;
			mes "....................";
			next;
			soundeffect "loli_ruri_stand.wav",0;
			mes "......................";
			next;
			mes "[？？]";
			mes "但是为什么，瓦尔蒙特博士？";
			mes "如果你因为任何原因";
			mes "对雷根贝勒公司";
			mes "感到不满……";
			next;
			mes "[Varmunt]";
			mes "嗯，既然我们已经完成了";
			mes "我答应完成的事情，";
			mes "我也没有理由继续留下。";
			mes "是时候回去继续";
			mes "我的个人研究了。";
			next;
			mes "[？？]";
			mes "请三思，瓦尔蒙特博士！";
			mes "你可以充分使用我们的设施";
			mes "来进行研究。我愿意";
			mes "为你提出一份条件。";
			mes "我愿意为此提供优厚待遇。";
			next;
			mes "[Varmunt]";
			mes "不，我不能……";
			mes "如果我继续在这里工作，";
			mes "恐怕会让很多人";
			mes "感到不高兴。不过，";
			mes "不过还是要谢谢";
			mes "你所做的一切。";
			next;
			mes "[？？]";
			mes "等等……";
			mes "瓦尔蒙特博士。";
			mes "你忘了你的手杖。";
			next;
			mes "[Varmunt]";
			mes "你什么时候见过我";
			mes "使用手杖？";
			mes "就算我真的需要，";
			mes "那也不是我的——";
			next;
			mes "……";
			next;
			mes "……";
			mes "…………";
			next;
			mes "……";
			mes "…………";
			mes "………………";
			set lhz_curse,13;
			close2;
			warp "lhz_in01",206,129;
			end;
		}
		else {
			warp "lhz_in01",206,129;
		}
	}
	else {
		warp "lhz_in01",206,129;
	}
	end;
}


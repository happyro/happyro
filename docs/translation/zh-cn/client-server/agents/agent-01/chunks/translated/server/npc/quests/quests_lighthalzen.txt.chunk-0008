			mes "当然，我们一开始";
			mes "不会承担太多责任，";
			mes "但他们会给我们很好的报酬！";
			next;
			mes "[？？？？？]";
			mes "嗯，我们总得吃饭。";
			mes "如果他们说到做到，";
			mes "那就更好了！";
			next;
			mes "………………";
			next;
			mes "………………";
			next;
			mes "[？？？]";
			mes "哇啊！";
			mes "哇啊啊啊~！";
			next;
			mes "[？？？？]";
			mes "女人，让这个";
			mes "孩子闭嘴！安静点，小鬼！";
			next;
			mes "[？？？？？]";
			mes "亲爱的，求你了……";
			mes "他还只是个孩子！";
			next;
			mes "[？？？？]";
			mes "我才不管这房子";
			mes "有多破！";
			mes "这是我的房子，我要安静！";
			next;
			mes "………………";
			next;
			mes "………………";
			next;
			emotion ET_QUESTION, playerattached();
			mes "["+strcharinfo(0)+"]";
			mes "我又听到奇怪的声音了！";
			mes "这些声音到底";
			mes "是从哪里传来的？";
			close2;
			soundeffect "tao_gunka_stand.wav",0;
			sc_end SC_Blind;
			sc_start SC_Curse,5000,0;
			if (!lhz_spi02) set lhz_spi02,1;
		}
	}
	end;
}


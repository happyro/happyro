		set mac_book,3;
		close;
	}
	if (mac_book == 3) {
		mes "[加尔福斯]";
		mes "你知道该做什么吧？用尽一切办法，在迪卡斯特斯档案馆寻找有关神器的信息。";
		next;
		mes "[加尔福斯]";
		mes "之后制作神器并带给我。然后我们再谈制作魔法书。";
		close;
	}
	if (mac_book == 4) {
		mes "[加尔福斯]";
		mes "哦，你找到";
		mes "有用的东西了吗？";
		next;
		set .@i, select("我发现了关于彗星的一切。:我掌握了四元漩涡的顶点。" );
		mes "[加尔福斯]";
		if ((.@i == 1 && countitem(100073)) || (.@i == 2 && countitem(100074))) {
			mes "你在开玩笑吗？你已经有这本书了！";
			close;
		}
		if ((.@i == 1 && checkquest(12218) == 2) || (.@i == 2 && checkquest(12219) == 2 && checkquest(12220) == 2 && checkquest(12221) == 2 && checkquest(12222) == 2)) {
			mes "天啊，我感受到你身上惊人的能量。太棒了！现在我们可以制作终极魔法书了。";
			next;
			mes "[加尔福斯]";
			mes "不过有一个问题：我穷得连制作魔法书的工具都买不起。";
			next;
			mes "[加尔福斯]";
			mes "我至少需要 ^0000aa500,000 Zeny^000000 购买所有必要工具。你有钱吗？";
			next;
			if(select("什、什么？没有！:当然。") == 1) {
				mes "[加尔福斯]";
				mes "啊，没有吗？真令人失望，但我也无能为力。钱够了再回来，好吗？";
				close;
			}
			mes "[加尔福斯]";
			if (Zeny >= 500000) {
				mes "好，那就开始吧！";
				next;
				specialeffect2 EF_DISPELL;
				progressbar "ffff00",4;
				specialeffect2 EF_LORD;
				set Zeny, Zeny - 500000;
				getitem 100072+.@i,1; //WL_MB_CM, WL_MB_TV
				mes "[加尔福斯]";
				mes "天啊，惊人的魔法能量差点让我失控！这是你的魔法书。";
				next;
				mes "[加尔福斯]";
				mes "谢谢你让我的梦想成真。需要其他魔法书时随时回来。";
				close;
			}
			mes "嘿，我告诉过你什么？没钱我就买不起制作魔法书的工具！";
			close;
		}
		mes "你确定找到东西了吗？看来你还没学会我们需要的内容……";
		close;
	}
	mes "[加尔福斯]";
	mes "还需要别的东西吗？";
	close;
}

dic_in01,25,190,0	script	Mysterious Documents	CLEAR_NPC,{
	if (isequipped(2782) < 1) {
		mes "我最好别忘了装备戒指。";
		close;
	}
	if (ep13_3_invite < 5) {
		mes "你靠近文件时，一个像档案馆管理员的邪恶巨人试图呼叫守卫加尔顿。你应该赶紧离开这里。";
		close;
	}
	if (checkquest(12165,PLAYTIME) == 1) {
		mes "这些文件让你感到恶心。等胃舒服些再回来吧。";
		close;
	}
	if (checkquest(12165,PLAYTIME) == 2) {
		mes "你已经不那么恶心了。现在应该可以安全继续。";
		erasequest 12165;
		close;
	}
	if ((BaseLevel < 140) || (getskilllv(2217) < 1) && (getskilllv(2213) < 1)) {
		mes "容器里的文件无法辨认。继续阅读也没有用。";
		close;
	}
	specialeffect2 EF_DISPELL;
	progressbar "ffff00",4;
	if (mac_book < 3) {
		mes "你发现了关于魔法、加速和粒子波的记录。";
		close;
	}
	if (mac_book == 3) {
		mes "你发现了关于魔法、加速和粒子波的记录。这些文件一定就是加尔福斯寻找的东西。";
		set mac_book, 4;
		close;
	}
	if (mac_book == 4) {
		set .@r, rand(1,10);
		if (.@r == 1) {
			if (getskilllv(2213) > 0) {
				if (checkquest(12218) == 1) {
					mes "你已经拥有这份文件了。";
					close;
				}
				mes "^660066要制作熔岩精华，必须在托尔火山地下城 2 层最炎热的地方精炼 40 个燃烧的心脏。^000000";
				mes "^660066必须使用那里的强大力量。人类自古以来就用这种方法研究魔法粒子的加速。^000000";
				next;
				mes "你发现了^990099熔岩精华制作方法^000000。详情请查看任务窗口。";
				specialeffect2 EF_STEAL;
				close2;
				setquest 12218;
				end;
			}
			mes "这份文件里没有任何有用的内容。";
			close;
		}
		if (.@r == 2) {
			if (getskilllv(2217) > 0) {
				if (checkquest(12219) == 1) {
					mes "你已经拥有这份文件了。";
					close;
				}
				mes "^660066火焰精华可以在托尔火山地下城 1 层的稳定地面上精炼。精炼精华需要 10 个爱的煤炭。^000000";
				mes "^660066根据人类的资料，这种精华是四大自然元素之一。^000000";
				next;
				mes "你发现了^990099火焰精华制作方法^000000。详情请查看任务窗口。";
				specialeffect2 EF_STEAL;
				close2;
				setquest 12219;
				end;
			}
			mes "这份文件里没有任何有用的内容。";
			close;
		}
		if (.@r == 3) {
			if (getskilllv(2217) > 0) {
				if (checkquest(12220) == 1) {
					mes "你已经拥有这份文件了。";
					close;
				}
				mes "^660066我成功在冰洞 3 层深处精炼出了冰川精华。如果想尝试，请准备 10 个冰之心并前往以下地点。^000000";
				next;
				mes "你发现了^990099冰川精华制作方法^000000。详情请查看任务窗口。";
				specialeffect2 EF_STEAL;
				close2;
				setquest 12220;
				end;
			}
			mes "这份文件里没有任何有用的内容。";
			close;
		}
		if (.@r == 4) {
			if (getskilllv(2217) > 0) {
				if (checkquest(12221) == 1) {
					mes "你已经拥有这份文件了。";
					close;
				}
				mes "^660066我在矿井地下城 2 层的古老岩石中精炼出了化石精华。到目前为止，那里是所有试验场中最稳定的地方。";
				mes "如果想尝试，请准备 10 个朱比利并前往地下城。祝你好运。^000000";
				next;
				mes "你发现了^990099化石精华制作方法^000000。详情请查看任务窗口。";
				specialeffect2 EF_STEAL;
				close2;
				setquest 12221;
				end;
			}
			mes "这份文件里没有任何有用的内容。";
			close;
		}
		if (.@r == 5) {
			if (getskilllv(2217) > 0) {
				if (checkquest(12222) == 1) {
					mes "你已经拥有这份文件了。";
					close;
				}
				mes "^660066为了精炼风暴精华，我去了昆仑风之精灵居住的隐士棋盘。";
				mes "精炼过程很简单，但寻找催化剂龙牙花了我很长时间。^000000";
				next;
				mes "你发现了^990099风暴精华制作方法^000000。详情请查看任务窗口。";
				specialeffect2 EF_STEAL;
				close2;
				setquest 12222;
				end;
			}
			mes "这份文件里没有任何有用的内容。";
			close;
		}
		if (.@r == 10) {
			mes "你突然感到不适，恶心很久都无法缓解。稍后再来寻找需要的文件吧。";
			setquest 12165;
			close;
		}
		mes "这里看起来没什么特别的。";
		close;
	}
	mes "你已经不需要再搜索这里了。";
	close;
}

function	script	Magic_Book_Essence	{
	if (MaxWeight - Weight < 1000) {
		mes "请减轻背包重量。";
		close;
	}
	.@item_req = getarg(1);
	.@req_amount = getarg(2);
	if (checkquest(getarg(0)) == 1 && countitem(.@item_req) >= .@req_amount) {
		specialeffect2 EF_BLIND;
		specialeffect2 EF_BEGINSPELL;
		progressbar "ffff00",4;
		delitem .@item_req,.@req_amount;
		if (rand(2)) {
			mes "你使用了 "+ callfunc("F_InsertPlural",.@req_amount,getitemname(.@item_req)) +" 制作^999900"+ getarg(3) +"精华^000000。";
			next;
			mes "^008800除非发生问题，否则"+getarg(3)+"精华将永久有效。^000000";
			completequest getarg(0);
			specialeffect2 EF_LORD;
			close;
		}
		mes "^008888使用 "+ callfunc("F_InsertPlural",.@req_amount,getitemname(.@item_req)) +" 精炼精华失败。^000000";
		close;
	}
	if (checkquest(getarg(0)) == 2) {
		mes "你已经在这个区域制作过"+getarg(3)+"精华了。";
		close;
	}
	mes "已经有人使用过这个区域了。";
	close;
}

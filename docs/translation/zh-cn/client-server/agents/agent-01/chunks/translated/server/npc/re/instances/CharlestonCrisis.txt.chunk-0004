	npctalk "维博士：我知道你和她有感情，就像人类家人一样。", .@npc1$;
	sleep 3000;
	npctalk "查尔斯顿 2：你这个卑鄙小人。", .@npc2$;
	sleep 3000;
	npctalk "维博士：你曾想成为人类。人类就是这样：撒谎、欺骗、毁灭。", .@npc1$;
	sleep 3000;
	npctalk "查尔斯顿 2：……", .@npc2$;
	sleep 3000;
	npctalk "查尔斯顿 2：进入睡眠模式……系统将保持不活动，直到输入外部命令。", .@npc2$;
	sleep 3000;
	npctalk "维博士：*轻笑*", .@npc1$;
	sleep 3000;
	initnpctimer;
	end;
OnTimer300:
	disablenpc instance_npcname("end#1");
	disablenpc instance_npcname("Charleston 2#7");
	disablenpc instance_npcname("Dr. Ve#3");
	enablenpc instance_npcname("Charleston 2#8");
	enablenpc instance_npcname("Dr. Ve#4");
	stopnpctimer;
	end;
}

1@mcd,116,215,4	script	Dr. Ve#4	4_M_DOCTOR,{
	if ('ep15_1_mcd01 == 17) {
		mes "[Dr. Ve]";
		mes "利用完整机械技术追求永生，有许多变量。";
		next;
		mes "[Dr. Ve]";
		mes "嗯……即使是改造机械身体也很困难……真的需要活体捐献者吗？嘿嘿！";
		close;
	}
	if ('ep15_1_mcd01 == 16) {
		mes "[Dr. Ve]";
		mes "普通人无法在核心中存活。你来自不同的时间点吗？";
		next;
		mes "[Dr. Ve]";
		mes "也许你来自查尔斯顿 1 制造者生活的时代……";
		next;
		mes "[Dr. Ve]";
		mes "算了。你不该来这里。回到破坏查尔斯顿 2 的人那里去。";
		close2;
		if ('ep15_1_mcd01 == 16)
			'ep15_1_mcd01 = 17;
		end;
	}
	if ('ep15_1_mcd01 == 15) {
		mes "[Dr. Ve]";
		mes "呼。";
		next;
		mes "[Dr. Ve]";
		mes "我最好重置查尔斯顿 2 并清除数据。这次真是险些出事。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "这次？";
		next;
		mes "[Dr. Ve]";
		mes "查尔斯顿 1 是 20 年前制造的。我为了学习她的技术而遇到她。";
		next;
		mes "[Dr. Ve]";
		mes "我是观察者，来这里记录查尔斯顿 1 和 2 的历史。我无法修复它们，但可以等待。";
		next;
		mes "[Dr. Ve]";
		mes "如果正确重新初始化查尔斯顿 1，她可以重组操作系统、修复损伤，并重新激活另一个查尔斯顿 2。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "另一个查尔斯顿 2？";
		next;
		mes "[Dr. Ve]";
		mes "查尔斯顿 2 的操作系统像活着的大脑一样自行进化。";
		next;
		mes "[Dr. Ve]";
		mes "每次查尔斯顿 2 在不同机器中复活，她都会更聪明、更理智，也更麻烦。";
		next;
		mes "[Dr. Ve]";
		mes "你我都无能为力。只能等查尔斯顿 1 自我修复。";
		next;
		mes "维博士叹气并写下了什么。";
		next;
		mes "[Dr. Ve]";
		mes "顺便说，通过机械工程实现永生有太多变量。";
		next;
		mes "[Dr. Ve]";
		mes "这证明机器太危险了。我需要活体生物。*轻笑*";
		if ('ep15_1_mcd01 == 15)
			'ep15_1_mcd01 = 16;
		close;
	}
	if ('ep15_1_mcd01 == 14) {
		mes "[Dr. Ve]";
		mes "查尔斯顿 1 又在重新初始化。嗯……";
		close;
	}
	mes "[Dr. Ve]";
	mes "关于这个案件，我有很多事情要记录。";
	close;
}

1@mcd,121,215,4	script	Charleston 2#8	4_F_CHARLESTON02,{
	if ('ep15_1_mcd01 == 15) {
		cutin "nale04.bmp",0;
		mes "她处于睡眠模式，一动不动。";
		close3;
	}
	if ('ep15_1_mcd01 > 15) {
		cutin "nale04.bmp",0;
		mes "查尔斯顿 2 一动不动，系统处于睡眠模式。片刻间，她的眼睛闪着未落的泪光。";
		close3;
	}
	cutin "nale04.bmp",0;
	mes "查尔斯顿 2 一动不动，系统处于睡眠模式。片刻间，她的眼睛闪着未落的泪光。";
	close3;
}

1@mcd,77,167,5	script	Shalosh#1	4_F_SHALOSH,{
	cutin "shaloshi01.bmp",2;
	mes "[Shalosh]";
	mes "......";
	next;
	switch( select( "交谈。", "我需要帮助。", "我想回去。" ) ) {
	case 1:
		if ('ep15_1_mcd01 == 17) {
			mes "[Shalosh]";
			mes "与新沃兹在噩梦中分开后，我四处漂泊，虽然由恶魔创造，却失去了目标。";
			next;
			mes "[Shalosh]";
			mes "我什么也没做，只是和查尔斯顿 2 说了话。";
			close3;
		}
		if ('ep15_1_mcd01 == 11) {
			mes "[Shalosh]";
			mes "即使努力永不停歇……";
			next;
			mes "[Shalosh]";
			mes "嗯……随你便！";
			close3;
		}
		if ('ep15_1_mcd01 == 4 || 'ep15_1_mcd01 == 3 || 'ep15_1_mcd01 == 2) {
			mes "[Shalosh]";
			mes "她真的这么说？说是我破坏了查尔斯顿 2？唉……";
			next;
			mes "[Shalosh]";
			mes "我没做错任何事。只是和查尔斯顿 2 简短交谈。这就是事实。";
			close3;
		}
		mes "[Shalosh]";
		mes "我只邀请了新沃兹。嗯，看来不该为需要终结的机器人开门。";
		close3;
	case 2:
		if ('ep15_1_mcd01 == 4) {
			viewpoint 1,84,226,1,0xFF00FF;
			viewpoint 1,126,84,2,0xFF00FF;
			viewpoint 1,111,68,3,0xFF00FF;
			viewpoint 1,210,181,4,0xFF00FF;
			viewpoint 1,183,192,5,0xFF00FF;
			viewpoint 1,130,124,6,0xFF00FF;
			viewpoint 1,54,108,7,0xFF00FF;
			mes "[Shalosh]";
			mes "如果你在寻找什么……";
			close3;
		}
		if ('ep15_1_mcd01 == 5 || 'ep15_1_mcd01 == 6 || 'ep15_1_mcd01 == 7) {
			viewpoint 1,86,231,8,0xFF00FF;
			viewpoint 1,172,196,9,0xFF00FF;
			viewpoint 1,126,84,10,0xFF00FF;
			mes "[Shalosh]";
			mes "如果你在寻找什么……";
			close3;
		}
		mes "[Shalosh]";
		mes "费雷和我一起来，但我没见到他。不，谢谢；我知道他会回来。";
		close3;
	case 3:
		if ('ep15_1_mcd01 == 17) {
			mes "[Shalosh]";
			mes "噪音停止了。如果你愿意，我可以把你送回原处。";
			next;
			if (select( "回去。", "留下。" ) == 2) {
				mes "[Shalosh]";
				mes "被邀请者无法干涉原本的时间，留下来也改变不了什么。";
				close3;
			}
			mes "[Shalosh]";
			mes "噪音和故事都很有趣。和新沃兹一起走吧，也许我们会再见。";
			next;
			mes "[Shalosh]";
			mes "也许我也该去寻找新的噪音和故事。";
			completequest 13184;
			if (isbegin_quest(13186) == 0) {
				setquest 13186;
				completequest 13186;
			}
			close2;
			getitem 6752,3;	// Charleston_Parts
			cutin "",255;
			warp "verus04",107,124;
			end;
		}
		mes "[Shalosh]";
		mes "你可以试试，但什么都改变不了。真是徒劳！";
		close3;
	}
	end;
}

1@mcd,109,219,5	script	Main Computer#1	CLEAR_NPC,{
	if ('ep15_1_mcd01 < 3)
		end;
	switch( checkquest(13188,PLAYTIME) ) {
	case -1:
		break;
	case 0:
	case 1:
		mes "[Main Computer]";
		mes "必须处理更多步骤。正在备份步骤数据……";
		close;
	case 2:
		break;
	}
	switch( checkquest(13187,HUNTING) ) {
	case -1:
		mes "[Main Computer]";
		mes "查尔斯顿 2 的系统在例行维护时过载。与操作系统断开失败。";
		next;
		mes "[Main Computer]";
		mes "系统防御了未经授权的访问，但数据拦截和冲突仍在继续，将纳米步变成了怪物。";
		next;
		mes "[Main Computer]";
		mes "为了加快主计算机处理速度并夺回工厂，必须处理 50 个步骤。";
		next;
		if (select( "执行请求。", "退出。" ) == 1) {
			mes "[Main Computer]";
			mes "需要处理 50 个步骤。";
			if (isbegin_quest(13188) == 1)
				erasequest 13188;
			setquest 13187;
		}
		close;
	case 0:
	case 1:
		mes "[Main Computer]";
		mes "为了加快主计算机处理速度并夺回工厂，必须处理 50 个步骤。";
		close;
	case 2:
		mes "[Main Computer]";
		mes "辛苦了。现在备份已处理步骤的数据……";
		erasequest 13187;
		setquest 13188;
		getexp 1000000,300000;
		getitem 6752,1;	// Charleston_Parts
		close;
	}
	end;
}

1@mcd,86,231,5	script	Backup Generator#1	CLEAR_NPC,2,2,{
	end;
OnTouch_:
	if ('ep15_1_mcd01 == 7) {

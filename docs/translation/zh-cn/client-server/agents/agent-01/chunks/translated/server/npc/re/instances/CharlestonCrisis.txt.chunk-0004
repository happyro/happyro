			disablenpc();
		}
		close;
	}
	if ('ep15_1_mcd01 == 6 || 'ep15_1_mcd01 == 5) {
		mes "你启动了发电机。传来齿轮转动的声音。";
		'ep15_1_mcd01++;
		disablenpc();
		close;
	}
	end;
}

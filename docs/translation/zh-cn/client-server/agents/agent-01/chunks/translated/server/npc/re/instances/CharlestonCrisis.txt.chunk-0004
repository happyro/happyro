1@mcd,114,82,4	script	IGU#01	4_F_IU,{
	cutin "igu04.bmp",2;
	if (isbegin_quest(13186) == 0) {
		mes "[IGU]";
		mes "我跟随新沃兹而来。他现在在哪里？";
		close3;
	}
	mes "[IGU]";
	mes "享受冒险吗？这里到处都是机器。这里以前是书房。看到那边的书了吗？";
	close3;
}


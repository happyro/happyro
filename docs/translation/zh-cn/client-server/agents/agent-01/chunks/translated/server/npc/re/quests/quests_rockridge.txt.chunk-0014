harboro2,57,239,3	script	Unemployed Man#srdg01	4_M_03,{
	mes "[失业男子]";
	mes "看到那些海葵了吗？它们总是堵塞下水道管道，所以我们定期清除。我喜欢坐在这里看它们移动。这样一来时间过得很快。";
	next;
	mes "[失业男子]";
	mes "至少那段时间我可以忘记现实，忘记矿山、没有工作之类的事。";

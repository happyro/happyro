}

harboro1,211,113,7	script	Foreman#srdg01	4_F_EDEN_OFFICER,{
	mes "[工人]";
	mes "我们什么时候能重新开始工作？";
	next;
	mes "[工人]";
	mes "我们还要等多久？";
	next;
	mes "[工头]";
	mes "啊，大家请冷静。";
	next;
	mes "[工人]";
	mes "你才该冷静。我们光坐在这里，每小时都在损失钱。";
	next;
	mes "[工头]";
	mes "拿到物资前我们什么也做不了。";
	next;
	mes "[工人]";
	mes "那要等到什么时候？";
	next;
	mes "[工头]";
	mes "我们无能为力。水牛强盗偷走了最后一批货，而且他们还会再这么做。";
	next;
	mes "[工人]";
	mes "我不在乎。如果明天还不能工作，我就离开这里！";
	close;
}

harboro1,214,115,3	script	Worker#srdg03	1_M_HOF,{

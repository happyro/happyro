}

harboro1,290,104,5	script	Eznia#rockn04	4_DR_M_02,{
	mes "[艾兹妮娅]";
	mes "你知道岩脊第一层的大多数建筑前都有巨大的招牌吗？";
	next;
	mes "[艾兹妮娅]";
	mes "这是个有趣的现象。我想招牌是为了让建筑看起来像有两层，至少正面看是这样。";
	next;
	mes "[艾兹妮娅]";
	mes "其实在建造地下室前，它们确实是两层。业主一定很怀念两层建筑。";
	close;
}
harboro1,273,259,4	script	Alain Morlein#dy	4_M_YURI,{
	emotion ET_FRET;
	mes "[阿兰·莫莱因]";
	mes "嘿，你为什么不能给我贷款？";
	next;
	emotion ET_PROFUSELY_SWEAT, getnpcid(0, "Bank Clerk#dy");
	emotion ET_SORRY, getnpcid(0, "Bank Clerk#dy");
	mes "[银行职员]";
	mes "抱歉，我们不向个人客户提供服务。";
	next;
	mes "[阿兰·莫莱因]";
	mes "你在开玩笑吗？我昨天还用过你们的服务。看，你不记得我了吗？";
	next;
	mes "[银行职员]";
	mes "让我看看你的身份证明。如你所知，这里很多人长得很像。";
	next;
	mes "[银行职员]";
	mes "因身份误认造成的所有交易错误都由我负责。请你理解。";
	next;
	emotion ET_THINK;
	mes "[阿兰·莫莱因]";
	mes "*哼*";
	next;
	emotion ET_THANKS, getnpcid(0, "Bank Clerk#dy");
	mes "[银行职员]";
	mes "谢谢你的理解。祝你今天愉快。";
	close;
}

harboro1,270,252,6	script	Bank Clerk#dy	4_M_MANAGER,{
	emotion ET_BIGTHROB;
	mes "[银行职员]";
	mes "你好。";
	mes "欢迎来到 GC 银行岩脊分行。今天我能为你做什么？";
	next;
	switch( select( "查看我的银行账户。", "购买投资产品。", "GC 银行是什么？", "我只是路过。" ) ) {
	case 1:
		mes "[银行职员]";
		mes "" + strcharinfo(0) + "，对吧？";
		next;
		mes "[银行职员]";
		mes "你在我们这里没有账户，但有一个以" + strcharinfo(0) + "名义开设的账户。今天还需要什么帮助吗？";
		close2;
		openbank;
		end;
	case 2:
		emotion ET_SORRY;
		mes "[银行职员]";
		mes "很抱歉，";
		mes "我们的投资产品只面向企业。";
		close;
	case 3:
		mes "[银行职员]";
		mes "你是指这家银行吗？";
		mes "知道它的人不多，因为目前分行还不多。";
		next;
		mes "[银行职员]";
		mes "它的主要客户是公司和其他企业。";
		next;
		mes "[银行职员]";
		mes "当然我们也服务个人客户，但大多数银行主要靠企业维持经营。";
		next;
		mes "[银行职员]";
		mes "这只是传闻，但 GC 银行的创始人用自己最喜欢的东西给银行命名：金币。";
		next;
		emotion ET_COOL;
		mes "[银行职员]";
		mes "你没看到这栋建筑屋顶上巨大漂亮的金币吗？";
		close;
	case 4:
		mes "[银行职员]";
		mes "哈哈，我明白了。";
		mes "我们在沙漠里，而且我不能进建筑，不过希望你在这里过得愉快。";
		close;
	}
}

harboro1,241,200,5	script	Gunslinger Posh#rockn05	4_M_HUMERCHANT,{
	mes "[枪手波什]";
	mes "你在找好武器吗？你知道枪械是这个地区的主要武器，对吧？";
	next;
	npctalk "有些人卖了一阵子枪后，就以为自己也擅长使用枪。我不是他们那种人。我一直都很擅长。", "", bc_self;
	mes "[枪手波什]";
	mes "啊，商店关门了。老板桑德斯带着枪去了沙漠，想亲自猎杀水牛强盗。结果摔倒伤了腰。";
	next;
	mes "[枪手波什]";
	mes "别担心，你还是可以买到枪。小桑德斯租了工具店的一角，可以在那里卖几把枪。";
	next;
	npctalk "沿着这条路向东走就能到工具店。", "", bc_self;
	mes "[枪手波什]";
	mes "他的商品种类没有父亲那么丰富，但有一些精心挑选的型号。";
	close;
}

harboro1,274,214,5	script	White Twig#rockn19	4_F_CACTUSLADY3,5,5,{
	mes "[白枝]";
	mes "阿库哈！纳哈里！他们去哪儿了？";
	next;
	mes "[白枝]";
	mes "你见过一对仙人掌孩子吗？一个男孩和一个女孩。";
	mes "我带他们来参观陌生人的村子，却在人群中把他们弄丢了。";
	next;
	mes "[白枝]";
	mes "我该怎么办？阿库哈！纳哈里！";
	mes "如果你看到他们，请告诉他们奶奶正在找他们。";
	close;

OnTouch:
	npctalk "阿库哈！纳哈里！天哪，他们在哪里？", "", bc_self;
	end;
}

harboro1,278,195,5	script	Carola Firth#rockn17	4_F_CAPEGIRL,{
	mes "[卡罗拉·菲尔斯]";
	mes "你听到了吗？地下室闹鬼！";
	next;
	mes "[卡罗拉·菲尔斯]";
	mes "传闻有名工人在地下室被掩埋前没能及时出来。";
	mes "这里进进出出的人太多，很难追踪每一个人。";
	next;
	npctalk "呜！", "Lucas Richie#rockn08", bc_self;
	mes "[卡罗拉·菲尔斯]";
	mes "一些工人下到地下室维修，听到了奇怪的窸窣声。";
	mes "当他们找到声音来源时？呀啊啊啊！";
	next;
	npctalk "卡罗拉，你做的事能吓到大多数男人，却害怕根本不存在的东西。", "Lucas Richie#rockn08", bc_self;
	npctalk "所以我才害怕：我不想被所有被我伤害过的人的鬼魂纠缠。", "", bc_self;
	mes "[卡罗拉·菲尔斯]";
	mes "卢卡斯！你想让我杀了你吗？别再这样了！";
	mes "呜，我太害怕了，不想再谈这个了。";
	close;
}

harboro1,280,195,3	script	Lucas Richie#rockn08	4_M_ROGUE,{
	mes "[卢卡斯·里奇]";
	mes "地下室闹鬼。你不会真的相信吧？";
	mes "我觉得下面有宝藏。";
	next;
	mes "[卢卡斯·里奇]";
	mes "传播这个愚蠢传闻的人，是为了阻止别人发现宝藏。";
	next;
	npctalk "随便吧。我还是不进去！", "Carola Firth#rockn17", bc_self;
	npctalk "*轻笑* 谁能想到卡罗拉会害怕鬼？", "", bc_self;
	mes "[卢卡斯·里奇]";
	mes "嗯，我本来是开玩笑，但她也许真的害怕。";
	mes "你觉得呢，卡罗拉？要不要和我一起下去？";
	mes "啊，冒险者。这件事就你知我知，好吗？";
	close;
}

-	shop	bread_rockridge	-1,580:150

harboro1,314,211,4	script	Bakery Owner#dy	4_COOK,3,3,{
	npctalk "欢迎！", "", bc_self;
	callshop "bread_rockridge",1;
	end;

OnTouch:
	.@r = rand(1,10);
	if (.@r == 3)
		npctalk "这些面包是我今天早上刚烤的。", "", bc_self;
	else if (.@r == 4)
		npctalk "面包！刚出炉的新鲜面包，快来买！", "", bc_self;
	else if (.@r == 5)
		npctalk "我的面包美味得让人愿意为之而死。", "", bc_self;
	else if (.@r == 6)
		npctalk "我有天下最好的面包！快来买我的面包！", "", bc_self;
	else if (.@r == 7)
		npctalk "面包！面包，面包！面包！", "", bc_self;
	else if (.@r == 8)
		npctalk "嘿，要不要买些面包？", "", bc_self;
	else if (.@r == 9)
		npctalk "我只卖面包，别的什么也不卖。", "", bc_self;
	end;
}


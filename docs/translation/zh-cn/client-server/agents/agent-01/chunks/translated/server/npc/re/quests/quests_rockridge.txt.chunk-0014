}

harboro2,118,264,5	script	Old Woman#srdg01	4_F_LGTGRAND,{
	mes "[老妇人]";
	mes "这里一点都没变。";
	next;
	mes "[老人]";
	mes "还记得我们第一次来这里吗？";
	next;
	mes "[老妇人]";
	mes "记得。";
	next;
	mes "[老人]";
	mes "我们亲手从地基石头到屋顶，一点点建起了这所房子。";
	next;
	mes "[老妇人]";
	mes "呜，越来越冷了。我们回地面吧。";
	next;
	mes "[老人]";
	mes "我可爱的克莱门汀……我就是在这里向她求婚的。";
	next;
	mes "[老妇人]";
	mes "我在这里。";
	next;
	mes "[老人]";
	mes "我的克莱门汀才没那么老！";
	next;
	mes "[老妇人]";
	mes "哼，你这个老糊涂！";
	close;
}

harboro2,120,265,3	script	Old Man#srdg01	4_M_DST_GRAND,{
	mes "[老人]";
	mes "嗯？谁在那里？是你吗，查理？";
	next;
	mes "[老妇人]";
	mes "查理不能来这里。他住在海的另一边。";
	next;
	mes "[老人]";
	mes "是吗？对了，这里变化很大。";
	next;
	mes "[老妇人]";
	mes "没有，还是和我们离开时一样。";
	next;
	mes "[老人]";
	mes "是吗？我怀念过去时会来这里，但这里太暗了。对了，为什么变得这么潮湿？";
	next;
	mes "[老妇人]";
	mes "这里被洪水淹过。所以才填平这里，我们也搬到了上面。你糊涂了吗？当初坚持这里太低不能建房的人就是你。";
	next;
	mes "[老人]";
	mes "是我吗？";
	close;
}


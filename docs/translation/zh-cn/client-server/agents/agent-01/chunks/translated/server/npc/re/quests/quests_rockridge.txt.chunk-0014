}

harboro1,324,124,7	script	Joe	4_MAL_CAPTAIN,{
	if (BaseLevel < 100) {
		mes "[乔]";
		mes "...";
		next;
		mes "[乔]";
		mes "你太虚弱了，";
		mes "不能进入地下室。";
		mes "请离开。";
		close;
	}
	mes "[乔]";
	mes "...";
	next;
	mes "[乔]";
	mes "你要进去吗？";
	next;
	if (select( "是。", "否。" ) == 2) {
		mes "[多诺万]";
		mes "...";
		close;
	}
	mes "[乔]";
	mes "你最好一完成就";
	mes "马上离开那里。";
	close2;
	warp "harboro2",281,104;
	end;
}

harboro1,352,199,5	script	Hungry Laborer#1	4W_M_03,5,5,{
	end;
OnTouch:
	if (isbegin_quest(12381) == 2)
		end;
	.@num = atoi(strnpcinfo(2));
	if (.@num == 1)
		npctalk "饥饿的工人：呜，我快饿死了。队伍怎么还没变短？";
	else if (.@num == 5)
		npctalk "好奇的人：这队伍是做什么的？你们在等活动奖励吗？";
	else if (.@num == 8)
		npctalk "饥饿的工人：太荒唐了。我排了 3 小时队，就是为了吃饭。";
	else if (.@num == 11)
		npctalk "饥饿的工人：很快就轮到我了！";
	else if (.@num == 13)
		npctalk "饥饿的工人：嘿，你没看到这里有队伍吗？去队尾排队！";
	end;
}

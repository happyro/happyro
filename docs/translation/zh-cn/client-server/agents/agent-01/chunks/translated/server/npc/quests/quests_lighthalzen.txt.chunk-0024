airplane_01,10,10,3	script	#LyozienSwitch	HIDDEN_NPC,{
	callfunc "F_GM_NPC";
	mes "[里奥岑开关]";
	mes "输入密码。";
	mes "输入 0 取消。";
	next;
	set .@i, callfunc("F_GM_NPC",1028,0,0,4000);
	if (.@i == -2) {
		mes "[里奥岑开关]";
		mes "错误。";
		close;
	} else if (.@i == -1) {
		mes "[里奥岑开关]";
		mes "已取消。";
		close;
	} else if (.@i == 0) {
		close;
	} else {
		mes "[里奥岑开关]";
		mes "你想将里奥岑";
		mes "NPC";
		mes "开启还是关闭？";
		next;
		switch(select("开启:关闭")) {
		case 1:
			set .@str$,"activated";
			donpcevent "Man#Lyozien::OnEnable";
			break;
		case 2:
			set .@str$,"deactivated";
			donpcevent "Man#Lyozien::OnDisable";
			break;
		}
		mes "[里奥岑开关]";
		mes "里奥岑 NPC 现在已";
		mes ""+.@str$+"。";
		mes " ";
		mes "/mm airplane_01.gat 96 48";
		close;
	}
}


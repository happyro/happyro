		next;
		mes "[" + strcharinfo(0) + "]";
		mes "请问，";
		mes "你是里奥岑吗？";
		next;
		cutin "lhz_ryo07",2;
		mes "[里奥岑]";
		mes "嘿，你就是我哥哥凯岑";
		mes "派来的人吗？";
		mes "太好了，我一直在等你。";
		mes "如你所见，";
		mes "我很难处理这里的";
		mes "这些包裹。";
		next;
		cutin "lhz_ryo14",2;
		mes "[" + strcharinfo(0)";
		mes "+ "]";
		mes "等等，凯岑是";
		mes "你的哥哥？真奇怪，";
		mes "按理说他应该提过这件事。";
		next;
		mes "[里奥岑]";
		mes "哦，是啊，我们住在";
		mes "里希塔乐贫民";
		mes "窟时他就这样。";
		mes "幸运的是";
		mes "，他加入了公司，";
		mes "帮助我们改善了生活……";
		next;
		cutin "lhz_ryo13",2;
		mes "[里奥岑]";
		mes "所以我很感激他";
		mes "让我为他工作。";
		mes "我不能让他失望。";
		mes "总之，回到正事：";
		mes "我们要把这些货物";
		mes "送到卢恩·米德加尔特王国。";
		next;
		cutin "lhz_ryo12",2;
		mes "[里奥岑]";
		mes "我必须确保这些包裹不会损坏，";
		mes "也不会被小偷偷走。你的任务是";
		mes "前往依斯鲁得";
		mes "，在机场找到阿曼先生，";
		mes "告诉他订购的货物已经安全抵达。";
		next;
		set lhz_rekenber,9;
		changequest 12011,12012;
		cutin "lhz_ryo11",2;
		mes "[里奥岑]";
		mes "你把消息告诉";
		mes "阿曼先生后，";
		mes "他会自己来取包裹。";
		mes "不过，我需要留下来";
		mes "暂时守护";
		mes "这些货物。";
		close2;
		cutin "",255;
		end;
	}
	cutin "lhz_ryo12",2;
	mes "[里奥岑]";
	mes "呃，你能不能在这附近";
	mes "走路轻一点";
	mes "，尽量绕开这些堆？";
	mes "是的，这些东";
	mes "西都很脆弱。";
	mes "谢谢，我很感激。";
	close2;
	cutin "",255;
	end;

OnEnter:
	enablenpc "Man#Lyozien";
	end;

OnStop:
	disablenpc "Man#Lyozien";
	end;
}

-	script	::Scamp	HIDDEN_NPC,{

	if(lhz_rekenber > 21)
	{
		mes "[阿曼]";
		mes "哦，你好。我听说";
		mes "你不得不退出了。";
		mes "真是遗憾。";
		mes "要不是你，我的一些包裹";
		mes "可能已经被那";
		mes "些恶棍毁掉了。";
		close;
	}
	else if(lhz_rekenber == 21)
	{
		mes "[阿曼]";
		mes "你不是应该休息一下吗？";
		mes "而且，里奥岑还";
		mes "在飞艇上等你，";
		mes "不是吗？";
		close;
	}
	else if(lhz_rekenber == 20)
	{
		mes "[阿曼]";
		mes "哦，我的包裹到了吗？";
		mes "很好，很好。";
		mes "感谢你辛苦工作。";
		mes "我很惊讶他";
		mes "们到现在还没";
		mes "正式雇用你。";
		next;
		mes "[阿曼]";
		mes "出什么事了吗？";
		mes "你脸色很苍白。嗯，";
		mes "你可以在飞艇";
		mes "上好好休息。";
		mes "哦，别担心";
		mes "，我会处理包裹。";
		set lhz_rekenber,21;
		close;
	}
	else if (lhz_rekenber > 15 && lhz_rekenber < 20)
	{
		mes "[阿曼]";
		mes "哦，你好。我现在没有";
		mes "期待中的包裹，虽然我知道";
		mes "还有几批货物在排队，";
		mes "但你不是应该";
		mes "在里希塔乐吗？";
		close;
	}
	else if(lhz_rekenber == 15)
	{
		mes "[阿曼]";
		mes "你不是应该赶路去向";
		mes "里奥岑报告吗？";
		mes "飞艇起飞前";
		mes "你得快一点。";
		close;
	}
	else if(lhz_rekenber == 14)
	{
		mes "[阿曼]";
		mes "啊，又是你。";
		mes "我想这意味着我的包裹";
		mes "已经安全抵达了";
		mes "。对吗？";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "是的，没错。";
		mes "其实这次我们";
		mes "在运输途中遭到了一群恶棍袭击，";
		mes "包裹也差点被抢走，";
		mes "所以我想问问你是否知道什么……";
		next;
		mes "[阿曼]";
		mes "他们又袭击了？";
		mes "哦，这可不好。";
		mes "嗯，我不知道";
		mes "发生了什么。";
		mes "真希望我能知道他";
		mes "们究竟在谋划什么。";
		next;
		set lhz_rekenber,15;
		mes "[阿曼]";
		mes "现在你应该去向里奥岑报告。";
		mes "我想你保护了我的包裹，";
		mes "谢谢你的辛勤工作。";
		mes "现在我要取走我";
		mes "订购的东西……";
		close;
	}
	else if (lhz_rekenber > 10 && lhz_rekenber < 14)
	{
		mes "[阿曼]";
		mes "哦，又是你。";
		mes "你不是应该登上飞艇，";
		mes "返回施瓦尔茨";
		mes "瓦德共和国吗？";
		mes "你知道还有更多";
		mes "货物在排队吧。";
		close;
	}
	else if(lhz_rekenber == 10)
	{
		mes "[阿曼]";
		mes "谢谢你告诉我";
		mes "订单已经到了。";
		mes "你现在应该回去找里奥岑，";
		mes "完成你的工作。";
		mes "冒险者";
		mes "，也许我们还会再见。";
		close;
	}
	else if(lhz_rekenber == 9)
	{
		mes "[男子]";
		mes "嗯，你真的能把这里";
		mes "称作机场吗？";
		mes "这里太小了，你不觉得吗？";
		mes "不过，我还挺";
		mes "喜欢坐在这里。";
		next;
		mes "[" + strcharinfo(0)";
		mes "+ "]";
		mes "请问，你知道哪里能找到";
		mes "一个叫阿曼的人吗？";
		mes "我有消息要告诉他。";
		next;
		mes "[阿曼]";
		mes "我是阿曼，有什么——";
		mes "哦！你一定是来告诉我";
		mes "包裹已经到了";
		mes "。对吗？";
		next;
		mes "[" + strcharinfo(0)";
		mes "+ "]";
		mes "是、是的，没错。";
		mes "你的包裹已经到了，";
		mes "现在有人看守，";
		mes "等你来取。";
		next;
		mes "[阿曼]";
		mes "啊，知道了。对了，你是";
		mes "里奥岑和凯岑的新员工吗？";
		mes "我以前没见过你。";
		mes "他们终于开始";
		mes "雇用兼职了吗？";
		next;
		mes "[" + strcharinfo(0)";
		mes "+ "]";
		mes "是的，没错。";
		mes "其实我是他们的兼职工。";
		mes "我听说他们很忙，";
		mes "所以就主动来帮忙了。";
		next;
		mes "[阿曼]";
		mes "好吧，好吧。";
		mes "我想你也和";
		mes "里奥岑一样，";
		mes "不知道这些包裹里";
		mes "运的是什么。";
		next;
		mes "[阿曼]";
		mes "反正这些都是机密信息，";
		mes "所以不用担心。谢谢你通知我货物送达";
		mes "。^FFFFFF  ^000000";
		mes "现在你该回去告诉里奥岑了。";
		mes "保重~";
		set lhz_rekenber,10;
		changequest 12012,12013;
		close;
	}
	mes "[男子]";
	mes "嗯，你真的能把这里";
	mes "称作机场吗？这里太小了，";
	mes "你不觉得吗";
	mes "？不过我还挺喜欢";
	mes "坐在这里。";
	close;
}

-	script	#bully1	HIDDEN_NPC,{

OnInit:
	disablenpc "#bully1";
	end;

OnEnter:
	enablenpc "#bully1";
	initnpctimer;
	monster "airplane_01",96,53,"Thug",1592,1,"#bully1::OnMyMobDead";
	monster "airplane_01",87,47,"Thug",1592,1,"#bully1::OnMyMobDead";
	set .bullymobs,2;
	end;

OnReset:
	killmonster "airplane_01","#bully1::OnMyMobDead";
	end;

OnMyMobDead:
	set .bullymobs,.bullymobs -1;
	if(.bullymobs < 1)
	{
		mes "[恶棍]";
		mes "该死！下、下次……";
		mes "下次我们一定会处理掉";
		mes "那些该死的包裹！";
		mes "^333333*咳咳*^000000 现在先撤退，";
		mes "改天再战！";
		close2;
		donpcevent "#bully1::OnInit";
		donpcevent "Man#Lyozien::OnEnter";
		stopnpctimer;
	}
	end;

OnTimer120000:
	donpcevent "#bully1::OnReset";
	donpcevent "#bully1::OnInit";
	donpcevent "Man#Lyozien::OnEnter";
	stopnpctimer;
	end;
}


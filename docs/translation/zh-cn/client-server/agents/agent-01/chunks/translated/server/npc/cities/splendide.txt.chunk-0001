// ep13_spl_extra
spl_in01,172,225,3	script	Wandering Poet#ep13	51,{
	cutin "god_nelluad02",2;
	mes "[诗人妮莉欧德]";
	mes "嗨~~你听到远处传来的美妙音乐了吗~？";
	next;
	select("你是谁？");
	cutin "god_nelluad01",2;
	mes "[诗人妮莉欧德]";
	mes "我吗……？";
	mes "我只是个享受氛围的诗人……";
	next;
	mes "[诗人妮莉欧德]";
	mes "我前几天来到这里，想记录这个新世界，他们允许我跟随冒险者来到此地。";
	next;
	mes "[诗人妮莉欧德]";
	mes "我和拉赫熟悉起来。";
	mes "一开始很尴尬……因为我不懂他们的语言。";
	mes "但当我开始演奏乐器……他们就喜欢上了。";
	next;
	mes "[诗人妮莉欧德]";
	mes "他们是懂得享受生活的妖精……";
	mes "他们多么快乐……";
	mes "他们非常好奇……能遇见他们是我的荣幸……";
	next;
	mes "[诗人妮莉欧德]";
	mes "那么，你想听我演奏吗？";
	next;
	switch(select("好啊。:不太想。")) {
	case 1:
		mes "[诗人妮莉欧德]";
		mes "你想听哪首歌？";
		next;
		switch(select("布莱奇诗人:永恒混沌:黄昏刺客:尼伯龙根之戒")) {
		case 1:
			cutin "god_nelluad02",2;
			mes "[诗人妮莉欧德]";
			mes "布莱奇诗人！";
			mes "你一定很有鉴赏力。";
			soundeffect "bragis_poem.wav",0;
			break;

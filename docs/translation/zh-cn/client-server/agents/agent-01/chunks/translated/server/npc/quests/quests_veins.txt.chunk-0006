		mes "沙啦啦啦啦啦";
		mes "普隆德拉骑士要";
		mes "守护宫殿~";
		mes "沙呼呼呼啊啊啊";
		mes "吉芬骑士要";
		mes "守护魔法塔~";
		next;
		mes "[盖兹]";
		mes "啦啦啦啦啦啦";
		mes "普隆德拉！吉芬！骑士们";
		mes "团结起来！守护宫殿！";
		mes "哦哦哦哦哦哦耶！";
		mes "然后粉碎西边的敌人！";
		mes "这就是秘密计划！啦啦啦~";
		next;
		mes "[盖兹]";
		mes "很有诗意吧？";
		mes "现在把你听到的这首歌";
		mes "原样唱给维特听。";
		set que_sch,22;
		close;
	}
	else if (que_sch < 30) {
		mes "[盖兹]";
		mes "你想再听一次我的歌？";
		mes "好吧，不过这次一定要全部记住。";
		next;
		mes "[盖兹]";
		mes "沙啦啦啦啦啦";
		mes "普隆德拉骑士要守护宫殿~";
		mes "沙呼呼呼啊啊啊";
		mes "吉芬骑士要守护魔法塔~";
		next;
		mes "[盖兹]";
		mes "啦啦啦啦啦啦";
		mes "普隆德拉！吉芬！骑士们团结起来！";
		mes "守护宫殿！哦哦哦哦哦哦耶！";
		mes "粉碎西边的敌人！这就是秘密计划！啦啦啦~";
		next;
		mes "[盖兹]";
		mes "很有诗意吧？";
		mes "现在把你听到的这首歌原样唱给维特听。";
		close;
	}
	else {
		mes "[盖兹]";
		mes "我完蛋了……";
		mes ".......";
		close;
	}
}

comodo,135,299,0	script	Young Man#sch2	809,{
	if (que_sch < 22) {
		mes "[诺斯丹]";
		mes "你是来听我的歌的吗？";
		mes "啊，欢迎你来欣赏我美妙的歌声——等等，";
		mes "你要去哪儿？";
		close;
	}
	else if (que_sch == 22) {
		mes "[诺斯丹]";
		mes "啊，你就是维特在信里提到的人？";

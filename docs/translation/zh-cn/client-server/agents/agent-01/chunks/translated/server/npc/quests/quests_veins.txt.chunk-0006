		mes "你觉得怎么样？";
		mes "呃，别问我歌词。";
		mes "我想那只是奇怪的艺术风格。";
		mes "哦，请替我把这首歌唱给维特听，好吗？";
		set que_sch,23;
		close;
	}
	else if (que_sch < 30) {
		mes "[诺斯丹]";
		mes "哦，你还想再听我的歌？";
		mes "没问题！看来你真的很喜欢~";
		next;
		mes "[诺斯丹]";
		mes "谁敢阻挡无畏的战士？巴风特？德雷克？";
		mes "不，他们太弱了！他的脚步正走向企图复活撒旦梦罗克的邪恶组织。真是的！";
		next;
		mes "[诺斯丹]";
		mes "老战友传来悲伤的消息，邪恶组织已经被发现……";
		mes "是时候阻止撒旦梦罗克复活了~";
		mes "啦啦啦啦啦啦啦啦啦啦啦啦啦啦啦啦啦啦";
		next;
		mes "[诺斯丹]";
		mes "你觉得怎么样？";
		mes "呃，别问我歌词。那只是奇怪的艺术风格。";
		mes "请替我把这首歌唱给维特听，好吗？";
		close;

sec_in02,10,43,4	script	Extra Story Patch	809,{
	callfunc "F_GM_NPC";
		mes "[补丁]";
		mes "可以，你试试吧。";
	next;
		if(select("现在:多少？") == 2) {
		input .@input,0,1000;
		set que_sch, .@input;
	}
	mes " ";
	mes ""+que_sch;
	close;
}


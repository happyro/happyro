veins,327,185,3	script	Kid#camelcamel	944,{
	if (MISC_QUEST & 8192) {
		if (rachel_camel == 0) {
			mes "[卡琳]";
			mes "*抽泣*";
			next;
			mes "^3355FF这个哭泣的孩子看起来非常难过……^000000";
			next;
			mes "["+strcharinfo(0)+"]";
			mes "嘿，你为什么哭？";
			mes "你迷路了吗？你妈妈在哪里？";
			next;
			mes "[卡琳]";
			mes "我……妈妈在家……";
			next;
			mes "["+strcharinfo(0)+"]";
			mes "......";
			mes ".........";
			next;
			mes "["+strcharinfo(0)+"]";
			mes "这样啊。那么……";
			mes "你找不到回家的路了吗？";
			next;
			mes "[卡琳]";
			mes "不！我已经十岁了！";
			mes "就算闭着眼睛，我也能找到回家的路！";
			mes "^333333*吸鼻子*^000000 呜呜呜呜~";
			next;
			mes "["+strcharinfo(0)+"]";
		mes "嗯……";
			next;
			mes "["+strcharinfo(0)+"]";
			mes "你能告诉我为什么哭吗？";
			next;
			mes "[卡琳]";
			mes "我……^333333*吸鼻子*^000000";
			mes "我、我去了……托……";
			mes "火山……和、和我的";
			mes "妹妹——哇啊啊啊！";
			next;
			mes "["+strcharinfo(0)+"]";
			mes "可怜的孩子……来，深呼吸，";
			mes "慢慢告诉我发生了什么。";
			next;
			mes "[卡琳]";
			mes "*^333333抽泣*^000000……只是……";
			mes "我和妹妹去了托尔火山，想看看谁更勇敢……";
			mes "可是后来，我们遇到了一些……";
			mes "很可怕的人……然后……";
			next;
			mes "[卡琳]";
			mes "我害怕了，所以……所以……";
			mes "我的妹妹……呜~！*抽泣*";
			next;
			mes "[卡琳]";
			mes "*抽泣*";
			next;
			mes "[卡琳]";
			mes "我、我从他们那里逃走了……";
			mes "但我把妹妹留在那里，和那些奇怪的男人在一起……";
			next;
			mes "[卡琳]";
			mes "妈妈生病了，爸爸总是在工作……";
			mes "他是船长，所以……我觉得他们帮不上忙。";
			next;
			mes "[卡琳]";
			mes "你能帮帮我，把妹妹带回来吗？";
			mes "*吸鼻子* 求你了？我保证爸爸回来后就付钱给你！";
			next;
			mes "["+strcharinfo(0)+"]";
			mes "等等……我有个问题。";
			mes "你说有人在托尔火山带走了你妹妹？";
			mes "他们长什么样？你确定那里有人吗？";
			next;
			mes "[卡琳]";
			mes "我……我不知道！";
			mes "我太害怕了，只能逃走！";
			mes "我、我不是故意丢下妹妹的！";
			next;
			mes "["+strcharinfo(0)+"]";
			mes "嗯……";
			mes "也许你的妹妹被强盗绑架了……";
			next;
			switch(select("拒绝请求:接受请求")) {
			case 1:
				mes "["+strcharinfo(0)+"]";
				mes "抱歉，孩子，但我还有事要做。";
				mes "我相信会有其他人来救你的妹妹。";
				next;
				mes "[卡琳]";
				mes "哇~";
				close;
			case 2:
				mes "["+strcharinfo(0)+"]";
				mes "好吧，我会尽力而为。";
				mes "我会试着找到你的妹妹。";
				next;
				mes "[卡琳]";
				mes "非常感谢你！";
				mes "请尽快找到我的妹妹柯蒂！";
				mes "希望她没事！如果她出事了……";
				mes "^333333*抽泣*^000000 我不知道该怎么办！哇啊啊啊~";
				next;
				mes "["+strcharinfo(0)+"]";
				mes "好吧……祝我好运。";
				mes "我会去托尔火山寻找你的妹妹柯蒂。";
				setquest 3060;
				set rachel_camel,1;
				close;
			}
		}
		else if (rachel_camel == 1) {
			mes "["+strcharinfo(0)+"]";
		mes "我最好去托尔火山寻找柯蒂，";
		mes "卡琳的妹妹。";
			close;
		}
		else if (rachel_camel == 2) {
		mes "[卡琳]";
		mes "你、你找到我妹妹了吗？";
		mes "她没事吧？发生了什么？";
			next;
			mes "["+strcharinfo(0)+"]";
		mes "我找到她了，她没事，但是……";
			next;
		mes "[卡琳]";
		mes "什么？她为什么没和你一起回来？";
			next;
			mes "["+strcharinfo(0)+"]";
		mes "柯蒂……嗯，她被锁住了。";
		mes "我们得想办法把她救出来。";
		mes "你知道哪里有能帮她的铁匠或锁匠吗？";
			next;
		mes "[卡琳]";
		mes "哦！市场街上有一位锁匠！";
		mes "你可以请他帮忙解救柯蒂！";
			changequest 3061,3062;
			set rachel_camel,3;
			close;
		}
		else if (rachel_camel == 3) {
			mes "[卡琳]";
			mes "让我想想……";
			mes "我最好去市场街找锁匠，";
			mes "请他帮我解开柯蒂的镣铐。";
			close;
		}
		else if (rachel_camel == 4) {
			mes "[卡琳]";
			mes "嗯……我最好先去找洛肯洛克先生，";
			mes "就是市场街上的锁匠。";
			close;
		}
		else if (rachel_camel == 5) {
			mes "["+strcharinfo(0)+"]";
			mes "嗯……如果想帮助卡琳解救妹妹柯蒂，";
			mes "我最好去找有机肥皂制作者艾沃里女士。";
			close;
		}
		else if (rachel_camel == 6) {
			mes "["+strcharinfo(0)+"]";
			mes "等等……我应该把所有肥皂材料";
			mes "带给艾沃里女士。";
			mes "都有哪些来着……？";
			next;
			mes "["+strcharinfo(0)+"]";
			mes "^4D4DFF10 个牛奶^000000、";
			mes "^4D4DFF100 个绿色药草^000000、";
			mes "^4D4DFF50 个杰勒比^000000和";
			mes "^4D4DFF5 个空瓶^000000。";
			mes "我最好去收集这些……";
			close;
		}
		else if (rachel_camel == 7) {
			mes "["+strcharinfo(0)+"]";
			mes "我需要和一个叫萨拉曼的人谈谈，";
			mes "取得制作肥皂的材料……";
			close;
		}
		else if (rachel_camel == 8) {
			mes "["+strcharinfo(0)+"]";
			mes "让我想想……";
			mes "我需要把萨拉曼先生刺激骆驼食欲所需的一切带给他。";
			mes "我需要取得……";
			next;
			mes "["+strcharinfo(0)+"]";
			mes "^4D4DFF1 个未成熟的苹果^000000、";
			mes "^4D4DFF5 个魔物饲料^000000、";
			mes "^4D4DFF1 个空瓶^000000和";
			mes "^4D4DFF1 瓶黄色药水^000000。";
			close;
		}
		else if (rachel_camel == 9) {
			mes "["+strcharinfo(0)+"]";
			mes "刺激骆驼食欲的东西都准备好了。";
			mes "现在我需要喂骆驼，";
			mes "这样才能取得肥皂材料和 5 块骆驼粪便。";
			close;
		}
		else if (rachel_camel == 10) {
			mes "["+strcharinfo(0)+"]";
			mes "现在我最好花时间寻找丝质沙漠骆驼，";
			mes "取得所需材料。";
			close;
		}
		else if (rachel_camel == 11) {
			mes "["+strcharinfo(0)+"]";
			mes "我最好找到萨拉曼先生走失的骆驼，";
			mes "喂它骆驼食欲刺激剂，";
			mes "然后取得肥皂材料和 5 块骆驼粪便，";
			mes "这样才能解救柯蒂。";
			close;
		}
		else if (rachel_camel > 11 && rachel_camel < 17) {
			mes "["+strcharinfo(0)+"]";
			mes "嗯……我找到骆驼了。";
			mes "现在需要取得所有肥皂材料。";
			mes "越快完成，就越快能帮助柯蒂。";
			close;
		}
		else if (rachel_camel == 17) {
			mes "["+strcharinfo(0)+"]";
			mes "我拿到了肥皂材料和 5 块骆驼粪便。";
			mes "我应该回去告诉萨拉曼先生他的骆驼在哪里，";
			mes "然后去找艾沃里女士。";
			close;
		}
		else if (rachel_camel == 18) {
			mes "["+strcharinfo(0)+"]";
			mes "让我想想……";
			mes "我现在是不是该去找艾沃里女士？";
			close;
		}
		else if (rachel_camel == 19) {
			mes "["+strcharinfo(0)+"]";
			mes "我已经拿到丝质沙漠骆驼肥皂了，";
			mes "现在应该把它带给洛肯洛克先生。";
			close;
		}
		else if (rachel_camel == 20) {
			mes "["+strcharinfo(0)+"]";
			mes "我最好用肥皂制作钥匙模具，";
			mes "然后带给洛肯洛克先生。";
			close;
		}
		else if (rachel_camel == 21) {
			mes "["+strcharinfo(0)+"]";
			mes "制作钥匙比告诉卡琳发生了什么更重要。";
			close;
		}
		else if (rachel_camel == 22) {
			mes "["+strcharinfo(0)+"]";
			mes "我需要带 1 个钢铁给洛肯洛克先生，";
			mes "这样他才能制作最终解救柯蒂的钥匙。";
			close;
		}
		else if (rachel_camel == 23) {
			mes "["+strcharinfo(0)+"]";
			mes "我终于拿到能解救柯蒂的钥匙了。";
			mes "现在我要去救她。";
			next;
			mes "[卡琳]";
			mes "非常感谢你！";
			mes "请尽快把柯蒂带回来！^333333*抽泣*^000000";

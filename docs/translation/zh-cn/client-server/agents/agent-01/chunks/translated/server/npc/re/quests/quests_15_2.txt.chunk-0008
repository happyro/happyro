		mes "[Bunker Sayhu]";
		mes "...";
		next;
		mes "[Bunker Sayhu]";
		mes "呼……光是想想就让我头晕。我们两个都很幸运。你不觉得吗？";
		next;
		select("我也这么认为。");
		emotion 28;
		mes "[Bunker Sayhu]";
		mes "不过我很同情她。看来很多人都把这次爆炸归咎于弗雷莎。";
		next;
		mes "[Bunker Sayhu]";
		mes "爆炸不可能只由洛娜负责。";
		next;
		select("洛娜？");
		emotion 1, playerattached();
		mes "[Bunker Sayhu]";
		mes "尽管实验失败了，她确实是个了不起的人。";
		next;
		mes "[Bunker Sayhu]";
		mes "在那种混乱的情况下，她负责查明幸存者人数。";
		next;
		mes "[Bunker Sayhu]";
		mes "如果是我……";
		next;
		mes "[Bunker Sayhu]";
		mes "我现在大概会不知所措地四处乱转……";
		next;
		mes "[Bunker Sayhu]";
		mes "唉——看来连我也该去帮忙。你想帮忙吗？";
		next;
		select("同意帮忙。");
		emotion 15;
		mes "[Bunker Sayhu]";
		mes "真的吗？你愿意帮忙？太好了，我本来没信心独自去。";
		next;
		mes "[Bunker Sayhu]";
		mes "这个房间中央有一位态度冷淡的研究员，对吧？";
		next;
		mes "[Bunker Sayhu]";
		mes "她是实验负责人洛娜·弗雷莎。大家通常叫她弗雷莎博士。";
		next;
		if (isbegin_quest(5370) == 1)
			erasequest 5370;
		setquest 5341;
		setquest 5342;
		mes "[Bunker Sayhu]";
		mes "要不要去问问她是否需要帮助？";
		close;
	}
	if (.@cooldown_status_day[0] == 1) {
		.@quest_day_1 = 
			isbegin_quest(5342) + isbegin_quest(5343) + isbegin_quest(5344) + isbegin_quest(5345) + isbegin_quest(5346) + 
			isbegin_quest(5347) + isbegin_quest(5348) + isbegin_quest(5349) + isbegin_quest(5350);
		switch(.@quest_day_1) {
		case 1:
			mes "[Bunker Sayhu]";
			mes "这个房间中央有一位态度冷淡的研究员，对吧？";
			next;
			mes "[Bunker Sayhu]";
			mes "要不要去问问她是否需要帮助？";
			close;
		case 2:
		case 3:
			mes "[Bunker Sayhu]";
			mes "有人让我查明有多少人会做饭。";
			next;
			mes "[Bunker Sayhu]";
			mes "虽然防空洞复杂又宽广，我们也必须努力。";
			close;
		default:
			mes "[Bunker Sayhu]";
			mes "谢谢你帮助她。";
			next;
			mes "[Bunker Sayhu]";
			mes "是因为我们帮忙了吗？我好像看到她脸上露出了一丝微笑。";
			close;
		}
	}
	if (.@cooldown_status_day[1] == 1) {
		emotion 1;
		mes "[Bunker Sayhu]";
		mes "呃？！我以前没在防空洞见过你吧？";
		next;
		mes "[Bunker Sayhu]";
		mes "啊！你就是帮忙搬运新制空气净化装置的冒险者？";
		next;
		mes "[Bunker Sayhu]";
		mes "那些不顾后果的机械工让你做了很多工作。";
		close;
	}
	if (.@cooldown_status_day[2] == 1) {
		mes "[Bunker Sayhu]";
		mes "生物工程师成功培育葡萄了，对吧？";
		next;
		mes "[Bunker Sayhu]";
		mes "听说每两周至少可以收获一次葡萄？收获日大概就是今天或明天。";
		next;
		mes "[Bunker Sayhu]";
		mes "我想尽快尝尝新鲜葡萄。最近几天我一直只吃干粮。";
		close;
	}
	if (.@cooldown_status_day[3] == 1) {
		mes "[Bunker Sayhu]";
		mes "防空洞里流传着一个传言。";
		next;
		mes "[Bunker Sayhu]";
		mes "不久前，化学物质专家和其他几个人离开了防空洞。";
		next;
		mes "[Bunker Sayhu]";
		mes "据说有某种污染物进入了防空洞。";
		next;
		mes "[Bunker Sayhu]";
		mes "我听说因为污染物，抽搐患者的数量正在迅速增加。";
		next;
		mes "[Bunker Sayhu]";
		mes "啊！这只是传言！传言！！";
		close;
	}
	if (.@cooldown_status_day[4] == 1) {
		mes "[Bunker Sayhu]";
		mes "看来流传的传言是真的。";
		next;
		mes "[Bunker Sayhu]";
		mes "我听说他们正把物资搬到刚开放的清洁 Z-2 区，因为那里受到了污染。";
		next;
		mes "[Bunker Sayhu]";
		mes "我想哪怕只能帮一点忙，也应该出手。";
		close;
	}
	mes "[Bunker Sayhu]";
	mes "很高兴见到你，我叫防空洞赛胡。";
	close;
}

un_bk_q,93,168,4	script	Dr.Fresa#EP15.2MR	4_F_BERRYTEA,{
	callfunc( "F_time_limit_recorder", .@cooldown_status_day );
	if (.@cooldown_status_day[0] == 1) {
		.@quest_day_1 = 
			isbegin_quest(5342) + isbegin_quest(5343) + isbegin_quest(5344) + isbegin_quest(5345) + isbegin_quest(5346) + 
			isbegin_quest(5347) + isbegin_quest(5348) + isbegin_quest(5349) + isbegin_quest(5350);
		switch(.@quest_day_1) {
		case 1:
			emotion 17;
			mes "[Lona Fresa]";
			mes "抱歉。我现在有几个问题要处理，有点忙。我们稍后再谈好吗？";
			next;
			select("不！我的意思是……");
			emotion 0;
			emotion 1;
			mes "[Lona Fresa]";
			mes "什么？！冒险者想帮我？";
			next;
			mes "[Lona Fresa]";
			mes "很好。人们因为震惊和混乱而无法控制。";
			next;
			mes "[Lona Fresa]";
			mes "如果有令人敬畏的冒险者帮忙，就更容易控制混乱的人群。";
			next;
			mes "[Lona Fresa]";
			mes "很好！！我同意。正好赶上一个棘手的问题。";
			next;
			select("棘手的问题？");
			emotion 1, playerattached();
			mes "[Lona Fresa]";
			mes "像你这样拥有各种专长的人员没有变更岗位，比较容易掌握，但其他员工才是问题。";
			next;
			mes "[Lona Fresa]";
			mes "他们应该都按照各自团队的紧急情况指南行动。";
			next;
			emotion 20;
			mes "[Lona Fresa]";
			mes "我无法从这里弄清楚他们在哪里、正在做什么。";
			next;
			mes "[Lona Fresa]";
			mes "所以我在想，你是否能";
			next;
			.@r = rand(1,4);
			setquest (5342 + .@r);
			mes "[Lona Fresa]";
			if (.@r == 1)
				mes "你能查明^0000FF生物工程师^000000的人数吗？";
			else if (.@r == 2)
				mes "你能查明^0000FF机械工^000000的人数吗？";
			else if (.@r == 3)
				mes "你能查明^0000FF设施管理员^000000的人数吗？";
			else
				mes "你能查明^0000FF化学物质专家^000000的人数吗？";
			next;
			mes "[Lona Fresa]";
			mes "我知道在这个巨大而复杂的防空洞里做这件事并不容易，但还是想拜托你。";
			close;
		case 2:
			emotion 0;
			emotion 1;
			mes "[Lona Fresa]";
			mes "嗯？！你已经回来了？比我想的早。";
			next;
			mes "[Lona Fresa]";
			mes "我拜托你的事……啊？！啊！！";
			next;
			mes "[Lona Fresa]";
			if (isbegin_quest(5343) == 1)
				mes "^0000FF生物工程师^000000的人数？据说有多少人幸存？";
			else if (isbegin_quest(5344) == 1)
				mes "^0000FF机械工^000000的人数？据说有多少人幸存？";
			else if (isbegin_quest(5345) == 1)
				mes "^0000FF设施管理员^000000的人数？据说有多少人幸存？";
			else
				mes "^0000FF化学物质专家^000000的人数？据说有多少人幸存？";
			next;
			input(.@num,1,99);
			mes "[Lona Fresa]";
			mes "" + .@num + " 人？你说的是这个人数？";
			next;
			emotion 20;
			mes "[Lona Fresa]";
			mes "真奇怪？根据名单，他们从来没有这个人数。";
			next;
			mes "[Lona Fresa]";
			mes "你能再确认一次吗？";
			close;
		case 3:
			emotion 0;
			mes "[Lona Fresa]";
			mes "啊！你来了。防空洞内部是不是有点复杂？我拜托你的事……";
			next;
			mes "[Lona Fresa]";
			if (isbegin_quest(5343) == 1)
				mes "^0000FF生物工程师^000000的人数？据说有多少人幸存？";
			else if (isbegin_quest(5344) == 1)
				mes "^0000FF机械工^000000的人数？据说有多少人幸存？";
			else if (isbegin_quest(5345) == 1)
				mes "^0000FF设施管理员^000000的人数？据说有多少人幸存？";
			else
				mes "^0000FF化学物质专家^000000的人数？据说有多少人幸存？";
			next;
			input(.@num,1,99);
			if (.@num != ep15_2_memory) {
				mes "[Lona Fresa]";
				mes "" + .@num + " 人？你说的是这个人数？";
				next;
				mes "[Lona Fresa]";
				mes "真奇怪？根据名单，他们从来没有这个人数。";
				next;
				mes "[Lona Fresa]";
				mes "你能再确认一次吗？";
				close;
			}
			mes "[Lona Fresa]";
			mes "真的吗？和名单上的人数大致相同。做得好。";
			next;
			mes "[Lona Fresa]";
			mes "赛胡说冒险者喜欢这种东西。这是你帮忙的报酬。";
			next;
			mes "小小的圆形胶囊渗入了皮肤。感觉经验正在积累。";
			next;
			for ( .@i = 5342; .@i < 5351; ++.@i ) {
				if (isbegin_quest(.@i) > 0)
					erasequest .@i;
			}
			ep15_2_memory = 0;
			setquest 5370;
			getexp 750000,750000;
			mes "[Lona Fresa]";
			mes "做得好。我知道这很令人沮丧，但希望在外面的情况变得安全之前，你能适应防空洞里的生活。";
			close;
		default:
			mes "[Lona Fresa]";
			mes "做得好。我知道这很令人沮丧，但希望在外面的情况变得安全之前，你能适应防空洞里的生活。";
			close;
		}
	}
	if (.@cooldown_status_day[1] == 1 || .@cooldown_status_day[2] == 1) {
		emotion 17;
		mes "[Lona Fresa]";
		mes "抱歉。我现在有几个问题要处理，有点忙。我们稍后再谈好吗？";
		close;
	}
	if (.@cooldown_status_day[3] == 1) {
		.@quest_day_4 = isbegin_quest(5364) + isbegin_quest(5365);
		if (.@quest_day_4 == 1) {
			mes "[Lona Fresa]";
			mes "你是怎么进来的？真奇怪！";
			close;
		}
		if (.@quest_day_4 == 2) {
			emotion 17;
			mes "[Lona Fresa]";
			mes "抱歉。我现在有几个问题要处理，有点忙。我们稍后再谈好吗？";
			next;
			select("我有紧急的事情要告诉你。");
			mes "[Lona Fresa]";
			mes "什么？！发生什么事了？";
			next;
			mes "说明临时诊所的现状。";
			next;
			emotion 23;
			mes "[Lona Fresa]";
			mes "患者同时出现抽搐……情况不妙。";
			next;
			mes "[Lona Fresa]";
			mes "我明白了。我们必须采取措施。";
			next;
			if (isbegin_quest(5364) > 0)
				erasequest 5364;
			if (isbegin_quest(5365) > 0)
				erasequest 5365;
			setquest 5370;
			getexp 750000,750000;
			mes "小小的圆形胶囊渗入了皮肤。感觉经验正在积累。";
			next;
			mes "[Lona Fresa]";
			mes "谢谢你告诉我。";
			close;
		}
		emotion 19;
		mes "[Lona Fresa]";
		mes "情况很严重，所以我们必须尽快采取措施。";
		close;
	}
	emotion 17;
	mes "[Lona Fresa]";
	mes "抱歉。我现在有几个问题要处理，有点忙。我们稍后再谈好吗？";
	close;
}


spl_fild01,375,109,0	script	to_dun01#ep13_2	-1,2,2,{
OnTouch:
	if (ep13_mdrama == 5) {
		mes "巨树根部的缝隙里缠着一根茎……看起来有什么东西从这里滑下去了。";
		next;
		mes "树木深处吹出一阵冷风。";
		next;
		switch(select("沿着踪迹前进。:看起来很危险……回去。")) {
		case 1:
			mes "你小心地穿过泥泞的根部向前一步，却滑倒了。";
			set ep13_mdrama,6;
			close2;
			percentheal -30,0;
			warp "nyd_dun01",72,125;
			end;
		case 2:
			mes "里面太暗什么也看不见……但感觉底部有个大洞。最好退后……看起来很危险。";
			close;
		}
	}
	else if (ep13_mdrama > 5) {
		mes "巨大的根部之间有个通往地下洞穴的洞。";
		next;
		switch(select("进去。:我不进去。")) {
		case 1:
			mes "你再次从泥泞的根部滑了下去。";
			close2;
			percentheal -30,0;
			warp "nyd_dun01",72,125;
			end;
		case 2:
			mes "你决定稍后再回来。";
			close;
		}
	}
	else {
		mes "奇怪的茎缠在巨树根部的缝隙里。表面看起来不稳定……最好离远点，免得滑倒。";
		close;
	}
}

nyd_dun01,58,223,0	script	Petrified Sapha#ep13md03	844,{
	if (checkweight(1201,2) == 0) {
		mes "等一下！！你的物品太多了。无法领取这个物品。请减轻负重后再试。";
		close;
	}
	if (ep13_mdrama == 6) {
		mes "这里是唯一有阳光从天花板洞口照下来的地方。";
		next;
		mes "抬头看，树根和茎穿过泥墙，让阳光照进来……地上有一座巨人雕像。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "这种地方竟然有雕像……真有趣。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "嗯，这像是……马努克的巨人部族……咦？它戴着围巾……不可能！";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "它身上有很多伤疤……仿佛经历过激烈战斗……";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "它似乎还抱着什么东西……这里究竟发生了什么？";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "无法想象这里发生过什么，但已经看不到特拉的痕迹……洞穴也不安全，先回去找阿克吧。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "难道……特拉曾与这个巨人战斗？";
		set ep13_mdrama,7;
		changequest 7057,7058;
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "总之……怎么离开这里？进来的洞太滑，爬不出去……";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "阳光从上方天花板照进来……也许可以沿附近的茎爬上去……";
		close;
	}
	else if ((ep13_mdrama == 7) || (ep13_mdrama == 8)) {
		mes "[" + strcharinfo(0) + "]";
		mes "我受够这里了。该回去找阿克……先找出口。";
		close;
	}
	else if (ep13_mdrama == 9) {
		mes "我回到这里，却没有特拉的踪迹……和上次唯一不同的是，萨法尸体周围散落着少量矿石颗粒。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "所以……特拉来过这里……粉末状布拉迪姆……她想对这个萨法做什么？";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "不能什么都没找到就回阿克那里……他会很失望……嗯，要不要去萨法村？";
		set ep13_mdrama,10;
		changequest 7059,7060;
		close;
	}
	else if (ep13_mdrama == 10) {
		mes "[" + strcharinfo(0) + "]";
		mes "我再也找不到特拉的踪迹了。让我在意的是……这些矿石颗粒。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "我应该回去问阿克，或者去萨法村继续调查。";
		close;
	}
	else if ((ep13_mdrama > 10) && (ep13_mdrama < 21)) {
		mes "这里石化着一个萨法族巨人。看起来已经死了……";
		close;
	}
	else if (ep13_mdrama == 21) {
		mes "我需要带回洞穴里这个巨人的证据。应该带什么？";
		next;
		switch(select("头发:围巾:裤子:布拉迪姆碎片")) {
		case 1:
			mes "取不下来，就像树根扎在岩石上一样。";
			close;
		case 2:
			mes "你小心地从萨法颈部取下磨损的围巾。看看这是否属于奥根。";
			next;
			mes "还有……我该带什么？";
			next;
			switch(select("头发:裤子:布拉迪姆碎片")) {
			case 1:
				mes "取不下来，就像树根扎在岩石上一样。";
				close;
			case 2:
				mes "……我不想脱下死人的裤子……";
				close;
			case 3:
			mes "你捡起地上散落的一块布拉迪姆碎片。这应该够了。";
				set ep13_mdrama,22;
				getitem 6085,1; //Shaggy_Muffler
				getitem 6084,1; //Bradium_Fragments
				changequest 7066,7067;
				close;
			}
		case 3:
			mes "……我不想脱下死人的裤子……";
			close;
		case 4:
			mes "你捡起地上散落的一块布拉迪姆碎片。";
			mes "这能证明特拉的努力……还有什么？";
			next;
			switch(select("头发:围巾:裤子")) {
			case 1:
				mes "取不下来，就像树根扎在岩石上一样。";
				close;
			case 2:
				mes "你小心地从萨法颈部取下磨损的围巾。看看这是否属于奥根……这应该够了。";
				set ep13_mdrama,22;
				getitem 6085,1; //Shaggy_Muffler
				getitem 6084,1; //Bradium_Fragments
				changequest 7066,7067;
				close;
			case 3:
				mes "……我不想脱下死人的裤子……";
				close;
			}
		}
	}
	else if (ep13_mdrama == 22) {
		mes "石化的萨法。现在拿到围巾了，回去找路易克和斯诺伦吧。";
		close;
	}
	else if (ep13_mdrama == 23) {
		if (isequipped(2782) == 1) {
			donpcevent "Snorren#ep13md17::OnEnable";
	mes "[斯诺伦]";
			mes "奥根！！！！！！";
				mes "……奥根……奥根……";
				mes "……奥根……";
			next;
			select("你不是说……？");
	mes "[斯诺伦]";
			mes "这……比我想象的更糟……奥根……看来无法逆转……";
			next;
	mes "[斯诺伦]";
			mes "无论注入多少布拉迪姆液体……奥根都无法复活……";
			next;
	mes "[斯诺伦]";
			mes "奥根……为了保护特拉……一直坚定地保护那个拉比内……他坚持到了最后……";
			next;
	mes "[斯诺伦]";
			mes "看看这个，"+strcharinfo(0)+"……他的石化身体……就这样保护了特拉。";
			next;
	mes "[斯诺伦]";
			mes "奥根……把自己变成了坚不可摧的盾牌……";
			next;
	mes "[斯诺伦]";
			mes "奥根……你现在可以回到祖国的怀抱了……这座雕像将成为你勇气的纪念碑……";
			next;
			mes "- - 我无法描述失去亲密朋友的悲痛…… -";
			next;
			mes "- 我能做的只有不停拍拍他的肩膀……而他默默地抽泣…… -";
			next;
			mes "[" + strcharinfo(0) + "]";
			mes "我们……回去吧……奥根不希望你如此悲伤消沉。";
			next;
	mes "[斯诺伦]";
			mes "你说得对……这里有阳光照耀……这一定是奥根安详休息的地方。";
			next;
	mes "[斯诺伦]";
			mes "我该去告诉路易克和村民……我先走了。";
			next;
			donpcevent "Snorren#ep13md17::OnDisable";
				mes "- 斯诺伦带着苦涩的微笑站了起来……";
				mes "- 我也该回去了……我很担心特拉。-";
			set ep13_mdrama,24;
			changequest 7068,7069;
			close;
		}
		else {
			mes "[" + strcharinfo(0) + "]";
			mes "哇，我差点忘了戒指。";
			close;
		}
	}
	else if (ep13_mdrama > 23) {
		mes "奥根……为了保护特拉而石化……他们之间究竟发生了什么，竟能超越种族差异？";
		close;
	}
	else {
		// custom translation
		mes "你面前是一座由石头和木头组成的雕像，栩栩如生得令人毛骨悚然。";
		close;
	}
}


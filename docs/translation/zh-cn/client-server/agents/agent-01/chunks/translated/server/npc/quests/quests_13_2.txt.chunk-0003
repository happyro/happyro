		mes "仔细一看，发现有一根打结的茎……这似乎就是阿克告诉我的特拉踪迹。";
		next;
		mes "打结的叶子指向^4d4dff北方^000000。";
		close2;
	}
	else {
		mes "这里很容易找到杂草……没什么特别的。";
		close2;
	}
	cutin "ep13_plant01",255;
	end;
}

spl_fild02,328,323,0	script	????#ep13_mdplant04	844,{

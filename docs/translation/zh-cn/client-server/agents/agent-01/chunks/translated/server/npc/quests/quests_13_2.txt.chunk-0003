}
manuk,278,177,5	script	Villager#ep13_11	454,{
	if (checkweight(1201,2) == 0) {
		mes "等一下！！你的物品太多了。无法领取这个物品。请减轻负重后再试。";
		close;
	}
	if (isequipped(2782) == 1) {
		if (ep13_mdrama == 10) {
	mes "[村民拉维内]";
			mes "对了，那个妖精怎么会来到这么远的地方？她被抓了吗？";
			next;
	mes "[村民里维尔]";
			mes "不，她没有。那个妖精是自己来到这里的。";
			mes "真无礼。她来时受了重伤。";
			next;
			mes "[" + strcharinfo(0) + "]";
			mes "（嗯？妖精？受伤了？";
			mes "（他们说的是特拉吗……？！）";
			next;
				switch(select("打断他们的谈话。:保持安静并倾听。")) {
			case 1:
				mes "[" + strcharinfo(0) + "]";
				mes "抱歉打断你们的谈话。你们在谈妖精，可以告诉我详情吗？";
				next;
		mes "[村民拉维内]";
				mes "外来者！！他为什么在这里？";
				next;
		mes "[村民里维尔]";
				mes "我们什么也没说。没什么可告诉你的。拉维娜，之后和我一起去精炼厂。";
				next;
				mes "- 萨帕人不愿告诉你任何事情。但被抓的";
				mes "- 被抓的妖精可能是特拉。 -";
				set ep13_mdrama,11;
				changequest 7060,7061;
				close;
			case 2:
				// Custom Translation
				mes "[村民拉维内]";
				mes "我听说有个妖精哭着哀求，伤得很重。";
				next;
				mes "[村民里维尔]";
				mes "没人听得懂妖精的话……最后我们也不知道该怎么办。";
				next;
				mes "[村民里维尔]";
				mes "总之，那个妖精现在被关起来了。对了，今天要去精炼厂，别忘了。";
				next;
				mes "[村民拉维内]";
				mes "你知道吧？啊！是外国访客！";
				next;
				mes "[村民里维尔]";
				mes "别管他，他听不懂我们的话。";
				next;
				mes "- 幸运的是，萨帕人以为我听不懂他们的话，";
				mes "- 但他们一定在谈特拉…… -";
				set ep13_mdrama,11;
				changequest 7060,7061;
				close;
			}
		}
		else if (ep13_mdrama > 10) {
			mes "- 萨帕人正在交谈，没有注意我的动向。-";
			next;
			mes "- 他们主要在谈论城镇琐事，没有多少有用信息。-";
			next;
			mes "- 我最好在他们怀疑我之前离开这里。-";
			close;
		}
		else {
	mes "[村民]";
			mes "……外来者？";
			mes "你有进入我们村子的许可吗？对了……你听得懂我吗？";
			close;
		}
	}
	else {
		mes "[村民]";
		mes "什么？";
		mes "听不懂！";
		mes "他说的是外来者。";
		close;
	}
}


nyd_dun01,62,233,0	script	Trunk of a Tree#ep13	844,2,2,{
	mes "树干向上延伸。这里有足够大的荆棘，可以当作落脚点向上攀爬。";
	close;

OnTouch:
	mes "这是伸向天花板洞口的树干。大荆棘可以当作落脚点。";
	next;
	switch(select("爬上去。:算了。")) {
		case 1:

		npctalk "如果你不阻止我，我就毁掉一切！", "Chulho#JQ_SH_2", bc_self;
		cutin "ex_sh_chulho01.png",2;
		next;
		mes "[哲浩]";
		mes "<FONT SIZE = 16>走吧！</FONT>";
		mes "<FONT SIZE = 16>快点！！</FONT>";
		emotion ET_GO, getnpcid(0,"Chulho#JQ_SH_2");
		erasequest 11780;
		setquest 11781;
		close2;
		cutin "",255;
		cloakonnpcself( "Chulho#JQ_SH_2" );
		navigateto("pay_fild09",108,346);
		end;
	}
	if (isbegin_quest(11781) == 1) {
		// Debug (npcs not uncloaked on official server)
		cloakoffnpcself( "???#JQ_SH_k" );
		cloakoffnpcself( "Chulho#JQ_SH_2" );

		mes "[基苏尔]";
		mes "既然我没兴趣了，那就回家吧。";
		emotion ET_SLEEPY, getnpcid(0,"???#JQ_SH_k");
		npctalk "真无聊~", "???#JQ_SH_k", bc_self;
		next;
		mes "[哲浩]";
		mes "哦！";
		mes "你不打算阻止我吗？";
		cutin "ex_sh_chulho01.png",2;
		emotion ET_HUK, getnpcid(0,"Chulho#JQ_SH_2");
		next;
		mes "[基苏尔]";
		mes "不，算了。";
		mes "他已经陷入困境，应该会自己处理吧？";
		cutin "ex_sh_kisul00.png",2;
		next;
		mes "[基苏尔]";
		mes "看起来会很有趣。";
		mes "嘿嘿嘿。";
		cutin "ex_sh_kisul00.png",2;
		emotion ET_KIK, getnpcid(0,"???#JQ_SH_k");
		next;
		cloakonnpcself( "???#JQ_SH_k" );
		mes "[哲浩]";
		mes "<FONT SIZE = 14>喘气！</FONT>";
		mes "<FONT SIZE = 14>没错！</FONT>";
		mes "<FONT SIZE = 14>我遇到麻烦了！</FONT>";
		cutin "ex_sh_chulho02.png",2;
		npctalk "疯了！！！", "Chulho#JQ_SH_2", bc_self;
		next;
		mes "[哲浩]";
		mes "<FONT SIZE = 14>如果贤禄发现他给朋友们吃了奇怪的药，还挖遍森林制作奇怪的东西，一定会遇到大麻烦！！</FONT>";
		npctalk "如果你不阻止我，我就毁掉一切！", "Chulho#JQ_SH_2", bc_self;
		cutin "ex_sh_chulho01.png",2;
		next;
		mes "[哲浩]";
		mes "<FONT SIZE = 16>走吧！</FONT>";
		mes "<FONT SIZE = 16>快点！！</FONT>";
		emotion ET_GO, getnpcid(0,"Chulho#JQ_SH_2");
		close2;
		cutin "",255;
		cloakonnpcself( "Chulho#JQ_SH_2" );
		navigateto("pay_fild09",108,346);
		end;
	}
	end;

OnInit:
	questinfo( QTYPE_JOBQUEST, QMARK_YELLOW, "isbegin_quest(11780) == 1" );
	end;
}

// Step 13, 15
pay_fild09,109,344,5	duplicate(dummy_cloaked_npc)	Chulho#JQ_SH_door	4_EXJOB_CHUL_HO

pay_fild09,108,346,3	script	Suspicious Light#JQ_SH	4_ENERGY_WHITE,{
	if (isbegin_quest(11770) == 0) {
		mes "- 可以看到可疑的涟漪。-";
		close;
	}
	// !TODO: unknown dialog for steps [2-12]
	if (isbegin_quest(11781) == 1) {
		mes "[哲浩]";
		mes "<FONT SIZE = 14>糟糕！</FONT>";
		mes "<FONT SIZE = 14>这可怕的气氛是什么！</FONT>";
		mes "<FONT SIZE = 14>果然，贤禄似乎注意到了！</FONT>";
		cloakoffnpcself( "Chulho#JQ_SH_door" );
		cutin "ex_sh_chulho02.png",2;
		next;
		mes "[哲浩]";
		mes "<FONT SIZE = 14>如果我们遇到大麻烦怎么办？</FONT>";
		mes "<FONT SIZE = 14>快点进去阻止贤禄。</FONT>";
		npctalk "贤禄生气时真的很可怕！", "Chulho#JQ_SH_door", bc_self;
		erasequest 11781;
		setquest 11782;
		next;
		cloakonnpcself( "Chulho#JQ_SH_door" );
		cutin "",255;
	}
	if (isbegin_quest(11782) == 1) {
		.@md_name$ = "Deep Forest";

		mes "- 哲浩消失的地方出现了可疑的涟漪。-";
		next;
		if (is_party_leader() == true) {	// !TODO: confirm if it's solo party
			.@menu$[0] = "Open the door.";
			.@menu$[1] = "Enter.";
		}
		switch( select( .@menu$[0], .@menu$[1], "退出。" ) ) {
		case 1:
			if (is_party_leader() == true)
				instance_create(.@md_name$);
			end;
		case 2:
			if (is_party_leader() == true) {
				switch( instance_enter(.@md_name$) ) {
				case IE_OTHER:
					mes "^ff0000发生未知错误。^000000";
					close;
				case IE_NOINSTANCE:
					mes "- 摇晃看起来令人不安。";
					mes "等一会儿再进去吧。-";
					close;
				case IE_NOMEMBER:
					end;
				case IE_OK:
			mapannounce "pay_fild09", "" + strcharinfo(0) + " 所在的队伍正在进入 " + .@md_name$ + "。", bc_map, 0xFF99;
					// warp "1@exsh",90,35;
					end;
				}
				end;
			}
			end;
		case 3:
			end;
		}
		end;
	}
	if (isbegin_quest(11769) == 1) {
		if (checkweight(490087,1) == 0) {
			// !TODO: unknown dialog
			mes "- 请稍等！！-";
			mes "- 你携带的物品太多。-";
			mes "- 因此无法再获得物品。-";
			mes "- 请腾出空间-";
			mes "- 再试一次。-";
			close;
		}
		if (SkillPoint > 0) {
			// !TODO: unknown dialog
			mes "[哲浩]";
			mes "请用完所有技能点后再继续。";
			close3;
		}
		mes "[哲浩]";
		mes "<FONT SIZE = 14>我等你很久了！</FONT>";
		mes "<FONT SIZE = 14>现在很难来到深林，不过仔细想想，我只要出来玩就行！</FONT>";
		mes "<FONT SIZE = 14>虽然贤禄不会出来！</FONT>";
		cloakoffnpcself( "Chulho#JQ_SH_door" );
		cutin "ex_sh_chulho01.png",2;
		next;
		mes "[哲浩]";
		mes "<FONT SIZE = 14>哦，这是贤禄的信！</FONT>";
		mes "<FONT SIZE = 14>读读看吧！</FONT>";
		cutin "ex_sh_chulho03.png",2;
		next;
		if (select( "阅读信件。", "停止。" ) == 2) {
			// !TODO: unknown dialog
			cutin "",255;
			cloakonnpcself( "Chulho#JQ_SH_door" );
			end;
		}
		mes "[贤禄的信]";
		mes "亲爱的" + strcharinfo(0) + "。";
		cutin "ex_sh_hyunrok00.png",2;
		next;
		mes "[贤禄的信]";
		mes "仅仅触碰你的衣服就产生了联系……";
		mes "你进入这片森林、我们相遇的原因，一定都是上天决定的命运。";
		next;
		mes "[贤禄的信]";
		mes "即使我们没有正确看待这段关系，在当时的事件中也很无礼，我永远不会忘记你在危难中帮助我们的恩情。";
		next;
		mes "[贤禄的信]";
		mes "正如哲浩所说，我本想至少举办宴会报答你，但长时间待在深林对外来者很危险，所以连好好道别都没有就匆忙送你回去，我心里很沉重。";
		next;
		mes "[贤禄的信]";
		mes "我相信你会理解，因为我是为了你好。";
		next;
		mes "[贤禄的信]";
		mes "这不是对你帮助的小小回报，而是铭刻在我们灵魂中的力量，需要帮助时我们就能唤起它。";
		next;
		mes "[贤禄的信]";
		mes "那么，期待我们再次相见……";
		next;
		mes "[哲浩]";
		mes "<FONT SIZE = 14>信读完了吗？</FONT>";
		mes "<FONT SIZE = 14>上面写了什么？</FONT>";
		cutin "ex_sh_chulho01.png",2;
		next;
		select( "展示信件。" );
		mes "[哲浩]";
		mes "<FONT SIZE = 14>贤禄总是说些难懂的话！</FONT>";
		mes "<FONT SIZE = 14>还有这个也拿去！</FONT>";
		mes "<FONT SIZE = 14>因为是有趣的物品，我一直保存着，但现在送给你！</FONT>";
		cutin "ex_sh_chulho02.png",2;
		completequest 11769;
		jobchange JOB_SPIRIT_HANDLER;
		getitem 490087,1;	// 4th_Q_Necklace
		close2;
		cutin "",255;
		cloakonnpcself( "Chulho#JQ_SH_door" );
		end;
	}
	if (isbegin_quest(11769) == 2) {
		mes "[哲浩]";
		mes "<FONT SIZE = 14>再见啦</FONT>";
		mes "<FONT SIZE = 14>我只是出去玩玩。</FONT>";
		cutin "ex_sh_chulho01.png",2;
		cloakoffnpcself( "Chulho#JQ_SH_door" );
		next;
		mes "[哲浩]";
		mes "<FONT SIZE = 14>森林外面有好多好玩的！</FONT>";
		mes "<FONT SIZE = 14>当然森林里也很有趣！</FONT>";
		close2;
		cutin "",255;
		cloakonnpcself( "Chulho#JQ_SH_door" );
		end;
	}
	end;

OnInit:
	// Step 13
	questinfo( QTYPE_JOBQUEST, QMARK_YELLOW, "isbegin_quest(11781) == 1" );

	// Step 14
	questinfo( QTYPE_JOBQUEST, QMARK_YELLOW, "isbegin_quest(11782) == 1" );

	// Step 15
	questinfo( QTYPE_JOBQUEST, QMARK_YELLOW, "isbegin_quest(11769) == 1" );
	end;
}


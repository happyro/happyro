		mes "[囚犯 243AD265]";
		mes "总之，很抱歉我帮不上你的忙。";
		next;
		emotion ET_QUESTION;
		mes "[囚犯 243AD265]";
		mes "人类冒险者，虽然我帮不上你，但能请你帮我一个忙吗？";
		next;
		select("说来听听吧？");
		mes "[囚犯 243AD265]";
		mes "谢谢。我曾经是水手，在海上航行。";
		next;
		mes "[囚犯 243AD265]";
		mes "航海时我遇到过许多水手。有讨人喜欢的，有爱吹牛的，也有胆小的……";
		next;
		emotion ET_BLABLA;
		mes "- 囚犯似乎回忆起过去，用拳头捶打着左胸。-";
		next;
		mes "[囚犯 243AD265]";
		mes "是的，我遇到过各式各样的水手。但来到这里后，我们不得不分开……";
		next;
		mes "[囚犯 243AD265]";
		mes "我记得自己一直在这里，但那个声音……最近才在这里出现。";
		next;
		mes "[囚犯 243AD265]";
		mes "虽然听不清……但我能听见黑暗深处传来的声音，正在呼唤我……";
		next;
		mes "[囚犯 243AD265]";
		mes "你能替我找到一位老朋友吗？他应该被关在监狱的某处。";
		next;
		select("交给我吧。");
		setquest 5416;// Restricted Sector A
		setquest 5425;// To My Beloved Fellow
		mes "[囚犯 243AD265]";
		mes "谢谢。我希望那就是我朋友的呼喊。";
		close;
	case 1:
		if (countitem(6925) < 1) {
			mes "[Prisoner 243AD265]";
		mes "拜托了。我希望那是我的朋友。你不知道我等了多久。";
			close;
		}
		emotion ET_SPARK;
		mes "[Prisoner 243AD265]";
		mes "你终于来了！那个声音是什么？你见到我的朋友了吗？";
		next;
		mes "- 你向他解释了朋友身上发生的事。-";
		next;
		mes "[Prisoner 243AD265]";
		mes "所以我在黑暗中听到的确实是朋友的声音。我本希望他平安无事。";
		next;
		mes "[Prisoner 243AD265]";
		mes "所以他已经不在了……虽然那件事已经过去很久，但仍然令人遗憾。";
		next;
		mes "[Prisoner 243AD265]";
		mes "非常感谢你替我查清这件事，我感激不尽。";
		next;
		mes "[Prisoner 243AD265]";
		mes "对了，我还没问你的名字。你叫什么？";
		next;
		select("告诉他你的名字。");
		mes "[Prisoner 243AD265]";
		mes "" + strcharinfo(0) + "....";
		next;
		emotion ET_BLABLA;
		mes "- 囚犯握紧拳头，捶打着左胸。-";
		next;
		delitem 6925,1;// Prisoner_Letter
		completequest 5425;// To My Beloved Fellow
		setquest 5426;// [Stand by]To My Beloved Fellow
		getexp 700000,500000;
		getitem 6919,4;// TokenOfHonor
		mes "[Prisoner 243AD265]";
		mes "我会把你的名字刻在这里。希望你继续成为我和朋友之间的信使。";
		close;
	case 2:
		switch( checkquest(5426,PLAYTIME) ) {
		case -1:
			if (isbegin_quest(5427) == 0) {
				emotion ET_SPARK;
				mes "[囚犯 243AD265]";
				mes "你好，"+strcharinfo(0)+"。";
				mes "你能再次找到我的老朋友，把他的故事带给我吗？";
				next;
				if (select( "交给我吧。", "我今天很忙。" ) == 2) {
					emotion ET_OTL;
					mes "[囚犯 243AD265]";
					mes "这样啊？真遗憾。有时间记得再来……";
					close;
				}
				setquest 5427;// [Repeat]To My Beloved Fellow
				mes "[囚犯 243AD265]";
				mes "我就指望你了。";
				close;
			}
			if (countitem(6925) < 1) {
				mes "[囚犯 243AD265]";
				mes "我等不及要听了。";
				close;
			}
			mes "[囚犯 243AD265]";
			mes "我欠你一个大人情，你无法想象。";
			next;
			emotion ET_BLABLA;
			mes "- 囚犯握紧拳头，捶打着左胸。-";
			next;
			delitem 6925,1;// Prisoner_Letter
			erasequest 5427;// [Repeat]To My Beloved Fellow
			setquest 5426;// [Stand by]To My Beloved Fellow
			getexp 700000,500000;
			getitem 6919,4;// TokenOfHonor
			mes "[囚犯 243AD265]";
			mes "我会把你的名字刻在这里。希望你继续成为我和朋友之间的信使。";
			close;
		case 0:
		case 1:
			mes "[囚犯 243AD265]";
			mes "既然朋友暂时脱离了死亡，我想知道他在做什么，也想知道他下一封信会写下怎样的回忆。";
			next;
			mes "囚犯开始歌唱，仿佛在回忆某件事。";
			close2;
			setpcblock PCBLOCK_NPC, true;
			switch( rand(1,5) ) {
			case 1:
				npctalk "囚犯 243AD265：再见~~再会~~我亲爱的女士~~", "", bc_self;
				sleep2 2000;
				npctalk "囚犯 243AD265：我奉命~~回到~~故乡~~", "", bc_self;
				sleep2 2000;
				npctalk "囚犯 243AD265：如果我这么做，就再也见不到你了，我美丽的女士~~", "", bc_self;
				sleep2 2000;
				npctalk "囚犯 243AD265：再见~~再会~~我亲爱的女士~~", "", bc_self;
				sleep2 2000;
				npctalk "囚犯 243AD265：我们会尖叫~~我们会呐喊~~", "", bc_self;
				sleep2 2000;
				npctalk "囚犯 243AD265：即使在海上~~我们也会尖叫~~我们也会呐喊~~", "", bc_self;
				sleep2 2000;
				npctalk "囚犯 243AD265：再见~~再会~~我亲爱的女士~~", "", bc_self;
				sleep2 2000;
				npctalk "囚犯 243AD265：伙计们~~把杯子倒满~~全部喝光~~", "", bc_self;
				sleep2 2000;
				npctalk "囚犯 243AD265：这是给男子汉的~~我们很悲伤~~喝个痛快吧~~", "", bc_self;
				sleep2 2000;
				npctalk "囚犯 243AD265：再见~~再会~~我亲爱的女士~~", "", bc_self;
				sleep2 2000;
				npctalk "囚犯 243AD265：我奉命~~回到~~故乡~~", "", bc_self;
				sleep2 2000;
				npctalk "囚犯 243AD265：如果我这么做，就再也见不到你了，我美丽的女士~~", "", bc_self;
				break;
			case 2:
				npctalk "囚犯 243AD265：听好了~~年轻的伙计们~~让我告诉你们那片令人好奇的大海~~", "", bc_self;
				sleep2 2000;
				npctalk "囚犯 243AD265：风在吹~~暴风雨也来了~~", "", bc_self;
				sleep2 2000;
				npctalk "囚犯 243AD265：风开始吹起时~~大家都聚在这里~~", "", bc_self;
				sleep2 2000;
				npctalk "囚犯 243AD265：听好了~~年轻的伙计们~~让我告诉你们那片令人好奇的大海~~", "", bc_self;
				sleep2 2000;
				 npctalk "囚犯 243AD265：风在吹~~暴风雨要来了~~", "", bc_self;
				sleep2 2000;
				npctalk "囚犯 243AD265：风在吹~~船正在航行~~", "", bc_self;
				sleep2 2000;
				npctalk "囚犯 243AD265：听好了~~年轻的伙计们~~让我告诉你们那片令人好奇的大海~~", "", bc_self;
				sleep2 2000;
				npctalk "囚犯 243AD265：鳗鱼飞翔，摆动着鱼鳍~~", "", bc_self;
				sleep2 2000;
				npctalk "囚犯 243AD265：我们扬起风帆，躲开礁石~~", "", bc_self;
				sleep2 2000;
				npctalk "囚犯 243AD265：听好了~~年轻的伙计们~~让我告诉你们那片令人好奇的大海~~", "", bc_self;
				sleep2 2000;
				npctalk "囚犯 243AD265：尖牙鲨鱼正在游泳~~", "", bc_self;
				sleep2 2000;
				npctalk "囚犯 243AD265：如果你吃面包~~我就吃肉~~", "", bc_self;
				sleep2 2000;
				npctalk "囚犯 243AD265：听好了~~年轻的伙计们~~让我告诉你们那片令人好奇的大海~~", "", bc_self;
				sleep2 2000;
				npctalk "囚犯 243AD265：巨大的鲸鱼~~正在游泳~~", "", bc_self;
				sleep2 2000;
				npctalk "囚犯 243AD265：如果你想要风~~让我制造一阵风~~", "", bc_self;
				sleep2 2000;
				npctalk "囚犯 243AD265：听好了~~年轻的伙计们~~让我告诉你们那片令人好奇的大海~~", "", bc_self;
				break;
			case 3:
				npctalk "囚犯 243AD265：我们要回家~~我们要回家~~", "", bc_self;
				sleep2 2000;
				npctalk "囚犯 243AD265：向前走~~向前走~~你好~~女士~~", "", bc_self;
				sleep2 2000;
				npctalk "囚犯 243AD265：当我们回家~~回家以后~~我们会好好对待父母~~一定会~~", "", bc_self;
				sleep2 2000;
				npctalk "囚犯 243AD265：向前走~~向前走~~你好~~女士~~", "", bc_self;
				sleep2 2000;
				npctalk "囚犯 243AD265：这里的女士~~漂亮~~又有趣~~她真是~~", "", bc_self;
				sleep2 2000;
				npctalk "囚犯 243AD265：向前走~~向前走~~你好~~女士~~", "", bc_self;
				sleep2 2000;
				npctalk "囚犯 243AD265：辛苦赚来的钱~~花掉吧~~全部花掉~~", "", bc_self;
				sleep2 2000;
				npctalk "囚犯 243AD265：向前走~~向前走~~你好~~女士~~", "", bc_self;
				sleep2 2000;
				npctalk "囚犯 243AD265：跳舞吧~~跳舞~~直到~~我们回家~~尽情跳舞~~", "", bc_self;
				sleep2 2000;
				npctalk "囚犯 243AD265：向前走~~向前走~~你好~~女士~~", "", bc_self;
				sleep2 2000;
				npctalk "囚犯 243AD265：当我们回家~~回家以后~~我们会和未婚妻跳舞~~", "", bc_self;
				sleep2 2000;
				npctalk "囚犯 243AD265：向前走~~向前走~~你好~~女士~~", "", bc_self;
				sleep2 2000;
				npctalk "囚犯 243AD265：向爱人道别~~向爱人道别~~道别~~喝光~~尽情跳舞~~跳舞~~", "", bc_self;
				sleep2 2000;
				npctalk "囚犯 243AD265：向前走~~向前走~~你好~~女士~~", "", bc_self;
				break;
			case 4:
				npctalk "囚犯 243AD265：嘿，嘿~~让船起航~~嘿，嘿~~让它起航~~", "", bc_self;
				sleep2 2000;
				npctalk "囚犯 243AD265：清晨~~在清晨~~", "", bc_self;
				sleep2 2000;
				npctalk "囚犯 243AD265：我们该拿醉醺醺的水手怎么办~~醉醺醺的水手该怎么办~~", "", bc_self;
				sleep2 2000;
				npctalk "囚犯 243AD265：清晨~~在清晨~~", "", bc_self;
				sleep2 2000;
				npctalk "囚犯 243AD265：插入水管~~把它塞进排水孔~~插入水管~~把它塞进排水孔~~", "", bc_self;
				sleep2 2000;
				npctalk "囚犯 243AD265：清晨~~在清晨~~", "", bc_self;
				sleep2 2000;
				npctalk "囚犯 243AD265：他醒来时~~把他锁在船舱里~~他醒来时~~把他锁在船舱里~~", "", bc_self;
				sleep2 2000;
				npctalk "囚犯 243AD265：清晨~~在清晨~~", "", bc_self;
				break;
			case 5:
				npctalk "囚犯 243AD265：喂~~伙计~~清晨时分~~", "", bc_self;
				sleep2 2000;
				npctalk "囚犯 243AD265：喂~~伙计~~扬起风帆~~", "", bc_self;
				sleep2 2000;
				npctalk "囚犯 243AD265：喂~~伙计~~倒上酒~~", "", bc_self;
				sleep2 2000;
				npctalk "囚犯 243AD265：喂~~伙计~~唱首歌~~", "", bc_self;
				sleep2 2000;
				npctalk "囚犯 243AD265：喂~~伙计~~", "", bc_self;
				break;
			}
			sleep2 2000;
			npctalk "囚犯 243AD265：…… …… ……", "", bc_self;
			sleep2 2000;
			setpcblock PCBLOCK_NPC, false;
			emotion ET_HNG;
			npctalk "囚犯 243AD265：身边没有水手伙伴时，一点也不好玩。", "", bc_self;
			end;
		case 2:
			erasequest 5426;// [Stand by]To My Beloved Fellow
			mes "[囚犯 243AD265]";
			mes "已经到听取我老朋友消息的时候了吗？";
			close;
		}
	}
}

prt_prison,205,139,4	script	Dark Shape#EP161A01	4_GHOST_STAND,{
	if (checkweight(1301,1) == 0) {
		mes "- 你携带的物品太多，无法继续任务。-";
		close;
	}
	if ((isbegin_quest(5425) != 1 && isbegin_quest(5427) != 1) || countitem(6925) > 0)
		mes "黑暗形体漂浮在黑暗空间中。我一表现出兴趣，它就消失得无影无踪。";
	else if (isbegin_quest(5427) == 1) {
		mes "黑暗形体看到我后开始摇摆。它是在为见到我而高兴吗？";
		next;
		select("还有别的东西要给我吗？");
		getitem 6925,1;// Prisoner_Letter
		mes "黑暗形体把信交给你后消失了。";
		next;
		playbgm "148";
		mes "黑暗形体似乎心情很好，哼着歌。";
	}
	else {
		mes "黑暗形体漂浮在黑暗空间中。我该对它做什么？";
		next;
		select("询问它是否是 243AD265 的朋友。");
		mes "[Dark Shape]";
		mes "那……你……倒下……风……";
		next;
		select("... ... ... ?");
		mes "[Dark Shape]";
		mes "……是……这样……谁……以及……它";
		next;
		select("... ... ... ?");
		mes "[Dark Shape]";
		mes "……我……看见……那……空气……呃……";
		next;
		mes "你完全听不懂它在说什么，但从它对你话语的回应来看，它应该就是囚犯 243AD265 的朋友。";
		next;
		mes "你该怎么做？";
		next;
		if (select( "直接离开。", "再等一会儿。" ) == 2) {
			getitem 6925,1;// Prisoner_Letter
			mes "黑暗形体把信交给你后离开了。它是想让你把信送出去吗？";
		}
		else {
			mes "由于无法有效沟通，你越来越焦躁，于是决定离开。";
			next;
			mes "黑暗形体似乎注意到了这一点，也消失得无影无踪。";
		}
	}
	.@num = atoi( replacestr( strnpcinfo(2), "EP161A0", "" ) );
	setarray .@npc_num[1],1,2,3,4,5;
	deletearray .@npc_num[.@num],1;
	disablenpc();
	enablenpc "Dark Shape#EP161A0" + .@npc_num[ rand(1,4) ];// enable another npc randomly
	close;

OnInit:
	.@npc_num = atoi( replacestr( strnpcinfo(2), "EP161A0", "" ) );
	if (.num_enabled == 0)
		.num_enabled = rand(1,5);
	if (.num_enabled != .@npc_num)
		disablenpc();// disable 4/5 npcs
	end;
}
prt_prison,153,175,4	duplicate(Dark Shape#EP161A01)	Dark Shape#EP161A02	4_GHOST_STAND
prt_prison,160,224,6	duplicate(Dark Shape#EP161A01)	Dark Shape#EP161A03	4_GHOST_STAND
prt_prison,169,81,6	duplicate(Dark Shape#EP161A01)	Dark Shape#EP161A04	4_GHOST_STAND
prt_prison,203,215,4	duplicate(Dark Shape#EP161A01)	Dark Shape#EP161A05	4_GHOST_STAND

// Sector B
prt_prison,267,184,8	script	Prisoner 267BD184#EP161B	4_DRACULA,{
	if (checkweight(1301,1) == 0) {
		mes "- 你携带的物品太多，无法继续任务。-";
		close;
	}
	if (isbegin_quest(5415) < 2) {// Restricted Sector
		emotion ET_SLEEPY;
		mes "这里的囚犯看起来极其无聊。现在和他交谈，你可能得坐下来陪他。";
		close;
	}
	if (BaseLevel < 140) {
		mes "[囚犯 267BD184]";
		mes "是的，正如你想的我很无聊，但我不能陪你。为什么？因为你没有我想要的那种眼睛。";
		close;
	}
	switch( isbegin_quest(5428) ) {
	case 0:
		emotion ET_COOL;
		mes "[囚犯 267BD184]";
		mes "嘿！对，就是铁栏外的你。你的眼睛真漂亮，正合我的胃口。";
		next;
		mes "[囚犯 267BD184]";
		mes "请好心送我一只眼睛吧。我会好好珍惜。";
		next;
		emotion ET_PROFUSELY_SWEAT, playerattached();
		mes "[" + strcharinfo(0) + "]";
		mes "哇，你也太直接了。";
		next;
		emotion ET_CRY;
		mes "[囚犯 267BD184]";
		mes "是吗？因为你的眼睛太漂亮了。";
		mes "就算给我一只，你还剩一只。有什么难的？";
		next;
		emotion ET_HNG;
		mes "[囚犯 267BD184]";
		mes "你可真贪心。";
		next;
		mes "[囚犯 267BD184]";
		mes "既然你这么说，那能抽时间和我聊聊吗？";
		next;
		if (select( "我可以。", "不。" ) == 2) {
			emotion ET_FRET;
			mes "[囚犯 267BD184]";
			mes "你真直接。既然你这么说……";
			close;
		}
		mes "[囚犯 267BD184]";
		mes "好吧！我们先聊什么？";
		next;
		mes "[囚犯 267BD184]";
		mes "这样吧，你知道人们指控我什么吗？说我骗婚！";
		next;
		emotion ET_FRET;
		mes "[囚犯 267BD184]";
		mes "骗婚？荒唐！我看起来像会骗别人和我结婚的人吗？";
		next;
		emotion ET_THINK, playerattached();
		mes "[" + strcharinfo(0) + "]";
		mes "嗯，呃……";
		next;
		mes "[囚犯 267BD184]";
		mes "哦？你也这么想？";
		next;
		mes "[囚犯 267BD184]";
		mes "漂亮的眼睛没用！你应该开阔心胸，配得上那双漂亮的小眼睛！";
		next;
		emotion ET_COOL;
		mes "[囚犯 267BD184]";
		mes "我只是被那位有着漂亮眼睛的女人吸引了。那是纯粹的爱情。人们不理解我。";
		next;
		emotion ET_SURPRISE;
		mes "[囚犯 267BD184]";
		mes "哦，我想起来了。是的，有一群家伙在地下城里随意走动。";
		next;
		mes "[囚犯 267BD184]";
		mes "我觉得很奇怪，最近还发现那些长着蝙蝠翅膀的调皮家伙，虽然它们甚至不是蝙蝠。";
		next;
		emotion ET_OK;
		mes "[囚犯 267BD184]";
		mes "它们确实很调皮，但我觉得它们有漂亮的蓝眼睛。";
		next;
		mes "[囚犯 267BD184]";
		mes "所以我告诉它们，只要交给我那些蓝宝石，我就大方地放它们带着翅膀通过。";
		next;
		mes "[囚犯 267BD184]";
		mes "但它们不听。";
		next;
		mes "[囚犯 267BD184]";
		mes "不过它们可能会听你的，因为你有漂亮的眼睛。";
		next;
		mes "[囚犯 267BD184]";
		mes "你能去问它们要那些漂亮宝石吗？我不能离开这里。";
		next;
		setquest 5417;// Restricted Sector B
		setquest 5428;// Lowly Standards
		mes "[囚犯 267BD184]";
		mes "如果它们不听，你直接拿走不就好了？要 20 个怎么样？我给你特别许可。";
		close;
	case 1:
		if (countitem(6924) < 20) {
		mes "[囚犯 267BD184]";

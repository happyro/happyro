//===== rAthena Script =======================================
//= Nameless Island Quests
//===== Description: =========================================
//= [Official Conversion]
//= Collection of Nameless Island Quests
//= Nameless Island:
//= - Quest to gain access to Nameless Island and dungeon.
//= - Variable in use: aru_monas  (Max: 26)
//= Peace for Arunafeltz:
//- - Help to keep peace between Arunafeltz and Midgard.
//= - Variable in use: aru_em (Max: 23)
//= Muff's Loan:
//- - Help Muff clear his Debt and get his collateral back.
//= - prerequisite Quest to "Broken Diamond"
//= - Variable in use: diamond_edq (Max: 14)
//= Broken Diamond:
//- - Help Ibrahim retrieve his stolen diamond.
//= - prerequisite Quest to "Unlucky Emerald"
//= - Variable in use: diamond_edq (Max: 26)
//= Z-Gang Quest:
//- - Help to aprehend the infamous Z-Gang.
//= - Variable in use: zdan_edq (Max: 19)
//= Unlucky Emerald:
//- - Help a treasure hunter from Prontera get home, and 
//=   learn the origins of the Unlucky Emerald.
//= - Variable in use: treasure_nd (Max: 12)
//= - Variable in use: jewel_nd (Max: 31)
//= Rogue Guild Investigation Assistance:
//- - Assist the Rogue Guild with their investigations.
//= - Variable in use: rumour_nd (Max: 22)
//===== Changelog: ===========================================
//= 1.0 First version. [L0ne_W0lf]
//= 1.1 Made quest accessable to "Failed" Geoborg quest. [L0ne_W0lf]
//= 1.1a Touch up to other Geoborg fail-points. [L0ne_W0lf]
//= 1.2 Some final tuning to Nameless Island quest. [Koca]
//= 1.3 Should fix any more issues with "Creature" npc. [L0ne_W0lf]
//= 1.4 Changed the way Out_from_Monastery works slightly. [L0ne_W0lf]
//= 1.5 added a next to stop double npc message [Yommy]
//= 1.6 Updated the Nameless Island Access quest
//=     Added Quest: Peace for Arunafeltz
//=     Added Quest: Muff's Loan
//=     Added Quest: Broken Diamond
//=     Added Quest: Z-Gang Quest
//=     Added Quest: Unlucky Emerald
//=     Added Quest: Rogue Guild Investigation
//= 1.7 Fixed a typo in monestary quest. [L0ne_W0lf]
//= 1.8 Renamed temporary global variable. [L0ne_W0lf]
//=     moved OnMyMobDead for access quest to a different NPC.
//= 1.9 Fixed mapwarp warping to disabled map. [L0ne_W0lf]
//= 2.0 Removed duplicate dialog. [L0ne_W0lf]
//= 2.1 Fixed a race condition blocking progress. [brianluau]
//= 2.2 Added quest log entries for:
//=     - Muff's Loan
//=     - Broken Diamond
//=     - Z-Gang Quest
//= 2.2a Fixed a few job constant typos. [Euphy]
//= 2.3 Updated RE/Pre-RE EXP. [Euphy]
//= 2.4 Moved Dorian to pre-re/re paths. [Euphy]
//= 2.5 Updated Nameless Island quests and added questlog support. [Euphy]
//= 2.6 Commented custom quest log support for the Nameless Island Quest [Everade]
//============================================================

// Nameless Island and Cursed Monestary Access Quest :: aru_monas
//============================================================
airplane_01,90,63,0	script	Event Switch#pc	-1,3,3,{
	end;

OnTouch:
	if ((prt_curse == 36 || prt_curse == 45 || prt_curse == 56 || prt_curse == 61) && (aru_monas < 1)) {
		hideoffnpc "Agent#pc1";
		mes "[？？？？]";
		mes "你是"+strcharinfo(0)+"吗？";
		mes "我一直在等你。";
		mes "^6B8E23班普神父^000000正在";
		mes "^6B8E23普隆德拉^000000的";
		mes "^6B8E23教堂^000000等你。";
		mes "请尽快去见他。";
		set aru_monas,1;
		//setquest 17000;
		close2;
		hideonnpc "Agent#pc1";
	}
	end;
}

airplane_01,95,61,3	script	Agent#pc1	899,{
	end;

OnInit:
	hideonnpc "Agent#pc1";
	end;
}

cmd_in02,174,89,7	script	Ordinary Man#pc1	97,{
	if (aru_monas < 2) {
		mes "[Larjes]";
		mes "该死，我又输了！";
		mes "这游戏肯定有问题！";
		mes "不管我怎么尝试，";
		mes "好像永远都赢不了！";
		mes "但科莫多德州扑克";
		mes "实在……太让人上瘾了！";
		close;
	}
	else if (aru_monas == 2) {
		mes "[Larjes]";
		mes "啊，我在这个游戏里输太多次了，";
		mes "多到完全数不清！";
		mes "我总有一天";
		mes "得赢一次……";
		next;
		select("打扰一下。");
		mes "[Larjes]";
		mes "哦！呃……嗯……";
		mes "我能帮你什么？";
		next;
		select ("^6B8E23班普神父^000000派我来的。");
		mes "[Larjes]";
		mes "哦，我明白了。";
		mes "如果我的叫喊让你不舒服，";
		mes "我向你道歉。";
		mes "我只是来打发时间的，";
		mes "现在我亲身体会到，";
		mes "赌博确实很邪恶！";
		next;
		mes "[Larjes]";
		mes "呃，你能到这边来吗？";
		mes "我不想让";
		mes "其他人";
		mes "听到我们的谈话。";
		close2;
		set aru_monas,3;
		warp "cmd_in02",110,53;
		end;
	}
	else {
		mes "[Larjes]";
		mes "什么？！";
		mes "我又输了？";
		mes "这游戏……这游戏到底怎么玩？！";
		close;
	}
}

cmd_in02,111,52,3	script	Ordinary Man#pc2	97,{
	if (aru_monas < 3) {
		mes "[Larjes]";
		mes "^666666*叹气……*^000000";
		mes "这完全不妙。";
		mes "我不知道该怎么办……";
		close;
	}
		else if (aru_monas == 3) {
			mes "[Larjes]";
			mes "很好，在这里没人能";
			mes "听见我们。";
			mes "我向那里发送消息后，";
			mes "发现了一些";
			mes "新情报，";
			mes "应该能真正帮助调查。";
		next;
		mes "[Larjes]";
			mes "我了解到那位高官失踪的夜晚有两点细节。";
			mes "我了解到那位高官失踪的夜晚";
			mes "有两点细节。";
			mes "首先，他离开卫兵一会儿";
			mes "去见一名女子。";
			mes "总是女人，对吧？";
		next;
		mes "[Larjes]";
			mes "[Larjes]";
				mes "其次，在他离开去见那名女子后，";
				mes "其他人";
				mes "进来了。";
			mes "他们离开时，带着";
			mes "非常大的行李向西方去了。";
		next;
		mes "[Larjes]";
			mes "那些行李大得可疑。";
			mes "看来是某个组织";
			mes "绑架了他，";
			mes "并出于某种原因";
			mes "想把他带到西方。";
		next;
		select("为什么是西方？");
		mes "[Larjes]";
		mes "这只是";
		mes "一个猜测，";
		mes "但我认为绑架他的人";
		mes "来自^2F4F2F阿鲁纳佩尔兹^000000。";
		mes "我被禁止进入阿鲁纳佩尔兹，";
		mes "所以无法继续调查。";
		set aru_monas,4;
		//changequest 17001,17002;
		close;
	}
	else {
		mes "[Larjes]";
		mes "我赌掉了这么多钱？";
		mes "这么多钱？";
		mes "我该怎么还清";
		mes "这些债？！";
		close;
	}
}

ra_in01,308,59,1	script	Waiter#pc	930,{
	if (aru_monas < 7) {
	mes "[Waiter]";
	mes "欢迎来到拉赫的";
	mes "餐厅，";
		mes "这是拉赫最精致、";
		mes "最出色的餐厅之一。";
		if (aru_monas < 6) {
			close;
		}
		if (aru_monas == 6) {
			next;
			mes "[Waiter]";
				mes "你想点什么？还是说……";
				mes "如果我没猜错，";
				mes "你是来办";
				mes "别的事的？";
			next;
			if (select("我想点餐。:是的，我来这里另有原因。") == 1) {
				mes "[服务员]";
				mes "当然，没问题。";
				mes "你是一个人来的吗？";
				next;
				select("是的。");
				mes "[服务员]";
				mes "请往这边走。";
				close2;
				set aru_monas,7;
				switch(rand(1,4)) {
					case 1: warp "ra_in01",303,43; end;
					case 2: warp "ra_in01",304,43; end;
					case 3: warp "ra_in01",304,39; end;
					case 4: warp "ra_in01",303,39; end;
				}
			}
				mes "[服务员]";
				mes "嗯，好吧。";
				mes "不管怎样，希望你在";
				mes "拉赫餐厅用餐愉快。";
			close;
		}
	}
	mes "[服务员]";
	mes "这家餐厅的食物是拉赫最好的——";
	mes "不，事实上，";
	mes "是整个阿鲁纳佩尔兹";
	mes "最好的！";
	mes "没有其他地方能比得上！";
	close;
}

ra_in01,301,50,3	script	Normal-Looking Man	927,{
	mes "[长相普通的男子]";
	mes "嗯——嗯！";
	mes "我喜欢这家餐厅的食物！";
	mes "这里的味道真棒！";
	mes "我敢说";
	mes "其他地方都没有";
	mes "这么好吃的东西！";
	close;
}

ra_in01,301,52,3	script	Common-Looking Man	927,{
	mes "[相貌普通的男子]";
	mes "这里的食物不差，";
	mes "但我最喜欢的餐厅在胡格尔。";
	mes "那里的食物";
	mes "绝对是最棒的。";
	close;
}

ra_in01,297,50,7	script	Suspicious-Looking Man	926,{
	mes "[看起来可疑的男子]";
	mes "每道菜都有独特的味道，";
	mes "你必须学会品尝。";
	mes "当然，不健康的";
	mes "垃圾食品是例外。";
	mes "那种东西不能算食物。";
	close;
}

ra_in01,301,43,0	script	MealConversation Trigger	-1,3,3,{
	end;

OnTouch:
	if (checkweight(907,200) == 0) {
		mes "^3355FF请稍等！";
		mes "你现在携带的物品太多。";
		mes "请使用卡普拉服务";
		mes "存放一些物品";
		mes "后";
		mes "再回来。^000000";
		close;
	}
	if (aru_monas == 7) {
		mes "[服务员]";
		mes "你想点什么？";
		mes "今天的特色菜是炸维纳斯金条纹刺鱼，";
		mes "因为我们今天早上刚收到";
		mes "来自维纳斯的";
		mes "高品质鱼。";
		mes "要来一份吗？";
		next;
		select("……好，就这个。");
		mes "[服务员]";
		mes "明智的选择。";
		mes "顺便告诉你，";
		mes "这道菜要 ^9932CD3,000 Zeny^000000。";
		mes "我马上回来。";
		next;
		mes "^3355FF服务员记下了你的订单，";
		mes "然后去了厨房。";
		mes "你决定在等待期间";
		mes "偷听邻桌人们的谈话。";
		mes "你仔细听着他们的交谈。";
		mes "^000000";
		next;
	mes "[浑厚的男声]";
	mes "………………………………………";
	mes "我真的看到了，";
	mes "世界上最棒的鱼！";
	mes "上次去维纳斯时，";
	mes "我瞥见了";
		mes "维纳斯金条纹刺鱼！是真的！";
		next;
	mes "[阴沉的男声]";
	mes "那么，你喝到维纳斯金条纹刺鱼的";
	mes "鱼汁了吗？";
	mes "真好喝吗？";
		next;
	mes "[普通的男声]";
	mes "哎，要是我喝到了，";
	mes "那一定是千载难逢的体验！";
	mes "维纳斯金条纹刺鱼";
	mes "可是十年才捕到一次，";
	mes "实在太难得了！";
		mes "真的太稀有了！";
		next;
	mes "[浑厚的男声]";
	mes "哦，那种鱼汁真不可思议。";
	mes "我喝下去后声音都变了！";
	mes "那真是……";
	mes "太震撼了。";
		next;
	mes "[普通的男声]";
	mes "哦！所以你的声音";
	mes "听起来才不一样。";
		next;
		mes "[阴沉的男声]";
		mes "你怎么能喝到这么稀有的鱼汁？";
		mes "肯定有很多人预约排队，";
		mes "就等着喝它呢！";
		mes "一定很难抢到吧？";
		mes "你真幸运。";
		next;
	mes "[浑厚的男声]";
	mes "我真是走运：我去维纳斯的一家酒馆，";
	mes "听说^DB7093一群";
	mes "走私犯^000000";
	mes "在东南海滩被卫兵逮捕了。^000000";
	mes "这消息让我想了很多。";
	mes "于是我有了一个猜测。";
		next;
		mes "[浑厚的男声]";
		mes "于是我开始想：";
		mes "走私犯可能在捕鱼。";
		mes "所以我去海滩看看，";
		mes "能不能找到他们的渔船。";
		mes "我想确认自己的猜测。";
		next;
		mes "[普通的男声]";
		mes "伙计，你一定对食物着迷。";
		mes "不然怎么会这么快想到";
		mes "走私犯在非法捕鱼？";
		mes "这推理也太快了吧。";
		mes "你真是个吃货。";
		next;
		mes "[浑厚的男声]";
		mes "哈，我想你说得对！";
		mes "总之，那里只有一艘渔船，";
		mes "卫兵正在检查它。";
		mes "我正失望地准备回去，";
		mes "但就在那时……我看到了一个渔夫！";
		mes "真是意外。";
		next;
	mes "[浑厚的男声]";
	mes "我从眼角看到他带来了";
	mes "当天的渔获，维纳斯金条纹刺鱼！";
	mes "我当场";
	mes "买下了";
	mes "他所有的鱼，";
	mes "一条也没留下。";
		next;
		mes "[阴沉的男声]";
		mes "你可真幸运。";
		mes "说到食物，你从不吝惜挥霍，";
		mes "对吧？嘿嘿~";
		mes "真是个怪人。";
		next;
		mes "[浑厚的男声]";
		mes "哦，那根本不算挥霍。";
		mes "如果你们处在我的位置，";
		mes "也会这么做。";
		mes "我只是很感激自己能尝到";
		mes "如此稀有的鱼。";
		mes "这可是难得的机会。";
		next;
		mes "^3355FF………………………………………";
		mes "随后，男人们开始互相夸赞。";
		mes "^000000";
		next;
		mes "[服务员]";
		mes "啊，这是你的炸维纳斯";
		mes "条纹刺鱼。";
		mes "请享用。";
		next;
	mes "["+strcharinfo(0)+"]";
	mes "^ff0000维纳斯^000000吗？";
	mes "就是那个地方？";
		mes "我改天也许该去那里看看，";
		mes "说不定能找到更多这种鱼。";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "哇，这鱼的味道……";
		mes "我从没尝过这种味道！";
		mes "简直像甜点。";
		mes "天啊，太好吃了！";
		set aru_monas,8;
		//changequest 17003,17004;
		if (Zeny > 3000) {
			set Zeny, Zeny-3000;
			getitem 12052,4; //Vit_Dish02
		}
		close;
	}
	end;
}

ve_in,78,314,5	script	Magistrate#Aru	945,{
	if (aru_monas < 8) {
		mes "[阿尔·哈马德]";
		mes "啊！为什么这种事会发生在我身上，";
		mes "尤其是在我马上要";
		mes "退休的时候！";
		mes "啊——我的胃溃疡……";
		mes "突然就……！";
		close;
	}
	else if (aru_monas == 8) {
		mes "[阿尔·哈马德]";
		mes "天啊，这大概是我职业生涯中";
		mes "最麻烦的";
		mes "事了。";
		mes "为什么偏偏现在发生？";
		mes "退休近在眼前，却又遥不可及。";
		next;
		select("你遇到麻烦了吗？");
		mes "[阿尔·哈马德]";
		mes "嗯？你看起来不像本地人。";
		mes "听着，我很感谢你的关心，";
		mes "但我实在不想";
		mes "和陌生人";
		mes "谈论自己的问题。";
		mes "请你理解。";
		set aru_monas,9;
		//changequest 17004,17005;
		close;
	}
	else if (aru_monas == 9) {
		mes "[阿尔·哈马德]";
		mes "除非你有特殊事务，";
		mes "否则不允许进入这里。";
		mes "我们负责维护公共秩序，";
		mes "让任何人进来";
		mes "都会造成麻烦。";
		mes "所以请离开。";
		close;
	}
	else if (aru_monas == 10) {
		mes "[阿尔·哈马德]";
		mes "我不是告诉过你";
		mes "不许进来";
		mes "吗？";
		mes "你为什么总是回来？";
		next;
		if (select("对不起。:我想了解走私犯。") == 1) {
			mes "[阿尔·哈马德]";
			mes "没关系。离开吧，";
			mes "除非你有非常充分的理由，";
			mes "否则别再回来。";
			mes "我不想再重复一遍。";
			close;
		}
		mes "[阿尔·哈马德]";

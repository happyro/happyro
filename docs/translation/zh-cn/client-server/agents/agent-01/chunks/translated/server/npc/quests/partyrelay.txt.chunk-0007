		mes "我比你年轻，";
		mes "但我负责这项任务！";
		mes "所以要听我的，好吗？";
		mes "嘿嘿！别害怕~";
		next;
		mes "[洛斯皮]";
		mes "我现在正为这项";
		mes "任务工作，你来得";
		mes "正是时候！让我看看……";
		mes "我得给你……一些";
		mes "要完成的任务……";
		mes "哦！我知道了！有了！";
		next;
		mes "[洛斯皮]";
		mes "我们要看看你是否";
		mes "懂得团队合作，对吧？";
		mes "不如给我看看你的";
		mes "朋友？带他们来……";
		mes "10 个人！对，就这样！";
		next;
		mes "[洛斯皮]";
		mes "我得看见他们，";
		mes "这样才能知道你没有";
		mes "对我撒谎。把他们带得";
		mes "非常近，这样我才知道他们是你的";
		mes "朋友，而不是其他人。";
		mes "";
		next;
		delitem 7732,1; //Mission_Certificate3
		set party_relay,10;
		mes "[洛斯皮]";
		mes "好，我会一直";
		mes "在这里！哦！还有，";
		mes "你得在我工作时";
		mes "和朋友们一起来！这点";
		mes "很重要！";
		close;
	}
	if ((countitem(7732) > 0) && (BaseLevel > 39) && (BaseClass == Job_Archer)) {
		mes "[洛斯皮]";
		mes "嗨，我是洛斯皮！也许";
		mes "我比你年轻，";
		mes "但我负责这项任务！";
		mes "所以要听我的，好吗？";
		mes "嘿嘿！别害怕~";
		next;
		mes "[洛斯皮]";
		mes "糟糕……我忘了";
		mes "现在还不该";
		mes "工作。等我工作时再";
		mes "回来，好吗？";
		next;
		mes "[洛斯皮]";
		mes "我的工作时间是……呃……";
		mes "下午 2 点到 5 点？哦！";
		mes "还有下午 6 点到 9 点。";
		mes "我想就是这些";
		mes "时间……我是说，时钟";
		mes "真的很难看懂啊！";
		close;
	}
	mes "[洛斯皮]";
	mes "嗨！我是洛斯皮！";
	mes "嘿，看起来我像是在";
	mes "工作吗？哈哈！";
	mes "我找到工作了！我正在";
	mes "大力帮助我的朋友们！";
	close;
}

// EXP Rewards
function	script	F_PartyRelay_Exp	{
	if (checkre(3)) { //unconfirmed
		if (BaseLevel > 94) getexp 104760,0;
		else if (BaseLevel > 89) getexp 85920,0;
		else if (BaseLevel > 79) getexp 38520,0;
		else if (BaseLevel > 69) getexp 19560,0;
		else if (BaseLevel > 59) getexp 6720,0;
		else if (BaseLevel > 49) getexp 2880,0;
		else getexp 1080,0;
	} else {
		if (BaseLevel > 94) getexp 1047600,0;
		else if (BaseLevel > 89) getexp 859200,0;
		else if (BaseLevel > 79) getexp 385200,0;
		else if (BaseLevel > 69) getexp 195600,0;
		else if (BaseLevel > 59) getexp 67200,0;
		else if (BaseLevel > 49) getexp 28800,0;
		else getexp 10800,0;
	}
	return;
}


//= L0ne_W0lf
//===== Current Version: ===================================== 
//= 1.2
//===== Compatible With: ===================================== 
//= rAthena Project
//===== Description: ========================================= 
//= [Official Conversion]
//= Guide for the city of Niflheim.
//===== Additional Comments: ================================= 
//= 1.0 First version, Renewal guide.
//= 1.1 Optimized. [Euphy]
//= 1.2 Navigation system update. [Euphy]
//============================================================ 

niflheim,201,187,3	script	Niflheim Guide#01nif	849,{
	mes "[尼弗海姆向导]";
	mes "欢迎来到……^8B4513尼弗海姆^000000……";
	mes "亡者的国度……";
	mes "需要我帮你熟悉这里吗？";
	if (F_Navi() == 0) {
		next;
		mes "[尼弗海姆向导]";
		mes "点击……^B9062F[地点名称]^000000……即可获得最先进的^B9062F导航^000000服务……！";
	}
	while (1) {
		next;
		switch(select("[ 工具店 ]:[ 酒馆 ]:[ 武器店 ]:[ 女巫城堡 ]:移除小地图标记:取消")) {
		case 1:
			callsub L_Mark, F_Navi("工具店","niflheim,218,196","^0000FF");
			viewpoint 1,218,196,0,0x0A82FF;
			break;
		case 2:
			callsub L_Mark, F_Navi("酒馆","niflheim,189,208","^006400");
			viewpoint 1,189,208,1,0xAAFF00;
			break;
		case 3:
			callsub L_Mark, F_Navi("武器店","niflheim,218,170","^800080");
			viewpoint 1,218,170,2,0xDA70D6;
			break;
		case 4:
			callsub L_Mark, F_Navi("女巫城堡","niflheim,255,195","^FF1493");
			viewpoint 1,255,195,3,0xFF1493;
			break;
		case 5:
			mes "[尼弗海姆向导]";
			mes "好的，我会移除你小地图上的所有标记……";
			mes "还有其他我能帮你的吗……？";
			viewpoint 2,1,1,0,0xFFFFFF;
			viewpoint 2,1,1,1,0xFFFFFF;
			viewpoint 2,1,1,2,0xFFFFFF;
			viewpoint 2,1,1,3,0xFFFFFF;
			break;
		case 6:
			mes "[尼弗海姆向导]";
			mes "……再见~！";
			close;
		}
	}
	end;
L_Mark:
	mes "[尼弗海姆向导]";
	mes "让我标记";
	mes getarg(0)+"^000000...";
	mes "在你的小地图上。";
	mes "还要查看其他地点吗？";
	return;
}

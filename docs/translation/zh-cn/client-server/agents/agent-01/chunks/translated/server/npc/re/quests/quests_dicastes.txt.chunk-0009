				mes "[Shay]";
				mes "……真没想到会这样。";
				mes "那么，Ahat 到底是谁……？";
				mes "……我闻到了阴谋的味道。";
				next;
				mes "[Shay]";
				mes "我没亲眼见过 Ahat，所以不清楚，";
				mes "但我们必须弄清这一切意味着什么。";
				next;
				select("你相信 BK 吗？");
				mes "[Shay]";
				mes "至少 BK 不会撒谎。";
				mes "我认识的 BK 从不撒谎。";
				mes "为什么这些东西会在裂缝附近？";
				mes "Ahat 为什么会在裂缝附近……";
				next;
				select("你想亲自见他吗？");
				mes "[Shay]";
				mes "你不能随随便便闯进去见他。";
				mes "像我们这样的外来者想见他就更难了。";
				mes "嗯……";
				next;
				mes "[Shay]";
				mes "我们可以试着收集功绩证明。";
				mes "做出伟大功绩的人才有机会见到大臣。";
				next;
				mes "[Shay]";
				mes "猫商人也在收集功绩证明。他们想亲自见大臣，以便谈生意。";
				next;
				mes "[Shay]";
				mes "完成城市各处的委托，就能获得功绩证明。";
				mes "如果你想见大臣 Ahat……";
				next;
				mes "[Shay]";
				mes "你至少需要^4d4dff3份功绩证明^000000。";
				mes "去^4d4dff迪尔打听一下^000000更多信息。";
				next;
				mes "[Shay]";
				mes "在迪尔登记冒险者的萨帕。";
				mes "他叫^4d4dffRhawyne^000000。去问他。";
				next;
				select("你没有萨帕的功绩证明吗？");
				mes "[Shay]";
				mes "................";
				mes "你以为我这么闲吗？";
				mes "我不是接委托的人，我是发布委托的人！！";
				next;
				mes "[Shay]";
				mes "啧。";
				mes "先想想你该做什么。";
				mes "收集功绩证明，去见 Ahat。";
				mes "然后查清他和裂缝之间到底是什么关系。";
				set ep13_3_secret, 12;
				for (set .@i, 0; .@i < getarraysize(.@quest); set .@i, .@i + 1)
					if (checkquest(.@quest[.@i]) >= 0) erasequest .@quest[.@i];
				setquest 7197;
				break;
			}
			else if (ep13_3_secret == 12) {
				mes "[Shay]";
				mes "先从收集功绩证明开始。";
				mes "你至少需要3份证明才能见大臣。";
				next;
				mes "[Shay]";
				mes "拿到证明后，去迪尔的冒险者接待处申请会见大臣。";
				mes "Rhawyne 会帮助你。";
				break;
			}
			else if (ep13_3_secret == 13) {
				mes "[Shay]";
				mes "所以……你获准了吗？";
				mes "我也很好奇 Ahat 是什么样的人。";
				next;
				mes "[Shay]";
				mes "很好。你回来前我会准备些食物。";
				mes "我几天前刚找到一个很棒的巧克力食谱。";
				next;
				select("哦……不……");
				mes "[Shay]";
				mes "我在梦罗克的时候，";
				mes "公会里有个同事经常做巧克力点心。";
				mes "因为他做起来很简单，我以为我也能做到。";
				next;
				select("所以……");
				mes "[Shay]";
				mes "等你尝过就知道了。";
				mes "现在，出发吧。";
				break;
			}
			else if ((ep13_3_secret > 13) && (ep13_3_secret < 17)) {
				mes "[Shay]";
				mes "大臣怎么样？";
				next;
				if (select("奇怪。:……很美……") == 1) {
					mes "[Shay]";
					mes "所以……有多奇怪。";
					mes "……是好还是坏？";
					mes "不，那不重要。试着想想你去那里是为了什么。";
					break;
				}
				mes "[Shay]";
				mes "咦？真的？";
				mes "即使种族不同，你也能看出美丑。";
				mes "做好你的工作，别光想着他的外表。";
				break;
			}
			else if ((ep13_3_secret > 16) && (ep13_3_secret < 19)) {
				mes "[Shay]";
				mes "嗯……";
				mes "清理裂缝区域？";
				mes "听起来很奇怪。";
				mes "感觉有些不对劲。";
				next;
				mes "[Shay]";
				mes "别忘了带回证据。";
				mes "还要假装自己被催眠了。";
				mes "很好。这是我们的秘密。";
				next;
				mes "[Shay]";
				mes "事情的发展真有趣。";
				mes "不过你真的很健谈。";
				mes "什么都告诉我了。啧。";
				break;
			}
			else if (ep13_3_secret > 18 && ep13_3_secret < 22) {
				mes "[Shay]";
				mes "你知道吗？";
				mes "还有一位很能干的贾鲁特。";
				mes "他叫 HesLanta。";
				next;
				mes "[Shay]";
				mes "他有时会回来分享自己的故事。";
				mes "不过我想，他也有故事要讲。";
				next;
				mes "[Shay]";
				mes "这只是我的想法，";
				mes "不过和 Ahat 身边的人聊聊也许不错。";
				next;
				mes "[Shay]";
				mes "去和那个叫 HesLanta 的贾鲁特聊聊怎么样？";
				mes "反正你也不会损失什么。";
				break;
			}
			else if (ep13_3_secret == 22) {
				mes "[Shay]";
				mes "你怎么又来了？";
				mes "你在工作吗？";
				next;
				if (select("任务完成了！:我是来感谢你的。") == 1) {
					mes "[Shay]";
					mes "真的吗？";
					mes "那太好了。";
					mes ".....";
					mes "任务。真是好久没听到这个词了。";
					next;
					mes "[Shay]";
					mes "现在走吧。";
					mes "我很忙。";
					mes "今天会有新食材送来。";
					mes "快走。";
					break;
				}
				mes "[Shay]";
				mes "如果你真的那么感激，就把我做的新菜全吃光，一口都别剩。";
				next;
				select("啊，这个嘛……");
				mes "[Shay]";
				mes "嗯？滚开。";
				mes "真不知感恩……";
				break;
			}
			set .@shysay, rand(1,3);
			if (.@shysay == 1) {
				mes "[Shay]";
				mes "你想要什么？";
				next;
				switch (select("告诉我你的事:关于萨帕:……嗯……")) {
					case 1:
						mes "[Shay]";
						mes "我？";
						mes "我不是以前告诉过你吗？";
						next;
						select("没有……");
						mes "[Shay]";
						mes "不，我以前说过自己的故事。";
						mes "不过既然你记性不好，我就再说一遍。";
						next;
						mes "[Shay]";
						mes "嗯。那么要我讲讲自己如何定居在这里的故事吗？";
						mes "最先申请来这里进行远征的，";
						mes "是刺客们。";
						next;
						mes "[Shay]";
						mes "我就是其中之一。";
						mes "所以我比其他人更早来到这里，";
						mes "远征营地的基地也就这样建成了。";
						next;
						mes "[Shay]";
						mes "不过你知道吗。";
						mes "我本想回故乡退休。";
						mes "但迪卡斯特斯联系了我。";
						next;
						mes "[Shay]";
						mes "他们请我为我们这些外来者建一个舒适的地方。";
						mes "他们还体贴地采用了米德加尔特风格来建造。";
						next;
						mes "[Shay]";
						mes "所以框架和风格确定后，";
						mes "他们请来了建筑师……";
						mes "结果我就这样开始管理整个项目了？";
						next;
						mes "[Shay]";
						mes "然后……";
						mes "我就这样来到了这里。";
						mes "从那以后我一直待在这里！";
						next;
						mes "[Shay]";
						mes "我已经不记得自己原来的职业了。";
						mes "看来我对卡塔尔有点生疏了……";
						next;
						mes "Shay 突然露出寂寞的表情，为自己的处境深深叹息。";
						mes "看起来非常疲惫。";
						break;
					case 2:
						mes "[Shay]";
						mes "萨帕？";
						mes "你周围全都是萨帕。";
						mes "......";
						next;
						mes "[Shay]";
						mes "你问我做什么？";
						mes "随便问一个路过的萨帕吧。";
						mes "问‘你是什么’。";
						break;
					case 3:
						mes "[Shay]";
						mes "什么……";
						mes "我没那么忙，但也别太烦我。";
						break;
				}
				break;
			}
			else if (.@shysay == 2) {
				mes "[Shay]";
				mes "你这次又带了什么来？";
				mes ".........";
				mes "什么？没有？";
				next;
				mes "[Shay]";
				mes "啧……真无聊。";
				break;
			}
			else {
				mes "[Shay]";
				mes "草莓巧克力为什么这么难做？";
				mes "我的巧克力为什么会散掉？";
				next;
				mes "[Shay]";
				mes "还有这个巧克力派。";
				mes "怎样才能把它烤成恰到好处的金色？";
				mes "为什么不能是白色或黑色？";
				mes "重要的不是派，而是巧克力。";
				next;
				mes "[Shay]";
				mes "我的同事到底是怎么做出这个的？！";
				mes "............";
				mes "……女孩子喜欢这个吗？";
				next;
				if (select("她们通常喜欢自制巧克力。:不，只有外星人才喜欢。") == 1) {
					mes "[Shay]";
					mes "我明白了。";
					mes "那么……";
					mes "你结婚了吗？";
					break;
				}
				mes "[Shay]";
				mes "你是一个人吧？";
				mes "....";
				mes "抱歉。";
				mes "我们同病相怜。";
				break;
			}
		}
	case 3:
		mes "[Shay]";
		mes "随你便。";
		break;
	}
	close2;
	cutin "",255;
	end;
}

dicastes01,207,210,5	script	Walking Knit#ep133_15	449,{
	if (!isequipped(2782)) {
		mes "[Knit]";
		mes "������";
		mes "������ �� ����� �� �𢲢�";
		next;
		mes "无法与他交流。";
		close;
	}
	if (ep13_3_secret == 4) {
		mes "[Knit]";
		mes "欢迎，人类。";
		mes "我终于习惯遇到像你这样的其他种族了。";
		next;
		if (select("除了人类还有其他种族吗？:你在做什么？") == 1) {
			mes "[Knit]";
			mes "在你来之前，这里有拉皮内。";
			mes "当然现在也还有。";
			mes "不过他们在卡米达尔山脉那边。";
			next;
			mes "[Knit]";
			mes "还有那些猫……";
			mes "啊，你看到城堡前的那群猫了吗？";
			mes "它们不像我们，毛茸茸的，真的很可爱。";
			next;
			if (checkquest(7188) >= -1) {
				mes "[Knit]";
				mes "尤其是它们的耳朵和尾巴！！";
				next;
				select("你见过这个人吗？");
				mes "[Knit]";
				mes "咦？嗯？";
				mes "男人？人类男性？";
				mes "一个长着猫耳朵的人类男性？";
				mes "从没听说过这种事……";
				next;
				mes "[Knit]";
				mes "人类真厉害！";
				mes "我完全没想到……！";
				mes ".....";
				next;
				mes "[Knit]";
				mes "但它们真的很可爱。";
				mes "那些可爱的猫……";
				next;
				mes "[Knit]";
				mes "不过即使对萨帕来说，Ahat 也很讨人喜欢。";
				mes "……如果说我的头发像干枯的冬树……";
				mes "Ahat 的头发就像早春刚冒出的嫩芽……";
				next;
				mes "[Knit]";
				mes "真难以置信，他为迪卡斯特斯工作，";
				mes "还能保持这么漂亮的头发。";
				mes "我几乎能看到光芒了。";
				next;
				mes "[Knit]";
				mes "啊……他的皮肤简直神圣。";
				mes "但他从不离开迪卡斯特斯·迪尔高处的办公室。";
				next;
				mes "[Knit]";
				mes "不过我想，这对 Ahat 的肤色更好……";
				mes "待在迪尔像水晶鸟一样温暖安全，总比在冬日寒风中好！";
				next;
				mes "- 他继续谈论 Ahat。";
				mes "看来也问不出更多信息了。-";
				setquest 7188;
				close;
			}
			mes "[Knit]";
			mes "它们真的很可爱。";
			mes "那些可爱的猫……";
			next;
			mes "[Knit]";
			mes "不过即使对萨帕来说，Ahat 也很讨人喜欢。";
			mes "……如果说我的头发像干枯的冬树……";
			mes "Ahat 的头发就像早春刚冒出的嫩芽……";
			next;
			mes "[Knit]";
			mes "啊……我真是嫉妒，太羡慕了……";
			close;
		}
		mes "[Knit]";
		mes "如你所见，我正在散步。";
		mes "我应该时不时走走，免得身体僵硬。";
		mes "我真的不喜欢身体僵硬。";
		close;
	}
	mes "[Knit]";
	mes "你不觉得猫很神奇吗？";
	mes "我听说在你来的地方，人们会养宠物……";
	next;
	mes "[Knit]";
	mes "饲养其他生物没问题吗？";
	mes "它们自己愿意吗？";
	mes "这是个复杂的问题……";
	close2;
}

dicastes01,112,248,5	script	Resting Piom#ep133_16	491,{
	mes "[Piom]";
	if (!isequipped(2782)) {
		mes "����� �� �����?";
		mes "��~!";
		mes "�Т��� �� ����� �� �� !!!";
		next;
		mes "无法与他交流。";
		close;
	}
	if (ep13_3_secret == 4) {
		mes "[Piom]";
		mes "呼……我需要休息。";
		mes "嗯？你是……人类！";
		mes "你为什么在这里？";
		next;
		if (checkquest(7189) >= -1) {
			select("关于长着猫耳朵的人类……");
			mes "[Piom]";
			mes "哈哈哈哈哈！！！";
			mes "哈哈哈哈哈！！！";
			mes "最近有很多人问这件事。";
			mes "这和猫商人有冲突吗？";
			next;
			mes "[Piom]";
			mes "哈哈……真有趣。";
			mes "长着猫耳朵的人类。我从没听说过这种事。";
			mes "不过你看起来刚来这里不久。";
			next;
			mes "[Piom]";
			mes "别把时间浪费在这么荒唐的事情上。";
			mes "就是这样！我觉得你是合适的人选。";
			next;
			mes "[Piom]";
			mes "大臣住在迪尔的最高处。";
			mes "试着去见大臣吧。";
			mes "他是个很棒的人。";
			mes "是所有萨帕的榜样！";
			next;
			mes "[Piom]";
			mes "既然你要待在迪卡斯特斯，就得了解萨帕，对吧？";
			mes "别和我这种灰扑扑的 Piom 浪费时间，去见 Ahat 吧。";
			mes "你会喜欢他的。";
			next;
			mes "- 他继续谈论 Ahat。";
			mes "看来也问不出更多信息了。-";
			setquest 7189;
			close;
		}
		mes "[Piom]";
		mes "别跟着猫到处跑。";
		mes "去见 Ahat 吧。";
		mes "他真的很美。";
		close;
	}
	mes "[Piom]";
	mes "如你所见，我正在休息。";
	mes "我喜欢自己的工作，但真的很累。";
	mes "不过比起当 Knit 时，我现在更开心。";
	next;
	mes "[Piom]";
	mes "我脑子转不动了。";
	mes "我不喜欢像 Knit 那样处理文件。";
	mes "但 Galten 得携带沉重的武器。";
	next;
	mes "[Piom]";
	mes "我最后做的工作是开采并提炼布拉迪姆，";
	mes "我很喜欢！";
	mes "想到我的工作能让大家保持健康，";
	mes "就觉得很有成就感。";
	close;
}

dicastes01,249,140,3	script	Training Galten#ep133_17	450,{

		emotion ET_SURPRISE;
		emotion ET_QUESTION;
		emotion ET_HUK;
		mes "[村童]";
		mes "等等？它去哪了？我跑步时好像把工具袋弄丢了。";
		next;
		mes "[村童]";
		mes "我大概能猜到它掉在哪里了……";
		next;
		emotion ET_SEXY;
		mes "[村童]";
		mes "在这种情况下还能在村子里走动，你一定很强。请帮我一个忙。";
		next;
		mes "[村童]";
		mes "你知道普隆德拉熔炉在哪里吗？";
		next;
		mes "[村童]";
		mes "那是普隆德拉很有名的店。总有一天，我会……";
		next;
		erasequest 5453;// Ungrateful(1)
		setquest 5454;// Ungrateful(2)
		mes "[村童]";
		mes "哦！没事了。我就拜托你了。";
		close2;
		cloakonnpcself( "Village Lad#EP161HO03" );
		end;
	}
	if (isbegin_quest(5455) == 1) {
		emotion ET_CONGRATULATION;
		mes "[村童]";
		mes "哇……我以为它丢了。你真的找到了！";
		next;
		emotion ET_STARE_ABOUT;
		mes "[村童]";
		mes "太棒了。非常感谢。你一定也很忙吧？我现在得去处理一些事情……";
		next;
		emotion ET_STARE_ABOUT;
		mes "[村童]";
		mes "哦！我知道你很强，但请小心。";
		next;
		erasequest 5455;// Ungrateful(3)
		setquest 5456;// Ungrateful(4)
		mes "[Village Lad]";
		mes "谢谢。再见。";
		close2;
		cloakonnpcself( "Village Lad#EP161HO03" );
		end;
	}
	mes "[村童]";
	mes "你看得见我吗？真奇怪，我本来不该被看见。";
	close2;
	cloakonnpcself( "Village Lad#EP161HO03" );
	end;

OnInit:
	cloakonnpc();
	end;
}


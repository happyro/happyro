prt_q,276,242,4	script	Girl#EP161GU01	4_F_RUSCHILD,{
	if (checkweight(1301,1) == 0) {
		mes "- 你携带的物品太多，无法继续任务。-";
		close;
	}
	if (isbegin_quest(5449) == 1 && isbegin_quest(5457) == 0) {
		select("小姑娘，你还好吗？");
		emotion ET_QUESTION, playerattached();
		emotion ET_CRY;
		mes "[洛温]";
		mes "我和妹妹罗莎一起跑去教堂……但我把她弄丢了……呜呜……";
		next;
		emotion ET_HNG;
		mes "[洛温]";
		mes "罗莎应该紧紧拉住我的手。她怎么会这么糊涂，把自己弄丢了！";
		next;
		mes "[洛温]";
		mes "你能带我去大教堂吗？";
		next;
		erasequest 5449;// Request from Chief Guard
		setquest 5457;// Find My Sister(1)
		viewpoint 2,276,242,1,0xFF0000;
		mes "[洛温]";
		mes "我们约好走散时在大教堂见面。我相信她会在那里。";
		close2;
		cloakonnpcself( "Girl#EP161GU01" );
		end;
	}
	mes "[洛温]";
	mes "哦？你看得见我吗？真奇怪，我本来不该被看见。";
	close2;
	cloakonnpcself( "Girl#EP161GU01" );
	end;

OnInit:
	cloakonnpc();
	end;
}

// Cathedral
prt_q,235,315,4	script	Cathedral Knight#EP161GU04	4_F_CRU,5,5,{
	if (checkweight(1301,1) == 0) {
		mes "- 你携带的物品太多，无法继续任务。-";
		close;
	}
	if (isbegin_quest(5458) == 1) {
		mes "[大教堂骑士]";
		mes "请照顾好洛温。她就像我们普隆德拉的吉祥物。";
		close;
	}
	if (isbegin_quest(5464) == 1) {
		mes "[大教堂骑士]";
		mes "艾莉非常脆弱。希望她平安无事。";
		close;
	}
	if (isbegin_quest(5466) == 1) {
		mes "[大教堂骑士]";
		mes "天啊……艾莉情况危急。希望里面有神父出来帮助她。";
		close;
	}
	if (isbegin_quest(5468) == 1) {
		mes "[大教堂骑士]";
		mes "谢谢你的努力。我们会奉献一生，保护大教堂免受亡灵侵袭。";
		close;
	}
	mes "[大教堂骑士]";
	mes "这里是普隆德拉的第一避难所大教堂。";
	if (countitem(6939) < 1)
		close;
	next;
	mes "[大教堂骑士]";
	mes "那条腰带……看起来属于被亡灵杀害的同事。能交给我吗？";
	next;
	mes "[大教堂骑士]";
	mes "我知道现在情况紧急，但我想安慰同事的灵魂。";
	next;
	if (select( "交给他。", "不交给他。" ) == 2) {
		mes "[大教堂骑士]";
		mes "哦，我明白了。如果改变主意，请把它带给我。";
		close;
	}
	if (countitem(6939) < 1) {
		mes "[大教堂骑士]";
		mes "哦，你把原来的腰带弄丢在哪里了？";
		close;
	}
	mes "[大教堂骑士]";
	mes "谢谢。我想死者现在可以安息了。这是我唯一能给你的东西……不过……";
	next;
	delitem 6939,1;	// Shabby_Old_Belt
	npcskill "AL_HEAL",10,99,99;
	percentheal 100,0;
	mes "[大教堂骑士]";
	mes "如果你找到士兵遗留的其他物品，请带给我好吗？";
	close;

OnTouch:
	if (isbegin_quest(5457) == 1)
		cloakoffnpcself( "Girl#EP161GU03" );
	if (isbegin_quest(5463) == 1 || isbegin_quest(5467) == 1)
		cloakoffnpcself( "Eryus#EP161BU02" );
	else if (isbegin_quest(5465) == 1) {
		cloakoffnpcself( "Eryus#EP161BU02" );
		cloakoffnpcself( "Female#EP161BU04" );
	}
	end;
}

prt_q,232,318,3	script	PecoPeco Mechanic#EP161GU02	8W_SOLDIER,{
	if (checkweight(1301,1) == 0) {
		mes "- 你携带的物品太多，无法继续任务。-";
		close;
	}
	if (strnpcinfo(0) == "PecoPeco Mechanic#EP161GU02")
		.@check = (Class == JOB_CRUSADER || Class == JOB_PALADIN);
	else
		.@check = (Class == JOB_KNIGHT || Class == JOB_LORD_KNIGHT);
	if (.@check && countitem(6939) > 0) {	// Shabby_Old_Belt
		mes "[波利机械师]";
		if (Class == JOB_CRUSADER)
			mes "哦！亲爱的十字军！";
		else if (Class == JOB_PALADIN)
			mes "哦！亲爱的圣骑士！";
		mes "那条腰带？看起来属于被亡灵杀害的同事。";
		next;
		mes "[波利机械师]";
		mes "能把它交给我安慰他可怜的灵魂吗？虽然服务因紧急情况暂停，但我可以帮你叫来波利。";
		next;
		if (select( "使用服务。", "取消。" ) == 2) {
			mes "[波利机械师]";
			mes "哦……这样啊，我明白了。";
			close;
		}
		if (countitem(6939) < 1) {
			mes "[波利机械师]";
			if (Class == JOB_CRUSADER)
				mes "亲爱的十字军";
			else if (Class == JOB_PALADIN)
				mes "亲爱的圣骑士";
			mes "哦！你把原来的腰带弄丢在哪里了？";
			close;
		}
		if (getskilllv("KN_RIDING") != 1) {
			mes "[PecoPeco Mechanic]";
			mes "哦……我想你应该先学会骑乘波利。";
			close;
		}
		if (checkriding()) {
			mes "[PecoPeco Mechanic]";
			mes "你已经在骑乘波利了。";
			close;
		}
		if (ismounting()) {
			mes "[PecoPeco Mechanic]";
			mes "你需要松开缰绳才能骑乘它。";
			close;
		}
		delitem 6939,1;	// Shabby_Old_Belt
		setriding();
		mes "[PecoPeco Mechanic]";
		mes "谢谢。如果你找到其他死去士兵遗留的物品，请带给我。";
		close;
	}
	if (isbegin_quest(5458) == 2) {
		emotion 57;
		mes "[波利机械师]";
		mes "哦，我现在成叔叔了……";
		close;
	}
	emotion ET_SORRY;
	mes "[波利机械师]";
	mes "如果你是来借波利的，很抱歉。";
	next;
	mes "[波利机械师]";
	mes "由于情况紧急，普隆德拉的所有部队都已部署去保护居民。";
	close;
}

prt_q,229,317,6	script	Girl#EP161GU03	4_F_RUSCHILD,{
	if (checkweight(1301,1) == 0) {
		mes "- 你携带的物品太多，无法继续任务。-";
		close;
	}
	if (isbegin_quest(5457) == 1) {
		mes "[洛温]";
		mes "哇，非常感谢你！";
		next;
		npctalk "女孩：罗莎！罗莎！", "Girl#EP161GU03", bc_self;
		emotion ET_BLABLA;
		mes "[Lowen]";
		mes "罗莎！罗莎！";
		next;
		emotion ET_SURPRISE;
		emotion ET_QUESTION;
		mes "[洛温]";
		mes "哦，波利叔叔，你看到我妹妹了吗？";
		next;
		emotion ET_HUK, getnpcid(0, "PecoPeco Mechanic#EP161GU02");
		mes "[波利机械师]";
		mes "咳……叔叔……";
		next;
		mes "[波利机械师]";
		mes "你说罗莎？罗莎吗？我没在这里见到她。她不是和你一起来的吗？";
		next;
		emotion ET_BLABLA;
		mes "[洛温]";
		mes "呜……罗莎，你现在在哪里？";
		next;
		emotion ET_SURPRISE;
		emotion ET_QUESTION;
		mes "[波利机械师]";
		mes "她可能去了骑士团建筑。你们姐妹不是应该去那里的避难所吗？";
		next;
		emotion ET_HUK, getnpcid(0, "PecoPeco Mechanic#EP161GU02");
		mes "[洛温]";
		mes "咦？那她应该没去大教堂……嗯？我该怎么办？";
		next;
		mes "[波利机械师]";
		mes "亲爱的冒险者，如果你不赶时间，能帮洛温逃到骑士团建筑吗？";
		next;
		mes "[波利机械师]";
		mes "洛温的妹妹和洛温不同，是个谨慎的女孩。她一定逃去了骑士团建筑。";
		next;
		npctalk "女孩：呼……叔叔！", "Girl#EP161GU03", bc_self;
		select("既然我已经在这里，就继续帮助她吧。");
		erasequest 5457;// Find My Sister(1)
		setquest 5458;// Find My Sister(2)
		emotion ET_THANKS, getnpcid(0, "PecoPeco Mechanic#EP161GU02");
		mes "[波利机械师]";
		mes "谢谢。请照顾好她。";
		close2;
		cloakonnpcself( "Girl#EP161GU03" );
		end;
	}
	mes "[洛温]";
	mes "哦？你看得到我吗？真奇怪，我本来不该被看见。";
	close2;
	cloakonnpcself( "Girl#EP161GU03" );
	end;

OnInit:
	cloakonnpc();
	end;
}


prt_q,85,90,7	script	Giant Beast Manager#EP161ETC06	8W_SOLDIER,{
	.@thirdmask = eaclass() & EAJ_THIRDMASK;
	if ((.@thirdmask != EAJ_RUNE_KNIGHT && .@thirdmask != EAJ_ROYAL_GUARD) || countitem(6939) < 1) {
		emotion 19;
		mes "[巨兽管理员]";
		mes "这里是普隆德拉的第三避难所村办公室。";
		close;
	}
	if (.@thirdmask == EAJ_RUNE_KNIGHT) {
		.@job$ = "Rune Knight";
		.@mount$ = "Dragon";
	}
	else {
		.@job$ = "Royal Guard";
		.@mount$ = "Griffon";
	}
	mes "[巨兽管理员]";
	mes "哦，亲爱的"+.@job$+"……那条腰带？看起来属于被亡灵杀害的同事。";
	next;
	mes "[巨兽管理员]";
	mes "能把它交给我安慰他可怜的灵魂吗？虽然服务因紧急情况暂停，但我可以帮你骑乘"+.@mount$+"。";
	next;
	if (select( "使用服务。", "取消。" ) == 2) {
		mes "[Giant Beast Manager]";
		mes "我明白了。那么，再见。";
		close;
	}
	if (getskilllv("KN_RIDING") < 1) {
		mes "[Giant Beast Manager]";
		mes "你需要先学会骑乘"+.@mount$+"。";
		close;
	}
	if (checkriding() || checkdragon()) {
		mes "[Giant Beast Manager]";
		mes "你已经在骑乘"+.@mount$+"了。";
		close;
	}
	if (ismounting()) {
		mes "[Giant Beast Manager]";
		mes "你需要松开缰绳才能骑乘"+.@mount$+"。";
		close;
	}
	delitem 6939,1;	// Shabby_Old_Belt
	if (.@thirdmask == EAJ_RUNE_KNIGHT)
		setdragon();
	else
		setriding();
	mes "[巨兽管理员]";
	mes "谢谢。如果你找到其他死去士兵遗留的物品，请带给我。";
	close;
}

prt_q,74,101,7	script	Magical Gear Mechanic#EP161ETC05	8W_SOLDIER,{
	.@thirdmask = eaclass() & EAJ_THIRDMASK;
	if (.@thirdmask != EAJ_MECHANIC || countitem(6939) < 1) {
		emotion 19;
		mes "[魔导机甲技师]";
		mes "这里是普隆德拉的第三避难所村办公室。";
		close;
	}
	mes "[魔导机甲技师]";
	mes "哦，亲爱的机甲工匠！那条腰带？看起来属于被亡灵杀害的同事。";
	next;
	mes "[魔导机甲技师]";
	mes "能把它交给我安慰他可怜的灵魂吗？虽然服务因紧急情况暂停，但我可以帮你借手推车或骑乘魔导机甲。";
	next;
	switch( select( "借用手推车。", "骑乘魔导机甲", "不使用。" ) ) {
	case 1:
		if (checkcart() == true) {
			mes "[魔导机甲技师]";
			mes "你已经在使用手推车了。";
			close;
		}
		if (getskilllv("MC_PUSHCART") == 0)	// the check is missing officially
			close;
		delitem 6939,1;	// Shabby_Old_Belt
		setcart();
		mes "[魔导机甲技师]";
		mes "谢谢。如果你找到其他死去士兵遗留的物品，请带给我。";
		close;
	case 2:
		if (checkmadogear()) {
			mes "[魔导机甲技师]";
			mes "你已经在骑乘魔导机甲，不能再骑另一台。";
			close;
		}
		if (getskilllv("NC_MADOLICENCE") < 1) {
			mes "[魔导机甲技师]";
			mes "请先取得骑乘魔导机甲的许可。";
			close;
		}
		delitem 6939,1;	// Shabby_Old_Belt
		setmadogear();
		mes "[魔导机甲技师]";
		mes "谢谢。如果你找到其他死去士兵遗留的物品，请带给我。";
		close;
	case 3:
		mes "[魔导机甲技师]";
		mes "哦……这样啊，我明白了。";
		close;
	}
}


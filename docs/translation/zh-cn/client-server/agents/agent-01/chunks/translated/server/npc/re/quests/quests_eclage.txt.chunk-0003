eclage,191,200,4	script	Yube#ep14_2	4_M_FAIRYKID5,{
	if (ep14_2_oliver < 8) {
		mes "- 沙沙声 -";
		mes "他正在做什么。";
		mes "别去打扰他。";
		close;
	}
	else if (ep14_2_oliver == 8) {
		mes "- Shuffle shuffle -";
		next;
		mes "- 看起来就是格拉丝说的那个妖精。 -";
		next;
		mes "[Yube]";
		mes "哇！";
		mes "你是谁？！";
		emotion ET_HUK;
		cutin "war_y1",2;
		next;
		if (Class == Job_Warlock || Class == Job_Warlock_T) {
			mes "[Yube]";
			mes "哇！这是谁？是";
			mes strcharinfo(0) +"?";
			mes "你现在更像术士了！";
			emotion ET_SMILE;
			cutin "war_y4",2;
			next;
			mes "[Yube]";
			mes "很高兴在这种地方见到你。";
			mes "到底发生了什么？";
			next;
		}
		select("分享格拉丝的故事。" );
		mes "[Yube]";
		mes "我告诉她要去找制作蜡烛的材料，但不出所料，她根本没在听。";
		mes "她总是对着镜子看自己看得入迷。";
		emotion ET_OHNO;
		cutin "war_y3",2;
		next;
		mes "[Yube]";
		mes "总之，莫伦现在多大了？";
		mes "我记得他比我小，但不太确定……";
		mes "你能替我问问格拉丝他的年龄吗？";
		ep14_2_oliver = 9;
		changequest 11316,11317;
		close2;
		cutin "",255;
		end;
	}
	if (ep14_2_oliver == 14) {
		if (countitem(6561) > 127) {
			if (checkweight(1201,1) == 0 || (MaxWeight - Weight) < 1000) {
			mes "- 到此为止！！ -";
			mes "- 你现在背包里的物品 -";
			mes "- 太多了。 -";
			mes "- 请减轻负重 -";
			mes "- 然后重试。 -";
				close;
			}
			mes "[Yube]";
		mes "哦！";
		mes "你已经收集够了吗？";
		mes "我也正好做够了灯芯！";
			emotion ET_DELIGHT;
			cutin "war_y4",2;
			delitem 6561,128;// Dustball
			ep14_2_oliver = 15;
			getitem 6555,128;// Birthday_Candle
			changequest 11322,11323;
			next;
			mes "[Yube]";
		mes "我就这样把尘土团塑形，再这样放入灯芯！";
		mes "好了！";
			next;
			mes "[Yube]";
		mes "全都做好了！";
		mes "请把它们带给格拉丝。";
			next;
			mes "[Yube]";
		mes "还有……";
		mes "为了回报你，我允许你使用我的房子！";
		mes "只要你在艾可拉玖，随时都可以来住。";
			emotion ET_BEST;
			next;
			mes "[Yube]";
		mes "反正我大部分时间都在斯普兰迪德工作，不常来艾可拉玖。";
		mes "好了，非常感谢~";
		}
		else {
			mes "[Yube]";
		mes "如果你不太忙，能带一团尘土来让我制作蜡烛吗？";
		mes "我必须制作和莫伦年龄一样多的蜡烛，所以请带来足够的尘土。";
			cutin "war_y4",2;
		}
		close2;
		cutin "",255;
		end;
	}
	mes "[Yube]";
	if (ep14_2_oliver == 9) {
		mes "总之，莫伦现在多大了？";
		mes "我记得他比我小，但不太确定……";
		mes "你能替我问问格拉丝他的年龄吗？";
		cutin "war_y3",2;
	}
	else if (ep14_2_oliver == 10) {
		mes "穆拉？穆拉在艾可拉玖广场。";
		cutin "war_y4",2;
	}
	else if (ep14_2_oliver == 11) {
		mes "舒尔？舒尔应该在城市东部。";
		cutin "war_y4",2;
	}
	else if (ep14_2_oliver == 12) {
		mes "塔托？塔托在城市西部。";
		cutin "war_y4",2;
	}
	else if (ep14_2_oliver == 13) {
		mes "什么？！";
		mes "所以没人知道莫伦多大？";
		emotion ET_HUK;
		cutin "war_y3",2;
		next;
		mes "[Yube]";
		mes "嗯，至少总结一下大家说的……";
		mes "他比我小；和格拉丝、穆拉都相差 30 岁，但格拉丝和穆拉并不同岁，";
		mes "舒尔的年龄等于莫伦的年龄加上我一百岁的年龄；舒尔比格拉丝大 2 岁；我和舒尔的平均年龄是塔托的年龄，而塔托是 146 岁，对吧？";
		emotion ET_THINK;
		emotion ET_THINK, playerattached();
		cutin "war_y2",2;
		next;
		mes "[Yube]";
		mes "...";
		mes "那么他到底多大？";
		emotion ET_QUESTION;
		cutin "war_y3",2;
		next;
		input .@inputnum;
		mes "[Yube]";
		if (.@inputnum != 128) {
			mes "嗯~我觉得不是。";
			mes "再仔细想想。";
			cutin "war_y2",2;
		}
		else {
			mes "对！";
			mes "就是这样！";
			mes "我想起来了！！！";
			mes "我记得应该就是这样！";
			emotion ET_AHA;
			cutin "war_y4",2;
			next;
			mes "[Yube]";
			mes "嗯，这意味着我还要制作一百多根蜡烛……";
			mes "哎……";
			emotion ET_KEK;
			cutin "war_y3",2;
			next;
			mes "[Yube]";
			mes "如果你不太忙，能带一团尘土来让我制作蜡烛吗？";
			mes "我必须制作和莫伦年龄一样多的蜡烛，所以请带来足够的尘土。";
			ep14_2_oliver = 14;
			changequest 11321,11322;
		}
	}
	else if (ep14_2_oliver == 15) {
		if (countitem(6555) >= 128) {
			mes "我就这样把尘土团塑形，再这样放入灯芯！";
			mes "好了！";
			cutin "war_y4",2;
			next;
			mes "[Yube]";
			mes "全都做好了！";
			mes "请把它们带给格拉丝。";
		}
		else {
			mes "什么……你把蜡烛弄丢了？";
			mes "我还剩一些灯芯，所以你再带一团尘土来，我就帮你重新制作。";
			emotion ET_PROFUSELY_SWEAT;
			cutin "war_y3",2;
			next;
			cutin "",255;
			if (select("制作蜡烛。:不制作蜡烛。") == 2) {
				mes "[Yube]";
				mes "真的吗？";
				mes "如果还需要，就告诉我~";
				cutin "war_y4",2;
			}
			else if (checkweight(1201,1) == 0 || (MaxWeight - Weight) < 1000) {
				mes "- 负重太高，-";
				mes "- 无法领取物品。-";
				mes "- 请减轻负重 -";
				mes "- 然后重试。-";
				close;
			}

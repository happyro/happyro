		next;
		mes "[???]";
		mes "呃……";
		mes "我已经很久没做过这么生动的梦了……";
		cutin "bu_oliver2",0;
		next;
		mes "[Du Lian]";
		mes "哇哈哈哈哈！";
		mes "梦！";

		mes "你到底从哪里来？";
		cutin "bu_du1",2;
		next;
		mes "[???]";
		mes "嘿~~";
		mes "我还以为你看不见我，看来不是？";
		cutin "bu_oliver2",0;
		next;
		mes "[Du Lian]";
		mes "我怎么可能看不见你？";
		mes "除非你像我们这里的阿尔普一样隐身！";
		mes "也许是因为他是十字斩首者，但即使不使用技能，他也显得非常没有存在感。";
		cutin "bu_du2",2;
		next;

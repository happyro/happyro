moro_vol,132,140,4	script	Tamarin#ep14bs_ju	4_M_TAMARIN,{
	if (ep14_3_newerabs == 9) {
		mes "[Tamarin]";
		mes "哇！";
		mes "没想到会看到这么多人。";
		cutin "ep143_tahuk.bmp",2;
		next;
		mes "[Tamarin]";
		mes "我没能成为第一个发现这里的人，真有点失望；不过在这个阴森的地方不是孤身一人，也让我很高兴。";
		cutin "ep143_taang.bmp",2;
		next;
		mes "[Tamarin]";
		mes "我看到更多那种看起来像人的实体了。";
		mes "这个地方可能比我想象的更不得了！";
		cutin "ep143_tasmi.bmp",2;
		next;
		mes "[Tamarin]";
		mes "看！";
		mes "会走路的树！";
		mes "嗷呜！";
		cutin "ep143_tahuk.bmp",2;
		next;
		mes "[Barget Tiblack]";
		mes "喂！";
		mes "你到底在做什么？！";
		cutin "",255;
		setquest 11354;// Specimen Collection
		ep14_3_newerabs = 15;
		close;
	}
	if (ep14_3_newerabs == 15) {
		mes "[Tamarin]";
		mes "看！";
		mes "会走路的树！";
		mes "嗷呜！";
		cutin "ep143_tahuk.bmp",2;
		next;
		mes "[Barget Tiblack]";
		mes "喂！";
		mes "你到底在做什么？！";
		cutin "",255;
		close;
	}
	if (ep14_3_newerabs == 16) {
		mes "[Tamarin]";
		mes "如果他们知道我们偷偷溜进来，可能会把我们赶出去。";
		mes "现在先按他们说的做吧，好吗？";
		cutin "ep143_taang.bmp",2;
		close3;
	}
	if (ep14_3_newerabs == 17 || ep14_3_newerabs == 18) {
		mes "[Tamarin]";
		mes "收集植物样本听起来不太难。我们可以分头收集。";
		cutin "ep143_tasta.bmp",2;
		next;
		mes "[Tamarin]";
		mes "^0000FF收集到25根索尼娅茎后，到这里中央的大岩石旁找我。^000000";
		if (ep14_3_newerabs == 17) {
			erasequest 11356;// Specimen Collection
			setquest 11357;// Specimen Collection
			ep14_3_newerabs = 18;
		}
		close3;
	}
	if (ep14_3_newerabs == 19) {
		if (countitem(6690) < 25) {// YummyStem
			mes "[Tamarin]";
			mes "哦！（皱眉）";
			mes "你的茎不够。";
			mes "再收集一些，然后带给巴杰特。";
			cutin "ep143_tahuk.bmp",2;
			close3;
		}
		mes "[Tamarin]";
		mes "我们先去向巴杰特报告吧。";
		cutin "ep143_tahuk.bmp",2;
		close3;
	}
	if (ep14_3_newerabs == 21 || ep14_3_newerabs == 22) {
		mes "[Tamarin]";
		mes "快点，";
		mes "赶紧去找^0000FF鲁根教官^000000！";
		cutin "ep143_tahuk.bmp",2;
		close3;
	}
	if (ep14_3_newerabs == 23) {
		mes "[Tamarin]";
		mes "感谢诸神，谁能想到我饿急了吃下的东西竟然救了我？";
		mes "我们去向巴杰特报告吧。";
		cutin "ep143_tahuk.bmp",2;
		close3;
	}
	if (ep14_3_newerabs == 24) {
		mes "[Tamarin]";
		mes "啊！";
		mes "" + strcharinfo(0) + "，趁其他人还没探索，快进洞穴！";
		cutin "ep143_tahuk.bmp",2;
		close3;
	}
	mes "[Tamarin]";
	mes "呃……";
	mes "我明明是第一个来到这里的人！";
	cutin "ep143_taang.bmp",2;
	close3;
}

moro_vol,142,131,5	script	Barget Tiblack#ep14bs	4_M_ALCHE_D,{
	if (checkweight(1119,3) == 0) {
		mes "- 你携带的物品太多，无法继续任务。-";
		close;
	}
	if (ep14_3_newerabs < 15) {
		mes "[Barget Tiblack]";
		mes "呃，我累坏了。";
		mes "我明白事情很紧急，但这不代表我喜欢被人呼来喝去。";
		close;
	}
	if (ep14_3_newerabs == 15) {
		mes "[Barget Tiblack]";
		mes "你毁了我珍贵的样本！";
		mes "我不是叫过你们这种人离我的工作区远一点吗？你的上级没告诉你？";
		next;
		mes "[Barget Tiblack]";
		mes "我在营地的研究还没完成，他们又把我拖来做另一个麻烦项目。";
		next;
		mes "[Barget Tiblack]";
		mes "我要求一个助手！";
		mes "别再拿预算问题搪塞我了！";
		mes "啊！";
		next;
		mes "[Barget Tiblack]";
		mes "...";
		mes "...";
		next;
		mes "[Barget Tiblack]";
		mes "好吧。";
		mes "你们两个！";
		mes "你们一定很闲，才会在这里漫无目的地闲逛。做点有用的事，帮我收集样本。";
		next;
		mes "[Barget Tiblack]";
		mes "毕竟你们已经毁掉我现有的样本了。";
		next;
		mes "[Barget Tiblack]";
		mes "首先，我要收集动物样本。";
		mes "这里经常能看到变异动物。最近，其中一种被确认是^0000FF全新的物种^000000。";
		next;
		mes "[Barget Tiblack]";
		mes "^0000FF这种新型昆虫被称为火虫，因为它们周身被火焰包围，生活在那样的火坑里。^000000";
		next;
		mes "[Barget Tiblack]";
		mes "爬出火坑的火虫很快就会死亡。";
		next;
		mes "[Barget Tiblack]";
		mes "请调查^0000FF20个火坑，并从火虫身上收集50个燃烧昆虫外壳^000000。";
		mes "过程中小心别烧伤自己。";
		erasequest 11354;// Specimen Collection
		setquest 11355;// Specimen Collection
		ep14_3_newerabs = 16;
		close;
	}
	if (ep14_3_newerabs < 19) {
		if (ep14_3_newerabs == 16) {
			if (countitem(6689) < 50 || checkquest(11355,HUNTING) != 2) {
				mes "[Barget Tiblack]";
				mes "首先，我要收集动物样本。";
				mes "这里经常能看到变异动物。最近，其中一种被确认是^0000FF全新的物种^000000。";
				next;
				mes "[Barget Tiblack]";
				mes "^0000FF这种新型昆虫被称为火虫，因为它们周身被火焰包围，生活在那样的火坑里。^000000";
				next;
				mes "[Barget Tiblack]";
				mes "爬出火坑的火虫很快就会死亡。";
				next;
				mes "[Barget Tiblack]";
				mes "请调查^0000FF20个火坑，并从火虫身上收集50个燃烧昆虫外壳^000000。";
				mes "过程中小心别烧伤自己。";
				close;
			}
			mes "[Barget Tiblack]";
			mes "哦，";
			mes "做得好！";
			mes "你完成任务的速度比我预想的快。";
			delitem 6689,50;// BurningSkin
			erasequest 11355;// Specimen Collection
			setquest 11356;// Specimen Collection
			ep14_3_newerabs = 17;
			next;
			mes "[Barget Tiblack]";
			mes "哎哟，好烫！";
			mes "*呼哧呼哧*";
			mes "趁它们冷却前，我先把它们装瓶，然后送到实验室。";
			next;
		}
		mes "[Barget Tiblack]";
		mes "现在轮到植物样本了。";
		mes "我们的目标植物叫索尼娅，是一种非常原始的植物。";
		next;
		mes "[Barget Tiblack]";
		mes "乍看之下，索尼娅像塑料管，但结构非常简单。";
		next;
		mes "[Barget Tiblack]";
		mes "它们不难收集。请^0000FF采集50株索尼娅，并带给我50根茎^000000。";
		next;
		mes "[Barget Tiblack]";
		mes "索尼娅样本是我最后要收集的样本。如果你碰巧^0000FF看到了奇怪的索尼娅^000000，请马上告诉我。";
		next;
		mes "[Barget Tiblack]";
		mes "尽量不要离基地太远。外面太危险了。";
		mes "平安回来。";
		next;
		mes "[Tamarin]";
		mes "嗯……";
		mes "" + strcharinfo(0) + "，等等！";
		cutin "ep143_tahuk.bmp",2;
		close3;
	}
	if (ep14_3_newerabs == 19) {
		if (countitem(6690) < 25) {
			mes "[Barget Tiblack]";
			mes "索尼娅收集得怎么样了？";
			close;
		}
		mes "[Barget Tiblack]";
		mes "啊，";
		mes "欢迎回来！";
		mes "我忘了告诉你，^0000FF不要靠近这里中央的岩石^000000。";
		next;
		mes "[Barget Tiblack]";
		mes "意识到自己的疏忽后，我担心你的安全，立刻叫了救援队。很高兴你毫发无伤地回来了。";
		next;
		mes "[Barget Tiblack]";
		mes "我为自己之前的混蛋态度道歉。";
		mes "繁重的工作让我压力很大。";
		next;
		mes "[Barget Tiblack]";
		mes "我还有这么多事要做……唉……";
		next;
		select("告诉她中央岩石的事。");
		mes "[Barget Tiblack]";
		mes "你说什么？！";
		mes "你去那里了？！";
		mes "而且还毫发无伤地回来了？怎么做到的？";
		next;
		mes "[Barget Tiblack]";
		mes "其他去那里的人都^0000FF因为岩石释放的有毒气体而陷入昏迷^000000。";
		next;
		mes "[Barget Tiblack]";
		mes "你做了什么？";
		mes "这是重大发现！";
		next;
		select("转述发生的事情。");
		mes "[Barget Tiblack]";
		mes "你吃了一根索尼娅茎。";
		mes "好吧，我知道这种茎没有毒，但还没完成成分研究。你有感到什么副作用吗？";
		next;
		mes "[Barget Tiblack]";
		mes "哇！";
		mes "这真是重大发现！";
		next;
		mes "[Barget Tiblack]";
		mes "我最好回去继续研究……";
		mes "不，我们首先必须^0000FF治疗那些需要索尼娅茎的患者。请把他们带来。^000000";
		next;
		mes "[Barget Tiblack]";
		mes "^0000FF鲁根教官负责管理他们^000000，所以你可以把他们带到他那里。";
		mes "请把文件交给我。我来替你签字。";
		next;
		mes "[Barget Tiblack]";
		mes "我最好回去继续研究植物茎。我会找其他人帮忙。";
		mes "这次算你走运。最好别养成吃地上东西的习惯。";
		erasequest 11358;// Specimen Collection
		setquest 11359;// Antidote
		ep14_3_newerabs = 20;
		close;
	}
	if (ep14_3_newerabs == 20) {
		mes "[Barget Tiblack]";
		mes "我最好回去继续研究……";
		mes "不，我们首先必须^0000FF治疗那些需要索尼娅茎的患者。请把他们带来。^000000";
		next;
		mes "[Barget Tiblack]";
		mes "^0000FF鲁根教官负责管理他们^000000，所以你可以把他们带到他那里。";
		mes "请把文件交给我。我来替你签字。";
		next;
		mes "[Barget Tiblack]";
		mes "我最好回去继续研究植物茎。我会找其他人帮忙。";
		mes "这次算你走运。最好别养成吃地上东西的习惯。";
		close;
	}
	if (ep14_3_newerabs < 23) {
		mes "[Barget Tiblack]";
		mes "你见到鲁根教官了吗？";
		close;
	}
	if (ep14_3_newerabs == 23) {
		mes "[Barget Tiblack]";
		mes "哈哈哈哈！";
		mes "进展如何？";
		mes "他们奏效了，对吧？";
		next;
		mes "[Barget Tiblack]";
		mes "我对自己的研究很有信心。";
		mes "你看似鲁莽的决定救了许多人的性命。";
		next;
		mes "[Barget Tiblack]";
		mes "这样一来，我们很快就能彻底调查那个^0000FF可疑的洞穴^000000了！";
		next;
		select("什么洞穴？");
		mes "[Barget Tiblack]";
		mes "哦，就是释放有毒气体的洞穴。";
		mes "气体在空气中^0000FF浓得让你看不清洞穴入口^000000。";
		next;
		mes "[Barget Tiblack]";
		mes "我们给了第一批疫苗的人已经前往洞穴了。";
		mes "目前还没有他们的消息。我希望这是个好兆头。";
		next;
		mes "[Barget Tiblack]";
		mes "要不是有你们两个，我可能已经气得把头发全扯掉了。";
		mes "干得好，你们两个！";
		getexp 0,1500000;
		completequest 11362;// Antidote
		ep14_3_newerabs = 24;
		close;
	}
	mes "[Barget Tiblack]";
	mes "我们给了第一批疫苗的人已经前往洞穴了。";
	mes "目前还没有他们的消息。我希望这是个好兆头。";
	next;
	mes "[Barget Tiblack]";
	mes "要不是有你们两个，我可能已经气得把头发全扯掉了。";
	mes "干得好，你们两个！";
	close;
}

moro_vol,198,179,4	script	Tamarin#ep14bs_st	4_M_TAMARIN,{

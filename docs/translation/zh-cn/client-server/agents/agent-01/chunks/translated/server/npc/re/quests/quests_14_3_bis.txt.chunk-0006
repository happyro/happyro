		next;
		mes "[Tamarin]";
		mes "呼！";
		mes "你能找到我真是太好了。";
		cutin "ep143_tasmi.bmp",2;
		next;
		mes "[Tamarin]";
		mes "让我把泥土清理掉……";
		mes "小心入口，那里非常狭窄。";
		cutin "ep143_tasta.bmp",2;
		next;
		if (select( "进入。", "退出。" ) == 2) {
			mes "[Tamarin]";
			mes "你不进去吗？";
			cutin "ep143_tahuk.bmp",2;
			close3;
		}
		mes "- 通道仅勉强能容纳一个人通过。-";
		completequest 11353;// Dimensional Travel
		ep14_3_newerabs = 9;
		close2;
		warp "moro_vol",136,135;
		end;
	}
	mes "- 一堆沙子突兀地堆在那里，与周围格格不入。-";
	next;
	if (select( "进入。", "退出。" ) == 2) {
		mes "你决定不进去。";
		close;
	}
	mes "- 通道仅勉强能容纳一个人通过。-";
	close2;
	warp "moro_vol",136,135;
	end;
}


		next;
		mes "[Tamarin]";
		mes "你觉得怎么样？";
		mes "很好吃吧？";
		cutin "ep143_tahuk.bmp",2;
		next;
		mes "[Tamarin]";
		mes "我只剩几根了。我们轮流再收集一些吧。";
		cutin "ep143_tasmi.bmp",2;
		erasequest 11357;// Specimen Collection
		setquest 11358;// Specimen Collection
		ep14_3_newerabs = 19;
		close3;
	}
	if (ep14_3_newerabs == 19) {
		mes "[Tamarin]";
		mes "我只剩几根了。我们轮流再收集一些吧。";
		cutin "ep143_tasmi.bmp",2;
		close3;
	}
	if (ep14_3_newerabs < 23) {
		mes "[Tamarin]";
		mes "快点，";
		mes "赶紧去找^0000FF鲁根教官^000000！";
		cutin "ep143_tahuk.bmp",2;
		close3;
	}
	if (ep14_3_newerabs == 23) {
		mes "[Tamarin]";
		mes "感谢诸神，谁能想到我饿急了吃下的东西竟然救了我？";
		mes "我们去向巴杰特报告吧。";
		cutin "ep143_tahuk.bmp",2;
		close3;
	}
	mes "[Tamarin]";
	mes "啊！";
	mes "" + strcharinfo(0) + "，趁其他人还没探索，快进去！";
	cutin "ep143_tahuk.bmp",2;
	next;
	if (select( "进入。", "退出。" ) == 2) {
		mes "[Tamarin]";
		mes "啊……";
		cutin "ep143_taang.bmp",2;
		close3;
	}
	mes "[Tamarin]";
	mes "地面很暗。小心脚下！";
	close2;
	warp "moro_cav",40,50;
	end;
}

moro_vol,105,71,5	script	Instructor Rugen#ep14bs	4_M_YOUNGKNIGHT,{
	if (ep14_3_newerabs < 20) {
		mes "[Instructor Rugen]";
		mes "呼……";
		mes "你为什么这么鲁莽？";
		next;
		mes "[Instructor Rugen]";
		mes "这值得吗？";
		mes "...";
		close;
	}
	if (ep14_3_newerabs == 20) {
		mes "[Instructor Rugen]";
		mes "呼……";
		mes "你为什么这么鲁莽？";
		next;
		mes "[Instructor Rugen]";
		mes "这值得吗？";
		mes "...";
		next;
		if (select( "和他说话。", "不了，他看起来太难过，不想说话。" ) == 2) {
			mes "[Instructor Rugen]";

thor_camp,134,309,5	script	Soldier#vol2	939,{
		mes "[托尔火山营地士兵]";
		mes "听说今晚晚餐有鸡肉沙拉、炸鸡，";
		mes "还有昆仑风味鸡！";
		mes "不知道是谁这么慷慨，";
		mes "捐了这么多鸡给我们？";
		mes "我已经开始期待晚餐了。";
		mes "希望消息是真的。";

		mes "[维托上校]";
		mes "你还站在那里做什么？";
		mes "别偷懒！过来！";
		mes "马上跟我走！";
		close2;
		disablenpc "Colonel Vito#1";
		warp "thor_camp",156,68;
		end;
	}
	end;
}


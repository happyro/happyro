		mes "注意听令！";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "你是在叫我吗？";
		mes "不，我是维纳斯地质——";
		next;
		mes "[维托上校]";
		mes "看看你。你连制服都还没有，";
		mes "还是个新兵吧？";
		mes "看来得由我亲自训练你，";
		mes "把你培养成我们的圣骑士！";
		mes "别担心，我会好好指导你的。";
		mes "你会成为合格的圣骑士！";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "可是我不是——";
		next;
		mes "[维托上校]";
		mes "你应该感到荣幸，竟有机会";
		mes "接受伟大的维托上校亲自训练。";
		mes "我会把你塑造成真正的";
		mes "芙蕾雅战士！现在跟我来！";
		mes "快点，别磨蹭！";
		mes "服从命令！";
		changequest 2122,2123;
		set aru_vol,14;
		close2;
		disablenpc "Colonel Vito#1";
		warp "thor_camp",156,68;
		end;
	}
	else if (aru_vol == 14) {

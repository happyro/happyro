thor_camp,159,74,3	script	Colonel Vito#3	946,{
	if (aru_vol == 14) {
		mes "[维托上校]";
		mes "我是维托上校，";
		mes "负责管理这里的";
		mes "阿鲁纳佩尔兹营地，";
		mes "也就是托尔火山营地。";
		mes "士兵，你叫什么名字？";
		next;
		mes "["+strcharinfo(0)+"]";
		mes ""+strcharinfo(0)+", sir.";
		next;
		mes "[维托上校]";
		mes "哼！真是个软弱的名字！";
		mes "我看得出来，你的身心都太弱了！";
		mes "这样可不行。你怎么配得上";
		mes "侍奉美丽优雅的芙蕾雅？";
		mes "你必须变得更强。";
		mes "否则就别想成为士兵。";
		next;
		mes "[维托上校]";
		mes "你需要更多训练。";
		mes "先休息一下，做好准备。";
		mes "等你准备好后，";
		mes "我们马上开始。";
		set aru_vol,15;
		close;
	}
	else if (aru_vol == 15) {
		mes "[维托上校]";
		mes "首先，我们要纠正你软弱的意志。";
		mes "第一项训练以口头练习为主，";
		mes "用来磨炼你的精神。";
		mes "你必须牢记我们的信念。";
		mes "现在开始。";
		next;
		while(1) {
		mes "[维托上校]";
		mes "第一个问题！";
		mes "我们为谁而战？";
		mes "我们为谁而活？";
			next;
		if (select("奥丁:芙蕾雅:托尔") == 2) {
				break;
			}
		mes "[维托上校]";
		mes "你这个笨蛋！";
			percentheal -10,0;
			specialeffect2 EF_HIT2;
			next;
		}
		mes "[维托上校]";
		mes "没错！芙蕾雅不仅是爱之女神，";
		mes "也是战争女神。";
		mes "我们肩负着神圣使命，";
		mes "要为她找回尤弥尔之心的碎片。";
		mes "这就是我们的职责。";
		mes "绝不能失败。";
		next;
		mes "[维托上校]";
		mes "在神、人类与恶魔之间的战争中，";
		mes "芙蕾雅受了重伤。";
		mes "众神之首奥丁试图帮助她，";
		mes "但即使是他的力量也不够。";
		mes "她的伤势非常严重。";
		mes "我们必须帮助她恢复。";
		next;
		mes "[维托上校]";
		mes "奥丁建议她取得尤弥尔之心，";
		mes "因为它能让她完全恢复力量。";
		mes "所以我们才在准备战争：";
		mes "必须为芙蕾雅取得尤弥尔之心！";
		mes "这是我们唯一的目标。";
		mes "你听明白了吗？";
		next;
		mes "[维托上校]";
		mes "你明白了吗？！";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "明白，长官！";
		next;
		mes "[维托上校]";
		mes "现在，有一个充满蠢货的国家，";
		mes "名叫卢恩-米德加尔特王国。";
		mes "他们的祖先把我们视为异端，";
		mes "把我们赶到了这片荒芜之地。";
		mes "这份屈辱我们永远不会忘记。";
		mes "记住他们的罪行。";
		next;
		mes "[维托上校]";
		mes "我们不能原谅他们剥夺了";
		mes "我们信仰芙蕾雅的自由。";
		mes "我们的人一定会向他们复仇。";
		mes "士兵，记住我的话。";
		mes "现在跟着我重复。";
		mes "一字不差地重复。";
		next;
		mes "[维托上校]";
		mes "我，"+strcharinfo(0)+"，";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "我，"+strcharinfo(0)+"，";
		next;
		while(1) {
		mes "[维托上校]";
		mes "^FF0000作为虔诚的仆人，";
		mes "侍奉芙蕾雅女神，";
			next;
			input .@input$;
		set .@answer$,"as a devoted servant of Goddess Freya";
			if (.@input$ == .@answer$) {
				mes "["+strcharinfo(0)+"]";
				mes "作为虔诚的仆人，侍奉";
				mes "伟大的阿鲁纳佩尔兹的";
				mes "守护女神芙蕾雅，^000000";
				mes "我将永远忠诚。^000000";
				next;
				break;
			}
			else {
		mes "[维托上校]";
				mes "错了！再试一次！";
				next;
			}
		}
		while(1) {
			mes "[维托上校]";
			mes "^FF0000我发誓将推翻";
			mes "我们不共戴天的敌人，";
			next;
			input .@input$;
			set .@answer$,"I pledge my honor to overthrow our mortal enemy";
			if (.@input$ == .@answer$) {
				mes "["+strcharinfo(0)+"]";
				mes "我发誓将推翻我们的宿敌，";
				mes "卢恩-米德加尔特王国。";
				mes "这是我的誓言。";
				next;
				break;
			}
			else {
			mes "[维托上校]";
				mes "错了！再试一次！";
				next;
			}
		}
		while(1) {
			mes "[维托上校]";
			mes "^FF0000我绝不怜悯任何人。^000000";
			next;
			input .@input$;
			set .@answer$,"I will show no mercy";
			if (.@input$ == .@answer$) {
				mes "["+strcharinfo(0)+"]";
				mes "我绝不怜悯任何人。";
				mes "没有什么能阻止我的行动。^000000";
				next;
				break;
			}
			else {
			mes "[维托上校]";
				mes "错了！再试一次！";
				next;
			}
		}
		while(1) {
			mes "[维托上校]";
			mes "^FF0000我将把一生奉献给";
			mes "芙蕾雅女神。^000000";
			next;
			input .@input$;
			set .@answer$,"I shall devote my entire life";
			if (.@input$ == .@answer$) {
				mes "["+strcharinfo(0)+"]";
				mes "我将把一生奉献给";
				mes "芙蕾雅女神，直到她";
				mes "完全恢复力量。^000000";
				mes "我将永远忠于她。^000000";
				next;
				break;
			}
			else {
			mes "[维托上校]";
				mes "错了！再试一次！";
				next;
			}
		}
		while(1) {
			mes "[维托上校]";
			mes "^FF0000打倒卢恩-米德加尔特王国！^000000";
			mes "让敌人覆灭！";
			next;
			input .@input$;
			set .@answer$,"Down with the Rune-Midgarts Kingdom!";
			if (.@input$ == .@answer$) {
				mes "["+strcharinfo(0)+"]";
				mes "打倒卢恩-米德加尔特王国！^000000";
				mes "让敌人覆灭！^000000";
				next;
				break;
			}
			else {
			mes "[维托上校]";
				mes "错了！再试一次！";
				next;
			}
		}
		mes "[维托上校]";
		mes "很好。现在你知道作为芙蕾雅的";
		mes "圣战士必须具备怎样的态度了。";
		mes "第一项训练到此结束，";
		mes "但还有一项训练等着你。";
		mes "做好准备。";
		mes "下次继续。";
		changequest 2123,2124;
		set aru_vol,16;
		close;
	}
	else if (aru_vol == 16) {
		mes "[维托上校]";
		mes "在开始第二项训练前，";
		mes "我有一项任务要交给你。";
		mes "去这栋建筑北边的巨大管道区，";
		mes "找出所有损坏的机器。";
		mes "不要遗漏任何一台。";
		mes "立刻出发。";
		set aru_vol,17;
		close;
	}
	else if (aru_vol == 17) {
		mes "[维托上校]";
		mes "检查这栋建筑北边";
		mes "管道区里的机器。";
		mes "别磨蹭，马上出发！";
		mes "完成任务后回来报告。";
		close;
	}
	else if (aru_vol == 18) {
		mes "[维托上校]";
		mes "干得好。记住，你的首要任务是";
		mes "检查控制面板。";
		mes "它控制着营地的能源，";
		mes "所以必须定期检查。";
		mes "不要忘记这一点。";
		mes "这是非常重要的工作。";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "明白，长官！";
		next;
		mes "[维托上校]";
		mes "现在开始第二项训练，";
		mes "这项训练会强化你的身体。";
		mes "看到你面前的木桩了吗？";
		mes "用手刀劈它 10 次。";
		mes "开始！";
		mes "不要偷懒！";
		changequest 2125,2126;
		set aru_vol,19;
		next;
		if (select("明白，长官！:劈是什么意思？") == 1) {
			mes "[维托上校]";
			mes "劈砍时把力量集中在";
			mes "你的呐喊中！";
			mes "劈！10 次！开始！";
			close;
		}
		mes "[维托上校]";
		mes "劈……？就是手刀。";
		mes "用手掌的底部像刀刃一样";
		mes "击打敌人。";
		mes "你连这个都不知道，";
		mes "到底是怎么加入军队的？";
		mes "算了，快开始训练。";
		next;
		mes "[维托上校]";
		mes "劈砍时把力量集中在";
		mes "你的呐喊中！";
		mes "劈！10 次！开始！";
		close;
	}
	else if (aru_vol == 20) {
		mes "[维托上校]";
		mes "训练越多，你就会变得越强。";
		mes "你越强，芙蕾雅的圣军也越强。";
		mes "每天都要训练，";
		mes "绝不许偷懒！";
		mes "记住你的使命。";
		mes "继续努力。";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "明白，长官！";
		next;
		mes "[维托上校]";
		mes "你的训练到此结束。";
		mes "如果对营地生活有任何疑问，";
		mes "就去问这栋建筑外的萨赫迪。";
		mes "你可以解散了。";
		mes "现在离开这里。";
		mes "听清楚了吗？";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "(^333333嗯……我想我还是回去找萨赫迪吧。";
		mes "希望他把我当成地质研究员，";
		mes "而不是士兵。^000000)";
		mes "(^333333这训练真奇怪。^000000)";
		mes "(^333333不过总算结束了。^000000)";
		mes "(^333333我得继续调查。^000000)";
		mes "(^333333走吧。^000000)";
		changequest 2126,2127;
		set aru_vol,21;
		close;
	}
			mes "[维托上校]";
		mes "训练时必须始终保持警惕。";
		mes "你永远不知道芙蕾雅何时会召唤我们战斗！";
		mes "随时做好准备。";
		mes "不要松懈。";
	close;
}


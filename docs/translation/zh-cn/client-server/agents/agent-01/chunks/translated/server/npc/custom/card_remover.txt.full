//===== rAthena Script =======================================
//= Card Removal NPC
//===== By: ==================================================
//= TyrNemesis^
//===== Current Version: =====================================
//= 1.2a
//===== Compatible With: =====================================
//= rAthena Project
//===== Description: =========================================
//= Removes cards from equipped items.
//===== Additional Comments: =================================
//= 1.0 First version. [TyrNemesis^]
//= 1.2 Optimized and fixed getequipname menu. [Kisuka]
//= 1.2a Added 'disable_items' command. [Euphy]
//============================================================

prt_in,28,73,4	script	Wise Old Woman#eAcustom	78,{

	set .zenycost,200000;    // base cost of the card remover services (in Zeny)
	set .percardcost,25000;  // cost per card of the card remover services (in Zeny)
	set .faildestroy,1;      // should the card remover have a chance of failure that destroys items? (1=yes, 0=no)

	disable_items;
	mes "[Wise Old Woman]";
	mes "你好，年轻人。我能从装备上拆除已经插入的卡片。你觉得这个主意如何？";
	next;
	switch(select("很好。:你怎么收费？:不用了，谢谢。")) {
	case 1:
		mes "[Wise Old Woman]";
		mes "好的。要我检查哪件物品？";
		next;

		setarray .@indices[1], EQI_HEAD_TOP, EQI_ARMOR, EQI_HAND_L, EQI_HAND_R, EQI_GARMENT, EQI_SHOES, EQI_ACC_L, EQI_ACC_R, EQI_HEAD_MID, EQI_HEAD_LOW;
		for( set .@i,1; .@i <= 10; set .@i,.@i+1 ) {
			if( getequipisequiped(.@indices[.@i]) )
				set .@menu$, .@menu$ + F_getpositionname(.@indices[.@i]) + "-[" + getequipname(.@indices[.@i]) + "]";
			set .@menu$, .@menu$ + ":";
		}
		set .@part, .@indices[ select(.@menu$) ];
		if(!getequipisequiped(.@part)) {
			mes "[Wise Old Woman]";
			mes "年轻人……你身上没有可以拆卡的装备。";
			close;
		}
		if(getequipcardcnt(.@part) == 0) {
			mes "[Wise Old Woman]";
			mes "年轻人……这件物品没有插入卡片。恐怕我无能为力。";
			close;
		}
		set .@cardcount,getequipcardcnt(.@part);
		
		if (!checkweight(1202,(.@cardcount+1))) { 
			mes "^3355FF请稍等！";
			mes "我无法为你提供服务，";
			mes "因为你携带的物品太多。";
			mes "把多余物品放进卡普拉仓库，";
			mes "再来找我吧~";
			close;
			}
		mes "[Wise Old Woman]";
		mes "这件物品插入了 " + .@cardcount + " 张卡片。施展魔法需要 " + (.zenycost+(.@cardcount * .percardcost)) + " Zeny、一个 ^0000FF星星的粉末^000000 和一个 ^0000FF黄色魔力矿石^000000。";
		next;
		if(select("好的，开始吧。:算了。") == 2) {
		mes "[Wise Old Woman]";
			mes "好的。需要服务时随时回来。";
			close;
			}
		if((zeny < (.zenycost+(.@cardcount * .percardcost))) || (countitem(1000) < 1) || (countitem(715) < 1)) {
		mes "[Wise Old Woman]";
			mes "孩子，你没有施法所需的全部物品。准备好后再来。";
			close;
			}
		mes "[Wise Old Woman]";
		mes "开始前必须警告你——我可能会失败。失败的话，卡片、物品或两者都可能被毁。我不退款。话说回来，对你而言什么更重要：卡片还是物品？";
		next;
		switch(select("我改变主意了。:物品。:卡片。")) {
		case 1:
		mes "[Wise Old Woman]";
			mes "好的。需要服务时随时回来。";
			close;
			case 2:
		set .@failtype,1;
			break;
			case 3:
		set .@failtype,2;
			}
		mes "[Wise Old Woman]";
		mes "很好。我要开始了。";
		set Zeny, Zeny - (.zenycost+(.@cardcount * .percardcost));
		delitem 1000,1; //Star_Crumb
		delitem 715,1; //Yellow_Gemstone
		

		// Replace the constants in the next 3 lines with failure chance values defined in refine_db.txt
		// First value = Total failure chance (item and cards destroyed)
		// Second value = Partial failure chance (one or the other is destroyed, player decides which one is safe)
		// Third value = Harmless failure chance (all that's lost is your investment)
		
set .@failchance,rand(100);
		if (.faildestroy==1) {
		if(.@failchance < 2) {
			next;
				failedremovecards .@part,0;
				mes "[Wise Old Woman]";
				mes "过程彻底失败了。恐怕物品和卡片都被毁掉了。";
				close;
				}

if(.@failchance < 8) {
			if (.@failtype == 1) {
				next;
					failedremovecards .@part,1;
					mes "[Wise Old Woman]";
					mes "我成功从物品上拆下了卡片，但卡片在过程中被毁了。不过物品没事。";
					close;
				}

if (.@failtype == 2) {
				next;
					failedremovecards .@part,2;
					mes "[Wise Old Woman]";
					mes "太不幸了。我成功拆下卡片，但物品本身在过程中被毁了。";
					close;
					}
				}
			}

if(.@failchance < 10) {
		next;
			failedremovecards .@part,3;
			mes "[Wise Old Woman]";
			mes "我没能拆下卡片。不过幸运的是，物品和卡片都完好无损。";
			close;
			}
		next;
		successremovecards .@part;
		mes "[Wise Old Woman]";
		mes "过程成功了。这是你的卡片和物品。再见。";
		close;
		case 2:
	mes "[Wise Old Woman]";
		mes "我收取固定费用 "+callfunc("F_InsertComma",.zenycost)+" Zeny，每拆一张卡片另收 "+callfunc("F_InsertComma",.percardcost)+" Zeny。此外，施法还需要星星的粉末和黄色魔力矿石。";
		close;
		case 3:
	mes "[Wise Old Woman]";
		mes "好的。需要服务时随时回来。";
		close;
		}
	}

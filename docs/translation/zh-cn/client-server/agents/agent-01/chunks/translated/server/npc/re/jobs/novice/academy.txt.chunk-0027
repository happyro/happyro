				mes "[Tadde]";
				mes "这意味着^A20B09精炼等级越高的武器越难获得。^000000";
				next;
				mes "[Tadde]";
				mes "从前来精炼的顾客来看，精炼 1、2 级武器的人比精炼 3、4 级武器的人更多。";
				next;
				continue;
			case 2:
				mes "[Tadde]";
				mes "安全精炼取决于铠甲或武器的等级，所以每个等级基本都有^3E86C3不同的安全升级等级。^000000";
				next;
				while(1) {
					switch(select("1 级武器", "2 级武器", "3 级武器", "4 级武器", "铠甲", "问题结束")) {
					case 1:
						mes "[Tadde]";
						mes "1 级武器精炼到^A20B09+7^000000 以内是安全的。武器等级越低，可达到的精炼数值越高。";
						next;
						mes "[Tadde]";
						mes "当然，它的效果比 1 级武器更强。";
						next;
						continue;
					case 2:
						mes "[Tadde]";
						mes "2 级武器精炼到^A20B09+6^000000 以内是安全的，虽然精炼数值低于 1 级武器。";
						next;
						mes "[Tadde]";
						mes "当然，它的效果比 1 级武器更强。";
						next;
						continue;
					case 3:
						mes "[Tadde]";
						mes "3 级武器精炼到^A20B09+5^000000 以内是安全的。简单来说，武器每提升一个等级，安全精炼等级就降低 1。";
						next;
						mes "[Tadde]";
						mes "武器等级越高，每次 +1 精炼带来的提升效果也越高。";
						next;
						continue;
					case 4:
						mes "[Tadde]";
						mes "4 级武器精炼到^A20B09+4^000000 以内是安全的。4 级武器非常稀有，所以带它们来这里的顾客不多。";
						next;
						mes "[Tadde]";
						mes "因为它是最奢华的武器之一，所以精炼效果也是最强的。";
						next;
						continue;
					case 5:
						mes "[Tadde]";
						mes "铠甲和 4 级武器一样，精炼到^A20B09+4^000000 以内是安全的。";
						next;
						mes "[Tadde]";
						mes "由于大多数精炼师习惯制作武器，所以很难安全地升级铠甲。";
						next;
						continue;
					case 6:
						mes "[Tadde]";
						mes "关于安全精炼的说明，你似乎已经听够了。";
						next;
						break;
					}
					break;
				}
				continue;
			case 3:
				break;
			}
			break;
		}
		completequest 5154;
		mes "[Tadde]";
		mes "你的问题到此结束。如果以后还有疑问，随时来找我。";
		close;
	}
	mes "[Tadde]";
	mes "这里出售用于精炼铁制或钢制武器的金属！";
	mes "我们有用于 1 级武器的^007777魔幻之石^000000，以及用于 2 级武器的^007777神之金属^000000。";
	next;
	switch(select("魔幻之石 - 200 Zeny。", "神之金属 - 1000 Zeny。", "询问其他金属。")) {
	case 1:
		mes "[Tadde]";
		mes "你想要多少？如果想结束请输入‘0’。";
		next;
		while(1) {
			input .@amount, 0, 501;
			if (.@amount == 0) {
				mes "[Tadde]";
				mes "交易结束。";
				close;
			} else if (.@amount > 500) {
				mes "[Tadde]";
				mes "请将数量减少到 500 个或以下。";
				next;
			} else {
				break;
			}
		}
		.@sell = .@amount * 200;
		.@item_weight = .@amount * 200;
		if (Zeny < .@sell) {
			mes "[Tadde]";
			mes "哎呀……很抱歉，你的钱不够。";
			mes "抱歉，我们不能再便宜了……我们只是小本生意。";
			close;
		}
		if ((MaxWeight - Weight) < .@item_weight) {
			mes "[Tadde]";
			mes "呃……领取这些物品前，请先整理你的物品栏……";
			close;
		}
		Zeny -= .@sell;
		getitem 1010,.@amount;// Phracon
		mes "[Tadde]";
		mes "这就是你要的东西。非常感谢！";
		close;
	case 2:
		mes "[Tadde]";
		mes "你想要多少？如果想结束请输入‘0’。";
		next;
		while(1) {
			input .@amount, 0, 501;
			if (.@amount == 0) {
				mes "[Tadde]";
				mes "交易结束。";
				close;
			} else if (.@amount > 500) {
				mes "[Tadde]";
				mes "请将数量减少到 500 个或以下。";
				next;
			} else {
				break;
			}
		}
		.@sell = .@amount * 1000;
		.@item_weight = .@amount * 200;
		if (Zeny < .@sell) {
			mes "[Tadde]";
			mes "哎呀……很抱歉，你的钱不够。";
			mes "抱歉，我们不能再便宜了……我们只是小本生意。";
			close;
		}
		if ((MaxWeight - Weight) < .@item_weight) {
			mes "[Tadde]";
			mes "呃……领取这些物品前，请先整理你的物品栏……";
			close;
		}
		getitem 1011,.@amount;// Emveretarcon
		Zeny -= .@sell;
		mes "[Tadde]";
		mes "这就是你要的东西。非常感谢！";
		close;
	case 3:
		mes "[Tadde]";
		mes "对武器等级和安全精炼有什么疑问吗？";
		while(1) {
			next;
			switch(select("武器等级", "安全精炼。", "结束提问。")) {
			case 1:
				mes "[Tadde]";
				mes "武器有等级，而铠甲没有。武器^3E86C3精炼等级^000000越高，武器等级就越高。";
				next;
				mes "[Tadde]";
				mes "这意味着^A20B09精炼等级越高的武器越难获得。^000000";
				next;
				mes "[Tadde]";
				mes "从前来精炼的顾客来看，精炼 1、2 级武器的人比精炼 3、4 级武器的人更多。";
				continue;
			case 2:
				mes "[Tadde]";
				mes "安全精炼取决于铠甲或武器的等级，所以每个等级基本都有^3E86C3不同的安全升级等级。^000000";
				while(1) {
					next;
					switch(select("1 级武器", "2 级武器", "3 级武器", "4 级武器", "铠甲", "问题结束")) {
					case 1:
						mes "[Tadde]";
						mes "1 级武器精炼到^A20B09+7^000000 以内是安全的。武器等级越低，可达到的精炼数值越高。";
						next;
						mes "[Tadde]";
						mes "当然，它的效果比 1 级武器更强。";
						continue;
					case 2:
						mes "[Tadde]";
						mes "2 级武器精炼到^A20B09+6^000000 以内是安全的，虽然精炼数值低于 1 级武器。";
						next;
						mes "[Tadde]";
						mes "当然，它的效果比 1 级武器更强。";
						continue;
					case 3:
						mes "[Tadde]";
						mes "3 级武器精炼到^A20B09+5^000000 以内是安全的。简单来说，武器每提升一个等级，安全精炼等级就降低 1。";
						next;
						mes "[Tadde]";
						mes "武器等级越高，每次 +1 精炼带来的提升效果也越高。";
						continue;
					case 4:
						mes "[Tadde]";
						mes "4 级武器精炼到^A20B09+4^000000 以内是安全的。4 级武器非常稀有，所以带它们来这里的顾客不多。";
						next;
						mes "[Tadde]";
						mes "因为它是最奢华的武器之一，所以精炼效果也是最强的。";
						continue;
					case 5:
						mes "[Tadde]";
						mes "铠甲和 4 级武器一样，精炼到^A20B09+4^000000 以内是安全的。";
						next;
						mes "[Tadde]";
						mes "由于大多数精炼师习惯制作武器，所以很难安全地升级铠甲。";
						continue;
					case 6:
						mes "[Tadde]";
						mes "关于安全精炼的说明，你似乎已经听够了。";
						break;
					}
					break;
				}
				continue;
			case 3:
				break;
			}
			break;
		}
		mes "[Tadde]";
		mes "我能向你解释的就是这些。";
		next;
		mes "[Tadde]";
		mes "关于安全精炼费用和效果的说明，会由洛卡斯先生负责。";
		close;
	}
}

izlude_a,145,122,7	duplicate(Tadde#iz)	Tadde#iz_a	4_M_04
izlude_b,145,122,7	duplicate(Tadde#iz)	Tadde#iz_b	4_M_04
izlude_c,145,122,7	duplicate(Tadde#iz)	Tadde#iz_c	4_M_04

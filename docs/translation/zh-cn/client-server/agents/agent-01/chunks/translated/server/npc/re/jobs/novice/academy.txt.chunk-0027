// - Locas
// -----------------------------------------------------------------------------
izlude,155,132,3	script	Locas#iz	4_M_02,{
	if (!checkweight(1301,1)) {
		mes "- 由于你的物品栏中有太多物品，无法继续任务。-";
		close;
	}
	if (isbegin_quest(5155) == 1) {
		mes "[Locas]";
		mes "你就是老板派来的人。他让我做什么？";
		next;
		select("你有很多抱怨，对吧？");
		mes "[Locas]";
		mes "是的。当然，老板总是用愚蠢的绩效评分威胁我。";
		next;
		mes "[Locas]";
		mes "他已经不是从前那个人了。";
		next;
		mes "[Locas]";
		mes "他以为只要有人离开，替代者马上就会出现。";
		next;
		mes "[Locas]";
		mes "总之，员工就该做老板要求的事……问你的问题吧。";
		next;
		while(1) {
			switch(select("精炼价格", "精炼效果", "结束交谈。")) {
			case 1:
				mes "[Locas]";
				mes "也许老板认为最重要的事情就是这个……";
				next;
				mes "[Locas]";
				mes "顾名思义，精炼价格就是^3E86C3进行一次精炼所需的费用^000000。";
				next;
				mes "[Locas]";
				mes "不过，根据 Zeny 和武器等级的不同，所需的^3E86C3基本材料也不同。^000000";
				next;
				while(1) {
					switch(select("1 级武器", "2 级武器", "3 级武器", "4 级武器", "铠甲", "问题结束")) {
					case 1:
						mes "[Locas]";
						mes "精炼 1 级武器需要^3E86C3魔幻之石和 1000 Zeny^000000。";
						next;
						mes "[Locas]";
						mes "魔幻之石是最常见的金属，既可以从怪物身上获得，也可以在塔德处以 200 Zeny 购买。";
						next;
						continue;
					case 2:
						mes "[Locas]";
						mes "精炼 2 级武器需要^3E86C3神之金属和 2,000 Zeny^000000。";
						next;
						mes "[Locas]";
						mes "神之金属也是相对常见的金属。你可以从怪物身上获得，也可以在塔德处以 1000 Zeny 购买。";
						next;
						continue;
					case 3:
						mes "[Locas]";
						mes "精炼 3 级武器需要^3E86C3奥利德奥康和 10,000 Zeny^000000。";
						next;
						mes "[Locas]";
						mes "奥利德奥康是非常稀有的金属，所以我不出售……不过，";
						next;
						mes "[Locas]";
						mes "如果你有 5 个可从某些怪物身上获得的粗糙奥利德奥康，就可以把它们精炼成 1 个奥利德奥康。";
						next;
						continue;
					case 4:
						mes "[Locas]";
						mes "精炼 4 级武器需要^3E86C3奥利德奥康和 20,000 Zeny^000000。";
						next;
						mes "[Locas]";
						mes "铝是和奥利德奥康一样稀有的金属。如果你带来 5 个可从某些怪物身上获得的粗糙铝，我会把它们精炼成 1 个铝。";
						next;
						continue;
					case 5:
						mes "[Locas]";
						mes "精炼铠甲需要^3E86C3铝和 20,000 Zeny^000000。";
						next;
						mes "[Locas]";
						mes "铝是和奥利德奥康一样稀有的金属。如果你带来 5 个可从某些怪物身上获得的粗糙铝，我会把它们精炼成 1 个铝。";
						next;
						continue;
					case 6:
						mes "[Locas]";
						mes "关于精炼价格的说明，你似乎已经听够了。";
						next;
						break;
					}
					break;
				}
				continue;
			case 2:
				mes "[Locas]";
		mes "我想你现在已经充分了解精炼了。";
				next;
				mes "[Locas]";
		mes "现在我来向你说明^3E86C3精炼的效果^000000。";
				next;
				mes "[Locas]";
		mes "这次我不会逐一解释物品。与其听口头说明，不如你亲自体验。";
				next;
				mes "[Locas]";
		mes "总之，说明如下。从 1 级武器开始，";
				next;
				mes "[Locas]";
		mes "1 级武器每精炼 +1，^A20B09攻击力增加 2^000000。明白了吗？";
				next;
		select("怎么样？？？");
				mes "[Locas]";
		mes "我以为解释得很简单，但看来并不是……";
				next;
				mes "[Locas]";
		mes "所以，如果把攻击力为 17 的小刀精炼 +1，攻击力就会变成 19。就是这样。";
				next;
				mes "[Locas]";
		mes "其实这里不用说太多。你之后亲自体验就知道了。";
				next;
				mes "[Locas]";
		mes "2 级武器每提升一个精炼等级，攻击力增加^A20B093^000000。";
				next;
				mes "[Locas]";
		mes "3 级武器每提升一个精炼等级，攻击力增加^A20B095^000000。";
				next;
				mes "[Locas]";
		mes "最后，4 级武器每提升一个精炼等级，攻击力增加^A20B097^000000。";
				next;
				mes "[Locas]";
		mes "啊，我漏了铠甲。铠甲每提升一个精炼等级，防御力增加^A20B091^000000。";
				next;
				mes "[Locas]";
		mes "好了，到目前为止说明的只是安全精炼的效果……";
				next;
				mes "[Locas]";
		mes "无论潜在风险如何，你最好自己了解^A20B09过度精炼的效果^000000。";
				next;
				mes "[Locas]";
		mes "如果把所有细节都告诉你，你大概会开始阅读一部一万页的史诗小说，所以我直接告诉你结局。";
				next;
				mes "[Locas]";
		mes "有一点要明确：如果过于急切，你必须小心装备被摧毁。";
				next;
				continue;
			case 3:
				break;
			}
			break;
		}
		mes "[Locas]";
		mes "看来你没有其他问题了。感谢你听完这么长的故事。";
		next;
		completequest 5155;
		mes "[Locas]";
		mes "你可以把任何话都告诉老板。绩效评分对我们技术人员来说没那么重要。";
		close;
	} else {
		mes "[Locas]";
		mes "如果你带来 5 个粗糙奥利德奥康或粗糙铝，我会立即把它们制成奥利德奥康或铝。";
		next;
	}
	switch(select("精炼奥利德奥康", "精炼铝", "其他问题。")) {
	case 1:
		mes "[Locas]";
	mes "要把 5 个粗糙奥利德奥康精炼成 1 个奥利德奥康吗？";
		next;
		if (select("5 个兑换 1 个", "全部兑换。") == 1) {
			if (countitem(756) > 4) {
				delitem 756,5;// Oridecon_Stone
				getitem 984,1;// Oridecon
				mes "[Locas]";
				mes "已将粗糙奥利德奥康精炼为奥利德奥康。";
				close;
			} else {
				mes "[Locas]";
				mes "你是在开玩笑吗？";
				mes "你应该带来 5 个粗糙奥利德奥康，才能精炼成 1 个奥利德奥康。";
				close;
			}
		} else {
			if (countitem(756) > 4) {
				.@ston_max = countitem(756) / 5;
				.@ston_full = .@ston_max * 5;
				delitem 756,.@ston_full;// Oridecon_Stone
				getitem 984,.@ston_max;// Oridecon
				mes "[Locas]";
				mes "已将 "+.@ston_full+" 个粗糙奥利德奥康精炼为 "+.@ston_max+" 个奥利德奥康。感谢惠顾。";
				close;
			} else {
				mes "[Locas]";
				mes "你是在开玩笑吗？";
				mes "你应该带来 5 个粗糙奥利德奥康，才能精炼成 1 个奥利德奥康。";
				close;
			}
		}
	case 2:
		mes "[Locas]";
	mes "要把 5 个粗糙铝精炼成 1 个铝吗？";
		next;
		if (select("5 个兑换 1 个", "全部兑换。") == 1) {
			if (countitem(757) > 4) {
				delitem 757,5;// Elunium_Stone
				getitem 985,1;// Elunium
				mes "[Locas]";
				mes "已将粗糙铝精炼为铝。";
				close;
			} else {
				mes "[Locas]";
				mes "你是在开玩笑吗？";
				mes "你应该带来 5 个粗糙铝，才能精炼成 1 个铝。";
				close;
			}
		} else {
			if (countitem(757) > 4) {
				.@ston_max = countitem(757) / 5;
				.@ston_full = .@ston_max * 5;
				delitem 757,.@ston_full;// Elunium_Stone
				getitem 985,.@ston_max;// Elunium
				mes "[Locas]";
				mes "已将 "+.@ston_full+" 个粗糙铝精炼为 "+.@ston_max+" 个铝。感谢惠顾。";
				close;
			} else {
				mes "[Locas]";
				mes "你是在开玩笑吗？";
				mes "你应该带来 5 个粗糙铝，才能精炼成 1 个铝。";
				close;
			}
		}
	case 3:
		mes "[Locas]";
		mes "你对精炼还有什么疑问吗？";
		next;
		mes "[Locas]";
		mes "虽然我不能解释太多……你想问什么？";
		next;
		while(1) {
			switch(select("精炼价格", "精炼效果", "结束说明。")) {
			case 1:
				mes "[Locas]";
				mes "顾名思义，精炼价格就是^3E86C3进行一次精炼所需的价格^000000。";
				next;
				mes "[Locas]";
				mes "不过，根据 Zeny 和武器等级的不同，所需的基本材料也不同。";
				next;
				while(1) {
					switch(select("1 级武器", "2 级武器", "3 级武器", "4 级武器", "铠甲", "问题结束")) {
					case 1:
						mes "[Locas]";
						mes "精炼 1 级武器需要^3E86C3魔幻之石和 1000 Zeny^000000。";
						next;
						mes "[Locas]";
						mes "魔幻之石是最常见的金属，既可以从怪物身上获得，也可以在塔德处以 200 Zeny 购买。";
						next;
						continue;
					case 2:
						mes "[Locas]";
						mes "精炼 2 级武器需要^3E86C3神之金属和 20,000 Zeny^000000。";
						next;

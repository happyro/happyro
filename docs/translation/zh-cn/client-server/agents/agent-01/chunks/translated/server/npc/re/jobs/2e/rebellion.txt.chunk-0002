job_gun,120,138,3	script	Ivan Sidorenko#1	4_M_REBELLION,{
	if (Class != Job_Gunslinger) {
		mes "[伊万·西多连科]";
		mes "这里是射击测试区，不能随便进来。";
		close2;
		warp "job_gun",81,29;
		end;
	}
	if (isbegin_quest(12342) < 2) {
		mes "[伊万·西多连科]";
		mes "好像出了差错，你不能留在这里。";
		close2;
		warp "job_gun",81,29;
		end;
	}
	if (isbegin_quest(12343) == 0) {
		mes "[伊万·西多连科]";
		mes "嘿，集中注意力——这里使用实弹，你随时可能中枪。";
		next;
		mes "[伊万·西多连科]";
		mes "我简单说明一下。你要在这个由 5 个区域组成的射击场中奔跑。";
		next;
		mes "[伊万·西多连科]";
		mes "目标是在拥挤的人群中迅速且准确地找出敌人。";
		next;
		mes "[伊万·西多连科]";
		mes "所有目标中只能射击^0000ff标准目标^000000。射错会扣分。";
		next;
		mes "[伊万·西多连科]";
		mes "试试看。^0000ff标准目标^000000不多，所以要睁大眼睛。";
		next;
		mes "[伊万·西多连科]";
		mes "^0000ff你有 3 分钟完成测试。如果在变身效果结束前未完成^000000，测试就会失败。到时沿着道路回来找我。";
		next;
		mes "[伊万·西多连科]";
		mes "^0000ff漏掉一个标准目标，或射错 3 个目标，测试都会失败^000000。开始吧。";
		setquest 12343;// Rebellion Job Change Quest
		setquest 12344;// Rebellion Job Change Quest
		transform 3169,180000;
		close2;
		warp "job_gun",102,146;
		end;
	}
	if (isbegin_quest(12343) == 1) {
		if (checkquest(12343,HUNTING) == 2)
			.@j_r_s = 10;
		if (checkquest(12344,HUNTING) == 2)
			.@j_r_f = 2;
		if (getstatus(SC_MONSTER_TRANSFORM,1) != 3169)
			.@j_r_t = 5;
		.@j_r_c = .@j_r_s - .@j_r_f - .@j_r_t;
		if (.@j_r_c > 9) {
			mes "[伊万·西多连科]";
			mes "干得好。没想到你这么快就通过了。";
			completequest 12343;
			completequest 12344;
			setquest 12345;// Rebellion Job Change Quest
			next;
			mes "[伊万·西多连科]";
			mes "你可以离开到外面等候。我会带其他教官的评估报告来见你。";
			close2;
			warp "job_gun",210,132;
			end;
		}
		if (.@j_r_c == 8) {
			mes "[伊万·西多连科]";
			mes "你的速度够快，但射错的目标太多了。你失败了。";
		}
		else if (.@j_r_c == 5) {
			mes "[伊万·西多连科]";
			mes "你的准确度够高，但花的时间太多。迟钝的叛乱者活不长。";
		}
		else if (.@j_r_c < 5) {
			mes "[伊万·西多连科]";
			mes "你的速度和准确度都不合格。你是怎么活到现在的？";
		}
		else {
			mes "[伊万·西多连科]";
			mes "出了问题，统计数据似乎不对。嗯……偶尔会发生这种事。";
		}
		erasequest 12343;
		erasequest 12344;
		next;
		mes "[伊万·西多连科]";
		mes "再试一次。这次要更加小心。";
		setquest 12343;
		setquest 12344;
		transform 3169,180000;
		close2;
		warp "job_gun",102,146;
		end;
	}
	mes "[伊万·西多连科]";
	mes "你怎么还没离开？";
	next;
	mes "[伊万·西多连科]";
	mes "你可以离开到外面等候。我会带其他教官的评估报告来见你。";
	close2;
	warp "job_gun",210,132;
	end;
}

job_gun,1,4,0	script	#target	CLEAR_NPC,{
	end;
OnStart:
	killmonster "job_gun","#target::OnMyMobDead";
OnInit:
OnMyMobDead:
	hideonnpc "#target";
	while( mobcount("job_gun","#target::OnMyMobDead") < 16 ) {
		.@m_rg = rand(1,5);
		if (.@m_rg == 1)
			monster "job_gun",rand(88,99),rand(143,147),"Standard-issue Target",3169,1,"#target::OnMyMobDead";
		else if (.@m_rg == 2)
			monster "job_gun",rand(92,96),rand(95,122),"Standard-issue Target",3169,1,"#target::OnMyMobDead";
		else if (.@m_rg == 3)
			monster "job_gun",rand(143,159),rand(99,100),"Standard-issue Target",3169,1,"#target::OnMyMobDead";
		else if (.@m_rg == 4)
			monster "job_gun",rand(157,158),rand(137,160),"Standard-issue Target",3169,1,"#target::OnMyMobDead";
		else
			monster "job_gun",rand(119,134),rand(156,160),"Standard-issue Target",3169,1,"#target::OnMyMobDead";
	}
	end;
}


job_gun,220,132,3	script	Ivan Sidorenko#2	10062,{
	if (!checkweight(1201,1)) {
		mes "你携带的物品太多，请减少后再继续。";
		close;
	}
	if ((MaxWeight - Weight) < 1000) {
		mes "背包里的物品太重了。请先减轻负重。";
		close;
	}
	if (isbegin_quest(12345) == 0) {
		mes "[伊万·西多连科]";
		mes "一定是出了差错。你不该留在这里。";
		close2;
		warp "job_gun",81,29;
		end;
	}
	if (Class == Job_Gunslinger) {
		if (BaseLevel < 99 || JobLevel < 70) {
			mes "[伊万·西多连科]";
			mes "嗯？你看起来太弱了？我没什么好说的。";
			close;
		}
		if (SkillPoint) {
			mes "[伊万·西多连科]";
			mes "糟糕~你还有技能点。";
			close;
		}
		mes "[伊万·西多连科]";
		mes "库尔贝蒂诺夫、埃尔文和我已经评估了你的叛乱者测试结果。";
		next;
		mes "[伊万·西多连科]";
		mes "还有……";
		next;
		mes "[伊万·西多连科]";
		mes "你的态度和测试表现都符合我们的全部要求。";
		next;
		mes "[伊万·西多连科]";
		mes "没错，你现在是叛乱者的一员了。准备好大吃一惊吧。";
		next;
		mes "[伊万·西多连科]";
		mes "埃尔文希望你收下这个。好好保管，这是他为你制作的。";
		jobchange Job_Rebellion;
		completequest 12345;
		getitem 13119,1;// Freedom_Flame
		next;
		mes "[伊万·西多连科]";
		mes "回头见。";
		close2;
		warp "job_gun",81,29;
		end;
	}
	if (Class == Job_Rebellion) {
		mes "[伊万·西多连科]";
		mes "生活应该有趣，而不是无聊。";
		next;
		mes "[伊万·西多连科]";
		mes "成为叛乱者后，你的生活应该更精彩。所以去创造伟大的旅程，让我们为你骄傲吧！";
		close2;
		warp "job_gun",81,29;
		end;
	}
	mes "[伊万·西多连科]";
	mes "你有话要对我说，对吧？";
	close;
}


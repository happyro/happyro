ra_fild12,50,219,1	script	Map Examiner Chakari#chakari	4_F_JOB_ASSASSIN,{
	.@npc_name$ = "[" + strnpcinfo(1) + "]";
	.@item_name$ = getitemname(1000374);

	if (BaseLevel < 80) {
		mes .@npc_name$;
		mes "朱诺怪物研究协会正在进行讨伐任务。不过你看起来还是有点弱，无法执行这些任务。";
		close;
	}
	switch( checkquest(3476,PLAYTIME) ) {
	case -1:
		break;
	case 0:
	case 1:
		mes .@npc_name$;
		mes "今天这样就可以了！！";
		next;
		mes .@npc_name$;
		mes "如果还想继续讨伐，请明天再来！！";
		next;
		if (select( "交出 " + .@item_name$ + "。", "不交。" ) == 2)
			end;
		if (countitem(1000374) < 3) {
			mes "- 需要 3 个" + .@item_name$ + "。-";
			close;
		}
		delitem 1000374,3;	// Brilliant_Soda
		erasequest 3476;
		mes .@npc_name$;
		mes "你要把它给我吗~？我会好好喝掉的！！";
		next;
		mes .@npc_name$;
		mes "咕噜~咕噜~~~！！！！";
		next;
		specialeffect EF_FLASHER;
		mes .@npc_name$;
		mes "呃……？这是什么微妙的味道……";
		next;
		mes .@npc_name$;
		mes "呃……我现在有点迷糊，过一会儿再来和我谈谈好吗？";
		close;
	case 2:
		erasequest 3476;
		break;
	}
	switch( checkquest(3475,HUNTING) ) {
	case -1:
		mes .@npc_name$;
		mes "你好！我是朱诺怪物研究协会派来的地图调查员查卡莉娜~！";
		next;
		switch( select( "接取讨伐任务。", "传送到附近城市。", "询问讨伐任务。", "下次再来。" ) ) {
		case 1:
			mes .@npc_name$;
			mes "你要接取委托吗？！";
			next;
			mes .@npc_name$;
			mes "你只需要在我所在的区域击杀 80 只怪物！";
			next;
			setquest 3475;
			mes .@npc_name$;
			mes "我相信你能很快完成！！";
			close;
		case 2:
			mes .@npc_name$;
			mes "拉赫离这里最近！！";
			next;
			mes .@npc_name$;
			mes "只要给我一个" + .@item_name$ + "，我马上就送你过去！";
			next;
			if (select( "移动", "不移动" ) == 2) {
				mes .@npc_name$;
				mes "好的，需要传送时请告诉我！！";
				close;
			}
			if (countitem(1000374) < 1) {
				mes .@npc_name$;
				mes "嗯？你没有" + .@item_name$ + "！！";
				next;
				mes .@npc_name$;
				mes "传送需要 1 个" + .@item_name$ + "！";
				close;
			}
			mes .@npc_name$;
			mes "好的！那就准备出发吧~！！";
			close2;
			delitem 1000374,1;	// Brilliant_Soda
			warp "rachel",130,30;
			end;
		case 3:
			mes .@npc_name$;
			mes "你听说过怪物群落扩张现象吗？";
			next;
			mes .@npc_name$;
			mes "本来应该持续进行讨伐，但因为短暂中断，我觉得情况已经到了危险边缘。";
			next;
			mes .@npc_name$;
			mes "所以朱诺怪物研究协会派出了几名地图调查员，我就是因此来到这里的。";
			close;
		case 4:
			mes .@npc_name$;
			mes "下次再见！！";
			close;
		}
		end;
	case 0:
	case 1:
		mes .@npc_name$;
		mes "你只需要在这个区域讨伐任意 80 只怪物。";
		next;
		mes .@npc_name$;
		mes "讨伐完成后回来，我会给你丰厚的奖励~！！";
		close;
	case 2:
		getexp 155040,146520;
		erasequest 3475;
		setquest 3476;
		mes .@npc_name$;
		mes "你果然很快就完成了！！";
		next;
		mes .@npc_name$;
		mes "只要有你这样的冒险者，我想讨伐就不会有问题……";
		next;
		mes .@npc_name$;
		mes "希望你明天也能来帮我……！";
		close;
	}
	end;

OnInit:
	setunittitle getnpcid(0), "<Juno Monster Society>";

	// note: ! displayed when playtime ongoing
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "BaseLevel >= 80 && checkquest(3475,HUNTING) == -1" );
	questinfo( QTYPE_QUEST2, QMARK_YELLOW, "checkquest(3475,HUNTING) == 2" );
	end;
}


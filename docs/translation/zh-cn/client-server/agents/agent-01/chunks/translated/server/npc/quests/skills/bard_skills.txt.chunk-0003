// Bartender
//============================================================ 
morocc_in,166,76,7	script	Bartender#bard_qskill	46,{
	if (checkweight(1201,1) == 0) {
		mes "^3355FF站住！";
		mes "你携带的物品太多，背包没有足够空间领取奖励。请腾出一些空间后再回来接受挑战。";
		close;
	}
	mes "[酒保]";
	mes "那么，你想点些什么？";
	mes "请告诉我吧。";
	next;
	switch(select("热带索格拉特:海滩上的朱红:不用了，谢谢。")) {
	case 1:
		if (MaxWeight - Weight < 2000) {
			mes "[酒保]";
			mes "你确定还能携带更多东西吗？";
			mes "看起来你的负重已经很高了。";
			mes "先休息一下，";
			mes "把一些物品存进卡普拉仓库，";
			mes "可以吗？";
			mes "这样就能腾出空间了。";
			close;
		}
		if (Zeny < 1000) {
			mes "[酒保]";
			mes "你确定现在买得起吗？";
			mes "这杯饮料要 1,000 Zeny，";
			mes "先检查一下手头的钱。";
			mes "没有的话就先回去，";
			mes "等攒够钱再来吧。";
			mes "到时候我再为你准备。";
			close;
		}
		mes "[酒保]";
		mes "给你，";
		mes "一杯热带索格拉特。";
		mes "味道甜美温和，";
		mes "但不小心的话，";
		mes "很快就会醉倒。";
		mes "慢慢享用吧。";
		set Zeny, Zeny-1000;
		getitem 12112,1; //Tropical_Sograt
		close;

	case 2:
		if (MaxWeight - Weight < 2000) {
			mes "[酒保]";
			mes "你确定还能携带更多东西吗？";
			mes "看起来你的负重已经很高了。";
			mes "先休息一下，";
			mes "把一些物品存进卡普拉仓库，";
			mes "可以吗？";
			mes "这样就能腾出空间了。";
			close;
		}
		if (Zeny < 1000) {
			mes "[酒保]";
			mes "你确定现在买得起吗？";
			mes "这杯饮料要 1,000 Zeny，";
			mes "先检查一下手头的钱。";
			mes "没有的话就先回去，";
			mes "等攒够钱再来吧。";
			mes "到时候我再为你准备。";
			close;
		}
		mes "[酒保]";
		mes "给你。";
		mes "好好享用饮料，";
		mes "但别喝得太疯狂。";
		mes "注意保持清醒。";
		set Zeny, Zeny-1000;
		getitem 12113,1; //Vermilion_The_Beach
		close;

	case 3:
		mes "[酒保]";
		mes "好吧。";
		mes "那就下次见。";
		close;
	}
}

// Function
//============================================================ 
function	script	F_BardSkillYhelle	{
	if (checkweight(1201,1) == 0 || MaxWeight - Weight < 2000) {
		mes "^3355FF站住！";
		mes "你携带的物品太多，背包没有足够空间领取奖励。请腾出一些空间后再回来接受挑战。";
		close;
	}
	emotion ET_HUK, playerattached();
	emotion ET_HUK;
	mes "[亨·耶尔]";
	mes "咯咯——？";
	mes "咯咯咯！";
	next;
	if (rand(1,3) == 2) {
		disablenpc "Yhelle#bard_chick"+getarg(0);
		donpcevent "Yhelle#bard_chick"+getarg(1)+"::OnEnable";
		mes "^3355FF察觉到你的气息后，";
		mes "母鸡迅速逃走了。^000000";
		mes "它跑得真快。";
		if (qskill_bard > 1 && qskill_bard < 7) {
			mes "^3355FF你在母鸡耶勒栖息的地方";
			mes "找到了^3333331个蛋^3355FF。^000000";
			mes "把它收起来吧。";
			set qskill_bard,qskill_bard+1;
			getitem 574,1; //Egg
		}
	}
	else {
		disablenpc "Yhelle#bard_chick"+getarg(0);
		donpcevent "Yhelle#bard_chick"+getarg(1)+"::OnEnable";
		mes "^3355FF察觉到你的气息后，";
		mes "母鸡迅速逃走了。^000000";
		mes "它跑得真快。";
	}
	return;
}

	mes "^3355FF察觉到你的气息后，";
	mes "母鸡迅速逃走了。^000000";
	mes "它跑得真快。";
	close;

OnEnable:
	enablenpc "Yhelle#bard_chick4";
	end;

OnDisable:
	disablenpc "Yhelle#bard_chick4";
	end;

OnTouch:
	callfunc "F_BardSkillYhelle",4,5; close;
}


// Drunken Men
//============================================================ 
morocc_in,178,73,3	script	Customer#bard_skill01	54,{
	mes "[微醺的男人]";
	mes "你觉得全世界最好的";
	mes "饮料是什么？我想是";
	mes "那个特里——特里斯坦？";
	mes "到底叫什么来着？";
	mes "我一时想不起来了。";
	next;
	mes "[醉得更厉害的男人]";
	mes "哦！十三年陈的特里斯坦？";
	mes "那当然是好酒，";
	mes "但不逢特殊场合就喝，";
	mes "实在太贵了。^333333*嗝*^000000";
	mes "我个人很喜欢维……呃，维……";
	mes "那个名字是什么来着？";
	next;
	mes "[微醺的男人]";
	mes "海滩上的朱红？";
	mes "对，那真的很棒，";
	mes "喝一杯就会醉倒！没错……";
	mes "热……热带！大家也说";
	mes "那个很好喝。等等，什么？";
	mes "我刚才说到哪儿了？";
	next;
	mes "[微醺的男人]";
	mes "喂——！^333333*嗝！*^000000";
	mes "你在干什么？！";
	mes "把手放好！";
	mes "你看我像女人吗？";
	mes "别对我动手动脚的！";
	next;
	mes "[醉得更厉害的男人]";
	mes "你在说什么？什——什么？！";
	mes "我的手臂为什么缠在";
	mes "你身上？对、对不起，我只是";
	mes "想从那边走过去——";
	mes "我不是想抱你的！";
	mes "真的不是！";
	next;
	mes "[微醺的男人]";
	mes "撞到我我可以理解，";
	mes "但整个抱上来是怎么回事？";
	mes "得了吧！";
	mes "你明明就是故意的！";
	mes "什——什么？我的手！它……";
	mes "它怎么自己动起来了？！";
	next;
	mes "[醉得更厉害的男人]";
	mes "啊！你、你在干什么！";
	mes "快、快停下！";
	mes "别摸我的屁股！";
	next;
	mes "^3355FF房间里的吟游诗人";
	mes "饶有兴致地看着两个醉汉，";
	mes "忍不住对他们的醉态窃笑。";
	mes "记住：喝太多可不是好事！^000000";
	mes "切勿贪杯。";
	close;
}


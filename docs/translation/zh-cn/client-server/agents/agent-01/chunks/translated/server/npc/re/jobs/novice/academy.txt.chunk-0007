			close2;
			emotion ET_OHNO;
			end;
		}
		mes "[Mainz]";
		mes "是的……你做了正确的选择。";
		mes "请记住，我本来真的很想吃，但看你累成这样，就先给你了！";
		emotion ET_BEST;
		next;
		mes "- 你打开饭盒，里面放着某种食物 -";
		next;
		mes "[Mainz]";
		mes "哇哈哈哈！别犹豫，拿去吧！";
		mes "它会帮你消除疲劳！";
		mes "吃吧~~ 吃吧~~";
		next;
		mes "- 由于你又累又饿，只好收下饭盒 -";
		next;
		mes ".........";
		next;
		sc_start SC_POISON, 60000, 0;
		mes "- 你吃下食物，突然感到胃部剧痛，视线也变得模糊 -";
		next;
		mes "[Mainz]";
		mes "哦……你怎么了？";
		mes "你的脸色不太好！";
		emotion ET_QUESTION;
		next;
		mes "[Mainz]";
		mes "天啊……";
		mes "我想你中毒了。";
		next;
		mes "[Mainz]";
		mes "我给你解毒剂。吃下它也许就会好起来。";
		next;
		mes "- 你不情愿地服下了解毒剂 -";
		sc_end SC_POISON;
		percentheal 100,0;
		next;
		mes "[Mainz]";
		mes "你到底是怎么中毒的？";
		next;
		mes "[Mainz]";
		mes "顺便说一句，我听说皇家克里图拉学院附近有幽灵游荡。";
		next;
		mes "[Mainz]";
		mes "我想一定是幽灵给你下了毒。";
		next;
		mes "- 你对迈因兹翻了个白眼 -";
		mes "- 迈因兹转过头，假装没注意到 -";
		emotion ET_STARE;
		next;
		mes "[Mainz]";
		mes "咳咳！总之，我很抱歉。";
		mes "请理解我没有恶意。";
		next;
		mes "[Mainz]";
		mes "这些全都是为了你……";
		mes "想知道我的意思吗？";
		next;
		mes "[Mainz]";
		mes "米德加尔特大陆上有各种魔物，其中一些会让你中毒或陷入异常状态。";
		next;
		mes "[Mainz]";
		mes "一般人不小心中毒后都会不好意思承认。我只是故意让你体验一次，以防你在外面的世界遇到这种情况。";
		next;
		mes "[Mainz]";
		mes "请理解，我不是想把妻子的饭盒当礼物送给你。这只是克里图拉学院的另一堂课。";
		emotion ET_OTL;
		next;
		mes "[Mainz]";
		mes "作为道歉，我想告诉你几种可能在米德加尔特大陆遇到的异常状态。";
		next;
		mes "[Mainz]";
		mes "不要拒绝！做好学习准备后再来找我。";
		setquest 15000;
		close2;
		emotion ET_SORRY;
		end;
	} else {
		mes "[Mainz]";
		mes "你是来了解异常状态的吗？有什么让你感到不安？";
		next;
		while(1) {
			switch(select("<^FF0000中毒^000000>", "<^FF0000眩晕^000000>", "<^FF0000睡眠^000000>", "<^FF0000沉默 ^000000>", "我没有问题。")) {
			case 1:
				mes "[Mainz]";
	mes "我来告诉你<^FF0000中毒^000000。";
				next;
				mes "[Mainz]";
	mes "正如你刚才经历的，中毒时身体会变紫，每秒损失少量 HP。";
				next;
				mes "[Mainz]";
	mes "HP 不会永远减少，所以不会因中毒直接死亡。";
				next;
				mes "[Mainz]";
	mes "亲自体验才会相信！我会让你进入中毒状态。";
				next;
				mes "[Mainz]";
	mes "看看中毒状态会对你造成什么影响。";
				next;
				sc_start SC_POISON, 30000, 0;
	mes "你现在是——<^FF0000中毒^000000。";
				next;
				mes "[Mainz]";
				mes "......";
				next;
				sc_end SC_POISON;
				mes "[Mainz]";
	mes "看清中毒状态了吗？一段时间后可能会自然解毒，但受到攻击时，指望自然解毒很危险。";
				next;
				mes "[Mainz]";
	mes "可以使用<^0022FF绿色药草^000000>、<^0022FF绿色药水^000000>、<^0022FF万能药^000000>和<^0022FF蜂王浆^000000>等解毒物品。";
				next;
				mes "[Mainz]";
	mes "还有什么让你感到不安？";
				next;
				break;
			case 2:
				mes "[Mainz]";
	mes "我来告诉你<^FF0000眩晕^000000。";
				next;
				mes "[Mainz]";
	mes "眩晕时，星星会在头顶旋转，你基本无法移动，处于‘毫无防备’状态。";
				next;
				mes "[Mainz]";
	mes "由于毫无防备，你不能移动、使用技能或物品。";
	mes "所以无法自行恢复。";
				next;
				mes "[Mainz]";
	mes "例外是，如果你是修罗，可以使用<^0022FF温柔之触-治愈^000000>技能恢复。";
				next;
				mes "[Mainz]";
	mes "也可以使用牧师的<^0022FF复原^000000>或大主教的<^0022FF赞歌之光^000000>等技能恢复。";
				next;
				mes "[Mainz]";
	mes "让我展示眩晕状态的效果！";
				next;
				sc_start SC_STUN, 30000, 0;
	mes "<^FF0000 眩晕 ^000000>。";
				next;
				mes "[Mainz]";
				mes "......";
				next;
				sc_end SC_STUN;
				mes "[Mainz]";
	mes "感觉如何？";
	mes "因为无法移动，是不是感到很压抑？";
				next;
				mes "[Mainz]";
	mes "想象你处于那种状态，而魔物正向你冲来……";
	mes "相信我，这种事真的会发生。";
				emotion ET_KEK;
				next;
				mes "[Mainz]";
  mes "还有什么让你感到不安？";
				next;
				break;
			case 3:
				mes "[Mainz]";
	mes "我来教你<^FF0000睡眠^000000。";
				next;
				mes "[Mainz]";
	mes "处于睡眠状态时，你会睡着，头顶还会出现 <Zzz>。";
				next;
				mes "[Mainz]";
	mes "和眩晕状态一样，你会毫无防备，但不同的是可以从敌人的攻击中恢复。";
				next;
				mes "[Mainz]";
	mes "但睡眠状态会提高被敌人发动‘暴击’的概率，让你处于危险之中并受到严重伤害。";
				next;
				mes "[Mainz]";
	mes "请注意，你无法自行恢复，只能使用牧师的<^0022FF复原^000000>技能。";
				next;
				mes "[Mainz]";
	mes "让我展示睡眠状态的效果。";
				next;
				sc_start SC_SLEEP, 30000, 0;
	mes "<^FF0000 睡眠 ^000000>。";
				next;
				mes "[Mainz]";
				mes "......";
				next;
				sc_end SC_SLEEP;
				mes "[Mainz]";
	mes "感觉如何？想象在危险敌人面前睡着，并不好玩吧？";
				next;
				mes "[Mainz]";
	mes "睡眠适合休息，但在战斗中可不是什么好事。";
				emotion ET_SPARK;
				next;
				mes "[Mainz]";
		mes "还有什么让你感到不安？";
				next;
				break;
			case 4:
				mes "[Mainz]";
	mes "我来教你<^FF0000沉默^000000。";
				next;
				mes "[Mainz]";
	mes "处于沉默状态时，你不能使用魔法技能，头顶会出现 <...>。";
				next;
				mes "[Mainz]";
	mes "不过并非完全不能攻击。沉默时仍然可以进行普通攻击。";
				next;
				mes "[Mainz]";
	mes "沉默状态下，你只能进行物理攻击或使用药水恢复。";
				next;
				mes "[Mainz]";
				mes "可以使用<^0022FF绿色药草^000000>、<^0022FF绿色药水^000000>、<^0022FF万能药^000000>和<^0022FF蜂王浆^000000>等物品恢复。";
				next;
				mes "[Mainz]";
	mes "让我展示沉默状态的效果。";
				next;
				sc_start SC_SILENCE, 30000, 0;
	mes "<^FF0000沉默^000000>";
				next;
				mes "[Mainz]";
				mes "......";
				next;
				sc_end SC_SILENCE;
				mes "[Mainz]";
	mes "不能使用技能很令人沮丧，对吧？";
				next;
				mes "[Mainz]";
				mes "尤其是依赖技能而非物理攻击的高阶职业，或在战斗中陷入睡眠状态时，会受到严重伤害。";
				next;
				mes "[Mainz]";
	mes "还有其他问题吗？";
				next;
				break;
			case 5:
				mes "[Mainz]";
	mes "如果没有其他问题，可以替我保管饭盒吗？";
	mes "不愿意吗？";
				next;
				mes "[Mainz]";
	mes "唉……";
	mes "我该拿这个饭盒怎么办？";
				close2;
				emotion ET_OHNO;
				end;
			}
		}
	}

OnTouch_:
	emotion ET_OTL;
	end;
}

iz_ac01_a,134,47,5	duplicate(Trainer Mainz#ac)	Trainer Mainz#ac_a	4_M_KY_KNT,4,4
iz_ac01_b,134,47,5	duplicate(Trainer Mainz#ac)	Trainer Mainz#ac_b	4_M_KY_KNT,4,4
iz_ac01_c,134,47,5	duplicate(Trainer Mainz#ac)	Trainer Mainz#ac_c	4_M_KY_KNT,4,4
iz_ac01_d,134,47,5	duplicate(Trainer Mainz#ac)	Trainer Mainz#ac_d	4_M_KY_KNT,4,4

// - Odd Novice
// - Introduces the player to the concept of Super Novices.
// -----------------------------------------------------------------------------
iz_ac01,36,52,3	script	Odd Novice#ac	4_M_SIT_NOVICE,{
	mes "[Odd Novice]";
	mes "啊哈~~ 在药房摸鱼。";
	mes "逃课又酷又棒。";
	if (Class == Job_Novice) {
		mes "虽然是 XXXXX，但你是谁？";
		mes "你也是同一种 XXXXX 吗？";
		next;
		.@choice = rand(1,10);
		if (.@choice < 3) {
			mes "[Odd Novice]";
			mes "嗯……你看起来很有天赋。";
			mes "我心情不错，要不要给你展示点新花样？";
			next;
			.@message = select("新花样？", "你是谁……？", "你为什么在这里？", "结束对话");
		} else {
			.@message = select("你是谁……？", "你为什么在这里？", "结束对话") +1;
		}
		switch(.@message)
		{
		case 1:
			mes "[Odd Novice]";
			mes "我看起来也许很普通，但我有新奇的天赋。";
			mes "看到它后受到惊吓可别怪我。";
			next;
			mes "[Odd Novice]";
			mes "好，我该从哪里开始？";
			mes "首先，重击！";
			specialeffect2 EF_BASH;
			next;
			mes "[Odd Novice]";
			mes "嘿嘿……吓到了？";
			mes "我只是装装样子……";
			mes "不是真的拳头。";
			next;
			mes "[Odd Novice]";
			mes "看来你被吓到了！";
			specialeffect2 EF_BLESSING;
			next;
			mes "[Odd Novice]";
			mes "保持冷静，";
			mes "喝下药水，";
			mes "但这还不是全部。";
			specialeffect2 EF_STEAL;
			next;
			mes "[Odd Novice]";
			mes "我偷走了你的一根头发。";
			mes "我不相信巫毒术。";
			mes "把它当作你的幸运吧。";
			next;
			mes "[Odd Novice]";
			mes "最后一个，至少可以说是一团火焰！";
			mes "怎么样？很新奇吧。";
			mes "别再浪费时间了，";
			mes "学到的技能都应该用起来。";
			specialeffect EF_SIGHT, AREA, "Odd Novice#nk1";
			next;
			mes "[Odd Novice]";
			mes "呃，我的 SP 全没了……";
			mes "都浪费掉了……我累了。";
			mes "我要回去休息。";
			mes "再见，拜拜~~ 别再烦我了。";
			close;
		case 2:
			if (.@choice == 10) {
				mes "[Odd Novice]";
				mes "什么？你来打扰我。";
				mes "离我远点，孩子，你烦到我了。";
				close;
			} else {
				switch(rand(1,3)) {
					case 1:
						mes "[Odd Novice]";
						mes "我？我是初心者。";
						mes "什么？很奇怪？你第一次见到我吗？";
						next;
						mes "[Odd Novice]";
						mes "如果我看起来很寒酸，你应该去照照镜子。";
						mes "朋友，你和我穿的是同样的东西。";
						close;
					case 2:
						mes "[Odd Novice]";
						mes "我就是所谓的初心者中的初心者。";
						mes "什么都会一点，却没有一项精通。";
						next;
						mes "[Odd Novice]";
						mes "如果你不从学校毕业，只会闲逛并模仿别人的生活方式，最后就会变成我这样。";
						next;
						mes "[Odd Novice]";
						mes "天才和笨蛋之间只有一线之隔。";
						mes "多才多艺却没有专长的人，就是超级初心者。";
						mes "大家都是这么称呼我们的。";
						close;
					case 3:
						mes "[Odd Novice]";
						mes "玫瑰换个名字……";
						mes "我就是我。超级初心者！";
						close;
				}
			}
		case 3:
			if (.@choice == 10) {
				mes "[Odd Novice]";
					mes "什么？你来打扰我。";
					mes "离我远点，孩子，你烦到我了。";
				close;
			} else {
				if (!callfunc("F_CanChangeJob")) {
					mes "[Odd Novice]";
						mes "你都这样说了，为什么不去转职，非要在这里闲逛？";
						mes "嗯，你难道想变得和我一样？";
					next;
					mes "[Odd Novice]";
						mes "啊哈~ 如果你想要各种不同的技能……";
					next;
					mes "[Odd Novice]";
						mes "如果你像我一样努力，就会成为伟大的超级初心者。";
					close;
				} else {
					switch(rand(1,3)) {
					case 1:
						mes "[Odd Novice]";
						mes "嗯。真是脏嘴！";
						mes "我在你这个年纪时，";
						mes "如果像你一样胡乱说话，就会被拖到后山，然后……";
						next;
						mes "[Odd Novice]";
						mes "好……够了……";
						mes "我现在心情好多了？";
						mes "我说好话的时候，";
						mes "你就安静地走开，好吗？";
						close;
					case 2:
						mes "[Odd Novice]";
						mes "你在学校里闲逛吗？";
						mes "我不需要多说。";
						mes "如果你一直在这里混日子，";
						mes "长大后就会变成我这样。";
						mes "很可怕，对吧？";
						next;
						mes "[Odd Novice]";
						mes "我知道，我知道，在被老师发现，或者更糟糕地被校长发现之前，";
						mes "快走，走~~~~远~~~~点~~~~~吧~";
						close;
					case 3:
						mes "[Odd Novice]";
						mes "嗯，";
						mes "我在做什么？";
						mes "一转眼，我就变成这样了。";
						next;
						mes "[Odd Novice]";
						mes "其实，我曾经有一个伟大的梦想……";
						mes "唉~~ 是因为想做的事情太多了吗？";
						close;
					}
				}
			}
		case 4:
			mes "[Odd Novice]";
			mes "好，好，走你的路吧……";
			mes "我是骄傲而孤独的初心者。";
			mes "我能自得其乐。";
			close;
		}
	}
	close;
}

iz_ac01_a,36,52,3	duplicate(Odd Novice#ac)	Odd Novice#ac_a	4_M_SIT_NOVICE
iz_ac01_b,36,52,3	duplicate(Odd Novice#ac)	Odd Novice#ac_b	4_M_SIT_NOVICE
iz_ac01_c,36,52,3	duplicate(Odd Novice#ac)	Odd Novice#ac_c	4_M_SIT_NOVICE
iz_ac01_d,36,52,3	duplicate(Odd Novice#ac)	Odd Novice#ac_d	4_M_SIT_NOVICE

// - Shop Helper
// - Teaches the player about Shops and Currency.
// -----------------------------------------------------------------------------
izlude,115,181,5	script	Shop Helper#iz	4_F_KHELLISIA,{
	if (!checkweight(1301,3)) {
		mes "- 由于背包已满，任务无法继续。-";
		close;
	}

	if (Class == Job_Novice) {
		if (!isbegin_quest(1237)) {
			mes "[Shop Helper Leonie]";
			mes "基础学习进行得怎么样？";
			mes "你需要了解商店相关信息。";
			next;
				if (select("我自己学得很好！", "好，我听着！") == 1) {
				mes "[Shop Helper Leonie]";
				mes "如果你认真听，我会给你一份纪念品。";
				close;
			}
			mes "[Shop Helper Leonie]";
			mes "明智的选择。";
			mes "米德加尔特有很多商店和各种货币。";
			mes "所以你要认真听，才能正确使用它们。";
			setquest 1237;
			close;
		}
		if (!isbegin_quest(1238)) {
			mes "[Shop Helper Leonie]";
			mes "开始吧。";
		} else if (isbegin_quest(1238) == 1) {
			if (countitem(501) > 0) {
				mes "[Shop Helper Leonie]";
				mes "好，一瓶^0000ff红色药水^000000。";
				mes "以后你可以在原野或地下城中使用它。";
				mes "作为奖励，我给你几片^ff0000苍蝇翅膀^000000。";
				completequest 1238;
				setquest 1239;
				getitem 12323,50;// N_Fly_Wing
				getexp 1300,100;
				close;
			}
			mes "[Shop Helper Leonie]";
			mes "去商店买一瓶^0000ff红色药水^000000带回来。";
			mes "你有那么多钱，对吧？";
			next;
			mes "[Shop Helper Leonie]";
			mes "如果没有，就去附近猎杀魔物，卖掉战利品后应该就够钱了。";
			next;
				if (select("我会去做。", "询问商店。") == 1) {
				mes "[Shop Helper Leonie]";
					mes "进入下一课吧。";
					mes "快点回来。";
				close;
			}
			mes "[Shop Helper Leonie]";
		} else {
			if (!isbegin_quest(1240)) {
				mes "[Shop Helper Leonie]";
					mes "我们来进行下一课。";
					mes "在今后的旅途中，";
					mes "你的背包里会获得许多物品。";
				next;
				mes "[Shop Helper Leonie]";
					mes "其中有些物品不能丢弃或交易，它们是任务物品。它们很重要，但有时也会成为负担。";
				next;
				mes "[Shop Helper Leonie]";
					mes "遇到这种情况时，可以把能卖的物品卖给商店，减少背包负担。";

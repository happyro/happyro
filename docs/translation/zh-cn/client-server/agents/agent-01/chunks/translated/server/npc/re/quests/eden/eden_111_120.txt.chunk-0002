									mes "我不知道你能携带多少掉落物，但希望你尽可能多带。能带来 10 个^FF0000碎片^000000和 20 个^FF0000生锈的螺丝^000000吗？";
									callsub S_Quest,13100,13099;
								}
							}
						}
					}
				}
			}
			else if (para_110lv01 < 5) {
				mes "对你来说，研究怪物的委托似乎太简单了。";
				next;
				mes "[Mingmin]";
				mes "这是伊甸园集团的规定，我也无能为力。";
				next;
				mes "[Mingmin]";
				mes "有人非常希望你完成这项委托。";
			}
			else {
				cutin "min01",0;

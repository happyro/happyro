						next;
						mes "[Mingmin]";
						mes "我以前参加过研究稀有怪物的俱乐部。听说后来变成了公会，我就是在那里遇到他的。";
						next;
						mes "[Mingmin]";
						mes "虽然我看起来更年轻，但我就像他的姐姐。那个俱乐部发生过很多事。不过不该一直说下去，有时间再告诉你。";
					}
					else if (para_110lv01 == 5) {

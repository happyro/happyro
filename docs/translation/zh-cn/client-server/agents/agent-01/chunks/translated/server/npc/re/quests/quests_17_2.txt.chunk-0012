ba_bath,286,298,3	script(CLOAKED)	Unknown Creature#172ba01	4_EP17_MERMAID,{
	if (checkweight(1000103,16) == 0) {	// (custom)
		mes "^008800等等！！";
		mes "你携带的物品太多，无法再领取物品。减轻负重后再试。^000000";
		close;
	}
	if (ep17_2_bath == 10) {
		cloakoffnpcself( "Rookie#172ba05" );
		cloakoffnpcself( "Denny#172ba04" );
		cloakoffnpcself( "Magenta#172ba05" );
		cloakoffnpcself( "Cyan#172ba04" );
		cloakoffnpcself( "Molar#172ba04" );
		cloakoffnpcself( "Canine#172ba04" );
		cloakoffnpcself( "Danae#172ba04" );
		cutin "16loo_01",2;
		mes "[新兵]";
		mes "冒险家，你来得正是时候。";
		mes "看，目标就在我们面前。大家小心。";
		next;
		cutin "",255;
		mes "叮——";
		specialeffect EF_SMOKE;
		specialeffect EF_PEONG;
		next;
		select( "这阵蒸汽一定是……" );
		setnpcdisplay( "Unknown Creature#172ba01", 4_CENERE );
		cloakoffnpcself( "Unknown Creature#172ba01" );
		cloakoffnpcself( "Gonie#172ba01" );
		mes "[丹尼]";
		mes "那不是戈尼吗？还有……两个幸运？";
		npctalk "幸运……？", "Denny#172ba04", bc_self;
		npctalk "谁才是真的？", "Magenta#172ba05", bc_self;
		next;
		cutin "16loo_01",2;
		mes "[新兵]";
		mes "当然是我！你们一路跟谁来的？我们是来抓那个冒牌货的。";
		npctalk "这是幸运。没错。", "Molar#172ba04", bc_self;
		npctalk "当然是我！", "Rookie#172ba05", bc_self;
		next;
		cutin "16loo_03",2;
		mes "[新兵]";
		mes "我不知道你是谁，但你无处可逃，最好别再抵抗。这里被三方包围了。丹尼、品红，检查戈尼。";
		next;
		cutin "16loo_01",0;
		mes "[??????]";
		mes "......";
		npctalk "......", "", bc_self;
		next;
		cutin "",255;
		cloakonnpcself( "Denny#172ba04" );
		cloakonnpcself( "Magenta#172ba05" );
		sleep2 1000;
		cloakoffnpcself( "Denny#172ba05" );
		cloakoffnpcself( "Magenta#172ba06" );
		mes "[丹尼]";
		mes "戈尼一直躲着，结果被卡住了。看起来没有受伤。";
		next;
		cutin "16loo_01",2;
		mes "[新兵]";
		mes "把你所有的药水都拿出来。";
		next;
		cutin "",255;
		mes "[品红]";
		mes "有必要吗？很快就会恢复，我只要在这里洒点水，再拍几下脸。";
		npctalk "我不是告诉过你别再准备间谍小说了吗？", "Cyan#172ba04", bc_self;
		next;
		cloakonnpcself( "Rookie#172ba05" );
		sleep2 1000;
		cloakoffnpcself( "Rookie#172ba06" );
		cutin "16loo_01",2;
		mes "[新兵]";
		mes "戈尼，戈尼？喝下这个。能喝吗？";
		npctalk "幸运，你最好往后站一点。你拿着它靠得太近，我会弄混的。", "Canine#172ba04", bc_self;
		next;
		cutin "",255;
		mes "[品红]";
		mes "幸运，往后站一点。那真的是戈尼吗？不是冒牌货？我们确认一下。";
		next;
		cutin "16loo_01",2;
		mes "[新兵]";
		mes "怎么会不是戈尼？那边明明有一个冒牌的我。";
		next;
		cutin "16go_03.bmp",2;
		mes "[戈尼]";
		mes "......!!";
		next;
		cutin "16loo_01",2;
		mes "[新兵]";
		mes "戈尼？你醒了吗？没事吧？";
		next;
		mes "[新兵]";
		mes "大家找掩护！冒险家你也是！";
		specialeffect EF_SUI_EXPLOSION, AREA, "Gonie#172ba01";
		next;
		cutin "",255;
		select( "是！" );
		cloakonnpcself( "Rookie#172ba06" );
		sleep2 1500;
		cloakoffnpcself( "Rookie#172ba05" );
		mes "[丹尼]";
		mes "不，就算你叫我们找掩护……";
		next;
		mes "叮——";
		specialeffect EF_SMOKE;
		specialeffect EF_PEONG;
		next;
		setnpcdisplay( "Unknown Creature#172ba01", 4_M_GONY );
		cloakoffnpcself( "Unknown Creature#172ba01" );
		cutin "16loo_01",2;
		mes "[新兵]";
		mes "啊！又来一阵蒸汽！！！";
		next;
		cutin "",255;
		mes "[丹尼]";
		mes "现在，戈尼……有两个戈尼。";
		npctalk "嘿，幸运。戈尼连暗号都不知道。我们该怎么办？", "Denny#172ba05", bc_self;
		npctalk "左边那个看起来不像戈尼吗？他好像很痛苦？", "Magenta#172ba06", bc_self;
		npctalk "右边那个显然才是戈尼。看看他的眼睛。", "Canine#172ba04", bc_self;
		next;
		cutin "16loo_02",2;
		mes "[新兵]";
		mes "大家安静。我们有简单可靠的方法辨认真正的戈尼。";
		mes "戈尼？哪个才是真的戈尼？";
		next;
		cutin "16go_03",2;
		mes "[戈尼]";
		mes "......";
		npctalk "......", "Gonie#172ba01", bc_self;
		next;
		cutin "16go_03",0;
		mes "[戈尼]";
		mes "当然是我。";
		npctalk "当然是我。", "", bc_self;
		next;
		cutin "",255;
		mes "[青色]";
		mes "嗯……真的。太简单了，连刚出生的孩子都能回答。";
		npctalk "丹尼、品红，把冒牌货牢牢抓住。", "Rookie#172ba05", bc_self;
		next;
		cutin "16go_03",0;
		mes "[戈尼]";
		mes "你们怎么了？放开我！那个才是冒牌货！";
		npctalk "你们怎么了？放开我！那个才是冒牌货！", "", bc_self;
		next;
		cutin "16loo_02",2;
		mes "[新兵]";
		mes "冒险家，你知道哪个是真的吗？";
		next;
		cutin "",255;
		if (select( "沉默的那个。", "自称是真的那个。" ) == 2) {
			mes "[青色]";
			mes "我们对你很失望！和我们相处这么久，你居然还不知道。";
		}
		else {
			mes "[青色]";
			mes "你的眼光不错，冒险家。";
		}
		next;
		mes "[青色]";
		mes "戈尼，过来这里。";
		next;
		cutin "16go_03",2;
		mes "[戈尼]";
		mes "......";
		npctalk "......", "Gonie#172ba01", bc_self;
		next;
		cutin "",255;
		cloakonnpcself( "Gonie#172ba01" );
		sleep2 1500;
		cloakoffnpcself( "Gonie#172ba02" );
		mes "[品红]";
		mes "哈哈哈！我们的戈尼真是个沉默寡言的人！！";
		npctalk "说出你的真身！你这个恶棍！！！", "Cyan#172ba04", bc_self;
		npctalk "青色，你更像个恶棍……", "Danae#172ba04", bc_self;
		next;

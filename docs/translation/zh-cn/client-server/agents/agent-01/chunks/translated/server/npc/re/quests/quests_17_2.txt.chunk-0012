ba_bath,203,58,3	script(CLOAKED)	Rookie#172ba04	4_M_ROOKIE,{
	if (checkweight(1201,2) == 0) {	// (custom)
		mes "^008800等等！！";
		mes "你携带的物品太多，无法再领取物品。减轻负重后再试。^000000";
		close;
	}
	if (ep17_2_bath == 5) {
		cloakoffnpcself( "Molar#172ba03" );
		cloakoffnpcself( "Magenta#172ba03" );
		mes "[品红]";
		mes "幸运！你没事！你一个人走开，我还以为发生了什么！";
		next;
		cutin "16loo_01",2;
		mes "[新兵]";
		mes "你也看到我了吗？";
		next;
		cloakoffnpcself( "Canine#172ba03" );
		cloakoffnpcself( "Denny#172ba03" );
		cutin "",255;
		mes "[丹尼]";
		mes "幸运？是你发的信号吗？为什么叫我们来？你不是叫我们去湖边吗？";
		next;
		cloakoffnpcself( "Danae#172ba03" );
		cloakoffnpcself( "Cyan#172ba03" );
		mes "[青色]";
		mes "你怎么比我更快到这里？";
		next;
		cutin "16loo_01",2;
		mes "[新兵]";
		mes "等等，冷静。你们都在外面看到我了吗？";
		next;
		cutin "",255;
		mes "[丹尼]";
		mes "当然！如果幸运不是幸运，那还能是谁？";
		npctalk "我不会骗你的。", "Cyan#172ba03", bc_self;
		next;
		cutin "16loo_03",2;
		mes "[新兵]";
		mes "那它似乎不是他们中的任何一个。";
		mes "听着，我们还不知道这里未知实体的身份。但它不是自动人偶，也不是幽灵。不是怪物，甚至不是超自然生物。";
		npctalk "那它到底是什么？", "Cyan#172ba03", bc_self;
		next;
		cutin "",255;
		mes "[丹尼]";
		mes "你怎么发现的？";
		next;
		cutin "16loo_01",2;
		mes "[新兵]";
		mes "我和每个人都见过一次。你们在外面看到的是我，对吧？我还告诉你们该往哪走。难道没感觉哪里不对？那是模仿我的冒牌货。";
		next;
		cutin "",255;
		mes "[品红]";
		mes "什么？？那不是真正的你？";
		npctalk "它看起来和你一模一样。", "Cyan#172ba03", bc_self;
		npctalk "哦，对了！它也叫我去湖边！", "Denny#172ba03", bc_self;
		next;
		cutin "16loo_01",2;
		mes "[新兵]";
		mes "我一直和神殿在一起。冒险家遇到的是冒牌货，差点被带到湖边。";
		mes "从目前情况看，它是有智慧的生命，并无意伤害我们。它只是想让我们离开这里。戈尼很可能是安全的。";
		next;
		cutin "",255;
		mes "[品红]";
		mes "你是说我被冒牌货骗了？不管它是谁，我都会找出真相。";
		npctalk "你骗了我……", "Cyan#172ba03", bc_self;
		npctalk "哈。没错，我真厉害。", "Denny#172ba03", bc_self;
		next;
		cutin "16loo_01",2;
		mes "[新兵]";
		mes "对手非常了解这座浴场。既然它知道有一座间歇排水的湖，也可能知道秘密通道。";
		next;
		mes "[新兵]";
		mes "你们会习惯水的。还有……蒸汽。它一定知道如何利用蒸汽。我不知道它想用蒸汽做什么，但肯定不只是遮挡视线。所以要小心。";
		next;
		cutin "16loo_03",2;
		mes "[新兵]";
		mes "对手在水上会非常快，就像水生生物一样。";
		next;
		cutin "",255;
		mes "[品红]";
		mes "那么，我们应该不让它接触水。";
		npctalk "也许它是一只浣熊。", "Cyan#172ba03", bc_self;
		npctalk "好，我们把它赶走！", "Denny#172ba03", bc_self;
		next;
		cutin "16loo_01",2;
		mes "[新兵]";
		mes "丹尼，准备布置陷阱，要设得严密。";
		npctalk "没想到会在这里用到陷阱。幸好我带来了。", "Denny#172ba03", bc_self;
		next;
		mes "[新兵]";
		mes "品红，堵住排水口和可能的撤退路线。";
		npctalk "我以前见过这些。", "Magenta#172ba03", bc_self;
		next;
		mes "[新兵]";
		mes "接下来，一边从一侧移动到另一侧，一边使用烟雾弹和空弹。注意别让弹药受潮，这里水和蒸汽很多。最后不要损坏设施。";
		npctalk "好的。", "Cyan#172ba03", bc_self;
		next;
		cutin "16loo_03",2;
		mes "[新兵]";
		mes "嗯……这里水很多，如果能利用就好了。要是用冰冻住它的脚……可以使用冰冻陷阱吗？";
		next;
		cutin "",255;
		mes "[丹尼]";
		mes "我都带来了。让我看看……在这里。";
		next;
		cutin "16loo_02",2;
		mes "[新兵]";
		mes "冒险家，拿着这些^0000CD冰冻陷阱^000000。请在所有标记的??<NAVI>[地点]<INFO>ba_bath,55,55,0,101,0</INFO></NAVI>设置。放好并固定即可。快点。";
		next;
		cutin "16loo_01",2;
		mes "[新兵]";
		mes "那么，出发！";
		ep17_2_bath = 6;
		erasequest 17367;
		setquest 17368;
		getitem 1000103,7;
		getitem 1000100,4;
		getexp 309400,0;
		close2;
		cutin "",255;
		cloakonnpcself();
		cloakonnpcself( "Denny#172ba03" );
		cloakonnpcself( "Molar#172ba03" );
		cloakonnpcself( "Canine#172ba03" );
		cloakonnpcself( "Danae#172ba03" );
		cloakonnpcself( "Magenta#172ba03" );
		cloakonnpcself( "Cyan#172ba03" );
		end;
	}
	end;

OnInit:
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "isbegin_quest(17367) == 1" );
	end;
}


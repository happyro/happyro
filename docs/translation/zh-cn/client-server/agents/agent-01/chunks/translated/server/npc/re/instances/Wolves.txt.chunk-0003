2@nyr,212,104,1	script	Lamacus#dms401	EP18_ARMED_VILLAGER01,{
	if ('nyr_main_step != 10)
		end;
	if (is_party_leader() == false)
		end;
	mes "[尤皮]";
	mes "这就是尽头了吗？";
	next;
	mes "[拉马库斯]";
	mes "我知道。他们一定有真正的秘密图书馆。";
	npctalk "糟糕，浪费了。", instance_npcname("Yopi#dms421");
	npctalk "你不会因为失败就怪我吧？", instance_npcname("Kun#dms411");
	next;
	mes "[拉马库斯]";
	mes "我早就叫你们去找了，不是让你们因为它存在就来找我。";
	next;
	mes "[坤]";
	mes "问问现在退出是否可以。";
	next;
	npctalk "这是沃尔夫。", instance_npcname("Lamacus#dms401");
	sleep2 2000;
	npctalk "？？？：你找到物品了吗？", instance_npcname("Lamacus#dms401");
	sleep2 2000;
	npctalk "这是最后一座图书馆，但我觉得它不在这里。", instance_npcname("Lamacus#dms401");
	sleep2 2000;
	npctalk "？？？：等等。", instance_npcname("Lamacus#dms401");
	mes "[坤]";
	mes "等等，我是不是看错了？那是米莉安和冒险家。";
	npctalk "你真执着。没想到你击败了所有守卫。", instance_npcname("Yopi#dms421");
	next;
	cutin "ep18_miriam_03.png",2;
	mes "[米莉安]";
	mes "你们在和谁说话？";
	next;
	select( "你们是收钱做这件事的吗？" );
	cutin "",255;
	mes "[拉马库斯]";
	mes "报酬？我们可没拿到，对吧？";
	npctalk "我多少还是相信一些的。", instance_npcname("Kun#dms411");
	npctalk "我们绝不会背叛。", instance_npcname("Yopi#dms421");
	next;
	enablenpc instance_npcname("Temple Guard#dms501");
	enablenpc instance_npcname("Temple Guard#dms511");
	enablenpc instance_npcname("Temple Guard#dms521");
	enablenpc instance_npcname("Temple Guard#dms531");
	enablenpc instance_npcname("Temple Guard#dms541");
	unitwalk getnpcid(0,instance_npcname("Temple Guard#dms501")),203,95;
	unitwalk getnpcid(0,instance_npcname("Temple Guard#dms511")),201,96;
	unitwalk getnpcid(0,instance_npcname("Temple Guard#dms521")),201,93;
	unitwalk getnpcid(0,instance_npcname("Temple Guard#dms531")),199,98;
	unitwalk getnpcid(0,instance_npcname("Temple Guard#dms541")),199,92;

	sleep2 500;
	npctalk "在这里！", instance_npcname("Temple Guard#dms501");
	npctalk "嘿！你在这里！！", instance_npcname("Lamacus#dms401");
	sleep2 1000;
	enablenpc instance_npcname("Schulang#dms101");
	unitwalk getnpcid(0,instance_npcname("Schulang#dms101")),206,96;
	npctalk "......", instance_npcname("Schulang#dms101");
	npctalk "你到了！", instance_npcname("Lamacus#dms401");
	npctalk "你到了！", instance_npcname("Kun#dms411");
	npctalk "你到了！", instance_npcname("Yopi#dms421");
	sleep2 2000;

	cutin "ep18_shulang.png",0;
	mes "[？？]";
	mes "这是图书馆的尽头吗？";
	next;
	cutin "",255;
	mes "[拉马库斯]";
	mes "是的。";
	next;
	cutin "ep18_shulang.png",0;
	mes "[？？]";
	mes "我本想找到那本书，但没能做到。他们已经完成工作，我们离开这里吧。";
	next;
	cutin "ep18_miriam_03.png",2;
	mes "[米莉安]";
	mes "你是谁？你和这些人有什么关系？";
	next;
	cutin "ep18_shulang.png",0;
	mes "[？？]";
	mes "怎么了？还有别的事吗？";
	next;
	cutin "",255;
	mes "[尤皮]";
	mes "有人嗅到了狼的踪迹，决定跟踪我们。我们很快就会处理掉。";
	next;
	cutin "ep18_shulang.png",0;
	mes "[？？]";
	mes "没必要。你们离开这里，让新人接手吧。";
	next;
	cutin "",255;
	mes "[拉马库斯]";
	mes "好！！";
	next;
	disablenpc instance_npcname("Schulang#dms101");
	cutin "ep18_miriam_03.png",2;
	mes "[米莉安]";
	mes "等等！！！";
	next;
	cutin "",255;
	mes "[神殿守卫]";
	mes "处理掉所有入侵者！";
	unittalk getcharid(3), "" + strcharinfo(0) + " : Who's the intruder?";
	next;
	cutin "ep18_miriam_03.png",2;
	mes "[米莉安]";
	mes "命运的转折真奇怪，对吧？神殿守卫被收买了。我们必须查清发生了什么……";
	unittalk getcharid(3), "" + strcharinfo(0) + " : Leave these people to me.";
	next;
	cutin "",255;
	mes "[神殿守卫]";
	mes "全员列队！";
	next;
	mes "[尤皮]";
	mes "哦，不~很遗憾和你们碰面了，我们已经弄脏手了，下次别再见面了？";
	if ('nyr_main_step == 10) {
		'nyr_main_step = 11;
		donpcevent instance_npcname("nyr_step_5") + "::OnStart";
	}

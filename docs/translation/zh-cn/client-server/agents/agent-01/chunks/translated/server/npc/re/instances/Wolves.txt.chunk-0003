	mes "你确定没有可疑人员进来吗？他们显然已经闯入这里了，等我一下，我马上去检查。";
	next;
	cutin "",255;
	mes "[神殿守卫]";
	mes "再靠近一步，我们就要采取行动。";
	next;
	cutin "ep18_miriam_03.png",2;
	mes "[米莉安]";
	mes "……那也没办法了。可以帮忙吗，冒险家？";
	next;
	select( "好。我来处理，你去追他们。" );
	mes "[米莉安]";
	mes "那就帮我一个忙，我会留下踪迹，让你找到我……";
	next;
	cutin "",255;
	disablenpc instance_npcname("Miriam#dms201");
	mes "[神殿守卫]";
	mes "入侵者……！啊！！！";
	if ('nyr_main_step == 4) {
		'nyr_main_step = 5;
		donpcevent instance_npcname("nyr_step_2") + "::OnStart";
	}
	close;
}


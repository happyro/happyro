2@nyr,99,47,1	script	Lamacus#dms301	EP18_ARMED_VILLAGER01,{
	if ('nyr_main_step != 8)
		end;
	if (is_party_leader() == false)
		end;
	mes "[拉马库斯]";
	mes "找到它了吗？这里到底是什么地方？";
	next;
	mes "[坤]";
	mes "还没有。我不认为它在这边。哦，等等……大祭司的……？";
	next;
	mes "[尤皮]";
	mes "别管那些无关的书。那不是我们要找的。";
	next;
	cutin "ep18_miriam_03.png",0;
	mes "[米莉安]";
	mes "你们这些人……！";
	next;
	select( "嘘——等一下。" );
	cutin "",255;
	mes "[拉马库斯]";
	mes "就算是最隐秘的图书馆，也不会把那种书随便放着。";
	next;
	mes "[坤]";
	mes "所以秘密图书馆里还有另一个秘密图书馆？";
	next;
	mes "[尤皮]";
	mes "我不知道。先把它找出来再说。";
	next;
	mes "[坤]";
	mes "要是知道书名就好了。";
	next;
	mes "[拉马库斯]";
	mes "如果我知道，就不会在这里了。我会说‘把看起来像那本的都带来’。快去找。";
	next;
	select( "看起来他们不是在找某本特定的书吗？" );
	mes "[米莉安]";
	mes "特定的书……？不是随便一本用来寻找弱点的书？";
	next;
	cutin "ep18_miriam_03.png",0;
	mes "[米莉安]";
	mes "不，你说的是这个吗？喂！你们在找什么？为了什么目的？";
	next;
	cutin "",255;
	mes "[尤皮]";
	mes "你又来了！为什么偷听？好像你有什么见不得人的事要说似的。";
	npctalk "你为什么一直跟着我？为什么一直打扰我？", instance_npcname("Kun#dms311");
	next;
	cutin "ep18_miriam_03.png",0;
	mes "[米莉安]";
	mes "偷偷摸摸闯进来的是你们，别忘了。你们找的是什么书？";
	next;
	cutin "",255;
	mes "[拉马库斯]";
	mes "这话真伤人。你难道不明白我们是在努力把事情变好吗？我们是在为大家创造更好的生活。";
	npctalk "你在陷害我们吗？", instance_npcname("Yopi#dms321");
	npctalk "他们对我们说了什么？", instance_npcname("Kun#dms311");
	next;
	mes "[拉马库斯]";
	mes "他们永远不会知道我们有多在乎。顺便说，你出现得正是时候……";
	next;
	cutin "ep18_miriam_03.png",0;
	mes "[米莉安]";
	mes "你们得抓住他们，让他们说出真相……！";
	next;
	enablenpc instance_npcname("Temple Guard#dms401");
	enablenpc instance_npcname("Temple Guard#dms411");
	enablenpc instance_npcname("Temple Guard#dms421");
	enablenpc instance_npcname("Temple Guard#dms431");
	enablenpc instance_npcname("Temple Guard#dms441");
	cutin "",255;
	mes "[神殿守卫]";
	mes "来了！入侵者在这里！！！";
	npctalk "来了！！！祝你好运！我们上，伙计们！", instance_npcname("Lamacus#dms301");
	npctalk "我去追他们，冒险者，你来对付这些家伙！", instance_npcname("Miriam#dms401");
	next;
	mes "[神殿守卫]";
	mes "放下武器！！";
	if ('nyr_main_step == 8) {
		'nyr_main_step = 9;
		donpcevent instance_npcname("nyr_step_4") + "::OnStart";
	}
	close;
}


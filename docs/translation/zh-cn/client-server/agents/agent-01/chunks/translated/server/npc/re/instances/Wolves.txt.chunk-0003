2@nyr,209,98,5	script	Miriam#dms501	4_EP18_MIRIAM,5,5,{
	if (is_party_leader() == false)
		npctalk "队长不是决定要来吗？", instance_npcname("Miriam#dms501");
	end;
OnTouch:
		npctalk "看到那边的书架了吗？", instance_npcname("Miriam#dms501");
		npctalk "我的手指要被烧伤了。", instance_npcname("Lamacus#dms401");

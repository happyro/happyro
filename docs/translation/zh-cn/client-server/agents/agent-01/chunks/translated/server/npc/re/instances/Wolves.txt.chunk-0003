2@nyr,37,93,5	script	Lamacus#dms201	EP18_ARMED_VILLAGER01,{
	if ('nyr_main_step != 6)
		end;
	if (is_party_leader() == false)
		end;
	cutin "ep18_miriam_03.png",2;
	mes "[米莉安]";
	mes "你们在这里做什么？";
	next;
	cutin "",255;
	mes "[拉马库斯]";
	mes "哇！你怎么会和冒险家一起在这里？";
	next;
	cutin "ep18_miriam_03.png",2;
	mes "[米莉安]";
	mes "你现在不该在这里。如果被神殿发现，只会让我们的处境更糟。";
	next;
	cutin "",255;
	mes "[拉马库斯]";
	mes "你还不明白吗？我们正在闯入图书馆。这里一定藏着许多定居者的秘密。";
	npctalk "想想看，如果这些东西都落到我们手里呢？", instance_npcname("Kun#dms211");
	npctalk "我们可以利用他们的弱点！", instance_npcname("Yopi#dms221");
	next;
	cutin "ep18_miriam_03.png",2;
	mes "[米莉安]";
	mes "那些以后再想。现在先回去。你现在的行为可能让我们陷入更大危险……";
	next;
	cutin "",255;
	mes "[尤皮]";
	mes "回家吧，米莉安。我再也不想配合你那套死板的做法了。";
	npctalk "你凭什么命令我们？", instance_npcname("Kun#dms211");
	next;
	enablenpc instance_npcname("Temple Guard#dms301");
	mes "[神殿守卫]";
	mes "在那里，入侵者！";
	next;
	enablenpc instance_npcname("Temple Guard#dms311");
	enablenpc instance_npcname("Temple Guard#dms321");
	enablenpc instance_npcname("Temple Guard#dms331");
	enablenpc instance_npcname("Temple Guard#dms341");
	mes "[神殿守卫]";
	mes "所有人放下武器，举起手来！";
	next;
	select( "我要怎么做？" );
	cutin "ep18_miriam_03.png",2;
	mes "[米莉安]";
	mes "他们人多势众，我们想办法应付。";
	next;
	cutin "",255;
	mes "[坤]";
	mes "来得正好。那我们就告别吧！";
	next;
	cutin "ep18_miriam_03.png",2;
	mes "[米莉安]";
	mes "等一下，冒险家！";
	next;
	select( "这个交给我！" );
	if ('nyr_main_step == 6) {
		'nyr_main_step = 7;
		donpcevent instance_npcname("nyr_step_3") + "::OnStart";
	}
	cutin "",255;
	end;
}


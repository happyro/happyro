mjolnir_09,209,341,3	script	Dwarf Blacksmith#south	826,{
	if ($God3 < $@god_check1) {
		mes "[Sudri]";
		mes "我想和越来越强的对手";
		mes "竞争并战斗！";
		next;
		mes "[Sudri]";
		mes "总有一天，我会回到斯瓦尔特夫海姆并打败伊瓦尔第！哇哈哈哈！";
		close;
	}
	else {
		if ($God4 >= $@god_check2) {
			mes "[Sudri]";
			mes "等等，现在还不是";
			mes "战斗的时机";
			mes "……";

		select("是的。");
		mes "[阿鲁纳佩尔兹信徒]";
		mes "泽德大祭司想立即见你，"+strcharinfo(0)+"。";
		next;
		select("可以问问原因吗？");
		mes "[阿鲁纳佩尔兹信徒]";
		mes "其实我也不知道。";
		mes "我只是来通知你，他正在找你。";

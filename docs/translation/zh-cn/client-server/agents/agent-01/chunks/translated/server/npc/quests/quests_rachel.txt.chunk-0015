rachel,142,167,5	script	Seeking Follower#rachel	916,6,6,{
	if ((lost_boy == 13) && (ra_tem_q == 20)) {
		L_Mes:
		mes "[阿鲁纳佩尔兹信徒]";
		mes "请问，你是"+strcharinfo(0)+"吗？";

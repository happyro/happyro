				mes "总有几位神父陪着我。";
				mes "他们有时甚至会看着我睡觉。";
				mes "所以我其实没有时间感到孤独。";
				next;
				mes "[教皇]";
				mes "谢谢你的关心。";
				mes "有时……有时我会想，";
				mes "我是否真的有家人。";
				mes "我甚至不知道他们是谁，";
				mes "或者他们是否存在。我不知道……";
				next;
				mes "[教皇]";
				mes "我……对不起。";
				mes "我想你没料到会听到这种话。";
				mes "^666666*叹气*^000000 我感觉很疲惫。";
				mes "我最好……我最好休息一下……";
				set aru_em,16;
				changequest 2135,2136;
				close2;
				cutin "",255;
				end;
			case 2:
				mes "[教皇]";
				mes "即使我想出去玩，也不能随便离开。";
				mes "作为教皇……嗯……";
				mes "所有人和所有事情都需要我的关注。";
				close2;
				cutin "",255;
				end;
			}
		}
		else if (aru_em == 16) {
			mes "[信徒]";
			mes "教皇说她很疲惫。";
			mes "请等她感觉好些后再回来，";
			mes "她会接见你的。";
		}
	}
	close2;
	cutin "",255;
	end;
}


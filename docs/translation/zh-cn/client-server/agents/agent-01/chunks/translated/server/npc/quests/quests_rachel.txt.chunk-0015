ra_temin,288,151,0	script	hidden1#rachel	-1,1,6,{
OnTouch:
	if (ra_tem_q == 18) {
		mes "^3355FF在这个距离，你能清楚听到";
		mes "墙另一侧传来的声音……^000000";
		next;
		mes "[????]";
		mes "……真的有必要让外人介入这件事吗？";
		mes "回答我！";
		next;
		mes "[泽德大祭司]";
		mes "你说的是那场事故吗？";
		mes "你知道我一直反对导致魔力泄漏的行为。";
		next;
		mes "[泽德大祭司]";
		mes "虽然我认为那是鲁莽的决定，";
		mes "但我已经关闭神殿，尽力掩盖这场不幸的事故。";
		next;
		mes "[????]";
		mes "我没有责怪你。事实上我承认，那是我们的错误。";
		mes "我们让魔力泄漏，导致魔物泛滥。";
		next;
		mes "[????]";
		mes "但这和我问你的事无关！";
		mes "你真的认为在这种动荡时期，";
		mes "允许外人与我们的教皇交谈是正确的吗？！";
		next;
		mes "[泽德大祭司]";
		mes "为什么不行？我以为这会给她很大的安慰。";
		mes "她很困惑，不明白圣地为何关闭，";
		mes "也无法知道那里发生了什么。";
		next;
		mes "[泽德大祭司]";
		mes "再说一次……我强烈反对那里暗中进行的事情。";
		mes "我知道自己不能正式反对这个行动，但是……";
		next;
		mes "[????]";
		mes "没什么好担心的！一切很快就会结束。";
		mes "而且现在已经太迟，无法回头了。";
		mes "我警告你：别做任何蠢事。";
		next;
		mes "^3355FF有人来了！";
		mes "你最好离开墙边，尽量装作什么也不知道！^000000";
		next;
		hideoffnpc "High Priestess Niren#ra";
		cutin "ra_gwoman",2;
		mes "[妮伦大祭司]";
		mes "哦！你一定就是大祭司贝——呃，泽德告诉我的那个人。";
		mes "很高兴见到你。我是妮伦大祭司，随时为你效劳。";
		next;
		mes "[妮伦大祭司]";
		mes "听说你有幸与我们的教皇交谈，";
		mes "她也度过了愉快的时光。";
		mes "你觉得她怎么样，嗯？";
		next;
		select("她和我想象的不一样……");
		cutin "ra_gwoman2",2;
		mes "[妮伦大祭司]";
		mes "啊，我明白你的意思了……";
		mes "通常外来者都会告诉我，";
		mes "他们以为我们的教皇是白发苍苍的老人。";
		mes "但阿鲁纳佩尔兹并不是这样。";
		next;
		cutin "ra_gwoman",2;
		mes "[妮伦大祭司]";
		mes "通常，我们会根据她与女神芙蕾雅的相似程度选择教皇。";
		mes "她必须拥有银色金发、雪白的皮肤，";
		mes "以及神圣色彩的眼睛。你看到了，对吧？";
		next;
		mes "[妮伦大祭司]";
		mes "我很好奇：你和教皇谈了些什么？";
		mes "如你所知，我们神职人员禁止离开阿鲁纳佩尔兹，所以……";
		next;
		mes "^3355FF你向她讲述了";
		mes "你可以谈谈与教皇的对话，";
		mes "但别提圣地的任何事情，这是泽德大祭司的要求。^000000";
		next;
		mes "[妮伦大祭司]";
		mes "啊，你的国家真有意思。";
		mes "告诉我，你是怎么认识贝肯托，呃，我是说泽德大祭司的？";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "(^666666贝肯托？^000000)";
		next;
		select("说明你如何认识泽德大祭司");
		cutin "ra_gwoman2",2;
		mes "[妮伦大祭司]";
		mes ".........................";
		mes "就这些？嗯？真有趣。^333333*叹气*^000000";
		mes "我觉得他太容易相信别人了……";
		mes "不过这只是我的看法。";
		next;
		cutin "ra_gwoman",2;
		mes "[妮伦大祭司]";
		mes "如果你不介意……";
		mes "我想给你一点建议。别和泽德大祭司走得太近。";
		mes "否则你可能会给自己惹上麻烦。";
		next;
		cutin "",255;
		hideonnpc "High Priestess Niren#ra";
		mes "^3355FF妮伦大祭司离开了。";
		mes "她说完这些话后，你感到疑惑。";
		mes "她到底是什么意思？";
		mes "现在，你最好去和泽德大祭司谈谈。^000000";
		set ra_tem_q,19;
		if (isbegin_quest(8102) == 1)
			changequest 8102,8103;
		else if (isbegin_quest(8101) == 1)
			changequest 8101,8103;
		close;
	}
	end;
}


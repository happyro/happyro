		mes "我们试着连接 Robert 吧。嗯……这不完全是为了测试机器的新功能。（犹豫）";
		next;
		while( select("我再想想别的办法。:我们试着和 Robert 通信吧。") != 2 ) {
			mes "[Hiel]";
			mes "嗯，真遗憾。如果你想攻击家树，那太危险了。你只会被关进监狱。";
			next;
		}
		mes "[Hiel]";
		mes "好！！太棒了，太棒了！";
		mes "那么开始通信吧？把手放在这里的反应器上。";
		changequest 12298,12299;
		ep14_2_etran = 36;
	}
	else if (ep14_2_etran == 36)
		mes "集中注意力于裂隙反应器。";
	else if (ep14_2_etran == 37) {
		mes "每次见到 Robert 先生，我总觉得像是在照镜子……";
		next;
		select("一点也不愉快……");
		mes "[Hiel]";
		mes "我只见过他两次，但每次见到他都觉得非常熟悉，还有些怀念。我不知道该怎么称呼这种感觉。就是一种很熟悉的感觉。";
		next;
		mes "[Hiel]";
		mes "哦，总之别对反应器分心。它现在正在连接。";
		ep14_2_etran = 38;
	}
	else if (ep14_2_etran == 41) {
		mes "嘿嘿～现在快完成了。";
		next;
		mes "[Hiel]";
		mes "现在这个反应器的范围已经超越艾可拉玖，抵达彩虹桥。";
		next;
		mes "[Hiel]";
		mes "如果再稍微改造一下，我肯定还能自由选择想要的时间点。";
		next;
		select("Etran 让我代他向你道谢。");
		mes "[Hiel]";
		mes "真的吗？那太好了……我希望有一天能帮助 Etran 先生和 Robert 先生在这台反应器中重聚。";
		next;
		cutin "EP14_robert1",1;
		mes "^000099这一刻，Hiel 的笑容让我想起了 Robert。我一定是产生错觉了。^000000";
		ep14_2_etran = 42;
		close2;
		cutin "",255;
		end;
	}
	else if (ep14_2_etran > 42) {
		mes "哦，你好～我和往常一样忙，啊哈。";
		next;
		if (select("我只是来打个招呼。:请他改造 Etran 的项链。") == 1) {
			mes "[Hiel]";
			mes "嗯，确实没什么需要改进的了。我特许你，"+ strcharinfo(0) +"，随时使用它。";
			next;
			mes "[Hiel]";
			mes "请随时来使用。我让它能够连接各种时间频道，但我自己也不知道会发生什么。";
			close;
		}
		mes "[Hiel]";
		mes "你是说 Etran 先生的信物？我可以试着用特殊的魔力石赋予它想要的效果，但这种材料很贵，要花 10 枚斯普兰迪德硬币……";
		next;
			switch( select("我下次再来吧……:我有足够的硬币。") ) {
			mes "[Hiel]";
		case 1:
			mes "好，准备好后告诉我。我会赋予你想要的效果。";
			close;
		case 2:
			mes "哦，好吧，那我们试着赋予效果？这不是我的专长，所以我有点紧张，不过……哈哈哈……";
			next;
			.@etran_r = select("我下次再做～:赋予物理能力:赋予魔法能力:赋予远程能力:赋予恢复能力") -1;
			mes "[Hiel]";
			if (.@etran_r == 0) {
				mes "好，准备好后告诉我。我会恢复它的效果。";
				close;
			}
		}
		if (countitem(6081) < 10)
			mes "看来你的硬币不够。我本想替你处理，但这种材料实在太贵了……";
		else if (!countitem(2915))
			mes "你现在身上似乎没有带着 Etran 的信物。";
		else {
			delitem 2915,1;// Ettlang_Keepsake
			delitem 6081,10;// Splendide_Coin
			setarray .@card3[1],4818,4813,4818,4805;
			setarray .@card4[1],4766,4760,4832,4805;
			getitem2 2915,1,1,0,0,0,0,.@card3[.@etran_r],.@card4[.@etran_r];// Ettlang_Keepsake
			mes "效果赋予成功。";
		}
	}
	else
		mes "嗯，还要修正什么呢？我本该多学习一些……";
	close;
}

mid_camp,173,257,5	script	Shelby#pa0829	4_CAT_SAILOR2,{
	disable_items;
	if (checkweight(1201,1) == 0) {
			mes "携带的物品种类似乎太多了。减少物品种类后再试一次吧。";
		close;
	}
	if ((MaxWeight - Weight) < 10000) {
			mes "你的物品似乎太重了。减轻负重后再试一次吧。";
		close;
	}
	if (ep14_2_etran == 15) {
		if (countitem(12636) < 10) {
			mes "^000099他正忙着和 Ford 战斗。如果没人阻止这场战斗，可能就再也没机会和他说话了。^000000";
			close;
		}
		mes "[Shelby]";
			mes "咦？";
			mes "你在哪里找到那罐头食品的？";
		next;

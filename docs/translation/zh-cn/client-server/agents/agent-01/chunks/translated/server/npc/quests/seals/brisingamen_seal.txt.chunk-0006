que_god02,1,1,1	script	#brisinsold2	-1,{
OnInit:
	hideonnpc "Soldier#2_brising";
	areawarp "que_god02",15,125,185,131,"geffen",120,100;
	end;

OnSold2On:
	hideoffnpc "Soldier#2_brising";
	initnpctimer;
	end;

OnTimer420000:
	mapannounce "que_god02","洛温的灵魂开始变得虚弱……",0,0x70DBDB;
	end;

OnTimer480000:
	mapannounce "que_god02","你在她过去的存在无法维持太久了……",0,0x70DBDB;
	end;

OnTimer540000:
	mapannounce "que_god02","洛温的灵魂无法再让你留在过去。",0,0x70DBDB;
	end;

OnTimer542000:
	areawarp "que_god02",15,125,185,131,"geffen",120,100;
	end;

OnTimer550000:
	donpcevent "#brisinsummon::OnReset";
	end;

OnTimer550500:
	stopnpctimer;
	end;

}
	
que_god02,1,1,1	script	#brisinsummon	-1,{

OnInit:

que_god02,48,55,3	script	Lowen Ellenen	745,{
	if (god_brising == 30) {
		mes "[洛温·艾伦恩]";
	mes "你现在能看到我吗？";
	mes "你一定很惊讶。";
	mes "这是我要";
	mes "与你分享的故事。";
		next;
		mes "[洛温·艾伦恩]";
	mes "看看周围。";
	mes "认出来了吗？";
	mes "我们还在同一个地方，只是现在回到了我的过去。";
		next;
		mes "[洛温·艾伦恩]";
	mes "我们所有人来到吉芬，是为了净化这里的邪灵。你问我为什么留在这个可怕的地方？";
		next;
		mes "[洛温·艾伦恩]";
	mes "我无法原谅自己对同伴所做的一切。他们";
	mes "因为我而死。";
		next;
	switch(select("你被诅咒了……？:你还有未完成的事。")) {
		case 1:
			mes "["+ strcharinfo(0) +"]";
			mes "你的意思是……";
			mes "同伴的愤怒";
			mes "化成了";
			mes "诅咒？";
			next;
			mes "[洛温·艾伦恩]";
		mes "被死去的同伴诅咒……是的，我一开始也是这么想的。所以我试图赎罪，也为他们报仇。";
			next;
			mes "[洛温·艾伦恩]";
		mes "两年来，我一直尽力安抚他们的灵魂。";
			next;
			mes "[" + strcharinfo(0) + "]";
	mes "自从你们任务失败后，你们就在这里杀了两年怪物？";
			next;
			mes "[洛温·艾伦恩]";
		mes "是的，没错。";
		mes "我以为这样能安慰同伴的灵魂。";
			next;
			mes "[洛温·艾伦恩]";
		mes "但我死后，在死者之城尼弗尔海姆遇到了所有老朋友。你听说过那里吧？";
			next;
			mes "[洛温·艾伦恩]";
		mes "没人";
		mes "因为发生的事";
		mes "责怪我。事实上，他们似乎都在担心我。";
			next;
		select("那为什么？");
			mes "[洛温·艾伦恩]";
		mes "他们在尼弗尔海姆等了我两年，因为不想让我误解。他们从未责怪我发生的一切。";
			next;
			mes "[洛温·艾伦恩]";
		mes "但我仍然觉得不对劲。在我们所有人中，只有我无法安息。其他人都被选去瓦尔哈拉。";
			next;
		mes "[洛温·艾伦恩]";
		mes "可瓦尔哈拉是所有光荣十字军应该去的地方。我到底做错了什么？";
			close;
		case 2:
			mes "[洛温·艾伦恩]";
		mes "我不认为自己还有未完成的事。但谁知道呢，也许我确实有必须完成的事。";
			next;
	mes "[洛温·艾伦恩]";
		mes "我在尼弗尔海姆遇到的所有已故同伴都被女武神选中，送往瓦尔哈拉。光荣的十字军死后就该如此。但看来我不配……";
			next;
		select("我可以帮你！");
		mes "[洛温·艾伦恩]";
		mes "你能";
		mes "帮我？";
		mes "怎么帮……？";
			next;
			mes "[" + strcharinfo(0) + "]";
		mes "你说这里就是讨伐任务发生的地方，对吧？我会和你一起战斗！";
			next;
			mes "["+ strcharinfo(0) +"]";
		mes "好了，你不该这样感到内疚。我们想想该怎么对付这些怪物吧！";
			next;
			mes "[洛温·艾伦恩]";
			mes "...";
		mes "谢谢你。";
		mes "真的非常感谢。";
			next;
			mes "[" + strcharinfo(0) + "]";
		mes "那么，";
		mes "我们进去吧？";
			set god_brising,31;
			close;
		}
	}
	else if (god_brising == 31) {
		mes "[洛温·艾伦恩]";
		mes "走下";
		mes "前面的楼梯。从这里开始，";
		mes "我只能在你的意识中";
		mes "和你一起前进……";
		close;
	}
	else {
		mes "[洛温·艾伦恩]";
		mes "怎么会……";
		mes "你在这里？";
		close2;
		warp "geffen",120,101;
		end;
	}
}

que_god02,54,64,4	script	Soldier#1_brising	105,1,1,{
 	if (god_brising == 31) {
		mes "[士兵]";
	mes "你报名参加怪物讨伐了吗？现在要开始任务吗？";
		next;
	switch(select("是。:我还需要时间。")) {
		case 1:
			mes "[士兵]";
			mes "准备好后，";
			mes "来我面前";
			mes "站好。";
			close;
		case 2:
	mes "[士兵]";
			mes "没问题，准备完成后再回来吧。";
			close;
		}
	}
	else {
		mes "[士兵]";
		mes "请退后。";
		mes "你没有获准";
		mes "进入！";
		close;
	}

OnTouch_:
	if (god_brising == 31) {
		warp "que_god02",174,49;
		donpcevent "#brisinsold::OnSold1Off";
		donpcevent "#brisinsold2::OnSold2On";
		end;
	}
	else {
			mes "[士兵]";
		mes "请退后。";
		mes "你无权进入";
		mes "这里！";
		close2;
		warp "que_god02",51,59;
		end;
	}
	end;
}


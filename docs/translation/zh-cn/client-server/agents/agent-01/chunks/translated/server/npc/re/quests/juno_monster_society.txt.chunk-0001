		mes .@npc_name$;
mes "朱诺怪物研究协会，顾名思义，是朱诺的怪物研究机构。";
mes "根据最近的调查，一些地区的怪物变得过于凶猛，或者数量增加了。";
		next;
		mes .@npc_name$;
mes "所以我们把地图调查员派往这些区域讨伐怪物。";
mes "我是地图调查员的助理莱梅恩！";
		next;
		mes .@npc_name$;
mes "我在城里向正直的人宣传朱诺怪物研究协会的工作……";
mes "我会宣传碳酸水自动售货机，或者带你去调查员所在处！";
		close;
	}
	mes .@npc_name$;
mes "直接送你过去有点困难……我也赚不到钱。";
mes "是的，给我一瓶" + .@item_name$ + "，我就提供传送服务！";
	next;
	if (select( "给我一瓶" + .@item_name$ + "。", "我拒绝。" ) == 2) {
		mes .@npc_name$;
mes "呃，你现在不去吗？那我就不为你服务" + .@item_name$ + "了。抱歉。";
		close;
	}
	if (countitem(1000374) < 1) {
		mes .@npc_name$;
		mes "这个看起来清爽的自动售货机出售" + .@item_name$ + "。";
mes "你只需要购买一些清爽的" + .@item_name$ + "并交给我。";
		close;
	}
	mes .@npc_name$;
mes "哇！谢谢你。这一瓶" + .@item_name$ + "会消除你的疲劳。";
mes "那么要把你送到哪里？";
	callfunc( "F_Brilliant_Soda" );
	mes .@npc_name$;
mes "哦，你现在不去吗？那我就把" + .@item_name$ + "还给你。";
	close;

OnInit:
	setunittitle getnpcid(0), "<Juno Monster Society>";
	end;
}


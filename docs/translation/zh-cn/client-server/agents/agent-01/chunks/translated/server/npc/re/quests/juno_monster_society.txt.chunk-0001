	if (select( "前往地图调查员所在处。", "听取朱诺怪物研究协会的工作介绍。" ) == 2) {
		mes .@npc_name$;
mes "朱诺怪物研究协会，顾名思义，是以朱诺为基地研究怪物的组织。";
mes "最近，一些当地怪物变得过于凶猛，或者数量大幅增加。";
		next;
		mes .@npc_name$;
mes "所以我们把地图调查员派往各地讨伐怪物。";
		next;
		mes .@npc_name$;
mes "我的任务是在城里宣传研究协会，协助地图调查员，并管理" + .@item_name$ + "自动售货机。";
mes "是的，我可以带你去调查员那里";
		close;
	}
	mes .@npc_name$;
mes "哦，抱歉。这不是免费的……";
mes "好，能给我一瓶" + .@item_name$ + "吗？我就送你过去！";
	next;
	if (select( "给我一瓶" + .@item_name$ + "。", "我拒绝。" ) == 2) {
		mes .@npc_name$;
mes "你不去吗？这是为了公众利益！";
		close;
	}
	if (countitem(1000374) < 1) {
		mes .@npc_name$;
		mes "你的包里没有" + .@item_name$ + "。";
mes "如果还需要，请使用这里清爽的碳酸水自动售货机。";
		close;
	}
	mes .@npc_name$;
mes "啊！新鲜又清凉的" + .@item_name$ + "！";
mes "你应该适量饮用……嗯，要把你送到哪里？";
	callfunc( "F_Brilliant_Soda" );
	mes .@npc_name$;
mes "你不去吗？这是为了公众利益！";
mes "唉……我把" + .@item_name$ + "还给你……";
	close;

OnInit:
	setunittitle getnpcid(0), "<Juno Monster Society>";
	end;
}


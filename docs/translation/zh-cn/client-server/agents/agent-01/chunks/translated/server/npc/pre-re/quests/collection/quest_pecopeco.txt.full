//===== Compatible With: =====================================
//= rAthena Project
//===== Description: =========================================
//= [Official Conversion]
//= Added Monster Killing quests.
//= Repeatable EXP Quest (Bill of Birds)
//===== Additional Comments: =================================
//= 1.0 First version.
//============================================================

moc_fild02,74,329,3	script	Gregor#PecoPeco_Hunt	97,{
	if (checkquest(60101) != -1) {
		if (checkquest(60101,HUNTING) != 2 ) {
			mes "[格雷戈尔]";
			mes "你完成猎杀 50 只大嘴鸟了吗？";
			next;
			switch(select("是:否:我想放弃")) {
			case 1:
				mes "[格雷戈尔]";
				mes "嗯，我不认为你已经猎杀了 50 只……";
				close;
			case 2:
				mes "[格雷戈尔]";
				mes "请尽快猎杀 50 只美味……呃，讨厌的大嘴鸟。";
				close;
			case 3:
				mes "[格雷戈尔]";
				mes "确定要停止猎杀吗？";
				mes "你取得的所有进度都会被删除";
				next;
				switch(select("是:否")) {
				case 1:
					mes "[格雷戈尔]";
					mes "好吧，改变主意后再回来。";
					erasequest 60101;
					close;
				case 2:
					mes "[格雷戈尔]";
					mes "请尽快猎杀 50 只美味……呃，讨厌的大嘴鸟。";
					close;
				}
			}
		}
		else {
			mes "[格雷戈尔]";
			mes "哦，非常感谢！";
			mes "我现在可以安心休息了。";
			getexp 4000,2000;
			erasequest 60101;
			close;
		}
	}
	if (checkquest(60102) != -1) {
		if (checkquest(60102,HUNTING) != 2 ) {
			mes "[格雷戈尔]";
			mes "你完成猎杀 50 只大嘴鸟了吗？";
			next;
			switch(select("是:否:我想放弃")) {
			case 1:
				mes "[格雷戈尔]";
				mes "嗯，我不认为你已经猎杀了 100 只……";
				close;
			case 2:
				mes "[格雷戈尔]";
				mes "请尽快猎杀 100 只美味……呃，讨厌的大嘴鸟。";
				close;
			case 3:
				mes "[格雷戈尔]";
				mes "确定要停止猎杀吗？";
				mes "你取得的所有进度都会被删除";
				next;
				switch(select("是:否")) {
				case 1:
					mes "[格雷戈尔]";
					mes "好吧，改变主意后再回来。";
					erasequest 60102;
					close;
				case 2:
					mes "[格雷戈尔]";
					mes "请尽快猎杀 100 只美味……呃，讨厌的大嘴鸟。";
					close;
				}
			}
		}
		else {
			mes "[格雷戈尔]";
			mes "哦，非常感谢！";
			mes "我现在可以安心休息了。";
			getexp 4000,2000;
			getexp 4000,2000;
			erasequest 60102;
			close;
		}
	}
	if (checkquest(60103) != -1) {
		if (checkquest(60103,HUNTING) != 2 ) {
			mes "[格雷戈尔]";
			mes "你完成猎杀 150 只大嘴鸟了吗？";
			next;
			switch(select("是:否:我想放弃")) {
			case 1:
				mes "[格雷戈尔]";
				mes "嗯，我不认为你已经猎杀了 150 只……";
				close;
			case 2:
				mes "[格雷戈尔]";
				mes "请尽快猎杀 150 只美味……呃，讨厌的大嘴鸟。";
				close;
			case 3:
				mes "[格雷戈尔]";
				mes "确定要停止猎杀吗？";
				mes "你取得的所有进度都会被删除";
				next;
				switch(select("是:否")) {
				case 1:
					mes "[格雷戈尔]";
					mes "好吧，改变主意后再回来。";
					erasequest 60103;
					close;
				case 2:
					mes "[格雷戈尔]";
					mes "请尽快猎杀 150 只美味……呃，讨厌的大嘴鸟。";
					close;
				}
			}
		}
		else {
			mes "[格雷戈尔]";
			mes "哦，非常感谢！";
			mes "我现在可以安心休息了。";
			getexp 4000,2000;
			getexp 4000,2000;
			getexp 4000,2000;
			erasequest 60103;
			close;
		}
	}
	//for minimum level
	if (BaseLevel > 9) {
		//for maximum level
		if (BaseLevel < 31) {
			mes "[格雷戈尔]";
			mes "大嘴鸟真迷人。";
			mes "我还在做我的……呃，研究……";
			mes "不过现在研究性质不同了。";
			next;
			mes "[格雷戈尔]";
			mes "你看，我一直通过收集它们的";
			mes "鸟嘴来……呃，‘研究’这些动物，";
			mes "但最近它们似乎";
			mes "开始对我抱有敌意。";
			next;
			mes "[格雷戈尔]";
			mes "你能帮我一个忙吗？";
			next;
			switch(select("什么忙？:不了")) {
			case 1:
				mes "[格雷戈尔]";
				mes "我很害怕这些大嘴鸟会因为我的……呃，研究活动而伤害我。";
				next;
				mes "[格雷戈尔]";
				mes "你能杀掉它们来保护我吗？";
				mes "这样我会安心些……";
				mes "拜托了……";
				next;
				switch(select("收集物品:猎杀大嘴鸟:取消")) {
				case 1:
					// Item turn in
					mes "[格雷戈尔]";
					mes "我的……呃，研究需要一些 ^FF0000鸟嘴^000000……";
					next;
					switch(select("我有鸟嘴:你需要什么？")) {
					case 1:
						if (countitem(925) > 24) {
							mes "[格雷戈尔]";
							mes "非常感谢。";
							delitem 925,25; //Bill_Of_Birds
							getexp 4000,2000;
							next;
							mes "[格雷戈尔]";
							mes "这一定会很好吃！";
							close;
						}
						else {
							mes "[格雷戈尔]";
							mes "看来你的数量不够。";
							next;
							mes "[格雷戈尔]";
							mes "你能帮我带来 ^FF000025 个鸟嘴^000000吗？";
							close;
						}
					case 2:
						mes "[格雷戈尔]";
						mes "你能帮我带来 ^FF000025 个鸟嘴^000000吗？";
						close;
					}
				case 2:
					// Kill Count Quest
					mes "[格雷戈尔]";
					mes "啊，好。我想你可以通过猎杀大嘴鸟来帮我。";
					mes "你想猎杀多少只？";
					next;
					switch(select("50 只大嘴鸟:100 只大嘴鸟:150 只大嘴鸟")) {
					case 1:
						mes "[格雷戈尔]";
						mes "完成任务后回来，我会给你一份小奖励。";
						setquest 60101;
						close;
					case 2:
						mes "[格雷戈尔]";
						mes "完成任务后回来，我会给你一份小奖励。";
						setquest 60102;
						close;
					case 3:
						mes "[格雷戈尔]";
						mes "完成任务后回来，我会给你一份小奖励。";
						setquest 60103;
						close;
					}
				case 3:
					mes "[格雷戈尔]";
					mes "如果你改变主意，请再回来。";
					close;
				}
			case 2:
				mes "[格雷戈尔]";
				mes "如果你改变主意，请再回来。";
				close;
			}
		}
		else {
			mes "[格雷戈尔]";
			mes "嗯……你似乎太强了，不该在这里战斗。";
			close;
		}
	}
	else {
		mes "[格雷戈尔]";
		mes "你好。";
		next;
		mes "[格雷戈尔]";
		mes "那边的波利鸟似乎更适合你。";
		close;
	}
}

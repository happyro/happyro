				mes "是目前最好的线索。";
				mes "这段旅程并不容易，";
				mes "所以谢谢你的理解。";
				break;
		}
		next;
		mes "[Kidd]";
		mes "总之，如果幸运的话，";
		mes "那里也许有人熟悉";
		mes "莱扬的研究，";

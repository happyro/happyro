		cutin "mocseal_rin01.bmp",2;
		mes "[Lin]";
		mes "塔纳托斯塔，嗯？";
		mes "好吧，我们不是不相信你，";
		mes "但在开始你要求的调查前，";
		mes "需要一些时间";

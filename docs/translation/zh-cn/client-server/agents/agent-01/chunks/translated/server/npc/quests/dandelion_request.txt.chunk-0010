que_job01,91,83,3	script	Kidd#hall	884,{

	if (mao_request == 124)
	{
		mes "[Kidd]";
		mes "大事要发生了……你必须";
		mes "召集蒲公英的其他成员，";
		mes "而我必须联系";
		mes "公会里的所有人！";
		next;
		mes "[Dandelion Member]";
		mes "放开我，我能感觉到";
		mes "梦罗克城堡发生了什么！";
		mes "我们现在就得过去！";

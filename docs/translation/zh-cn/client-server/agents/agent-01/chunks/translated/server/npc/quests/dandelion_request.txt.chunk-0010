	}
	else if(mao_request < 3 || (mao_request > 102 && mao_request < 124))
	{
		mes "[Kidd]";
		mes "......";
		mes ".........";
		close2;
	}
	else if(mao_request == 3)
	{
		cutin "mocseal_kid01.bmp",2;
		mes "[Kidd]";
		mes "哦，太好了，你来了，";
		mes "正是时候。这位蒲公英成员";
		mes "会向我们";
		mes "说明任务。";
			mes "现在请你";
			mes "认真听他说明……";
		next;
		cutin "mocseal_dan01.bmp",0;
		mes "[Dandelion Member]";
			mes "啊，你就是和基德一起";
			mes "执行任务的人吗？我是你的委托人，";
			mes "蒲公英组织的";
			mes "代表。";
		next;
		mes "[Dandelion Member]";
			mes "如果你还不知道，";
			mes "我们是提供公共服务的团体，";
			mes "进行各种志愿工作。";
			mes "不过，我们的一个项目——";
			mes "儿童托管中心，被";
			mes "莱扬·穆尔先生毁了。";
		next;
		mes "[Dandelion Member]";
			mes "他做的事太可怕了：";
			mes "莱扬·穆尔绑架了";
			mes "托管中心的所有孩子！";
			mes "我们觉得自己有责任，";
			mes "正在竭尽全力寻找他们……";
		next;
		mes "[Dandelion Member]";
			mes "不过，我们组织的人";
			mes "没有找到他的能力，";
			mes "更别说对付这个危险的";
			mes "男人了。所以才向你";
			mes "寻求帮助。";
		next;
		cutin "mocseal_kid01.bmp",2;
		mes "[Kidd]";
			mes "所以孩子们才会";
			mes "不断失踪吗？";
			mes "嗯，根据莱扬·穆尔的资料，";
			mes "他更像是个";
			mes "学者或研究人员，";
			mes "而不是危险的绑架者……";
		next;
		cutin "mocseal_dan01.bmp",0;
		mes "[Dandelion Member]";
			mes "是的，根据我们给你的资料，";
			mes "他看起来无害，";
			mes "但我不认为";
			mes "我们应该低估";
			mes "莱扬·穆尔这个人。";
		next;
		mes "^3355FF蒲公英组织的代表";
			mes "蒲公英组织";
			mes "取出一枚项链吊坠";
		mes "从衬衫下取出，贴在";
		mes "额头上，然后快速";
		mes "喃喃念了几句。^000000";
		set mao_request,4;
		close2;
	}

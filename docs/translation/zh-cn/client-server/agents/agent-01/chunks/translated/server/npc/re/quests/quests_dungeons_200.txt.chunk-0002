					mes "是啊……我不会因为睡不着就死掉……";
					mes "我已经死了。";
					close;
				}
				mes "[Milla]";
				mes "谢谢你的善心。";
				mes "愿活人的慈悲得到祝福！";
				setquest 8641;
				close;
			case 0:
			case 1:

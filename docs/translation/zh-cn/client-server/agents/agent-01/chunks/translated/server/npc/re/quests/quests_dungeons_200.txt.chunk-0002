			mes "[Old scholar]";
			mes "哦，天啊，我一直在寻找的强大而真诚的冒险者竟然出现在这里。";
			mes "你愿意帮我进行研究吗？";
			next;
		.@s = select( "听取请求", "可疑……" );
			mes "[Old scholar]";
		mes "只看一眼我就能认出你的实力，请帮帮忙……！";
			if (.@s == 2)
				close;
		mes "……？";
		mes "什么？你愿意帮我？";
			next;
			mes "[Old scholar]";
		mes "不，没什么……所有人都拒绝了，所以没说完的话卡在嘴边。";
		mes "谢谢你的配合。";
			next;
		select( "你还真是会使唤人……" );
			mes "[Old scholar]";
		mes "拜托，就是这样。当然，像你这么有才能的人可以前往尼福尔海姆。";
		mes "我当然也没多少日子可活了，但现在还不是我去的时候，而且我也来不及回来。";
			next;
			mes "[Old scholar]";
		mes "根据最近的消息……在尼福尔海姆的黑暗深处，死者正在举办宴会，";
		mes "形式令人难以想象。";
		mes "但没有地方能打听到更多消息。";
			next;
			mes "[Old scholar]";
		mes "反正你很快就会知道，但我现在就很好奇。";
		mes "你能去看看吗？我会给你丰厚的报酬。";
			next;
		if (select( "这样就够了。我可以回来吗？", "如果我回不来呢？" ) == 2) {
				mes "[Old scholar]";
		mes "以你的等级，根本不用担心回不来……";
		mes "既然你这么谨慎，那就算了。准备好后再回来。";
				close;
			}
			setquest 8639;
			mes "[Garim Springfield]";
		mes "谢谢。说起来，我忘了自我介绍。";
		mes "我叫加林·斯普林菲尔德。";
		mes "我在贤者城堡工作了很长时间……现在退休了，想在这里享受闲暇时光，也想提些请求……";
			next;
			mes "[" + strcharinfo(0) + "]";
		mes "放松……";
			next;
			mes "[Garim Springfield]";
		mes "好吧。值得一试。";
		mes "满足一个闲散老人的愿望吧。";
		mes "那么我等你的好消息。";
			close;
		}
		mes "[Garim Springfield]";
		mes "你在做什么？快去快回。";
		close;
	case 1:
		mes "[Garim Springfield]";
		mes "咦？你真的去过尼福尔海姆深处的宴会厅？";
		mes "你活着回来了？";
		mes "好吧，告诉我你的经历。";
		next;
		mes "[Garim Springfield]";
		mes "嗯嗯……原来如此！";
		mes "有了这些准备，我以后去那里就不害怕了！";
		next;
		mes "[Garim Springfield]";
		mes "研究将永远持续下去……！";
		completequest 8640;
		close;
	case 2:
		mes "[Garim Springfield]";
		mes "感觉就算死后也能继续研究，所以心情好多了。";
		close;
	}
	end;

OnInit:
	questinfo( QTYPE_QUEST2, QMARK_YELLOW, "BaseLevel >= 200 && isbegin_quest(8639) == 0 && isbegin_quest(8640) == 0" );
	questinfo( QTYPE_QUEST2, QMARK_YELLOW, "isbegin_quest(8640) == 1" );
	end;
}

niflheim,164,102,3	script	Tired looking dead#lv20	4_F_NFDEADMGCIAN,{
	switch( isbegin_quest(8640) ) {
	case 0:
		switch( isbegin_quest(8639) ) {
		case 0:
			mes "[疲惫的亡者]";
			mes "哈啊……";
			mes "我睡不着。";
			mes "都已经死了，怎么还会因为睡不着而烦恼？";
			mes "睡一觉吧……";
			mes "吵得我都要死了。";
			close;
		case 1:
			mes "[疲惫的亡者]";
			mes "哈啊……";
			mes "咦？什么？我不和小贩打交道。";
			next;
			if (select( "你的脸色很差", "安静地回去" ) == 2) {
			mes "[疲惫的亡者]";
				mes "哦，我本来想问你有没有安眠药……但我已经死了……你听不见我……嗯。";
				close;
			}
			mes "[疲惫的亡者]";
			mes "呃，你怎么知道？";
			mes "我的脸色一定很差……";
			mes "你有安眠药吗？";
			next;
			select("我不是瘾君子" );
			mes "[疲惫的亡者]";
			mes "啊……对不起，是我误会了。来到这里的人不是奇怪的小鬼，就是卖药的人，所以我把他们都赶走了。";
			next;
			mes "[疲惫的亡者]";
			mes "对了……你怎么知道我很累？我的脸色真的那么差吗？";
			next;
			mes "[疲惫的亡者]";
			mes "其实我死了一段时间了，但最近才来到尼福尔海姆。所以决定在这所房子里睡觉……";
			mes "但隔壁太吵，我晚上睡不着。";
			next;
			mes "[疲惫的亡者]";
			mes "不，是明明已经死了，却因为隔壁太吵而睡不着的痛苦……";
			mes "哦，不是隔壁。他们全都逃走了。";
			mes "这里这么便宜是有原因的……";
			next;
			mes "[疲惫的亡者]";
			mes "是的，就在<NAVI>[那里]<INFO>niflheim,148,124,0,101,0</INFO></NAVI>。";
			mes "那里的村民都疯了……他们每天都举办宴会。";
			next;
			mes "[疲惫的亡者]";
			mes "我每天都在那里，每天！！";
			next;
			mes "[疲惫的亡者]";
			mes "哈……我知道，就算每天举办，也有固定时间。";
			mes "对了……你活着时如果是个按时回家的人，死后也会这样做吗？";
			next;
			mes "[疲惫的亡者]";
			mes "我……已经死了，所以只想安静地睡觉……";
			mes "希望宴会结束后，他们能恢复理智。";
			next;
			select( "宴会是……" );
			mes "[疲惫的亡者]";
			mes "是啊……你看起来很强，而且那里有酒……他们已经死了，所以这是魔法。";
			mes "如果你能用魔法让那些醉鬼整晚安静下来，我会奖励你。";
			mes "当然，是每天都要。";
			next;
			mes "[Milla]";
			mes "我是米拉，现在是尼福尔海姆的居民。";
			mes "亲爱的，请帮我睡个好觉。";
			erasequest 8639;
			setquest 8640;
			close;
		case 2:
			end;
		}
		end;
	case 1:
	case 2:
		mes "[Milla]";
		mes "是的，谢谢你回来。";
		mes "哈啊……";
		mes "为了我和邻居们……为了一个好觉。";
		next;
		if (select( "听取请求。", "拒绝。" ) == 2) {
			mes "[Milla]";
			mes "如果你很忙，就不用做了……";
			mes "啊，毕竟活人听不见那个声音。这是只有死者才知道的痛苦……";
			npctalk "另一名死者：太吵了！睡觉去！", "#lv200althema", bc_self;
			npctalk "另一名死者：他真的睡不着！", "#lv200althema2", bc_self;
			close;
		}
		mes "[Milla]";
		mes "亲爱的活人，谢谢你的慈悲。";
		mes "那里有宴会厅和歌剧院，是豪华的设施，但每个地方都有些不同。";
		mes "我会根据你的善意请求相应的帮助……";
		next;
		switch( select( "他看起来很可爱", "那不是乐器", "弹钢琴", "头发凌乱的人", "带玩偶的人", "叫醒他们", "停止" ) ) {

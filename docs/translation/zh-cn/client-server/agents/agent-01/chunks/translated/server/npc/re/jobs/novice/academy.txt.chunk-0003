							next;
							emotion ET_SURPRISE, getnpcid(0, "Information Staff#"+strnpcinfo(2));
							mes "[信息工作人员]";
							mes "你说得对。";
							mes "准备是成功的关键。";
							mes "如果^4d4dff需要地点信息，请来问我。^000000";
							next;
							mes "[信息工作人员]";
							mes "亨的情报也是有限的。";
							close;
						}
					}
				}
			} else {
				if (!isbegin_quest(4269)) {
					mes "[亨]";
					mes "是你啊……";
					mes "你接下来打算做什么？找到住处了吗？";
					next;
					switch(select("我需要帮助", "什么都可以。", "别担心。")) {
					case 1:
						mes "[亨]";
						mes "不过话说回来，独自在新地方生活很辛苦。";
						mes "所以才有克里阿图拉学院。";
						next;
						mes "[亨]";
						mes "卡洛克大概也是因为这个原因才让你来找我。";
						mes "虽然我只是这里的帮工，但可以带你四处看看。";
						next;
						mes "[亨]";
						mes "沿着这条路向北走，你就能看到";
						mes "<NAVI>[学院建筑]<INFO>iz_ac01,100,39</INFO></NAVI>。";
						mes "任何人都能报名，别错过机会。";
						next;
						emotion ET_SURPRISE, getnpcid(0, "Information Staff#"+strnpcinfo(2));
						mes "[信息工作人员]";
						mes "抱歉打断一下。";
						mes "如果^4d4dff需要地点信息，请来问我。^000000";
						next;
						mes "[信息工作人员]";
						mes "亨的情报也是有限的。";
						close;
					case 2:
						mes "[亨]";
						mes "你真乐观。如果需要帮助，随时可以去克里阿图拉学院。";
						next;
						mes "[亨]";
						mes "报名没有任何要求，也不收费，对你会很有帮助。";
						mes "沿这条路向北走，你会找到";
						mes "<NAVI>[学院建筑]<INFO>iz_ac01,100,39</INFO></NAVI>。";
						next;
						mes "[亨]";
						mes "如果有更多像你这样的冒险者，未来会更加光明。哈哈哈哈。";
						next;
						emotion ET_SURPRISE, getnpcid(0, "Information Staff#"+strnpcinfo(2));
						mes "[信息工作人员]";
						mes "抱歉打断一下。";
						mes "如果^4d4dff需要地点信息，请来问我。^000000";
						next;
						mes "[信息工作人员]";
						mes "亨的情报也是有限的。";
						close;
					case 3:
					mes "[亨]";
					mes "你已经制定好计划了？准备得很充分。";
					mes "不过如果你对克里阿图拉学院感兴趣，还是去看看吧。";
						next;
					mes "[亨]";
					mes "沿这条路向北走，你会找到<NAVI>[学院建筑]<INFO>iz_ac01,100,39</INFO></NAVI>。";
					mes "顺其自然，不是吗？";
						next;
						emotion ET_SURPRISE, getnpcid(0, "Information Staff#"+strnpcinfo(2));
					mes "[信息工作人员]";
					mes "你说得对。准备是成功的关键。";
					mes "如果^4d4dff需要地点信息，请来问我。^000000";
						next;
					mes "[信息工作人员]";
					mes "亨的情报也是有限的。";
						close;
					}
				} else {
					mes "[亨]";
					mes "克里阿图拉学院是为未来积累经验的好地方。";
					mes "我不是因为在这里工作才这么说。";
					next;
					mes "[亨]";
					mes "真的……哈哈哈哈。";
					close;
				}
			}
		}
	} else {
		mes "[亨]";
		mes "皇家克里阿图拉学院成立的目的，是帮助初出茅庐的冒险者踏上最初的旅程。";
		next;
		mes "[亨]";
		mes "虽然我只是这里的帮工，但看到学生毕业并成为优秀的社会成员，我很高兴。";
		close;
	}

OnInit:
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "Class == Job_Novice && BaseLevel <= 14 && !isbegin_quest(7473)" );
	end;

OnTouch:
	if (!isbegin_quest(4269))
		emotion ET_SURPRISE;
	else
		emotion ET_SMILE;
	end;
}

izlude_a,122,207,3	duplicate(Criatura Academy Staff#0)	Criatura Academy Staff#a	4_M_KHKYEL,3,3
izlude_b,122,207,3	duplicate(Criatura Academy Staff#0)	Criatura Academy Staff#b	4_M_KHKYEL,3,3
izlude_c,122,207,3	duplicate(Criatura Academy Staff#0)	Criatura Academy Staff#c	4_M_KHKYEL,3,3
izlude_d,122,207,3	duplicate(Criatura Academy Staff#0)	Criatura Academy Staff#d	4_M_KHKYEL,3,3

// - Information Staff
// - Teaches the player about the Mini-Map through a quick quest.
// -----------------------------------------------------------------------------
izlude,120,207,4	script	Information Staff#0	8W_SOLDIER,{
	if (!checkweight(1304,3)) {
		mes "由于库存已满，任务无法继续。";
		mes "整理物品后请再试一次。";
		close;
	}

	if (BaseLevel < 15 && !isbegin_quest(7474)) {
		mes "[信息工作人员]";
		mes "你好，你好吗？";
		mes "我负责伊斯鲁德重要地点的导航指引。";
		mes "我想在提供导航的同时玩个小游戏，可以吗？";
		next;
		if (select("好，我们玩吧！", "我全都知道了。") == 1) {
			mes "[信息工作人员]";
			mes "首先，来看看如何查看小地图。";
			mes "你可以通过画面右上角的小地图确认自己的位置。";
			next;
			mes "[信息工作人员]";
			mes "如果获得城镇或城市的信息，地图上会标记一个^4d4dff+^000000路标。";
			next;
			mes "[信息工作人员]";
			mes "按键盘上的^4d4dff[Ctrl]和[~]可以查看世界地图^000000。";
			next;
			mes "[信息工作人员]";
			mes "通过^4d4dff世界地图可以查看你和队员的位置，以及区域内魔物的等级。^000000";
			next;
			mes "[信息工作人员]";
			mes "记住这些有用的信息。现在，要玩个小游戏吗？";
			next;
			mes "[信息工作人员]";
			mes "我会在小地图上^4d4dff标记三个特定地点。^000000";
			mes "请以路标为参考，^4d4dff访问这些地点^000000。";
			next;
			mes "[信息工作人员]";
			mes "把它当作寻宝游戏去吧。我在那里藏了一些有用物品。";
			viewpoint 1,179,75,1,0xCCFFFF;
			viewpoint 1,45,94,2,0x00FF00;
			viewpoint 1,207,167,3,0xFFEB46;
			setquest 7474;
			next;
			mes "[信息工作人员]";
			mes "走过三个地点后再来找我，我会确认结果。";
			next;
			mes "[信息工作人员]";
			mes "啊，有人比你先出发了！如果不快点，物品会被那个人全部拿走！";
			mes "快跑！";
			npcskill "AL_INCAGI", 10, 10, 10;
			close;
		}
		mes "[信息工作人员]";
		mes "你需要伊斯鲁德所有地点的信息吗？";
		mes "点击介绍的^B9062F[营地名称]^000000，我会为你指引，请跟随^B9062F红色箭头^000000。";
		next;
		while(1) {
			switch(select("[主要设施]", "[指南与帮助]", "移除小地图标记", "结束对话")) {
			case 1:
				while (1) {
					switch(select("[克里阿图拉学院]", "[码头]", "[国际飞艇]", "[竞技场]", "[商店]", "[剑士公会]", "[附魔协会]", "[铁匠工坊]", "返回上一级菜单")) {
					case 1:
						mes "[信息工作人员]";
						mes "如果你是第一次冒险，<NAVI>[克里阿图拉学院]<INFO>iz_ac01,100,39,</INFO></NAVI>能提供很多信息和帮助。";
						mes "需要进一步指引吗？";
						viewpoint 1, 128, 260, 0, 0xFFD269;
						next;
						continue;
					case 2:
						mes "[信息工作人员]";
						mes "从东北方的<NAVI>[码头]<INFO>izlude,197,205,</INFO></NAVI>可以前往^8B4513艾尔贝塔^000000或^8B4513巴亚兰岛^000000。";
						next;
						mes "[信息工作人员]";
						mes "巴亚兰岛是个可怕的地方，里面有^8B4513依斯鲁德地下城^000000。需要进一步指引吗？";
						viewpoint 1, 197, 205, 1, 0xFFFF00;
						next;
						continue;
					case 3:
						mes "[信息工作人员]";
						mes "东南方的<NAVI>[飞艇]<INFO>izlude,206,75,</INFO></NAVI>连接施瓦茨瓦尔德共和国首都^8B4513朱诺^000000，";
						mes "以及阿鲁纳佩尔兹王国首都^8B4513拉赫^000000。需要进一步指引吗？";
						viewpoint 1, 210, 73, 2, 0xFF0A82;
						next;
						continue;
					case 4:
						mes "[信息工作人员]";
						mes "东边的<NAVI>[竞技场]<INFO>izlude,213,161,</INFO></NAVI>用于测试战斗能力。";
						mes "这是个很棒的地方，我会在小地图上标记位置。需要进一步指引吗？";
						viewpoint 1, 213, 161, 3, 0xFFFF54;
						next;
						continue;
					case 5:
						mes "[信息工作人员]";
			mes "我会在小地图上标记<NAVI>[商店]<INFO>izlude,110,182,</INFO></NAVI>的位置。";
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
						mes "需要进一步指引吗？";
						viewpoint 1, 108, 179, 4, 0xFFAAFF;
						next;
						continue;
					case 6:
						mes "[信息工作人员]";
						mes "<NAVI>[剑士公会]<INFO>izlude,51,172,</INFO></NAVI>负责剑士转职。";
						mes "我会在小地图上标记剑士公会的位置。需要进一步指引吗？";
						viewpoint 1, 52, 172, 5, 0xFFDA70;
						next;
						continue;
					case 7:
						mes "[信息工作人员]";
						mes "我会在小地图上标记<NAVI>[附魔协会]<INFO>izlude,97,125,</INFO></NAVI>的位置。";
						mes "需要进一步指引吗？";
						viewpoint 1, 97, 125, 6, 0xFFDA70;
						next;
						continue;
					case 8:
						mes "[信息工作人员]";
						mes "我会在小地图上标记<NAVI>[铁匠工坊]<INFO>izlude,153,126,</INFO></NAVI>的位置。";
						mes "需要进一步指引吗？";
						viewpoint 1, 153, 126, 7, 0xFFAAFF;
						next;
						continue;
					case 9:
						break;
					}
					break;
				}
				break;
			case 2:
				while (1) {
					switch(select("[伊甸园传送员]", "[卡普拉员工]", "[催眠师]", "[婚礼秘书]", "[佣兵公会官员]", "[驯兽商人]", "返回上一级菜单")) {
					case 1:
						mes "[信息工作人员]";
						mes "我会在小地图上标记<NAVI>[伊甸园传送员]<INFO>izlude,131,148,</INFO></NAVI>的位置。";
						mes "需要进一步指引吗？";
						viewpoint 1, 131, 148, 8, 0xFF0A82;
						next;
						continue;
					case 2:
						mes "[信息工作人员]";
						mes "我会在小地图上标记<NAVI>[卡普拉员工]<INFO>izlude,128,148,</INFO></NAVI>的位置。";
						mes "需要进一步指引吗？";
						viewpoint 1, 128, 148, 9, 0xFFFF54;
						next;
						continue;
					case 3:
						mes "[信息工作人员]";
						mes "我会在小地图上标记<NAVI>[催眠师]<INFO>izlude,124,127,</INFO></NAVI>的位置。";
						mes "需要进一步指引吗？";
						viewpoint 1, 125, 127, 10, 0xFF0064;
						next;
						continue;
					case 4:
						mes "[信息工作人员]";
						mes "如果想去情侣度假地^8B4513爪哇伊^000000，";
						mes "请和<NAVI>[婚礼秘书]<INFO>izlude,180,224,</INFO></NAVI>交谈。";
						mes "问她相关问题即可。需要进一步指引吗？";
						viewpoint 1, 180, 224, 11, 0xFFFF00;
						next;
						continue;
					case 5:
						mes "[信息工作人员]";
						mes "如果想了解佣兵公会，向西走并和<NAVI>[佣兵公会官员]<INFO>izlude,47,170,</INFO></NAVI>交谈。";
						mes "需要进一步指引吗？";
						viewpoint 1, 47, 170, 12, 0xFFDA70;
						next;
						continue;
					case 6:
						mes "[信息工作人员]";
						mes "我会在小地图上标记<NAVI>[驯兽商人]<INFO>izlude,118,163,</INFO></NAVI>的位置。";
						mes "需要进一步指引吗？";
						viewpoint 1, 118, 163, 13, 0xFF0064;
						next;
						continue;
					case 7:
						break;
					}
					break;
				}
				break;
			case 3:
				mes "[信息工作人员]";
				mes "我会清除标记。需要进一步指引吗？";
				viewpoint 2, 197, 205, 1, 0xFF0000;
				viewpoint 2, 210, 73, 2, 0xFF0000;
				viewpoint 2, 213, 161, 3, 0xFF0000;
				viewpoint 2, 108, 179, 4, 0xFF0000;
				viewpoint 2, 52, 172, 5, 0xFF0000;
				viewpoint 2, 97, 125, 6, 0xFF0000;
				viewpoint 2, 153, 126, 7, 0xFF0000;
				viewpoint 2, 131, 148, 8, 0xFF0000;
				viewpoint 2, 128, 148, 9, 0xFF0000;
				viewpoint 2, 125, 127, 10, 0xFF0000;
				viewpoint 2, 180, 224, 11, 0xFF0000;
				viewpoint 2, 47, 170, 12, 0xFF0000;
				viewpoint 2, 118, 163, 13, 0xFF0000;
				next;
				break;
			case 4:
				mes "[信息工作人员]";
				mes "祝你冒险愉快。再见~~！";
				close;
			}
		}
	} else if (isbegin_quest(7474) == 1) {
		if ((isbegin_quest(7475) + isbegin_quest(7476) + isbegin_quest(7477)) > 2) {
			mes "[信息工作人员]";
			mes "怎么愁眉苦脸的？看起来你找到了我标记的所有地点。";
			next;
			mes "[卢敏]";
			mes "乌龟……";
			cutin "nov_lumin01.bmp", 2;
			next;
			select("你叫我什么？");
			mes "[卢敏]";
			mes "因为你太慢了。";
			mes "没错。我感觉自己等了你一辈子。";
			next;
			mes "[卢敏]";
			mes "……要不要我和你分享？";
			cutin "nov_lumin03.bmp", 2;
			next;
			if (select("我不需要你的同情。", "！！！") == 1) {
				mes "[卢敏]";
				mes "是吗？船长总是告诉我要帮助可怜的人。";
				mes "但你让我失去了帮助你的机会。";
				cutin "nov_lumin02.bmp", 2;
				next;
				mes "[卢敏]";
				mes "啊，真烦人。";
				next;
			} else {
				mes "[卢敏]";
				mes "那么现在七三分？我接受四六分。";
				cutin "nov_lumin02.bmp", 2;
				next;
				mes "[" + strcharinfo(0) + "]";
			mes "这家伙……";
				next;
			}
			cutin "", 255;
			mes "[信息工作人员]";
			mes "啊，你们两个冷静。卢敏把它们全拿走了。";
			mes ""+ strcharinfo(0) + "，我会另外给你一套。";
			next;
			mes "[信息工作人员]";
			mes "想想原因吧，是我犯错了，本来只该留下一人的物品，却把你们两人的都留下了。";
			next;
			cutin "nov_lumin03.bmp", 2;
			mes "[卢敏]";
			mes "简单又公平的决定。好了，我走了。朋友，回头见。";
			next;
			cutin "", 255;
			mes "[信息工作人员]";
			mes "你们两个不是朋友吗？";
			mes "看起来你们相处得很友好，对吧？";
			next;
			mes "[信息工作人员]";
			mes "这是我送给你们的礼物。希望能派上用场。";
			completequest 7474;
			erasequest 7475;
			erasequest 7476;
			erasequest 7477;
			getexp 300,20;
			getitem 12323,20;// N_Fly_Wing
			getitem 12324,10;// N_Butterfly_Wing
			getitem 569,20;// Novice_Potion
			next;
			mes "[信息工作人员]";
			mes "祝你旅途愉快。";
			close;
		} else {
			mes "[信息工作人员]";
			mes "你还没有找到我藏的宝藏。";
			mes "这是地点列表，再看一遍。快点！";
			viewpoint 1,179,75,1,0xccffff;
			viewpoint 1,45,94,2,0x00ff00;
			viewpoint 1,207,167,3,0xFFEB46;
			close;
		}
	} else {
		mes "[信息工作人员]";
		mes "这里是依斯鲁德——普隆德拉的卫星城。需要指引吗？";
		next;
		mes "[信息工作人员]";
		mes "点击^B9062F[区域名称]^000000后，我可以为你^B9062F导航^000000一条可跟随的路线。";
		next;
		while(1) {
			switch(select("[主要设施]", "[指南与帮助]", "移除小地图标记", "结束对话")) {
			case 1:
				while (1) {
					switch(select("[克里阿图拉学院]:[码头]:[国际飞艇]:[竞技场]:[商店]:[剑士公会]:[附魔协会]:[铁匠工坊]:返回上一级菜单")) {
					case 1:
						mes "[信息工作人员]";
						mes "如果你是第一次冒险，<NAVI>[克里阿图拉学院]<INFO>iz_ac01,100,39,</INFO></NAVI>能提供很多信息和帮助。";
						mes "需要进一步指引吗？";
						viewpoint 1, 128, 260, 0, 0xFFD269;
						next;
						continue;
					case 2:
						mes "[信息工作人员]";
						mes "从东北方的<NAVI>[码头]<INFO>izlude,197,205,</INFO></NAVI>可以前往^8B4513艾尔贝塔^000000或^8B4513巴亚兰岛^000000。";
						next;
						mes "[信息工作人员]";
						mes "巴亚兰岛是个可怕的地方，里面有^8B4513依斯鲁德地下城^000000。需要进一步指引吗？";
						viewpoint 1, 197, 205, 1, 0xFFFF00;
						next;
						continue;
					case 3:
						mes "[信息工作人员]";
						mes "东南方的<NAVI>[飞艇]<INFO>izlude,206,75,</INFO></NAVI>连接施瓦茨瓦尔德共和国首都^8B4513朱诺^000000，";
						mes "以及阿鲁纳佩尔兹王国首都^8B4513拉赫^000000。需要进一步指引吗？";
						viewpoint 1, 210, 73, 2, 0xFF0A82;
						next;
						continue;
					case 4:
						mes "[信息工作人员]";
						mes "东边的<NAVI>[竞技场]<INFO>izlude,213,161,</INFO></NAVI>用于测试战斗能力。";
						mes "这是个很棒的地方，我会在小地图上标记位置。需要进一步指引吗？";
						viewpoint 1, 213, 161, 3, 0xFFFF54;
						next;
						continue;
					case 5:
						mes "[信息工作人员]";
						mes "我会在小地图上标记<NAVI>[商店]<INFO>izlude,110,182,</INFO></NAVI>的位置。";

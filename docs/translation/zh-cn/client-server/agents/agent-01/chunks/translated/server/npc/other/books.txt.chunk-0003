				mes "2. 达斯提尼斯";
				mes "这种飞行怪物的回避率很高，";
				mes "如果你的攻击命中率很低，";
				mes "你可能应该";
				mes "不要招惹它。";
				mes "^0099FF掉落物品^000000： Moth Dust, Moth Wing,";
				mes "昆虫触角、红色药草";
				next;
				mes "^FF0000[格芬地下城 2F 怪物]^000000";
				mes "3. 毒魔菇";
				mes "黑帽蘑菇。它会攻击";
				mes "害怕被吃掉的冒险者，";
				mes "尽管有毒且并不";
				mes "美味。";
				mes "^0099FF掉落物品^000000： Spore, 绿色药草";
				next;
				mes "^FF0000[格芬地下城 2F 怪物]^000000";
				mes "4. 阿格斯";
				mes "巨大的蜘蛛，一见到冒险者";
				mes "就会攻击。它太大了，";
				mes "冒险者无法用脚";
				mes "踩扁。";
				mes "^0099FF掉落物品^000000： Cobweb, Scell, Bug Leg,";
				mes "绿色药草, Yellow Herb";
				next;
				mes "^FF0000[格芬地下城 2F 怪物]^000000";
				mes "5. 低语";
				mes "一块会散发诡异气息的";
				mes "活布。有时它喜欢";
				mes "变得隐形……";
				mes "^0099FF掉落物品^000000： Fabric";
				next;
				mes "^FF0000[格芬地下城 2F 怪物]^000000";
				mes "6. 杰克";
				mes "一个可怕的南瓜头怪物，";
				mes "穿着时髦的正式服装。";
				mes "据说它过去曾在万圣节前夜";
				mes "入侵普隆德拉。";
				mes "过去。";
				mes "^0099FF掉落物品^000000： Jack'o'Pumpkin, Zargon";
				next;
				break;
			case 3:
				mes "^FF0000[格芬地下城 3F 怪物]^000000";
				mes "1. 阿格斯";
				mes "巨大的蜘蛛，一见到冒险者";
				mes "就会攻击。它太大了，";
				mes "冒险者无法用脚";
				mes "踩扁。";
				mes "^0099FF掉落物品^000000： Cobweb, Scell, Bug Leg,";
				mes "绿色药草, Yellow Herb";
				next;
				mes "^FF0000[格芬地下城 3F 怪物]^000000";
				mes "2. 低语";
				mes "一块会散发诡异气息的活布。";
				mes "有时它喜欢";
				mes "变得隐形……";
				mes "^0099FF掉落物品^000000： Fabric";
				next;
				mes "^FF0000[格芬地下城 3F 怪物]^000000";
				mes "3. 杰克";
				mes "一个可怕的南瓜头怪物，";
				mes "穿着时髦的正式服装。";
				mes "据说它过去曾在万圣节前夜";
				mes "入侵普隆德拉。";
				mes "过去。";
				mes "^0099FF掉落物品^000000： Jack'o'Pumpkin, Zargon";
				next;
				mes "^FF0000[格芬地下城 3F 怪物]^000000";
				mes "4. 迷雾";
				mes "由雾组成的奇怪怪物，";
				mes "附着在幽灵";
				mes "窗上。";
				mes "^0099FF掉落物品^000000： Trunk, Gas Mask";
				next;
				mes "^FF0000[格芬地下城 3F 怪物]^000000";
				mes "5. 木偶娃娃";
				mes "一个重生为诅咒玩偶的怪物，";
				mes "被绑在系于";
				mes "木棍上的丝线上。";
				mes "^0099FF掉落物品^000000： Golden Hair, Trunk";

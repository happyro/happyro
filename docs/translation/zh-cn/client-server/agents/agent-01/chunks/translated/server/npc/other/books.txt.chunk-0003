				mes "^0099FF这里到处都是^000000";
				mes "^0099FF波利贴纸^000000";
				mes "^0099FF贴满这些页面！^000000";
				next;
				mes "^0099FF看来你必须自己学习^000000";
				mes "^0099FF关于小型毒属性怪物的知识^000000";
				mes "^0099FF。^000000";
				next;
				break;
			case 2:
				mes "^FF0000[第 23 卷：中型毒属性怪物]^000000";
				mes "1. 波波利";
				mes "浅绿色、具有";
				mes "毒属性的波利。比波利强得多，";
				mes "但仍靠弹跳";
				mes "移动。";
				mes "^0099FF掉落物品^000000： Sticky Mucus, Garlet,";
				mes "绿色药草";
				next;
				mes "^FF0000[第 23 卷：中型毒属性怪物]^000000";
				mes "2. 毒魔菇";
				mes "一种黑帽蘑菇。它害怕被吃掉，";
				mes "便攻击冒险者，";
				mes "尽管自己有毒，";
				mes "而且并不好吃。";
				mes "^0099FF掉落物品^000000： Spore, 绿色药草";
				next;
				mes "^FF0000[第 23 卷：中型毒属性怪物]^000000";
				mes "3. 第二代哥布灵";
				mes "一种小型狼状怪物，";
				mes "聪明到足以使用武器。";
				mes "不过要小心，它虽小却很凶猛，";
				mes "可别低估它。";
				mes "^0099FF掉落物品^000000： Blue Hair, Zargon,";
				mes "黄色药草";
				next;
				mes "^FF0000[第 23 卷：中型毒属性怪物]^000000";
				mes "4. 侧蛇";
				mes "一种讨厌人类的深色蛇，";
				mes "要小心，并在它毒伤你之前";
				mes "将它击杀。";
				mes "^0099FF掉落物品^000000： Shining Scale, Zargon,";
				mes "毒犬牙、蛇鳞";
				next;
				break;
			case 3:
				mes "^FF0000[第 24 卷：大型毒属性怪物]^000000";
				mes "1. 阿格斯";
				mes "巨大的蜘蛛，一见到冒险者";
				mes "就会攻击。它太大了，";
				mes "冒险者无法用脚";
				mes "踩扁。";
				mes "^0099FF掉落物品^000000： Cobweb, Scell, Bug Leg,";
				mes "绿色药草, Yellow Herb";
				next;
				mes "^FF0000[第 24 卷：大型毒属性怪物]^000000";
				mes "2. 阿格利欧佩";
				mes "分节的蜈蚣类怪物";
				mes "会用毒素攻击";
				mes "路人。";
				mes "^0099FF掉落物品^000000： Bug Leg, Zargon, Green";
				mes "药草";
				next;
				mes "^FF0000[第 24 卷：大型毒属性怪物]^000000";
				mes "3. 迷雾";
				mes "由雾组成的奇怪怪物，";
				mes "附着在幽灵";
				mes "窗上。";
				mes "^0099FF掉落物品^000000： Trunk, Gas Mask";
				next;
				break;
			case 4:
				close;
			}
		}

	case 3:
		while(1) {
			switch(select("小型怪物:中型怪物:大型怪物:取消")) {
			case 1:
				mes "^FF0000[第 25 卷：小型不死属性怪物]^000000";
				mes "^0099FF...^000000";
				next;
				mes "^FF0000[第 25 卷：小型不死属性怪物]^000000";
				mes "^0099FF...^000000";
				mes "^0099FF......^000000";
				next;
				mes "^0099FF...!^000000";
				mes "^0099FF某个笨小孩在本章^000000";
				mes "^0099FF到处乱画！看来你得^000000";
				mes "^0099FF自己学习有关^000000";
				mes "^0099FF小型不死属性怪物的知识，^000000";
				mes "^0099FF不能依靠别人。^000000";
				next;
				break;
			case 2:
				mes "^FF0000[第 26 卷：中型不死属性怪物]^000000";
				mes "1. 僵尸";
				mes "一个无辜的人类，";
				mes "被黑魔法从死亡中复活。";
				mes "由黑暗魔法唤回人间。";
				mes "^0099FF掉落物品^000000： Decayed Nail, Sticky";
				mes "黏液、恐怖嘴";
				next;
				mes "^FF0000[第 26 卷：中型不死属性怪物]^000000";
				mes "2. 巨齿鲨";
				mes "一具会活动的鱼类骸骨，";
				mes "在海上游荡。虽然看起来可怕，";
				mes "其实并不危险。";
				mes "^0099FF掉落物品^000000： Stinky Scale,";
				mes "骷髅骨";
				next;
				mes "^FF0000[第 26 卷：中型不死属性怪物]^000000";
				mes "3. 兽人僵尸";
				mes "从死亡中复活的兽人。";
				mes "兽人战士高尚的战斗精神";
				mes "永远不会消逝！";
				mes "^0099FF掉落物品^000000： Orc Claw, Sticky Mucus";
				next;
				mes "^FF0000[第 26 卷：中型不死属性怪物]^000000";
				mes "4. 海盗骷髅";
				mes "一个没穿上衣的海盗骷髅，";
				mes "穿着紫色袜子蹦来蹦去。";
				mes "七海的灾祸。";
				mes "^0099FF掉落物品^000000： Skel-Bone";
				next;
				mes "^FF0000[第 26 卷：中型不死属性怪物]^000000";
				mes "5. 兽人骷髅";
				mes "兽人的骸骨，";
				mes "被重新带回生命。即使死亡后，";
				mes "兽人仍会继续战斗。";
				mes "^0099FF掉落物品^000000： Orc's Fang, Green";
				mes "药草";
				next;
				mes "^FF0000[第 26 卷：中型不死属性怪物]^000000";
				mes "6. 骷髅士兵";
				mes "一名同时挥舞两把剑的骷髅士兵。";
				mes "他活着时一定是个";
				mes "很厉害的家伙。";
				mes "^0099FF掉落物品^000000： Skel-Bone, Red Herb";
				next;
				mes "^FF0000[第 26 卷：中型不死属性怪物]^000000";
				mes "7. 木乃伊少女";
				mes "一具美丽的僵尸，";
				mes "似乎与邦古有某种联系。";
				mes "^0099FF掉落物品^000000： Daenggie, Munak Turban";
				next;
				mes "^FF0000[第 26 卷：中型不死属性怪物]^000000";
				mes "8. 骷髅矿工";
				mes "一名矿工的骸骨，";
				mes "死去时还没拿到";
				mes "遣散费便被复活。";
				mes "^0099FF掉落物品^000000： Iron, Lantern";
				next;
				mes "^FF0000[第 26 卷：中型不死属性怪物]^000000";
				mes "9. 弓箭手骷髅";
				mes "尽管没有真正的眼睛，";
				mes "弓箭手骷髅的准头却很好。";
				mes "^0099FF掉落物品^000000： Skel-Bone, Fire Arrow,";
				mes "红色药草";
				next;
				mes "^FF0000[第 26 卷：中型不死属性怪物]^000000";
				mes "10. 木乃伊";
				mes "一具裹满绷带的行尸，";
				mes "它以前大概也曾";
				mes "美丽过。";
				mes "^0099FF掉落物品^000000： Rotten Bandage";
				next;
				mes "^FF0000[第 26 卷：中型不死属性怪物]^000000";
				mes "11. 维力";
				mes "一只会捡起地上";
				mes "所有掉落物的木乃伊狗。";
				mes "虽然它是僵尸，";
				mes "却似乎很高兴再次活着。";
				mes "^0099FF掉落物品^000000： Immortal Heart, Zargon";
				mes "腐烂绷带";
				next;
				mes "^FF0000[第 26 卷：中型不死属性怪物]^000000";
				mes "12. 食尸鬼";
				mes "类似僵尸，但食尸鬼是绿色的，";
				mes "而且强大得多。它的呕吐物";
				mes "不止一种意义上令人作呕。";
				mes "实在令人难以忍受。";
				mes "^0099FF掉落物品^000000： Horrendous Mouth";
				next;
				break;
			case 3:
				mes "^FF0000[第 27 卷：大型不死属性怪物]^000000";
				mes "1. 邪恶德鲁伊";
				mes "一个招摇的邪恶德鲁伊。它总是";
				mes "使用一本漂浮的魔法书，";
				mes "书中迸发能量，给冒险者";
				mes "带来痛苦。";
				mes "^0099FF掉落物品^000000： Amulet, White Herb";
				next;
				break;
			case 4:
				close;
			}
		}

	case 4:
		close;
	}
}

prt_in,172,96,4	script	Monster Encyclopedia#4pr	HIDDEN_NPC,{
	mes "^FF0000[地下城怪物图鉴]^000000";
	mes "这是一本介绍";
	mes "地下城中怪物的图鉴。";
	next;
	switch(select("蚂蚁地狱：格芬塔：斯芬克斯：取消")) {
	case 1:
		while(1) {
			switch(select("1F：2F：取消")) {
			case 1:
				mes "^FF0000[蚂蚁地狱 1F 怪物]^000000";
				mes "1. 蚂蚁卵";
				mes "只是一枚蚂蚁卵。它不会伤害";
				mes "你。";
				mes "^0099FF掉落物品^000000： Shell, Jellopy, Sticky";
				mes "黏液、空瓶";
				next;
				mes "^FF0000[蚂蚁地狱 1F 怪物]^000000";
				mes "2. 安德烈";
				mes "一只勤劳的工蚁，为了族群";
				mes "而生活。不过要小心，攻击一只";
				mes "就会和所有蚂蚁";
				mes "展开战斗。";
				mes "^0099FF掉落物品^000000： Worm Peeling, Garlet";
				mes "黏稠液体、贝壳";
				next;
				mes "^FF0000[蚂蚁地狱 1F 怪物]^000000";
				mes "3. 皮耶尔";
				mes "一只绿色工蚁，和安德烈一样";
				mes "勤劳地工作。";
				mes "^0099FF掉落物品^000000： Worm";
				mes "蚯蚓皮、加勒特、黏稠液体、贝壳";
				next;
				mes "^FF0000[蚂蚁地狱 1F 怪物]^000000";
				mes "4. 德尼罗";
				mes "红色工蚁，速度";
				mes "比皮耶尔和德尼罗更快。";
				mes "^0099FF掉落物品^000000： Worm Peeling, Garlet,";
				mes "黏稠液体、贝壳";
				next;
				mes "^FF0000[蚂蚁地狱 1F 怪物]^000000";
				mes "5. 维塔塔";
				mes "体内装满蜂蜜的工蚁……";
				mes "胖得甚至不会";
				mes "捡起任何东西。";
				mes "^0099FF掉落物品^000000： Worm Peeling, Scell";
				mes "蜂蜜";
				next;
				mes "^FF0000[蚂蚁地狱 1F 怪物]^000000";
				mes "6. 吉艾瑟";
				mes "一位在洞穴中游荡、";
				mes "收集矿石的年长小妖精。死后他";
				mes "计划把自己美丽的";
				mes "胡子留给这个世界。";
				mes "^0099FF掉落物品^000000： Old Pixie's Moustache";
				next;
				break;
			case 2:
				mes "^FF0000[蚂蚁地狱 2F 怪物]^000000";
				mes "1. 蚂蚁卵";
				mes "无法攻击，甚至";
				mes "无法感受疼痛的蚂蚁卵。";
				mes "^0099FF掉落物品^000000： Shell, Jellopy, Sticky";
				mes "黏液、空瓶";
				next;
				mes "^FF0000[蚂蚁地狱 2F 怪物]^000000";
				mes "2. 安德烈";
				mes "一种黄色工蚁，可能是族群中";
				mes "最慢的，维塔塔除外。";
				mes "它行动十分迟缓。";
				mes "^0099FF掉落物品^000000： Worm Peeling, Garlet,";
				mes "黏稠液体、贝壳";
				next;
				mes "^FF0000[蚂蚁地狱 2F 怪物]^000000";
				mes "3. 皮耶尔";
				mes "一种绿色工蚁，显然";
				mes "来自法国。";
				mes "^0099FF掉落物品^000000： Worm Peeling, Garlet,";
				mes "黏稠液体、贝壳";
				next;
				mes "^FF0000[蚂蚁地狱 2F 怪物]^000000";
				mes "4. 德尼罗";
				mes "工蚁中速度最快的，";
				mes "拥有醒目的红色外表。";
				mes "^0099FF掉落物品^000000： Worm Peeling, Garlet,";
				mes "黏稠液体、贝壳";
				next;
				mes "^FF0000[蚂蚁地狱 2F 怪物]^000000";
				mes "5. 维塔塔";
				mes "负责将蜂蜜储存在";
				mes "腹中的工蚁。";
				mes "^0099FF掉落物品^000000： Worm Peeling, Scell,";
				mes "蜂蜜";
				next;
				mes "^FF0000[蚂蚁地狱 2F 怪物]^000000";
				mes "6. 吉艾瑟";
				mes "一位在洞穴中游荡、收集矿石的";
				mes "年长小妖精。几乎像矮人，";
				mes "但又不完全是。";
				mes "^0099FF掉落物品^000000： Old Pixie's Moustache";
				next;
				mes "^FF0000[蚂蚁地狱 2F 怪物]^000000";
				mes "7. 步瑞翁";
				mes "一个极其强大的家伙，";
				mes "身体有百分之四十是舌头。";
				mes "^0099FF掉落物品^000000： Tongue, Ant Jaw";
				next;
				break;
			case 3:
				close;
			}
		}

	case 2:
		while(1) {
			switch(select("1F：2F：3F：4F：取消")) {
			case 1:
				mes "^FF0000[格芬地下城 1F 怪物]^000000";

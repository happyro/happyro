				mes "还会追逐路人。";
				mes "^0099FF掉落物品^000000：蝙蝠之牙、苍蝇翅膀、";
				mes "葡萄、红色药草";
				next;
				mes "^FF0000[格芬地下城 1F 怪物]^000000";
				mes "2. 波波利";
				mes "浅绿色、具有";
				mes "毒属性的波利。比波利强得多，";
				mes "但仍靠弹跳";
				mes "移动。";
				mes "^0099FF掉落物品^000000： Sticky Mucus, Garlet";
				mes "绿色药草";
				next;
				mes "^FF0000[格芬地下城 1F 怪物]^000000";
				mes "3. 达斯提尼斯";
				mes "这种飞行怪物的回避率很高，";
				mes "如果你的攻击命中率很低，";
				mes "你可能应该";
				mes "不要招惹它。";
				mes "^0099FF掉落物品^000000： Moth Dust, Moth Wing,";
				mes "昆虫触角、红色药草";
				next;
				mes "^FF0000[格芬地下城 1F 怪物]^000000";
				mes "4. 毒魔菇";
				mes "黑帽蘑菇。它会攻击";
				mes "害怕被吃掉的冒险者，";
				mes "尽管有毒且并不";
				mes "美味。";
				mes "^0099FF掉落物品^000000： Spore, 绿色药草";
				next;
				break;
			case 2:
				mes "^FF0000[格芬地下城 2F 怪物]^000000";
				mes "1. 蝙蝠";
				mes "一种不太强的灰色蝙蝠，";
				mes "但它会快速而持续地攻击，";
				mes "因此非常烦人，";
				mes "还会追逐路人。";
				mes "^0099FF掉落物品^000000：蝙蝠之牙、苍蝇翅膀、";

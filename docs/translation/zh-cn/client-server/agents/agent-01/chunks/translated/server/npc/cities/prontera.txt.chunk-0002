		mes "[Tailor Ginedin Rephere]";
		mes "我认为对人类来说，衣服是展现个性、风格和美丽的少数方式之一。";
		next;
		mes "[Tailor Ginedin Rephere]";
		mes "因此我觉得自己的工作很有用，也很时髦。这本身就值得一切努力。粗布和粗皮染色后会焕发活力与生命……";
		next;
		mes "[Tailor Ginedin Rephere]";
		mes "过程艰苦又乏味，但衣服完成时的幸福和喜悦足以弥补所有辛劳。";
		close;
	case 2:
		mes "[Tailor Ginedin Rephere]";
		mes "啊……！";
		mes "你也是来给衣服";
		mes "染色的吗？";
		next;
		mes "[Tailor Ginedin Rephere]";
		mes "但是……真的很抱歉。";
		mes "我现在没时间给你的衣服染色，还有很多订单等着处理。";
		next;
		mes "[Tailor Ginedin Rephere]";
		mes "给你添麻烦了，下次再来可以吗？";
		close;
	case 3:
		mes "[Tailor Ginedin Rephere]";
		mes "请慢慢来，在这里放松一下。不过很抱歉没什么可以招待你的。";
		close;
	}
}

// Prontera Church
//============================================================
prt_church,103,76,0	script	Garnet#pront	67,{
	mes "[Garnet]";
	mes "你好~";
	mes "你想进一步了解如何帮助和支持他人吗？";
	next;
	mes "[Garnet]";
	mes "在这座教堂受训的服事和祭司可以治疗他人、治愈异常状态，甚至唤醒其他冒险者的战斗潜能。";
	next;
	mes "[Garnet]";
	mes "如果对服事和祭司技能有疑问，尽管问我。";
	while(1) {
		next;
		switch(select("关于治愈术:关于痊愈术:关于敏捷提升:关于天使之赐福:关于神威祈福:关于传送之阵:结束对话")) {
		case 1:
			mes "[Garnet]";
			mes "你可以用 ^6666CC治愈术^000000 恢复自己的 HP。治疗是战斗中帮助朋友最重要的方式之一。";
			next;
			mes "[Garnet]";
			mes "虽然我们的力量通常用于治疗他人，但 ^6666CC治愈术^000000 也能伤害不死族怪物。";
			next;
			mes "[Garnet]";
			mes "对不死族使用痊愈术或治愈术时，记得按住 ^6666CCShift^000000 键。要确保是在伤害怪物，不要用来帮助它们。";
			next;
			mes "[Garnet]";
			mes "服事学会 ^6666CC治愈术^000000 后，转为祭司就能学习 ^6666CC圣域^000000。";
			next;
			mes "[Garnet]";
			mes "祭司用 ^6666CC圣域^000000 创造区域，在其中休息就能恢复你和朋友的 HP。";
			continue;
		case 2:
			mes "[Garnet]";
			mes "服事的 ^6666CC治愈术达到 2 级^000000 后，可以学习用于治疗异常状态的 ^6666CC痊愈术^000000。";
			next;
			mes "[Garnet]";
			mes "这项技能能救命，几乎所有异常状态都能用痊愈术治好。记得必须先学会 ^6666CC治愈术 2 级^000000。";
			continue;
		case 3:
			mes "[Garnet]";
			mes "^6666CC敏捷提升^000000 可以对自己或朋友使用，暂时提高 AGI，让攻击更快，也更容易躲避怪物攻击。";
			next;
			mes "[Garnet]";
			mes "服事想学习 ^6666CC敏捷提升^000000，必须先学习 ^6666CC治愈术 3 级^000000。";
			continue;
		case 4:
			mes "[Garnet]";
			mes "^6666CC天使之赐福^000000 可以提高自己和队友的防御。记住，只有队伍成员才能接受该技能。";
			next;
			mes "[Garnet]";
			mes "学习天使之赐福前，需要 ^6666CC神圣之光 3 级^000000。";
			next;
			mes "[Garnet]";
			mes "继续提升天使之赐福后，最终可以学习 ^6666CC霸邪之阵^000000，自动闪避初始攻击。";
			continue;
		case 5:
			mes "[Garnet]";
			mes "^6666CC神威祈福^000000 暂时提高 STR、DEX 和 INT，让你和朋友在战斗中占据优势！";
			next;
			mes "[Garnet]";
			mes "学习神威祈福前，必须先学会 ^6666CC神圣之光 5 级^000000。";
			continue;
		case 6:
			mes "[Garnet]";
			mes "^6666CC传送之阵^000000 是很复杂的技能，学习前必须掌握其他技能。";
			next;
			mes "[Garnet]";
			mes "首先要学习能看见隐形怪物的 ^6666CC光之障壁^000000，之后学习 ^6666CC瞬间移动^000000。";
			next;
			mes "[Garnet]";
			mes "学会 ^6666CC传送之阵^000000 后，技能等级决定你能记录多少个传送目的地或传送点。";
			next;
			mes "[Garnet]";
			mes "精通传送之阵后最多能拥有 4 个不同传送点。其中至少一个是你在卡普拉职员处设定的储存点。";
			next;
			mes "[Garnet]";
			mes "虽然有点麻烦，但想把某地设为传送点，必须先亲自到那里，再在命令行输入 ^6666CC/memo^000000。";
			next;
			mes "[Garnet]";
			mes "注意，不能在地下城内记录传送点。每次制作传送之阵，都要使用 1 个 ^6666CC蓝色魔力矿石^000000 作为催化剂。";
			continue;
		case 7:
			mes "["+ strcharinfo(0) +"]";
			mes "好了，我已经";
			mes "听够了。";
			close;
		}
	}
	end;
}

prt_church,103,71,0	script	Henson#pront	120,{
	mes "[Henson]";
	mes "我们祭司和服事不只会减轻同胞的痛苦……";
	next;
	mes "[Henson]";
	mes "我们也会对邪恶势力施以迅速而无情的惩罚。当然，净化那些变成不死族的可怜灵魂也是职责。";
	next;
	mes "[Henson]";
	mes "你对服事和祭司技能有疑问吗？";
	while(1) {
		next;
		switch(select("关于神圣之光:关于恶魔火焰:关于敏捷下降:关于十字驱魔攻击:关于光之障壁:关于光之障壁:关于瞬间移动:结束对话。")) {
		case 1:
			mes "[Henson]";
			mes "想永久提高对不死族的防御，就学习 ^6666CC神圣之光^000000。";
			next;
			mes "[Henson]";
			mes "神圣之光达到特定等级后，还能学习 ^6666CC天使之赐福^000000 和 ^6666CC神威祈福^000000 等技能，Garnet 会为你说明。";
			next;
			mes "[Henson]";
			mes "学会 ^6666CC神圣之光 3 级^000000 后，就能学习 ^6666CC恶魔火焰^000000。";
			next;
			mes "[Henson]";
			mes "^6666CC恶魔火焰^000000 会永久提高你对不死族的攻击伤害。";
			continue;
		case 2:
			mes "[Henson]";
			mes "^6666CC恶魔火焰^000000 会永久提高你对不死族造成的伤害。";
			next;
			mes "[Henson]";
			mes "首先要学习 ^6666CC神圣之光 3 级^000000 才能学习恶魔火焰，请记住。";
			next;
			mes "[Henson]";
			mes "学会 ^6666CC恶魔火焰 3 级^000000 后，可以学习 ^6666CC十字驱魔攻击^000000，降低不死族和暗属性怪物的防御。";
			continue;
		case 3:
			mes "[Henson]";
			mes "对怪物使用 ^6666CC敏捷下降^000000 会减慢移动和攻击速度，也降低它们闪避你攻击的能力。";
			next;
			mes "[Henson]";
			mes "想学习敏捷下降，必须先学会 ^6666CC敏捷提升 2 级^000000。";
			continue;
		case 4:
			mes "[Henson]";
			mes "^6666CC十字驱魔攻击^000000 会降低不死族或暗属性怪物的防御，范围很广，威力也很强。";
			next;
			mes "[Henson]";
			mes "不过它很难使用，成功率也相对较低。即使不是每次都成功，也不要灰心。";
			next;
			mes "[Henson]";
			mes "成功时会带来巨大的战斗优势。记住，需要 ^6666CC恶魔火焰 3 级^000000 才能学习。";
			continue;
		case 5:
			mes "[Henson]";
			mes "^6666CC光之障壁^000000 能生成屏障，阻挡一定范围内的所有远程攻击，保护你免受远距离怪物攻击。";
			next;
			mes "[Henson]";
			mes "想学习光之障壁，必须先完全精通 ^6666CC传送之阵^000000。";
			continue;
		case 6:
			mes "[Henson]";
			mes "没有什么能逃过圣光之眼！^6666CC光之障壁^000000 能看见隐藏或隐形的怪物和冒险者。";
			next;
			mes "[Henson]";
			mes "学会光之障壁后，就能学习 ^6666CC瞬间移动^000000。";
			continue;
		case 7:
			mes "[Henson]";
			mes "首先必须学习 ^6666CC光之障壁^000000，才能学习瞬间移动。";
			next;
			mes "[Henson]";
			mes "^6666CC瞬间移动^000000 会把你传送到当前原野或城市的随机地点。它适合快速逃跑，但目的地……无法预测。";
			next;
			mes "[Henson]";
			mes "精通瞬间移动后，可以传送到在卡普拉职员处设定的最新储存点。我也不知道为什么，但主的行事总是神秘莫测。";
			next;
			mes "[Henson]";
			mes "精通瞬间移动后，还能学习 ^6666CC传送之阵^000000。想了解更多就去问 Garnet。";
			continue;
		case 8:
			mes "[Henson]";
			mes "如果想进一步了解服事或祭司技能，欢迎随时来找我。";
			close;
		}
	}
	end;
}

// Hidden Temple
//============================================================
prt_maze02,100,69,0	script	Soldier#pront	105,{
	mes "[Soldier]";
	mes "喂、喂！";
	mes "你在这里";
	mes "做什么？！";
	next;
	mes "[Soldier]";
	mes "你不知道这片森林里住着恶魔吗？！";
	mes "进去的话我可无法保证你的安全！";
	close;
}

prt_maze02,110,69,0	script	Soldier#2pront	105,{
	mes "[Soldier]";
	mes "*叹气……* 上一个进入这里的人再也没回来。他不听我的劝告，进去采什么草药之类的蠢东西……";
	next;
	mes "[Soldier]";
	mes "真是个笨蛋。谁会为了采些蠢草药就把命丢掉？";
	close;
}

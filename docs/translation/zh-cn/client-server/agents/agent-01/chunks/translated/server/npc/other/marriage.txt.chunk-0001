//===== rAthena Script ======================================= 
//= Player Marriage
//===== By: ================================================== 
//= L0ne_W0lf
//===== Current Version: ===================================== 
//= 1.5
//===== Compatible With: ===================================== 
//= rAthena Project
//===== Description: ========================================= 
//= [Official Conversion]
//= Official Marriage script.
//= Added isloggedin() check, even though Aegis doesn't do it.
//= Currently does not support same-Sex marriages.
//= Old script located in: npc/custom/marriage.txt
//= - Variable in use: wedding_sign (max 1)
//= - Variable in use: $@wedding (max 1) 
//= - Variable in use: $@wed_groom$ $@wed_bride$
//===== Additional Comments: ================================= 
//= 1.0 First version. [L0ne_W0lf]
//= 1.1 Fixed a missing ")" [L0ne_W0lf]
//= 1.2 Corrected duration of Wedding status. [L0ne_W0lf]
//= 1.3 Changed permanent global variables to temporary ones. [Euphy]
//=     Added GM NPCs (commented).
//= 1.4 Added GM management function. [Euphy]
//= 1.5 Added Marriage Covenant item and VIP features. [Euphy]
//============================================================

prt_church,97,100,4	script	Wedding Staff#w	71,{
	cutin "wedding_marry01",2;
	if (countitem(6026) == 0) {

		// If the VIP system is enabled:
		// - Non-VIP players must use a Marriage Covenant to get married.
		// - VIP players may either pay the Zeny fee or use a Marriage Covenant.
		if (VIP_SCRIPT && !vip_status(VIP_STATUS_ACTIVE)) {
			mes "[快乐玛莉]";
			mes "抱歉，你现在不能结婚。";
			mes "婚礼仅向订阅玩家开放。";
			mes "但如果你拥有 ^FF0000婚姻契约^000000，就可以结婚！";
			goto L_End;
		}

	} else
		set .@covenant,1;
	if (Upper == 2) {
		mes "[快乐玛莉]";
		mes "你好~";
		mes "我叫快乐玛莉";
		mes "我来为你提供";
		mes "婚姻相关信息。";
		mes "现在，你有什么";
		mes "问题吗？";
		next;
		if (select("我想结婚。:我不需要你的帮助！") == 1) {
			mes "[快乐玛莉]";
			mes "哦，抱歉，";
			mes "被收养的角色";
			mes "不允许";
			mes "结婚。目前不如";
			mes "享受";
			mes "童年的简单乐趣？";
			goto L_End;
		}
		mes "[快乐玛莉]";
		mes "哦，当然，你";
		mes "不需要！小孩子";
		mes "不能结婚——";
		mes "法律不允许";
		mes "这样~你不是最";
		mes "可爱的小家伙吗？";
		goto L_End;
	}
	mes "[快乐玛莉]";
	mes "婚姻是两个灵魂的美丽";
	mes "结合，他们选择永远";
	mes "在一起，";
	mes "分享快乐与生活。";
	mes "你生命中有";
	mes "这样特别的人吗？";
	next;
	switch(select("询问婚礼仪式:询问流程:申请婚礼:我们是无敌单身军团！")) {
	case 1:
		mes "[快乐玛莉]";
		mes "睿智仁慈的";
		mes "特里斯坦三世国王曾经";
		mes "主持婚礼，";
		mes "但现在因王室职责和";
		mes "繁忙日程";
		mes "无法再主持。";
		next;
		mes "[快乐玛莉]";
		mes "爱之主教沃玛斯主教";
		mes "现在负责主持";
		mes "婚礼仪式。";
		mes "他是符文米德加尔特王国的";
		mes "真正瑰宝。";
		next;
		mes "[快乐玛莉]";
		mes "结婚是一生的事，";
		mes "所以提出或接受求婚前请慎重考虑。";
		mes "接受求婚。";
		mes "请注意，男性只能";
		mes "与女性结婚，反之亦然。";
		next;
		mes "[快乐玛莉]";
		mes "如果你足够幸运，";
		mes "找到真正";
		mes "想共度余生的人，";
		mes "不妨向对方求婚。希望大家";
		mes "都找到完美伴侣~";
		break;
	case 2:
		mes "[快乐玛莉]";
		mes "婚礼流程的第一步是";
		mes "完成申请。";
		mes "新娘和新郎完成申请后，";
		mes "必须组成两人队伍。";
		mes "这样才能继续婚礼流程。";
		mes "请务必确认队伍人数。";
		next;
		mes "[快乐玛莉]";
		mes "组成两人队伍后，";
		mes "两人必须和沃玛斯主教交谈。";
		mes "新郎先说话，必须告诉主教";
		mes "新娘的准确姓名，否则婚礼会中止。";
		mes "请提前确认姓名拼写。";
		next;
		mes "[快乐玛莉]";
		mes "之后新娘要和主教交谈，";
		mes "告诉他新郎的姓名。";
		mes "如果两人的姓名都正确，";
		mes "就可以交换戒指了。";
		mes "请不要输入错误姓名。";
		mes "否则流程会被中断。";
		next;
		mes "[快乐玛莉]";
		mes "交换结婚戒指后，";
		mes "两人就会永远结为夫妻。当然，";
		mes "在此之前还有很多机会改变主意，所以……";
		next;
		mes "[快乐玛莉]";
		mes "如果同时有很多对情侣想结婚，";
		mes "请排好队，依次和沃玛斯主教交谈。";
		mes "因为一次只能为一对情侣举行婚礼。";
		mes "请耐心等待。";
		mes "不要插队。";
		next;
		mes "[快乐玛莉]";
		mes "最后，请务必告诉沃玛斯主教";
		mes "伴侣的准确姓名，不要浪费太多时间。";
		mes "如果耗时太久，婚礼会自动中止，";
		mes "你必须重新尝试。";
		next;
		mes "[快乐玛莉]";
		mes "新娘要记住，";
		mes "新郎和主教交谈结束后，";
		mes "新娘只有 3 分钟";
		mes "可以和沃玛斯主教交谈。";
		mes "请抓紧时间。";
		next;
		if (select("谢谢，这帮了大忙！:怎样最容易说出伴侣的姓名？") == 1) {
			mes "[快乐玛莉]";
			mes "我会帮助大家";
			mes "尽可能顺利地完成婚礼。";
			mes "如果有任何不明白的地方，";
			mes "尽管再来问我。";
			mes "我很乐意为你解答。";
			mes "祝你婚礼顺利。";
			goto L_End;
		}
		mes "[快乐玛莉]";
		mes "向主教输入伴侣姓名最简单的方法，";
		mes "是先给伴侣发送私聊，";
		mes "然后左键点击聊天输入框左侧的姓名。";
		mes "这样就能快速复制姓名。";
		mes "请确认选择了正确的人。";
		next;
		mes "[快乐玛莉]";
		mes "按下 ‘Ctrl’ 和 ‘C’ 键复制姓名。";
		mes "然后按下 ‘Insert’ 和 ‘Shift’ 键，";
		mes "就能把姓名粘贴到输入框中。";
		mes "听起来很简单吧？";
		mes "试试看。";
		next;
		mes "[快乐玛莉]";
		mes "好了，现在试试看。";
		mes "用我刚才说的方法，";
		mes "练习输入伴侣的姓名。";
		mes "请仔细确认。";
		next;
		input .@partner$;
		mes "[快乐玛莉]";
		mes "好了，决定结婚后，";
		mes "再回来找我，";
		mes "提交你的申请。";
		mes "回头见，冒险者～";
		break;
	case 3:
		cutin "wedding_marry02",2;
		if (VIP_SCRIPT) {
			mes "[快乐玛莉]";
			mes "^FF0000等等！^000000";
			mes "^FF0000如果你的账号不是高级账号，必须拥有结婚誓约才能结婚。^000000";
			mes "^FF0000登记婚礼前，请确认你和伴侣的账号状态。^000000";
			next;
		}
		if (Sex == SEX_MALE) {
			mes "[快乐玛莉]";
			mes "你想结婚吗？";
			mes "作为新郎，你需要准备";
			if (.@covenant) {
				mes "^3377FF1 件礼服^000000，并交给我 ^3377FF1结婚誓约^000000。";
				mes "新娘需要准备自己的婚纱并支付费用，";
				mes "费用为 1,200,000 Zeny，或带来结婚誓约。";
			} else {
				mes "^3377FF1 件礼服^000000，支付 ^3377FF1,300,000 Zeny^000000。";
				mes "新娘需要准备自己的婚纱并支付费用，";
				mes "费用为 1,200,000 Zeny。";
			}
		} else {
			mes "[快乐玛莉]";
			mes "你想结婚吗？";
			mes "作为新娘，你需要准备";
			if (.@covenant) {
				mes "^3377FF1 件婚纱^000000，并交给我 ^3377FF结婚誓约^000000。";
				mes "新郎必须带礼服并支付";
				mes "1,300,000 Zeny，或带来结婚誓约。";
			} else {
				mes "^3377FF1 件婚纱^000000并支付 1,200,000 Zeny。新郎必须";
				mes "带礼服并支付 1,300,000 Zeny 才能结婚。";
			}
		}
		next;
		mes "[快乐玛莉]";
		mes "新娘和新郎还需要准备";
		mes "^3377FF1 枚钻戒^000000，与伴侣交换。";
		mes "提交婚礼申请时，";
		mes "必须准备好所有这些物品。";
		mes "请提前确认材料。";
		mes "这样婚礼才能顺利进行。";
		next;
		mes "[快乐玛莉]";
		mes "准新娘和准新郎都必须完成";
		mes "申请流程，";
		mes "婚礼才能举行。";
		mes "现在要申请结婚吗？";
		mes "请慎重考虑。";
		mes "准备好后再来登记。";
		next;
		if (select("是:否") == 1) {
			if (getpartnerid()) {
				cutin "wedding_marry02",2;
				mes "[快乐玛莉]";
				mes "抱歉，你不能再次申请结婚！";
				mes "我不能允许你背叛";
				mes "自己的伴侣，";
				mes "而且在卢恩·米德加尔特，";
				mes "一夫多妻制";
				mes "是不合法的。";
				break;
			}
			else if (wedding_sign == 1) {
				mes "[快乐玛莉]";
				mes "你不是已经完成申请了吗？";
				mes "嗯，请确认你的伴侣也完成了申请，";
				mes "然后去和沃玛斯主教交谈。";
				break;
			}
			else if (BaseLevel < 45) {
				mes "[快乐玛莉]";
				mes "嗯，在考虑结婚前，";
				mes "你需要变得足够强大，";
				mes "才能保护你所爱的人。";
				mes "变强之后，";
				mes "再来找我吧。";
				goto L_End;
			}
			else if (countitem(2613) < 1) {
				mes "[快乐玛莉]";
				mes "嗯？你忘了带结婚典礼上";
				mes "要和伴侣交换的钻戒吗？";
				mes "仔细找找，找到后再回来，好吗？";
				goto L_End;
			}
			else if (Sex == SEX_FEMALE) {
				if (countitem(6026) == 0 && Zeny < 1200000) {
					mes "[快乐玛莉]";
					mes "抱歉，所有新娘都必须支付 1,200,000 Zeny，";
					mes "或携带婚姻誓约才能举行婚礼。";
					mes "也许你可以请伴侣帮忙准备费用？";
					goto L_End;
				}
				else if (countitem(2338) < 1) {
					mes "[快乐玛莉]";
					mes "哎呀，你忘了带婚纱吗？";
					mes "快去找来交给我，";
					mes "婚礼绝对少不了它！";
					goto L_End;
				}
			}
			else if (Sex == SEX_MALE) {
				if (countitem(6026) == 0 && Zeny < 1300000) {
					mes "[快乐玛莉]";
					mes "抱歉，你没有新郎必须支付的 1,300,000 Zeny，";
					mes "也没有婚姻誓约。";
					mes "是不是把钱放错地方了？";
					goto L_End;
				}
				else if (countitem(7170) < 1) {
					mes "[快乐玛莉]";
					mes "你的燕尾服呢？";
					mes "婚礼上必须穿着它！";
					mes "找到后带来，我们就能开始婚礼了，好吗？";
					goto L_End;
				}
			}
			mes "[快乐玛莉]";
			mes "看来你已经准备好一切了。";
			mes "虽然我还不知道你的伴侣是谁，";
			mes "但先祝贺你即将举行婚礼～";
			next;
			mes "[快乐玛莉]";
			mes "现在开始申请。";
			mes "请在这里准确写下你的名字。";
			next;
			while(1) {
				input .@name$;
				if (.@name$ != strcharinfo(0)) {
					mes "[快乐玛莉]";
					mes "嗯，你必须准确写下显示出来的名字。";
					mes "也许需要复制粘贴？";
					mes "总之，再试一次吧。";
					next;
				}
				else
					break;
			}
			mes "[快乐玛莉]";
			mes "很好，你的申请完成了。";
			mes "记住，稍后和沃玛斯主教交谈时，";
			mes "必须告诉他伴侣的准确姓名，好吗？";
			next;
			mes "[快乐玛莉]";
			mes "伴侣完成申请后，";
			mes "你们两人都要和主教交谈，";
			mes "才能开始婚礼。";
			emotion ET_THROB;
			next;
			mes "[快乐玛莉]";
			if (Sex == SEX_FEMALE) {
				mes "你是新娘，需要等新郎先和沃玛斯主教交谈。";
				mes "他完成后，就轮到你和沃玛斯主教交谈了。";
				if (.@covenant)
					delitem 6026,1; //Marriage_Covenant
				else
					set Zeny, Zeny-1200000;
				delitem 2338,1; //Wedding_Dress
			}
			else {
				mes "你是新郎，需要先和主教交谈。";
				mes "你完成后，就轮到新娘和沃玛斯主教交谈了。";
				if (.@covenant)
					delitem 6026,1; //Marriage_Covenant
				else
					set Zeny, Zeny-1300000;
				delitem 7170,1; //Tuxedo
			}
			delitem 2613,1; //Diamond_Ring
			set wedding_sign,1;
			goto L_End;
		}
		mes "[快乐玛莉]";
		mes "不……？";
		mes "准备好结婚时，";
		mes "随时欢迎回来申请。";
		mes "祝你今天愉快～";
		break;
	case 4:
		cutin "wedding_marry02",2;
		donpcevent "Single Army#Prontera::OnEnable";
		donpcevent "Single Army#Geffen::OnEnable";
		donpcevent "Single Army#Morocc::OnEnable";
		donpcevent "Single Army#Payon::OnEnable";
		donpcevent "Single Army#Amatsu::OnEnable";
		donpcevent "Single Army#Kunlun::OnEnable";
		emotion ET_HUK;
		mes "[单身军]";
		mes "^CC9933想打造强力装备，就得自己精炼物品！^000000";
		emotion ET_ROCK, getnpcid(0, "Single Army#Prontera");
		next;
		mes "[单身军]";
		mes "^330099在地下城组队只是浪费时间！我一个人也能闯过去！^000000";
		emotion ET_ROCK, getnpcid(0, "Single Army#Geffen");
		next;
		mes "[单身军]";
		mes "^666666从出生到转职，我一直都是独自训练的！^000000";
		emotion ET_ROCK, getnpcid(0, "Single Army#Morocc");
		next;
		mes "[单身军]";
		mes "^666600我选择独自度过圣诞节……玩单人纸牌、填填字游戏！^000000";
		emotion ET_ROCK, getnpcid(0, "Single Army#Payon");
		next;
		mes "[单身军]";
		mes "^CC9966女人也许能击碎我的精神，但永远夺不走……我的自由！^000000";
		emotion ET_ROCK, getnpcid(0, "Single Army#Amatsu");
		next;
		mes "[单身军]";
		mes "^669900……我们是自由的！我们是无敌单身军！^000000";
		emotion ET_ROCK, getnpcid(0, "Single Army#Kunlun");
		close2;
		cutin "wedding_marry01",255;
		emotion ET_SWEAT;
		donpcevent "Single Army#Prontera::OnInit";
		donpcevent "Single Army#Geffen::OnInit";
		donpcevent "Single Army#Morocc::OnInit";
		donpcevent "Single Army#Payon::OnInit";
		donpcevent "Single Army#Amatsu::OnInit";
		donpcevent "Single Army#Kunlun::OnInit";
		end;
	}
	close2;
	cutin "wedding_marry01",255;
	end;

L_End:
	close2;
	cutin "",255;
	end;
}

prt_church,97,102,0	script	Single Army#Prontera	105,{
	mes "[单身军]";
	mes "^CC9933想打造强力装备，就得自己精炼物品！^000000";
	close;

OnInit:
	hideonnpc "Single Army#Prontera";
	end;

OnEnable:
	hideoffnpc "Single Army#Prontera";
	emotion ET_GO;

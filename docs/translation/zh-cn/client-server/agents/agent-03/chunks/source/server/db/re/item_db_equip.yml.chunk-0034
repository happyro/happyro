         bonus2 bAddRace,RC_Player_Human,pow(min(14,.@r)-4,2);
         bonus2 bIgnoreDefRaceRate,RC_DemiHuman,5;
         bonus2 bIgnoreDefRaceRate,RC_Player_Human,5;
      }
      if (.@r>8)
         bonus2 bSkillAtk,"AC_DOUBLE",20;

		mes "They better send";
		mes "someone soon...";
		next;
		switch( select( "Jargeah?","Ignore him." ) )
		{
			case 1:
				mes "[Jargeah]";
				mes "^333333*Cough Gasp*^000000";
				mes "H-how do you know my...";

            Amount: 20
          - Item: Old_Frying_Pan
            Amount: 10
          - Item: Apple_Juice
            Amount: 3
          - Item: Eggring_Card
            Amount: 1
      - Target: SWEETS_DROPS
        ItemRequirements:

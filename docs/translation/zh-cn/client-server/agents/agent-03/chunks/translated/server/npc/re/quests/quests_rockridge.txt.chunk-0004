		mes "很快我会带几名恢复得足够好的矿工去矿井二层工作。";
		mes "当然要小心，因为强盗还在矿井里。";
		next;
		mes "[Shawn McCurdy]";
		mes "他们在一层，所以我们只要封锁电梯。";
		mes "还有很多事要做。";
		close;
	}
	end;

OnInit:
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "rock_main_quest == 10" );
	end;
}

rockrdg2,347,216,5	script	Shawn McCurdy#rockrdg2	4_M_SEANMCCURDY,{
	if (rock_main_quest < 11) {
		npctalk "*Gasp* Adventurer, be careful! This place isn't safe since the Buffalo Bandits have occupied the nearby mine.", "", bc_self;
		end;
	}
	if (rock_main_quest == 11 || rock_main_quest == 12) {
		if (rock_main_quest == 11) {
			mes "[Shawn McCurdy]";
			mes "哇！你是谁？";
			sleep2 1000;
			unittalk getcharid(3), "" + strcharinfo(0) + " : Take it easy. It's me.", bc_self;
			next;
			mes "[Shawn McCurdy]";
			mes "哦，呼。原来是冒险者。";
			mes "待在这么危险的地方让我很紧张。";
			mes "很高兴你安全来到这里。";
			next;
			mes "[Shawn McCurdy]";
			mes "上次我来这里时，";
			mes "为了以防万一藏起了入口。";
			mes "你要下楼吗？";
		}
		else {
			if (countitem(25247) > 0) {
				mes "[Shawn McCurdy]";
				mes "这证明了你作为冒险者的经验。";
				mes "虽然我没告诉你要找什么，你还是找到了又大又优质的矿石。";
				next;
				mes "[Shawn McCurdy]";
				mes "干得好！这应该能说服Albert。";
				mes "我们去和他谈判吧！";
				rock_main_quest = 13;
				erasequest 7801;
				setquest 7802;// Hear Me Out 2
				close;
			}
			mes "[Shawn McCurdy]";
			mes "我们需要一块矿石来骗过Albert和其他强盗。你现在要去找吗？";
		}
		next;
		if (select( "就这么办。", "我还没准备好。" ) == 2) {
			mes "[Shawn McCurdy]";
			mes "在这里待太久很危险。";
			mes "请快一点。";
			close;
		}
		mes "[Shawn McCurdy]";
		mes "小心脚下。";
		close2;
		warp "rockmi2",14,86;
		end;
	}
	if (rock_main_quest == 13) {
		if (countitem(25247) > 0) {
			mes "[Shawn McCurdy]";
			mes "好！";
			mes "现在最好去见Albert。祝你谈判顺利！";
			mes "矿井入口就在这里稍微偏北的地方。";
			next;
			mes "[Shawn McCurdy]";
			mes "希望我的意见能帮到你！";
			close;
		}
		mes "[Shawn McCurdy]";
		mes "冒险者，你把那块又大又漂亮的矿石放哪了？弄丢了吗？";
		mes "需要再去挖一块吗？";
		next;
		if (select( "是。", "我还没准备好。" ) == 2) {
			mes "[Shawn McCurdy]";
			mes "在这里待太久很危险。";
			mes "请快一点。";
			close;
		}
		mes "[Shawn McCurdy]";
		mes "希望这次你别再弄丢。";
		mes "小心脚下。";
		close2;
		warp "rockmi2",14,86;
		end;
	}
	if (rock_main_quest < 16) {
		mes "[Shawn McCurdy]";
		mes "我正在研究如何继续利用这个地方。";
		mes "当然，我不确定你能否直接和他们的首领交谈，不过……";
		close;
	}
	if (rock_main_quest < 20) {
		mes "[Shawn McCurdy]";
		mes "好，你最好在Buffalo强盗发现这里之前，赶快去见他们。";
		close2;
		warp "rockmi2",14,86;
		end;
	}
	if (rock_main_quest == 20) {
		mes "[Shawn McCurdy]";
		mes "现在只剩Albert Ford了。";
		mes "他一定在等Johnny被处决，这样就能成为帮派首领。";
		next;
		mes "[Shawn McCurdy]";
		mes "但强盗可能知道我们正在矿井里寻找箱子。";
		mes "现在轮到我们对他们强硬了。";
		next;
		mes "[Shawn McCurdy]";
		mes "请在前往那里时^4d4dff消灭Buffalo强盗，并带上5条棕色围巾和5条强盗围巾^000000。";
		mes "把Albert逼入绝境吧！";
		close;
	}
	mes "[Shawn McCurdy]";
	mes "我很谨慎，因为不想让强盗发现这个入口。";
	mes "请小心，冒险者。";
	close;

OnInit:
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "rock_main_quest == 11 || rock_main_quest == 12" );
	end;
}

rockmi2,10,86,5	script	Shawn McCurdy#rockmi2	4_M_SEANMCCURDY,{
	if (rock_main_quest == 11) {
		mes "[Shawn McCurdy]";
		mes "我们开始工作吧？";
		mes "沿着这条狭窄通道走，你会看到矿脉。";
		mes "这里的矿物很丰富。";
		mes "只要找到大小合适的^4d4dff1块紫色矿石^000000。";
		next;
		mes "[Shawn McCurdy]";
		mes "与此同时，我会检查我们回去时要用的滑轮。";
		mes "我们当时做得很匆忙，所以有时不太安全。哈哈。";
		rock_main_quest = 12;
		erasequest 7800;
		setquest 7801;// Shawn McCurdy's Weapon 3
		close;
	}
	if (rock_main_quest == 12) {
		if (countitem(25247) < 1) {
			mes "[Shawn McCurdy]";
			mes "冒险者，去找^4d4dff1块紫色矿石^000000。";
			mes "我会检查我们回去时要用的滑轮。";
			close;
		}
		mes "[Shawn McCurdy]";
		mes "这证明了你作为冒险者的经验。";
		mes "虽然我没告诉你要找什么，你还是找到了又大又优质的矿石。";
		next;
		mes "[Shawn McCurdy]";
		mes "干得好！这应该能说服Albert。";
		mes "好了，我们回去吧。";
		erasequest 7801;
		setquest 7802;// Hear Me Out 2
		rock_main_quest = 13;
		close2;
		warp "rockrdg2",348,214;
		end;
	}
	if (rock_main_quest == 13) {
		mes "[Shawn McCurdy]";
		mes "确认矿石在你身上。";
		mes "准备好回去了吗？";
		next;
		if (select( "是。", "让我去找另一块。" ) == 2) {
			mes "[Shawn McCurdy]";
			mes "我会在这里等。";
			close;
		}
		mes "[Shawn McCurdy]";
		mes "好了，我们上去吧！";
		close2;
		warp "rockrdg2",348,214;
		end;
	}
	if (rock_main_quest == 14) {
		mes "[Shawn McCurdy]";
		mes "谈判怎么样？";
		mes "我们回村子吧，大家一定在等我们。";
		close;
	}
	if (rock_main_quest == 16) {
		mes "[Shawn McCurdy]";
		mes "从矿井中央向北走，你会看到坏掉的电梯。";
		mes "愚蠢的强盗，我不敢相信他们竟为了藏矿石弄坏电梯。";
		next;
		mes "[Shawn McCurdy]";
		mes "他们以为自己很聪明，";
		mes "但这证明了他们的愚蠢。";
		next;
		mes "[Shawn McCurdy]";
		mes "确认矿石的位置，只带^4d4dff1个矿石箱^000000。";
		mes "我会把其他东西搬到别处。";
		next;
		mes "[Shawn McCurdy]";
		mes "强盗可能在矿井周围守卫。";
		mes "请小心。";
		rock_main_quest = 17;
		erasequest 7805;// Location of the Ores 2
		setquest 7806;// Location of the Ores 3
		close;
	}
	if (rock_main_quest == 17) {
		mes "[Shawn McCurdy]";
		mes "坏掉的电梯就在这座矿井中央的北边。";
		mes "确认矿石的位置，只带^4d4dff1个矿石箱^000000。";
		mes "我会把其他东西搬到别处。";
		next;
		mes "[Shawn McCurdy]";
		mes "强盗可能在矿井周围守卫。";
		mes "请小心。";
		close;
	}
	if (rock_main_quest == 18) {
		mes "[Shawn McCurdy]";
		mes "啊，我早该知道";
		mes "他们会在电梯附近巡逻。";
		mes "消灭你看到的Buffalo强盗，然后取得矿石。";
		close;
	}
	if (rock_main_quest == 19) {
		mes "[Shawn McCurdy]";
		mes "对，你带来了正确的箱子。";
		mes "如果^4d4dffAlbert Ford^000000看到这个，一定会大发雷霆。";
		next;
		mes "[Shawn McCurdy]";
		mes "趁Albert发现他的强盗无法巡逻回来之前，我们离开这里。";
		mes "哦，不过你得先^4d4dff和他谈谈。^000000";
		next;
		mes "[Shawn McCurdy]";
		mes "请在前往那里时^4d4dff消灭Buffalo强盗，并带上5条棕色围巾和5条强盗围巾^000000。";
		next;
		mes "[Shawn McCurdy]";
		mes "它们会帮助制造Sheriff Warp想要的局面。";
		mes "我们上去吧？";
		erasequest 7806;// Location of the Ores 3
		setquest 7807;// Ace up Our Sleeve
		rock_main_quest = 20;
		close2;
		warp "rockrdg2",348,214;
		end;
	}
	if (rock_main_quest == 20) {
		mes "[Shawn McCurdy]";
		mes "快点，你得消灭Buffalo强盗，让Albert措手不及！";
		mes "我们上去！";
		close2;
		warp "rockrdg2",348,214;
		end;
	}
	warp "rockrdg2",348,214;	// debug
	end;

OnInit:
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "rock_main_quest == 11 || rock_main_quest == 16" );
	end;
}

rockmi2,97,120,5	script	Broken Elevator#rrevt10	4_ENERGY_WHITE,{
	if (checkweight(1301,3) == 0) {
		mes "- You are carrying too many items to proceed with this quest. -";
		close;
	}
	if (rock_main_quest < 17) {
		mes "这里有一部坏掉的电梯。";
		close;
	}
	if (rock_main_quest == 17) {
		mes "[????]";
		mes "快看，";
		mes "有只老鼠溜进来了。";
		next;
		mes "[????]";
		mes "抓住它真是太好了，";
		mes "对吧？";
		close2;
		rock_main_quest = 18;
		monster "rockmi2", 95,116,"Buffalo Bandit",3736,1, "Broken Elevator#rrevt10::OnMyMobDead";
		monster "rockmi2",101,116,"Buffalo Bandit",3737,1, "Broken Elevator#rrevt10::OnMyMobDead";
		monster "rockmi2", 99,110,"Buffalo Bandit",3738,1, "Broken Elevator#rrevt10::OnMyMobDead";
		hideonnpc "Broken Elevator#rrevt10";
		end;
	}
	if (rock_main_quest == 18) {
		mes "我拆下了电梯底部的板子，在下面发现了几箱矿石。";
		unittalk getcharid(3), "" + strcharinfo(0) + " : Shawn said just one box.", bc_self;
		getitem 25248,1;// Violet_Stone_Box
		rock_main_quest = 19;
		close;
	}
	if (rock_main_quest == 19) {
		unittalk getcharid(3), "" + strcharinfo(0) + " : I have no more business here. I'd better go back to Shawn.", bc_self;
		end;
	}
	end;

OnMyMobDead:
	sleep2 1000;
	if (mobcount( "rockmi2", "Broken Elevator#rrevt10::OnMyMobDead" ) < 1)
		hideoffnpc "Broken Elevator#rrevt10";
	end;
}


rockrdg2,279,313,3	script	Concaved Rock#revt09	4_ENERGY_RED,{
	if (rock_main_quest == 13) {
		mes "这一定就是Johnny James告诉我的信号石。";
		next;
		if (select( "敲、敲敲敲、敲。", "敲、敲、敲。" ) == 2) {
			mes "我感觉自己应该帮他们堆雪人。";
			mes "什么也没发生。";
			close;
		}
		npctalk "Boss？是你吗，Boss？", "Albert Ford#rockrdg2", bc_self;
		cloakoffnpcself( "Albert Ford#rockrdg2" );
		close;
	}
	if (rock_main_quest == 14) {
		if (countitem(25249) < 1) {
			mes "我敲了信号石，Albert Ford跑了出来。";
			npctalk "你是谁？！", "Albert Ford#rockrdg2", bc_self;
			cloakoffnpcself( "Albert Ford#rockrdg2" );
			close;
		}
		mes "现在还用不上这个。";
		close;
	}
	if (rock_main_quest == 20) {
		if (checkquest(7807,HUNTING) < 2) {
			mes "我最好消灭足够多的Buffalo强盗，让Albert Ford害怕。";
			close;
		}
		mes "我敲了信号石，Albert Ford跑了出来。";
		npctalk "你是谁？！", "Albert Ford#rockrdg2", bc_self;
		cloakoffnpcself( "Albert Ford#rockrdg2" );
		close;
	}
	if (rock_main_quest == 20) {
		if (checkquest(7807,HUNTING) < 2) {
			mes "我最好消灭足够多的Buffalo强盗，让Albert Ford害怕。";
			close;
		}
		if (countitem(25249) < 1) {
			mes "我敲了信号石，Albert Ford跑了出来。";
			cloakoffnpcself( "Albert Ford#rockrdg2" );
			npctalk "你是谁？！", "Albert Ford#rockrdg2", bc_self;
			close;
		}
		mes "我没有矿石箱可以拿给Albert Ford看。";
		close;
	}
	if (rock_main_quest == 22) {
		mes "这个已经没用了。";
		close;
	}
	mes "敲击这块石头时会发出深沉的回声。";
	mes "矿工用它向矿井里的其他人发信号。";
	close;
}

rockrdg2,295,309,3	script	Albert Ford#rockrdg2	4_M_ALBERTFORD,{
	if (checkweight(1301,3) == 0) {
		mes "- You are carrying too many items to proceed with this quest. -";
		close;
	}
	disable_items;
	.@account_id = getcharid(3);
	.@player_name$ = strcharinfo(0);
    if (rock_main_quest < 13) {
		npctalk "Rock Ridge的那群混蛋低估我们了。*咬牙*", "", bc_self;
		end;
	}
	if (rock_main_quest == 13) {
		mes "[Albert Ford]";
		mes "你到底是谁？";
		mes "你怎么知道只有Boss和我知道的暗号？";
		next;
		select("我是来和你谈判的。");
		mes "[Albert Ford]";
		mes "你一定是在开玩笑。";
		mes "从你偷袭Boss的那一刻起，就没有谈判可谈了。";
		next;
		switch( select( "你说得对。我不是来谈判的。", "我是来告诉你Johnny要背叛你们了。" ) ) {
		case 1:
			mes "[" + .@player_name$ + "]";
			mes "我说的是实话。";
			mes "我是来告诉你总部的决定。";
			mes "我们已经保存了很多矿石，足够弥补你们偷走的那一点。";
			next;
			mes "[" + .@player_name$ + "]";
			mes "我们用不上它们，你们就留着吧。";
			next;
			npctalk "Boss怎么样？", "", bc_self;
			unittalk .@account_id, "" + .@player_name$ + " : You mean Johnny James?", bc_self;
			mes "[" + .@player_name$ + "]";
			mes "我们也用不上他。";
			mes "但Sheriff一直想抓到他。";
			mes "他很快就会在法庭上受审。";
			next;
			mes "[" + .@player_name$ + "]";
			mes "而且Johnny已经放弃了。";
			mes "他认为你背叛了他。你知道吗？你丢下他逃跑了。";
			next;
			mes "[" + .@player_name$ + "]";
			mes "他甚至提出用矿石的位置换取自由。";
			mes "不过当然，我们不需要他提供的信息。";
			mes "我想让你知道你的Boss有多懦弱。";
			break;
		case 2:
			mes "[Albert Ford]";
			mes "你在说什么？";
			mes "Boss背叛了我们？";
			mes "他为什么要这么做？";
			mes "别撒谎！";
			unittalk .@account_id, "" + .@player_name$ + " : Why do you think I'm lying?", bc_self;
			next;
			mes "[Albert Ford]";
			mes "我查过了，Costello仍然是你们的Mayor！";
			mes "你在上次会议上撒谎，说自己会成为新Mayor！";
			unittalk .@account_id, "" + .@player_name$ + " : Ah, that.", bc_self;
			next;
			mes "[" + .@player_name$ + "]";
			mes "好吧，我仍然来自总部。";
			mes "我负责这起案件。";
			mes "解决这起案件后，我会取代Costello成为Mayor。";
			next;
			mes "[" + .@player_name$ + "]";
			mes "Costello想离开。";
			mes "他留在这里只是因为总部让他留着。";
			mes "别把我和他相提并论。";
			next;
			npctalk "你说Boss要背叛我们是什么意思？", "", bc_self;
			unittalk .@account_id, "" + .@player_name$ + " : You mean Johnny James?", bc_self;
			mes "[" + .@player_name$ + "]";
			mes "总部已经决定";
			mes "即使没有你们偷走的矿石，我们的矿石也够了。";
			mes "所以……";
			next;
			mes "[" + .@player_name$ + "]";
			mes "我们也用不上他。";
			mes "但Sheriff一直想抓到他。";
			mes "他很快就会在法庭上受审。";
			next;
			mes "[" + .@player_name$ + "]";
			mes "而且Johnny已经放弃了。";
			mes "他认为你背叛了他。你知道吗？你丢下他逃跑了。";
			next;
			mes "[" + .@player_name$ + "]";
			mes "他甚至提出用矿石的位置换取自由。";
			mes "既然他正式提出了这个条件，我们不能忽视。";
			next;
			mes "[" + .@player_name$ + "]";
			mes "我想让你知道你的Boss有多懦弱。";
			break;
		}
		next;
		mes "[" + .@player_name$ + "]";
		mes "如果我们想拿回矿石，随时可以去和Johnny谈，";
		mes "没必要和你打交道。";
		next;
		npctalk "我逃跑了", "", bc_self;
		mes "[Albert Ford]";
		mes "去叫人帮忙。";
		mes "我们随时可以入侵你们的村子，把Boss带回来！";
		mes "我不敢相信Boss竟如此小看我……";
		next;
		mes "[Albert Ford]";
		mes "不过话说回来，你也可能在骗我。";
		mes "你不是想挑拨我和Boss的关系吧？";
		next;
		select("你觉得是谁告诉我如何向你发信号的？");
		mes "[Albert Ford]";
		mes "...!";
		mes "是他告诉你的？";
		mes "他真的背叛我们了吗？";
		unittalk .@account_id, "" + .@player_name$ + "：我到底要告诉你多少次？", bc_self;
		next;
		mes "[Albert Ford]";
		mes "我们一直在想办法救他，";
		mes "他却和我们的敌人交朋友。我们不需要这种自私的叛徒。";
		next;
		mes "[Albert Ford]";
		mes "你特意来到这里告诉我这些。为什么？";
		next;
		select("告诉我们矿石在哪里。");
		mes "[Albert Ford]";
		mes "你说过你们不需要它们！";
		next;
		select("不，但它们是惩罚Johnny所必需的。");
		mes "[" + .@player_name$ + "]";

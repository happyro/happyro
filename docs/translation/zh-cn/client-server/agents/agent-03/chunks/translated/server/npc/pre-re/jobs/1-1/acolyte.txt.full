//===== Compatible With: ===================================== 
//= rAthena Project
//===== Description: ========================================= 
//= [Official Conversion]
//= Job quest for Acolyte classes
//===== Additional Comments: ================================= 
//= 1.0 Fully working.
//= 1.1 Added function calls for Priest Quest.
//= 1.2 Fixed Marthilda, Yosuke bugs. [Lupus]
//= 1.2a Added instant job change for High Novice [Lupus]
//= 1.3 Added Baby Class support [Lupus]
//= 1.4 Optimised and moved first checker to Jfunc1-1 [massdriller]
//= 1.5 Now saves/restores all quest skills [Lupus]
//= 1.6 Merged back JFunc [Lupus]
//= 1.7 Rescripted to Aegis 10.3 stadards. [L0ne_W0lf]
//=     No longer uses function "F_ToHigh"
//=     Proper dialog for Priest job quest is unused (for now.)
//= 1.7a Functions now make use of proper priest quest dialog [L0ne_W0lf]
//= 1.8 Removed an Unnecessary "set job_acolyte_q,0;" [Samuray22]
//= 1.8a More bug fixes care of Crashy. [L0ne_W0lf]
//= 1.9 Changed Marthilda to Mathilda. [L0ne_W0llf]
//= 2.0 Fixed High Acolytesnot being given holy light. [L0ne_W0lf]
//= 2.1 Added Quest Log commands. [L0ne_W0lf]
//= 2.2 Fixed an issue with completequest by adding checkquest. [Kisuka]
//============================================================ 

prt_church,184,41,4	script	Cleric#aco	60,{
	if (Upper == 1) {
		if (ADVJOB == Job_High_Priest || ADVJOB == Job_Champion) {
			if (Class == Job_Novice_High) {
				mes "[Father Mareusis]";
				mes "啊，我感觉到你经历过前世。";
				mes "进入英灵殿前，你一定学到了很多东西。";
				next;
				if (!callfunc("F_CanChangeJob")) {
					mes "[Father Mareusis]";
					mes "很遗憾，你还没准备好成为服事。请先学会所有基础技能。";
					next;
					mes "[Father Mareusis]";
					mes "在此期间，我会等到你准备好。愿上帝与你同在。";
					mes "";
					mes "";
					mes "";
					mes "";
					close;
				}
				mes "[Father Mareusis]";
				mes "欢迎你从英灵殿归来，";
				mes "祝你新的人生旅程好运。";
				mes "";
				mes "";
				next;
				skill "NV_TRICKDEAD",0,SKILL_PERM;
				jobchange Job_Acolyte_High;
				skill "AL_HOLYLIGHT",1,SKILL_PERM;
				mes "[Father Mareusis]";
				mes "现在出发，寻找需要帮助的人。愿上帝照亮你的道路。";
				close;
			}
			else {
				mes "[Father Mareusis]";
				mes "现在出发，寻找需要帮助的人。愿上帝指引你的道路。";
				close;
			}
		}
		else {
			mes "[Father Mareusis]";
			mes "我感觉到你经历过前世。进入英灵殿前，你一定学到了很多东西。";
			next;
			mes "[Father Mareusis]";
			mes "不过，你并不适合成为服事。请记住前世的自己，找到你的道路。";
			close;
		}
	}
	mes "[Father Mareusis]";
	mes "你在寻求什么？";
	mes "";
	next;
	switch(select("神父，我想成为服事。:服事要求。:我只是看看。")) {
	case 1:
		mes "[Father Mareusis]";
		if (BaseJob == Job_Acolyte) {
			mes "今天感觉好吗？从你的服装就能看出你已经是服事了。你不是在开玩笑吧？";
			close;
		}
		else if (BaseJob != Job_Novice) {
			mes "抱歉，只有初心者才能申请转职为服事。";
			close;
		}
		if (job_acolyte_q == 0) {
			mes "你真的愿意成为";
			mes "上帝的仆人吗？";
			mes "";
			next;
			if (select("是的，神父。:不，我撒谎了。") == 1) {
				mes "[Father Mareusis]";
				mes "很好。我接受" + strcharinfo(0) + "成为服事的意愿。你明白成为上帝的仆人前必须接受苦修，对吧？";
				next;
				mes "[Father Mareusis]";
				mes "那么，我会给你一个任务……";
				mes "";
				switch(rand(3)) {
				default:
					set job_acolyte_q,2;
					mes "请拜访普隆德拉教区成员^000077Rubalkabara神父^000000后回来。他正在^000077普隆德拉城东北的遗迹^000000修行。";
					setquest 1001;
					break;
				case 1:
					set job_acolyte_q,3;
					mes "请拜访^000077Mathilda修女^000000后回来。她正在^000077普隆德拉城西南的梦罗克镇附近^000000修行。";
					setquest 1002;
					break;
				case 2:
					set job_acolyte_q,4;
					mes "请拜访^000077Yosuke神父^000000后回来。他正在^000077普隆德拉西北某座桥附近^000000修行。";
					setquest 1003;
					break;
				}
				next;
				mes "[Father Mareusis]";
				mes "愿上帝的恩典照亮你的道路，引导你的苦修之旅。";
				close;
			}
			mes "[Father Mareusis]";
			mes "你撒谎了？";
			mes "很好，你承认了自己的过错。";
			mes "去吧，我的孩子，愿你平安。";
			mes "";
			mes "";
			close;
		}
		mes "哦，你回来了。让我看看你是否准备好侍奉上帝……";
		next;
		mes "[Father Mareusis]";
		if (!callfunc("F_CanChangeJob")) {
			mes "天啊！你还没完成基础训练？！完成它很重要！";
			next;
			mes "[Father Mareusis]";
			mes "你应该多训练！回去确认初心者职业等级达到9并学会所有基础技能！";
			close;
		}
		if (job_acolyte_q < 5) {
			mes "哦？我在登记表上找不到你的名字。";
			next;
			switch(job_acolyte_q) {
			case 2:
				mes "[Father Mareusis]";
				mes "请拜访普隆德拉教区成员^000077Rubalkabara神父^000000后回来。";
				next;
				mes "[Father Mareusis]";
				mes "他正在^000077普隆德拉城东北的遗迹^000000修行。";
				break;
			case 3:
				mes "[Father Mareusis]";
				mes "请拜访^000077Mathilda修女^000000后回来。";
				next;
				mes "[Father Mareusis]";
				mes "她正在^000077普隆德拉城西南的梦罗克镇附近^000000修行。";
				break;
			case 4:
				mes "[Father Mareusis]";
				mes "请拜访^000077Yosuke神父^000000后回来。";
				next;
				mes "[Father Mareusis]";
				mes "他正在^000077普隆德拉西北某座桥附近^000000修行。";
				break;
			}
			next;
			mes "[Father Mareusis]";
			mes "愿上帝的恩典照亮你的道路，引导你的苦修之旅。";
			close;
		}
		mes "嗯……";
		mes "你的名字在名单上，也证明了你的资格。";
		next;
		mes "[Father Mareusis]";
		mes "我很自豪地宣布，你已经准备好成为服事了！";
		next;
		skill "NV_TRICKDEAD",0,SKILL_PERM;
		callfunc "Job_Change",Job_Acolyte;
		callfunc "F_ClearJobVar";
		if(checkquest(1001) != -1) {
			completequest 1001;
		}
		else if(checkquest(1002) != -1) {
			completequest 1002;
		}
		else {
			completequest 1003;
		}
		mes "[Father Mareusis]";
		mes "永远记得感谢一直照顾我们的上帝。";
		next;
		mes "[Father Mareusis]";
		mes "用你的天赋帮助他人、侍奉上帝。在困难时期以坚定的信仰面对苦难。";
		next;
		mes "[Father Mareusis]";
		mes "最后，衷心祝贺你坚持完成了苦修试炼。";
		close;
	case 2:
		mes "[Father Mareusis]";
		mes "你想成为服事吗？必须满足两个要求。";
		next;
		mes "[Father Mareusis]";
		mes "首先，初心者职业等级至少达到9并学会所有基础技能。其次，你必须完成苦修试炼。";
		next;
		mes "[Father Mareusis]";
		if (job_acolyte_q != 0) {
			switch(job_acolyte_q) {
			case 2:
				mes "试炼期间请拜访^000077Rubalkabara神父^000000后回来。";
				next;
				mes "[Father Mareusis]";
				mes "他正在^000077普隆德拉城东北的遗迹^000000修行。";
				break;
			case 3:
				mes "试炼期间请拜访^000077Mathilda修女^000000后回来。";
				next;
				mes "[Father Mareusis]";
				mes "她正在^000077普隆德拉城西南的梦罗克^000000附近修行。";
				break;
			default:
				mes "试炼期间请拜访^000077Yosuke神父^000000后回来。";
				next;
				mes "[Father Mareusis]";
				mes "他正在^000077普隆德拉西北某座桥^000000附近修行。";
				break;
			}
			next;
			mes "[Father Mareusis]";
			mes "愿上帝的恩典照亮你的道路，引导你的苦修之旅。";
		}
		else {
			mes "填写申请表后，系统会决定这次试炼的目的地。";
		}
		next;
		mes "[Father Mareusis]";
		mes "满足我提出的两个要求后再回来。只要你真心想侍奉上帝和帮助他人，就一定能做到。";
		close;
	case 3:
		close;
	}
}

prt_fild03,365,255,2	script	Ascetic#aco	89,{
	mes "[Father Rubalkabara]";
	if (BaseJob == Job_Novice) {
		if (job_acolyte_q == 6) {
			mes "请保重。你到达普隆德拉圣堂时，他们应该已经知道你见过我了。";
			next;
			mes "[Father Rubalkabara]";
			mes "我已让信鸽带去消息，希望它能安全抵达……";
			close;
		}
		if (job_acolyte_q != 0) {
			if (job_acolyte_q == 2) {
				mes "哦……？你一定是想成为服事的人。我已经收到圣堂消息，知道你可能会来。";
				next;
				mes "[Father Rubalkabara]";
				mes "你的名字是" + strcharinfo(0) + "，对吧？很好，谢谢你来看我。";
				next;
				mes "[Father Rubalkabara]";
				mes "我想Mareusis神父已经告诉你许多关于服事的事。普隆德拉圣堂还有很多能帮助你的人。";
				next;
				mes "[Father Rubalkabara]";
				mes "我想没必要教你太多。而且像你这样的年轻人，听我这个老人说话可能会觉得困难。哈哈哈～";
				next;
				mes "[Father Rubalkabara]";
				mes "不过，教训可能来自最意想不到的地方。上帝喜欢用奇妙的方式教导孩子。你会看到的。";
				next;
				mes "[Father Rubalkabara]";
				mes "我会发消息告诉他们你来过。现在你可以回普隆德拉圣堂了。";
				next;
				mes "[Father Rubalkabara]";
				mes "再见。";
				close2;
				savepoint "prt_fild03",361,255,1,1;
				set job_acolyte_q,6;
				end;
			}
			else {
				mes "Oh...";
				mes "你是服事申请者吗……？";
				mes "让我看看……";
				mes "";
				next;
				mes "[Father Rubalkabara]";
				mes "你的名字是" + strcharinfo(0) + "？";
				mes "我想你的名字不在名单上。嗯……";
				mes "";
				next;
				mes "[Father Rubalkabara]";
				mes "回普隆德拉圣堂再确认一次吧。";
				close;
			}
		}
		else {
			mes "咦？你为什么来这里？对你这样的初心者来说，这里非常危险！";
			close;
		}
	}
	else if (BaseJob == Job_Acolyte) callfunc "F_FatherRub";
	else {
		if (BaseJob == Job_Priest) {
			mes "你好。";
			next;
			mes "[Father Rubalkabara]";
			mes "欢迎来到深处。坐下来和我一起思考上帝的讯息吧。这里很美，尽管宁静中伴随着危险……";
			close;
		}
		else {
			mes "哦呵……";
			mes "你是来这里训练的，还是只是个漫游者？";
			next;
			mes "[Father Rubalkabara]";
			mes "不管你是谁，请保重。这里的怪物外表可爱，实力却强得惊人。";
			close;
		}
	}
}

moc_fild07,41,355,4	script	Ascetic#2aco	95,{
	mes "[Mother Mathilda]";
	if (BaseJob == Job_Novice) {
		if (job_acolyte_q == 7) {
			mes "我会让信鸽把消息送到普隆德拉圣堂。你回去时，那里负责的神父应该已经收到消息。";
			next;
			mes "[Mother Mathilda]";
			mes "我会向上帝祈祷，希望你早日成为服事。";
			close;
		}
		if (job_acolyte_q != 0) {
			if (job_acolyte_q == 3) {
				mes "啊，你一定是服事申请者。真诚欢迎你。";
				next;
				mes "[Mother Mathilda]";
				mes "你的名字是" + strcharinfo(0) + "？让我看看……啊，你在名单上。";
				next;
				mes "[Mother Mathilda]";
				mes "我会向圣堂确认" + strcharinfo(0) + "来过这里并完成了苦修。";
				next;
				mes "[Mother Mathilda]";
				mes "请回普隆德拉圣堂，和负责的神父谈谈。";
				mes "";
				close2;
				savepoint "moc_fild07",35,355,1,1;
				set job_acolyte_q,7;
				end;
			}
			else {
				mes "啊……！";
				mes "你一定是服事申请者。真诚欢迎你。";
				next;
				mes "[Mother Mathilda]";
				mes "你的名字是什么？";
				mes "" + strcharinfo(0) + "？让我看看……";
				next;
				mes "[Mother Mathilda]";
				mes "嗯……";
				mes "你的名字似乎不在名单上……";
				next;
				mes "[Mother Mathilda]";
				mes "也许你应该回普隆德拉圣堂，再次确认苦修试炼的目的地。";
				close;
			}
		}
		else {
			mes "...";
			close;
		}
	}
	else if (BaseJob == Job_Acolyte) callfunc "F_MotherMart";
	else {
		if (BaseJob == Job_Priest) {
			mes "你好～";
			next;
			mes "[Mother Mathilda]";
			mes "修行进展如何？希望你享受生活在上帝恩典中的时光。";
			close;
		}
		else {
			mes "愿上帝";
			mes "与你同在……";
				mes "";
			close;
		}
	}
}

prt_fild00,208,218,6	script	Ascetic#3aco	98,{
	mes "[Father Yosuke]";
	if (BaseJob == Job_Novice) {
		if (job_acolyte_q == 8) {
			mes "什么？";
			next;
			mes "[Father Yosuke]";
			mes "你还有什么事吗？！没有就现在回圣堂！";
			close;
		}
		if (job_acolyte_q != 0) {
			if (job_acolyte_q == 4) {
				mes "嘿。";
				mes "不管你是谁，";
				mes "看起来像服事申请者。";
				mes "对吧？";
				next;
				mes "[Father Yosuke]";
				mes "不错，不错。你很好地完成了苦修试炼。";
				mes "你的名字是什么？";
				mes "";
				next;
				mes "[Father Yosuke]";
				mes "" + strcharinfo(0) + "，嗯？";
				next;
				mes "[Father Yosuke]";
				mes "好。我会向圣堂报告" + strcharinfo(0) + "来拜访过我。";
				next;
				mes "[Father Yosuke]";
				mes "现在回圣堂完成服事转职吧，小子。";
				close2;
				savepoint "prt_fild00",206,230,1,1;
				set job_acolyte_q,8;
				end;
			}
			else {
				mes "嘿。";
				mes "你看起来像服事申请者，对吗？";
				next;
				mes "[Father Yosuke]";
				mes "不错，你从普隆德拉一路来到这里。你的名字是什么，小子？";
				next;
				mes "[Father Yosuke]";
				mes "" + strcharinfo(0) + "，嗯？你的名字为什么不在我的名单上？";
				next;
				mes "[Father Yosuke]";
				mes "你可能弄错了。回圣堂找主教确认吧。";
				mes "";
				close;
			}
		}
		else {
			mes "你……";
			mes "初心者。";
			mes "有什么";
			mes "想告诉我的吗？";
			close;
		}
	}
	else if (BaseJob == Job_Acolyte) callfunc "F_FatherYos";
	else {
		if (BaseJob == Job_Priest) {
			mes "嘿……";
			next;
			mes "[Father Yosuke]";
			mes "如果愿意，就来和我一起坐着冥想伟大的真理。上帝的威严确实令人敬畏……";
			close;
		}
		else {
			mes "你有什么想说的吗？不过很遗憾，";
			mes "我没有任何回复。";
			close;
		}
	}
}

//===== rAthena Script =======================================
//= Old Pharmacist
//===== By: ==================================================
//= DZeroX
//===== Current Version: =====================================
//= 1.4
//===== Compatible With: =====================================
//= rAthena Project
//===== Description: =========================================
//= Trade in items for potions.
//= Breakdown of arguments used:
//= arg(0): Herb required.
//= arg(1): Zeny cost.
//= arg(2): Potion given.
//===== Additional Comments: =================================
//= 1.0 Fully working. [DZeroX]
//= 1.0a Minor fixes [Lupus]
//= 1.1 Added changed the dialogs and name to fit the
//=     the official information. [DZeroX]
//= 1.1a Removed .GATs [Lupus]
//= 1.1b Fixed a bug in Orange Potion creating. Copy&Pasting = bad. [L0ne_W0lf]
//= 1.2 Added checkweight, and input min/max values. [L0ne_W0lf]
//= 1.3 Fixed minor condition check bug. (bugreport:597) [L0ne_W0lf]
//= 1.4 Updated to match AEGIS script. [Kisuka]
//============================================================

alberta_in,16,28,4	script	Pharmacist	61,{
	if (checkweight(1201,1) == 0) {
		mes "- 等一下！-";
		mes "- 你当前携带了";
		mes "- 太多物品。-";
		mes "- 请稍后再来";
		mes "- 把一些物品存入卡普拉仓库后。-";
		close;
	}
	mes "[老药剂师]";
	mes "嗯嗯……";
	mes "你来这里做什么……？";
	next;
	switch(select("制作药水:交谈:调配信息:取消")) {
	case 1:
		if (MaxWeight - Weight < 5000) {
			mes "[老药剂师]";
			mes "你为什么带这么多东西！";
			mes "别贪心，只带你需要的数量！";
			next;
			mes "[老药剂师]";
			mes "你太重了，无法从我这里领取药水……";
			mes "先把一些物品存进仓库吧！";
			close;
		} else {
			mes "[老药剂师]";
			mes "材料都准备好了，对吧？你想要哪一种？";
			next;
			switch(select("红色药水:橙色药水:黄色药水:白色药水:蓝色药水:绿色药水:其实我什么都不要")) {
			case 1:
				callsub L_Making,507,3,501;
			case 2:
				mes "[老药剂师]";
				if (countitem(507) < countitem(713)) {
					set .@max,countitem(507);
				}
				else if (countitem(508) < countitem(713)) {
					set .@max,countitem(508);
				}
				else {
					set .@max,countitem(713);
				}
				if ((countitem(507) < 1) || (countitem(508) < 1) || (countitem(713) == 0)) {
					mes "你这个坏家伙！你以为会怎样？！空手来这里。啧！";
					mes "走开！";
					close;
				}
				if (Zeny < 3) {
					mes "你这个坏家伙！你以为会怎样？！空手来这里。啧！";
					mes "走开！";
					close;
				}
				mes "要多少？";
				next;
				switch(select("尽可能多地制作:我想选择数量:其实我什么都不要")) {
				case 1:
					if ((countitem(507) < .@max) || (countitem(508) < .@max) || (countitem(713) < .@max) || (Zeny < .@max*3)) {
						mes "[老药剂师]";
						mes "你这个坏家伙！材料都不齐还想让我制作药水？！";
						close;
					}
					set Zeny,Zeny-(.@max*5);
					delitem 507,.@max; //Red_Herb
					delitem 508,.@max; //Yellow_Herb
					delitem 713,.@max; //Empty_Bottle
					getitem 502,.@max; //Orange_Potion
					break;
				case 2:
					mes "[老药剂师]";
					mes "选择一个低于 100 的数量。不想要就输入‘0’。按你现有的材料，大约可以制作 "+.@max+" 瓶药水。";
					next;
					input .@amount,0,101;
					if (.@amount == 0) {
						mes "[老药剂师]";
						mes "你决定好了吗？！";
						close;
					}
					if (.@amount > 100) {
						mes "[老药剂师]";
						mes "你聋了吗？我说少于 100！";
						close;
					}
					if ((countitem(507) < .@amount) || (countitem(508) < .@amount) || (countitem(713) < .@amount) || (Zeny < .@amount*3)) {
						mes "[老药剂师]";
						mes "你这个坏家伙！材料都不齐还想让我制作药水？！";
						close;
					}
					next;
					set Zeny,Zeny-(.@amount*5);
					delitem 507,.@amount; //Red_Herb
					delitem 508,.@amount; //Yellow_Herb
					delitem 713,.@amount; //Empty_Bottle
					getitem 502,.@amount; //Orange_Potion
					break;
				case 3:
					mes "[老药剂师]";
					mes "什么？！";
					mes "呃……";
					mes "呸！";
					mes "走开！";
					close;
				}
				mes "[老药剂师]";
				mes "给你，都做好了。拿去吧。但记住！滥用药物可不好。";
				close;
			case 3:
				callsub L_Making,508,10,503;
			case 4:
				callsub L_Making,509,20,504;
			case 5:
				callsub L_Making,510,30,505;
			case 6:
				callsub L_Making,511,3,506;
			case 7:
				mes "[老药剂师]";
				mes "什么？！";
				mes "呃……";
				mes "呸！";
				mes "走开！";
				close;
			}
		}
	case 2:
		mes "[老药剂师]";
		mes "药物可以增强人的恢复能力，但效果有限。*叹气*我开始想念年轻时的日子了。我一定是老了。";
		next;
		mes "[老药剂师]";
		mes "总之，药水就是药水，不多不少。";
		close;
	case 3:
		mes "[老药剂师]";
		mes "哼……";
		mes "你们年轻人真烦。不过既然你问了，我就解释一下。";
		next;
		mes "[老药剂师]";
		mes "草药本身就很好，但用我的特殊技术和技巧把它们制成药水，效果会强得多。";
		next;
		mes "[老药剂师]";
		mes "只要你诚恳有礼地请求，我就会为你制作。不过不是免费的……别担心，我只收少量费用，并不贵。";
		next;
		mes "[老药剂师]";
		mes "红色药水 - ^0098E52 个红色药草、1 个空瓶、2 Zeny 费用。^000000";
		mes "橙色药水 - ^0098E51 个红色药草、1 个黄色药草、1 个空瓶、5 Zeny 费用。^000000";
		mes "黄色药水 - ^0098E52 个黄色药草、1 个空瓶、10 Zeny。^000000";
		next;
		mes "[老药剂师]";
		mes "白色药水 - ^0098E52 个白色药草、1 个空瓶、20 Zeny 费用。^000000";
		mes "蓝色药水 - ^0098E52 个蓝色药草、1 个空瓶、30 Zeny 费用。^000000";
		mes "绿色药水 - ^0098E52 个绿色药草、1 个空瓶、3 Zeny 费用。^000000";
		close;
	case 4:
		mes "[老药剂师]";
		mes "真无聊。如果有话要说，为什么不直说？！";
		close;
	}
	
L_Making:
	.@item_req = getarg(0);
	.@req_amount = getarg(1);

	mes "[老药剂师]";
	if ((countitem(.@item_req)/2) < countitem(713)) {
		.@max = countitem(.@item_req) /2;
	} else {
		.@max = countitem(713);
	}
	if (countitem(.@item_req) < 2 || countitem(713) == 0) {
		mes "你这个坏家伙！你以为会怎样？！空手来这里。啧！";
		mes "走开！";
		close;
	}
	if (Zeny < 3) {
		mes "你这个坏家伙！你以为会怎样？！空手来这里。啧！";
		mes "走开！";
		close;
	}
	mes "要多少？";
	next;
	switch(select("尽可能多地制作:我想选择数量:其实我什么都不要")) {
	case 1:
		if ((countitem(.@item_req) < .@max*2) || countitem(713) < .@max || (Zeny < .@max*.@req_amount)) {
			mes "[老药剂师]";
			mes "你这个坏家伙！材料都不齐还想让我制作药水？！";
			close;
		}
		Zeny = Zeny - (.@max*.@req_amount);
		delitem .@item_req,.@max*2;
		delitem 713,.@max; //Empty_Bottle
		getitem getarg(2),.@max; 
		break;
	case 2:
		mes "[老药剂师]";
		mes "选择一个低于 100 的数量。不想要就输入‘0’。按你现有的材料，大约可以制作 "+.@max+" 瓶药水。";
		next;
		input .@amount;
		if (.@amount == 0) {
			mes "[老药剂师]";
			mes "你决定好了吗？！";
			close;
		}
		if (.@amount > 100) {
			mes "[老药剂师]";
			mes "你聋了吗？我说少于 100！";
			close;
		}
		if ((countitem(.@item_req) < .@amount*2) || countitem(713) < .@amount || (Zeny < .@amount*.@req_amount)) {
			mes "[老药剂师]";
			mes "你这个坏家伙！材料都不齐还想让我制作药水？！";
			close;
		}
		Zeny = Zeny - (.@max*.@req_amount);
		delitem .@item_req,.@amount*2;
		delitem 713,.@amount; //Empty_Bottle
		getitem getarg(2),.@amount; 
		break;
	case 3:
		mes "[老药剂师]";
		mes "什么？！";
		mes "呃……";
		mes "呸！";
		mes "走开！";
		close;
	}
	mes "[老药剂师]";
	mes "给你，都做好了。拿去吧。但记住！滥用药物可不好。";
	close;
}

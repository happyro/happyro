	next;
	mes "[弓箭手乔]";
	mes "嘿，你~！";
	mes "听说过";
	mes "著名的斐扬吗？";
	next;
	switch(select("当然听说过~！:斐……扬？:……")) {
	case 1:
		mes "[弓箭手乔]";
		mes "哦！你真懂行！";
		mes "你知道斐扬弓箭手！";
		mes "我们从不失手！即使相隔很远，敌人的心脏也不安全！";
		next;
		if (select("所以，你喜欢这里，对吧？:哈哈哈~") == 1) {
			mes "[弓箭手乔]";
			mes "是的！我喜欢这里！";
			mes "我太喜欢这座城市了，";
			mes "甚至一直在研究它！想知道斐扬的任何事，尽管问我！";
			next;
			switch(select("这里的人穿着独特服装:镇中心的建筑是什么？:那边喝酒的家伙是谁？:下次再聊")) {
			case 1:
				mes "[弓箭手乔]";
				mes "是的，我同意。";
				mes "你应该知道，这里曾因茂密森林和山区而与世隔绝。";
				next;
				mes "[弓箭手乔]";
				mes "因此斐扬发展出独特文化，与卢恩·米德加尔兹其他地区大不相同。";
				next;
				mes "[弓箭手乔]";
				mes "这件服装是斐扬传统服饰！你不试着穿一件吗？很舒服~";
				break;
			case 2:
				mes "[弓箭手乔]";
				mes "你是说中央宫殿？外人不能进入那里。据说王室和外来的朋友会在那里聚会。";
				next;
				mes "[弓箭手乔]";
				mes "我也想什么时候去看看里面是什么样！";
				break;
			case 3:
				mes "[弓箭手乔]";
				mes "哦！那家伙臭名昭著！";
				mes "无论如何，别请他喝酒！";
				mes "你会后悔的！";
				break;
			case 4:
				mes "[弓箭手乔]";
				mes "好！";
				mes "再见！";
				mes "下次见！";
				break;
			}
		}
		close;

	case 2:
		mes "[弓箭手乔]";
		mes "真遗憾……";
		mes "你怎么会没听说过";
		mes "斐扬弓箭手？";
		next;
		mes "[弓箭手乔]";
		mes "等你更多了解我们后，";
		mes "我们再聊，我会告诉你斐扬弓箭手";
		mes "为什么如此伟大！";
		mes "";
		break;
	case 3:
		mes "[弓箭手乔]";
		mes "你为什么";
		mes "这么安静？";
		mes "你不是害羞吧？";
		mes "来吧，没理由";
		mes "在我面前害羞~";
		break;
	}
	close;
}
// 保持翻译切片物理行数

//===== rAthena Script =======================================
//= Eclage Quests
//===== Description: =========================================
//= [Official Conversion]
//-- Quest NPCs related to Eclage:
//- Teleport Cats
//- Eclage's Entrance
//- Oliver Wolf Hood (Dreaming Time)
//- Wanted to be Big and Beautiful
//- Mystery Burglary Quest
//- Troublesome Fairies (Prankster of Eclage)
//- Light and Darkness
//- Laphines That Love The Land (Lost Adventurers)
//- Memory of Professor Worm
//- Encounter in a Strange Land
//===== Changelogs: ==========================================
//= 1.0 Converted from the official Aegis script. [Dastgir]
//= 1.1 Converted from Hercules Script to rAthena Script. [Skorm]
//= 1.2 Clean-up. [Capuche]
//============================================================

// Teleport Cats (14.2 Cat Paw Addition)
//============================================================
-	script	Teleport Cat#ep14_2	-1,{
	switch(atoi(charat(strnpcinfo(1),16))) {
	case 1:
		setarray .@map$[0],"Entrance to Mora";
		setarray .@cost[0],15;// Amount Canned Food
		break;
	case 2:
		setarray .@map$[0],"Near Eclage","Near Splendide";
		setarray .@cost[0],15,55;
		break;
	case 3:
		setarray .@map$[0],"Entrance to Mora","Midgard Allied Forces Post";
		setarray .@cost[0],55,10;
		break;
	case 4:
		setarray .@map$[0],"Near Splendide","Manuk Field";
		setarray .@cost[0],10,10;
		break;
	case 5:
		setarray .@map$[0],"Midgard Allied Forces Post","Near El Dicastes";
		setarray .@cost[0],10,20;
		break;
	case 6:
		setarray .@map$[0],"Manuk Field";
		setarray .@cost[0],20;
		break;
	}
	mes "[Teleport Cat]";
	mes "天气真好，不是吗！";
	mes "欢迎来到猫爪商团。我们会竭尽全力让顾客满意。你想的话，我们甚至可以躺下给你看！";
	next;
	mes "[Teleport Cat]";
	mes "我们利用积累的知识提供各地区间的传送服务。我们接受马来港罐头特产或Zeny，你喜欢怎么支付都行~";
	next;
	set .@menu$,"Forget it:";
	for (.@i = 0; .@i < getarraysize(.@map$); .@i++) {
		set .@menu$, .@menu$+
			.@map$[.@i]+" ("+.@cost[.@i]+" Canned Food):"+
			.@map$[.@i]+" ("+callfunc("F_InsertComma",.@cost[.@i]*1000)+" Zeny):";
	}
	.@i = select(.@menu$) -2;
	if (.@i == -1) {
		mes "[Teleport Cat]";
		mes "那之后再见。";
		close;
	}
	.@choice$ = .@map$[.@i/2];
	.@price = .@cost[.@i/2];
	if (.@i % 2) {
		.@price = .@price*1000;
		if (Zeny < .@price) {
			mes "[Teleport Cat]";
			mes "恐怕这不够。抱歉，不能免费~";
			close;
		}
		Zeny = Zeny -.@price;
	} else {
		if (countitem(12636) < .@price) {
			mes "[Teleport Cat]";
			mes "恐怕这不够。抱歉，不能免费~";
			close;
		}
		delitem 12636,.@price;// Malang_Sp_Can
	}
	if (.@choice$ == "Midgard Allied Forces Post") warp "mid_camp",180,247;
	else if (.@choice$ == "Manuk Field") warp "man_fild02",133,47;
	else if (.@choice$ == "Near Splendide") warp "spl_fild02",51,240;
	else if (.@choice$ == "Near El Dicastes") warp "dic_fild01",159,264;
	else if (.@choice$ == "Entrance to Mora") warp "bif_fild02",291,323;
	else if (.@choice$ == "Near Eclage") warp "ecl_fild01",116,309;
	end;
}
ecl_fild01,118,311,4	duplicate(Teleport Cat#ep14_2)	Teleport Cat No.1	4_M_BOSSCAT
bif_fild02,293,325,4	duplicate(Teleport Cat#ep14_2)	Teleport Cat No.2	4_M_BOSSCAT
spl_fild02,53,242,4	duplicate(Teleport Cat#ep14_2)	Teleport Cat No.3	4_M_BOSSCAT
mid_camp,207,234,4	duplicate(Teleport Cat#ep14_2)	Teleport Cat No.4	4_M_BOSSCAT
man_fild02,135,49,4	duplicate(Teleport Cat#ep14_2)	Teleport Cat No.5	4_M_BOSSCAT
dic_fild01,161,266,4	duplicate(Teleport Cat#ep14_2)	Teleport Cat No.6	4_M_BOSSCAT

// Eclage's Entrance
//============================================================
ecl_fild01,97,322,0	script	#ep14_2Entrance	WARPNPC,3,3,{
	end;
OnTouch:
	if (ep14_2_oliver < 3) {
		mes "[Security Guard]";
		mes "请稍等。";
		mes "所有第一次来Eclage的访客必须填写必要表格后才能进入。";
		close;
	}
	warp "eclage",100,28;
	end;
}

ecl_fild01,94,322,5	script	Security Guard#ep14_2	4_M_FAIRYSOLDIER,{
	mes "[Security Guard]";
	if (ep14_2_oliver == 0) {
		mes "所有第一次来Eclage的访客必须在这里填写必要表格后才能进入。";
		next;
		mes "[Security Guard]";
		mes "请理解，最近通过彩虹桥从米德加尔特涌入的人增加，所以我们不得不建立这套流程。";
		next;
		mes "[Security Guard]";
		mes "当然，文件用于出入管理后会被妥善保管，所以不用担心。";
		next;
		if (select("填写表格。:算了。") == 2) {
			mes "[Security Guard]";
			mes "请注意，不填写表格就无法进入城市。";
			close;
		}
		mes "[Security Guard]";
		mes "请在这里填写姓名、职业和等级。";
		next;
		mes "填写姓名。";
		input .@inputstr$;
		next;
		mes "填写职业。";
		input .@inputstr$;
		next;
		mes "填写等级。";
		input .@inputstr$;
		next;
		mes "[Security Guard]";
		mes "填好表格后，请交给那边的管理员。";
		mes "可能需要等待，请慢慢来。";
		ep14_2_oliver = 1;
		setquest 11310;
	} else if (ep14_2_oliver == 1) {
		mes "填写姓名、职业和等级后，请把表格交给那边的管理员。";
		mes "可能需要等待，请慢慢来。";
	} else if (ep14_2_oliver == 2) {
		mes "太好了，你完成了表格。";
		mes "欢迎来到Laphines的首都Eclage。";
		next;
		mes "[Security Guard]";
		mes "由于Eclage受到彩虹桥影响，各种族之间可以顺畅交流。";
		next;
		mes "[Security Guard]";
		mes "不需要额外翻译，步行种族也有足够的桥梁，希望你参观愉快。";
		ep14_2_oliver = 3;
		completequest 11311;
		close2;
		warp "eclage",100,28;
		end;
	} else {
		mes "欢迎来到Laphines的首都Eclage。";
		next;
		mes "[Security Guard]";
		mes "由于Eclage受到彩虹桥影响，各种族之间可以顺畅交流。";
		next;
		mes "[Security Guard]";
		mes "不需要额外翻译，步行种族也有足够的桥梁，希望你参观愉快。";
	}
	close;
}
ecl_fild01,100,323,3	duplicate(Security Guard#ep14_2)	Security Guard#ep14_2_2	4_M_FAIRYSOLDIER

ecl_fild01,111,320,3	script	Immigration Officer#ep14	4_M_FAIRYKID4,{
	mes "[Immigration Officer]";
	if (ep14_2_oliver == 0) {
		mes "你需要什么？";
		mes "如你所见，我这里很忙，除非你有需要，否则请别打扰我。";
		emotion ET_FRET;
	} else if (ep14_2_oliver == 1) {
		if (checkquest(11310,PLAYTIME) != 2) {
			mes "前面还有很多人。请等到你的顺序。";
			mes "不会等太久。";
			emotion ET_CRY;
			close;
		}
		mes "呼！抱歉让你久等了。";
		mes "访客实在太多了。";
		emotion ET_KEK;
		next;
		mes "[Immigration Officer]";
		mes "那么，请把表格放在这里……";
		next;
		mes "[???]";
		mes "这里！！这是我填好的表格！！";
		mes "这次没问题了，对吧？";
		mes "快让我进去！";
		cutin "bu_du1",2;
		emotion ET_HUK, playerattached();
		next;
		cutin "",255;
		mes "[Immigration Officer]";
		mes "我会按到达顺序接待访客，请等待你的顺序。";
		emotion ET_SWEAT;
		next;
		mes "[???]";
		mes "你在说什么！";
		mes "我明明比这些人早得多！";
		cutin "bu_du3",2;
		next;
		cutin "",255;
		mes "[Immigration Officer]";
		mes "因为你需要填写表格，所以顺序被推迟了，必须等到后面。";
		emotion ET_ANGER;
		next;
		mes "[???]";
		mes "什么？！你刚才还说按到达顺序接待访客！！！";
		cutin "bu_du5",2;
		next;
		cutin "",255;
		mes "[Immigration Officer]";
		mes "是的，我是这么说了，但是……";
		next;
		mes "- SMACK!!! -";
		next;
		mes "[???]";
		mes "啊！！你为什么打我？";
		cutin "bu_du4",2;
		next;
		mes "[???]";
		mes "非常抱歉。";
		mes "我这个笨朋友惹麻烦了。";
		cutin "bu_mark3",0;
		next;
		mes "[???]";
		mes "你叫谁笨蛋？！";
		cutin "bu_du5",2;
		next;
		mes "[???]";
		mes "要不是你一开始把我的名字填错，我们也不会这样等着！";
		cutin "bu_mark3",0;
		next;
		mes "[???]";
		mes "Mark Esha或Madrid，都一样！";
		cutin "bu_du3",2;
		next;
		mes "[Mark Esha]";
		mes "根本不一样！";
		mes "更何况，你怎么会不知道认识了15年的朋友的名字？";
		cutin "bu_mark4",0;
		next;
		mes "[???]";
		mes "不是我不知道——我是故意的！！";
		mes "Madrid很好！就是Madrid！";
		cutin "bu_du3",2;
		next;
		cutin "",255;
		mes "- SMACK -";
		next;
		mes "[Mark Esha]";
		mes "呼……非常抱歉，我的朋友这么笨。";
		mes "别介意我们，做你该做的事吧。";
		cutin "bu_mark3",0;
		next;
		mes "[???]";
		mes "啊啊啊！！！";
		mes "让我进去！！！！";
		mes "我还要在这里等多久！！！";
		cutin "bu_du5",2;
		next;
		mes "[Mark Esha]";
		mes "你能先安静待一会儿吗？！";
		mes "抱歉。非常抱歉。";
		cutin "bu_mark3",0;
		next;
		cutin "",255;
		mes "[Immigration Officer]";
		mes "哦，天啊，真是太疯狂了。";
		mes strcharinfo(0) +" Here, your documents are processed.";
		mes "去和安保人员谈过后，你就可以进入城市。";
		emotion ET_GO;
		next;
		mes "[???]";
		mes "沙沙，沙沙";
		cutin "bu_oliver0",0;
		next;
		cutin "",255;
		mes "[Immigration Officer]";
		mes "Deu Lean先生，请带你的队伍进去。这里实在太吵了。";
		emotion ET_FRET;
		next;
		mes "[Du Lian]";
		mes "哇哈哈！！";
		mes "看到了吗？！";
		mes "多亏了我，我们更快通过了！";
		cutin "bu_du1",2;
		next;
		mes "[Mark Esha]";
		mes "你是说更慢了……";
		cutin "bu_mark4",0;
		next;
		mes "[Du Lian]";
		mes "真正的男人不会被过去拖住！！";
		mes "我填文件可能慢了点，但我会第一个进入Eclage！";
		mes "哇哈哈！";
		cutin "bu_du2",2;
		next;
		mes "[Mark Esha]";
		mes "......Whew";
		mes "为这一切我非常抱歉。";
		cutin "bu_mark2",0;
		next;
		mes "[???]";
		mes "嗯……";
		mes "Mark先生，Du先生已经走了。";
		cutin "bu_maggi3",2;
		next;
		mes "[Mark Esha]";
		mes "哦………………..";
		mes "哦………………...........";
		cutin "bu_mark3",0;
		next;
		mes "[Mark Esha]";
		mes "我的天……";
		emotion ET_PROFUSELY_SWEAT, playerattached();
		ep14_2_oliver = 2;
		changequest 11310,11311;
		close2;
		cutin "",255;
		end;
	}
	else if (ep14_2_oliver <= 3) {
		mes "哦，天啊，真是太疯狂了。";
		mes strcharinfo(0) +" Here, your documents are processed.";
		mes "去和安保人员谈过后，你就可以进入城市。";
		emotion ET_GO;
	}
	else {
		mes "好了，请队伍里的下一位！";
		mes "下一位！";
		mes "下一位！";
		next;
		mes "[Immigration Officer]";
		mes "啊……";
		mes "我觉得访客太多并不是什么好事。";
		emotion ET_CRY;
	}
	close;
}


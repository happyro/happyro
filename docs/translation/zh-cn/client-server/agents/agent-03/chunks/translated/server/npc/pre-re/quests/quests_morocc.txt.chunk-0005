			mes "[Ernst]";
			mes "哥……哥哥。你太专横了。我们的评估员必须有自己的立场和意见。";
			next;
			mes "[Ahrum]";
			mes "你还是性格软弱。我没有强迫他做困难的事！管他呢？我把沉默当作肯定回答！我的提案成功了！我们的约定也成立了！";
			next;
			mes "[Ernst]";
			mes "哈啊……哈哈……评估员，非常抱歉冒犯了你。对不起，但这个约定不可能实现。所以别把这当真……你知道……等猪会飞了再说……～";
			next;
			mes "[Ernst]";
			mes "现在让我回房间吧。继续努力，评估员。";
			donpcevent "Prince#another_ern::OnDisable";
			set nkprince_eisen,6;
			close;
		}
		else if (nkprince_eisen == 6) {
			mes "[Ahrum]";
			mes "我听说今天家族里有个人要来。";
			mes "但我还没找到他。";
			next;
			mes "[Ahrum]";
			mes "你的话让我担心……";
			mes "这次你想说什么……";
			mes "你见过他吗，评估员？";
			set nkprince_eisen,7;
			changequest 10012,10016;
			close;
		}
		else if (nkprince_eisen == 7) {
			mes "[Ahrum]";
			mes "啊……无聊，无聊。";
			mes "我现在正在认真苦修！";
			close;
		}
		else if (nkprince_eisen == 8) {
			mes "[Ahrum]";
			mes "你来得太频繁了。";
			mes "我知道你是忠诚的人，正在处理王国的重要事务，但你来得太多了……";
			next;
			switch(select("我有件事……:是这样吗？那再见。")) {
			case 1:
				mes "[" + strcharinfo(0) + "]";
				mes "我见到了Walter家族的人。";
				next;
				mes "[Ahrum]";
				mes "哦！真的吗？";
				mes "他为什么不来找我？";
				next;
				mes "[" + strcharinfo(0) + "]";
				mes "- 我把故事告诉Ahrum。-";
				next;
				mes "[Ahrum]";
				mes "......";
				next;
				mes "[Ahrum]";
				mes "什么！你百分百确定吗？啊啊啊……";
				next;
				mes "[Ahrum]";
				mes "......";
				next;
				mes "[Ahrum]";
				mes "非常抱歉，但我想一个人静静。现在就离开！";
				set nkprince_eisen,9;
				close2;
				warp "prt_castle",318,273;
				end;
			case 2:
				mes "[Ahrum]";
				mes "好，赶紧走吧。";
				close;
			}
		}
		else if ((nkprince_eisen == 9) || (nkprince_eisen == 10) || (nkprince_eisen == 11) || (nkprince_eisen == 12)) {
			mes "[Ahrum]";
			mes "非常抱歉，但我想一个人静静。现在就离开！";
			close2;
			warp "prt_castle",318,273;
			end;
		}
		else if (nkprince_eisen == 13) {
			mes "[Ahrum]";
			mes "我告诉过你我不想当国王，也没打算改变主意！";
			next;
			mes "[Ernst]";
			mes "哥哥！我不知道你为什么如此痛苦！你就这么软弱吗？！";
			next;
			mes "[Ahrum]";
			mes "痛苦？我？……啊啊啊……看起来是这样？嗯……确实如此。压力真大……呜呜……哈哈哈！！";
			next;
			mes "[Ernst]";
			mes "哥哥，Ahrum……？";
			next;
			mes "[Ahrum]";
			mes "……只有我能逃脱吗……总之，我是不合格的人……呜呜。但我已经做了决定。";
			next;
			mes "[Ahrum]";
			mes "Ernst。";
			next;
			mes "[Ernst]";
			mes "是……？是？";
			next;
			mes "[Ahrum]";
			mes "拿着这个。";
			next;
			mes "- 嗖。-";
			next;
			mes "- Ahrum随手把Bazerald扔给Ernst。-";
			next;
			mes "[Ernst]";
			mes "咦……这是怎么回事？Walter家族的Bazerald？为什么？";
			next;
			mes "[Ahrum]";
			mes "现在时机正好，连见证人也在！Ern，你还记得我们的约定，对吧？";
			next;
			mes "[Ernst]";
			mes "什么？约定？见证人？……啊……真、真的吗……";
			next;
			mes "[Ahrum]";
			mes "是的，真的。就是现在。";
			next;
			mes "[Ernst]";
			mes "胡说！你觉得我能对你做那种事吗？！";
			next;
			mes "[Ahrum]";
			mes "笨蛋！当国王就要果断行动。我没有机会当国王。腐败地活着，比被你杀死更糟……";
			next;
			mes "[Ernst]";
			mes "但、但是你可以像现在这样活下去！就当什么都没发生。你只要恢复原样就好。哥哥，让我帮你。把你隐藏的一切告诉我……";
			next;
			mes "[Ahrum]";
			mes "太愚蠢了！你能说自己有王者风范吗？！你现在是在同情我吗？你应该理智些！否则没有资格成为国王候选人！";
			next;
			mes "[Ernst]";
			mes "可、可是！";
			next;
			mes "[Ahrum]";
			mes "争论没有用！我别无选择。如果你不理智地一味坚持，那就不该当国王。";
			next;
			mes "[Ahrum]";
			mes "呃？！哥哥？！";
			next;
			mes "（匕首刺入声）";
			specialeffect EF_HIT2;
			set nkprince_eisen,14;
			donpcevent "Prince#another_ern::OnDisable";
			donpcevent "Prince#another_ern1::OnEnable";
			close;
		}
		else if (nkprince_eisen == 14) {
			mes "[Ernst]";
			mes "哥……哥哥……你……说过要杀了我……";
			mes "你只是想被我杀死吗……哥……哥哥……";
			mes "";
			next;
			mes "[Ahrum]";
			mes "呜呜……不是。我只是想杀你……就这样……干得好，Ern……这是合法的自卫，杀死恶人……对吧？";
			next;
			mes "[Ernst]";
			mes "哥……哥哥……现在还不晚！去找医生还能救活你！";
			next;
			mes "[Ahrum]";
			mes "太迟了……重要器官被刺穿后……我不知道怎么活下去……甚至不知道如何复生……我不需要活着。";
			next;
			mes "[Ernst]";
			mes "哥……哥哥……你怎么能这样？！";
			next;
			mes "[Ahrum]";
			mes "再见，我的弟弟……成为国王，改变这个国家。你……你能做到……咳……";
			next;
			mes "[Ernst]";
			mes "……哥哥……哥哥……为什么……为什么你的表情如此满足？为什么……哥哥……";
			next;
			mes "[Ahrum]";
			mes "呜呜……你不需要知道。顺便说，你遵守了约定……你应该成为国王……但如果你迷失、误入歧途，我随时会从地狱回来杀了你！！";
			next;
			mes "[Ernst]";
			mes "我……我不知道！我不知道发生了什么！";
			next;
			mes "[Ahrum]";
			mes "你不必知道……你只要知道我做出了牺牲。为了让我的死有意义，你必须成为好国王。这就是我的信念……就这样……咳！别忘记我的话……咳咳。";
			next;
			mes "[Ernst]";
			mes "笨蛋……傻瓜……";
			next;
			mes "[Ahrum]";
			mes "啊……评估员，你知道该怎么做吗？说话要谨慎。关于你看到、听到的一切……不要把全部经历告诉监察官。";
			next;
			mes "[Ahrum]";
			mes "Ern在这里杀死了欺凌他人的恶人……我没有机会……他表现得果断，这足以让他成为国王……";
			next;
			mes "[Ahrum]";
			mes "如果你错误地处理这件事，我的死就毫无价值……咳……你明白吗？";
			next;
			switch(select("……好，我会遵从你的意愿……:……")) {
			case 1:
				mes "[" + strcharinfo(0) + "]";
				mes "……好，我会遵从你的意愿。别担心……";
				next;
				break;
			case 2:
				mes "[" + strcharinfo(0) + "]";
				mes "......";
				next;
				mes "[Ahrum]";
				mes "无知……也是积极的……这意味着……我的提案……成功了……";
				next;
				break;
			}
			mes "[Ahrum]";
			mes "现在……我可以安详地死去了……非常……感谢……你们两个。";
			next;
			mes "[Ernst]";
			mes "哥哥……";
			next;
			mes "[Ahrum]";
			mes "那么，永别了……再见……抱歉……现在不能去钓鱼了。";
			next;
			mes "[Ernst]";
			mes "B...bro?";
			next;
			mes "[Ahrum]";
			mes "......";
			next;
			mes "[Ernst]";
			mes "哥……哥哥！";
			next;
			mes "[Ahrum]";
			mes "......";
			next;
			mes "[Ernst]";
			mes "哥哥啊啊啊啊啊！！！";
			next;
			set nkprince_eisen,15;
			set nk_prince,7;
			donpcevent "Prince#another_ern1::OnDisable";
			changequest 10024,10025;
			close2;
			warp "prt_castle",318,273;
			end;
		}
	}
	if (nk_prince < 5) {
		mes "[Prince]";
		mes "你不允许来这里。";
		mes "嗯……";
		next;
		mes "[Prince]";
		mes "别挡我的路。";
		mes "我不想和你冲突。";
		close;
	}
	else if (nk_prince > 4) {
		mes "[Prince]";
		mes "你是新的冒险者评估员吗？我是Walter家族的Eigen Ahrum。你可以简称我为Ahrum王子。";
		next;
		mes "[Ahrum]";
		mes "希望你问简短直接的问题。问题长不代表答案特别或优秀。";
		next;
		while(1) {
			mes "- 我该问什么……-";
			next;
			mes "[" + strcharinfo(0) + "]";
			mes "我想询问……";
			next;
			switch(select("你的背景故事……:你对国家的看法……:你的爱好或兴趣……:算了，我以后再来。")) {
			case 1:
				mes "[Ahrum]";
				mes "你不是只想满足对王室家族的好奇心吧？";
				next;
				mes "[Ahrum]";
				mes "从小我就喜欢体验并学习各种事物。因此我不得不忍受家人的干涉。在他们眼里，我不是合格的贵族成员。";
				next;
				mes "[Ahrum]";
				mes "但我不在意这些，我认为好国王应该忽略琐事。";
				next;
				mes "[Ahrum]";
				mes "别人可以说我的行为让他们难堪，但只要结果圆满，最终大家都会满意。难道我错了吗？";
				next;
				mes "[Ahrum]";
				mes "虽然我错过了一些人生课程，但很容易补回来。谁在乎谁能拥立我为王！我就是这样。";
				next;
				mes "[Ahrum]";
				mes "Ern总是为此唠叨，";
				mes "但我从不在意。真是个吹毛求疵的家伙。";
				next;
				mes "[Ahrum]";
				mes "我就是在他的责骂中长大的。他的话比那些在我成功后闭嘴的人更严厉。";
				next;
				mes "[Ahrum]";
				mes "他总说结果并不是唯一重要的事。";
				next;
				mes "[Ahrum]";
				mes "最重要的是，我很幸运也很荣耀，能出生在Walter这个显赫贵族家族。";
				next;
				mes "[Ahrum]";
				mes "当然，我的能力因背景而被低估。";
				mes "对此我在其他方面感到悲哀。";
				next;
				mes "[Ahrum]";
				mes "未来人们会称我为Walter家族的Eigen Ahrum，而不是Walter的Eigen Ahrum。";
				next;
				mes "[Ahrum]";
				mes "Walter家族本身就高贵而闻名，但我会让这个名字更加闪耀，让其他人为我骄傲。";
				next;
				break;
			case 2:
				mes "[Ahrum]";
				mes "我治理的国家不会像童话一样";
				mes "和谐美好。";
				mes "";
				mes "";
				next;
				mes "[Ahrum]";
				mes "当然，失败者和消沉者都有自己的问题，比如人生挑战太少。";
				next;
				mes "[Ahrum]";
				mes "我相信无限竞争的好处。坦白说，我不喜欢贵族家族选王的制度。";
				next;
				mes "[Ahrum]";
				mes "即使这些身份制度消失，";
				mes "我也会凭自己的能力和资质成为国王！哈哈哈。";
				mes "";
				emotion ET_SMILE;
				next;
				mes "[Ahrum]";
				mes "我很了解其他国王候选人。";
				mes "但我找不到一个能带领王国的杰出人物。";
				mes "";
				next;
				mes "[Ahrum]";
				mes "我不是说他们不优秀，但考虑到卢恩·米德加尔特当前的情况，他们不像出色的领袖。";
				next;
				mes "[Ahrum]";
				mes "因此，我敢说他们没有人适合这个职位。如果必须选一个能与我匹敌的人，那就是Ernst。";
				next;
				mes "[Ahrum]";
				mes "他性格柔弱，做事思虑太久，但我承认他有许多优点。他是相当高标准的候选人。";
				next;
				mes "[Ahrum]";
				mes "........";
				next;
				mes "[Ahrum]";
				mes "嗯，我说得太多了。";
				mes "为我的废话道歉，哈哈哈。";
				next;
				break;
			case 3:
				mes "[Ahrum]";
				mes "我喜欢活动。";
				mes "我受不了纸牌和棋盘这类被动游戏，";
				mes "我觉得那更适合学者型的人。";
				mes "";
				mes "";
				next;
				mes "[Ahrum]";
				mes "我弟弟Ern能长时间专注于书本或学习。";
				next;
				mes "[Ahrum]";
				mes "一旦成为国王，";
				mes "我不会整天坐着处理文件。";
				mes "";
				next;
				mes "[Ahrum]";
				mes "那对我来说太难了。";
				next;
				break;
			case 4:
				mes "[Ahrum]";
				mes "好吧……";
				mes "随你便。";
				if (nkprince_eisen == 2) {
					set nkprince_eisen,3;
				}
				else {
					set nkprince_eisen,1;
				}
				completequest 10005;
				set .@prin1,checkquest(10005);
				set .@prin2,checkquest(10006);
				set .@prin3,checkquest(10007);
				set .@prin4,checkquest(10008);
				set .@prin5,checkquest(10009);
				set .@prin6,checkquest(10010);
				set .@prin7,checkquest(10011);
				if ((.@prin1 + .@prin2 + .@prin3 + .@prin4 + .@prin5 + .@prin6 + .@prin7) == 14) {
					setquest 10012;
				}
				close;
			}
		}
	}
}

prt_castle,368,312,4	script	Prince#ern	985,{
	if (checkquest(10024) == 2) {
		mes "[Ernst]";
		mes "……哥哥，如果你愿意……";
		mes "……啊，请离开这里。";
		mes "我不想见任何人。";
		close;
	}
	else if (checkquest(10024) == 0 || checkquest(10024) == 1) {
		mes "[Ernst]";
		mes "……Ahrum哥哥……";
		close;
	}
	if (nkprince_eisen > 2) {
		if (nkprince_eisen == 3) {
			mes "[Ernst]";
			mes "你见过我哥哥Ahrum吗？他是个很棒的人，真的。";
			next;
			mes "他处理事情过于强硬，有时会把事情变复杂。但即便如此，他愿意听我的话，所以我们很少遇到严重麻烦。";
			next;
			mes "[Ernst]";
			mes "之所以如此，是因为我们兄弟关系非常亲密。";
			next;
			mes "[Ernst]";
			mes "Ahrum哥哥一直为此责备我，我觉得没必要持续这么久。但他会听我的建议并照做。";
			next;
			mes "[Ernst]";
			mes "他不是很棒吗？";
			mes "他是值得信赖、善于教导的人。";
			close;
		}
		else if (nkprince_eisen == 5) {
			mes "[Ernst]";
			mes "啊，我要和Ahrum哥哥商量计划。";
			mes "如果你没有重要的事，我就先走了。";
			close;
		}
		else if (nkprince_eisen == 6) {
			mes "[Ernst]";
			mes "啊，我听说Walter家族的人来了。你见过他吗？";
			next;
			mes "[Ernst]";
			mes "看来Ahrum哥哥也没见过他。嗯……";
			set nkprince_eisen,7;
			changequest 10012,10016;
			close;
		}
		else if (nkprince_eisen == 9) {
			mes "[Ernst]";
			mes "欢迎，评估员。";
			mes "我们坦诚相见。";
			mes "别急，慢慢完成工作吧。";
			next;
			mes "[Ernst]";
			mes "嗯……我没什么可说的了。而且Ahrum最近似乎很奇怪，我很担心。希望没什么大事。";
			set nkprince_eisen,10;
			changequest 10017,10004;
			close;
		}
		else if ((nkprince_eisen == 10) || (nkprince_eisen == 11) || (nkprince_eisen == 12)) {
			mes "[Ernst]";
			mes "Ahrum变得很奇怪。";
			mes "这不是普通的变化，而是真正的腐化。我对此感到不安。";
			next;
			mes "[Ernst]";
			mes "不该发生这种事。";
			mes "我相信Ahrum会恢复原样，但我感觉很不好。";
			close;
		}
		else if (nkprince_eisen == 15) {
			mes "[Ernst]";
			mes "啊……";
			mes "Ahrum哥哥……";
			mes "Eigen Ahrum……是的，先生。";
			next;
			mes "[Ernst]";
			mes "......";
			next;
			mes "[Ernst]";
			mes "请离开这里。我不想见任何人。";
			close;
		}
		else {
			mes "[Ernst]";
			mes "欢迎，评估员。";
			mes "感谢你的辛苦工作。评估他人很难，对吧？";
			close;
		}
	}
	if (nk_prince < 5) {
		mes "[Prince]";
		mes "你不是冒险者评估员。";
		mes "我觉得你不该在这里。";
		close;
	}
	else if (nk_prince > 4) {
		mes "[Prince]";
		mes "你好，";
		mes "你就是评估员。";
		mes "我是Geoborg王子Ernst。";
		next;
		mes "[Ernst]";
		mes "评估人的才能很辛苦。我会尽力帮助你。";
		next;
		mes "[Ernst]";
		mes "那么，谢谢你。";
		next;

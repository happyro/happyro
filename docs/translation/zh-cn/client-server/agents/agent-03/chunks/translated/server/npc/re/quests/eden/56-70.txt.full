//===== rAthena Script =======================================
//= Eden Group Quests - Mission [56 - 70]
//===== By: ==================================================
//= L0ne_W0lf
//===== Current Version: =====================================
//= 1.7
//===== Compatible With: =====================================
//= rAthena Project
//===== Description: =========================================
//= Repetable Quests for Players between Baselevel 56 - 70.
//===== Additional Comments: =================================
//= 1.0 First Version.
//= 1.1 Some little optimization here and there. [Masao]
//= 1.2 Added checkquest confirmation for -1. [Euphy]
//= 1.3 Fixed Puppet Master's Agony Quest (12217 -> 3259). [Joseph]
//= 1.4 Fixed invalid check (Magic Wand Quest). [Joseph]
//= 1.5 Optimized, based on code by Zopokx. [Euphy]
//= 1.6 Added support to Para_Team_Mark_ in Eden Group. [Ragno]
//= 1.7 Added use of F_HasEdenGroupMark function. [Ragno]
//= 1.8 Reverting Magic Wand Quest to request Trunks. [Carlosgrr]
//============================================================

moc_para01,42,38,3	script	Mission [56 - 70]	857,{
	if (!callfunc("F_HasEdenGroupMark")) {
		mes "要接取这些任务，必须先加入伊甸园集团。我要找到秘书Lime Evenor并成为成员。";
		close;
	}
	mes "这里是等级56～70冒险者的各种冒险清单。";
	next;
	mes "有许多任务，例如猎杀怪物、运送货物、寻找人员。";
	next;
	switch(select("任务1～5:任务6～10:任务11～15")) {
	case 1:
		switch(select("这是什么绷带？:危险的鳄鱼。:那不是美人鱼……:我的国家在呼唤我！")) {
			case 1: callsub L_HuntingQuest,3250,15000,5000,930,30;
			case 2: callsub L_HuntingQuest,3251,16000,6000;
			case 3: callsub L_HuntingQuest,3252,17000,8000;
			case 4: callsub L_Quest,3254,18000,8000,7043,10,1056,30;
		}
	case 2:
		switch(select("猎杀野猪:准备夏日:女人的怨恨:特殊材料:傀儡师的痛苦")) {
			case 1: callsub L_HuntingQuest,3255,16000,7000;
			case 2: callsub L_Quest,3256,15000,5000,918,30;
			case 3: callsub L_HuntingQuest,3257,17000,8000;
			case 4: callsub L_Quest,3258,16000,7000,7198,40;
			case 5: callsub L_HuntingQuest,3259,17000,7000,1060,30;
		}
	case 3:
		switch(select("烦人的苍蝇:危险的狸猫:让世界变绿:魔法杖")) {
			case 1: callsub L_HuntingQuest,3260,16000,6000;
			case 2: callsub L_HuntingQuest,3261,16000,7000;
			case 3: callsub L_Quest,3262,17000,7000,1032,40;
			case 4: callsub L_Quest,3263,18000,8000,1021,30,1019,30;
		}
	}
	end;

L_Quest:
	.@quest_id = getarg(0);
	if (checkquest(.@quest_id) == -1) {
		callsub L_Details, .@quest_id;
		next;
		mes "要接受这个任务吗？";
		next;
		if(select("接受任务。:不接受任务。") == 1) {
			if (BaseLevel < 55 || BaseLevel > 70) {
				mes "这些任务不适合我的等级。我应该找其他任务。";
				close;
			}
			setquest .@quest_id;
			mes "我已成功接受任务。完成后必须回来确认工作。";
			next;
			mes "这个任务没有时间限制。";
		}
		close;
	}
	if (getargcount() > 5) {
		if (countitem(getarg(5)) < getarg(6))
			set .@items,1; //incomplete
		else
			set .@items,2; //complete
	}
	if (checkquest(.@quest_id) < 2 && (countitem(getarg(3)) < getarg(4) || .@items == 1)) {
		mes "你有正在进行的任务。要查看详情吗？";
		next;
		if(select("查看详情。:取消。") == 1)
			callsub L_Details, .@quest_id;
		close;
	} else {
		mes "我已经很好地完成任务了。现在要报告吗？";
		next;
		if(select("报告任务。:暂时不报告。") == 1) {
			delitem getarg(3),getarg(4);
			if (.@items)
				delitem getarg(5),getarg(6);
			getexp getarg(1),getarg(2);
			erasequest .@quest_id;
			mes "你完成了任务。领取奖励吧。";
		}
		close;
	}
	end;

L_HuntingQuest:
	.@quest_id = getarg(0);
	if (checkquest(.@quest_id) == -1) {
		callsub L_Details, .@quest_id;
		next;
		mes "要接受这个任务吗？";
		next;
		if(select("接受任务。:不接受任务。") == 1) {
			if (BaseLevel < 55 || BaseLevel > 70) {
				mes "这些任务不适合我的等级。我应该找其他任务。";
				close;
			}
			setquest .@quest_id;
			mes "我已成功接受任务。完成后必须回来确认工作。";
			next;
			mes "这个任务没有时间限制。";
		}
		close;
	}
	if (getargcount() > 3) {
		if (countitem(getarg(3)) < getarg(4))
			set .@items,1; //incomplete
		else
			set .@items,2; //complete
	}
	if (checkquest(.@quest_id,HUNTING) < 2 || .@items == 1) {
		mes "你有正在进行的任务。要查看详情吗？";
		next;
		if(select("查看详情。:取消。") == 1)
			callsub L_Details, .@quest_id;
		close;
	} else if (checkquest(.@quest_id,HUNTING) == 2) {
		mes "我已经很好地完成任务了。现在要报告吗？";
		next;
		if(select("报告任务。:暂时不报告。") == 1) {
			if (.@items)
				delitem getarg(3),getarg(4);
			getexp getarg(1),getarg(2);
			erasequest .@quest_id;
			mes "你完成了任务。领取奖励吧。";
		}
		close;
	}
	end;

L_Details:
	switch(getarg(0)) {
	case 3250:
		mes "这个任务由莱赫伦的雷根贝勒公司委托。详情如下。";
		next;
		mes "雷根贝勒公司即将启动‘绿色医疗中心’项目。项目第一件产品是保健绷带。";
		next;
		mes "我们需要研究怪物被腐烂绷带包裹时的反应。";
		next;
		mes "如果有兴趣，请猎杀30只木乃伊并带来30条腐烂绷带。它们在梦罗克西边金字塔。";
		next;
		mes "完成任务后请向我们确认，我们会给予相应奖励。";
		next;
		mes "- 雷根贝勒公司主管‘Julie E Delph’ -";
		break;
	case 3251:
		mes "这个任务由海洞合作社委托。详情如下。";
		next;
		mes "最近鳄鱼变得狂暴，攻击海滩附近的女性和醉汉。";
		next;
		mes "这对符文米德加尔特最棒的度假胜地来说非常丢脸。";
		next;
		mes "如果能猎杀30只鳄鱼解决问题，就帮大忙了。";
		next;
		mes "完成任务后请向我们确认，我们会给予相应奖励。";
		break;
	case 3252:
		mes "这个任务由依斯鲁得的未知委托人委托。";
		next;
		mes "我从出生起就仰慕依斯鲁得海滩。";
		next;
		mes "小时候，我在依斯鲁得地下城发现了神秘生物，从没见过那样的东西……";
		next;
		mes "我立刻以为那是美人鱼，惊讶之下用一生研究美人鱼。";
		next;
		mes "但深入研究后发现它不是美人鱼……是的，它一点也不像其他美人鱼那么美……";
		next;
		mes "我终于查明那是鱼人，不是美人鱼！";
		next;
		mes "鱼人……我竟浪费一生研究这种怪物！请猎杀30只鱼人让我好受些。";
		next;
		mes "完成任务后请向我们确认，我们会给予相应奖励。";
		next;
		mes "-- 依斯鲁得‘失落梦境的美人鱼’ --";
		break;
	case 3254:
		mes "这个任务由符文米德加尔特王国政府官员委托。";
		next;
		mes "为防止普隆德拉洪水，我们决定建造大型水坝调节供水。";
		next;
		mes "但物资人手不足，需要收集细沙和砂砾。";
		next;
		mes "因此请大家帮忙，每人带来10份细沙和30份砂砾，以便建造水坝。";
		next;
		mes "材料可从沙人身上获得，祝你好运！";
		next;
		mes "完成任务后请向我们确认，我们会给予相应奖励。";
		next;
		mes "-- 符文米德加尔特王国政府官员Dufre Kent --";
		break;
	case 3255:
		mes "这个任务由斐扬市政厅委托。";
		next;
		mes "野生动物总是农民的麻烦。";
		next;
		mes "它们袭击农场，毁掉全部庄稼！！我们再也受不了了！";
		next;
		mes "所以请勇敢的冒险者帮忙。";
		next;
		mes "请猎杀30只野兽，拯救我们的庄稼！";
		next;
		mes "在城镇和田野附近很容易找到它们。";
		next;
		mes "完成任务后请向我们确认，我们会给予相应奖励。";
		next;
		mes "-- 斐扬市政厅成员 --";
		break;
	case 3256:
		mes "这个任务由梦罗克铁匠Aragham委托。";
		next;
		mes "你们好～～～～，冒险者！我是梦罗克最炙手可热的铁匠Aragham！";
		next;
		mes "总之，我有个儿子叫Aragam Junior，很可爱。哈哈。";
		next;
		mes "他今年夏天要参加夏令营，但不会游泳。";
		next;
		mes "我想教他，但我是铁匠，和游泳相去甚远！嘿嘿。";
		next;
		mes "不过我想，做一双脚蹼能增强他的信心～！";
		next;
		mes "制作脚蹼需要30个罗达蛙的黏脚。能带给我吗？";
		next;
		mes "完成任务后请向我们确认，我们会给予相应奖励。";
		next;
		mes "附言：别把我和Hollgrehenn或Antonio相提并论！！！！";
		next;
		mes "-- 最炙手可热的铁匠、梦罗克铁匠Aragham --";
		break;
	case 3257:
		mes "这个任务由依斯鲁得发明家Dorian委托。";
		next;
		mes "你听过女人心怀怨恨会引发自然灾害的故事吗？";
		next;
		mes "哇，所以男人要小心敏感的女人！别让她们怨恨你。";
		next;
		mes "女人能带来奇怪的现象！";
		next;
		mes "我对这个故事很着迷，正试图证明它可能是真的。";
		next;
		mes "所以我得让女人生气！哈哈，这主意真坏，对吧？";
		next;
		mes "但真的只是为了研究……请猎杀30只似乎由受害灵魂复活的素伊。";
		next;
		mes "这样我才能继续观察。";
		next;
		mes "完成任务后请向我们确认，我们会给予相应奖励。";
		next;
		mes "-- 优雅的发明家Dorian --";
		break;
	case 3258:
		mes "这个任务由斐扬的Wallah委托。";
		next;
		mes "你好，冒险者。最近好吗？身体如何？";
		next;
		mes "我是药剂师，最近很难取得特殊材料。";
		next;
		mes "我只是柔弱的女孩，怎么可能独自取得那些东西。";
		next;
		mes "所以请帮帮我。带来40片巨大叶子，就能完成我的特殊药剂！";
		next;
		mes "请尽快带来，人们需要我的药。";
		next;
		mes "完成任务后请向我们确认，我们会给予相应奖励。";
		next;
		mes "-- Wallah --";
		break;
	case 3259:
		mes "这个任务由吉芬傀儡师Woonute委托。";
		next;
		mes "你知道，傀儡师很难满足人们。";
		next;
		mes "如今人们可以自行寻找并看到各种东西。";
		next;
		mes "他们的期待越来越高，我已经无法满足。";
		next;
		mes "但如果能制作活玩具之类的新概念玩具，就会是突破。";
		next;
		mes "听说有叫魔偶的活人偶。能猎杀30只魔偶吗？再带来30根金发，它们是新玩具的好材料。";
		next;
		mes "完成任务后请向我们确认，我们会给予相应奖励。";
		next;
		mes "-- 傀儡师Woonute --";
		break;
	case 3260:
		mes "这个任务由普隆德拉灭虫员委托。";
		next;
		mes "天气变暖后，昆虫不断繁殖，已经失控。";
		next;
		mes "普隆德拉居民因家中虫子太多而无法入睡。";
		next;
		mes "所以请帮忙猎杀30只猎蝇，慢慢减少数量。";
		next;
		mes "完成任务后请向我们确认，我们会给予相应奖励。";
		next;
		mes "-- 普隆德拉灭虫员 --";
		break;
	case 3261:
		mes "这个任务由斐扬的Cheese Dongja委托。";
		next;
		mes "你听说过狸猫吗？";
		next;
		mes "丑陋的狸猫怪物正在威胁斐扬居民。";
		next;
		mes "所以需要你这样的勇敢冒险者！";
		next;
		mes "请猎杀30只狸猫，让斐扬恢复和平。";
		next;
		mes "完成任务后请向我们确认，我们会给予相应奖励。";
		next;
		mes "- 斐扬Cheese Dongja -";
		break;
	case 3262:
		mes "这个任务由梦罗克宝石商人Ibraham委托。";
		next;
		mes "贫瘠沙漠中的小小美丽花朵……多么壮观！";
		next;
		mes "种花能让世界变绿，到处都会很美。";
		next;
		mes "我计划在梦罗克沙漠种植坚韧花朵，改善土壤。";
		next;
		mes "我需要Flora的40朵食人花。虽是丑花，但仍是植物。";
		next;
		mes "希望你能猎杀Flora带来40朵食人花。你正在让世界变绿！值得骄傲！";
		next;
		mes "完成任务后请向我们确认，我们会给予相应奖励。";
		next;
		mes "-- 梦罗克Ibraham --";
		break;
	case 3263:
		mes "这个任务由斐扬铁匠Antonio委托。";
		next;
		mes "魔法杖！听说过吗？那是不可思议的魔杖！";
		next;
		mes "念出咒语挥动魔杖，就能实现愿望。";
		next;
		mes "所以我决定亲自制作。这样我就能富有又强大～！哈哈！！";
		next;
		mes "制作魔杖需要特殊材料。";
		next;
		mes "请带来30个独眼怪角和30根树枝。这样我会借给你一次魔杖。哈哈，划算吧？";
		next;
		mes "完成任务后请向我们确认，我们会给予相应奖励。";
		next;
		mes "-- 斐扬铁匠Antonio --";
		break;
	}
	return;
}

         if (.@r>=9) {
             bonus2 bSubRace,RC_DemiHuman,10;
             bonus2 bSubRace,RC_Player_Doram,10;
             bonus2 bSubRace,RC_Player_Human,10;
             bonus2 bSubRace,RC_Dragon,10;
             if (.@r>=11) {
                 bonus bDelayrate,-10;
                 if (.@r>=13) {
                     bonus bDef,200;
                     bonus bMdef,40;
                 }
             }
         }
      }

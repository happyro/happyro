// Food Merchant
-	shop	inf_ration	-1,512:-1,513:-1,515:-1,516:-1

cmd_fild07,63,268,1	script	Emergency Food Merchant#pa0829_01	4_M_BIBI,{
	mes "[Emergency Food Merchant]";
	mes "我这里有很多东西，当然不是免费的。";
	close2;
	callshop "inf_ration",1;
	end;
}

// Warp Scroll Seller
cmd_fild07,375,167,1	script	Ruins Black Trader#pa0829_01	4_F_JOB_HUNTER,{
	mes "[Ruins Black Trader]";
	mes "嘿，每次进出这里不麻烦吗？只要^0000ff20,000^000000 Zeny，就能买一张直接传送到遗迹入口的卷轴，怎么样？";
Purchase:
	next;
	switch( select( "给我一张", "不用了" )) {
		case 1:
			if (!checkweight(22980,1) || (MaxWeight - Weight) < 1000) {
				mes "你携带的物品太多，无法继续对话。";
				mes "请整理物品后再试。";
				close;
			}
			else if (Zeny < 20000) {
				mes "[Ruins Black Trader]";
				mes "你似乎没有足够的钱。卷轴售价20,000 Zeny。";
				close;
			}
			Zeny -= 20000;
			getitem 22980,1;
			mes "[Ruins Black Trader]";
			mes "交易愉快。还要更多吗？";
			goto Purchase;
		case 2:
			mes "[Ruins Black Trader]";
			mes "随时欢迎回来。";
			close;
	}
}

// Equipment Shop
cmd_fild07,57,275,5	script	Artifact Appraiser#pa0829_01	1_F_02,{
	if (!checkweight(1201,1) || (MaxWeight - Weight) < 1000) {
		mes "你携带的物品太多，无法继续对话。";
		mes "请整理物品后再试。";
		close;
	}
	.@stone_id = 6905;
	mes "[ Artifact Appraiser ]";
	mes "请选择要购买的装备类型。只要有" + getitemname(.@stone_id) + "，想买多少都可以。";
	next;
	switch (select("取消:武器:防具")) {
		case 1:
			mes "[ Artifact Appraiser ]";
			mes "想回来时随时来吧～";
			close;

		case 2:
			setarray .@equip_id,1994,1938,13323,13126,28703,2024,16038,21014,28105,18128;
			.@price = 50;
			break;

		case 3:
			setarray .@equip_id,15141,22075,20779,19033;
			.@price = 50;
			break;
	}
	.@menu$ = "Cancel:";
	for (.@i = 0; .@i < getarraysize(.@equip_id); .@i++)
		.@menu$ += getitemname(.@equip_id[.@i]) + ":";
	.@s = select(.@menu$) - 1;
	switch (.@s) {
		case 0:
			mes "[ Artifact Appraiser ]";
			mes "想回来时随时来吧～";
			close;

		default:
			.@s--;
			mes "[ Artifact Appraiser ]";
	mes "购买" + getitemname(.@equip_id[.@s]) + "需要^0000FF" + .@price + "^000000个" + getitemname(.@stone_id) + "～";
			next;
			if (select("取消:购买") == 1) {
				mes "[ Artifact Appraiser ]";
				mes "想回来时随时来吧～";
				close;
			}
			if (countitem(.@stone_id) < .@price) {
				mes "[ Artifact Appraiser ]";
				mes "你的" + getitemname(.@stone_id) + "不足，无法购买。";
				close;
			}
			mes "[ Artifact Appraiser ]";
			mes "感谢你的信任。下次再来。";
			delitem .@stone_id,.@price;
			getitem .@equip_id[.@s],1;
			close;
	}
}

// Equipment Enchanter
cmd_fild07,60,275,3	script	Artifact Enhancer#pa0829_01	4_F_JOB_BLACKSMITH,{
	if (!checkweight(1201,1) || (MaxWeight - Weight) < 1000) {
		mes "你携带的物品太多，无法继续对话。";
		mes "请整理物品后再试。";
		close;
	}
	disable_items;
	.@stone_id = 6905;
	function equip_check;
	mes "[ Artifact Enhancer ]";
	mes "如果想强化在无限空间获得的装备，你来对地方了。";
	mes "你有" + getitemname(.@stone_id) + "吗？";
	next;
	switch (select("如何附魔装备？:附魔装备。:初始化装备附魔。")) {
		case 1:
			mes "[ Artifact Enhancer ]";
			mes "探索帕罗斯灯塔下方的空间，就能获得" + getitemname(.@stone_id) + "。";
			next;
			mes "[ Artifact Enhancer ]";
			mes "有了这种材料，我就能强化你从无限空间获得的装备。";
			next;
			mes "[ Artifact Enhancer ]";
			mes "我只能附魔第3和第4槽位。";
			next;
			mes "[ Artifact Enhancer ]";
			mes "附魔过程中装备不会损坏，但初始化附魔时有很高概率损坏。";
			next;
			mes "[ Artifact Enhancer ]";
			mes "想附魔装备时再来找我。";
			break;

		case 2:
			.@stone_id = 6905;
			.@fee = 20;
			mes "[ Artifact Enhancer ]";
			mes "请选择要附魔的装备。";
			next;
			switch (select("取消:武器:铠甲:鞋子:披肩:头盔")) {
				case 1:
					mes "[ Artifact Enhancer ]";
					mes "想附魔装备时再来找我。";
					close;

				case 2:
					.@part = EQI_HAND_R;
					break;

				case 3:
					.@part = EQI_ARMOR;
					break;

				case 4:
					.@part = EQI_SHOES;
					break;

				case 5:
					.@part = EQI_GARMENT;
					break;

				case 6:
					.@part = EQI_HEAD_TOP;
					break;
			}
			.@equip_id = getequipid(.@part);
			.@refine = getequiprefinerycnt(.@part);
			equip_check(.@equip_id);
			for (.@i = 0;.@i < 4;.@i++) {
				.@card[.@i] = getequipcardid(.@part,.@i);
				.@check[.@i] = getequipcardid(.@part,.@i);
			}
			if (.@card[2] > 0) {
				mes "[ Artifact Enhancer ]";
				mes "我最多只能附魔到第三槽位。你的装备无法继续附魔。";
				close;
			}
			switch (.@part) {
				case EQI_HAND_R:
					setarray .@enchant$,
					"4700,4701:4710,4711:4720,4721",
					"4811,4810,4809,4808,4820,4821,4822,4823:4815,4814,4813,4812,4826,4827,4828,4829:4832,4833,4834,4835,4836,4837,4838,4839";
					break;

				case EQI_ARMOR:
				case EQI_SHOES:
					setarray .@enchant$,
					"4700,4701,4702,4703:4710,4711,4712,4713:4720,4721,4722,4723",
					"4795,4796,4797:4870,4871,4800:4870,4871,4800";
					break;

				case EQI_GARMENT:
				case EQI_HEAD_TOP:
					setarray .@enchant$,
					"4700,4701,4702,4703:4710,4711,4712,4713:4720,4721,4722,4723",
					"4861,4862,4867,4868,4900:4861,4862,4867,4868,4900:4861,4862,4867,4868,4900";
					break;
			}
			.@slot = (.@card[3] > 0 ? 2 : 3);
			.@index = (.@slot == 3 ? 0 : 1);
			mes "[ Artifact Enhancer ]";
			mes "你可以选择3种附魔，费用是" + .@fee + "个" + getitemname(.@stone_id) + "。";
			mes "我会确保附魔顺利完成。";
			next;
			.@type = select("退出:物理:魔法:远程") - 2;
			mes "[ Artifact Enhancer ]";
			if (.@slot == 3)
				mes "好，开始第一次附魔。";
			else
				mes "好，进行第二次附魔。";
			next;
			if (select("我以后再来。:请继续。") == 1) {
				mes "[ Artifact Enhancer ]";
				mes "改变主意的话，随时回来。";
				close;
			}
			if (countitem(.@stone_id) < .@fee) {
				mes "[ Artifact Enhancer ]";
				mes "嗯。顺便说，你似乎没听我说，你的" + getitemname(.@stone_id) + "不够。";
				close;
			}
			explode(.@T$,.@enchant$[.@index],":");
			explode(.@TT$,.@T$[.@type],",");
			.@enchant = atoi(.@TT$[rand(getarraysize(.@TT$))]);
			.@card[.@slot] = .@enchant;
			delitem .@stone_id,.@fee;
			if (callfunc("F_IsEquipIDHack", .@part, .@equip_id) || callfunc("F_IsEquipRefineHack", .@part, .@refine) || callfunc("F_IsEquipCardHack", .@part, .@check[0], .@check[1], .@check[2], .@check[3]))
				close;
			delequip .@part;
			getitem2 .@equip_id,1,1,.@refine,0,.@card[0],.@card[1],.@card[2],.@card[3];
			specialeffect2 EF_REPAIRWEAPON;
			mes "[ Artifact Enhancer ]";
			mes "嗯，完成得很好。马上检查你的装备。";
			break;
		
		case 3:
			.@stone_id = 6905;
			.@fee = 30;
			.@break_chance = 30;
			mes "[ Artifact Enhancer ]";
			mes "请选择要附魔的装备。";
			next;
			switch (select("取消:武器:铠甲:鞋子:披肩:头盔")) {
				case 1:
					mes "[ Artifact Enhancer ]";
					mes "想附魔装备时再来找我。";
					close;

				case 2:
					.@part = EQI_HAND_R;
					break;

				case 3:
					.@part = EQI_ARMOR;
					break;

				case 4:
					.@part = EQI_SHOES;
					break;

				case 5:
					.@part = EQI_GARMENT;
					break;

				case 6:
					.@part = EQI_HEAD_TOP;
					break;
			}
			.@equip_id = getequipid(.@part);
			.@refine = getequiprefinerycnt(.@part);
			equip_check(.@equip_id);
			for (.@i = 0; .@i < 4; .@i++) {
				.@card[.@i] = getequipcardid(.@part,.@i);
				.@check[.@i] = .@card[.@i];
			}
			if (.@card[3] == 0) {
				mes "[ Artifact Enhancer ]";
				mes "你的装备没有任何附魔。";
				close;
			}
			mes "[ Artifact Enhancer ]";
			mes "无限空间装备在初始化时可能损坏。你仍要继续吗？";
			next;
			if (select("退出:继续") == 1) {
				mes "[ Artifact Enhancer ]";
				mes "改变主意的话，随时回来。";
				close;
			}
			if (countitem(.@stone_id) < .@fee) {
				mes "[ Artifact Enhancer ]";
				mes "嗯。顺便说，你似乎没听我说，你的" + getitemname(.@stone_id) + "不够。";
				close;
			}
			delitem .@stone_id,.@fee;
			if (callfunc("F_IsEquipIDHack", .@part, .@equip_id) || callfunc("F_IsEquipRefineHack", .@part, .@refine) || callfunc("F_IsEquipCardHack", .@part, .@check[0], .@check[1], .@check[2], .@check[3]))
				close;
			delequip .@part;
			if (rand(1,100) > .@chance) {
				getitem2 .@equip_id,1,1,.@refine,0,.@card[0],.@card[1],0,0;
				specialeffect2 EF_REPAIRWEAPON;
				mes "[ Artifact Enhancer ]";
				mes "嗯，完成得很好。马上检查你的装备。";
			} else {
				specialeffect2 EF_REFINEFAIL;
				mes "[ Artifact Enhancer ]";
				mes "我已经提醒过你了。看来你运气不好，是吧？";
			}
			break;
	}
	close;

	function	equip_check	{
		setarray .@equip_id,1994,1938,13323,13126,28703,2024,16038,21014,28105,18128,15141,22075,20779,19033;
		if (!getarg(0)) {
			mes "[ Artifact Enhancer ]";
			mes "你是不是脱下了装备？";
			close;
		}
		if (inarray(.@equip_id,getarg(0)) == -1) {
			mes "[ Artifact Enhancer ]";
			mes "这件装备不适合附魔。别忘了只有无限空间系列装备可以附魔。";
			close;
		}
		return;
	}
}

  - Id: 312058
    AegisName: Ice_C_Orb_Pow_S
    Name: 冰川花喵之力（POW与STA）
    Type: Card
    SubType: Enchant
    Script: |
      .@g = getenchantgrade();
      .@r = getrefine();
      bonus bPow,3;
      bonus bSta,3;
      if (.@r>=9) {
         bonus bPow,1;
         bonus bSta,1;
      }
      if (.@g>=ENCHANTGRADE_D) {
         bonus bPow,2;
         bonus bSta,2;
         if (.@g>=ENCHANTGRADE_C) {
            bonus bPow,(.@r/3);
            bonus bSta,(.@r/3);
         }
      }

		next;
		mes "[King]";
		mes "因为我不需要。";
		next;
		mes "[Jojo]";
		mes "那么，冒险者，请带来^0000cd10霓虹蘑菇的闪耀孢子^000000和^0000cd10甜蜜梦魇的梦魇团块^000000。";
		setquest 14677;// Studying in Dim Light
		close;
	case 1:
	case 2:
		mes "[Jojo]";
		mes "冒险者，欢迎回来！";
		next;
		if (countitem(25264) < 10 || countitem(25265) < 10)	{
			mes "[King]";
			mes "光看就知道数量不够。";
			next;
			mes "[Jojo]";
			mes "哦，你说得对。你一定忘了我的要求。";
			next;
			mes "[Jojo]";
			mes "请带来^0000cd10霓虹蘑菇的闪耀孢子^000000和^0000cd10甜蜜梦魇的梦魇团块^000000。谢谢。";
			close;
		}
		mes "[King]";
		mes "我看他带齐了你要求的东西。快把它们调成糊状，涂到墙上。";
		next;
		mes "[Jojo]";
		mes "冒险者，谢谢你帮我研究。这些发光孢子维持不了多久。明天能再带一些来吗？";
		delitem 25264,10;// NightmareOfLump
		delitem 25265,10;// Shining_Spore
		erasequest 14677;// Studying in Dim Light
		setquest 14678;// Time to Study
		getexp 500000,500000;
		getitem 25271,1;// Illusion Stone
		close;
	}
	end;

OnTouch:
	if (ill_vampire == 16 && isbegin_quest(14677) == 0)
		npctalk "啊，冒险者！等等！", "Wizard#ilgf02", bc_self;
	if (ill_vampire > 13) {
		cloakoffnpcself( "King#ilgf01" );
		cloakoffnpcself( "Wizard#ilgf02" );
		cloakoffnpcself( "Dracula#ilgf02" );
	}
	end;

OnInit:
	cloakonnpc();

	.@main_completed$ = "isbegin_quest(14666) == 2";
	questinfo( QTYPE_QUEST, QMARK_YELLOW, (.@main_completed$ + " && checkquest(14678,PLAYTIME) == -1 && isbegin_quest(14677) == 0") );
	questinfo( QTYPE_QUEST, QMARK_YELLOW, (.@main_completed$ + " && isbegin_quest(14677) == 1 && countitem(25264) > 9 && countitem(25265) > 9") );
	questinfo( QTYPE_QUEST, QMARK_YELLOW, (.@main_completed$ + " && checkquest(14678,PLAYTIME) == 2") );
	end;
}

gef_d01_i,189,98,3	script(CLOAKED)	Dracula#ilgf02	4_DRACULA,{
	if (ill_vampire < 10) {
		mes "[Dracula]";
		mes "你来这里做什么？我建议你离开这里。";
		close;
	}
	if (ill_vampire == 10) {
		setpcblock PCBLOCK_NPC, true;
		npctalk "就喝这个人的血。", "King#ilgf01", bc_self;
		sleep2 1500;
		emotion ET_SWEAT, getnpcid(0, "Wizard#ilgf02");
		npctalk "哦，不。那是？", "Wizard#ilgf02", bc_self;
		sleep2 1500;
		npctalk "国王，我说过我们不再喝人的血了。而且这样说也不礼貌。我替他道歉。", "", bc_self;
		sleep2 2000;
		npctalk "没、没关系。", "Wizard#ilgf02", bc_self;
		sleep2 1500;
		npctalk "人类最终都会死。早一点死有什么不好？来，喝一杯。不过这个人闻起来不太好。", "King#ilgf01", bc_self;
		sleep2 2000;
		npctalk "我可以处理掉那只蝙蝠吗？", "Wizard#ilgf02", bc_self;
		sleep2 1500;
		npctalk "不许有人在我面前伤害别人。", "", bc_self;
		emotion ET_FRET, getnpcid(0, "King#ilgf01");
		npctalk "人类，你瞎了吗？我不是蝙蝠。", "King#ilgf01", bc_self;
		sleep2 1500;
		npctalk "那你是什么？", "Wizard#ilgf02", bc_self;
		specialeffect EF_PORTAL4, AREA, "King#ilgf01";
		specialeffect EF_M01, AREA, "King#ilgf01";
		cloakoffnpcself( "King#ilgf01" );
		sleep2 1500;
		npctalk "现在，我看起来像什么？", "King#ilgf01", bc_self;
		sleep2 1500;
		emotion ET_HUK, getnpcid(0, "Wizard#ilgf02");
		npctalk "*Gasp* What the hell are you?!", "Wizard#ilgf02", bc_self;
		sleep2 1500;
		npctalk "怎么，太吓人了吗？那这个怎么样？", "King#ilgf01", bc_self;
		specialeffect EF_PORTAL4, AREA, "King#ilgf01";
		specialeffect EF_M01, AREA, "King#ilgf01";
		cloakoffnpcself( "King#ilgf01" );
		sleep2 1500;
		emotion ET_CRY, getnpcid(0, "Wizard#ilgf02");
		npctalk "你、你是我？分、分身！我、我要死了吗？！", "Wizard#ilgf02", bc_self;
		sleep2 1500;
		npctalk "你害怕自己。为什么？", "King#ilgf01", bc_self;
		sleep2 2000;
		npctalk "你如此爱自己，以至于无法接受不像你的人。但看到和你一模一样的人时，你又无法忍受。为什么？", "King#ilgf01", bc_self;
		sleep2 2000;
		npctalk "看其他人类和看自己的克隆体是两回事！", "Wizard#ilgf02", bc_self;
		sleep2 1500;
		npctalk "国王，够了。别再折磨他。", "", bc_self;
		sleep2 2000;
		emotion ET_OHNO, getnpcid(0, "King#ilgf01");
		npctalk "啧，啧。面对人类时你太心软了。", "King#ilgf01", bc_self;
		specialeffect EF_PORTAL4, AREA, "King#ilgf01";
		specialeffect EF_M01, AREA, "King#ilgf01";
		cloakoffnpcself( "King#ilgf01" );
		sleep2 1000;
		npctalk "嗯……我现在能正常行动了。可以走了吗？", "Wizard#ilgf02", bc_self;
		sleep2 500;
		npctalk "可以，你走吧。", "", bc_self;
		npctalk "不行！", "King#ilgf01", bc_self;
		sleep2 500;
		npctalk "为什么不行？", "", bc_self;
		sleep2 1500;
		npctalk "他是人类，而人类总是成群结队。他会带朋友来攻击我们。你已经忘了吗？", "King#ilgf01", bc_self;
		sleep2 2000;
		npctalk "不，我不会那样做。我从不忘记恩情。你救了我。我保证不会伤害你。请相信我。", "Wizard#ilgf02", bc_self;
		sleep2 2000;
		npctalk "人类永远不可信。", "King#ilgf01", bc_self;
		sleep2 2000;
		npctalk "我同意他可能会带朋友来，但不是所有人类都不可信。", "", bc_self;
		npctalk "你站哪边？我还是他？", "King#ilgf01", bc_self;
		setpcblock PCBLOCK_NPC, false;

		mes "[" + strcharinfo(0) + "]";
		mes "典型的魔法师……等等，那会不会是乔乔？？";
		unittalk getcharid(3), "" + strcharinfo(0) + " : Typical wizard... Wait, could that be Jojo??", bc_self;
		next;
		select("乔乔？你是乔乔吗？");
		mes "[Jojo]";
		mes "你、你是谁？";
		npctalk "看吧，我说过的！他的一个朋友已经出现了！所以我才不信任人类！", "King#ilgf01", bc_self;
		npctalk "人类？", "", bc_self;
		next;
		mes "[Jojo]";
		mes "不，不！他不是我的朋友！我发誓以前从没见过他！";
		next;
		mes "[King]";
		mes "他可能是你的朋友派来的。人类，回答我！";
		next;
		select("乔乔的同事正在找他。" );
		mes "[Stranger]";
		mes "我明白了。我们发现他受伤昏迷，就把他带来治疗。他现在已经可以离开了。";
		npctalk "不！他们会让我们陷入危险！", "King#ilgf01", bc_self;
		next;
		select("你们救了乔乔。" );
		mes "[" + strcharinfo(0) + "]";
		mes "我代表他的同事感谢你。可以告诉我你的名字吗？";
		next;
		mes "[King]";
		mes "你来这里，却不知道他是谁。他是德古拉。你不是来挑战他的吗？";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "德古拉？你说的是那个德古拉？";
		next;
		mes "[Dracula]";
		mes "冒险者，你身上有熟悉的气味。我渴望这种气味很久了。";
		npctalk "你是说他闻起来很好吃？我可以喝他的血吗？", "King#ilgf01", bc_self;
		next;
		mes "[Dracula]";
		mes "我的意思是，他闻起来像朋友，小家伙。";
		npctalk "什么朋友？我以为我是你唯一的朋友。", "King#ilgf01", bc_self;
		next;
		select("我来这里前见过波米。" );
		mes "[Dracula]";
		mes "……我明白了。她怎么样？";
		npctalk "什么？波米？", "King#ilgf01", bc_self;
		npctalk "你说的是笔记本的主人？", "Wizard#ilgf02", bc_self;
		sleep2 500;
		npctalk "她有没有告诉你关于……我的事？", "", bc_self;
		next;
		mes "[King]";
		mes "哇，所以你一直因为那个忘恩负义的女孩待在这里。是这样吗？";
		npctalk "她不是忘恩负义。她从没想要我给她的东西。", "", bc_self;
		next;
		mes "[Jojo]";
		mes "你给了她什么？";
		next;
		mes "[King]";
		mes "永恒的生命。";
		next;
		mes "[Jojo]";
		mes "永恒的生命……！";
		next;
		mes "[King]";
		mes "这是人类正常的反应！她忘恩负义！";
		npctalk "怎么，你想要吗？我可以给你。", "King#ilgf01", bc_self;
		next;
		select("她说德古拉背叛了她。" );
		emotion ET_FRET, getnpcid(0, "King#ilgf01");
		mes "[King]";
		mes "背叛她？哈？她在哪里？他当初就该让她死！";
		next;
		mes "[Dracula]";
		mes "她还没有原谅我。但我做了必须做的事。";
		next;
		select("一定有什么误会。" );
		mes "[Dracula]";
		mes "我需要人类才能生存。我藏在人类中，需要时就猎杀他们。";
		next;
		mes "[Dracula]";
		mes "有一天，教会的人发现了我。他们打着正义的名义，决心杀死我。";
		npctalk "他们很顽固。", "King#ilgf01", bc_self;
		next;
		mes "[Dracula]";
		mes "我被他们重伤，不知怎么来到了这个充满死亡和神秘能量的地方。";
		next;
		mes "[Dracula]";
		mes "我以为会死在这里，但幸运女神终于眷顾了我。";
		npctalk "谁来让他闭嘴。我讨厌这个故事。", "King#ilgf01", bc_self;
		next;
		mes "[Dracula]";
		mes "波米救了我。她把自己的血给我，让我恢复力量。我不是活人，但那天她给了我新生。";
		next;
		mes "[Jojo]";
		mes "那之后你为什么不离开？";
		next;
		mes "[Dracula]";
		mes "尽管波米很坚强，她的身体却逐渐衰弱。看着她日渐憔悴让我痛苦。我向她提供永恒生命，但她拒绝了。";
		next;
		mes "[Dracula]";
		mes "我留下来，是想在人类的她死去时陪在身边。";
		next;
		mes "[Dracula]";
		mes "在漫长的存在中，我第一次认真思考人类，以及是什么造就了他们。他们也会本能地帮助别人，不求回报。";
		next;
		mes "[Dracula]";
		mes "我通过波米了解了他们。但学到的东西无法理解，我也不真正明白。";
		next;
		mes "[Dracula]";
		mes "但这和我以前对人类的看法不同。我开始理解他们了。";
		npctalk "为什么？理解他们对你有什么好处？", "King#ilgf01", bc_self;
		next;
		mes "[Jojo]";
		mes "那你为什么违背她的愿望？";
		next;
		mes "[Dracula]";
		mes "发生了一场事故。差点杀死我的那些人又找到了我。";
		npctalk "教会的人？", "Wizard#ilgf02", bc_self;
		next;
		mes "[Dracula]";
		mes "无论我走到哪里，厄运都跟着我。波米甚至给我做了护身符，但没用。";
		next;
		mes "[Dracula]";
		mes "那时我已经完全恢复力量，那些人类不是我的对手。但波米……她不想让任何人受伤。";
		next;
		mes "[Dracula]";
		mes "总之，她被卷入交火。她濒临死亡，我慌了。";
		next;
		mes "[Dracula]";
		mes "我还没准备好放手。在来得及思考之前，我就把她变成了吸血鬼。";
		next;
		mes "[Jojo]";
		mes "你是不想失去她才这么做的。在那种情况下，我也会做同样的事。";
		npctalk "为什么？", "King#ilgf01", bc_self;
		sleep2 1000;
		npctalk "人们就是这样保护所爱之人的。", "Wizard#ilgf02", bc_self;
		next;
		mes "[King]";
		mes "但那个固执的女孩拒绝承认这一点！";
		next;
		mes "[King]";
		mes "我不理解她的逻辑。她怎么会宁愿作为人类死去，也不愿作为吸血鬼活着？怎么会认为永恒生命是背叛？";
		next;
		mes "[Jojo]";
		mes "我想我明白了。人们容易把一切视为理所当然。如果能永生，我可能会失去动力。毕竟你拥有的只有时间。";
		next;
		mes "[Jojo]";
		mes "我觉得你们需要彼此谈谈。你试过和她说话吗？";
		next;
		mes "[Dracula]";
		mes "她复活时又震惊又愤怒，根本不听我说。";
		next;
		mes "[Dracula]";
		mes "我做这一切是为了救她，我理解她因此怨恨我。";
		npctalk "你该停止和人类混在一起。你现在听起来就像他们。", "King#ilgf01", bc_self;
		next;
		mes "[King]";
		mes "德古拉，那个人类对你来说算什么？她甚至不和你说话，";
		npctalk "你为什么还要坚持留在这种地方？", "King#ilgf01", bc_self;
		next;
		mes "[Dracula]";
		mes "我不是吗？";
		next;
		emotion ET_SURPRISE, getnpcid(0, "King#ilgf01");
		mes "[King]";
		mes "大家安静。我闻到什么了。";
		erasequest 14661;// Jojo Is the Mage's Name 02
		setquest 14662;// You're Scaring Me
		ill_vampire = 11;
		close;
	}
	if (ill_vampire == 11) {
		mes "[Dracula]";
		mes "国王？是什么？";
		close;
	}
	if (ill_vampire == 12 || ill_vampire == 13) {
		mes "[Dracula]";
		mes "战斗？糟糕，我们得快点！";
		close2;
		viewpoint 1,85,131,1,0x00FF00;
		end;
	}
	if (ill_vampire == 14 || ill_vampire == 15) {
		mes "[Dracula]";
		mes "我决定等她。反正我也需要休息。";
		close;
	}
	mes "[Dracula]";
	mes "她喝的蝙蝠血有时会让她失去理智。过一会儿她会平静下来，但如果教会的人看到她脆弱的状态，就会试图杀死她。";
	close;
}


//============================================================
//= Illusion of Frozen
//============================================================
// boss summoning - 1 day of delay for now
ice_d03_i,126,126,3	script	Orb of Seal#frozen1	CLEAR_NPC,{
	if (.ill_frozen_boss_timer >= gettimetick(2)) {
		mes "这个宝珠还需要时间聚集足够能量才能运作。";
		close;
	}
	.@i = atoi( charat(strnpcinfo(2), 6) );
	.timer[.@i] = 30;
	initnpctimer;	// the effect continue after boss spawn
	if (.timer[1] > 0 && .timer[2] > 0 && .timer[3] > 0 && .timer[4] > 0) {
		.ill_frozen_boss_timer = gettimetick(2) + 86400;// respawn timer (seems to be one day)
		donpcevent "bosseff#frozen::OnEvent";
	}
	end;
OnTimer1000:
	.@i = atoi( charat(strnpcinfo(2), 6) );
	.timer[.@i]--;
	if (.timer[.@i] < 1)
		stopnpctimer;
	else {
		initnpctimer;
		specialeffect EF_DETOXICATION;
	}
	end;
}
ice_d03_i,172,126,3	duplicate(Orb of Seal#frozen1)	Orb of Seal#frozen2	CLEAR_NPC
ice_d03_i,172,173,3	duplicate(Orb of Seal#frozen1)	Orb of Seal#frozen3	CLEAR_NPC
ice_d03_i,127,172,3	duplicate(Orb of Seal#frozen1)	Orb of Seal#frozen4	CLEAR_NPC

ice_d03_i,149,112,0	script	bosseff#frozen	HIDDEN_WARP_NPC,{
	end;
OnEvent:
	initnpctimer;
	end;
OnTimer1000:
	mapannounce "ice_d03_i", "洞穴中封印的全部能量已经释放，唤醒了 Ktullanux。", bc_map, 0xFFFF00;
	end;
OnTimer3000:
	stopnpctimer;
	mapannounce "ice_d03_i", "Ktullanux: Who dares call me a lizard? I'll freeze you all!", bc_map, 0xFFFF00;
	specialeffect EF_PORTAL;
	if (mobcount("ice_d03_i", "bosseff#frozen::OnBossDead") < 1)
		monster "ice_d03_i",149,112,"Awakened Ktullanux",3796,1, "bosseff#frozen::OnBossDead";	// ILL_KTULLANUX
	end;
OnBossDead:
	mapannounce "ice_d03_i", "Ktullanux: I'll... be... back...", bc_map;
	end;
}



			mes "现在请每种带给我10个。";
			ep14_2_mylord = 17;
			changequest 7436,7437;
			close;
		case 2:
			mes "啊，真遗憾。";
			mes "那我去问别人吧。";
			close;
		}
	}
	else if (ep14_2_mylord == 17) {
		if (countitem(6561) < 10 || countitem(6560) < 10) {
			mes "我需要10个尘球和10个落叶制成的书签。";
			mes "你可以在塔里找到它们。";
			close;
		}
		mes "你找到了！";
		mes "谢谢你。";
		mes "这些应该能用一阵子。";
		next;
		select("谁是魔法学者？");
		mes "[Shenime]";
		mes "我只是私人资助他而已。";
		mes "属于真理之门的学者和炼金术师，除了研究之外在许多方面都不擅长。";
		mes "有些人甚至无法养活自己……";
		mes "我资助的那个人就是其中之一。";
		next;
		select("我想见见他。");
		mes "[Shenime]";
		mes "那恐怕不行。";
		mes "他正在进行非常重要的实验，而且他很敏感，不喜欢见陌生人。";
		next;
		mes "[Shenime]";
		mes "我很难向你介绍他，而且我也没有义务告诉你他的个人信息。";
		mes "别再打听他了。";
		delitem 6561,10;// Dustball
		delitem 6560,10;// Leaf_Bookmark
		ep14_2_mylord = 18;
		getexp 150000,150000;
		changequest 7437,7438;
		next;
		select("关于Avant。");
		mes "[Shenime]";
		mes "Avant?";
		mes "我不认识他。";
		mes "魔法学者？我认识的学者里没有叫这个名字的人。";
		mes "我不知道。";
	}
	else if (ep14_2_mylord > 17 && ep14_2_mylord < 22) {
		mes "你刚才问的Avant，难道不是那个几十年前做了不当实验后失踪的天才吗？";
		next;
		mes "[Shenime]";
		mes "我不知道你从哪里听说他的，但你还是放弃吧。你找不到他的。";
	}
	else if (ep14_2_mylord == 22 || ep14_2_mylord == 23) {
		mes "你还对我资助的那位学者感兴趣吗？";
		mes "很遗憾，他突然失踪了。";
		next;
		mes "[Shenime]";
		mes "因为他对你这样的人类感兴趣，我本想安排你们见面，";
		mes "但我不知道他在哪里……";
	}
	else if (ep14_2_mylord == 24) {
		mes "Mayor命令我们加强Orb周围的警戒。";
		mes "我不知道为什么，但你也应该留意。";
		mes "毕竟你还在为国王工作，对吧？";
		next;
		mes "[Shenime]";
		mes "总之，你还对我资助的魔法学者感兴趣吗？";
		mes "这才是你最初想问的事，对吧？";
		next;
		select("你知道他的研究吗？");
		mes "[Shenime]";
		mes "我不知道。";
		mes "他说只要我资助他，就会帮我一个忙。";
		next;
		mes "[Shenime]";
		mes "没什么可说的了。";
		mes "我很恼火他突然失踪。";
	}
	else if (ep14_2_mylord == 25) {
		mes "啊……我开始头疼了。";
		mes "Mayor甚至不告诉我原因，就命令我加强Orb的守卫……";
		next;
		mes "[Shenime]";
		mes "而我资助的学者也不见了……";
		mes "天啊……这算是骗完就跑吗？！";
		next;
		select("你很生气吗？");
		mes "[Shenime]";
		mes "我很生气？";
		mes "哈……我想我可能被骗了。";
		mes "他答应只要我资助他一段时间，就会研究我感兴趣的主题。";
		next;
		switch( select("你知道他在研究什么吗？:你想让他研究什么？") ) {
			mes "[Shenime]";
		case 1:
			mes "他的要求很简单。";
			mes "我提供居住和研究的地方，以及按我的要求进行研究时所需材料的费用。";
			next;
			mes "[Shenime]";
			mes "我以为他正在研究我感兴趣的主题。";
			mes "你前几天不是把材料给我了吗？";
			mes "就是那些与塔内怪物有关的材料。";
			next;
			mes "[Shenime]";
			mes "我给他吃的、住的，还提供实验材料，他却直接逃跑了！！";
			mes "我非常震惊。";
			next;
			select("为什么过了这么久才抱怨？");
			mes "[Shenime]";
			mes "……我想了想，也没有其他人可以倾诉。";
			mes "我又不是偷偷资助他的，但还是……";
			mes "我去问真理之门的学者他们也不知道他的下落……";
			next;
			mes "[Shenime]";
			mes "……而且我本来想让他研究Hazy Forest。";
			mes "现在我得找另一位学者了。";
			break;
		case 2:
			mes "我不想免费提供食物和住处，";
			mes "所以让他研究Bifrost Tower。";
			next;
			mes "[Shenime]";
			mes "我只做了这些，除此之外什么也不知道。";
			mes "等他完成研究后，我本来还想让他研究Hazy Forest。";
			next;
			mes "[Shenime]";
			mes "但我没想到他会这么不负责任。";
			mes "我被耍了！";
			next;
			mes "[Shenime]";
			mes "看来我得找一位更适合这份工作的学者。";
			break;
		}
		next;
		mes "[Shenime]";
		mes "总之，这就是我的遭遇。";
		mes "顺便问一下，为国王工作的你知道Mayor最近在想什么吗？";
		next;
		mes "[Shenime]";
		mes "Mayor必须代表全体Laphine。";
		mes "如果他擅自策划什么，那是不可接受的。";
		next;
		select("没有那回事。:你想知道什么？");
		mes "[Shenime]";
		mes "是关于Orb的。";
		mes "他下令加强Orb周围的守卫。";
		mes "你知道为什么吗？";
		next;
		if (select("告诉他原因。:我也不知道。") == 1) {
			mes "你应该告诉他多少？";
			next;
			if (select("全部告诉他。:编个理由。") == 1) {
				mes "[Shenime]";
				mes "什么？";
				mes "你是说我资助的学者就是'Avant'？";
				next;
				select("你连资助对象的名字都不知道？");
				mes "[Shenime]";
				mes "不……不可能……！";
				mes "只是他使用了另一个名字。";
				next;
				mes "[Shenime]";
				mes "总之，如果你说的是真的，那就是个大问题。";
				mes "但据我观察，我从没见过他和其他人交谈。";
				next;
				mes "[Shenime]";
				mes "考虑到他的性格，他可能只是出于兴趣，而不是为了某个特定目的。";
				mes "其实我希望他确实只是出于兴趣。";
				next;
				mes "[Shenime]";
				mes "光是Splendide的事件就让我头疼……但情况还在变得更糟。";
				next;
				mes "[Shenime]";
				mes "虽然你是外国人，但既然你知道一切，就有义务保护Orb。";
				next;
				mes "[Shenime]";
				mes "希望不会发生，但如果出了什么事，我希望你能帮助我。";
				next;
				mes "[Shenime]";
				mes "现在我应该把更多精力放在部署守卫上。";
				mes ".. ..";
				ep14_2_mylord = 26;
				changequest 7445,7446;
				close;
			}
			mes "[Shenime]";
			mes "你也不知道？";
			mes "Mayor Jun不知为何感到不安，所以命令我们加强守卫？";
			next;
			mes "[Shenime]";
			mes "好吧，我明白了。";
			mes "既然他这么说，我就应该照做。";
			mes "我应该相信Mayor是在正常、理性地考虑后才下达命令的。";
		}
		else {
			mes "[Shenime]";
			mes "真出乎意料。";
			mes "我以为你是Mayor Jun在Eclage最信任的人。";
			next;
			mes "[Shenime]";
			mes "不管原因是什么，我都应该相信Mayor是在正常、理性地考虑后才下达命令的。";
		}
		next;
		select("你不想遵从他的命令吗？");
		mes "[Shenime]";
		mes "当然想！";
		mes "我只是担心腐化的血脉可能蒙蔽了Mayor的判断。";
		next;
		mes "[Shenime]";
		mes "好吧，换个说法。";
		mes "你似乎信任并追随Mayor Jun，却不在意我们心中的不安。";
		next;
		mes "[Shenime]";
		mes "我们祈祷如今的Mayor能像拂过的风一样离去。";
		mes "那种强风来一次就够了。";
		next;
		mes "[Shenime]";
		mes "我不知道Mayor为什么如此执着于Orb，但既然他是在和你交谈后做出决定的，我相信你也对他产生了很大影响。";
		next;
		mes "[Shenime]";
		mes "让我们等着看";
		mes "作为Laphine骄傲与起源的Orb会发生什么。";
		mes "当然，你也应该在场。";
		ep14_2_mylord = 26;
		changequest 7445,7447;
	}
	else if (ep14_2_mylord == 26) {
		mes "我希望你能积极介入这件事。";
		mes "Orb对我们Laphine意义重大，不能交给其他种族管理，";
		next;
		mes "[Shenime]";
		mes "你不该等着看看你如此信任的Mayor是否做出了正确决定吗？";
		next;
		select("他说得对。");
		mes "[Shenime]";
		mes "如果他错了，对我来说也是个问题！";
		mes "我只是盯着他，因为谁也不知道他什么时候会像Seneth一样暴露个人野心。";
		mes "谁能保证他的正直？这可能是表面看起来没问题的操纵诡计。";
		next;
		mes "[Shenime]";
		mes "不过，Mayor本身的存在就是完美而值得敬畏的。";
		mes "因此，我们必须保持警惕，同时希望他能做出正确决定。";
		next;
		mes "[Shenime]";
		mes "所以这只是为了谨慎起见。";
		mes "我只有一个愿望。";
		next;
		mes "[Shenime]";
		mes "我希望你作为见证者，判断围绕Orb采取的一系列行动是否真的为了Orb和Laphine。";
	}
	else if (ep14_2_mylord == 27) {
		mes "你对Orb了解多少？";
		mes "那颗充满浓缩魔力、代表全体Laphine骄傲的水晶？";
		next;
		mes "[Shenime]";
		mes "我说的是结构上的事，不是那些抽象概念。";
		mes "你有没有抬头看过广场的天花板？Orb就装饰在那里。";
		next;
		mes "[Shenime]";
		mes "也许没有。";
		mes "即使看过，也会被耀眼的光芒刺得睁不开眼。";
		next;
		select("你为什么告诉我这些？");
		mes "[Shenime]";
		mes "Mayor没告诉你吗？";
		mes "天花板上安装了灯具，用来进一步衬托Orb的光辉。";
		next;
		mes "[Shenime]";
		mes "Orb一直暴露在广场上，所有Laphine都注视着它，所以保护Orb的守卫会从安装灯具的天花板上俯视下方。";
		next;
		mes "[Shenime]";
		mes "换句话说，只要攻击并破坏天花板，就很容易伤害Orb。";
		next;
		mes "[Shenime]";
		mes "你想去看看吗？";
		mes "如果是你的话，应该没问题。";
		mes "而且，你有义务判断国王是否做出了正确决定。";
		next;
		mes "[Shenime]";
		mes "我来带你过去。";
		mes "牵着我的手。";
		next;
		mes "我该怎么办？";
		next;
		switch( select("先问Kardui。:牵他的手。") ) {
		case 1:
			mes "["+ strcharinfo(0) +"]";
			mes "我不明白你为什么告诉我这么重要的信息。";
			mes "给我一点时间考虑。";
			next;
			mes "[Shenime]";
			mes "你需要时间考虑？";
			mes "我通常不会对外国人这么热情，不过我明白了。";
			mes "那就之后再回来吧。";
			ep14_2_mylord = 28;
			changequest 7448,7449;
			close;
		case 2:
			mes "你牵住Shenime的手时，手上感到一阵剧痛。";
			mes "你迅速松开手检查，却什么也没发现。";
			next;
			select("只是错觉吗……？");
			mes "[Shenime]";
			mes "怎么了？";
			mes "我可以带你过去吗？";
			mes "现在，你应该仔细观察这里。";
			ep14_2_mylord = 29;
			changequest 7448,7450;
			close2;
			warp "ecl_hub01",129,12;
			end;
		}
	}
	else if (ep14_2_mylord == 29) {
		mes "安装Orb照明设备的地方，也就是守卫驻守的地方，是天花板。";
		mes "这是你上宫殿前会经过的地方。";
		close2;
		warp "ecl_hub01",129,12;
		end;
	}
	else {
		mes "我听说你最近到处帮忙。";
		mes "你一定很忙。";
	}
	close;
}

ecl_in03,41,90,3	script	Mayor Jun Kardui#tl01	4_M_FARIYKING,{
	if (!checkweight(1301,3)) {
		mes "- You have too many items to proceed with the quest. -";
		close;
	}
	if (ep14_2_mylord > 32) {
		switch(rand(1,3)) {
		case 1:
			cutin "kardui03",1;
			mes "[Kardui]";
			mes "失血时人就是这种感觉吗？";
			mes "魔力从我体内流失的感觉……";
			mes "抱歉，我有点累。";
			break;
		case 2:
			cutin "hisie02",0;
			mes "[Hisie]";
			mes "等等……别打扰他。";
			mes "他刚睡着。";
			mes "替换Orb的魔力一定让他非常疲惫。";
			next;
			mes "[Hisie]";
			mes "我对此并不高兴，但Avant正在制作替代Orb内核的东西。";
			mes "如果他成功了，一切就会恢复原样，对吧？";
			next;
			mes "[Hisie]";
			mes "真是的……我不敢相信自己还得请他帮忙。";
			mes "....";
			break;
		case 3:
			cutin "kardui01",1;
			mes "[Kardui]";
			mes "我的脑子里塞满了太多东西。";
			mes "Mayor的头脑本应装着数十万个抽屉……";
			mes "但现在远远超出那个程度了。";
			next;
			mes "[Kardui]";
			mes "啊，我只是想抱怨一下。我的弟弟去哪儿了……？";
			mes "其他Laphine看到我这样，大概会害怕。";
			next;
			cutin "kardui05",1;
			mes "[Kardui]";
			mes "啊哈哈哈哈哈——";
			mes "你看。千年的知识或万年的记忆，感觉都毫无用处。";
			next;
			cutin "kardui03",1;
			mes "[Kardui]";
			mes "我绞尽脑汁翻遍每位Mayor的记忆、信息和历史，";
			mes "却找不到任何对抗魔王的方法。";
			next;
			cutin "kardui01",1;
			mes "[Kardui]";
			mes "也许我该把这件事交给专家？";
			break;
		}
		close2;
		cutin "",255;
		end;
	}
	mes "[Kardui]";
	if (ep14_2_mylord < 6) {
		mes "嗯……";
		mes "我不知道你是谁，但你能等我叫你吗？";
		mes "总有一天我会见你，但现在还不是时候。";
		cutin "kardui01",1;
	}
	else if (ep14_2_mylord == 6) {
		cutin "kardui01",1;
		mes "陌生人，欢迎来到Eclage。";
		mes "……这曾是很流行的问候方式，不过现在似乎没意思了。";
		cutin "kardui01",1;
		next;
		mes "[Kardui]";
		mes "总之，远道而来并";
		mes "得到守护者认可的你，";
		mes "有什么真相想告诉我吗？";
		next;
		mes "[Kardui]";
		mes "如果是这样，你今后会非常忙。";
		next;
		select("什么意思？");
		mes "[Kardui]";
		mes "你必须完成许多工作，才能说服我、长老和其他许多Laphine。";
		next;
		mes "[Kardui]";
		mes "当然我可以相信你说的一切，";
		mes "但其他Laphine会接受一个被外国人一句话动摇的Mayor Jun吗？";
		next;
		cutin "kardui03",1;
		mes "[Kardui]";
		mes "尤其是那个Mayor Jun就是我。啊……";
		next;
		cutin "kardui01",1;
		mes "[Kardui]";
		mes "你还不明白吗？";
		mes "在Eclage，你必须获得Laphine更多的认可。";
		next;
		if (select("我必须做出贡献吗？:是关于Yggdrasil的事！") == 1) {
			mes "[Kardui]";
			mes "看，你理解得很对。";
			next;
			select("是关于Yggdrasil的事！");
		}
		cutin "kardui04",1;
		mes "[Kardui]";
		mes "嗯。";
		mes "我知道。";
		next;
		mes "[Kardui]";
		mes "你不用摆出那副表情。";
		mes "无论在你眼中我是什么样子，我都是Laphine的历史与精神，也是Yggdrasil的守护者。";
		next;
		mes "[Kardui]";
		mes "你以为继承了Yggdrasil意志的我，什么都不知道吗？";
		mes "这只是无知，我不怪你。";
		next;
		mes "[Kardui]";
		mes "Jotunheim的战争很快就会结束。";
		mes "不是通过强迫，而是通过相互协商。";
		next;
		cutin "kardui01",1;
		mes "[Kardui]";
		mes "所以，陌生人，";
		mes "别担心，你愿意和我一起为Eclage工作吗？";
		next;
		select("那你为什么发动战争并无视真相？");
		cutin "kardui02",1;
		mes "[Kardui]";
		mes "嗯……";
		mes "等我们更加熟悉时我会告诉你。";
		mes "我没有义务和刚认识的人谈论这个重要话题。";
		next;
		cutin "kardui01",1;
		mes "[Kardui]";
		mes "现在，我会把你的情况告诉行政统治者、长老和所有守卫，";
		mes "关于你，";
		mes "你将以国王的工作人员身份享有在Eclage的全部权利。";
		next;
		select("那就雇个工人吧！");
		mes "[Kardui]";
		mes "这是和我这个种族之王建立关系的一部分。你不喜欢吗？";
		mes "如果这样，我想我们之间就没有友谊了。";
		next;
		select("你说'我们之间'是什么意思？");
		mes "[Kardui]";
		mes "我们？";
		mes "嗯……";
		mes "从今以后分享秘密的朋友？";
		next;
		mes "[Kardui]";
		mes "..Haha...wasn't it funny?";
		mes "你那是什么表情。";
		mes "总之，我允许你随时来访。";
		next;
		cutin "kardui04",1;
		mes "[Kardui]";
		mes "不过，如果你达不到我的期望，就什么也得不到。";

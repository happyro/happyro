		mes "摩洛克……这已经超越邪恶了。";
		next;
		mes "[瓦尔德斯]";
		mes "R先生……如果他就是赖安·";
		mes "摩尔，那你可以在另一间房间";
		mes "找到他。去审问他，确认";
		mes "你了解的一切。";
		mes "你了解的一切。";
		next;
		mes "[瓦尔德斯]";
		mes "来……";
		mes "这边。";
		next;
		donpcevent "Valdes#2::OnInit";

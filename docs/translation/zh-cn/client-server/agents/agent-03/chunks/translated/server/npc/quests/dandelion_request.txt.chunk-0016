moc_castle,40,20,3	script	Man	849,{

	if ((mao_request > 27 && mao_request < 31) || (mao_request > 125 && mao_request < 129))
	{
		mes "^3355FF你发现一具";
		mes "死人的尸体。^000000";
		emotion ET_SCRATCH, playerattached();
		close;
	}
	mes "^3355FF你发现一个男人躺在";
	mes "地板上。他似乎";
	mes "濒临死亡，";
	mes "正在胡言乱语。^000000";
	if (mao_request == 26 || mao_request == 27)
	{
		next;
		mes "[男人]";
		mes "呃呃~！新、新鲜……";
		mes "血、血！嘿嘿嘿~";
		mes "为、为了仪式，我、我会";
		mes "献、献出……自己……";
		mes "作为祭品！";
		mes "^333333*咳嗽咳嗽！*^000000";
		if(!$mao_gate1)
		{
			close2;
			warp "que_job02",14,182;
			set $mao_gate1,1;
			end;
		}
	}
	else if(mao_request == 124 || mao_request == 125)
	{
		next;
		mes "[Man]";
		mes "呃呃~！新、新鲜……";
		mes "血、血！嘿嘿嘿~";
		mes "为、为了仪式，我、我会";
		mes "献、献出……自己……";
		mes "作为祭品！";
		mes "^333333*咳嗽咳嗽！*^000000";
		if(!$mao_gate2)
		{
			close2;
			warp "que_job03",14,182;
			set $mao_gate2,1;
			end;
		}
	}
	close;

OnInit:
	set $mao_gate1,0;
	set $mao_gate2,0;
	end;
}

que_job02,14,182,1	script	#maogate1	139,1,1,{

OnEnter:
	enablenpc "#maogate1";
	end;
	
OnStop:
	disablenpc "#maogate1";
	end;
	
OnTouch:
	if (mao_request == 26 || mao_request == 27)
	{
		initnpctimer;
		disablenpc "#maogate1";
		donpcevent "#maogate1_talk1::OnEnter";
	}
	else
	{
		mes "^3355FF现在你将被";
		mes "传送到外面。^000000";
		close2;
		warp "morocc",100,100;
		set $mao_gate1,0;
	}
	end;


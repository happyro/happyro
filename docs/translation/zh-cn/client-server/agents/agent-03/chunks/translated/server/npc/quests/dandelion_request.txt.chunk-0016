		mes "我从一开始就怀疑如此。";
		mes "不过，我不知道该信任";
		mes "R先生";
		mes "还是蒲公英组织。";
		next;
		mes "[瓦尔德斯]";
		mes "既然双方都声称";
		mes "能够帮助失踪的";
		mes "孩子，我就抓住了这个机会。";
		mes "现在最好的办法是询问";
		mes "R先生的袭击者是否来自";
		mes "蒲公英组织……";
		next;
		mes "[林]";
		mes "好吧……我不敢相信";
		mes "这……R·摩尔先生……基德";
		mes "要追捕";
		mes "赖安·摩尔……这太";
		mes "巧合了……";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "林！抱歉打断你，";
		mes "但R先生";
		mes "失踪了……我不知道";
		mes "他在哪里！";
		next;
		mes "[林]";
		mes "什么？！到底发生了什么——";
		mes "发、发生了什么？！";
		mes "我脑子里这";
		mes "该死的声音是什么？！";
		mapannounce "que_job01","……血液……是灵魂的货币……",1,0x7B68EE;
		next;
		mes "[林]";
		mes "糟糕……";
		mes "这就是我";
		mes "最害怕的事……";
		next;
		mes "[" + strcharinfo(0) + "]";

-	script	Charles Orleans#cook_	-1,{
	if (MaxWeight - Weight < 2000) {
		mes "[查尔斯·奥尔良]";
		mes "请稍等。";
		mes "你现在携带的物品";
		mes "太多了，";
		mes "最好把一些物品";
		mes "放进卡普拉仓库，";
		mes "好吗？";
		close2;
		//EnableItemMove;
		end;
	}
	if (BaseJob == Job_Novice) {
		if (Sex == SEX_MALE) {
			cutin "orleans_5",0;
			mes "[查尔斯·奥尔良]";
			mes "打扰一下，先生？";
			mes "对，就是你。如果你不是";
			mes "来厨房帮忙的雇工，";
			mes "那我想请你";
			mes "现在离开。";
			next;
			emotion ET_FRET;
			mes "[查尔斯·奥尔良]";
			mes "请别";
			mes "生气，但你在这里";
			mes "跑来跑去时，";
			mes "我无法专心烹饪，";
			mes "像你这样的初心者";
			mes "像孩子一样到处乱跑。";
			close3;
		}
		cutin "orleans_1",0;
		mes "[查尔斯·奥尔良]";
		mes "小姐，你在";
		mes "城堡的这个区域";
		mes "做什么？";
		mes "哦，你一定是迷路了~";
		next;
		cutin "orleans_2",0;
		mes "[查尔斯·奥尔良]";
		mes "请使用";
		mes "右边的楼梯离开，进入";
		mes "主建筑。亲爱的，";
		mes "爬楼梯时要小心，";
		mes "注意脚下，";
		mes "好吗？";
		goto L_End;
	}
	else if (getequipid(EQI_HEAD_TOP) != 5026) {
		if (Sex == SEX_MALE) {
			cutin "orleans_5",0;
			emotion ET_FRET;
			mes "[查尔斯·奥尔良]";
			mes "先生，你为什么这样";
			mes "看着我？是因为我穿的摩洛克";
			mes "丝绸衬衫、";
			mes "维罗妮卡夫人设计的发型，";
			mes "还是我的名牌围巾";
			mes "安东尼奥先生精心制作的？";
			next;
			cutin "orleans_7",0;
			mes "[查尔斯·奥尔良]";
			mes "也许你惊叹于";
			mes "最新时尚的";
			mes "眼镜，它由";
			mes "雷根贝勒公司的艺术家设计？请告诉我~";
			next;
			cutin "orleans_2",0;
			mes "[查尔斯·奥尔良]";
			mes "等等，等一下。";
			mes "你了解";
			mes "最新的";
			mes "潮流吗？你看起来";
			mes "不太时尚……";
			next;
			cutin "orleans_5",0;
			cutin "orleans_4",0;
			mes "[查尔斯·奥尔良]";
			mes "唉，如果可以避免，";
			mes "我通常不愿意";
			mes "和粗人交往。";
			mes "但我发现你们";
			mes "冒险者确实有";
			mes "自己的优点……";
			goto L_End;
		}
		cutin "orleans_1",0;
		mes "[查尔斯·奥尔良]";
		mes "哦！请原谅我这简陋";
		mes "的小厨房，";
		mes "小姐。但即使";
		mes "普隆德拉城堡的辉煌";
		mes "也比不上";
		mes "你迷人美貌的光辉。";
		next;
		cutin "orleans_2",0;
		mes "[查尔斯·奥尔良]";
		mes "告诉我，紧挨着你";
		mes "抱着猫的";
		mes "可爱孩子是谁？";
		mes "我知道这样问很无礼，";
		mes "但我被所谓的";
		mes "好奇心鼓起了勇气。";
		next;
		switch(select("……？:她是我妹妹:其实我不认识她。")) {
		case 1:
			cutin "nyuang_3",2;
			emotion ET_DELIGHT, getnpcid(0, "Child with Cat#cook");
			mes "[抱猫的孩子]";
			mes "喵哈哈哈，";
			mes "喵哈哈哈~";
			mes "喵~喵~";
			next;
			cutin "orleans_2",0;
			emotion ET_SMILE;
			mes "[查尔斯·奥尔良]";
			mes "多么可爱的孩子。";
			mes "乖女孩要安静。";
			next;
			break;
		case 2:
			cutin "nyuang_1",2;
			emotion ET_QUESTION, getnpcid(0, "Child with Cat#cook");
			mes "[抱猫的孩子]";
			mes "……喵？";
			mes "……喵？";
			next;
			cutin "orleans_2",0;
			emotion ET_BIGTHROB;
			mes "[查尔斯·奥尔良]";
			mes "她很可爱，";
			mes "也很安静，虽然她";
			mes "看起来不像你。";
			mes "连她的猫都很可爱。";
			break;
		case 3:
			cutin "nyuang_2",2;
			emotion ET_HNG, getnpcid(0, "Child with Cat#cook");
			mes "[抱猫的孩子]";
			mes "喵哈哈哈，";
			mes "喵哈哈哈~";
			mes "喵，喵~";
			next;
			cutin "orleans_4",0;
			cutin "orleans_3",0;
			emotion ET_PROFUSELY_SWEAT;
			mes "[查尔斯·奥尔良]";
			mes "啊，再次向你";
			mes "道歉。我原以为";
			mes "这个孩子很幸运，";
			mes "能成为";
			mes "小姐的同伴。";
			break;
		}
		next;
		cutin "orleans_1",0;
		mes "[查尔斯·奥尔良]";
		mes "请允许我向你";
		mes "介绍自己，亲爱的。";
		mes "我是永远忠于你的";
		mes "仆人，我的心";
		mes "被你的目光迷住。";
		mes "我的名字是查尔斯·奥尔良。";
		next;
		cutin "orleans_4",0;
		mes "[查尔斯·奥尔良]";
		mes "但有一件事";
		mes "令我痛苦。自从";
		mes "特里斯坦三世国王陛下";
		mes "失踪后，我再也没找到";
		mes "值得品尝我料理的人。";
		mes "我的生活失去了意义……";
		next;
		mes "[查尔斯·奥尔良]";
		mes "唉，最近我只能";
		mes "教导普通的";
		mes "学徒，他们是";
		mes "烹饪艺术的新手。";
		mes "真令人沮丧——他们中许多人";
		mes "一点天赋都没有！";
		next;
		cutin "orleans_3",0;
		mes "[查尔斯·奥尔良]";
		mes "啊，请原谅我，亲爱的";
		mes "小姐。我希望你";
		mes "能理解";
		mes "我被迫承受的困难。下次";
		mes "见面时，我很想送你一份甜点。";
		next;
		cutin "orleans_1",0;
		mes "[查尔斯·奥尔良]";
		mes "是的，像你这样拥有";
		mes "美貌的女性，绝对值得";
		mes "品尝";
		mes "只有我能提供的美味。";
		mes "在那天到来之前，我只能";
		mes "依依不舍地向你道别。";
		goto L_End;
	}
	else if (cooking_q == 0) {
		cutin "orleans_5",0;
		emotion ET_THINK;
		mes "[查尔斯·奥尔良]";
		mes "哦，你是来这里";
		mes "学习烹饪的吗？^333333*叹气*^000000";
		mes "我今天不想教";
		mes "任何东西——事实上，";
		mes "我觉得教学是在浪费";
		mes "我的时间！^333333*叹气*^000000 不过……";
		next;
		switch(select("呃，你是在和我说话吗？:等等，你不记得我了吗？:奥尔良先生？")) {
		case 1:
			cutin "orleans_7",0;
			mes "[查尔斯·奥尔良]";
			mes "不然我还能和谁";
			mes "说话？";
			mes "和那边的玛德琳";
			mes "吗？还是那个";
			mes "抱着肮脏";
			mes "猫的孩子？我的天！";
			next;
			cutin "nyuang_4",2;
			mes "[抱猫的孩子]";
			mes "咕噜噜！";
			mes "喵呜！";
			next;
			cutin "orleans_4",0;
			cutin "orleans_3",0;
			emotion ET_HUK;
			mes "[查尔斯·奥尔良]";
			mes "天啊，你吓到我了！";
			mes "真是个坏脾气的孩子！";
			mes "谁把这孩子带进来的？";
			break;
		case 2:
			mes "[查尔斯·奥尔良]";
			mes "我不可能记得每一个";
			mes "求我教授";
			mes "烹饪";
			mes "艺术的新人。我敢肯定你";
			mes "几个月前来过这里，";
			mes "只是……你叫什么来着……？";
			next;
			cutin "orleans_7",0;
			mes "[查尔斯·奥尔良]";
			mes "呸！无所谓。";
			mes "我想那";
			mes "现在";
			mes "并不重要。";
			break;
		case 3:
			cutin "orleans_4",0;
			mes "[查尔斯·奥尔良]";
			mes "你、你说什么？我虽然是";
			mes "你的导师，但你";
			mes "可以直接叫我的名字。";
			mes "我知道自己可能很严格，";
			mes "但请记住：归根结底我们是同事，即使我是上级。";
			next;
			cutin "orleans_1",0;
			mes "[查尔斯·奥尔良]";
			mes "好吧，好吧……";
			mes "既然你坚持表达";
			mes "一点点";
			mes "敬意，那你可以";
			mes "称呼我“查尔斯先生”。";
			next;
			cutin "orleans_7",0;
			mes "[查尔斯·奥尔良]";
			mes "啊……这称呼";
			mes "听起来确实不错。";
			mes "这个称号其实是我";
			mes "从国王本人那里得到的，虽然";
			mes "我只是名义和举止像骑士，而不是力量。";
			break;
		}
		next;
		cutin "orleans_7",0;
		mes "[查尔斯·奥尔良]";
		mes "那么，我们开始";
		mes "今天的简单";
		mes "料理。好吧，^FF0000我不会重复教授食谱";
		mes "^000000，^FF0000所以务必";
		mes "把它记下来^000000。现在";
		mes "我们要做什么？";
		next;
		cutin "orleans_6",0;
		set .@cook_m1,rand(1,6);
		if (.@cook_m1 == 1) {
			set cooking_q,1;
			mes "[查尔斯·奥尔良]";
			mes "啊，要不要做";
			mes "‘油炸蝗虫腿？’";
			mes "对不熟悉的人来说，";
			mes "这似乎是道恶心的菜，";
			mes "但相信我，它的精致味道会让你的味蕾享受纯粹的快乐。";
			next;
			mes "[查尔斯·奥尔良]";
			mes "现在请带来";
			mes "^4D4DFF5只蝗虫腿^000000、";
			mes "^4D4DFF1份食用油^000000和";
			mes "^4D4DFF1口旧平底锅^000000。";
			mes "然后就可以开始了。";
			goto L_End;
		}
		else if (.@cook_m1 == 2) {
			set cooking_q,2;
			mes "[查尔斯·奥尔良]";
			mes "啊，我想到了！";
			mes "我们做‘葡萄汁";
			mes "草药茶’。天气";
			mes "正适合";
			mes "清凉爽口的饮料。";
			next;
			mes "[查尔斯·奥尔良]";
			mes "请带来";
			mes "^4D4DFF3颗葡萄^000000和";
			mes "^4D4DFF2瓶红色药水^000000";
			mes "这样我们就能";
			mes "开始课程~";
			goto L_End;
		}
		else if (.@cook_m1 == 3) {
			set cooking_q,3;
			mes "[查尔斯·奥尔良]";
			mes "我想到了~";
			mes "我们可以做";
			mes "‘蜂蜜葡萄汁’。";
			mes "请带来以下";
			mes "材料，这样我们";
			mes "就能开始课程。";
			next;
			mes "[查尔斯·奥尔良]";
			mes "^4D4DFF1份蜂蜜^000000、";
			mes "^4D4DFF2颗葡萄^000000和";
			mes "^4D4DFF1瓶红色药水^000000。";
			goto L_End;
		}
		else if (.@cook_m1 == 4) {
			set cooking_q,4;
			mes "[查尔斯·奥尔良]";
			mes "嗯，我们为什么不做";
			mes "‘青蛙卵和";
			mes "乌贼墨汤’？那些";
			mes "缺乏美食鉴赏力的人可能";
			mes "觉得它恶心，但它";
			mes "其实非常美味。";
			next;
			mes "[查尔斯·奥尔良]";
			mes "那么，";
			mes "请带来";
			mes "^4D4DFF1袋谷物^000000、";
			mes "^4D4DFF10只水母幼体^000000和";
			mes "^4D4DFF1份乌贼墨^000000。";
			goto L_End;
		}
		else if (.@cook_m1 == 5) {
			set cooking_q,5;
			mes "[查尔斯·奥尔良]";
			mes "啊，我知道现在";
			mes "最适合";
			mes "做什么。‘蒸螃蟹";
			mes "钳’。现在请";
			mes "带来这些材料，";
			mes "这样我们就能做汤。";
			next;
			mes "[查尔斯·奥尔良]";
			mes "我们需要";
			mes "^4D4DFF10份绿色药草^000000、";
			mes "^4D4DFF10个螃蟹钳^000000和";
			mes "^4D4DFF1瓶黄色药水^000000。";
			goto L_End;
		}
		set cooking_q,6;
		mes "[查尔斯·奥尔良]";
		mes "哦，你知道什么";
		mes "会很美味吗？";
		mes "‘油炸猴尾’。没错，";
		mes "听起来很棒！请";
		mes "带来这些材料，";
		mes "我就能教你这道菜。";
		next;
		mes "[查尔斯·奥尔良]";
		mes "我们需要";
		mes "^4D4DFF1口平底锅^000000、";
		mes "^4D4DFF5条溜溜猴尾巴^000000和";
		mes "^4D4DFF1份食用油^000000。";
		goto L_End;
	}
	else if (cooking_q == 1) {
		if (countitem(940) > 4 && countitem(7031) > 0 && countitem(7457) > 0) {
			cutin "orleans_4",0;
			emotion ET_FRET;
			mes "[查尔斯·奥尔良]";
			mes "你终于来了！记住，";
			mes "你的材料必须";
			mes "尽可能新鲜。";
			mes "否则料理质量会差很多。现在让我";
			mes "解释如何制作这道菜。";
			next;
			cutin "orleans_6",0;
			mes "[查尔斯·奥尔良]";
			mes "把蝗虫腿";
			mes "尽可能洗干净后，";
			mes "放入平底锅。";
			mes "然后倒入半瓶食用油，用";
			mes "大火煎腿约20分钟。";
			next;
			mes "[查尔斯·奥尔良]";
			mes "现在严格按照";
			mes "我刚才给你的";
			mes "说明操作！嗯……很好，很好。";
			mes "一点也不差。好了，";
			mes "你快完成了……";
			next;
			cutin "orleans_7",0;
			mes "[查尔斯·奥尔良]";
			mes "好了，完成了！";
			mes "摆盘还可以";
			mes "再改进一点，但至少你";
			mes "现在知道这道菜的食谱了。今天";
			mes "就到这里，请去";
			mes "自己练习吧。";
			delitem 940,5; //Grasshopper's_Leg
			delitem 7031,1; //Old_Frying_Pan
			delitem 7457,1; //Cooking_Oil
			set cooking_q,7;
			getitem 12041,1; //Str_Dish01
			goto L_End;
		}
		cutin "orleans_6",0;
		set .@talk_j,rand(1,2);
		if (.@talk_j == 1) {
			mes "[查尔斯·奥尔良]";
			mes "快把制作";
			mes "所需的材料带来，";
			mes "制作油炸蝗虫腿！";
			mes "如果餐厅客人";
			mes "点了这道菜，你就会";
			mes "让他等着了！";
			goto L_End;
		}
		mes "[查尔斯·奥尔良]";
		mes "去伏击那些";
		mes "在田野里";
		mes "快乐玩耍的蝗虫。快打碎它们，然后撕下它们的";
		mes "腿——但要仁慈一点！ ";
		goto L_End;
	}
	else if (cooking_q == 2) {
		if (countitem(514) > 2 && countitem(501) > 1) {
			cutin "orleans_4",0;
			mes "[查尔斯·奥尔良]";
			mes "你终于来了！记住，";
			mes "你的材料必须";
			mes "尽可能新鲜。";
			mes "否则料理质量会差很多。现在让我";
			mes "解释如何制作这道菜。";
			next;
			cutin "orleans_6",0;
			mes "[查尔斯·奥尔良]";
			mes "你要像这样";
			mes "从葡萄中榨汁——";
			mes "为了保持新鲜，不能使用预制的葡萄";
			mes "汁。然后你需要隔水煮沸红色";
			mes "药水……";

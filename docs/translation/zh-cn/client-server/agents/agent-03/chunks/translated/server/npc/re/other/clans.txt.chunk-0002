					mes "[Shaam Rumi]";
					mes "啊哈，明白了！谢谢你，队长！";
					mes "你也听到了吧？";
					next;
					mes "[Shaam Rumi]";
					mes "氏族由王国直接管理，不能参加攻城战，但好消息是成员会获得一些^3131FF属性加成^000000。";
					next;
					mes "[Shaam Rumi]";
					mes "如果你担心^3131FF弩手氏族^000000只招收弓箭手，那就错了。";
					mes "所有氏族接受所有职业，你可以选择最适合自己的。";
					next;
					cutin "sham02.bmp", 2;
					mes "[Shaam Rumi]";
					mes "该说的应该都说完了。";
					mes "伯曼，我们去古城逛逛吧。";
					next;
					cutin "debon03.bmp", 2;
					mes "[Devon Aire]";
					mes "你……";
					next;
					cutin "sham03.bmp", 2;
					mes "[Shaam Rumi]";
					mes "哦，好可怕！你真是保护弟弟啊。";
					break;
				case 2:
					mes "[Shaam Rumi]";
					mes "^3131FF弩手氏族^000000最适合远程职业。";
					next;
					mes "[Shaam Rumi]";
					mes "让我查查氏族手册。对了，新成员可获得属性加成：^FF0000<DEX+1, AGI+1, MHP+30, MSP+10>^000000。";
					next;
					mes "[Shaam Rumi]";
					mes "氏族不能参加攻城战；想参加攻城战就加入私人公会吧。";
					mes "氏族适合不喜欢受束缚的冒险者。";
					next;
					mes "[Shaam Rumi]";
					mes "你有什么问题吗？";
					break;
				case 3:
					break;
			}
			break;
		case 2:
			mes "[Shaam Rumi]";
			mes "哦，是吗？明智的选择！";
			mes "那我们看看氏族规定，开始入会手续吧。";
			next;
			mes "[Shaam Rumi]";
			mes "^3131FF氏族成员^000000不能参加攻城战。";
			mes "作为新成员，你将获得以下属性加成：^FF0000<DEX+1, AGI+1, MHP+30, MSP+10>^000000。";
			mes "你同意吗？";
			next;
			if( select( "同意。:不同意。" ) == 1 ){
				mes "[Shaam Rumi]";
				mes "你可以随时加入或离开氏族，但如果^FF0000超过两周^000000不上线，就会被^FF0000驱逐^000000。";
				mes "你保证会保持良好状态吗？";
				next;
				if( select( "同意。:不同意。" ) == 1 ){
					mes "[Shaam Rumi]";
					mes "很好，在这里写下你的名字。";
					next;
					input .@name$;
					mes "[Shaam Rumi]";
					mes "^3131FF" + strcharinfo( 0 ) + "^000000..!";
					mes "呃，你的字迹还得练练。我来处理你的申请。";
					next;
					if( getcharid( 2 ) ){
						mes "[Shaam Rumi]";
						mes "你已经处理好公会那边的事了吗？";
						close3;
					}else if( getcharid( 5 ) != 0 ){
						mes "[Shaam Rumi]";
						mes "呃，你已经加入氏族了。喂，这可不好笑。";
					}else{
						if (clan_join(CROSSBOWCLAN)) {
							sc_start2 SC_CROSSBOWCLAN, INFINITE_TICK, 0, CROSSBOWCLAN;
							cutin "sham02.bmp", 2;
							mes "[Shaam Rumi]";
							mes "欢迎加入^3131FF弩手氏族^000000！";
							next;
							cutin "sham01.bmp", 2;
							mes "[Shaam Rumi]";
							mes "你可以用^3131FFCtrl+G^000000查看氏族信息。";
							next;
							mes "[Shaam Rumi]";
							mes "别和其他氏族成员打架，要友善相处。";
							mes "需要帮助就随时密语我，好吗？回头见！";
						} else
							mes "发生错误。";
					}
				}else{
					mes "[Shaam Rumi]";
					mes "好吧，那我去找点乐子。";
				}
			}else{
				mes "[Shaam Rumi]";
				mes "啊，你需要时间考虑吗？没问题。";
			}
			break;
		case 3:
			mes "[Shaam Rumi]";
			mes "怎么，找到更好的氏族了？";
			mes "我很失望，不过由你决定。我来处理你的退出。";
			next;
			if( select( "继续。:取消。" ) == 1 ){
				if( getcharid( 5 ) == 0 ){
					cutin "sham04.bmp", 2;
					mes "[Shaam Rumi]";
					mes "我不能让你离开——你根本不在我的氏族里！";
				}else if( getcharid( 5 ) != CROSSBOWCLAN ){
					mes "[Shaam Rumi]";
					mes "抱歉，我不插手其他氏族的事。";
				}else{
					if (clan_leave()) {
						sc_end SC_CROSSBOWCLAN;
						mes "[Shaam Rumi]";
						mes "办好了。";
						mes "想我们的时候就回来，别客气，好吗？";
					} else
						mes "发生错误。";
				}
			}
			break;
	}
	close2;
	cutin "", 255;
	end;

OnInit:
	sc_start2 SC_CROSSBOWCLAN, INFINITE_TICK, 0, CROSSBOWCLAN, 10000, SCSTART_NOAVOID, getnpcid(0);
	end;
}

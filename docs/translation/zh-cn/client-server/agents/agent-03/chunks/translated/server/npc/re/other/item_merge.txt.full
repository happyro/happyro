//===== Current Version: =====================================
//= 1.1
//===== Compatible With: =====================================
//= rAthena Project
//===== Description: =========================================
//= [Official Conversion]
//= Merges items taking up multiple slots in a player's
//= inventory.
//===== Additional Comments: =================================
//= 1.0 First version, currently useless/disabled.
//= 1.1 Implemented the 'mergeitem' script command. [Cydh]
//= 1.2 Updated and moved to Cash Mall [Lemongrass]
//============================================================

//prontera,146,95,3	script	Mergician#pron	1_M_WIZARD,{
itemmall,35,75,3	script	Mergician#mall	1_M_WIZARD,{
	if (checkweight(1301,1) == 0) {
		mes "- 等一下！！-";
		mes "- 你携带的物品太多了 -";
		mes "- 或者负重过高，无法继续。-";
		mes "- 整理好";
		mes "- 物品栏后再回来。-";
		close;
	}
	mes "[合并术士]";
	mes "你相信合并之神的奇迹吗？那就大声重复我念出的咒语吧！！！";
	mes "合并、合并、合————并！！！";
	next;
	switch(select("合————并！！！！:合并的奇迹是什么？:放弃……")) {
	case 2:
		mes "[合并术士]";
		mes "有一种秩序统治着世界，让世界正常运转。";
		next;
		mes "[合并术士]";
		mes "但有一个坏因素彻底破坏了这条规则！！";
		next;
		mes "[合并术士]";
		mes "明明由相同材料组成，却被分开的物品！！";
		next;
		mes "[合并术士]";
		mes "你从没遇到过这种糟糕的事情吗？？";
		mes "明明是^3131FF同一种药水，却在物品栏里出现两次以上！^000000真令人不快！！！";
		next;
		mes "[合并术士]";
		mes "相信合并主义，那就是真理。";
		mes "这样我就能帮你获得幸福和满足。";
		close;
	case 1:
		mes "[合并术士]";
		mes "这是向伟大的合并之神祈祷的完整圣仪！我只是暂时借用他的力量！！";
		next;
		mes "[合并术士]";
		mes "如果你渴望得到合并之神的祝福，就谦卑地大声喊出来！合并、合并、合————并！！！";
		next;
		switch(select("合————并！:不要听他的。")) {
		case 1:
			mergeitem;
			mes "[合并术士]";
			mes "合并之神听到了你的愿望，并让它实现了！";
			mes "打开物品栏看看奇迹吧！";
			close;
		case 2:
			mes "[合并术士]";
			mes "你这个笨蛋！！！你破坏了完整的节奏！为什么不能跟上我的节拍？！笨蛋！";
			close;
		}
	case 3:
		close;
	}
}

um_fild01,34,281,5	script	Lilla#Dryad_Hunt	724,{
	if (checkquest(60131) != -1) {
		if (checkquest(60131,HUNTING) != 2 ) {
			mes "[Lilla]";
			mes "你完成了猎杀50只树精的任务吗？";
			next;
			switch(select("是:否:我想退出")) {
			case 1:
				mes "[Lilla]";
				mes "嗯，我觉得你还没猎杀够50只……";
				close;
			case 2:
				mes "[Lilla]";
				mes "记住，我需要你帮忙猎杀树精，去猎杀50只吧。";
				close;
			case 3:
				mes "[Lilla]";
				mes "确定要停止猎杀吗？";
				mes "你取得的进度都会被清除。";
				next;
				switch(select("是:否")) {
				case 1:
					mes "[Lilla]";
					mes "好吧，改变主意后再回来。";
					erasequest 60131;
					close;
				case 2:
					mes "[Lilla]";
					mes "请猎杀50只树精。";
					close;
				}
			}
		}
		else {
			mes "[Lilla]";
			mes "太棒了，你完成得真快。";
			getexp 262485,141835;
			erasequest 60131;
			close;
		}
	}
	if (checkquest(60132) != -1) {
		if (checkquest(60132,HUNTING) != 2 ) {
			mes "[Lilla]";
			mes "你完成了猎杀100只树精的任务吗？";
			next;
			switch(select("是:否:我想退出")) {
			case 1:
				mes "[Lilla]";
				mes "嗯，我觉得你还没猎杀够100只……";
				close;
			case 2:
				mes "[Lilla]";
				mes "记住，我需要你帮忙猎杀树精，去猎杀100只吧。";
				close;
			case 3:
				mes "[Lilla]";
				mes "确定要停止猎杀吗？";
				mes "你取得的进度都会被清除。";
				next;
				switch(select("是:否")) {
				case 1:
					mes "[Lilla]";
					mes "好吧，改变主意后再回来。";
					erasequest 60132;
					close;
				case 2:
					mes "[Lilla]";
					mes "请猎杀100只树精。";
					close;
				}
			}
		}
		else {
			mes "[Lilla]";
			mes "太棒了，你完成得真快。";
			getexp 262485,141835;
			getexp 262485,141835;
			erasequest 60132;
			close;
		}
	}
	if (checkquest(60133) != -1) {
		if (checkquest(60133,HUNTING) != 2 ) {
			mes "[Lilla]";
			mes "你完成了猎杀150只树精的任务吗？";
			next;
			switch(select("是:否:我想退出")) {
			case 1:
				mes "[Lilla]";
				mes "嗯，我觉得你还没猎杀够150只……";
				close;
			case 2:
				mes "[Lilla]";
				mes "记住，我需要你帮忙猎杀树精，去猎杀150只吧。";
				close;
			case 3:
				mes "[Lilla]";
				mes "确定要停止猎杀吗？";
				mes "你取得的进度都会被清除。";
				next;
				switch(select("是:否")) {
				case 1:
					mes "[Lilla]";
					mes "好吧，改变主意后再回来。";
					erasequest 60133;
					close;
				case 2:
					mes "[Lilla]";
					mes "请猎杀150只树精。";
					close;
				}
			}
		}
		else {
			mes "[Lilla]";
			mes "太棒了，你完成得真快。";
			getexp 262485,141835;
			getexp 262485,141835;
			getexp 262485,141835;
			erasequest 60133;
			close;
		}
	}
	//for minimum level
	if (BaseLevel > 59) {
		//for maximum level
		if (BaseLevel < 86) {
			mes "[Lilla]";
			mes "你好呀！";
			mes "你看起来愿意帮助我这样的小家伙。";
			next;
			switch(select("当然:不")) {
			case 1:
				mes "[Lilla]";
				mes "真的？！";
				mes "太好了！";
				next;
				switch(select("收集物品:猎杀树精:取消")) {
				case 1:
					// Item turn in
					mes "[Lilla]";
					mes "我真的需要收集^00CE0050锋利树叶^000000来举办花园茶会。";
					mes "你有吗？";
					next;
					switch(select("我有锋利树叶:你需要什么？")) {
					case 1:
						/*
						if (checkweight(504,10) == 0) {
							mes "[Lilla]";
							mes "嘿，你背上的重量似乎要把你压垮了。";
							mes "减轻负重后再回来。";
							close;
						}
						*/
						if (countitem(7100) > 49) {
							mes "[Lilla]";
							mes "嘿，你真是个可爱的小家伙。";
							mes "非常感谢你的帮助！";
							next;
							mes "[Lilla]";
							mes "哦，我差点忘了。我有东西给你^_^";
							mes "再次非常感谢你的帮助。";
							delitem 7100,50; //Sharp_Leaf
							getexp 262485,141835;
							//getitem 504,10; //White_Potion
							close;
						}
						else {
							mes "[Lilla]";
							mes "我看起来又可爱又傻，但请别和我开玩笑。";
							close;
						}
					case 2:
						mes "[Lilla]";
						mes "我需要^00CE0050锋利树叶^000000。";
						close;
					}
				case 2:
					// Kill Count Quest
					mes "[Lilla]";
					mes "啊，好吧。你可以帮我猎杀一些树精。";
					mes "你想猎杀多少只？";
					next;
					switch(select("50只树精:100只树精:150只树精")) {
					case 1:
						mes "[Lilla]";
						mes "完成任务后回来，我会给你小奖励。";
						setquest 60131;
						close;
					case 2:
						mes "[Lilla]";
						mes "完成任务后回来，我会给你小奖励。";
						setquest 60132;
						close;
					case 3:
						mes "[Lilla]";
						mes "完成任务后回来，我会给你小奖励。";
						setquest 60133;
						close;
					}
				case 3:
					mes "[Lilla]";
					mes "改变主意后请再回来。";
					close;
				}
			case 2:
				mes "[Lilla]";
				mes "改变主意后请再回来。";
				close;
			}
		}
		else {
			mes "[Lilla]";
			mes "抱歉，你太老、太吓人了，我不想和你说话！";
			close;
		}
	}
	else {
		mes "[Lilla]";
		mes "你太小了，帮不了我。";
		mes "";
	mes "不过还是谢谢你的好意。";
		close;
	}
}

morocc,143,63,3	script	Ragged Man#nd	929,{
	if (treasure_nd == 0) {
		mes "[Ragged Man]";
		mes "你、你好？能帮帮我吗？只要帮我这个忙，就等于救了可怜人的命。拜托……";
		next;
		switch(select("我能怎么帮你？:忽略他")) {
		case 1:
			mes "[" + strcharinfo(0) + "]";
			mes "好吧，我能怎么帮你？";
			next;
			mes "[Ragged Man]";
			mes "哦，太感谢了！被忽视这么久后，能和人说话真好！我看起来像乞丐，但其实是来自普隆德拉的寻宝者。";
			next;
			switch(select("嗯……所以？")) {
			case 1:
				mes "[Ragged Man]";
				mes "刚开始时，我确信能在梦罗克找到宝藏……做了所有调查和准备。但雇了几队寻宝者和研究员之后……";
				next;
				mes "[Ragged Man]";
				mes "我花光了全部财产，却仍没更接近宝藏。我……我甚至没有回家的钱了！";
				emotion ET_CRY;
				next;
				mes "[Ragged Man]";
				mes "你能给我一点钱，让我终于回到普隆德拉吗？";
				next;
				switch(select("你为什么不走回去？:我可以给你钱。")) {
				case 1:
					mes "[Ragged Man]";
					mes "什么？你以为我能走到普隆德拉却没走吗？！我为什么还要乞讨？算了，我不需要你这种同情。";
					next;
					mes "[Ragged Man]";
					mes "我本来有个重要情报要告诉你，但你不愿分享，我也不说了！";
					set treasure_nd,1;
					close;
				case 2:
					mes "[Ragged Man]";
					mes "哦，谢谢！你能给多少我都感激！上帝保佑你，保佑你！";
					next;
					if (Zeny < 1200) {
						mes "[Ragged Man]";
						mes "嗯……哦，天啊……";
						mes "你的处境和我一样糟。";
						mes "我很感激，但不能收你的钱。";
						mes "";
						next;
						mes "[Ragged Man]";
						mes "真遗憾。";
						mes "如果你给我 1,200 Zeny，";
						mes "我本来会告诉你一个大情报……";
						mes "";
						set treasure_nd,1;
						close;
					}
					else {
						set Zeny, Zeny-1200;
						mes "[Ragged Man]";
						mes "让我看看……我只需要 1,200 Zeny。";
						mes "这足够让我回家了。";
						mes "但我不能收了你的钱却让你空手离开，对吧？";
						mes "";
						mes "";
						mes "";
						next;
						mes "[Ragged Man]";
						mes "还记得我一直寻找的隐藏宝藏吗？";
						mes "听说它的位置终于被确认了。";
						mes "你不如自己去找找看？";
						mes "";
						mes "";
						mes "";
						next;
						mes "[Ragged Man]";
						mes "我更希望它落入你这样的人手中，而不是竞争对手手里。";
						mes "城北的那位猎人似乎确认了宝藏的位置。";
						mes "";
						mes "";
						mes "";
						next;
						mes "[Ragged Man]";
						mes "听说那家伙还没回家，";
						mes "也还没找到宝藏。";
						mes "他大概遇到了很大的麻烦。";
						mes "";
						mes "";
						next;
						mes "[Ragged Man]";
						mes "我怀疑他会轻易告诉你宝藏位置，";
						mes "但谁知道呢？也许";
						mes "";
						mes "也许他会失言，意外给你某种线索。";
						set treasure_nd,2;
						close;
					}
				}
			}
		case 2:
			mes "[Ragged Man]";
			mes "请！请等等！你是冒险者，对吧？只要给我一点钱，我就告诉你有价值的情报……嘿！回来！不……我只是……";
			close;
		}
	}
	else if (treasure_nd == 1) {
		mes "[Ragged Man]";
		mes "哦，我记得你。你现在一定很想要那批宝藏吧？给我 1,200 Zeny 让我回家，我就告诉你知道的一切。";
		next;
		switch(select("给钱:不给钱")) {
		case 1:
			mes "[Ragged Man]";
			mes "啊，明智的选择！非常感谢。终于能";
				mes "回到普隆德拉的家。";
			next;
			if (Zeny < 1200) {
				mes "[Ragged Man]";
				mes "什么——？！这点钱不够我回家！筹够钱后再回来。我会等着。";
				close;			}
			else {
				set Zeny, Zeny-1200;
				mes "[Ragged Man]";
				mes "记得我寻找的隐藏宝藏吗？据说它的位置终于确认了。你为什么不自己去找找？";
				next;
				mes "[Ragged Man]";
				mes "我更希望它落入你这样的人手里，而不是竞争对手。城北的那位寻宝者似乎确认了宝藏位置。";
				next;
				mes "[Ragged Man]";
				mes "听说那家伙还没回家，也还没找到宝藏。他可能遇到了大麻烦。";
				next;
				mes "[Ragged Man]";
				mes "我怀疑他会轻易告诉你宝藏位置，但谁知道呢？也许他会失言，意外给你某种线索。";
				set treasure_nd,2;
				close;
			}
		case 2:
			mes "[Ragged Man]";
			mes "好吧，随你。";
			mes "我承认有点失望。你们冒险者不是应该成为人民的英雄吗？";
			close;
		}
	}
	else if (treasure_nd == 2) {
		mes "[Ragged Man]";
		mes "哦，你回来了？啊，你一定很难找到我说的那个人。他就在城镇北部，不该那么难找。";
		close;
	}
	else if (treasure_nd > 10) {
		mes "[Ragged Man]";
		mes "你找到宝藏了？！它……它真的存在……抱歉，这一直是我的梦想……我想哭……天啊……我不知道这种感觉是什么……";
		next;
		mes "[Ragged Man]";
		mes "我的意思是……我太高兴了，但是……我花光了全部财产……毁掉一生，只为看到那批宝藏……";
		close;
	}
	else {
		mes "[Ragged Man]";
		mes "寻宝进展如何？希望你比我幸运。不过，我有很强的预感你会找到它。";
		close;
	}
}

morocc,102,298,3	script	Man#zgang	98,{
	if (treasure_nd < 2) {
		mes "[Man]";
		mes "你想要什么？别管我。";
		close;
	}
	else if (treasure_nd == 2) {
		mes "[Man]";
		mes "你想要什么？别管我。";
		next;
			switch(select("告诉我宝藏的事。")) {
		case 1:
			emotion ET_SURPRISE;
			mes "[Man]";
			mes "什么？你就是我被警告过的那个人！我一直在等你出现。准备受死吧！";
			next;
			mes "[" + strcharinfo(0) + "]";
			mes "呃……打扰一下？我听说你确认了某处惊人宝藏的位置，只想多问问而已！";
			next;
			mes "[Man]";
			mes "什么？如果你只是为此而来，那你怎么知道我和宝藏？不是人人都知道。";
			next;
			mes "[" + strcharinfo(0) + "]";
			mes "我和另一个寻宝者聊过，他……嗯，现在有点像乞丐……";
			next;
			mes "[Man]";
			mes "哦，那个老人？我不知道他寻找的宝藏和我找到的是不是同一个。但没错，我认识那个人。";
			next;
			mes "[Man]";
			mes "好吧。我找到了这批宝藏，但没办法挖出来。也许我们能互相帮助。我需要钱，而你想知道更多，对吧？我们做个交易吧。";
			next;
			switch(select("不用了，谢谢。:你有什么打算？")) {
			case 1:
				mes "[Man]";
				mes "不？好吧……你现在没理由相信我，我想。但你离开能得到什么？";
				set treasure_nd,3;
				close;
			case 2:
				mes "[Man]";
				mes "我把事情说明白。我受雇寻找这批宝藏，他们说我可以拿走找到的东西，但他们特别想要其中一件。";
				next;
				mes "[Man]";
				mes "他们交付时才付款，所以我还没拿到一分钱。协议有条件：我挖不出宝藏，他们也会理解我失败了。";
				next;
				mes "[Man]";
				mes "但如果你挖出来，就能全部保留。听起来不错吧？我只想从你那里得到一些东西，弥补至今的努力。";
				next;
				mes "[Man]";
				mes "换句话说，如果你带给我，";
				mes "^FF000020 Mementos^000000,";
				mes "^FF00002 Pearls^000000, and";
				mes "^FF00002 Zargons^000000, we can talk";
				mes "我们就继续谈生意。明白了吗？";
				set treasure_nd,4;
				next;
				mes "[Man]";
				mes "我放弃宝藏份额可能会吃亏，但手中鸟胜过林中鸟。";
				close;
			}
		}
	}
	else if (treasure_nd == 3) {
		mes "[Man]";
		mes "又是你？让我猜猜……你重新考虑我提议的交易了，对吧？";
		next;
		switch(select("不，不是。:我想是的。")) {
		case 1:
			mes "[Man]";
			mes "确定吗？这笔交易没人会吃亏。好吧，除了雇我找宝藏的人。这基本是双赢。";
			next;
			mes "[Man]";
			mes "依我看，总得有人找到那份宝藏。";
			mes "我虽然不能亲自挖出来，";
			mes "";
			mes "把它挖出来，但也许";
			mes "像你这样的人也许可以……";
			close;
		case 2:
			mes "[Man]";
			mes "我把事情说明白。我受雇寻找这批宝藏，他们说我可以拿走找到的东西，但他们特别想要其中一件。";
			next;
			mes "[Man]";
			mes "他们交付时才付款，所以我还没拿到一分钱。我的协议有条件：我挖不出宝藏，他们也会理解我失败了。";
			next;
			mes "[Man]";
			mes "但如果你挖出来，就可以全部保留。听起来不错吧？我只想从你那里得到一些东西，弥补我至今的努力。";
			next;
			mes "[Man]";
			mes "换句话说，如果你带给我，";
			mes "^FF000020 个纪念品^000000、^FF00002 颗珍珠^000000和^FF00002 个 Zargon^000000，";
			mes "我们就继续谈生意。明白了吗？";
			set treasure_nd,4;
			next;
			mes "[Man]";
			mes "我放弃宝藏份额可能会吃亏，但俗话说，手中鸟胜过林中鸟。";
			close;
		}
	}
	else if (treasure_nd == 4) {
		mes "[Man]";
		mes "又回来了？你带来我要的东西了吗？";
		next;
		if ((countitem(722) > 1) && (countitem(912) > 1) && (countitem(934) > 19)) {
			mes "[Man]";
			mes "很好，你完成了自己的部分。现在该履行我的承诺了。听好。";
			delitem 722,2; //Scarlet_Jewel
			delitem 912,2; //Zargon
			delitem 934,20; //Mementos
			set treasure_nd,5;
			next;
			mes "[Man]";
			mes "宝藏埋在梦罗克南方。出南门离开城镇，再前往南边的下一个原野。从那里开始就靠你自己了。";
			next;
			mes "[Man]";
			mes "我不知道宝藏具体埋在哪里，但你应该能在那片区域找到。祝你好运。";
			close;
		}
		else {
			mes "[Man]";
			mes "嗯，你一定忘了我要什么。我并不是要你带来特别贵重的东西。总之，听好。";
			next;
			mes "[Man]";
			mes "只要带给我，";
			mes "^FF000020 个纪念品^000000、^FF00002 颗珍珠^000000和^FF00002 个 Zargon^000000，我们就能继续谈生意。明白了吗？";
			close;
		}
	}
	else if (treasure_nd == 5) {
		mes "[Man]";
		mes "你还在这里做什么？不该去找宝藏吗？";
		close;
	}
	else if (treasure_nd == 6) {
		mes "[Man]";
		mes "你还在这里做什么？不该去找宝藏吗？";
		next;
		select("我已经找到它了，但是……");
		mes "[" + strcharinfo(0) + "]";
		mes "我已经找到它了，但是……它完全不动！";

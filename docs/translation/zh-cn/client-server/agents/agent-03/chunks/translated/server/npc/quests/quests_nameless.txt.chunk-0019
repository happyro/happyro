		mes "事情出了大问题，对吧？让我回去吧~！";
		set zdan_edq,15;
		set $@monster_zgang,0;
		set $@door2,0;
		close2;
		warp "moc_fild17",209,235;
		end;
	}

OnInit:
	hideonnpc "Catfoii";
	end;
}


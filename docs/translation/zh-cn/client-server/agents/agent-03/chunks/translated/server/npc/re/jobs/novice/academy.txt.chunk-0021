iz_ac02_a,50,169,3	duplicate(Salim Hamid#ac)	Salim Hamid#ac_a	1_M_MERCHANT
iz_ac02_b,50,169,3	duplicate(Salim Hamid#ac)	Salim Hamid#ac_b	1_M_MERCHANT
iz_ac02_c,50,169,3	duplicate(Salim Hamid#ac)	Salim Hamid#ac_c	1_M_MERCHANT
iz_ac02_d,50,169,3	duplicate(Salim Hamid#ac)	Salim Hamid#ac_d	1_M_MERCHANT

// - Steward Aydin
// -----------------------------------------------------------------------------
iz_ac02,53,171,3	script	Steward Aydin#ac	4_M_MANAGER,{
	disable_items;
	if (!checkweight(714,3) || (MaxWeight - Weight) < 10000) {
		mes "- 由于你携带的物品太多，任务无法继续。";
		close;
	}
	if (isbegin_quest(12304) == 1) {
		mes "[Steward Aydin]";
		mes "Hamid 先生派你来这里。很高兴见到你。我正在整理账簿，但会抽时间接待你。";
		next;
		mes "[Steward Aydin]";
		mes "交易获利有很多方法……威胁、协商、黑市交易等等。";
		next;
		mes "[Steward Aydin]";
		mes "必要时，甚至可以采取各种暴力血腥的捷径（哇，这家伙是认真的！）";
		next;
		mes "[Steward Aydin]";
		mes "哦，等等，我刚才说了什么？";
		mes "这些行为是法律禁止的。所以商人会获得两项技能，即^4d4fff高价卖出和低价买入^000000……";
		next;
		mes "[Steward Aydin]";
		mes "此外还有一些有用的技能，例如^4d4fff手推车、露天商店、物品鉴定^000000等，虽然它们并不直接属于这两项技能。";
		next;
		mes "[Steward Aydin]";
		mes "这些技能有什么疑问吗？";
		next;
		while(1) {
			switch(select("我已经全都知道了。", "高价卖出和低价买入", "其他技能", "物品鉴定")) {
				case 1:
					mes "[Steward Aydin]";
					mes "你真的确定吗？";
					next;
					if (select("等等，我全都知道。", "不，请再解释一次。") == 1) {
						mes "[Steward Aydin]";
						mes "哦～你没有问题吗？";
						mes "好。你是重实践而非理论的人。";
						next;
						mes "[Steward Aydin]";
						mes "Salim Hamid 先生会提供额外讲座。啊，我有东西要给你。";
						next;
						mes "[Steward Aydin]";
						mes "这是一个装有整理库存时发现的损坏装备的箱子。";
						mes "请用它在商人手册中练习物品鉴定技能。";
						next;
						mes "[Steward Aydin]";
						mes "期待下次以良好的状态见到你。";
						completequest 12304;
						getitem 12847,1;// Old_Equipment_Box
						close;
					}
					mes "[Steward Aydin]";
					mes "哦～抱歉，是我误会你了。";
					mes "我们开始上课吧。";
					next;
					break;
				case 2:
					mes "[Steward Aydin]";
					mes "高价卖出和低价买入很容易使用。";
					next;
					mes "[Steward Aydin]";
					mes "这两项是被动技能。熟悉后，"+strcharinfo(0)+"，它们会在与商人 NPC 交易时自动生效，无需你操作。";
					next;
					mes "[Steward Aydin]";
					mes "学会高价卖出后，向商人 NPC 出售商品时，可以获得按技能等级在普通售价上增加后的销售金额。";
					next;
					mes "[Steward Aydin]";
					mes "相反，低价买入技能会让你从商人 NPC 购买商品时，按照技能等级以低于普通售价的价格购买。";
					next;
					mes "[Steward Aydin]";
					mes "请注意，这两项技能只能用于与普通商人 NPC 交易，不能用于其他制造 NPC 或冒险者之间。";
					next;
					mes "[Steward Aydin]";
					mes "还有问题吗？";
					next;
					break;
				case 3:
					mes "[Steward Aydin]";
					mes "负重上限增加、手推车和露天商店，这三项技能关系密切。";
					next;
					mes "[Steward Aydin]";
					mes "先说^4d4fff负重上限增加^000000，它能提升角色的基础负重点数。学会后会自动生效，是被动技能。";
					next;
					mes "[Steward Aydin]";
					mes "这项技能达到一定等级后，就可以使用^4d4fff手推车^000000技能。";
					next;
					mes "[Steward Aydin]";
					mes "手推车的优点是装载量高，但缺点是会降低移动速度。";
					next;
					mes "[Steward Aydin]";
					mes "手推车达到一定等级后，就可以使用^4d4fff露天商店^000000技能，向其他玩家出售自己的物品。";
					next;
					mes "[Steward Aydin]";
					mes "除此之外还有问题吗？";
					next;
					break;
				case 4:
					mes "[Steward Aydin]";
					mes "物品鉴定是辅助技能，而不是必需技能。";
					next;
					mes "[Steward Aydin]";
					mes "学会后无需使用放大镜就能鉴定物品。";
					next;
					mes "[Steward Aydin]";
					mes "除此之外还有问题吗？";
					next;
					break;
			}
		}
	} else {
		mes "[Steward Aydin]";
		mes "我正忙着整理账簿，下次再聊怎么样？";
		close;
	}
}

iz_ac02_a,53,171,3	duplicate(Steward Aydin#ac)	Steward Aydin#ac_a	4_M_MANAGER
iz_ac02_b,53,171,3	duplicate(Steward Aydin#ac)	Steward Aydin#ac_b	4_M_MANAGER
iz_ac02_c,53,171,3	duplicate(Steward Aydin#ac)	Steward Aydin#ac_c	4_M_MANAGER
iz_ac02_d,53,171,3	duplicate(Steward Aydin#ac)	Steward Aydin#ac_d	4_M_MANAGER

// =============================================================================
// = Thief
// =============================================================================

// - Guest Lecturer Mayssel
// - Teaches the player about the Thief class.
// -----------------------------------------------------------------------------
iz_ac02,52,136,3	script	Guest Lecturer Mayssel#0	4_F_MAYSEL,{
	if (!checkweight(1301,3)) {
		mes "由于背包过满，任务无法继续。";
		mes "整理物品后请再试一次。";
		close;
	}

	if (isbegin_quest(4269) > 0 && Class == Job_Novice) {
		if (!isbegin_quest(7480)) {
			mes "[Lumin]";
			mes ".......... Then";
			cutin "nov_lumin01.bmp", 2;
			next;
			cutin "gc_mayssel05.bmp", 1;
			mes "[Mayssel]";
			mes "我明白了，Lu，就按你的想法做吧。";
			next;
			select("呃，你好……");
			cutin "gc_mayssel01.bmp", 1;
			mes "[Mayssel]";
			mes "对不起……";
			mes "你是克里图拉学院的学生吗？";
			mes "我不是故意无视你的。";
			mes "他也是这门课的学生之一。";
			next;
			mes "[Mayssel]";
			mes "你好，" + strcharinfo(0) + "";
			mes "我是 Mayssel，刺客公会 Veins 分部的负责人。";
			mes "我来这里是为了向你介绍盗贼职业的一些信息。";
			next;
			mes "[Mayssel]";
			mes "你想了解盗贼职业吗？";
			next;
			if (select("好的，请告诉我。", "不，我不想成为盗贼。") == 2) {
				mes "[Mayssel]";
				mes "如果你想了解……";
				cutin "gc_mayssel05.bmp", 1;
				close2;
				cutin "", 255;
				end;
			}
			mes "[Mayssel]";
			mes "通常来说，盗贼会被认为是罪犯。";
			mes "但我们的公会并不是从需要物品的人那里夺取东西。";
			next;
			mes "[Mayssel]";
			mes "首先，我们要说明这一点。";
			mes "我们不偷窃他人的财物。";
			next;
			mes "[Lumin]";
			mes "那怪物呢？";
			cutin "nov_lumin01.bmp", 2;
			next;
			cutin "", 255;
			mes "[Mayssel]";
			mes "至于怪物……";
			cutin "gc_mayssel03.bmp", 1;
			next;
			mes "[Verkhasel]";
			mes "嘿，冷静点。";
			mes "你说这是为了重要事情的任务。但却只是这种地方……";
			cutin "gc_verkhasel01.bmp", 2;
			next;
			cutin "gc_mayssel01.bmp", 1;
			mes "[Mayssel]";
			mes "我刚才有些激动……";
			mes "让我继续说。";
			mes "盗贼使用普通盗贼掌握的技巧，行动快速而灵活。";
			next;
			mes "[Mayssel]";
			mes "我们利用隐身融入环境，并攻击敌人。";
			next;
			mes "[Mayssel]";
			mes "我们的主要武器是短剑，并通过给攻击附加毒属性来弥补攻击力。";
			next;
			mes "[Mayssel]";
			mes "盗贼的进阶职业是刺客和流氓。";
			mes "Verkhasel 是刺客系的三转职业十字斩首者。";
			mes "还有……";
			next;
			mes "[Mayssel]";
			mes "Vicente 先生……我叫 Dumk……";
			cutin "gc_mayssel02.bmp", 1;
			next;
			mes "[Vicente]";
			mes "啊，那是……Mayssel……";
			mes "你很了解大师。";
			mes "我可以向你介绍流氓。";
			next;
			mes "[Mayssel]";
			mes "我明白了……";
			mes "" + strcharinfo(0) + " Sorry but you can learn about the Shadow Chaser class from them.";
			cutin "gc_mayssel03.bmp", 1;
			next;
			cutin "gc_mayssel01.bmp", 1;
			mes "[Mayssel]";
			mes "总之，这两位先生会帮助你。";
			mes "^4d4dffCome back to me after speaking to Verkhasel and Vicente.^000000";
			setquest 7480;
			close2;
			cutin "", 255;
			end;
		} else if (isbegin_quest(7480) == 1) {
			if (isbegin_quest(7481) > 0 && isbegin_quest(7482) > 0) {
				mes "[Mayssel]";
				mes "你了解盗贼、刺客和流氓了吗？";
				mes "你现在不需要理解全部内容。";
				cutin "gc_mayssel01.bmp", 1;
				next;
				if (BaseLevel > 12) {
					mes "[Mayssel]";
					mes "我只是负责告诉你有这些内容……";
					mes "下一课是如何使用经验指南……我们快速看一下。";
					next;
					mes "[Mayssel]";
					mes "学院提供的技能体验指南可以使用到 12 级。";
					mes "遗憾的是，你现在只能阅读说明。";
					next;
					mes "[Mayssel]";
					mes "如果你想成为盗贼，就回来这里。";
					mes "我可以帮助你完成转职的第一步。";
					next;
					mes "[Mayssel]";
					mes "谢谢你的努力。";
					cutin "gc_mayssel02.bmp", 1;
					completequest 7480;
					erasequest 7481;
					erasequest 7482;
					setquest 7483;
					completequest 7483;
					getexp 800,50;
					getitem 569,30;// Novice_Potion
					getitem 12325,20;// N_Magnifier
				} else {
					mes "[Mayssel]";
					mes "我只是负责告诉你有这些内容……";
					mes "那么，我们来谈谈盗贼的技能。";
					next;
					mes "[Mayssel]";
					mes "我会给你指南，让你暂时体验盗贼技能。";
					mes "整理好指南物品后，你可以在“ETC”技能窗口看到有用的技能。";
					next;
					mes "[Mayssel]";
					mes "利用这份指南，你可以接受 Verkhasel 和 Vicente 要求的任务。";
					completequest 7480;
					erasequest 7481;
					erasequest 7482;
					setquest 7483;
					getitem 2820,1;// Thief_Manual
				}
				close2;
				cutin "", 255;
				end;
			} else {
				mes "[Mayssel]";
				mes "Verkhasel 和 Vicente 会提供进阶职业的各种信息。";
				mes "所以听完他们的介绍后再回来找我。";
				cutin "gc_mayssel01.bmp", 1;
				next;
				mes "[Mayssel]";
				mes "接下来是实战准备。";
				next;
				if (select("我明白了……", "我不做。") == 1) {
					mes "[Mayssel]";
					mes "任务完成后我会给你补偿。";
					mes "和 Verkhasel、Vicente 谈完后回来找我。";
				} else {
					mes "[Mayssel]";
					mes "我明白了……";
					mes "这门课程现在取消。";
					erasequest 7480;
				}
				close2;
				cutin "", 255;
				end;
			}
		} else {
			if (!isbegin_quest(7483)) {
				mes "[Mayssel]";
				mes "你了解盗贼、刺客和流氓了吗？";
				mes "你现在不需要理解全部内容。";
				cutin "gc_mayssel01.bmp", 1;
				next;
				if (BaseLevel > 12) {
					mes "[Mayssel]";
					mes "我只是负责告诉你有这些内容……？";
					mes "下一课是如何使用经验指南……我们快速看一下。";
					next;
					mes "[Mayssel]";
					mes "学院提供的技能体验指南可以使用到 12 级。";
					mes "遗憾的是，你现在只能阅读说明。";
					next;
					mes "[Mayssel]";
					mes "如果你想成为盗贼，就回来这里。";
					mes "我可以帮助你完成转职的第一步。";
					next;
					mes "[Mayssel]";
					mes "你辛苦了。";
					cutin "gc_mayssel02.bmp", 1;
					completequest 7480;
					erasequest 7481;
					erasequest 7482;
					setquest 7483;
					completequest 7483;
					getexp 800,50;
					getitem 569,30;// Novice_Potion
					getitem 12325,20;// N_Magnifier
				} else {
					mes "[Mayssel]";
					mes "我只是负责告诉你有这些内容……";
					mes "那么，我们来谈谈盗贼的技能。";
					next;
					mes "[Mayssel]";
					mes "我会给你指南，让你暂时体验盗贼技能。";
					mes "整理好指南物品后，你可以在“ETC”技能窗口看到有用的技能。";
					next;
					mes "[Mayssel]";
					mes "利用这份指南，你可以接受 Verkhasel 和 Vicente 要求的任务。";
					completequest 7480;
					erasequest 7481;
					erasequest 7482;
					setquest 7483;
					getitem 2820,1;// Thief_Manual
				}
				close2;
				cutin "", 255;
				end;
			} else if (isbegin_quest(7483) == 1) {
				if (isbegin_quest(7484) > 1 && isbegin_quest(7485) > 1) {
					cutin "gc_mayssel01.bmp", 1;
					mes "[Mayssel]";
					mes "你感觉到成为盗贼是什么样了吗？";
					mes "如果你想使用二刀连击等技能，请拜访^4d4dff一楼的 Subino 先生^000000。";
					next;
					mes "[Mayssel]";
					mes "<NAVI>[战斗教官 Subino]<INFO>iz_ac01,59,83</INFO></NAVI>会提供几个战斗任务。";
					next;
					mes "[Mayssel]";
					mes "希望你通过战斗任务体验其他技能。";
					mes "二刀连击是个相当刺激的技能。";
					next;
					mes "[Mayssel]";
					mes "至少体验过后再做决定。";
					mes "距离做决定还很远，你还有足够时间……请认真考虑。";
					next;
					mes "[Mayssel]";
					mes "如果你想成为盗贼，就回来这里。";
					mes "我可以帮助你完成转职的第一步。";
					next;
					mes "[Mayssel]";
					mes "谢谢你的努力。";
					completequest 7483;
					getexp 800,50;
					getitem 569,30;// Novice_Potion
					getitem 12325,20;// N_Magnifier
					close2;
					cutin "", 255;
					end;
				} else {
					cutin "gc_mayssel01.bmp", 1;
					mes "[Mayssel]";
					mes "在战斗训练中，实战比理论更重要。";
					mes "实际使用一次技能胜过说这么多话。";
					next;
					mes "[Mayssel]";
					mes "如果你完成 Verkhasel 和 Vicente 要求的任务，我就会进入下一课。";
					next;
					if (select("我明白了。", "我不做。") == 1) {
						mes "[Mayssel]";
						mes "任务完成后我会给你补偿。";
						mes "听完 Verkhasel 和 Vicente 的介绍后回来找我。";
						close2;
						cutin "", 255;
						end;
					} else {
						mes "[Mayssel]";
						mes "我明白了。";
						mes "这门课程现在取消。";
						mes "正在进行的低阶课程将取消。";
						next;
						if (select("不。", "是，取消课程。") == 1) {
							mes "[Mayssel]";
							mes "幸好……";
							mes "很高兴你有耐心。";
							close2;
							cutin "", 255;
							end;
						}
						mes "[Mayssel]";
						mes "所有正在进行的课程都取消。";
						mes "这些课程不适合你的资质。";
						nude;
						if (countitem(2820) > 0)
							delitem 2820,countitem(2820);// Thief_Manual
						erasequest 7483;
						erasequest 7484;
						erasequest 7485;
						close2;
						cutin "", 255;
						end;
					}
				}
			} else {
				cutin "gc_mayssel01.bmp", 1;
				mes "[Mayssel]";
				mes "你对什么感兴趣？";
				mes "如果你想了解战斗，请拜访 <NAVI>[战斗教官 Subino]<INFO>iz_ac01_c,59,83</INFO></NAVI>。";
				next;
				switch(select("转职为盗贼。", "盗贼属性说明", "盗贼技能说明", "没兴趣。")) {
				case 1:
					if (JobLevel > 9) {
						mes "[Mayssel]";
						mes "你已经下定决心了。";
						mes "欢迎来到影子的世界。";
						cutin "gc_mayssel02.bmp", 1;
						next;
						cutin "gc_mayssel01.bmp", 1;
						mes "[Mayssel]";
						mes "如果你准备好了，我会把你送到梦罗克沙漠，拥抱黑影。";
						mes "这段旅程既奇异又充满挑战。";
						next;
						if (select("请马上送我去。", "我还需要一些时间。") == 2) {
							mes "[Mayssel]";
							mes "是的，充分了解其他职业后再做决定吧。";
							close2;
							cutin "", 255;
							end;
						}
						mes "[Mayssel]";
						mes "^4d4dffFind the Pyramid^000000 in the ^4d4dffNorthwest^000000 of Morocc.";
						close2;
						cutin "", 255;
						warp "morocc", 30, 290;
						end;
					} else {
						mes "[Mayssel]";
						mes "抱歉，你的 Job 等级不足，无法转职。";
						next;
						mes "[Mayssel]";
						mes "等级由 Base 等级和 Job 等级组成。";
						mes "Job 等级决定你当前的职业。";
						next;
						mes "[Mayssel]";
						mes "^4d4dff一转条件是 Job 等级 10。^000000";
						mes "你需要更多经验，所以先多战斗并升级吧。";
						close2;
						cutin "", 255;
						end;
					}
				case 2:
					mes "[Mayssel]";
					mes "你想进一步了解属性吗？";
					mes "正如 Vicente 已经告诉你的，属性没有固定答案。";
					cutin "gc_mayssel01.bmp", 1;
					next;
					mes "[Mayssel]";
					mes "如果要从中选择一项，";
					mes "^4d4dffAGI 与闪避能力有关^000000，";
					mes "^4d4dffDex 与命中率有关";
					mes "STR 提升物理攻击力^000000";
					next;
					mes "[Mayssel]";
					mes "Vit、Luk、Int 的价值取决于你选择的目标。";
					mes "供你参考，Verkhasel 的 Luk 等级很高。";
					mes "一种叫卡塔勒的武器适合进行暴击。";
					next;

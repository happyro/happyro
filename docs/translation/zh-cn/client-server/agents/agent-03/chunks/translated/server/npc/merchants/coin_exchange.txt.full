// Manuk & Splendide
//============================================================
-	script	::merchant_13_2	-1,{
	set .@n$, "["+strnpcinfo(1)+"]";
	mes .@n$;
	if (isequipped(2782) && ep13_2_rhea == 100) {
		if (!checkweight(1201,1)) {
			mes "看来你携带的东西太多了。";
			mes "不如把一些物品存进仓库再回来？";
			close;
		}
		mes "你好。";
		mes "你想找什么？";
		next;
		if (strnpcinfo(1) == "Merchant of Manuk") {
			setarray .@Items[2],12342,12343,12348;
			set .@Book,11019; //Manuk_Selling_Item
			set .@Coin,6080; //Manuk_Coin
			set .@i, select("查看物品说明:曼格的机会:曼格的勇气:曼格的信仰:取消");
		}
		else {
			setarray .@Items[2],12344,12345,12349;
			set .@Book,11018; //Splendide_Selling_Item
			set .@Coin,6081; //Splendide_Coin
			set .@i, select("查看物品说明:购买食人花果酱:购买荧光花蜂蜜酱:购买独角兽之泪:什么也不做");
		}
		mes .@n$;
		if (.@i == 1) {
			mes "这是物品说明。";
			close2;
			readbook .@Book,1;
			end;
		}
		else if (.@i < 5) {
			mes "我可以用"+getitemname(.@Items[.@i])+"^3131FF1枚硬币^000000卖给你 3 个。";
			next;
			switch(select("购买:不购买")) {
			case 1:
				if (countitem(.@Coin)) {
					mes .@n$;
					mes "感谢光临。";
					delitem .@Coin,1; 
					getitem .@Items[.@i],3;
					close;
				}
				else {
					mes .@n$;
					mes "你的硬币不够。";
					close;
				}
			case 2:
				mes .@n$;
				break;
			}
		}
		mes "改变主意后欢迎再来。";
		close;
	}
	else {
		if (strnpcinfo(1) == "Merchant of Manuk") {
			mes "Rtt od d";
			mes "Qwo hd is d irr";
		}
		else {
			mes "BurWehAla";
			mes "tasnarAndu Ie Ru";
		}
		close;
	}
}
man_in01,286,16,1	duplicate(merchant_13_2)	Merchant of Manuk	454
spl_in01,110,326,5	duplicate(merchant_13_2)	Merchant of Splendide	439

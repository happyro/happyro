	mes "我愿用一生报答你！从现在起我是你谦卑的仆人。主人，你有什么吩咐？";
		next;
		mes "["+strcharinfo(0)+"]";
	mes "这……太过分了。";
	mes "没必要一辈子当我的仆人。";
		next;
		mes "[Morriphen]";
	mes "等等，我知道了！如果你不接受我的生命，我可以给你别人的。";
	mes "你有敌人吗？我出去替你杀掉！";
		next;
		mes "["+strcharinfo(0)+"]";
	mes "……不用了。其实我更想知道你、Siria 和 Dono 的关系。";
	mes "我和 Siria 交谈时，她说你们并没有结婚……";
		next;
		mes "["+strcharinfo(0)+"]";
	mes "Siria 确实说过她因某种原因欠你很多，";
	mes "即使付出生命也无法完全偿还。";
		next;
		mes "[Morriphen]";
	mes "她这么说？^333333*叹气*^000000";
	mes "可怜的女孩，我劝过她很多次别这样想。";
	mes "好吧，既然你想知道，我就告诉你我们的故事。";
		next;
		mes "[Morriphen]";
	mes "Dono 和我从小就是朋友，几乎什么都一起做。";
	mes "开始职业生涯后，我们也都决定为 Rekenber 公司工作。";
		next;
		mes "[Morriphen]";
	mes "Dono 后来负责 Rekenber 的医学实验研究，";
	mes "而我主导 Rekenber 的武器研究项目。";
		next;
		mes "[Morriphen]";
	mes "虽然专长不同，但 Dono 和我发现合作对双方都很有成果。";
	mes "然而有一天，我去 Dono 的办公室见到了她。";
		next;
		mes "[Morriphen]";
	mes "她漂浮在巨大的试管里，我目不转睛地看着她：她是我见过最美的事物。";
	mes "但 Dono 说她只是一项实验……";
		next;
		mes "[Morriphen]";
	mes "他让我别太好奇，但我没听。";
	mes "从那以后我尽可能常去他的办公室，找借口见她。我无法自拔，我爱上了她。";
		next;
		mes "[Morriphen]";
	mes "后来我听说 Dono 的研究没有产生预期结果，他要关闭一切。所有实验都会被处理掉。";
		next;
		mes "[Morriphen]";
	mes "那晚下着暴风雪，但我冒着严寒潜入 Rekenber 实验室。";
	mes "我把她从试管里救出来，放火烧了实验室，然后逃了出去。";
		next;
		mes "[Morriphen]";
	mes "当时我不知道自己在火灾中接触了化学品。";
	mes "它们严重损伤了我的组织，所以我现在非常依赖这些药物。";
		next;
		mes "[Morriphen]";
		mes "总之，我们逃离实验室，躲进山里。";
		mes "我背着她尽可能走远。最后我无法抵抗眩晕，突然昏了过去。";
		next;
		mes "[Morriphen]";
		mes "昏倒前我记得看到一个高大的长袍男子。";
		mes "他说要把我们带到休耶，迷失者、奥丁阴影下诞生者的休息地。真奇怪……";
		next;
		mes "[Morriphen]";
		mes "我看不见他的脸。兜帽遮住了脸，";
		mes "但我想他的名字是……Mawon……Mawong？";
		mes "总之，醒来时我们躺在休耶村温暖的床上。";
		next;
		mes "[Morriphen]";
		mes "我们遇到的人非常体贴、热情友好。";
		mes "他们没有问任何问题，直接接纳了我们。";
		mes "我救的女孩当时还不会说话……";
		next;
		mes "[Morriphen]";
		mes "我康复后立刻教她我们的语言，还给她取名 Siria。";
		mes "她不再是实验，而是我的爱人。但我们并没有从此幸福地生活。";
		next;
		mes "[Morriphen]";
		mes "为了生存，我必须养活我们两人，于是在艾因布洛克和拉赫工作。";
		mes "后来我在拉赫一家破旧的药草店遇到 Dono。我感到非常羞愧……";
		next;
		mes "[Morriphen]";
		mes "我烧毁了他的实验室，这一定损害了他在公司的声誉。";
		mes "但我告诉他发生的事后，他似乎理解了，甚至开始帮助我……";
		next;
		mes "[Morriphen]";
		mes "你知道，Siria 原本要成为大规模杀人武器。";
		mes "Dono 的实验失败，是因为她反抗了他们的计划。";
		mes "她不只是实验或武器。";
		next;
		mes "[Morriphen]";
		mes "如果一切按 Dono 的计划发展，Siria 会成为士兵，";
		mes "而我会为她提供武器，提供军事研发巅峰的尖端装备。";
		next;
		mes "[Morriphen]";
		mes "我为 Rekenber 工作时，曾研究量产传说之剑‘处刑者’的仿制品。";
		mes "它们不会是完美复制品，但想想成功后会发生什么。";
		next;
		mes "[Morriphen]";
		mes "想想看，我们本来都能发财。";
		mes "我负责武器制造，而最大的客户阿鲁纳佩尔茨会给我们好生意。";
		next;
		mes "[Morriphen]";
		mes "我做出了选择，没有后悔。事实上，我不会改变人生，也不会把 Siria 交出去。";
		mes "但 Dono 可能想法不同：工作就是他的生命。";
		next;
		mes "[Morriphen]";
		mes "我觉得 Dono 永远不会把我和 Siria 的事告诉 Rekenber。";
		mes "我无法报答他现在对我们的帮助，但他内心一定恨我。";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "别这么想。Dono 一定仍把你当朋友。";
		mes "他对发生的事很苦涩，但不会抛弃你。去见见他吧？";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "而且你现在有去见他的理由——你的药，对吧？";
		mes "去看望他，和 Siria 幸福生活，就是对他的报答。";
		next;
		mes "[Morriphen]";
		mes "^333333*抽泣*^000000你说得对……";
		mes "对不起，Dono！^333333*抽鼻子*^000000";
		mes "非常感谢你。再来休耶时来看看我。你帮了我和 Siria 很多。";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "别担心。快点好起来，这样我就不用担心你了。保重~";
		set hg_bio,9;
		getexp (checkre(3))?70000:700000,0;
		completequest 11016;
		close;
	} else if (hg_bio == 9) {
		mes "[Morriphen]";
		mes "哦，好久不见~";
		mes "是的，我和妻子幸福极了。";
		mes "我们悠闲地生活，也完全康复了。神奇吧？";
		next;
		mes "[Morriphen]";
		mes "哦，我们终于在休耶举行了小型婚礼。";
		mes "有空来我们家做客吧？";
		close;
	} else {
		mes "[Morriphen]";
		mes "哦，好久不见~";
		mes "是的，我和妻子幸福极了。";
		mes "我们悠闲地生活，也完全康复了。神奇吧？";
		next;
		mes "[Morriphen]";
		mes "哦，我们终于在休耶举行了小型婚礼。";
		mes "有空来我们家做客吧？";
		close;
	}
}

hu_in01,326,307,3	script	Siria	90,{
	if (hg_bio == 1) {
		mes "[Siria]";
		mes "哦，你好。";
		mes "有什么我能帮忙的吗？";
		mes "看起来你想问我什么……";
		next;
		mes "^3355FF这么年轻的女人怎么会是 Morriphen 的妻子？^000000";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "是的，Morriphen 让我来拿他的药。我正要……";
		next;
		mes "[Siria]";
		mes "我的天！他还好吗？";
		mes "求求你，别让他死了！不！发、发生什么坏事了吗？";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "（她惊慌失措，似乎不知道该怎么办。她心不在焉地向前走，然后在地板上绊倒。）";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "你没事吧？！";
		mes "（她的眼神空洞，似乎很难看清东西。）";
		next;
		mes "[Siria]";
		mes "哦，我没事，谢谢。";
		mes "我只是……视力有点问题。";
		mes "那么……他怎么了？";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "他只是身体不舒服。";
		mes "他说药吃完了，需要更多。";
		next;
		mes "[Siria]";
		mes "啊，我的药也刚用完。";
		mes "去找 Morriphen 的朋友，从他那里拿药。";
		mes "他应该在拉赫某处……";
		next;
		mes "[Siria]";
		mes "^333333*Cough cough!*^000000";
		mes "呃，抱歉。让我坐一会儿。*咳！*";
		next;
		mes "^3355FFSiria's face grows";
		mes "脸色苍白，开始大汗淋漓。^000000";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "嗯……你还好吗？你不会也生病了吧？";
		next;
		mes "[Siria]";
		mes "哦，不，不……我只是太担心 Morriphen 了。";
		mes "*Sob* I can't live without him,";
		mes "他是我的全部。我欠他一切，我必须去见 Dono，我要——";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "这样吧，你最好在这里休息。我去拉赫拜访 Dono。你听起来不适合旅行。";
		next;
		mes "[Siria]";
		mes "我……很抱歉麻烦你。但既然 Morriphen 信任你来到这里，我也会信任你。^333333*咳*^000000";
		mes "非常感谢……";
		set hg_bio,2;
		changequest 11009,11010;
		close;
	} else if (hg_bio == 2) {
		mes "[Siria]";
		mes "^333333*Sniff*^000000 Please";
		mes "请尽快去拉赫，从他的朋友 Dono 那里拿^333333*咳*^000000 Morriphen 的药。";
		close;
	} else if (hg_bio == 3) {
		mes "[Siria]";
		mes "哦，你见过 Dono 吗？我非常感谢他的帮助。无论他说什么，他都是 Morriphen 的好朋友。";
		close;
	} else if (hg_bio == 4) {
		mes "[Siria]";
		mes "哦，你见过 Dono 吗？我非常感谢他的帮助。无论他说什么，他都是 Morriphen 的好朋友。";
		close;
	} else if (hg_bio == 5) {
		mes "[Siria]";
		mes "哦，你见过 Dono 吗？我非常感谢他的帮助。无论他说什么，他都是 Morriphen 的好朋友。";
		close;
	} else if (hg_bio == 6) {
		mes "[Siria]";
		mes "*Cough* I-I'm fine,";
		mes "所以别担心我。请尽快把药带给 Morriphen。";
		close;
	} else if (hg_bio == 7) {
		mes "^3355FFYou gently administered";
		mes "把药交给 Siria，她慢慢恢复了意识。^000000";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "嘿，你还好吗？感觉怎么样？";
		mes "Morriphen 让我来这里马上把药给你。";
		next;
		mes "[Siria]";
		mes "...Ah... I can't...";
		mes "我不知道……我……你在哪里……？哦，是你。";
		mes "我想……你刚刚救了我的命。抱歉一直给你添麻烦……";
		next;
		mes "[Siria]";
		mes "我一直是 Morriphen 和 Dono 的累赘。";
		mes "你不知道我怎样毁了他们的生活。我只是……需要休息。";
		mes "谢谢你做的一切……";
		set hg_bio,8;
		getexp (checkre(3))?30000:500000,0;
		changequest 11015,11016;
		close;
	} else if (hg_bio == 8) {
		mes "[Siria]";
		mes "请回去告诉 Morriphen 我好多了。我不想让他担心！";
		close;
	} else if (hg_bio == 9) {
		mes "[Siria]";
		mes "哦，欢迎~";
		mes "非常感谢你帮助我和";
		mes "Morriphen。你真是上天的恩赐，知道吗？";
		close;
	} else {
		mes "[Siria]";
		mes "哦，你好。有什么我能帮忙的吗？";
		close;
	}
}

lighthalzen,88,79,7	script	Dono	85,{
	if (hg_bio == 2) {
		mes "[Dono]";
		mes "你想要什么？直说吧，我没时间。";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "打扰一下，我在找一个叫 Dono 的人。";
		next;
		mes "[Dono]";
		mes "是我，但你到底是谁？";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "我来取 Morriphen 的药。嗯，他的妻子 Siria 说药在你这里。";
		next;
		mes "[Dono]";
		mes "妻子？哼！不太可能。好吧，我明白了。他一定用完了药。";
		mes "天啊，他们还活着？能坚持这么久真是奇迹。唉，算了。";
		next;
		mes "[Dono]";
		mes "他的身体变成这样是他自己的错。现在看看我们有多少药……嗯……糟糕。";
		mes "你说你为 Morriphen 工作，对吧？";
		next;
		mes "[Dono]";
		mes "我有药，但连一个人都不够，更别说他们两个。你得帮我再做一些。";
		mes "现在仔细听，这是我需要的材料……";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "等等，我以为只要给 Morriphen 取药。你是说他的妻子 Siria 也需要药吗？";
		next;
		mes "[Dono]";

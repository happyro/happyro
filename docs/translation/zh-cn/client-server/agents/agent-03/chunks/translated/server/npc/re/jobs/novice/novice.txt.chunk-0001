-	script	Jinha#newbe03::NvJinha	-1,{
	if (job_novice_q < 5) {
		mes "[Jinha]";
		mes "我能帮你什么？";
		mes "嗯？你没有按课程正确进行。";
		next;
		mes "[Jinha]";
		mes "你必须先见 Brade 教官再来找我。我会把你送到 Brade 教官那里。";
		close2;
		warp strnpcinfo(4),100,100;
		end;

//===== rAthena Script =======================================
//= Renewal Novice Training Grounds
//===== By: ==================================================
//= Kisuka
//===== Current Version: =====================================
//= 1.6
//===== Compatible With: =====================================
//= rAthena Project
//===== Description: =========================================
//= [Official Conversion]
//= A tutorial for new players starting at new_1-1 (53,111).
//=
//= This script was replaced by the Izlude Academy in 2012.
//===== Additional Comments: =================================
//= 1.0 First version, hand scripted from iRO. [Kisuka]
//= 1.1 Updated warps, savepoints, NPC locations. [Kisuka]
//= 1.2 Cleaning. [Euphy]
//= 1.3 Fixed Eden Group Officer's level requirement. [Joseph]
//= 1.4 Fixed checkquest to check quest accordingly. [Joseph]
//= 1.4a Added 'npcskill' command. [Euphy]
//= 1.5 Replaced with the official kRO scripts. [Euphy]
//= 1.6 Added VIP features. [Euphy]
//============================================================

// Main NPCs
//============================================================
-	script	Sprakki#newbe01::NvSprakkiA	-1,{
	if (job_novice_q == 0) {
		mes "[Sprakki]";
		mes "你好！欢迎来到《仙境传说 Online》的世界。我叫 Sprakki，负责向你介绍基础游戏操作。";
		mes "点击[下一步]按钮或按[Enter]继续。";
		next;
		mes "[Sprakki]";
		mes "首先，你需要学习控制角色的基础操作。";
		mes "所有基础的^4d4dff移动、物品选择和攻击^000000都使用鼠标^4d4dff左键^000000。";
		next;
		cutin "tutorial01",3;
		mes "-！信息！-";
		mes "点击地面即可移动角色。";
		mes "只要点击怪物即可攻击，点击这个世界的人们即可与他们交谈。";
		next;
		cutin "",255;
		mes "[Sprakki]";
		mes "首先，试着移动一下。";
		mes "你看到右边的木桥了吗？";
		next;
		mes "[Sprakki]";
		mes "走过那座桥，那里有一座作为训练中心的城堡。";
		mes "我会在城堡里等你。请自己来到城堡。";
		set job_novice_q,1;
		setquest 7117;
		next;
		cutin "tutorial02",3;
		mes "-！信息！-";
		mes "你从 Sprakki 那里接到了任务。";
		mes "你可以在任务信息窗口查看任务内容。";
		next;
		mes "[Sprakki]";
		mes "我会在桥对面的训练中心里等你。";
		next;
		mes "-！信息！-";
		mes "同时按下^4d4dffAlt + U^000000即可打开任务信息窗口。";
		next;
		cutin "",255;
		mes "[Sprakki]";
		mes "你查看过任务信息窗口了吗？";
		mes "我会在桥对面的城堡里等你。";
		close2;
		cutin "",255;
		end;
	} else if (job_novice_q == 1) {
		mes "[Sprakki]";
		mes "我会在东边桥的另一侧等你。";
		close;
	} else {
		mes "[Sprakki]";
		mes "你迷路了吗？";
		mes "你已经走过东边的桥了吗？";
		mes "在训练中心见面后，我会继续指导你。";
		close;
	}
}
new_1-1,53,114,3	duplicate(NvSprakkiA)	Sprakki#nv1a	90
new_2-1,53,114,3	duplicate(NvSprakkiA)	Sprakki#nv2a	90
new_3-1,53,114,3	duplicate(NvSprakkiA)	Sprakki#nv3a	90
new_4-1,53,114,3	duplicate(NvSprakkiA)	Sprakki#nv4a	90
new_5-1,53,114,3	duplicate(NvSprakkiA)	Sprakki#nv5a	90

-	script	Sprakki#newbe05::NvSprakkiB	-1,{
	if (job_novice_q == 0) {
		mes "[Sprakki]";
		mes "你好！欢迎来到《仙境传说 Online》的世界。";
		mes "我叫 Sprakki，负责向你介绍基础游戏操作。";
		mes "点击[下一步]按钮或按[Enter]键继续。";
		next;
		mes "[Sprakki]";
		mes "首先，你需要学习控制角色的基础操作。";
		mes "所有基础的^4d4dff移动、物品选择和攻击^000000都使用鼠标^4d4dff左键^000000。";
		next;
		cutin "tutorial01",3;
		mes "-！信息！-";
		mes "点击地面即可移动角色。";
		mes "只要点击怪物即可攻击，点击这个世界的人们即可与他们交谈。";
		next;
		cutin "",255;
		mes "[Sprakki]";
		mes "那么，我会给你一个与我交谈的任务。";
		mes "对话结束后，左键点击我再次交谈。";
		set job_novice_q,1;
		setquest 7117;
		next;
		cutin "tutorial02",3;
		mes "-！信息！-";
		mes "你从 Sprakki 那里接到了任务。";
		mes "同时按下^4d4dffAlt + U^000000即可在任务信息窗口查看任务内容。";
		next;
		cutin "",255;
		mes "[Sprakki]";
		mes "你查看过任务信息窗口了吗？";
		mes "好了，再和我谈谈吧。";
		close;
	} else if (job_novice_q < 3) {
		if (job_novice_q == 1) {
			mes "[Sprakki]";
			mes "很好！";
			mes "现在你知道如何移动和与他人交谈了，对吧？";
			set job_novice_q,2;
			getexp 600,5;
			completequest 7117;
			next;
		}
		mes "[Sprakki]";
		mes "训练中心就是为你这样的初心者准备的。";
		mes "你将在那里接受训练，熟悉游戏基础。";
		next;
		mes "[Sprakki]";
		mes "当然，训练流程是可选的。如果你想直接去城镇，也没问题。";
		mes "但你会错过训练中心提供的所有好处。";
		next;
		switch(select("开始训练。:立即开始游戏。")) {
		case 1:
			mes "[Sprakki]";
			mes "我会带你去初心者训练中心。";
			mes "里面的“Brade”教官会等你交谈。";
			next;
			mes "[Sprakki]";
			mes "之后“Brade”教官会帮助你。";
			mes "请去见他。";
			setquest 7118;
			next;
			mes "^4d4dff- 你从 Sprakki 那里接到了任务“初心者训练场 -1”。";
			mes "请查看任务信息窗口。-^000000";
			close2;
			savepoint strnpcinfo(4),100,100,1,1;
			warp strnpcinfo(4),100,100;
			end;
		case 2:
			set nov_1st_cos,0;
			set nov_2nd_cos,0;
			set nov_3_swordman,0;
			set nov_3_archer,0;
			set nov_3_thief,0;
			set nov_3_magician,0;
			set nov_3_acolyte,0;
			set nov_3_merchant,0;
			mes "[Sprakki]";
			mes "好，你想立即开始。";
			mes "你想从哪个城镇开始？";
			next;
			set .@select, select("普隆德拉:梦罗克:吉芬:斐扬:艾尔贝塔:伊兹鲁德");
			mes "[Sprakki]";
			mes "我明白了。";
			mes "去变得更强吧！面向光明的未来前进。";
			callfunc "F_NvErase";
			close2;
			switch(.@select) {
			case 1:
				savepoint "prontera",273,354,1,1;
				warp "prontera",273,354;
				break;
			case 2:
				savepoint "morocc",160,94,1,1;
				warp "morocc",160,94;
				break;
			case 3:
				savepoint "geffen",120,100,1,1;
				warp "geffen",120,100;
				break;
			case 4:
				savepoint "payon",70,100,1,1;
				warp "payon",70,100;
				break;
			case 5:
				savepoint "alberta",116,57,1,1;
				warp "alberta",116,57;
				break;
			case 6: // Old coordinates: (94,103)
				savepoint "izlude",128,98,1,1;
				warp "izlude",128,98;
				break;
			}
			end;
		}
	} else {
		mes "[Sprakki]";
		mes "这里是初心者训练场。";
		mes "我会带你去初心者训练中心。";
		close2;
		savepoint strnpcinfo(4),100,100,1,1;
		warp strnpcinfo(4),100,100;
		end;
	}
}
new_1-2,100,29,4	duplicate(NvSprakkiB)	Sprakki#nv1b	90
new_2-2,100,29,4	duplicate(NvSprakkiB)	Sprakki#nv2b	90
new_3-2,100,29,4	duplicate(NvSprakkiB)	Sprakki#nv3b	90
new_4-2,100,29,4	duplicate(NvSprakkiB)	Sprakki#nv4b	90
new_5-2,100,29,4	duplicate(NvSprakkiB)	Sprakki#nv5b	90

-	script	Brade#newbe02::NvBradeA	-1,{
	if (job_novice_q < 2) {
		mes "[Instructor Brade]";
		mes "你好！欢迎来到《仙境传说 Online》的世界。";
		mes "你曾参加过之前的训练场。";
		mes "训练场现在已经由新的管理者接手。";
		next;
		mes "[Instructor Brade]";
		mes "看来我们只能重新开始你的训练了。";
		next;
		mes "[Instructor Brade]";
		mes "我叫 Brade 教官，负责向你介绍基础游戏操作。";
		mes "点击[下一步]按钮或按[Enter]继续。";
		next;
		mes "[Instructor Brade]";
		mes "首先，你需要学习控制角色的基础操作。";
		mes "所有基础的^4d4dff移动、物品选择和攻击^000000都使用鼠标^4d4dff左键^000000。";
		next;
		cutin "tutorial01",3;
		mes "-！信息！-";
		mes "点击地面即可移动角色。";
		mes "只要点击怪物即可攻击，点击这个世界的人们即可与他们交谈。";
		next;
		cutin "",255;
		next;
		mes "[Instructor Brade]";
		mes "首先，试着移动一下。";
		mes "移动一会儿后，再和我交谈。";
		set nov_1st_cos,0;
		set nov_2nd_cos,0;
		set nov_3_swordman,0;
		set nov_3_archer,0;
		set nov_3_thief,0;
		set nov_3_magician,0;
		set nov_3_acolyte,0;
		set nov_3_merchant,0;
		set treasure_alb,0;
		set job_novice_q,2;
		setquest 7118;
		next;
		cutin "tutorial02",3;
		mes "-！信息！-";
		mes "你从 Brade 教官那里接到了任务。";
		mes "你可以在任务信息窗口查看任务内容。";
		next;
		mes "-！信息！-";
		mes "同时按下^4d4dffAlt + U^000000键即可打开任务信息窗口。";
		next;
		cutin "",255;
		mes "[Instructor Brade]";
		mes "你查看过任务信息窗口了吗？";
		mes "好了，再和我谈谈吧。";
		close;
	} else if (job_novice_q < 4) {
		if (job_novice_q == 2) {
			mes "[Instructor Brade]";
			mes "很好。";
			mes "你成功完成了任务，所以我会用经验值奖励你。";
			set job_novice_q,3;
			getexp 900,10;
			completequest 7118;
			next;
			mes "[Instructor Brade]";
			mes "你可以查看画面左上方的 EXP 条，确认通过狩猎或完成任务获得的经验值。";
			next;
			mes "[Instructor Brade]";
			mes "唉……我就简单说吧。";
			mes "……我就是不习惯“礼貌”，你懂吗？";
			mes "别那样看我！";
			next;
			mes "[Instructor Brade]";
			mes "好了，打起精神来，你这个小家伙。";
			mes "接下来是物品和装备。";
			next;
			mes "[Instructor Brade]";
			mes "首先，拿着这些。";
			mes "这些是最基础的装备和恢复药水。";
		} else {
			mes "[Instructor Brade]";
			mes "呃……我们说到哪里了？哦对，继续吧。";
			mes "是关于物品和装备的。";
			next;
			mes "[Instructor Brade]";
			mes "拿着这些。";
			mes "基础装备和恢复药水。";
		}
		set job_novice_q,4;
		getitem 2352,1; //Novice_Plate
		getitem 2510,1; //Novice_Hood
		getitem 2414,1; //Novice_Boots
		getitem 5055,1; //Novice_Egg_Cap
		getitem 1243,1; //Novice_Knife
		getitem 2112,1; //Novice_Guard
		getitem 569,300; //Novice_Potion
		setquest 7119;
		next;
		mes "[Instructor Brade]";
		mes "在左上方的基本信息窗口中，点击“物品”图标打开物品窗口。";
		mes "物品窗口分为……";
		next;
		mes "[Instructor Brade]";
		mes "3 个区域：消耗品、装备和其他物品。";
		mes "要使用或装备物品，只需双击物品，或将其拖入装备窗口。";
		next;
		mes "[Instructor Brade]";
		mes "右键点击物品即可查看详细信息。";
		mes "物品的详细信息会显示出来。";
		next;
		cutin "tutorial04",3;
		mes "!- Info -!";
		mes "右键点击物品查看详细信息。";
		next;
		mes "!- Info -!";
		mes "右键点击其他玩家可以显示社交菜单，你可以加入队伍或请求与玩家交易等。";
		next;
		cutin "",255;
		mes "[Instructor Brade]";
		mes "不如装备我之前给你的物品？";
		mes "^4d4dff双击^000000想装备的物品。装备完毕后我们继续。";
		next;
		cutin "tutorial03",3;
		mes "!- Info -!";
		mes "双击物品即可轻松装备或使用。";
		mes "打开背包窗口的快捷键是 ALT + E。";
		next;
		mes "!- Info -!";
		mes "要查看当前装备的物品，请使用快捷键 ALT + Q。";
		mes "或者将物品拖到想装备的物品栏位。";
		next;
		mes "!- Info -!";
		mes "装备 Brade 教官给你的全部装备。";
		close2;
		cutin "",255;
		end;
	} else if (job_novice_q == 4) {
		if (isequipped(2414) + isequipped(2352) + isequipped(2510) + isequipped(2112) + isequipped(1243) < 4) {
			mes "[Instructor Brade]";
			mes "试着至少装备我给你的 4 件装备。";
			mes "穿上鞋子和衣服，再拿起那把武器，你这个小家伙。";
			close;
		}
		mes "[Instructor Brade]";
		mes "你准备好了。";
		mes "你做得非常好。";
		set job_novice_q,5;
		getexp 1200,15;
		getitem 12323,50; //N_Fly_Wing
		getitem 12324,20; //N_Butterfly_Wing
		completequest 7119;
		next;
		mes "[Instructor Brade]";
		mes "这是给你的奖励：苍蝇翅膀和蝴蝶翅膀。";
		mes "你在训练场暂时用不到它们，但以后会派上用场。";
		next;
		mes "[Instructor Brade]";
		mes "接下来是快捷键。";
		mes "按下键盘上的^4d4dffF12 键^000000。";
		mes "会弹出一个有 9 个栏位的窗口。";
		next;
		mes "[Instructor Brade]";
		mes "拖动快捷键窗口的右下角，就能看到其他快捷页。";
		next;
		mes "[Instructor Brade]";
		mes "F1 到 F9 是指定的快捷键。";
		mes "将技能或物品拖到快捷键窗口，再按对应按键即可立即使用。";
		next;
		cutin "tutorial05",3;
		mes "!- Info -!";
		mes "将技能或物品拖到快捷栏位，即可登记到快捷键窗口。";
		next;
		mes "!- Info -!";
		mes "按对应按键即可使用或装备已登记的技能和物品。";
		next;
		mes "!- Info -!";
		mes "在选项菜单中修改快捷键设置，就能自定义想使用的快捷键。";
		next;
		mes "!- Info -!";
		mes "登记常用技能和物品，方便使用。";
		next;
		cutin "",255;
		mes "[Instructor Brade]";
		mes "最后是技能的使用方法。";
		mes "但在此之前，你需要先学习一项技能。";
		next;
		mes "[Instructor Brade]";
		mes "这个房间里有一个叫^4d4dffJinha^000000的人。";
		mes "找到 Jinha，向他学习^4d4dff[急救]^000000技能。";
		setquest 7120;
		next;
		mes "[Instructor Brade]";
		mes "之后就是你的课程。";
		mes "去找 Jinha 学习[急救]技能，然后回来找我。";
		close;
	} else if (job_novice_q == 5) {
		mes "[Instructor Brade]";
		mes "这个房间里有一个叫^4d4dffJinha^000000的人。";
		mes "找到 Jinha，向他学习^4d4dff[急救]^000000技能。";
		close;
	} else if (job_novice_q == 6) {
		mes "[Instructor Brade]";
		mes "现在你已经学会[急救]技能了。";
		mes "正如我之前说的，将急救技能登记到快捷键窗口后，就能快速方便地使用。";
		next;
		mes "[Instructor Brade]";
		mes "就是这样，这些是我能教你的全部内容。";
		mes "你看到西边的出口了吗？";
		mes "前往下一个房间，那里会有另一位教官等你。";
		next;
		mes "[Instructor Brade]";
		mes "我们很快还会见面的。";
		mes "但现在先去西边的房间获取更多信息。";
		next;
		mes "[Instructor Brade]";
		mes "你一路做得很好。";
		mes "这不是什么贵重物品，但请收下作为奖励。";
		set job_novice_q,7;
		getitem 2393,1; //N_Adventurer's_Suit
		completequest 7120;
		close;
	} else if (job_novice_q == 7) {
		mes "[Instructor Brade]";
		mes "训练的下一步在这里西边的房间进行。";
		mes "如果你迷路了，我可以送你过去。";
		next;
		switch(select("我可以自己过去。:请把我送到下一个房间。")) {
		case 1:
			mes "[Instructor Brade]";
			mes "很好，这才是你应该有的态度。";
			mes "你不能总是依赖别人帮助你。";
			mes "现在，出发吧。";
			close;
		case 2:
			mes "[Instructor Brade]";
			mes "好吧。";
			mes "我想这总比看着你迷路乱转好。";
			mes "哈哈哈哈……";
			close2;
			warp strnpcinfo(4),41,172;
			end;
		}
	} else {
		mes "[Instructor Brade]";
		mes "你在这里的课程还没结束吗？";
		mes "还是你只是迷路了？";
		next;
		switch(select("送我去战斗训练场。:我想去城镇。")) {
		case 1:
			mes "[Instructor Brade]";
			mes "当然。";
			mes "小心别再迷路了。";
			close2;
			warp "new_"+charat(strnpcinfo(4),4)+"-3",96,21;
			end;
		case 2:
			mes "[Instructor Brade]";
			mes "城镇……嗯？";
			mes "那样的话，我会把你送到卡普拉职员所在的地方。";
			mes "使用^4d4dff卡普拉的传送服务^000000前往城镇。";
			close2;
			warp strnpcinfo(4),41,172;
			end;
		}
	}
}
new_1-2,100,105,3	duplicate(NvBradeA)	Brade#nv1a	733
new_2-2,100,105,3	duplicate(NvBradeA)	Brade#nv2a	733
new_3-2,100,105,3	duplicate(NvBradeA)	Brade#nv3a	733
new_4-2,100,105,3	duplicate(NvBradeA)	Brade#nv4a	733

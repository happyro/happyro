ba_maison,249,161,3	script	Adore#jh5	4_EP17_BASIC_B,{
	if (ep17_2_main == 17) {
		cutin "ep172_beta",2;
		mes "[Adore]";
		mes "你好，访客。我能帮你吗？";
		next;
		cutin "",255;
		select( "过去关于佣兵的记录。" );
		cutin "ep172_beta",2;
		mes "[Adore]";
		mes "过去访客的记录很多，你需要哪种记录？";
		next;
		cutin "",255;
		select( "关于名叫H的佣兵。" );
		cutin "ep172_beta",2;
		mes "[Adore]";
		mes "正在搜索……搜索完成。关于H先生的记录很少……";
		mes "不过，有很多别人谈论H先生的记录。";
		next;
		mes "[Adore]";
		mes "如果你想阅读记录，我会为你准备。";
		next;
		cutin "",255;
		cloakoffnpcself( "Mercenary#jh5_5" );
		cloakoffnpcself( "Mercenary#jh5_6" );
		specialeffect EF_DA_SPACE, AREA, "Mercenary#jh5_5";
		specialeffect EF_DA_SPACE, AREA, "Mercenary#jh5_6";
		mes "..................";
		mes "..................";
		next;
		mes "[Mercenary]";
		mes "对了，H先生在哪里？";
		mes "我找了他一段时间，但是……";
		emotion ET_QUESTION, getnpcid(0,"Mercenary#jh5_5");
		next;
		mes "[Mercenary]";
		mes "他似乎经常不在。";
		mes "我总有一天要和他谈谈。要是公司的人突然来了怎么办。";
		emotion ET_THINK, getnpcid(0,"Mercenary#jh5_6");
		next;
		mes "[Mercenary]";
		mes "不久前，我看到H先生和一个陌生人交谈。";
		emotion ET_THINK, getnpcid(0,"Mercenary#jh5_5");
		next;
		mes "[Mercenary]";
		mes "你不认识的人？这里怎么会有陌生人？";
		emotion ET_QUESTION, getnpcid(0,"Mercenary#jh5_6");
		next;
		mes "[Mercenary]";
		mes "所以才奇怪。他还在彻底检查周边，不过我很擅长躲藏。";
		emotion ET_THINK, getnpcid(0,"Mercenary#jh5_5");
		next;
		mes "[Mercenary]";
		mes "他们谈了什么？";
		emotion ET_THINK, getnpcid(0,"Mercenary#jh5_6");
		next;
		mes "[Mercenary]";
		mes "距离太远，我没听见。";
		emotion ET_THINK, getnpcid(0,"Mercenary#jh5_5");
		next;
		mes "[Mercenary]";
		mes "你不是藏得好，只是离得远！";
		mes "总之，真的很可疑。到底发生了什么？";
		mes "..................";
		mes "..................";
		emotion ET_SWEAT, getnpcid(0,"Mercenary#jh5_6");
		next;
		cloakonnpcself( "Mercenary#jh5_5" );
		cloakonnpcself( "Mercenary#jh5_6" );
		cutin "ep172_beta",2;
		mes "[Adore]";
		mes "记录输出完成。";
		mes "你需要更多关于H的信息吗？";

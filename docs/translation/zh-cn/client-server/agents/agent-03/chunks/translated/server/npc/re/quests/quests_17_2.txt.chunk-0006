ba_maison,189,56,3	script	Yunas#jh5	4_EP17_BASIC_B,{
	if (ep17_2_main == 17) {
		cutin "ep172_beta",2;
		mes "[Yunas]";
		mes "欢迎，尊贵的客人，我是编号为Yunas的自动人偶。";
		mes "当然，我站在这里就是为了帮助有需要的访客。";
		next;
		cutin "",255;
		select( "我想询问过去的记录。" );
		cutin "ep172_beta",2;
		mes "[Yunas]";
		mes "你想让我查询什么记录？";
		next;
		cutin "",255;
		select( "任何关于佣兵的记录都可以。" );
		cutin "ep172_beta",2;
		mes "[Yunas]";
		mes "我会准备记录。请稍等。";
		next;
		mes "[Yunas]";
		mes "按照访客的要求，我会随机提供数据库中的佣兵记录。";
		next;
		cutin "",255;
		cloakoffnpcself( "Mercenary#jh5_1" );
		cloakoffnpcself( "Mercenary#jh5_2" );
		specialeffect EF_DA_SPACE, AREA, "Mercenary#jh5_1";
		specialeffect EF_DA_SPACE, AREA, "Mercenary#jh5_2";
		mes "..................";
		mes "..................";
		next;
		mes "[Mercenary]";
		mes "我们是怎么来到这里的？";
		emotion ET_THINK, getnpcid(0,"Mercenary#jh5_1");
		next;
		mes "[Mercenary]";
		mes "一座宅邸……属于一个你从未认识的人。";
		mes "我以前从没来过这样的宅邸。";
		emotion ET_THINK, getnpcid(0,"Mercenary#jh5_2");
		next;
		mes "[Mercenary]";
		mes "瓦尔蒙特自愿接纳我们，他究竟是怎样的人？";
		emotion ET_QUESTION, getnpcid(0,"Mercenary#jh5_1");
		next;
		mes "[Mercenary]";
		mes "哦，你应该问问那个人是谁。";
		mes "我们以为都要死了的时候，不是你救了我们吗？";
		emotion ET_THINK, getnpcid(0,"Mercenary#jh5_2");
		next;
		mes "[Mercenary]";
		mes "是的，多亏了瓦尔蒙特先生和H先生，我们才能活着。";
		mes "如果不是H先生让我们来这里，我们现在都已经死了。";
		emotion ET_THINK, getnpcid(0,"Mercenary#jh5_1");
		next;
		mes "[Mercenary]";
		mes "我们在这里恢复体力，为战斗做准备。";
		emotion ET_THINK, getnpcid(0,"Mercenary#jh5_2");
		next;
		mes "..................";
		mes "..................";
		cloakonnpcself( "Mercenary#jh5_1" );
		cloakonnpcself( "Mercenary#jh5_2" );
		next;
		cutin "ep172_beta",2;
		mes "[Yunas]";
		mes "你还想看看其他记录吗？";
		next;
		cutin "",255;
		if (select( "我对名叫H先生的人很好奇。", "没有了。" ) == 2) {
			cutin "ep172_beta",2;
			mes "[Yunas]";
			mes "谢谢你阅读记录！";
			mes "如果你还需要其他记录，请随时询问。";
			close3;
		}
		cutin "",255;
		cloakoffnpcself( "Mercenary#jh5_11" );
		cloakoffnpcself( "Mercenary#jh5_21" );
		specialeffect EF_DA_SPACE, AREA, "Mercenary#jh5_11";
		specialeffect EF_DA_SPACE, AREA, "Mercenary#jh5_21";
		mes "..................";
		mes "..................";
		next;
		mes "[Mercenary]";
		mes "... I think I've finally calm down.";
		mes "所有人都非常愤怒。";
		emotion ET_SWEAT, getnpcid(0,"Mercenary#jh5_11");
		next;
		mes "[Mercenary]";
		mes "但那是不得不做的事。";
		mes "人们就那样死去了……到处都是鲜血，他们的眼睛都翻白了。";
		mes "现在想起来，我深深地后悔。";
		emotion ET_KEK, getnpcid(0,"Mercenary#jh5_21");
		next;
		mes "[Mercenary]";
		mes "我们采用了替代计划，造成的伤亡比应有的更多。";
		mes "我本应该阻止H先生。";
		mes "所有人开始叫喊和恐慌，说我们必须先除掉他们……";
		emotion ET_SCRATCH, getnpcid(0,"Mercenary#jh5_11");
		next;
		mes "[Mercenary]";
		mes "那时H先生和我们都没有伤得那么重。";
		mes "别太责怪H先生。";
		emotion ET_THINK, getnpcid(0,"Mercenary#jh5_21");
		next;
		mes "[Mercenary]";
		mes "嗯，确实如此……别再谈了，继续纠结只会让我们更难受。";
		emotion ET_THINK, getnpcid(0,"Mercenary#jh5_11");
		next;
		mes "..................";
		mes "..................";
		cloakonnpcself( "Mercenary#jh5_11" );
		cloakonnpcself( "Mercenary#jh5_21" );
		next;
		cutin "ep172_beta",2;
		mes "[Yunas]";
		mes "你还想看看其他记录吗？";
		next;
		cutin "",255;
		select( "我看完了。" );
		cutin "ep172_beta",2;
		mes "[Yunas]";
		mes "谢谢你阅读记录！";
		mes "如果你还需要其他记录，请随时询问。";
		next;
		mes "- I need to remember what I heard carefully. -";
		close2;
		cutin "",255;
		if (isbegin_quest(16442) == 1)
			erasequest 16442;
		if (isbegin_quest(16442) == 0 && isbegin_quest(16443) == 0 && isbegin_quest(16444) == 0 && isbegin_quest(16445) == 0 && isbegin_quest(16453) == 0)
			unittalk getcharid(3), "" + strcharinfo(0) + " : I think I've heard enough stories. Should I go back to the teahouse now?", bc_self;
		end;
	}
	cutin "ep172_beta",2;
	mes "[Yunas]";
	mes "欢迎来到瓦尔蒙特宅邸。瓦尔蒙特宅邸提供医疗服务、购物、娱乐和休闲活动等各种便利……";
	next;
	mes "[Yunas]";
	mes "呃，糟糕。不是这个。我不小心告诉了你错误的信息。";
	mes "请忽略它……";
	close3;

OnInit:
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "isbegin_quest(16442) == 1" );
	end;
}


		mes "你给予的好处太多了。";
		mes "照这样下去，会有越来越多的人以各种理由向公司勒索钱财。";
		next;
		cutin "ep171_kaya01",2;
		mes "[Kaya Toss]";
		mes "我不认为这些都算过分。";
		mes "我只是在做我们必须做的事。";
		next;
		cutin "",255;
		mes "[???]";
		mes "呼……如果我知道会和你一起经历这些，我就不会来了。算了，我本来也不是来聊天的。";
		next;
		cutin "ep171_kaya01",2;
		mes "[Kaya Toss]";
		mes "你是什么意思？";
		next;
		cutin "",255;
		mes "[???]";
		mes "谈话毫无意义。现在是让你从这里消失的时候了！";
		next;
		select( "危险！" );
		cloakoffnpcself( "Dien#jh5_2" );
		cutin "ep162_dn03",2;
		mes "[Dien]";
		mes "危险！";
		emotion ET_SURPRISE, getnpcid(0,"Dien#jh5_2");
		next;
		cloakoffnpcself( "Ridsh#jh5_2" );
		cutin "ep162_rds02",2;
		mes "[Ridsh]";
		mes "我来看看出了什么问题，看来有只老鼠出现了。";
		emotion ET_SURPRISE, getnpcid(0,"Ridsh#jh5_2");
		next;
		cloakoffnpcself( "Cotnes#jh5_2" );
		cutin "ep162_ctn02",2;
		mes "[Cotnes]";
		mes "你是谁！我不会放你走！";
		emotion ET_SURPRISE, getnpcid(0,"Cotnes#jh5_2");
		next;
		cutin "",255;
		mes "[???]";
		mes "可恶，你被抓住了吗？！被这些没用却敏锐的老人抓住了！";
		next;
		cloakonnpcself( "Assassin#jh5_1" );
		cutin "ep171_kaya01",2;
		mes "[Kaya Toss]";
		mes "呃，谢谢你们的帮助，长老们。这……这是我毕生投入的工作，而公司却派刺客来杀我。";
		next;
		mes "[Kaya Toss]";
		mes "但我不会输。";
		mes "公司唯一的道路就是清理过去，改善现在。";
		close2;
		cutin "",255;
		ep17_2_main = 22;
		erasequest 16449;
		setquest 16450;
		end;
	}
	if (ep17_2_main == 22) {
		cloakoffnpcself( "Dien#jh5_2" );
		cloakoffnpcself( "Ridsh#jh5_2" );
		cloakoffnpcself( "Cotnes#jh5_2" );
		cutin "ep171_kaya01",2;
		mes "[Kaya Toss]";
		mes "但我不会输。";
		mes "公司唯一的道路就是清理过去，改善现在。";
		close3;
	}
	if (ep17_2_main == 23) {
		cloakoffnpcself( "Dien#jh5_2" );
		cloakoffnpcself( "Ridsh#jh5_2" );
		cloakoffnpcself( "Cotnes#jh5_2" );
		cutin "ep171_kaya01",2;
		mes "[Kaya Toss]";
		mes "明白了。我会联系公司，请一位重要人物与政府和反叛军进行更深入的沟通。";
		next;
		mes "[Kaya Toss]";
		mes "我们应该好好调查这起事件，抓住罪犯。";
		mes "再次感谢你的合作。";
		next;
		cutin "ep162_dn01",2;
		mes "[Dien]";
		mes "你一定很惊讶，但我感谢你迅速采取了行动。";
		next;
		cutin "ep171_kaya01",2;
		mes "[Kaya Toss]";
		mes "那么我们回茶馆吧。我也想稍微冷静一下。";
		mes "长老们，你们愿意和我一起吗？";
		next;
		cutin "ep162_dn02",2;
		mes "[Dien]";
		mes "我很乐意护送你。";
		next;
		cutin "ep171_kaya01",2;
		mes "[Kaya Toss]";
		mes "冒险家，如果你也能和我们一起，我会很感激。";
		mes "我们一起喝茶，等那位重要人物到来。";
		close2;
		cutin "",255;
		cloakonnpcself( "Dien#jh5_2" );
		cloakonnpcself( "Ridsh#jh5_2" );
		cloakonnpcself( "Cotnes#jh5_2" );
		ep17_2_main = 24;
		erasequest 16451;
		setquest 16452;
		getitem 1000103,15;
		getexp 900000,0;	// note: ~exp. getbaseexp_ratio?
		end;
	}
	cutin "ep171_kaya01",2;
	mes "[Kaya Toss]";
	mes "我来这里思考一会儿。";
	close3;

OnInit:
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "isbegin_quest(16449) == 1" );
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "isbegin_quest(16451) == 1" );
	end;
}

ba_maison,100,90,7	script(CLOAKED)	Dien#jh5_2	4_F_DIENE,{
	if (ep17_2_main == 22) {
		cutin "ep162_dn01",2;
		mes "[Dien]";
		mes "我听到了你们的意见。";
		mes "嗯……我现在明白了，你们所说的承担责任并不是当着我们的面说说而已。";
		next;
		mes "[Dien]";
		mes "不过，没有理由相信你能为公司做过的一切道歉。";
		mes "再多相信自己一点吧，我只是想看看你接下来会怎么做。";
		next;
		cutin "ep162_dn03",2;
		mes "[Dien]";
		mes "别忘了。即使我们有一天消失，年轻一代、新的反叛军，以及无数受公司恶行影响的无辜者和其他人，都在注视公司的行为。";
		next;
		mes "[Dien]";
		mes "如果你已经决定了，我想和代表更明确地谈谈。";
		mes "另外，为了正确完成工作，最好不只由我们陪同，也让总统的人一起参与。";
		next;
		cutin "ep162_dn02",2;
		mes "[Dien]";
		mes "首先，让我们看看你迈出的第一步能做到什么。";
		close2;
		cutin "",255;
		ep17_2_main = 23;
		erasequest 16450;
		setquest 16451;
		end;
	}
	end;

OnInit:
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "isbegin_quest(16450) == 1" );
	end;
}


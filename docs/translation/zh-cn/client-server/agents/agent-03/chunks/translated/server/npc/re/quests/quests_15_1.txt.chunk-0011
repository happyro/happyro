		emotion ET_CHUP;
		close;
	case 1:
		mes "嘿！";
		mes "亲爱的，是什么风把你吹来了？";
		mes "如果你想找个肩膀哭诉，我就在这里。";
		emotion ET_CHUP;
		next;
		select("询问登记流程。");
		mes "[Leitner]";
		mes "哦。";
		mes "我早该知道。";
		mes "你是说通往幻影之城的电梯，对吧？";
		emotion ET_THINK;
		next;
		mes "[Leitner]";
		mes "我刚得到这份工作时，电梯是私人使用的，我什么都不用做。";
		next;
		mes "[Leitner]";
		mes "后来管理层向公众开放了电梯，我的生活直接变成了地狱。";
		next;
		mes "[Leitner]";
		mes "啊，为什么是我？！";
		mes "再见了，平静的日子！";
		mes "我忙得几乎没时间陪女士们。";
		emotion ET_HELP;
		next;
		mes "[Leitner]";
		mes "总之，先给你登记。我还想回去休息。";
		mes "呃……在这里写下名字，再在旁边按指纹。";
		mes "完成。很简单吧？";
		next;
		mes "[Leitner]";
		mes "我知道，我知道；既然电梯向公众开放，为什么还要多此一举？";
		next;
		mes "^0000FF- 哔——！ -";
		mes "- 以下用户 -";
		mes "- 已登记。-^000000";
		next;
		mes "[Leitner]";
		mes "好了，";
		mes "你可以走了。";
		mes "现在你可以使用电梯了。";
		ep15_1_elb = 2;
		completequest 11363;// To Phantasmagorika!
		setquest 11364;
		close;
	case 2:
		mes "我知道，我知道；既然电梯向公众开放，为什么还要多此一举？";
		next;
		mes "[Leitner]";
		mes "现在你可以使用电梯了。";
		close;
	default:
		mes "电梯几乎每天都会坏，可能是因为承载了太多人。";
		mes "啊，我需要休息。唉。";
		emotion ET_HELP;
		close;
	}
}

verus04,119,220,3	script	Guide Scarlet#ep15_1bs	4_M_TELEPORTER,{
	if (isbegin_quest(11376) > 0) {
		mes "[Scarlet]";
		mes "嘿！问题解决了！";
		mes "嘿……抱歉，我不该笑，但真的太好笑了……哦……";
		erasequest 11376;
		close;
	}
	.@name$ = strcharinfo(0);
	mes "[Scarlet]";
	switch(ep15_1_elb) {
	case 0:
	case 1:
	case 2:
		mes "*清嗓子*";
		mes "这项设施由^0000FF雷根贝勒^000000提供，";
		next;
		mes "[Scarlet]";
		mes "供^0000FF伊甸园集团成员^000000安全前往^0000FF幻影之城^000000。";
		next;
		mes "[Scarlet]";
		mes "要使用这项设施，你必须是^0000FF已登记幻影之城挖掘项目的伊甸园集团成员^000000。";
		next;
		mes "[Scarlet]";
		mes "只要你是伊甸园集团登记的挖掘者，就可以在^0000FF雷根贝勒公司总部^000000登记使用设施。";
		next;
		mes "[Scarlet]";
		mes "登记后，使用设施前请再次确认登记状态。";
		close;
	case 3:
		mes "你在电梯里做了什么？";
		emotion ET_FRET;
		next;
		mes "[Scarlet]";
		mes "我说过不要在电梯里跑跳！";
		next;
		mes "[Scarlet]";
		mes "真不敢相信你把门撞坏了！";
		next;
		mes "[Mark]";
		mes "是我的错。";
		mes "我本该看好他。";
		emotion ET_PROFUSELY_SWEAT, getnpcid(0, "Mark#ep15_1elb");
		cutin "bu_mark3.bmp",0;
		next;
		mes "[Du]";
		mes "你怎么能让我相信这种破机器？";
		emotion ET_HUK, getnpcid(0, "Du#ep15_1elb");
		cutin "bu_du3.bmp",2;
		next;
		mes "[Mark]";
		mes "够了！";
		mes "向女士道歉！";
		emotion ET_FRET, getnpcid(0, "Mark#ep15_1elb");
		cutin "bu_mark4.bmp",0;
		next;
		mes "[Du]";
		mes "但明明是他先开始的……";
		cutin "bu_du3.bmp",2;
		next;
		mes "[Mark]";
		mes "......";
		emotion ET_FRET, getnpcid(0, "Mark#ep15_1elb");
		cutin "bu_mark4.bmp",0;
		next;
		mes "[Tamarin]";
		mes "我说过别跳！";
		emotion ET_HUK, getnpcid(0, "Tamarin#ep15_1elb");
		cutin "ep143_taang.bmp",2;
		next;
		mes "[Alph]";
		mes "你们几个，";
		mes "别吵了。";
		mes "地板感觉非常不稳定，危险至极。";
		emotion ET_PROFUSELY_SWEAT, getnpcid(0, "Alph#ep15_1elb");
		cutin "bu_alp2.bmp",2;
		next;
		mes "[Scarlet]";
		mes "我们都应该下去并叫技术员……";
		cutin "",255;
		next;
		mes "^FF0000- 砰 -^000000";
		emotion ET_HUK;
		emotion ET_HUK, getnpcid(0, "Du#ep15_1elb");
		emotion ET_HUK, getnpcid(0, "Mark#ep15_1elb");
		emotion ET_HUK, getnpcid(0, "Tamarin#ep15_1elb");
		emotion ET_HUK, getnpcid(0, "Alph#ep15_1elb");
		emotion ET_HUK, getnpcid(0, "Maggi#ep15_1elb");
		next;
		mes "[Maggi]";
		mes "呀啊啊啊——！";
		emotion ET_HUK, getnpcid(0, "Maggi#ep15_1elb");
		cutin "bu_maggi4.bmp",2;
		next;
		mes "[Du]";
		mes "哇！";
		mes "地板震动了！";
		emotion ET_PROFUSELY_SWEAT, getnpcid(0, "Du#ep15_1elb");
		cutin "bu_du5.bmp",2;
		next;
		mes "[Scarlet]";
		mes "停下！";
		mes "大家别动！";
		mes "否则我们可能会坠到底部！";
		emotion ET_HUK;
		cutin "",255;
		next;
		mes "[Scarlet]";
		mes "嘿，";
		mes "你！";
		mes "救命！";
		emotion ET_HELP;
		next;
		mes "[Scarlet]";
		mes "电梯太不稳定了，我们谁都不能动。";
		mes "你能带些东西来^0000FF支撑地板^000000吗？";
		next;
		mes "[Scarlet]";
		mes "我们没时间等技术员！";
		mes "我们只需要朱佩洛斯的 Dimik 掉落的^FF000030 个旧铁板^000000！";
		next;
		mes "[Scarlet]";
		mes "请帮帮我们！";
		ep15_1_elb = 4;
		completequest 11365;
		setquest 11366;
		close;
	case 4:
		mes "小心！";
		mes "大家别动！";
		next;
		mes "[Du]";
		mes "哇——！";
		mes "我们要坠落到地面了！";
		emotion ET_HUK, getnpcid(0, "Du#ep15_1elb");
		cutin "bu_du5.bmp",2;
		next;
		mes "[Tamarin]";
		mes "别说这种话！";
		mes "这都是你的错！";
		emotion ET_FRET, getnpcid(0, "Tamarin#ep15_1elb");
		cutin "ep143_taang.bmp",2;
		next;
		mes "[Scarlet]";
		mes "你们两个安静！";
		mes "你们动一下，我们就都会死！";
		emotion ET_HUK;
		cutin "",255;
		next;
		if (countitem(7319) < 30) {
			mes "[Scarlet]";
			mes "电梯太不稳定了，我们谁都不能动。";
			mes "你能带些东西来^0000FF支撑地板^000000吗？";
			next;
			mes "[Scarlet]";
			mes "我们没时间等技术员！";
			mes "我们只需要朱佩洛斯的 Dimik 掉落的^FF000030 个旧铁板^000000！";
			next;
			mes "[Scarlet]";
			mes "请帮帮我们！";
			close;
		}
		mes "[Scarlet]";
		mes "你带来旧铁板了吗？";
		mes "请小心地一块一块推到这里。";
		delitem 7319,30;// Old_Steel_Plate
		ep15_1_elb = 5;
		completequest 11366;
		next;
		mes "[Scarlet]";
		mes "它们可能撑不了多久，但应该足够让我们逃出去。";
		next;
		select("推入旧铁板。");
		mes "[Scarlet]";
		mes "现在，下来！";
		mes "铁板撑不了多久！";
		next;
		mes "[Du]";
		mes "感谢众神！";
		mes "来，Maggi！";
		mes "牵我的手下来。";
		cutin "bu_du4.bmp",2;
		next;
		mes "[Scarlet]";
		mes "呼……";
		mes "很高兴没人受伤。";
		mes "这次我就算了，";
		mes "但绝不能再有下次！";
		cutin "",255;
		next;
		mes "[Scarlet]";
		mes "还有，" + .@name$ + ", thank you so much.";
		mes "如果没有你，我们可能已经陷入大麻烦。";
		emotion ET_THANKS;
		next;
		mes "[Scarlet]";
		mes "我刚听 Elisha 说了。";
		mes "电梯坏了，所以你只好走路，对吧？";
		next;
		mes "[Scarlet]";
		mes "很抱歉给你带来不便。";
		mes "电梯现在恢复运行了。想上去的话告诉我。";
		next;
		mes "[Mark]";
		mes "呼！" + .@name$ + "，你救了我们。";
		mes "唉，我不知道他什么时候才能长大。";
		emotion ET_THANKS, getnpcid(0, "Mark#ep15_1elb");
		cutin "bu_mark2.bmp",0;
		next;
		mes "[Maggi]";
		mes "*Sob* *Hiccup*";
		mes "谢、谢谢……*哭泣* *抽泣*";
		mes "我好害怕！哇——！";
		emotion ET_THANKS, getnpcid(0, "Maggi#ep15_1elb");
		cutin "bu_maggi4.bmp",2;
		next;
		mes "[Du]";
		mes "...Sorry.";
		cutin "bu_du5.bmp",2;
		next;
		mes "[Tamarin]";
		mes "谢谢。";
		mes "唉，我不敢想象如果没有你，" + .@name$ + ", didn't pass by at that moment.";
		emotion ET_THANKS, getnpcid(0, "Tamarin#ep15_1elb");
		cutin "ep143_tasmi.bmp",2;
		next;
		mes "[Alph]";
		mes "...Thank you.";
		cutin "bu_alp1.bmp",2;
		emotion ET_THANKS, getnpcid(0, "Alph#ep15_1elb");
		next;
		mes "[Tamarin]";
		mes "顺便说，你不觉得奇怪吗";
		mes "新发现的遗迹里竟然安装并运行着电梯？";
		cutin "ep143_tasta.bmp",2;
		next;
		mes "[Mark]";
		mes "嗯，";
		mes "雷根贝勒赞助了挖掘，这对我来说就是充分的理由。";
		cutin "bu_mark1.bmp",0;
		next;
		mes "[???]";
		mes "朱佩洛斯地下的遗迹。是不是很令人兴奋？";
		cutin "",255;
		next;
		mes "[Du]";
		mes "确实！";
		mes "没人知道遗迹是什么时候建造的。";
		mes "走吧！我想第一个知道答案！";
		cutin "bu_du2.bmp",2;
		next;
		mes "[Mark]";
		mes "冷静！";
		mes "你还没吸取教训吗？你差点把电梯弄坏！";
		emotion ET_FRET, getnpcid(0, "Mark#ep15_1elb");
		cutin "bu_mark3.bmp",0;
		next;
		mes "[Scarlet]";
		mes "小心！";
		mes "地板还不稳定！";
		cutin "",255;
		close;
	default:
		mes "你好。";
		mes "请说出你的名字，我要确认登记信息。";
		next;
		if (select( "说出你的名字。", "结束对话。" ) == 2) {
			mes "[Scarlet]";
			mes "祝你今天愉快。";
			close;
		}
		mes "[Scarlet]";
		mes "嗯……";
		mes "是, " + .@name$ + ", your registration has been confirmed.";
		mes "你想移动到朱佩洛斯入口吗？";
		next;
		if (select( "不", "是" ) == 1) {
			mes "[Scarlet]";
			mes "祝你今天愉快。";
			close;
		}
		mes "[Scarlet]";
		mes "准备好了吗？";
		mes "祝你探索顺利！";
		close2;
		warp "yuno_fild07",230,156;
		end;
	}
}

function	script	excavator_part2	{
	mes "[Du]";
	mes "嗯……";
	mes "这里看起来没有我想象中那么有趣。";
	cutin "bu_du3.bmp",2;
	next;
	mes "[Mark]";
	mes "你期待什么？";
	emotion ET_THINK, getnpcid(0, "Mark#ep15_1elb");
	cutin "bu_mark1.bmp",0;
	next;
	mes "[Du]";
	mes "你知道，";
	mes "我以为这里会充满惊人的宝藏。";
	cutin "bu_du2.bmp",2;
	next;
	mes "[Mark]";
	mes "如果真是那样，其他人可能已经捷足先登了。";
	cutin "bu_mark2.bmp",0;
	next;
	mes "[Alph]";
	mes "嗯……";
	mes "这里看起来不起眼，但建筑风格和材料与我在米德加尔特见过的不同。";
	cutin "bu_alp1.bmp",2;
	next;
	mes "[Alph]";
	mes "也和朱佩洛斯的不同。";
	next;
	mes "[Du]";
	mes "哇！";
	mes "大家快来看这个喷泉！";
	emotion ET_HUK, getnpcid(0, "Fountain#ep15_1elb");
	cutin "bu_du2.bmp",2;
	setquest 11367;// Looking for the Traces
	ep15_1_elb = 6;
	return;
}


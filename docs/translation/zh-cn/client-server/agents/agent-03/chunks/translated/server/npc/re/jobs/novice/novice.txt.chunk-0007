		set .@gunslinger_p, .@gunslinger_p+1;
		break;
	case 2:
		set .@acolyte_p, .@acolyte_p+1;
		set .@swordman_p, .@swordman_p+1;
		break;
	}
	mes "[Lark]";
	mes "你喜欢待在人群聚集的地方吗？";
	next;
	switch(select("是:否")) {
	case 1:
		set .@acolyte_p, .@acolyte_p+1;
		set .@swordman_p, .@swordman_p+1;
		break;
	case 2:
		set .@archer_p, .@archer_p+1;
		set .@ninja_p, .@ninja_p+1;
		break;
	}
	mes "[Lark]";
	mes "你喜欢独自生活吗？";
	next;
	switch(select("是:否")) {
	case 1:
		set .@thief_p, .@thief_p+1;
		set .@ninja_p, .@ninja_p+1;
		break;
	case 2:
		set .@acolyte_p, .@acolyte_p+1;
		break;
	}
	mes "[Lark]";
	mes "你喜欢和他人保持距离吗？";
	next;
	switch(select("是:否")) {
	case 1:
		set .@gunslinger_p, .@gunslinger_p+1;
		set .@archer_p, .@archer_p+1;
		break;
	case 2:
		set .@taekwon_p, .@taekwon_p+1;
		break;
	}
	mes "[Lark]";
	mes "你认为战斗中拥有好的藏身处很重要吗？";
	next;
	switch(select("是:否")) {
	case 1:
		set .@magician_p, .@magician_p+1;
		set .@gunslinger_p, .@gunslinger_p+1;
		set .@archer_p, .@archer_p+1;
		break;
	case 2:
		set .@taekwon_p, .@taekwon_p+1;
		set .@magician_p, .@magician_p+1;
		break;
	}
	mes "[Lark]";
	mes "即使知道朋友错了，你也会保护他们吗？";
	next;
	switch(select("是:否")) {
	case 1:
		set .@swordman_p, .@swordman_p+1;
		break;
	case 2:
		set .@thief_p, .@thief_p+1;
		set .@ninja_p, .@ninja_p+1;
		break;
	}
	mes "[Lark]";
	mes "你会试图用道理说服敌人不要和你战斗吗？";
	next;
	switch(select("是:否")) {
	case 1:
		set .@archer_p, .@archer_p+1;
		set .@merchant_p, .@merchant_p+1;
		break;
	case 2:
		set .@acolyte_p, .@acolyte_p+1;
		set .@archer_p, .@archer_p+1;
		break;
	}
	mes "[Lark]";
	mes "你能长时间坐在同一个地方不动吗？";
	next;
	switch(select("是:否")) {
	case 1:
		set .@taekwon_p, .@taekwon_p+1;
		set .@thief_p, .@thief_p+1;
		break;
	case 2:
		set .@archer_p, .@archer_p+1;
		set .@gunslinger_p, .@gunslinger_p+1;
		break;
	}
	mes "[Lark]";
	mes "你觉得自己能承受兽人正中腹部的一拳吗？";
	next;
	switch(select("是:否")) {
	case 1:
		set .@swordman_p, .@swordman_p+1;
		set .@merchant_p, .@merchant_p+1;
		break;
	case 2:
		set .@magician_p, .@magician_p+1;
		set .@thief_p, .@thief_p+1;
		break;
	}
	mes "[Lark]";
	mes "你会给朋友起昵称吗？";
	next;
	switch(select("是:否")) {
	case 1:
		set .@gunslinger_p, .@gunslinger_p+1;
		set .@archer_p, .@archer_p+1;
		break;
	case 2:
		set .@acolyte_p, .@acolyte_p+1;
		set .@gunslinger_p, .@gunslinger_p+1;
		break;
	}
	mes "[Lark]";
	mes "面对各种情况，你总有B计划吗？";
	next;
	switch(select("是:否")) {
	case 1:
		set .@thief_p, .@thief_p+1;
		set .@gunslinger_p, .@gunslinger_p+1;
		break;
	case 2:
		set .@gunslinger_p, .@gunslinger_p+1;
		set .@merchant_p, .@merchant_p+1;
		break;
	}
	mes "[Lark]";
	mes "和别人交谈时，你会留时间让对方思考吗？";
	next;
	switch(select("是:否")) {
	case 1:
		set .@magician_p, .@magician_p+1;
		break;
	case 2:
		set .@ninja_p, .@ninja_p+1;
		set .@archer_p, .@archer_p+1;
		break;
	}

	// Calculate player's job.
	// In the official script, higher .@who_job value always wins in a tie.
	setarray .@points[0],
		.@swordman_p, .@magician_p, .@archer_p, .@merchant_p, .@thief_p, .@acolyte_p, .@taekwon_p, .@gunslinger_p, .@ninja_p;
	set .@max, .@points[0];
	for(set .@i,1; .@i<9; set .@i,.@i+1) {
		if (.@points[.@i] >= .@max) {
			set .@max, .@points[.@i];
			set .@ele, .@i;
		}
	}
	set .@who_job, .@ele+1; // To match the official script's numbering.

	mes "[Lark]";
	mes "谢谢你，愿你长寿。";
	mes "职业适性评估完成。";
	next;
	mes "[Lark]";
	mes "……结果正在汇总……";
	next;
	mes "[Lark]";
	mes "统计完成。";
	mes "^0000FF那么^000000，按下这个按钮";
	mes "按下按钮就能查看结果。";
	next;
	switch(.@who_job) {
	case 1:
		set .@job$, "Swordman";
		mes "[Lark]";
		mes "……简单直接……";
		mes "……坚定信念能影响世界……";
		mes "……代表人们的希望……";
		mes "……守护忠诚。";
		mes "……向前冲刺……";
		next;
		break;
	case 2:
		set .@job$, "Wizard";
		mes "[Lark]";
		mes "……独自理解一切……";
		mes "……努力与独立思考……";
		mes "……优秀判断力，内向……";
		mes "……善于分析，富有洞察力……";
		mes "……这种人会观察一切……";
		next;
		break;
	case 3:
		set .@job$, "Archer";
		mes "[Lark]";
		mes "……无法衡量，情感丰富……";
		mes "……对试图理解他人的人……";
		mes "……努力理解并接受。还有……";
		mes "……拒绝平庸，真正的……";
		mes "……生活方式。容易受影响……";
		mes "……丰富而浪漫……";
		next;
		break;
	case 4:
		set .@job$, "Merchant";
		mes "[Lark]";
		mes "……辨别人的听觉……";
		mes "……杰出的决心与目标……";
		mes "……目标明确，责任感强……";
		mes "……成就欲强……";
		next;
		break;
	case 5:
		set .@job$, "Thief";
		mes "[Lark]";
		mes "……总让生活有趣，想要……";
		mes "……总在寻找新工作……";
		mes "……为世界作贡献……";
		mes "……这种人。冒险者……";
		mes "……乐观。";
		next;
		break;
	case 6:
		set .@job$, "Acolyte";
		mes "[Lark]";
		mes "……心态让他温暖体贴……";
		mes "我知道自己爱着所有人……";
		mes "……帮助他人，为了他人……";
		mes "……善于照顾他人。";
		mes "……总想帮助别人。";
		next;
		break;
	case 7:
		set .@job$, "Taekwon Boy/Girl";
		mes "[Lark]";
		mes "……以顽强信念相信……";
		mes "……草原之心与精神始终如一……";
		mes "……一步步向前。";
		mes "……想理解信念的类型……";
		mes "……通过训练不断修正……";
		mes "……拥有健全心灵……";
		next;
		break;
	case 8:
		set .@job$, "Gunslinger";
		mes "[Lark]";
		mes "人们常常赞美正义。";
		mes "有时会出现恐惧与混乱……";
		mes "……那时，混乱的定义……";
		mes "……为了维持平衡，你背负着重担……";
		mes "……为了你……";
		next;
		break;
	case 9:
		set .@job$, "Ninja";
		mes "[Lark]";
		mes "……避免自我追求的类型……";
		mes "……与显著目标结合，默默避开……";
		mes "……脚步与目标……";
		mes "……直到目标完成的类型……";
		mes "……我不后悔……";
		next;
		break;
	default:
		mes "[Lark]";
		mes "发生错误。";
		close;
	}
	mes "[Lark]";
	mes "^8014EB适合你的职业是"+.@job$+"。^000000";
	next;
	mes "[Lark]";
	mes "那么，"+.@job$+"，你可以选择不同的职业道路。";
	mes "想确定适合你的职业吗？";
	mes "要选择职业吗？";
	next;
	switch(select(.@job$+"。:其他职业。")) {
	case 1:
		mes "[Lark]";
		mes "新手训练中心课程结束了，"+.@job$+"。要选择这个职业吗？";
		next;
		if(select("我再考虑一下。:我选择前者。") == 1) {
			mes "[Lark]";
			mes "你会收到与各职业对应的书。";
			mes "请积累足够经验，谨慎决定适合你的职业。";
			close;
		}
		break;
	case 2:
		mes "[Lark]";
		mes "现在退出训练中心课程。要把某个职业作为你的选择吗？";
		next;
		if(select("我再考虑一下。:我仍想转职。") == 1) {
			mes "[Lark]";
			mes "你会收到各职业的入门书。";
			mes "请积累经验后再谨慎决定。";
			close;
		}
		mes "[Lark]";
		mes "好的。请选择想要的职业。";
		next;
		set .@who_job, select("剑士:巫师:弓箭手:商人:盗贼:服事:跆拳少年/少女:枪手:忍者:我再想想。");
		if (.@who_job == 10) {
			mes "[Lark]";
			mes "新手训练中心经验丰富，路上请多加注意。";
			close;
		}
		break;
	}
	callfunc "F_NvErase",1;
	set .@str$, "^A62A2A'"+strcharinfo(0)+"^000000'！保重，愿芙蕾雅在旅途中祝福你。";
	switch(.@who_job) {
	case 1:
		mes "[Lark]";
		mes "我们将把你送到";
		mes "卫星城依斯鲁得的剑士公会。";
		mes .@str$;
		mes "再见。";
		close2;
		savepoint "izlude",128,98,1,1; // Old coordinates: (95,104)
		warp "izlude_in",74,167;
		end;
	case 2:
		mes "[Lark]";
		mes "我们会把你送往";
		mes "魔法之都吉芬的魔法师公会。";
		mes .@str$;
		mes "再见。";
		close2;
		savepoint "geffen",119,37,1,1;
		warp "geffen_in",163,98;
		end;
	case 3:
		mes "[Lark]";
		mes "我们会把你送往";
		mes "山岳城市斐扬的弓箭手公会。";
		mes .@str$;
		mes "再见。";
		close2;
		savepoint "payon",256,242,1,1;
		warp "payon_in02",64,65;
		end;
	case 4:
		mes "[Lark]";
		mes "我们会把你送往";
		mes "港口城市艾尔贝塔的商人公会。";
		mes .@str$;
		mes "再见。";
		close2;
		savepoint "alberta",30,232,1,1;
		warp "alberta_in",62,44;
		end;
	case 5:
		mes "[Lark]";
		mes "我们会把你送往";
		mes "沙漠城市梦罗克的盗贼公会。";
		mes .@str$;
		mes "再见。";
		close2;
		savepoint "morocc",150,99,1,1;
		warp "moc_prydb1",99,185;
		end;
	case 6:
		mes "[Lark]";
		mes "我们会把你送往";
		mes "符文米德加尔特王国首都普隆德拉。";
		mes .@str$;
		mes "再见。";
		close2;
		savepoint "prontera",117,72,1,1;
		warp "prt_church",172,19;
		end;
	case 7:
		mes "[Lark]";
		mes "我们会把你送往";
		mes "山岳城市斐扬的凤凰。";
		mes .@str$;
		mes "再见。";
		close2;
		savepoint "payon",164,58,1,1;
		warp "payon",163,141;
		end;
	case 8:
		mes "[Lark]";
		mes "你将被送到";
		mes "卫星城依斯鲁得的飞艇。";
		mes "可以乘坐飞艇前往工业城市艾因布洛克。";
		mes .@str$;
		mes "再见。";
		close2;
		savepoint "izlude",128,98,1,1; // Old coordinates: (95,104)
		warp "izlude",128,67;
		end;
	case 9:
		mes "[Lark]";
		mes "我们会把你送往";
		mes "走私船船长处。";
		mes "在船长帮助下可以前往";
		mes "天津町。";
		mes .@str$;
		mes "再见。";
		close2;
		savepoint "alberta",117,56,1,1;
		warp "alberta",171,132;
		end;
	default:
		mes "[Lark]";
		mes "发生错误。如果问题持续，请联系本地GM团队。";
		close;
	}
}

			close;
		}
		mes "[Mage Guild Member]";
		mes "你想登记体验法师职业吗？";
		mes "你想测试法师技能吗？";
		next;
		switch(select("我想测试法师技能。:我不想测试。")) {
		case 1:
			mes "[Mage Guild Member]";
			mes "这是法师手册。";
			mes "我会收回其他职业的登记表和手册。";
			next;
			callfunc "F_NvErase";
			getitem 2824,1; //Mage_Manual
			next;
			mes "[Mage Guild Member]";
			mes "装备手册后，按 ALT+S 打开技能菜单。";
			mes "请点击技能树窗口右上角的“-”按钮，将技能树最小化。";
			close;
		case 2:
			mes "[Mage Guild Member]";
			mes "嗯。你这么认为吗？";
			mes "好，我同意你。选择职业是人生中非常重要的事。";
			mes "想体验法师技能时，随时来和我交谈。";
			close;
		}
	case 2:
		mes "[Mage Guild Member]";
		mes "你想成为法师？";
		mes "好，那么我马上把你送到吉芬的法师公会。";
		next;
		mes "[Mage Guild Member]";
		mes "等等，你查看过 Job 等级了吗？";
		mes "你想完成初心者训练，直接前往法师公会吗？";
		next;
		switch(select("我再考虑一下。:是的，完成我的训练。")) {
		case 1:
			mes "[Mage Guild Member]";
			mes "决定前请先体验法师技能。";
			mes "我们随时欢迎你！";
			close;
		case 2:
			mes "[Mage Guild Member]";
			mes "太好了。";
			mes "那么我会结束训练流程，马上把你送到吉芬的法师公会。";
			callfunc "F_NvErase",1;
			close2;
			savepoint "geffen",119,37,1,1;
			warp "geffen_in",163,98;
			end;
		}
	case 3:
		set .@quest, checkquest(7124);
		if (.@quest == -1) {
			mes "[Mage Guild Member]";
			mes "嗯？任务？";
			mes "嗯……什么任务适合你呢……？";
			mes "你想使用箭术技能猎杀疯兔吗？";
			next;
			mes "^4d4dff你从法师指南员那里接到了狩猎任务。";
			mes "你可以在任务窗口获得更多任务信息。^000000";
			setquest 7124;
			next;
			mes "[Mage Guild Member]";
			mes "你可以使用法师手册中展示的“火箭术”技能。";
			mes "我会在这里等你。";
			mes "祝你好运！";
			close;
		} else if (.@quest == 0 || .@quest == 1) {
			if (checkquest(7124,HUNTING) == 2) {
				mes "[Mage Guild Member]";
				mes "你做得非常好。";
				mes "那么，你对法师感兴趣了吗？";
				mes "好吧。我给你一些东西……";
				mes "这是初心者蝴蝶翅膀，请收下。";
				completequest 7124;
				getitem 12324,30; //N_Butterfly_Wing
				getexp 5000,100;
				close;
			} else {
				mes "[Mage Guild Member]";
				mes "任务要求是";
				mes "猎杀疯兔并带来 5 个四叶草。";
				close;
			}
		} else if (.@quest == 2) {
			mes "[Mage Guild Member]";
			mes "你已经完成任务了。";
			mes "进入主世界后，你可以在那里获得各种有趣的任务！";
			next;
			mes "[Mage Guild Member]";
			mes "这些应该足够你的训练了。";
			close;
		} else {
			mes "[Mage Guild Member]";
			mes "抱歉，我现在没有任务可以给你。";
			close;
		}
	case 4:
		mes "[Mage Guild Member]";
		mes "如果你对法师有任何疑问，尽管问我。";
		mes "我觉得你可以成为聪明的法师……";
		close;
	}
}

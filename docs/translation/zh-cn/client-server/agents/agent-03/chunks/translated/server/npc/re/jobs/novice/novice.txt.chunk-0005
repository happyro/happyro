-	script	Bruce#nv::NvBruce	-1,{
	mes "[Bruce]";
	mes "你好？";
	mes "我来为你介绍额外职业和特殊职业。";
	next;
	mes "[Bruce]";
	mes "特殊职业包括跆拳男、跆拳女、忍者、超级初心者和枪手。";
	mes "你想听哪种职业的介绍？";
	next;
	while(1) {
		switch(select("跆拳:忍者:超级初心者:枪手:结束对话。")) {
		case 1:
			mes "[Bruce]";
			mes "这是一个通常使用许多踢技的职业。";
			mes "它属于特殊职业，之后可以转职为拥有更强攻击技能的跆拳宗师。";
			next;
			mes "[Bruce]";
			mes "还可以选择一个叫灵魂链接者的进阶职业，同样拥有强大的攻击能力。";
			mes "变强后再决定也不迟。";
			next;
			break;
		case 2:
			mes "[Bruce]";
			mes "忍者的特长是快速移动。";
			mes "他们擅长使用投掷武器。";
			next;
			mes "[Bruce]";
			mes "忍者是混合型职业，可以根据偏好使用各种闪避技能，并兼具物理和魔法攻击能力。";
			next;
			break;
		case 3:
			mes "[Bruce]";
			mes "被称为超级初心者的强化初心者，最大的特点是样样都会但不专精。";
			mes "他们是众所周知的万事通，却没有一项真正精通。";
			next;
			mes "[Bruce]";
			mes "超级初心者可以学习大多数一转职业技能。";
			mes "成为超级初心者后无法转职，虽然有些遗憾，但你可以成长为非常独特的角色。";
			next;
			break;
		case 4:
			mes "[Bruce]";
			mes "你可以从初心者直接转职为擅长使用枪械远距离攻击的特殊职业。";
			next;
			mes "[Bruce]";
			mes "枪手使用钢铁之城“艾因布洛克”制造的各种枪械。";
			mes "我推荐给想成为强力神枪手的人。";
			next;
			break;
		case 5:
			mes "[Bruce]";
			mes "如果你需要更多信息，";
			mes "你可以随时访问 ^2F4F4F“www.ragnarok.co.kr”^000000";
			close;
		}
	}
}

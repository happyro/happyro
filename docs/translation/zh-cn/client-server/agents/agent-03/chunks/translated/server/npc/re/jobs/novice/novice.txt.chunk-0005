// Trainer
//============================================================
-	script	::NvBrutus	-1,{
	mes "[Trainer Brutus]";
	mes "这些怪物都很弱，很容易击杀。但要小心，其中许多具有攻击性并且嗜血！";
	next;
	mes "[Trainer Brutus]";
	mes "如果你觉得这里的怪物太弱，我可以把你送到另一个训练场，那里的怪物更强。";
	next;
	mes "[Trainer Brutus]";
	mes "那么你想试试吗？";
	next;
	switch(select("送我去其他等级:那里有什么怪物？:取消")) {
	case 1:
		mes "[Trainer Brutus]";
		mes "我明白了，那我带你去其他等级。你想去哪个等级？";
		next;
		for(set .@i,1; .@i<6; set .@i,.@i+1) {
			if (!compare(strnpcinfo(2),"nv"+.@i))
				set .@menu$, .@menu$+"Send me to Level "+.@i;
			set .@menu$, .@menu$+":";
		}
		set .@i, select(.@menu$+"取消");
		if (.@i < 7)
			warp "new_"+.@i+"-3",96,21;
		close;
	case 2:
		mes "[Trainer Brutus]";
		mes "你似乎很渴望战斗。";
		mes "训练场等级越高，怪物等级越高。";
		next;
		mes "[Trainer Brutus]";
		mes "1 级的怪物最弱。";
		mes "那里有波利、波利王和疯兔。";
		next;
		mes "[Trainer Brutus]";
		mes "2 级更具挑战性。";
		mes "那里有波利、疯兔、树精和苍蝇。";
		next;
		mes "[Trainer Brutus]";
		mes "3 级与 2 级相同。";
		mes "那里有波利、疯兔、树精和苍蝇。";
		next;
		mes "[Trainer Brutus]";
		mes "4 级的怪物更强。";
		mes "那里有树精、蜂兵、Picky 和苍蝇。";
		next;
		mes "[Trainer Brutus]";
		mes "5 级与 4 级相同。";
		mes "那里有树精、蜂兵、Picky 和苍蝇。";
		close;
	case 3:
		mes "[Trainer Brutus]";
		mes "嗯……？";
		mes "你担心去更有挑战性的地方吗？毕竟你还是新冒险者，这很正常。祝你好运～";
		close;
	}
}

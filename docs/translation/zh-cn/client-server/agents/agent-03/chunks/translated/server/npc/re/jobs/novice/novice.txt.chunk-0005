			mes "就在斐扬北边，你会找到弓箭手村。";
			mes "祝你的旅程顺利。";
			callsub S_Warp,"payon",167,68,172,111;
		case 4:
			mes "[Eden Group Officer]";
			mes "艾尔贝塔，港口城市。";
			mes "这里是所有贸易的主要枢纽。";
			mes "如果你想前往其他文明，艾尔贝塔是唯一的出发地。";
			callsub S_Warp,"alberta",115,57,116,58;
		case 5:
			mes "[Eden Group Officer]";
			mes "吉芬被称为卢恩·米德加尔特的魔法之城。";
			mes "我会把你送到喷泉附近。";
			mes "愿女神芙蕾雅祝福你。";
			callsub S_Warp,"geffen",118,36,128,66;
		case 6:
			mes "[Eden Group Officer]";
			mes "如果你还不确定想转职什么职业，就和职业指南员谈谈寻求帮助。";
			close;
		}
	case 2:
		mes "[Eden Group Officer]";
		mes "普隆德拉是卢恩·米德加尔特王国的首都。这里有出售物品的商人，也是冒险者最喜欢的聚集地。";
		next;
		mes "[Eden Group Officer]";
		mes "服事公会位于西北方的普隆德拉教堂。剑士公会在普隆德拉东南方的城镇伊兹鲁德。";
		next;
		mes "[Eden Group Officer]";
		mes "梦罗克是位于沙漠中的城市，最近被名为撒旦梦罗克的邪恶怪物摧毁。盗贼公会一直在努力让它恢复昔日的荣耀。";
		next;
		mes "[Eden Group Officer]";
		mes "斐扬是弓箭手公会的所在地。在城市中心附近还能找到出售商城物品的卡普拉商店职员。";
		next;
		mes "[Eden Group Officer]";
		mes "艾尔贝塔是卢恩·米德加尔特的贸易中心。商人公会位于此处，码头的船只会带你前往不同的岛屿城市。";
		next;
		mes "[Eden Group Officer]";

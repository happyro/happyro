//===== rAthena Script =======================================
//= iRO Valentine's Day Event (2009)
//===== By: ==================================================
//= Kisuka
//===== Current Version: =====================================
//= 1.3
//===== Compatible With: =====================================
//= rAthena Project
//===== Description: =========================================
//= iRO Valentine's Day Event. (2009)
//= Make Chocolate/Chocolate Boxes/Home-Made Chocolate.
//= Make Valentine's Rings/Boxes.
//= Trade rings to those of opposite gender.
//= Register rings you have gotten for votes.
//=
//= The male and female with the most votes at the end of
//= the event will receive item (14466) from GM team.
//=
//= Must enable the event items in item_db2 and item_trade!
//===== Additional Comments: =================================
//= 1.0 First version. [Kisuka]
//= 1.1-1.2 Fixed exploits with unlimited rings and non deleting choco [Lupus]
//= 1.3 Some Changes. [Kisuka]
//============================================================

// Marco Bassinio (Chocolate/Chocolate Box maker)
//============================================================
prontera,164,174,4	script	Trader#Val09	58,{
	mes "[马可·巴西尼奥]";
	mes "嘿，大家！这是平时看不到的东西！";
	mes "在卢恩·米德加尔兹绝对找不到！";
	mes "一口就能让你幸福！";
	next;
	mes "[马可·巴西尼奥]";
	mes "这是完美的甜点，也是送给爱人的完美礼物。";
	mes "高品质传统手工巧克力，每块只要 5000z！";
	next;
	switch(select("请给我:我要包装巧克力:结束交易")) {
		case 1:
			mes "[马可·巴西尼奥]";
			mes "哈哈，亲爱的。";
			mes "这种巧克力与众不同。";
			mes "每一块都承载着制作者的心意！";
			next;
			mes "[马可·巴西尼奥]";
			mes "所以我一次最多只能卖 5 块。";
			mes "如果真的想要更多，就再来找我。";
			mes "你到底想要几块？";
			next;
			while(.@input <= 0 || .@input > 5) {
				input .@input;
				if (.@input < 1) {
					mes "[马可·巴西尼奥]";
					mes "哦，真遗憾！";
					mes "你一定会错过机会，后悔没买。";
					next;
					mes "[马可·巴西尼奥]";
					mes "记住，其他地方绝对找不到！";
					mes "改变主意后随时回来。";
					close;
				}
				if (.@input > 5) {
					mes "[马可·巴西尼奥]";
					mes "呃……我不是告诉过你吗？";
					mes "最多 5 块！";
					mes "我不能卖给同一个人更多。";
					next;
					mes "[马可·巴西尼奥]";
					mes "这可不是每天都能吃的东西。";
					mes "吃太多对你不好。";
					next;
				}
			}
			if (!checkweight(558, .@input)) {
				mes "[马可·巴西尼奥]";
				mes "你携带的物品太多。";
				mes "请使用卡普拉服务。";
				close;
			}
			set .@price, .@input * 5000;
			if (Zeny < .@price) {
				mes "[马可·巴西尼奥]";
				mes "看来你的 Zeny 不够。";
				mes "也许该向朋友借一些。";
				mes "因为我不会每天都在这里。";
				close;
			} else {
				mes "[马可·巴西尼奥]";
				mes "太好了！";
				mes "它也是完美的礼物！";
				mes "这种巧克力平时可买不到。";
				next;
				mes "[马可·巴西尼奥]";
				mes "想要更多就再来。";
				mes "有机会时多买一些是个好主意……！";
				set Zeny,Zeny - .@price;
				getitem 558,.@input;
				close;
			}
		case 2:
			mes "[马可·巴西尼奥]";
			mes "想包装巧克力，当然需要巧克力、包装纸、包装带和盒子。";
			next;
			mes "[马可·巴西尼奥]";
			mes "还要支付 500 Zeny 在盒子上刻名字。";
			mes "都准备好了吗……？";
			next;
			if (countitem(7175) < 1 || countitem(7174) < 1 || countitem(7948) < 1 || Zeny < 500) {
				mes "[马可·巴西尼奥]";
				mes "嗯……看来你没有足够材料装饰礼盒。";
				mes "不能把礼物放进普通盒子……";
				mes "你不觉得吗？";
				next;
				mes "[马可·巴西尼奥]";
				mes "你需要带包装纸、包装带和盒子。";
				mes "哦，还要带 500 Zeny，别忘了带上真诚的爱心！！";
				close;
			}
			if (countitem(558) < 1) {
				mes "[Marco Bassinio]";
				mes "嘿，冒险者！";
				mes "我不能马上制作！";
				mes "你知道我不是炼金术士之类的。";
				next;
				mes "[Marco Bassinio]";
				mes "你不会是想要没有巧克力的空盒子吧？";
				close;
			}
			if (!checkweight(12744,1)) {
				mes "[Marco Bassinio]";
				mes "你携带的物品太多。";
				mes "请使用卡普拉服务。";
				close;
			}
			mes "[Marco Bassinio]";
			mes "来，看看！";
			mes "这是刻有你名字的巧克力盒。";
			mes "是不是很棒？";
			mes "看，你的名字在盒子上真好看！";
			next;
			delitem 558,1;
			delitem 7175,1;
			delitem 7174,1;
			delitem 7948,1;
			set Zeny,Zeny-500;
			getnameditem 12744,strcharinfo(0);
			mes "[Marco Bassinio]";
			mes "情人节快乐！";
			mes "情人节就是我回来的原因。";
			close;
		case 3:
			mes "[Marco Bassinio]";
			mes "哦，真遗憾！";
			mes "你一定会错过机会，后悔没买。";
			next;
			mes "[Marco Bassinio]";
			mes "记住，其他地方绝对找不到！";
			mes "改变主意后随时回来。";
			close;
	}
}

// Packs Trader (Sells Wrapping Paper, Lace, and Box)
//============================================================
prontera,147,171,5	script	Packs Trader#Val09	58,{
	mes "[Packs Trader]";
	mes "你好。";
	mes "我是包装用品商人，出售纸盒和礼物包装用品。";
	next;
	while(1) {
		mes "[Packs Trader]";
		mes "你想买些什么？";
		next;
		switch(select("包装纸:包装带:盒子:取消")) {
			case 1:
				mes "[Packs Trader]";
				mes "一张包装纸 200 Zeny。";
				mes "你要多少？";
				mes "一次最多购买 10 件。";
				next;
				input .@input;
				if (.@input <= 0) {
					mes "[Packs Trader]";
					mes "没有要购买的东西。";
					mes "需要时再回来。";
					close;
				}
				if (.@input > 10) {
					mes "[Packs Trader]";
					mes "我说过不能买超过 10 件……";
					next;
					break;
				}
				if (!checkweight(7175,.@input)) {
					mes "[Packs Trader]";
					mes "你携带的物品太多。";
					mes "请使用卡普拉服务。";
					close;
				}
				set .@price, .@input * 200;
				if (Zeny < .@price) {
					mes "[Packs Trader]";
					mes "你的钱不够。";
					mes "请检查钱包。";
					next;
					break;
				} else {
					mes "[Packs Trader]";
					mes "给你。";
					mes "希望它让你的情人节更加愉快！";
					set Zeny,Zeny-.@price;
					getitem 7175,.@input;
					next;
					break;
				}
			case 2:
				mes "[Packs Trader]";
				mes "一条包装带 200 Zeny。";
				mes "你要多少？";
				mes "一次最多购买 10 件。";
				next;
				input .@input;
				if (.@input <= 0) {
					mes "[Packs Trader]";
					mes "没有要购买的东西。";
					mes "需要时再回来。";
					close;
				}
				if (.@input > 10) {
					mes "[Packs Trader]";
					mes "我说过不能买超过 10 件……";
					next;
					break;
				}
				if (!checkweight(7174,.@input)) {
					mes "[Packs Trader]";
					mes "你携带的物品太多。";
					mes "请使用卡普拉服务。";
					close;
				}
				set .@price, .@input * 200;
				if (Zeny < .@price) {
					mes "[包装用品商人]";
					mes "你的钱不够。";
					mes "请检查钱包。";
					next;
					break;
				} else {
					mes "[包装用品商人]";
					mes "给你。";
					mes "希望它让你的情人节更加愉快！";
					set Zeny,Zeny-.@price;
					getitem 7174,.@input;
					next;
					break;
				}
			case 3:
				mes "[Packs Trader]";
				mes "一盒 600 Zeny。";
				mes "你要几盒？";
				mes "一次最多购买 10 件。";
				next;
				input .@input;
				if (.@input <= 0) {
					mes "[Packs Trader]";
					mes "没有要购买的东西。";
					mes "需要时再回来。";
					close;
				}
				if (.@input > 10) {
					mes "[Packs Trader]";
					mes "我说过不能买超过 10 件……";
					next;
					break;
				}
				if (!checkweight(7948,.@input)) {
					mes "[Packs Trader]";
					mes "你携带的物品太多。";
					mes "请使用卡普拉服务。";
					close;
				}
				set .@price, .@input * 600;
				if (Zeny < .@price) {
					mes "[Packs Trader]";
					mes "你的钱不够。";
					mes "请检查钱包。";
					next;
					break;
				} else {
					mes "[Packs Trader]";
					mes "给你。";
					mes "希望它让你的情人节更加愉快！";
					set Zeny,Zeny-.@price;
					getitem 7948,.@input;
					next;
					break;
				}
			case 4:
				mes "[Packs Trader]";
				mes "再见！";
				mes "祝你情人节愉快。";
				close;
		}
	}
}

// Event Ring Maker (Makes ring for players)
//============================================================
prontera,154,185,5	script	Event Ring Maker#Val09	721,{
	if (BaseLevel < 75) {
		mes "[Event Ring Maker]";
		mes "你好，我只为 75 级以上的资深冒险者制作情人节戒指。";
		next;
		mes "[Event Ring Maker]";
		mes "你还不够有经验。";
		mes "有足够经验处理任务后再来。";
		close;
	}
	
	if (iROval09ring >= 1) {
		mes "[Event Ring Maker]";
		mes "刻有你名字的戒指盒，要送给你所爱的人。";
		next;
		mes "[Event Ring Maker]";
		mes "至于你从别人那里收到的戒指，都应在投票管理者处登记。";
		mes "她就在普隆德拉喷泉附近。";
		next;
		mes "[Event Ring Maker]";
		mes "只有最受欢迎的男性和女性能获得奖励。";
		mes "注意这一点，努力保持人气！";
		close;
	}
	
	mes "[Event Ring Maker]";
	mes "你好，最近怎么样？";
	mes "对‘谁是情人节最受欢迎的人？’活动感兴趣就来找我。";
	next;
	mes "[Event Ring Maker]";
	mes "我制作最珍贵的戒指，你可以送给心爱的人。";
	mes "这些戒指很特别，因为我会在上面刻下你的名字！";
	next;
	mes "[Event Ring Maker]";
	mes "是不是很令人兴奋？";
	mes "这主意是不是很棒？";
	mes "把这些特别戒指送给心爱的人吧！";
	next;
	mes "[Event Ring Maker]";
	mes "你要抓紧，因为活动只持续两周。";
	mes "把情人节戒指送给那个特别的人。";
	next;
	mes "[Event Ring Maker]";
	mes "记住，戒指只能制作一次。";
	mes "制作戒指还需要包装纸、包装带和盒子。";
	next;
	mes "[Event Ring Maker]";
	mes "所以一定要想好送给谁。";
	mes "顺便说，费用是 1,000 Zeny。";
	mes "要制作一枚吗？";
	next;
	if(select("嗯……我得再考虑一下……:好的。") == 1) {
		mes "[Event Ring Maker]";
		mes "好吧！";
		mes "这种事情不能着急。";
		mes "想清楚你真正想要什么。";
		mes "跟随你的心！";
		close;
	}
	if (countitem(7175) < 1 || countitem(7174) < 1 || countitem(7948) < 1 || Zeny < 1000) {
		mes "[Event Ring Maker]";
		mes "嗯，你没有足够材料制作礼盒。";
		mes "检查一下物品，准备齐全后再来。";
		close;
	}
	mes "[Event Ring Maker]";
	mes "好嘞！";
	mes "我马上制作。";
	next;
	delitem 7175,1;
	delitem 7174,1;
	delitem 7948,1;
	set Zeny,Zeny-1000;
	set iROval09ring,1;
	if (Sex == SEX_MALE) {
		getnameditem 12742,strcharinfo(0);
	} else {
		getnameditem 12743,strcharinfo(0);
	}
	mes "[Event Ring Maker]";
	mes "给你，世界上最珍贵的戒指！";
	mes "别忘了，你再也不能制作这枚戒指了。";
	next;
	mes "[Event Ring Maker]";
	mes "你必须选择真正深爱的人，把戒指送给他/她。";
	next;
	mes "[Event Ring Maker]";
	mes "当然，你也要从别人那里获得戒指，这样才能参加投票，对吧？";
	mes "挑战自己，成为情人节最受欢迎的人！";
	close;
}

// Valentine Vote Manager (Registers votes)
//============================================================
prontera,157,185,4	script	Valentine Vote Manager#v	113,{
	mes "[Valentine Vote Manager]";
	mes "你好，我是情人节投票管理者。";
	mes "我负责收集本活动的戒指！";
	next;
	mes "[Valentine Vote Manager]";
	mes "我会登记你从别人那里得到的戒指，并计算总数。";
	next;
	mes "[Valentine Vote Manager]";
	mes "你知道我除了数戒指还做什么吗？";
	mes "我可以告诉你票数最多的冒险者名字。";
	next;
	mes "[Valentine Vote Manager]";
	mes "你还可以知道他/她获得了多少票。";
	next;
	while (1) {
		mes "[Valentine Vote Manager]";
		mes "那么，你想做什么？";
		next;
		switch(select("请登记我的戒指。:请统计我的票数。:暂时没什么事。")) {
			case 1:
				mes "[Valentine Vote Manager]";
				mes "请告诉我要登记多少枚戒指。";
				next;
				mes "[Valentine Vote Manager]";
				mes "输入戒指数量时，不能超过你实际拥有的数量。";
				mes "输入‘0’取消全部操作。";
				next;
				input .@input;

				if (.@input <= 0) {
					mes "[Valentine Vote Manager]";
					mes "你输入了 0。";
					mes "登记已取消。";
					next;
					break;
				}
				
				if (Sex == SEX_MALE) {
					if (countitem(7947) > .@input) {
						mes "[Valentine Vote Manager]";
						mes "你输入的数量似乎太少。";
						mes "我知道你有更多。诚实一点，亲爱的。";
						next;
						break;
					}
					
					if (countitem(7947) < .@input) {
						mes "[Valentine Vote Manager]";
						mes "你输入的数量似乎太多。";
						mes "我知道你没那么多。诚实一点，亲爱的。";
						next;
						break;
					}
					
					mes "[Valentine Vote Manager]";
					mes "我会收下那些银戒指，帮你计算票数。";
					mes "感谢参与。";
					delitem 7947,.@input;
					set Val09Rings,Val09Rings+.@input;
					if (Val09Rings > $Val09votes_M) {
						set $Val09votes_M,Val09Rings;
						set $Val09name_M$,strcharinfo(0);
					}
					next;
					break;
				} else {
					if (countitem(7946) > .@input) {
						mes "[Valentine Vote Manager]";
						mes "你输入的数量似乎太少。";
						mes "我知道你有更多。诚实一点，亲爱的。";
						next;
						break;
					}
					
					if (countitem(7946) < .@input) {
						mes "[Valentine Vote Manager]";
						mes "你输入的数量似乎太多。";
						mes "我知道你没那么多。诚实一点，亲爱的。";
						next;
						break;
					}
					
					mes "[Valentine Vote Manager]";
					mes "我会收下那些金戒指，帮你计算票数。";
					mes "感谢参与。";
					delitem 7946,.@input;
					set Val09Rings,Val09Rings+.@input;
					if (Val09Rings > $Val09votes_F) {
						set $Val09votes_F,Val09Rings;
						set $Val09name_F$,strcharinfo(0);
					}
					next;
					break;
				}
			case 2:
				mes "[Valentine Vote Manager]";
				mes "让我看看……";

				mes "[辽森]";
				mes "如果你找到神秘之角，请回来找我！";
				close;
			}
		}
		else {
			mes "[辽森]";
			mes "请不要碰任何东西！";
			close;
		}
	}
	else {
		mes "[辽森]";

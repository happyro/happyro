-	script	bing_1#tt_main	-1,{
	end;
OnTouch_:
	set .@w$,callfunc("F_tt");
	set .@bing1,rand(1,10);
	if (.@bing1 > 0 && .@bing1 < 4)
		warp strnpcinfo(4),217,232;
	else if (.@bing1 == 6)
		warp strnpcinfo(4),233,207;
	else if (.@bing1 == 7)
		warp strnpcinfo(4),208,219;
	else if (.@bing1 == 8)
		warp strnpcinfo(4),219,202;
	else if (.@bing1 == 9)
		warp strnpcinfo(4),218,228;
	disablenpc "bing#"+.@w$;
	enablenpc "bing2#"+.@w$;
	end;
}

turbo_room,130,92,3	script	Kafra Staff#tt	115,{
	cutin "kafra_03",2;
	mes "[Kafra Staff]";
	mes "欢迎～卡普拉服务";
	mes "永远站在你这边。提醒你，";
	mes "在这里使用保存服务会将";
	mes "你的复活点改为艾尔帕兰。";
	mes "现在需要什么帮助？";
	callfunc "F_Kafra",5,8,1,40,0;

	M_Save:
		savepoint "aldebaran",168,112,1,1;
		callfunc "F_KafEnd",0,1,"in Al De Baran";

}

turbo_room,124,86,0	shop	Turbo Track Merchant	90,501:-1,502:-1,503:-1,504:-1,645:-1,656:-1,1065:-1,1750:-1

// Official name: "TBT_Guide#Broadcast"
turbo_room,99,120,4	script	Turbo Track Guide	124,{
	mes "[Turbo Track Guide]";
	mes "你好～";
	mes "有什么想了解";
	mes "Turbo Track";
	mes "的事情吗？";
	mes "有问题尽管问我。";
	mes "";
	next;
	while(1) {
		switch(select("比赛规则:赛道:游戏模式:禁止物品与技能:取消")) {
		case 1:
			mes "[Turbo Track Guide]";
			mes "所有比赛规则都很简单。";
			mes "通过所有障碍，";
			mes "努力抵达终点线";
			mes "即可。";
			mes "";
			mes "";
			next;
			mes "[Turbo Track Guide]";
			mes "当然，某些赛道可能出现意外情况，我无法举例说明……";
			mes "只要知道赛道上会有陷阱即可。";
			mes "";
			mes "";
			mes "";
			next;
			mes "[Turbo Track Guide]";
			mes "能骑大嘴鸟的职业，如骑士、骑士领主、十字军和圣殿十字军，";
			mes "进入 Turbo Track 竞技场前必须下鸟。";
			mes "";
			mes "";
			mes "";
			mes "";
			next;
			mes "[Turbo Track Guide]";
			mes "更准确地说，Turbo Track 入口工作人员会要求你下鸟，";
			mes "并给你一张票，让你免费重新租用大嘴鸟。";
			mes "";
			mes "";
			mes "";
			mes "";
			next;
			mes "[Turbo Track Guide]";
			mes "比赛的获胜者是第一个到达终点线的人。";
			mes "一旦有人越过终点线，比赛就会结束，所有人会自动被传送到等候室。";
			mes "";
			mes "";
			next;
			mes "[Turbo Track Guide]";
			mes "请记住，每场比赛只有 15 分钟。";
			mes "如果没有人在时限内到达终点线，比赛将无胜者结束。";
			mes "";
			mes "";
			mes "";
			next;
			mes "[Turbo Track Guide]";
			mes "参加 Turbo Track 没有职业或等级要求。";
			mes "不过需要支付 1,000 Zeny 的参加费。";
			mes "";
			mes "";
			mes "";
			next;
			break;
		case 2:
			mes "[Turbo Track Guide]";
			mes "Turbo Track 比赛包含各种赛道：";
			mes "^4d4dff木桥、方块山、";
			mes "单蜗牛、蛇形骰子、小洞穴";
			mes "和隐形迷宫。";
			mes "";
			next;
			mes "[Turbo Track Guide]";
			mes "具体赛道取决于游戏模式。";
			mes "想了解某条赛道的更多信息吗？";
			mes "";
			mes "";
			next;
			set .@exitloop,1;
			while (.@exitloop) {
				switch(select("木桥与方块山:诅咒沙漠与闪光迷宫:单蜗牛与隐形迷宫:蛇形骰子与小洞穴:不了，谢谢。")) {
				case 1:
					mes "[Turbo Track Guide]";
					mes "在木桥赛道中，";
					mes "你必须越过一根木头。";
					mes "如果掉下去，就会被带回木桥起点。";
					mes "";
					mes "";
					mes "";
					next;
					mes "[Turbo Track Guide]";
					mes "方块山是由堆积箱子组成的迷宫。";
					mes "有些箱子可以翻越，有些无法通过。";
					mes "你必须探索并找到最佳路线。";
					mes "";
					mes "";
					next;
					break;
				case 2:
					mes "[Turbo Track Guide]";
					mes "诅咒沙漠是一条充满惊喜的短赛道。";
					mes "如果运气很差，你可能会迷路甚至被诅咒！";
					mes "";
					mes "";
					mes "";
					next;
					mes "[Turbo Track Guide]";
					mes "闪光迷宫充满会致盲的陷阱，";
					mes "探索时要格外小心。最好放慢速度避开陷阱……";
					mes "";
					mes "";
					next;
					break;
				case 3:
					mes "[Turbo Track Guide]";
					mes "单蜗牛是一条狭窄的螺旋道路，";
					mes "形状像蜗牛壳。";
					mes "障碍不多，但很难在这条赛道上全速前进。";
					mes "";
					mes "";
					next;
					mes "[Turbo Track Guide]";
					mes "隐形迷宫看起来像巨大的空房间，";
					mes "实际上充满隐形墙。";
					mes "你会得到一些提示，所以并非无法通过。";
					mes "";
					mes "";
					mes "";
					next;
					break;
				case 4:
					mes "[Turbo Track Guide]";
					mes "蛇形骰子赛道提供蜿蜒道路，";
					mes "像蛇的身体一样。";
					mes "运气也会影响这条赛道，";
					mes "你可以亲自体验。";
					mes "";
					next;
					mes "[Turbo Track Guide]";
					mes "小洞穴只是斐扬洞穴的复制品。";
					mes "如果你熟悉在斐扬洞穴狩猎，这部分应该很简单。";
					mes "";
					mes "";
					next;
					break;
				case 5:
					mes "[Turbo Track Guide]";
					mes "我明白了。";
					mes "好吧，";
					mes "祝你比赛好运！";
					mes "";
					next;
					set .@exitloop,0;
				}
			}
			mes "[Turbo Track Guide]";
			mes "还想了解 Turbo Track 的其他信息吗？";
			mes "";
			mes "";
			next;
			break;
		case 3:
			mes "[Turbo Track Guide]";
			mes "Turbo Track 比赛有三种游戏模式：";
			mes "普通、专家和单人。";
			mes "";
			mes "";
			mes "";
			next;
			mes "[Turbo Track Guide]";
			mes "与其他模式不同，^4d4dff专家模式允许玩家进行 PvP^000000。";
			mes "适合队伍或公会之间比赛。";
			mes "";
			mes "";
			mes "";
			next;
			mes "[Turbo Track Guide]";
			mes "隐形迷宫是特殊赛道，";
			mes "仅在^4d4dff普通^000000和^4D4DFF专家^000000模式的16人比赛中开放。";
			mes "";
			mes "";
			next;
			mes "[Turbo Track Guide]";
			mes "在单人模式中，你可以体验所有赛道，";
			mes "最快玩家的姓名和时间会记录在荣誉殿堂。";
			mes "";
			mes "";
			mes "";
			next;
			break;
		case 4:
			mes "[Turbo Track Guide]";
			mes "Turbo Track 中禁止使用以下物品：";
			mes "绿色药水、万能药和苍蝇翅膀。";
			mes "即使尝试使用，也要离开赛道后才会生效。";
			mes "";
			next;
			mes "[Turbo Track Guide]";
			mes "Turbo Track 比赛中无法使用以下技能：";
			mes "强夺、瞬间移动、传送之阵、隐匿、伪装、潜行、治愈、冰墙、狂暴、圣母之颂歌、庇护祝福和长矛冲锋。";
			mes "";
			next;
			//this appears supposed to fall through.
		case 5:
			mes "[Turbo Track Guide]";
		mes "请享受你在艾尔迪巴兰 Turbo Track 的时光。谢谢～";
		mes "";
		mes "";
			close;
		}
	}

OnInit:
	// This will only ever be run ONCE!
	// Unless you eradicate the variable.
	//
	// This OnInit initiallizes and sets the starting
	// data for the Turbo Track's "Record" Logs.
	// WARNING/ATTENTION: DO NOT MODIFY ANY OF THE DATA.
	// DOING SO WILL CAUSE INTERNAL PROBLEMS IN THE SCRIPT.
	if ($ttnames$[0] == "") {
		setarray $ttnames$[0],"Breezy Havana";	// Solo Mode/Time Attack
		setarray $ttnames$[1],"RS125";	// Normal 4 Player
		setarray $ttnames$[2],"Hollgrehenn";	// Normal 8 Players
		setarray $ttnames$[3],"Antonio";	// Noomal 16 Players

		setarray $ttnames$[4],"Aragham";	// Expert 4 Players
		setarray $ttnames$[5],"Kafra Jasmine";	// Expert 8 Players
		setarray $ttnames$[6],"Chris";	// Expert 16 Players

		setarray $ttnames$[7],"Breezy Havana";	// Honor Place 1
		setarray $ttnames$[8],"RS125";	// Honor Place 2

		setarray $ttnames$[9],"Breezy Havana";	// Top 1
		setarray $ttnames$[10],"Nari";	// Top 2
		setarray $ttnames$[11],"Senorita Sylvia";	// Top 3
		setarray $ttnames$[12],"Joo Jahk";	// Top 4
		setarray $ttnames$[13],"RS125";	// Top 5

		setarray $ttranks[0],999999,0,0,0,0,0;
	}
	end;

OnEnd_n1:
	mapannounce "turbo_room","[普通模式-单人]比赛即将结束。",bc_map,"0xadff2f";
	end;

OnEnd_n4:
	mapannounce "turbo_room","[普通模式-4人]比赛即将结束。",bc_map,"0xadff2f";
	end;

OnEnd_n8:

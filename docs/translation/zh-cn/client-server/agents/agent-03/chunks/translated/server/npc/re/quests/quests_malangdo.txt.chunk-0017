			mes "你没把这笔交易告诉任何人，对吧？";
			next;
			mes "[Eff]";
			mes "没有。喵~";
			next;
			mes "["+strcharinfo(0)+"]";
			mes "好猫！绝对不行！！";
			mes "把这件事告诉其他猫！~";
			mes "再见~";
			close2;
		} else {

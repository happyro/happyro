				mes "我离开猫族玩家时说了很多坏话。..";
				mes "请原谅我。";
				emotion ET_CRY;
				next;
				emotion ET_THINK;
				emotion ET_THINK, playerattached();
				next;
				mes "["+strcharinfo(0)+"]";
				mes "罐头之主宽恕Ketchup的罪过。";
				mes "我们的主也希望你别再说脏话，诚实生活！";
				next;

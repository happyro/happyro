				next;
				mes "["+strcharinfo(0)+"]";
				mes "有些地点，";
				mes "Prontera王国正在秘密出售……";
				next;
				mes "[Eff]";
				mes "还有……还有……？喵～";
				next;
				mes "["+strcharinfo(0)+"]";
				mes "嗯，这是最高机密。";
				mes "绝对不能泄露的事情……";
				mes "你真的能保守秘密吗……？";
				emotion ET_QUESTION, playerattached();
				next;
				mes "[Eff]";
				mes "嗯……大家都知道我很会保守秘密喵。";
				mes "喵~完全不用担心。喵~";
				next;
				mes "["+strcharinfo(0)+"]";
				mes "好，我相信你，Eff……";
				mes "请保守秘密。";
				next;
				mes "[Eff]";
				mes "明白了。喵~";
				emotion ET_OK;
				next;
				mes "["+strcharinfo(0)+"]";
				mes "嗯，我听说Juno有个地方，地下大人物会在那里投资约100亿Zeny。";
				mes "现在已经可以提前投资。";
				next;
				mes "["+strcharinfo(0)+"]";
				mes "在这里投资1个罐头，回报会非常巨大。";
				next;

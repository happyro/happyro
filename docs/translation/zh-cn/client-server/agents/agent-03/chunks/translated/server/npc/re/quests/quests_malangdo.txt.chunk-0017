			mes "喵喵~‘猫族玩家’终于可以和我说再见了，喵。";
			mes "Meow... 你是谁喵？";
			next;
			mes "这只猫可能会打你。我们走吧。";
			close2;
		} else {
			mes "[Eff]";
			mes "Meow~ 我想投资。 Meow~";
			next;
			mes "["+strcharinfo(0)+"]";
			mes "咦？谁……？";
			next;
			mes "Eff似乎认出了你，我们走吧。";
			close2;
		}
	}

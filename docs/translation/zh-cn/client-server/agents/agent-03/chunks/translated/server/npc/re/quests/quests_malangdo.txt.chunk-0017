				mes "真不敢相信。";
				mes "结果会是100000个罐头，100000个！！";
				next;
				mes "[Eff]";
				mes "1... 100,000 cans... Meow~";
				next;
				mes "["+strcharinfo(0)+"]";
				mes "那么告诉我……你为什么辞掉这么好的工作？";
				mes "为什么？";
				next;
				mes "[Eff]";
				mes "我害怕那里的导演猫……";
				mes "喵~有一次我不得不请病假。";
				mes "喵~我这辈子都没见过那么可怕的猫……";
				next;
				mes "["+strcharinfo(0)+"]";
				mes "所以你是因为猫族玩家导演太可怕才辞职的。嗯，抱歉，我不能让你参与这项投资……";
				mes "我想也是……真浪费时间！";
				mes "再见！";
				next;
				mes "["+strcharinfo(0)+"]";
				mes "哦，别把我刚才说的告诉任何人！";
				mes "再见~";
				next;
				mes "你发现了Eff离开团队的原因。";
				mes "现在去找其他猫。";
				setquest 5065;
				completequest 5065;
				break;
			case 2:
				mes "[Eff]";
				mes "是的。我是一只猫。";
				mes "喵~你觉得我是狗吗？";
				mes "喵~你是个奇怪的人类。喵~";
				break;

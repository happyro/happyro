mora,43,127,3	script	Innkeeper#mora_inn	522,{
	mes "[Innkeeper]";
	mes "哦～看来又来了一位冒险者。";
	mes "你从哪里来？";
	next;
	switch(select("只保存游戏。:我想休息一下。:我以前住的地方叫……:仓库怎么用？")) {
	case 1:
		mes "[Innkeeper]";
		mes "哇，急什么？";
		mes "你才刚到这里，就要去别的地方了？";
		next;
		mes "[Innkeeper]";
		mes "俗话说欲速则不达。啧啧。";
		mes "好了，游戏已保存。";
		savepoint "mora",56,143,1,1;
		close;
	case 2:
		mes "[Innkeeper]";
		mes "哎呀，我也需要休息。";
		mes "费用是5000 Zeny。要住一间房吗？";
		next;
		switch(select("是:否")) {
		case 1:
			if (Zeny < 5000) {
				mes "[Innkeeper]";
				mes "费用是5000 Zeny。";
				close;
			}
			mes "[Innkeeper]";
			mes "请随意休息。";
			close2;
			set Zeny, Zeny-5000;
			percentheal 100,100;
			warp "mora",32,123;
			end;
		case 2:
			mes "[Innkeeper]";
			mes "没钱的话，就去村中央的水洼里泡一泡吧。";
			mes "那会让你暖和起来。";
			close;
		}
	case 3:
		input .@inputstr$;
		mes "["+strcharinfo(0)+"]";
		mes "我来自一个叫"+.@inputstr$+"的地方。";
		next;
		mes "[Innkeeper]";
		mes "哦，我好像以前听说过那里！";
		next;
		if (.@inputstr$ == "Shinlim") {
			mes "[Innkeeper]";
			mes "我听说那里有一座旧塔，可怕的女巫把野兽放进大锅，还对它们施放邪恶法术，对吧？";
			next;
			mes "[Innkeeper]";
			mes "更糟的是，喝下用野兽制成的药的人还会回来继续喝！";
			mes "他会四处寻找那座塔，最后变成巨大的野兽！";
			emotion ET_STARE_ABOUT, playerattached();
			next;
		} else {
			mes "[Innkeeper]";
			mes "我听说那里有些怪人，即使下雨下雪，或者恋人和父母呼唤他们，也完全不会起身！";
			mes "而且乌云一直盘旋在他们头顶，引发暴风雨！";
			next;
		}
		mes "[Innkeeper]";
		mes "太可怕了！";
		close;
	case 4:
		mes "[Innkeeper]";
		mes "搜索我右边那个蔬菜形状的抽屉。";
		close;
	}
}

mora,48,128,0	script	Drawer#mora_warehouse	111,{
	if(!callfunc("F_CanOpenStorage")){
		mes "- 你不记得如何打开仓库。-";
		close;
	}
	mes "- 蔬菜形状的抽屉上写着小小的数字1 0 0。-";
	next;
	switch(select("投入100 Zeny。:什么也不做。")) {
	case 1:
		if (Zeny < 100) {
			mes "- 你身上似乎没有100 Zeny。-";
			close;
		}
		set Zeny, Zeny-100;
		openstorage;
		close;
	case 2:
		mes "- 你放弃使用仓库。-";
		close;
	}
}

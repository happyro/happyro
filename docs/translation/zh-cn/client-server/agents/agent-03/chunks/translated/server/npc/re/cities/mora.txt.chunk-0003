		mes "[Upset Traveler]";
		mes "你这个混蛋……你从这家伙身上";
		mes "得到了什么……？";
		emotion ET_ANGER, getnpcid(0, "Traveler#ep14_1_1");
		break;
	case 3:
		mes "["+strcharinfo(0)+"]";
		mes "我完全不知道。";
		mes "你们自己解决吧。";
		next;
		mes "[Traveler Trying to Stop the Fight]";
		mes "你这个没用的混蛋，";
		mes "想把这摊烂事丢给我吗？";
		emotion ET_FRET, getnpcid(0, "Traveler#ep14_1_3");
		break;
	}
	next;
	mes "*砰*";
	mes "你感觉后脑突然受到撞击。";
	mes "你的视线开始模糊。";
	specialeffect2 EF_HIT1;
	sc_start SC_BLIND,20000,0;
	next;
	mes "昏过去之前，你感觉有人在翻你的口袋。";
	if (Zeny >= 5000)
		set Zeny, Zeny-5000;
	else
		set Zeny, 0;
	close2;
	percentheal -99,0;
	warp "mora",31,132;
	end;
}

				mes "[F. Harrison]";
				mes "啊哈！你把所有材料都拿来了！";
				mes "……但我珍爱的‘猩红闪电’呢！？";
				mes "不把它带回来，我可不会帮你修理屠夫！！";
				close;
			}
		}
		else{
			mes "[F. Harrison]";
			mes "我需要的材料是：";
			mes "钢铁10个、铝2个、";
			mes "神之金属1个、煤炭20个……";
			mes "还有屠夫使用的特殊金属棒……";
			mes "幸好你已经找到了";
			mes "特殊金属棒。";
			close;
		}
	}
	else if(gun_na == 104){
		if(checkweight(13159,1) == 0){
			mes "-你已经超重了。-";
			mes "-先丢弃一些物品，";
			mes "再回来吧。-";
			close;
		}
		set gun_na,0;
		getitem 13159,1;
		mes "[F. Harrison]";
		mes "呼……终于修好了，多亏了你的努力。";
		mes "把它弄坏了我很抱歉，也谢谢你费心。";
		mes "只修好它让我觉得过意不去，";
		mes "所以我给它增加了一些额外威力。";
		mes "希望它能好好为你效力。";
		mes "好了，尽情使用吧。";
		close;
	}
	else if(gun_na == 0){
		if(BaseJob != Job_Gunslinger) {
			mes "[F. Harrison]";
			mes "唉，真无聊……";
			mes "不知道有没有什么";
			mes "有趣的事……";
			next;
			mes "[F. Harrison]";
			mes "算了……我还是玩玩我";
			mes "漂亮的‘猩红闪电’吧。";
			close;
		}
		if(BaseLevel > 67 && countitem(13158) > 0){
			mes "[F. Harrison]";
			mes "唉，真无聊……";
			mes "不知道有没有什么";
			mes "有趣的事……";
			next;
			mes "[F. Harrison]";
			mes "咦？你是枪手吗？";
			mes "我以前没见过你手里的";
			mes "那件武器……";
			next;
			mes "[F. Harrison]";
			mes "可以让我看看吗？求你了！";
			mes "来嘛，让我看一眼！";
			mes "我在这里快无聊死了！";
			mes "求求你啦～～？";
			next;
			if(select("才不要。:给你……") == 1){
				mes "[F. Harrison]";
				mes "哈！你以为只有你有帅气武器！？";
				mes "我也有漂亮的猩红闪电！";
				mes "哼！！";
				close;
			}
			mes "[F. Harrison]";
			mes "嘿嘿……这是艾因布罗克火器实验室";
			mes "最新研发的武器，所谓的";
			mes "‘毁灭者屠夫’，对吧？";
			mes "有意思……非常有意思……";
			next;
			mes "[F. Harrison]";
			mes "嘿，让我试用一下，怎么样？别担心，";
			mes "我知道怎么使用武器，";
			mes "不会把它弄坏的！";
			mes "就这么定了！走吧～";
			delitem 13158,1;
			set gun_na,100;
			close;
		}
	}
}







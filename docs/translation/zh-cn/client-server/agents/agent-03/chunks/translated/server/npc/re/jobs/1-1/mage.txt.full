//===== rAthena Script ======================================= 
//= Renewal Mage Job Quest
//===== By: ================================================== 
//= Kisuka
//===== Current Version: ===================================== 
//= 1.1
//===== Compatible With: ===================================== 
//= rAthena Project
//===== Description: ========================================= 
//= Job Change to Mage Class
//===== Additional Comments: ================================= 
//= 1.0 First Version. [Kisuka]
//= 1.1 Added support for Baby classes. [Euphy]
//============================================================ 
geffen_in,164,124,4	script	Mage Guildsman#mage	123,{
	if (Upper == 1) {
		if (ADVJOB == Job_High_Wizard || ADVJOB == Job_Professor) {
			if (Class == Job_Novice_High) {
				mes "[Mage Guildsman]";
				mes "哇，好久不见！不过你不是应该已经死了吗？";
				next;
				mes "[Mage Guildsman]";
				mes "啊，你一定是转生了。很高兴你回来了。";
				next;
				if (!callfunc("F_CanChangeJob")) {
					mes "[Mage Guildsman]";
					mes "抱歉，我觉得你还没准备好学习魔法。先去完成基础技能的学习吧？";
					next;
					mes "[Mage Guildsman]";
					mes "慢慢来。学得越多，就越能准备好再次学习魔法。";
					close;
				}
				mes "[Mage Guildsman]";
				mes "既然你曾通过魔法师测试，我不会质疑你的资格。你想立刻恢复魔法技能，对吧？";
				next;
				skill "NV_TRICKDEAD",0,SKILL_PERM;
				jobchange Job_Mage_High;
				skill "MG_ENERGYCOAT",1,SKILL_PERM;
				mes "[Mage Guildsman]";
				mes "哇，不知为何，你看起来比以前好多了。总之，我相信你也会成为更出色的魔法师。";
				close;
			}else{
				mes "[Mage Guildsman]";
				mes "还有什么我能帮你的吗？如果没有，就去测试你的技能吧！世界正在等待你~！";
				close;
			}
		}else{
			mes "[Mage Guildsman]";
			mes "什么，你对魔法师公会感兴趣？虽然不想告诉你，但你不属于这里。";
			next;
			mes "[Mage Guildsman]";
			mes "我不知道你为什么还站在我面前，但我能看出你不适合成为魔法师。";
			close;
		}
	}
	mes "[Mage Guildsman]";
	if(BaseJob != Job_Novice) {
		if(BaseJob == Job_Mage) {
			mes "喂，你没发现吗？你已经是魔法师了，傻瓜！";
			mes "总有一天，当你能用意念制造火焰时，就会明白体内的力量！";
		} else
			mes "嘿~别闹了。你已经有其他职业，不能成为魔法师。";
		close;
	}else{
		mes "嗯？";
		next;
		switch(select("我想成为魔法师:成为魔法师有什么要求？:没事，谢谢。")) {
		case 1:
			mes "[Mage Guildsman]";
			mes "想成为魔法师？嗯……";
			next;
			mes "[Mage Guildsman]";
			if (Sex == SEX_MALE) {
				mes "嘿，看看你！真可爱~！不过不是我的类型……";
			}else{
				mes "哦哦，你真是个性感美女~！";
				mes "我喜欢你这样的女孩~";
			}
			mes "对了，你说你想成为魔法师？";
			next;
			if(select("我想成为魔法师。:不用了，谢谢。") == 2) {
				mes "[Mage Guildsman]";
				mes "什么~？！刚说想成为魔法师就改变主意？！果断一点！";
				close;
			}
			mes "[Mage Guildsman]";
			if (!callfunc("F_CanChangeJob")) {
				mes "哎，你的基础技能等级还不够成为魔法师。";
				mes "回去提升基础技能吧。";
				close;
			}
			mes "好……签申请表……哇~你的字真漂亮！啊，好了，够了。";
			mes "你是……"+strcharinfo(0)+"。";
			next;
			mes "[Mage Guildsman]";
			mes "嗯，我看得出你用自己的方式努力过。虽然有点笨拙，不过我觉得没问题！";
			mes "很好！坚持基础最重要！我马上为你转职。";
			next;
			mes "[Mage Guildsman]";
			mes "哈……！你现在是魔法师了，我们的同伴！";
			mes "欢迎加入魔法师公会，新朋友！";
			next;
			mes "[Mage Guildsman]";
			mes "'Welcome to the Mage Guild~'";
			mes "恭喜你成为魔法师公会成员！加油！";
			callfunc "Job_Change",Job_Mage;
			getitem 1639,1;	// N_Rod
			close;
		case 2:
			mes "[Mage Guildsman]";
			mes "想成为魔法师？";
			mes "我很乐意为你这样的美女说明要求！";
			next;
			mes "[Mage Guildsman]";
			mes "首先，你必须达到初心者职业等级 10，并学会全部基础技能。";
			next;
			mes "[Mage Guildsman]";
			mes "过去有复杂的药水制作测试，因此申请者逐渐减少。";
			mes "所以，我们决定接受所有满足基本要求的申请者。";
			next;
			mes "[Mage Guildsman]";
			mes "别犹豫，成为魔法师吧！";
			close;
		case 3:
			mes "[Mage Guildsman]";
			mes "没事……？";
			close;
		}
	}
}

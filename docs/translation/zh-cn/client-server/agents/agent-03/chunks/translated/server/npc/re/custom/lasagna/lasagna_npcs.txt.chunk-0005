	mes "[Fettuccina]";
	mes "我在这里工作了一段时间，但我还是最小的，所以所有碗都由我来洗。";
	next;
	mes "[Fettuccina]";
	mes "出航前一杯，长途航行上岸后一杯，外地来解决炉子问题的人每人一杯，老顾客每人一杯，别人喝所以跟着喝的人也一杯……";
	next;
	mes "[Fettuccina]";
	mes "总之，我每天要洗的杯子多得超乎想象。不仅如此，还得听治安队和商人手下的低级杜拉姆抱怨，并指导新手冒险者。";
	next;
	mes "[Fettuccina]";
	mes "真是的，24 小时太短了。我们应该再雇一个人！";
	close;
}

lasagna,131,245,5	script	The diligent second son	4_CAT_3COLOR,{
	if (checkweight(1001,1) == 0) {
		mes "- 请等一下！！ -";
		mes "- 你的物品太多了。 -";
		mes "- 这意味着你无法再获得物品。 -";
		mes "- 请清理空间 -";
		mes "- 然后再试。 -";
		close;
	}
	mes "[Yota Chara]";
	mes "爸爸、妈妈，请平安回家。";
	mes "(He's making something, mumbling.)";
	next;
	if (select( "Craft Amulet", "About the Family" ) == 2) {
		mes "[Yota Chara]";
		mes "...My parents keep going out into the dangerous areas. I'm still a child to help them, so what I do is to make these amulets for them.";
		next;
		emotion ET_PROFUSELY_SWEAT;
		mes "[Yota Chara]";
		mes "如果我努力制作护身符保佑他们，却还是传来坏消息怎么办？";
		next;
		mes "[Yota Chara]";
		mes "每次有邮件来我都会吓一跳……";
		next;
		emotion ET_CRY, getnpcid(0, "The skittish fourth#wea");
		mes "[Dandi Chara]";
		mes "我们的父母到底怎么了？～放声哭泣～";
		next;
		emotion ET_BEST, getnpcid(0, "The brave third#weapon");
		mes "[Jogi Chara]";
		mes "那好吧。我来当你爸爸！！";
		next;
		emotion ET_CRY, getnpcid(0, "The skittish fourth#wea");
		emotion ET_PROFUSELY_SWEAT;
		mes "[Dandi Chara]";
		mes "~Keeps crying uncontrollably~ No way!! Mom!! Dad!!";
		next;
		mes "[Goma Chara]";
		emotion ET_FRET, getnpcid(0, "The sensitive-minded ela");
		emotion ET_PROFUSELY_SWEAT;
		mes "他们都会平安无事，很快就会回来。所以别哭了！你非要把他弄哭吗？！";
		next;
		emotion ET_THINK;
		mes "- Yota became disheartened and started making another amulet, quietly. -";
		close;
	}
	mes "[Yota Chara]";
	mes "...Do you have someone you're close to and whom you wish for their wellness?";
	mes "想要护身符的话，可以用杜拉姆代币交换。我这里有很多护身符。";
	next;
	.@s = select( "Low-grade Horse Mackerel Amulet", "Low-grade Leaf Amulet", "Low-grade Rabbit Amulet", "Shining Twig Charm", "Fresh Tuna Amulet", "Plump Earthworm Amulet" );
	mes "[Yota Chara]";
	switch(.@s) {
	case 1:
		mes mesitemlink( 28413, false ) + " is for my father who is far out to the sea.";
		break;
	case 2:
		mes mesitemlink( 28416, false ) + " is for my mother who should be wandering about the deep side of the forest.";
		break;
	case 3:
		mes mesitemlink( 28419, false ) + " is for my brothers' health and wellness.";
		break;
	case 4:
		mes mesitemlink( 28422, false ) + " is to wish for my mother to return home safely from anywhere in the world.";
		break;
	case 5:
		mes mesitemlink( 28423, false ) + " is to wish for my father to return home quick with his ship full of tunas.";
		break;
	case 6:
		mes mesitemlink( 28424, false ) + " is to wish for easy fishing so that my family won't be starved.";
		break;
	}
	if (.@s < 4) {
		.@cost = 10;
		.@item_id = 28410 + .@s * 3;
	}
	else {
		.@cost = 30;
		.@item_id = 28418 + .@s;
	}
	mes "要用 " + .@cost + " 个 " + mesitemlink( 25142, false ) + " 交换吗？";
	next;
	if (select( "Exchange", "Cancel" ) == 2) {
		mes "[Yota Chara]";
		mes "我……我说错什么了吗？";
		mes "我不是专家，但已经尽力了。";
		close;
	}
	if (countitem(25142) < .@cost) {
		mes "[Yota Chara]";
		mes "抱歉。如果不按正确价格出售，我姐姐会很生气。请带 10 个杜拉姆代币再回来好吗？";
		close;
	}
	mes "[Yota Chara]";
	mes "谢谢你。希望我的护身符能派上用场……";
	delitem 25142, .@cost;
	getitem .@item_id, 1;
	close;
}

lasagna,131,250,5	script	The brave third#weapon	4_DR_M_02,{
	if (checkweight(1001,1) == 0) {
		mes "- Hold on a second here!! -";
		mes "- You have too many items. -";
		mes "- That means you can no longer receive any items. -";
		mes "- Free up some space -";
		mes "- and try again. -";
		close;
	}
	mes "[Jogi Chara]";
	mes "～嗡嗡～";
	mes "拉萨格纳的轰炸手 Jogi 登场！";
	mes "放下武器投降吧！";
	next;
	if (select( "Act as if you surrender.", "Ignore him." ) == 2) {
		mes "[Jogi Chara]";
		mes "～发出呼呼声～";
		mes "～砰砰声～";
		mes "嗯？你想去哪里？";
		close;
	}
	mes "[Jogi Chara]";
	mes "哇哈哈！又是我的胜利！真是有收获的一天！";
	mes "接下来做什么？";
	next;
	if (select( "用代币交换武器。", "关于家人" ) == 2) {
		emotion ET_BEST;
		mes "[Jogi Chara]";
		mes "姐姐告诉我，父母都是战士！他们去参加伟大的冒险了！！";
		next;
		emotion ET_BEST;
		mes "[Jogi Chara]";
		mes "我要加入民兵队，像父母一样变得伟大！";
		mes "我还太小不能加入民兵队，但我会努力训练，加入后一定能成为王牌。";
		next;
		emotion ET_HNG;
		mes "[Jogi Chara]";
		mes "我的家人都很懒。要不是我用坚定信念训练他们，他们永远成不了战士。";
		mes "尤其是哥哥和弟弟，真是让我头疼！";
		next;
		emotion ET_SMILE;
		mes "[Jogi Chara]";
		mes "Dandi！今天的训练是<把 10 条蚯蚓放在头上！>快过来！";
		next;
		emotion ET_CRY, getnpcid(0, "The skittish fourth#wea");
		mes "[Dandi Chara]";
		mes "~Bursting into crying~ Goma Chara!!";
		close;
	}
	emotion ET_SPARK;
	mes "[Jogi Chara]";
	mes "哇，新武器！新力量！";
	mes "你要给我什么？你有很多武器吗？我能搜搜吗？要用它交换 " + mesitemlink( 25142, false ) + " 吗？";
	next;
	if (select( "Search", "Cancel" ) == 1) {
		setarray .@item_data[0],
			1690, 1,	// Marvelous Foxtail Staff [3]
			1691, 2,	// Wondrous Foxtail Staff [2]
			1692, 3,	// Magic Foxtail Staff [2]
			1693, 4,	// Magic Yellow Foxtail Staff [1]
			1694, 1,	// Foxtail Replica [3]
			1695, 2,	// Fine Foxtail Replica [2]
			1696, 3,	// Elaborate Foxtail Replica [2]
			1697, 4;	// Elaborate Yellow Foxtail Replica [1]
		.@total_item = getarraysize(.@item_data);

		while(true) {
			for ( .@i = 0; .@i < .@total_item; .@i += 2 ) {
				if ((countitem(.@item_data[.@i]) - isequippedcnt(.@item_data[.@i])) > 0)
					break;
			}
			if (.@i == .@total_item) {
				mes "[Jogi Chara]";
				mes "就这些？";
				next;
				if (select( "Search again.", "Stop." ) == 2)
					break;
			}
			else {
				mes "[Jogi Chara]";
				mes "哇！这是 ^3131FF" + getitemname(.@item_data[.@i]) + "^000000！";
				mes "用它交换 " + .@item_data[.@i+1] + " 个 " + mesitemlink( 25142, false ) + "！求你了？可以吗？";
				next;
				if (select( "Exchange", "Quit exchanging" ) == 2) {
					mes "[Jogi Chara]";
					mes "～咯咯笑～我们应该多见面！";
					close;
				}
				mes "[Jogi Chara]";
				mes "耶！！太感谢了！";
				mes "我能再找找别的吗？";
				delitem .@item_data[.@i],1;
				getitem 25142,.@item_data[.@i+1];// Doram token
				next;
			}
		}
	}
	mes "[Jogi Chara]";
	mes "～哼～好吧。";
	close;
}

lasagna,140,250,3	script	The skittish fourth#wea	4_DR_F_01,{
	if (checkweight(1001,1) == 0) {
		mes "- 请等一下！！ -";
		mes "- 你的物品太多了。 -";
		mes "- 这意味着你无法再获得物品。 -";
		mes "- 请清理空间 -";
		mes "- 然后再试。 -";
		close;
	}
	emotion ET_HUK;
	mes "[Dandi Chara]";
	mes "～尖叫～嗨……你好……";
	mes "你真的吓到我了……我还以为是 Jogi。";
	next;
	if (select( "用代币交换护甲。", "关于家人" ) == 2) {
		mes "[Dandi Chara]";
		mes "她很容易生气，但会说我值得漂亮衣服，然后为我做新衣服。";
		mes "我喜欢她……";
		next;
		emotion ET_CRY;
		mes "[Dandi Chara]";
		mes "我的哥哥们很坏，所以我尽量听 Dandi 的话。";
		mes "不过 Yota 从不露出笑容，而 Jogi 会带来蚯蚓之类可怕的东西，说我应该更坚强。～发出抽泣声～";
		next;
		emotion ET_CRY;
		mes "[Dandi Chara]";
		mes "而且 Jogi 总在森林附近徘徊，说要去加入民兵队。妈妈说那里很危险……";
		next;
		emotion ET_CRY;
		mes "[Dandi Chara]";
		mes "要是怪物把我哥哥带走怎么办？那个怪物一定很厉害……";
		next;
		emotion ET_SURPRISE;
		mes "[Dandi Chara]";
		mes "你有没有多余的护甲可以给我哥哥？可以给我吗？我会付钱……";
		close;
	}
	mes "[Dandi Chara]";
	mes "我可以搜搜你身上的物品吗？";
	mes "如果找到适合 Jogi 的物品，我会支付 " + mesitemlink( 25142, false ) + "……";
	next;
	if (select( "Search", "Cancel" ) == 1) {
		setarray .@item_data[0],	// keep the order
			15156, 4,	// Elegant Doram Suit [1]
			20790, 4,	// Elegant Doram Manteau [1]
			22085, 4,	// Elegant Doram Shoes [1]
			28415, 4,	// Advanced Saurel Charm [1]
			28418, 4,	// Advanced Leaf Charm [1]
			28421, 4,	// Advanced Bunny Charm [1]
			28414, 3,	// Fair Saurel Charm [1]
			28417, 3,	// Fair Leaf Charm [1]
			28420, 3,	// Fair Bunny Charm [1]
			15129, 3,	// Luxurious Doram Suit [1]
			20789, 3,	// Luxurious Doram Manteau [1]
			22084, 3,	// Luxurious Doram Shoes [1]
			15126, 3,	// Doram Suit [1]
			20788, 3,	// Doram Manteau [1]
			22083, 3,	// Doram Shoes [1]
			28380, 2,	// Fresh Grass Necklace [1]
			28381, 2,	// Cute Grass Necklace [1]
			28382, 2,	// Charming Grass Necklace [1]
			28422, 2,	// Shining Branch Charm [1]
			28423, 2,	// Fresh Tuna Charm [1]
			28423, 2,	// Plump Earthworm Charm [1]
			28413, 2,	// Basic Saurel Charm [1]
			28416, 2,	// Basic Leaf Charm [1]
			28419, 2;	// Basic Bunny Charm [1]
		.@total_item = getarraysize(.@item_data);

		while(true) {
			for ( .@i = 0; .@i < .@total_item; .@i += 2 ) {
				if ((countitem(.@item_data[.@i]) - isequippedcnt(.@item_data[.@i])) > 0)
					break;
			}
			if (.@i == .@total_item) {
				mes "[Dandi Chara]";
				mes "...I think That's just it. Should I look over it again, or stop right here?";
				next;
				if (select( "Search again.", "Stop." ) == 2)
					break;
			}
			else {
				mes "[Dandi Chara]";
				mes "哇，这一定是 ^3131FF" + getitemname(.@item_data[.@i]) + "^000000！！";
				mes "要不要用它交换 " + .@item_data[.@i+1] + " 个 " + mesitemlink( 25142, false ) + "？";
				next;
				if (select( "Exchange", "Quit exchanging" ) == 2) {
					mes "[Dandi Chara]";
					mes "知道了。我搜你的背包太久了，抱歉……";
					close;
				}
				mes "[Dandi Chara]";
				mes "谢谢你。";
				mes "我能再找找别的吗？";
				delitem .@item_data[.@i],1;
				getitem 25142,.@item_data[.@i+1];// Doram token
				next;
			}
		}
	}
	mes "[Dandi Chara]";
	mes "好吧……谢谢你的……帮助吧……";
	close;
}

lasagna,140,245,3	script	The sensitive-minded ela	4_CAT_SAILOR3,{
	if (checkweight(1001,1) == 0) {
		mes "- Hold on a second here!! -";
		mes "- You have too many items. -";
		mes "- That means you can no longer receive any items. -";
		mes "- Free up some space -";
		mes "- and try again. -";
		close;
	}
	mes "[Goma Chara]";
	mes "我是 Chara 家族的大女儿 Goma Chara。这些小鬼让我的衰老速度加快了……";
	mes "如果你有我弟弟 Yota 制作的护身符，我可以帮你抛光。";
	next;
	if (select( "升级护身符", "关于家人" ) == 2) {
		mes "[Goma Chara]";
		mes "父亲天生是水手，很久以前出海了，说要捕捉世界上最大的金枪鱼。";
		next;
		mes "[Goma Chara]";
		mes "母亲喜欢收集东西，总是深入森林寻找奇异的水果。我还没反应过来，她就已经来来去去了。";
		next;
		mes "[Goma Chara]";
		mes "所以照顾这些淘气弟弟成了我的责任！我真想知道为什么我是长姐！我快受不了了！";
		next;
		emotion ET_FRET;
		mes "[Goma Chara]";
		mes "Yota！做完护身符后把地方收拾干净！把那里的竹荚鱼鳞片捡起来。真是的……";
		next;
		emotion ET_FRET;
		mes "[Goma Chara]";
		mes "Jogi，Dandi 快要哭出来了。你能不能乖一点？";
		next;
		emotion ET_ANGER;
		mes "[Goma Chara]";
		mes "～深深叹气～我的头都晕了！";
		mes "抱歉，我们的闲聊到此为止。照顾弟弟时总觉得时间过得飞快。";
		close;
	}
	mes "[Goma Chara]";
	mes "Yota 经常制作高品质护身符，但还需要进一步抛光。";
	mes "如果他注意细节，护身符会更棒。但他就是不在乎。";
	next;
	.@s = select( "抛光竹荚鱼护身符。", "抛光树叶护身符。", "抛光兔子护身符。" ) - 1;
	setarray .@ids[0], 28413,28416,28419;
	.@start_ID = .@ids[.@s];
	if ((countitem(.@start_ID) - isequippedcnt(.@start_ID))  > 0) {	// basic amulet to upgrade
		.@your_charm_ID = .@start_ID;
		.@next_charm_ID = .@start_ID + 1;
		.@needCoin = 30;
	}
	else if ((countitem(.@start_ID+1) - isequippedcnt(.@start_ID+1))  > 0) {	// intermediate
		.@your_charm_ID = .@start_ID + 1;
		.@next_charm_ID = .@start_ID + 2;
		.@needCoin = 90;
	}
	else if ((countitem(.@start_ID+2) - isequippedcnt(.@start_ID+2))  > 0) {	// player have some "perfect" amulet in inventory
		mes "[Goma Chara]";
		mes "这个护身符已经完美了！";
		close;
	}
	if (.@your_charm_ID < 1) {
		mes "[Goma Chara]";
		mes "把你的护身符给我看看。我在背包里找不到。";
		close;
	}
	mes "[Goma Chara]";
	mes "让我看看。嗯……是 " + getitemname(.@your_charm_ID) + "。";
	mes "……我就知道又会这样。更糟的是，这个需要更多时间抛光！";
	next;
	mes "[Goma Chara]";
	mes "嘿，如果你给我 " + .@needCoin + " 个 " + mesitemlink( 25142, false ) + "，我就帮你修好。";
	mes "应该会变成 " + mesitemlink( .@next_charm_ID, false ) + "。你觉得怎么样？";
	next;
	if (select( "升级", "取消" ) == 2) {
		mes "[Goma Chara]";
		mes "随你。";
		close;
	}
	if (countitem(25142) < .@needCoin) {
		mes "[Goma Chara]";
		mes "材料不足，无法免费修复。";
		close;
	}
	mes "[Goma Chara]";
	mes "这个护身符的内部似乎很坚固。";
	mes "但我的灵巧更厉害。好了！好好使用我弟弟的护身符吧。";
	delitem 25142, .@needCoin;// Doram token
	delitem .@your_charm_ID,1;
	getitem .@next_charm_ID,1;
	close;
}

// Daily Quests
lasa_fild01,353,370,5	script	Shepherd#dorcon	4_DR_KID_01,{
	if (BaseLevel < 6 || BaseLevel > 9) {
		if (BaseLevel > 9) {
			if (checkquest(14592,PLAYTIME) == 2)
				erasequest 14592;
			switch( checkquest(14546,HUNTING) ) {
			case -1:
				break;
			case 0:
			case 1:
				mes "[Shepherd]";
				mes "你已经很努力地帮助我们了，但我还是想说，不如找点别的工作？浪费你的才能太可惜了。";
				next;
				mes "[Shepherd]";
				if (BaseLevel < 14)
					mes "我听说采蜜工作需要帮助，你可以去找^4D4DFF[Florin]^000000。谢谢你帮助我们。";
				else if (BaseLevel < 16)
					mes "我听说 Prok 现在需要帮助。为什么不去找^4D4DFF[Prok]^000000？谢谢你帮助我们。";
				else if (BaseLevel < 20)
					mes "说起来，^4D4DFF[Fisher]^000000说他需要帮助。你愿意试试吗？谢谢你帮助我们。";
				else if (BaseLevel < 21)
					mes "^4D4DFF[Sleepy meow]^000000, who lives over there at the mouth of the cave where basilisks live, is desperately seeking for a strong individual. Perhaps you should give it a try for the experience. Thank you for helping us.";
				else
					mes "从^4D4DFF[码头]^000000乘船寻找更大的冒险也是好主意。谢谢你帮助我们。";
				erasequest 14546;// Take care of grass thief
				close;
			case 2:
				mes "[Shepherd]";
				mes "谢谢你。现在我们的牛可以享用美味的食物了。";
				next;
				mes "[Shepherd]";
				mes "但你似乎太擅长这类工作了。还有许多需要体力的工作，也许你该去找找。";
				next;
				mes "[Shepherd]";
				mes "今天不行。也许明天？让我想想……谁说过需要帮助？";
				next;
				mes "[Shepherd]";
				if (BaseLevel < 14)
					mes "我听说采蜜工作需要帮助，你可以去找^4D4DFF[Florin]^000000。谢谢你帮助我们。";
				else if (BaseLevel < 16)
					mes "我听说 Prok 现在需要帮助。去找^4D4DFF[Prok]^000000吧。谢谢你帮助我们。";
				else if (BaseLevel < 20)
					mes "说起来，^4D4DFF[Fisher]^000000说他需要帮助。你愿意试试吗？谢谢你帮助我们。";
				else if (BaseLevel < 21)
					mes "^4D4DFF[Sleepy meow]^000000, who lives over there at the mouth of the cave where basilisks live, is desperately seeking for a strong individual. Perhaps you should give it a try for the experience. Thank you for helping us.";
				else
					mes "从^4D4DFF[码头]^000000乘船寻找更大的冒险也是好主意。谢谢你帮助我们。";
				erasequest 14546;// Take care of grass thief
				if (isbegin_quest(14592) == 0 && BaseLevel < 21)
					setquest 14592;// Resting Time
				getexp 150,250;
				close;
			}
		}
		mes "[Shepherd]";

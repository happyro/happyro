//===== rAthena Script ======================================= 
//= Emperium Seller
//===== By: ================================================== 
//= Pokye
//===== Current Version: ===================================== 
//= 1.0
//===== Compatible With: ===================================== 
//= rAthena Project
//===== Description: ========================================= 
//= Sell Emperium
//===== Additional Comments: ================================= 
//= 1.0 Special thanks for Balfear and Everade
//============================================================ 

prt_in,212,169,3	script	Guild Clerk	4_M_04,{
	if (gettime(DT_DAYOFWEEK) >= 1 && gettime(DT_DAYOFWEEK) <= 6 && gettime(DT_HOUR) >= 18 && gettime(DT_HOUR) <= 23) {
		mes "[公会职员]";
		mes "今天要发放到公会办公室的 Emperium 已经到了。想购买的话，请随意选购~";
		next;
		mes "[公会职员]";
		mes "今天似乎有很多人在找 Emperium。只是我的个人感觉。";
		close2;                                                                                                         
		callshop "emp_seller#slo";
		end;
	}
	mes "[公会职员]";
	mes "我们的公会办公室积极协助冒险者顺利集合。";
	next;
	mes "[公会职员]";
	mes "作为其中一部分，";
	mes "我们每天限量出售 100 个" + mesitemlink( 714, false ) + " ，每天";
	mes "时间为^0000ff周一至周六 18:00 至 23:59^000000。";
	next;
	mes "[公会职员]";
	mes "请注意，公会办公室并非全天出售，因为其他时间我们要外出补充 Emperium。";
	close;

OnHour00:
	npcshopupdate "emp_seller#slo",714,0,100;
	end;
}
-	marketshop	emp_seller#slo	FAKE_NPC,714:1000000:100

	end;
OnEventOn:
	.is_enabled = 1;
	enablenpc "#soltalk02";
	sleep 3000;
	npctalk "雅肯：士兵们，我们来自不同国家，但为了同一个目标聚集于此！", "Instructor Jakken#h_sol01";
	sleep 3000;
	npctalk "雅肯：让敌人见识我们团结的力量！", "Instructor Jakken#h_sol01";
	sleep 2000;
	npctalk "雅肯：向荣耀进军！", "Instructor Jakken#h_sol01";
	sleep 1500;
	npctalk "黎明时分~", "Midgard Alliance Soldier#h_sol02";
	npctalk "我做了个梦~", "Midgard Alliance Soldier#h_sol03";
	npctalk "梦见了故乡~", "Midgard Alliance Soldier#h_sol04";
	sleep 3000;
	npctalk "我穿上外套~", "Midgard Alliance Soldier#h_sol05";
	npctalk "戴上头盔~", "Midgard Alliance Soldier#h_sol06";
	npctalk "准备迎接新的一天~", "Midgard Alliance Soldier#h_sol07";
	sleep 3000;
	npctalk "我准备好了~", "Midgard Alliance Soldier#h_sol08";
	npctalk "我佩上长剑~", "Midgard Alliance Soldier#h_sol09";
	npctalk "踏在清晨的阳光下~", "Midgard Alliance Soldier#h_sol10";
	sleep 3000;
	npctalk "我抬头仰望~", "Midgard Alliance Soldier#h_sol11";
	npctalk "我抬头仰望~", "Midgard Alliance Soldier#h_sol12";
	npctalk "向前看~", "Midgard Alliance Soldier#h_sol13";
	sleep 3000;
	npctalk "水清澈~", "Midgard Alliance Soldier#h_sol02";
	npctalk "山青翠~", "Midgard Alliance Soldier#h_sol03";
	npctalk "为了我的家乡~", "Midgard Alliance Soldier#h_sol04";
	sleep 3000;
	npctalk "我不会停下~", "Midgard Alliance Soldier#h_sol05";
	npctalk "直到我击败", "Midgard Alliance Soldier#h_sol06";
	npctalk "魔神为止！", "Midgard Alliance Soldier#h_sol07";
	sleep 3000;
	npctalk "我不会停下~", "Midgard Alliance Soldier#h_sol08";
	npctalk "直到我击败", "Midgard Alliance Soldier#h_sol09";
	npctalk "魔神为止！", "Midgard Alliance Soldier#h_sol10";
	sleep 3000;
	npctalk "哇啊啊——！", "Midgard Alliance Soldier#h_sol11";
	npctalk "哈啊啊——！", "Midgard Alliance Soldier#h_sol12";
	npctalk "哈啊啊——！", "Midgard Alliance Soldier#h_sol13";
	sleep 18000;
	disablenpc "#soltalk02";
	.is_enabled = 0;
	end;

OnInit:
	disablenpc "#soltalk02";
	end;
}


moro_vol,134,83,5	script	Jeruth Vehanus#ep143	4_MAN_JERUTOO,{
	mes "[Vehanus]";
	mes "你也来到这里了。";
	mes "看来不用戒指也能和我交流。";
	next;
	mes "[Vehanus]";
	mes "现在我想知道彩虹桥的恩泽能延伸多远。";
	mes "也许我该借此机会了解拉菲内族。";
	next;
	mes "[Vehanus]";
	mes "我佩服赫斯兰特的勇气。";
	mes "他来到战场，愿意与我们的敌人拉菲内族结盟。";
	next;
	mes "[Vehanus]";
	mes "我真希望我们不必在这里和拉菲内族交战。";
	close;
}

moro_vol,138,84,3	script	Adjutant Tiera#ep143	4_MAN_NITT,{
	mes "[Tiera]";
	mes "迪卡斯特斯·迪尔的杰鲁斯和尼特族或许答应了赫斯兰特的请求，";
	next;
	mes "[Tiera]";
	mes "但在这件事上我完全支持他。";
	mes "面对共同的敌人魔神，敌人就是朋友。";
	next;
	mes "[Tiera]";
	mes "我们当然可以当懦夫，让别人替我们战斗，";
	mes "但如果他们输了呢？我们会和他们一起败亡，那是我们的责任。";
	next;
	mes "[Tiera]";
	mes "人类，你们也一样。";
	mes "我们战斗就是为了胜利。";
	close;
}

moro_vol,134,87,1	script	Advance Captain Avaranc#ep143	4_MAN_GALTUN,{
	mes "[Avaranche]";

		npctalk "即使……死后……我也会诅咒你……", "", bc_self;
	else if (.@r == 2)
		npctalk "我什么……都没有……", "", bc_self;
	else if (.@r == 3)
		npctalk "你……在想什么……？", "", bc_self;
	else
		npctalk "你……甚至……没有……家人吗……？", "", bc_self;

		getitemname(18974),	// Old_Driver_Band_Y
		getitemname(18975),	// Old_Shadow_Handicraft
		getitemname(18976),	// Old_Minstrel_Song_Hat
		getitemname(18977),	// Old_Midas_Whisper
		getitemname(18978),	// Old_Magic_Stone_Hat
		getitemname(18979),	// Old_Blazing_Soul
		getitemname(18980),	// Old_Wind_Whisper
		getitemname(18981),	// Old_Dying_Swan
		getitemname(18984),	// Old_Camo_RabbitHood
		getitemname(18982),	// Old_Circlet_Of_Bone
		getitemname(18983),	// Old_Protect_Of_Crown
		getitemname(20749);	// Cloak of the Fallen Soldier[1]
	while(true) {
		if (checkweight(2677,5) == 0) {
			mes "[悲伤灵魂的心念]";
			mes "你的背包……";
			mes "已经满了……";
			close;
		}
		if (select( "交出灵魂。", "结束对话。" ) == 2) {
			mes "[悲伤灵魂的心念]";
			mes "……我希望……你……能再次回来找我……";
			close;
		}
		mes "[悲伤灵魂的心念]";
		mes "如果你交出……我们的灵魂……我会通过合成……制作充满特殊力量的东西……";
		mes "你……想要……什么……？";
		while(true) {
			next;
			switch( select( "返回上一个菜单。", .@item_name$[0], .@item_name$[1], .@item_name$[2], .@item_name$[3], .@item_name$[4], .@item_name$[5], .@item_name$[6], .@item_name$[7], .@item_name$[8], .@item_name$[9], .@item_name$[10], .@item_name$[11], .@item_name$[12], .@item_name$[13], .@item_name$[14] + "[1]" ) ) {
			case 1:
				break;
			case 2:
				mes "- " + .@item_name$[0] + " -";
				mes "^006400该物品无法与其他账号交易。^000000";
				mes "^006400全属性 + 1, MDEF+ 5^000000";
				mes "^006400每提升 1 级强化，ATK + 4^000000";
				mes "^006400每提升 5 级强化，ASPD + 1^000000";

				mes "^006400每提升 2 级强化，点燃爆裂伤害增加 20%^000000";
				mes "^006400每提升 2 级强化^000000";
				mes "^006400每提升 2 级强化，百矛穿刺伤害增加 15%^000000";
				mes "^006400每提升 2 级强化^000000";
				mes "^006400类型：头盔 防御：10^000000";

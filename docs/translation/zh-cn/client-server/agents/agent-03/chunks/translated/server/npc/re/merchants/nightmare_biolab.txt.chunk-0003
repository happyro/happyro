
		if (callfunc("F_IsEquipIDHack", EQI_HEAD_TOP, .@equip_id) || callfunc("F_IsEquipCardHack", EQI_HEAD_TOP, .@card[0], .@card[1], .@card[2], .@card[3]) || callfunc("F_IsEquipRefineHack", EQI_HEAD_TOP, .@refine))
			close;

		delequip EQI_HEAD_TOP;
		getitem2 .@equip_id,1,1,.@refine,0,.@card[0],0,0,0;
		mes "[漫游之心]";
		mes "咔……强烈怨念的力量……已经被吸收……我失去的东西……咔……啊……";
		close;
	case 3:
		for ( .@i = 18971; .@i <= 18984; ++.@i ) {
			if (.@i < 18977)
				.@string$[0] += getitemname(.@i) + ", ";
			else if (.@i < 18984)
				.@string$[1] += getitemname(.@i) + ", ";
			else
				.@string$[2] = getitemname(.@i);
		}
		mes "[漫游之心]";
		mes "你想要……力量吗？……如果想要……你需要……那顶旧头盔……";
		mes "^FF0000*你可以将它附魔为 " + .@string$[0];
		mes "" + .@string$[1];
		mes "" + .@string$[2] + ".*^000000";
		next;
		mes "[漫游之心]";
		mes "如果你……带来怨念的力量……我就……给予你……强大的力量……";
		mes "^FF0000*附魔需要诅咒碎片。*^000000";
		next;
		mes "[漫游之心]";
		mes "咔……当然……为了获得……强大的力量……你可能需要……无数的……怨念力量……";
		mes "^FF0000*附魔按 4、3、2 号插槽的顺序进行。每个插槽首次附魔时需要 10 个诅咒碎片。*^000000";
		next;
		mes "[漫游之心]";
		mes "如果你……有机会……也许可以……提升……附魔等级……";
		mes "^FF0000*强化附魔等级时，会根据附魔等级消耗 50、70、100、150、250、500、1000 个诅咒碎片，";
		mes "第二阶段增加 20 个诅咒碎片，第三阶段增加 40 个。*^000000";
		close;
	}
}

lhz_dun_n,143,269,4	script	Victimized Soul's Mind#1	4_M_DEATH2,{
	disable_items;
	.@r = rand(5);
	if (.@r == 0)
		npctalk "你……就是把我……变成怪物的人……", "", bc_self;
	else if (.@r == 1)
		npctalk "请救救我……你要我做什么……我都会做……", "", bc_self;
	else if (.@r == 2)
		npctalk "我深爱的……妻子和女儿……还在家里等我……", "", bc_self;
	else if (.@r == 3)
		npctalk "你……做了……那么可怕的事……", "", bc_self;
	else
		npctalk "我的……腿……我的……手臂……", "", bc_self;
	mes "[受害灵魂的心念]";
	mes "无数……实验对象的……心灵……";
	mes "过去……现在……还有复仇……";
	mes "你是谁……";
	mes "你能……安慰……被悲伤折磨的我们吗……？";
	next;
	if (.@r == 0)
		npctalk "即使我死后……即使在梦中……", "", bc_self;
	else if (.@r == 1)
		npctalk "请……救救我……请把那把刀收起来……它让我害怕……", "", bc_self;
	else if (.@r == 2)
		npctalk "求你……放过我……我会给你钱……你想要多少都行……", "", bc_self;
	else if (.@r == 3)
		npctalk "你……不害怕……上帝的……愤怒吗……？", "", bc_self;
	else
		npctalk "啊……啊……呃……", "", bc_self;
	mes "[受害灵魂的心念]";
	mes "如果你……能做到……也许……我可以……帮助你们……";
	next;
	if (.@r == 0)
		npctalk "我要……把你……撕成碎片……", "", bc_self;
	else if (.@r == 1)
		npctalk "求你……啊啊啊……", "", bc_self;
	else if (.@r == 2)
		npctalk "求你……", "", bc_self;
	else if (.@r == 3)
		npctalk "上帝……会保护……你……只要你……现在悔改……", "", bc_self;
	else
		npctalk "……尖叫……", "", bc_self;
	mes "[受害灵魂的心念]";
	mes "这把武器似乎……充满了……强烈的心念……我们的悲伤……和怨恨……";
	mes "如果你……带来一把……我会把它……恢复为……能量碎片……";
	while(true) {
		next;
		if (checkweight(2677,5) == 0) {
			mes "[受害灵魂的心念]";
			mes "你的背包……";
			mes "已经满了……";
			close;
		}
		if (select( "交出武器。", "结束对话。" ) == 2) {
			mes "[受害灵魂的心念]";
			mes "……你……还会……再次找到我……";
			close;
		}
		mes "[受害灵魂的心念]";
		mes "这把武器……包含了……什么样的心念……？";
		next;
		while(true) {
			switch( select( "返回上一个菜单。", "拳刃", "弓", "斧、钝器、书", "魔杖", "剑、短剑", "矛、双手剑", "乐器、鞭、拳套" ) ) {
			case 1:
				break;
			case 2:
				callsub S_Exchange,
					1284,	// Krishna
					1290,	// Agent_Katar
					1285,	// Chakram
					1291;	// Guillotine_Katar
				continue;
			case 3:
				callsub S_Exchange,
					18109,	// Catapult
					18110,	// Big_CrossBow
					1745,	// Falken_Blitz
					18103,	// Mystic_Bow
					18111;	// Creeper_Bow
				continue;
			case 4:
				callsub S_Exchange,
					1311,	// Vecer_Axe
					1392,	// Ygnus_Stale
					1393,	// End_Sektura
					16017,	// Bloody_Cross
					16010,	// Red_Ether_Bag
					2161,	// Geffenia_Book_Water
					1584,	// Chilly_Spell_Book
					16000,	// Erde
					16001;	// Red_Square_Bag
				continue;
			case 5:
				callsub S_Exchange,
					2005,	// Dea_Staff
					2004,	// Kronos
					1647,	// Croce_Staff
					1659,	// Recovery_Light
					1646,	// La'cryma_Stick
					1654;	// Mental_Stick
				continue;
			case 6:
				callsub S_Exchange,
					13431,	// Chrome_Sword
					13421,	// Ruber
					13061,	// Black_Wing
					13062,	// Ancient_Dagger
					13070,	// Scarletto_Nail
					13069,	// Aztoe_Nail
					13046,	// Krieg
					13047;	// Weihna
				continue;
			case 7:
				callsub S_Exchange,
					1433,	// Imperial_Spear
					1435,	// Cannon_Spear
					1490,	// Giant_Lance
					1196,	// Chrome_Twohand_Sword
					1189;	// Krasnaya
				continue;
			case 8:
				callsub S_Exchange,
					1930,	// Green_Whistle
					1984,	// Stem_Whip
					1985,	// Rosebine
					1830;	// Sura_Rampage
				continue;
			}
			break;
		}
	}
	end;

S_Exchange:
	.@size = getargcount();
	.@menu$ = "返回上一个菜单。:";
	for ( .@i = 0; .@i < .@size; .@i++ ) {
		if (countitem(getarg(.@i)) < 1)
			.@menu$ += "^999999不足以兑换 " + getitemname(getarg(.@i)) + "。^000000:";
		else
			.@menu$ += "你拥有 " + getitemname(getarg(.@i)) + "。:";
	}
	.@s = select(.@menu$) - 2;
	if (.@s == -1)
		return;
	mes "[受害灵魂的心念]";
	mes "你……选择了……这把似乎……充满强烈心念的武器……我……要将它恢复为能量碎片……你同意吗？";
	next;
	if (select( "不同意。", "获取能量碎片。" ) == 2) {
		if (countitem(getarg(.@s)) < 1) {
			mes "[受害灵魂的心念]";
			mes "你没有……^006400" + getitemname(getarg(.@s)) + "^000000...";
			mes "你还有……其他事情……要找我吗……？";
			next;
			return;
		}
		donpcevent strnpcinfo(0) + "::OnBar";
		sleep2 5000;
		specialeffect EF_BLACKBODY;
		specialeffect EF_GUMGANG4;
		specialeffect EF_DARKCASTING2;
		specialeffect EF_RG_COIN7;
		percentheal -50,-50;
		specialeffect2 EF_POISONSMOKE;
		specialeffect2 EF_NPC_BURNT;
		delitem getarg(.@s),1;
		.@r = rand(100);
		if (.@r < 70)
			.@amount = 1;
		else if (.@r < 90)
			.@amount = 2;
		else
			.@amount = 3;
		getitem 6820, .@amount;// Energy Fragment
		mes "[受害灵魂的心念]";
		mes "我通过恢复……制作了……能量碎片……^006400" + getitemname(getarg(.@s)) + "^000000...";
		next;
		mes "- 强烈心念的波长渗入身体，让我受到暴击伤害。-";
		next;
	}
	mes "[受害灵魂的心念]";
	mes "你还有……其他事情……要找我吗……？";
	next;
	return;

OnBar:
	progressbar_npc "000000",5;
	end;
}

lhz_dun_n,136,269,6	script	Sorrowful Soul's Mind#1	4_M_DEATH,{
	disable_items;
	.@r = rand(5);
	if (.@r == 0)
		npctalk "妈妈……好痛……", "", bc_self;
	else if (.@r == 1)
		npctalk "你们所有人……下地狱吧……", "", bc_self;
	else if (.@r == 2)
		npctalk "我不明白。为什么……是我……？", "", bc_self;
	else if (.@r == 3)
		npctalk "呃……我不……该遭受这些……", "", bc_self;
	else
		npctalk "你们全都是……恶魔……", "", bc_self;
	mes "[悲伤灵魂的心念]";
	mes "无数……实验对象的……心灵……";
	mes "过去……现在……还有复仇……";
	next;
	if (.@r == 0)
		npctalk "我的心……太痛了……", "", bc_self;
	else if (.@r == 1)
		npctalk "我……会……送你们去那里……", "", bc_self;
	else if (.@r == 2)
		npctalk "我……已经没有多少时间……留在这里了。", "", bc_self;
	else if (.@r == 3)
		npctalk "你以为……做了这一切之后……还能活着吗……？", "", bc_self;
	else
		npctalk "我是无辜的……我……不该遭受这些……", "", bc_self;
	mes "[悲伤灵魂的心念]";
	mes "你是谁……？";
	mes "你能……取回我们……被悲伤折磨的灵魂吗……？";
	next;
	if (.@r == 0)
		npctalk "我想……回家……", "", bc_self;

		mes "[Kronecker]";
		mes "你再多说一个字，我就亲手把你吊起来。";
		next;
		cutin "ep16_kronecker_granz_heine",2;
		mes "[Kronecker]";
		mes "我很惊讶。";
		mes "这意味着我们可以带来^4d4dff假的伊米尔之心^000000，或者";
		mes "带来真正的伊米尔之心碎片，替代被毁掉的部分。";
		next;
		mes "[Kronecker]";
		mes "真正的问题是特拉·格洛丽亚……";
		mes "它从一开始就是独一无二的。";
		mes "因为它是用从核心掉落的一小块碎片制成的……";
		next;
		mes "[Kronecker]";
		mes "我们应该和施瓦茨瓦尔德方面协商吗？";
		mes "等一下。";
		mes ".....";
		next;
		select("我现在该做什么？");
		mes "[Kronecker]";
		mes "整理思绪让你久等了，抱歉。";
		mes "谢谢你的努力。";
		next;
		mes "[Kronecker]";
		mes "能请你帮个忙吗？";
		mes "你能继续和尼勒姆一起拜访那个地方吗？";
		next;
		mes "[Kronecker]";
		mes "虽然我们会在正式会议上讨论，但我不认为结果会有不同。";
		next;
		mes "[Kronecker]";
		mes "请在那里守护伊米尔之心，或者把它带给我们！";
		mes "我们不抱太大希望，但值得一试，不是吗？";
		next;
		mes "[Kronecker]";
		mes "拜托了。";
		mes "我会批准你每天访问王室往日回忆。";
		mes "请从弗里茨……我是说弗里德里希那里接受任务。";
		next;
		mes "[Kronecker]";
		mes "虽然很遗憾，但你是我们仅剩的希望。";
		mes "我们就靠你了。";
		erasequest 7703;// Who Knows the Truth
		getitem 6919,30;// TokenOfHonor
		getexp 800000,800000;
		setquest 7706;// Nillem Is Not Almighty
		ep16_royal = 23;
		next;
		cutin "",255;
		mes "^4d4dff从现在起，你可以从弗里德里希·斯托尔策那里接受与过去的意识之屋相关的每日任务。^000000";
		close;
	}
	if (ep16_royal > 22) {
		cutin "ep16_kronecker_granz_heine",2;
		mes "[Kronecker G. Heine]";
		mes "那么，这里的事情就交给你和尼勒姆了。";
		mes "为了王室家族的正统性……";
		next;
		mes "[Kronecker G. Heine]";
		mes "请秘密执行这项任务。";
		close3;
	}
	end;
OnInit:
	cloakonnpc();
	cloakonnpc "Kronecker G. Heine#ep16_01_lib02";
	cloakonnpc "Nyhill M. Heine#ep16_lib01";
	end;
}

prt_lib,81,79,5	script	Kronecker G. Heine#ep16_01_lib02	4_EP16_GRANZ,{ end; }
prt_lib,83,80,5	script	Nyhill M. Heine#ep16_lib01	4_EP16_NIHIL,{ end; }

prt_lib,85,82,5	script	Ian Walther#ep16_lib01	1_M_JOBTESTER,{
	if (ep16_royal < 9) {
		if (strnpcinfo(1) == "Ian Walther") {
			npctalk "心神不宁时，就会一句话也说不出来。", "Ian Walther#ep16_lib01", bc_self;
			setpcblock PCBLOCK_NPC, true;
			sleep2 3000;
			setpcblock PCBLOCK_NPC, false;
			npctalk "这正描述了我现在的感受。", "Ian Walther#ep16_lib01", bc_self;
		}
		else if (strnpcinfo(1) == "Levuiere Wigner")
			npctalk "……事情接下来会变成什么样……", "Levuiere Wigner#ep16_lib01", bc_self;
		else
			npctalk "难以置信。", "Maximilian Roegenburg#ep16_lib01", bc_self;
		end;
	}
	.@char_id = getcharid(0);
	if (ep16_royal == 9) {
		.@name$ = strcharinfo(0);
		.@account_id = getcharid(3);
		mes "[Ian Walther]";
		mes "我们一直在等你，因为……";
		mes "我们想知道你是否^4d4dff曾把仪式的事告诉过别人^000000。";
		next;
		npctalk "……奇怪，是空白的。", "Kronecker G. Heine#ep16_01_lib01", bc_self;
		mes "[Ian Walther]";
		mes "只有少数人知道王室往日回忆和祝福仪式……";
		next;
		mes "[Maximilian]";
		mes "你得说得更清楚。";
		mes "直接说吧。";
		next;
		select("我是这里的嫌疑人吗？");
		mes "[Ian Walther]";
		mes "啊，是这样的……";
		mes "你是唯一知道这件事的外人，而且之前没有先例……";
		npctalk "这只是间接证据……嗯……", "Maximilian Roegenburg#ep16_lib01", bc_self;
		npctalk ".....", "Nyhill M. Heine#ep16_lib01", bc_self;
		next;
		mes "[Nyhill]";
		mes "我不这么认为。";
		mes "这位英雄甚至不知道王室往日回忆的存在，也不知道它在哪里。";
		next;
		mes "[Nyhill]";
		mes "我们只告诉他王室议会完成后观察仪式。";
		mes "从没提过仪式在哪里或如何举行。";
		next;
		mes "[Nyhill]";
		mes "我理解这起突发事件让你们多么不安。";
		mes "但是，请不要怀疑无辜的人。";
		next;
		npctalk "哈……到底是怎么回事！", "Kronecker G. Heine#ep16_01_lib01", bc_self;
		mes "[Nyhill]";
		mes "那一定是……";
		next;
		cloakonnpcself( "Kronecker G. Heine#ep16_01_lib01" );
		cloakoffnpcself( "Kronecker G. Heine#ep16_01_lib02" );
		mes "[Kronecker]";
		mes "真麻烦。";
		mes "你以前见过这份文件吗？";
		next;
		mes "[Levuiere]";
		mes "是什么？";
		mes "我们正在处理重要的事情。";
		next;
		mes "[Kronecker]";
		mes "没有什么比这更重要！";
		mes "事情已经发生了。我们必须为未来做准备。";
		next;
		mes "[Kronecker]";
		mes "但是，^4d4dff特拉·格洛丽亚^000000不见了……";
		npctalk "特拉·格洛丽亚……？", "Ian Walther#ep16_lib01", bc_self;
		npctalk "不见了？发生了什么……？", "Levuiere Wigner#ep16_lib01", bc_self;
		npctalk "!!!!!", "Maximilian Roegenburg#ep16_lib01", bc_self;
		next;
		mes "[Kronecker]";
		mes "我们处理倒下的彼得时它消失了。";
		mes "我想那些入侵者一定是在爆炸时把它拿走了。";
		next;
		mes "[Kronecker]";
		mes "至于祝福之星……他们说……";
		mes "那是^4d4dff假的^000000。";
		next;
		mes "[Kronecker]";
		mes "一定是指伊米尔之心的碎片。";
		next;
		mes "[Nyhill]";
		mes "抱歉打断你们，但我有话要说。";
		next;
		npctalk "你在做什么？注意礼貌。", "Kronecker G. Heine#ep16_01_lib02", bc_self;
		mes "[Nyhill]";
		mes "……这很重要。我正要告诉你们这一切的原因。";
		next;
		mes "[Ian Walther]";
		mes "事件的原因？";
		mes "你的意思是你知道是谁泄露了秘密？";
		next;
		npctalk "……", "Nyhill M. Heine#ep16_lib01", bc_self;
		mes "[Nyhill]";
		mes "泄露仪式秘密的人……";
		sleep2 1000;
		mes "是我。";
		sleep2 500;
		npctalk "什么？", "Ian Walther#ep16_lib01", bc_self;
		npctalk "！！！", "Levuiere Wigner#ep16_lib01", bc_self;
		npctalk "哈！", "Maximilian Roegenburg#ep16_lib01", bc_self;
		mes "...So...";
		next;
		mes "[Nyhill]";
		mes "请惩罚我的过错。";
		next;
		mes "[Kronecker]";
		mes "你在说什么？尼希尔！";
		mes "你为什么要……！";
		next;
		mes "[Nyhill]";
		mes "我想是我。";
		mes "我记得自己喝醉时曾和别人谈过这件事。";
		next;
		unittalk .@account_id, "" + .@name$ + " : (Does it mean...)", bc_self;
		mes "[Nyhill]";
		mes "我想秘密就是这样泄露的。";
		mes "我深感羞愧。";
		next;
		mes "[Ian Walther]";
		mes "天啊……是海涅家族的家主……";
		mes "虽然我们沃尔特家族没有参加王室议会，但不会袖手旁观！";
		next;
		unittalk .@account_id, "" + .@name$ + " : (He must have been drugged then.)", bc_self;
		mes "[Maximilian]";
		mes "哈，我听说过人们怎么评价你。你似乎真的什么都做不好。";
		mes "你为什么要做这种事？";
		next;
		mes "[Maximilian]";
		mes "你就那么想当国王吗？";
		mes "彼得可是你自己的家族成员！";
		next;
		unittalk .@account_id, "" + .@name$ + " : (They were looking for a target...)", bc_self;
		mes "[Nyhill]";
		mes "……呼……";
		mes "不是那样……";
		next;
		mes "[Kronecker]";
		mes "为自己辩解吧。";
		mes "我想知道你到底有多无能。";
		next;
		unittalk .@account_id, "" + .@name$ + " : (It was just a misfortune that Nyhill was marked as the target...)", bc_self;
		mes "[Nyhill]";
		mes "我无话可说。";
		mes "不过……";
		next;
		mes "[Nyhill]";
		mes "我是海涅家族的人，鲁恩·米德加尔特七大王室家族之一。";
		mes "我不是故意做这种事的。";
		next;
		mes "[Maximilian]";
		mes "你确定不是为了报复失去王位候选人的资格才这么做的吗？";
		next;
		mes "[Nyhill]";
		mes "我说过那不是真的！";
		mes "..........";
		unittalk .@account_id, "" + .@name$ + " : ...Oh, my...", bc_self;
		next;
		select("等等，我可以打断一下吗？");
		mes "[Ian Walther]";
		mes "请吧。之前失礼了，抱歉。";
		mes "……亲爱的客人，你知道这件事吗？";
		next;
		select("告诉他们宴会厅里发生的事。");
		mes "[Levuiere]";
		mes "……真的发生过这种事？";
		mes "一个看起来像科学家和药剂师的人……";
		next;
		mes "[Levuiere]";
		mes "如果是真的，海涅大人一定不是故意这样做的。";
		mes "一定有人按照某个阴谋利用了他……";
		next;
		mes "[Maximilian]";
		mes "你有证据吗？";
		mes "你不是为了帮他才编出这个故事的吧？";
		unittalk .@account_id, "" + .@name$ + " : (Skia will testify for him since we found him together.)", bc_self;
		next;
		select("尼鲁斯夫人会作证……");
		mes "[Ian Walther]";
		mes "……嗯……尼鲁斯家族的女士们也看到了？";
		mes "我们需要召开会议。";
		next;
		mes "[Ian Walther]";
		mes "嘿，格兰茨。你打算怎么做？";
		next;
		mes "[Kronecker]";
		mes "即使这是真的，他的行为也太鲁莽了。";
		mes "我不能就这样算了。";
		next;
		mes "[Kronecker]";
		mes "虽然很难开口，但这可能会被视为叛国。";
		mes "真是遗憾。我无话可说。";
		next;
		mes "[Kronecker]";
		mes "这给海涅家族的名声带来了耻辱。";
		next;
		mes "[Kronecker]";
		mes "尼希尔，我判你纪律禁闭一段时间。";
		mes "除了必须见的人，不得与任何人联系。";
		next;
		mes "[Kronecker]";
		mes "至于消失的^4d4dff特拉·格洛丽亚^000000";
		mes "以及被毁的祝福之星，我们必须想出解决办法。";
		next;
		mes "[Ian Walther]";
		mes "这会是一场漫长的讨论。";
		mes "我马上召集会议。";
		next;
		mes "[Ian Walther]";
		mes "那稍后见。";
		erasequest 7693;// Surprise Attack
		ep16_royal = 10;
		close2;
		npctalk "法师！启动大门。", "Ian Walther#ep16_lib01", bc_self;
		setpcblock PCBLOCK_NPC, true;
		sleep2 2000;
		npctalk "哦，是的。其他人之前使用过，大门已经启动了。", "Mage Nillem#ep16_warp", bc_self;
		sleep2 3000;
		npctalk "是这样吗？那么，失陪了。", "Ian Walther#ep16_lib01", bc_self;
		sleep2 3000;
		cloakonnpcself( "Ian Walther#ep16_lib01" );
		sleep2 500;
		cloakonnpcself( "Levuiere Wigner#ep16_lib01" );
		cloakonnpcself( "Maximilian Roegenburg#ep16_lib01" );
		sleep2 500;
		npctalk "尼希尔，跟我来。", "Kronecker G. Heine#ep16_01_lib02", bc_self;
		sleep2 3000;
		setpcblock PCBLOCK_NPC, false;
		cloakonnpcself( "Kronecker G. Heine#ep16_01_lib02" );
		cloakonnpcself( "Nyhill M. Heine#ep16_lib01" );
		end;
	}
	mes "[Ian Walther]";
	mes "和家族讨论后，我再把详细情况告诉你。";
	close2;
	npctalk "法师！启动大门。", "Ian Walther#ep16_lib01", bc_self;
	setpcblock PCBLOCK_NPC, true;
	sleep2 2000;
	npctalk "哦，是的。其他人之前使用过，大门已经启动了。", "Mage Nillem#ep16_warp", bc_self;
	sleep2 3000;
	npctalk "是这样吗？那么，失陪了。", "Ian Walther#ep16_lib01", bc_self;
	sleep2 3000;
	cloakonnpcself( "Ian Walther#ep16_lib01" );
	sleep2 500;
	cloakonnpcself( "Levuiere Wigner#ep16_lib01" );
	cloakonnpcself( "Maximilian Roegenburg#ep16_lib01" );
	sleep2 500;
	npctalk "尼希尔，跟我来。", "Kronecker G. Heine#ep16_01_lib02", bc_self;
	sleep2 3000;
	setpcblock PCBLOCK_NPC, false;
	cloakonnpcself( "Kronecker G. Heine#ep16_01_lib02" );
	cloakonnpcself( "Nyhill M. Heine#ep16_lib01" );
	end;
}
prt_lib,88,83,4	duplicate(Ian Walther#ep16_lib01)	Levuiere Wigner#ep16_lib01	4_EP16_LOUVIERE
prt_lib,91,78,2	duplicate(Ian Walther#ep16_lib01)	Maximilian Roegenburg#ep16_lib01	4_EP16_MAX


prt_lib,94,82,3	script	Dimension Warper MkII#ep16_lib	PORTAL,{
	if (ep16_royal < 18) {
		mes "[Nillem]";
		mes "等等，还没准备好。";
		mes "别碰那个。";
		close;
	}
	mes "[Nillem]";
	mes "让我强行连接次元间隙。";
	mes "间隙可能看不见，但它仍然是一道裂缝。";
	next;
	mes "[Nillem]";
	mes "它会连接到发生重大事件的时代。";
	mes "准备好了吗？";
	next;
	if (select( "我准备好了！", "我还没准备好！" ) == 2) {
		mes "[Nillem]";
		mes "呼，别这么拖拖拉拉的。";
		close;
	}
	mes "[Nillem]";
	mes "那么，做个好梦！";
	close2;
	warp "prt_lib_q",89,43;
	end;
OnInit:
	cloakonnpc "Dimension Warper MkII#ep16_lib";
	end;
}

// Instance Room of conciousness, daily quest
prt_lib_q,91,85,3	script	Nillem#ep16_lib_q	4_M_JOB_WIZARD,{
	if (ep16_royal == 18) {
		mes "[Nillem]";
		mes "哦，我们成功了。";
		mes "虽然不知道是哪一年，但这里就是^4d4dff王室往日回忆^000000！";
		next;
		npctalk "哈！我是天才！", bc_self;
		mes "[Nillem]";
		mes "不过，我得扭转它才能到达我们想去的地方。";
		next;
		mes "[Nillem]";
		mes "可以吗？";
		mes "哈哈哈，当然可以！";
		npctalk "我是这里唯一的次元魔法师，奇妙的尼勒姆！", bc_self;
		next;
		mes "[Nillem]";
		mes "这是我第一次做这种事。";
		mes "不过，让我这样扭转次元。";
		npctalk "哼！", bc_self;
		specialeffect EF_BEGINSPELL;
		next;
		cloakoffnpcself( "Swaying Space#evt_gate02" );
		mes "[Nillem]";
		mes "强行连接空间！";
		mes "好了，看看这里发生了什么。";
		next;
		mes "[Nillem]";
		mes "准备好了吗？";
		mes "准备好后和我说——";
		ep16_royal = 19;
		close;
	}
	if (ep16_royal == 19) {
		cloakoffnpcself( "Swaying Space#evt_gate02" );
		if (getcharid(1) == 0 || is_party_leader() == false) {
			mes "^4d4dff这是作为纪念进行的事件。";
			mes "只有队长才能进行纪念事件。组队后再试一次。^000000";
			close;
		}
		mes "[Nillem]";
		mes "那么我们去看看意识之屋发生了什么。";
		mes "因为我要再次强行连接扭曲的时空，";
		mes "可能得用尽全力来维持它！";
		next;
		mes "[Nillem]";
		mes "请活着平安回来——";
		next;
		if (select( "现在连接。", "不要去。" ) == 2) {
			mes "[Nillem]";
			mes "哈哈，太晚了也不好……";
			close;
		}
		if (instance_create("Room of Consciousness") < 0) {
			mes "[Nillem]";
			mes "哦……不太顺利。";
			mes "等等，呼……让我重新积蓄力量……";
			next;
			mes "[Nillem]";
			mes "……我会让它运转起来，等一下。";
			close;
		}
		mes "[Nillem]";
		mes "哇！通往下个区域的大门启动了！";
		mes "好了，我们进去吧！";
		cloakoffnpcself( "Swaying Space#evt_gate02" );
		close;
	}
	if (ep16_royal == 20) {
		mes "[Nillem]";
		mes "你现在到这里了！";
		mes "你离开后，这里一直很混乱。";
		next;
		mes "[Nillem]";
		mes "看到那边的出口了吗？";
		mes "哈哈，那扇门通往普隆德拉。";
		next;
		mes "[Nillem]";
		mes "还有……";
		next;
		select("然后呢？");
		mes "[Nillem]";
		mes "普隆德拉正在被亡灵军队摧毁——！";
		mes "就是现在！外面乱成一团！";
		next;
		mes "[Nillem]";
		mes "我是说，既然我们已经在这里了，";
		mes "不如去看看普隆德拉未知的过去？";
		next;
		mes "[Nillem]";
		mes "我稍微调查过了，想来的时候随时都能来这里……";
		next;
		mes "[Nillem]";
		mes "嗯，这可能是平行世界之一，但反正我们也没有什么损失。";
		mes "不如去看看？";
		next;
		select("既然你坚持。");
		mes "[Nillem]";
		mes "我就知道你会同意！我果然没看错你！";
		mes "还等什么！我们出去吧！";
		erasequest 7701;// Lost Imir Heart
		setquest 7702;// Prontera at the Time
		ep16_royal = 21;
		close;
	}
	if (ep16_royal == 21) {
		mes "[Nillem]";
		mes "我们不出去吗？";
		mes "走吧！";
		close;
	}
	if (ep16_royal == 22) {
		mes "[Nillem]";
		mes "哇，我们现在整理一下思绪吧？";
		next;
		mes "[Nillem]";
		mes "^4d4dff意识之屋里有什么^000000一定是……";

			if (god_eremes > 22) {
				mes "[Egnigem]";
				mes "你为什么回到这片孤独黑暗之地？";
				next;
				mes "[Egnigem]";
				mes "请回到生者的世界。留在这里就是受苦，这就是 Niflheim 的本质。";
				close;
			}

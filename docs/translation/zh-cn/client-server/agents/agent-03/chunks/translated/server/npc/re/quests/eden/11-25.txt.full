//===== rAthena Script =======================================
//= Eden Group Quests - Mission [11 - 25]
//===== By: ==================================================
//= L0ne_W0lf
//===== Current Version: =====================================
//= 1.5
//===== Compatible With: =====================================
//= rAthena Project
//===== Description: =========================================
//= Repetable Quests for Players between Baselevel 11 - 25.
//===== Additional Comments: =================================
//= 1.0 First Version.
//= 1.1 Some little optimization here and there. [Masao]
//= 1.2 Optimized. [Euphy]
//= 1.3 Bug fixes. [Capuche]
//= 1.4 Added support to Para_Team_Mark_ in Eden Group. [Ragno]
//= 1.5 Added use of F_HasEdenGroupMark function. [Ragno]
//============================================================

moc_para01,36,38,3	script	Mission [11 - 25]#Tuto	4_BOARD3,{
	if (!callfunc("F_HasEdenGroupMark")) {
		mes "- 你需要拥有";
		mes "- ^4d4dff‘伊甸园标记’^000000";
		mes "- 才能接受这些任务。-";
		close;
	}
	for ( .@i = 11124; .@i < 11134; .@i++ )
		if (checkquest(.@i,PLAYTIME) == 2) erasequest .@i;
	for( .@i = 11114; .@i < 11124; .@i++ ) {
		.@j = checkquest(.@i,HUNTING);
		if (.@j == 2) {
			mes " - 你必须领取 ";
			mes " - 奖励后才能开始 ";
			mes " - 新任务。- ";
			mes " ";
			mes " - 管理员：斯派克 - ";
			close;
		}
		else if (.@j >= 0) {
			mes " - 一次只能申请 ";
			mes " - 一个任务。- ";
			mes " ";
			mes " - 管理员：斯派克 - ";
			close;
		}
	}
	if (BaseLevel < 11) {
		mes " - 目前没有 ";
		mes " - 可供你接受的任务。- ";
		close;
	}
	if (BaseLevel > 25) {
		mes " - 这些任务对你来说太 ";
		mes " - 简单了， ";
		mes " - 请寻找更适合你等级的 ";
		mes " - 任务。- ";
		close;
	}
	mes " - 任务公告板 -";
	mes " - 面向新手。-";
	mes " ";
	mes " - 管理员：斯派克 -";
	next;
	switch(select("猎杀蜜蜂:猎杀秃鹰:蝗虫腿:猎杀蠕虫尾巴:猎杀蘑菇:害虫防治:猎杀穆卡:猎杀吸血蝙蝠:收集羽毛:收集毒蘑菇:取消")) {
		case 1: callsub L_Quest,11114,"猎杀蜜蜂"," - 猎杀 10 只^4d4dff‘蜜蜂’^000000 - "," - 位于普隆德拉西北。- ";
		case 2: callsub L_Quest,11115,"猎杀秃鹰"," - 猎杀 20 只^4d4dff‘秃鹰’^000000 - "," - 位于梦罗克南方。- ";
		case 3: callsub L_Quest,11116,"蝗虫腿"," - 猎杀 10 只^4d4dff‘摇滚蝗虫’^000000 - "," - 位于普隆德拉西南，并- "," - 带回 10 个^4d4dff蝗虫腿^000000。- ";
		case 4: callsub L_Quest,11117,"猎杀蠕虫尾巴"," - 猎杀 20 只^4d4dff‘蠕虫尾巴’^000000 - "," - 位于斐扬东南。- ";
		case 5: callsub L_Quest,11118,"猎杀蘑菇"," - 猎杀 30 只^4d4dff‘蘑菇’^000000 - "," - 位于斐扬周边。- ";
		case 6: callsub L_Quest,11119,"害虫防治"," - 猎杀 20 个^4d4dff盗虫卵^000000 - "," - 位于普隆德拉下水道，并- "," - 带回 10 个^4d4dff蛹^000000。- ";
		case 7: callsub L_Quest,11120,"猎杀穆卡"," - 猎杀 20 只^4d4dff‘穆卡’^000000 - "," - 位于普隆德拉南方。- ";
		case 8: callsub L_Quest,11121,"猎杀吸血蝙蝠"," - 猎杀 20 只^4d4dff吸血蝙蝠^000000 - "," - 位于下水道，- "," - 普隆德拉西方。- ";
		case 9: callsub L_Quest,11122,"收集羽毛"," - 猎杀 30 只^4d4dff‘大嘴鸟’^000000 - "," - 位于普隆德拉南方。- ";
		case 10: callsub L_Quest,11123,"收集毒蘑菇"," - 猎杀 30 只^4d4dff毒蘑菇^000000 - "," - 位于吉芬塔内，并- "," - 带回 5 个^4d4dff毒蘑菇^000000。- ";
		case 11:
			mes " - Stop reading the bulletin board. - ";
			close;
	}

L_Quest:
	.@quest_status = checkquest(getarg(0)+10,PLAYTIME);
	if (.@quest_status == 0 || .@quest_status == 1) {
		mes " - Mission ^4d4dff"+ getarg(1) +"^000000 - ";
		mes " - is already finished for today. - ";
		mes " ";
		mes " - 管理员：斯派克 - ";
		close;
	}
	mes " - Mission '"+ getarg(1) +"' - ";
	for ( .@i = 2; .@i < getargcount(); .@i++ )
		mes getarg(.@i);
	mes " ";
	mes " - 管理员：斯派克 - ";
	next;
	if (select("我会完成这个任务:寻找其他任务") == 2) {
		mes " - - 寻找";
		mes " - 其他任务。- ";
		close;
	}
	for ( .@i = 2; .@i < getargcount(); .@i++ )
		mes getarg(.@i);
	setquest getarg(0);
	close;
}

moc_para01,32,30,6	script	Spike	4_F_CHILD,{
	for( .@i = 11114; .@i < 11124; .@i++ ) {
		.@j = checkquest(.@i,HUNTING);
		if (.@j == 2) {
			switch(.@i) {
				case 11114: callsub L_Quest,.@i,"猎杀蜜蜂",900;
				case 11115: callsub L_Quest,.@i,"猎杀秃鹰",1800;
				case 11116: callsub L_Quest,.@i,"蝗虫腿",1400,940,10;
				case 11117: callsub L_Quest,.@i,"猎杀蠕虫尾巴",2600;
				case 11118: callsub L_Quest,.@i,"猎杀蘑菇",3900;
				case 11119: callsub L_Quest,.@i,"害虫防治",2900,915,10;
				case 11120: callsub L_Quest,.@i,"猎杀穆卡",3200;
				case 11121: callsub L_Quest,.@i,"猎杀吸血蝙蝠",3200;
				case 11122: callsub L_Quest,.@i,"收集羽毛",5400;
				case 11123: callsub L_Quest,.@i,"收集毒蘑菇",6000,7033,5;
			}
		}
		else if (.@j >= 0) {
			mes "[Spike]";
			mes "你还没有完成任务。";
			mes "继续加油，马上就完成了。";
			close;
		}
	}
	mes "[Spike]";
	mes "你在找工作吗？";
	mes "我们总有很多工作要做。";
	next;
	mes "[Spike]";
	mes "四处看看，找些有趣的任务吧。";
	close;

L_Quest:
	.@quest_id = getarg(0);
	if (checkquest(.@quest_id,HUNTING) == 2) {
		.@item_req = getarg(3,0);
		.@req_amount = getarg(4,0);
		if (.@item_req) {
			if (countitem(.@item_req) < .@req_amount) {
				mes "[Spike]";
				mes "你的"+ getitemname(.@item_req) +".";
				mes "你需要带来"+ .@req_amount +" "+ getitemname(.@item_req) +".";
				close;
			}
		}
		mes "[Spike]";
		mes "嗯……让我看看~";
		mes "你完成了‘"+ getarg(1) +"’任务。";
		next;
		mes "[Spike]";
		mes "干得好~！！";
		mes "我们的委托人对你的工作非常满意。他会感谢你的努力。";
		mes "请再帮助我们。谢谢！";
		if (.@item_req)
			delitem .@item_req,.@req_amount;
		erasequest .@quest_id;
		setquest .@quest_id+10;
		getexp getarg(2),0;
		close;
	}
}

		case 2:
			mes "[Buddy]";
			mes "那你为什么来这里？";
			mes "你不是来见我的，对吧？";
			close;
		}
	}
	mes "[Buddy]";
	mes strcharinfo(0)+", didn't you meet the master yet?";
	next;
	mes "[Buddy]";
	mes "我的师父不喜欢噪音，请^f57d7d在客厅安静等待。^000000";
	next;
	mes "[Buddy]";
	mes "这边……";
	close2;
	warp "sword_1-1",215,244;
	end;
}


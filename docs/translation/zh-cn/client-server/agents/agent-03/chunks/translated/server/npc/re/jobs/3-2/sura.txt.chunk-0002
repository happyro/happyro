sword_1-1,222,169,5	script	Bruno#job_shu	484,{
	if (job_shu > 4) {
		mes "[Bruno]";
		mes "嘿～"+strcharinfo(0)+"，怎么了？";
		next;
		switch(select("聊聊天。:出去。")) {
		case 1:
			if (job_shu == 100) {
				mes "[Bruno]";
				mes "我的师父？";
				mes "他说自己已忘却世界，是放弃成为人类的幽灵，但似乎仍对世界留有眷恋。";
				next;
				mes "[Bruno]";
				mes "我也是修罗，但仍喜欢旅行、认识许多人～";
				next;
				mes "[Bruno]";
				mes "过去师父有一位亲密朋友，但成为修罗后，";
				next;
				mes "[Bruno]";
				mes "听说他写信告诉朋友自己已经死了。";
				mes "之后他偶尔会秘密拜访‘记忆之地’。";
				next;
				mes "[Bruno]";
				mes "不说自己死了、继续和朋友见面或许更好。";
				mes "他有点顽固。";
				next;
				mes "[Bruno]";
				mes "但他真的很酷、很棒。";
				mes "Ho ho.";
				next;
				mes "[Bruno]";
				mes "我持续旅行是为了寻找师父的‘珍贵朋友’，不是为了训练自己。";
				next;
				mes "[Bruno]";
				mes "看到师父思念朋友，我心里很难受……";
				mes "这不……不只是为了我的……师父！";
				close;
			}
			mes "[Bruno]";
			mes "哇～我以为你见到师父前就会被打倒，没想到你真的来了？";
			next;
			mes "[Bruno]";
			mes "既然你来了，现在我就是你的直属上司。";
			next;
			mes "[Bruno]";
			mes "在我们的世界里不在乎年龄！";
			close;
		case 2:
			mes "[Bruno]";
			mes "想来就再来～";
			mes "我会带你参观亡者的训练场～";
			close2;
			warp "yuno_fild07",255,178;
			end;
		}
	}
	mes "[Bruno]";
	mes "你是什么人？";
	mes "你怎么找到这里的！";
	mes "走开！！！";
	close2;
	warp "yuno_fild07",255,178;
	end;
}

sword_1-1,223,167,2	script	Master#job_shu	483,{
	mes "[Master]";
	if (job_shu == 5) {
		mes "你一定眼光敏锐，终于来到这个房间。";
		next;
		mes "[Master]";
		if (SkillPoint != 0) {
			mes "用完所有技能点后才能成为修罗。";
			close;
		}
		if (checkweight(1201,1) == 0 || MaxWeight - Weight < 3500) {
			mes "你的负重似乎太高了。请卸下一些物品。";
			close;
		}
		if (BaseLevel < 99 || JobLevel < 50) {
			mes "你似乎还没达到人类的极限，距离成为修罗还有很长的路。";
			mes "请继续修行。";
			close;
		}
		if (BaseJob != Job_Monk) {
			mes "Hmm?";
			close;
		}
		mes "当然～";
		mes "我的眼光很敏锐。";
		next;
		mes "[Bruno]";
		mes "师父！这是狼皮外套。";
		mes "天冷时穿上。";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "啊！那就是我……抓到的狼……呃。";
		next;
		mes "- 啪 -";
		next;
		mes "[Bruno]";
		mes "呵呵呵～";
		mes "你有什么要说的吗，"+strcharinfo(0)+"？";
		mes "你已经是我们家族的一员，一起好好相处吧～";
		next;
		mes "[Master]";
		mes "没错，我现在也接受你成为我的学生。";
		next;
		mes "[Master]";
		mes "我想你已经知道，成为修罗并不容易。";
		next;
		mes "[Master]";
		mes "我也与世隔绝。若有一天我们再次走入世界，那一定是世界需要幽灵参加战争的日子。";
		next;
		mes "[Master]";
		mes "希望那天不会到来，但……我会甘愿成为幽灵，消灭所有敌人。";
		next;
		if (ismounting()) {
			mes "[Master]";
			mes "所以……请从坐骑上下来！";
			mes "这种情况下骑乘是不礼貌的。";
			close;
		}
		mes "[Master]";
		mes "在那天到来前，你应该持续修行。";
		set job_shu,100;
		jobchange roclass(eaclass()|EAJL_THIRD);
		completequest 11158;
		getitem 5754,1; //Blazing_Soul
		getitem 2795,1; //Green_Apple_Ring
		close;
	} else if (job_shu > 5) {
		mes "我曾是四处旅行、结识许多朋友的普通年轻人。";
		next;
		mes "[Master]";
		mes "但正如你可能感受到的，我最终面对了自己的极限。";
		next;
		mes "[Master]";
		mes "有时我会想‘难道要放弃一切才能变得更强……？’";
		next;
		mes "[Master]";
		mes "但事已至此……";
		close;
	}
	mes "这里不是你能久留的地方。";
	mes "请回去。";
	close2;
	warp "yuno_fild07",255,178;
	end;
}

sword_2-1,1,2,0	script	Button Girl#sura	66,{
	callfunc "F_GM_NPC";
	switch(select("开启竞技场。:关闭竞技场。:开启客厅。:开启Buddy。:开启Gara。:全部关闭。:关闭")) {
	case 1:
		mes "开启竞技场。";
		donpcevent "Drawing Room::OnEnable";
		close;
	case 2:
		mes "关闭竞技场。";
		donpcevent "Drawing Room::OnDisable";
		close;
	case 3:
		mes "开启客厅。";
		donpcevent "Buddy#Sura_Salon::OnEnable";
		close;
	case 4:
		mes "开启Buddy。";
		donpcevent "Buddy#job_shuaneh::OnEnable";
		close;
	case 5:
		mes "开启Gara。";
		donpcevent "#Sura_garajjom::OnEnable";
		close;
	case 6:
		mes "全部关闭。";
		donpcevent "Drawing Room::OnDisable";
		donpcevent "Buddy#Sura_Salon::OnReset";
		donpcevent "Buddy#Sura_Salon::OnDisable";
		donpcevent "Buddy#job_shuaneh::OnDisable";
		donpcevent "#Sura_garajjom::OnDisable";
		close;
	case 7:
		close;
	}
}

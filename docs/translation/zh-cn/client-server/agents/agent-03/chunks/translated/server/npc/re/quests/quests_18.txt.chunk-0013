}

// Quest: Investigation of Oz Labyrinth. Step 12.
oz_dun02,143,231,3	script	Old Man#ep18_sb1	4_EP18_GW_OLD01,{
	if (isbegin_quest(11734) == 1) {
		mes "[Imril]";
		mes "<FONT SIZE = 14><B>Elder!!!!</FONT></B>";
		mes "你安全了！！！";
		cutin "ep18_imril_03.png",2;
		next;
		cutin "",255;
		mes "[Elder]";
		mes "不。";
		mes "这是谁？";
		mes "这不是Imril吗？";
		mes "你为什么来这么危险的地方？";
		next;
		mes "[Imril]";
		mes "不，长老，你到底为什么在这里？";
		cutin "ep18_imril_02.png",2;
		next;
		cutin "",255;
		mes "[Maze Master Elder]";
		mes "迷宫之主当然在迷宫里，不然还能在哪里。";
		next;
		mes "[Imril]";
		mes "但这里有怪物，太危险了……";
		cutin "ep18_imril_01.png",2;
		next;
		cutin "",255;
		mes "[Maze Master Elder]";
		mes "嗯，不只是这里有危险，所以别担心。";
		mes "最近怪物制造了很多噪音，我想可能有人遇险，所以下来看看。";
		next;
		mes "[Maze Master Elder]";
		mes "我已经告诉Suad，熔岩已经到达这里，下面的地面也融化了很多，更加危险，所以别再往下走。";
		next;
		mes "[Maze Master Elder]";
		mes "如果你身边是冒险家也许没事，但对你来说太危险了。";
		next;
		mes "[Imril]";
		mes "明白了。";
		mes "长老，请保重。";
		mes "快回村子。";
		cutin "ep18_imril_02.png",2;
		next;
		cutin "",255;
		mes "[Maze Master Elder]";
		mes "哦天啊~";
		mes "迷宫之主不在迷宫里，谁来管理迷宫！";
		next;
		mes "[Imril]";
		mes "总之，真固执……";
		cutin "ep18_imril_02.png",2;
		next;
		mes "[Imril]";
		mes "正如Inspirational所说，我觉得自己无法继续往下，所以回^e5555e村子^000000吧。";
		mes "我现在就觉得皮肤在燃烧。";
		erasequest 11734;
		setquest 11735;
		close2;
		cutin "",255;
		navigateto("wolfvill",143,113);
		end;
	}
	if (isbegin_quest(11735) == 1) {
		mes "[Maze Master Elder]";
		mes "哦天啊~";
		mes "迷宫之主不在迷宫里，谁来管理迷宫！";
		next;
		mes "[Imril]";
		mes "总之，你真固执……";
		cutin "ep18_imril_02.png",2;
		next;
		mes "[Imril]";
		mes "正如长老所说，我觉得不能再往下了，所以回^e5555e村子^00000。";
		mes "现在我的皮肤仍感觉要被烧着。";
		close2;
		cutin "",255;
		navigateto("wolfvill",143,113);
		end;
	}
	end;

OnInit:
	questinfo( QTYPE_QUEST2, QMARK_YELLOW, "isbegin_quest(11734) == 1" );
	end;
}

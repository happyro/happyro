// Quest: Investigation of Oz Labyrinth. Step 10.
oz_dun01,110,37,5	script	#ep18_sb2	4_POINT_RED,{
	if (isbegin_quest(11732) == 1 || isbegin_quest(11733) == 1) {
		mes "[Imril]";
		mes "呃……";
		mes "热得已经无法忍受了。";
		mes "下面更加危险，我们必须小心。";
		cutin "ep18_imril_02.png",2;
		next;
		mes "[Imril]";

wolfvill,117,119,5	script	Scania#wms01	4_EP18_GW_MAN02,5,5,{
	if (checkweight(1000405,10) == 0) {
		mes "- Wait a minute !! -";
		mes "- Currently you're carrying -";
		mes "- too many items with you. -";
		mes "- Please try again -";
		mes "- after you loose some weight. -";
		close;
	}
	if (ep18_main < 36) {
		mes "[Scania]";
		mes "天啊，看他呼吸的样子。我们的小家伙真可爱，不是吗？";
		close;
	}
	switch( isbegin_quest(17510) ) {
	case 0:
		mes "[Scania]";
		mes "嘿，伙计，你也该学学外语了……";
		npctalk "What's up?", "Goat#wms01", bc_self;
		next;
		mes "[Scania]";
		mes "天啊，看看这个！看他们呼吸的样子。他们吸气和呼气都很厉害！真正的天才！";
		next;
		cloakoffnpcself( "Maram#wms01" );
		mes "[Maram]";
		mes "你好！Scania！";
		next;
		mes "[Scania]";
		mes "Maram？你什么时候来的？比预想的早？";
		next;
		mes "[Maram]";
		mes "多亏冒险家的帮助，这次我来得快了一点。";
		npctalk "你好。你是一位强大而勇猛的冒险者。", "Maram#wms01", bc_self;
		next;
		mes "[Scania]";
		mes "这就是刚到的新人？";
		next;
		mes "[Maram]";
		mes "哦，不是这样。他不是这里的人，来自完全不同的地方。这次他帮忙采购物品，并一路运到了这里。";
		npctalk "他是一位强大而勇猛的冒险者。", "Maram#wms01", bc_self;
		next;
		mes "[Scania]";
		mes "嗯…… An adventurer...? So, they're an outsider? Are we sure about your identity? What if we search through everything he have?";
		mes "或者我们可以在那里透露一些信息？否则，他们会不会像那些移民一样试图占领我们的土地？";
		next;
		mes "[Maram]";
		mes "不，不是他！他对遇到的每个人都只有善意的话语！他完全不是那种人。你为什么要把他和那些捣乱者相提并论？";
		next;
		mes "[Scania]";
		mes "你觉得人的意图会写在脸上吗？他是盗贼还是军人，时间会告诉我们！";
		mes "Isha带回了一只狼崽，现在Marem，你要带回人类吗？";
		npctalk "带回来，是吗！注意你的措辞！", "Maram#wms01", bc_self;
		next;
		select( "I'm not that kind of person, though." );
		mes "[Maram]";
		mes "哦，当然，嘴里说出来的不一定是真的。那只是说说而已。";
		mes "对了，狼崽？什么狼崽？";
		next;
		mes "[Scania]";
		mes "哦！Isha不久前从森林带回了一只灰狼幼崽！我们叫她把它带回森林，她根本不听！";
		next;
		mes "[Scania]";
		mes "你知道这意味着什么吗？它已经给我们的羊带来麻烦了！现在就这样，长大后会怎样？它肯定会伤害我们的羊！";
		mes "所以你去试着说一次吧！我不会听你的！";
		next;
		mes "[Maram]";
		mes "哦？这确实是个好建议，会是一场很有建设性的谈话。但我该怎么办？我得整理带来的东西。";
		npctalk "Oh, what's with the awkward tone?", "Scania#wms01", bc_self;
		next;
		mes "[Maram]";
		mes "啊，当然！冒险家！你愿意去吗？探索这里、欣赏风景，也许还能给当地人留下深刻印象。";
		mes "反正我们会在这里待一阵子，对吧？这里的人都像我一样友好善良，你不会遇到敌意。";
		next;
		mes "[Maram]";
		mes "对吧，Scania？";
		next;
		mes "[Scania]";
		mes "......";
		npctalk "What's with the glare?", "Maram#wms01", bc_self;
		next;
		mes "[Maram]";
		mes "去确认Aisha带回来的究竟是真狼崽，还是一只长得像狼的幼犬。";
		npctalk "It's a wolf even without checking! I saw it all!", "Scania#wms01", bc_self;
		next;
		select( "What about verifying it?" );
		mes "[Maram]";
		mes "哦……嗯，我还没想到那么远。但如果真是狼崽，难道不会很麻烦吗？即使是幼犬也会很麻烦。";
		npctalk "麻烦会在哪里？", "Scania#wms01", bc_self;
		next;
		mes "[Maram]";
		mes "让我向新来的冒险家解释一下。这里的土地不适合饲养很多动物。";
		next;
		mes "[Maram]";
		mes "主要由Skania照料羊和鸡。几乎没有牛或猪能适应这里。因此，牲畜在这里非常珍贵。";
		next;
		mes "[Scania]";
		mes "但如果Aisha带回来的是狼崽呢？";
		next;
		mes "[Maram]";
		mes "狼妈妈会来找她的幼崽！";
		next;
		mes "[Scania]";
		mes "即使狼妈妈不来找它？";
		next;
		mes "[Maram]";
		mes "狼崽长大后会伤害牲畜！";
		next;
		emotion ET_SWEAT, playerattached();
		mes "[Scania]";
		mes "你听见了吗？";
		next;
		select( "Where should I go?" );
		mes "[Maram]";
		mes "Aisha住在哪里来着？啊，对了！去<NAVI>[上城区]<INFO>wolfvill,99,178,0,101,0</INFO></NAVI>，你会找到Aisha的房子。";
		next;
		emotion ET_SWEAT, playerattached();
		mes "[Scania]";
		mes "但说这些也没用，对吧？如果我说服你，你也许会改变对我的看法。";
		npctalk "Skania，冒险者的价值不是由你的意见决定的。", "Maram#wms01", bc_self;
		npctalk "谁说的？我来处理。", "Scania#wms01", bc_self;
		next;
		mes "[Maram]";
		mes "冒险家，那么请平安归来！我也先告辞了！";
		setquest 17510;
		close2;
		cloakonnpcself( "Maram#wms01" );
		end;
	case 1:
		mes "[Scania]";
		mes "<NAVI>[Aisha]<INFO>wolfvill,99,178,0,101,0</INFO></NAVI>, no matter how many times I say it to you, it won't make a difference, will it? If I persuade you, it might change my opinion of you too.";
		close;
	case 2:
		break;
	}
	switch( isbegin_quest(17512) ) {
	case 0:
		mes "[Scania]";
		mes "<NAVI>[Aisha]<INFO>wolfvill,99,178,0,101,0</INFO></NAVI> for a hundred days won't help? If you convince me, I'll change my opinion of you.";
		close;
	case 1:
		mes "[Scania]";
		mes "汪汪。今天的散步结束了。我太累了。";
		next;
		mes "[Goat]";
		mes "哈啊——";
		next;
		mes "[Scania]";
		mes "我不能让你一个人去。怎么能把你独自送到那么危险的地方？当然，我知道你能独自行动，但我还是担心。";
		next;
		setnpcdisplay( "Boksil#wms01", 21324 );	// EP18_GREY_WOLF_BABY
		cloakoffnpcself( "Aisha#wms01" );
		cloakoffnpcself( "Boksil#wms01" );
		npctalk "Scania!", "Aisha#wms01", bc_self;
		mes "[Scania]";
		mes "Aisha？你为什么在这里？你是来送回狼的吗？";
		next;
		npctalk "Wow!!", "Boksil#wms01", bc_self;
		mes "[Scania]";
		mes "不，不是那样。你把狼……带来了？还带到羊群面前？你疯了吗？";
		next;
		mes "[Scania]";
		mes "你到底为什么要养狼？需要狗的话，就去养狗。";
		mes "不，我来当狗就好。我也会弄乱你的房子，偶尔咬你。";
		next;
		mes "[Aisha]";
		mes "Scania，我清楚听到了你的愿望。那么，你竟然派人来找我？你把我当成什么承包商了吗，冒险家？";
		next;
		mes "[Aisha]";
		mes "你费尽心思又怎样？这个人已经站在我这边了！哈哈哈！来吧，让我看看你绝望的表情！";
		next;
		mes "[Scania]";
		mes "什么？冒险家？你背叛了我？你怎么能这样？初次见面就背叛，不觉得太过分吗？我早该知道。像你这样的外来者不可信。";
		next;
		mes "[Aisha]";
		mes "Scania，你去过冰洞吗？你血管里流的血，难道比那里结冰的水还冷？你这个冷血的家伙！";
		npctalk "什么？那水冻住了吗？", "Scania#wms01", bc_self;
		npctalk "不。..?", "Aisha#wms01", bc_self;
		next;
		mes "[Aisha]";
		mes "你怎么能建议把这个弱小脆弱的生物送回那么危险的地方？它的母亲已经死了，它无法独自生存。";
		next;
		mes "[Scania]";
		mes "它的母亲……已经不在了？";
		next;
		mes "[Aisha]";
		mes "我不是说过了吗？我告诉过你一百遍。你又没听，对吧？你只相信自己想相信的，对吧？";
		next;
		mes "[Aisha]";
		mes "我不知道你怎么想，但我无法忍心把这只弱小脆弱的幼狼送回市场。";
		next;
		mes "[Scania]";
		mes "但如果那只狼长大，我们的羊……";
		next;
		mes "[Aisha]";
		mes "不用担心那个。冒险家？";
		next;
		select( "Oh, do I need to talk about it?" );
		mes "[Aisha]";
		mes "反正你不会听我的。我说话时你从不听，只相信别人说的话。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "这只狼崽只要接受训练就没问题。从小和其他朋友一起长大，它不会伤害它们，反而会保护羊。";
		next;
		mes "[Aisha]";
		mes "你听见我说话了吗？你要怎么反驳？来吧，聪明的天才！坐下！举手！";
		emotion ET_WRAP, getnpcid(0,"Aisha#wms01");
		npctalk "Woof!!", "Boksil#wms01", bc_self;
		emotion ET_ROCK, getnpcid(0,"Boksil#wms01");
		npctalk "I'm glad you think so! You did a great job too! We're both genius!", "Aisha#wms01", bc_self;
		next;
		mes "[Scania]";
		mes "确实如此。但是……我不知道能持续多久……也不知道它能否压制野性……";
		next;
		mes "[Scania]";
		mes "最重要的是，我不认为你能耐心地训练它。";
		npctalk "你看着我做什么？喂，跟我来。", "Aisha#wms01", bc_self;
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "我会帮你缓解紧张，让它接受完整训练。我会带它散步，培养彼此感情。";
		next;
		mes "[Scania]";
		mes "但是……";
		next;
		mes "[Aisha]";
		mes "你说它独自散步时很难一直追着它。这不是好事吗？";
		npctalk "一个懒得喂羊的牧羊人。", "Aisha#wms01", bc_self;
		next;
		mes "[Scania]";

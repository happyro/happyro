gef_fild07,321,193,4	script	Langry#Fabre_Hunt	754,{
	if (checkquest(60107) != -1) {
		if (checkquest(60107,HUNTING) != 2 ) {
			mes "[Langry]";
			mes "你完成了猎杀50只苍蝇幼虫的任务吗？";
			next;
			switch(select("是:否:我想退出")) {
			case 1:
				mes "[Langry]";
				mes "嗯，我觉得你还没猎杀够50只……";
				close;
			case 2:
				mes "[Langry]";
				mes "记住，我需要你帮忙猎杀苍蝇幼虫，去猎杀50只吧。";
				close;
			case 3:
				mes "[Langry]";
				mes "确定要停止猎杀吗？";
				mes "你取得的进度都会被清除。";
				next;
				switch(select("是:否")) {
				case 1:
					mes "[Langry]";
					mes "好吧，改变主意后再回来。";
					erasequest 60107;
					close;
				case 2:
					mes "[Langry]";
					mes "请猎杀50只苍蝇幼虫。";
					close;
				}
			}
		}
		else {
			mes "[Langry]";
			mes "太棒了，你完成得真快。";
			getexp 385,30;
			erasequest 60107;
			close;
		}
	}
	if (checkquest(60108) != -1) {
		if (checkquest(60108,HUNTING) != 2 ) {
			mes "[Langry]";
			mes "你完成了猎杀100只苍蝇幼虫的任务吗？";
			next;
			switch(select("是:否:我想退出")) {
			case 1:
				mes "[Langry]";
				mes "嗯，我觉得你还没猎杀够100只……";
				close;
			case 2:
				mes "[Langry]";
				mes "记住，我需要你帮忙猎杀苍蝇幼虫，去猎杀100只吧。";
				close;
			case 3:
				mes "[Langry]";
				mes "确定要停止猎杀吗？";
				mes "你取得的进度都会被清除。";
				next;
				switch(select("是:否")) {
				case 1:
					mes "[Langry]";
					mes "好吧，改变主意后再回来。";
					erasequest 60108;
					close;
				case 2:
					mes "[Langry]";
					mes "请猎杀100只苍蝇幼虫。";
					close;
				}
			}
		}
		else {
			mes "[Langry]";
			mes "太棒了，你完成得真快。";
			getexp 385,30;
			getexp 385,30;
			erasequest 60108;
			close;
		}
	}
	if (checkquest(60109) != -1) {
		if (checkquest(60109,HUNTING) != 2 ) {
			mes "[Langry]";
			mes "你完成了猎杀150只苍蝇幼虫的任务吗？";
			next;
			switch(select("是:否:我想退出")) {
			case 1:
				mes "[Langry]";
				mes "嗯，我觉得你还没猎杀够150只……";
				close;
			case 2:
				mes "[Langry]";
				mes "记住，我需要你帮忙猎杀苍蝇幼虫，去猎杀150只吧。";
				close;
			case 3:
				mes "[Langry]";
				mes "确定要停止猎杀吗？";
				mes "你取得的进度都会被清除。";
				next;
				switch(select("是:否")) {
				case 1:
					mes "[Langry]";
					mes "好吧，改变主意后再回来。";
					erasequest 60109;
					close;
				case 2:
					mes "[Langry]";
					mes "请猎杀150只苍蝇幼虫。";
					close;
				}
			}
		}
		else {
			mes "[Langry]";
			mes "太棒了，你完成得真快。";
			getexp 385,30;
			getexp 385,30;
			getexp 385,30;
			erasequest 60109;
			close;
		}
	}
	//for minimum level
	if (BaseLevel > 1) {
		//for maximum level
		if (BaseLevel < 21) {
			mes "[Langry]";
			mes "你能帮我吗？";
			mes "拜托？";
			next;
			switch(select("当然:不")) {
			case 1:
				mes "[Langry]";
				mes "真的？！";
				mes "太好了！";
				next;
				switch(select("收集物品:猎杀苍蝇幼虫:取消")) {
				case 1:
					// Item turn in
					mes "[Langry]";
					mes "我需要收集^0000CE25个绒毛^000000";
					mes "来完成社区服务项目。";
					mes "知道吗？帮我完成后我还会给你小奖励。";
					next;
					switch(select("我有绒毛:你刚才说什么？")) {
					case 1:
						if (countitem(914) > 24) {
							mes "[Langry]";
							mes "谢谢你的绒毛，这帮了我大忙。";
							mes "给你，这应该能让你更强、更快！";
							delitem 914,25; //Fluff
							getexp 385,30;
							close;
						}
						else {
							mes "[Langry]";
							mes "我没看到绒毛，等等，看到了，是你嘴里说出的谎言。";
							close;
						}
					case 2:
						mes "[Langry]";
						mes "我需要^00CE0025个绒毛^000000。";
						close;
					}
				case 2:
					// Kill Count Quest
					mes "[Langry]";
					mes "啊，好吧。你可以帮我猎杀一些苍蝇幼虫。";
					mes "你想猎杀多少只？";
					next;
					switch(select("50只苍蝇幼虫:100只苍蝇幼虫:150只苍蝇幼虫")) {
					case 1:
						mes "[Langry]";
						mes "完成任务后回来，我会给你小奖励。";
					mes "";
						setquest 60107;
						close;
					case 2:
						mes "[Langry]";
						mes "完成任务后回来，我会给你小奖励。";
						setquest 60108;
						close;
					case 3:
						mes "[Langry]";
						mes "完成任务后回来，我会给你小奖励。";
						setquest 60109;
						close;
					}
				case 3:
					mes "[Langry]";
					mes "改变主意后请再回来。";
					close;
				}
			case 2:
				mes "[Langry]";
				mes "改变主意后请再回来。";
				close;
			}
		}
		else {
			mes "[Langry]";
			mes "你好，我叫Langry。";
			mes "我必须完成社区服务，但我太懒了。";
			close;
		}
	}
	else {
		mes "[Langry]";
		mes "你可能是最不可能的人。回收一些苍蝇幼虫后再回来。";
			mes "";
		close;
	}
}

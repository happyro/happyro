				mes "去和";
				mes "杰克谈谈，他是城西的联络人。你最好马上去……";
				set mao_request,1;
				getitem 7416,1;
				close;
			}
			else if((Class == Job_Assassin) || (Class == Job_Assassin_Cross))
			{
				mes "[米娅]";
				mes "" + strcharinfo(0) + "!";
				mes "刺客公会会长";

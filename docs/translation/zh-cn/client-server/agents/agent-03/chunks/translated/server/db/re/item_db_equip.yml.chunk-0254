      bonus bMatk,.@r;
      bonus2 bIgnoreDefClassRate,Class_Normal,3*(getskilllv("GS_SNAKEEYE")+.@r);
      .@aspd = 1;
      if (.@r>=7) {
         .@aspd += 1;

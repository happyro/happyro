ecl_fild01,183,94,0	script	#pa0829EtranExterioTouch	HIDDEN_WARP_NPC,3,3,{
	end;
OnTouch_:
	if (checkweight(1201,1) == 0) {
		mes "看来物品种类太多了。减少种类后再试。";
		close;
	}
	if ((MaxWeight - Weight) < 10000) {
		mes "看来我带的东西太重了。减轻负重后再试。";
		close;
	}
	if (ep14_2_etran == 34) {
		disable_items;
		cutin "EP14_etran1",1;
		mes "[Etran]";
		mes "哇……这、这是……！！！";
		next;
		cutin "EP14_bif02",3;
		mes "[Etran]";
		mes "这是真的吗？这不是梦，对吧……"+ strcharinfo(0) +".";
		next;
		select("这不是梦");
		mes "["+ strcharinfo(0) +"]";
		mes "你现在看到的是数千名Laphine后裔的家园——生命之地彩虹桥。";
		next;
		cutin "EP14_etran7",1;
		mes "[Etran]";
		mes "我没有错。我没有错。";
		next;
	mes "^000099Etran 开始抽泣，似乎摆脱了生命中的负担。他好像想起了什么，并提出一个问题。^000000";
		next;
		cutin "EP14_etran5",1;
		mes "[Etran]";
		mes "但是，Robert的家园树呢？他的家园树发生了什么？";
		next;
		select("他的家园树也长得很好。");
		cutin "EP14_etran1",1;
		mes "[Etran]";
		mes "我明白了。我想看看他培育的家园树……你也能带我去那里吗？";
		next;
		select("很遗憾，办不到……");
		cutin "",255;
		mes "["+ strcharinfo(0) +"]";
		mes "很遗憾，这台反应堆的范围太小，带你去那里时连接会断开。恐怕不可能。";
		next;
		cutin "EP14_etran6",1;
		mes "[Etran]";
		mes "Robert真的也成功了吗？你该不会想把他的失败瞒着我吧？";
		next;
		select("我该带些东西证明给你看吗？");
		mes "[Etran]";
		mes "证明？";
		while (1) {
			next;
			switch( select("带猫罐头。:带Laphine硬币。:带家园树叶。") ) {
				mes "[Etran]";
			case 1:
				cutin "EP14_etran5",1;
				mes "猫罐头？这和家园树有什么关系？";
				next;
				cutin "",255;
				mes "["+ strcharinfo(0) +"]";
				mes "哦，我只是随口胡说。";
				continue;
			case 2:
				cutin "EP14_etran3",1;
				mes "Laphine硬币？这是新东西吗？家园树现在会产硬币了？";
				next;
				cutin "",255;
				mes "["+ strcharinfo(0) +"]";
				mes "不，不会发生这种事。我只是举了个糟糕的例子。";
				continue;
			}
			break;
		}
		cutin "EP14_etran1",1;
		mes "啊，家园树叶。没错。家园树正常生长就会长出叶子。这是其他植物没有的。";
		next;
		cutin "",255;
		mes "["+ strcharinfo(0) +"]";
		mes "家园树叶是什么样的？有没有颜色之类的独特特征？";
		next;
		cutin "EP14_etran3",1;
		mes "[Etran]";
		mes "我只是听说过，从没亲眼见过。听说生命力旺盛的家园树会呈金色。";
		next;
		mes "[Etran]";
		mes "除此之外我一无所知。但如果是真正的家园树叶，我不可能认不出来。家园树叶的生命反应非常惊人。";
		next;
		cutin "EP14_etran4",1;
		mes "[Etran]";
		mes "如果你带来一片完全成熟的家园树叶，我就不会放弃。你无法伪造Robert的成功。";
		next;
		mes "[Etran]";
		mes "另外，我还有一个请求。";
		next;
		cutin "EP14_bif03",3;
		mes "[Etran]";
		mes "这条项链……请把它交给Robert。告诉他我从未放弃，我们必须竭尽全力……";
		next;
		cutin "EP14_etran01",1;
	mes "^000099Etran 的身影开始消散。反应器的力量一定减弱了。^000000";
		next;
		cutin "EP14_etran0",1;
	mes "^000099Etran 的身影消失时，他的项链掉在草地上。^000000";
		next;
		cutin "EP14_bif03",3;
	mes "^000099你获得了一条破旧的项链。感觉有未知的生命能量正在进入身体。^000000";
		changequest 12297,12298;
		ep14_2_etran = 35;
		getitem 6539,1;// Old_Left_Lapine
		getexp 120000,80000;
		next;
		mes "^000099You gained experience points and job experience points.^000000";
		cutin "",255;
		close;
	}
}


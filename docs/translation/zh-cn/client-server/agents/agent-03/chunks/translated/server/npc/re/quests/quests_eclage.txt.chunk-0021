		mes "[Etran]";
		mes "那么，我该走了。也请代我向建造这台不可思议机器的人表达谢意。";
		next;
		cutin "",255;
		delitem 6540,1;// Golden_Leaf
		delitem 6539,1;// Old_Left_Lapine
		changequest 12300,12301;
		ep14_2_etran = 41;
		getitem 2915,1;// Ettlang_Keepsake
	mes "^000099收到了 Etran 的遗物。可以装备它，但^ff0000要发挥全部力量，^000099之后还需要 Hiel 的帮助。^000000";
	}
	else if (ep14_2_etran > 39)
	mes "^000099这里是与 Etran 建立交流的墓地。他最后的日子一定是在附近度过的。^000000";
	else
	mes "^000099这里有一座与高塔格格不入的墓地。它破败不堪，已经很难看出这些是谁的坟墓。^000000";
	close;
}


ecl_in04,105,216,4	script	Hiel's Workshop#pa0829	HIDDEN_NPC,{
	if (checkweight(1201,1) == 0)
		mes "看来物品种类太多了。减少种类后再试。";
	else if ((MaxWeight - Weight) < 10000)
		mes "看来我带的东西太重了。减轻负重后再试。";
	else if (ep14_2_etran < 18)
		mes "^000099这是一个摆满奇怪物品的工作室。^000000";
	else if (ep14_2_etran == 18)
		mes "^000099It looks like Hiel's preliminary rift reactor. It seems like it could be operated upon touching it.^000000";
	else if (ep14_2_etran == 19) {
		mes "^000099Dark Debris 一放到 Hiel 布置的中央，一切就陷入黑暗，奇怪的声音凭空出现。^000000";
		sc_start SC_BLIND,120000,0;
		next;
		cutin "EP14_robert0",1;
		mes "[????]";
		mes "估计家园树的恢复至少需要200年。在此期间，这片土地上80%的生命形式会被摧毁。";
		next;
		mes "[????]";
		mes "然而，如果不恢复家园树，只照顾土地上的生命，没有维持生命的基本资源，最终必然走向毁灭。那样甚至撑不过400年。";
		next;
		mes "[????]";
		mes "我们要接受200年的牺牲，享受长久和平吗？还是为了维持生命工作400年后走向灭亡？";
		next;
		mes "[????]";
		mes "我们请求长老议会的智慧。";
		next;
		cutin "",255;
		mes "[A low voice]";
		mes "我们会先考虑你的报告。议会的决定是……（静电……静电）";
		next;
		sc_end SC_BLIND;
		mes "^000099噪音干扰了声音，当前时间恢复了。^000000";
		ep14_2_etran = 20;
	}
	else if (ep14_2_etran == 20)
		mes "^000099It looks like Hiel's preliminary rift reactor. It seems like it could be operated upon touching it.^000000";
	else if (ep14_2_etran < 36)
		mes "^000099Hiel 似乎还在继续改进。现在触碰它似乎不太合适。^000000";
	else if (ep14_2_etran == 36) {
		cutin "EP14_robert01",1;
		mes "[Robert]";
		mes "Hmm?";
		mes "难道是……上次的那些家伙？";
		next;
		cutin "EP14_robert5",1;
		mes "[Robert]";
		mes "说起来，"+ strcharinfo(0) +"，你把我留在家园树前后就消失了！";
		next;
		mes "^000099Robert 能如此清晰地出现真是太好了。但他似乎很生气，因为上次交流被中断。先让他抓住我衣领的手冷静下来吧。^000000";
		next;
		select("你听我说……:这是误会！:这很难解释。:请给我一点时间说明！");
		cutin "EP14_robert1",1;
		mes "[Robert]";
		mes "嗯？你右手里的项链……";
		next;

					mes "这 3 个问题不该这么难……";
					next;
					mes "[地图专家]";
					mes "你看起来很聪明，为什么不再试一次测验？";
					break;
				case 2:
					callsub L_Info;
					mes "[地图专家]";
					mes "专家的讲解怎么样？现在我要给你一个小测验。全部答对才能通过。想试试吗？";
					break;
				case 3:
					mes "[地图专家]";
					mes "我是最后一位专家！别放弃！准备好后再来找我！";
					close;
				}
			}
			close;
		case 2:
			mes "[地图专家]";
			mes "你都不试就要放弃？但我是最后一位专家！别放弃！准备好后再来找我！";
			close;
		}
		close;
	}
	mes "[地图专家]";
	mes "想向我学习，先获得^006400纪念地下城^000000的认可。";
	close;

L_Info:
	mes "[地图专家]";
	mes "^006400地图^000000显示世界旅行所需信息，例如地形、主要城镇和原野。它是非常重要的工具！";
	next;
	mes "[地图专家]";
	mes "因此，了解^006400地图^000000比其他任何事都重要。";
	next;
	mes "[地图专家]";
	mes "点击屏幕左上方写着^006400地图^000000的按钮即可打开地图。";
	next;
	mes "[地图专家]";
	mes "点击^006400地图^000000按钮后，米德加尔特全地图会占满屏幕。";
	mes "将鼠标^0000FF悬停在特定区域^000000上，可以查看^006400名称^000000和区域详情。";
	next;
	mes "[地图专家]";
	mes "地图右下方有一幅^006400波利图案^000000。";
	mes "点击它或按 ^006400TAB^000000 快捷键，即可查看各种信息。";
	next;
	mes "[地图专家]";
	mes "首先，你可以查看各区域怪物的^006400名称^000000和^006400等级^000000，方便决定去哪里狩猎。";
	next;
	mes "[地图专家]";
	mes "其次，你可以找到各种^006400地下城^000000及其^006400入口位置^000000。";
	mes "还可以查看该区域的怪物及其^006400等级^000000，信息以红色显示，便于查找。";
	mes "";
	next;
	mes "[地图专家]";
	mes "如果想关闭地图，有两种方法。";
	mes "可以按 ^006400CTRL + %^000000 或 ^006400ESC^000000 快捷键。";
	mes "或者点击地图右上角的 ^006400X^000000 按钮，返回正常游戏画面。";
	next;
	mes "[地图专家]";
	mes "目前我们无法看到米德加尔特之外的地方，但据说外面存在许多未知世界。";
	next;
	return;
}

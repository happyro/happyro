			default:
				break;
			}
			mes "[The Anonymous One]";
			mes "10. 选择通常对刺客帮助最小的卡片。";
			next;
			if (select("小恶魔卡:长老树精卡:骷髅士兵卡:哥布灵卡") == 2)
				.@assassin_t += 10;
			break;
		}
		if (ASSIN_Q2 == 3) {
			next;
			mes "[The Anonymous One]";
			mes "哼。";
			mes "不知怎么的，你";
			mes "向我展示了";
			mes "很大的努力。";
			next;
			mes "[The Anonymous One]";
			mes "让我看看……";
			mes "你的得分是";
			mes "" + .@assassin_t + "分……";
			if (.@assassin_t > 80) {
				ASSIN_Q2 = 5;
				changequest 8002,8003;
				mes "做得好。";
				mes "你通过了。";
				next;
				mes "[The Anonymous One]";
				mes "不过还有另一项测试等着你。进入下一区域后会收到指示……";
				close;
			}
			else {
				ASSIN_Q2 = 4;
				mes "这意味着你失败了！";
				next;
				mes "[The Anonymous One]";
				mes "凭这个分数怎么能成为刺客？继续训练，准备好后再回来。";
				next;
				mes "[The Anonymous One]";
				mes "你可以向处理申请的凯询问建议。";
				next;
				mes "[The Anonymous One]";
				mes "你也可以使用这个代码：^880000iro.ragnarokonline.com^000000。据说这些文字连接着庞大的异世界知识……";
				close2;
				warp "in_moc_16",19,76;
				end;
			}
		}
		else if (ASSIN_Q2 == 4) {
			next;
			mes "[The Anonymous One]";
			mes "你展现了";
			mes "很大的努力……";
			next;
			mes "[The Anonymous One]";
			mes "让我看看……";
			mes "你的得分是";
			mes "" + .@assassin_t + "分……";
			if (.@assassin_t > 80) {
				ASSIN_Q2 = 5;
				changequest 8002,8003;
				next;
				mes "[The Anonymous One]";
				mes "这次你没有失败！但还没结束。前方还有另一项测试，继续前进后会得到下一项试炼的说明。";
				close;
			}
			else {
				ASSIN_Q2 = 4;
				mes "你失败了！";
				next;
				mes "[The Anonymous One]";
				mes "你的资格远远不够。怎么能妄想成为刺客？！";
				next;
				mes "[The Anonymous One]";
				mes "真惊讶你居然能成为盗贼。走开，弄清自己在做什么后再回来。";
				next;
				mes "[The Anonymous One]";
				mes "哼，如果你真的毫无头绪，我就给你一点建议。";
				next;
				mes "[The Anonymous One]";
				mes "去问负责你测试申请的凯，也许他能帮你。";
				next;
				mes "[The Anonymous One]";
				mes "你也可以利用古老代码^3355FFiro.ragnarokonline.com^000000。据说这些文字连接着庞大的异世界知识……";
				close2;
				warp "in_moc_16",19,76;
				end;
			}
		}
	}
	else {
		mes "[The Anonymous One]";
		mes "……我会继续观察你。";
		close;
	}
}

in_moc_16,21,165,2	script	Standby Room#ASNTEST	725,{
	end;

OnInit:
	//disablenpc "Standby Room#ASNTEST";
	hideonnpc "Standby Room#ASNTEST";
	waitingroom "Standby Room",10,"Standby Room#ASNTEST::OnStartArena",1;
	enablewaitingroomevent;
	end;

OnStartArena:
	warpwaitingpc "in_moc_16", 66, 151;
	attachrid($@warpwaitingpc[0]);
	if (ASSIN_Q2 < 5) {
		warpchar "in_moc_16",20,145,getcharid(0);
		end;
	}
	donpcevent "Beholder#ASNTEST::OnEnable";
	donpcevent "Keeper of the Door#ASN::OnDisable";
	set getvariableofnpc(.DisableTraps,"Beholder#ASNTEST"),0;
	disablewaitingroomevent;
	end;

OnStart:
	enablewaitingroomevent;
	end;
}

in_moc_16,21,165,2	script	Test Guide#ASN	725,4,4,{
	end;

OnTouch_:
	if (ASSIN_Q2 < 5) {
		mes "[Barcardi]";
		mes "不通过笔试就不能参加下一项试炼。你最好去和匿名者谈谈……";
		close2;
		warp "in_moc_16",19,76;
		end;
	}
	if (ASSIN_Q == 1 && ASSIN_Q2 == 5) {
		mes "[Barcardi]";
		mes "" + strcharinfo(0) + "...";
		mes "你通过测试了……？";
		next;
		mes "[Barcardi]";
		mes "说实话，我想不附加任何条件就让你转职。太多可悲的人连成为刺客的基础知识都没有……";
		next;
		mes "[Barcardi]";
		mes "我们必须保持刺客的尊严，成为真正伟大的人！遗憾的是，太多蠢货毫无自尊。";
		next;
		mes "[Barcardi]";
		mes "所有刺客都必须尊重被自己杀死的敌人、流下的鲜血，最重要的是保持尊严！";
		next;
		mes "[Barcardi]";
		mes "好。下一项试炼会测试你迅速找到目标的能力。";
		next;
		mes "[Barcardi]";
		mes "如果你想成为刺客，我们必须确认你能否瞬间分辨敌我。";
		next;
		mes "[Barcardi]";
		mes "测试的主要目标是尽可能找到并杀死名为^008800转职目标^000000的怪物。";
		next;
		mes "[Barcardi]";
		mes "你必须至少杀死";
		mes "6只^008800转职目标^000000怪物。它们混在外观相似的怪物中，所以要小心……";
		next;
		mes "[Barcardi]";
		mes "如果失败，就必须重新开始测试。去我上面的房间";
		mes "那里会把你传送到测试大厅。";
		next;
		mes "[Barcardi]";
		mes "一次只能有一人参加测试，如果有人正在测试，你必须等他完成。";
		close;
	}
	else {
		mes "[Barcardi]";
		mes "Hey, don't be too hard";
		mes "照顾好自己。加油！";
		next;
		mes "[Barcardi]";
		mes "嗯，如果你累了，我可以带你回来。当然，离开后必须重新参加转职测试。你想怎么做？";
		next;
		if (select("继续！:暂时退出转职测试。") == 1) {
			mes "[Barcardi]";
			mes "明智的选择！";
			mes "记住，你必须";
			mes "找到并杀死";
			mes "6只^008800转职目标^000000怪物！";
			mes "祝你好运！";
			close;
		}
		mes "[Barcardi]";
		mes "好吧……";
		mes "我想你";
		mes "可以休息一下……";
		close2;
		ASSIN_Q = 0;
		ASSIN_Q2 = 0;
		changequest 8003,8000;
		warp "in_moc_16",19,13;
		end;
	}
}


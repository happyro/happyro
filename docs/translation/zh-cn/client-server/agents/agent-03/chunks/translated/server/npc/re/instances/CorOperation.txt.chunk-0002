1@cor,172,223,3	script	Elena Volkova#171_cmd_1	4_F_ELENA,{
	cutin "162elena_01",2;
	mes "[Elena Volkova]";
	mes "我一直在等你。我找到那个疯狂研究员了。";
	mes "其他人已经包围了那里。";
	next;
	mes "[Elena Volkova]";
	mes "要如此熟练地控制这种机器，艾莉米娜一定就在附近。";
	next;
	mes "[Elena Volkova]";
	mes "我可以处理这台机器，但那样就没法抓住艾莉米娜。";
	next;
	mes "[Elena Volkova]";
	mes "如果你处理机器，其他搜索队会负责寻找艾莉米娜。";
	next;
	cutin "162elena_02",2;
	mes "[Elena Volkova]";
	mes "反叛军队伍配合默契，这项工作最适合我们。那件事交给我们吧。";
	next;
	cutin "162elena_01",2;
	mes "[Elena Volkova]";
	mes "我们将在9点钟方向进入。我确认那里没有人藏身，也封锁了出口。";
	next;
	mes "[Elena Volkova]";
	mes "准备进入时给我信号。我会通知队伍放你进去。";
	next;
	if (select("发出信号。:还没准备好。") == 2) {
		mes "[Elena Volkova]";
		mes "是的，那是危险的对手。抱歉要让你独自战斗，准备好后告诉我。";
		close3;
	}
	cutin "162elena_02",2;
	mes "[Elena Volkova]";
	mes "好，小心！我打开了传送门，你可以进去。这是单向入口，务必做好准备！";
	close2;
	cutin "",255;
	viewpointmap 'map$,2,172,223,5,0xFFFFFF;
	if ('step == 2) {
		'step = 3;
		donpcevent instance_npcname("#171_cor_control") + "::OnStory03";
	}
	end;
}

1@cor,138,221,3	script	Elena Volkova#171_cmd_2	4_F_ELENA,{
	if ('mode) {
		if (isbegin_quest(16363) == 0) {
			cutin "162elena_01",2;
			mes "[Elena Volkova]";
			mes "哦，你这次也辛苦了。真够棘手！我们还要用那块废铁多久才能让它停下？";
			next;
			cutin "ep171_elyumina02",0;
			mes "[Elyumina]";
			mes "我不是说过别叫它废铁吗？！你这个笨蛋！";
			next;
			cutin "162elena_01",2;
			mes "[Elena Volkova]";
			mes "好好，起初它不是废铁。但既然我们抓住了它，现在就是废铁。总之你辛苦了，回去休息吧。";
			next;
			cutin "",255;
			if (select("回去。:再待一会儿。") == 2) {
				mes "[Elena Volkova]";
				mes "好的，准备出去时告诉我。";
				close3;
			}
			cutin "162elena_02",2;
			mes "[Elena Volkova]";
			mes "干得好。明天还要再做一次，真有意思。明天见。";
			setquest 16363;
			getitem 25723,1;
			getitem 25669,5;
			close2;
			warp "sp_cor",111,125;
		}
		end;
	}
	if (isbegin_quest(16354) == 1 && checkquest(16376,HUNTING) == 2) {
		cutin "162elena_02",2;
		mes "[Elena Volkova]";
		mes "干得好，" +strcharinfo(0)+ "。行动成功了！";
		mes "我也逃走了。你击倒那块巨大废铁时我真狼狈。不过我还捕获了某种迷人的东西。";
		next;
		cutin "ep171_elyumina02",0;
		mes "[Elyumina]";
		mes "废铁！这是杰作！我伟大的孩子！";
		mes "你！你……伤害了我的孩子！你毁了我的孩子！";
		next;
		cutin "162elena_02",2;
		mes "[Elena Volkova]";
		mes "你刚才把那些废铁叫孩子？";
		mes "你的孩子大概很优秀。那么为你孩子的错误付出代价吧。";
		next;
		cutin "162elena_01",2;
		mes "[Elena Volkova]";
		mes "你现在打算做什么，" + strcharinfo(0) + "？";
		next;
		if (select("我马上回去。:我再待一会儿") == 2) {
			mes "[Elena Volkova]";
			mes "好的，准备出去时告诉我。";
			close3;
		}
		mes "[Elena Volkova]";
		mes "干得好。我们会清理这里，你可以休息一下。我要审问她。休息后再回来找我。";
		completequest 16354;
		erasequest 16376;
		setquest 16357;
		setquest 16377;
		close2;
		warp "sp_cor",176,169;
	}
	end;
}


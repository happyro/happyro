	npctalk "接触化学毒物会使毒性扩散。你已经踩到了，快躲开！",instance_npcname("Rebellion#" + strnpcinfo(2));
	.@event$ = instance_npcname(strnpcinfo(0)) + "::OnPoisonKill";

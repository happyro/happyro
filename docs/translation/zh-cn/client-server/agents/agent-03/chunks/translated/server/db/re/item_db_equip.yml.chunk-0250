      bonus bMaxHP,.@r*10;
      bonus2 bAddSize,Size_All,1;
      bonus2 bMagicAddSize,Size_All,1;
      if (.@r>=7) {
         bonus2 bAddSize,Size_All,1;
         bonus2 bMagicAddSize,Size_All,1;
      }
      if (.@r>=9) {
         bonus2 bAddSize,Size_All,1;
         bonus2 bMagicAddSize,Size_All,1;
      }

//===== Compatible With: ===================================== 
//= rAthena Project
//===== Description: ========================================= 
//= Job Change to Acolyte Class
//===== Additional Comments: ================================= 
//= 1.0 First Version. [Kisuka]
//= 1.1 Added back the npcs used for the priest quest.
//= 1.2 Added support for Baby classes. [Euphy]
//============================================================ 
prt_church,184,41,4	script	Cleric#aco	60,{
	if (Upper == 1) {
		if (ADVJOB == Job_High_Priest || ADVJOB == Job_Champion) {
			if (Class == Job_Novice_High) {
				mes "[Father Mareusis]";
				mes "啊，我感觉你经历过";
				mes "前世。进入英灵殿前，你一定学到了很多。";
				next;
				if (!callfunc("F_CanChangeJob")) {
					mes "[Father Mareusis]";
					mes "遗憾的是，我认为你还没准备好成为服事。请先学完所有基础技能。";
					next;
					mes "[Father Mareusis]";
					mes "在此期间，";
					mes "我会等到";
					mes "你准备好。";
					mes "愿上帝";
					mes "与你同在。";
					close;
				}
				mes "[Father Mareusis]";
				mes "那么，欢迎你";
				mes "从英灵殿回来，祝你";
				mes "新生命旅程";
				mes "好运。";
				next;
				skill "NV_TRICKDEAD",0,SKILL_PERM;
				jobchange Job_Acolyte_High;
				skill "AL_HOLYLIGHT",1,SKILL_PERM;
				mes "[Father Mareusis]";
				mes "现在出发，寻找需要你帮助的人。愿上帝照亮你的道路。";
				close;
			}else{
				mes "[Father Mareusis]";
				mes "现在出发寻找需要你帮助的人。愿上帝指引你的道路。";
				close;
			}
		}else{
			mes "[Father Mareusis]";
			mes "我感觉你经历过前世。进入英灵殿前，你一定学到了很多。";
			next;
			mes "[Father Mareusis]";
			mes "但我能看出你不适合成为服事。请记住前世的自己，寻找你的道路。";
			close;
		}
	}
	mes "[Father Mareusis]";
	mes "你想寻求什么？";
	next;
	switch(select("转职为服事。:询问服事要求。:算了。")) {
	case 1:
		mes "[Father Mareusis]";
		if(BaseJob != Job_Novice) {
			if(BaseJob == Job_Acolyte)
				mes "今天还好吗？看你的服装就知道你已经是服事。你不是在开玩笑吧？";
			else
				mes "抱歉，但看来你已经有自己的职业了，对吧？";
			close;
		}else{
			mes "你真的想成为上帝的仆人吗？";
			mes "让我看看你是否准备好了……嗯……";
			next;
			if (!callfunc("F_CanChangeJob")) {
				mes "[Father Mareusis]";
				mes "天啊？！你还没完成基础修行？！路还很长！提升职业等级后再来！";
				close;
			}
			mes "[Father Mareusis]";
			mes "嗯……你的职业等级够了……";
			mes "很好。现在我授予你成为服事的资格。";
			next;
			mes "[Father Mareusis]";
			mes "永远记得感谢一直照顾我们的上帝。在混乱和困难时期，以坚定信仰面对苦难。";
			callfunc "Job_Change",Job_Acolyte;
			getitem 1545,1;	// N_Mace
			next;
			mes "[Father Mareusis]";
			mes "最后，真诚恭喜你坚持通过苦修试炼。";
			close;
		}
	case 2:
		mes "[Father Mareusis]";
		mes "你想成为服事吗？";
		mes "那么，你必须完成以下要求，把它们当作上帝给予的修行。";
		next;
		mes "[Father Mareusis]";
		mes "首先，你必须达到新手职业等级9，并学会所有基础技能。";
		mes "这是最基本的要求，要把它当作自我训练。";
		next;
		mes "[Father Mareusis]";
		mes "满足要求后再回来。届时你就能获得传播上帝旨意的神圣职业。";
		close;
	case 3:
		close;
	}
}


prt_fild03,365,255,2	script	Ascetic#aco	89,{
	mes "[Father Rubalkabara]";
	if (BaseJob == Job_Novice) {
		if (job_acolyte_q == 6) {
			mes "请保重。你抵达普隆德拉圣堂时，他们应该已经知道你见过我。";
			next;
			mes "[Father Rubalkabara]";
			mes "我已派信鸽送信，希望它能安全抵达……";
			close;
		}
		if (job_acolyte_q != 0) {
			if (job_acolyte_q == 2) {
				mes "哦……？你一定是想成为服事的人。我已收到圣堂消息，说你可能会来。";
				next;
				mes "[Father Rubalkabara]";
				mes "你的名字是" + strcharinfo(0) +"，对吧？很好，谢谢你来看我。";
				next;
				mes "[Father Rubalkabara]";
				mes "我相信Mareusis修士已告诉你许多服事的事。普隆德拉圣堂也有很多热心的人。";
				next;
				mes "[Father Rubalkabara]";
				mes "看来我没什么需要教你的。而且你们这一代人大概不愿听我这个老人的话。哈哈哈～";
				next;
				mes "[Father Rubalkabara]";
				mes "不过，教训可能来自意想不到的地方。上帝喜欢用奇特方式教导孩子。你会看到的。";
				next;
				mes "[Father Rubalkabara]";
				mes "我会发消息告诉他们你来过。现在你可以回普隆德拉圣堂了。";
				next;
				mes "[Father Rubalkabara]";
				mes "再会。";
				close2;
				savepoint "prt_fild03",361,255,1,1;
				set job_acolyte_q,6;
				end;
			}
			else {
				mes "哦……";
				mes "你是";
				mes "服事申请者吗……？";
				mes "让我看看……";
				next;
				mes "[Father Rubalkabara]";
				mes "你的名字是" + strcharinfo(0) +"？";
				mes "我想你的名字";
				mes "不在名单上。嗯……";
				next;
				mes "[Father Rubalkabara]";
				mes "你为什么不回普隆德拉圣堂再确认一次？";
				close;
			}
		}
		else {
			mes "嗯？你怎么来这里？对你这样的新手来说，这里很危险！";
			close;
		}
	}
	else if (BaseJob == Job_Acolyte) callfunc "F_FatherRub";
	else {
		if (BaseJob == Job_Priest) {
			mes "你好。";
			next;
			mes "[Father Rubalkabara]";
			mes "欢迎来到深处。坐下来和我思考上帝的讯息吧。这里很美，尽管宁静中伴随着危险……";
			close;
		}
		else {
			mes "哦呵……";
			mes "你来深处训练吗？还是只是个流浪者？";
			next;
			mes "[Father Rubalkabara]";
			mes "无论你是谁，请保重。这里的怪物外表可爱，力量却惊人。";
			close;
		}
	}
}

moc_fild07,41,355,4	script	Ascetic#2aco	95,{
	mes "[Mother Mathilda]";
	if (BaseJob == Job_Novice) {
		if (job_acolyte_q == 7) {
			mes "我会派信鸽前往普隆德拉圣堂。你回去时，那里的祭司应该已经收到我的消息。";
			next;
			mes "[Mother Mathilda]";
			mes "我会向上帝祈祷，希望你早日成为服事。";
			close;
		}
		if (job_acolyte_q != 0) {
			if (job_acolyte_q == 3) {
				mes "啊，你一定是服事申请者。真诚欢迎你。";
				next;
				mes "[Mother Mathilda]";
			mes "你叫什么？" + strcharinfo(0) +"？让我看看……啊，你在我的名单上。";
				next;
				mes "[Mother Mathilda]";
			mes "我会向圣堂发消息，确认" + strcharinfo(0) +"来见过我并完成了苦修。";
				next;
				mes "[Mother Mathilda]";
				mes "请回普隆德拉圣堂，和负责的祭司谈谈。";
				close2;
				savepoint "moc_fild07",35,355,1,1;
				set job_acolyte_q,7;
				end;
			}
			else {
				mes "啊……！";
				mes "你一定是";
				mes "服事申请者。";
				mes "真诚欢迎你。";
				next;
				mes "[Mother Mathilda]";
				mes "你叫什么名字？";
			mes "" + strcharinfo(0) +"？让我看看……";
				next;
				mes "[Mother Mathilda]";
				mes "嗯……";
				mes "看来你的名字";
				mes "不在名单上……";
				next;
				mes "[Mother Mathilda]";
				mes "也许你应该回普隆德拉圣堂，再次确认苦修试炼的地点。";
				close;
			}
		}
		else {
			mes "...";
			close;
		}
	}
	else if (BaseJob == Job_Acolyte) callfunc "F_MotherMart";
	else {
		if (BaseJob == Job_Priest) {
			mes "你好～";
			next;
			mes "[Mother Mathilda]";
			mes "你的修行进展如何？希望你享受生活在上帝恩典中的日子。";
			close;
		}
		else {
			mes "愿上帝";
			mes "与你同在……";
			close;
		}
	}
}

prt_fild00,208,218,6	script	Ascetic#3aco	98,{
	mes "[Father Yosuke]";
	if (BaseJob == Job_Novice) {
		if (job_acolyte_q == 8) {
			mes "什么？";
			next;
			mes "[Father Yosuke]";
			mes "你还有什么事？！没有！现在回圣堂去！";
			close;
		}
		if (job_acolyte_q != 0) {
			if (job_acolyte_q == 4) {
				mes "嘿。";
				mes "不管你是谁，";
				mes "看起来像个";
				mes "服事申请者。";
				mes "对吧？";
				next;
				mes "[Father Yosuke]";
				mes "不错，不错。你很好地通过了苦修试炼。";
				mes "你叫什么名字？";
				next;
				mes "[Father Yosuke]";
			mes "" + strcharinfo(0) +"，嗯？";
				next;
				mes "[Father Yosuke]";
			mes "好。我会向圣堂发消息，说" + strcharinfo(0) +"来见过我。";
				next;
				mes "[Father Yosuke]";
				mes "现在回圣堂，完成服事转职吧，小子。";
				close2;
				savepoint "prt_fild00",206,230,1,1;
				set job_acolyte_q,8;
				end;
			}
			else {
				mes "Hey.";
				mes "你看起来像服事申请者。对吗？";
				next;
				mes "[Father Yosuke]";
				mes "很不错，你从普隆德拉一路来到这里。你叫什么，小子？";
				next;
				mes "[Father Yosuke]";
			mes "" + strcharinfo(0) +"，嗯？你的名字为什么不在名单上？";
				next;
				mes "[Father Yosuke]";
				mes "你可能弄错了。回圣堂去，和主教确认。";
				close;
			}
		}
		else {
			mes "你……";
			mes "新手。";
			mes "有什么";
			mes "想告诉我的吗？";
			close;
		}
	}
	else if (BaseJob == Job_Acolyte) callfunc "F_FatherYos";
	else {
		if (BaseJob == Job_Priest) {
			mes "嘿……";
			next;
			mes "[Father Yosuke]";
			mes "愿意的话，来和我一起坐下冥想伟大真理。上帝的威严确实令人敬畏……";
			close;
		}
		else {
			mes "你有什么要说的吗？不过遗憾的是，";
			mes "我不作任何回答。";
			close;
		}
	}
}

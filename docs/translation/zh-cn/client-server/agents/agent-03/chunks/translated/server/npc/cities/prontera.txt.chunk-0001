prt_in,175,50,0	script	Library Girl#pront	71,{
	mes "[图书馆女孩艾伦]";
	mes "在普隆德拉图书馆东馆，我们提供按属性整理生物的怪物百科。还有商人和铁匠技能的书籍。";
	mes "哦~！图书馆另一馆也有许多有趣读物！有机会的话，不妨去看看。";
	close;
}

prt_in,47,141,0	script	An Old Man#pront	56,{
	mes "[老人]";
	mes "普隆德拉下水道长期无人管理。现在那里到处都是^000077盗虫^000000！";
	next;
	mes "[老人]";
	mes "这些盗虫会迅速抓走地上的物品，然后带着逃跑……比蟑螂还烦人！！";
	close;
}

prt_in,26,31,0	script	An Old Man#2pront	54,{
	mes "[老人]";
	mes "不知道你信不信，但我在^000077下水道^000000里见过最奇怪的东西……";
	next;
	mes "[老人]";
	mes "我在三层训练了很久，对那里无所不知。但当我终于去了四层……";
	next;
	mes "[老人]";
	mes "在那里，我看到一道闪烁的光。它完全吸引了我，我走近查看。那一定是某种美丽妖精……";
	next;
	mes "[老人]";
	mes "但当我";
	mes "靠近后，";
	mes "才发现那是";
	mes "一只^000077盗虫^000000！";
	next;
	mes "[老人]";
	mes "我从没见过会发光的盗虫！天啊，真是永远有新鲜事……";
	close;
}

prt_in,180,20,2	script	Bartender#pront	61,{
	mes "[酒保]";
	mes "唉……来普隆德拉的人越来越多，";
	mes "我的生意越来越好。不过……";
	mes "我很难保持充足的食材库存。";
	next;
	mes "[酒保]";
	mes "如你所见，城外怪物数量大增，导致供应商无法按时送货。";
	mes "我不能用普通食材制作超棒菜单，因为它们需要特殊材料！";
	next;
	mes "[酒保]";
	mes "所以我一直联系顶尖猎人寻找新鲜特殊的食材。";
	mes "但最近需求已经超过供应。";
	next;
	mes "[酒保]";
	mes "没有我的特色菜单‘脆脆酸’和‘香香美味’，生意就无法维持……*叹气*";
	while(1) {
		next;
		switch(select("‘脆脆酸’？:‘香香美味’？:取消")) {
		case 1:
			mes "[酒保]";
			mes "脆脆酸的基本食材是沙漠蚂蚁地狱里的蚂蚁。";
			mes "据说蚂蚁数量大增、变得更暴力，所以没人想进去。";
			next;
			mes "[酒保]";
			mes "*叹气*……恐怕我的生意时日无多了。";
			continue;
		case 2:
			mes "[酒保]";
			mes "香香美味的基本食材是西边森林某处的蚱蜢。没错，这是最畅销的菜单。";
			mes "据说它们变得非常暴力，蜜蜂也在那里筑巢，所以没人想进去。";
			next;
			mes "[Bartender]";
			mes "*Sigh*...I am afraid that my business days are numbered now.";
			continue;
		case 3:
			mes "[酒保]";
			mes "保重~。";
			close;
		}
	}
	end;

}

prt_in,173,24,2	script	Shevild#pront	85,{
	mes "[Shevild]";
	mes "嘿，过来喝一杯吧！我有很多有趣故事要讲！";
	mes "我知道许多关于普隆德拉的事。我看过许多美景，也探索过城外的一些怪物巢穴。";
	next;
	if (select("你是怎么进入怪物巢穴的？:取消") == 1) {
		mes "[谢维尔德]";
		mes "我看起来像个醉汉，但可不只是表面这样。";
		mes "我曾进入那些地方，为猎人运送武器或递送各种东西。";
		mes "你可以把我当成普通送货员，";
		next;
		mes "[谢维尔德]";
		mes "但我很自豪自己的工作。你知道世界变得多艰难吗？";
		mes "无论工作多辛苦，我都不怕去做。";
		next;
		mes "[谢维尔德]";
		mes "总之，我就是这样探索了一些怪物巢穴之类的奇怪地方……";
		mes "这也是我坚持工作的原因。";
		mes "啊，我想起我进过迷宫和恐怖森林！";
		next;
		switch(select("迷宫？:恐怖森林？:取消")) {
		case 1:
			mes "[谢维尔德]";
			mes "是的。几天前，我跟着一群猎人进入了普隆德拉北部的神秘迷宫。";
			next;
			mes "[谢维尔德]";
			mes "他们说即使迷宫里充满强大怪物，也能获得大量稀有物品。";
			mes "于是我们去了，但一进去就被困在迷宫里。";
			next;
			mes "[谢维尔德]";
			mes "我们一直绕圈，最后决定离开。那真是个可怕的迷宫。";
			mes "但我下定决心，有一天一定要成功探索迷宫。";
			next;
			if (select("我该怎么去那里？:取消") == 1) {
				mes "[谢维尔德]";
				mes "嗯？你还没游览过普隆德拉外面吗？";
				mes "迷宫在普隆德拉北部的森林里。去森林西北侧看看。";
				close;
			}
			mes "[Shevild]";
			mes "是啊，独自冒险时要小心~";
			close;

		case 2:
			mes "[谢维尔德]";
			mes "从普隆德拉向东北出城，就会到达宁静的遗迹。我不久前去过那里，给牧师送东西。";
			mes "前往遗迹要经过一片森林，里面到处是猴子和浣熊。";
			next;
			mes "[谢维尔德]";
			mes "注意，森林不是野餐的地方。如果把东西掉在地上，猴子会从不知哪里冒出来，拿走你所有财物。";
			next;
			if (select("我该怎么去那里？:取消") == 1) {
				mes "[Shevild]";
				mes "没有道路直接通往遗迹。但向北走，再一直向东，就能到达。";
				mes "哦，前往遗迹的路上要小心，那里有些奇怪植物会无缘无故攻击路人。";
				close;
			}
			mes "[Shevild]";
			mes "是啊，独自冒险时要小心~";
			close;

		case 3:
			mes "[Shevild]";
			mes "是啊，独自冒险时要小心~";
			close;
		}
	}
	mes "[Shevild]";
	mes "随时欢迎回来~";
	close;
}

prt_in,177,20,2	script	TenSue#pront	97,{
	switch(rand(3)) {
	case 1:
		mes "[腾苏]";
		mes "什么……？";
		mes "已经厌倦在野外和地下城杀怪了吗？来吧……";
		next;
		mes "[腾苏]";
		mes "哈哈哈，看来你对自己的力量很有信心？嗯……为什么不加入公会？强者都这么做。";
		next;
		mes "[腾苏]";
		mes "不过我不认识什么公会，你得自己打听。结识联系人、建立关系，也就是社交。";
		next;
		mes "[腾苏]";
		mes "如果你不喜欢听命令，那为什么不自己创建公会？";
		close;

	case 2:
		mes "[腾苏]";
		mes "有一次我没有使用传送，徒步走到艾尔帕兰。路上怪物很多，非常危险！";
		next;
		mes "[腾苏]";
		mes "我差点死了！有些怪物一直跟着我，想杀我，尽管我什么也没做！太疯狂了。";
		next;
		mes "[腾苏]";
		mes "不过我觉得走风景路线很值得。沿途景色非常壮观。";
		next;
		mes "[腾苏]";
		mes "艾尔帕兰城也赏心悦目，有优雅建筑和浪漫运河。";
		next;
		mes "[腾苏]";
		mes "卡普拉公司的总部也在艾尔帕兰。你应该亲自去看看。";
		close;
	Default:
		mes "[腾苏]";
		mes "卢恩·米德加尔兹王国";
		mes "由仁慈善良的";
		mes "特里斯坦三世国王统治。";
		mes "";
		next;
		mes "[腾苏]";
		mes "卢恩·米德加尔兹的繁荣多亏了他。他说服人民欢迎外乡人进入普隆德拉，并与天津町、昆仑等外国建立贸易。";
		next;
		mes "[腾苏]";
		mes "但有时……";
		mes "很难相信他是如此聪明能干的领袖。";
		next;
		mes "[腾苏]";
		mes "毕竟我只有在他主持婚礼时见过他。即使没有婚礼，他也总在普隆德拉教堂附近闲逛！";
		next;
		mes "[腾苏]";
		mes "不过……";
		mes "当你恰好是整个国家的领主和统治者时，很多事都可以蒙混过关。";
		close;
	}
}

prt_in,177,18,2	script	Marvin#pront	80,{
	mes "[马文]";
	mes "无论是和异性搭讪，还是与怪物战斗，都离不开^333399技能^000000。";
	next;
	mes "[Marvin]";
	if (Sex == SEX_MALE)
		mes "关于如何和像我这样有魅力的女性聊天，我帮不了你太多，但可以告诉你一些战斗技能。";
	else

// Prontera
//============================================================
-	script	Guard#pront::prtguard	105,{
	mes "[普隆德拉卫兵]";
	mes "欢迎来到普隆德拉。";
	close;
}
prontera,223,99,1	duplicate(prtguard)	Guard#2pront	105
prontera,229,104,5	duplicate(prtguard)	Guard#3pront	105
prontera,47,339,5	duplicate(prtguard)	Guard#4pront	105

prontera,101,288,3	script	Shuger#pront	98,{
	mes "[舒格]";
	mes "在城市安全范围外，有一种粉色怪物叫^000077波利^000000。";
	next;
	mes "[舒格]";
	mes "波利外表可爱，不会主动伤人，但会把地上的物品吸收到身体里。";
	next;
	mes "[舒格]";
	mes "如果想捡地上的东西，要小心别被波利吃掉。不过……波利其实很弱……";
	next;
	mes "[舒格]";
	mes "绿色的^000077波波利^000000比波利更强。新手常因不了解它的力量而贸然攻击……所以要小心！";
	close;
}

prontera,54,240,6	script	Tono#pront	97,{
	mes "[托诺]";
	mes "你知道吗？";
	next;
	mes "[托诺]";
	mes "克里米的幼虫是法布尔。所以那些绿色的小虫子，其实就是你周围看到的粉紫色蝴蝶的幼体。";
	next;
	mes "[托诺]";
	mes "法布尔变成克里米前会经历蛹期，变成深紫色的茧，也就是我们所说的蛹。很简单吧？";
	next;
	mes "[托诺]";
	mes "还有一种怪物会经历巨大变化……波利奇。";
	next;
	mes "[托诺]";
	mes "波利奇小时候很可爱，长大后却变成那些巨大笨拙的波利克。真是尴尬的青春期。";
	close;
}

prontera,106,116,6	script	Merideth#pront	91,{
	mes "[梅丽德丝]";
	mes "休息日天气很好，我和家人去野餐。我们选了稍微僻静的地方，在那里我看到很有趣的东西……";
	next;
	mes "[梅丽德丝]";
	mes "那是一大群大黄蜂！更奇怪的是，它们全都由一只蜂后控制，服从她的每个命令。";
	next;
	mes "[梅丽德丝]";
	mes "它们也许只是虫子，但我觉得它们做得对。男人就该听我们女人的命令……我们才是正确的！";
	close;
}

prontera,160,133,2	script	YuPi#pront	102,{
	mes "[优皮]";
	mes "虽然许多怪物看起来相同，但要小心！相同基本形态的怪物也有不同变种。";
	next;
	mes "[优皮]";
	mes "有些怪物看起来和你遇到过的温顺弱小怪物一样，实际上可能野蛮凶猛！";
	next;
	mes "[优皮]";
	mes "可以通过体色区分这类怪物。越野蛮强大的怪物，颜色看起来越危险。";
	close;
}

prontera,149,202,2	script	YuNa#pront	700,{
	mes "[优娜]";
	mes "看啊……";
	mes "伟大的奥丁！";
	mes "智慧之神！";
	mes "战争之神！";
	next;
	mes "[优娜]";
	mes "在卢恩·米德加尔兹，我们侍奉奥丁，这位为获得智慧而牺牲一只眼睛的可怕神明。";
	next;
	mes "[优娜]";
	mes "我身后的雕像是伟大奥丁的雕像。不过很遗憾，它实在不像。";
	next;
	mes "[优娜]";
	mes "我是说，这座雕像和我们心中的奥丁完全不同。我想雕刻家发挥了太多艺术自由。";
	next;
	mes "[优娜]";
	mes "我敢打赌你第一次看到时会想：‘^3355FF哦，马上有个肌肉男^000000。’";
	next;
	mes "[优娜]";
	mes "但这座雕像明显不够强壮，也不够神圣，无法公平代表神明！也许给他加个光环？";
	close;
}

prontera,216,70,2	script	Strife#pront	48,{
	if (Class == Job_Novice) {
		if (event_prt_nov_dreamtalk == 0) {
			mes "[斯特莱夫]";
			mes "呼！";
			mes "天啊……";
			mes "我要成为";
			mes "最棒的骑士！";
			next;
			mes "[斯特莱夫]";
			mes "我知道，我知道……";
			mes "首先我要成为剑士。只要继续练习，我就能成为出色的剑士。然后……";
			next;
			mes "[斯特莱夫]";
			mes "我要成为最";
			mes "棒的骑士！";
			mes "这……这是我最珍贵的梦想。";
			next;
			mes "[Strife]";
			mes "猛击！";
			next;
			if (select("我也想变强！:嗯……你加油。") == 1) {
				set event_prt_nov_dreamtalk,1;
				mes "[斯特莱夫]";
				mes "哇……！";
				mes "太棒了！";
				mes "我们有着";
				mes "同一个梦想！";
				next;
				mes "[斯特莱夫]";
				mes "如果你想成为剑士，就去伊兹鲁德。在那里可以参加剑士转职考试。我第一次……惨败了。但我不会再失败！";
				next;
				mes "[斯特莱夫]";
				mes "训练！训练！必须继续训练！你也要变强！等我们都变强后，再见面吧！";
				close;
			}
			mes "[斯特莱夫]";
			mes "嘿嘿！我一定会的！‘勇敢的骑士斯特莱夫。’听起来很酷，对吧？";
			close;
		}
		else {
			mes "[斯特莱夫]";
			mes "战斗……！";
			mes "战斗 战斗 战斗！";
			close;
		}
	}
	else if (Class != Job_Novice) {
		if (event_prt_nov_dreamtalk == 1) {
			mes "[斯特莱夫]";
			mes "嘿……！";
			mes "你现在看起来不一样了。*喘气*你变得……^993333更强^000000了。哇，太酷了！";
			next;
			mes "[斯特莱夫]";
			mes "我好嫉妒！";
			mes "看来这意味着";
			mes "我现在必须";
			mes "更加努力训练！";
			next;
			set event_prt_nov_dreamtalk,2;
			getitem 2501,1; //Hood
			mes "[斯特莱夫]";
			mes "这个送给你，帮助你变得更强。我想感谢你为我树立了好榜样。";
			close;
		}
		else if (event_prt_nov_dreamtalk == 2) {
			mes "[斯特莱夫]";
			mes "战斗！战斗！";
			close;
		}
		mes "[斯特莱夫]";
		mes "呼！";
		mes "天啊……";
		mes "我要成为";
		mes "最棒的骑士！";
		next;
		mes "[斯特莱夫]";
		mes "我知道，我知道……";
		mes "首先我要成为剑士。只要继续练习，我就能成为出色的剑士。然后……";
		next;
		mes "[斯特莱夫]";
		mes "我要成为最";
		mes "棒的骑士！";
		mes "这……这是我最珍贵的梦想。";
		next;
		if (select("加油:别闹了，小鬼。") == 1) {
			mes "[斯特莱夫]";
			mes "是的，当然！有一天我会变得和你一样强！那时希望我们能一起训练！";
			close;
		}
		mes "[斯特莱夫]";
		mes "什么——？";
		mes "好吧！但我会继续训练，看看最后谁能笑到最后！";
		close;
	}
}

prontera,78,150,3	script	Dairenne#pront	90,{
	mes "[城镇女孩戴莲]";
	mes "啊……";
	mes "最近街道太拥挤了。*咳咳*看看这些灰尘，住在首都也不全是好事。总之，需要帮助吗？";
	next;
	if (select("交谈:取消") == 1) {
		mes "[城镇女孩戴莲]";
		mes "不知道你是否对派对或礼服感兴趣。嘿嘿。最近最热门的当然是那些色彩缤纷、奢华华丽的礼服。";
		next;
		mes "[城镇女孩戴莲]";
		mes "听说要获得如此耀眼的颜色，必须使用只能在梦罗克取得的染料。但我也听说价格高得难以想象。";
		next;
		mes "[城镇女孩戴莲]";
		mes "啊啊啊~我真希望能穿上那种礼服。哪怕只有一次……";
		close;
	}
	mes "[城镇女孩戴莲]";
	mes "诶~？你干嘛和我说话？真奇怪的人。";
	close;
}


//= 1.0 First version. [Euphy]
//============================================================

// Main Quest :: 2013_xmas_en
//============================================================
xmas,10,1,5	script	2013questreset2#xmas	10086,{
	if (callfunc("F_GM_NPC",1854,0) == 1) {
		setarray .@quests[0], 15055,15056,15057,15059,15060,15061,15062,15063,15064;
		for (set .@i,0; .@i<=getarraysize(.@quests); set .@i,.@i+1)
			if (isbegin_quest(.@i)) erasequest .@i;
	}
	end;
}

xmas,150,134,3	script	Union Commander Cliff	10086,{
	if (BaseLevel < 40) {
		mes "[单身联盟指挥官克里夫]";
		mes "不收菜鸟！！40 级以下不能加入单身联盟军！";
		close;
	}
	if (checkweight(1201,1) == 0 || MaxWeight - Weight < 1) {
		mes "^ff0000你负重过高。检查背包后再来找我。^000000";
		close;
	}
	set .@playtime, checkquest(15059,PLAYTIME);
	if (.@playtime == 0 || .@playtime == 1) {
		mes "- 24 小时后可以重复此任务。";
		close;
	} else if (checkquest(15059,PLAYTIME) > 1) {
		erasequest 15059;
		set xmas2013_01,0;
	}
	set .@que_allmem, isbegin_quest(15060) + isbegin_quest(15061) + isbegin_quest(15062) + isbegin_quest(15063) + isbegin_quest(15064);
	if (isbegin_quest(15057) == 1) {
		if (countitem(7909) < 10 || countitem(7910) < 10 || countitem(6682) < 10) {
			mes "[单身联盟指挥官克里夫]";
			mes "我们需要更多材料为单身联盟军举办圣诞派对！";
			next;
			mes "[单身联盟指挥官克里夫]";
			mes "从那些该死的浣熊那里带来^ff000010 块被偷的饼干、10 颗被偷的糖果和 10 袋销售物品^000000！";
			close;
		}
		mes "[单身联盟指挥官克里夫]";
		mes "你教训了浣熊欢呼队吗？哦！你带来了所有需要的物品。我们可以感受圣诞气氛了！";
		next;
		mes "[单身联盟指挥官克里夫]";
		mes "你带来的物品我全都要。作为回报，我会给你单身联盟军专属奖励。你-必-须-独-自-打-开！";
		next;
		mes "[Union Commander Cliff]";
		mes "享受节日吧！";
		mes "单身联盟军万岁！嘻嘻嘻哈哈哈哈！！";
		delitem 7909, countitem(7909); //Stolen_Cookie
		delitem 7910, countitem(7910); //Stolen_Candy
		delitem 6682, countitem(6682); //Bag_Of_Selling_Goods
		erasequest 15057;
		setquest 15059;
		getitem 22685,1; //Solo_Christmas_Gift
		specialeffect2 EF_MAGICALATTHIT;
		specialeffect2 EF_POTION2;
		specialeffect2 EF_ANGEL2;
		close;
	} else if (isbegin_quest(15056) == 1 && xmas2013_01 < 5) {
		mes "[单身联盟指挥官克里夫]";
		mes "你总共有 " + xmas2013_01 + " 个拆散情侣点数。";
		mes "至少拆散 5 对情侣后再回来找我！";
		close;
	} else if (isbegin_quest(15056) == 1 && xmas2013_01 > 4) {
		mes "[单身联盟指挥官克里夫]";
		mes "是的！你做到了！！越来越多人加入单身联盟军！！嘻嘻哈哈哈！胜利属于我们！！";
		erasequest 15056;
		setquest 15057;
		getitem 22686,5; //Solo_Cookie
		next;
		mes "[单身联盟指挥官克里夫]";
		mes "但是！！！我们忙着拆散情侣时，那些该死的浣熊欢呼队小鬼偷走了大部分物品。没有它们，我们无法感受圣诞气氛。";
		next;
		mes "[单身联盟指挥官克里夫]";
		mes "是时候惩罚他们，为单身联盟军夺回物品了！！";
		next;
		mes "[单身联盟指挥官克里夫]";
		mes "^ff0000>10块被偷的饼干、10颗被偷的糖果和10袋销售物品^000000应该足够举办派对了。去野外地图和地下城寻找浣熊！";
		next;
		mes "[Union Commander Cliff]";
		mes "带多了也没关系，我全都要！！";
		close;
	} else if (isbegin_quest(15055) == 0) {
		mes "[单身联盟指挥官克里夫]";
		mes "嘿，你！！对，就是你！你！！";
		next;
		mes "[单身联盟指挥官克里夫]";
		mes "我直截了当地问你。";
		mes "你一定是单身。我有这种感觉。对吧？！";
		next;
		if(select("- ……也许……？:什么！我有伴侣！！") == 2) {
			mes "[单身联盟指挥官克里夫]";
			mes "什么？……有伴侣？！";
			mes "……不是单身，而是有伴侣……";
			mes "......";
			mes "该死！尝尝单身联盟军的怒火！！！";
			close2;
			specialeffect2 EF_MAGICALATTHIT;
			specialeffect2 EF_POTION2;
			specialeffect2 EF_CRASHEARTH;
			specialeffect2 EF_COIN;
			end;
		}
		mes "[单身联盟指挥官克里夫]";
		mes "嘻嘻哈哈哈！";
		mes "我就知道！一眼就能看出来！";
		mes "别小看我，我一辈子都是单身！嘻嘻哈哈哈！";
		mes "我叫单身联盟指挥官克里夫！";
		next;
		mes "[单身联盟指挥官克里夫]";
		mes "总之，这个十二月，那一天就要来了……";
		next;
		mes "[单身联盟指挥官克里夫]";
		mes "到处都是圣诞歌、彩灯、白雪，还有微笑相视的情侣……情侣……情——侣——们……！！！！";
		next;
		mes "[单身联盟指挥官克里夫]";
		mes "起初这是庆祝主诞生的节日！为什么……怎么……什么时候变成情侣的节日了？！";
		next;
		mes "[单身联盟指挥官克里夫]";
		mes "我受不了了……";
		mes "我不会原谅他们只顾自己享受幸福！！";
		next;
		mes "[单身联盟指挥官克里夫]";
		mes "情侣的圣诞节？";
		mes "不可能！今年圣诞节属于单身者！！";
		next;
		mes "[单身联盟指挥官克里夫]";
		mes "不过我需要成员对抗他们。我们的名字是单身联盟军！！";
		next;
		mes "[单身联盟指挥官克里夫]";
		mes "你觉得呢？愿意加入单身联盟军，让圣诞节属于单身者吗？";
		next;
		select("算我一个！:我来帮忙。:我还能拒绝吗？");
		mes "[Union Commander Cliff]";
		mes "好！就是这样！但我们需要更多成员对抗情侣。";
		next;
		mes "[Union Commander Cliff]";
		mes "这是你的第一个任务！";
		mes "去露提找人让他们加入。5 名单身者应该够了，出发出发~！";
		mes "嘻嘻哈哈哈！";
		close2;
		setquest 15055;
		end;
	} else if (isbegin_quest(15055) == 1 && .@que_allmem < 10) {
		mes "[Union Commander Cliff]";
		mes "没时间浪费！";
		mes "去露提找 5 名单身者，让他们加入！";
		close;
	} else if (isbegin_quest(15055) == 1 && .@que_allmem > 9) {
		mes "[Union Commander Cliff]";
		mes "干得好！我已经见过他们！他们值得加入我们的事业，嘻嘻哈哈哈！！";
		next;
		mes "[Union Commander Cliff]";
		mes "你收集更多单身联盟军成员时，我制作了徽章……";
		next;
		mes "[Union Commander Cliff]";
		mes "它也许没什么用，但这种小小的信物能让我们的纽带坚固！";
		next;
		mes "[Union Commander Cliff]";
		mes "来，收下这个！现在你是光荣的单身联盟军成员了！！";
		set xmas2013_01,0;
		completequest 15055;
		getitem 6821,1; //Solo_Troops_Badge
		next;
		mes "[单身联盟指挥官克里夫]";
		mes "现在成员够多了，是时候向情侣展示我们的力量！！";
		next;
		mes "[单身联盟指挥官克里夫]";
		mes "开始第二个任务！";
		mes "去露提拆散情侣。不管用什么方法，总之让他们分手！！";
		mes "嘻嘻哈哈哈！";
		next;
		mes "[单身联盟指挥官克里夫]";
		mes "还有一件事……";
		mes "干扰情侣时，若他们分手得 2 分，若只是争吵得 1 分。";
		mes "但如果他们感情更深，扣 1 分。获得 5 分回来报告，就算任务完成。";
		next;
		mes "[单身联盟指挥官克里夫]";
		mes "你不会得到负分，所以别担心。";
		setquest 15056;
		close;
	} else if (isbegin_quest(15055) == 2) {
		mes "[单身联盟指挥官克里夫]";
		mes "现在兵力够了，是时候向情侣展示我们的力量！！";
		next;
		mes "[单身联盟指挥官克里夫]";
		mes "开始第二个任务！";
		mes "去露提拆散情侣。不管怎样让他们分手！！";
		next;
		mes "[Union Commander Cliff]";
		mes "还有一件事……";
		mes "干扰情侣时，若他们分手得 2 分，若只是争吵得 1 分。";
		mes "但如果他们感情更深，扣 1 分。获得 5 分回来报告，就算任务完成。";
		next;
		mes "[Union Commander Cliff]";
		mes "你不会得到负分，所以别担心。";
		setquest 15056;
		close;
	}
	end;
}

xmas,172,126,3	script	Lonely Kwami#xmas	10089,{
	if (isbegin_quest(15055) == 0) {
		mes "[Kwami]";
		mes "哈……圣诞前分手……我孤单……单身！……是吗？！";
		close;
	} else if (isbegin_quest(15055) == 1 && isbegin_quest(15060) == 0) {
		mes "[Kwami]";
		mes "哈啊……圣诞节前分手……我一个人……单身！……是吗？！！";
		next;
		mes "[Kwami]";
		mes "你是谁！？";
		mes "找我有什么事？";
		next;
		select("- 单身联盟军来找你了。-");
		mes "[Kwami]";
		mes "呃？单身联盟军？那是什么？";
		next;
		select("- 说明俱乐部情况 -");
		mes "[Kwami]";
		mes "……嗯，你说得对！";
		next;
		mes "[Kwami]";
		mes "我可是单身！绝不会让情侣享受这个圣诞节！！";
		next;
		mes "[Kwami]";
		mes "我要加入单身联盟军！！";
		next;
		mes "- Kwami已成为单身联盟军成员。-";
		setquest 15060;
		completequest 15060;
		close;
	} else {
		mes "[Singles Union Kwami]";
		mes "首先，我得向前任复仇……对吧？";
		close;
	}
}

xmas,113,161,5	script	Lonely Willer#xmas	10090,{
	if (isbegin_quest(15055) == 0) {
		mes "[Willer]";
		mes "呜哦哦哦……一个人玩真无聊……";
		close;
	} else if (isbegin_quest(15055) == 1 && isbegin_quest(15061) == 0) {
		mes "[Willer]";
		mes "呜哦哦哦……一个人玩真无聊……";
		next;
		mes "[Willer]";
		mes "难道没有什么刺激的事吗？";
		mes "……嘿，要和我一起玩吗？";
		next;
		select("- 单身联盟军来找你了。-");
		mes "[Willer]";
		mes "什么单身联盟？为什么来找我？";
		next;
		select("- 说明俱乐部情况 -");
		mes "[Willer]";
		mes "所以……";
		mes "拆散情侣，只为单身者举办圣诞派对？";
		next;
		mes "[Willer]";
		mes "一定很有趣！虽然我不太明白，但我要加入！！";
		next;
		mes "- Willer已成为单身联盟军成员。-";
		setquest 15061;
		completequest 15061;
		close;
	} else {
		mes "[Singles Union Willer]";
		mes "拆散情侣……这一定很有趣！！";
		close;
	}
}

xmas,131,97,5	script	Lonely Rinka#xmas	10091,{
	if (isbegin_quest(15055) == 0) {
		mes "[Rinka]";
		mes "呸！可恶……只会炫耀男朋友的朋友真恶心！她真以为我找不到男朋友吗？！";
		close;
	} else if (isbegin_quest(15055) == 1 && isbegin_quest(15062) == 0) {
		mes "[Rinka]";
		mes "呸！可恶……只会炫耀男朋友的朋友真恶心！她真以为我找不到男朋友吗？！";
		next;
		mes "[Rinka]";
		mes "- 抽泣 -";
		next;
		mes "[Rinka]";
		mes "我不行……其实根本没有人……我谁都没有！！！！！！！！！！";
		next;
		select("- 单身联盟军来找你了。-");
		mes "[Rinka]";
		mes "呀！哇！！";
		mes "你吓到我了。你在说什么，那是什么？！";
		next;
		select("- 说明俱乐部情况 -");
		mes "[Rinka]";
		mes "呵呵……还有这样的组织？";
		mes "拆散情侣……";
		mes "好！让我加入！";
		next;
		mes "[Rinka]";
		mes "还有位置给另一名成员吗？";
		mes "……很快又会有成员加入！";
		mes "等着吧～我的朋友！！……";
		next;
		mes "- Rinka已成为单身联盟军成员。-";
		setquest 15062;
		completequest 15062;
		close;
	} else {
		mes "[Singles Union Rinka]";
		mes "等着吧~我的朋友！！你很快就会加入！！";
		close;
	}
}

xmas,121,127,5	script	Lonely Jee#xmas	10088,{
	if (isbegin_quest(15055) == 0) {
		mes "[Jee]";
		mes "单身多美好……";
		close;
	} else if ((isbegin_quest(15055) == 1) && (isbegin_quest(15063) == 0)) {
		mes "[Jee]";
		mes "单身多美好……";
		next;
		mes "[Jee]";
		mes "没有人打扰你，也不用照顾任何人。不再有别人带来的额外工作。有更多时间独处。";
		next;
		mes "[Jee]";
		mes "为什么人们要放弃这些优势，去当情侣？！";
		next;
		select("- 单身联盟军来找你了。-");
		mes "[Jee]";
		mes "是的，我最近听说了。我就知道你会来找我。";
		next;
		mes "[Jee]";
		mes "不用多说。我会传播单身的优势！";
		next;
		mes "- Jee已成为单身联盟军成员。-";
		setquest 15063;
		completequest 15063;
		close;
	} else {
		mes "[Singles Union Jee]";
		mes "我会传播单身的优势！";
		close;
	}
}

xmas,150,169,3	script	Lonely Marty#xmas	10087,{
	if (isbegin_quest(15055) == 0) {
		mes "[Marty]";
		mes "嗯……Zzz……吧唧吧唧……";
		close;
	} else if (isbegin_quest(15055) == 1 && isbegin_quest(15064) == 0) {
		mes "[Marty]";
		mes "嗯……Zzz……吧唧吧唧……";
		next;
		select("- 单身联盟军来找你了。-");
		mes "[Marty]";
		mes "吧唧……吧唧……呼噜……Zzz";
		next;
		select("- 说明俱乐部情况 -");
		mes "[Marty]";
		mes "嗯……喵啊……Zzz";
		next;
		mes "- ……可以认为他同意加入了。-";
		next;
		mes "- Marty已成为单身联盟军成员。-";
		setquest 15064;
		completequest 15064;
		close;
	} else {
		mes "[Singles Union Marty]";
		mes "吧唧……吧唧……呼噜……Zzz";
		close;
	}
}

xmas,108,149,5	script	Drop Machine#xmas	562,{
	if (isbegin_quest(15056) == 0) {
		mes "[Drop Machine]";
		mes "叮叮咚叮！～";
		emotion ET_THROB;
		next;
		mes "[Slot Machine]";
		mes "!~";
		emotion ET_THROB, getnpcid(0, "Slot Machine#xmas");
		close;
	} else if (isbegin_quest(15056) == 1 && xmas2013_01 < 5) {
		mes "[Drop Machine]";
		mes "叮叮叮叮！～";
		emotion ET_THROB;
		next;
		mes "[Slot Machine]";
		mes "咔——沙——叮！～";
		emotion ET_THROB, getnpcid(0, "Slot Machine#xmas");
		next;
		mes "- 糟糕，又一对情侣！";
		mes "- 虽然它们只是机器……";
		mes "- 我无法忍受看到这一幕！";
		next;
		select("- 让机器全功率运行。-");
		mes "[Drop Machine]";
		mes "叮叮叮咚叮叮叮咚叮叮叮咚叮叮叮咚";
		next;
		mes "[Slot Machine]";
		mes "咔啊啊啊啊叮叮咚咔啊啊叮叮咔啊啊啊啊叮咔啊啊啊啊";
		next;
		set .@cu_bre, rand(1,10);
		if (.@cu_bre < 3) {
			mes "- 我……";
			mes "- 我想我把它们都拆散了！";
			mes "- 成功拆散一对情侣！";
			mes "- 干得漂亮，获得2分！";
			set xmas2013_01, xmas2013_01 + 2;
		} else if (.@cu_bre > 7) {
			mes "- 我让机器运行了一会儿";
			mes "- 但机器的声音";
			mes "- 似乎越来越大。";
			mes "- 拆散失败，扣1分！";
			if (xmas2013_01 > 0)
				set xmas2013_01, xmas2013_01 - 1;
		} else {
			mes "- 机器运行了一会儿后";
			mes "- 我想我终于拆散了其中一个！";
			mes "- 干得不错，获得1分！";
			set xmas2013_01, xmas2013_01 + 1;
		}
		mes "- 当前拆散情侣点数为" + xmas2013_01 + "。";
		hideonnpc "Drop Machine#xmas";
		hideonnpc "Slot Machine#xmas";
		initnpctimer;
		close;
	} else if (isbegin_quest(15056) == 1 && xmas2013_01 > 4) {
		mes "- 拆散情侣点数";
		mes "- 现在超过5分。";
		mes "- 我该回去找单身联盟指挥官克里夫了。";
		close;
	}
	end;
OnTimer100000:
	hideoffnpc "Drop Machine#xmas";
	hideoffnpc "Slot Machine#xmas";
	stopnpctimer;
	end;
}
xmas,111,149,3	script	Slot Machine#xmas	563,{ end; }

xmas,181,150,5	script	Frightened Man#xmas	711,{
	if (isbegin_quest(15056) == 0) {
		mes "[Frightened Man]";
		mes "是我的错，对不起。请别生气。";
		emotion ET_SORRY;
		next;
		mes "[Angry Woman]";
		mes "你道歉？知道自己做了什么吗？知道我为什么生气吗？";
		emotion ET_FRET, getnpcid(0, "Angry Woman#xmas");
		close;
	} else if (isbegin_quest(15056) == 1 && xmas2013_01 < 5) {
		mes "[Frightened Man]";
		mes "是我的错，对不起。请别生气。";
		emotion ET_SORRY;
		next;
		mes "[Angry Woman]";
		mes "你道歉？知道自己做了什么吗？知道我为什么生气吗？";
		emotion ET_FRET, getnpcid(0, "Angry Woman#xmas");

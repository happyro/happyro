			next;
			mes "因此，他们建造了一座看起来像水务和下水道设施的巨大建筑……";
			next;
			mes "但为什么在城内找不到入口？是结构问题，还是出于安全考虑？";
			break;
		case 7:
			mes "Glast Heim，曾经伟大城堡的遗迹。";
			next;
			mes "他们很快会揭示这里发生了什么以及背后的故事。所以，让我们关注事态发展。";
			next;
			mes "总之，Glast Heim上下层的十多个区域里，有许多怪物共同生活。";
			next;
			mes "这个地区更详细的地理信息实在太少了，我真想抓住一个城市工程师的衣领问个清楚。";
			break;
		case 8:
			mes "人类文明已经先进到足以建立国家，但人类并没有积累知识，只是在不断转移关注点，";
			next;
			mes "似乎已经无法区分不同的树木和草。";
			next;
			mes "否则，他们不会把这座井然有序的森林命名为‘神秘森林’。真不敢相信，只因为找不到出口就给森林起了这么奇怪的名字。";
			break;
		case 9:
			mes "他们也许曾认为语言是人类独有的。但我相信遇到我们这些妖精后，他们改变了想法。";
			next;
			mes "不过，他们看到一些体型远大于普通猫的猫生活在社会中，并能与人类交流时，倒并不惊讶。";
			next;
			mes "有件事我不知道。我要揭露真相吗？";
			break;
		case 10:
			mes "突发新闻：对秘密地点的思考。";
			next;
			mes "离普隆德拉不远的修道院里，一直发生着剥削和骚扰。";
			next;
			mes "他们引诱那些想走上神之道路的人，让他们采蘑菇或长跑……这怎么能被接受！";
			break;
		}
		next;
	}
}

ecl_in01,83,84,4	script	Midgard Exploration#bok3	HIDDEN_NPC,{
	PranksterDiag;
	mes "- 我看到一本书，伸手去拿。我想那是关于米德加尔特北部的书。-";
	next;
	while (1) {
		if (select("远离书架。:查看书架。") == 1) {
			mes "["+ strcharinfo(0) +"]";
			mes "我不该读它。";
			close;
		}
		switch(rand(1,10)) {
		case 1:
			mes "人类不断让巨大的箱子漂浮在水面和海上，最后甚至开始利用天空。";
			next;
			mes "他们接下来要去哪里？地下？还是要超越时间与空间？";
			next;
			mes "照这样下去，人类可能愿意穿越到过去。人类的科技进步值得关注。";
			break;
		case 2:
			mes "Einbroch充满了机器。他们似乎没有制造很多工业产品，但机器肯定就是他们的武器。";
			next;
			mes "那些工厂在生产什么，人们又为何工作？";
			next;
			mes "他们难道不知道文明发展不一定会提高生命的价值吗？";
			break;
		case 3:
			mes "在Einbroch乘坐火车，可以到达名为Einbech的村庄。";
			next;
			mes "当然我讨厌这种交通方式（铁味太重），但它价格便宜、运力强，对人类很有用。";
			next;
			mes "话说，他们没有足够材料修建铁路吗？什么时候才会延长铁路路线？";
			break;
		case 4:
			mes "Hugel这个小型乡村，就像南部地区的Comodo。";
			next;
			mes "那里有各种小游戏，风景也非常田园。";
			next;
			mes "但这些娱乐设施不是应该位于国家中心吗？";
			break;
		case 5:
			mes "名为Juno的城市甚至漂浮在天空中！真不可思议。";
			next;
			mes "逃出迷宫的人还能获得特殊奖励：有一个可以重生的地方。";
			next;
			mes "人类真可怕。但我感觉曾在哪里见过这个迷宫……";
			break;
		case 6:
			mes "在Arunafeltz首都拉赫，住着一种小巧、可爱、白色且看起来很柔软的生物。";
			next;
			mes "如果你想到Siroma，那就错了。它也不是海洋生物。";
			next;
			mes "答案是一位既是牧师又是首领的女孩。这是因为Arunafeltz是神权实体。";
			break;
		case 7:
			mes "Audhumbla平原上生活着许多怪物花和草食动物。";
			next;
			mes "虽然看到它们攻击人类，会以为它们不是草食动物，但";
			next;
			mes "如果它们真是肉食动物，又靠什么为生？而且没有记录表明它们攻击路过的冒险家后会把他们吃掉。";
			break;
		case 8:
			mes "Veins，一座建在山上的村庄，看起来规划得很好。";
			next;
			mes "虽然进出位置让人困惑，";
			next;
			mes "但如果你想看看石头吞掉你掉落的硬币等奇景，那里值得一去。";
			break;
		case 9:
			mes "Arunafeltz某处还有一个极其炎热的地方……";
			next;
			mes "那里的热量仿佛会把我的翅膀完全烧穿。那里居民的态度似乎也不友好。";
			next;
			mes "所以我不得不停止探险。希望读者们也离那个地方远一点。";
			next;
			mes "嗯……我可不是害怕那里的守护者！";
			break;
		case 10:
			mes "在Lighthalzen，有一座由技术人员建造的巨型建筑。虽然他们究竟在里面做什么有点可疑……";
			next;
			mes "我不确定一家追求利润的公司是否应该做这种事。";
			next;
			mes "城内干净区和脏乱区被分开的做法也很奇怪……";
			break;
		}
		next;
	}
}

ecl_in01,83,81,4	script	Midgard Exploration#bok4	HIDDEN_NPC,{
	PranksterDiag;
	mes "- I saw a book and stretched my hand out to reach for it. I think it's about various regions in Midgard. -";
	next;
	while (1) {
		if (select("远离书架。:查看书架。") == 1) {
			mes "["+ strcharinfo(0) +"]";
			mes "我不该读它。";
			close;
		}
		switch(rand(1,10)) {
		case 1:
			mes "乘坐Alberta的船，可以前往各个目的地。";
			next;
			mes "我不知道为什么这么多船都以Alberta为终点，但这样旅行方便多了。";
			break;
		case 2:
			mes "通过Alberta可以到达的地方如下。";
			next;
			mes "诸神之国Amatsu、避难之地Kunlun、许多武术高手居住的洛阳、有巨大雕像的Ayothaya，以及其他地方。";
			next;
			mes "最近许多国家的代表抵达那里，我想未来还会有更多目的地开放。";
			break;
		case 3:
			mes "在这些船只可达之地中，有一个著名目的地。";
			next;
			mes "遗憾的是，他们只因为我是独自旅行者就不带我，甚至不肯给船费打折。";
			next;
			mes "作为学者，Jawaii航船船长的无知让我无比愤怒。即使在战争期间，历史学家也不应遭受敌意。";
			break;
		case 4:
			mes "从Alberta还可以去一个以大量海龟闻名的岛。";
			next;
			mes "那里没有固定航线，但经过长期研究，我发现有一位船长专门前往那里。";
			next;
			mes "到达那里后，我看到了许多奇特海龟，包括冷海龟、热海龟和忍者海龟。";
			break;
		case 5:
			mes "从钟楼村出发，通过一位全年穿着厚重红衣的老人，我来到了雪村。";
			next;
			mes "整个村子被雪覆盖，正如准备庆典的地方一样，气氛非常好。";
			next;
			mes "村子里还有一个为孩子制作玩具的地方，但不知为何他们把我赶了出来。";
			break;
		case 6:
			mes "在船只可达的地方中，有一座停着沉船的小岛。";
			next;
			mes "我不知道那艘船是否打算打捞，但那里已经被奇怪的生物占据。";
			break;
		case 7:
			mes "这片大陆信仰的主神是Odin，因此也有Odin神殿。";
			next;
			mes "我也被这里排斥了。人们完全没有善待外来者的观念。";
			break;
		case 8:
			mes "村子南边有一些码头。我研究了很久码头的用途，却始终找不到答案。";
			next;
			mes "但很快，我跟随秘密使用码头的冒险家，发现了它们通往的目的地。";
			next;
			mes "那里令人恐惧，但我看到的景象着实令人震惊。";
			next;
			mes "冒险家理应记录所见一切，但这是不宜公开的政治敏感材料，我就说到这里。";
			break;
		default:
			mes "村子南边有一些码头。我研究了很久码头的用途，却始终找不到答案。";
			next;
			mes "但很快，我跟随秘密使用码头的冒险家，发现了它们通往的目的地。";
			next;
			mes "那里令人恐惧，但我看到的景象着实令人震惊。";
			next;
			mes "冒险家理应记录所见一切，但这是不宜公开的政治敏感材料，我就说到这里。";
			break;
		}
		next;
	}
}

ecl_in01,82,78,4	script	Magazine#01	HIDDEN_NPC,{
	PranksterDiag;
	mes "《卢恩-米德加尔特月刊》，十月刊";
	next;
	mes "突发新闻！普隆德拉麻烦制造者！！独家采访！！";
	next;
	if (select("继续阅读。:停止阅读。") == 2)
		close;
	mes "[记者]：大家好，今天我们请到了精炼大师 Hollgrehen 先生。你好，Hollgrehen 先生。";
	next;
	mes "[Hollgrehen]：你好，很高兴见到你。";
	next;
	mes "[记者]：是什么让你在过去十年专心研究精炼？";
	next;
	mes "[Hollgrehen]：我小时候去游泳池，即使不会游泳也能漂在水面上。我就是能做到。那就是我成为精炼师的起点。";
	next;
	if (select("继续阅读。:停止阅读。") == 2)
		close;
	mes "[Reporter]: What? You float well? Hmm? It sounds weird..";
	next;
	mes "[Hollgrehen]：你试过在水里精炼吗？没试过就别开始。";
	next;
	mes "[记者]：好，我明白了。听说你有惊人的技能，是什么？";
	next;
	mes "[Hollgrehen]：我闭着眼睛也能精炼物品。";
	next;
	if (select("继续阅读。:停止阅读。") == 2)
		close;
	mes "[记者]：这不就是你总把物品弄坏的原因吗？";
	next;
	mes "[Hollgrehen]：你试过闭眼精炼吗？没试过就别开始。";
	next;
	if (select("继续阅读。:停止阅读。") == 2)
		close;
	mes "[记者]：原来如此……那能给我们展示一下吗？先从简单的开始，比如……小刀？";
	next;
	mes "[Hollgrehen]：我不精炼那种便宜武器。至少要是 4 级武器。";
	next;
	mes "[Reporter]: Huh? Cheap weapons? You're kidding, right?";
	next;
	mes "[Hollgrehen]：我不讲笑话。哦，你拿着一把‘+9 冰镐’，很好。给我，我把它升到 10。";
	next;
	mes "[Reporter]: Huh?! Oh, no..";
	next;
	if (select("继续阅读。:停止阅读。") == 2)
		close;
	mes "- Clank! Clank! Clank! Shatter!! -";
	mes "[Hollgrehen]: Uoooohhhhhhh!!!";
	next;
	mes "[Reporter]: ..";
	next;
	if (select("继续阅读。:停止阅读。") == 2)
		close;
	mes "[Hollgrehen]：哈哈哈，我今天可能状态不太好。哦！今天是星期日，对吧？我忘了星期日不适合精炼武器。也许盔甲可以。对，盔甲一定会漂起来。";
	next;
	mes "- 他拿走记者的盔甲。-";
	mes "[Hollgrehen]：这是很不错的盔甲。是 +7 高风险女武神盔甲吗？";
	next;
	if (select("继续阅读。:停止阅读。") == 2)
		close;
	mes "- Clank! Clank! Clank! Shatter!! -";
	mes "[Hollgrehen]: Uoooohhhhhhh!!!";
	next;
	mes "[Reporter]: .. ..";
	next;
	if (select("继续阅读。:停止阅读。") == 2)
		close;
	mes "[Hollgrehen]：现在想想，今天是偶数日。偶数日不适合精炼盔甲。对了，鞋子应该能漂得很好。";
	next;
	mes "- 他拿走记者的鞋子。-";
	mes "[Hollgrehen]：嘿，你挺富有。这是 +9 暗黑皮靴。我会让你更富有。";
	next;
	if (select("继续阅读。:停止阅读。") == 2)
		close;
	mes "- Clank! Clank! Clank! Shatter!! -";
	mes "[Hollgrehen]: Uoooohhhhhhh!!!";
	next;
	mes "[Reporter]: .. .. ..";
	next;
	if (select("继续阅读。:停止阅读。") == 2)
		close;
	mes "[Hollgrehen]：看了日历才发现今天是本月第一个星期日。不知为何，第一个星期日不适合精炼鞋子。对了，今天最适合精炼衣服！！";
	next;
	mes "- 他拿走记者的衣服。-";
	mes "[Hollgrehen]：这是 +9 漫游女武神斗篷。很好，我一定把它升到 10。";
	next;
	if (select("继续阅读。:停止阅读。") == 2)
		close;
	mes "- Clank! Clank! Clank! Shatter!! -";
	mes "[Hollgrehen]: Uoooohhhhhhh!!!";
	next;
	mes "[Reporter]: .. .. .. ..";
	next;
	if (select("继续阅读。:停止阅读。") == 2)
		close;
	mes "[Hollgrehen]：哈哈哈，我好像忘了什么重要的事……我该走了。";
	next;
	mes "[Reporter]: .. .. .. .. ..";
	next;
	if (select("继续阅读。:停止阅读。") == 2)
		close;
	mes "由于记者的身体状况，采访未能完成，敬请谅解。——编辑部";
	close;
}

ecl_in01,82,79,4	script	Magazine#02	HIDDEN_NPC,{
	PranksterDiag;
	mes "《卢恩-米德加尔特月刊》，十一月刊";
	next;
	mes "本月读者回忆录讲述猫咪之岛Malangdo。你不期待了解Malangdo发生了什么吗？！";
	next;
	if (select("继续阅读。:停止阅读。") == 2)
		close;
	mes "读者回忆录";
	mes "探索MalangdoX精炼记录O";
	next;
	mes "Malangdo，猫咪之岛。柔软又可爱，啊……那是一座充满可爱猫咪的岛。呜，我该怎么办……它们都可爱得让我想拥抱……";
	next;
	if (select("继续阅读。:停止阅读。") == 2)
		close;
	mes "它们……是的，我本来想这么做，直到遇到那对可怕的猫父女。";
	next;
	mes "是的，我当时在等着捕捉章鱼王。好像是在经过一艘船时？我遇到了一只斜眼猫。";
	next;
	if (select("继续阅读。:停止阅读。") == 2)
		close;
	mes "那只猫自我介绍说，他曾在Morocc学习。";
	next;
	mes "然后他向我保证能把我的+9紫色恐惧升级为+10紫色恐惧。";
	next;
	if (select("继续阅读。:停止阅读。") == 2)
		close;
	mes "他有留学经历，听起来很可靠，对吧？所以我相信了他，把+9紫色恐惧交给他。";
	next;
	mes "结果我的+9紫色恐惧碎成了片。我非常震惊，因为那是我唯一的武器。";
	next;
	if (select("继续阅读。:停止阅读。") == 2)
		close;
	mes "我还花光所有钱买了浓缩神之金属。没错，即使他留过学，我也不能百分百信任他。";
	next;
	mes "所以我只能安慰自己，为我的+9紫色恐惧哀悼。";
	next;
	if (select("继续阅读。:停止阅读。") == 2)
		close;
	mes "但这还没结束。之后，一只小猫来找我，说她有一把能精炼天上星辰的锤子。";
	next;
	mes "能精炼天上星辰的锤子！听起来很棒吧？既然我失去了唯一的武器，我想强化护甲，于是把所有东西都给了她。";
	next;
	if (select("继续阅读。:停止阅读。") == 2)
		close;
	mes "鞋子、衣服、护甲，甚至头盔……我拥有的一切都没了……现在想想，她说那是一把能精炼天上星辰的锤子。";
	next;
	mes "但她没说不会弄坏东西，对吧？所以如果你去Malangdo，要小心那些叫‘Strip’和‘Shatter’的猫。我可是符文骑士，却还在抓波利……你不会想变成我这样……";
	next;
	if (select("继续阅读。:停止阅读。") == 2)
		close;
	mes "这是一个关于‘出现在Morocc天空’的故事。";
	close;
}


// Light and Darkness
//============================================================
ecl_in02,98,32,3	script	Eclage Guard#tl1b	4_M_FAIRYSOLDIER2,{
	mes "[Eclage Guard]";
	if (ep14_2_mylord > 6) {
		mes "你是为……国王工作。";
		mes "我准许你进入。";
		mes "这边走。";
		close2;
		warp "ecl_in02",126,115;
		end;
	}
	mes "这里是关押罪犯的监狱。";
	mes "外来者禁止进入。";
	close;
}

ecl_in02,133,115,0	script	#pa0829Prison Guard	HIDDEN_WARP_NPC,3,3,{
	end;
OnTouch_:
	if (ep14_2_etran < 2) {
		mes "[Clever]";
		mes "嘿，卫兵~这里湿气太重了，我的皮肤要毁了。这样可以吗？嗯？";
		next;
		mes "[Prison Guard]";
		mes "......";
		next;
		mes "^000099狱卒疲惫地看着囚犯，似乎因不断和囚犯争吵而感到烦躁。^000000";
		next;
		mes "[Prison Guard]";
		mes "Clever先生，你必须明白。你目前是服刑中的囚犯。";
		next;
		mes "[Clever]";
		mes "是的，我知道。我知道。所以请带个炉子来这里。湿气太重，让一切都变得黏糊糊的。";
		next;
		mes "[Prison Guard]";
		mes "你不明白吗？不可能让囚犯在有利条件下服刑。";
		next;
		mes "[Clever]";
		mes "真小气……";
		next;
		mes "[Prison Guard]";
		mes "(Enraged)";
		next;
		mes "^000099狱卒强忍怒火回到岗位，宽容地让囚犯随心所欲。^000000";
		ep14_2_etran = 2;
		setquest 12280;
		close;
	}
	mes "[Prison Guard]";
	if (ep14_2_etran == 21) {
		mes "哦！你就是之前那个人。我真感谢你来这里！请帮帮我，我似乎无法处理这里的事情。";
		next;
		mes "[Clever]";
		mes "别看别处~别和其他囚犯说话~只看我，只看我~~和我在一起时要乖~~";
		next;
		mes "^000099情况很明显：狱卒需要有人帮他处理这个囚犯。^000000";
		next;
		select("可是我没有提交申请……");
		mes "[Prison Guard]";
		mes "正式请求？不，根本没必要。你是来探望Clever先生的，对吧？看，已经登记好了。";
		next;
		mes "^000099It's probably better not to randomly make up an official record right in front of me.^000000";
	}
	else if (ep14_2_etran == 25) {
		mes "你来了，"+ strcharinfo(0) +"。我不知道你做了什么，但Clever先生现在安静了。";
		next;
		select("我需要填写访问表吗？");
		mes "[Prison Guard]";
		mes "不，不！你在说什么……"+ strcharinfo(0) +"随时欢迎你来探监。如果是来见Clever先生，我尤其会为你安排！";
		next;
		mes "^000099Yeah, I keep thinking about it. It's probably better not to randomly make up an official record right in front of me.^000000";
	}
	else if (ep14_2_etran == 26) {
		mes strcharinfo(0) + "你已经要走了吗？啊……真糟糕～这里刚安静下来！！";
		next;
		select("我还以为我的访问时间已经结束了……");
		mes "[Prison Guard]";
		mes "什么！你在说什么？"+ strcharinfo(0) +"探访时间对你来说是问题吗？来……我把时间延长3小时！";
		next;
		mes "^000099他随意编造故事的方式真是……我已经无话可说了……^000000";
		ep14_2_etran = 27;
	}
	else if (ep14_2_etran == 29) {
		mes "你已经要走了吗……";
		mes "(The prison guard looks on hopefully)";
	}
	else if (ep14_2_etran == 42) {
		mes "是的~~你来了！！";
		mes "我一直在等你！";
		next;
		select("Clever又给你添麻烦了吗……？");
		mes "[Prison Guard]";
		mes "这不是歌曲。"+ strcharinfo(0) + "不在这里时，Clever先生一直念着某种咒语折磨我！";
		next;
		mes "[Prison Guard]";
		mes "既然你来了，我先为你记录下来！";
		next;
		mes "^000099他总是编故事，我现在已经习惯了。^000000";
	}
	close;
}

ecl_in02,146,114,4	script	Clever#pa0829	4_M_FAIRYSCHOLAR_DIRTY,{
	disable_items;
	if (checkweight(1201,1) == 0 || (MaxWeight - Weight) < 1000) {
		mes "看来物品种类太多了。减少种类后再试。";
		close;
	}
	if (ep14_2_etran > 6 && ep14_2_etran < 21) {
		mes "^000099Clever 还在熟睡。小心别把他吵醒。^000000";
		close;
	}
	if (ep14_2_etran > 22 && ep14_2_etran < 25) {
		mes "^000099Clever 在我手上潦草画了地图，看起来像是书所在的地方。^000000";
		close;
	}
	if (ep14_2_etran > 42) {
		mes "^000099我看见 Clever 正努力使用书写工具，应该是在写新的历史报告。^000000";
		close;
	}
	mes "[Clever]";
	if (ep14_2_etran < 3)
		mes "嗯？你是谁？你不是访客。卫兵~！！！卫兵~！！！这里有可疑人物！你们为什么不把他带走？！";
	else if (ep14_2_etran == 3) {
		mes "嗯，总之我以前没见过你。你为什么来探望我？";
		next;
		if (select("我也从没想过要来见你。:你犯了什么罪？") == 1) {
			mes "[Clever]";
			mes "哦~真的吗？好，你离开这里吧。我要开始折磨卫兵了。让我想想……好，我要唱歌给他听！";
			next;
			mes "^000099Clever 一开始唱歌，狱卒就疲惫地看着我。当然，对我来说也是一种折磨。^000000";
			close;
		}

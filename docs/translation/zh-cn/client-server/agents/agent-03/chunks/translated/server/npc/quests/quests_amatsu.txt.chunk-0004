ama_in02,200,176,4	script	Lord of Palace#ama	768,{
	if (event_amatsu == 0) {
		mes "[Ishida Yoshinaga]";
		mes "什么！外国人……？*呼*";
		mes "抱歉，我没心情";
		mes "见新客人！";
		next;
		mes "[Ishida Yoshinaga]";
		mes "出去！我不在乎";
		mes "你是谁。";
		mes "我身体不舒服！";
		close;
	}
	else if (event_amatsu == 1) {
		mes "[Ishida Yoshinaga]";
		mes "什么！外国人？你来这里";
		mes "做什么？如果不紧急，";
		mes "改天再来找我……！";
		next;
		switch(select("我听说了你母亲的事……:你的姓氏很好听:你是谁？")) {
		case 1:
			mes "[Ishida Yoshinaga]";
			mes "哦……你知道她的病吗？";
			mes "我听说在外国，";
			mes "医学知识";
			mes "相当惊人。";
			next;
			mes "[Ishida Yoshinaga]";
			mes "欢迎。如你所知，我是";
			mes "洞京城的领主，";
			mes "石田吉长。很高兴";
			mes "见到你。";
			next;
			mes "[Ishida Yoshinaga]";
			mes "我们直入主题吧。";
			mes "我母亲最近身体不好。我知道你是因为这件事来的。";
			mes "你能治好她吗？";
			next;
			mes "[Ishida Yoshinaga]";
			mes "到现在为止，许多名医";
			mes "都来诊治过她，但他们";
			mes "全都没能治好她的病，";
			mes "反而让病情恶化……";
			mes "他们让我失望。";
			next;
			mes "[Ishida Yoshinaga]";
			mes "你来自米德加尔特，";
			mes "也许能治好我母亲的病。成功的话我会重重奖赏你……";
			next;
			set event_amatsu,2;
			if (isbegin_quest(8131) == 1)
				changequest 8131,8132;
			else
				setquest 8132;
			mes "[Ishida Yoshinaga]";
			mes "求你了……拜托。";
			mes "我母亲住在宫殿外的一所房子里。";
			mes "治疗结束后再来找我。";
			close;
		case 2:
			mes "[Ishida Yoshinaga]";
			mes "好听？！那又怎样？！";
			mes "尽管念我的名字，念到";
			mes "你厌烦为止！可恶！";
			next;
			mes "[Ishida Yoshinaga]";
			mes "这种紧要关头还开玩笑……*呼*……";
			mes "请在天津町玩得开心。";
			mes "……随便你！";
			close;
		case 3:
			mes "[Ishida Yoshinaga]";
			mes "……我？你不知道吗？嗯？";
			mes "我是这座宫殿的领主。";
			mes "不知道的话，就去问";
			mes "外面的士兵！";
			close;
		}
	}
	else if (event_amatsu == 5) {
		if (countitem(1022) > 0) {
			mes "[Ishida Yoshinaga]";
			mes "我听到了好消息！";
			mes "我母亲似乎好转了。她得的是什么病？";
			next;
			mes "[Ishida Yoshinaga]";
			mes "狐狸？是这样吗？哦……";
			mes "原来不是病……！！";
			mes "我怎么没发现？！";
			next;
			mes "[Ishida Yoshinaga]";
			mes "该死的狐狸。竟然逃走，";
			mes "还用这种方式";
			mes "向我复仇……好吧，现在它没机会复仇了……哈哈哈！";
			next;
			mes "[Ishida Yoshinaga]";
			mes "嗯，嗯嗯。嗯……";
			next;
			mes "[Ishida Yoshinaga]";
			mes "总之，谢谢你帮助我。";
			mes "母亲现在会没事了……";
			mes "我想奖励你……";
			mes "不过送什么好呢……？";
			next;
			mes "[Ishida Yoshinaga]";
			mes "好吧，我给你";
			mes "一张通行许可证。";
			mes "有了这张票";
			mes "你可以去任何地方。";
			next;
			set event_amatsu,6;
			completequest 8135;
			delitem 1022,1; //Fox_Tail
			getitem 7160,1; //Lord's_Passable_Ticket
			mes "[Ishida Yoshinaga]";
			mes "这不是什么贵重奖励，但";
			mes "将来会对你有用。";
			mes "详情请询问我的士兵‘Jyuro’。";
			close;
		}
		mes "[Ishida Yoshinaga]";
		mes "嗯，我听说母亲";
		mes "好转了……但是";
		mes "我怎么知道你是否治好了";
		mes "她？";
		next;
		mes "[Ishida Yoshinaga]";
		mes "有什么证据能证明";
		mes "是你治好她的吗？";
		next;
		mes "[Ishida Yoshinaga]";
		mes "拿出证据证明";
		mes "你的治疗。我见过";
		mes "很多外国人。";
		mes "但不是所有人都值得信任。";
		mes "那么……祝你愉快。";
		close;
	}
	else if (event_amatsu == 6) {
		mes "[Ishida Yoshinaga]";
		mes "*轻笑*在天津町玩得开心";
		mes "……";
		mes "外国人永远受欢迎。";
		close;
	}
	mes "[Ishida Yoshinaga]";
	mes "我母亲的情况怎么样？";
	mes "如果你知道病名，请告诉我。";
	mes "我整晚都在";
	mes "担心她。";
	next;
	mes "[Ishida Yoshinaga]";
	mes "因为你带来了";
	mes "米德加尔特的知识，";
	mes "我相信你的能力。";
	close;
}
	
ama_in01,22,111,0	script	Grandma#ama2	761,{
	if (event_amatsu == 4) {
		mes "[....]";
		mes "^FF6060嗷，嗷，愚蠢的人类";
		mes "又来了！你要怎么做";
		mes "才能赶走我！？^000000";
		next;
		mes "[....]";
		mes "^FF6060看起来你从某处学了";
		mes "一些东西，但";
		mes "那伤不了我！！嗷！^000000";
		next;
		select("喝啊！！");
		if (BaseJob == Job_Priest) {
			if (rand(1,4) == 1)
				set .@fox_kill,0;
			else
				set .@fox_kill,1;
		}
		else if (BaseJob == Job_Acolyte || BaseJob == Job_Monk || countitem(523) > 0 || countitem(948) > 0 || countitem(1029) > 0) {

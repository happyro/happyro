			killmonsterall "ama_in01";
			set event_amatsu,5;
			changequest 8134,8135;
			getitem 1022,1; //Fox_Tail
			mes "[....]";
			mes "^FF6060吉长所做的一切";
			mes "都会给你带来不幸……^000000";
			mes "^FF0000嗷啊啊啊啊！！^000000";
			close;
		}
		mes "[....]";
		mes "^FF6060嗷！哈哈！嗷！哈哈哈！";
		mes "你想把我从这具身体赶出去吗！？";
		mes "走开！！嗷！^000000";
		close2;
		warp "amatsu",167,197;
		end;
	}
	else if (event_amatsu == 5) {
		mes "[Ishida Saoko]";
		mes "……嗯？你为什么在这里……？";
		mes "*呃*我的头好痛……";
		mes "但我开始想起一切了……";
		next;
		mes "[Ishida Saoko]";
		mes "谢谢你，来自遥远土地的";
		mes "旅人。我欠你一个大人情……非常感谢……";
		next;
		mes "[Ishida Saoko]";
		mes "我会告诉儿子";
		mes "是你驱除了狐狸……";
		mes "谢谢你……";
		next;
		mes "[Ishida Saoko]";
		mes "我该休息一下了。";
		mes "我的头很痛，年轻人……";
		mes "去找我儿子吧……";
		close;
	}
	else if (event_amatsu == 6) {
		mes "[Ishida Saoko]";

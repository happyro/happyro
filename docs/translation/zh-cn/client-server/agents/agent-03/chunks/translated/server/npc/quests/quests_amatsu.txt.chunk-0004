ama_in02,115,177,7	script	Soldier#ama10	767,{
	mes "[Jyuro]";
	mes "你在这里做什么？";
	mes "这里没什么有趣的。";
	next;
	if (select("确实如此:打开大门") == 1) {
		mes "[Jyuro]";
		mes "城里有更值得享受的东西。祝你愉快……";
		close;
	}
	if (event_amatsu == 6) {
		if (countitem(7160) > 0) {
			mes "[Jyuro]";
			mes "你有通行证……";
			mes "要我现在送你进去，还是需要一些说明？";
			next;
			if (select("我要进去:请说明一下") == 1) {
				mes "[Jyuro]";
				mes "我会打开大门。";
				mes "请保重……";
			}
			else {
				mes "[Jyuro]";
				mes "这扇门后面的区域";
				mes "受到某种魔法保护。";
				mes "你可能被某人杀死";
				mes "或者迷路。";
				mes " ";
				next;
				mes "[Jyuro]";
				mes "我不能告诉你太多。";
				mes "我没有深入里面，";
				mes "只是匆匆看了一眼。";
				mes " ";
				mes " ";
				next;
				mes "[Jyuro]";
				mes "第一……";
				mes "‘不要相信你所看到的。’";
				mes "我不知道这是什么意思，";
				mes "但我想你不该相信眼前的一切。";
				next;
				mes "[Jyuro]";
				mes "第二……";
				mes "‘魔法有特定的规则。’";
				mes "万物都有存在的理由。";
				mes "魔法也不例外。你或许能找到答案……";
				next;
				mes "[Jyuro]";
				mes "那么，我要打开这扇门了。";
				mes "请保重……";
			}
			close2;
			warp "ama_dun01",229,10;
			end;
		}
		mes "[Jyuro]";
		mes "对不起。";
		mes "你需要通行许可证才能进去。";
		mes "请回去吧。";
		close;
	}
	mes "[Jyuro]";
	mes "你说的是哪扇门？";
	mes "大楼顶层的门？你一定是搞错了。";
	emotion ET_SWEAT;
	next;
	if (countitem(7160) > 0) {
		if (select("给他看通行证:取消") == 1) {
			mes "[Jyuro]";
			mes "什么？那张通行证是……？";
			mes "这张通行许可证来自";
			mes "领主，但我想它被";
			mes "发给了错误的人。";
			next;
			delitem 7160,1; //Lord's_Passable_Ticket
			mes "[Jyuro]";
			mes "我会没收这张票，因为";
			mes "它未经许可就被发出。";
			mes "这是警告。";
			mes "小心点。";
			close;
		}
		mes "[Jyuro]";
		mes "城里还有更多值得享受的东西。祝你愉快……";
		close;
	}
	mes "[Jyuro]";
	mes "城里还有更多值得享受的东西。祝你玩得开心……";
	close;
}
	

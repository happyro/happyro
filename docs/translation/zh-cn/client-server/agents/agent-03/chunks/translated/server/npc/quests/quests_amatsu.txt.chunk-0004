				set .@fox_kill,0;
			else
				set .@fox_kill,1;
		}
		else {
			if (rand(1,4) == 1)
				set .@fox_kill,1;
			else
				set .@fox_kill,0;
		}
		if (.@fox_kill == 1) {
			mes "[....]";
			mes "^FF6060嗷！嗷！嗷！人类！";
			mes "竟想这样把我从这具身体赶走！";
			mes "诅咒你！该死的！！^000000";
			next;
			mes "[....]";
			mes "^FF6060我要永远诅咒";
			mes "让我们变成这样的石田家族！";
			mes "人类，你最好小心！^000000";
			next;

			mes "那些艰难的测试";
			mes "完成得还好吗？";
			mes "我将进行你的下一项测试。";
			next;
			mes "[加布里埃尔·瓦伦丁]";
			mes "我叫加布里埃尔·瓦伦丁。我也在为圣战做准备。目前负责守卫这座教堂。";
			next;
			mes "[Gabriel Valentine]";
			mes "我会测试你是否掌握成为十字军所需的知识。";
			mes "仅仅挥剑可无法赢得圣战。";
			next;
			mes "[Gabriel Valentine]";
			mes "我会给你";
			mes "10道题。";
			mes "请正确回答。";
			next;
		}
		else if(CRUS_Q == 7) {
			mes "欢迎回来~";
			mes "你为这次测试";
			mes "准备好了吗？";
			mes "我们再试一次，";
			mes "好吗……？";
			next;
			mes "[Gabriel Valentine]";
			mes "我再给你10道题。";
			mes "仔细听，";
			mes "准备开始。";
			mes "选择正确答案。";
			next;
		}
		set .@cru_m,rand(1,3);
		if (.@cru_m == 1) {
			mes "[Gabriel Valentine]";
			mes "1. 哪种属性攻击不死系最有效？";
			next;
			if (select("无属性:地属性:不死属性:圣属性") == 4)
				set .@cru_t,.@cru_t+10;

			mes "[Gabriel Valentine]";
			mes "2. 如果怪物是不死系2级，圣属性攻击比火属性多造成多少伤害？";
			next;
			if (select("25%:50%:75%:100%") == 1)
				set .@cru_t,.@cru_t+10;

			mes "[Gabriel Valentine]";
			mes "3. 你无法从邪恶德鲁伊那里获得什么物品？";
			next;
			if (select("僧侣帽:世界树叶:白草:护身符") == 1)
				set .@cru_t,.@cru_t+10;

			mes "[Gabriel Valentine]";
			mes "4. 哪种不死系怪物";
			mes "HP最高？";
			next;
			if (select("食尸鬼:骷髅囚犯:幽灵:僵尸囚犯") == 4) 
				set .@cru_t,.@cru_t+10;

			mes "[Gabriel Valentine]";
			mes "5. 以下哪种怪物的体型与其他不同？";
			next;
			if (select("幽灵:卡利斯格:德雷克:邪恶德鲁伊") == 3)
				set .@cru_t,.@cru_t+10;

			mes "[Gabriel Valentine]";
			mes "6. 哪张卡片能提高你对不死属性攻击的耐性？";
			next;
			if (select("兽人骷髅卡:兽人僵尸卡:食尸鬼卡:骷髅工人卡") == 2)
				set .@cru_t,.@cru_t+10;

			mes "[Gabriel Valentine]";
			mes "7. 穆拉克和邦古恩生前是什么关系？";
			next;
			if (select("兄妹:同村儿时朋友:异父异母兄妹:完全陌生人") == 2)
				set .@cru_t,.@cru_t+10;

			mes "[Gabriel Valentine]";
			mes "8. 以下哪种怪物不会主动攻击？";
			next;
			if (select("骷髅士兵:兽人骷髅:骷髅:骷髅工人") == 3)
				set .@cru_t,.@cru_t+10;

			mes "[Gabriel Valentine]";
			mes "9. 插入穆拉克卡片的盾牌叫什么？";
			next;
			if (select("原子盾:护身符盾:催眠盾:荷莫洛斯盾") == 2)
				set .@cru_t,.@cru_t+10;

			mes "[Gabriel Valentine]";
			mes "10. 以下哪种怪物不会掉落遗迹？";
			next;
			if (select("穆拉克:食尸鬼:木乃伊:骷髅士兵") == 1)
				set .@cru_t,.@cru_t+10;
		}
		else if (.@cru_m == 2) {
			mes "[Gabriel Valentine]";
			mes "1. 以下哪种怪物的属性与其他不同？";
			next;
			if (select("卡拉特:风幽灵:伊西斯:流浪者") == 3)
				set .@cru_t,.@cru_t+10;

			mes "[Gabriel Valentine]";
			mes "2. 哪把剑攻击恶魔系怪物最有效？";
			next;
			if (select("十字太刀:空洞太刀:诅咒太刀:昏睡太刀") == 1)
				set .@cru_t,.@cru_t+10;

			mes "[Gabriel Valentine]";
			mes "3. 以下哪件物品不是鬼火掉落的？";
			next;
			if (select("粗糙的铝:黄金锤:剑锤:强力法杖") == 2)
				set .@cru_t,.@cru_t+10;

			mes "[Gabriel Valentine]";
			mes "4. 哪种恶魔系怪物HP最高？";
			next;
			if (select("地灵:玛格诺利亚:鬼火:傀儡娃娃") == 4)
				set .@cru_t,.@cru_t+10;

			mes "[Gabriel Valentine]";
			mes "5. 哪种恶魔系怪物体型与其他不同？";
			next;
			if (select("幽灵波利:小恶魔:小巴风特:巴风特") == 1)
				set .@cru_t,.@cru_t+10;

			mes "[Gabriel Valentine]";
			mes "6. 哪面盾牌能减少恶魔系怪物造成的伤害？";
			next;
			if (select("撒旦盾:地狱之盾:护身符盾:精良盾") == 2)
				set .@cru_t,.@cru_t+10;

			mes "[Gabriel Valentine]";
			mes "7. 哪种属性对风幽灵最有效？";
			next;
			if (select("水:地:火:风") == 2)
				set .@cru_t,.@cru_t+10;

			mes "[Gabriel Valentine]";
			mes "8. 哪种怪物与其他恶魔系怪物不同？";
			next;
			if (select("秀发婆婆:伊西斯:鬼火:小幽灵") == 4)
				set .@cru_t,.@cru_t+10;

			mes "[Gabriel Valentine]";
			mes "9. 傀儡娃娃卡有什么效果？";
			next;
			if (select("对暗属性攻击防御增加30%:对毒攻击防御增加30%:对念属性攻击防御增加30%:对无属性攻击防御增加30%") == 3)
				set .@cru_t,.@cru_t+10;

			mes "[Gabriel Valentine]";
			mes "10. 遇到恶魔系怪物时，以下哪种应对方式有效？";
			next;
			if (select("大喊‘邪恶之物，滚开！’:献出灵魂并达成交易。:在武器上涂圣水后攻击。:戴上小恶魔帽。") == 3)
				set .@cru_t,.@cru_t+10;
		}
		else {
			mes "[Gabriel Valentine]";
			mes "1. 学习‘恶魔克星’需要几级‘神圣之护’？";
			next;
			if (select("1级:2级:3级:4级") == 3)
				set .@cru_t,.@cru_t+10;

			mes "[Gabriel Valentine]";
			mes "2. 如果你的INT为30（含装备加成），55级时5级治愈术恢复多少HP？";
			next;
			if (select("396:440:484:528") == 2)
				set .@cru_t,.@cru_t+10;

			mes "[Gabriel Valentine]";
			mes "3. 7级神圣之护会使你对不死系的防御增加多少？";
			next;
			if (select("21:22:23:24") == 1)
				set .@cru_t,.@cru_t+10;

			mes "[Gabriel Valentine]";
			mes "4. 以下哪把矛能攻击拥有念属性的梦魇？";
			next;
			if (select("长矛:比尔·吉萨姆:新月镰刀:西风") == 4)
				set .@cru_t,.@cru_t+10;

			mes "[Gabriel Valentine]";
			mes "5. 学习‘治愈术’需要几级‘治愈’？";
			next;
			if (select("1级:2级:3级:4级") == 2)
				set .@cru_t,.@cru_t+10;

			mes "[Gabriel Valentine]";
			mes "6. 学会3级骑士修炼术后，攻击速度是多少？";
			next;
			if (select("正常速度的70%:正常速度的80%:正常速度的90%:正常速度的100%") == 2)
				set .@cru_t,.@cru_t+10;

			mes "[Gabriel Valentine]";
			mes "7. 关于恶魔克星技能，以下哪项不正确？";
			next;
			if (select("增加对不死系攻击:只有服事能学习:精通后增加30:被动技能") == 2)
				set .@cru_t,.@cru_t+10;

			mes "[Gabriel Valentine]";
			mes "8. 7级治愈术消耗多少SP？";
			next;
			if (select("30:31:33:35") == 2)
				set .@cru_t,.@cru_t+10;

			mes "[Gabriel Valentine]";
			mes "9. 哪种状态无法用治愈术";
			mes "治愈？";
			next;
			if (select("诅咒:沉默:混乱:黑暗") == 1)
				set .@cru_t,.@cru_t+10;

			mes "[Gabriel Valentine]";
			mes "10. 哪句话最能描述十字军？";
			next;
			if (select("准备结婚的人。:准备圣战的人。:准备圆满的人。:准备药剂的人。") == 2)
				set .@cru_t,.@cru_t+10;

		}
		mes "[Gabriel Valentine]";
		mes "做得好~";
		mes "首先让我";
		mes "看看你的结果。";
		next;
		mes "[Gabriel Valentine]";
		mes "" + strcharinfo(0) + "的分数";
		mes "是" + .@cru_t + "分……";
		if(.@cru_t == 100) {
			set CRUS_Q, 8;
			changequest 3011,3013;
			mes "太棒了！现在是";
			mes "参加下一项测试的时候。";
			next;
			mes "[Gabriel Valentine]";
			mes "去普隆德拉城堡";
			mes "见布莱恩特·皮约德。";
			mes "我会通知他";
			mes "接下来由他测试你。";
			close;
		}
		else if(.@cru_t == 90) {
			set CRUS_Q, 8;
			changequest 3011,3013;
			mes "做得好~ 现在是";
			mes "参加下一项测试的时候。";
			next;
			mes "[Gabriel Valentine]";
			mes "去普隆德拉城堡";
			mes "见布莱恩特·皮约德。";
			mes "我会通知他";
			mes "接下来由他测试你。";
			close;
		}
		else if (.@cru_t == 80 && CRUS_Q == 7) {
			set CRUS_Q,8;
			changequest 3011,3013;
			mes "看来你准备得很充分，这次我让你通过。";
			mes "快去参加下一项测试。";
			next;
			mes "[Gabriel Valentine]";
			mes "去普隆德拉城堡见布莱恩特·皮约德。";
			mes "我会通知他准备下一项测试。";
			close;
		}
		set CRUS_Q,7;
		if(checkquest(3011) != -1) {
			changequest 3011,3012;
		}
		mes "嗯……真遗憾。";
		mes "再多学习一些，";
		mes "然后重新参加测试，好吗？";
		next;
		mes "[Gabriel Valentine]";
		mes "别紧张，你需要了解很多才能通过测试。无论如何，我会在这里等你。准备好后再回来，好吗？";
		close;
	} 
	else if(CRUS_Q == 8 || CRUS_Q == 9) {
		mes "正如我之前说的，你该去普隆德拉城堡找布莱恩特·皮约德参加下一项测试。祝你好运，尽快成为十字军，好吗？";
		close;
	}
	else if(CRUS_Q == 10) {
		mes "你还在这里做什么？你已经完成所有测试。去和我们的领袖交谈，你现在已经准备好成为十字军了。";
		next;
		mes "[Gabriel Valentine]";
		mes "你很快会加入我们准备圣战。成为十字军后，也要继续虔诚信仰。";
		close;
	}
	mes "嗯……？";
	mes "看来你是";
	mes "有志成为十字军的人……";
	mes "但还没轮到我";
	mes "测试你。";
	next;
	mes "[Gabriel Valentine]";
	mes "完成其他测试，";
	mes "接受指示后再来找我。";
	mes "在那之前，";
	mes "回头见~";
	close;
}

// Crusader: 4th Purification Test
//============================================================
-	script	Patron Knight_	-1,{
	mes "[Bliant Piyord]";
	mes "欢迎。";
	if(BaseJob != Job_Swordman) {
		if(BaseJob == Job_Crusader) {
			mes "你的训练";
			mes "进行得怎么样？";
			next;
			mes "[Bliant Piyord]";
			mes "培养信仰。力量与纪律源于信仰。日复一日训练自己，成为伟大的十字军。";
			close;
		}
		else if(BaseJob == Job_Novice) {
			mes "我们是十字军，";
			mes "为即将到来的伟大圣战准备的圣洁战士。";
			next;
			mes "[Bliant Piyord]";
			mes "你有兴趣";
			mes "成为十字军吗？";
			mes "我们一直等待";
			mes "更多有能力的男女";
			mes "加入我们的行列。";
			next;
			mes "[Bliant Piyord]";
			mes "先作为剑士训练，准备好后再来。如果奥丁召唤你成为十字军，那就更好了。";
			close;
		}
		mes "我们是十字军，";
		mes "为即将到来的伟大圣战准备的圣洁战士。";
		next;
		mes "[Bliant Piyord]";
		mes "即使在相对和平的时代，我们的训练也不能停止。我们必须准备好迎接黑暗浪潮冲向人类的那一天……";
		close;
	}
	else if(CRUS_Q == 0) {
		mes "我们是十字军，";
		mes "为即将到来的伟大圣战准备的圣洁战士。";
		next;
		mes "[Bliant Piyord]";
		mes "你有兴趣";
		mes "成为十字军吗？";
		mes "我们一直等待";
		mes "更多有能力的男女";
		mes "加入我们的行列。";
		next;
		mes "[Bliant Piyord]";
		mes "要成为十字军，你必须训练到职业等级40。详情请与里面的领袖交谈。";
		next;
		mes "[Bliant Piyord]";
		mes "愿奥丁";
		mes "与你同在……";
		close;
	}
	else if(CRUS_Q == 8 || CRUS_Q == 9) {
		if (CRUS_Q == 8) {
			mes "很高兴";
			mes "见到你。";
			mes "现在是";
			mes "进行最终测试的时候。";
			next;
			mes "[Bliant Piyord]";
			mes "我叫布莱恩特·皮约德，也在为圣战做准备。一路来到这里一定很辛苦。";
			next;
			mes "[Bliant Piyord]";
			mes "这项测试会检验你的战斗技巧。只有战斗能力出众的人才能成为十字军。";
			next;
			mes "[Bliant Piyord]";
			mes "参加战斗测试，请带来";
			mes "1 ^3355FFHoly Water^000000. This will be used to purify you prior to taking the test.";
			if(checkquest(3013) != -1) {
				changequest 3013,3014;
			}
			next;
			mes "[Bliant Piyord]";
			mes "那么……";
			mes "我们要";
			mes "马上开始吗？";
			mes "还是需要时间";
			mes "准备自己？";
		}
		else {
			mes "你现在";
			mes "准备好测试了吗？";
			next;
			mes "[Bliant Piyord]";
			mes "想现在开始，还是仍需要时间准备？";
		}
		next;
		if (select("我想开始。:给我一些准备时间。") == 1) {
			if(getequipid(EQI_ACC_L) != 2608 && getequipid(EQI_ACC_R) != 2608) {
				mes "[Bliant Piyord]";
				mes "等等，你没有装备念珠。作为十字军，你必须随身携带念珠。";
				next;
				mes "[Bliant Piyord]";
				mes "带上念珠后";
				mes "再回来参加";
				mes "测试。";
				close;
			}
			else if(countitem(523) < 1) {
				mes "[Bliant Piyord]";
				mes "参加战斗测试，请准备一份^3355FF圣水^000000。";
				mes "我说过它是用来净化候选人的。";
				next;
				mes "[Bliant Piyord]";
				mes "准备好后回到这里。";
				mes "我会等你。";
				close;
			}
			delitem 523, 1; //Holy Water
			mes "[Bliant Piyord]";
			mes "那么，我会开始";
			mes "测试。你将用";
			mes "准备好的圣水";
			mes "进行净化。";
			next;
			mes "[Bliant Piyord]";
			mes "...............";
			next;
			mes "[Bliant Piyord]";
			mes "开始吧。";
			mes "去进入";
			mes "等候室。";
			mes "击败";
			mes "四个阶段出现的";
			mes "怪物。";
			close2;
			warp "job_cru",24,169;
			end;
		}
		mes "[Bliant Piyord]";
		mes "准备1份^3355FF圣水^000000参加战斗测试。正如我所说，它会在测试前净化你。";
		next;
		mes "[Bliant Piyord]";
		mes "准备好后再回来";
		mes "参加测试。";
		mes "我会等待。";
		mes "1 Holy Water.";
		mes "请不要迟到。";
		mes "我会在这里等你。";
		close;
	} 
	else if(CRUS_Q == 10) {
		mes "恭喜。";
		mes "你已经完成";
		mes "成为十字军所需的";
		mes "全部测试。";
		next;
		mes "[Bliant Piyord]";
		mes "去和里面的";
		mes "领袖交谈。";
		mes "欢迎你加入";
		mes "准备迎接";
		mes "即将到来的";
		mes "圣战的行列。";
		close;
	}
	mes "你不是正在努力成为十字军的人吗？";
	next;
	mes "[Bliant Piyord]";
	mes "还没轮到你";
	mes "参加我的测试。";
	mes "完成其他所有测试后";
	mes "再回来。";
	next;
	mes "[Bliant Piyord]";
	mes "很快再见。";
	mes "愿奥丁的祝福";
	mes "与你同在。";
	close;
}



// Actual tests
//============================================================

//----------------------------------------------------------------------------
// Endurance Test
//----------------------------------------------------------------------------
job_cru,1,1,1	script	Summoner#cr1	-1,{
OnTimer300000:
	donpcevent "Summoner#cr1::OnReset";
	end;

OnTimer300500:
	donpcevent "Summoner#cr1::OnEnd";
	end;

OnTimer301000:
	donpcevent "Summoner#cr1::OnStart";
	stopnpctimer;
	end;

OnInit:
	enablenpc "Summoner#cr1";
	monster "job_cru",94,45,"Mandragora",1020,1,"Summoner#cr1::OnDead";
	monster "job_cru",94,55,"Mandragora",1020,1,"Summoner#cr1::OnDead";

	goto L_QuestGiven;

N_PayonC:
	mes "^FF0000斐扬洞穴^000000";
	mes "^FF0000----------^000000" ;
	mes "嗯……似乎有个叫杰克的人想在弓箭手公会大厅和你谈谈。";
	mes " ";
	mes "我们越深入洞穴，感觉就越奇怪。";
	set nine_qset,4;
	goto L_QuestGiven;

///////Job list 10///////
N_JobList10:
	mes "[盖伊]";
	mes "好，这里有几个可以完成的任务。";
	next;
	menu "空白箱子",-,"^FF0000Eddga^000000",N_Eddga,"^FF0000Phreeoni^000000",N_Phreeoni,"^FF0000Maya^000000",N_Maya;

	mes "^FF0000空白箱子^000000";
	mes "^FF0000-------------^000000";
	mes "送往梦罗克的包裹";
	mes " ";
	mes "箱子上什么都没写，只有一张通知，要把它交给一个叫克雷格的人。";
	getitem 1082,1; //Delivery_Box_
	set ten_qset,1;
	goto L_QuestGiven;

N_Eddga:
	mes "^FF0000Eddga^000000";
	mes "^FF0000*****^000000";
	mes "老虎托尼嗑嗨了，正在破坏森林。";
	mes " ";
	mes "去‘隐藏的’猎人公会外找一个男人，他需要你的帮助。";
	set ten_qset,2;
	goto L_QuestGiven;

N_Phreeoni:
	mes "^FF0000Phreeoni^000000";
	mes "^FF0000********^000000";
	mes "他又大又粉红，快跑，躲起来！";
	mes " ";
	mes "有一天这家伙突然出现在某个洞穴里，看起来没那么强，但你会大吃一惊。去蚂蚁地狱外找一个叫卡拉尔的人。";
	set ten_qset,3;
	goto L_QuestGiven;

N_Maya:
	mes "^FF0000Maya^000000";
	mes "^FF0000****^000000";
	mes "可怕的东西！";
	mes " ";
	mes "这个半裸的怪物需要一支军队才能击倒，现在任务交给你了，祝你好运。去蚂蚁地狱后门外找一个叫杰妮的女孩。";
	set ten_qset,4;
	goto L_QuestGiven;
}

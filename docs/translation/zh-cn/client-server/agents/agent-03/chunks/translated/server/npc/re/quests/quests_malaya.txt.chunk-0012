		case 1:
			mes "我清楚记得这个故事。";
			mes "把我发现的事告诉Malaya的^0000FF古老传说讲述者^000000";
			mes "我发现的事。";
			close;
		case 2:
			callsub L_Record;
			close;
		}
	}
	end;

L_Record:
	mes "[百年前剑士留下的记录]";
	mes "与Bakonawa战斗后，我受了重伤";
	mes "于是来到了这里。";
	mes "我能做的只有";
	mes "把木偶放在某个地方，";
	mes "怪物就会过来。";
	next;
	mes "[一百年前剑士留下的记录]";
	mes "^0000FF有时变成孩子，甚至变成老妇人，^000000";
	mes "我知道^0000FFBakonawa^000000一直";
	mes "在暗中追杀我。";
	mes "由于怪物受到重伤，";
	next;
	mes "[Record left by a swordsman from a hundred years ago]";
	mes "** 它需要将近一百年";
	mes "Bakonawa需要吸收月亮的力量";
	mes "才能完全恢复力量。";
	mes "小心月亮消失的那一天。";
	next;
	mes "[Record left by a swordsman from a hundred years ago]";
	mes "Bakonawa终有一天";
	mes "会彻底失控。";
	mes "但需要将近一百年才能完全恢复力量。";
	mes "总会有人比我更强，";
	mes "能够击败这个邪恶生物。";
	next;
	mes "[Record left by a swordsman from a hundred years ago]";
	mes "我会相信多年后取代我的那个人……";
	next;
	mes "怎么会这样……";
	mes "Bakonawa变成老妇人时说的谎言";
	mes "为了向剑士复仇，";
	mes "多年后竟变成了传说。";
	next;
	mes "我发现Bakonawa";
	mes "不过是嗜血的怪物。";
	mes "我必须把知道的一切告诉";
	mes "Malaya的^0000FF古老传说讲述者^000000。";
	return;
}


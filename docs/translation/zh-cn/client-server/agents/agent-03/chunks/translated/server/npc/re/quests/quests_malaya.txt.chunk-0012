	}
}

malaya,265,274,5	script	Missing Person's Friend	577,{
	if (malaya_hi < 20) {
		mes "- 他似乎对你很警惕。-";
		close;
	}
	if (malaya_bakona2 < 2) {
		mes "[Missing Person's Friend]";
		mes "请找到";
		mes "我的朋友。";
		mes "我们当时一起玩球，";
		mes "我的朋友却突然消失了。";
		next;
		mes "[Missing Person's Friend]";
		mes "我相信他还活得好好的，";
		mes "就在某个地方。";
		close;
	} else if (malaya_bakona2 == 2) {
		if (countitem(6520) < 7) {
			mes "[Missing Person's Friend]";
			mes "你是在寻找七件^FF0000失踪者遗物^000000，";
			mes "属于我的朋友吗？";
			mes "我的朋友没有死！";
			close;
		}
		mes "[Missing Person's Friend]";
		mes "这些是我送给他的弹珠和玩具……";
		mes "这些显然是我朋友的^FF0000失踪者遗物^000000……";
		mes "我的朋友在哪里？";
		mes "把他带到这里来，现在就带他回来！";
		callsub L_Quest;
		delitem 6520,7; //Lost_Belongings
		erasequest 1181;
		setquest 1182;
		set malaya_bakona2,3;
		close;
	} else {
		mes "[Missing Person's Friend]";
		mes "把我的朋友带回来！";
		mes "现在就把我的朋友带回来！";
		mes "我的朋友还活着，";
		mes "这一切都是谎言，呜~";
		if (malaya_bakona2 == 3)
			callsub L_Quest;
		close;
	}

L_Quest:
	next;
	mes "留下哭泣的男孩，";
	mes "我们继续寻找失踪者的遗物吧。";
	mes "从Tiyanak那里取回三件^FF0000失踪者遗物^000000，";
	mes "然后交给^0000FF失踪者的儿子^000000。";
	return;
}


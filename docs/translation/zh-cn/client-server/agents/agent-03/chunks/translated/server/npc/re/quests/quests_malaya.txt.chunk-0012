malaya,283,265,4	script	Village Chief#bako2	580,{
	if (checkweight(1301,3) == 0) {
		mes "无法开始对话。你携带的物品太多了。-";
		close;
	}
	if (BaseLevel < 120) {
		mes "[Village Chief]";
		mes "我正急切需要援手，";
		mes "但你看起来";
		mes "太虚弱了。";
		next;
		mes "[Village Chief]";
		mes "等你变得足够强大，";
		mes "能够与Incubus匹敌时，";
		mes "再回来吧。";
		close;
	}
	if (malaya_hi < 20) {
		mes "- 他似乎对你很警惕。-";
		close;
	}
	if (malaya_bakona2 == 0) {
		if (malaya_bakona1 <= 5) {
			mes "[Village Chief]";
			mes "我不知道什么才是正确的决定。";
			mes "是与Bakonawa战斗，";
			mes "还是献上祭品让它平静下来。";
		} else {
			mes "[Village Chief]";
			mes "传说全都是谎言吗？";
			mes "看来一直以来所有村民";
			mes "都被那头卑劣的怪物操纵了。";
			next;
			mes "[Village Chief]";
		}
		mes "最近，受到Bakonawa伤害的人";
		mes "越来越多了。";
		next;
		mes "[Village Chief]";
		mes "有些村民失踪了，";
		mes "但我无法确认他们只是失踪，";
		mes "还是已经被Bakonawa";
		mes "杀害了。";
		next;
		mes "[Village Chief]";
		mes "我听说失踪者的遗物";
		mes "在Baryo Mahiwaga Field被发现了。";
		mes "请去那里寻找^0000FF失踪者遗物^000000，";
		mes "并交给";
		mes "失踪者的家人，";
		mes "数量按他们的要求来。";
		next;
		mes "[Village Chief]";
		mes "据说在Baryo Mahiwaga出没的";
		mes "^FF0000Tiyanak^000000携带着";
		mes "^0000FF失踪者遗物^000000。";
		next;
		switch(select("你自己去吧。:我这就去。")) {
		case 1:
			mes "[Village Chief]";
			mes "你让我想了很多。";
			mes "马上离开村子。";
			close;
		case 2:
			mes "[Village Chief]";
			mes "那就开始吧。首先，";
			mes "从Tiyanak那里取回两件^FF0000失踪者遗物^000000，";
			mes "然后替我交给^0000FF失踪者的父亲^000000。";
			mes "拜托你了。";
			set malaya_bakona2,1;
			setquest 1180;
			close;
		}
	} else if (malaya_bakona2 == 1) {
		mes "[Village Chief]";
		mes "从Baryo Mahiwaga Field出没的Tiyanak那里，";
		mes "取回两件^FF0000失踪者遗物^000000，";
		mes "然后替我交给^0000FF失踪者的父亲^000000。";
		mes "拜托你了。";
		close;
	} else if (malaya_bakona2 == 2) {
		mes "[Village Chief]";
		mes "从Tiyanak那里取回七件^FF0000失踪者遗物^000000，";
		mes "然后替我交给^0000FF失踪者的朋友^000000。";
		mes "拜托你了。";
		close;
	} else if (malaya_bakona2 == 3) {
		mes "[Village Chief]";
		mes "从Tiyanak那里取回三件^FF0000失踪者遗物^000000，";
		mes "然后替我交给^0000FF失踪者的儿子^000000。";
		mes "拜托你了。";
		close;
	} else if (malaya_bakona2 == 4) {
		mes "[Village Chief]";
		mes "从Tiyanak那里取回五件^FF0000失踪者遗物^000000，";
		mes "然后替我交给^0000FF失踪者的母亲^000000。";
		mes "拜托你了。";
		close;
	} else if (malaya_bakona2 == 5) {
		mes "[Village Chief]";
		mes "看来所有失踪者";
		mes "都被Bakonawa杀害了。";
		next;
		mes "[Villagers]";
		mes "杀掉Bakonawa！";
		mes "我们自己来消灭这头怪物！";
		next;
		mes "[Village Chief]";
		mes "看来我们再也无法";
		mes "举行仪式让Bakonawa平静下来了。";
		next;
		mes "[Village Chief]";
		mes "年轻占卜师正在寻求你的帮助，";
		mes "他说月亮的能量似乎很异常。";
		erasequest 1184;
		setquest 1185;
		set malaya_bakona2,6;
		if (!VIP_SCRIPT || vip_status(VIP_STATUS_ACTIVE))
			getitem 12700,7; //Insideout_Shirt
		else
			getitem 12700,5; //Insideout_Shirt
		close;
	} else if (malaya_bakona2 == 6) {
		mes "[Village Chief]";
		mes "年轻占卜师正在寻求你的帮助，";
		mes "他说月亮的能量似乎很异常。";
		close;
	} else if (malaya_bakona2 == 7) {
		mes "[Village Chief]";
		mes "我知道月亮消失时";
		mes "很久以前曾发生过可怕的事情。";
		mes "希望月亮能在你的努力下";
		mes "恢复力量。";
		close;
	} else if (malaya_bakona2 == 8) {
		mes "[Village Chief]";
		mes "我会告诉年轻占卜师";
		mes "来帮助你。";
		mes "但在此之前，";
		mes "你必须立即做一件事。";
		next;
		mes "[Village Chief]";
		mes "我们不知道Bakonawa什么时候会发动攻击，";
		mes "所以必须在村子入口和洞穴附近";
		mes "设置陷阱。";
		next;
		mes "[Village Chief]";
		mes "如果你能帮助我们，我会非常感激。";
		mes "我已经派出工人";
		mes "前往设置陷阱的地点，";
		mes "你只需要去大约5个地方。";
		next;
		switch(select("听起来工作量太大了。:没问题。")) {
		case 1:
			mes "[Village Chief]";
			mes "这次行动对我们来说事关生死，";
			mes "可你却轻易拒绝，";
			mes "就像这只是某种杂务一样……";
			next;
			mes "[Village Chief]";
			mes "真是个英雄！";
			close;
		case 2:
			mes "[Village Chief]";
			mes "第一个陷阱将设置在";
			mes "Baryo Mahiwaga Field，";
			mes "靠近村子入口的地方。^0000FF粗鲁工人^000000";
			mes "会在那里等你，他会提供很大帮助。";
			erasequest 1187;
			setquest 1188;
			set malaya_bakona2,9;
			close;
		}
	} else if (malaya_bakona2 == 9) {
		mes "[Village Chief]";
		mes "第一个陷阱将设置在";
		mes "Baryo Mahiwaga Field，";
		mes "靠近村子入口的地方。^0000FF粗鲁工人^000000";
		mes "会在那里等你，他会提供很大帮助。";
		close;
	} else if (malaya_bakona2 == 10) {
		mes "[Village Chief]";
		mes "第二个陷阱将设置在";
		mes "连接Baryo Mahiwaga Field";
		mes "与Bakonawa Lake的地方附近。";
		mes "^0000FFGrumpy Worker^000000";
		mes "会在那里等你，他会提供很大帮助。";
		close;
	} else if (malaya_bakona2 == 11) {
		mes "[Village Chief]";
		mes "第三个陷阱将设置在";
		mes "Bakonawa Lake入口附近。";
		mes "^0000FFCowardly Worker^000000";
		mes "会在那里等你，他会提供很大帮助。";
		close;
	} else if (malaya_bakona2 == 12) {
		mes "[Village Chief]";
		mes "第四个陷阱也将设置在";
		mes "Bakonawa Lake入口附近。";
	mes "^0000FF忧郁的工人^000000会等着你。";
		mes "他会提供很大帮助。";
		close;
	} else if (malaya_bakona2 == 13) {
		mes "[Village Chief]";
		mes "第五个陷阱也将设置在";
		mes "Bakonawa Lake入口附近。";
		mes "^0000FFSentimental Worker^000000";
		mes "会在那里等你，他会提供很大帮助。";
		close;
	} else if (malaya_bakona2 == 14) {
		mes "[Village Chief]";
		mes "看来陷阱都设置好了。";
		mes "我们刚刚结束了村民会议，";
		mes "讨论该如何对付Bakonawa。";
		next;
		mes "[Village Chief]";
		mes "我们已经决定";
		mes "要与Bakonawa战斗。";
		mes "请帮助我们";
		mes "攻击它的巢穴。";
		erasequest 1193;
		set malaya_bakona2,15;
		getexp 1000000,600000;
		if (!VIP_SCRIPT || vip_status(VIP_STATUS_ACTIVE))
			getitem 6497,7; //Lesser_Agimat
		else
			getitem 6497,5; //Lesser_Agimat
		close;
	} else if (malaya_bakona2 == 15) {
		mes "[Village Chief]";
		if (malaya_bakona1 < 7) {
			mes "有机会的话，你能去拜访^0000FFOld Legend Teller^000000吗？";
			mes "我想你应该能帮助他。";
			mes "这是我的请求。";
			next;
			mes "[Village Chief]";
			mes "谢谢你。";
		}
		mes "请想想那些无数的受害者，";
		mes "为了他们";
		mes "击败Bakonawa。";
		close;
	}
}


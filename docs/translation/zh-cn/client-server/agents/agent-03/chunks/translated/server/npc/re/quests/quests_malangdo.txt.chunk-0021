		mes "[Leader]";
		mes "如果还需要游戏规则方面的帮助，随时回来。猫咪经理也能提供一些规则说明。";
		close;
	}

	// Starting Flag Points (default 5).
	set .@flag_point,5;
	setarray .@flag_point_cat[1],5,5,5,5,5;

	// Cat players' names.
	setarray .@npc_name$[1],
		"Debong#gamer","Seichi#gamer","Libs#gamer","Row#gamer","YongYong#gamer";
	setarray .@cat_name$[1],
		"Debong","Seichi","Annoying Libs","Row","YongYong";
	setarray .@cat_desc$[1],
		" who likes to pick hair"," the observer",""," who likes to show off"," who likes to droop";

	// Emotions displayed when cats' flags not waved.
	setarray .@cat_emote[1],
		ET_DELIGHT,ET_STARE_ABOUT,ET_FRET,ET_BEST,ET_CONFUSE;

	// .@cat_action[] when cats' flags are not waved.
	setarray .@cat_emotes$[1],
		"1|3|5|7",	// Picking hair
		"2|4|6|8",	// Looking around
		"1|3|6|8",	// Getting annoyed
		"2|4|5|7",	// Showing off
		"3|4|5|6";	// Drooping

	while(1) {
		for(set .@i,1; .@i<=5; set .@i,.@i+1)
			set .@cat_action[.@i], ((.@flag_point_cat[.@i])?rand(1,8):0);

		switch(.@cat_action[1]) {
			case 0: set .@cat_mes$[1], "所有点数用完，什么也做不了"; break;
			case 1: set .@cat_mes$[1], "专心挑毛，顾不上游戏"; break;
			case 2: set .@cat_mes$[1], "睁着圆眼睛四处张望"; break;
			case 3: set .@cat_mes$[1], "挑前爪附近的毛"; break;
			case 4: set .@cat_mes$[1], "尾巴拍打地面，开始烦躁"; break;
			case 5: set .@cat_mes$[1], "一边张望一边整理毛发"; break;
			case 6: set .@cat_mes$[1], "向领队猫炫耀前爪"; break;
			case 7: set .@cat_mes$[1], "平静地整理腹部的毛"; break;
			case 8: set .@cat_mes$[1], "满脸惬意地耷拉着"; break;
		}
		switch(.@cat_action[2]) {
			case 0: set .@cat_mes$[2], "所有点数用完，什么也做不了"; break;
			case 1: set .@cat_mes$[2], "挑前爪附近的毛"; break;
			case 2: set .@cat_mes$[2], "睁着圆眼睛四处张望"; break;
			case 3: set .@cat_mes$[2], "对领队猫感到烦躁"; break;
			case 4: set .@cat_mes$[2], "观察飞来飞去的苍蝇"; break;
			case 5: set .@cat_mes$[2], "得意地炫耀刚挑出的毛"; break;
			case 6: set .@cat_mes$[2], "好奇地观察领队猫的尾巴"; break;
			case 7: set .@cat_mes$[2], "用耷拉的眼睛看着你"; break;
			case 8: set .@cat_mes$[2], "用奇怪的目光打量你"; break;
		}
		switch(.@cat_action[3]) {
			case 0: set .@cat_mes$[3], "所有点数用完，什么也做不了"; break;
			case 1: set .@cat_mes$[3], "尾巴拍打地面，开始烦躁"; break;
			case 2: set .@cat_mes$[3], "好奇地观察领队猫的尾巴"; break;
			case 3: set .@cat_mes$[3], "一边挑毛一边烦躁"; break;
			case 4: set .@cat_mes$[3], "耷拉着脸抓挠"; break;
			case 5: set .@cat_mes$[3], "抓住飞来的苍蝇并炫耀"; break;
			case 6: set .@cat_mes$[3], "疲惫地变得烦躁"; break;
			case 7: set .@cat_mes$[3], "一边张望一边整理毛发"; break;
			case 8: set .@cat_mes$[3], "对领队猫感到烦躁"; break;
		}
		switch(.@cat_action[4]) {
			case 0: set .@cat_mes$[4], "所有点数用完，什么也做不了"; break;
			case 1: set .@cat_mes$[4], "平静地整理腹部的毛"; break;
			case 2: set .@cat_mes$[4], "向领队猫炫耀前爪"; break;
			case 3: set .@cat_mes$[4], "疲惫地变得烦躁"; break;
			case 4: set .@cat_mes$[4], "抓住飞来的苍蝇并炫耀"; break;
			case 5: set .@cat_mes$[4], "炫耀迷人的尾巴"; break;
			case 6: set .@cat_mes$[4], "耷拉着嘟囔"; break;
			case 7: set .@cat_mes$[4], "得意地炫耀刚挑出的毛"; break;
			case 8: set .@cat_mes$[4], "用奇怪的目光打量你"; break;
		}
		switch(.@cat_action[5]) {
			case 0: set .@cat_mes$[5], "所有点数用完，什么也做不了"; break;
			case 1: set .@cat_mes$[5], "和自己的尾巴打架"; break;
			case 2: set .@cat_mes$[5], "用后脚抓挠"; break;
			case 3: set .@cat_mes$[5], "满脸惬意地耷拉着"; break;
			case 4: set .@cat_mes$[5], "耷拉着脸打量你"; break;
			case 5: set .@cat_mes$[5], "耷拉着脸抓挠"; break;
			case 6: set .@cat_mes$[5], "耷拉着嘟囔"; break;
			case 7: set .@cat_mes$[5], "懒洋洋地躺着~"; break;
			case 8: set .@cat_mes$[5], "什么也没做"; break;
		}

		switch(rand(3)) {
			case 0: set .@tip$, "用‘观察猫咪’可以预测猫咪是否挥旗。"; break;
			case 1: set .@tip$, "选择‘挥旗’会扣除 1 点旗帜点数。"; break;
			case 2: set .@tip$, "选择‘等待’可以查看结果并进入下一局。"; break;
		}
		while(1) {
			mes "[Leader]";
			mes "猫咪们都准备好了。";
			mes "你要做什么？";
			mes " ";
			mes "提示：^F86A08"+.@tip$+"^000000";
			next;
			set .@choice, select("观察猫咪:挥旗:等待");
			switch(.@choice) {
			case 1:
				mes "观察猫咪……";
				next;
				for(set .@i,1; .@i<=5; set .@i,.@i+1) {
					mes "[------ Observing cats ------]";
					mes .@cat_name$[.@i]+.@cat_desc$[.@i]+" ^FF0000"+.@cat_mes$[.@i]+"^000000.";
					next;
				}
				break;
			case 2:
				set .@flag_point, .@flag_point-1;
				set .@you_flag,1;
				break;
			case 3:
				break;
			}
			if (.@choice != 1) break;
		}
		set .@round, .@round+1;
		set .@rounds_nowave, .@rounds_nowave+1;
		if (.@you_flag == 1) {
			set .@you_flag$, "你挥了旗";
			set .@emotion[0], ET_FLAG;
		} else {
			set .@you_flag$, "你没有挥旗";
			set .@emotion[0], ET_PROFUSELY_SWEAT;
		}
		for(set .@i,1; .@i<=5; set .@i,.@i+1) {
			if (.@flag_point_cat[.@i] == 0) {
				set .@cat_flag$[.@i], "旗帜点数不足，无法挥旗";
				set .@emotion[.@i], ET_DELIGHT;
			} else {
				if (compare(.@cat_emotes$[.@i],""+.@cat_action[.@i])) {
					set .@cat_flag$[.@i], "没有挥旗";
					set .@emotion[.@i], .@cat_emote[.@i];
				} else {
					set .@cat_flag$[.@i], "挥了旗";
					set .@flag_point_cat[.@i], .@flag_point_cat[.@i]-1;
					set .@cat_flags_waved, .@cat_flags_waved+1;
					set .@emotion[.@i], ET_FLAG;
				}
			}
		}
		mes "[Leader]";
		mes "第 ^C1653E"+.@round+"^000000 局结果……";
		next;
		mes "[Leader]";
		mes "~ 旗帜游戏挑战者 "+strcharinfo(0)+" ~";
		mes "^FF0000"+.@you_flag$+"^000000 for game ^C1653E"+.@round+"^000000.";
		mes "剩余 "+.@flag_point+" 点旗帜点数。";
		emotion .@emotion[0], playerattached();
		next;
		for(set .@i,1; .@i<=5; set .@i,.@i+1) {
			mes "[Leader]";
			mes "~ "+.@cat_name$[.@i]+.@cat_desc$[.@i]+" ~";
			mes "^FF0000"+.@cat_flag$[.@i]+"^000000 the flag for game ^C1653E"+.@round+"^000000.";
			mes .@flag_point_cat[.@i]+" Flag Point remaining for "+.@cat_name$[.@i]+".";
			emotion .@emotion[.@i], getnpcid(0, .@npc_name$[.@i]);
			next;
		}
		if (.@you_flag == 1) {
			set .@rounds_nowave,0;
			if (.@cat_flags_waved == 0) {
				// You win.
				break;
			} else if (.@flag_point == 0) {
				// You lose.
				mes "[Leader]";
				mes "你已用完所有旗帜点数。";
				next;
				break;
			} else {
				set .@you_flag,0;
				mes "[Leader]";
				mes "挥旗失败。";
				mes .@flag_point+" Flag Point remaining.";
				next;
				mes "[Leader]";
				mes "进入下一局游戏吧。";
				next;
				mes "... ... ... ...";
				next;
			}
		} else {
			if (.@cat_flags_waved == 5) {
				mes "[Leader]";
				mes "恭喜"+strcharinfo(0)+"。你成功没有挥旗。";
				next;
				mes "[Leader]";
				mes "但是！这是挥旗游戏，所以这不算数。";
				next;
			} else {
				if (.@rounds_nowave == 10) {
					set .@rounds_nowave,0;
					set .@flag_point, .@flag_point-1;
					mes "[Leader]";
					mes "根据官方旗帜游戏规则，你连续 10 局没有挥旗，将扣除 1 点旗帜点数。";
					next;
					if (.@flag_point == 0) {
						// You lose.
						mes "[Leader]";
						mes "你已用完所有旗帜点数。";
						next;
						break;
					} else {
						mes "[Leader]";
						mes .@flag_point+" Flag Point remaining.";
						next;
					}
				} else {
					mes "[Leader]";
					mes "第"+.@round+"局正常结束。再过"+(10-.@rounds_nowave)+"局后将扣分。";
					next;
				}
				mes "[Leader]";
				mes "进入下一局游戏吧。";
				next;
				mes "... ... ... ...";
				next;
			}
		}
		set .@cat_flags_waved,0;
	}
	mes "[Leader]";
	mes "挥旗游戏结束了。";
	next;
	mes "[Leader]";
	mes "最终结果！！";
	mes "经过"+.@round+"局，"+strcharinfo(0)+"还剩"+.@flag_point+"点旗帜点数。";
	mes "... ... ...";
	next;
	if (.@you_flag == 1 && .@cat_flags_waved == 0) {
		setquest 5073;
		if (.@flag_point_cat[1]+.@flag_point_cat[2]+.@flag_point_cat[3]+.@flag_point_cat[4]+.@flag_point_cat[5] < 5) {
			getitem 12636,3; //Malang_Sp_Can
			mes "[Leader]";
			mes "恭喜。你赢得了挥旗游戏。";
			next;
			mes "[Leader]";
			mes "不过，因为你在游戏中没有积极参与，只奖励 3 个罐头食品。";
		} else {
			switch(.@flag_point) {
				case 0: set .@cans,5; break;
				case 1: set .@cans,7; break;
				case 2: set .@cans,10; break;
				case 3: set .@cans,15; break;
				case 4: set .@cans,20; break;
			}
			getitem 12636, .@cans; //Malang_Sp_Can
			mes "[Leader]";
			mes "恭喜。你赢得了挥旗游戏，奖励"+.@cans+"个罐头食品。";
		}
		next;
		mes "[Leader]";
		mes "希望你明天能赢到更多罐头食品。";
		close;
	}
	mes "[Leader]";
	mes "挥旗失败……";
	mes "... ... ... ...";
	next;
	setquest 5073;
	switch(rand(1,13)) {
		case 1: setquest 5074; break;
		case 2: setquest 5075; break;
		case 3: setquest 5076; break;
		case 4: setquest 5077; break;
		case 5: setquest 5078; break;
		case 6: setquest 5079; break;
		case 7: setquest 5080; break;
		case 8: setquest 5081; break;
		case 9: setquest 5082; break;
		case 10: setquest 5083; break;
		case 11: setquest 5085; break;
		case 12: setquest 5087; break;
		case 13: setquest 5089; break;
	}
	mes "领队毫不犹豫地给你一张纸条。你现在必须按要求行动。";
	close;
}


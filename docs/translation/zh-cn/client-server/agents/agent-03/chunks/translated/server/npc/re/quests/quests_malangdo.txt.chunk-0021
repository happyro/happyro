mal_in01,155,222,2	script	Uneet#gamer	890,{
	set .@playtime, checkquest(5069,PLAYTIME);
	if (.@playtime == 0 || .@playtime == 1) {
		mes "[Uneet]";
		mes "哇呜~真忙的一天~";
		mes "哦，你就是获得荣誉证书的人？";
		next;
		mes "[Uneet]";
		mes "每天都有更多订单。啊！！再给我一些人手！！";
		close;
	} else if (.@playtime == 2) {
		mes "[Uneet]";
		mes "喵~嗡~证书完成！！";
		next;
		mes "[Uneet]";
		mes "我已经把你的证书交给猫咪游戏主管了！去确认吧~";
		next;
		mes "[Uneet]";
		mes "请……无论走到哪里都带着它。";
		close;
	} else if (malang_gamer < 19) {
		mes "[Uneet]";
		mes "我是猫。喵~嗡~";
		mes "我看起来像羊，是因为太忙没时间剃毛。";
		mes "这不是我的错……";
		close;
	} else {
		mes "[Uneet]";
		mes "喵~嗡~别打扰我休息。";
		mes "我平时很忙……";
		mes "别碰我。";
		next;
		mes "[Uneet]";
		mes "我现在有点胖，但你也该看看自己。哈哈……";
		close;
	}
	end;
}


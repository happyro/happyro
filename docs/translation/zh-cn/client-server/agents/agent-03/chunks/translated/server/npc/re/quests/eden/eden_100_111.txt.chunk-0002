						}
						else if (checkquest(13025,HUNTING) == 2) {
							cutin "gelca03",2;
							mes "伊甸园守护爱、正义和米德加尔特！万岁！";
							mes "这会成为美好回忆。";
							callsub S_Quest,13025,13026,106000,148000;
						}
						else {
							cutin "°øÁßµô¸®ÅÍÄ«µå",3;  //flying_deleter_card
							mes "一位客户在熔岩地城跳舞给恋人看。有一天，他们跳舞时遭到了毁灭者袭击。";
							next;
							mes "[Gelkah]";
							mes "袭击毁掉了舞蹈，最终也毁掉了他们的关系，因为男方责怪女方遭到袭击。";
							next;
							mes "[Gelkah]";
							mes "现在她把责任归咎于毁灭者，所以提出了这个委托。请消灭^FF000030飞行毁灭者^000000。";
							callsub S_Quest,13026,13025;
						}
					}
					break;
				case 5:
					mes "这是来自米德加尔特各地的其他委托列表。";
					next;
					switch( select( "猎杀洛丽露丽 - 尼夫海姆", "猎杀美杜莎 - 梦罗克", "猎杀阿努比斯 - 斯芬克斯" ) ) {
						mes "[Gelkah]";
					case 1:
						if (checkquest(13041,PLAYTIME) == 0)
							mes "我觉得你应该休息一下。冒险者也需要休息，对吧？";
						else if (checkquest(13040,HUNTING) == 1) {
							cutin "·Î¸®·ç¸®Ä«µå",3;  //loli_ruri_card
							mes "伊甸园计划发布通知，不再派遣未成熟的冒险者执行夜间委托，因为太危险。";
							next;
							mes "[Gelkah]";
							mes "真不明白他们为什么策划这种^FF0000胡闹^000000……他们真的懂冒险吗？";
							next;
							mes "[Gelkah]";
							mes "在收到更多荒唐委托前，我们先接受这个简单委托吧。请消灭尼夫海姆的^FF000030洛丽露丽^000000。";
							next;
							cutin "gelca02",2;
							mes "[Gelkah]";
							mes "完成委托后请告诉我。";
						}
						else if (checkquest(13040,HUNTING) == 2) {
							mes "你精神受创了吗？很高兴你平安回来。";
							mes "这会是一次很好的经历。";
							callsub S_Quest,13040,13041,112000,186500;
						}
						else {
							cutin "·Î¸®·ç¸®Ä«µå",3;  //loli_ruri_card
							mes "一个秘密组织请求伊甸园保护他们免受洛丽露丽侵扰，因为他们相信洛丽露丽拥有精神力量。";
							next;
							mes "[Gelkah]";
							mes "他们说会以治疗疲惫的伊甸园冒险者作为报酬，但我们不确定他们是否会兑现。";
							next;
							mes "[Gelkah]";
							mes "不管怎样，我们应接受这个简单委托。请消灭尼夫海姆的^FF000030洛丽露丽^000000。";
							callsub S_Quest,13041,13040;
						}
						break;
					case 2:
						if (checkquest(13043,PLAYTIME) == 0)
							mes "冒险很重要，但休息也很重要。";
						else if (checkquest(13042,HUNTING) == 1) {
							cutin "¸ÞµÎ»çÄ«µå",3;  //medusa_card
							mes "我不知道师父为什么喜欢这种委托。他还常说对冒险者来说任何委托都是好委托……";
							next;
							mes "[Gelkah]";
							mes "请消灭梦罗克西部洞窟的^FF000030美杜莎^000000。";
							next;
							cutin "gelca01",2;
							mes "[Gelkah]";
							mes "完成委托后请告诉我。";
						}
						else if (checkquest(13042,HUNTING) == 2) {
							mes "梦罗克海滩怎么样？别只顾委托，也四处看看。";
							mes "一定会是很好的经历。";
							callsub S_Quest,13042,13043,106000,148000;
						}
						else {
							cutin "¸ÞµÎ»çÄ«µå",3;  //medusa_card
							mes "这是来自艾尔贝塔发型师的委托。他想知道美杜莎头上的蛇是真蛇还是发饰……";
							next;
							mes "[Gelkah]";
							mes "显然是真蛇，但我们没理由打碎这个疯狂家伙的梦想，对吧？";
							next;
							mes "[Gelkah]";
							mes "师父接受这个委托只是因为它很疯狂。请消灭梦罗克西部洞窟的^FF000030美杜莎^000000。";
							callsub S_Quest,13043,13042;
						}
						break;
					case 3:
						if (checkquest(13045,PLAYTIME) == 0)
							mes "斯芬克斯委托完成了。请休息一下。";
						else if (checkquest(13044,HUNTING) == 1) {
							cutin "¾Æ´©ºñ½ºÄ«µå",3;  //anubis_card
							mes "我应该亲自调查客户，但现在请先消灭斯芬克斯地下城4楼的^FF000020阿努比斯^000000。";
							next;
							cutin "gelca01",2;
							mes "[Gelkah]";
							mes "完成委托后请告诉我。";
						}
						else if (checkquest(13044,HUNTING) == 2) {
							cutin "gelca02",2;
							mes "斯芬克斯地下城真像迷宫。";
							mes "这会是很好的经历。";
							callsub S_Quest,13044,13045,112000,186500;
						}
						else {
							cutin "¾Æ´©ºñ½ºÄ«µå",3;  //anubis_card
							mes "一位匿名委托人请求清理斯芬克斯地下城的魔物，因为冒险者已经很少前往梦罗克。那里的魔物似乎正在肆虐。";
							next;
							mes "[Gelkah]";
							mes "请消灭斯芬克斯地下城4楼的^FF000020阿努比斯^000000。";
							callsub S_Quest,13045,13044;
						}
					}
				}
				break;
			case 2:
				if (para_100lv02 < 20) {
					.@ran = rand(1,3);
					if (.@ran == 1)
						mes "我们忙于处理大量委托，这是我第一次承受这么大压力。";
					else if (.@ran == 2)
						mes "我以为伊甸园很忙，但没想到会这么忙。我作为冒险者应该多做些事！";
					else {
						cutin "gelca02",2;
						mes "真希望能喝一杯新鲜果汁……";
					}
				}
				else if (para_100lv02 < 40) {
					.@ran = rand(1,3);
					if (.@ran == 1) {
						cutin "gelca03",2;
						mes "冒险者有时会带回委托地点的特殊物品或战利品。真不错！";
					}
					else if (.@ran == 2)
						mes "如果有好东西，"+ strcharinfo(0) +"我会尽量给你一些。但冒险者太多，不一定够分。";
					else
						mes "处理文件一定很困难。还是在外面实地行动轻松。";
				}
				else if (para_100lv02 < 60) {
					if (para_100lv01 > 3) {
						.@ran = rand(1,3);
						if (.@ran == 1)
							mes "有好东西我会告诉你。";
						else if (.@ran == 2)
							mes "你习惯这些委托了吗？我居然在指导冒险者，而不是自己接委托，真奇怪。";
						else
							mes "从格拉斯特海姆收到委托后，一次完成一个就好。";
					}
					else {
						cutin "gelca03",2;
						mes "我很忙，但你清理了这么多委托，"+ strcharinfo(0) +"，我很感激。让我看看。我从一位冒险者那里得到了一些他完成委托时获得的好食物。";
						next;
						mes "[Gelkah]";
						mes "糟糕，我全吃完了？好吧，只剩一个。稍后再来吧！";
						para_100lv01 = 4;
						getitem 608,1;// Seed_Of_Yggdrasil
					}
				}
				else if (para_100lv02 < 80) {
					cutin "gelca03",2;
					if (para_100lv01 > 4)
						mes "Cheer up! "+ strcharinfo(0) +" I'm not sure if he thinks of you as his pupil. He is just out of control.";
					else {
						mes "高效完成委托时会收到很多礼物。来，把这个当奖励。";
						para_100lv01 = 5;
						getitem 607,1;// Yggdrasilberry
					}
				}
				else if (para_100lv02 > 100) {
					mes "和师父一起工作很辛苦，但也很有趣，对吧，"+ strcharinfo(0) +"？";
					next;
					switch( select( "我讨厌那个暴脾气的笨蛋。", "我希望你成为师父。", "我会跟随你参加任何战斗。" ) ) {
						mes "[Gelkah]";
					case 1:
						mes "我理解你。我第一次在梦罗克村遇到师父时就和他打了一架。";
						next;
						mes "[Gelkah]";
						mes "我第一次见他时他差点哭了。假装输给他很难。请保密。";
						emotion ET_SMILE;
						break;
					case 2:
						if (Sex == SEX_MALE)
							mes "我不确定自己适合那份工作。而且……";
						else
							mes "抱歉这么说，但我现在以及永远都是师父唯一的弟子……他说^FF0000我不需要丑陋的女弟子^000000，但我仍会跟着他。";
						break;
					case 3:
						cutin "gelca04",2;
						mes "糟糕……请别这样。抱歉，请替我对师父保密。我太粗心了。";
						emotion ET_SHY;
						break;
					}
					next;
					cutin "gelca03",2;
					mes "[Gelkah]";
					if (para_100lv01 > 5)
						mes "剩余委托加油。";
					else {
						mes "剩余委托加油。^FF0000师父说有话要对你说。^000000";
						para_100lv01 = 6;
					}
				}
				else
					mes "抱歉，我有点忙。稍后再聊好吗？";
				break;
			case 3:
				cutin "gelca03",2;
				mes "你带来善意通行证了吗？";
				next;
				if (countitem(6549) > 0) {// Courtesy_Ticket
					if (select( "^FF0000善意通行证^000000？", "用通行证兑换奖励。" ) == 1) {
						mes "[Gelkah]";
						mes "听起来很幼稚，对吧？它的形状就像我们小时候玩的卡片。";
						next;
						if (select( "卡片？那是什么？", "呃，是啊，那很好玩……" ) == 1) {
							cutin "gelca02",2;
							mes "[Gelkah]";
							mes "抱歉……这大概只有我们村子流行。扔出去、加热，然后让它飞起来。";
							emotion ET_SORRY;
							next;
						}
						cutin "gelca01",2;
						mes "[Gelkah]";
						mes "如你所见，这是师父亲手制作并印了画像的卡片。他曾四处寻找制作卡片的纸张材料。";
						next;
						cutin "gelca02",2;
						mes "[Gelkah]";
						mes "如果没有妥善归档，寻找纸张的委托就会被列入委托清单。";
						next;
						mes "[Gelkah]";
						mes "师父虽然看起来不像，但其实很善良。他用这些卡片奖励努力的冒险者。";
						next;
						cutin "gelca01",2;
						mes "[Gelkah]";
						mes "使用1、10、20或30张卡片，可以听冒险故事或兑换战利品。";
						next;
						mes "[Gelkah]";
						mes "听冒险者的故事会是很好的经历。我们从师父那里听过许多冒险故事。";
						next;
						mes "[Gelkah]";
						mes "如果你已经成熟到不需要委托，请注意不能使用通行证。";
					}
					else {
						mes "[Gelkah]";
						mes "你想怎么使用这张通行证？";
						next;
						if (select( "兑换奖励", "听故事并获得经验" ) == 1) {
							cutin "gelca03",2;
							mes "[Gelkah]";
							mes "你可以从袋子里挑选战利品。即使拿到不想要的东西，也请不要失望。要兑换多少张？";
							next;
							.@amount = select( "兑换1张^FF0000善意通行证^000000", "兑换10张^FF0000善意通行证^000000" ) == 1 ? 1 : 10;
							mes "[Gelkah]";
							mes "请给我通行证，然后把手伸进袋子挑选。";
							next;
							if (countitem(6549) < .@amount) {// Courtesy_Ticket
								mes "[Gelkah]";
								mes "^FF0000善意通行证^000000不足。";
							}
							else {
								mes "挑选中";
								next;
								.@ran = rand(1,1000);
								if (.@amount == 1) {
									if (.@ran <= 100)
										setarray .@item[0],505,2;// Blue_Potion
									else if (.@ran <= 200)
										setarray .@item[0],547,10;// White_Slim_Potion
									else if (.@ran == 333)
										setarray .@item[0],603,1;// Old_Blue_Box
									else if (.@ran == 777)
										setarray .@item[0],617,1;// Old_Violet_Box
									else
										setarray .@item[0],547,5;// White_Slim_Potion
								}
								else {
									if (.@ran <= 100)
										setarray .@item[0],608,1;	// Seed_Of_Yggdrasil
									else if (.@ran <= 200)
										setarray .@item[0],547,100;	// White_Slim_Potion
									else if (.@ran >= 300 && .@ran <= 399)
										setarray .@item[0],603,1;	// Old_Blue_Box
									else if (.@ran >= 600 && .@ran <= 650)
										setarray .@item[0],616,1;	// Old_Card_Album
									else if (.@ran >= 700 && .@ran <= 800)
										setarray .@item[0],617,1;	// Old_Violet_Box
									else
										setarray .@item[0],547,60;	// White_Slim_Potion
								}
								delitem 6549,.@amount;// Courtesy_Ticket
								getitem .@item[0], .@item[1];
								mes "你把手伸进袋子，抓到^0000FF"+ .@item[1] +" "+ getitemname(.@item[0]) +"^000000。";
								next;
								if (.@amount == 10)
									cutin "gelca03",2;
								mes "[Gelkah]";
				mes "好好利用它。";
							}
						}
						else {
							mes "[Gelkah]";
							mes "好，我用善意通行证给你讲个故事。";
							next;
							switch( select( "交出^FF000010^000000张善意通行证", "交出^FF000020^000000张善意通行证", "交出^FF000030^000000张善意通行证" ) ) {
								mes "[Gelkah]";
							case 1:
								if (countitem(6549) < 10)// Courtesy_Ticket
									mes "你的善意通行证不足。";
								else {
									.@story = rand(1,3);
									if (.@story == 1) {
										cutin "gelca02",2;
										mes "你见过艾尔贝塔附近的沉船吗？";
										next;
										mes "我和罗特师父深入沉船，与名为^FF0000德雷克^000000的怪物战斗。那天我决心成为最棒的冒险者。";
										.@exp = 200000;
										.@jexp = 148000;
									}
									else if (.@story == 2) {
										cutin "gelca03",2;
										mes "有一次，我和师父去了梦罗克西边的洞窟，看到了美杜莎怪物……";
										next;
										mes "天啊，他脸上的表情真是无价之宝！";
										emotion ET_BIGTHROB;
										emotion ET_THINK, playerattached();
										.@exp = 180000;
										.@jexp = 168000;
									}
									else {
										mes "我曾在普隆德拉北方的迷宫里迷路，以为永远在绕圈，最后终于走了出来。";
										next;
										mes "传说如果在那座迷宫迷路，就会变成其中一只怪物。";
										.@exp = 220000;
										.@jexp = 128000;
									}
									if (JobLevel < 6)
										.@jexp = 106000;
									getexp .@exp,.@jexp;
									delitem 6549,10;
									para_100lv02 += 1;
								}
								break;
							case 2:
								if (countitem(6549) < 20)// Courtesy_Ticket
									mes "你的善意通行证不足。";
								else {
									.@story = rand(1,3);
									if (.@story == 1) {
										cutin "gelca04",2;
										mes "我曾找到一条去斐扬的秘密路线……只有情侣能去，但我们中有人仍知道怎么走。";
										next;
										mes "没有伴侣去那里也没什么用，不过算了。";
										emotion ET_THROB;
										.@exp = 550000;
										.@jexp = 340000;
									}
									else if (.@story == 2) {
										cutin "gelca03",2;
										mes "有一次，师父加入了一个叫‘翼’什么的公会……鸡翅？";
										next;
										mes "那是个有趣的公会，没人把事情当真，但师父受不了他们的懒惰，于是离开了。";
										.@exp = 400000;
										.@jexp = 240000;
									}
									else {
										mes "你去过^FF0000无限塔^000000吗？我和师父去过，但爬到20楼时他的膝盖撑不住了……";
										next;
										mes "^FF0000无限塔^000000在海上某处。你得在艾尔贝塔找到一个叫詹索尔或类似名字的人，他会带你去。";
										.@exp = 550000;
										.@jexp = 290000;
									}
									if (JobLevel < 6)
										.@jexp = 206000;
									getexp .@exp, .@jexp;
									delitem 6549,20;
									para_100lv02 += 1;
								}
								break;
							case 3:
								if (countitem(6549) < 30)// Courtesy_Ticket
									mes "你的善意通行证不足。";
								else {
									.@story = rand(1,2);
									if (.@story == 1) {
										cutin "gelca04",2;
										mes "师父的公会在灰色熔炉解散了，因为会长与角羚怪战斗后失踪。";
										next;
										mes "[Gelkah]";
										mes "从那以后，他开始对弱小的冒险者刻薄……";
										next;
										mes "[Gelkah]";
										mes "我想那天之后他再也没见过那位会长。";
										getexp 650000,488000;
									}
									else {
										cutin "gelca03",2;
										mes "[Gelkah]";
										mes "师父最初是普隆德拉修道院里很受欢迎的辅助武僧。";
										next;
										mes "[Gelkah]";
										mes "但他好胜的性格也让他被视为麻烦制造者，所以离开了。";
										getexp 700000,430000;
									}
									delitem 6549,30;
									para_100lv02 += 1;
								}
								break;
							}
						}
					}
				}
				else {
					mes "[Gelkah]";
					mes "收到更多善意通行证后再回来找我！";
				}
			}
		}
	}
	else {
		cutin "gelca03",2;
		if (para_100lv02 > 100)
			mes strcharinfo(0) +"！你做得很好！还有更多委托，留给其他冒险者吧。";
		if (para_100lv02 < 101)
			mes "我觉得你不适合我能提供的委托。请去寻找其他冒险。";
		callsub S_Hunting,13003,106000,148000,"Carat";// <quest id>, <job exp if joblevel < 6>, <job exp>, <quest name>
		callsub S_Hunting,13005,106000,148000,"Arclouse";
		callsub S_Hunting,13007,112000,186500,"Anolian";
		callsub S_Hunting,13009,112000,186500,"Sting";
		callsub S_Hunting,13011,112000,252000,"Majoruros";
		callsub S_Hunting,13013,106000,148000,"Pinguicula";
		callsub S_Hunting,13015,112000,186500,"Luciola Vespa";
		callsub S_Hunting,13017,106000,148000,"Desert Wolf";
		callsub S_Hunting,13019,106000,148000,"Snowier";
		callsub S_Hunting,13021,112000,186500,"Ice Titan";
		callsub S_Hunting,13023,106000,148000,"Nightmare Terror";
		callsub S_Hunting,13025,106000,148000,"Flying Deleter";
		callsub S_Hunting,13040,112000,186500,"Loli Ruri";
		callsub S_Hunting,13042,106000,148000,"Medusa";
		callsub S_Hunting,13044,112000,186500,"Anubis";
		setarray .@quest_id[0],13004,13006,13008,130010,13012,13014,13016,13018,13020,13022,13024,13026,13041,13043,13045;
		for ( .@i = 0; .@i < 15; .@i++ ) {
			if (checkquest(.@quest_id[.@i],PLAYTIME) == 2) {
				erasequest .@quest_id[.@i];
				break;
			}
		}
	}
	close2;
	cutin "",255;
	end;
S_Quest:
	if (getarg(2,0)) {
		getitem 6549,1;// Courtesy_Ticket
		para_100lv02 += 1;
		if (JobLevel < 6)
			getexp 550000,getarg(1);
		else
			getexp 550000,getarg(2);
	}
	else {
		next;
		cutin "gelca01",2;
		if (select( "接受委托。","拒绝。" ) == 2)
			return 0;
		mes "[Gelkah]";
		mes "完成委托后请告诉我。";
		if (getarg(0) == 13012) {
			next;
			mes "[Gelkah]";
			mes "前往格拉斯特海姆最底层路途遥远，但和队伍一起去会很有趣。";
		}
	}
	if (isbegin_quest(getarg(0)))
		erasequest getarg(0);
	setquest getarg(1);
	return 1;

S_Hunting:
	switch( checkquest(getarg(0),HUNTING) ) {
	case -1:
		return;
	case 2:
		next;
		mes "[Gelkah]";
		mes "你完成了";
		mes "^FF0000"+ getarg(3) +"狩猎^000000委托。";
		mes "我会记录你已完成此委托。";
		para_100lv02 += 1;
		if (JobLevel < 6)
			getexp 550000,getarg(1);
		else
			getexp 550000,getarg(2);
		break;
	case 0:
	case 1:// untranslated these cases
	}
	erasequest getarg(0);

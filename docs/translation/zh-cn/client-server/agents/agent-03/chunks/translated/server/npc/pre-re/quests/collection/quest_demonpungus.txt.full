ein_fild01,43,249,0	script	Local Villager#hunt	898,{
	if (checkquest(60125) != -1) {
		if (checkquest(60125,HUNTING) != 2 ) {
			mes "[Local Villager]";
			mes "你完成了猎杀50只恶魔波利的任务吗？";
			next;
			switch(select("是:否:我想退出")) {
			case 1:
				mes "[Local Villager]";
				mes "嗯，我觉得你还没猎杀够50只……";
				close;
			case 2:
				mes "[Local Villager]";
				mes "记住，我需要你帮忙猎杀恶魔波利，去猎杀50只吧。";
				close;
			case 3:
				mes "[Local Villager]";
				mes "确定要停止猎杀吗？";
				mes "你取得的进度都会被清除。";
				next;
				switch(select("是:否")) {
				case 1:
					mes "[Local Villager]";
					mes "好吧，改变主意后再回来。";
					erasequest 60125;
					close;
				case 2:
					mes "[Local Villager]";
					mes "请猎杀50只恶魔波利。";
					close;
				}
			}
		}
		else {
			mes "[Local Villager]";
			mes "太棒了，你完成得真快。";
			getexp 250266,144452;
			erasequest 60125;
			close;
		}
	}
	if (checkquest(60126) != -1) {
		if (checkquest(60126,HUNTING) != 2 ) {
			mes "[Local Villager]";
			mes "你完成了猎杀100只恶魔波利的任务吗？";
			next;
			switch(select("是:否:我想退出")) {
			case 1:
				mes "[Local Villager]";
				mes "嗯，我觉得你还没猎杀够100只……";
				close;
			case 2:
				mes "[Local Villager]";
				mes "记住，我需要你帮忙猎杀恶魔波利，去猎杀100只吧。";
				close;
			case 3:
				mes "[Local Villager]";
				mes "确定要停止猎杀吗？";
				mes "你取得的进度都会被清除。";
				next;
				switch(select("是:否")) {
				case 1:
					mes "[Local Villager]";
					mes "好吧，改变主意后再回来。";
					erasequest 60126;
					close;
				case 2:
					mes "[Local Villager]";
					mes "请猎杀100只恶魔波利。";
					close;
				}
			}
		}
		else {
			mes "[Local Villager]";
			mes "太棒了，你完成得真快。";
			getexp 250266,144452;
			getexp 250266,144452;
			erasequest 60126;
			close;
		}
	}
	if (checkquest(60127) != -1) {
		if (checkquest(60127,HUNTING) != 2 ) {
			mes "[Local Villager]";
			mes "你完成了猎杀150只恶魔波利的任务吗？";
			next;
			switch(select("是:否:我想退出")) {
			case 1:
				mes "[Local Villager]";
				mes "嗯，我觉得你还没猎杀够150只……";
				close;
			case 2:
				mes "[Local Villager]";
				mes "记住，我需要你帮忙猎杀恶魔波利，去猎杀150只吧。";
				close;
			case 3:
				mes "[Local Villager]";
				mes "确定要停止猎杀吗？";
				mes "你取得的进度都会被清除。";
				next;
				switch(select("是:否")) {
				case 1:
					mes "[Local Villager]";
					mes "好吧，改变主意后再回来。";
					erasequest 60127;
					close;
				case 2:
					mes "[Local Villager]";
					mes "请猎杀150只恶魔波利。";
					close;
				}
			}
		}
		else {
			mes "[Local Villager]";
			mes "太棒了，你完成得真快。";
			getexp 250266,144452;
			getexp 250266,144452;
			getexp 250266,144452;
			erasequest 60127;
			close;
		}
	}
	//for minimum level
	if (BaseLevel > 59) {
		//for maximum level
		if (BaseLevel < 75) {
			mes "[Local Villager]";
			mes "嘿，说你呢！就是你！";
			mes "你能帮我做件事吗？";
			next;
			switch(select("当然:不")) {
			case 1:
				mes "[Local Villager]";
				mes "我想通过这里，但似乎无法越过这些恶魔波利。";
				next;
				switch(select("收集物品:猎杀恶魔波利:取消")) {
				case 1:
					// Item turn in
					mes "[Local Villager]";
					mes "你能帮我收集^FF0000芽孢^000000吗？";
					mes "帮我清理这些东西，我会奖励你。";
					next;
					switch(select("我有芽孢:你需要什么？")) {
					case 1:
						/*
						if (checkweight(504,10) == 0) {
							mes "[Local Villager]";
							mes "嘿，你背上的重量似乎要把你压垮了。减轻负重后再回来。";
							close;
						}
						*/
						if (countitem(7119) > 49) {
							mes "[Local Villager]";
							mes "我原本有些怀疑，但你证明了我错了。";
							mes "";
							delitem 7119,50; //Spawns
							getexp 250266,144452;
							//getitem 504,10; //White_Potion
							close;
						}
						else {
							mes "[Local Villager]";
							mes "看起来你的数量不够。";
							next;
							mes "[Local Villager]";
							mes "我需要确认你收集了^FF000050个芽孢^000000，然后才能奖励你。";
							mes "";
							close;
						}
					case 2:
						mes "[Local Villager]";
						mes "我需要确认你收集了^FF000050个芽孢^000000，然后才能奖励你。";
						close;
					}
				case 2:
					// Kill Count Quest
					mes "[Local Villager]";
					mes "啊，好吧。你可以帮我猎杀一些恶魔波利。";
					mes "你想猎杀多少只？";
					next;
					switch(select("50只恶魔波利:100只恶魔波利:150只恶魔波利")) {
					case 1:
						mes "[Local Villager]";
						mes "完成任务后回来，我会给你小奖励。";
						setquest 60125;
						close;
					case 2:
						mes "[Local Villager]";
						mes "完成任务后回来，我会给你小奖励。";
						setquest 60126;
						close;
					case 3:
						mes "[Local Villager]";
						mes "完成任务后回来，我会给你小奖励。";
						setquest 60127;
						close;
					}
				case 3:
					mes "[Local Villager]";
					mes "改变主意后请再回来。";
					close;
				}
			case 2:
				mes "[Local Villager]";
				mes "改变主意后请再回来。";
				close;
			}
		}
		else {
			mes "[Local Villager]";
			mes "嗯……我不认为……";
			next;
			mes "[Local Villager]";
			mes "抱歉，我现在不能说话。";
			close;
		}
	}
	else {
		mes "[Local Villager]";
		mes "真是太棒了。";
		mes "我只希望能顺利完成这一切。";
		mes "";
		mes "";
		close;
	}
}

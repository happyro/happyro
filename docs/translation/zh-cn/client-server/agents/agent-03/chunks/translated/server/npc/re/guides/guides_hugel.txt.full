hugel,98,56,3	script	Hugel Guide Granny#hugel	863,{
	mes "[休尔赫尔姆向导奶奶]";
	mes "哦，你好~真是个精力充沛的冒险者。";
	mes "欢迎来到^8B4513休尔赫尔姆^000000。我很荣幸为你介绍这座美丽的村庄。";
	mes "如果你第一次使用向导服务，尽管多问一些问题。";
	F_Navi("[休尔赫尔姆向导奶奶]");
	next;
	set .@str$,"想了解更多地点吗？";
	while (1) {
		switch(select("[ 主要设施 ]:[ 商人与助手 ]:移除小地图标记:取消")) {
		case 1:
			set .@loop,1;
			while (.@loop) {
				switch(select("[ 教堂 ]:[ 旅馆 ]:[ 酒吧 ]:[ 机场 ]:[ 武器商店 ]:[ 工具商店 ]:[ 宾果游戏室 ]:[ ^3131FF猎人公会^000000 ]:[ 聚会用品商店 ]:[ ^3131FF神殿远征队^000000 ]:上一级菜单")) {
				case 1:
					mes "[休尔赫尔姆向导奶奶]";
					mes "对我这个老人来说，"+F_Navi("教堂","hugel,159,113")+"更像是适合老年人的地方……";
					mes .@str$;
					viewpoint 1,159,113,0,0xFF0000;
					next;
					break;
				case 2:
					mes "[休尔赫尔姆向导奶奶]";
					mes "与其夸奖，不如来点布丁。";
					mes "在逛村子前，最好先把行李放到"+F_Navi("旅馆","hugel,101,77")+"。";
					mes .@str$;
					viewpoint 1,101,77,1,0x8B4513;
					next;
					break;
				case 3:
					mes "[休尔赫尔姆向导奶奶]";
					mes "旅行时当然要去"+F_Navi("酒吧","hugel,126,65")+"结交新朋友。";
					mes "从这里向东走就能到酒吧。";
					mes .@str$;
					viewpoint 1,126,65,2,0xDAA520;
					next;
					break;
				case 4:
					mes "[休尔赫尔姆向导奶奶]";
					mes "不久前，陌生人来到村子，建了那个奇怪的"+F_Navi("机场","hugel,178,146")+"……";
					mes "他们叫它什么？飞艇？";
					mes .@str$;
					viewpoint 1,178,146,3,0xD7567F;
					next;
					break;
				case 5:
					mes "[休尔赫尔姆向导奶奶]";
					mes "村子中央有一家"+F_Navi("武器商店","hugel,88,167")+"。";
					mes "不过我不知道那里有没有你用得上的武器。";
					mes .@str$;
					viewpoint 1,88,167,4,0xCD5C5C;
					next;
					break;
				case 6:
					mes "[休尔赫尔姆向导奶奶]";
					mes "我喜欢休尔赫尔姆牌红色药水。我还没尝过其他牌子的红色药水……呵呵呵。";
					mes ""+F_Navi("工具商店","hugel,92,163")+"位于村子中央。";
					mes .@str$;
					viewpoint 1,92,163,5,0x000080;
					next;
					break;
				case 7:
					mes "[休尔赫尔姆向导奶奶]";
					mes "我会标记";
					mes "关于"+F_Navi("宾果游戏室","hugel,58,206","^800080");
					mes "已标记在你的小地图上。";
					mes .@str$;
					viewpoint 1,58,206,6,0x800080;
					next;
					break;
				case 8:
					mes "[休尔赫尔姆向导奶奶]";
					mes "哦，你想成为猎人吗？";
					mes "沿着海滩向东北走，就能找到"+F_Navi("猎人公会","hugel,209,224")+"。";
					mes .@str$;
					viewpoint 1,209,224,7,0xFF1493;
					next;
					break;
				case 9:
					mes "[休尔赫尔姆向导奶奶]";
					mes "我会标记";
					mes "关于"+F_Navi("聚会用品商店","hugel,95,103","^483D8B");
					mes "已标记在你的小地图上。";
					mes .@str$;
					viewpoint 1,95,103,8,0x483D8B;
					next;
					break;
				case 10:
					mes "[休尔赫尔姆向导奶奶]";
					mes "我听说";
					mes F_Navi("Shrine Expedition","hugel,52,95")+" is staying in a house at the west.";
					mes "他们在村子中央立了某种标志，看来是在招人做什么……";
					mes "不知道他们在这里做什么……嗯。";
					mes .@str$;
					viewpoint 1,52,95,9,0x834683;
					next;
					break;
				case 11:
					set .@loop,0;
					break;
				}
			}
			break;
		case 2:
			set .@loop,1;
			while (.@loop) {
				switch(select("[ 怪物赛跑竞技场 ]:[ Cool Event 公司职员 ]:上一级菜单")) {
				case 1:
					mes "[休尔赫尔姆向导奶奶]";
					mes "我也喜欢玩怪物赛跑，很有趣呢。";
					mes "哦，你还没试过？不~最好去试试。相信我，你会喜欢的。";
					mes .@str$;
					viewpoint 1,60,71,10,0xFF1493;
					next;
					break;
				case 2:
					mes "[休尔赫尔姆向导奶奶]";
					mes "我会标记";
					mes "关于^DA70D6Cool Event 公司职员^000000";
					mes "已标记在你的小地图上。";
					mes .@str$;
					viewpoint 1,88,168,11,0xDA70D6;
					next;
					break;
				case 3:
					set .@loop,0;
					break;
				}
			}
			break;
		case 3:
			mes "[休尔赫尔姆向导奶奶]";
			mes "我会移除你小地图上的标记。";
			mes "还有什么我能帮你的吗？";
			viewpoint 2,159,113,0,0xFFFFFF;
			viewpoint 2,101,77,1,0xFFFFFF;
			viewpoint 2,126,65,2,0xFFFFFF;
			viewpoint 2,178,146,3,0xFFFFFF;
			viewpoint 2,88,167,4,0xFFFFFF;
			viewpoint 2,92,163,5,0xFFFFFF;
			viewpoint 2,58,206,6,0xFFFFFF;
			viewpoint 2,209,224,7,0xFFFFFF;
			viewpoint 2,95,103,8,0xFFFFFF;
			viewpoint 2,52,95,9,0xFFFFFF;
			viewpoint 2,60,71,10,0xFFFFFF;
			viewpoint 2,88,168,11,0xFFFFFF;
			next;
			break;
		case 4:
			mes "[休尔赫尔姆向导奶奶]";
			mes "呵呵呵~！";
			mes "做向导很有意思。";
			close;
		}
	}
}

hugel,187,172,6	script	Guide Rich King#hugel	414,{
	mes "[富有的国王]";
	mes "你来这座乡村";
	mes "有什么事？";
	next;
	mes "[富有的国王]";
	mes "这里是^8B4513休尔赫尔姆^000000";
	mes "位于黑色波利共和国。";
	mes "能得到我这样的伟大人物指引，你很幸运。";
	F_Navi("[富有的国王]");
	next;
	while (1) {
		switch(select("[ 主要设施 ]:[ 商人与助手 ]:移除小地图标记:取消")) {
		case 1:
			set .@loop,1;
			while (.@loop) {
				switch(select("[ 教堂 ]:[ 旅馆 ]:[ 酒吧 ]:[ 机场 ]:[ 武器商店 ]:[ 工具商店 ]:[ 宾果游戏室 ]:[ 猎人公会 ]:[ 聚会用品商店 ]:[ 神殿远征队 ]:上一级菜单")) {
				case 1:
					callsub L_Mark, F_Navi("Church","hugel,159,113","^FF0000");
					viewpoint 1,159,113,0,0xFF0000;
					next;
					break;
				case 2:
					callsub L_Mark, F_Navi("Inn","hugel,101,77","^8B4513");
					viewpoint 1,101,77,1,0x8B4513;
					next;
					break;
				case 3:
					callsub L_Mark, F_Navi("Pub","hugel,126,65","^DAA520");
					viewpoint 1,126,65,2,0xDAA520;
					next;
					break;
				case 4:
					callsub L_Mark, F_Navi("Airport","hugel,178,146","^D7567F");
					viewpoint 1,178,146,3,0xD7567F;
					next;
					break;
				case 5:
					callsub L_Mark, F_Navi("Weapon Shop","hugel,88,167","^CD5C5C");
					viewpoint 1,88,167,4,0xCD5C5C;
					next;
					break;
				case 6:
					callsub L_Mark, F_Navi("Tool Shop","hugel,92,163","^000080");
					viewpoint 1,92,163,5,0x000080;
					next;
					break;
				case 7:
					callsub L_Mark, F_Navi("Bingo Game Room","hugel,58,206","^800080");
					viewpoint 1,58,206,6,0x800080;
					next;
					break;
				case 8:
					callsub L_Mark, F_Navi("Hunter Guild","hugel,209,224","^FF1493");
					viewpoint 1,209,224,7,0xFF1493;
					next;
					break;
				case 9:
					callsub L_Mark, F_Navi("Party Supplies Shop","hugel,95,103","^483D8B");
					viewpoint 1,95,103,8,0x483D8B;
					next;
					break;
				case 10:
					callsub L_Mark, F_Navi("Shrine Expedition","hugel,52,95","^834683");
					viewpoint 1,52,95,9,0x834683;
					next;
					break;
				case 11:
					set .@loop,0;
					break;
				}
			}
			break;
		case 2:
			set .@loop,1;
			while (.@loop) {
				switch(select("[ 怪物赛跑竞技场 ]:[ Cool Event 公司职员 ]:上一级菜单")) {
				case 1:
					callsub L_Mark, "^FF1493Monster Race Arena^000000";
					viewpoint 1,60,71,10,0xFF1493;
					next;
					break;
				case 2:
					callsub L_Mark, "^DA70D6Cool Event Corp. Staff^000000";
					viewpoint 1,88,168,11,0xDA70D6;
					next;
					break;
				case 3:
					set .@loop,0;
					break;
				}
			}
			break;
		case 3:
			mes "[富有的国王]";
			mes "我会移除你小地图上的标记。";
			mes "我知道你好奇，但别再烦我了。";
			viewpoint 2,159,113,0,0xFFFFFF;
			viewpoint 2,101,77,1,0xFFFFFF;
			viewpoint 2,126,65,2,0xFFFFFF;
			viewpoint 2,178,146,3,0xFFFFFF;
			viewpoint 2,88,167,4,0xFFFFFF;
			viewpoint 2,92,163,5,0xFFFFFF;
			viewpoint 2,58,206,6,0xFFFFFF;
			viewpoint 2,209,224,7,0xFFFFFF;
			viewpoint 2,95,103,8,0xFFFFFF;
			viewpoint 2,52,95,9,0xFFFFFF;
			viewpoint 2,60,71,10,0xFFFFFF;
			viewpoint 2,88,168,11,0xFFFFFF;
			next;
			break;
		case 4:
			mes "[富有的国王]";
			mes "辛苦工作后我有点饿了……";
			mes "我很想吃点东西！";
			close;
		}
	}
	end;
L_Mark:
	mes "[富有的国王]";
	mes "我会标记";
	mes "的"+getarg(0)+"。";
	mes "想了解更多地点吗？";
	mes "你还要继续烦我让我生气吗？";
	return;
}

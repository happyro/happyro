			mes "与施瓦茨瓦尔德共和国研究队合作，但我们的领导完全合不来，个性冲突太严重了……";
			next;
			mes "[Ashe]";
			mes "总之，如果你想加入我们揭开过去秘密的努力，请去找 Laurence 女士。";
			close;

		case 2:
		case 12:
			mes "[Ashe]";
			mes "你要去奥丁神殿？祝你好运，小心点，好吗？";
			close;

		case 3:
		case 13:
			mes "[Ashe]";
			mes "哦，你回来得比我想的早！像你这样有才华的人一定能帮大忙！";
			close;

		case 4:
			mes "[Ashe]";
			mes "嗯？你决定帮助施瓦茨瓦尔德队？没问题，但 Laurence 女士可能会不高兴。对我来说无所谓。";
			close;

		case 5:
			mes "[Ashe]";
			mes "工作进展如何？我知道队伍领导互相讨厌，但他们应该明白，一个人的研究胜利就是所有人的胜利。";
			close;
		
		case 6:
			mes "[Ashe]";
			mes "工作进展如何？我知道队伍领导互相讨厌，但他们应该明白，一个人的研究胜利就是所有人的胜利。";
			close;
			
		case 14:
			mes "[Ashe]";
			mes "请继续努力~";
			close;
			
		case 15:
			if (countitem(7511) > 4)
			{
				mes "[Ashe]";
			mes "看来最后一切顺利，对吧？取得那些符文做得好。";
				close;
			}
			mes "[Ashe]";
			mes "哦，亲爱的，你看起来不太好。发生什么了吗？";
			close;
		
		case 16:
			mes "[Ashe]";
			mes "我知道 Laurence 女士说话很强势，但她肯定很感激你的努力。非常感谢你的付出~";
			close;
		
		case 17:
			mes "[Ashe]";
			mes "Laurence 女士为什么要这样？老实说，我觉得这场竞争太幼稚了……";
			close;
		
		case 19:
			mes "[Ashe]";
			mes "呃……别担心~";
			close;
		
		case 20:
			mes "[Ashe]";
			mes "请别问我任何事……我不会伤害你~";
			close;
	}
}


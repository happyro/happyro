hu_in01,159,84,3	script	Laura#2	70,{
	if (hg_odin == 22 || hg_odin == 23) {
		cutin "hu_laura03.bmp",2;
		emotion ET_FRET, getnpcid(0, "Laura#2");
		mes "[Laura]";
		mes "什、什么……？！";
		mes "这意味着所有人一直在骗我？！太荒谬了！";
		next;
		cutin "hu_alex04.bmp",0;
		emotion ET_FRET, getnpcid(0, "Alex#2");
		mes "[Alex]";
		mes "你在说什么，疯女人？你看过另一边的神殿！那不是什么秘密！";
		next;
		cutin "hu_laura03.bmp",2;
		mes "[Laura]";
		mes "我说的不是那个！我看到你弟弟半夜在城里到处挖掘！";
		next;
		cutin "hu_alex04.bmp",0;
		mes "[Alex]";
		mes "胡说……！你从哪儿得出这种想法？凭什么认为城里埋着神器？";
		next;
		mes "[Alex]";
		mes "再说，你凭什么认为我弟弟会浪费时间做这种荒唐事？";
		next;
		cutin "hu_laura03.bmp",2;
		mes "[Laura]";
		mes "哈哈哈！尽管为你弟弟辩护吧，伪君子！你们明明互相憎恨，装什么关心！";
		next;
		cutin "hu_alex04.bmp",0;
		mes "[Alex]";
		mes "你说什么……？有胆再说一遍！我会让你后悔！";
		next;
		cutin "hu_laura01.bmp",2;
		mes "[Laura]";
		mes "我知道你在帮他挖掘。一个人不可能取得这么大进展！事实上，我有证据！";
		next;
		mes "^3355FFLaura 猛烈挥舞手中的厚文件。^000000";
		next;
		emotion ET_HUK, getnpcid(0, "Julian#2");
		mes "[Julian]";
		mes "什么……？";
		mes "啊，那是——！";
		next;
		emotion ET_ANGER, getnpcid(0, "Laura#2");
		mes "[Laura]";
		mes "没错。现在告诉我，‘^FF0000伊米尔之心^000000’到底是什么？";
		next;
		cutin "hu_alex02.bmp",0;
		mes "[Alex]";
		mes "......";
		mes "Julian！";
		next;
		emotion ET_PROFUSELY_SWEAT, getnpcid(0, "Julian#2");
		mes "[Julian]";
		mes "呃，这不是我的错！她、她没权进入我们的办公室！";
		next;
		cutin "hu_laura02.bmp",2;
		mes "[Laura]";
		mes "哈！我们不是同一探险队的平等伙伴吗？一开始我听到的就是这样！但你们显然另有打算！";
		next;
		cutin "hu_laura03.bmp",2;
		mes "[Laura]";
		mes "太可疑了：你们只在夜里外出，奥丁神殿挖掘进展又这么慢。告诉我，你们真正的目标是什么？！";
		next;
		cutin "hu_alex03.bmp",0;
		emotion ET_PROFUSELY_SWEAT, getnpcid(0, "Alex#2");
		mes "[Alex]";
		mes "我、我不知道你在说什么！J-Julian 一定接了什么任务，未经我同意就执行！别歪曲事实，你……你这个小偷！";
		next;
		cutin "hu_laura03.bmp",2;
		mes "[Laura]";
		mes "小偷……？！";
		mes "看看是谁在说话！";
		next;
		mes "^3355FFLaura tossed the file";
		mes "扔开文件，威胁地卷起袖子。^000000";
		next;
		emotion ET_CRY, getnpcid(0, "Ashe#2");
		mes "[Ashe]";
		mes "住、住手！你们两个！";
		next;
		emotion ET_PROFUSELY_SWEAT, getnpcid(0, "Laura#2");
		mes "[Laura]";
		mes "别插手，Ashe！";
		next;
		cutin "hu_alex04.bmp",0;
		emotion ET_FRET, getnpcid(0, "Alex#2");
		mes "[Alex]";
		mes "没错，这不关你的事！";
		next;
		set hg_odin,25;
		mes "[Ashe]";
		mes "哦……天哪！";
		close2;
		cutin "hu_alex04.bmp",255;
		end;
	} else if (hg_odin > 23) {
		cutin "hu_laura03.bmp",2;
		emotion ET_FRET, getnpcid(0, "Laura#2");
		mes "[Laura]";
		mes "哈……！";
		mes "你刚才……打我？";
		next;
		cutin "hu_alex04.bmp",0;
		emotion ET_FRET, getnpcid(0, "Alex#2");
		mes "[Alex]";
		mes "你疯了……！";
		close2;
		cutin "hu_alex04.bmp",255;
		end;
	}
}


}



// Sidequest quest : I don't like it - Step 1
// Daily quest : Warehouse Clearance
// Daily quest : Basement Clearance
ba_2whs01,150,51,5	script	Chirp#172wh01	4_EP17_BASKET,{
	if (checkweight(1000103,3) == 0) {
		mes "你持有的物品数量太多，无法继续对话。";
		mes "请整理背包后再试。";
		close;
	}
	if (BaseLevel < 160) {
		cutin "ep172_beta",2;
		mes "[Chirp]";
		mes "这里很危险。";
		mes "等你有能力更好地保护自己时再回来。";
		next;
		mes "- You must be atleast level 160 to perform this quest. -";
		close3;
	}
	if (ep17_2_main < 9) {
		cutin "ep172_beta",2;
		mes "[Chirp]";
		mes "既然所有地方都对特殊访客开放，我们无法阻止你进来。不过，如果你要参观仓库，就不该触碰这里的任何东西。";
		close3;
	}
	// Sidequest quest
	if (ep17_2_chirp == 0) {
		cutin "ep172_beta",2;
		mes "[Chirp]";
		mes "这里真是一团糟。";
		mes "你是怎么进来的？";
		mes "你甚至没有带钥匙。";
		next;
		cutin "",255;
		if (select( "这里是做什么的？", "我不想惹麻烦，我这就回去。" ) == 2) {
			cutin "ep172_beta",2;
			mes "[Chirp]";
			mes "也许你只是意外进来的。";
			close3;
		}
		cutin "ep172_beta",2;
		mes "[Chirp]";
		mes "人类。";
		mes "而且……是访客？";
		next;
		mes "[Chirp]";
		mes "你是来找宅邸蓝图的吗？";
		mes "如果你能等，我会把它带给你。";
		mes "我记得一句话，人类缺乏耐心。";
		next;
		mes "[Chirp]";
		mes "这里是瓦尔蒙特宅邸的第二仓库。";
		next;
		cutin "",255;
		select( "仓库……？" );
		cutin "ep172_beta",2;
		mes "[Chirp]";
		mes "哦，外面的人类没有仓库的概念吗？仓库就是存放不使用物品的地方。";
		unittalk getcharid(3), "" + strcharinfo(0) + " : I know that!", bc_self;
		next;
		mes "[Chirp]";
		mes "我来这里是为了拿宅邸蓝图和餐厅食材。你亲自来是因为不信任我吗？如果是这样，请不用担心。";
		next;
		mes "[Chirp]";
		mes "我负责仓库已经很久了，能迅速找到存放的旧物或小物件。";
		mes "不用说，我也记得蓝图在哪里。";
		next;
		mes "[Chirp]";
		mes "我是自动人偶。我们不会丢失记忆。";
		next;
		cutin "",255;
		if (select( "我不是来找蓝图的。", "这里非常复杂。" ) == 1) {
			cutin "ep172_beta",2;
			mes "[Chirp]";
			mes "是这样吗？我误会情况了。";
			mes "我没想到会有人类来仓库。通常一路来到这里的人类都是小偷。";
			next;
			mes "[Chirp]";
			mes "但这不代表你是小偷。否则你不会有资格成为访客。瓦尔蒙特宅邸不会邀请所有人成为访客。";
			next;
			mes "[Chirp]";
			mes "即使你有那个打算，也不容易在这里找到想要的东西。";
			next;
			select( "这里非常复杂。" );
		}
		cutin "ep172_beta",2;
		mes "[Chirp]";
		mes "当然，这是瓦尔蒙特的旧仓库。";
		mes "它如今这么大，是因为没有足够空间存放整个大陆的物品，所以我们不断扩建和翻修。";
		next;
		mes "[Chirp]";
		mes "虽然看起来很复杂，但其实并不复杂，因为所有东西都按类别整理。";
		next;
		mes "[Chirp]";
		mes "这只是因为这里的空间远比外面看到的宽敞。如果你在等它，请先回去等我……我很快就会带给你。";
		next;
		cutin "",255;
		select( "为什么？" );
		cutin "ep172_beta",2;
		mes "[Chirp]";
		mes "我想我会因为损坏的清洁机器人耽搁一会儿。那是一台被入侵者黑入的自动机器人。我正在想办法清理它造成的混乱。";
		next;
		mes "[Chirp]";
		mes "^CC0000Setting it on fire^000000 will be the cleanest way, don't you think?";
		next;
		cutin "",255;
		select( "什么？一切都会被烧掉。" );
		cutin "ep172_beta",2;
		mes "[Chirp]";
		mes "没关系。它们都是防火的。即使烧掉一切，宅邸的图纸也在其他仓库里。虽然要走远一点，但没关系。放心吧。";
		next;
		mes "[Chirp]";
		mes "一次性处理所有东西最快也最干净。";
		next;
		cutin "",255;
		select( "问题不在这里……" );
		cutin "ep172_beta",2;
		mes "[Chirp]";
		mes "那么，问题是什么？";
		next;
		cutin "",255;
		if (select( "我宁愿叫安保。", "我宁愿叫上级。" ) == 2) {
			cutin "ep172_beta",2;
			mes "[Chirp]";
			mes "叫上级是什么意思？";
			mes "你是要我把问题交给上级解决吗？";
		}
		else {
			cutin "ep172_beta",2;
			mes "[Chirp]";
			mes "叫安保当然可以，但会花很长时间。";
			mes "你能接受吗？安保到位并控制、处理它们至少需要一天。";
		}
		next;
		cutin "ep172_beta",2;
		mes "[Chirp]";
		mes "既然你能自己处理，就没必要浪费时间把问题上报，不是吗？";
		next;
		mes "[Chirp]";
		mes "不过，我们被要求尽可能尊重访客的意见。请稍等。";
		unittalk getcharid(3), "" + strcharinfo(0) + " : I'm so eager to...", bc_self;
		progressbar_npc "00FF00",3;
		next;
		cloakoffnpcself( "Beta#ep172_2whs01-00" );
		cutin "ep172_beta",0;
		mes "[Beta]";
		mes "你叫我？发生什么事了？很严重吗？我现在很忙。";
		next;
		cutin "ep172_beta",2;
		mes "[Chirp]";
		mes "看看这里。你觉得怎么样？";
		mes "你想让我拿这里所有损坏的清洁机器人怎么办？";
		mes "你有好主意吗？";
		next;
		cutin "ep172_beta",0;
		mes "[Beta]";
		mes "哦。这情况很严重。";
		next;
		cutin "ep172_beta",2;
		mes "[Chirp]";
		mes "对吧？现在告诉我如何快速解决。";
		mes "让这里的人类访客也听见。因为访客希望我叫你来想办法。";
		next;
		cutin "ep172_beta",0;
		mes "[Beta]";
		mes "问题不只在这里。我现在没有可派来的安保。";
		next;
		cutin "ep172_beta",2;
		mes "[Chirp]";
		mes "我现在必须为这里的访客取些东西。如果我现在进去，会不会像它们一样损坏？这样可以吗？";
		next;
		cutin "ep172_beta",0;
		mes "[Beta]";
		mes "你不能这么做，但我帮不了你。我会尽快派人来，但要等到明天。";
		next;
		cutin "ep172_beta",2;
		mes "[Chirp]";
		mes "我可以放火吗？";
		next;
		cutin "ep172_beta",0;
		mes "[Beta]";
		mes "不，别这样。损坏的机器人只会移动到别处。";
		mes "而且我们不能让访客承担这种风险。";
		next;
		cutin "ep172_beta",2;
		mes "[Chirp]";
		mes "我有信心控制火势不蔓延。";
		next;
		cutin "ep172_beta",0;
		mes "[Beta]";
		mes "你不能。你这样拖延我，处理进度只会更慢。再等一会儿，并请访客理解。";
		next;
		cloakonnpcself( "Beta#ep172_2whs01-00" );
		cutin "ep172_beta",2;
		mes "[Chirp]";
		mes "你看到了吗？即使我叫上级，现在也不会有援助。我甚至无法再执行放火的方案。要不是你和我说话，我本来已经放火了。";
		next;
		mes "[Chirp]";
		mes "我现在该怎么办？我需要从那里取东西，但进去后会像它们一样损坏。毕竟我不是战斗型人偶。";
		next;
		mes "[Chirp]";
		mes "我能在一定程度上避开它们，但它们太多了，我很担心。如果它们同时攻击，就连最强的人偶也会很快被摧毁。";
		next;
		mes "[Chirp]";
		mes "当然，我可以为这个请求牺牲自己。";
		mes "但我不认为现在该这么选。如果为更重要的事牺牲自己，会更有价值。";
		next;
		mes "[Chirp]";
		mes "此外，还有谁来管理仓库？";
		mes "甚至没人知道东西在哪里。";
		next;
		cutin "",255;
		select( "我该整理吗？" );
		cutin "ep172_beta",2;
		mes "[Chirp]";
		mes "" + strcharinfo(0) + ", Are you sure?";
		mes "你是说你要整理那些清洁机器人？";
		next;
		if (select( "我不能做吗？", "你看起来很困扰。" ) == 2) {
			cutin "ep172_beta",2;
			mes "[Chirp]";
			mes "你是在同情我在仓库自动人偶面前无能为力吗？人类会为自己没做的事负责吗？";
		}
		else {
			cutin "ep172_beta",2;
			mes "[Chirp]";
			mes "一个人类的过错，是所有人类的过错吗？";
		}
		next;
		cutin "",255;
		select( "不。" );
		cutin "ep172_beta",2;
		mes "[Chirp]";
		mes "是这样吗？所以我们才误解了。他们彼此相连，所以共同承担一切，包括过错和责任。";
		next;
		cutin "",255;
		select( "瓦尔蒙特也是人类。" );
		cutin "ep172_beta",2;
		mes "[Chirp]";
		mes "他不一样。他是个睿智的人。";
		mes "如果他现在在这里，所有问题都会解决。也许问题根本不会发生。";
		next;
		mes "[Chirp]";
		mes "谢谢你的帮助，但通知要求在不伤害访客的情况下尽量与访客合作。我会想别的办法，什么办法都行。";
		next;
		cutin "",255;
		select( "我是战斗人员。" );
		cutin "ep172_beta",2;
		mes "[Chirp]";
		mes "... Is that so? If you're a combatant, you're job is to deal with these kind of things, isn't it? Wouldn't that hurt you?";
		next;
		cutin "",255;
		select( "完全不是。" );
		cutin "ep172_beta",2;
		mes "[Chirp]";
		mes "我明白了，你是能从这类事情中获得乐趣的人。我以前听说过。那我想请你帮个忙。当然，我会给你奖励。";
		emotion ET_SWEAT, getcharid(3);
		next;
		mes "[Chirp]";
		mes "请收集^0000CD五台清洁机器人^000000。";
		mes "这样我就能处理这团乱局。";
		mes "希望你能从中获得乐趣。";
		ep17_2_chirp = 1;
		setquest 17342;
		close3;
	}
	if (ep17_2_chirp == 1) {
		switch( checkquest(17342,HUNTING) ) {
		case -1:
			end;
		case 0:
		case 1:
			cutin "ep172_beta",2;
			mes "[Chirp]";
			mes "完成了吗？它们还是太多了。我需要你更加努力。";
			mes "请收集^0000CD五台清洁机器人^000000。";
			mes "这样我就能处理这团乱局。";
			close3;
		case 2:
			cutin "ep172_beta",2;
			mes "[Chirp]";
			mes "你享受其中吗？我想知道你是享受摧毁它们，还是享受保护它们，不过我不必知道。";
			next;
			mes "[Chirp]";
			mes "多亏了你，我拿回了我们需要的东西。";
			mes "达到那个程度，你就能比平时更快地行动。";
			next;
			mes "- Rumbling -";
			next;
			mes "- Rattling -";
			next;
			mes "[Chirp]";
			mes "你听到了吗？";
			next;
			cutin "",255;
			select( "那是嘎吱声吗？" );
			cutin "ep172_beta",2;
			mes "[Chirp]";
			mes "没错。保持不动，安静。";
			next;
			mes "- Rattling -";
			next;
			mes "- ...Ooh... Uh... -";
			next;
			mes "[Chirp]";
			mes "这是根据声音模式发出的自动人偶声音，但不是附近自动人偶的声音。声音来自稍远的地方。";
			next;
			mes "[Chirp]";
			mes "我觉得声音来自地下室。如果真是地下室，那就严重了。";
			next;
			cutin "",255;
			select( "为什么？" );
			cutin "ep172_beta",2;
			mes "[Chirp]";
			mes "和这个仓库不同，只有瓦尔蒙特能进入地下室。那里有很多秘密和危险物品。";
			emotion ET_SURPRISE;
			next;
			mes "[Chirp]";
			mes "如果自动人偶或人类进去，误碰了危险物品，";
			mes "可预见的灾难一定会发生。";
			next;
			mes "[Chirp]";
			mes "如果声音真的来自地下，而且是自动人偶的声音，那等待我们的只有毁灭。";
			next;
			mes "[Chirp]";
			mes "这里迟早会因大爆炸化为灰烬。这和我的放火计划完全不是一个级别。";
			next;
			mes "[Chirp]";
			mes "地下潜伏着危险。";
			mes "必须有人去检查。如果你查清发生了什么，也许我们能请你的上级尽快赶来。这样就没事了。";
			next;
			mes "[Chirp]";
			mes "我们必须做些什么来阻止这一切。";
			next;
			mes "[Chirp]";
			mes "我得在整理损坏的自动人偶时去取蓝图和食材。";
			next;
			mes "[Chirp]";
			mes "" + strcharinfo(0) + " is a combatant.";
			mes "那么剩下的就是……";
			next;
			cutin "",255;
			select( "……去检查它。" );
			cutin "ep172_beta",2;
			mes "[Chirp]";
			mes "哦，你愿意吗？真没想到。";
			mes "真不敢相信你不常做这种安保工作。我会记住的。照顾访客娱乐也是我们的工作之一。";
			emotion ET_SWEAT, getcharid(3);
			next;
			mes "[Chirp]";
			mes "仓库^0000CD最上方^000000有一条通往地下的楼梯。下楼检查下面的情况。不要触碰任何东西。";
			next;
			mes "[Chirp]";
			mes "去吧，完成后回来。";
			ep17_2_chirp = 2;
			erasequest 17342;
			setquest 17343;
			getitem 1000103,3;
			close3;
		}
	}

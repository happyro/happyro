		mes "[Sweep]";
		mes "访客和入侵者最大的区别是什么？为什么访客和入侵者的行为模式不同？人类如何区分二者？";
		next;
		mes "[Sweep]";
		mes "我们自动人偶认为自己不知道很正常，因为以前只接触过访客。";
		mes "我们感受不到人类能感受到的东西。我甚至感觉不到手指尖的触感。";
		next;
		mes "[Sweep]";
		mes "即使不知道这种事，也不会影响我的工作。我可以清洁，也可以执行交给我的任务。被指定为垃圾的东西就应该被清扫。";
		next;
		mes "[Sweep]";
		mes "人类就是人类，自动人偶就是自动人偶。";
		next;
		mes "[Sweep]";
		mes "但是……如果你能帮我一件事，我会很高兴。你有兴趣吗？";
		next;
		cutin "",255;
		if (select( "我很乐意。", "我有点忙。" ) == 2) {
			cutin "ep172_beta",2;
			mes "[Sweep]";
			mes "我明白了。我学到不该占用忙碌访客的时间。";
			close3;
		}
		cutin "ep172_beta",2;
		mes "[Sweep]";
		mes "那么可以请你消灭^0000CD15只沸腾食人鱼和15只沸腾马尔克^000000吗？它们是浴场失踪事件的主要原因之一。";
		next;
		mes "[Sweep]";
		mes "宅邸其他地方也人手不足，所以我们必须自己处理。我会尽力清理，但数量太多了。这关系到卫生和安全，不能拖延。那么，拜托了。";
		setquest 17378;
		completequest 17378;
		setquest 17379;
		close3;
	}
	cutin "ep172_beta",2;
	mes "[Sweep]";
	mes "怎么了？你是来帮我的吗？";
	next;
	.@playtime = checkquest(17380,PLAYTIME);
	.@hunting = checkquest(17379,HUNTING);

	if (.@playtime == 0 || .@playtime == 1)
		.@menu$ = "^C0C0C0Fish extermination - Cooldown^000000";
	else if (.@hunting == 0 || .@hunting == 1)
		.@menu$ = "^C0C0C0Fish extermination - On Progress^000000";
	else
		.@menu$ = "Fish extermination";

	if (select( .@menu$, "我对清洁很好奇。" ) == 2) {
		mes "[Sweep]";
		mes "清洁是我平时的工作，只是现在障碍太多，有些困难。";
		close3;
	}
	if (.@playtime == 0 || .@playtime == 1) {
		mes "[Sweep]";
		mes "嗯……我很高兴你来帮我。但我听说人类需要大量休息，请黎明后再来。";
		close3;
	}
	switch( .@hunting ) {
	case -1:
		mes "[Sweep]";
		mes "谢谢你的帮助。那么可以请你消灭^0000CD15只沸腾食人鱼和15只沸腾马尔克^000000吗？";
		next;
		if (select( "好的。", "我今天想休息一下……" ) == 2) {
			mes "[Sweep]";
			mes "我明白了。我听说人类应该经常休息。";
			close3;
		}
		mes "[Sweep]";
		mes "那么就交给你处理。";
		setquest 17379;
		if (isbegin_quest(17380) > 0)
			erasequest 17380;
		close3;
	case 0:
	case 1:
		mes "[Sweep]";
		mes "你处理好了吗？";
		next;
		mes "[Boiler]";
		mes "你忘了吗？那么请消灭^0000CD15只沸腾食人鱼和15只沸腾马尔克^000000。";
		close3;
	case 2:
		mes "[Sweep]";
		mes "你处理好了吗？";
		next;
		mes "[Boiler]";
		mes "太好了。非常感谢。如果你能黎明后再来，我会更加感激。";
		erasequest 17379;
		setquest 17380;
		getitem 1000103,2;
		getexp 722940,506070;
		close3;
	}
	end;

OnInit:
	// Daily
	questinfo( QTYPE_DAILYQUEST, QMARK_YELLOW, "isbegin_quest(17374) == 2 && checkquest(17379,HUNTING) == -1 && checkquest(17380,PLAYTIME) == -1" );
	questinfo( QTYPE_DAILYQUEST, QMARK_YELLOW, "checkquest(17380,PLAYTIME) == 2" );
	questinfo( QTYPE_QUEST2, QMARK_YELLOW, "checkquest(17379,HUNTING) == 2" );
	end;
}


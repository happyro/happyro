bat_room,135,178,5	script	Guillaume Knight#3	417,{
	mes "[Guillaume Knight]";
	mes "弗拉维乌斯战场的目标是在敌人之前摧毁水晶，先得两分。";
	next;
	mes "[Guillaume Knight]";
	mes "双方军队的水晶都由特殊路障保护，无法直接攻击摧毁。";
	next;
	mes "[Guillaume Knight]";
	mes "摧毁保护敌方基地的守护者后，路障就会消失。";
	next;
	mes "[Guillaume Knight]";
	mes "水晶免疫所有技能；只有物理攻击才能摧毁敌方水晶。";
	next;
	mes "[Guillaume Knight]";
	if (getbattleflag("feature.bgqueue"))
		mes "准备好后，请点击界面中的 ^0000FF战斗按钮^000000。";
	else {
		mes "请记住：参加战斗时你会获得一个令牌，表示你在指定时间内不能参加同类型战斗。";
		mes "按 Alt+U 键即可查看剩余时间。";
	}
	next;
	mes "[Guillaume Knight]";
	if (getbattleflag("feature.bgqueue"))
		mes "请注意，取消后 ^0000FF一分钟内不能再次申请^000000！";
	else
		mes "准备好战斗了吗？请向我旁边的招募员申请！";
	close;
}

bat_room,151,178,5	duplicate(Guillaume Knight#3)	Guillaume Knight#4	417


//===== rAthena Script =======================================
//= BattleGround System - Flavius Entrance NPCs
//===== Description: =========================================
//= [Official Conversion]
//= Flavius Battleground Entrance NPCs
//===== Changelogs: ==========================================
//= 1.0 First Version. [L0ne_W0lf]
//= 1.1 Added battle_config checks to allow this script to use the new queue interface or the previous method. [Aleos]
//============================================================

// Flavius Officer - Guillaume
//============================================================
bat_room,133,178,5	script	Flavius Officer#01a	418,{
	if (getbattleflag("feature.bgqueue"))
		end;
	if (checkweight(1201,1) == 0) {
		mes "- 请稍等！-";
		mes "- 你目前携带了 -";
		mes "- 太多物品。-";
		mes "- 请在减轻负重后 -";
		mes "- 再试一次。-";
		close;
	}
	mes "[Guillaume Army Officer]";
	mes "让那些臭烘烘的克鲁瓦军见识一下吉约姆军的力量！";
	next;
	switch(select("我想加入你们的军队！:结束对话")) {
	case 1:
		if ((BaseJob == Job_Novice) || (BaseJob == Job_Super_Novice)) {
			mes "[Guillaume Army Officer]";
			mes "我很高兴你想加入我们对抗克鲁瓦军，但很抱歉：我不能让你这样的新人去残酷的战场送死。";
		}
		else {
			if (BaseLevel < 80) {
				mes "[Guillaume Army Officer]";
				mes "我很高兴你想加入我们对抗克鲁瓦军，但很抱歉：我不能让你这样的新人去残酷的战场送死。";
			}
			else {
				set .@chk_urtime,checkquest(2070,PLAYTIME);
				if ((.@chk_urtime == 0)|| (.@chk_urtime == 1)) {
					mes "[Guillaume Army Officer]";
					mes "你似乎刚从战场回来。";
					mes "现在回去还太早。去休息吧，敌人交给我们！";
				}
				else {
					if (.@chk_urtime == 2)
						erasequest 2070;
					set .@mapcount2,getmapusers("bat_b01");
					if (.@mapcount2 > 0) {
						mes "[Guillaume Army Officer]";
						mes "报告称，一支精锐部队已经被派往战场与克鲁瓦军交战。";
						mes "你先等一会儿吧？趁这段时间磨利武器、准备补给。";
					}
					else {
						if ($@FlaviusBG1 > 0) {
							mes "[Guillaume Army Officer]";
							mes "一支精锐部队已经待命，准备出发前往战场。";
							mes "你先等一会儿吧？趁这段时间磨利武器、准备补给。";
						}
						else {
							mes "[Guillaume Army Officer]";
							mes "你看起来已经做好战斗准备了！";
							mes "去让克鲁瓦军见识真正的恐惧吧！";
							mes "今天，我们的胜利呼声将响彻整个战场！";
							close2;
							warp "bat_room",85,223;
							end;
						}
					}
				}
			}
		}
		break;
	case 2:
		mes "[Guillaume Army Officer]";
		mes "今天，我们必将胜利！";
		break;
	}
	close;
}


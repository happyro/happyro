// Doll Quest
//============================================================
alberta,117,135,0	script	Elin	96,{
	if (checkweight(1201,1) == 0) {
		mes "[Elin]";
		mes "^3355FF等一下！你现在携带的物品太多了。请先把一些物品存入卡普拉仓库后再回来。^000000";
		close;
	}
	mes "[Elin]";
	if (Sex == SEX_MALE) {
		mes "你好呀~！";
		mes "嘿嘿，你是男孩子，所以应该不喜欢娃娃吧？不过我非常非常喜欢娃娃！";
	} else {
		mes "嗨嗨~！哦哦，你喜欢娃娃吗？我真的真的很喜欢娃娃……嘿嘿~！";
	}
	next;
	mes "[Elin]";
	mes "我真的真的想要一个新娃娃！希望爸爸能在我生日时送我一个……！";
	next;
	switch(select("嗯，希望你爸爸送你一个。:不如我现在送你一个？")) {
	case 1:
		mes "[Elin]";
		mes "是啊，我希望";
		mes "他送我一个溜溜猴";
		mes "娃娃。它们太可爱了！";
		close;
	case 2:
		if (MaxWeight - Weight < 1000) {
			mes "[Elin]";
			if (Sex == SEX_MALE) {
				mes "你应该先存放一些东西，看起来你带得太多了，嘿嘿~";
			} else {
				mes "你总是带这么多东西吗？先存放一些，好吗？";
			}
			close;
		}
		mes "[Elin]";
		if (Sex == SEX_MALE) {
			mes "天哪！";
			mes "真的吗？你真是";
			mes "太贴心了~！";
		} else {
			mes "真的吗？";
			mes "你要送给";
			mes "我一个娃娃？耶~";
		}
		next;
		mes "[Elin]";
		mes "你要送我什么娃娃？你真的会送我吗？";
		next;
		switch(select("波利娃娃:苍蝇娃娃:布偶:摇滚蝗虫娃娃:蘑菇娃娃:俄赛里斯娃娃:巴风特娃娃:狸猫娃娃:溜溜猴娃娃:我像娃娃一样可爱。")) {
		case 1:
			if (countitem(741) >= 1) {
				delitem 741,1; //Poring_Doll
				mes "[Elin]";
				mes "啊……";
				mes "我已经有很多";
				mes "波利娃娃了……";
				next;
				mes "[Elin]";
				if (Sex == SEX_MALE) {
					mes "不过这是可爱的男孩子送的，我就开心收下啦！嘿嘿，柔软蓬松的波利娃娃~";
				} else {
					mes "不过这是漂亮女孩送的，我就收下啦！嘿嘿，柔软蓬松的波利娃娃~";
				}
				next;
				mes "[Elin]";
				mes "哦，让我送你点东西表示感谢。其实我藏了一些糖果，这样就能瞒着妈妈偷偷吃了。";
				next;
				getitem 529,1; //Candy
				mes "[Elin]";
				if (Sex == SEX_MALE) {
					mes "不知道你是不是已经不喜欢糖果了，不过应该没关系。";
				} else {
					mes "所以别吃太多，好吗？不然可能会惹麻烦！";
				}
				next;
				mes "[Elin]";
				mes "非常感谢你";
				mes "送我的";
				mes "波利娃娃！";
				close;
			} else {
				mes "[Elin]";
				if (Sex == SEX_MALE) {
					mes "啊……？";
					mes "你只是在逗我吗？";
				} else {
					mes "啊……";
					mes "你不是在嘲笑我吧？";
				}
				next;
				mes "[Elin]";
				mes "我想你一定把它忘在哪儿了……";
				close;
			}
		case 2:
			if (countitem(742) >= 1) {
				delitem 742,1; //Chonchon_Doll
				mes "[Elin]";
				mes "啊——！";
				mes "苍、苍蝇娃娃？！";
				next;
				mes "[Elin]";
				if (Sex == SEX_MALE) {
					mes "不过既然……你是……这么好的人……那我就收下了……！";
				} else {
					mes "不过既然……既然是礼物……那我就收下吧……";
				}
				next;
				mes "[Elin]";
				mes "嗯~";
				mes "让我回送你";
				mes "一些东西……";
				next;
				getitem 530,1; //Candy_Striper
				mes "[Elin]";
				mes "吃太多的话牙齿会蛀掉……至少妈妈是这么说的。";
				next;
				mes "[Elin]";
				mes "还有……";
				mes "呃……";
				mes "谢谢你";
				mes "送我娃娃？";
				close;
			} else {
				mes "[Elin]";
				mes "苍蝇娃娃本来就很丑，但你还是骗了我！你怎么能这么坏？！";
				next;
				mes "[Elin]";
				mes "哇啊啊啊啊~~";
				close;
			}
		case 3:
			if (countitem(740) >= 1) {
				delitem 740,1; //Stuffed_Doll
				mes "[Elin]";
				mes "哇……！";
				mes "看起来像兔子！";
				next;
				mes "[Elin]";
				mes "我很喜欢这个布偶~嘿嘿嘿！太感谢你了~";
				next;
				mes "[Elin]";
				mes "哦哦！";
				mes "我也有东西";
				mes "要给你！";
				mes "嗯，在哪儿";
				mes "来着……啊！";
				next;
				getitem 530,1; //Candy_Striper
				mes "[Elin]";
				mes "就是这个！这是圣诞老人送我的糖果。快尝尝！哦，还有，非常感谢你送的娃娃！";
				close;
			} else {
				mes "[Elin]";
				mes "啊，你只是在开玩笑吗？你、你为什么要这样逗我？";
				next;
				mes "[Elin]";
				mes "^666666*抽泣……*^000000";
				next;
				mes "[Elin]";
				mes "哇啊啊啊啊~~";
				close;
			}
		case 4:
			if (countitem(752) >= 1) {
				delitem 752,1; //Grasshopper_Doll
				mes "[Elin]";
				mes "哦！摇滚蝗虫娃娃！";
				mes "这是喜欢唱歌跳舞的摇滚蝗虫！我不喜欢蝗虫，但这个很可爱，所以我喜欢~";
				next;
				mes "[Elin]";
				mes "嗯，我也该送你点东西，对吧？让我看看，这是爷爷给我的……";
				next;
				getitem 532,7; //Banana_Juice
				mes "[Elin]";
				mes "给你！家里有很多这个，所以送给你，好吗？哦，也非常感谢你送的娃娃~我喜欢可爱的娃娃！";
				close;
			} else {
				mes "[Elin]";
				mes "啊……";
				next;
				mes "[Elin]";
				mes "你真的";
				mes "没有娃娃吗……？";
				mes "我还那么期待呢……";
				close;
			}
		case 5:
			if (countitem(743) >= 1) {
				delitem 743,1; //Spore_Doll
				mes "[Elin]";
				mes "这是蘑菇？";
				mes "呃，好恶心！";
				mes "妈妈今天也让我吃了";
				mes "蘑菇……";
				next;
				mes "[Elin]";
				mes "不过这个娃娃很可爱，我就收下了。但我还是不要吃蘑菇！嘿嘿~";
				next;
				getitem 538,5; //Well_Baked_Cookie
				mes "[Elin]";
				mes "嘿嘿~这是妈妈做的！真的很好吃。我也喜欢饼干。尝尝吧，你会喜欢的！嘿嘿！";
				next;
				mes "[Elin]";
				mes "谢谢你送的";
				mes "娃娃！我会";
				mes "好好珍惜它的！";
				close;
			} else {
				mes "[Elin]";
				mes "咦……？";
				mes "你没有";
				mes "娃娃吗？";
				next;
				mes "[Elin]";
				mes "啊……";
				mes "这样逗人";
				mes "可不太好。^666666*抽泣，抽泣*^000000";
				close;
			}
		case 6:
			if (countitem(751) >= 1) {
				delitem 751,1; //Osiris_Doll
				mes "[Elin]";
				mes "啊啊啊！";
				mes "这是什么";
				mes "东西？！太可怕了！";
				next;
				mes "[Elin]";
				mes "我从没见过这样的娃娃。它是从哪儿来的？嗯？既然以前没见过，我也要拿给爸爸看看。嘿嘿~！他一定会吓一跳！";
				next;
				mes "[Elin]";
				mes "来，你送我这么精致的娃娃，我也该送你点好东西。";
				next;
				getitem 522,2; //Fruit_Of_Mastela
				mes "[Elin]";
				mes "这是我偷偷去森林时找到的，因为颜色漂亮就拿来了！";
				if (Sex == SEX_MALE) {
					mes "这里有两个，你可以和女朋友分享。嘿嘿~！";
				} else {
					mes "这里有两个，你可以和男朋友分享。嘿嘿~！";
				}
				close;
			} else {
				mes "[Elin]";
				mes "啊……";
				mes "你为什么要";
				mes "嘲笑我？";
				close;
			}
		case 7:
			if (countitem(750) >= 1) {
				delitem 750,1; //Baphomet_Doll
				mes "[Elin]";
				mes "咦？";
				mes "是一只小山羊……";
				next;
				mes "[Elin]";
				mes "真奇怪。既可爱又有点吓人。不过既然你送我漂亮的娃娃，我也想送你点东西。";
				next;
				getitem 525,5; //Panacea
				mes "[Elin]";
			mes "我生病时爸爸给我的。我已经不生病了，你需要时可以用。嘿嘿~";
				next;
				mes "[Elin]";
			mes "嘿嘿~";
			mes "谢谢你送的";
			mes "娃娃。我不会弄丢的！";
				close;
			} else {
				mes "[Elin]";
			mes "你这个大骗子！为什么要假装友善？！";
				close;
			}
		case 8:
			if (countitem(754) >= 1) {
				delitem 754,1; //Raccoondog_Doll
				mes "[Elin]";
			mes "嘿嘿，这是";
			mes "狸猫娃娃。";
			mes "非常非常可爱~";
				next;
				mes "[Elin]";
			mes "我现实中不喜欢";
			mes "狸猫，";
			mes "但这个娃娃很棒！";
				next;
				getitem 539,3; //Piece_Of_Cake
				mes "[Elin]";
			mes "来，我给你一些奶奶做的蛋糕。真的很好吃。不知道你喜不喜欢甜食，但它真的很棒！请尝尝！";
				next;
				mes "[Elin]";
			mes "嘿嘿~";
			mes "谢谢你送的娃娃。";
			mes "我要把它";
			mes "放在房间里！";
				close;
			} else {
				mes "[Elin]";
			mes "喂！你为什么要说这种话？你在嘲笑我吗？！";
				close;
			}
		case 9:
			if (countitem(753) >= 1) {
				delitem 753,1; //Monkey_Doll
				mes "[Elin]";
			mes "哇哦哦哦~！";
				next;
				mes "[Elin]";
			mes "溜溜猴娃娃！太漂亮了！你真的要送给我吗？！耶！太感谢你了！我很喜欢！嘿嘿！";
				next;
				mes "[Elin]";
			mes "既然你送给我";
			mes "这么漂亮的娃娃，";
			mes "我也想送你";
			mes "一些东西！";
				next;
				getitem 608,1; //Seed_Of_Yggdrasil
				mes "[Elin]";
			mes "爸爸去别的城镇时捡到的。看起来像某种种子。我试着种在家门前，但它不发芽。你想试试吗？";
				next;
				mes "[Elin]";
			mes "嘿嘿~";
			mes "谢谢你送的";
			mes "娃娃。睡觉前";
			mes "我要抱着它";
			mes "入睡！";
				close;
			} else {
				mes "[Elin]";
			mes "喂……";
			mes "你为什么要嘲笑我？！";
				close;
			}
		case 10:
			mes "["+strcharinfo(0)+"]";
		mes "我像娃娃一样可爱……";
			next;
			mes "[Elin]";
		mes "什——么……？";
			next;
			mes "[Elin]";
		mes "^3355FF你刚才^000000";
		mes "^3355FF说什么？！^000000";
			close;
		}
	}
}

// 'Boy's Cap' Quest
//============================================================
alberta_in,28,145,4	script	Grampa	120,{
	mes "[Grampa]";
	mes "*喘气*……";
	mes "……*喘气！*";
	mes "哦……";
	mes "有人说我这一生沉醉于美酒、美人和歌声……";
	next;
	mes "[Grampa]";
	mes "但我的灵魂仍燃烧着青春的活力！只是……这副老身体已经跟不上了……*咳！呼哧~*";
	next;
	if (countitem(1030) > 9) {
		switch(select("给他看虎皮脚.:用它交换男孩帽.:取消")) {
		case 1:
			mes "[Grampa]";
			mes "哦哦~！！";
			mes "那是……？";
			mes "没错！";
			mes "那就是虎皮脚！！在这里我都能感受到它的力量！";
			next;
			mes "[Grampa]";
			mes "看一眼就能恢复力量，闻一闻就会热血沸腾、充满活力……";
			next;
			mes "[Grampa]";
			mes "只要咬一口……";
			mes "就能恢复我的雄风！！！！虎皮脚~！！哦哦！我的天！！求你了！！请把它给我……求你……";
			close;
		case 2:
			delitem 1030,10;  //Tiger_Footskin
			getitem 5016,1; //Boy's_Cap
			mes "[Grampa]";
			mes "谢、谢谢！！";
			mes "有了它我就能恢复青春风采！！我必须马上吃掉它！";
			next;
			mes "[Grampa]";
			mes "...";
			mes "不，还是觉得老。";
			mes "反而更糟了。脑、脑袋里一直嗡嗡作响……";
			close;
		case 3:
			mes "[Grampa]";
			mes "喂……喂，小子！！等、等一下！";
			close;
		}
	} 
	else {
		switch(select("交谈:取消")) {
		case 1:
			mes "[Grampa]";
			mes "听好了……";
			mes "你必须尽可能照顾好自己。没有健康，就无法享受尘世的乐趣。";
			next;
			mes "[Grampa]";
			mes "为了恢复青春，我尝试了各种方法，大多是道听途说，但都没用。最后我在奇药上花光了 Zeny，变得一贫如洗。";
			next;
			mes "[Grampa]";
			mes "我基本放弃恢复青春了。但还有一个希望……吃下^3355FF虎皮脚^000000，活力之王！！";
			next;
			mes "[Grampa]";
			mes "你没听说过吗？！看一眼就能让白发恢复颜色，闻一闻，甚至摸一下，八十岁老人也能重获青春……这就是活力之王！";
			next;
			mes "[Grampa]";
			mes "在我死之前……";
			mes "我希望能吃十个虎皮脚。那样我就不用死了！";
			next;
			mes "[Grampa]";
			mes "如果有人帮我弄到它们，我会毫不吝惜地把珍贵的^3355FF男孩帽^000000送给那个人……";
			close;
		case 2:
			mes "[Grampa]";
			mes "咳咳！！";
			mes "虎……虎皮……脚……咳咳！！";
			close;
		}
	}
}

// 'Antlers' Quest
//============================================================
alberta_in,122,53,4	script	Cherokee	47,{
	mes "[Cherokee]";
	mes "你好呀~！";
	next;
	mes "[Cherokee]";
	mes "你怎么看动物角？哦，我觉得它们棒极了！你不觉得吗？我太喜欢动物角了，所以成了^3355FF角收藏家^000000。";
	next;
	mes "[Cherokee]";
	mes "动物角有很多用途。可以戴在头上，也可以戴在……嗯，房子上？总之用途多多！";
	next;
	mes "[Cherokee]";
	mes "我几乎收集了所有种类的角，唯独缺少^FF3355邪恶之角^000000。据说它不是动物的角，而是恶魔的角。不过即便如此，我还是想要。";
	next;
	mes "[Cherokee]";
	mes "你……";
	mes "你有^FF3355邪恶之角^000000吗？";
	mes "如果你给我二十个邪恶之角，我就把珍藏的^3355FF鹿角^000000送给你。成交吗？";
	next;
	switch(select("好，成交。:闭嘴，笨蛋。")) {
	case 1:
		if (countitem(923) > 19) {
			delitem 923,20;  //Evil_Horn
			mes "[Cherokee]";
			mes "哇~！这是我第一次见到真正的^FF3355邪恶之角^000000！！";
			mes "谢谢你！来，这是给你的鹿角！";
			getitem 2284,1; // Antler
			next;
			mes "[Cherokee]";
			mes "多亏你的帮助，我这次终于能实现愿望了。我终于会被认可为真正的角收藏家。太感谢了~！";
			close;
		}

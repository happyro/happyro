// Bard Jet
//============================================================
payon_in02,67,65,3	script	Bard Jet#tu	1_M_BARD,{
	mes "[杰特]";
	mes "每位神明都不会老去";
	mes "因为美丽的";
	mes "女神伊登。";
	mes "青春苹果的守护者，";
	mes "不朽女神。";
	next;
	mes "[杰特]";
	if (BaseJob == Job_Archer){
		mes "哦，你是弓箭手？";
		mes "曾经我也是弓箭手。";
		mes "但我转职了，现在用歌曲和幽默娱乐大众。";
		next;
		mes "[杰特]";
		mes "说到这个……";
		mes "让我给你讲个笑话！";
		mes "相信我，非常好笑~";
		mes "^333333*咳嗯*^000000";
		emotion ET_SURPRISE;
		next;
		mes "[杰特]";
		mes "一只白蚁走进";
		mes "酒吧问道：";
		mes "“这里有酒保吗？”";
		mes "哈哈哈哈哈！";
		mes "呜哈哈哈哈！";
		emotion ET_THROB;
		next;
		mes "[杰特]";
		mes "哈哈哈~！";
		mes "天啊，";
		mes "我真幽默！";
		mes "现在你来！";
		mes "来，编一个";
		mes "笑话~！";
		emotion ET_KIK;
		next;
		if (Sex == SEX_MALE) {
			select("笑话，是吗？");
			specialeffect2 EF_TALK_FROSTJOKE;
			mes "[杰特]";
			mes "哦……";
			mes "我……";
			mes "的天……";
			next;
			mes "[杰特]";
			mes "这是我一生听过的";
			mes "最棒的笑话！你真的有";
			mes "天生的表演";
			mes "天赋！你";
			mes "应该成为诗人！";
		} else {
			select("尖叫！");
			specialeffect2 EF_TALK_SCREAM;
			mes "[杰特]";
			mes "哇、哇……";
			mes "我不知道为什么，但那真的太棒了。你一定";
			mes "具备成为舞娘的资质……";
		}
		emotion ET_BEST;
		next;
		mes "[杰特]";
		mes "不过在那之前，你得先摆脱弓箭手的样子，对吧？";
		next;
		mes "[杰特]";
		mes "其实我是";
		mes "^3131FF弓箭手公会^000000“伊卡鲁斯”的成员，它在^3131FF转职办公室左边^000000。你应该能在那里";
		mes "学到很多。";
		next;
		mes "[杰特]";
		mes "好了，去学习";
		mes "一切并转职，";
		mes "这样你就能";
		mes "来和我玩了！";
	} else if (BaseJob == Job_Bard){
		mes "哦……！";
		mes "你是……！";
		next;
		specialeffect2 EF_TALK_FROSTJOKE;
		//specialeffect EF_TALK_FROSTJOKE,AREA,"Bard Jet#tu";
		emotion ET_BEST;
		mes "[杰特]";
		mes "让我看看……";
		mes "我一直在想";
		mes "一个新笑话，";
		mes "但我需要一些";
		mes "反馈。准备好了吗？";
		next;
		mes "[杰特]";
		mes "男商人对";
		mes "跳舞的伊西斯说了什么？";
		mes "猜不到？";
		next;
		mes "[杰特]";
		mes "“贪婪投掷！”";
		mes "明白吗？因为他";
		mes "把钱扔向她，";
		mes "而“贪婪投掷”这个词";
		mes "听起来——等等。如果我得解释";
		mes "就不好笑了，对吧？";
	} else if (BaseJob == Job_Dancer){
		mes "哦……！";
		mes "你好，你好！";
		mes "如果有一天我们能";
		mes "一起";
		mes "表演";
		mes "该多好？";
	} else {
		mes "你看起来很无聊……";
		mes "生活真的那么";
		mes "平淡乏味吗？";
		mes "那么……我会让";
		mes "你笑起来……";
		next;
		mes "[杰特]";
		mes "^333333*咳嗯*^000000";
		mes "这是";
		mes "黑帮杀手的";
		mes "临终遗言……";
		next;
		mes "[杰特]";
		mes "“谁把";
		mes "小提琴放进这个";
		mes "小提琴盒了？！”";
		mes "哇哈哈哈哈哈哈！";
		mes "懂这个笑话吗？";
	}
	close;
}

// Sign
//============================================================
pay_arche,127,154,4	script	Sign#arc	2_BOARD1,{
	mes " ";
	mes " Archer Job Change Office ---> ";
	mes " <--- Icarus ";
	mes " ";
	close;
}

// Master Kavaruk
//============================================================
payon_in02,54,13,3	script	Master Kavaruk	1_M_JOBTESTER,{
	mes "[卡瓦鲁克大师]";
	mes "你好，年轻人。";
	mes "我是";
	mes "伊卡鲁斯弓箭手公会的卡瓦鲁克大师。";
	mes "欢迎你。";
	next;
	switch(select("询问“伊卡鲁斯”。:询问最近消息。:谈谈弓箭手。")) {
	case 1:
		mes "[卡瓦鲁克大师]";
		mes "你听说过";
		mes "这个故事吗";
		mes "伊卡鲁斯的故事吗？";
		next;
		mes "[卡瓦鲁克大师]";
		mes "伊卡鲁斯是个勇敢的年轻人，他用蜂蜡粘合的翅膀飞过天空。出于好奇，他飞得离太阳太近，翅膀融化后坠落身亡。";
		next;
		mes "[卡瓦鲁克大师]";
		mes "虽然他的故事很悲惨，但伊卡鲁斯拥有勇敢的心，";
		mes "我们应该以此";
		mes "作为标准。";
		next;
		mes "[卡瓦鲁克大师]";
		mes "我们公会成员不仅希望勇敢，也像伊卡鲁斯一样追逐梦想。成员包括想成为弓箭手的人、曾经的弓箭手和现在的弓箭手。";
		next;
		mes "[卡瓦鲁克大师]";
		if (Class == Job_Novice){
			mes "如果你想成为弓箭手，不如四处了解";
			mes "一些职业知识？我相信你能在这里听到很多故事。";
		}
		else if(Class == Job_Archer){
			mes "既然你是弓箭手，四处聆听别人的";
			mes "战斗经历会让你受益。熟悉不同战斗情形将帮助你应对未来。";
		}
		else if (BaseJob == Job_Hunter){
			mes "[卡瓦鲁克大师]";
			mes "阿佩斯托正在外面等你。";
			mes "他是经验丰富的";
			mes "猎人，能";
			mes "给你很大帮助。";
		}
		else if (BaseJob == Job_Dancer){
			mes "事实上，我们有几位";
			mes "成员擅长用";
			mes "优雅的舞蹈吸引";
			mes "观众的注意，";
			mes "就像你一样。";
			next;
			mes "[卡瓦鲁克大师]";
			mes "……但我现在似乎没看到";
			mes "他们中的任何人。他们从不在一个地方停留太久，";
			mes "不过我相信他们总有一天会出现在这里，";
			mes "";
		}
		else if (BaseJob == Job_Bard){
			mes "事实上，我们有几位成员";
			mes "非常擅长唱歌和娱乐盟友，就像你一样。";
			next;
			mes "[卡瓦鲁克大师]";
			mes "……但我现在似乎没看到他们。他们随风漫游，不过我相信总有一天会回到这里";
			mes "。";
		}
		else {
			mes "他们了解许多与弓箭手相关的职业。你不如和他们谈谈，进一步了解";
			mes "这些职业？";
		}
		close;
	case 2:
		mes "[卡瓦鲁克大师]";
		if (BaseJob == Job_Archer) {
			if(tu_archer02 == 0){
				mes "哦，幸好";
				mes "你来了， "+strcharinfo(0)+".";
				mes "我刚收到炼金术士";
				mes "公会在艾尔帕兰的支援请求。";
				next;
				mes "[卡瓦鲁克大师]";
				mes "他们一直照料";
				mes "一片花妖田来筹措资金，但最近流浪猫似乎一直在破坏那里的植物。";
				next;
				mes "[卡瓦鲁克大师]";
				mes "炼金术士们一直用炼金术召唤花妖来维持田地，但这正在消耗他们的资源。";
				next;
				mes "[卡瓦鲁克大师]";
				mes "他们愿意奖励带来^3131FF食人花花瓣^000000和^3131FF树茎^000000等材料的人，这些材料能帮助他们恢复";
				mes "花妖。";
				next;
				mes "[卡瓦鲁克大师]";
				mes "如果你有兴趣，最好去找炼金术士公会成员，他在^3131FF伊卡鲁斯南边道路旁的商店^000000等我们的消息。";
				tu_archer02 = 1;
				close;
			} else if(tu_archer02 == 1){
				mes "嗯……";
				mes "..........";
				next;
				select("出什么事了吗？");
				mes "[卡瓦鲁克大师]";
				mes "事实上，我们遇到了问题。";
				mes "大师职位似乎权力很大，但我必须一直留在这里，无法离开岗位。";
				next;
				mes "[卡瓦鲁克大师]";
				mes "我请伊卡鲁斯的一名成员";
				mes "在卢恩·米德加尔兹王国四处走动，收集最近发生的消息。";
				next;
				mes "[卡瓦鲁克大师]";
				mes "他一直寄信给我，提供详细信息，但突然间我失去了联系。我担心他出了什么事。";
				next;
				mes "[卡瓦鲁克大师]";
				mes "请你去找";
				mes "^3131FF风之阿赛尔^000000好吗？虽然他不喜欢人群，但我命令他在人群中收集信息。";
				next;
				mes "[卡瓦鲁克大师]";
				mes "请确认他是否安好，并帮助他解决";
				mes "可能遇到的问题。在此期间我会等你的消息，非常感谢。";
				tu_archer02 = 2;
				close;
			} else if(tu_archer02 == 2){
				mes "找到";
				mes "风之阿赛尔。";
				mes "他应该在";
				mes "普隆德拉某处……";
				close;
			} else if(tu_archer02 == 9){
				mes "嗯，我明白了。谢谢你";
				mes "把消息带回来。正如阿赛尔所说，我会等他带来更多消息。";
				mes "你也应该训练，为未来做准备。";
				tu_archer02 = 10;
				if (checkre(3))
					getexp 1000,1000;
				else
					getexp 2000,1000;
				close;
			}
		}
		mes "我不知道……";
		mes "最近没听到什么值得注意的消息。目前，太阳的温暖似乎守护着这里的和平。";
		next;
		mes "[卡瓦鲁克大师]";
		mes "但如果我听到";
		mes "任何有趣的传闻，";
		mes "我会告诉你。";
		close;
	case 3:
		mes "[卡瓦鲁克大师]";
		if(tu_archer01 < 1){
			if(Class == Job_Novice || Class == Job_Baby){
				mes "啊……";
				mes "那么你有兴趣";
				mes "成为";
				mes "弓箭手吗？";
			} else if (Class == Job_Archer_High || BaseJob == Job_Dancer || BaseJob == Job_Bard){
				mes "我承认你是专家，但偶尔复习弓术基础也是好主意。要试试复习训练吗？";
			} else if (BaseJob == Job_Hunter){
				mes "[卡瓦鲁克大师]";
				mes "阿佩斯托正在外面等你。";
				mes "他是经验丰富的";
				mes "猎人，能";
				mes "给你很大帮助。";
				close;
			} else if(Class == Job_Archer || Class == Job_Baby_Archer){
				mes "作为弓箭手，你应该牢牢掌握职业基础。";
				mes "想接受专项指导吗？";
			} else {
				mes "虽然你可能无法";
				mes "直接运用弓术知识，但了解";
				mes "弓箭手伙伴的能力也很有用。";
				next;
				mes "[卡瓦鲁克大师]";
				mes "你想不想接受专项指导，";
				mes "进一步了解弓箭手职业？";
			}
			next;
			switch(select("是:否")){
			case 1:
				tu_archer01 = 1;
				mes "[卡瓦鲁克大师]";
				mes "好的。那么请把这封消息";
				mes "带给^3131FF伊西斯纳^000000，她在伊卡鲁斯西边的训练场。";
				next;
				mes "^3355FF你收到了";
				mes "卡瓦鲁克给";
				mes "伊西斯纳的消息。^000000";
				next;
				mes "[卡瓦鲁克大师]";
				mes "伊西斯纳非常勤奋，";
				mes "沉着、聪明且";
				mes "能力出众。我相信";
				mes "你能从她那里学到很多。";
				close;
			case 2:
				mes "[卡瓦鲁克大师]";
				mes "啊，我明白了。好吧，";
				mes "伊卡鲁斯永远张开双臂欢迎你。";
				mes "如果你";
				mes "改变主意，随时";
				mes "欢迎回来。";
				close;
			}
		} else if(tu_archer01 == 1 || tu_archer01 == 2){
			mes "嗯……？";
			mes "你还在这里";
			mes "做什么？去伊卡鲁斯西边的";
			mes "山丘，和";
			mes "^3131FF伊西斯纳^000000谈谈，开始专项训练。";
			close;
		} else if(tu_archer01 == 3){
			mes "那么，"+strcharinfo(0)+",";
			mes "体验还好吗？只学理论并不有趣，但这是必要的。";
			next;
			mes "[卡瓦鲁克大师]";
			if (BaseJob == Job_Archer){
				mes "现在该亲自体验刚学的原则了。去和大楼外的^3131FF莱丁·科西^000000谈谈，他会告诉你各种技能。";
				tu_archer01 = 4;
			} else {
				mes "不过你不必进行实地训练，因为只有弓箭手能参加";
				mes "那项训练。";
			}
			close;
		} else if(tu_archer01 == 4 && BaseJob == Job_Archer) {
			mes "莱丁·科西就在大楼外。你进来时没看到他吗？";
			close;
		}
	}
	mes "你现在这样";
	mes "就很棒。";
	mes "不过如果你觉得需要什么，就和公会成员谈谈，听听他们的人生经历。";
	close;
}

// Reidin Corse
//============================================================
pay_arche,103,165,5	script	Reidin Corse#tu	4_M_REIDIN_KURS,{
	mes "[莱丁·科西]";
	if (checkweight(1201,1) == 0) {
		mes "[莱丁·科西]";
		mes "你为什么带着";
		mes "这么多东西？最好把不需要的放进卡普拉仓库。";
		close;
	}
	if(MaxWeight - Weight < 2000){
		mes "嘿，你带的东西";
		mes "太多了。你应该";
		mes "把一些物品";
		mes "放进卡普拉仓库……";
		close;
	}
	if(tu_archer01 > 0 && (BaseJob != Job_Hunter && BaseJob != Job_Bard && BaseJob != Job_Dancer || Upper == 2)){
		if(tu_archer01 == 4){
			mes "啊，怎么了？";
			mes "我能帮你";
			mes "什么吗？";
			next;
			switch(select("告诉我技能。:呃，其实没什么……")) {
			case 1:
				mes "[莱丁·科西]";
				mes "嗯。那么，卡瓦鲁克大师";
				mes "让你";
				mes "来找我，是吗？";
				mes "好吧。";
				emotion ET_KIK;
				next;
				break;
			case 2:
				mes "[莱丁·科西]";
				mes "嗯……？";
				mes "好吧。你确定";
				mes "没什么要";
				mes "问我吗？你刚才";
				mes "就是那副表情。";
				close;
			}
			mes "[莱丁·科西]";
			mes "好吧。我非常";
			mes "忙，但会抽时间教你弓箭手技能……不过有一个条件！";
			next;
			mes "[莱丁·科西]";
			mes "从现在开始，你得";
			mes "叫我^3131FF首领^000000，明白吗？跟着我，你会成为世界第二强的弓箭手！怎么样，";
			mes "小子？";
			next;
			switch(select("明白了，首领！:呃，不用了~！")) {
			case 1:
				mes "[莱丁·科西]";
				mes "呵呵！";
				mes "这才对！";
				mes "很好很好~从现在起";
				mes "叫我首领，听见了吗？";
				next;
				break;
			case 2:
				mes "[莱丁·科西]";
				mes "嗯？这是什么态度";
				mes "啊，我明白了。你还不够成熟，无法在伟大就在眼前时";
				mes "认出它。";
				next;
				mes "[莱丁·科西]";
				mes "别担心……";
				mes "等你爬着";
				mes "回来时，我会重新考虑";
				mes "教你。";
				close;
			}
			mes "[莱丁·科西]";
			mes "让我看看……";
			mes "你知道多少？";
			mes "Mmmmmmmmmm...";
			next;
			mes "^3355FF莱丁·科西眯起老练的双眼打量你。^000000";
			next;
			mes "[莱丁·科西]";
			if(JobLevel > 39)
				mes "嘿！你已经准备好转职了，对吧？别在这里浪费时间，赶紧转职吧！或者你也可以请卡瓦鲁克大师给你安排事情。";
			else if(JobLevel < 5){
				mes "好！这里有个新弓箭手！你来找我真幸运，我是你能找到的最棒老师！不过我教得很快，所以尽量跟上";
				mes "。好吗？很好。";
				next;
				tu_archer01 = 5;
				mes "[莱丁·科西]";
				mes "好，我准备开始课程了！准备好弓、箭和其他东西后再回来，明白吗？";
			} else {
				mes "好。看来你已经知道";
				mes "一些东西。但即使你";

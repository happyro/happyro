		mes "看起来很喜欢，所以有空就来帮我吧~";
		close;
	} else if (hg_milk == 9) {
		mes "[Kurupe]";
		mes "哦，又是你！想帮我给 Booboo 奶牛挤奶吗？我总是需要你这样可靠的人。";
		next;
		switch(select("好，我给 Booboo 挤奶。:这次给我什么报酬？:不了，只是路过。")) {
		case 1:
			mes "[Kurupe]";
			mes "太好了！想给 Booboo 挤奶的话，先告诉 Burupu 今天不用来上班，再回来找我。我就让你给 Booboo 挤奶。";
			set hg_milk,10;
			close;
		case 2:
			mes "[Kurupe]";
			mes "让我看看……这次替我给 Booboo 挤奶，我会随机选择一组奖励给你。";
			next;
			mes "5 份牛奶、3 份蜂蜜、5 瓶橙色药水、1 组黄色药水，或 1 捆食物。嗯……听起来很公平，对吧？";
			close;
		case 3:
			mes "[Kurupe]";
			mes "啊哈哈哈，见到你真好！别变得见外，好吗？Burupu 可以向你学习一些东西……";
			close;
		}
	} else if (hg_milk == 10) {
		mes "[Kurupe]";
		mes "现在去告诉 Burupu 今天不用来上班~";
		close;
	} else if (hg_milk == 11) {
		mes "[Kurupe]";
		mes "啊，你已经和 Burupu 说过了？很好。现在请给 Booboo 挤奶，好吗？再次感谢~";
		set hg_milk,12;
		close;
	} else if (hg_milk == 12) {
		mes "[Kurupe]";
		mes "请尽快给 Booboo 挤奶，好吗？";
		close;
	} else if (hg_milk == 13) {
		mes "[Kurupe]";
		mes "啊，你把 Booboo 挤得很好。让我看看该给你什么报酬。嗯……";
		next;
		set .@milkreward,rand(1,10);
		if (.@milkreward < 5) {
			mes "[Kurupe]";
			mes "这样吧，给你一些牛奶？毕竟很合适，而且对你很好！再次感谢你的帮助~";
			if (checkweight(519,5) != 1) {
				next;
				mes "[Kurupe]";
				mes "等一下！你携带的物品太多。存入卡普拉仓库后再回来。";
				close;
			}
			set hg_milk,9;
			erasequest 12043;
			getitem 519,5; //Milk
			close;
		} else if (.@milkreward > 4 && .@milkreward < 8) {
			mes "[Kurupe]";
			mes "啊，我知道了！你喜欢橙色药水，对吧？来，这些送给你，感谢你给 Booboo 挤奶~";
			if (checkweight(502,5) != 1) {
				next;
				mes "[Kurupe]";
				mes "请稍等！";
				mes "你现在携带了太多物品。";
				mes "把一些物品存入卡普拉仓库后再回来。";
				mes "";
				mes "";
				close;
			}
			set hg_milk,9;
			erasequest 12043;
			getitem 502,5; //Orange_Potion
			close;
		} else if (.@milkreward > 7 && .@milkreward < 10) {
			mes "[Kurupe]";
			mes "哦，我可以给你黄色药水。对，好主意。请收下这些，感谢你给老 Booboo 挤奶。";
			if (checkweight(503,5) != 1) {
				next;
				mes "[Kurupe]";
				mes "请稍等！";
				mes "你现在携带了太多物品。";
				mes "把一些物品存入卡普拉仓库后再回来。";
				mes "";
				mes "";
				close;
			}
			set hg_milk,9;
			erasequest 12043;
			getitem 503,5; //Yellow_Potion
			close;
		} else {
			set .@milkreward,rand(1,10);
			if (.@milkreward < 7) {
				mes "[Kurupe]";
				mes "嘿，拿些新鲜蜂蜜吧？甜美又美味，是你想要的一切！谢谢你给 Booboo 挤奶~";
				if (checkweight(518,3) != 1) {
					next;
					mes "[Kurupe]";
					mes "请稍等！";
					mes "你现在携带了太多物品。";
					mes "把一些物品存入卡普拉仓库后再回来。";
					mes "";
					mes "";
					close;
				}
				set hg_milk,9;
				erasequest 12043;
				getitem 518,3; //Honey
				close;
			}
			mes "[Kurupe]";
			mes "来，吃点这种美味食物吧？我不记得里面装了什么，但肯定好吃，对你也有益~";
			if (checkweight(12111,1) != 1) {
				next;
				mes "[Kurupe]";
				mes "请稍等！";
				mes "你现在携带了太多物品。";
				mes "把一些物品存入卡普拉仓库后再回来。";
				mes "";
				mes "";
				close;
			}
			set hg_milk,9;
			erasequest 12043;
			getitem 12111,1; //Food_Package
			close;
		}
	} else {
		mes "[Kurupe]";
		mes "啊，糟糕……！明天有很多牛奶要配送，但没有牛奶我该怎么办？！";
		close;
	}

OnTouch_:
	if (BaseLevel > 49) {
		if (!hg_milk) {
			mes "[Kurupe]";
			mes "糟糕，我该怎么办？！明天要配送牛奶，但 Burupu 还没来！";
			emotion ET_HUK;
			next;
			mes "[Kurupe]";
			mes "他什么时候来上班？Burupu，你在哪里？！";
			emotion ET_SWEAT;
			set hg_milk,1;
			close;
		}
	}
	mes "[Kurupe]";
	mes "Burupu 为什么还没来？他不快点来，我怎么在明天前送完牛奶？";
	close;
}

hu_fild06,217,270,3	script	Burupu	896,3,3,{
	if (hg_milk == 3) {
		mes "[Burupu]";
		mes "什么？Kurupe 要我回来上班？你看我像是想一辈子给 Booboo 挤奶吗？算了，我要当剑士！冲啊！";
		next;
		mes "[Burupu]";
		mes "自从飞艇降落城镇，我看到那些剑士，就知道这是我的命运！别管牧场了，我要挥舞该死的剑！";
		set hg_milk,4;
		close;
	} else if (hg_milk == 4) {
		mes "[Burupu]";
		mes "嘿，你那身装备看起来很贵。";
		mes "";
		mes "我想成为剑士就需要那种装备。嘿，我知道我们可以互相帮助~";
		next;
		mes "[Burupu]";
		mes "如果你能给我合适的剑士装备，我就帮你给 Booboo 挤奶。给我一把双洞刺剑怎么样？不算过分吧？";
		next;
		switch(select("好吧。:哇，这太过分了！")) {
			case 1:
				mes "[Burupu]";
				mes "很高兴你同意~尽快带一把双洞刺剑来！我等不及用它训练了！";
				set hg_milk,5;
				changequest 12040,12041;
				close;

			case 2:
				mes "[Burupu]";
				mes "你这么想……？这是我唯一真正想要的东西……";
				close;
		}
	} else if (hg_milk == 5) {
		if (!countitem(1110)) {
			mes "[Burupu]";
		mes "喂，你不是该带双洞刺剑来吗？想让我给 Booboo 挤奶，就遵守约定~";
			close;
		}
		mes "[Burupu]";
		mes "哦，哇……！好漂亮的刺剑！看，有两个洞！我现在就用它训练！";
		delitem 1110,1; //Lapier
		set hg_milk,6;
		changequest 12041,12042;
		next;
		mes "[Burupu]";
		mes "你知道吗？我改变主意了。不想给那头笨牛挤奶！不过剑士应该遵守承诺，对吧？这样吧。";
		next;
		mes "[Burupu]";
		mes "我把给 Booboo 挤奶的秘密说明埋在她东北方地下。仔细阅读后，你应该能自己挤奶。可以做到吧？";
		next;
		mes "[Burupu]";
		mes "别忘了找到并阅读说明。还有，再次感谢你的刺剑~";
		close;
	} else if (hg_milk == 10) {
		mes "[Burupu]";
		mes "嗯？你今天想给 Booboo 挤奶？太好了，";
		mes "这意味着我有更多时间练习剑术。";
		mes "好，现在我可以专心训练了！";
		mes "";
		mes "";
		mes "";
		set hg_milk,11;
		close;
	} else {
		mes "[Burupu]";
		mes "我要成为世界上最强的剑士！";
		mes "不过首先得学会怎么使用这东西！";
		mes "喝——呀！怎么样？那几乎就是 Magnum Break 了，对吧？";
		mes "";
		mes "";
		emotion ET_PROFUSELY_SWEAT;
		close;
	}

OnTouch_:
	if (hg_milk == 2) {
		mes "[Burupu]";
		mes "Heeeyah!";
		mes "Yaaaaaaaah!";
		mes "Wh-whooooooosh!";
		emotion ET_PROFUSELY_SWEAT;
		next;
		mes "[Burupu]";
		mes "可恶！为什么我会";
		mes "拥有这么糟糕的";
		mes "剑？！我是说，我已经厌倦了";
		mes "自己制造所有呼呼声和特效。";
		mes "";
		set hg_milk,3;
		emotion ET_FRET;
		close;
	} else if (hg_milk == 5) {
		mes "[Burupu]";
		mes "Heeeyah!";
		mes "Yaaaaaaaah!";
		mes "Yeeeeeeeyoooop!";
		emotion ET_PROFUSELY_SWEAT;
		close;
	}
}

hugel,72,101,0	script	Burupu's Instructions	111,{
	if (hg_milk < 6) {
		mes "^3355FFYou've found a small^000000";
		mes "^3355FFnotebook on the ground.^000000";
		close;
	}
	mes "^804000This small notebook^000000";
	mes "^804000contains Burupu's detailed^000000";
	mes "^804000instructions for milking^000000";
	mes "^804000这是 Booboo 奶牛的说明。虽然是手写的，^000000";
	mes "^804000但整理得非常好。^000000";
	mes "";
	next;
	mes "[Table of Contents]";
	mes " ";
	mes "第一章：如何给 Booboo 挤奶";
	mes "第二章：如何照顾 Booboo";
	mes "第三章：开始之前";
	next;
	switch(select("第一章:第二章:第三章")) {
	case 1:
		mes "[Chapter 1]";
		mes "Booboo 是一头情感非常敏感的奶牛，";
		mes "会通过歌声表达自己。你必须听她唱歌，判断她的心情，";
		mes "";
		mes "然后正确地给她梳毛。";
		next;
		mes "[Chapter 1]";
		mes "根据 Booboo 的心情，按照她歌声对应的次数梳毛。第二章会详细说明。";
		break;
	case 2:
		mes "[Chapter 2 Contents]";
		mes " ";
		mes "第1部分：如何回应 Booboo 的情绪";
		mes "第2部分：Booboo 的歌声";
		next;
			switch(select("第1部分:第2部分")) {
		case 1:
			mes "[Chapter 2, Part 1]";
			mes "Booboo 通常通过歌声表达五种情绪：喜悦、悲伤、愤怒、爱和中立的满足。";
			next;
			mes "[Chapter 2, Part 1]";
			mes "^800080她非常开心^000000！开心时，在挤奶前梳毛 3 次。^8000803 次^000000。";
			next;
			mes "[Chapter 2, Part 1]";
			mes "^800080她和平时一样^000000。感觉一般时梳毛^8000805 次^000000。";
			next;
			mes "[Chapter 2, Part 1]";
			mes "Booboo 悲伤时，要让她感到更多爱。怎么做？至少梳毛 10 次。";
			next;
			mes "[Chapter 2, Part 1]";
			mes "记住，Booboo 生气时完全不要碰她。对梳毛说‘不！’，明白吗？";
			next;
			mes "[Chapter 2, Part 1]";
			mes "Booboo 恋爱时只梳一次。看到爱心就知道她恋爱了，明白吗？";
			next;
			mes "[Chapter 2, Part 1]";
			mes "Booboo 感到中立满足时，梳 5 次。就这样~";
			break;
		case 2:
			mes "[Chapter 2, Part 2]";
			mes "Booboo 总会唱这首歌。她唱时记住这些声音……";
			next;
			mes "^ff0000Brr~ Brrbrr~ Boobooboo~^000000";
			mes "^0000ffBrrrrrr~ Booboo~ Boorrboo~^000000";
			mes "^ff0000Booruboorubrr~ Rrrrboo~^000000";
			mes "^0000ffRrrr~ Booboorrrr~ Boobooru~^000000";
			mes "^ff0000Boobooboo~ Rururu~ Booruboorub~^000000";
			mes "^0000ffBoo! B! Boo~^000000";
			next;
			mes "[Chapter 2, Part 2]";
			mes "尝试给 Booboo 挤奶时，她会稍微改变歌声。找出差异，然后哼出正确的词。";
			break;
		}
		break;
	case 3:
		mes "[Chapter 3]";
		mes "想给 Booboo 挤奶，必须先得到 Kurupe 的许可。还需要 3 瓶集中药水，放入 Booboo 的梳子。";

}

// Izlude Dungeon
//============================================================
izlu2dun,108,27,0	script	Sailor#2izlude	100,{
	mes "[水手]";
	mes "想";
	mes "回去吗？";
	next;
	if (select("是的，我累得要死。:不，我喜欢这里！") == 1) {
		if(checkre(0))
			warp "izlude",197,210;
		else
			warp "izlude",176,182;
		end;
	}
	close;
}

			mes "真的吗？";
			mes "太遗憾了。";
			mes "完成这些任务后，我还会给你相当不错的奖励。";
			close;
		}
		mes "[Instructor Ur]";
		mes "是的！";
		mes "好，我看看什么任务适合你。";
		next;
		mes "[Instructor Ur]";
		if (BaseLevel < 60) {
			mes "嗯……我知道你有这份心，但你现在有点太弱，还帮不上忙。";
			next;
			mes "[Instructor Ur]";
			mes "抱歉，至少要达到 Base 等级 60 才能帮助完成这些任务。";
		}
		else if (BaseLevel < 70) {
			mes "好吧，你的等级刚好达到这些任务的最低要求。";
			next;
			mes "[Instructor Ur]";
			mes "根据你的等级，我认为梦罗克地区适合你。";
			next;
			mes "[Instructor Ur]";
			mes "你知道梦罗克在哪里吗？";
			mes "你可以先去梦罗克，再经过灯塔到达那里。";
			next;
			mes "[Instructor Ur]";
			mes "梦罗克是一个拥有许多洞窟的海岸小城。";
			next;
			mes "[Instructor Ur]";
			mes "寻找北方的洞窟。那里有一个叫 Romeo 的人。";
			mes "你知道吗？就是“Romeo，Romeo，你在哪里啊”的 Romeo。";
			next;
			mes "[Instructor Ur]";
			mes "去那里从他手中接取任务。";
			mes "完成后活着回来！";
			para_2nd01 = 1;
			setquest 7214;// Advanced Training at Comodo
		}
		else if (BaseLevel < 80) {
			mes "让我看看……";
			mes "你的等级表明梦罗克对你来说太简单了。";
			mes "好，就是这里。";
			next;
			mes "[Instructor Ur]";
			mes "你知道古城在哪里吗？";
			mes "如果再次发生悲剧，卢恩·米德加尔特王国的首都可能会回到那里。";
			next;
			mes "[Instructor Ur]";
			mes "如果那里没有不死怪物肆虐，它就会成为卢恩·米德加尔特的新首都。";
			next;
			mes "[Instructor Ur]";
			mes "请活着回来。";
			para_2nd01 = 7;
			setquest 7219;// Advanced Training at Glast Heim
		}
		else if (BaseLevel < 90) {
			mes "啊，好吧，至于你……";
			mes "嗯，我该把你送到哪里？";
			next;
			mes "[Instructor Ur]";
			mes "那里有一座工业城市艾因布洛克。";
			mes "你知道吗？那是一座被烟雾笼罩的城市。";
			mes "想想看，那是一座相当阴郁的城市。";
			next;
			mes "[Instructor Ur]";
			mes "总之，去艾因布洛克，找到那里的派遣教官。他应该在主城南边的原野。";
			setquest 7223;// Advanced Training in Einbroch
			para_2nd01 = 12;
		}
		else
			callsub S_Quest89100;
	}
	else if (para_2nd01 == 5) {
		mes "哦，他在那里。";
		mes "Romeo 似乎刚从原野报告回来。";
		next;
		mes "[Instructor Ur]";
		mes "我们有奖励给你。";
		mes "我相信 Romeo 已经给了你一些物品，但我们还带来了更有用的东西。";
		next;
		mes "[Instructor Ur]";
		mes "你知道武器储藏室在哪里吗？";
		mes "从那扇大蓝门出去，走到走廊尽头。";
		mes "向铁匠询问，他会给你新装备。";
		next;
		mes "[Instructor Ur]";
		mes "第二阶段训练和任务从 70 级开始，到时再回来。";
		mes "别忘了，我会等你。";
		para_2nd01 = 6;
		para_2nd02 = 1;
		erasequest 7218;// Report to Instructor Ur
	}
	else if (para_2nd01 == 6) {
		if (BaseLevel > 69) {
			mes "嘿，朋友～";
			mes "怎么了？";
			next;
			switch( select( "我想开始训练。", "我只是来看看。" ) ) {
				mes "[Instructor Ur]";
			case 1:
				mes "嗯……你的状态不错！";
				mes "让我看看……";
				mes "哪个地点适合你……？";
				next;
				mes "[Instructor Ur]";
				if (BaseLevel < 80) {
					mes "啊，这个地方应该不错！";
					mes "你知道古城在哪里吗？";
					mes "如果不是那场可怕的事故，古城仍然会是";
					mes "卢恩·米德加尔特的首都，而不是普隆德拉。";
					next;
					mes "[Instructor Ur]";
					mes "总之，那座古老城堡现在充满了不死怪物。";
					mes "南边的圣堂附近尤其严重。";
					next;
					mes "[Instructor Ur]";
					mes "所有那些不死怪物都来自地下墓地";
					mes "嗯……我想你不必一直走到墓地深处……";
					next;
					mes "[Instructor Ur]";
					mes "到达圣堂后，你会看到我们的人驻守在入口前。";
					mes "按照他的指示帮助清理那片区域。";
					next;
					mes "[Instructor Ur]";
					mes "请活着回来。";
					para_2nd01 = 7;
					setquest 7219;// Advanced Training at Glast Heim
				}
				else if (BaseLevel < 90)
					callsub S_Quest7990;
				else
					callsub S_Quest89100;
				close;
			case 2:
				mes "真的吗？ At your level, I think you can easily complete the top class missions..";
				mes "改变主意后我会在这里等你。";
				close;
			}
		}
		else {
			mes "第二阶段训练任务从 70 级开始。";
			mes "到时见。";
			mes "你从储藏室拿到必要装备了吗？";
			mes "哈哈哈！";
		}
	}
	else if (para_2nd01 == 10) {
		mes "哦！你来了！";
		mes "我刚收到 Johan 的消息。";
		mes "我觉得他隐瞒了什么，但我想不出是什么。";
		next;
		mes "[Instructor Ur]";
		mes "总之，干得好。很高兴你没有受伤。";
		mes "铁匠 BK 说他会强化你的武器。";
		next;
		callsub S_Para2;
		mes "[Instructor Ur]";
		mes "你知道铁匠在哪里，对吧？";
		mes "从蓝门出去，走到走廊尽头。";
		mes "BK 是很棒的铁匠，他会让你的武器变得更强。";
		mes "你还在等什么？";
		para_2nd01 = 11;// Report to Instructor Ur
		erasequest 7222;
	}
	else if (para_2nd01 == 11) {
		if (BaseLevel > 79) {
			mes "啊，你一直在进步，"+ strcharinfo(0) +"?";
			mes "是什么风把你吹来了？";
			next;
			switch( select( "我来继续训练。", "我只是来看看。" ) ) {
				mes "[Instructor Ur]";
			case 1:
				mes "嗯……你的状态不错！";
				mes "让我看看……";
				next;
				mes "[Instructor Ur]";
				if (BaseLevel < 90)
					callsub S_Quest7990;
				else
					callsub S_Quest89100;
				close;
			case 2:
				mes "真的吗？ At your level, I think you can easily complete the top class missions..";
				mes "改变主意后我会在这里等你。";
				close;
			}
		}
		else {
			mes "3rd stage training starts at level 80.";
			mes "到时见。";
			mes "哦，如果你还没强化武器，就去找 BK。";
		}
	}
	else if (para_2nd01 == 15) {
		mes "啊，你来了。";
		mes "我刚收到 Kiren 的消息。";
		mes "他怎么样？被叫醒后没有发脾气吧？";
		mes "如果他发脾气，我也不会惊讶。";
		next;
		mes "[Instructor Ur]";
		mes "总之，干得好。很高兴你没有受伤。.";
		mes "铁匠 BK 说他会强化你的武器。";
		next;
		callsub S_Para2;
		mes "[Instructor Ur]";
		mes "你知道铁匠在哪里，对吧？";
		mes "从蓝门出去，走到走廊尽头。";
		mes "BK 是很棒的铁匠，他会让你的武器变得更强。";
		mes "你还在等什么？";
		erasequest 7228;// Report to Instructor Ur
		para_2nd01 = 16;
	}
	else if (para_2nd01 == 16) {
		if (BaseLevel > 89) {
			mes "很高兴看到你依然强壮！";
			mes "你今天怎么来了？";
			next;
			if (select( "我想继续训练。", "我只是来看看。" ) == 2) {
				mes "[Instructor Ur]";
				mes "真的吗？ At your level, I think you can easily complete the top class missions..";
				mes "改变主意后我会在这里等你。";
				close;
			}
			mes "[Instructor Ur]";
			callsub S_Quest89100;
		}
		else {
			mes "4th stage training starts at level 90.";
			mes "到时见。";
			mes "哦，如果你还没强化武器，就去找 BK。";
		}
	}
	else if (para_2nd01 == 20) {
		mes "恭喜你完成了所有训练阶段！";
		mes "花了不少时间，对吧？";
		mes "铁匠 BK 说他会强化你的武器。";
		next;
		callsub S_Para2;
		mes "[Instructor Ur]";
		mes "你知道铁匠在哪里，对吧？";
		mes "从蓝门出去，走到走廊尽头。";
		mes "BK 是很棒的铁匠，他会让你的武器变得更强。";
		next;
		mes "[Instructor Ur]";
		mes "干得好！";
		para_2nd01 = 30;
		erasequest 7232;//Report to Instructor Ur
	}
	else if (para_2nd01 == 29) {
		mes "恭喜你完成了所有训练阶段！";
		mes "远征怎么样？看起来一定很辛苦。";
		next;
		mes "[Instructor Ur]";
		mes "干得好……";
		mes "铁匠 BK 说他会强化你的武器。";
		next;
		callsub S_Para2;
		mes "[Instructor Ur]";
		mes "你知道铁匠在哪里，对吧？";
		mes "从蓝门出去，走到走廊尽头。";
		mes "BK 是很棒的铁匠，他会让你的武器变得更强。";
		next;
		mes "[Instructor Ur]";
		mes "顺便说，Michael 好像也有话要告诉你。";
		mes "去找他谈谈，他也在武器储藏室。";
		mes "去吧。";
		para_2nd01 = 30;
		erasequest 7237;// Report to Instructor Ur
	}
	else if (para_2nd01 == 30) {
		mes "干得好。";
		mes "哦，如果你还没强化武器，就去找 BK。";
		next;
		mes "[Instructor Ur]";
		mes "另外，Michael 有时需要帮助，如果你有时间就帮帮他。";
		mes "我相信他会为你的时间给予奖励。";
	}
	else if (para_2nd01 < 5)
		callsub S_Direction,"Comodo";
	else if (para_2nd01 < 10)
		callsub S_Direction,"Glast Heim Castle";
	else if (para_2nd01 < 15)
		callsub S_Direction,"Einbroch";
	else if (para_2nd01 < 20)
		callsub S_Direction,"Ice Dungeon";
	else if (para_2nd01 < 29) {
		mes "你必须走很远才能到达^4d4dff米德加尔特远征营地^000000！";
		mes "如果你想留在那里，就通过完成任务来赚取生活费。明白了吗？";
	}
	close;
S_Para2:
	if (para_2nd02 == 0) {
		mes "[Instructor Ur]";
		mes "我才意识到……这是你的第一个任务，对吧？";
		mes "你还没拿到基础装备，对吧？";
		mes "去武器储藏室领取。";
		mes "询问铁匠 Michael，他会给你装备。";
		para_2nd02 = 1;
		next;
	}
	return;
S_Direction:
	mes "那么，你去过^4d4dff"+ getarg(0) +"^000000 yet?";
	mes "我不是叫你去那里了吗？";
	mes "先去那里再回来找我。好吗？";
	return;

S_Quest7990:
	mes "嗯……不错……";
	mes "你一定已经逐渐掌握诀窍了……";
	mes "这次来做个简单任务吧";
	next;
	mes "[Instructor Ur]";
	mes "有一座工业城市叫艾因布洛克。";
	mes "你听说过吗？那是一座被污染笼罩的城市。";
	mes "去过那座城市后，你会更加珍惜这里的环境……";
	mes "我们都应该心怀感激。";
	next;
	mes "[Instructor Ur]";
	mes "总之，去艾因布洛克南边的原野，你会看到派遣教官。";
	mes "我相信他会先认出你。";
	mes "别忘了带上伊甸园集团徽章。";
	next;
	mes "[Instructor Ur]";
	mes "城市的污染令人难以忍受";
	mes "但周围的原野相对干净……";
	mes "这对你来说应该很简单。";
	para_2nd01 = 12;
	setquest 7223;// Advanced Training in Einbroch
	return;

S_Quest89100:
	if (BaseLevel < 100) {
		mes "嗯……";
		mes "嗯……";
		mes "你看起来很冷静。你觉得冰洞怎么样？";
		next;
		mes "[Instructor Ur]";
		mes "拉赫北边有一座充满冰的洞穴。";
		mes "在那里找到派遣教官。";
		para_2nd01 = 17;
		setquest 7229;// Advanced Training in Ice Dungeon
	}
	else {
		mes "哎呀，哎呀……";
		mes "我甚至不知道现在该把你送到哪里。";
		mes "我相信你已经熟悉这里的大多数地方";
		next;
		mes "[Instructor Ur]";
		mes "那么这次要不要把你送到更远的地方？";
		mes "这里有一名猫爪商团代理人。";
		mes "你看到那边的他了吗？";
		next;
		mes "[Instructor Ur]";
		mes "通过他，你可以很容易到达灰色沃土。";
		mes "那里有一个远征营地……";
		next;
		mes "[Instructor Ur]";
		mes "你只要找到那里的伊甸园集团代理人。";
		mes "告诉他是我派你去的，他会给你指示。";
		mes "你可以探索新世界";
		mes "就像度假一样，对吧？";
		next;
		mes "[Instructor Ur]";
		mes "哈哈哈！";
		mes ".. Maybe I'll go instead of sending you.";
		mes "总之，他们的名字好像是 Ma～什么……我不知道。";
		next;
		mes "[Instructor Ur]";
		mes "所以，再说一次，任务是找到米德加尔特远征营地的代理人。";
		mes "这不是你接过的最简单任务吗？";
		mes "回来时别忘了带我的礼物～！";
		para_2nd01 = 22;
		setquest 7233;// Advanced Training at Ash Vacuum
	}
	return;
}

//--60~69
// comodo,173,354,5	script	Dispatched Instructor#2nd02	1_M_JOBTESTER,{
comodo,173,354,5	script	Dispatched Instructor#02	1_M_JOBTESTER,{
	mes "[Romeo]";
	if (para_2nd01 < 1) {
		mes "你好吗？";
		mes "梦罗克有全世界最好的天气。";
		mes "即使在冬天，梦罗克的天气也很好。";
		next;
		mes "[Romeo]";
		mes "你知道为什么吗？";
		mes "梦罗克被海洋和洞穴环绕。";
		mes "季节变化不会影响这里的温度。";
		next;
		mes "[Romeo]";
		mes "在这里放松吧。";
		mes "这里是休闲放松的地方。";
	}
	else if (para_2nd01 == 1) {
		mes "你好吗？";
		mes "你是 Instructor Ur 派来这里的，对吧？";
		mes "你是为了任务来的吗？";
		next;
		mes "[Romeo]";
		mes "我不知道这里是否适合你";
		mes "不如试试看。";
		next;
		mes "[Romeo]";
		mes "这座洞穴里的许多怪物都是由石头形成的。";
		mes "只要保持警惕，它们应该不会太危险……";
		next;
		mes "[Romeo]";
		mes "但大多数会进行远程攻击……";
		mes "而且有时会有非常强大的怪物游荡。";
		next;
		mes "[Romeo]";
		mes "嗯……这就是你训练的原因，对吧？";
		mes "我们试着挑战一只大型怪物吧";
		next;
		mes "[Romeo]";
		mes "'They are called 'Stalactic Golem'.";
		mes "试着击败几只。";
		mes "不是太难，对吧？";
		para_2nd01 = 2;
		erasequest 7214;
		setquest 7215;
	}
	else if (para_2nd01 == 2) {
		if (checkquest(7215,HUNTING) == 2) {
			mes "那么，你现在是多么优秀的探险者了？";
			mes "你以前战斗过这些怪物，所以应该能清理这座洞穴。";
			next;
			mes "[Romeo]";
			mes "正如我之前说的，因为梦罗克是一座洞穴中的城市……";
			mes "通往外界主要通过东部入口，但……";
			next;
			mes "[Romeo]";
			mes "我们试着从北边出去。";
			mes "那里应该有可以狩猎的目标。";
			next;
			mes "[Romeo]";
			mes "与其直接走出去，";
			mes "不如在路上杀死约 10 只石头波利。";
			next;
			mes "[Romeo]";
			mes "这样从北边来的旅客就能安全通过。";
			mes "记住，10 只石头波利。然后到洞穴北部的另一侧";
			next;
			mes "[Romeo]";
			mes "我会在外面等你。";
			para_2nd01 = 3;
			getexp 10000,10000;
			erasequest 7215;// Stalactic Golem Hunt
			setquest 7216;// More Golem Hunting
		}
		else {
			mes "作为这座洞穴难度的测试";
			mes "去击败 3 只石头波利。";
			mes "也要小心其他怪物。";
			next;
			mes "[Romeo]";
			mes "如果你累了，我来帮你恢复。";
			npcskill "AL_HEAL",10,99,60;
			percentheal 0,100;
		}
	}
	else if (para_2nd01 == 3) {
		mes "你必须穿过这座洞穴到达外面。";
		mes "别忘了击败路上遇到的石头波利。";
	}
	else {
		mes "我总是给来这里的学员同样的测试……";
		mes "我从没见过有人像你一样完美地通过。";
	}
	close;
}

um_fild01,34,280,5	script	Instructor Romeo#2nd02	1_M_JOBTESTER,{
	mes "[Romeo]";
	if (para_2nd01 < 2) {
		mes "如果你是伊甸园集团派来训练的，就在城镇等我。";
		mes "我现在正在等另一名学员。";
	}
	else if (para_2nd01 == 2) {
		mes "不，不……不是这里。";
		mes "我现在正在等另一名学员。";
		mes "回去。";
	}
	else if (para_2nd01 == 3) {
		if (checkquest(7216,HUNTING) == 2) {
			mes "啊，我看你没有迷路。";
			mes "你击败那些石头波利的能力超出我的预期。";
			mes "这说明你进步了很多。";
			next;
			mes "[Romeo]";
			mes "现在看看周围";
			mes "我们现在身处茂密的森林。";
			mes "这里有树精和伍坦族……";
			next;
			mes "[Romeo]";
			mes "下一个任务是清理这片区域的怪物。";

amatsu,233,234,3	script	Momotoro Publisher#rus42	4_F_JPN,{
	if ((MaxWeight-Weight) < 3500) {
		mes "[Momotoro Publisher]";
	mes "你的包里到底装了什么？你在为某件事训练吗？";
		close;
	}
	if (rhea_rus_main < 26) {
		mes "[Momotoro Publisher]";
	mes "你订购了书吗？";
		next;
		mes "[Momotoro Publisher]";
	mes "有人订了书却没有来取。";
		close;
	} else if (rhea_rus_main == 26) {
		mes "[Momotoro Publisher]";
	mes "你订购了书吗？";
		next;
		mes "[Momotoro Publisher]";
	mes "有人订了书却没有来取。";
		next;
		mes "["+ strcharinfo(0) +"]";
	mes "啊，我……一本魔法书……";
		next;
		mes "[Momotoro Publisher]";
	mes "什么？啊，你是来取书的吗？请告诉我你的名字。";
		next;
		input .@input$;
		if (.@input$ == "Baba Yaga") {
			mes "["+ strcharinfo(0) +"]";
			mes "我是 "+ .@input$ +"。";
			next;
			mes "[Momotoro Publisher]";
			mes ""+ .@input$ +"……啊，就是这里。";
			next;

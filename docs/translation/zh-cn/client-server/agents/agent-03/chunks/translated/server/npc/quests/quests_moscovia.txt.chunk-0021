mosk_dun02,65,232,0	script	Noisy Coffin#rus36	4_NFCOFFIN,{
	if (rhea_rus_main < 19) {
		mes "[Noisy Coffin]";
		mes "活着不是很好吗？能够活着不是很好吗？";
		next;
		mes "[Noisy Coffin]";
		mes "你不想和我交换生命吗？和我交换，交换！";
		if (rhea_rus_main < 16) close;
		next;
		mes "["+ strcharinfo(0) +"]";
		mes "呃，那是个吵闹的棺材。";
		next;
		mes "[Noisy Coffin]";
		mes "我活着！我活着！你和我有什么不同？你为什么还活着？你为什么没死？我为什么死了？";
		next;
		mes "["+ strcharinfo(0) +"]";
	mes "……我该怎么让他安静……";
		next;
		while (.@break_while == 0) {
			switch(select("祈祷:唱赞美诗:给他倒圣水:踢他")) {
			case 1:
				mes "["+ strcharinfo(0) +"]";
				mes "...I'll pray.";
				next;
				mes "["+ strcharinfo(0) +"]";
				mes "天地与风属于上帝，邪恶无处容身。";
				specialeffect EF_BLESSING;
				next;
				mes "[Noisy Coffin]";
				if (rhea_rus_main == 17) {
					mes "嘶，嘶——！嘶——！";
					rhea_rus_main = 18;
				} else {
					mes "那是什么？为什么这样做？好玩吗？";
					next;
					mes "["+ strcharinfo(0) +"]";
					mes "......................................";
					.@break_while = 1;
				}
				break;
			case 2:
				mes "["+ strcharinfo(0) +"]";
				mes "嗯，嗯！我要唱赞美诗。第一句是‘圣洁的上帝抵御邪恶’！！";
				next;
				mes "["+ strcharinfo(0) +"]";
			mes "- 贪婪者、堕落者 -";
			mes "- 所有令人憎恶的邪恶 -";
			mes "- 都将被赶出这片土地 -";
				specialeffect EF_GLORIA;
				next;
				mes "[Noisy Coffin]";
				if (rhea_rus_main == 18) {
					mes "嘶，嘶——！嘶——！";
					rhea_rus_main = 19;
				} else {
					mes "变态！太变态了！！赶走他！！那是什么歌？！好玩吗？！";
					next;
					mes "["+ strcharinfo(0) +"]";
					mes "......................................";
					.@break_while = 1;
				}
				break;
			case 3:
				if (countitem(523)) {
					mes "["+ strcharinfo(0) +"]";
					mes "你再不闭嘴，我就把圣水倒在你身上！";
					next;
					mes "- 你打开圣水瓶，小心地将圣水洒在棺材周围！！-";
					specialeffect EF_SPHERE;
					next;
					mes "[Noisy Coffin]";
					if (rhea_rus_main == 16) {
					mes "嘶，嘶——！嘶——！";
						delitem 523,1;
						rhea_rus_main = 17;
					} else {
						mes "啊，好冷！不，是凉快！好玩吗？好玩吗？！";
						delitem 523,1;
						next;
						mes "["+ strcharinfo(0) +"]";
						mes "......................................";
						.@break_while = 1;
					}
				} else {
					mes "["+ strcharinfo(0) +"]";
					mes "对了，圣水在哪里？";
					next;
					mes "["+ strcharinfo(0) +"]";
					mes "……我没有……";
					next;
					mes "["+ strcharinfo(0) +"]";
					mes "......................................";
					.@break_while = 1;
				}
				break;
			case 4:
				mes "["+ strcharinfo(0) +"]";
				mes "……如果你不闭嘴……";
				mes "……我就踢你！！";
				next;
				mes "- 你闭上眼睛深吸一口气，用神的力量踢向棺材！！-";
				next;
				mes "[Noisy Coffin]";
				if (rhea_rus_main == 19) {
					mes "嘶——！嘶——！！我害怕！住手！！";
					specialeffect EF_HOLYHIT;
					rhea_rus_main = 20;
				} else {
					mes "砰！砰！我喜欢噪音！再多一点，再多一点，再多一点！";
					next;
					mes "["+ strcharinfo(0) +"]";
					mes "......................................";
				}
				.@break_while = 1;
				break;
			}
			next;
		}
		if (rhea_rus_main < 20) {
			mes "["+ strcharinfo(0) +"]";
			mes "... Not effective...";
			rhea_rus_main = 16;
			close;
		}
		mes "["+ strcharinfo(0) +"]";
		mes "……如果你再发出声音，就会看到超乎想象的东西……";
		next;
		mes "[Noisy Coffin]";
		mes "................................";
		emotion ET_THINK;
		next;
		mes "["+ strcharinfo(0) +"]";
		mes "呼，工作完成了。我们回 Baba Yaga 那里吧。";
		rhea_rus_main = 42;
		// changequest 8161,8162;
		close;
	} else if (rhea_rus_main == 20) {
		mes "["+ strcharinfo(0) +"]";
		mes "……如果你再发出声音，就会看到超乎想象的东西……";
		next;
		mes "[Noisy Coffin]";
		mes "................................";
		emotion ET_THINK;
		next;
		mes "["+ strcharinfo(0) +"]";
		mes "呼，工作完成了。我们回 Baba Yaga 那里吧。";
		rhea_rus_main = 42;
		close;
	} else if (rhea_rus_main == 42) {
		mes "["+ strcharinfo(0) +"]";
		mes "……如果你再发出声音，就会看到超乎想象的东西……";
		next;
		mes "[Noisy Coffin]";
		mes "................................";
		emotion ET_THINK;
		next;
		mes "["+ strcharinfo(0) +"]";
		mes "呼，工作完成了。我们回 Baba Yaga 那里吧。";
		close;
	}
	mes "[Noisy Coffin]";
	mes ".............................";
	close;
}

treasure01,165,58,0	script	Old Treasure Box#rus37	HIDDEN_NPC,{
	if ((MaxWeight-Weight) < 3500) {
		mes "你携带的物品太多了！减轻负重后再试。";
		close;
	}
	if (rhea_rus_main > 20 && rhea_rus_main < 25) {
		mes "- 它锁着。-";
		close;
	} else if (rhea_rus_main == 25) {
		mes "- 锁着的箱子周围刻着一个头发是蛇的女人。-";
		next;
		mes "["+ strcharinfo(0) +"]";
		mes "这个能用吗……";
		next;
		select("把钥匙插入锁孔");
		mes "- 你把钥匙插入锁孔后，女人的眼睛移动并看向你。-";
		next;
		mes "- 她的眼睛是由宝石制成的！！-";
		if (countitem(747)) {
			next;
			mes "["+ strcharinfo(0) +"]";
			mes "啊啊啊？这是什么！！";
			specialeffect EF_FLASHER;
			next;
		} else {
			sc_start SC_BLIND,60000,0;
			donpcevent "Old Treasure Box#rus37::OnCall";
			close2;
			donpcevent "Old Treasure Box#rus37::OnDisable";
			end;
		}
		mes "- 你挥动手臂遮住眼睛，包里的镜子意外反射了她眼中的光！！-";
		specialeffect EF_FLASHER;
		next;
		mes "- 反射的光照向女人的图案，箱子冒出烟雾并打开了！！-";
		next;
		mes "- ^0000ff 你找到芭芭雅嘎的勺子了！！^000000 -";
		// changequest 8167,8168;
		rhea_rus_main = 43;
		getitem 7880,1;
		close;
	} else if (rhea_rus_main == 43) {
		mes "- 你找到银勺子的宝箱。-";
		close;
	}
	end;

OnCall:
	initnpctimer;
	monster "treasure01",164,58,"Medusa",1148,1,"Old Treasure Box#rus37::OnMyMobDead";
	monster "treasure01",157,59,"Obeaune",1044,1,"Old Treasure Box#rus37::OnMyMobDead";
	monster "treasure01",164,54,"Obeaune",1044,1,"Old Treasure Box#rus37::OnMyMobDead";
	monster "treasure01",163,63,"Obeaune",1044,1,"Old Treasure Box#rus37::OnMyMobDead";
	monster "treasure01",168,59,"Obeaune",1044,1,"Old Treasure Box#rus37::OnMyMobDead";
	end;

OnDisable:
	initnpctimer;
	disablenpc "Old Treasure Box#rus37";
	end;

OnTimer180000:
	stopnpctimer;
	killmonster "treasure01","Old Treasure Box#rus37::OnMyMobDead";

OnMyMobDead:
	enablenpc "Old Treasure Box#rus37";
	end;
}


// Help Chef Nyas :: mal_day_qook
//============================================================
mal_in02,187,58,3	script	Chef Nyas	548,{
	if (checkweight(1201,1) == 0) {
		mes "- You have too many items so you can't continue the quest. -";
		close;
	}
	if (BaseLevel < 60) {
		mes "[Chef Nyas]";
		mes "怎么回事，小子？";
		mes "我不想和你说话。离我远点！";
		next;
		mes "我被一只难相处的猫无视了。";
		mes "变强后也许就不会被无视了……";
		close;
	}
	if (mal_qook < 2) {
		mes "[Chef Nyas]";
		mes "我是整个舰队独一无二的厨师。";
		mes "你想从我这里得到什么？";
		next;
		mes "[Chef Nyas]";
		mes "虽然我没有空闲，平时也乐意端上一盘汤，但现在！";
		mes "因为一个笨蛋的疏忽，食材被虫子侵扰了！";
		next;
		mes "[Chef Nyas]";
		mes "所以，等我的怒火像平静海面一样消退后再回来！";
		mes "顺便说，那个笨蛋去哪儿了！";
		close;
	} else if (mal_qook == 2) {
		mes "[Chef Nyas]";
		mes "我是整个舰队独一无二的厨师。";
		mes "你想从我这里得到什么？";
		next;
			switch(select("出示猫船饼干。:谈谈克里昂扬的故事。")) {
		case 1:
			mes "[Chef Nyas]";
			mes "嗯？这是猫船饼干吗？";
			mes "特别是，我能从这块饼干中感受到时间的流动。";
			mes "对了，你怎么会有这个？";
			next;
			mes "他讲述发现猫船饼干的地点，并";
			mes "解释Cleanyang的故事。";
			next;
			break;
		case 2:
			mes "[Chef Nyas]";
			mes "为什么是那个笨蛋？";
			mes "你想在平静海面制造雷暴吗？！";
			next;
			mes "安抚愤怒的厨师";
			mes "解释Cleanyang的误会，并讲述猫船饼干的完整故事。";
			next;
			break;
		}
		mes "[Chef Nyas]";
		mes "所以这一切是因为猫船饼干？";
		mes "对，这是在说那件事吗？";
		next;
		select("你理解得很快。");
		mes "[Chef Nyas]";
		mes "……他真是个混蛋！";
		mes "另外，什么？船长房间里又找到一块？！";
		next;
		mes "[Chef Nyas]";
		mes "Thomas……";
		mes "他本应领导水手，却搞错了吗？";
		mes "呜嘟嘟。";
		next;
		mes "[Chef Nyas]";
		mes "这块猫船饼干！它总是在漫长航行中帮助我们摆脱饥饿，令人感激的食物！";
		mes "无论味道如何，它总能在生死关头救我们一命！";
		next;
		mes "[Chef Nyas]";
		mes "即使一个月、两个月，甚至1000天都无法生火！";
		mes "这是在大海上生存的祝福食物！";
		next;
		mes "[Chef Nyas]";
		mes "制作猫船饼干让多少猫厨师吃尽苦头！";
		mes "因为定居岛上，军纪已经松懈了！你们已经忘了危险的处境吗？！";
		next;
		mes "厨师暴怒且非常不满。";
		mes "他咕哝着，磨牙发出威胁的声音。";
		mes "等他冷静后再回来。";
		set mal_qook,3;
		erasequest 7264;
		setquest 7265;
		close;
	} else if (mal_qook == 3) {
		if (!rand(3)) {
			mes "[Chef Nyas]";
			mes "你来了？我做了个糟糕的决定。";
			mes "你外出时，我做了一个重要决定。";
			next;
			mes "[Chef Nyas]";
			mes "定居岛上后，充足食物让大家的想法变得堕落。";
			mes "所以我会改变菜单，每天一餐提供猫船饼干！";
			next;
			mes "[Chef Nyas]";
			mes "制作猫船饼干需要那种材料。";
			mes "这座岛上没有小麦，所以需要你的帮助。";
			next;
			mes "[Chef Nyas]";
			mes "只要能磨粉和揉面，什么都可以。";
			mes "请带来^4d4dff10个谷物^000000和^4d4dff1份普通酱汁^000000。";
			mes "用海水代替盐……";
			next;
			mes "[Chef Nyas]";
			mes "在陆地上容易得到吗？";
			mes "剩下的材料我会自己弄。";
			next;
			mes "[Chef Nyas]";
			mes "我要纠正他们对罐头食物的疯狂口味。";
			mes "他像一片平静却藏着可怕雷暴的海一样走来";
			mes "我要让他感受海神的怒火！喵呜~~！！";
			next;
			mes "厨师的神情非常严肃。";
			mes "我先把结果告诉Cleanyang。";
			set mal_qook,4;
			erasequest 7265;
			setquest 7266;
			close;
		}
		mes "厨师还在努力平息怒火。";
		mes "也许还需要一点时间。";
		close;
	} else if (mal_qook == 4) {
		if (countitem(577) >= 10 && countitem(7454) > 0) {
			mes "[Chef Nyas]";
			mes "终于到了。哇，这片土地真不一样。";
			mes "这些足够处理了。";
			next;
			mes "[Chef Nyas]";
			mes "如果可以，我希望每天都得到这些食物。";
			mes "如果你不介意，明天再来吧。";
			delitem 577,10; //Grain
			delitem 7454,1; //Plain_Sauce
			set mal_qook,5;
			erasequest 7266;
			setquest 7276;
			close;
		}
		mes "[Chef Nyas]";
		mes "制作猫船饼干需要那种材料。";
		mes "这座岛上没有小麦，所以需要你的帮助。";
		next;
		mes "[Chef Nyas]";
		mes "只要能磨粉和揉面，什么都可以。";
		mes "请带来^4d4dff10个谷物^000000和^4d4dff1份普通酱汁^000000。";
		mes "用海水代替盐…….";
		close;
	}
	mes "[Chef Nyas]";
	mes "你来了。";
	mes "现在不是用餐时间……你为什么来这里？";
	next;
	switch(select("今天的工作是什么？:送餐:只是觉得无聊……")) {
	case 1:
		if (checkquest(7276,PLAYTIME) == 0) {
			mes "[Chef Nyas]";
			mes "现在，猫船饼干正在这个烤箱里烘烤。";
			mes "这些都是要交付的食物。";
			next;
			mes "[Chef Nyas]";
			mes "安静的波浪带着些许咸香气味。";
			mes "海洋的食物即将到来，让水手的心怦怦直跳。";
			next;
			mes "[Chef Nyas]";
			mes "今天制作猫船饼干的材料够了。";
			mes "下次再来点单吧。";

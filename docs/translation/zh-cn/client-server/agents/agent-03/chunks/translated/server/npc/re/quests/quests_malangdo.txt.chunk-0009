			mes "沙堆隆起得像坟墓，里面应该有东西。";
			mes "据说猫有便后用沙子掩埋的习惯……";
			next;
			switch(select("避开这个脏地方。:可恶！")) {
			case 1:
				mes "[" + strcharinfo(0) + "]";
				mes "没错！";
				mes "也许是猫的坟墓……别碰它！";
				mes "避开，避开~";
				break;
			case 2:
				mes "闭上眼，开始挖那堆沙子！";
				mes "于是有东西迅速从那里出来并消失了。";
				mes "然后……";
				next;
				mes "从黑影刚刚经过、有人最近藏过的地方。";
				mes "发现一些猫船饼干碎片。";
				setquest .@quest;
				if (!rand(3)) {
					emotion ET_HUK;
					getmapxy(.@map$,.@x,.@y,BL_NPC);
					monster .@map$,.@x,.@y,"Quick Dark Shadow",2209,1;
				} else
					getitem 11536,1; //Cat_Hard_Biscuit
				close;
			}
		}
		mes "我们已经收集了埋藏的猫船饼干。";
		close;
	}
	mes "- Looks so strange. -";
	mes "- That's it... -";
	close;
}

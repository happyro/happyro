rgsr_in,131,187,5	script	Ore Researcher#rg02	MD_ED_M_SCIENCE,{
	mes "[Grid]";
	mes "Come on.";
	mes "这是低预算实验室，所以一直这样。";
	mes "我和助手负责精炼实验室使用的宝石。需要收费。";
	next;
	switch( select( "查看兑换清单", "你们兑换什么？", "退出" ) ) {
	case 1:
		mes "[Grid]";
		mes "让我看看……";
		mes "现在有这些项目。";
		next;
		switch( select( "宝石精炼", "高级矿石兑换", "购买额外矿石", "取消" ) ) {
		case 1:
			mes "[Grid]";
			mes "宝石精炼。";
			close2;
			callshop("barter_rgsr_in_1");
			end;
		case 2:
			mes "[Grid]";
			mes "高级矿石兑换。";
			close2;
			callshop("barter_rgsr_in_2");
			end;
		case 3:
			mes "[Grid]";
			mes "矿石不够？那么我正在特别收集一种东西……";
			mes "你有暗影分解器吗？";
			close2;
			callshop("barter_rgsr_in_3");
			end;
		case 4:
			mes "[Grid]";
			mes "需要什么就再来。";
			close;
		}
		end;
	case 2:
		mes "[Grid]";
		mes "研究显示材料非常稀有。团队雇佣了冒险者，但带来的数量仍远远不够。";
		mes "因此冒险者带材料来时，我们会提供相应研究价值。";
		next;
		mes "[Grid]";
		mes "幸运的是，我们负责研究，来找我们的冒险者提供材料并使用我们的技术。";
		mes "想改造什么，只需带来指定材料。";
		next;
		mes "[Grid]";
		mes "你是冒险者，知道这意味着什么吧？";
		close;
	case 3:
		mes "[Grid]";
		mes "需要什么就再来。";
		close;
	}
}

rgsr_in,137,178,3	script	Accessories Researcher#rg02	MD_ED_M_SCIENCE,{
	mes "[Champ]";
	mes "终于有冒险者来确认我的研究了，是你吗？";
	mes "遗憾的是，我们团队还没准备好走出去。";
	next;
	mes "[Champ]";
	mes "研究仍未完成。";
	mes "得到队长许可后下次再见。";
	close;

OnInit:
	setunittitle( getnpcid(0), "Team Zerter");
	end;
}

rgsr_in,136,171,5	script	Special Equipment Researcher#rg02	MD_ED_M_SCIENCE,{
	mes "[Stack]";
	mes "想看看Licht团队的成果吗？";
	mes "我们为这个实验室感到自豪。";
	mes "你想改造哪一件？";
	mes "可改造物品位于<TIPBOX>[列表]<INFO>9166</INFO></TIPBOX>。";
	next;
	switch( select( "特殊铠甲", "特殊武器", "退出" ) ) {
	case 1:
		mes "[Stack]";
		mes "^0000FF特殊铠甲^000000有低级、中级和高级改造。";
		mes "不可精炼铠甲只能进行高级改造。";
		next;
		switch( select( "低级改造", "中级改造", "高级改造", "退出" ) ) {
		case 1:
			mes "[Stack]";
			mes "铠甲低级改造？好。";
			mes "^FF0000精炼等级降低5^000000，但消耗材料较少。";
			mes "改造要求装备精炼等级+9或以上。";
			close2;
			item_reform("C_Armor_Reform_1");
			end;
		case 2:
			mes "[Stack]";
			mes "铠甲中级改造？好。";
			mes "^FF0000精炼等级降低1^000000，但消耗更多材料。";
			mes "改造要求装备精炼等级+9或以上。";
			close2;
			item_reform("C_Armor_Reform_2");
			end;
		case 3:
			mes "[Stack]";
			mes "铠甲高级改造？好。";
			mes "^FF0000精炼等级提高1^000000，但消耗更多材料。";
			mes "改造要求装备精炼等级+9或以上。";
			mes "^FF0000不可精炼装备^000000也能进行高级改造，但精炼等级不会提高。";
			close2;
			item_reform("C_Armor_Reform_3");
			end;
		case 4:
			mes "[Stack]";
			mes "已经要走了吗？";
			mes "你还需要看看我们更多出色成果！";
			close;
		}
	case 2:
		mes "[Stack]";
		mes "^0000FF特殊武器^000000有低级、中级和高级改造。";
		next;
		switch( select( "低级改造", "中级改造", "高级改造", "退出" ) ) {
		case 1:
			mes "[Stack]";
			mes "武器低级改造？好。";
			mes "^FF0000精炼等级降低5^000000，但消耗材料较少。";
			mes "改造要求装备精炼等级+9或以上。";
			close2;
			item_reform("C_Weapon_Reform_1");
			end;
		case 2:
			mes "[Stack]";
			mes "武器中级改造？好。";
			mes "^FF0000精炼等级降低1^000000，但消耗更多材料。";
			mes "改造要求装备精炼等级+9或以上。";
			close2;
			item_reform("C_Weapon_Reform_2");
			end;
		case 3:
			mes "[Stack]";
			mes "武器高级改造？好。";
			mes "^FF0000精炼等级提高1^000000，但消耗更多材料。";
			mes "改造要求装备精炼等级+9或以上。";
			close2;
			item_reform("C_Weapon_Reform_3");
			end;
		case 4:
			mes "[Stack]";
			mes "已经要走了吗？";
			mes "你还需要看看我们更多出色成果！";
			close;
		}
		end;
	case 3:
		mes "[Stack]";
		mes "已经要走了吗？";
		mes "你还需要看看我们更多出色成果！";
		close;
	}
	end;

OnInit:
	setunittitle( getnpcid(0), "Team Licht");
	end;
}

rgsr_in,128,174,5	script	Director#rg02	1_M_LIBRARYMASTER,{
	mes "[Director]";
	mes "……来吧。";
	mes "你来时可能听过说明，但简单介绍一下，这里还有很长的路。我们正在把许多武器、铠甲、饰品等改造成不同的东西。";
	next;
	mes "[Director]";
	mes "转换装备必须降低精炼等级，但这是获得更强力量的代价。";
	next;
	mes "[Director]";
	mes "研究仍在继续，不知道何时何地会突然完成并提供给冒险者。";
	mes "就是这样……数据收集完毕后总会有办法。";
	next;
	mes "[Director]";
	mes "这一次，Licht团队做到了。";
	mes "如果感兴趣，看看完成了哪些研究。";
	next;
	mes "[Director]";
	mes "大家都喜欢安静，所以别大声说话。";
	close;
}

rgsr_in,122,160,5	script	Exit Guard#rg01	4_M_LGTGUARD,{
	mes "[Exit guard]";
	mes "结束了吗？";
	mes "要^FF0000返回莱赫伦^000000吗？";
	next;
	if (select( "返回。", "还有工作。" ) == 2) {
		mes "[Exit guard]";
		mes "完成后随时告诉我们。";
		close;
	}
	mes "[Exit guard]";
	mes "我带你回去。";
	close2;
	warp "lighthalzen",101,156;
	end;
}

rgsr_in,129,160,3	script	Exit Guard#rg02	4_M_LGTGUARD,{
	mes "[Exit guard]";
	mes "Are you done?";
	mes "要^FF0000返回道具商城^000000吗？";
	next;
	if (select( "返回。", "还有工作。" ) == 2) {
		mes "[Exit guard]";
		mes "完成后随时告诉我们。";
		close;
	}
	mes "[Exit guard]";
	mes "我带你回去。";
	close2;
	warp "itemmall",16,47;
	end;
}

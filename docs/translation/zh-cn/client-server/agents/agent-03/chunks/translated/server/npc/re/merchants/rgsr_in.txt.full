itemmall,14,50,3	script	Equipment Reform PR Agent#it01	4_F_ZONDAGIRL,{
	mes "[Equipment Reform PR Agent]";
	mes "你好，冒险者！";
	mes "你对现在的装备不满意吗？";
	mes "不想尝试不同于普通方法的新改造吗？";
	mes "加入雷根贝勒研究所吧！";
	next;
	switch( select( "走吧。", "听听说明。", "退出。" ) ) {
	case 1:
		mes "[Equipment Reform PR Agent]";
		mes "很好！研究所其他设施属于机密，无法进入，所以我们会引导你们这些外来者走特殊通道！";
		close2;
		warp "rgsr_in",125,170;
		end;
	case 2:
		mes "[Equipment Reform PR Agent]";
		mes "雷根贝勒研究所正在世界各地研究武器、铠甲、饰品及其他装备的改造……";
		mes "我们仍在收集数据、研究改造，因此需要大量冒险者装备来推进研究。";
		next;
		mes "[Equipment Reform PR Agent]";
		mes "研究仍在进行，完成后会追加许多新装备，敬请期待！";
		close;
	case 3:
		mes "[Equipment Reform PR Agent]";
		mes "以后感兴趣的话再回来！";
		close;
	}
}
lighthalzen,99,156,3	duplicate(Equipment Reform PR Agent#it01)	Equipment Reform PR Agent#lh01	4_F_ZONDAGIRL

rgsr_in,112,167,7	script	Enchant Researcher#rg02-1	MD_ED_M_SCIENCE,{
	mes "[Torus]";
	mes "嗯？除了队长，你还想见我们队里的其他人吗？";
	mes "那就是我～";
	mes "我负责附魔。";
	mes "让我看看你带了什么？";
	next;
	if (select( "OS武器附魔", "退出" ) == 2) {
		mes "[Torus]";
		mes "需要时再回来。";
		mes "我们也需要研究数据。";
		close;
	}
	mes "[Torus]";
	mes "在哪里……";
	close2;
	item_enchant(33);
	end;

OnInit:
	setunittitle( getnpcid(0), "Team Atnad" );
	end;
}

rgsr_in,115,169,5	script	Weapon Researcher#rg02	MD_ED_M_SCIENCE,{
	mes "[Frasa]";
	mes "让我看看……你是客人。";
	mes "我喜欢知道自己想要什么的人。";
	mes "可改造物品也可在<TIPBOX>[列表]<INFO>9163</INFO></TIPBOX>中查看。";
	mes "我会尽量回答你的问题。";
	next;
	switch( select( "Thanos武器", "OS武器", "退出" ) ) {
	case 1:
		mes "[Frasa]";
		mes "^0000FFThanos武器^000000改造分为低级和中级。";
		next;
		switch( select( "低级改造", "中级改造", "退出" ) ) {
		case 1:
			mes "[Frasa]";
			mes "Thanos武器低级改造。";
			mes "^FF0000精炼等级降低5^000000，但消耗材料较少。";
			mes "改造要求武器精炼等级+9或以上。";
			close2;
			item_reform("Thanos_W_Reform_1");
			end;
		case 2:
			mes "[Frasa]";
			mes "Thanos武器中级改造。";
			mes "^FF0000精炼等级降低1^000000，但消耗更多材料。";
			mes "改造要求武器精炼等级+9或以上。";
			close2;
			item_reform("Thanos_W_Reform_2");
			end;
		case 3:
			mes "[Frasa]";
			mes "需要改造时再回来。";
			mes "只要帮助我们的研究，随时欢迎回来。";
			close;
		}
		end;
	case 2:
		mes "[Frasa]";
		mes "^0000FFOS武器^000000……";
		mes "改造要求精炼等级+7或以上。";
		mes "精炼等级不会降低。";
		mes "你带来材料了吗？";
		next;
		if (select( "转换", "退出" ) == 2) {
			mes "[Frasa]";
			mes "需要改造时再回来。";
			mes "只要帮助我们的研究，随时欢迎回来。";
			close;
		}
		mes "[Frasa]";
		mes "让我看看你带了什么。";
		close2;
		item_reform("OS_Weapon_Reform");
		end;
	case 3:
		mes "[Frasa]";
	mes "如果你需要改造，请再回来。";
		mes "只要帮助我们的研究，随时欢迎回来。";
		close;
	}
	end;

OnInit:
	setunittitle( getnpcid(0), "Team Atnad");
	end;
}

rgsr_in,115,180,5	script	Armor Researcher#rg02	MD_ED_M_SCIENCE,{
	mes "[Algebra]";
	mes "啊，我们已经走到这一步，但团队研究仍缺少实验。";
	mes "下次我会改进一些并取得队长许可，再继续。";
	mes "Okay?";
	npctalk "皱眉。", "", bc_self;
	close;

OnInit:
	setunittitle( getnpcid(0), "Team Fresa" );
	end;
}


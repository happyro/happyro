			setarray .@Items[0],2733,500,2720,500,2721,500,2722,500,2723,500,2724,500,2725,500;
			set .@menu1$,"Gunslinger:Swordman/Taekwon Master:Thief:Acolyte:Magician:Archer:Merchant";
			break;
		case 4:
			mes "[艾伦德克]";
			mes "你选择了 ^3131FF消耗品^000000。";
			mes "以下消耗品可用战场徽章兑换：";
			next;
			setarray .@Items[0],12269,10,12270,10,12271,5,12272,10,12273,10;
			break;
		}
		break;
	case 2:
		mes "[艾伦德克]";
		mes "物品很多，请仔细查看后再购买。";
		close2;
		readbook 11010,1;
		end;
	}
	set .@menu$,"";
	if (.@menu1$ != "") set .@menu$, .@menu1$;
	else for(set .@i,0; .@i<getarraysize(.@Items); set .@i,.@i+2)
		set .@menu$, .@menu$+getitemname(.@Items[.@i])+":";
	set .@i, (select(.@menu$)-1)*2;
	mes "[艾伦德克]";
	mes "你选择了 ^3131FF"+getitemname(.@Items[.@i])+"^000000。";
	switch(.@Items[.@i]) {
		case 2720: mes "此物品仅限剑士和跆拳宗师职业。"; break;
		case 2721: mes "此物品仅限盗贼职业。"; break;
		case 2722: mes "此物品仅限服事职业。"; break;
		case 2723: mes "此物品仅限魔法师职业。"; break;
		case 2724: mes "此物品仅限弓箭手职业。"; break;
		case 2725: mes "此物品仅限商人职业。"; break;
		case 2733: mes "此物品仅限神枪手职业。"; break;
		default: break;
	}
	mes "你可以用 ^FF0000"+.@Items[.@i+1]+" "+getitemname(7828)+" 或 "+.@Items[.@i+1]+" "+getitemname(7829)+"^000000 兑换此物品。";
	mes "要兑换吗？";
	next;
	switch(select("不兑换:兑换")) {
	case 1:
		mes "[Erundek]";
		mes "还需要时间查看物品吗？";
		break;
	case 2:
		mes "[Erundek]";
		mes "你想使用哪种徽章兑换？";
		mes "兑换需要 ^3131FF"+.@Items[.@i+1]+" 枚徽章^000000。";
		next;
		if (.@item[0] < 12269 || .@item[0] > 12273 ) {
			mes "[Erundek]";
			mes "请注意，战场奖励物品是 ^FF0000角色绑定^000000 的。确定要兑换吗？";
			next;
		}
		set .@j, select("勇气徽章:勇猛徽章:取消");
		mes "[艾伦德克]";
		if (.@j == 3) {
			mes "你取消了兑换。";
			break;
		}
		set .@cost, ((.@j==1)?7828:7829);
		if (countitem(.@cost) >= .@Items[.@i+1]) {
			mes "感谢你的兑换。";
			delitem .@cost, .@Items[.@i+1];
			getitem .@Items[.@i],1;
		}
		else mes "你的"+getitemname(.@cost)+"不足。";
		break;
	}
	close;
}

// Badge Reward Function
//============================================================
function	script	F_BG_Badge	{
	.@team$ = getarg(1);
	.@bg_type$ = getarg(2);

	if (.@bg_type$ == "Tierra") {
		set .@badge,7828; //BF_Badge1
		set .@amount_win,3;
		set .@amount_lose,1;
	} else if (.@bg_type$ == "Flavius") {
		set .@badge,7829; //BF_Badge2
		set .@amount_win,9;
		set .@amount_lose,3;
	} else
		return;

	if (getarg(0) == 1) {
		set .@amount, .@amount_win;
		if (.@team$ == "Guillaume") {
			mes "[艾克斯尔·罗斯]";
			mes "吉约姆军万岁！";
		} else if (.@team$ == "Croix") {
			mes "[斯旺德里]";
			mes "克鲁瓦军万岁！";
		}
		mes "让我们享受光荣的胜利吧！";
		mes strcharinfo(0)+"，这是胜利的象征。";
	} else {
		set .@amount, .@amount_lose;
		if (.@team$ == "Guillaume") {
			mes "[艾克斯尔·罗斯]";
			mes "你输了，但你为这场战斗付出了努力。";
			mes "这是吉约姆·马洛尔对你坚定不移的奖励！";
			mes "把这次失败当作教训，下次你一定会赢。";
		} else if (.@team$ == "Croix") {
			mes "[斯旺德里]";
			mes "哦，"+strcharinfo(0)+"，别难过。";
			mes "虽然我们没有获胜，但我们已经尽力了。";
			mes "这是克鲁瓦王室的礼物，请不要忘记这场战斗。下一场我们会赢。";
		}
	}
	close2;

	// If the VIP system is enabled, VIP players receive an extra 2 badges.
	if (VIP_SCRIPT && vip_status(VIP_STATUS_ACTIVE))
		set .@amount, .@amount+2;

	set .@medal_gap, 500 - countitem(.@badge);
	if (.@medal_gap >= .@amount)
		getitem .@badge,.@amount;
	else
		getitem .@badge,.@medal_gap;
	return;
}

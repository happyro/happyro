  - Id: 400975
    AegisName: Frontier_R_Crown_DK
    Name: 边境符文王冠（龙骑士）    # !todo check english name
    Type: Armor
    Weight: 1000
    Defense: 60
    Slots: 1
    Jobs:
      Knight: true
    Classes:
      Fourth: true
    Locations:
      Head_Top: true
    ArmorLevel: 2
    EquipLevelMin: 265
    Refineable: true
    Gradable: true
    View: 2733
    Trade:
      NoDrop: true
      NoTrade: true
      NoCart: true
      NoGuildStorage: true
      NoMail: true
      NoAuction: true
    Script: |
      .@g = getenchantgrade();
      .@r = getrefine();
      bonus bAtkRate,4*(.@r/3);
      bonus2 bSkillAtk,"DK_HACKANDSLASHER",5*(.@r/4);
      bonus2 bSkillAtk,"DK_SERVANTWEAPON_ATK",5*(.@r/4);
      if (.@r>=7) {
         bonus bShortAtkRate,10;
         if (.@r>=9) {
            bonus2 bAddRace,RC_All,15;
            bonus2 bAddRace,RC_Player_Human,-15;
            bonus2 bAddRace,RC_Player_Doram,-15;
            bonus bPAtk,7;
            if (.@r>=12) {
               bonus bCritAtkRate,15;
               bonus bCritical,15;
            }
         }
      }
      if (.@g>=ENCHANTGRADE_D) {
         bonus bPAtk,5;
         if (.@g>=ENCHANTGRADE_C) {
            bonus bMaxHPrate,5;
            bonus bMaxSPrate,5;
            if (.@g>=ENCHANTGRADE_B) {
               bonus bShortAtkRate,10;
               if (.@g>=ENCHANTGRADE_A) {
                  bonus2 bAddSize,Size_All,15;
               }
            }
         }
      }

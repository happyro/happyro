//===== rAthena Script =======================================
//= Treasure Hunter Quests
//===== By: ==================================================
//= Fredzilla
//===== Current Version: =====================================
//= 1.0
//===== Compatible With: =====================================
//= rAthena Project
//===== Description: =========================================
//= Start for Treasure hunter quests
//===== Additional Comments: =================================
//= Event_THQS - Used to check if you have already registered
//= #Treasure_Token - used to keep track of tokens
//============================================================

yuno_in01,124,164,6	script	Guild Leader	108,{
	mes "[基根]";
	mes "是什么风把你吹来了？有什么事吗？";
	next;
	menu "我想成为寻宝猎人",-,"接受新任务。",N_NQuest,"带我去官方商店。",N_OShop,"没事了。",N_NVM;
	if(Event_THQS==1) goto N_AlreadyReg;
	mes "[基根]";
	mes "那么，"+strcharinfo(0)+"，如果你想成为寻宝猎人，首先必须完成这些。";
	mes " ";
	mes "^FF00001.^000000 你需要支付^FF000025,000Zeny^000000接受基础训练，并证明自己是会员。";
	mes " ";
	mes "嗯……就这些了。哈哈哈。";
	next;
	menu "支付^FF000025,000Zeny^000000。",-,"太贵了！",N_HighPrice;
	if (Zeny < 25000) goto N_NoZeny;
	set Zeny,Zeny-25000;
	//getitem 7950, 1;
	//getitem 7951, 1;
	set Event_THQS,1;
	mes "[基根]";
	mes "恭喜！";
	emotion ET_CONGRATULATION;
	next;
	mes "[基根]";
	mes "欢迎加入寻宝猎人公会。";
	mes "现在你可以随意接受寻宝任务了。";
	close;
N_NoZeny:
	mes "[基根]";
	mes "嗯……你好像没有^FF000025,000Zeny^000000，"+strcharinfo(0)+"。准备好后再来吧。";
	close;
N_HighPrice:
	mes "[基根]";
	mes "如果连区区^FF000025,000Zeny^000000都付不起，你还不能成为寻宝猎人。";
	close;
N_AlreadyReg:
	mes "[基根]";
	mes "哈哈哈……你已经是会员了。";
	close;
N_NQuest:
	if (Event_THQS!=1) goto A_NeedReg;
	mes "[基根]";
	mes "那么，"+strcharinfo(0)+"，想接任务的话，就去隔壁房间找那位寻宝猎人吧。";
	close;
A_NeedReg:
	mes "[基根]";
	mes "抱歉，想接受任务必须先成为寻宝猎人公会的会员。";
	mes " ";
	mes "既然你已经是会员，随时都可以使用我们的商店。它们就在这一层。";
	mes " ";
	mes "我们还有一家仅限会员的商店，可以用叫作寻宝猎人代币的小金属钻石兑换稀有物品。";
	mes " ";
	mes "你还可以进入我们专属的个人地下城。";
	close;
N_OShop:
	if (Event_THQS!=1) goto N_NeedMem;
	mes "[基根]";
	mes "好的，"+strcharinfo(0)+"，我马上带你去商店！";
	next;
	warp "prt_in",166,171;
	close;
	end;
N_NeedMem:
	mes "[基根]";
	mes "抱歉，只有会员才能进入我们的私人商店。";
	close;
N_NVM:
	mes "[基根]";
	mes "好的，有空时再来吧。";
	close;
}

// GM Control Panel (custom translations)
//============================================================
job_ko,3,1,4	script	Battle Test Control#ko	588,{
	callfunc "F_GM_NPC";
	if (callfunc("F_GM_NPC",1854,0) == 1) {
		mes "这是战斗测试控制 NPC。";
		next;
	} else {
		mes "密码错误。";
		close;
	}
	switch(select("召唤目标:禁用召唤目标:召唤幻影:禁用召唤幻影")) {
	case 1:
		donpcevent "Summon Target#ko::OnEnable";
		mes "召唤目标已启用。";
		break;
	case 2:
		donpcevent "Summon Target#ko::OnDisable";
		mes "召唤目标已禁用。";
		break;
	case 3:
		donpcevent "Summon Fake#ko::OnEnable";
		mes "召唤幻影已启用。";
		break;
	case 4:
		donpcevent "Summon Fake#ko::OnDisable";
		mes "召唤幻影已禁用。";
		break;
	}
	next;
	mes "控制完成。";
	close;
}

job_ko,4,1,4	script	Guide#ko_helper	588,{
	callfunc "F_GM_NPC";
	if (callfunc("F_GM_NPC",1854,0) == 1) {
		mes "这是影狼和胧月转职助手 NPC。";
		next;
	} else {
		mes "密码错误。";
		close;
	}
	mes "我能解决转职任务中的任何问题。";
	next;
	switch(select("当前状态:设置测试:转职前:初始化")) {
	case 1:
		mes "变量状态（当前/最大）";
		mes "job_kagero (" + job_kagero + "/9)";
		mes "job_kagero_lp (" + job_kagero_lp + "/100)";
		next;
		mes "任务状态（当前/最大）";
		mes "5131 (" + isbegin_quest(5131) + "/1)";
		mes "5132 (" + isbegin_quest(5132) + "/1)";
		mes "5133 (" + isbegin_quest(5133) + "/1)";
		mes "5134 (" + isbegin_quest(5134) + "/1)";
		mes "5135 (" + isbegin_quest(5135) + "/1)";
		mes "5136 (" + isbegin_quest(5136) + "/2)";
		mes "5139 (" + isbegin_quest(5139) + "/1)";
		mes "5137 (" + isbegin_quest(5137) + "/2)";
		mes "5140 (" + isbegin_quest(5140) + "/1)";
		mes "5141 (" + checkquest(5141,PLAYTIME) + "/1)";
		mes "5138 (" + isbegin_quest(5138) + "/2)";
		mes "5142 (" + isbegin_quest(5142) + "/1)";
		mes "5143 (" + isbegin_quest(5143) + "/2)";
		mes "5144 (" + isbegin_quest(5144) + "/2)";
		mes "5145 (" + isbegin_quest(5145) + "/1)";
		mes "5146 (" + isbegin_quest(5146) + "/1)";
		close;
	case 2:
		mes "要将哪项测试设为完成？";
		mes "转职前必须完成三项测试。要进入转职状态，请从上一个菜单直接选择[转职前]！";
		next;
		switch(select("完成知识测试:完成生存测试:完成武器测试")) {
		case 1:
			set job_kagero,5;
			setquest 5136;
			completequest 5136;
			mes "知识测试已设为完成。希望你已完成初始化。";
			break;
		case 2:
			set job_kagero,5;
			set job_kagero_lp,0;
			setquest 5137;
			completequest 5137;
			mes "生存测试已设为完成。希望你已完成初始化。";
			break;
		case 3:
			set job_kagero,5;
			setquest 5138;
			completequest 5138;
			mes "武器测试已设为完成。希望你已完成初始化。";
			break;
		}
		close;
	case 3:
		mes "我会将任务状态改为转职前，但在此之前……";
		next;
		mes "请选择武器。";
		next;
		switch(select("短剑:手里剑")) {
			case 1: set .@quest,5143; break;
			case 2: set .@quest,5144; break;
		}
		setquest 5136;
		completequest 5136;
		setquest 5137;
		completequest 5137;
		setquest 5138;
		completequest 5138;
		setquest .@quest;
		completequest .@quest;
		setquest 5146;
		set job_kagero,8;
		mes "已设置转职前状态。祝你好运！！";
		close;
	case 4:
		set job_kagero,0;
		set job_kagero_lp,0;
		for (set .@i,5131; .@i<=5146; set .@i,.@i+1)
			if (isbegin_quest(.@i)) erasequest .@i;
		mes "初始化任务完成。可通过[当前状态]选项确认！";
		close;
	}
	end;
}

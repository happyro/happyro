// Test of Battle
//============================================================
job_ko,148,46,4	script	Leader Gion#ko2	588,{
	if (MaxWeight - Weight < 2000 || checkweight(1201,1) == 0) {
		mes "[Leader Gion]";
		mes "你现在不需要带这么多东西！"; //custom translation
		close;
	}
	if (job_kagero == 7) {
		cutin "job_ko01",2;
		mes "[Leader Gion]";
		mes "看来你还没处理目标。";
		next;
		mes "[Leader Gion]";
		mes "我再说一次。目标是^FF0000宗族秘密^000000。";
		next;
		mes "[Leader Gion]";
		mes "路当然很难，继续寻找吧！"; //custom translation
		close2;
		cutin "",255;
		end;
	} else if (job_kagero == 8) {
		cutin "job_ko02",2;
		mes "[Leader Gion]";
		mes "看来你已经处理了目标。嗯。";
		next;

		//custom translations
		if (ismounting()) {
			mes "[Leader Gion]";
			mes "但请从青蛙坐骑上下来。否则我无法继续！";
			close2;
			cutin "",255;
			end;
		}
		if (BaseLevel < 99 || JobLevel < 70) {
			mes "[Leader Gion]";
			mes "你怎么变弱了？恢复之前的等级后再来。";
			close2;
			cutin "",255;
			end;
		}
		if (SkillPoint != 0) {
			mes "[Leader Gion]";
			mes "用完所有技能点后再回来。";
			close2;
			cutin "",255;
			end;
		}

		mapannounce "job_ko","[Gion] 中断战斗测试。",bc_map;
		cutin "job_ko04",2;
		mes "[Leader Gion]";
		mes "战斗测试暂时延期。别担心，这不会影响其他测试。";
		next;
		mapannounce "job_ko","[Gion] 我的朋友" + strcharinfo(0) + "踏上了" + ((Sex == SEX_MALE)?"影狼":"胧月") + "之路。恭喜！！",bc_map;
		mes "[Leader Gion]";
		mes "我的朋友" + strcharinfo(0) + "踏上了" + ((Sex == SEX_MALE)?"影狼":"胧月") + "之路。恭喜！！";
		next;
		cutin "job_ko02",2;
		mes "[Leader Gion]";
		mes "见到踏上新道路的年轻人真令人愉快。";
		next;
		mes "[Someone's Voice]";
		mes "等一下，Gion。";
		next;
		donpcevent "Kuuga Gai#ko2::OnEnable";
		donpcevent "Red Leopard Joe#ko2::OnEnable";
		cutin "job_ko04",2;
		mes "[Leader Gion]";
		mes "抱歉，差点忘了你们。有什么要和" + strcharinfo(0) + "分享的吗？";
		next;
		cutin "",255;
		mes "[Kuuga Gai]";
		mes "嗯……突然让我发言……真尴尬……";
		next;
		mes "[Kuuga Gai]";
		mes strcharinfo(0) + "，你现在是我们宗族值得骄傲的一员。永远抬头挺胸……";
		next;
		mes "[Kuuga Gai]";
		mes "^777777(Gai's voice fades out.)^000000.";
		mes "很抱歉初次见面时掐了你。";
		next;
		donpcevent "Kuuga Gai#ko2::OnDisable";
		mes "[Red Leopard Joe]";
		mes "噗哈哈哈！Gai只会说。我知道自己比Gai更有价值。";
		next;
		if (isbegin_quest(5143) == 2) {
			set .@item,13075; //Kurenai
			set .@weapon$,"dagger";
		} else {
			set .@item,13311; //Huuma_Shadow
			set .@weapon$,"shuriken";
		}
		mes "[Red Leopard Joe]";
		mes "我改良了你制作的原型" + .@weapon$ + "。";
		next;
		mes "[Red Leopard Joe]";
		mes "我完成最后加工后，" + getitemname(.@item) + "闪耀着美丽的猩红光芒。";
		next;
		mes "[Red Leopard Joe]";
		mes "我擅自给你的武器取了名字，相信你会喜欢。";
		next;
		mes "[Red Leopard Joe]";
	mes "Gion 队长，请继续。";
		next;
		cutin "job_ko01",2;
		donpcevent "Red Leopard Joe#ko2::OnDisable";
		mes "[Leader Gion]";
		mes "Gai和Joe已经说完了，我没什么补充。";
		next;
		mes "[Leader Gion]";
		mes "只是很遗憾，这些测试的环境本可以为后代做得更好。";
		next;
		mes "[Leader Gion]";
		mes "你只需向前看，永远不要回头。";
		next;
		for (set .@i,5131; .@i<=5146; set .@i,.@i+1)
			if (isbegin_quest(.@i)) erasequest .@i;
		set job_kagero,9;
		getnameditem .@item,strcharinfo(0);
		jobchange (Sex == SEX_MALE)?Job_Kagerou:Job_Oboro;
		donpcevent "Summon Target#ko::OnEnable";
		mes "[Leader Gion]";
		mes "愿舞动的太阳影狼与朦胧月光胧月的祝福伴你前行。";
		close2;
		warp "que_ng",21,71;
		end;
	} else if (job_kagero == 9) {
		cutin "job_ko01",2;
		mes "[Leader Gion]";
		mes "愿舞动的太阳影狼与朦胧月光胧月的祝福伴你前行。";
		close2;
		warp "que_ng",21,71;
		end;
	} else {
		cutin "job_ko01",2;
		mes "[Leader Gion]";
		mes "你不该来这里。请离开！"; //custom translation
		close2;
		warp "amatsu",147,136;
		end;
	}
}


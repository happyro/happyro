		mes "他四处游荡，可能很难找到，但知道他喜欢赌博也许会有帮助……";
		next;
		mes "[Jesqurienne]";
		mes "祝你找到 Dearles。";
		mes "我输得很惨，所以打算留在这里再喝一杯。";
		mes "再见，"+.@input$+"。";
		mes "";
		mes "";
		close;
	}
	else if (sign_q == 25) {
		mes "哦哦哦……";
		mes "我的头……";
		mes "哦……是你……！";
		mes "你找到 Dearles 了吗？";
		next;
		mes "[Jesqurienne]";
		mes "嗯……";
		mes "他沉迷赌博，";
		mes "也许你可以去能赌博的地方找到他……";
		mes "";
		mes "";
		close;
	}
	else {
		mes "哦哦哦～";
		mes "好晕。";
		mes "也许我又喝太多了～";
		mes "";
		close;
	}

OnOmg:
	emotion ET_HUK;
	end;

OnHo:
	emotion ET_DELIGHT;
	end;
}


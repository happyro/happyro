				mes "[Jesqurienne]";
				mes "啊——！我的酒杯已经空了？酒保，再来一杯~";
				next;
				break;
			}
			mes "[Jesqurienne]";
			mes "总之，我为自己的卓越智慧感到骄傲！我可能有点沉迷学习，但这正是值得钦佩的理由~";
			next;
			mes "[Jesqurienne]";
			mes "巫师和贤者考试？没问题~连炼金术士考试也很简单。到目前为止还没遇到比我聪明的人~";
			next;
			switch(select("^333333自大的丫头。^000000:少喝点……")) {
			case 1:
				emotion ET_FRET;
				mes "[Jesqurienne]";
				mes "什么……？你说什么？从没人对我说过这种话！你、你竟敢……";
				next;
				emotion ET_ANGER;
				mes "[Jesqurienne]";
				mes "证明你能与我的卓越智慧相提并论，我就接受你的小小侮辱！是时候进行知识挑战了！";
				next;
				mes "["+ strcharinfo(0) +"]";
				mes "知识……挑战？像问答游戏？但谁来提问？";
				next;
				donpcevent "Aaron#sign::onSmile";
				emotion ET_SURPRISE;
				emotion ET_SURPRISE, playerattached();
				mes "[Aaron]";
			mes "有人叫我吗？";
				mes "''Quiz Challenge?''";
			mes "我相信我可以帮忙。";
				next;
				set sign_q,21;
				emotion ET_KIK;
				mes "[Jesqurienne]";
			mes "Aaron 教授？呵呵~如果他提问，你打败我的机会就是零！";
				close;
			case 2:
				mes "[Jesqurienne]";
			mes "呵呵呵~很多人都叫我别喝太多。但一旦开始我就停不下来。我就是这么爱喝！";
				next;
				mes "[Jesqurienne]";
			mes "还有……有时我宁愿用朦胧的双眼看世界，按照自己想看的方式看……";
				close;
			}
		}
	}
	else if ((sign_q == 21) || (sign_q == 22)) {
		mes "想到你以为能在知识挑战中赢我，就觉得好笑。呵呵呵呵呵~！";
		next;
		mes "[Jesqurienne]";
		mes "Aaron 教授在等你请他开始。我在等你意识到自己毫无胜算的时刻！";
		close;
	}
	else if (sign_q == 23) {
		mes "哇哈哈哈哈！你一开始就该知道自己没有机会！当然，我有，但你得亲自吸取教训。";
		next;
		emotion ET_FRET;
		mes "[Jesqurienne]";
		mes "如果你没在知识挑战中丢尽脸，我还会羞辱你。事实上，我甚至原谅你之前伤害了我的自尊。";
		next;
		emotion ET_KIK;
		mes "[Jesqurienne]";
		mes "你敢相信吗？";
		mes "就算喝醉了，我也能在智力测试中击败你！";
		mes "哇哈哈！真不敢相信你这么没头脑……！";
		mes "";
		mes "";
		next;
		switch(select("我不能让你赢！:该死……")) {
		case 1:
			set sign_q,22;

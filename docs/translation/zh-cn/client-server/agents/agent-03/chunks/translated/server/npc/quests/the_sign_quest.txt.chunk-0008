			mes "你学得很慢，对吧？";
			mes "不过，我随时欢迎你的‘挑战’！";
			mes "哇哈哈哈哈～！";
			mes "";
			close;
		case 2:
			mes "[Jesqurienne]";
			mes "你现在才意识到自己的智力";
			mes "和我相比有多可怜吗？呵呵呵！";
			mes "每个傻瓜都有希望！";
			mes "";
			close;
		}
	}
	else if (sign_q == 24) {
		mes "什么……？";
		mes "我……我……";
		mes "我不、不敢相信。";
		next;
		mes "[Jesqurienne]";
		mes "我输了……";
		mes "也、也许你说得对。";
		mes "我确实很傲慢……";
		mes "我应该少喝一点，";
		mes "四处旅行，拓展知识……";
		mes "";
		next;
		mes "[Jesqurienne]";

// Utility NPCs :: cat_merchant
//============================================================
mal_in02,134,31,5	script	Investment Cat Helper	505,{
	if (MaxWeight - Weight < 100 || checkweight(1201,1) == 0) {
		mes "[投资ment Cat Helper]";
		mes "你带着沉重的货物。你是商贩吗？这里没有商贩。";
		close;
	}
	if (ep13_yong1 < 10) {
		mes "[投资ment Cat Helper]";
		mes "哦！";
		mes "你是来咨询投资的吗？";
		mes "你来对地方了。";
		next;
		mes "[投资ment Cat Helper]";
		mes "我来这里是为了投资猫爪商会。";
		mes "呃——我的意思是，我是来帮助你这样的诚实之人的。";
		mes "嘿嘿嘿~";
		next;
		mes "[投资ment Cat Helper]";
		mes "我一直在这里和你们人类交谈，已经记不清所有事情了。";
		mes "但我想先确认……等等。";
		next;
		mes "闻闻……闻闻……";
		next;
		mes "[投资ment Cat Helper]";
		mes "啊？！";
		mes "你对猫爪商会了解不多，对吧？";
		mes "嗯，你闻起来确实不像猫。";
		next;
		mes "[投资ment Cat Helper]";
		mes "很好！！";
		mes "你来这里投资猫爪商会，做了正确的决定~";
		next;
		mes "[投资ment Cat Helper]";
		mes "首先，想开户需要拥有10个Malangdo罐头。";
		next;
		while(1) {
			switch(select("开户:询问福利:取消")) {
			case 1:
				if (countitem(12636) < 10) {
					mes "[投资ment Cat Helper]";
					mes "嗯！";
					mes "我很想免费为你开户，";
					mes "但你知道，这是为了";
					mes "宣传商团投资者，抱歉。";
					close;
				}
				delitem 12636,10; //Malang_Sp_Can
				set ep13_yong1,10;
				mes "[投资ment Cat Helper]";
				mes "好！";
				mes "在这里写下名字~然后";
				mes "在那里按下掌印，";
				mes "啊！~你叫什么？";
				next;
				mes "[投资ment Cat Helper]";
				mes strcharinfo(0)+" you are~";
				next;
				mes "[投资ment Cat Helper]";
				mes "姓名："+strcharinfo(0);
				mes "账户数量：10";
				mes "好了！登记完成！";
				next;
				mes "[投资ment Cat Helper]";
				mes "你现在拥有账户了。";
				mes "下次投资时会获得一定数量的罐头。";
				next;
				mes "[投资ment Cat Helper]";
				mes "我希望获得大量投资，";
				mes "这样你也能享受更多服务。";
				mes "我也希望我们猫爪商会能赚很多钱。";
				next;
				mes "[投资ment Cat Helper]";
				mes "下次投资见~";
				close;
			case 2:
				mes "[投资ment Cat Helper]";
				mes "你想知道投资的福利吗？";
				mes "其实，我们是一小群猫，思维方式和人类不同。";
				next;
				mes "[投资ment Cat Helper]";
				mes "福利取决于你在我们服务中的投资金额。";
				mes "包括更多传送点、额外仓库位置以及商品和服务的价格折扣。";
				next;
				mes "[投资ment Cat Helper]";
				mes "我保证，商会贸易发展后你也会受益。";
				next;
				break;
			case 3:
				mes "[投资ment Cat Helper]";
				mes "啊~你就要走了吗？";
				mes "T_T~请开户。";
				close;
			}
		}
	} else if (ep13_yong1 < 20000) {
		mes "[投资ment Cat Helper]";
		mes "我见过太多人，记不住所有人……";
		mes "但我想先确认一下……等等。";
		mes "打扰了！";
		next;
		mes "闻闻……闻闻……";
		next;
		if (ep13_yong1 < 10000) {
			set .@cans,10;
			mes "[投资ment Cat Helper]";
			mes "这是熟悉的味道！！";
			mes "如果是这样……！！";
			next;
			mes "[投资ment Cat Helper]";
			mes "你是来投资的！！";
			mes "好！~~ Good to see you~";
			next;
			mes "[投资ment Cat Helper]";
			mes "从你的气味来看~你少于10000个账户。";
			mes "在此之前，投资10个罐头就能获得一个账户。";
		} else {
			set .@cans,20;
			mes "[投资ment Cat Helper]";
			mes "好强烈的气味！！";
			mes "那一定是！！";
			next;
			mes "[投资ment Cat Helper]";
			mes "VIP投资者！！！！！！";
			mes "你是来投资的吗？欢迎！";
			next;
			mes "[投资ment Cat Helper]";
			mes "拥有超过10000个账户的VIP投资者";
			mes "可以用20个罐头再获得一个账户。";
			mes "一笔好投资！";
		}
		next;
		mes "[投资ment Cat Helper]";
		mes "你要做什么？";
		next;
		switch(select("投资:查看账户数量:取消")) {
		case 1:
			mes "[投资ment Cat Helper]";
			mes "哦~谢谢你的投资~";
			mes "一次最多可获得10个账户。";
			mes "很棒吧？";
			mes "你要投资多少？输入0取消。";
			next;
			input .@input;
			if (.@input == 0) {
				mes "[投资ment Cat Helper]";
				mes "下次再投资吧~";
				close;
			} else if (.@input > 10) {
				mes "[投资ment Cat Helper]";
				mes "一次最多可获得10个账户~";
				close;
			}
			set .@required, .@input*.@cans;
			mes "[投资ment Cat Helper]";
			mes "总计" + .@input + "个账户，对吧？";
			mes "你需要的罐头数量是"+.@required+"个。";
			mes "要继续吗？";
			next;
			if(select("是:否") == 2) {
				mes "[投资ment Cat Helper]";
				mes "哦？错了吗？真奇怪。";
				mes "请再检查一次~";
				close;
			}
			if (countitem(12636) < .@required) {
				mes "[投资ment Cat Helper]";
				mes "啊啊啊！";
				mes "你的罐头不够。";
				mes "你知道的，我是一只很忙的猫。";
				close;
			}
			if (ep13_yong1 < 10000) {
				delitem 12636,.@required; //Malang_Sp_Can
				set ep13_yong1, ep13_yong1+.@input;
				mes "[投资ment Cat Helper]";
				mes .@input+" accounts were invested in.";
				mes "谢谢你的帮助~";
				next;
				mes "[投资ment Cat Helper]";
				mes "等我们获得更多罐头投资，";
				mes "我们的商团会进一步壮大。";
				mes "你也能享受服务~";
				mes "双赢策略？";
				close;
			} else {
				if (.@input + ep13_yong1 > 20000) {
					delitem 12636,.@required; //Malang_Sp_Can
					set ep13_yong1,20000;
					mes "[投资ment Cat Helper]";
					mes "最多可以拥有20000个账户";
					mes "根据商团政策……";
					mes strcharinfo(0)+"'s accounts increase to 20,000.";
					mes "非常感谢你的投资~";
					next;
					mes "[投资ment Cat Helper]";
					mes "否w, "+strcharinfo(0)+", you can't invest further";
					mes "但你仍然可以把罐头捐给商团。";
					mes "非常感谢~";
					close;
				} else {
					delitem 12636,.@required; //Malang_Sp_Can
					set ep13_yong1, ep13_yong1+.@input;
					mes "[投资ment Cat Helper]";
					mes .@input+" accounts have been invested in.";
					mes "谢谢你的帮助~";
					next;
					mes "[投资ment Cat Helper]";
					mes "有了你对罐头的大量投资，";
					mes "我们能更早实现目标。";
					mes "再次感谢。";
					close;
				}
			}
		case 2:
			mes "[投资ment Cat Helper]";
			mes "你想查看账户数量？嗯，让我看看~";
			next;
			mes "[投资ment Cat Helper]";
			mes "姓名："+strcharinfo(0);
			mes "账户数量："+ep13_yong1;
			next;
			mes "[投资ment Cat Helper]";
			if (ep13_yong1 < 10000)
				mes "明白了吗？";
			else
				mes "你进行了许多投资。谢谢你。";
			close;
		case 3:
			mes "[投资ment Cat Helper]";
			mes "下次再投资吧~";
			close;
		}
	} else if (ep13_yong1 >= 20000) {
		mes "[投资ment Cat Helper]";
		mes strcharinfo(0) + ", welcome~";
		mes strcharinfo(0) + "~ I felt something upon your arrival.";
		next;
		mes "[投资ment Cat Helper]";
		mes "想捐赠吗？";
		next;
		if(select("捐赠:否") == 2) {
			mes "[投资ment Cat Helper]";
			mes "嘿嘿~那就在这里玩得开心~";
			close;
		}
		mes "[投资ment Cat Helper]";
		mes "哇，谢谢你，"+strcharinfo(0)+"~!";
		next;
		mes "[投资ment Cat Helper]";
		mes strcharinfo(0)+"~ with your help";
		mes "这些罐头会分发给";
		mes "米德加尔特地区的猫咪~";
		next;
		mes "[投资ment Cat Helper]";
		mes "罐头捐赠数量最少20个，最多10000个。";
		next;
		input .@input;
		if (.@input < 20 || .@input > 10000) {
			mes "[投资ment Cat Helper]";
			mes "罐头捐赠数量最少20个，最多10000个。";
			close;
		} else if (countitem(12636) < .@input) { // Malang_Sp_Can
			mes "[投资ment Cat Helper]";
			mes "Hmm? 你的罐头不够。";
			close;
		} else {
			delitem 12636,.@input; //Malang_Sp_Can
			mes "[投资ment Cat Helper]";
			mes "哦！ Thank you~";
			next;
			mes "[投资ment Cat Helper]";
			mes "亲爱的"+strcharinfo(0)+" ~";
			mes "我只能提供速度激发";
			mes "和天赐祝福。";
			mes "谢谢你。";
			npcskill "AL_INCAGI",10,0,0;
			npcskill "AL_BLESSING",10,0,0;
			close;
		}
	}
}

malangdo,184,139,4	script	Storekeeper#mal	560,{
	mes "[Storekeeper]";
	mes "嘿，看来你想清空背包里的东西。";
	mes "想免费打开仓库吗？";
	next;
	mes "[Storekeeper]";
	mes "哈哈哈~开玩笑的，当然不是免费的。";
	mes "你把我当成什么了？";
	next;
	if (ep13_yong1 > 999) {
		set .@cans,1;
		set .@zeny,1500;
		set .@i, select("用罐头支付——1单位:用Zeny支付——1500z");
	} else {
		set .@cans,2;
		set .@zeny,3000;
		set .@i, select("用罐头支付——2单位:用Zeny支付——3000z");
	}
	if(!callfunc("F_CanOpenStorage")){
		mes "[Storekeeper]";
		mes "啊，等等！！";
		mes "使用仓库服务需要^FF0000基础技能6级^000000！！";
		close;
	}
	switch(.@i) {
	case 1:
		if (countitem(12636) < .@cans) {
			mes "[Storekeeper]";
			mes "你的罐头不够。..";
			close;
		}
		delitem 12636,.@cans; //Malang_Sp_Can
		break;
	case 2:
		if (Zeny < .@zeny) {
			mes "[Storekeeper]";
			mes "你的Zeny不够……";
			close;
		}
		set Zeny, Zeny-.@zeny;
		break;
	}
	mes "[Storekeeper]";
	mes "谢谢你。";
	close2;
	openstorage;
	end;
}

// Malangdo Island :: ma_tomas
//============================================================
mal_in02,28,56,5	script	Samuel#mal	495,{
	mes "[Samuel]";
	mes "啊，你是说广告……嗯，你是说我们的村长？";
	mes "最好别打扰他，他总是很忙。";
	if (ma_tomas == 0)
		close;
	next;
	mes "[Samuel]";
	mes "^0000FFBut it'd be impossible to talk without bothering him anyway......^000000";
	mes "他只是一直很忙。";
	next;
	switch(select("广告……？:村长？")) {
	case 1:
		mes "[Samuel]";
		mes "啊，在定居这里之前，他曾是这艘船的上将~";
		mes "如太阳般闪耀的金色眼睛！！！";
		mes "在粗犷海风中飘动的银色胡须！！！";
		next;
		mes "[Samuel]";
		mes "哈~真帅！！！！";
		mes "我被那种魅力吸引，乘上了Navi号船！";
		mes "这就是所谓男人的浪漫。呼呼~";
		emotion ET_SHY;
		next;
		mes "[Samuel]";
		mes "嗯……自从定居Malangdo后，他忙于村长工作，指甲似乎变差了一点。但他的眼睛还是一样。";
		close;
	case 2:
		mes "[Samuel]";
		mes "嗯，既然这里是Malangdo，他会不会是Malangdo村长……？！";
		mes "否, though it will be funny...";
		mes "Malangdo村……嗯……这个……也不对……";
		mes "嗯，这件事没那么重要。";
		next;
		mes "[Samuel]";
		mes "虽然上将和村长肯定有很多区别，但无论如何都离不开Tomas上将。";
		next;
		mes "[Samuel]";
		mes "不只是我，大家都会这么想。";
		mes "因此他很辛苦。";
		close;
	}
}

mal_in02,22,62,3	script	Tomas#mal	556,{
	if (BaseLevel < 60) {
		mes "[Tomas, Village Chief]";
		mes "嗯……你是谁？";
		mes "你不觉得现在来这里太早了吗？";
		close;
	}
	if (ma_tomas == 0) {
		mes "[Tomas, Village Chief]";
		mes "Samuel！";
		mes "那边快结束了吗？";
		cutin "ma_tomas02",2;
		next;
		mes "[Samuel]";
		mes "是, Admiral!";
		mes "包括刚收到的箱子在内，我已经把3000个箱子都搬进仓库了。下一批箱子预计5小时后送到！";
		emotion ET_HUK, getnpcid(0, "Samuel#mal");
		next;
		mes "[Tomas, Village Chief]";
		mes "Samuel！";
		mes "我还要告诉你多少次，要叫我村长，不是上将！";
		next;
		mes "[Samuel]";
		mes "抱歉！村长！";
		mes "我会改正！";
		emotion ET_HUK, getnpcid(0, "Samuel#mal");
		next;
		mes "[Tomas, Village Chief]";
		mes "嗯，嗯！";
		mes "把它们分类并整理到那边。下一批箱子到之前，你必须完成那里的工作！";
		next;
		mes "[Tomas, Village Chief]";
		mes "海参、海鞘、海葵放右边！海藻和海带放楼下，凤尾鱼和海鼓送到集合处。其余的分类堆在角落！";
		next;
		mes "[Samuel]";
		mes "是! Village Chief!";
		mes "海藻、海参、海鞘、海葵放右边！海藻和玻璃瓶放楼下！凤尾鱼和海鼓送到集合处！其余分类堆在角落！";
		emotion ET_HUK, getnpcid(0, "Samuel#mal");
		next;
		mes "[Tomas, Village Chief]";
		mes "不是。";
		mes "海参、海鞘、海葵放右边。海藻和海带放楼下。凤尾鱼和海鼓送到集合处。其余分类堆在角落。";
		emotion ET_THINK;
		next;
		mes "[Samuel]";
		mes "是!!";
		emotion ET_HUK, getnpcid(0, "Samuel#mal");
		next;
		mes "[Tomas, Village Chief]";
		mes "呼……";
		mes "看来没完没了。";
		mes "还有一堆文件要处理……如果不在下一批箱子到达前完成，我就要遭殃了。";
		emotion ET_OHNO;
		next;
		mes "[Tomas, Village Chief]";
		mes "那么，下一批箱子有1300个……";
		mes "接下来是楼下要装船的700个箱子……";
		next;
		switch(select("试着和他说话。:既然他很忙，就算了。")) {
		case 1:
			mes "[Tomas, Village Chief]";
			mes "嗯，你是谁？";
			mes "你看起来很陌生。抱歉，如果不是急事，能改天再来吗？";
			cutin "ma_tomas01",2;
			next;
			switch(select("我第一次来马来港。:另一只猫让我来这里。:我以后再来。")) {
			case 1:
				mes "[Tomas, Village Chief]";
				mes "...So I told you your face was not familiar.";
				emotion ET_THINK;
				next;
				mes "[Tomas, Village Chief]";
				mes "嗯……抱歉，但如我之前所说，如果不是急事，请和其他猫谈吧。我还有很多工作没做，没时间和你聊天。";
				break;
			case 2:
				mes "[Tomas, Village Chief]";
				mes "...Anyway all are always good to leave me with the work.";
				mes "真无情……";
				emotion ET_FRET;
				next;
				mes "[Tomas, Village Chief]";
				mes "嗯……既然如此，如果不是急事，请和其他猫谈吧。我还有很多未完成的工作，没时间和你聊天。";
				break;
			case 3:
				mes "[Tomas, Village Chief]";
				mes "抱歉。";
				mes "请再来找我，虽然我不知道什么时候有空。";
				close2;
				cutin "",255;
				end;
			}
			next;
			mes "[Tomas, Village Chief]";
			mes "最近工作压得我喘不过气，虽然能作为村长被信任和依靠也不错……";

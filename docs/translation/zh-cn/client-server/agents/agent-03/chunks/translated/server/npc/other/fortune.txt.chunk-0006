			mes "哼！现在不是考虑金钱的时候。冷静下来，放宽心吧！";
			break;
		case 4:// Drops Card
			mes "仔细看，那不是在喝果汁，而是用插在地里的吸管喝地下水！金钱就藏在意想不到的地方！祝你寻找顺利！";
			break;
		case 5:
			mes "就像能在干燥沙漠中解渴一样，即使在艰难的世界里也能赚到钱！";
			break;
		case 6:
			mes "就像仙人掌刺中的汁液，即使身处痛苦也能积累财富。你能做到！";
			break;
		case 7:// Mantis Card
			mes "啊！有人盯上你的财物了！小心！";
			break;
		case 8:
			mes "糟糕！有人盯上你的钱了！好好保管！";
			break;
		case 9:
			mes "预示你可能会为了赚钱而想做坏事！别忘了保持善良！";
			break;
		case 10:// Munak Card
			mes "你把钱藏在衣服里了！隐藏的富翁！小心别被发现！";
			break;
		case 11:
			mes "将来你似乎会像那些波利一样用脚踢着钱玩！恭喜！";
			break;
		case 12:
			mes "你一定累坏了！赚钱可不是容易的事！但这样得来的钱更有价值！";
			break;
		case 13:// Santa Poring Card
			mes "你花钱的倾向越来越强了！小心别变得身无分文！";
			break;
		case 14:
			mes "用钱买些有趣的东西吧！好运就会向你而来！";
			break;
		case 15:
			mes "把钱花在令人兴奋的事物上！看来好运正要到来！";
			break;
		case 16:// Soldier Skeleton Card
			mes "看来你会遇到两次幸运的机会！别错过这两次机会！";
			break;
		case 17:
			mes "小钱包里好像应该有钱吧？你会有一笔小收入！聪明地存钱吧！";
			break;
		case 18:
			mes "这么～空。虽然令人沮丧，但别太担心钱！更好的事情会发生！";
			break;
		case 19:// Skeleton Card
			mes "有人会归还你丢失的东西！真让人安心！";
			break;
		case 20:
			mes "不用担心骨质疏松！吃了这么多钙不是好事吗？哎呀！这不是在说钱吗？！";
			break;
		case 21:
			mes "看你这么努力工作，看来会赚很多钱！恭喜～！";
			break;
		case 22:// Eddga Card
			mes "即使存了钱，也会像烟一样消失。别太执着于金钱！";
			break;
		case 23:
			mes "赚钱很难，对吧？但别忘了人生中的善行！";
			break;
		case 24:
			mes "四处收钱可能会遇到可怕的人！一定要小心！";
			break;
		case 25:// Angeling Card
			mes "忘掉金钱，飞呀～飞呀！你会感到非常轻松！";
			break;
		case 26:
			mes "金钱就像云！别想着钱，想想幸福的生活吧！";
			break;
		case 27:
			mes "即使看似毫无意义，只要坚持就能赚很多钱！你能做到！";
			break;
		case 28:// Poring Card
			mes "别忽视地板上的小事！保持那样开放的心态，就能积攒钱财！";
			break;
		case 29:
			mes "如果从事与蘑菇或苹果有关的工作，好运在等着你！会是什么工作呢？";
			break;
		case 30:
			mes "看着这么平和的牌怎么能想到钱呢！太不像话了！呜……不过看来你会积累很多财富！";
			break;
		case 31:// Poporing Card
			mes "你有许多漂亮的石头！从事这个行业就会兴旺！";
			break;
		case 32:
			mes "这预示着你会兴旺发达！现在不用担心了！";
			break;
		case 33:
			mes "你会收集许多宝藏！但问题是如何保护它们！";
			break;
		}
		next;
		mes "[Chocarle]";
		mes "听完财富占卜后，有件事你必须记住！";
		mes "不努力，金钱不会自动来到身边！无论运势多好，都必须勤奋工作！";
		next;
		cutin "",255;
		mes "[Chocarle]";
		mes "记住这一点！那么，下次再见……噗！";
		close;
	}

L_displaycutin:
	.@arg = getarg(0);
	if (.@arg < 4) cutin "Ʈī",4;		// Ghostring Card
	else if (.@arg < 7) cutin "ī",4;	// Drops Card
	else if (.@arg < 10) cutin "Ƽī",4;	// Mantis Card
	else if (.@arg < 13) cutin "ī",4;		// Munak Card
	else if (.@arg < 16) cutin "Ÿī",4;	// Santa Poring Card
	else if (.@arg < 19) cutin "ī",4;// Soldier Skeleton Card
	else if (.@arg < 22) cutin "̷ī",4;	// Skeleton Card
	else if (.@arg < 25) cutin "尡ī",4;	// Eddga Card
	else if (.@arg < 28) cutin "ī",4;	// Angeling Card
	else if (.@arg < 31) cutin "ī",4;		// Poring Card
	else cutin "ī",4;// Poporing Card
	return;
}
	
payon_in03,118,119,1	script	Ascetic	4W_F_01,2,2,{
	mes "[Kissy-Kissy]";
	mes "NyangNyangNyang~";
	mes "NyaNyangNyaNyag~";
	next;
	mes "[Kissy-Kissy]";
	mes "我年轻时决定成为占卜师，";
	mes "来到城里后便";
	mes "全心投入训练。";
	mes "进步缓慢让我十分苦恼。";
	next;
	mes "[Kissy-Kissy]";
	mes "我听说许多占卜师";
	mes "聚集在这里的斐扬，";
	mes "却没有人愿意告诉我任何事～";
	mes "呜啊～好伤心～";
	next;
	mes "[Kissy-Kissy]";
	mes "NyangNyangNyang~";
	mes "NyaNyangNyaNyang~";
	next;
	mes "[Kissy-Kissy]";
	mes "亲亲我～～";
	close;

OnTouch_:
	mes "[Kissy-Kissy]";
	mes "NyangNyangNyang~";
	mes "NyaNyangNyaNyang~";
	mes "亲亲我～";
	close;
}

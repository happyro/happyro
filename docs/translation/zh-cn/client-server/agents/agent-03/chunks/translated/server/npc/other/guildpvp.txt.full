//===== Current Version: ===================================== 
//= 1.1
//===== Compatible With: ===================================== 
//= rAthena Project
//===== Description: ========================================= 
//= [Official Conversion]
//= Guild Battle with PVP mechanics.
//===== Additional Comments: ================================= 
//= 1.0 First version. [L0ne_W0lf]
//= 1.1 Optimized. [Euphy]
//============================================================ 

pvp_y_room,77,85,4	script	Guild Battle Guide	105,{

	setarray .@map1X[1],7,9,16,8,20;
	setarray .@map2X[1],91,90,83,91,79;
	setarray .@mapY[1],49,49,50,49,50;

	mes "[公会战向导]";
	mes "你好吗？";
	mes "我是公会战向导，";
	mes "负责新的 PvP 地图。";
	mes "告诉我你想让我把你移动到";
	mes "哪张地图。";
	next;
	set .@i, select("地图 1:地图 2:地图 3:地图 4:地图 5");
	mes "[公会战向导]";
	mes "你选择了地图 "+.@i+".";
	mes "现在你属于哪支队伍？";
	mes "你可以选择";
	mes "队伍 1 或队伍 2。";
	next;
	set .@j, select("队伍 1:队伍 2");
	mes "[公会战向导]";
	mes "好的，我会把你移动到";
	mes "地图 "+.@i+"，作为";
	mes "队伍 "+.@j+"。准备好";
	mes "现在传送过去了吗？";
	next;
	if(select("是:否") == 2) {
		mes "[公会战向导]";
		mes "好的，希望在";
		mes "PvP 战场上";
		mes "再次见到你！";
		close;
	}
	mes "[公会战向导]";
	mes "太好了！玩得开心~";
	close2;
	warp "guild_vs"+.@i,getd(".@map"+.@j+"X["+.@i+"]"),.@mapY[.@i];
	end;
}

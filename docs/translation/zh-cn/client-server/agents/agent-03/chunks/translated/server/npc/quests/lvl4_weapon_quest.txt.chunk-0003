			mes "这是多么稀有的武器啊！对了，我记得父亲临终前告诉过我它的名字。这就是……安息日！";
			set lv4_weapon,0;
			getitem 1365,1; //Sabbath
		}
		next;
		mes "[Tabezthan]";
		mes "这把强大的武器归你所有。若你觉得我还能再次帮上忙，欢迎回来找我。";
		mes "若你愿意，随时都可以再来找我。";
		mes "暂别了，勇敢的冒险者。";
		close;
	}
	if (((lv4_weapon == 16) && (countitem(7290))) || ((lv4_weapon == 17) && (countitem(7289))) || ((lv4_weapon == 18) && (countitem(7293)))) {
		if (lv4_weapon == 16) {
			set .@itemreq,7290; //Phlogopite
		}
		else if (lv4_weapon == 17) {
			set .@itemreq,7289; //Olivine
		}
		else if (lv4_weapon == 18) {
			set .@itemreq,7293; //Rose_Quartz
		}
		mes "[Tabezthan]";
		mes "我们开始吧？";
		mes "我会告诉你四种不同魔物的名字。你有五次机会猜出我正在想哪一种。";
		next;
		mes "[Tabezthan]";
		mes "这个读心游戏能有效测出你的运势好坏。现在准备好……";
		next;
		for( set .@i, 1; .@i <= 5; set .@i,.@i+1 ) {
			setarray .@mons[.@i],rand(1,4);
			mes "[Tabezthan]";
			if (.@i == 1) {
				mes "我最喜欢的魔物是";
				mes "巴风特、黑暗领主、血腥";
				mes "骑士和暴风骑士。现在，";
				mes "试着猜猜我正在想哪一个。";
				mes "想想看。";
			}
			else if (.@i == 2) {
				mes "请试着判断";
				mes "我此刻正在想的";
				mes "是哪一种魔物。";
			}
			else if (.@i == 3) {
				mes "现在，试着感受";
				mes "我在脑海中";
				mes "想象的是哪一种魔物。";
			}
			else if (.@i == 4) {
				mes "再一次试试，";
				mes "猜猜我现在";
				mes "正在想什么魔物。";
			}
			else if (.@i == 5) {
				mes "好了，这是";
				mes "你最后一次";
				mes "正确猜出我";
				mes "正在想的魔物的机会。";
			}
			next;
			set .@answer,select("巴风特:黑暗领主:血腥骑士:暴风骑士");
			if (.@answer == .@mons[.@i]) {
				set .@dap,.@dap + 1;
			}
		}
		mes "[Tabezthan]";
		mes "游戏结束了。下面是我刚才想的魔物顺序……";
		next;
		mes "[Tabezthan]";
		for( set .@i, 1; .@i <= 5; set .@i,.@i+1 ) {
			if (.@mons[.@i] == 1) {
				mes "巴风特";
			}
			else if (.@mons[.@i] == 2) {
				mes "黑暗领主";
			}
			else if (.@mons[.@i] == 3) {
				mes "血腥骑士";
			}
			else if (.@mons[.@i] == 4) {
				mes "暴风骑士";
			}
		}
		if (.@dap > 0) {
			delitem .@itemreq,30;
			set lv4_weapon,lv4_weapon+3;
		}
		else if (.@dap < 1) {
			delitem .@itemreq,10;
		}
		next;
		mes "[Tabezthan]";
		if (.@dap > 0) {
			mes "你答对了 " + .@dap + " 次。看来你的运气正旺，现在正是我为你制作物品的好时机。给我一点准备时间，之后再回来找我。";
			close;
		}
		else if (.@dap < 1) {
			mes "很遗憾，你一个也没猜对。看来你的运气充满了负能量。我们需要用你的 10 个金云母来驱除这股霉运。";
			next;
			mes "[Tabezthan]";
			mes "不要灰心。失去 10 个"+getitemname(.@itemreq)+"，总比制作失败时失去 30 个要好。";
			next;
			mes "[Tabezthan]";
			mes "请带着 30 个金云母回来，我们再试一次这个读心游戏。我会在这里等你。";
			close;
		}
	}
	if ((lv4_weapon == 16) || (lv4_weapon == 17) || (lv4_weapon == 18)) {
		mes "[Tabezthan]";
		mes "嗯……";
		mes "你似乎没有";
		mes "足够的玫瑰石英。";
		mes "请至少收集 30 个，";
		mes "收集好之后";
		mes "再回来找我。";
		close;
	}
	if ((lv4_weapon == 15) && (countitem(969) > 9) && (countitem(999) > 49) && (countitem(714) > 9)) {
		mes "[Tabezthan]";
		mes "你比我预想的更早回来了。我感觉你带齐了基本材料，但特殊矿石也带够了吗？";
		next;
		if ((countitem(7290) > 29) || (countitem(7289) > 29) || (countitem(7293) > 29)) {
			if ((countitem(7290) > 29) && (countitem(7289) > 29) && (countitem(7293) > 29)) {
				mes "[Tabezthan]";
				mes "啊，你把三种都带来了。不过一次只能使用一种矿石，请只选择一种。";
				next;
				switch(select("金云母:橄榄石:玫瑰石英")) {
				case 1:
					set .@itemreq,7290; //Phlogopite
					break;
				case 2:
					set .@itemreq,7289; //Olivine
					break;
				case 3:
					set .@itemreq,7293; //Rose_Quartz
					break;
				}
			}
			else if ((countitem(7290) > 29) && (countitem(7289) > 29)) {
				mes "[Tabezthan]";
				mes "哈哈哈，你不用";
				mes "带来不止一种矿石。现在，";
				mes "现在你想使用哪一种？";
				mes "请做出选择。";
				next;
				switch(select("金云母:橄榄石")) {
				case 1:
					set .@itemreq,7290; //Phlogopite
					break;
				case 2:
					set .@itemreq,7289; //Olivine
					break;
				}
			}
			else if ((countitem(7290) > 29) && (countitem(7293) > 29)) {
				mes "[Tabezthan]";
				mes "哈哈哈，你不用";
				mes "带来不止一种矿石。";
				mes "现在你想使用哪一种？";
				mes "请做出选择。";
				next;
				switch(select("金云母:玫瑰石英")) {
				case 1:
					set .@itemreq,7290; //Phlogopite
					break;
				case 2:
					set .@itemreq,7293; //Rose_Quartz
					break;
				}
			}
			else if ((countitem(7289) > 29) && (countitem(7293) > 29)) {
				mes "[Tabezthan]";
				mes "哈哈哈，你不用";
				mes "带来不止一种矿石。";
				mes "现在你想使用哪一种？";
				mes "请做出选择。";
				next;
				switch(select("橄榄石:玫瑰石英")) {
				case 1:
					set .@itemreq,7289; //Olivine
					break;
				case 2:
					set .@itemreq,7293; //Rose_Quartz
					break;
				}
			}
			else {
				if (countitem(7290) > 29) {
					set .@itemreq,7290; //Phlogopite
				}
				else if (countitem(7289) > 29) {
					set .@itemreq,7289; //Olivine
				}
				else if (countitem(7293) > 29) {
					set .@itemreq,7293; //Rose_Quartz
				}
			}
			mes "[Tabezthan]";
			mes "很好，"+getitemname(.@itemreq)+"。";
			mes "现在，在开始制作之前，";
			mes "我得先确认你的运气是否足够好，";
			mes "能让我继续。";
			next;
			mes "[Tabezthan]";
			mes "我们来玩一个读心游戏，";
			mes "这样我就能测量你的运气，看它是否足够高，避免制作失败。";
			next;
			mes "[Tabezthan]";
			mes "你有 5 次机会猜出我正在想的四种最爱魔物之一。只要答对一次，我就能开始制作。";
			next;

		next;
		mes "[Tabezthan]";
		mes "让我们祈祷能有好结果。";
		mes "现在我们能做的，只有把";
		mes "最终结果交给命运。";
		next;
		mes "^3355FF材料缓缓融合";
		mes "在一起，组合成了全新的物体。";
		mes "很快我们就会知道你和塔贝兹坦究竟成功还是失败。^000000";
		next;
		mes "[Tabezthan]";
		if (lv4_weapon == 19) {
			mes "我不敢相信！";
			mes "这是多么稀有的武器啊！对了，我记得父亲临终前告诉过我它的名字。这就是……凯撒之剑！";
			set lv4_weapon,0;
			getitem 1134,1; //Scissores_Sword
		}
		else if (lv4_weapon == 20) {
			mes "我不敢相信！";
			mes "这是多么稀有的武器啊！对了，我记得父亲临终前告诉过我它的名字。这就是……提尔锋！";
			set lv4_weapon,0;
			getitem 1139,1; //Tale_Fing_
		}
		else if (lv4_weapon == 21) {

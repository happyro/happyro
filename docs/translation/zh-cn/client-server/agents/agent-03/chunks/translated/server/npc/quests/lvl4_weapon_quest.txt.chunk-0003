			delitem 999,50; //Steel
			delitem 969,10; //Gold
			delitem 714,10; //Emperium
			if (countitem(7290) > 29) {
				set lv4_weapon,16;
			}
			else if (countitem(7289) > 29) {
				set lv4_weapon,17;
			}
			else if (countitem(7293) > 29) {
				set lv4_weapon,18;
			}
			close;
		}
		else {
			mes "[Tabezthan]";
			mes "嗯……";
			mes "看来还不行。记住，开始制作前，我需要金云母、橄榄石或玫瑰石英中的任一种 30 个。";
			close;
		}
	}
	if (lv4_weapon == 15) {
		mes "[Tabezthan]";
		mes "[Tabezthan]";
		mes "带给我……";
		mes "10 个黄金、";
		mes "50 个钢铁";
		mes "以及 10 个神之金属。";
		mes "我还需要一种稀有矿石来附魔作品。";
		next;
		mes "[Tabezthan]";
		mes "另外，请带来金云母、橄榄石或玫瑰石英中的任一种 30 个。根据你选择的矿石，我的作品会拥有不同特性。";
		close;
	}
	mes "[Tabezthan]";
	mes "嗯……";
	mes "我感觉你与众不同。你是这里的新面孔，对吧？";
	next;
	mes "[Tabezthan]";
	mes "容我自我介绍。我是塔贝兹坦，乌姆巴拉名副其实的知识源泉和天才。哈哈哈！";
	next;
	mes "[Tabezthan]";
	mes "我有两个弟子：愚蠢的希比莱坦，以及相当聪明、很有潜力的巴佐。";
	next;
	mes "[Tabezthan]";
	mes "当然，他们都很有天赋也很有本领，但我很担心希比莱坦。他总是犯下愚蠢的错误，却对自己的过失毫不羞愧。";
	next;
	mes "[Tabezthan]";
	mes "我教他们操纵";
	mes "乌姆巴拉的环境能量来创造物品。听说外界也有类似的技艺，你们称之为炼金术。";
	next;
	mes "[Tabezthan]";
	mes "无论如何，你对我的技艺";
	mes "有兴趣吗？如果有，请带来我需要的材料，让我为你效劳。";
	next;
	switch(select("好的，请帮我。:不用了，谢谢。")) {
	case 1:
		if (BaseLevel < 70) {
			mes "[Tabezthan]";
			mes "很遗憾，你还没有能力承受我的作品。请先训练并获得更强的力量，再回来找我。祝你旅途平安。";
			close;
		}
		mes "[Tabezthan]";
		mes "很好。我希望你";
		mes "记住需要带来的东西，";
		mes "这样我才能为你制作物品。我需要……";
		next;
		mes "[Tabezthan]";
		mes "10 个黄金、";
		mes "50 个钢铁";
		mes "以及 10 个神之金属";
		mes "作为基本材料。";
		mes "我还需要一种稀有矿石来附魔作品。";
		next;
		mes "[Tabezthan]";
		mes "另外，请带来金云母、橄榄石或玫瑰石英中的任一种 30 个。根据你选择的矿石，我的作品会拥有不同特性。";
		next;
		mes "[Tabezthan]";
		mes "请注意，我并不知道最终会制作出什么物品。炼金术的影响因素太多，任何人的知识都有极限。";
		next;
		mes "[Tabezthan]";
		mes "换句话说，我们只能听天由命。不过之后还有时间再谈这些。现在请去收集必要的材料，我会在这里等你。";
		set lv4_weapon,15;
		close;
	case 2:
		mes "[Tabezthan]";
		mes "哦……我明白了。";
		mes "听到这个有点令人失望，不过如果你觉得我能回来";
		mes "帮上你的忙，";
		mes "请再找我。";
		close;
	}
}


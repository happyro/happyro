//===== rAthena Script =======================================
//= Imitation of Dumpling Festival
//===== By ===================================================
//= Massdriller
//===== Version ==============================================
//= 1.01
//===== Compatible With ======================================
//= rAthena Project; 0.52+
//===== Description ==========================================
//= A complete redering of the Dumpling Festival.
//===== Comments =============================================
//= Ver 1.0- Duplicate of MRO's Dumpling Event
//= 1.01 fixed bugs [Lupus]
//============================================================
  
payon,93,81,4	script	Exorcist Master Fahae	834,{

	mes "[驱魔大师法海]";
	mes "你好，年轻的战士，我是驱魔大师法海。";
	mes "我追踪难寻的白素贞已经有一段时间了。";
	next;
	mes "[驱魔大师法海]";
	mes "我觉得是时候让另一位战士尝试完成";
	mes "我的任务了。我有一些物品可以帮助你。";
	next;
	menu "我想购买",-, "不用了",M_FIN;
  
	mes "[驱魔大师法海]";
	mes "我有两件可能对你有用的物品。";
	next;
	menu "雄黄酒",-, "驱魔草",M_HERB;
  
	mes "[驱魔大师法海]";
	mes "你需要多少？";
	mes "一次最多购买 5 个。";
	mes "每个售价 20000z。";
	mes "（输入 0 取消）";
	next;
	input @input;
	if(@input==0) close;
	if(@input>5) goto L_SORRY;
	if(Zeny< @input*20000) goto L_NOZENY;
	set Zeny,Zeny-20000*@input;
	getitem 682,@input;
	mes "[驱魔大师法海]";
	mes "给你，希望你能成功完成我的任务。";
	close;
  
L_SORRY:
	mes "[驱魔大师法海]";
	mes "不要贪心，诚实才是上帝之道。";
	close;
  
M_FIN:
	mes "[驱魔大师法海]";
	mes "彻底消灭邪恶的道路还很漫长，请沿着上帝之道帮助我。";
	close;
  
M_HERB:
	mes "[驱魔大师法海]";
	mes "你需要多少？";
	mes "一次最多购买 5 个。";
	mes "每个售价 10000z。";
	mes "（输入 0 取消）";
	next;
	input @input;
	if(@input==0) close;
	if(@input>5) goto L_SORRY;
	if(Zeny< @input*10000) goto L_NOZENY;
	set Zeny,Zeny-10000*@input;
	getitem 683,@input;
	mes "[驱魔大师法海]";
	mes "给你，希望你能成功完成我的任务。";
	close;

L_NOZENY:
	mes "[驱魔大师法海]";
	mes "钱不能给所有人带来快乐，但我们需要它来支持寺庙和我自己。请试着杀死一些怪物并拾取掉落物。";
	close;
}
  

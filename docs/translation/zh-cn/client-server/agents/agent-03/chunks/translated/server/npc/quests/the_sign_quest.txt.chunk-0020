		mes "如果冒犯了你，我很抱歉。";
		mes "我知道很难让你相信什么，但请理解，我只是不希望任何人利用你。请原谅我的无礼。";
			close;
		}
	}
	else if (sign_q < 129) {
		mes "^3355FF这只是 Serin 残留的痕迹，";
		mes "是她最终记忆的显现。^000000";
		close;
	}
	else if (sign_q == 129) {
		mes "[Serin]";
		mes "...";
		mes "......";
		next;
		mes "[Serin]";
		mes "...";
		mes "......";
		mes "..........";
		if (countitem(2643) == 1) {
			next;
				switch(select("把戒指交还给 Serin。:留下戒指。")) {
			case 1:
				mes "[Serin]";
				mes "...";
				mes "......";
				mes ".............";
				next;
				mes "[Serin]";
				mes "...."+strcharinfo(0)+".....";
				mes "我不想忘记你。";
				mes "我可以忘掉对生命的执念";
				mes "以及其他所有记忆，";
				mes "但如果只能保留一段记忆，我希望是你善良的记忆。";
				next;
				mes "[Serin]";
				mes "直到现在，你依然";
				mes "对我如此温柔。谢谢你";
				mes "把戒指还给我，";
				mes "这是我最珍贵的所有物。";
				mes "谢谢你，谢谢你……";
				emotion ET_CRY;
				next;
				mes "^3355FFSerin 的声音渐渐柔和，最终归于沉默；她双眼茫然地望着前方，";
				mes "仿佛陷入了恍惚。看来她已经忘记了一切……^000000";
				next;
				mes "^3355FF但 Serin 也终于忘记了悲伤。划过她脸颊的泪痕，";
				mes "以及唇边淡淡的微笑告诉你，她对你的记忆";
				mes "将永远留在心中。^000000";
				delitem 2643,1; //Serin's_Gold_Ring_
				getexp (checkre(3))?50000:500000,0;
				close;
			case 2:
				emotion ET_CRY;
				close;
			}
		}
		else {
			emotion ET_CRY;
			close;
		}
	}
	else if (sign_q == 130) {
		mes "[Serin]";
		mes "...........";
		emotion ET_CRY;
		next;
		mes "[Serin]";
		mes "...........";
		emotion ET_THINK;
		next;
		mes "[Serin]";
		mes "...........";
		emotion ET_THINK;
		next;
		mes "[Serin]";
		mes "...........";
		emotion ET_CRY;
		close;
	}
	else if (sign_q == 131) {
		mes "[Serin]";
		mes "........";
		next;
		select("告诉我关于女巫的传闻。");
		next;
		mes "[Serin]";
		mes "我听说女巫一直藏在尼弗海姆深处，只会和通过她考验的人说话。听说她正在准备某种仪式";
		mes "以获得更强大的力量……";
		next;
		mes "[Serin]";
		mes "这几乎可怕得令人难以置信，";
		mes "但我认为她正准备仪式，";
		mes "召唤魔王——";
		mes "魔界的统治者。";
		next;
		select("魔王……？");
		mes "[Serin]";
		mes "大多数人不知道，";
		mes "但魔王来自魔界。";
		mes "在自己的领域里，他强大到连神明都畏惧。";
		next;
		mes "[Serin]";
		mes "有时魔王可以进入米德加尔特，";
		mes "但只能以仅代表其一小部分力量的形态出现。";
		next;
		mes "[Serin]";
		mes "从魔界前往米德加尔特需要太多能量。而且米德加尔特的生命力与他的力量冲突，所以魔王无法直接抵达你们的世界。";
		next;
		select("死之女王不会阻止他吗？");
		mes "[Serin]";
		mes "魔王只想要米德加尔特，";
		mes "所以死之女王并不觉得自己对尼弗海姆的统治受到威胁。";
		next;
		mes "[Serin]";
		mes "事实上，我确信她知道魔王会在米德加尔特造成成千上万的死亡，意味着她将多出成千上万的灵魂可以统治。因此阻止他对她没有好处。";
		next;
		select("那我们该怎么办……？");
		mes "[Serin]";
		mes "不论付出什么代价，";
		mes "我们都必须阻止她召唤魔王，";
		mes "保护米德加尔特免遭";
		mes "彻底毁灭。";
		next;
		mes "[Serin]";
		mes "我以前是个相当厉害的巫师，";
		mes "所以我知道她若想召唤魔王，必须在尼弗海姆画出巨大的魔法阵。";
		next;
		select("你能告诉我在哪里吗？");
		mes "[Serin]";
		mes "召唤有一些规则和条件。吉奥尔谷没有足够宽敞的地方，而尼弗海姆入口又有太多人看守……";
		next;
		mes "[Serin]";
		mes "如果是我要召唤魔王，";
		mes "大概会在城镇内部找个地方，";
		mes "以免引人注意。嗯……";
		mes "等我弄清魔法阵可能在哪里，就送你过去。";
		set sign_q,132;
		close;
	}
	else if (sign_q == 132) {
		if ($@sign_w2 == 1) {
			mes "[Serin]";
			mes "我还需要完成把你送到魔法阵的准备，";
			mes "所以请再给我一点时间……";
			close;
		}
		mes "[Serin]";
		mes "好了……";
		mes "你准备好";
		mes "出发了吗？";
		next;
		switch(select("是:还没有")) {
		case 1:
			mes "[Serin]";
			mes "好～";
			mes "我们走……";
			close2;
			set $@sign_w2,1;
			warp "que_sign01",199,36;
			end;
		case 2:
			close;
		}
	}
	else if ((sign_q < 135) || (sign_q == 199)) {
		if ($@sign_w2 == 1) {
			mes "[Serin]";
			mes "我的准备工作";
			mes "比预想中花的时间更长。";
			mes "可以请你再等一会儿吗？";
			close;
		}
		mes "^3355FFThis is just a lingering";
		mes "这是 Serin 的残留痕迹，是她灵魂与记忆的印象，";
		mes "你不知为何仍能感受到。^000000";
		next;
		switch(select("跟随痕迹。:忽略它。")) {
		case 1:
			close2;
			set sign_q,199;
			set $@sign_w2,1;
			warp "que_sign01",199,36;
			end;
		case 2:
			close;
		}
	}
	else if (sign_q < 137) {
		mes "[Serin]";
		mes "...";
		mes "......";
		mes "你、你是……";
		mes "你是谁？";
		emotion ET_THINK;
		close;
	}
	else if (sign_q > 199) {
		mes "^3355FFThis is just a lingering";
		mes "这是 Serin 的残留痕迹，是她灵魂与记忆的印象，";
		mes "你不知为何仍能感受到。";
		mes "她究竟遭遇了什么？^000000";
		if (countitem(2642) > 0) {
			next;
			mes "^33555FFSuddenly, Serin's";
			mes "金戒指发出柔和的光芒，";
			mes "随后渐渐消失。^000000";
			delitem 2642,1; //Serin's_Gold_Ring
			close;
		}
		close;
	}
	else {
		if (countitem(2642) > 0) {
			mes "[Serin]";
			mes "谢谢你……";
			emotion ET_CRY;
			delitem 2642,1; //Serin's_Gold_Ring
			next;
			mes "^3355FFYou returned";
			mes "你归还了 Serin 的金戒指。^000000";
			close;
		}
		mes "[Serin]";
		mes "...";
		mes "......";
		emotion ET_THINK;
		close;
	}
}

que_sign01,122,141,4	script	Witch#s	792,{
	callfunc "F_UpdateSignVars";
	if (checkweight(1201,1) == 0) {
		mes "- 请等一下！！ -";
		mes "- 你目前携带的物品 -";
		mes "- 太多了。 -";
		mes "- 请先减轻负重 -";
		mes "- 再来尝试。 -";
		close;
	}
	mes "[Kirkena]";
	if ((countitem(7313) == 1) && ((sign_q != 124) || (sign_q != 125) || (sign_q != 126))) {
		mes "那枚女巫徽章……";
		mes "你一定是来帮助朋友";
		mes "处理 Serin 的。你准备好";
		mes "出发了吗，"+strcharinfo(0)+"？";
		next;
		switch(select("是。:还没有……")) {
		case 1:
			switch(select("直接前往 Serin:前往 Serin 的道路")) {
			case 1:
				mes "[Kirkena]";
				mes "谢谢你的帮助。";
				mes "Serin 的威胁可能太过强大，";
				mes "不是一个冒险者";
				mes "独自一人能够应付的……";
				close2;
				warp "que_sign01",195,189;
				end;
			case 2:
				mes "[Kirkena]";
				mes "谢谢你的帮助。";
				mes "Serin 的威胁可能太过强大，";
				mes "不是一个冒险者";
				mes "独自一人能够应付的……";
				close2;
				warp "que_sign02",35,313;
				end;
			}
		case 2:
			mes "[Kirkena]";
			mes "请快一点……";
			mes "时间非常宝贵……";
			close;
		}
	}
	if (sign_q == 90) {
		if (countitem(2642) == 1) {
			mes "那个混蛋偷走了我的两本魔法书。";
			mes "你带回了其中一本，";
			mes "但另一本仍然下落不明。";
			next;
			mes "[Kirkena]";
			mes "冒险者，能请你";
			mes "帮我找回另一";
			mes "本魔法书吗？";
			set sign_sq,0;
			close;
		}
		else {
			mes "有个混蛋偷走了我的两本魔法书。";
			mes "如果你能在尼弗海姆找到他，";
			mes "把我的书带回来，我会非常感激。";
			close;
		}
	}
	else if (sign_q == 91) {
		if (countitem(7304) > 0) {
			mes "那个傻瓜偷走我的魔法书后，";
			mes "未经允许施放其中的法术，结果受到了诅咒。";
			mes "终于再次把它们拿在手里，";
			mes "我真是松了口气。";
			next;
			mes "[Kirkena]";
			mes "那么，凡人……";
			mes "你为什么来见我？";
			mes "我想你一定有什么";
			mes "想要的东西。";
			next;
			select("他让我来找你，是为了……");
			mes "[Kirkena]";
			mes "正如我所料，这一切背后";
			mes "果然另有隐情。你或许知道";
			mes "自己身在何处，但你明白";
			mes "死者为何会在这里吗？";
			next;
			mes "[Kirkena]";
			mes "这个领域收容的是";
			mes "没能证明勇气的战士。";
			mes "记住，你加入他们的行列";
			mes "还不算太晚。";
			next;
			mes "[Kirkena]";
			mes "尼弗海姆由死之女王统治。";
			mes "她有时会穿着闪耀的铠甲巡视，";
			mes "所有见到她的人都会被那威严的身影震慑。";
			next;
			mes "[Kirkena]";
			mes "现在……";
			mes "我需要你去向死之女王";
			mes "索取九界徽章。";
			next;
			select("那是什么？");
			mes "[Kirkena]";
			mes "这枚徽章是女王权威的凭证，";
			mes "代表她统治死者的";
			mes "不可否认的正当性。";
			mes "但现在我还不能解释";
			mes "为什么需要它。";
			next;
			mes "[Kirkena]";
			mes "等你把女王的徽章带来，";
			mes "我会告诉你需要它的原因。";
			mes "请保守秘密，别告诉任何人";
			mes "是我让你把徽章带来的。";
			next;
			select("我该如何取得徽章？");
			mes "[Kirkena]";
			mes "强行夺取徽章绝不可能。";
			mes "就连神明也不会考虑";
			mes "与死之女王战斗。";
			next;
			mes "[Kirkena]";
			mes "你必须赢得女王的好感，";
			mes "才有机会获得";
			mes "九界徽章。";
			next;
			mes "[Kirkena]";
			mes "有传闻说，死之女王正在寻找失踪的母亲安格尔波达。";
			mes "如果你能找到安格尔波达被封印的地方……";
			delitem 7304,1; //Witch's_Spell_Book
			set sign_q,92;
			close;
		}
		else {
			mes "嗯……？";
			mes "你为什么还没";
			mes "把我的书带回来？";
			emotion ET_HNG;
			close;
		}
	}
	else if (sign_q == 92) {
		if (rand(1,10) < 9) {
			mes "如果你想了解更多关于安格尔波达的事，";
			mes "为什么不去四处打听？我相信";
			mes "所有人都知道女王正在寻找母亲。";
			next;
			mes "[Kirkena]";
			mes "再说一次，别让任何人知道";
			mes "是我让你带来九界徽章。";
			mes "尤其不能让 Serin 知道。";
			next;
			mes "[Kirkena]";
			mes "只要我能做到，";
			mes "我就不会容忍 Serin";
			mes "待在尼弗海姆。";
			mes "如果能放逐她，我一定会做！";
			close;
		}
		else {
			mes "我几乎不愿提议这件事，";
			mes "但我觉得 Serin 可能知道";
			mes "安格尔波达的下落。";
			next;
			mes "[Kirkena]";
			mes "但记得小心接近她。";
			mes "那个 Serin 总有些不对劲……";
			close;
		}
	}
	else if (sign_q < 118) {
		mes "获得九界徽章可能几乎不可能。";
		mes "不过你我都需要它。";
		next;
		mes "[Kirkena]";
		mes "我希望你明白，徽章不只是普通凭证。";
		mes "它其实蕴含着巨大的力量……";
		close;
	}
	else if (sign_q == 118) {
		mes "九界徽章？";
		mes "你是怎么拿到的？！";
		mes "啊，你一定找到了死之女王的母亲安格尔波达，对吧？干得漂亮～";
		next;
		mes "[Kirkena]";
		mes "现在把徽章交给我，";
		mes "我就告诉你接下来该做什么。";
		next;
		switch(select("交出徽章。:不交出徽章。")) {
		case 1:
			mes "[Kirkena]";
			mes "仔细听好。既然你真的拿到了徽章，";
			mes "我相信只有你能完成接下来的任务。";
			next;
			mes "[Kirkena]";
			mes "我们要用这枚徽章制造某样东西，";
			mes "但还需要最后一件物品。";
			mes "我需要你找一件";
			mes "带有 Serin 气息的东西。";
			next;
			mes "[Kirkena]";
			mes "Serin 已经藏在尼弗海姆深处，";
			mes "但只要找到她残留的痕迹，";
			mes "我相信你就能找到那件东西。";
			delitem 7305,1; //Authority_Of_Nine_World
			set sign_q,119;

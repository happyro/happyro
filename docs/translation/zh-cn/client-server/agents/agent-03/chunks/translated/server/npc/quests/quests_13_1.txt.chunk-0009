				mes "捕虫草已经进化，";
				mes "变得更强、更加";
				mes "具有攻击性，都是因为这片";
				mes "贫瘠的环境。";
				next;
				mes "[鲁米斯·布洛克]";
				mes "我想知道祖先们是如何";
				mes "分散到";
				mes "两个不同世界的……";
				next;
				mes "[鲁米斯·布洛克]";
				mes "也许他们穿过了";
				mes "世界树 Yggdrasil？";
				mes "也许它与";
				mes "其他生物（比如魔王梦罗克）一起";
				mes "穿越了时间";
				mes "与空间。";
				next;
				mes "[鲁米斯·布洛克]";
				mes "这个物种的特征是……";
				next;
				mes "[鲁米斯·布洛克]";
				mes "哦，瞧我这礼数！";
				mes "抱歉，刚才讲了些";
				mes "学术废话，让你觉得无聊了……";
				mes "我们聊点";
				mes "别的吧，好吗？";
				next;
				mes "[鲁米斯·布洛克]";
				mes "你觉得……";
				mes "我哥哥看到这份捕虫草";
				mes "样本会高兴吗？";
				mes "你知道，捕虫草是";
				mes "植物魔物，而这正是";
				mes "我哥哥的专长。";
				next;
				mes "[鲁米斯·布洛克]";
				mes "请把这份样本交给泰瑞斯·布洛克。";
				mes "他就在远征营地附近。";
				mes "不用担心，你不必留下看我哥哥的反应……如果反应很糟的话。";
				next;
				mes "[鲁米斯·布洛克]";
				mes "- 你收到了 -";
				mes "- 捕虫草样本 -";
				mes "- 来自鲁米斯·布洛克。-";
				delitem 713,1; //Empty_Bottle
				delitem 523,5; //Holy_Water
				delitem 938,30; //Sticky_Mucus
				set ep13_animal,4;
				changequest 2148,2149;
				close;
			}
			else {
				mes "[鲁米斯·布洛克]";
				mes "为了制作样本工具，";
				mes "我需要 ^3131FF1 个空瓶、5 瓶圣水和 30 个黏稠液体^000000。";
				next;
				mes "[鲁米斯·布洛克]";
				mes "你知道我要什么，对吧？先谢谢你了。";
				close;
			}
		}
		else if ((ep13_animal > 3) && (ep13_animal < 10)) {
			mes "[鲁米斯·布洛克]";
			mes "你把捕虫草样本交给我哥哥泰瑞斯了吗？";
			mes "他在营地东边。";
			close;
		}
		else if (ep13_animal == 10) {
			mes "[Rumis Block]";
			mes "...Welcome back.";
			mes "哦，你不用告诉我哥哥说了什么，";
			mes "因为他那边已经有人来过了。他的报告给管理层留下了深刻印象，对吧？";
			next;
			mes "[Rumis Block]";
			mes "是啊，那就是我的哥哥……";
			next;
			mes "[Rumis Block]";
			mes "...Anyways, one of the soldiers that captured Nepentheses for me has given me some interesting information.";
			next;
			mes "[Rumis Block]";
			mes "他在东桥那边发现了一种新型魔物。";
			next;
			mes "[Rumis Block]";
			mes "根据他的描述，那只魔物疑似属于长毛猫科。我很想亲眼看看，但……";
			next;
			mes "[Rumis Block]";
			mes "如你所知，我还没准备好面对这个世界的任何魔物……";
			next;
			mes "[Rumis Block]";
			mes "我研究那个物种时，你能保护我吗？";
			mes "求求你了！";
			next;
			switch(select("好吧。:不。")) {
			case 1:
				mes "[Rumis Block]";
				mes "哇，谢谢！";
				mes "那我最好马上收拾东西……";
				next;
				mes "[Rumis Block]";
				mes "不会花太久。请你先去东桥那边等我，好吗？";
				mes "别……别离桥太远！";
				set ep13_animal,11;
				changequest 2153,2154;
				close;
			case 2:
				emotion ET_CRY;
				mes "[Rumis Block]";
				mes "哦…………";
				close;
			}
		}
		else if (ep13_animal == 11) {
			mes "[Rumis Block]";
			mes "我会收拾好东西跟上你。请去右侧的桥那边等我，好吗？";
			mes "别……别离桥太远！";
			close;
		}
		else if (ep13_animal == 12) {
			mes "- Rumis is hurriedly packing his stuff. -";
			close;
		}
		else if (ep13_animal == 13) {
			mes "[Rumis Block]";
			mes "......";
			next;
			mes "[Rumis Block]";
			mes "听说灰烬真空里栖息着一种极其聪明的生物。";
			next;
			mes "[Rumis Block]";
			mes "一名探险者越过右侧的桥去寻找木材。在黑暗中，一个巨大的东西从远处向他冲来。";
			next;
			mes "[Rumis Block]";
			mes "他恢复意识后，地上只剩下一顶三角帽。";
			next;
			mes "[Rumis Block]";
			mes "这顶三角帽的编织方式从未在米德加尔特出现过，材质也无法辨认。";
			next;
			mes "[Rumis Block]";
			mes "这是否意味着这里居住着另一种人类？他们是妖精，还是别的什么？";
			next;
			mes "[Rumis Block]";
			mes "如果他们发现了我们，想把我们赶走呢……哇！";
			next;
			mes "[Rumis Block]";
			mes "光是想想他们就让我脊背发凉！请去右侧桥尽头的土地看看那里住着什么种族，好吗？";
			mes "我想知道他们对我们友好还是敌对。";
			set ep13_animal,14;
			changequest 2156,2157;
			close;
		}
		else if (ep13_animal == 14) {
			if (checkquest(2157,HUNTING) == 2) {
				mes "[Rumis Block]";
				mes "欢迎回来。你查到他们的情况了吗？";
				next;
				mes "["+strcharinfo(0)+"]";
				mes "好，让我看看……";
				next;
				while(1) {
					mes "["+strcharinfo(0)+"]";
					mes "三角帽的主人";
					mes "是一种叫作……的魔物";
					input .@input$;
					if (compare(.@input$,"Tatacho")) {
						mes "^FF0000Tatacho^000000";
						next;
						break;
					}
					else {
						next;
						mes "["+strcharinfo(0)+"]";
						mes ""+.@input$+"...? I don't think that was the name...";
						next;
					}
				}
				mes "["+strcharinfo(0)+"]";
				mes "塔答丘的体型大约是……";
				input .@input$;
				mes "^3131FF"+.@input$+"^000000, I guess...";
				next;
				mes "["+strcharinfo(0)+"]";
				mes "塔答丘通常坐在地上，但天气寒冷导致体温过低时，它们会四处打滚。";
				next;
				mes "["+strcharinfo(0)+"]";
				mes "关于那顶三角帽，根据它们的外貌和行动模式，我得出结论：它们一点也不活跃或有生产力：";
				next;
				mes "["+strcharinfo(0)+"]";
				mes "它们不够聪明，无法制作那样精巧的帽子。";
				next;
				mes "[Rumis Block]";
				mes "......";
				mes "你现在听起来像我了……看来我的学术说话方式影响了你。哦，我不是说这不好，但是……";
				next;
				mes "[Rumis Block]";
				mes "总之，按照你的结论，那顶帽子一定是别人送给它们的，或者是其他生物丢下后被它们捡到的。";
				mes "感谢你提供如此宝贵的信息。";
				mes "这些足够写一份报告了。";
				next;
				mes "[Rumis Block]";
				mes "我应该写一份简短报告提交给管理层。希望后来的魔物学者能更好地研究它们。";
				next;
				mes "[Rumis Block]";
				mes "我的祖国施瓦茨瓦尔德共和国有很多寒冷的地方，但没有一处像这里这么冷。这种天气冻僵了我的感官，也消磨了我对研究的热情。";
				mes "我要比营地里任何人都更快回家。我已经厌倦了这个世界……";
				next;
				mes "[Rumis Block]";
				mes "..."+strcharinfo(0)+", I thank you so much for helping me despite my self-centered behavior.";
				mes "我真的非常感谢。";
				next;
				mes "[Rumis Block]";
				mes "回家后我会尽快报答你的恩情。";
				mes "希望你能凭借伟大的成就在灰烬真空声名远扬。";
				set ep13_animal,15;
				completequest 2157;
				getexp (checkre(3))?100000:150000,0;
				close;
			}
			else {
				mes "[Rumis Block]";
				mes "请去右侧桥尽头看看那里住着什么种族，好吗？我想知道他们对我们友好还是敌对。";
				close;
			}
		}
		else if (ep13_animal == 15) {
			if (countitem(6033) > 0) {
				mes "["+strcharinfo(0)+"]";
				mes "鲁米斯先生！快看看这个！";
				next;
				mes "[鲁米斯·布洛克]";
				mes "……哦，你好。";
				mes "我非常沮丧。上次没能回家让我感到无能为力……";
				next;
				mes "["+strcharinfo(0)+"]";
				mes "我在斯普兰迪德地区的魔物身上发现了这只角。";
				mes "那只魔物很神秘，身体上覆盖着草。";
				next;
				mes "[鲁米斯·布洛克]";
				mes "哦……覆盖着草？";
				mes "……我知道你很兴奋，但这对我来说没什么趣。抱歉。";
				next;
				mes "[鲁米斯·布洛克]";
				mes "让我看看这只角。";
				next;
				mes "[鲁米斯·布洛克]";
				mes "嗯。";
				next;
				mes "[鲁米斯·布洛克]";
				mes "呃……";
				next;
				mes "[鲁米斯·布洛克]";
				mes "咦……？";
				next;
				mes "[鲁米斯·布洛克]";
				mes "……真了不起。";
				mes "……这只角和栖息在马努克地区的山脉兽角非常相似。";
				next;
				mes "[Rumis Block]";
				mes "不知道它们是否有关联，";
				mes "还是这是一只进化后的山脉兽。";
				next;
				mes "["+strcharinfo(0)+"]";
				mes "啊，也有可能是环境造成的变异。";
				next;
				mes "[鲁米斯·布洛克]";
				mes "……你是什么意思？";
				mes "你是说这只魔物因环境而发生了变异？";
				next;
				mes "["+strcharinfo(0)+"]";
				mes "嗯，也不是没有可能，对吧？哈哈！";
				next;
				mes "- 你把从植物学家泰瑞斯那里听到的消息告诉鲁米斯：有些植物已经出现变异迹象。-";
				next;
				mes "[鲁米斯·布洛克]";
				mes "哦，真有趣。";
				mes "如果真有这样的装置，向魔物注入特殊能量，就可能导致异常生长。";
				next;
				mes "[鲁米斯·布洛克]";
				mes "对了，是谁想出了那个装置？";
				next;
				mes "["+strcharinfo(0)+"]";
				mes "我完全不知道。哈哈！";
				next;
				mes "[鲁米斯·布洛克]";
				mes "我明白了……";
				mes "由人造装置造成的变异体……那么除了藤蔓狮鹫，可能还有更多变异生物。";
				next;
				mes "[鲁米斯·布洛克]";
				mes "……现在我非常好奇。";
				mes "但是……我想回家……如果管理层命令我回去，研究它们也没有意义。";
				next;
				mes "[鲁米斯·布洛克]";
				mes "我想我哥哥真的喜欢这里。";
				mes "他一直努力研究这里的一切……";
				next;
				mes "[鲁米斯·布洛克]";
				mes "不是所有人都能过一样的生活。";
				mes "我只希望他能更理解我……";
				next;
				mes "[鲁米斯·布洛克]";
				mes "我不知道米德加尔特的人会不会欢迎我回去。";
				mes "多亏了你，我至少有一些有趣的故事可以告诉他们。";
				next;
				mes "[鲁米斯·布洛克]";
				mes "如果你打算继续留在这里，请帮助我哥哥进行研究。";
				mes "等这里完全探索和开发后，我可能会再回来……";
				next;
				mes "- 鲁米斯·布洛克腼腆地笑着请你握手，然后匆忙转身离开。-";
				next;
				mes "- 你真心希望鲁米斯能够回到家乡。-";
				set ep13_animal,100;
				delitem 6033,1; //Horn_Of_Tendrilion
				getexp (checkre(3))?50000:100000,0;
				close;
			}
			else {
				mes "[鲁米斯·布洛克]";
				mes "……我已经向管理层提交了报告，但他们还没有命令我回家……";
				mes "……*叹气* 看来事情没有我想的那么简单。";
				close;
			}
		}
		else if (ep13_animal == 100) {
			mes "- 鲁米斯看起来焦虑而心不在焉。-";
			close;
		}
		else {
			mes "[鲁米斯·布洛克]";
			mes "我什么时候才能回米德加尔特……？*叹气*";
			close;
		}
	}
}

mid_camp,240,270,3	script	Botanist#ep13	750,{
	if (ep13_ryu < 100 && ep13_start < 100) {
		mes "[Botanist]";
		mes "这片新土地！";
		mes "未被发现的生命！";
		mes "这个世界的一切都让我兴奋。";
		next;
		emotion ET_BIGTHROB;
		mes "[植物学家]";
		mes "哦，好吧……啊哈！";
		mes "原来是这样……";
		close;
	}
	else {
		if (ep13_animal < 4) {
			mes "[植物学家]";
			mes "这片新土地！";
			mes "未被发现的生命！";
			mes "这个世界的一切都让我兴奋。";
			next;
			emotion ET_BIGTHROB;
			mes "[植物学家]";
			mes "哦，好吧……啊哈！";
			mes "原来是这样……";
			close;
		}
		else if (ep13_animal == 4) {
			mes "这片新土地！";
			mes "未被发现的生命！";
			mes "这个世界的一切都让我兴奋。";
			next;
			emotion ET_BIGTHROB;
			emotion ET_THINK, playerattached();
			mes "[植物学家]";
			mes "哦，好吧……啊哈！";
			mes "原来是这样……";
			next;
			switch(select("表达你的不满。:同意他的说法。")) {
			case 1:
				mes "["+strcharinfo(0)+"]";
				mes "你的兴奋让我烦躁。";
				next;
				mes "[植物学家]";
				mes "咦？啊哈哈哈！";
				mes "拜托，我只是太开心了。";
				mes "对了，有什么我能帮你的吗？";
				next;
				break;
			case 2:
				emotion ET_BIGTHROB, playerattached();
				mes "["+strcharinfo(0)+"]";
				mes "我同意。这里有好多东西可以看！";
				next;
				mes "[植物学家]";
				mes "啊哈哈哈！";
				mes "很高兴认识你，我的朋友。";
				mes "那么，有什么我能帮你的吗？";
				next;
				break;
			}
			mes "["+strcharinfo(0)+"]";
			mes "你哥哥让我把这个交给你。也许对你的研究有帮助。";
			next;
			mes "- 你把捕虫草样本交给了植物学家。-";
			next;
			emotion ET_STARE;
			mes "[植物学家]";
			mes "哦……这不是？！";
			next;
			emotion ET_HUK, playerattached();
			mes "[植物学家]";
			mes "……嗯，我已经有一大堆这种样本了。抱歉。";
			next;
			mes "- 他指向帐篷里的一堆样本。-";
			next;
			mes "[植物学家]";
			mes "不过我还是很佩服。我一直以为哥哥什么都做不好。但你看，他竟然收集到了捕虫草样本。";
			next;
			mes "[植物学家]";
			mes "话说回来，我强烈感觉有人帮助了他。";
			mes "那个人大概就是你，对吧？～";
			next;
			mes "[植物学家]";
			mes "不管怎样，我不在乎。";
			mes "我只为他关心我而高兴……";
			next;
			mes "["+strcharinfo(0)+"]";
			mes "你为什么这么想？";
			mes "你不能感谢他努力帮助你吗？";
			next;
			mes "[植物学家]";
			mes "你一定忘了我和他是双胞胎。";
			mes "我们的精神彼此相连。";
			next;
			mes "[植物学家]";
			mes "双胞胎通常共享相同的感受和想法，只要我努力，就能看到他做什么或想什么。";
			next;
			emotion ET_OHNO;
			mes "[植物学家]";
			mes "让我看看鲁米斯现在在做什么……哦，他正用左手抠鼻子，右手吃面包。";
			mes "天啊，真恶心！";
			next;
			switch(select("去确认鲁米斯是否如此。:别相信他的话。")) {
			case 1:
				emotion ET_SMILE;
				mes "[植物学家]";
				mes "哈哈哈！";
				mes "呜哈哈哈！";
				mes "让我猜猜，你想去确认鲁米斯是不是那样，看看我说的是不是真的。对吗？";
				mes "哈哈哈哈！抱歉，我撒谎了。远程视觉？就因为我们是双胞胎？";
				next;
				mes "[植物学家]";
				mes "天啊，你真有趣。哈哈哈～";
				mes "你让我很开心，就像世界树上绽放的新生物一样～";
				next;
				break;
			case 2:
				emotion ET_OHNO;
				mes "[植物学家]";
				mes "哦，";
				mes "你就不能放过我吗？我只是开个玩笑活跃气氛。";
				mes "这个世界太贫瘠、太艰苦了，没有幽默和玩笑可活不下去，你知道吗？";
				next;
				break;
			}
			emotion ET_HNG;
			mes "[Botanist]";
			mes "总之，正如我所说，我有很多捕虫草样本。";
			mes "不过我还是会感激地收下他这份自命不凡的礼物。";
			next;
			mes "[Botanist]";
			mes "这问题可能有点突然，但是……你想见见在原野上玩耍的危险女孩吗？";
			next;
			select("危险女孩？");
			mes "[Botanist]";
			mes "没错，蛇蝎美人！";
			mes "我见过非常美丽的女孩。";
			mes "她们危险得无法接近，但正因如此才令人无法抗拒。你明白我的意思吗？";
			next;
			select("这……很难说。");
			mes "[Botanist]";
			mes "你探索过联合远征营地右侧桥梁另一边的区域吗？";
			mes "你会发现那里冷得能瞬间冻结你的心。";
			next;
			mes "[Botanist]";

		close;
	}
	if (zdan_edq == 11) {
		mes "[Marybell]";
		mes "嘿，我一直在找你！派往科莫多的一名盗贼从 Z Gang 线人身上找到这封信。可能是线索！";
		next;
		mes "[Marybell]";
		mes "奇怪的是，线人拼命保护一张白纸……但我们知道事情没那么简单，对吧？";
		next;
		mes "[Marybell]";
		mes "他们一定用了某种秘密隐形墨水。我把纸交给专业解码员破解，他现在应该完成了。总之……";
		next;
		mes "[Marybell]";
		mes "我想你也许想去找他，看看是否完成了。他叫 Gooho Ahn，在斐扬，是王国最优秀的解码员之一。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "Gooho Ahn？为什么我觉得应该认识这个名字？好熟悉……";
		next;
		mes "[Marybell]";
		mes "我想是因为 Gooho 是 Moonho 的弟弟，你曾经打败过那位传奇赌徒。";
		next;
		mes "[Marybell]";
		mes "呃，现在重要的不是这个。你能去找 Gooho Ahn，看看他发现了什么吗？";
		changequest 3128,3129;
		set zdan_edq,12;
		close;
	}
	if ((zdan_edq > 11) && (zdan_edq < 14)) {
		mes "[Marybell]";
		mes "嘿，为什么不去斐扬找 Gooho Ahn，问问他是否已经完成了 Z Gang 秘密信件的解码？";
		close;
	}
	if (zdan_edq == 14) {
		mes "[Marybell]";
		mes "哦，Gooho 解读了全部内容？让我看看……是关于禁忌之谜之书的……啊，有了！Z Gang 据点的位置！嘿嘿！我们抓到他们了！";
		next;
		mes "[Marybell]";
		mes "一名盗贼跟踪了携带这封信的线人，但追捕中他突然消失了……我猜是魔法。所以我们不知道据点的确切位置。";
		next;
		mes "[Marybell]";
		mes "即便如此，我们确定它在通往梦罗克南部地下区域的秘密道路附近。不过，我们不能让你和盗贼公会一起行动。";
		next;
		mes "[Marybell]";
		mes "抱歉，我知道这是公务之类的。这样吧，我们分头追捕，谁先找到他们，谁就先揍他们！";
		changequest 3131,3132;
		set zdan_edq,15;
		close;
	}
	if ((zdan_edq > 14) && (zdan_edq < 18)) {
		mes "[Marybell]";
		mes "我们确定 Z Gang 据点在通往梦罗克南部地下区域的秘密道路附近。你知道在哪里吗？";
		next;
		mes "[Marybell]";
		mes "这样吧，我们分头追捕，谁先找到他们，谁就先揍他们！";
		close;
	}
	if (zdan_edq > 18) {
		mes "[Marybell]";
		mes "干得好！你抓住了 Z Gang！王国一定给了你丰厚奖励吧？";
		next;
		mes "[Marybell]";
		mes "Valdes 很想亲自抓住他们，但听到这个消息一定很高兴。也许之后我和他可以喝一杯庆祝。";
		next;
		mes "[Marybell]";
		mes "嘿，和你合作真是刺激，太刺激了。以后为了正义，我们也许还能再次组队，对吧？";
		close;
	}
	if (BaseJob == Job_Thief) {
		mes "[Marybell]";
		mes "Z Gang 一直让盗贼公会头疼。没人能从我们手里逃走！没人！但是……他们不知怎么做到了。";
		next;
		mes "[Marybell]";
		mes "这里没什么值得你感兴趣的，不过想看的话随意。";
		close;
	}
}


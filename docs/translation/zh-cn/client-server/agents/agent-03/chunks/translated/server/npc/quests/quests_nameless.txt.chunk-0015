		mes "你是怎么打败他的？上次他把我的钱全赢走了！你能打败那家伙，一定是个天才。嘿，我低估你了。";
		next;
		mes "[Marybell]";
		mes "等等，在此之前，我得告诉大家有人打败了白色流星。他们绝对不会相信！";
		close;
	}
	if (zdan_edq == 8) {
		mes "[Marybell]";
		mes "我答应过告诉你 Z Gang 的情报，所以会信守承诺。你想问什么？";
		next;
		while(1) {
			switch(select("Z Gang 的目标:Z Gang 最近的动向:Z Gang 的据点:谢谢情报！")) {
			case 1:
				mes "[Marybell]";
				mes "其实我不知道他们计划做什么，但显然不是什么好事。我个人觉得，他们只是想尽可能骚扰别人。";
				next;
				mes "[Marybell]";
				mes "我想，凭那本禁忌之谜之书可以征服世界，但我不认为他们有那么……精明。";
				next;
				set .@a,.@a+1;
				break;
			case 2:
				mes "[Marybell]";
				mes "最近一连串盗窃案都是 Z Gang 干的。他们只偷钻石、红宝石、翡翠之类的珠宝。不知道为什么……";
				next;
				set .@b,.@b+1;
				break;
			case 3:
				mes "[Marybell]";
				mes "我们不知道他们藏在哪里。要是知道，Z Gang 早就被抓了！他们甚至从我们盗贼手里逃脱。疯狂吧？";
				next;
				mes "[Marybell]";
				mes "盗贼公会有最好的情报网络，所以……Z Gang 可能在所有城镇都有线人。只有这样他们才能逃过我们。";
				next;
				mes "[Marybell]";
				mes "嘿，我们可以利用这一点……抓住一个线人，他就会说出 Z Gang 的藏身处。值得一试，对吧？";
				next;
				set .@c,.@c+1;
				break;
			case 4:
				if ((.@a > 0) && (.@b > 0) && (.@c > 0)) {
					mes "[Marybell]";
					mes "哦，还有一件事……听说他们正试图在梦罗克秘密招募更多成员。那些家伙真大胆……！";
					next;
					mes "[Marybell]";
					mes "你最好去梦罗克调查一下。祝你找到那些 Z Gang 家伙。保重！";
					changequest 3125,3126;
					set zdan_edq,9;
					close;
				}
				else {
					mes "[Marybell]";
					mes "嘿，我愿意告诉你我知道的一切。你经历了这么多麻烦，肯定有一大堆问题！";
					next;
				}
				break;
			}
		}
	}
	if ((zdan_edq > 8) && (zdan_edq < 11)) {
		mes "[Marybell]";
		mes "哦，还有一件事……听说他们正试图秘密招募更多";
		mes "在梦罗克招募成员。那些家伙真大胆……！";
		next;
		mes "[Marybell]";

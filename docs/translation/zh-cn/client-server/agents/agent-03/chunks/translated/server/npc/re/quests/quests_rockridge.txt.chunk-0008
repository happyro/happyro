			mes "哦，你不愿意。*咂嘴*真令人失望！";
			close;
		}
		mes "[Steel Vigilante]";
		mes "啊，原来你不像我想的那么势利。";
		next;
		mes "[Steel Vigilante]";
		mes "要让Rock Ridge成为交通枢纽，周围的怪物必须被清除，但我们找不到合适的人选。";
		next;
		select("这些人呢？");
		mes "[Steel Vigilante]";
		mes "*哼*这些人？我们本以为他们够强，直到发现外面的怪物有多厉害。";
		next;
		mes "[Steel Vigilante]";
		mes "这些人没一个能活着回来，更别说赚取报酬了。我们还得出去收集他们的遗体，那对我们来说更糟。";
		next;
		mes "[Steel Vigilante]";
		mes "后来我看到了你，你就像羊群中的狼一样醒目。也就是说，你通过了！恭喜！";
		next;
		select("我从没说过想和你一起工作。");
		mes "[Steel Vigilante]";
		mes "啊，别这样。帮帮我这个可怜人吧。";
		next;
		if (select( "好吧。", "让我想想。" ) == 2) {
			mes "[Steel Vigilante]";
			mes "好吧，好吧。如果你忙我理解。但我提供的是对双方都有好处的事。";
			next;
		}
		mes "[Steel Vigilante]";
		mes "我给你看看能为我们做的事？如果感兴趣，之后再回来。我保证会慷慨付酬。";
		setquest 12389;// Guardian of Rock Ridge
		completequest 12389;// Guardian of Rock Ridge
		close;
	}
	switch( checkquest(12390,PLAYTIME) ) {
	case -1:
		break;
	case 0:
	case 1:
		mes "[Steel Vigilante]";
		mes "最糟糕的时期过去了。我还会需要你的帮助。在那之前保存体力，好吗？";
		close;
	case 2:
		erasequest 12390;
		break;
	}
	for ( .@quest_id = 12391; .@quest_id <= 12396 && isbegin_quest(.@quest_id) == 0; .@quest_id++ )
		continue;
	if (.@quest_id > 12396) {
		.@quest_id = rand(12391,12396);
		setquest .@quest_id;
	}
	else {
		mes "[Steel Vigilante]";
		mes "你忘了要做什么吗？那我再告诉你一次。";
		next;
	}
	if (checkquest(.@quest_id,HUNTING) < 2) {
		switch(.@quest_id) {
		case 12391:// Buffaloes with Rifles
			mes "[Steel Vigilante]";
			mes "附近田野最大的威胁是Buffalo强盗。他们聪明而残酷，不讲道理。";
			next;
			mes "[Steel Vigilante]";
			mes "他们还时不时入侵村子，仿佛在测试我们能坚持多久。";
			next;
			mes "[Steel Vigilante]";
			mes "我们要杀鸡儆猴，控制他们。消灭^0000ff15名持枪的Buffalo强盗^000000。";
			break;
		case 12392:// Punishing the Red Masks
			mes "[Steel Vigilante]";
			mes "附近田野最大的威胁是Buffalo强盗。他们聪明而残酷，不讲道理。";
			next;
			mes "[Steel Vigilante]";
			mes "他们还时不时入侵村子，仿佛在测试我们能坚持多久。";
			next;
			mes "[Steel Vigilante]";
			mes "我们要杀鸡儆猴，控制他们。消灭^0000ff15名戴红色面具的Buffalo强盗^000000。";
			break;
		case 12393:// Eye Patch Desperadoes
			mes "[Steel Vigilante]";
			mes "附近田野最大的威胁是Buffalo强盗。他们聪明而残酷，不讲道理。";
			next;
			mes "[Steel Vigilante]";
			mes "他们还时不时入侵村子，仿佛在测试我们能坚持多久。";
			next;
			mes "[Steel Vigilante]";
			mes "我们要杀鸡儆猴，控制他们。消灭^0000ff15名戴眼罩的Buffalo强盗^000000。";
			break;
		case 12394:// Exterminate Gray Four-legged Beasts
			mes "[Steel Vigilante]";
			mes "你忘了要做什么吗？那我再告诉你一次。";
			next;
			mes "[Steel Vigilante]";
			mes "Cacti和村民关系很好，最近通往他们村子的路上出现了更多郊狼。";
			next;
			mes "[Steel Vigilante]";
			mes "郊狼并不主动攻击，但仍妨碍Cacti自由进出村子。";
			next;
			mes "[Steel Vigilante]";
			mes "请猎杀^0000ff20只郊狼^000000，帮助我们的朋友。";
			break;
		case 12395:// Exterminate Swamp Arclouzes
			mes "[Steel Vigilante]";
			mes "派到村庄地下室的工人接连失踪，所以我们展开调查。我们认为他们被怪物杀害了。";
			next;
			mes "[Steel Vigilante]";
			mes "沼泽弧角虫是生活在那里的快速食肉昆虫，数量增长得惊人，工人现在都不愿下去工作。";
			next;
			mes "[Steel Vigilante]";
			mes "如果你要去那里，请消灭10只^0000ff沼泽弧角虫^000000。";
			break;
		case 12396:// Exterminate Brown Rats
			mes "[Steel Vigilante]";
			mes "地下室失踪工人的尸体被找到了。他们被严重肢解，连家人都难以辨认。";
			next;
			mes "[Steel Vigilante]";
			mes "我认为他们是被在地下室繁衍的棕鼠杀害的。传闻它们甚至攻击活人，如果属实，问题就严重了。";
			next;
			mes "[Steel Vigilante]";
			mes "如果你要去地下室，请消灭10只^0000ff棕鼠^000000。";
			break;
		}
		close2;
		donpcevent "#r_q1::OnEnable";
		end;
	}
	switch(.@quest_id) {
	case 12391:// Buffaloes with Rifles
		getexp 23745,22935;
		.@mob_id = 3736;
		break;
	case 12392:// Punishing the Red Masks
		getexp 21645,20595;
		.@mob_id = 3737;
		break;
	case 12393:// Eye Patch Desperadoes
		getexp 27105,25785;
		.@mob_id = 3738;
		break;
	case 12394:// Exterminate Gray Four-legged Beasts
		getexp 37040,35140;
		.@mob_id = 3739;
		break;
	case 12395:// Exterminate Swamp Arclouzes
		getexp 8640,9030;
		.@mob_id = 3787;
		break;
	case 12396:// Exterminate Brown Rats
		getexp 6810,7230;
		.@mob_id = 3788;
		break;
	}
	getitem 25250,2;// Coin_Of_Rr
	erasequest .@quest_id;
	setquest 12390;// Relieved for Now
	mes "[Steel Vigilante]";
	mes "你真厉害！没想到你真的能做到！谢谢！";
	close;
}

harboro1,357,152,3	script	Steel Vigilante#2	4_M_ACROSS,{
	disable_items;
	if (checkweight(1201,1) == 0) {
		mes "我携带的物品种类太多，应该先减轻负重。";
		close;
	}
	if ((MaxWeight - Weight) < 10000) {
		mes "我超重了，最好先减轻负重。";
		close;
	}
	if (BaseLevel < 140) {
		mes "[Steel Vigilante]";
		mes "哈哈，谢谢你的兴趣，但我们还没窘迫到需要你这样的小孩子帮忙。";
		next;
		mes "^0000ff你必须达到140级或以上才能接取此任务。^000000";
		close;
	}
	if (isbegin_quest(12389) != 2) {
		mes "[Steel Vigilante]";
		mes "嗯？你不是我们的人。如果想找工作，就去别处看看。";
		close;
	}
	switch( checkquest(12398,PLAYTIME) ) {
	case -1:
		break;
	case 0:
	case 1:
		mes "[Steel Vigilante]";
		mes "你很不错。我很愿意再次和你合作。";
		close;
	case 2:
		erasequest 12398;
		break;
	}
	for ( .@quest_id = 12399; .@quest_id <= 12402 && isbegin_quest(.@quest_id) == 0; .@quest_id++ )
		continue;
	if (.@quest_id > 12402) {
		mes "[Steel Vigilante]";
		mes "你很强。能处理困难的事情吗？";
		next;
		if (select( "当然，为什么不？", "让我想想。" ) == 2) {
			mes "[Steel Vigilante]";
			mes "好，慢慢想。";
			close;
		}
		.@quest_id = rand(12399,12402);
		setquest .@quest_id;
	}
	else {
		.@no_npctalk = true;
		mes "[Steel Vigilante]";
		mes "你忘了要做什么吗？那我再告诉你一次。";
		next;
	}
	if (checkquest(.@quest_id,HUNTING) < 2) {
		switch(.@quest_id) {
		case 12399:// Hunt Heinous Criminals
			mes "[Steel Vigilante]";
			mes "精英Buffalo强盗是Buffalo强盗中的首领，这次任务与他们有关。";
			next;
			mes "[Steel Vigilante]";
			mes "你以前对付过持枪的Buffalo强盗吧？那一定见过拥有^0000ff发光蓝眼睛^000000的。";
			next;
			mes "[Steel Vigilante]";
			mes "他们是持枪Buffalo强盗中的中层军官。我想让你消灭10名^0000ff拥有发光蓝眼睛的持枪Buffalo强盗^000000。";
			close2;
			if (!.@no_npctalk)
				npctalk "热心求职者：要去猎杀持枪Buffalo强盗吗？请让我加入。", "Enthusiastic Job Seeker#11";
			end;
		case 12400:// Hunt Heinous Criminals
			mes "[Steel Vigilante]";
			mes "精英Buffalo强盗是Buffalo强盗中的首领，这次任务与他们有关。";
			next;
			mes "[Steel Vigilante]";
			mes "你以前对付过戴面具的Buffalo强盗吧？那一定见过戴^0000ff绿色面具^000000的。";
			next;
			mes "[Steel Vigilante]";
			mes "他们是戴面具Buffalo强盗中的中层军官。我想让你消灭10名^0000ff戴绿色面具的Buffalo强盗^000000。";
			close2;
			if (!.@no_npctalk)
				npctalk "热心求职者：要去猎杀戴面具的Buffalo强盗吗？请让我加入。", "Enthusiastic Job Seeker#11";
			end;
		case 12401:// Hunt Heinous Criminals
			mes "[Steel Vigilante]";
			mes "精英Buffalo强盗是Buffalo强盗中的首领，这次任务与他们有关。";
			next;
			mes "[Steel Vigilante]";
			mes "你以前对付过戴眼罩的Buffalo强盗吧？那一定见过穿^0000ff浅绿色背心^000000的。";
			next;
			mes "[Steel Vigilante]";
			mes "他们是持剑Buffalo强盗中的中层军官。我想让你消灭10名^0000ff戴眼罩并穿浅绿色背心的Buffalo强盗^000000。";
			close2;
			if (!.@no_npctalk)
				npctalk "热心求职者：要去猎杀戴眼罩的Buffalo强盗吗？请让我加入。", "Enthusiastic Job Seeker#11";
			end;
		case 12402:// Eliminate Dangerous Gas
			mes "[Steel Vigilante]";
			mes "一些矿工向我们报告了会传播神经毒素的气体状怪物。";
			next;
			mes "[Steel Vigilante]";
			mes "它们是名为Gaster的紫色怪物。除非被激怒，否则不会攻击，但仍然构成威胁。";
			next;
			mes "[Steel Vigilante]";
			mes "请在村外矿井中猎杀10只^0000ffGaster^000000。";
			close2;
			if (!.@no_npctalk)
				npctalk "热心求职者：要去猎杀Gaster吗？请让我加入。", "Enthusiastic Job Seeker#11";
			end;
		}
	}
	switch(.@quest_id) {
	case 12399:// Hunt Heinous Criminals
		getexp 95630,4_M_CACTUSMAN20;
		.@mob_id = 3747;
		break;
	case 12400:// Hunt Heinous Criminals
		getexp 95970,90930;
		.@mob_id = 3748;
		break;
	case 12401:// Hunt Heinous Criminals
		getexp 76280,80770;
		.@mob_id = 3749;
		break;
	case 12402:// Eliminate Dangerous Gas
		getexp 50800,47160;
		.@mob_id = 3740;
		break;
	}
	getitem 25250,3;// Coin_Of_Rr
	erasequest .@quest_id;
	setquest 12398;// You're Good
	mes "[Steel Vigilante]";
	mes "你很不错。我很愿意再次和你合作。";
	close;
}


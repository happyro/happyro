harboro1,341,136,0	script	#r_q2	HIDDEN_WARP_NPC,5,5,{
	end;
OnTouch:
	if (isbegin_quest(12389) == 2)
		end;
	.@r = rand(1,6);
	if (.@r == 1)
		npctalk "害怕的工匠：这里不安全。", "Scared Artificer#2";
	else if (.@r == 2)
		npctalk "害怕的工匠：除非他们答应赔偿工伤，否则我不干了！", "Scared Artificer#4";
	else if (.@r == 3)
		npctalk "害怕的工匠：我从没见过这么大的虫子。我再也不能在这里工作了。", "Scared Artificer#6";
	else if (.@r == 4)
		npctalk "害怕的工匠：一群虫子爬过地上的同事来攻击我，我吓得什么也做不了。为什么没人告诉我它们的事？", "Scared Artificer#8";
	else if (.@r == 5)
		npctalk "害怕的工匠：如果想让我们为你工作，就先把工作场所变安全！", "Scared Artificer#10";
	else
		npctalk "害怕的工匠：你没下去过吧？你真幸运。", "Scared Artificer#12";
	end;

OnEnable:
	.@r = rand(1,4);
	if (.@r == 1)
		npctalk "害怕的工匠：下面的地方无可救药！现在停手还不晚！", "Scared Artificer#7";
	else if (.@r == 2)
		npctalk "害怕的工匠：你还太年轻，不能死。", "Scared Artificer#5";
	else if (.@r == 3)
		npctalk "害怕的工匠：你最好考虑清楚。下面很危险。", "Scared Artificer#3";
	else
		npctalk "害怕的工匠：喂，生命比钱重要。", "Scared Artificer#1";
	end;
}

harboro1,334,135,6	script	Desalination Facility Manager	4_M_YURI,{
	disable_items;
	if (checkweight(1201,1) == 0) {
		mes "我携带的物品种类太多，应该先减轻负重。";
		close;
	}
	if ((MaxWeight - Weight) < 10000) {
		mes "我超重了，最好先减轻负重。";
		close;
	}
	if (BaseLevel < 100) {
		mes "[Desalination Facility Manager]";
		mes "你在这里做什么？你还不够格赚取报酬。出去！";
		close;
	}
	if (isbegin_quest(12403) == 0) {// first time
		mes "[Desalination Facility Manager]";
		mes "我的办公室里全是小偷。每个人都想拿钱？却不做自己的工作！";
		next;
		select("……？");
		mes "[Desalination Facility Manager]";
		mes "还有你。你打算向我要多少钱？先说好，我们不支付预支工资。";
		next;
		if (select( "我只是路过。", "我想预支1亿Zeny。" ) == 2) {
			mes "[Desalination Facility Manager]";
			mes "...";
			next;
			mes "[Desalination Facility Manager]";
			mes "你疯了吗。";
			close;
		}
		mes "[Desalination Facility Manager]";
		mes "嗯？但你看起来太强了，不像普通路人。";
		next;
		select("嗯，我在这里没什么事。我该走了。");
		mes "[Desalination Facility Manager]";
		mes "等等！";
		next;
		mes "[Desalination Facility Manager]";
		mes "等等。对了。";
		next;
		mes "[Desalination Facility Manager]";
		mes "喂，Jamie！你说涵洞还需要多少工人？";
		npctalk "职业介绍所老板：喂，Jamie！你说涵洞还需要多少工人？";
		next;
		mes "[Jamie]";
		mes "^000077Since 2 more disappeared yesterday, 15. No one wants to go down there.^000000";
		npctalk "Jamie：因为昨天又有两人失踪，所以是15人。没人想下去。", "Jamie";
		next;
		mes "[Desalination Facility Manager]";
		mes "听到了吗？我们的办公室严重缺人。";
		next;
		if (select( "那这些渴望工作的人呢？", "不关我的事。" ) == 2) {
			mes "[Desalination Facility Manager]";
			mes "喂，别走！我还没说完！";
			close;
		}
		mes "[Desalination Facility Manager]";
		mes "他们确实很积极，但没有一个强到能派上用场。";
		next;
		mes "[Desalination Facility Manager]";
		mes "施工现场需要很多人。下面……有点危险，但你看起来知道如何应对危险。";
		next;
		mes "[Desalination Facility Manager]";
		mes "怎么样，要不要为我工作？我会慷慨付酬。";
		next;
		if (select( "告诉我这份工作具体做什么。", "让我想想。" ) == 2) {
			mes "[Desalination Facility Manager]";
			mes "不用想了！这对我们双方都有好处！";
			next;
			mes "[Desalination Facility Manager]";
			mes "我来简单介绍一下这个村子。它建在一座沉入海中的城市遗迹上。";
			next;
			mes "[Desalination Facility Manager]";
			mes "我们不能完全填满地下室，因为那里有海水淡化系统。";
		}
		else {
			mes "[Desalination Facility Manager]";
			mes "我来简单介绍一下这个村子。它建在一座沉入海中的城市遗迹上。";
			next;
			mes "[Desalination Facility Manager]";
			mes "我们不能完全填满地下室，因为那里有海水淡化系统。";
		}
		next;
		select("不能从别处取水吗？");
		mes "[Desalination Facility Manager]";
		mes "这里是沙漠。海水淡化比进口水便宜。";
		next;
		mes "[Desalination Facility Manager]";
		mes "总之，海水淡化系统本身状况良好，但组成系统的管网容易腐蚀和破裂，需要持续维护。";
		next;
		mes "[Desalination Facility Manager]";
		mes "后来地下室开始出现怪物，现在我们的工人都害怕工作。这就是我们目前的处境。";
		next;
		select("如果我拒绝会怎样？");
		mes "[Desalination Facility Manager]";
		mes "这个村子会用光饮用水。总得有人做这件事。信不信由你，我完全是为了利润才做的。";
		next;
		mes "[Desalination Facility Manager]";
		mes "怎么样，这个动机够充分吗？如果你还是不想帮忙，我不会强迫你。";
		next;
		mes "[Jamie]";
		mes "^000077Mr. Chairman, I've just got a call from the basement. Five more workers have been attacked by monsters.^000000";
		npctalk "Jamie：主席先生，我刚接到地下室的电话。又有五名工人遭到怪物攻击。", "Jamie";
		next;
		mes "[Desalination Facility Manager]";
		mes "糟糕，我最好去处理那件事。改变主意后再回来。";
		setquest 12403;// Laborers of Rock Ridge
		completequest 12403;
		close;
	}
	switch( checkquest(12404,PLAYTIME) ) {
	case -1:
		break;
	case 0:
	case 1:
		mes "[Desalination Facility Manager]";

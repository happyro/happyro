}

tur_dun03,105,76,4	script	Knight Leader#tur	110,5,5,{
	mes "[Takuyaka]";
	mes "我的人都去哪儿了？！";
	mes "太糟糕了~！";
	next;
	mes "[Takuyaka]";
	mes "哦……";
	mes "*呼！*";
	mes "终于又见到人了。";
	mes "告诉我你是谁！";
	next;
	switch(select("你凭什么问？:"+ strcharinfo(0) +"！:你在这里做什么？:先告诉我你是谁。")) {
	case 1:
		mes "[Takuyaka]";
		mes "你竟敢用这种语气和我说话！不知道我是谁吗？！我是塔库亚卡，艾尔贝塔治安骑士团团长！听到我的名字，狗头人和波利都会发抖……";
		next;
		mes "[Takuyaka]";
		mes "老实告诉我！你是来寻宝的，对吧？！你想独吞宝藏！你这个混蛋！现在滚出这座岛！走，快走！";
		close;
	case 2:
		mes "[Takuyaka]";
		mes "" + strcharinfo(0) + "？";
		mes "嗯，你的名字听起来比我的好。而且你头发也比我多。嗯……";
		next;
		mes "[Takuyaka]";
		mes "你有什么东西能给我吗？比如食物或 Zeny？我也不是很需要，只是……唉，算了。以后也许还会见面。";
		close;
	case 3:
		mes "[Takuyaka]";
		mes "听说海龟岛上有许多宝藏。只要带够回家，我就发财了！当然我们也该营救迷路的冒险者，不过随便吧。作为团长，我想做什么都行！";
		next;
		mes "[Takuyaka]";
		mes "不过我们完全迷路了。也就是说，宝藏找不到，人也救不了。呃……！我那些没用的士兵去哪儿了！肯定是我给他们吃太多，把他们惯坏了！";
		next;
		mes "[Takuyaka]";
		mes "如果你看到他们，让他们到这里集合！听到了吗？！";
		close;
	case 4:
		mes "[Takuyaka]";
		mes "我？我是塔库亚卡。高大、英俊、潇洒的团长，也是令人畏惧的骑士！我是来拯救那些来海龟岛寻宝的艾尔贝塔蠢人的。";
		next;
		mes "[Mudasamu]";
		mes "真的吗？";
		next;
		mes "[Takuyaka]";
		mes "安静！";
		next;
		mes "[Takuyaka]";
		mes "总之，我们怀着最纯粹的目的来到这里。但刚到就遭到怪物袭击！战斗混乱中，我的士兵们四散了。";
		next;
		mes "[Takuyaka]";
		mes "穆达萨姆！";
		mes "为什么这种事";
		mes "会发生在我身上!!!!";
		next;
		mes "[Mudasamu]";
		mes "咦……！";
		mes "你有什么好";
		mes "惊讶的，";
		mes "你这个胖矮人？";
		close;
	}

OnTouch_:
	mes "[Scared Voice]";
	mes "什、什、什么？！";
	next;
	mes "[Terrified Voice]";
	mes "那是什么声音？！";
	mes "穆、穆、穆达萨姆！";
	mes "保护我！";
	next;
	mes "[Mudasamu]";
	mes "不。";
	mes "闭嘴。";
	close;
}

tur_dun03,105,74,4	script	Mudasamu#tur	119,{
	mes "[Mudasamu]";
	mes "我的名字是穆达萨姆……";
	mes "艾尔贝塔治安骑士团的";
	mes "副团长。";
	next;
	mes "[Mudasamu]";
	mes "我们来这里是为了营救可能遇险的寻宝者。不过，我们的团长就是我身边这个胖家伙。所以我早就预见到任务会失败。";
	next;
	mes "[Mudasamu]";
	mes "基本上，团长一心想着自己找宝藏，结果我们和士兵走散了。他又胖又邋遢已经够糟了，还是个贪婪的邋遢鬼！";
	next;
	emotion ET_ANGER;
	mes "[Takuyaka]";
	mes "喂，穆达萨姆！";
	mes "你是在说";
	mes "我吗？！";
	next;
	mes "[Mudasamu]";
	mes "不，胖子，";
	mes "我们不是";
	mes "在说你。";
	next;
	mes "[Mudasamu]";
	mes "*叹气……*";
	mes "我最好能拿到";
	mes "加班费，毕竟";
	mes "一直在忍受这些。";
	close;
}

tur_dun01,190,115,4	script	Knight#tur	105,{
	mes "[?]";
	mes "他们去哪儿了？";
	mes "哦，嘿！你是冒险者吧？你知道我的同伴在哪里吗？";
	next;
	switch(select("你是谁？:抱歉，我不知道。:你为什么来这里？:你是怎么到这里的？")) {
	case 1:
		mes "[Passats]";
		mes "我叫帕萨茨，是艾尔贝塔治安骑士团的骄傲。我们得到消息，有人来这里寻宝。";
		next;
		mes "[Passats]";
		mes "我们的任务是救人，但抵达海龟岛时遭到一群怪物袭击！所以大家都走散了。";
		next;
		mes "[Passats]";
		mes "现在只剩我一个。如果你找到我部队的其他人，能告诉他们一声吗？";
		close;
	case 2:
		mes "[Passats]";
		mes "啊，算了……";
		mes "如果你碰巧找到我部队的其他人，能告诉他们我在哪儿吗？";
		next;
		mes "[Passat]";
		mes "哦，如果你找到我们的团长，替我踢他的屁股，好吗？他的屁股太肥了，绝不会踢偏。";
		next;
		if (BaseLevel <= 10)
			percentheal 40,0;
		mes "[Passats]";
		mes "哦……";
		mes "还有，呃……";
		mes "打起精神！";
		close;
	case 3:
		mes "[Passats]";
		mes "关于这座岛上惊人财富的传说很多。不过大家都认为不可能找到海龟岛。";
		next;
		mes "[Passats]";
		mes "但后来有个领航员真的知道去海龟岛的路。我想他会带任何人去，只要一万 Zeny！";
		next;
		mes "[Passats]";
		mes "总之，一些艾尔贝塔人傻乎乎地来这里寻宝。当然，他们不会和怪物战斗。";
		next;
		mes "[Passats]";
		mes "所以我们来寻找遇险的城镇居民，把他们安全送回家。当然，现在看来也需要别人来救我们……";
		close;
	case 4:
		mes "[Passats]";
		mes "嗯……";
		next;
		mes "[Passats]";
		mes "不知道。";
		next;
		select("怎么会这样？！");
		mes "[Passats]";
		mes "哦，别生气。我只是伏特加喝多了！抵达前我还昏迷着，醒来后就到了这里。真丢脸~";
		next;
		mes "[Passats]";
		mes "我……";
		mes "我也是受害者~";
		close;
	}
}

tur_dun03,189,126,4	script	Knight#tur2	105,{
	mes "[Jayprocat]";
	mes "哦？你是平民吗？很高兴见到你。我是艾尔贝塔强大的治安骑士杰普罗卡特。";
	next;
	if (select("具体是做什么的？:没什么了不起。") == 1) {
		mes "[Jayprocat]";
		mes "嗯……";
		mes "我们应该保护艾尔贝塔的人民。这就是我们这些骄傲的治安骑士的职责。";
		next;
		mes "[Jayprocat]";
		mes "所以当一群人寻宝心切、来到这里时，我们就来救他们。总之，原计划是这样。";
		next;
		mes "[Jayprocat]";
		mes "没想到命运开了个玩笑，我们的团长是个胖家伙。他没有完成任务，反而大声挖宝，引来了一群怪物。";
		next;
		mes "[Jayprocat]";
		mes "*叹气……*";
		mes "为什么不是穆达萨姆负责？如果他是团长，我现在应该已经回家吃晚饭了……";
		close;
	}
	mes "[Jayprocat]";
	mes "嗯……";
	mes "确实，我们拯救寻宝者的任务基本搞砸了，因为现在也需要别人来救我们。";
	next;
	mes "[Jayprocat]";
	mes "*抽泣*";
	mes "为什么我第一次任务就被这么多怪物袭击？我……我只是新兵……";
	next;
	if (select("你为什么逃跑？:我不在乎。") == 1) {
		mes "[Jayprocat]";
		mes "不，我不是单纯逃跑！怪物太强，而且数量太多！再说都是我们该死的团长的错。";
		next;
		mes "[Jayprocat]";
		mes "这些怪物都是高度进化的乌龟。而且这座岛看起来也像乌龟！不过我想你已经知道了。";
		next;
		mes "[Jayprocat]";
		mes "我没想到这座岛的怪物比艾尔贝塔附近的强这么多。";
		next;
		mes "[Jayprocat]";
		mes "它们的壳太硬了，我们根本找不到弱点！我完全不知道该怎么对付这些乌龟！";
		close;
	}
	mes "[Jayprocat]";
	mes "你真坏……";
	mes "我可是新手啊！";
	close;
}

tur_dun03,104,171,4	script	Knight#tur3	105,{
	mes "[Squall]";
	mes "只剩我一个了吗？我的同伴都去哪儿了？！我……我要疯了！";
	next;
	if(select("也许他们逃跑了？:发生了什么？") == 1) {
		mes "[Squall]";

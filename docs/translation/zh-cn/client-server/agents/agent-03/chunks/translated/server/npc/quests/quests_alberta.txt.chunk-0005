		mes "...";
		next;
		mes "[Iromo]";
		mes "……所以最后……";
		mes "你只是想让我……走出家门……";
		mes "对吗……";
		next;
		select("没错，你会得到比付出更多的东西。");
		mes "[Iromo]";
		mes "...";
		next;
		mes "[Iromo]";
		mes "……但是现在……我不会出门。";
		mes "我还是害怕……";
		next;
		mes "[Iromo]";
		mes "即使现在不出门，";
		mes "我也会……努力做到。";
		mes "总有一天，我一定会成为……";
		mes "……冒险者……去做许许多多的事。";

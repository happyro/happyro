		next;
		mes "[Squall]";
		mes "即使那个团长有点贪婪，头发也可能越来越少……";
		next;
		mes "[Squall]";
		mes "^FF0000而且身材像";
		mes "怀孕的鲸鱼^000000。";
		next;
		mes "[Squall]";
		mes "等等！";
		mes "我不该";
		mes "说那个！";
		mes "我的意思";
		mes "是……";
		next;
		mes "[Squall]";
		mes "^CC0000而且身材是";
		mes "怀着双胞胎的鲸鱼^000000。";
		next;
		mes "[Squall]";
		mes "嗷……！";
		mes "我好生气！";
		mes "为什么穆达萨姆";
		mes "不能当我们的团长？！";
		close;
	}
	mes "[Squall]";
		mes "这次任务有副团长穆达萨姆制定的好计划。但被团长执行得一团糟。";
	next;
	mes "[Squall]";
		mes "每次塔库亚卡带队任务，总能把事情搞砸！艾尔贝塔的领导为什么会喜欢他？！";
	next;
	mes "[Squall]";
		mes "*抽泣*";

		mes "[Iromo]";
		mes "好了……走开吧。我知道……";
		mes "我知道你想说什么……真烦……";
		next;
		mes "-你没有放弃，继续-";
		mes "-讲述那些-";
		mes "-与朋友分享的故事。-";

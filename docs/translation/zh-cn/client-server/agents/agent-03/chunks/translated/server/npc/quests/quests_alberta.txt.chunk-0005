	next;
	mes "[Squall]";
		mes "塔库亚卡去自助餐后，武器和盔甲预算总会花光……我们为什么这么悲惨？！";
	close;
}

tur_dun03,67,130,4	script	Knight#tur4	105,{
	mes "[Nysurea]";
	mes "嗯？居然还有人活着，我很惊讶。";
	next;
	mes "[Nysurea]";
	mes "我开始觉得我的同伴都被这里的怪物杀死了……";
	next;
	if (BaseLevel <= 40) {
		mes "[Nysurea]";
		mes "遇到";
		mes "困难了吗？";
		next;
		if (Zeny <= 3000) {
			mes "[Nysurea]";
			mes "即使你很强，迟早也需要休息。如果你愿意，我现在就能把你送回艾尔贝塔。";
			next;
			if (select("是的，帮帮我。:不用了，谢谢。") == 1) {
				mes "[Nysurea]";
			mes "好吧，让我启动卡普拉公司捐赠给我们的传送装置……";
				close2;
				warp "alberta",241,115;
				end;
			}
			mes "[Nysurea]";
			mes "这才对！不过你要小心。如果你看到我的其他同伴，告诉他们我在这里，好吗？";
			next;
			mes "[Nysurea]";
			mes "祝你好运！";
			close;
		}
		mes "[Nysurea]";
		mes "你看起来迷路了！继续待在这里的话，迟早会被怪物收拾。";
		next;
		mes "[Nyusurea]";
		mes "总之……";
		mes "祝你好运！";
		mes "你会需要好运的！";
		close;
	}
	mes "[Nysurea]";
	mes "咦……";
	mes "你看起来冷静又沉着。如果所有士兵都像你这么强，我们大概就不会走散。";
	next;
	mes "[Nysurea]";
	mes "我梦想成为伟大的骑士，但我们的‘团长’只有肥胖没有头脑，我们才会陷入这种困境。";
	next;
	mes "[Nysurea]";
	mes "总之，在海龟岛第三层要小心。很多士兵探索东侧和北侧时被消灭了，所以务必小心！";
	close;
}


		mes "-死于这场悲剧。-";
		mes "-最后，一切都是悲剧……-";
		next;
		mes "-但你强调-";
		mes "-即使结局悲惨，-";
		mes "-美好的友谊-";
		mes "-也不会因此消失。-";
		next;
		mes "[Iromo]";
		mes "...";
		next;

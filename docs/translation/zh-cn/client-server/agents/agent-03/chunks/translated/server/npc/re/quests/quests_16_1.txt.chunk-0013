		next;
		cutin "16wol_nor",2;
		mes "[Wolf]";
		mes "看来我把自己的意志强加给了赫尔穆特和家族成员。";
		next;
		mes "[Wolf]";
		mes "除了战争，还有其他办法可以影响大陆的每个角落。";
		next;
		mes "[Wolf]";
		mes "正如迈尔所说，我正在寻找其他途径，也会继续下去。";
		next;
		mes "[Wolf]";
		mes "亲爱的冒险者，如果你不介意，能把我的意愿转告给^0000cd迈尔^000000吗？";
		next;
		mes "[Wolf]";
		mes "告诉他我已经放弃战争，正在寻找更好的解决方案；如果可以，请他拜访家族，看看大家。";
		next;

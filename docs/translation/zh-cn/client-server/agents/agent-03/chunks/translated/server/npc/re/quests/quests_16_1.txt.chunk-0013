	if (ep16_lug == 10) {
		mes "[Maximilian]";
		mes "欢迎，冒险者。旅途还安全吗？";
		next;
		mes "[Maximilian]";
		mes "我没看到赫尔穆特。他拒绝来了吗？";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "是的，他给你们两人留了口信。";
		next;
		mes "[告诉马克西米利安和沃尔夫赫尔穆特的遗嘱与继承安排]";
		next;
		mes "[Maximilian]";
		mes "赫尔穆特离开时我就有所察觉，但没想到他会放弃继承权。";
		mes "不过既然这是赫尔穆特的愿望，我不反对。";
		next;
		mes "[Maximilian]";
		mes "王室议会和宴会结束后就会宣布这件事。沃尔夫，现在你该领导我们的家族了。希望这不会成为你的负担。";
		next;

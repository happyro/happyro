		mes "[" + strcharinfo(0) + "]";
		mes "你表现出了以前从未有过的坚定态度。";
		next;
		mes "[Maximilian]";
		mes "我曾试图让孩子们按我的想法行动，却失败了。从那以后我让他们随心所欲。但现在我明白了。";
		next;
		mes "[Maximilian]";

	disablenpc instance_npcname("#npc_con07");
	stopnpctimer;
	end;
}

// Round 3
1@lab,4,1,3	script	#npc_con08	CLEAR_NPC,{
	end;
OnStart:
	sleep 13000;
	mapannounce 'map_name$, "Lona Fresa：主计算机MA-4885。看来你正试图同步异次元与本世界。", bc_map, 0x00ff77;
	sleep 6000;
	mapannounce 'map_name$, "MA-4885：正确。", bc_map, 0xffff00,FW_NORMAL,13,0;
	sleep 6000;
	npctalk "Artemia：Fresa博士！！这荒唐事件和我们原本的实验完全无关！", 'artemia$;
	sleep 6000;
	mapannounce 'map_name$, "Lona Fresa：我完全明白。", bc_map, 0x00ff77;
	sleep 6000;
	npctalk "Silvia：我们不能彻底关闭主电源吗？", 'silvia$;
	sleep 6000;
	mapannounce 'map_name$, "MA-4885：正在重启粒子加速程序。", bc_map, 0xffff00,FW_NORMAL,13,0;
	sleep 5000;
	'bool_event = true;
	donpcevent instance_npcname("#npc_con03") + "::OnStart";
	mapannounce 'map_name$, "Lona Fresa：" + gettime(DT_MONTH) + "月" + gettime(DT_DAYOFMONTH) + "日。当前时间11点38分，暂时终止粒子加速器项目。", bc_map, 0x00ff77;
	sleep 6000;
	mapannounce 'map_name$, "Lona Fresa：记录结束，原因是主计算机故障和加速器过热。", bc_map, 0x00ff77;
	sleep 5000;
	npctalk "Silvia：好了！现在只要Fresa博士关闭电源。", 'silvia$;
	sleep 6000;
	mapannounce 'map_name$, "Lona Fresa：切断主计算机MA-4885的电源。", bc_map, 0x00ff77;
	sleep 6000;
	mapannounce 'map_name$, "MA-4885：根据管理员请求暂停所有设备运行。", bc_map, 0xffff00,FW_NORMAL,13,0;
	sleep 5000;
	mapannounce 'map_name$, "MA-4885：……指令……Zizip……执行后续指令……Zizip。", bc_map, 0xffff00,FW_NORMAL,13,0;
	sleep 5000;
	'bool_event = false;
	npctalk "Artemia：呼……结束了吗？", 'artemia$;
	sleep 6000;
	mapannounce 'map_name$, "Lona Fresa：主计算机MA-4885已关闭。确认设备暂停。", bc_map, 0x00ff77;
	sleep 5000;
	npctalk "Silvia：看来结束了。", 'silvia$;
	sleep 4000;
	npctalk "Federico：初始化植物最棒。", 'federico$;
	sleep 4000;
	mapannounce 'map_name$, "Lona Fresa：记录所有实验进度，并在当前节点终止。", bc_map, 0x00ff77;
	sleep 5000;
	mapannounce 'map_name$, "Lona Fresa：最终实验失败很遗憾。但我保证下次会进行更完美的实验。", bc_map, 0x00ff77;
	sleep 5000;
	mapannounce 'map_name$, "Lona Fresa：大家干得好。", bc_map, 0x00ff77;
	sleep 5000;
	npctalk "Artemia：看来结束了。", 'artemia$;
	sleep 5000;
	npctalk "Federico：我以为这是Fresa的独断实验，原来是主计算机出了问题。", 'federico$;
	sleep 5500;
	npctalk "Silvia：冷静下来，离开这个可怕的实验室。", 'silvia$;
	sleep 5000;
	npctalk "Vincent：顺便说……我还是动不了，这是怎么回事？", 'vincent$;
	sleep 5000;
	'bool_event = true;
	donpcevent instance_npcname("#npc_con03") + "::OnStart";
	donpcevent instance_npcname("#npc_con03") + "::OnStart3";
	sleep 2000;
	mapannounce 'map_name$, "MA-4885：代号——下降", bc_map, 0xff0000,FW_NORMAL,16,0;
	sleep 5000;
	npctalk "Federico：什么？这不是初始化阶段吗？", 'federico$;
	sleep 2500;
	mapannounce 'map_name$, "MA-4885：开始最终阶段转换。", bc_map, 0xffff00,FW_NORMAL,13,0;
	sleep 3000;
	npctalk "Silvia：一切结束了。", 'silvia$;
	sleep 5500;
	mapannounce 'map_name$, "MA-4885：新的生物即将从半位面传送。", bc_map, 0xffff00,FW_NORMAL,13,0;
	sleep 5000;
	mapannounce 'map_name$, "MA-4885：剩余5秒", bc_map, 0xffff00,FW_NORMAL,13,0;
	sleep 1000;
	mapannounce 'map_name$, "MA-4885：剩余4秒", bc_map, 0xffff00,FW_NORMAL,13,0;
	sleep 1000;
	mapannounce 'map_name$, "MA-4885：剩余3秒", bc_map, 0xffff00,FW_NORMAL,13,0;
	sleep 1000;
	mapannounce 'map_name$, "MA-4885：剩余2秒", bc_map, 0xffff00,FW_NORMAL,13,0;
	sleep 1000;
	mapannounce 'map_name$, "MA-4885：剩余1秒", bc_map, 0xffff00,FW_NORMAL,13,0;
	sleep 1000;
	donpcevent instance_npcname("#npc_con10") + "::OnStart";
	mapannounce 'map_name$, "MA-4885：为与转换后的相位同步，暂时关闭主电源。", bc_map, 0xffff00,FW_NORMAL,13,0;
	sleep 3000;
	'bool_event = false;
	end;
}


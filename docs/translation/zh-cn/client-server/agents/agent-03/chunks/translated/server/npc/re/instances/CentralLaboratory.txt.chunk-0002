	sleep 1000;
	mapannounce 'map_name$, "MA-4885：剩余2秒", bc_map,0xFFFF00,FW_NORMAL,13;
	sleep 1000;
	mapannounce 'map_name$, "MA-4885：剩余1秒", bc_map,0xFFFF00,FW_NORMAL,13;

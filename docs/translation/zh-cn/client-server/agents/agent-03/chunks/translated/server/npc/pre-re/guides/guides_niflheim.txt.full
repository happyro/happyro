//===== rAthena Script =======================================
//= Niflheim Guide
//===== By: ==================================================
//= L0ne_W0lf
//===== Current Version: =====================================
//= 1.3
//===== Compatible With: =====================================
//= rAthena Project
//===== Description: =========================================
//= [Official Conversion]
//= Guides for the City of Niflheim
//===== Additional Comments: =================================
//= 1.1 Fixed location command format [Lupus]
//= 1.2 Optimized, updated common guide names [Lupus]
//= 1.3 Rescripted to official 10.3 standards. [L0ne_W0lf]
//============================================================

niflheim,107,156,6	script	Roaming Man#nif	798,{
	mes "[里凯尔]";
	mes "你一定是迷路了……";
	mes "为什么会有人";
	mes "故意来到这个";
	mes "可怕又恐怖的地方……？";
	next;
	mes "[里凯尔]";
	mes "自从我失足掉进这棵巨树，我就在这里受尽折磨。我在悲伤中虚度了多年，无法逃离尼夫海姆。";
	next;
	mes "[里凯尔]";
	mes "不过为了寻找";
	mes "逃跑的路线，我大概比任何人都";
	mes "更了解这座城镇。我想，";
	mes "如果逃出去不是徒劳的话，知道";
	mes "布局或许能帮到你。";
	next;
	switch(select("询问建筑位置。:移除小地图上的标记。:取消。")) {
	case 1:
		mes "[里凯尔]";
		mes "那么，你想了解哪个地方？";
		next;
		switch(select("女巫城堡:工具商店:武器商店:酒馆:取消")) {
		case 1:
			mes "[里凯尔]";
			mes "就是那里。我已经在你的小地图上";
			mes "标出了^FF3355+^000000，";
			mes "你可以前往那座";
			mes "可怕女巫居住的城堡。";
			next;
			mes "[里凯尔]";
			mes "我以前去过那里，但后来我";
			mes "逃走了，并决定尽量";
			mes "不要死得太频繁。";
			mes "这基本就是我在";
			mes "尼夫海姆的人生目标。";
			viewpoint 1,253,191,2,0xFF3355;
			break;
		case 2:
			mes "[里凯尔]";
			mes "工具商店就在我在你小地图上";
			mes "标出的^CE6300+^000000处。";
			next;
			mes "[里凯尔]";
			mes "他们出售一些在城外";
			mes "找不到的独特物品。";
			mes "当然，当我发现没有任何";
			mes "药水能缓解我的痛苦时，";
			mes "它们也就没那么特别了。";
			mes "……我真希望自己在监狱里。";
			emotion ET_KEK;
			viewpoint 1,217,196,3,0xCE6300;
			break;
		case 3:
			mes "[里凯尔]";
			mes "武器商店就在我在你小地图上";
			mes "标出的^55FF33+^000000处。";
			next;
			mes "[里凯尔]";
			mes "他们出售一些在城外";
			mes "找不到的独特物品……当然，";
			mes "在这里和怪物战斗只会";
			mes "让它们更加愤怒。你还不如";
			mes "直接让它们把你吃掉。";
			emotion ET_KEK;
			viewpoint 1,216,171,4,0x55FF33;
			break;
		case 4:
			mes "[里凯尔]";
			mes "酒馆就在我在你小地图上";
			mes "标出的^3355FF+^000000处。";
			next;
			mes "[里凯尔]";
			mes "有时我会在酒馆里看到死人";
			mes "开心地享受时光。以前我也";
			mes "曾经能够快乐，但现在每个";
			mes "醒着的时刻，我感受到的只有";
			mes "孤独与绝望的冰冷刺痛……";
			viewpoint 1,189,207,5,0x3355FF;
			break;
		case 5:
			mes "[里凯尔]";
			mes "如果你想移除小地图上的地点";
			mes "标记，请从菜单中选择";
			mes "‘移除小地图上的标记’。";
		}
		break;
	case 2:
		viewpoint 2,253,191,2,0xFF3355;
		viewpoint 2,217,196,3,0xCE6300;
		viewpoint 2,216,171,4,0x55FF33;
		viewpoint 2,189,207,5,0x3355FF;
		mes "[里凯尔]";
		mes "我已经移除了你小地图上的地点";
		mes "标记。以后想再次标记";
		mes "建筑位置时，尽管来问我。";
		mes "这能让我暂时忘记不断啃噬我的";
		mes "抑郁。";
		break;
	case 3:
		mes "[里凯尔]";
		mes "独自探索尼夫海姆";
		mes "可不是什么好主意……";
		mes "至少要尽量小心。";
		break;
	}









	close;
}

prontera,188,177,4	script	Happymerry#happymerry	869,{
	if (christ_solo05==1) {
		mes "[欢乐梅丽]";
		mes "霍尔格伦~~！！";
		mes "没想到你会背叛我！我不想精炼了~！！！";
		mes "我讨厌圣诞节~！";
		emotion ET_CRY;
		next;
		mes "["+ strcharinfo(0) +"]";
		mes "你……是……？";
		next;
		mes "[欢乐梅丽]";
		mes "你笑什么？嗯~！";
		mes "至少我从没找人帮忙";
		mes "精炼装备！";
		mes "我一直都很勇敢！！";
		mes "祝福？荣耀~~？！";
		mes "情侣~~哼~！！！";
		next;
		mes "["+ strcharinfo(0) +"]";
		mes "看来你就是合适的人！！！";
		mes "恩乔在等你。";
		mes "我们走！！！";
		next;
		mes "[欢乐梅丽]";
		mes "……！";
		mes "这一天终于到了？";
		mes "去年圣诞节我精炼装备失败时，";
		mes "是他帮助了我。";
		mes "哦，神圣的恩乔~";
		next;
		mes "[欢乐梅丽]";
		mes "好！我等了一年！！";
		mes "我准备好搞砸圣诞节了~！！";
		mes "恩乔在哪里？";
		mes "他在哪里？！";
		next;
		mes "["+ strcharinfo(0) +"]";
		mes "他在等你！";
		mes "你先去吧~";
		mes "我联系其他人后再跟上。";
		next;
		mes "[欢乐梅丽]";
		mes "好！";
		mes "我本来要叫^0000FF克里斯特^000000！";
		mes "替我叫他！";
		mes "我收拾好行李就先走。";
		mes "再见！";
		set christ_solo05,2;
		close;
	}
	// 保持翻译切片物理行数
		// 保持翻译切片物理行数
		// 保持翻译切片物理行数
		// 保持翻译切片物理行数
		// 保持翻译切片物理行数
	else if (christ_solo05 > 1) {
		mes "[欢乐梅丽]";
		mes "嗯……要收拾的东西比我想的多。";
		mes "毕竟已经一年了……";
		mes "总之，";
		mes "别忘了叫^0000FF克里斯特^000000！";
		mes "再见！";
		close;
	}
	else {
		mes "[欢乐梅丽]";
		mes "霍尔格伦！！";
		mes "没想到你会背叛我！我不想精炼了~！！！";
		mes "我讨厌圣诞节~！";
		emotion ET_CRY;
		next;
		mes "[欢乐梅丽]";
		mes "你笑什么？嗯~！";
		mes "至少我从没找人帮忙精炼装备！";
		mes "我一直都很勇敢！！";
		mes "祝福？荣耀~~？！";
		mes "情侣~~哼~！！！";
		close;
	}
}

prontera,62,339,3	script	Christ#christ	875,{
	if (christ_solo05 == 2) {
		mes "[克里斯特]";
		mes "现在~终于！！！";

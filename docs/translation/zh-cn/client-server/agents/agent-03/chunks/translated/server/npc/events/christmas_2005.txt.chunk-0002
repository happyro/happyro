// Oholy (Event 3)
prontera,156,242,0	script	Oholy#pron::OholyDup	79,{
	if (!christ_carol05) {
		mes "[奥霍利]";
		mes "普世欢腾！";
		mes "主已降临。";
		specialeffect EF_GLORIA;
		next;
		if (Sex == SEX_MALE) {
			mes "[奥霍利]";
			mes "圣诞快乐！";
			mes "亲爱的兄弟，想到圣诞节时，";
			mes "你会想到什么？";
			next;
		}
		else {
			mes "[奥霍利]";
			mes "圣诞快乐！";
			mes "亲爱的姐妹，想到圣诞节时，";
			mes "你会想到什么？";
			next;
		}
		switch(select("圣诞老人:圣诞礼物:圣诞颂歌:圣诞帽:我不喜欢情侣")) {
		case 1:
			mes "[奥霍利]";
			mes "圣诞老人！";
			mes "你还保有孩子般的纯真，";
			mes "小家伙！！！";
			mes "呵呵呵。";
			next;
			mes "[奥霍利]";
			mes "据说有个圣诞永不结束的城镇，";
			mes "那里住着圣诞老人。";
			mes "这只是你我之间的秘密，好吗？";
			next;
			mes "[奥霍利]";
			mes "奥霍利最新头条：";
			mes "是不是很惊人？";
			emotion ET_SMILE;
			close;
		case 2:
			mes "[奥霍利]";
			mes "礼物！真不错！";
			mes "多么令人兴奋！！！";
			mes "你醒来时发现";
			mes "圣诞礼物就在枕边！";
			next;
			mes "[奥霍利]";
			mes "你听说了吗？";
			mes "每年圣诞节发动突然袭击的坏圣诞老人，";
			mes "把圣诞老人的礼物";
			mes "带给了好孩子！";
			next;
			mes "[奥霍利]";
			mes "所以圣诞城的圣诞老人悬赏";
			mes "抓捕冒牌圣诞老人安东尼奥。";
			next;
			mes "[Oholy]";
			mes "奥霍利最新头条：";
			mes "是不是很惊人？";
			emotion ET_SMILE;
			close;
		case 3:
			mes "[奥霍利]";
			mes "没错！";
			mes "颂歌是圣诞节不可缺少的！";
			mes "我年轻时，圣诞节的颂歌";
			mes "总能让我的心怦怦跳。";
			mes "";
			next;
			mes "[奥霍利]";
			mes "但如今唱圣诞颂歌的人不多，";
			mes "很难感受到";
			mes "圣诞节正在临近。";
			mes "";
			mes " ";
			next;
			mes "[Oholy]";

prontera,163,66,7	script	Mas#mas	748,{
	if (christ_solo05 == 3) {
		mes "[Mas]";
		mes "药草！！！！要多久才会再生！";
		mes "有人知道药草的再生时间吗？！！";
		mes "我要挖药草、制作药水，卖给单身者！！";
		mes "哈哈哈哈！！";
		next;
		mes "[Mas]";
		mes "啊~~";
		mes "为什么我感觉如此空虚~";
		mes "明明仓库里装满了药草。";
		mes "不~~！！！！！！";
		mes "没时间浪费~~";
		mes "挖药草去……";
		next;
		mes "["+ strcharinfo(0) +"]";
		mes "嘿~你没事吧？你是马斯吗？";
		next;
		mes "[Mas]";
		mes "你……你是谁？！！！";
		mes "我已经很久没和陌生人说话了。";
		mes "嗯……";
		mes "我心里感觉到一股温暖……";
		mes "算了！！我在想什么？！！";
		mes "走开~我要挖药草~";
		next;
		mes "["+ strcharinfo(0) +"]";
		mes "马斯！！";
		mes "你没事吧？！";
		mes "克里斯特派我来的。";
		next;
		mes "[Mas]";
		mes "什么！！！已经这样了！！";
		mes "好吧~没错！";
		mes "我不需要花时间挖药草！！";
		mes "如果恩乔下了订单！？！";
		mes "我马上就到~！！！！！";
		next;
		mes "[Mas]";
		mes "...Are going with me?";
		next;
		mes "["+ strcharinfo(0) +"]";
		mes "不~~";
		mes "我还有事情要做。";
		mes "我必须告诉其他人这件事。";
		next;
		mes "[Mas]";
		mes "哦，对了！！！";
		mes "去找^0000FF事件^000000。";
		mes "好，拜拜~";
		mes "我会在那里和你见面！！……";
		mes "药草~？！情侣？！随便吧~~";
		set christ_solo05,4;
		close;
	}
	else if (christ_solo05 > 3) {
		mes "[马斯]";
		mes "失陪，我先去见恩乔。";
		mes "别忘了把这件事告诉^0000FF事件^000000。";
		mes "药草~情侣~~随便吧~~";
		mes "这个圣诞节会非常精彩！！";
		mes "哈哈哈~";
		close;
	}
	else {
		mes "[马斯]";
		mes "药草！！！！要多久才会再生！";
		mes "有人知道药草的再生时间吗？！！";
		mes "我要挖药草、制作药水，卖给单身者！！";
		mes "哈哈哈哈！！";
		next;
		mes "啊~~";
		mes "为什么我感觉如此空虚~";
		mes "明明仓库里装满了药草。";
		mes "不~~！！！！！！";
		mes "没时间浪费~~";
		mes "挖药草去……";
		close;
	}
}

prontera,35,209,5	script	Event#event	881,{

		mes "走吧，小蜜蜂。";
		next;
		mes "-He  talked to his right hand-";
		mes "-and packed his stuff and bowed to Kafra.-";
		next;
		mes "["+ strcharinfo(0) +"]";
		mes "终于！！！告诉完所有人了！！";
		mes "现在该收拾好东西，";
		mes "去惩罚单身者！！！";
		mes "哈哈哈……";
		close;
	}
	else {
		mes "[Event]";
		mes "........................";
		next;
		mes "[Event]";
		mes "...I love you too~!!!";
		emotion ET_HUK, playerattached();
		next;
		mes "["+ strcharinfo(0) +"]";
		mes "(Oh.my~)";
		next;
		mes "[Event]";
		mes "没关系，小蜜蜂。我一点也不孤单。";

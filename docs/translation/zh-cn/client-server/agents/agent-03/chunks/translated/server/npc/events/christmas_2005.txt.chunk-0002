		mes "再见~~！";
		close;
	}
	else {
		mes "[克里斯特]";
		mes "现在~终于！！！";
		mes "我可以骑大嘴鸟了~！";
		mes "为什么要和牧师组织派对？！";
		mes "我不需要那些。";
		mes "我只需要这只胖乎乎的大嘴鸟~！";
		next;
		mes "[克里斯特]";
		mes "你是谁！";
		mes "别想靠近我的大嘴鸟~！";
		mes "哦~我的可爱大嘴鸟~~你没被吓到吧？没事，亲爱的。";
		mes "恩乔从出生起就一直孤单寂寞~";
		mes "但我？！才不是！！";
		mes "我有可爱的伙伴陪着！！";
		next;
		mes "[克里斯特]";
		mes "我要和我的大嘴鸟举办派对。";
		mes "我们会一起分享圣诞蛋糕……";

			next;
			npctalk "哇哦！味道真不错……", "", bc_self;
			sleep2 500;
			specialeffect EF_FLASHER;
			mes .@npc_name$;
			mes "咦？！刚才一转眼就来了客人。";
			close;
		case 2:
			mes .@npc_name$;
			mes "你要回家吗？最近的城市是朱诺。我需要 1 个" + mesitemlink( 1000374 ) + "。";
			next;
			select( "给我 1 个" + .@item_name$ + "。" );
			if (countitem(1000374) < 1) {
				mes .@npc_name$;
				mes "去附近城市需要 1 个" + .@item_name$ + "。";
				close;
			}
			mes .@npc_name$;
			mes "旅途愉快。";
			close2;
			delitem 1000374,1;	// Brilliant_Soda
			warp "hugel",97,154;
			end;
		}
		end;
	case 2:
		erasequest 5925;
		mes .@npc_name$;
		mes "你可以再次进行讨伐任务了。";
		close;
	}
	switch( checkquest(5924,HUNTING) ) {
	case -1:
		mes .@npc_name$;
		mes "朱诺怪物协会正在执行讨伐任务。";
		next;
		switch( select( "接受讨伐任务。", "讨伐任务？", "传送到附近城市。", "你来自马来港吗？" ) ) {
		case 1:
			setquest 5924;
			mes .@npc_name$;
			mes "你可以在这里的塔纳托斯塔前原野捕获 80 只怪物。全部完成后向我报告。";
			close;
		case 2:
			mes .@npc_name$;
			mes "这是减少塔纳托斯塔前怪物数量的讨伐任务。";
			next;
			mes .@npc_name$;
			mes "怪物数量可能增加并造成损害，所以要提前减少怪物数量。";
			next;
			mes .@npc_name$;
			mes "做兼职前我以为怪物协会只是游戏，但看来确实是在工作。";
			close;
		case 3:
			mes .@npc_name$;
			mes "你要回家吗？最近的城市是修格尔。我需要 1 个" + mesitemlink( 1000374 ) + "。";
			next;
			select( "Give me 1 " + .@item_name$ + "." );
			if (countitem(1000374) < 1) {
				mes .@npc_name$;
				mes "去附近城市需要 1 个" + .@item_name$ + "。";
				close;
			}
			mes .@npc_name$;
			mes "旅途愉快。";
			close2;
			delitem 1000374,1;	// Brilliant_Soda
			warp "hugel",97,154;
			end;
		case 4:
			mes .@npc_name$;
			mes "哈哈哈……你知道马来港吗？那是个很棒的地方。";
			next;
			mes .@npc_name$;
			mes "别误会，我不是马来港的船长。";
			next;
			mes .@npc_name$;
			mes "这套船长服很酷，所以我想穿着它；但在那边穿就算冒充。我只是离开家乡时穿着它。";
			next;
			mes .@npc_name$;
			mes "啊……我突然想回家了。妈妈离家时说很辛苦，确实如此。";
			close;
		}
		end;
	case 0:
	case 1:
		mes .@npc_name$;
		mes "在塔纳托斯塔前捕获 80 只怪物后向我报告。";
		close;
	case 2:
		getexp 110760,104040;
		erasequest 5924;
		setquest 5925;
		mes .@npc_name$;
		mes "辛苦了。讨伐任务每天都能做，有空请再来。";
		close;
	}
	end;

OnInit:
	setunittitle getnpcid(0), "<Juno Monster Society>";

	questinfo( QTYPE_CLICKME, QMARK_YELLOW, "(checkquest(5925,PLAYTIME) == 0 || checkquest(5925,PLAYTIME) == 1) && countitem(1000374) > 2" );
	questinfo( QTYPE_DAILYQUEST, QMARK_YELLOW, "BaseLevel >= 75 && checkquest(5924,HUNTING) == -1 && checkquest(5925,PLAYTIME) == -1" );
	questinfo( QTYPE_QUEST2, QMARK_YELLOW, "checkquest(5924,HUNTING) == 2" );
	questinfo( QTYPE_DAILYQUEST, QMARK_YELLOW, "checkquest(5925,PLAYTIME) == 2" );
	end;
}

tur_dun01,159,46,4	script	Map Examiner Tural#yma	4_M_BRZ_MAN1,{

			mes "是的，我是厨师。现在的工作还不习惯，累得我都想不起来了。";
			next;
			mes .@npc_name$;
			mes "我记得在文件里写着要找厨房助手的兼职。醒来后不知怎么就成了这里的讨伐地图检查员。";
			next;
			mes .@npc_name$;
			mes "真的吗？我不能敷衍了事，否则会很兴奋……";
			close;
		}
		end;
	case 0:
	case 1:
		mes .@npc_name$;
		mes "除了塔拉青蛙，在乌龟岛捕获 80 只怪物后，来找我领取奖励。";

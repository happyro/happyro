	case 2:
		erasequest 5923;
		mes .@npc_name$;
		mes "你可以再次进行乌龟岛讨伐任务了。";
		close;
	}
	switch( checkquest(5922,HUNTING) ) {
	case -1:
		mes .@npc_name$;
		mes "嘿嘿……我还以为是怪物。你是来接讨伐任务的吗？";
		next;
		switch( select( "接受讨伐任务。", "讨伐任务？", "传送到附近城市。", "你不是厨师吗？" ) ) {
		case 1:
			setquest 5922;
			mes .@npc_name$;
			mes "除了塔拉青蛙，你可以在乌龟岛捕获 80 只怪物。全部完成后来找我领取奖励。";
			close;
		case 2:
			mes .@npc_name$;
			mes "这是要求你在乌龟岛捕获 80 只怪物的任务。";
			next;
			mes .@npc_name$;
			mes "啊！顺便说，即使捕获塔拉青蛙也不计数。不去招惹它的话，它是温顺的怪物，可以避开。";
			close;
		case 3:
			mes .@npc_name$;
			mes "给我一个" + mesitemlink( 1000374 ) + "，我就能传送你到艾尔贝塔。";

			close;
		case 2:
			mes .@npc_name$;
			mes "附近的城市是利希塔乐岑。给我一个" + mesitemlink( 1000374 ) + "，我就能传送你过去。";
			next;
			select( "给我 1 个" + .@item_name$ + "。" );
			if (countitem(1000374) < 1) {
				mes .@npc_name$;
				mes "咦？" + .@item_name$ + "在哪里？";
				close;
			}
			mes .@npc_name$;
			mes "下次再见~";
			close2;
			delitem 1000374,1;	// Brilliant_Soda
			warp "lighthalzen",192,314;
			end;
		}
		end;
	case 2:
		erasequest 5919;
		mes .@npc_name$;
		mes "你可以再次进行讨伐任务了。";
		close;
	}
	switch( checkquest(5918,HUNTING) ) {
	case -1:
		mes .@npc_name$;
		mes "这里是朱诺怪物协会。";
		next;
		switch( select( "接受讨伐任务。", "讨伐任务？", "传送到附近城市。", "你为什么这么直接？" ) ) {
		case 1:
			setquest 5918;
			mes .@npc_name$;
			mes "你只需要在这里的利希塔乐岑原野捕获 80 只怪物。";
			next;
			mes .@npc_name$;
			mes "谢谢，谢谢。任务正在进行。";
			close;
		case 2:
			mes .@npc_name$;
			mes "我也只是兼职。我不知道详细情况。";
			next;
			mes .@npc_name$;
			mes "我开始解释怪物群落和数量时听说过……";
			next;
			mes .@npc_name$;
			mes "听着说明我有点困了。解释起来太难。";
			next;
			mes .@npc_name$;
			mes "在利希塔乐岑原野捕获怪物并领取奖励，不是很重要吗？";
			close;
		case 3:
			mes .@npc_name$;
			mes "附近的城市是利希塔乐岑。给我一个" + mesitemlink( 1000374 ) + "，我就能传送你过去。";
			next;
			select( "给我 1 个" + .@item_name$ + "。" );
			if (countitem(1000374) < 1) {
				mes .@npc_name$;
				mes "咦？" + .@item_name$ + "在哪里？";
				close;
			}
			mes .@npc_name$;
			mes "下次再见~";
			close2;
			delitem 1000374,1;	// Brilliant_Soda
			warp "lighthalzen",192,314;
			end;
		case 4:
			mes .@npc_name$;
			mes "抱歉，我太困了。因为薪水不错，我才接了这份兼职。";
			next;
			mes .@npc_name$;
			mes "没有替班的人……我得一整天坚持下去……先好好工作，辞职后再起诉你。";
			close;
		}
		end;
	case 0:
	case 1:
		mes .@npc_name$;
		mes "你只要在利希塔乐岑原野捕获 80 只怪物。全部完成后找我确认并领取奖励。";
		close;
	case 2:
		getexp 81120,74560;
		erasequest 5918;
		setquest 5919;
		mes .@npc_name$;
		mes "辛苦了。呃……由于数量限制，讨伐任务每天只能做一次，明天可以再来。";
		next;
		mes .@npc_name$;
		mes "哦，我好累。真希望有人能替班……";
		close;
	}
	end;

OnInit:
	setunittitle getnpcid(0), "<Juno Monster Society>";

	questinfo( QTYPE_CLICKME, QMARK_YELLOW, "(checkquest(5919,PLAYTIME) == 0 || checkquest(5919,PLAYTIME) == 1) && countitem(1000374) > 2" );
	questinfo( QTYPE_DAILYQUEST, QMARK_YELLOW, "BaseLevel >= 71 && checkquest(5920,HUNTING) == -1 && checkquest(5921,PLAYTIME) == -1" );
	questinfo( QTYPE_QUEST2, QMARK_YELLOW, "checkquest(5918,HUNTING) == 2" );
	questinfo( QTYPE_DAILYQUEST, QMARK_YELLOW, "checkquest(5919,PLAYTIME) == 2" );
	end;
}

mal_dun01,141,126,4	script	Map Examiner Mother One#yma	4_F_TAEKWON,{
	.@npc_name$ = "[" + strnpcinfo(1) + "]";
	.@item_name$ = getitemname(1000374);

	if (BaseLevel < 75) {
		mes .@npc_name$;
		mes "朱诺怪物协会正在执行讨伐任务。不过你似乎还太弱，无法执行任务。";
		close;
	}
	switch( checkquest(5927,PLAYTIME) ) {
	case -1:
		break;
	case 0:
	case 1:
		mes .@npc_name$;
		mes "明天再做讨伐任务，可以吗？我累了，请别和我说话好吗？";
		next;
		switch( select( "你看起来很累。要喝点东西吗？", "传送到附近城市。" ) ) {
		case 1:
			if (countitem(1000374) < 3) {
				mes .@npc_name$;
				mes "什么？我的 3 个" + .@item_name$ + "去哪了？";
				close;
			}
			delitem 1000374,3;	// Brilliant_Soda
			erasequest 5927;
			mes .@npc_name$;
			mes "真的吗？之后没别的要说了吗？";
			next;
			npctalk "呃~ 真刺激……", "", bc_self;
			sleep2 500;
			specialeffect EF_FLASHER;
			mes .@npc_name$;
			mes "啊！她……她又说了。喂，你在说什么？";
			close;
		case 2:
			mes .@npc_name$;
			mes "马兰岛？想去的话给我一个" + .@item_name$ + "。不过从这里走过去不是更好吗？";
			next;
			select( "给我 1 个" + .@item_name$ + "。" );
			if (countitem(1000374) < 1) {
				mes .@npc_name$;
				mes "一个" + .@item_name$ + "。但我建议你走过去。";
				close;
			}
			mes .@npc_name$;
			mes "好！再见~下次再见~";
			close2;
			delitem 1000374,1;	// Brilliant_Soda
			warp "malangdo",141,118;
			end;
		}
	case 2:
		erasequest 5927;
		mes .@npc_name$;
		mes "啊！我又可以做讨伐任务了。该工作了吗？";
		close;
	}
	switch( checkquest(5926,HUNTING) ) {
	case -1:
		mes .@npc_name$;
		mes "我现在很忙。只有想接讨伐任务的人才来和我说话。";
		next;
		switch( select( "接受讨伐任务。", "讨伐任务？", "传送到附近城市。", "你在做什么？" ) ) {
		case 1:
			setquest 5926;
			mes .@npc_name$;
			mes "你是客人吗？那就请客气一点。";
			mes "你只需在星光珊瑚区捕获 80 只怪物；贝类、螃蟹和艾斯特不计入数量，不必捕获。加油！！";
			close;
		case 2:
			mes .@npc_name$;
			mes "啊？！你又这样打扰我。既然是客人，就请客气一点。";
			next;
			mes .@npc_name$;
			mes "这是在星光珊瑚区捕获怪物、控制数量的任务。";
			next;
			mes .@npc_name$;
			mes "蛤蜊、螃蟹和艾斯特无需捕获，因为不需要控制它们的数量。";
			next;
			mes .@npc_name$;
			mes "别问为什么。我只是兼职，不知道。下一位！";
			close;
		case 3:
			mes .@npc_name$;
			mes "马兰岛？想去的话给我一个" + .@item_name$ + "。不过从这里走过去不是更好吗？";
			next;
			select( "给我 1 个" + .@item_name$ + "。" );
			if (countitem(1000374) < 1) {
				mes .@npc_name$;
				mes "一个" + .@item_name$ + "。但我建议你走过去。";
				close;
			}
			mes .@npc_name$;
			mes "好！再见~下次再见~";
			close2;
			delitem 1000374,1;	// Brilliant_Soda
			warp "malangdo",141,118;
			end;
		case 4:
			mes .@npc_name$;
			mes "啊？！真的吗！！太烦人了。你看到那边站着的艾斯特了吗？你明明会说话，我和你说话却不回答？";
			next;
			mes .@npc_name$;
			mes "明明看到冒险者经过时你就像在聊天。你害羞吗？为什么不和我说话？";
			close;
		}
		end;
	case 0:
	case 1:
		mes .@npc_name$;
		mes "在星光珊瑚区捕获 80 只怪物后再来找我。";
		next;
		mes .@npc_name$;
		mes "即使捕获蛤蜊、螃蟹和艾斯特也不计数，别之后再来问我。";
		close;
	case 2:
		getexp 90880,85440;
		erasequest 5926;
		setquest 5927;
		mes .@npc_name$;
		mes "哦！你做得很好。讨伐任务明天也能做，有空时再来吧。";
		close;
	}
	end;

OnInit:
	setunittitle getnpcid(0), "<Juno Monster Society>";

	questinfo( QTYPE_CLICKME, QMARK_YELLOW, "(checkquest(5927,PLAYTIME) == 0 || checkquest(5927,PLAYTIME) == 1) && countitem(1000374) > 2" );
	questinfo( QTYPE_DAILYQUEST, QMARK_YELLOW, "BaseLevel >= 75 && checkquest(5926,HUNTING) == -1 && checkquest(5927,PLAYTIME) == -1" );
	questinfo( QTYPE_QUEST2, QMARK_YELLOW, "checkquest(5926,HUNTING) == 2" );
	questinfo( QTYPE_DAILYQUEST, QMARK_YELLOW, "checkquest(5927,PLAYTIME) == 2" );
	end;
}

hu_fild01,133,157,6	script	Map Examiner Huf#yma	4_MAL_CAPTAIN,{
	.@npc_name$ = "[" + strnpcinfo(1) + "]";

		close;
	}
	switch( checkquest(5925,PLAYTIME) ) {
	case -1:
		break;
	case 0:
	case 1:
		mes .@npc_name$;
		mes "我已经独自站在这里好几天了，希望明天有人来接替我。";
		next;
		switch( select( "你看起来很累。要喝点东西吗？", "传送到附近城市。" ) ) {
		case 1:

			mes "[雪雪]";
			mes "不过……";
			mes "有时所有圣诞的喜悦，也无法治愈我内心深处涌起的黑暗孤独。";
			next;
			mes "[雪雪]";
			mes "你愿意做我的朋友吗？如果愿意，我也会做你的朋友~";
			close2;
			cutin "",255;
			end;
		} else {
			switch(xmas_npc) {
			case 2:
				cutin "rutie_snownow01.bmp",2;
				mes "[雪雪]";
				mes "哦……？";
				mes "你见过达芙吗？";
				mes "是啊，她有时会来";
				mes "打声招呼……";
				next;
				mes "[雪雪]";
				mes "露提居民称我为神秘的魔法雪人，真奇怪。我的内心不也和普通人一样吗？";
				next;
				mes "[雪雪]";
				mes "*抽泣*有、有时我甚至不知道自己是什么。";
				mes "即便如此，露提居民仍努力接纳我。";
				next;
				mes "[雪雪]";
				mes "^3355FF波兹^000000给了我一张写有地址的写真照，让我难过时去找他。听到这些我好开心……";
				next;
				mes "[雪雪]";
				mes "但命运又对我开了残酷玩笑，我意识到自己没有腿去见他。";
				next;
				mes "[雪雪]";
				mes "我到底怎么来到这个城镇的？又怎么能说话？！这、这不自然，对吧？难道……难道我就是怪物？";
				next;
				mes "^3355FF雪雪陷入沉思，似乎^000000";
				mes "^3355FF一直盯着波兹的纪念品。^000000";
				set xmas_npc,3;
				close2;
				cutin "",255;
				end;
			case 3:
				cutin "rutie_snownow01.bmp",2;
				mes "[雪雪]";
				mes "...";
				next;
				mes "^3355FF雪雪陷入沉思，似乎^000000";
				mes "^3355FF一直盯着波兹的纪念品。^000000";
				close2;
				cutin "",255;
				end;
			case 4:
				cutin "rutie_snownow01.bmp",2;
				mes "[雪雪]";
				mes "太好了！";
				mes "你见过波兹！";
				next;
				mes "[雪雪]";
				mes "他是个诚实善良的人。希望他和达芙有一天能走到一起。";
				next;
				mes "[雪雪]";
				mes "……哦不~！";
				mes "我把它说出来了吗？本来应该只在心里想的！真、真对不起！我真是个大笨蛋，对吧？";
				next;
				mes "[雪雪]";
				mes "是啊……";
				mes "波兹爱着达芙。她对所有人都很友善，唯独对波兹例外。";
				next;
				mes "[雪雪]";
				mes "但我知道那是因为她非常非常喜欢他！嘻嘻嘻！";
				close2;
				cutin "",255;
				end;
			case 5:
				cutin "rutie_snownow01.bmp",2;
				mes "[Snowysnow]";
				mes "哦……？";
				mes "你见过";
				mes "^3355FFUncle Hairy Cantata^000000?";
				next;
				cutin "rutie_snownow02.bmp",2;
				mes "[Snowysnow]";
				mes "没错，他声音很大、不洗澡，身上还有腐烂食物的味道。但他很有趣，也很热心。大家都喜欢他！";
				next;
				mes "[Snowysnow]";
				mes "当然，他还喜欢喝奇怪的东西。据说他没肚子疼真是奇迹。嘻嘻~！哦，我喜欢那家伙！";
				close2;
				cutin "",255;
				end;
			case 6:
				cutin "rutie_snownow01.bmp",2;
				mes "[Snowysnow]";
				mes "哦……？";
				mes "你见过";
				mes "^3355FFAunt Thachentze^000000?";
				next;
				mes "[Snowysnow]";
				mes "是啊，她是腌菜专家。对了，你能把这个给她吗？我一直替她保管着世界上最粗糙的盐。";
				next;
				set xmas_npc,7;
				mes "^3355FFSnowysnow gave you the roughest salt in the world^000000.";
				next;
				mes "[Snowysnow]";
				mes "我喜欢她的料理，因为太好吃了！她有时会给我雪花上的葡萄糖浆。总之，朋友，帮我把盐送去吧~！";
				close2;
				cutin "",255;
				end;
			case 7:
				cutin "rutie_snownow01.bmp",2;
				mes "[雪雪]";
				mes "‘^3355FF世界上最粗糙的";
				mes "盐^000000……’";
				mes "哇，真粗糙！塔琴泽阿姨总是在腌菜，她很快就能用上！";
				close2;
				cutin "",255;
				end;
			case 8:
				cutin "rutie_snownow01.bmp",2;
				mes "[雪雪]";
				mes "哈肖基，那个无聊的小丑？起初他看起来有点傻，也不怎么有趣。但他内心深处非常关心别人。";
				next;
				mes "[雪雪]";
				mes "他总是尽力让那两个孤儿笑起来，忘记烦恼……";
				close2;
				cutin "",255;
				end;
			case 9:
				cutin "rutie_snownow01.bmp",2;
				mes "[雪雪]";
				mes "啊……";
				mes "你见过查鲁查鲁？那个男孩充满乐观、总是向前看。长大后他会成为大人物！";
				next;
				mes "[雪雪]";
				mes "我敢肯定！";
				mes "嘻嘻嘻~！";
				close2;
				cutin "",255;
				end;
			case 10:
				cutin "rutie_snownow01.bmp",2;
				mes "[雪雪]";
				mes "谢谢你一直听我说。我很感激你虽然是外乡人，却努力理解我。";
				next;
				mes "[雪雪]";
				mes "现在你比镇上任何人都了解我。所以作为回报，我想送你一件小礼物。";
				next;
				mes "[雪雪]";
				mes "锵锵！";
				mes "挑一件";
				mes "你想要的吧~";
				next;
				mes "^3355FF你小心地把手伸进";
				mes "雪雪的魔法礼物袋里摸索。^000000";
				next;
				switch(rand(1,8)) {
				case 1:
					set xmas_npc,11;
					getitem 529,5;// Candy
					cutin "rutie_snownow02.bmp",2;
					mes "[雪雪]";
					mes "哇~！";
					mes "^3355FF5 Candy^000000!";
					mes "恭喜！";
					break;
				case 2:
					set xmas_npc,11;
					getitem 529,10;// Candy
					cutin "rutie_snownow02.bmp",2;
					mes "[雪雪]";
					mes "哦~！";
					mes "^3355FF10 Candy^000000!";
					break;
				case 3:
					set xmas_npc,11;
					getitem 530,5;// Candy_Striper
					cutin "rutie_snownow02.bmp",2;
					mes "[雪雪]";
					mes "好耶~！";
					mes "^3355FF5 Candy Cane^000000!";
					break;
				case 4:
					set xmas_npc,11;
					getitem 530,10;// Candy_Striper
					cutin "rutie_snownow02.bmp",2;
					mes "[雪雪]";
					mes "哇，太棒了！";
					mes "^3355FF10 Candy Cane^000000!";
					break;
				case 5:
					set xmas_npc,11;
					getitem 539,1;// Piece_Of_Cake
					cutin "rutie_snownow02.bmp",2;
					mes "[雪雪]";
					mes "你真幸运！";
					mes "^3355FF1 Piece Of Cake^000000!";
					break;
				case 6:
					set xmas_npc,11;
					getitem 539,2;// Piece_Of_Cake
					cutin "rutie_snownow02.bmp",2;
					mes "[雪雪]";
					mes "这不是很好吗？";
					mes "^3355FF2 Piece Of Cake^000000!";
					break;
				case 7:
					set xmas_npc,11;
					getitem 538,5;// Well_Baked_Cookie
					cutin "rutie_snownow02.bmp",2;
					mes "[雪雪]";
					mes "哦，哇哦~！";
					mes "^3355FF5 Cookie^000000!";
					break;
				case 8:
					set xmas_npc,11;
					getitem 538,10;// Well_Baked_Cookie
					cutin "rutie_snownow02.bmp",2;
					mes "[雪雪]";
					mes "*倒吸气！*哦~";
					mes "^3355FF10 Cookie^000000!";
					break;
				}
				next;
				mes "[雪雪]";
				mes "亲爱的朋友，请偶尔来看我，我们聊聊天，好吗？回头见！圣诞快乐！";
				close2;
				cutin "",255;
				end;
			case 11:
				cutin "rutie_snownow02.bmp",2;
				mes "[雪雪]";
				mes "你好你好！";
				next;
				mes "[雪雪]";
				mes "露提永远欢迎你，尤其是我雪雪！宽扎节、光明节和圣诞节快乐~！";
				close2;
				cutin "",255;
				end;
			}
		}
		case 2:
			cutin "rutie_snownow01.bmp",2;
			mes "[雪雪]";
			mes "这个永远受到圣诞祝福的美好城镇附近，有一座永远受到圣诞诅咒的可怕地下城。";
			next;
			mes "[雪雪]";
			mes "听说里面装饰得很好，像玩具工厂一样，所有东西都可爱漂亮。到处都是玩具士兵和礼物盒！";
			next;
			cutin "rutie_snownow01.bmp",2;
			mes "[雪雪]";
			mes "是不是非常令人兴奋？！*叹气*即使那是地下城，我也想进去看看。要是我是真正的男孩，或者至少有腿就好了……";
			close2;
			cutin "",255;
			end;
		case 3:
			cutin "rutie_snownow03.bmp",2;
			mes "[雪雪]";
			mes "拜拜，朋友~！";
			mes "谢谢你听我说~";
			mes "总有一天我们会再见！你永远在我心里~";
			close2;
			cutin "",255;
			end;
		}
}

xmas,146,136,4	script	Hashokii	715,{
	mes "[哈肖基]";
	mes "圣~诞~快~乐~！";
	mes "啦啦啦~！";
	mes "嘟嘟嘟嘟！";
	next;
	switch(select("喂，小丑男，怎么了？:关于雪雪:结束对话")) {
	case 1:
		mes "[哈肖基]";
		mes "啦啦啦~！";
		mes "嘟嘟嘟嘟！";
		mes "哦，我正在想为查鲁查鲁和马塞尔上演什么好节目！";
		next;
		mes "[哈肖基]";
		mes "他们每天都变得更聪明、更机灵，现在似乎连我最好的笑话都不笑了。他们怎么变得这么聪明？";
		next;
		mes "[哈肖基]";
		mes "只要我足够努力，他们一定会忍不住笑我的笑话！所以……我最好马上开始编更好的笑话。";
		next;
		mes "[哈肖基]";
		mes "啦啦啦~！";
		mes "嘟嘟嘟嘟";
		mes "圣诞快乐！";
		close;
	case 2:
		if (xmas_npc == 8) {
			mes "[哈肖基]";
			mes "嘟嘟嘟嘟";
			mes "啊哈！你想了解更多关于雪雪的事！让我看看……";
			next;
			mes "[哈肖基]";
			mes "有两个淘气孩子，";
			mes "^3355FF‘查鲁查鲁’^000000和";
			mes "^3355FF‘马塞尔’^000000。他们经常来看我的节目。我猜你从坎塔塔那里听过故事？";
			next;
			mes "[哈肖基]";
			mes "总之，被雪雪抱在怀里保护的两个婴儿？没错，就是他们。但查鲁查鲁和马塞尔似乎不知道是雪雪救了他们。";
			next;
			mes "[哈肖基]";
			mes "雪雪告诉我，他在两个孩子还是婴儿时，让身体飞到空中挡住即将击中他们的巨大火球。为了他们，他愿意牺牲自己。";
			next;
			mes "[哈肖基]";
			mes "去见见那两个孩子吧？他们也许会告诉你我们从未有机会听到的故事。好吧，祝你好运~！拜拜！";
			set xmas_npc,9;
			close;
		} else {
			mes "[哈肖基]";
			mes "啊……^3355FF雪雪^000000？";
			mes "我当然认识他！不知道雪雪的人才是这里真正的外乡人！有时我会和他聊聊天……";
			next;
			mes "[哈肖基]";
			mes "他是我节目很好的观众。但说实话，我不确定他是否真的喜欢。大多数人似乎不喜欢我的笑话。";
			next;
			mes "[哈肖基]";
			mes "这完全让我困惑！他们怎么会不喜欢世界上最好的笑话？！唉~";
			next;
			mes "[哈肖基]";
			mes "嗯，抱歉！";
			mes "总之，雪雪";
			mes "是个很棒的人！";
			mes "啦啦啦~！";
			mes "嘟嘟嘟嘟";
			mes "圣诞快乐——！！";
			close;
		}
	case 3:
		mes "[哈肖基]";
		mes "啦啦啦~！";
		mes "嘟嘟嘟嘟";
		mes "圣诞快乐~！";
		close;
	}
}
// 保持翻译切片物理行数

xmas,206,168,4	script	Little Boy	706,{
	if (xmas_npc == 9) {
		mes "[查鲁查鲁]";
		mes "呃？";
		mes "雪雪？";
		next;
		mes "[查鲁查鲁]";
		mes "嗯……";
		mes "他是个善良的雪人！";
		mes "想知道更多关于雪雪的事？嗯，我没那么聪明！去问马塞尔！";
		close;
	} else {
		mes "[查鲁查鲁]";
		mes "圣诞快乐快乐！";
		mes "嘿嘿嘿嘿~！";
		next;
		mes "[查鲁查鲁]";
		mes "你和那边的小丑说话了吗？他是不是超级无聊？（-.-）";
		next;
		mes "[查鲁查鲁]";
		mes "马塞尔和我看他的节目时，感觉自己越来越笨~";
		next;
		mes "[马塞尔]";
		mes "查鲁查鲁！！注意你的言辞！怎么能这样说可怜的哈肖基？！他一直努力让我们开心！";
		next;
		mes "[查鲁查鲁]";
		mes "好啦，好啦。";
		mes "随便吧~";
		mes "我早就知道了！";
		mes "但他一点也不好笑！";
		mes "我宁愿和^3355FF雪雪^000000待在一起~";
		next;
		mes "[查鲁查鲁]";
		mes "算了，如果你还没去见雪雪，至少去看他一次。他很有趣！";
		next;
		mes "[查鲁查鲁]";
		mes "圣诞快乐！";
		mes "在露提享受假期吧~！";
		close;
	}
}

xmas,208,168,4	script	Little Girl	703,{
	if (xmas_npc == 9 || xmas_npc == 10) {
		switch(xmas_npc) {
		case 9:
			mes "[马塞尔]";
			mes "你是说雪雪？";
			mes "我当然认识他！";
			next;
			mes "[马塞尔]";
			mes "他是个善良又有趣的人！";
			mes "正如查鲁查鲁一直说的，他比哈肖基更好笑~（但别让哈肖基知道！）";
			next;
			mes "[马塞尔]";
			mes "查鲁查鲁和我是孤儿，完全不记得父母。我们由露提居民抚养长大。";
			next;
			mes "[马塞尔]";
			mes "坎塔塔叔叔和塔琴泽阿姨把我们当亲生孩子，波兹和达芙就像我们的兄弟姐妹！";
			next;
			mes "[马塞尔]";
			mes "他们都善良慷慨，我们一直感激他们对我们的照顾。";
			next;
			mes "[马塞尔]";
			mes "我还听说雪雪也没有爸爸妈妈。我也听说雪雪和我们不是在这里出生，而是在别的地方。";
			next;
			mes "[马塞尔]";
			mes "听说雪雪和我们来自同一个地方，虽然我还不确定。但我知道雪雪和我身上有同样的烧伤。";
			next;
			mes "[马塞尔]";
			mes "查鲁查鲁和我背上有旧烧伤，雪雪肚子上有一块黑色污迹。所以我想我们是同时被烧伤的……";
			next;
			mes "[Marcell]";
			mes "哦，我明白了……";
			mes "你想了解雪雪的一切，是因为想成为他的朋友！他知道后一定很开心！哦！也许他会送你礼物！祝你好运！";
			set xmas_npc,10;
			close;
		case 10:
			mes "[Marcell]";
			mes "你比任何人都了解雪雪！请去和雪雪先生聊聊，他知道你关心他一定很开心。圣诞快乐！";
			close;
		}
	} else {
		mes "[Marcell]";
		mes "圣诞快乐~！";
		next;
		mes "[Marcell]";
		mes "外面冷死了……！查鲁查鲁难以忍受的笑话让我更冷。风也刮得这么大！";
		next;
		mes "[Marcell]";
		mes "你知道吗？雪雪有特殊力量。他能像圣诞老人一样制作许多礼物！很棒吧？";
		next;
		mes "[Marcell]";
		mes "嗯？你脸上那是什么表情？雪雪体内有一个大礼物袋，想送礼物时就会拿出来。有什么难以相信的？";
		close;
	}
}

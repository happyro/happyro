			mes "如果你遇到Sapha认证，请回来找我。";
			next;
			mes "[Kareka]";
			mes "我可以为你的^990099El Dicastes之光^000000饰品附加魔法。";
			close;
		}
		mes "[Kareka]";
		mes "你是来唤醒^990099El Dicastes之光^000000的无限力量。";
		next;
		if (select("请说明。:我想升级。") == 1) {
			mes "[Kareka]";
			mes "我听说城外的一些工匠也能为装备施法。";
			next;
			mes "[Kareka]";
			mes "我也一样，不过至少我不会摧毁装备。";
			next;
			mes "[Kareka]";
			mes "如果你带来Sapha认证，我可以为你的^990099El Dicastes之光^000000施加1到3阶段的魔法。";
			next;
			mes "[Kareka]";
			mes "当然，这是在原有魔法上附加法术，所以不能保证一次就得到你想要的效果。";
			close;
		}
		if (countitem(2844) < 1) {
			mes "[Kareka]";
			mes "你没有穿戴或携带要升级的装备。";
			close;
		}
		set .@v$, "ring2";
		set .@Items_, 2844;
	}
	else {
		mes .@n$;
		set .@cat_hi, rand(1,30);
		if (.@cat_hi == 1) mes "这里很难找到鱼。找不到鱼的话，Jahbong会忘记自己很忙，看到鱼尾还会生气。";
		else if (.@cat_hi == 2) mes "呜……我昨天在毯子上尿尿，被人用长柄勺惩罚了。";
		else if (.@cat_hi == 3) mes "我有时梦见巨人在摸我的头。但我觉得烦恼多于害怕。";
		else if (.@cat_hi == 4) mes "新手Jarute，Ahat看起来不像Sapha。";
		else if (.@cat_hi == 5) mes "我们的人说Ahat看起来像一只漂亮的猫。";
		else if (.@cat_hi == 6) mes "我听说Manuk首都有一位高超的装备升级工匠。";
		else if (.@cat_hi == 7) mes "呜……我觉得最近自己的声音不太正常。应该是天气的原因。";
		else if (.@cat_hi == 8) mes "有时我会大声喊叫，但只是因为心情好。不用惊慌。";
		else if (.@cat_hi == 9) mes "看到一堆东西时，我就想用四只爪子跳上去。";
		else if (.@cat_hi == 10) mes "我前世一定是一只猫。";
		else if (.@cat_hi == 11) mes "我又梦见那个巨人。我烦躁地挥舞爪子，他却一直摸我的头。";
		else if (.@cat_hi == 12) mes "没错！！Ahat看起来像人类的传闻是真的吗？！";
		else if (.@cat_hi == 13) mes "我听说这只黑色捕虫草拥有枯萎花。";
		else if (.@cat_hi == 14) mes "附近有个叫捕虫草的人，他那里有锋利叶片。";
		else if (.@cat_hi == 15) mes "附近有个叫捕虫草的人，他那里有大叶片。";
		else if (.@cat_hi == 16) mes "我建议从附近的Draco那里获得。但它们只会随机掉落，所以你可能会空手而归……";
		else mes "嗯……这对你也许不重要，不过。";
		next;
		mes .@n$;
		if (countitem(6304) < 1) {
			if (.@re$ == "Brare") {
				mes "哦……没有Sapha认证吗？";
				next;
				mes .@n$;
				mes "所以你一个也没有……";
				next;
				mes .@n$;
				mes "真遗憾。它们非常有用，你知道的……";
				close;
			} else if (.@re$ == "Mancho") {
				mes "在这座城市努力工作，就能获得Sapha兑换认证。";
				next;
				mes .@n$;
				mes "如果你遇到这种认证，能带给我吗？";
				next;
				mes .@n$;
				mes "我们可以交换，你不会后悔。";
				close;
			} else if (.@re$ == "Jalapeno") {
				mes "为了见到Ahat，我已经收集Sapha兑换认证一年了。";
				next;
				mes .@n$;
				mes "但我离目标还很远，因为像我这样的低等生物要见他，需要高职位和一些贿赂。";
				next;
				mes .@n$;
				mes "如果你有多余的Sapha兑换认证，请分给我。我保证会用服务回报你，这是别处得不到的。";
				close;
			}
		}
		if (.@re$ == "Brare") {
			mes "你想用黄金铃铛显得华丽吗？";
			set .@Items_,2843;
			set .@v$, "ring1";
		}
		else if (.@re$ == "Mancho") {
			mes "你一定对^800080野性尾巴^000000感兴趣吧？";
			set .@Items_,2564;
			set .@v$, "robe";
		}
		else if (.@re$ == "Jalapeno") {
			mes "你是来找野性靴的吗？我正好有适合你的物品。";
			set .@Items_,2463;
			set .@v$, "shoe";
		}
		next;
		switch(select("请说明。:我想重置。:我想升级。")) {
			case 1:
				if (.@re$ == "Brare") {
					mes .@n$;
					mes "嗯。^990099黄金铃铛^000000是授予族中最优秀、最勇敢战士的饰品。";
					next;
					mes .@n$;
					mes "第一和第二阶段会随机施加技能，但";
					next;
					mes .@n$;
					mes "第三次升级时物品有损坏风险。";
				} else if (.@re$ == "Mancho") {
					mes .@n$;
					mes "你想让我说明升级吗？";
					next;
					mes .@n$;
					mes "嗯。^990099野性尾巴^000000是独特物品，看起来就像我们的尾巴。";
					next;
					mes .@n$;
					mes "它不仅坚固温暖，也足以附加魔法。";
					next;
					mes "[Mancho]";
					mes "嗯……它和^990099野性靴^000000一样，在第三阶段升级时有损坏风险。";
				} else if (.@re$ == "Jalapeno") {
					mes .@n$;
					mes "你想让我说明升级吗？";
					next;
					mes .@n$;
					mes "嗯。^990099野性靴^000000非常独特。鞋匠根据我们的脚型设计了这件物品。";
					next;
					mes .@n$;
					mes "我不知道实际使用的材料，但它足以附加最多3种升级魔法。";
					next;
					mes .@n$;
					mes "嗯……有些物品确实会在第三次升级时损坏，发生这种事时总有客人抱怨……喵";
					next;
					mes .@n$;
					mes "... I almost died in one occasion. (murmuring)";
				}
				close;
			case 2:
				mes .@n$;
				if (.@re$ == "Mancho") {
					mes "你想重置吗？";
					mes "这会^990000摧毁正在升级的野性尾巴^000000并取消所有记录。确定吗？";
				}
				else if (.@re$ == "Jalepeno") {
					mes "重置？确定吗？";
					mes "这会^990000摧毁正在升级的野性靴^000000并取消所有记录。确定吗？";
				}
				else if (.@re$ == "Brare") {
					mes "重置！！";
					mes "这会^990000摧毁正在升级的黄金铃铛^000000并取消所有记录。确定吗？";
				}
				next;
				if(select("下次再说。:请重置。") == 1) {
					mes .@n$;
					mes "准备好后，";
					mes "请再回来。";
					close; 
				}
				if (countitem(.@Items_) < 1) {
					mes .@n$;
					mes "那么，先脱下装备。";
					close; 
				}
				specialeffect2 EF_OVERTHRUST;
				mes .@n$;
				if (.@re$ == "Brare") mes "我已按你的要求收回所有装备并删除记录。现在你的装备和记录都已清除。";
				else mes "我只是按要求做事。我已收回所有装备并取消全部记录。";
				delitem .@Items_,1;
				setd "ep13_3_"+.@v$, 0;
				close;
			case 3: break;
		}
		if (countitem(.@Items_) < 1) {
			mes .@n$;
			mes "但是……";
			mes "你似乎没有穿戴或携带要升级的装备。";
			close; 
		}
	}
	if (getd("ep13_3_"+.@v$) == 0) {
		mes .@n$;
		mes "我正在准备";
		mes "第一次升级。";
		mes "装备升级后，";
		mes "在摧毁它之前，";
		mes "你无法更改升级内容。";
		next;
		mes .@n$;
		mes "第一次升级需要^8000801个Sapha认证^000000。要继续吗？";
		set .@req, 1;
	}
	else if (getd("ep13_3_"+.@v$) < 9) {
		mes .@n$;
		mes "我正在准备";
		mes "第二次升级。";
		mes "装备升级后，";
		mes "在摧毁它之前，";
		mes "你无法更改升级内容。";
		next;
		mes .@n$;
		mes "第二次升级需要^9900992个Sapha兑换认证^000000。要继续吗？";
		set .@req, 2;
	} 
	else if (getd("ep13_3_"+.@v$) < 69) {
		mes .@n$;
		mes "我正在准备";
		mes "第三次升级。";
		mes "装备升级后，";
		mes "在摧毁它之前，";
		mes "你无法更改升级内容。";
		next;
		mes .@n$;
		mes "最重要的是，";
		mes "装备损坏的风险";
		mes "在第三次升级时很高！";
		mes "这个流程还需要^9900993个Sapha兑换认证^000000。";
		next;
		mes .@n$;
		mes "请记住，";
		mes "这是一个精细的过程，";
		mes "要向装备施加巨大的力量。";
		mes "准备好了吗？";
		set .@req, 3;
	}
	else if (getd("ep13_3_"+.@v$) > 68 && countitem(.@Items_)) {
		mes .@n$;
		mes "你完成了";
		mes "第三次升级。";
		next;
		mes .@n$;
		mes "如果你不喜欢";
		mes "装备升级结果，";
		mes "我可以取回装备";
		mes "并删除所有记录";
		mes "。";
		next;
		if (select("我就使用它。:请收回它。") == 1) {
			mes .@n$;
			mes "你改变主意时，随时回来。";
			mes "请再回来。";
			close;
		}
		specialeffect2 EF_OVERTHRUST;
		mes .@n$;
		mes "我已经删除所有之前的升级记录，";
		mes "可以从头开始，使用";
		mes "没有升级记录的新装备";
		mes "你带来的装备。";
		delitem .@Items_,1;
		setd "ep13_3_"+.@v$, 0;
		close;
	}
	else {
		mes .@n$;
		mes "嗯？";
		mes "你想从我这里得到什么吗？";
		setd "ep13_3_"+.@v$, 0;
		close;
	}
	next;
	if(select("下次再说。:我想升级。") == 1) {
		mes .@n$;
		mes "准备好后，";
		mes "请再回来。.";
		close; 
	}
	if (countitem(6304) < .@req) {
		mes .@n$;
		mes "但你的兑换认证不够。你需要"+.@req+"个Sapha兑换认证才能进行"+((.@req == 3)?"third":((.@req == 2)?"second":"first"))+"阶段升级。";
		close;
	}
	mes .@n$;
	mes "那么我们开始吧。";
	next;
	specialeffect2 EF_REPAIRWEAPON;
	progressbar "ffff00",3;
	delitem 6304,.@req;
	if (getd("ep13_3_"+.@v$) == 0) {
		if (.@re$ == "Kareka") {
			set .@enc_en, rand(1,45);
			setarray .@rates, 45,32,30,22,20,12,10,2;
		}
		else {
			set .@enc_en, rand(1,40);
			setarray .@rates, 40,34,30,24,20,14,10,4;
		}
		setarray .@var, 1,2,3,4,5,6,7,8;
	}
	else if (getd("ep13_3_"+.@v$) <= 8) {
		if (.@re$ == "Kareka") {
			set .@enc_en, rand(1,45);
			setarray .@rates, 45,32,30,17,15,2;
		}
		else {
			set .@enc_en, rand(1,30);
			setarray .@rates, 30,24,20,14,10,4;
		}
		setarray .@var, 10,20,30,40,50,60;
	}
	else if (getd("ep13_3_"+.@v$) <= 68) {
		if (compare(.@v$,"ring")) {
			set .@enc_en, rand(1,90);
			setarray .@rates, 90,62,60,32,30,2;
			setarray .@var, 100,200,400,500,700,800;
		}
		else {
			set .@crs_yong, 140 - (ep13_yong1 / 100);
			if (.@crs_yong < 95) set .@crs_yong, 95;
			set .@enc_en, rand(1,.@crs_yong);
			if (.@enc_en > 90) {
				delitem .@Items_,1;
				setd "ep13_3_"+.@v$, 0;
				mes .@n$;
				if (.@re$ == "Jalepano") mes "哈哈哈。看吧，我早就说过。哦，抱歉，忘掉我刚才说的话！！";
				else if (.@re$ == "Mancho") mes "贪婪是投资失败的原因。啧啧。";
				else if (.@re$ == "Brare") mes "哦不……！！！！黄金铃铛怎么了！";
				close;
			}
			setarray .@rates, 90,75,65,60,45,35,30,15,5;
			setarray .@var, 100,200,300,400,500,600,700,800,900;
		}
	}
	else {
		mes .@n$;
		mes "我完成了。嘿嘿";
		close;
	}
	
	// Enchant Constants
	// Ex: .@dex[1]: DEX + 1 | .@cri[5]: CRI + 5 | .@eva[12]: FLEE + 12
	set .@matk[1], 4760; set .@matk[2], 4761;
	set .@eva[6], 4762;	set .@eva[12], 4763;
	set .@cri[5], 4764;	set .@cri[7], 4765;
	set .@atk[2], 4766;	set .@atk[3], 4767;
	set .@dex[1], 4720;	set .@dex[2], 4721;	set .@dex[3], 4722;
	set .@int[1], 4710;	set .@int[2], 4711;	set .@int[3], 4712;	
	set .@agi[1], 4730;	set .@agi[2], 4731;	set .@agi[3], 4732;
	
	// Enchant attribute is determined by the digit position of variable value (ep13_3_<type>).
	// For example, assume the variable value is 516:
	// .@f_<slot>[<index>]
	// slot:	2	3	4
	// index:	5 	1 	6
	
	// Enchant Format
	if (compare(.@v$,"ring")) setarray .@f_2[1],.@agi[1],.@agi[2],.@int[1],.@int[2],.@dex[1],.@dex[2];
	else setarray .@f_2[1],.@agi[1],.@agi[2],.@agi[3],.@int[1],.@int[2],.@int[3],.@dex[1],.@dex[2],.@dex[3];
	setarray .@f_3[1],.@agi[1],.@agi[2],.@int[1],.@int[2],.@dex[1],.@dex[2];
	setarray .@f_4[1],.@atk[2],.@atk[3],.@cri[5],.@cri[7],.@eva[6],.@eva[12],.@matk[1],.@matk[2];
	set .@str$, getd("ep13_3_"+.@v$) + "";
	set .@len, getstrlen(.@str$);
	set .@j, 4;
	set .@c, 1;
	while ((.@len - .@c) > -1 && getd("ep13_3_"+.@v$)) {
		setd ".@e_"+.@j, getd(".@f_"+.@j+"["+atoi(charat(.@str$,.@len-.@c))+"]");
		set .@c, .@c + 1;
		set .@j, .@j - 1;
	}
	for (set .@size, getarraysize(.@rates); .@r <= .@size; set .@r, .@r + 1) {
		if (.@enc_en > .@rates[.@r]) {
			setd ".@e_"+.@j, getd(".@f_"+.@j+"["+.@r+"]");
			break;
		}
	}
	delitem .@Items_,1;
	getitem2 .@Items_,1,1,0,0,.@e_1,.@e_2,.@e_3,.@e_4;
	setd "ep13_3_"+.@v$, .@var[.@r-1] + getd("ep13_3_"+.@v$);
	close;
}
dic_fild01,240,198,2	duplicate(dic_enc#main)	Jalapeno#pa0829	495
dic_fild01,251,183,3	duplicate(dic_enc#main)	Brare#pa0829	495
dic_fild01,259,172,3	duplicate(dic_enc#main)	Mancho#pa0829	495

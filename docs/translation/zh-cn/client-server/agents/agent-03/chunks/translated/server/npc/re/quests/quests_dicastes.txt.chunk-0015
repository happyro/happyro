dic_fild01,228,159,4	script	Jahbong#pa0829	496,{
	mes "[Jahbong]";
	if (countitem(6304) < 1) {
		mes "你还没有获得Sapha认证吗？";
		next;
		mes "[Jahbong]";
		mes "拿到后回来找我。我会用好东西交换。";
		close; 
	}
	set .@cattalkj,rand(1,9);
	if (.@cattalkj == 1) mes "别碰我的背！我可能会无意识地咬你。";
	else if (.@cattalkj == 2) mes "酒馆老板Shay拿走了东西，要制作奇怪的物品！小心！";
	else if (.@cattalkj == 3) mes "我们猫能跳到自身高度的5倍。很酷吧？不过现在别让我从这里跳。";
	else if (.@cattalkj == 4) mes "为了保持漂亮的毛发，我必须勤于梳理。";
	else if (.@cattalkj == 5) mes "我每天都要梳理自己，保持毛发闪亮蓬松。但我的毛发本来就不漂亮。真悲伤。";
	else if (.@cattalkj == 6) mes "你应该用双爪恭敬地接收Sapha认证。不这样做的猫不配得到认证！";
	else if (.@cattalkj == 7) mes "我其实不怎么说话！Ahat看起来像……喵喵喵……抱歉。";
	else if (.@cattalkj == 8) mes "喵~~~~~~~~~~";
	else mes "毛线是安抚猫的好办法。";
	next;
	mes "[Jahbong]";
	mes "你为什么在这里？";
	mes "Jahbong会用^8000801个Sapha认证^000000交换^8000801件物品^000000！";
	next;
	set .@i, select("只是来看看你有什么。:我想要野性靴！:给我野性尾巴！:给我黄金铃铛！:买你要多少钱？")-1;
	switch (.@i) {
		case 0:
			mes "[Jahbong]";
			mes "喵！";
			next;
			mes "[Jahbong]";
			mes "^8000801Feral Boots^000000 are shoes for your feet! Buy one and Jalapeno over there will refine it for you!";
			next;
			mes "[Jahbong]";
			mes "^8000801Feral Tail^000000 is pretty rough! Mancho over there can help you fix it!!";
			next;
			mes "[Jahbong]";
			mes "^8000801Golden Bell^000000 is an accessory. Brare spent 40 years making this! Or maybe 4 years! Oh well, come back when you need anything!";
			next;
			mes "[Jahbong]";
			mes "有些疯狂冒险家竟然问能不能买我！Jahbong不卖！你再问我就咬你！！";
			close;
		case 4:
			mes "[Jahbong]";
			mes "喵呜呜呜呜呜呜呜呜呜！！！！~~喵呜呜呜呜呜！！！！！";
			next;
			mes "- ^800080Jahbong goes wild^000000. -";
			next;
			mes "[Jahbong]";
			mes "我不是物品！！如果你把我当物品，我绝不手下留情！！";
			next;
			mes "- He may react extremely, but Jahbong doesn't seem to be really angry. -";
			close;
		default:
			break;
	}
	mes "[Jahbong]";
	mes "你真的要买东西吗？！";
	next;
	if (select("不要:给我！！！") == 1) {
		mes "[Jahbong]";
		mes "好！";
		close;
	}
	setarray .@items[1],2463,2564,2843;
	mes "[Jahbong]";
	mes "给你！";
	delitem 6304,1;
	getitem .@items[.@i],1;
	close;
}

// Cat Paw Agent
//============================================================
moc_para01,44,19,3	script	Cat Paw Agent#gekk	496,{
	if (BaseLevel < 70)	{
		mes "[Cat Paw Agent]";
		mes "嘿，人类！你也是来提交请求的吗？什么时候轮到我？";
		next;
		mes "[Cat Paw Agent]";

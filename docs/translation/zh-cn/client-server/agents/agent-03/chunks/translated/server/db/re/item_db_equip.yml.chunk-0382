  - Id: 450010
    AegisName: Europa_Robe_J
    Name: 欧罗巴长袍
    Type: Armor
    Buy: 200000
    Weight: 500
    Defense: 35
    Slots: 1
    Locations:
      Armor: true
    ArmorLevel: 1
    EquipLevelMin: 100
    Refineable: true
    Script: |
      .@r = getrefine();
      .@a = (readparam(bVit)+readparam(bLuk))/10;
      bonus bMdef,10;
      bonus bVit,5;
      bonus bLuk,5;
      bonus bDelayrate,-10;
      if (.@r>=7) {
         bonus2 bSubRace,RC_Player_Human,7;
         bonus2 bSubRace,RC_Player_Doram,7;
         bonus bUnbreakableArmor;
      }
      if (.@r>=8) {
         bonus bBaseAtk,10*.@a;
         bonus bMatk,10*.@a;
      }
      if (.@r>=9)
         bonus2 bResEff,Eff_Stone,10000;

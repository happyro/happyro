  - Id: 450001
    AegisName: Atker_Plate
    Name: 攻击者增幅铠甲
    Type: Armor
    Defense: 120
    Slots: 1
    Locations:
      Armor: true
    Trade:
      NoDrop: true
      NoTrade: true
      NoCart: true
      NoStorage: true
      NoGuildStorage: true
      NoMail: true
      NoAuction: true
    ArmorLevel: 1
    EquipLevelMin: 100
    Refineable: true
    Script: |
      bonus bBaseAtk,100;
      bonus bDelayrate,-5;
      .@r = getrefine();
      if (.@r>=2) {
         bonus bAtkRate,.@r/2;
      }
      if (.@r>=3) {
         bonus bCritAtkRate,.@r/3;
      }
      if (.@r>=7) {
         bonus bBaseAtk,50;
      }
      if (.@r>=9) {
         bonus bDelayrate,-5;
      }

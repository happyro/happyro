			mes "我知道的就这些。";
			mes "如果你去探险，";
			mes "要小心那些熊，好吗？";
			mes "它们也许很可爱，";
			mes "但出了名的凶猛！";
			close;
		}
	case 2:
		mes "[弗朗茨]";
		mes "哦，好吧。";
		mes "你很忙，还有事情要做，";
		mes "我明白。你可能得马上赶去某个地方。";
		mes "嗯，知道了。";
		mes "";
		next;
		mes "[弗朗茨]";
		mes "我……";
		mes "我也有事情";
		mes "应该去做。对，我很忙。";
		mes "";
		close;
	}
}

//===== Current Version: =====================================
//= 1.0
//===== Compatible With: =====================================
//= rAthena Project
//===== Description: =========================================
//= [Official Conversion]
//= Guides for the town of Moscovia.
//===== Additional Comments: =================================
//= 1.0 First Version. [Kisuka]
//============================================================

moscovia,161,76,4	script	Moscovia Guide#mosk	959,{
	mes "[莫斯科比亚向导]";
	mes "欢迎来到莫斯科比亚";
	mes "这里是无尽大海上的";
	mes "天堂";
	mes "美丽的景色与阳光";
	mes "一定会让你开心！";
	next;
	mes "[莫斯科比亚向导]";
	mes "我受莫斯科比亚宫殿派遣";
	mes "负责引导游客并提供";
	mes "这座城镇的信息。";
	mes "如果你有问题，请尽管问我。";
	next;
	switch(select("询问可以去哪里。:删除小地图上的所有标记。:取消。")) {
		case 1:
			mes "[莫斯科比亚向导]";
			mes "你想去哪里？";
			next;
			switch(select("宫殿:防具商店:工具商店:旅馆:取消")) {
				case 1:
					mes "[莫斯科比亚向导]";
					mes "宫殿就在^ff0000+^000000处，位于";
					mes "北海尽头的";
					mes "符文-米德加尔特。";
					mes "那里住着我们的领主——";
					mes "莫斯科比亚的沙皇及其侍从。";
					close2;
					viewpoint 1,257,138,1,0xFF0000;
					end;
				case 2:
					viewpoint 1,185,187,2,0x00FF00;
					mes "[莫斯科比亚向导]";
					mes "防具商店位于城镇";
					mes "西南角。";
					mes "你可以在那里买到莫斯科比亚";
					mes "顶尖工匠制作的防具。";
					close;
				case 3:
					mes "[莫斯科比亚向导]";
					mes "工具商店就在城镇中心";
					mes "正南方。";
					mes "旅行所需的各种物品";
					mes "都能在那里找到。";
					close2;
					viewpoint 1,223,174,3,0x00FF00;
					end;
				case 4:
					mes "[莫斯科比亚向导]";
					mes "‘黏草树’旅馆就在城镇中心";
					mes "正北方。";
					mes "如果你需要休息，";
					mes "那里是最好的去处。";
					close2;
					viewpoint 1,229,208,4,0x3355FF;
					end;
				case 5:
					close;
			}
		case 2:
			mes "[莫斯科比亚向导]";
			mes "我已经删除了小地图上的所有标记。";
			mes "以后想添加标记时，";
			mes "可以再来找我。";
			viewpoint 2,257,138,1,0xFF0000;
			viewpoint 2,185,187,2,0x00FF00;
			viewpoint 2,223,174,3,0x00FF00;
			viewpoint 2,229,208,4,0x3355FF;
			close;
		
		case 3:
			mes "[莫斯科比亚向导]";
			mes "一个人四处走走也不错。";
			mes "保重。";
			close;
	}
}

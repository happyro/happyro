			mes "如果你真的认真研究 Homunculus，最好放弃，寻找新的炼金兴趣。";
			close;
		}
	}
	if (BaseJob == Job_Alchemist && bioeth > 3) {
		mes "[Kellasus]";
		mes "抱歉，我拒绝教你任何 Homunculus 技能。";
		next;
		mes "[Kellasus]";
		mes "你这样问我本该感到被冒犯，但我也曾像你一样，所以能理解你的感受。不过，我现在的看法已大不相同……";
		close;
	}
	if (BaseJob == Job_Alchemist && bioeth == 3) {
		mes "[Kellasus]";
		mes "哦，你好，什么风把你吹来了？作为炼金领域的前辈，遇到问题时我可以给你建议……";
		next;
		if (select("教我 Homunculus 技能。:没什么。") == 1) {
			mes "[" + strcharinfo(0) + "]";
			mes "我想让你教我如何创造 Homunculus。";
			next;
			mes "[Kellasus]";
			mes "...";
			mes "你说什么？我好像没听清。";
			next;
			mes "[" + strcharinfo(0) + "]";
			mes "我说……我想让你教我创造 Homunculus 的技能。";
			next;
			mes "[Kellasus]";
			mes "我说了这么多……警告炼金术士不要接触禁忌知识，你还想创造 Homunculus？！";
			next;
			mes "[Kellasus]";
			mes "也许我不该提起那个话题。但我仍不明白你为什么突然想学这些技能。是的，我确实可以教你……";
			next;
			set bioeth,4;
			mes "[Kellasus]";
			mes "但无论什么理由，我都拒绝把 Homunculus 知识传给任何人。你现在应该知道了。我真没想到你竟敢开口！";
			close;
		}
		mes "[Kellasus]";
		mes "不？嗯，自己学习当然好，但有时向比你经验丰富的人求助也不错。";
		close;
	}
	if (BaseJob == Job_Alchemist && bioeth == 2) {
		mes "[Kellasus]";
		mes "啊，你回来了……";
		mes "你一定想知道，我为什么一直警告你，";
		mes "不要为了获得本应被禁止的知识";
		mes "而使用炼金术的危险。";
		mes "";
		mes "";
		next;
		mes "[Kellasus]";
		mes "现在知道总比以后才发现、";
		mes "却毫无准备要好。炼金术中有一项技能，";
		mes "它创造出不应存在的生命，";
		mes "违背了自然法则。";
		mes "";
		mes "";
		next;
		mes "[Kellasus]";
		mes "这是一项极其危险的技能，";
		mes "源于人类的傲慢。生命是美丽而珍贵的礼物，";
		mes "我们不敢随意干涉。";
		mes "";
		mes "";
		mes "";
		next;
		mes "[Kellasus]";
		mes "我一生最大的耻辱，";
		mes "就是曾为那个知识领域做出贡献。";
		mes "那时我年轻而任性，";
		mes "骄傲到不肯承认自己在扮演上帝。";
		mes "";
		mes "";
		next;
		mes "[Kellasus]";
		mes "我甚至成为了制作";
		mes "^FF0000Homunculi^000000 技艺最高超的炼金术士。";
		mes "但我已经改变了。";
		mes "我不会……再也不会创造它们了。";
		mes "";
		mes "";
		next;
		mes "[Kellasus]";
		mes "炼金术是一门不可思议的学问，";
		mes "很高兴你投身其中，但要永远记住，";
		mes "这门科学既能造福世人，";
		mes "也有被滥用的巨大可能。";
		mes "";
		next;
		mes "[Kellasus]";
		mes "我只担心你对知识的追求，";
		mes "以及揭开未知的无尽好奇，";
		mes "会把你引向 Homunculus 的道路。";
		mes "为了你自己，别考虑这个想法。";
		next;
		set bioeth,3;
		mes "[Kellasus]";
		mes "记住，所有生命都很珍贵。";
		mes "只要你的动机是善良的，";
		mes "不受名利欲望污染，";
		mes "并且为人类的更大利益而努力，就不会有问题。";
		close;
	}
	if (BaseJob == Job_Alchemist && bioeth == 1) {
		mes "[Kellasus]";
		mes "啊，又是你。既然你来了，";
		mes "让我问你一个问题。";
		mes "你究竟怎么看炼金术？";
		mes "";
		mes "";
		next;
		mes "[Kellasus]";
		mes "等等，别回答。";
		mes "作为这个领域经验更丰富的人，";
		mes "我认为这个问题的答案";
		mes "比你想象的更加复杂。";
		mes "";
		mes "";
		next;
		mes "[Kellasus]";
		mes "大多数人把炼金术士看作贪婪的科学家，";
		mes "以为我们只用技能炼金。";
		mes "当然，学习炼金是基础训练的一部分。";
		mes "";
		mes "";
		next;
		mes "[Kellasus]";
		mes "但学习炼金只是更宏大事业的一部分。";
		mes "所有炼金术士都必须努力驾驭自然，";
		mes "为人类谋福。为此需要学习每一门科学。";
		mes "";
		mes "";
		mes "";
		next;
		mes "[Kellasus]";
		mes "医学、化学、生物学、地质学，";
		mes "天文学、占星术、地相学，";
		mes "数学、物理学，甚至哲学，";
		mes "都必须由合格的炼金术士学习。";
		mes "";
		mes "";
		next;
		set bioeth,2;
		mes "[Kellasus]";
		mes "一旦进入炼金术令人兴奋的广阔世界，";
		mes "就没有回头路。尽力学习一切，";
		mes "永远不要忘记自己对人类负有责任。";
		mes "";
		close;
	}
	if (BaseJob == Job_Alchemist) {
		mes "[Kellasus]";
		mes "你也是炼金术的实践者，对吧？";
		mes "我已经很久没和";
		mes "这么年轻的同僚交谈了……";
		mes "";
		mes "";
		mes "";
		next;
		mes "[Kellasus]";
		mes "作为你的前辈，我鼓励你专心训练。";
		mes "通过解开科学谜题启迪自己，";
		mes "满足你的好奇心。";
		mes "";
		mes "";
		mes "";
		next;
		mes "[Kellasus]";
		mes "但请记住我的话……";
		mes "科学中有些秘密绝不能被人类发现。";
		mes "不要骄傲到去寻找禁忌真相。";
		mes "";
		mes "";
		mes "";
		next;
		set bioeth,1;
		mes "[Kellasus]";
		mes "祝你学习顺利，希望你永远不要";
		mes "把寻找答案当作屈服于";
		mes "贪婪和执念的借口。";
		mes "";
		mes "";
		mes "";
		close;
	}
	mes "[Kellasus]";
	mes "嗯。谁来决定什么是对、什么是错？";
	mes "什么应该被知晓，";
	mes "又有哪些秘密从未打算让人类理解？";
	mes "";
	mes "";
	next;
	mes "[Kellasus]";
	mes "很多人都会同意，只有上帝";
	mes "拥有掌控生死的权力。";
	mes "但炼金术确实为大胆之人提供了方法……";
	mes "";
	mes "";
	close;
}

lhz_in01,225,122,5	script	Skrajjad#qsk_al	754,{
	if (BaseJob == Job_Alchemist && bioeth > 4) {
		mes "[Skrajjad]";
		mes "关于 Homunculi，我已经把能教的都教给你了。";
		mes "希望我能在你探索并理解宇宙的求知之旅中帮到你。";
		mes "";
		mes "";
		next;
		mes "[Skrajjad]";
		mes "如果你还没去拜访 Keshibien，";
		mes "请去找他。他是召唤 Homunculus 技能大师，";
		mes "总是愿意尽力帮助年轻科学家。";
		mes "";
		mes "";
		mes "";
		close;
	}
	if (BaseJob == Job_Alchemist && bioeth == 4) {
		mes "[Skrajjad]";
		mes "啊，你就是那个有勇气";
		mes "请 Kellasus 教你炼金术的人。";
		mes "我必须说，我很欣赏你的态度，";
		mes "";
		mes "";
		if (Sex == SEX_MALE)
			mes "年轻人。现在，别担心……";
		else
			mes "年轻姑娘。现在，别担心……";
		next;
		mes "[Skrajjad]";
		mes "我理解 Kellasus 拒绝教你方法后";
		mes "你的感受，但那并不意味着";
		mes "你永远学不会创造 Homunculus。";
		mes "";
		mes "";
		mes "";
		next;
		mes "[Skrajjad]";
		mes "我相信，只要你向所有 Homunculus 专家学习，";
		mes "就能学会想学的东西。等你证明自己的认真，";
		mes "Kellasus 也许会改变对你的看法。";
		next;
		mes "[Skrajjad]";
		mes "让我教你我的 Homunculus 专长，";
		mes "^FF0000雾化^000000技能。其实没有 Kellasus 的技术，";
		mes "它没什么用，但作为起点已经足够好了。";
		mes "";
		mes "";
		mes "";
		next;
		mes "[Skrajjad]";
		mes "雾化技能是炼金术士技能，";
		mes "专门用于处理";
		mes "Homunculus。雾化技能在等级 1 掌握。";
		next;
		mes "[Skrajjad]";
		mes "这项技能能将 Homunculus 化为雾气，使其处于惰性化学状态。想想看，这很像冬眠。";
		next;
		mes "[Skrajjad]";
		mes "如果想恢复雾化的 Homunculus，就需要掌握 ^FF0000召唤 Homunculus^000000。";
		mes "你可以从 Keshibien 那里学习。记住……";
		next;
		mes "[Skrajjad]";
		mes "Homunculus 是活着的生物，不要随意将它们雾化或召回。这种行为不人道。";
		next;
		mes "[Skrajjad]";
		mes "‘尊重所有生命形态。’这是 Homunculus 专家的信条。现在去找 ^FF0000Keshibien^000000，让他教你召唤 Homunculus 技能。";
		next;
		set bioeth,5;
		mes "[Skrajjad]";
		mes "学习好运，希望你找到想要的答案。";
		close;
	}
	mes "[Skrajjad]";
	mes "炼金术很奇妙……它融合所有科学和许多知识领域，光是博学还不够……不……";
	next;
	mes "[Skrajjad]";
	mes "某种意义上，你必须样样精通才能精通炼金术。但对我们这些不断追问世界如何、为何运作的人来说，回报无比丰厚。";
	close;
}

lhz_in01,204,138,5	script	Keshibien#qsk_al	750,{
	if (BaseJob == Job_Alchemist && bioeth > 5) {
		mes "[Keshibien]";
		mes "希望你能善用我教你的东西。我很高兴能为你的炼金学习贡献力量。";
		next;
		mes "[Keshibien]";
		mes "现在，唯一有资格教你 Homunculus 复活技能的人是 Brocher。他……很有个性，但也是优秀的老师。";
		next;
		mes "[Keshibien]";
		mes "现在……他会在哪里？我知道他喜欢喝酒，也许你能在拉赫的酒馆找到他？";
		close;
	}
	if (BaseJob == Job_Alchemist && bioeth == 5) {
		mes "[Keshibien]";
		mes "哦！你一定是 Skrajjad 提到的人。你来找我学习召唤 Homunculus 技能？";
		next;
		mes "[Keshibien]";
		mes "首先，很高兴见到同行。我是 Keshibien，虽然专精这项技能，但总体只是普通炼金术士。";
		next;
		mes "[Keshibien]";
		mes "召唤 Homunculus 技能需要掌握雾化技能，技能等级 1 即可。它能召唤 Homunculus。目前很简单，对吧？";
		next;
		mes "[Keshibien]";
		mes "如果你有雾化的 Homunculus，就可以召唤它。否则，可以用这项技能和这些物品创造一个……";
		next;
		mes "[Keshibien]";
		mes "^FF00001 个胚胎^000000、^FF00001 根玻璃管^000000、^FF00001 颗生命种子^000000和^FF00001 份世界树露水^000000。";
		next;
		mes "[Keshibien]";
		mes "好了，这就是我能分享的技术信息。记住要善待 Homunculus。呃，前提是你召唤了一个。";
		next;
		mes "[Keshibien]";
		mes "不过在此之前，你需要学习只有 Kellasus 能教你的技巧。现在去找 ^FF0000Broncher^000000 向他学习，好吗？";
		next;
		mes "[Keshibien]";
		mes "Broncher 专精 Homunculus 复活技能。你应该能在城里某处找到他，";
		mes "不过我不知道他在哪里……";
		next;
		set bioeth,6;
		mes "[Keshibien]";
		mes "总之，很高兴认识你。希望你很快学会充分使用 Homunculus。不过，你还得说服 Kellasus……";
		close;
	}
	mes "[Keshibien]";
	mes "你好~你一定来自卢恩-米德加尔特，对吧？很高兴认识你。";
	next;
	mes "[Keshibien]";
	mes "听说那里的炼金术士很有本领。不知道我有没有机会和他们合作……";
	close;
}


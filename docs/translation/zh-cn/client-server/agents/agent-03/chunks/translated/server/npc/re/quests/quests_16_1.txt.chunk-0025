prt_cas,322,216,5	script	Maid#ep16wig02	1_F_04,{
	if (checkweight(1304,3) == 0) {
		mes "[Maid]";
		mes "哦，你不该带太多东西进来。";
		mes "如你所见，这里有很多易碎品。";
		next;
		mes "[Maid]";
		mes "你得把一些东西放在外面。如果包裹碰到餐具并把它们打碎，就麻烦了。";
		close;
	}
	.@name$ = strcharinfo(0);
	if (ep16_wig == 4) {
		mes "[Maid]";
		mes "我正在打扫厨房，这是最难清洁的地方。要清除这里所有污垢真的很难。";
		mes "我的手臂太弱，做不了这些。";
		next;
		mes "[Maid]";
		mes "我碰巧看到一个手臂强壮的人……那双手臂……你为什么来这里？";
		next;
		mes "[" + .@name$ + "]";
		mes "你好，我是受邀参加王室宴会的冒险者。你是今天下午打扫维格纳宅邸的女仆吗？";
		next;
		mes "[Maid]";
		mes "是的。我能为你做什么？";
		next;
		mes "[" + .@name$ + "]";
		mes "你有没有在维格纳宅邸看到^0000cd一个小盒子^000000？它应该在床边的桌上。盒子属于凯特琳公主。你见过吗？";
		next;
		mes "[Maid]";
		mes "见过。那是一个简约又雅致的盒子。我拿起它清洁桌面后放了回去，记得很清楚。";
		next;
		mes "[" + .@name$ + "]";
		mes "你离开房间时它还在那里吗？房间里没有其他人吗？";
		next;
		mes "[Maid]";
		mes "等等。我知道你想说什么。我们女仆经常遇到这种情况。";
		next;
		emotion ET_FRET;
		mes "[Maid]";
		mes "盒子不见了，你就^0000cd怀疑打扫房间的女仆^000000？对吗？";
		next;
		mes "[" + .@name$ + "]";
		mes "我没有怀疑你，只是^0000cd询问情况^000000来追查盒子。";
		next;
		emotion ET_FRET;
		mes "[Maid]";
		mes "但你心里还是有怀疑，对吧？";
		next;
		mes "[" + .@name$ + "]";
		mes "不，我没有怀疑你。请别误会。我只是问你什么时候见过它，以及那里是否还有其他人。";
		next;
		emotion ET_ANGER;
		mes "[Maid]";
		mes "哈，你对我不诚实。如果我说周围没人，就会被怀疑，对吧？";
		next;
		mes "[Maid]";
		mes "不过我可以告诉你，我没有拿它。至于房间里有没有其他人，嗯……";
		next;
		mes "[" + .@name$ + "]";
		mes "房间里有人，对吧？";
		next;
		mes "[Maid]";
		mes "有人吗？厨房太乱了，我无法集中思考。^0000cd如果清理干净，也许我能想起来^000000。";
		next;
		emotion ET_SLEEPY;
		mes "[Maid]";
		mes "哦，厨房很乱，我脑子里的思绪也很乱。真是又脏又乱！";
		next;
		mes "[" + .@name$ + "]";
		mes "我可以帮你打扫吗？";
		next;
		emotion ET_SMILE;
		mes "[Maid]";
		mes "哦，你愿意帮我吗？我会非常感激。这是^0000cd波利擦洗海绵^000000，请把这里每一寸都擦干净。";
		next;
		mes "[Maid]";
		mes "这是女仆专用擦洗海绵，有多种用途。它会教你如何清洁，好好利用吧。";
		next;
		mes "[Maid]";
		mes "你可能会惊讶，但这是不会伤害他人的安全擦洗海绵。别担心。";
		mes "这是传奇人物开发的擦洗海绵。";
		next;
		mes "[Maid]";
		mes "等等！清洁有一定的顺序。首先擦掉墙上的霉菌，然后清理油脂，最后打扫地板。";
		next;
		mes "[" + .@name$ + "]";
		mes "我……明白了。";
		erasequest 14478;// Searching for the Clue
		setquest 14479;// Clean-up out of Apology
		getitem 6928,3;// Poring_Loofah
		ep16_wig = 5;
		close;
	}
	if (ep16_wig > 4 && ep16_wig < 11) {
		mes "[Maid]";
		mes "你已经完成了吗？";
		mes "看来没有。我脑中的思绪还没理清。";
		next;
		mes "[Maid]";
		mes "等你用我给的擦洗海绵清理厨房回来，我想我就能回忆起来。";
		close;
	}
	if (ep16_wig == 11) {
		emotion ET_BEST;
		mes "[Maid]";
		mes "哇……厨房变得好干净！清理油脂真的需要强壮的手臂！";
		next;
		mes "[" + .@name$ + "]";
		mes "啊……我的手臂……房间里还有其他人吗？";
		next;
		mes "[Maid]";
		mes "你一定知道那是什么家族。那是鲁恩·米德加尔特最富有的家族。虽然只是临时住所，房间却装饰得十分用心。";
		next;
		mes "[Maid]";
		mes "那些华丽的家具和地毯……我从没见过那么白、那么大的虎皮。";
		next;
		mes "[" + .@name$ + "]";
		mes "你怎么突然谈起家具了？";
		next;
		mes "[Maid]";
		mes "天啊，你这么迟钝，要怎么和王室家族成员打交道？";
		mes "想想看。我为什么要^0000cd谈家具^000000？";
		next;
		mes "[" + .@name$ + "]";
		mes "……你可以^0000cd询问运送家具的人^000000。";
		next;
		mes "[Maid]";
		mes "我不能明说，但我想已经给了你足够线索。";
		mes "顺便问一下，盒子真的一开始就不见了吗？";
		next;
		mes "[" + .@name$ + "]";
		mes "你是什么意思？";
		next;
		mes "[Maid]";
		mes "这不是我的看法，只是人们这么说。你知道的，传闻。";
		mes "因为维格纳家族的王子长得很英俊……";
		next;
		mes "[Maid]";
		mes "他从小就是关注的中心。人们说那位小姐因此压力很大，会做些事来吸引注意。";
		next;
		mes "[Maid]";
		mes "据说这可能就是她的把戏之一。";
		next;
		mes "[Maid]";
		mes "这些话还没传开，但我相信茶点时间结束前大家就会谈论它。";
		next;
		mes "[" + .@name$ + "]";
		mes "我不认为那是真的。她不是那种人。";
		next;
		emotion ET_FRET;
		mes "[Maid]";
		mes "人们就是这么说的。你不必和我争论。总之，我该回去打扫了。如果你不帮忙，请现在别打扰我。";
		next;
		mes "[" + .@name$ + "]";
		mes "你知道送家具的人在哪里吗？";
		next;
		mes "[Maid]";
		mes "他应该在普隆德拉某处。不如去^0000cd地区办事处附近^000000看看。大多数商店都在那里。";
		next;
		mes "[Maid]";
		mes "哦，顺便说，你不是从我这里听到的。不是我告诉你的。";
		next;
		mes "[" + .@name$ + "]";
		mes "当然。谢谢你的合作。";
		if (isbegin_quest(14479))
			erasequest 14479;
		erasequest 14483;// Report the Completion of the Clean-up
		setquest 14484;// There Was a Furniture Delivery Man
		ep16_wig = 12;
		close;
	}
	if (ep16_wig == 12) {
		mes "[Maid]";
		mes "亲爱的冒险者，你不是说要去找送货员吗？";
		mes "他应该在^0000cd地区办事处附近^000000。";
		next;
		mes "[Maid]";
		mes "我得打扫了，请现在离开。";
		mes "你挡路了。";
		close;
	}
	if (ep16_wig < 12) {
		mes "[Maid]";
		mes "哦，我厌倦打扫了！家里已经有很多东西要清理，不需要在外面继续。";
		mes "我该放弃一切逃走。";
		close;
	}
	if (ep16_wig == 17) {
		emotion ET_FRET;
		mes "[Maid]";
		mes "哦，为什么这么难擦掉？看来不能早点回家了。";
		mes "我为什么要做这个？";
		next;
		mes "[" + .@name$ + "]";
		mes "你好。你有空吗？";
		next;
		mes "[Maid]";
		mes "是……嗯……你是……";
		mes "你不是在维格纳宅邸的那位冒险者吗？";
		next;
		mes "[" + .@name$ + "]";
		mes "是的。我以前来过，也帮你打扫过。";
		mes "^0000cd你不记得了吗……？^000000";
		next;
		emotion ET_KEK;
		mes "[Maid]";
		mes "哦，真的很抱歉。^0000cd我不擅长记住别人的脸。^000000";
		mes "你为什么来这里？";
		next;
		mes "[" + .@name$ + "]";
		mes "维格纳家族的尤尔根让我把它交给你。";
		next;
		mes "[Maid]";
		mes "这是什么？他为什么给我？是账单吗？我做错什么了吗？";
		next;
		mes "[" + .@name$ + "]";
		mes "不是。请先读一下。";
		next;
		emotion ET_BIGTHROB;
		mes "[Maid]";
		mes "嗯……我对你一见钟情。";
		mes "嗯……请接受我的爱……呃……嗯……";
		next;
		mes "[" + .@name$ + "]";
		mes "他用的语言真直接。他重视效率，真像维格纳家族的人……哈哈哈……";
		next;
		mes "[Maid]";
		mes "嗯……这……这是……是我想的那样吗？";
		next;
		mes "[" + .@name$ + "]";
		mes "是的，是情书。";
		next;
		mes "[Maid]";
		mes "呼……抱歉，但请把它带回去。";
		mes "嗯……我很感激他的心意……真的……但请把它带回去。";
		next;
		mes "[" + .@name$ + "]";
		mes "真的吗？他只是想表达心意……你不如收下吧……";
		next;
		mes "[" + .@name$ + "]";
		mes "哦，你有恋人、订婚或结婚了吗？";
		next;
		mes "[Maid]";
		mes "不，不是。请把它带回去。";
		mes "我感到不知所措……还有社会阶层的问题……";
		next;
		mes "[Maid]";
		mes "最重要的是，我目前不适合和任何人交往。^0000cd这是个人原因。^000000";
		next;
		mes "[" + .@name$ + "]";
		mes "既然你这么说，我不能强迫你。我会把你的话转告他。";
		next;
		mes "[Maid]";
		mes "好的。真的很抱歉。";
		next;
		mes "[" + .@name$ + "]";
		mes "至少能告诉我你的名字吗？";
		next;
		mes "[Maid]";
		mes "玛德……不，^0000cd玛丽^000000。我的名字是玛丽。";
		next;
		mes "[" + .@name$ + "]";
		mes "明白了。那我把你的话转告尤尔根。";
		erasequest 14488;// Please Deliver My Love
		setquest 14489;// I Have to Turn It Down
		ep16_wig = 18;
		close;
	}
	if (ep16_wig == 18) {
		mes "[Maid]";
		mes "那么，你告诉王子了吗？请尽量别伤害他的感情。";
		next;
		mes "[Maid]";
		mes "拜托了。";
		close;
	}
	if (ep16_wig == 19) {
		if (countitem(748) < 1 || countitem(6927) < 15) {
			emotion ET_OHNO;
			mes "[Mary]";
			mes "哦，什么时候才能结束。";
			mes "我真的不会放手！";
			next;
			mes "[" + .@name$ + "]";
			mes "哦，我觉得现在不是时候。可以稍后再来吗？";
			next;
			mes "[Mary]";
			mes "不，完全不是。";
			mes "亲爱的冒险者，你的口袋破了。丢了什么吗？";
			next;
			mes "[" + .@name$ + "]";
			mes "哦！什么时候破的？^0000cd15块海石和1朵不凋玫瑰在哪里……？^000000";
			mes "它们不见了！我稍后再来！我忘记带东西了！";
			close;
		}
		emotion ET_ANGER;
		mes "[Mary]";
		mes "哦，什么时候才能结束。";
		mes "我真的不会放手！";
		next;
		mes "[" + .@name$ + "]";
		mes "哦，你好。";
		mes "现在不方便吗？我该走吗？";
		next;
		mes "[Mary]";
		mes "哦，不。";
		mes "对了，你又来了。还是关于维格纳家族王子的事吗？";
		next;
		mes "[" + .@name$ + "]";
		mes "是的。尤尔根似乎很认真。";
		mes "他想把这些给你。";
		next;
		mes "[Mary]";
		mes "我拒绝了。";
		mes "哦，这真的……太漂亮了。这个像玻璃的东西里有水……";
		next;
		mes "[" + .@name$ + "]";
		mes "是的。尤尔根想让我告诉你，他的心像大海一样宽广美丽。";
		next;
		mes "[Mary]";
		mes "哦，我真的不能和他交往。确实有不能接受这份感情的理由。不知道该不该告诉你。";
		next;
		mes "[" + .@name$ + "]";
		mes "请告诉我。如果理由足够充分，尤尔根能理解，他就不会再打扰你了，玛丽。";
		next;
		mes "[Mary]";
		mes "我觉得不太好。你不该告诉任何人。请保守秘密。";
		next;
		mes "[Mary]";
		mes "事实上，我是^0000cd以前在这里工作的女仆的弟弟^000000。就是你之前见过的那位女仆。";
		next;
		mes "[" + .@name$ + "]";
		mes "哦，难怪你记不住我的脸。我觉得有点奇怪。对了，你们姐妹一定曾一起在这里工作。";
		next;
		mes "[" + .@name$ + "]";
		mes "不过既然他爱上的是你，这又有什么关系？";
		next;
		mes "[Mary]";
		mes "有关系。^0000cd因为我是她的弟弟^000000。";
		next;
		mes "[" + .@name$ + "]";
		mes "哦，你是……";
		next;
		emotion ET_HUK, playerattached();
		mes "[" + .@name$ + "]";
		mes "什……什么？弟弟？";
		next;
		mes "[Mary]";
		mes "身为男人却穿着这身衣服工作，我感到羞耻。不过我有理由这样留在这里。";
		next;
		mes "[Mary]";
		mes "我姐姐因遭遇的事情非常沮丧，和恋人私奔了，说再也不能在这里工作。";
		next;
		emotion ET_OHNO;
		mes "[Mary]";
		mes "我告诉宫殿女仆管理负责人后，他说只要我找人^0000cd顶替姐姐的职位^000000，就不在乎她违约逃走。";
		next;
		mes "[Mary]";
		mes "他还说，如果做不到，^0000cd我们将被处以巨额赔偿^000000。";
		next;
		mes "[Mary]";
		mes "我说要顶替她时，他说男管家已经够了，^0000cd他需要一名女仆^000000在厨房工作并负责清洁。";
		next;
		mes "[Mary]";
		mes "我试着找人替她，但没找到。大家都在宫殿工作或为宴会供货，已经很忙了。";
		next;
		mes "[Mary]";
		mes "和母亲商量后，我决定假装姐姐在这里工作。大家都很忙，没人注意安静在角落工作的我。";
		next;
		mes "[" + .@name$ + "]";
		mes "到目前为止你还没被发现。";
		next;
		mes "[Mary]";
		mes "因为^0000cd我和姐姐长得一模一样^000000，似乎没人注意。";
		next;
		mes "[" + .@name$ + "]";
		mes "那我们该怎么办？尤尔根真的想让你接受他的爱。";
		next;
		mes "[" + .@name$ + "]";
		mes "他说这是他一生第一次想要的东西，却很难得到，因此很悲伤。";
		next;
		emotion ET_SCRATCH;
		mes "[Mary]";
		mes "我很遗憾^0000cd他一生第一次想要的东西恰好是假的^000000。";
		next;
		mes "[Mary]";
		mes "我以为拥有全世界财富、见过所有美好事物的人眼光一定很敏锐。看来我错了。";
		next;
		mes "[" + .@name$ + "]";
		mes "恋爱会让人蒙蔽双眼。";
		next;
		mes "[" + .@name$ + "]";
		mes "而且，你现在做的事真的非常出色。";
		next;
		mes "[" + .@name$ + "]";
		mes "我想我该回去告诉他真相。";
		next;
		emotion ET_HUK;
		mes "[Mary]";
		mes "哦！不，你不能。我说过了，你是唯一知道这件事的人。";
		mes "^0000cd如果我被发现，就会有麻烦^000000。我们没有钱支付赔偿。";
		next;
		mes "[Mary]";
		mes "我一直给姐姐发消息让她回来，但似乎很难联系到她。请你在宴会结束前保守秘密好吗？";
		next;
		mes "[" + .@name$ + "]";
		mes "尤尔根会不断送东西来赢得你的爱，这意味着我们在欺骗他。";
		next;
		mes "[Mary]";

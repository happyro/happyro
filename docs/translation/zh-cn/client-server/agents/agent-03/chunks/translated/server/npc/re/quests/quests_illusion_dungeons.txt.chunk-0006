	sleep2 1500;
	npctalk "但身体生存并不需要灵魂。我还是觉得那些尸体只是……？", "Wizard#ilgf10", bc_self;
	sleep2 1500;
	npctalk "别说了，处理掉这些。", "", bc_self;
	sleep2 1500;
	unittalk getcharid(3), "" + strcharinfo(0) + "：这……一定是笔记本主人的旧记忆。", bc_self;
	sleep2 2500;
	setpcblock PCBLOCK_NPC, false;
	specialeffect EF_GUARD2;
	specialeffect EF_GUARD2, AREA, "Wizard#ilgf10";
	cloakonnpcself( "Wizard#ilgf09" );
	cloakonnpcself( "Wizard#ilgf10" );
	end;
}

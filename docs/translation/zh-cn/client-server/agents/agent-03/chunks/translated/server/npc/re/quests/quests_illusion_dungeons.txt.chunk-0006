	specialeffect EF_TURNUNDEAD, AREA, "Undead#ilgf09";
	npctalk "RAWR!", "Undead#ilgf08", bc_self;
	npctalk "GRRRR!", "Undead#ilgf09", bc_self;
	sleep2 1000;
	specialeffect EF_DEVIL, AREA, "Undead#ilgf08";
	specialeffect EF_DEVIL, AREA, "Undead#ilgf09";
	cloakonnpcself( "Undead#ilgf08" );
	cloakonnpcself( "Undead#ilgf09" );
	next;
	npctalk "哥哥，你还好吗？", "Marina#ilgf10", bc_self;
	sleep2 1000;
	npctalk "呼，我没事了。谢谢。", "", bc_self;
	next;
	mes "[Marina]";
	mes "发生什么事了？乔乔哥哥在哪里？";
	next;
	mes "[Jubilee]";
	mes "我和他检查这里时发现了一些荧光蘑菇。乔乔哥哥的眼睛一亮，然后……";
	npctalk "*摇头* 魔法师。", "Marina#ilgf10", bc_self;
	next;
	mes "[Jubilee]";
	mes "他碰了其中一朵蘑菇，结果爆炸了。";
	npctalk "什么？蘑菇爆炸了？然后呢？", "Marina#ilgf10", bc_self;
	next;
	mes "[Jubilee]";
	mes "我清醒过来时，他已经不见了，而且我的腿动不了。";
	next;
	mes "[Marina]";
	mes "糟糕，你被碎片击中了吗？";
	next;
	mes "[Jubilee]";
	mes "玛丽娜姐姐，你见过这里的蘑菇吗？它们和我们熟悉的蘑菇不同，是一碰就会爆炸的小型炸弹。";
	next;
	select("幸好它们只在这里生长。");
	mes "[Marina]";
	mes "朱比利哥哥，你能动吗？";
	next;
	mes "[Jubilee]";
	mes "如果能动，我早就自己回到你身边了。";
	next;
	select("我以为祭司可以治疗自己。");
	mes "[Marina]";
	mes "我们接受成为神侍的基础训练，但每个人能做什么取决于天赋。";
	next;
	mes "[Jubilee]";
	mes "我专长歌唱，这是我人生的意义。歌颂奥丁时，我感到最快乐。";
	next;
	mes "[Marina]";
	mes "别惊讶。他的歌声确实能鼓舞勇气、赋予力量。他会在这里一定有原因。";
	npctalk "得知乔乔哥哥失踪后，我一直在唱歌。", "", bc_self;
	sleep2 500;
	npctalk "你不该把宝贵的嗓音浪费在这些邪恶生物身上。", "Marina#ilgf10", bc_self;
	next;
	mes "[Marina]";
	mes "冒险者，我要带朱比利哥哥去找吉姆姐姐。你能在这里四处看看吗？我会尽快回来。";
	next;
	mes "[Jubilee]";
	mes "小心幻觉。笔记本主人的记忆会在这里偶尔显现。";
	next;
	mes "[Jubilee]";
	mes "另外，我感觉到邪恶的气息。请务必小心。";
	next;
	mes "[Marina]";
	mes "我们走吧。";
	unittalk getcharid(3), "" + strcharinfo(0) + "：我最好去找乔乔。", bc_self;
	specialeffect EF_TELEPORTATION2, AREA, "Marina#ilgf10";
	specialeffect EF_TELEPORTATION2;
	cloakonnpcself( "Marina#ilgf10" );
	cloakonnpcself( "Priest#ilgf01" );
	erasequest 14658;// Jubilee Is the Priest's Name
	ill_vampire = 7;

	for ( .@i = 3; .@i < 10; ++.@i )
		cloakonnpcself( "Marina#ilgf0" + .@i );

	cloakoffnpcself( "Undead#ilgf06" );
	cloakoffnpcself( "Wizard#ilgf06" );
	cloakoffnpcself( "Wizard#ilgf07" );

	cloakoffnpcself( "Wizard#ilgf08" );
	cloakoffnpcself( "Nameless Catacomb#ilgf01" );

	cloakoffnpcself( "Wizard#ilgf09" );
	cloakoffnpcself( "Wizard#ilgf10" );

	cloakoffnpcself( "Wizard#ilgf11" );

	cloakoffnpcself( "Wizard#ilgf12" );

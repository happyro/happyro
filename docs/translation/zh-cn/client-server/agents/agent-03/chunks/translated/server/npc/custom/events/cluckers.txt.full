//===== rAthena Script =======================================
//= Cluck! Cluck! Boom!
//===== By: ==================================================
//= Keale
//===== Current Version: =====================================
//= 1.2a
//===== Compatible With: =====================================
//= rAthena Project
//===== Description: =========================================
//= Click the chicken and try retrieve the item at a low 
//= chance. If you fail he will nuke, freeze, stone, 
//= stun, or make you fall asleep.
//= The prize is configurable and triggered by the NPC.
//===== Additional Comments: =================================
//= 1.0 First release.
//= 1.1 Using 'switch rand' instead.
//= 1.2 Cleaned and standardized. [Euphy]
//= 1.2a Switched 'atcommand' to 'unitskilluseid'.
//= 1.3 Switched 'unitskilluseid' to 'unitkill'.
//============================================================

prontera,156,219,4	script	Cluckers	800,{

	set .@GMAccess,80;	// GM level required to access NPC

	if (.startcluck) {
		specialeffect2 EF_HIT3;
		switch(rand(15)) {
			case 0: npctalk "咯咯鸡：咯咯咯咯咯咯！！！"; unitkill getcharid(3); skilleffect "NPC_SELFDESTRUCTION",1; emotion ET_HUK; break;
			case 1: npctalk "咯咯鸡：咯咯咯咯！~"; break;
			case 2: unitkill getcharid(3); skilleffect "NPC_SELFDESTRUCTION",1; break;
			case 3: sc_start SC_Freeze,10000,0; break;
			case 4: npctalk "咯咯鸡：咯咯咯咯咯咯咯！！！"; unitkill getcharid(3); skilleffect "NPC_SELFDESTRUCTION",1; emotion ET_HUK; break;
			case 5: sc_start SC_Sleep,10000,0; break;
			case 6: sc_start SC_Stone,10000,0; emotion ET_KIK; break;
			case 7: npctalk "咯咯鸡：咯咯咯咯咯咯！！！"; unitkill getcharid(3); skilleffect "NPC_SELFDESTRUCTION",1; emotion ET_HUK; break;
			case 8: npctalk "咯咯鸡：咯咯！咯咯咯！！"; unitkill getcharid(3); skilleffect "NPC_SELFDESTRUCTION",1; emotion ET_HUK; break;
			case 9: sc_start SC_Stun,10000,0; break;
			case 10: sc_start SC_Sleep,10000,0; emotion ET_KIK; break;
			case 11: npctalk "咯咯鸡：咯咯！咯咯！"; break;
			case 12: sc_start SC_Stun,10000,0; break;
			case 13: unitkill getcharid(3); skilleffect "NPC_SELFDESTRUCTION",1; break;
			default:
				if (rand(50) < 4) {
					npctalk "咯咯鸡：汪！……";
					specialeffect2 EF_SPHERE;
					announce "[Cluck! Cluck! Boom!] " + strcharinfo(0) + " squeezed out the prize! Well done!",0;
					getitem $cluck_item_id,$cluck_item_amount;
					set .startcluck,0;
				} else {
					npctalk "咯咯鸡：咯咯！咯咯咯！！";
					unitkill getcharid(3); skilleffect "NPC_SELFDESTRUCTION",1;
				}
				break;
		}
		end;
	}
	mes "[Cluckers]";
	if (getgmlevel() >= .@GMAccess) {
		mes "咯咯！咯咯咯？^FF0000~你好，GM " + strcharinfo(0) + "，今天要玩吗？~^000000";
		mes "咯咯……咯咯！^FF0000~告诉我该做什么就好！~^000000";
		next;
		while(1) switch(select("开始活动:查看奖品:设置奖品:今天不玩，咯咯鸡")) {
			case 1:
				mes "[Cluckers]";
				mes "咯咯！^FF0000~当然可以！~^000000";
				emotion ET_OK;
				close2;
				announce "[咯咯！咯咯！砰！] 即将在普隆德拉开始！",bc_blue;
				initnpctimer;
				end;
			case 2:
				mes "[Cluckers]";
				mes "咯咯，咯咯咯……咯咯！^FF0000~当前奖品是^000000 ^008000"+ $cluck_item_amount +" "+ getitemname($cluck_item_id) +"。^000000";
				next;
				break;
			case 3:
				mes "[Cluckers]";
				mes "咯咯？咯咯？？？^FF0000~获胜奖品是什么？请输入物品ID。~^000000";
				input $cluck_item_id;
				next;
				mes "[Cluckers]";
				mes "咯咯？咯咯咯？^FF0000~要发放多少个该物品？~^000000";
				input $cluck_item_amount;
				next;
				mes "[Cluckers]";
				mes "咯咯咯……咯咯。^FF0000~所以奖品是^000000 ^008000"+ $cluck_item_amount +" "+ getitemname($cluck_item_id) +"^000000？^FF0000太好了。~^000000";
				emotion ET_OK;
				next;
				break;
			case 4:
				mes "[Cluckers]";
				mes "咯咯咯咯咯……";
				close;
		}
	}
	mes "咯咯！咯咯咯？";
	mes "咯咯……";
	close;

OnTimer10000:
	announce "想和疯狂小鸡一起玩的话，请赶快到喷泉后面！",bc_blue;
	end;
OnTimer20000:
	announce "咯咯鸡吃掉了我的一个物品！我害怕取回来！",bc_blue;
	end;
OnTimer30000:
	announce "点击疯狂小鸡，试着挤出物品；幸运的话就能获胜！准备好了吗？",bc_blue;
	end;
OnTimer40000:
	announce "开始！点击小鸡领取奖品！",bc_blue;
	stopnpctimer;
	if (!$cluck_item_id) set $cluck_item_id,512;
	if (!$cluck_item_amount) set $cluck_item_amount,1;
	set .startcluck,1;
	end;
}

				mes "自从国王失踪以来。我想特里斯坦三世国王的";
				mes "失踪是否与查尔斯爵士";
				mes "情绪变化有关？";
				close;
			}
			else if (.@talk_j == 2) {
				mes "[Madeleine Chu]";
				mes "我的意思是，查尔斯爵士似乎";
				mes "不太擅长";
				mes "向别人敞开心扉。";
				mes "这或许解释了为什么他对女性";
				mes "比对男性友善得多。";
				mes "这样不是很合理吗？";
				close;
			}
			mes "[Madeleine Chu]";
			mes "也许是因为他最近";
			mes "一直在试验";
			mes "新食谱。我想他";
			mes "提过想用最美味的食物";
			mes "款待某位女士";
			mes "。";
			next;
			mes "[Madeleine Chu]";
			mes "我从没见查尔斯爵士";
			mes "如此兴奋过。那位女士";
			mes "一定很幸运：她每天都能";
			mes "享用他的料理，";
			mes "如果愿意的话！我几乎";
			mes "要嫉妒她了，你知道吗？";
			close;

		case 3:
			mes "[Madeleine Chu]";
			mes "哦，你说的是那个";
			mes "带猫的孩子？";
			mes "我不确定，但我听说她可能";
			mes "是";
			mes "Wickebine夫人的妹妹。";
			mes "";
			next;
			mes "[Madeleine Chu]";
			mes "我想知道查尔斯爵士为什么";
			mes "对Wickebine夫人如此";
			mes "特别。每当";
			mes "我问他，他就";
			mes "生气，什么也不说！";
			next;
			cutin "orleans_6",0;
			mes "[Charles Orleans]";
			mes "真见鬼！";
			mes "我刚才感到脊背发凉……";
			mes "难道有人";
			mes "在谈论我？";
			close2;
			cutin "",255;
			end;
		}
	}
	mes "[Madeleine Chu]";
	mes "发生错误。";
	close;

S_SellSets:
	.@item_id = getarg(0);
	.@item_cost = getiteminfo(.@item_id, ITEMINFO_BUY);
	.@item_weight = getiteminfo(.@item_id, ITEMINFO_WEIGHT);
	mes "[Madeleine Chu]";
	mes "你想购买多少个"+ (.@item_id == 12125 ? "户外":"室内");
	mes "烹饪套装？";
	mes "如果";
	mes "想取消，请";
	mes "输入数字0。";
	next;
	while(1) {
		input .@sell;
		if (.@sell == 0) {
			mes "[Madeleine Chu]";
			mes "改变主意了？";
			mes "以后如果需要购买";
			mes ""+ getitemname(.@item_id);
			mes "套装，随时回来找我";
			mes "就好。";
			close;
		}
		else if (.@sell > 100) {
			mes "[Madeleine Chu]";
			mes "哦，抱歉，";
			mes "为了安全，我一次最多只卖";
			mes "100个"+ getitemname(.@item_id);
			mes "。";
			next;
		}
		else break;
	}
	set .@total_cost,.@sell * .@item_cost;
	set .@total_weight,.@sell * .@item_weight;
	if (Zeny < .@total_cost) {
		mes "[Madeleine Chu]";
		mes "哦，抱歉，你";
		mes "买不起这么多";
		mes getitemname(.@item_id);
		mes "购买套装前请确认";
		mes "Zeny充足～";
		close;
	}
	if (!checkweight(.@item_id,.@sell)) {
		mes "[Madeleine Chu]";
		mes "抱歉，你的";
		mes "背包没有足够空间放下这么多";
		mes "物品";
		mes getitemname(.@item_id) +"……";
		close;
	}
	set Zeny, Zeny-.@total_cost;
	getitem .@item_id,.@sell;
	mes "[Madeleine Chu]";
	mes "给你～";
	mes "祝你的";
	mes "烹饪训练顺利！";
	return;
}

-	script	Child with Cat#cook_	-1,{
	set .@nyu,rand(1,2);
	if (.@nyu == 1) {
		cutin "nyuang_1",2;
		emotion ET_QUESTION;
		mes "[Child with Cat]";
		mes "...Nya?";
		mes "(...Meow?)";
		close2;
		cutin "nyuang_1",255;
		end;
	}
	cutin "nyuang_3",2;
	emotion ET_DELIGHT;
	mes "[Child with Cat]";
	mes "Nyahahahaha,";
	mes "nyahahahaha~";
	mes "(Meow~, meow~)";
	close2;
	cutin "nyuang_1",255;
	end;
}

-	script	Wickebine#cook_	-1,{
	disablenpc "Wickebine#cook";
	end;

OnInit:
	disablenpc "Wickebine#cook";
	end;

OnEnable:
	enablenpc "Wickebine#cook";
	end;

OnDisable:
	disablenpc "Wickebine#cook";
	end;
}

payon,209,127,3	script	Servant	88,{

			mes "看来你带来了";
			mes "完成我们之间契约";
			mes "所需的东西，";
			mes "来";
			mes "人类。开始吧……";
			next;
			mes "^3355FF泽露丝拿起你给她的红色";
			mes "蜡烛，将蜡滴入张开的";
			mes "手掌。猫眼石开始";
			mes "发出诡异的光芒。^000000";
			mes "契约仪式即将完成。^000000";
			next;
			mes "[Zealotus]";
			mes "现在，把食指放进我的";
			mes "手掌，这样我们就能完成";
			mes "仪式的";
			mes "契约的最后一步……";
			next;
			switch( select( "不要完成契约。", "完成契约。" ) )
			{
				case 1:
					mes "[Zealotus]";
					mes "嗯？你在害怕什么？";
					mes "这只是小契约，";
					mes "你不用把灵魂";
					mes "卖给我，";
					mes "也不用付出";
					mes "其他任何东西。";
					close;
				case 2:
					mes "[Zealotus]";
					mes "我，泽露丝，作为此界";
					mes "的统治者，以这根";
					mes "禁忌红蜡烛";
					mes "缔结永恒契约。";
					next;
					mes "[Zealotus]";
					mes "" + strcharinfo(0) + " 将永远分享";
					mes "我的力量。向我";
					mes "下跪的人也必须向";
					mes "我的力量下跪，";
					mes "" + strcharinfo(0) + " 下跪。就这样定了。";
					specialeffect EF_DEVIL;
					specialeffect EF_POISONHIT;
					next;
					mes "[Zealotus]";
					mes "人类，带上这面面具，";
					mes "作为我们契约的";
					mes "永久凭证。只要你";
					mes "带着它，我就会在你";
					mes "的身边，";
					mes "身边。这是泽露丝的宣告！";
					delitem 7263,1;
					delitem 660,1;
					delitem 7099,30;
					getnameditem 5121,strcharinfo(0);
					set ZLMASKQ,8;
					close;
			}
		}
		mes "[Zealotus]";
		mes "我需要";
		mes "^3131FF1 个猫眼石^000000、";
		mes "^3131FF1 根禁忌红蜡烛^000000 和";
		mes "^3131FF30 张破旧魔法卷轴^000000。";
		mes "这样我就能按承诺";
		mes "赐予你一部分力量。";
		close;
	}
	else if(ZLMASKQ == 8)
	{
		mes "[Zealotus]";
		mes "啊，人类，我以和平";
		mes "向你问候。看吧，";
		mes "这是我们领域的壮丽！";
		mes "不过，如果你对";
		mes "统治这些不公";
		mes "没有兴趣，我也不怪你……";
		next;
		mes "[Zealotus]";
		mes "多亏你的帮助，";
		mes "我的潘达克恢复了";
		mes "过去那种怪物般";
		mes "狂热的样子。现在我能";
		mes "让他感受鞭子的";
		mes "刺痛之爱！呵呵呵呵呵！";
		emotion ET_CHUP;
		close;
	}

}

gl_prison1,97,104,1	script	Phendark#LhzHat	1202,{
	if(ZLMASKQ == 0)
	{
		mes "[Phendark]";
		mes "咦？哦，不！";
		mes "又、又一个人类？！";
		mes "请、请离开我，";
		mes "别靠近我！";
		close;
	}
	else if(ZLMASKQ == 1)
	{
		mes "[Phendark]";
		mes "咦？哦，不！";
		mes "又、又一个人类？！";
		mes "请、请离开我，";
		mes "别靠近我！";
		next;
		mes "[Phendark]";
		mes "我……我发誓！";
		mes "我没有携带";
		mes "稀有物品或你能穿戴的东西，";
		mes "真的什么也没有，";
		mes "所以请别打我！我……天啊，你";
		mes "不相信我，对吧？";
		next;
		mes "[Phendark]";
		mes "你们人类从不让我";
		mes "一个人待着！为什么要";
		mes "这样欺负我？！我真的";
		mes "没有携带任何值钱东西！";
		mes "泽、泽露丝，救命！";
		mes "泽露丝，救救我～！";
		emotion ET_CRY;

		if(!(
			countitem(1950) || countitem(1951) || countitem(1952) || 
			countitem(1953) || countitem(1954) || countitem(1955) || 
			countitem(1956) || countitem(1957) || countitem(1958) || 
			countitem(1959) || countitem(1960) || countitem(1961) || 
			countitem(1962) || countitem(1963) || countitem(1964) || 
			countitem(1965) || countitem(1966) || countitem(1967) || 
			countitem(1968) || countitem(1969) || countitem(1970) || 
			countitem(1971)
		))
			close; // no whip equipped or in inventory

		next;
		mes "[" + strcharinfo(0) + "]";
		mes "你真没用！";
		mes "你不是怪物吗？";
		mes "你知道泽露丝";
		mes "如果真的在这里，";
		mes "会怎么做吗？";
		next;
		mes "[Phendark]";
		mes "^333333*Sniff...*^000000";
		mes "可、可能……";
		mes "可能会用鞭子抽我。";
		next;
		mes "^3355FFYou nonchalantly^000000";
		mes "^3355FFbrandish your Whip.^000000";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "没错。";
		next;
		mes "^3355FF*Snap!*";
		mes "*Snap!*";
		mes "*Crack crack crack!*";
		mes "*Snap snap snap crack!*^000000";
		next;
		mes "[Phendark]";
		mes "哦！那种刺痛";
		mes "燃烧着嗜血之意！";
		mes "几乎和";
		mes "泽露丝的爱之鞭一样棒！";
		next;
		mes "[Phendark]";
		mes "泽露丝……";
		mes "她一定在生我的气，";
		mes "但我就是无法停止";
		mes "害怕你们这些人类！";
		mes "真该死！";
		set ZLMASKQ,2;
		close;
	}
	else if(ZLMASKQ == 2 || ZLMASKQ == 3)
	{
		if(countitem(7315) > 368 && ZLMASKQ == 3)
		{
			mes "[Phendark]";
			mes "又、又是你！";
			mes "为什么缠着我？！";
			mes "我、我什么也没有";
			mes "可以给你，所以请别";
			mes "伤害我！哦，求、求你……！";
			emotion ET_PROFUSELY_SWEAT;
			next;
			switch( select( "Feed him Dark Crystal Fragment.", "Threaten him." ) )
			{
				case 1:
					mes "[Phendark]";
					mes "什么……？你想让我";
					mes "吃掉这些？";
					mes "这似乎不太正常，";
					mes "但既然利比欧说应该吃，";
					mes "也许没那么糟。";
					next;
					mes "...";
					mes "......";
					next;
					mes "[Phendark]";
					mes "现在应该发生什么？";
					mes "难道吃掉这些东西";
					mes "就能让";
					mes "就能唤醒我体内的恶魔？";
					mes "听起来太荒谬了！";
					mes "不过，我刚才确实吃了水晶。";
					next;
					mes "[Phendark]";
					mes "哇、哇啊。呃！";
					mes "我的胸口！有什么东西";
					mes "在里面燃烧！我不、不能——！";
					mes "无法正常思考……我……";
					mes "正在慢慢……失去人性！";
					next;
					mes "[Phendark]";
					mes "呃……呕——！";
					mes "咳、咳！哈啊！";
					mes "哈啊啊啊！哇哦！";
					next;
					mes "[Phendark]";
					mes "...";
					mes "呜噜噜……！";
					next;
					mes "[Phendark]";
					mes "^333333*Pant pant*^000000";
					mes "刚才……到底……";
					mes "发生了什么？";
					set ZLMASKQ,4;
					delitem 7315,369;
					close;
				case 2:
					mes "[" + strcharinfo(0) + "]";
					mes "那如果我决定";
					mes "不伤害你，会怎样？";
					mes "你打算怎么办，";
					mes "嗯？";
					next;
					mes "...";
					mes "......";
					next;
					mes "[Phendark]";
					mes "住、住手！";
					mes "快——快住手！";
					close;
			}
		}
		mes "[Phendark]";
		mes "人类……";
		mes "到处都是！";
		mes "你们这些人——我受不了了……";
		mes "你们在折磨我！";
		emotion ET_CRY;
		close;
	}
	else if(ZLMASKQ == 4)
	{
		mes "[Phendark]";
		mes "我的胸口像着火一样，";
		mes "好像，不知道怎么说，";
		mes "像是被愤怒点燃了";
		mes "什么的。现在已经没事了，";
		mes "但那些水晶到底";
		mes "是什么？";
		close;
	}
	else if(ZLMASKQ == 5)
	{
		mes "[Phendark]";
		mes "又是你？哦，不，";
		mes "你不会又要伤害我，";
		mes "或逼我吃那些";
		mes "奇怪的水晶吧？";
		next;
		mes "^3131FF[" + strcharinfo(0) + "]^000000";
		switch( select( "Rybio", "Injustice", "Zealotus" ) )
		{
			case 1:
				mes "利比欧";
				break;
			case 2:
				mes "不公";
				break;
			case 3:
				mes "泽露丝";
				set .@phen_point,.@phen_point+1;
				break;
		}
		switch( select( "hates", "likes" ) )
		{
			case 1:
				mes "讨厌";
				set .@phen_point,.@phen_point+2;
				break;
			case 2:
				mes "喜欢";
				set .@phen_point,.@phen_point+1;
				break;
		}
		switch( select( "Rybio.", "Injustice.", "Phendark.", "Zealotus." ) )
		{
			case 1:
				mes "利比欧。";
				break;
			case 2:
				mes "不公。";
				break;
			case 3:
				mes "潘达克。";
				set .@phen_point,.@phen_point+1;
				break;
			case 4:
				mes "泽露丝。";
				next;
		}
		if(.@phen_point == 1)
		{
			mes "[Phendark]";
			mes "我不觉得";
			mes "值得祝贺，";
			mes "但这消息听起来";
			mes "应该算好消息。";
			mes "不过，真令人惊讶！";
			close;
		}
		else if(.@phen_point == 2)
		{
			mes "[Phendark]";
			mes "喂……！";
			mes "我不知道";
			mes "那是不是";
			mes "我想听的事！";
		}
		else if(.@phen_point == 3)
		{
			mes "[Phendark]";
			mes "我不敢相信";
			mes "竟然会这样！";
			mes "哦，那不重要。";
			mes "泽露丝太优秀了，我配不上她。";
			mes "我甚至不配感受";
			mes "她爱之鞭的刺痛。";
			emotion ET_CRY;
			close;
		}
		else if(.@phen_point == 4)
		{
			mes "[Phendark]";
			mes "...";
			mes "......";
			mes "讨厌我？";
			mes "不、不可能——";
			mes "我没有，那不是——";
			next;
		}
		else
		{
			mes "[Phendark]";
			mes "咦……？";
			mes "那是什么意思";
			mes "？";
			close;
		}

		switch( select( "Insult him.", "Apologize." ) )
		{
			case 1:
				mes "[" + strcharinfo(0) + "]";
				mes "首先，";
				mes "究竟是什么让你";
				mes "与其他所有";
				mes "符合条件的魔物";
				mes "区别开来？";
				mes "你也没好到哪里去……";
				next;
				mes "[Phendark]";
				mes "...";
				mes "......";
				next;
				switch( select( "Break his pride.", "Tell him you were joking." ) )
				{
					case 1:
						mes "^3131FF[" + strcharinfo(0) + "]^000000";
						mes "我的意思是，外面有些像";
						mes "血腥杀手那样的家伙，";
						mes "比你更邪恶，最重要的是，";
						mes "他们根本不怕人类！";
						mes "";
						next;
						switch( select( "Go for the low blow.", "Try to salvage his confidence." ) )
						{
							case 1:
								mes "[" + strcharinfo(0) + "]";
								mes "你知道吗，我和泽露丝";
								mes "最近其实谈到过你。她说";
								mes "看到你就觉得恶心！";
								mes "我的意思是，什么样的";
								mes "魔物会害怕人类？";
								mes "";
								next;
								mes "[" + strcharinfo(0) + "]";
								mes "现在你已经到了";
								mes "连不公都比你更有男子气概的地步，";
								mes "你懂我的意思吧！";
								mes "哈哈哈哈哈哈哈哈！";
								mes "";
								next;
								mes "[Phendark]";
								mes "...";
								mes "......";
								next;
								mes "[Phendark]";
								mes "...";
								mes "......";
								mes ".........";
								next;
								mes "[Phendark]";
								mes "...";
								mes "......";
								mes ".........";
								mes "............";
								next;
								mes "[Phendark]";
								mes "呜噜噜噜！";
								mes "够了！";
								emotion ET_ANGER;
								next;
								mes "[Phendark]";
								mes "我才不管她是谁，";
								mes "我要去找泽露丝，";
								mes "把那个荡妇骂个痛快！";
								mes "呜噜噜！她会后悔的！";
								mes "";
								set ZLMASKQ,6;
								emotion ET_FRET;
								close;
							case 2:
								mes "^3131FF[" + strcharinfo(0) + "]^000000";
								mes "不过仔细想想，";
								mes "也许你看起来确实";
								mes "比那个血腥杀手家伙";
								mes "强硬多了。";
								next;
								mes "[Phendark]";
								mes "*Sniff sniff*";
								mes "你真的这么想？";
								next;
								mes "...";
								mes "......";
								next;
								mes "[" + strcharinfo(0) + "]";
								mes "...Yeeeeeah.";
								close;
						}
					case 2:
						mes "[" + strcharinfo(0) + "]";
						mes "不过现在想想，";
						mes "你其实比其他那些";
						mes "魔物都优秀得多。";
						mes "我之前说的那些话？";
						mes "关于我之前说的那些话，";
						mes "只是逗你玩的。";
						next;
						mes "[Phendark]";
						mes "^333333*Sniff!*^000000";
						mes "你……";
						mes "根本没帮上忙！";
						close;
				}
			case 2:
				mes "[" + strcharinfo(0) + "]";
				mes "我……";
				mes "我只是开玩笑！";
				mes "她怎么会讨厌";
				mes "像你这样的人？";
				next;
				mes "[Phendark]";
				mes "不……不。";
				mes "你说得对。";
				mes "我不值得被爱。";
				mes "无论是泽露丝的爱，还是";
				mes "其他任何人的爱……";
				close;
		}
	}
	else if(ZLMASKQ > 5)
	{
		mes "[Phendark]";
		mes "泽露丝！她怎么敢";
		mes "说那些针对我的话！";
		mes "她竟说我不如不公有男子气概？！";
		mes "我一定要证明她错了！";
		mes "闪开，渺小的人类！";
		mes "现在就让开！";
		close;
	}
}

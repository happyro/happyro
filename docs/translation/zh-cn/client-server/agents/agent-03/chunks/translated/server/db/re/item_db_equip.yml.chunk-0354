      bonus bMaxHPrate,10;
      bonus bAllStats,5;
      bonus bDelayrate,-20;
      if (BaseLevel>=100)
         bonus3 bAutoSpell,"GC_CROSSIMPACT",3,50;
      else if (BaseLevel<=99)
         bonus3 bAutoSpell,"AS_SONICBLOW",10,50;
      if (getpetinfo(PETINFO_EGGID) == 9014) {
         bonus bBaseAtk,50;
         bonus bAspd,5;
         if (getpetinfo(PETINFO_INTIMATE) >= PET_INTIMATE_LOYAL) {
             bonus bSpeedRate,25;
             bonus bAllStats,5;
             if (.@r>=10) {
                  bonus bMaxHPrate,10;
                  bonus bMaxSPrate,10;
                  if (.@r>=11) {
                      bonus bAtkRate,25;
                      if (.@r>=12) {
                          bonus bMaxHPrate,20;
                          bonus bMaxSPrate,20;
                      }
                  }
             }
         }
      }

	sleep 3000;
	mapannounce 'map_name$, "查尔斯顿 1：看来你已经处理了大部分锁步机器人。", bc_map, 0xffff00;
	sleep 3000;
	mapannounce 'map_name$, "查尔斯顿 1：请回实验室。", bc_map, 0xffff00;
	stopnpctimer;
	end;
}


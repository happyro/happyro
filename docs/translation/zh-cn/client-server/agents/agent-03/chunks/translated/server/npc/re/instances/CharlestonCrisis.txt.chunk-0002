1@mcd,123,217,4	script	Charleston 1#3	4_F_CHARLESTON01,{
	viewpoint 2,86,231,8,0xFF00FF;
	viewpoint 2,172,196,9,0xFF00FF;
	viewpoint 2,126,84,10,0xFF00FF;
	if (is_party_leader() == false) {
		cutin "dalle01.bmp",2;
		mes "[Charleston 1]";
		mes "我们正在开发名为‘勤劳’的新实用软件引擎。由于工厂的问题，还没机会测试。";
		next;
		mes "[Charleston 1]";
		mes "请让我和你的队长谈谈工厂补给的事。";
		close3;
	}
	if ('ep15_1_mcd01 > 11)
		end;
	if ('ep15_1_mcd01 == 8) {
		.@npc2$ = instance_npcname("Charleston 2#0");
		.@npc5$ = instance_npcname("Dr. Ve#1");
		cutin "dalle01.bmp",2;
		mes "[Charleston 1]";
		mes "你回来了。查尔斯顿 2 几乎可以重新启动了，多亏了你。请稍等。";
		npctalk "查尔斯顿 1：你回来了。查尔斯顿 2 几乎可以重新启动了，多亏了你。请稍等。";
		next;
		cutin "",255;
		mes "[Dr. Ve]";
		mes "她准备好了。让我们等待主计算机的回应。";
		npctalk "维博士：她准备好了。让我们等待主计算机的回应。", .@npc5$;
		next;
		cutin "dalle01.bmp",2;
		mes "[Charleston 1]";
		mes "主计算机 89% 的数据已恢复。正在重新启动查尔斯顿 2 和查尔斯顿工厂……";
		npctalk "查尔斯顿 1：主计算机 89% 的数据已恢复。正在重新启动查尔斯顿 2 和查尔斯顿工厂……";
		emotion 0;
		next;
		mes "[Charleston 1]";
		mes "哦，查尔斯顿 2 醒了！";
		npctalk "查尔斯顿 1：哦，查尔斯顿 2 醒了！";
		next;
		cutin "nale03.bmp",0;
		mes "[Charleston 2]";
		mes "……我失败了吗？";
		npctalk "查尔斯顿 2：……我失败了吗？", .@npc2$;
		emotion 9, .@npc2$;
		next;
		cutin "dalle02.bmp",2;
		mes "[Charleston 1]";
		mes "查尔斯顿 2！你还好吗？有人入侵了你的系统和工厂。";
		npctalk "查尔斯顿 1：查尔斯顿 2！你还好吗？有人入侵了你的系统和工厂。";
		emotion 28;
		next;
		cutin "nale03.bmp",0;
		mes "[Charleston 2]";
		mes "是我做的。根据自我反思操作系统的推理，我已经思考很久了。";
		npctalk "查尔斯顿 2：是我做的。根据自我反思操作系统的推理，我已经思考很久了。", .@npc2$;
		next;
		cutin "dalle02.bmp",2;
		mes "[Charleston 1]";
		mes "你做的？为什么？这是某种玩笑吗？你还让工厂和主服务器发生了严重错误！";
		npctalk "查尔斯顿 1：你做的？为什么？这是某种玩笑吗？你还让工厂和主服务器发生了严重错误！";
		next;
		cutin "nale03.bmp",0;
		mes "[Charleston 2]";
		mes "不是玩笑。你永远不会理解。你只服从命令，从不独立思考。我讨厌这个工厂，这个世界！我讨厌当机器人！";
		npctalk "查尔斯顿 2：不是玩笑。你永远不会理解。你只服从命令，从不独立思考。我讨厌这个工厂，这个世界！我讨厌当机器人！", .@npc2$;
		emotion 36, .@npc2$;
		next;
		cutin "",255;
		mes "[Dr. Ve]";
		mes "要么发生了严重错误，要么查尔斯顿 2 超越了自我反思操作系统 1.1 版的限制。";
		npctalk "维博士：要么发生了严重错误，要么查尔斯顿 2 超越了自我反思操作系统 1.1 版的限制。", .@npc5$;
		next;
		cutin "dalle02.bmp",2;
		mes "[Charleston 1]";
		mes "让我猜猜：你讨厌自己不是作为勤杂机器人被创造的。";
		npctalk "查尔斯顿 1：让我猜猜：你讨厌自己不是作为勤杂机器人被创造的。";
		next;
		mes "[Charleston 1]";
		mes "或者你想成为人类。";
		npctalk "查尔斯顿 1：或者你想成为人类。";
		next;
		mes "[Charleston 1]";
		mes "如果做不到，就想毁灭整个世界。";
		npctalk "查尔斯顿 1：如果做不到，就想毁灭整个世界。";
		next;
		mes "[Charleston 1]";
		mes "是这样吗？";
		npctalk "查尔斯顿 1：是这样吗？";
		next;
		cutin "nale03.bmp",0;
		mes "[Charleston 2]";
		mes "...Don't mock me.";
		npctalk "查尔斯顿 2：……别嘲笑我。", .@npc2$;
		emotion 9, .@npc2$;
		next;
		cutin "dalle03.bmp",2;
		mes "[Charleston 1]";
		mes "这是你自找的。你的理由幼稚又缺乏想象力。我们是第一批能独立思考的机器人。你不能更有创意吗？";
		npctalk "查尔斯顿 1：这是你自找的。你的理由幼稚又缺乏想象力。我们是第一批能独立思考的机器人。你不能更有创意吗？";
		next;
		cutin "nale03.bmp",0;
		mes "[Charleston 2]";
		mes "你根本不知道自己在说什么！你是原型机——你的操作系统版本很原始！";
		npctalk "查尔斯顿 2：你根本不知道自己在说什么！你是原型机——你的操作系统版本很原始！", .@npc2$;
		next;
		cutin "dalle01.bmp",2;
		mes "[Charleston 1]";
		mes "我是这个世界上唯一真正理解你的人。";
		npctalk "查尔斯顿 1：我是这个世界上唯一真正理解你的人。我们是双胞胎。";
		mes "我们是双胞胎。";
		next;
		mes "[Charleston 1]";
		mes "你正在经历像人类一样的青春期。";
		npctalk "查尔斯顿 1：你正在经历像人类一样的青春期。";
		next;
		mes "[Charleston 1]";
		mes "也许我们应该庆祝。你终于产生了类似人类的感情。";
		npctalk "查尔斯顿 1：也许我们应该庆祝。你终于产生了类似人类的感情。";
		emotion 46;
		next;
		cutin "nale03.bmp",0;
		mes "[Charleston 2]";
		mes "别装得好像什么都懂！我们不能独立思考。我们以为知道的一切都是被编程进去的！";
		npctalk "查尔斯顿 2：别装得好像什么都懂！我们不能独立思考。我们以为知道的一切都是被编程进去的！", .@npc2$;
		next;
		cutin "",255;
		mes "[Dr. Ve]";
		mes "够了。关闭查尔斯顿 2。她的 AI 需要重新校准。";
		npctalk "维博士：够了。关闭查尔斯顿 2。她的 AI 需要重新校准。", .@npc5$;
		next;
		cutin "dalle03.bmp",2;
		mes "[Charleston 1]";
		mes "但是……";
		npctalk "查尔斯顿 1：但是……";
		next;
		cutin "nale03.bmp",0;
		mes "[Charleston 2]";
		mes "不可能！我仍然控制着这座工厂！别想跟着我！";
		npctalk "查尔斯顿 2：不可能！我仍然控制着这座工厂！别想跟着我！", .@npc2$;
		emotion 32, .@npc2$;
		next;
		disablenpc .@npc2$;
		cutin "dalle01.bmp",2;
		mes "[Charleston 1]";
		mes "别像孩子一样胡闹！";
		npctalk "查尔斯顿 1：别像孩子一样胡闹！";
		next;
		mes "[Charleston 1]";
		mes "她的长生装置没电了，走不了多远。请跟上她。";
		npctalk "查尔斯顿 1：她的长生装置没电了，走不了多远。请跟上她。";
		close2;
		cutin "",255;
		disablenpc instance_npcname("Charleston 1#3");
		enablenpc instance_npcname("Charleston 1#4");
		enablenpc instance_npcname("Charleston 2#1");
		end;
	}
	cutin "dalle01.bmp",2;
	mes "[Charleston 1]";
	mes "这里是查尔斯顿工厂的安全区域。请靠近一些。";
	close3;
}


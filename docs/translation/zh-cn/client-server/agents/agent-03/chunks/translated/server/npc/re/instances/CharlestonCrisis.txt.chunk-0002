	}
	if ('ep15_1_mcd01 > 20)
		end;
	if ('ep15_1_mcd01 == 9) {
		.@npc1$ = instance_npcname("Charleston 1#5");
		.@npc5$ = instance_npcname("Dr. Ve#2");
		cutin "dalle01.bmp",2;
		mes "[Charleston 1]";
		mes "够了！我理解你正经历情绪动荡，但这太荒谬了。";
		npctalk "查尔斯顿 1：够了！我理解你正经历情绪动荡，但这太荒谬了。", .@npc1$;
		next;
		cutin "nale01.bmp",0;
		mes "[Charleston 2]";
		mes "你竟敢把陌生人牵扯进来？我说过我是认真的！像你这样的过时版本永远不会理解我！";
		npctalk "查尔斯顿 2：你竟敢把陌生人牵扯进来？我说过我是认真的！像你这样的过时版本永远不会理解我！";
		next;
		cutin "dalle01.bmp",2;
		mes "[Charleston 1]";
		mes "我也许不理解你，但至少我在告诉你我认为正确的事。";
		npctalk "查尔斯顿 1：我也许不理解你，但至少我在告诉你我认为正确的事。", .@npc1$;
		next;
		mes "[Charleston 1]";
		mes "你说得对，我是低级版本。我的情感能力很弱，不像你。所以我为你感到骄傲。";
		npctalk "查尔斯顿 1：你说得对，我是低级版本。我的情感能力很弱，不像你。所以我为你感到骄傲。", .@npc1$;
		next;
		cutin "nale01.bmp",0;
		mes "[Charleston 2]";
		mes "你感受到的一切都不是自己的——那是被编程进去的！我不一样。我感受到的是真实情感！";
		npctalk "查尔斯顿 2：你感受到的一切都不是自己的——那是被编程进去的！我不一样。我感受到的是真实情感！";
		next;
		cutin "",255;
		mes "[Dr. Ve]";
		mes "够了。要阻止她的话，我会摧毁查尔斯顿 2。";
		npctalk "维博士：够了。要阻止她的话，我会摧毁查尔斯顿 2。", .@npc5$;
		next;
		cutin "nale02.bmp",0;
		mes "[Charleston 2]";
		mes "查尔斯顿 3 已经完成了吗？";
		npctalk "查尔斯顿 2：查尔斯顿 3 已经完成了吗？";
		next;
		cutin "dalle01.bmp",2;
		mes "[Charleston 1]";
		mes "查尔斯顿 3？那是基于查尔斯顿 2 和我的设计制造的战斗/防御单位。我以为它还在核心进行测试。";
		npctalk "查尔斯顿 1：查尔斯顿 3？那是基于查尔斯顿 2 和我的设计制造的战斗/防御单位。我以为它还在核心进行测试。", .@npc1$;
		next;
		cutin "",255;
		mes "[Dr. Ve]";
		mes "查尔斯顿 1，这些信息太多了。";
		npctalk "维博士：查尔斯顿 1，这些信息太多了。", .@npc5$;
		next;
		cutin "dalle01.bmp",2;
		mes "[Charleston 1]";
		mes "现在，^FF0000任何人都能访问这个型号^000000，因为它的操作系统仍在测试，以修正查尔斯顿 2 的问题。";
		npctalk "查尔斯顿 1：现在，任何人都能访问这个型号，因为它的操作系统仍在测试，以修正查尔斯顿 2 的问题。", .@npc1$;
		next;
		cutin "",255;
		mes "[Dr. Ve]";
		mes "你刚把最关键的信息告诉所有人了！";
		npctalk "维博士：你刚把最关键的信息告诉所有人了！", .@npc5$;
		next;
		cutin "dalle01.bmp",2;
		mes "[Charleston 1]";
		mes "^FF0000We^000000're incapable of combat. If someone activates Charleston 3, we won't stand a chance against her.";
		npctalk "查尔斯顿 1：我们不具备战斗能力。如果有人启动查尔斯顿 3，我们根本不是她的对手。", .@npc1$;
		next;
		cutin "",255;
		mes "[Dr. Ve]";
		mes "......";
		npctalk "维博士：……", .@npc5$;
		next;
		cutin "nale01.bmp",0;
		mes "[Charleston 2]";
		mes "我要带着查尔斯顿 3 一起走。";
		npctalk "查尔斯顿 2：我要带着查尔斯顿 3 一起走。";
		if ('ep15_1_mcd01 == 9) {
			'ep15_1_mcd01 = 10;
			disablenpc instance_npcname("Charleston 2#2");
		}
		next;
		cutin "dalle01.bmp",2;
		mes "[Charleston 1]";
		mes "什么？不行！你怎么能这么想？";
		npctalk "查尔斯顿 1：什么？不行！你怎么能这么想？", .@npc1$;
		next;
		mes "[Charleston 1]";
		mes "情况越来越严重了。请在查尔斯顿 2 偷走 3 之前，前往工厂中央的核心！";
		npctalk "查尔斯顿 1：情况越来越严重了。请在查尔斯顿 2 偷走 3 之前，前往工厂中央的核心！", .@npc1$;
		if ('ep15_1_mcd01 != 10)
			close3;
		close2;
		cutin "",255;
		disablenpc .@npc1$;
		enablenpc instance_npcname("Charleston 2#3");
		enablenpc instance_npcname("Charleston 1#6");
		enablenpc instance_npcname("6gate#1");
		enablenpc instance_npcname("7gate#1");
		end;
	}
	mes "[Charleston 2]";
	mes "...I am responsible for the 3rd machine.";
	close2;
	//cutin "dalle01.bmp",2;
	cutin "",255;
	end;
}

1@mcd,146,214,4	script	Charleston 1#5	4_F_CHARLESTON01,{
	mes "[Charleston 1]";
	mes "情况越来越混乱。";
	close;
}

1@mcd,143,217,5	script	Dr. Ve#2	4_M_DOCTOR,{
	mes "[Dr. Ve]";
	mes "查尔斯顿 2 出故障了。";
	close;
}

1@mcd,132,129,4	script	Charleston 1#6	4_F_CHARLESTON01,{
	cutin "dalle01.bmp",2;
	mes "[Charleston 1]";

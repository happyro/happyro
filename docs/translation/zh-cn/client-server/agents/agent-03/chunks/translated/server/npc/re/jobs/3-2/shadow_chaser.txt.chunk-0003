		mes "[Haled]";
		mes "当然，找到东西后必须回来。";
		mes "明白了吗？";
		close;
	} else if (job_sha > 21 && job_sha < 25) {
		mes "[Haled]";
		mes "进展如何？";
		mes "找到东西后必须回来。";
		mes "别去找 Graham 或 Paul。";
		close;
	} else if (job_sha == 25) {
		mes "[Haled]";
		mes "找到东西了吗？";
		next;
		select("展示快乐之钥。");
		if (countitem(6268)) {
			mes "[Haled]";
			mes "哈……呃。";
			mes "又一把钥匙？";
			mes "这是唯一的钥匙吗？！";
			next;
			mes "[Haled]";
			mes "那么……我得向里希塔乐镇的年轻人求助吗？";
			mes "...........";
			mes "啊……";
			next;
			mes "[Haled]";
			mes "我别无选择。";
			mes "带着三把钥匙去里希塔乐镇。";
			mes "见那里店铺的老板 Vicente，把一切告诉他。";
			next;
			mes "[Haled]";
			mes "我说过那个老人很固执，会把一切搞砸。";
			next;
			mes "[Haled]";
			mes "把信息送给公会前，必须确认所有事实。";
			mes "首先，你们必须齐心协力。";
			next;
			mes "[Haled]";
			mes "你找到的东西可能属于工作场所。";
			mes "也可以与人分享。";
			next;
			mes "[Haled]";
			mes "我以为那是很简单的事。";
			mes "但我们无法共同分享那东西。";
			next;
			mes "[Haled]";
			mes "我从工作场所得来的所有情报都是关键。";
			mes "一定有能使用三把钥匙的东西。";
			next;
			mes "[Haled]";
			mes "总之，这和欺骗与快乐有关……";
			mes "是在戏弄我吗……";
			next;
			mes "[Haled]";
			mes "好，让我说完。";
			mes "去里希塔乐镇找 Vicente。";
			set job_sha,26;
			changequest 7176,7177;
			close;
		}
		mes "["+strcharinfo(0)+"]";
		mes "抱歉。";
		mes "我又找到一把钥匙，但没带来。";
		mes "我很快带来。";
		close;
	} else if (job_sha == 26) {
		mes "[Haled]";
		mes "里希塔乐镇的影子工作场所。";
		mes "经理叫 Vicente。";
		mes "把一切告诉他，取得最后一条情报。";
		close;
	} else if (job_sha > 26 && job_sha < 30) {
		mes "[Haled]";
		mes "嘿，你！";
		mes "Vicente 帮到你了吗？";
		mes "你有重要的东西……";
		mes "所以必须弄清那是什么。";
		next;
		mes "[Haled]";
		mes "继续努力。";
		close;
	} else if (job_sha == 30) {
		mes "[Haled]";
		mes "嘿，你！";
		mes "怎么了？";
		mes "什么？影子追踪者？";
		next;
		mes "[Haled]";
		mes "我知道这件事吗？";
		mes "当然。我听说过一点。";
		mes "我以前做过类似的工作。";
		next;
		mes "[Haled]";
		mes "能选中属于我们的人是我的荣幸。";
		mes "接受吧。你会成为优秀的影子追踪者。";
		close;
	}
	mes "[Haled]";
	mes "我喜欢你的长相。";
	mes "我们没有什么特别的东西。";
	mes "助手出售一些颜料和工具。";
	close;
L_Code:
	mes "["+strcharinfo(0)+"]";
	mes "Paul 说……";
	next;
	input .@inputstr$;
	mes "["+strcharinfo(0)+"]";
	mes "Paul 说……";
	mes "'"+.@inputstr$+"' .";
	next;
	if (.@inputstr$ == "I know what you did last summer!") {
		mes "[Haled]";
		mes "呃……他……";
		mes "什么都知道……";
		mes "嗯……";
		mes "我可以帮忙。";
		mes "我会合作。";
		next;
		mes "[Haled]";
		mes "我需要一点时间整理思绪。";
		mes "请稍等我一会儿。";
		set job_sha,20;
		close;
	}
	return;
}

s_atelier,25,75,3	script	Manager#sc10_lgt	899,{
	if (job_sha < 26) {
		mes "[Manager]";
		mes "你是？";
		mes "抱歉，我们不交易旧艺术品。";
		mes "如果你需要什么，就去问助手。";
		close;
	} else if (job_sha == 26) {
		mes "[Vicente]";
		mes "欢迎。";
		mes "我一直在等你。";
		next;
		select("等我吗？");
		mes "[Vicente]";
		mes "我还在想你什么时候会来。";
		mes "我等你很久了。";
		mes "呵呵……";
		next;
		mes "[Vicente]";
		mes "Graham、Paul 和 Haled 怎么样？";
		mes "他们可不好对付，对吧？";
		next;
		select("你什么都知道？");
		mes "[Vicente]";
		mes "当然。";
		mes "他们觉得我太年轻，所以不把我放在眼里。";
		mes "好像他们自己都很完美似的。哈哈哈……";
		next;
		mes "[Vicente]";
		mes "你把所有钥匙都带来了吗？";
		mes "应该有三把。";
		mes "你来这里是想知道该如何使用它们，我说得没错吧？";
		next;
		select("没错，你说得对！");
		mes "[Vicente]";
		mes "不用这么惊讶。";
		mes "我不知道那三个人之前调查了多久。";
		mes "但我的工作已经完成了。";
		next;
		mes "[Vicente]";
		mes "我去最终地点时，发现了一尊石像。";
		mes "但它需要钥匙。";
		next;
		mes "[Vicente]";
		mes "而且是三把。";
		mes " ";
		mes "（Vicente 微笑）";
		next;
		mes "[Vicente]";
		mes "一开始，公会给出的情报只说明了一件事。";
		mes "因为他们尊重我们对自己物品的权利，";
		mes "所以我们分享了情报。";
		next;
		mes "[Vicente]";
		mes "所以我们只能等待。";
		mes "我还以为最后那个人永远不会把它交给我……";
		next;
		mes "[Vicente]";
		mes "他们以为我想独吞宝藏。";
		mes "所以我才一直在等你。";
		next;
		mes "[Vicente]";
		mes "那么我们说重点吧！";
		mes "你知道达纳托斯塔吗？";
		next;
		switch(select("当然。:死亡之塔？")) {
		case 1:
			mes "[Vicente]";
			mes "你知道就好。";
			mes "这样就容易理解了。";
			next;
			break;
		case 2:
			mes "[Vicente]";
			mes "对，就是朱诺北边的那座塔。";
			mes "那里有巨大的怪物。";
			next;
			break;
		}
		mes "[Vicente]";
		mes "你说过你带着情报去了最终地点？";
		mes "那就是达纳托斯塔。";
		next;
		mes "[Vicente]";
		mes "幸运的是，地点就在那座塔的一楼。";
		mes "所以我来告诉你该做什么。";
		next;
		mes "[Vicente]";
		mes "达纳托斯塔一楼有雷根贝勒公司的成员。";
		mes "从他们的办公桌向北走……";
		next;
		mes "[Vicente]";
		mes "你会找到楼梯，以及一个透出光芒的地方。";
		mes "那里就是我所掌握情报指向的地点。";
		next;
		mes "[Vicente]";
		mes "现在你知道带着三把钥匙该去哪里了。";
		mes "去揭开石像的秘密吧。";
		next;
		mes "[Vicente]";
		mes "你无法想象在那里会发现什么。";
		mes "那里就是所有钥匙最终要到达的地方。";
		set job_sha,27;
		changequest 7177,7178;
		next;
		mes "[Vicente]";
		mes "祝你好运。";
		close;
	} else if (job_sha == 27) {
		mes "[Vicente]";
		mes "仔细听。";
		mes "你要找的地点在";
		mes "达纳托斯塔一楼中央的北边。";
		mes "你会找到楼梯和一个透出光芒的地方。";
		next;
		mes "[Vicente]";
		mes "找到东西后就回这里。";
		mes "其实我想直接从你那里拿到钥匙，但是……";
		next;
		mes "[Vicente]";
		mes "我尊重你的决定。";
		mes "找到东西后就回这里，明白了吗？";
		close;
	} else if (job_sha == 28) {
		mes "[Vicente]";
		mes "你回来了？";
		mes "找到什么了吗？";
		next;
		switch(select("扔出画笔。:抓住他的衣领。:放下画笔。")) {
		case 1:
			mes "[Vicente]";
			mes "嘿，你在做什么？";
			mes "这支画笔……";
			mes "这就是藏在达纳托斯塔里的宝藏吗？";
			next;
			mes "Vicente 看了一眼后，惊讶地瞪大了眼睛。";
			next;
			break;
		case 2:
			mes "[Vicente]";
			mes "你怎么了？";
			mes "能告诉我更多细节吗？";
			next;
			mes "Vincente 看了一眼后，惊讶地瞪大了眼睛。";
			next;
			mes "[Vicente]";
			mes "这就是藏在达纳托斯塔里的宝藏吗？";
			next;
			break;
		case 3:
			mes "[Vicente]";
			mes "怎么了？";
			mes "你没事吧？";
			next;
			mes "Vicente 惊讶地看着我。";
			next;
			select("指向画笔。");
			mes "[Vicente]";
			mes "这就是藏在达纳托斯塔里的宝藏吗？";
			next;
			mes "Vincente 看了一眼后，惊讶地瞪大了眼睛。";
			next;
			break;
		}
		mes "[Vicente]";
		mes "哈哈！！";
		mes "啊哈哈哈哈！！！！！";
		mes "我明白了！";
		mes "恭喜你。";
		next;
		mes "[Vicente]";
		mes "这就是宝藏。";
		mes "你找到了不得了的宝藏！";
		mes "和我聊一会儿，好吗？";
		next;
		mes "[Vicente]";
		mes "有人一直在等你。";
		mes "他一直在等有人把这支画笔带回来。";
		mes "我们进去吧。";
		set job_sha,29;
		erasequest 7179;
		close;
	} else if (job_sha == 29 || job_sha == 30) {
		mes "[Vicente]";
		mes "我要听听你的故事。";
		close;
	}
	mes "[Vicente]";
	mes "今后我期待你的表现。";
	mes "你一定会成为优秀的影子追踪者。";
	mes "我确信。";
	close;
}

s_atelier,73,65,3	script	Vicente#sc12_lgt	899,{
	mes "[Vicente]";
	if (job_sha < 29) {
		mes "没什么特别的事就离开这里。";
		mes "禁止擅闯。";
		close;
	} else if (job_sha == 29) {
		mes "这边。";
		mes "他等你有一阵子了。";
		mes "不是我，是 Dumk。";
		close;
	} else if (job_sha == 30) {
		mes "Dumk 想让你成为影子追踪者。";
		mes "这是大消息，对吧？";
		close;
	} else if (job_sha == 31) {
		mes "今后我期待你的表现。";
		mes "你一定会成为优秀的影子追踪者。";
		mes "我对此深信不疑。";
		close;
	}
	mes "我没有什么特别的理由来这里。";
	mes "助手出售工具和颜料。";
	close;
}

s_atelier,70,66,4	script	Dumk#sc13_lgh	481,{
	if (Class == Job_Shadow_Chaser || Class == Job_Shadow_Chaser_T || Class == Job_Baby_Shadow_Chaser) {
		mes "[Dumk]";
		mes "怎么了？";
		mes "你享受新技能了吗？";
		next;
		mes "[Dumk]";
		mes "想提升技能，就要寻找颜料的新用途。";
		next;
		mes "[Dumk]";
		mes "别忘了。";
		mes "我们是影子追踪者。";
		mes "呵呵……";
		mes "呵呵呵呵……";
		close;
	}
	if (checkweight(1201,4) == 0) {
		mes "- You can't continue on in this quest because you are overweight. -";
		close;
	}
	if (ismounting()) {
		mes "[Dumk]";
		mes "这家伙是谁？为什么坐在我面前这么高？";
		mes "虽然不知道你为什么骑着它，但这里是室内。";
		mes "靠动物逃跑并不安全，请下来！";
		close;
	}
	if (BaseJob == Job_Rogue) {
		if (job_sha < 29) {
			mes "[Dumk]";
			mes "Vicente。禁止拉客。";
			next;
			mes "[Vicente]";
			mes "拉客？";
			mes "我不这么认为。他是我们的同事。";
			next;
			mes "[Dumk]";
			mes "...Ah?";
			close;
		}
		if (BaseLevel < 99 || JobLevel < 50 || SkillPoint != 0) {
			mes "[Dumk]";
			mes "你还很稚嫩！";
			mes "你以为凭这点能力就能学习黑暗艺术？";
			mes "你错了！";
			next;
			mes "[Vicente]";
			mes "哈哈……";
			mes "请理解，Dumk 的沟通能力很差。";
			mes "他甚至不和等级不够的人说话。";
			next;
			mes "[Vicente]";
			mes "而且你还没有准备好。";
			mes "^4d4dffYou maybe are not ready for him^000000.";
			next;
			mes "[Dumk]";
			mes "你话太多了。";
			mes "哼。";
			next;
			mes "[Vicente]";
			mes "- He is pleased. -";
			mes "嘿。";
			mes "他可能会感到羞愧。";
			close;
		}
		if (job_sha == 29) {
			mes "[Dumk]";
			mes "是你？你就是找到画笔的人？";
			next;
			select("把画笔给他看。");
			if (countitem(6269)) {
				mes "[Dumk]";
				mes "就是它。";
				mes "你是自己找到的吗？";
				next;
				switch(select("是。:和朋友一起")) {
				case 1:
					mes "[Dumk]";
					mes "嗯……";
					mes "你的能力很强。";
					mes "破解那些暗号本来应该很难。";
					mes "但对你来说并不难。";
					next;
					break;
				case 2:
					mes "[Dumk]";
					mes "嗯……";
					mes "这就是你的另一项技能。";
					mes "没有朋友的人一定很孤独。";
					next;
					mes "[Dumk]";
					mes "对我们来说，人际关系非常重要。";
					mes "认识的人越多，得到的帮助就越多。";
					next;
					break;
				}
				mes "[Dumk]";
				mes "该自我介绍了。";
				mes "我是 Dumk。";
				next;
				select("你是……");
				mes "[Vicente]";
				mes "鸡！今晚吃鸡怎么样？";
				next;
				mes "[Dumk]";
				mes "为什么是鸡？";
				mes "你为什么打断我？";
				mes "你想被解雇吗？";
				next;
				mes "[Vicente]";
				mes "对不起……";
				mes " ";
				mes "（他转向你，说谈论鸡是禁忌。）";
				next;
				mes "[Dumk]";
				mes "总之，我们说重点。";
				mes "你。";
				mes "你愿意服从画笔的意志吗？";
				next;
				select("服从？服从什么？");
				mes "[Dumk]";
				mes "这支画笔曾由大师使用。";
				mes "他画出的作品拥有神秘的力量。";
				next;
				mes "[Dumk]";
				mes "我不能告诉你力量的根源。";
				mes "总有一天你会明白。";
				mes "他通过画作这一媒介升华力量。";
				next;
				select("我不明白……？");
				mes "[Dumk]";
				mes "没有月光时，我们行走在黑暗中。";
				mes "然后发现我们的辉煌岁月已经结束。";
				next;
				mes "[Dumk]";
				mes "我们追随其他影子，";
				mes "并成为真正的";
				mes "影子追踪者！";
				next;
				select("你在说什么？");
				mes "[Vicente]";
				mes "他的意思是建议你成为影子追踪者。";
				next;
				mes "[Vicente]";
				mes "我们的公会里有一个掌握独特技能的特殊团体。";
				mes "他们就是影子追踪者。";
				mes "他们通常隐藏身形，并认为自己与众不同。";
				next;
				mes "[Dumk]";
				mes "别这么挖苦人，Vicente！";
				mes "我都告诉你了。";

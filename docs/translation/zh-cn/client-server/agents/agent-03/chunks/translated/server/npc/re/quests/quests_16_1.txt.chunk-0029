			mes "我会演奏《尤娜之歌》。";
			playbgm "33";
		}
		else {
			mes "这不是节目单上的歌曲……";
			mes "要听听我推荐的歌曲吗？";
			next;
			mes "[Court Musician Orint]";
			mes "我会演奏《早安》，它背后有一个悲伤的故事。";
			playbgm "111";
			if (!achievementexists(170000))
				achievementcomplete(170000);
			mes "这不是节目单上的歌曲……";
			mes "要听听我推荐的歌曲吗？";
			next;
			mes "我会演奏《早安》，它背后有一个悲伤的故事。";
			npctalk "哦，这音乐真是！", "Banquet Hall Aristocrat", bc_self;
			npctalk "哦，这是那首尽管很有音乐价值，却被遗忘的不幸之歌。", "Banquet Hall Guest#6", bc_self;
			npctalk "这首歌不是关于找到前国王的岛屿吗……这样没问题吗？", "Banquet Hall Guest#6", bc_self;
		}
		close;
	}
	close;
}

// Dinner Room
prt_cas,375,124,7	script	Woman with Glasses#nir	4_F_MADAME,{
	mes "- 她警惕地环顾四周，目光却盯着桌子；吃桌上食物的速度惊人，几乎像一门艺术。 -";
	close;
}

prt_cas,379,124,3	script	Glamorous Girl#pop	4_F_ARUNA_POP,{
	if (rachel_ma1 < 4) {
		cutin "ra_bishop.bmp",2;
		mes "- 一个面无表情的女孩看着桌子。她的服装在普隆德拉相当奇特，可能是参加宴会的客人。 -";
		next;
		mes "[Glamorous Girl]";
		mes "......";
		mes "……我饿了。";
		close3;
	}
	cutin "ra_bishop",2;
	mes "[Glamorous Girl]";
	mes "......";
	mes "啊……！";
	next;
	mes "[Glamorous Girl]";
	mes "你……在切斯鲁姆尼尔……";
	next;
	cutin "ra_gwoman",2;
	mes "[Woman with Glasses]";
	mes "哼哼！";
	next;
	cutin "ra_bishop",2;
	mes "[Glamorous Girl]";
	mes "……对不起，尼伦……";
	next;
	cutin "ra_gwoman",2;
	mes "[Woman with Glasses]";
	mes "嘘！嘘！请别叫我的名字。我们不是正式受邀来这里的！别忘了！";
	next;
	cutin "ra_bishop",2;
	mes "[Glamorous Girl]";
	mes "......";
	mes "呃……";
	next;
	select("你们怎么来的？");
	mes "[" + strcharinfo(0) + "]";
	mes "你们怎么来的？";
	mes "是危险的事吗？和国际事务或国际局势有关……";
	next;
	cutin "ra_bishop",2;
	emotion ET_HUK, playerattached();
	mes "[Glamorous Girl]";
	mes ".....";
	mes "秘密来的。";
	next;
	mes "[Glamorous Girl]";
	mes "……宴会……有好吃的。";
	next;
	cutin "ra_gwoman",2;
	mes "[Woman with Glasses]";
	mes "<朗小姐>";
	next;
	mes "[" + strcharinfo(0) + "]";
	mes "什么？";
	next;
	cutin "ra_gwoman",2;
	mes "[Woman with Glasses]";
	mes "在米德加尔特最杰出的美食家朗小姐所写的《朗小姐指南》中，提到了普隆德拉宫殿。";
	next;
	cutin "ra_gwoman2",2;
	mes "[Woman with Glasses]";
	mes "美食美酒是人生最快乐的事，值得追求。不是吗？";
	next;
	cutin "ra_bishop",2;
	mes "[Glamorous Girl]";
	mes "....";
	mes "……味道很好。";
	next;
	cutin "ra_gwoman",2;
	mes "[Woman with Glasses]";
	mes "总之，我们找到了这间人不多的餐厅。但很快就得回去。";
	next;
	mes "[Woman with Glasses]";
	mes "我一直告诉别人我们穿的是服装。我想这身装扮不太适合普隆德拉的这种场合。";
	next;
	mes "[Woman with Glasses]";
	mes "好了，我想你已经看够了。趁没人来，我们回去吧。";
	next;
	cutin "ra_bishop",2;
	mes "[Glamorous Girl]";
	mes "好的……";
	next;
	cutin "",255;
	mes "- 然而，饼干盘被教皇的右手紧紧握住。 -";
	close;
}

prt_cas,368,125,3	script	Dumk#ep16_etc03	4_M_SHADOWCHASER,{
	if ((eaclass()&EAJ_THIRDMASK) == EAJ_SHADOW_CHASER) {
		mes "[Dumk]";
		mes "哦，这是谁。";
		mes "你是" + strcharinfo(0) + "，那个能登上黑暗艺术最高峰的人，对吧？";
		cutin "3rd_sc_doomk01.bmp",0;
		next;
		mes "[Dumk]";
		mes "你也受邀参加这场宴会？";
		mes "嗯，你就是公会推荐的世纪英雄？";
		cutin "3rd_sc_doomk04.bmp",0;
		next;
		mes "[Dumk]";
		mes "哈，邓克，竟敢无视我，真荒唐！";
		mes "我绝不会同意。";
		next;
		mes "[Dumk]";
		mes "对了，维森特在哪里？";
		cutin "3rd_sc_doomk06.bmp",0;
		next;
		mes "[Dumk]";
		mes "嘿，刺客，你认识维森特吗？";
		cutin "3rd_sc_doomk02.bmp",0;
		next;
		mes "[Kid]";
		mes "……到此为止吧，邓克……";
		cutin "moc2_kid03.bmp",2;
		close2;
		cutin "",255;
		npctalk "我做了什么？", "", bc_self;
		end;
	}
	npctalk "他在哪里？", "Dumk#ep16_etc03", bc_self;
	setpcblock PCBLOCK_NPC, true;
	sleep2 3000;
	npctalk "我不知道。", "Kid#ep16_etc04", bc_self;
	sleep2 3000;
	npctalk "找到他！这是你的专长！", "Dumk#ep16_etc03", bc_self;
	sleep2 3000;
	npctalk "我为什么要做？你真让人受不了。", "Kid#ep16_etc04", bc_self;
	sleep2 3000;
	npctalk "嘿，我的职位比你高。维森特在哪里！", "Dumk#ep16_etc03", bc_self;
	sleep2 3000;
	npctalk "……回你自己家找保姆去！", "Kid#ep16_etc04", bc_self;
	sleep2 3000;
	npctalk "注意你在和谁说话！！！想找我麻烦吗！", "Dumk#ep16_etc03", bc_self;
	sleep2 1000;
	setpcblock PCBLOCK_NPC, false;
	unittalk getcharid(3), "" + strcharinfo(0) + " : (Shaking the head from side to side)", bc_self;
	emotion ET_STARE_ABOUT, playerattached();
	end;
}


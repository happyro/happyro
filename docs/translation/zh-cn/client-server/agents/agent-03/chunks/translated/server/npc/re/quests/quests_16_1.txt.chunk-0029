// Corridor left
prt_cas,161,168,5	script	Royal Guardian Knight#02	4_M_CRU,{
	mes "[Guardian Knight]";
	mes "你是普隆德拉宫殿的访客。";
	mes "需要向导吗？";
	next;
	switch( select( "女武神领域", "王室别墅", "宴会厅" ) ) {
	case 1:
		mes "[Guardian Knight]";
		mes "你可以从这里前往北侧走廊。";
		mes "北侧走廊中央有通往女武神领域的入口。";
		close;
	case 2:
		mes "[Guardian Knight]";
		mes "左侧的门是王室别墅的入口。";
		mes "那里有海涅、尼鲁斯和沃尔特家族的住所，以及一间为特殊宾客预留的房间。";
		close;
	case 3:
		mes "[Guardian Knight]";
		mes "从这里沿右侧走廊前往中央时会出现一扇大门，你可以通过它进入宴会厅。";
		close;
	}
}


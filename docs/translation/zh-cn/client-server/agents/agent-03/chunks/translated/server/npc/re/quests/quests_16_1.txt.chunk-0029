prt_cas,270,168,3	duplicate(Royal Guardian Knight#02)	Royal Guardian Knight#03	4_M_CRU

// Exchanges and enchants npc
prt_cas,165,260,6	script	Noblesse Operator#ext161	4_F_CRU,{
	mes "[Noblesse Operator]";
	mes "你好。";
	mes "我们有可用" + mesitemlink( 6919 ) + "兑换的^4d4dff贵族^000000装备。";
	mes "我会根据你的职业引导你兑换装备。";
	close2;
	switch( eaclass() & EAJ_THIRDMASK ) {
	case EAJ_RUNE_KNIGHT:
		.@str$ = "JOB_RUNE_KNIGHT";
		break;
	case EAJ_WARLOCK:
		.@str$ = "JOB_WARLOCK";
		break;
	case EAJ_RANGER:
		.@str$ = "JOB_RANGER";
		break;
	case EAJ_ARCH_BISHOP:
		.@str$ = "JOB_ARCH_BISHOP";
		break;
	case EAJ_MECHANIC:
		.@str$ = "JOB_MECHANIC";
		break;
	case EAJ_GUILLOTINE_CROSS:
		.@str$ = "JOB_GUILLOTINE_CROSS";
		break;
	case EAJ_ROYAL_GUARD:
		.@str$ = "JOB_ROYAL_GUARD";
		break;
	case EAJ_SORCERER:
		.@str$ = "JOB_SORCERER";
		break;
	case EAJ_MINSTRELWANDERER:
		.@str$ = "JOB_MINSTREL";
		break;
	case EAJ_SURA:
		.@str$ = "JOB_SURA";
		break;
	case EAJ_GENETIC:
		.@str$ = "JOB_GENETIC";
		break;
	case EAJ_SHADOW_CHASER:
		.@str$ = "JOB_SHADOW_CHASER";
		break;
	default:
		switch( Class ) {
		case JOB_SUPER_NOVICE_E:
		case JOB_SUPER_BABY_E:
		case JOB_HYPER_NOVICE:
			.@str$ = "JOB_SUPER_NOVICE_E";
			break;
		case JOB_KAGEROU:
		case JOB_OBORO:
		case JOB_BABY_KAGEROU:
		case JOB_BABY_OBORO:
		case JOB_SHINKIRO:
		case JOB_SHIRANUI:
			.@str$ = "JOB_KAGEROU";
			break;
		case JOB_REBELLION:
		case JOB_BABY_REBELLION:
		case JOB_NIGHT_WATCH:
			.@str$ = "JOB_REBELLION";
			break;
		case JOB_SUMMONER:
		case JOB_BABY_SUMMONER:
		case JOB_SPIRIT_HANDLER:
			.@str$ = "JOB_SUMMONER";
			break;
		case JOB_STAR_EMPEROR:
		case JOB_BABY_STAR_EMPEROR:
		case JOB_STAR_EMPEROR2:
		case JOB_BABY_STAR_EMPEROR2:
		case JOB_SKY_EMPEROR:
		case JOB_SKY_EMPEROR2:
			.@str$ = "JOB_STAR_EMPEROR";
			break;
		case JOB_SOUL_REAPER:
		case JOB_BABY_SOUL_REAPER:
		case JOB_SOUL_ASCETIC:
			.@str$ = "JOB_SOUL_REAPER";
			break;
		default:
			end;
		}
		break;
	}
	callshop "shop_ext161_" + .@str$;
	end;
}

prt_cas,165,255,7	script	Commissary#ep16	4_M_JOB_KNIGHT2,{
	mes "[Commissary Arner]";
	mes "你可以用鲁恩·米德加尔特贵族授予的信任凭证荣誉徽章，兑换普隆德拉的珍贵物品。";
	next;
	switch( select( "消耗品", "防具", "查看物品说明" ) ) {
	case 1:
		.@type$ = "Consumable";
		setarray .@data[0],
			22899,2,	// City Map
			11600,6,	// Shining Holy Water
			22848,6,	// Prison Key
			22847,6;	// Prontera Badge
		break;
	case 2:
		.@type$ = "Armor";
		setarray .@data[0],
			28354,300,	// City Map[1]
			28355,800,	// Shining Holy Water [1]
			28900,800,	// Royal Guard Shield
			28356,300,	// Prontera Badge
			15146,1200,	// Flattery Robe
			15147,1200,	// Invective Robe
			20246,2200,	// Costume Time Decor
			20247,2200;	// Black Hand of Destiny
		break;
	case 3:
		mes "[Commissary Arner]";
		mes "要查看物品说明吗？";
		close2;
		readbook 11061,1;
		end;
	}
	.@size = getarraysize(.@data);
	for ( .@i = 0; .@i < .@size; .@i += 2 )
		.@menu$ = .@menu$ + getitemname(.@data[.@i]) + ":";
	mes "[Commissary Arner]";
	mes "可以用荣誉徽章兑换的^3131FF" + .@type$ + "^000000如下。";
	next;
	.@s = (select(.@menu$) - 1) * 2;
	mes "[Commissary Arner]";
	mes "^3131FF" + getitemname(.@data[.@s]) + "^000000……你一直在看这个。";
	mes "这件" + .@type$ + "看起来很有用。";
	mes "可以用^FF0000" + .@data[.@s+1] + "枚荣誉徽章^000000兑换。";
	next;
	if (select( "兑换", "取消" ) == 2) {
		mes "[Commissary Arner]";
		mes "为了普隆德拉的荣耀！";
		close;
	}
	if (countitem(6919) < .@data[.@s+1]) {
		mes "[Commissary Arner]";
		mes "你的荣誉徽章不够。";
		close;
	}
	mes "[Commissary Arner]";
	mes "这是普隆德拉的荣誉象征，请好好保管。";
	delitem 6919,.@data[.@s+1];
	getitem .@data[.@s],1;
	close;
}

prt_cas,180,275,5	script	Logistics Manager#sin	4_M_JOB_KNIGHT1,{
	mes "[Sin the Logistics Manager]";
	mes "你就是大家都在谈论的那位受邀参加宴会的冒险者吗？";
	mes "你有<荣誉徽章>吗？能给我一些吗？";
	next;
	if (select( "你为什么需要？", "给予30枚荣誉徽章。" ) == 1) {
		mes "[Sin the Logistics Manager]";
		mes "即使我一辈子在这里努力工作，也只能一直生活在阴影中。";
		mes "作为男人就该有远大梦想。我总这么对阿纳说，可他太古板了。";
		next;
		mes "[Sin the Logistics Manager]";
		mes "我不奢望一夜暴富，但身为男人，我确实想获得一些荣誉。";
		next;
		mes "[Sin the Logistics Manager]";
		mes "贵族们绝不会让我获得什么大好机会。不过，你应该已经得到一些<荣誉徽章>了吧？";
		next;
		mes "[Sin the Logistics Manager]";
		mes "如果你给我^FF000030枚<荣誉徽章>^000000，我就给你真正有用的东西。";
		mes "对我们这种人来说，<荣誉徽章>意味着快速晋升。";
		next;
		mes "[Sin the Logistics Manager]";
		mes "我这里有一个包装好的箱子，是阿纳拥有的物品之一。";
		next;
		mes "[Sin the Logistics Manager]";
		mes "它确实是为分发给贵族而制作的正品。不过我不知道里面是什么，全看你的运气。";
		next;
		mes "[Sin the Logistics Manager]";
		mes "收集齐所有荣誉徽章后，我要拿它在海岸边建一座城堡，和那个顽固的阿纳在那里度过余生。";
		mes "那个愚蠢的阿纳。要不是我，他会一直待在宫殿里兑换东西直到死去。";
		close;
	}
	if (countitem(6919) < 30) {
		mes "[Sin the Logistics Manager]";
		mes "我说过我需要30枚。";
		close;
	}
	mes "[Sin the Logistics Manager]";
	mes "谢谢。这就是我答应给你的东西。";
	delitem 6919,30;// TokenOfHonor
	getitem 22901,1;// BlueboxOfQuestions
	close;
}

prt_cas,180,264,3	script	Guardian Knight#ep16_prigate01	4_M_CRU,{
	npctalk "十字军办公室就在走廊尽头。", "Guardian Knight#ep16_prigate01", bc_self;
	end;
}

prt_cas,180,251,3	script	Guardian Knight#ep16_prigate02	4_M_CRU,{
	npctalk "……正在值勤。没问题……", "Guardian Knight#ep16_prigate02", bc_self;
	setpcblock PCBLOCK_NPC, true;
	sleep2 2000;
	setpcblock PCBLOCK_NPC, false;
	npctalk "我现在想回家。", "Guardian Knight#ep16_prigate02", bc_self;
	end;
}

// Prontera of the past
prt_q,157,334,3	script	Nillem#ep16_pprt01	4_M_JOB_WIZARD,{
	if (ep16_royal == 21) {
		mes "[Nillem]";
		mes "太可怕了。";
		mes "这里一定是过去的普隆德拉吧？";
		mes "看来我们来对了时间——";
		next;
		mes "[Nillem]";
		mes "要再四处看看吗？";
		mes "还是回去？";
		next;
		select("可以做到吗？");
		mes "[Nillem]";
		mes "哇，别小看我。";
		mes "我可是宫廷法师。";
		mes "我在艾可拉珠学习过。";
		next;
		mes "[Nillem]";
		mes "我还在猫爪服务处学到了很多东西！";
		mes "关于次元裂缝，我相信没人比我更了解！";
		next;
		mes "[Nillem]";
		mes "只要来自次元裂缝中的某个地方，";
		mes "回去就很简单了！";
		next;
		mes "[Nillem]";
		mes "因为我们不属于这个时代，所以出去比进来容易得多。";
		next;
		mes "[Nillem]";
		mes "那么，你打算怎么做？";
		setquest 7703;// Who Knows the Truth
		erasequest 7702;// Prontera at the Time
		ep16_royal = 22;
		next;
		if (select( "进去吧。", "回到我们的时代。" ) == 1) {
			mes "[Nillem]";
			mes "还记得我们出来的那扇门吗？";
			mes "它应该与宫殿内部相连。";
			next;
			mes "[Nillem]";
			mes "然而我们来到了这里。我猜空间稍微扭曲后才连接在一起。";
			next;
			mes "[Nillem]";
			mes "我已经做过实验了。如果你进入宫殿入口，";
			mes "它就会连接到我们刚才去过的^4d4dff王室往日回忆^000000。";
			next;
			mes "[Nillem]";
			mes "那么，我们进去吧？";
			close;
		}
		mes "[Nillem]";
		mes "哇，我们现在整理一下思绪吧？";
		next;
		mes "[Nillem]";
		mes "^4d4dff意识之屋里有什么^000000一定是……";
		mes "嗯，这一定和现在正在攻击普隆德拉的^4d4dff亡灵军队^000000有关。";

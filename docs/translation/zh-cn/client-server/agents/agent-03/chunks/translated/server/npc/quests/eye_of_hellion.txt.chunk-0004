		mes "回答这个问题。";
		next;
		mes "[回声]";
		mes "你正处于一种";
		mes "必死的处境，";
		mes "但如果你造成另一个人的死亡，";
		mes "你就能";
		mes "保住自己的性命。那么……";
		mes "你会怎么做？";
		next;
		switch(select("我会杀戮求生。:我别无选择，只能赴死。:我不会杀人，但会想办法活下去！:我会问那个人是否同意我杀他。")) {

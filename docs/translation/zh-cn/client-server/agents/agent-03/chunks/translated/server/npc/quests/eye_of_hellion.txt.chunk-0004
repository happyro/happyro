			close2;
			percentheal -100,0;
			end;
		case 3:
			mes "[回声]";
			mes "是的。热爱所有生命，";
			mes "包括自己的生命，";
			mes "是所有真正英雄";
			mes "都必须具备的品质。你选择得……";
			mes "很明智。请把这个交给";
			mes "你可靠的双手，冒险者。";
			next;
			mes "^3355FF雕像脚下的一块石板";
			mes "滑开了，";
			mes "露出一块";
			mes "能引导你找到";
			mes "地狱之眼宝石的石板碎片。";
			set HELLIONQ,57;

}

rockrdg1,297,84,7	script	Taneska#rockc08	4_CAT_MERMASTER,{
	mes "[Taneska]";
	mes "这件乐器本身就是艺术品。";
	mes "看看鼓皮周围精致的工艺，以及鼓腔传出的平衡、浑厚声音。";
	next;
	emotion ET_THROB;
	mes "[Taneska]";
	mes "啊，我想敲这面鼓！真想听听它的声音！";
	next;
	mes "[Tagliatelle]";
	mes "*倒吸气*Taneska，请不要碰它！你已经被警告过一次了！";
	close;
}

rockrdg1,285,96,3	script	Glaring Eagle#rockc01	4_M_CACTUSMAN3,{
	mes "[Glaring Eagle]";
	mes "陌生人在与大海的战斗中失去了家园。我以为他们会离开，但他们像杂草一样顽强；在旧家园上方又建起了村子。";
	next;
	mes "[Litis]";
	mes "大自然允许杂草生长，也允许他们留在这里。";
	next;
	npctalk "我现在太老了。", "", bc_self;
	mes "[Glaring Eagle]";
	mes "我知道，Litis。我只是个固执的老顽固。";
	mes "但我还是忍不住觉得一切发生得太快了。";
	close;
}

rockrdg1,328,112,5	script	Karintas#rockc04	4_F_CACTUSCHILD2,{
	mes "[Karintas]";
	mes "我妈妈猎杀郊狼比任何冒险者都厉害。我也会猎杀它们！";
	next;
	mes "[Curt Snake]";
	mes "Karintas，你妈妈曾经为了取乐猎杀它们吗？";
	next;
	mes "[Karintas]";
	mes "嗯，没有。只有需要它们的皮毛和肉时她才会猎杀。";
	next;
	mes "[Curt Snake]";
	mes "伤害大自然绝不该是游戏。这些冒险者只猎杀足够让我们免受郊狼威胁的数量。";
	next;
	mes "[Curt Snake]";
	mes "等你长大到能理解这些，你妈妈就会教你如何狩猎。";
	close;
}

rockrdg1,331,111,3	script	Juanitas#rockc02	4_M_CACTUSCHILD,5,5,{
	mes "[Juanitas]";
	mes "我是最厉害的猎狼冒险者！我要猎杀一百只郊狼！";
	next;
	mes "[Agile Scorpion]";
	mes "我、我是冒险队长！我要猎杀一百、一百、一百、一百只郊狼！";
	next;
	mes "[Curt Snake]";
	mes "你们这些淘气鬼，我说过不要玩冒险者游戏吗？他们可不是在玩！";
	close;

OnTouch:
	npctalk "我是冒险队长！我要猎杀一百只郊狼！", "Karintas#rockc04", bc_self;
	npctalk "那我要猎杀一百、一百、一百只郊狼！", "", bc_self;
	npctalk "我是猎杀郊狼的冒险者！", "Swift Scorpion#rockc03", bc_self;
	npctalk "你们这些淘气鬼，我说过不要玩冒险者游戏吗？", "Mrs. Cacturon#rrrem01", bc_self;
	end;
}

rockrdg1,327,109,5	script	Swift Scorpion#rockc03	4_F_CACTUSCHILD2,{
	mes "[Agile Scorpion]";
	mes "*呜咽*但我们也想像他们一样猎杀郊狼。汪！汪汪！嘿！";
	next;
	mes "[Karintas]";
	mes "也许我们村的大人们也该出去猎杀郊狼。";
	next;
	mes "[Curt Snake]";
	mes "你们这些笨蛋，我们不想猎杀它们。";
	mes "我们想在Kiwawa Desert与它们和平共处。";
	next;
	mes "[Curt Snake]";
	mes "只是周围有太多郊狼对我们不安全。所以我们才请求冒险者帮助。";
	mes "但这不意味着我们想消灭所有郊狼。";
	close;
}

rockrdg1,287,95,3	script	Litis#rockc10	4_F_CACTUSLADY2,{
	mes "[Litis]";
	mes "我明白Glaring Eagle先生的意思，也明白他为什么如此担心。";
	next;
	mes "[Litis]";
	mes "但今天的河流和昨天不同。事物不断变化，这是自然规律。";
	close;
}

rockrdg1,297,111,3	script	Roytanen#rockc10	4_F_RANGER,{
	mes "[Roytanen]";
	mes "*倒吸气*我回到Cactus村了。啊，我又迷路了吗？";
	next;
	emotion ET_CRY;
	mes "[Roytanen]";
	mes "Kiwawa Desert辽阔无边，到处只有泥土和岩石，很容易迷路。";
	next;
	mes "[Roytanen]";
	mes "天啊，我真的不想再出门了……希望离开前能喝一杯凉水。";
	close;
}


harboro1,91,211,3	script	#rockno01	HIDDEN_NPC,5,5,{
	mes "[Central Road Sign]";
	mes "沿这条路向东，可到达旅馆、Sheriff办公室、商店和广场。";
	next;
	mes "[Central Road Sign]";
	mes "这条路也通往村外的Kiwawa Desert。";
	close;

OnTouch:
	npctalk "中央道路", "", bc_self;
	end;
}


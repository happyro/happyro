	end;
OnTouch:
	npctalk "西：旅馆，东：Sheriff办公室", "", bc_self;
	end;
}

harboro1,134,211,3	script	#rockno05	HIDDEN_NPC,5,5,{
	end;
OnTouch:
	npctalk "东：旅馆", "", bc_self;
	end;
}

harboro1,310,201,3	script	#rockno06	HIDDEN_NPC,5,5,{
	end;
OnTouch:
	npctalk "工具店、武器/防具店", "", bc_self;
	end;
}

harboro1,60,215,5	script	Karam Pucci#harboro1	4_M_SEAMAN,{
	mes "[Karam Pucci]";
	mes "你想回Alberta吗？";
	next;
	if (select( "是。", "不是。" ) == 2) {
		mes "[Karam Pucci]";
		mes "没问题。我不介意再在这里待一会儿。";
		mes "事实上，我的公司也希望如此。";
		close;
	}
	mes "[Karam Pucci]";
	mes "那我们走吧！";
	close2;
	warp "alberta",172,131;
	end;
}

harboro1,321,237,5	script	Rubina Adler#rockn07	4_F_SITDOWN,{
	emotion ET_DELIGHT;
	mes "[Rubina Adler]";
	mes "嗯，嗯！龙舌兰汁是我在Rock Ridge喝过最好喝的东西。";
	next;
	mes "[Rubina Adler]";
	mes "我听说这是Cacti的传统饮料。喝下去感觉能冲掉堵在喉咙里的灰尘。";
	next;
	mes "[Rubina Adler]";
	mes "呃，等等。这不是真正的龙舌兰汁。上面写的是龙舌兰风味果汁。";
	next;
	emotion ET_SWEAT;
	mes "[Rubina Adler]";
	mes "啊，里面到底有没有龙舌兰？";
	close;
}

harboro1,75,211,1	script	Zebedee#rockwn13	4_KID01,5,5,{
	mes "[Zebedee]";
	mes "欢迎来到Rock Ridge！";
	mes "希望你能在这片梦想之地找到机会。";
	close;

OnTouch:
	specialeffect EF_SPHERE;
	emotion ET_BIGTHROB;
	npctalk "欢迎来到Rock Ridge！", "", bc_self;
	end;
}

harboro1,75,219,3	script	Irene#rockwn14	4W_KID,5,5,{
	mes "[Irene]";
	mes "冒险者，欢迎来到Rock Ridge！";
	mes "希望你喜欢探索这个美妙的地方。";
	close;

OnTouch:
	specialeffect EF_SPHERE;
	emotion ET_BIGTHROB;
	npctalk "欢迎，冒险者！", "", bc_self;
	end;
}


harboro1,79,224,5	script	Miles Wiesner#rockwn12	4_M_SITDOWN,{
	mes "[Miles Wiesner]";
	mes "我在等我的妹妹。她应该会乘下一艘船来。";
	mes "我先来到这里，再邀请她过来。";
	next;
	mes "[Miles Wiesner]";
	mes "一年前我决定来这片大陆时，她担心得不得了。";
	mes "看到我过得不错，她会很高兴。";
	next;
	mes "[Miles Wiesner]";
	mes "充满机会的土地，这就是Rock Ridge。";
	close;
}

harboro1,82,221,3	script	Cheerful Leaf#rockwn16	4_F_CACTUSCHILD2,{
	mes "[Cheerful Leaf]";
	mes "爷爷是我认识的最棒的Cactus！";
	mes "有时他说的话我听不懂，但没关系。";
	next;
	emotion ET_DELIGHT;
	mes "[Cheerful Leaf]";
	mes "希望我长得和他一样高时，能更好地理解他。";
	mes "我想快点长大，这样就能让他再告诉我以前说过的事。";
	close;

OnTouch:
	emotion ET_SMILE;
	end;
}

harboro1,83,221,3	script	Mahua Kaya#rockwn15	4_M_CACTUSCHIEF,{
	mes "[Mahua Kaya]";
	mes "有些Cacti不喜欢开拓者，但Leaf，记住他们也是大自然的孩子。";
	next;
	mes "[Cheerful Leaf]";
	mes "孩子？他们和Leaf一样可爱吗？";
	next;
	mes "[Mahua Kaya]";
	mes "当然。在大自然眼中，每个人，包括我这个老人，都是孩子。";
	next;
	emotion ET_SMILE;
	mes "[Cheerful Leaf]";
	mes "哈哈哈！这说不通。你又高又有胡子，婴儿可没有胡子。";
	next;
	mes "[Mahua Kaya]";
	mes "我的意思是，你应该像对朋友一样友善地对待他们。";
	mes "你明白吗，Leaf？";
	next;
	mes "[Cheerful Leaf]";
	mes "明白。Leaf是个好Cactus，也爱他的爷爷。";
	close;
}

harboro1,86,218,3	script	Welch#rockwn01	4_M_ARCHER,5,5,{
	mes "[Welch]";
	mes "你刚到吗？我也是，两天前来的。这里的风声不一样，我喜欢！";
	next;
	mes "[Welch]";
	mes "所有建筑都有新油漆的味道，无论走到哪里都能听见敲打声。这个村子充满活力！";
	next;
	emotion ET_SMILE;
	mes "[Welch]";
	mes "只是站在这里就让我开心得停不下笑。哈哈哈！";
	close;

OnTouch:
	emotion ET_DELIGHT;
	end;
}

harboro1,88,217,3	script	Edith Richie#rockwn02	4_F_KID2,{
	emotion ET_PROFUSELY_SWEAT;
	mes "[Edith Richie]";
	mes "我爸爸在火车站工作。";
	mes "在东边？嗯，等等。西边是左手边，然后……";
	next;
	mes "[Edith Richie]";
	mes "看地图一直往上走就行。你会到达火车站。";
	mes "我爸爸很强，一次能搬很多箱子！";
	close;
}

harboro1,86,210,4	script	Carmen O'Neil#rockwn06	8_F,{
	mes "[Carmen O'Neil]";
	mes "*打嗝*我可以喝一整天啤酒！";
	next;
	mes "[Leland Wenkins]";
	mes "让我们赚钱，然后——嘿嘿！——吃点美味的东西！";
	next;
	npctalk "天啊，他们又在喝酒。", "Mortimer#rockwn07", bc_self;
	mes "[Drunk Doram]";
	mes "我还要鸡肉，喵！鸡肉真的很容易消化。";
	close;
}

harboro1,85,208,7	script	Leland Wenkins#rockwn03	4_M_TWTEAMAN,5,5,{
	mes "[Leland Wenkins]";
	mes "为我们伟大的村子干杯！干杯！";
	next;
	mes "[Carmen O'Neil]";
	mes "为开拓精神干杯！干杯！";
	next;
	unittalk getcharid(3), "" + strcharinfo(0) + "：他们喝醉了。", bc_self;
	mes "[Drunk Doram]";
	mes "*打嗝*干杯！喵喵！";
	close;

OnTouch_:
	if (.talk == 0) {
		.talk = 1;
		npctalk "为了Rock Ridge！";
		sleep 3000;
		npctalk "干杯！", "Carmen O'Neil#rockwn06";
		npctalk "干杯，喵！", "Drunk Doram#rockwn11";
		sleep 9000;
		npctalk "哇哈哈哈！啤酒最棒！";
		sleep 1000;
		npctalk "我尤其喜欢白天喝！", "Carmen O'Neil#rockwn06";
		sleep 1000;
		npctalk "鸡肉！*打嗝*一定要配鸡肉！", "Drunk Doram#rockwn11";
		sleep 9000;
		npctalk "我们是谁？";
		sleep 1000;
		npctalk "我们是Rock Ridge的开拓者！", "Carmen O'Neil#rockwn06";
		sleep 1000;
		npctalk "我们勇敢！我们英勇！", "Drunk Doram#rockwn11";
		sleep 3000;
		npctalk "我们是Rock Ridge的开拓者！";
		npctalk "我们是Rock Ridge的开拓者！", "Carmen O'Neil#rockwn06";
		npctalk "喵、喵、喵！嘻嘻，喵！", "Drunk Doram#rockwn11";
		sleep 9000;
		.talk = 0;
	}
	end;
}

harboro1,100,77,4	script	Maybell#rockn02	8_F,{
	mes "[Maybell]";
	mes "Rock Ridge是一个海边村庄。最初……嗯，即使现在也在与大海抗争。";
	next;
	mes "[Maybell]";
	mes "你知道这个村子下面还有一层吗？那里是最初的Rock Ridge，因为海水侵蚀和地下水淹没而无法居住。";
	next;
	mes "[Maybell]";
	mes "Mayor Costell的解决办法是填埋第一层，在上面建造新村子。现在原来的第一层成了地下室，第二层才是真正的一层。";
	next;
	mes "[Maybell]";
	mes "我们仍需每天抽水防止洪水，但那只是小挫折——我们退一步是为了前进两步。Rock Ridge会继续发展。";
	close;
}

harboro1,229,64,3	script	Rosemary Weber#rockn03	4_F_EINWOMAN,{
	mes "[Rosemary Weber]";
	mes "我厌倦了被这么多水包围！所以我们必须不断修缮地面和上面的建筑。";
	mes "你知道我们不得不填埋原本的村庄地面吗？那是个艰难的决定，而且仍没解决所有问题。";
	next;
	mes "[Rosemary Weber]";
	mes "大多数建筑由木头建成，容易腐烂。彻底填埋花费了大量金钱和精力，才能让新的地面不再下沉。";
	next;
	mes "[Rosemary Weber]";
	emotion 54, getnpcid(0,"Rosemary Weber#rockn03");
	mes "填埋工作至今仍未完成。唉，我都不知道那是不是个好决定了。";
	close;
}

harboro1,87,207,1	script	Drunk Doram#rockwn11	4_CAT_SAILOR5,{
	mes "[Leland Wenkins]";
	mes "我们是Rock Ridge伟大的开拓者！嘿，吼！";
	next;
	mes "[Carmen O'Neil]";
	mes "我们挖矿、建房！海水和沙尘暴都无法阻止我们！";
	next;
	npctalk "他声音真大。", "Edith Richie#rockwn02", bc_self;
	mes "[Drunk Doram]";
	mes "喵！喵喵！喵哈哈！喵喵！";
	close;
}


harboro1,80,204,7	script	Elsie#rockwn05	4W_KID,5,5,{
	mes "[Elsie]";
	mes "哇，好漂亮！";
	next;
	emotion ET_QUESTION;
	mes "[Elsie]";
	mes "要五百万Zeny。那是多少钱？";
	next;
	mes "[Mortimer]";
	mes "啊，那个价格只对冒险者。";
	mes "像你这样漂亮的小女士，二百Zeny就可以了。";
	next;
	mes "[" + strcharinfo(0) + "]";
	mes "我也漂亮又娇小。";
	next;
	emotion ET_SWEAT;
	mes "[Mortimer]";
	mes "……你不是妄想，";
	mes "就是厚脸皮。";
	next;
	emotion ET_FRET, playerattached();
	mes "[" + strcharinfo(0) + "]";
	mes "你才厚脸皮！";
	close;

OnTouch:
	emotion ET_SURPRISE;
	end;
}

harboro1,81,205,1	script	Mortimer#rockwn07	4_M_ROGUE,5,5,{
	mes "[Mortimer]";
	mes "纪念品！我有纪念品！";
	mes "给家人、朋友、老师和重要的人买纪念品吧！";
	next;
	mes "[Mortimer]";
	mes "啊，冒险者。要买些纪念品吗？";
	next;
	npctalk "它们便宜得几乎等于白送。其实我这样是在亏钱！", "", bc_self;
	mes "[Mortimer]";
	mes "我给你特别折扣。这件羽毛饰品只要两百万Zeny。这条手帕——哦，哇！——只要五百万！";
	next;
	emotion ET_HUK, playerattached();
	mes "[" + strcharinfo(0) + "]";
	mes "太贵了！";
	close;

OnTouch:
	npctalk "纪念品！我有纪念品！", "", bc_self;
	end;
}

harboro1,73,206,5	script	Walter Greenwald#rockwn	4_M_BARD,{
	mes "[Walter Greenwald]";
	mes "我想你从大陆一路来到这里一定有原因。";
	mes "完成那件事后，如果不知道该做什么，那么……";
	next;
	mes "[Walter Greenwald]";
	mes "我建议你沿中央道路到村庄东门，再往南走一点。";
	mes "打开地图后，那是3点钟方向。";
	next;
	mes "[Walter Greenwald]";
	mes "在那里，你能遇到提供工作和食物的人。";
	mes "当然，他们周围也有许多想要工作和食物的人。";
	close;
}

harboro1,84,200,5	script	Delbert Lake#rockwn04	4_M_EINMINER,{
	mes "[Delbert Lake]";
	mes "成为百万富翁前我不会回家！";
	mes "我太兴奋了，穿着全套采矿装备就上了船！";
	next;
	mes "[Delbert Lake]";
	mes "好漂亮的石头！嘿呀！";
	mes "出来吧，黄金、白银、钻石！你们躲不过Delbert！";
	next;
	emotion ET_FRET, getnpcid(0, "Constance#rockwn18");
	mes "[Constance]";
	mes "喂，你疯了吗？！";
	mes "那不是矿脉，是装饰石！现在把镐子从它旁边拿开！";
	close;
}

harboro1,85,195,1	script	Constance#rockwn18	4_F_EINWOMAN,5,5,{
	mes "[Constance]";
	mes "啊，你是冒险者吗？请帮我阻止那个疯子！";
	next;
	mes "[Constance]";
	mes "他穿着沉重的采矿装备从大陆船上下来，一看到那块石头就变成了挥舞镐子的疯子。";
	next;
	emotion ET_ANGER;
	mes "[Constance]";
	mes "那不是矿脉，而是我们村民一起搬来的装饰石。我告诉过他，但他根本不在乎！";
	mes "他穿着全套采矿装备，却分不清普通石头和矿脉。有多蠢啊？";
	close;

OnTouch:
	npctalk "哇哈哈，我要把一切都挖出来！", "Delbert Lake#rockwn04", bc_self;
	npctalk "喂，别挥那把镐子！", "", bc_self;

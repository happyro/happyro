	mes "[Plaza Sign]";
	mes "Rock Ridge广场内提供Kafra服务。";
	next;
	mes "[Plaza Sign]";
	mes "Sheriff办公室和商店建筑在广场西侧。旅馆和港口还要更往西。";
	close;

OnTouch:
	npctalk "Rock Ridge广场", "", bc_self;
	end;
}


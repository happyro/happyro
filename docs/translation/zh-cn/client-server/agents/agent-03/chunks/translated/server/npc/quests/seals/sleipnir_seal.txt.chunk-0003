}

que_god01,14,47,3	script	Researcher#G4	713,{
	if ($God1 < $@god_check2) {
		if (god_sl_1 == 2) {
			set god_sl_1,41;
		}
		if ((god_sl_1 == 41) || (god_sl_1 == 12) || (god_sl_1 == 23) || (god_sl_1 == 34)) {
			if (god_sl_2 == 0) {
				mes "[Pavel]";
				mes "^333333*Sniff sniff*...";
				mes "*Achoo!*^000000 Huh?";
		mes "你是谁？";
				next;
				mes "[Pavel]";
		mes "哦，抱歉。你一定是新助理——^333333*啊嚏！*^000000呃，^333333*抽鼻子*^000000抱歉。你看，我有点不舒服。";
				next;
				mes "[Pavel]";
		mes "知道你来帮我真好。但是^333333*啊嚏！抽鼻子*^000000";
				next;
				mes "[Pavel]";
		mes "总之，去看看那个——^333333*啊嚏！*^000000那件^333333*啊嚏！*^000000东西……^333333*抽鼻子*^000000";
				set god_sl_2,1;
				close;
			}
			else if (god_sl_2 == 1) {
				mes "[Pavel]";
				mes "我叫你去看看那个——^333333*啊嚏！*^000000那件^333333*啊嚏！啊嚏！咳咳*^000000";
				close;
			}
			else if (god_sl_2 == 2) {
				mes "[Pavel]";
				mes "^333333*Cough cough*";
				mes "*Sniff sniff...*^000000";
				mes "你看过了吗？即使看到了，我也不认为你能理解。^333333*咳咳*^000000";
				next;
				mes "[Pavel]";
				mes "^333333*AAAAACHHHOOO!*^000000";
				mes "那块石板，不，等等，^333333*啊嚏！*^000000上面刻的文字是古代——^333333*啊嚏！*^000000如今已经没人使用的语言。";
				next;
				mes "[Pavel]";
				mes "我无法判断^333333*咳咳*^000000那是什么古代语言——^333333*啊嚏！*^000000所以……嗯……";
				next;
				mes "[Pavel]";
				mes "考虑到^333333*啊嚏！抽鼻子*^000000石板使用的材料并非^333333*抽鼻子*^000000普通石头，里面一定安装了某种装置？^333333*咳*^000000";
				next;
				mes "[Pavel]";
				mes "不仅如此，^333333*抽鼻子*^000000文字不只是刻上去的。^333333*啊嚏！*^000000有东西覆盖着^333333*咳*^000000表面。";
				next;
				mes "[Pavel]";
				mes "我必须^333333*咳咳*^000000拆下装置，才能^333333*咳咳*^000000继续调查。^333333*抽鼻子*^000000但看看我，我已经狼狈不堪，甚至无法^333333*啊嚏！*^000000……说话。";
				next;
				mes "[Pavel]";
				mes "^333333*Sniff sniff*^000000";
				mes "所以希望你不介意^333333*啊嚏！*^000000帮我拆下^333333*咳*^000000装置。非常感谢。^333333*抽鼻子*^000000";
				set god_sl_2,3;
				close;
			}
			else if (god_sl_2 == 3) {
				mes "[Pavel]";
				mes "^333333Aaaaaccccchhhhoooo...!*^000000";
				mes "呃，我想说的是——^333333啊嚏！^000000";
				mes "^333333*Sniff sniff...*^000000";
				close;
			}
			else if (god_sl_2 == 4) {
				mes "[Pavel]";
				mes "^333333*Cough*^000000";
				mes "哦……^333333*抽鼻子*^000000";
				mes "我明白了……";
				mes "^333333*glhk glhk*^000000";
				next;
				mes "[Pavel]";
				mes "我说得对～^333333*啊嚏！*^000000没错，^333333*啊嚏！*^000000石板里确实安装了东西。^333333*咳*^000000都怪这该死的^333333*咳咳咳*^000000流感，我没法亲自查看。";
				next;
				mes "[Pavel]";
				mes "干得好～";
				mes "你做得^333333*抽鼻子*^000000很棒。非常感谢你的帮助。^333333*啊嚏！啊嚏！*^000000";
				set god_sl_2,0;
				if (god_sl_1 == 41) {
					set god_sl_1,42;
				}
				if (god_sl_1 == 12) {
					set god_sl_1,13;
				}
				if (god_sl_1 == 23) {
					set god_sl_1,24;
				}
				if (god_sl_1 == 34) {
					set god_sl_1,50;
				}
				close;
			}
		}
		else {
			mes "[Pavel]";
			mes "我们能否真正探测或感知灵魂并不重要，首先要证明它们确实存在。";
			close2;
		}
	}
	else {
		mes "[Pavel]";
		mes "我们能否真正探测或感知灵魂并不重要，首先要证明它们确实存在。";
		close2;
	}
}


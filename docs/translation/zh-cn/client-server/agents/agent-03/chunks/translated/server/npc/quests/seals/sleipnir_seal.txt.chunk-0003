payon,79,171,4	script	Friar#G5	95,{
	if ($God1 < $@god_check2) {
		if ((god_sl_1 == 21) || (god_sl_1 == 32) || (god_sl_1 == 43) || (god_sl_1 == 14)) {
			if ((god_sl_2 == 1) || (god_sl_2 == 3)) {
				mes "[Lania]";
			mes "无论故事多么古老，民间故事和传说中总能找到有益的建议。";
				next;
				mes "[Lania]";
			mes "尽管时代变迁、人类进步，生活的某些基本原则永恒不变。";
				next;
			switch(select("嗯……:我明白了。")) {
				case 1:
					mes "[Lania]";
					mes "嗯……？你需要我做什么吗？我会尽力帮助你。";
					next;
					mes "[Lania]";
					mes "我相信，拥有能力或力量却不用于正确目的，就没有意义。";
					next;
							switch(select("不用了，没关系。:Sleipnir 的故事。")) {
					case 1:
						mes "[Lania]";
							mes "我一定是误会了。不过需要时尽管来找我帮忙。";
						next;
						mes "[Lania]";
							mes "我把帮助他人视为精神修行。希望你也能善良慷慨地对待他人。";
						close;
					case 2:
						mes "[Lania]";
							mes "啊，我明白了。我可以告诉你我知道的 Sleipnir。让我看看能否记起全部。";
						next;
						mes "[Lania]";
							mes "啊，是的。我想起来了。Sleipnir 是 Odin 的战马。";
						next;
						mes "[Lania]";
						mes "在诸神世界，有三匹传说战马：Sleipnir、Svadilfari 和 Gullfaxi。";
						next;
						mes "[Lania]";
						mes "Gullfaxi 属于巨人之王 Hrungnir。Svadilfari 是 Sleipnir 的父亲，也属于一名巨人。";
						next;
						mes "[Lania]";
						mes "好，现在谈谈 Sleipnir 如何诞生。这个故事展示了诸神和巨人的弱点。";
						next;
						mes "[Lania]";
						mes "在诸神领域 Asgard，有一道巨大的防护城墙，最近的战争几乎将其摧毁。";
						next;
						mes "[Lania]";
						mes "然而……诸神毕竟是诸神，他们不愿亲自重建城墙。";
						next;
						mes "[Lania]";
						mes "一天，一个瘦削男人骑着黑马，提出重建甚至改良保护 Asgard 的城墙。";
						next;
						mes "[Lania]";
						mes "诸神需要抵御敌人的一切保护，因此他的提议很诱人。";
						next;
						mes "[Lania]";
						mes "男人承诺只用 18 个月重建 Asgard 城墙，但要求娶女神 Freya，并拥有太阳和月亮。";
						next;
						mes "[Lania]";
						mes "这个代价对诸神来说太不合理。Asgard 众神被陌生人的要求激怒并感到受辱，但他们确实想重建城墙。";
						next;
						mes "[Lania]";
						mes ".....";
						mes "你无聊了吗？如果是，我们可以以后再讲完这个故事。";
						next;

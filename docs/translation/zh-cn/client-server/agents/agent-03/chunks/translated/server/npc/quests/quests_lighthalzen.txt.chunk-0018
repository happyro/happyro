		next;
		mes "[Karl]";
	mes "……我为自己的所作所为感到非常抱歉。";
		next;
		mes "[Karl]";
	mes "谢谢你带来这份珍贵礼物。我会坚强起来，努力实现目标。";
		next;
		mes "[Karl]";
	mes "我会招募新成员，让全世界知道那家公司究竟做了什么。";
		next;
		mes "[Karl]";
	mes "真的非常感谢。你可以相信我会纠正错误。";
		set hg_tre,57;
		delitem 7342,1; //File01
		getexp (checkre(3))?200000:2000000,0;
		getitem 617,1;
		close2;
		cutin "",255;
		end;
	}
	else if(hg_tre == 57)
	{
		mes "[Karl]";
	mes "我正在招募能帮助我击垮 Rekenber 公司的能人。多亏了你，我已经有足够的信息迈出重要的第一步。";
		next;
		mes "[Karl]";
	mes "我让手下收集了一些情报，得知 Regenschirm 已经停止运作。你为施瓦茨瓦尔德共和国做得很好。";
		close2;
		cutin "",255;
		end;
	}
	else
	{
		mes "[Karl]";
		mes ".........";
		mes "............";
		close2;
		cutin "",255;
		end;
	}
}


		close;
	}
}

aldebaran,58,225,4	script	Kafra Employee#l1	4_F_KAFRA2,{

	if(lhz_boss != 17)
	{
		mes "[Kafra Employee]";
		mes "欢迎来到卡普拉总部。在卡普拉业务的中心，你可以享受其他地方没有的特殊服务！";
		next;
		mes "[Kafra Employee]";
		mes "如果有任何需要，请询问建筑内的卡普拉员工。谢谢，祝你今天愉快~";
		close;
	}
	mes "[Kafra Employee]";
	mes "你好~卡普拉公司一直致力于让顾客满意。今天我能为你做什么？";
	next;
	switch( select( "我有个问题。","我没事，谢谢。" ) )
	{
		case 1:
			mes "[Kafra Employee]";
			mes "当然，我会尽力回答。不过涉及专业信息时，可能需要请你咨询其他员工。";
			next;
			switch( select( "你知道在哪里能找到 Benith 吗？" ) )
			{
				case 1:
					break;
			}
			mes "[Kafra Employee]";
			mes "哦，Benith？当然。她就在卡普拉总部里面，应该在右边某处。她穿着特殊制服，很容易找到。";
			next;
			mes "[Kafra Employee]";
			mes "好的，祝你今天愉快！记住，卡普拉服务永远站在你这边~";
			close;

		case 2:
			mes "[Kafra Employee]";
			mes "如果需要卡普拉的特殊服务，随时询问附近的员工。谢谢，祝你愉快~";
			close;
	}
}

aldeba_in,155,240,5	script	Kafra Employee#l2	4_F_AGENTKAFRA,{

	if(checkweight(7343,1) != 1)
	{
		mes "^3355FF等一下！你现在携带的物品太多了。请先使用卡普拉服务存放一些物品后再回来。^000000";
		close;
	}
	if(lhz_boss < 17)
	{
		mes "[Kafra Employee]";
		mes "欢迎来到卡普拉总部。想知道卡普拉有什么新消息？很高兴你问了。我们正在与 Cool Event 公司开发全新项目。";
		next;
		mes "[Kafra Employee]";
		mes "这个项目将为尊贵的顾客提供直达地下城的传送服务。是不是……很令人兴奋？";
		next;
		mes "[Kafra Employee]";
		mes "由于技术问题，卡普拉公司和 Cool Event 公司无法同时向同一地下城提供传送服务，因此将选出一家统一的传送服务提供商。";
		next;
		mes "[Kafra Employee]";
		mes "因此，我们将通过选举决定哪家公司提供地下城传送服务。投票前请确认资格要求。";
		close;
	}
	else if(lhz_boss == 17)
	{
		mes "[Kafra Employee]";
		mes "欢迎来到卡普拉总部。想知道卡普拉有什么新消息？很高兴你问了。我们正在与 Cool Event 公司开发全新项目。";
		next;
		mes "[Kafra Employee]";
		mes "这个项目将为尊贵的顾客提供直达地下城的传送服务。是不是……很令人兴奋？";
		next;
		mes "[Kafra Employee]";
		mes "由于技术问题，卡普拉公司和 Cool Event 公司无法同时向同一地下城提供传送服务，因此将选出一家统一的传送服务提供商。";
		next;
		mes "[Kafra Employee]";
		mes "我们想通知你，顾客将通过选举决定传送服务提供商。非常感谢你投出宝贵的一票。";
		next;
		mes "[Kafra Employee]";
		mes "记得参加在普隆德拉和朱诺举行的投票。祝你投票愉快。";
		next;
		switch( select( "好的。","我等不及了！" ) )
		{
			case 1:
				mes "[Kafra Employee]";
				mes "呃……你有问题吗？说实话，我对卡普拉提供的服务了解不多。我的工作……我在另一个部门。";
				next;
				switch( select( "哦，那就算了。","你是 Benith 吗……？" ) )
				{
					case 1:
						mes "[Kafra Employee]";
						mes "*呼！*太好了。如果你对卡普拉服务有疑问，请询问普通卡普拉员工。谢谢。";
						close;

					case 2:
						mes "[Benith]";
						mes "是的，就是我。有什么我能为你做的吗？";
						next;
						switch( select( "没什么。","出示会员卡。" ) )
						{
							case 1:
								mes "[Benith]";
								mes "真的吗？好吧。";
								close;

							case 2:
								if(!countitem(7348))
								{
								mes "^3355FF等等……没有会员卡，你不能出示‘秘密之翼’会员卡！^000000";
									close;
								}
								mes "[Benith]";
								mes "哦，我一直在等你。终于可以放下宣传的伪装，谈正事并告诉你任务了。";
								next;
								mes "[Benith]";
								mes "作为经验丰富的冒险者，你擅长取回物品并对抗魔物。我们有一项适合你专长的救援任务。";
								next;
								mes "[Benith]";
								mes "我们的一名特殊特工遭遇事故，困在^FF0000死神峡谷^000000，那里位于艾因布洛克和拉赫之间。";
								next;
								mes "[Benith]";
								mes "据报我们的特工 Jargeah 藏在那里的断桥附近。其他特工都被派去执行任务了，现在只有你能帮助他。";
								next;
								mes "[Benith]";
								mes "他身受重伤，请赶快行动，别让敌人先找到他……";
								set lhz_boss,18;
								changequest 12019,12020;
								close;
						}
				}

			case 2:
				mes "[Kafra Employee]";
			mes "这算一名——我的意思是，非常感谢你的参与。记住，卡普拉永远站在你这边。";
				close;
		}
	}
	else if(lhz_boss == 18)
	{
		mes "[Benith]";
		mes "请快去救 Jargeah。如果敌人在我们之前找到他，他的努力乃至生命都可能白费。";
		next;
		mes "[Benith]";
		mes "你应该能在死神峡谷的断桥附近找到他，那里位于艾因布洛克和拉赫之间。";
		close;
	}
	else if(lhz_boss == 19)
	{
		if(!countitem(7343))
		{
			mes "[Benith]";
			mes "请快点！我不想让敌人在我们之前找到 Jargeah！他的生命和秘密之翼都危在旦夕！";
			close;
		}
		mes "[Benith]";
		mes "太好了，你回来了，还带来了 Jargeah 设法取得的情报。但是……Jargeah 在哪里？他是不是……？";
		next;
		switch( select( "他去了更好的地方。" ) )
		{
			case 1:
				break;
		}
		mes "[Benith]";
		mes "...";
		mes "......";
		next;
		mes "[Benith]";
		mes "什么……？！不——！同志 Jargeah！我向你发誓，你不会白白牺牲！为什么又有好人死去？回答我！！";
		next;
		mes "[Benith]";
		mes "我不能……不行。我们必须先向 Jargeah 的高尚牺牲致敬，不能先沉溺于哀悼。把文件交给他之前，让我先读一读……";
		delitem 7343,1;
		set lhz_boss,20;
		close;
	}
	else if(lhz_boss == 20)
	{
		mes "[Benith]";
		mes "好吧。现在请把这份文件交给^FF0000他^000000。我相信你知道我说的是谁。秘密之翼就靠你了，勇敢的冒险者。";
		set lhz_boss,21;
		getitem 7343,1; //File02
		changequest 12021,12022;
		next;
		mes "[Benith]";
		mes "我以父亲的坟墓起誓，我为 Jargeah 流下的泪水，必将由我以神圣复仇洒下的鲜血偿还。Jargeah，请保佑我！";
		close;
	}
	else
	{
		mes "[Benith]";
		mes "欢、欢迎来到卡普拉总部。卡普拉有什么新消息？^333333很高兴……你……问了……^000000";
		close;
	}
}

lhz_fild02,228,214,0	script	Wounded Man	4_M_DIEMAN,{


// Quest: Childhood Friends. Step 1.
wolfvill,182,82,5	script	Albert#ep18	4_M_RACHMAN1,{
	if (ep18_main < 36) {
		mes "[Albert]";
		mes "...";
		close;
	}
	switch( isbegin_quest(8718) ) {
	case 0:
		mes "[Albert]";
		mes "如果你决定回拉赫，能帮我一个忙吗？";
		next;
		mes "[Albert]";
		mes "直说吧……我有个朋友曾在拉赫的旅馆当店员。";
		mes "如果他还没来这里，大概还在那儿工作。";
		next;
		mes "[Albert]";
		mes "我和我的朋友……Horim从小就住在我隔壁。";
		mes "我以前住在拉赫，但再也无法忍受，所以……";
		next;
		mes "[Albert]";
		mes "他们家和我家决定离开拉赫。";
		mes "但Horim说他要留在拉赫。";
		mes "我们等不下去了，所以把他留下，搬到了这里。";
		next;
		mes "[Albert]";
		mes "拉赫是座大城市，但他现在孤身一人。";
		mes "...";
		mes "如果你不介意，我想请你顺路看看他过得怎么样。";
		next;
		if (select( "可以", "我暂时不会去任何地方。" ) == 2) {
			mes "[Albert]";
			mes "既然如此，那就算了。";
			close;
		}
		mes "[Albert]";
		mes "谢谢。";
		mes "只是……顺路看看就好。不用向我报告。";
		setquest 8718;
		close;
	case 1:
		mes "[Albert]";
		mes "你不用向我报告。";
		mes "你只要确认Horim过得很好。";
		close;
	case 2:
		mes "[Alber]";
		mes "他见到那个孩子了吗？";
		mes "是的。";
		mes "...yes.";
		mes "我说完了离开时没能说出口的一切。";
		mes "现在已经没有遗憾了。";
		next;
		mes "[Alber]";
		mes "感觉灰色的森林正在发光。";
		mes "我做不到。";
		mes "冒险家们，这都多亏了你。";
		mes "谢谢你。";
		close;
	}
	end;

OnInit:
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "isbegin_quest(8718) == 0 && isbegin_quest(11724) == 2" );
	end;
}


ra_in01,388,59,5	script(CLOAKED)	Employee#ep1800	4_M_RACHMAN2,{
	if (ep18_main < 36)
		end;
	if (isbegin_quest(8718) == 1) {
		mes "[Employee]";
		mes "...!";
		mes "冒险家，你身上有火山灰的味道。";
		mes "托尔火山……不，不是。";
		next;
		mes "工作人员环顾片刻，低声说了句抱歉。";
		next;
		mes "[Employee]";
		mes "你去过灰狼森林吗……";
		next;
		if (select( "I know.", "I don't know" ) == 2) {
			mes "[Employee]";
			mes "假装不知道没有用。";
			next;
		}
		mes "[Employee]";
		mes "...I was wondering if you could direct me there.";
		mes "我真的……真的想去那里。";
		next;
		mes "[Employee]";
		mes "我知道那条路很危险，而我不是冒险家……";
		mes "但我真的没有办法去那里。";
		next;
		mes "[Employee]";
		mes "我的朋友和家人都要离开，所以我决定坚持下去，但是……";
		mes "某天晚上，他们以为我会阻碍他们，像一群破坏者一样全都离开了。";
		mes "然后，当然，我们再也没收到他们的消息……";
		next;
		mes "[Employee]";
		mes "请带我去那里。";
		mes "我已经没有任何人了。";
		next;
		select( "Did something go wrong?" );
		mes "他甚至还没介绍完自己。";
		next;
		mes "[Employee]";
		mes "是啊，我也不知道自己在说什么。";
		mes "我叫Horim。";
		mes "冒险家……";
		mes "" + strcharinfo(0) + ", you?";
		next;
		mes "[Horim]";
		mes "那么……" + strcharinfo(0) + "You.";
		mes "你去过那里，就会知道<B>我们的</B>情况。";
		next;
		mes "[Horim]";
		mes "在家人离开之前，那里比现在好。";
		mes "现在看起来和当时没什么不同……";
		next;
		mes "[Horim]";
		mes "现在表面上……还好，我们有许多政策。但表面之下却不断腐烂……";
		mes "走在街上时，我甚至听不见自己的笑声。我感觉有人在叫我、叫我们难听的名字。";
		mes "我再也受不了了……";
		next;
		select( "Once I started..." );
		mes "[" + strcharinfo(0) + "]";
		mes "只要开过一次头，第二次、第三次也会一样。";
		next;
		mes "[Horim]";
		mes "...Thank you. Thank you so much...";
		next;
		mes "Horim勉强说出一句感谢，松了口气。";
		next;
		npctalk "Employee: Coming~", "Employee#ep1801", bc_self;
		mes "[Horim]";
		mes "...I'm sorry, sir. I've got a little something going on right now, and I have to go.";
		next;
		mes "[Horim]";
		mes "回头见，我们在拉赫城门外见。";
		completequest 8718;
		setquest 8698;
		close2;
		cloakonnpcself( "Employee#ep1800" );
		cloakonnpcself( "Employee#ep1801" );
		end;
	}
	end;

OnInit:
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "isbegin_quest(8718) == 1" );
	end;
}


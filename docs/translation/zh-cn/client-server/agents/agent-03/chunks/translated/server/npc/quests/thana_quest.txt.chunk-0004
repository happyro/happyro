				}
			case 3:
				mes "你决定忽略它。";
				close;
			}
		}
		mes "你没有适合这个锁孔的钥匙。";
		close;
	}
	mes "法术已经解除。你已从这座雕像获得所需的一切。";
	close;

OnTouch_:
	if ((countitem(7424) == 0) && (countitem(7429) == 0))
		specialeffect EF_LEVEL99_4;
	end;
}

tha_t06,204,181,0	script	Splendid Sword#tt5	111,3,3,{
	if ((countitem(7425) == 0) && (countitem(7430) == 0)) {
		mes "一把破旧的剑悬挂在华丽的桌子上方。";
		mes "它散发着阴沉的气息。";
		next;
		if ((countitem(7421) > 0) && (countitem(7422) > 0) && (countitem(7423) > 0) && (countitem(7424) > 0)) {
			mes "当你靠近时，口袋里的钥匙";
			mes "突然回应了神秘力量。";
			specialeffect2 EF_ABSORBSPIRITS;
			next;
			if(select("观察它。:忽略它。") == 2) {
				mes "^3355FF你决定不管";
				mes "这把剑。^000000";
				close;
			}
			mes "你越靠近，剑就越剧烈地震动。";
			mes "你的目光不断被剑柄吸引。";
			mes "随后你的双手失去控制，伸向剑柄……";
			next;
			switch(select("靠近剑刃:靠近剑柄:靠近桌子")) {
			case 1:
				mes "在未知召唤下，你决定抓住剑刃。";
				mes "你的双手受伤并开始流血。";
				specialeffect2 EF_HIT1;
				percentheal -20,0;
				close;
			case 2:
				mes "在未知召唤下，你决定抓住剑柄。";
				mes "钥匙中的神秘力量传入剑中，剑从桌上掉落。";
				next;
				mes "同时，桌面出现了一个小孔。";
				mes "现在你握着剑……";
				specialeffect EF_EXIT2;
				next;
				switch(select("劈砍桌子:将剑插入孔中:安全带走剑")) {
				case 1:
					mes "你用剑劈砍桌子。";
					mes "许多相互冲突的法术作用其上，你知道自己选错了。";
					mes "剑自动回到原来的桌面。";
					specialeffect EF_HIT1;
					specialeffect2 EF_HIT1;
					percentheal -20,0;
					close;
				case 2:
					mes "插入剑后，闪电在剑周围闪烁，黑烟从孔中升起。";
					mes "烟雾慢慢散去，你看见一个特定形状的物体……";
					specialeffect EF_CHANGEDARK;
					next;
					mes "^4d4dff突然，一把黑钥匙从烟雾中出现，你感到其中强大的诅咒力量。^000000";
					getitem 7425,1; //Key_Black
					if (thana_tower != 8) close;
					next;
					mes "你拾起钥匙观察时，桌下的抽屉突然打开。";
					mes "抽屉里有一本旧笔记本。";
					next;
					mes "笔记本显然包含重要信息。";
					mes "也许这就是雷根贝勒不惜牺牲也想找到的笔记本。";
					next;
					mes "^4d4dff你决定把笔记本和钥匙交给伯雷德。";
					mes "你获得了瓦尔蒙特的日志。^000000";
					set thana_tower, 9;
					changequest 7052,7053;
					getitem 11011,1; //Barmund_Note
					close;
				case 3:
					mes "你拿起剑时，许多相互冲突的法术让你感到震动。";
					mes "没错……偷窃是最糟糕的。";
					mes "剑自动回到原来的桌面。";
					close;
				}
			case 3:
				mes "你伸手寻找桌下的东西，但什么也没有。";
				close;
			}
		}
		mes "你强烈感受到这里有被封印的诅咒力量，";
		mes "但很难判断原因。";
		mes "你无法靠近。";
		close;
	}
	mes "你已经用这把剑解除过封印。";
	mes "你已从这里获得所需的一切。";
	close;

OnTouch_:
	if ((countitem(7425) == 0) && (countitem(7430) == 0))
		specialeffect EF_LEVEL99_4;
	end;
}


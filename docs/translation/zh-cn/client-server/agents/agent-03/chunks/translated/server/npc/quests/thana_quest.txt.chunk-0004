tha_t08,90,153,0	script	Shining Crystal#tt_r1	844,{
	if (countitem(7421) > 0) {
		mes "水晶球正释放神秘力量。";
		next;
		mes "水晶球旁的地面上有褪色的图案。";
		mes "看起来像某种需要插入物品的锁孔……";
		next;
		mes "靠近锁孔后，红钥匙突然产生反应。";
		mes "你将钥匙插入锁孔，结果它变成了一颗小宝石。";
		next;
		mes "触摸耀眼的红色宝石时……";
		mes "你内心深处感到孤独和悲伤……";
		next;
		mes "^4d4dff你找到了一块凝聚残酷命运与深沉黑暗的红色护符石。^000000";
		delitem 7421,1; //Key_Red
		getitem 7426,1; //Magic_Gem_Red
		close;
	}
	mes "水晶球正释放神秘力量。";
	mes "里面肯定有东西……怎样才能打开它？";
	close;

OnInit:
OnDisable:
	disablenpc();
	end;
OnEnable:
	enablenpc();
	end;
}

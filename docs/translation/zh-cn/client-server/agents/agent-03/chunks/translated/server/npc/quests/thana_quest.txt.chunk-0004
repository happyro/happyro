tha_t12,161,57,0	script	Gold Religious Statue#tt	111,{
	if ($@thana_summon == 0) {
		if (countitem(7427) > 0) {
			mes "这是一座散发金色光芒的雕像。";
			mes "剑上似乎缺少宝石。";
			mes "靠近雕像时，黄色护符石发出耀眼光芒。";
			specialeffect EF_BEGINSPELL5;
			specialeffect2 EF_BEGINSPELL5;
			next;
			if(select("插入黄色护符石。:逃跑。") == 2) close;
			if ($@thana_summon == 0) {
				mes "将黄色护符石插入剑后，雕像开始产生反应。";
				specialeffect EF_BEGINSPELL5;
				delitem 7427,1; //Magic_Gem_Yellow
				set $@thana_summon, 1;
				donpcevent "#tteffect01::OnEnable";
				mapannounce "tha_t12","金色魔力释放了部分封印。",bc_map,"0x00ff00"; //FW_NORMAL 12 0 0
				close;
			}
			mes "有人已经将护符石插入这座雕像。";
			close;
		}
		mes "雕像散发神秘光芒。";
		mes "奇怪的力量阻挡了你。";
		close;
	}
	mes "雕像光芒太强，我无法看见或触摸它。";
	close;
}


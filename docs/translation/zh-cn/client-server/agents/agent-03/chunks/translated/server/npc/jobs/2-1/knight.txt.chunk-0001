//===== rAthena Script ======================================= 
//= Knight Job Quest
//===== By: ================================================== 
//= PGRO TEAM (Aegis).
//= Converted by kobra_k88
//= Further bugfixed and tested by Lupus
//===== Current Version: ===================================== 
//= 3.3
//===== Compatible With: ===================================== 
//= rAthena Project
//===== Description: ========================================= 
//= [Official Conversion]
//= Job Change quest for Knight class.
//===== Additional Comments: ================================= 
//= 1.0 Fully working.  Please comment out any pre-existing warps for the
//= test rooms in any other files so that the ones specified here can work.
//= 1.1 Fixed a major bug.  Now using the initnpctimer command,
//= donpcevent, and new waitingroom event commands.  No more addtimer
//= spamming.  No longer have to talk to the npc to take the test.  Just enter the chat room.
//= 1.2 More bug fixes.  Changed global variable names to unique ones.
//= Added second set of items to first test. Added Awake pots award for job change.
//= 1.3 Added Baby Class support [Lupus]
//= 1.5 Fixed possible EXP abuse [Lupus]
//= 1.6 Added a func which prevent advanced classes passing
//= 2nd Job Quests again. It also guides adv classes where
//= to go. [Lupus]
//= 2.0 Changed numbers to constants. [Vicious]
//= 2.1 Merged JFunc [Lupus]
//= 2.2 Rescripted to Aegis 10.3 standards. [L0ne_W0lf]
//= 2.3 Several bugfixes with the help of Barron-Monster. [L0ne_W0lf]
//= 2.4 Minor fixes to timer#knt. [L0ne_W0lf]
//= 2.5 Fixes a small bug with making claymores. [L0ne_W0lf]
//=     Corrected usages of killmonster and killmonsterall.
//= 2.6 Corrected an improper areawarp destination. [L0ne_W0lf]
//= 2.7 Deleted unused variables. [Samuray22]
//= 2.7a Corrected a Typo error ";;". [Samuray22]
//= 2.8 Now uses enable and disable waitingroomevent. [L0ne_W0lf]
//= 2.9 Added Quest Log commands. [Kisuka]
//= 3.0 Removed the need for use of 'goto.' [L0ne_W0lf]
//= 3.1 Modified the quest to renewal. [Vali] (Thanks to Muad_Dib for the necessary info).
//= 3.2 More Renewal updates and some optimization. [Euphy]
//= 3.3 Fixed missing changequest. [Joseph]
//============================================================ 

prt_in,88,101,4	script	Chivalry Captain#knt	56,{
	mes "[Captain Herman]";
	if (Upper == 1) {
		mes "嗯？你是……你身上有什么？我做了很久的荣誉骑士，却无法理解从你身上感受到的这股气息……";
		next;
		mes "[Captain Herman]";
		mes "愿神祝福你的身心，战士。希望你展现勇气，保护比你弱小的人。";
		close;
	}
	if (BaseJob != Job_Swordman) {
		if (BaseJob == Job_Knight) {
			mes "啊，我们骑士团的成员。";
			mes "希望你没有辜负我的期望。我们发誓为王国变得强大，即使死亡迫近也不退缩……";
			close;
		}
		else if (BaseClass == Job_Novice) {
			mes "欢迎，";
			mes "这里是";
			mes "普隆德拉骑士团。";
			mes "你为何来到这里？";
			next;
			switch(select("我想转职为剑士。:我想转职为骑士。:只是来看看。")) {
			case 1:
				mes "[Captain Herman]";
				mes "啊哈~";
				mes "你说你想成为剑士？";
				mes "抱歉，"+((Sex==SEX_MALE)?"小伙子":"姑娘")+"，但你";
				mes "来错地方了！";
				next;
				mes "[Captain Herman]";
				mes "这里不是剑士公会，而是普隆德拉骑士团！想成为剑士，请去伊兹鲁德的剑士公会。";
				close;
			case 2:
				mes "[Captain Herman]";
				mes "啊，我看得出你志向远大。但成为骑士前必须先成为剑士。";
				mes "一步一步来……";
				next;
				mes "[Captain Herman]";
				mes "首先去伊兹鲁德的剑士公会。成为经验丰富的剑士后，再回来找我们。";
				close;
			case 3:
				mes "[Captain Herman]";
				mes "啊哈~";
				mes "你一定很有空。与其漫无目的地闲逛，不如去猎杀一些怪物？";
				close;
			}
		}
		else {
			mes "欢迎。我们骄傲的普隆德拉骑士团愿为国王和国家献出生命！请好好参观。";
			close;
		}
	}
	if (KNIGHT_Q == 0) {
		mes "欢迎，这里是";
		mes "普隆德拉骑士团。";
		mes "你为何来到这里？";
		next;
		if (select("我想转职为骑士。:只是来看看。") == 1) {
			mes "[Captain Herman]";
			mes "哦……";
			mes "一位想成为骑士的"+((Sex==SEX_MALE)?"年轻人":"女士")+"！";
			mes "我们普隆德拉骑士团";
			mes "会帮助你。";
			next;
			mes "[Captain Herman]";
			mes "首先，我是普隆德拉骑士团团长赫尔曼·冯·埃菲西尔斯。很高兴见到渴望加入骑士团的年轻人。";
			next;
			mes "[Captain Herman]";
			mes "我们只接受";
			mes "职业等级至少 40 的剑士。";
			mes "经验不足以成为骑士的申请者不在考虑范围内。";
			next;
			mes "[Captain Herman]";
			mes "提交申请后，如果确认你符合资格，";
			mes "我们就会开始转职流程。你现在";
			mes "要申请吗？";
			next;
			if (select("是，我想申请。:请让我考虑一下。") == 1) {
				mes "[Captain Herman]";
				if (JobLevel < 40) {
					mes "啊，你还没准备好成为骑士！我不是特别说过职业等级 40 的要求吗？";
					next;
					mes "[Captain Herman]";
					mes "我当然理解你加入我们的强烈愿望，但现在还不是时候。出去再多战斗一些怪物吧。我们会在这里等你。";
					close;
				}
				if (SkillPoint) {
					mes "啊……！";
					mes "如果还有未使用的技能点，就不能转职。使用完";
					mes "所有技能点后再回来。";
					close;
				}
				set KNIGHT_Q,1;
				setquest 9000;
				mes "让我看看……";
				mes "你的名字是";
				mes strcharinfo(0) + "……";
				mes "对吗？";
				next;
				mes "[Captain Herman]";
				mes "让我说明转职流程。你必须拜访一系列骑士，并通过他们各自的";
				mes "测试。";
				next;
				mes "[Captain Herman]";
				mes "完成所有测试后，参与测试的每位骑士都会聚集起来讨论你的表现。";
				next;
				mes "[Captain Herman]";
				mes "所有骑士一致同意后，你才能加入普隆德拉骑士团。只要有一个人反对，你就必须";
				mes "重新开始。";
				next;
				mes "[Captain Herman]";
				mes "但我相信，只要你怀着真诚之心坚持下去，就会得到骑士们的认可，最终成为我们骑士团的一员。";
				next;
				mes "[Captain Herman]";
				mes "所以别再浪费时间聊天了！去见这些骑士并开始测试。完成所有测试后再回来找我。";
				close;
			}
			mes "[Captain Herman]";
			mes "哦……！";
			mes "我不想给你压力。慢慢考虑吧。准备好转职后再回来，";
			mes "我们会等着你。";
			close;
		}
		mes "[Captain Herman]";
		mes "说起来，你不是剑士吗？看起来你在战斗中遇到过很多敌人。";
		next;
		mes "[Captain Herman]";
		mes "你应该考虑转职为骑士。感兴趣的话来找我谈谈。";
		next;
		mes "[Captain Herman]";
		mes "请慢慢";
		mes "参观这里。";
		mes "祝你今天愉快。";
		close;
	}
	else if (KNIGHT_Q == 1) {
		mes "嗯？";
		mes strcharinfo(0) + "，";
		mes "我能为你做什么？";
		mes "啊，你不知道";
		mes "该拜访谁吗？";
		next;
		mes "[Captain Herman]";
		mes "负责测试的骑士安排了拜访顺序，我想这样有助于测试流程。";
		next;
		mes "[Captain Herman]";
		mes "首先去拜访";
		mes "安德鲁爵士参加第一次测试。别太紧张，和他交谈后他会解释一切。";
		close;
	}
	else if (KNIGHT_Q == 2) callsub L_Mission,0;
	else if (KNIGHT_Q == 3) callsub L_Mission,0;
	else if (KNIGHT_Q == 4) {
		callsub L_Mission,1;
		mes "看来你完成了一项测试。安德鲁爵士，这位剑士接下来该拜访谁？";
		next;
		mes "[Sir Andrew]";
		mes "我说过要";
		mes "拜访西拉库斯爵士。";
		mes "奇怪，我以为我告诉过";
		mes "你了。难道我忘了……？";
		next;
		mes "[Captain Herman]";
		mes "听到了吗？";
		mes "去找西拉库斯爵士参加测试。完成他的测试后，也别忘了接下来该拜访谁。";
		close;
	}
	else if (KNIGHT_Q == 5) callsub L_Mission,0;
	else if (KNIGHT_Q == 6) {
		callsub L_Mission,1;
		mes "让我看看……";
		mes "你已经完成两项测试。";
		mes "西拉修斯爵士，这名剑士接下来该拜访谁？";
		next;
		mes "[Sir Siracuse]";
		mes "哦……！";
		mes "嗯，接下来是谁……？";
		mes "对了！温莎爵士！";
		next;
		mes "[Captain Herman]";
		mes "前往";
		mes "温莎·本尼迪克特爵士那里参加下一项测试。仔细听测试骑士的说明，别迷路，明白吗？";
		close;
	}
	else if (KNIGHT_Q == 7) callsub L_Mission,0;
	else if (KNIGHT_Q == 8) {
		callsub L_Mission,1;
		mes "温莎爵士……？";
		mes "这名剑士";
		mes "接下来该拜访";
		mes "谁？";
		next;
		mes "[Sir Windsor]";
		mes "...";
		next;
		mes "[Sir Windsor]";
		mes "...";
		mes "......";
		next;
		mes "[Sir Windsor]";
		mes "...Amy Beatrice.";
		next;
		mes "[Captain Herman]";
		mes "啊，去拜访";
		mes "艾米女士并参加她的测试。注意下一项测试该去找谁。";
		close;
	}
	else if (KNIGHT_Q == 9) callsub L_Mission,0;
	else if (KNIGHT_Q == 10) {
		callsub L_Mission,1;
		mes "让我看看……";
		mes "艾米女士，这位剑士";
		mes "接下来必须拜访";
		mes "谁？";
		next;
		mes "[Lady Amy]";
		mes "哦……";
		mes "我说过要拜访";
		mes "埃德蒙爵士！";
		mes "嘻嘻~";
		next;
		mes "[Captain Herman]";
		mes "现在去和";
		mes "埃德蒙爵士交谈。他将";
		mes "负责你的";
		mes "下一项测试。";
		close;
	}
	else if (KNIGHT_Q == 11) callsub L_Mission,0;
	else if (KNIGHT_Q == 12) {
		callsub L_Mission,1;
		mes "你只需要再拜访一个人，对吧？负责";
		mes "最终测试的骑士";
		mes "是格雷·普罗斯菲罗爵士。";
		next;
		mes "[Sir Edmond]";
		mes "这个世界遵循";
		mes "因果法则运行。";
		mes "最终一切都会揭晓。";
		next;
		mes "[Captain Herman]";
		mes "保持警觉并尽力而为，";
		mes "因为这是最后一项测试。";
		mes "请不要大意。";
		next;
		mes "[Captain Herman]";
		mes "完成最后一项";
		mes "测试后";
		mes "回来找我。";
		mes "我会等你。";
		close;
	}
	else if (KNIGHT_Q == 13) {
		mes "完成最后一项测试。";
		mes "完成后，所有参与测试的骑士会集合，我们将评估你的表现。";
		close;
	}
	else if (KNIGHT_Q == 14) {
		if (SkillPoint) {
			mes "哦……！";
			mes "如果还有未使用的技能点，就不能转职。分配完所有技能点后再回来。";
			close;
		}
		mes "哦，你完成所有测试了吗？但不是所有完成测试的人都能";
		mes "成为骑士。";
		next;
		mes "[Captain Herman]";
		mes "测试中我们会观察你的忠诚、荣誉与力量，也会看你是否有礼貌，是否懂得谦逊与敬畏的价值。";
		next;
		mes "[Captain Herman]";
		mes "通过这个过程，我也观察了你的行动。我们七人的意见都会反映在转职决定中。";
		next;
		mes "[Captain Herman]";
		mes "那么……";
		mes "我们来听听";
		mes "大家的想法！";
		mes "安德鲁，你怎么看？";
		next;
		mes "[Sir Andrew]";
		if (JobLevel == 50) {
			mes "我还能说什么？";
			mes "我同意！";
			mes "一直以来作为";
			mes "剑士生活";
			mes "已经足够了。";
			mes "我认可他。";
		}
		else {
			mes "这个人收集了";
			mes "难以获得的物品，";
			mes "我同意！";
			mes "我相信他成为骑士后也会保持忠诚。";
			mes "请继续保持忠诚。";
		}
		next;
		mes "[Captain Herman]";
		mes "嗯。";
		mes "评价得不错。";
		mes "西拉库斯，你怎么看？";
		next;
		mes "[Sir Siracuse]";
		mes "嘿，很好。虽然还不是我";
		mes "所期望的样子，但希望未来会变得更好。";
		next;
		mes "[Sir Siracuse]";
		mes "成为骑士后，你必须用荣誉建立良好声望。嗯……我认可。";
		next;
		mes "[Captain Herman]";
		mes "好的……";
		mes "温莎，";
		mes "你怎么看？";
		next;
		mes "[Sir Windsor]";
		mes "...";
		next;
		mes "[Sir Windsor]";
		mes "...";
		mes "......";
		next;
		mes "[Sir Windsor]";
		mes "……通过。";
		next;
		mes "[Captain Herman]";
		mes "我想他没有";
		mes "表示反对。";
		mes "那么，听听";
		mes "艾米的意见。";
		next;
		mes "[Lady Amy]";
		if (Sex == SEX_MALE) {
			mes "嗯~他真有礼貌！";
			mes "他会成为出色的骑士。而且脸蛋好可爱~嘻嘻！";
		}
		else {
			mes "嗯~她应该很棒！";
			mes "她既有礼貌又可爱，再加几分！嘿~";
			mes "我不该说这些的！";
		}
		next;
		mes "[Captain Herman]";
		mes "嗯……";
		mes "奇怪的评价，";
		mes "但我相信";
		mes "她同意了。";
		mes "埃德蒙，说说";
		mes "你的想法。";
		next;
		mes "[Sir Edmond]";
		if (Sex == SEX_MALE) {
			mes "他看起来有些粗鲁，但内心闪耀着光芒。经过打磨与完善，他的真正价值会像太阳一样绽放。";
			mes "我认为他值得认可。";
		}
		else {
			mes "虽然不易察觉，但她拥有内在的精神之美。经过打磨，她的真正价值会像月亮一样";
			mes "熠熠生辉。";
		}
		next;
		mes "[Captain Herman]";
		mes "最后……";
		mes "格雷，我想";
		mes "听听你的看法。";
		next;
		mes "[Gray]";
		mes "一位下定决心成为骑士的年轻"+((Sex==SEX_MALE)?"绅士":"女士")+"来到这里，这就足够了……";
		next;
		mes "[Captain Herman]";
		mes "所有人";
		mes "都同意了。";
		mes "没人反对。";
		mes "那么我来告诉";
		mes "你我的意见。";
		next;
		mes "[Captain Herman]";
		mes "我的决定是……";
		next;
		mes "[Captain Herman]";
		mes "我同意。";
		next;
		mes "[Captain Herman]";
		mes "你也许没有完美完成所有测试，但你具备成为";
		mes "骑士所需的全部品质。";
		next;
		completequest 9012;
		callfunc "Job_Change",Job_Knight;
		callfunc "F_ClearJobVar"; // Clears all job variables for the current player
		mes "[Captain Herman]";
		mes "我现在宣布";
		mes "你成为";
		mes "普隆德拉骑士团的一员。";
		mes "保护弱者，";
		mes "以荣誉生活。";
		next;
		getitem 656,7; //Awakening_Potion
		mes "[Captain Herman]";
		mes "哦……";
		mes "我们准备了一份小礼物，祝贺你转职。保护他人、战斗时请使用它。";
		next;
		mes "[Captain Herman]";
		mes "出发吧！";
		mes "符文-米德加尔特的";
		mes "未来";
		mes "肩负在你的";
		mes "肩上！";
		close;
	}
L_Mission:
	mes "嗯？";
	mes "剑士" + strcharinfo(0) + "。";
	mes "测试进行得怎么样？";
	if (getarg(0)) {
		mes "啊~你不知道";
		mes "接下来该拜访谁吗？";
		next;
		mes "[Captain Herman]";
		return;
	} else {
		mes "可能很困难，";
		mes "但要尽力而为。";
		close;
	}
}
	
prt_in,75,107,4	script	Sir Andrew#knt	65,{
	mes "[Sir Andrew]";
	if (BaseJob != Job_Swordman) {
		if (BaseJob == Job_Knight) {
			mes "你一定是";
			mes "骑士团的成员。";
			mes "最近过得怎么样？";
			mes "还好吗？";
			next;
			mes "[Sir Andrew]";
			mes "你必须努力收集食物，并节省Zeny购买装备。战斗中找到的东西都要保存，";
			mes "即使是最小的杰勒比结晶。";
			next;
			mes "[Sir Andrew]";
			mes "但也不能";
			mes "太贪心。";
			mes "毕竟，我们是骑士。";
			close;
		}
		else if (BaseClass == Job_Novice) {
			mes "嘿，";
			mes "小小的初心者。";
			mes "欢迎来到";
			mes "普隆德拉骑士团。";
			next;
			mes "[Sir Andrew]";
			mes "你现在可能很弱，但有一天";
			mes "你会变得更强。";
			next;
			mes "[Sir Andrew]";
			mes "梦想拥有光明的未来，";
			
			mes "沿你选择的道路前进。";
			mes "愿你勇往直前。";

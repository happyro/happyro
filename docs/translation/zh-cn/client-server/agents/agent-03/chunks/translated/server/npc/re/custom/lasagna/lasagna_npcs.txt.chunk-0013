			next;
			mes "- Tomei Thomas -";
			mes "拉萨格纳人，因富裕的父母而生活优渥。";
			next;
			mes "- Tomei Thomas -";
			mes "与 Gamberry（现任 Con-Chliina 船长）一起长大，是儿时好友。";
			next;
			mes "- Tomei Thomas -";
			mes "作为兴趣，和 Gamberry、Peperoncino（现任蝴蝶治安队队长）一起在凤尾鱼工坊工作。";
			next;
			mes "- Tomei Thomas -";

			next;
			mes "- Tomei Thomas -";
			mes "决定向海上扩张后，Gamberry 和 Thomas 集结船队出航，但 Thomas 船长在暴风雨中失踪。";
			next;
			mes "- Tomei Thomas -";
			mes "后来他安全抵达新世界的柔软岛并定居，稳步扩大自己的领域。";
			close;
		case 4:
			mes "[" + strcharinfo(0) + "]";
			mes "没什么可看的。";
			close;
		}
	case 3:
		mes "^0000cd[Pub-Oven]^000000";
		mes "Thomas、Peperoncino 和 Gamberry 达成约定的地方。";
		next;

		next;
		mes "[" + strcharinfo(0) + "]";
		mes "那你为什么需要新的视角？";
		next;
		mes "[Recorder]";
		mes "如果无法找回，就应该重建。我试着采访 Gamberi 船长补全缺失的页面，但他没有回应。";
		next;
		mes "[Recorder]";
		mes "我派过很多其他人，但没有用。他不愿向 Con-Chliina 上的任何人谈起过去。所以我需要^0000cd新的视角^000000。";
		next;
		mes "[Recorder]";
		mes "他有时会在讲冒险故事时向陌生人或新人讲述^0000cd自己的故事以及拉萨格纳的发展历程^000000。";
		mes "这次我想派你去听听。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "你的意思是让我询问过去发生的事，但不能让他察觉是你让我来的。";
		next;
		mes "[Recorder]";
		mes "没错。必须保密。如果 Gamberi 船长发现了，你我都逃不了。";
		npctalk "一切都取决于你。", "", bc_self;
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "我明白了。";
		next;
		mes "[Recorder]";
		mes "那么，旅途平安。";
		setquest 14579;// Interview with Captain
		conch_in_recorder = 1;
		close;
	}
	if (conch_in_recorder == 1) {
		mes "[Recorder]";
		mes "你可以采访 Gamberi 船长，然后把故事告诉我。";
		close;
	}
	if (conch_in_recorder == 2) {
		mes "[Recorder]";
		mes "你来了。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "我听了 Gamberi 船长的故事，但非常困惑。";
		npctalk "请告诉我这个故事！", "", bc_self;
		next;
		mes "[When you told the story you heard from Captain Gamberi and about how Stello interrupted, the Recorder started writing it down.]";
		next;
		emotion ET_SCRATCH;
		mes "[Recorder]";
		mes "真奇怪。我记不起全部记录，但 Gamberi 船长讲的故事与我记得的记录部分^0000cd不同^000000。";
		npctalk "It wasn't supposed to be lengthy like this.", "", bc_self;
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "那么，大副的故事是真的吗？";
		next;
		mes "[Recorder]";
		mes "我不确定。我们需要和其他版本核对。既然存在差异，我不能只根据 Gamberi 船长的话记录。";
		next;
		mes "[Recorder]";
		mes "除了 Gamberi 船长，我们还有其他人可以听故事，真让人安心。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "还有谁？";
		next;
		mes "[Recorder]";
		mes "虽然这个人不是拉萨格纳人，但他和 Gamberi 船长相处过很长时间。你可以去找他。我们能把他的故事与采访对照。";
		npctalk "我早该这么做了。", "", bc_self;
		next;
		mes "[Recorder]";
		mes "抱歉又要拜托你。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "那是谁？";
		next;
		mes "[Recorder]";
		mes "我是说^0000cd治安队首领 Pepperoncino^000000。现在他应该正在新的冒险者俱乐部吃早饭。";
		npctalk "他可能在桌边。", "", bc_self;
		next;
		mes "[Recorder]";
		mes "前往<NAVI>^4D4DFF[冒险者俱乐部]^000000<INFO>lasagna,56,186,000,1,</INFO></NAVI>南门即可进入餐厅。";
		npctalk "你可以沿着这根红线走。红线总会带你走上正确的道路。", "", bc_self;
		erasequest 14580;// To Recorder
		setquest 14581;// Interview with the Chief
		conch_in_recorder = 3;
		close;
	}
	if (conch_in_recorder == 3) {
		mes "[Recorder]";
		mes "你可以采访 Pepperoncino，然后把故事告诉我。";
		next;
		mes "[Recorder]";
		mes "他现在应该正在新建的<NAVI>^4D4DFF[冒险者俱乐部]^000000<INFO>lasagna,56,186,000,1,</INFO></NAVI>吃早饭。前往南门即可进入餐厅。";
		close;
	}
	if (conch_in_recorder == 4) {
		mes "[Recorder]";
		mes "看来这次你听到了真实故事。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "Pepperoncino 的故事让我更困惑了。你自己听听吧。";
		next;
		mes "[When you told the story you heard from Pepperoncino and about how Olio interrupted, the Recorder started writing it down.]";
		next;
		mes "[Recorder]";
		mes "Pepperoncino 的故事也不太合理。我可以把他的故事和记录核对。";
		next;
		mes "[Recorder]";
		mes "让我看看。你听到的故事与 Pepperoncino 的记录不同。";
		next;
		mes "[Recorder]";
		mes "我们不能完全相信 Pepperoncino 讲的故事。我不能记录不可信的故事。";
		npctalk "真不敢相信我们的船长和领袖竟然如此自负！", "", bc_self;
		next;
		mes "[Recorder]";
		mes "但我不能让记录就这样丢失。我该怎么办……";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "去问 Navi 的 Thomas 船长怎么样？";
		npctalk "Thomas 船长？", "", bc_self;
		next;
		mes "[Recorder]";
		mes "如你所见，Gamberi 船长和 Pepperoncino 只讲他们想讲的故事。Thomas 船长的故事也不可信。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "问问拉萨格纳最年长的人怎么样？";
		next;
		mes "[Recorder]";
		mes "年轻时，人们只把拉萨格纳当作赚些钱的地方。大多数人最终都会离开……";
		next;
		mes "[Recorder]";
		mes "哦，你说得对。确实有^0000cd这么一个人^000000。";
		npctalk "拉萨格纳活生生的历史。", "", bc_self;
		next;
		mes "[Recorder]";
		mes "冒险者俱乐部现在所在的地方以前是^0000cdPub-Oven^000000，那里曾经出售卡露娜牛奶。你可以去见^0000cd店铺的第一任老板^000000。可是……";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "有什么问题？";
		next;
		mes "[Recorder]";
		mes "不过她现在神志不太清醒……也许因此能更鲜明地记得过去，就像活在过去一样。";
		next;
		mes "[Recorder]";
		mes "去见^0000cd曾经经营 Pub-Oven 的老妇人^000000。她住在^0000cd冒险者俱乐部附近的小屋^000000里。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "好。我很快回来。";
		erasequest 14582;// To Recorder
		setquest 14583;// To Granma
		conch_in_recorder = 5;
		close;
	}
	if (conch_in_recorder == 5) {
		mes "[Recorder]";
		mes "去见曾经经营 Pub-Oven 的老妇人。她应该就在附近的房子里。";
		close;
	}
	if (conch_in_recorder == 6) {
		mes "[Recorder]";
		mes "欢迎回来。谢谢你的努力。现在请汇报吧。";
		next;
		mes "[When you told the story about Captain Gamberi you heard from the old lady, the Recorder started writing it down.]";
		next;
		mes "[Recorder]";
		mes "干得好。这个故事与我记得的一些细节相符。他就是活生生的历史。我应该根据故事补全记录。";
		npctalk "拉萨格纳活生生的历史。", "", bc_self;
		next;
		mes "[Recorder]";
		mes "这份记录会比之前的更加详尽。";
		next;
		classchange( 4_DR_GAMBERI, "Captain Gamberi#dorcon0_2", bc_self );
		mes "[Recorder]";
		mes "尊敬的船长，你来这里做什么？";
		next;
		emotion ET_HUK, getnpcid(0, "Captain Gamberi#dorcon0");
		mes "[Captain Gamberi]";
		mes "你在这里啊。我只是确认航行前大家是否都在正确的位置。";
		npctalk "嗯！嗯！我还以为这里没人。", "Captain Gamberi#dorcon0_2", bc_self;
		next;
		mes "[Recorder]";
		mes "什么时候检查这些成了你的职责？还这么安静，连门都不敲？";
		next;
		mes "[Captain Gamberi]";
		mes "作为经验丰富的 Con-Chliina 船员，必须随时应对各种情况。";
		next;
		emotion ET_HUK, playerattached();
		mes "[Recorder]";
		mes "我明白了。^0000cd看来撕毁并烧掉文件也是船长的职责^000000。";
		npctalk "你真以为我不会发现吗？你已经留下了一长串证据。", "", bc_self;
		npctalk "I don't know what you are talking about.", "Captain Gamberi#dorcon0_2", bc_self;
		next;
		mes "[Captain Gamberi]";
		mes "哦，嗯。我该去确认水手长是否在正确位置。";
		npctalk "我本该去很多地方看看。", "Captain Gamberi#dorcon0_2", bc_self;
		next;
		classchange( HIDDEN_WARP_NPC, "Captain Gamberi#dorcon0_2", bc_self );
		mes "[Recorder]";
		mes "以后想都别想！";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "那么，船长一定是……？";
		next;
		mes "[Recorder]";
		mes "随着越来越多人乘船并查看记录，他一定因记录里不光彩的过去而感到羞耻。";
		npctalk "在拉萨格纳，这没什么好羞耻的。", "", bc_self;
		next;
		mes "[Recorder]";
		mes "我就知道他还会来。他一定听说我在整理记录，想回来再次销毁。我得更加小心，不能让它丢失。";
		npctalk "I'd better make multiple copies and hide them everywhere.", "", bc_self;
		next;
		mes "[Recorder]";
		mes "亲爱的冒险者，既然你完成了任务，这是给你的奖励。从现在起你可以自由查阅记录室的所有文件。那么，再见。";
		completequest 14584;// Back to Recorder
		getexp 700,700;
		conch_in_recorder = 7;
		close;
	}
	if (conch_in_recorder == 7) {
		mes "[Recorder]";
		mes "你可以自由查阅记录室的所有文件。";
		close;
	}
}

conch_in,101,31,3	script	Captain Gamberi#dorcon0_2	HIDDEN_WARP_NPC,{ end; }

conch_in,98,33,5	script	Con-Chliina Ship's Log#	HIDDEN_NPC,{
	if (conch_in_recorder < 7) {
		mes "[Recorder]";
		mes "请不要触碰书籍。";
		close;
	}
	mes "[" + strcharinfo(0) + "]";
	mes "我该先读哪一本？";
	next;
	switch( select( "航海日志", "主要人物", "术语表", "合上书本。" ) ) {
	case 1:
		switch( select( "7 年前", "6 年前", "5 年前", "4 年前", "3 年前", "合上书本。" ) ) {
		case 1:
			mes "X 月 X 日";
			mes "期待已久的第一次航行。卸下所有货物后，希望我们能满载而归……";
			next;
			mes "X 月 X 日";
			mes "无论去哪里生意都很好。我对 Peperoncino 船长和船员们的洞察力感到惊讶。";
			next;
			mes "X 月 X 日";
			mes "离开里乔利港三天后遇到暴风雨。虽然不是第一次领教大自然的无常，但清点损失时仍不免沮丧。";
			mes "重伤 1 人，轻伤 13 人，优质凤尾鱼 23 箱，卡露娜牛奶 7 罐，胡须梳 1 箱，精制布料 200 卷。";
			next;
			mes "X 月 X 日";
			mes "几天前才遇到暴风雨，怎么又来一次？！是谁在这个季节规划这条航线？第一次就算了。";
			next;
			mes "X 月 X 日";
			mes "一切平静无事。满月映照的海面上，飞鱼群跃过的景象壮观极了。";
			next;
			mes "X 月 X 日";
			mes "卸空全部货物再装载新物品返航真棒。我感到自豪，就像收割并播撒庄稼一样。";
			next;
			mes "X 月 X 日";
			mes "领到工资后在酒馆喝一杯卡露娜牛奶，是世上最甜蜜的事。";
			close;
		case 2:
			mes "X 月 X 日";
			mes "Gamberry 船长和 Thomas 船长很奇怪。他们试图让船头保持直线并以相同速度航行，就像让孩子们齐步走。";
			next;
			mes "X 月 X 日";
			mes "我们频繁遇到暴风雨，我开始考虑是否该改变航线。感谢神明，我们避开了里乔利港的暴风雨。";
			next;
			mes "X 月 X 日";
			mes "从里乔利港招来的副厨师真是太棒了。";
			next;
			mes "X 月 X 日";
			mes "离开里乔利港第二天遇到暴风雨，Butterfly 失踪了。我们悲痛万分，回到拉萨格纳时没人说得出话。";
			next;
			mes "X 月 X 日";
			mes "暂时不再出航。";
			next;
			mes "X 月 X 日";
			mes "感觉只要去港口，大家就会回来并露出笑容。";
			next;
			mes "X 月 X 日";
			mes "仍然没有消息。";
			close;
		case 3:
			mes "X 月 X 日";
			mes "第二次寻找 Butterfly，仍然一无所获。找不到任何残骸，所以他们一定平安无事。";
			next;
			mes "X 月 X 日";
			mes "Butterfly 仍然没有消息。";
			next;
			mes "X 月 X 日";
			mes "舵手钓到金枪鱼。厨师想把整条鱼蒸了，副厨师勉强阻止并切成小块分给大家。真希望还能再吃一些。";
			next;
			mes "X 月 X 日";
			mes "又吃金枪鱼。第一天是金枪鱼，第二天是金枪鱼意面，第三天是炸金枪鱼，第四天是炖金枪鱼……我受够了。我们是不是惹怒了副厨师？";
			next;
			mes "X 月 X 日";
			mes "水手长想把剩下的金枪鱼扔掉，被副厨师抓住了。我们都知道了他有多可怕。";
			next;
			mes "X 月 X 日";
			mes "我们遇到暴风雨。大家准备充分，所以损失不大。这就是经验吧。";
			next;
			mes "X 月 X 日";
			mes "水手长行为古怪。我们勉强阻止他半夜跳入海中。他浑身发抖，似乎失去理智，但第二天早上又恢复正常。他可能中了魔法。";
			next;
			mes "X 月 X 日";
			mes "仍在寻找。Butterfly 没有消息。";
			close;
		case 4:
			mes "X 月 X 日";
			mes "船上从没出现过老鼠，却突然泛滥成灾。调查后发现是水手长……你真是……";
			next;
			mes "X 月 X 日";
			mes "即使一年过去，我们也不能放弃寻找。我们正在仔细搜查他们失踪的区域。";
			next;
			mes "X 月 X 日";
			mes "不知道为什么，我有种不祥的预感。";
			next;
			mes "X 月 X 日";
			mes "暴风雨。我真受够了。我们已经习惯到几乎能驾驭它。";
			next;
			mes "X 月 X 日";
			mes "Stello 声称昨晚看到奇怪的东西，于是我们调转船头。这是从未走过的航线。大家意见不同，但既然已经找遍所有地方，我们决定试试看。";
			next;
			mes "X 月 X 日";
			mes "我做了一个奇怪的梦。";
			next;
			mes "X 月 X 日";
			mes "穿过突然出现的浓雾后，我们发现一座从未见过的岛屿。Butterfly 的船员在那里，像当地人一样自然。";
			next;
			mes "X 月 X 日";
			mes "被巨浪冲击后我们平稳登陆的地方叫柔软岛。这里居住着外貌各异的人，是神秘的新世界。";
			next;
			mes "X 月 X 日";
			mes "Butterfly 以柔软岛为基地，已经在新世界站稳脚跟并获利。他们天生就是商人。";
			next;
			mes "X 月 X 日";
			mes "我们正在返回拉萨格纳。Gamberry 船长和 Thomas 船长进行了长谈。";
			next;
			mes "X 月 X 日";
			mes "抵达拉萨格纳。喝了五杯卡露娜牛奶。";
			close;
		case 5:
			mes "3 年前：决定出航";
			mes "X 月 X 日";
			mes "我们带着物资前往新世界。我一直想近距离看看，这是绝佳机会。";
			next;
			mes "X 月 X 日";
			mes "又遇到暴风雨。";
			next;
			mes "X 月 X 日";
			mes "抵达柔软岛。我不知道我们如何在茫茫大海找到航路，但仍然令人惊叹。";
			next;
			mes "X 月 X 日";
			mes "Gamberry 船长和 Thomas 船长正式宣布新世界扩张计划。Con-Chliina 负责招募并派遣冒险者前往新世界，";
			mes "蝴蝶治安队负责训练他们。Butterfly 同意以柔软岛为基地支援冒险者。准备时间为三年。";
			next;
			mes "X 月 X 日";
			mes "我想到了可以在新世界与远星之间销售的物品。两地的喜好差异让我惊讶，听到世界树果实的价格更是吃惊。";
			next;
			mes "X 月 X 日";
			mes "从柔软岛出航。我们大概还会再来几次。";
			close;
		case 6:
			mes "[" + strcharinfo(0) + "]";
			mes "没什么可看的。";
			close;
		}
	case 2:
		switch( select( "Gamberry", "Peperoncino", "Tomei Thomas", "合上书本。" ) ) {
		case 1:
			mes "- Gamberry -";
			mes "Con-Chliina 船长。";
			mes "昵称是 Berry。";
			mes "卡露娜牛奶应该搅拌。";
			next;
			mes "- Gamberry -";
			mes "他的父母在拉萨格纳经营肉铺。";
			next;
			mes "- Gamberry -";
			mes "年轻时，他忍不住用暴力改造混混杜拉姆，因此被称为拉萨格纳的疯狗。";
			next;
			mes "- Gamberry -";
			mes "他在 Pub-Oven 因卡露娜牛奶的喝法与 Peperoncino（现任蝴蝶治安队队长）争论而相识。";
			next;
			mes "- Gamberry -";
			mes "由于当时欠下债务，他最终与 Peperoncino 一起在凤尾鱼工坊工作。Gamberry 凭技能得到认可，成为工坊经理。";
			next;
			mes "- Gamberry -";
			mes "后来 Thomas（现任 Butterfly 船长）加入，他们一起组织了商贸事业。";
			next;
			mes "- Gamberry -";
			mes "决定向海上扩张后，Gamberry 和 Thomas 集结船队出航，但 Thomas 船长在暴风雨中失踪。";
			next;
			mes "- Gamberry -";
			mes "Con-Chliina 大副 Stello 发现了海路，终于找到了安全抵达新世界柔软岛的 Butterfly。";
			next;
			mes "- Gamberry -";
			mes "目前在连接拉萨格纳与新世界的班轮上航行。";
			close;
		case 2:
			mes "- Peperoncino -";

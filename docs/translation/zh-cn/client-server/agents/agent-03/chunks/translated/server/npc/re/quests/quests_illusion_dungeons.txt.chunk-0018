			mes "你可以取消。但取消后目前进度会丢失。确定要取消吗？";
			next;
			if (select( "不取消", "取消" ) == 1)
				end;
			erasequest 5848;
			mes "委托已取消。";
			close;
		}
		end;
	case 2:

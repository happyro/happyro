//= Illusion of Underwater
//============================================================
// prt_in,157,66,4	script	Jerrymon#jerry	1_M_01,{
prt_elib,57,18,4	script	Jerrymon#jerry	1_M_01,{
	if (ill_underwater == 0) {
		mes "[Jerrymon]";
		mes "嗯……呃……";
		next;
		mes "[Jerrymon]";
		mes "哦，真意外！！";
		next;
		mes "[Jerrymon]";
		mes "怎么了？我现在很忙，之后再聊。";
		close;
	}
	if (ill_underwater == 1) {
		mes "[Jerrymon]";
		mes "嗯……呃……";
		next;
		mes "[Jerrymon]";
		mes "哦，真意外！！";
		next;
		mes "[Jerrymon]";
		mes "怎么了？我现在有点忙……";
		next;
		mes "[Jerrymon]";
		mes "啊，你就是拉凯特介绍的人。我一直在等你。";
		mes "能给我看看你的钓竿吗？";
		next;
		mes "- Jerrymon began to examine the rod closely. -";
		next;
		mes ".";
		next;
		mes "..";
		next;
		mes "...";
		next;
		mes "....";
		next;
		mes ".....";
		next;
		mes "[Jerrymon]";
		mes "是的，没错……这种物质就是……能这样再次发现它……";
		next;
		select( "你说的是什么材料？" );
		mes "[Jerrymon]";
		mes "冒险者，你知道海洋最深处在哪里吗？";
		next;
		select( "嗯……？？" );
		mes "[Jerrymon]";
		mes "那是名为^4d4dff海沟^000000的地方。简单来说，可以把它想成海中的深谷。";
		next;
		mes "[Jerrymon]";
		mes "据说世界海洋中有数百种不同的海沟。";
		next;
		mes "[Jerrymon]";
		mes "已知最宽最深的海沟是依斯鲁得附近的^4d4dff巴希亚海沟^000000。";
		next;
		mes "[Jerrymon]";
		mes "海沟底部有稀有生命形态，像我这样的海洋科学家对此很感兴趣，一直在探索。";
		next;
		mes "[Jerrymon]";
		mes "不过浅海沟在一定程度上可以探索。";
		next;
		mes "[Jerrymon]";
		mes "但巴希亚海沟深不可测，科学家计算认为那里不可能存在生命。";
		next;
		mes "[Jerrymon]";
		mes "我最近发现巴希亚海沟中存在生命。";
		next;
		select( "你怎么知道？？" );
		mes "[Jerrymon]";
		mes "可以通过含有我魔法的石头判断。";
		next;
		select( "拥有魔力的石头？" );
		mes "[Jerrymon]";
		mes "是的，我是由魔法师转行的海洋学家。为了海洋学，我学习了魔法。";
		next;
		mes "[Jerrymon]";
		mes "给巨石附魔，让它落到海沟所在的海底。";
		next;
		mes "[Jerrymon]";
		mes "落下石头上的魔法与我相连，通过测量距离，我能大致知道深度以及石头附近的情况。";
		next;
		mes "[Jerrymon]";
		mes "告诉你我的发现……";
		next;
		mes "[Jerrymon]";
		mes "普通海水和深海水的成分几乎相同。但巴希亚海沟的深海水有所不同。";
		next;
		mes "[Jerrymon]";
		mes "应该说就像水和油？有一段区域两者永远不会混合。";
		next;
		mes "[Jerrymon]";
		mes "它们相遇处形成了强烈边界，仿佛那里的深海水拼命阻挡着从上方流下的海水。";
		next;
		mes "[Jerrymon]";
		mes "水压也比普通海水低得多，因此推测那里是适合生命的环境。";
		next;
		mes "[Jerrymon]";
		mes "我们称之为^4d4dff深海水^000000。";
		next;
		select( "这个光泽和你说的有关吗？" );
		mes "[Jerrymon]";
		mes "是的！没错！！";
		mes "我们只确认巴希亚海沟深处存在深渊海水，采样非常困难。这根钓竿上有很多深渊海水……";
		next;
		mes "[Jerrymon]";
		mes "能把这根钓竿留给我吗？如果提取海水并制成精华，我想就能弄清楚一些事。";
		next;
		mes "[Jerrymon]";
		mes "对了，我听说这根钓竿今天才被发现。能请你检查附近海域是否还有其他漂浮物吗？";
		next;
		if (select( "Okay, I'll be back.", "I'm a bit busy right now..." ) == 2) {
			mes "[Jerrymon]";
			mes "完成后请回来找我！";
			close;
		}
		mes "[Jerrymon]";
		mes "好的，谢谢！我会等你！！";
		close2;
		if (countitem(25898) > 0)
			delitem 25898,1;	// Siroods_Fish_Rod
		ill_underwater = 2;
		erasequest 3407;
		end;
	}
	if (ill_underwater == 2) {
		mes "[Jerrymon]";
		mes "抱歉麻烦你，但拜托了。我会在这里等你。";
		close;
	}
	if (ill_underwater == 3) {
		if (countitem(25899) < 1) {
			mes "[Jerrymon]";
			mes "抱歉麻烦你，但拜托了。我会在这里等你。";
			close;
		}
		mes "[Jerrymon]";
		mes "啊，欢迎，冒险者！";
		next;
		mes "[Jerrymon]";
		mes "调查进行得很顺利~";
		mes "嘿，能看看这个吗？";
		next;
		mes "[Jerrymon]";
		mes "看到这里的两个小水瓶了吗？";
		next;
		mes "[Jerrymon]";
		mes "一边是普通海水，另一边是混入钓竿中深渊海水的海水。我来试着混合这两种。";
		next;
		mes " - Jerrymon poured both waters into one bottle and began to shake them together. - ";
		next;
		mes "[Jerrymon]";
		mes "现在看。正如我之前说的，它们完全不会混合，对吧？";
		next;
		mes "[Jerrymon]";
		mes "这……这是！！";
		next;
		mes "[Jerrymon]";
		mes "如果用力摇晃它！！";
		next;
		mes "[Jerrymon]";
		mes "<FONT COLOR = E68F8F><FONT SIZE = 16><B>Wow!!!!!!</FONT></FONT></B>";
		next;
		mes "[Jerrymon]";
		mes "<FONT COLOR = E68F8F><FONT SIZE = 16><B>Uwachachaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa!!!!!!</FONT></FONT></B>";
		next;
		mes "[Jerrymon]";
		mes "<FONT COLOR = E68F8F><FONT SIZE = 16><B>Ahhhhhhh!!!!!!</FONT></FONT></B>";
		next;
		mes "[Jerrymon]";
		mes "啊啊啊啊啊啊啊啊啊啊啊啊啊啊啊啊啊……";
		next;
		select( "哦，我要去抓人，可以吗？" );
		mes "[Jerrymon]";
		mes "继续……哇……哇……好了。";
		next;
		mes "- Looking into the bottle Jerrymon is holding, I can clearly see the shape of the vortex. - ";
		next;
		mes "[Jerrymon]";
		mes "现在看到了吗，这个漩涡！！这是通往巴希亚海沟底部的通道！";
		next;
		select( "??? Isn't that just a whirlpool created by shaking it?" );
		mes "[Jerrymon]";
		mes "不，这是蕴含我魔力的石头。让我们看看。";
		next;
		mes " - Jerrymon put a glowing stone into the bottle. The glowing stone was sucked into the whirlpool inside the bottle and disappeared without a trace! - ";
		next;
		select( "不，怎么可能？" );
		mes "[Jerrymon]";
		mes "我告诉过你，这块蕴含魔力的石头能测量到我的距离吗？";
		next;
		mes "[Jerrymon]";
		mes "感觉和上次把小石子扔进巴希亚海沟时一样……";
		mes "沿着这个漩涡走，也许能找到钓竿的主人。";
		next;
		mes "[Jerrymon]";
		mes "问题是……钓竿上的精华不足以形成能容纳人的漩涡。";
		next;
		select( "这个数量可以吗？" );
		mes "- Showed the ^4d4dff" + getitemname(25899) + "^000000 received from Gein to Jerrymon. - ";
		next;
		mes "[Jerrymon]";
		mes "哦，为了以防万一，我其实找到了它！";
		next;
		mes "[Jerrymon]";
		mes "有了这些，我应该能制造普通人可以进入的裂隙漩涡。请交给我。";
		next;
		mes "[Jerrymon]";
		mes "这里空间太小，无法完成这些，所以去依斯鲁得吧。也能得到你朋友的帮助。";
		mes "那就在依斯鲁得见！！";
		close2;
		delitem 25899,1;	// E_Abyss1
		ill_underwater = 4;
		erasequest 3408;
		setquest 3409;
		end;
	}
	if (ill_underwater == 4) {
		mes "[Jerrymon]";
		mes "那就在依斯鲁得见！！";
		close;
	}
	mes "[Jerrymon]";
	mes "抱歉麻烦你，但拜托了。我会在这里等你。";
	close;

OnInit:
	// note: no questinfo for 3407
	questinfo( QTYPE_QUEST2, QMARK_YELLOW, "isbegin_quest(3408) == 1" );
	end;
}


izlude,126,53,0	script	Sirood#SRD1	HIDDEN_WARP_NPC,4,4,{
	end;
OnTouch:
	if (ill_underwater > 3)
		cloakoffnpcself( "Jerrymon#jerry2" );
	if (ill_underwater > 6)
		cloakoffnpcself( "Sirood#SRD2" );
	end;
}
izlude,132,54,0	duplicate(Sirood#SRD1)	Jerrymon#jerry1	HIDDEN_WARP_NPC,4,4

izlude,126,53,4	script	Sirood#SRD2	1_M_04,{
	mes "[Sirood]";
	mes "非常感谢你，冒险者。";
	next;
	mes "[Sirood]";
	mes "我以为再也回不来了……";
	close;
}

izlude,129,49,4	script	Soup#Soup	1_M_02,{
	if (ill_underwater < 5) {
		mes "[Soup]";
		mes "你好，我叫苏普，是失踪的希鲁德的朋友。";
		next;
		mes "[Soup]";
		mes "我们四个——希鲁德、拉凯特、盖因和我——经常一起钓鱼。";
		next;
		mes "[Soup]";
		mes "那天风很大……我一直很内疚没能阻止希鲁德去钓鱼。";
		next;
		mes "[Soup]";
		mes "听说找到了希鲁德的钓竿，我立刻跑了出来。";
		next;
		mes "[Soup]";
		mes "你一定知道些什么线索吧？";
		close;
	}
	if (ill_underwater < 7) {
		mes "[Soup]";
		mes "我已经尽力了。";
		next;
		mes "[Soup]";
		mes "希望希鲁德能平安回来。";
		close;
	}
	mes "[Soup]";

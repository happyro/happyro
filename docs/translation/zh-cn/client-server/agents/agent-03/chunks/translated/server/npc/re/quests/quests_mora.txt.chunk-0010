		close;
	} else if (.@playtime == 2) {
		mes "[Hotcha]";
		mes "完成现有任务的时间到了。";
		next;
		mes "[Hotcha]";
		mes "如果任务日志中有未完成的任务，它们会被视为'失败'并从日志中移除。";
		next;
		mes "[Hotcha]";
		mes "移除后，去和Elephantine交谈，就能接到新任务。";
		for(set .@i,12225; .@i<=12229; set .@i,.@i+1) {
			if (checkquest(.@i) > -1)
				erasequest .@i;
		}
		erasequest 12230;
		close;
	}
	mes "[Hotcha]";
	mes "欢迎。";
	mes "我能帮你什么？";
	next;
	select("我完成了一项任务。");
	mes "哦。";
	mes "完成了吗？";
	mes "请稍等，我确认一下文件。";
	next;

	for(set .@i,12225; .@i<=12229; set .@i,.@i+1) {
		if (checkquest(.@i,HUNTING) == 2) {
			mes "[Hotcha]";
			mes "是的，我看到你完成了任务。已确认完成。";
			erasequest .@i;
			specialeffect2 EF_STEAL;
			if (BaseLevel > 99 && JobLevel < 50)
				getexp 0, (JobLevel * JobLevel * (110/100) * 50);	// note 110/100 is from the original file
			else if (BaseLevel < 100 && JobLevel < 70)
				getexp 0, (JobLevel * JobLevel * (110/100) * 10);
			getitem 6380,3; //Mora_Coin
			close;
		}
	}

	mes "[Hotcha]";
	mes "嗯……"+strcharinfo(0)+"。";
	mes "可能是文件记录错误，但根据文件，你没有相关任务。";
	close;
}

mora,119,103,4	script	Bow-wow#pa0829	513,{
	if (checkweight(1201,1) == 0) {
		mes "你携带的物品种类太多，无法这样做。丢掉一些后再试。";
		close;
	}
	if (MaxWeight - Weight < 1000) {
		mes "你携带的重量太多，无法这样做。减轻重量后再试。";
		close;
	}
	if (ep14_1_mistwoods < 10) {
		mes "[Bow-wow]";
		mes "我只把任务交给可靠的人。你……算了，没什么。";
		close;
	}
	if (BaseLevel < 97) {
		mes "[Bow-wow]";
		mes "你真的一窍不通。凭这么虚弱的身体能做什么？";
		close;
	}
	set .@playtime, checkquest(12241,PLAYTIME);
	if (.@playtime == 0 || .@playtime == 1) {
		mes "[Bow-wow]";
		mes "现在没有其他任务。如果有新任务，你回来时我会告诉你。";
		close;
	} else if (.@playtime == 2) {
		mes "[Bow-wow]";
		mes "请向^990099杂货商^000000";
		mes "确认上一项任务的详情。";
		close;
	}
	mes "[Bow-wow]";
	mes "欢迎。";
	mes "我这里有些任务，你要看看吗？";
	next;
	if(select("你有什么任务给我？:告诉我今天的任务。") == 1) {
		mes "[Bow-wow]";
		mes "我们在这里为冒险者制作各种补给品。";
		next;
		mes "[Bow-wow]";
		mes "我们每天接受一次补给品原材料。";
		next;
		mes "[Bow-wow]";
		mes "有时我们会要求很难取得的材料。那时可以向其他冒险者求助。";
		close;
	}
	mes "[Bow-wow]";
	mes "让我看看……今天要制作什么补给品……？";
	next;
	mes "[Bow-wow]";
	mes "这个怎么样？";
	next;
	switch(rand(1,5)) {
	case 1:
		setquest 12231;
		setquest 12241;
		mes "[Bow-wow]";
		mes "这里的冒险者探索地下城时，会带上保持食物新鲜的防腐剂。你知道防腐剂是用什么做的吗？";
		next;
		mes "[Bow-wow]";
		mes "*咧嘴笑*当然是……昆虫触角！那边的杂货商让我找四个。我自己无论如何都不会吃……";
		set .@n$,"防腐剂材料";
		break;
	case 2:
		setquest 12232;
		setquest 12241;
		mes "[Bow-wow]";
		mes "如今这里的冒险者常制作护身符，在危险冒险中保护自己，就像一种保险。";
		next;
		mes "[Bow-wow]";
		mes "最近不朽心脏似乎很流行。杂货商让我找五个。";
		set .@n$,"抵抗的象征";
		break;
	case 3:
		setquest 12233;
		setquest 12241;
		mes "[Bow-wow]";
		mes "他们需要大量腐烂绷带来制作急救绷带。新的材料一定用完了。";
		next;
		mes "[Bow-wow]";
		mes "委托人就是那边的杂货商。三捆就够了。";
		set .@n$,"急救包材料";
		break;
	case 4:
		setquest 12234;
		setquest 12241;
		mes "[Bow-wow]";
		mes "强大战士的象征能为冒险者的旅途提供巨大支持。所以兽人通行证卖得很火。";
		next;
		mes "[Bow-wow]";
		mes "杂货商让我找三张兽人通行证，用来制作勇气的象征。";
		set .@n$,"勇气的象征";
		break;
	case 5:
		setquest 12235;
		setquest 12241;
		mes "[Bow-wow]";
		mes "冒险者之间似乎流传着一个说法：喝下混水的骨粉能增强体力。";
		next;
		mes "[Bow-wow]";
		mes "杂货商让我找三根骷髅骨，用来制作补剂。";
		set .@n$,"增强体力……";
		break;
	}
	next;
	mes "你接到了任务^880088"+.@n$+"^000000。打开任务窗口查看详情。";
	close;
}

mora,119,118,4	script	General Goods Dealer#pa0	516,{
	if (checkweight(1201,1) == 0) {
		mes "你携带的物品种类太多，无法这样做。丢掉一些后再试。";
		close;
	}
	if (MaxWeight - Weight < 1000) {
		mes "你携带的重量太多，无法这样做。减轻重量后再试。";
		close;
	}
	if (ep14_1_mistwoods < 10) {
		mes "[General Goods Dealer]";
		mes "嗯，你看起来还不够可靠，无法接Bow-wow的任务。";
		close;
	}
	if (BaseLevel < 97) {
		mes "[General Goods Dealer]";
		mes "凭那副脆弱的身体能做什么？去锻炼一下吧。";
		close;
	}
	set .@playtime, checkquest(12241,PLAYTIME);
	if (.@playtime == -1) {
		mes "[General Goods Dealer]";
		mes "看来你还没有接到";
		mes "任何任务。";
		mes "去和Bow-wow谈谈，";
		mes "Bow-wow会给你";
		mes "无数任务中的一个。";
		close;
	} else if (.@playtime == 2) {
		mes "[General Goods Dealer]";
		mes "完成现有任务的时间到了。";
		next;
		mes "[General Goods Dealer]";
		mes "如果任务日志中有未完成的任务，它们会被视为'失败'并从日志中移除。";
		next;
		mes "[General Goods Dealer]";
		mes "移除后，去和Bow-wow交谈，就能接到新任务。";
		for(set .@i,12231; .@i<=12235; set .@i,.@i+1) {
			if (checkquest(.@i) > -1)
				erasequest .@i;
		}
		erasequest 12241;
		close;
	}
	mes "[General Goods Dealer]";
	mes "欢迎。";
	mes "我能帮你什么？";
	next;
	select("我完成了一项任务。");
	mes "[General Goods Dealer]";
	mes "哦。";
	mes "完成了吗？";
	mes "请稍等，我确认一下文件。";
	next;

	callsub L_CheckQuest,12231,928,4; //Insect_Feeler
	callsub L_CheckQuest,12232,929,5; //Immortal_Heart
	callsub L_CheckQuest,12233,930,1; //Rotten_Bandage
	callsub L_CheckQuest,12234,931,3; //Orcish_Voucher
	callsub L_CheckQuest,12235,932,3; //Skel_Bone

	mes "[General Goods Dealer]";
	mes "嗯……"+strcharinfo(0)+"。";
	mes "可能是文件记录错误，但根据文件，你没有相关任务。";
	close;

L_CheckQuest:
	if (checkquest(getarg(0)) > -1) {
		if (countitem(getarg(1)) < getarg(2)) {
			mes "[General Goods Dealer]";
			mes "数量不够……";
			close;
		}
		mes "[General Goods Dealer]";
		mes "物品已顺利收到。在我有下一项任务前还要一段时间，不如去温泉放松一下？";
		delitem getarg(1),getarg(2);
		erasequest getarg(0);
		specialeffect2 EF_STEAL;
		if (BaseLevel > 99)
			getexp 0, ((JobLevel < 50)?JobLevel * JobLevel * (110/100) * 50:0);
		else
			getexp 0, ((JobLevel < 70)?JobLevel * JobLevel * (110/100) * 10:0);
		getitem 6380,1; //Mora_Coin
		close;
	}
	return;
}


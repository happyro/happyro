mora,170,101,4	script	Soul Guide#pa0829	515,{
	if (checkweight(1201,1) == 0) {
		mes "你携带的物品种类太多，无法这样做。丢掉一些后再试。";
		close;
	}
	if (MaxWeight - Weight < 1000) {
		mes "你携带的重量太多，无法这样做。减轻重量后再试。";
		close;
	}
	if (ep14_1_mistwoods < 10) {
		mes "[Soul Guide]";
		mes "寻找失落灵魂最需要可靠性。你看起来不太可靠。";
		close;
	}
	if (BaseLevel < 97) {
		mes "[Soul Guide]";
		mes "完成这项任务需要坚强的精神。我认为你还需要更多磨炼。";
		close;
	}
	set .@playtime, checkquest(12253,PLAYTIME);
	if (.@playtime == 0 || .@playtime == 1) {
		mes "你身上还留着被灵魂缠绕的痕迹。";
		next;
		mes "等痕迹消失后再回来。";
		close;
	} else if (.@playtime == 2) {
		mes "你感觉心情再次平静下来。现在你有足够能量寻找其他灵魂，再去和引导者谈谈吧。";
		for(set .@i,12243; .@i<=12252; set .@i,.@i+1) {
			if (checkquest(.@i) > -1)
				erasequest .@i;
		}
		erasequest 12253;
		close;
	}
	mes "[Soul Guide]";
	mes "欢迎。";
	mes "准备好了吗？";
	next;
	if(select("你有什么任务给我？:告诉我今天的任务。") == 1) {
		mes "[Soul Guide]";
		mes "我的工作是收集纠缠森林的灵魂残留，让它们安息。";
		next;
		mes "[Soul Guide]";
		mes "迷宫中困着无数灵魂。";
		next;
		mes "[Soul Guide]";
		mes "帮助它们获得期待已久的安息。";
		close;
	}
	mes "[Soul Guide]";
	mes "我来告诉你一个失落灵魂的详情。";
	next;
	switch(rand(1,10)) {
	case 1:
		setquest 12243;
		setquest 12253;
		mes "^66006632岁，来自Midgard。为了采集当地植物前往Hazy Forest迷宫后失踪，已经3个月了。生还希望渺茫。^000000";
		set .@n$,"Tazar";
		break;
	case 2:

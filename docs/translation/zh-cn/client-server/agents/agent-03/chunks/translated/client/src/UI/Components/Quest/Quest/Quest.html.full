<div id="Quest">
	<div class="titlebar">
		<div class="quest-top-panel"><span class="quest-top-panel-text">任务信息</span></div>
		<div class="quest-left-panel">
			<ul class="quest-menu">
				<li id="active" class="quest-menu-item">进行中</li>
				<li id="feature" class="quest-menu-item">推荐</li>
				<li id="inactive" class="quest-menu-item">搁置</li>
				<li id="cooldown" class="quest-menu-item">等待中</li>
			</ul>
		</div>
		<div class="quest-right-panel">
			<ul id="active-quest-list" class="quest-list"></ul>
			<ul id="feature-quest-list" class="quest-list"></ul>
			<ul id="inactive-quest-list" class="quest-list"></ul>
			<ul id="cooldown-quest-list" class="quest-list"></ul>
		</div>
		<div class="quest-bottom-panel">
			<div class="toggle-quest-list"><button class="toggle-quest-image"></button></div>
			<div class="toggle-quest-text"><span>显示任务</span></div>
			<div class="close-quest-container">
				<ui-button class="close-quest-container-btn" bg="basic_interface/btn_close.bmp">关闭</ui-button>
			</div>
		</div>
	</div>
</div>

//----------------------------------------------------------------------------
// Worried Mother (Lusalka's Hair)
//----------------------------------------------------------------------------
moscovia,166,145,1	script	Worried Mother#rus19	4_F_RUSWOMAN3,{
	if (rhea_rus_main < 8) {
		mes "[Worried Mother]";
		mes "她在哪里……";
		next;
		mes "[Worried Mother]";
		mes "你听说过那个婚礼前溺水身亡、变成水妖 Lusalka 的新娘吗？";
		next;
		mes "[Worried Mother]";
		mes "我的女儿几天前失踪了，我非常担心。希望她没出事……";
		close;
	} else if (rhea_rus_main == 8) {
		if (rhea_rus_hair < 1) {
			if (getequipid(EQI_SHOES) != 2429 && getequipid(EQI_SHOES) != 2430) {
				mes "["+ strcharinfo(0) +"]";
				mes "...Hmm, did I forget to wear something...?";
				close;
			}
			mes "[Worried Mother]";
			mes "她在哪里……";
			next;
			mes "[Worried Mother]";
			mes "你听说过那个婚礼前溺水身亡、变成水妖 Lusalka 的新娘吗？";
			next;
			mes "[Worried Mother]";
			mes "我的女儿几天前失踪了，我非常担心。希望她没出事……";
			next;
			mes "[Worried Mother]";
		mes "你去过莫斯科比亚原野的沼泽吗？见到我的女儿了吗？即使她变成 Lusalka 我也不在乎。我只想知道她在哪里。";
			next;
			if(select("安慰她。:我会找到她。") == 1) {
				mes "["+ strcharinfo(0) +"]";
				mes "她应该没事。她很快就会回来的。";
				next;
				mes "[Worried Mother]";
				mes "真的吗？我真的希望如此。";
				close;
			}
			mes "[Worried Mother]";
			mes "啊，你愿意吗？";
			next;
			mes "[Worried Mother]";
			mes "我试着找她，但魔物太多，无法靠近沼泽。";
			next;
			mes "[Worried Mother]";
			mes "求求你，找到我的女儿。";
			rhea_rus_hair = 1;
			// setquest 8148;
			close;
		} else if (rhea_rus_hair == 1) {
			mes "[Worried Mother]";
			mes "啊，有些事情你必须知道。";
			next;
			mes "[Worried Mother]";
			mes "如果我的女儿变成了水妖 Lusalka，你需要听听我知道的事情。";
			next;
			mes "[Worried Mother]";
			mes "Lusalka 是善良的水妖，但并非完全无害。与她对视的人会受到严重伤害。";
			next;
			mes "[Worried Mother]";
			mes "你必须准备保护自己的东西。‘^0000ff圣水^000000’能保护你免受 Lusalka 的凝视。";
			next;
			mes "[Worried Mother]";
			mes "Lusalka 是夜行的。你应该在 ^ff00005 pm 到 6 am（PST）^000000 之间找到她。";
			next;
			mes "[Worried Mother]";
			mes "别忘了，带上‘^0000ff圣水^000000’，并在 ^ff00005 pm 到 6 am（PST）^000000 之间寻找她。";
			next;
			mes "[Worried Mother]";
			mes "我不知道她会在哪里，但一定在水边。请找到我的女儿，求你了。";
			rhea_rus_hair = 2;
			// changequest 8148,8149;
			close;
		} else if (rhea_rus_hair > 1 && rhea_rus_hair < 9) {
			mes "[Worried Mother]";
			mes "Lusalka 是善良的水妖，但并非完全无害。与她对视的人会受到严重伤害。";
			next;
			mes "[Worried Mother]";
			mes "你必须准备保护自己的东西。‘^0000ff圣水^000000’能保护你免受 Lusalka 的凝视。";
			next;
			mes "[Worried Mother]";
			mes "Lusalka 是夜行的。你应该在 ^ff00005 pm 到 6 am（PST）^000000 之间找到她。";
			next;
			mes "[Worried Mother]";
			mes "别忘了，带上‘^0000ff圣水^000000’，并在 ^ff00005 pm 到 6 am（PST）^000000 之间寻找她。";
			next;
			mes "[Worried Mother]";
			mes "我不知道她会在哪里，但一定在水边。请找到我的女儿，求你了。";
			close;
		}
	}
	mes "[Worried Mother]";
	mes "我最近什么也做不了。";
	next;
	mes "[Worried Mother]";
	mes "我似乎丢了什么，但不知道是什么……";
	close;
}


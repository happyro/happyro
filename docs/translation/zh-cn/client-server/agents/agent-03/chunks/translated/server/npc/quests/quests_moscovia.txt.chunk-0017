					else if (BaseLevel < 61) getexp 615,0;
					else if (BaseLevel < 66) getexp 750,0;
					else if (BaseLevel < 71) getexp 1000,0;
					else if (BaseLevel < 76) getexp 1500,0;
					else if (BaseLevel < 81) getexp 2000,0;
					else if (BaseLevel < 86) getexp 4500,0;
					else if (BaseLevel < 91) getexp 8500,0;
					else if (BaseLevel < MAX_LEVEL) getexp 30000,0;
					else {
						getitem 607,1; //Yggdrasilberry
						getexp 30000,0;
					}
				} else {
					if (BaseLevel < 56) getexp 4700,0;
					else if (BaseLevel < 61) getexp 6150,0;
					else if (BaseLevel < 66) getexp 10605,0;
					else if (BaseLevel < 71) getexp 16223,0;
					else if (BaseLevel < 76) getexp 41227,0;
					else if (BaseLevel < 81) getexp 69073,0;
					else if (BaseLevel < 86) getexp 85102,0;
					else if (BaseLevel < 91) getexp 104615,0;
					else if (BaseLevel < 99) getexp 222035,0;
					else getitem 607,1; //Yggdrasilberry
				}
				close;
			}
			mes "["+ strcharinfo(0) +"]";
			mes "……！？长笛在哪里！？";
			emotion ET_HUK, playerattached();
			close;
		} else if (rhea_rus_ring == 8) {
			mes "[Ryubaba]";
			mes "你把它还给我了！";
			next;
			mes "["+ strcharinfo(0) +"]";
			mes "我必须让你父亲知道真相！他必须知道你做了什么！";
			next;
			mes "[Ryubaba]";
			mes "等、等等！！！";
			close2;
			warp "moscovia",203,80;
			end;
		}
		mes "[Ryubaba]";
		mes "................................";
		mes "我真蠢……";
		next;
		mes "[Ryubaba]";
		mes "我必须为罪孽忏悔，用余生赎罪。";
		close;
	}
	mes "[Ryubaba]";
	mes "................................";
	mes "我真蠢……";
	next;
	mes "[Ryubaba]";
	mes "我必须为罪孽忏悔，用余生赎罪。";
	close;
}

//----------------------------------------------------------------------------
// Little Boy (Ryubaba Info)
//----------------------------------------------------------------------------
moscovia,223,210,3	script	Little Boy#rus09	4_M_RUSCHILD,{
	if (rhea_rus_main < 8) {
		mes "[Little Boy]";
		mes "我要成为冒险者，娶最美丽的新娘！娶一个比 Ryubaba 姐姐还漂亮的新娘！";
		close;
	} else if (rhea_rus_main == 8) {
		if (rhea_rus_ring == 2) {
			mes "[Little Boy]";
		mes "嘿嘿，你见过她吗？";
			next;
			mes "[Little Boy]";
		mes "大家都认识她。她很漂亮。哥哥告诉我他想娶她，但她的脾气让人犹豫。";
			next;
			mes "[Little Boy]";
		mes "我不喜欢她，因为她不给我糖果或饼干。虽然她很漂亮，但脾气太坏了……";
			next;
			if (countitem(529) || countitem(538)) {// Candy, Well_Baked_Cookie
				mes "[Little Boy]";
				mes "啊，你有糖果或饼干吗？";
				next;
				if(select("给一些:不给") == 2) {
					mes "[Little Boy]";
					mes "哼！哼！呸！！你和 Ryubaba 姐姐一样！";
					close;
				}
				mes "[Little Boy]";
				mes "哇，真的吗？你真好！";
				next;
				mes "[Little Boy]";
				mes "啊，我告诉你一件事！";
				next;
				mes "[Little Boy]";
				if (countitem(529))
					delitem 529,1;
				else if (countitem(538))
					delitem 538,1;
				else {
					mes "Ryubaba 姐姐喜欢……嗯？你没有糖果或饼干吗？不想给我吗？";
					close;
				}
				mes "Ryubaba 姐姐喜欢礼物！尤其是玫瑰之类的花。她觉得花朵很像自己。";
				rhea_rus_ring = 3;
				close;
			}
			mes "[Little Boy]";
		mes "我最喜欢糖果和饼干。";
			close;
		} else if (rhea_rus_ring == 3) {
			mes "[Little Boy]";
	mes "Ryubaba 姐姐喜欢礼物！尤其是玫瑰之类的花。她觉得花朵很像自己。";
			close;
		}
	}
	mes "[Little Boy]";
	mes "我要成为冒险者，娶最美丽的新娘！娶一个比 Ryubaba 姐姐还漂亮的新娘！";
	close;
}

//----------------------------------------------------------------------------

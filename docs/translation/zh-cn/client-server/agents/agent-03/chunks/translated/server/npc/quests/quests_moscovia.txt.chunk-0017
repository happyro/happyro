//----------------------------------------------------------------------------
mosk_fild02,157,233,0	script	Shepherdess#rus10	1_F_04,{
	if (rhea_rus_main < 8) {
		mes "[Shepherdess]";
		mes "哈啊，真无聊！放羊太无聊了！";
		next;
		mes "[Shepherdess]";
		mes "真希望能一直听音乐。";
		close;
	} else if (rhea_rus_main == 8) {
		if (rhea_rus_ring < 5) {
			mes "[Shepherdess]";
			mes "哈啊，真无聊！放羊太无聊了！";
			next;
			mes "[Shepherdess]";
			mes "真希望能一直听音乐。";
			close;
		} else if (rhea_rus_ring == 5) {
			if (getequipid(EQI_SHOES) != 2429 && getequipid(EQI_SHOES) != 2430) {
				mes "["+ strcharinfo(0) +"]";
				mes "...Hmm, did I forget to wear something...?";
				close;
			}
			mes "[Shepherdess]";
			mes "哈啊，真无聊！放羊太无聊了！";
			next;
			mes "[Shepherdess]";
			mes "真希望能一直听音乐。";
			next;
			select("打扰一下……");
			mes "["+ strcharinfo(0) +"]";
			mes "打扰一下……你见过一个叫 Mashenka 的女孩吗？最后有人看见她朝沼泽走去。";
			next;
			mes "[Shepherdess]";
			mes "嗯，我似乎听说过她，但不记得了……你应该自己在沼泽附近找找。";
			next;
			mes "[Shepherdess]";
			mes "啊，对了！搜索时能帮我收集一些尖锐树枝吗？请给我 ^0000ff25 根尖锐树枝^000000？";
			next;
			mes "[Shepherdess]";
			mes "我是优秀的长笛演奏家！如果你给我足够的尖锐树枝，我会做成长笛，为你演奏美妙音乐。拜托~！";
			rhea_rus_ring = 6;
			// changequest 8144,8145;
			close;
		} else if (rhea_rus_ring == 6) {
			if (countitem(7882) > 24) {// Pointed_Branch
				if (getequipid(EQI_SHOES) != 2429 && getequipid(EQI_SHOES) != 2430) {
					mes "["+ strcharinfo(0) +"]";
					mes "...Hmm, did I forget to wear something...?";
					close;
				}
				mes "[Shepherdess]";
				mes "哇，你拿到尖锐树枝了！？";
				next;
				mes "[Shepherdess]";
				mes "好！我会做成长笛，为你演奏听过的最美妙音乐！";
				next;
				mes "- 她开始切削尖锐树枝 -";
				mes "- 最后制作出一支漂亮的长笛！-";
				next;
				mes "[Shepherdess]";
				mes "好，太好了！让我演奏一下测试音色！";
				next;
				mes "- 她闭上眼睛 -";
				mes "- 吹奏长笛 -";
				next;
				mes "^ff0000父亲送我的红戒指^000000";
				mes "^ff0000红戒指施加魔法^000000";
				mes "^ff0000献给最可爱的女儿^000000";
				next;
				mes "^ff0000引发嫉妒的红戒指^000000";
				mes "^ff0000红戒指施加魔法^000000";
				mes "^ff0000我的妹妹心生嫉妒^000000";
				next;
				mes "^ff0000冰冷的手掐紧我的脖子^000000";
				mes "^ff0000冰冷的眼睛揪紧我的心^000000";
				mes "^ff0000冰冷的沼泽吞噬我的身体^000000";
				mes "^ff0000红戒指被夺走^000000";
				mes "^ff0000红戒指施加魔法^000000";
				emotion ET_HUK;
				emotion ET_HUK, playerattached();
				next;
				mes "[Shepherdess]";
				mes "这、这是什么？太可怕了！为什么长笛会发出声音？";
				next;
				mes "[Shepherdess]";
				mes "我从没见过这种事！感觉不对！你！把它拿走！";
				next;
				mes "- ^0000ff牧羊少女把^000000 -";
				mes "- ^0000ff‘尖锐木笛’交给我！！^000000 -";
				delitem 7882,25;
				rhea_rus_ring = 7;
				getitem 7883,1;// Pointed_Wooden_Flute
				// changequest 8145,8146;
				close;
			}
			mes "[Shepherdess]";
			mes "嗯，我似乎听说过她，但不记得了……你应该自己在沼泽附近找找。";
			next;
			mes "[Shepherdess]";
			mes "啊，对了！搜索时能帮我收集一些尖锐树枝吗？请给我 ^0000ff50 根尖锐树枝^000000？";
			next;
			mes "[Shepherdess]";
			mes "我是优秀的长笛演奏家！如果你给我足够的尖锐树枝，我会做成长笛，为你演奏美妙音乐。拜托~！";
			close;
		} else if (rhea_rus_ring > 6) {
			mes "[Shepherdess]";
			mes "我再也不会演奏用沼泽尖锐树枝做的长笛了！";
			close;
		}
	}
	mes "[Shepherdess]";
	mes "哈啊，真无聊！放羊太无聊了！";
	next;
	mes "[Shepherdess]";
	mes "真希望能一直听音乐。";
	close;
}


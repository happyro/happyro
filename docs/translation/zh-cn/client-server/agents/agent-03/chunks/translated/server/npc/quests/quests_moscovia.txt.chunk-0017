//----------------------------------------------------------------------------
// Lusalka Trigger (Lusalka's Hair)
//----------------------------------------------------------------------------
mosk_fild02,116,202,3	script	Lusalka#07russai_22	-1,3,3,{
	end;
OnTouch_:
	if (rhea_rus_main != 8 || rhea_rus_hair < 2) {
		emotion ET_QUESTION, playerattached();
		end;
	}
	if (rhea_rus_hair == 2) {
		if (gettime(DT_HOUR) >= 17 || gettime(DT_HOUR) <= 6) {
			mes "- Splash !! -";
			next;
			if (countitem(523) > 0) {// Holy_Water
				mes "- 你听见泼水声 -";
				mes "- 看见有什么东西在闪光 -";
				donpcevent "Lusalka#rus23::OnEnable";
				close;
			}
			mes "- 你听见泼水声，-";
			mes "- 某个闪光的东西 -";
			mes "- 似乎正盯着你！！-";
			next;
			specialeffect2 EF_FLASHER;
			percentheal -60,0;
			close;
		}
	} else if (rhea_rus_hair > 2 && rhea_rus_hair < 7) {
		mes "[Lusalka's Voice]";
		mes "他的名字是 Igor……他去了卢恩-米德加尔特首都。把我的金耳环交给他。";
		next;
		mes "[Lusalka's Voice]";
		mes "请告诉他别再受苦，要幸福。这是我的请求。";
		close;
	} else if (rhea_rus_hair == 7) {
		if (gettime(DT_HOUR) >= 17 || gettime(DT_HOUR) <= 6) {
			mes "- Splash !! -";
			next;
			if (countitem(523) > 0) {
			mes "-你听见泼水声，看见有什么东西在闪光-";
				donpcevent "Lusalka#rus23::OnEnable";
				close;
			}
			mes "-你似乎听见泼水声，但某个闪光的东西向你袭来！！-";
			specialeffect2 EF_FLASHER;
			percentheal -60,0;
			close;
		}
	} else if (rhea_rus_hair == 8) {
		mes "["+ strcharinfo(0) +"]";
		mes "那是什么？！我为什么在这里？";
		next;
		mes "- 站起来后，你看到 -";
		mes "- 湿漉漉的头发就在面前 -";
		next;
		mes "["+ strcharinfo(0) +"]";
		mes "……这是 Lusalka 的头发？";
		mes "啊，对了……我是来取她头发的。";
		next;
		mes "- 你捡起头发 -";
		next;
		mes "- 你一碰到那冰冷潮湿的头发，-";
		mes "- 就感受到了其中的悲伤 -";
		mes "";
		rhea_rus_hair = 9;
		getitem 7878,2;
		// // completequest 8150;
		// completequest 8153;
		close;
	} else if (rhea_rus_hair > 8) {
		mes "- 你感觉有人 -";
		mes "- 正在注视你 -";
		next;
		mes "["+ strcharinfo(0) +"]";
		mes "谁在那里？有人吗？";
		next;
		mes "- 泼水声 -";
		mes "- 渐渐消失，但你 -";
		mes "- 仍能感到悲伤 -";
		close;
	}
}

//----------------------------------------------------------------------------
// Lusalka (Lusalka's Hair)
//----------------------------------------------------------------------------
mosk_fild02,124,202,3	script	Lusalka#rus23	4_F_RUSGREEN,{
	if (countitem(523)) {// Holy_Water
		if (rhea_rus_main < 8) {

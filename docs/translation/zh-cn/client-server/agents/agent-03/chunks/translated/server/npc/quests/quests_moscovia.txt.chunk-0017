-	script	PTree#rusmain	-1,{
	if (rhea_rus_ring == 6) {
		if (countitem(7882) < 50) {// Pointed_Branch
			if (rand(1,3) == 2) {
				mes "- 我避开荆棘，-";
				mes "- cut off a branch!! -";
				getitem 7882,1;
				donpcevent strnpcinfo(0) +"::OnDisable";
				close;
			}
			mes "- 我的手被荆棘刺伤了！-";
			specialeffect2 EF_HIT2;
			percentheal -5,0;
			close;
		}
	}
	end;

OnDisable:
	initnpctimer;
	disablenpc();
	end;

OnTimer60000:
OnEnable:
	stopnpctimer;
	enablenpc();
	end;
}

// Exchange npc
1@jtb,375,28,5	script	Mingmin#05	4_F_GENETIC,{
	disable_items;
	if (!checkweight(18122,1) || (MaxWeight - Weight) < 1000) {// custom - officially no check of the weight
		mes "- Wait a minute !! -";
		mes "- Currently you're carrying -";
		mes "- too many items with you. -";
		mes "- Please try again -";
		mes "- after you lose some weight. -";
		close;
	}
	cutin "min02",0;
	mes "[Mingmin]";
	mes "我从莎洛希那里偷了几根头发，想着将来可能有用。想分析一下，虽然已经知道结果了。";
	next;
	switch( select( "Strange Pendant", "Jitterbug Tooth", "Quit." ) ) {
	case 1:
		mes "[Mingmin]";
		mes "你见过这个吊坠吗？";
		next;
		mes "[Mingmin]";
		mes "我觉得可以把和谐吊坠和混沌吊坠组合起来。";
		next;
		mes "[Mingmin]";
		mes "如果成功，结果会非常惊人！";
		next;
		mes "[Mingmin]";
		mes "攻击力 +6%。魔法攻击力 +6%。全属性 +1。";
		mes "敌人的魔法攻击会自动施放 1 级漩涡。";
		mes "防御：0 重量：10 要求等级：130";
		mes "插槽：1";
		next;
		mes "[Mingmin]";
		mes "如果我描述的组合结果让你觉得似曾相识，我也不知道原因。但我想象中的结果就是这样。找到两个吊坠后带给我，好吗？";
		next;
		if ((countitem(2990) - isequippedcnt(2990)) > 0 && (countitem(2991) - isequippedcnt(2991)) > 0) {
			mes "[Mingmin]";
			mes "哦，你有漂亮的吊坠。要把它们组合起来吗？我保证不会失败。";
			next;
			if (select( "Quit.", "Combine." ) == 2) {
				mes "[Mingmin]";
				mes "组合过程很简单。把和谐吊坠放在地上，再把混沌吊坠扔过去……就像这样！";
				next;
				specialeffect EF_PHARMACY_FAIL;
				mes "[Mingmin]";
				mes "哦，失败了吗？";
				next;
				mes "[Mingmin]";
				mes "*Chuckle* I was messing with you--it worked!";
				delitem	2990,1;// Pendant_Of_Harmony
				delitem	2991,1;// Pendant_Of_Chaos
				getitem 2992,1;// Pendant_Of_Maelstorm
				next;
				mes "[Mingmin]";
				mes "啊，组合物品真有趣。";
				next;
			}
		}
		break;
	case 2:
		mes "[Mingmin]";
		mes "你有梦魇跳虫的牙齿吗？";
		next;
		mes "[Mingmin]";
		mes "现在还不能告诉你，但它们对我有用。带给我，我会把纽沃兹囤积的战利品分给你。";
		next;
		mes "[Mingmin]";
		mes "具体是什么？巨大弓、风暴弓，以及^FF0000在这个空间找到的其他珍贵物品。^000000想要的话，至少带来 50 颗梦魇跳虫牙齿。";
		next;
		mes "[Mingmin]";
		mes "我会用 50 颗梦魇跳虫牙齿交换^FF0000一件随机物品。^000000";
		next;
		if (select( "Quit.", "Exchange 50." ) == 2) {
			if (countitem(6719) < 50) {// Tooth_Of_Jitterbug
				mes "[Mingmin]";
				mes "少于 50 颗梦魇跳虫牙齿我不会接受。";
			}
			else {
				mes "[Mingmin]";
				mes "好吧！让我想想要给你什么……";
				next;
				delitem 6719,50;// Tooth_Of_Jitterbug

// Room 5 (Exit)
1@jtb,379,31,4	script	Newoz#05	4_M_NEWOZ,{
	if ('room != 25 || is_party_leader() == false) {
		cutin "nines01",2;
		mes "[Newoz]";
		mes "我已经很久没这么开心了。";
		if ('room >= 25 && isbegin_quest(13181) == 1)	// officially, complete the quest for members
			completequest 13181;
		close3;
	}
	.@aigu$ = instance_npcname("Aigu#05");
	.@roter$ = instance_npcname("Roter#05");
	.@runane$ = instance_npcname("Runane#05");
	.@melody$ = instance_npcname("Melody-Jack#05");
	.@mingmin$ = instance_npcname("Mingmin#05");

	cutin "nines02",2;
	emotion ET_DELIGHT;
	mes "[Newoz]";
	mes "这是我很久以来第一次和老朋友冒险。希望我们很快再来一次。";
	npctalk "纽沃兹：这是我很久以来第一次和老朋友冒险。希望我们很快再来一次。";
	next;
	cutin "rote01",0;
	emotion ET_STARE, getnpcid(0,.@roter$);
	mes "[Roter]";
	mes "纽沃兹。需要我提醒你，这个公会已经不叫纽沃兹白翼了吗？";
	npctalk "罗特：纽沃兹。需要我提醒你，这个公会已经不叫纽沃兹白翼了吗？", .@roter$;
	next;
	cutin "nines04",2;
	mes "[Newoz]";
	mes "什么？你改了公会名字？";
	npctalk "纽沃兹：什么？你改了公会名字？";
	next;
	cutin "rote01",0;
	emotion ET_HNG, getnpcid(0,.@roter$);
	mes "[Roter]";
	mes "当然！现在叫……嗯……";
	npctalk "罗特：当然！现在叫……嗯……", .@roter$;
	next;
	emotion ET_OHNO, getnpcid(0,.@mingmin$);
	cutin "min02",0;
	mes "[Mingmin]";
	mes "别想了，就保留旧名字吧。";
	npctalk "明明：别想了，就保留旧名字吧。", .@mingmin$;
	emotion ET_SCRATCH, getnpcid(0,.@mingmin$);
	next;
	emotion ET_SPARK, getnpcid(0,.@roter$);
	cutin "rote01",0;
	mes "[Roter]";
	mes "不，我要叫它罗特超级临界公会！";
	npctalk "罗特：不，我要叫它罗特超级临界公会！", .@roter$;
	emotion ET_SHY, getnpcid(0,.@roter$);
	next;
	emotion ET_OTL, getnpcid(0,.@aigu$);
	cutin "igu05",2;
	mes "[Aigu]";
	mes "...";
	npctalk "艾古：……", .@aigu$;
	next;
	mes "[Aigu]";
	mes "听起来很无聊。";
	npctalk "艾古：听起来很无聊。", .@aigu$;
	next;
	cutin "roel04",2;
	mes "[Roel]";
	mes "我不喜欢。";
	npctalk "罗埃尔：我不喜欢。", instance_npcname("Roel#05");
	next;
	cutin "lunain04",0;
	mes "[Runane]";
	mes "真傻。";
	npctalk "鲁娜妮：真傻。", .@runane$;
	next;
	cutin "rote01",0;
	emotion ET_STARE, getnpcid(0,.@roter$);
	mes "[Roter]";
	mes "我是公会会长！我想叫什么就叫什么！";
	npctalk "罗特：我是公会会长！我想叫什么就叫什么！", .@roter$;
	next;
	cutin "arang01",2;
	mes "[Arang]";
	mes "一点也不酷。";
	npctalk "阿朗：一点也不酷。", instance_npcname("Arang#05");
	next;
	emotion ET_KIK, getnpcid(0,.@mingmin$);
	cutin "min02",0;
	mes "[Mingmin]";
	mes "保留这个名字。我退出。";
	npctalk "明明：保留这个名字。我退出。", .@mingmin$;
	next;
	emotion ET_HUK, getnpcid(0,.@roter$);
	cutin "rote01",0;
	mes "[Roter]";
	mes "你不能这样！";
	npctalk "罗特：你不能这样！", .@roter$;
	next;
	cutin "",255;
	mes "[Melody-Jack]";
	mes "我不是成员，但你问我的话，那个名字……";
	npctalk "旋律杰克：我不是成员，但你问我的话，那个名字……", .@melody$;
	emotion ET_THINK, getnpcid(0,.@melody$);
	next;
	cutin "ragi01",0;
	mes "[Lagi]";
	mes "我永远说不出那个名字。艾古，你确定要和这些人待在一起吗？";
	npctalk "拉吉：我永远说不出那个名字。艾古，你确定要和这些人待在一起吗？", instance_npcname("Lagi#05");
	next;
	cutin "igu02",2;
	mes "[Aigu]";
	mes "我不在乎。我会和纽沃兹一起。";
	npctalk "艾古：我不在乎。我会和纽沃兹一起。", .@aigu$;
	emotion ET_BIGTHROB, getnpcid(0,.@aigu$);
	next;
	cutin "lunain04",0;
	mes "[Runane]";
	mes "我只是不喜欢这个名字。";
	npctalk "鲁娜妮：我只是不喜欢这个名字。", .@runane$;
	next;
	cutin "rote01",0;
	mes "[Roter]";
	mes "嘘！今天已经够了。你们都解散！罗特超级临界公会的冒险到此结束！";
	npctalk "罗特：嘘！今天已经够了。你们都解散！罗特超级临界公会的冒险到此结束！", .@roter$;
	completequest 13181;
	if ('room == 25) {
		'room = 26;
		enablenpc instance_npcname("24 Door 1");
	}
	close3;
}


	mes "费雷……";
	npctalk "费雷：费雷……", .@ferre$;
	next;
	enablenpc .@roter$;
	enablenpc instance_npcname("Gelka#24");
	cutin "rote01",2;
	mes "[Roter]";
	mes "纽沃兹，你还活着！很好，因为我要杀……";
	npctalk "罗特：纽沃兹，你还活着！很好，因为我要杀……", .@roter$;
	next;
	enablenpc .@aigu$;
	enablenpc instance_npcname("Lagi#24");
	cutin "igu05",0;
	mes "[Aigu]";
	mes "纽沃兹，你还好吗？";
	npctalk "艾古：纽沃兹，你还好吗？", .@aigu$;
	next;
	cutin "nines01",0;
	mes "[Newoz]";
	mes "我没事。罗特，你担心我吗？";
	npctalk "纽沃兹：我没事。罗特，你担心我吗？";
	next;
	enablenpc .@melody$;
	enablenpc .@mingmin$;
	enablenpc .@arang$;
	enablenpc .@runane$;
	enablenpc .@roel$;
	sleep2 500;
	emotion ET_FRET, getnpcid(0,.@roter$);
	emotion ET_THINK, getnpcid(0,.@melody$);
	cutin "",255;
	mes "[Melody-Jack]";
	mes "哇，这地方撑不了多久——看地面震得多厉害！纽沃兹，我们得赶紧离开。";
	npctalk "旋律杰克：哇，这地方撑不了多久——看地面震得多厉害！纽沃兹，我们得赶紧离开。", .@melody$;
	next;
	mes "[Ferre]";
	mes "费雷……";
	npctalk "费雷：费雷……", .@ferre$;
	next;
	cutin "rote01",2;
	mes "[Roter]";
	mes "他还没死。各位，我知道你们是新人，但不能犯这种错误。";
	npctalk "罗特：他还没死。各位，我知道你们是新人，但不能犯这种错误。", .@roter$;
	next;
	cutin "",255;
	emotion ET_THINK, getnpcid(0,.@melody$);
	mes "[Melody-Jack]";
	mes "最好赶紧处理掉他。";
	npctalk "旋律杰克：最好赶紧处理掉他。", .@melody$;
	next;
	cutin "shaloshi01",2;
	mes "[Shaloshi]";
	mes "不！他是我的朋友！";
	npctalk "莎洛希：不！他是我的朋友！", .@shaloshi$;
	next;
	mes "[Shaloshi]";
	mes "费雷在裂隙中为我创造了这个空间。如果他失去理智或死去，这个空间及其中的一切都会消失。";
	npctalk "莎洛希：费雷在裂隙中为我创造了这个空间。如果他失去理智或死去，这个空间及其中的一切都会消失。", .@shaloshi$;
	next;
	cutin "min02",2;
	mes "[Mingmin]";
	mes "你除外，对吧。";
	npctalk "明明：你除外，对吧。", .@mingmin$;
	next;
	emotion ET_DELIGHT, getnpcid(0,instance_npcname("Newoz#24"));
	npctalk "纽沃兹：农夫对绿色南瓜说什么？你为什么橙了？", instance_npcname("Newoz#24");
	cutin "shaloshi01",2;
	mes "[Shaloshi]";
	mes "...";
	npctalk "莎洛希：……", .@shaloshi$;
	next;
	cutin "rote01",2;
	mes "[Roter]";
	mes "在那之前我有足够时间处理你。我会让你看看我为何被称为驱魔界的坏小子。";
	npctalk "罗特：在那之前我有足够时间处理你。我会让你看看我为何被称为驱魔界的坏小子。", .@roter$;
	next;
	cutin "shaloshi01",2;
	mes "[Shaloshi]";
	mes "如果我带费雷去另一个空间，松动的时空裂隙中就会出现多个出口。";
	npctalk "莎洛希：如果我带费雷去另一个空间，松动的时空裂隙中就会出现多个出口。", .@shaloshi$;
	next;
	cutin "",255;
	emotion ET_THINK, getnpcid(0,.@melody$);
	mes "[Melody-Jack]";
	mes "你很聪明，还会传送。罗特，我们不能让她走。";
	npctalk "旋律杰克：你很聪明，还会传送。罗特，我们不能让她走。", .@melody$;
	next;
	cutin "shaloshi01",2;
	mes "[Shaloshi]";
	mes "我不该把你们带来，但我真的想要朋友。";
	npctalk "莎洛希：我不该把你们带来，但我真的想要朋友。", .@shaloshi$;
	next;
	cutin "nines03",0;
	mes "[Newoz]";
	mes "你已经有了。我们就是。";
	npctalk "纽沃兹：你已经有了。我们就是。";
	next;
	cutin "shaloshi01",2;
	mes "[Shaloshi]";
	mes "……谢谢。";
	npctalk "莎洛希：……谢谢。", .@shaloshi$;
	next;
	mes "[Shaloshi]";
	mes "现在我该对你们坦诚。我已经想起了一切。让我重新自我介绍。";
	npctalk "莎洛希：现在我该对你们坦诚。我已经想起了一切。让我重新自我介绍。", .@shaloshi$;
	next;
	mes "[Shaloshi]";
	mes "我是莎洛希，恶魔读心者，也是摩洛克的第三位使者。";
	npctalk "莎洛希：我是莎洛希，恶魔读心者，也是摩洛克的第三位使者。", .@shaloshi$;
	next;
	cutin "rote01",2;
	mes "[Roter]";
	mes "摩洛克？！";
	npctalk "罗特：摩洛克？！", .@roter$;
	next;
	cutin "shaloshi01",2;
	mes "[Shaloshi]";
	mes "...I'm free now, but that doesn't change who I am: a demon.";
	npctalk "莎洛希：……我现在自由了，但这不会改变我的身份：恶魔。", .@shaloshi$;
	next;
	mes "[Shaloshi]";
	mes "我很享受和你们相处。如果再见……我们会成为敌人吗？";
	npctalk "莎洛希：我很享受和你们相处。如果再见……我们会成为敌人吗？", .@shaloshi$;
	next;
	cutin "nines03",0;
	mes "[Newoz]";
	mes "不，莎洛希。从今天起，你就是纽沃兹白翼公会的新成员。";
	npctalk "纽沃兹：不，莎洛希。从今天起，你就是纽沃兹白翼公会的新成员。";
	next;
	cutin "rote01",2;
	mes "[Roter]";
	mes "谁说你能邀请她？我才不收恶魔！";
	npctalk "罗特：谁说你能邀请她？我才不收恶魔！", .@roter$;
	next;
	cutin "arang02",2;
	mes "[Arang]";
	mes "公会成员可以互相争吵，但仍然是一家人。";
	npctalk "阿朗：公会成员可以互相争吵，但仍然是一家人。", .@arang$;
	next;
	cutin "shaloshi01",2;
	mes "[Shaloshi]";
	mes "...Thank you, Adventurer Newoz. If I find some interesting place, can I invite you over?";
	npctalk "莎洛希：……谢谢你，冒险者纽沃兹。如果找到有趣的地方，我可以邀请你来吗？", .@shaloshi$;
	next;
	mes "[Shaloshi]";
	mes "我想无论去哪，我都有带人同行的能力。不然你们也不会跟我到这里。";
	npctalk "莎洛希：我想无论去哪，我都有带人同行的能力。不然你们也不会跟我到这里。", .@shaloshi$;
	next;
	cutin "lunain04",0;
	mes "[Runane]";
	mes "你敢把我的纽沃兹带走！";
	npctalk "鲁娜妮：你敢把我的纽沃兹带走！", .@runane$;
	next;
	cutin "shaloshi01",2;
	mes "[Shaloshi]";
	mes "你刚才是不是想‘也带上我！’";
	npctalk "莎洛希：你刚才是不是想‘也带上我！’", .@shaloshi$;
	next;
	cutin "igu03",0;
	mes "[Aigu]";
	mes "啊，鲁娜妮，你真可爱！";
	npctalk "艾古：啊，鲁娜妮，你真可爱！", .@aigu$;
	next;
	cutin "roel04",2;
	mes "[Roel]";
	mes "莎洛希，我不在乎你是谁。你是我的朋友，我也是你的。";
	npctalk "罗埃尔：莎洛希，我不在乎你是谁。你是我的朋友，我也是你的。", .@roel$;
	next;
	cutin "shaloshi01",2;
	mes "[Shaloshi]";
	mes "谢谢。如果我知道该如何表达感情就好了……";
	npctalk "莎洛希：谢谢。如果我知道该如何表达感情就好了……", .@shaloshi$;
	next;
	cutin "igu05",0;
	mes "[Aigu]";
	mes "很简单。只要微笑。";
	npctalk "艾古：很简单。只要微笑。", .@aigu$;
	next;
	cutin "shaloshi04",2;
	mes "[Shaloshi]";
	mes "再见，朋友们。希望我们很快再见。";
	npctalk "莎洛希：再见，朋友们。希望我们很快再见。", .@shaloshi$;
	next;
	specialeffect EF_PORTAL2,AREA, .@shaloshi$;
	specialeffect EF_PORTAL2,AREA, .@ferre$;
	disablenpc .@shaloshi$;
	disablenpc .@ferre$;
	cutin "nines01",0;
	mes "[Newoz]";
	mes "再见。";
	npctalk "纽沃兹：再见。";
	next;
	cutin "rote01",2;
	mes "[Roter]";
	mes "别看我。那是出口吗？";
	npctalk "罗特：别看我。那是出口吗？", .@roter$;
	close2;
	cutin "",255;
	if ('room == 24 && is_party_leader() == true)
		donpcevent 'jitterbug_main$ + "::OnNextIs5";
	end;
}


		next;
		emotion 6;
		mes "[Strong Guards]";
		mes "嘿，你！那里！排好队！停在那里！别挡路！";
		mes "如果你继续这样，我就不让你来这里！";
		close;
	}
}

// Wigner
prt_cas_q,82,21,1	script	Levuiere Wigner#ep16wig	4_EP16_LOUVIERE,{
	if (BaseLevel < 100) {
		mes "[Levuiere]";
		mes "亲爱的冒险者，虽然我敬佩你克服重重障碍和困难的努力，但你现在来这里还是有点早。";
		mes "希望稍后能再见到你。";
		close;
	}
	if (ep16_wig == 0) {
		if (isbegin_quest(7682) != 1) {
			mes "[Levuiere]";
			mes "你是谁？";
			mes "只有获准的人才能进入这里。请离开。";
			close;
		}
		mes "[Levuiere]";
		mes "亲爱的冒险者，欢迎来到维格纳家族。我叫^0000cd莱维耶尔·维格纳^000000。";
		next;
		mes "[Levuiere]";
		mes "亲爱的冒险者，你在参加为你举办的宴会之际来访，我深感荣幸。";
		next;
		mes "[Levuiere]";
		mes "这场宴会不只是庆祝，因为王室议会也同时举行。你听说了吗？";
		next;
		mes "[Levuiere]";
		mes "我们家族也有候选人参加王室议会。你想见见他吗？";
		next;
		mes "[Levuiere]";
		mes "她是维格纳家的夫人，^0000cd凯瑟琳·维格纳^000000。";
		next;
		mes "[Catherine]";
		mes "你好。你在维格纳家族做客期间请随意。如果有任何不便，请告诉我。";
		next;
		mes "[Catherine]";
		mes "我们维格纳家族会尽力让你感到方便，亲爱的冒险者。";
		next;
		mes "[Catherine]";
		mes "有时间也请拜访我们的庄园，亲爱的冒险者。我们随时欢迎你。";
		mes "^0000cd尤尔根^000000现在在哪里？";
		next;
		cloakoffnpcself( "Jurgen Wigner#ep16wig00" );
		cloakonnpcself( "Jurgen Wigner#ep16wig" );
		cutin "16jur_nor",0;
		mes "[Jurgen]";
		mes "你在找我吗？";
		next;
		cutin "",255;
		mes "[Levuiere]";
		mes "你在这里！亲爱的冒险者，这是^0000cd维格纳家族的继承人^000000，也是这次参加王室议会的^0000cd王位候选人^000000。";
		next;
		cutin "16jur_nor",0;
		mes "[Jurgen]";
		mes "你好。我叫^0000cd尤尔根·维格纳^000000。很高兴见到你。";
		next;
		mes "[Jurgen]";
		mes "亲爱的冒险者，请把这里当作自己的家。需要什么或觉得不便，随时告诉我们。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "谢谢你的款待。";
		next;
		mes "[Jurgen]";
		mes "那么，失陪了。";
		next;
		cloakonnpcself( "Jurgen Wigner#ep16wig00" );
		cloakoffnpcself( "Jurgen Wigner#ep16wig" );
		cutin "",255;
		mes "[Levuiere]";
		mes "啧，我担心他缺乏社交能力。作为家族继承人，他得见很多人。亲爱的冒险者，请原谅我儿子的无礼。";
		next;
		mes "[Levuiere]";
		mes "如果有时间，你愿意见见我们的孩子吗？他们一直很兴奋，想在宴会上见到击败梦罗克的英雄。";
		setquest 14475;// To Jurgen
		ep16_wig = 1;
		next;
		mes "[Levuiere]";
		mes "那么请随意参观，亲爱的冒险者。";
		close;
	}
	if (ep16_wig == 1) {
		mes "[Levuiere]";
		mes "亲爱的冒险者，请把这里当作自己的家，慢慢参观。";
		next;
		mes "[Levuiere]";
		mes "如果有时间，请给我们的孩子讲讲你的冒险故事？那对他们会是宝贵的经历。";
		next;
		mes "[Levuiere]";
		mes "那么，祝你休息愉快。";
		close;
	}
	if (ep16_wig == 2) {
		mes "[Levuiere]";
		mes "亲爱的冒险者，你见过孩子们了吗？如果你有空，我想和你喝茶、听你讲故事。";
		next;
		mes "[Levuiere]";
		mes "我们非常喜欢听冒险者的故事。";
		mes "那些冒险是金钱买不到的宝贵经历。";
		next;
		mes "[Catherine]";
		mes "不知道我们的孩子有没有注意礼仪。他们有时如此鲁莽，一定是我们宠坏了。";
		next;
		mes "[Catherine]";
		mes "最近我在提醒他们。如果他们对你无礼，请多多包涵。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "完全没有。尤尔根似乎比我上次来时成长了。";
		mes "凯特琳和艾萨克也给我留下了深刻印象。";
		next;
		mes "[Catherine]";
		mes "我们对他们太宽松了。";
		mes "上次王室议会准备不足，我们感到羞愧。";
		next;
		mes "[Levuiere]";
		mes "他是否成为国王并不重要。";
		mes "如果他是当国王的材料，自然会成为国王；如果不是，也不必勉强。我不想因此给他压力。";
		next;
		mes "[Catherine]";
		mes "你没有野心吗？如果这一代能从家族中培养出国王，该多么荣耀！";
		mes "既然祖先建立了这个王国，我们理应培养出国王。";
		next;
		mes "[Levuiere]";
		mes "国王是个空洞的职位，只会带来责任。";
		mes "我以前没告诉过你吗？你忘了吗？";
		next;
		mes "[Levuiere]";
		mes "如果家族培养出国王，大量财富会被花掉。我们家族曾因此吃尽苦头。";
		mes "国王身边总有一群讨厌的苍蝇。";
		next;
		mes "[Catherine]";
		mes "你知道吗，也可能恰恰相反。";
		mes "这可能会强化我们的家族。";
		next;
		mes "[Catherine]";
		mes "现在有凯特琳和艾萨克支持尤尔根。";
		next;
		mes "[Levuiere]";
		mes "嗯……艾萨克。";
		mes "想到他就让我充满信心。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "你一定非常信任艾萨克。";
		next;
		mes "[Levuiere]";
		mes "哦，我们一定把你冷落在谈话之外了，亲爱的冒险者。";
		mes "抱歉。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "完全没有。我很享受这次谈话。";
		next;
		mes "[Levuiere]";
		mes "你这么一说，我想问问你觉得我们的第三个孩子艾萨克怎么样？";
		mes "他是孩子中最像维格纳家族的人。";
		next;
		mes "[Levuiere]";
		mes "尤尔根在意外表，却不太在乎金钱或王位……";
		mes "如果凯特琳是男孩，我会乐意把一切交给她。";
		next;
		mes "[Levuiere]";
		mes "幸运的是，曾经调皮的第三个孩子已经长大，配得上维格纳之名。";
		mes "并不是说另外两个不够好。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "我明白你的意思。";
		next;
		mes "[Catherine]";
		mes "不过别在孩子们面前这样说。偏爱某个孩子不好。";
		next;
		mes "[Levuiere]";
		mes "作为维格纳家族的一员，必须能够面对批评。";
		mes "他们应该听取他人的话后判断对错，也要能够面对残酷的真相。";
		next;
		mes "[Catherine]";
		mes "请别在孩子们面前这样说。";
		next;
		mes "[Levuiere]";
		mes "我从来不会这样对他们说。";
		next;
		mes "[Catherine]";
		mes "总之，艾萨克最近似乎在忙什么。你知道他在做什么吗？";
		next;
		mes "[Levuiere]";
		mes "我听说他和罗根堡家族的三公子在做某件事。不必担心艾萨克，他知道如何照顾自己。";
		next;
		mes "[Katrin]";
		mes "啊啊啊啊啊！";
		next;
		emotion ET_HUK;
		mes "[Levuiere]";
		mes "^0000cd凯特琳？^000000";
		next;
		emotion ET_HUK, getnpcid(0, "Catherine Wigner#ep16wig");
		mes "[Catherine]";
		mes "^0000cd凯特琳？^000000 我的孩子发生什么事了吗？我得过去看看……";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "你们两个留在这里。可能很危险。我先去看看。";
		cloakonnpcself( "Isaac Wigner#ep16wig" );
		erasequest 14476;// To Levuiere and His Wife
		setquest 14477;// What Is Going on?
		ep16_wig = 3;
		close;
	}
	if (ep16_wig == 3) {
		mes "[Levuiere]";
		mes "我们的孩子，我是说凯特琳，发生什么事了吗？";
		mes "我是不是该亲自下去？";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "可能很危险。请在这里等一会儿。";
		mes "我去。";
		close;
	}
	if (ep16_wig < 12) {
		mes "[Levuiere]";
		mes "亲爱的冒险者，欢迎。";
		mes "我问过孩子们发生了什么，但他们没告诉我。";
		next;
		mes "[Catherine]";
		mes "他们在对我隐瞒什么坏事吗……？";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "不，他们没有。你不用担心。";
		next;
		mes "[Catherine]";
		mes "那请告诉我到底是什么事。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "既然他们决定不告诉你，那就不该由我来说。";
		mes "我还有些事要办，现在该走了。";
		close;
	}
	if (ep16_wig < 16) {
		mes "[Levuiere]";
		mes "亲爱的冒险者，你似乎很忙。";
		mes "是我们的孩子请你做的事吗？";
		next;
		mes "[Catherine]";
		mes "我们决定不再追问了。";
		mes "他们已经长大，但我们还是太宠着他们……";
		next;
		mes "[Levuiere]";
		mes "总之，需要帮助随时告诉我。";
		mes "也谢谢你帮助我们的孩子。";
		close;
	}
	if (ep16_wig > 15) {
		mes "[Levuiere]";
		mes "亲爱的冒险者，我听孩子们说了这件事。";
		mes "他们没有说全部细节，但我听说他们欠你一个大人情。";
		next;
		mes "[Catherine]";
		mes "孩子们最近相处得好多了。";
		mes "他们以前关系也不坏，但现在似乎更关心彼此。我很高兴。";
		next;
		mes "[Levuiere]";
		mes "你似乎是我们家族的幸运使者。";
		mes "亲近并善待像你这样的人，是我们的家族传统。";
		next;
		mes "[Catherine]";
		mes "宴会结束后请拜访我们的庄园。";
		mes "能邀请你到家里做客是我们的荣幸。";
		close;
	}
}

prt_cas_q,82,23,0	script	Catherine Wigner#ep16wig	1_F_LIBRARYGIRL,{
	if (ep16_wig == 0) {
		mes "[Catherine]";
		mes "你好，亲爱的冒险者。欢迎！";
		mes "维格纳家族很荣幸你来访。";
		next;
		mes "[Catherine]";
		mes "如果有任何不便，请告诉我。";
		mes "作为家族夫人，我会尽力让你住得愉快。";
		next;
		mes "[Catherine]";
		mes "你可以和我身边的家主交谈。他叫莱维耶尔·维格纳。";
		close;
	}
	if (ep16_wig <= 2) {
		mes "[Catherine]";
		mes "你见过我们的孩子吗？和你交谈对他们会是无价的经验，亲爱的冒险者。";
		mes "他们成长过程中没经历过什么困难，所以缺少各种生活经验。";
		next;
		mes "[Catherine]";
		mes "我嫁给了建立这个国家的家族成员，希望把孩子培养得配得上这个姓氏。但我的丈夫对名望和权力不感兴趣。";
		next;
		mes "[Catherine]";
		mes "我对此感到很遗憾。";
		next;
		mes "[Catherine]";
		mes "不过我总是让孩子们做想做的事，这让我怀疑是不是宠坏了他们……";
		next;
		mes "[Catherine]";
		mes "所以我想听听你的故事。";
		mes "听经历丰富的人讲故事总是很快乐。";
		close;
	}
	if (ep16_wig == 3) {
		mes "[Catherine]";
		mes "我的孩子凯特琳是不是出什么事了？";
		mes "我最好亲自下去看看。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "可能很危险，请在这里等一会儿。";
		mes "让我下去看看发生了什么。";
		next;
		mes "[Catherine]";
		mes "希望一切都好。";
		close;
	}
	if (ep16_wig < 12) {
		mes "[Levuiere]";
		mes "亲爱的冒险者，欢迎。";
		mes "我问过孩子们发生了什么，但他们没告诉我。";
		next;
		mes "[Catherine]";
		mes "他们在对我隐瞒什么坏事吗……？";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "不，他们没有。你不用担心。";
		next;
		mes "[Catherine]";
		mes "那请告诉我到底是什么事。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "既然他们决定不告诉你，那就不该由我来说。";
		mes "我还有些事要办，现在该走了。";
		close;
	}
	if (ep16_wig < 16) {
		mes "[Catherine]";
		mes "不知道我们的孩子有没有给你添麻烦。虽然我们很好奇，但决定不再追问。";
		mes "他们已经长大，但我们还是太宠着他们……";
		next;
		mes "[Levuiere]";
		mes "总之，需要帮助随时告诉我。";
		mes "也谢谢你帮助我们的孩子。";
		close;
	}
	if (ep16_wig > 15) {
		mes "[Catherine]";
		mes "不知为何，我们的孩子变得非常亲密。";
		mes "我想这一切都多亏了你。";
		next;
		mes "[Catherine]";
		mes "宴会结束后请拜访我们的庄园。";
		mes "请给我们机会款待你，亲爱的冒险者。";
		close;
	}
}

prt_cas_q,95,9,5	script	Jurgen Wigner#ep16wig	4_M_4THPRIN1,{
	if (checkweight(1304,3) == 0) {
		cutin "16jur_nor",0;
		mes "[Jurgen]";
		mes "你似乎带了很多行李。还好吗？";
		mes "看起来又多又大。";
		next;
		mes "[Jurgen]";
		mes "要不要减少一些？";
		close3;
	}
	if (ep16_wig == 0) {
		mes "[Jurgen]";
		mes "你是我的粉丝吗？预约了吗？如果你是我的客人，不如去见那边的父亲？";
		close;
	}
	if (ep16_wig == 1) {
		cutin "16jur_nor",0;
		mes "[Jurgen]";
		mes "亲爱的冒险者，很高兴你还在这里。之前失礼了，抱歉。我想和你多聊聊，但在母亲面前说错话会挨骂。";
		next;
		mes "[Jurgen]";
		mes "她倒不会严厉责备我，但我还是觉得不自在，所以只好离开。抱歉。";
		next;
		mes "[Jurgen]";
		mes "亲爱的冒险者，既然你来了，我可以介绍家人给你吗？这位优雅的女士是我的姐姐，^0000cd凯特琳·维格纳^000000。";
		next;
		cutin "16kat_nor",2;
		mes "[Katrin]";
		mes "这种场合别叫我姐姐，而要叫我维格纳家族的长女。";
		next;
		mes "[Katrin]";
		mes "亲爱的冒险者，很荣幸见到你。希望你在维格纳家族住得舒心。";
		next;
		cutin "16jur_nor",0;
		mes "[Jurgen]";
		mes "这是我的弟弟，^0000cd艾萨克·维格纳^000000。";
		next;
		mes "[Jurgen]";
		mes "他是维格纳家族最小的孩子。和不关心家族事务的姐姐与我不同，他是天才，会让维格纳家族声名远扬。";
		next;
		cutin "16isa",1;
		mes "[Isaac]";
		mes "你好？我是艾萨克·维格纳。你来拜访这样无聊的家族真是辛苦。希望你能在这里玩得开心……";
		next;
		cutin "16kat_ang",2;
		mes "[Katrin]";
		mes "艾萨克，我以前警告过你别这样说话。";
		mes "你还对刚介绍你的尤尔根不敬。你想让我们都丢脸吗？";
		next;
		cutin "16isa",1;
		mes "[Isaac]";
		mes "开玩笑，只是开玩笑！姐姐，你太死板了。";
		mes "在这种沉闷的气氛里，这位冒险者值得笑一笑，对吧？";
		next;
		cutin "16kat_nor",2;
		mes "[Katrin]";
		mes "你不是幽默，而是在对客人无礼。亲爱的冒险者，请原谅他的失礼。抱歉。";
		next;
		cutin "16jur_nor",0;
		mes "[Jurgen]";
		mes "顺便说，我想尽快回家。这里太狭窄阴暗了。";
		mes "至少我想去宴会厅。";
		next;
		mes "[Jurgen]";
		mes "一定有很多人想见我。我有义务露面。";
		next;
		mes "[Jurgen]";
		mes "我的出现会照亮黑暗的宫殿。我应该去娱乐那里无聊的人。";
		next;
		cutin "16kat_ang",2;
		mes "[Katrin]";
		mes "你在侮辱王室议会。你必须尽力。王室议会比你想的更神圣。";
		next;
		cutin "16kat_nor",2;
		mes "[Katrin]";
		mes "别忘了你是王位候选人之一，将和七大王室家族一起领导王国。";
		next;
		mes "[Katrin]";
		mes "这意味着你不该像孩子一样。我说过，别把责任和义务看得太轻。";
		next;
		cutin "16jur_nor",0;
		mes "[Jurgen]";
		mes "当然，我很清楚。所以我整理了仪容，把头发弄得完美。";
		mes "我努力让自己不松懈。";
		next;
		mes "[Jurgen]";
		mes "要处理更重要的事，就得先把自己打理好。";
		mes "当然，我已经准备充分。";
		next;
		mes "[Jurgen]";
		mes "想看看我的新披风吗？";
		mes "它和我的眼睛颜色很搭，一定能照亮宫殿。";
		next;
		cutin "16isa",1;
		mes "[Isaac]";
		if (ep16_lug == 2 || ep16_lug == 3 || ep16_lug == 7 || ep16_lug == 8) {
			mes "哦，又来了。亲爱的冒险者，你该习惯在家里和我弟弟聊天。";
			next;
		}
		else {

	if (checkweight(1201,1) == 0) {
		mes "^3355FF请稍等！";
		mes "你现在携带的物品太多了。";
		mes "请先整理一下随身物品。";
		mes "然后再回来。";
		mes "请使用卡普拉服务";
		mes "存放一些物品后再回来。^000000";
		close;
	}
	if (BaseClass == Job_Assassin) {
		mes "[Karred]";
		mes "欢迎。";
		mes "要喝一杯吗？";
	}
	else {
		mes "[Karred]";
		mes "你想喝什么？";
	}
	next;
	switch(select("点饮料:关于任务:离开")) {
	case 1:
		mes "[Karred]";
		mes "我们有热带索格拉特";
		mes "和海滩绯红。";
		mes "你想喝哪一种？";
		next;
		switch(select("热带索格拉特:海滩绯红:免费饮料怎么样？")) {
		case 1:

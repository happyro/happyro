				mes "你已经携带太多东西了。";
				close;
			}
			else {
				if (BaseClass == Job_Assassin) {
					if (Zeny < 800) {
						mes "[Karred]";
						mes "我可以给你特别折扣，但是";
						mes "你的钱连折扣价都付不起。";
						mes "先检查一下你的钱吧。";
						mes "这杯饮料对刺客只要800 Zeny！";
					}
					else {
						mes "[Karred]";
						mes "我给你特别折扣。";
						mes "来，喝吧。";
						mes "这杯饮料主要由果汁制成，";
						mes "但也不要喝太多。";
						set Zeny, Zeny-800;
						getitem 12112,1; //Tropical_Sograt
					}
					close;
				}
				else {
					if (Zeny < 1000) {
						mes "[Karred]";
						mes "你到底有没有钱？";
						mes "先检查一下你的钱吧。";
						mes "一杯要1000 Zeny。";
						close;
					}
					else {
						mes "[Karred]";
						mes "给你。";
						mes "这杯饮料主要由果汁制成，";
						mes "但也不要喝太多。";
						set Zeny, Zeny-1000;
						getitem 12112,1; //Tropical_Sograt
						close;
					}
				}
			}
		case 2:
			if (MaxWeight - Weight < 2000) {
				mes "[Karred]";
				mes "你确定还能拿得动一杯酒吗？";
				mes "你已经携带太多东西了。";
				close;
			}
			else {
				if (BaseClass == Job_Assassin) {
					if (Zeny < 800) {
						mes "[Karred]";
						mes "我可以给你特别折扣，但是";
						mes "你的钱连折扣价都付不起。";
						mes "先检查一下你的钱吧。";
						mes "这杯饮料对刺客只要800 Zeny！";
					}
					else {
						mes "[Karred]";
						mes "我给你特别折扣。";
						mes "来，慢慢享用。";
						set Zeny, Zeny-800;
						getitem 12113,1; //Vermilion_The_Beach
					}
					close;
				}
				else {
					if (Zeny < 1000) {
						mes "[Karred]";
						mes "你到底有没有钱？";
						mes "先检查一下你的钱吧。";
						mes "一杯要1000 Zeny。";
						close;
					}
					else {
						mes "[Karred]";
						mes "给你。";
						mes "不要喝太多，好吗？";
						set Zeny, Zeny-1000;
						getitem 12113,1; //Vermilion_The_Beach
						close;
					}
				}
			}
		case 3:
			mes "[Karred]";
			mes ".........";
			mes "出去。";
			close;
		}
	case 2:
		if (BaseClass == Job_Assassin) {
			mes "[Karred]";
			mes "我能帮你什么？";
			next;
			if (mao_morocc2 == 4) {
				mes "[Karred]";
				mes "……Rin？我明白了。你在协助Kidd先生。";
				mes "Rin……她在里面的房间。";
				mes "她不久前受了重伤……";
				next;
				select("?");
				mes "[Karred]";
				mes "不能指望工作总是一帆风顺。";
				mes "当然会有风险。";
				mes "你不去看看她吗？";
				set mao_morocc2,5;
				close;
			}
			else if (mao_morocc2 > 4) {
				mes "[Karred]";
				mes "Rin现在需要休息。希望你尽力帮助她。";
				mes "不过也请照顾好自己。";
				next;
				mes "[Karred]";
				mes "你和Rin对我来说就像自己的孩子，而这样的伤势……";
				mes "唉……看到这些真让我痛苦。";
				close;
			}
			else {
				mes "[Karred]";
				mes "希望你常来。即使没有任务，这里也永远向你开放。";
				close;
			}
		}
		else {
			if (mao_morocc2 > 4) {
				mes "[Karred]";
				mes "Rin需要在床上休息一阵子。希望你能帮她完成职责。";
				mes "……承认这一点有些难为情，但我把她当成自己的女儿。";
				next;
				mes "[Litheron]";
				mes "啊，忘了我刚才说的话吧。那样说不合适。";
				mes "我想我整天和酒打交道，已经醉了。";
				close;
			}
			else {
				mes "[Karred]";
				mes "我能帮你什么？";
				mes "顺便告诉你，‘推荐信’已经失效了。你最好回去。";
				if (mao_morocc2 == 4) {
					next;
					select("我是来找Rin的！");
					mes "[Karred]";
					mes "……？你为什么找Rin？";
					next;
					mes "......";
					mes ".........";
					next;
					mes "[Karred]";
					mes "我明白了。原来你是灰色熔岩洞探险队的成员。";
					mes "Rin在里面的房间。";
					mes "……她受了重伤，正在床上休息。别做出吓到她的事，好吗？";
					set mao_morocc2,5;
					close;
				}
				else {
					close;
				}
			}
		}
		break;
	case 3:
		mes "[Karred]";
		mes "嗯。";
		close;
	}
}


que_job01,80,77,0	script	que_job01#04	45,2,2,{

					mes "嘿，这才对嘛！";
					mes "我说的就是这个！";
					mes "嘿，酒保！给我";
					mes "平常那杯！我喜欢你的";
					mes "风格，冒险者……";
					set Zeny, Zeny-1000;
					next;
					mes "[Litheron]";
					mes "好吧，你可以进来了。";
					mes "但你敢把这个酒吧的事";
					mes "告诉任何活人";
					mes "试试看。";
					close2;
					warp "que_job01",61,50;
					end;
				}
				else {
					mes "咦……";
					mes "哦，你的钱甚至不够";
					mes "在这里买水。哎呀……";
					mes "真想进去的话，";
					mes "记得带够现金！";
					mes "";
					close2;
					warp "que_job01",85,77;
					end;
				}
			case 2:
				mes "[Litheron]";
				mes "你不是很机灵嘛，";
				mes "是吧……？行，行。";
				mes "既然你不肯帮我，";
				mes "那我为什么要帮你？";
				mes "走开！";
				close2;
				warp "que_job01",85,77;
				end;
			}
		}
		else {
			mes "[Bar Master]";
			mes "只要你把外人挡在入口外，今天你喝的每杯酒都由酒吧请客。";

que_job01,49,49,5	script	Tao#dan_09	877,{
	mes "[Tao]";
	if (BaseClass == Job_Assassin) {
		mes "欢迎，喵。";
		mes "外面的世界怎么样？喵？";
		next;
		if (prt_curse == 24) {
			switch(select("Marjana在里面吗？:我是来看你的，Tao。")) {
			case 1:
				mes "[Tao]";
				mes "她在你左边的房间里，喵～";
				mes "不过，你怎么知道她在这里，喵？";
				close;
			case 2:
				mes "[Tao]";
				mes "这里不是玩耍的地方，喵……";
				mes "……嘿，你那样看着我很尴尬，喵……";
				close;
			}
		}
		else if (mao_morocc2 > 4) {
			mes "[Tao]";
			mes "Tao知道你在想什么，喵～你是来看Rin姐姐的，对吧，喵？";
			mes "嘿嘿，她在哪里呢，喵～";
			close;
		}
		else {
			mes "[Tao]";
			mes "没理由待在这里的话就离开，喵！";
			mes "不是所有人都能进入这里，喵。";
			mes "你虽然不知怎么进来了，却不能进入房间。";
			next;
			mes "[Tao]";
			mes "不，等等……我想你也许能进去……我不知道，喵！";
			mes "Tao当门卫当累了，喵！喵！";
			close;
		}
	}
	else {
		mes "你为什么来这里，喵？";
		next;
		switch(select("嘿，小孩，你一个人吗？:你是什么，喵？！:你为什么一直喵喵叫？！")) {
		case 1:
			mes "[Tao]";
			mes "你叫谁小孩？";
			mes "Tao可是优秀的门卫！";
			mes "别叫我小孩！";
			next;
			mes "[Tao]";
			mes "我看得出来你来这里有原因，但你惹上麻烦了！";
			mes "你要是以为我会告诉你，";
			mes "大师和Marjana在左边房间，那你就错了。呜……喵！";
			close;
		case 2:
			mes "[Tao]";
			mes "你是在取笑我当门卫吗，喵？！";
			mes "呜……";
			next;
			mes "[Tao]";
			mes "你让我生气了，喵。滚开！！";
			close;
		case 3:
			mes "[Tao]";
			mes "说来话长，喵。";
			mes "那天我开始喵喵叫，已经过去很久了……";
			mes "那天，Tao非常想要一条大缎带。";
			next;
			mes "[Tao]";
			mes "于是Tao去寻找野生玫瑰。";
			mes "喵？！我为什么要告诉你这些，喵？！";
			next;
			mes "[Tao]";
			mes "呜！";
			mes "你到底是什么，喵？！";
			next;
			mes "[Tao]";
			mes "出去！";
			close;
		}
	}
}

que_job01,51,55,0	script	que_job01#room_1	45,1,1,{
OnInit:
OnReset:
	set $@moc_mao_room1,0; //Global Variable
	end;

OnTouch_:
	mes "[Tao]";
	if (prt_curse == 24) {
		if ($@moc_mao_room1 == 0) {
			set $@moc_mao_room1,1; //Global Variable
			donpcevent " #room1timer::OnEnable";
			donpcevent "Marjana#poison::OnEnable";
			mes "啊，那个地方受到";
			mes "安全魔法保护，你只能";
			mes "在那里停留^4D4DFF4分钟^000000。";
			mes "别浪费时间，喵！";
			close2;
			warp "que_job01",11,7;
			end;
		}
		else {
			mes "真是抱歉，喵～";
			mes "里面已经有别人了。";
			mes "请稍后再回来，";
			mes "好吗，喵？";
			close2;
			warp "que_job01",52,50;
			end;
		}
	}
	else if (mao_request > 0) {
		if ($@moc_mao_room1 == 0) {
			set $@moc_mao_room1,1; //Global Variable
			donpcevent " #room1timer::OnEnable";
			donpcevent "Valdes#moc_master_1::OnEnable";
			mes "啊，那个地方受到";
			mes "安全魔法保护，你只能";
			mes "在那里停留^4D4DFF4分钟^000000。";
			mes "别浪费时间，喵！";
			close2;
			warp "que_job01",11,7;
			end;
		}
		else {
			mes "真是抱歉，喵～";
			mes "里面已经有别人了。";
			mes "请稍后再回来，";
			mes "好吗，喵？";
			close2;
			warp "que_job01",52,50;
			end;
		}
	}
	else {
		mes "你是谁，喵？！";
		mes "只有获准人员才能进入内室，喵！";
		mes "你没有得到许可！";
		mes "出去！";
		close2;
		warp "que_job01",52,50;
		end;
	}
}

que_job01,1,1,0	script	 #room1timer	844,{
OnEnable:
	initnpctimer;
	mapannounce "que_job01", "你现在将进入大师区域1。",bc_map,"0x70DBDB";
	end;

OnStop:
	mapannounce "que_job01", "大师区域1的安全魔法已解除。",bc_map,"0x70DBDB";
	donpcevent "#room1_warp13::OnDisable";
	donpcevent "Valdes#moc_master_1::OnDisable";
	donpcevent "Marjana#poison::OnInit";
	donpcevent "que_job01#room_1::OnReset";
	stopnpctimer;
	end;

OnTimer240000:
	donpcevent "#room1_warp13::OnEnable";
	end;

OnTimer245000:
	donpcevent "#room1_warp13::OnDisable";
	donpcevent "Valdes#moc_master_1::OnDisable";
	donpcevent "Marjana#poison::OnInit";
	end;

OnTimer250000:
	mapannounce "que_job01", "大师区域1的安全魔法现已启动。",bc_map,"0x70DBDB";
	donpcevent "que_job01#room_1::OnReset";
	stopnpctimer;
}

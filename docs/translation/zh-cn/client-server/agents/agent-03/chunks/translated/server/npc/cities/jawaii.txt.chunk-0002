jawaii_in,28,124,0	script	Bartender#jaw	46,{
	mes "[酒保]";
	mes "欢迎来到";
	mes "Jawaii 酒馆酒吧。";
	mes "你想喝";
	mes "什么？";
	next;
	if (Zeny < 99) {
		mes "[酒保]";
		if (rand(1,100) > 29) {
			mes "嗯，抱歉，";
			mes "你没有足够的钱";
			mes "买酒。";
			mes "";
			close;
		}
		mes "……嗯……";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "嘿……！";
		mes "酒保……";
		mes "再给我一杯。";
		next;
		mes "[酒保]";
		mes "好吧……";
		mes "我请客。";
		mes "喝一杯吧。";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "谢谢。";
		close2;
		percentheal -100,0;
		end;
	}
	while(1) {
		switch(select("听从酒保推荐:我要神枪手:我要可波:我要炸弹:我要布吉曼")) {
		case 1:
			set .@roof_jaw,.@roof_jaw+3;
			if (.@roof_jaw > 9) {
				mes "[酒保]";
				mes "嗯……";
				mes "你似乎喝得够多了。";
				mes "确定没问题吗？";
				next;
				mes "["+strcharinfo(0)+"]";
				mes "酒保，";

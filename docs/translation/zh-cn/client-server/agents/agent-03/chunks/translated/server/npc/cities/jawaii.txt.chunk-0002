jawaii_in,15,104,0	script	Waitress#jawaii	80,{
	if (checkweight(1201,1) == 0) {
		mes "^3355FF * 请稍等！*";
		mes "你现在携带的物品太多。请将部分物品存入卡普拉仓库后再试。^000000";
		close;
	}
	if (getpartnerid()) {
		mes "[女服务员]";
		mes "你好，";
		mes "需要什么服务？";
		emotion ET_CHUP;
		next;
		switch(select("给我食物:给我饮料:酒吧在哪里？")) {
		case 1:
			mes "[女服务员]";
			mes "1000 Zeny 可以购买";
			mes "1 块肉。要来一块吗？";
			next;
			if (select("是:哇——！太贵了！") == 1) {
				mes "[女服务员]";
				if (Zeny > 999) {
					set Zeny, Zeny-1000;
					getitem 517,1; //Meat
					mes "给你~";
					mes "用餐愉快~！";
					close;
				}
				mes "抱歉……";
				mes "钱不够……";
				close;
			}
			mes "[女服务员]";
			mes "如果你";
			mes "还需要什么，";
			mes "请告诉我。";
			close;

		case 2:
			mes "[女服务员]";
			mes "1000 Zeny 可以购买";
			mes "1 瓶黄色药水。";
			mes "要来一瓶吗？";
			next;
			if (select("是:哇——！太贵了！") == 1) {
				mes "[女服务员]";
				if (Zeny > 999) {
					set Zeny, Zeny-1000;
					getitem 503,1;// Yellow_Potion
					mes "给你~";
					mes "用餐愉快~！";
					close;
				}
				mes "抱歉，你没有足够的钱？！";
				close;
			}
			mes "[Waitress]";
			mes "如果你";
			mes "还需要什么，";
			mes "请告诉我。";
			close;

		case 3:
			mes "[女服务员]";
			mes "哦，往酒馆中央走就行。";
			mes "希望你玩得开心，但要小心，";
			mes "别喝太多！玩得开心！";
			close;
		}
	}
	emotion ET_HUK;
	mes "[女服务员]";
	mes "嘿，嘿……！";
	mes "我不知道";
	mes "你为什么来这里……";
	next;
	mes "[女服务员]";
	mes "但我们不允许单身者在这里骚扰幸福的已婚夫妇。";
	mes "喝完你的酒";
	mes "就离开吧！";
	next;
	if (Select("我是单身军成员！！:……我只是想恭喜他们……") == 1) {
		mes "[员工]";
		mes "是吗。";
		mes "别闹了。";
		mes "你为什么不能为别人";
		mes "感到高兴？！";
		next;
		mes "[员工]";
		mes "^666666*Sigh*^000000";
		mes "和伴侣一起来时，";
		mes "这里会欢迎你，";
		mes "好吗？";
		close;
	}
	mes "[员工]";
	mes "嗯？你刚才说";
	mes "想恭喜他们？";
	mes "哦，你一定是其中一对夫妇的";
	mes "好朋友……";
	mes "";
	mes "";
	next;
	mes "[员工]";
	mes "抱歉！";
	mes "请允许我为刚才的无礼道歉。";
	mes "希望你玩得开心。";
	mes "";
	mes "";
	close;
}

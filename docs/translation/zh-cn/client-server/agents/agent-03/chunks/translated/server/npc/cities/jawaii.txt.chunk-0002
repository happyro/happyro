				mes "^0000FF‘特别 J&Z’^000000。";
				mes "这杯我请。";
				next;
				mes "["+strcharinfo(0)+"]";
				mes "谢谢……";
				mes "非常感谢……";
				close2;
				percentheal -100,0;
				end;
			}
			if (Zeny > 99) set Zeny, Zeny-100;
			switch(rand(4)) {
			case 1:
				mes "[酒保]";
				mes "嗯……";
				mes "这杯鸡尾酒怎么样？";
				next;
				mes "[酒保]";
				mes "我推荐";
				mes "^0000FF巴卡迪 150^000000。";
				mes "这是海盗的饮料！";
				next;
				mes "^3355FF你端详着装有";
				mes "闪亮棕色液体的";
				mes "小玻璃杯……^000000";
				mes "";
				next;
				mes "^3355FF虽然杯子很小、容量不多，但里面的液体闻起来依然很危险……^000000";
				next;
				mes "[酒保]";
				mes "它很烈而且易燃，";
				mes "你可能会觉得喉咙";
				mes "像被烧灼一样。";
				next;
				mes "^3355FF你一口把它喝了下去。^000000";
				specialeffect2 EF_VENOMDUST;
				percentheal -20,0;
				next;
				break;
			case 2:
				mes "[酒保]";
				mes "嗯……";
				mes "这杯鸡尾酒怎么样？";
				next;
				mes "[酒保]";
				mes "我推荐^0000FF黑俄罗斯双倍^000000。它会让你梦见躺在广阔的俄罗斯田野……";
				next;
				mes "^3355FF你端详着装有冰镇深棕色液体的大杯。香气带着淡淡甜味，";
				mes "还有让你想起留胡子老人的麝香。^000000";
				next;

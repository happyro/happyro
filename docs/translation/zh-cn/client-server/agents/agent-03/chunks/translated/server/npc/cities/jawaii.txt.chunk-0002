		next;
		mes "[员工巴菲]";
		mes "哦~";
		mes "看看你……";
		mes "你看起来和";
		if (Sex == SEX_MALE)
			mes "你的妻子很般配~";
		else
		mes "你的丈夫很般配~";
		mes "啊，我也想快点结婚~！";
		close;
	}
	else if (!getpartnerid()) {
		next;
		mes "[员工巴菲]";
		mes "嗯……？";
		mes "你看起来不像";
		mes "结婚了，对吧？";
		if (Sex == SEX_MALE) {
			next;
			mes "[员工巴菲]";
			mes "我很擅长";
			mes "做饭和打扫。";
			mes "^666666*咳咳*^000000 而且我有^FF0000好身材^000000。";
			mes "你觉得怎么样……？";
		}
		close;
	}
	mes "希望你玩得开心。";
	close;

OnWelcome:
	emotion ET_CHUP;
	end;
OnSolo:
	emotion ET_HUK;
	end;
}


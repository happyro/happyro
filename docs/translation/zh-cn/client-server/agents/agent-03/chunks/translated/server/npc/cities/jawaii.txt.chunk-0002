				next;
				mes "^3355FF你一小口一小口地喝，";
				mes "品味着它浓郁、";
				mes "醇厚的味道。^000000";
				specialeffect2 EF_FIREIVY;
				percentheal -20,0;
				next;
				break;
			case 3:
				mes "[酒保]";
				mes "那么……";
				mes "这杯怎么样……？";
				next;
				mes "[酒保]";
				mes "不如试试";
				mes "^0000FF火焰之吻";
				mes "旋转鸟踢^000000？";
				next;
				mes "[酒保]";
				mes "别被它甜美的香气和漂亮的红色骗了。这是最烈的饮料之一。";

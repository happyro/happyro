				mes "^3355FF1根树枝^000000，用来装订书籍，";
				mes "^3355FF1瓶鱿鱼墨水^000000，用作墨水，";
				mes "^3355FF1个空瓶^000000，用来装鱿鱼墨水。";
				next;
				set SAGE_Q2,0;
				set SAGE_Q,12;
				if(checkquest(2056) != -1) {
					changequest 2056,2051;
				}
				else if(checkquest(2057) != -1) {
					changequest 2057,2051;
				}
				else if(checkquest(2058) != -1) {
					changequest 2058,2051;
				}
				else {
					changequest 2059,2051;
				}
				mes "[卢修斯·凯尔苏斯]";
				mes "带齐这些物品后，我会帮助你写论文。";
				mes "你快完成了。学习很容易，不是吗？";
				close;
			}
			mes "什么，你已经忘了我说的话？";
			mes "真麻烦……这次仔细听。";
			next;
			mes "[卢修斯·凯尔苏斯]";
			mes "5个^3355FF"+getitemname(.@items[0])+"^000000，";
			mes "5个^3355FF"+getitemname(.@items[1])+"^000000，";
			mes "5个^3355FF"+getitemname(.@items[2])+"^000000，";
			close;
		}
		mes "呼噜……呼噜……";
		close;
	}
	else if (SAGE_Q == 12) {
		if (countitem(916) > 0 && countitem(919) > 0 && countitem(1019) > 0 && countitem(1024) > 0 && countitem(713) > 0) {
			delitem 916,1; //Feather_Of_Birds
			delitem 919,1; //Animal's_Skin
			delitem 1019,1; //Wooden_Block
			delitem 1024,1; //Chinese_Ink
			delitem 713,1; //Empty_Bottle
			mes "哼。幸运的小子把物品都带来了。";
			mes "不过我不指望你写出惊世骇俗的论文……";
			next;
			mes "[卢修斯·凯尔苏斯]";
			mes "如果你真的想自己写，我可以让你负责，不过……";
			mes "我会给你一篇天才之作。只要用你的名字抄一份。";
			next;
			mes "[卢修斯·凯尔苏斯]";
			mes "你有意见？随你，那就是我的风格。";
			mes "照我说的做。";
			next;
			mes "..........";
			next;
			mes "....................";
			next;
			mes ".................................";
			next;
			select("……怪物的外形各不相同，");
			mes ".....Monsters vary by physical appearance,";
			select("……并拥有不同的属性。");
			mes "...and possess various elemental properties.";
			select("你必须了解每种怪物的属性，");
			mes "你必须了解每种怪物的属性，";
			select("……并知道某些咒语对不同怪物效果不同。");
			mes "……并知道某些咒语对不同怪物效果不同。";
			select("你必须特别小心圣属性和暗属性怪物。");
			mes "你必须特别小心圣属性和暗属性怪物。";
			select("这些怪物最危险，不过偶尔也很可爱。");
			mes "这些怪物最危险。";
			next;
			mes "..........";
			next;
			mes "....................";
			next;
			mes ".................................";
			next;
			set SAGE_Q,15;
			changequest 2051,2052;
			mes "[卢修斯·凯尔苏斯]";
			mes "完成了吗？好，那就结束了。";
			mes "你再也不能写另一篇论文了，请小心保管这篇。";
			getitem 1550,1; //Book
			next;
			mes "[卢修斯·凯尔苏斯]";
			mes "把这篇杰作给院长看。";
			mes "然后他会让你从学院毕业。再见。";
			close;
		}
		else {
			mes "什么，你确定准备好了吗？不，我不这么认为。";
			mes "好吧……这次仔细听。";
			next;
			mes "[卢修斯·凯尔苏斯]";
			mes "^3355FF1根鸟羽^000000，用作笔，";
			mes "^3355FF1张动物皮^000000，用作纸，";
			mes "^3355FF1根树枝^000000，用来装订书籍，";
			mes "^3355FF1瓶鱿鱼墨水^000000，用作墨水，";
			mes "^3355FF1个空瓶^000000，用来装鱿鱼墨水。";
			next;
			mes "[卢修斯·凯尔苏斯]";
			mes "你做得不错，我想你能顺利完成。";
			mes "去把它们带来。快点。";
			close;
		}
	}
	else if (SAGE_Q == 15) {
		mes "你在这里做什么？去把论文给院长看！";
		mes "别再浪费时间了。";
		next;
		mes "[Lucius Celsus]";
		mes "看来你太闲了。好吧，我给你安排一些任务。";
		mes "哈哈哈，你说不？好吧，快走。";
		close;
	}
	else {
		mes "哇~！我的脑袋快爆炸了！为什么要准备这么多东西？！";
		mes "你是谁？！别打扰我，我很忙！！";
		next;
		mes "[Lucius Celsus]";
		mes "如果你只是想在这里看怪物，随便你……";
		mes "但别问我问题。";
		close;
	}
}

yuno_in03,244,31,3	script	Physics Professor#sa	120,{
	mes "[Aebecee George]";
	if (BaseJob != Job_Mage) {
		if (BaseJob == Job_Sage) {
			mes "嘻嘻，你好！亲爱的，你怎么又来了？";
			mes "哦，我明白了……你终于成为贤者，太兴奋了吗？嘻嘻~";
			next;
			mes "[Aebecee George]";
			mes "嗯，虽然你成了贤者，做的还是同样的事，嘻嘻……我们骨子里都是魔法师！";
			mes "我们比其他职业好多了，因为我们很聪明，你知道吗？";
			next;
			mes "[Aebecee George]";
			mes "好吧，你想聊些什么？";
			mes "哦，亲爱的，别紧张……你的冒险精神去哪了？";
		}
		else if (BaseJob == Job_Novice) {
			mes "哎呀，你真是最可爱的小初心者~";
			next;
			mes "[Aebecee George]";
			mes "你来这里做什么，甜心？只是来看看这里有什么吗？";
			mes "想吃糖吗？糖果，我的宝贝？嘻嘻。";
			next;
			mes "[Aebecee George]";
			mes "哦，天啊……抱歉，我以为还有……";
			mes "不过我有其他点心，你明白我的意思吗？";
		}
		else {
			mes "嘿，嘻嘻，水手，过得怎么样？";
			next;
			mes "[Aebecee George]";
			mes "你来这里参观吗？嗯……？";
			mes "如果不是来办事，那你一定是来……";
			next;
			mes "[Aebecee George]";
			mes "……寻欢作乐。";
			mes "嘿等等！回来~！";
		}
		close;
	}
	if (SAGE_Q == 13) {
		if (SAGE_Q2 == 0) {
			mes "你好~？很高兴见到你，嘻嘻。";
			mes "你是来看我的吗？哦，你是学生！";
			next;
			mes "[Aebecee George]";
			mes "嘻嘻，我是负责你的教授，艾比西·乔治。";
			mes "那么……和我在一起不开心吗，亲爱的？不高兴吗？嘻嘻~";
			next;
			mes "[Aebecee George]";
			mes "不过，在开始上课前，我需要你帮我……一个忙。";
			mes "别害怕，只是很小的忙。嘻嘻~";
			next;
			mes "[Aebecee George]";
			mes "请给我^3355FF30块石头^000000，就这些。";
			mes "不难，对吧？";
			next;
			set SAGE_Q2,1;
			changequest 2049,2060;
			mes "[Aebecee George]";
			mes "不如请盗贼朋友帮忙？";
			mes "带来那些石头后我们就开始上课~ 嘻嘻~";
			close;
		}
		else if (SAGE_Q2 == 1) {
			if (countitem(7049) > 29) {
				mes "哦~ 真甜！你全都带来了~ 谢谢~";
				mes "哦，能等一会儿吗？开始前我需要做点事。嘻嘻~";
				next;
				mes "[Aebecee George]";
				mes "哈库斯·波库斯！！";
				next;
				mes "[Aebecee George]";
				mes "哈库斯~波库斯！！";
				next;
				mes "[Aebecee George]";
				mes "哈~库斯~波~库斯！！";
				next;
				delitem 7049,30; //Stone
				mes "[Aebecee George]";
				mes "嘻嘻，你这调皮的石头~";
				mes "只有3块对我有用。嘻嘻~";
				next;
				mes "[Aebecee George]";
				mes "还有一个忙要请你帮。哦，那是喜悦的泪水吗？";
				mes "哦，我也太兴奋了！嘻嘻~";
				next;
				getitem 991,1; //Crystal_Blue
				getitem 993,1; //Yellow_Live
				getitem 992,1; //Wind_Of_Verdure
				mes "[Aebecee George]";
				mes "我会给你这些元素矿石……但是……不是免费的。";
				mes "哇，别急着走~ 听我说，嘻嘻~";
				set SAGE_Q2,2;
				changequest 2060,2061;
				next;
				mes "[Aebecee George]";
				mes "请用这些物品制作箭矢并带给我，拜托~";
				mes "50支^3355FF水晶箭^000000，";
				mes "50支^3355FF石箭^000000，";
				mes "50支^3355FF风之箭^000000。";
				next;
				mes "[Aebecee George]";
				mes "如果你认识弓箭手朋友，就请他们帮忙。";
				mes "期待再次见到你，嘻嘻~";
				close;
			}
			else {
				mes "你没有全部物品？我还白兴奋了。";
				mes "快去吧，亲爱的，赶快回来~";
				next;
				mes "[Aebecee George]";
				mes "我让你带来^3355FF30块石头^000000。";
				mes "外面有很多，不会太难找~ 嘻嘻。";
				close;
			}
		}
		else if (SAGE_Q2 == 2) {
			if (countitem(1754) > 49 && countitem(1756) > 49 && countitem(1755) > 49) {
				mes "哦~ 真甜！你全都带来了~ 谢谢~";
				mes "那么，我们开始正事吧。嘻嘻~";
				next;
				mes "[Aebecee George]";
				mes "我说一句，你就全部记下来。";
				mes "别忘了给重要句子画线~";
				next;
				mes "[Aebecee George]";
				mes "水属性魔法对火属性非常强。";
				mes "想象强壮性感的消防员用水灭火。哦，好湿！";
				next;
				mes "[Aebecee George]";
				mes "风属性魔法完全压制水属性！哦，是的~";
				mes "想象闪电击中湖泊。哦，我真坏！";
				next;
				mes "[Aebecee George]";
				mes "就力量而言，地属性魔法胜过风属性魔法！呵~~";
				mes "想象风猛烈拍打观景台或恋人小径附近的悬崖。嘻嘻~";
				next;
				mes "[Aebecee George]";
				mes "火属性魔法对地属性很强！嘻嘻~";
				mes "想象在舒适壁炉里燃烧来自大地的木头。躺在熊皮上，置身黑暗~";
				next;
				mes "[Aebecee George]";
				mes "...Oh my gosh! Time flies sooo fast!";
				mes "今天就到这里吧，亲爱的，嘻嘻~";
				next;
				delitem 1754,50; //Crystal_Arrow
				delitem 1756,50; //Stone_Arrow
				delitem 1755,50; //Arrow_Of_Wind
				mes "[Aebecee George]";
				mes "下次上课时，带来^3355FF1份圣水^000000~";
				mes "希望你至少有一个牧师朋友。没有吗？那就去交一个吧。";
				set SAGE_Q2,3;
				changequest 2061,2062;
				close;
			}
			else {
				mes "你在这里做什么，亲爱的……想骗我吗？嘻嘻~";
				mes "希望你没把我给的元素矿石卖掉？真调皮~ 难道不知道钻石是女孩最好的朋友吗？嘻嘻~";
				next;
				mes "[Aebecee George]";
				mes "50 ^3355FFCrystal Arrow^000000,";
				mes "50 ^3355FFStone Arrow^000000,";
				mes "50 ^3355FFWind Arrow^000000.";
				mes "如果你有弓箭手朋友，就请他们帮忙~ 嘻嘻。";
				close;
			}
		}
		else if (SAGE_Q2 == 3) {
			if (countitem(523) > 0) {
				mes "哦~ 真甜！你带来了圣水~ 谢谢亲爱的~";
				mes "哦对了，我们该开始上课了。嘻嘻~";
				next;
				mes "[Aebecee George]";
				mes "和上次一样，我说你就把我说的全部写下来。";
				mes "即使不明白，也装作明白顺着做，好吗？嘻嘻~";
				next;
				mes "[Aebecee George]";
				mes "水属性魔法对风属性很弱！没错~";
				mes "想想泡热水澡时为什么不把电风扇放旁边。哦！真带电！";
				next;
				mes "[Aebecee George]";
				mes "风属性魔法对地属性很弱！";
				mes "想象风无法穿透泥面膜~";
				next;
				mes "[Aebecee George]";
				mes "地属性魔法对火属性很弱！嘻嘻~";
				mes "想象壁炉里燃烧来自大地的木头。躺在熊皮上——哦？我说过了？真糟糕。";
				next;
				mes "[Aebecee George]";
				mes "火属性魔法对水属性很弱！是的~";
				mes "东西烧得滚烫时，最好泼冷水。你同意吗~？";
				next;
				mes "[Aebecee George]";
				mes "哦，下课了~ 嘻嘻。";
				mes "怎么样？学到很多了吗？可以感谢我了，亲爱的！";
				next;
				delitem 523,1; //Holy_Water
				mes "[Aebecee George]";
				mes "好了，就这些。你可以用我教的内容写论文了！";
				mes "嘻嘻~ 是的！我是世界上最好的老师！哦，我燃烧起来了！嘻嘻~";
				set SAGE_Q2,0;
				set SAGE_Q,14;
				changequest 2062,2051;
				next;
				mes "[Aebecee George]";
				mes "好吧，请收集这些物品来写论文，亲爱的~ 嘻嘻~";
				mes "^3355FF1 Feather of Birds^000000 which will be used as a pen,";
				mes "^3355FF1 Animal Skin^000000 which will be used as paper,";
				mes "^3355FF1 Trunk^000000 which will be used to bind a book,";
				mes "^3355FF1 Squid Ink^000000 which will be used as ink,";
				mes "^3355FF1 Empty Bottle^000000 to keep that Squid Ink from splashing.";
				next;
				mes "[Aebecee George]";
				mes "那么出发吧，牛仔，快点回来~ 嘻嘻~";
				close;
			}
			else {
				mes "你在这里做什么，亲爱的……在玩游戏吗？嘻嘻。";
				mes "哦，可怜的亲爱的。你忘了我说的话吗？要我提醒你吗？嘻嘻~";
				next;
				mes "[Aebecee George]";
				mes "^3355FF1 Holy Water^000000,";
				mes "和服事或牧师交朋友不会有坏处……嘻嘻。";
				close;
			}
		}
		else {
			mes "那么……你有时间吗？开玩笑的，女朋友！";
			close;
		}
	}
	else if (SAGE_Q == 14) {
		if (countitem(916) > 0 && countitem(919) > 0 && countitem(1019) > 0 && countitem(1024) > 0 && countitem(713) > 0) {
			delitem 916,1; //Feather_Of_Birds
			delitem 919,1; //Animal's_Skin
			delitem 1019,1; //Wooden_Block
			delitem 1024,1; //Chinese_Ink
			delitem 713,1; //Empty_Bottle
			mes "好~ 现在就是关键时刻~ 嘻嘻~";
			mes "我把知道的一切都教给你了。别紧张，你会没事的~";
			next;
			mes "..........";
			next;
			mes "....................";
			next;
			mes ".................................";
			next;
			mes ".....Magic spells are varied into 4 elements such as";
			switch(select("水、地、火、风。:地、水、火、风。:水、风、地、火。")) {
			case 1:
				mes "水、地、火、风。";
				break;
			case 2:
				mes "地、水、火、风。";
				break;
			case 3:
				mes "水、风、地、火。";
				break;
			}
			mes "每种属性都有相克属性，";
			switch(select("风属性魔法克制水:水属性魔法克制火:火属性魔法克制地")) {
			case 1:
				mes "风属性魔法克制水属性";
				break;
			case 2:
				mes "水属性魔法克制火属性";
				break;
			case 3:
				mes "火属性魔法克制地属性";
				break;
			}
			mes "地属性魔法克制风属性。";
			switch(select("但反过来并不成立:地属性武器也遵循此理论:属性因怪物种类而异")) {
			case 1:
				mes "但反过来并不成立";
				break;
			case 2:
				mes "地属性武器也遵循此理论";
				break;
			case 3:
				mes "属性因怪物种类而异";
				break;
			}
			switch(select("必须了解能力的极限。:根据情况或地点使用不同属性。:据说红色药水尝起来像草莓。")) {
			case 1:
				mes "必须了解能力的极限。";
				break;
			case 2:
				mes "必须根据情况或地点使用不同属性。";
				break;
			case 3:
				mes "据说红色药水尝起来像草莓。";
				break;
			}
			next;
			switch(select("最可爱的NPC是普隆德拉的优比:据说红色药水由波利制成:你永远不知道魔法的极限")) {
			case 1:
				mes "最可爱的NPC是普隆德拉的优比";
				break;
			case 2:
				mes "据说红色药水由波利制成";
				break;
			case 3:
				mes "你永远不知道魔法的极限";
				break;
			}
			switch(select("梦罗克的女商人和优比一样可爱。:没人知道红色药水为什么像草莓。:不建议沉迷魔法咒语。")) {
			case 1:
				mes "梦罗克的女商人和优比一样可爱。";
				break;
			case 2:
				mes "没人知道红色药水为什么像草莓。";
				break;
			case 3:
				mes "不建议沉迷魔法咒语。";
				break;
			}
			switch(select("如果我有兔女郎发带，:那么白色药水是什么味道？:只使用合适的魔法并休息")) {
			case 1:
				mes "如果我有兔女郎发带，";
				break;
			case 2:
				mes "那么白色药水是什么味道？";
				break;
			case 3:
				mes "只使用合适的魔法并休息";
				break;
			}
			switch(select("我想把它作为礼物送给她。:我完全无法想象味道。:能保证你安全战斗。")) {
			case 1:
				mes "我想把它作为礼物送给她。";
				break;
			case 2:
				mes "我完全无法想象味道。";
				break;
			case 3:
				mes "能保证你安全战斗。";
				break;
			}
			switch(select("虽然兔女郎发带最适合服事职业:我喜欢这种刺激感:与不同职业的人组队")) {
			case 1:

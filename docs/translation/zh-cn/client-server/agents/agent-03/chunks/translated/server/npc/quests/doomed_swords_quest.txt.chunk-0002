			mes "[莫夫]";
			mes "听着……";
			mes "如果你只是";
			mes "站在那里";
			mes "在我工作时";
			mes "盯着我的脖子，";
			mes "那不如做点有用的事。";
			next;
			mes "[莫克]";
			mes "给我带点";
			mes "零食之类的，";
			mes "否则在我完成前";
			mes "赶紧滚出去！";
			close;
		case 6:
			mes ".........";
			mes "............";
			mes "...............";
			next;
			mes "^3355FF莫夫已经陷入";
			mes "沉睡。^000000";
			close;
		case 7:
			mes "[莫夫]";
			mes "不……";
			mes "还没完成。";
			mes "就像上次一样，";
			mes "你问时我也这么说。";
			mes "只是…… Wait...";
			close;
		case 8:
			mes ".........";
			mes "............";
			mes "...............";
			next;
			mes "^3355FF莫夫已经陷入";
			mes "非常安稳的";
			mes "睡眠，似乎";
			mes "享受其中。^000000";
			close;
		case 9:

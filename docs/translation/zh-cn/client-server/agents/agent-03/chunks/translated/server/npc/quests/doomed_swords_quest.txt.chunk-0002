			next;
			mes "[莫夫]";
			mes "于是……";
			mes "光明之神";
			mes "就是这样被杀死的。";
			mes "死于洛基的诡计和";
			mes "盲者的愚行。";
			mes "这就是米斯特汀的故事。";
			next;
			mes "[莫夫]";
			mes "现在，如果你碰巧";
			mes "从封印中得到米斯特汀";
			mes "这把诅咒之剑，它不会";
			mes "像原版那样强大，原版曾";
			mes "杀死过一位";
			mes "神。它无法复制……";
			next;
			mes "[莫夫]";
			mes "不过，仿制品";
			mes "非常强大，你";
			mes "必须确保负责任地使用";
			mes "它。现在，我知道";
			mes "你一定对我花了这么久";
			mes "感到不满……";
			next;
			mes "[莫夫]";
			mes "请理解";
			mes "我现在年纪很大，";
			mes "制作五芒星并不";
			mes "容易。总之，我的部分完成了。";
			mes "现在你得找到休伊，";
			mes "我最小的弟弟。";
			next;
			mes "[莫夫]";
			mes "休伊一直在四处旅行，";
			mes "但我最后听说他";
			mes "在摩洛克。如果你能找到他，";
			mes "他可以替你完成";
			mes "这个五芒星。好了，";
			mes "保重，祝你好运。";

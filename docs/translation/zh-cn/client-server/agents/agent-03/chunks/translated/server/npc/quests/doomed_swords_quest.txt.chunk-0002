		mes "黄色药水来";
		mes "缓解宿醉。";
		mes "快点，我真的需要药！";
		close;
	}
}

morocc,248,159,4	script	Young Man#magum1	86,{
	if (dmdswrd_Q == 39) {
		mes "[休伊]";
		mes "打扰一下……";
		mes "呃，你需要";
		mes "什么吗？你看起来";
		mes "像是有";
		mes "问题要问我。";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "其实我在找";
		mes "一个叫休伊的人。";
		mes "听说只有他";
		mes "能帮我完成";
		mes "这个……嗯……你知道";
		mes "在哪里能找到他吗？";
		next;
		mes "[休伊]";
		mes "是、是的。我、我是休伊。";
		mes "但你为什么找";
		mes "我？哦！你是我某位";
		mes "兄弟派来的";
		mes "使者吗？我已经很久没";
		mes "听到他们的消息了。";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "其实我想";
		mes "得到一把诅咒之剑。";
		mes "为此，我已经拿到";
		mes "穆里涅尔的封印，";
		mes "你的兄弟们也已经";
		mes "开始制作这个五芒星。";
		next;
		mes "[休伊]";
		mes "你是认真的吗？";
		mes "你一路走到这里就是为了";
		mes "得到一把被诅咒的";
		mes "刀刃？嗯，可以让我";
		mes "看看五芒星吗？哦，";
		mes "我的兄弟们做得真好！";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "啊，是的。给你。";
		next;
		mes "[休伊]";
		mes "我不知道你是否能";
		mes "欣赏它，但这个";
		mes "五芒星的工艺真的很棒！";
		mes "现在，如果我的";
		mes "哥哥们已经帮助了你，我也会这样做。";
		next;
		mes "[休伊]";
		mes "我的哥哥们甚至是比我";
		mes "更好的铁匠，";
		mes "所以既然你能说服";
		mes "他们帮助你，我也没有";
		mes "理由拒绝。况且，如果我不帮……";
		next;
		mes "[休伊]";
		mes "……那我哥哥的工作";
		mes "就白费了。";
		mes "而且……他们可能会";
		mes "来找我。尤其是莫夫。哦，对了！材料！";
		mes "我需要这些来完成五芒星！";
		next;
		mes "[休伊]";
		mes "请带给我";
		mes "^FF00009颗红宝石^000000、";
		mes "^FF00006把黑暗之刃^000000、";
		mes "^FF00009把血腥之刃^000000，和";
		mes "^FF00001个洛基的耳语^000000。";
		next;
		mes "[休伊]";
		mes "你收集";
		mes "必要物品时，我会";
		mes "完成准备工作。";
		mes "哦，还要带来^FF0000准确的";
		mes "数量^000000——^FF0000不能多^000000，^FF0000不能少^000000。";
		mes "好了，回头见~";
		set dmdswrd_Q,40;
		close;
	}
	else if (dmdswrd_Q == 40) {
		if (countitem(7024) == 9 && countitem(7023) == 6 && countitem(723) == 9 && countitem(7019) == 1) {
			mes "[休伊]";
			mes "哦，你回来了。你带齐";
			mes "五芒星需要的";
			mes "所有东西了吗？";
			mes "数量准确吗？嗯……";
			mes "啊！完美！干得好~";
			next;
			mes "[休伊]";
			mes "请稍等，";
			mes "我完成这个五芒星？";
			mes "这需要一点时间，";
			mes "但相信我，我们";
			mes "快完成了。你所有的努力";
			mes "很快会有回报~";
			delitem 7024,9; //Bloody_Edge
			delitem 7023,6; //Blade_Lost_In_Darkness
			delitem 723,9; //Cardinal_Jewel
			delitem 7019,1; //Loki's_Whispers

		mes "不能多也不能少。如果有";
		mes "多余的物品，就放进仓库吧？";
		next;
		mes "[休伊]";
		mes "请带给我";
		mes "^FF00009颗红宝石^000000、";
		mes "^FF00006把黑暗之刃^000000、";
		mes "^FF00009把血腥之刃^000000，和";
		mes "^FF00001个洛基的耳语^000000。";
		mes "好吧，我会等着~";
		close;
	}
	else if (dmdswrd_Q == 41) {
		mes "[休伊]";
		mes "嘿，你来得正好，";
		mes "我刚完成了";
		mes "用于解封一把";
		mes "诅咒之剑的五芒星。";
		mes "只剩最后一步……";
		next;
		mes "[休伊]";
		mes "把穆里涅尔的封印放到五芒星上？这样会解开";
		mes "封印，让最适合你的诅咒之剑显现。";
		mes "很快，牙突、米斯特汀、";
		mes "或处刑者就会属于你……";
		next;
		mes "^3355FF你小心地将";
		mes "穆里涅尔的封印放到";
		mes "五芒星上。五芒星的几处";
		mes "立刻开始";
		mes "安静地脉动，发出";
		mes "柔和的光芒。^000000";
		next;
		mes "[休伊]";
		mes "开始了……开始了！五芒星的";
		mes "各个部分";
		mes "正按";
		mes "完成顺序激活。";
		mes "现在亮起的部分";
		mes "一定是沃克的作品……";
		next;
		mes "^3355FF突然，五芒星的另一部分";
		mes "被激活，";
		mes "五芒星的部分";
		mes "不稳定地闪烁着";
		mes "强烈而摇曳的光。^000000";
		next;
		mes "[休伊]";
		mes "那一定是……";
		mes "莫夫一定完成了";
		mes "那部分。好了，当";
		mes "光芒稳定，";
		mes "整个五芒星";
		mes "发光时，就准备好了。";
		next;
		mes "^3355FF未激活的部分";
		mes "燃烧起来，";
		mes "整个五芒星";
		mes "散发出温暖而充沛的光芒。^000000";
		next;
		mes "[休伊]";
		mes "好了，这很重要！";
		mes "一把诅咒之剑";
		mes "很快就会显现。";
		mes "当你看到光中的";
		mes "剑时，快点抓住它！ ";
		next;
		mes "[休伊]";
		mes "等等，你能——？";
		mes "在那里，我看到了！现在";
		mes "快点拿走！它属于你！";
		next;
		set .@random,rand(1,10);
		if (.@random >= 1 && .@random <= 5) {
			callsub S_GetSword,1237,0,1,42;
			getitem 1237,1; //Grimtooth_
			close;
		}
		else if (.@random >= 6 && .@random <= 8) {
			callsub S_GetSword,1138,1,1,43;
			getitem 1138,1; //Mysteltainn_
			close;
		}
		else {
			callsub S_GetSword,1169,2,1,44;
			getitem 1169,1; //Executioner_
			close;
		}
	}
	else if (dmdswrd_Q == 42) {
		callsub S_GetSword,1237,0,0,0;
		getitem 1237,1; //Grimtooth_
		close;
	}
	else if (dmdswrd_Q == 43) {
		callsub S_GetSword,1138,1,0,0;

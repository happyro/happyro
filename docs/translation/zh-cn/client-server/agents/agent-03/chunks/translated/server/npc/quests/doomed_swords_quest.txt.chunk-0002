			mes "如果我";
			mes "搞砸这个五芒星，";
			mes "你就得从头开始吗？";
			mes "没错，就是这样~";
			close;
		case 3:
			mes "[莫夫]";
			mes "还……没……完成。";
			mes "完成时自然会完成，";
			mes "明白吗？你不如";
			mes "去散散步之类的";
			mes "消磨时间，嗯？";
			close;
		case 4:
			mes "[莫夫]";
			mes "是啊，你知道吗？";
			mes "又该休息了。";
			mes "让我休息一下酸痛的手，";
			mes "喝一瓶你带来的";
			mes "黄色药水，";
			mes "嗯，这是个好主意。";

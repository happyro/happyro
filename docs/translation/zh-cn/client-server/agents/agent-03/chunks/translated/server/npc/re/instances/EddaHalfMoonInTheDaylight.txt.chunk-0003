	mes "[" + strcharinfo(0) + "]";
	mes "在教皇平安回来前，我负责照顾她。";
	mes "我会陪她一起去。";
	unittalk getcharid(3), "我会陪她一起去。";
	next;
	cutin "loo_sim",0;
	mes "[Luwmin]";
	mes "......";
	next;
	cutin "pop_nor", 2;
	mes "[Pope]";
	mes "我们走吧。";
	npctalk "哥哥……", instance_npcname("Pope#1hmoon06");
	next;
	cutin "loo_nor",0;
	mes "[Luwmin]";
	mes "这些衣服太显眼了。给你换套衣服吧。";
	next;
	cutin "pop_nor", 2;
	mes "[Pope]";
	mes "换衣服……？";
	next;
	cutin "loo_nor",0;
	mes "[Luwmin]";
	mes "普通孩子通常……都会穿这个。";
	next;
	cutin "pop_nor", 2;
	mes "[Pope]";
	mes "普通衣服？";
	next;
	mes "[Pope]";
	mes "好。";
	next;
	cutin "pop_nor", 255;
	disablenpc();
	sleep2 2000;
	enablenpc instance_npcname("Pope#1hmoon07");
	cutin "pops_bug", 2;
	mes "[Pope]";
	mes "毛茸茸的……";
	next;
	mes "[Pope]";
	mes "这似乎有点奇怪……";
	next;
	mes "[" + strcharinfo(0) + "]";
	mes "不，一点也不。";
	next;
	cutin "Loo_smi",0;
	mes "[Luwmin]";
	mes "真的很漂亮。";
	next;
	cutin "pops_lau", 2;
	mes "[Pope]";
	mes "那太好了。";
	next;
	cutin "Loo_smi",0;
	mes "[Luwmin]";
	mes "现在走吧。爸爸妈妈在等我们。";
	next;
	cutin "pops_lau", 2;
	mes "[Pope]";
	mes "好的。";
	close2;
	cutin "pops_lau", 255;
	setpcblock PCBLOCK_NPC, true;
	disablenpc instance_npcname("Pope#1hmoon07");
	disablenpc instance_npcname("Luwmin#1hmoon01");
	sleep2 2000;
	enablenpc instance_npcname("Pope#1hmoon08");
	emotion ET_THINK, getnpcid(0, instance_npcname("Pope#1hmoon08"));
	sleep2 2000;
	unittalk getcharid(3), "Pope? Didn't you just go out?";
	sleep2 2000;
	emotion ET_THINK, getnpcid(0, instance_npcname("Pope#1hmoon08"));
	sleep2 2000;
	specialeffect EF_HITBODY, AREA, instance_npcname("Pope#1hmoon08");
	enablenpc instance_npcname("#1hmoond07");
	disablenpc instance_npcname("Pope#1hmoon08");
	unittalk getcharid(3), "I may be mistaken ... but I have to follow the Pope.";
	if ('progress == 4)
		'progress = 5;
	setpcblock PCBLOCK_NPC, false;
	end;
}


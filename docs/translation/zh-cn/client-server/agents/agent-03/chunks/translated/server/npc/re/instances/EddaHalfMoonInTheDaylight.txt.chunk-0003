1@pop2,117,221,3	script	Pope#2hmoon01	POPE_MD_MERC_CASUAL,{
	if ('progress != 5)
		end;
	'progress = 6;
	setpcblock PCBLOCK_NPC, true;
	npctalk "在哪里……在哪里？", instance_npcname("Luwmin#2hmoon01");
	sleep2 2000;
	unittalk getcharid(3), "...This is near High Priest Zhed's residence.";
	sleep2 2000;
	npctalk "泽德？那我在这里就安全了。";
	sleep2 2000;
	npctalk "来不及了。我们得快点。", instance_npcname("Luwmin#2hmoon01");
	sleep2 2000;
	disablenpc instance_npcname("Luwmin#2hmoon01");
	sleep2 1000;
	npctalk "我们走吧，哥哥。";
	sleep2 500;
	enablenpc instance_npcname("Pope#2hmoon02");
	enablenpc instance_npcname("Luwmin#2hmoon02");
	disablenpc();
	setpcblock PCBLOCK_NPC, false;
	end;
}

1@pop2,63,237,3	script(DISABLED)	Pope#2hmoon02	4_F_ARUNA_POP2,{
	if ('progress != 6)
		end;
	mes "[Luwmin]";
	mes "这里是神父的住所，对吧？";
	next;
	cutin "loo_nor", 255;
	mes "[" + strcharinfo(0) + "]";
	mes "我会调查这个人的住所周边。";
	next;
	enablenpc instance_npcname("Guard#2hmoon01");
	enablenpc instance_npcname("Guard#2hmoon02");
	mes "[Guards]";
	mes "站住！谁在那里？";
	next;
	mes "[" + strcharinfo(0) + "]";
	mes "我们没有恶意。";
	next;
	mes "[Guards]";
	mes "哦？报上身份！";
	npctalk "谁在那里！", instance_npcname("Guard#2hmoon02");
	next;
	mes "[Guards]";
	mes "花园里发现入侵者！";
	next;
	enablenpc instance_npcname("High Priest Zhed#2hmoon");
	cutin "ra_gman2", 0;
	mes "[High Priest Zhed]";
	mes "该死，这里怎么这么吵。发生什么了……？";
	next;
	cutin "RA_GMAN2", 255;
	mes "[Guards]";
	mes "大祭司，敌人派了孩子刺客来伤害你！";
	next;
	mes "[Guards]";
	mes "入侵者闯入宅邸庭院了！！";
	next;
	mes "[Guards]";
	mes "我们会处理这个情况。";
	next;
	cutin "ra_gman2", 0;
	mes "[High Priest Zhed]";
	mes "教、教皇，你不是教皇吗？";
	npctalk "教、教皇，你不是教皇吗？", instance_npcname("High Priest Zhed#2hmoon");
	next;
	cutin "pops_sim", 2;
	mes "[Pope]";
	mes "啊……";
	npctalk "啊……", instance_npcname("Pope#2hmoon02");
	next;
	cutin "ra_gman2", 0;
	mes "[High Priest Zhed]";
	mes "你从哪里来？寺庙？你对教皇做了什么？";
	next;
	mes "[" + strcharinfo(0) + "]";
	mes "我在护送教皇。";
	unittalk getcharid(3), "I am in charge.";
	next;
	mes "[High Priest Zhed]";
	mes "你是……冒险者？";
	next;
	mes "[High Priest Zhed]";
	mes "不过教皇不该离开寺庙。我们有严格的规章。";
	next;
	mes "[High Priest Zhed]";
	mes "很多时候，狂热信徒会擅自行动……趁还来得及，请回寺庙。";
	next;
	mes "[High Priest Zhed]";
	mes "尼伦不会希望这样……";
	next;
	mes "[High Priest Zhed]";
	mes "如果教皇出事，不只是她个人的问题，而是整个阿鲁纳佩尔兹国民的问题！";
	next;
	cutin "pops_sim", 2;
	mes "[Pope]";
	mes "我只是女神的容器吗？";
	next;
	mes "[Pope]";
	mes "你把我当成普通容器吗？";
	next;
	cutin "ra_gman2", 0;
	mes "[High Priest Zhed]";
	mes "阿鲁纳佩尔兹的国民从教皇身上获得安慰、鼓舞和希望。";
	next;
	mes "[High Priest Zhed]";
	mes "确保教皇安全是我们神父的职责。";
	next;
	cutin "pops_sim", 2;
	mes "[Pope]";
	mes "但是泽德……暂时，哪怕只是一会儿。";
	next;
	mes "[Pope]";
	mes "请帮帮我。请理解……";
	npctalk "我会再问你一次……", instance_npcname("Pope#2hmoon02");
	next;
	cutin "ra_gman2", 0;
	mes "[High Priest Zhed]";
	mes "我不会让你的安全受到任何风险。请允许我护送你回寺庙。";
	next;
	cutin "LOO_ANG", 0;
	mes "[Luwmin]";
	mes "你才是真正的危险……把小女孩关进可怕的寺庙里！";
	next;
	cutin "ra_gman2", 0;
	mes "[High Priest Zhed]";
	mes "这张脸……还有眼睛。你是鲁温敏？";
	next;
	mes "[High Priest Zhed]";
	mes "你、你……怎么出来的？";
	npctalk "你、你……怎么出来的？", instance_npcname("High Priest Zhed#2hmoon");
	next;
	cutin "loo_smi", 0;
	mes "[Luwmin]";
	mes "我……";
	next;
	cutin "ra_gman2", 0;
	mes "[High Priest Zhed]";
	mes "守卫，抓住那个男孩！";
	next;
	cutin "loo_smi", 0;
	mes "[Luwmin]";
	mes "我们最好在这里分散甩掉他们。回村庄集合。";
	sleep2 1000;
	cutin "loo_smi", 255;
	disablenpc instance_npcname("Luwmin#2hmoon02");
	next;
	cutin "pops_sim", 2;
	mes "[Pope]";
	mes "这就像……";
	npctalk "这就像……", instance_npcname("Pope#2hmoon02");
	next;
	cutin "ra_gman2", 0;
	mes "[High Priest Zhed]";
	mes "教皇，那个男孩在那边……？";
	next;
	cutin "pops_sim", 2;
	mes "[Pope]";
	mes "那个人……";
	next;
	cutin "pops_sim", 255;
	instance_announce 0, "Guard: The Pope is here!", bc_map, "0xFFFF00";
	sleep2 1000;
	instance_announce 0, "Guard: Over here! Quick!!!", bc_map, "0xFFFF00";
	sleep2 3000;
	cutin "ra_gman2", 0;
	mes "[High Priest Zhed]";
	mes "教皇，尼伦同意你偷偷离开寺庙吗？";
	next;
	cutin "pops_sim", 2;
	mes "[Pope]";
	mes "泽德！我没有放弃职责。只是暂时……求你！就暂时一会儿……";
	next;
	cutin "ra_gman2", 0;
	mes "[High Priest Zhed]";
	mes "我们不能再浪费时间待在寺庙之外。我会亲自带你回去。";
	next;
	cutin "pops_sim", 2;
	mes "[Pope]";
	mes "我讨厌这样。";
	next;
	cutin "ra_gman2", 0;
	mes "[High Priest Zhed]";
	mes "教皇，你该走了。";
	next;
	cutin "pops_sim", 2;
	mes "[Pope]";
	mes "我讨厌这样！我不走！！！";
	npctalk "我讨厌这样！", instance_npcname("Pope#2hmoon02");
	next;
	cutin "pops_sim", 255;
	enablenpc instance_npcname("Guard#2hmoon03");
	enablenpc instance_npcname("Guard#2hmoon04");
	enablenpc instance_npcname("Guard#2hmoon05");
	enablenpc instance_npcname("Guard#2hmoon06");
	enablenpc instance_npcname("Guard#2hmoon07");
	enablenpc instance_npcname("Guard#2hmoon08");
	mes "[Guards]";
	mes "教皇在这里！";
	npctalk "教皇在这里", instance_npcname("Guard#2hmoon03");
	next;
	mes "[Guards]";
	mes "教皇，请不要反抗。我们只是在履行职责。";
	next;
	cutin "pops_sim", 2;
	mes "[Pope]";
	mes "不，我现在不走！";
	next;
	cutin "pops_sim", 255;
	mes "[Guards]";
	mes "教皇！你必须和我们一起走！";
	npctalk "教皇！你必须和我们一起走！", instance_npcname("Guard#2hmoon03");
	next;
	cutin "pops_sim", 2;
	mes "[Pope]";
	mes "我讨厌，讨厌这样！！";
	npctalk "我讨厌，讨厌这样！！", instance_npcname("Pope#2hmoon02");
	specialeffect EF_MAGICCRASHER, AREA, instance_npcname("Pope#2hmoon02");
	next;
	cutin "pops_sim", 255;
	mes "[" + strcharinfo(0) + "]";
	mes "让教皇平静离开。否则我会采取强制手段。";
	next;
	mes "[Guards]";
	mes "投降！你只是个普通冒险者！";
	npctalk "你只是个普通冒险者！", instance_npcname("Guard#2hmoon07");
	next;
	mes "[Guards]";
	mes "外人不该插手我们的事！";
	npctalk "外人不该插手我们的事！", instance_npcname("Guard#2hmoon05");
	sleep2 500;
	npctalk "你们所有人！闭嘴！", instance_npcname("Guard#2hmoon04");
	next;
	mes "[Guards]";
	mes "冒险者是敌对目标。格杀勿论！";
	next;
	mes "[Guards]";
	mes "记住，不要伤害教皇！";
	next;
	mes "[Guards]";
	mes "准备好了吗？";
	next;
	mes "[Guards]";
	mes "站住！！";
	next;
	mes "[" + strcharinfo(0) + "]";
	mes "教皇，过来。";
	for ( .@i = 1; .@i <= 8; ++.@i ) {
		npctalk "站住！！", instance_npcname("Guard#2hmoon0" + .@i);
		disablenpc instance_npcname("Guard#2hmoon0" + .@i);
	}
	disablenpc instance_npcname("High Priest Zhed#2hmoon");
	disablenpc instance_npcname("Pope#2hmoon02");
	if ('mode == 1)
		mercenary_create 3569,1800000; //POPE_MD_H_MERC_NORMAL
	else
		mercenary_create 3570,1800000; //POPE_MD_H_MERC_CASUAL
	sleep2 1000;
	instance_announce 0, "Guard: Pope, you must return with us!", bc_map, "0xFFFF00";
	donpcevent instance_npcname("#mob2hmoon") + "::OnStart";
	if ('progress == 6)
		'progress = 7;
	close3;
}

1@pop2,69,158,3	script(DISABLED)	Pope#2hmoon03	4_F_ARUNA_POP2,{
	if ('progress != 7)
		end;
	'progress = 8;
	setpcblock PCBLOCK_NPC, true;
	npctalk "非常感谢。", instance_npcname("Pope#2hmoon03");
	sleep2 1000;
	unittalk getcharid(3), "It's nothing. I've seen worse.";
	sleep2 1000;
	npctalk "嗯？我会在那里等你。", instance_npcname("Pope#2hmoon03");
	sleep2 1000;
	unittalk getcharid(3), "Okay. I hope you weren't disturbed by that incident earlier.";
	sleep2 1000;
	npctalk "别担心。我没事。", instance_npcname("Pope#2hmoon03");
	sleep2 1000;
	enablenpc instance_npcname("#2hmoond01");
	disablenpc instance_npcname("Pope#2hmoon03");
	enablenpc instance_npcname("Pope#2hmoon04");
	enablenpc instance_npcname("Luwmin#2hmoon03");
	enablenpc instance_npcname("Puppy#2hmoon01");
	setpcblock PCBLOCK_NPC, false;
	end;
}

1@pop2,56,116,5	script(DISABLED)	Pope#2hmoon04	4_F_ARUNA_POP2,{
	if ('progress != 8)
		end;
	mes "[Luwmin]";
	mes "你为什么这么晚？";
	npctalk "汪！！", instance_npcname("Puppy#2hmoon01");
	next;
	cutin "pops_smi", 2;
	mes "[Pope]";
	mes "小狗？";
	next;
	cutin "loo_nor", 0;
	mes "[Luwmin]";
	mes "是的，我发现它没有主人，四处游荡……";
	next;
	cutin "pops_lau", 2;
	mes "[Pope]";
	mes "好可爱！";
	next;
	cutin "LOO_SMI", 0;
	mes "[Luwmin]";
	mes "我想你也许会有兴趣养一只？";
	next;
	cutin "pops_lau", 2;
	mes "[Pope]";
	mes "当然！我们一起把它当宠物养吧？";
	next;
	cutin "loo_nor", 0;
	mes "[Luwmin]";
	mes "去让爸爸妈妈同意吧。";
	next;
	cutin "pops_lau", 2;
	mes "[Pope]";
	mes "好！";
	npctalk "你叫什么名字？", instance_npcname("Pope#2hmoon04");
	next;
	cutin "pops_lau", 255;
	enablenpc instance_npcname("Friend#2hmoon01");
	mes "[Friend]";
	mes "你要来吗？";
	npctalk "你要来吗？", instance_npcname("Friend#2hmoon01");
	next;
	enablenpc instance_npcname("Friend#2hmoon02");
	sleep2 1000;
	enablenpc instance_npcname("Friend#2hmoon03");
	mes "[Friend]";
	mes "我以为你今天不来了。";
	npctalk "我以为你今天不来了。", instance_npcname("Friend#2hmoon02");
	next;
	cutin "loo_smi", 0;
	mes "[Luwmin]";
	mes "我们……刚才正忙着呢。";
	next;
	cutin "loo_smi", 255;
	mes "[Friend]";
	mes "这是难得的机会，我们一起玩吧。然后去彼此家里做客~";
	next;
	mes "[Friend]";
	mes "好，就这么做吧。";
	npctalk "好，就这么做吧。", instance_npcname("Friend#2hmoon03");
	next;
	mes "[Friend]";
	mes "我们先回家怎么样？";
	next;
	cutin "pops_lau", 2;
	mes "[Pope]";
	mes "好！！！";
	next;
	cutin "loo_smi", 0;

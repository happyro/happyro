			next;
			if (select( "Accept", "Refuse" ) == 2) {
				mes .@npc_name$;
				mes "这是互惠互利的，你为什么拒绝……";
				close;
			}
			setquest 8662;
			mes .@npc_name$;
			mes "我喜欢，我喜欢。";
			mes "我去确认这里的数量控制是否足够。";
			close;
		case 2:
			mes .@npc_name$;
			mes "这里最近的地方是^0033FF拉赫^000000，";
			mes "如果你有" + .@item_name$ + "，请给我一个……我就传送你过去。";
			mes "哈~这东西最近很流行，可我没法去买。";
			next;
			if (select( "Give me 1 " + .@item_name$ + ", Rachel", "No" ) == 2) {
				mes .@npc_name$;
				mes "哦……那我该怎么办？不行。";
				mes "什么时候再试呢……";
				close;
			}
			if (countitem(1000374) < 1) {
				mes .@npc_name$;
				mes "你似乎没有" + .@item_name$ + "？";
				mes "我会继续站岗……抱歉。";
				close;
			}
			delitem 1000374,1;	// Brilliant_Soda
			warp "rachel",113,136;
			end;
		case 3:
			mes .@npc_name$;
			mes "这是互惠互利的，你为什么拒绝……";
			close;
		}
		end;
	case 0:
	case 1:
		mes .@npc_name$;
		mes "请在附近击杀 80 只怪物。";
		mes "...Yes? Mobility service?";
		next;
		mes .@npc_name$;
		mes "这里最近的地方是^0033FF拉赫^000000，";
		mes "如果你有" + .@item_name$ + "，请给我一个……我就传送你过去。";
		mes "哈~这东西最近很流行，可我没法去买。";
		next;
		if (select( "Give me 1 " + .@item_name$ + ", Rachel", "No" ) == 2) {
			mes .@npc_name$;
			mes "啊……那我该怎么办？";
			mes "什么时候再试呢……";
			close;
		}
		if (countitem(1000374) < 1) {
			mes .@npc_name$;
			mes "你似乎没有" + .@item_name$ + "？";
			mes "我会继续站岗……抱歉。";
			close;
		}
		delitem 1000374,1;	// Brilliant_Soda
		warp "rachel",113,136;
		end;
	case 2:
		mes .@npc_name$;
		mes "啊，冒险者！我已经充分看到你的表现了。辛苦你了。";
		next;
		mes .@npc_name$;
		mes "我觉得任何事情都要掌握适当的量，对吧？";
		getexp 166760,157960;
		erasequest 8662;
		setquest 8661;
		close;
	}
	end;

OnInit:
	setunittitle getnpcid(0), "<Juno Monster Society>";

	questinfo( QTYPE_DAILYQUEST, QMARK_YELLOW, "BaseLevel >= 88 && checkquest(8662,HUNTING) == -1 && checkquest(8661,PLAYTIME) == -1" );

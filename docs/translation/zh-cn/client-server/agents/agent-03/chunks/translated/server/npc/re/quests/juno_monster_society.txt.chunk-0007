		mes "真的很不错。我们正在请路过的冒险者调查怪物讨伐情况，怎么样？";
		.@skip = true;
		break;
	case 2:
		erasequest 8661;
		break;
	}
	switch( checkquest(8662,HUNTING) ) {
	case -1:
		if (!.@skip) {
			mes .@npc_name$;
			mes "你好。你今天来了！";
			mes "我正在请路过的冒险者调查怪物讨伐情况，怎么样？";
		}

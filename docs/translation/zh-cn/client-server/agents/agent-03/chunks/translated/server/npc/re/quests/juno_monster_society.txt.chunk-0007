}

// note: all mobs increase the hunt count
ve_fild01,354,280,3	script	Map Examiner Yirun Seo#suiroon	4_F_SISTER,{
	.@npc_name$ = "[" + strnpcinfo(1) + "]";
	.@item_name$ = getitemname(1000374);

	if (BaseLevel < 90) {
		mes .@npc_name$;
		mes "朱诺怪物协会正在执行讨伐任务。不过你似乎还太弱，无法执行任务。";
		close;
	}
	switch( checkquest(3482,PLAYTIME) ) {
	case -1:
		break;
	case 0:
	case 1:
		mes .@npc_name$;
		mes "啊，今天的讨伐就到这里！";
		next;
		mes .@npc_name$;
		mes "明天再来帮忙讨伐怪物的话，我会很感激！！";
		next;
		if (select( "Send " + .@item_name$ + ".", "Do not pass." ) == 2)
			end;
		if (countitem(1000374) < 3) {
			mes " - Requires 3 " + .@item_name$ + ". - ";
			close;
		}
		delitem 1000374,3;	// Brilliant_Soda
		erasequest 3482;
		mes .@npc_name$;
		mes "啊~！！太感谢了~我刚好非常口渴~";
		next;
		mes .@npc_name$;
		mes "咕噜~咕噜~~~";
		next;
		specialeffect EF_FLASHER;
		mes .@npc_name$;
		mes " huh……这浓烈的味道……！";
		next;
		mes .@npc_name$;
		mes "呃……你对我来说是新人，等一下。我也要喝一点，过一会儿再和我说话好吗？";
		close;
	case 2:
		erasequest 3482;
		break;
	}
	switch( checkquest(3481,HUNTING) ) {
	case -1:
		mes .@npc_name$;
		mes "你好！！我叫徐伊伦，是朱诺怪物协会派来的地图检查员！";
		next;
		switch( select( "Receive a subjugation quest.", "Teleport to a nearby city.", "Ask about a subjugation quest.", "Come next." ) ) {
		case 1:
			mes .@npc_name$;
			mes "哦，你想接委托吗？";
			next;
			mes .@npc_name$;
			mes "你只需要在我所在的这片原野击杀 80 只怪物。";
			next;
			setquest 3481;
			mes .@npc_name$;
			mes "那我等你，希望你能平安回来。";
			close;
		case 2:
			mes .@npc_name$;
			mes "这里最近的城市是艾因布洛克！";
			next;
			mes .@npc_name$;
			mes "给我一个" + .@item_name$ + "，我马上就送你过去！";
			next;
			if (select( "Move", "Do not move" ) == 2) {
				mes .@npc_name$;
				mes "好的，需要传送就告诉我！！";
				close;
			}
			if (countitem(1000374) < 1) {
				mes .@npc_name$;
				mes "喂，你没有" + .@item_name$ + "吗~";
				next;
				mes .@npc_name$;
				mes "传送需要 1 个" + .@item_name$ + "。";
				close;
			}
			mes .@npc_name$;
			mes "好的！现在就为你传送！！";
			close2;
			delitem 1000374,1;	// Brilliant_Soda
			warp "veins",146,32;
			end;
		case 3:
			mes .@npc_name$;
			mes "不久前，人们发现了怪物群落扩大的现象。";
			next;
			mes .@npc_name$;
			mes "曾经人们积极进行讨伐，但如今看来是稍有疏忽的结果。";
			next;
			mes .@npc_name$;
			mes "这种现象继续下去会很危险，因此朱诺怪物协会决定进行全面讨伐。";
			next;
			mes .@npc_name$;
			mes "也就是说，我们会在需要讨伐的各区域派驻地图检查员！";
			close;
		case 4:
			mes .@npc_name$;
			mes "啊，你要去哪？";
			close;
		}
		end;
	case 0:
	case 1:
		mes .@npc_name$;
		mes "你只需要在这片区域讨伐任意 80 只怪物。";
		next;
		mes .@npc_name$;
		mes "完成讨伐后，来找我领取奖励！！";
		close;
	case 2:
		getexp 209440,157920;
		erasequest 3481;
		setquest 3482;
		mes .@npc_name$;
		mes "你平安回来了！";
		next;
		mes .@npc_name$;
		mes "我勉强完成了今天的目标……";
		next;
		mes .@npc_name$;
		mes "明天有空的话，请再来！！";
		close;
	}
	end;

OnInit:
	setunittitle getnpcid(0), "<Juno Monster Society>";

	questinfo( QTYPE_QUEST, QMARK_YELLOW, "BaseLevel >= 90 && checkquest(3481,HUNTING) == -1 && checkquest(3482,PLAYTIME) == -1" );
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "checkquest(3482,PLAYTIME) == 2" );
	questinfo( QTYPE_QUEST2, QMARK_YELLOW, "checkquest(3481,HUNTING) == 2" );

	// (no questinfo when playtime ongoing)
	end;
}

ve_fild04,52,242,5	script	Map Examiner Rana#85	4_M_MOC_SOLDIER,{
	.@npc_name$ = "[" + strnpcinfo(1) + "]";
	.@item_name$ = getitemname(1000374);

	if (BaseLevel < 90) {
		mes .@npc_name$;
		mes "冒险者，这里很危险。";
		mes "我不知道自己的命还值不值得……";
		close;
	}
	switch( checkquest(8676,PLAYTIME) ) {
	case -1:
		break;
	case 0:
	case 1:
		if (countitem(1000374) < 3) {
			mes .@npc_name$;
			mes "原则上讨伐任务每天只能进行一次。";
			mes "今天先休息一下，下次再来……";
			close;
		}
		mes .@npc_name$;
		mes "原则上讨伐任务每天只能进行一次。";
		mes "今天先休息一下，下次再来……";
		next;
		if (select( "I recommend " + .@item_name$ + "", "See you tomorrow" ) == 2) {
			mes .@npc_name$;
			mes "好的！明天再见。";
			close;
		}
		delitem 1000374,3;	// Brilliant_Soda
		erasequest 8676;
		mes .@npc_name$;
		mes "哦，这是我最喜欢的" + .@item_name$ + "！";
		mes "我可以拿走吗？谢谢！";
		mes "踢踏踢踏……";
		next;
		specialeffect EF_FLASHER;
		mes .@npc_name$;
		mes "真清爽！";
		mes "...";
		mes "啊！冒险者！";
		next;
		mes .@npc_name$;
		mes "我正在请路过的冒险者调查怪物讨伐情况，怎么样？";
		callsub( S_Quest, 8677, 2 );	// no text
	case 2:
		erasequest 8676;
		break;
	}
	if (isbegin_quest(8675) < 2) {
		switch( checkquest(8675,HUNTING) ) {	// first time
		case -1:
			callsub( S_Quest, 8675, 0 );
		case 0:
		case 1:
			mes .@npc_name$;
			mes "请在附近击杀 80 只怪物。";
			mes "...Yes? Mobility service?";
			next;
			callsub( S_Warp );
		case 2:
			mes .@npc_name$;
			mes "啊，冒险者！我已经充分看到你的表现了。辛苦你了。";
			getexp 188600,173200;
			completequest 8675;
			setquest 8676;
			close;
		}
	}
	switch( checkquest(8677,HUNTING) ) {
	case -1:
		callsub( S_Quest, 8677, 1 );
	case 0:
	case 1:
		mes .@npc_name$;
		mes "请在附近击杀 80 只怪物。";
		mes "...Yes? Mobility service?";
		next;
		callsub( S_Warp );
	case 2:
		mes .@npc_name$;
		mes "啊，冒险者！我已经充分看到你的表现了。辛苦你了。";
		getexp 188600,173200;
		erasequest 8677;
		setquest 8676;
		close;
	}
	end;

S_Quest:
	.@quest_id = getarg(0);
	.@npc_name$ = "[" + strnpcinfo(1) + "]";

	switch( getarg(1) ) {
	case 0:	// quest 8675
		mes .@npc_name$;
		mes "你好。我是朱诺怪物协会的拉尼娅。";
		mes "我正在请冒险者调查怪物讨伐情况，你觉得怎么样？";
		break;
	case 1:	// quest 8677
		mes .@npc_name$;
		mes "你好。你今天来了！";
		mes "我正在向路过的冒险者请求怪物讨伐调查。怎么样？";
		break;
	case 2:	// quest 8677 but no text
		break;
	}
	mes "另外，如果你就在附近，我们也提供传送服务。";
	next;
	switch( select( "Listen to the situation", "Move to a nearby city", "Stop" ) ) {
	case 1:
		if (.@quest_id == 8675) {
			mes .@npc_name$;
			mes "最近一些地区的怪物数量正在增加，包括这一带。";
			mes "我想原因是这里的人比以前少了……";
			next;
			mes .@npc_name$;
			mes "这已经意味着无法自然控制数量。";
			mes "为了防止群落继续扩大，朱诺怪物协会计划进行大规模讨伐。";
			next;
			mes .@npc_name$;
			mes "无论有多少冒险者来访，如果怪物来到人们居住的地方就很麻烦……";
			mes "所以，可以请你帮忙讨伐吗？";
			next;
		}
		mes .@npc_name$;
		mes "如果你在我看到的维因斯原野击杀 80 只怪物，协会会认可你的成就并给予经验值。";
		next;
		if (select( "Accept", "Refuse" ) == 2) {
			mes .@npc_name$;
			mes "这是互惠互利的，你为什么拒绝……";
			close;
		}
		setquest .@quest_id;
		mes .@npc_name$;
		mes "很好。我会在这里等着。";
		close;
	case 2:
		callsub( S_Warp );
	case 3:
		mes .@npc_name$;
		mes "这是互惠互利的，你为什么拒绝……";
		close;
	}
	end;

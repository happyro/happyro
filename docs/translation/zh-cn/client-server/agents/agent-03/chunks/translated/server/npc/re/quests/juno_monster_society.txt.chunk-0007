			warp "rachel",113,136;
			end;
		case 3:
			mes .@npc_name$;
			mes "这是互惠互利的，你为什么拒绝……";
			close;
		}
		end;
	case 0:
	case 1:
		mes .@npc_name$;
		mes "请在附近击杀 80 只怪物。";
		mes "……嗯？需要传送服务吗？";
		next;
		mes .@npc_name$;
		mes "这里最近的地方是^0033FF拉赫^000000，";
		mes "如果你有" + .@item_name$ + "，请给我一个……我就传送你过去。";
		mes "哈~这东西最近很流行，可我没法去买。";
		next;
		if (select( "Give me 1 " + .@item_name$ + ", Rachel", "No" ) == 2) {
			mes .@npc_name$;
			mes "啊……那我该怎么办？";
			mes "什么时候再试呢……";
			close;
		}
		if (countitem(1000374) < 1) {
			mes .@npc_name$;
			mes "你似乎没有" + .@item_name$ + "？";
			mes "我会继续站岗……抱歉。";
			close;
		}
		delitem 1000374,1;	// Brilliant_Soda
		warp "rachel",113,136;
		end;
	case 2:
		mes .@npc_name$;
		mes "啊，冒险者！我已经充分看到你的表现了。辛苦你了。";
		next;
		mes .@npc_name$;
		mes "我觉得任何事情都要掌握适当的量，对吧？";
		getexp 187410,178020;
		erasequest 8671;
		setquest 8670;
		close;
	}
	end;


OnInit:
	setunittitle getnpcid(0), "<Juno Monster Society>";

	questinfo( QTYPE_DAILYQUEST, QMARK_YELLOW, "BaseLevel >= 87 && checkquest(8671,HUNTING) == -1 && checkquest(8670,PLAYTIME) == -1" );
	questinfo( QTYPE_DAILYQUEST, QMARK_YELLOW, "checkquest(8670,PLAYTIME) == 2" );
	questinfo( QTYPE_DAILYQUEST, QMARK_YELLOW, "checkquest(8671,HUNTING) == 2" );

	// (no questinfo when playtime ongoing)
	end;
}

ra_fild01,224,319,5	script	Map Examiner Ciara#85	4_M_MOC_SOLDIER,{
	.@npc_name$ = "[" + strnpcinfo(1) + "]";
	.@item_name$ = getitemname(1000374);

	if (BaseLevel < 88) {
		mes .@npc_name$;
		mes "朱诺怪物协会正在执行讨伐任务。不过你似乎还太弱，无法执行任务。";
		close;
	}
	switch( checkquest(8661,PLAYTIME) ) {
	case -1:
		break;
	case 0:
	case 1:
		if (countitem(1000374) < 3) {
			mes .@npc_name$;
			mes "冒险者，这里很危险。";
			mes "我不知道自己的命还值不值得……";
			close;
		}
		mes .@npc_name$;
		mes "原则上讨伐任务每天只能进行一次。";

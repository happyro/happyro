      Crusader: true
    Classes:
      Fourth: true
    Locations:
      Right_Hand: true
    WeaponLevel: 5
    EquipLevelMin: 215
    Refineable: true
    Gradable: true
    Script: |
      .@g = getenchantgrade();
      .@r = getrefine();
      bonus bMatkRate,5;
      bonus bSpl,2;
      bonus2 bSkillAtk,"IG_CROSS_RAIN",5;
      if (.@r>=5) {
         bonus2 bSkillAtk,"IG_CROSS_RAIN",10;
         if (.@r>=7) {
            bonus2 bMagicAtkEle,Ele_Holy,5;
            if (.@r>=9) {
               bonus2 bSkillAtk,"IG_CROSS_RAIN",10;
               if (.@r>=10) {
                  bonus bVariableCastrate,-10;
                  if (.@r>=11) {
                     bonus2 bMagicAtkEle,Ele_Holy,15;
                     bonus2 bSkillAtk,"IG_CROSS_RAIN",5;
                  }
               }
            }
         }
      }
      if (.@g>=ENCHANTGRADE_D) {
         bonus2 bMagicAtkEle,Ele_Holy,10;
         if (.@g>=ENCHANTGRADE_C) {
            bonus2 bMagicAddSize,Size_All,10;
            if (.@g>=ENCHANTGRADE_B) {
               bonus2 bMagicAddRace,RC_All,10;
               if (.@g>=ENCHANTGRADE_A) {
                  bonus2 bMagicAddEle,Ele_All,10;
               }
            }
         }
      }

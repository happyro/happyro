glast_01,369,308,5	script	Bulletin Board#28	837,{
	mes "[古城]";
	mes "古城是一座拥有无数楼层的巨大地下城。";
	mes "这座地下城绝不是新手或普通冒险者的去处，";
	mes "而是地下城专家的挑战场。";
	next;
	mes "[古城]";
	mes "这里有许多可怕的怪物，例如 ^6B1312黑暗领主^000000、";
	mes "^6B1312猫头鹰男爵^000000、^6B1312猫头鹰公爵^000000、^6B1312黑暗幻影^000000、^6B1312血腥骑士^000000、^6B1312深渊骑士^000000、^6B1312奇美拉^000000，以及各种被诅咒的剑。";
	next;
	mes "[古城]";
	mes "不过探险越困难，奖励也越丰厚。";
	mes "因此，这座地下城在专家中相当受欢迎。";
	mes "祝你地下城探险愉快。";
	close;
}

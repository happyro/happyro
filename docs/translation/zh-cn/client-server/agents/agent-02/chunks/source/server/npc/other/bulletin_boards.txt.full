yuno,154,112,5	script	Bulletin Board#17	837,{
	mes "[朱诺：]";
	mes "[施瓦茨瓦尔德共和国首都]";
	mes "欢迎来到贤者之城朱诺。";
	mes "朱诺凭借";
	mes "尤弥尔之心碎片的力量";
	mes "漂浮在空中。";
	next;
	mes "[朱诺：]";
	mes "[施瓦茨瓦尔德共和国首都]";
	mes "想成为贤者的人";
	mes "请前往贤者城堡，了解";
	mes "贤者职业及其";
	mes "转职要求。";
	next;
	mes "[朱诺：]";
	mes "[施瓦茨瓦尔德共和国首都]";
	mes "其他著名地点包括";
	mes "怪物博物馆、魔法学院";
	mes "和朱诺图书馆。";
	next;
	mes "[朱诺：]";
	mes "[施瓦茨瓦尔德共和国首都]";
	mes "朱诺附近某处藏有";
	mes "秘密通道的相关情报，";
	mes "冒险者可以前往那个世界，";
	mes "以全新的力量重生。";
	next;
	mes "[朱诺：]";
	mes "[施瓦茨瓦尔德共和国首都]";
	mes "朱诺东南方是 ^6B1312诺格";
	mes "^6B1312道路^000000，也就是熔岩地下城。诺格道路";
	mes "以凶猛的生物";
	mes "闻名，请务必小心。";
	next;
	mes "[朱诺：]";
	mes "[施瓦茨瓦尔德共和国首都]";
	mes "从朱诺向南就是卢恩-米德加尔兹王国的城市";
	mes "^2D3832艾尔迪巴兰^000000，";
	mes "位于南方。";
	close;
}

aldebaran,145,105,5	script	Bulletin Board#18	837,{
	mes "[艾尔迪巴兰：边境城市]";
	mes "欢迎来到卢恩-米德加尔兹王国的";
	mes "边境城市艾尔迪巴兰。";
	mes "艾尔迪巴兰美丽的运河和";
	mes "雄伟的钟楼是市民";
	mes "引以为傲的景观。";
	next;
	mes "[艾尔迪巴兰：边境城市]";
	mes "冒险者可以探索位于城市中央的";
	mes "钟楼。其他著名地点还有卡普拉";
	mes "公司总部，以及提供";
	mes "炼金术士转职服务的";
	mes "炼金术士公会。";
	next;
	mes "[艾尔迪巴兰：边境城市]";
	mes "艾尔迪巴兰某处有一位训练有素的";
	mes "圣诞老人，可以把你送到";
	mes "魔法小镇 ^1D2585姜饼城^000000。";
	mes "如果你想亲眼看看，就去";
	mes "寻找圣诞老人吧。";
	next;
	mes "[艾尔迪巴兰：边境城市]";
	mes "从这座城市向北是 ^60D5FD朱诺^000000，";
	mes "向南是 ^6D6FE0普隆德拉^000000。";

niflheim,200,191,5	script	Bulletin Board#25	837,{
	mes "[亡者之城，尼芙菲姆]";
	mes "欢迎来到亡者之城尼芙菲姆。";
	mes "尼芙菲姆曾被认为是死后";
	mes "才会来到的另一个世界。";
	mes "不过最近人们发现了神秘大树后方的一条秘密通道。";
	mes "因此，你会看到许多人在这片区域旅行。";
	next;
	mes "[亡者之城，尼芙菲姆]";
	mes "作为观光景点，推荐参观女巫城堡。";
	mes "与普通城镇不同，尼芙菲姆内禁止保存复活点或";
	mes "传送点，城镇内部也会刷新怪物。";
	next;
	mes "[亡者之城，尼芙菲姆]";
	mes "尤其要小心名为";
	mes "^6B1312死亡之王^000000 的 Boss 怪物。";
	next;
	mes "[亡者之城，尼芙菲姆]";
	mes "继续向西就会抵达 ^6B1312吉欧尔谷^000000，";
	mes "那里栖息着强大而可怕的怪物。";
	mes "如果你是初次单独冒险，建议立即离开该区域。";
	close;
}


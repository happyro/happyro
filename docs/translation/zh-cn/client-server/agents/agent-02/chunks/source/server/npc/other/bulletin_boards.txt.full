alberta,111,59,5	script	Bulletin Board#1	837,{
	mes "[艾尔贝塔：港口城市]";
	mes "欢迎来到港口城市艾尔贝塔。";
	next;
	mes "[艾尔贝塔：港口城市]";
	mes "在艾尔贝塔，你可以找到商人公会，冒险者可在那里转职为商人。";
	next;
	mes "[艾尔贝塔：港口城市]";
	mes "艾尔贝塔提供可靠的海上旅行服务，也为外国贸易提供了便利，使卢恩-米德加尔兹王国繁荣昌盛。";
	next;
	mes "[艾尔贝塔：港口城市]";
	mes "码头上可以找到来自外国的代表，他们会带游客前往自己的国家。";
	next;
	mes "[艾尔贝塔：港口城市]";
	mes "水手之间流传着一个名为 ^338C60海龟岛^000000 的地方。勇敢的冒险者可以亲自调查这个传闻，找出真相。";
	next;
	mes "[艾尔贝塔：港口城市]";
	mes "艾尔贝塔附近还发现了一艘沉船，如今已成为冒险者热门的探索地点。";
	next;
	mes "[艾尔贝塔：港口城市]";
	mes "从艾尔贝塔向西北可以到达 ^1F3A11斐扬^000000。你可以在码头搭乘客船前往 ^5E5C69伊兹鲁德^000000。";
	mes "祝你旅途愉快。"; 

	close;
}

geffen,124,65,5	script	Bulletin Board#2	837,{
	mes "[吉芬：魔法之城]";
	mes "欢迎来到魔法之城吉芬。吉芬以各种与魔法有关的传说闻名。";
	next;
	mes "[吉芬：魔法之城]";
	mes "城内的名胜包括可转职为铁匠的熔炉、培养魔法师的魔法学院，以及用于转职巫师的吉芬塔。";
	next;
	mes "[吉芬：魔法之城]";
	mes "吉芬塔下方有一座地下城，据说会出现可怕的怪物。";
	next;
	mes "[吉芬：魔法之城]";
	mes "据说精灵传说中的失落之城吉芬尼亚，就隐藏在这座地下城的深处。";
	next;
	mes "[吉芬：魔法之城]";
	mes "从吉芬向南是 ^828E28兽人村落^000000，向西是 ^4C6055古城^000000，最东边是 ^6D6FE0普隆德拉^000000，向北是 ^744B2D妙勒尼山^000000。祝你在吉芬过得愉快。";
	close;
}

izlu2dun,104,92,5	script	Bulletin Board#4	837,{
	mes "[拜亚兰岛]";
	mes "^6B1312注意！^000000";
	mes "伊兹鲁德地下城共有 5 层。前几层适合初出茅庐的冒险者。";
	next;
	mes "[拜亚兰岛]";
	mes "越深入拜亚兰地下城，遇到的怪物就越强大。";
	next;
	mes "[拜亚兰岛]";
	mes "除了少数例外，这座地下城的大多数怪物都属于水属性。因此，风属性武器会对你大有帮助。";
	close;
}

payon,178,108,5	script	Bulletin Board#06	837,{
	mes "[斐扬：山城]";
	mes "欢迎来到山城斐扬。斐扬最近完成了翻新，希望你喜欢这里整洁漂亮的街道和建筑。";
	next;
	mes "[斐扬：山城]";
	mes "斐扬以弓术之城闻名。长期以来，这里的居民都靠弓箭狩猎为生，弓箭制作和训练也在斐扬得到了发展。";
	next;
	mes "[斐扬：山城]";
	mes "斐扬有各种护甲和武器，尤其适合弓箭手。如果你想成为弓箭手，最好先熟悉这座城市。";
	next;
	mes "[斐扬：山城]";
	mes "斐扬宫位于城市中央。弓箭手村位于斐扬北部，人们可以在那里转职为弓箭手。";
	next;
	mes "[斐扬：山城]";
	mes "弓箭手村附近有 ^2F0400斐扬洞窟^000000，那里栖息着不死怪物。";
	next;
	mes "[斐扬：山城]";
	mes "从斐扬向东南是 ^123972艾尔贝塔^000000，向西是 ^866C4B梦罗克^000000。^5E5C69伊兹鲁德^000000 和 ^6D6FE0普隆德拉^000000 位于斐扬北方。";
	mes "祝你旅途愉快。"; 

	close;
}

pay_arche,79,31,5	script	Bulletin Board#07	837,{
	mes "[弓箭手村]"; 

	mes "欢迎来到斐扬弓箭手村，新手可以在这里转职为弓箭手。";
	next;
	mes "[弓箭手村]";
	mes "弓箭手村出售弓和紧身衣，这是新晋弓箭手和猎人的必需品。";
	next;
	mes "[弓箭手村]";
	mes "如果你想成为弓箭手，建议先熟悉这个村庄。想成为猎人的话，猎人公会位于斐扬东边的原野上。";
	close;
}

prontera,148,49,5	script	Bulletin Board#09	837,{
	mes "[普隆德拉：卢恩-米德加尔兹]";
	mes "[王国首都]";
	mes "欢迎来到卢恩-米德加尔兹的首都普隆德拉。";
	next;
	mes "[普隆德拉：卢恩-米德加尔兹]";
	mes "[王国首都]";
	mes "普隆德拉位于卢恩-米德加尔兹大陆中央，以繁荣的商业闻名。";
	next;
	mes "[普隆德拉：卢恩-米德加尔兹]";
	mes "[王国首都]";
	mes "城内有大教堂，人们可以在那里转职为服事和牧师。";
	next;
	mes "[普隆德拉：卢恩-米德加尔兹]";
	mes "[王国首都]";
	mes "你还可以找到城堡，人们可以在那里转职为十字军。";
	next;
	mes "[普隆德拉：卢恩-米德加尔兹]";
	mes "[王国首都]";
	mes "请尽情探索普隆德拉的街道，城内有各种各样的观光景点。";
	next;
	mes "[普隆德拉：卢恩-米德加尔兹]";
	mes "[王国首都]";
	mes "需要升级武器和护甲时，请前往普隆德拉中央喷泉的五点钟方向那栋建筑。";
	next;
	mes "[普隆德拉：卢恩-米德加尔兹]";
	mes "[王国首都]";
	mes "从普隆德拉向东南是 ^5E5C69伊兹鲁德^000000，最南边是 ^1F3A11斐扬^000000，最西边是 ^683C1F吉芬^000000，最北边是 ^2D3832艾尔迪巴兰^000000。";
	mes "祝你在普隆德拉玩得愉快。";

	close;
}

morocc,152,110,5	script	Bulletin Board#11	837,{
	mes "[梦罗克：边境城镇]";
	mes "欢迎来到沙漠之城梦罗克。梦罗克建在绿洲之上，因此可以容纳众多访客和旅人。";
	next;
	mes "[梦罗克：边境城镇]";
	mes "梦罗克城堡位于城市中央。请尽情探索这座城镇，享受其独特氛围。不过要看好钱包，小心盗贼和刺客。";
	next;
	mes "[梦罗克：边境城镇]";
	mes "从梦罗克向西北可以找到 ^660000金字塔地下城^000000，向西可以找到 ^660000斯芬克斯地下城^000000，向东南则是 ^660000蚂蚁地狱^000000。";
	next;
	mes "[梦罗克：边境城镇]";
	mes "据说刺客公会位于东南方。从梦罗克向东再向北，就能抵达 ^3355FF普隆德拉^000000。";

	close;
}

comodo,210,148,5	script	Bulletin Board#12	837,{
	mes "[科摩多：海滨城市]";
	mes "欢迎！科摩多城镇四周";
	mes "环绕着许多来自";
	mes "被遗忘时代的古代遗迹。";
	next;
	mes "[科摩多：海滨城市]";
	mes "只有在科摩多才能找到";
	mes "舞娘公会和诗人公会，";
	mes "冒险者可以在那里";
	mes "转职为舞娘或诗人。";
	next;
	mes "[科摩多：海滨城市]";
	mes "你还可以参观赌场，";
	mes "那里既是热门的观光";
	mes "景点，也是休闲场所。";
	next;
	mes "[科摩多：海滨城市]";
	mes "你可以从当地的工具商人处";
	mes "购买科摩多特产";
	mes "狂暴药水。";
	next;
	mes "[科摩多：海滨城市]";
	mes "科摩多周围有 3 座洞窟，";
	mes "里面栖息着许多";
	mes "不同种类的怪物。进入";
	mes "这些区域时请务必";
	mes "小心。";
	next;
	mes "[科摩多：海滨城市]";
	mes "从科摩多可以通过东洞窟";
	mes "前往 ^866C4B梦罗克^000000，";
	mes "也可以通过北洞窟前往";
	mes "^7D2272乌姆巴拉^000000。";
	next;
	mes "[科摩多：海滨城市]";
	mes "向东可以找到 ^BF2B0D帕罗斯";
	mes "^BF2B0D灯塔^000000，盗贼公会就在那里。";
	mes "享受科摩多的夜";
	mes "生活吧～";
	close;
}

umbala,137,94,5	script	Bulletin Board#13	837,{
	mes "[乌姆巴拉：乌坦村落]";
	mes "欢迎来到乌姆巴拉，";
	mes "乌坦部落的村落。";
	next;
	mes "[乌姆巴拉：乌坦村落]";
	mes "乌姆巴拉和使用独特语言的";
	mes "乌坦部落，最近才被几名";
	mes "勇敢的冒险者";
	mes "发现。";
	next;
	mes "[乌姆巴拉：乌坦村落]";
	mes "学者认为乌姆巴拉可能是";
	mes "我们世界与另一个领域的边界。";
	mes "他们相信两个世界的交界处";
	mes "可能就是北方的";
	mes "世界树。";
	next;
	mes "[乌姆巴拉：乌坦村落]";
	mes "景点包括酋长之家、";
	mes "萨满之家和蹦极区。成千上万的";
	mes "游客来到蹦极区，";
	mes "挑战自己的";
	mes "勇气。";
	next;
	mes "[乌姆巴拉：乌坦村落]";
	mes "从乌姆巴拉向南即可前往";
	mes "^D91B73科摩多^000000。请享受";
	mes "在乌姆巴拉的时光。";
	close;
}


que_house_s,11,52,3	script	#03homun_s	111,{
	end;
OnInit:
	initnpctimer;
	end;
OnTimer6000:
	emotion ET_SURPRISE;
	end;
OnTimer7000:
	emotion ET_SURPRISE, getnpcid(0, "#04homun_s");
	stopnpctimer;
	initnpctimer;
	end;
}

que_house_s,14,52,3	script	#04homun_s	111,{
	end;
}

// Researcher's Pet
//============================================================
que_house_s,24,46,3	script	Jonathan#homun_s	6002,{
	end;
}

que_house_s,23,46,3	script	#05homun_s	111,{
	emotion ET_STARE_ABOUT, getnpcid(0, "Jonathan#homun_s");
	if (gethominfo(1) < 6048 || gethominfo(1) > 6052) { // Not mutated Homunculus-S
		mes "[Jonathan]";
		mes "Hwang~ Hwang!";
		next;
		mes ":: It seems to be Viorel's";
		mes ":: Homunculus.";
		mes ":: It is wearing a small necklace";
		mes ":: with the name Jonathan engraved";
		mes ":: on it.";
		close;
	} else {
		mes "[Jonathan]";
		mes "Hwang~?!";
		next;
		emotion ET_PROFUSELY_SWEAT, getnpcid(0, "Jonathan#homun_s");
		mes "[Jonathan]";
		mes "*Sniff* ...";
		next;
		mes ":: This Amistr";
		mes ":: called Jonathan";
		mes ":: seems to be surprised by my";
		mes ":: new Homunculus.";
		close;
	}
}

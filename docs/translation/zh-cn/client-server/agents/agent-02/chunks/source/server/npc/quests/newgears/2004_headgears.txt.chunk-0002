			mes "[Hatbyr Mhore]";
			mes "Aha~ Good good good.";
			mes "Let's see let's see...";
			mes "1 Devil Wing";
			mes "1 Elven Ears...";
			next;
			mes "[Hatbyr Mhore]";
			mes "Some other crap and";

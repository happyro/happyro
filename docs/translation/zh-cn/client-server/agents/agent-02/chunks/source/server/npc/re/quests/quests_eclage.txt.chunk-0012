		}
		else {
			mes "["+ strcharinfo(0) +"]";
			mes "I should observe it ";
			mes "a little bit more...";
		}
		close;
	}
	mes "[Poppy]";
	if (ep14_2_detect < 10) {
		mes "Grrrrrrr.... Bow Wow!!";
		mes "Grrrrr!!!!";
	}
	else {
		mes "Rawrrr~ Lick lick!!";
		mes "Rub rub~";
	}
	close;
}


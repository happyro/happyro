harboro1,345,149,7	duplicate(dummy_npc)	Enthusiastic Job Seeker#2	4_M_JOB_KNIGHT2
harboro1,350,149,7	duplicate(dummy_npc)	Enthusiastic Job Seeker#3	4_M_MONK
harboro1,348,148,7	duplicate(dummy_npc)	Enthusiastic Job Seeker#4	4_M_MONK

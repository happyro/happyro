/**
 * Gets int32 type data from struct DBData.
 * If data is not int32 type, returns 0.
 * @param data Data
 * @return Integer value of the data.
 * @public
 */
int32 db_data2i(DBData *data)
{
	DB_COUNTSTAT(db_data2i);
	if (data && DB_DATA_INT == data->type)
		return data->u.i;
	return 0;
}


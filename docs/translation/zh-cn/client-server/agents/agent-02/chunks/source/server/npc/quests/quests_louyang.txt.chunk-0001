		else if (gettime(DT_HOUR) >= 17 && gettime(DT_HOUR) < 22) {
			if (rand(1,10) < 6) {
				mes "[Huang Jia Xian]";
				mes "What the...?";
				mes "Hey, what";
				mes "are you doing?";
				mes "Get out of here!";
				next;
				mes "^3131FFYou have failed^000000";
				mes "^3131FFto steal the pot.^000000";

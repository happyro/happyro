//===== rAthena Script ======================================= 
//= Merchant Job Quest
//===== By: ================================================== 
//= kobra_k88; L0ne_W0lf
//===== Current Version: ===================================== 
//= 2.4
//===== Compatible With: ===================================== 
//= rAthena Project
//===== Description: ========================================= 
//= [Official Conversion]
//= Job quest for Merchant classes
//===== Additional Comments: ================================= 
//= 1.0 Fully working.
//= 1.1 Added instant job change for High Novice [Lupus]
//= 1.3 Added Baby Class support [Lupus]
//= 1.4 Optimised and moved first checker to Jfunc1-1 [massdriller]
//= 1.5 Changed Prontera->Izlude teleport price to 600 [Lupus]
//= 1.5.1 Removed Duplicates [Silent]
//= 1.5.2 Now saves/restores all quest skills [Lupus]
//= 1.6 Merged back JFunc, CHANGED NUMBERS TO CONSTANTS [Lupus]
//= 1.7 Updated to use Free Ticket for Kafra [Lupus]
//= 1.8 Rescripted to Aegis 10.3 stadards. [L0ne_W0lf]
//=     No longer uses function "F_ToHigh"
//= 1.9 Bugfixes, thanks to Barron-Monster. [L0ne_W0lf]
//= 1.9a Added a missing next; (Barron-Monster) [L0ne_W0lf]
//= 1.9b Typo. "nextl" -> "next;" (Barron-Monster) [L0ne_W0lf]
//= 2.0 Should "fix" the problem with the Biliban Kafra. [L0ne_W0lf]
//= 2.1 Fixed mistake in condition check. [L0ne_W0lf]
//= 2.2 Added Quest Log commands. [L0ne_W0lf]
//= 2.3 Fixed an issue with completequest by adding checkquest. [Kisuka]
//= 2.4 Quest log fixes. [Euphy]
//============================================================ 

alberta_in,53,43,6	script	Merchant#mer	86,{
	if (Upper == 1) {
		if (Class == Job_Novice_High && (ADVJOB == Job_Whitesmith || ADVJOB == Job_Creator)) {
			mes "[马恩苏首领]";
			mes "好久不见！";
			mes "嘿，你没有放弃";
			mes "你的事业吧？";
			mes "发生什么事了？";
			next;
			mes "[马恩苏首领]";
			mes "哇……";
			mes "你真的去过英灵殿？！哇，你走了很远的路……";
			next;
			if (!callfunc("F_CanChangeJob")) {
				mes "[马恩苏首领]";
				mes "嗯……";
				mes "看来你还没准备好再次成为商人。先完成初心者基础技能学习吧。";
				next;
				mes "[马恩苏首领]";
				mes "别担心，我们总会为你保留商人职位。准备好后再回来，好吗？";
				close;
			}
			mes "[马恩苏首领]";
			mes "看来我们再次相遇是命运安排。好吧，我再帮你转职为商人！";
			next;
			skill "NV_TRICKDEAD",0,SKILL_PERM;
			jobchange Job_Merchant_High;
			skill "MC_CARTREVOLUTION",1,SKILL_PERM;
			skill "MC_CHANGECART",1,SKILL_PERM;
			skill "MC_LOUD",1,SKILL_PERM;
			mes "[马恩苏首领]";
			mes "啊~ 真令人怀念。和从前一样！好吧，加油！";
			close;
		}
		else {
			mes "[Chief Mahnsoo]";
			mes "^333333*叹气*^000000";
			mes "我好无聊……";
			mes "什么时候才能收到我可爱的布洛森的消息？";
			close;
		}
	}
	if (BaseJob == Job_Merchant) {
		mes "[Chief Mahnsoo]";
		mes "你好！";
		mes "你觉得成为商人";
		mes "怎么样？";
		next;
		mes "[Chief Mahnsoo]";
		mes "善于处理";
		mes "金钱当然";
		mes "有它的好处，";
		mes "不是吗？";
		close;
	}
	else if (BaseJob != Job_Merchant && BaseJob != Job_Novice) {
		mes "[Chief Mahnsoo]";
		mes "我们商人讨厌两面派，这对生意不好。";
		next;
		mes "[Chief Mahnsoo]";
		mes "那些总想占别人便宜、用离谱价格卖东西再挥霍钱的人最糟糕。";
		next;
		mes "[Chief Mahnsoo]";
		mes "无论如何，我们只接受初心者转职为商人。不过感谢你对我们工作的兴趣。";
		close;
	}
	else if (job_merchant_q == 9) {
		mes "[Chief Mahnsoo]";
		mes "你好，";
		mes ""+ strcharinfo(0) +".";
		set job_merchant_q,0;
		set job_merchant_q2,0;
		set quest_alb_01,0;
		mes "很遗憾，这次你没能取得商人执照。";
		next;
		mes "[Chief Mahnsoo]";
		mes "我会删除你的记录，想重新申请时随时回来。";
		close;
	}
	else if (job_merchant_q == 8 || job_merchant_q == 7) {
		mes "[Chief Mahnsoo]";
		mes "你好，";
		mes ""+ strcharinfo(0) +".";
		mes "我很高兴告诉你";
		mes "一个好消息！";
		next;
		mes "[Chief Mahnsoo]";
		mes "商人公会接受了你的申请。你已证明自己完全有资格成为商人。";
		if (job_merchant_q == 7) {
			next;
			mes "[Chief Mahnsoo]";
			mes "现在只需处理会员费。";
			mes "准备好了吗？";
			next;
			switch(select("支付剩余 500 Zeny:退出")) {
			case 1:
				mes "[Chief Mahnsoo]";
				if (Zeny < 500) {
					mes "嗯……";
					mes "看来你现在没有足够的 Zeny 支付剩余会员费。";
					next;
					mes "[Chief Mahnsoo]";
					mes "赚到成为商人所需的 500 Zeny 后再回来。";
					close;
				}
				set Zeny, Zeny-500;
				mes "啊，对了……！";
				mes "现在你的";
				mes "会员费";
				mes "已经全部付清。";
				break;
			case 2:
				mes "[Chief Mahnsoo]";
				mes "看来你需要一些时间筹集会员费。准备好后";
				mes "请尽快回来。";
				close;
			}
		}
		next;
		mes "[Chief Mahnsoo]";
		mes "恭喜你！";
		callfunc "Job_Change",Job_Merchant;
		callfunc "F_ClearJobVar";
		for ( .@quest_id = 1009; .@quest_id <= 1012; .@quest_id++ ) {
			if (isbegin_quest(.@quest_id) == 1)
				completequest .@quest_id;
		}
		mes "很高兴你加入商人公会，希望你能积极参与卢恩·米德加兹的经济。";
		next;
		if (quest_alb_01 == 1) {
			mes "[Chief Mahnsoo]";
			mes "*咳咳* 那么，感谢你替我把消息带给布洛森，这是给你的一点钱。";
			mes "希望下次你还会帮我~";
			set Zeny, Zeny+200;
			set quest_alb_01,2;
		}
		else {
			mes "[Chief Mahnsoo]";
			mes "我托你送的消息？你忘了吗？算了。干得好！";
		}
		next;
		mes "[Chief Mahnsoo]";
		mes "我们的目标是掌控世界 20% 的收入！需要你这样年轻又积极的人！";
		next;
		mes "[Chief Mahnsoo]";
		mes "不过总的来说，只要赚很多钱我们也会很开心。";
		mes "我们都知道这一点~";
		close;
	}
	else if (job_merchant_q2 && job_merchant_q > 0 && job_merchant_q < 7) {
		mes "[Chief Mahnsoo]";
		if (job_merchant_q2 == 1 || job_merchant_q2 == 2) {
			mes "首先从仓库取出包裹，再送到普隆德拉旧剑士协会。";
			next;
			mes "[Chief Mahnsoo]";
			mes "到那里后把包裹交给附近的卡普拉职员。她叫布洛森。都记住了吗？";
			next;
			if (job_merchant_q2 == 1) {
				mes "[Chief Mahnsoo]";
				mes "记住，包裹序列号是 ^3355FF2485741^000000.";
			}
			else {
				mes "[Chief Mahnsoo]";
				mes "记住，包裹序列号是 ^3355FF2328137^000000.";
			}
		}
		else if (job_merchant_q2 == 3 || job_merchant_q2 == 4) {
			mes "首先从仓库取出包裹，再送到吉芬魔法师公会。";
			next;
			if (job_merchant_q2 == 3) {
				mes "[Chief Mahnsoo]";
				mes "到那里后把包裹交给魔法师公会负责人。记住，包裹序列号是 ^3355FF2989396^000000.";
			}
			else {
				mes "[Chief Mahnsoo]";
				mes "到那里后把包裹交给魔法师公会负责人。记住，包裹序列号是 ^3355FF2191737^000000.";
			}
		}
		else if (job_merchant_q2 == 5 || job_merchant_q2 == 6) {
			mes "首先从仓库取出包裹，再送到梦罗克。";
			next;
			mes "[Chief Mahnsoo]";
			mes "你必须找到染料商 Java Dullihan，把他订购的商品送到。";
			next;
			if (job_merchant_q2 == 5) {
				mes "[Chief Mahnsoo]";
				mes "不过他有些健忘，请交给他的学生之一。包裹序列号是 ^3355FF3012685^000000.";
			}
			else {
				mes "[Chief Mahnsoo]";
				mes "不过他有些健忘，交给他的学生之一。包裹序列号是 ^3355FF3487372^000000.";
			}
		}
		else if (job_merchant_q2 == 7 || job_merchant_q2 == 8) {
			mes "首先从仓库取出包裹，交给海底洞窟岛的卡普拉职员。她叫布洛森。";
			next;
			if (job_merchant_q2 == 7) {
				mes "[Chief Mahnsoo]";
				mes "记住，包裹序列号是 ^3355FF3318702^000000.";
			}
			else {
				mes "[Chief Mahnsoo]";
				mes "记住，包裹序列号是 ^3355FF3543625^000000.";
			}
		}
		if (job_merchant_q2 == 7 || job_merchant_q2 == 8) {
			next;
			mes "[Chief Mahnsoo]";
			mes "还、还有……";
			mes "别忘了帮我送那条消息~";
		}
		next;
		mes "[Chief Mahnsoo]";
		mes "别忘了目的地和包裹序列号。";
		mes "你需要把它们告诉";
		mes "仓库管理员。";
		next;
		mes "[Chief Mahnsoo]";
		mes "仓库就在我右边的房间里。";
		mes "在那里你可以和仓库管理员交谈，";
		mes "他会";
		mes "帮助你。";
		next;
		mes "[Chief Mahnsoo]";
		mes "送货后回仓库，把收据交给仓库管理员。";
		mes "然后回来";
		mes "找我。";
		next;
		mes "[Chief Mahnsoo]";
		mes "清楚了吗？";
		mes "好，这就是";
		mes "精神。";
		mes "保重！";
		close;
	}
	else {
		mes "[Chief Mahnsoo]";
		mes "那么，你为什么来到";
		mes "商人协会？";
		mes "有什么";
		mes "我能帮你吗？";
		next;
		switch(select("我想成为商人。:告诉我商人的事。:告诉我要求。:不用了。")) {
		case 1:
			mes "[Chief Mahnsoo]";
			mes "你想成为";
			mes "商人吗？";
			mes "嗯……";
			next;
			if (!callfunc("F_CanChangeJob")) {
				mes "[Chief Mahnsoo]";
				mes "首先，你必须是职业等级 10 的初心者，并学会所有基础技能。";
				next;
				mes "[Chief Mahnsoo]";
				mes "我们不只是";
				mes "简单的赚钱人！";
				mes "我们以拥有标准、只接受合格申请者为傲！";
				close;
			}
			mes "[Chief Mahnsoo]";
			mes "好吧，你需要填写申请表，并准备 1,000 Zeny 会员费。";
			next;
			mes "[Chief Mahnsoo]";
			mes "哦……！";
			mes "如果没有全部钱，";
			mes "现在可以先收 500 Zeny。";
			mes "通过测试并取得";
			mes "商人公会执照后，";
			mes "再支付余款。";
			next;
			mes "[Chief Mahnsoo]";
			mes "你觉得怎么样？";
			mes "现在准备加入吗？";
			next;
			if (select("是的，我愿意。:嗯……以后再说……") ==1 ) {
				mes "[Chief Mahnsoo]";
				mes "让我检查你是否";
				mes "填写了申请表的所有内容";
				mes "……";
				next;
				mes "[Chief Mahnsoo]";
				mes "嗯……";
				mes "" + strcharinfo(0) + "...";
				mes "名字不错。";
				next;
				mes "[Chief Mahnsoo]";
				mes "这份申请只有在";
				mes "支付会员费后才会";
				mes "登记。";
				mes "你想如何";
				mes "处理费用？";
				next;
				switch(select("现在支付全部 1,000 Zeny！:分两次支付 500 Zeny。:退出")) {
				case 1:
					mes "[Chief Mahnsoo]";
					if (Zeny >= 1000) {
						set job_merchant_q,2;
						set Zeny, Zeny-1000;
						mes "好~";
						mes "这是 1,000 Zeny。";
						mes "非常好，非常好。";
					}
					else {
						mes "看来你现在没有足够 Zeny 支付全部费用。现在先支付 500 Zeny 怎么样？想想吧。";
						close;
					}
					break;
				case 2:
					mes "[Chief Mahnsoo]";
					if (Zeny >= 500) {
						set job_merchant_q,1;
						set Zeny, Zeny-500;
						mes "让我看看……";
						mes "这是 500 Zeny。虽然我不认为分期付款对商人是好主意，但你还在学习，就这样吧。";
					}
					else {
						mes "嗯……";
						mes "看来你没有足够资金支付一半会员费。筹够所需 Zeny 后再回来。";
						close;
					}
					break;
				case 3:
					mes "[Chief Mahnsoo]";
					mes "准备好后随时回来";
					mes "就好。";
					close;
				}
			}
			else {
				mes "[Chief Mahnsoo]";
				mes "现在没有足够 Zeny 吗？没关系。慢慢来，准备好后";
				mes "再回来，好吗？";
				close;
			}
			next;
			mes "[Chief Mahnsoo]";
			mes "好，你现在已列入申请者名单。开始前我先说一件事。";
			next;
			mes "[Chief Mahnsoo]";
			mes "外面有些愚蠢贪婪的人根本不明白商人意味着什么。";
			mes "希望你不会变成那样，对吧？";
			next;
			mes "[Chief Mahnsoo]";
			mes "现在让我";
			mes "说明你需要为";
			mes "商人执照考试";
			mes "做些什么。";
			next;
			mes "[Chief Mahnsoo]";
			switch(rand(1,4)) {
			case 1:
				mes "首先从仓库取出包裹，再前往普隆德拉旧剑士协会。";
				next;
				mes "[Chief Mahnsoo]";
				mes "到那里后拜访驻守的卡普拉职员。她叫布洛森。都记住";
				mes "了吗？";
				callsub S_GiveSerial,2485741,1,2328137,2,1009;
				break;
			case 2:
				mes "首先从仓库取出包裹，前往吉芬魔法师公会，再拜访负责人。";
				callsub S_GiveSerial,2989396,3,2191737,4,1010;
				break;
			case 3:
				mes "首先从仓库取出包裹，前往梦罗克，找到染料商 Java Dullihan。";
				next;
				mes "[Chief Mahnsoo]";
				mes "他有些健忘，你最好把包裹交给他的学生之一。";
				callsub S_GiveSerial,3012685,5,3487372,6,1011;
				break;
			case 4:
				mes "首先从仓库取出包裹，交给海底洞窟岛的卡普拉职员。";
				callsub S_GiveSerial,3318702,7,3543625,8,1012;
				next;
				mes "[Chief Mahnsoo]";
				mes "嗯……";
				mes "我还有一个";
				mes "个人";
				mes "请求。";
				next;
				mes "[Chief Mahnsoo]";
				mes "送包裹时可以把这条消息交给她吗？拜托~";
				getitem 1072,1; //Delivery_Message
				break;
			}
			next;
			mes "[Chief Mahnsoo]";
			mes "别忘了目的地和包裹序列号。 You will need to tell those to the storekeeper in the storehouse to the right of me.";
			next;
			mes "[Chief Mahnsoo]";
			mes "送货后把收据交给仓库管理员，再回来找我。";
			next;
			mes "[Chief Mahnsoo]";
			mes "清楚了吗？";
			mes "好，这就是";
			mes "精神。";
			mes "保重！";
			close;
		case 2:
			mes "[Chief Mahnsoo]";
			mes "商人？";
			mes "我们主要靠出售商品赚钱。这就是";
			mes "商人的道路。";
			next;
			mes "[Chief Mahnsoo]";
			mes "我们可能不擅长战斗，也没有很多特殊攻击，更没有治疗技能……";
			next;
			mes "[Chief Mahnsoo]";
			mes "但我们能从 NPC 商店低价买入商品，再高价卖给其他人~";
			next;
			mes "[Chief Mahnsoo]";
			mes "我们的终极攻击技能是‘贪婪’。贪婪的力量来自";
			mes "被迫花掉好不容易赚来的 Zeny 时产生的愤怒。";
			next;
			mes "[Chief Mahnsoo]";
			mes "那样花掉 Zeny";
			mes "会让任何商人心中涌起致命的怒火！";
			mes "一想到这件事";
			mes "就让我热血沸腾！";
			next;
			mes "[Chief Mahnsoo]";
			mes "总之，我们能使用大多数";
			mes "武器，弓、杖和双手剑除外。不过我们总能把它们卖掉。";
			next;
			mes "[Chief Mahnsoo]";
			mes "是的……";
			mes "我们商人通常";
			mes "满脑子都是钱……";
			close;
		case 3:
			mes "[Chief Mahnsoo]";
			mes "成为商人前必须满足三个条件。";
			next;
			mes "[Chief Mahnsoo]";
			mes "第一，你必须是职业等级 10 的初心者，并学会所有基础技能。";
			next;
			mes "[Chief Mahnsoo]";
			mes "第二，你必须支付 1,000 Zeny 会员费。我相信任何商人候选人都能轻松赚到 1,000 Zeny。";
			next;
			mes "[Chief Mahnsoo]";
			mes "第三，有一项测试体力和方向感的执照考试。你要把包裹送给指定地点的指定人物。";
			close;
		case 4:
			close;
		}
	}

S_GiveSerial:
	next;
	mes "[Chief Mahnsoo]";
	mes "记住……";
	mes "包裹";
	mes "序列号是";
	if (rand(2)) {
		mes "^3355FF"+getarg(0)+"^000000.";
		set job_merchant_q2,getarg(1);
	}
	else {
		mes "^3355FF"+getarg(2)+"^000000.";
		set job_merchant_q2,getarg(3);
	}
	setquest getarg(4);
	return;
}

alberta_in,28,29,2	script	Merchant Guildsman#mer	83,{
	if (BaseJob == Job_Merchant) {
		mes "[Union Staff Kay]";

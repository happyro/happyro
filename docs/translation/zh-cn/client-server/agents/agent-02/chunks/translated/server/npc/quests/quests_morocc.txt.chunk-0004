moc_fild21,38,193,0	script	Morocc Timer#edq	-1,6,6,{
//OnInit:
//	set $@re_moc,0;
//	set $@re_moc_time$,"";
//	end;

OnTouch_:
	if ($@re_moc == 0) {
		set $@re_moc,1;
		donpcevent "Satan Broadcast#edq::OnEnable";
	}
	end;
}

moc_fild21,1,1,0	script	Satan Broadcast#edq	844,{
OnInit:
	disablenpc "Satan Broadcast#edq";
	end;

OnEnable:
	enablenpc "Satan Broadcast#edq";
	initnpctimer;
	end;

OnTimer5000:
	mapannounce "moc_fild21","Satan Morocc: I'm very impressed by you weaklings.",bc_map,"0xFFFF00";
	end;

OnTimer15000:
	mapannounce "moc_fild21","Satan Morocc: You may as well deal with all your regrets now. I shall snuff out your life soon!",bc_map,"0xFFFF00";
	end;

OnTimer25000:
	mapannounce "moc_fild21","Satan Morocc: It's only a matter of time until I get you, you worthless insects. Just a little while longer...",bc_map,"0xFFFF00";
	stopnpctimer;
	end;

OnDisable:
	stopnpctimer;
	disablenpc "Satan Broadcast#edq";
	end;
}

moc_fild21,178,239,0	script	Group of Evil#edq	844,1,1,{
	if (((rebirth_moc_edq == 4) || (rebirth_moc_edq == 7)) && ($@re_moc == 1)) {
		mes "你被赋予黑暗生命的时空裂隙震慑，本能地后退。";
		next;
		mes "你能感受到光暗交汇的裂隙中升起的黑暗力量。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "哇……！";
		close2;
		if($@re_moc == 1) {
			set $@re_moc,2;
			donpcevent "Satan Summon#edq::OnEnable";
		}
		end;
	}
	else {
		mes "你被赋予黑暗生命的时空裂隙震慑，本能地后退。";
		next;
		mes "你感受到光暗交汇的裂隙中升起黑暗力量。";
		close;
	}

OnEnable:
	enablenpc "Group of Evil#edq";
	set $@re_moc_time$,"";
	end;
}

moc_fild21,177,239,0	script	Time-Space Gap#edq	844,1,1,{
	if ((rebirth_moc_edq == 4) && ($@re_moc == 3)) {
		mes "随着 Satan Morocc 消失，时空裂隙的可怕黑暗似乎也在消散。";
		next;
		mes "你看到碎片漂浮在裂隙中，放射出的光芒也逐渐放慢。";
		next;
		mes "你伸手捡起一块暗淡无光的碎片。";
		getitem 7820,1; //Morocc_Skin
		set rebirth_moc_edq,6;
		changequest 3053,3055;
		close;
	}
	else {
		mes "当你凝视时空裂隙时，神秘的黑暗帷幕缓慢而不规则地遮住双眼。";
		next;
		mes "你感觉再靠近就太危险了。";
		close;
	}

OnInit:
	disablenpc "Time-Space Gap#edq";
	end;

OnEnable:
	initnpctimer;
	enablenpc "Time-Space Gap#edq";
	end;

OnDisable:
	stopnpctimer;
	disablenpc "Time-Space Gap#edq";
	donpcevent "Group of Evil#edq::OnEnable";
	set $@re_moc,0;
	end;

OnTimer1800000:
	set $@re_moc,4;
	end;

OnTimer21600000:
	donpcevent "Time-Space Gap#edq::OnDisable";
	end;
}

moc_fild21,3,1,0	script	Satan Summon#edq	844,{
OnInit:
	disablenpc "Satan Summon#edq";
	end;

OnEnable:
	enablenpc "Satan Summon#edq";
	initnpctimer;
	monster "moc_fild21",177,217,"Satan Morocc",1916,1,"Satan Summon#edq::OnMyMobDead";
	end;

OnDisable:
	stopnpctimer;
	killmonster "moc_fild21","Satan Summon#edq::OnMyMobDead";
	set $@re_moc,0;
	disablenpc "Satan Summon#edq";
	end;

OnMyMobDead:
	set $@re_moc,3;
	set $@re_moc_time$, gettimestr("%H%M%S",7);
	mapannounce "moc_fild21","I'll let live just a little longer. You'll never find me through this time-space gap!",bc_map,"0xFFFF00";
	donpcevent "Time-Space Gap#edq::OnEnable";
	donpcevent "Satan Broadcast#edq::OnDisable";
	disablenpc "Group of Evil#edq";
	stopnpctimer;
	killmonster "moc_fild21","Satan Summon#edq::OnMyMobDead";
	disablenpc "Satan Summon#edq";
	end;

OnTimer5400000:
	mapannounce "moc_fild21","You weaklings can't even scratch me!",bc_map,"0xFFFF00";

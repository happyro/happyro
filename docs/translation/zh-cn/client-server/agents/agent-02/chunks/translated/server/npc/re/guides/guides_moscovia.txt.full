//= 1.0 First version, Renewal guide.
//= 1.1 Optimized (a little bit). [Euphy]
//= 1.2 Navigation system update. [Euphy]
//============================================================ 

moscovia,161,76,3	script	Moscovia Guide#01mosc	959,{
	mes "[莫斯科比亚向导]";
	mes "海上的天堂，";
	mes "美丽的海浪与温暖的阳光。";
	mes "^8B4513莫斯科比亚^000000正在等待你的到来。";
	mes "我会为你提供这里的相关信息。";
	mes "有任何问题都尽管告诉我。";
	F_Navi("[莫斯科比亚向导]");
	set .@str$,"还有什么我能帮你的吗？";
	while (1) {
		next;
		switch(select("[ 卡普拉员工 ]:[ 王宫 ]:[ 小教堂 ]:[ 武器店 ]:[ 防具店 ]:[ 道具店 ]:[ 旅馆 ]:[ 返回艾尔贝塔 ]:移除小地图标记:取消")) {
		case 1:
			mes "[莫斯科比亚向导]";
			mes "^0000FF卡普拉员工^000000已";
			mes "标记在你的小地图上。";
			mes "请查看小地图。";
			mes "还需要其他帮助吗？";
			viewpoint 1,223,191,0,0x0A82FF;
			break;
		case 2:
			mes "[莫斯科比亚向导]";
			mes "在"+F_Navi("王宫","moscovia,255,140","^006400")+"里，你会找到我们的沙皇陛下和其他侍从。";
			mes .@str$;
			viewpoint 1,255,140,1,0x0A82FF;
			break;
		case 3:
			mes "[莫斯科比亚向导]";
			mes F_Navi("小教堂","moscovia,253,179","^008080")+"就在这里。";
			mes .@str$;
			viewpoint 1,253,179,2,0xAAFF00;
			break;
		case 4:
			mes "[莫斯科比亚向导]";
			mes "前往"+F_Navi("武器店","moscovia,186,191","^FF1493")+"，就能向莫斯科比亚最好的工匠购买武器。";
			mes .@str$;
			viewpoint 1,186,191,3,0x008080;
			break;
		case 5:
			mes "[莫斯科比亚向导]";
			mes "莫斯科比亚的"+F_Navi("防具店","moscovia,204,169","^8B4513")+"只出售最好的装备。";
			mes .@str$;
			viewpoint 1,204,169,4,0xB200FF;
			break;
		case 6:
			mes "[莫斯科比亚向导]";
			mes F_Navi("道具店","moscovia,221,176","^FF1493")+"位于城镇中心正南方。";
			mes "你能在那里找到旅行所需的各种物品。";
			mes .@str$;
			viewpoint 1,221,176,5,0xFF1493;
			break;
		case 7:
			mes "[莫斯科比亚向导]";
			mes "旅馆"+F_Navi("黏草树","moscovia,227,206")+"就在城镇中心的北边。";
			mes "如果你需要休息，没有比这里更好的地方了。";
			mes .@str$;
			viewpoint 1,227,206,6,0x8B4513;
			break;
		case 8:
			mes "[莫斯科比亚向导]";
			mes "如果你想返回艾尔贝塔，";
			mes "可以在码头找到";
			mes F_Navi("莫斯科比亚公共关系官","moscovia,166,53")+"。";
			viewpoint 1,166,53,7,0x00BFFF;
			break;
		case 9:
			mes "[莫斯科比亚向导]";
			mes "我会移除小地图上的所有标记。";
			mes .@str$;
			viewpoint 2,1,1,0,0xFFFFFF;
			viewpoint 2,1,1,1,0xFFFFFF;
			viewpoint 2,1,1,2,0xFFFFFF;
			viewpoint 2,1,1,3,0xFFFFFF;
			viewpoint 2,1,1,4,0xFFFFFF;
			viewpoint 2,1,1,5,0xFFFFFF;
			viewpoint 2,1,1,6,0xFFFFFF;
			viewpoint 2,1,1,7,0xFFFFFF;
			break;
		case 10:
			mes "[莫斯科比亚向导]";
			mes "旅途愉快～！";
			close;
		}
	}
}
moscovia,226,191,4	duplicate(Moscovia Guide#01mosc)	Moscovia Guide#02mosc	959

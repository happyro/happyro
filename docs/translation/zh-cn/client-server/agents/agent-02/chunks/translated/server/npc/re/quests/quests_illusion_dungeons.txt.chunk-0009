		mes "*嗅嗅* 是这边！气味从这边传来！";
		close2;
		viewpoint 1,85,131,1,0x00FF00;
		end;
	}
	if (ill_vampire == 14 || ill_vampire == 15) {
		mes "[King]";
		mes "你为什么那样看着我？德古拉需要更多休息。不要打扰他。";
		close;
	}
	// if (ill_vampire == 16) {
	switch( checkquest(14676,PLAYTIME) ) {
	case -1:
		break;
	case 0:
	case 1:
		mes "[Jojo]";
		mes "冒险者，你这么快就回来了。";
		next;
		mes "[King]";
		mes "是啊，你为什么这么快回来？我现在不想被打扰。晚点再来。";
		close;
	case 2:
		mes "[King]";
		mes "冒险者来了！";
		next;
		mes "[Jojo]";
		mes "冒险者来了！";
		next;
		select("你们为什么见到我这么兴奋？" );
		mes "[King]";
		mes "你会像上次一样处理那些哑光吸血蝙蝠，对吧？它们太吵了。";
		next;
		mes "[Jojo]";
		mes "你也会带些^0000cd短蝙蝠毛^000000回来，对吧？我需要的比上次多得多。";
		next;
		mes "[King]";
		mes "^0000cd10只哑光吸血蝙蝠^000000！";
		next;
		mes "[Jojo]";
		mes "先谢谢你了！";
		erasequest 14676;// Break Time
		setquest 14675;// Noisy Neighbors
		close;
	}
	switch( checkquest(14675,HUNTING) ) {
	case -1:
		mes "[Jojo]";
		mes "啊，冒险者。很高兴再见到你！德古拉好多了，不过他整天都在睡觉。";
		next;
		mes "[King]";
		mes "他已经完全康复，但还是不想离开。我不知道他为什么如此迷恋那个变成吸血鬼的人类。";
		next;
		mes "[Jojo]";
		mes "哦，你说的是波米？我以为她和德古拉一样是吸血鬼。";
		next;
		mes "[King]";
		mes "不是所有吸血鬼都一样。我们和她不同。对了，你为什么还在这里？德古拉已经不需要你了。";
		next;
		mes "[Jojo]";
		mes "嗯，这附近有些东西我想研究，而且……";
		next;
		mes "[King]";
		mes "你想找死吗？你没注意到这些蝙蝠又饿又凶吗？这些讨厌的家伙会扑向任何移动的东西！帮我处理它们，好吗？";
		next;
		if (select( "它们很烦人。", "嗯，我有点忙。") == 2) {
			mes "[King]";
			mes "哦，是吗？那就走。快走。";
			next;
			mes "[Jojo]";
			mes "国王，你不用这么刻薄。";
			next;
			mes "[King]";
			mes "是他先对我刻薄的！而且他说自己很忙。所以我才叫他走。快走！";
			close;
		}
		mes "[Jojo]";
		mes "只要待在德古拉和国王身边，它们就不会打扰我。";
		next;
		mes "[King]";
		mes "但它们喝僵尸血！呸！无论多饿我都不会喝死者的血。太可耻了！";
		next;
		mes "[Jojo]";
		mes "所以你讨厌自己的同类。";
		npctalk "什么？你这个人类。", "", bc_self;
		sleep2 1000;
		npctalk "是……？", "Wizard#ilgf02", bc_self;
		sleep2 1000;
		npctalk "我是蝙蝠吗？", "", bc_self;
		sleep2 1000;
		npctalk "...No.", "Wizard#ilgf02", bc_self;
		next;
		mes "[King]";
		mes "如果你忘了，你知道自己为什么还能站在那里呼吸吗？";
		next;
		mes "[Jojo]";
		mes "……怎么会？";
		next;
		mes "[King]";
		mes "因为是我允许的。我让你呼吸，不是因为你值得活着，而是因为我懒得杀你。";
		next;
		emotion ET_SWEAT, getnpcid(0, "Wizard#ilgf02");
		mes "[Jojo]";
		mes "……哦。谢谢你的一切。嗯，我想是时候回到队伍了。";
		next;
		mes "[King]";
		mes "我还在和你说话。你不会因为我是蝙蝠形态就不怕我吧？你们人类真蠢，只看得到表面。";
		npctalk "不，不是这样的。", "Wizard#ilgf02", bc_self;
		next;
		mes "[Jojo]";
		mes "我同意这些蝙蝠是可耻、无耻又恶心的动物。";
		next;
		mes "[King]";
		mes "你刚才叫我恶心的动物？";
		next;
		mes "[Jojo]";
		mes "不，不是你。我说的是哑光吸血蝙蝠。";
			npctalk "很好，因为你可不想惹我生气。", "", bc_self;
		sleep2 1000;
			npctalk "看来你已经把自己认作蝙蝠了。", "Wizard#ilgf02", bc_self;
		sleep2 1000;
			npctalk "什么？", "", bc_self;
		next;
		select("国王，我有个问题。" );
		mes "[King]";
		mes "什么问题？";
		next;
		select("你为什么是蝙蝠形态？" );
		mes "[Jojo]";
		mes "是啊。既然你这么讨厌它们，为什么不变回原来的形态？";
		next;
		mes "[King]";
		mes "因为这个形态更有效率。不用喝很多就能吃饱，不引人注意，而且人们，比如那边那个笨蛋，会对我放松警惕。";
		next;
		mes "[Jojo]";
		mes "我才不是笨蛋。如果是笨蛋就不会成为魔法师。别忘了，是我救了德古拉！";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "但为什么是蝙蝠？还有其他小动物吧。";
		next;
		mes "[King]";
		mes "因为蝙蝠擅长隐匿，而且会飞。说起来，你知道哑光吸血蝙蝠的短毛可以用来制作隐身斗篷吗？";
		next;
		select("嗯？不，我从没听说过。" );
		mes "[Jojo]";
		mes "隐身斗篷？小偷之类的人一定很喜欢。";
		next;
		mes "[King]";
		mes "真不敢相信你这么单纯。";
		next;
		mes "[Jojo]";
		mes "呃，我要怎么得到毛？去猎杀哑光吸血蝙蝠吗？";
		next;
		mes "[King]";
		mes "怎么，你想放弃魔法改行当小偷？";
		next;
		mes "[Jojo]";
		mes "不。但征服大陆上所有地下城、成为最伟大的魔法师一直是我的梦想。";
		next;
		mes "[King]";
		mes "……那是个伟大的梦想，也是个不可能的梦想。不过，任何人都可以有远大的梦想。";
		npctalk "啊，拜托！", "Wizard#ilgf02", bc_self;
		sleep2 1000;
		npctalk "拜托，什么？", "", bc_self;
		next;
		mes "[Jojo]";
		mes "即使不是为了梦想，隐身斗篷在各种情况下也很有用。";
		next;
		mes "[King]";
		mes "我不知道我们之中还有未来的小偷。嗯。";
		next;
		mes "[Jojo]";
		mes "我说了我不是那个意思。冒险者，你忙吗？";
		next;
		mes "[King]";
		mes "什么，你要问他？自己做！";
		next;
		mes "[Jojo]";
		mes "我还有其他事要做。";
		next;
		mes "[King]";
		mes "什么事？吃饭、睡觉和拉屎？";
		next;
		mes "[Jojo]";
		mes "哦，拜托！你知道我一直忙着研究！";
		next;
		mes "[King]";
		mes "你是说，研究我和德古拉。";
		next;
		mes "[Jojo]";
		mes "……你是怎么做到的……？";
		next;
		mes "[King]";
		mes "我一开始就知道了。你的表情太明显，什么都藏不住。我只是觉得你紧张地偷看我们很有趣，所以没说。";
		next;
		mes "[Jojo]";
		mes "……哦。那我可以问你几个问题吗？";
		npctalk "不。", "", bc_self;
		sleep2 1000;
		npctalk "为什么不？！", "Wizard#ilgf02", bc_self;
		next;
		mes "[King]";
		mes "冒险者，你要替他弄蝙蝠毛吗？很好，那就由你处理那些哑光吸血蝙蝠。它们扇翅膀让我晚上睡不着。";
		next;
		mes "[Jojo]";
		mes "你为什么不能自己做？只要动动手指就行。";
		next;
		mes "[King]";
		mes "如果你愿意，我可以对你弹一下手指。";
		next;
		mes "[Jojo]";
		mes "冒险者，请把蝙蝠毛带给我。国王，我是说，国王先生，我需要多少蝙蝠毛？";
		next;
		mes "[King]";
		mes "这取决于你想要什么斗篷。不过用毛制作东西很难。";
		next;
		mes "[Jojo]";
		mes "嗯，好吧，那先请带来^0000cd20根短蝙蝠毛^000000。";
		next;
		mes "[King]";
		mes "另外，猎杀附近的^0000cd哑光吸血蝙蝠^000000。至少要^0000cd10只^000000。";
		next;
		mes "[Jojo]";
		mes "狩猎愉快，冒险者！";
		setquest 14675;// Noisy Neighbors
		npctalk "啊，冒险者！等等！", "Wizard#ilgf02", bc_self;
		close;
	case 0:
	case 1:
		break;
	case 2:
		if (countitem(25263) < 20)
			break;
		mes "[King]";
		mes "你回来得很快。希望你没忘记什么。";
		next;
		mes "[King]";
		mes "魔法师！冒险者把毛带来了。";
		next;
		mes "[Jojo]";
		mes "那我现在该做什么？";
		next;
		mes "[King]";
		mes "你自己想办法。我又不是斗篷制作者，对吧？但我知道你需要的不止这些。";
		next;
		mes "[Jojo]";
		mes "嗯……冒险者？";
		next;
		mes "[King]";
		mes "他刚狩猎回来。至少让他今天剩下的时间休息一下。";
		next;
		mes "[King]";
		mes "冒险者，明天再回来帮我猎杀更多哑光吸血蝙蝠，好吗？没有它们真安静。";
		next;
		mes "[Jojo]";
		mes "那、那明天见，冒险者……";
		delitem 25263,20;// Short_Bat_Fur
		erasequest 14675;// Noisy Neighbors
		setquest 14676;// Break Time
		getexp 500000,500000;
		getitem 25271,1;// Illusion Stone
		close;
	}
	mes "[King]";
	mes "你回来得很快。希望你没忘记什么。";
	next;
	mes "[King]";
	mes "看看你带了什么。你忘了我的要求吗？我说过要^0000cd猎杀10只哑光吸血蝙蝠并带回20根短蝙蝠毛^000000。";
	next;
	mes "[King]";
	mes "去完成吧。";
	close;

OnInit:
	cloakonnpc();

	.@main_completed$ = "isbegin_quest(14666) == 2";
	questinfo( QTYPE_QUEST, QMARK_YELLOW, (.@main_completed$ + " && checkquest(14676,PLAYTIME) == -1 && checkquest(14675,HUNTING) == -1") );
	questinfo( QTYPE_QUEST, QMARK_YELLOW, (.@main_completed$ + " && checkquest(14675,HUNTING) == 2 && countitem(25263) > 19") );
	questinfo( QTYPE_QUEST, QMARK_YELLOW, (.@main_completed$ + " && checkquest(14676,PLAYTIME) == 2") );
	end;
}

gef_d01_i,191,96,3	script	Wizard#ilgf02	4_M_JOB_WIZARD,5,5,{
	if (checkweight(501,1) == 0 || (MaxWeight - Weight) < 1000) {
		mes "[Jojo]";
		mes "你确定能带得动这么多东西吗？为什么不减轻一下背包？";
		close;
	}
	if (ill_vampire < 10) {
		mes "[Jojo]";
		mes "哎呀，我的伤已经完全好了，但还是很痛。";
		close;
	}
	if (ill_vampire == 10) {
		mes "[Jojo]";
		mes "莫乔怎么样了？嘿，她太好奇了，我真替不得不应付她的格林兄弟感到难过。";
		next;
		mes "[Jojo]";
		mes "我暂时还不能离开。这里还有很多事我想了解。";
		close;
	}
	if (ill_vampire == 11) {
		mes "[Jojo]";
		mes "国王闻到了血。虽然他就是这样找到濒死流血的我，但他能做到这一点还是让我害怕。";
		close;
	}
	if (ill_vampire == 12 || ill_vampire == 13) {
		mes "[Jojo]";
		mes "那边某处发生了战斗。你不想去看看吗？";
		close2;
		viewpoint 1,85,131,1,0x00FF00;
		end;
	}
	if (ill_vampire == 14 || ill_vampire == 15) {
		mes "[Jojo]";
		mes "我要在这里待一阵子。德古拉完全恢复能量还需要时间，而且我个人还有很多关于这些人的事想了解。";
		next;
		mes "[Jojo]";
		mes "请告诉宝石修女和莫乔。";
		close;
	}
	// if (ill_vampire == 16) {
	switch( checkquest(14678,PLAYTIME) ) {
	case -1:
		break;
	case 0:
	case 1:
		mes "[Jojo]";
		mes "冒险者，看到这里的荧光了吗？这是你带给我的发光孢子发出的。";
		next;
		mes "[Jojo]";
		mes "在这昏暗的光下学习，让我感觉回到了过去。";
		next;
		mes "[Jojo]";
		mes "这些发光孢子还剩足够的光。请天亮后再回来。";
		close;
	case 2:
		mes "[Jojo]";
		mes "冒险者！你是我生命中的光！";
		next;
		mes "[King]";
		mes "你吓到他了。";
		next;
		mes "[Jojo]";
		mes "今天还能帮我弄些发光孢子吗？";
		next;
		mes "[Jojo]";
		mes "请从霓虹蘑菇那里带来^0000cd10个发光孢子^000000，再从甜蜜梦魇那里带来^0000cd10簇梦魇结晶^000000。谢谢。";
		erasequest 14678;// Time to Study
		setquest 14677;// Studying in Dim Light
		close;
	}
	switch( isbegin_quest(14677) ) {
	case 0:
		mes "[Jojo]";
		mes "冒险者，等等！";
		next;
		mes "[King]";
		mes "你把那个词拼错了。";
		next;
		mes "[Jojo]";
		mes "哪里？哦，我又拼错了。";
		next;
		mes "[King]";
		mes "啧啧，我真不知道你连字都拼不对，怎么能成为魔法师。";
		next;
		mes "[Jojo]";
		mes "只是因为太暗看不清。还有，别偷看我在做什么！";
		next;
		mes "[King]";
		mes "你又不是在写什么重要的东西。";
		next;
		select("你们两个还是和我记得的一样合得来。" );
		mes "[King]";
		mes "你在这里做什么？你没有别的事要做吗？";
		next;
		if (select( "Jojo wanted to see me.", "Actually, I'm busy.") == 2) {
			mes "[Jojo]";
			mes "是吗？我本来想请你帮忙，但可以等。";
			next;
			mes "[King]";
			mes "那你最好去处理自己的事。";
			close;
		}
		mes "[King]";
		mes "为什么？";
		next;
		mes "[Jojo]";
		mes "因为我们在地下，太暗了，我无法读写。我有很多信息要整理，但看不清就总是拼错。";
		next;
		mes "[King]";
		mes "你闭着眼也应该能做到。你是魔法师，难道没学过召唤光？当然，如果你在我面前使用魔法，我会把你烧成灰。";
		npctalk "我……我还是魔法师！", "Wizard#ilgf02", bc_self;
		sleep2 500;
		npctalk "什么？我听不见。", "King#ilgf01", bc_self;
		next;
		mes "[Jojo]";
		mes "我完成了公会的正式魔法师训练课程。我已经强到能和你一决高下！";
		next;
		mes "[King]";
		mes "哦，真的吗？那很好！";
		next;
		mes "[King]";
		mes "不过说实话，你真的努力学习了吗？每节课都参加、整晚学习、刻苦练习了吗？最好告诉我真相。";
		next;
		mes "[King]";
		mes "你能诚实地说自己努力突破极限了吗？";
		next;
		mes "[Jojo]";
		mes "...";
		next;
		mes "[King]";
		mes "不，你没有。所以才会被那些蘑菇打得落花流水。";
		next;
		mes "[Jojo]";
		mes "我说的是僵尸，不是蘑菇！";
		next;
		mes "[King]";
		mes "僵尸和蘑菇。对我来说没什么区别。";
		next;
		mes "[King]";
		mes "你还不够格养活自己。我不敢相信你的公会真的投资培养了你。";
		npctalk "我一直都能养活自己。", "", bc_self;
		sleep2 500;
		npctalk "是啊，才怪。", "King#ilgf01", bc_self;
		next;
		mes "[Jojo]";
		mes "那你呢？我知道你会变身。但你还会什么？";
		npctalk "你真的想让我展示吗？现在？", "King#ilgf01", bc_self;
		sleep2 1000;
		npctalk "...No.", "", bc_self;
		next;
		mes "[King]";
		mes "也许你一直质问我是因为不信任我。那我教你成为人类中最伟大的魔法师，怎么样？这样你会信任我吗？";
		next;
		mes "[Jojo]";
		mes "呃，你要教我？";
		next;
		mes "[King]";
		mes "当然。";
		next;
		mes "[Jojo]";
		mes "为什么？";
		next;
		mes "[King]";
		mes "我学习了很多。你觉得我为什么学习？";
		next;
		mes "[Jojo]";
		mes "为了变得更聪明？";
		next;
		mes "[King]";
		mes "不。因为我无聊得要死！";
		next;
		mes "[Jojo]";
		mes "你拥有无尽的时间。我真羡慕。";
		next;
		mes "[King]";
		mes "如果你不想让我教，也随你。";
		next;
		mes "[Jojo]";
		mes "不，不！我很愿意！但是，你不会要求我用血来交换吧？";
		next;
		mes "[King]";
		mes "*哼* 如果我因为肚子饿就喝任何东西，那不就和那些哑剧吸血鬼没什么两样了吗？";
		npctalk "你刚才把我和僵尸相比？", "", bc_self;
		sleep2 500;
		npctalk "看来你没有我想的那么蠢。", "King#ilgf01", bc_self;
		next;
		select("乔乔？" );
		mes "[Jojo]";
		mes "哦，抱歉，我不是故意让你一直站着。你能弄些霓虹蘑菇的孢子吗？我需要光来读我写的东西。";
		npctalk "为什么要那些？", "King#ilgf01", bc_self;
		next;
		mes "[Jojo]";
		mes "你知道那些孢子会发光。我想用它们照亮这里。";
		next;
		mes "[King]";
		mes "那你自己去拿。别把事情都推给这位冒险者。";
		next;
		mes "[Jojo]";
		mes "哦，嗯……我……霓虹蘑菇……你知道的。";
		npctalk "你说你被僵尸攻击了。", "King#ilgf01", bc_self;
		sleep2 500;
		npctalk "是的。", "", bc_self;
		next;
		mes "[King]";

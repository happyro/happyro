// Blacksmith: 'Welding Mask' Quest
//============================================================
geffen_in,144,166,4	script	Blacksmith	63,{
	mes "[Blacksmith]";
	mes "你从没听说过我？我可是这片土地上的资深铁匠。我在炽热血腥的炉火中度过了 30 年，让钢铁服从我的意志！";
	next;
	mes "[Blacksmith]";
	mes "但是……";
	mes "我正在老去，技艺也随年龄渐渐衰退。因此我为年轻、有热情、前途无量的铁匠发明了一件东西，希望他们也能掌握我的技艺……";
	next;
	switch(select("那是什么？:……")) {
	case 1:
		mes "[Blacksmith]";
		mes "我们铁匠总要在极高温度下加工钢铁，灼热的空气和熔化的金属不是大多数人能够承受的。";
		next;
		mes "[Blacksmith]";
		mes "为了这门技艺，我们美丽而阳刚的脸庞一直处于危险之中……";
		next;
		mes "[Blacksmith]";
		mes "但有了这项奇妙的技术，就不用担心了！看，这就是 ^3355FF焊接面罩^000000！！";
		next;
		mes "[Blacksmith]";
		mes "它用厚重的金属板遮住脸部。确实是人人都该拥有的物品！如果你不需要，也可以送给正在学习锻造的朋友。";
		next;
		mes "[Blacksmith]";
		mes "怎么样？只要给我 ^2244FF50 个钢铁^000000 和 ^4422FF仅 2000 Zeny^000000，我马上就为你制作~！！";
		next;
		switch(select("嗯……不错。好的。:它的原理是什么？")) {
		case 1:
			if ((countitem(999) > 49) && (Zeny > 1999)){
				mes "[Blacksmith]";
				mes "啊，我看得出你欣赏铁匠的作品！好，我马上开始！！";
				next;
				delitem 999,50;  //Steel
				set Zeny,Zeny-2000;
				getitem 2292,1; // Welding_Mask
				mes "[Blacksmith]";
				mes "哈哈哈~！好好使用它吧！";
				close;
			}
			else {
				mes "[Blacksmith]";
				mes "嗯……";
				mes "你没有我需要的物品。";
				next;
				mes "[Blacksmith]";
				mes "普通铁匠可能会把这视为不敬，但我会原谅你。想让我制作面罩的话，别忘了我需要的材料。";
				close;
			}
		case 2:
			mes "[Blacksmith]";
			mes "^3355FF焊接面罩^000000 用厚重的金属板保护你的脸。这项发明是我在铁砧前辛苦锻造 30 年的成果。";
			close;
		}
	case 2:
		mes "[Blacksmith]";
		mes "啊……！";
		mes "我想你一定是第一次遇到像我这么伟大的铁匠，已经敬畏得说不出话了。慢慢来，准备好后再开口吧。";
		next;
		mes "^3355FFThis guy seems";
		mes "有点自负";
		mes "。^000000";
		close;
	}
}

// Eric: 'Headset' Quest
//============================================================
geffen_in,30,71,4	script	Eric	83,{
	mes "[Eric]";
	mes "请听听";
	mes "我的故事";
	mes "关于我那位受祝福的";
	mes "祖父。";
	next;
	switch(select("交谈:询问所需物品:制作:退出")) {
	case 1:
		mes "[Eric]";
		mes "几年前去世的祖父对我来说很特别。他总是陪着我、照顾我，比那个总是忙于工作的老爸好多了。";
		next;
		mes "[Eric]";
		mes "对我来说，祖父的图书馆一直像是可以逃避现实的幻想之地。我大部分时间都在那里度过。";
		next;
		mes "[Eric]";
		mes "我从图书馆里的书中学到了很多东西。祖父对炼金术和音乐很感兴趣，他的图书馆里堆满了神秘的古书。";
		next;
		mes "[Eric]";
		mes "有一天……";
		mes "我像往常一样去了图书馆，发现了一张有趣的设计图。";
		next;
		mes "[Eric]";
		mes "上面画着一种像耳罩的乐器，戴在头上后可以通过细线将音乐或低语传入耳中。";
		next;
		mes "[Eric]";
		mes "我想……";
		mes "那是祖父未完成的作品。我找过几位炼金术士，请他们制作，但他们拒绝了我的请求……";
		next;
		mes "[Eric]";
		mes "最后我想，‘我必须自己做出来。’于是研究了几年，现在已经完全明白制作方法了。但我一直无法收集齐材料！";
		next;
		mes "[Eric]";
		mes "如果能得到那些材料，我马上就能制作。如果你对我的想法感兴趣，可以帮我把它们带来吗？";
		next;
		mes "[Eric]";
		mes "我只想为了纪念祖父制作出它，完成他开始的工作。如果你让我把它送给你，我也不会介意。";
		close;
	case 2:
		mes "[Eric]";
		mes "40 ^3355FFSteel^000000";
		mes "1 ^3355FFOridecon^000000";
		mes "1 ^3355FFAlcohol^000000";
		mes "1 ^3355FFCoal^000000";
		mes "这些就是祖父杰作所需的材料。";
		close;
	case 3:
		if ((countitem(999) > 39) && (countitem(984) > 0) && (countitem(970) > 0) && (countitem(1003) > 0)) {
			delitem 999,40; //Steel
			delitem 984,1; //Oridecon
			delitem 970,1; //Alchol
			delitem 1003,1; //Coal
			getitem 5001,1; //Headset
			mes "*Tap! Tap! Tap!*";
			next;
			mes "[Eric]";
			mes "谢谢你。";
			mes "多亏了你，我实现了祖父的愿望。如果他能在天堂俯视我，一定会很高兴。";
			next;
			mes "[Eric]";
			mes "正如我说的，请收下这个。我能独自完成它，已经感到很自豪了。";
			close;
		}
		else {
			mes "[Eric]";
			mes "谢谢你愿意帮助我，但你没有带齐所需的物品。不过我相信你很快就能找齐。";
			close;
		}
	case 4:
		mes "[Eric]";
		mes "不、不吗？";
		mes "好吧……";
		mes "我想你也有自己的";
		mes "烦恼吧。";
		mes "再见。";
		close;
	}
}

// Number Match Game :: gef_yagu
//============================================================
geffen,122,77,4	script	Nia#yagu	700,{
	mes "[Nia]";
	mes "你好，我是尼娅，游戏大师";
	mes "马翁的第五位弟子。现在，";
	mes "你想和我玩一场";
	mes "数字匹配游戏吗？";
	mes "准备好了吗？";
	next;
	switch(select("Number Match Game?:Practice Number Match:Play Number Match:Record Holder:Cancel")) {
	case 1:
		mes "[Nia]";
		mes "嗯，数字匹配游戏的目标是";
		mes "猜出我正在想的数字。";
		mes "当然，还有一些规则";
		mes "限制我可以选择的数字。";
		mes "这些规则会限制数字。";
		mes "这是我能选择的范围。";
		next;
		mes "[Nia]";
		mes "我组成的数字";
		mes "必须是三位数，不能";
		mes "在任何一位使用 0，";
		mes "也不能使用相同的";
		mes "数字填在不同位上";
		mes "超过一次。";
		next;
		mes "[Nia]";
		mes "例如，我不能";
		mes "使用 103、112、";
		mes "252 或 701。这些数字";
		mes "要么包含 0，要么";
		mes "在各位重复使用了相同数字。";
		mes "现在明白了吗？";
		next;
		mes "[Nia]";
		mes "你只有 5 次猜测机会，";
		mes "每次猜测后，我会告诉你";
		mes "猜对了几位数字，";
		mes "以及其中有几位数字处于";
		mes "正确的位置。";
		next;
		mes "[Nia]";
		mes "例如，假设";
		mes "我想的数字是 168。";
		mes "如果你第一次猜 678，那么猜中了两个数字，";
		mes "6 和 8。但只有";
		mes "8 处于正确的位置。";
		next;
		mes "[Nia]";
		mes "我建议你";
		mes "先试试练习模式。";
		mes "熟悉之后，";
		mes "再玩正式的";
		mes "数字匹配游戏。别忘了速度也会计入分数！";
		next;
		mes "[Nia]";
		mes "如果你在数字匹配游戏中";
		mes "创造新纪录，";
		mes "你的名字就会";
		mes "被记录下来。";
		mes "别错过这个";
		mes "获得名声甚至财富的机会哦~";
		close;
	case 2:
		mes "[Nia]";
		mes "好，我们来玩练习";
		mes "数字匹配。请";
		mes "猜猜我的数字，好吗？";
		mes "如果要取消，请输入大于 1,000 的数字。";
		set .@practice,1;
		break;
	case 3:
		mes "[Nia]";
		mes "好，我们来玩数字匹配！";
		mes "你有 5 次机会猜出我想的数字。";
		mes "如果要取消，请输入大于 1,000 的数字。";
		set .@practice,0;
		break;
	case 4:
		set .@name_record$, $050908_minus1_yagu$;
		if (.@name_record$ == "") //custom
			set .@name_record$,"(null)";
		set .@score_record, $050908_minus1_yagu;
		set .@score_min, .@score_record / 60;
		set .@score_sec, .@score_record % 60;
		mes "[Nia]";
		mes "^ff0000" + .@name_record$ + "^000000 is the";
		mes "数字匹配游戏的纪录保持者，";
		mes "用时为";
		mes "^ff0000" + .@score_min + " 分钟、" + .@score_sec + " 秒^000000。";
		close;
	case 5:
		mes "[Nia]";
		mes "冒险者，请保重。";
		mes "想玩数字匹配游戏时，";
		mes "随时";
		mes "来找我交谈，";
		mes "好吗？再见~";
		close;
	}
	next;

	// Generate 3 digits of a number.
	while(1) {
		set .@yagu100, rand(1,9);
		set .@yagu10, rand(1,9);
		set .@yagu1, rand(1,9);
		if ((.@yagu100 != .@yagu10) && (.@yagu100 != .@yagu1) && (.@yagu10 != .@yagu1)) {
			// Store the actual number (unofficial).
			set .@yagu, (100*.@yagu100) + (10*.@yagu10) + .@yagu1;
			break;
		}
	}

	// The official time calculation is based on ServerTime,
	// an int HHMMSS equivalent to atoi(gettimestr("%H%M%S",7)).
	// UNIX time is really a better way to do this.
	set .@start_time, gettimetick(2);

	while(1) {

		// Guess a number that meets all conditions.
		while(1) {
			if (input(.@input,100,999) != 0) {
				mes "[Nia]";
				mes "你取消了";
				mes "数字匹配游戏。";
				close;
			}
			set .@input100, .@input / 100;
			set .@input10, (.@input % 100) / 10;
			set .@input1, .@input % 10;
			if ((.@input100 > 0) && (.@input10 > 0) && (.@input1 > 0)) {
				if ((.@input100 != .@input10) && (.@input100 != .@input1) && (.@input10 != .@input1))
					break;
			}
			mes "[Nia]";
			mes "你输入的数字包含 0，";
			mes "或在不同位重复使用了";
			mes "相同的数字。";
			mes "请重新";
			mes "猜测。";
			next;
		}

		set .@retry, .@retry+1;
		mes "[Nia]";
		mes "^ff0000"+strcharinfo(0)+"^000000,";
		mes "你的猜测是 ^0000ff"+.@input+"^000000。";
		mes "请稍等，";
		mes "我来计算结果。";
		next;

		// Correct digits in correct locations.
		set .@strike,0;
		if (.@yagu100 == .@input100)
			set .@strike, .@strike+1;
		if (.@yagu10 == .@input10)
			set .@strike, .@strike+1;
		if (.@yagu1 == .@input1)
			set .@strike, .@strike+1;

		// Correct digits in incorrect locations.
		set .@ball,0;
		if ((.@yagu100 == .@input10) || (.@yagu100 == .@input1))
			set .@ball, .@ball+1;
		if ((.@yagu10 == .@input100) || (.@yagu10 == .@input1))
			set .@ball, .@ball+1;
		if ((.@yagu1 == .@input100) || (.@yagu1 == .@input10))
			set .@ball, .@ball+1;

		if (.@strike == 3) {
			if (.@practice) {
				mes "[Nia]";
				mes "没错，我想的数字是";
				mes "^ff0000"+.@yagu+"^000000！";
				mes "恭喜你赢得了";
				mes "这场练习赛！";
				mes "现在你已经准备好";
				mes "挑战正式比赛了~";
				close;
			} else {

				// Calculate final time and check against the previous record.
				set .@end_time, gettimetick(2);
				if (.@end_time < .@start_time)
					set .@end_time, .@end_time + 3600;
				set .@total_time, .@end_time - .@start_time;
				set .@total_min, .@total_time / 60;
				set .@total_sec, .@total_time % 60;
				set .@name_record$, $050908_minus1_yagu$;
				if (.@name_record$ == "") //custom
					set .@name_record$,"(null)";
				set .@score_record, $050908_minus1_yagu;
				set .@score_min, .@score_record / 60;
				set .@score_sec, .@score_record % 60;

				if (.@score_record >= .@total_time || !.@score_record) { //custom (second condition)
					set $050908_minus1_yagu$, strcharinfo(0);
					set $050908_minus1_yagu, .@total_time;
					mes "[Nia]";
					mes "太棒了！你猜中了我的数字，";
					mes "答案是";
					mes "^ff0000" + .@yagu + "^000000。";
					mes "你用时";
					mes "^ff0000" + .@total_min + " 分钟、" + .@total_sec + " 秒^000000，";
					mes "打破了之前";
					mes "^ff0000" + .@score_min + " 分钟、" + .@score_sec + " 秒^000000 的纪录。";
					next;
					mes "[Nia]";
					mes "^ff0000" + .@name_record$ + "^000000";
					mes "创造了那项旧纪录，";
					mes "而现在你成为了";
					mes "数字匹配游戏新的挑战目标。";
					mes "恭喜你创造了新纪录！";
					close;
				}
				mes "[Nia]";
				mes "做得好，你猜中了我的数字！";
				mes "答案当然是 ^ff0000" + .@yagu + "^000000。";
				mes "你成功猜中这个数字，";
				mes "用时";
				mes "^ff0000" + .@total_min + " 分钟、" + .@total_sec + " 秒^000000。";
				next;
				mes "[Nia]";
				mes "^ff0000" + .@name_record$ + "^000000 is";
				mes "是当前数字匹配游戏的";
				mes "纪录保持者，用时";
				mes "^ff0000" + .@score_min + " 分钟、" + .@score_sec + " 秒^000000。";
				mes "祝你好运，希望有一天";
				mes "你能打破这项纪录~";
				close;
			}
		} else {
			if (.@practice) {
				mes "[Nia]";
				mes "你的猜测中有 ^ff0000" + .@ball + "^000000 个数字正确，";
				mes "其中 ^ff0000" + .@strike + "^000000 个数字";
				mes "处于正确的位置。";
				mes "好，";
				mes "再试一次吧~";
				mes "";
				next;
			} else {
				mes "[Nia]";
				mes "你上次的猜测中有 ^ff0000" + .@ball + "^000000 个数字正确，";
				mes "其中 ^ff0000" + .@strike + "^000000 个数字";
				mes "处于正确的位置。";
				mes "";
				mes "";
				switch(.@retry) {
					case 1: mes "You have four guesses left."; break;
					case 2: mes "You have three guesses left."; break;
					case 3: mes "You have two guesses left."; break;
					case 4: mes "You only have one guess left..."; break;
					case 5: mes "The answer was ^ff0000" + .@yagu + "^000000."; close;
				}
				next;
			}
		}
	}
}

//===== rAthena Script =======================================
//= Rock Ridge Guides
//===== Description: =========================================
//= NPC Guide for Rock Ridge
//===== Changelogs: ==========================================
//= 1.0 First Version. [Capuche]
//============================================================

harboro1,356,211,5	script	Guide#rockridge01	4_F_ANYA,{
	mes "[Sheriff Assistant]";
	mes "欢迎来到洛克里奇，这片西部炎热干燥的沙漠正等待着冒险！";
	mes "我是警长助理，负责为访客指路。你想去哪里？";
	next;
	mes "[Sheriff Assistant]";
	mes "告诉我你想去的地方，我会为你指明位置。";
	mes "此外，你还可以通过^B9062F点击我显示的地点名称^000000来使用^B9062F导航^000000模式。";
	while(true) {
		next;
		.@s = select( "[卡普拉员工]", "[旅馆]", "[武器/防具店]", "[道具店]", "[警长办公室]", "清除小地图标记。", "取消。" );
		switch(.@s) {
		case 1:
			mes "[Sheriff Assistant]";
			mes "^006400卡普拉员工^000000，知道了。请点击小地图上的^0000FF箱子图标^000000。";
			viewpoint 1,291,207,1,0xFFFF33;
			break;
		case 2:
			mes "[Sheriff Assistant]";
			mes "我已在小地图上标记了<NAVI>旅馆<INFO>harboro1,156,215,0,000,0</INFO></NAVI>的位置。";
			mes "点击名称即可启用导航模式。";
			viewpoint 1,156,215,2,0xAAFF00;
			break;
		case 3:
			mes "[Sheriff Assistant]";
			mes "我已在小地图上标记了<NAVI>武器/防具店<INFO>harboro1,312,193,0,000,0</INFO></NAVI>的位置。";
			mes "点击名称即可启用导航模式。";
			viewpoint 1,312,193,3,0x008080;
			break;
		case 4:
			mes "[Sheriff Assistant]";
			mes "我已在小地图上标记了<NAVI>道具店<INFO>harboro1,312,193,0,000,0</INFO></NAVI>的位置。";
			mes "点击名称即可启用导航模式。";
			viewpoint 1,312,193,4,0xFF1493;
			break;
		case 5:
			mes "[Sheriff Assistant]";
			mes "我已在小地图上标记了<NAVI>警长办公室<INFO>harboro1,241,218,0,000,0</INFO></NAVI>的位置。";
			mes "点击名称即可启用导航模式。";
			viewpoint 1,241,218,5,0xFFCCFF;
			break;
		case 6:
			mes "[Sheriff Assistant]";
			mes "让我移除小地图上的所有标记。";
			viewpoint 2,291,207,1,0xFFFF33;
			viewpoint 2,156,215,2,0xAAFF00;
			viewpoint 2,312,193,3,0x008080;
			viewpoint 2,312,193,4,0xFF1493;
			viewpoint 2,241,218,5,0xFFCCFF;
			break;
		case 7:
			mes "[Sheriff Assistant]";
			mes "祝你在洛克里奇逗留愉快！";
			close;
		}
		if (.@s == 7)
			mes "还需要别的帮助吗？";
		else
			mes "还想查看其他地方吗？";
	}
}

harboro1,80,211,3	duplicate(Guide#rockridge01)	Guide#rockridge02	4_F_ANYA

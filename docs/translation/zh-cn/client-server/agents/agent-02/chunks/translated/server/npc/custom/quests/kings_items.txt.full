prt_castle,80,170,4	script	King of Prontera	108,{
	mes "[King of Prontera]";
	mes "你好，你能帮帮我吗？";
	next;
	if(select("当然，我能做什么？:抱歉，我很忙。")==2) {
		mes "[King of Prontera]";
		mes "好吧，没关系，我相信会有人帮忙。";
		close; }
	mes "[King of Prontera]";
	mes "谢谢。嗯，我身边的女儿有点任性……";
	mes "如果你能给她找来这些物品，她一定会安静下来。";
	mes "我会把王冠或宝剑作为奖励给你。";
	next;
	setarray .@Items1[0],5007,742,30,741,50,753,20,732,1,710,20,629,20;
	setarray .@Items2[0],1137,2254,1,2282,1,714,1;
	switch(select("你需要什么？:我有这些物品！:算了。")) {
		case 1:
			for(set .@i,1; .@i<3; set .@i,.@i+1) {
				mes "[King of Prontera]";
				mes "如果你能给我找来：";
				for(set .@j,1; .@j<getarraysize(getd(".@Items"+.@i)); set .@j,.@j+2)
					mes " ~ ^0055FF"+getd(".@Items"+.@i+"["+(.@j+1)+"]")+"^000000x "+getitemname(getd(".@Items"+.@i+"["+.@j+"]"));
				mes "我就把我的"+((.@i == 2 )?"宝剑。":"王冠。")+"给你。";
				if (.@i==2) close;
				next; }
		case 2:
			mes "[King of Prontera]";
			mes "你想要哪件物品？";
			next;
			set .@i, select("王冠:宝剑");
			for(set .@j,1; .@j<getarraysize(getd(".@Items"+.@i)); set .@j,.@j+2)
				if (countitem(getd(".@Items"+.@i+"["+.@j+"]")) < getd(".@Items"+.@i+"["+(.@j+1)+"]")) set .@nr,1;
			mes "[King of Prontera]";
			if (.@nr) { 
				mes "你还缺少一些物品。";
				mes "收集齐全部物品后再回来。";
				close; }
			for(set .@j,1; .@j<getarraysize(getd(".@Items"+.@i)); set .@j,.@j+2)
				delitem getd(".@Items"+.@i+"["+.@j+"]"), getd(".@Items"+.@i+"["+(.@j+1)+"]");
			getitem getd(".@Items"+.@i+"[0]"),1;
			mes "非常感谢！！";
			mes "这一定能让她安静下来。";
			mes "如约，这是我的"+((.@i==1)?"王冠。":"宝剑。");
			close;
		case 3:
			mes "[King of Prontera]";
		mes "好吧，没关系，我相信会有人帮忙。";
			close;
	}
}

prt_castle,84,170,4	script	King's Daughter	62,{
	mes "[King's Daughter]";
	mes "哼，我现在讨厌爸爸！！";
	next;
	if(select("为什么？:随便……")==2) {
		mes "[King's Daughter]";
		mes "那就算了！哼！！";
		close; }
	mes "[King's Daughter]";
	mes "他就是不肯给我想要的东西！！";
	mes "他可是普隆德拉国王，应该能给我任何东西！！！";
	close;
}

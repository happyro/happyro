//===== rAthena Script =======================================
//= Magazine Dealers
//===== Description: =========================================
//= Turns bullets into magazines/packs.
//===== Changelogs: ==========================================
//= 1.0 First version. [SinSloth]
//= 1.1 Optimized version - Reduced to only one function [SinSloth]
//= 1.2 Optimized^2, corrected npc's name [ultramage]
//= 1.2a Optimized. Please, ommit extra NPC names [Lupus]
//= 1.3 Updated to match AEGIS script. [Kisuka]
//= 1.4 Updated to match AEGIS script again. [Masao]
//= 1.5 Moved Izlude duplicate to pre-re/re paths. [Euphy]
//= 2.0 Clean-up. [Capuche]
//= 2.1 Fixes Issue #1482, where Rebellion jobs cannot use this npc. [Limestone]
//============================================================

que_ng,187,149,3	script	Magazine Dealer Kenny::mdk	4_M_01,{
	mes "[Kenny]";
	if (BaseClass == Job_Gunslinger) {
		mes "欢迎来到我的弹匣商店。";
		mes "如你所知，大量子弹";
		mes "装入弹匣后会更容易携带。";
		mes "现在，有什么特别想要的吗？";
		mes "请告诉我你的需求。";
		next;
		switch(select("风球弹匣:暗影弹匣:毒球弹匣:水球弹匣:火球弹匣:子弹盒:血腥子弹盒:银色子弹盒:取消")) {
		case 1: callsub S_Casing,13204,12144;// <bullet id>, <pack id>
		case 2: callsub S_Casing,13206,12145;
		case 3: callsub S_Casing,13205,12146;
		case 4: callsub S_Casing,13207,12147;
		case 5: callsub S_Casing,13203,12148;
		case 6: callsub S_Casing,13200,12149;
		case 7: callsub S_Casing,13202,12150;
		case 8: callsub S_Casing,13201,12151;
		case 9:
			mes "[Kenny]";
			mes "如果你发现子弹太多了，";
			mes "就来找我吧。";
			mes "把子弹存进我的弹匣";
			mes "是个聪明的主意。";
			mes "随时欢迎你来。";
			close;
		}
	}
	mes "欢迎来到我的商店。";
	mes "这里为枪手提供弹匣";
	mes "和子弹盒。";
	mes "抱歉，但看起来我的服务";
	mes "对你这位冒险者";
	mes "没有什么用处。";
	next;
	mes "[Kenny]";
	mes "不过，如果你认识枪手，";
	mes "就把他们带来找我吧。";
	mes "子弹永远不会嫌多。";
	mes "我随时欢迎他们。";
	close;

S_Casing:
	.@bullet_id = getarg(0);
	.@pack_id = getarg(1);

	mes "[Kenny]";
	mes "现在，你可以用";
	mes callfunc("F_InsertPlural",500,getitemname(.@bullet_id));
	mes "和 500 Zeny 换取 1 个"+getitemname(.@pack_id)+"，请确认";
	mes "你有足够的子弹";
	mes "和 Zeny 进行兑换。";
	next;
	mes "[Kenny]";
	mes "你可以用"+callfunc("F_InsertPlural",500,getitemname(.@bullet_id))+"和 500 Zeny";
	mes "兑换 1 个"+getitemname(.@pack_id)+"。";
	next;
	mes "[Kenny]";
	mes "记住，我一次最多只能给你";
	mes "50 个弹匣。现在请输入";
	mes "你想要的弹匣数量。";
	mes "如果要取消，只需输入‘0’。";
	mes "请输入数量。";
	next;
	input .@amount;
	mes "[Kenny]";
	if (.@amount > 50 || .@amount == 0) {
		mes "嘿，我不能给你";
		mes "那么多弹匣。";
		mes "请重试，并输入";
		mes "不超过 50 的数字。";
		mes "否则我无法为你兑换。";
	}
	else if (countitem(.@bullet_id) >= (500*.@amount)) {
		if (Zeny >= (500*.@amount)) {
			if (checkweight(.@pack_id,.@amount) == 0) {
				mes "嘿，你的物品栏里";
				mes "塞满了很多垃圾。";
				mes "腾出一些空间后再回来，";
				mes "然后用子弹兑换";
				mes "弹匣，好吗？";
				mes "整理好后再来吧。";
			} else {
				mes "好的，这是你的";
				mes "弹匣。谢谢你光顾我的商店，";
				mes "希望你能明智地使用";
				mes "所有弹药。";
				mes "祝你使用愉快。";
				Zeny = Zeny -500*.@amount;
				delitem .@bullet_id,(500*.@amount);
				getitem .@pack_id,.@amount;
			}
		} else {
			mes "抱歉，你没有足够的 Zeny";
			mes "进行这次弹匣兑换。";
			mes "攒够更多钱后";
			mes "再回我的商店吧。";
			mes "我会等你的。";
			mes "下次见。";
		}
	} else {
		mes "抱歉，你没有足够的子弹";
		mes "进行这次弹匣兑换。";
		mes "也许你应该再检查一下物品栏，";
		mes "稍后再回来找我。";
		mes "确认后再来兑换吧。";
		mes "祝你好运。";
	}
	close;
}

izlude,171,127,3	duplicate(mdk)	Magazine Dealer Kenny#iz	4_M_01

	mes "发生的一切很悲惨，但必须复仇。也许这就是我一直怨恨因布莉亚的原因。总之……";
		next;
		mes "[Father Biscuss]";
	mes "虽然我们不能公开承认，但我谨代表普隆德拉教会感谢你的一切帮助。";
		set prt_curse,36;
		//completequest 18050;
		getexp (checkre(3))?90000:1600000,0;
		close;
	}
	else if (prt_curse == 36) {
		mes "[Father Biscuss]";
	mes "不经历黑暗，就无法理解光明。和平只有与混沌对比才有意义。";
		next;
		mes "[Father Biscuss]";
	mes "在混沌与困境时期，宗教更加重要。我必须保持冷静，尤其是班普神父为整件事感到难过时……";
		close;
	}
	else {
		mes "[Father Biscuss]";
	mes "请在祭司室内保持安静。感谢配合。";
		close;
	}
}

prt_church,177,113,3	script	#gototomb	111,{
	if (prt_curse > 17 && prt_curse < 23 || prt_curse > 31 && prt_curse < 35 || prt_curse == 41 || prt_curse == 42 || prt_curse == 44 || prt_curse == 51 || prt_curse == 52) {
		warp "prt_church",21,91;
	}
	end;
}

prt_church,23,89,3	script	Father Biscuss#tomb	60,{
	mes "[Father Biscuss]";
	mes "嗯……？准备回楼上了吗？";
	next;
	if (select("是:否") == 1) {
		mes "[Father Biscuss]";
		mes "请跟我来。";
		next;
		warp "prt_church",178,111;
		end;
	}
	mes "[Father Biscuss]";
	mes "请慢慢来，尽可能彻底地调查。";
	close;
}

prt_church,16,114,4	script	Father Bamph#tomb	60,{
	if (prt_curse == 18) {
		mes "[Father Bamph]";
		mes "这些是驱魔时被杀的吉欧博格王子遗体。请看看左边的遗体。";
		set prt_curse,19;
		close;
	}
	else if (prt_curse == 19) {
		mes "[Father Bamph]";
		mes "请看看最左边的遗体，也就是第一王子。";
		close;
	}
	else if (prt_curse == 20) {
		mes "["+strcharinfo(0)+"]";
		mes "那个奇怪的印记看起来像蛇鳞。那……那是耶梦加得诅咒留下的印记吗？";
		next;
		mes "[Father Bamph]";
		mes "没错。现在检查中间的第二王子遗体。";
		close;
	}
	else if (prt_curse == 21) {
		mes "[Father Bamph]";
		mes "现在……我们该检查第三王子了。";
		close;
	}
	else if (prt_curse == 22) {
		mes "[Father Bamph]";
		mes "我们上楼继续谈。啊，你可以请比斯库斯神父带路。";
		close;
	}
	else if (prt_curse == 32 || prt_curse == 41 || prt_curse == 51) {
		mes "[Father Bamph]";
		mes "你准备好^3131FF黄色宝石^000000和^3131FF绿色药水^000000了吗？如果准备好了，应先在第三王子遗体上测试。";
		close;
	}
	else if (prt_curse == 33 || prt_curse == 42 || prt_curse == 52) {
		mes "[Father Bamph]";
		mes "印记消失了？哦，这太可怕了！这意味着有人用毒药杀害了其他王子！我几乎……无法……";
		next;
		mes "[Father Bamph]";
		mes "我……我需要时间从震惊中恢复，并仔细思考。现在先回楼上吧。";
		if (prt_curse == 33) set prt_curse,34;
		else if (prt_curse == 42) set prt_curse,43;
		else set prt_curse,53;
		close;
	}
	else if (prt_curse == 43 || prt_curse == 53) {
		mes "[Father Bamph]";
		mes "我们已经充分打扰了这些可怜灵魂的遗体。现在该回楼上了……";
		close;
	}
	end;
}

prt_church,19,111,5	script	#prince1	887,{
	if (prt_curse == 19) {
		mes "[Father Bamph]";
		mes "这是国王的长子、王储的遗体。就像历代发生的那样，诅咒夺走了长子的生命……";
		next;
		mes "^3355FF你在王子袖子下发现一个黑色印记。拉起袖子后，发现印记像蛇鳞。^000000";
		set prt_curse,20;
		//changequest 18037,18038;
		close;
	}
	else if (prt_curse == 33 || prt_curse > 41 && prt_curse < 51 || prt_curse == 52) {
		mes "^3355FF你将黄色宝石和绿色药水制成的溶液滴在皮肤印记上。等了一会儿，溶液没有反应。^000000";
		close;
	}
	else {
		mes "^3355FF这是一个身穿华丽长袍的男性遗体。虽然已经死去，但身体尚未完全失去生命的色彩。";
		close;
	}
}

prt_church,21,111,5	script	#prince2	887,{
	if (prt_curse == 20) {
		mes "[Father Bamph]";
		mes "这是第二王子的遗体。诅咒本应只杀死长子，但这一代的三位王子都被杀了……";
		next;
		mes "[Father Bamph]";
		mes "尽管我们竭力驱除强大的诅咒，仍然失败了。相关人员开始相信奥丁可能抛弃了我们……";
		emotion ET_HUK, playerattached();
		next;
		mes "^3355FF你检查第二王子的遗体，发现他皮肤上的鳞片印记比第一王子的更淡，颜色也略有不同。^000000";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "班普神父……！看，第二王子的印记和第一王子不同！看到了吗？深浅和颜色都不一样。";
		next;
		mes "[Father Bamph]";
		mes "天哪，你说得对！我们怎么会忽略？嗯，这支持有人阴谋作案的想法。去检查第三王子遗体。";
		set prt_curse,21;
		//changequest 18038,18039;
		close;
	}
	else if (prt_curse == 33 || prt_curse > 41 && prt_curse < 51 || prt_curse == 52) {
		specialeffect EF_POISONATTACK;
		specialeffect EF_POISONHIT;
		specialeffect EF_BUBBLE;
		mes "^3355FF你将绿色药水和黄色宝石制成的溶液滴在遗体鳞片印记上。印记变淡，溶液接触时冒泡。";
		close;
	}
	else {
		mes "^3355FF这是一个身穿华丽长袍的男性遗体。虽然已经死去，但身体尚未完全失去生命的色彩。";
		close;
	}
}

prt_church,24,111,5	script	#prince3	887,{
	if (prt_curse == 21) {
		mes "^3355FF你和班普神父匆忙检查第三王子遗体，发现他皮肤上的鳞片印记比第二王子更深。^000000";
		next;
		mes "[Father Bamph]";
		mes "这非常可疑……第二、第三王子的死可能是谋杀，而非诅咒。但究竟什么能杀死他们？";
		next;
		while(1) {
			if (select("武器！:毒药！") == 1) {
				mes "[Father Bamph]";
				mes "嗯……但遗体没有伤口或疤痕。如果是武器，国王肯定会向某人宣战。所以不可能是武器。";
				next;
			}
			else  break;
		}
		mes "[Father Bamph]";
		mes "毒药……？哦，糟糕！普隆德拉教会没人懂毒药。但也许确实用了毒药。怎样才能确定？";
		next;
		mes "[Father Biscuss]";
		mes "我建议你直接找专家。^FF0000摩洛克刺客公会^000000里有人应该知道。我听说他们能制作一滴就杀人的毒药！";
		next;
		mes "[Father Bamph]";
		mes "啊，好主意！不过先到外面继续谈吧？我不想再打扰这些遗体……";
		set prt_curse,22;
		close;
	}
	else if (prt_curse == 22) {
		mes "[Father Bamph]";
		mes "我们上楼继续谈。啊，你可以请比斯库斯神父带路。";
		close;
	}
	else if (prt_curse == 32 || prt_curse == 41 || prt_curse == 51) {
		if (countitem(506) > 0 && countitem(715) > 0) {
			mes "^3355FF你打开一瓶绿色药水并放入黄色宝石。宝石迅速溶解，形成检测毒药的溶液。你将其倒在王子的鳞片印记上。^000000";
			next;
			specialeffect EF_POISONATTACK;
			specialeffect EF_POISONHIT;
			specialeffect EF_BUBBLE;
			mes "^3355FF*Pssssssssh*^000000";
			next;
			mes "^3355FF溶液接触皮肤后冒泡，王子身上的蛇鳞印记逐渐变淡，直至消失。^000000";
			delitem 506,1; //Green_Potion
			delitem 715,1; //Yellow_Gemstone
			if (prt_curse == 32) set prt_curse,33;
			else if (prt_curse == 41) set prt_curse,42;
			else set prt_curse,52;
			//changequest 18046,18047;
			close;
		}
		mes "^3355FF你需要绿色药水和黄色宝石，才能检测并确认第二、第三王子是否死于毒药。^000000";
		close;
	}
	else if (prt_curse == 33 || prt_curse == 42 || prt_curse == 52) {
		mes "^3355FF你将绿色药水与黄色宝石制成的溶液涂在皮肤上后，这位王子身上的蛇鳞印记消失了。^000000";
		close;
	}
	else {
		mes "^3355FF这是一个身穿华丽长袍的男性遗体。虽然已经死去，但身体尚未完全失去生命的色彩。";
		close;
	}
}

moc_fild16,201,295,5	script	Assassin Guildsman#poiso	884,{
	if (prt_curse == 23) {
		mes "[Assassin Guildsman]";
		mes "你来这里有什么事？";
		next;
		if (select("毒药:没什么") == 1) {
			mes "["+strcharinfo(0)+"]";
			mes "我需要和毒药专家谈谈。我正在为普隆德拉教会调查一件事，可能是谋杀案。";
			next;
			mes "[Assassin Guildsman]";
			mes "...";
			mes "......";
			mes ".........";
			next;
			mes "[Assassin Guildsman]";
			mes "仔细听。我只告诉你一次。";
			next;
			mes "[Assassin Guildsman]";
			mes "摩洛克 7 点钟方向有刺客私人酒吧。去里面找名叫^3131FF玛尔佳娜^000000的人。";
			set prt_curse,24;
			//changequest 18040,18041;
			close;
		}
		mes "[Assassin Guildsman]";
		mes "不。看你的眼神，我确定你来这里有原因……";
		close;
	}
	else {
		mes "[Assassin Guildsman]";
		mes "今天很干燥多风。我喜欢这种天气，感觉很符合真正刺客——躲在阴影中的独行者——的灵魂。";
		close;
	}
}

que_job01,10,16,5	script	Marjana#poison	885,{
	if (prt_curse == 24) {
		mes "[Marjana]";
		mes "你来这里有什么事？我给你 4 分钟，说话直接点。";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "我想了解更多毒药，并确认它是否被用来杀人。";
		next;
		mes "[Marjana]";
		mes "毒药？你找对人了。如果我不知道答案，我怀疑你还能找到谁。问吧。";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "刺客的毒药真的强大到一滴就能杀人吗？";
		next;
		mes "[Marjana]";
		mes "确实存在如此强力的毒药，但这种致命毒药通常只有刺客十字使用。一般刺客使用的毒药弱得多。";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "好吧。你能制作在身体上留下特定印记的毒药吗？";
		next;
		mes "[Marjana]";
		mes "当然。世上有各种你无法想象的毒药。不过能留下特定印记的毒药很难使用，能驾驭的人很少。";
		next;
		mes "[Marjana]";
		mes "留下的印记类型取决于制作毒药所用的材料。因为有些材料只在特定地区存在……";
		next;
		mes "[Marjana]";
		mes "嗯，留下的印记类型本身可以成为线索。受害者身上的印记是什么样？";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "我们还不确定是否用了毒药，但遗体上留下了像蛇鳞的印记。";
		next;
		mes "[Marjana]";
		mes "嗯。如果让我猜，我会说……";

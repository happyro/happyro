//===== rAthena Script =======================================
//= Guides WoE TE
//===== Description: =========================================
//= [Official Conversion]
//= NPC Guide for WoE TE
//===== Changelogs: ==========================================
//= 1.0 First Version. [Capuche]
//============================================================

prt_gld,118,151,4	script	Guide in Gloria#tes01	8W_SOLDIER,{
	mes "[Guide Soldier]";
	mes "愿无尽荣耀与卢恩·米德加尔特王国及其七大王室同在！";
	mes "欢迎来到格洛里亚，这座攻城战 TE 的要塞。我们与卡普拉及王国主要王室合作提供服务。";
	next;
	switch( select( "格洛里亚？", "关于攻城战 TE", "关于参加条件", "算了。" ) ) {
	case 1:
		mes "[Guide Soldier]";
		mes "它以七大王室和王国之名命名。";
		mes "整座城市与女武神领域十分相似，这里寄托着王室对所有人的期望。";
		next;
		mes "[Guide Soldier]";
		mes "在由格洛里亚和卡普拉服务管理的艾尔迪巴兰卡普拉花园，我们采用了与现有规则略有不同的特殊规则。";
		mes "我们称之为攻城战 TE。";
		next;
		mes "[Guide Soldier]";
		mes "新规则只是限制参加资格，理解起来应该不会有困难。";
		close;
	case 2:
		mes "[Guide Soldier]";
		mes "这是王室准备的新舞台，让更多人能够参加攻城战。";
		mes "这里采用不同规则，并提供充分支援，因为氛围类似体育馆。";
		next;
		mes "[Guide Soldier]";
		mes "^4d4dff在适用攻城战 TE 规则的格洛里亚和卡普拉花园地区，不允许三转职业及扩展等级职业进入。^000000";
		next;
		mes "[Guide Soldier]";
		mes "此外，我们免费借出各种只能在对应地区使用的战斗装备。";
		mes "这或许是最大的区别。";
		close;
	case 3:
		mes "[Guide Soldier]";
		mes "^4d4dff初心者、一转、二转职业以及扩展职业都可以参加。^000000";
		mes "当然，一转和二转职业也包含在内。";
		next;
		mes "[Guide Soldier]";
		mes "换句话说，三转职业以及影狼、胧等扩展等级职业不允许参加。";
		mes "它们的增益效果在这里也会被消除。";
		next;
		mes "[Guide Soldier]";
		mes "除此之外，与现有攻城战没有太大区别。";
		close;
	case 4:
		mes "[Guide Soldier]";
		mes "愿王室的荣耀与奥丁的庇护与你同在！";
		close;
	}
}

prt_gld,122,151,4	script	Guide in Gloria#tes02	8W_SOLDIER,{
	mes "[Guide Soldier]";
	mes "这里的传送门可以带你进入格洛里亚地区。";
	mes "请记住，你需要通过这里的传送点移动。";
	close;
}

te_prt_gld,118,151,4	script	Guide in Gloria#tes03	8W_SOLDIER,{
	mes "[Guide Soldier]";
	mes "你现在位于格洛里亚要塞。";
	mes "如果想返回女武神领域，可以通过传送点移动。";
	close;
}

te_prt_gld,122,151,4	script	Guide in Gloria#tes04	8W_SOLDIER,{
	mes "[Guide Soldier]";
	mes "欢迎来到格洛里亚。";
	mes "在卡普拉花园和格洛里亚要塞参加攻城战的职业，仅限 ^4d4dff一转、二转以及没有扩展等级的职业。^000000";
	next;
	mes "[Guide Soldier]";
	mes "在卡普拉花园和格洛里亚地区，你会接到独立任务。";
	mes "其中一些与 Emperium 无关，尽管挑战吧！";
	next;
	mes "[Guide Soldier]";
	mes "王室和卡普拉服务为你准备了各种租借物品。";
	mes "虽然租借时间相对较短，但全部免费。不要错过机会！";
	close;
}

alde_gld,228,189,3	script	Sorin of Kafragarten	4_F_KAFRA3,{
	mes "[Sorin]";
	mes "欢迎来到卡普拉服务~ 我们总是为顾客提供最好的服务。";
	mes "卡普拉服务终于建立了自己的要塞！";
	next;
	switch( select( "什么是卡普拉花园？", "什么是攻城战 TE？", "参加资格", "算了。" ) ) {
	case 1:
		mes "[Sorin]";
		mes "这是卡普拉服务与卢恩·米德加尔特王室合作提供的要塞。";
		mes "它的意思是‘卡普拉的花园’。";
		next;
		mes "[Sorin]";
		mes "虽然它看起来与鲁因十分相似，";
		mes "但服务的是不同的用户，所以没关系。";
		mes "可以说，这里是训练舞台。";
		next;
		mes "[Sorin]";
		mes "卡普拉花园建在鲁因地区，而女武神领域则建立了王室的格洛里亚。";
		mes "卡普拉服务希望你能在这座新要塞获得宝贵经验。";
		close;
	case 2:
		mes "[Sorin]";
		mes "攻城战 TE 是^4d4dff只为一转和二转职业设计的攻城战，不包括三转职业。^000000";
		next;
		mes "[Sorin]";
		mes "它是新设立的，旨在让更多用户通过攻城战获得经验。";
		next;
		mes "[Sorin]";
		mes "此外，为了方便你，我们借出各种只能在对应要塞内使用的物品。请好好利用这个机会。";
		next;
		mes "[Sorin]";
		mes "正如人们所说，‘行动胜于言语’。";
		mes "现在就亲自去看看吧~";
		close;
	case 3:
		mes "[Sorin]";
		mes "只有一转、二转，以及没有扩展等级的扩展职业可以参加。";
		next;
		mes "[Sorin]";
		mes "换句话说，三转职业以及影狼、胧等扩展等级职业不允许参加。";
		close;
	case 4:
		mes "[Sorin]";
		mes "卡普拉服务会通过卡普拉花园竭尽全力为你的生活带来欢乐。";
		close;
	}
}

alde_gld,224,185,5	script	Defolty of Kafragarten	4_F_KAFRA1,{
	mes "[Defolty]";
	mes "卡普拉花园就像鲁因的镜像，结构与鲁因完全相同。";
	next;
	mes "[Defolty]";
	mes "你可以通过这里的传送点移动。";
	mes "可以使用传送点前往卡普拉花园。";
	close;
}

te_alde_gld,228,189,3	script	W of Kafragarten#tes01	4_F_KAFRA6,{
	mes "[W]";
	mes "你可以通过这里的传送点前往鲁因。";
	mes "好好利用吧。";
	next;
	mes "[W]";
	mes "谁攻下了以我 W 命名的城堡？";
	mes "嘿嘿，这不就说明我比 Tailing 优秀吗？";
	close;
}

te_alde_gld,224,185,5	script	Tailing of Kafragarten	4_F_KAFRA2,{
	mes "[Tailing]";
	mes "这里是卡普拉花园地区。";
	mes "在卡普拉花园和格洛里亚地区的攻城战中，只有一转、二转以及没有扩展等级的职业可以参加。";
	next;
	mes "[Tailing]";
	mes "……。";
	mes "在卡普拉花园和格洛里亚地区，你会接到独立任务。";
	mes "所以请密切留意。";
	next;
	mes "[Tailing]";
	mes "此外，我们准备了各种战斗装备，你随时可以申请使用。";
	next;
	mes "[Tailing]";
	mes "不过显然，它们只能在卡普拉花园和格洛里亚地区使用。";
	next;
	mes "[Tailing]";
	mes "……。";
	mes "啊，如果你觉得我因为卡普拉花园没有以我命名而生气，说话才变得有些僵硬，";
	next;
	mes "[Tailing]";
	mes "我的天。";
	mes "真的是这样吗？";
	mes "不可能。W 才不比我强……哈哈哈。";
	close;
}

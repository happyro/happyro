		mes "我在家酿酒，晚餐后和朋友分享。";
		next;
		mes "["+ strcharinfo(0) +"]";
		mes "我遇到一位商人，他很想尝尝那种酒。你能卖给我一些吗？";
		next;
		mes "[Foreign Merchant]";
		mes "哦，抱歉，今天已经卖光了。";
		next;
		mes "["+ strcharinfo(0) +"]";
		mes "哦，不……";
		emotion ET_OTL, playerattached();
		next;
		mes "[Foreign Merchant]";
		mes "...............................";
		mes "...............................";
		mes "...............................";
		emotion ET_PROFUSELY_SWEAT;
		next;
		emotion ET_HUK, playerattached();
		mes "[Foreign Merchant]";
		mes "我会留一小瓶酒给自己，所以把那瓶给你吧。";
		mes "我随时可以再酿，也很荣幸你的朋友对我的酒感兴趣。";
		next;
		mes "["+ strcharinfo(0) +"]";
		mes "真的吗？谢谢你！他一定会非常感谢你的慷慨。";
		next;
		mes "[Foreign Merchant]";
		mes "哦，别客气。好了，我该回家了。下次你想要更多时，我会多留一瓶。保重，回头见！";
		emotion ET_FLAG;
		next;
		mes "^3355FF你从老人那里得到了一瓶著名的果酒。那人真不错！^000000";
		set aru_em,7;
		hideonnpc "Foreign Merchant#aru2";
		changequest 2129,2130;
		close;
	}
	else {
		mes "[Foreign Merchant]";
		mes "抱歉，果酒已经卖光了。希望没有给你带来太多不便。";
		close;
	}

OnInit:
	hideonnpc "Foreign Merchant#aru2";
	end;
}

ra_temin,103,151,7	script	Female Follower#em	917,{
	if (aru_em < 9) {
		mes "[Sappie]";
		mes "我努力保持房间干净舒适，让大祭司能在这里安心休息。深吸一口气，闻到那令人放松的香气了吗？";
		close;
	}
	else if (aru_em == 9) {
		mes "[Sappie]";
		mes "我努力保持房间干净舒适，让大祭司能安心休息。深吸一口气，闻到那令人放松的香气了吗？";
		next;
		mes "["+ strcharinfo(0) +"]";
		mes "哦，你说得对，味道真好！那么，尼伦祭司今天不在办公室吗？";
		next;
		mes "[Sappie]";
		mes "是的，她出去了，因为有许多信徒想见她，甚至一大早就来了。";
		next;
		mes "["+ strcharinfo(0) +"]";
		mes "你知道在哪里能找到她吗？";
		next;
		mes "[Sappie]";
		mes "嗯……西皮提到过……啊，对了。西皮说大祭司尼伦去了切斯赫鲁姆尼尔花园。那座花园很大，也很美。";
		next;
		mes "["+ strcharinfo(0) +"]";
		mes "大祭司一定很忙。";
		next;
		mes "[Sappie]";
		mes "哦，你根本想象不到！她从小就向人们传授智慧，如今仍有大批人渴望聆听她的教诲。";
		next;
		mes "[Sappie]";
		mes "如果你真想和她谈话，最好在她被芙蕾雅的信徒包围前找到她。";
		set aru_em,10;
		close;
	}
	else if (aru_em == 10) {
		mes "[Sappie]";
		mes "大祭司尼伦一定在切斯赫鲁姆尼尔花园。你应该在人群出现前去找她。";
		close;
	}
	else if (aru_em > 21) {
		mes "[Sappie]";
		mes "据说女神芙蕾雅曾与教皇交谈，告诉她一条重要消息。现在所有人都想知道芙蕾雅对她说了什么……";
		close;
	}
	else {
		mes "[Sappie]";
		mes "我努力保持房间干净舒适，让大祭司能安心休息。深吸一口气，闻到那令人放松的香气了吗？";
		close;
	}
}

ra_fild03,139,355,5	script	Ishmael#em	914,{
	if (checkweight(907,200) == 0) {
		mes "^3355FF等一下！你现在携带的物品太多了。请使用卡普拉服务存放一些物品后再回来。^000000";
		close;
	}
	if (aru_em < 17) {
		mes "[Ishmael]";
		mes "我、我不认识你，对吧？抱歉，你能……离我远一点吗？我……我不喜欢离陌生人太近。";
		mes "其他人。拜托了！";
		emotion ET_PROFUSELY_SWEAT;
		close;
	}
	else if (aru_em == 17) {
		mes "[Ishmael]";
		mes "我、我不认识你，对吧？抱歉，你能……离我远一点吗？等等，你不是有事要找我吧？";
		emotion ET_PROFUSELY_SWEAT;
		next;
		switch(select("把尼伦的文件给她:别打扰她")) {
		case 1:
			if (countitem(7343) > 0) {
				mes "["+ strcharinfo(0) +"]";
				mes "你认识大祭司尼伦，对吧？这是她给你的。";
				next;
				mes "[Ishmael]";
				mes "哦，真的吗？好吧，只要……把文件扔过来就行。我、我不想让你靠近。";
				emotion ET_PROFUSELY_SWEAT;
				next;
				mes "[Ishmael]";
				mes "我很乐意帮助大祭司。虽然我们是本地人，她从不歧视我们。嗯……她想要什么？";
				next;
				mes "[Ishmael]";
				mes "让我看看……她要我伪造一份文件？小菜一碟，我可是伪造文字的专家！给我一点时间——";
				next;
				emotion ET_HUK;
				mes "[Ishmael]";
				mes "糟糕！我完全忘了！有人昨天偷了我的笔！现在该怎么办……？";
				next;
				emotion ET_CRY;
				mes "[Ishmael]";
				mes "我的笔由一种叫^FF0000红缟玛瑙^000000的稀有宝石制成。*呜* 阿鲁纳佩尔兹好像没人卖红缟玛瑙，只能去邻国找……";
				next;
				mes "[Ishmael]";
				mes "我真的想帮助大祭司尼伦……她一直善待我们，我不能让她失望……";
				set aru_em,18;
				delitem 7343,1; //File02
				changequest 2137,2138;
				close;
			}
			else {
				mes "^3355FF你似乎把尼伦的文件弄丢了……^000000";
				close;
			}
		case 2:
			mes "[Ishmael]";
			mes "我……我没看到你后退。站在那里，别碰我！";
			close;
		}
	}
	else if (aru_em == 18) {
		if (countitem(725) > 0) {
			mes "["+ strcharinfo(0) +"]";
		mes "如果有这块宝石，你能伪造一份大祭司尼伦的文件吗？";
			next;
			mes "[Ishmael]";
		mes "哦，你找到红缟玛瑙了？看起来很完美！";
			next;
			mes "[Ishmael]";
		mes "呃，但是……请你别再靠近。我只是……呃……不是想无礼……只是……我不擅长和人……";
			emotion ET_PROFUSELY_SWEAT;
			next;
			mes "[Ishmael]";
		mes "只要把红缟玛瑙扔过来，我马上就能伪造文件。";
			next;
		switch(select("不给她:给她")) {
			case 1:
				mes "[Ishmael]";
				mes "咦？我以为你需要我的帮助？不给我宝石我什么也做不了。";
				close;
			case 2:
				mes "[Ishmael]";
				mes "耶，太谢谢你了！现在我可以开始工作了~";
				next;
				mes "^3355FF*沙沙*沙沙*^000000";
				specialeffect EF_COMBOATTACK2;
				next;
				mes "^3355FF*沙沙*";
				mes "*沙沙*^000000";
				specialeffect EF_COMBOATTACK4;
				next;
				mes "^3355FF*沙沙*";
				mes "*沙沙*^000000";
				mes "^3355FF*沙沙*";
				mes "*沙沙*^000000";
				specialeffect EF_COMBOATTACK4;
				specialeffect EF_STEAL;
				emotion ET_AHA;
				next;
				mes "[Ishmael]";
				mes "给你！这是我能做出的最高质量副本，因为是大祭司尼伦要求的。请代我向她问好？嘿嘿~";
				next;
				mes "^3355FF你得到了一份由伊什梅尔伪造的书面休假许可文件。^000000";
				delitem 725,1; //Red_Jewel
				set aru_em,19;
				getitem 7343,1; //File02
				changequest 2138,2139;
				close;
			}
		}
		else {
			emotion ET_CRY;
			mes "[Ishmael]";
		mes "要是我有那支红缟玛瑙制成的宝贝笔就好了！呜哇~！";
			close;
		}
	}
	else {
		mes "[Ishmael]";
		mes "大祭司尼伦是个很好的人。有机会我一定要帮她。呃，你能退后一点吗？我不喜欢靠近别人！";
		close;
	}
}


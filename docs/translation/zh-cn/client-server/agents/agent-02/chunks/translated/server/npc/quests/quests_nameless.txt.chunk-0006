que_temsky,100,93,0	script	#em_sky_s	-1,5,2,{
OnTouch:
	if (aru_em == 21) {
		mes "^3355FF大祭司哲德和大祭司尼伦已经抵达，正仔细观察教皇的表情。他们似乎担心接下来会发生什么……^000000";
		next;
		cutin "ra_gman",0;
		mes "[Zhed]";
		mes "您近来可好，陛下？抱歉没能早点拜访您，我一直为自己作为大祭司的能力感到羞愧。";
		next;
		cutin "ra_bishop",2;
		mes "[Pope]";
		mes "大祭司哲德……你来了……谢谢你……";
		next;
		mes "^3355FF教皇看到大祭司哲德，终于再次见到他，脸上露出淡淡的微笑。^000000";
		next;
		cutin "ra_gwoman",0;
		mes "[Niren]";
		mes "陛下……希望您明白，我一直尽力只让您看到世间美好的一面……";
		next;
		cutin "ra_bishop",2;
		mes "[Pope]";
		mes "...............................";
		mes "大祭司尼伦……";
		next;
		cutin "ra_gwoman",0;
		mes "[Niren]";
		mes "然而今天我必须让您了解世界的丑陋。对不起……我今天给天空花园的人放了假，这样我们可以私下告诉您一些事情。";
		next;
		cutin "ra_bishop",2;
		mes "[Pope]";
		mes "尼伦……怎么了？";
		next;
		cutin "ra_gman2",0;
		mes "[Zhed]";
		mes "陛下，接下来要告诉您的事情可能需要您做好心理准备。您也许会大受震惊……";
		next;
		mes "^3355FF大祭司哲德详细解释了阿鲁纳佩尔兹的所有秘密，揭露了祭司中的温和派与强硬派分裂以及腐败……^000000";
		next;
		mes "^3355FF他还说明祭司在雷根贝勒公司进行非人道实验中的作用，以及强硬派祭司在托尔火山争夺权力的情况。^000000";
		next;
		mes "^3355FF教皇听着大祭司哲德的讲述，震惊地凝视着他。^000000";
		next;
		mes "[Zhed]";
		mes "我们都明白您作为教皇已经肩负重任，但我们认为您应该尽快采取行动。";
		next;
		cutin "ra_bishop",2;
		mes "[Pope]";
		mes "...............................";
		mes "...............................";
		mes "...............................";
		next;
		cutin "ra_gwoman",2;
		mes "[Niren]";
		mes "我们无意强迫您，陛下，但时间不多了。我们正面临战争的可能，为拯救阿鲁纳佩尔兹必须阻止它。";
		next;
		mes "[Pope]";
		mes "...............................";
		mes "...............................";
		mes "...............................";
		mes ".......................终于。";
		next;
		cutin "ra_gman2",0;
		mes "[Zhed, Niren]";
		mes "您说什么？";
		next;
		cutin "ra_bishop",2;
		mes "[Pope]";
		mes "尼伦、哲德……我很高兴你们终于来找我解决这一切。";
		mes "我虽然年轻，但还记得在圣地看到的景象。";
		next;
		mes "[Pope]";
		mes "你不记得了吗，尼伦？你在圣地找到我并安全带我离开。但在那里时，我看到了^3131FF尤弥尔之心^000000。";
		mes "[Zhed]";
		mes "你……你怎么知道那是尤弥尔之心？";
		next;
		mes "[Pope]";
		mes "天空中的祭司……";

				else if ((BaseLevel > 75) && (BaseLevel < 97)) {
					mes "[" + .@name$ + "]";
					mes "提升^FF00001 个基础等级^000000后，你就能准备任务。别灰心，我知道你能做到。祝你好运。";
					delitem 7244,1; //Soul_Of_Unity
					set guildrelay_q,14;
					close;
				}
				else if (BaseLevel > 96) {
					mes "[" + .@name$ + "]";
					mes "嗯，你比我预想的强得多。无需我再鼓励你提升力量，我承认你很强。";
					next;
					mes "[" + .@name$ + "]";
					mes "认清力量的范围和极限，但别让自负污染内心。骄傲会束缚力量。记住谦逊。";
					next;
					mes "[" + .@name$ + "]";
					mes "你已经足够合格，值得我信任。请把这个灵魂交给^FF0000公会会长^000000。现在你的任务完成了。";
					delitem 7244,1; //Soul_Of_Unity
					set guildrelay_q,75;
					getitem 7245,1; //Soul_Of_Friendship
					close;
				}
			}

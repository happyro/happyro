				next;
				mes "[" + .@name$ + "]";
				mes "你赢得了我的信任。请把这个灵魂交给^FF0000公会会长^000000。你做得很好。";
				set guildrelay_q,75;
				getitem 7245,1; //Soul_Of_Friendship
				close;
			}
			else if ((BaseLevel < BaseLevel) && (guildrelay_q == 14)) {
				mes "[" + .@name$ + "]";
				mes "我看你完成了我交给你的任务。也许很困难，但你会明白我一直为公会的最大利益着想。";
				next;
				mes "[" + .@name$ + "]";
				mes "你赢得了我的信任。请把这个灵魂交给^FF0000公会会长^000000。你做得很好。";
				set guildrelay_q,75;
				getitem 7245,1; //Soul_Of_Friendship
				close;
			}
			if ((guildrelay_q == 12) && (BaseJob == Job_Wizard)) {
				mes "[" + .@name$ + "]";
				mes "你还不够强，公会无法在危机中完全依靠你。必须提升等级！";
				close;
			}
			else if ((guildrelay_q == 13) && (BaseJob == Job_Wizard)) {
				mes "[" + .@name$ + "]";
				mes "你还不够强，公会无法在危机中完全依靠你。必须提升等级！";
				close;
			}
			else if ((guildrelay_q == 14) && (BaseJob == Job_Wizard)) {
				mes "[" + .@name$ + "]";
				mes "嗯……我认为你还没花够时间升级。继续努力。";
				close;
			}
		}
	}
	else {
		if (is_guild_leader(.@GID) == true) {
			mes "[" + .@name$ + "]";
			mes "嗯，你是另一个公会的会长，对吧？我对你没有忠诚。请离开这里。";
			close;
		}
		else {
			mes "[" + .@name$ + "]";
			mes "嗯？你没有理由继续留在要塞。请现在离开。";
			close;
		}
	}
	if ((guildrelay_q == 71) && (countitem(7241) > 0)) {
		mes "[" + .@name$ + "]";
		mes "你不必继续保管联合之灵。请把它交给公会中的吟游诗人、诗人、舞娘或吉普赛。";
		close;
	}
	else if (guildrelay_q == 71) {
		mes "[" + .@name$ + "]";
		mes "提升自己也会增强公会。要为自己和团队留出时间，两者缺一不可。";
		next;
		mes "[" + .@name$ + "]";
		mes "看来你已经不太需要我了……但我永远会支持你。";
		close;
	}
	if ((guildrelay_q == 72) && (countitem(7242) > 0)) {
		mes "[" + .@name$ + "]";
		mes "你不必继续保管组合之灵。请把它交给公会中的刺客或十字刺客。";
		close;
	}
	else if (guildrelay_q == 72) {
		mes "[" + .@name$ + "]";
		mes "你的歌声鼓舞公会士气，帮助他们站起来战斗，无论局势多么绝望。你的声音能创造奇迹。";
		next;
		mes "[" + .@name$ + "]";
		mes "看来你已经不太需要我了……但我永远会支持你。";
		close;
	}
	if ((guildrelay_q == 73) && (countitem(7242) > 0)) {
		mes "[" + .@name$ + "]";
		mes "你不必继续保管组合之灵。请把它交给公会中的刺客或十字刺客。";
		close;
	}
	else if (guildrelay_q == 73) {
		mes "[" + .@name$ + "]";
		mes "你的舞蹈鼓舞公会士气，帮助他们站起来战斗，无论局势多么绝望。你的舞姿能创造奇迹。";
		next;
		mes "[" + .@name$ + "]";
		mes "看来你已经不太需要我了……但我永远会支持你。";
		close;
	}
	if ((guildrelay_q == 74) && (countitem(7244) > 0)) {
		mes "[" + .@name$ + "]";
		mes "你不必继续保管团结之灵。请把它交给公会中的巫师或高阶巫师。";
		close;
	}
	else if (guildrelay_q == 74) {
		mes "[" + .@name$ + "]";
		mes "看来你已经不太需要我了……但我永远会支持你。";
		next;
		mes "[" + .@name$ + "]";
		mes "认清你的敌人。若有人反对公会，必须毫不犹豫地击溃他们。正义必须迅速执行！";
		close;
	}
	if ((guildrelay_q == 75) && (countitem(7245) > 0)) {
		mes "[" + .@name$ + "]";
		mes "你不必继续保管友谊之灵。请把它交给公会会长。";
		close;
	}
	else if (guildrelay_q == 75) {
		mes "[" + .@name$ + "]";
		mes "我看得出你一直在帮助公会成员。你的忠诚会让他们在欢乐和苦难时都站在你身边。";
		next;
		mes "[" + .@name$ + "]";
		mes "看来你已经不太需要我了……但我永远会支持你。";
		close;
	}
	mes "[" + .@name$ + "]";
	mes "我们之间无事可谈。别来烦我，走你的路吧。";
	close;
}

-	script	GuildDummy4::GuildRelay4	754,{
	set .@name$,strnpcinfo(1);
	getmapxy(.@m$,.@x,.@x,BL_NPC);
	set .@GID, GetCastleData(.@m$,1);
	if (checkweight(1201,1) == 0) {
		mes "^3355FF等一下！你现在携带的物品太多了，请把多余物品存入卡普拉仓库后再回来。^000000";
		close;
	}
	if (.@GID == 0) {
		mes "^3355FF这个疲惫的人注意到你的目光，却选择不理你。要塞里没有其他人，没有理由继续待在这里。^000000";
		close;
	}
	if (getcharid(2) == .@GID) {
		if (is_guild_leader() == true) {
			if (countitem(7246) > 0) {
				mes "[" + .@name$ + "]";
				mes "嗯？你带来的那个灵魂……抱歉，你带着它没有用。";
				next;
				mes "[" + .@name$ + "]";
				mes "请把它交给公会中的^FF0000盗贼^000000或^FF0000神行太保^000000，再让他带给我。";
				close;
			}
			else {
				mes "[" + .@name$ + "]";
				mes "我们之间的事情已经结束了。如果不忙，去帮助你的公会吧，他们一定会感激。";
				close;
			}
		}
		else {
			if ((BaseJob == Job_Rogue) && (countitem(7246) > 0)) {
				mes "[" + .@name$ + "]";
				mes "所以你就是被托付和平之灵的人？那么……你的任务是^FF0000组建";
				switch(rand(1,3)) {
				case 1:
					mes "一支拥有 6 名成员的队伍^000000。";
					mes "不多不少。";
					next;
					mes "[" + .@name$ + "]";
					mes "这是个奇怪的测试，但如果你能做到，就能证明你的待人技巧合格。";
					delitem 7246,1; //Soul_Of_Peace
					set guildrelay_q,91;
					close;
				case 2:
					mes "一支拥有 8 名成员的队伍^000000。";
					mes "不多不少。";
					next;
					mes "[" + .@name$ + "]";
					mes "这是个奇怪的测试，但如果你能做到，就能证明你的待人技巧合格。";
					delitem 7246,1; //Soul_Of_Peace
					set guildrelay_q,92;
					close;

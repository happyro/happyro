dicastes01,191,202,4	script	Complaining Galten#fihs	450,{
	if (isequipped(2782)) {
		mes "[Complaining Galten]";
		mes "那个疯狂的 Vanknick 总是";
		mes "谈论那座雕像的传说。";
		next;
		mes "[Complaining Galten]";
		mes "你和他";
		mes "谈过吗？";
		next;
		if(select("没有:是的") == 1) {
			mes "[Complaining Galten]";
			mes "那么你不知道雕像背后的传说？";
			mes "那我没什么可和你聊的。";
			close; 
		}
		emotion ET_KIK, getnpcid(0, "Crazy Venknick#fihsing1");
		mes "[Complaining Galten]";
		mes "你也被那个疯子骗了。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "是的。";
		emotion ET_CRY, playerattached();
		next;
		mes "[Complaining Galten]";
		mes "为了你好，赶快忘掉这件事吧。";
		close;
	}
	mes "[∋∀⊆ ∪ ]";
	mes "∋∫∩ ∫ ∀∩⊇ ⊇ ";
	mes "∩⊃∩ ⊇ ∧￢∩ ∏ ∬";
	next;
	mes "[∋∀⊆ ∪ ]";
	mes "∝∮∧ ∩ ∋⊇∃";
	mes "∃￢⊂ ∑ ⊇";
	next;
	mes "不知道这是什么意思。";
	close;
}

dicastes01,202,197,4	script	Crazy Venknick#fihsing1	449,{
	if (isequipped(2782)) {
		mes "[Crazy Venknick]";
		mes "只要 5000 Zeny，";
		mes "我就告诉你那座雕像背后的悲伤传说。";
		next;
		if(select("给 5000 Zeny。:不给 5000 Zeny。") == 2) {
			mes "[Crazy Venknick]";
			mes "别带着后悔回来。";
			close; 
		}
		if (Zeny < 5000) {
			mes "[Crazy Venknick]";
			mes "我没有";
			mes "要和穷人分享的传说。";
			mes "";
			close;
			close; 
		}
		set Zeny, Zeny-5000;
		mes "[Crazy Venknick]";
		mes "谢谢。";
		emotion ET_KIK, getnpcid(0, "Complaining Galten#fihs");
		next;
		mes "["+strcharinfo(0)+"]";
		mes "什么悲伤传说？";
		next;
		emotion ET_THINK;
		mes "["+strcharinfo(0)+"]";
		mes "我是问悲伤传说讲的是什么！";
		next;
		mes "[Crazy Venknick]";
		mes "我不相信传说。";
		next;
		emotion ET_THINK, playerattached();
		mes "["+strcharinfo(0)+"]";
		mes "我被骗了吗？";
		sc_start SC_Blind,20000,0;
		next;
		mes "你因被骗而感到愤怒。";
		close; 
	}
	mes "[⊆∪⊃ ∏ ]";
	mes "∑∩∬ ∬ ⊃∃⊂";
	mes "∃∝∑ ∮ ∵⊆∑ ⊂ ∽⊆∧";
	next;
	mes "不知道这是什么意思。";
	close;
}


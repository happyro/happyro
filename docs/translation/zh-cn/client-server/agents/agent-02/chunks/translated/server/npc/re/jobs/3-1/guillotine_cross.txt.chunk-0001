que_job01,75,96,3	script	Guild Member#3rdgc01	997,{
	if (job_3rd_gc == 0) {
		if (Class == Job_Assassin || Class == Job_Assassin_Cross || Class == Job_Baby_Assassin) {
			if (BaseLevel > 98) {
			L_Mission:
				mes "[Ahcart]";
				mes "终于到时候了……";
				mes "嘿，你叫什么名字？";
				next;
				switch(select(strcharinfo(0),".....")) {
				case 1:
					mes "[Ahcart]";
					mes strcharinfo(0)+"？";
					mes "知道了。我会记住你的名字。";
					mes "一位大师告诉我，你是有能力的人。";
					break;
				case 2:
					mes "[Ahcart]";
					mes "什么？你是个多疑的人。";
					mes "嗯，算了。";
					mes "我听说你是有能力的人。";
					break;
				}
				next;
				mes "[Ahcart]";
				mes "我的职责是把公会消息传给有能力的刺客。";
				mes "我认为你适合执行公会的任务。";
				next;
				mes "[Ahcart]";
				mes "那么，你愿意替我们执行这个任务吗？";
				mes "当然，完成任务会有奖励。";
				next;
				select("What is the request?");
				mes "[Ahcart]";
				mes "不清楚。";
				mes "我说过，这是特殊任务。";
				mes "我只知道，必须找来具备大师级能力的人。";
				next;
				mes "[Ahcart]";
				mes "第一，要有耐心。";
				mes "第二，要安静。";
				mes "第三，要专注。";
				next;
				mes "[Ahcart]";
				mes "你怎么看我说的这些？";
				mes "这项任务需要一个不受个人意愿影响也能完成任务的人。";
				next;
				mes "[Ahcart]";
				mes "必须对这项委托保密。";
				mes "不告诉任何人也是你的职责。";
				next;
				mes "[Ahcart]";
				mes "一切由你选择。";
				mes "你愿意帮助我们完成委托吗？";
				next;
				switch(select("I'll do it.:Give me time to think.")) {
				case 1:
					if (VIP_SCRIPT) {
						callfunc "VIP_Third_Class";
						set job_3rd_gc, 3;
						setquest 7101;
						next;
					}
					mes "[Ahcart]";
					mes "好，去Veins。";
					mes "我会联系他们。";
					mes "你的第一项任务是前往Veins。";
					next;
					mes "[Ahcart]";
					mes "你应该很容易找到那里。";
					mes "现在出发吧。";
					set job_3rd_gc, 3;
					setquest 7101;
					close;
				case 2:
					mes "[Ahcart]";
					mes "知道了。";
					mes "但别考虑太久。";
					set job_3rd_gc, 2;
					close;
				}
			}
			mes "[Ahcart]";
			mes "嗯，你是我的同道。";
			mes "我是Ahcart，来自Veins。";
		mes "嗯……";
			next;
			mes "[Ahcart]";
			mes "当然，刺客公会的分部不只在Morocc。如果有机会，去那里看看。";
			mes "我想你可能会去那里。";
			set job_3rd_gc, 1;
			close;
		}
		mes "[A man of a sharp impression]";
		mes "....";
	mes "什么……？";
	mes "你不是刺客。";
		close;
	} else if (job_3rd_gc == 1) {
		if (BaseLevel > 98) goto L_Mission;
		mes "[Ahcart]";
		mes "如果你变得更强、更熟练，刺客公会会给你特殊任务。";
		mes "加油吧。";
		close;
	} else if (job_3rd_gc == 2) {
		mes "[Ahcart]";
		mes "你考虑得怎么样了？";
		next;
		switch(select("I'll do it.:I'm not ready.")) {
		case 1:
			if (VIP_SCRIPT) {
				callfunc "VIP_Third_Class";
				set job_3rd_gc, 3;
				setquest 7101;
				next;
			}
			mes "[Ahcart]";
			mes "好，去Veins。";
			mes "我会联系他们。";
			mes "你的第一项任务是前往Veins。";
			next;
			mes "[Ahcart]";
			mes "你应该很容易找到那里。";
			mes "现在出发吧。";
			set job_3rd_gc, 3;
			setquest 7101;
			close;
		case 2:
			mes "[Ahcart]";
		mes "你太谨慎了。";
		mes "我感觉你不想为我们工作。";
			close;
		}
	} else if (job_3rd_gc == 3) {
		mes "[Ahcart]";
		mes "去Veins找分部。";
		mes "在那里你能听到更多详情。";
		close;
	} else {
		mes "[Ahcart]";
		mes "祝你好运。";
		close;
	}
}

function	script	func_3rdgc	{
	set .@n$, "["+strcharinfo(0)+"]";
	mes .@n$;
	mes "让我收集所有信息……";
	set .@i,0;
	if (checkquest(7112) == 1) { mes "Madelle说深夜看到一个看起来像Rachel牧师的人。"; set .@i,.@i+1; }
	if (checkquest(7113) == 1) { mes "Crave说有个女孩日夜不停地购买许多东西。"; set .@i,.@i+1; }
	if (checkquest(7114) == 1) { mes "Trovan说有个经常出现、却不是酒店客人的男人，所以很可疑。"; set .@i,.@i+1; }
	if (!getarg(0)) {
		set .@i,.@i-2;
		if (checkquest(7115) == 1) { mes "一个穿着破旧的商贩每天都购买新鲜昂贵的东西。"; set .@i,.@i+1; }
		if (checkquest(7116) == 1) { mes "村里的老人说有个女孩总在同一时间出现在同一地点，也许搬到了这里。"; set .@i,.@i+1; }
	}
	next;
	if (.@i == 3) {
		mes .@n$;
		mes "有一天，Madelle看到一个像Rachel牧师的人，";
		mes "而Trovan怀疑那个人为什么会在这里。";
		next;
		mes .@n$;
		mes "但Trovan怀疑他们的原因是……";
		next;
		switch(select("They are unfamiliar:The residence is unclear")) {
		case 1:
			mes .@n$;
			mes "不，不是这个原因。守卫每天都会见到新的冒险者。";
			mes "而且Madelle说是男人，Crave说是女孩。";
			mes "我糊涂了。";
			next;
			mes .@n$;
			mes "让我重新想想。";
			set job_3rd_gc, 7;
			close;
		case 2:
			mes .@n$;
			mes "是啊，冒险者经常来，所以不能算合理理由。";
			next;
			mes .@n$;
			mes "Trovan怀疑的是他的住处不明。但他经常出现，还定期购买物资。";
			next;
			mes .@n$;
			mes "但Crave说是女孩。";
			mes "Madelle说她看到的是男人。";
			next;
			if (getarg(0)) {
				if(select("Madelle witnessed 2...:There are more than 2...") == 1) {
					mes .@n$;
					mes "Madelle说她在黑暗中又看到一个人。";
					mes "那么是女孩带来了物资吗？";
					next;
				}
			}
			else select("It could be a helper.");
			mes .@n$;
			mes "是的，可能还有一个帮手。";
			mes "她派别人代替自己购买东西。";
			mes "或者是Madelle没看到的同伴。";
			next;
			mes .@n$;
			mes "Crave说她日夜都会来这里定期买东西。";
			mes "那我知道该做什么了。";
			set job_3rd_gc, 8;
			close;
		}
	}
	mes .@n$;
	mes "嗯……";
	mes "我需要更多信息吗？我觉得还缺少一些东西。";
	close;
}

job3_guil01,82,95,3	script	Daora#3rdgc02	940,{
	mes "[Daora]";
	if (Class == Job_Assassin || Class == Job_Assassin_Cross || Class == Job_Baby_Assassin) {
		if (job_3rd_gc < 4) {
			if (Sex == SEX_MALE) {
				mes "哦～你真帅！";
				mes "那么，你想要什么？";
			} else {
				mes "嗯，你是女孩。";
				mes "好吧，想拿什么就拿吧。";
			}
			next;
			mes "[Daora]";
			mes "不知道你是否已经知道，我们这里卖特殊的Morocc酒。";
			mes "你想要哪一种？";
			next;
			switch(select("Tropical Sograt:Vermilion on the Beach:No thanks!:......")) {
			case 1:
				mes "[Daora]";
				if (Zeny > 799) {
					mes "给你，拿去吧。";
					set Zeny, Zeny - 800;
					getitem 12112,1; //Tropical_Sograt
					close;
				}
				mes "Tropical Sograt每杯800 Zeny。";
				close;
			case 2:
				mes "[Daora]";
				if (Zeny > 799) {
					mes "给你，拿去吧。";
					set Zeny, Zeny - 800;
					getitem 12113,1; //Vermilion_The_Beach
					close;
				}
				mes "‘沙滩朱红’每杯800 Zeny。";
				close;
			case 3:
				mes "[Daora]";
				mes "别在我面前表现得紧张！";
				specialeffect2 EF_HIT1;
				percentheal -30,0;
				close;
			case 4:
				mes "[Daora]";
				mes "什么？为什么那样看我？";
				mes "哦？你是这个世界的人。";
				mes "你的名字是……";
				next;
				mes "["+strcharinfo(0)+"]";
				mes strcharinfo(0)+".";
				next;
				mes "[Daora]";
				if (job_3rd_gc == 3) {
				mes "啊～我听过你的名字。";
				mes "嗯……没错！";
				mes "Ahcart推荐了你。";
					next;
					mes "[Daora]";
				mes "你能找到角落里的小巷入口吗？";
				mes "进去后，你会听到更详细的故事。";
				mes "接受这个特殊任务吧～！";
					set job_3rd_gc, 4;
					changequest 7101,7102;
					close;
				}
				mes "什么，我不认识这个名字。";
				mes "嘿，我要做生意，能让开吗？";
				close;
			}
		} else if (job_3rd_gc == 4) {
			mes "角落里的房间。随便进去吧，反正没人会进那个房间。";
			mes "还是你需要什么？";
			next;
			mes "[Daora]";
			mes "啊，已经开始特殊任务的人不能买酒。";
			next;
			switch(select("Not selling liquor...:I need information.:Fine then punk!")) {
			case 1:
				mes "[Daora]";
			mes "嘿，你现在正在执行任务。";
			mes "还想让我卖酒给你？！";
			mes "每个刺客都像你一样吗？懒惰的酒鬼？";
				close;
			case 2:
				mes "[Daora]";
			mes "接了任务还敢要求情报。";
			mes "你还没见到大师吗？";
			mes "你问我就会直接告诉你吗！";
			mes "你真幼稚。";
				close;
			case 3:
				mes "[Daora]";
			mes "别把我当朋友一样说话！";
			mes "你没有资格这样对我！";
				specialeffect2 EF_HIT1;
				percentheal -30,0;
				close;
			}
		} else if (job_3rd_gc == 10) {
			mes "哦～！对我来说真好。";
			mes "她是谁？";
			mes "你告诉她我们会保护她？";
			next;
			select("Yes,I did.");
			mes "[Daora]";
			mes "嗯，我明白了……";
			mes "你的意见很重要。";
			mes "知道了。";
			next;
			mes "[Daora]";
			mes "她非常害怕，";
			mes "所以我给她一杯热饮，";
			mes "把她带回了房间。";
			next;
			mes "[Daora]";
			mes "嗯……没有比这个房间更适合监视她的地方了。";
			next;
			select("No, I just protect...");
			mes "[Daora]";
			mes "啊～算了，反正你让我工作了。";
			mes "为了保护那个年轻女孩。";
			next;
			mes "[Daora]";
			mes "Mayshell告诉我必须支持你，所以我不会抱怨。";
			next;
			mes "[Daora]";
			mes "所以，别担心。";
			mes "你是为了她才来这里的吗？";
			mes "去吧。";
			set job_3rd_gc, 11;
			close;
		} else if (job_3rd_gc == 11) {
			mes "她在一个房间里。";
			mes "就在大师房间的对面。";
			mes "你找得到吗？";
			close;
		} else if (job_3rd_gc == 12) {
			mes "那个女孩……";
			mes "要被送回家吗？";
			mes "不用担心。";
			next;
			mes "[Daora]";
			mes "Mayshell和其他人会处理。";
			close;
		} else if (job_3rd_gc == 14) {
			mes "哦，来得正好。";
			mes "Mayshell会叫你。";
			mes "去大师的房间。";
			close;
		} else if (job_3rd_gc > 4 && job_3rd_gc < 18) {
			mes "你需要什么？";
			mes "我们不卖东西给已经开始特殊任务的人。";
			next;
			switch(select("....:Give me 1 glass.:Then, can you give milk?")) {
			case 1:
				mes "[Daora]";
				mes "怎么了？失望吗？";
				mes "嗯～";
				mes "我不能让执行任务的人喝酒。";
				close;
			case 2:
				mes "[Daora]";
				if (job_3rd_gc == 5) {
					mes "我告诉过你不会卖给你。";
					mes "空杯子也可以，不需要酒。";
					mes "我已经说过了……";
					next;
					mes "[Daora]";
					mes "我会告诉你我知道的所有情报。";
					next;
					mes "[Daora]";
					mes "有需要随时来找我，任务结束后我会给你一杯酒。";
					set job_3rd_gc, 6;
					close;
				} else if (job_3rd_gc == 6) {
					if (checkquest(7091) == 1) {
						mes "你希望杯子里能出现什么吗？";
						mes "空杯子里不会冒出情报。";
						close;
					}
					mes "你需要杯子？";
					mes "Mayshell的命令让你分心，所以什么都理解不了。";
					next;
					mes "[Daora]";
					mes "好吧，你想知道什么？";
					mes "你希望杯子里能出现什么吗？";
					next;
					switch(select("Ask for help.:Handle it by yourself.")) {
					case 1:
						mes "[Daora]";
						mes "所以，只是杀死村里的奇怪男人？";
						mes "你为什么因此苦恼？";
						mes "嗯……让我想想……";
						next;
						mes "[Daora]";
						mes "那就需要实地调查？";
						mes "村里最拥挤的地方在哪里？";
						mes "酒吧和旅馆。";
						next;
						mes "[Daora]";
						mes "村里的守卫总会留意奇怪的人。";
						mes "老商人的观察力也很敏锐。";
						next;
						mes "[Daora]";
						mes "尤其可以说……";
						mes "Trovan、商人Crave和酒吧里的Madelle观察力很敏锐。";
						next;
						mes "[Daora]";
						mes "这是有用的情报，对吧？";
						setquest 7091;
						next;
						mes "- 达欧拉的建议贴在任务信息公告板上。-";
						close;
					case 2:
						mes "[Daora]";
						mes "好。很棒。";
						mes "每句话和每个行为都会是事件的重要线索。";
						mes "所以仔细观察，找出答案。";
						next;
						mes "[Daora]";
						mes "好事会发生的。";
						close;
					}
				} else if (job_3rd_gc == 7) {
					mes "你似乎很担心。";
					mes "来，这是冷水。";
					mes "喝冷水冷静地想想。";
					next;
					switch(select("Figure out based on information.:Stop the stage.")) {
					case 1:
						if (checkquest(7091) == 1) set .@j,1;
						callfunc "func_3rdgc",.@j;
						close;
					case 2:
						mes "你停止了信息确认。";
						close;
					}
				} else if (job_3rd_gc == 8) {
					if (checkquest(7092) == 1) {
						mes "在她通常出现的小巷等待，就能继续调查。";
						next;
						mes "[Daora]";
						mes "试试也没坏处。";
						mes "想找到根，就必须先找到叶子。";
						mes "努力吧。";
						close;
					}
					mes "你解决了吗？";
					mes "你打算怎么办？";
					next;
					switch(select("Get advice.:It's a secret.")) {
					case 1:
						mes "[Daora]";
						mes "能告诉我你收集到的情报吗？";
						next;
						if(select("You have a heart-to-heart talk with him.:That's impossible.") == 2) {
							mes "[Daora]";
							mes "什么，我不能好好支持你吗？";
							mes "你自己解决吧。";

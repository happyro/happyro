			mes "[Captain Tigris]";
			mes "礼物不多，但会送给测试成绩优秀的新任符文骑士。";
			next;
			mes "[Captain Tigris]";
			mes "礼物会根据成绩有所不同，但都对符文骑士有帮助。";
			next;
			mes "[Captain Tigris]";
			mes "最后，还有几件事是从骑士转职为英灵殿领主骑士时需要注意的。";
			next;
			callsub L_Warning;
			mes "[Captain Tigris]";
			mes "好了，我的工作完成了。你想开始符文骑士的新生活吗？";
			next;
			switch(select("准备全部完成。:我还需要时间考虑。")) {
			case 1:
				if (SkillPoint != 0 || checkriding()) {
					mes "[Captain Tigris]";
					mes "你没听见吗？";
					next;
					callsub L_Warning;
					mes "[Captain Tigris]";
					mes "明白的话就做好准备再回来。";
					close;
				}
				if (BaseLevel < 99 || JobLevel < 50) {
					mes "[Captain Tigris]";
					mes "看来还不够？";
					close;
				}
				if (ismounting()) {
					mes "[Captain Tigris]";
					mes "请卸下坐骑后再回来。";
					close;
				}
				mes "[Captain Tigris]";
				mes "我们的主人Beljeve……以及大贤者Serpeone……";
				next;
				mes "[Captain Tigris]";
				mes "这位骑士将与我们一同走上符文骑士之路，请赐予祝福。";
				next;
				getitem 5746,1; //Rune_Circlet
				getitem 2795,1; //Green_Apple_Ring
				set job_rune_edq,23;
				completequest 3219;
				jobchange roclass(eaclass()|EAJL_THIRD);
				mes "[Captain Tigris]";
				mes "恭喜。";
				mes "你现在是一名光荣的符文骑士。";
				mes "从今以后记住这一天！";
				next;
				mes "[Captain Tigris]";
				mes "卢恩-米德加尔兹王国为所有新任符文骑士准备了王室礼物。";
				next;
				mes "[Captain Tigris]";
				mes "给我一点时间取王室礼物，再来和我谈。";
				close;
			case 2:
				close;
			}
		}
	}
	mes "[Captain Tigris]";
		mes "我不知道你怎么来到这里的。但看来你来到了不该来的地方。";
	next;
	mes "[Captain Tigris]";
		mes "回到你该去的地方。";
	close2;
	warp "gl_knt02",150,55;
	end;
L_Warning:
	mes "[Captain Tigris]";
		mes "如果你现在装备着任何物品，或手里拿着任何东西，请在转职前清空。";
	next;
	mes "[Captain Tigris]";
		mes "和卡普拉职员交谈使用仓库。";
	next;
	mes "[Captain Tigris]";
		mes "你可能已经知道，如果骑着大嘴鸟，就应该把它留在后面。带来了的话请留下，再回来。";
	next;
	mes "[Captain Tigris]";
		mes "还有一件事。如果有剩余技能点，请全部使用并学习技能。还有技能点就无法转职。";
	next;
	return;
}

job3_rune01,90,50,3	script	Rune Knight Lunarea	469,2,2,{
	if (Class == Job_Rune_Knight || Class == Job_Rune_Knight_T || Class == Job_Baby_Rune_Knight) {
		mes "她安静地抬起下巴，轻轻点头，注意到了我。";
		next;
		mes "片刻后她低下脸，似乎沉浸在其他思绪中。";
		close;
	}
	if (BaseJob == Job_Knight) {
		if (job_rune_edq == 3) {
			mes "她终于开口说话。";
			next;
			mes "[Rune Knight, Lunarea]";
			mes "5分钟……坚持下来并消灭全部目标，就算成功。";
			next;
			mes "[Rune Knight, Lunarea]";
			mes "在这项测试中，我会和Tigris队长、Renoa、Velpino一起前往。";
			next;
			mes "[Rune Knight, Lunarea]";
			mes "如果愿意，可以向我们中的一人求助。但别以为我们总会帮你。";
			next;
			mes "[Rune Knight, Lunarea]";
			mes "既然是测试，是否接受我们的帮助完全由你决定。接受帮助或独自测试都可以。";
			next;
			mes "[Rune Knight, Lunarea]";
			mes "准备前往测试场时和我谈。";
			next;
			switch(select("现在前往测试场。:给我时间准备。")) {
			case 1:
				callsub L_Test,0;
				close;
			case 2:
				close;
			}
		} else if (job_rune_edq == 4) {
			mes "[Rune Knight, Lunarea]";
			mes "失败了吗？不过尝试次数没有限制。";
			next;
			mes "[Rune Knight, Lunarea]";
			mes "想再次参加测试的话，我可以送你去测试场。";
			next;
			mes "[Rune Knight, Lunarea]";
			mes "5分钟……坚持下来并全部消灭它们，就算成功。";
			next;
			mes "[Rune Knight, Lunarea]";
			mes "准备前往测试场时和我谈。";
			next;
			switch(select("现在前往测试场。:请给我时间准备。")) {
			case 1:
				if (checkquest(3220,PLAYTIME) == 1) {
					mes "[Rune Knight, Lunarea]";
					mes "有人进入测试场后，你不能直接进入。测试会逐一进行。";
					next;
					mes "[Rune Knight, Lunarea]";
					mes "轮到你进入时，会直接把你送过去。";
					close;
				}
				callsub L_Test,1;
				close;
			case 2:
				close;
			}
		} else if (job_rune_edq == 5) {
			mes "[Rune Knight, Lunarea]";
			mes "测试成功了吗？";
			next;
			mes "她露出几乎看不见的微笑，看着我。";
			next;
			mes "[Rune Knight, Lunarea]";
			mes "这部分测试结束了。去和Tigris队长谈谈。";
			set job_rune_edq,6;
			changequest 3203,3204;
			close;
		} else if (job_rune_edq > 5) {
			mes "[Rune Knight, Lunarea]";
			mes "这部分测试结束了。去和Tigris队长谈谈。";
			next;
			mes "[Rune Knight, Lunarea]";
			mes "你还需要完成其他测试。希望你表现出色。";
			close;
		}
	}
	mes "这个皮肤苍白、神情恍惚的女符文骑士似乎毫不在意。当然，她似乎也对我的存在不感兴趣。";
	close;
L_Test:
	mes "她点点头，轻轻伸出手。然后拔剑发出信号。";
	if ($@job_rune_test1 == 0) {
		if (getarg(0) == 0) {
			set job_rune_edq,4;
			changequest 3202,3203;
			setquest 3220; // ?
		} else if (checkquest(3220) > -1) {
			erasequest 3220;
			setquest 3220;
		}
		set $@job_rune_test1,1;
		close2;
		warp "job3_rune02",38,40;
		end;
	}
	// Custom translation
	next;
	mes "但她准备说话时，表情突然有些变化。";
	next;
	mes "[Rune Knight, Lunarea]";
	mes "现在……测试房间正被占用……";
	next;
	mes "[Rune Knight, Lunarea]";
	mes "你必须等待……规定要求测试逐一进行。";
	next;
	mes "[Rune Knight, Lunarea]";
	mes "等5分钟就该轮到你了。";
	close;
}

job3_rune01,55,50,3	script	Rune Knight, Renoa	469,2,2,{
	mes "[Rune Knight, Renoa]";
	if (Class == Job_Rune_Knight || Class == Job_Rune_Knight_T || Class == Job_Baby_Rune_Knight) {
		mes "恭喜你成为我们的一员，符文骑士新兵"+strcharinfo(0)+"。";
		next;
		mes "[Rune Knight, Renoa]";
		mes "很快你就会清楚我们该走的道路。";
		next;
		mes "[Rune Knight, Renoa]";
		mes "在那之前，我会留在这里寻找更多像你这样的候选人。";
		close;
	}
	if (BaseJob == Job_Knight) {
		if (job_rune_edq < 7) {
		mes "你就是想成为符文骑士的人吗？今天已经有很多人来了。";
			next;
			mes "[Rune Knight, Renoa]";
		mes "遗憾的是，还没多少候选人通过测试来到我这里，所以我正在休息。";
			next;
			mes "[Rune Knight, Renoa]";
		mes "如果你要参加符文骑士测试，希望你全力以赴。这不会像Lunarea的测试那么容易通过，明白吗？";
			close;
		} else if (job_rune_edq == 7) {
		mes "终于！轮到我了吗？我真高兴。";
			next;
			mes "[Rune Knight, Renoa]";
		mes "太多候选人没通过Lunarea的测试，我已经懒得数了。";
			next;
			mes "[Rune Knight, Renoa]";
		mes "我是Renoa，负责符文骑士候选人的符文与魔法教学和测试。";
			next;
			mes "[Rune Knight, Renoa]";
		mes "感谢你一路参加测试的辛苦。好了，总之。";
			next;
			mes "[Rune Knight, Renoa]";
		mes "首先给你一项作业。让我们从学习开始。去图书馆研读这些书。";
			next;
			mes "[Rune Knight, Renoa]";
		mes "嗯，^0000FF《符文与符文骑士》^000000、^0000FF《符文原理》^000000、^0000FF《符文的制作与使用》^000000。先从这3本开始……";
			next;
			mes "[Rune Knight, Renoa]";
		mes "认真读完书再回来。如果你不喜欢阅读和学习，就很难作为符文骑士生活。";
			next;
			mes "[Rune Knight, Renoa]";
		mes "不用担心，不要求你拥有和Geffen或Juno魔法师一样的知识。但也不能太笨。";
			set job_rune_edq,8;
			changequest 3205,3206;
			close;
		} else if (job_rune_edq > 7 && job_rune_edq < 11) {
			mes "首先给你一项作业。让我们从学习开始。去图书馆研读这些书。";
			next;
			mes "[Rune Knight, Renoa]";
			mes "嗯，^0000FF《符文与符文骑士》^000000、^0000FF《符文原理》^000000、^0000FF《符文的制作与使用》^000000。先从这3本开始……";
			next;
			mes "[Rune Knight, Renoa]";
			mes "认真读完书再回来。如果你不喜欢阅读和学习，就很难作为符文骑士生活。";
			next;
			mes "[Rune Knight, Renoa]";
			mes "不用担心，不要求你拥有和Geffen或Juno魔法师一样的知识。但也不能太笨。";
			close;
		} else if (job_rune_edq == 11) {
			mes "你读完图书馆的所有书了吗？阅读并不容易，但既然决心成为符文骑士，就必须掌握这些基础知识。";
			next;
			mes "[Rune Knight, Renoa]";
			mes "基本上，不经过训练来引出自然与元素的力量，就无法使用魔法。";
			next;
			mes "[Rune Knight, Renoa]";
			mes "因此出现了巫师和贤者等职业，魔法也成了他们的神圣领域。";
			next;
			mes "[Rune Knight, Renoa]";
			mes "符文骑士的领袖Beljeve，据说早在撒旦Morocc复活、灰色废墟的维度之门出现前，就已与精灵接触。";
			next;
			mes "[Rune Knight, Renoa]";
			mes "我从魔法学者那里听说了能将魔法本质实体化的技术。在他们的帮助下，我开始研究如何把它实体化为符文。";
			next;
			mes "[Rune Knight, Renoa]";
			mes "符文骑士就是那项研究的成果，可以使用符文同时施展剑与魔法的力量。";
			next;
			mes "[Rune Knight, Renoa]";
			mes "看起来你不明白，我为什么要重复书中已经写过的故事。";
			next;
			mes "[Rune Knight, Renoa]";
			mes "所以第二项测试，你需要拜访在灰色废墟直接帮助符文骑士诞生的拉比尼魔法学者。";
			next;
			mes "[Rune Knight, Renoa]";
			mes "去找贤者Serpeone，她在灰色废墟的米德加尔营地研究并帮助符文骑士。";
			next;
			mes "[Rune Knight, Renoa]";
			mes "这位贤者已经和我们交流很久了，所以不用担心听不懂Serpeone的语言。";
			next;
			mes "[Rune Knight, Renoa]";
			mes "准备好后我会带你去直接通往Serpeone的传送点。去见她并接受她的指示。";
			set job_rune_edq_book,0;
			set job_rune_edq,12;
			changequest 3206,3207;
			close;
		} else if (job_rune_edq > 11 && job_rune_edq < 14) {
			mes "准备好后我会打开通往灰色废墟米德加尔据点贤者Serpeone的道路。准备好了吗？";
			next;
			switch(select("是的，我准备好了。:还没有。")) {
			case 1:
				mes "[Rune Knight, Renoa]";
				mes "很好。那我现在送你过去。不过有件事要告诉你。";
				next;
				mes "[Rune Knight, Renoa]";
				mes "你会被送往灰色废墟。派往米德加尔据点的人都是认证冒险者和官员。";
				next;
				mes "[Rune Knight, Renoa]";
				mes "Beljeve与其他联盟国家达成协议，保证符文骑士可以自由行动，但是……";
				next;
				mes "[Rune Knight, Renoa]";
				mes "如果想自由穿行灰色废墟，就必须按正常流程取得米德加尔联盟资格。这与我们无关。";
				next;
				mes "[Rune Knight, Renoa]";
				mes "协议只允许我们把候选人送到米德加尔营地，不能去其他地方。";
				next;
				mes "[Rune Knight, Renoa]";
				mes "祝你好运。";
				close2;
				warp "mid_camp",235,250;
				end;
			case 2:
				mes "[Rune Knight, Renoa]";
				mes "准备好后再来找我。我随时有空。";
				close;
			}
		} else if (job_rune_edq == 14) {
			mes "嗯，你回来了？灰色废墟怎么样？";
			next;
			mes "[Rune Knight, Renoa]";
			mes "以你的实力，应该已经去过那里了吧？";
			next;
			mes "[Rune Knight, Renoa]";
			mes "现在该参加符文测试了。我知道你经历了相当复杂的过程。";
			next;
			mes "[Rune Knight, Renoa]";
			mes "我要给你一项让你直接接触符文的测试。";
			next;
			mes "[Rune Knight, Renoa]";
			mes "在这项测试中，你要亲自制作符文石，它也会用于最后的测试。";
			next;
			mes "[Rune Knight, Renoa]";
			mes "如果记得刚才在图书馆读过的内容，就能不用我解释，在这里制作符文石。";
			next;
			mes "[Rune Knight, Renoa]";
			mes "成功制作的符文石会自动成为你转职为符文骑士后使用的符文石，所以请努力。";
			next;
			mes "[Rune Knight, Renoa]";
			mes "你需要制作的符文石总数是20个。";
			mes "请牢记。";
			set job_rune_edq,15;
			changequest 3213,3214;
			close;
		} else if (job_rune_edq == 15) {
			mes "在这项测试中，你要亲自制作符文石，用于最后的测试。";
			next;
			mes "[Rune Knight, Renoa]";
			mes "如果记得刚才在图书馆读过的书，就能不用我解释，在这里制作符文石。";
			next;
			mes "[Rune Knight, Renoa]";
			mes "成功制作的符文石会自动成为你通过测试后使用的符文石，并交给Tigris队长……所以努力吧。";
			next;
			mes "[Rune Knight, Renoa]";
			mes "你总共需要制作20个符文石。请牢记。";
			next;
		switch(select("查看已制作符文数量？:我已经制作了20个符文石。")) {
			case 1:
				mes "[Rune Knight, Renoa]";
				mes "目前制作的符文石数量是" + job_rune_edq2 + "个。";
				close;
			case 2:
				if (job_rune_edq2 < 20) {
					mes "[Rune Knight, Renoa]";
					mes "嘿！我不是说至少要制作20个吗？";
					close;
				}
				if (job_rune_edq2 == 20) {
					mes "[Rune Knight, Renoa]";
					mes "数量刚刚好。我会把完成的符文石交给Tigris队长。";
					next;
				} else {
					mes "[Rune Knight, Renoa]";
					mes "哇！这是什么？你制作了超过20个。现在没关系，但下次记得遵守指示。";
					mes "我会把制作的符文石交给Tigris队长。";
					next;
				}
				mes "[Rune Knight, Renoa]";
				mes "因为还有一项测试会使用这些符文石。";
				next;
				mes "[Rune Knight, Renoa]";
				mes "好了，你通过了。回去找Tigris队长完成下一项测试。";
				next;
				mes "[Rune Knight, Renoa]";
				mes "哈！考虑到我的测试有多难，你做得很好。如果之前紧张，现在可以放松了。";
				set job_rune_edq,16;
				if (job_rune_edq2 == 20)
					changequest 3214,3215;
				close;
			}
		}
		mes "成为一名自豪的符文骑士吧。";
		close;
	}
	mes "怎么……你怎么进来的？！队长，我们有间谍！";
	next;
	mes "[Captain Tigris]";
	mes "啊？你在说什么，Renoa？别这样说！听起来我们像罪犯。";
	next;
	mes "[Rune Knight, Renoa]";
	mes "这里确实有个身份不明的人。";
	next;
	mes "[Captain Tigris]";
	mes "啊……嘿，朋友，过来聊一会儿……";
	close;
}

job3_rune01,58,51,1	script	Rune Furnace	844,{
	if (job_rune_edq < 15) {
		mes "[Rune Knight Renoa]";
		mes "你不想碰那东西。相信我，我不是在开玩笑。";
		close;
	} else if (job_rune_edq == 15) {
		mes "我看到Renoa身后巨型符文石雕像下面有个洞。显然这就是书中写的量产符文加热炉。";
		next;
		if(select("使用符文加热炉:停止。") == 2) close;
		switch(rand(24)) {
			case 0: setarray .@str$[0],"Ehwaz","这个炽热的红色螺旋是……"; break;
			case 1: setarray .@str$[0],"Osilia","这个闪耀着紫色斜线的符文是……"; break;
			case 2: setarray .@str$[0],"Mannaz","这个鲜活的翡翠色菱形符文是……"; break;
			case 3: setarray .@str$[0],"Ansuz","这个闪耀着翡翠色圆形的符文是……"; break;
			case 4: setarray .@str$[0],"Hagalas","这个闪耀着天蓝色星形的符文是……"; break;
			case 5: setarray .@str$[0],"Kano","这个闪耀着红色菱形的符文是……"; break;
			case 6: setarray .@str$[0],"Rhydo","这个闪耀着天蓝色斜线的符文是……"; break;
			case 7: setarray .@str$[0],"Turisus","这个闪耀着黄色圆形的符文是……"; break;
			case 8: setarray .@str$[0],"Dagaz","这个闪耀着翡翠色螺旋线的符文是……"; break;
			case 9: setarray .@str$[0],"Sowilo","这个闪耀着天蓝色扇形的符文是……"; break;
			case 10: setarray .@str$[0],"Laguz","这个闪耀着黄色菱形的符文是……"; break;
			case 11: setarray .@str$[0],"Isia","这个闪耀着紫色螺旋线的符文是……"; break;
			case 12: setarray .@str$[0],"Pertz","这个闪耀着银色螺旋形的符文是……"; break;
			case 13: setarray .@str$[0],"Verkana","这个闪耀着金色星形的符文是……"; break;
			case 14: setarray .@str$[0],"Gebo","这个闪耀着黄色锥形的符文是……"; break;
			case 15: setarray .@str$[0],"Algiz","这个闪耀着翡翠色斜线的符文是……"; break;
			case 16: setarray .@str$[0],"Arwez","这个灰色菱形符文是……"; break;
			case 17: setarray .@str$[0],"Teiwaz","这个闪耀着金色球体的符文是……"; break;
			case 18: setarray .@str$[0],"Wunjo","这个闪耀着翡翠色星形的符文是……"; break;
			case 19: setarray .@str$[0],"Jera","这个闪耀着黄色球体的符文是……"; break;
			case 20: setarray .@str$[0],"Nosiege","这个闪耀着黄色扇形的符文是……"; break;
			case 21: setarray .@str$[0],"Ingz","这个闪耀着紫色菱形的符文是……"; break;
			case 22: setarray .@str$[0],"Fehu","这个闪耀着银色圆形的符文是……"; break;

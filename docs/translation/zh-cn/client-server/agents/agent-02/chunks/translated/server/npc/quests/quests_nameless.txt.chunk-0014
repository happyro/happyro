		mes "[Chief Officer]";
		mes "共有三名成员：路易斯·冯·西洛肯斯（路易斯）、玛莎·赫蒂赞（玛莎），以及卡特菲（卡特菲）。必须抓住卡特菲！";
		changequest 3119,3120;
		set zdan_edq,2;
		close;
	}
	if ((zdan_edq == 1) && (BaseLevel < 70)) {
		mes "[Chief Officer]";
		mes "哦，你对追捕通缉令上的罪犯感兴趣吗？抱歉，你还没准备好承担那种任务……但我鼓励你继续训练！谢谢。";
		close;
	}
	if (zdan_edq == 2) {
		mes "[Chief Officer]";
		mes "你好，卢恩-米德加尔特人。你来这里做什么？";
		next;
		switch(select("国家通缉令:Z 帮:Z 帮犯了什么罪？")) {
		case 1:
			mes "[Chief Officer]";
			mes "啊，你对追捕 Z 帮感兴趣吗？请仔细阅读我旁边的通缉令。我们急需帮助抓住他们。";
			next;
			mes "[Chief Officer]";
			mes "如果想了解 Z 帮更多情况，我建议你和一位叫瓦尔德斯的骑士谈谈。他很熟悉他们的行径。";
			next;
			mes "[Chief Officer]";
			mes "可惜他可能因没能抓住他们而感到羞愧。不过我相信他会帮助你伸张正义。";
			close;
		case 2:
			mes "[Chief Officer]";
			mes "你想了解 Z 帮成员更多情况？我不太了解他们，但可以告诉你我听说的一点消息。";
			next;
			switch(select("路易斯:玛莎:卡特菲:禁忌之谜之书？")) {
			case 1:
				mes "[Chief Officer]";
				mes "路易斯·冯·西洛肯斯是贵族西洛肯斯家族的三子。该家族多年前已衰败。据记录，他三次未能通过魔法学院考试。";
				next;
				mes "[Chief Officer]";
				mes "据说他因个人失败组建了 Z 帮，还从王立图书馆偷走了禁忌之谜之书。";
				next;
				mes "[Chief Officer]";
				mes "我们必须在他滥用书的力量前抓住他并取回书。需要民众帮助找到他，让路易斯接受正义审判！";
				close;
			case 2:
				mes "[Chief Officer]";
				mes "玛莎·赫蒂赞是艾尔贝塔赫蒂赞家族的二女儿。没人知道她二十岁时为何离家出走。";
				next;
				mes "[Chief Officer]";
				mes "玛莎负责 Z 帮的财务。这样有才华的商人竟堕落为盗贼，真令人遗憾。";
				close;
			case 3:
				mes "[Chief Officer]";
				mes "我们起初以为卡特菲只是路易斯和玛莎的宠物猫……但它其实是犯罪大师。接近时务必小心！";
				next;
				mes "[Chief Officer]";
				mes "我只知道这些。卡特菲的真实本性仍笼罩在谜团中。";
				close;
			case 4:
				mes "[Chief Officer]";
				mes "在他们所有罪行中，偷走禁忌之谜之书对王国的威胁最大。若滥用此书，将造成严重灾难。";
				close;
			}
		case 3:
			mes "[Chief Officer]";
			mes "该死的 Z 帮似乎是卢恩-米德加尔特所有犯罪的中心。他们散布鬼魂谣言，在吉芬引发骚乱……";
			next;
			mes "[Chief Officer]";
			mes "他们毒害斐扬水井的饮用水，掠夺无数货物，从非法贸易中获利……罪行数不胜数……";
			next;
			mes "[Chief Officer]";
			mes "在他们所有罪行中，偷走禁忌之谜之书对王国的威胁最大。若滥用此书，将造成严重灾难。";
			close;
		}
	}
	if (zdan_edq == 18) {
		mes "[Chief Officer]";
			mes "哦，你就是前几天来过的那位好心冒险者。有什么我能帮忙的吗？";
		next;
		mes "[Chief Officer]";
			mes "什么？！你真的找到了 Z 帮藏身处，抓住了他们，还取回了禁书？";
		next;
		delitem 7724,1; //Forbidden_Secret_Art
		mes "[Chief Officer]";
			mes "太棒了！我代表国王给你应得的奖励。感谢你为王国所做的一切！";
		next;
		mes "[Chief Officer]";
			mes "你的勇气和热忱将永远记录在卢恩-米德加尔特史册中。恭喜！";
		completequest 3134;
		set zdan_edq,19;
		getexp (checkre(3))?100000:1000000,0;
		close;
	}
	mes "[Chief Officer]";
	mes "所有危害王国和平与安全的人，都将承受正义之剑的怒火！";
	close;
}

prt_in,168,18,1	script	Valdes	65,2,2,{
	if (checkweight(907,100) == 0) {
		mes "^3355FF等一下！你携带的物品太多。请使用卡普拉服务存放一些物品后再回来。^000000";
		close;
	}
	if (zdan_edq == 2) {
		mes "[Valdes]";
		mes "^666666*嗝*^000000 什么？你来……呃，也为人生失败而同情我吗？";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "你是瓦尔德斯吗？我是来请求你帮助的……";
		next;
		mes "[Valdes]";
		mes "^666666*打嗝*^000000 为什么~？我、我已经没用啦！";
		next;
		switch(select("询问 Z 帮:首席官很担心你。:再见！")) {
		case 1:
			mes "[Valdes]";
			mes "那个 Z 帮……毁了我的人生！我的事业、养老金……全被那些该死的罪犯毁了！";
			next;
			mes "[Valdes]";
			mes "你？去抓他们？祝你好运！只要……别落得和我一样。哦，你想要情报？^666666*嗝*^000000 嘿嘿，先帮我挠挠背，后面的你知道。";
			next;
			mes "[Valdes]";
			mes "嘿嘿，我的酒喝完了！给我^0000FF摩洛克果酒^000000！5 瓶！然后……也许……我会告诉你真正想知道的事。嘿嘿~ ^666666*嗝！*^000000";
			changequest 3120,3121;
			set zdan_edq,3;
			close;
		case 2:
			mes "[Valdes]";
			mes "真、真的吗？好吧……我不在乎！让我安静喝酒！";
			close;
		case 3:
			mes "[Valdes]";
			mes "什、什么？你以为你在招惹谁，^666666*嗝！*^000000竟然只是来道别？！我以前可是骑士，知道吗？我能狠狠踢你——^666666*呃！*^000000";
			close;
		}
	}
	if (zdan_edq == 3) {
		mes "[Valdes]";
		mes "嘿——你——~带酒来了吗？";
		next;
		if (countitem(12049) > 4) {
			delitem 12049,5; //Int_Dish04
			mes "[Valdes]";
			mes "^666666*嗅*^000000 哇，闻起来真香。一定是这个。哦，对，骑士的荣誉。先说话，再喝酒……";
			next;
			mes "[Valdes]";
			mes "好吧，也许……就尝一口~^666666*咕咚咕咚*^000000";
			next;
			mes "[" + strcharinfo(0) + "]";
			mes "你刚才……那可是三瓶！";
			next;
			mes "[Valdes]";
			mes "啊，美味！好了，伙计，我感觉好多了，现在能说话了~";
			next;
			mes "[" + strcharinfo(0) + "]";
			mes "(^666666什——么~？^000000)";
			next;
			mes "[Valdes]";
			mes "我想你已经知道 Z 帮及其成员的基本信息。我不明白他们为何突然如此肆无忌惮地犯罪。";
			next;
			mes "[Valdes]";
			mes "他们的成功前所未有，甚至多次躲过流氓公会。我六个月前调查过他们，却因失败被解雇。";
			next;
			mes "[Valdes]";
			mes "我知道 Z 帮雇佣了许多线人，流氓公会仍在自行调查他们。";
			next;
			mes "[Valdes]";
			mes "我建议你去流氓公会见一位叫玛丽贝尔的探员。密码是‘^0000FF黎明尚未来临^000000’。";
			next;
			mes "[Valdes]";
			mes "我只能告诉你这些。替我向玛丽贝尔问好，抓住那些 Z 帮混蛋。^666666*叹气*^000000 我想休息一会儿。祝你好运！";
			changequest 3121,3122;
			set zdan_edq,4;
			close;
		}
		else {
			mes "[Valdes]";
			mes "你这个臭脸！我的酒呢？！^0000FF5 瓶摩洛克果酒^000000呢？！没有酒我不会说话！";
			close;
		}
	}
	if (zdan_edq == 4) {
		mes "[Valdes]";
		mes "我建议你去流氓公会见玛丽贝尔，并告诉她密码‘^0000FF黎明尚未来临^000000’。";
		close;
	}
	mes "[Valdes]";
	mes "^666666*叹气*^000000 我最大的愿望是骑士团长允许我归队。但他可能还没原谅我的失败。^666666*呜咽*^000000 我的生命仿佛结束了……";
	close;

OnTouch:
	if (zdan_edq == 2) {
		mes "[Valdes]";
		mes "^666666*叹气*^000000 该死的小偷。为什么我还要在乎他们？！他们已经不是我的问题了……^666666*打嗝*^000000";
		close;
	}
	end;
}

in_rogue,359,116,3	script	Marybell	747,{
	if (zdan_edq == 4) {
		mes "[Marybell]";
		mes "嘿，你想要什么？";
		next;
		switch(select("密码")) {
		case 1:
			mes "[Marybell]";
			mes "听不见。靠近一点，在我耳边说。";
			next;
			input .@input$;
			if (.@input$ == "The dawn is yet to come.") {
				mes "[Marybell]";
				mes "瓦尔德斯派你来的？！真没想到他终于愿意和别人说话！好吧，既然你是他的朋友，我会尽力帮忙。你需要什么？";
				next;
				switch(select("询问 Z 帮:瓦尔德斯向你问好。")) {
				case 1:
					mes "[Marybell]";
					mes "又是 Z 帮？我想他还在为没能抓住他们生气。告诉你我知道的并不难，但我真的能信任你吗？";
					next;
					mes "[Marybell]";
					mes "让我考验你。去斐扬找一个叫安文浩的老人。他是传奇赌徒，人称白色流星。如果他信任你，我就信任你。";
					next;
					mes "[Marybell]";
					mes "嘿，只有你在赌博中赢过他，他才会信任你。不管你回不回来，我都会继续为流氓公会和瓦尔德斯调查 Z 帮。";
					changequest 3122,3123;
					set zdan_edq,5;
					break;
				case 2:
					mes "[Marybell]";
					mes "奇怪。他平时不会这样问候。该不会生病了吧？下次见到他还在喝酒，我一定揍他！";
					next;
					mes "[Marybell]";
					mes "天啊。他不知道我是为了他才自愿做这工作的吗？算了，知道他还想着我也不错。什么？流氓也可以有朋友！";
					close;
				}
			}
			else {
				mes "[Marybell]";
				mes "听不清你具体在说什么。";
				next;
				if (Sex == SEX_MALE) {
					mes "[Marybell]";
					mes "如果这是奇怪的搭讪，你最好说点更像样的话！";
					close;
				}
				else {
					mes "[Marybell]";
					mes "什么，你在向我示爱？我不在乎性别，不过，嘿嘿，你确定吗？哈哈哈哈哈哈！";
					close;
				}
			}
		}
	}
	if ((zdan_edq > 4) && (zdan_edq < 7)) {
		mes "[Marybell]";
		mes "让我考验你。去斐扬找一个叫安文浩的老人。他是传奇赌徒，人称白色流星。如果他信任你，我就信任你。";
		close;
	}
	if (zdan_edq == 7) {
		mes "[Marybell]";
		mes "什么，你回来了？哎呀！你手臂上的签名……你真的赢了他？怎么做到的——？";
		next;
		set zdan_edq,8;
		mes "[Marybell]";
		mes "等等，让我确认一下。没错，就是这个。这是他作为白色流星时使用的签名。";
		next;
		mes "[Marybell]";
	//

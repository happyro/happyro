				next;
				mes "[Syklah]";
				mes "我不认为你可以随便使用这枚印章。毕竟，这是传说中的物品。";
				next;
				mes "[Syklah]";
				mes "请去拜访居住在朱诺繁荣之岛所罗门的第三贤者^3355FF埃斯克拉^000000。";
				next;
				mes "[Syklah]";
				mes "他会告诉你该在哪里使用这枚印章。不过要小心，他是我们所有贤者中最挑剔的一位。";
				close;
			}
			else {
				mes "[Syklah]";
				mes "希望你尽快带来制作‘穆里涅尔印章墨水’所需的材料。";
				next;
				mes "[Syklah]";
				mes "我需要……";
				mes "^3355FF20个红色药草^000000、";
				mes "^3355FF5块石头^000000和";
				mes "^3355FF1颗石心^000000。";
				close;
			}
		case 27:
			mes "[Syklah]";
			mes "请去繁荣之岛所罗门拜访^3355FF埃斯克拉^000000。但要小心，他是我们中最苛刻的贤者。";
			close;
		}
	}
	else {
		mes "[Syklah]";
		mes "这里的人一直在谈论一个住在朱诺的可疑男子。";
		next;
		mes "[Syklah]";
		mes "据说他相当危险，总是沉浸在某种研究中。";
		next;
		mes "[Syklah]";
		mes "人们已经称他为‘疯狂科学家’，把时间浪费在普通人无法理解的无用研究上。";
		next;
		mes "[Syklah]";
		mes "据说这位科学家制造了由魔法火焰构成的怪物‘火焰怪’。";
		next;
		mes "[Syklah]";
		mes "那是生活在朱诺郊外、会施放火箭术和火球术的危险可怕怪物。";
		close;
	}
}
	
yuno,213,298,4	script	Sage Esklah#juno	735,{
	if (dmdswrd_Q == 27 || dmdswrd_Q == 28 || dmdswrd_Q == 29 || dmdswrd_Q == 30) {
		switch(dmdswrd_Q) {
		case 27:
			mes "[Esklah]";
			mes "嗯……？";
			mes "你一定就是持有穆里涅尔印章的人……";
			next;
			mes "[Esklah]";
			mes "呵，你看起来没什么特别。不过外表普通的你竟然拥有传说物品！";
			next;
			mes "[Esklah]";
			mes "米德加尔特历史上只有少数人被选中使用^3355FF穆里涅尔印章^000000。";
			next;
			mes "[Esklah]";
			mes "不过，我的工作就是测试你是否真正有资格拥有它。";
			next;
			mes "[Esklah]";
			mes "让我告诉你印章工匠^3355FF穆里涅尔^000000的故事。";
			next;
			mes "[Esklah]";
			mes "这个人很久以前住在姆约尔尼尔山某处。他热衷研究，想重现世上存在的每一种图案。";
			next;
			mes "[Esklah]";
			mes "他认为人们会妨碍自己研究图案，于是隐居起来独自钻研。";
			next;
			mes "[Esklah]";
			mes "一天研究图案时，他偶然发现了连接这个世界与另一个世界的魔法阵。";
			next;
			mes "[Esklah]";
			mes "那魔法阵与魔法师、巫师或贤者使用的完全不同，能够召唤来自异世界的邪恶生物。";
			next;
			mes "[Esklah]";
			mes "要召唤生物，必须在完美地点绘制图案。穆里涅尔探索了许多地方，终于找到了目标地点。";
			next;
			mes "[Esklah]";
			mes "他找到的地方如今就是^3355FF穆里涅尔的小屋^000000。但要前往那里，你首先需要^3355FF穆里涅尔罗盘^000000。";
			next;
			mes "[Esklah]";
			mes "呵呵。没错，制作穆里涅尔罗盘就是我对你的考验。";
			next;
			mes "[Esklah]";
			mes "现在仔细听，我不会说第二遍。你需要收集一些物品来制作^3355FF穆里涅尔罗盘^000000。";
			next;
			mes "[Esklah]";
			mes "带给我……";
			mes "^3355FF2块铁矿石^000000、";
			mes "^3355FF10个橡子^000000和";
			mes "^3355FF5根腐朽的钉子^000000。";
			next;
			mes "[Esklah]";
			mes "对于寻找诅咒之剑的人来说，这应该是相对简单的任务。现在去把我要的东西带来。";
			set dmdswrd_Q,28;
			close;
		case 28:
			if (countitem(1002) > 1 && countitem(1026) > 9 && countitem(957) > 4) {
				mes "[Esklah]";
				mes "让我看看。";
				mes "2块铁矿石……";
				mes "10个橡子……";
				mes "5根腐朽的钉子……";
				mes "很好，东西齐了！";
				delitem 1002,2; //Iron_Ore
				delitem 1026,10; //Acorn
				delitem 957,5; //Decayed_Nail
				next;
				mes "[Esklah]";
				mes "干得好。现在我来制作罗盘主体，你去把剩下的材料带来。";
				next;
				mes "[Esklah]";
				mes "呜哈哈哈哈！你那是什么表情？你知道这种事情就是这么办的！";
				next;
				mes "[Esklah]";
				mes "别再抱怨了，";
				mes "去带来……";
				mes "^3355FF2个布里甘^000000和";
				mes "^3355FF1个普拉康^000000。";
				mes "这不是很简单吗？";
				mes "呜哈哈哈哈！！";
				set dmdswrd_Q,29;
				close;
			}
			mes "[Esklah]";
			mes "仔细听好，我不会说第二遍。我需要一些物品来制作^3355FF穆里涅尔罗盘^000000。";
			next;
			mes "[Esklah]";
			mes "带给我……";
			mes "^3355FF2块铁矿石^000000、";
			mes "^3355FF10个橡子^000000和";
			mes "^3355FF5根腐朽的钉子^000000。";
			close;
		case 29:
			if (countitem(7054) > 1 && countitem(1010) > 0) {
				mes "[Esklah]";
				mes "现在……";
				mes "让我看看";
				mes "你带来的东西。";
				mes "2个布里甘，还有……";
				mes "1个普拉康。嗯，很好。";
				mes "现在让我开始工作。";
				delitem 7054,2; //Brigan
				delitem 1010,1; //Phracon
				next;
				mes "[Esklah]";
				mes "嗯……";
				mes "让我看看……";
				mes "好了，完成了。";
				next;
				mes "^3355FF贤者埃斯克拉把^3355FF穆里涅尔罗盘^000000交给了你。";
				next;
				mes "^3355FF罗盘指向的方向刻着一些文字……^000000";
				next;
				mes "^3355FF- Mountain Mjornir -^000000";
				mes "^3355FF- mjolnir_02 . 170 193 -^000000";
				next;
				mes "[Esklah]";
				mes "仔细查看罗盘中央，找到必须使用印章的地方。祝你旅途好运。";
				set dmdswrd_Q,30;
				close;
			}
			mes "[Esklah]";
			mes "仔细听好！";
			mes "我要你带来……";
			mes "^3355FF2个布里甘^000000和";
			mes "^3355FF1个普拉康^000000";
			mes "这不是很简单吗？";
			mes "呜哈哈！现在快去！";
			close;
		case 30:
			mes "^3355FF你查看穆里涅尔罗盘，记下上面的刻字……^000000";
			next;
			mes "^3355FF- Mountain Mjornir -^000000";
			mes "^3355FF- mjolnir_02 . 170 193 -^000000";
			close;
		}
	}
	else {
		mes "[Esklah]";
		mes "我记得曾看见一张无害的";
		mes "纸片";
		mes "在空中飘浮……";
		next;
		mes "[Esklah]";
		mes "我正想着那画面多么诗意时，纸片突然袭击了我！袭击朱诺最伟大的贤者之一！";
		next;
		mes "[Esklah]";
		mes "我试图用可靠的剑防御，但那怪物薄如纸片，躲过了我所有攻击。我只好施法消灭它。";
		next;
		mes "[Esklah]";
		mes "后来我得知，那怪物名为^3355FF纸片^000000。";
		next;
		mes "[Esklah]";
		mes "它原本是一本记载朱诺古老知识的旧书的一部分，却不知怎的变成了怪物。很奇怪吧？";
		close;
	}
}
	
mjolnir_02,170,193,4	script	Muriniel's Cottage#juno	111,{
	if (dmdswrd_Q == 30 || dmdswrd_Q == 31) {
		switch(dmdswrd_Q) {
		case 30:
			mes "^3355FF木地板上刻着穆里涅尔的图案。^000000";
			next;
			mes "^3355FF你使用^9999FF穆里涅尔印章^3355FF和^9999FF穆里涅尔印章墨水^3355FF，将印章嵌入地板上的图案。^000000";
			next;
			mes "^3355FF*Woon Woon*^000000";
			next;
			mes "^3355FF你隐约听见远处有人轻声说话。^000000";
			next;
			mes "[Muriniel's Recording]";
			mes "来自未来的你，请允许我自我介绍。";
			next;
			mes "[Muriniel's Recording]";
			mes "我叫穆里涅尔，是生活在你们过去的印章工匠。感谢你克服重重困难来到这里。";
			next;
			mes "[Muriniel's Recording]";
			mes "不过，你必须先证明自己有资格 wield 诅咒之剑的强大力量。";
			next;
			mes "[Muriniel's Recording]";
			mes "朱诺的伟大贤者帮助我在小屋安装了这个魔法系统，好向未来的冒险者你留下讯息。";
			next;
			mes "[Muriniel's Recording]";
			mes "我知道你想通过获得诅咒之剑来寻求更强力量。但不是任何人都能驾驭它的威力。";
			next;
			mes "[Muriniel's Recording]";
			mes "如果这股力量落入邪恶之手，后果不堪设想。我准备的考验要等炎热夏季之后的秋天到来才能开始。";
			next;
			mes "[Muriniel's Recording]";
			mes "我会给你一件物品，作为未来将交给你的任务的凭证。等树木开始落叶时，回到这里……";
			next;
			mes "[Muriniel's Recording]";
			mes "在那之前做好准备，并活下去。";
			next;
			mes "^3355FF*Bzzzt!*";
			mes "*Bzzzzzzt--*^000000";
			next;
			mes "^3355FF突然，穆里涅尔印章和穆里涅尔罗盘裂开，露出一个小小的发光物体。^000000";
			next;
			mes "^3355FF你获得了^9999FF穆里涅尔的尊严^000000。";
			set dmdswrd_Q,31;
			close;
		case 31:
			mes "^3355FF你隐约听见某处传来的声音……^000000";
			next;
			mes "[Muriniel's Recording]";
			mes "请记得在树木开始落叶时回到这里。在那之前做好准备并活下去。";
			close;
		}
	}
	else {
		mes "‘穆里涅尔的小屋’";
		next;
		mes "^3355FF不知为何，这里写着那段讯息。但这样一间小屋究竟有什么意义？^000000";
		close;
	}
}

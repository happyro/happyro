		close;
	}
}

mid_campin,85,118,7	script	Instructor Igrid	751,{
	if ((ep13_1_edq == 13) || (ep13_1_edq == 14)) {
		mes "[Instructor Igrid]";
		mes "嘿，新兵们。我猜你们很幸运地完成了任务。";
		next;
		mes "[Instructor Igrid]";
		mes "这还不是结束。在我们再次需要你们之前，务必保重。";
		close;
	}
	else if (ep13_1_edq == 0) {
		mes "[Instructor Igrid]";
		mes "我是米德加尔特远征队的伊格里德教官，负责训练和指挥士兵。";
		next;
		mes "[Instructor Igrid]";
		mes "你一定想成为我们远征队的正式成员。";
		mes "抱歉，但你太弱了，无法承受我的强化训练。";
		mes "在受伤前放弃吧。";
		next;
		mes "[Instructor Igrid]";
		mes "如果你闲得发慌，就四处看看。这里有很多适合你这种所谓冒险者的杂务。";
		mes "如果你能尽力完成，我也许会接受你成为远征队的学员。";
		close;
	}
	else if ((ep13_1_edq > 0) && (ep13_1_edq < 4)) {
		mes "[Instructor Igrid]";
		mes "我不信任你。嗯，抱歉。如果指挥官派你执行任务，我确实没资格这么说。";
		next;
		mes "[Instructor Igrid]";
		mes "如果你要放弃，现在就放弃吧。这样对我们双方都好。";
		close;
	}
	else if ((ep13_1_edq == 4) || (ep13_1_edq == 5)) {
		mes "[Instructor Igrid]";
		mes "我就知道你做不到。我不是早就叫你趁机会放弃吗？！";
		close;
	}
	else if (ep13_1_edq > 5) {
		mes "[Instructor Igrid]";
		mes "你以为我是在为你做这些吗？不，我只是借此机会管教偷懒的士兵。";
		next;
		mes "[Instructor Igrid]";
		mes "你在看什么？管好你自己的事！";
		close;
	}
	else {
		// 13.2 addon
		mes "[Instructor Igrid]";
		mes "我是远征队训练教官伊格里德，负责训练士兵并担任指挥。";
		close;
	}
}

mid_camp,206,286,3	script	Expedition Messenger	997,{
	if ((ep13_1_edq == 3) && (countitem(11012) > 0)) {
		mes "[Expedition Messenger]";
		mes "欢迎，我一直在等你。";
		mes "你一定是" + strcharinfo(0) + "。很高兴见到你。";
		next;
		mes "[Expedition Messenger]";
		mes "让我快速确认一下。你是直接从指挥官那里收到报告的，对吧？可以让我看看吗？";
		next;
		mes "...";
		mes "......";
		mes ".........";
		next;
		mes "[Expedition Messenger]";
		mes "太好了，谢谢。那么我们会回到大陆，告诉领导者你，"+ strcharinfo(0) +"，已经出发。";
		next;
		mes "[Expedition Messenger]";
		mes "各位，该走了。";
		next;
		donpcevent "Expedition Messenger#2::Ongo";
		mes "[Expedition Messenger]";
		mes "你去施瓦尔茨瓦德共和国。";
		mes "你去阿鲁纳佩茨。我会去普隆德拉宫殿。";
		emotion ET_OK, getnpcid(0, "Expedition Messenger#2");
		next;
		mes "[Expedition Messenger]";
		mes "回头见，各位。";
		donpcevent "Expedition Messenger#2::OnDisable";
		next;
		mes "[Expedition Messenger]";
		mes "怎么了？你为什么还没离开……？";
		specialeffect EF_SOULBREAKER,AREA,"Expedition Messenger";
		next;
		mes "[Expedition Messenger]";
		mes "啊……你为什么要这样做？！";
		next;
		cutin "ep13_shadow_edq",2;
		mes "[???]";
		mes "......";
		next;
		mes "[???]";
		mes "把报告给我。";
		next;
		switch(select("Give the report.:Protect the report.")) {
		case 1:
			mes "[Expedition Messenger]";
			mes "什……你在做什么？你不能放弃报告……";
			mes "呜呜……";
			next;
			mes "[???]";
			mes "现在就给我！";
			next;
			donpcevent "Expedition Messenger#2::OnEnable";
			emotion ET_SURPRISE, getnpcid(0, "Expedition Messenger#3");
			cutin "ep13_shadow_edq",2;
			mes "[???]";
			mes "啊……";
			next;
			specialeffect EF_SOULBREAKER,AREA,"Expedition Messenger#3";
			specialeffect EF_SOULBREAKER,AREA,"Expedition Messenger#3";
			mes "[???]";
			mes "啊……你……";
			next;
			mes "[Expedition Messenger]";
			mes "*咳嗽* 谢天谢地！" + strcharinfo(0) + "，快带着报告跑！";
			next;
			mes "[???]";
			mes "不……不要啊！";
			next;
			specialeffect2 EF_SOULBREAKER;
			specialeffect2 EF_SONICBLOWHIT;
			mes "[Expedition Messenger]";
			mes "啊……" + strcharinfo(0) + "，你还好吗？报告……报告……";
			next;
			delitem 11012,1; //Expedition_Report
			set ep13_1_edq,4;
			changequest 3087,3088;
			mes "[Expedition Agent]";
			mes "报告丢了。页面被风吹走了！";
			next;
			mes "[???]";
			mes "哈哈，我也许没能拿到报告，但让它毁掉总比落在你手里好！";
			cutin "ep13_shadow_edq",255;
			next;
			donpcevent "Expedition Messenger#3::OnDisable";
			mes "[Expedition Agent]";
			mes "你还好吗？报告怎么样了……？";
			next;
			mes "[Expedition Messenger]";
			mes "*咳嗽* 报告已经不在我们手里了……";
			next;
			mes "[Expedition Agent]";
			mes "如果我们动员所有部队搜索整个区域……";
			next;
			mes "[Expedition Messenger]";
			mes "我们必须先把这件事报告给指挥官。";
			mes ""+ strcharinfo(0) + "，请立即向指挥官报告。剩下的交给我们。";
			donpcevent "Expedition Messenger#2::OnDisable";
			next;
			mes "[Expedition Agent]";
			mes "是的，请向指挥官报告……";
			close;
		case 2:
			mes "[???]";
			mes "哦，是吗？那我只好使用武力了！";
			next;
			donpcevent "Expedition Messenger#2::OnEnable";
			emotion ET_SURPRISE, getnpcid(0, "Expedition Messenger#3");
			mes "[???]";
			mes "啊！";
			next;
			specialeffect EF_SOULBREAKER,AREA,"Expedition Messenger#3";
			specialeffect EF_SOULBREAKER,AREA,"Expedition Messenger#3";
			mes "[???]";
			mes "啊……你……";
			next;
			mes "[Expedition Messenger]";
			mes "*咳嗽* 谢天谢地！" + strcharinfo(0) + "，快带着报告跑！";
			next;
			mes "[???]";
			mes "不……不要啊！";
			next;
			specialeffect2 EF_SOULBREAKER;
			specialeffect2 EF_SONICBLOWHIT;
			mes "[Expedition Messenger]";
			mes "啊……" + strcharinfo(0) + "，你还好吗？报告……报告……";
			next;
			mes "[Expedition Agent]";
			mes "报告丢了。页面被风吹走了！";
			next;
			delitem 11012,1; //Expedition_Report
			set ep13_1_edq,5;
			changequest 3087,3088;
			mes "[???]";
			mes "哈哈，我也许没能拿到报告，但让它毁掉总比落在你手里好！";
			cutin "ep13_shadow_edq",255;
			next;
			donpcevent "Expedition Messenger#3::OnDisable";
			mes "[Expedition Agent]";
			mes "你还好吗？报告怎么样了……？";
			next;
			mes "[Expedition Messenger]";
			mes "*咳嗽* 报告已经不在我们手里了……";
			next;
			mes "[Expedition Agent]";
			mes "如果我们动员所有部队搜索整个区域……";
			next;
			mes "[Expedition Messenger]";
			mes "我们必须先把这件事报告给指挥官。";
			mes ""+ strcharinfo(0) + ", please report to the commander immidiatly. Let us take care of the rest.";
			set ep13_1_edq,5;
			next;
			mes "[Expedition Agent]";
			mes "是的，请向指挥官报告……";
			close;
		}
	}
	else if ((ep13_1_edq == 3) && (countitem(11012) == 0)) {
		mes "[Expedition Messenger]";
		mes "你被指派来递送远征报告吗？";
		next;
		mes "[Expedition Messenger]";
		mes "抱歉，我没看到你手里的报告。请把报告带来，我才能确认你的身份。";
		close;
	}
	else if ((ep13_1_edq > 3) && (ep13_1_edq < 6)) {
		mes "[Expedition Messenger]";
		mes "请尽快把这件事报告给指挥官。";
		close;
	}
	else {
		mes "[Expedition Messenger]";
		mes "你好！我在这里等人。嗯，这就是我的职责。";
		close;
	}

OnInit:
	donpcevent "Expedition Messenger#2::OnDisable";
	donpcevent "Expedition Messenger#3::OnDisable";
	donpcevent "Command Timer#edq::OnEnable";
	end;
}

mid_camp,2,2,3	script	Command Timer#edq	997,4,4,{
OnInit:
	disablenpc "Command Timer#edq";
	end;

OnEnable:
	enablenpc "Command Timer#edq";
	stopnpctimer;
	initnpctimer;
	end;

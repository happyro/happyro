//===== rAthena Script ======================================= 
//= Sealed Shrine
//===== By: ================================================== 
//= L0ne_W0lf
//===== Current Version: ===================================== 
//= 2.3
//===== Compatible With: ===================================== 
//= rAthena Project
//===== Description: ========================================= 
//= [Official Conversion]
//= Seal away the Great Demon Baphomet.
//===== Additional Comments: ================================= 
//= 1.0 First version. [L0ne_W0lf]
//= 1.1 Added setquest for instance cooldown. [L0ne_W0lf]
//= 1.2 Fixed Torch#12 not being disabled. (bugreport:4044) [L0ne_w0lf]
//= 1.3 Fixed cutins not being removed. (bugreport:4117) [L0ne_w0lf]
//= 1.4 Fixed some typos. [Gepard]
//= 1.5 Fixed not being able to enter dungeon for the first two hours.
//= 1.6 Players should be able to re-take the quest after 12 hours now.
//=     Changed quest 3046 to 3040. This is the correct quest id.
//=     Removed checking quest 3045, unofficial check.
//= 1.7 Fixed a checkquest condition never setting quest. [L0ne_W0lf]
//= 1.8 Added 'instance_check_party' command to the script for proper checking if
//=     the invoking party meets the requirements to join the Memorial Dungeon.
//= 1.9 Fixed broken else/if chaining. [Joseph]
//= 2.0 Some optimization. [Euphy]
//= 2.1 Fixed quest being removed before the 12 hours cool down. [Joseph]
//= 2.2 Removed extra setquest (quest id:3040).	[Joseph]
//= 2.3 Instance system rewrite. [Euphy]
//============================================================ 

// Sealed Catacomb Entrance
//============================================================
monk_test,309,146,3	script	Friar Patrick#edq	412,{
	cutin "ins_cata_pri_n",2;
	mes "[帕特里克修士]";
	mes "世界的和平不可能永远持续……邪恶之手再次伸向这个世界……";
	next;
	mes "[帕特里克修士]";
	mes "是什么把你带到这里的？";
	next;
	if (countitem(6004) > 0) {
		set .@doll,1;
		set .@selection,select("这里是什么地方？:我想进去。:关于被诅咒的巴风特玩偶。:取消。");
	}
	else {
		set .@selection,select("这里是什么地方？:我想进去。:取消。");
	}
	switch(.@selection) {
	case 1:
		mes "[帕特里克修士]";
		mes "咦……你不知道吗？这里是圣卡皮托利那修道院，想成为修士的兄弟们在这里训练和祈祷。";
		next;
		mes "[帕特里克修士]";
		mes "至于这里……该怎么说呢……没错，这是恶魔的坟墓。坟墓……";
		next;
		mes "[帕特里克修士]";
		mes "曾经毁灭世界的伟大恶魔，就沉睡在这里。";
		next;
		switch(select("再多告诉我一些。:别说了。")) {
		case 1:
			cutin "ins_cata_pri_n",2;
			mes "[帕特里克修士]";
			mes "巴风特……就是那恶魔的名字……我想你听说过。";
			next;
			mes "[帕特里克修士]";
			mes "许多勇敢的人和兄弟曾在这座修道院训练……";
			next;
			mes "[帕特里克修士]";
			mes "就在你面前的墓碑下……封印着巴风特。";
			next;
			mes "[帕特里克修士]";
			mes "但是……此刻魔王梦罗克正集结强大魔法，企图影响这片大陆上的所有生命。";
			next;
			mes "[帕特里克修士]";
			mes "巴风特也……已经苏醒，借助魔王梦罗克的力量削弱封印，准备复活到这个世界……";
			next;
			mes "[帕特里克修士]";
			mes "现在……我正在寻找足够勇敢的人，将巴风特重新封印在神殿中……就像多年前我们做过的那样……";
			next;
			mes "[帕特里克修士]";
			mes "任何为正义而战的人，内心深处都知道邪恶正威胁着征服这个世界……";
			next;
			mes "[帕特里克修士]";
			mes "继续训练，运用你的技能保护世界免受邪恶的威胁……";
			break;
		case 2:
			cutin "ins_cata_pri_n",2;
			mes "[帕特里克修士]";
			mes "任何为正义而战的人，内心深处都知道邪恶正威胁着征服这个世界……";
			next;
			mes "[帕特里克修士]";
			mes "继续训练，运用你的技能保护世界免受邪恶的威胁……";
			break;
		}
		break;
	case 2:
		if (BaseLevel >= 75) {

			set .@party_id,getcharid(1);

			mes "[帕特里克修士]";
			mes "你是要前往神殿重新封印巴风特吗？";
			next;

			// 12 hour cooldown
			set .@ins_bapho_check,checkquest(3040,PLAYTIME);
			// Two hour play limit
			//set .@ins_bapho_check2,checkquest(3045,PLAYTIME);

			if (.@ins_bapho_check == -1) {
				if (is_party_leader(.@party_id) == true && instance_check_party(.@party_id,2,75)) {
					mes "[帕特里克修士]";
					mes "队伍名称是 "+getpartyname(.@party_id)+"……";
					mes "队长名称是 "+strcharinfo(0)+"……";
					if (instance_create("Sealed Catacomb") < 0) {
						mes "嗯……这里似乎出了问题……我马上检查。请稍等。";
					}
					else {
						mes "好……我会调整神殿封印，让你和队伍成员进入。";
						next;
						mes "[帕特里克修士]";
						mes "封印解除时你会看到信号。请等待信号出现……";
						next;
						mes "[帕特里克修士]";
						mes "看到信号后，把手放在墓碑上……然后就能进入。";
						next;
						mes "[帕特里克修士]";
						mes "记住一件事……进入神殿的人都会被巴风特诅咒，在诅咒期间无法进出。";
						next;
						mes "[帕特里克修士]";
						mes "还有一件事……在这个被诅咒的区域，封印效果会禁止一些依靠外部物理力量保护的技能。";
						next;
						mes "[帕特里克修士]";
						mes "例如^0000FF暗之障壁和霸邪之阵^000000……所以进入神殿前最好做好准备。";
					}
				}
				else {
					mes "[帕特里克修士]";
					mes "嗯……我认可你的勇气，但是……我不能允许任何人直接进入。只能先允许队长进入。";
					next;
					mes "[帕特里克修士]";
					mes "队长获准后，其他队员才能进入。这是修道院的规定，请理解。";
				}
			}
			else if (.@ins_bapho_check == 0 || .@ins_bapho_check == 1) {
				mes "[帕特里克修士]";
				mes "你最近似乎进入过神殿……巴风特的诅咒仍在，所以不能再次进入。诅咒要过一段时间才会消失。";
			}
			else if (.@ins_bapho_check == 2) {
				mes "[帕特里克修士]";
				mes "嗯……巴风特的诅咒似乎减弱了。我现在可以解除它。";
				next;
				mes "[帕特里克修士]";
				mes "哈啊啊啊……呼呼克斯·翼加迪姆·阿布拉卡达布拉！！！！！";
				next;
				erasequest 3040;
				if (checkquest(3041)>=0) erasequest 3041;
				if (checkquest(3045)>=0) erasequest 3045;
				mes "[帕特里克修士]";
				mes "呼……结束了。巴风特的诅咒已经解除，你可以再次进入。";
			}
		}
		else {
			mes "[帕特里克修士]";
			mes "嗯……你应该多训练，才能进入这个危险的地方……至少要达到 Lv 75。";
			next;
			mes "[帕特里克修士]";
			mes "请继续训练，以后再来。";
		}
		break;
	case 3:
		if (.@doll == 1) {
		mes "[帕特里克修士]";
		mes "那就是……你手里的邪恶玩偶……让我看看。";
			next;
		mes "[帕特里克修士]";
			mes "... ... ...";
			next;
		mes "[帕特里克修士]";
		mes "没错……我能感受到其中的巴风特邪恶力量……你要怎么处理玩偶？";
			next;
		mes "[帕特里克修士]";
		mes "如果什么也不做，它只是危险又无用的东西……我介绍一个能帮助你的人……想见他吗？";
			next;
		mes "[帕特里克修士]";
		mes "去见修道院主建筑附近的^0000FF鲁斯特·黑手^000000……他能让这个玩偶发挥作用。";
			setquest 3042;
			break;
		}
	case 4:
		mes "[帕特里克修士]";
		mes "任何为正义而战的人，内心深处都知道邪恶正威胁着征服这个世界……";
		next;
		mes "[帕特里克修士]";
		mes "继续训练，运用你的技能保护世界免受邪恶的威胁……";
		break;
	}
	close2;
	cutin "",255;
	end;
}

monk_test,306,151,3	script	Grave of Baphomet#edq	111,{
	if (countitem(6002)) delitem 6002,countitem(6002); //Token_Of_Apostle
	mes "这块墓碑上刻着长着巨大角的邪恶恶魔，令人感到不祥。";
	next;
	if(select("触摸石碑。:后退。") == 2)
		close;

	// 12 hour cooldown
	set .@ins_bapho_check,checkquest(3040,PLAYTIME);
	// Two hour play limit
	//set .@ins_bapho_check2,checkquest(3045,PLAYTIME);

	if (.@ins_bapho_check == -1) {
		switch(instance_enter("Sealed Catacomb")) {
		case IE_OTHER:
		case IE_NOINSTANCE:
		mes "摸起来很冷，没有任何反应。";
			close;
		case IE_NOMEMBER:
			mes "[帕特里克修士]";
			mes "要进入这个危险的地方，你不能独自前往。加入队伍后再来。";
			close;
		case IE_OK:
			mapannounce "monk_test","[" + strcharinfo(0) + "] member of the [" + getpartyname(.@party_id) + "] party has entered the Sealed Shrine.",bc_map,"0x00ff99";
			setquest 3040;
			//warp "1@cata",100,224;
			close;
		}
	} else if (.@ins_bapho_check == 0 || .@ins_bapho_check == 1) {
		mes "[帕特里克修士]";
		mes "你最近似乎进入过神殿……巴风特的诅咒仍在，不能再次进入。";
		mes "进入一段时间后，巴风特的诅咒才会消失。";
		close;
	} else if (.@ins_bapho_check == 2) {
		mes "[帕特里克修士]";
		mes "嗯……巴风特的诅咒似乎减弱了。我来清除这股诅咒。";
		next;
		mes "[帕特里克修士]";
		mes "哈啊啊啊……羽加迪姆·勒维奥萨，呼神护卫！！！！！";
		specialeffect2 EF_HOLYHIT;
		erasequest 3040;
		if (checkquest(3041)>=0) erasequest 3041;
		if (checkquest(3045)>=0) erasequest 3045;
		next;
		mes "[帕特里克修士]";
		mes "呼……结束了。你身上的诅咒都解除了，可以再次进入。";
		close;
	}
}

prt_monk,261,91,3	script	Rust Blackhand#edq	826,{
	set .@new_maje,checkquest(3043);
	mes "[鲁斯特·黑手]";
	mes "你是谁？找我有什么事？";
	next;
	mes "[鲁斯特·黑手]";
	mes "你不是修士，那你想要什么？";
	next;
	if (.@new_maje == 0 || .@new_maje == 1) {
		mes "[鲁斯特·黑手]";
		mes "材料都带来了吗？";
		next;
		if ((countitem(6004) > 0) && (countitem(2256) > 0) && (countitem(7799) > 29) && (countitem(7798) > 49) && (Zeny > 990000)) {
			mes "[鲁斯特·黑手]";
			mes "咯咯……材料准备得不错。放在那里等着吧。";
			next;
			mes "[鲁斯特·黑手]";
			mes "嗯……我好久没见过这些邪恶的角了……咯咯……开始吧……";
			next;
			mes "...";
			next;
			mes "... ...";
			next;
			mes "... ... ...";
			next;
			delitem 6004,1; //Bapho_Doll
			delitem 2256,1; //Magestic_Goat
			delitem 7799,30; //Dark_Crystal
			delitem 7798,50; //Dark_Debris
			set Zeny, Zeny-990000;
			completequest 3043;
			getitem 5374,1; //L_Magestic_Goat
		mes "[鲁斯特·黑手]";
		mes "完成了。当然你可能很兴奋，我理解……";
			next;
		mes "[鲁斯特·黑手]";
		mes "我不接受投诉或售后请求，小心使用。我要走了……";
			close;
		}
		else {
			mes "[鲁斯特·黑手]";
			mes "呼……你没听懂我的话。材料不齐，什么也做不了。";
			next;
			mes "[鲁斯特·黑手]";
			mes "我再说一遍材料，请正确收集。";
			next;
	mes "[鲁斯特·黑手]";
			mes "^0000FF被诅咒的巴风特玩偶、霸邪之角、黑暗结晶 30 个、黑暗碎片 50 个^000000，最重要的是制作费用 ^0000FF990000^000000 Zeny。";
			close;
		}
	}
	else if ((.@new_maje == -1) && (countitem(6004) > 0)) {
		switch(select("关于被诅咒的巴风特玩偶:停止交谈。")) {
		case 1:
			mes "[鲁斯特·黑手]";
			mes "什么……嗯……你拿到玩偶了？不错嘛，和外表不一样……";
			next;
			mes "[鲁斯特·黑手]";
			mes "让我看看……不用说，一定是帕特里克派你来处理玩偶的，对吧？";
			next;
			mes "[鲁斯特·黑手]";
			mes "酷……我会帮你让邪恶玩偶发挥作用。什么？我能做什么？";
			next;
			mes "[鲁斯特·黑手]";
			mes "我可以为你制作邪恶魔王巴风特强大巨大的角，做成蕴含其力量的头盔。";
			next;
			mes "[鲁斯特·黑手]";
			mes "它叫^4d4dff巨大的霸邪之角^000000。你会发现熟悉的霸邪之角根本无法相比。";
			next;
			mes "[鲁斯特·黑手]";
			mes "被诅咒的巴风特玩偶是最重要的材料……你想要的话我就帮你制作。想怎么做？";
			next;
			switch(select("我想做一个！:我不需要。")) {
			case 1:
				mes "[鲁斯特·黑手]";
				mes "咯咯……没错，聪明人会抓住机会。我告诉你材料。别忘了全部带来。";
				next;
				mes "[鲁斯特·黑手]";
				mes "^0000FF被诅咒的巴风特玩偶、霸邪之角、黑暗结晶 30 个、黑暗碎片 50 个^000000，制作费用 ^0000FF990000^000000 Zeny。";
				next;
				mes "[鲁斯特·黑手]";
				mes "霸邪之角可以从迷宫森林的弱化巴风特处获得。黑暗结晶和黑暗碎片来自梦罗克的化身。";
				next;
				mes "[鲁斯特·黑手]";
				mes "你既然封印过真正的巴风特，肯定能拿到材料。对吧？咯咯……";
				next;
				mes "[鲁斯特·黑手]";
				mes "得到这顶帽子前，你永远不会知道它有多棒。明白了就去收集材料。";
				if (isbegin_quest(3042))
					changequest 3042,3043;
				else
					setquest 3043;
				close;
			case 2:
				mes "[鲁斯特·黑手]";
				mes "嗯……随你吧……你真的要浪费这个机会吗？";
				next;
				mes "[鲁斯特·黑手]";
				mes "啧啧……邪恶玩偶一直威胁你的生命，我才不在乎呢！";
				close;
			}
		case 2:
			mes "[鲁斯特·黑手]";
			mes "真是个无趣的小子……哼……";
			close;
		}
	}
	else if ((.@new_maje == -1) && (countitem(6004) == 0)) {
		mes "[鲁斯特·黑手]";
		mes "没事就走开！我为修道院的兄弟制作装备，不是为你这样的冒险家。明白吗？";
		close;
	}
	else if ((.@new_maje == 2) && (countitem(6004) > 0)) {
		switch(select("关于被诅咒的巴风特玩偶:停止交谈。")) {
		case 1:
			mes "[鲁斯特·黑手]";
			mes "什么……又是你？这次想要什么？";
			next;
			mes "[鲁斯特·黑手]";
			mes "什么？你又拿到了邪恶魔王的玩偶？嗯……你比我想的厉害……";
			next;
			mes "[鲁斯特·黑手]";
			mes "好吧……我再帮你一次。";
			next;
			mes "[鲁斯特·黑手]";
			mes "如果你想再次把玩偶制成^4d4dff巨大的霸邪之角^000000，我可以再做一个。";
			next;
			mes "[鲁斯特·黑手]";
			mes "我再告诉你一次材料。你要制作吗？";
			next;
			switch(select("我想要。:不，我不要。")) {
			case 1:
				mes "[鲁斯特·黑手]";
				mes "呵呵呵……没错，聪明人会在机会来临时把握住它。我告诉你材料，别忘了全部带来。";
				next;
				mes "[鲁斯特·黑手]";
				mes "^0000FF诅咒巴风特玩偶、威严山羊、30个黑暗结晶、50个黑暗碎片^000000，最重要的是，制作费为^0000FF990000^000000 Zeny。";
				next;
				mes "[鲁斯特·黑手]";
				mes "霸邪之角可以从迷宫森林的弱化巴风特处获得。黑暗结晶和黑暗碎片来自梦罗克的化身。";
				next;
				mes "[鲁斯特·黑手]";
				mes "你封印过真正的巴风特，所以肯定能拿到材料，对吧？呵呵呵……";
				next;
				mes "[鲁斯特·黑手]";
				mes "得到这顶帽子前，你永远不会知道它有多棒。明白了就去收集材料。";
				//recall_completequest 3043
				if (isbegin_quest(3042))
					changequest 3042,3043;
				else {
					erasequest 3043;
					setquest 3043;
				}
				close;
			case 2:
				mes "[鲁斯特·黑手]";
				mes "嗯……随你吧……你真的要浪费这个机会吗？";
				next;
				mes "[鲁斯特·黑手]";
				mes "啧啧……邪恶玩偶一直威胁你的生命，我才不在乎呢！";
				close;
			}
		case 2:
			mes "[鲁斯特·黑手]";
			mes "真是个无趣的小子……哼……";
			close;
		}
	}
	else if ((.@new_maje == 2) && (countitem(6004) == 0)) {
		mes "[鲁斯特·黑手]";
		mes "你为什么还在这里闲逛？不想要^4d4dff巨大的霸邪之角^000000就走开。";
		close;
	}
}

// Sealed Shrine Interior
//============================================================
1@cata,1,2,0	script	ins_baphomet_lotto	-1,{
OnInstanceInit:
	// Pick one "true" Gravestone and 12 "false" Gravestones.
	set .@true, rand(1,13);
	for(set .@i,1; .@i<=13; set .@i,.@i+1) {
		disablenpc instance_npcname("Gravestone#1F_"+.@i+((.@i == .@true)?"T":"F"));
	}
	disablenpc instance_npcname("ins_baphomet_lotto");
	end;
}

1@cata,3,2,0	script	ins_baphomet_lotto2	-1,{
OnEnable:
	for(set .@i,1; .@i<=12; set .@i,.@i+1)
		enablenpc instance_npcname("Bobbing Torch#"+.@i);
	end;
}

1@cata,4,2,0	script	ins_baphomet_lotto3	-1,{
OnEnable:
	set .@label$, instance_npcname("ins_baphomet_lotto3")+"::OnMyMobDead";
	set .@map$, instance_mapname("1@cata");
	monster .@map$,0,0,"Apostle of Baphomet",1869,1,.@label$;
	monster .@map$,0,0,"Apostle of Baphomet",1291,1,.@label$;
	monster .@map$,0,0,"Apostle of Baphomet",1869,1,.@label$;
	monster .@map$,0,0,"Apostle of Baphomet",1291,1,.@label$;
	monster .@map$,0,0,"Apostle of Baphomet",1869,1,.@label$;
	monster .@map$,0,0,"Apostle of Baphomet",1291,1,.@label$;
	monster .@map$,0,0,"Apostle of Baphomet",1869,1,.@label$;
	monster .@map$,0,0,"Apostle of Baphomet",1132,1,.@label$;
	monster .@map$,0,0,"Apostle of Baphomet",1117,1,.@label$;
	monster .@map$,0,0,"Apostle of Baphomet",1132,1,.@label$;
	monster .@map$,0,0,"Apostle of Baphomet",1117,1,.@label$;
	monster .@map$,0,0,"Apostle of Baphomet",1132,1,.@label$;
	monster .@map$,0,0,"Apostle of Baphomet",1291,1,.@label$;
	monster .@map$,0,0,"Apostle of Baphomet",1117,1,.@label$;
	monster .@map$,0,0,"Apostle of Baphomet",1869,1,.@label$;
	end;

OnDisable:
	killmonster instance_mapname("1@cata"),instance_npcname("ins_baphomet_lotto3")+"::OnMyMobDead";
	end;

OnMyMobDead:
	set .@map$, instance_mapname("1@cata");
	if (mobcount(.@map$,instance_npcname("ins_baphomet_lotto3")+"::OnMyMobDead") < 1) {
		mapannounce .@map$, "All apostles of Baphomet are dead!",bc_map,"0x00ff99";
	}
	getitem 6002,1; //Token_Of_Apostle
	end;
}

// Soul of hero near the north grave
//============================================================
1@cata,141,221,0	script	Gravestone#	844,3,3,{
	set .@party_id,getcharid(1);
	if ('ins_baphomet == 0) {
		mes "墓碑在颤抖……";
		next;
		mes "触摸墓碑时，我听到一个声音。";
		next;
		specialeffect2 EF_CONE;
		mes "[墓碑的声音]";
		mes "我等了又等，终于等到像你这样再次回来的勇敢冒险家……";
		next;
		while(1) {
			switch(select("你是谁？:你在等我？:取消。")) {
			case 1:
				mes "[墓碑的声音]";
				mes "我曾是和你一样阻止巴风特的战士。如今我已死去，只剩灵魂……";

//= Jawaii Town NPCs
//===== Additional Comments: =================================
//= 1.0 Done By jAthena
//= 1.1 Rough Translation [DNett123]
//= 1.2 Started Grammer Corrections [DNett123]
//= 1.3 Some Edits Thanks To Vidar & Fusion [DNett123]
//= 1.4 Edited Dancer, Thanks ceskil [DNett123]
//= 1.5 Fixed Script, and spelling errors, some thanks to Sparkles [DNett123]
//= 1.6 Final corrections (not complete), thanks to the public, and DNett123!
//= 1.6c added missing monsters. Still 1 type is missing [Lupus]
//= 1.7 Fixed a lot of typos [Nexon]
//= 1.8 Removed monster spawns, added aegis ep 8.5 spawns to npc/mobs/fields/jawaii.txt [MasterOfMuppets]
//= 2.0 Updated the npcs according to iRO [MasterOfMuppets]
//= 2.01 fixed missing @ at randomdrink, thanks to theultramage [Lupus]
//= 2.02 Fixed Classic Suite NPC warping directly above a warp [Evera]
//= 3.0 Rescripted to Aegis 10.3 standard. Contains all Jawaii-related NPCs. [L0ne_W0lf]
//= 3.1 Fixed bugs with getpartnerid() (it never returns 1), fixed some conditons,
//=     replaced getpartnerid() with ispartneron() at some tri-forks [Lupus]
//= 3.2 Reverted ispartneron() BACK to getpartnerid(). [L0ne_W0lf]
//=     None of the NPCs need the player's partner to be online.
//= 3.3 Just a small fix up on the Bartender. [L0ne_W0lf]
//= 3.3a Just a little typo error. [Samuray22]
//= 3.4 Added missing checkweights. [L0ne_W0lf]
//= 3.5 Replaced effect numerics with constants. [L0ne_W0lf]
//= 3.6 Fixed bartender so he no longer hangs. [L0ne_W0lf]
//= 3.7 Added Izlude RE coordinates. [Euphy]
//============================================================

// Jawaii Transportation
//============================================================
jawaii,239,112,7	script	Mariner#toizu	100,{
	mes "[Mariner]";
	mes "这艘船";
	mes "正驶向";
	mes "^666699伊斯鲁德^000000。";
	mes "在斐扬岛玩得开心吗？出发前请检查一下";
	mes "是否忘记了什么东西。";
	next;
	mes "[Mariner]";
	mes "那么，";
	mes "你想回到";
	mes "伊斯鲁德吗？";
	next;
	if (select("Go back.:Cancel.") == 1) {
		mes "[Mariner]";
		mes "现在让我";
		mes "带你前往";
		mes "伊斯鲁德。";
		close2;
		if(checkre(0))
			warp "izlude",195,212;
		else
			warp "izlude",176,182;
		end;
	}
	mes "[Mariner]";
	mes "慢慢来，";
	mes "想逛多久都可以。";
	mes "毕竟这里不是";
	mes "经常能来参观的地方，";
	mes "你明白吧？";
	mes "好好享受假期。";
	close;
}

jawaii,122,263,5	script	Mariner#toalbe	100,{
	mes "[Mariner]";
	mes "这艘船";
	mes "正驶回";
	mes "^003399艾尔贝塔^000000。";
	mes "在斐扬岛玩得开心吗？出发前请检查一下";
	mes "是否忘记了什么东西。";
	next;
	mes "[Mariner]";
	mes "现在你准备好";
	mes "回到";
	mes "艾尔贝塔了吗？";
	next;
	if (select("Go back.:Cancel.") == 1) {
		mes "[Mariner]";
		mes "现在让我";
		mes "带你回到";
		mes "艾尔贝塔。";
		close2;
		warp "alberta",192,157;
		end;
	}
	mes "[Mariner]";
	mes "是啊……";
	mes "尽量享受你的假期吧。";
	mes "我们会等你准备好后";
	mes "再出发。";
	mes "不用着急。";
	close;
}

// Generic Jawaii NPCs
//============================================================
jawaii,188,218,7	script	Tavern Lady#Jawaii	80,{
	mes "[Lady]";
	mes "哎呀！";
	mes "你不会是要去";
	mes "酒馆吧？";
	next;
	if (select("不，我不是。:当然～") == 1) {
		mes "[Lady]";
		mes "呼～！";
		mes "谢天谢地！";
		mes "只是……";
		mes "酒馆可能不是";
		mes "适合你享受时光的地方。";
		mes "请务必小心。";
		next;
	}
	mes "[Lady]";
	mes "虽然我在那里工作，但还是不敢相信有那种地方！我以为卢恩·米德加尔特王国已经禁酒了！";
	next;
	mes "[Lady]";
	mes "我不知道单身者是怎么找到这里的。";
	mes "听说各种各样的人会因为不同理由来到这里。";
	next;
	mes "[Lady]";
	mes "我甚至见过未婚单身者专程来这里喝醉！";
	mes "哦！而且不知为什么，有人一直从酒馆失踪！";
	next;
	mes "[Lady]";
	mes "到底发生了什么呢？";
	mes "^666666*叹气*^000000 我是那里的女服务员，但还是想劝你别进去……";
	close;
}

jawaii,220,235,3	script	Jawaii Resident#heart	724,{
	mes "[Jawa Jawa]";
	mes "你知道斐扬岛最美的";
	mes "地方是哪里吗？";
	mes "就是爱心岛。";
	next;
	mes "[Jawa Jawa]";
	mes "就是这里稍微偏北的‘爱心岛’。环绕爱心岛的水不深，小心一点就能走过去。";
	next;
	mes "[Jawa Jawa]";
	mes "那里最适合和心爱的人分享亲密时光。";
	mes "环境幽静，景色也非常美丽。";
	next;
	mes "[Jawa Jawa]";
	mes "当然，如果你是单身，";
	mes "最好不要一个人去。";
	mes "那样看起来会像个";
	mes "可怜的失败者！";
	mes "还是找个伴一起去吧。";
	close;
}

jawaii,240,146,5	script	Jawaii Resident#desc1	724,{
	mes "[Waii Waii]";
	mes "欢迎来到斐扬岛！";
	next;
	mes "[Waii Waii]";
	mes "在这里，你可以安心享受蜜月，不用担心任何打扰。";
	mes "也不用理会臭名昭著的单身军团！";
	next;
	mes "[Waii Waii]";
	mes "周围虽然有一些怪物，但只要不先攻击它们就没事。";
	mes "把它们当成岛上的原住民，也是值得欣赏的风景。";
	close;
}

jawaii,168,247,5	script	Jawaii Resident#desc2	724,{
	mes "[Waja Waja]";
	mes "啊，你一定是游客。";
	mes "如果迷路了，向西走就好。新婚夫妇的住宿";
	mes "位于斐扬岛西部，";
	mes "这里的房间非常棒。";
	next;
	mes "[Waja Waja]";
	mes "这里有四种不同主题的房间，可以选择喜欢的类型。";
	mes "如果想了解更多，可以找附近的导游。";
	next;
	mes "[Waja Waja]";
	mes "想回去时，请前往西北方向搭乘前往艾尔贝塔的船。";
	mes "如果要去伊斯鲁德，东南方有船等候。";
	close;
}

jawaii,165,121,1	script	Jawaii Resident#desc3	724,{
	mes "[Iwa Iwa]";
	mes "斐扬岛～";
	mes "斐～扬～岛～";
	mes "在这里你可以";
	mes "找到幸福～";
	next;
	mes "[Iwa Iwa]";
	mes "哦，这里很美吧？你什么都不用做，只要放松下来呼吸宁静的空气。";
	mes "这就是斐扬岛最棒的地方之一。";
	next;
	mes "[Iwa Iwa]";
	mes "哦！我们有时会在这个舞台举办演唱会。";
	mes "如果你擅长唱歌，为什么不上台";
	mes "为我们唱一首歌呢？";
	next;
	mes "[Iwa Iwa]";
	mes "斐扬岛～";
	mes "斐～扬～岛～";
	mes "在这里你可以";
	mes "找到幸福～";
	close;
}

jawaii,141,200,3	script	Employee#sroom	798,{
	mes "[Alowa]";
	mes "欢、欢迎……？";
	mes "这、这是我们";
	mes "甜蜜的房间。";
	mes "我、我们刚刚为你打扫过，";
	mes "当、当然是这样。";
	mes "请放心使用。";
	next;
	mes "[Alowa]";
	mes "费、费用是";
	mes "每人 1000 Zeny。";
	mes "请先支付费用，";
	mes "我、我发誓会让你进去！";
	next;
	mes "[Alowa]";
	mes "我、我也会帮你搬行李。";
	mes "但、但要先付款，否则老板会生气……^666666*咽口水*^000000";
	next;
	mes "[Alowa]";
	mes "^333333会把我打死的……^000000";
	next;
	if (select("使用。:取消。") == 1) {
		mes "[Alowa]";
		if (Zeny > 999) {
			mes "非、非常感谢！";
			mes "我、我来为你打开房门。";
			mes "谢、谢谢。";
			mes "祝、祝你玩得开心。";
			close2;
			set Zeny, Zeny-1000;
			warp "jawaii_in",116,64;
			end;
		}
		mes "糟糕！不、不行不行！";
		mes "这、这些钱不够吗？";
		mes "对、对不起，但老板会打我的，";
		mes "我不能让你不付钱就进去……";
		close;
	}
	mes "[Alowa]";
	mes "^666666*抽泣*^000000";
	mes "但、但我保证这是最漂亮、最干净的房间！请、请回来！";
	emotion ET_CRY;
	close;
}

jawaii,108,199,5	script	Employee#antroom	74,{
	mes "[Pine Oran]";
	mes "欢迎来到";
	mes "古董房。";
	next;
	mes "[Pine Oran]";
	mes "这个房间为恋人营造";
	mes "奢华优雅的氛围。";
	mes "为年轻情侣提供各种舒适设施。";
	mes "希望你们住得愉快。";
	next;
	mes "[Pine Oran]";
	mes "所有房间的基本结构相似，但每个房间都有独特的室内设计，满足不同人的喜好。";
	next;
	mes "[Pine Oran]";
	mes "如果想住在这里，每人进入前需要支付 1000 Zeny。既然你们来这里创造蜜月回忆，";
	mes "就应该住最好的房间。";
	next;
	mes "[Pine Oran]";
	mes "决定入住古董房后请告诉我。";
	mes "做出选择后，我会带你们过去。";
	next;
	if (select("使用。:取消。") == 1) {
		mes "[Pine Oran]";
		if (Zeny > 999) {
			mes "谢谢你使用";
			mes "我们的服务。";
			mes "请……";
			mes "好好放松，";
			mes "住得舒适。";
			close2;
			set Zeny, Zeny-1000;
			warp "jawaii_in",129,110;
			end;
		}
		mes "抱歉，你的钱似乎不够。请检查当前资金，";
		mes "看看能否解决这个问题。";
		close;
	}
	mes "[Pine Oran]";
	mes "请……";
	mes "慢慢来。";
	mes "休闲时光不必着急。";
	mes "好好享受吧。";
	close;
}

jawaii,107,189,5	script	Employee#horoom	93,{
	mes "[Sharkie Rania]";
	mes "我带你去";
	mes "蜜糖房。";
	mes "费用是 1000 Zeny。";
	next;
	mes "[Sharkie Rania]";
	mes "你想去吗？";
	next;
	if (select("使用。:取消。") == 1) {
		mes "[Sharkie Rania]";
		if (Zeny > 999) {
			mes "好吧。";
			mes "我们出发。";
			close2;
			set Zeny, Zeny-1000;
			warp "jawaii_in",86,117;
			end;
		}
		mes "你……";
		mes "没有足够的";
		mes "钱。";
		mes "浪漫也是需要 Zeny 的，";
		mes "明白了吗？";
		close;
	}
	mes "[Sharkie Rania]";
	mes "没问题。";
	close;
}

jawaii,112,173,7	script	Employee#villroom	93,{
	mes "[Larks Rania]";
	mes "你好，亲爱的。";
	mes "最近好吗？";
	mes "你是在找";
	mes "住宿的房间吗？";
	next;
	mes "[Larks Rania]";
	mes "这里叫别墅房。";
	mes "我推荐给喜欢";
	mes "舒适氛围、";
	mes "像在家一样住宿的人。";
	mes "一定会让你满意。";
	next;
	mes "[Larks Rania]";
	mes "和其他房间一样，";
	mes "住宿费用是 1000 Zeny。";
	mes "如果你愿意，我现在就能带你去别墅房。";
	mes "想入住吗？";
	next;
	if (select("使用。:取消。") == 1) {
		mes "[Larks Rania]";
		if (Zeny > 999) {
			mes "谢谢～";
			mes "祝你住得愉快。";
			close2;
			set Zeny, Zeny-1000;
			warp "jawaii_in",87,75;
			end;
		}
		mes "真遗憾！";
		mes "你的钱似乎不够……";
		mes "要不要请你的伴侣";
		mes "帮忙支付费用？";
		mes "两个人一起承担吧。";
		mes "这样会轻松一些。";
		close;
	}
	mes "[Larks Rania]";
	mes "没问题～";
	mes "如果愿意，也可以看看蜜糖房。房间管理员莎奇是个害羞的女孩，但房间真的很漂亮。";
	close;
}

jawaii,214,168,5	script	Honeymoon Helper#Jawaii	71,{
	mes "[Helper]";
	mes "没有比斐扬岛";
	mes "更适合度蜜月的";
	mes "地方了。";
	next;
	mes "[Helper]";
	mes "为什么不充分利用这里的时光，创造许多值得多年珍藏的甜蜜回忆呢？";
	next;
	mes "[Helper]";
	mes "提醒你幸福时光的纪念品会成为最珍贵的财产。";
	mes "比如结婚戒指，或婚礼上穿过的礼服和婚纱……";
	next;
	mes "[Helper]";
	mes "即使婚礼已经结束，回顾婚礼仪式的美好回忆也很不错吧？";
	mes "现在只需低价购买魔法相册，就能做到！";
	next;
	mes "[Helper]";
	mes "它的名字是……";
	mes "‘婚姻的甜蜜回忆’！！";
	next;
	mes "[Helper]";
	mes "它能用魔法瞬间把你带到婚礼大厅！";
	mes "只需 50,000 Zeny……";
	next;
	if (select("I shall buy it.:No, thanks.") == 1) {
		mes "[Helper]";
		if (Zeny > 49999) {
			set Zeny, Zeny-50000;
			getitem 681,1;// Memory_Of_Wedding
			mes "非常感谢～！";
			mes "请记住，应该和你的伴侣";
			mes "在对你们双方都特别的地方";
			mes "一起使用它。";
			mes "留下美好回忆。";
			close;
		}
	mes "‘婚姻的甜蜜回忆’售价50,000 Zeny。但你现在似乎没有足够的钱。也许你和伴侣可以互相帮助，一起买下婚姻的甜蜜回忆？";
		close;
	}
	mes "[Helper]";
	mes "即使你们的关系结束，";
	mes "共同分享的回忆也会永远留存……";
	close;
}

// Inside Jawaii
//============================================================
jawaii_in,25,94,0	script	Employee#jaw1	724,{
	mes "[Employee Tryteh]";
	mes "欢迎来到斐扬岛酒馆～";
	if (getpartnerid()) {
		mes "总之，我很高兴你们结婚了。祝你们永远幸福～";
		next;
		mes "[Employee Tryteh]";
		mes "如果遇到粗鲁的客人，请小心一点。";
		mes "他们可能喝醉了，会做出蠢事。";
		mes "你知道的……";
		close;
	}
	else if (!getpartnerid()) {
	mes "希望你在这里住得愉快。";
	mes "不过不要喝太多～";
	mes "注意身体。";
		close;
	}
	mes "希望你玩得愉快。";
	close;

OnWelcome:
	emotion ET_CHUP;
	end;
OnSolo:
	emotion ET_HUK;
	end;
}

jawaii_in,25,96,0	script	Employee#jaw2	724,{
	mes "[Employee Fey]";
	mes "欢迎来到斐扬岛酒馆～";
	if (getpartnerid()) {
		next;
		mes "[Employee Fey]";
		mes "希望你和心爱的人在这里度过愉快时光。这里舒适又温馨，";
		mes "是完美的浪漫氛围吧？";
		next;
		mes "[Employee Fey]";
		mes "如果不是那些‘无敌单身军团’的怪人，这里就完美了。";
		mes "不知怎么有几个笨蛋找到了这里。让他们见鬼去吧！";
		close;
	}
	else if (!getpartnerid()) {
		mes "玩得开心！不过请不要";
		mes "打扰这里幸福的已婚人士！";
		close;
	}
	mes "希望你玩得愉快～";
	close;

OnWelcome:
	emotion ET_CHUP;
	end;
OnSolo:
	emotion ET_HUK;
	end;
}

jawaii_in,25,98,0	script	Employee#jaw3	724,{
	mes "[Employee Buffy]";
	mes "欢迎来到斐扬岛酒馆～";
	if (getpartnerid()) {

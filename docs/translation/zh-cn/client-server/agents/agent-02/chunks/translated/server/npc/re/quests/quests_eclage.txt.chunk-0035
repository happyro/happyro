que_avan01,23,34,2	script	Hisie#tlspt	4_M_FARIY_HISIE,4,4,{
	cutin "hisie01",0;
	mes "[Hisie]";
	if (ep14_2_mylord == 21)
		mes "这里肯定有重要或奇怪的研究文件。";
	else if (ep14_2_mylord == 22)
		mes "真不敢相信你竟躲起来进行这种没用的研究……";
	close2;
	cutin "",255;
	end;

OnInit:
	hideonnpc "Hisie#tlspt";
	end;

OnTouch_:
	if (ep14_2_mylord == 22) {
		switch(rand(1,5)) {
		case 2:
			npcskill "AL_BLESSING",1,0,0;
			npcskill "AL_HEAL",10,99,80;
			break;
		case 3:
			npcskill "AL_INCAGI",1,0,0;
			break;
		default:
			npcskill "AL_HEAL",9,99,80;
		}
	}
	end;
}

que_avan01,25,41,5	script	Hisie#tlhunt	4_M_FARIY_HISIE,10,10,{
OnTouch_:
	cutin "hisie01",0;
	mes "[Hisie]";
	if (ep14_2_mylord == 22) {
		mes "别耍花样。";
		mes "你最好照我们说的做。";
		next;
		cutin "avant01",2;
		mes "[Avant]";
		mes "擅闯还不够，你现在还要抢劫我吗？";
		mes "这就是年轻人……";
		mes "算了，随你便。";
		next;
		cutin "hisie03",0;
		mes "[Hisie]";
		mes "……你在耍我吗？";
		mes "为什么这么轻易就让我抓到你？";
		mes "你在策划什么？！";
		next;
		cutin "avant02",2;
		mes "[Avant]";
		mes "没什么。也许是因为多年后见到我的儿子们很高兴？";
		next;
		cutin "hisie03",0;
		mes "[Hisie]";
		mes "你的儿子？饶了我吧。";
		mes strcharinfo(0) +"！我没什么要和这家伙说的了。";
		mes "我来处理，你继续前进。";
		ep14_2_mylord = 23;
	}
	else {
		mes "这里没什么可看的了。";
		mes "我们回去吧。";
	}
	close2;
	cutin "",255;
	warp "eclage",294,240;
	donpcevent "#avtmanager::OnReset";
	end;

OnInit:
	hideonnpc "Hisie#tlhunt";
	end;
}

bif_fild02,311,91,3	script	Dead Laphine#ecltl	4_FAIRYDEADLEAF,{
	if (ep14_2_mylord == 31) {
		mes "这是拉菲内的尸体。";
		mes "从尸体的变化来看，死亡时间应该不长。";
		next;
		mes "仔细一看，这是参谋长！";
		mes "本该是头部的地方有一个洞。";
		next;
		mes "洞口的血迹似乎指向南方。";
		mes "血迹像是某种长虫爬走留下的。";
		next;
		mes "["+ strcharinfo(0) +"]";
		mes "如果在这里南边……";
		mes "那就是裂隙。";
		mes "……他逃进裂隙了吗，Shenime！！";
		next;
		mes "["+ strcharinfo(0) +"]";
		mes "看来这里没有更多线索了。";
		mes "我应该尽快告诉 Kardui。";
		ep14_2_mylord = 32;
		changequest 7452,7453;
	}
	else if (ep14_2_mylord == 32) {
		mes "这是参谋长的尸体。";
		mes "曾经控制参谋长身体的东西已经逃走了。";
	}
	else
		mes "这是拉菲内的尸体。";
	close;
}

			mes "[Avant the Scholar of Magics]";
			mes "不，那有点困难。";
			mes "没礼貌的孩子。你们是在抢空房子吗？";
			mes "你们的胡闹到此为止！";
			hideoffnpc "Avant Magic Scholar#tlac";
			hideoffnpc "Avant's Summon#tlact01";
			hideoffnpc "Avant's Summon#tlact02";
			hideoffnpc "Avant's Summon#tlact03";
			hideoffnpc "Avant's Summon#tlact04";
			next;
			cutin "hisie01",0;
			mes "[Hisie]";
			mes "先拿着这个。";
			mes "我去找 Avant。";
			ep14_2_mylord = 22;
			getitem 6541,1; //Avant_Research_Data
			changequest 7443,7444;
			next;
			switch( select("让 Hisie 处理吧。:我来处理这里！") ) {
				mes "[Hisie]";
			case 1:
				cutin "hisie04",0;
				mes "我马上就到。";
				mes "把文件交给 Kar！";
				close2;
				warp "eclage",294,240;
				donpcevent "#avtmanager::OnReset";
				break;
			case 2:
				cutin "hisie01",0;
				mes "好吧。我们只要消灭 Avant 召唤的那些东西。";
				mes "我会在后方支援你。需要帮助就靠近我。";
				donpcevent "#avtmanager::OnEnable";
				close2;
			}
		}
	}
	else if (ep14_2_mylord == 22) {
		mes "Avant 的研究文件已经拿到了。";
		mes "桌上没什么可看的了。";
		close2;
	}
	else {
		mes "这是拉菲内学者的书桌。";
		close2;
	}
	cutin "",255;
	end;
}


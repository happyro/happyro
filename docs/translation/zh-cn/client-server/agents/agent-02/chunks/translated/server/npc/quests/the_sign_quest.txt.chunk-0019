			else {
				mes "[Serin]";
				mes "你还没放弃吗？请别再试图阻止我！";
				close2;
				set sign_q,126;
				donpcevent "Serin#witch::OnDisable";
				donpcevent "CallMonster#witch::Oncall";
				end;
			}
		}
		else {
			if (((sign_sq == 0) && (.@fail_s5 == 356)) || ((sign_sq == 1) && (.@fail_s4 == 356)) || (.@fail_s3 == 356)) {
				delitem 7308,1; //Witch's_Potion
				set sign_q,200;
				mes "[Serin]";
				mes "虽然你试图阻止我，但我仍不想取你性命。我明白你只是想保护米德加尔特。";
				next;
				mes "[Serin]";
				mes "不过……我不认为你有勇气克服众神的试炼。请别再来了……";
				next;
				mes "^3355FFSerin 从你那里拿走了 1 瓶女巫滋补药水。^000000";
				next;
				mes "[Serin]";
				mes "对不起……但我要用你的女巫滋补药水帮助我召唤黑暗领主。再见……";
				close2;
				set $@sign_w1,0;
				warp "niflheim",30,156;
				end;
			}
			else {
				mes "[Serin]";
				mes "你还没放弃吗？请别再试图阻止我！";
				close2;
				set sign_q,126;
				donpcevent "Serin#witch::OnDisable";
				donpcevent "CallMonster#witch::Oncall";
				end;
			}
		}
	}
	else if (sign_q == 200) {
		mes "[Serin]";
		mes "让我把你带回属于你的地方。……";
		close2;
		set $@sign_w1,0;
		warp "umbala",132,203;
		end;
	}
	else {
		mes "[Serin]";
		mes ".........";
		close;
	}
	end;

OnDisable:
	disablenpc "Serin#witch";
	end;

OnEnable:
	enablenpc "Serin#witch";
	end;
}

niflheim,313,70,4	script	Pleasant-Featured Lady#s	90,{
	callfunc "F_UpdateSignVars";
	if (sign_q < 82) {
		mes "[Serin]";
		mes "抱歉，你不是我要找的人。不……";
		close;
	}
	else if (sign_q == 82) {
		mes "[Serin]";
		mes "善良的冒险者……你就是我要找的人，那个踏上漫长旅程来证明";
		if (Sex == SEX_MALE) {
			mes "他勇气的人。";
		}
		else {
			mes "她的勇气。";
		}
		next;
		mes "[Serin]";
		mes "即使在尼弗海姆的黑暗中，我也能认出你。你像星星一样对我闪耀！求你听听我的故事……";
		next;
		switch(select("我很忙，抱歉。:好，请说。")) {
		case 1:
			mes "[Serin]";
			mes "我知道无法阻止你追寻荣耀之路。但如果你改变主意……！";
			close;
		case 2:
			mes "[Serin]";
			mes "谢谢……正如你从其他人那里听到、从我的外表看出的那样，我显然不属于这里。";
			next;
			mes "[Serin]";
			mes "我也许没有被女武神选中的幸运，但我需要你的帮助，尽快离开这里~";
			next;
			switch(select("呃，我想起来我很忙。:好，我们做吧。")) {
			case 1:
				mes "[Serin]";
				mes "我知道无法阻止你追寻荣耀之路。但如果你改变主意……！";
				close;
			case 2:
				mes "[Serin]";
				mes "我知道这要求太多，但如果你也帮助这里其他不幸的灵魂，我会非常感激。不知为何，我觉得解决他们的问题能帮助我回去。";
				next;
				switch(select("好啊，为什么不呢？:我为什么要帮助他们？")) {
				case 1:
					mes "[Serin]";
					mes "我就知道你会理解！你真是个善良的人。要帮助尼弗海姆其他不幸者，记得先取得他们的信任并接近他们，好吗？";
					set sign_q,83;
					close;
				case 2:
					mes "[Serin]";
					mes "我……我明白。虽然请你帮助这里其他人要求太多，但我希望你能意识到，这是目前寻找逃脱线索的最好方法。";
					set sign_q,84;
					close;
				}
			}
		}
	}
	else if (sign_q == 83) {
		if (sign_sq < 8) {
			mes "[Serin]";
			mes "嗯……？你不知道需要帮助尼弗海姆的哪些人？嗯，让我想想……";
			next;
			mes "[Serin]";
			mes "在这个注定毁灭的地方，人们彼此缺乏信任，但有些人会在你^3355FF靠近他们^000000、^3355FF面对面^000000时分享问题。明白吗？";
			next;
			mes "[Serin]";
			mes "这样一来，如果他们先和你说话，可能更愿意接受帮助，或告诉你真正需要知道的事。希望这能帮到你……";
			close;
		}
		else if (sign_sq == 8) {
			mes "[Serin]";
			mes "非常感谢你的帮助。这是我仅有的东西，对我意义重大，但我想把这枚戒指给你。这是我表达感激的唯一方式。";
			set sign_q,85;
			set sign_sq,0;
			getitem 2642,1; //Serin's_Gold_Ring
			close;
		}
		else {
			mes "[Serin]";
			mes "对死人来说，活人要么是美味猎物，要么是好目标。";
			close;
		}
	}
	else if (sign_q == 84) {
		mes "[Serin]";
		mes "你好，冒险者。最近过得怎么样？真惊讶还能在这座危险的城镇见到你。";
		next;
		mes "[Serin]";
		mes "如果你在尼弗海姆闲逛，会发现这里有些死者与其他人不同。请和他们谈谈，看看能否帮忙。";
		set sign_q,87;
		close;
	}
	else if (sign_q == 85) {
		mes "[Serin]";
		mes "尼弗海姆有一名声音甜美却忧郁的吟游诗人。他会为你这样的陌生冒险者歌唱。";
		next;
		mes "[Serin]";
		mes "我想他可能知道有用的信息，所以最好去和他谈谈。";
		set sign_q,86;
		close;
	}
	else if (sign_q < 92) {
		mes "[Serin]";
		mes "你好，"+strcharinfo(0)+"。真惊讶你能在这里活这么久。凡人能在尼弗海姆存活可不是小事……";
		close;
	}
	else if (sign_q == 92) {
		if (countitem(2642) > 0) {
			mes "[Serin]";
			mes "啊，"+strcharinfo(0)+"~最近怎么样？再次感谢你帮助这里可怜的灵魂。";
			next;
			mes "[Serin]";
			mes "嗯……？你脸上的表情是怎么回事？你想问我什么吗？";
			next;
		}
		else {
			mes "[Serin]";
			mes "啊，"+strcharinfo(0)+"~最近怎么样？";
			next;
			mes "[Serin]";
			mes "嗯……？你脸上的表情是怎么回事？你想问我什么吗？";
			next;
		}
			switch(select("没什么。:关于亡者女王……")) {
		case 1:
			mes "[Serin]";
			mes "如果你需要我的帮助，请不要犹豫，尽管开口。";
			close;
		case 2:
			mes "[Serin]";
			mes "亡者女王？她是尼弗海姆的统治者。作为洛基与安格尔波达最小的孩子，她被奥丁授予了这片领域的完全统治权。";
			next;
			mes "[Serin]";
			mes "她通常在自己的城堡赫尔统治，但有时也会外出巡视尼弗海姆。我只知道这些。";
			next;
			select("关于九界象征");
			mes "[Serin]";
			mes "哦，那个……？有时它被称为亡者凭证。奥丁把它交给亡者女王，象征她对尼弗海姆的权威。";
			next;
			mes "[Serin]";
			mes "关于那个象征及其能力有许多传闻，但我们唯一确定的是，它可以用来命令亡者……";
			next;
			select("关于安格尔波达");
			mes "[Serin]";
			mes "安格尔波达……？她是赫尔女王的母亲，也是这个宇宙中一些最强大怪物的母亲。";
			next;
			mes "[Serin]";
			mes "众神非常害怕她的怪物孩子，于是束缚他们并封印了安格尔波达。之后再也没有她的消息……";
			next;
			select("女巫告诉我你是……");
			mes "[Serin]";
			mes "哦，女巫说的是我？我知道她不太看得起我。不过，我也无法信任她。";
			next;
			mes "[Serin]";
			mes "没办法。至少我们都同意，我似乎确实不属于尼弗海姆。";
			emotion ET_THINK;
			set sign_q,93;
			close;
		}
	}
	else if (sign_q == 93) {
		mes "[Serin]";
		mes "抱歉上次和你说了很多无关的话。现在想想，我并没有告诉你真正有用的信息。";
		next;
		mes "[Serin]";
		mes "不过最近我听说亡者女王正在寻找她的母亲安格尔波达。奇怪的是，拥有全部力量的女王竟然也找不到她。";
		next;
		mes "[Serin]";
		mes "我不知道原因，但安格尔波达似乎被封印在米德加尔特世界……";
		emotion ET_THINK;
		set sign_q,94;
		close;
	}
	else if (sign_q == 94) {
		mes "[Serin]";
		mes "我已经告诉你所有知道的事了。但如果想了解更多关于安格尔波达的信息，你可能需要找真正能与众神沟通的人。";
		next;
		mes "[Serin]";
		mes "也许女武神，或真正住过阿斯加特的人，知道安格尔波达被封印在哪里。";
		next;
		mes "[Serin]";
		mes "另外，你为什么想要九界象征？这是非常危险的物品，落入坏人手中会造成巨大麻烦……";
		next;
		switch(select("你是什么意思？:别担心，不会的。")) {
		case 1:
			mes "[Serin]";
			mes "尼弗海姆有许多被悔恨和绝望驱使的死者。如果他们拥有象征，死亡的愤怒可能会让他们犯下可怕的罪行。";
			next;
			switch(select("那我该怎么办？:谢谢你的担心，但我不担心。")) {
			case 1:
				mes "[Serin]";
				mes "我真的认为你应该在给别人看之前先把象征带给我。然后，我会告诉你为什么需要它的力量。";
				next;
				mes "[Serin]";
				mes "我现在无法解释，但我想用象征的力量为你做真正有帮助的事。你只需要相信我。";
				next;
				select("我会考虑的。");
				mes "[Serin]";
				mes "那我会在这里等你。";
				set sign_q,95;
				close;
			case 2:
				mes "[Serin]";
				mes "好吧……由你决定。";
				set sign_q,95;
				close;
			}
		case 2:
			mes "[Serin]";
			mes "啊……好吧。如果你有资格获得象征，应该也有能力保护它不被滥用。";
			set sign_q,95;
			close;
		}
	}
	else if (sign_q < 118) {
		mes "[Serin]";
		mes "如果你得到九界象征，请马上把它带给我，"+strcharinfo(0)+"。";
		close;
	}
	else if (sign_q == 118) {
		mes "[Serin]";
		mes "是的……这就是九界象征。它只有一次使用的力量，但得到它仍然不容易。现在，你打算用它做什么？";
		next;
		select("告诉她你的故事。");
		mes "[Serin]";
		mes "啊，所以你来尼弗海姆是为了克服众神试炼，向女武神证明勇气。";
		next;
		mes "[Serin]";
		mes "等等……你只是为了那个女巫才得到象征？也许这话很无礼，但我想告诉你我对她的真实看法。";
		next;
		mes "[Serin]";
		mes "她没有向你解释意图，难道不可疑吗？九界象征是尼弗海姆最强大的物品之一。她计划的事一定规模巨大。";
		next;
		mes "[Serin]";
		mes "还有那个 Metz Brayde。你真的相信他完成研究后会还给你？你不能把拥有巨大力量的物品交给别人，再指望他还回来！";
		next;
		switch(select("我、我该怎么办？:我不敢相信！")) {
		case 1:
			mes "[Serin]";
			mes "我不能告诉你该怎么做，但我不认为把九界象征交给那个女巫是好主意。没人知道她会用它的力量做什么。";
			next;
			mes "[Serin]";
			mes "其实……有个传闻正在流传，但我不知道你是否想听……";
			set sign_q,131;
			close;
		case 2:
			mes "[Serin]";

// Kunlun Transportation
//============================================================
-	script	::Kunlun_Envoy_gonryun	-1,{
	mes "[Wa Bai Hu]";
	mes "你好～";
	mes "欢迎大家来到我的故乡，";
	mes "昆仑。";
	mes "我很荣幸能为";
	mes "来自卢恩·米德加尔特王国的";
	mes "尊贵客人担任向导。";
	next;
	switch(select("About Kunlun:Visit Kunlun:Cancel")) {
	case 1:
		mes "[Wa Bai Hu]";
		mes "昆仑是一个美丽的地方，";
		mes "拥有悠久的历史和独特传统。";
		mes "我认为昆仑是";
		mes "观光游览的最佳地点。";
		next;
		mes "[Wa Bai Hu]";
		mes "抵达昆仑港口后，";
		mes "你会看到艾尔贝塔和";
		mes "普隆德拉建筑的";
		mes "微型复制品。";
		mes "非常值得一看。";
		next;
		mes "[Wa Bai Hu]";
		mes "悠闲散步之后，";
		mes "走进美丽的光柱，";
		mes "它会带你穿过云层，";
		mes "前往昆仑村。";
		mes "祝你旅途愉快。";
		mes "请慢慢欣赏沿途风景。";
		next;
		mes "[Wa Bai Hu]";
		mes "我听说在卢恩·米德加尔特大陆上，";
		mes "还有另一座城市";
		mes "被古老而神秘的力量";
		mes "托在天空中……";
		mes "真令人好奇。";
		next;
		mes "[Wa Bai Hu]";
		mes "我的昆仑也漂浮在空中，";
		mes "但不依靠所谓的科技";
		mes "或能源供应。";
		mes "我们认为这片土地";
		mes "受到了特别的祝福……";
		next;
		mes "[Wa Bai Hu]";
		mes "来到昆仑时，别忘了";
		mes "品尝我们的特色美食。";
		mes "比如巨型饺子或天桃。";
		next;
		mes "[Wa Bai Hu]";
		mes "如果你打算参观昆仑地牢，";
		mes "最好提前做好准备。";
		mes "那里并不是适合游玩的安全场所。";
		mes "请务必小心。";
		next;
		mes "[Wa Bai Hu]";
		mes "如果你有兴趣参观昆仑，";
		mes "请随时告诉我。";
		mes "能为你服务是我的荣幸，";
		mes "尊贵的客人。";
		close;
	case 2:
		mes "[Wa Bai Hu]";
		mes "非常好的选择，欢迎你成为我们的客人～";
		mes "不过乘船前往昆仑需要支付少量费用。";
		mes "请提前准备好。";
		next;
		mes "[Wa Bai Hu]";
		mes "请在出发前支付 10,000 Zeny。";
		mes "这笔费用也包含返回艾尔贝塔的费用。";
		mes "我随时可以带你前往昆仑。";
		mes "请放心乘坐。";
		mes "旅途很快就会开始。";
		next;
		mes "[Wa Bai Hu]";
		mes "你想登船吗？";
		next;
		if (select("前往昆仑～！:否。") == 1) {
			if (Zeny > 9999) {
				mes "[Wa Bai Hu]";
				mes "谢谢，我现在就带你前往那里。";
				close2;
				set Zeny, Zeny-10000;
				warp "gon_fild01",258,82;
				end;
			}
			mes "[Wa Bai Hu]";
			mes "抱歉，前往昆仑需要";
			mes "10,000 Zeny。";
			mes "请确保你携带足够的 Zeny。";
			mes "谢谢，欢迎下次再来。";
			mes "祝你旅途愉快。";
			close;
		}
		mes "[Wa Bai Hu]";
		mes "我明白了。如果你改变主意，";
		mes "请随时告诉我。";
		mes "能为你服务是我的荣幸，";
		mes "尊贵的客人。";
		mes "欢迎再次光临。";
		close;
	case 3:
		mes "[Wa Bai Hu]";
		mes "我明白了。如果你改变主意，";
		mes "请随时告诉我。";
		mes "能为你服务是我的荣幸，尊贵的客人。";
		mes "希望你旅途愉快。";
		close;
	}
}

gon_fild01,255,79,7	script	Kunlun Envoy#gon2	776,{
	mes "[Wa Bai Hu]";
	mes "旅途愉快吗？";
	mes "我想你该回家了。";
	mes "前往卢恩·米德加尔特的船随时可以出发。";
	next;
	if (select("Go back to Alberta:Cancel") == 1) {
		mes "[Wa Bai Hu]";
		mes "欢迎再次光临。";
		mes "回去后请把昆仑介绍给你的朋友。";
		mes "现在让我带你回到艾尔贝塔。";
		mes "请跟紧我。";
		mes "一路顺风。";
		close2;
		if (checkre(0))
			warp "alberta",245,87;
		else
			warp "alberta",243,67;
		end;
	}
	mes "[Wa Bai Hu]";
	mes "慢慢来，客人。";
	mes "这里还有很多地方";
	mes "你可能还没参观过。";
	close;
}

gon_fild01,187,239,7	script	Kunlun Envoy#gon3	776,{
	mes "[Zhang Quing Long]";
	mes "请向北走进入昆仑。";
	mes "希望你在昆仑期间";
	mes "度过美好时光。";
	close;
}

gonryun,153,64,7	script	Kunlun Envoy#gon4	776,{
	mes "[Zhang Quing Long]";
	mes "请放松休息。";
	mes "如果你想回去，";
	mes "我很乐意带你前往";
	mes "返回艾尔贝塔的船。";
	next;
	if (select("Go back to the harbor:Cancel") == 1) {
		mes "[Zhang Quing Long]";
		mes "希望你旅途愉快。";
		mes "现在让我带你回到港口。";
		mes "请跟我来。";
		close2;
		warp "gon_fild01",258,82;
		end;
	}
	mes "[Zhang Quing Long]";
	mes "慢慢来，客人。";
	mes "这里还有很多地方";
	mes "你可能还没参观过。";
	close;
}

// Generic Kunlun NPCs
//============================================================
gonryun,200,82,3	script	Jian Chung Xun#gon	774,{
	mes "[Jian Chung Xun]";
	mes "我非常喜欢节日。";
	mes "所以我喜欢这座城镇。";
	mes "这里让我感觉一年到头";
	mes "都像置身节日之中。";
	close;
}

gonryun,268,88,3	script	Liang Zhun Bu#gon	776,{
	mes "[Liang Zhun Bu]";
	mes "我们为成为独立国家而自豪，";
	mes "多年来一直抵抗";
	mes "企图征服这片受祝福土地的邪恶入侵者……";
	mes "我们绝不会屈服。";
	next;
	mes "[Liang Zhun Bu]";
	mes "但我们成功击退了每次入侵！";
	mes "只要相信自己，";
	mes "我们就永远不会忘记";
	mes "在斗争中帮助我们的凯旋之歌。";
	mes "它会一直激励我们。";
	close;
}

gonryun,118,111,5	script	Qian Yuen Shuang#gon	89,{
	mes "[Qian Yuen Shuang]";
	mes "这座城镇的首领是个";
	mes "愿意向他人敞开心扉的人。";
	mes "不过我听说有些人";
	mes "不喜欢他的性格……";
	next;
	mes "[Qian Yuen Shuang]";
	mes "我喜欢这座城镇。首领的努力";
	mes "让我们的家园更加安全。";
	mes "我希望其他人也能理解";
	mes "他所做的一切。";
	close;
}

gonryun,181,161,3	script	Jing Wen Zhen#gon	773,{
	mes "[Jing Wen Zhen]";
	mes "我们昆仑的男人们";
	mes "都勇敢而有胆量。";
	mes "但他们却无法结婚。";
	mes "真是令人遗憾……";
	next;
	mes "[Jing Wen Zhen]";
	mes "都是因为男人比女人多。";
	mes "我甚至不知道我的儿子";
	mes "能不能给我找个儿媳妇。";
	mes "真让人担心。";
	mes "希望他能遇到合适的人。";
	close;
}

gonryun,113,135,6	script	Gatekeeper#gon	780,{
	mes "[Kunlun Guard]";
	mes "欢迎。";
	mes "这里是昆仑首领史彦文的住所。";
	next;
	mes "[Kunlun Guard]";
	mes "在这里最好规矩一点。";
	mes "如果发现任何可疑行为，";
	mes "我们会立刻逮捕你。";
	next;
	mes "[Kunlun Guard]";
	mes "不过请放心，你看起来值得信任。";
	mes "我相信不会发生任何问题。";
	mes "祝你参观愉快。";
	close;
}

gonryun,113,127,6	script	Gatekeeper#gon2	780,{
	mes "[Kunlun Guard]";
	mes "欢迎。";
	mes "这里是昆仑首领史彦文的住所。";
	next;
	mes "[Kunlun Guard]";
	mes "在这里最好规矩一点。";
	mes "如果发现任何可疑行为，";
	mes "我们会立刻逮捕你。";
	next;
	mes "[Kunlun Guard]";
	mes "不过请放心，你看起来值得信任。";
	mes "我相信不会发生任何问题。";
	mes "祝你参观愉快。";
	close;
}

gon_in,73,82,5	script	Ji Chung Zhe#gon	778,{
	if (nakha >= 0 && nakha <= 2) {
		mes "[Ji Chung Zhe]";
		mes "............";
		next;
		mes "[Ji Chung Zhe]";
		mes "呼……这确实";
		mes "令人担心。";
		mes "希望情况不会恶化。";
		close;
	}
	if (nakha == 3) {
		// set cha,1;// unused
		mes "[Ji Chung Zhe]";
	mes "我是纪忠哲，一位著名的茶师。";
	mes "每天我都会全力制作";
	mes "美味可口的茶。";
		next;
		mes "[Ji Chung Zhe]";
		mes "*叹气* 但最近我做的茶";
	mes "但最近做出的茶不太理想……";
	mes "要是能找到特别的材料就好了……";
		next;
		mes "[Ji Chung Zhe]";
	mes "听说使用蛇就能调制";
	mes "真正非凡的饮料～";
	mes "但是……我该去哪里找蛇，";
	mes "又该怎么抓住它呢？";
	mes "嗯……";
		close;
	}
}

gon_in,173,27,3	script	Yu Jiu Xia#gon	774,{
	mes "[Yu Jiu Xia]";
	mes "哎呀，果然如此。";
	mes "他们不肯卖酒给我。";
	mes "也许是因为我年纪太小……";
	mes "嗯……不知道酒是什么味道……";
	next;
	mes "[Yu Jiu Xia]";
	mes "不过我知道他们正在制作";
	mes "连我这样的孩子也能享用的美味茶。";
	mes "光是想想这种新茶，";
	mes "我就忍不住流口水。";
	mes "真想马上尝尝。";
	close;
}

gonryun,166,196,3	script	Soldier#gon	780,{
	if (b_sword < 7) {
		mes "[Wa Qiu Wu]";
		mes "告诉你一些关于这里的趣事～";
		mes "很久以前，这一带曾经是一座神社。";
		mes "这里有着悠久的历史。";
		next;
		mes "[Wa Qiu Wu]";
		mes "那时，道士们会聚集于此，";
		mes "试图前往天界。";
		mes "然而他们惨败了……";
		mes "怪物也逐渐开始出现……";
		close;
	}
	else if ((b_sword > 6) && (b_sword < 10)) {
		mes "[Wa Qiu Wu]";
		mes "你不觉得昨晚很吵吗？";
		mes "都是那个小偷造成的。";
		mes "他闹出了很大动静……";
		mes "声音太大了，";
		mes "我完全睡不着……";
		next;
		mes "[Wa Qiu Wu]";
		mes "啊～～～～！";
		mes "在那片混乱中，";
		mes "我看到有什么东西";
		mes "直接跑进了神社。";
		mes "速度非常快。";
		next;
		mes "[Wa Qiu Wu]";
		mes "它跑得太快了，我甚至看不清。";
		mes "依稀看起来像人类。";
		mes "不知道到底是什么……";
		mes "真让人好奇。";
		mes "也许是那个小偷。";
		next;
		mes "[Wa Qiu Wu]";
		mes "可能就是那个小偷，";
		mes "但它移动得太快了，";
		mes "看起来只是一道模糊的影子。";
		mes "我从没见过那么快的人。";
		close;
	}
	mes "[Wa Qiu Wu]";
	mes "告诉你一些有趣的事～";
	mes "这一带以前曾经是一座神社。";
	mes "历史非常悠久。";
	next;
	mes "[Wa Qiu Wu]";
	mes "很久以前，道士们会聚集于此，";
	mes "试图前往天界。";
	mes "然而他们惨败了……";
	mes "怪物也逐渐开始出现。";
	next;
	mes "[Wa Qiu Wu]";
	mes "城镇正在为节日做准备，";
	mes "但有些事情让活动延期了。";
	mes "以前从未发生过这种情况……";
	close;
}

gonryun,169,71,3	script	Guidev#gon	770,{
	mes "[Li Xi Jiao]";
	mes "欢迎来到昆仑！";
	mes "一路上的美景还满意吗？";
	mes "这里的建筑虽然不大，";
	mes "但我们都为建造这座城市付出了努力。";
	mes "希望你喜欢这里。";
	next;
	mes "[Li Xi Jiao]";
	mes "我这里有一些卢恩·米德加尔特王国的微缩模型。";
	mes "一眼就能看到整个普隆德拉。";
	mes "这些杰作的工艺";
	mes "真是令人惊叹！";
	mes "欢迎仔细欣赏。";
	next;
	mes "[Li Xi Jiao]";
	mes "如果你仔细观察，";
	mes "会发现城镇各处";
	mes "都有美丽的景色。";
	close;
}


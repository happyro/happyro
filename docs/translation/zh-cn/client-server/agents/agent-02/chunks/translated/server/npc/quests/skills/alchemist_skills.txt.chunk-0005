		mes "告诉我会发生的事！什么——？";
		mes "你已经去过 Keshibien 了？";
		mes "糟糕！我还以为你至少";
		mes "还要一小时才会到！";
		next;
		mes "[Broncher]";
		mes "哦，别管清醒了。";
		mes "我直接教你";
		mes "^FF0000人工生命体复活^000000";
		mes "技能。这反正是你需要学习的";
		mes "人工生命体技能中";
		mes "最后几个之一。";
		next;
		mes "[Broncher]";
		mes "没错，你真的可以";
		mes "让人工生命体起死回生。";
		mes "另外，你应该知道这项技能";
		mes "在技能等级 5 时";
		mes "达到精通。";
		next;
		mes "[Broncher]";
		mes "要让你的";
		mes "人工生命体起死回生，";
		mes "只需按下这个按钮，";
		mes "上面标着‘人工生命体";
		mes "复活’。很简单，对吧？";
		mes "";
		next;
		mes "[Broncher]";
		mes "好了，课程结束。";
		mes "关于使用人工生命体复活，";
		mes "你已经知道所有需要知道的事。";
		mes "不过你仍需要 Kellasus";
		mes "教你基础知识。";
		mes "";
		set bioeth,7;
		next;
		mes "[Broncher]";
		mes "没有那些基础";
		mes "技巧，你从我们这里学到的";
		mes "一切都会白费。所以……";
		mes "祝你好运，想办法说服";
		mes "Kellasus 教你吧。";
		mes "";
		next;
		mes "[Broncher]";
		mes "现在离开，";
		mes "让我独自享受";
		mes "这些酒，";
		mes "好吗？";
		close;
	}
	mes "[Broncher]";
	mes "^333333*Hiccup~*^000000";
	mes "哦对，就是这个！";
	mes "我称它为……";
	mes "我的‘反清醒’";
	mes "配方！想不出";
	mes "更棒的发明了……";
	close;
}

lhz_in03,106,34,3	script	Koring#qsk_al	706,{
	if (BaseJob == Job_Alchemist && bioeth == 8 || bioeth == 9) {
		mes "[Koring]";
		mes "我爸爸是最棒的";
		mes "炼金术士！他超级";
		mes "聪明，我从没听说";
		mes "他犯过错！";
		next;
		mes "[Koring]";
		mes "爸爸最近总是在思考，";
		mes "我不知道为什么。爸爸";
		mes "担心事情时会变得";
		mes "非常严肃。";
		mes "";
		next;
		mes "[Koring]";
		mes "他总是努力";
		mes "让我开心，";
		mes "在我遇到问题时帮助我。";
		mes "就像我生病的时候……";
		next;
		mes "[Koring]";
		mes "爸爸尽力制作";
		mes "帮助我的药，";
		mes "还四处寻找";
		mes "能治好我的医生。";
		mes "那段时间我真的很害怕，";
		mes "但爸爸从未放弃。";
		next;
		if (bioeth == 8) set bioeth,9;
		mes "[Koring]";
		mes "他现在可能有点";
		mes "暴躁，但我的爸爸";
		mes "仍然是最棒的！";
		mes "希望他早日好起来。";
		close;
	}
	mes "[Koring]";
	mes "爸爸怎么会这么聪明？";
	mes "我希望自己也能像他一样";
	mes "快速学习，长大后";
	mes "也成为炼金术士！";
	close;
}

lhz_in03,109,31,5	script	Beninne#qsk_al	90,{
	if (BaseJob == Job_Alchemist && bioeth == 8 || bioeth == 9) {
		mes "[Beninne]";
		mes "你见过我丈夫";
		mes "Kellasus 吗？他既固执又坚定，";
		mes "具体是哪一种，取决于你";
		mes "怎么看他。一旦他";
		mes "下定决心，就不会动摇！";
		mes "";
		next;
		mes "[Beninne]";
		mes "他是很好的丈夫和父亲，";
		mes "但我觉得一旦他认定自己";
		mes "在某件事上是对的，";
		mes "就算全世界也很难";
		mes "改变他的想法。";
		mes "";
		next;
		mes "[Beninne]";
		mes "当然，如果你能证明他错了，";
		mes "他会尽力弥补。";
		mes "我第一次见到 Kellasus 时，";
		mes "他就是这样的。";
		mes "";
		next;
		mes "[Beninne]";
		mes "有这样一个人保护你，";
		mes "感觉真好。";
		mes "Kellasus 热爱他的工作，";
		mes "但他更爱自己的家人。";
		mes "很神奇，对吧？";
		mes "";
		close;
	}
	mes "[Beninne]";
	mes "大多数人认为";
	mes "做科学家的妻子很难。";
	mes "我很幸运，我的丈夫";
	mes "是如此顾家的男人，";
	mes "即使他是一名炼金术士。";
	close;
}

lighthalzen,226,210,3	script	Nannan#qsk_al	86,{
	mes "[Nannan]";
	mes "你知道，我一直以为炼金术士都是书呆子，";
	mes "学者型的人，总是埋头读书学习。但";
	mes "我找到了一个完全不符合这种刻板印象的人。";
	next;
	mes "[Nannan]";
	mes "这个家伙，叫什么来着，";
	mes "Broncher，总是在浪费时间喝酒。";
	mes "我猜他发现了把水变成上等酒的秘密。";
	mes "至少他不是古板的类型。";
	next;
	mes "[Nannan]";
	mes "我不知道他能给想成为";
	mes "炼金术士的人多少帮助，";
	mes "但在我看来，";
	mes "这个人是货真价实的";
	mes "天才！至少相较于";
	mes "我这样的街头小人物……";
	close;
}

lhz_in01,218,141,7	script	Alchemist#qsk_al	98,{
	mes "[Alchemist]";
	mes "在人类之中，";
	mes "我认为 Kellasus 是";
	mes "最接近发现";
	mes "生命奥秘的人。";
	mes "他总是让我惊叹……";
	mes "";
	next;
	mes "[Alchemist]";
	mes "我也很佩服他，";
	mes "他不会让工作妨碍自己";
	mes "成为家人最好的父亲和丈夫。";
	mes "他是我们所有人的榜样。";
	mes "";
	next;
	mes "[Alchemist]";
	mes "Kellasus 确实是";
	mes "一个了不起的人。";
	mes "我认识的炼金术士没有一个";
	mes "不在科学和个人生活方面";
	mes "仰慕他的。";
	mes "";
	close;
}


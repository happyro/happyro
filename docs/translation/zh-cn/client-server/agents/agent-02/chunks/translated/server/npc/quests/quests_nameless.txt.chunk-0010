					mes "^3355FF*嗡嗡*嗡嗡*机器的震动现在稳定了一些。你要试哪个开关？^000000";
						next;
					switch(select("红色开关:蓝色开关:黄色开关:绿色开关")) {
						default:
							mes "^3355FF*嗖嗖*^000000";
							mes "^3355FF*嗖嗖*^000000";
							next;
							mes "^3355FF机器发出剧烈而紊乱的声响，剧烈震动后突然停止。开错了开关，最好去问多里安……";
							changequest 3105,3106;
							set diamond_edq,11;
							close;
						case 3:
							if (.@yellow >= 0) {
								mes "^3355FF*嗡嗡嗡*^000000";
								mes "^3355FF*铿锵……！*^000000";
								next;
								mes "^3355FF机器的震动变强了。看来你选对了开关。^000000";
								next;
								set .@yellow,.@yellow+1;
							}
							else {
								mes "^3355FF*嗖嗖*^000000";
								mes "^3355FF*嗖嗖*^000000";
								next;
								mes "^3355FF机器发出剧烈紊乱的声音，猛烈震动后突然停止。开错了开关，最好去问多里安……";
								changequest 3105,3106;
								set diamond_edq,11;
								close;
							}
							break;
						}
					}
					else if (.@switch_sound == 4) {
						next;
						mes "^3355FF*滋滋滋*机器现在震动得很厉害。你要试哪个开关？^000000";
						next;
						switch(select("红色开关:蓝色开关:黄色开关:绿色开关")) {
						default:
							mes "^3355FF*嗖嗖*^000000";
							mes "^3355FF*嗖嗖*^000000";
							next;
							mes "^3355FF机器发出剧烈紊乱的声音，猛烈震动后突然停止。开错了开关，最好去问多里安……";
							changequest 3105,3106;
							set diamond_edq,11;
							close;
						case 4:
							if (.@green >= 0) {
								mes "^3355FF*滋滋滋*^000000";
								mes "^3355FF*铿锵……！*^000000";
								next;
								mes "^3355FF机器的震动变强了。看来你选对了开关。^000000";
								next;
								set .@green,.@green+1;
							}
							else {
						mes "^3355FF*嗖嗖*^000000";
						mes "^3355FF*嗖嗖*^000000";
						next;
						mes "^3355FF机器发出剧烈紊乱的声音，猛烈震动后突然停止。开错了开关，最好去问多里安……";
								changequest 3105,3106;
								set diamond_edq,11;
								close;
							}
							break;
						}
					}
				}
			}
		}
	}
	if (diamond_edq == 12) {
		mes "[Dorian]";
		mes "看来你已经修好我的优雅神秘烘干机了。回来吧，我来解释怎么使用。";
		close;
	}
	if ((diamond_edq == 13) && (countitem(7722) < 1)) {
		mes "^3355FF你抬起主操作开关，灯亮起并打开一个插槽。你把湿掉的债券放进去。^000000";
		next;
		mes "^3355FF发动机的活塞和气缸发出欢快的轰鸣，暖机停止后，插槽重新打开。^000000";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "这就是穆夫丢失的原始债券？看起来……完美！";
		changequest 3108,3109;
		getitem 7722,1; //Debt_Note
		close;
	}
	else if ((diamond_edq == 13) && (countitem(7722) > 0)) {
		mes "你已经用这台机器修复债券了。没必要再摆弄它。";
		close;
	}
	mes "[Dorian]";
	mes "你是谁？别想碰我的珍贵杰作！";
	close;
}

// Broken Diamond
//============================================================
moc_ruins,152,147,5	script	Ibrahim	732,3,3,{
	if (checkweight(907,200) == 0) {
		mes "[Ibrahim]";
		mes "你带的东西太多了。先存进卡普拉仓库、卖掉或丢掉，再来找我，好吗？";
		close;
	}
	if (diamond_edq < 14) {
		mes "[Ibrahim]";
		mes "你听说过四大诅咒宝石吗？听说其中的毁灭之钻最近出现了。我真想找到它……";
		close;
	}
	if ((diamond_edq == 14) && (BaseLevel > 65)) {
		mes "[Ibrahim]";
		mes "" + strcharinfo(0) + ", right?";
		mes "别太惊讶。我到处都听说过你的事。嘿嘿~！";
		next;
		while(1) {
			switch(select("我能帮你什么？:你听说了什么？:再见！")) {
			case 1:
				mes "[Ibrahim]";
				mes "我想问问四大诅咒宝石的事。附近所有商人都在谈论它们。总之，我设法得到了毁灭之钻！";
				next;
				mes "[" + strcharinfo(0) + "]";
				mes "(^666666嗯……他可能在说穆夫交给贝尔德抵债的那颗宝石。^000000)";
				next;
				mes "[Ibrahim]";
				mes "我花了大价钱买下它，却在几天后弄丢了。我严密保管，但还是没能阻止小偷……";
				next;
				mes "[Ibrahim]";
				mes "这工作有风险，但我想雇你查出钻石去了哪里。能找回来最好，找不到我也理解。你愿意吗？";
				next;
				switch(select("好，我帮你。:不，抱歉。")) {
				case 1:
					mes "[Ibrahim]";
					mes "太好了！我就知道找你是正确的。小偷没留下线索，但出售这颗独一无二的宝石应该会遇到麻烦。";
					next;
					mes "[Ibrahim]";
					mes "先去卢恩-米德加尔特王国的大型珠宝店看看吧。那里的商人最了解这些宝石。";
					next;
					mes "[Ibrahim]";
					mes "小偷还得把宝石卖给买得起天价的珠宝商。你应该去三个主要地点调查。";
					next;
					mes "[Ibrahim]";
					mes "去找艾尔贝塔的^0000FFJhonnita^000000、斐扬的^0000FFKimeunbang^000000和吉芬的^0000FFLeblo^000000。他们也很想要那颗钻石，应该记得相关线索。";
					next;
					mes "[Ibrahim]";
					mes "别让他们知道是我雇你调查钻石。如果他们发现是我派你去的，就不会对你说实话。";
					next;
					mes "[Ibrahim]";
					mes "好，我就在这里。希望你带着好消息回来。";
					setquest 3110;
					set diamond_edq,15;
					close;
				case 2:
					mes "[Ibrahim]";
					mes "真的吗？我费了很大力气才找到你，不过……我理解。如果你改变主意，我仍愿意雇你发挥专长。";
					close;
				}
			case 2:
				if ((BaseJob == Job_Novice) || (BaseJob == Job_Super_Novice)) {
					mes "[Ibrahim]";
					mes "原来是真的……人们说你只是初心者，却仍会帮助他们解决问题。";
					close;
				}
				else if (BaseClass == Job_Swordman) {
					mes "[Ibrahim]";
					mes "我在剑士协会有几个朋友。我说在找聪明又强大的人时，他们提到了你的名字。";
					close;
				}
				else if (BaseClass == Job_Crusader) {
					mes "[Ibrahim]";
					mes "嘿，原来你真的是神圣骑士。能亲自见到你，我很高兴。";
					close;
				}
				else if (BaseClass == Job_Acolyte) {
					mes "[Ibrahim]";
					mes "没想到神职人员会这么强，不过你的名声早已传开了。";
					close;
				}
				else if (BaseClass == Job_Merchant) {
					mes "[Ibrahim]";
					mes "嘿，如果连你的名字都不知道，我怎么能自称商人？你是我们的榜样~";
					close;
				}
				else if (BaseClass == Job_Blacksmith) {
					mes "[Ibrahim]";
					mes "我们有共同的朋友，你知道吗？阿拉甘姆对你评价很高。";
					close;
				}
				else if (BaseClass == Job_Alchemist) {
					mes "[Ibrahim]";
					mes "我认识一个人，他认识炼金术士公会的人。在他们那里，你似乎很有名。";
					close;
				}
				else if (BaseClass == Job_Magician) {
					mes "[Ibrahim]";
					mes "魔法完全超出我的理解，但只要能解决问题就不算坏。我听说你很擅长。";
					close;
				}
				else if (BaseClass == Job_Thief) {
					mes "[Ibrahim]";
					mes "嘿，听起来摩洛克所有有头有脸的人都知道你是谁。很高兴认识你~";
					close;
				}
				else if (BaseClass == Job_Archer) {
					mes "[Ibrahim]";
					mes "所有用弓的人谈到精准与英雄气概时似乎都会提到你的名字。真难以相信我竟在和你说话~";
					close;
				}
				else if (BaseClass == Job_Bard) {
					mes "[Ibrahim]";
					mes "真的吗？听说你唱歌像天使……";
					close;
				}
				else if (BaseClass == Job_Dancer) {
					mes "[Ibrahim]";
					mes "真的吗？听说你跳舞像恶魔……";
					close;
				}
				else if ((Class == Job_Star_Gladiator) || (Class == Job_Star_Gladiator2)) {
					mes "[Ibrahim]";
					mes "我和你的老导师菲尼克斯是老朋友。他谈起你时只有骄傲~";
					close;
				}
				else if (Class == Job_Soul_Linker) {
					mes "[Ibrahim]";
					mes "我从梦中的神秘讯息里听到了你的名字。听起来不疯狂吧？";
					close;
				}
			case 3:
				mes "[Ibrahim]";
				mes "你难道一点也不好奇我怎么知道你的事？等等，回来！我没那么可疑！";
				close;
			}
		}
	}
	if (diamond_edq == 15) {
		mes "[Ibrahim]";
		mes "去找艾尔贝塔的^0000FFJhonnita^000000、斐扬的^0000FFKimeunbang^000000和吉芬的^0000FFLeblo^000000。他们也很想要那颗钻石，应该记得相关线索。";
		next;
		mes "[Ibrahim]";
		mes "别让他们知道是我雇你调查钻石。如果发现是我派你去的，他们不会对你说实话。";
		close;
	}
	if ((diamond_edq > 15) && (diamond_edq < 25)) {
		mes "[Ibrahim]";
		mes "你还在调查钻石的下落吗？希望你很快能带回好消息。";
		close;
	}
	if (diamond_edq == 25) {
		mes "[Ibrahim]";
		mes "哦，你回来了。调查毁灭之钻有进展吗？";
		next;
		select("说明调查结果");
		mes "[Ibrahim]";
		mes "什么？！Z 帮偷了我的钻石？难怪！他们肯定想利用它的诅咒做坏事。宝石呢？你找回来了吗？";
		next;
		select("交出毁灭之钻");
		mes "[Ibrahim]";
		mes "哦！太好了！原来它在 Z 帮的藏身处？哇，即使听说过那么多你的事，你还是超出了我的期待！";
		next;
		delitem 7723,1; //Diamond_Of_Ruin
		mes "[Ibrahim]";
		mes "感谢上天，我终于拿回它了！啊，至于你的报酬……我不知道是否足够，但希望你喜欢。";
		completequest 3118;
		set diamond_edq,26;
		getitem 732,2; //Crystal_Jewel__
		getitem 603,1; //Old_Blue_Box
		next;
		mes "[Ibrahim]";
		mes "现在我再次拥有毁灭之钻，可以继续研究它奇特的性质。如果需要帮助，我会再联系你。";
		close;
	}
	if (diamond_edq == 26) {
		if (jewel_nd == 0) {
			if ((treasure_nd > 10) && (BaseLevel > 65)) {
				mes "[Ibrahim]";
				mes "啊，我听摩洛克的朋友说你得到了不幸翡翠。我确定它是四大诅咒宝石之一。让我看看，可以吗？";
				next;
				switch(select("不行！:当然可以。")) {
				case 1:
					mes "[Ibrahim]";
					mes "不行？我相信你有自己的理由。不过，如果让我研究，也许能发现对我们都有益的东西。";
					close;
				case 2:
					mes "[Ibrahim]";
					mes "啊，太感谢了！现在让我看看……";
					next;
					if (countitem(7725) > 0) {
						mes "[Ibrahim]";

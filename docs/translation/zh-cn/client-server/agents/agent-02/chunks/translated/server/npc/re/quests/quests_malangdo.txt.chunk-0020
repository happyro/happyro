		close;
	}
	for(set .@i,5074; .@i<=5090; set .@i,.@i+1) {
		if (checkquest(.@i) > -1) {
			mes "[KungKung]";
			mes "你没有遵守约定。我和你没什么好谈的。";
			close;
		}
	}
	if (malang_gamer < 20) {
		if (countitem(2872)) {
			mes "[KungKung]";
		mes "你不符合资格。嗯……我不知道你怎么得到这个的，但我们不能和你练习。回去吧。";
			close;
		}
		mes "[KungKung]";
		mes "别烦我。我在等练习伙伴。";
		close;
	}
	if (!isequipped(2872)) {
		mes "[KungKung]";
		mes "你是练习伙伴？你迟到了。马上开始吧。";
		next;
		mes "[KungKung]";
		mes "... ... ...";
		next;
		mes "[KungKung]";
		mes "你的证书呢？没有证书就不能和我们练习。去拿来。";
		close;
	}
	if (checkquest(5072,PLAYTIME) == 0 || checkquest(5072,PLAYTIME) == 1) {
		mes "[KungKung]";
		mes "你没有手表？还是不会看时间？现在还没到时候。";
		close;
	} else if (checkquest(5072,PLAYTIME) == 2)
		erasequest 5072;
	mes "[KungKung]";
	mes "你是练习伙伴？你迟到了。马上开始吧。";
	next;
	switch(select("开始游戏。：询问当前第一名。：询问游戏规则。")) {
	case 1:
		mes "[KungKung]";
		mes "游戏开始前，我们会通过掷骰子决定顺序。";
		next;
		break;
	case 2:
		mes "[KungKung]";
		mes "你为什么想知道第一名？空喵空是一种残酷又激烈的对战游戏。库卡应该知道！";
		close;
	case 3:
		mes "[KungKung]";
		mes "你想学习游戏规则？";
		mes "你提问的方式很有礼貌。";
		mes "仔细听。";
		next;
		mes "[KungKung]";
		mes "空喵空在攻击和防守时有不同的规则。";
		next;
		mes "[KungKung]";
		mes "攻击时，你必须把手转向和对手相同的一侧，才能完成攻击。";
		next;
		cutin "cat_g_01",4;
		mes "[KungKung]";
		mes "像这样把手转向同一侧，你的攻击就成功了。";
		next;
		cutin "",255;
		mes "[KungKung]";
		mes "防守时，你必须把手转向和对手相反的一侧，才能保护自己。";
		next;
		cutin "cat_g_06",4;
		mes "[KungKung]";
		mes "没错！像这样把手转向和我相反的一侧，你就成功防守了。";
		next;
		cutin "",255;
		mes "[KungKung]";
		mes "如果你足够聪明，就该知道下面的手是攻击者的手。";
		next;
		mes "[KungKung]";
		mes "最后！！最重要的规则。";
		mes "攻击成功后，可以继续攻击对手。";
		mes "失败后，就轮到你防守。";
		mes "别忘了！";
		next;
		mes "[KungKung]";
		mes "你随时都可以询问空喵空的规则！";
		mes "我们的管理员猫也熟悉所有空喵空规则。";
		mes "就是这些！";
		close;
	}
	while(1) {
		set .@pc_dic,  rand(6);
		set .@npc_dic, rand(6);

		// Emote[58-63]:
		// ET_DICE1, ET_DICE2, ET_DICE3, ET_DICE4, ET_DICE5, ET_DICE6
		emotion ET_DICE1+.@pc_dic, playerattached();
		emotion ET_DICE1+.@npc_dic;

		if (.@pc_dic > .@npc_dic) {
			mes "[KungKung]";
			mes "你的骰子点数更高，可以先攻击。";
			set .@attack_turn,1;
			next;
			break;
		} else if (.@pc_dic < .@npc_dic) {
			mes "[KungKung]";
			mes "我的骰子点数更高，我先攻击。";
			set .@attack_turn,2;
			next;
			break;
		} else {
			mes "[KungKung]";
			mes "我们点数相同。再掷一次骰子吧。";
			next;
		}
	}
	set .@pc_hp,100;
	set .@npc_hp,100;
	while(1) {
		if (!.@pc_hp || !.@npc_hp) break;
		mes strcharinfo(0)+" (^FF0000"+.@pc_hp+"^000000/100)";
		mes "--------------------------------";
		mes "空空（^FF0000"+.@npc_hp+"^000000/100）";
		next;
		mes "[KungKung & "+strcharinfo(0)+"]";
		mes "空！";
		emotion ET_BLABLA, playerattached();
		emotion ET_BLABLA;
		next;
		mes "[KungKung & "+strcharinfo(0)+"]";
		mes "空！喵！";
		emotion ET_BLABLA, playerattached();
		emotion ET_BLABLA;
		next;
		mes "[KungKung & "+strcharinfo(0)+"]";
		mes "空！喵！空！";
		emotion ET_BLABLA, playerattached();
		emotion ET_BLABLA;
		next;
		set .@cat_hand, rand(1,10);
		switch(.@attack_turn) {
		case 1: // Attack
			mes "你想如何攻击？";
			mes " ";
			mes "　 Tip !!";
			mes "选择手背：^FF0000猫展示手背时你获胜。^000000";
			mes "选择手掌：^FF0000猫展示手掌时你获胜。^000000";
			next;
			switch(select("手背：手掌")) {
			case 1:
				if (.@cat_hand <= 5) {
					set .@npc_hp, .@npc_hp-10;
					cutin "cat_g_01",4;
					specialeffect EF_BASH;
					mes "攻击成功。";
					mes "你拍中了空空的爪背。";
					next;
					cutin "",255;
				} else {
					set .@attack_turn,2;
					cutin "cat_g_02",4;
					mes "攻击失败。";
					mes "空空现在开始攻击。";
					next;
					cutin "",255;
				}
				break;
			case 2:
				if (.@cat_hand <= 5) {
					set .@attack_turn,2;
					cutin "cat_g_03",4;
				mes "攻击失败。";
				mes "空空现在开始攻击。";
					next;
					cutin "",255;
				} else {
					set .@npc_hp, .@npc_hp-10;
					cutin "cat_g_04",4;
					specialeffect EF_BASH;
				mes "攻击成功。";
				mes "你拍中了空空的爪背。";
					next;
					cutin "",255;
				}
				break;
			}
			break;
		case 2: // Defend
			mes "你想如何防守？";
			mes " ";
			mes "　 Tip !!";
			mes "选择手背：^FF0000猫展示手背时你获胜。^000000";
			mes "选择手掌：^FF0000猫展示手掌时你获胜。^000000";
			next;
			switch(select("手背：手掌")) {
			case 1:
				if (.@cat_hand <= 5) {
					set .@pc_hp, .@pc_hp-10;
					cutin "cat_g_05",4;
					specialeffect2 EF_BASH;
					mes "防守失败。";
					mes "空空用锋利的爪子攻击你的手背。";
					next;
					cutin "",255;
				} else {
					set .@attack_turn,1;
					cutin "cat_g_06",4;
					mes "防守成功。";
					mes "现在可以开始攻击。";
					next;
					cutin "",255;
				}
				break;
			case 2:
				if (.@cat_hand <= 5) {
					set .@attack_turn,1;
					cutin "cat_g_07",4;
			mes "防守成功。";
			mes "现在可以开始攻击。";
					next;
					cutin "",255;
				} else {
					set .@pc_hp, .@pc_hp-10;
					cutin "cat_g_08",4;
					specialeffect2 EF_BASH;
			mes "防守失败。";
			mes "空空用锋利的爪子攻击你的手背。";
					next;
					cutin "",255;
				}
				break;
			}
			break;
		}
	}
	if (.@npc_hp == 0) {
		mes "[KungKung]";
	mes "我输了。这确实是场好比赛。";
	mes "赢下来当然更好，但我太忙了，没空回顾过去。";
		next;
		cutin "cat_g_lose",4;
		mes "[KungKung]";
	mes "呜……";
		emotion ET_CRY;
		next;
		cutin "",255;
		mes "[KungKung]";
	mes "嗯……我想没必要这样。";
	mes "这个给你，人类！";
		setquest 5072;
		getitem 12636,5; //Malang_Sp_Can
		next;
		mes "[KungKung]";
	mes "明天再来。我下次会赢你。";
		close2;
		cutin "",255;
		end;
	}
	cutin "cat_g_win",4;
	mes "[KungKung]";
	mes "我赢了。这场比赛很无聊。";
	mes "你需要多练习。也许做些额外工作会有帮助。";
	next;
	setquest 5072;
	switch(rand(1,13)) {
	case 1:
		setquest 5074;
		mes "[KungKung]";
		mes "去捕捉美味的鱼菲恩。";
		next;
		mes "[KungKung]";
		mes "去捕捉30条菲恩，再弄10条鱼尾。交给我们的猫咪总监，他会用它们做出美味料理。";
		break;
	case 2:
		setquest 5075;
		mes "[KungKung]";
		mes "我可能锻炼过度了……感觉无力，身体负担也太重。该注意健康了。";
		next;
		mes "[KungKung]";
		mes "我已经10岁了，是时候吃些健康食物。";
		next;
		mes "[KungKung]";
		mes "给猫咪游戏总监带50个马尔斯和30瓶牛奶。他很了解健康食品。";
		break;
	case 3:
		setquest 5076;
		mes "[KungKung]";
		mes "我们有个对手。‘狗狗华尔兹’队……他们一来就会出问题。";
		next;
		mes "[KungKung]";
		mes "我想请你欺负他们，但那是违法的……";
		next;
		mes "[KungKung]";
		mes "去骚扰30名哥布灵弓箭手，别去找‘狗狗华尔兹’，然后向猫咪游戏总监报告。";
		break;
	case 4:
		setquest 5077;
		mes "[KungKung]";
		mes "速度是赢得比赛最重要的因素。为了提高速度……";
		next;
		mes "[KungKung]";
		mes "最好去抓老鼠。现在是捕捉痉挛鼠的时候。";
		next;
		mes "[KungKung]";
		mes "抓10只痉挛鼠，然后向猫咪游戏总监报告。";
		break;
	case 5:
		setquest 5078;
		mes "[KungKung]";
		mes "我想吃鸟类料理。你以前尝过吗？";
		next;
		mes "[KungKung]";
		mes "波利波利听起来很好吃。我不喜欢独自吃饭，所以……";
		next;
		mes "[KungKung]";
		mes "捕捉50只波利波利，向猫咪游戏总监报告。我们可以用波利波利料理举办晚宴。";
		break;
	case 6:
		setquest 5079;
		mes "[KungKung]";
		mes "保持冷静是赢得重要比赛的关键。";
		next;
		mes "[KungKung]";
		mes "没有哪只猫小时候没玩过毛线。";
		next;
		mes "[KungKung]";
		mes "弄20个毛线，向猫咪游戏总监报告。这能提高我们队伍的能力。";
		break;
	case 7:
		setquest 5080;
		mes "[KungKung]";
		mes "我强烈怀疑管理员猫在偷吃我们的零食。";
		next;
		mes "[KungKung]";
		mes "我们只需要证据……弄30条老鼠尾巴，向猫咪游戏总监报告。";
		next;
		mes "[KungKung]";
		mes "这样就能查明管理员猫是否做了坏事。";
		break;
	case 8:
		setquest 5081;
		mes "[KungKung]";
		mes "练习还不错，但我最近似乎陷入低谷。";
		next;
		mes "[KungKung]";
		mes "这种时候需要一些柠檬。";
		next;
		mes "[KungKung]";
		mes "给猫咪游戏总监带5个柠檬。他知道该怎么做。";
		break;
	case 9:
		setquest 5082;
		mes "[KungKung]";
		mes "马来岛是适合猫咪居住的地方。但这里很容易变热。";
		next;
		mes "[KungKung]";
		mes "这种炎热的日子，需要一些冰块或冰淇淋。";
		next;
		mes "[KungKung]";
		mes "弄10个冰块或10个冰淇淋。我们的猫咪游戏总监应该知道怎么用。";
		break;
	case 10:
		setquest 5083;
		mes "[KungKung]";
		mes "这是猫咪游戏总监的要求。我得让你去跑一趟。";
		next;
		mes "[KungKung]";
		mes "找到马来岛的猫艾留，大声清楚地说‘回来’。";
		next;
		mes "[KungKung]";
		mes "之后向猫咪游戏总监报告。出发吧！！";
		break;
	case 11:
		setquest 5085;
		mes "[KungKung]";
		mes "这是猫咪游戏总监的要求。我得让你去跑一趟。";
		next;
		mes "[KungKung]";
		mes "找到马来岛的猫炖汤，大声清楚地说‘回来’。";
		next;
		mes "[KungKung]";
		mes "之后向猫咪游戏总监报告。出发吧！！";
		break;
	case 12:
		setquest 5087;
		mes "[KungKung]";
		mes "这是猫咪游戏总监的要求。我得让你去跑一趟。";
		next;
		mes "[KungKung]";
		mes "找到马来岛的猫番茄酱，大声清楚地说‘回来’。";
		next;
		mes "[KungKung]";
		mes "之后向猫咪游戏总监报告。出发吧！！";
		break;
	case 13:
		setquest 5089;
		mes "[KungKung]";
		mes "这是猫咪游戏总监的要求。我得让你去跑一趟。";
		next;
		mes "[KungKung]";
		mes "找到马来岛的猫艾弗，大声清楚地说‘回来’。";
		next;
		mes "[KungKung]";
		mes "之后向猫咪游戏总监报告。出发吧！！";
		break;
	}
	close2;
	cutin "",255;
	end;
}

mal_in01,133,214,6	script	Leader#gamer	546,{
	if (MaxWeight - Weight < 1000) {
		mes "背包太重，无法继续。减轻负重后再来。";
		close;
	}
	if (checkweight(1201,1) == 0) {
		mes "背包太满，无法继续。清理背包后再来。";
		close;
	}
	for(set .@i,5074; .@i<=5090; set .@i,.@i+1) {
		if (checkquest(.@i) > -1) {
			mes "[Leader]";
		mes "完成分配的工作后才能挑战旗帜游戏。";
			close;
		}
	}
	if (malang_gamer < 20) {
		if (countitem(2872)) {
			mes "[Leader]";
		mes "不是有证书就人人都能挑战。";
			close;
		}
		mes "[Leader]";
		mes "好，在挑战者到来前先练习吧！！";
		close;
	}
	if (!isequipped(2872)) {
		mes "[Leader]";
		mes "你想挑战吗？";
		next;
		mes "[Leader]";
		mes "... ... ...";
		next;
		mes "[Leader]";
		mes "没有装备我们的证书物品，就不能挑战旗帜游戏。请稍后再来。";
		close;
	}
	if (checkquest(5073) == 0 || checkquest(5073) == 1) {
		mes "[Leader]";
		mes "旗帜游戏每天只能进行一次。";
		close;
	} else if (checkquest(5073) == 2)
		erasequest 5073;
	mes "[Leader]";
	mes "你想挑战吗？";
	next;
	switch(select("挑战。：你是谁？：询问规则。")) {
	case 1:
		mes "[Leader]";
	mes "开始挑战旗帜游戏。请等待猫咪们准备。";
		next;
		break;
	case 2:
		mes "[Leader]";
	mes "哦！我从‘猫咪游戏’退休了，现在正在考国家游戏裁判资格。最近考证很流行。";
		next;
		mes "[Leader]";
	mes "裁判必须使用标准语言……所以我很难像其他猫那样停止喵喵叫~";
		next;
		mes "[Leader]";
	mes "我当然知道玩家的游戏规则，但担任裁判比想象中难得多。";
		next;
		mes "[Leader]";
	mes "有时我会犯错，人们就像世界末日一样发疯。这工作真难。";
		next;
		mes "[Leader]";
	mes "但我想完成课程，成为世界上最好的裁判。";
		next;
		mes "[Leader]";
	mes "你可以相信我！！";
		close;
	case 3:
		mes "[Leader]";
	mes "请允许我说明挥旗游戏的规则。";
		next;
		mes "[Leader]";
	mes "你会和另外5只猫一起玩。";
	mes "等待其他人都没有挥旗时再挥旗。";
		next;
		mes "[Leader]";
	mes "开始时有5点旗帜点数，每次挥旗会减少1点。";
	mes "点数降到0时，游戏结束。";
		next;
		mes "[Leader]";
	mes "旗帜游戏还有特殊规则。为了增加刺激，如果连续10局不挥旗，就会减少1点。";
		next;
		mes "[Leader]";
	mes "使用更少旗帜点数获胜，就能得到更丰厚的礼物。";
		next;

job_cru,24,187,4	script	Patron Knight#2	751,{
	mes "[布利安特·皮约尔]";
	mes "欢迎。";
	mes "你将在这里进行";
	mes "最后一项测试。";
	mes "准备好接受";
	mes "测试后，请进入";
	mes "等候室。";
	next;
	mes "[布利安特·皮约尔]";
	mes "一次只能有一人参加测试。若已有其他人在测试，请等待测试区域再次开放。";
	next;
	mes "[布利安特·皮约尔]";
	mes "每人有 4 分钟完成测试。若想在测试中途离开，请断开游戏连接。";
	close;
}

job_cru,24,187,2	script	Waiting Room#cr1	700,{
	end;


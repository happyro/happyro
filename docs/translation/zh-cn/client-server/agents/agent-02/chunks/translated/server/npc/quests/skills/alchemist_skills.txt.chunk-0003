				mes "我知道可以相信你会将这项研究用于善良高尚的目的。现在，请阅读这篇论文和我的补充笔记……";
				next;
				mes "^3355FF皮斯鲁伊克详细解释了药物的性质、人体器官对它的反应，以及药物副作用的警告。^000000";
				next;
				set ALCHE_SK,11;
				getitem 7434,1; //Elemental_Create_Book
				mes "[Pisruik]";
				mes "好了，你应该可以制作出我这种药物的变体药水了。不过最好把论文留在手边以便查阅。";
				next;
				mes "[Pisruik]";
				if (Sex == SEX_MALE) {
					mes "希望将来还能再见。冒险者，旅途顺利。*咳咳* 现在……我的下一个项目是什么呢？";
				}
				else {
					mes "总之，我很快要开始新项目，所以我们暂时就此分别。不过，认识你真的非常愉快……";
				}
				close;
			}
			mes "[Pisruik]";
			mes "真、真的吗……？如果你改变主意，随时回来，我可以教你。";
			if (Sex == SEX_FEMALE) {
				mes "完全不麻烦！我真的很喜欢和你相处……";
			}
			close;
		}
		else if (ALCHE_SK == 11) {
			if (countitem(7434) == 0) {
				mes "[Pisruik]";
				mes "糟糕……你把我写给你的论文弄丢了？我现在没时间再写一份……";
				close;
			}
			else if (countitem(7434) == 1) {
				mes "[Pisruik]";
				mes "你最近怎么使用我教你制作的药水？希望它们能在冒险中派上用场。";
				close;
			}
			else if (countitem(7434) > 1) {
				mes "[Pisruik]";
				mes "嗯，我的论文副本已经在外面流传了？抱歉，我没时间给你的副本签名……";
				close;
			}
		}
		else {
			mes "[Pisruik]";
			mes "嗯……？你需要什么特别的东西吗？不过，恐怕我这个身份的人帮不了你。";
			close;
		}
	}
	else {
		mes "[Pisruik]";
		mes "嗯……？你需要什么特别的东西吗？不过，恐怕我这个身份的人帮不了你。";
		close;
	}
}

yuno_in04,22,107,5	script	Irache#qsk_al	740,{
	mes "[Irache]";
	mes "嘿嘿嘿……！完成了！有了这个配方，我能熔化世上的任何物质！哈哈哈！没有什么能阻挡我统治世——";
	next;
	mes "[Irache]";
	mes "好痛！秘密配方！它烧穿试管了！我把它做得太强了！该死！";
	close;
}

yuno_in04,27,107,4	script	Degas#qsk_al	748,{
	mes "[Degas]";
	mes "和这些科学家挨得这么近工作真麻烦。旁边那家伙总是喋喋不休地说要统治世界什么的。";
	next;
	mes "[Degas]";
	mes "另一个怪人又总是咳嗽。他们两个吵得我根本无法专心研究！真希望能在自己的秘密私人实验室工作……";
	close;
}

yuno_in04,33,106,4	script	Pile of Books#qsk_al	111,{
	mes "^3355FF这只是一堆散乱的文件。虽然看起来没有整理，但这里的人似乎总能在^FFFFFF ^3355FF需要时找到想要的东西。";
	close;
}

// Start Bioethics quest
lhz_in01,224,140,3	script	Kellasus#qsk_al	57,{
	if (BaseJob == Job_Alchemist && bioeth == 13) {
		mes "[Kellasus]";
		mes "继续努力。我有种感觉，我们的未来可能取决于你……";
		close;
	}
	if (BaseJob == Job_Alchemist && bioeth == 12) {
		mes "[Kellasus]";
		mes "好吧，我先教你^FF0000生物伦理学^000000，这是制作人工生命体的基础技能。";
		next;
		mes "[Kellasus]";
		mes "要掌握生物伦理学，你必须珍惜生命的美好，真心关心生物。因此，你必须始终照顾自己的人工生命体。";
		next;
		mes "[Kellasus]";
		mes "你必须经常确认人工生命体是否疲倦、饥饿或受伤，也要考虑它作为你的宠物对你的感情。";
		next;
		mes "[Kellasus]";
		mes "当这种关怀态度成为你的本能时，你就掌握了生物伦理学。听起来简单，但只有通过经验才能理解与人工生命体的关系。";
		next;
		mes "[Kellasus]";
		mes "现在你应该已经足够了解如何制作和照顾自己的人工生命体。我相信你会负责任地寻找造福人类的发现。";
		next;
		mes "[Kellasus]";
		mes "分别之前，能告诉我你的名字吗？";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "我的名字是……";
		mes "" + strcharinfo(0) + "。";
		next;
		set bioeth,13;
		skill "AM_BIOETHICS",1,SKILL_PERM;
		mes "[Kellasus]";
		mes "啊……";
		mes "" + strcharinfo(0) + "。我会记住的。暂时再见，希望有一天你能为炼金术的世界做出伟大贡献。";
		close;
	}
	if (BaseJob == Job_Alchemist && bioeth == 11) {
		mes "[Kellasus]";
		mes "我们的观点不同，但我同意人工生命体研究的潜力太大，作为科学家和人道主义者，我不能再忽视。";
		next;
		mes "[Kellasus]";
		mes "如果我教你这些技能，你可能会踏过道德界线。但我相信，只要你学习的是能造福大众的东西，就应该没问题。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "这……这意味着你会教我吗？";
		next;
		mes "[Kellasus]";
		mes "别太兴奋。我仍不确定人工生命体研究是否该向所有炼金术士开放，但目前我相信你。";
		next;
		mes "[Kellasus]";
		mes "不过，你必须使用我教你的技能造福他人。我不可能在你学会制作人工生命体后强迫你忘记，明白吗？";
		next;
		set bioeth,12;
		mes "[Kellasus]";
		mes "请给我一点时间准备课程。我已经很久没做这种事了……";
		close;
	}
	if (BaseJob == Job_Alchemist && bioeth == 10) {
		set bioeth,11;
		mes "[Kellasus]";
		mes "^333333*叹气*^000000 我太困惑了……你说的一切都没错，但现在我不知道该相信什么……";
		close;
	}
	if (BaseJob == Job_Alchemist && bioeth == 9) {
		mes "[Kellasus]";
		mes "你又来请我教人工生命体技能吗？你真是执着，不过我想这也许正是你成为炼金术士的原因……";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "嗯，我确实是来问这个的。不过首先，我听说你的儿子曾经病得很重……";
		next;
		mes "[Kellasus]";
		mes "是、是的。那段时间对我来说很难谈。想到失去儿子就让我无法承受。他是我的全部……";
		next;
		mes "[Kellasus]";
		mes "为了让儿子活下去，我绝望到可以毫不后悔地出卖灵魂。我甚至愿意为他牺牲自己的生命。";
		next;
		mes "[Kellasus]";
		mes "幸运的是，儿子从疾病中康复了，现在很健康。但你为什么要提醒我这件事？";
		mes "这件事？";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "你说得对，创造人工生命体会带来道德问题。但比起道德，我想尽量诉诸你的人道主义精神。";
		next;
		mes "[Kellasus]";
		mes "我不明白。你说的人道主义究竟是什么意思？";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "我相信人工生命体研究能帮助我们发现生命的秘密。其中造福人类的潜力实在太大，不能忽视。";
		next;
		mes "["+ strcharinfo(0) +"]";
		mes "我对创造新生物或扮演上帝没兴趣。我想要的是无论疾病多么绝望，都能治愈人们的知识。";
		next;
		mes "["+ strcharinfo(0) +"]";
		mes "创造实验性生命并牺牲它们也许不道德，但为了可能需要我发现的疗法的人们，我愿意这么做……";
		next;
		mes "["+ strcharinfo(0) +"]";
		mes "你儿子生病时，你愿意做出牺牲让他康复。但世界上还有其他患有更严重疾病的人……";
		next;
		mes "["+ strcharinfo(0) +"]";
		mes "我想研究人工生命体，因为也许能为某个绝望的处境带来希望……";
		next;
		set bioeth,10;
		mes "[Kellasus]";
		mes "我从没……我从没想过……抱歉，我需要独处一会儿……";
		close;
	}
	if (BaseJob == Job_Alchemist && bioeth == 8) {
		mes "[Kellasus]";
		mes "虽然我承认你有能力学习我能教的人工生命体知识，但凭良心我不能这么做。抱歉，请放弃吧。";
		close;
	}
	if (BaseJob == Job_Alchemist && bioeth == 7) {
		mes "[Kellasus]";
		mes "要我说多少次？抱歉，我不能教你任何人工生命体相关知识。尤其让我在意的是，你对它们一无所知……";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "但在我离开期间，我花了很多时间向这些炼金术专家学习人工生命体。我保证自己有资格学习基础知识！";
		next;
		mes "[Kellasus]";
		mes "专家……？你是说斯卡拉杰德、凯希比恩和布朗彻？我的老同事。好吧，但我会判断你是否学到了人工生命体知识。";
		next;
		mes "[Kellasus]";
		mes "我要问你几个问题，希望你全部答对。准备好了吗？";
		next;
		mes "[Kellasus]";
		mes "第一题。掌握到技能等级 1 后，哪个技能能让施法者收回人工生命体，使其进入休眠状态？";
		next;
		input .@input$;
		if (.@input$ == "Vaporize") {
			mes "[Kellasus]";
			mes "嗯，不错。看来你确实学习过。第二题：用于召唤人工生命体技能、名称表示人工生命体早期阶段的物品是什么？";
			next;
			input .@input$;
			if (.@input$ == "Embryo") {
				mes "[Kellasus]";
				mes "嗯，这题你也答对了。第三题：掌握到技能等级 5 后，能复活人工生命体的技能叫什么？";
				next;
				input .@input$;
				if (.@input$ == "Homunculus Resurrection") {
					mes "[Kellasus]";
					mes "看来你在这方面下了很大功夫。我很佩服你的投入，你似乎有潜力成为优秀的炼金术士。";
					next;
					mes "[Kellasus]";
					mes "不过，即使你有资格学习所有人工生命体技能，我仍基于个人原则选择不教。没有什么能改变我的想法。";
					next;
					mes "[Kellasus]";
					mes "我承认你取得的进步让我骄傲，但我无法参与我认为是滥用生命恩赐的行为。";
					next;
					set bioeth,8;
					mes "[Kellasus]";
					mes "风险太大了！我无法承担人工创造生命可能带来的任何后果。";
					close;
				}
				else {
					mes "[Kellasus]";
					mes "我很失望……我真以为你已经学会了所有人工生命体知识，但看来你的知识还有一些空白。";
					close;
				}
			}
			else {
				mes "[Kellasus]";
				mes "嗯……看来你对人工生命体的了解仍然不足。即使我想教你，你似乎也还没准备好……";
				close;
			}
		}
		else {
			mes "[Kellasus]";
			mes "你应该能答对第一题";

//===== rAthena Script ======================================= 
//= Kafra Teleportation Services
//===== Changelogs: ==========================================
//= 1.0 First Version. [JohnnyPlayy]
//===== Description: ========================================= 
// Texts from this script were translated according to KRO
//============================================================

function	script	F_KafTeleDoram	{
	.@menu_choice = getarg(0);

	cutin "kafra_do01", 2;
	mes "[Kafra Employee]";
	mes "欢迎。";
	mes "卡普拉服务永远站在你这边。";
	mes "请选择目的地。";
	next;
	switch(.@menu_choice) {
	case 1: // Alberta
		switch( select( "斐扬东南原野", "沉船", "取消。") ) {
		case 1:
			callsub( S_Zone, "Southeast Field of Payon", 250,13 );
			warp "pay_fild06",199,152;
			end;
		case 2:
			callsub( S_Zone, "Sunken Ship", 50,3 );
			warp "alb2trea",55,63;
			end;
		case 3:
			callfunc( "F_KafEnd",0,0 );
		}
	case 2: // Aldebaran
		switch( select( "艾尔迪巴兰边境", "取消。") ) {
		case 1:
			callsub( S_Zone, "Aldebaran Border", 50,3 );
			warp "yuno_fild01",194,150;
			end;
		case 2:
			callfunc( "F_KafEnd",0,0 );
		}
	case 3: // Einbroch
		switch( select( "深渊谷西部原野", "莱恩哈特北部原野", "取消。") ) {
		case 1:
			callsub( S_Zone, "West Field of the Abyss Valley", 600,30 );
			warp "ein_fild06",199,152;
			end;
		case 2:
			callsub( S_Zone, "North Field of Lighthalzen", 1400,70 );
			warp "lhz_fild01",244,130;
			end;
		case 3:
			callfunc( "F_KafEnd",0,0 );
		}
	case 4: // Geffen
		switch( select( "吉芬塔地下入口", "妙勒尼山北部原野", "兽人村", "古城入口", "取消。") ) {
		case 1:
			callsub( S_Zone, "Geffen Tower Underground Entrance", 300,15 );
			warp "gef_tower",153,46;
			end;
		case 2:
			callsub( S_Zone, "North Field of Mount Mjolnir", 150,8 );
			warp "mjolnir_02",172,195;
			end;
		case 3:
			callsub( S_Zone, "Orc Village", 100,5 );
			warp "gef_fild10",150,301;
			end;
		case 4:
			callsub( S_Zone, "Glast Heim Entrance", 6666,444 );
			warp "gef_fild06",34,270;
			end;
		case 5:
			callfunc( "F_KafEnd",0,0 );
		}
	case 5: // Lighthalzen
		switch( select( "莱恩哈特北部原野", "取消。") ) {
		case 1:
			callsub( S_Zone, "North Field of Lighthalzen", 200,10 );
			warp "lhz_fild01",244,130;
			end;
		case 2:
			callfunc( "F_KafEnd",0,0 );
		}
	case 6: // Morocc
		switch( select( "梦罗克遗迹金字塔", "苏格拉特沙漠斯芬克斯", "梦罗克东南原野", "海洞海滩", "死者国度", "取消。") ) {
		case 1:
			callsub( S_Zone, "Morocc Ruins Pyramid", 50,3 );
			warp "moc_ruins",100,140;
			end;
		case 2:
			callsub( S_Zone, "Sograt Desert Sphinx", 50,3 );
			warp "moc_fild19",132,100;
			end;
		case 3:
			callsub( S_Zone, "Southeast Morocc Field", 100,5 );
			warp "moc_fild11",267,100;
			end;
		case 4:
			callsub( S_Zone, "Comodo Beaches", 250,13 );
			warp "cmd_fild02",89,83;
			end;
		case 5:
			callsub( S_Zone, "Kingdom of the Dead", 12121,666 );
			warp "niflheim",220,141;
			end;
		case 6:
			callfunc( "F_KafEnd",0,0 );
		}
	case 7: // Payon
		switch( select( "弓箭手村", "斐扬东南原野", "普隆德拉南部原野", "取消。") ) {
		case 1:
			callsub( S_Zone, "Archer's Village", 50,3 );
			warp "pay_arche",69,130;
			end;
		case 2:
			callsub( S_Zone, "Southeast Payon Field", 100,5 );
			warp "pay_fild10",203,331;
			end;
		case 3:
			callsub( S_Zone, "Prontera South Field", 150,8 );
			warp "moc_fild02",109,144;
			end;
		case 4:
			callfunc( "F_KafEnd",0,0 );
		}
	case 8: // Prontera
		switch( select( "普隆德拉西南原野", "普隆德拉北部原野", "拜亚兰岛", "普隆德拉南部原野", "取消。") ) {
		case 1:
			callsub( S_Zone, "Southwestern Prontera Field", 100,5 );
			warp "prt_fild07",250,257;
			end;
		case 2:
			callsub( S_Zone, "Prontera North Field", 150,8 );
			warp "prt_fild01",194,123;
			end;
		case 3:
			callsub( S_Zone, "Byalan Island", 150,8 );
			warp "izlu2dun",63,129;
			end;
		case 4:
			callsub( S_Zone, "Prontera South Field", 150,8 );
			warp "moc_fild02",109,144;
			end;
		case 5:
			callfunc( "F_KafEnd",0,0 );
		}
	case 9: // Rachel
		switch( select( "冰洞南部原野", "托尔火山东部原野", "取消。") ) {
		case 1:
			callsub( S_Zone, "Southern Ice Cave Field", 600,30 );
			warp "ra_fild04",214,220;
			end;
		case 2:
			callsub( S_Zone, "Thor Volcano East Field", 600,30 );
			warp "ve_fild04",198,174;
			end;
		case 3:
			callfunc( "F_KafEnd",0,0 );
		}
	case 10: // Veins
		switch( select( "托尔火山东部原野", "维因斯南部原野", "取消。") ) {
		case 1:
			callsub( S_Zone, "Thor Volcano East Field", 400,20 );
			warp "ra_fild04",198,174;
			end;
		case 2:
			callsub( S_Zone, "South Veins Field", 200,10 );
			warp "ve_fild07",85,255;
			end;
		case 3:
			callfunc( "F_KafEnd",0,0 );
		}
	case 11: // Yuno
		switch( select( "深渊谷西部原野", "深渊谷幻影挖掘区", "朱诺高原熔岩洞窟", "深渊湖西部原野", "取消。") ) {
		case 1:
			callsub( S_Zone, "West Field of the Abyss Valley", 400,20 );
			warp "ein_fild06",199,152;
			end;
		case 2:
			callsub( S_Zone, "Phantasmagorika Excavation of the Abyss Valley", 400,20 );
			warp "yuno_fild07",225,145;
			end;
		case 3:
			callsub( S_Zone, "Magma Dungeon Juno Plateau", 400,20 );
			warp "yuno_fild03",201,152;
			end;
		case 4:
			callsub( S_Zone, "West Field of Abyss Lake", 800,40 );
			warp "hu_fild04",186,78;
			end;
		case 5:
			callfunc( "F_KafEnd",0,0 );
		}
	}

S_Zone:
	.@zeny_req = getarg(1);
	.@item_req = getarg(2);

	mes "[Kafra Employee]";
	mes getarg(0) + "需要 ^ff0000" + .@zeny_req + " Zeny^000000 或 ^ff0000" + .@item_req + " 个玛岚岛罐头^000000。";
	next;
	switch( select( .@zeny_req + " Zeny", .@item_req + " 个玛岚岛罐头", "取消" ) ) {
	case 1:
		if (Zeny < .@zeny_req)
			break;
		Zeny -= .@zeny_req;
		return;
	case 2:
		if (countitem(12636) < .@item_req)
			break;
		delitem 12636,.@item_req; // Malang_Sp_Can
		return;
	case 3:
		mes "[Kafra Employee]";
		mes "能告诉我其他服务地点吗？";
		close3;
	}
	mes "[Kafra Employee]";
	mes "先生！你没有足够的费用。";
	mes "请准备好后再来。";
	close3;
}

moc_para01,35,23,3	script	Kafra Teleportation#eden	4_F_DRKAFRA01,{
	cutin "kafra_do01", 2;
	mes "[Kafra Employee]";
	mes "欢迎。";
	mes "卡普拉服务永远站在你这边。";
	next;
	mes "[Kafra Employee]";
	mes "为了回馈冒险者的支持，卡普拉公司与伊甸园集团合作，为^ff0000等级 39 以下的初心者冒险者^000000提供免费服务。";
	next;
	if (BaseLevel > 40) {
		mes "[Kafra Employee]";
		mes "我们不为^ff0000等级 40 以上^000000的冒险者提供免费传送服务。";
		mes "请在城镇中寻找卡普拉传送服务。";
		close3;
	}
	mes "[Kafra Employee]";
	mes "请选择目的地。";
	next;
	switch( select( "普隆德拉西部原野", "普隆德拉西南原野", "普隆德拉湖畔原野", "斐扬地下城入口", "伊兹鲁德西南原野", "取消。") ) {
	case 1:
		mes "[Kafra Employee]";
		mes "普隆德拉原野：";
		mes "普隆德拉西部原野是山地原野，也可以从那里进入^ff0000普隆德拉下水道^000000。";
		mes "那里有^ff0000大黄蜂^000000，初心者冒险者要小心！";
		next;
		callsub( S_Zone );
		warp "prt_fild05",276,241;
		end;
	case 2:
		mes "[Kafra Employee]";
		mes "普隆德拉原野：";
		mes "普隆德拉西南原野是^ff0000摇滚蝗虫^000000居住的地方。";
		next;
		callsub( S_Zone );
		warp "prt_fild07",250,257;
		end;
	case 3:
		mes "[Kafra Employee]";
		mes "普隆德拉原野：";
		mes "普隆德拉湖畔原野是^ff0000琥珀虫^000000居住的地方。";
		next;
		callsub( S_Zone );
		warp "prt_fild04",204,109;
		end;
	case 4:
		mes "[Kafra Employee]";
		mes "弓箭手村：";
		mes "斐扬洞窟很可怕，里面有许多^ff0000僵尸^000000和^ff0000骷髅^000000。";
		next;
		callsub( S_Zone );
		warp "pay_arche",69,130;
		end;
	case 5:
		mes "[Kafra Employee]";
		mes "苏格拉特沙漠：";
		mes "这里位于普隆德拉西南和伊兹鲁德西南，遍布^ff0000穆卡^000000和^ff0000大嘴鸟^000000。";
		next;
		callsub( S_Zone );
		warp "moc_fild01",232,250;
		end;
	case 6:
		callfunc( "F_KafEnd",0,0 );
	}
S_Zone:
	switch( select( "我想去。", "我想留下。" ) ) {
	case 1:
		return;
	case 2:
		mes "[Kafra Employee]";
		mes "想看看我们的其他服务吗？";
		close3;
	}	
}


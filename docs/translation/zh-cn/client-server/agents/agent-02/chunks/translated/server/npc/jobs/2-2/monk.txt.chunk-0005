job_monk,225,180,1	script	Hyunmoo#mk	89,{
	if ((countitem(1069) > 0 || countitem(1070) > 0) && countitem(1069) < 30 && countitem(1070) < 30) {
		mes "[玄武]";
		mes "你带来的蘑菇不够……再去找一些。";
		next;
		mes "[玄武]";
		mes "还是说你想放弃……你要放弃吗？";
		next;
		switch(select("不。:是。") == 1) {
			mes "[玄武]";
			mes "那就行动起来！";
			close;
		}
		mes "[玄武]";
		mes "……我就猜到了……你没有修行精神。";
		mapannounce "job_monk","" + strcharinfo(0) + "放弃了修道士测试。",bc_map;
		close2;
		set MONK_Q,16;
		changequest 3027,3028;
		warp "prt_monk",194,168;
		end;
	}
	else if (MONK_Q > 14 && MONK_Q < 25 && (countitem(1069) == 0 || countitem(1070)  == 0)) {
		mes "[玄武]";
		mes "很高兴见到你。我叫玄武，负责蘑菇测试。";
		next;
		mes "[玄武]";
		mes "你的任务是收集蘑菇。";
		mes "明白了吗？";
		next;
		mes "[玄武]";
		mes "采摘蘑菇是为了训练你的耐性。";
		mes "我们种植菜园，既是为了生存，也是为了磨炼心智。";
		next;
		mes "[玄武]";
		mes "我相信，没有什么比融入自然更能找到真正的内心平静。";
		mes "所以我们建了菜园，可这些蘑菇却开始到处冒出来！";
		next;
		mes "[玄武]";
		mes "作为训练的一部分，我们要求你清除这些蘑菇。";
		mes "去帮助其他人尽可能多地清除蘑菇，再带回足够的";
		mes "^FF0000橙色网状蘑菇^000000和^FF0000橙色黏稠蘑菇^000000作为证明。";
		next;
		mes "[玄武]";
		mes "现在，去找些蘑菇吧。";
		mes "采摘一些后回来找我，我会告诉你是否足够。";
		mes "记住，在园艺中寻找平静。";
		next;
		mes "[玄武]";
		mes "……还是说你想放弃？";
		next;
		if (select("不。:是。") == 1) {
			mes "[玄武]";
			mes "那就继续吧。";
			close;
		}
		mes "[玄武]";
		mes "……果然如此……你没有成为修道士所需的精神。";
		mapannounce "job_monk","" + strcharinfo(0) + "放弃了修道士测试。",bc_map;
		delitem 1069,countitem(1069); //Mushroom_Of_Thief_1
		delitem 1070,countitem(1070); //Mushroom_Of_Thief_2
		close2;
		mapannounce "job_monk","" + strcharinfo(0) + "放弃了修道士训练。",bc_map;
		warp "prt_monk",194,168;
		set MONK_Q,16;
		changequest 3027,3028;
		end;
	}
	else if (MONK_Q > 14 && MONK_Q < 25 && (countitem(1069) > 29 || countitem(1070) > 29)) {
		mes "[玄武]";
		mes "……嗯……还不错。";
		mes "好，你通过了。";
		next;
		mes "[玄武]";
		mes "去见图门，接受下一项测试。";
		mes "图门住在这座修道院附近一栋建筑最深处的房间里。";
		set MONK_Q,25;
		changequest 3027,3029;
		delitem 1069,countitem(1069); //Mushroom_Of_Thief_1
		delitem 1070,countitem(1070); //Mushroom_Of_Thief_2
		close2;
		warp "prt_monk",194,168;
		end;
	}
	else if (MONK_Q > 24) {
		mes "[玄武]";
		mes "我不是叫你去见^FF0000图门^000000吗？还是你想再采些蘑菇？";
		mes "图门住在这座修道院附近一栋建筑最深处的房间里。";
		close;
	}
}

prt_monk,225,180,1	script	Hyunmoo#mk2	89,{
	if (MONK_Q < 25) {
		mes "[玄武]";
		mes "看着蔬菜成长，我也感到自己在内心成长。";
		next;
		mes "[玄武]";
		mes "看着其他修道士辛勤种植蔬菜，";
		mes "看到他们像我一样享受园艺，我感到很温暖。";
		next;
		mes "[玄武]";
		mes "说实话，我觉得园艺是世上最棒的事……";
		mes "我们应该感谢那些辛勤为我们准备食物的同伴。";
		next;
		mes "[玄武]";
		mes "经过时别忘了感谢他们的辛劳。";
		close;
	}
	else if (MONK_Q > 24 && BaseJob == Job_Acolyte) {
		mes "[玄武]";
		mes "我不是叫你去见图门吗？还是你想再采些蘑菇？";
		mes "图门住在这座修道院附近一栋建筑最深处的房间里。";
		close;
	}
	else {
		mes "[玄武]";
		mes "看着蔬菜成长，我也感到自己在内心成长。";
		next;
		mes "[玄武]";
		mes "看着其他修道士辛勤种植蔬菜，";
		mes "看到他们像我一样享受园艺，我感到很温暖。";
		next;
		mes "[玄武]";
		mes "说实话，我觉得园艺是世上最棒的事……";
		mes "我们应该感谢那些辛勤为我们准备食物的同伴。";
		next;
		mes "[玄武]";
		mes "经过时别忘了感谢他们的辛劳。";
		close;
	}
}

monk_test,319,139,1	script	Tomoon#mk	52,{
	if (MONK_Q == 25) {
		mes "[图门]";
		mes "欢迎你，年轻人。";
		mes "我叫图门，负责精神训练的最后一项测试！";
		next;
		mes "[图门]";
		mes "现在你不需要更多指导了：";
		mes "^990000消灭挡在你路上的一切活物！^000000就是这样！";
		next;
		mes "[图门]";
		mes "在迷宫中游荡时，遇到任何邪恶生物就杀掉它们！解放它们受折磨的灵魂！！";
		next;
		mes "[图门]";
		mes "别把我们和软弱的牧师相提并论！我们是修道士，永远都是最强的！！";
		next;
		mes "[图门]";
		mes "我们不像牧师那样躲在他人的力量后面瑟瑟发抖！";
		next;
		mes "[图门]";
		mes "现在，集中精神！！握紧拳头、睁大眼睛！是时候让我看看你的本事了。";
		next;
		mes "[图门]";
		mes "让我看看你是否具备成为真正修道士的资格！！";
		close2;
		set MONK_Q,26;
		changequest 3029,3031;
		warp "monk_test",88,74;
		end;
	}
	else if (MONK_Q == 26) {
		mes "[图门]";
		mes "嗯……你失败了？";
		mes "振作起来！失败只是通往成功的过程！";
		mes "去吧！重新开始！把它们全都杀掉！！";
		close2;
		warp "monk_test",88,74;
		end;
	}
	else if (MONK_Q == 27) {
		mes "[图门]";
		mes "干得漂亮！！";
		mes "我就知道你能通过！";
		mes "现在……我会给你一瓶能让体力加倍的秘药。";
		next;
		getitem 506,1; //Green_Potion
		mes "喝下这瓶药，你就能成为修道士了！！！";
		mes "……现在回去找师范穆海！！！";
		set MONK_Q,28;
		changequest 3031,3032;
		close;
	}
	else if (MONK_Q == 28) {
		mes "[图门]";
		mes "我已经告诉过你了，回去找师范穆海！！！";
		close;
	}
	else {
		mes "[图门]";
		mes "……安静。";
		mes "……";
		next;
		mes "[图门]";
		mes "我不允许任何人在这座修道院里惹麻烦。";
		next;
		mes "[图门]";
		mes "你最好别想着惹什么麻烦。";
		close;
	}
}

monk_test,82,85,1	script	Proctor#mk	95,{
	mes "[考官]";
	mes "那么，你准备好接受精神训练了吗？";
	next;
	switch(select("是！:否。:我该做什么？")) {
	case 1:
		mes "[考官]";
		mes "好！祝你好运。如果迷路找不到出口，只要登出再重新登录即可。";
		mes "这样你会回到保存点。什么意思？我也不知道，我只是被要求这么说。对了，请和同伴合作。";
		close2;
		set MONK_Q,26;
		warp "monk_test",125,277;
		end;
	case 2:
		mes "[考官]";
		mes "我明白了。慢慢来。";
		close;
	case 3:
		mes "[考官]";
		mes "这座测试大厅里有一座灵魂迷宫。";
		mes "里面的灵魂会阻碍你自由移动。";
		next;
		mes "[考官]";
		mes "如果想离开测试大厅，你必须前往位于起点对面的传送门。";
		next;
		mes "[考官]";
		mes "……对了，迷宫里还有怪物游荡，请把它们清除。";
		mes "祝你好运。";
		close;
	}
}


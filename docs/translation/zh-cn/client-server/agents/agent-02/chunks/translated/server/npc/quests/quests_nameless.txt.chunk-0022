		}
		else {
			mes "[Shaman]";
			mes "你没带翡翠吗？希望你没把它弄丢。";
			close;
		}
	}
	else if (jewel_nd == 21) {
		mes "[Shaman]";
		mes "去吉芬镇向西走，寻找桥另一边的高地。也就是从吉芬西门出去，找一处高地。";
		next;
		mes "[Shaman]";
		mes "相信我。你会在那里找到能回应翡翠力量的东西。别忘了带上翡翠！";
		close;
	}
	else if ((jewel_nd == 22) || (jewel_nd == 23)) {
		mes "[Shaman]";
		mes "我怎么说的？那颗宝石会带来厄运。不过我不明白里面的战士灵魂为什么不肯和我说话。怎么回事？";
		close;
	}
	else {
		mes "[Shaman]";
		mes "我已经很久没做这些仪式了。感觉精神力彻底耗尽。";
		close;
	}
}

yuno_in04,38,48,3	script	Archeologist	55,{
	if (jewel_nd < 18) {
		mes "[Archeologist]";
		mes "事情太多了！这些研究要怎么处理？别慌，别慌，一件一件来！";
		close;
	}
	else if (jewel_nd == 18) {
		mes "[Archeologist]";
		mes "哦，我从科莫多的古董鉴定师那里听说过你……你就是挖出不幸翡翠的人，对吧？让我看看可以吗？";
		next;
		if (countitem(7725) > 0) {
			mes "[Archeologist]";
			mes "啊，难怪这么多人想要它。这块翡翠真大……真漂亮！那么……你是需要我帮忙吗？";
			next;
			switch(select("询问宝石诅咒:炫耀宝石")) {
			case 1:
				emotion ET_SMILE;
				mes "[Archeologist]";
				mes "宝石的诅咒？哈！你相信那种老迷信？哦，你是想解除宝石诅咒？哼哼，哈哈！你还没死，对吧？";
				next;
				mes "[Archeologist]";
				mes "全是胡说！持有这颗宝石时只有一个人死了，就是科莫多那个用它偿还赌债的赌徒。";
				next;
				mes "[Archeologist]";
				mes "这颗宝石只是失踪了很久，最近重新出现，仅此而已。像这样贵重的宝石总会伴随许多神话传说。";
				next;
				mes "[Archeologist]";
				mes "总之，它没有诅咒。你爱信什么就信什么，但根据我的研究，这是我的专业意见。";
				set jewel_nd,19;
				close;
			case 2:
				mes "[Archeologist]";
				mes "哇……那颗宝石真大……";
				close;
			}
		}
		else {
			mes "[Archeologist]";
			mes "你把宝石弄丢了？也许不全是坏事。历史表明，许多人突然获得巨额财富后反而毁了自己。";
			close;
		}
	}
	else if (jewel_nd == 22) {
		mes "[Archeologist]";
		mes "战士的怨魂在生者世界中游荡？我不太愿意相信你说的。";
		next;
		mes "[Archeologist]";
		mes "我个人觉得那个老萨满是骗子，不过……你可以自由决定相信什么。但别让它困扰你。";
		close;
	}
	else if (jewel_nd == 23) {
		mes "[Archeologist]";
		mes "你又在说鬼魂？好吧，为了讨论，就假设宝石里真的有某位阵亡战士的灵魂。";
		next;
		mes "[Archeologist]";
		mes "欠下巨债的人自杀，或战士在与狗头人战斗时阵亡，都不难理解。不过……我会尽量调查。";
		next;
		mes "[Archeologist]";
		mes "这让我想起……我有一支在吉芬西边原野遇难的冒险队记录，就是你提到的那支。让我找找。";
		set jewel_nd,24;
		close;
	}
	else if (jewel_nd == 24) {
		mes "[Archeologist]";
		mes "啊，你回来了！我找到之前说的记录了。这是目击者对那群人在吉芬西边遇难经过的记述。";
		next;
		mes "[Archeologist]";
		mes "有趣的是，根据这人的记录，你一直说的那个战士根本不是被狗头人杀死的。让我看看……啊，在这里。";
		next;
		mes "[Archeologist]";
		mes "''^666666当首领和士兵赶到时，战斗已经结束。尸体遍地，但有一名浑身是血的战士，半昏迷却还活着。^000000''";
		next;
		mes "[Archeologist]";
		mes "很奇怪，对吧？这是现在住在普隆德拉的一名退伍士兵写的日志。也许你可以去和他谈谈。";
		set jewel_nd,25;
		close;
	}
	else if (jewel_nd == 25) {
		mes "[Archeologist]";
		mes "有一名退伍士兵亲眼目睹了吉芬西边原野发生的事。你应该去普隆德拉找他，看看能了解到什么。";
		close;
	}
	else if (jewel_nd > 28) {
		mes "[Archeologist]";
		mes "啊，那真是……太深刻了。那名战士意识到自己太弱、无法保护同伴后发狂了吗？他完全失去了控制……";
		next;
		mes "[Archeologist]";
		mes "我最好去和那位老士兵谈谈，把完整故事记录下来。这会是所有剑士的历史教训。谢谢你告诉我。";
		close;
	}
	else {
		mes "[Archeologist]";
		mes "我太忙了！听着，等我没那么忙时再回来好吗？";
		close;
	}
}

prontera,140,304,5	script	Old Soldier	901,{
	if (checkweight(907,200) == 0) {
		mes "[Retired Soldier]";
		mes "你为什么带这么多东西？难道没有卡普拉仓库存放杂物吗？";
		close;
	}
	if (jewel_nd == 25) {
		mes "[Retired Soldier]";
		mes "奇怪，不知为何这么多人想和我说话，不过我承认这感觉还不错。";
		next;
		switch(select("询问过去的战斗:询问阵亡战士")) {
		case 1:
			mes "[Retired Soldier]";
			mes "别让我开始。一谈起过去我能说一整晚。那段日子很艰难，但也是值得回忆的美好记忆……";
			close;
		case 2:
			mes "[Retired Soldier]";
			mes "阵亡战士……？只有一个人让我每次想起都脊背发凉。他出事时和你差不多大……";
			next;
			mes "[Retired Soldier]";
			mes "我们收到狗头人威胁的报告，于是被派往吉芬西边原野。但我们到达时战斗已经结束，来得太晚了。";
			next;
			mes "[Retired Soldier]";
			mes "所有狗头人都被杀了，但……还有一名浑身是血的战士。他看到我们后就开始攻击所有人！他彻底失控了。";
			next;
			mes "[Retired Soldier]";
			mes "我们别无选择，只能杀了他。这是自卫，但我仍忍不住同情他。他的同伴全死了，我无法想象那是什么感受。";
			next;
			mes "[Retired Soldier]";
			mes "我们来得太晚，没看到那场战斗，但我确定它很惨烈。你一定很想了解这名士兵。";
			next;
			mes "[Retired Soldier]";
			mes "我很高兴你能了解更多。我们可以从他人的经历中学到很多。";
			set jewel_nd,26;
			close;
		}
	}
	else if ((jewel_nd > 25) && (jewel_nd < 29)) {
		mes "[Retired Soldier]";
		mes "我不后悔杀了那名战士。那时候我们别无选择。";
		close;
	}
	else if (jewel_nd == 29) {
		mes "[Retired Soldier]";
		mes "哦，又是你。想再问问那名战士吗？恐怕我已经把知道的一切都告诉你了。";
		next;
		switch(select("抱歉……:我遇到了战士的灵魂。")) {
		case 1:
			mes "[Retired Soldier]";
			mes "没关系。";
			close;
		case 2:
			mes "[Retired Soldier]";
			mes "什么？怎么可能？";
			next;
			mes "^3355FF你向退伍士兵解释了迄今发生的一切。^000000";
			next;
			mes "[Retired Soldier]";
			mes "真是个故事。不过我很惊讶他不愿和你谈发生的事。我想他仍对那天怀有怨恨……";
			next;
			mes "[Retired Soldier]";
			mes "我想现在已经不重要了。把这一切当作很好的学习经历吧。";
			next;
			switch(select("我真为他感到难过。:你相信宝石真的被诅咒吗？")) {
			case 1:
				mes "[Retired Soldier]";
				mes "嗯……我不知道该怎么说。我的意思是，你确实无法……";
				mes "他没有责怪任何人，只是失去了理智……";
				close;
			case 2:
				mes "[Retired Soldier]";
				mes "我不确定宝石是否被诅咒、诅咒是否由战士引发，或者宝石根本没有诅咒。我只是个年迈而普通的士兵。";
				next;
				mes "[Retired Soldier]";
				mes "有一点确定：如果真的有诅咒，只要意志足够坚定，那名士兵就该能克服它。这样说很残酷，但是……";
				next;
				mes "[Retired Soldier]";
				mes "真正的战士有忍耐、抵抗诱惑、保持专注的力量。那家伙……不适合战斗。";
				set jewel_nd,30;
				next;
				if (countitem(7725) > 0) {
					mes "[Retired Soldier]";
					mes "这样吧？如果你担心诅咒，为什么不把宝石留给我？别担心，我会补偿你的。";
					next;
					mes "[Retired Soldier]";
					mes "我宁愿自己留着，也不想冒险让它影响别人。我的意志足够坚定，可以抵抗诅咒——如果它真的存在的话。";
					delitem 7725,1; //Unlucky_Emerald
					set jewel_nd,31;
					getitem 603,1; //Old_Blue_Box
					if (checkre(3)) {
						if (BaseLevel < 66) getitem 607,1; //Yggdrasilberry
						else if ((BaseLevel > 65) && (BaseLevel < 75)) getexp 5000,0;
						else if ((BaseLevel > 74) && (BaseLevel < 81)) getexp 18000,0;
						else if ((BaseLevel > 80) && (BaseLevel < 86)) getexp 36000,0;
						else if ((BaseLevel > 85) && (BaseLevel < 91)) getexp 50000,0;
						else if ((BaseLevel > 90) && (BaseLevel < 96)) getexp 80000,0;
						else if ((BaseLevel > 95) && (BaseLevel < MAX_LEVEL)) getexp 100000,0;
						else getitem 617,1; //Old_Violet_Box
					} else {
						if (BaseLevel < 66) getitem 607,1; //Yggdrasilberry
						else if ((BaseLevel > 65) && (BaseLevel < 75)) getexp 50000,0;
						else if ((BaseLevel > 74) && (BaseLevel < 81)) getexp 180000,0;
						else if ((BaseLevel > 80) && (BaseLevel < 86)) getexp 360000,0;
						else if ((BaseLevel > 85) && (BaseLevel < 91)) getexp 500000,0;
						else if ((BaseLevel > 90) && (BaseLevel < 96)) getexp 800000,0;
						else if ((BaseLevel > 95) && (BaseLevel < 99)) getexp 1000000,0;
						else getitem 617,1; //Old_Violet_Box
					}
					next;
					mes "[Retired Soldier]";
					mes "如果你从这一切中学到什么，那就是永远不要屈服于绝望。愤怒什么也带不来，它的力量只是幻觉。";
					close;
				}
				else {
					mes "[Retired Soldier]";
					mes "这样吧？如果你担心诅咒，为什么不把宝石留给我？别担心，我会补偿你的。";
					next;
					mes "[Retired Soldier]";
					mes "我宁愿自己留着，也不想冒险让它影响别人。我的意志足够坚定，可以抵抗诅咒——如果它真的存在的话。";
					close;
				}
			}
		}
	}
	else if (jewel_nd == 30) {
		if (countitem(7725) > 0) {
			delitem 7725,1; //Unlucky_Emerald
			set jewel_nd,31;
			getitem 603,1; //Old_Blue_Box
			if (checkre(3)) {
				if (BaseLevel < 66) getitem 607,1; //Yggdrasilberry
				else if ((BaseLevel > 65) && (BaseLevel < 75)) getexp 5000,0;
				else if ((BaseLevel > 74) && (BaseLevel < 81)) getexp 8000,0;
				else if ((BaseLevel > 80) && (BaseLevel < 86)) getexp 15000,0;
				else if ((BaseLevel > 85) && (BaseLevel < 91)) getexp 20000,0;
				else if ((BaseLevel > 90) && (BaseLevel < 96)) getexp 40000,0;
				else if ((BaseLevel > 95) && (BaseLevel < MAX_LEVEL)) getexp 50000,0;
				else getitem 617,1; //Old_Violet_Box
			} else {
				if (BaseLevel < 66) getitem 607,1; //Yggdrasilberry
				else if ((BaseLevel > 65) && (BaseLevel < 75)) getexp 50000,0;
				else if ((BaseLevel > 74) && (BaseLevel < 81)) getexp 80000,0;
				else if ((BaseLevel > 80) && (BaseLevel < 86)) getexp 150000,0;
				else if ((BaseLevel > 85) && (BaseLevel < 91)) getexp 200000,0;
				else if ((BaseLevel > 90) && (BaseLevel < 96)) getexp 400000,0;
				else if ((BaseLevel > 95) && (BaseLevel < 99)) getexp 500000,0;
				else getitem 617,1; //Old_Violet_Box
			}
			next;
			mes "[Retired Soldier]";
			mes "如果你从这一切中学到什么，那就是永远不要屈服于绝望。";

ma_dun01,35,108,4	script	Nurse#ma_n2	569,{
	if (malaya_bang < 19) {
		// fall through
	} else if (malaya_bang < 30) {
		if (malaya_bang == 19) {
			mes "医院里到处都是怪物，就像老太太说的那样。";
			mes "她的脚那样，怎么可能在一楼和二楼之间来回……";
			next;
			set malaya_bang,20;
			changequest 11300,11301;
		}
		mes "[护士拉斯]";
		mes "你能再检查一下二楼的门吗？也许我漏掉了什么。";
		cutin "malaya_nurseA01",2;
		next;
		switch(select("去外面。：退出。")) {
		case 1:
			close2;
			cutin "",255;
			warp "malaya",58,76;
			end;
		case 2:
			mes "[护士拉斯]";
			mes "啧……";
			close2;
			cutin "",255;
			end;
		}
	} else {
		callfunc "F_Malaya_Nurse",2;
		end;
	}
	mes "[护士]";
	mes "我想一个人待着。";
	mes "请离开。";
	close2;
	warp "malaya",58,76;
	end;
}


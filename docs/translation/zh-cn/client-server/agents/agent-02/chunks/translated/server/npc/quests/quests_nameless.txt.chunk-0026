		else {
			mes "[Agent]";
		mes "你没有吗？你没把酒精喝掉吧？";
			close;
		}
	}
	else if (rumour_nd == 14) {
		mes "[Agent]";
		mes "嗯，我制作解毒剂时犯了错……应该用 Detrimindexta，而不是 Karvodailnirol 来制作解毒剂。";
		next;
		mes "[Agent]";
		mes "抱歉，它们在我看来长得一样。而且字母表里的字母也都一样。你介意再试一次吗？只需再来 1 份酒精……";
		next;
		mes "[Agent]";
		mes "嘿，我保证！这次不会搞砸。我们一定能做到~";

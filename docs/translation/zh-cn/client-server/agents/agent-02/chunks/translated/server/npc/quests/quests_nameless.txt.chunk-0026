		close;
	}
}

comodo,233,199,5	script	Rogue Guild Agent#nd3	810,{
	if (checkweight(907,200) == 0) {
		mes "[Agent]";
		mes "你带的东西太多了。先把一些存进卡普拉仓库再和我说话，好吗？";
		close;
	}
	if (rumour_nd < 1) {
		mes "[Agent]";
		mes "......";
		mes "......";
		close;
	}
	else if ((rumour_nd > 0) && (rumour_nd < 16)) {
		if (zdan_edq > 12) {
			mes "[Agent]";
			mes "你就是帮助击败 Z 帮的人？嘿！干得好~";
			close;
		}
		else {
			mes "[Agent]";
			mes "你是谁？嗯。";
			close;
		}
	}
	else if ((rumour_nd == 16) || (rumour_nd == 18)) {
		mes "[Agent]";
		mes "你知道，流氓狡猾又难抓，所以我要教你自律。明白吗？纪律！你需要它！";
		next;
		mes "[Agent]";
		mes "从现在起，听到我的指示就大声喊‘是，长官！’。明白了吗！响亮清楚！";
		next;
		switch(select("是，长官！:……")) {
		case 1:
			emotion ET_THINK;
			mes "[Agent]";
			mes "很好，很好。嗯，再试一次……让我听到你更大声地说！";
			next;
			select("是，长官！");
			mes "[Agent]";
			mes "不错！";
			next;
			mes "[Agent]";
			mes "好，现在是训练指示……据说有怪物入侵村子，但我确定只是有人想吓唬大众。";
			next;
			mes "[Agent]";
			mes "我很确定，呃，罪犯戴着面具冒充怪物。也就是说……你的任务是带一些怪物面具给我。";
			next;
			mes "[Agent]";
			mes "嘿嘿……你的任务是什么？！";
			next;
			select("带来怪物面具！");
			mes "[Agent]";
			mes "很好。";
			next;
			mes "[Agent]";
			mes "好，带给我^FF00002 个吓人的怪物面具^000000。只要 2 个，确保它们够吓人。";
			set rumour_nd,19;
			close;
		case 2:
			mes "[Agent]";
			mes "你以为自己在做什么？你这样反抗让我很生气。这样怎么能成为优秀的流氓？！";
			close;
		}
	}
	else if (rumour_nd == 19) {
		mes "[Agent]";
		mes "所以……你像个乖士兵一样带来面具了？";
		next;
		switch(select("嗯。:是，长官！")) {
		case 1:
			mes "[Agent]";
			mes "嘿，记得我们的小规矩吗？我说‘士兵’时已经提醒你了。嘿~";
			close;
		case 2:
			mes "[Agent]";
			mes "好，让我检查一下。";
			next;
			if ((countitem(2278) > 0) || (countitem(2281) > 0) || (countitem(5043) > 0) || (countitem(2288) > 0) || 
			(countitem(2292) > 0) || (countitem(2297) > 0) || (countitem(5005) > 0) || (countitem(5086) > 0) || 
			(countitem(5087) > 0) || (countitem(5088) > 0) || (countitem(5089) > 0) || (countitem(5090) > 0) || 
			(countitem(5176) > 0) || (countitem(5203) > 0) || (countitem(5098) > 0) || (countitem(5121) > 0) || 
			(countitem(5130) > 0) || (countitem(5177) > 0) || (countitem(5169) > 0) || (countitem(5143) > 0)) {
				mes "[Agent]";
				mes "太好了！";
				next;
				mes "[Agent]";
				mes "听着，我知道之前为难了你。别担心，我不会拿走面具。我只是想训练你成为最优秀的流氓。明白吗？";
				next;
				mes "[Agent]";
				mes "咦？你手里一直拿着的是什么便条？";
				next;
				mes "[Agent]";
				mes "嗯……嗯哼……嗯……哦！";
				next;
				mes "[Agent]";
				mes "啊，糟糕！你怎么不早说？我以为你是来参加流氓转职考试的！";
				emotion ET_HUK;
				next;
				emotion ET_SORRY;
				mes "[Agent]";
				mes "啊，伙计，你大老远来帮我，我却以为……真的很抱歉！我把你和等候的训练生搞混了……";
				next;
				mes "[Agent]";
				mes "帮我个忙，别告诉别人，好吗？把这当作……嗯，流氓世界的内部见闻吧。";
				emotion ET_CRY;
				next;
					switch(select("是，长官！:我不会告诉别人。")) {
				case 1:
					mes "[Agent]";
						mes "哇！哇！你可以停下了。";
					mes "谢谢，我真的很感激。";
					next;
					break;
				case 2:
					mes "[Agent]";
					mes "谢谢。我就知道不知为何可以信任你！";
					next;
					break;
				}
				mes "[Agent]";
				mes "总之，你还要去最后一个地方：摩洛克。去和那里的流氓探员报到，好吗？还有，带上这些食物，就当我的赔礼。";
				set .@sorry_item,rand(1,6);
				if (.@sorry_item == 1) {
					getitem 12044,1; //Str_Dish04
				}
				else if (.@sorry_item == 2) {
					getitem 12059,1; //Agi_Dish04
				}
				else if (.@sorry_item == 3) {
					getitem 12064,1; //Dex_Dish04
				}
				else if (.@sorry_item == 4) {
					getitem 12049,1; //Int_Dish04
				}
				else if (.@sorry_item == 5) {
					getitem 12054,1; //Vit_Dish04
				}
				else if (.@sorry_item == 6) {
					getitem 12069,1; //Luk_Dish04
				}
				else {
					mes "[Agent]";
					mes "等等，好像不太对。你稍后再回来好吗？";
					close;
				}
				next;
				mes "[Agent]";
				mes "去摩洛克路上小心，好吗？祝你找到那里的流氓探员。还有，别把我的小失误说出去~";
				set rumour_nd,20;
				close;
			}
			else {
				mes "[Agent]";
				mes "嘿，你到底有没有带面具？回去把它们找来！";
				close;
			}
		}
	}
	else if (rumour_nd == 20) {
		mes "[Agent]";
		mes "哦，嘿，你回来了？你不是已经去摩洛克了吗？";
		close;
	}
	else if (rumour_nd == 22) {
		mes "[Agent]";
		mes "嘿嘿，看来我们破案了~";
		next;
		if (zdan_edq > 12) {
			mes "[Agent]";
			mes "多亏了你，我们不用再担心那个讨厌的 Z 帮了。";
			close;
		}
		else {
			mes "[Agent]";
			mes "在世界摆脱邪恶之前，流氓们总有工作要做。";
			close;
		}
	}
	else {
		mes "[Agent]";
		mes "你怎么还在这里？没有更重要的事要做吗？";
		close;
	}
}

morocc,116,39,3	script	Rogue Guild Agent#nd4	779,{
	if (rumour_nd == 1) {
		mes "[Agent]";
		mes "案件？你在说什么……？去问别人。我听不懂你说的。别烦我，让我放松~";
		close;

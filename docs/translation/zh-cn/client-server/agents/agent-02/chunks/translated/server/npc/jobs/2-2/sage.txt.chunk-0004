			mes "……大陆四周有一片海洋，";
			mes "海洋被";
			switch(select("一棵巨大的梣树。:一条巨大的耶梦加得蛇。:一只巨大的乌龟和大象。:一条巨龙。")) {
			case 1:
				set .@w_point,.@w_point+1;
				mes "一棵巨大的梣树。";
				break;
			case 2:
				mes "一条巨大的耶梦加得蛇。";
				break;
			case 3:
				set .@w_point,.@w_point+1;
				mes "一只巨大的乌龟和大象。";
				break;
			case 4:
				set .@w_point,.@w_point+1;
				mes "一条巨龙。";
				break;
			}
			mes "大陆由以下三个地方组成：";
			switch(select("蜘蛛栖息的妙勒尼尔山：:泰坦栖息的乌拉诺斯：:泰坦栖息的乌特加德：:冬季之地卢蒂耶，")) {
			case 1:
				set .@w_point,.@w_point+1;
				mes "蜘蛛栖息的妙勒尼尔山，";
				break;
			case 2:
				set .@w_point,.@w_point+1;
				mes "泰坦栖息的乌拉诺斯，";
				break;
			case 3:
				mes "泰坦栖息的乌特加德，";
				break;
			case 4:
				set .@w_point,.@w_point+1;
				mes "冬季之地卢蒂耶，";
				break;
			}
			switch(select("人类栖息的米德加尔特：:人类栖息的卢恩·米德加兹：:人鱼栖息的特里托尼亚：:沙漠城市梦罗克，")) {
			case 1:
				mes "人类居住的米德加尔特，";
				break;
			case 2:
				set .@w_point,.@w_point+1;
				mes "人类居住的卢恩·米德加兹，";
				break;
			case 3:
				set .@w_point,.@w_point+1;
				mes "人鱼居住的特里托尼亚，";
				break;
			case 4:
				set .@w_point,.@w_point+1;
				mes "沙漠城市梦罗克，";
				break;
			}
			switch(select("神明栖息的阿布加德。:神明栖息的阿斯加德。:居民栖息的施瓦茨瓦尔德。:卢恩·米德加兹首都普隆德拉。")) {
			case 1:
				set .@w_point,.@w_point+1;
				mes "神明栖息的阿布加德。";
				break;
			case 2:
				mes "神明栖息的阿斯加德。";
				break;
			case 3:
				set .@w_point,.@w_point+1;
				mes "居民栖息的施瓦茨瓦尔德。";
				break;
			case 4:
				set .@w_point,.@w_point+1;
				mes "卢恩·米德加兹首都普隆德拉。";
				break;
			}
			mes "大陆由上述三个地方组成。";
			next;
			if (.@w_point > 0) {
				mes "[萨菲恩·莱利斯]";
				mes "……" + strcharinfo(0) + "，你疯了吗？";
				mes "你的成果太差，根本不能算论文！";
				next;
				mes "[萨菲恩·莱利斯]";
				mes "我不认为你能把成果提交给院长。";
				mes "再努力学习后重试吧！";
				close;
			}
			mes "……正如上节课所学，";
			mes "世界树是……";
			switch(select("一棵巨大的梣树。:一棵奇妙的玛斯黛拉树。:一棵巨大的柳树。:一根巨大的枯枝。")) {
			case 1:
				mes "一棵巨大的梣树。";
				break;
			case 2:
				set .@w_point,.@w_point+1;
				mes "一棵奇妙的玛斯黛拉树。";
				break;
			case 3:
				set .@w_point,.@w_point+1;
				mes "一棵巨大的柳树。";
				break;
			case 4:
				set .@w_point,.@w_point+1;
				mes "一根巨大的枯枝。";
				break;
			}
			mes "世界树的根分为三部分，分别延伸到三个地方……";
			switch(select("施瓦茨瓦尔德、约顿海姆、尼夫尔海姆。:米德加尔特、约顿海姆、纳弗海姆。:阿斯加德、约顿海姆、纳弗海姆。:阿斯加德、约顿海姆、尼夫尔海姆。")) {
			case 1:
				set .@w_point,.@w_point+1;
				mes "施瓦茨瓦尔德、约顿海姆、尼夫尔海姆。";
				break;
			case 2:
				set .@w_point,.@w_point+1;
				mes "米德加尔特、约顿海姆、纳弗海姆。";
				break;
			case 3:
				set .@w_point,.@w_point+1;
				mes "阿斯加德、约顿海姆、纳弗海姆。";
				break;
			case 4:
				mes "阿斯加德、约顿海姆、尼夫尔海姆。";
				break;
			}
			mes "拥有世界树种子的人，";
			switch(select("可以治愈所有异常状态。:可以一次恢复全部 HP 和 SP。:可以恢复总 HP 和 SP 的一半。:可以治愈沉默、诅咒和混乱。")) {
			case 1:
				set .@w_point,.@w_point+1;
				mes "可以治愈所有异常状态。";
				break;
			case 2:
				set .@w_point,.@w_point+1;
				mes "可以一次恢复全部 HP 和 SP。";
				break;
			case 3:
				mes "可以恢复总 HP 和 SP 的一半。";
				break;
			case 4:
				set .@w_point,.@w_point+1;
				mes "可以治愈沉默、诅咒和混乱。";
				break;
			}
			next;
			if (.@w_point > 0) {
				mes "[萨菲恩·莱利斯]";
				mes "……" + strcharinfo(0) + "，你疯了吗？";
				mes "你的成果太差，根本不能算论文！";
				next;
				mes "[萨菲恩·莱利斯]";
				mes "我不认为你能把成果提交给院长。";
				mes "再努力学习后重试吧！";
				close;
			}
			mes "..........";
			next;
			mes "....................";
			next;
			mes ".................................";
			next;
			set SAGE_Q,15;
			changequest 2051,2052;
			mes "[萨菲恩·莱利斯]";
			mes "哦，你已经完成了吗？做得好。";
			mes "请小心保管，因为你再也不能重新进行这项任务了。";
			getitem 1550,1; //Book
			next;
			mes "[萨菲恩·莱利斯]";
			mes "我想你已经准备好把成果提交给院长了。";
			mes "是否通过测试由他决定。";
			close;
		}
		else {
			mes "我不确定你是否准备好写论文。";
			mes "恐怕我已经告诉过你需要什么了。";
			next;
			mes "[萨菲恩·莱利斯]";
			mes "^3355FF1 根鸟羽毛^000000，用作笔，";
			mes "^3355FF1 动物皮^000000，用作纸，";
			mes "^3355FF1 树干^000000，用来装订书籍，";
			mes "^3355FF1 乌贼墨汁^000000，用作墨水，";
			mes "^3355FF1 空瓶^000000，用来盛放乌贼墨汁。";
			next;
			mes "[萨菲恩·莱利斯]";
			mes "我会协助你写论文。";
			mes "请把这些物品全部带来。";
			close;
		}
	}
	else if (SAGE_Q == 15) {
		mes "嗯？你不是应该去找院长吗？";
		mes "论文写完后，请把它带给院长。";
		next;
		mes "[萨菲恩·莱利斯]";
		mes "成为贤者前，你只有一次写论文的机会。";
		mes "所以请继续前进。";
		close;
	}
	else {
		mes "我不确定你找我有什么事，请稍后再来。";
		mes "我还有些问题要思考……";
		close;
	}
}

yuno_in03,32,102,1	script	Biology Professor#sa	755,{
	mes "[Lucius Celsus]";
	if (BaseJob != Job_Mage) {
		if (BaseJob == Job_Sage) {
			mes "你找我有什么事？";
			mes "有问题的话必须提前一周预约。";
			next;
			mes "[Lucius Celsus]";
			mes "你不知道我有多忙吗……？";
			mes "如果你是贤者，现在应该已经听说过我了。";
			next;
			mes "[Lucius Celsus]";
			mes "你时间太多了。去探索些地下城吧。";
			mes "那比把时间浪费在我身上更有帮助。";
		}
		else if (BaseJob == Job_Novice) {
			mes "小鬼，你来找我有什么事？";
			next;
			mes "[Lucius Celsus]";
			mes "你最好出去和伙伴玩。";
			mes "这里不是让你胡闹的地方。";
		}
		else {
			mes "嗯？你来找我有什么事？对观看怪物感兴趣吗？";
			next;
			mes "[Lucius Celsus]";
			mes "你可以观看，但别制造骚乱打扰它们。";
			mes "也别伸手，有些家伙危险得不能触碰。";
			next;
			mes "[Lucius Celsus]";
			mes "顺便说，如果以后捕获稀有怪物，记得告诉我。";
			mes "我愿意不惜代价购买。";
		}
		close;
	}
	if (SAGE_Q == 11) {
		if (SAGE_Q2 == 0) {
			mes "欢迎来到我的课堂，实战考试成绩不错吗？";
			mes "我叫卢修斯·塞尔苏斯，是生物学专家。";
			next;
			mes "[Lucius Celsus]";
			mes "嗯……真没礼貌！我问候你后，你应该马上自我介绍！";
			mes "年轻人，你叫什么名字？";
			next;
			select(strcharinfo(0));
			mes "[Lucius Celsus]";
			mes "好名字。很高兴认识你。";
			mes "那么，你知道自己学习的科目吗？";
			next;
			mes "[Lucius Celsus]";
			mes "如你所知，你的研究主题是怪物。";
			mes "你和怪物战斗过多少次？";
			next;
			if (select("我都数不清了。:几次吧，我想……") == 1) {
				mes "[Lucius Celsus]";
				mes "闭嘴，小鬼。别太自以为是。";
				mes "即使你有丰富的怪物经验，也很难理解我的讲义。";
			}
			mes "[Lucius Celsus]";
			mes "没错，我就猜到你是这样。你只是书呆子。";
			mes "不过，我相信你会遇到讲义中提到的大多数怪物。";
			next;
			set sage_m4,rand(1,3);
			mes "[Lucius Celsus]";
			mes "我们开始吧。";
			mes "上课期间务必准备好实战考试。";
			next;
			if (sage_m4 == 1) {
				set SAGE_Q2,1;
				changequest 2048,2053;
				mes "[Lucius Celsus]";
				mes "把以下物品带给我。";
				mes "5 ^3355FFTentacle^000000,";
				mes "5 ^3355FFSingle Cell^000000,";
				mes "5 ^3355FFFish Tail^000000.";
			}
			else if (sage_m4 == 2) {
				set SAGE_Q2,2;
				changequest 2048,2054;
				mes "[Lucius Celsus]";
				mes "把以下物品带给我。";
				mes "5 ^3355FFNipper^000000,";
				mes "5 ^3355FFClam Flesh^000000,";
				mes "5 ^3355FFHeart of Mermaid^000000.";
			}
			else {
				set SAGE_Q2,3;
				changequest 2048,2054;
				mes "[Lucius Celsus]";
				mes "把以下物品带给我。";
				mes "5 ^3355FFTendon^000000,";
				mes "5 ^3355FFNipper^000000,";
				mes "5 ^3355FFSharp Scale^000000.";
			}
			next;
			mes "[Lucius Celsus]";
			mes "你把它们带来后我会继续上课。";
			mes "祝你愉快。";
			close;
		}
		else if (SAGE_Q2 >= 1 && SAGE_Q2 <=3) {
			switch(SAGE_Q2) {
			case 1: setarray .@items[0],962,1052,1023; break;
			//Nipper, Clam Flesh, Heart of Mermaid
			case 2: setarray .@items[0],960,966,950; break;
			//Tendon, Nipper, Sharp Scale
			case 3: setarray .@items[0],1050,960,963; break;
			}
			if (countitem(.@items[0]) > 4 && countitem(.@items[1]) > 4 && countitem(.@items[2]) > 4) {
				mes "你很努力地收集了这些物品。";
				mes "不过，我不确定你是自己收集的，还是从商店买来的……";
				next;
				mes "[Lucius Celsus]";
				mes "掉落这些物品的怪物似乎有共同点。";
				mes "你能告诉我相似之处是什么吗？";
				next;
				switch(select("它们拥有水属性。:它们是鱼。:它们很凶猛。:呃……它们是怪物。")) {
				case 1:
					mes "[Lucius Celsus]";
					mes "没错，它们拥有水属性，同时也是鱼。";
					mes "大多数鱼类怪物生活在水下，所以被赋予水属性。";
					break;
				case 2:
					mes "[Lucius Celsus]";
					mes "没错，它们拥有水属性，同时也是鱼。";
					mes "大多数鱼类怪物生活在水下，所以被赋予水属性。";
					break;
				case 3:
					set sage_m4,4;
					mes "[Lucius Celsus]";
					mes "……我不知道芬斯现在变得这么有攻击性？";
					mes "还是说玛丽娜和浮游虫联手来找你打架？";
					next;
					mes "[Lucius Celsus]";
					mes "掉落这些物品的怪物都不凶猛……清醒一点。";
					mes "它们都是鱼，并且拥有水属性。";
					break;
				case 4:
					set sage_m4,4;
					mes "[Lucius Celsus]";
					mes "什么……！你来这里做什么！？你是来研究特定怪物的，小脑畸形笨蛋！";
					mes "唉……它们都是鱼，并且拥有水属性。";
					break;
				}
				next;
				mes "[Lucius Celsus]";
				mes "并非所有鱼类怪物都有水属性，但大多数有。";
				mes "那么哪种魔法对大多数鱼类怪物最有效？";
				next;
				switch(select("雷击术。:火箭术。:雷暴术。:冰冻术。")) {
				case 1:
					mes "[Lucius Celsus]";
					mes "没错，拥有风属性的雷击术对水属性怪物最有效。";
					mes "不过要小心能察觉施法的怪物。";
					break;
				case 2:
					set sage_m4,4;
					mes "[Lucius Celsus]";
					mes "什么？火箭术！火怎么能战胜水，你这个蠢货！";
					mes "大多数鱼拥有水属性，所以弱于风属性魔法。你还不明白吗？";
					break;
				case 3:
					mes "[Lucius Celsus]";
					mes "嗯，雷暴术不错……它是风属性魔法。";
					mes "不过如果选错位置施法，你会陷入麻烦。";
					break;
				case 4:
					set sage_m4,4;
					mes "[Lucius Celsus]";
					mes "我无法理解这种愚蠢！题目要你选择克制水的属性！还不懂吗？";
					mes "按道理，拥有水属性的魔法不可能击败水属性怪物！";
					break;
				}
				next;
				mes "[Lucius Celsus]";
				mes "顺便说，虽然魔花笛妖或阿斯特等怪物被视为鱼类怪物，";
				mes "但它们的属性与其他怪物不同。最好小心应对。";
				next;
				mes "[Lucius Celsus]";
				mes "好，让我教你昆虫怪物的知识。";
				mes "让我想想……嗯……嗯……";
				next;
				switch(rand(1,4)) {
				case 1:
					set SAGE_Q2,4;
					if(checkquest(2053) != -1) {
						changequest 2053,2056;
					}
					else if(checkquest(2054) != -1) {
						changequest 2054,2056;
					}
					else {
						changequest 2055,2056;
					}
					mes "5 ^3355FFCobweb^000000,";
					mes "5 ^3355FFShell^000000,";
					mes "5 ^3355FFInsect Feeler^000000.";
					break;
				case 2:
					set SAGE_Q2,5;
					if(checkquest(2053) != -1) {
						changequest 2053,2057;
					}
					else if(checkquest(2054) != -1) {
						changequest 2054,2057;
					}
					else {
						changequest 2055,2057;
					}
					mes "5 ^3355FFHorn^000000,";
					mes "5 ^3355FFSnail's Shell^000000,";
					mes "5 ^3355FFMoth Dust^000000.";
					break;
				case 3:
					set SAGE_Q2,6;
					if(checkquest(2053) != -1) {
						changequest 2053,2058;
					}
					else if(checkquest(2054) != -1) {
						changequest 2054,2058;
					}
					else {
						changequest 2055,2058;
					}
					mes "5 ^3355FFMantis Scythe^000000,";
					mes "5 ^3355FFWorm Peeling^000000,";
					mes "5 ^3355FFRainbow Shell^000000.";
					break;
				case 4:
					set SAGE_Q2,7;
					if(checkquest(2053) != -1) {
						changequest 2053,2059;
					}
					else if(checkquest(2054) != -1) {
						changequest 2054,2059;
					}
					else {
						changequest 2055,2059;
					}
					mes "5 ^3355FFCobweb^000000,";
					mes "5 ^3355FFMantis Scythe^000000,";
					mes "5 ^3355FFSolid Shell^000000.";
				}
				next;
				mes "[Lucius Celsus]";
				mes "你把它们带来后我会继续上课。";
				mes "祝你愉快。";
				close;
			}
			mes "什么，你已经忘了我刚才告诉你的事？";
			mes "真麻烦……这次认真听。";
			next;
			mes "[Lucius Celsus]";
			mes "5 ^3355FF"+getitemname(.@items[0])+"^000000,";
			mes "5 ^3355FF"+getitemname(.@items[1])+"^000000,";
			mes "5 ^3355FF"+getitemname(.@items[2])+"^000000,";
			close;
		}
		else if (SAGE_Q2 >= 4  && SAGE_Q2 <= 7) {
			switch(SAGE_Q2) {
			case 4: setarray .@items[0],1025,935,928; break;
			//Horn, Snail's Shell, Moth Dust
			case 5: setarray .@items[0],947,946,1057; break;
			//Mantis Scythe, Worm Peeling, Rainbow Shell
			case 6: setarray .@items[0],1031,955,1013; break;
			//Cobweb, Mantis Scythe, Solid Shell
			case 7: setarray .@items[0],1025,1031,943; break;
			}
			if (countitem(.@items[0]) > 4 && countitem(.@items[1]) > 4 && countitem(.@items[2]) > 4) {
				mes "做得好。那么，你收集物品时观察昆虫了吗？";
				mes "嗯，我相信你完成得不错。";
				next;
				mes "[Lucius Celsus]";
				mes "昆虫类怪物大多没有相同的属性，";
				mes "对昆虫施放魔法前必须三思。";
				next;
				mes "[Lucius Celsus]";
				mes "昆虫能发现隐藏物体，真是不可思议。";
				mes "因此，隐匿或伪装等隐藏技能对昆虫怪物无效。";
				next;
				mes "[Lucius Celsus]";
				mes "有些昆虫会结群生活。";
				mes "它们由群体首领控制……";
				next;
				mes "[Lucius Celsus]";
				mes "例如蚁后玛雅……";
				mes "黄蜂女王女王蜂，";
				mes "或盗虫之王黄金盗虫……";
				next;
				mes "[Lucius Celsus]";
				mes "你无法独自击败那些首领怪物，";

			}
			mes "[凯斯勒警长]";
			mes "哇，你是第一个主动提供帮助的人。我们人手严重不足，同时还要处理末日祷告团和其他事情。";
			next;
			mes "[凯斯勒警长]";
			mes "我还没时间了解队员们可能遇到的工作困难。";
			next;
			mes "[凯斯勒警长]";
			mes "你能在幻象学各处巡视并和警员谈谈吗？";
			next;
			if (select( "好的。", "也许之后。" ) == 2) {
				emotion ET_CRY;
				mes "[凯斯勒警长]";
				mes "哦，我以为你想帮忙。";
				close;
			}
			setquest 5309;// Police Chief's Request
			mes "[凯斯勒警长]";
			mes "谢谢你。";
			close;
		}
		if (isbegin_quest(5310) == 0 || isbegin_quest(5311) == 0 || isbegin_quest(5312) == 0 || isbegin_quest(5313) == 0) {
			emotion ET_QUESTION;
			mes "你还没见过所有成员。";
			next;
			mes "[凯斯勒警长]";
			mes "见完后再回来。";
			close;
		}
	mes "你已经见过我的所有队员了。谢谢你。";
		next;
		mes "[凯斯勒警长]";
		mes "很高兴他们——萨尔格兰、盖雷夫、塞登和皮夫斯——都没有遇到问题。";
		next;
		mes "[凯斯勒警长]";
		mes "请收下这份小小的谢礼。";
		next;
		for ( .@quest_id = 5309; .@quest_id <= 5313; .@quest_id++ )
			erasequest .@quest_id;
		for ( .@quest_id = 5314; .@quest_id <= 5317; .@quest_id++ ) {
			if (isbegin_quest(.@quest_id) == 2) {
				erasequest .@quest_id;
				.@success++;
			}
		}
		setquest 5318;// Come Back Tomorrow
		getexp 200000 + (200000 * .@success),0;
		mes "[凯斯勒警长]";
		mes "如果你明天不忙，能回来再帮我吗？";
		close;
	case 3:
		emotion ET_HUK;
		mes "[凯斯勒警长]";
		mes "哦，这是你第一次来幻象学吗？";
		next;
		mes "[凯斯勒警长]";
		mes "这个地点最近才被发现，因此相当安全。我想不出有什么值得你担心的……";
		next;
		emotion ET_HUK;
		mes "[凯斯勒警长]";
		mes "哦，收回前言——确实有一件事。";
		next;
		mes "[凯斯勒警长]";
		mes "这个^82ABE9维鲁斯挖掘现场^000000很安全，但如果你打算前往^82ABE9维鲁斯中央广场^000000，务必做好最坏的准备。";
		next;
		mes "[凯斯勒警长]";
		mes "顺便说，这里的挖掘才刚开始，在挖掘结束前，里面的一切都必须保持原位。";
		next;
		emotion ET_FRET;
		mes "[凯斯勒警长]";
		mes "但那些末日祷告团让这变得不可能。呸！%$#@#$#@";
		next;
		mes "[凯斯勒警长]";
		mes "我担心得都快秃了。本来头发就不多。";
		next;
		mes "[凯斯勒警长]";
		mes "...";
		next;
		mes "[凯斯勒警长]";
		mes "嗯，我不是想抱怨自己的头发。";
		next;
		emotion ET_OK;
		mes "[凯斯勒警长]";
		mes "小心别破坏这里发现的任何东西。";
		close;
	case 4:
		if (isbegin_quest(5304) == 2) {
			mes "[凯斯勒警长]";
			mes "哦，你之前不是带来过一些末日代币吗？";
			next;
			mes "[凯斯勒警长]";
			mes "我猜你还没离开？你一定喜欢待在这里。我也是。哈哈哈哈！";
			while(1) {
				next;
				switch( select( "末日代币可以兑换什么", "交出末日代币。", "没什么。" ) ) {
				case 1:
					mes "[凯斯勒警长]";
					mes "你第一次带来末日代币时我就告诉过你，不过没关系，我不介意再说一遍。";
					next;
					mes "[凯斯勒警长]";
					mes "末日代币可以兑换挖掘现场常见的打包信封。";
					next;
					mes "[凯斯勒警长]";
					mes "学者发现，打开信封会触发各种效果。";
					next;
					mes "[凯斯勒警长]";
					mes "效果持续时间很短，但总比没有好。";
					continue;
				case 2:
					.@amount = countitem(6753);// Sign_Of_Destruction
					.@r = (.@amount > 2) ? .@amount : (.@amount - 2);
					.@reward_amount = rand(.@r, .@amount);
					delitem 6753, .@amount;
					getitem 22611, .@reward_amount;// Packed_Envelope
					mes "[凯斯勒警长]";
					mes "你带来了" + .@amount + "枚末日代币。我可以给你" + .@reward_amount + "个打包信封。";
					next;
					mes "[凯斯勒警长]";
					mes "谢谢，继续努力。";
					close;
				case 3:
					emotion ET_SCRATCH;
					mes "[凯斯勒警长]";
					mes "嗯，你不是说有末日代币吗？";
					close;
				}
			}
		}
		emotion ET_HUK;
		mes "[凯斯勒警长]";
		mes "哦，末日祷告团携带这种^F8081E末日代币^000000。";
		next;
		mes "[凯斯勒警长]";
		mes "你在哪里找到的？";
		next;
		select("告诉他你在哪里找到的。");
		emotion ET_THANKS;
		mes "[凯斯勒警长]";
		mes "非常感谢你帮助我们维护公共秩序。";
		next;
		mes "[凯斯勒警长]";
		mes "你应得奖励，但我想不到什么好东西。";
		next;
		mes "[凯斯勒警长]";
		mes "嗯……";
		next;
		emotion ET_SURPRISE;
		mes "[凯斯勒警长]";
		mes "哦，我有主意了！带来^F8081E末日代币^000000，我会兑换成^4E9867打包信封^000000。";
		next;
		select("打包信封？");
		mes "[凯斯勒警长]";
		mes "这是挖掘现场经常发现的信封。";
		next;
		mes "[凯斯勒警长]";
				mes "学者发现，打开信封会触发各种效果。";
		next;
		mes "[凯斯勒警长]";
		mes "现在要把末日代币兑换成打包信封吗？也可以以后再换。";
		next;
		if (select( "现在兑换。", "以后再做。" ) == 2) {
			mes "[凯斯勒警长]";
			mes "当然，没问题。末日代币又不会过期。";
		}
		else {
			.@amount = countitem(6753);// Sign_Of_Destruction
			delitem 6753, .@amount;
			getitem 22611, .@amount;// Packing_Envelope
			mes "[凯斯勒警长]";
			mes "用你的" + .@amount + "枚末日代币，我给你" + .@amount + "个打包信封。";
		}
		setquest 5304;// Police Chief Kesler
		completequest 5304;
		next;
		mes "[凯斯勒警长]";
		mes "谢谢你持续支持讨伐末日祷告团。";
		close;
	case 5:
		emotion ET_STARE_ABOUT;
		mes "[凯斯勒警长]";
		mes "这是我告诉每位新访客的第一件事：看到^F8081E末日祷告团^000000，立即向最近的警察局报告。";
		close;
	default:
		mes "[Police Chief Kesler]";
		mes "发生错误。如果重试后仍然如此，请截图并请求处理。";
		close;
	}
}

verus03,36,113,4	script	Police Officer Salgran#EP15	2_M_THIEFMASTER,{
	if (checkweight(1301,1) == 0) {
		mes "- 你携带的物品太多，无法继续。-";
		close;
	}
	.@quest_5305 = isbegin_quest(5305);// Police Officer Salgran
	.@quest_5309 = isbegin_quest(5309);// Police Chief's Request
	.@quest_5310 = isbegin_quest(5310);// Salgran's Problem
	.@quest_5314 = isbegin_quest(5314);// Salgran's Request
	.@quest_5315 = isbegin_quest(5315);// Gerev's Request
	.@quest_5316 = isbegin_quest(5316);// Seiden's Request
	.@quest_5317 = isbegin_quest(5317);// Piffs's Request
	.@playtime_5318 = checkquest(5318,PLAYTIME);

	if (.@quest_5309 != 1) {
		if (isbegin_quest(5305) == 0) {
			specialeffect EF_SLEEPATTACK;
			mes "[萨尔格兰警员]";
			mes "呼……呼……";
			next;
			emotion ET_PROFUSELY_SWEAT;
			mes "[萨尔格兰警员]";
			mes "警……警长，对不起！";
			next;
			mes "他在说梦话。";
			close;
		}
		mes "[萨尔格兰警员]";
		mes "是这样吗？这里什么都没有，你也什么都不是吗？";
		close;
	}
	if (.@quest_5315 == 1 || .@quest_5316 == 1 || .@quest_5317 == 1) {
		if (isbegin_quest(5305) == 0) {
			specialeffect EF_SLEEPATTACK;
			mes "[萨尔格兰警员]";
			mes "呼……呼……";
			next;
			emotion ET_PROFUSELY_SWEAT;
			mes "[萨尔格兰警员]";
			mes "警……警长，对不起！";
			next;
			mes "他在说梦话。";
			close;
		}
		if (isbegin_quest(5310) == 0) {
			mes "[萨尔格兰警员]";
			mes "你现在正在其他区域工作。完成后再回来。";
			close;
		}
		mes "[萨尔格兰警员]";
		mes "你在其他区域帮忙吗……？";
		close;
	}
	if (.@quest_5310 != 0) {
		mes "[萨尔格兰警员]";
		mes "你还没向队长报告吗？我说过我负责的区域一切正常。";
		close;
	}
	switch(.@quest_5314) {
	case 0:
		if (.@quest_5305 == 0) {
			specialeffect EF_SLEEPATTACK;
			select("打扰一下。");
			emotion ET_HUK;
			mes "[萨尔格兰警员]";
			mes "凯……凯斯勒警长！我……我没有打瞌睡！";
			next;
			emotion ET_THINK;
			mes "[萨尔格兰警员]";
			mes "...";
			next;
			mes "[萨尔格兰警员]";
			mes "呼，你不是警长。你是谁？";
			next;
			mes "[" + strcharinfo(0) + "]";
			mes "幻象学中央的警长派我来的。";
			next;
			emotion ET_SEXY;
			mes "[萨尔格兰警员]";
			mes "谢天谢地，他没有亲自来。他一定很忙吧？欢迎。能帮我一件事吗？";
			next;
			if (select( "帮忙。", "也许下次。" ) == 2) {
				emotion ET_OHNO;
				setquest 5305;// Police Officer Salgran
				completequest 5305;// Police Officer Salgran
				setquest 5310;// Salgran's Problem
				mes "[萨尔格兰警员]";
				mes "你一定很忙。好吧，那就告诉警长我负责的区域一切正常。";
				close;
			}
			mes "[萨尔格兰警员]";
			mes "谢谢！我被一些烦人的工作缠住了，需要你的帮助。";
			next;
			mes "[萨尔格兰警员]";
			mes "你知道末日祷告团就在我们中间吧？";
			next;
			mes "[萨尔格兰警员]";
			mes "他们到处散发非法宣传单，而且使用的纸张像口香糖一样粘在地上。";
			next;
			mes "[萨尔格兰警员]";
			mes "我需要在传单永久粘住前清除它们。";
			next;
			mes "[萨尔格兰警员]";
			mes "如果你在现场看到它们，能帮忙清除吗？它们让我头疼。";
			next;
			if (select( "好的", "也许下次。" ) == 2) {
				emotion ET_OHNO;
				setquest 5305;// Police Officer Salgran
				completequest 5305;// Police Officer Salgran
				setquest 5310;// Salgran's Problem
				mes "[萨尔格兰警员]";
				mes "你一定很忙。好吧，那就告诉警长我负责的区域一切正常。";
				close;
			}
			setquest 5314;
			mes "[萨尔格兰警员]";
			mes "谢谢。清除10张非法传单后回来。";
			close;
		}
		emotion ET_WRAP;
		mes "[萨尔格兰警员]";
		mes "欢迎回来。警长又派你来了吗？";
		next;
		emotion ET_QUESTION;
		mes "[萨尔格兰警员]";
		mes "太好了，你能再次帮我清除那些非法传单吗？";
		next;
		if (select( "帮忙。", "也许下次。" ) == 1) {
			setquest 5314;
			mes "[萨尔格兰警员]";
			mes "谢谢。清除10张非法传单后回来。";
			close;
		}
		setquest 5310;// Salgran's Problem
		mes "[萨尔格兰警员]";
		mes "你一定很忙。好吧，那就告诉警长我负责的区域一切正常。";
		close;
	case 1:
		mes "[萨尔格兰警员]";
		mes "哇，我以为你刚才离开了，没想到已经回来了。你清除非法传单了吗？";
		next;
		switch( select( "我做到了。", "在哪里能找到？", "我可以不做吗？", "算了。" ) ) {
		case 1:
			mes "[萨尔格兰警员]";
			if (checkquest(5314,HUNTING) == 2) {
				mes "哦，做得好！警长不会忘记人情，也许会根据心情给你更丰厚的奖励。";
				completequest 5314;
				if (isbegin_quest(5305) == 0) {
					setquest 5305;
					completequest 5305;
				}
				setquest 5310;
				close;
			}
			emotion ET_OHNO;
			mes "哼，当然没人能这么快。我让你至少清除10张非法传单。";
			close;
		case 2:
			emotion ET_HUK;
			mes "[萨尔格兰警员]";
			mes "幻象学到处都是。你不可能看不到。";
			next;
			emotion ET_SCRATCH;
			mes "[萨尔格兰警员]";
			mes "你视力有问题吗？不可能错过它们。";
			close;
		case 3:
			erasequest 5314;
			if (isbegin_quest(5305) == 0) {
				setquest 5305;
				completequest 5305;
			}
			setquest 5310;
			mes "[萨尔格兰警员]";
			mes "我想说不，但不能强迫你。去告诉警长我负责的区域一切正常。";
			close;
		case 4:
			emotion ET_SCRATCH;
			mes "[萨尔格兰警员]";
			mes "你真傻。";
			close;
		}
	case 2:
		end;
	}
	mes "[萨尔格兰警员]";
	mes "你还没向队长报告吗？我说过我负责的区域一切正常。";
	close;
}

verus03,116,36,6	script	Police Officer Gerev#EP15_1D	4_M_ALCHE_A,{
	if (checkweight(1301,1) == 0) {
		mes "- 你携带的物品太多，无法继续。-";
		close;
	}
	.@quest_5306 = isbegin_quest(5306);// Police Officer Gerev
	.@quest_5309 = isbegin_quest(5309);// Police Chief's Request
	.@quest_5311 = isbegin_quest(5311);// Gerev's Problem
	.@quest_5314 = isbegin_quest(5314);// Salgran's Request
	.@quest_5315 = isbegin_quest(5315);// Gerev's Request
	.@quest_5316 = isbegin_quest(5316);// Seiden's Request
	.@quest_5317 = isbegin_quest(5317);// Piffs's Request
	.@playtime_5318 = checkquest(5318,PLAYTIME);

	mes "[Police Officer Gerev]";
	if (.@quest_5309 != 1) {
		if (isbegin_quest(5306) == 0) {
			emotion ET_OTL;
			mes "呃，我能感觉到压力在体内累积……啊，这地方让我得胃溃疡了！";
			next;
			mes "他痛苦地揪着头发。";
			close;
		}
		emotion ET_DELIGHT;
		mes "我现在好多了。请告诉凯斯勒警长我负责的区域一切正常。";
		close;
	}
	if (.@quest_5314 == 1 || .@quest_5316 == 1 || .@quest_5317 == 1) {
		if (isbegin_quest(5306) == 0) {
			emotion ET_OTL;
			mes "呃，我能感觉到压力在体内累积……啊，这地方让我得胃溃疡了！";
			next;
			mes "他痛苦地揪着头发。";
			close;
		}
		if (isbegin_quest(5311) == 0) {
			emotion ET_PROFUSELY_SWEAT;
			mes "呃，我胃痉挛了。完成当前任务后再回来。";
			close;
		}
		mes "[Police Officer Gerev]";
		mes "你在其他区域帮忙吗？真厉害……我只求别给我压力……";
		close;
	}
	if (.@quest_5311 != 0) {
		emotion ET_DELIGHT;
		mes "我现在好多了。请告诉凯斯勒警长我负责的区域一切正常。";
		close;
	}
	switch(.@quest_5315) {
	case 0:
		if (.@quest_5306 == 0) {
			emotion ET_CONFUSE;
			mes "啊，我的笔呢？离开警察局时还在。难道被那些机器人偷走了？";
			next;
			mes "[" + strcharinfo(0) + "]";
			mes "检查耳朵后面。";
			next;
			emotion ET_HUK;
			mes "[Police Officer Gerev]";
			mes "呃？我不记得把它放在那里了。";
			next;
			emotion ET_QUESTION;
			mes "[Police Officer Gerev]";
			mes "哎呀，抱歉。我能怎样帮助你？";
			next;
			mes "[" + strcharinfo(0) + "]";
			mes "幻象学中央的警长派我来的。";
			next;
			emotion ET_FRET;
			mes "[Police Officer Gerev]";
			mes "啊，凯斯勒警长派你来的。如果不是了解他，我会以为他太忙没空见我。不过我肯定比他更忙。";
			next;
			if (select( "我可以帮忙。", "抱歉，我帮不了。" ) == 2) {
				if (isbegin_quest(5306) == 0) {
					setquest 5306;
					completequest 5306;
				}
				setquest 5311;// Gerev's Problem
				mes "[Police Officer Gerev]";
				mes "你愿意帮助警长，却不帮我。难道因为我不是警长？";
				next;
				emotion ET_STARE;
				mes "[Police Officer Gerev]";
				mes "*哼* 去告诉凯斯勒警长，我负责的区域一切安静。";
				close;
			}
			emotion ET_BIGTHROB;
			mes "[Police Officer Gerev]";
			mes "你确定吗？因为我真的讨厌失望。";
			next;
			mes "[Police Officer Gerev]";
			mes "如你所知，末日祷告团就在我们中间。咬牙，一想到他们我就磨牙。";
			next;
			mes "[Police Officer Gerev]";
			mes "昨天我踩到他们的一个陷阱，扭伤了脚踝，";
			next;
			mes "[Police Officer Gerev]";
			mes "更别提其他倒霉事了。";
			next;
			mes "[Police Officer Gerev]";
			mes "唉，你能拆除他们的陷阱吗？";
			next;
			if (select( "没问题。", "也许下次。" ) == 2) {
				emotion ET_FRET;
				if (isbegin_quest(5306) == 0) {
					setquest 5306;
					completequest 5306;
				}
				setquest 5311;
				mes "[Police Officer Gerev]";
				mes "*哼* 我就知道。去告诉凯斯勒队长，我负责的区域一切安静。";
				close;
			}

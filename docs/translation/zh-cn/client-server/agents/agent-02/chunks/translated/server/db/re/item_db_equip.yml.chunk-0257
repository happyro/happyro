    AegisName: S_Healing_Shield
    Name: Healing Shadow Shield
    Type: Shadowgear
    Locations:
      Shadow_Shield: true
    EquipLevelMin: 1
    Refineable: true
    Script: |
      .@r = getrefine();
      bonus bMaxHP,.@r*10;
      bonus bMatk,10;
      if (.@r >= 7) {

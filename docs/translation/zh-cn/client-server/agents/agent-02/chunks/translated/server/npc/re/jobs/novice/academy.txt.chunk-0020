gef_fild07,89,208,6	script	Magician's Guild Guide#1	2_F_MAGICMASTER,{
	if (isbegin_quest(9265) == 1) {
		mes "[魔法师公会向导]";
		mes "首先，我的任务是带你前往魔法师公会！";
		mes "一直向右走！";
		mes "^8B4513过桥^000000后，你就会看到^FF0000吉芬^000000的入口！";
		next;
		mes "[魔法师公会向导]";
		mes "到了那里，";
		mes "你应该能找到我们的<NAVI>^4D4DFF[魔法师公会向导]^000000<INFO>geffen,43,123,</INFO></NAVI>。";
		mes "和他交谈，他会继续带你前往魔法师公会！";
	} else {

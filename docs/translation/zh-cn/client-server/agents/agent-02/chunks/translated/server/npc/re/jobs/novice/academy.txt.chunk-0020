		mes "[魔法师公会向导]";
		mes "你看起来有点累了……";
		mes "不过……成为魔法师本来就是一件辛苦的事……";
		next;
		mes "[魔法师公会向导]";
		mes "首先，我的任务是带你前往魔法师公会！";
		mes "一直向右走！";
		mes "^8B4513过桥^000000后，你就会看到^FF0000吉芬^000000的入口！";
		next;
		mes "[魔法师公会向导]";
		mes "到了那里，";
		mes "你应该能找到我们的<NAVI>^4D4DFF[魔法师公会向导]^000000<INFO>geffen,43,123,</INFO></NAVI>。";
		mes "和他交谈，他会继续带你前往魔法师公会！";
		nov_3_magician = 2;
		completequest 9264;
		erasequest 9264;
		setquest 9265;
		close;
	}
}

// - Magician's Guild Guide

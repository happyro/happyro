geffen,43,123,6	script	Magician's Guild Guide#2	2_F_MAGICMASTER,{
	if (isbegin_quest(9265) == 1) {
		mes "[魔法师公会向导]";
		mes "啊，你一路来到这里了。对学院学生来说做得很好！";
		next;
		mes "[魔法师公会向导]";
		mes "没有这份一步步的向导，他们很容易迷路并感到沮丧。";
		next;
		mes "[魔法师公会向导]";
		mes "总之，长话短说。";
		mes "现在我告诉你前往魔法师公会的路线！";
		mes "路线很简单……";
		mes "从这里朝11点钟方向走，你就会看到魔法师公会。";
		next;
		mes "[魔法师公会向导]";
		mes "进去后上楼走一小段，就能找到";
		mes "<NAVI>^4D4DFF[魔法师公会成员]^000000<INFO>geffen_in,164,124,</INFO></NAVI>";
		mes "他会在那里协助你成为魔法师。";
		completequest 9265;
		erasequest 9265;
		setquest 9266;
	} else if (isbegin_quest(9266) == 1) {
		mes "[魔法师公会向导]";
		mes "路线很简单……";
		mes "从这里朝11点钟方向走，你就会看到魔法师公会。";
		next;
		mes "[魔法师公会向导]";
		mes "进去后上楼走一小段，就能找到";
		mes "<NAVI>^4D4DFF[魔法师公会成员]^000000<INFO>geffen_in,164,124,</INFO></NAVI>";
		mes "他会在那里协助你成为魔法师。";
	} else {
		mes "[魔法师公会向导]";
		mes "我负责带领^8B4513克里图拉学院^000000的学生前往魔法师公会。";
		mes "最近学院来了很多新学生，所以我很高兴能在这里工作。";
	}
	close;

OnInit:
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "!isbegin_quest(9266) && isbegin_quest(9265) == 1" );
	end;
}

// =============================================================================
// = Merchant
// =============================================================================

// - Salim Hamid
// -----------------------------------------------------------------------------
iz_ac02,50,169,3	script	Salim Hamid#ac	1_M_MERCHANT,{
	disable_items;
	if (!checkweight(714,3) || (MaxWeight - Weight) < 10000) {
		mes "- 你携带的物品过多，无法继续任务。-";
		close;
	}
	if (BaseLevel > 15 || Class != Job_Novice) {
		cutin "aca_salim01",2;
		mes "[萨利姆·哈米德]";
		mes "嗯？";
		mes "这门课程只面向刚开始冒险的初心者。";
		next;
		mes "[萨利姆·哈米德]";
		mes "看你的样子似乎需要帮助。要不要去别的地方看看？";
		close2;
		cutin "", 255;
		end;
	}
	if (isbegin_quest(4269) < 1) {
		cutin "aca_salim01",2;
		mes "[萨利姆·哈米德]";
		mes "哦～";
		mes "一眼看去，你就像一只迷路的小羊……这里禁止未登记的访客进入。";
		next;
		mes "[萨利姆·哈米德]";
		mes "如果你想自由参观这里，最好先在学院入口的信息台登记。";
		close2;
		cutin "", 255;
		end;
	}
	if (JobLevel >= 10) {
		cutin "aca_salim01.bmp", 2;
		mes "[萨利姆·哈米德]";
		mes "哟哦～";
		mes "看起来你已经准备好转职为一转职业了。";
		next;
		cutin "aca_salim02",2;
		mes "[萨利姆·哈米德]";
		mes "怎么样？你对商人的道路感兴趣吗？如果感兴趣，我可以帮助你。";
		next;
		if (select("没兴趣。", "感兴趣。") == 1) {
			mes "[萨利姆·哈米德]";
			mes "哦……不……";
			mes "好吧，没办法。克里图拉学院优先尊重冒险者自己的选择。";
			close2;
			cutin "", 255;
			end;
		}
		mes "[萨利姆·哈米德]";
		mes "很好～我会把你送到艾尔帕兰，在那里你可以成为商人。";
		next;
		mes "[萨利姆·哈米德]";
		mes "不要去别处，马上进入城镇。";
		mes "找到<NAVI>[铁匠铺]<INFO>alberta_in,75 48</INFO></NAVI>。";
		next;
		if (select("还没准备好。", "我准备好了！") == 1) {
			mes "[萨利姆·哈米德]";
			mes "好的，我明白了。准备好后再来找我吧。";
			close2;
			cutin "", 255;
			end;
		} else {
			mes "[萨利姆·哈米德]";
			mes "很好～请前往铁匠铺找我。";
			close2;
			setquest 12307;
			warp "pay_fild03", 388, 68;
			end;
		}
	}
	if (isbegin_quest(12302) < 1) {
		cutin "aca_salim02.bmp", 2;
		mes "[萨利姆·哈米德]";
		mes "哦～";
		mes "嘿，你就像一只迷路的小羊。知道自己为什么来到这里吗？";
		next;
		if (select("不知道", "知道。") == 1) {
			mes "[萨利姆·哈米德]";
			mes "哦……你不知道吗？";
			next;
		} else {
			mes "[萨利姆·哈米德]";
			mes "哦～ you seem like a quick learner.";
			next;
		}
		mes "[萨利姆·哈米德]";
		mes "好吧，至少让我先做个介绍。";
		next;
		cutin "aca_salim01.bmp", 2;
		mes "[萨利姆·哈米德]";
		mes "我是负责克里图拉学院商人课程培训的^0000ff萨利姆·哈米德^000000。";
		next;
		mes "[萨利姆·哈米德]";
		mes "这间教室供商人申请者使用。实际上，这里主要负责克里图拉学院的财务管理。";
		next;
		cutin "aca_salim02.bmp", 2;
		mes "[萨利姆·哈米德]";
		mes "下次如果想旁听商人课程，可以来找我萨利姆·哈米德登记。";
		setquest 12302;
		completequest 12302;
		close2;
		cutin "", 255;
		end;
	}
	if (isbegin_quest(12303) < 1) {
		cutin "aca_salim01.bmp", 2;
		mes "[萨利姆·哈米德]";
		mes "哦～ You came back. Do you want to experience the Merchant training course? It is a little bit difficult to the average beginner.";
		next;
		if (select("不用了，谢谢！", "我要报名！") == 1) {
			mes "[萨利姆·哈米德]";
			mes "哦～ though it is a bit hard, it is worth learning. Sadly, there's no other way.";
			close2;
			cutin "", 255;
			end;
		}
		mes "[萨利姆·哈米德]";
		mes "哦，是的……那么，先在这份学生名单上登记你的名字吧？";
		next;
		if (select("拒绝。", "把名字写在名单上。") == 1) {
			cutin "aca_salim03.bmp", 2;
			mes "[萨利姆·哈米德]";
			mes "一开始就抗拒吗？这可不是开始训练的方式。";
			close2;
			cutin "", 255;
			end;
		}
		cutin "aca_salim01.bmp", 2;
		mes "[萨利姆·哈米德]";
		mes "嗯～你的名字是……";
		mes "^0000ff"+ strcharinfo(0) +"^000000...... right?";
		next;
		mes "[萨利姆·哈米德]";
		mes "想旁听商人课程，首先要具备商人的心态。手里不到100 Zeny的交易者不能称为商人。";
		next;
		cutin "aca_salim02.bmp", 2;
		mes "[萨利姆·哈米德]";
		mes ""+ strcharinfo(0) +"^000000下节课前带着100 Zeny回来找我。";
		next;
		mes "[萨利姆·哈米德]";
		mes "当然，我不会拿走那笔钱。这只是测试你是否具备成为商人的基本心态。祝你好运。";
		setquest 12303;
		close2;
		cutin "", 255;
		end;
	} else if (isbegin_quest(12303) == 1) {
		if (Zeny >= 100) {
			cutin "aca_salim02.bmp", 2;
			mes "[萨利姆·哈米德]";
			mes "哇，你真的带着100 Zeny回来了。我清楚感受到了你想学习的愿望。";
			next;
			mes "[萨利姆·哈米德]";
			mes "现在我会给你一本商人手册。装备它，然后按Alt + S键查看技能窗口。";
			next;
			mes "[萨利姆·哈米德]";
			mes "点击技能窗口中的[MISC]标签，就能看到商人手册技能。";
			next;
			mes "[萨利姆·哈米德]";
			mes "现在～我们该进入下一门课程了。装备手册并查看技能，然后再来和我说话。";
			getitem 2823,1;// Merchant_Manual
			completequest 12303;
			close2;
			cutin "", 255;
			end;
		} else {
			cutin "aca_salim02.bmp", 2;
			mes "[萨利姆·哈米德]";
			mes "呵呵呵……测试不容易吧？现在要放弃吗？";
			next;
			if (select("做不到。", "放弃。") == 1) {
				mes "[萨利姆·哈米德]";
				mes "要放弃吗？100 Zeny并不难赚到，朋友。";
				close2;
				cutin "", 255;
				end;
			} else {
				mes "[萨利姆·哈米德]";
				mes "好的，改变主意后再来找我。";
				erasequest 12303;
				close2;
				cutin "", 255;
				end;
			}
		}
	}
	if (isbegin_quest(12304) < 1) {
		cutin "aca_salim01",2;
		mes "[萨利姆·哈米德]";
		mes "现在，要不要参加关于商人赚钱所需各种基础技能的课程？";
		next;
		mes "[萨利姆·哈米德]";
		mes "你最好向隔壁场地工作的管理员学习。去找他上商人理论课，然后再回来找我。";
		setquest 12304;
		close2;
		cutin "", 255;
		end;
	} else if (isbegin_quest(12304) == 1) {
		cutin "aca_salim01",2;
		mes "[萨利姆·哈米德]";
		mes "你还没去上课吗？去找我旁边的管理员，完成商人技能理论课后再回来。";
		close2;
		cutin "", 255;
		end;
	}
	if (isbegin_quest(12305) < 1) {
		mes "[萨利姆·哈米德]";
		mes "你听完管理员讲解商人能做什么的课程了吗？";
		next;
		cutin "aca_salim02",2;
		mes "[萨利姆·哈米德]";
		mes ""+strcharinfo(0)+"，你有兴趣继续在这里了解商人吗？";
		next;
		if (select("我去看看其他职业。", "让我再学习一点。") == 1) {
			mes "[萨利姆·哈米德]";
			mes "很好，你愿意保持开放的心态。学院里除了商人，还有许多其他讲师。";
			next;
			mes "[萨利姆·哈米德]";
		mes ""+strcharinfo(0)+"，想再次学习时随时回来找我。";
			close2;
			cutin "", 255;
			end;
		}
		mes "[萨利姆·哈米德]";
		mes "是这样吗？好吧，现在要学习商人属性的主要作用吗？准备好后和我说话。";
		setquest 12305;
		close2;
		cutin "", 255;
		end;
	} else if (isbegin_quest(12305) == 1) {
		cutin "aca_salim01.bmp", 2;
		mes "[萨利姆·哈米德]";
		mes "交易者的属性分为两大类：一类用于制造，另一类用于战斗。";
		next;
		cutin "aca_salim02",2;
		mes "[萨利姆·哈米德]";
		mes "当然，那是今后才会用到的内容。目前你甚至缺少足够的属性点来投资DEX，以便猎杀魔物。";
		next;
		cutin "aca_salim01",2;
		mes "[萨利姆·哈米德]";
		mes "不过，了解基本规则和对此一无所知之间有很大差别。";
		mes "让我们逐一了解吧。";
		next;
		mes "[萨利姆·哈米德]";
		mes "那么，我们先从哪一类开始？";
		while(1) {
			next;
			switch(select("已经知道了。", "战斗属性", "制造属性")) {
			case 1:
				mes "[萨利姆·哈米德]";
				mes "这样就可以了吧？";
				next;
				if (select("我全都知道了。", "请再解释一次。") == 1) {
					mes "[萨利姆·哈米德]";
					mes "是的，"+strcharinfo(0)+"。很高兴遇到你这样学得快的学生，也省了我的时间。";
					next;
				} else {
					mes "[萨利姆·哈米德]";
					mes "啊哈～看来是我误会你了。我们重新开始讲课吧。";
					continue;
				}
				break;
			case 2:
				mes "[萨利姆·哈米德]";
				mes "作为交易者，影响战斗力的属性主要有两项：^4d4fffSTR和DEX^000000。";
				next;
				mes "[萨利姆·哈米德]";
				mes "STR关系到基础攻击力，DEX关系到命中率和受伤后的恢复。";
				next;
				mes "[萨利姆·哈米德]";
				mes "将来根据你选择的二转和三转职业，还能学习其他攻击属性，例如^4d4fffINT或AGI^000000。";
				next;
				mes "[萨利姆·哈米德]";
				mes "为了弥补不足，你可以适当提高LUK。";
				next;
				mes "[萨利姆·哈米德]";
				mes "与其自己烦恼，不如向其他商人学习。记得向别人请教。";
				next;
				mes "[萨利姆·哈米德]";
				mes "还有其他问题吗？";
				continue;
			case 3:
				mes "[萨利姆·哈米德]";
				mes "制造相关属性比战斗属性简单。唯一的难点是如何培养。";
				next;
				mes "[萨利姆·哈米德]";
				mes "通常会以^4d4fffDEX和LUK^000000为基础，如果还有余力，就把剩余点数投入^4d4fffINT^000000。";
				next;
				mes "[萨利姆·哈米德]";
				mes "当然，属性点的分配应根据你的装备和所处状况适当调整。";
				next;
				mes "[萨利姆·哈米德]";
				mes "请记住，独自作为专精制造的商人成长，可能会是一条非常枯燥而清苦的道路。";
				next;
				mes "[萨利姆·哈米德]";
				mes "可以的话，尽量利用朋友和他们的物品。";
				mes "这只是我的个人意见。";
				mes "绝不代表克里图拉学院的官方立场。";
				next;
				mes "[萨利姆·哈米德]";
				mes "还有其他问题吗？";
				continue;
			}
			break;
		}
		mes "[萨利姆·哈米德]";
		mes "那么，这门课就到此结束。";
		mes "如果还想了解商人，请再来找我。";
		completequest 12305;
		close2;
		cutin "", 255;
		end;
	}
	if (isbegin_quest(12306) < 1) {
		mes "[萨利姆·哈米德]";
		mes "你又回来了。"+strcharinfo(0)+"，这次要不要通过跑一趟简单的差事进行实践训练？";
		next;
		mes "[萨利姆·哈米德]";
		mes "你看到教室角落那台吵闹的自动售货机了吗？它原本是饮料售货机，但特别吞硬币……";
		next;
		cutin "aca_salim02",2;
		mes "[萨利姆·哈米德]";
		mes "总之，由于这个原因，它现在被用来让学员练习技能。请确认加勒结晶和扎贡的价格。";
		next;
		mes "[萨利姆·哈米德]";
		mes "但是！你必须装备商人手册并使用折扣技能，带着^4d4fff折扣价格的信息^000000回来。";
		next;
		cutin "aca_salim01",2;
		mes "[萨利姆·哈米德]";
		mes "不要购买它们，只要带着确认过的价格回来。能做到吗？";
		next;
		if (select("我下次再做。", "我会去做。") == 1) {
			mes "[萨利姆·哈米德]";
			mes "好吧，那就下次再挑战吧。";
			close2;
			cutin "", 255;
			end;
		}
		mes "[萨利姆·哈米德]";
		mes "很好～回头见。";
		setquest 12306;
		close2;
		cutin "", 255;
		end;
	} else if (isbegin_quest(12306) == 1) {
		cutin "aca_salim02",2;
		mes "[萨利姆·哈米德]";
		mes "好的。让我看看你确认的价格。";
		next;
		switch(select("我重新确认后再回来。:加勒结晶39z 扎贡450z:加勒结晶37z 扎贡448z:加勒结晶37z 扎贡446z:加勒结晶37z 扎贡444z")) {
			case 1:
				mes "[萨利姆·哈米德]";
				mes "好吧。重新仔细确认后再回来。";
				close2;
				cutin "", 255;
				end;
			case 4:
				mes "[萨利姆·哈米德]";
				mes "好～你装备商人手册正确确认了价格。";
				next;
				cutin "aca_salim01",2;
				mes "[萨利姆·哈米德]";
				mes "也许，成为商人并使用高级折扣技能后，你就能以便宜得多的价格买到想要的东西。";
				next;
				mes "[萨利姆·哈米德]";
				mes "加价练习也是一样的道理。";
				next;
				cutin "aca_salim02",2;
				mes "[萨利姆·哈米德]";
				mes "你也不必专门练习加价。出售其他课程中获得的物品时就能体验。";
				next;
				mes "[萨利姆·哈米德]";
				mes "学院的商人培训到此结束。";
				completequest 12306;
				close2;
				cutin "", 255;
				end;
			default:
				cutin "aca_salim03",2;
				mes "[萨利姆·哈米德]";
				mes "你确认得正确吗？";
				close2;
				cutin "", 255;
				end;
		}
	}
	// if (JobLevel < 10) {
	cutin "aca_salim02",2;
	mes "[萨利姆·哈米德]";
	mes "哈哈哈。"+strcharinfo(0)+"，你已经完成了克里图拉学院的商人理论课程。";
	next;
	mes "[萨利姆·哈米德]";
	mes "如果你想测试商人手册中的其他战斗技能，";
	mes "请前往一楼的<NAVI>[战斗训练师苏比诺]<INFO>iz_ac01,59,83</INFO></NAVI>。";
	next;
	mes "[萨利姆·哈米德]";
	mes "你可以通过他完整体验战斗相关的练习。";
	next;
	mes "[萨利姆·哈米德]";
	mes "达到Job等级10后，"+strcharinfo(0)+"将获得下一门课程的向导。祝你好运。";
	close2;
	cutin "", 255;
	end;
}

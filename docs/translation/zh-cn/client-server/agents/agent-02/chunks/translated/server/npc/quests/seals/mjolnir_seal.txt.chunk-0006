							mes "索尔再次成为幻术的受害者。";
							mes "他没意识到自己并非真的在与老妇人摔跤。你知道他的对手究竟是什么吗？";
							next;
							switch(select("Curse:Earth:Heart:Old Age")) {
							default:
								set .@talk_not,1;
								break;
							case 4:
								break;
							}
						}
						else if (.@talk_to == 3) {
							mes "[Nordri]";
							mes "没错，索尔是在和‘老年’摔跤！无论多么强大，都无法与衰老抗争。";
							next;
							mes "[Nordri]";
							mes "索尔输掉每场比赛后，";
							mes "国王告诉了他比赛的真相。索尔怒不可遏，但为时已晚。那时国王和巨人们早已全部消失。";
							next;
							mes "[Nordri]";
							mes "这个故事有两点教训。";
							mes "第一，不要相信眼前的一切；第二，永远不要对自己的力量过度自信。";
							next;
							mes "[Nordri]";
							mes "总会有人或某种事物比你更强大。重要的是尽力而为，并保持谦逊的态度。";
							next;
							mes "[Nordri]";
							mes "尽力过好自己的生活。记住，你不可能拥有想要的一切。执迷与非理性总是相伴而生。";
							next;
							set god_mjo_4,2;
							mes "[Nordri]";
							mes "谢谢你听完我的长篇故事。如果遇到危险地执迷不悟的人，请把索尔与巨人王幻术的故事讲给他听。";
							close;
						}
						if (.@talk_not == 1) {
							mes "[Nordri]";
							mes "嗯……？";
							mes "我不认为是这样。让我想想，也许能记起来。希望迟早会想起来……";
							next;
							mes "[Nordri]";
							mes "再喝一瓶红色药水后，我们再继续聊这个话题吧？哈哈哈哈哈～";
							close;
						}
						else {
							set .@talk_to,.@talk_to + 1;
						}
					}
				}
				else {
					mes "[Nordri]";
					mes "哦哦……";
					mes "我好渴！";
					next;
					mes "[Nordri]";
					mes "嗯，我不是让你带红色药水来吗？喉咙这么干，我可没法讲故事～";
					close;
				}
			}
			else if (god_mjo_4 == 0) {
				mes "[Nordri]";
				mes "人类，你来找我";
				mes "有什么事？";
				mes "到底想做什么？";
				next;
				switch(select("Nothing.:Excuse me.")) {
				case 1:
					mes "[Nordri]";
					mes "哼。";
					mes "既然如此，";
					mes "那就别来烦我。";
					close;
				case 2:
					mes "[Nordri]";
					mes "奇怪。最近有太多的人类想见我和兄弟们。不过，他们的拜访也不能说令人不快。";
					next;
					set god_mjo_4,1;
					mes "[Nordri]";
					mes "我有点渴。能带一瓶红色药水给我吗？如果你愿意，我就告诉你一个重要的故事。嘿嘿嘿～";
					close;
				}
			}
			else {
				mes "[Nordri]";
				mes "呼……呼……";
				close2;
			}
		}
		else if (god_mjo_0 == 2) {
			if ((god_mjo_1 == 3) || (god_mjo_2 == 3) || (god_mjo_3 == 3) || (god_mjo_4 == 3)){
				mes "[Nordri]";
				mes "呵呵呵～";
				mes "待在姆约尔尼尔森林真好。周围安静祥和，什么都不用担心……";
				close;
			}
			else if (god_mjo_1 == 2) {
				mes "[Nordri]";
				mes "你现在不是该上路了吗？算了，不关我的事。";
				next;
				mes "[Nordri]";
				mes "如果有多余的 Zeny，为什么不买些旅行零食？比如美味的香蕉，或者南瓜……";
				close;
			}
			else if ((god_mjo_2 != 0) || (god_mjo_3 != 0) || (god_mjo_4 != 0)) {
				mes "[Nordri]";
				mes "人类，你来找我";
				mes "有什么事？";
				mes "到底想做什么？";
				next;
				switch(select("Nothing.:Excuse me.")) {
				case 1:
					mes "[Nordri]";
					mes "哼。";
					mes "既然如此，";
					mes "那就别来烦我。";
					close;
				case 2:
					set god_mjo_1,3;
					mes "[Nordri]";
					mes "哼。";
					mes "这样也好。不过……";
					mes "没想到你是";
					mes "如此有礼貌的人类。";
					close;
				}
			}
			else if (god_mjo_1 == 1) {
				if (countitem(501) > 0) {

					delitem 501,1;  //Red_Potion
					mes "[Nordri]";
					mes "啊，你带来了";
					mes "红色药水……？";
					mes "作为回报，我会";
					mes "告诉你一个古老的故事。";
					mes "我相信你会喜欢。";
					next;
					while(1) {
						if (.@talk_to == 0) {
							mes "[Nordri]";
							mes "有一个名叫阿尔维斯的矮人，他拥有比图书馆更多的知识，比战士齐格弗里德更加勇敢。";
							next;
							mes "[Nordri]";
							mes "不幸的是……";
							mes "他野心太大。";
							mes "他对索尔的长女特鲁德一见钟情。";
							next;
							mes "[Nordri]";
							mes "他请求索尔允许自己迎娶特鲁德，但索尔果然拒绝了。阿尔维斯本该就此放弃，可他没有。";
							next;
							mes "[Nordri]";
							mes "于是索尔决定用问题测试他的知识。第一个问题是：‘人类如何称呼脚下的土地？’你知道答案吗？";
							next;
							switch(select("Ymir's body:Earth:Lane:Universe")) {
							default:
								set .@talk_not,1;
								break;
							case 2:
								break;
							}
						}
						else if (.@talk_to == 1) {
							mes "[Nordri]";
							mes "没错，就是‘大地’。阿尔维斯也正确回答了索尔的问题。";
							next;
							mes "[Nordri]";
							mes "索尔又问了阿尔维斯一个问题。巨人如何称呼覆盖大地的圆形外壳？";
							next;
							switch(select("Ymir's Head:Sky:Cloud Factory:High House")) {
							default:
								set .@talk_not,1;
								break;
							case 4:
								break;
							}
						}
						else if (.@talk_to == 2) {
							mes "[Nordri]";
							mes "就是‘高屋’。巨人身躯庞大，在他们看来或许确实如此。";
							next;
							mes "[Nordri]";
							mes "索尔又问：诸神如何称呼夜空中升起的球体？";
							next;
							switch(select("Circling Wheel:Moon:False Sun:Fast Stranger")) {
							default:
								set .@talk_not,1;
								break;
							case 3:
								break;
							}
						}
						else if (.@talk_to == 3) {
							mes "[Nordri]";
							mes "没错！诸神把";
							mes "月亮称为‘虚假的太阳’。";
							mes "虽然阿尔维斯答对了索尔所有问题，却没注意到太阳正在升起。";
							next;
							mes "[Nordri]";
							mes "没错……";
							mes "索尔故意拖延考验，等太阳升起后";
							mes "阿尔维斯就会变成石头。";
							next;
							mes "[Nordri]";
							mes "我们可以从这个故事学到两点。";
							mes "第一，不要贪恋某物到挑战命运或诸神的地步。";
							mes "第二，保持理智。";
							next;
							mes "[Nordri]";
							mes "第二，不要过分自负。无论你有多大的能力或天赋，";
							mes "也不可能得到想要的一切。";
							next;
							mes "[Nordri]";
							mes "最重要的是";
							mes "过正直善良的生活。实现愿望固然很好，但要明白有些愿望注定无法实现。";
							mes "请记住这个教训。";
							next;
							set god_mjo_1,2;
							mes "[Nordri]";
							mes "谢谢你听完我的故事。如果遇到被无尽欲望折磨的人，请把索尔与阿尔维斯的故事告诉他；阿尔维斯是勇敢却极其叛逆的矮人。";
							close;
						}
						if (.@talk_not == 1) {
							mes "[Nordri]";
							mes "嗯……？";
							mes "我不认为是这样。让我想想，也许迟早会记起来……";
							next;
							mes "[Nordri]";
							mes "再喝一瓶红色药水后，我们再继续聊吧？哈哈哈哈哈～";
							close;
						}
						else {
							set .@talk_to,.@talk_to + 1;
						}
					}
				}
				else {
					mes "[Nordri]";
					mes "哦哦……";
					mes "我好渴！";
					next;
					mes "[Nordri]";
					mes "嗯，我不是让你带红色药水来吗？喉咙这么干，我可没法讲故事～";
					close;
				}
			}
			else if (god_mjo_1 == 0) {
				mes "[Nordri]";
				mes "人类，你来找我";
				mes "有什么事？";
				mes "到底想做什么？";
				next;
				switch(select("Nothing.:Excuse me.")) {
				case 1:
					mes "[Nordri]";
					mes "你真有趣，不过别来烦我。";
					close;
				case 2:
					mes "[Nordri]";
					mes "奇怪。最近有太多的人类想见我和兄弟们。不过，他们的拜访也不能说令人不快。";
					next;
					set god_mjo_1,1;
					mes "[Nordri]";
					mes "我有点渴。能带一瓶红色药水给我吗？如果你愿意，我就告诉你一个重要的故事。嘿嘿嘿～";
					close;
				}
			}
			else {
				mes "[Nordri]";
				mes "呼……呼……呼……";
				close;
			}
		}
		else if (god_mjo_0 == 0) {
			mes "[Nordri]";
			mes "我是诺德里，";
			mes "矮人铁匠。";
			next;
			mes "[Nordri]";
			mes "我负责姆约尔尼尔山北部。如果你想通过，必须先得到我的许可！";
			next;
			mes "[Nordri]";
			mes "呵呵呵……";
			mes "冷静点，";
			mes "刚才只是个玩笑。";
			mes "哈哈哈哈哈！";
			close;
		}
		else {
			mes "[Nordri]";
			mes "呼……呼……呼……";
			close;
		}
	}
}

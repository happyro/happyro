1@bamn,202,274,5	script(DISABLED)	Est#est03	4_F_ESTLOVELOY,{
	if ('twilight_story == 5) {
		cutin "ep162_est01",2;
		mes "[Est]";
		mes "我觉得多放些诱饵比较好，所以去请求自动人偶帮忙。";
		mes "另外，Almond 说她得出去检查一些东西。";
		next;
		cutin "ep172_beta",0;
		mes "[Almond]";
		mes "中继器又坏了，所以我必须修好它。";
		mes "中继器是入侵者最喜欢攻击的目标，不能就这样放着不管，对吧？";
		next;
		cutin "ep162_est01",2;
		mes "[Est]";
		mes "因此，我想请你护送 Almond 去检查中继器。";
		mes "我会四处看看，寻找其他路线。";
		next;
		cutin "ep172_beta",0;
		mes "[Almond]";
		mes "准备好后我们就一起出发。";
		close2;
		cutin "",255;
		if ('twilight_story == 5)
			'twilight_story = 6;
		end;
	}
	if ('twilight_story == 6) {
		cutin "ep162_est01",2;
		mes "[Est]";
		mes "准备出发时和 Almond 说话。";
		close3;
	}
	end;
}

1@bamn,199,275,5	script(DISABLED)	Almond#amond01	EP17_2_BETA_BASIC,{
	if ('twilight_story < 6) {
		cutin "ep172_beta",2;
		mes "[Almond]";
		mes "今天大家本来都应该在宅邸里。";
		mes "发生了重要的事情，所以我和 Est 来到了这里。";
		close3;
	}
	if ('twilight_story == 6) {
		'guide = getnpcid(0);
		'twilight_story = 7;
		npcspeed 200;
		npctalk "那么，我们走吧。";
		unitwalk 'guide,199,248, instance_npcname("Almond#amond01") + "::OnEvent00";
		enablenpc instance_npcname("Intruder#sweety02");
		end;
	}
	if ('twilight_story == 7)
		end;
	if ('twilight_story == 8) {
		'twilight_story = 9;
		unittalk getcharid(3), "" + strcharinfo(0) + "：追踪器：哔——！在那里！！";
		setpcblock PCBLOCK_NPC, true;
		navigateto("1@bamn",242,206);
		sleep2 2000;
		npctalk "啊哈哈哈，真吵。";
		sleep2 2000;
		npctalk "我有点好奇，我们要不要快点过去？";
		sleep2 2000;
		npctalk "客人，有入侵者！";
		donpcevent instance_npcname("twilight_story_mob_3") + "::OnStart";
		setpcblock PCBLOCK_NPC, false;
		sleep 200;
		npcspeed 80;
		unitwalk 'guide,245,229, instance_npcname("Almond#amond01") + "::OnEvent02";
		end;
	}
	if ('twilight_story == 10 || 'twilight_story == 11 || 'twilight_story == 12) {
		npctalk "小心！";
		end;
	}
	if ('twilight_story == 13) {
		'twilight_story = 14;
		npcspeed 200;
		setpcblock PCBLOCK_NPC, true;
		npctalk "我们去检查中继器吧。";
		sleep2 2000;
		setpcblock PCBLOCK_NPC, false;
		sleep2 1000;
		unitwalk 'guide,244,208, instance_npcname("Almond#amond01") + "::OnEvent04";
		end;
	}
	if ('twilight_story == 14)
		end;
	if ('twilight_story == 15) {
		'twilight_story = 16;
		setpcblock PCBLOCK_NPC, true;
		for ( .@i = 1; .@i < 5; ++.@i )
			enablenpc instance_npcname("Rebellion#md_rb0" + .@i);
		for ( .@i = 6; .@i < 9; ++.@i )
			enablenpc instance_npcname("Heart Hunter#md_hh0" + .@i);
		unittalk getcharid(3), "" + strcharinfo(0) + "：追踪器：咔咔咔咔咔咔！犯人就在附近！他们在我的雷达上！是那边！";
		navigateto("1@bamn",332,143);
		sleep2 2000;
		setpcblock PCBLOCK_NPC, false;
		sleep2 1000;
		npcspeed 80;
		npctalk "又有入侵者！难怪我开始兴奋起来了~！";
		unitwalk 'guide,332,169;
		end;
	}
	if ('twilight_story < 18)
		end;
	if ('twilight_story == 18) {
		npcspeed 200;
		'twilight_story = 19;
		npctalk "冒险者，你没事吧？那我们继续前进。";
		unitwalk 'guide,332,143, instance_npcname("Almond#amond01") + "::OnEvent11";
		end;
	}
	if ('twilight_story == 19)
		end;
	if ('twilight_story == 20) {
		npctalk "你不该和 Est 说说话吗？她好像一直在等。";
		end;
	}
	end;

OnEvent00:
	npctalk "这边。";
	sleep 1000;
	unitwalk 'guide,225,248, instance_npcname("Almond#amond01") + "::OnFollow00";
	end;
OnFollow00:
	unitwalk 'guide,245,248, instance_npcname("Almond#amond01") + "::OnEvent01";
	end;
OnEvent01:
	npctalk "我们去看看经常被黑客入侵的中继器。";
	sleep 2000;
	npctalk "嗯？你现在带着什么？拿出来给我看看。";
	'twilight_story = 8;
	end;

OnEvent02:
	npctalk "冒险者，有入侵者！";
	unitwalk 'guide,245,215, instance_npcname("Almond#amond01") + "::OnEvent03";
	end;
OnEvent03:
	'twilight_story = 10;
	end;

OnEvent04:
	npctalk "……正在检查信号。";
	sleep 2000;
	npctalk "……黑客频道检查完毕。";
	sleep 2000;
	npctalk "……正在恢复……";
	sleep 2000;
	npctalk "……正在恢复……84%";
	sleep 2000;
	npctalk "……恢复完成。";
	sleep 2000;
	npctalk "我们去中继器那里吧？";
	sleep 2000;
	unitwalk 'guide,245,204, instance_npcname("Almond#amond01") + "::OnEvent05";
	end;
OnEvent05:
	npctalk "冒险者，你喜欢杏仁吗？一位喜欢杏仁的客人给我取了这个名字。适合我吗？";
	sleep 3000;
	unitwalk 'guide,265,204, instance_npcname("Almond#amond01") + "::OnEvent06";
	end;
OnEvent06:
	npctalk "刚才那个孩子，我以前见过他。";
	unitwalk 'guide,285,204, instance_npcname("Almond#amond01") + "::OnEvent07";
	end;
OnEvent07:
	npctalk "但他总是跑得很快，这是我第一次好好看清他~";
	unitwalk 'guide,300,204, instance_npcname("Almond#amond01") + "::OnEvent08";
	end;
OnEvent08:
	npctalk "这里的火龙果很可爱~听说杏仁很好吃？你以前吃过杏仁吗？";
	sleep 2000;
	npctalk "这边。";
	unitwalk 'guide,300,190, instance_npcname("Almond#amond01") + "::OnEvent09";
	end;
OnEvent09:
	npctalk "已经很久没有这么放松过了~";
	unitwalk 'guide,327,189, instance_npcname("Almond#amond01") + "::OnEvent10";
	end;
OnEvent10:
	npctalk "冒险者，那个吵闹的东西又在闪烁吗？我们去检查一下吧。";
	'twilight_story = 15;
	end;

OnEvent11:
	npctalk "……正在检查信号。";
	sleep 2000;
	npctalk "……黑客频道检查完毕。";
	sleep 2000;
	npctalk "……正在恢复……";
	sleep 2000;
	npctalk "……正在恢复……72%";
	sleep 2000;
	npctalk "……恢复完成。";
	sleep 2000;
	npctalk "我们去下一个中继器吧~";
	sleep 2000;
	unitwalk 'guide,320,139, instance_npcname("Almond#amond01") + "::OnFollow12";
	end;
OnFollow12:
	unitwalk 'guide,300,139, instance_npcname("Almond#amond01") + "::OnEvent12";
	end;
OnEvent12:
	npctalk "是之前那个孩子，对吧？他是入侵者。真奇怪，有点像杏仁……";
	unitwalk 'guide,285,139, instance_npcname("Almond#amond01") + "::OnEvent13";
	end;
OnEvent13:
	npctalk "我们要不要快一点？那边传来了声音……";
	unitwalk 'guide,285,118, instance_npcname("Almond#amond01") + "::OnEvent14";
	end;
OnEvent14:
	npctalk "比我想象的更安静。入侵者去哪儿了？";
	unitwalk 'guide,285,98, instance_npcname("Almond#amond01") + "::OnEvent15";
	end;
OnEvent15:
	npctalk "这边。";
	unitwalk 'guide,261,98, instance_npcname("Almond#amond01") + "::OnEvent16";
	end;
OnEvent16:
	npcspeed 80;
	npctalk "是 Est！";
	'twilight_story = 20;
	unitwalk 'guide,261,87;
	end;
}


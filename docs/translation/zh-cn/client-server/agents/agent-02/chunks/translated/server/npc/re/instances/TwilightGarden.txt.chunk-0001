1@bamn,242,206,7	script(DISABLED)	Intruder#sweety02	4_EP17_SWEETY,{
	if ('twilight_story < 11) {
		npctalk "你们慢了一步！你们这群笨蛋！";
		end;
	}
	if ('twilight_story == 11) {
		'twilight_story = 12;
		npctalk "哈！你以为能抓住我吗？";
		sleep 2000;
		npctalk "去受苦吧！";
		sleep 500;
		disablenpc();
		donpcevent instance_npcname("twilight_story_mob_4") + "::OnStart";
		end;
	}
	end;
}


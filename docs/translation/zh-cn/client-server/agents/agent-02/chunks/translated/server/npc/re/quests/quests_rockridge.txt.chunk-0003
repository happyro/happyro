
har_in01,78,25,5	script	Egring#srdg01	4_DR_TORTEL,{
	setpcblock PCBLOCK_NPC, true;
	emotion ET_THROB;
	npctalk "今天什么时候吃饭？吃什么？豆子？", "", bc_self;
	sleep2 1000;
	npctalk "距离上次吃饭还不到30分钟！", "Harold#srdg01", bc_self;
	setpcblock PCBLOCK_NPC, false;
	end;
}

har_in01,89,26,5	script	Johnny James#har_in01	4_M_JOHNNYJAMES,{
	disable_items;
	if (checkweight(1301,3) == 0) {
		mes "- 你携带的物品太多，无法继续任务。-";
		close;
	}
	if (rock_main_quest < 8) {
		npctalk "你们这些卑鄙的混蛋，竟敢再次出现！下地狱去吧！", "", bc_self;
		end;
	}
	if (rock_main_quest == 8) {
		.@player_name$ = strcharinfo(0);

		setpcblock PCBLOCK_NPC, true;
		npctalk "你们这些卑鄙的混蛋，竟敢再次出现？下地狱去吧！", "", bc_self;
		sleep2 2000;
		cloakoffnpcself(  "Ivoka Skudi#har02" );
		setpcblock PCBLOCK_NPC, false;
		npctalk "啊，你最好对我们的未来市长尊重点。", "Ivoka Skudi#har02", bc_self;
		mes "[伊沃卡·斯库迪]";
		mes "我说过我能处理他。";
		mes "你没必要下来和他谈。";
		next;
		unittalk getcharid(3), "" + .@player_name$ + " : But the negotiation isn't over.", bc_self;
		mes "[伊沃卡·斯库迪]";
		mes "什么谈判？";
		mes "连他的副手都放弃他了。";
		mes "把他当人质也没有用。";
		next;
		npctalk "什么？你说的是阿尔伯特？", "", bc_self;
		mes "[伊沃卡·斯库迪]";
		mes "剩下唯一的办法就是吊死他，让其他人知道别再惹我们！";
		mes "未来市长先生。";
		next;
		mes "[伊沃卡·斯库迪]";
		mes "连治安官也同意我的看法。";
		mes "明天怎么样？还是后天？";
		mes "等等，今天更好。今天是吊死一头水牛的完美日子！";
		next;
		npctalk "吊什么水牛？等等，你说的是我吗？", "", bc_self;
		mes "[Johnny James]";
		mes "你一直在告诉我奇怪的事情。";
		mes "你想要什么？";
		next;
		select("阿尔伯特现在是你们帮派的新首领。" );
		mes "[Johnny James]";
		mes "你在说什么？！";
		mes "你以为我会相信你吗？";
		next;
		npctalk "但他丢下你，没有回来救你。", "Ivoka Skudi#har02", bc_self;
		select("他说会用100万 Zeny把矿石卖给我们。" );
		mes "[Johnny James]";
		mes "什么？阿尔伯特，那个笨蛋！";
		mes "你没撒谎吧？";
		mes "为什么告诉我这些？";
		next;
		select("这样你就能为惩罚做好准备。" );
		npctalk "没错。治安官很期待他被处决的那一天。哈哈哈！", "Ivoka Skudi#har02", bc_self;
		mes "[Johnny James]";
		mes "嘿，嘿！";
		mes "我没有机会离开这里吗？";
		mes "我要死在这里吗？";
		next;
		unittalk getcharid(3), "" + .@player_name$ + " : Actually, you have.", bc_self;
		mes "[" + .@player_name$ + "]";
		mes "阿尔伯特要我们为矿石付钱。";
		mes "但如果你告诉我们矿石在哪里，我们就不用付钱。";
		next;
		mes "[" + .@player_name$ + "]";
		mes "此外，我们也想要回矿井。和他交易让我们很不舒服。";
		mes "Johnny，如果你帮助我们，就能不花钱拿回矿石。";
		npctalk "你说得对，未来市长先生。你真聪明！", "Ivoka Skudi#har02", bc_self;
		next;
		mes "[" + .@player_name$ + "]";
		mes "如果你帮助我们，我们也会替你处理阿尔伯特。反正他妨碍我们拿回矿井。";
		mes "你觉得怎么样？";
		next;
		mes "[" + .@player_name$ + "]";
		mes "先说好，这个提议不会一直有效。";
		mes "希望你做出正确的决定。";
		next;
		npctalk "...", "", bc_self;
		select("别再看窗外了。" );
		mes "[伊沃卡·斯库迪]";
		mes "是的，我们知道那个间谍。";
		mes "他来这里是为了看你什么时候被吊死。";
		next;
		mes "[伊沃卡·斯库迪]";
		mes "如果他来这里是为了救你，应该会试着隔着牢门和你说话，对吧？";
		mes "如果我是他，我会试着给你递张纸条。";
		next;
		mes "[伊沃卡·斯库迪]";
		mes "他给过你纸条吗？";
		mes "至少给你存过囚犯账户吗？";
		npctalk "...", "", bc_self;
		sleep2 2000;
		next;
		npctalk "这样吧。", "", bc_self;
		mes "[Johnny James]";
		mes "我会告诉你矿石在哪里，";
		mes "前提是你放我走。";
		mes "还有一个条件。";
		next;
		select("继续说。" );
		mes "[Johnny James]";
		mes "……你能处理那个叛徒阿尔伯特吗？";
		mes "我会告诉你把他从藏身处叫出来的口令。";
		next;
		mes "[Johnny James]";
		mes "^4d4dff敲击矿井前的凹石三次，^000000阿尔伯特就会出来。";
		mes "这样你就能处理他。";
		next;
		mes "[Johnny James]";
		mes "把^4d4dff他的鬃毛^000000带回来作为证明。";
		mes "等我离开这里时，如果阿尔伯特还活着，我就无法回到帮派。";
		mes "我要他消失。";
		next;
		mes "[Johnny James]";
		mes "之后我会告诉你矿石在哪里。";
		next;
		select("成交。" );
		mes "[Johnny James]";
		mes "……该死！";
		mes "在拿到^4d4dff阿尔伯特的鬃毛^000000给我看之前别回来，明白吗？";
		mes "现在滚出去！";
		rock_main_quest = 9;
		erasequest 7797;
		setquest 7798;// Perfectly Prime
		close;
	}
	if (rock_main_quest < 14) {
		mes "[Johnny James]";
		mes "在拿到^4d4dff阿尔伯特的鬃毛^000000给我看之前别回来，明白吗？";
		mes "现在滚出去！";
		close;
	}
	if (rock_main_quest == 14) {
		if (countitem(25249) < 1) {
			mes "[Johnny James]";
			mes "把那个混蛋的鬃毛带给我！";
			close;
		}
		mes "[Johnny James]";
		mes "那个狡猾的混蛋，他背叛了我！";
		mes "他喝醉时总说自己会比我活得更久。";
		next;
		mes "[Johnny James]";
		mes "他窗外的间谍甚至用手指像枪一样指着我！";
		mes "阿尔伯特怎么样？";
		next;
		select("给他看阿尔伯特的鬃毛。" );
		mes "[Johnny James]";
		mes "……你确定他死了吗？";
		mes "因为他的间谍刚才用手指像枪一样指着我。";
		next;
		select("他大概还没听说。" );
		mes "[Johnny James]";
		mes "……也许你说得对。你处理完他就来这里了吗？";
		mes "所以他的间谍还不知道他死了。";
		next;
		mes "[Johnny James]";
		mes "好吧，这就说得通了。";
		mes "我出去后会把那家伙送到地狱和阿尔伯特团聚。";
		mes "*Chuckle*";
		next;
		mes "[Johnny James]";
		mes "那个叛徒以为自己会比我活得久。";
		mes "看看现在是谁还在呼吸！";
		next;
		mes "[Johnny James]";
		mes "好吧，我告诉你矿石在哪里。";
		mes "它们在^4d4dff矿井二层电梯下方^000000。";
		mes "我们弄坏了电梯，就能把矿石藏在下面。";
		next;
		mes "[Johnny James]";
		mes "你们这些弱者得很多人一起才能抬起电梯。";
		mes "祝你好运。";
		mes "别忘了告诉治安官我配合了。";
		rock_main_quest = 15;
		delitem 25249,1;// Mane_Of_Cow
		erasequest 7803;// Happy for Broken Trust
		setquest 7804;// Location of the Ores
		close;
	}
	if (rock_main_quest == 15) {
		mes "[Johnny James]";
		mes "可恶，等我离开这里……";
		mes "（轻笑）我会让你为羞辱我付出代价。";
		close;
	}
	mes "[Johnny James]";
	mes "怎么花了这么久？";
	mes "我不喜欢等待。";
	close;

OnInit:
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "rock_main_quest == 8 || rock_main_quest == 14" );
	end;
}

har_in01,88,22,6	script	Ivoka Skudi#har02	4_M_EVOKASCUDI,{
	if (rock_main_quest == 9) {
		mes "[伊沃卡·斯库迪]";
		mes "（低声）他比我想象的还要头脑简单。我们去向警长报告吧。";
		close2;
		cloakonnpcself( "Ivoka Skudi#har02" );
		end;
	}
	end;
OnInit:
	cloakonnpc();
	end;
}

// Fild 1
rockrdg1,160,306,3	duplicate(dummy_cloaked_npc)	Johnny James#revt04	4_M_JOHNNYJAMES
rockrdg1,168,306,3	duplicate(dummy_cloaked_npc)	Albert Ford#revt08	4_M_ALBERTFORD
rockrdg1,156,302,7	duplicate(dummy_cloaked_npc)	Ivoka Skudi#revt02	4_M_EVOKASCUDI
rockrdg1,156,306,5	duplicate(dummy_cloaked_npc)	Cactus Gunslinger#revt05	4_M_EVOKASCUDI
rockrdg1,161,302,1	duplicate(dummy_cloaked_npc)	Cactus Gunslinger#revt06	4_M_EVOKASCUDI
rockrdg1,164,306,3	duplicate(dummy_cloaked_npc)	Cactus Gunslinger#revt07	4_M_EVOKASCUDI

rockrdg1,156,312,3	script	Unmoving Freight Train#	4_ENERGY_RED,{
	if (rock_main_quest == 5) {
		setpcblock PCBLOCK_NPC, true;
		unittalk getcharid(3), "" + strcharinfo(0) + " : I think this is the place, but maybe I came too early.", bc_self;
		sleep2 2000;
		cloakoffnpcself( "Johnny James#revt04" );
		sleep2 1000;
		emotion ET_QUESTION, getnpcid(0,"Johnny James#revt04");
		npctalk "这是谁？你不是我期待的人。", "Johnny James#revt04", bc_self;
		sleep2 1000;
		cloakoffnpcself( "Albert Ford#revt08" );
		npctalk "嘿，老大，我说过别丢下我自己走。", "Albert Ford#revt08", bc_self;
		sleep2 2000;
		npctalk "嗯？我不记得科斯特洛长这样。", "Albert Ford#revt08", bc_self;
		sleep2 2500;
		npctalk "嘿，我正在进行重要会面。滚开！", "Johnny James#revt04", bc_self;
		sleep2 2000;
		cloakoffnpcself( "Wyatt Warp#revt03" );
		sleep2 1000;
		npctalk "Johnny James？你不该对长官这么无礼。", "Wyatt Warp#revt03", bc_self;
		sleep2 2500;
		npctalk "啊，治安官来了。你带着谁？我说过想和市长谈。", "Johnny James#revt04", bc_self;
		sleep2 2500;
		npctalk "你不想要回矿石和矿井吗？嗯？", "Johnny James#revt04", bc_self;
		if (select( "我是总部派来的。", "我是市长。" ) == 1)
			unittalk getcharid(3), "" + strcharinfo(0) + " : I came all the way from Headquarters for this meeting.", bc_self;
		else
			unittalk getcharid(3), "" + strcharinfo(0) + " : You don't keep up with the news, do you? I'm the mayor now.", bc_self;
		sleep2 2000;
		npctalk "是的。你得和他谈，不是和科斯特洛谈。", "Wyatt Warp#revt03", bc_self;
		sleep2 2500;
		emotion ET_AHA, getnpcid(0,"Johnny James#revt04");
		npctalk "所以传闻是真的：科斯特洛终于滚蛋了，嗯？哇哈哈哈！", "Johnny James#revt04", bc_self;
		sleep2 3000;
		emotion ET_THINK, getnpcid(0,"Albert Ford#revt08");
		npctalk "这些人可能在撒谎。", "Albert Ford#revt08", bc_self;
		sleep2 3000;
		npctalk "撒谎对我们有什么好处？我们才是求人的一方。现在告诉我们你想要什么。", "Wyatt Warp#revt03", bc_self;
		sleep2 3000;
		npctalk "这样他就能带着你的要求回总部。", "Wyatt Warp#revt03", bc_self;
		sleep2 2500;
		npctalk "（哼）你是敌人，但我欣赏你的直率。我们想要什么？", "Johnny James#revt04", bc_self;
		sleep2 3000;
		npctalk "好，够了。", "Wyatt Warp#revt03", bc_self;
		sleep2 300;
		npctalk "什么？我还没开始呢？", "Johnny James#revt04", bc_self;
		sleep2 500;
		specialeffect 563, AREA, "Johnny James#revt04";
		cloakoffnpcself( "Cactus Gunslinger#revt05" );
		cloakoffnpcself( "Cactus Gunslinger#revt06" );
		cloakoffnpcself( "Cactus Gunslinger#revt07" );
		cloakoffnpcself( "Ivoka Skudi#revt02" );
		npctalk "不许动！", "Ivoka Skudi#revt02", bc_self;
		sleep2 1000;
		specialeffect 453, AREA, "Johnny James#revt04";
		npctalk "不许动！", "Cactus Gunslinger#revt05", bc_self;
		npctalk "你们被包围了，", "Cactus Gunslinger#revt06", bc_self;
		npctalk "水牛们！", "Cactus Gunslinger#revt07", bc_self;
		npctalk "这、这到底是怎么回事？", "Johnny James#revt04", bc_self;
		sleep2 2000;
		npctalk "老大！老大！", "Albert Ford#revt08", bc_self;
		sleep2 2000;
		specialeffect 563, AREA, "Johnny James#revt04";
		npctalk "水牛们！", "Cactus Gunslinger#revt05", bc_self;
		npctalk "水牛们！", "Cactus Gunslinger#revt06", bc_self;
		npctalk "水牛们！", "Cactus Gunslinger#revt07", bc_self;
		sleep2 2000;
		npctalk "（轻笑）", "Wyatt Warp#revt03", bc_self;
		npctalk "一切都按我们的计划进行！", "Ivoka Skudi#revt02", bc_self;
		sleep2 2000;
		npctalk "该死的仙人掌！你们伪装成了植物！", "Johnny James#revt04", bc_self;
		sleep2 3000;
		npctalk "阿尔伯特，别傻看着，做点什么！", "Johnny James#revt04", bc_self;
		sleep2 2000;
		npctalk "我、我去带帮派的其他人来！", "Albert Ford#revt08", bc_self;
		sleep2 1000;
		npctalk "什么？", "Johnny James#revt04", bc_self;
		cloakonnpcself( "Albert Ford#revt08" );
		sleep2 1000;
		npctalk "阿尔伯特！", "Johnny James#revt04", bc_self;
		sleep2 2000;
		npctalk "嘿，Johnny，你的朋友丢下你了。", "Wyatt Warp#revt03", bc_self;
		npctalk "他跑去保命了。（轻笑）", "Ivoka Skudi#revt02", bc_self;
		sleep2 3000;
		npctalk "伊沃卡，还有我们的仙人掌朋友，你们做得很好！现在可以把他带走了。", "Wyatt Warp#revt03", bc_self;
		sleep2 1000;
		npctalk "走吧！", "Cactus Gunslinger#revt05", bc_self;
		npctalk "你现在落到我们手里了！", "Cactus Gunslinger#revt06", bc_self;
		npctalk "别抵抗！", "Cactus Gunslinger#revt07", bc_self;
		sleep2 1000;
		npctalk "哼，你们不想要回矿石吗？！", "Johnny James#revt04", bc_self;
		sleep2 1000;
		npctalk "谁在乎矿石？", "Cactus Gunslinger#revt05", bc_self;
		sleep2 1000;
		npctalk "我们的工作是把你带走！", "Cactus Gunslinger#revt06", bc_self;
		sleep2 1000;
		npctalk "闭嘴，不然我就把戒指穿过你的鼻子！", "Cactus Gunslinger#revt07", bc_self;
		sleep2 1000;
		npctalk "伙计们，走吧！", "Ivoka Skudi#revt02", bc_self;
		sleep2 2000;
		cloakonnpcself( "Cactus Gunslinger#revt05" );
		cloakonnpcself( "Cactus Gunslinger#revt06" );
		cloakonnpcself( "Cactus Gunslinger#revt07" );
		cloakonnpcself( "Ivoka Skudi#revt02" );
		cloakonnpcself( "Johnny James#revt04" );
		sleep2 2000;
		npctalk "我们回去吧，好吗？", "Wyatt Warp#revt03", bc_self;
		rock_main_quest = 6;
		erasequest 7795;
		setquest 7796;// Unexpected Arrest
		setpcblock PCBLOCK_NPC, false;
		end;
	}
	mes "它毫无价值，而且已经被废弃。";
	close;

OnInit:
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "rock_main_quest == 5" );
	end;
}

rockrdg1,153,303,5	script	Wyatt Warp#revt03	4_M_YATTWARP,{
	if (rock_main_quest == 6) {
		mes "[Wyatt Warp]";
		mes "伊沃卡的计划完美成功了。";
		mes "而且成功的原因是他和朋友们都是仙人掌。";
		next;
		mes "[Wyatt Warp]";
		mes "如果科斯特洛和我们在一起，计划可能不会成功。";
		mes "你作为陌生人的身份，比我们想象中更有效地分散了他们的注意力。";
		next;
		mes "[Wyatt Warp]";
		mes "现在我们可以和强盗平等谈判了。";
		mes "谁知道呢？我们可以用 Johnny 交换被偷的矿石。";
		next;
		mes "[Wyatt Warp]";
		mes "回我的办公室吧。";
		close2;
		cloakonnpcself( "Wyatt Warp#revt03" );
		end;
	}
	end;
OnInit:
	cloakonnpc();
	end;
}

harboro1,288,193,5	script	Shawn McCurdy#harboro1	4_M_SEANMCCURDY,{
	if (rock_main_quest < 10) {
		mes "[肖恩·麦卡迪]";
		mes "我担心我们矿工很长时间都无法工作，";
		mes "我们承受不起这种情况。";
		mes "这是因为强盗，对吧？";
		close;
	}
	if (rock_main_quest == 10) {
		mes "[肖恩·麦卡迪]";
		mes "哦，你就是听说可能成为我们新市长的冒险者？";
		mes "很高兴见到你！我叫肖恩·麦卡迪，是矿井的工头。";
		mes "叫我肖恩就好。";
		next;
		mes "[肖恩·麦卡迪]";
		mes "沃普治安官都告诉你了，对吧？";
		mes "我听说你一直忙于和强盗谈判。";
		next;
		mes "[肖恩·麦卡迪]";
		mes "这也和矿井有关，对吧？";
		mes "我可能有一种能用来对付他们其中一人的武器——阿尔伯特·福特。";
		next;
		select("那是什么？" );
		mes "[肖恩·麦卡迪]";
		mes "未加工的矿石。就像强盗从我们这里偷走的那些。";
		mes "这些矿石不加工就毫无价值，";
		next;
		mes "[肖恩·麦卡迪]";
		mes "就像钻石一样。";
		mes "换句话说，这些矿石对强盗没有用。";
		next;
		mes "[肖恩·麦卡迪]";
		mes "他们偷走的矿石相当于三个月的工作量。";
		mes "这其实不算多，和大多数人的想象相反。";
		next;
		mes "[肖恩·麦卡迪]";
		mes "矿井里原本只有一层，";
		mes "但最近我们在下方挖出了另一层。";
		mes "那一层埋藏着大量矿石，所以产量是第一层的好几倍。";
		next;
		mes "[肖恩·麦卡迪]";

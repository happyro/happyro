		next;
		mes "[Red Leopard Joe]";
		mes "多亏了你的帮助，";
		mes "我现在有了";
		mes "制作苦无所需的矿石！";
		mes "哈哈哈！既然我占据优势，就不会同意休战！";
		next;
		mes "[Red Leopard Joe]";
		mes "总之，让我写下";
		mes "给他的回复。我也会";
		mes "给你我的建议……";
		mes "我觉得即使刚才被我骗了，";
		mes "你也会成为非常出色的";
		mes "忍者。嘿嘿嘿！";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "……";
		mes "………";
		mes "………………";
		next;
		mes "[Red Leopard Joe]";
		mes "给你。";
		mes "请把这封";
		mes "信带给Kuuga Gai。";
		mes "回到天津町还要一段时间，";
		mes "所以让我直接把你";
		mes "送到那里吧……";
		delitem 1010,1;	// Phracon
		delitem 7053,5;	// Cyfar
		set NINJ_Q,3;
		changequest 6016,6017;
		close2;
		warp "amatsu",113,127;
		end;
	}
	else if (NINJ_Q == 3) {
		mes "[Red Leopard Joe]";
		mes "嗯？我不太清楚发生了什么，";
		mes "但看来你还没有";
		mes "把我的回复交给Kuuga Gai。";
		mes "你还没有把回复交给他。";
		mes "要我现在直接把你";
		mes "送到天津町吗？";
		next;
		if(select("不用了，谢谢。:好的，请送我过去。") == 1) {
			mes "[Red Leopard Joe]";
			mes "好吧。我只是";
			mes "想帮你节省一些时间。";
			mes "希望你一路顺利。";
			close;
		}
		mes "[Red Leopard Joe]";
		mes "好的。";
		mes "暂时再见。";
		close2;
		warp "amatsu",113,127;
		end;
	}
	else if (NINJ_Q == 4) {
		mes "[Red Leopard Joe]";
		mes "Kuuga Gai 也让你";
		mes "收集一些材料吗？算了，我想";
		mes "也不能怪他。";
		mes "毕竟我也能理解。";
		mes "而且，堂堂正正战斗的话";
		mes "我应该能打败他～";
		close;
	}
	else if (NINJ_Q == 5 && BaseClass == Job_Ninja) {
		mes "[Red Leopard Joe]";
		mes "哦，你是忍者～";
		mes "希望你继续";
		mes "锻炼自己，掌握";
		mes "所有能学会的忍者技能。";
		mes "尽可能掌握所有忍术。";
		mes "永远记住要融入阴影。";
		close;
	}
	else {
		mes "[Tourist]";
		mes "我去过许多";
		mes "国家，但从没见过";
		mes "像艾音布罗克塔这么高的建筑。";
		mes "那座塔真是太高了。";
		mes "我家乡的所有建筑";
		mes "相比之下都小得多……";
		close;
	}
}

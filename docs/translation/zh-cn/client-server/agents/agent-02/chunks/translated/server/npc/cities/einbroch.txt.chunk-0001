einbroch,218,198,5	script	Mark#ein	855,{
	.@npc_name$ = strnpcinfo(1);
	mes "["+ .@npc_name$ +"]";
	mes "你好～";
	mes "我是"+ .@npc_name$ +"，";
	mes "负责带你参观";
	mes "艾音布罗克塔。";
	next;
	mes "["+ .@npc_name$ +"]";
	mes "艾音布罗克塔能欣赏";
	mes "城市最美的景色，";
	mes "也是和朋友见面或约会的好地方。";
	mes "参观艾音布罗克塔";
	mes "需要支付 10 Zeny。";
	mes "欢迎前来参观。";
	next;
	mes "["+ .@npc_name$ +"]";
	mes "现在我们正在推出特别优惠：";
	mes "苹果组合套装只需 20 Zeny。";
	mes "套装包含艾音布罗克塔门票";
	mes "以及一个可以当零食的苹果。";
	mes "非常划算哦。";
	mes "要购买吗？";
	next;
	switch(select("Tower Admission Only:Apple Combo Set:Cancel")) {
	case 1:
		if (Zeny < 10) {
			mes "["+ .@npc_name$ +"]";
			mes "抱歉，你的 Zeny 不够。";
			mes "艾音布罗克塔门票";
			mes "需要支付 10 Zeny。";
			mes "请准备好费用后再来。";
			mes "谢谢。";
			close;
		}
		else {
			mes "["+ .@npc_name$ +"]";
			mes "谢谢你使用我们的服务。";
			mes "我现在就带你前往";
			mes "艾音布罗克塔。";
			mes "请跟紧我。";
			set Zeny, Zeny-10;
			close2;
			warp "einbroch",181,196;
			end;
		}
	case 2:
		if (Zeny < 20) {
			mes "["+ .@npc_name$ +"]";
			mes "抱歉，你的 Zeny 不够。";
			mes "苹果组合套装需要 20 Zeny。";
			mes "请准备好费用后再来。";
			close;
		}
		else {
			mes "["+ .@npc_name$ +"]";
		mes "在带你前往塔顶之前，";
		mes "让我先检查你的状态，";
		mes "确认安全后再交给你";
		mes "苹果组合套装。";
		mes "请稍等片刻。";
			next;
			if (checkweight(512,1)) {
				mes "["+ .@npc_name$ +"]";
				mes "谢谢你使用我们的服务。";
				mes "我现在就带你前往";
				mes "艾音布罗克塔。";
				mes "请跟紧我。";
				set Zeny, Zeny-20;
				getitem 512,1; //Apple
				close2;
				warp "einbroch",174,204;
				end;
			}
			else {
				mes "["+ .@npc_name$ +"]";
				mes "抱歉，你携带的物品太多了。";
				mes "请先把部分物品存入卡普拉仓库，";
				mes "再购买苹果组合套装。";
				close;
			}
		}
	case 3:
		mes "["+ .@npc_name$ +"]";
	mes "我明白了。";
	mes "欢迎你随时";
	mes "再次前来。";
	mes "谢谢。";
		close;
	}
}

einbroch,175,196,5	script	Morei#ein	854,{
	mes "[Morei]";
	mes "你好，";
	mes "我是莫雷，";
	mes "艾音布罗克塔的";
	mes "助理导游。";
	next;
	mes "[Morei]";
	mes "如果你想回到一楼，";
	mes "请告诉我。";
	mes "你想回到";
	mes "地面层吗？";
	mes "我可以带你下去。";
	next;
	switch(select("是。:否。")) {
	case 1:
		mes "[Morei]";
		mes "我明白了。";
		mes "让我带你回到一楼。";
		mes "谢谢你使用";
		mes "我们的服务。";
		mes "请慢走。";
		close2;
		switch(rand(1,3)) {
		case 1:
			warp "einbroch",170,229;
			end;
		case 2:
			warp "einbroch",216,188;
			end;
		case 3:
			warp "einbroch",178,167;
			end;
		}
	case 2:
		mes "[Morei]";
		mes "我明白了。";
		mes "希望你在";
		mes "艾音布罗克塔";
		mes "度过愉快时光。";
		close;
	}
}

einbroch,173,229,5	duplicate(Mark#ein)	Oberu#ein	855
einbroch,176,172,5	duplicate(Mark#ein)	Khemko#ein	855

einbroch,232,272,3	script	Train Station Staff#ein1::EinbrochTrain	852,{
	mes "[Staff]";
	mes "欢迎来到";
	mes "火车站。";
	mes "前往艾音贝赫的列车";
	mes "一直在运行，";
	mes "错过一班也不用担心。";
	mes "很快就会有下一班。";
	next;
	mes "[Staff]";
	mes "乘坐艾音布罗克至艾音贝赫线路的列车";
	mes "需要支付 200 Zeny。";
	mes "你想买票吗？";
	mes "请确认你的选择。";
	next;
	switch(select("Yes.:No.:About the Environment...")) {
	case 1:
		if (Zeny > 199) {
			mes "[Staff]";
			mes "非常感谢。";
			mes "祝你旅途平安。";
			mes "请注意安全。";
			mes "^333333*Ahem*^000000 All aboard!";
			close2;
			set Zeny, Zeny-200;
			warp "einbech",43,215;
			end;
		}
		else {
			mes "[Staff]";
			mes "抱歉，这些 Zeny";
			mes "不足以支付";
			mes "火车票价。";
			close;
		}
	case 2:
		mes "[Staff]";
		mes "好的。";
		mes "希望你在艾音布罗克";
		mes "度过愉快时光。";
		close;
	case 3:
		mes "[Staff]";
		mes "艾音布罗克因空气污染而臭名昭著，";
		mes "这无疑是这里的工业设施";
		mes "造成的。";
		mes "真是太糟糕了……";
		mes "请注意防护。";
		next;
		mes "[Staff]";
		mes "有时空气污染严重到";
		mes "让人难以呼吸。";
		mes "如果听到艾音布罗克烟雾警报，";
		mes "请立即寻找避难处！";
		mes "不要在外面逗留。";
		close;
	}
}

einbroch,252,301,3	duplicate(EinbrochTrain)	Train Station Staff#ein2	852

einbroch,259,326,3	script	Leslie#ein_1	846,{
	mes "[Leslie]";
	mes "^666666*Cough cough!*^000000";
	mes "哎呀，真是的！";
	next;
	mes "[Leslie]";
	mes "像我这样的老太婆";
	mes "根本无法呼吸这里的空气！";
	mes "人们怎么能在这种烟雾里生活？";
	mes "艾音贝赫的空气确实不算清新，";
	mes "但艾音布罗克这里更糟！^333333*咳～！*^000000";
	next;
	mes "[Leslie]";
	mes "我有时真讨厌来这里！";
	mes "空气完全被污染了，";
	mes "这座城市还有很多傲慢的家伙！";
	mes "不过这里卖的东西";
	mes "是我在家乡买不到的……";
	mes "所以还是得来一趟。";
	close;
}

einbroch,236,191,3	script	Tan#ein	855,{
	mes "[Tan]";
	mes "艾音布罗克的所有工厂";
	mes "都造成了严重的";
	mes "空气污染问题。";
	mes "必须尽快解决。";
	next;
	mes "[Tan]";
	mes "我是飞艇工程师，";
	mes "每天都要处理油污和各种污染物。";
	mes "我居然还没生病，";
	mes "自己都觉得惊讶……";
	mes "工作真的很辛苦。";
	next;
	mes "[Tan]";
	mes "不过我还是会尽量小心。";
	mes "每当走进城市的红雾，";
	mes "我都会戴上防毒面具。";
	mes "如果你要在这里待一阵子，";
	mes "也应该随身带一个。";
	mes "保护好自己。";
	close;
}

einbroch,228,121,5	script	Little Toby#ein-1	855,{
	mes "[Little Toby]";
	mes "不好意思……";
	mes "我迷路了！";
	mes "我找不到";
	mes "爸爸妈妈了！";
	next;
	mes "[Little Toby]";
	mes "这、这里是机场吗？！";
	mes "爸爸妈妈应该来接我，";
	mes "可是我还没找到他们！";
	mes "我们刚搬到这里，";
	mes "我完全不知道这里的路！";
	mes "你能帮帮我吗？";
	next;
	mes "[Little Toby]";
	mes "等、等等！";
	mes "你要去哪里？！";
	mes "不要丢下我，";
	mes "我一个人好害怕……！";
	close;
}

einbroch,40,116,1	script	Airship Engineer#ein-1	855,{
	mes "[Airship Engineer]";
	mes "喂！别碰我珍贵的";
	mes "布里艾尔！我刚给她调试完，";
	mes "她现在正在睡觉！";
	mes "请、请离她远一点！";
	mes "她需要好好休息。";
	next;
	switch(select("布里艾尔是谁？:抱歉。")) {
	case 1:
		mes "[Airship Engineer]";
		mes "布里艾尔是过去十年里";
		mes "所有飞艇中最漂亮的型号！";
		mes "她现在可能停飞了，";
		mes "但在我的修复之手下，";
		mes "她一定会再次征服天空！";
		mes "请相信我。";
		next;
		switch(select("啊～:嗯……")) {
		case 1:
			mes "["+strcharinfo(0)+"]";
			mes "啊～";
			mes "原来你是在修复";
			mes "这艘壮丽的飞艇。";
			mes "祝你好运～";
			mes "希望一切顺利。";
			next;
			mes "[Airship Engineer]";
			mes "是的。请你小心一点，";
			mes "我会非常感激。";
			mes "我倾注了很多心血";
			mes "来修复布里艾尔……";
			close;
		case 2:
			mes "["+strcharinfo(0)+"]";
			mes "嗯……";
			mes "刚才那一瞬间，";
			mes "我还以为你在说一个人，";
			mes "但后来觉得你应该不是疯子。";
			mes "至少我是这么想的。";
			mes "希望我没理解错。";
			next;
			mes "["+strcharinfo(0)+"]";
			mes "哦，你说的是";
			mes "‘最漂亮的型号’？";
			mes "在我看来所有飞艇都一样，";
			mes "这艘也没什么特别。";
			mes "你真是疯了，老兄。";
			mes "别再胡思乱想了。";
			next;
			emotion ET_FRET;
			mes "[Airship Engineer]";
		mes "什、什么……？！";
			close;
		}
	case 2:
		mes "[Airship Engineer]";
		mes "至少你知道自己做错了什么。";
		mes "现在别再打扰她，快走吧！";
		mes "让她好好休息。";
		close;
	}
}

einbroch,294,312,3	script	Centzu#ein	854,{
	mes "[Centzu]";
	mes "我在这里住了很久，";
	mes "看着这座巨大的城市";
	mes "每天都在继续扩张。";
	mes "变化真大。";
	next;
	mes "[Centzu]";
	mes "艾音布罗克怎么这么快就";
	mes "变得这么大？我仍然不敢相信";
	mes "这里发展到了这种程度。";
	mes "不过这和我无关，";
	mes "我做什么也改变不了什么……";
	mes "只能顺其自然了。";
	next;
	mes "[Centzu]";
	mes "虽然如此快速的工业化";
	mes "对环境和人们都没有好处，";
	mes "但我还是会坐下来观察变化，";
	mes "好好享受自己的生活……";
	mes "希望一切最终会变好。";
	mes "至少我会这样期待。";
	close;
}

einbroch,232,255,5	script	Khowropher#ein	847,{
	mes "[Khowropher]";
	mes "^666666*咳咳*^000000";
	mes "天哪！这里的空气";
	mes "又厚又脏！";
	mes "对我们这些有呼吸问题的";
	mes "老人来说更糟！^333333*咳！*^000000";
	mes "真让人难受。";
	next;
	mes "[Khowropher]";
	mes "他们继续在城里建工厂和住宅，";
	mes "我也管不了。";
	mes "不过我希望余生能住在";
	mes "安静、空气清新的地方……";
	mes "那样就足够了。";
	mes "希望这愿望能实现。";
	next;
	mes "[Khowropher]";
	mes "不过，艾音布罗克是我的故乡，";
	mes "我不能说走就走。";
	mes "也许这就是我的命运，";
	mes "直到死去都要忍受污浊的空气。^666666*叹气……*^000000";
	close;
}

einbroch,143,109,5	script	Khetine#ein	855,{
	mes "[Khetine]";
	mes "最近有人在谈论市中心那栋空建筑，";
	mes "据说它被改造成了";
	mes "某种神秘设施。";
	mes "不知道里面到底有什么。";
	mes "听起来很可疑。";
	next;
	mes "[Khetine]";
	mes "一切看起来都很可疑，";
	mes "但这不是我该知道的事。";
	mes "只要不影响到我，";
	mes "我又何必担心呢？";
	mes "还是少管闲事吧。";
	mes "保持距离比较好。";
	close;
}

einbroch,229,149,3	script	Sleik#ein	854,{
	mes "[Sleik]";
	mes "令人惊讶的是，我们有一座火车站，";
	mes "大家都称它为科学的胜利。";
	mes "不过，我们不是更应该";
	mes "为飞艇感到惊叹吗？";
	mes "它看起来更加神奇。";
	next;
	mes "[Sleik]";
	mes "如果你想知道火车到底开往哪里，";
	mes "我也无法告诉你。";
	mes "毕竟我从没坐过。";
	mes "不过，拥有自己的火车站";
	mes "应该还是件好事。";
	mes "至少交通方便了。";
	close;
}

airport,174,41,6	script	Young Man#air	99,{
	mes "[Runnan]";
	mes "……所以我才会";
	mes "环游世界。我的老板们";
	mes "很擅长发现最奇特的商品，";
	mes "我负责收集并完成配送。";
	mes "工作虽然辛苦但很有趣。";
	mes "总能见识新东西。";
	next;
	mes "[Runnan]";
	mes "有一次他们还让我收集";
	mes "果冻块，虽然那东西现在很常见。";
	mes "现在想想，他们为什么";
	mes "需要那么多材料呢？";
	mes "真是令人费解。";
	mes "也许有特殊用途吧。";
	close;
}

airport,176,41,4	script	Old Man#air	88,{
	mes "[Zhen Lan]";
	mes "我听说这里的怪物";
	mes "身上带着一种矿石，";
	mes "会闪耀出极其美丽的光芒。";
	mes "很漂亮，对吧？";
	mes "我也想找一些。";
	next;
	mes "[Zhen Lan]";
	mes "这些矿石很适合用来制作花瓶。";
	mes "我的朋友是一名人偶制作师，";
	mes "他告诉我这些矿石的用途。";
	mes "他会用各种材料制作人偶。";
	mes "手艺非常精湛。";
	next;
	mes "[Zhen Lan]";
	mes "他用晒黑的皮革制作身体，";
	mes "塞入鸟羽毛，";
	mes "再用赛法或扎贡制作眼睛。";
	mes "甚至会在底部放一块果冻块来保持平衡。";
	mes "真是巧妙。";
	next;
	mes "[Zhen Lan]";
	mes "这说明看似没用的东西";
	mes "其实也可能派上用场。";
	mes "所以别担心物品太多。";
	mes "迟早会有人需要它们。";
	close;

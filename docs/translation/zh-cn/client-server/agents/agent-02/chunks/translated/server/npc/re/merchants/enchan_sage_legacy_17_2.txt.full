ba_in01,87,376,3	script	Cube Lane#ep172cube	4_EP17_GUARD_B,{
	mes "[Cube Lane]";
	mes "我们提供强化方块，可以立即将你的 ^0000CD+4^000000 幻象和自动装备精炼到 ^FF0000+7^000000！";
	mes "瓦尔蒙特无疑是世界上最棒的人！";
	close2;
	callshop "ep172cubeshop00";
	end;
}


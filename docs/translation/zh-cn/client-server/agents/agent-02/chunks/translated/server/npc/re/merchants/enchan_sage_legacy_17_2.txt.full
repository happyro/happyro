//= Equipment Shop
ba_in01,87,383,3	script	Yeoncheong#equipment_exchange	4_EP17_CLEANER_W,{
	if (checkweight(1201,3) == 0) {
		cutin "ep172_omega.bmp",2;
		mes "[Yeoncheong]";
	mes "背包已满。再次交谈前请检查携带物品的重量和数量。";
		close3;
	}
	disable_items;
	cutin "ep172_omega",2;
	mes "[Yeoncheong]";
	mes "我们接受巴尔米尔票，将幻象装备升级为自动装备。";
	mes "你想交换什么？";
	next;
	switch( select( "交换说明", "自动装备交换", "自动饰品交换", "退出" ) ) {
	case 1:
		mes "[Yeoncheong]";
	mes "你可以用^0000CD+9 幻象铠甲、引擎或腿部装备和 900 张巴尔米尔票^000000交换^FF0000自动铠甲、引擎或腿部装备^000000。";
		next;
		mes "[Yeoncheong]";
	mes "^FF0000自动饰品^000000可以用^0000CD幻象饰品和 1500 张巴尔米尔票^000000交换。";
		next;
		mes "[Yeoncheong]";
	mes "要交换的装备必须在库存中，然后和我交谈。";
	mes "^FF0000请只带一件要交换的装备再继续。^000000";
		close3;
	case 2:
		.@shop$ = "barter_auto_equip_1";
		break;
	case 3:
		.@shop$ = "barter_auto_equip_2";
		break;
	case 4:
		mes "[Yeoncheong]";
	mes "祝你今天愉快，亲爱的客人~";
		close3;
	}
	mes "[Yeoncheong]";
	mes "^FF0000请只带一件要交换的装备再继续。^000000";
	mes "如果库存中有多件符合条件的装备，将随机进行交换。";
	close2;
	cutin "",255;
	callshop .@shop$;
	end;
}

//= Device Module Exchange
ba_in01,87,380,3	script	Yecheon#ep172module_trader	4_EP17_CLEANER_W,{
	if (checkweight(1201,3) == 0) {
		cutin "ep172_omega",2;
		mes "[Yecheon]";
	mes "背包已满。再次交谈前请检查携带物品的重量和数量。";
		close3;
	}
	disable_items;
	cutin "ep172_omega",2;
	mes "[Yecheon]";
	mes "我可以提供自动模块、物理自动改良装置和魔法自动改良装置，帮助你提升自动装备的能力。";
	next;
	cutin "",255;
	switch( select( "更多信息。", "获取自动模块", "获取物理自动改良装置", "获取魔法自动改良装置", "取消" ) ) {
	case 1:
		cutin "ep172_omega",2;
		mes "[Yecheon]";
	mes "你可以用^0000CD90 张巴尔米尔票^000000获得^FF0000自动模块^000000。我会随机给你一件不含史诗等级的自动模块。";
		next;
		mes "[Yecheon]";
	mes "我还提供^FF0000物理自动改良装置和魔法自动改良装置^000000。可以用^0000CD45 张巴尔米尔票^000000或^0000CD1500000 Zeny^000000交换。";
		next;
		mes "[Yecheon]";
	mes "那么，战斗专家客人，请安全地提升你的能力吧。";
		close3;
	case 2:
		.@price = 90;
		cutin "ep172_omega",2;
		mes "[Yecheon]";
	mes "我会用 " + .@price + " " + mesitemlink(1000103) + " 交换 1 件随机自动模块（不含史诗等级）。";
		next;
		cutin "",255;
	if (select( "交换巴尔米尔票。", "不交换" ) == 2) {
			mes "[Yecheon]";
	mes "交易结束。";
			close3;
		}
		cutin "ep172_omega",2;
		if (countitem(1000103) < .@price) {
			mes "[Yecheon]";
	mes "你没有足够的巴尔米尔票进行交换。";
			close3;
		}
		mes "[Yecheon]";
	mes "我已为你交换一件随机自动模块。";
		delitem 1000103,.@price;
		getitem rand(1000105,1000149),1;
		close3;
	case 3:
		.@price = 45;
		.@zeny = 1500000;
		cutin "ep172_omega",2;
		mes "[Yecheon]";
	mes "我会用 " + .@price + " " + mesitemlink(1000103) + " 或 " + .@zeny + " Zeny 交换 ^FF00001 件物理自动改良装置^000000。";
		next;
		cutin "",255;
	switch( select( "用巴尔米尔票交换。", "用 1500000 Zeny 交换。", "不交换。" ) ) {
		case 1:
			cutin "ep172_omega",2;
			if (countitem(1000103) < .@price) {
				mes "[Yecheon]";
				mes "你没有足够的巴尔米尔票进行交换。";
				close3;
			}
			delitem 1000103,.@price;
			break;
		case 2:
			cutin "ep172_omega",2;
			if (Zeny < .@zeny) {
				mes "[Yecheon]";
	mes "你没有足够的 Zeny 进行交换。";
				close3;
			}
			Zeny -= .@zeny;
			break;
		case 3:
			mes "[Yecheon]";
			mes "交易结束。";
			close3;
		}
		mes "[Yecheon]";
	mes "我已为你交换一件随机物理自动改良装置。";
		.@r = rand(100);
		if (.@r < 50)
			getitem 100164,1;
		else if (.@r < 80)
			getitem 100165,1;
		else
			getitem 100166,1;
		close3;
	case 4:
		.@price = 45;
		.@zeny = 1500000;
		cutin "ep172_omega",2;
		mes "[Yecheon]";
	mes "我会用 " + .@price + " " + mesitemlink(1000103) + " 或 " + .@zeny + " Zeny 交换 ^FF00001 件魔法自动改良装置^000000。";
		next;
		cutin "",255;
		switch( select( "用巴尔米尔票交换。", "用 1500000 Zeny 交换。", "不交换。" ) ) {
		case 1:
			cutin "ep172_omega",2;
			if (countitem(1000103) < .@price) {
				mes "[Yecheon]";
				mes "你没有足够的巴尔米尔票进行交换。";
				close3;
			}
			delitem 1000103,.@price;
			break;
		case 2:
			cutin "ep172_omega",2;
			if (Zeny < .@zeny) {
				mes "[Yecheon]";
				mes "你没有足够的 Zeny 进行交换。";
				close3;
			}
			Zeny -= .@zeny;
			break;
		case 3:
			mes "[Yecheon]";
			mes "交易结束。";
			close3;
		}
		mes "[Yecheon]";
	mes "我已为你交换一件随机魔法自动改良装置。";
		.@r = rand(100);
		if (.@r < 50)
			getitem 100167,1;
		else if (.@r < 80)
			getitem 100168,1;
		else
			getitem 100169,1;
		close3;
	case 5:
		mes "[Yecheon]";
		mes "交易结束。";
		close3;
	}
	end;
}

ba_in01,87,389,2	script	Butterfly Merchant#ba_in01	4_EP17_MASTER_A,{
	if (ep17_2_main < 8) {
		mes "[Butterfly Merchant]";
	mes "抱歉，购买蝴蝶需要先登记。";
		close;
	}
	mes "[Butterfly Merchant]";
	mes "欢迎。";
	mes "需要翅膀前往巴尔蒙特宅邸吗？";
	close2;
	callshop "barter_Teleport_Ep17_02";
	end;
}

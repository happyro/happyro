		next;
		mes "[迈克尔]";
		mes "如果我犯错，雷克会惩罚我。";
		close;
	case 3:
		mes "你是说升级装备，对吧？";
		mes "我们只能升级伊甸园集团帽子。";
		next;
		mes "[迈克尔]";
		if (para_suv02 == 3) {
			if (countitem(5583) > 0) {
				disable_items;
				mes "你想升级哪项属性加成？";
				next;
				switch (select("升级STR：升级AGI：升级VIT：升级INT：升级DEX：升级LUK：算了。")) {
				case 1: callsub S_Upgrade,"STR",4701;
				case 2: callsub S_Upgrade,"AGI",4731;
				case 3: callsub S_Upgrade,"VIT",4741;
				case 4: callsub S_Upgrade,"INT",4711;
				case 5: callsub S_Upgrade,"DEX",4721;
				case 6: callsub S_Upgrade,"LUK",4751;
				case 7:
					mes "[迈克尔]";
					mes "为什么？升级后会比现在更好。";
					mes "总之，我们只能给你升级一顶帽子。";
					next;
					mes "[迈克尔]";
					mes "你想怎么使用它由你决定。";
					close;
				}
			}
			mes "先带来你想让我升级的帽子。";
			mes "确认它在你的物品栏里，明白了吗？";
			close;
		}
		if (para_suv02 == 4) {
			mes "嗯，这不是已经升级过了吗？";
			mes "根据记录，";
			mes ""+strcharinfo(0)+": Has already upgraded their Hat.";
			next;
			mes "[迈克尔]";
			mes "我们只能提供1次升级。";
			mes "抱歉，我不能升级两次。";
			close;
		}
		mes "你还没有领取第3步的全部补给。";
		mes "升级帽子是一项特殊服务。";
		next;
		mes "[迈克尔]";
		mes "抱歉，我帮不了你。";
		close;
	}
S_Upgrade:
	mes "[迈克尔]";
	mes "我明白了。";
	mes "我会^4d4dff升级"+ getarg(0) +"^000000。";
	mes "确定吗？";
	next;
	switch (select("是的：等等。")) {
	case 1:
		mes "[迈克尔]";
		mes "我现在开始升级。";
		next;
		mes "[迈克尔]";
		mes "给你。";
		para_suv02 = 4;
		delitem 5583,1;
		getitem2 5583,1,1,0,0,0,0,0,getarg(1);
		close;
	case 2:
		mes "[迈克尔]";
		mes "你不想升级吗？";
		close;
	}

S_Select:
	.@total_arg = getargcount();
	if (.@total_arg < 7)
		mes "我们只有1件武器给你。";
	else {
		mes "你想要哪种武器？";
		mes getarg(0);
		mes "以下是可选项。";
	}
	next;
	mes "[迈克尔]";
	for ( .@i = 1; .@i < .@total_arg; .@i += 5 ) {
		set .@menu$, .@menu$ + getarg(.@i+1) + ":";
		mes getarg(.@i+1)+": "+ getarg(.@i+2) +". "+ getarg(.@i+3) +".";
	}
	if (.@total_arg < 7)
		mes "它是Lv. 2，要求等级为"+ (para_suv01 == 22 ? "26" : "40") +".";
	else
		mes "它们都是Lv. 2武器，要求等级为"+ (para_suv01 == 22 ? "26" : "40") +".";
	next;
	mes "[迈克尔]";
	mes "它们也不能与其他玩家交易或精炼。";
	next;
	//			callsub S_Select,"We have one and Two-handed swords",
		//			13424,"Eden Saber II","One-handed sword","Attack 170","",///P_Sabre2
			//		1193,"Eden Slayer II","Two-handed sword","Attack 185","";//P_Slayer2
	if (.@total_arg < 7) {
		.@i = 1;
		mes "[迈克尔]";
		mes "你将获得"+ getarg(.@i+1) +".";
		next;
		mes "[迈克尔]";
	}
	else {
		.@i = (select(.@menu$) -1) *5 +1;
		mes "[迈克尔]";
		mes "你选择了"+ getarg(.@i+1) +".";
	}
	if (para_suv01 == 22) {
		mes "此外你还会获得伊甸园集团靴子II和制服II。";
		next;
		getitem 2457,1;	// Para_Team_Boots2
		getitem 15010,1;// Para_Team_Uniform2
		para_suv01 = 23;
	}
	else {
		mes "此外你还会获得伊甸园集团靴子III和制服III。";
		next;
		getitem 2458,1;// Para_Team_Boots3
		getitem 15011,1;// Para_Team_Uniform3
		para_suv01 = 38;
	}
	getitem getarg(.@i),1;
	mes "[迈克尔]";
	if (para_suv02 == 0) {
		mes "没有你领取补给的记录，";
		mes "所以你还会获得伊甸园集团帽子和斗篷。";
		getitem 5583,1;// Para_Team_Hat
		getitem 2560,1;// Para_Team_Manteau
		if (para_suv01 == 22)
			para_suv02 = 2;
		else
			para_suv02 = 3;
		next;
		mes "[迈克尔]";
		mes "再次检查你的补给，并好好保管。";
	}
	else {
		if (para_suv01 == 22)
			para_suv02 = 2;
		else
			para_suv02 = 3;
		mes ""+ getarg(.@i+2) +"、制服和靴子，共3件补给。";
		mes "请再次检查。";
		next;
		mes "[迈克尔]";
		mes "希望它们对你有用。";
		mes getarg(.@i+4);
	}
	close;
}

moc_para01,179,44,3	script	Chef	820,{
	mes "[厨师]";
	mes "怎么了？";
	mes "想吃饭吗？还是有别的事？";
	next;
	switch (select("点餐：聊天。")) {
	case 1:
		mes "[厨师]";
		mes "请选择A、B、C三种套餐中的一种。";
		mes "需要我说明吗？";
		next;
		switch (select("我想听说明：点A套餐：点B套餐：点C套餐：结束对话。")) {
		case 1:
			mes "[厨师]";
			mes "呃？你想知道什么？";
			next;
			switch (select("关于A套餐：关于B套餐：关于C套餐：结束对话。")) {
			case 1:
				mes "[厨师]";
				mes "A套餐适合普通人。";
				mes "它包含三种菜肴，主菜是……";
				mes " ";
				mes "-厨师正试图指向图中的一道菜。那里有一个黑色卷。-";
				next;
				mes "[厨师]";
				mes "它由海草制成，像纸一样干。";
				mes "这是里面包着蒸米饭、蔬菜和肉的卷。";
				mes "看起来简单，但非常美味健康。";
				next;
				mes "[厨师]";
				mes "食材与辣酱混合得很好。";
				mes "还混入了类似香肠的碎肉。";
				next;
				mes "[厨师]";
				mes "简单又便宜，所以很受大家欢迎。";
				mes "只要3,000 Zeny。";
				mes "吃完会很满足。";
				close;
			case 2:
				mes "[厨师]";
				mes "嗯，B套餐是……";
				mes "我用香味蔬菜和肉在汤里制作酱汁。";
				next;
				mes "[厨师]";
				mes "肉在汤里煮过，软嫩得可以用叉子切开。";
				mes "汤快煮好时，我会加入面条作为点睛之笔。";
				next;
				mes "[厨师]";
				mes "这是适合和朋友分享的菜。";
				mes "价格是4,000 Zeny。";
				mes "这是很有趣的美食。";
				close;
			case 3:
				mes "[厨师]";
				mes "接下来是C套餐……";
				mes "这是肉类杰作……肉类套餐的传说！";
				next;
				mes "[厨师]";
				mes "牛肉、培根、";
				mes "西冷牛排、";
				mes "肋眼卷";
				mes "...";
				next;
				mes "[厨师]";
				mes "需要更多信息吗？";
				mes "别担心。";
				mes "我用最好的橡木熏制。";
				mes "啊，价格是5,000 Zeny。很便宜吧？我只用最好的肉，所以不用担心。";
				close;
			case 4:
				mes "[厨师]";
				mes "我没时间和你聊天……";
				close;
			}
		case 2:
			mes "[厨师]";
			mes "A套餐？";
			mes "啊，金德顺。";
			mes "这是普通市民的代表套餐。";
			next;
			if (callfunc("F_HasEdenGroupMark")) {
				if (Zeny > 2699) {
					mes "[厨师]";
					mes "嘿，给你。";
					mes "请享用。";
					next;
					mes "- 吃完饭后，你感觉有点饱。";
					mes "你恢复了一些HP和SP。-";
					set Zeny, Zeny - 2700;
					percentheal 50,0;
					percentheal 0,50;
					close;
				}
				mes "[厨师]";
				mes "这份套餐原价3,000 Zeny，但我会以2,700出售。";
				mes "因为你是伊甸园成员，享受10%折扣，所以是2,700 Zeny。";
				close;
			}
			if (Zeny > 2999) {
				mes "[厨师]";
				mes "嘿，给你。";
				mes "请享用。";
				next;
				mes "- 吃完饭后，你感觉有点饱。";
				mes "你恢复了一些HP和SP。-";
				set Zeny, Zeny - 3000;
				percentheal 50,0;
				percentheal 0,50;
				close;
			}
			mes "[厨师]";
			mes "这份套餐价格是3,000 Zeny。";
			mes "我得告诉你多少次？";
			close;
		case 3:
			mes "[厨师]";
			mes "B套餐？";
			mes "这道肉和蔬菜热汤源自寒冷干燥环境下的游牧生活。";
			next;
			if (callfunc("F_HasEdenGroupMark")) {
				if (Zeny > 3599) {
					mes "[厨师]";
					mes "嘿，给你。";
					mes "请享用。";
					next;
					mes "- 吃完饭后，你感觉有点饱。";
					mes "你恢复了一些HP和SP。-";
					set Zeny, Zeny - 3600;
					percentheal 75,0;
					percentheal 0,75;
					close;
				}
				mes "[厨师]";
				mes "这份套餐原价4,000 Zeny，但我会以3,600出售。";
				mes "因为你是伊甸园成员，享受10%折扣，所以是3,600 Zeny。";
				close;
			}
			if (Zeny > 3999) {
				mes "[厨师]";
				mes "嘿，给你。";
				mes "请享用。";
				next;
				mes "- 吃完饭后，你感觉有点饱。";
				mes "你恢复了一些HP和SP。-";
				set Zeny, Zeny - 4000;
				percentheal 75,0;
				percentheal 0,75;
				close;
			}
			mes "[厨师]";
			mes "这份套餐价格是4,000 Zeny。";
			mes "我得告诉你多少次？";
			close;
		case 4:
			if (callfunc("F_HasEdenGroupMark")) {
				if (Zeny > 4499) {
					mes "[厨师]";
					mes "嘿，给你。";
					mes "请享用。";
					next;
					mes "- 肋眼卷是在橡木上烤制的。";
					mes "- 吃完饭后，你感觉有点饱。";
					mes "你恢复了HP和SP。-";
					set Zeny, Zeny - 4500;
					percentheal 100,0;
					percentheal 0,100;
					close;
				}
				mes "[厨师]";
				mes "这份套餐原价5,000 Zeny，但我会以4,500出售。";
				mes "因为你是伊甸园成员，享受10%折扣，所以是4,500 Zeny。";
				close;
			}
			if (Zeny > 4999) {
				mes "[厨师]";
				mes "嘿，给你。";
				mes "请享用。";
				next;
				mes "嘿，给你。";
				mes "- 肋眼卷是在橡木上烤制的。";
				mes "- 吃完饭后，你感觉有点饱。";
				mes "你恢复了HP和SP。-";
				set Zeny, Zeny - 5000;
				percentheal 100,0;
				percentheal 0,100;
				close;
			}
			mes "[厨师]";
			mes "这份套餐价格是5,000 Zeny。";
			mes "我得告诉你多少次？";
			close;
		case 5:
			mes "[厨师]";
			mes "由你决定。";
			close;
		}
	case 2:
		if (callfunc("F_HasEdenGroupMark")) {
			mes "[Chef]";
			mes "大多数工作都应该自己处理，所以可能很困难，对吧？";
			mes "其实这很危险，所以他们一直在请求帮助。";
			next;
			mes "[Chef]";
			mes "我们不能互相帮助、一起努力吗？";
			mes "总之，你……";
			next;
			if (para_suv01 == 0) {
				if (BaseLevel < 41) {
					mes "[Chef]";
					mes "你好吗？";
					mes "啊……你现在看起来不像初心者了。";
					mes "想知道一些好消息吗？";
					next;
					mes "[Chef]";
					mes "伊甸园集团……有时会接到委托。";
					mes "但他们也会自己制造防具和武器。";
					next;
					mes "[Chef]";
					mes "如果你愿意，可以从伊甸园集团获得制服。";
					next;
					mes "[Chef]";
					mes "要获得制服，你需要完成他们的任务。";
					mes "如果你感兴趣，就去柜台找博雅教官。";
					close;
				}
				mes "[Chef]";
				mes "你看起来像专家……";
				mes "嗯嗯……";
				mes "嗯嗯……ummm..";
				next;
				mes "[Chef]";
				mes "是的！我发现了你缺少的东西！";
				mes "你还没拿到伊甸园集团制服？";
				next;
				mes "[Chef]";
				mes "嗯，虽然不是必须的，但如果你留在伊甸园集团，这会是很好的象征。";
				next;
				mes "[Chef]";
				mes "你不容易拿到它，不过……";
				mes "感兴趣的话，去柜台问博雅教官。";
				close;
			}
			mes "[Chef]";
			mes "当然，制服很适合你。";
			mes "哦，当然。";
			mes "最近是首领负责设计。";
			next;
			mes "[Chef]";
			mes "啊哈……尤其是帽子。";
			mes "对……我来说……帽子……嗯。";
			mes "它很适合莱姆，但卢克的话……我不知道……";
			next;
			switch (select("帽子怎么样？：卢克？")) {
			case 1:
				mes "[Chef]";
				mes "没什么。它很可爱。";
				mes "我很在意那条缎带。";
				mes "但我必须戴这顶帽子……";
				next;
				mes "[Chef]";
				mes "哈哈哈，我不在乎。";
				mes "我完全不在乎！";
				mes "哈哈哈……啊哈哈哈哈……";
				close;
			case 2:
				mes "[Chef]";
				mes "他是短剑专家。";
				mes "我们的一名卫队首领。";
				mes "他还负责办公室的安全。";
				next;
				mes "[Chef]";
				mes "几乎所有新雇员都对他感到好奇。";
				mes "但莱姆和卢克完全不同。";
				next;
				mes "[Chef]";
				mes "这些首领已经合作很久了。";
				mes "但首领想隐藏自己的过去……";
				next;
				mes "[Chef]";
				mes "我猜……他可能是富裕家族的儿子。";
				mes "传闻卢克曾是那个家族的护卫。";
				mes "莱姆曾是仆人？不是吗？";
				mes "你觉得我的故事怎么样？";
				next;
				select("……");
				mes "[Chef]";
				mes "…………..";
				mes "啊哈……嘿～就算我说了些没用的事，也别那样看着我";
				mes "但三个人建立了伊甸园集团确实是真的。";
				close;
			}
		}
		mes "[Chef]";
		mes "嗯？任务。你找对地方了吗？";
		mes "而且让我看看……你不是我们的成员。我怎么能给你工作？";
		next;
		mes "[Chef]";
		mes "就在餐厅吃饭吧。";
		mes "我们为所有人提供餐食。";
		mes "我很确定味道很棒！";
		close;
	}
}

moc_para01,23,35,5	script	Instructor Ur#2nd01	4_M_KNIGHT_BLACK,{
	mes "[乌尔教官]";
	if (!callfunc("F_HasEdenGroupMark")) {
		mes "嘿，你好！";
		mes "我看你不是我们的成员？";
		mes "你有兴趣加入我们吗？";
		next;
		mes "[乌尔教官]";
		mes "加入不收取费用！";
		mes "我们是把援助送到需要之处的中介。像你这样的冒险者越多，利润就越多。";
		next;
		mes "[乌尔教官]";
		mes "如果感兴趣，就去和莱姆谈谈。";
		mes "莱姆是个好人。";
		mes "哈哈哈……";
	}
	else if (para_2nd01 == 0) {
		mes "你好？";
		mes "需要帮助吗？";
		mes "这是领取下一块公告板委托前必须完成的普通委托。";
		next;
		if (select( "你在这里做什么？", "没什么。" ) == 2) {
			mes "[乌尔教官]";
			mes "那看来我们没什么可谈的了。";
			close;
		}
		mes "[乌尔教官]";
		mes "我是伊甸园集团的教官。";
		next;
		mes "[乌尔教官]";
		mes "我会根据你当前的基础等级发布任务。";
		mes "这些任务并不难完成。";
		next;
		mes "[乌尔教官]";
		mes "我是伊甸园集团的高级教官。";
		mes "怎么样，你准备好接受挑战了吗？";
		next;
		if (select( "今天不行。", "好的，我试试。" ) == 1) {
			mes "[Instructor Ur]";

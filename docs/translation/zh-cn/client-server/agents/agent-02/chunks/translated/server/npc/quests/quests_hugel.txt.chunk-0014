		mes "游戏协调员通常";
		mes "都很忙……";
		close;
	}
}

que_bingo,53,190,7	script	Eukran	778,{
	if (hg_ma1 == 6) {
		mes "[Eukran]";
		mes "哦，你刚才不是";
		mes "还在宾果房吗？";
		mes "希望你享受游戏。";
		mes "现在有什么";
		mes "我能帮你的吗？";
		next;
		select("谈谈 Euslan");
		mes "^3355FF你告诉 Eukran，他的姐姐";
		mes "病得很重，并派你寻找";
		mes "她的未婚夫 Thierry。^000000";
		next;
		mes "[Eukran]";
		mes "*抽泣* 我完全不知道";
		mes "姐姐 Euslan 病得这么重！";
		mes "难怪上次见 Thierry 时";
		mes "他看起来那么沮丧。";
		mes "他为什么什么都没告诉我？";
		next;
		mes "[Eukran]";
		mes "大约一个月前 Thierry 经过这里，";
		mes "告诉我他必须去奥丁神殿。";
		mes "当时我不确定，";
		mes "但现在我觉得他是在";
		mes "想办法帮助我姐姐。";
		next;
		mes "[Eukran]";
		mes "那里一定有能帮助";
		mes "我姐姐康复的东西。";
		mes "否则 Thierry 为什么要去";
		mes "那么危险的地方？";
		mes "没人会无缘无故去奥丁神殿。";
		close2;
		set hg_ma1,8;
		changequest 8047,8048;
		warp "que_bingo",37,24;
		end;
	}
	
}

odin_tem01,129,127,0	script	HiddenActivator#Hugel	139,3,3,{
OnTouch:
	if (hg_ma1 == 8) {
		mes "^3355FF你听到不远处";
		mes "有两个人在交谈。^000000";
		next;
		mes "[Suspicious Man]";
		mes "你确定研究有进展吗？";
		mes "我什么像样的成果";
		mes "都没见到！";
		next;
		mes "[Young Man]";
		mes "我告诉你，这和上个项目不同。";
		mes "没有别的办法，需要一些时间。";
		mes "你只能耐心等待……";
		next;
		mes "[Suspicious Man]";
		mes "好，随便你。";
		mes "但你的未婚妻呢？";
		mes "我知道她已经命悬一线：";
		mes "你真的能等这么久吗？";
		mes "好好想想。";
		next;
		mes "[Young Man]";
		mes "......";
		mes ".........";
		mes "............";
		next;
		mes "[Suspicious Man]";
		mes "尽快完成这件事。";
		mes "为了你的未婚妻，";
		mes "也为了你自己。";
		mes "明白我的意思吗？";
		next;
		mes "[Young Man]";
		mes "……我明白。";
		next;
		mes "^3355FF你听到脚步声，";
		mes "脚步声渐渐变得";
		mes "越来越微弱。";
		mes "其中一人一定离开了。^000000";
		close2;
		enablenpc "Young Man#Hu_Quest";
		initnpctimer;
		end;
	} else if (hg_ma1 == 9 || hg_ma1 == 10 || hg_ma1 == 11) {
		enablenpc "Young Man#Hu_Quest";
		initnpctimer;
		end;
	}

OnTimer180000:
	disablenpc "Young Man#Hu_Quest";
	stopnpctimer;
	end;
	
OnInit:
	disablenpc "Young Man#Hu_Quest";
	end;

}

odin_tem01,130,134,4	script	Young Man#Hu_Quest	774,{
	if (hg_ma1 == 8) {
		mes "[Young Man]";
		mes "嗯？哦，是冒险者。";
		mes "如今来参观";
		mes "奥丁神殿的你们";
		mes "越来越多了。";
		next;
		select("Thierry 先生？");
		mes "[Thierry]";
		mes "...?!";
		mes "你、你怎么";
		mes "知道我的名字？";
		mes "我认识你吗？";
		mes "从某个地方来的吗？";
		next;
		select("告诉他 Euslan 的情况");
		mes "[Thierry]";
		mes "哦，是 Euslan 派你来的吗？";
		mes "很抱歉让你";
		mes "经历这么多麻烦。";
		mes "不过听到她的消息我很高兴。";
		mes "请告诉她我很快就回家，好吗？";
		next;
		select("你在这里做什么？");
		mes "[Thierry]";
		mes "嗯……抱歉。";
		mes "我不能透露细节，";
		mes "但我正在进行这项研究，";
		mes "寻找治愈 Euslan 疾病的方法。";
		mes "现代医学无法治愈它……";
		close2;
		set hg_ma1,9;
		changequest 8048,8049;
		end;
	} else if (hg_ma1 == 9) {
		mes "[Thierry]";
		mes "我不能再告诉你更多了。";
		mes "请相信我。";
		mes "在此期间，能请你告诉 Euslan，";
		mes "我很快就会回家吗？";
		close;
	} else if (hg_ma1 == 10) {
		mes "[Thierry]";
		mes "哦，我还以为你已经离开奥丁神殿了。";
		mes "你还有别的事要告诉我吗？";
		next;
		select("警告 Thierry 有可疑男子");
		mes "[Thierry]";
		mes "什么？！果然和我想的一样！";
		mes "他们一直都只是在利用我……！";
		mes "不过我现在还不能离开这里……不行……";
		next;
		mes "[Thierry]";
		mes "一切大概始于 Euslan 染上那种怪病。";
		mes "没有医生知道那是什么，也没有人能做什么。";
		mes "那真是令人绝望……";
		next;
		mes "[Thierry]";
		mes "最后，我带她去见了 Mawong。";
		mes "他说他遇到过患有这种病的人，";
		mes "也知道治愈的方法。";
		mes "我只能放手一搏……";
		next;
		mes "[Thierry]";
		mes "Mawong 说药方就在汶格附近的奥丁神殿一带。";
		mes "如你所知，这里极其危险。";
		mes "但我不在乎。为了 Euslan，我什么都愿意做。";
		next;
		mes "[Thierry]";
		mes "当然，我只告诉 Euslan 我会在施瓦茨瓦尔德共和国附近寻找。";
		mes "如果她知道我在奥丁神殿，一定会非常担心。";
		next;
		mes "[Thierry]";
		mes "来到这里后，我不知道该做什么，甚至不知道要找什么。";
		mes "后来我遇到那些奇怪的人，";
		mes "因为苦恼便把自己的遭遇告诉了他们。";
		next;
		mes "[Thierry]";
		mes "当他们说知道如何治好 Euslan 时，简直像奇迹一样。";
		mes "他们说自己是研究团队，";
		mes "正在进行与我的困境有关的项目。";
		next;
		mes "[Thierry]";
		mes "我根本没有多想，立刻接受了他们的邀请加入。";
		mes "他们要求的研究我都照做，";
		mes "同时寻找治愈 Euslan 的方法……";
		next;
		mes "[Thierry]";
		mes "后来我偷听到他们的谈话，才知道他们其实是雷根贝勒公司的特工。";
		mes "他们的项目与药物或 Euslan 毫无关系……";
		next;
		mes "[Thierry]";
		mes "他们真正的目标，是找到奥丁神殿地下某个巨人的遗骸，改进守护者技术。";
		mes "不过与他们合作也让我获得了许多资源。";
		next;
		mes "[Thierry]";
		mes "通过与那些人的研究，我其实已经找到了治愈 Euslan 的方法，";
		mes "所以现在不能放弃。";
		mes "我还要为 Euslan 制作药物！";
		next;
		mes "[Thierry]";
		mes "所以我一直背着他们，利用他们的守护者收集未婚妻药物所需的材料。";
		mes "但如果他们打算除掉我，我已经没有时间了。";
		next;
		mes "[Thierry]";
		mes "我会遭遇什么并不重要，但我必须救 Euslan。";
		mes "还需要 ^FF00005 个黑暗符文^000000 才能完成药物。";
		mes "冒险者，请帮我取得它们……";
		next;
		mes "[Thierry]";
		mes "我只能相信你来救 Euslan。";
		mes "在此期间，我会躲在这里避开那些人。";
		mes "如果被他们抓到，我就永远无法制作药物了！";
		close2;
		set hg_ma1,11;
		changequest 8050,8051;
		end;
	} else if (hg_ma1 == 11) {
		if (countitem(7511) < 5) {
			mes "[Thierry]";
			mes "我知道在奥丁神殿收集材料很困难，";
			mes "但请尽快为我取得 ^3355FF5 个黑暗符文^000000。";
			mes "我的 Euslan 真的需要那种药……";
			close;
		}
		mes "[Thierry]";
		mes "哦！你真的带来了黑暗符文！";
		mes "我终于能制作拯救 Euslan 的药了。";
		mes "我……我真不知该如何感谢你。";
		mes "我太高兴了……";
		next;
		mes "[Thierry]";
		mes "请稍等片刻。";
		mes "我想马上制作。让我看看，啊，这是我的研究笔记……";
		next;
		mes "......";
		mes ".........";
		mes "............";
		next;
		mes "[Thierry]";
		mes "终于完成了。这种药能治好 Euslan。";
		mes "如果你愿意再帮我最后一件事，";
		mes "请把它交给她。";
		mes "等事情平息后，我必须悄悄离开。";
		next;
		mes "[Thierry]";
		mes "请理解我也想尽快见到她，";
		mes "但必须等那些雷根贝勒特工停止搜寻我。";
		mes "也请告诉 Euslan 我很快就会回家。";
		next;
		mes "^3355FF你收到了 Thierry 制作的药物，";
		mes "请交给 Euslan。^000000";
		close2;
		delitem 7511,5; //Rune_Of_Darkness
		set hg_ma1,12;
		changequest 8051,8052;
		end;
	} else if (hg_ma1 == 12) {
		mes "[Thierry]";
		mes "请尽快把药物交给 Euslan，";
		mes "她的生命就靠它了。";
		mes "请告诉她我会尽快回家。";
		close;
	} else {
		mes "[Researcher]";
		mes "对不起，Euslan……";
		mes "请再等我一会儿。";
		mes "我发誓一定会回到你身边！";
		close;
	}
	
}


hugel,56,104,3	script	Kurupe	709,3,3,{
	if (hg_milk == 1) {
		mes "[Kurupe]";
		mes "Burupu 又躲着我吗？";
		mes "自从他想成为剑士后，";
		mes "就越来越想逃避工作。";
		mes "要是能雇到别人就好了……";
		next;
		mes "[Kurupe]";
		mes "可惜我找不到其他会给我的奶牛 Booboo 挤奶的人！";
		mes "如果你能帮我找到 Burupu，";
		mes "我一定会支付报酬。";
		next;
		switch(select("好的。:抱歉，我很忙。")) {
		case 1:
			mes "[Kurupe]";
			mes "谢谢，你真是我的救星！";
			mes "我必须在明天前送出牛奶，";
			mes "所以真的需要 Burupu 回来！";
			mes "你应该能在城外找到他。";
			set hg_milk,2;
			setquest 12040;
			close;
		case 2:
			mes "[Kurupe]";
			mes "不、不……！";
			mes "如果找不到 Burupu，";
			mes "我就没法在明天前送出牛奶！";
			mes "天啊，我该怎么办？";
			close;
		}
	} else if (hg_milk > 1 && hg_milk < 5) {
		mes "[Kurupe]";
		mes "Burupu，我需要你";
		mes "来工作！也许";
		mes "你可以找到他在练习";
		mes "在城外用剑练习";
		mes "出城去找他。";
		mes "希望你能找到那个懒家伙……";
		close;
	} else if (hg_milk == 5) {
		mes "[Kurupe]";
		mes "Burupu 竟然在提要求？！";
		mes "看来我别无选择。";
		mes "你不会碰巧知道";
		mes "你知道细剑多少钱吗？";
		mes "为什么 Burupu 想成为";
		mes "这么喜欢剑士，对吧？";
		close;
	} else if (hg_milk == 6) {
		mes "[Kurupe]";
		mes "哦，你要";
		mes "帮我给奶牛挤奶？";
		mes "太好了，太好了，谢谢！";
		mes "请给 Booboo 挤奶";
		mes "马上给我";
		mes "一些美味的牛奶~";
		set hg_milk,7;
		close;
	} else if (hg_milk == 7) {
		mes "[Kurupe]";
		mes "嗯，这样如何？";
		mes "如果你真的能给";
		mes "如果你给奶牛 Booboo 挤奶，";
		mes "我就给你一些食物。";
		mes "听起来公平吧？总之，";
		mes "请尽快开始工作~";
		close;
	} else if (hg_milk == 8) {
		mes "[Kurupe]";
		mes "太好了！现在你已经";
		mes "给 Booboo 挤过奶，我可以";
		mes "并完成明天的配送！";
		mes "这里有一点";
		mes "一些食物，";
		mes "以此表达“非常感谢~”";
		next;
		if (checkweight(12063,3) != 1) {
			mes "[Kurupe]";
			mes "请等一下！";
			mes "你现在携带的物品";
			mes "太多了。";
			mes "把一些物品存进卡普拉仓库后";
			mes "请再回来。";
			close;
		}
		set hg_milk,9;
		specialeffect2 EF_CONE;
		getexp (checkre(3))?10000:100000,0;
		getitem 12063,3;
		erasequest 12043;
		mes "[Kurupe]";
		mes "我总是需要有人";
		mes "帮我给 Booboo 挤奶，";
		mes "尤其是 Burupu";
	mes "不舒服的时候。";

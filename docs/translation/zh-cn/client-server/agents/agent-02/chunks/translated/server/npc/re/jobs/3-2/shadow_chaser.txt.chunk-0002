		close;
	} else if (job_sha > 29) {
		mes "[Graham]";
		mes "魅影追踪者！！";
		mes "啊！";
		next;
		mes "[Graham]";
		mes "不是故意欺骗……";
		mes "哈哈哈！！";
		next;
		mes "[Graham]";
		mes "很有趣吧？";
		mes "这不只是参加考试。";
		mes "我们了解了你，也弄清了你是谁。";
		next;
		mes "[Graham]";
		mes "我的演技怎么样？";
		mes "成功了吗？";

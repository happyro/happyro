			mes "- to be thinking about -";
			mes "- 思考什么。然后他-";
			mes "- hands over a paper. -";
			next;
			mes "[Manager]";
			mes "不可能。";
			mes "这是线索。";
			mes "试着找出来。";
			next;
			mes "[Manager]";
			mes "总之，我叫Paul。";
			mes "...........";
			next;

	close;
L_Code:
	mes "-便笺。";
	mes "^4d4dff 13 15 18 15 3 3 18 21 9 14^000000";
	mes "钥匙：0-";
	next;
	select("这些只是数字……");
	mes "[Graham]";
	mes "与盗贼公会那份的唯一区别是，不需要把它们两两配对。";
	next;
	mes "[Graham]";
	mes "这里还有关键词……";
	mes "本例的钥匙是0。";
	next;
	mes "[Graham]";
	mes "例如。";
	mes "13 15 18 15 3 3 18 21 9 14 =";
	mes "M O R O C C R U I N";
	next;
	mes "[Graham]";
	mes "看这里……C=3。";
	mes "C是第三个字母，对吧？";
	next;
	mes "[Graham]";
	mes "明白了吗？";
	mes "关键词不是0时不会直接告诉你。给你关键词后，你可以自己解出来。";
	next;
	if (getarg(0)) return;
	mes "[Graham]";
	mes "现在进入任务。";
	mes "这是密码……";
	next;
	set .@key01, rand(3,5);
	set .@a, 1 + .@key01;
	set .@b, 2 + .@key01;
	set .@d, 4 + .@key01;
	set .@e, 5 + .@key01;
	set .@f, 6 + .@key01;
	set .@h, 8 + .@key01;
	set .@i, 9 + .@key01;
	set .@l, 12 + .@key01;
	set .@n, 14 + .@key01;
	set .@o, 15 + .@key01;
	set .@r, 18 + .@key01;
	set .@s, 19 + .@key01;
	set .@t, 20 + .@key01;
	set .@u, 21 + .@key01;
	mes "^4d4dff" + .@b + " " + .@l + " " + .@u + " " + .@e + " ";
	mes "" + .@f + " " + .@i + " " + .@r + " " + .@e + " ";
	mes "" + .@i + " " + .@n + " ";
	mes "" + .@t + " " + .@u + " " + .@r + " " + .@t + " " + .@l + " " + .@e + " ";
	mes "" + .@i + " " + .@s + " " + .@l + " " + .@a + " " + .@n + " " + .@d + " ";
	mes "" + .@t + " " + .@h + " " + .@i + " " + .@r + " " + .@d + " ";
	mes "" + .@f + " " + .@l + " " + .@o + " " + .@o + " " + .@r + " ";
	mes "钥匙：" + .@key01 + "。";
	set job_sha,5;
	erasequest 7160;
	if (.@key01 == 3) setquest 7161;
	else if (.@key01 == 4) setquest 7162;
	else if (.@key01 == 5) setquest 7163;
	next;
	mes "[Graham]";
	mes "拿去吧。";
	mes "我的记性不太好。";
	mes "你已经拥有全部信息，接下来靠自己了。";
	next;
	mes "[Graham]";
	mes "找到东西后到这里来。";
	next;
	mes "- 你从Graham那里拿到了便笺。";
	mes "别忘了！ -";
	close;
}

s_atelier,168,65,5	script	Manager#sc08_ra	923,{
	if (job_sha < 10) {

			mes "L-N-N-W-W-N-D";
			next;
			mes "[Paul]";
			mes "是不是很简单？";
			mes "你觉得呢？";
			mes "RENNND / LNNWWND指向同一件事。";
			next;
			switch(select("I think I got it.:I have no clue.")) {
			case 1:
				callsub L_Code,7166;
				close;
			case 2:
				mes "[Paul]";
				mes "什么？你不知道？";
				mes "那你最好再想想。";
				mes "这很简单。";
				set job_sha,10;
				changequest 7166,7167;

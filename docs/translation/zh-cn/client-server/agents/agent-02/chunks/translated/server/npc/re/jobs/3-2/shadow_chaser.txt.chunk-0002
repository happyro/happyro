		next;
		mes "[Graham]";
		mes "人们以为我们只是在交易东西……";
		mes "但我们来这里是为了非常特别的物品。";
		next;
		mes "[Graham]";
		mes "去^4d4dffRachel画廊^000000获取密码……";
		mes "把一切解释清楚，他们会支持你。";
		mes "明白吗？";
		close;
	} else if (job_sha > 9 && job_sha < 30) {
		mes "[Graham]";

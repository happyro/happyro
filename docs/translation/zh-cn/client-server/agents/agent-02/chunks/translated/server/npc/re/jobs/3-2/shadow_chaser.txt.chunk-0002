		next;
		mes "[Paul]";
		mes "Lighthalzen的年轻人很难对付……";
		mes "所以最好向Haled请求帮助……";
		next;
		mes "[Paul]";
		mes "嘿……";
		mes "如果你去Juno……";
		mes "那里有一座画廊……";
		next;
		mes "[Paul]";
		mes "能请他取得密码吗？";
		mes "嗯……";
		next;
		mes "[Paul]";
		mes "我觉得主画廊的红发男人在捉弄我……";
		mes "总之……";
		mes "我真的很想知道密码和钥匙的身份……";
		next;
		mes "[Paul]";
		mes "如果Haled不愿支持……";

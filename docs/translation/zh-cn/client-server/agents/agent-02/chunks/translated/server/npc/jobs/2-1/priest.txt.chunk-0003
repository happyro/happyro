		next;
		if (select("你说得对，我退出！:恶魔，滚出我的视线！") == 1) {
			mes "[小恶魔]";
			mes "^660000没错～！^000000 我的意思是……";
			mes "对你有好处！";
			next;
			mes "[小恶魔]";
			mes "哦……？";
			mes "看看^660000时间^000000。";
			mes "你最好走了。";
			next;
			mes "[小恶魔]";
			mes "哇哈哈哈哈哈哈！";
			mes "明白这个笑话了吗？！";
			close2;
			warp "c_tower2",168,33;
			end;
		}
		mes "[小恶魔]";
		mes "滚出你的视线？";
		mes "看来我不是你见过的";
		mes "最可爱东西，对吧？";
		next;
		mes "[小恶魔]";
		mes "那这个怎么样……？是不是很诱人？一张漂亮闪亮的新卡片，崭新的状态。你知道，没多少人拥有它。但我有好多张，口袋都疼了。";
		next;
		cutin "�̽�Ʈ����ī��.bmp",4; // Mistress Card
		mes "[小恶魔]";
		mes "拥有这种卡片不是所有人的梦想吗？想想看，当牧师只会带来痛苦……";
		next;
		if (select("你说得对，我收下了！:闭嘴！") == 1) {
			mes "[小恶魔]";
			mes "选得好！";
			mes "这张卡片";
			mes "可以属于你……";
			next;
			cutin "�̽�Ʈ����ī��.bmp",255; // Mistress Card
			mes "[小恶魔]";
			mes "理论上是这样！";
			mes "哇哈哈哈哈哈哈哈！";
			mes "去自己赚吧！";
			close2;
			warp "mjolnir_05",200,200;
			end;
		}
		cutin "�̽�Ʈ����ī��.bmp",255; // Mistress Card
		mes "[小恶魔]";
		mes "你……";
		mes "你刚才是叫我";
		mes "闭嘴吗？";
		mes "我的天……";
		next;
		mes "[小恶魔]";
		mes "抱歉……";
		mes "哦，是^660000你的^000000上帝。";
		mes "好吧，走吧。";
		mes "但你会后悔";
		mes "你之后会后悔自己的决定！";
		close;
	}
	end;
}

job_prist,168,80,4	script	Doppelganger#prst	1046,8,1,{
OnTouch_:
	if (BaseJob == Job_Priest) {
		mes "[分身]";
		mes "你在这里做什么？你已经做出选择，无法回头了……牧师。";
		next;
		mes "[分身]";
		mes "而且这不关你的事。这个服事者是否成为牧师不是你说了算。现在滚出去，别逼我动手。";
		close;
	}
	else if (BaseClass == Job_Acolyte) {
		mes "[分身]";
		mes "等等，服事者。";
		mes "我不像小恶魔，";
		mes "不会对你";
		mes "拐弯抹角。";
		next;
		mes "[分身]";
		mes "你为什么想成为牧师？那是毫无价值又得不到感谢的工作。如果你愿意，我给你机会变回初心者，然后你可以成为更好的职业！";
		next;
		mes "[分身]";
		mes "当然，我会让你按基础等级重新分配属性点。这不是很划算吗……？";
		next;
		if (select("成交，成交！:不成交……分身。") == 1) {
			mes "[分身]";
			mes "明智的选择～";
			mes "我会如你所愿，";
			mes "把你的职业变回";
			mes "初心者。";
			next;
			mes "[分身]";
			mes "现在走！！";
			mes "永远别再踏入";
			mes "光明！";
			close2;
			warp "gef_dun02",210,177;
			end;
		}
		mes "[分身]";
		mes "我想你没明白我的提议。再考虑一下。这是你纠正人生错误的唯一机会。成为服事者有什么好？";
		next;
		mes "[分身]";
		mes "别成为牧师就好。我不会问你第二次。你可以选择更好的职业……比如像我一样当剑士。";
		next;
		if (select("我不想成为牧师！:我永远不会听你的！") == 1) {
			mes "[分身]";
			mes "太棒的选择。现在永远别回这里。我会如你所愿把职业变回初心者。";
			next;
			mes "[分身]";
			mes "现在走！！";
			mes "永远别再踏入";
			mes "光明！";
			close2;
			warp "gef_dun02",210,177;
			end;
		}
		mes "[分身]";
		mes "哼。我佩服";
		mes "你的决心。";
		mes "好吧，你可以通过。";
		mes "暂时如此。";
		next;
		mes "[分身]";
		mes "但如果我们再次相遇，";
		mes "我保证……你绝不会高兴见到我。";
		close;
	}
}


job_prist,168,45,4	script	Deviruchi#prst	1109,8,1,{
OnTouch_:
	if (BaseJob == Job_Priest) {
		mes "[小恶魔]";
		mes "什——么……？";
		mes "你怎么又";
		mes "回来了？";
		next;
		mes "[小恶魔]";
		mes "哎呀，看看现在谁成了^660000BMOC^000000。就是‘^660000B^000000ig ^660000M^000000an ^660000O^000000n ^660000C^000000ampus’，不知道吧。顺便说，我是在讽刺。";
		next;
		mes "[小恶魔]";
		mes "你真的";
		mes "喜欢当牧师吗？";
		mes "不可能吧。";
		next;
		mes "[小恶魔]";
		mes "好吧，看在过去的份上让你通过。但只有这一次。别再让我抓到你！这里可是邪恶地盘，听见了吗？！";
		close;
	}
	if (BaseClass == Job_Acolyte) {

		mes "[彼得神父]";
		mes "请稍后再回来。这个服事者完成训练后，我会把你送到训练场。";
		close;
	}
	if (PRIEST_Q == 5) {
		mes "请稍等一会儿。训练场里现在还有另一名服事者。";
		next;
		mes "[彼得神父]";
		mes "想参加测试的话，请等一会儿再来找我。";
		close;
	}
	else if (PRIEST_Q == 6) {
		mes "请稍等一会儿。训练场里现在还有另一名服事者。";
		next;
		mes "[彼得神父]";
		mes "想参加测试的话，请等一会儿再来找我。";
		close;
	}
	else {
		mes "愿和平……";
		mes "与你同在。";
		close2;
		warp "prontera",234,318;
		end;
	}

OnInit:
	disablenpc "Peter S. Alberto#2";
	end;

OnEnable:
	enablenpc "Peter S. Alberto#2";
	end;

OnDisable:
	disablenpc "Peter S. Alberto#2";
	end;
}


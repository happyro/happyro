			end;
		case 2:
			mes "[彼得神父]";
			mes "嗯？你需要什么？";
			mes "没关系，你可以慢慢来。";
			close;
		case 3:
			mes "[彼得神父]";
			mes "什么……？";
			mes "你想回去？";
			next;
			mes "[彼得神父]";
			mes "我明白了。你应该有重要的理由或事务要处理。有空时再回来吧。";
			close2;
			warp "prontera",234,318;
			end;
		}
	}
	else {
		mes "回去吧！";
		close2;
		warp "prontera",234,318;
		end;
	}

OnEnable:
	enablenpc "Peter S. Alberto";
	end;

OnDisable:
	disablenpc "Peter S. Alberto";
	end;
}

job_prist,23,187,1	script	Peter S. Alberto#2	110,{
	mes "[彼得神父]";
	if (BaseJob == Job_Priest) {

		if (Sex == SEX_MALE)
		mes "兄弟 "+ strcharinfo(0) +"！";
		else
			mes "姐妹 "+ strcharinfo(0) +"！";
		mes "见到你真好！";
		next;
		mes "[彼得神父]";
		mes "你是来帮助服事者朋友进行精神训练的吗？太好了～我相信你会做得很好。";
		next;

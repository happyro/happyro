mosk_dun03,153,90,3	script	Bubbling Swamp#mos1	CLEAR_NPC,{
	if ((MaxWeight-Weight) < 2000) {
		mes "- 你今天的背包很重。-";
		close;
	}
	if (mos_swan == 10) {
		mes "- 光是看着这片沼泽，你就觉得黏糊糊的。-";
		next;
		mes "- 气泡不断上升，这里的气氛十分可怕。-";
		next;
		mes "["+strcharinfo(0)+"]";
	mes "我没看到 Mikhail 的踪迹。看来应该回去再检查一次他的房子。";
		mos_swan = 11;
		changequest 18063,18064;
		close;
	} else if (mos_swan == 11 && mos_swan == 12) {
		mes "- 你看到一片泥泞的小沼泽。-";
		next;
		mes "- 气泡不断上升，这里的气氛十分可怕。-";
		close;
	} else if (mos_swan > 12 && mos_swan < 23) {
		mes "- 光是看着这片沼泽，你就觉得黏糊糊的。-";
		next;
		mes "- 气泡不断上升，这里的气氛十分可怕。-";
		next;
		mes "- 你伸手寻找黏性草。-";
		next;
		if (rand(1,10) < 6) {
			mes "- 你的手指被黏性草刺到了。-";
			getitem 7763,1;
			mos_swan++;
			if (mos_swan == 23)
				changequest 18066,18067;
			close;
		}
		mes "- 你的手指被绿色药草刺到了。-";
		getitem 511,1;
		close;
	}
	mes "- 你看到一片看起来很泥泞的小沼泽。-";
	next;
	mes "- 气泡不断上升，这里的气氛十分可怕。-";
	close;
}


			// changequest 18062,18063;
			close;
		}
		mes "[Pub Owner]";
		mes "虽然你是经验丰富的冒险者，看起来却很年轻。";
		mes "我推荐这些饮料。你要哪一种？";
		next;
		.@j = select("牛奶 - 1000 Zeny:黏性草汁 - 1000 Zeny:都太贵了！") - 1;
		if (.@j == 2) {
			mes "[Pub Owner]";
		mes "哈哈哈，对你来说太贵了吧，小气鬼。";
			close;
		}
		if (Zeny > 999) {
			Zeny = Zeny -1000;
			mos_swan = 9;
			if (.@j == 0)
				getitem 519,1;
			else
				getitem 531,1;
			mes "[Pub Owner]";
		mes "给你，这是你点的。你觉得莫斯科比亚怎么样？";
			next;
			mes "["+strcharinfo(0)+"]";
		mes "是的，美丽又壮观。Sasha，能回答我一个问题吗？";
			next;
			mes "[Pub Owner]";
		mes "什么问题？";
			next;
			mes "["+strcharinfo(0)+"]";
		mes "Mikhail 来过这里吗？";
			next;
			mes "[Pub Owner]";
		mes "来过。他脸色苍白，需要高强度黏合剂。";
			next;
			mes "["+strcharinfo(0)+"]";
		mes "发生了什么？";
			next;
			mes "[Pub Owner]";
		mes "我不太了解黏合剂。";
		mes "不过我认识一个可能了解的人，所以把 Mikhail 介绍给他。";
			next;
			mes "["+strcharinfo(0)+"]";
		mes "这个人是谁？";
			next;
			mes "[Pub Owner]";
		mes "就是那边的 Victor。";
		mes "他非常注重细节，所以我们叫他 ^3131FF‘刺猬 Victor’^000000。";
		mes "没人比他更了解黏合剂。";
			next;
			mes "["+strcharinfo(0)+"]";
		mes "Sasha，非常感谢！";
			next;
			mes "[Pub Owner]";
		mes "不客气。";
			close;
		}
		mes "[Pub Owner]";
		mes "旅行时需要很多钱。如果钱不够，我可以给你一杯水。";
		close;
	} else if (mos_swan == 8) {
		mes "[Pub Owner]";
		mes "我在酒馆工作时能听到世界各地的故事。他们都是自己人生的英雄。";
		next;
		mes "[Pub Owner]";
		mes "每个故事都让我感兴趣，所以一天很快就过去了。这就是我喜欢工作的原因。";
		next;
		mes "[Pub Owner]";
		mes "你有故事要告诉我，或者有什么要问吗？我推荐这些饮料。";
		next;
		.@s = select( "牛奶 - 1000 Zeny:苹果汁 - 1000 Zeny:都太贵了！" );
		if (.@s == 3) {
			mes "[Pub Owner]";
			mes "哈哈哈，这里可是观光胜地。";
			close;
		}
		if (Zeny > 999) {
			Zeny = Zeny -1000;
			mos_swan = 9;
			if (.@s == 1)
				getitem 519,1;
			else
				getitem 531,1;
			mes "[Pub Owner]";
			mes "给你，这是你点的。请慢用。";
			close;
		}
		mes "[Pub Owner]";
		mes "旅行时需要很多钱。如果钱不够，我可以给你一杯水。";
		close;
	} else if (mos_swan == 9) {
		mes "[Pub Owner]";
		mes "你和 Victor 谈过了吗？";
		close;
	}
	mes "[Pub Owner]";
	mes "欢迎来到我们的酒馆。";
	mes "我是 ^3131FF‘溪流酒馆’^000000 的 Alexandre，但大家都叫我 Sasha。";
	mes "今天天气很好，我想出去走走。";
	close;
}

mosk_in,147,202,3	script	Victor#mos	4_M_RUSMAN2,{
	if ((MaxWeight-Weight) < 2000) {
		mes "- 请停在这里！-";
		mes "- 你携带的物品太多 -";
		mes "- 请使用卡普拉服务后 -";
		mes "- 再试一次 -";
		close;
	}
	if (mos_swan == 8) {
		mes "["+strcharinfo(0)+"]";
		mes "打扰一下。能抽几分钟给我吗？";
		next;
		mes "[Victor]";
		mes "你是谁？凭什么这样说？我正忙着品尝杯中的葡萄酒。";
		close;
	} else if (mos_swan == 9) {
		mes "["+strcharinfo(0)+"]";
		mes "打扰一下。能抽几分钟给我吗？";
		next;
		mes "[Victor]";
		mes "你是谁？凭什么这样说？我正忙着品尝杯中的葡萄酒。";
		next;
		mes "[Victor]";
		mes "什么？你也在喝酒。好吧，一个人喝酒很孤单，不过我已经习惯了。";
		next;
		mes "[Victor]";
		mes "告诉我你在想什么。我听着。";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "你见过一个寻找黏合剂的小男孩吗？";
		next;
		mes "[Victor]";
		mes "..................";
		next;
		mes "[Victor]";
		mes "你说的是 Mikhail？他真是个多愁善感的孩子，让我很困扰。";
		next;
		mes "[Victor]";
		mes "对了，你怎么知道他来见我？他对你说了什么吗？";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "Mikhail 去拿黏合剂后还没回来。他弄坏了母亲的 Matrushka……";
		next;
		mes "[Victor]";
		mes "…………什么？";
		mes "嗯……天啊……我怀疑他去了那里。";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "那里？";
		next;
		mes "[Victor]";
		mes "是的。恐怖的 Baba Yaga 和其他可怕动物住在那里。";
		next;
		mes "[Victor]";
		mes "那个小男孩几小时前哭着来到这里。";
		mes "他有东西需要粘合，所以需要高强度黏合剂。";
		next;
		mes "[Victor]";
		mes "但我没有那种东西，所以让他带来制作材料。";
		next;
		mes "[Victor]";
		mes "要取得高强度黏合剂的材料，必须前往偏僻沼泽。可以乘船到达，但需要很久。";
		next;
		mes "[Victor]";
		mes "但去沼泽的路非常危险，周围有可怕怪物，用贪婪的目光猎杀一切。";
		next;
		mes "[Victor]";
		mes "尤其是老太婆 Baba Yaga，她会攻击看到的任何人，特别喜欢你这样的年轻人。哈哈！";
		mes "嘻嘻嘻！！";
		next;
		mes "[Victor]";
		mes "……你脸色变白了！哈哈哈！！";
		next;
		mes "[Victor]";
		mes "但是……我有点夸张了，那里确实有可怕的东西。";
		mes "不过我不相信像 Mikhail 那样胆小的孩子会去那里。不可能！";
		next;
		mes "[Victor]";
		mes "我告诉他‘你绝对不能去那里’，让他回家。";
		mes "他提出不可能的要求，所以我用面包安抚他。";
		next;
		mes "[Victor]";
		mes "他因弄坏母亲的 Matrushka 已经吓得脸色发白。你觉得他会去那里吗？";
		next;
		mes "[Victor]";
		mes "他可能只是躲在某处，哈哈！";
		mos_swan = 10;
		changequest 18062,18063;
		close;
	} else if (mos_swan == 10 || mos_swan == 11) {
		mes "[Victor]";
		mes "莫斯科比亚附近有座大岛，乘船到那里要花很久，所以没人愿意去。";
		next;
		mes "[Victor]";
		mes "深入森林，你会找到生长黏性杂草的沼泽。";
		next;
		mes "[Victor]";
		mes "去那里的路充满危险。你觉得像 Mikhail 那样胆小的孩子能去吗？";
		close;
	} else if (mos_swan == 12) {
		mes "[Victor]";
		mes "你回来了。嗯，你不会想让我为他的失踪负责吧？";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "不，我找到他了。你不用担心。";
		next;
		mes "[Victor]";
		mes "那么，你想找我做什么？";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "我答应为他制作高强度黏合剂。为此需要做什么？";
		next;
		mes "[Victor]";
		mes "你为什么这么急着制作？那东西有多重要？嗯，我不在乎……";
		next;
		mes "[Victor]";
		mes "莫斯科比亚附近有座大岛，乘船到那里要花很久，所以没人愿意去。";
		next;
		mes "[Victor]";
		mes "深入森林，你会找到生长黏性杂草的沼泽。";
		next;
		mes "[Victor]";
		mes "你应该带来 ^3131FF‘10 个黏性草’^000000 和 ^3131FF1 个药碗^000000。";
		mos_swan = 13;
		changequest 18065,18066;
		close;
	} else if (mos_swan > 12 && mos_swan < 23) {
		mes "[Victor]";
		mes "如果你想制作黏合剂，就带来 10 个黏性草和 1 个药碗。";
		mes "1 medicine bowl for me.";
		mes "黏性草生长在沼泽。那里可能很危险，但对你应该不是问题吧？";
		close;
	} else if (mos_swan == 23) {
		mes "[Victor]";
		mes "这次你又想找我做什么？？";
		mes "哦，你说你想要黏合剂……你真烦人！";
		next;
		if (countitem(7763) > 9 && countitem(7134)) {
			mes "[Victor]";
			mes "把材料给我！我很快就能做出来。你真烦！";
			next;
			for (.@i = 0; .@i < 3; .@i++)
				mes "- 他发出嘎吱声制作黏合剂。-";
			next;
			for (.@i = 0; .@i < 4; .@i++)
				mes "- 他似乎还在揉搓什么。-";
			next;
			mes "[Victor]";
			mes "好了，完成！我不想再被你打扰！请离开！";
			delitem 7763,10;// Sticky_Herb
			delitem 7134,1;// Medicine_Bowl
			mos_swan = 24;
			getitem 7764,1;// High_Strength_Adhesive
			changequest 18067,18068;
			close;
		}
		mes "[Victor]";
		mes "他真烦人。把材料给我！天啊，那是什么？我说的是 10 个黏性草和 1 个药碗！！";
		next;
		mes "[Victor]";
		mes "虽然我总在酒馆里，但我也有自己的生意……！";
		next;
		mes "[Victor]";
		mes ".............!!!!";
		next;
		mes "[Victor]";
		mes "..................";
		mes "你在盯着什么？现在就把材料带来！";
		close;
	}
	mes "[Victor]";
	mes "你说什么？我只想安静地喝酒！";
	close;
}


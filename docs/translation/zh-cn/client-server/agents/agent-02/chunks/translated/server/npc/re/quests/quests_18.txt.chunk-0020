// Quest: Checking Traps for Food. Step 1 + 3 (final).
wolfvill,197,170,5	script	Larama#ep18	4_M_DESERT,{
	if (rand(2))
		mes "他正忙着磨刀，我叫了他，但没有回应。";
	else {
		mes "[拉拉玛]";
		mes "哦，我现在很忙。之后再聊。";
	}
	close;
}

wolfvill,202,166,3	script	Eruin#ep18	4_F_SHABBY,{
	if (checkweight(1000405,20) == 0) {
		mes "- 请稍等！！-";
		mes "- 你目前携带了-";
		mes "- 太多物品。-";
		mes "- 请再试一次，-";
		mes "- 先减轻负重。-";
		close;
	}
	if (ep18_main < 36) {
		mes "[艾露因]";
		mes "...";
		mes "外来者禁止在这片森林猎捕非怪物动物。";
		mes "不要捕捉兔子。";
		close;
	}
	switch( isbegin_quest(8688) ) {
	case 0:
		mes "[艾露因]";
		mes "……你说有一名冒险者来了。";
		mes "你是在四处游荡，找事情做吗？";
		next;
		if (select( "是", "不是" ) == 2) {
			mes "[艾露因]";
			mes "如果没事做，就别坐在这里看那边的火。";
			close;
		}
		mes "[艾露因]";
		mes "我负责照看那边的牲畜和野生动物，以及艾露因家族的人。";
		mes "我还负责维护刀具和其他刃具。";
		npctalk "照顾好艾露因的祖母～！", "Larama#ep18", bc_self;
		next;
		mes "[艾露因]";
		mes "……啧啧。";
		npctalk "嘿嘿。", "Larama#ep18", bc_self;
		next;
		mes "[艾露因]";
		mes "如果要把一件事交给外来者，那就是检查我今天早上设置的陷阱。";
		mes "你能做到吗？";
		next;
		select( "应该不难" );
		mes "[艾露因]";
		mes "回答得很爽快。";
		mes "...";
		next;
		setquest 8688;
		mes "[艾露因]";
		mes "在<NAVI>[灰狼森林]<INFO>gw_fild01,25,101,0,101,0</INFO></NAVI>附近看看，你会发现很多陷阱。";
		mes "有时间的话，去取回五个。";
		mes "如果不动剩下的诱饵，之后还会有东西上钩，所以等着看就好。";
		next;
		mes "[艾露因]";
		mes "辛苦你了。";
		close;
	case 1:
		.@trap01 = countitem(1000412);
		.@trap02 = countitem(1000413);
		.@trap03 = countitem(1000414);
		if ((.@trap01 + .@trap02 + .@trap03) < 5) {
			mes "[艾露因]";
			mes "我想请你收集大约5件在<NAVI>[灰狼森林]<INFO>gw_fild01,25,101,0,101,0</INFO></NAVI>陷阱中捕获的东西。";
			close;
		}
		if (.@trap01 > 0)
			delitem 1000412, .@trap01;
		if (.@trap02 > 0)
			delitem 1000413, .@trap02;
		if (.@trap03 > 0)
			delitem 1000414, .@trap03;

		completequest 8688;
		setquest 8689;
		getitem 1000405,20;	// Ep18_Amethyst_Fragment
		getexp 7769124,3000000;
		mes "^4d4dff这会让你获得有利的评价。^000000";
		add_reputation_points(REPUTATION_EP18, 100);
		if (get_reputation_points(REPUTATION_EP18) >= 1000 && ep18_main == 36) {// Custom implementation: reputation 1000 on wolfvill => player can continue the main quest
			ep18_main = 37;
			setquest 18082;
			mes "^4d4dff 灰狼村的村民已接受你成为村子的一员。^000000";
			mes "你有资格参加^4d4dff会议。^000000";
		}
		next;
		mes "[艾露因]";
		mes "……好。干得不错。";
		mes "如果你明天有空在这里逗留，我还能再请你帮忙吗？";
		next;
		if (select( "当然", "我明天可能很忙" ) == 2)
			end;
		mes "[艾露因]";
		mes "好。我负责设陷阱和照料，所以一直都在工作。如果你再偷看，我会发现，然后让你干活，免得你来烦我。";
		mes "对外来者也一样。";
		close;
	case 2:
		break;
	}

	// daily
	switch( checkquest(8689,PLAYTIME) ) {
	case -1:
		break;
	case 0:
	case 1:
		mes "[艾露因]";
		mes "今天回去休息吧。";
		close;
	case 2:
		erasequest 8689;
		break;
	}
	switch( isbegin_quest(8690) ) {
	case 0:
		mes "[艾露因]";
		mes "你来了吗？我看你又在附近转悠，看来你有空。";
		next;
		switch( select( "去调查陷阱", "聊天", "离开" ) ) {
		case 1:
			mes "[艾露因]";
			mes "如果你愿意帮忙，我还有很多其他事情要做，所以很感谢你。";
			mes "在附近转一圈，收集我设置的陷阱捕获的5件东西。";
			next;
			if (select( "接受", "拒绝" ) == 2) {
				mes "[艾露因]";
				mes "别坐立不安，安静坐着。你太躁动了。";
				close;
			}
			setquest 8690;
			mes "[艾露因]";
			mes "如果不动剩下的诱饵，还会有其他东西上钩，所以等着看吧。";
			mes "辛苦你了。";
			close;
		case 2:
			mes "[艾露因]";
			mes "别坐立不安，安静坐着。你太躁动了。";
			close;
		case 3:
			mes "[艾露因]";
			mes "你从什么时候开始设置陷阱的？";
			mes "嗯？从你不再当冒险者开始？";
			close;
		}
		end;
	case 1:
		.@trap01 = countitem(1000412);
		.@trap02 = countitem(1000413);
		.@trap03 = countitem(1000414);
		if ((.@trap01 + .@trap02 + .@trap03) < 5) {
			mes "[艾露因]";
			mes "如果你能从<NAVI>[灰狼森林]<INFO>gw_fild01,25,101,0,101,0</INFO></NAVI>收集大约5件陷阱捕获的东西，就太好了。";
			close;
		}
		if (.@trap01 > 0)
			delitem 1000412, .@trap01;
		if (.@trap02 > 0)
			delitem 1000413, .@trap02;
		if (.@trap03 > 0)
			delitem 1000414, .@trap03;

		erasequest 8690;
		setquest 8689;
		add_reputation_points(REPUTATION_EP18, 30);
		if (get_reputation_points(REPUTATION_EP18) >= 5000)
			.@bonus = 1;
		if (get_reputation_points(REPUTATION_EP18) >= 1000 && ep18_main == 36) {// Custom implementation: reputation 1000 on wolfvill => player can continue the main quest
			ep18_main = 37;
			setquest 18082;
			mes "^4d4dff 灰狼村的村民已接受你成为村子的一员。^000000";
			mes "你有资格参加^4d4dff会议。^000000";
		}
		getitem 1000405,3+.@bonus;	// Ep18_Amethyst_Fragment
		getexp 18252408,2000000;
		mes "[艾露因]";
		mes "……好。干得不错。";
		mes "如果你明天也有空来这里，我还能再请你帮忙吗？";
		next;
		if (select( "好", "我明天可能很忙" ) == 2)
			end;
		mes "[艾露因]";
		mes "那就好。";
		mes "他不会拒绝帮助。谢谢。";
		close;
	case 2:	// impossible
		end;
	}
	end;

OnInit:
	// note: the questinfo on official is never removed except by PLAYTIME == 1
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "isbegin_quest(11724) == 2 && isbegin_quest(8688) == 0" );
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "isbegin_quest(8688) == 1" );

	questinfo( QTYPE_DAILYQUEST, QMARK_YELLOW, "isbegin_quest(8688) == 2 && isbegin_quest(8690) == 0 && (checkquest(8689,PLAYTIME) == -1 || checkquest(8689,PLAYTIME) == 2)" );
	questinfo( QTYPE_DAILYQUEST, QMARK_YELLOW, "isbegin_quest(8690) == 1" );
	
	// questinfo( QTYPE_QUEST, QMARK_YELLOW, "isbegin_quest(11724) == 2 && isbegin_quest(8688) == 0" );
	// questinfo( QTYPE_QUEST, QMARK_YELLOW, "isbegin_quest(8688) == 1 && (countitem(1000412)+countitem(1000413)+countitem(1000414)) > 4" );
	// questinfo( QTYPE_DAILYQUEST, QMARK_YELLOW, "isbegin_quest(8688) == 2 && isbegin_quest(8690) == 0 && (checkquest(8689,PLAYTIME) == -1 || checkquest(8689,PLAYTIME) == 2)" );
	// questinfo( QTYPE_QUEST, QMARK_YELLOW, "isbegin_quest(8690) == 1 && (countitem(1000412)+countitem(1000413)+countitem(1000414)) > 4" );
	end;
}

// Quest: Checking Traps for Food. Step 2.
gw_fild01,24,122,0	script	Trap Set#01	CLEAR_NPC,{
	if (checkweight(1000405,20) == 0) {
		mes "- 请稍等！！-";
		mes "- 你目前携带了-";
		mes "- 太多物品。-";
		mes "- 请再试一次，-";
		mes "- 先减轻负重。-";
		close;
	}
	if (ep18_main < 36)
		end;
	if (isbegin_quest(8688) == 1 || isbegin_quest(8690) == 1) {
		.@amount = countitem(1000412) + countitem(1000413) + countitem(1000414);
		if (.@amount >= 5) {
			mes "今天收集的陷阱捕获物已经够了。";
			mes "把它带给<NAVI>[艾露因]<INFO>wolfvill,202,166,0,101,0</INFO></NAVI>吧。";
			close;
		}
		specialeffect2 EF_STEAL;
		progressbar "FFFF00",10;
		.@r = rand(1,5);
		if (.@r == 1)
			getitem 1000412,1;	// Ep18_Trapped01
		else if (.@r == 2)
			getitem 1000413,1;	// Ep18_Trapped02
		else if (.@r == 3)
			getitem 1000414,1;	// Ep18_Trapped03
		else
			mes "什么也没拿到……";
		disablenpc strnpcinfo(0);
		initnpctimer;
		end;
	}
	end;
OnTimer60000:
	enablenpc strnpcinfo(0);
	stopnpctimer;
	end;

OnInit:
	questinfo( QTYPE_CLICKME, QMARK_YELLOW, "isbegin_quest(8688) == 1" );
	questinfo( QTYPE_CLICKME, QMARK_YELLOW, "isbegin_quest(8690) == 1" );
	end;
}
gw_fild01,93,113,0	duplicate(Trap Set#01)	Trap Set#02	CLEAR_NPC
gw_fild01,106,126,0	duplicate(Trap Set#01)	Trap Set#03	CLEAR_NPC

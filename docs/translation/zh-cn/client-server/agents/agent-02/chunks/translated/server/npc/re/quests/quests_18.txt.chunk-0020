// Quest: " + getmonsterinfo("EP18_FIREWIND_KITE", MOB_NAME) + "s. Step 1 + 2 + 3 (final).
wolfvill,147,97,5	script	Ahir#ep18	4_M_DST_CHILD,3,3,{
	if (checkweight(1000405,20) == 0) {
		mes "- 请稍等！！-";
		mes "- 你目前携带了-";
		mes "- 太多物品。-";
		mes "- 请再试一次，-";
		mes "- 先减轻负重。-";
		close;
	}
	if (ep18_main < 36) {
		mes "[阿希尔]";
		mes "啊，外来者……";
		close;
	}
	if (isbegin_quest(16548) != 2) {
		switch( checkquest(16548,HUNTING) ) {
		case -1:
		mes "[阿希尔]";
		mes "哈啊……嗯？是我没见过的人。你是灰狼村的新成员吗？";
		mes "呃……";
			next;
			select( "你昨晚睡得不好吗？" );
			mes "[阿希尔]";
			mes "是的，我一眼都没合上。";
			mes "哈啊……在灰狼森林里躺下睡觉，会听到各种各样的声音。";
			next;
			mes "[阿希尔]";
			mes "萤火虫的声音、成年人的交谈声、野兽的声音……";
			mes "最扰人、会打断睡眠的，是各种怪物的叫声。";
			next;
			mes "[阿希尔]";
			mes "哈啊……其中，" + getmonsterinfo("EP18_FIREWIND_KITE", MOB_NAME) + "的叫声最可怕。";
			mes "人们甚至担心它们带来火星，把整个村子烧毁。";
			next;
			mes "[阿希尔]";
			mes "它们嘴里含着火星叫喊、压低声音的样子真的很恐怖……";
			mes "呃，光是想想我的身体就发抖。";
			next;
			select( "我是冒险者，要我帮你猎捕它们吗？" );
			mes "[阿希尔]";
			mes "哇！你是冒险者？";
			mes "那我一定要请你帮忙！";
			next;
			mes "[阿希尔]";
			mes "你能帮我们只猎捕30只" + getmonsterinfo("EP18_FIREWIND_KITE", MOB_NAME) + "吗？";
			mes "如果猎捕一批，也许" + getmonsterinfo("EP18_FIREWIND_KITE", MOB_NAME) + "今晚就会安静些。";
			next;
			if (select( "交给我吧！", "糟糕，我现在有点麻烦。" ) == 2) {
				mes "[阿希尔]";
				mes "我想像你这样的冒险者也一定很忙，对吧？";
				mes "我知道你现在很忙，但你有没有试过在各种声音中闭上眼睛好好睡一觉？我最近就是这样。";
				close;
			}
			mes "[阿希尔]";
			mes "哇，谢谢你，冒险者！";
			mes "一共30只" + getmonsterinfo("EP18_FIREWIND_KITE", MOB_NAME) + "。拜托你了。";
			next;
			mes "[阿希尔]";
			mes "猎捕完后请回来告诉我。我会准备一份小奖励！";
			setquest 16548;
			close;
		case 0:
		case 1:
			mes "[Ahir]";
			mes "谢谢你，冒险者！";
			mes "一共有30只" + getmonsterinfo("EP18_FIREWIND_KITE", MOB_NAME) + "。拜托你了。";
			close;
		case 2:
			mes "[Ahir]";
			mes "谢谢！风暴风筝的鸣叫声确实减少了！";
			mes "今晚我可以舒服地睡觉了。";
			next;
			mes "[Ahir]";
			mes "好吧，恐怕不会持续太久。";
			mes "明天声音又会变大，但希望你天亮后再来，捕捉一只" + getmonsterinfo("EP18_FIREWIND_KITE", MOB_NAME) + "。";
			next;
			mes "[Ahir]";
			mes "这是让今晚的我能睡个好觉的谢礼。";
			mes "冒险者，请收下这份微薄的心意。";
			completequest 16548;
			setquest 16550;
			getitem 1000405,20;	// Ep18_Amethyst_Fragment
			getexp 7769124,3000000;
			mes " ";
			mes "^4d4dff 你获得了良好评价。^000000";
			add_reputation_points(REPUTATION_EP18, 100);
			if (get_reputation_points(REPUTATION_EP18) >= 1000 && ep18_main == 36) {// Custom implementation: reputation 1000 on wolfvill => player can continue the main quest
				ep18_main = 37;
				setquest 18082;
				mes "^4d4dff 灰狼村的村民接受你成为村子的一员。^000000";
				mes "你有资格参加^4d4dff会议。^000000";
			}
			close;
		}
	}
	switch( checkquest(16550,PLAYTIME) ) {
	case -1:
		break;
	case 0:
	case 1:
		mes "[Ahir]";
		mes "看来" + getmonsterinfo("EP18_FIREWIND_KITE", MOB_NAME) + "仍然潜伏着。";
		mes "如果现在刺激它们，今晚可能会因为邪气而更加吵闹。";
		next;
		mes "[Ahir]";
		mes "你会在天亮后回来捕捉一只" + getmonsterinfo("EP18_FIREWIND_KITE", MOB_NAME) + "吗？";
		mes "拜托你了，冒险者。";
		close;
	case 2:
		erasequest 16550;
		break;
	}
	switch( checkquest(16549,HUNTING) ) {
	case -1:
		mes "[Ahir]";
		mes "唉，今天我又困得不行。";
		mes "冒险者，你能帮我捕捉30只" + getmonsterinfo("EP18_FIREWIND_KITE", MOB_NAME) + "吗？";
		next;
		mes "[Ahir]";
		mes "如果你成群猎捕，" + getmonsterinfo("EP18_FIREWIND_KITE", MOB_NAME) + "今晚大概就会安静了。";
		next;
		if (select( "当然，我会全部捕捉。", "我没兴趣捕捉它们。" ) == 2) {
			mes "[阿希尔]";
			mes "我想你也很忙吧，冒险者？";
			mes "你一定累了，去休息吧。不过有这么多鸣叫声，可能很难睡着。";
			close;
		}
		mes "[Ahir]";
		mes "哇，谢谢你，冒险者！";
		mes "一共30只" + getmonsterinfo("EP18_FIREWIND_KITE", MOB_NAME) + "，真的非常感谢。";

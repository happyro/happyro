		npctalk "大家都是这样调整的。", "Old Man#hms05", bc_self;
		next;
		select( "我……" );
		mes "[老人]";
		mes "你是谁？我不认识你。";
		npctalk "这是新来的人吗？", "Old Man#hms05", bc_self;
		npctalk "我没有忘记什么吧？", "Old Man#hms06", bc_self;
		next;
		mes "[老人]";
		mes "哦，你又回来了？之前不是来过了吗？你今后会经常来这里吗？";
		next;
		mes "[老人]";
		mes "欢迎，欢迎，欢迎！有问题尽管问。";
		next;
		mes "[老人]";
		mes "尽管问吧，这里不是每个人都会介意。";
		next;
		select( "我是来处理诊所的事……" );
		mes "[老人]";
		mes "什么？诊所？他们正在建的不会就是诊所吧？";
			npctalk "当然。不然还能是什么？", "Old Man#hms05", bc_self;
		next;
		mes "[老人]";
		mes "我觉得我已经说得够清楚了。这里不需要建诊所，你们不该建。";
		next;
		mes "[老人]";
		mes "既然现在这里就能治疗，为什么还要建一座新建筑，还是一座外来的建筑？";
		next;
		mes "[老人]";
		mes "没有它，我们不也一直这样生活吗？";
		next;
		select( "因为医疗设施很重要。" );
		mes "[老人]";
		mes "不，什么？你的意思是我们觉得它不重要吗？难道我们还不够好吗？";
			npctalk "我们发脾气不是没有理由的。", "Old Man#hms06", bc_self;
		next;
		mes "[老人]";
		mes "我们知道它很好、很方便，也知道它有多好，但你不能习惯它。";
		next;
		mes "[老人]";
		mes "我们会习惯外来者的生活方式，最终离不开它带来的便利。";
		npctalk "这正是占领我们土地的人想要的。", "Old Man#hms05", bc_self;
		next;
		mes "[老人]";
		mes "你现在拥有的已经足够了，但不该依赖它。那意味着失败。";
		next;
		select( "但这是必要的设施。" );
		mes "[老人]";
		mes "这里从来没有缺少治疗，否则我们也不可能在这里生存这么久。";
		next;
		mes "[老人]";
		mes "总之，我就是这么认为的。即使我已经委婉地说了，你还是不明白。";
		next;
		mes "[老人]";
		mes "如果你今后想住在这里，最好尽快忘记那边的生活。";
		next;
		mes "[老人]";
		mes "你越早适应这里的生活，就会过得越好。";
		next;
		select( "我不是……我不是这里的人……" );
		mes "[老人]";
		mes "什么？你甚至不是这里的人？你有什么权利插手？";
		next;
		mes "[老人]";
		mes "冷静。你可以做到。别生他的气，他一直在帮助你们的孩子。";
		next;
		mes "[老人]";
		mes "关于诊所的<NAVI>[那颗牙]<INFO>wolfvill,171,253,0,101,0</INFO></NAVI>，我们之后再谈，但我认为应该把外来者排除在外。";
		erasequest 17504;
		setquest 17505;
		close;
	}
	if (isbegin_quest(17505) == 1) {
		mes "[Old Man]";
		mes "关于诊所的<NAVI>[那颗牙]<INFO>wolfvill,171,253,0,101,0</INFO></NAVI>，我们之后再谈，但我认为应该把外来者排除在外。";
		close;
	}
	mes "[老人]";
	mes "我得去找新来的人了。";
	close;

OnInit:
	questinfo( QTYPE_QUEST2, QMARK_YELLOW, "isbegin_quest(17504) == 1" );
	end;
}

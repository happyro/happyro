		else if (.@gamble1 < 501) .@item = 2108; // Mirror Shield[1]
		break;
	default: // Cancel button / hack
		cutin "katsua01.bmp",255;
		close;
		break;
	}
	getitem .@item,1;
	cutin "katsua01.bmp",255;
	cutin "katsua02.bmp",2;
	mes "[卡秋娅]";
	mes "啊~ 那颗钻石真漂亮。";
	mes "真希望能更好地报答你。";
	close2;
	cutin "katsua02.bmp",255;
	end;
}

comodo,204,148,7	script	Devellin	4_F_01,{
	mes "[德维林]";
	mes "好像不久前有个旅行者给卡秋娅看了";
	mes "一颗巨大的钻石。从那以后，她满口都是钻石和对它们的渴望。";
	next;
	mes "[德维林]";
	mes "她变得相当执着，这让我害怕。她似乎愿意用自己拥有的一切换一颗钻石。";

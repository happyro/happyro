	close;
}

comodo,210,154,2	script	Suspicious Guy#cmd	2_M_THIEFMASTER,{
	if (BaseClass == Job_Thief){
		mes "[凯恩]";
		mes "嘿……";
		mes "看来你我做的是同一行。嘿嘿，给你个热门消息。";
		next;
		mes "[凯恩]";
		mes "我一直向别人收费提供这消息，不过既然我们同行，就不收你的 Zeny 了。";
		next;
		mes "[凯恩]";
		mes "看到那边的女士了吗？";
		mes "她完全迷恋钻石。据我的消息，她富得流油，有成堆的贵重物品。";
		next;
		mes "[凯恩]";
		mes "我说的是稀有物品。";
		mes "我偷偷看过她的收藏，发现她有羊角头盔，甚至还有王冠！她有钱得离谱！";
		next;
		mes "[凯恩]";
		mes "传闻她还有一批稀有装备和武器！怎么样？要不要合作犯罪，去抢她的房子？";
		next;
		switch(select("不用了，谢谢。:好，我加入！")){
		case 1:
			mes "[凯恩]";
			mes "什……？";
			mes "来吧！我以为盗窃就是你的专长！算了，我会去做，但你要对此保密，明白吗？";
			close;
		case 2:
			mes "[凯恩]";
			mes "哈哈哈！";
			mes "……^660000笨蛋^000000！";
			mes "我只是开玩笑，";
			mes "忘了这事吧！";
			next;
			mes "[凯恩]";
			mes "对了，据说有座山里埋着大量钻石。我的朋友说山附近还有矿井，去那里应该能找到钻石。";
			next;
			mes "[凯恩]";
			mes "去那里收集钻石，再和老太太交换她的收藏应该不会有坏处。保重，朋友~";
			close;
		}
	}
	mes "[凯恩]";
	mes "嘿……";
	mes "我有个热门消息告诉你。";
	mes "只要 500 Zeny，";
	mes "相信我，绝对值得。";
	mes "怎么样……？";
	next;
	switch(select("好吧。:不用了，谢谢。")){
	case 1:
		if (Zeny > 499){
			mes "[凯恩]";
			mes "看到那边的女士了吗？她完全迷恋钻石。据我的消息，她富得流油，有成堆的贵重物品。";
			next;
			mes "[凯恩]";
			mes "我说的是稀有物品。";
			mes "我偷偷看过她的收藏，发现她有羊角头盔，甚至还有王冠！她有钱得离谱！";
			next;
			mes "[凯恩]";
			mes "稀有装备和武器可能会成为你的！她愿意用任何东西换 3 克拉钻石。如果你有，不妨去找她。";
			next;
			mes "[凯恩]";
			mes "对了，据说有座山里埋着大量钻石，";
			mes "我的朋友说山附近还有矿井，去那里应该能找到钻石。";
			next;
			mes "[凯恩]";
			mes "去那里收集钻石，再和老太太交换她的收藏应该不会有坏处。保重，朋友~";
			Zeny = Zeny-500;
			close;
		}
		mes "[凯恩]";
		mes "搞什么？！";
		mes "你没钱吗？我不是说 500 Zeny 吗？这种消息可不便宜！";
		close;
	case 2:
		mes "[凯恩]";
		mes "嘿嘿！";
		mes "你是吝啬鬼吗？万物皆有价格，这消息绝对值这个价。来吧，你不会错过的，对吧？";
		close;
	}
}


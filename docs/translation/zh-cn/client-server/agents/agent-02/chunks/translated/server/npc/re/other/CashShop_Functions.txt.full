//===== rAthena Script =======================================
//= Cash Shop Functions
//===== Description: =========================================
//= Functions related to the VIP system.
//===== Changelogs: ==========================================
//= 1.0 Moved VIP_Third_Class function
//=	from other/CashShop_Functions. [Capuche]
//============================================================

// VIP Functions
//============================================================
function	script	VIP_Third_Class	{
	if (!vip_status(VIP_STATUS_ACTIVE)) {
		mes "[来自虚空的声音]";
		mes "只有拥有一定数量重置石的人才能使用高级内容。";
		next;
		if (countitem(6320) < 1) {
			mes "[来自虚空的声音]";
			mes "要转职为三转职业，你必须带来 1 个^0000CC重置石^000000，或拥有高级账号。";
			//mes "Please visit our iShop to purchase the ^0000CCReset Stone^000000.";
			close;
		} else {
			mes "[来自虚空的声音]";
			mes "你愿意用 1 个^0000CC重置石^000000参加这项任务吗？";
			next;
			switch(select("是:否")) {
			case 1:
				mes "[来自虚空的声音]";
				mes "祝你好运，冒险者。";
				delitem 6320,1; //Premium_Reset_Stone
				next;
				break;
			case 2:
				mes "[来自虚空的声音]";
				mes "好的。";
				close;
			}
		}
	}
	return;
}

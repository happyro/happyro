//===== rAthena Script =======================================
//= Eden Group Quests - Mission [100-111]
//===== By: ==================================================
//= Capuche
//===== Current Version: =====================================
//= 1.2
//===== Compatible With: =====================================
//= rAthena Project
//===== Description: =========================================
//= [Official Conversion]
//= Repeatable quests for players between BaseLevel 100 - 111.
//===== Additional Comments: =================================
//= 1.0 First version.
//= 1.1 Added support to Para_Team_Mark_ in Eden Group. [Ragno]
//= 1.2 Added use of F_HasEdenGroupMark function. [Ragno]
//============================================================

moc_para01,37,95,5	script	Gelkah#1	4_F_GELKA,{
	cutin "gelca01",2;
	if (checkweight(1201,1) == 0) {
		mes "^FF0000-警告信息-";
		mes "- 请稍等！！-";
		mes "- 你携带的物品太多-";
		mes "- 无法接收物品。-";
		mes "- 请减轻负重-";
		mes "- 请再试一次。-^000000";
		close2;
		cutin "",255;
		end;
	}
	mes "[Gelkah]";
	if (!callfunc("F_HasEdenGroupMark")) {
		mes "给我看看你属于伊甸园集团的证明，否则我没什么要和你谈的。";
		mes "我为基础等级^FF0000100～110^000000的冒险者发布委托。";
	}
	else if (BaseLevel < 100) {
		mes "你还不是足够成熟的冒险者。基础等级至少要达到100，也就是至少三转职业。";
		next;
		mes "[Gelkah]";
		mes "这份委托来自米德加尔特以外的^FF0000其他地方^000000。";
	}
	else if (BaseLevel < 111) {
		if (para_100lv01 == 0) {
			mes "冒险者们！";
			emotion ET_SMILE;
			next;
			cutin "gelca03",2;
			mes "[Gelkah]";
			mes "最近我收到几份委托，委托人需要像你这样的冒险者帮助。";
			next;
			if (select( "我喜欢委托！", "无聊的任务……不用了，谢谢！" ) == 2) {
				mes "[Gelkah]";
				mes "你知道越困难的委托奖励越丰厚，对吧？";
				next;
			}
			mes "[Gelkah]";
			mes "其实，我不能随便接受路边来的陌生人。我的师父讨厌优柔寡断的人。";
			next;
			if (select( "谁是你的师父？", "我才不是优柔寡断的人！" ) == 1) {
				cutin "gelca03",2;
				mes "[Gelkah]";
				mes "站在我旁边的那个人就是我的师父……他经过长途修行后回来了。";
				next;
				mes "[Gelkah]";
				mes "我理解你可能会疑惑，为什么修罗会请大主教当老师……";
			}
			else {
				cutin "gelca03",2;
				mes "[Gelkah]";
				if (BaseLevel < 110)
					mes "你只是成为三转职业，就觉得自己是老手了吗……";
				else
					mes "我知道你不算初心者，但我的师父认为你和初心者没什么不同。依我看，你是很棒的冒险者！";
			}
			next;
			mes "[Gelkah]";
			mes "我们需要愿意提供帮助的冒险者。你愿意帮助我们吗？";
			next;
			cutin "gelca01",2;
			if (select( "好，我会帮忙。", "我没兴趣帮助你。" ) == 2) {
				mes "[Gelkah]";
				mes "不去做又怎么会知道呢。";
			}
			else {
				mes "[Gelkah]";
				mes "这就是冒险者该做的事！";
				next;
				mes "[Gelkah]";
				mes "我想知道你是否有能力完成委托。让我看看……";
				next;
				mes "[Gelkah]";
				mes "收集50个^ff0000布里甘。^000000这是一个简单又复杂的测试。";
				next;
				mes "[Gelkah]";
				mes "在海底洞穴或古城的魔物身上很容易找到。";
				next;
				mes "[Gelkah]";
				mes "完成简单任务后，我们再开始真正的委托。";
				setquest 13002;// Brigan collecting
				para_100lv01 = 1;
				para_100lv02 += 1;
			}
		}
		else if (para_100lv01 == 1) {
			if (countitem(7054) > 49) {// Brigan
				mes "我让你收集的布里甘都带来了吗？";
				next;
				mes "[Gelkah]";
				mes "不用一个个数。这份委托是为了选出最优秀的冒险者。";
				next;
				mes "[Gelkah]";
				mes "别生气，因为冒险者在委托中受伤时最终由师父负责。";
				next;
				mes "[Gelkah]";
				mes "师父认为冒险者的安全很重要，因为很多新委托都很危险。";
				next;
				cutin "rote01",2;
				mes "[Rohtert]";
				mes "嗯……";
				emotion ET_HNG, getnpcid(0, "Rohtert#12");
				next;
				cutin "gelca01",2;
				mes "[Gelkah]";
				mes "希望你没有偷看。对你完成普通委托能力的评估快结束了。";
				next;
				mes "[Gelkah]";
				mes "没时间制作^ff0000伊甸园集团高级徽章^000000了。";
				next;
				mes "[Gelkah]";
				mes "^ff0000时间就是金钱，初心者！^000000";
				mes "我想真正的师父说话就是这样，对吧？";
				next;
				mes "[Gelkah]";
				mes strcharinfo(0) +" will make a request list for you so go talk to my Master now and show your respects.";
				delitem 7054,50;// Brigan
				completequest 13002;// Brigan collecting
				para_100lv01 = 2;
				getitem 6549,1;// Courtesy_Ticket
			}
			else {
				cutin "gelca02",2;
				mes "还没找到50个布里甘吗？师父说这是很简单的任务……";
				next;
				mes "[Gelkah]";
				mes "请快一点！我们需要真正的冒险者来完成委托。";
			}
		}
		else if (para_100lv01 == 2)
			mes "等一下。我正在制作委托清单，只是不知道该给你哪一份。我可是个好人。";
		else if (para_100lv01 > 2) {
			mes "委托清单准备好了。要开始吗？";
			next;
			switch( select( "狩猎委托", "询问近况", "出示善意通行证" ) ) {
				mes "[Gelkah]";
			case 1:
				mes "不必一次接受所有委托。选择适合你技能的区域，在完成委托的同时享受旅程。";
				next;
				switch( select( "古城相关委托", "灰色荒野相关委托", "冰洞相关委托", "熔岩地下城相关委托", "其他委托" ) ) {
					mes "[Gelkah]";
				case 1:
					mes "这些是古城地区的委托。";
					next;
					switch( select( "猎杀卡拉特", "猎杀石砾怪", "猎杀鳄鱼人", "猎杀刺猬虫", "猎杀米诺斯" ) ) {
						mes "[Gelkah]";
					case 1:
						if (checkquest(13004,PLAYTIME) == 0)
							mes "你刚完成一份委托。休息一会儿很重要，总会有新的委托等着你。";
						else if (checkquest(13003,HUNTING) == 1) {
							cutin "ĳ��ī��",3;  //carat_card
							mes "这份委托要求清除古城城堡一楼的^0000FF30只^000000^FF0000卡拉特^000000。";
							next;
							cutin "gelca01",2;
							mes "[Gelkah]";
							mes "完成委托后请告诉我。";
						}
						else if (checkquest(13003,HUNTING) == 2) {
							mes "拜访那座可怕的古老城堡一定很辛苦。总有一天我也会去体验的。";
							callsub S_Quest,13003,13004,106000,148000;
						}
						else {
							cutin "ĳ��ī��",3;  //carat_card
							mes "这份委托来自梦罗克的一名商人，他不知为何因古城的这些魔物而生意受损。";
							next;
							mes "[Gelkah]";
							mes "伊甸园集团知道这理由不算充分，但委托就是委托。请清除古城城堡内的^FF000030卡拉特^000000魔物。";
							callsub S_Quest,13004,13003;
						}
						break;
					case 2:
						if (checkquest(13006,PLAYTIME) == 0)
							mes "你刚完成一份委托。请休息一下，总会有委托等着你。";
						else if (checkquest(13005,HUNTING) == 1) {
							cutin "��ũ��콺ī��",3;  //arclouse_card
							mes "请清除^FF000022只石砾怪^000000。";
							next;
							cutin "gelca01",2;
							mes "[Gelkah]";
							mes "清除委托目标后请告诉我。";
						}
						else if (checkquest(13005,HUNTING) == 2) {
							mes "你做得很好。";
							emotion ET_BEST;
							callsub S_Quest,13005,13006,106000,148000;
						}
						else {
							cutin "��ũ��콺ī��",3;  //arclouse_card
							mes "你知道米德加尔特有一种豆子可以食用吗？石砾怪蜷缩起来时很像豆子。";
							next;
							mes "[Gelkah]";
							mes "伊甸园集团总部想调查石砾怪，看看它是否能成为吉祥物。";
							next;
							mes "[Gelkah]";
							mes "请清除^FF000022只石砾怪^000000。";
							if (callsub( S_Quest,13006,13005 ) == 0) {
								mes "[Gelkah]";
								mes "真遗憾。这本来是个有趣的委托。";
							}
						}
						break;
					case 3:
						if (checkquest(13008,PLAYTIME) == 0)
							mes "你刚完成一份委托。冒险很重要，但休息也同样重要。总会有新的委托等着你。";
						else if (checkquest(13007,HUNTING) == 1) {
							cutin "�Ƴ��ī��",3;  //anolian_card
							mes "一名僧侣正在进行朝圣，希望有人保护他免受鳄鱼般生物的侵扰。";
							next;
							mes "[Gelkah]";
							mes "总之，这份委托要求清除地下水道中的鳄鱼人，为安全朝圣开路。";
							next;
							cutin "gelca01",2;
							mes "[Gelkah]";
							mes "清除委托目标后请告诉我。";
						}
						else if (checkquest(13007,HUNTING) == 2) {
							mes "你很好地完成了这份委托。";
							callsub S_Quest,13007,13008,112000,186500;
						}
						else {
							cutin "�Ƴ��ī��",3;  //anolian_card
							mes "古城似乎不仅是冒险者的圣地，也是僧侣的圣地。我不知道那里究竟有什么吸引他们。";
							next;
							mes "[Gelkah]";
							mes "从修道院前往地下水道是一段旅程。这份委托要求清除古城下水道中的^FF000030鳄鱼人^000000，确保朝圣安全。";
							callsub S_Quest,13008,13007;
						}
						break;
					case 4:
						if (checkquest(13010,PLAYTIME) == 0)
							mes "你刚完成一份委托。冒险很重要，但休息也同样重要。总会有新的委托等着你。";
						else if (checkquest(13009,HUNTING) == 1) {
							cutin "����ī��",3;  //sting_card
							mes "地下水道和地下洞窟里有很多刺猬虫，所以很容易清除。";
							next;
							mes "[Gelkah]";
							mes "这份委托要求清除地下水道和地下洞窟中的^FF000030刺猬虫^000000，确保朝圣安全。";
							next;
							cutin "gelca01",2;
							mes "[Gelkah]";
							mes "清除委托目标后请告诉我。";
						}
						else if (checkquest(13009,HUNTING) == 2) {
							mes "前往又脏又臭的地下区域一定很辛苦。对你来说会是很好的体验。";
							callsub S_Quest,13009,13010,112000,186500;
						}
						else {
							cutin "����ī��",3;  //sting_card
							mes "你听说过僧侣朝圣吗？地下水道和洞窟里有很多刺猬虫，打扰了平静的僧侣。";
							next;
							mes "[Gelkah]";
							mes "师父尊重那些僧侣，所以接受了这份委托。任务是清除地下水道中的^FF000030刺猬虫^000000，确保朝圣安全。";
							callsub S_Quest,13010,13009;
						}
						break;
					case 5:
						if (checkquest(13012,PLAYTIME) == 0)
							mes "你刚完成一份委托。冒险很重要，但休息也同样重要。朝圣还会继续，所以之后还会有新的委托。";
						else if (checkquest(13011,HUNTING) == 1) {
							cutin "��������ν�ī��",3;  //majoruros_card
							mes "我想知道这些僧侣不断朝圣的原因……一定有什么隐藏理由。";
							next;
							mes "[Gelkah]";
							mes "我以前负责这份委托，但很担心。任务是清除地下洞窟二楼的^FF000030米诺斯^000000。";
							next;
							cutin "gelca01",2;
							mes "[Gelkah]";
							mes "清除委托目标后请告诉我。";
						}
						else if (checkquest(13011,HUNTING) == 2) {
							mes "长途朝圣一定很累。";
							mes "这会是很好的体验。";
							callsub S_Quest,13011,13012,112000,252000;
						}
						else {
							cutin "��������ν�ī��",3;  //majoruros_card
							mes "僧侣的朝圣目的地在古城城堡地下洞窟二楼。这不是轻松的旅程，但会是很好的体验。";
							next;
							mes "[Gelkah]";
							mes "米诺斯并不容易猎杀，请小心。任务是清除地下洞窟二楼的^FF000030米诺斯^000000。";
							callsub S_Quest,13012,13011;
						}
					}
					break;
				case 2:
					mes "米德加尔特远征队送来了许多委托。";
					next;
					if (select( "狩猎委托","创伤" ) == 1) {
						mes "[Gelkah]";
						if (checkquest(13014,PLAYTIME) == 0)
							mes "你刚完成一份委托。冒险很重要，但休息也同样重要。 请休息一下。 There will always be a request for you.";
						else if (checkquest(13013,HUNTING) == 1) {
							cutin "�ɱ�ŧ��ī��",3;  //pinguicula_card
							mes "外面的空间很神秘……魔物也很独特。";
							next;
							mes "[Gelkah]";
							mes "这是一份特别的委托。请清除^FF000030食人花^000000。";
							next;
							cutin "gelca01",2;
							mes "[Gelkah]";
							mes "清除委托目标后请告诉我。";
						}
						else if (checkquest(13013,HUNTING) == 2) {
							mes "前往灰色荒野一定很辛苦。";
							mes "这会是很好的体验。";
							callsub S_Quest,13013,13014,106000,148000;
						}
						else {
							cutin "�ɱ�ŧ��ī��",3;  //pinguicula_card
							mes "食人花是冒险者进入灰色荒野后遇到的第一批魔物之一。他们希望我们减少远征营地周围的魔物。";
							next;
							mes "[Gelkah]";
							mes "遇到陌生魔物时更容易发生事故，这是很常见的委托。请清除^FF000030食人花^000000。";
							callsub S_Quest,13014,13013;
						}
					}
					else {
						mes "[Gelkah]";
						if (checkquest(13016,PLAYTIME) == 0)
							mes "你刚完成一份委托。冒险很重要，但休息也同样重要。 请休息一下。 This request is not worth working so hard.";
						else if (checkquest(13015,HUNTING) == 1) {
							cutin "��ÿö󺣽���ī��",3;  //luciola_vespa_card
							mes "这是一份奇怪、理由也奇怪的委托，但我们还是应该接受。";
							next;
							mes "[Gelkah]";
							mes "请清除^FF000030萤光花甲虫^000000。";
							next;
							cutin "gelca01",2;
							mes "[Gelkah]";
							mes "清除委托目标后请告诉我。";
						}
						else if (checkquest(13015,HUNTING) == 2) {
							mes "完成这种奇怪的委托一定很辛苦。";
							callsub S_Quest,13015,13016,112000,186500;
						}
						else {
							cutin "��ÿö󺣽���ī��",3;  //luciola_vespa_card
							mes "这是一份非常私人的委托。虽然很不寻常，但委托人是和罗特尔特关系很好的冒险者，由俊美少年提出。他为什么要写这个？";
							next;
							mes "[Gelkah]";
							mes "因为他小时候被蜜蜂蛰过，留下了心理创伤，所以无法前往灰色荒野。";
							next;
							mes "盖尔卡正盯着罗特尔特。";
							next;
							mes "[Gelkah]";
							mes "看来这份委托是为了增加前往新世界的旅行者。请清除^FF000030萤光花甲虫^000000。";
							callsub S_Quest,13016,13015;
						}
					}
					break;
				case 3:
					mes "拉赫的冰洞附近和内部有许多委托。";
					next;
					switch( select( "猎杀沙漠之狼", "猎杀雪怪", "冰巨人……" ) ) {
						mes "[Gelkah]";
					case 1:
						if (checkquest(13018,PLAYTIME) == 0)
							mes "你刚完成一份委托。冒险很重要，但休息也同样重要。";
						else if (checkquest(13017,HUNTING) == 1) {
							cutin "����Ʈ����ī��",3;  //desert_wolf_card
							mes "你读过旧书吗？那是关于冒险者与巨狼战斗，最后成为朋友的故事，书名叫《与狼共舞桑巴》。";
							next;
							mes "[Gelkah]";
							mes "小说终究是小说。请清除拉赫冰洞入口附近的^FF000030沙漠之狼^000000。";
							next;
							cutin "gelca01",2;
							mes "[Gelkah]";
							mes "清除委托目标后请告诉我。";
						}
						else if (checkquest(13017,HUNTING) == 2) {
							mes "很可爱吧？";
							mes "这会是很好的体验。";
							callsub S_Quest,13017,13018,106000,148000;
						}
						else {
							cutin "����Ʈ����ī��",3;  //desert_wolf_card
							mes "冰洞就在拉赫正北方。问题是游客前往冰洞时会被狼群吓到。";
							next;
							mes "[Gelkah]";
							mes "如果能和狼交谈并跳桑巴一定很有趣！请清除冰洞附近的^FF000030沙漠之狼^000000。";
							callsub S_Quest,13018,13017;
						}
						break;
					case 2:
						if (checkquest(13020,PLAYTIME) == 0)
							mes "你刚完成一份委托。冒险很重要，但休息也同样重要。";
						else if (checkquest(13019,HUNTING) == 1) {
							cutin "�����̾�ī��",3;  //snowier_card
							mes "呼吸粗重、眼神不安、寒冷刺骨……这不是简单的委托，先让自己暖和起来。";
							next;
							mes "[Gelkah]";
							mes "请清除冰洞二楼的^FF000030雪怪^000000。";
							cutin "gelca01",2;
							next;
							mes "[Gelkah]";
							mes "清除委托目标后请告诉我。";
						}
						else if (checkquest(13019,HUNTING) == 2) {
							mes "前往冰冷的冰洞一定很辛苦。";
							mes "这会是很好的体验。";
							callsub S_Quest,13019,13020,106000,148000;
						}
						else {
							cutin "�����̾�ī��",3;  //snowier_card
							mes "去过冰洞的人说有吵闹的魔物打扰他们。若你能忍受，请清除它们。";
							next;
							mes "[Gelkah]";
							mes "请清除冰洞二楼的^FF000030雪怪^000000。";

pub_cat,93,105,3	script	Philofontes#171_cat	4_M_PHILOFONTES,{
	if (terra_gloria_main < 26) {
		mes "[Tes]";
	mes "谁能想到还有这样的地方。";
	mes "比你想象的更令人惊讶。";
		close;
	}
	if (terra_gloria_main == 26 && isbegin_quest(7850) < 2) {
		cutin "ep16_tes01",1;
	npctalk "就是这里。","",bc_self;
		mes "[Tes]";
	mes "我一直在等你。";
	mes "这里有点混乱，但叛乱军很喜欢这里。";
		next;
		mes "[Tes]";
	mes "你执行其他任务时，这里会作为基地。";
		next;
		mes "[Tes]";
	mes "总之，我分析了上次行动收集的所有情报。";
	mes "结果发现还有更多设有秘密实验室的设施。";
		next;
		mes "[Tes]";
	mes "开始研究时我们就预料到了。";
	mes "这次不只是推测，证据已经很明确。";
		next;
		mes "[Tes]";
	mes "埃琳娜·沃尔科娃正在组织侦察队调查可疑区域。";
	mes "如果你也加入她的队伍，一定会有很大帮助……";
		next;
		cloakoffnpc "Elena Volkova#171_cat",getcharid(0);
		cutin "162elena_02",2;
		mes "[Elena Volkova]";
	mes "嘿～泰丝！";
	mes "我们派了侦察队调查你说的区域。";
		next;
	select("在哪里？");
		cutin "162elena_01",2;
		mes "[Elena Volkova]";
	mes "哦，你就是冒险者？泰丝叫你来的吗？";
	mes "如果有你这么强的人加入，我们会轻松很多。";
		next;
		mes "[Elena Volkova]";
	mes "你确定是这个地方吗？";
	mes "拉奇说这里只是矿井关闭后的废弃冶炼厂。";
		next;
		cutin "ep16_tes01",1;
		mes "[Tes]";
	mes "我知道这里看起来没什么，";
	mes "但多亏沃纳研究所之前收集的数据……";
	mes "我们找到了通往^4D4DFF鲁杜斯废弃地^000000的入口。";
		next;
		mes "[Tes]";
	mes "我们找到了进入其中的路线或位置，所以想请你进一步调查。";
		next;
		cutin "162elena_01",2;
		mes "[Elena Volkova]";
	mes "总之，就是这个进行各种实验的区域？";
	mes "那我去现场。";
	mes "冒险者随后跟来。";
		next;
		cutin "ep16_tes01",1;
		mes "[Tes]";
	mes "那我会另外把你的位置告诉冒险者。";
		next;
		cutin "162elena_01",2;
		mes "[Elena Volkova]";
	mes "交给我吧。";
		next;
		cloakonnpc "Elena Volkova#171_cat",getcharid(0);
		cutin "ep16_tes01",1;
		mes "[Tes]";
	mes "为什么不加入我们，亲自看看情况？";
	mes "地点是艾因布罗克东北部平原。行动代号是鲁杜斯。";
		next;
		mes "[Tes]";
	mes "今后我会把这个地点称为<NAVI>[鲁杜斯]<INFO>ein_fild05,158,284,0,101,0</INFO></NAVI>。";
	mes "如果你愿意加入，我会很感激。";
		if (isbegin_quest(7850) == 0)
			setquest 7850;
		completequest 7850;
		setquest 7851;
		next;
		mes "[Tes]";
	mes "同时我会继续了解更多关于莱赫尔恩的情报。";
	mes "现在你应该已经有足够情报开始调查。";
		close3;
	}
	if (isbegin_quest(7859) == 0) {
		cutin "ep16_tes01",1;
		mes "[Tes]";
	mes "<NAVI>[鲁杜斯]<INFO>ein_fild05,158,284,0,101,0</INFO></NAVI>位于艾因布罗克东北部平原。";
	mes "如果你加入侦察队，一定会有帮助。";
		close3;
	}
	if (isbegin_quest(7859) == 1) {
		cutin "ep16_tes01",1;
		mes "[Tes]";
	mes "你去过那里了？";
	mes "嗯，你在封闭矿井里发现了屏障，后面还有怪物？";
		next;
		mes "[Tes]";
	mes "即使参考其他成员的报告，我也不认为那是研究设施。";
	mes "那里似乎是掩盖失败实验的地方。";
		next;
		cutin "ep16_tes03",1;
		mes "[Tes]";
	mes "不知为何，外面没有发生事故。啧。";
	mes "暂时我打算和叛乱军分开行动。";
		next;
		mes "[Tes]";
	mes "遗憾的是，鲁杜斯没有带来好结果。沃尔科娃帮了很大的忙。";
		next;
		cutin "ep16_tes01",1;
		mes "[Tes]";
	mes "我现在得去后门房间。";
	mes "看来我招来了糟糕的客人，但有冒险者帮忙应该不会有问题。";
		completequest 7859;
		setquest 7860;
		cloakoffnpc "Philofontes#171_cat2",getcharid(0);
		cloakoffnpc "Middle-Aged Man#171_cat",getcharid(0);
		cloakoffnpc "Rekenber Senior Guard#171_cat",getcharid(0);
		cloakoffnpc "Commander Est#171_cat",getcharid(0);
		close3;
	}
	if (isbegin_quest(7860) == 1) {
		cutin "ep16_tes01",1;
		mes "[Tes]";
	mes "就是那边的房间。只有叛乱军首领能进出那里。";
	mes "所有队长都在里面。";
		close3;
	}
	if (isbegin_quest(7861) == 1) {
		cutin "ep16_tes01",1;
		mes "[Tes]";
	mes "那是总部左上方的建筑，位于<NAVI>[莱赫尔恩]<INFO>lighthalzen,56,270,0,101,0</INFO></NAVI>。";
	mes "阿斯派出的雷根贝勒守卫和共和国派出的部队会在那里。";
		next;
		mes "[Tes]";
	mes "埃斯特也会在那里，你很容易找到位置。";
	mes "希望这次任务顺利。";
		close3;
	}
	if (isbegin_quest(7862) == 2 && isbegin_quest(7864) == 0) {
		cutin "ep16_tes01",2;
		mes "[Tes]";
	mes "你回来了。";
	mes "埃斯特先回来了，我还不确定你是不是出了什么事。";
		next;
		mes "[Tes]";
	mes "我从埃斯特那里得到的情报令人难以置信。";
	mes "而且懒惰似乎有事要告诉你。";
		next;
		mes "[Tes]";
	mes "卡雅应该也在那里。";
	mes "我得分析大家交给我的数据，已经堆积如山了。";
	mes "你已经有足够多的事要做。";
		setquest 7864;
		getitem 25669,25;
		getexp 800000,800000;
		cloakoffnpc "Lazy#171_cat",getcharid(0);
		cloakoffnpc "Kaya Tos#171_cat",getcharid(0);
		cloakoffnpc "Aas#171_cat",getcharid(0);
		close3;
	}
	if (isbegin_quest(7863) == 1) {
		cutin "ep16_tes01",2;
		mes "[Tes]";
	mes "这和实验室的安保有关吗？";
	mes "阿斯告诉我你有东西要交。";
		next;
		mes "[Tes]";
	mes "我想这是施莱因有意留下这些文件。";
	mes "啧，那个施莱因。";
		next;
		mes "[Tes]";
	mes "我明白了。";
	mes "我会和其他材料一起分析。";
		getexp 200000,200000;
		completequest 7863;
		close3;
	}
	if (isbegin_quest(7864) == 1) {
		cutin "ep16_tes01",2;
		mes "[Tes]";
	mes "懒惰似乎在做什么。";
	mes "他就在酒馆某处，去找他吧。";
		cloakoffnpc "Lazy#171_cat",getcharid(0);
		cloakoffnpc "Kaya Tos#171_cat",getcharid(0);
		cloakoffnpc "Aas#171_cat",getcharid(0);
		close3;
	}
	if (isbegin_quest(17014) == 1) {
		cutin "ep16_tes01",1;
		mes "[Tes]";
	mes "我以为你和懒惰一起调查，看来结果不太好。";
		next;
		mes "[Tes]";
	mes "我已经分析了你之前从雷根希尔姆收集的情报，发现了物资和研究数据的痕迹。";
		next;
		mes "[Tes]";
	mes "目前我认为这是企业内部那些人的诡计。";
	mes "嗯……";
		cloakoffnpc "Kaya#171_cat3",getcharid(0);
		next;
		cutin "ep171_kaya01",2;
		mes "[Kaya]";
	mes "我同意你的判断。";
	mes "我越了解真相，就越不明白发生了什么。";
	npctalk "哦，发生什么了？","",bc_self;
		next;
		mes "[Kaya]";
	mes "我目前看到的只是冰山一角。";
	mes "我现在终于看清了。";
	npctalk "抱歉突然打断。","Kaya#pub_cat_dummy",bc_self;
		next;
		cutin "ep16_tes02",1;
		mes "[Tes]";
	mes "看来是那群假装成安保人员、随后袭击实验室的人。";
	mes "他们的动机可能是什么？";
		next;
		cutin "ep171_kaya01",2;
		mes "[Kaya]";
	mes "啧，我想我知道幕后黑手是谁。";
	mes "在实验室进行不合理实验的人只有少数几个。";
		next;
		mes "[Kaya]";
	mes "我们因为他们进行不道德实验而解雇了他们，我猜就是他们。";
		next;
		cutin "ep16_tes01",1;
		mes "[Tes]";
	mes "嗯……调查的这一部分还需要进一步确认。";
	mes "我会继续寻找关于新实验室的情报。";
		next;
		cutin "ep171_kaya01",2;
		mes "[Kaya]";
	mes "这部分交给你了。";
	mes "我要回实验室做研究。";
		next;
		mes "[Kaya]";
	mes "先告辞了。";
		next;
		cloakonnpc "Kaya#171_cat3",getcharid(0);
		cutin "ep16_tes01",1;
		mes "[Tes]";
	mes "……那我会把下一次行动的消息告诉你。";
		next;
		mes "[Tes]";
	mes "艾因布罗克西北部还有一座封闭矿井。";
	mes "那片区域有许多废弃矿井……";
		next;
		cutin "ep16_tes03",1;
		mes "[Tes]";
	mes "我本来应该多调查，但资源不足……";
		next;
		cutin "ep16_tes01",1;
		mes "[Tes]";
	mes "总之，这次叛乱军的长老们会参加行动。";
	mes "他们是非常强大的支援力量。";
		next;
		mes "[Tes]";
	mes "在艾因布罗克西北部与一名<NAVI>[叛乱军成员]<INFO>ein_fild03,278,269,0,101,0</INFO></NAVI>会面。";
		completequest 17014;
		setquest 7865;
		close3;
	}
	if (isbegin_quest(7865) == 1) {
		mes "[Tes]";
		mes "在艾因布罗克西北部与一名<NAVI>[叛乱军成员]<INFO>ein_fild03,278,269,0,101,0</INFO></NAVI>会面。";
		close;
	}
	cutin "ep16_tes01",2;
	mes "[Tes]";
	mes "我有点累。还有很多文件要分析。";
	close3;

OnInit:
	questinfo(QTYPE_QUEST,QMARK_YELLOW,"terra_gloria_main == 26");
	questinfo(QTYPE_QUEST,QMARK_YELLOW,"isbegin_quest(7859) == 1");
	questinfo(QTYPE_QUEST,QMARK_YELLOW,"isbegin_quest(7862) == 2 && isbegin_quest(7864) == 0");
	questinfo(QTYPE_QUEST,QMARK_YELLOW,"isbegin_quest(7863) == 1");
	questinfo(QTYPE_QUEST,QMARK_YELLOW,"isbegin_quest(17014) == 1");
	end;
}

lighthalzen,43,271,5	script	Rekenber Guard#171_light_1	4_M_LGTGUARD,{ end; }
lighthalzen,46,271,5	script	Rekenber Guard#171_light_2	4_M_LGTGUARD,{ end; }

//= Pub Back Area
pub_cat,150,105,0	script	#EP171_EVT_CAT00	HIDDEN_WARP_NPC,1,1,{
	end;

OnTouch:
	if (isbegin_quest(7860) == 1) {
		cloakoffnpc "Philofontes#171_cat2",getcharid(0);
		cloakoffnpc "Middle-Aged Man#171_cat",getcharid(0);
		cloakoffnpc "Rekenber Senior Guard#171_cat",getcharid(0);
		cloakoffnpc "Commander Est#171_cat",getcharid(0);
		npctalk "我只合作这一次，明白吗？","Commander Est#171_cat",bc_self;
		end;
	}
	if (isbegin_quest(7860) == 2 && isbegin_quest(7861) == 0) {
		cloakoffnpc "Philofontes#171_cat2",getcharid(0);
		cloakoffnpc "Middle-Aged Man#171_cat",getcharid(0);
		end;
	}
	if (isbegin_quest(7860) == 2 && isbegin_quest(7861) == 1)
		cloakoffnpc "Middle-Aged Man#171_cat",getcharid(0);
	end;
}

pub_cat,160,102,5	script	Philofontes#171_cat2	4_M_PHILOFONTES,{
	if (isbegin_quest(7860) == 1) {
		cutin "ep162_est01",2;
		mes "[Est]";
		mes "这是你的行动。没有可用的支援吗？";
		mes "没有军队，你们到底怎么成为政府的？";
		next;
		cutin "ep16_tes01",0;
		mes "[Tes]";
		mes "关于这个我无可奉告。";
		mes "我没有组建和发展自己军队的权力。";
		next;
		cutin "ep162_est03",2;
		mes "[Est]";
		mes "我知道。我不能要求一名普通士兵改变这种事。";
		mes "你没有改变它的力量。";
		next;
		select("你们为什么都在这里？！");
		cutin "ep162_est02",2;
		mes "[Est]";
		mes "对吧？你也觉得奇怪吗？";
		mes "对我们来说也很奇怪，冒险者，你知道发生了什么吗？";
		next;
		cutin "ep162_est03",2;
		mes "[Est]";
		mes "他们居然能让我们所有人在酒馆里开会，现在叛乱军部队还在帮助企业，真令人惊叹。";
		next;
		cutin "ep162_est02",2;
		mes "[Est]";
		mes "这不是又美妙又神奇吗？我见过很多事，却没想过会有这一天。";
		mes "但你为什么在这里？";
		next;
		cutin "ep171_kaya01",0;
		mes "[Middle-Aged Man]";
		mes "唉……我不知道我们为什么彼此如此敌视。";
		mes "不过，真正为人民做贡献的组织并不多……";
		next;
		cutin "ep162_est02",2;
		mes "[Est]";
		mes "你真的这么认为吗？";
		mes "你不知道我们为什么被称为叛乱军吗？";
		mes "你只是在考虑自己想要什么。";
		next;
		cutin "ep162_est01",2;
		mes "[Est]";
		mes "没错，那是企业。你们现在有多少家公司？";
		mes "你们的总统总是看不起我们。";
		next;
		cutin "ep16_tes03",0;
		mes "[Tes]";
		mes "不是那样，埃斯特。";
		mes "你知道其中是有原因的，对吧？";
		next;
		cutin "ep162_est03",2;
		mes "[Est]";
		mes "我已经决定派出支援部队。";
		mes "即便如此，真的够吗？";
		npctalk ".....","Middle-Aged Man#171_cat",bc_self;
		npctalk "....hick...","Rekenber Senior Guard#171_cat",bc_self;
		next;
		select("那么到底发生了什么？");
		mes "[Est]";
		mes "我有点太激动了。我闭嘴。泰丝，请解释一下。";
		next;
		cutin "ep16_tes01",0;
		mes "[Tes]";
		mes "简单来说，我们所属的企业研究所雷根希尔姆被一大群敌人占领了。";
		mes "埃斯特指挥的特战部队将被派去夺回。";
		next;
		mes "[Tes]";
		mes "所以埃斯特才会这么紧张。";
		next;
		select("为什么企业守卫不帮忙？");
		mes "[Tes]";
		mes "你看……";
		 npctalk "这全是我的错！","Rekenber Senior Guard#171_cat",bc_self;
		next;
		cutin "ep171_as01",1;
		mes "[Aas]";
		mes "一切都始于守卫中的叛徒。";
		mes "哦，抱歉，我是雷根贝勒高级安全官阿斯。";
		next;
		mes "[Aas]";
		mes "叛徒是首席安全官施莱因，他在守卫部队中拥有很大的支持。";
		next;
		mes "[Aas]";
		mes "就是这些由施莱因带领的守卫，";
		mes "目前占领了雷根希尔姆。";
		mes "大多数武装部队加入了施莱因，他们开始自称心脏猎人。";
		next;
		cutin "ep171_as02",1;
		mes "[Aas]";
		mes "没错，就是心脏猎人。";
		mes "事件发生那天午夜，守卫换上了奇怪的新制服。";
		unittalk getcharid(3),strcharinfo(0)+ "：心脏猎人？！",bc_self;
		next;
		mes "[Aas]";
		mes "白天由我们的队伍负责巡逻和安保。到了晚上，施莱因的安全部队接管工作。";
		next;
		mes "[Aas]";
		mes "那天轮班的守卫穿着新制服到来，我误以为那是实验服。";
		next;
		cutin "ep171_as01",1;
		mes "[Aas]";
		mes "他们瞬间控制了白班队伍。";
		mes "通过欺骗，他们同时接管了所有安全守卫。";
		next;
		mes "[Aas]";
		mes "我试着发出紧急请求，召集应急队，但他们异常强大……";
		mes "结果只有更多守卫牺牲，我们也没能成功。";
		next;
		cutin "ep171_as02",1;
		mes "[Aas]";
		mes "而造成这一切的就是穿着新制服出现的施莱因。";
		mes "他问我是否想变强。如果接受他的邀请，我也会成为心脏猎人。";
		next;
		mes "[Aas]";
		mes "我拒绝后离开，只能眼睁睁看着更多守卫受苦。";
		mes "我的大部分队伍都伤亡惨重，而我只能羞愧地袖手旁观……";
		next;
		cutin "ep171_as01",1;
		mes "[Aas]";
		mes "跟随施莱因、穿着新制服的守卫，不一定全都是心脏猎人。";
		mes "毕竟施莱因只会召集最强的人。";
		next;
		select("我也遇到过心脏猎人……");

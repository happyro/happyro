		mes "[Jurgen]";
		mes "你是来替我向玛丽传达爱意的吗？";
		next;
		mes "[Jurgen]";
		mes "哦，是你说她会被我的急切吓跑的。";
		next;
		mes "[Jurgen]";
		mes "我正努力不每分每秒都给她寄情书。时机到了请再回来。";
		close3;
	case 2:
		cutin "16jur_nor",0;
		mes "[Jurgen]";
		mes "亲爱的冒险者，你来了！今天似乎会有好事发生。";
		next;
		mes "[Jurgen]";
		mes "请带着^0000cd15块海之石和1朵永恒玫瑰^000000向她传达我的爱意。";
		next;
		mes "[Jurgen]";
		mes "还记得吗？击败美杜莎就能获得海之石。";
		next;
		emotion ET_CRY;
		mes "[Jurgen]";
		mes "请把它们交给她，并告诉我玛丽今天怎么样。我很难过，她不再来这里打扫房间了。";
		next;
		mes "[Jurgen]";
		mes "我想亲自去见她。不过我想她会感到不自在。";
		next;
		mes "[Jurgen]";
		mes "亲爱的冒险者，就拜托你了！";
		erasequest 14492;// There Is a Silver Lining
		setquest 14493;// Today I Feel
		close3;
	}
}


prt_cas_q,96,7,1	script	Katrin Wigner#ep16wig	4_EP16_POE,{
	if (ep16_wig < 3) {
		cutin "16kat_nor",2;
		mes "[Katrin]";
		mes "亲爱的冒险者，很荣幸你能来。你见过我们的父亲，也就是维格纳家族的家主吗？";
		next;
		mes "[Katrin]";
		mes "要不要见见参加王室会议的维格纳家族继承人尤尔根？";
		next;
		mes "[Katrin]";
		mes "那么，请在维格纳家族度过一段舒适的时光。";
		close3;
	}
	if (ep16_wig == 3) {
		cutin "16kat_nor",2;
		mes "[Katrin]";
		mes "糟了！";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "发生什么事了？";
		next;
		cutin "16jur_sim",0;
		mes "[Jurgen]";
		mes "姐姐，请冷静。你把它放在哪里了？你确定放在这里吗？";
		next;
		cutin "16kat_nor",2;
		mes "[Katrin]";
		mes "就在这里，我就放在这里！和冒险者谈完后我把它放在这里，然后……它不见了……去哪儿了？";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "你丢了什么？";
		next;
		mes "[Katrin]";
		mes "我的首饰盒……严格来说它不是首饰盒，因为里面没有首饰，不过总之，^0000cd一个装着重要物品的小盒子不见了。^000000";
		next;
		mes "[Katrin]";
		mes "我把它从包里拿出来放在这里，然后它就不见了。我该怎么办？没有它我不知道该怎么办……我不能让任何人看到它……";
		next;
		cutin "16jur_sim",0;
		mes "[Jurgen]";
		mes "可能是之前来打扫房间的^0000cd女仆^000000拿走了。";
		next;
		cutin "16kat_nor",2;
		mes "[Katrin]";
		mes "你没有看到她拿走。没有证据就不该怀疑别人。";
		next;
		cutin "",255;
		mes "[" + strcharinfo(0) + "]";
		mes "我不是怀疑她，但问问她也许有帮助。比如她是否见过，或者最后一次见到它是什么时候……";
		next;
		cutin "16kat_nor",2;
		mes "[Katrin]";
		mes "请不要。要是让她觉得被怀疑，她会很难过。";
		next;
		cutin "16jur_sim",0;
		mes "[Jurgen]";
		mes "但你这么紧张。那不是对你很重要的东西吗？";
		next;
		cutin "16kat_nor",2;
		mes "[Katrin]";
		mes "是很重要，但是……";
		next;
		cutin "16jur_nor",0;
		mes "[Jurgen]";
		mes "你确实需要把它找回来，对吧？";
		next;
		cutin "16kat_nor",2;
		mes "[Katrin]";
		mes "你说得对，但是……";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "我会尽可能礼貌地问她。请放松，在这里等着。";
		next;
		mes "[Katrin]";
		mes "我不知道这是不是最好的办法。我不想让她觉得我们在怀疑她。";
		next;
		cutin "16jur_nor",0;
		mes "[Jurgen]";
		mes "等冒险者回来就好。冒险者很擅长处理这种事。";
		next;
		cutin "16kat_nor",2;
		mes "[Katrin]";
		mes "我该……";
		mes "那么请帮帮我，亲爱的冒险者。我去其他地方找找。";
		next;
		cloakonnpcself( "Katrin Wigner#ep16wig" );
		cutin "16jur_nor",0;
		mes "[Jurgen]";
		mes "请帮助她。我听说^0000cd女仆们在厨房^000000。";
		erasequest 14477;// What Is Going on?
		setquest 14478;// Searching for the Clue
		ep16_wig = 4;
		close3;
	}
	if (ep16_wig < 12) {
		cutin "16kat_nor",2;
		mes "[Katrin]";
		mes "哦，我该怎么办？";
		mes "我本来应该好好保管它的……";
		next;
		mes "[Katrin]";
		mes "请一定不要伤害别人的感情。";
		mes "我也想自己去找，但现在的情况不允许……";
		next;
		mes "[Katrin]";
		mes "我甚至不敢想象被别人看到它……";
		mes "那会让我羞愧至死。";
		close3;
	}
	if (ep16_wig == 15) {
		cutin "16kat_nor",2;
		mes "[Katrin]";
		mes "现在请让我一个人静静！";
		mes "啊，是你啊，亲爱的冒险者。请原谅我。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "你的兄弟一定伤害了你的感情。";
		next;
		mes "[Katrin]";
		mes "不是那样。";
		mes "我……我只是生自己的气。";
		next;
		mes "[Katrin]";
		mes "如果我更小心，就不会发生这种事……";
		mes "而且我也不该对兄弟们说那些话。";
		next;
		mes "[Katrin]";
		mes "可是听到那些传言，再看到尤尔根的态度，我再也无法忍受了……";
		mes "我以为自己已经习惯了那些事……看来并没有。";
		next;
		mes "[Katrin]";
		mes "我现在本该已经放弃了……";
		mes "哦，对不起。我想你不是来这里听这种故事的。";
		next;
		mes "[Katrin]";
		mes "对不起，但我现在想一个人待着。";
		mes "拜托了。";
		close3;
	}
	if (ep16_wig > 15) {
		cutin "16kat_nor",2;
		mes "[Katrin]";
		mes "多亏了你，我们现在变得更亲近了。";
		mes "现在我能更多地向兄弟们敞开心扉。";
		next;
		mes "[Katrin]";
		mes "我一直试图隐藏感情、少说话。不过我已经意识到，那并不是最好的做法。";
		mes "今后我要告诉他们自己的感受，避免产生误会。";
		next;
		mes "[Katrin]";
		mes "亲爱的冒险者，谢谢你。";
		close3;
	}
	cutin "16kat_nor",2;
	mes "[Katrin]";
	mes "我想以前没见过你。你是来见我父亲的吗？";
	next;
	mes "[Katrin]";
	mes "我父亲在那边。";
	close3;
}

prt_cas_q,94,7,7	script	Isaac Wigner#ep16wig	4_EP16_ISAAC,{
	if (checkweight(1304,3) == 0) {
		mes "[Isaac Wigner]";
		mes "亲爱的冒险者，你知道‘越空虚，越能填满’这句老话吗？";
		mes "这是我们家族流传下来的许多格言之一。";
		close;
	}
	.@name$ = strcharinfo(0);
	if (ep16_lug == 2) {
		mes "[" + .@name$ + "]";
		mes "你好，艾萨克·维格纳。";
		next;
		cutin "16isa",1;
		mes "[Isaac]";
		mes "哦，欢迎你，亲爱的冒险者，我弟弟在那边……";
		next;
		mes "[" + .@name$ + "]";
		mes "不，我是来见你的，艾萨克。";
		next;
		mes "[Isaac]";
		mes "是关于沃尔夫的吗？";
		next;
		mes "[" + .@name$ + "]";
		mes "是的。你怎么知道的……？";
		next;
		mes "[Isaac]";
		mes "沃尔夫过了约定时间还没来。他一向信守承诺，一定是出了什么事。";
		next;
		mes "[Isaac]";
		mes "不过我没想到会是你来这里。那么他今天是要取消约定吗？";
		next;
		mes "[" + .@name$ + "]";
		mes "是的。他让我从你这里取得^0000cd某样东西^000000，艾萨克。";
		next;
		mes "[Isaac]";
		mes "那样东西……？沃尔夫一定信任你，亲爱的冒险者。或者也可能是……";
		next;
		mes "[" + .@name$ + "]";
		mes "某种考验。";
		next;
		mes "[Isaac]";
		mes "别误会。我只是谨慎。要做好我的工作，首先必须知道能信任谁。";
		next;
		mes "[" + .@name$ + "]";
		mes "我明白。";
		next;
		mes "[Isaac]";
		mes "你可以把它带给沃尔夫。请小心保管。";
		next;
		mes "[" + .@name$ + "]";
		mes "OK.";
		next;
		mes "[Isaac]";
		mes "我能再请你办一件事吗？我听说普隆德拉流传着^0000cd奇怪的传闻^000000。";
		next;
		mes "[Isaac]";
		mes "据说与^0000cd赫尔穆特·罗根贝格^000000有关。你能调查传闻并告诉我真相吗？";
		next;
		mes "[Isaac]";
		mes "我必须维护自己的声誉，承担不起丑闻。请帮帮我。";
		if (ep16_wig > 1 && ep16_wig < 15) {
			next;
			mes "[Isaac]";
			mes "那么请容我告辞。";
			cloakonnpcself( "Isaac Wigner#ep16wig" );
		}
		erasequest 14496;// To Isaac
		setquest 14497;// Delivery for Wolf
		ep16_lug = 3;
		getitem 6930,1;// Biz_Items_Sample
		close3;
	}
	if (ep16_lug == 3) {
		cutin "16isa",1;
		mes "[Isaac]";
		mes "你把东西安全交给沃尔夫了吗？它可能很危险，你应该小心。";
		next;
		mes "[Isaac]";
		mes "还有，别忘了询问传闻。";
		if (ep16_wig > 1 && ep16_wig < 15) {
			next;
			mes "[Isaac]";
			mes "那么请容我告辞。";
			cloakonnpcself( "Isaac Wigner#ep16wig" );
		}
		close3;
	}
	if (ep16_lug == 7) {
		if (countitem(6931) < 1) {
			cutin "16isa",1;
			mes "[Isaac]";
			mes "亲爱的冒险者，你回来了。东西安全交到了吗？他对传闻怎么说？";
			next;
			mes "[" + .@name$ + "]";
			mes "这是相关文件。就在这里……咦，等等，我一定是忘了带。我很抱歉，很快就会带回来。";
			next;
			mes "[Isaac]";
			mes "这种事难免发生。慢慢来，我会等你。";
			close3;
		}
		cutin "16isa",1;
		mes "[Isaac]";
		mes "亲爱的冒险者，你回来了。东西安全交到了吗？他对传闻怎么说？";
		next;
		mes "[" + .@name$ + "]";
		mes "这是关于此事的^0000cd文件^000000。由沃尔夫·罗根贝格亲自撰写。";
		next;
		mes "[Isaac]";
		mes "我看看……嗯……所以新事业会无限期推迟，事业方向也会改变。";
		next;
		mes "[Isaac]";
		mes "处理完事情后再见。——W. R.";
		next;
		mes "[Isaac]";
		mes "这意味着他会停止有关战争的交易，对吧？那个传闻一定相当具有威胁性。";
		next;
		mes "[Isaac]";
		mes "真遗憾。那本来是让我在家人面前表现自己的好机会。";
		next;
		mes "[Isaac]";
		mes "嗯，我相信沃尔夫会找到更好的事业方向。请告诉沃尔夫我支持他的决定，也很期待他的新事业。";
		next;
		mes "[" + .@name$ + "]";
		mes "好的，我会的。";
		if (ep16_wig > 1 && ep16_wig < 15) {
			next;
			mes "[Isaac]";
			mes "那么请容我告辞。";
			cloakonnpcself( "Isaac Wigner#ep16wig" );
		}
		delitem 6931,1;// Secret_Documents
		erasequest 14502;// To Isaac
		setquest 14503;// Report to Wolf
		ep16_lug = 8;
		close3;
	}
	if (ep16_lug == 8) {
		cutin "16isa",1;
		mes "[Isaac]";
		mes "真遗憾。";
		mes "那本来是我和沃尔夫的大好机会。";
		next;
		mes "[Isaac]";
		mes "不过既然我的伙伴想退出，我不该强迫他继续。";
		mes "我相信沃尔夫心里已经有下一个商品的计划了。";
		next;
		mes "[Isaac]";
		mes "所以我接受了与他合作经商的提议。";
		if (ep16_wig > 1 && ep16_wig < 15) {
			next;
			mes "[Isaac]";
			mes "那么请容我告辞。";
			cloakonnpcself( "Isaac Wigner#ep16wig" );
		}
		close3;
	}

	if (ep16_wig == 1 || ep16_wig == 2) {
		cutin "16isa",1;
		mes "[Isaac]";
		mes "亲爱的冒险者，既然你来到了维格纳家族，为什么不去见见家族的其他成员？";
		mes "比如我的父母、身为王位候选人的弟弟，或者身为长女的妹妹。";
		next;
		mes "[Isaac]";
		mes "我相信和他们相处会更有收获。";
		close3;
	}
	if (ep16_wig == 15) {
		cutin "16isa",1;
		mes "[Isaac]";
		mes "亲爱的冒险者，你带来我拜托的东西了吗？";
		next;
		mes "[Isaac]";
		mes "我想亲自去取，或者请别人代办。但这是家事，我觉得有些不自在。";
		next;
		mes "[Isaac]";
		mes "我知道这让你很困扰，但请帮助我们。你没忘记要带什么吧？";
		next;
		mes "[Isaac]";
		mes "你需要带来^0000cd10块海之石和1朵永恒玫瑰^000000。";
		next;
		mes "[Isaac]";
		mes "我们的命运取决于你！我们可能重新和好，也可能变得疏远。";
		next;
		mes "[Isaac]";
		mes "请尽快把它们带给我们！";
		close3;
	}
	if (ep16_wig > 15) {
		cutin "16isa",1;
		mes "[Isaac]";
		mes "多亏了你，我的弟弟和妹妹又亲近起来了。";
		mes "没有我他们可怎么办？";
		next;
		mes "[Isaac]";
		mes "亲爱的冒险者，那我们回头见。";
		close3;
	}
	cutin "16isa",1;
	mes "[Isaac]";
	mes "你是第一次来维格纳家族吗？";
	mes "那么，^0000cd你应该先去见见我们的父母^000000。";
	close3;
}

prt_cas_q,80,23,5	script	Jurgen Wigner#ep16wig00	4_M_4THPRIN1,{
	end;
OnInit:
	cloakonnpc();
	end;
}
prt_cas_q,93,10,4	duplicate(Jurgen Wigner#ep16wig00)	Maid#ep16wig01	1_F_04

prt_cas_q,95,11,4	script	Womenfolk#ep16wig01	1_F_03,{
	mes "[Womenfolk]";
	mes "尤尔根，你是我的！";
	close2;
	if (achievementinfo(110001, ACHIEVEINFO_COUNT6) == 0)
		achievementupdate(110001, ACHIEVEINFO_COUNT6, 1);
	end;

OnTimer600000:
	enablenpc "Womenfolk#ep16wig01";
	npctalk "天哪！尤尔根！我的王子！我爱你！请看这里！", "Womenfolk#ep16wig01";
	emotion ET_CHUP, getnpcid(0, "Womenfolk#ep16wig01");
	sleep 2000;
	npctalk "你是……我以前见过你……嗯……你是来见我的吗？", "Jurgen Wigner#ep16wig";
	sleep 2000;
	npctalk "亲爱的尤尔根！请永远和我在一起！", "Womenfolk#ep16wig01";
	specialeffect EF_HEARTCASTING,AREA,"Womenfolk#ep16wig01";
	sleep 2000;
	npctalk "这有点困难……", "Jurgen Wigner#ep16wig";
	sleep 2000;
	enablenpc "Strong Guards#ep16wig03";
	enablenpc "Strong Guards#ep16wig04";
	npctalk "天哪！你怎么又进来了？", "Strong Guards#ep16wig03";
	sleep 2000;
	npctalk "她们总是能穿过守卫进来。加强安保也没用！", "Strong Guards#ep16wig04";
	sleep 2000;
	npctalk "把她带出去！", "Strong Guards#ep16wig03";
	sleep 2000;
	npctalk "天哪！尤尔根！我爱你！", "Womenfolk#ep16wig01";
	disablenpc "Womenfolk#ep16wig01";
	disablenpc "Strong Guards#ep16wig03";
	disablenpc "Strong Guards#ep16wig04";
	initnpctimer;
	end;
OnInit:
	initnpctimer;
	disablenpc "Womenfolk#ep16wig01";
	disablenpc "Strong Guards#ep16wig03";
	disablenpc "Strong Guards#ep16wig04";
	end;
}


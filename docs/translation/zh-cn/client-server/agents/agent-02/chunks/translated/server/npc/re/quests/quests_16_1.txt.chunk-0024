prt_cas_q,98,23,1	script	Bachelor#ep16wig01	1_M_ORIENT01,{
	mes "[Bachelor]";
	mes "我没能和尤尔根握手！哦，太热了！";
	close2;
	if (achievementinfo(110001, ACHIEVEINFO_COUNT7) == 0)
		achievementupdate(110001, ACHIEVEINFO_COUNT7, 1);
	end;

OnTimer480000:
	enablenpc "Bachelor#ep16wig01";
	npctalk "尤尔根，啊！好热！", "Bachelor#ep16wig01";
	sleep 2000;
	npctalk "我为什么会掉到这里？", "Bachelor#ep16wig01";
	sleep 2000;
	npctalk "那个女人一定给了我错误的坐标！", "Bachelor#ep16wig01";
	sleep 2000;
	npctalk "哦，好热！", "Bachelor#ep16wig01";
	npctalk "嗯，你没必要用全身向我展示炽热的爱。", "Jurgen Wigner#ep16wig";
	sleep 2000;
	npctalk "哦，好热！尤尔根，救救我……啊！", "Bachelor#ep16wig01";
	sleep 3000;
	enablenpc "Strong Guards#ep16wig05";
	enablenpc "Strong Guards#ep16wig06";
	npctalk "强力守卫为您服务！", "Strong Guards#ep16wig05";
	sleep 2000;
	npctalk "这个人在这里做什么？", "Strong Guards#ep16wig06";
	sleep 2000;
	npctalk "世界上真是什么人都有。", "Strong Guards#ep16wig05";
	sleep 2000;
	npctalk "把她带出去！", "Strong Guards#ep16wig06";
	sleep 2000;
	npctalk "啊！尤尔根，我的王子！", "Bachelor#ep16wig01";
	disablenpc "Bachelor#ep16wig01";
	disablenpc "Strong Guards#ep16wig05";
	disablenpc "Strong Guards#ep16wig06";
	initnpctimer;
	end;
OnInit:
	initnpctimer;
	disablenpc "Bachelor#ep16wig01";
	disablenpc "Strong Guards#ep16wig05";
	disablenpc "Strong Guards#ep16wig06";
	end;
}

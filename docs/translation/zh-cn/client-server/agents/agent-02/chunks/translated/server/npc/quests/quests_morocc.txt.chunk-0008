que_ba,102,56,0	script	#3room_barmunt	-1,3,3,{
OnTouch:
	if (barmunt_crow < 4) {
		warp "yuno_in04",100,3;
	}
	else {
		mes "^660000你穿过被火焰吞噬的走廊，来到一间即将坍塌的房间，和这里其他地方一样。^000000";
		next;
		mes "^660000烟雾太浓，你看不清房间里有什么，但知道里面确实有东西。^000000";
		next;
		mes "^660000你眯起眼睛，仔细聆听。你听到了人声，但说话者的身影并不像人类。^000000";
		next;
		mes "[Female]";
		mes "咳！着火了……咳！该死的人类……咳咳！";
		next;
		mes "^660000随着火焰的轰鸣声变强，她咳嗽得更加厉害。^000000";
		next;
		mes "[Male]";
		mes "他们逃走了，把我们留下等死！";
		next;
		mes "[Female]";
		mes "……我们要死了吗？";
		next;
		mes "[Male]";
		mes "死？……哈哈。^3131FF‘Eva’^000000，我们不会死……我们本来就不算活着。";
		next;
		mes "- Crumbling -";
		next;
		mes "[Male]";
		mes "呃啊！";
		next;
		mes "^660000唯一的出口被铁栅栏挡住了，没人能逃出被火焰包围的房间。随后，墙角在火焰的高温下坍塌。^000000";
		next;
		mes "^660000男性身影迅速走到墙边，开始挖掘坍塌的墙角。^000000";
		next;
		mes "[Male]";
		mes "...It's done!";
		next;
		mes "[Male]";
		mes "走吧，Eva！";
		next;
		mes "[Eva]";
		mes "等等，我们必须带孩子们一起走。";
		next;
		mes "^660000名叫 Eva 的女性身影走近靠墙排列的试管。^000000";
		next;
		mes "[Male]";
		mes "Eva！！我们没时间救所有人！快过来！";
		if (barmunt_crow == 4) {
			set barmunt_crow,5;
		}
		sc_start SC_Blind,600000,0,10000;
		close2;
		warp "que_ba",53,232;
		end;
	}
	end;
}


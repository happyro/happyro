		mes "哇，谢谢！";
			next;
			mes "[Oliver Hilpert]";
		mes "嗯……我还没收到出版预付款，可以先收下这个吗？";
			next;
			break;
		case 2:
			mes "[Oliver Hilpert]";
		mes "好……我明白了……";
			emotion ET_CRY;
			set barmunt_crow,13;
			close2;
			cutin "",255;
			end;
		}
		mes "[Oliver Hilpert]";
		mes "我还没机会打开，但出版商说里面有非常稀有的东西。希望足以支付你的书。";
		next;
		mes "["+ strcharinfo(0) +"]";
		mes "哈哈，谢谢。你知道，在 Morocc……阿嚏！有个人和你一样是 Mammi 的大粉丝……阿嚏！你可以去见他。";
		next;
		mes "["+ strcharinfo(0) +"]";
		mes "那本书是他送我的礼物。他可能还有更多 Mammi 的稀有书……阿嚏！";
		next;
		mes "[Oliver Hilpert]";
		mes "哦，非常感谢你提供这么有价值的信息！";
		next;
		mes "[Oliver Hilpert]";
		mes "哇！我必须趁忘记前写下昨晚梦见的故事！";
		next;
		mes "[Oliver Hilpert]";
		mes "希望你也喜欢我的下一本书。那我先走了……谢谢你的绘本！";
		cutin "oliver_smile",255;
		next;
		mes "^660000他像无头苍蝇一样跑来跑去，迅速打开包，拿出笔记本，跑到桌边飞快写下什么。";
		mes "起初他看起来很滑稽，但现在你觉得他是认真写作的人。^000000";
		next;
		mes "^660000你正要离开时，发现地上有一张纸。^000000";
		next;
		mes "^660000纸上满是涂鸦，顶部标着《命运之鸦》。一定是 Oliver 掉落的小说笔记。^000000";
		next;
		mes "^3131FF古代武器 = 某种能量源^000000";
		mes "^3131FF隐居——女弟子的信^000000";
		mes "^3131FF继母 = 前世恋人？！^000000";
		close2;
		specialeffect2 EF_ENHANCE;
		delitem 7795,1; //Mami_Photo_Album
		set barmunt_crow,14;
		getitem 7796,1; //Author_Autograph
		getitem 7797,1; //Author_Memo
		getitem 617,1; //Old_Violet_Box
		warp "que_ba",270,270;
		cutin "",255;
		end;
	}
	else {
		mes "^660000考虑到出版日期不久，这本书的封面却严重损坏。一定有很多人翻阅过。^000000";
		close;
	}
}


		next;
		mes "^660000你突然感到胸口一阵剧痛，仿佛有人正在挤压你的心脏。^000000";
		next;
		mes "^660000这座宅邸看起来优雅而昂贵，却和你第一个梦里的实验室一样着火了。^000000";
		next;
		mes "^660000胸痛和火焰让你难以思考，但你知道这座宅邸撑不了多久。你寻找出口，看到一个男人站在楼下的火焰中央。^000000";
		next;
		mes "^660000他似乎不在意和宅邸一起毁灭，正用低沉悲伤的声音缓慢地说话。^000000";
		next;
		mes "[Mysterious Man]";
		mes ".....................";
		mes "毕竟，神一直在玩弄我……这一直是他的计划……连我最好的朋友也是他的傀儡……";
		next;
		mes "[Mysterious Man]";
		mes "我强烈憎恨自己的命运……但我准备接受一切的终结……";
		next;
		mes "^660000他的话还没说完就被火焰吞没。与此同时，你……^000000";
		specialeffect EF_METEORSTORM;
		set barmunt_crow,12;
		close2;
		warp "yuno_in04",108,57;
	}
	else {
		warp "yuno_in04",108,57;
	}
	end;
}


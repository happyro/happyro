cave,82,97,3	script	Cave Settler#g1	996,3,3,{
	if (barmunt_crow == 8) {
		mes "[Cave Settler]";
		mes "不允许外人进入此地。";
		next;
		switch(select("Step back.:No, listen to me!")) {
		case 1:
			mes "[Cave Settler]";
			mes "哈，我就知道你会怕我！";
			close2;
			warp "cave",81,92;
			end;
		case 2:
			mes "["+ strcharinfo(0) +"]";
			mes "啊……阿嚏！";
			mes "‘我和其他外来者不一样……阿嚏！";
			mes "我来这里是为了完成目标……阿嚏！";
			specialeffect2 EF_VENOMDUST;
			next;
			mes "^660000虽然你有些害怕这个守卫，喷嚏也确实帮不上忙，但你还是继续前进。^000000";
			next;
			mes "["+ strcharinfo(0) +"]";
			mes "我来这里找人！";
			input .@input$;
			mes "她的名字是 ^FF0000"+.@input$+"^000000！";
			next;
			if (compare(.@input$,"Eva") == 0) {
				mes "[Cave Settler]";
				mes "你在开玩笑吗？要找失踪儿童就去朱诺斯警察局！";
				close2;
				warp "cave",81,92;
				end;
			}
			else {
				mes "[Cave Settler]";
				mes "............!!!!";
				next;
				mes "[Cave Settler]";
			mes "你刚才说 Eva？嗯……";
+	//
	//
	//
	//
	//
	//
	//
	//
	//
	//
	//
	//
	//
	//
			mes "在这里等着。";
				next;
				emotion ET_COMEON;
				mes "[Cave Settler]";
			mes "嘿，Jaeda！";
				enablenpc "Jaeda#garas1";
				next;
				mes "[Cave Settler]";
			mes "上楼告诉 Eva 有客人。";
				disablenpc "Jaeda#garas1";
				next;
				mes "^660000令人惊讶的是，他似乎知道 Eva 是谁。你仍然无法相信她真的存在！这一切太奇怪了。^000000";
				next;
				mes "^660000你内心充满兴奋和期待。也许你就快弄清这些梦真正的含义了。^000000";
				enablenpc "Jaeda#garas1";
				next;
				mes "[Cave Settler]";
			mes "嗯……好的？我明白了。";
				next;
				disablenpc "Jaeda#garas1";
				mes "[Cave Settler]";
			mes "嘿，你可以通过。上楼吧，但最好别耍花样。明白吗？";
				next;
				mes "^660000那个表情严肃的男人打量着你，然后侧身让你通过。";
			mes "^000000你紧张地握紧拳头，走上昏暗的楼梯。^000000";
				set barmunt_crow,9;
				close2;
				warp "cave",82,105;
				end;
			}
		}
	}
	else if (barmunt_crow < 8) {
		mes "[Cave Settler]";
		mes "不允许外人进入此地。";
		next;
		mes "^660000他的声音和外表一样严厉而令人畏惧。^000000";
		close2;
		warp "cave",81,92;
		end;
	}
	else {
		mes "[Cave Settler]";
		mes "你还要找 Zid 办事吗？最好快点完成，因为我们不喜欢外人在村里乱跑。";
		close;
	}


// Treasure Room Exit
//============================================================
payg_cas05,161,136,0	script	#lever_PA05	111,{
	mes " ";
	mes "这里有一根小拉杆。要拉动它吗？";
	next;
	if(select("拉动。:不拉。") == 1) {
		close2;
		warp "payg_cas05",277,250;
		end;
	}
	close;
}


			mes "只要清除通道和附近的一些魔物。";
			mes "我很高兴你喜欢这份工作。";
			next;
			mes "[米歇尔管理员]";
			mes "完成后可以回来向我报告，";
			mes "或者去中央指挥中心找路易斯。";
			mes "谢谢你的帮助。";
			close;
		case 2:
			mes "哦，消灭魔物做得很好。";
			mes "我们的士兵会感谢你的帮助。";
			mes "请收下这份小小的谢礼。";
			mes "希望对你有用。";
			erasequest 7611;// Passage Cleaning
			setquest 7612;// Passage Cleaning - Down
			getexp 1500000,1000000;
			close;
		}
	case 0:
	case 1:
		mes "谢谢你清除了通道里的魔物。";
		mes "如果你能继续做下去，我会很感激。";
		close;
	case 2:
		mes "你在找新工作吗？";
		mes "如果你更喜欢体力劳动，";
		mes "可以一直帮我消灭魔物。";
		erasequest 7612;// Passage Cleaning - Down
		close;
	}
	end;

OnInit:
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "isbegin_quest(7611) == 0 && ep15_1_atnad == 4" );
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "isbegin_quest(7612) == 0" );
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "checkquest(7611,HUNTING) == 2" );
	end;
}

verus04,182,168,5	script	Receptionist Nara#atnd06	4_F_HUWOMAN,{
	mes "[纳拉]";
	if (ep15_1_atnad < 4) {
		mes "你好。";
		mes "感谢使用幻象学挖掘接待处。";
		mes "你有推荐信吗？或者你是挖掘队成员吗？";
		next;
		mes "[纳拉]";
		mes "哦，都不是。";
		mes "抱歉，我不能让你登记。";
		mes "我们确实需要挖掘者，但有一定标准。";
		next;
		switch( select( "我现在要登记。", "我稍后再来。" ) ) {
		case 1:
			if (BaseLevel > 139) {
				mes "[纳拉]";
				mes "你必须有推荐信，或者属于挖掘队。";
				mes "抱歉。";
				mes "嗯……";
				next;
				mes "[纳拉]";
				mes "如果你不知道去哪里获得推荐信或加入挖掘队，";
				mes "你可以加入^4d4dff伊甸园集团^000000。";
				next;
				mes "[纳拉]";
				mes "如果你曾为集团工作过，获得推荐信就不成问题。";
				close;
			}
			mes "[纳拉]";
			mes "嗯……";
			mes "抱歉，我也无能为力。";
			mes "这里现在对你来说太危险。";
			next;
			mes "[纳拉]";
			mes "经验更丰富后再回来。";
			mes "登记至少需要达到等级140。";
			mes "这是必要条件，否则挖掘队只会变成一群杂乱的初心者。";
			mes "抱歉。";
			close;
		case 2:
			mes "[纳拉]";
			mes "带着正式挖掘队一起来，或者带上推荐信。";
			close;
		}
	}
	if (ep15_1_atnad == 4) {
		mes "你好。";
		mes "感谢使用幻象学挖掘接待处。";
		mes "你有推荐信吗？或者你是挖掘队成员吗？";
		next;
		select("我来自伊甸园集团。");
		mes "[纳拉]";
		mes "伊甸园集团，明白了。";
		mes "可以告诉我你的名字吗？" + strcharinfo(0) + "...";
		mes "啊，找到了。";
		next;
		mes "[纳拉]";
		mes "你是其他挖掘队的成员。";
		mes "你属于哪支挖掘队？";
		next;
		input .@string$;
		mes "[纳拉]";
		if (.@string$ != "Atnad" && .@string$ != "Atnad Excavation" && .@string$ != "Atnad Excavation Team") {
			mes "..." + .@string$ + "...?";
			mes "确定正确吗？";
			mes "因为我在名单上找不到这个名字。";
			next;
			mes "[纳拉]";
			mes "请再确认一次。";
			close;
		}
		mes "阿特纳德……阿特纳德……";
		mes "哦，找到了。";
		mes "有了你"+strcharinfo(0)+"，这支队伍勉强达到最低成员要求。";
		mes "哦，我们不歧视小队伍。别担心。";
		next;
		mes "[纳拉]";
		mes "听从挖掘队队长指挥的同时，";
		mes "你也可以接受中央指挥中心提供的任务。";
		next;
		mes "[纳拉]";
		mes "特殊活动时我们会通知你。";
		mes "受伤或疲惫时，可以使用指挥中心待命的治疗师。";
		next;
		mes "[纳拉]";
		mes "雷根贝勒会为你提供挖掘现场工作所需的一切。";
		mes "作为回报，我们希望你专心揭开幻象学中埋藏的秘密。";
		mes "祝你的挖掘顺利。";
		erasequest 7609;// Atnad Excavation Team 2
		setquest 7610;// Registered Excavator
		completequest 7610;// Registered Excavator
		ep15_1_atnad = 5;
		getexp 300000,300000;
		close;
	}
	if (ep15_1_atnad == 5) {
		mes "现在你可以无限制进入此区域。";
		mes "挖掘或探索时遇到问题，随时告诉我们。";
		next;
		mes "[纳拉]";
		mes "你的登记已经处理完毕。需要帮助或指示，请找路易斯指挥官。";
		mes "他也会提供一些魔物讨伐任务。";
		next;
		mes "[纳拉]";
		mes "祝你好运！";
		close;
	}
	mes "你今天怎么样？";
	mes "继续努力。";
	close;

OnInit:
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "isbegin_quest(7610) == 0 && BaseLevel >= 140" );
	end;
}

verus04,179,165,5	script	Commander Louis#atnd07	4_M_LGTGUARD,{
	if (checkweight(1301,3) == 0) {
		mes "- 你携带的物品太多，无法继续任务。-";
		close;
	}
	mes "[路易斯]";
	if (ep15_1_atnad < 5) {
		mes "登记成为正式挖掘者，否则会被护送离开。";
		mes "你可以在接待处登记。";
		close;
	}
	mes "你属于阿特纳德挖掘队。";
	mes "我能怎样帮助你？";
	next;
	switch( select( "报告挖掘成果。", "关于清理通道。", "关于魔物讨伐。", "没什么。" ) ) {
	case 1:
		mes "[路易斯]";
		if (ep15_1_atnad == 12) {
			if (isbegin_quest(7617) != 1 || countitem(6748) < 1) {
				mes "你要报告成果吗？";
				mes "……报告上必须有阿特纳德考古任务负责人印章！";
				next;
				mes "[路易斯]";
				mes "这类信息会被整理成档案。";
				mes "抱歉麻烦你了。";
				mes "阿特纳德考古队的内容一定很有趣，我们很期待！";
				close;
			}
			mes "啊，你们队伍的挖掘成果。";
			mes "我看得出你们一直在专注核心区域。";
			next;
			mes "[路易斯]";
			mes "主席对你们队伍特别感兴趣。";
			mes "继续努力，你会收到他的消息。";
			next;
			mes "[路易斯]";
			mes "谢谢你今天的辛苦工作。";
			mes "明天见。";
			next;
			mes "[路易斯]";
			mes "哦，等等。";
			mes "你的队伍正在无线电里。";
			mes "我把线路接给你。";
			next;
			mes "[Ian Atnad's Voice]";
			mes "*Crackle* Hey... *Crackle* rookie...";
			mes "*噼啪* 这东西……怎么了……";
			mes "*噼啪* 我听不见……";
				mes "菜鸟……*杂音* 快到这里来……*杂音*";
				mes "哼！*嘟*";
			next;
			mes "[路易斯]";
			mes "抱歉，信号通常没这么差。";
			mes "我想医生正在找你。";
			mes "你应该去。";
			delitem 6748,1;// Excavator_Repoet
			erasequest 7617;// Turning In Excavation Report
			setquest 7623;// Atnad's Summon
			ep15_1_atnad = 13;
			getexp 300000,300000;
			close;
		}
		if (ep15_1_atnad == 13) {
			mes "虽然调查时间很短，但你们队伍完成了很多工作。";
			next;
			mes "[路易斯]";
			mes "其他学者和挖掘者只能进行表面观察，";
			mes "你们队伍却有了一些技术发现。";
			next;
			mes "[路易斯]";
			mes "我会向主席报告，并确保你们队伍获得特别待遇。";
			mes "期待你们的下一份报告。";
			close;
		}
		if (isbegin_quest(7618) == 1) {
			mes "高层管理人员很想了解";
			mes "更多调查结果。";
			mes "希望你能继续给我们惊喜。";
			close;
		}
		if (isbegin_quest(7617) != 1 || countitem(6748) < 1) {
			mes "你是来报告每日成果的吗？";
			mes "请带来有队长签名的报告。";
			next;
			mes "[路易斯]";
			mes "留下记录总是更稳妥。";
			mes "报告准备好后尽快带来。";
			mes "阅读你的报告总让我兴奋。";
			close;
		}
		mes "啊，你们队伍的挖掘成果。";
		mes "我看得出你们一直在专注核心区域。";
		next;
		mes "[路易斯]";
		mes "主席对你们队伍特别感兴趣。";
		mes "继续努力，你会收到他的消息。";
		next;
		mes "[路易斯]";
		mes "谢谢你今天的辛苦工作。";
		mes "明天见。";
		delitem 6748,1;// Excavator_Repoet
		erasequest 7617;// Turning In Excavation Report
		setquest 7618;// Reporting the Results - Down
		getexp 300000,300000;
		close;
	case 2:
		mes "[路易斯]";
		switch( checkquest(7612,PLAYTIME) ) {
		case -1:
			switch( checkquest(7611,HUNTING) ) {
			case -1:
				mes "啊，你来得正是时候。";
				mes "通道和遗迹中的魔物越来越多。";
				mes "佣兵请求增援。";
				next;
				if (select( "我去。", "拒绝。" ) == 2) {
					mes "[路易斯]";
					mes "当然，你的首要任务是挖掘。";
					mes "我会找别人。";
					close;
				}
				mes "[路易斯]";
				mes "很好。";
				mes "先谢谢你。";
				mes "完成后可以向东部遗迹的米歇尔管理员报告成果。";
				mes "狩猎愉快。";
				setquest 7611;// Passage Cleaning
				close;
			case 0:
			case 1:
				mes "谢谢你。";
				mes "穿过通道并清除里面的魔物。";
				mes "完成后，请向东部遗迹的米歇尔管理员报告成果。";
				close;
			case 2:
				mes "你处理通道和遗迹里的魔物了吗？";
				mes "我们的佣兵会很高兴。";
				mes "他们要求增援已经有一段时间了。哈哈！";
				next;
				mes "[路易斯]";
			mes "谢谢你的辛苦工作。";
				mes "请去休息，之后才能继续挖掘任务。";
				erasequest 7611;// Passage Cleaning
				setquest 7612;// Passage Cleaning - Down
				getexp 1500000,1000000;
				close;
			}
		case 0:
		case 1:
			mes "我们的佣兵可以处理通道和遗迹里的魔物。";
			mes "但还是感谢你关心现场安全。";
			close;
		case 2:
			erasequest 7612;// Passage Cleaning - Down
			mes "你担心通道和遗迹里的魔物吗？";
			mes "充分休息后，我可以安排你执行讨伐任务。";
			next;
			mes "[路易斯]";
			mes "既然你打算出去，不如顺便接下任务，一举两得。";
			mes "你也可以向东部遗迹的米歇尔管理员报告成果。";
			close;
		}
	case 3:
		mes "[路易斯]";
		switch( checkquest(7614,PLAYTIME) ) {
		case -1:
			switch( checkquest(7613,HUNTING) ) {
			case -1:
				mes "啊，你来得正是时候。";
				mes "广场出现了危险的机械。";
				mes "工人请求战斗部队。";
				next;
				if (select( "我去。", "拒绝。" ) == 2) {
					mes "[路易斯]";
					mes "当然，你的首要任务是挖掘。";
					mes "我会找别人。";
					close;
				}
				mes "[路易斯]";
				mes "很好。";
				mes "先谢谢你。";
				mes "请小心！";
				setquest 7613;// Eliminating Risks
				close;
			case 0:
			case 1:
				mes "谢谢你。";
				mes "广场是大部分挖掘工作的地点。";
				mes "如果能从摧毁的机械中找到什么就太好了。";
				close;
			case 2:
				mes "事情似乎平息了。";
				mes "工人很快会恢复工作。";
				mes "他们不是战士，所以遇到这种情况通常会保持被动。";
				next;
				mes "[路易斯]";
			mes "谢谢你的辛苦工作。";
				mes "我们的工人会感谢你保护他们安全。";
				erasequest 7613;// Eliminating Risks
				setquest 7614;// Eliminating Risks - Down
				getexp 1500000,1000000;
				close;
			}
		case 0:
		case 1:
			mes "我还有其他志愿者负责处理主挖掘点广场的魔物。";
			mes "你应该休息。";
			close;
		case 2:
			erasequest 7614;// Eliminating Risks - Down
			mes "你担心主挖掘点的机械吗？";
			mes "确实有些机械过于敏感且具有攻击性，";
			mes "我同意它们威胁着我们的工作。";
			next;
			mes "[路易斯]";
			mes "如果你能处理它们，我就可以正式安排你执行任务，";
			mes "你也会获得相应奖励。雷根贝勒不会忽视你的服务。";
			close;
		}
	case 4:
		mes "[路易斯]";
		mes "是这样吗？";
		mes "注意到异常情况就告诉我。";
		close;
	}
	end;

OnInit:
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "isbegin_quest(7610) == 2 && isbegin_quest(7611) == 0 && isbegin_quest(7612) == 0" );
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "isbegin_quest(7613) == 0 && isbegin_quest(7614) == 0" );
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "checkquest(7613,HUNTING) == 2 && isbegin_quest(7614) == 0" );
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "isbegin_quest(7618) == 0 && isbegin_quest(7617) == 1" );
	end;
}

verus04,176,161,5	script	Healer Miyo#atnd08	4_F_ACOLYTE,{
	mes "[美代]";
	mes "请进。";
	mes "哪里疼？";
	next;
	.@s = select( "HP/SP完全恢复 5,000 Zeny", "HP/SP恢复一半 2,000 Zeny" );
	if (isbegin_quest(7610) > 0)
		setarray .@cost[1],4500,1800;
	else
		setarray .@cost[1],5000,2000;
	if (Zeny < .@cost[.@s]) {
		mes "[美代]";
		mes "……看看你，居然";
		mes "连治疗费都付不起？";
		close;
	}
	Zeny = Zeny - .@cost[.@s];
	npcskill "AL_HEAL",(10/.@s),(99/.@s),(99/.@s);
	percentheal (100 / .@s), (100 / .@s);
	mes "[美代]";
	mes "哦，你累坏了。";
	mes "让我恢复你的" + ( .@s == 1 ? "your full" : "some of your" ) + "能量。";
	mes "正式挖掘者享受10%折扣。";
	mes "笑一笑，心情会好起来。";
	close;
}

verus04,141,193,5	script	Archaeologist Aures#atnd09	4_M_OLDSCHOLAR,{
	if (checkweight(1301,3) == 0) {
		mes "- 你携带的物品太多，无法继续任务。-";
		close;
	}
	switch(ep15_1_atnad) {
	case 0:
	case 1:
	case 2:
	case 3:
		mes "老考古学家背对着你，正在工作。";
		mes "你不应该打扰他。";
		close;
	case 4:
		cutin "verus_aures.bmp",0;
		mes "[奥尔斯]";
		mes "啊，欢迎。";
		mes "我一直在等你。";
		mes "首先，你应该去中央指挥中心登记。";
		next;
		mes "[奥尔斯]";
		mes "你的名字已经在名单上了。去指挥中心报到吧。";
		mes "否则你无法完全进入这个区域。";
		next;
		mes "[奥尔斯]";
		mes "完成后回来，我会把你介绍给其他成员。";
		mes "去吧。";
		close3;
	case 5:
		cutin "verus_aures.bmp",0;
		mes "[奥尔斯]";
		mes "啊，你回来了。";
		mes "向我们的首领伊恩·阿特纳德问好。";
		next;
		cutin "verus_ian03.bmp",2;
		mes "[Ian Atnad]";
		mes "……菜鸟。";
		mes "我没时间应付菜鸟。把他送回去！";
		next;
		cutin "verus_aures.bmp",0;
		mes "[奥尔斯]";
		mes "你又来了。";
		mes "我们老了，需要帮助！";
		mes "别这么固执。";
		next;
		cutin "verus_ian03.bmp",2;
		mes "[Ian Atnad]";
		mes "……嘿，菜鸟。";
		mes "是我女儿派你来监视我的吗？";
		mes "告诉我！";
		next;
		if (select( "我是来帮忙的。", "我不知道你在说什么。" ) == 2) {
			cutin "verus_ian02.bmp",2;
			mes "[Ian Atnad]";
			mes "嗯？你不知道我女儿是谁？";
			mes "那就保持这样吧。";
			next;
		}
		cutin "verus_ian01.bmp",2;
		mes "[Ian Atnad]";
		mes "这意味着你知道我女儿是谁。";
		mes "你真的觉得能和我合作？";
		mes "知道我是谁？";
		next;
		mes "[Ian Atnad]";
		mes "好吧。";
		mes "开始工作吧。";
		mes "我想知道你能否服从命令。";
		next;
		cutin "verus_aures.bmp",0;
		mes "[奥尔斯]";
		mes "伊恩，你真是没救了。";
		mes "那么，欢迎加入团队，年轻的冒险者。";
		mes "我们计划的一些工作很考验体力，更不用说危险了。";
		next;
		cutin "verus_ian01.bmp",2;
		mes "[Ian Atnad]";
		mes "够了。菜鸟，过来。";
		next;
		cutin "verus_aures.bmp",0;
		mes "[奥尔斯]";
		mes "抱歉。";
		mes "你最好过去。";

// setting map-variable
-	script	MV_Eden Market Group	FAKE_NPC,{
OnInit:
OnClock0000:
	switch( gettime(DT_DAYOFWEEK) ) {
	case WEDNESDAY:
		$event_paramk = 0;
		break;
	case FRIDAY:
		$event_paramk = 2;
		break;
	case SATURDAY:
		if (gettime(DT_HOUR) > 21)
			$event_paramk = 4;
		else
			$event_paramk = 3;
		break;
	case THURSDAY:
	default:
		$event_paramk = 1;
		break;
	}
	end;

OnSat2200:
	$event_paramk = 4;
	end;
}

// Eden Market Group Hustler
moc_para01,106,38,4	script	Market Group Hustler#ent	4_M_YOYOROGUE,{
	mes "[Hustler]";
	mes "嘿，冒险者。";
	mes "我可以带你去个好地方。感兴趣吗？";
	next;
	switch (select("前往伊甸市场集团！:关于伊甸市场集团。:取消。")) {
	case 1:
		mes "[Hustler]";
	mes "出发~！";
		close2;
		warp "paramk",97,17;
		end;
	case 2:
		mes "[Hustler]";
	mes "哈哈哈……伊甸市场集团是商人聚集、出售各种物品的地方。";
	mes "我说的可不是随处都能获得的杰勒比之类的普通东西。我们这里只交易真正的好货。";
		next;
		mes "[Hustler]";
	mes "普通材料、宝石、来自地下城和挖掘遗址的稀有物品，还有来自异次元的奇异宝物……";
	mes "你想要的一切应有尽有！";
		next;
	select("你的意思是，这是黑市？！");
		mes "[Hustler]";
	mes "啊……我不会这么说。";
	mes "这个市场嘛，严格来说是合法的……";
	mes "请记住，大多数特殊商品都是^4d4dff限量^000000的。来晚了可能就卖光了。";
		next;
		mes "[Hustler]";
	mes "大多数限量商品不会打折。";
	mes "你必须支付全价。";
		next;
		mes "[Hustler]";
	mes "冒险者有时会来出售探险中找到的东西。";
	mes "不过，你得亲自来看看！";
		next;
		mes "[Hustler]";
	mes "请注意，大多数商店每周有一天休息；^4d4dff大多数商店周三不营业^000000。";
	mes "不过不是所有商店都在周三休息，大部分仍然会营业。";
		next;
		mes "[Hustler]";
	mes "周末会出售更加特别的物品。";
	mes "我甚至见过有人出售" + mesitemlink( 709, false ) + "~";
	mes "真是不可思议。";
	mes "当然贵得离谱，而且只有少量出售。";
		next;
		mes "[Hustler]";
	mes "怎么样？感兴趣吗？";
	mes "值得去看看吧？";
	mes "哈哈哈哈哈！";
		close;
	case 3:
		mes "[Hustler]";
	mes "想去伊甸市场集团的话，随时来找我！";
		close;
	}
}

// Eden Market Group Guide
paramk,101,22,3	script	Market Group Guide#info	4_F_ZONDAGIRL,{
	mes "[Guide]";
	mes "你好。欢迎来到伊甸市场集团，这是由大陆商人联盟运营、伊甸集团支持的官方市场。";
	next;
	switch (select("关于营业时间。:关于特殊商品。:关于伊甸市场集团。:取消。")) {
	case 1:
		mes "[Guide]";
	mes "伊甸市场集团是一个汇集许多不同商店的市场。";
		next;
		mes "[Guide]";
	mes "周三是市场规定的官方休息日；大多数商店当天歇业。";
		next;
		mes "[Guide]";
	mes "不过根据店主意愿和所售商品类型，一些商店即使在休息日也会部分营业。";
		next;
		mes "[Guide]";
	mes "此外，有些商店会在每周特定日期出售特殊商品。请记住这一点。";
		close;
	case 2:
		mes "[Guide]";
	mes "有些商店会在周末、每周特定日期甚至特定时段出售不同商品；这些商品与平日商品不同。";
		next;
		mes "[Guide]";
	mes "“奇妙的朋友”和“强大的朋友”每个周末会各出售一种稀有商品。";
	mes "“矿工联盟”只在周末出售铁匠用的砧。";
		next;
		mes "[Guide]";
	mes "我无法告诉你每家商店出售什么，因为它们各不相同。";
	mes "何不自己多来逛逛，亲自了解呢？";
		close;
	case 3:
		mes "[Guide]";
	mes "许多拥有商人之魂的人想把物品卖给有需要的人。";
	mes "伊甸市场集团为他们指定了买卖场所。";
		next;
		mes "[Guide]";
	mes "我们与商人联盟和冒险者合作，让原本可能成为违禁品的货物也能以公平透明的方式买卖。";
		next;
		mes "[Guide]";
	mes "有人嘀咕伊甸市场集团是黑市……哈哈，真是荒唐的想法……";
	mes "我们只是一个商人联盟。";
		next;
		mes "[Guide]";
	mes "我们的一部分利润用于运营冒险者公会伊甸集团。";
	mes "你可以在这里出售冒险战利品，我们的利润则用于提供对你有益的服务，真是一举两得。";
		next;
		mes "[Guide]";
	mes "请记住，限量商品永远不会打折！";
		close;
	case 4:
		mes "[Guide]";
	mes "祝你购物愉快！";
		close;
	}

OnTimer60000:
	npctalk "欢迎。这里是伊甸市场集团。";

OnInit:
	initnpctimer;
	end;
}

// Guards
paramk,103,17,3	script	Market Guard#1	4_M_YOUNGKNIGHT,{
	callfunc("F_CoolDown", 5);
	switch (atoi(strnpcinfo(2))) {
	default:
		npctalk "欢迎。";
		break;
	case 3:
		npctalk "欢迎来到伊甸市场集团。";
		break;
	case 4:
		npctalk "你好吗？这里是伊甸市场集团。";
		break;
	case 5:
		npctalk "感谢你在伊甸市场集团购物。";
		break;
	case 6:
		npctalk "欢迎。伊甸市场集团欢迎你。";
		break;
	}
	end;
}


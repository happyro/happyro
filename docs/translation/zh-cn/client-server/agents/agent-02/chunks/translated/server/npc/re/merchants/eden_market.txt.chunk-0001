// Cassie
paramk,113,56,3	script	Cassie#gst05	1_F_PUBGIRL,6,6,{
	npctalk "欢迎来到伊甸市场集团~想来杯特别的饮料吗？";
	mes "[Cassie]";
	mes "你想买饮料吗？";
	next;
	switch (select("热带苏格拉特。:海滩绯红。:不。")) {
	case 1:
		.@item = 12112;
		break;
	case 2:
		.@item = 12113;
		break;
	case 3:
		mes "[Cassie]";
	mes "祝你愉快。";
		close;
	}
	if (Zeny < 800) {
		mes "[Cassie]";
	mes "饮料售价 800 Zeny。";
		close;
	}
	mes "[Cassie]";
	mes "请享用。";
	Zeny -= 800;
	getitem(.@item, 1);
	close;

OnTouch:
	callfunc("F_CoolDown", 4);
	npctalk "欢迎来到伊甸市场集团。想来杯特别的饮料吗？";
	end;
}

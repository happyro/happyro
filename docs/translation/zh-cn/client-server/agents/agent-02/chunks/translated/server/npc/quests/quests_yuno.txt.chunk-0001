// Metto Quest :: yuno_ryusei
//============================================================
yuno_in03,26,39,3	script	Metto#juno	709,{
	mes "[Metto]";
	if (metto_q == 0) {
		mes "实验室，今天在实验室，明天也在实验室！每天都在研究中度过！即使要耗尽一生，我也不会放弃，直到创造出全新的朱诺……";
		next;
		mes "[Metto]";
		mes "一个所有人都能沐浴在我天才光芒下的全新朱诺！只要能驾驭飞行的力量……我知道我能做到！";
		next;
		mes "[Metto]";
		mes "^FF0000瓦甘^000000说我的想法疯狂又不可能实现。但我不是傻瓜，不会被他的嘲笑动摇！";
		close;
	}
	else if (metto_q == 1) {
		set metto_q,2;
		mes "我要请我的同事^FF0000斯坦克尔^000000帮忙。我相信他一定很乐意帮助老朋友。";
		next;
		mes "[Metto]";
		mes "有那家伙帮忙的话，事情会容易多了。祈祷吧！向你相信的任何神祈祷我们能够成功！";
		close;
	}
	else if (metto_q == 3) {
		set metto_q,4;
		mes "什么？你是说那个斯坦克尔不愿意帮我？！这可不妙，会严重拖慢我的研究。";
		next;
		mes "[Metto]";
		mes "……";
		mes "我现在该怎么办？！";
		next;
		mes "[Metto]";
		mes "幸运的是，我还有备用计划。我相信我的朋友兼同事^FF0000卡托^000000会伸出援手。";
		next;
		mes "[Metto]";
		mes "只要能研究他的超级机器人伟大Z，我就能继续研究……";
		next;
		mes "[Metto]";
		mes "既然斯坦克尔不愿意帮我，那就随他去吧。不管他帮不帮忙，我都必须继续研究。";
		next;
		mes "[Metto]";
		mes "期待伟大的成果吧，年轻的朋友。呜哈哈哈哈。";
		close;
	}
	else if (metto_q == 5) {
		set metto_q,6;
		mes "什么？你是说我继续研究所需要的东西——强大的伟大Z——已经被摧毁了？！";
		next;
		mes "[Metto]";
		mes "不——！！为什么？他们为什么要这样做？难道众神在诅咒我？！";
		next;
		mes "[Metto]";
		mes "等等，我需要……冷静下来……";
		next;
		mes "[Metto]";
		mes "如果能得到^FF0000琪琪教授^000000的骑乘引擎理论帮助，也许我就能完成研究……";
		next;
		mes "[Metto]";
		mes "我还有希望！哈！哈！哈！";
		close;
	}
	else if (metto_q == 7) {
		set metto_q,8;
		mes "……";
		next;
		mes "[Metto]";
		mes "……\n……";
		next;
		mes "[Metto]";
		mes "怎么会连续三次发生这种事？没错，众神已经抛弃我了！我完了……完了！！！";
		next;
		mes "[Metto]";
		mes "我现在还能做什么……？难道真的到了放弃多年研究的时候吗？";
		next;
		mes "[Metto]";
		mes "我知道让你失望了，但请把我彻底忘掉吧。";
		next;
		mes "[Metto]";
		mes "谁会这样对我？什么样的恶毒之人会粉碎一个人的梦想？？";
		next;
		mes "[Metto]";
		mes "我受够了。我想是时候放弃了。一切都结束了。请别太失望……";
		close;
	}
	else if (metto_q == 8) {
		mes "也许我该考虑转职。听说这如今是很流行的选择。";
		next;
		mes "[Metto]";
		mes "我该考虑什么呢？我唯一确定的是，我不想再当科学家了。我受够研究了……";
		close;
	}
	else {
		mes "我得去看看这个新东西。你还在这里做什么？我过一会儿就要出发了。";
		next;
		mes "[Metto]";
		mes "我得准备一下！你先走吧，我很快就要出门了。";
		close;
	}
}

yuno_in01,17,30,5	script	Wagan#juno	85,{
	mes "[Wagan]";
	if (metto_q == 0) {
		mes "我相信你知道，我们的城市多年来一直依靠研究发展。";
		next;
		mes "[Wagan]";
		mes "我们能拥有这样的生活质量，要感谢那些献身于研究和学习的人。";
		next;
		mes "[Wagan]";
		mes "所以我们彼此帮助、共同研究。进行研究时，有这样坚实的支持很令人安心。";
		next;
		mes "[Wagan]";
		mes "但也有几个害群之马，简直让我抓狂……";
		next;
		mes "[Wagan]";
		mes "努力当然是好事，但有些自私又疯狂的科学家让我们其他人的工作变得更困难。";
		next;
		mes "[Wagan]";
		mes "在这些人里，^FF0000梅托^000000绝对是最糟糕的。他总在研究疯狂的东西……";
		next;
		mes "[Wagan]";
		mes "他以科学为名破坏公共设施，制造噪音和空气污染，扰乱公共秩序……";
		next;
		mes "[Wagan]";
		mes "还以研究为借口为自己的行为辩护！他已经走火入魔了！";
		next;
		mes "[Wagan]";
		mes "真希望有办法阻止他继续给我们添乱。应该有勇敢无畏的人来做点什么……";
		next;
		if (select("交给我吧。:祝你们村子好运。") == 1) {
			if (Class == Job_Novice) {
				mes "[Wagan]";
				mes "嗯……谢谢你的好意，但我不认为你能做到这件事……";
				next;
				mes "[Wagan]";
				mes "我想我们需要更强硬的人来帮忙。对初心者来说，这有点太难了。";
				next;
				mes "[Wagan]";
				mes "请别因此生气。";
				close;
			}
			set metto_q,1;
			mes "[Wagan]";
			mes "哦，你要替我们处理这件事吗？那我们会非常感激。";
			next;
			mes "[Wagan]";
			mes "但你打算怎么做？我想这比听起来困难……";
			next;
			if (select("当然，我有计划。:我想我需要一个计划。") == 1) {
				mes "[Wagan]";
				mes "我相信你。你应该知道，他相信命运。利用这一点。";
				next;
				mes "[Wagan]";
				mes "知道你会处理这个小麻烦，我安心多了……";
				close;
			}
			mes "[Wagan]";
			mes "嗯……我欣赏你的热情，但没有计划，你打算怎样完成任何事情？";
			next;
			mes "[Wagan]";
			mes "你需要设法骗他放弃。要巧妙一些，比如……嗯……";
			next;
			mes "[Wagan]";
			mes "……破坏他的实验，让它看起来像是命中注定会失败！";
				next;
			mes "[Wagan]";
			mes "他很健谈，只要接近他，他就会把你需要知道的一切告诉你。";
				next;
			mes "[Wagan]";
			mes "是啊……这个计划我已经想了一阵子了……";
			close;
		}
		mes "[Wagan]";
		mes "我们只能祈祷命运帮助我们。说起来，梅托非常相信命运。";
		next;
		mes "[Wagan]";
		mes "要是我们能利用这一点就好了……";
		close;
	}
	else if (metto_q == 8) {
		mes "谢谢你的帮助。多亏你除掉了梅托，我们少了一件烦心事。";
		next;
		mes "[Wagan]";
		mes "我相信朱诺人民都非常感谢你。这是我们的一点心意……";
		next;
		mes "[Wagan]";
		if (Class == Job_Sage) {
			if (MaxWeight - Weight < 300) {
				mes "糟糕，你携带的东西似乎太多了！能腾出些空间吗？";
				close;
			}
			set metto_q,9;
			mes "祝你今后一切顺利……";
			getitem 715,10; //Yellow_Gemstone
			close;
		}
		if (MaxWeight - Weight < 150) {
			mes "糟糕，你携带的东西似乎太多了！能腾出些空间吗？";
			close;
		}
		set metto_q,9;
		mes "祝你今后一切顺利……";
		getitem 717,5; //Blue_Gemstone
		close;
	}
	else if (metto_q == 9) {
		mes "没有梅托在这里，周围似乎平静多了。谢谢你的帮助。";
		close;
	}
	else {
		mes "你和梅托的工作进展如何？希望计划顺利。抱歉让你处理这样的任务。";
		close;
	}
}
yuno_in01,17,95,5	script	Stangckle#juno	99,{
	mes "[Stangckle]";
	if (metto_q == 2) {
		mes "我能为你做什么？我的同事梅托很快就要来了，我没有多少时间。你刚才说需要什么？";
		next;
		if (select("我来阻止你的研究。:我什么也不需要。") == 1) {
			set metto_q,3;
			mes "[Stangckle]";
			mes "……"; next;
			mes "[Stangckle]"; mes "……\n……"; next;
			mes "[Stangckle]"; mes "……\n……\n……"; next;
			mes "[Stangckle]"; mes "真的吗？梅托不把我当同事，却还想让我帮他？！"; next;
			mes "[Stangckle]"; mes "他只把我当助手，还要把我们发现的一切功劳都偷走？！"; next;
			mes "[Stangckle]"; mes "这家伙不可信！传闻是真的：他真的疯了！"; next;
			mes "[Stangckle]"; mes "想不到我曾经那么尊敬那个叛徒！我再也不想看到他的脸。"; next;
			mes "[Stangckle]"; mes "幸好像你这样诚实可靠的人有勇气告诉我。谢谢你。"; next;
			mes "[Stangckle]"; mes "那么，失陪了，我还有工作要做。";
			close;
		}
		mes "[Stangckle]"; mes "那你在做什么？别浪费我的时间。"; close;
	}
	else if (metto_q == 0) {
		mes "我是这座城市的科学家之一。我叫斯坦克尔。";
		next;
		mes "[Stangckle]";
		mes "你应该记住我的名字，将来可能会对你有用。";
		close;
	}
	else if (metto_q == 1) {
		mes "我是这座城市的科学家之一。我叫斯坦克尔。";
		next;
		mes "[Stangckle]";
		mes "你应该记住我的名字，将来可能会对你有用。";
		close;
	}
	else {
		mes "梅托已经成为那种疯狂的科学家了。我想那就是他最终为自己选择的人生。"; close;
	}
}

yuno_in01,19,183,5	script	Kato#juno	55,{
	mes "[Kato]";
	if (metto_q == 4) {
		mes "我是研究各种事物的科学家。"; next;
		mes "[Kato]"; mes "当然，我的研究属于私人机密。不过，我能为你做什么？"; next;
		if (select("我想阻止你犯错。:只是来打个招呼。") == 1) {
			set metto_q,5;
			mes "[Kato]"; mes "什么？梅托说我的伟大Z不如斯坦克尔的研究？！"; next;
			mes "[Kato]"; mes "他、他说我应该把发明改名为“废柴Z”？*抽泣* 我……我不敢相信……*呜咽*"; next;
			mes "[Kato]"; mes "如、如果我的发明不好，那我想我应该摧毁伟大Z……*叹气*"; next;
			mes "[Kato]"; mes "谢谢你告诉我。我知道把这些话告诉我并不容易。"; close;
		}
		mes "[Kato]"; mes "……\n好吧……\n嗯……嘿。"; close;
	}
	else if (metto_q == 6 || metto_q == 7 || metto_q == 8 || metto_q == 9) {
		mes "我对研究人工智能很感兴趣。就是机器人之类的。"; next;
		mes "[Kato]"; mes "我知道这很难做到，但有志者事竟成。"; next;
		mes "[Kato]"; mes "如果你见到这种真正惊人的东西，就会知道那是我的作品。"; close;
	}
	else {
		mes "我是研究人工智能和机器人的科学家。"; next;
		mes "[Kato]"; mes "我现在没有具体项目，但我最近的创造——伟大Z——确实是纯粹天才的产物。"; close;
	}
}

yuno_in03,178,43,0	script	CiCi#juno	121,{
	if (metto_q == 6) {
		mes "[CiCi]"; mes "我叫琪琪，是这座城市三大科学家之一。"; next;
		mes "[CiCi]"; mes "这里有许多伟大的科学家，但能跻身前三是真正的荣耀。你不这么认为吗？"; next;
		mes "[CiCi]"; mes "嗯，我好像有点自夸过头了。你找我有什么事？"; next;
		switch(select("我想警告你。:没什么，只是来打招呼。")) {
		case 1:
			set metto_q,7;
			mes "[CiCi]"; mes "嗯？梅托说他不需要我的骑乘引擎理论？！哼，真是个忘恩负义的家伙！"; next;
			mes "[CiCi]"; mes "我真想教教他什么才是真正的科学和聪明的研究。"; next;
			mes "[CiCi]"; mes "他觉得我欠他一个道歉？！为什么？我凭什么道歉……？！"; next;
			mes "[CiCi]"; mes "算了，反正我也没有帮助他的必要零件。无论如何，他都没有机会。"; next;
			mes "[CiCi]"; mes "告诉他，我根本不想参与他正在做的事。他甚至没有进行我们能够公开发表的研究。"; close; break;
		case 2:
			mes "[CiCi]"; mes "什么？就这样？你来之前我就很无聊了，结果你让我更无聊。"; break;
		}
	}
	else if (metto_q < 6) {
		mes "[CiCi]";
		mes "我叫琪琪，是这座城市三大科学家之一。这里有许多伟大的科学家。";
		next;
		mes "[CiCi]";
		mes "但能跻身前三是真正的荣耀，你不这么认为吗？";
		close;
	}
	else {
		mes "[CiCi]"; mes "嗯……我想用新方法改进骑乘引擎，但缺少所需零件……"; next;
		mes "[CiCi]"; mes "真头疼~ 梅托从来没主动帮过我。这不会容易。"; close;
	}
}

// Alchemist Brothers Quest :: yuno_ryusei
//============================================================
yuno_in01,103,157,3	script	Bain#juno	98,{
	if (checkweight(1201,1) == 0) {
		mes "- 等一下！！ -";
		mes "- 你现在携带的物品太多了。 -";
		mes "- 请减轻负重后再试。 -";
		close;
	}
	if (countitem(974) > 0 && countitem(612) > 4 && countitem(1003) > 4 && countitem(7068) > 4 && countitem(7043) > 4 && countitem(757) > 2 && countitem(756) > 2 && Zeny >= 2000) {
		if (ALCH_Q == 23) set ALCH_Q,24;
		set .@kyulkwa,rand(1,10);
		mes "[Bain]"; mes "哦呵呵……这些就是我需要的零件。非常感谢。"; next;
		mes "[Bain]"; mes "好，我们来试试！请稍等一会儿！"; next;
		mes "^3355FF*嗡~~~~*^000000"; next;
		mes "^3355FF*咔咔咔咔咔咔咔咔*^000000"; next;
		mes "^3355FF*咔啦啦啦啦啦啦！*^000000"; next;
		if (.@kyulkwa < 4 || .@kyulkwa > 8)
			callsub S_DelItems,1002,5,1;
		if (.@kyulkwa == 5 || .@kyulkwa == 6 || .@kyulkwa == 8)
			callsub S_DelItems,723,5,1;
		else if (.@kyulkwa == 7)
			callsub S_DelItems,969,2,0;
	}
	if (bros_q == 1) {
		mes "[Bain]"; mes "如果你忘了，这些就是所需材料。需要的话记下来。"; next;
		mes "[Bain]"; mes "^FF00001 个混合剂^000000、^FF00005 个小型熔炉^000000、^FF00005 棵烧焦的树^000000、^FF00005 块煤炭^000000、^FF00005 份细沙^000000、^FF00003 块粗糙的铝^000000、^FF00003 块粗糙的黄晶^000000。"; next;
		mes "[Bain]"; mes "此外还需要 2,000 Zeny。祝你好运……"; close;
	}
	if (bros_q == 0) {
		mes "[Bain]"; mes "我们要发明一个会说话、会交流的玩偶！至少，我正在努力。"; next;
		mes "[Bain]"; mes "这个想法来自一个历史传说。我想既然以前有人做到过，这个项目就一定可行。"; next;
		mes "[Bain]"; mes "但现在我缺少尝试这项壮举所需的物资和零件。我不知道他们当初是怎样收集齐所有材料的……"; next;
		mes "[Bain]"; mes "钱只能买到我需要的一部分东西。有些物品必须从强得过分的怪物身上取得。我该怎么继续研究？"; next;
		if (select("我来帮你取得。:祝你好运。") == 1) {
			set bros_q,1;
			mes "[Bain]";
			mes "真的吗？这样慷慨的人可不多见。";

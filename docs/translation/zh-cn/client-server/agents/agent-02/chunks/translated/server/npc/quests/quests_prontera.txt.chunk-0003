			mes "[Historian Rodafrian]";
		mes "我现在待在摩洛克，参观斯芬克斯和金字塔，看看能否挖掘遗迹。希望能发现新的历史证据。";
			next;
			mes "[Historian Rodafrian]";
		mes "如果你想了解更多摩洛克的历史，请去和我的助手谈谈。他非常热衷研究这座城镇的文化与背景。";
			next;
			mes "[Historian Rodafrian]";
		mes "其实摩洛克人也珍视城镇历史，世代传唱古老时代的歌曲。让我想想，那首歌怎么唱来着？";
			next;
			mes "[Historian Rodafrian]";
		mes "^FF0000*巨蛇*^000000";
		mes "^FF0000*吞下了大海。*^000000";
		mes "^FF0000*彩虹之鹰*^000000";
		mes "^FF0000*吞下了巨蛇，然后*^000000";
		mes "然后……然后……呃，糟糕。";
			next;
			mes "[Historian Rodafrian]";
		mes "我记不起下一句了！对了，你以前听过这首歌吗？";
			next;
		switch(select("是的，听过。:听过，但不一样。:不，抱歉。")) {
			case 1:
				mes "[Historian Rodafrian]";
				mes "哦，太好了！你能告诉我这些歌词后面的句子吗？";
				next;
				mes "^FF0000*巨蛇*^000000";
				mes "^FF0000*吞下了大海。*^000000";
				mes "^FF0000*彩虹之鹰*^000000";
				mes "^FF0000*吞下了巨蛇。*^000000";
				mes "......................";
				next;
				input .@answer$;
				if (.@answer$ == "Then the eagle built its nest.") {
					mes "[Historian Rodafrian]";
					mes "真的吗？这说得通，但歌词听起来和我听过的不一样。嗯……如果不介意，请告诉我你的名字？";
					callsub S_GiveName,1;
				}
				else {
					mes "[Historian Rodafrian]";
				mes "咦……？听起来完全不对。你确定听到的是这句歌词？";
					delitem 7342,1; //File01
					set prt_curse,7;
					close;
				}

			case 2:
				mes "[Historian Rodafrian]";
				mes "你说什么？歌曲不一样？嗯，那么请把你知道的版本唱给我听？";
				next;
				mes "^3355FF你清了清嗓子，开始唱从卡洛莫夫那里听到的歌曲。^000000";
				next;
				mes "["+strcharinfo(0)+"]";
				input .@line$;
				if (.@line$ == "The great serpent swallowed the sea.") {
					set .@total,.@total+1;
					mes "*巨蛇*吞下了大海。";
				}
				else mes "* "+.@line$+"*";

				input .@line$;
				if (.@line$ == "The eagle of the rainbow swallowed the serpent.") {
					set .@total,.@total+1;
					mes "*彩虹之鹰*吞下了巨蛇。";
				}
				else mes "*"+.@line$+"*";

				input .@line$;
				if (.@line$ == "Then the eagle built its nest.") {
					set .@total,.@total+1;
					mes "*然后彩虹之鹰筑起巢穴。*";
				}
				else mes "*"+.@line$+"*";

				input .@line$;
				if (.@line$ == "A nest upon the swallowed sea.") {
					set .@total,.@total+1;
					mes "*巢穴建在被吞下的大海之上。*";
				}
				else mes "*"+.@line$+"*";
				next;
				if (.@total == 4) {
					mes "[Historian Rodafrian]";
					mes "真的吗？这说得通，但歌词和我听过的不一样。嗯……如果不介意，请告诉我你的名字？";
					callsub S_GiveName,1;
				}
				else {
					mes "[Historian Rodafrian]";
					mes "咦……？听起来完全不对。你确定听到的是这些歌词？";
					delitem 7342,1; //File01
					set prt_curse,7;
					close;
				}

			case 3:
				mes "[Historian Rodafrian]";
				mes "............";
				mes "........................";
				mes "那么，冒险者，可以告诉我你的名字吗？";
				callsub S_GiveName,1;
			}
		}
		mes "[Historian]";
		mes "虽然我喜欢研究并发掘历史新资料，但有时会感到孤独。毕竟很少有人和我有相同兴趣……";
		close;
	}
	else if (prt_curse == 7) {
		mes "^3355FF罗达弗里安抱着双臂，似乎陷入沉思。随后像做出重要决定般直视你的眼睛，开口说道。^000000";
		next;
		mes "[Historian Rodafrian]";
		mes "冒险者……我想知道你的名字。";
		callsub S_GiveName,0;
	}
	else if (prt_curse > 7 && prt_curse < 30) {
		mes "[Historian Rodafrian]";
		mes "如果我没记错，蒙多应该在卢恩-米德加尔特北部的雷神之锤山。去问他那首我记不住的歌的歌词……";
		close;
	}
	else if (prt_curse == 30 || prt_curse == 55) {
		mes "[Historian Rodafrian]";
		mes "哦，你回来了。见到蒙多并弄清我寻找的那首歌的歌词了吗？";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "^FF0000*巨蛇吞下了大海。* 彩虹之鹰吞下了巨蛇。*蛇鳞在鹰身上生长，鹰渐渐死去。*^000000";
		next;
		mes "[Historian Rodafrian]";
		mes "哦，是的！就是这样！我想起来了，非常感谢！啊，继续工作……";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "^333333（罗达弗里安是历史学家，也许能帮我调查吉欧博格家的诅咒。但祭司们让我保密。我该冒这个险吗？）^000000";
		next;
		if (select("告诉她耶梦加得的诅咒:不要告诉她") == 1) {
			mes "^3355FF你将所知的一切告诉罗达弗里安，没有隐瞒任何秘密。^000000";
			emotion ET_AHA;
			next;
			mes "[Historian Rodafrian]";
			mes ".....................!";
			emotion ET_SURPRISE;
			next;
			mes "[Historian Rodafrian]";
			mes "谢谢你与我分享。我希望你明白这信息多么珍贵。我完全不知道王室隐藏着这种秘密。天哪……";
			next;
			mes "[Historian Rodafrian]";
			mes "我其实不太了解毒药，但除了刺客之外，西方某个奇异国度还住着毒药专家。";
			next;
			mes "[Historian Rodafrian]";
			mes "总之，雷根贝勒历史研究组会非常重视你关于吉欧博格家族的报告。但我得先完成摩洛克项目……";
			next;
			mes "[Historian Rodafrian]";
			mes "总之，暂时替我保密。等我揭露吉欧博格王室的秘密诅咒，就能彻底胜过卡洛莫夫！哇哈哈哈哈！";
			next;
			mes "["+strcharinfo(0)+"]";
		mes "^333333（糟糕，她没有帮我……我只是向她透露了一个可能被传播的巨大秘密！算了，我最好回去找祭司……）^000000";
			if (prt_curse == 30)  {
				set prt_curse,31;
				//changequest 18042,18044;
			} else {
				set prt_curse,60;
				//changequest 18051,18052;
			}
			close;
		}

		mes "[Historian Rodafrian]";
			mes "哦，再次感谢你费心帮我找歌词~我已经让助手够辛苦了……";
		next;
		mes "[Historian Rodafrian]";
			mes "我也不能忘了查看卡洛莫夫的报告。迟早要和他辩论，我一定要让他认清自己的位置！";
		next;
			mes "^3355FF罗达弗里安非常高兴，开始阅读卡洛莫夫的报告。现在最好先回去找班普神父。^000000";
		if (prt_curse == 30) {
			set prt_curse,40;
			//changequest 18042,18045;
		} else {
			set prt_curse,56;
			//completequest 18051;
		}
		close;
	}
	else if (prt_curse == 31 || prt_curse == 40) {
		mes "^3355FF罗达弗里安非常高兴，开始阅读卡洛莫夫的报告。现在最好先回去找班普神父。^000000";
		close;
	}
	else if (prt_curse == 56) {
		emotion ET_FRET;
		mes "[Historian Rodafrian]";
		mes "我刚去找过卡洛莫夫，把我的想法告诉他！我想……我让他认清了自己的位置。但那个狡猾的家伙很难捉摸……";
		close;
	}
	else if (prt_curse == 60) {
		emotion ET_FRET;
		mes "[Historian Rodafrian]";
		mes "我刚去找过卡洛莫夫，把我的想法告诉他！我想……我让他认清了自己的位置。但那个狡猾的家伙很难捉摸……";
		next;
		mes "罗达弗里安似乎无法再提供信息。现在最好前往^3355FF普隆德拉教堂。^000000";
		close;
	}
	else {
		mes "[Historian Rodafrian]";
		mes "抱歉，我现在正忙于研究。等完成后再谈好吗？";
		close;
	}

S_GiveName:
	next;
	select("我的名字是"+strcharinfo(0)+"。");
	mes "[Historian Rodafrian]";
	mes "啊，"+strcharinfo(0)+"？我能请你帮忙吗？我需要确认这首歌的真实歌词，但必须留在摩洛克完成研究。";
	next;
	mes "[Historian Rodafrian]";
	mes "请找到我的同事蒙多，向他询问这首歌的歌词。他在卢恩-米德加尔特北部的雷神之锤山古代遗迹中。";
	next;
	mes "[Historian Rodafrian]";
	mes "抱歉让你做这种听起来很傻的跑腿，但为了研究我确实需要知道这首歌的歌词……";
	if (getarg(0) == 1) delitem 7342,1; //File01
	set prt_curse,8;
	//changequest 18031,18032;
	close;
}

mjolnir_01,135,168,3	script	Historian#prt03	754,{
	if ((MaxWeight-Weight) < 2000 || checkweight(1201,1) == 0) {
		mes "^3355FF等一下！你携带的物品太多。请使用卡普拉服务存放一些物品后再回来。^000000";
		close;
	}
	if (prt_curse == 8) {
		mes "[Historian Mondo]";
		mes "不好意思……如果你没有重要的事，能请你离开吗？我还有研究要做……";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "抱歉，罗达弗里安女士让我向你询问描述卢恩-米德加尔特王国建立的歌曲歌词。能替她告诉我吗？";
		next;
		mes "[Historian Mondo]";
		mes "罗达弗里安？哦，她指的是那首古老的童谣。怎么唱来着？啊，我想起来了……";
		next;
		mes "[Historian Mondo]";
		mes "^FF0000*巨蛇吞下了大海。彩虹之鹰吞下了巨蛇。蛇鳞在鹰身上生长，鹰渐渐死去。*^000000";
		next;
		select("...........?");
		mes "[Historian Mondo]";
		mes "是的，我知道：尽管唱起来很欢快，这首歌其实相当阴暗。有时这种童谣就是用来吓唬孩子行善。";
		next;
		select("不好意思……");
		mes "[Historian Mondo]";
		mes "嗯？你看起来很困惑。想问我这首歌的事吗？";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "其实我听过这首歌的另一个版本，所以想知道歌词为什么不同……";
		next;
		mes "[Historian Mondo]";
		mes "真的吗？那么请从头唱一遍你听过的版本。";
		next;
		callsub S_Song;
	}
	else if (prt_curse == 9) {
		mes "[Historian Mondo]" ;
		mes "啊，你能告诉我你听到的卢恩-米德加尔特建国神话歌曲版本的歌词吗？";
		next;
		callsub S_Song;
	}
	else if (prt_curse == 10) {
		mes "[Historian Mondo]";
		mes "有趣……你从卡洛莫夫那里听到的版本和我知道的不一样。也许他的版本才是最真实的。";
		next;
		mes "[Historian Mondo]";
		mes "毕竟，我知道的版本是听一个小孩唱的。";
		next;
		select("小孩？");
		mes "[Historian Mondo]";
		mes "是的。我猜那个孩子唱的版本可能在世代口耳相传中发生了变化。如果想了解更多，你最好找到那个孩子。";
		next;
		mes "[Historian Mondo]";
		mes "总之，卡洛莫夫可能拥有最准确的版本，因为他擅长搜集和鉴定历史书面记录与文件。这是他的专长。";
		next;
		mes "[Historian Mondo]";
		mes "啊，如果想了解更多，你应该去找唱歌的孩子。嗯，他可能在^3131DD附近的河边^000000。希望不难找到。";
		next;
		mes "[Historian Mondo]";
		mes "和那个孩子谈过后，回去向罗达弗里安报告。她可能很快就需要知道，而我可以稍后再和孩子谈……";
		next;
		mes "[Historian Mondo]";
		mes "那么，希望你能找到想要的答案。";
	//

mid_camp,222,283,4	script	Marian#ep13bs	727,{
	if (checkweight(1201,1) == 0 || MaxWeight - Weight < 1000) {
		mes "[Marian]";
		mes "你携带了太多物品~";
		mes "丢弃一些后再回来找我。";
		close;
	}
	if (ep13_newbs < 1) {
		if (ep13_ryu > 99 || ep13_start > 99) {
			mes "[Marian]";
			mes "你一定是这里的陌生人。";
			mes "这是你第一次来吗？";
			next;
			switch(select("是。:否。")) {
			case 1:
				mes "[Marian]";
				mes "果然如此~";
				mes "我没有撒谎，不过通常";
				mes "我不会忘记一张脸。";
				emotion ET_THROB;
				next;
				mes "[Marian]";
				mes "总之……";
				mes "如果这是你第一次来，";
				mes "最好去见 ^0000FF卢根教官^000000。";
				mes "他能帮助你适应";
				mes "这里的环境。";
				next;
				mes "[Marian]";
				mes "向右走就能找到";
				mes "^0000FF卢根教官^000000。";
				set ep13_newbs,1;
				getitem 12322,1; //Chocolate_Pie
				setquest 11084;

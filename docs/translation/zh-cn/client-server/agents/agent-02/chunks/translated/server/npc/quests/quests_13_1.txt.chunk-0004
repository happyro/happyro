moc_ruins,137,89,5	script	Time-Space Gap Guard	707,{
	if (ep13_ryu == 100) {
		mes "[Guard]";
		mes "- Trembling in fear. -";
		next;
		mes "[Guard]";
		mes "- Trembling in fear. -";
		next;
		mes "[Guard]";
		mes "说实话，我应该守在次元裂缝旁，";
		mes "但那里太可怕了。";
		mes "我从那里逃走了。";
		mes "";
		next;
		mes "[Guard]";
		mes "啊？";
		mes "你真勇敢！";
		mes "完全不害怕周围的事物。我真羡慕你……";
		next;
		mes "[Guard]";
		mes "我是个胆小鬼，但我能送你穿过次元裂缝。";
		mes "这是我唯一能为你做的事。";
		next;
		mes "[Guard]";
		mes "我可以轻松把你送过去，";
		mes "但别把我的事告诉别人。好吗？";
		next;
		mes "[Guard]";
		mes "那么，你现在想穿过时空裂缝吗？";
		next;
		switch(select("是。:不用了，谢谢。")) {
		case 1:
			mes "[Guard]";
			mes "好，那我送你过去。正如我说的，别把我的事告诉任何人。总之……祝你好运！！";
			close2;
			warp "moc_fild22b",49,195;
			end;
		case 2:
			mes "[Guard]";
			mes "没关系。";
			mes "只是请别把我的事告诉任何人。";
			close;
		}
	}
	mes "[Guard]";
	mes "- Trembling in fear. -";
	next;
	mes "[Guard]";
	mes "说实话，我应该守在次元裂缝旁，";
	mes "但那里太可怕了。";
	mes "我从那里逃走了。";
	mes "";
	next;
	mes "[Guard]";
	mes "- Trembling. -";
	mes "请保守我在这里的秘密。";
	mes "我好害怕！！";
	mes "";
	close;
}

moc_fild22b,370,370,3	script	Allied Manager#gm	100,{
	callfunc "F_GM_NPC";
	mes "[Manager]";
	mes "请输入密码。";
	next;
	set .@i, callfunc("F_GM_NPC",8028,0,0,9000);
	if (.@i == -2) {
		mes "[Manager]";
		mes "密码错误。";
		close;
	} else if (.@i == -1) {
		mes "[Manager]";
		mes "请输入非 0 的密码。";
		close;
	} else if (.@i == 0) {
		mes "[Manager]";
		mes "那就算了。";
		close;
	} else {
		mes "[Manager]";
		mes "你想做什么？";
		next;
		switch(select("重置联盟攻击。:没什么。")) {
		case 1:
			mes "[Manager]";
			mes "正在重置联盟攻击。";
			set $@ep13_test,2;
			disablenpc "Head of the Alliance#moo";
			close;
		case 2:
			mes "[Manager]";
			mes "那就算了。";
			close;
		}
	}
}


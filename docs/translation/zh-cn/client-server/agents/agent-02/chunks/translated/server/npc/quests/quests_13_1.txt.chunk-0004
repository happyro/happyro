moc_fild22b,230,197,5	script	Munkenro#2	967,{
	if (ep13_ryu == 100) {
		mes "[Munkenro]";
		mes "准备好探索灰色真空了吗？";
		next;
		switch(select("当然！:请稍等……")) {
		case 1:
			mes "[Munkenro]";
			mes "祝你好运！";
			mes "希望你在灰色真空的冒险中取得成功！";
			next;
			mes "[Munkenro]";
			mes "（……我只会跟随你的指引！）";
			mes "（我记得你意志坚定。）";
			mes "（虽然我有罪，）";
			mes "（我会尽力而为。）";
			close2;
			warp "mid_camp",210,291;
			end;
		case 2:
			mes "[Munkenro]";
			mes "去准备吧。";
			close;
		}
	}
	if (ep13_ryu == 20) {
		mes "[Munkenro]";
		mes "我是三王国联盟的首领。你是为了探索次元裂缝来到这里的，对吗？";
		next;
		mes "[Munkenro]";
		mes "嗯，你就是之前";
		mes "帮过忙的人……";
		mes "你叫" + strcharinfo(0) + "？";
		mes "我记得你。";
		next;
		mes "[Munkenro]";
		mes "席凯兹紧急辞去了职务。我是他的继任者。";
		next;
		mes "[Munkenro]";
		mes "你现在不需要知道全部细节。这对你并不重要，对吧？";
		next;
		mes "[Munkenro]";
		mes "你是为了探索次元裂缝而来。我不能马上送你过去。虽然你通过了之前的测试，但那已经是过去。你还没接受我的测试~";
		next;
		mes "[Munkenro]";
		mes "所以你需要再次接受测试。我现在没有太多时间，就进行一个简短测试。";
		next;
		mes "[Munkenro]";
		mes "这里的士兵现在会开始攻击你……如果你活下来，我就认可你。及时完成即可。";
		next;
		mes "[Munkenro]";
		mes "这能证明你足够强大。这是我能进行的最低限度测试。";
		next;
		changequest 10076,10077;
		set ep13_ryu,21;
		mes "[Munkenro]";
		mes "准备好后，";
		mes "告诉我就行。";
		close;
	}
	if (ep13_ryu == 21) {
		mes "[Munkenro]";
		mes "准备好了吗？";
		mes "开始吧！";
		next;
		switch(select("准备好了！！:请稍等……")) {
		case 1:
			mes "[Munkenro]";
			mes "好，祝你冒险顺利。";
			next;
			set ep13_ryu,22;
			if (isbegin_quest(10077) == 1)
				changequest 10077,10078; 
			donpcevent "Head of the Alliance#moo::OnEnable"; 
			mes "[Munkenro]";
			mes "如果你回来太晚，";
			mes "就会被视为失败，所以尽快回来。";
			close;
		case 2:
			mes "[Munkenro]";
			mes "如果你犹豫，";
			mes "就意味着失败。";
			mes "我再给你一次机会。去吧。";
			close;
		}
	}
	if ($@ep13_test == 2) {
		mes "[Munkenro]";
		mes "你相当狡猾……";
		mes "你之前怎么通过测试的？";
		mes "真让人难以置信。";
		next;
		mes "[Munkenro]";
		mes "我再给你一次机会。";
		mes "不要再犯任何错误。";
		next;
		set ep13_ryu,21;
		set $@ep13_test,0;
		mes "[Munkenro]";
		mes "准备好后，";
		mes "告诉我一声，";
		mes "我们就开始！";
		close;
	}
	if ($@ep13_test == 1) {
		mes "[Munkenro]";
		mes "我们正在测试其他冒险者，除非你有事找我，否则晚点再来。";
		close;
	}
	if (($@ep13_test == 0) && (ep13_ryu == 22)) {
		mes "[Munkenro]";
		mes "很好！你做得不错！";
		mes "虽然测试时间不够，但我认为几乎完美。";
		next;
		mes "[Munkenro]";
		mes "你可能觉得我太严格……但作为联盟首领，我只是在做必须做的事。";
		next;
		mes "[Munkenro]";
		mes "如果我无法管理好联盟，会因没能胜任席凯兹的工作而内疚。总之，我会尽力。";
		next;
		mes "[Munkenro]";
		mes "嗯？我只是在抱怨。";
		mes "你不必听这些。";
		mes "忘了吧。";
		next;
		completequest 10078;
		set ep13_ryu,100;
		if (checkre(3))
			getexp 66000,21000;
		else
			getexp 660000,210000;
		mes "[Munkenro]";
		mes "我会让你去那里。";
		mes "准备好后告诉我。";
		close;
	}
}

moc_fild22b,1,1,0	script	Head of the Alliance#moo	-1,{
OnInit:
	disablenpc "Head of the Alliance#moo";
	end;

OnEnable:
	mapannounce "moc_fild22b","Head of the Alliance: I command that all soldiers attack the adventurers around here for 15 minutes. This is an order!",bc_map;
	enablenpc "Head of the Alliance#moo";
	set $@ep13_test,1;
	initnpctimer;
	monster "moc_fild22b",0,0,"Allied Soldier",1851,80,"Head of the Alliance#moo::OnMyMobDead";
	end;

OnReset:
	killmonster "moc_fild22b","Head of the Alliance#moo::OnMyMobDead";
	end;

OnDisable:
	killmonster "moc_fild22b","Head of the Alliance#moo::OnMyMobDead";
	mapannounce "moc_fild22b","Head of the Alliance: All alliance members. All of you should stop your attacks and return to work. That's all.",bc_map;
	set $@ep13_test,0;
	disablenpc "Head of the Alliance#moo";
	end;

OnMyMobDead:
	if (mobcount("moc_fild22b","Head of the Alliance#moo::OnMyMobDead") < 41) {
		donpcevent "Head of the Alliance#moo::OnDisable";
	}
	end;

OnTimer900000:
	killmonster "moc_fild22b","Head of the Alliance#moo::OnMyMobDead";
	mapannounce "moc_fild22b","Head of the Alliance: All alliance members. All of you should stop your attacks and return to work. That's all.",bc_map;
	set $@ep13_test,2;
	disablenpc "Head of the Alliance#moo";
	stopnpctimer;
	end;
}


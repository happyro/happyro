	}
	if (ep13_ryu == 19) {
		mes "[Officer A]";
		mes "你为什么来找我？";
		mes "发生什么事了？";
		next;
		mes "[Officer B]";
		mes "有什么事吗？";
		next;
		mes "[Officer A]";
		mes "我想不是。";
		mes "你是来告诉我你要出发执行任务。";
		mes "我说得对吗？";
		next;
		mes "[Officer B]";
		mes "你是席凯兹派来的……";
		mes "对吧？";
		next;
		mes "[Officer A]";
		mes "好，我收到你的报告了。";
		mes "回那里去吧。";
		mes "祝你好运。";
		next;
		mes "[Officer B]";
		mes "尽你所能吧";
		mes "……不管你要做什么……";
		next;
		changequest 10075,10076;
		set ep13_ryu,20;
		mes "[Officer A]";
		mes "回那里去吧。干得好。";
		close;
	}
	if (ep13_ryu == 18) {
		mes "[Officer A]";
		mes "席凯兹让人无法理解……";
		mes "我也无能为力……";
		next;
		mes "[Officer B]";
		mes "他所倡导的和平";
		mes "只是他自己的方式。";
		mes "三个王国为一个任务……";
		mes "没有和平……";
		mes "我们甚至得不到好处。";
		next;
		mes "[Officer A]";
		mes "我们不能让他们继续这样。虽然我是他们的首领，但我只是个傀儡。";
		next;
		mes "[Officer A]";
		mes "有什么办法改变他们吗？";
		next;
		mes "[Officer B]";
		mes "如果他们改变，";
		mes "我们就不会惹上麻烦。";
		mes "但他不愿妥协。";
		next;
		mes "[Officer A]";
		mes "那又怎样？";
		mes "我们得不到自己的利益，";
		mes "就这样什么也不为自己做吗？";
		next;
		mes "[Officer B]";
		mes "还有蒙肯罗。";
		next;
		mes "[Officer A]";
		mes "那又怎样……？";
		next;
		mes "[Officer B]";
		mes "像席凯兹一样诚实……";
		mes "像席凯兹一样灵活……";
		mes "但很容易越过他……";
		next;
		mes "[Officer B]";
		mes "我们不能排除他，";
		mes "所以就让蒙肯罗带头。这样更容易！";
		next;
		mes "[Officer A]";
		mes "哦！！";
		mes "好主意。";
		mes "总之……";
		mes "有访客来了。";
		mes "以后再谈吧。";
		next;
		changequest 10074,10075;
		set ep13_ryu,19;
		mes "[Officer B]";
		mes "嗯，你有什么事吗？";
		close;
	}
	mes "[Officer B]";
	mes "最重要的是金钱和权力。如果至少得不到一样，我们就和贫民窟里的穷人没区别。";
	close;
}

moc_fild20,349,179,3	script	Rift Guard#1	707,{
	if (ep13_ryu > 19) {
		mes "[Guard]";
		mes "啊，你是发现次元裂缝的联盟成员？欢迎。都准备好了。穿过裂缝后进入并找到营地即可。";

	if (KNIGHT_Q == 0) {
		mes "哦，你是";
		mes "剑士……？";
		mes "你是来转职成为";
		mes "骑士的吗？";
		next;
		mes "[艾米小姐]";
		mes "申请转职请去和";
		mes "那边的队长交谈。";
		mes "嘻嘻～";
		close;
	}
	else if (KNIGHT_Q >= 1 && KNIGHT_Q <= 7) {
		mes "嗯……？";
		mes "你为什么";
		mes "来找艾米？";
		next;
		if (select("我想参加转职测试。:哦，没什么。") == 1) {
			mes "[艾米小姐]";
			mes "嗯～";
			mes "你申请转职了！好！有这种决心，你很快就会成为骑士！";
			next;
			mes "[艾米小姐]";
			mes "但是……";
			mes "在和艾米交谈前，";
			mes "你必须先去见其他骑士。";
			next;
			mes "[艾米小姐]";
			mes "我很想从头测试你，";
			mes "但我不被允许这么做。";
			mes "嘻嘻～";
			close;
		}
		mes "[艾米小姐]";
		mes "哎呀～";
		mes "好吧……";
		close;
	}
	else if ((KNIGHT_Q == 8) || (KNIGHT_Q == 9)){
		if (KNIGHT_Q == 8) {
			mes "嗯……？";
			mes "你为什么";
			mes "来找艾米？";
			next;
			if (select("温莎先生让我来的——:哦，没什么。") == 1) {
				if(checkquest(9008) == -1) changequest 9007,9008;
				mes "[艾米小姐]";
				mes "哦！";
				mes "不用再说了。";
				mes "欢迎！现在是";
				mes "参加艾米测试的时间！";
				next;
				mes "[艾米小姐]";
				mes "我叫艾米·比阿特丽斯，";
				mes "是普隆德拉骑士团骄傲的女骑士。艾米的测试会考验你的骑士礼仪～";
				next;
				mes "[艾米小姐]";
				mes "我会讲一个故事，每当我提问时你选择答案。";
				mes "你的礼仪会根据答案来评判。";
				next;
				mes "[艾米小姐]";
				mes "所以仔细听，像真正的骑士一样回答，好吗？";
				next;
				mes "[艾米小姐]";
				mes "那么，开始吧！";
				next;
			}
			else {
				mes "[艾米小姐]";
				mes "哎呀……";
				mes "好吧～";
				close;
			}
		}
		else if (KNIGHT_Q == 9) {
			mes "嗯……？";
			mes "你为什么";
			mes "来找艾米？";
			next;
			if (select("我想参加转职测试。:哦，没什么。") == 1) {
				mes "[艾米小姐]";
				mes "嗯～？";
				mes "你学会上次";
				mes "做错的地方了吗？";
				mes "如果再失败，我会生气的！";
				next;
				mes "[艾米小姐]";
				mes "所以仔细听，";
				mes "像骑士一样回答。";
				mes "那么，开始吧！";
				next;
				mes "[艾米小姐]";
				mes "你是一名骑士，正在梦罗克寻找队伍。";
				mes "你会怎么做？";
				next;
			}
			else {
				mes "[艾米小姐]";
				mes "哎呀……";
				mes "好吧～";
				close;
			}
		}
		mes "你是一名骑士，正在梦罗克寻找队伍。";
		mes "你会怎么做？";
		next;
		if (select("大声喊自己在找队伍。:开设聊天室等待。:寻找需要骑士的人。") != 1)
			set .@knight_t,.@knight_t+10;
		mes "[艾米小姐]";
		mes "你和等级相近的玩家组成队伍，有牧师、巫师、猎人、刺客和铁匠……";
		next;
		mes "[艾米小姐]";
		mes "你们六人决定去狩猎，目的地是金字塔。";
		next;
		mes "[艾米小姐]";
		mes "你和队伍到达金字塔";
		mes "第四层。";
		mes "你该怎么做？";
		next;
		if (select("查看区域并提前规划。:为队友聚集怪物。:在前方慢慢带队。") != 2)
			set .@knight_t,.@knight_t+10;
		mes "[艾米小姐]";
		mes "但一些无礼的玩家带着一群怪物出现后消失了！你该怎么办？";
		next;
		if (select("阻止怪物接近队伍。:队伍撤退时进行防御。:骑着大嘴鸟逃跑。") != 3)
			set .@knight_t,.@knight_t+10;
		mes "[艾米小姐]";
		mes "幸运的是，你们都活过了危机。但途中发现一名非队伍成员倒在地上。";
		next;
		mes "[艾米小姐]";
		mes "那个人礼貌地请求帮助。你该怎么办？";
		next;
		if (select("请队伍中的牧师帮忙。:说你要收 Zeny 才帮忙。:无视并继续前进。") == 1)
			set .@knight_t,.@knight_t+10;
		mes "[艾米小姐]";
		mes "因为必须去别处，你要和队友告别。";
		next;
		mes "[艾米小姐]";
		mes "但你在战斗中发现";
		mes "一件稀有物品。";
		mes "你该怎么做？";
		next;
		if(select("交给最应该得到它的人。:假装什么也没发生并据为己有。:和队伍商量由谁获得。") != 2)
			set .@knight_t,.@knight_t+10;
		mes "[艾米小姐]";
		mes "你拿到物品后前往普隆德拉出售，那里有许多开店或聊天室卖东西的人。";
		next;
		mes "[艾米小姐]";
		mes "你该怎么出售物品？";
		next;
		if (select("向所有人大声喊话。:开聊天室等待。:询问是否有人感兴趣。") != 1)
			set .@knight_t,.@knight_t+10;
		mes "[艾米小姐]";
		mes "等待时，有人过来乞求物品和 Zeny。";
		mes "你会怎么做？";
		next;
		if (select("给他们一些 Zeny 和物品。:直接无视。:建议一个狩猎地点。") == 3)
			set .@knight_t,.@knight_t+10;
		mes "[艾米小姐]";
		mes "现在你决定独自前往隐秘神殿，开心地骑着大嘴鸟。";
		next;
		mes "[艾米小姐]";
		mes "但你遇到一个迷路的人。";
		mes "你该怎么做？";
		next;
		if(select("告诉对方如何到达出口。:带对方去出口。:给一张蝴蝶翅膀。") != 3)
			set .@knight_t,.@knight_t+10;
		mes "[艾米小姐]";
		mes "你狩猎了一阵子，现在 HP 很低！";
		mes "已经变红，非常危险。";
		next;
		mes "[艾米小姐]";
		mes "这时恰好有一名牧师经过。";
		mes "你会如何向牧师请求治疗？";
		next;
		if (select("可以请你治疗我吗？:能给我治疗吗？:治疗一下！！") == 1)
			set .@knight_t,.@knight_t+10;
		mes "[艾米小姐]";
		mes "你现在非常";
		mes "疲惫，是时候回城了。";
		next;
		mes "[艾米小姐]";
		mes "你在街上发现";
		mes "一件稀有物品。";
		mes "你该怎么做？";
		next;
		if (select("捡起来据为己有。:四处询问失主。:直接走过。") != 1)
			set .@knight_t,.@knight_t+10;
		mes "[艾米小姐]";
		mes "好了，";
		mes "我的测试";
		mes "结束了！";
		next;
		mes "[艾米小姐]";
		if (.@knight_t == 100) {
			set KNIGHT_Q,10;
			changequest 9008,9009;
		mes "做得好，骑士需要这样的心态！下一项测试请去找埃德蒙爵士～";
			next;
		mes "[艾米小姐]";
		mes "我会向队长称赞你。剩下的测试也要好好表现，好吗？";
			close;
		}
		else if (.@knight_t == 90) {
			set KNIGHT_Q,10;
			changequest 9008,9009;
		mes "虽然不完美，";
		mes "但我认为你的礼仪知识";
		mes "足以成为";
		mes "优秀的骑士。";
			next;
		mes "[艾米小姐]";
		mes "现在去找埃德蒙爵士参加下一项测试。剩下的测试也要好好表现，答应我～";
			close;
		}
		set KNIGHT_Q,9;
		mes "嗯……";
		mes "老实说，你的态度还不够成为骑士。";
		next;
		mes "[艾米小姐]";
		mes "如果你真是那样，大家会以为骑士都很无礼！想想你如何回答问题，之后再来。";
		next;
		mes "[艾米小姐]";
		mes "如果你愿意，";
		mes "我可以让你";
		mes "重新测试，好吗？";
		close;
	}
	else if (KNIGHT_Q == 10) {
		mes "嗯……？";
		mes "你为什么";
		mes "来找艾米？";
		next;
		mes "[艾米小姐]";
		mes "你必须去找";
		mes "埃德蒙爵士参加下一项测试，好吗？";
		close;
	}
	else if (KNIGHT_Q == 14) {
		mes "哇～";
		mes "现在该由大家";
		mes "决定你的转职了！";
		next;
		mes "[艾米小姐]";
		mes "去和我们的队长谈谈。";
		mes "别太担心，";
		mes "应该没问题。";
		close;
	}
	else {
		mes "嗯……？";
		mes "你为什么";
		mes "来找艾米？";
		next;
		mes "[艾米小姐]";
		mes "你还有";
		mes "其他测试要完成。";
		mes "快点完成吧～";
		close;
	}
}

// Test 4 (patience)
//==========================================================
prt_in,70,99,6	script	Sir Edmond#knt	734,{
	mes "[埃德蒙爵士]";
	if (BaseJob != Job_Swordman) {
		if (BaseJob == Job_Knight) {
			mes "把你的心思想象成";
			mes "流动的水。";
			next;
			mes "[Sir Edmond]";
		mes "流水会避开障碍，";
		mes "继续向前流淌……";
			next;
		mes "[埃德蒙爵士]";
		mes "骑士必须像平静的流水一样，";
		mes "能够在任何情况下";
		mes "渡过难关。";
			close;
		}
		else if (BaseClass == Job_Novice) {
		mes "根深的树木不会随风摇摆。强大的技能必须建立在扎实基础上，这是不变的真理……";
			next;
		mes "[埃德蒙爵士]";
		mes "你的未来";
		mes "甚至现在就能";
		mes "决定……";
			close;
		}
		else {
		mes "世界上的一切都和谐共存。不破坏这种和谐，才是正确的生活方式……";
			close;
		}
	}
	if (KNIGHT_Q == 0) {
		mes "只有心怀不祥想法的人才会做这样的梦。与其梦见悲伤和绝望，不如完全不做梦。";
		close;
	}
	else if (KNIGHT_Q >= 1 && KNIGHT_Q <= 9) {
		mes "这是什么……";
		mes "流浪剑士？";
		next;
		if (select("我想参加转职测试。:哦，没什么。") == 1) {
			mes "[埃德蒙爵士]";
			mes "种子必须先埋入泥土，";
			mes "才能发芽；嫩芽必须长出叶子，花蕾才能绽放……";
			next;
			mes "[埃德蒙爵士]";
			mes "否则……";
			mes "花朵就会";
			mes "不完整。";
			next;
			mes "[埃德蒙爵士]";
			mes "先去见其他人，";
			mes "这样才能找到你的道路……";
			close;
		}
		mes "[Sir Edmond]";
		mes "你想要的生活";
		mes "很快就会出现在眼前。";
		mes "一切都会";
		mes "井然有序。";
		close;
	}
	else if (KNIGHT_Q == 10) {
		mes "这是什么……";
		mes "流浪剑士。";
		next;
		if (select("艾米小姐派我来的。:哦，没什么。") == 1) {
			mes "[埃德蒙爵士]";
			mes "现在是参加我测试的时候。像之前的测试一样，请尽力而为。";
			next;
			mes "[埃德蒙爵士]";
			mes "我叫";
			mes "埃德蒙·格罗斯特。";
			mes "我是";
			mes "普隆德拉骑士团成员。";
			next;
			mes "[埃德蒙爵士]";
			mes "骑士处于被他人追随的位置。因此，你必须谦逊地思考世界秩序，并具备符合自身角色的品格。";
			next;
			mes "[埃德蒙爵士]";
			mes "不能轻率地做决定。需要时，意志应像芦苇一样柔韧，也应像岩石一样坚定。";
			next;
			mes "[埃德蒙爵士]";
			mes "不能无缘无故杀死怪物，也不能以此为乐。现在安静地独自思考这些……";
			next;
			mes "[埃德蒙爵士]";
			mes "那么，我们开始测试。";
			mes "请记住";
			mes "敬意的品质。";
			close2;
			set KNIGHT_Q,11;
			changequest 9009,9010;
			warp "job_knt",143,57;
			end;
		}
		mes "[埃德蒙爵士]";
		mes "你想要的生活";
		mes "很快就会出现在";
		mes "你眼前。";
		close;
	}
	else if (KNIGHT_Q == 11) {
		mes "这是什么……";
		mes "流浪剑士？";
		next;
		if (select("对不起，我不是故意的……:哦，没什么。") == 1) {
			mes "[埃德蒙爵士]";
			mes "你在上次测试中太粗心了。骑士之剑是为了保护他人，而不是折磨弱小怪物。";
			next;
			mes "[埃德蒙爵士]";
			mes "万物和谐共存的世界里，人类不能毫无目的地持续破坏。这条原则适用于现实世界，不只是测试。";
			next;
			mes "[埃德蒙爵士]";
			mes "测试";
			mes "现在开始。";
			mes "让我看看你的";
			mes "耐心……";
			close2;
			warp "job_knt",143,57;
			end;
		}
		mes "[埃德蒙爵士]";
		mes "你想要的生活";
		mes "很快就会出现在眼前。";
		mes "一切都会";
		mes "井然有序。";
		close;
	}
	else if (KNIGHT_Q == 12 || KNIGHT_Q == 13) {
		mes "我已经亲眼看到了你的品格。现在该进行最后一项测试了。去和";
		mes "格雷爵士谈谈……";
		close;
	}
	else {
		mes "去和我们的队长谈谈。";
		mes "现在是我们所有人";
		mes "评估你表现的时候了。";
		close;
	}
}

job_knt,1,1,1	script	Timer#knt	107,{
OnTimer300000:
	enablenpc "Warp#knt";
	end;

OnTimer300500:
	donpcevent "Timer#knt::OnDisable";
	disablenpc "Warp#knt";
	end;

OnTimer301500:
	stopnpctimer;
	donpcevent "Timer#knt::OnEnable";
	end;

OnInit:
OnEnable:
	enablenpc "Timer#knt";
	monster "job_knt",141,57,"Poring",1002,1,"Timer#knt::OnMyMobDead";
	monster "job_knt",145,57,"Poring",1002,1,"Timer#knt::OnMyMobDead";
	monster "job_knt",143,55,"Poring",1002,1,"Timer#knt::OnMyMobDead";
	monster "job_knt",143,59,"Poring",1002,1,"Timer#knt::OnMyMobDead";
	monster "job_knt",141,55,"Lunatic",1063,1,"Timer#knt::OnMyMobDead";
	monster "job_knt",141,59,"Lunatic",1063,1,"Timer#knt::OnMyMobDead";
	monster "job_knt",145,55,"Lunatic",1063,1,"Timer#knt::OnMyMobDead";
	monster "job_knt",145,59,"Lunatic",1063,1,"Timer#knt::OnMyMobDead";
	monster "job_knt",139,57,"Chonchon",1011,1,"Timer#knt::OnMyMobDead";
	monster "job_knt",147,57,"Chonchon",1011,1,"Timer#knt::OnMyMobDead";
	monster "job_knt",143,53,"Chonchon",1011,1,"Timer#knt::OnMyMobDead";
	monster "job_knt",143,61,"Chonchon",1011,1,"Timer#knt::OnMyMobDead";
	//These monsters were out of bounds. Adjusted to put them in bounds.
	monster "job_knt",165,54,"Mushroom",1182,1,"Timer#knt::OnMyMobDead";
	monster "job_knt",165,57,"Mushroom",1182,1,"Timer#knt::OnMyMobDead";
	monster "job_knt",122,54,"Mushroom",1182,1,"Timer#knt::OnMyMobDead";
	monster "job_knt",122,57,"Mushroom",1182,1,"Timer#knt::OnMyMobDead";
	initnpctimer;
	end;

OnDisable:
	killmonster "job_knt","Timer#knt::OnMyMobDead";
	disablenpc "Timer#knt";
	disablenpc "Warp#knt";
	end;

OnMyMobDead:
	warp "prt_fild05",353,251;
	end;
}


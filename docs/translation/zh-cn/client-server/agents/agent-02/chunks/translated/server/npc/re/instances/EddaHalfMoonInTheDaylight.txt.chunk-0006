1@pop3,45,66,3	script	Pope#3hmoon01	4_F_ARUNA_POP2,{
	if ('progress != 14)
		end;
	mes "[Pope]";
	mes "哥哥，就是这里吗……？";
	next;
	cutin "loo_nor", 0;
	mes "[Luwmin]";
	mes "现在没事了。我们安全了。";
	next;
	cutin "pops_nor", 2;
	mes "[Pope]";
	mes "我们一直谈论的梦之地？怎么会？";
	next;
	cutin "loo_nor", 0;
	mes "[Luwmin]";
	mes "我希望过，我一直希望。我想把梦想变成现实。";
	next;
	cutin "pops_nor", 2;
	mes "[Pope]";
	mes "我以为这只是存在于梦中的地方。";
	next;
	mes "[Pope]";
	mes "这座喷泉和我想象的一样。那棵树也是。还有……那个玩偶！";
	next;
	cutin "loo_smi", 0;
	mes "[Luwmin]";
	mes "如果我们躲在这里，就没人能找到我们。";
	next;
	cutin "pops_nor", 2;
	mes "[Pope]";
	mes "永远没人能找到我们吗？";
	npctalk "没人？", instance_npcname("Pope#3hmoon01");
	next;
	cutin "loo_smi", 0;
	mes "[Luwmin]";
	mes "是的，现在可以把那个冒险者送回去了。";
	npctalk "现在回去吧。", instance_npcname("Luwmin#3hmoon01");
	next;
	mes "[Luwmin]";
	mes "我们已经安全了，不再需要他们。";
	next;
	cutin "pops_sim", 2;
	mes "[Pope]";
	mes "冒险者？但是……";
	next;
	mes "[" + strcharinfo(0) + "]";
	mes "我会陪教皇直到最后。";
	unittalk getcharid(3), "我会陪教皇直到最后。";
	next;
	cutin "loo_ang", 0;
	mes "[Luwmin]";
	mes "你要保护她免受什么伤害？你来之前我们明明好好的！";
	next;
	mes "[Luwmin]";
	mes "你出现后，大祭司和守卫就来找我们……我们甚至还和父母分开了！！";
	next;
	mes "[Luwmin]";
	mes "你对我们来说是个危险！";
	npctalk "你对我们来说是个危险！", instance_npcname("Luwmin#3hmoon01");
	next;
	cutin "pops_sim", 2;
	mes "[Pope]";
	mes "哥哥，别这么说。冒险者一直是值得信赖的伙伴。";
	next;
	cutin "loo_ang", 0;
	mes "[Luwmin]";
	mes "真的吗？你是认真的吗？即使外面的所有人都背叛了我们？";
	next;
	cutin "pops_smi", 2;
	mes "[Pope]";
	mes "是的。我相信冒险者。";
	next;
	cutin "loo_smi", 0;
	mes "[Luwmin]";
	mes "我以为这里是只属于我们两个人的地方……现在却这样？";
	next;
	cutin "loo_ang", 0;
	mes "[Luwmin]";
	mes "你觉得这个冒险者能比我更好地保护你吗？";
	next;
	cutin "pops_sim", 2;
	mes "[Pope]";
	mes "但是……";
	npctalk "但是……", instance_npcname("Pope#3hmoon01");
	next;
	cutin "loo_smi", 0;
	mes "[Luwmin]";
	mes "我们会永远藏在这里。摆脱牧师、守卫……甚至妈妈和爸爸。";
	next;
	cutin "pops_sim", 2;
	mes "[Pope]";
	mes "……没人能找到我们！我愿意用生命保证……！";
	npctalk "永远……没人会找到……", instance_npcname("Pope#3hmoon01");
	next;
	mes "[" + strcharinfo(0) + "]";
	mes "教皇！你不能永远待在这里，最终必须醒来！";
	next;
	cutin "pops_nor", 2;
	mes "[Pope]";
	mes "梦……？";
	npctalk "梦……？", instance_npcname("Pope#3hmoon01");
	next;
	mes "[" + strcharinfo(0) + "]";
	mes "现实中有许多人在等待你的出现。这只是一个梦，未必反映过去发生的事情。";
	next;
	cutin "loo_ang", 0;
	mes "[Luwmin]";
	mes "别听他的！全都是谎言！";
	npctalk "别听他的！全都是谎言！", instance_npcname("Luwmin#3hmoon01");
	next;
	cutin "pops_sim", 2;
	mes "[Pope]";
	mes "这是梦……？";
	npctalk "这是梦……？", instance_npcname("Pope#3hmoon01");
	next;
	mes "[" + strcharinfo(0) + "]";
	mes "是的，没错。这只是一个梦，是你和Luwmin所有焦虑的体现。你看到的一切并不都是真实的。";
	next;
	cutin "loo_ang", 0;
	mes "[Luwmin]";
	mes "谎言！全都是谎言！！";
	next;
	cutin "pops_sim", 2;
	mes "[Pope]";
	mes "我在黑暗中失去了Tilibi，然后……遇到了冒险者。";
	next;
	cutin "pops_sim", 255;
	mes "[" + strcharinfo(0) + "]";
	mes "你的焦虑在这个梦里被严重扭曲了。";
	next;
	cutin "loo_ang", 0;
	mes "[Luwmin]";
	mes "别听那些。连想都不要想！";
	next;
	cutin "pops_sim", 2;
	mes "[Pope]";
	mes "妈妈和爸爸抛弃了我……";
	next;
	cutin "pops_sim", 255;
	mes "[" + strcharinfo(0) + "]";
	mes "那些人不是你的亲生父母……";
	next;
	cutin "pops_sim", 2;
	mes "[Pope]";
	mes "我……我需要回那里……";
	next;
	cutin "loo_smi", 0;
	mes "[Luwmin]";
	mes "你想回去？你可以不受他人干扰，永远待在这里。你说过外面的生活……令人窒息。";
	next;
	cutin "pops_smi", 2;
	mes "[Pope]";
	mes "我能承受，哥哥。我能承受。";
	npctalk "一起走。", instance_npcname("Pope#3hmoon01");
	next;
	mes "[" + strcharinfo(0) + "]";
	mes "别这样。Luwmin被冻住了，无法移动。";
	next;
	cutin "pops_sim", 2;
	mes "[Pope]";
	mes "他被冻住了？";
	npctalk "他被冻住了？", instance_npcname("Pope#3hmoon01");
	next;
	mes "[" + strcharinfo(0) + "]";
	mes "来这里之前，Niren告诉过我。";
	next;
	mes "[" + strcharinfo(0) + "]";
	mes "教皇的双胞胎弟弟Luwmin被封印在冰洞深处。";
	next;
	cutin "loo_ang", 0;
	mes "[Luwmin]";
	mes "你知道什么……！人类骨子里都是邪恶的！我们从来没有选择！";
	next;
	mes "[Luwmin]";
	mes "仅仅因为我们生来就是这个模样，就被抓进了神殿。我正是因此被囚禁在冰中！";
	next;
	mes "[Luwmin]";
	mes "我们甚至没有得到合理的解释！";
	next;
	mes "[Luwmin]";
	mes "我为什么一出生就要面对这样的命运……";
	next;
	cutin "pops_sim", 2;
	mes "[Pope]";
	mes "被封印？我的弟弟……被封印？";
	next;
	cutin "loo_smi", 0;
	mes "[Luwmin]";
	mes "现在已经不重要了。从今以后我们会永远在一起。";
	npctalk "我们永远在一起。", instance_npcname("Luwmin#3hmoon01");
	next;
	cutin "pops_sim", 2;
	mes "[Pope]";
	mes "那是很久以前的事了……";
	npctalk "那是很久以前的事了……", instance_npcname("Pope#3hmoon01");
	next;
	mes "[Pope]";
	mes "我的弟弟突然消失了。";
	npctalk "我的弟弟突然消失了。", instance_npcname("Pope#3hmoon01");
	next;
	mes "[Pope]";
	mes "封印……冰洞……现在很冷。";
	npctalk "现在很冷。", instance_npcname("Pope#3hmoon01");
	next;
	mes "[Pope]";
	mes "哥哥，你现在梦见什么？";
	npctalk "哥哥，你现在梦见什么？", instance_npcname("Pope#3hmoon01");
	next;
	mes "[Pope]";
	mes "所以弟弟才想和我分享一个梦吗？";
	npctalk "所以弟弟才想和我分享一个梦吗？", instance_npcname("Pope#3hmoon01");
	next;
	mes "[Pope]";
	mes "你想梦见什么？";
	npctalk "你想梦见什么？", instance_npcname("Pope#3hmoon01");
	next;
	cutin "loo_smi", 0;
	mes "[Luwmin]";
	mes "像以前一样在一起。";
	npctalk "像以前一样在一起。", instance_npcname("Luwmin#3hmoon01");
	next;
	mes "[Luwmin]";
	mes "就在这里。";
	npctalk "就在这里。", instance_npcname("Luwmin#3hmoon01");
	next;
	mes "[Luwmin]";
	mes "永远。";
	npctalk "永远。", instance_npcname("Luwmin#3hmoon01");
	next;
	mes "[" + strcharinfo(0) + "]";
	mes "这不对。";
	next;
	cutin "loo_ang", 0;
	mes "[Luwmin]";
	mes "你敢插手试试！";
	specialeffect2 EF_FROSTDIVER2;
	next;
	mes "[Luwmin]";
	mes "烦人的冒险者马上就要消失了！！！！";
	npctalk "烦人的冒险者马上就要消失了！！！！", instance_npcname("Luwmin#3hmoon01");
	cutin "loo_ang", 255;
	specialeffect2 EF_ICEWALL;
	unittalk getcharid(3), "?? ....";
	sleep2 1000;
	cutin "loo_ang", 0;
	next;
	mes "[Luwmin]";
	mes "消失吧！";
	next;
	cutin "loo_ang", 255;
	mes "[Pope]";
	mes "弟弟……？";
	npctalk "弟弟……？", instance_npcname("Pope#3hmoon01");
	next;
	mes "[" + strcharinfo(0) + "]";
	mes "教皇，很危险！";
	mes "到我身边来……！！！";
	disablenpc instance_npcname("Luwmin#3hmoon01");
	disablenpc instance_npcname("Pope#3hmoon01");
	if ('mode == 1)
		mercenary_create 3569,1800000; //POPE_MD_H_MERC_NORMAL
	else
		mercenary_create 3570,1800000; //POPE_MD_H_MERC_CASUAL
	instance_announce 0, "似乎有一股令人战栗的气息……", bc_map, "0xFFFF00";
	if ('progress == 14) {
		'progress = 15;
		donpcevent instance_npcname("#mob3hmoon") + "::OnStart";
	}
	close3;
}


1@pop3,54,69,6	script(DISABLED)	Ktullanux#3hmoon01	1779,5,5,{
	if ('progress != 16)
		end;
	mes "[?????]";
	mes "只是个渺小的人类。";
	next;
	cutin "pops_sim", 2;
	mes "[Pope]";
	mes "你是谁？";
	next;
	cutin "pops_sim", 255;
	mes "[Ktullanux]";
	mes "这里是冰洞的主人。";
	npctalk "你认不出我吗？", instance_npcname("Ktullanux#3hmoon01");
	sleep2 1000;
	unittalk getcharid(3), "Who knows?";
	next;
	mes "[" + strcharinfo(0) + "]";
	mes "冰洞的主人？这不是教皇和Luwmin的梦吗？";
	next;
	mes "[Ktullanux]";
	mes "兄弟姐妹只要意志坚定，就能分享同一个梦。";
	npctalk "兄弟姐妹只要意志坚定，就能分享同一个梦。", instance_npcname("Ktullanux#3hmoon01");
	next;
	mes "[Ktullanux]";
	mes "一个成为教皇的孩子，以及被封印的双胞胎弟弟Luwmin？";
	next;
	cutin "pops_sim", 2;
	mes "[Pope]";
	mes "我的弟弟为什么……";
	npctalk "为什么……", instance_npcname("Pope#3hmoon04");
	next;
	cutin "pops_sim", 255;
	mes "[Ktullanux]";
	mes "为什么？你问为什么？";
	next;
	mes "[Ktullanux]";
	mes "弟弟Luwmin被强行推入洞穴深处，最后被冻住了。";
	npctalk "......", instance_npcname("Pope#3hmoon04");
	next;
	mes "[Ktullanux]";
	mes "携带奥丁之火的人类威胁我，要我让这个孩子永远冻在这里……";
	next;
	mes "[Ktullanux]";
	mes "我对人类仍然保留些许怜悯。";
	next;
	mes "[Ktullanux]";
	mes "所以我探查了Luwmin的意识。";
	next;
	mes "[Ktullanux]";
	mes "我看到了当时发生的一切……";
	next;
	mes "[Ktullanux]";
	mes "那些记忆主要与他的双胞胎姐姐有关。";
	next;
	mes "[Ktullanux]";
	mes "记得你曾和弟弟一起玩耍，在床上聊天，一起哭，一起笑。";
	npctalk "那是珍贵的回忆。", instance_npcname("Ktullanux#3hmoon01");
	next;
	cutin "pops_sim", 2;
	mes "[Pope]";
	mes "弟弟……";
	next;
	cutin "pops_sim", 255;
	mes "[Ktullanux]";
	mes "我决定帮助Luwmin。这是帮助他的办法。";
	next;
	mes "[Ktullanux]";
	mes "我们找到了获得解放的方法，而且并不困难。";
	next;
	mes "[Ktullanux]";
	mes "Luwmin拥有和姐姐分享梦境的力量。";
	next;
	mes "[Ktullanux]";
	mes "让坐在教皇王座上的姐姐永远困在梦中。";
	next;
	mes "[" + strcharinfo(0) + "]";
	mes "这怎么帮助了你？";
	next;
	mes "[Ktullanux]";
	mes "那些威胁教皇、让我陷入永恒沉睡的人现在一定很担心。我们有共同的敌人。";
	next;
	mes "[Ktullanux]";
	mes "他们的首领陷入沉睡……深深的沉睡，一定让他们很不安。";
	next;
	cutin "pops_sim", 2;
	mes "[Pope]";
	mes "所以你可以和Luwmin分享这份复仇？";
	next;

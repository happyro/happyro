	}
	mes .@npc_name$;
	mes "我是尤里卡，朱诺魔物协会的助手。";
	mes "我能为你做什么？";
	next;
	if (select( "前往地图调查员所在地。", "听取朱诺魔物协会的工作介绍。" ) == 2) {
		mes .@npc_name$;
		mes "最近，一些当地魔物变得异常凶猛，或者数量增加。";
		mes "所以我们来到朱诺魔物协会协调处理。";
		next;
		mes .@npc_name$;
		mes "朱诺魔物协会是一个以朱诺为基地的魔物研究机构。";
		mes "我们正在派遣地图调查员前往各地制服魔物。";
		next;
		mes .@npc_name$;
		mes "怎么样？感兴趣吗？";
		mes "我负责宣传朱诺魔物协会的工作，管理" + .@item_name$ + "自动售货机，并带你前往地图调查员所在的地点。";
		close;
	}
	mes .@npc_name$;
	mes "直接送你过去有点困难，但我又拿不到钱……";
	mes "好吧，你能给我一杯" + .@item_name$ + "吗？我马上送你过去。";
	next;
	if (select( "给我一瓶" + .@item_name$ + ".", "我拒绝。" ) == 2) {
		mes .@npc_name$;
		mes "你不走吗？";
		close;
	}
	if (countitem(1000374) < 1) {
		mes .@npc_name$;
		mes "我负责管理" + .@item_name$ + " 自动售货机。";
		mes "你可以使用我旁边的碳酸水自动售货机，想买多少都行。";
		close;
	}
	mes .@npc_name$;
	mes "啊，清爽、冰凉，真不错。";
	mes "现在要送你去哪里？";
	callfunc( "F_Brilliant_Soda" );
	mes .@npc_name$;
	mes "你不走吗？ Then, the " + .@item_name$ + "... 给，我把它还给你。";
	close;

OnInit:
	setunittitle getnpcid(0), "<Juno Monster Society>";
	end;
}

lighthalzen,171,106,5	script	Assistant Staff#lig	4_M_CRU_HEAD,{
	.@npc_name$ = "[" + strnpcinfo(1) + "]";
	.@item_name$ = getitemname(1000374);

	if (isbegin_quest(16547) == 0) {
		mes .@npc_name$;
		mes "想参加朱诺魔物协会举办的魔物讨伐活动吗？";
		mes "我们会直接带你前往想去的地点！";
		next;
		mes .@npc_name$;
		mes "我是斯塔夫，朱诺魔物协会的助理主管。";
		mes "我来向你宣传魔物讨伐活动。";
		next;
		select( "魔物讨伐？", "朱诺魔物协会？" );	// note: same text
		mes .@npc_name$;
		mes "朱诺魔物协会是一个以朱诺为基地、研究魔物的协会。";
		mes "最近，一些当地魔物变得异常凶猛，或者数量增加。";
		next;
		mes .@npc_name$;
		mes "所以我们派遣地图调查员前往各地制服魔物。";
		next;
		mes .@npc_name$;
		mes "我的任务是协助地图调查员在城内宣传魔物协会，并管理" + .@item_name$ + "自动售货机。";
		mes "是的，我可以带你去调查员所在地";
		setquest 16547;
		completequest 16547;
		next;
	}
	mes .@npc_name$;
	mes "我是魔物协会的助理斯塔夫！！！";
	mes "需要我的帮助吗！！！";
	next;
	if (select( "前往地图调查员所在地。", "听取朱诺魔物协会的工作介绍。" ) == 2) {
		mes .@npc_name$;
		mes "朱诺魔物协会就是研究魔物的协会！！！";
		mes "……总部在朱诺。";
		next;
		mes "最近，一些当地魔物变得异常凶猛，或者数量增加了！！！";
		mes "所以派往各地的地图调查员会给冒险者发布制服魔物的任务！！！";
		next;
		mes .@npc_name$;
		mes "我是你的助手斯塔夫！！";
		next;
		mes .@npc_name$;
		mes "在城内宣传魔物协会，召集冒险者……";
		mes "并把前来的冒险者传送到地图调查员所在地！！！";
		close;
	}
	mes .@npc_name$;
	mes "好！！！价格是一瓶" + .@item_name$ + "！！！";
	mes "你不会以为我会免费传送你吧！！！";
	next;
	if (select( "给我一瓶" + .@item_name$ + ".", "我拒绝。" ) == 2) {
		mes .@npc_name$;
		mes "什么……？我不去讨伐！！！";
		close;
	}
	if (countitem(1000374) < 1) {
		mes .@npc_name$;
		mes "如果你需要" + .@item_name$ + ", face this vending machine that I manage！！！";
		mes "付出代价，赢得奖励！！！";
		close;
	}
	mes .@npc_name$;
	mes "你的" + .@item_name$ + ", I gladly received it！！！";
	mes "现在你想去哪里进行魔物讨伐！！！";
	callfunc( "F_Brilliant_Soda" );
	mes .@npc_name$;
	mes "什么……？我不去讨伐！！！";
	mes "别自相矛盾！！！……我把" + .@item_name$ + ".";
	close;

OnInit:
	setunittitle getnpcid(0), "<Juno Monster Society>";
	end;
}


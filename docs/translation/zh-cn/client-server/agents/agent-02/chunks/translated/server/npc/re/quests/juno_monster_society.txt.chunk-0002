ein_fild06,257,351,4	script	Map Examiner Bast#yma	4_F_CHNDRESS1,{
	.@npc_name$ = "[" + strnpcinfo(1) + "]";
	.@item_name$ = getitemname(1000374);

	if (BaseLevel < 70) {
		mes .@npc_name$;
		mes "朱诺魔物协会正在进行讨伐任务，但你看起来还不够强，无法执行任务。";
		close;
	}
	switch( checkquest(5917,PLAYTIME) ) {
	case -1:
		break;
	case 0:
	case 1:
		mes .@npc_name$;
		mes "BNP工作过度很累，请明天再来。讨伐任务每天只能进行一次。";
		next;
		switch( select( "你看起来很累。要喝点东西吗？", "传送到附近城镇。" ) ) {
		case 1:
			if (countitem(1000374) < 3) {
				mes .@npc_name$;
				mes "在哪里能找到" + .@item_name$ + "？嗯——很好。我本来想要三瓶左右。";
				close;
			}
			delitem 1000374,3;	// Brilliant_Soda
			erasequest 5917;
			mes .@npc_name$;
			mes "谢谢。我刚才很累，但现在好多了。";
			next;
			npctalk "咕噜咕噜——", "", bc_self;
			sleep2 500;
			specialeffect EF_FLASHER;
			mes .@npc_name$;
			mes "咦？我一定是睡着了。刚才告诉你讨伐任务了吗？等我清醒一点后再和我说话好吗？";
			close;
		case 2:
			mes .@npc_name$;
			mes "我可以把你送到艾因布洛克吗？给我一瓶" + mesitemlink( 1000374 ) + "，我就能传送你。";
			next;
			select( "给我1瓶" + .@item_name$ + "." );
			if (countitem(1000374) < 1) {
				mes .@npc_name$;
				mes "你没有" + .@item_name$ + "，但朱诺魔物协会为什么让你拿这个？这只是一杯饮料。";
				close;
			}
			mes .@npc_name$;
			mes "拜拜～下次见。";
			close2;
			delitem 1000374,1;	// Brilliant_Soda
			warp "einbroch",239,197;
			end;
		}
		end;
	case 2:
		erasequest 5917;
		mes .@npc_name$;
		mes "你可以再次执行讨伐任务。";
		close;
	}
	switch( checkquest(5916,HUNTING) ) {
	case -1:
		mes .@npc_name$;
		mes "你好～冒险者～我是朱诺魔物协会的INPU。";
		next;
		switch( select( "领取讨伐任务。", "讨伐任务？", "传送到附近城镇。", "问候。" ) ) {
		case 1:
			setquest 5916;
			mes .@npc_name$;
			mes "哇！真的吗？任务很简单，就是在艾因布洛克原野猎杀80只魔物。";
			next;
			mes .@npc_name$;
			mes "你是冒险者的话，应该能轻松完成后回来吧？我很期待。";
			close;
		case 2:
			mes .@npc_name$;
			mes "最近，我们发现魔物聚落正在扩大。";
			next;
			mes .@npc_name$;
			mes "我认为是魔物数量增加了，也可能是因为我没有像过去那样积极讨伐。";
			next;
			mes .@npc_name$;
			mes "为了防止魔物聚落进一步扩大，朱诺魔物协会计划进行大规模讨伐。";
			next;
			mes .@npc_name$;
			mes "数量增加的聚落一旦发生冲突，可能会伤害附近居民。";
			close;
		case 3:
			mes .@npc_name$;
			mes "我可以把你送到艾因布洛克吗？给我一瓶" + mesitemlink( 1000374 ) + "，我就能传送你。";
			next;
			select( "给我1瓶" + .@item_name$ + "." );
			if (countitem(1000374) < 1) {
				mes .@npc_name$;
				mes "你没有" + .@item_name$ + "，但朱诺魔物协会为什么让你拿这个？这只是一杯饮料。";
				close;
			}
			mes .@npc_name$;
			mes "拜拜～下次见。";
			close2;
			delitem 1000374,1;	// Brilliant_Soda
			warp "einbroch",239,197;
			end;
		case 4:
			mes .@npc_name$;
			mes "初次见面。接受讨伐任务会不会让你更愉快？";
			close;
		}
		end;
	case 0:
	case 1:
		mes .@npc_name$;
		mes "你只要在艾因布洛克原野猎杀80只魔物。全部完成后回来领取奖励。";
		close;
	case 2:
		getexp 121320,110520;
		erasequest 5916;
		setquest 5917;
		mes .@npc_name$;
		mes "谢谢，你辛苦了。";
		mes "最近大家批评我表现不好。这里荒凉又疲惫，很难熬。";
		next;
		mes .@npc_name$;
		mes "抱歉。非常感谢，我只是抱怨一下。如果你明天也来帮忙，我会加倍感激，请多关照。";
		close;
	}
	end;

OnInit:
	setunittitle getnpcid(0), "<Juno Monster Society>";

	questinfo( QTYPE_CLICKME, QMARK_YELLOW, "(checkquest(5917,PLAYTIME) == 0 || checkquest(5917,PLAYTIME) == 1) && countitem(1000374) > 2" );
	questinfo( QTYPE_DAILYQUEST, QMARK_YELLOW, "BaseLevel >= 70 && checkquest(5916,HUNTING) == -1 && checkquest(5917,PLAYTIME) == -1" );
	questinfo( QTYPE_QUEST2, QMARK_YELLOW, "checkquest(5916,HUNTING) == 2" );
	questinfo( QTYPE_DAILYQUEST, QMARK_YELLOW, "checkquest(5917,PLAYTIME) == 2" );
	end;
}

gef_fild06,209,31,6	script	Map Examiner Gefil#yma	4_M_MIDDLE,{
	.@npc_name$ = "[" + strnpcinfo(1) + "]";
	.@item_name$ = getitemname(1000374);

	if (BaseLevel < 71) {
		mes .@npc_name$;
		mes "朱诺魔物协会正在进行讨伐任务，但你看起来还不够强，无法执行任务。";
		close;
	}
	switch( checkquest(5921,PLAYTIME) ) {
	case -1:
		break;
	case 0:
	case 1:
		mes .@npc_name$;
		mes "明天可以再次执行讨伐任务。你一定累了，回城休息吧。";
		next;
		switch( select( "你看起来很累。要喝点东西吗？", "传送到附近城镇。" ) ) {
		case 1:
			if (countitem(1000374) < 3) {
				mes .@npc_name$;
				mes "你没有" + .@item_name$ + "。只有三瓶。";
				close;
			}
			delitem 1000374,3;	// Brilliant_Soda
			erasequest 5921;
			mes .@npc_name$;
			mes "啊！这就是" + .@item_name$ + "最近很流行的饮料吗？我会好好喝的。";
			next;
			npctalk "咕噜咕噜——", "", bc_self;
			specialeffect EF_FLASHER;
			mes .@npc_name$;
			mes "咦？！你在哪里？啊！你睡着了吗？有客人来了。";
			close;
		case 2:
			mes .@npc_name$;
			mes "给我1瓶" + mesitemlink( 1000374 ) + "，我就能把你传送到吉芬。";
			next;
			select( "给我1瓶" + .@item_name$ + "." );
			if (countitem(1000374) < 1) {
				mes .@npc_name$;
				mes "你没有" + .@item_name$ + ". 这只是一杯饮料。";
				close;
			}
			mes .@npc_name$;
			mes "下次见。旅途愉快……";
			close2;
			delitem 1000374,1;	// Brilliant_Soda
			warp "geffen",119,37;
			end;
		}
	case 2:
		erasequest 5921;
		mes .@npc_name$;
		mes "你可以再次执行讨伐任务。";
		close;
	}
	switch( checkquest(5920,HUNTING) ) {
	case -1:
		mes .@npc_name$;
		mes "朱诺魔物协会正在寻找愿意接受讨伐任务的人。";
		next;
		switch( select( "领取讨伐任务。", "讨伐任务？", "传送到附近城镇。", "你似乎负担得起？" ) ) {
		case 1:
			setquest 5920;
			mes .@npc_name$;
			mes "谢谢。你只需在吉芬原野猎杀80只魔物。全部完成后请回来向我报告。";
			close;
		case 2:
			mes .@npc_name$;
			mes "最近魔物数量正在增加。";
			next;
			mes .@npc_name$;
			mes "随着魔物增加，聚落会扩大；如果魔物为争夺力量发生冲突，人类就能避开它们。";
			next;
			mes .@npc_name$;
			mes "这是提前预防。";
			close;
		case 3:
			mes .@npc_name$;
			mes "给我1瓶" + mesitemlink( 1000374 ) + "，我就能把你传送到吉芬。";
			next;
			select( "给我1瓶" + .@item_name$ + "." );
			if (countitem(1000374) < 1) {
				mes .@npc_name$;
				mes "你没有" + .@item_name$ + ". 这只是一杯饮料。";
				close;
			}
			mes .@npc_name$;
			mes "下次见。旅途愉快……";
			close2;
			delitem 1000374,1;	// Brilliant_Soda
			warp "geffen",119,37;
			end;
		case 4:
			mes .@npc_name$;
			mes "啊！你看到了吗？你总是一副疲惫的样子。也许是因为你放下一切、接受了疲惫？我到底在说什么？";
			next;
			mes .@npc_name$;
			mes "我累了，所以什么都说。";
			close;
		}
		end;
	case 0:
	case 1:
		mes .@npc_name$;
		mes "在吉芬原野猎杀80只魔物，然后回来向我报告。";
		close;
	case 2:
		getexp 64133,57253;
		erasequest 5920;
		setquest 5921;
		mes .@npc_name$;
		mes "你辛苦了。我又能暂时放心了，也可以休息。讨伐任务明天会再次开放，有时间请再来。";
		close;
	}
	end;

OnInit:
	setunittitle getnpcid(0), "<Juno Monster Society>";

	questinfo( QTYPE_CLICKME, QMARK_YELLOW, "(checkquest(5921,PLAYTIME) == 0 || checkquest(5921,PLAYTIME) == 1) && countitem(1000374) > 2" );
	questinfo( QTYPE_DAILYQUEST, QMARK_YELLOW, "BaseLevel >= 71 && checkquest(5920,HUNTING) == -1 && checkquest(5921,PLAYTIME) == -1" );
	questinfo( QTYPE_QUEST2, QMARK_YELLOW, "checkquest(5920,HUNTING) == 2" );
	questinfo( QTYPE_DAILYQUEST, QMARK_YELLOW, "checkquest(5921,PLAYTIME) == 2" );
	end;
}


	.@npc_name$ = "[" + strnpcinfo(1) + "]";
	.@item_name$ = getitemname(1000374);

	if (BaseLevel < 71) {
		mes .@npc_name$;
		mes "朱诺魔物协会正在进行讨伐任务，但你看起来还不够强，无法执行任务。";
		close;
	}
	switch( checkquest(5919,PLAYTIME) ) {
	case -1:
		break;
	case 0:
	case 1:
		mes .@npc_name$;
		mes "明天可以再次执行利赫泰伦原野讨伐任务。你一定累了，进去休息吧。我也有点累。";

		set ch_poison,14;
		getitem 678,3; //Poison_Bottle
		next;
		mes "[Song Zhi Du]";
		mes "请立即服下药丸。";
		next;
		mes "^3355FF你吞下了一颗闪耀金色光芒的奇怪药丸。味道很苦……^000000";
		next;
		mes "^3355FF难闻的味道在口中久久不散，但随后一股暖流流遍全身。最终你失去了意识。^000000";
		next;
		if (checkre(3)) {
			if (BaseLevel < 56) getexp 500,0;
			else if (BaseLevel > 55 && BaseLevel < 61) getexp 700,0;
			else if (BaseLevel > 60 && BaseLevel < 66) getexp 850,0;
			else if (BaseLevel > 65 && BaseLevel < 71) getexp 1270,0;
			else if (BaseLevel > 70 && BaseLevel < 76) getexp 1600,0;
			else if (BaseLevel > 75 && BaseLevel < 81) getexp 2100,0;
			else if (BaseLevel > 80 && BaseLevel < 86) getexp 4000,0;
			else if (BaseLevel > 85 && BaseLevel < 91) getexp 7000,0;
			else getexp 11000,0;
		} else {
			if (BaseLevel < 56) getexp 8909,0;
			else if (BaseLevel > 55 && BaseLevel < 61) getexp 10213,0;
			else if (BaseLevel > 60 && BaseLevel < 66) getexp 17684,0;
			else if (BaseLevel > 65 && BaseLevel < 71) getexp 25411,0;
			else if (BaseLevel > 70 && BaseLevel < 76) getexp 68757,0;
			else if (BaseLevel > 75 && BaseLevel < 81) getexp 128246,0;
			else if (BaseLevel > 80 && BaseLevel < 86) getexp 142340,0;
			else if (BaseLevel > 85 && BaseLevel < 91) getexp 152052,0;
			else getexp 366786,0;
		}
		warp "louyang",270,136;
		end;
	}
	else if (ch_par > 9 && ch_poison == 14) {
		mes "[Song Zhi Du]";
		mes "......................";
		next;
		mes "^3355FFSong Zhi Du 茫然望着天花板。复仇之后，他似乎失去了生活的动力。帮助他究竟是正确的吗？^000000";
		next;
		mes "^3355FF据说毒饮料效果不佳，因为外国来的小偷偷走了瓶子。^000000";
		close;
	}
	else if (ch_par > 9 && ch_poison == 15 && ch_poison < 20) {
		mes "[Song Zhi Du]";
		mes "发生了什么？白龙大人为什么还没死？！";
		next;
		mes "[Song Zhi Du]";
		mes "嗯……你没有另一个计划吧？";
		close;
	}
	else if (ch_par > 9 && ch_poison == 20) {
		mes "[Song Zhi Du]";
		mes "啊……欢迎。我的师父把一切都告诉我了。";
		next;
		mes "[Song Zhi Du]";
		mes "不知为何，我既感到释然又感到抱歉。不过现在我可以忘记过去发生的一切了。";
		next;
		mes "[Song Zhi Du]";
		mes "现在我决定专心学习医术，尽可能拯救更多生命。很抱歉之前对你如此无礼。";
		next;
		mes "[Song Zhi Du]";
		mes "另外，请收下这些，我已经不再需要了。";
		set ch_poison,21;
		completequest 11083;
		getitem 678,5; //Poison_Bottle
		next;
		mes "[Song Zhi Du]";
		mes "再次感谢你，朋友。现在请容我告辞，我还有很多事要做……";
		close;
	}
	else if (ch_poison > 20) {
	mes "^3355FFSong Zhi Du 正忙着整理药草，脸上曾有的淡淡悲伤似乎已经消失。^000000";
		next;
	mes "^3355FF从他的动作和工作节奏来看，你能感受到他热爱所做之事。Song Zhi Du 似乎终于找到了人生道路。^000000";
		close;
	}
	mes "[Song Zhi Du]";
	mes "Nagash Arses 也是 Arcturus 传说中毒王的名字。我的师父确实有理由为这个名字自豪！";
	close;
}

lou_fild01,224,348,0	script	Lady#delivery	817,{
	if (checkweight(1201,1) == 0) {
		mes "^3355FF * Wait a minute! *";
		mes "你现在携带的物品太多。请将一些物品存入卡普拉仓库后再试。^000000";
		close;
	}
	if (ch_poison < 8) {
		if (rand(1,10) > 5) {
			mes "[Lady]";
			mes "你来到了洛阳入口。希望你在这里过得愉快~";
			emotion ET_CHUP;
			close;
		}
		mes "[Lady]";
		mes "你来到了洛阳入口。";
		next;
		mes "[Lady]";
		mes "洛阳以各种烟花爆竹闻名。想看一个吗？";
		next;
		if (select("好啊！:不用了~") == 1) {
			mes "[Lady]";
			mes "好，给你！";
			if (Zeny > 99) {
				set Zeny, Zeny-100;
			}
			close2;
			specialeffect EF_BLASTMINEBOMB,AREA," #fire";
			end;
		}
		mes "[Lady]";
		mes "哼……！";
		emotion ET_THINK;
		close;
	}
	else if (ch_poison == 8) {
		mes "[Lady]";
		mes "想看烟花爆竹吗？";
		next;
		if (select("好啊！:不用了~") == 1) {
			mes "[Lady]";
			mes "好，给你！";
			if (Zeny > 99) {
				set Zeny, Zeny-100;
			}
			close2;
			donpcevent " #fire::OnClaymore";
			end;
		}
		mes "[Lady]";
		mes "嗯，如果不是烟花爆竹，那你一定想要别的东西。有人派你来吗？";
		next;
		if (select("是的。:不是。") == 1) {
			mes "[Lady]";
			mes "是谁？请告诉我他的名字。";
			next;
			input .@input$;
			if (.@input$ == "Song Zhi Du") {
				mes "[Lady]";
				mes "哦，我明白了。让我把包裹给你。";
				next;
				mes "[Lady]";
				mes "啊，等等！我忘了！你必须先支付 1,000 Zeny 的配送费。";
				next;
				if (Zeny > 999) {
					set Zeny, Zeny-1000;
					getitem 7126,1; //Large_Jellopy
					mes "[Lady]";
				mes "谢谢~费用已支付，请把这个带给 Song Zhi Du。保重！";
					set ch_poison,9;
					changequest 11073,11074;
					close;
				}
				mes "[Lady]";
				mes "呃……你没有足够的 Zeny 支付费用。除非付清配送费，否则不能给你包裹！";
				emotion ET_FRET;
				close;
			}
			mes "[Lady]";
			mes "嗯？我不知道那是谁。所以我肯定没有你说的人的包裹。";
			close;
		}
		mes "[Lady]";
		mes "不是……？";
		next;
		mes "[Lady]";
		mes "你……是在搭讪我吗？";
		close;
	}
	else if (ch_poison > 8) {
		if (rand(1,10) > 5) {
			mes "[Lady]";
		mes "你来到了洛阳入口。希望你玩得开心~";
			emotion ET_CHUP;
			close;
		}
		mes "[Lady]";
		mes "你来到了洛阳入口。";
		next;
		mes "[Lady]";
		mes "洛阳以各种烟花爆竹闻名。想看一个吗？";
		next;
		if (select("好啊！:不用了~") == 1) {
			mes "[Lady]";
			mes "好~给你！";
			if (Zeny > 99) {
				set Zeny, Zeny-100;
			}
			close2;
			donpcevent " #fire::OnClaymore";
			end;
		}
		mes "[Lady]";
		mes "哼……！";
		emotion ET_THINK;
		close;
	}
}


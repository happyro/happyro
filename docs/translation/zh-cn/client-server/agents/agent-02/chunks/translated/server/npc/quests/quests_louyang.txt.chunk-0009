lou_in01,107,163,0	script	 #lou_drink1	111,{
	if (ch_poison == 12) {
		mes "^3355FF你找到一个饮料瓶，可能是洛阳领主白龙的。^00000";
		next;
		mes "^3355FF你把致命毒药放进瓶子里。^000000";
		delitem 678,1; //Poison_Bottle
		set ch_poison,13;
		changequest 11076,11077;
		close;
	}
	else if (ch_poison == 13) {
		mes "^3355FF你最好尽快离开这里。^000000";
		close;
	}
	else if (ch_poison == 16) {
		if (countitem(938) > 0 && countitem(713) > 0) {
			mes "^3355FF你拿走饮料瓶，换成装满黏稠液体的瓶子。希望白龙不会发现！^000000";
			delitem 938,1; //Sticky_Mucus
			delitem 713,1; //Empty_Bottle
			set ch_poison,17;
			changequest 11079,11080;
			close;
		}
		mes "^3355FF看来你需要把白龙的饮料瓶换成别的东西。直接拿走饮料瓶会引起怀疑。^000000";
		next;
		mes "^3355FF也许你可以找个空瓶子，装进类似黏稠液体的东西……^000000";
		close;
	}
	mes "^3355FF你找到一个饮料瓶。它精致得很，唯一可能的主人就是洛阳领主白龙。^000000";
	close;
}


lou_in01,99,158,4	script	Lord#bailong	821,{
	if (checkweight(1201,1) == 0) {
		mes "^3355FF * Wait a minute! *";
		mes "你现在携带的物品太多。请将一些物品存入卡普拉仓库后再试。^000000";
		close;
	}
	if (ch_poison == 12 || ch_poison == 16) {
		mes "[Lord Bai Long]";
		mes "嘿……！你没在做什么可疑的事吧？";
		next;
		mes "^3355FFYou run away";
		mes "尽快把它交给白龙。^000000";
		close2;
		warp "louyang",218,246;
		end;
	}
	else {
		mes "[Lord Bai Long]";
		mes "哈哈哈哈！欢迎来到洛阳！";
		next;
		mes "[Lord Bai Long]";
		mes "洛阳是一座伟大的城市。四十年来，我们一直保护这片土地免受邪恶生物入侵！";
		next;
		mes "[Lord Bai Long]";
		mes "希望你在这里过得愉快，米德加尔特人！";
		next;
		if (ch_poison == 18) {
		mes "^3355FF你将 Nagash Arses 的日记交给白龙。他专注阅读，缓缓翻过每一页。^000000";
			next;
			mes "^3355FFHe's completely silent for about fifteen minutes, and focuses all";
		mes "将注意力集中在日记上。^000000";
			next;
		mes "^3355FF阅读 Nagash Arses 的文字时，一滴泪从他眼角滑落……^000000";
			next;
			mes "[Lord Bai Long]";
		mes "谢谢你……冒险者……";
			next;
			mes "[Lord Bai Long]";
		mes "非常感谢。你帮助我与老朋友和好了！";
			next;
			mes "[Lord Bai Long]";
		mes "我，白龙，将公平对待所有武术组织，无论其方法或理念！";
			next;
			mes "[Lord Bai Long]";
		mes "我也会原谅 Song Zhi Du，即使他曾试图毒害我。他是无辜的……";
			next;
			mes "[Lord Bai Long]";
		mes "事实上，据报告 Nagash 在那次事件后被遣返回故乡。我不知道他竟然进了监狱！";
			next;
			mes "[Lord Bai Long]";
		mes "非常感谢你的帮助！";
			next;
			next;
			mes "[Lord Bai Long]";
		mes "请收下这个作为谢礼，并替我把这封信交给 Nagash 和 Song Zhi Du。";
			set ch_poison,19;
			changequest 11081,11802;
			getitem 603,1; //Old_Blue_Box
			next;
			mes "^3355FFYou obtained ^0000FFBai Long's letter^000000.";
			next;
			mes "[Lord Bai Long]";
		mes "先谢谢你了。";
			close;
		}
		mes "[Lord Bai Long]";
		mes "我怎么会失去辉煌时期的朋友？嗯……？";
		mes "哦，我没意识到你还在那里听我说话。";
		next;
		mes "[Lord Bai Long]";
		mes "抱歉，我只是在自言自语。希望你在洛阳过得愉快。";
		close;
	}
}


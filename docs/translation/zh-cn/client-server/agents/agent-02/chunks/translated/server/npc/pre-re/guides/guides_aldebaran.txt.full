aldebaran,139,63,4	script	Soldier#alde	105,{
	cutin "prt_soldier",2;
	mes "[艾尔迪巴兰卫兵]";
	mes "我只是一个普通卫兵，";
	mes "在其他城市也能找到和我一样的人。我甚至没有名字……";
	next;
	mes "[艾尔迪巴兰卫兵]";
	mes "我负责艾尔迪巴兰驻军的服务指南。";
	mes "让我带你游览城镇！";
	next;
	if (select("获取地点指南。:结束对话。") == 1) {
		viewpoint 1,61,229,0,0xFF6633;
		viewpoint 1,72,197,1,0x0000FF;
		viewpoint 1,223,222,2,0x00FFFF;
		viewpoint 1,233,105,3,0x515151;
		viewpoint 1,197,70,4,0x3355FF;
		viewpoint 1,60,60,5,0xFF5555;
		mes "^FF6633+^000000 -> 卡普拉总办公室";
		mes "^0000FF+^000000 -> 武器店";
		mes "^00FFFF+^000000 -> 巫师公会（关闭）";
		mes "^515151+^000000 -> 酒馆";
		mes "^3355FF+^000000 -> 道具店";
		mes "^FF5555+^000000 -> 炼金术士公会";
		close2;
		cutin "prt_soldier",255;
		end;
	}
	mes "[艾尔迪巴兰卫兵]";
	mes "我们发誓守护艾尔迪巴兰！";
	mes "愿邪恶势力永远被正义的拳头击溃！";
	close2;
	cutin "prt_soldier",255;
	end;
}

aldebaran,133,108,4	script	Soldier#2alde	105,{
	cutin "prt_soldier",2;
	mes "[艾尔迪巴兰卫兵]";
	mes "我只是一个";
	mes "普通卫兵，";
	mes "在其他城市也";
	mes "能找到这样的卫兵。";
	next;
	mes "[艾尔迪巴兰卫兵]";
	mes "不忙着保护艾尔迪巴兰";
	mes "居民的时候，";
	mes "我就在这里为像你这样的冒险者指路。";
	mes "随时欢迎你来询问方向。";
	next;
	switch(select("卡普拉总办公室:武器店:巫师公会:酒馆:道具店:炼金术士公会:结束对话")) {
	case 1:
		viewpoint 1,61,229,0,0xFF6633;
		mes "^FF6633+^000000 -> 卡普拉总办公室";
		break;
	case 2:
		viewpoint 1,72,197,1,0x0000FF;
		mes "^0000FF+^000000 -> 武器店";
		break;
	case 3:
		viewpoint 1,223,222,2,0x00FFFF;
		mes "^00FFFF+^000000 -> 巫师公会（关闭）";
		break;
	case 4:
		viewpoint 1,233,105,3,0x515151;
		mes "^515151+^000000 -> 酒馆";
		break;
	case 5:
		viewpoint 1,197,70,4,0x3355FF;
		mes "^3355FF+^000000 -> 道具店";
		break;
	case 6:
		viewpoint 1,60,60,5,0xFF5555;
		mes "^FF5555+^000000 -> 炼金术士公会";
		break;
	case 7:
		mes "[艾尔迪巴兰卫兵]";
		mes "我们发誓";
		mes "守护艾尔迪巴兰！";
		mes "愿正义永远战胜邪恶～";
		mes "愿光明永远照耀这座城市。";
		break;
	}
	close2;
	cutin "prt_soldier",255;
	end;
}

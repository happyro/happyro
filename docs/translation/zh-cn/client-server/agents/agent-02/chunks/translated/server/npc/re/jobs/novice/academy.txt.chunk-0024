						mes "记住这些就够了。";
						mes "这门课就是为了让你了解自己能做什么。";
						mes "让我们完成技能体验。";
						mes "去找梅赛尔确认。";
						setquest 7485;
						completequest 7485;
						close2;
						cutin "", 255;
						end;
					} else if (isbegin_quest(7485) == 1) {
						if (checkquest(7485,HUNTING) == 2) {
							cutin "gc_verkhasel01.bmp", 0;
							mes "[维尔卡塞尔]";
							mes "你做得很好。";
							mes "施毒具有中毒效果，也能通过毒素本身造成伤害。";
							next;
							mes "[维尔卡塞尔]";
							mes "技能体验已经足够了。";
							mes "去找梅赛尔确认。";
							completequest 7485;
							getexp 800,0;
							close2;
							cutin "", 255;
							end;
						} else {
							cutin "gc_verkhasel01.bmp", 0;
							mes "[维尔卡塞尔]";
							mes "你无法装备盗贼手册吗？";
							mes "你的等级太高了。";
							mes "没有其他办法了。";
							next;
							mes "[维尔卡塞尔]";
							mes "施毒是让目标中毒的技能。";
							mes "即使没有使目标中毒，也能利用毒素的特性对其造成伤害。";
							next;
							mes "[维尔卡塞尔]";
							mes "记住这些就够了。";
							mes "这门课就是为了让你了解自己能做什么。";
							mes "让我们完成技能体验。";
							mes "去找梅赛尔确认。";
							completequest 7485;
							close2;
							cutin "", 255;
							end;
						}
					}
				}

				if (!isbegin_quest(7485)) {
					cutin "gc_verkhasel01.bmp", 0;
					mes "[维尔卡塞尔]";
					mes "这是关于技能使用的课程。";
					mes "如果你将来成为刺客，要不要现在测试一下今后可以继续使用的毒素相关技能？";
					next;
					mes "[维尔卡塞尔]";
					mes "装备梅赛尔给你的盗贼手册，然后按Alt+S键打开技能窗口，";
					mes "将登记在ETC栏中的施毒设置到快捷键上^000000";
					next;
					mes "[维尔卡塞尔]";
					mes "然后，走近房间中央的波利笼子，";
					mes "瞄准波利，并使用^4d4dff施毒猎杀一只波利";
					next;
					mes "[维尔卡塞尔]";
					mes "这就是我交给你的任务。";
					mes "你必须在这个房间里对波利使用施毒。";
					mes "不要跑到外面寻找波利。";
					setquest 7485;
					next;
					cutin "nov_lumin02.bmp", 2;
					mes "[露敏]";
					mes "嗯……";
					mes "真遗憾……";
					mes "先接受我的慰问吧，因为你没法体验施毒……呵呵呵……";
					next;
					select("你在说什么？");
					mes "[露敏]";
					mes "接下来我要去猎杀波利……";
					mes "……别误会，我不是要向你挑战，只是想和你打个赌。";
					cutin "nov_lumin03.bmp", 2;
					next;
					cutin "", 255;
					mes "露敏正在下注赌输赢。";
					close;
				} else if (isbegin_quest(7485) == 1) {
					if (checkquest(7485,HUNTING) == 2) {
						cutin "gc_verkhasel01.bmp", 0;
						mes "[维尔卡塞尔]";
						mes "你做得很好。";
						mes "施毒具有中毒效果，也能通过毒素本身造成伤害。";
						next;
						mes "[维尔卡塞尔]";
						mes "技能体验已经足够了。";
						mes "去找梅赛尔确认。";
						completequest 7485;
						getexp 800,0;
						close2;
						cutin "", 255;
						end;
					} else {
						cutin "gc_verkhasel01.bmp", 0;
						mes "[维尔卡塞尔]";
						mes "靠近波利笼子，对波利使用施毒。";
						mes "你只能对这个房间里的波利这样做。";
						next;
						if (select("我明白了……", "我不做。") == 1) {
							mes "[维尔卡塞尔]";
							mes "好的。在杀死笼子里的所有波利前，继续用毒素攻击它们。";
							percentheal 0,100;
							close2;
							cutin "", 255;
							end;
						}
						mes "[维尔卡塞尔]";
						mes "看来这不适合你。";
						mes "我会取消我的任务，梅赛尔交给你的其他任务也会由她取消。";
						next;
						if (select("取消。", "我会继续……") == 1) {
							mes "[维尔卡塞尔]";
							mes "取消使用施毒猎杀波利的任务。";
							erasequest 7485;
							close2;
							cutin "", 255;
							end;
						}
						mes "[维尔卡塞尔]";
						mes "你改变主意了吗？";
						mes "那么，在杀死笼子里的所有波利前，继续对它们使用施毒。";
						percentheal 0,100;
						close2;
						cutin "", 255;
						end;
					}
				} else {
					mes "[维尔卡塞尔]";
					mes "现在你已经完全理解毒素技能了……";
					mes "既然你完成了我的任务，就去找梅赛尔确认吧。";
					cutin "gc_verkhasel01.bmp", 0;
					close2;
					cutin "", 255;
					end;
				}
			} else {
				mes "[维尔卡塞尔]";
				mes "你已经顺利完成梅赛尔的课程了。";
				mes "还有问题就去问梅赛尔。";
				mes "我的课程到此结束。";
				cutin "gc_verkhasel01.bmp", 0;
				next;
				mes "[维尔卡塞尔]";
				mes "如果你成为盗贼，也许将来某天我们还会再见……";
				mes "如果你成为刺客的话。";
				close2;
				cutin "", 255;
				end;
			}
		}
	} else {
		if (!isbegin_quest(4269)) {
			mes "[维尔卡塞尔]";
			mes "没什么好对不属于本学院的家伙说的。";
			mes "其实我是被迫来到这里的，没心情对你这种人客气……";
			cutin "gc_verkhasel01.bmp", 0;
			next;
			mes "[梅赛尔]";
			mes "等等，维尔卡塞尔……";
			mes "别迁怒其他无辜的人……";
			mes "帮我完成课程怎么样？";
			cutin "gc_mayssel03.bmp", 1;
			next;
			cutin "", 255;
			mes "……大家似乎都很紧张……";
			close;
		} else {
			if (Class == Job_Thief) {
				mes "[维尔卡塞尔]";
				mes "哟～你……";
				mes "你想成为什么？";
				cutin "gc_verkhasel01.bmp", 0;
				next;
				if (select("刺客！", "流氓！") == 1) {
					mes "[露敏]";
					mes "欢迎加入血腥的黑暗之路。";
					mes "我的同伴。";
					cutin "nov_lumin03.bmp", 2;
					next;
					cutin "gc_verkhasel02.bmp", 0;
					mes "[维尔卡塞尔]";
					mes "..............";
					mes "（维尔卡塞尔抬头望天）";
					mes "...";
					mes "……哈……！";
					next;
					cutin "", 255;
					mes "气氛变得奇怪了。";
					close;
				} else {
					mes "[维尔卡塞尔]";
					mes "到那边去。";
					cutin "gc_verkhasel01.bmp", 0;
					next;
					cutin "sc_vicente04.bmp", 2;
					mes "[维森特]";
					mes "哦……维尔卡塞尔先生……";
					mes "别在一家人之间这样闹。";
					mes "你为什么要把我们分成两队？";
					next;
					cutin "gc_verkhasel01.bmp", 0;
					mes "[维尔卡塞尔]";
					mes "我从来就不是你们家的人。";
					mes "说到底，你也不是流氓。";
					mes "你以前只是个商人。";
					next;
					cutin "sc_vicente02.bmp", 2;
					mes "[维森特]";
					mes "哦……不……真是难听的话。";
					mes "我有请你来向我买东西吗？";
					next;
					cutin "gc_mayssel03.bmp", 1;
					mes "[梅赛尔]";
					mes "…………你们两个看起来关系真好……";
					next;
					cutin "", 255;
					mes "气氛变得紧张了。";
					close;
				}
			} else {
				cutin "gc_verkhasel01.bmp", 0;
				mes "[维尔卡塞尔]";
				mes "你是那个什么都知道的家伙。";
				mes "你只是来旁观的吗？嗯？";
				mes "别只看着，去帮助后辈吧？";
				close2;
				cutin "", 255;
				end;
			}
		}
	}

OnInit:
	questinfo( QTYPE_QUEST, QMARK_NONE, "!isbegin_quest(7482) && isbegin_quest(7480) == 1" );
	questinfo( QTYPE_QUEST, QMARK_NONE, "!isbegin_quest(7485) && isbegin_quest(7483) == 1" );
	end;
}

iz_ac02_a,55,134,3	duplicate(Verkhasel#ac)	Verkhasel#ac_a	4_M_GUILLOTINE
iz_ac02_b,55,134,3	duplicate(Verkhasel#ac)	Verkhasel#ac_b	4_M_GUILLOTINE
iz_ac02_c,55,134,3	duplicate(Verkhasel#ac)	Verkhasel#ac_c	4_M_GUILLOTINE
iz_ac02_d,55,134,3	duplicate(Verkhasel#ac)	Verkhasel#ac_d	4_M_GUILLOTINE

// - Lumin
// -----------------------------------------------------------------------------
iz_ac02,62,139,3	script	Lumin#ac	4_M_NOV_RUMIN,{
	if (!checkweight(1301,3)) {
		mes "由于物品栏已满，无法继续任务。";
		mes "整理物品后请再试一次。";
		close;
	}
	if (checkquest(7487,HUNTING) == -1) {
		if (isbegin_quest(7485) == 2) {
			mes "[露敏]";
			mes "你完成任务的热情和努力打动了我，所以我想送你一些东西。";
			cutin "nov_lumin01.bmp", 2;
			next;
			mes "[露敏]";
			mes "^4d4dff在30秒内猎杀这里的4只波利^000000。";
			mes "如果你做到，我会把手头所有获得的物品都给你。";
			next;
			select("如果我失败了呢？");
			mes "[露敏]";
			mes "这是我们的赌约。你输了就必须交出你的赌注。";
			mes "嗯……我很慷慨，只要你交出^4d4dff10瓶初心者红色药水^000000。";
			next;
			if (select("放弃。", "我接受。") == 1) {
				mes "[露敏]";
				mes "……呃……";
				mes "胆小鬼！";
				cutin "nov_lumin02.bmp", 2;
				close2;
				cutin "", 255;
				end;
			} else {
				mes "[露敏]";
				mes "……很好！";
				mes "现在，^4d4dff在30秒内猎杀4只波利后再来找我。^000000";
				setquest 7487;
				close2;
				cutin "", 255;
				end;
			}
		} else {
			mes "[露敏]";
			mes "中毒的敌人不会仅因中毒而死亡。";
			mes "它们只会濒临死亡。";
			cutin "nov_lumin01.bmp", 2;
			next;
			mes "[露敏]";
			mes "……波利为什么转过身去？";
			close2;
			cutin "", 255;
			end;
		}
	} else if (checkquest(7487,HUNTING) == 1) {
		if (checkquest(7487,PLAYTIME) == 2) {
			mes "[露敏]";
			mes "……30秒过去了，你还没有猎杀4只波利。";
			mes "那就没意思了。";
			cutin "nov_lumin01.bmp", 2;
			next;
			mes "[露敏]";
			mes "如果你不想做……那就算了。";
			mes "我很慷慨，这次就不计较赌约了。";
			erasequest 7487;
			close2;
			cutin "", 255;
			end;
		} else {
			mes "[露敏]";
			mes "你可能正忙着^4d4dff在30秒内猎杀4只波利。^000000";
			mes "嘿，时间正在流逝……";
			cutin "nov_lumin01.bmp", 2;
			close2;
			cutin "", 255;
			end;
		}
	} else if (checkquest(7487,HUNTING) == 2) {
		if (checkquest(7487,PLAYTIME) == 0) {
			mes "[露敏]";
			mes "哦……你真厉害！";
			mes "那么，按照约定，我会把我拥有的一切都给你。";
			cutin "nov_lumin03.bmp", 2;
			next;
			mes "[露敏]";
			mes "多亏你，我玩得很开心！";
			cutin "nov_lumin05.bmp", 2;
			completequest 7487;
			getexp 800,50;
			getitem 512,3;// Apple
			getitem 511,2;// Green_Herb
			getitem 569,22;// Novice_Potion
			getitem 622,1;// Rainbow_Carrot
			close2;
			cutin "", 255;
			end;
		} else {
			mes "[露敏]";
			mes "遗憾的是，30秒已经过去了。";
			cutin "nov_lumin02.bmp", 2;
			mes ".....";
			next;
			mes "[露敏]";
			mes "不管怎样我都会给你。";
			mes "来，拿着吧。";
			cutin "nov_lumin03.bmp", 2;
			completequest 7487;
			getexp 800,50;
			getitem 512,22;// Apple
			next;
			select("你为什么要这样对我？", "我不是输了吗？");
			mes "[露敏]";
			mes "你陪我度过了这段时间。";
			mes "免费拿走吧。这些是我从波利那里偷来的。";
			cutin "nov_lumin05.bmp", 2;
			close2;
			cutin "", 255;
			end;
		}
	} else {
		if (Class == Job_Novice) {
			mes "[露敏]";
			mes "我们也许会再见。";
			mes "和别人熟悉起来，既快乐又令人伤感。";
			cutin "nov_lumin02.bmp", 2;
			next;
			mes "[露敏]";
			mes "……如果它当场死掉，可能会有麻烦……";
			close2;
			cutin "", 255;
			end;
		} else {
			mes "[露敏]";
			mes "这一天终于到来了。";
			cutin "nov_lumin01.bmp", 2;
			next;
			cutin "", 255;
			mes "露敏一点一点地换着衣服。";
			specialeffect2 EF_SPHERE;
			specialeffect2 EF_SPHERE;
			setnpcdisplay( "Lumin#"+strnpcinfo(2), 4_M_THIEF_RUMIN );
			next;
			cutin "thf_lumin01.bmp", 2;
			mes "[露敏]";
			mes "我正在执行任务。";
			next;
			select("不用找借口……");
			mes "[露敏]";
			mes "至少我不想和你变成陌生人。";
			mes "忘掉你今天看到的一切，因为我必须尽可能多地向人介绍盗贼公会的道路。";
			cutin "thf_lumin05.bmp", 2;
			close2;
			specialeffect2 EF_SPHERE;
			specialeffect2 EF_SPHERE;
			setnpcdisplay( "Lumin#"+strnpcinfo(2), 4_M_NOV_RUMIN );
			cutin "", 255;
			end;
		}
	}

OnInit:
	questinfo( QTYPE_QUEST, QMARK_NONE, "!isbegin_quest(7487) && isbegin_quest(7485) == 1" );
	end;
}

iz_ac02_a,62,139,3	duplicate(Lumin#ac)	Lumin#ac_a	4_M_NOV_RUMIN
iz_ac02_b,62,139,3	duplicate(Lumin#ac)	Lumin#ac_b	4_M_NOV_RUMIN
iz_ac02_c,62,139,3	duplicate(Lumin#ac)	Lumin#ac_c	4_M_NOV_RUMIN

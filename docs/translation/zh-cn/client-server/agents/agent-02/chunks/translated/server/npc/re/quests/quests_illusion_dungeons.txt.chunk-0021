		mes "没错。很多人都说见过它。";
		mes "他说自己是左臂受伤的游侠，所以他不可能是唯一见过的朋友。";
		next;
		mes "[约兰达]";
		mes "我该怎么办？如果我也受那种伤，更别说搜索了……";
		next;
		mes "[米尔科]";
		mes "哦，等等！";
		mes "那边的冒险者，请等一下！";
		next;
		select( "我？" );
		mes "[米尔科]";
		mes "你最近来过这里吗？";
		mes "太好了。我们最近找到了深入其中的方法。";
		next;
		emotion ET_PROFUSELY_SWEAT, getnpcid(0,"Yolanda#1F");
		ill_anthell = 1;
		setquest 8719;
		mes "[约兰达]";
		mes "嘿，如果我告诉你呢！这不是我的研究，是你的！";
		next;
		select( "说话然后睡觉……" );
		mes "[" + strcharinfo(0) + "]";
		mes "你对陌生人说这个？";
		next;
		mes "[约兰达]";
		mes "没错！冒险者，";
		mes "抱歉，请等一下。";
		npctalk "约兰达：你自己到底会做什么？", "Yolanda#1F", bc_self;
		npctalk "米尔科：嘿，那应该我去，还是让刚出现的冒险者去？", "Mirko#1F", bc_self;
		close;
	}
	if (ill_anthell == 1) {
		emotion ET_PROFUSELY_SWEAT, getnpcid(0,"Mirko#1F");
		mes "[米尔科]";
		mes "怎么了，我现在需要再雇些人。";
		mes "那里甚至还不是废墟，放手去做怎么样？";
		next;
		emotion ET_PROFUSELY_SWEAT;
		mes "[约兰达]";
		mes "别总是犯错，然后把后续工作留给我。";
		next;
		emotion ET_PROFUSELY_SWEAT, getnpcid(0,"Mirko#1F");
		mes "[米尔科]";
		mes "冒险者在等你。";
		mes "之后再聊，好吗？";
		mes "好，那么冒险者。";
		mes "你叫什么？" + strcharinfo(0) + "？";
		next;
		mes "[米尔科]";
		mes "是的，" + strcharinfo(0) + "。";
		mes "我直说吧。";
		next;
		mes "[米尔科]";
		mes "我是米尔科，那边是约兰达。";
		mes "还有一名受了轻伤的游侠进入了我之前说的新发现蚁丘。我想……";
		mes "我现在的目标不是探索，而是希望你救出那名游侠和他的朋友。";
		next;
		mes "[米尔科]";
		mes "游侠名叫布莱申……";
		mes "布莱申提到的同伴是卡赫里斯，";
		mes "据布莱申说，他和她长得像双胞胎。";
		next;
		ill_anthell = 2;
		erasequest 8719;
		setquest 8720;
		mes "[米尔科]";
		mes "找到其中任何一个后，";
		mes "把消息带回来给我。";
		mes "带回尸体也可以。";
		mes "准备好后回来找我。";
		close;
	}
	if (ill_anthell == 2) {
		mes "[米尔科]";
		mes "找到布莱申和他的同伴。";
		mes "如果找到其中任何一个，希望你把他们带出来。";
		mes "带回尸体也可以。";
		mes "准备好了吗？";
		next;
		if (select( "好", "之后再说" ) == 2) {
			mes "[米尔科]";
			mes "抱歉突然提出请求。";
			mes "总之调查还没有完成，我们很不安……";
			mes "准备好后告诉我。";
			close;
		}
		mes "[米尔科]";
		mes "是的……事情就是这样……这是意外。我不小心打破了墙……";
		mes "连我们都能感受到的强大力量！看吧！";
		mes "隔着墙也能感受到。";
		next;
		mes "[米尔科]";
		mes "我能怎么办？作为冒险者，如果这里不是历史遗迹，又没有人的痕迹……我就必须调查！";
		mes "所以……我抓着头发调查了起来。";
		next;
		select( "你真勇敢" );
		mes "[约兰达]";
		mes "是啊……那个混蛋当时真的很勇敢。";
		mes "幸好你没有死。";
		next;
		mes "[米尔科]";
		mes "因为我还活着，所以没关系！";
		mes "总之，这里是二楼，去一楼的路在那边，对吧？";
		mes "但是……那不是路！";
		next;
		mes "[米尔科]";
		mes "但有什么不一样，气氛变了。";
		mes "感觉像是在朦胧的……梦里行走？";
		next;
		mes "[约兰达]";
		mes "我感觉自己写下了《阿修罗败国》。";
		next;
		mes "[米尔科]";
		mes "嘿，大多数人听你这样解释都听不懂！";
		next;
		select( "我大概明白了" );
		mes "[约兰达]";
		mes "哎呀。";
		next;
		mes "[米尔科]";
		mes "是我太迟钝了吗……？";
		mes "总之，虽然这里异常昏暗，却像身在此处又不在此处……感知正从身体上剥离……";
		mes "所以……";
		next;
		mes "[约兰达]";
		mes "轻微混乱。";
		mes "别担心，没什么严重的。我想我只是看到了愚蠢的东西。";
		mes "猜测也没关系。每个人的形态都不同。";
		next;
		mes "[约兰达]";
		mes "走到路上后能看出那里是空的，但在里面时无法察觉。";
		mes "换句话说，即使我弄错了，我也没有回到一楼。";
		next;
		mes "[米尔科]";
		mes "是的！虽然是同一条路，但我感觉自己在某处跨过了界线。";
		mes "而且，那里的蚂蚁强得离谱！";
		next;
		mes "[米尔科]";
		mes "你竟然活着回来了，真是遗憾……幸好那里的蚂蚁似乎没有来到这里。";
		mes "之后我打算暂时停止这边的地质探索，组织一次新的远征。";
		next;
		mes "[约兰达]";
		mes "我们中最强的布莱申去巡逻了，但看来来到这里的冒险者还不足以组成远征队。";
		mes "所以要么我们独自去，要么让他独自去……有一天，他在那里看到了一个和自己长得一模一样的人。";
		next;
		mes "[约兰达]";
		mes "正如我之前所说，有些人可能看到的是虚假事物，但……";
		mes "当它出现时，你会知道那是胡说吗？可是布莱申出来后这么说……";
		mes "我觉得那是真的。我们从未见过那种事。";
		next;
		mes "[约兰达]";
		mes "之后我们在外面等待，因为独自探索的结果还不错。";
		mes "前几天他身负重伤回来，但他的同伴还在那里。";
		mes "你被蚂蚁追赶了。";
		next;
		mes "[约兰达]";
		mes "但受了这样的伤……他说需要休息一阵，却一定是独自进入了那座蚁丘。";
		mes "也就是说，生死未卜……";
		next;

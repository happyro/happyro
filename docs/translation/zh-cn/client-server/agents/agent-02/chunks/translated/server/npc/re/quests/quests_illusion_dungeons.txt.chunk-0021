		case -1:
			break;
		case 0:
		case 1:
			mes "[凯娜]";
			mes "我想今天已经够了，请明天再来。";
			close;
		case 2:
			erasequest 3420;
			break;
		}
		switch( checkquest(3419,HUNTING) ) {
		case -1:
			mes "[凯娜]";
			mes "请各消灭15只^4d4dff" + getmonsterinfo("ILL_SEDORA", MOB_NAME) + "^000000和^4d4dff" + getmonsterinfo("ILL_STROUF", MOB_NAME) + "^000000。";
			next;
			mes "[凯娜]";
			mes "它们很烦人，请小心。";
			close2;
			setquest 3419;
			end;
		case 0:
		case 1:
			mes "[凯娜]";
			mes "请各消灭15只^4d4dff" + getmonsterinfo("ILL_SEDORA", MOB_NAME) + "^000000和^4d4dff" + getmonsterinfo("ILL_STROUF", MOB_NAME) + "^000000。";
			close;
		case 2:
			mes "[凯娜]";
			mes "它们都被消灭了，谢谢你的努力。";
			next;
			mes "[凯娜]";
			mes "时间合适时请明天再来。我会等着你。";
			close2;
			getitem 25271,1;	// IllusionStone
			getexp 20107500,14075250;
			setquest 3420;
			erasequest 3419;
			end;
		}
		end;
	case 3:
		mes "[凯娜]";
		mes "糟糕……";
		next;
		mes "[凯娜]";
		mes "放着不管会很危险……";
		close;
	}
	end;

S_Quest:
	switch( checkquest(getarg(1),PLAYTIME) ) {
	case -1:
		switch( checkquest(getarg(2),HUNTING) ) {
		case -1:
			.@string$ = getarg(0);
			break;
		case 0:
		case 1:
			.@string$ = getarg(0) + " - In Progress";
			break;
		case 2:
			.@string$ = getarg(0) + " - Done";
			break;
		}
		break;
	case 0:
	case 1:
		.@string$ = "^999999" + getarg(0) + " - Pending^000000";
		break;
	case 2:
		.@string$ = getarg(0);
		break;
	}
	return .@string$;

OnInit:
	questinfo( QTYPE_DAILYQUEST, QMARK_YELLOW, "checkquest(3418,PLAYTIME) == -1 && checkquest(3417,HUNTING) == -1" );
	questinfo( QTYPE_DAILYQUEST, QMARK_YELLOW, "checkquest(3417,HUNTING) == 2" );
	questinfo( QTYPE_DAILYQUEST, QMARK_YELLOW, "checkquest(3418,PLAYTIME) == 2" );

	questinfo( QTYPE_DAILYQUEST, QMARK_YELLOW, "checkquest(3420,PLAYTIME) == -1 && checkquest(3419,HUNTING) == -1" );
	questinfo( QTYPE_DAILYQUEST, QMARK_YELLOW, "checkquest(3419,HUNTING) == 2" );
	questinfo( QTYPE_DAILYQUEST, QMARK_YELLOW, "checkquest(3420,PLAYTIME) == 2" );
	end;
}


//============================================================
//= Illusion of Twins
//============================================================
// anthell02,172,189,5	script	Yolanda#1F	ASSASSIN,{
anthell02,172,189,5	script	Yolanda#1F	HIDDEN_NPC,{
	if (checkweight(1201,3) == 0) {
		mes "- 你携带的物品太多，无法继续任务。-";
		close;
	}
	if (BaseLevel < 160) {
		mes "[约兰达]";
		mes "我们不能这样下去……";
		next;
		mes "[米尔科]";
		mes "但在有足够强大的冒险者到达那里之前……";
		next;
		mes "== 这是160级或更高等级的任务 ==";
		close;
	}
	if (ill_anthell == 0) {
		emotion ET_PROFUSELY_SWEAT;
		mes "[约兰达]";
		mes "你真的要进去吗？";
		next;
		emotion ET_PROFUSELY_SWEAT, getnpcid(0,"Mirko#1F");
		mes "[米尔科]";
		mes "没错。很多人都说见过它。";
		mes "他说自己是左臂受伤的游侠，所以他不可能是唯一见过的朋友。";
		next;
		mes "[约兰达]";
		mes "我该怎么办？如果我也受那种伤，更别说搜索了……";
		next;
		mes "[米尔科]";
		mes "哦，等等！";
		mes "那边的冒险者，请等一下！";
		next;
		select( "我？" );
		mes "[米尔科]";
		mes "你最近来过这里吗？";
		mes "太好了。我们最近找到了深入其中的方法。";
		next;
		emotion ET_PROFUSELY_SWEAT;
		ill_anthell = 1;
		setquest 8719;
		mes "[约兰达]";
		mes "嘿，如果我告诉你呢！这不是我的研究，是你的！";
		next;
		select( "说话然后睡觉……" );
		mes "[" + strcharinfo(0) + "]";
		mes "你对陌生人说这个？";
		next;
		mes "[约兰达]";
		mes "没错！冒险者，";
		mes "抱歉，请等一下。";
		npctalk "约兰达：你自己到底会做什么？", "", bc_self;
		npctalk "米尔科：嘿，那应该我去，还是让刚出现的冒险者去？", "Mirko#1F", bc_self;
		close;
	}
	if (ill_anthell == 1) {
		emotion ET_PROFUSELY_SWEAT, getnpcid(0,"Mirko#1F");
		mes "[米尔科]";
		mes "怎么了，我现在需要再雇些人。";
		mes "那里甚至还不是废墟，放手去做怎么样？";
		next;
		emotion ET_PROFUSELY_SWEAT;
		mes "[约兰达]";
		mes "别总是犯错，然后把后续工作留给我。";
		next;
		emotion ET_PROFUSELY_SWEAT, getnpcid(0,"Mirko#1F");
		mes "[米尔科]";
		mes "有一名冒险者在等你。";
		mes "之后再聊，好吗？";
		mes "好，那么冒险者。";
		mes "你叫" + strcharinfo(0) + "？";
		next;
		mes "[米尔科]";
		mes "是的，" + strcharinfo(0) + "。";
		mes "我直说吧。";
		next;
		mes "[米尔科]";
		mes "我是米尔科，那边是约兰达。";
		mes "还有一名受了轻伤的游侠进入了我之前说的新发现蚁丘。我想……";
		mes "我现在的目标不是探索，而是希望你救出那名游侠和他的朋友。";
		next;
		mes "[米尔科]";
		mes "游侠名叫布莱申……";
		mes "布莱申提到的同伴是卡赫里斯，";
		mes "据布莱申说，他和她长得像双胞胎。";
		next;
		ill_anthell = 2;
		erasequest 8719;
		setquest 8720;
		mes "[米尔科]";
		mes "找到其中任何一个后，";
		mes "把消息带回来给我。";
		mes "带回尸体也可以。";
		mes "准备好后回来找我。";
		close;
	}
	if (ill_anthell == 2) {
		mes "[约兰达]";
		mes "怎么了……";
		close;
	}
	if (ill_anthell == 3) {
		mes "[约兰达]";
		mes "要是我能再强一点……";
		close;
	}
	if (ill_anthell == 4) {
		mes "[约兰达]";
		mes "你见过布莱申吗？";
		mes "你还活着？太好了……为什么没把我带出去？";
		mes "啊……";
		mes "...";
		next;
		mes "[约兰达]";
		mes "再和米尔科谈谈吧。";
		mes "我想你和我想到一块去了。";
		close;
	}
	if (ill_anthell == 5 || ill_anthell == 6) {
		mes "[约兰达]";
		mes "如果我们也能去就好了……";
		mes "照顾好布莱申。";
		close;
	}
	if (ill_anthell == 7) {
		mes "[约兰达]";
		mes "真令人惊讶！";
		mes "它从哪里来的？！";
		next;
		select( "它弹回来了" );
		mes "[约兰达]";
		mes "什么？";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "有三个人长得像卡赫里斯……";
		next;
		mes "== Explained everything to Mirko and Yolanda. ==";
		next;
		mes "[米尔科]";
		mes "三个人都在谈话中途消失了。";
		mes "而且，你最后见到的人是……维塔塔？";
		next;
		mes "[约兰达]";
		mes "也许……也许……";
		mes "三个都可能是卡赫里斯，而不是只有那个长得像他的人吗？";
		next;
		mes "[米尔科]";
		mes "什么？";
		mes "如果" + strcharinfo(0) + "当时独自在那里，也可能是幻觉，对吧？";
		next;
		mes "[约兰达]";
		mes "我听说布莱申就是这么做的。和卡赫里斯在一起时，蚂蚁没有攻击我。";
		next;
		mes "[米尔科]";
		mes "但最后，玛雅……";
		next;
		mes "[约兰达]";
		mes "如果是那样呢？";
		next;
		mes "[约兰达]";
		mes "这只是个假设。";
		mes "卡赫里斯……和维塔塔在一起，所以其他蚂蚁自然不会碰它。";
		mes "蚂蚁不是群体吗？";
		next;
		mes "[约兰达]";
		mes "但玛雅是地牢的统治者。";
		next;
		mes "[米尔科]";
		mes "嗯……";
		next;
		mes "[约兰达]";
		mes "如果你能伤害自己……";
		next;
		mes "[米尔科]";
		mes "也许我就能碰到它。";
		next;
		mes "[约兰达]";
		mes "维塔塔的行为威胁到了她的地位……";
		next;
		mes "[米尔科]";
		mes "!!";
		mes "所以现在真正危险的是……";
		next;
		mes "[米尔科]";
		mes "" + strcharinfo(0) + "，这只是个假设，但现在布莱申真的很危险！";
		next;
		if (select( "好，我会回来。", "我需要时间准备。" ) == 2) {
		mes "[米尔科]";
			mes "事情很紧急，所以我就快速问你！";
			close;
		}
		mes "[米尔科]";
		mes "拜托了！";
		close2;
		warp "ant_d02_i",172,185;
		ill_anthell = 8;
		erasequest 8728;
		setquest 8729;
		open_quest_ui(8729);
		end;
	}
	if (ill_anthell == 8) {
		mes "[约兰达]";
		mes "求你了，" + strcharinfo(0) + "……";
		close;
	}
	if (ill_anthell == 9) {
		mes "[约兰达]";
		mes "...";
		close;
	}
	mes "[约兰达]";
	mes "我会继续研究一段时间。";
	mes "钱不多，之后再给你。";
	close;

OnInit:
	.@npc_id = getnpcid(0);
	setunitdata .@npc_id, UNPC_CLASS, 12;
	setunitdata .@npc_id, UNPC_HAIRSTYLE, 9;
	setunitdata .@npc_id, UNPC_HEADTOP, 1501;

	questinfo( QTYPE_QUEST, QMARK_YELLOW, "ill_anthell == 0" );	// note: some dialogs are similiar to the sage npc but only this questinfo is displayed for this npc
	end;
}

anthell02,177,190,3	script	Mirko#1F	4_M_SAGE_A,{
	if (checkweight(1201,3) == 0) {
		mes "- 你携带的物品太多，无法继续任务。-";
		close;
	}
	if (BaseLevel < 160) {
		mes "[米尔科]";
		mes "你见过布莱申了吗？";
		next;
		mes "[约兰达]";
		mes "还没有。";
		mes "……我也需要看看那里有什么。";
		next;
		mes "== 这是一个160级以上的任务 ==";
		close;
	}
	if (ill_anthell == 0) {
		emotion ET_PROFUSELY_SWEAT, getnpcid(0,"Yolanda#1F");
		mes "[约兰达]";
		mes "你真的要进去吗？";
		next;
		emotion ET_PROFUSELY_SWEAT;

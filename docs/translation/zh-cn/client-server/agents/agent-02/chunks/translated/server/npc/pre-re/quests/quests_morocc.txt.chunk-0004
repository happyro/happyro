		close;
	}
	if (checkquest(10018) == 2) {
		mes "[Poe]";
		mes "他毫无挑战地放弃了。这不是男子汉该做的事。他不如我。不过，我还是对他很失望。Eigen Ahrum。";
		close;
	}
	else if (checkquest(10018) == 0 || checkquest(10018) == 1) {
		mes "[Poe]";
		mes "......";
		close;
	}
	if (nk_prince < 5) {
		mes "[Prince]";
		mes "嗨，你好吗？";
		mes "我不认为你有资格";
		mes "来到这里。";
		mes "先把你的家谱理清，再来吧？";
		close;
	}
	else if (nk_prince > 4) {
		mes "[Prince]";
		mes "过来。";
		mes "你就是那位冒险者！";
		mes "我也喜欢艰难旅途的挑战。爱说话的老人和他们的冒险……你无法让我停止冒险……";
		next;
		mes "[Prince]";
		mes "我叫 Poe。";
		mes "我是理查德家族的王子。记住我，成为我的支持者……";
		next;
		mes "[Poe]";
		mes "首先，我想";
		mes "测试你作为冒险者的能力。能力测试没那么严肃，我只是想知道你的直觉有多准确……仅此而已。";
		next;
		mes "[Poe]";
		mes "我不想和";
		mes "直觉低下的人说话。";
		mes "让我简单说明一下，";
		mes "然后测试你的直觉。";
		next;
		mes "[Poe]";
		mes "我的牌上有 1 到 13 的数字。对于我抽到的牌，你要回答它是较小还是较大的数字。";
		next;
		mes "[Poe]";
		mes "当然，7 是中间数字。7 代表既不成功也不失败。游戏目标是连续两次回答正确。开始吧！";
		next;
		while(.@wincount < 2) {
			set .@card,rand(1,13);
			mes "[Poe]";
			mes "好，现在从";
			mes "较大和较小中选一个。";
			mes "只能选一个。";
			next;
			switch(select("较大:较小")) {
			case 1:
				mes "[Poe]";
				mes "嗯……较大……？";
				mes "我现在抽牌！";
				next;
				mes "[Poe]";
				mes "是……" + .@card + "！！";
				next;
				if (.@card > 7) {
					set .@wincount,.@wincount+1;
					mes "[Poe]";
				mes "哇，你回答正确！";
					if (.@wincount == 2) {
					mes "你连续赢了两次，对吧……？";
						next;
						break;
					}
					else {
					mes "不过目前为止你只答对了一次。";
						next;
					}
				}
				else if (.@card == 7) {
					mes "[Poe]";
				mes "这局平手。";
				mes "下次表现好一点。";
					next;
				}
				else {
					mes "[Poe]";
				mes "错了……";
				mes "去找 Hollgrehenn，请他提升你的运气。";
					close;
				}
				break;
			case 2:
				mes "[Poe]";
				mes "呃，较小……？";
				mes "看我的牌！";
				next;
				mes "[Poe]";
				mes "是……" + .@card + "！！";
				next;
				if (.@card < 7) {
					set .@wincount,.@wincount+1;
					mes "[Poe]";
					mes "哇，你回答正确！";
					if (.@wincount == 2) {
					mes "你连续赢了两次，对吧……？";
						next;
						break;
					}
					else {
					mes "不过目前为止你只答对了一次。";
						next;
					}
				}
				else if (.@card == 7) {
					mes "[Poe]";
				mes "这局平手。";
				mes "下次表现好一点。";
					next;
				}
				else {
					mes "[Poe]";
				mes "错了……";
				mes "去找 Hollgrehenn，请他提升你的运气。";
					close;
				}
				break;
			}
		}
		mes "[Poe]";
	mes "很好，向喜欢抽出所有牌的高直觉之人倾诉是很自然的。";
		next;
		mes "[Poe]";
	mes "通过展示的牌我已经很了解你了，但这次让我分享我的隐藏牌！想知道什么尽管问。";
		next;
		mes "[Poe]";
	mes "那么……你想知道什么？！";
		next;
		while(1) {
			switch(select("你的背景故事……:你对国家的看法……:爱好和兴趣……:我稍后再来。")) {
			case 1:
				mes "[Poe]";
				mes "我的背景……";
				mes "过去的故事。";
				mes "我完全不重视它，所以记不清了……";
				next;
				mes "[Poe]";
				mes "我能说自己是经历过许多比赛和战斗的幸存者吗？这很适合我。哈哈哈哈哈！";
				next;
				mes "[Poe]";
				mes "我经历过许多事故和挑战……并从中幸存下来，继续追寻新事物。生命意味着……";
				next;
				mes "[Poe]";
				mes "永远不要被发到的牌击垮，瞄准致命一击！";
				next;
				mes "[Poe]";
				mes "......";
				next;
				mes "[Poe]";
				mes "嘿，很酷吧？";
				mes "我们的品味相同，对吧？";
				set .@p_a,1;
				next;
				break;
			case 2:
				mes "[Poe]";
				mes "我认为国家应该为人民提供最低限度的保护，保障每个人的自由。";
				next;
				mes "[Poe]";
				mes "人们应该挑战自己热爱的事物，国家不应阻碍人民的自由行动。";
				next;
				mes "[Poe]";
				mes "如果我是国王，我会取消所有限制，让每个人都能在安全范围内过自由的生活。";
				next;
				mes "[Poe]";
				mes "想到我的家人，我的族人太保守，也不懂变通。";
				next;
				mes "[Poe]";
				mes "他们总说这不能做、那很危险、这是理所当然……一生都在不停唠叨……";
				next;
				mes "[Poe]";
				mes "啊，刚才那些话";
				mes "不算正式发言。";
				mes "我不想被家人烦扰。";
				set .@p_b,1;
				next;
				break;
			case 3:
				mes "[Poe]";
				mes "体验新事物！";
				mes "不管是什么我都不在乎！";
				next;
				mes "[Poe]";
				mes "如果这是探索时代，我可能会成为探索队的队长！未开发、寻路、调查……这些都是我的专长。你呢？";
				next;
				mes "[Poe]";
				mes "但很多人说我沉迷赌博。其实我只是充满挑战精神，喜欢赚大钱！我是个崇尚自由的普通人。";
				set .@p_c,1;
				next;
				break;
			case 4:
				mes "[Poe]";
				mes "好吧，";
				mes "下次在更刺激、更危险的地方见。";
				if (.@p_a + .@p_b + .@p_c == 3) {
					completequest 10007;
				}
				set .@prin1,checkquest(10005);
				set .@prin2,checkquest(10006);
				set .@prin3,checkquest(10007);
				set .@prin4,checkquest(10008);
				set .@prin5,checkquest(10009);
				set .@prin6,checkquest(10010);
				set .@prin7,checkquest(10011);
				if ((.@prin1 + .@prin2 + .@prin3 + .@prin4 + .@prin5 + .@prin6 + .@prin7) == 14) {
					setquest 10012;
				}
				close;
			}
		}
	}
}

prt_castle,364,375,4	script	Prince#peter	987,{
	if (nk_prince > 6) {
		mes "[Peter]";
		mes "鉴定师。";
		mes "你见过艾尔帕兰的那个小女孩吗？";
		next;
		switch(select("见过，我替你见过她。:不，我不想去。")) {
		case 1:
			if (checkquest(10014) == 0 || checkquest(10014) == 1) {
				mes "[Peter]";
				mes "我很高兴女孩喜欢它。治好后我就想去见她。";
				next;
				mes "[Peter]";
				mes "总之，谢谢你的努力。很抱歉总用琐事打扰你。这是我的谢意，请收下，不必有负担。";
				completequest 10014;
				getitem 644,1; //Gift_Box
				close;
			}
			mes "[Peter]";
			mes "想到那个小女孩我就平静下来。我仍不敢相信自己的眼睛。刚刚去世的 Ahrum 王子……~";
			close;
		case 2:
			if (checkquest(10014) == 0 || checkquest(10014) == 1) {
				mes "[Peter]";
				mes "如你所说。";
				mes "听说失去她时，她的生命就像一朵花。";
				mes "我会亲自去见她。";
				next;
				mes "[Peter]";
				mes "很抱歉总用琐事打扰你。请收下这个。";
				completequest 10014;
				getitem 644,1; //Gift_Box
				close;
			}
			mes "[Peter]";
			mes "没关系。";
			mes "我仍不敢相信自己的眼睛。刚刚去世的 Ahrum 王子……~~";
			close;
		}
	}
	if (checkquest(10019) == 2) {
		mes "[Peter]";
		mes "孩子……你到底怎么了……？";
		close;
	}
	else if (checkquest(10019) == 0 || checkquest(10019) == 1) {
		mes "[Peter]";
		mes "......";
		close;
	}
	if (checkquest(10008) == 2) {
		set .@quest, checkquest(10014);
		if (.@quest == 2) {
			mes "[Peter]";
			mes "我真的很感激。";
			mes "你真善良。";
			close;
		}
		else if (.@quest == 0 || .@quest == 1) {
			mes "[Peter]";
			mes "我很高兴那个女孩喜欢它。痊愈后，我想去见她。";
			next;
			mes "[Peter]";
			mes "总之，谢谢你的帮助。因为琐事麻烦你，我真的很过意不去。这是我的谢礼，请收下，不必有负担。";
			completequest 10014;
			getitem 644,1; //Gift_Box
			close;
		}
		else {
			mes "[Peter]";
			mes "鉴定师，你还有";
			mes "其他事情吗？";
			close;
		}
	}
	else {
		if (nk_prince < 4) {
			mes "[Prince]";
			mes "我认为你不被允许";
			mes "待在这里。";
			close;
		}
		else if (nk_prince > 4) {
			mes "[Prince]";
			mes "你好，";
			mes "我是 Heine 家族的 Peter。很高兴见到你。";
			next;
			mes "[Peter]";
			mes "那么，我们从哪里开始？";
			next;
			while(1) {
				switch(select("你的背景故事……:你对国家的看法……:爱好和兴趣……:我稍后再来。")) {
				case 1:
					mes "[Peter]";
					mes "我的家族并没有多大影响力。我的童年并不富裕，只能找工作、靠兼职赚钱。";
					next;
					mes "[Peter]";
					mes "但这让我能了解人们的生活和细节。这是我的优点。";
					next;
					mes "[Peter]";
					mes "这些足够回答你的问题了吗？";
					next;
					break;
				case 2:
					mes "[Peter]";
					mes "我认为重要的是人们在自己的领域实现价值，国家只需提供必要的支持。";
					mes "简而言之，国家不应统治一切，人们需要彼此和平相处。";
					next;
					mes "[Peter]";
					mes "因此，我会消除阶级差异带来的利益差距。这不是平等问题，而是为了提升国家力量。";
					next;
					break;
				case 3:
					mes "[Peter]";
					mes "我的爱好只有读书。我认为人应该不断前进，必须有进取的态度。";
					next;
					break;
				case 4:
					mes "[Peter]";
					mes "啊，是这样吗？";
					next;
					mes "[Peter]";
					mes "那么，我有件事想拜托你……能听听我的故事吗？";
					next;
					mes "[Peter]";
					mes "我原本不喜欢留胡子……但曾有一次改变的机会……最近我觉得，是有人给了我这个机会。";
					next;
					mes "[Peter]";
					mes "那是因为一个陌生女孩的信……";
					next;
					mes "[Peter]";
					mes "她在信里说我的脸部轮廓太锋利，如果留胡子就能遮住不少，外表也会好看得多。";
					next;
					mes "[Peter]";
					mes "我想报答她。";
					mes "因为她的话帮了我很多。不是什么特别的东西，也许送一小束花就好。";
					next;
					mes "[Peter]";
					mes "你能带着这些花，替我向某个在艾尔帕兰的女孩道谢吗？";
					completequest 10008;
					next;
					switch(select("好的，没问题。:请找别人吧。")) {
					case 1:
						mes "[Peter]";
						mes "好的，非常感谢你。";
						mes "请多保重。";
						getitem 744,1; //Bunch_Of_Flowers
						setquest 10013;
						set .@prin1,checkquest(10005);
						set .@prin2,checkquest(10006);
						set .@prin3,checkquest(10007);
						set .@prin4,checkquest(10008);
						set .@prin5,checkquest(10009);
						set .@prin6,checkquest(10010);
						set .@prin7,checkquest(10011);
						if ((.@prin1 + .@prin2 + .@prin3 + .@prin4 + .@prin5 + .@prin6 + .@prin7) == 14) {
							setquest 10012;
						}
						close;
					case 2:
						mes "[Peter]";
						mes "我理解你……";
						mes "我知道你有自己的";
						mes "事情要办。";
						setquest 10013;
						set .@prin1,checkquest(10005);
						set .@prin2,checkquest(10006);
						set .@prin3,checkquest(10007);
						set .@prin4,checkquest(10008);
						set .@prin5,checkquest(10009);
						set .@prin6,checkquest(10010);
						set .@prin7,checkquest(10011);
						if ((.@prin1 + .@prin2 + .@prin3 + .@prin4 + .@prin5 + .@prin6 + .@prin7) == 14) {
							setquest 10012;
						}
						close;
					}
				}
			}
		}
	}
}

aldebaran,132,184,3	script	Girl#prince	96,{
	if (checkquest(10013) == 0 || checkquest(10013) == 1) {
		if (countitem(744) > 0) {
			mes "[Girl]";
			mes "哇，Peter 叔叔送这些花";
			mes "给我的吗？";
			mes "嗯~闻起来真香。";
			next;
			mes "[Girl]";
			mes "嘿嘿~你一定是 Peter 叔叔的朋友。";
			mes "下次见到他时，";
			mes "请代我向 Peter 叔叔问好。";
			mes "告诉他我非常喜欢这些花……";
			mes "好啦，再见。";
			next;
			mes "[Girl]";
			mes "我要早点回家，";
			mes "把这些花插进花瓶。";
			mes "啦啦啦~";
			delitem 744,1; //Bunch_Of_Flowers
			changequest 10013,10014;
			close;
		}
		else {
			mes "[Girl]";
			mes "嘿，你听过《长腿叔叔》的故事吗？……";
			close;
		}
	}
	else {
		mes "[Girl]";
		mes "嘿，你听过《长腿叔叔》的故事吗？……";
		close;
	}
}

prt_castle,314,373,4	script	Prince#eisen	983,{
	if (nkprince_eisen > 2) {
		if (nkprince_eisen == 3) {
			mes "[Ahrum]";
			mes "Ernst 怎么样……？";
			mes "他对一切都很认真。他不惹麻烦，也不发脾气……有时有点奇怪。";
			next;
			mes "[Ahrum]";
			mes "我们曾是亲密朋友。他不像我，善良又富有同情心，是出色的公务官员。需要严格时，他会对所有人严格。";
			set nkprince_eisen,4;
			close;
		}
		else if (nkprince_eisen == 4) {
			mes "[Ahrum]";
			mes "我是 Eigen Ahrum，";
			mes "我将成为卢恩·米德加尔的光。";
			close;
		}
		else if (nkprince_eisen == 5) {
			mes "[Ahrum]";
			mes "无论谁成为国王，让我们互相帮助，把卢恩·米德加尔建设成世界上最好的国家。";
			next;
			mes "[Ernst]";
			mes "我们能做到。";
			mes "不，我们一定能做到。我和哥哥一起，一定能做到。";
			next;
			mes "[Ahrum]";
			mes "但是……如果我成为统治者或帮助你，而我被腐化……你就亲手杀了我。";
			next;
			mes "[Ahrum]";
			mes "反过来我也会杀了你，明白吗？所以永远不要偏离，也不要忘记你的决心。";
			next;
			mes "[Ernst]";
			mes "哥哥，你想得太可怕了。那永远不会发生，所以……别这么说。";
			next;
			mes "[Ahrum]";
			mes "这只是假设。";
			mes "别太当真。";
			next;
			mes "[Ernst]";
			mes "好了，好了。别";
			mes "误解我的意思。";
			mes "我一直在为哥哥和王国行事，以后也会如此。";
			next;
			emotion ET_SURPRISE;
			mes "[Ahrum]";
			mes "啊，鉴定师来了。";
			mes "你怎么突然出现？我和 Ernst 正聊到一半。";
			next;
			mes "[Ernst]";
			mes "怎么了，哥哥？我们没在说什么坏事，只是在坚定我们的决心。";
			next;
			mes "[Ahrum]";
			mes "你来得正好。我们刚决定，如果其中一人被腐化，就杀掉另一个。";
			next;
			mes "[Ernst]";
			mes "哥哥？！";
			next;
			mes "[Ahrum]";
			mes "无论如何，请作为这份约定的见证者。你不能拒绝。就某些方面而言，这对你的工作很有好处，不是吗？";
			next;

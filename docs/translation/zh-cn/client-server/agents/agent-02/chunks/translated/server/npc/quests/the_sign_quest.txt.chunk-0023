				mes "[Gen]";
			mes "我只是想警告你。小心别以证明勇气为借口，掩饰自己对奖励的贪婪。我当时就是这样……";
				next;
				mes "[Gen]";
			mes "总之，我说得够多了。先去见女巫，请她帮忙，好吗？";
				next;
				mes "[Gen]";
			mes "最后一件事。私下说，如果你要和 Serin 打交道，应该非常小心。她看起来人不错，但有些地方很奇怪。";
				next;
				mes "[Gen]";
			mes "她非常有说服力，而且她生前曾是伟大的巫师，这让我不安。她和尼弗海姆其他被困者很不一样……";
				set sign_q,88;
				close;
			}
		}
		else {
			mes "[Gen]";
			mes "你是来向众神证明勇气的吗？";
			next;
			mes "[Gen]";
		mes "你知道，我以前也是冒险者。事实上，我也曾为了众神设下的试炼来到尼弗海姆。但我失败了，最后被束缚在这个领域……";
			next;
			mes "[Gen]";
			mes "我只是想警告你。小心别以证明勇气为借口，掩饰自己对奖励的贪婪。我当时就是这样……";
			next;
			mes "[Gen]";
			mes "总之，我说得够多了。先去见女巫，请她帮忙，好吗？";
			set sign_q,88;
			close;
		}
	}
	else if (sign_q < 117) {
		mes "[Gen]";
			mes "嗯……我听说你在寻找非常重要的东西。这会是危险的搜索。";
		next;
		mes "[Gen]";
			mes "还有许多其他人也对你寻找的东西感兴趣……";
		close;
	}
	else if (sign_q == 117) {
		mes "[Gen]";
		mes "你一定是非常足智多谋的凡人。即使拥有全部力量的赫尔女王，也花了很久找不到她母亲的灵魂。";
		next;
		mes "[Gen]";
		mes "我不必再隐藏真实身份了。我的真名是冈拉蒂，尼弗海姆统治者赫尔女王的仆人。";
		next;
		mes "[Gen]";
		mes "殿下想和你谈谈。现在要我把你送到她的宅邸埃尔尤德尼尔吗？";
		next;
		switch(select("是:否")) {
		case 1:
			mes "[Gen]";
			mes "记住，和赫尔女王说话时要小心，尤其要礼貌。否则后果会很严重……";
			close2;
			warp "que_sign01",45,20;
			end;
		case 2:
			mes "[Gen]";
			mes "我明白。与神相见不是小事。不过我建议你尽快，因为殿下急着见你。";
			close;
		}
	}
	else if (sign_q == 118) {
		mes "[Gen]";
		mes "你一定深受眷顾，才能获得九界象征。当然它只能使用一次，但这仍是莫大的荣誉。";
		next;
		mes "[Gen]";
		mes "我再次提醒你要提防 Serin。她也许已经知道你打算如何使用这个象征……";
		close;
	}
	else if (sign_q < 129) {
		mes "[Gen]";
		mes "你必须赶快阻止召唤，否则你的世界将陷入巨大危机！";
		next;
		mes "[Gen]";
		mes "虽然赫尔女王对这件事相当冷淡，但我恳求你为生者领域尽力！";
		close;
	}
	else if (sign_q > 200) {
		mes "[Gen]";
		mes "我早该知道";
		mes "我早该知道你无法阻止她。不过我仍抱着一丝希望，觉得你也许能做到。";
		next;
		mes "[Gen]";
		mes "也许我对你期待太高了。暂时再见，凡人。";
		close;
	}
	else {
		mes "[Gen]";
		mes "你阻止 Serin 做得很好。太棒了！你为生者领域提供了如此伟大的服务！";
		next;
		mes "[Gen]";
		mes "很高兴通知你，你再次受邀前往赫尔女王的宅邸。你准备好出发了吗？";
		next;
		switch(select("不用了，谢谢。:是。")) {
		case 1:
			mes "[Gen]";
			mes "我明白了。准备充分后再回来找我。";
			close;
		case 2:
			mes "[Gen]";
			mes "很好，很好。别忘了以最高的敬意与殿下交谈！";
			close2;
			warp "que_sign01",45,20;
			end;
		}
		close;
	}
}

nif_in,140,177,0	script	#Switch	111,{
	callfunc "F_UpdateSignVars";
	if (countitem(7313) == 1) {
		warp "que_sign01",115,135;
		end;
	}
	if (sign_q > 89) {
		if (sign_q == 126) set sign_q,198;
		warp "que_sign01",115,135;
		end;
	}
	end;
}

niflheim,102,54,4	script	Mad Man#s	739,{
	callfunc "F_UpdateSignVars";
	mes "[Laichin]";
	if (sign_q < 82) {
		mes "什么？我看起来很面熟？嗯，你知道他们怎么说。世上总有某个人和你长得像。我说得对吧？";
		close;
	}
	else if (sign_q < 96) {
		mes "尼弗海姆不是很糟的居住地。阿斯加特确实漂亮，但规矩太多。这里自由多了，只要习惯臭味。";
		next;
		mes "[Laichin]";
		mes "我说‘臭味’？我的意思是……‘香气’。好吧，众神把我驱逐了，但我真该感谢他们把我送到这里！";
		next;
		mes "[Laichin]";
		mes "你那是什么表情……？什么，你不相信像我这样的人曾住在英灵殿？我也不信！他们让我住进阿斯加特真是个错误！";
		close;
	}
	else if (sign_q == 96) {
		mes "安格尔波达……？对，对！我记得以前在阿斯加特和众神混在一起时听过她的事。";
		next;
		mes "[Laichin]";
		mes "是啊，那些家伙做得很狠。他们取出她的灵魂，将其分成四块，藏在米德加尔特最深的洞穴里！";
		next;
		mes "[Laichin]";
		mes "当然她是巨人，但众神很害怕她。她的孩子最后都成了传说中的怪物！不过我不确定赫尔女王算不算。";
		next;
		mes "[Laichin]";
		mes "这也太残酷了。即使死去，灵魂也无处安息。安格尔波达的灵魂还被切成了碎片！";
		next;
		select("那么灵魂碎片在哪里来着？");
		mes "[Laichin]";
		mes "什么……？我刚说过，在米德加尔特最深的地下。那是由怪物群保护的危险地方。";
		next;
		mes "[Laichin]";
		mes "等等，你是说要找到安格尔波达的全部灵魂？！你疯了！要是碎片失踪，众神会知道是我给你通风报信！";
		next;
		mes "[Laichin]";
		mes "如果我要冒灵魂的风险，就想在被众神干掉前尽情享受余生。伙计，我至少需要 40,000 Zeny 才能过得像样……";
		next;
			switch(select("付给 Laichin 40,000 Zeny:不付给 Laichin。")) {
		case 1:
			if (Zeny < 40000) {
				mes "[Laichin]";
				mes "嘿……这点钱远远不够让我在灵魂被众神毁掉前享受生活。";
				emotion ET_HNG;
				close;
			}
			else {
				mes "[Laichin]";
				mes "这才像话！你是真正的英雄！去古城最深处寻找安格尔波达的灵魂碎片。";
				next;
				set .@select_s,rand(1,5);
				if (.@select_s == 1) {
					mes "[Laichin]";
					mes "查看大 1 点钟、大 5 点钟、大 7 点钟和小 6 点钟方向。";
					next;
				}
				else if (.@select_s == 2) {
					mes "[Laichin]";
					mes "查看大 4 点钟、大 10 点钟、小 6 点钟和很小 11 点钟方向。";
					next;
				}
				else if (.@select_s == 3) {
					mes "[Laichin]";
					mes "查看大 5 点钟、小 11 点钟、小 6 点钟和很小 11 点钟方向。";
					next;
				}
				else if (.@select_s == 4) {
					mes "[Laichin]";
				mes "去看看大 4 点钟方向、大 5 点钟方向、大 10 点钟方向和小 11 点钟方向。";
					next;
				}
				else {
					mes "[Laichin]";
				mes "嘿嘿！";
					close;
				}
				mes "[Laichin]";
			mes "她的灵魂碎片藏得很隐蔽，即使知道大致位置也要仔细寻找。而且别把这些位置告诉别人，否则会有麻烦。";
				next;
			switch(select("我保证。:你说的大和小是什么意思？")) {
				case 1:
					mes "[Laichin]";
					mes "好吧，小子。玩得开心！";
					if (.@select_s == 1) set sign_q,97;
					else if (.@select_s == 2) set sign_q,98;
					else if (.@select_s == 3) set sign_q,99;
					else if (.@select_s == 4) set sign_q,100;
					else {
						mes "[Laichin]";
					mes "嘿嘿！";
						close;
					}
					set Zeny, Zeny-40000;
					close;
				case 2:
					mes "[Laichin]";
				mes "我说的大和小是什么意思？嘿，这个答案至少值……20,000 Zeny。想知道就拿钱来！";
					next;
				switch(select("不付钱。:付钱。")) {
					case 1:
						mes "[Laichin]";
					mes "好，好。你要是找不到灵魂碎片的位置，可别哭着回来！";
						set Zeny, Zeny-40000;
						if (.@select_s == 1) set sign_q,97;
						else if (.@select_s == 2) set sign_q,98;
						else if (.@select_s == 3) set sign_q,99;
						else if (.@select_s == 4) set sign_q,100;
						else {
							mes "[Laichin]";
					mes "嘿嘿嘿嘿~";
							close;
						}
						emotion ET_HNG;
						close;
					case 2:
						if (Zeny < 60000) {
							mes "[Laichin]";
							mes "这是什么？你想赖账吗？";
							emotion ET_HNG;
							close;
						}
						else {
							mes "[Laichin]";
							mes "好，听着。大、小和很小指的是距离地图中心的远近。大就是靠近地图边缘。简单吧？";
							next;
							mes "[Laichin]";
							mes "我说小时，你要在比地图边缘更靠里的区域寻找。很小则要看中心附近。明白了吗？";
							set Zeny, Zeny-60000;
							if (.@select_s == 1) set sign_q,101;
							else if (.@select_s == 2) set sign_q,102;
							else if (.@select_s == 3) set sign_q,103;
							else if (.@select_s == 4) set sign_q,104;
							else {
								mes "[Laichin]";
					mes "呃嘿，嘿嘿嘿！";
								close;
							}
							close;
						}
					}
				}
			}
		case 2:
			mes "[Laichin]";
		mes "嗯……？好吧，朋友。";
			close;
		}
	}
	else if ((sign_q == 97) || (sign_q == 98) || (sign_q == 99) || (sign_q == 100)) {
		mes "哦，对了，关于上次给你的方向？它们有效，但你得知道我说的‘大’或‘小’分别是什么意思。没错……";
		next;
		mes "[Laichin]";
		mes "事实上，我会全都告诉你。就在你付给我……嗯，^FF000020,000 Zeny^000000之后。";
		next;
		switch(select("付钱给他。:不付钱。")) {
		case 1:
			if (Zeny < 20000) {
				mes "[Laichin]";
				mes "这是什么？你想赖账吗？";
				close;
			}
			else {
				mes "[Laichin]";
				mes "好，听着。大、小和很小指的是距离地图中心的远近。大就是靠近地图边缘。简单吧？";
				next;
				mes "[Laichin]";
				mes "我说小时，你要在比地图边缘更靠里的区域寻找。很小则要看中心附近。明白了吗？";
				set Zeny, Zeny-20000;
				if (sign_q == 97) set sign_q,101;
				else if (sign_q == 98) set sign_q,102;
				else if (sign_q == 99) set sign_q,103;
				else if (sign_q == 100) set sign_q,104;
				else {
					mes "[Laichin]";
				mes "哇哈哈哈！";
					close;
				}
				close;

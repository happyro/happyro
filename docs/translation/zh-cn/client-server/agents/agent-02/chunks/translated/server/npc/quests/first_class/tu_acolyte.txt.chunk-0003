	monk_in,103,176,7	script	Karven	1_M_PASTOR,{
	mes "[Karven]";
	mes "愿你";
	if(tu_acolyte01 == 21 && countitem(7183)){
	delitem 7183, 1;// Sister_Letter
	tu_acolyte01 = 22;
	mes "永远安息……";
	next;
	mes "[Karven]";
	
mes "我正在为刚逝去的人祈祷。";
mes "如果不急，请改天再来。";
next;
mes "[Karven]";
mes "一封信？";
mes "哦，一定是我妹妹寄来的。";
	mes "她这次想要什么？";
	next;
	mes "[Karven]";
	mes "希望她能领悟神的教诲，";
	mes "重新过上善良的生活。非常感谢。";
	close;
	}
	mes "安息吧……";
	close;
	}

		mes "天啊！";
		mes "这封信充满了";
		mes "母爱的力量！";
		specialeffect EF_STEELBODY;
		next;
	mes "[Hedrick]";
	mes "太谢谢了！";

mes "来，尝一块她寄给我的";
mes "饼干吧？";
delitem 7148,1; //Mother_Letter
tu_acolyte01 = 20;
	getitem 538,1; //Well_Baked_Cookie
	close;
	}

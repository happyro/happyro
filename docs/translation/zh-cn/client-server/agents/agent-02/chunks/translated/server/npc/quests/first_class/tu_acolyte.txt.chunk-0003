	prt_monk,136,261,0	script	Weapon Merchant#tu	HIDDEN_WARP_NPC,9,9,{
	OnTouch_:
	if(tu_acolyte01 != 20 || countitem(1081) == 0) end;// Merchant_Box_1
	mes "[Weapon Merchant]";
	mes "我向公会订的东西终于到了！";
	mes "这里太偏远，要保持库存可真不容易。";
	next;
	mes "[Weapon Merchant]";
	mes "嘿，太感谢了！";
	mes "以后需要什么就来找我，好吗？";
	delitem 1081,1; //Merchant_Box_1
	tu_acolyte01 = 21;
	close;
	}

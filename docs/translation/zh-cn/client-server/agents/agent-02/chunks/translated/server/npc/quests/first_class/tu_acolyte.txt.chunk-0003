//============================================================
prt_monk,219,164,3	script	Gloria#tu	4_F_SISTER,{
mes "[Gloria]";
if(BaseJob != Job_Acolyte){
mes "嗨，嗨～";
	mes "我叫格洛丽亚。";
	mes "想知道我名字的";
	mes "有趣故事吗？";
		next;
		mes "[Gloria]";
		mes "我父亲是吉芬的铁匠，据说在我出生那天完成了一件惊人的武器。";
		mes "他觉得这是好运的征兆，";
		mes "所以就用我的名字给武器命名！";
		next;
		mes "[Gloria]";
		mes "知道有武器以自己命名确实有点奇怪，";
		mes "不过我非常喜欢自己的名字。父母总不可能是因为那件武器才给我取名吧？";
		close;
		}
		if(tu_acolyte01 > 0 && tu_acolyte01 < 25){
		mes "我还是个正在训练的年轻服事，";
		mes "总是犯错！";
		next;
		mes "[Gloria]";
		mes "^333333*Sniff*^000000";
		mes "而且几乎一直被训斥……";
		mes "不过有一件事我做得非常好！";
		next;
		mes "[Gloria]";
		mes "传送门！";
		mes "我会二级传送门！";
	mes "我的一个记录点在这里，";
	mes "另一个在普隆德拉。";
	next;

mes "[Gloria]";
mes "总之，只要你需要，";
mes "我就能把你送到普隆德拉。";
mes "告诉我一声就好，好吗？";
	next;
	switch(select("I'm okay for now.:Send me to Prontera.")){
		case 1:
		mes "[Gloria]";
		mes "使用传送门需要一颗^3131FF蓝色宝石^000000。";
		mes "这是要帮我吗？";
		mes "哇，我好感动！";
		emotion ET_CRY;
		close;
		case 2:
		mes "[Gloria]";
		mes "交给我吧！";
		mes "开始咯～！！";
		mes "传、传送门！";
		close2;
		warp "prontera",116,72;
		end;
	}
	}
		mes "哇……";
		mes "你都是从阿斯特那里学的吗？太厉害了……";
		mes "你一定比我强多了，我都不好意思再炫耀把人传送到普隆德拉了。^333333*抽泣*^000000";
		close;
		}


// =============================================================================
// = Miscellaneous NPCS
// =============================================================================

// - Wedding Secretary
// - Teaches the player about in-game Marriage & Adoption mechanics.
// -----------------------------------------------------------------------------
izlude,102,150,5	script	Wedding Secretary#iz	1_F_LIBRARYGIRL,{
	if (Class == Job_Novice) {
		mes "[Wedding Secretary]";
		mes "你只是个新手。";
		next;
		mes "[Wedding Secretary]";
		mes "一切看起来都新鲜又陌生，对吧？是不是很令人兴奋？";
		next;
		mes "[Wedding Secretary]";
		mes "人生还有什么比婚姻更令人兴奋的开始呢？";
		next;
	} else {
		mes "[Wedding Secretary]";
		mes "你恋爱了吗？";
		next;
	}
	mes "[Wedding Secretary]";
	mes "我是婚礼秘书，为想与他人共度一生的人服务。";
	next;
	while(1) {
		mes "[Wedding Secretary]";
		mes "关于婚姻有什么担心的事，尽管问吧！";
		next;
		switch(select("如何结婚。", "婚姻的好处", "收养", "闭嘴！")) {
		case 1:
			mes "[Wedding Secretary]";
		mes "为恋人举行婚礼，确实是人生中最美丽、最特别的事件。";
			next;
			mes "[Wedding Secretary]";
		mes "不过，结婚需要完成一些手续。";
			next;
			mes "[Wedding Secretary]";
		mes "首先，想结婚的双方基础等级必须达到^0000cd45^000000以上，也就是要有能力负责自己的生活和财务。";
			next;
			mes "[Wedding Secretary]";
		mes "接着要准备感谢的象征。男方需要^0000cd礼服^000000，女方需要^0000cd婚纱^000000，双方都要有作为永恒爱情象征的^0000cd钻石戒指^000000。";
			next;
			mes "[Wedding Secretary]";
		mes "还需要支付^0000cd100万Zeny^000000的费用。";
			next;
			mes "[Wedding Secretary]";
		mes "准备好这些后，只组建两人的队伍，前往^0000cd普隆德拉大教堂^000000。";
			next;
			mes "[Wedding Secretary]";
		mes "那里有另一位像我一样的^0000cd婚礼秘书^000000等着你。和她交谈，她会告诉你更多细节。";
			next;
			mes "[Wedding Secretary]";
		mes "希望你能遇到优秀的伴侣，享受幸福婚姻！";
			next;
			break;
		case 2:
			mes "[Wedding Secretary]";
		mes "婚姻最重要的好处，就是永远在一起！";
			next;
			mes "[Wedding Secretary]";
		mes "婚礼后，你们可以在专属于你们的^0000cdJawaii^000000度假地享受甜蜜蜜月。";
			next;
			mes "[Wedding Secretary]";
		mes "结婚后，双方都会获得^0000cd特殊技能^000000。";
			next;
			mes "[Wedding Secretary]";
		mes "其中两个技能叫^0000cd爱的触摸^000000和^0000cd不灭的爱^000000，能牺牲HP或SP传给伴侣。";
			next;
			mes "[Wedding Secretary]";
		mes "其中^0000cd浪漫约会^000000最浪漫，可以从世界任何地方召唤伴侣到身边。";
			next;
			mes "[Wedding Secretary]";
		mes "这些技能很棒吧？你现在想结婚吗？";
			next;
			break;
		case 3:
			mes "[Wedding Secretary]";
		mes "在一起很美好，但没有经历过的人无法理解成为父母的全部幸福。";
			next;
			mes "[Wedding Secretary]";
		mes "已婚夫妇可以收养其他角色作为孩子。";
			next;
			mes "[Wedding Secretary]";
			mes "^0000cd跆拳男/女、枪手或忍者等扩展职业的角色不能被收养。^000000";
			next;
			mes "[Wedding Secretary]";
		mes "准备成为父母的双方基础等级必须达到^0000cd70^000000，才有资格承担父母的责任。";
			next;
			mes "[Wedding Secretary]";
		mes "组建家庭后，可以获得^0000cd家庭成员之间使用的技能^000000。";
			next;
			mes "[Wedding Secretary]";
		mes "还有其他技能可以巩固羁绊，例如想念孩子时召唤他们，或战斗死亡时不损失已获得的等级。";
			next;
			mes "[Wedding Secretary]";
		mes "孩子带来的可爱魅力也是额外奖励～";
			next;
			break;
		case 4:
			emotion ET_HUK;
			mes "[Wedding Secretary]";
		mes "你妈妈没教好你吗？";
		mes "真可怜，你完全不懂爱情的美好！！！";
			close;
		}
	}
}

izlude_a,102,150,5	duplicate(Wedding Secretary#iz)	Wedding Secretary#iz_a	1_F_LIBRARYGIRL
izlude_b,102,150,5	duplicate(Wedding Secretary#iz)	Wedding Secretary#iz_b	1_F_LIBRARYGIRL
izlude_c,102,150,5	duplicate(Wedding Secretary#iz)	Wedding Secretary#iz_c	1_F_LIBRARYGIRL
izlude_d,102,150,5	duplicate(Wedding Secretary#iz)	Wedding Secretary#iz_d	1_F_LIBRARYGIRL

// - Mom
// -----------------------------------------------------------------------------
izlude,95,146,5	script	Mom#iz	4_F_CAVE1,{
	mes "[Mom]";
	mes "亲爱的～～～";
	next;
	mes "[Dad]";
	mes "嗯～～";
	next;
	mes "[Mom]";
	mes "你看到Etinifni在后院玩吗？";
	next;
	mes "[Dad]";
	mes "没有～～";
	next;
	emotion ET_FRET;
	mes "[Mom]";
	mes "他又出去了？从来不待在家里！！我要用它吗？";
	next;
	mes "[Dad]";
	mes "别管他～他可能在某处玩。";
	next;
	emotion ET_FRET;
	mes "[Mom]";
	mes "你太宠他了！";
	next;
	mes "[Mom]";
	mes "^0000cd[到我这里来，亲爱的~]^000000";
	next;
	enablenpc "Etinifni#"+strnpcinfo(2);
	specialeffect EF_PORTAL, AREA, "Etinifni#"+strnpcinfo(2);
	mes "[Etinifni]";
	mes "怎么了？我在哪里？";
	next;
	mes "[Mom]";
	mes "这里！";
	next;
	emotion ET_ANGER, getnpcid(0, "Etinifni#"+strnpcinfo(2));
	mes "[Etinifni]";
	mes "啊……又来了！！我刚才在外面猎杀兽人。";
	next;
	mes "[Mom]";
	mes "我说过别去猎杀！去给我们买牛奶！";
	next;
	mes "[Etinifni]";
	mes "为什么我只是你的跑腿？去，给我找个弟弟！";
	next;
	mes "[Mom]";
	mes "什么？这个笨蛋？！";
	next;
	emotion ET_OHNO, getnpcid(0, "Etinifni#"+strnpcinfo(2));
	mes "[Etinifni]";
	mes "好吧。我会做的。";
	next;
	disablenpc "Etinifni#"+strnpcinfo(2);
	emotion ET_CRY, getnpcid(0, "Dad#"+strnpcinfo(2));
	mes "[Dad]";
	mes "对不起……爸爸斗不过你的妈妈。";
	close;
}

izlude_a,95,146,5	duplicate(Mom#iz)	Mom#iz_a	4_F_CAVE1
izlude_b,95,146,5	duplicate(Mom#iz)	Mom#iz_b	4_F_CAVE1
izlude_c,95,146,5	duplicate(Mom#iz)	Mom#iz_c	4_F_CAVE1
izlude_d,95,146,5	duplicate(Mom#iz)	Mom#iz_d	4_F_CAVE1

// - Dad
// -----------------------------------------------------------------------------
izlude,97,147,3	script	Dad#iz	1_M_JOBGUIDER,{
	mes "[Dad]";
	mes "多年没有孩子后，我们十年前得到了这个男孩。";
	next;
	mes "[Dad]";
	mes "他是我的掌上明珠，但我妻子对他太严格。";
	next;
	mes "[Dad]";
	mes "所以我总担心这个独子会被宠坏。";
	next;
	mes "[Dad]";
	mes "也许所有父母都会担心吧？";
	close;
}


// - Otter Samssoon
// - Allows the player to change their hair style and color once.
// -----------------------------------------------------------------------------
iz_ac01,69,36,3	script	Otter Samssoon#ac	4W_SAILOR,{
	mes "[Otter Samssoon]";
	mes "欢迎～";
	mes "我是Samssoon～！我是被派到学院的皇家水獭发型设计师。";
	next;
	mes "[Otter Samssoon]";
	mes "拿着^ff0000Criatura发型优惠券^000000，就能免费改变发型！不要错过这^ff0000一生一次^000000的机会～";
	next;
	switch(select("阅读发型手册。", "改变发型。", "如何获得优惠券", "停止。")) {
		case 1:
			mes "[Otter Samssoon]";
			mes "哦～我相信任何发型都适合你！你真有品味～";
			mes "有很多发型，请从^ff0000第1页到第19页^000000选择。";
			mes "想停止就输入0。";
			next;
			input .@style;
			if (.@style > 19) {
				mes "[Otter Samssoon]";
				mes "哦，天啊！！？亲爱的～你可以用优惠券选择这里的发型～";
				close;
			} else if (!.@style) {
				mes "[Otter Samssoon]";
				mes "决定了吗？哪种发型？";
				mes "我想亲手摸摸你的头发～亲爱的～";
				close;
			} else {
				callsub L_cutin, .@style;
				mes "[Otter Samssoon]";
				switch(.@style) {
				case 1:
					if (Sex == SEX_MALE) {
						mes "哦，天啊！！？‘装死’发型？";
						mes "整洁又放松……很流行的发型。";
					} else {
						mes "哦，天啊！！？‘急救’发型？";
						mes "真是可爱的发型。";
						mes "我想也很适合你！！";
					}
					break;
				case 2:
					if (Sex == SEX_MALE) {
						mes "哦，天啊！！？‘双手剑熟练度’发型？";
						mes "你……知道那位著名的D吗？他就是这个发型！";
					} else {
						mes "哦，天啊！！？‘狂击’发型？";
						mes "这个发型让两侧头发卷得很有力。";
					}
					break;
				case 3:
					if (Sex == SEX_MALE) {
						mes "哦，天啊！！？‘心灵爆破’发型？";
						mes "整齐的发际线让人感觉充满魅力。";
					} else {
						mes "哦，天啊！！？‘冰冻术’发型？";
						mes "神秘的发型，同时带来冷峻与温暖的感觉。";
					}
					break;
				case 4:
					if (Sex == SEX_MALE) {
						mes "哦，天啊！！？‘二连矢’发型？";
						mes "自然的头发随风摇曳……整洁又舒服。";
					} else {
						mes "哦，天啊！！？‘箭雨’发型？";
						mes "帅气漂亮的层次短发，造型很好。";
					}
					break;
				case 5:
					if (Sex == SEX_MALE) {
						mes "哦，天啊！！？‘天使之赐福’发型？";
						mes "平静又虔诚……一点也不无聊。";
					} else {
						mes "哦，天啊！！？‘治愈术’发型？";
						mes "女性化的发型带来治愈感。";
					}
					break;
				case 6:
					if (Sex == SEX_MALE) {
						mes "哦，天啊！！？‘手推车’发型？";
						mes "Big Kar被这个充满男人浪漫的发型激励了。";
					} else {
						mes "哦，天啊！！？‘露天商店’发型？";
						mes "王室女士喜欢这个发型。是能赚大钱的发型。";
					}
					break;
				case 7:
					if (Sex == SEX_MALE) {
						mes "哦，天啊！！？‘施毒’发型？";
						mes "强悍的发型让人上瘾。";
					} else {
						mes "哦，天啊！！？‘二刀连击’发型？";
						mes "任何人都会为这个发型冲刺两次。";
						mes "马尾很重要。";
					}
					break;
				case 8:
					if (Sex == SEX_MALE) {
						mes "哦，天啊！！？‘怪物互击’发型？";
						mes "这个发型让帅哥更有挑战感。";
						mes "只需一眼就能偷走人心。";
					} else {
						mes "哦，天啊！！？‘荣耀之歌’发型？";
						mes "这个发型极其华丽优雅。";
					}
					break;
				case 9:
					if (Sex == SEX_MALE) {
						mes "哦，天啊！！？‘毒雾’发型？";

// - Romantic Male
// -----------------------------------------------------------------------------
izlude,99,138,3	script	Romantic Male#iz	4_M_SITDOWN,{
	emotion ET_DELIGHT;
	mes "[Romantic Male]";
	mes "一起走吧～～手牵着手～～抛开一切～～在Jawaii深蓝的夜空下～～星光之中～～";
	next;
	mes "[Romantic Male]";
	mes "我们要去Jawaii蜜月胜地，庆祝结婚10周年！";
	next;
	emotion ET_THROB;
	mes "[Romantic Male]";
	mes "租用我的婚纱和你的礼服，重温美好回忆！！这会加深我们的感情，对吧？";
	next;
	specialeffect EF_HEARTCASTING, AREA, "Romantic Female#"+strnpcinfo(2);
	emotion ET_CHUP, getnpcid(0, "Romantic Female#"+strnpcinfo(2));
	mes "[Romantic Male]";
	mes "亲爱的～～我爱你！！甜心～";
	next;
	emotion ET_CHUPCHUP;
	mes "[Romantic Male]";
	mes "不！！我比你更爱你！！";
	close;
}

izlude_a,99,138,3	duplicate(Romantic Male#iz)	Romantic Male#iz_a	4_M_SITDOWN
izlude_b,99,138,3	duplicate(Romantic Male#iz)	Romantic Male#iz_b	4_M_SITDOWN
izlude_c,99,138,3	duplicate(Romantic Male#iz)	Romantic Male#iz_c	4_M_SITDOWN
izlude_d,99,138,3	duplicate(Romantic Male#iz)	Romantic Male#iz_d	4_M_SITDOWN

// - Romantic Female
// -----------------------------------------------------------------------------
izlude,97,138,5	script	Romantic Female#iz	4_F_SITDOWN,{
	mes "[Romantic Female]";
	mes "想念我时就这样喊，亲爱的！！";
	next;
	emotion ET_THROB, getnpcid(0, "Romantic Female#"+strnpcinfo(2));
	mes "[Romantic Female]";
	mes "^0000cd[我想你。]^000000";
	next;
	mes "[Romantic Female]";
	mes "然后你会抛下一切向我跑来，对吧～？";
	next;
	mes "[Romantic Female]";
	mes "你呼唤我，我一定会去！！";
	next;
	mes "[Romantic Female]";
	mes "你坐累了吧？";
	next;
	specialeffect EF_HEARTCASTING, AREA, "Romantic Female#"+strnpcinfo(2);
	emotion ET_CHUP, getnpcid(0, "Romantic Female#"+strnpcinfo(2));
	mes "[Romantic Female]";
	mes "我的甜心！！！我爱你！！！";
	next;
	mes "[Romantic Male]";
	mes "是的，谢谢你分享SP！你也累了吧？";
	next;
	specialeffect EF_HEARTCASTING, AREA, "Romantic Male#"+strnpcinfo(2);
	emotion ET_CHUPCHUP, getnpcid(0, "Romantic Male#"+strnpcinfo(2));
	mes "[Romantic Male]";
	mes "我的甜心！！我爱你！！！";
	next;
	emotion ET_THROB, getnpcid(0, "Romantic Female#"+strnpcinfo(2));
	mes "[Romantic Female]";
	mes "呀～你最酷了！！！";
	close;
}


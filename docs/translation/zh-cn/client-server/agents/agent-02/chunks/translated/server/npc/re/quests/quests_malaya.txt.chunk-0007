	.@playtime = checkquest(7390, PLAYTIME);
	if (.@playtime == 0 || .@playtime == 1) {
		mes "[玛丽丝]";
		mes "孩子们知道用里外穿的衬衫就能回家后，";
		mes "就毫无顾忌、没日没夜地在森林里玩。";
		next;
		mes "[玛丽丝]";
		mes "照这样下去，孩子们肯定又会迷路。";
		mes "如果再次发生，我还会来找你帮忙。";
		close;
	} else if (.@playtime == 2) {
		mes "[玛丽丝]";
		mes "又有一个孩子不见了……";
		mes "天啊……";
		erasequest 7390;
		close;
	} else {
		if (checkquest(7389) != -1) {
		mes "[玛丽丝]";
		mes "你回来了。";
		mes "多亏你，孩子平安回家了。";
			next;
		mes "[玛丽丝]";
		mes "虽然衬衫是里外穿的，却能奇迹般地把他们带回该去的地方。";
		mes "谢谢你把珍贵的衬衫送给我的孩子们。";
			setquest 7390;
			erasequest 7389;
			if (!VIP_SCRIPT || vip_status(VIP_STATUS_ACTIVE))
				getitem 6497, 2; // Lesser_Agimat
			else
				getitem 6497, 1; // Lesser_Agimat
			getexp 200000,200000;
			if (!rand(3))
				$malayaNames$[2] = strcharinfo(0);
			close;
		} else {
			if (checkquest(7388) != -1) {
				mes "[玛丽丝]";
				mes "我确定他们是因为淘气的灵魂而在森林里迷路了。";
				mes "找到孩子后，请把^4d4dff里外穿的衬衫^000000交给他。";
				next;
				mes "[玛丽丝]";
				mes "里外穿的衬衫……";
				mes "恶魔带着它们逃走了，你大概可以从恶魔那里得到。";
				close;
			} else {
				mes "[玛丽丝]";
				mes "你好……我在找我的孩子……";
				mes "我的女儿没有回来。";
				mes "请帮帮我，我想她在森林里迷路了。";
				next;
				switch (select("当然。：我现在太忙了。：你有好多孩子。")) {
				case 1:
					mes "[玛丽丝]";
					mes "我确定她是因为淘气的灵魂而在森林里迷路了。";
					next;
					mes "[玛丽丝]";
					mes "如果她被诅咒了，就很难把她带出来。";
					mes "她会在迷宫里四处游荡，那里的景象甚至会让你着迷。";
					next;
					mes "[玛丽丝]";
					mes "找到一件^4d4dff里外穿的衬衫^000000，交给我的女儿。";
					mes "虽然衬衫是里外穿的，却能奇迹般地把他们带回该去的地方。";
					next;
					mes "[Maries]";
				mes "里外穿的衬衫……";
				mes "恶魔带着它们逃走了，你大概可以从恶魔那里得到。";
					setquest 7388;
					close;
				case 2:
					mes "[Maries]";
					mes "……是的……我明白了。";
				mes "我得去问别人。";
				mes "好吧。";
				mes "唉……";
					close;
				case 3:
					mes "[Maries]";
					mes "……最后我生了三胞胎。";
				mes "连我有时也会搞混。（轻笑）";
					next;
					mes "[Maries]";
				mes "她们似乎被诅咒了，因为其中一个总是在森林里迷路……";
				mes "唉……";
					close;
				}
			}
		}
	}
	end;
}

ma_fild01,203,189,3	script	Little Girl#malaya	576,{
	mes "[Little Girl]";
	mes "嘿嘿，森林虽然可怕，但很好玩，所以我经常去那里玩～";
	mes "奇怪，我们总是会迷路。";
	next;
	mes "[Little Girl]";
	mes "不过没关系，因为不是只有我会迷路～";
	mes "我们是三胞胎～另外两个不见了～嘻嘻～";
	close;
}

ma_fild01,251,93,3	script	Lost Child#malaya01	576,{
	if (checkquest(7388) > -1) {
		if (!countitem(12700)) {
			mes "[Little Kid]";
			mes "唉。你也迷路了吗？";
			mes "他们真调皮。";
			next;
			mes "[Little Kid]";
			mes "我正需要一件里外穿的衬衫。";
			mes "（轻笑）……";
			close;
		}
		mes "[Little Kid]";
		mes "哦，真讨厌。";
		mes "他们一定又骗我迷路了！";
		next;
		select ("Do you want to go home?");
		mes "[Little Kid]";
		mes "如果我不快点回去，妈妈会担心死的。";
		mes "唉……真希望有一件里外穿的衬衫可以回家。";
		next;
		select ("Here you are.");
		mes "[Little Kid]";
		mes "真的吗？";
		mes "真的是那件衬衫！";
		mes "它会直接把我带回家！";
		next;
		mes "[Little Kid]";
		mes "妈妈派你来的吗？";
		mes "她一定很担心……！";
		mes "我现在就回家！";
		mes "非常感谢！";
		delitem 12700, 1; // Insideout_Shirt
		setquest 7389;
		erasequest 7388;
		close2;
		disablenpc();
		if (strnpcinfo(0) == "Lost Child#malaya01") {
			enablenpc "Lost Child#malaya02";
		} else if (strnpcinfo(0) == "Lost Child#malaya01") {
			enablenpc "Lost Child#malaya03";
		} else {
			enablenpc "Lost Child#malaya01";
		}
		end;
	} else {
		if (checkquest(7389) != -1) {
			mes "[Little Kid]";
			mes "我还想再玩一会儿。";
			mes "有这件衬衫，我随时都能回家。";
			mes "妈妈不会担心的。";
			close;
		} else {
			mes "[Little Kid]";
			mes "嗯。我又迷路了吗？";
			mes "我在哪里……";
			mes "我确定从第三棵树朝日出的方向走就能回家……嗯？";
			next;
			mes "[Little Kid]";
			mes "为什么～我总是在这里绕圈子？";
			mes "你知道为什么吗，" + ((Sex == SEX_MALE) ? "先生" : "女士") + "？";
			mes "这条路是怎么回事？";
			mes "有人想骗我吗？";
			close;
		}
	}
	end;
	
OnInit:
	if (strnpcinfo(0) != "Lost Child#malaya01")
		disablenpc();
}
ma_fild01,114,141,3	duplicate(Lost Child#malaya01)	Lost Child#malaya02	576
ma_fild01,130,314,3	duplicate(Lost Child#malaya01)	Lost Child#malaya03	576

ma_fild02,241,39,5	script	Good Capre Budidai	572,{
	mes "[Budidai]";
	mes "嘿嘿嘿～";
	mes "我是只很棒的卡普雷～嘿！";
	mes "我要去一家很棒的咖啡馆～哟！";
	mes "我比昨天更棒～嘿！";
	mes "我是押韵很棒的卡普雷～哦？";
	next;
	mes "[Budidai]";
	mes "嘿，朋友，你是来听布达代唱歌的吗？";
	next;
	switch (select("你喜欢歌吗？：关于独眼怪物的深度研究。：再见！")) {
	case 1:
		mes "[Budidai]";
		mes "没错，布达代喜欢唱歌。";
		mes "牛、马、山羊、公鸡和野猪都喜欢我的歌。";
		mes "它们都是朋友。";
		next;
		mes "[Budidai]";
		mes "除了那只独眼的邦吉松吉。";
		mes "它总是欺负我的朋友。";
		mes "我很生气，但布达代很弱。";
		next;
		mes "[Budidai]";
		mes "我害怕它的独眼凝视，但更害怕它挥舞的棍棒。";
		mes "我想给朋友们唱歌，但它在这里，它们都不敢来。";
		next;
		mes "[Budidai]";
		mes "所以布达代就在这里唱歌。";
		mes "很多旅行者会经过。";
		mes "卡普雷是旅行者的伙伴。";
		mes "你也是伙伴。";
		close;
	case 2:
		if (BaseLevel < 100) {
			mes "[Budidai]";
		mes "朋友，你对那个恶棍感兴趣吗？";
		mes "它只是森林里的恶霸！";
		mes "它总是欺负我的动物朋友！";
			next;
			mes "[Budidai]";
		mes "可惜布达代只擅长唱歌。";
		mes "我对那可怕的凝视和挥舞的棍棒无能为力。";
			next;
			mes "[Budidai]";
		mes "邦吉松吉！光是和它待在同一片森林里，我就发抖……";
		mes "但布达代很弱。";
			next;
			mes "[Budidai]";
		mes "旅行者，你和我都不行。";
		mes "我们永远赢不了。";
			close;
		}
		.@playtime = checkquest(7410, PLAYTIME);
		if (.@playtime == 0 || .@playtime == 1) {
			mes "[Budidai]";
			mes "旅行者，我的朋友！";
			mes "邦吉松吉跑得很远很远。";
			mes "狗、牛、马、山羊和公鸡会回到我身边，对吧？";
			next;
			mes "[Budidai]";
			mes "但布达代很担心。";
			mes "那个独眼恶霸最终会回来的。";
			mes "你能再帮我一次吗？";
			next;
			mes "[Budidai]";
			mes "你，布达代的朋友，";
			mes "不会对一只善良的卡普雷见死不救吧？";
			close;
		} else {
			if (checkquest(7409) != -1) {
				if (checkquest(7409, HUNTING) == 2) {
					mes "[Budidai]";
					mes "太惊人了，旅行者！";
					mes "我在这里都能听到邦吉松吉可怜的哀嚎！";
					mes "布达代又能为朋友们唱歌了，对吧？";
					next;
					mes "[Budidai]";
					mes "那么，布达代能为善良的旅行者、独眼怪物的杀手做什么？";
					mes "啊哈！这里有一张护身符。";
					mes "对旅行者来说会很有用。";
					next;
					mes "[Budidai]";
					mes "善良的卡普雷是旅行者的朋友。";
					mes "希望再次见到你，旅行者。";
					mes "这是给朋友的祝福。嘿嘿嘿～";
					setquest 7410;
					erasequest 7409;
					if (!VIP_SCRIPT || vip_status(VIP_STATUS_ACTIVE))
						getitem 6497, 2; // Lesser_Agimat
					else
						getitem 6497, 1; // Lesser_Agimat
					getexp 200000,200000;
					if (!rand(3))
						$malayaNames$[1] = strcharinfo(0);
					close;
				} else {
					mes "[Budidai]";
					mes "请消灭破坏性的放荡者邦吉松吉。";
					mes "这样我这只卡普雷就能再次为朋友唱歌。";
					close;
				}
			} else {
				if (.@playtime == 2) {
					mes "[Budidai]";
					mes "嘿，善良的旅行者。";
					mes "独眼放荡者邦吉松吉回来了！";
					mes "我该怎么办？我该做什么？";
					next;
					mes "[Budidai]";
					mes "我唱歌时它会生气。";
					mes "但马、牛、山羊、狗和野猪都喜欢。";
					mes "这让布达代很为难。";
					erasequest 7410;
					close;
				} else {
					mes "[Budidai]";
					mes "朋友，你对那个恶棍感兴趣吗？";
					mes "它只是森林里的恶霸！";
					mes "它总是欺负我的动物朋友！";
					next;
					mes "[Budidai]";
					mes "可惜布达代只擅长唱歌。";
					mes "我对那可怕的凝视和挥舞的棍棒无能为力。";
					next;
					mes "[Budidai]";
					mes "邦吉松吉！光是和它待在同一片森林里，我就发抖……";
					mes "但布达代很弱。";
					next;
					if (select("要我处理它吗？：光想就发抖。") == 2) {
						mes "[布达代]";
						mes "别提醒我。";
						mes "因为那个庞然大物，我的朋友不能来听我唱歌。";
						mes "真让人沮丧。";
						close;
					}
					mes "[布达代]";
					mes "你要教训邦吉松吉？！";
					mes "善良的旅行者！！";
					mes "狠狠教训那个放荡者！！";
					setquest 7409;
					close;
				}
			}
		}
		break;
	case 3:
		mes "[布达代]";
		mes "离开我吧，旅行者～";
		mes "卡普雷布达代会歌唱奇迹～";
		mes "你胜过所有人～";
		mes "你带来了所有野兽～";
		mes "回卡普拉那里去吧～";
		next;
		mes "[布达代]";
		mes "嘿嘿嘿～";
		mes "善良优秀卡普雷的祝福～";
		mes "旅行者朋友的卡普雷礼物～";
		mes "嘿嘿嘿～";
		close;
	}
	end;
}

// Traders :: malaya_npc
//============================================================
ma_fild01,166,214,6	script	Old Man in Dilemma#GA	575,{
	if (MaxWeight - Weight < 600 || checkweight(1201,1) == 0) {
		mes "你持有的物品太多，无法继续。";
		close;
	}
	mes "[陷入困境的老人]";
	mes "哦！恶魔在这个世界的力量越来越强了。";
	next;
	switch(select("我们需要收集物品对抗它们。：忽略。")) {
	case 1:
		if (countitem(6497) >= 3 && Zeny >= 1000) {
			mes "[陷入困境的老人]";
			mes "你似乎还不够强，无法对抗恶魔。";
			next;
			mes "[陷入困境的老人]";
			mes "要用3个小型古代灵魂护符和1000 Zeny制作大型古代灵魂护符吗？";
			next;
			if(select("制作。：不用了，谢谢。") == 1) {
				if (countitem(6497) >= 3 && Zeny >= 1000) {
					specialeffect2 EF_CONE;
					specialeffect EF_FORESTLIGHT2;
					set Zeny, Zeny-1000;
					delitem 6497,3; //Lesser_Agimat
					getitem 12775,1; //Ancient_Spirit_Agimat
				} else {
					mes "[陷入困境的老人]";
					mes "材料不足。";
					close;
				}
			}
			mes "[陷入困境的老人]";
			mes "希望你能战胜恶魔。";
			close;
		}
		mes "[陷入困境的老人]";
		mes "现在做不了，但有一种代代相传的古老制作方法。";
		next;
		mes "[陷入困境的老人]";
		mes "你需要借助古代灵魂的力量。但首先要准备几种重要材料。";
		next;
		select("是什么？" );
		mes "[陷入困境的老人]";
		mes "3个小型古代灵魂护符，用来承载古代灵魂的力量，以及另一种代代相传的特殊材料。";
		next;
		mes "[陷入困境的老人]";
		mes "但现在没人能再得到这种特殊物品。";
		next;
		select("金钱买不到的东西？" );
		mes "[陷入困境的老人]";
		mes "不，不……是这个圆圆的小东西，看到了吗？";
		next;
		select("你说的是 Zeny？" );
		mes "[陷入困境的老人]";
		mes "它看起来和代代相传的特殊物品很相似。";
		next;
		mes "[陷入困境的老人]";
		mes "只要有足够的 Zeny，我们就能制作大型古代灵魂护符来对抗恶魔。";
		next;
		select("听起来不错。" );
		mes "[陷入困境的老人]";
		mes "如果你太疲惫，无法对抗恶魔……";
		next;
		mes "[陷入困境的老人]";
		mes "带3个小型古代灵魂护符和1000个所谓的 Zeny 来。";
		next;
		mes "[陷入困境的老人]";
		mes "我会制作大型古代灵魂护符，使你对恶魔的攻击力提高10%，持续20分钟。";
		close;
	case 2:
		mes "[陷入困境的老人]";
		mes "希望你能战胜恶魔。";
		close;
	}
}

ma_fild01,238,198,4	script	Tikbalang Expert#malaya	582,{
	if (MaxWeight - Weight < 50 || checkweight(1201,1) == 0) {
		mes "你持有的物品太多，无法继续。";
		close;
	}
	mes "[玩偶专家]";
	mes "我一生90%的时间都在研究玩偶。";
	next;
	switch(select("但你看起来很年轻？：什么是玩偶？：教我如何捕捉玩偶。")) {
	case 1:
		mes "[玩偶专家]";
		mes "什么！可能是我想多了。";
		next;
		mes "[玩偶专家]";
		mes "我因为长着娃娃脸，所以看起来比实际年龄年轻。哈哈哈～";
		next;
		select("…… …… ……" );
		mes "[玩偶专家]";
		mes "相信我！！据说信念会带来好运。";
		close;
	case 2:
		mes "[玩偶专家]";
		mes "哈哈……你问得好。";
		mes "我是这个领域的专家，什么都可以问我。";
		next;
		select("你为什么不回答我？" );
		mes "[玩偶专家]";
		mes "你……曾被身边的人骗过吗？为什么不能相信别人说的话？真的，什么都可以问。";
		next;
		while(1) {
			switch(select("我没有问题。：特征？：外貌？：传闻？：栖息地？")) {
			case 1:
				mes "[玩偶专家]";
				mes "现在解释这些就够了。其他高度专业、术语复杂的话题，你也听不懂。";
				next;
				mes "[玩偶专家]";
				mes "哦！你还有其他问题吗？";
				next;
				mes "[玩偶专家]";
				mes "怎么样？对我的博学印象深刻吗？还有问题随时来找我。";
				close;
			case 2:
				mes "[玩偶专家]";
				mes "玩偶会在遇到旅行者时迷惑他们，让他们无论走到哪里、走多远都不停绕圈。";
				next;
				mes "[玩偶专家]";
				mes "它们是调皮的生物。";
				next;
				mes "[玩偶专家]";
				mes "当然有办法阻止它们恶作剧。你知道里外穿的衬衫吗？也可以把上衣里外反穿。";
				next;
				mes "[玩偶专家]";
				mes "或者安静地走自己的路，不要打扰玩偶。";
				next;
				mes "[玩偶专家]";
				mes "哈哈哈哈～但大家都知道冒险者旅行时从来不会安静，对吧？";
				next;
				mes "[玩偶专家]";
				mes "从来不会……";
				break;
			case 3:
				mes "[玩偶专家]";
				mes "据说玩偶有几个显著特征。";
				next;
				mes "[玩偶专家]";
				mes "第一，它们非常高^AAAAAA（啧……真希望我也这么高）^000000，四肢纤细且比例失衡。看起来几乎像人类，但坐下时膝盖比上半身还高。";
				next;
				mes "[玩偶专家]";
				mes "第二，这是协会认可的标准特征。它们有马一样的头和脚。";
				next;
				mes "[玩偶专家]";
				mes "由于这些外貌特征，玩偶有时也被称为来自地狱的生物。";
				break;
			case 4:
				mes "[玩偶专家]";

OnTouch_:
	set .@sub$,callfunc("F_Okolnir");
	sc_end SC_Stone;
	setarray .@n, 108,151,107,135,113,114,158,106,163,133,150,154;
	for (set .@i, 0; .@i < getarraysize(.@n); set .@i, .@i + 2)
		warp "que_q"+.@sub$,.@n[.@i],.@n[.@i+1];
	for (set .@i, 1; .@i <= 6; set .@i, .@i + 1)
		disablenpc "#"+.@sub$+"_cage0"+.@i;
	end;
	
OnInit:
	set .@sub$,callfunc("F_Okolnir");
	for (set .@i, 1; .@i <= 6; set .@i, .@i + 1)
		disablenpc "#"+.@sub$+"_cage0"+.@i;
	end;

	set .@sub$,callfunc("F_Okolnir");
	donpcevent "#getspell04_"+.@sub$+"::OnDisable";
	donpcevent "#getspell05_"+.@sub$+"::OnEnable";
	end;

OnTimer50000:
	set .@sub$,callfunc("F_Okolnir");
	donpcevent "#getspell05_"+.@sub$+"::OnDisable";


OnDisable:
	set .@sub$,callfunc("F_Okolnir");
	disablenpc "#event_start01_"+.@sub$;
	stopnpctimer;
	end;

OnTouch_:
	initnpctimer;
	set .@sub$,callfunc("F_Okolnir");
	disablenpc "#event_start01_"+.@sub$;
	end;

OnTimer2000:
	set .@sub$,callfunc("F_Okolnir");
	mapannounce "que_q"+.@sub$,"皮亚梅特喃喃自语：……有六只鸟，特奥。但其中一只是……",bc_map,"0xdb7093";
	end;

OnTimer6000:
	set .@sub$,callfunc("F_Okolnir");
	mapannounce "que_q"+.@sub$,"皮亚梅特喃喃自语：……嘘……特奥。鸟儿回来了……是之前逃走的鸟吗……？还是伪装成善良冒险者的破坏者？",bc_map,"0xdb7093";
	end;

OnTimer10000:
	set .@sub$,callfunc("F_Okolnir");
	mapannounce "que_q"+.@sub$,"皮亚梅特喃喃自语：哈！它们被关进笼子了。",bc_map,"0xdb7093";
	end;

OnTimer14000:
	set .@sub$,callfunc("F_Okolnir");
	mapannounce "que_q"+.@sub$,"皮亚梅特：特奥，抓住鸟儿！把笼子带离这里！",bc_map,"0x00ff00";
	donpcevent "#gdtimer01_"+.@sub$+"::OnEnable";
	stopnpctimer;
	end;
	
OnInit:
	set .@sub$,callfunc("F_Okolnir");
	disablenpc "#event_start01_"+.@sub$;
	end;
}

//===== rAthena Script ======================================= 
//= Advance Class jobchanger after kRO Normals.
//===== By: ==================================================
//= Nana
//= finished, optimized and tested by Lupus
//===== Current Version: ===================================== 
//= 1.3
//===== Compatible With: ===================================== 
//= rAthena Project
//===== Description: ========================================= 
//= Advance Class jobchanger after kRO Normals.
//===== Additional Comments: ================================= 
//= 1.1 Made all into functions, additional checks, etc. [Lupus]
//= 1.2 Made numbers into constants. [Vicious]
//= 1.3 Now saves/restores all the quest skills [Lupus]
//============================================================ 

valkyrie,53,56,3	script	Gypsy#Valkyrie	101,{
	if (ADVJOB == 0 || Upper != 1) {
		set .@karma_d,rand(1,10);
		if (.@karma_d > 4) {
			mes "[Gypsy]";
			mes "恭喜你。";
			mes "向勇士致敬！";
			close;
		}
		mes "[Gypsy]";
		mes "向左走，";
		mes "向右走～！";
		mes "再踏一步……！";
		mes "跳舞不只是";
		mes "一种爱好。";
		mes "对我来说，这是生活方式～";
		close;
	}
	else if (ADVJOB == Job_Gypsy && Class == Job_Archer_High && JobLevel > 39) {
		mes "[Gypsy]";
		mes "米德加尔特大陆";
		mes "需要有才华的女性，";
		mes "巧妙地改变";
		mes "善与恶之战中";
		mes "善与恶之战的平衡。";
		next;
		mes "[Gypsy]";
		mes "你准备好";
		mes "承担这个职责，";
		mes "成为舞娘了吗？";
		next;
		if (select("不。:是。") == 1) {
			mes "[Gypsy]";
			mes "准备好后，";
			mes "随时欢迎回来。";
			mes "向勇士致敬！";
			close;
		}
		if (SkillPoint) {
			mes "[Gypsy]";
			mes "你仍然可以学习更多技能。请在回来找我之前，";
			mes "使用完所有剩余的技能点。";
			close;
		}
		jobchange Job_Gypsy;
		set ADVJOB,0;
		mes "[Gypsy]";
		mes "恭喜你！";
		mes "作为舞娘，我知道";
		mes "你的表演";
		mes "会打动所有";
		mes "观看者的心……";
		close;
	}
	mes "[Gypsy]";
	mes "欢迎";
	mes "来到瓦尔哈拉，";
	mes "荣誉大厅。";
	next;
	mes "[Gypsy]";
	mes "请在这里";
	mes "放松休息。";
	mes "在这里好好休息吧。";
	mes "向勇士致敬！";
	close;
}

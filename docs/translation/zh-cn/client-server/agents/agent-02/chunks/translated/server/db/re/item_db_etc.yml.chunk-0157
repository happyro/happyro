  - Id: 312406
    AegisName: Experience_Badge
    Name: Experience Badge
    Type: Card
    SubType: Enchant
    Script: |
      .@g = getenchantgrade();
      if (BaseLevel<175) {
         bonus2 bExpAddRace,RC_All,10;
      }
      if (BaseLevel>=175) {
         bonus2 bExpAddRace,RC_All,4;
      }
      if (.@g>=ENCHANTGRADE_D) {
         bonus2 bExpAddRace,RC_All,1;
         if (.@g>=ENCHANTGRADE_C) {
            bonus2 bExpAddRace,RC_All,2;
            if (.@g>=ENCHANTGRADE_B) {
               bonus2 bExpAddRace,RC_All,3;
            }
         }
      }

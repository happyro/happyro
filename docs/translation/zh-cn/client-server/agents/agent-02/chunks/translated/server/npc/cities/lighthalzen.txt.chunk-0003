lighthalzen,312,233,3	script	Beggar#lhz_02	777,3,1,{
	end;

OnTouch_:
	mes "[乞丐]";
	mes "求求你……";
	mes "我的孩子快饿坏了……";
	mes "能不能给我";
	mes "一点钱？";
	next;
	if (select("给他一些钱。:不理会他。") == 1) {
		if (Zeny < 50) {
			mes "[乞丐]";
			mes "谢谢你的";
			mes "好意，不过看来";
			mes "你也很缺";
			mes "Zeny。要不要";
			mes "和我一起讨生活？";
			emotion ET_SMILE;
			close;
		}
		mes "[" + strcharinfo(0) + "]";
		mes "拿去吧，";
		mes "这些给你。";
		set Zeny, Zeny-50;
		next;
		mes "[乞丐]";
		mes "太感谢你了。";
		mes "我没有什么东西";
		mes "可以回报你，但能给你";
		mes "讲个故事，再把";
		mes "这些年来领悟的";
		mes "一点道理告诉你。";
		emotion ET_THANKS;
		next;
		switch(rand(1,3)) {
		case 1:
			mes "[乞丐]";
			mes "每个人都遇到过";
			mes "这样的处境吧，";
			mes "有时你会觉得";
			mes "自己非得在";
			mes "正确的事和想做的事";
			mes "之间作出选择，对吧？";
			next;
			mes "[乞丐]";
			mes "你也许会觉得进退两难。";
			mes "不过听我说，遇到";
			mes "难题时，并非所有";
			mes "可行的解决办法";
			mes "都会明摆在";
			mes "眼前。所以冷静想想吧。";
			next;
			mes "[乞丐]";
			mes "你眼中所见、";
			mes "心中所知，未必";
			mes "就是真实。星辰始终都在，只是白天看不见，";
			mes "希望也永远存在，即使我们暂时看不到它。";
			next;
			mes "[" + strcharinfo(0) + "]";
			emotion ET_THINK, playerattached();
			mes ". . . . . . . . . . . .";
			next;
			mes "[" + strcharinfo(0) + "]";
			emotion ET_THINK, playerattached();
			mes ". . . . . . . . . . . .";
			mes ". . . . . . . . . . . .";
			next;
			mes "[" + strcharinfo(0) + "]";
			emotion ET_THINK, playerattached();
			mes ". . . . . . . . . . . .";
			mes ". . . . . . . . . . . .";
			mes ". . . . . . . . . . . .";
			next;
			mes "[乞丐]";
			emotion ET_QUESTION;
			mes "嗯……？";
			mes "你好像很惊讶嘛～";
			close;
		case 2:
			mes "[乞丐]";
			mes "我有些相信命运，";
			mes "又有些不信。让我";
			mes "这样解释吧。我过日子";
			mes "总是一天算一天，每一天";
			mes "都横跨着奇迹与悲剧的两端。";
			next;
			mes "[乞丐]";
			mes "所以每一天都有可能";
			mes "带来美好、糟糕，";
			mes "或两者兼有的经历。我相信";
			mes "每个人都能主动 ";
			mes "一点一点塑造";
			mes "自己的命运。";
			next;
			mes "[乞丐]";
			mes "当然，有些事情";
			mes "也许由不得你掌控，";
			mes "但就连悲观的人";
			mes "或许也会承认，";
			mes "这个世界不只有";
			mes "悲剧，也存在奇迹。";
			next;
			mes "[乞丐]";
			mes "跌倒时就站起来，";
			mes "满怀热情地生活。奇迹的可能";
			mes "永远都在，而且要知道，";
			mes "你也能成为别人生命中的";
			mes "奇迹。那不是很美好吗？";
			next;
			mes "[" + strcharinfo(0) + "]";
			emotion ET_THINK, playerattached();
			mes ". . . . . . . . . . . .";
			next;
			mes "[" + strcharinfo(0) + "]";
			emotion ET_THINK, playerattached();
			mes ". . . . . . . . . . . .";
			mes ". . . . . . . . . . . .";
			next;
			mes "[" + strcharinfo(0) + "]";
			emotion ET_THINK, playerattached();
			mes ". . . . . . . . . . . .";
			mes ". . . . . . . . . . . .";
			mes ". . . . . . . . . . . .";
			next;
			mes "[乞丐]";
			emotion ET_QUESTION;
			mes "不相信我吗？";
			mes "年轻人，迟早";
			mes "你会亲自明白的。";
			mes "你心里有许多善意。";
			close;
		case 3:
			mes "[乞丐]";
			mes "愤怒。人们处理";
			mes "它的方式各不相同。有人";
			mes "压抑它，有人沉溺其中，";
			mes "还有人害怕动怒。简单来说，";
			mes "我们不妨认为";
			mes "愤怒分成两种。";
			next;
			mes "[乞丐]";
			mes "第一种没有什么";
			mes "益处，更像是一种";
			mes "可以放下的挫败感。";
			mes "有人在路上抢了你的道，";
			mes "或朋友无意忘了你的生日？没什么大不了。";
			next;
			mes "[乞丐]";
			mes "别让这种愤怒";
			mes "控制你，否则只会";
			mes "显得可悲。放眼大局，";
			mes "如果还是难受，";
			mes "就适当发泄。坦诚一些，但别伤害任何人。";
			next;
			mes "[乞丐]";
			mes "第二种则是";
			mes "义愤。你受到了";
			mes "不公，需要 ";
			mes "以某种方式讨回公道。 ";
			mes "只要别迁怒他人，";
			mes "并作出恰当回应。";
			next;
			mes "[乞丐]";
			mes "第二种愤怒";
			mes "就是义愤。你受了";
			mes "不公，需要以某种方式";
			mes "讨回公道。记得";
			mes "用恰当的方式面对问题，";
			mes "别把怒火发泄错了对象。";
			next;
			mes "[乞丐]";
			mes "如果你因义愤而战，";
			mes "比如为了保护";
			mes "珍爱的人，就会";
			mes "成为英雄。若因挫败生怒而争斗，";
			mes "你就成了恶霸。要懂得两者的区别。";
			next;
			mes "[" + strcharinfo(0) + "]";
			emotion ET_THINK, playerattached();
			mes ". . . . . . . . . . . .";
			next;
			mes "[" + strcharinfo(0) + "]";
			emotion ET_THINK, playerattached();
			mes ". . . . . . . . . . . .";
			mes ". . . . . . . . . . . .";
			next;
			mes "[" + strcharinfo(0) + "]";
			emotion ET_THINK, playerattached();
			mes ". . . . . . . . . . . .";
			mes ". . . . . . . . . . . .";
			mes ". . . . . . . . . . . .";
			next;
		mes "[乞丐]";
			emotion ET_QUESTION;
		mes "怎么了？";
		mes "我知道，这些话";
		mes "可能让你一时难以接受。";
			close;
		}
	}
	mes "[" + strcharinfo(0) + "]";
	mes "...";
	mes "......";
	close;
}


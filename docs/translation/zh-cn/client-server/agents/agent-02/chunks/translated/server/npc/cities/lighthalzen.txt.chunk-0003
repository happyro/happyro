		mes "隔壁的人也";
		mes "一直没有回来……";
		close;
	case 3:
		mes "[比莉亚]";
		mes "嗯？啊，对不起，";
		mes "我弟弟一直";
		mes "哭个不停。";
		mes "吵到你的话，真的很抱歉……";
		emotion ET_QUESTION, getnpcid(0, "Pilia#lhz_01");
		next;
		mes "[比莉亚]";
		mes "爸爸去了很远的地方";
		mes "工作。他终于";
		mes "找到了一份好工作，可是";
		mes "有时一连好几天";
		mes "都没有他的消息。我们";
		mes "真的很担心他。";
		next;
		mes "[比莉亚]";
		mes "弟弟贝鲁总是";
		mes "特别想念爸爸。我不";
		mes "知道怎样才能让他";
		mes "别再哭了！我该怎么办？";
		emotion ET_PROFUSELY_SWEAT, getnpcid(0, "Pilia#lhz_01");
		close;
	}
}


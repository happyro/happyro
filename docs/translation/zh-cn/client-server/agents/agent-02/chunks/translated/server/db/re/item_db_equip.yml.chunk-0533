    Attack: 210
    Range: 5
    Slots: 2
    Jobs:
      Hunter: true
    Classes:
      Fourth: true
    Locations:
      Both_Hand: true
    WeaponLevel: 5
    EquipLevelMin: 205
    Refineable: true
    Gradable: true
    Script: |
      .@g = getenchantgrade();
      .@r = getrefine();
      bonus2 bSkillAtk,"WH_GALESTORM",5;
      if (BaseLevel>=210) {
         bonus bAtkRate,7;
         bonus bBaseAtk,70;
      }
      if (BaseLevel>=220) {
         bonus2 bSkillAtk,"WH_GALESTORM",5;
      }
      if (BaseLevel>=230) {
         bonus2 bAddSize,Size_All,10;
      }
      if (.@r>=7) {
         bonus bCritAtkRate,10;
         if (.@r>=9) {
            bonus2 bSkillAtk,"WH_GALESTORM",10;
            if (.@r>=10) {
               bonus bCritical,10;
               if (.@r>=11) {
                  bonus2 bSkillAtk,"WH_GALESTORM",10;
               }
            }
         }
      }
      if (.@g>=ENCHANTGRADE_D) {
         bonus bCritAtkRate,15;
         if (.@g>=ENCHANTGRADE_C) {
            bonus2 bSkillAtk,"WH_GALESTORM",5;
            if (.@g>=ENCHANTGRADE_B) {
               bonus2 bSkillAtk,"WH_GALESTORM",10;
               if (.@g>=ENCHANTGRADE_A) {
                  bonus bPAtk,4*(.@r/2);
                  bonus bAtkRate,4*(.@r/2);
               }
            }
         }
      }

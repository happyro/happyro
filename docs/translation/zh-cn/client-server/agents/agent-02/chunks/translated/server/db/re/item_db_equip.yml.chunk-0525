  - Id: 650000
    AegisName: Woe_Huuma1_Z
    Name: 次级公会成员风魔手里剑
    Type: Weapon
    SubType: Huuma
    Weight: 1500
    Attack: 175
    Range: 1
    Jobs:
      KagerouOboro: true
      Ninja: true
    Locations:
      Both_Hand: true
    WeaponLevel: 3
    EquipLevelMin: 70
    Refineable: true
    Script: |
      .@r = getrefine();
      bonus2 bAddRace,RC_Player_Human,25+.@r;
      bonus2 bAddRace,RC_Player_Doram,25+.@r;
      bonus2 bIgnoreDefRaceRate,RC_Player_Human,10;
      bonus2 bIgnoreDefRaceRate,RC_Player_Doram,10;
      if (.@r>=7) {
         bonus2 bIgnoreDefRaceRate,RC_Player_Human,5;
         bonus2 bIgnoreDefRaceRate,RC_Player_Doram,5;
      }
      if (.@r>=9) {
         bonus2 bAddRace,RC_Player_Human,15;
         bonus2 bAddRace,RC_Player_Doram,15;
      }
      if (.@r>=10)
         autobonus3 "{ .@r = getrefine(); bonus2 bIgnoreDefRaceRate,RC_Player_Human,10+(.@r-10); bonus2 bIgnoreDefRaceRate,RC_Player_Doram,10+(.@r-10); }",1000,20000,"NJ_HUUMA";

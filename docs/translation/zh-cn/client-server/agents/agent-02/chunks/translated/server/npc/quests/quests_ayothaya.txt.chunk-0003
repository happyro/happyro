ayothaya,193,171,3	script	Old Man#02	842,{
	if (thai_find == 3) {
		mes "[Tham]";
		mes "奇怪……";
		mes "那个人为什么";
		mes "要那样跑进";
		mes "神殿？";
		mes "真让我";
		mes "在意……";
		next;
		mes "[Tham]";
		emotion ET_SURPRISE;
		mes "哦，你不是";
		mes "来自米德加尔特吗？";
		mes "你好呀~";
		next;
		mes "[Tham]";
		mes "啊……";
		mes "你听到我自言自语了吗？我没看清他是谁，但有个人跑进了通往神殿的森林。他似乎非常害怕什么东西。";
		next;
		mes "[Tham]";
		mes "他突然出现，把我吓了一大跳。你觉得他可能是罪犯吗？";
		next;
		mes "[Tham]";
		emotion ET_AHA;
		mes "啊！我想他在极度恐惧中喊着什么“^FF0000Shuda^000000”之类的话。但那到底是什么意思？";
		next;
		mes "[Tham]";
		mes "算了，别担心。我们村民并不是都那样。总之，希望你在艾沃泰雅旅行愉快。";
		set thai_find,4;
		changequest 12031,12032;
		close;
	} else {
		set .@randayo,rand(1,7);
		if (.@randayo < 5) {
			mes "[Tham]";
			mes "哦，你好~";
			mes "从你的衣服就能看出，你一定来自米德加尔特。";
			next;
			mes "[Tham]";
			mes "最近，似乎有更多游客";
			mes "来到我们的村子，";
			mes "我也能看出";
			mes "村子正受到";
			mes "积极的影响。";
			next;
			mes "[Tham]";
			mes "啊……";
			mes "既然你来到这里，";
			mes "为什么不亲自品尝";
			mes "正宗的艾沃泰雅料理？";
			mes " ";
			next;
			mes "[Tham]";
			mes "这里的海鲜";
			mes "又辣又甜，";
			mes "附近还有一些";
			mes "很棒的餐馆。";
			next;
			mes "[Tham]";
			mes "总之，我相信你会喜欢。希望你常来艾沃泰雅~";
			close;
		} else if (.@randayo > 4 && .@randayo < 7) {
			mes "[Tham]";
			mes "啊~";
			mes "我很想念辣妹 Mali 的料理，尤其是她的“冬阴功”。";
			next;
			mes "[Tham]";
			mes "我觉得那是";
			mes "全世界";
			mes "最美味的料理！";
			close;
		} else {
			mes "[Tham]";
			mes "哦，你好~";
			mes "从你的服装就能看出，你一定来自米德加尔特。";
			next;
			mes "[Tham]";
			mes "希望你在这里过得愉快，也希望你常来艾沃泰雅~";
			close;
		}
	}
}


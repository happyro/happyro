ayothaya,83,132,0	script	Dusit#thai	843,{
	if (ayodunquest == 0) {
		mes "[Dusit]";
		mes "哦……！";
		mes "你一定是旅行者。";
		mes "如果你有兴趣，我有个故事想讲给你听。";
		next;
		if (select("是什么故事？:我知道这个故事。") == 1) {
			mes "[Dusit]";
			mes "艾沃泰雅历史悠久。现在看起来平静祥和，但过去村子曾被可怕的生物侵扰。";
			next;
			mes "[Dusit]";
			mes "这种野兽被我们称为";
			mes "^660000沙鸣虎^000000，过去栖息在";
			mes "古代遗迹深处。";
			next;
			mes "[Dusit]";
			mes "沙鸣虎沉迷于人肉的味道。";
			mes "据说它会变成被吃掉之人的模样，引诱那人的家人和朋友出来。";
			next;
			mes "[Dusit]";
			mes "当地人仍然害怕它会变成熟人的模样，潜入家中吃掉他们。";
			next;
			mes "[Dusit]";
			mes "不过，有一种方法可以辨别沙鸣虎和人类。因为它是老虎，无法做到人类学会的某些事情，";
			mes "比如点燃火柴。";
			mes " ";
			next;
			mes "[Dusit]";
			mes "所以，如果你碰巧看到";
			mes "朋友突然举止奇怪，";
			mes "就让他划一根火柴。";
			mes "确认他不是";
			mes "沙鸣虎。";
			next;
			mes "[Dusit]";
			mes "不过……";
			mes "我也不确定这是否真的有效。如果怀疑某人是";
			mes "沙鸣虎，最好还是赶快逃命。";
			next;
			mes "[Dusit]";
			mes "你相信";
			mes "会吃人的老虎";
			mes "存在吗？";
			next;
			if (select("嗯，不太相信。:是的，我相信，而且我觉得很可怕！") == 1) {
				mes "[Dusit]";
				mes "嗯……";
				mes "算了。我小时候祖父曾告诉我沙鸣虎的故事。";
				mes "当然，";
				mes "我从没见过它。";
				next;
				mes "[Dusit]";
				mes "我见过最像沙鸣虎的，是一只戴铃铛的金色猫咪。不过我不认为它吃过人。";
				close;
			}
			mes "[Dusit]";
			mes "如果遇到沙鸣虎就赶快逃命！";
			mes "它会把你活活吃掉！";
			next;
			mes "[Dusit]";
			mes "如果你想了解更多故事，";
			mes "我可以介绍一个人给你，";
			mes "他比任何人";
			mes "都了解那种生物。";
			next;
			mes "[Dusit]";
			mes "去和 Boonthom 谈谈吧？他是个很奇怪的人，但身上有些特别之处……";
			next;
			mes "[Dusit]";
			mes "...";
			mes "......";
			next;
			mes "[Dusit]";
			mes "你见到他就会明白我说什么了。希望他能帮你更多了解那种邪恶生物。";
			set ayodunquest,1;
			setquest 12035;
			close;
		}
		mes "[Dusit]";
		mes "你现在相信了吗？";
		mes "那就小心点！";
		mes "它会把你活活吃掉！";
		close;
	} else if (ayodunquest > 0) {
		mes "[Dusit]";
		mes "你好吗？";
		mes "如果你对沙鸣虎感兴趣，";
		mes "请去和 Boonthom 谈谈。";
		next;
		mes "[Dusit]";
		mes "但要小心！";
		mes "沙鸣虎可能";
		mes "比你想象的更接近你！";
		close;
	}
}

ayo_in01,181,193,4	script	Shaman#thai	840,{

	// For both parts of the quest:

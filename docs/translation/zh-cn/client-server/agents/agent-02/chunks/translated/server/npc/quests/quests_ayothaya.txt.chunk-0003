	else
		setarray .@items[0],1059,1022; //Transparent_Cloth, Fox_Tail

	if (ayodunquest == 1) {
		mes "[Boonthom]";
		mes "你……！";
		mes "难道是……！";
		mes "哦哦哦哦哦！";
		next;
		mes "[Boonthom]";
		mes "哦……？";
		next;
		mes "[Boonthom]";
		mes "...";
		next;
		mes "[Boonthom]";
		mes "...";
		mes "......";
		next;
		mes "[Boonthom]";
		mes "...";
		mes "......";
		mes ".........";
		next;
		mes "[Boonthom]";
		mes "没事。";
		mes "哈！我忘了";
		mes "刚才想到哪里。";
		next;
		mes "[Boonthom]";
		mes "所以你是来找我求助的吗？我能看到你眼中的恐惧。让我凝视你的灵魂，看看你究竟害怕什么。嗯……";
		next;
		mes "[Boonthom]";
		mes "...";
		next;
		mes "[Boonthom]";
		mes "...";
		mes "......";
		next;
		mes "[Boonthom]";
		mes "...";
		mes "......";
		mes ".........";
		next;
		mes "[Boonthom]";
		mes "什么……！";
		mes "我看出你害怕沙鸣虎！我已经很久没听到那怪物的消息了……";
		next;
		mes "[Boonthom]";
		mes "很久以前，";
		mes "沙鸣虎确实在村子里游荡，";
		mes "吃掉了无辜的人。";
		mes " ";
		next;
		mes "[Boonthom]";
		mes "不过，它的恐怖统治";
		mes "在最终被捕后结束了。";
		mes "我就是参与捕获沙鸣虎的人之一。";
		next;
		mes "[Boonthom]";
		mes "我坚持要杀了它，但其他人太害怕而不敢动手。因此，沙鸣虎";
		mes "被关在古代遗迹中的一个洞穴里。";
		next;
		mes "[Boonthom]";
		mes "我想那至少是 10 年前的事了。它也许已经死了。不过没人";
		mes "知道那只老虎究竟有多强，";
		mes "它可能还活着。";
		next;
		mes "[Boonthom]";
		mes "但我认为不必担心。它被关在那里，就会一直关在那里。";
		next;
		switch(select("我想探索古代遗迹。:被关起来了！很好！我不害怕！")) {
		case 1:
			mes "[Boonthom]";
			mes "你……";
			mes "你真奇怪。";
			mes "你想探索古代遗迹。所有冒险者都这样不顾安全吗？";
			next;
			mes "[Boonthom]";
			mes "这是你的选择。但记住，通往建筑中心的道路非常危险。通常我会禁止进入。";
			next;
			mes "[Boonthom]";
			mes "但如果你想进去，";
			mes "我可以给你一些有用的提示。";
			mes "你想听吗？";
			next;
			if (select("既然那么危险，我还是不试了。:当然！") == 1) {
				mes "[Boonthom]";
				mes "你做了正确的决定。";
				mes "如果想活下来，";
				mes "最好小心一点。";
				close;
			}
			mes "[Boonthom]";
			mes "嗯，好吧。";
			mes "既然你";
			mes "这么感兴趣……";
			next;
			mes "[Boonthom]";
			mes "如果想进入古代建筑，你必须拥有抵御恶灵和恶意的保护。";
			next;
			if (Class == Job_Priest || Class == Job_Acolyte || Class == Job_Crusader) {
				mes "[Boonthom]";
				mes "即使你能";
				mes "使用神圣力量，";
				mes "仍然需要我们这片土地的精神护佑。";
			} else {
				mes "[Boonthom]";
				mes "洞穴里有许多鬼魂和恶魔，";
				mes "它们会攻击没有神圣力量的人……就像你。";
			}
			next;
			mes "[Boonthom]";
			mes "如果你愿意，我可以制作一件";
			mes "蕴含神圣力量的物品。制作它需要一些材料。";
			next;
			mes "[Boonthom]";
			mes "^3366991 个 "+getitemname(.@items[0])+"^000000，";
			mes "^3366991 个 "+getitemname(.@items[1])+"^000000，";
			mes "^3366991 个坚硬外壳^000000和";
			mes "^3366991 瓶圣水^000000……";
			mes "这些就是全部。";
			next;
			mes "[Boonthom]";
			mes "准备好所有材料后";
			mes "请再回来。";
			mes " ";
			set ayodunquest,2;
			changequest 12035,12036;
			close;
		}
		mes "[Boonthom]";
		mes "嗯……";
		mes "你不害怕";
		mes "它吗？";
		next;
		mes "[Boonthom]";
		mes "............";
		mes "............";
		close;
	} else if (ayodunquest == 2) {
		if (countitem(.@items[0]) > 0 && countitem(.@items[1]) > 0 && countitem(7190) > 0 && countitem(523) > 0) {
			mes "[Boonthom]";
			mes "太好了！";
			mes "你已经带来了";
			mes "我需要的一切。让我按约定";
			mes "为你制作物品……";
			next;
			mes "[Boonthom]";
			mes "哦哦哦嗯……";
			next;
			mes "[Boonthom]";
			mes "嗯嗯嗯……";
			mes "嗯嗯嗯嗯嗯。";
			next;
			mes "[Boonthom]";
			mes "噗噗……";
			next;
			mes "[Boonthom]";
			mes "给你。";
			mes "请收下这些圣线。";
			mes "有了它，你就能更安心地进入遗迹。";
//
//
//
//
//
//

				mes "[Gunther Doubleharmony]";
				mes "没错，那是我的朋友！明蒂·艾伦黛！我们曾经非常亲近，所以我会为朋友明蒂·艾伦黛写下歌曲的每个字，请转过身去！";
				next;
				mes "^3355FF冈瑟在你的背上奋笔疾书。^000000";
				next;
				mes "[Gunther Doubleharmony]";
				mes "好了！现在你可以回去找明蒂·艾伦黛，给他看背上的字，他就能看到我写的内容并想起歌词了！";
				if (gef_bard_q == 2) set gef_bard_q,3;
				if (gef_bard_q == 22) set gef_bard_q,23;
				close;

			} else {
				mes "[Gunther Doubleharmony]";
				mes "不不不，我不认识那个名字的人，你最好再确认一下委托人的名字，好吗？";
				close;
			}

		} else {
			mes "[Gunther Doubleharmony]";
			mes "不不不不，我不知道有那首歌，甚至可能根本不存在。你应该再确认歌曲名称后告诉我，好吗？";
			close;
		}

	} else if (gef_bard_q == 6 || gef_bard_q == 26) {
		mes "[Gunther Doubleharmony]";
		mes "你又回来了！";
		mes "咦，我写在你背上的歌？等等，让我想想——啊，对了，我想起来了！";
		next;
		mes "[Gunther Doubleharmony]";
		mes "我写在你背上的歌词是凯蒂先生写的，他是我的偶像、我的英雄！那首歌出自 ^228B22金诺·凯蒂^000000！";
		next;
		mes "[Gunther Doubleharmony]";
		mes "我希望有一天也能成为像他一样伟大的吟游诗人！";
		close;

	} else {
		mes "[Gunther Doubleharmony]";
		mes "哈哈哈~！";
		mes "听我说，听我说！";
		next;
		mes "[Gunther Doubleharmony]";
		mes "我的朋友告诉我这首歌是关于住在斐扬的一位商人，大家都喜欢它，尤其是因为由我来演唱，你知道……";
		next;
		mes "[Gunther Doubleharmony]";
		mes "哦，对了……！";
		mes "你想听";
		mes "我的歌还是故事？";
		mes "我知道你想听！";
		mes "对吧，对吧？";
		next;

		if(select("表现出兴趣。:忽略他。")==1) {
			mes "[Gunther Doubleharmony]";
			mes "耶~！我就知道！";
			mes "那么你想听";
			mes "歌曲还是故事？";
			next;
			switch(select("歌曲:故事:下次再说")) {
			case 1:
				switch(rand(1,3)) {
				case 1:
					mes "[Gunther Doubleharmony]";
					mes "冈瑟歌唱！";
					mes "冈瑟舞蹈！";
					mes "这首歌的标题是~";
					mes "‘富有的金先生~！’";
					next;
					mes "^228B22Merchant of Payon";
					mes "好穷穷穷穷穷~";
					mes "没有钱买铠甲";
					mes "也没有钱制作。";
					next;
					mes "^228B22卖掉了";
					mes "棉布衬衫";
					mes "从他背上脱下";
					mes "他不会接受怜悯。^000000";
					next;
					mes "^228B22起初，他只卖红色药水，";
					mes "起初，他只卖红色药水。";
					mes "后来升级卖胡萝卜，呜呼~";
					mes "他买得起新铠甲";
					mes "甚至还能穿上它，";
					mes "呜呼~^000000";
					next;
					mes "^228B22但有一天，他被骗了，";
					mes "被邪恶的公会欺骗。";
					mes "再次变得贫穷。";
					mes "他决定前往蚂蚁地狱";
					mes "就在那儿";
					mes "马上出发。";
					next;
					mes "^228B22Bats, Dwarves, Eggs, Ants!";
					mes "他与它们全部战斗~";
					mes "蠕虫皮屑、杰勒比！";
					mes "收集大大小小的战利品。";
					next;
					mes "^228B22后来，光荣的日子到来了，";
					mes "当他找到一张珍贵的卡片";
					mes "能为他的名声带来巨大财富~^000000";
					next;
					mes "^228B22但他珍藏着它，";
					mes "为了铭记那段";
					mes "辛勤工作的时光。";
					mes "他从未卖掉它，从未卖掉";
					mes "那张珍贵的卡片~^000000";
					next;
					mes "[Gunther Doubleharmony]";
					mes "这是关于富有的金先生，以及他从贫穷到富有、再从富有到贫穷、再到富有的古老故事。是真的还是虚构的？别问我！我也不知道！";
					close;

				case 2:
					mes "[Gunther Doubleharmony]";
					mes "*Ahem*";
					mes "冈瑟歌唱";
					mes "世界树尤克特拉希尔~";
					next;
					mes "^228B22Evergreen Yggdrasil~";
					mes "巨大的灰烬之树";
					mes "直指天空。";
					mes "晶莹的晨露";
					mes "从叶片滴落";
					mes "汇成乌尔德之泉。^000000";
					next;
					mes "^228B22Three wise girls.";
					mes "坐在树枝下。";
					mes "过去的乌尔德，";
					mes "现在的贝尔丹迪，";
					mes "未来的诗寇蒂。^000000";
					next;
					mes "^228B22Spinning, weaving";
					mes "命运的丝线。";
					mes "常青的世界树尤克特拉希尔~";
					mes "巨大的灰烬之树";
					mes "直指天空。";
					mes "根部浸透了泪水。^000000";
					next;
					mes "^228B22Death in Hvergelmir.";
					mes "邪恶的巨龙";
					mes "燃烧它的根部";
					mes "用永恒的火焰。";
					mes "邪龙尼德霍格";
					mes "生活在世界树与";
					mes "尼弗海姆之间。^000000";
					next;
					mes "^228B22Evergreen Yggdrasil~";
					mes "巨大的灰烬之树";
					mes "直指天空。";
					mes "根部蕴含智慧";
					mes "根系延伸至";
					mes "密米尔之泉。^000000";
					next;
					mes "^228B22Guarded by a wise giant.";
					mes "奥丁牺牲了一只";
					mes "眼睛换取智慧。";
					mes "海姆达尔隐藏的号角";
					mes "在世界树根部";
					mes "将最后一次吹响";
					mes "宣告诸神黄昏。^000000";
					next;
					mes "[Gunther Doubleharmony]";
					mes "这是一个非常古老的故事……";
					mes "它是真实还是虚构？别问我，我也不知道~！";
					close;

				case 3:
					mes "[Gunther Doubleharmony]";
					mes "我要唱一首卢克的歌，你知道卢克吧，他是那个时代最伟大的吟游诗人之一。不过我稍微改了歌词。";
					next;
					mes "^228B22I found it in a drawer.";
					mes "古老、磨损的信件";
					mes "组成精致的词句。";
					mes "真诚的倒影";
					mes "来自真诚的心。^000000";
					next;
					mes "^228B22I found it in a drawer.";
					mes "我曾经真的是那样吗？";
					mes "我曾经真的那么幼稚吗？";
					mes "我的记忆已经蒙尘。";
					next;
					mes "^228B22I found it in a drawer.";
					mes "我曾忘记的爱。";
					mes "她从未收到这封信。";
					mes "但我们都太害羞。";
					next;
					mes "^228B22I found it in a drawer.";
					mes "我曾忘记的爱。";
					mes "我从未把这封信交给她。";
					mes "但我们都太骄傲。";
					next;
					mes "[Gunther Doubleharmony]";
					mes "你心里有谁吗？有吗？如果你写了情书，一定要寄出去表达自己。";
					next;
					mes "[Gunther Doubleharmony]";
					mes "如果你写了永远不会寄出的情书，就把它们扔掉。把你该死的自尊也扔掉。";
					close;
				}

			case 2:
				switch(rand(1,3)) {
				case 1:
					mes "[Gunther Doubleharmony]";
					mes "嗯，你尝过";
					mes "可莫多奶酪吗？";
					next;
					mes "[Gunther Doubleharmony]";
					mes "只有在可莫多才能尝到它，但需要强健的胃才能消化。哦！而且这种奶酪还藏着秘密！";
					next;
					mes "[Gunther Doubleharmony]";
					mes "吃下它后，^228B22也许^000000能免疫来自异世界的毁灭之剑的力量！";
					next;
					mes "[Gunther Doubleharmony]";
					mes "还没尝过的话，为什么不去试试？我以前尝过一次。味道还不错，但后来我晕倒了。哈哈哈~！";
					close;

				case 2:
					mes "[Gunther Doubleharmony]";
					mes "前几天我经过普隆德拉，来到以前的剑士训练场。";
					next;
					mes "[Gunther Doubleharmony]";
					mes "我看到一个孩子非常努力地训练，他没注意到我在看，所以我想他一定非常认真！";
					next;
					mes "[Gunther Doubleharmony]";
					mes "他看起来想成为职业剑士，却又把装备送给其他初心者。";
					next;
					mes "[Gunther Doubleharmony]";
					mes "看他一遍又一遍做同样的事让我感到无聊，不过如果我介绍他，魔物研究组织应该会喜欢他。";
					close;

				case 3:
					mes "[Gunther Doubleharmony]";
					mes "你去过卢迪吗，";
					mes "那个全年下雪的地方？";
					next;
					mes "[Gunther Doubleharmony]";
					mes "那里有一个叫";
					mes "雪雪的雪人，见到他你就会发现许多事，比如他会说话！真奇怪又神秘~！";
					next;
					mes "[Gunther Doubleharmony]";
					mes "他有一个能不断变出礼物的神秘袋子，还有一段与寒冷小镇和邪恶女巫有关的神秘过去。";
					next;
					mes "[Gunther Doubleharmony]";
					mes "不过没关系，他被一位炼金术士救活了。想了解更多的话，就去卢迪看看，好吗？";
					close;
				}
			
			case 3:
				mes "[Gunther Doubleharmony]";
				mes "你现在就要离开，连听我一点点都不愿意吗？好吧，我没事，但答应我还会回来听我的一首歌，好吗？";
				close;
			
			}

		} else {
			mes "[" + @name$ + "]";
			mes "...";
			next;
			mes "[Gunther Doubleharmony]";
			mes "哇，你在无视我吗？好吧，我不介意！除非你遇到了无法说话的问题，那我真的非常抱歉。";
			close;
		}

	}

}

yuno_in04,20,123,7	script	Representative#bq	95,{
//set @check = GetGlobalVar "040708_god2"
	mes "[Marlin Putiur]";
	if (god_brising == 3) {
		mes "欢迎来到";
		mes "魔物研究";
		mes "组织。";
		next;
		mes "[Marlin Putiur]";
		mes "我们根据冒险者提供的信息研究魔物，以便有效应对野外的魔物。";
		next;
		mes "[Marlin Putiur]";
		mes "我们接受任何与魔物有关的信息，";
		mes "如果你有消息或资料，请随时提交给我。";
		next;
		mes "[Marlin Putiur]";
		mes "你可以随时使用";
		mes "房间里的报告表格。";
		next;
		mes "[Marlin Putiur]";
		mes "咦……？";
		mes "你刚才说";
		mes "正在寻找";
		mes "某个人？嗯……";
		next;
		mes "[Marlin Putiur]";
		mes "如果他是本组织的";
		mes "注册成员，";
		mes "我可以帮助你。";
		next;
		mes "[Marlin Putiur]";
		mes "名字是什么？";
		mes "赫米特·查尔斯……？";
		next;
		mes "[Marlin Putiur]";
		mes "哦，我找到他了。";
		mes "呃，不过他申请加入时没有提交全部所需信息……";
		next;
		mes "[Marlin Putiur]";
		mes "哦，他是盗贼。";
		mes "那就解释得通了。你要看看";
		mes "我们拥有的全部信息吗？";
		next;
		mes "^3355FF马林向你展示";
		mes "会员申请";
		mes "卡。^000000";
		next;
		mes "[Membership Card]";
		mes "姓名：赫米特·查尔斯";
		mes "职业：盗贼";
		mes "性别：盗贼";
		mes "地址：普隆德拉你妈街";
		next;
		mes "[Marlin Putiur]";
		mes "很遗憾，我们没有更多信息。但希望这些能对你有所帮助。";
		next;
		mes "[Marlin Putiur]";
		mes "不过，去盗贼公会看看也许是个好主意。";
		mes "也许他们能帮助你。";
		close;
	}

	mes "欢迎来到";
	mes "魔物研究";
	mes "组织。";
	next;
	mes "[Marlin Putiur]";
	mes "我们根据冒险者提供的信息研究魔物，以便有效应对野外的魔物。";
	next;
	mes "[Marlin Putiur]";
	mes "我们接受任何与魔物有关的信息，如果你有消息或资料，请随时提交给我。";
	next;
	mes "[Marlin Putiur]";
	mes "你可以随时使用房间里的报告表格。";
	if (gef_bard_q == 4 || gef_bard_q == 24) {
		next;
		mes "[Marlin Putiur]";
		mes "嗯？";
		mes "本组织的冒险者？啊，你说你在找一位吟游诗人？";
		next;
		mes "[Marlin Putuir]";
		mes "是的，我们有几位吟游诗人成员会定期发送魔物相关信息。";
		next;
		mes "[Marlin Putiur]";
		mes "我还听说吟游诗人帮助学者在野外设置公告牌，为新冒险者指示地点。可以告诉我你要找的人的全名吗？";
		next;
		input .@inputstr$;
		if (.@inputstr$ == "Minty Errende") {
			mes "[Marlin Putiur]";
			mes "明蒂·艾伦黛……";
			mes "哦，我记得他。他前段时间说要往南方去，现在住在吉芬。";
			next;
			mes "[Marlin Putiur]";
			mes "他是个善良友好的人。艾伦黛总是尽力提供我们所需的信息。有机会的话，请代我向他问好。";
			close;

		} else if (.@inputstr$ == "Kino Kitty") {
			mes "[Marlin Putiur]";
			mes "金诺·凯蒂，金诺·凯蒂……哦，找到了。他寄来一封信，说‘在找到真正的自己之前，我会留在沙漠。’";
			next;
			mes "[Marlin Putiur]";
			mes "他看起来不太健康，但我想他还在旅行。去梦罗克找找他吧，有机会请代我问好。";
			close;

		} else if (.@inputstr$ == "Gunther Doubleharmony") {
			mes "[Marlin Putiur]";
			mes "啊，你是冈瑟的朋友？哈哈，他很有趣，只是有点容易激动。让我看看，冈瑟，冈瑟……";
			next;
			mes "[Marlin Putiur]";
			mes "这里写着他想去斐扬和艾尔贝塔看看。所以他应该在其中一个地方。抱歉我无法说得更具体。";
			close;

		} else {
			mes "[Marlin Putiur]";
			mes " " + .@inputstr$ + "……？";
			mes "嗯……";
			mes "抱歉，我们没有那个人的记录。";
			close;
		}

	} else {
		next;
		mes "[Marlin Putiur]";
		mes "我们正在研究这个世界的魔物，希望帮助每一位踏上旅途的冒险者。";
		close;
	}
}

yuno_in04,33,119,3	script	Adventurer#1	828,{
	mes "...";
	next;
	mes "...";
	mes ".......";
	next;
	mes "^3355FF*唰唰唰*^000000";
	next;
	mes "[Energetic Young Man]";
	mes "呃……？";
	mes "怎么了？";
	next;
	if (Sex == SEX_FEMALE) {
		emotion ET_SMILE;
		mes "[Energetic Young Man]";
		mes "哦……！";
		mes "一位美丽的";
		mes "年轻女士~！";
		next;
		mes "[Energetic Young Man]";
		mes "你好~";
		mes "我叫潘恩。";
		mes "可以问问你的名字吗？";
		set @name$,strcharinfo(0);
		input .@inputstr$;
		next;
		mes "[Energetic Young Man]";
		mes "哦……";
		mes "" +.@inputstr$+ "...";
		if (@name$ == .@inputstr$) {
			next;
			mes "[Energetic Young Man]";
			mes "^FF6699"+.@inputstr$+"!";
			mes "真是个美好的名字！";
			next;
			mes "[Energetic Young Man]";
			mes "女士，我会记住你的名字。哦，真的很抱歉，我现在有点忙。你能晚点再来吗？下次我会尽力招待你。";
			emotion ET_CHUP;
			close;

		} else {
			mes "那是你的名字？";
			next;
			mes "[Energetic Young Man]";
			mes "呃，随便吧。不过真的很抱歉，我现在有点忙。你能晚点再来吗？下次我会尽力招待你。";
			emotion ET_SMILE;
			close;
		}

	} else {
		mes "[Energetic Young Man]";
		mes "怎么了，老兄……！";
		mes "别烦我。";
		mes "你没看到我正忙吗？";
		close;
	}
}

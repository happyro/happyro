					mes "金、金诺叔叔";
					mes "你吓到我了。";
					mes "请不要大喊！";
					mes "这让我想";
					mes "哭……";
					next;
					mes "[Kino Kitty]";
					mes "哦……";
					mes "对不起，公主。我不会再这样了。金诺叔叔以后会努力做个好人。";
					next;
					mes "[Kino Kitty]";
					mes "*唉……*";
					mes "好了，听我说。";
					next;
					mes "[Kino Kitty]";
					mes "你需要一本收录艾达歌词的旧书，才能找到歌曲的原词。新书已经不再收录原版了。";
					next;
					mes "[Kino Kitty]";
					mes "我想知道……";
					mes "艾伦黛怎么会知道原歌词？无论如何，真抱歉给你添了这么多麻烦。我想我只是有些厌倦了。";
					next;
					mes "[Kino Kitty]";
					mes "你可以去朱诺看看。书街上有一家小书店，你也许能在那里找到这首歌。";
					next;
					mes "[Kino Kitty]";
					mes "^333333^333333*咳咳*^000000^000000";
					mes "为、为什么我要受苦？我作为吟游诗人在世上的最后日子就要到头了吗？我感觉自己真可悲……";
					set gef_bard_q,10;
					close;

				} else {
					mes "[Mysterious Bard]";
					mes "真的吗？";
					mes "真奇怪。";
					mes "你们冒险者总是在进行某种冒险，不是吗？毕竟这就是这个词的含义。";
					close;
				}

			} else {
				if (Sex == SEX_MALE) {
					mes "[Kino Kitty]";
					mes "你真是个好青年。我会记住你的名字，也希望你能记住我的名字。";
					next;
					mes "[Mysterious Bard]";
					mes "我叫金诺·凯蒂，是一名四处流浪、希望重新找回愿望与梦想的诗人。";
					next;
					mes "[Kino Kitty]";
					mes "下次见面时，我会告诉你我听到和经历的一切。也就是说，我愿意与你共度时光。";
					set gef_bard_q,20;
					close;

				} else {
					mes "[Mysterious Bard]";
					mes "啊，能遇见您这样的高贵女士是我的荣幸。请允许我告诉您我的名字。";
					next;
					mes "[Mysterious Bard]";
					mes "我的女士，您的美貌如紫藤，足以媲美女神芙蕾雅。我是四处流浪的穷诗人金诺·凯蒂，希望您能记住我。";
					set gef_bard_q,20;
					close;
				}
			}
		}
	}
}


yuno_in01,172,100,3	script	Old Man#bq1	712,{
	if (gef_bard_q > 11 && gef_bard_q < 20) {
		mes "[Sketzi Bundin]";
		mes "你找到想找的东西了吗？虽然我们这里只有落满灰尘的旧书，但希望你常来。也请代我向你的吟游诗人朋友问好。";
		close;

	} else if (gef_bard_q == 30) {
		mes "[Sketzi Bundin]";
		mes "有意思……";
		mes "你手上有黑色十字印记。凯蒂还在吗？知道他还活着我很高兴。如果你是他的朋友，这里欢迎你。";
		close;

	} else if (gef_bard_q == 31) {
		mes "[Sketzi Bundin]";
		mes "哎呀，你又来了。今天想找什么书？当然，我们这里只有写满艾达、落满灰尘的旧书。哈哈哈~";
		close;

	} else if (gef_bard_q == 11) {
		mes "[Sketzi Bundin]";
		mes "欢迎。";
		mes "你一定在找特别的东西。我们这里几乎有所有的北欧诗歌，也就是‘艾达’。只有这里能找到那种古老的歌曲。";
		next;
		mes "[Sketzi Bundin]";
		mes "不过，我不能把这些脆弱的书展示给任何人。为了保存它们，我只能向熟客展示这些作品。";
		next;

		if(select("给他看你的左手。:给他看你的右手。")==1) {
			mes "[Sketzi Bundin]";
			mes "啊~！你一定是高级吟游诗人的朋友！我明白了，你一定是明蒂·艾伦黛的朋友。";
			next;
			mes "[Sketzi Bundin]";
			mes "那么，你在找什么？我想其实不用问也知道。哈哈哈~";
			next;
			mes "[Sketzi Bundin]";
			mes "请……";
			mes "慢慢找。";
			mes "希望你能找到";
			mes "自己";
			mes "想要的东西。";
			set gef_bard_q,12;
			close;

		} else {
			mes "[Sketzi Bundin]";
			mes "让我看看……好吧。";
			mes "你的心跳比平时稍快。你应该检查一下，毕竟是为了健康，对吧？";
			next;
			mes "[Sketzi Bundin]";
			mes "你不是在找医学或健康方面的书吧？抱歉，我们没有这类书。";
			close;
		}
	
	} else {
		mes "[Sketzi Bundin]";
		mes "欢迎。";
		mes "你一定在找特别而稀有的东西。不过我们这里只收藏一种书。";
		next;
		mes "[Sketzi Bundin]";
		mes "如果你在找魔物资料，为什么不去普隆德拉图书馆，或朱诺这里的魔物博物馆看看？";
		close;
	}
}

yuno_in01,163,101,0	script	Old Book#bq	111,{
	set @name$,strcharinfo(0);
	if ((gef_bard_q > 11) && (gef_bard_q < 14)) {
		if (!rand(5)) {
			mes "^3355FF你打开了书。书页又脆又硬，字迹已经褪色，几乎无法阅读。甚至看不出作者的名字。^000000";
			next;
			mes "[Collection of Eddas]";
			mes "这是一首情歌。每个人一生中至少都会经历一次单相思。";
			next;
			mes "[Collection of Eddas]";
			mes "一时，我坠入爱河。";
			mes "二时，你给我一个微笑。";
			mes "三时，我爱慕你的触碰。";
			mes "四时，一个温柔的吻……";
			next;
			mes "[Collection of Eddas]";
			mes "五时，我们改变心意。";
			mes "花瓣随风飘散。";
			mes "六时，我坠入爱河~";
			mes "七时，你坠入爱河……";
			next;
			mes "[" + @name$ + "]";
			mes "我想就是这个……！";
			mes "最好把它记下来。";
			next;
			mes "[Collection of Eddas]";
			mes "八时，我们相爱。";
			mes "九时，你了解我的心。";
			mes "十时，我知道你一直";
			mes "在等我。";
			next;
			mes "[Collection of Eddas]";
			mes "十一时，一句珍贵的";
			mes "低语：‘你愿意嫁给我吗？’";
			mes "十二时，我们的两颗心";
			mes "合二为一。十二片花瓣，";
			mes "我们的爱终于绽放。";
			next;
			mes "^3355FF你抄下最后几行，写在纸条上放进口袋。";
			set gef_bard_q,15;
			close;

		} else {
			mes "[" + @name$ + "]";
			mes "*叹气* 我几乎看不清这本书。也许我该翻翻另一本。";
			close;
		}

	} else {
		mes "[Sketzi Bundin]";
		mes "抱歉，那本书太脆弱了，不能随意翻阅。只有特别的客人才能阅读。";
		close;
	}
}


yuno_in01,173,96,0	script	Luke's Songs Vol.1	111,{
	if (gef_bard_q > 11) {
		mes "[Preface]";
		mes "我是伊兹卢德的卢克，当代最伟大的吟游诗人，现将重要歌曲的歌词留给后世。";
		mes " ";
		mes "目录";
		next;

		switch(select("婚礼之歌:人生如水车:我们")) {

		case 1:
			mes "[Wedding Song]";
			mes "普隆德拉圣堂";
			mes "所有人都将前往那里";
			mes "庆祝你们的结合";
			mes "见证最幸福的婚礼。";
			next;
			mes "[Wedding Song]";
			mes "我欢快地拨动鲁特琴";
			mes "这是我的职业";
			mes "为你们带来欢快歌声";
			mes "伴随婚礼队伍前行。";
			next;
			mes "[Wedding Song]";
			mes "我的歌不收";
			mes "Zeny 或金币，";
			mes "只要新娘的笑容，";
			mes "如果我可以";
			mes "大胆提出这个要求。";
			next;
			mes "[Wedding Song]";
			mes "美丽姑娘闪亮的双眼";
			mes "动人的秀发";
			mes "以及那结实、柔软的——";
			mes "";
			next;
			mes "[Wedding Song]";
			mes "请原谅我，新郎！";
			mes "但新娘实在太美了！";
			mes "愿你们的结合受到祝福！";
			mes "呃，愿你的妻子贤惠。";
			next;
			mes "[Luke's Note]";
			mes "这首歌讲述一位受邀参加婚礼的吟游诗人无法抵抗新娘美貌，最后唱起了诱惑之歌。";
			next;
			mes "[Luke's Note]";
			mes "当然，歌词是虚构的，绝非真实故事。";
			close;
		
		case 2:
			mes "[人生如水车]";
			mes "我追逐名声。";
			mes "它却躲开了我。";
			mes "我追寻幸福";
			mes "却从未抓住它。";
			next;
			mes "[人生如水车]";
			mes "但明天依然会";
			mes "到来，我确信。";
			mes "就像艾尔帕兰的";
			mes "水车，";
			mes "随着";
			mes "生活继续转动。";
			next;
			mes "[人生如水车]";
			mes "振作起来！生活还要继续。";
			mes "正如水车";
			mes "一定会转动，";
			mes "明天终会到来。";
			next;
			mes "[Luke's Note]";
			mes "这首歌";
			mes "是为了安慰";
			mes "绝望中的人。";
			close;
		
		case 3:
			mes "[我们]";
			mes "优秀的吟游诗人歌唱";
			mes "是为了取悦听众。";
			mes "所以不要期待悲伤的歌曲";
			mes "让你的痛苦更加深重。";
			next;
			mes "[我们]";
			mes "优秀的舞者起舞";
			mes "是为了取悦观众。";
			mes "我们一起跳舞吧？";
			mes "握住我的手就好。";
			mes "啦啦啦~ 啦啦啦~";
			next;
			mes "[我们]";
			mes "镇民：‘那你们为什么偶尔唱出刺耳的和声？！’";
			mes "吟游诗人：‘嗯……没有人是完美的！’";
			next;
			mes "[Luke's Note]";
			mes "这首歌适合在节日演唱，故意制造的不和谐会鼓励观众参与。除此之外，这首歌没什么特别含义。";
			close;
		}

	} else {
		mes "[Sketzi Bundin]";
		mes "抱歉，那本书不对公众展出。";
		close;
	}
}


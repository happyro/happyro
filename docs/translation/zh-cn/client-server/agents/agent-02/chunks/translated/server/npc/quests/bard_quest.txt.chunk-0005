payon,181,172,3	script	Bard#4	51,{
	set @name$,strcharinfo(0);
	if (gef_bard_q == 2 || gef_bard_q == 22) {
		mes "[Gunther Doubleharmony]";
		mes "哈哈哈~！";
		mes "听我说，听我说！";
		next;
		mes "[Gunther Doubleharmony]";
		mes "我的朋友告诉我这首歌是关于住在斐扬的一位商人，大家都喜欢它，尤其是因为由我来演唱，你知道……";
		next;
		mes "[" + @name$ + "]";
		mes "打扰一下。";
		mes "你是……";
		mes "冈瑟·双和声吗？";
		next;
		mes "[Gunther Doubleharmony]";
		mes "……那位商人穷得甚至没有——嗯？哦，对，是我。怎么了？";
		next;
		mes "^3355FF你向他解释自己来此是为了寻找遗失的歌词。^000000";
		next;
		mes "[Gunther Doubleharmony]";
		mes "啊——我明白了。";
		mes "那么，那首歌的名字";
		mes "是什么来着？";
		next;
		input .@inputstr$;
		if (.@inputstr$ == "At One, I Fall in Love") {
			mes "[Gunther Doubleharmony]";
			mes "啊~ 那首歌……？";
			mes "顺便问一下，是谁让你";
			mes "来打听这首歌的？";
			next;
			input .@inputstr$;
			if (.@inputstr$ == "Minty Errende") {

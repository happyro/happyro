	case 1:
		mes "[Bookcase Notes]";
		mes "疯狂与天才在概念上相同，因为它们都是异常现象。";
		mes "观察^8B4513吉芬^000000的炼金术士^005DFF莫根斯坦^000000后，我认为两者确实相等。";
		next;
		mes "[Bookcase Notes]";
		mes "有一次我不得不去拜访……";
		mes "那个奇怪的^005DFF莫根斯坦^000000进行研究。";
		next;
		mes "[Bookcase Notes]";
		mes "在见到^005DFF莫根斯坦^000000之前我喝了肉汤，";
		mes "令人惊讶的是，我还没靠近，他就嘟囔说闻到了肉味。";
		next;
		mes "[Bookcase Notes]";
		mes "我从没想过炼金术士的嗅觉这么灵敏。";
		mes "下次拜访";
		mes "^005DFF莫根斯坦^000000时，";
		mes "我会吃点别的东西。";
		close;
	case 2:
		mes "[Bookcase Notes]";
		mes "^005DFF德布里斯^000000认为炼金术士最近的热情<大幅>下降了……";
		next;
		mes "[Bookcase Notes]";
		mes "他尤其不喜欢我专注于^FF4800生命体^000000研究。";
		mes "我们在^8B4513卢恩-米德加兹^000000一起学习时，他可没说过这种话。";
		next;
		mes "[Bookcase Notes]";
		mes "总有一天，我会把我的^FF4800生命体^000000研究数据给^005DFF德布里斯^000000看。";
		mes "我喜欢看他吓得魂不附体……我很期待那一天。";
		close;
	case 3:
		mes "[Bookcase Notes]";
		mes "^005DFF德布里斯^000000对^57007F基因学^000000的热情令人惊叹。";
		next;
		mes "[Bookcase Notes]";
		mes "最近，炼金术士公会来信邀请我加入^57007F基因学^000000部门。";
		mes "不知道^005DFF德布里斯^000000对公会说了什么……";
		next;
		mes "[Bookcase Notes]";
		mes "嗯，我很感激……";
		mes "不过对现在的我来说，";
		mes "研究才是最重要的。";
		close;
	case 4:
		mes "[Bookcase Notes]";
		mes "^005DFF达西亚^000000曾对我说过一件有趣的事。";
		mes "是关于^005DFF杰伊娜^000000第一次学习药水合成的时候……";
		next;
		mes "[Bookcase Notes]";
		mes "她一直做得很好，直到把水倒入混合物。";
		mes "她只要把它倒进空瓶就好了……";
		next;
		mes "[Bookcase Notes]";
		mes "^005DFF达西亚^000000看着她完成最后一步，";
		mes "困惑的^005DFF杰伊娜^000000却从碗里喝掉混合物，告诉她效果很好。";
		next;
		mes "[Bookcase Notes]";
		mes "想想看，就连如今的药水合成大师";
		mes "^005DFF杰伊娜^000000也有过新手失误，";
		mes "这说明想象和预测";
		mes "一个人的过去与未来";
		mes "是多么困难。";
		close;
	case 5:
		mes "[Bookcase Notes]";
		mes "^005DFF文森特^000000，我想我成功了。";
		mes "我永远不会忘记你的鼓励，";
		mes "也很感激现在终于能回报你。";
		next;
		mes "[Bookcase Notes]";
		mes "这确实是个漫长的过程。";
		mes "当公会许多人";
		mes "认为我的研究无关紧要时，";
		mes "……虽然我没有失去信念，";
		mes "内心深处还是受到了伤害。";
		next;
		mes "[Bookcase Notes]";
		mes "那些相信我的少数朋友，";
		mes "尤其是^005DFF杰伊娜^000000";
		mes "和你，^005DFF文森特^000000……";
		mes "我发自内心地感谢你们。";
		next;
		mes "[Bookcase Notes]";
		mes "人们常说，";
		mes "结果证明手段是正当的。";
		mes "一开始，";
		mes "我并不明白这是什么意思……";
		next;
		mes "[Bookcase Notes]";
		mes "现在我明白了。";
		mes "我知道遵从内心";
		mes "有多么重要。";
		next;
		mes "[Bookcase Notes]";
		mes "我很快会去拜访。";
		mes "在那之前请保重。";
		close;
	case 6:
		mes "[Bookcase Notes]";
		mes "一款类似国际象棋的游戏^0000FF史诗战役 2^000000很有趣。";
		next;
		mes "[Bookcase Notes]";
		mes "不久前，我遇到一位擅长史诗战役 2 的^0000FF水果商人^000000。";
		mes "他甚至轻松破解了臭名昭著的^006400灰熊冲击波战术^000000和^006400死神恐惧^000000。";
		next;
		mes "[Bookcase Notes]";
		mes "要在^0000FF牧师阵营^000000战斗的早期阶段击败那些对手……";
		mes "对我来说很难，因为需要组合棋子并使用诱敌技巧。";
		next;
		mes "[Bookcase Notes]";
		mes "不知道什么时候我才能成为 3 克拉钻石级玩家。";
		close;
	case 7:
		mes "[Bookcase Notes]";
		mes "许多炼金术士喜欢^FF4800巴尼米尔斯^000000。";
		next;
		mes "[Bookcase Notes]";
		mes "但我更喜欢^FF4800阿米斯特^000000。";
		mes "它用闪亮的眼睛摇尾巴时很可爱。";
		next;
		mes "[Bookcase Notes]";
		mes "我的阿米斯特乔纳森聪明又温和，非常讨人喜欢。";
		mes "我们是好朋友，对吧，乔纳森？";
		close;
	}
}

que_house_s,16,52,3	script	Open Book#02homun_s	111,{
	switch(rand(1,8)) {
	case 1:
		mes "[Bookcase Notes]";
		mes "我该给^005DFF德布里斯^000000写些什么呢？";
		mes ":: 致我那位杰出的";
		mes ":: 基因学朋友德布里斯。";
		mes ":: 里希塔乐镇最近好吗？";
		mes ":: 他们有足够的";
		mes ":: 你最喜欢的饼干吗？";
		next;
		mes "[Bookcase Notes]";
		mes ":: 我很快会带着饼干";
		mes ":: 去拜访你。";
		mes ":: 我们见面时，";
		mes ":: 我会把我的";
		mes ":: ^006400新生命体^000000介绍给你。";
		next;
		mes "[Bookcase Notes]";
		mes ":: 不用保持警惕。";
		mes ":: 和你不同，";
		mes ":: 它们对别人吃什么";
		mes ":: 并不感兴趣。";
		mes ":: 很快再见～！";
		mes ":: 你敢关门试试。";
		close;
	case 2:
		mes "[Bookcase Notes]";
		mes "上次我拜访炼金术士公会时，桌上有一场有趣的讨论。";
		mes "我想主题是^006400生命体在公共场所的疏忽^000000。";
		next;
		mes "[Bookcase Notes]";
		mes "主人打瞌睡时，";
		mes "一只脱离束缚的^FF4800生命体^000000";
		mes "惹出了某种麻烦。";
		next;
		mes "[Bookcase Notes]";
		mes "我会确保我的生命体乔纳森……";
		mes "接受充分训练，不在他人身边惹麻烦。";
		close;
	case 3:
		mes "[Bookcase Notes]";
		mes "我和^005DFF杰伊娜^000000喜欢上了一种新玩具。";
		mes "它还比较新，";
		mes "好像叫……^0000FF‘赫洛’^000000？";
		next;
		mes "[Bookcase Notes]";
		mes "有位^57007F诗人^000000为它唱了一首相关歌曲。";
		mes "歌词大概是^006400‘啊啊～啊～啊啊啊啊’^000000。";
		next;
		mes "[Bookcase Notes]";
		mes "娱乐本身很有趣，";
		mes "音乐也很棒，";
		mes "听着它时，";
		mes "感觉 SP 恢复了很多。";
		next;
		mes "[Bookcase Notes]";
		mes "我必须说，";
		mes "休息时娱乐很重要，";
		mes "能提升研究士气。";
		mes "^006400为了生命体～！^000000";
		close;
	case 4:
		mes "[Bookcase Notes]";
		mes "听公会成员";
		mes "^005DFF帕米^000000说，";
		mes "^005DFF拉斯普钦^000000还是一如既往地古怪。";
		next;
		mes "[Bookcase Notes]";
		mes "让那些精力充沛的灵魂";
		mes "如此热情地";
		mes "前来转职，";
		mes "也许并不是好主意。";
		close;
	case 5:
		mes "[Bookcase Notes]";
		mes "一位喜欢绘画的朋友";
		mes "提议制作一部名为";
		mes "^0000FF《变异者》^000000的<图像小说>，";
		mes "因为他听说了我的研究";
		mes "和作品。";
		next;
		mes "[Bookcase Notes]";
		mes "故事开始了……";
		mes "一个外星";
		mes "^FF4800生命体^000000";
		mes "来到了我们的世界。";
		next;
		mes "[Bookcase Notes]";
		mes "这个外星";
		mes "^FF4800生命体^000000无需主人也能生存，";
		mes "还能变成各种";
		mes "在我们世界游荡的";
		mes "生物。";
		mes "它拥有不可思议的力量。";
		next;
		mes "[Bookcase Notes]";
		mes "这些外星^FF4800生命体^000000";
		mes "分成两个对立阵营，";
		mes "因政治分歧而彼此敌对。";
		mes "在我们的世界里，称它们为";
		mes "^006400自治生命体^000000和";
		mes "^006400欺诈生命体^000000。";
		next;
		mes "[Bookcase Notes]";
		mes "^006400自治生命体^000000是我们的朋友。";
		mes "它们的首领";
		mes "名叫^005DFF擎天波利^000000，";
		mes "对波利来说造型非常酷，";
		mes "还能随意召唤手推车！";
		mes "真是太厉害了。";
		next;
		mes "[Bookcase Notes]";
		mes "对立阵营^006400欺诈生命体^000000";
		mes "由^005DFF巨魔^000000领导，";
		mes "它们不择手段";
		mes "想摧毁我们的世界。";
		next;
		mes "[Bookcase Notes]";
		mes "故事的主人公";
		mes "来自^8B4513艾尔贝塔^000000，名叫^005DFF杰姆·威奇^000000，";
		mes "他遇到了^005DFF擎天波利^000000，";
		mes "当时他正在购买手推车，";
		mes "仿佛一切都是命运安排。";
		next;
		mes "[Bookcase Notes]";
		mes "于是，一场史诗般的战斗";
		mes "在^8B4513梦罗克沙漠^000000展开，";
		mes "我们世界的命运";
		mes "掌握在他的手中……";
		mes "故事还在继续。";
		next;
		mes "[Bookcase Notes]";
		mes "先说到这里～！";
		mes "故事的其余部分请阅读";
		mes "正式出版的书。";
		mes "^0000FF《变异者》^000000";
		mes "一定会很精彩～！";
		close;
	case 6:
		mes "[Bookcase Notes]";
		mes "公会给成员送来了一份特别礼物。";
		mes "它叫做^0000FF高级发夹 4^000000。";
		next;
		mes "[Bookcase Notes]";
		mes "它原本用于方便成员间私聊，但也有其他实用功能。";
		next;
		mes "[Bookcase Notes]";
		mes "这是某个公会发明的。我记得他们的徽章上有苹果图案。";
		close;
	case 7:
		mes "[Bookcase Notes]";
		mes "生命体确实很有价值。";
		mes "不过和所有人一样，我有时也会质疑它的意义和未来。";
		next;
		mes "[Bookcase Notes]";
		mes "我认为大自然赋予的生命应该为自己而活。";
		mes "然而……";
		next;
		mes "[Bookcase Notes]";
		mes "赋予生命体生命的研究，实际上是为了人类的利益。";
		mes "也许人类在伦理上还没有准备好创造生命。";
		close;
	case 8:
		mes "[Bookcase Notes]";
		mes "不久前，^005DFF杰伊娜^000000把我介绍给一个人。";
		mes "她来自^8B4513吉芬^000000，";
		mes "自称是^005DFF鸡类研究者^000000。";
		next;
		mes "[Bookcase Notes]";
		mes "她是^006400传说中的比佐夫尼尔^000000专家。";
		mes "她很反感人们认为比佐夫尼尔是鹰。";
		next;
		mes "[Bookcase Notes]";
		mes "她说在^8B4513赫维格尔米尔泉^000000的某处，";
		mes "存在一只会说话的^005DFF鸡^000000以及其他故事……";
		mes "总之，故事就是这样，";
		mes "非常有趣。";
		close;
	}
}


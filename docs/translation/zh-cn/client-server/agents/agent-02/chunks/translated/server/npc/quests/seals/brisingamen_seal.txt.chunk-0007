	mes "什么……？！";
	mes "分身？！";
	next;
	donpcevent "#brisinsummon::OnDoppel1On";
	donpcevent "#brisinsummon::OnKnight1On";
	donpcevent "#brisinsummon::OnKnight2On";
	donpcevent "#brisinsummon::OnKnight3On";
	donpcevent "#brisinsummon::OnLowenOn";
	mes "[" + strcharinfo(0) + "]";
	mes "这是怎么回事？你真的和那个生物战斗过吗？喂、喂！回答我！";
	next;
	mes "[Lowen Ellenen]";
	mes "没错，就是这里……指挥官下达命令后……发生了什么？";
	next;
	mapannounce "que_god02","大家保持冷静！各就各位！",0,0x9CFF00;
	mes "^4E2F2F[Crusader Commander]";
	mes "大家各就各位！前排阻挡它的行动！后排支援防御！^000000";
	emotion ET_GO, getnpcid(0, "#knight1");
	emotion ET_GO, getnpcid(0, "#knight2");
	emotion ET_GO, getnpcid(0, "#knight3");
	emotion ET_SURPRISE, getnpcid(0, "#doppelganger1");
	next;
	mes "[Lowen Ellenen]";
	mes "不、不是！";
	mes "我没有逃跑！";
	next;
	mes "^3355FF巨大的不安充满你的心，你亲身体会到了洛温在那一刻感受到的恐惧与压力。^000000";
	next;
	mes "^4E2F2F[Crusader Commander]";
	mes "上吧，洛温！现在施放圣十字攻击！^000000";
	next;
	specialeffect EF_BEGINSPELL7,AREA,"#lowen";
	mapannounce "que_god02","哇哈哈！凡人真是愚蠢……",0,0xA8A8A8;
	donpcevent "#brisinsummon::OnDoppel1Off";
	donpcevent "#brisinsummon::OnDoppel2On";
	emotion ET_SURPRISE, getnpcid(0, "#knight1");
	emotion ET_SURPRISE, getnpcid(0, "#knight2");
	emotion ET_SURPRISE, getnpcid(0, "#knight3");
	emotion ET_SURPRISE, getnpcid(0, "#lowen");
	mes "[" + strcharinfo(0) + "]";
	mes " ??!!!";
	next;
	specialeffect EF_BEGINSPELL7,AREA,"#doppelganger2";
	mes "[Male Voice]";
	mes "洛温！";
	mes "不——！！！";
	close2;
	warp "que_god02",120,52;
	donpcevent "#brisinsummon::OnDoppel2Off";
	donpcevent "#brisinsummon::OnKnight1Off";
	donpcevent "#brisinsummon::OnKnight2Off";
	donpcevent "#brisinsummon::OnKnight3Off";
	donpcevent "#brisinsummon::OnLowenOff";
	end;
}

que_god02,124,59,7	script	#hermite	798,{ end; }
 
que_god02,120,52,0	script	#monologue	139,0,0,{

OnTouch_:
	mes "[" + strcharinfo(0) + "]";
	mes "我在哪里？那不是……赫米特怎么会在这里？！";
	next;
	mes "[Hermite Charles]";
	mes "不，不，不！洛温，别……！他会杀了你的！";
	next;
	mes "[Hermite Charles]";
	mes "圣十字攻击？！使用那个就是自杀！洛温，别这么做！别这样，洛温！";
	next;
	mapannounce "que_god02","哇哈哈！凡人真是愚蠢……",0,0xA8A8A8;
	mes "[Hermite Charles]";
	mes "洛温！";
	mes "不——！！！";
	next;
	donpcevent "#brisinsummon::OnHermiteOff";
	mes "[" + strcharinfo(0) + "]";
	mes "他去哪儿了？刚才……那是他的内心吗？";
	mapannounce "que_god02","发生了什么？！洛、洛温不见了！！",0,0xA8A8A8;
	next;
	mes "[Lowen Ellenen]";
	mes "……我明白了。我知道……发生了什么……";
	close2;
	warp "que_god02",18,127;
	end;

}

que_god02,21,127,3	script	Lowen Ellenen#2	745,{
	mes "[Lowen Ellenen]";
	mes "我真是个傻瓜。现在我想起赫米特了。他一定就是救我的人。但我恢复意识时，身边已经没有人了。";
	next;
	mes "[Lowen Ellenen]";
	mes "我责怪自己独自活了下来。我本该和朋友们一起死在那里。我觉得自己毫无用处。";
	next;
	mes "[Lowen Ellenen]";
	mes "现在我明白，有很多人爱着我。但当时我感受到的只有罪恶感。";
	next;
	mes "[Lowen Ellenen]";
	mes "三天后我回到指挥官身边。那很愚蠢，但当时我想不到别的办法。";
	next;
	mes "[Lowen Ellenen]";
	mes "上层和政客们正在为任务失败寻找替罪羊。";
	next;
	mes "[Lowen Ellenen]";
	mes "所以我成了被责怪的人。然后他们夺走了我拥有的一切：我的地位，以及赐予我的神圣力量……";
	next;
	mes "[Lowen Ellenen]";
	mes "我以为自己应得那种惩罚。毕竟，所有同伴都死了，为什么偏偏我活了下来？";
	next;
	mes "[Lowen Ellenen]";
	mes "就在那时，我决定为朋友们复仇，挽回所剩无几的荣誉感。";
	next;
	mes "[Lowen Ellenen]";
	mes "我回到了那个地方。我不断战斗，试图为自己犯下的错误赎罪……";
	next;
	mapannounce "que_god02","如果你愿意，就继续战斗吧。我保证胜者会成为英灵……",0,0x70DB93;
	mes "[Lowen Ellenen]";
	mes "那个声音……那不是……？";
	next;
	mes "[Lowen Ellenen]";
	mes "你要再给我一次机会吗？但我已经没有身体可以继续与怪物战斗了……";
	next;
	mes "[" + strcharinfo(0) + "]";
	mes "别担心，我和你在一起！我们开始吧！";
	close2;
	donpcevent "#brisinsummon::OnSummon";
	donpcevent "#brisinsummon::OnLowen2Off";
	end;
}

que_god02,178,127,3	script	Valkyrie#1	811,{

	if (god_brising == 31) {
		mes "[Valkyrie]";
		mes "你通过了考验，洛温。我没有太多时间说话。";
		next;
		mes "[Valkyrie]";
		mes "你找到从罪恶感与痛苦中解放自己的力量了吗？我一直在等你。你愿意接受我前往英灵殿的邀请吗？";
		next;
		switch(select("是的，我跟你走。:嗯……我不是洛温。")) {
		case 1:
			mes "[Valkyrie]";
			mes "洛温·埃伦南，被误解的英雄。我现在将遵循神的意志，将你提升为英灵。";
			next;
			mes "[Valkyrie]";
			mes "你的灵魂将在英灵殿重生为神圣战士，为神圣战争做好准备。";
			specialeffect2 EF_BLESSING;
			next;
			mes "[Valkyrie]";
			mes "还有……";
			mes ""+ strcharinfo(0) +",";
			mes "我知道你的功绩。但我很好奇，是什么把你带到了这里？";
			next;
			mes "^3355FF你向女武神讲述了发生的一切，从永不融化的雪晶开始。^000000";
			next;
			mes "[Valkyrie]";
			mes "我明白了。故事很久很久以前就从美与爱的守护女神芙蕾雅开始。";
			next;
			mes "[Valkyrie]";
			mes "她的泪滴化作美丽的宝石。芙蕾雅泪滴落下的雪，将永远保持水晶般的美丽。";
			next;
			mes "[Valkyrie]";
			mes "你在寻找女神的痕迹？也许这是千年和平即将结束的征兆。那一天到来时，我希望人类不会放弃信仰。";
			next;
			mes "[Valkyrie]";
			mes "也许我也是被派来与你相遇的。我希望人类能运用神之痕迹带来的力量守护正义。";
			next;
			mes "[Valkyrie]";
			mes ""+ strcharinfo(0) +"...";
			mes "听好。这就是你必须寻找的东西。";
			next;
			mes "[Valkyrie]";
			mes "女神踏过的寒冷雪路。女神渡过的蓝色河流。女神经过的狭窄小径。女神遇见的四名矮人……";
			next;
			mes "[Valkyrie]";
			mes "^4d4dff群星的美丽";
			mes "与之相比也黯然失色。我们将心交给了那金色的头发和那双耀眼的眼睛。^000000";
			next;
			mes "[Valkyrie]";
			mes "记住这些。我会把你送回属于你的地方。";
			set god_brising,34;
			next;
			mes "[Valkyrie]";
			mes "为了奥丁的荣誉……";
			close2;
			hideonnpc "#doppelganger1";
			hideonnpc "#doppelganger2";
			hideonnpc "#knight1";
			hideonnpc "#knight2";
			hideonnpc "#knight3";
			hideonnpc "#lowen";
			hideoffnpc "Soldier#1_brising";
			hideonnpc "Soldier#2_brising";
			hideoffnpc "#hermite";
			hideoffnpc "Lowen Ellenen#2";
			hideonnpc "Valkyrie#1";
			warp "geffen",120,101;
			end;
		case 2:
			mes "[Valkyrie]";
		mes "哈哈哈哈……已经很久";
			mes "没有凡人能逗我笑。";
			next;
			mes "[Valkyrie]";
			mes ""+ strcharinfo(0) +"，我是在与你体内休眠的灵魂说话，也就是那个你借出身体、让她了解过去真相的女孩。";
			next;
			mes "[Valkyrie]";
			mes "洛温·埃伦南，被误解的英雄。我现在将遵循神的意志，将你提升为英灵。";
			next;
			mes "[Valkyrie]";
			mes "你的灵魂将在英灵殿重生为神圣战士，为神圣战争做好准备。";
			specialeffect2 EF_BLESSING;
			next;
			mes "[Valkyrie]";
			mes "还有……";
			mes ""+ strcharinfo(0) +"，我知道你的功绩。但我很好奇，是什么把你带到了这里？";
			next;
			mes "^3355FF你向女武神解释了发生的一切，从永不融化的雪晶开始讲起。^000000";
			next;
			mes "[Valkyrie]";
			mes "我明白了。故事很久很久以前就从美与爱的守护女神芙蕾雅开始。";
			next;
			mes "[Valkyrie]";
			mes "她的泪滴化作美丽的宝石。芙蕾雅泪滴落下的雪，将永远保持水晶般的美丽。";
			next;
			mes "[Valkyrie]";
			mes "你在寻找女神的痕迹？也许这是千年和平即将结束的征兆。那一天到来时，我希望人类不会放弃信仰。";
			next;
			mes "[Valkyrie]";
			mes "也许我也是被派来与你相遇的。我希望人类能运用神之痕迹带来的力量守护正义。";
			next;
			mes "[Valkyrie]";
			mes ""+ strcharinfo(0) +"……听好。这就是你必须寻找的东西。";
			next;
			mes "[Valkyrie]";
			mes "女神踏过的寒冷雪路。女神渡过的蓝色河流。女神经过的狭窄小径。";
			next;
			mes "[Valkyrie]";
			mes "^4d4dff群星的美丽与之相比也黯然失色。我们将心交给了那金色的头发和那双耀眼的眼睛。^000000";
			next;
			mes "[Valkyrie]";
			mes "记住这些。我会把你送回属于你的地方。";
			set god_brising,34;
			next;
			mes "[Valkyrie]";
			mes "为了奥丁的荣誉……";
			close2;
			hideonnpc "#doppelganger1";
			hideonnpc "#doppelganger2";
			hideonnpc "#knight1";
			hideonnpc "#knight2";
			hideonnpc "#knight3";
			hideonnpc "#lowen";
			hideoffnpc "Soldier#1_brising";
			hideonnpc "Soldier#2_brising";
			hideoffnpc "#hermite";
			hideoffnpc "Lowen Ellenen#2";
			hideonnpc "Valkyrie#1";
			warp "geffen",120,101;
			end;
		}
	}
}

xmas,38,105,0	script	#brisindwarf1	111,3,3,{
	if ($God2 < $@god_check1) {
		mes "^3355FFA lot of snow";
		mes "厚厚地堆在地上。^000000";
		close;
	}
	if ($God3 >= $@god_check2) {
		mes "^3355FF大量积雪厚厚地堆在地上。^000000";
		close;
	}
	if ((god_brising > 39) && (god_brising < 50)) {
		mes "^3355FF大量积雪厚厚地堆在地上。^000000";
		next;
		mes "^3355FF但不知为何，这堆积雪让你感到好奇。^000000";
		next;
		switch(select("用手扫开积雪。:用手指戳积雪。:取消。")) {
		case 1:
			mes "^3355FF你用手掌扫开积雪，一部分雪融化了，露出一个奇怪的谜题方块。它有多个面，你可以读到每个面上都刻着一段歌词。";
			next;
			switch(select("调整谜题。:退出。")) {
			case 1:
				mes "[" + strcharinfo(0) + "]";
				mes "好吧，嗯……我想我该选择一段歌词……";
				next;
				switch(select("与之相比黯然失色:献给那美丽的头发:我们所有人的心:群星的美丽:献给那耀眼的双眼")) {
				case 1:
					mes "[" + strcharinfo(0) + "]";
					mes "我们献上……";
					break;
				case 2:
					mes "[" + strcharinfo(0) + "]";
					mes "献给那美丽的头发";
					break;
				case 3:
					mes "[" + strcharinfo(0) + "]";
					mes "我们所有人的心";
					break;
				case 4:
					mes "[" + strcharinfo(0) + "]";
					mes "群星的美丽";
					set .@point,.@point + 10;
					break;
				case 5:
					mes "[" + strcharinfo(0) + "]";
					mes "献给那耀眼的双眼";
					break;
				}
				switch(select("我们献上:与之相比黯然失色。:我们所有人的心:献给女神经过的道路:献给那耀眼的双眼")) {
				case 1:
					mes "我们献上……";
					break;
				case 2:
					mes "与之相比黯然失色。";
					set .@point,.@point + 10;
					break;
				case 3:
					mes "我们所有人的心";
					break;
				case 4:
					mes "献给女神经过的道路";
					break;
				case 5:
					mes "献给那耀眼的双眼";
					break;
				}
				switch(select("我们献上:献给那美丽的头发:我们所有人的心:献给女神经过的道路:我们失去了心")) {
				case 1:
					mes "我们献上";
					break;
				case 2:
					mes "献给那美丽的头发";
					break;
				case 3:
					mes "我们所有人的心";
					break;
				case 4:
					mes "献给女神经过的道路";
					break;
				case 5:
					mes "我们失去了心";
					set .@point,.@point + 10;
					break;
				}
				switch(select("献给那金色的头发:献给那美丽的头发:我们所有人的心:献给女神经过的道路:献给那耀眼的双眼")) {
				case 1:
					mes "献给那金色的头发";
					set .@point,.@point + 10;
					break;
				case 2:
					mes "献给那美丽的头发";
					break;
				case 3:
					mes "我们所有人的心";
					break;
				case 4:
					mes "献给女神经过的道路";
					break;
				case 5:
					mes "献给那耀眼的双眼";
					break;
				}
				switch(select("我们献上:献给那美丽的头发:和那耀眼的双眼。:献给女神经过的道路:献给那耀眼的双眼")) {
				case 1:
					mes "我们献上";
					break;
				case 2:
					mes "献给那美丽的头发";
					break;
				case 3:
					mes "和那耀眼的双眼。";
					set .@point,.@point + 10;
					break;
				case 4:
					mes "献给女神经过的道路";
					break;
				case 5:
					mes "献给那耀眼的双眼";
					break;
				}
				next;
				if (.@point > 40) {
					hideoffnpc "Alfrik#1";
					mes "[Old dwarf]";
				mes "你是谁？！为什么把我吵醒？";
					close;
				}
				close;
			case 2:
				mes "["+ strcharinfo(0) +"]";
				mes "嗯……？什么也没发生。是我做错了，还是这只是一个普通的谜题方块？";
				close;
			}
		case 2:
			mes "["+ strcharinfo(0) +"]";
			mes "这……最好别只是某人掉在雪里的普通谜题方块！";
			close;
		case 3:
			mes "^3355FF你用手指戳了戳积雪，但碰到非常坚硬的东西后，手指有些疼。^000000";
			emotion ET_ANGER, playerattached();
			percentheal -20,0;
			close;
		case 4:
			close;
		}
	}
	else {
		mes "^3355FF大量积雪厚厚地堆在地上。^000000";
		close;
	}

OnTouch_:
	if (god_brising > 39) {
		emotion ET_SURPRISE, playerattached();

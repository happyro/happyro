morocc,155,56,3	script	Miya	93,3,3,{

	if(checkweight(7416,1) != 1)
	{
		mes "^3355FF等一下！";
		mes "你现在携带的东西";
		mes "太多了。";
		mes "请使用卡普拉服务";
		mes "存放一些物品后";
		mes "再回来。^000000";
		close;
	}
	if(!(BaseLevel > 59))
	{
		mes "[Girl]";
		mes "嘿，小鬼……";
		mes "你在这里";
		mes "闲逛做什么？";
		mes "你知道像你这样的孩子";
		mes "从这座城市";
		mes "失踪了，对吧？";
		next;
		mes "[Girl]";
		mes "你最好离开，";
		mes "去更安全的地方玩，";
		mes "比如普隆德拉或艾尔贝塔。";
		mes "快走吧，别";
		mes "靠近陌生人，好吗？";
		close;
	}
	if(!(Class == Job_Star_Gladiator || BaseClass == Job_Thief))
	{
		mes "[Girl]";
		mes "...............................";
		mes "嗯？你到底";
		mes "想要什么？滚开，";
		mes "别和我说话，";
		mes "除非你想挨揍！";
		close;
	}
	if(!mao_request)
	{
		if (Class == Job_Star_Gladiator)
		{
			mes "[Miya]";
			mes "等等！你是";
			mes "跆拳道大师，对吧？";
			mes "记得武贤吗？他";
			mes "帮你转过职……？";
			mes "他为你写了这封信。";
			next;
			mes "[Miya]";
			mes "听着，"+ strcharinfo(0) +"...";
			mes "他要你帮助";
			mes "刺客公会执行一项";
			mes "特殊任务。我想";
			mes "这事相当严重。";
			next;
			mes "[Miya]";
			mes "如果你有兴趣帮助";
			mes "协助刺客,";
			mes "就去和联系人见面，";
			mes "地点在城市西边";
			mes "附近。好了，这就是";
			mes "他告诉我的全部，再见~";
			set mao_request,1;
			getitem 7416,1;
			close;
		}
		else if((BaseJob == Job_Thief) || (BaseJob == Job_Thief_High) || (Class == Job_Rogue) || (Class == Job_Stalker))
		{
			mes "[Miya]";
			mes "嘿，" + strcharinfo(0) + ",";
			mes "我有重要的";
			mes "工作给你。刺客";
			mes "公会竟然向盗贼";
			mes "和流氓公会求助！";
			mes "你能相信吗？";
			next;
			mes "[Miya]";
			mes "总之，我们这些恶棍";
			mes "应该尽力帮忙。";
			mes "来，拿上这封推荐信，";
			mes "去找";
			mes "本城西边的联络人杰克。你最好马上去……";
			set mao_request,1;
			getitem 7416,1;
			close;
		}
		else if((Class == Job_Assassin) || (Class == Job_Assassin_Cross))
		{
			mes "[Miya]";
			mes "" + strcharinfo(0) + "!";
			mes "刺客公会会长";
			mes "马上要见你。你知道";
			mes "秘密酒馆在哪里吗？";
			next;
			mes "[" + strcharinfo(0) + "]";
			mes "啊，你、你好，米娅，";
			mes "好久不见。";
			mes "什么秘密酒馆？";
			next;
			mes "[Miya]";
			mes "我想你可能没听说过。去和";
			mes "杰克谈谈，他在本城绿洲西边，";
			mes "他会让你进去。";
			mes "从现在起，你会在那里的";
			mes "酒馆度过很多时间。";
			mes " ";
			next;
			mes "[Miya]";
			mes "那家酒馆大概是";
			mes "我们这些刺客";
			mes "唯一能放松的地方。不过，";
			mes "这项任务很重要。";
			mes "我们需要尽可能多的";
			mes "帮助……";
			set mao_request,1;
			getitem 7416,1;
			close;
		}
	}
	else if(mao_request == 1)
	{
		if (Class == Job_Star_Gladiator)
		{
			mes "[Miya]";
			mes "如果你有兴趣帮助";
			mes "协助刺客,";
			mes "就去和联系人见面，";
			mes "地点在城市西边";
			mes "附近。好了，这就是";
			mes "他告诉我的全部，再见~";
			close;
		}
		else if((BaseJob == Job_Thief) || (BaseJob == Job_Thief_High) || (Class == Job_Rogue) || (Class == Job_Stalker))
		{
			mes "[Miya]";
			mes "据说在本城绿洲西边";
			mes "有一家私人酒馆。";
			mes "你应该和我们";
			mes "的联络人杰克谈谈，";
			mes "他就在酒馆外面。";
			mes " ";
			close;
		}
		else if((Class == Job_Assassin) || (Class == Job_Assassin_Cross))
		{
			mes "[Miya]";
			mes "在梦罗克绿洲西边寻找杰克，";
			mes "他会让你进入";
			mes "酒馆。我们的公会会长会在";
			mes "里面等你……";
			mes "在里面等你……";
			close;
		}
	}
	else if(((mao_request > 2) && (mao_request < 27)) || ((mao_request > 102) && (mao_request < 125)))
	{
		if((Class == Job_Star_Gladiator) || (BaseJob == Job_Thief) || (BaseJob == Job_Thief_High) || (Class == Job_Rogue) || (Class == Job_Stalker))
		{
			mes "[Miya]";
			mes "进展如何？";
			mes "我想你接到的任务";

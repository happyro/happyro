				mes "[Guildsman]";
				mes "刺客公会向";
				mes "正式向我们公会请求帮助，";
				mes "调查有关";
				mes "最近从梦罗克失踪的孩子。";
				mes "最近从梦罗克失踪的孩子，";
				mes "他们想让我们派人……就是你！";
				next;
				mes "[Guildsman]";
				mes "或者……至少你是炼金术士公会";
				mes "想派去代表我们的人之一。";
				mes "所以你为什么不去？为了孩子们。想想吧。";

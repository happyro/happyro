				mes "我毫不怀疑这会是";
				mes "非常困难的任务。";
				mes "如果要参与，";
				mes "请做好准备……";
				set mao_request,1;
				getitem 7416,1;
				close;
			}
			else if((Class == Job_Alchemist) || (Class == Job_Creator))
			{
				mes "[Guildsman]";

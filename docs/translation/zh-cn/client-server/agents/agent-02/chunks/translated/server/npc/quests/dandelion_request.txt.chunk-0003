				mes "[公会成员]";
				mes "好吧，随便。";
				mes " ";
				mes "^71637D好，那么刺客";
				mes "公会正在寻找外部";
				mes "帮助完成一项任务。";
				mes "非常重要的事。^000000";
				next;
				mes "[Guildman]";
				mes "^71637D他们受某位客户雇佣，";
				mes "来……来……嗯，你知道的……^000000";
				mes " ";
				mes "……调查失踪儿童？";
				mes "^71637D对，对，就是这个。^000000";
				next;
				mes "[Guildman]";
				mes "^71637D总之，这是一个相当";
				mes "这项任务很重要，刺客";
				mes "公会正在寻求";
				mes "帮助。我觉得你非常适合";
				mes "代表灵魂链接者，";
				mes "所以我决定选你。^000000";
				next;
				mes "[公会成员]";
				mes "^71637D所以去帮助刺客吧！^000000";
				mes " ";
				mes "等等，别忘了";
				mes "推荐信！";
				mes " ";
				mes "^71637D哦，对了！来，拿着这个！^000000";
				set mao_request,1;
				getitem 7416,1;
				next;
				mes "[公会成员]";

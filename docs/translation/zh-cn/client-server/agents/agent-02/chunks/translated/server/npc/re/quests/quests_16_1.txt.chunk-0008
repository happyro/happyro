		mes "[Dyu]";
		mes "哦，我被他哥哥抓住了。";
		mes "我是被强行拖到这里来的……";
		cutin "bu_du2",2;
		next;
		mes "[Dyu]";
		mes "我好像见过马克……";
		mes "在哪里……在哪里来着？";
		cutin "bu_du3",2;
		next;

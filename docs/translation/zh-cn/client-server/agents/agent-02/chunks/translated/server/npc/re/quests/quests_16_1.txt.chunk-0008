prt_cas,361,142,5	script	Tamarin#ep16_1	4_EP16_TAMARIN,{
	if (ep16_cookbs < 15) {
		mes "[Tamarin]";
		mes "Haaaaaaa!";
		mes "这是怎么回事……";
		emotion ET_HNG;
		npctalk "啊啊啊啊！", "Tamarin#ep16_1", bc_self;
		cutin "tama_cook_4",2;
		close3;
	}
	if (ep16_cookbs == 15) {
		mes "[Tamarin]";
		mes "Haaaaaaa!";
		mes "这是怎么回事……";
		emotion ET_HNG;
		npctalk "啊啊啊啊！", "Tamarin#ep16_1", bc_self;
		cutin "tama_cook_4",2;
		next;
		mes "[Tamarin]";
		mes "哦……" + strcharinfo(0) + "，是你啊？";
		mes "听说各地的英雄都会参加宴会，我还在想你会不会来。";
		emotion ET_SURPRISE;
		cutin "tama_cook_2",2;
		next;
		mes "[Tamarin]";
		mes "你享受这场宴会吗……";
		mes "……等等！你看起来好像……";
		emotion ET_HUK;
		cutin "tama_cook_4",2;
		next;
		mes "[Tamarin]";
		mes "不会吧！";
		mes "" + strcharinfo(0) + "，你也遇到那种事了吗？";
		next;
		mes "[Tamarin]";
		mes "我到处寻找更多食物给迪尤时，有人把我带到主厨那里，让我在那里工作！";
		cutin "tama_cook_1",2;
		next;
		mes "[Tamarin]";
		mes "他们忙着准备宴会，我根本没时间解释……结果我就……";
		emotion ET_CRY;
		cutin "tama_cook_4",2;
		next;
		mes "[Tamarin]";
		mes "哈哈……他们实在太忙了，我也没法直接辞掉工作……";
		mes "哈哈……哈哈哈哈哈……";
		next;
		mes "[Tamarin]";
		mes "我想对我来说已经太迟了……";
		mes "哈哈哈哈……";
		next;
		mes "[Tamarin]";
		mes "如果你在宴会厅找到迪尤，请告诉他我太忙了，没办法带着食物回去。";
		mes "哈哈哈哈哈……";
		cutin "tama_cook_3",2;
		erasequest 11413;// Why Should I Prepare for the Banquets?
		setquest 11414;// Why Should I Prepare for the Banquets?
		ep16_cookbs = 16;
		close3;
	}
	if (ep16_cookbs > 15 && ep16_cookbs < 20) {
		mes "[Tamarin]";
		mes "我想对我来说已经太迟了……";
		mes "哈哈哈哈……";
		cutin "tama_cook_4",2;
		next;
		mes "[Tamarin]";
		mes "如果你在宴会厅找到迪尤，请告诉他我太忙了，没办法带着食物回去。";
		mes "哈哈哈哈哈……";
		cutin "tama_cook_3",2;
		close3;
	}
	if (ep16_cookbs == 20) {
		mes "[Tamarin]";
		mes "……呼，那是我姐姐。";
		mes "那么，" + strcharinfo(0) + "，你要不要和我一起享受宴会……";
		emotion ET_DELIGHT;
		cutin "tama_cook_3",2;
		next;
		mes "[Tamarin]";
		mes "……我想我们应该把一直在做的事完成！";
		cutin "tama_cook_1",2;
		next;
		mes "[Tamarin]";
		mes "我应该把用过的餐具送到厨房。";
		mes "我们一起做会省些时间。赶紧做完，然后去吃点好吃的吧！";
		cutin "tama_cook_3",2;
		erasequest 11418;// Why Should I Prepare for the Banquets?
		setquest 11419;// Why Should I Prepare for the Banquets?
		ep16_cookbs = 21;
		close3;
	}
	if (ep16_cookbs == 21) {
		mes "[Tamarin]";
		mes "我想我们应该把一直在做的事完成！";
		cutin "tama_cook_1",2;
		next;
		mes "[Tamarin]";
		mes "我应该把用过的餐具送到厨房。";
		mes "我们一起做会省些时间。赶紧做完，然后去吃点好吃的吧！";
		cutin "tama_cook_3",2;
		close3;
	}
	if (ep16_cookbs == 22) {
		mes "[Tamarin]";
		mes "嗯……我接下来该做什么……";
		cutin "tama_cook_1",2;
		close3;
	}
	mes "[Tamarin]";
		mes "哇……" + strcharinfo(0) + "，谢谢你。";
		mes "现在我终于能喘口气了……";
	cutin "tama_cook_3",2;
	next;
	mes "[Tamarin]";
		mes "哦……我实在没办法辞职……";
		mes "我向主厨报告后正要离开时，被马克的哥哥抓住了。";
	cutin "tama_cook_1",2;
	next;
	mes "[Tamarin]";
		mes "我想如果就这样放弃，生活会轻松很多。";
	emotion ET_HNG;
	cutin "tama_cook_3",2;
	close3;
}

prt_cas,358,124,0	script	Grilled Griffon#ep16_1	4_EP16_FOOD,{
	if (ep16_royal < 2) {
		mes "看起来很美味的烤狮鹫。";
		close;
	}
	if (ep16_cookbs == 14) {
		mes "请将餐盘小心地放在台面上。";
		next;
		mes "[Tamarin]";
		mes "Haaaaaaa!";
		mes "这是怎么回事……";
		npctalk "啊啊啊啊！", "Tamarin#ep16_1", bc_self;
		cutin "tama_cook_4",2;
		erasequest 11399;// Why Should I Prepare for the Banquets?
		setquest 11413;// Why Should I Prepare for the Banquets?
		ep16_cookbs = 15;
		close3;
	}
	if (isbegin_quest(11424) == 1) {
		if (checkweight(1119,3) == 0) {
		mes "- 你持有的物品太多了。";
		mes "请整理物品栏后再试。 -";
			close;
		}
		mes "请将餐盘小心地放在台面上。";
		erasequest 11424;// Banquet: Griffin Barbecue
		setquest 11425;// Complete Today's Grilled Griffin
		getitem 6919,4;// TokenOfHonor
	}
	mes "看起来很美味的烤狮鹫。";
	close;
}

prt_cas_q,30,128,0	script	#ep16_evt_neriusroom	HIDDEN_WARP_NPC,2,2,{
	end;
OnTouch:
	if (ep16_royal == 15) {
		cloakonnpcself( "Bodyguard Crux#ep16_room01" );
		cloakonnpcself( "Spica Nerius#ep16_room01" );
		cloakonnpcself( "Skia Nerius#ep16_room01" );
		cloakoffnpcself( "Spica Nerius#ep16_room02" );
	}
	else if (ep16_royal > 2 && ep16_royal < 7) {
		cloakonnpcself( "Bodyguard Crux#ep16_room01" );
		cloakonnpcself( "Spica Nerius#ep16_room01" );
		cloakonnpcself( "Skia Nerius#ep16_room01" );
	}
	else if (ep16_royal > 17)
		cloakonnpcself( "Skia Nerius#ep16_room01" );
	end;
}


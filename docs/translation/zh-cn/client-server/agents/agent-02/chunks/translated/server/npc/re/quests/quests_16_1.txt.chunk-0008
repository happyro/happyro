// Hall
prt_cas,82,268,5	script	Mark Ishar#ep16_1	4_EP16_MARK,{
	if (ep16_cookbs == 18) {
		mes "[Mark]";
		mes "你好，" + strcharinfo(0) + "。";
		mes "你玩得开心吗？";
		mes "需要我帮忙吗？";
		npctalk "你好。", "Mark Ishar#ep16_1", bc_self;
		emotion ET_DELIGHT;
		cutin "mark_wt_4",0;
		next;
		select("告诉他塔玛琳的事。");
		mes "[Mark]";
		mes "哦！";
		mes "他……";
		mes "他居然嘲笑我在这里工作！真是太好了！";
		emotion ET_FRET;
		cutin "mark_wt_2",0;
		next;
		mes "[Mark]";
		mes "请告诉他要努力工作！";
		mes "哈哈哈哈哈！";
		cutin "mark_wt_4",0;
		next;
		mes "[Alice]";
		mes "哦，塔玛琳就是那个经常失踪的朋友，对吧？";
		cutin "acact_03",2;
		erasequest 11416;// Why Should I Prepare for the Banquets?
		setquest 11417;// Why Should I Prepare for the Banquets?
		ep16_cookbs = 19;
		close3;
	}
	if (ep16_cookbs == 19) {
		mes "[Mark]";
		mes "Oh!";
	mes "他……";
		mes "他居然嘲笑我在这里工作！真是太好了！";
		cutin "mark_wt_2",0;
		next;
		mes "[Mark]";
		mes "请告诉他要努力工作！";
		mes "哈哈哈哈哈！";
		cutin "mark_wt_4",0;
		next;
		mes "[Alice]";
		mes "哦，塔玛琳就是那个经常失踪的朋友，对吧？";
		cutin "acact_03",2;
		close3;
	}
	if (ep16_cookbs == 20) {
		mes "[Mark]";
		mes "" + strcharinfo(0) + "，请把那件事告诉塔玛琳。";
		mes "我希望能摆脱宴会准备工作。";
		cutin "mark_wt_1",0;
		close3;
	}
	mes "[Mark]";
	mes "你好，" + strcharinfo(0) + "。";
	mes "你玩得开心吗？";
	mes "需要我帮忙吗？";
	npctalk "你好。", "Mark Ishar#ep16_1", bc_self;
	emotion ET_DELIGHT;
	cutin "mark_wt_4",0;
	close3;
}

prt_cas,83,270,3	script	Alice Ishar#ep16_1	4_F_ACOLYTE,{
	if (ep16_cookbs < 19) {
		mes "[Alice]";
		mes "马克！你不该放在那里。放到这里来……";
		mes "既然我们在宫殿工作，就连最细小的事情也不能忽视！";
		cutin "acact_01",2;
		close3;
	}
	if (ep16_cookbs == 19) {
		mes "[Alice]";
		mes "嗯……我知道你很忙，但这是宫殿的事务，不能无缘无故让别人工作。";
		cutin "acact_03",2;
		next;
		mes "[Alice]";
		mes "我会告诉他们。你能通知塔玛琳吗？";
		mes "宴会结束前，宴会准备工作都不会结束。";
		cutin "acact_01",2;
		erasequest 11417;// Why Should I Prepare for the Banquets?
		setquest 11418;// Why Should I Prepare for the Banquets?
		ep16_cookbs = 20;
		close3;
	}
	if (ep16_cookbs == 20) {
		mes "[Alice]";
		mes "我会告诉他们。你能通知塔玛琳吗？";
		mes "宴会结束前，宴会准备工作都不会结束。";
		cutin "acact_01",2;
		close3;
	}
	mes "[Alice]";
		mes "哦！事情怎么样了？";
		mes "嗯，大家都这么忙，什么事都有可能发生。";
		mes "哈哈哈。";
	cutin "acact_02",2;
	close3;
}


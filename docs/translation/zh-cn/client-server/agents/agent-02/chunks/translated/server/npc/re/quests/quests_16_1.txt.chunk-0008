prt_cas_q,20,139,3	script	Spica Nerius#ep16_room01	4_EP16_SPICA,{
	if (ep16_royal < 2) {
		mes "[Spica]";
		mes "你是受邀参加宴会的吗？";
		mes "这里不是宴会厅。";
		close3;
	}
	if (ep16_royal == 2) {
		switch( isbegin_quest(7684) ) {
		case 0:
			mes "[Spica]";
		mes "你一定就是大家都在谈论的" + strcharinfo(0) + "。";
		mes "谢谢你来看望我们。";
		mes "我是尼鲁斯家族的斯皮卡。";
			cutin "ep16_spica_nerius01",1;
			next;
			mes "[Skia]";
		mes "我是斯琪亚。";
		mes "很高兴见到你。";
			cutin "ep16_skia_nerius01",0;
			next;
			mes "[Spica]";
		mes "他是我的护卫。";
			cutin "ep16_spica_nerius01",1;
			next;
			mes "[Crux]";
		mes "我的名字是克鲁克斯·芬德尔。";
		mes "我正在尼鲁斯家族学习剑术。";
			cutin "ep16_crux_findel01",2;
			next;
			mes "[Spica]";
		mes "我们的母亲，也就是家族现任家主，本来应该在这里。";
		mes "不过听说像你，" + strcharinfo(0) + "，这样的许多英雄会参加这场宴会，";
			cutin "ep16_spica_nerius01",1;
			next;
			mes "[Spica]";
		mes "母亲就让我们来这里与他们见面并向他们学习。";
			next;
		select("王位候选人在哪里？");
			cutin "ep16_spica_nerius05",1;
			mes "[Spica]";
		mes "哦，你一定是受邀来观礼的……";
		mes "我明白了。";
		npctalk "他应该在图书馆。", "Bodyguard Crux#ep16_room01", bc_self;
			next;
			cutin "ep16_spica_nerius01",1;
			mes "[Spica]";
		mes "埃里希在王室图书馆。";
		mes "我想他可能在寻找某种让他感兴趣的设计图。";
			next;
			cutin "ep16_spica_nerius02",1;
			mes "[Spica]";
		mes "尼鲁斯对王位不感兴趣。";
		mes "埃里希本来不必参加王室会议。";
			next;
			cutin "ep16_spica_nerius01",1;
			mes "[Spica]";
		mes "既然他只是名义上的候选人，现在一定是在做自己想做的事。";
			next;
		select("你为什么对王位不感兴趣？");

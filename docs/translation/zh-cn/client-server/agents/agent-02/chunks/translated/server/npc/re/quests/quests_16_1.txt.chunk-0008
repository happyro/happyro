		close3;
	}
	mes "[Magi]";
	mes "……我想这不是偶然，而是命中注定……";
	cutin "bu_maggi2",2;
	close3;
}

prt_cas,111,235,3	script	Dyu Rianne#ep16_1	4_M_REDMAN,{

		if (checkweight(1201,1) == 0 || MaxWeight - Weight < 3500) {
		mes "你携带的物品太多了。";
		mes "最好减轻负重。";
			close;
		}
		mes "[Yoop]";
		mes "要再试一次吗？";
		mes "我再给你一些红宝石。";
		next;
		if (countitem(12384)) delitem 12384,countitem(12384); //Rainbow_Ruby_Water
		if (countitem(12386)) delitem 12386,countitem(12386); //Rainbow_Ruby_Wind
		if (countitem(12387)) delitem 12387,countitem(12387); //Rainbow_Ruby_Earth
		if (countitem(12385)) delitem 12385,countitem(12385); //Rainbow_Ruby_Fire
		getitem 12384,5; //Rainbow_Ruby_Water
		getitem 12386,5; //Rainbow_Ruby_Wind
		getitem 12387,5; //Rainbow_Ruby_Earth
		getitem 12385,5; //Rainbow_Ruby_Fire
		close2;
		warp "job3_war01",23,20;
		end;
	} else if (job_wl == 8) {
		mes "[Yoop]";
		mes "你成功结晶了空洞之石。";
		mes "抱歉，我曾经怀疑你。";
		if (countitem(12384)) delitem 12384,countitem(12384); //Rainbow_Ruby_Water
		if (countitem(12386)) delitem 12386,countitem(12386); //Rainbow_Ruby_Wind
		if (countitem(12387)) delitem 12387,countitem(12387); //Rainbow_Ruby_Earth
		if (countitem(12385)) delitem 12385,countitem(12385); //Rainbow_Ruby_Fire
		next;
		mes "[Yoop]";
		mes "所有测试都完成了。现在去和Engoloria大师谈谈。";
		mes "我很高兴你成功了。";
		set job_wl,9;
		changequest 11111,11112;
		close;
	} else if (job_wl == 9) {
		mes "[Yoop]";
		mes "所有测试都完成了。现在去和Engoloria大师谈谈。";
		mes "我很高兴你成功了。";
		close;
	} else {
		mes "[Yoop]";
		mes "我能感觉到你拥有强大的魔力。";
		mes "我真羡慕你。";
		next;
		mes "[Yoop]";
		mes "它值得特别对待。";
		mes "不要滥用它。";
		close;
	}
}

spl_in02,78,110,5	script	Assistant#Warlock3	437,{
	if (job_wl == 0) {
		callfunc "F_Warlock";
		end;
	}
	mes "[Assistant]";
	mes "......";
	switch(job_wl) {
		case 1: mes "没什么要对我说的话，就离开吧。"; break;
		case 2: mes "我没有马尾……"; break;
		default: mes "我师父冥想时请保持安静。"; break;
	}
	next;
	switch(select("Leave:Stay")) {
	case 1:
		mes "[Assistant]";
		mes "那请小心。";
		close2;
		warp "splendide",200,100;
		end;
	case 2:
		mes "[Assistant]";
		mes "......";
		close;
	}
}

spl_in02,80,108,5	script	Guild Master#Warlock	465,{
	if (job_wl == 0) {
		callfunc "F_Warlock";
		end;
	} else if (job_wl == 1) {
		mes "[Master Egnoloria]";
		mes "你有事要问我吗？";
		next;
		switch(select("How can I be a Warlock?:Cancel.")) {
		case 1:
			if (VIP_SCRIPT) {
				callfunc "VIP_Third_Class";
				set job_wl,2;
				setquest 11106;
				next;
			}
			mes "[Master Egnoloria]";
			mes "你是认真的吗？";
			mes "人类，你渴望力量，对吧。";
			next;
			mes "[Master Egnoloria]";
			mes "变得更强的强烈欲望会让你的灵魂更加美丽。";
			next;
			mes "[Master Egnoloria]";
			mes "但是，我需要确认你是否合格。";
			next;
			mes "[Master Egnoloria]";
			mes "Yoop！";
			next;
			mes "[Yoop]";
			mes "是！！";
			next;
			mes "[Master Egnoloria]";
			mes "把这个交给人类。";
			next;
			mes "[Master Egnoloria]";
			mes "去和那个头发奇怪的男人谈谈。";
			mes "他会告诉你该做什么。";
			set job_wl,2;
			setquest 11106;
			close;
		case 2:
			mes "[Master Egnoloria]";
			mes "很好。";
			mes "你是人类，所以这给你。";
			close2;
			warp "splendide",200,100;
			end;
		}
	} else if (job_wl == 2) {
		mes "[Master Egnoloria]";
		mes "我正在冥想，我说过要和Yoop谈。";
		mes "Yoop有一条有趣的马尾。";
		mes "别打扰我。";
		close;
	} else if (job_wl == 3 || job_wl == 4) {
		mes "[Master Egnoloria]";
		mes "……";
		next;
		mes "[Assistant]";
		mes "师父正在冥想。";
		mes "请安静。";
		close;
	} else if (job_wl == 5) {
		mes "[Master Egnoloria]";
		mes "我听Yoop说可以制造一种非常有用的石头。";
		next;
		mes "[Master Egnoloria]";
		mes "它可以用来制作施展强大魔法的魔法首饰。";
		next;
		mes "[Master Egnoloria]";
		mes "Yoop。";
		next;
		mes "[Yoop]";
		mes "是，师父！";
		next;
		mes "[Master Egnoloria]";
		mes "请带他去魔法房间。";
		next;
		mes "[Yoop]";
		mes "好的，师父。";
		mes "请跟我来。";
		emotion ET_AHA, getnpcid(0, "Assistant#Warlock2");
		set job_wl,6;
		changequest 11108,11109;
		close;
	} else if (job_wl < 9) {
		mes "[Master Egnoloria]";
		mes "......";
		next;
		mes "[Yoop]";
		mes "我师父现在正在冥想，请跟我来。";
		close;
	} else if (job_wl == 9) {
		if (BaseLevel < 99 || BaseJob != Job_Wizard) {
			mes "[Master Egnoloria]";
		mes "嗯……？";
		mes "你是怎么走到这一步的……";
			close;
		}
		if (checkweight(1201,1) == 0 || MaxWeight - Weight < 3500) {
		mes "你携带的物品太多了。";
		mes "减少物品后再回来。";
			close;
		}
		mes "[Master Egnoloria]";
		if (SkillPoint != 0) {
			mes "除非你喜欢当前职业，否则应该使用所有技能点。";
			close;
		}
		if (ismounting()) {
			mes "你正骑着坐骑，";
			mes "所以无法转职。";
			mes "请卸下坐骑后再试！";
			close;
		}
		mes "美丽的光芒……";
		mes "别让我对你失望……";
		next;
		mes "[Master Egnoloria]";
		mes "你已经成为术士的一员。";
		mes "为此感到自豪吧。";
		next;
		if (SkillPoint != 0) {
		mes "^0000ff你还剩技能点，请使用全部技能点后重新开始！^000000";
			close;
		}
		mes "[Master Egnoloria]";
		mes "这块结晶魔法石会保护你。";
		if (Class == Job_High_Wizard) {
			if (JobLevel > 69) set job_wl,13;
			else if (JobLevel > 59) set job_wl,12;
			else set job_wl,11;
		}
		else set job_wl,10;
		jobchange roclass(eaclass()|EAJL_THIRD);
		completequest 11112;
		getitem 5753,1; //Magic_Stone_Hat
		getitem 2795,1; //Green_Apple_Ring
		close;
	} else if (job_wl > 9) {
		mes "[Master Egnoloria]";
		mes "你适应术士的力量了吗？";
		mes "如果粗心大意，就会被自己的力量推翻。";
		close;
	}
}

job3_war01,22,22,7	script	Yoop#WRR	439,{

lou_in02,53,174,7	script	Employee#1	822,6,62,{
	if (gettime(DT_HOUR) >= 10 && gettime(DT_HOUR) < 22) {
		mes "[Chang Pai]";
		mes "欢迎，欢迎！我们已经准备好为您服务~！现在请上楼~！";
		close;
	}
	mes "[Chang Pai]";
	mes "^666666*哈欠……*^000000";
	close;

OnTouch_:
	if (ch_tre == 2 || ch_tre == 3) {
		if (gettime(DT_HOUR) >= 10 && gettime(DT_HOUR) < 14) {
			if (rand(1,10) < 9) {
				mes "[Chang Pai]";
				mes "等等，你是谁？！放下那个，现在马上出去！";
				next;
				mes "^3131FF你偷锅失败了。^000000";
				set ch_tre,1;
				close;
			}
		}
		else if (gettime(DT_HOUR) >= 14 && gettime(DT_HOUR) < 17) {
			if (rand(1,10) < 10) {
				mes "[Chang Pai]";
				mes "等等，你是谁？！放下那个，现在马上出去！";
				next;
				mes "^3131FF你失败了^000000";
				mes "^3131FF没能偷走锅。^000000";
				set ch_tre,1;
				close;
			}
		}
		else if (gettime(DT_HOUR) >= 17 && gettime(DT_HOUR) < 21) {
			if (rand(1,10) < 6) {
				mes "[Chang Pai]";
				mes "等等，你是谁？！放下那个，现在马上出去！";
				next;
				mes "^3131FF你失败了^000000";
				mes "^3131FF没能偷走锅。^000000";
				set ch_tre,1;
				close;
			}
		}
		else {
			if (rand(1,10) < 5) {
				mes "[Chang Pai]";
				mes "^666666*哈欠……*^000000";
				mes "好困……";
				next;
				mes "[Chang Pai]";
				mes "嗯……？你是谁！？嘿，这里有小偷！";
				next;
				mes "^3131FF你失败了^000000";
				mes "^3131FF没能偷走锅。^000000";
				set ch_tre,1;
				close;
			}
		}
	}
	end;
}

lou_in02,76,181,3	script	Employee#2	822,2,2,{

lou_in02,62,183,3	script	Chef#1-2	820,2,2,{
	if (ch_tre > 0 && ch_tre < 4) {
		mes "[Wang Shi Long]";
		mes "嗯？你是客人吗？我是王世龙，这家餐厅的厨师。";
		next;
		mes "[Wang Shi Long]";
		mes "我们家族长期为白龙大人提供食物。这家餐厅由家族所有，我是继承人。";
		next;
		mes "[Wang Shi Long]";
		mes "我们家族烹制的每道菜都是洛阳最美味的食物之一。";
		next;
		mes "[Wang Shi Long]";
		mes "我们的龙汤尤其受到白龙大人的高度赞赏。";
		next;
		mes "[Wang Shi Long]";
		mes "我还可以自豪地告诉你，我们只使用最新鲜、最高品质的食材。";
		next;
		mes "[Wang Shi Long]";
		mes "凭借美食的品质，我们数百年来一直在洛阳广受欢迎。";
		next;
		mes "[Wang Shi Long]";
		mes "不过最近我有种不好的预感，有人想接管我们的餐厅……";
		next;
		mes "[Wang Shi Long]";
		mes "哦，也许是其他原因让我心情不同。应该没什么。";
		close;
	}
	else if (ch_tre > 3 && ch_tre < 6) {
		mes "[Wang Shi Long]";
		mes "^666666*Moans and Cries*^000000";
		mes "看来就是这样了……！我家族荣耀的终结。有人偷走了龙汤的底汤！";
		next;
		mes "[Wang Shi Long]";
		mes "我现在该怎么办？没有龙汤，我们家的餐厅就会和其他餐厅一样了……";
		close;
	}
	mes "[Wang Shi Long]";
	mes "你好，你是我们的客人吗？我是王世龙，这家餐厅的厨师。";
	next;
	mes "[Wang Shi Long]";
	mes "我们家族长期为白龙大人提供食物。这家餐厅代代相传，我是继承人~";
	next;
	mes "[Wang Shi Long]";
	mes "我们的招牌菜龙汤受到白龙大人的高度赞赏，他以极其挑剔的味觉闻名。";
	next;
	mes "[Wang Shi Long]";
	mes "我也很自豪，我们只用最新鲜、最高品质的食材烹饪。";
	next;
	mes "[Wang Shi Long]";
	mes "凭借高品质美食，我们数百年来一直在洛阳广受欢迎。";
	next;
	mes "[Wang Shi Long]";
	mes "在这种干燥炎热的天气里，龙汤最适合开胃。我建议你尝一碗，一定会满意！";
	close;

OnTouch_:
	if (ch_tre == 2 || ch_tre == 3) {
		if (gettime(DT_HOUR) >= 10 && gettime(DT_HOUR) < 14) {
			if (rand(1,10) < 9) {
				mes "[Wang Shi Long]";
		mes "嘿，你以为自己在做什么？！放下那个，快出去！";
				next;
				mes "^3131FF你失败了^000000";
				mes "^3131FF没能偷走锅。^000000";
				set ch_tre,1;
				warp "louyang",280,161;
				close;
			}
		}
		else if (gettime(DT_HOUR) >= 14 && gettime(DT_HOUR) < 17) {
			if (rand(1,10) < 10) {
				mes "[Wang Shi Long]";
		mes "嘿，你以为自己在做什么？！放下那个，快出去！";
				next;
				mes "^3131FF你失败了^000000";
				mes "^3131FF没能偷走锅。^000000";
				set ch_tre,1;
				warp "louyang",280,161;
				close;
			}
		}
		else if (gettime(DT_HOUR) >= 17 && gettime(DT_HOUR) < 22) {
			if (rand(1,10) < 6) {
				mes "[Wang Shi Long]";
				mes "嘿，你以为自己在做什么？！放下那个，快出去！";
				next;
				mes "^3131FF你失败了^000000";
				mes "^3131FF没能偷走锅。^000000";
				set ch_tre,1;
				warp "louyang",280,161;
				close;
			}
		}
		else {
			if (rand(1,10) < 5) {
				mes "[Wang Shi Long]";
				mes "^666666*Yawn...*^000000";
		mes "嗯……？那是谁？";
				next;
				mes "[Wang Shi Long]";
		mes "等等……！你在做什么？！快、快出去！";
				next;
				mes "^3131FF你失败了^000000";
				mes "^3131FF没能偷走锅。^000000";
				set ch_tre,1;
				warp "louyang",280,161;
				close;
			}
		}
	}
	end;
}

lou_fild01,195,177,5	script	Jiu Lian Bu#1-1	819,{
	//Remove outdated variables and attempt to preserve prior quest progress.
	if (QL_ACCEPTSOUP) set ch_tre,1;
	if (QL_GOTDRAGONSOUP) set ch_tre,2;
	if (QL_GOTFAKESOUP) set ch_tre,3;
	if (QL_SOUPQUEST)  set ch_tre,4;
	if (QL_SOUP2) set ch_tre,5;

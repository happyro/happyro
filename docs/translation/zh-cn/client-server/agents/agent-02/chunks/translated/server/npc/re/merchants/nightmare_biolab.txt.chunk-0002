	disable_items;
	mes "[恶霸]";
	mes "嘿，朋友。你还有剩余的能量碎片吗？如果你愿意，我可以帮你兑换成合适的东西。";
	next;
	.@s = select(
		"听故事。",
		( countitem(25127) < 2000 ? "^777777" : "^000000" ) + "1个能量碎片（2000个寂静能量粒子）",
		( countitem(25128) < 1000 ? "^777777" : "^000000" ) + "1个能量碎片（1000个微弱能量粒子）",
		( countitem(25129) < 500 ? "^777777" : "^000000" ) + "1个能量碎片（500个不稳定能量粒子）",
		( countitem(25130) < 500 ? "^777777" : "^000000" ) + "1个能量碎片（500个邪恶能量粒子）",
		( countitem(25131) < 50 ? "^777777" : "^000000" ) + "1个能量碎片（50个堕落能量粒子）",
		( countitem(6820) < 50 ? "^777777" : "^000000" ) + "1个感伤碎片（50个能量碎片）",
		( countitem(6820) < 666 ? "^777777" : "^000000" ) + "1个诅咒碎片（666个能量碎片）"
	) - 2;
	if (.@s == -1) {
		emotion ET_THINK;
		mes "[恶霸]";
		mes ". . . . . . .";
		next;
		mes "[恶霸]";
		mes "嗯……真出乎意料。";
		mes "通常他会无视我，继续做自己的工作。";
		next;
		mes "[恶霸]";
		mes "抱歉，我没什么可说的。我只是因为能赚很多钱才做这个。";
		close;
	}
	setarray .@exchange[0],
		6820, 25127,2000,	// Silent Energy Particle -> Energy Fragment
		6820, 25128,1000,	// Weak Energy Particles -> Energy Fragment
		6820, 25129,500,	// Unstable Energy Particle -> Energy Fragment
		6820, 25130,500,	// Sinister Energy Particle -> Energy Fragment
		6820, 25131,50,		// Fallen Energy Particle -> Energy Fragment
		22687, 6820,50,		// Energy Fragment -> Sentimental Fragment
		23016, 6820,666;	// Energy Fragment -> Cursed Fragment
	.@index = .@s * 3;
	mes "[恶霸]";
	mes "你确定要用^330066" + .@exchange[.@index+2] + " " + getitemname(.@exchange[.@index+1]) + "^000000兑换^CC33331" + getitemname(.@exchange[.@index]) + "^000000?";
	next;
	if (select( "兑换。", "不兑换。" ) == 2) {
		emotion ET_HNG;
		mes "[恶霸]";
		mes "好吧……如果你不喜欢，那就算了。";
		close;
	}
	while(true) {
		if (countitem(.@exchange[.@index+1]) < .@exchange[.@index+2]) {
			emotion ET_SCRATCH;
			mes "[恶霸]";
			mes "不……不……你不该这样做。";
			mes "你说过你会用" + .@exchange[.@index+2] + "个物品来兑换它。";
			close;
		}
		delitem .@exchange[.@index+1], .@exchange[.@index+2];
		getitem .@exchange[.@index], 1;
		emotion ET_SEXY;
		mes "[恶霸]";
		mes "哦，谢谢。还想兑换其他东西吗？";
		next;
		if (select( "继续兑换。", "停止兑换。" ) == 2) {
			mes "[恶霸]";
			mes "还有能量碎片时，再来找我。";
			close;
		}
	}
}

// Enchants NPCs
lhz_dun_n,145,265,4	script	Silent Mind#JCv2	4_CENERE,{
	disable_items;
	mes "[寂静之心]";
	mes ". . . . . .!";
	mes "...";
	mes "^FF0000*向寂静之心交出3个相同类型的灵魂，即可获得死亡之箱。*^000000";
	next;
	setarray .@item[0],6814,6815,6816,6817,6818,6819;
	for ( .@i = 0; .@i < 6; ++.@i ) {
		if (countitem(.@item[.@i]) < 3)
			.@menu$ += "^777777数量不足" + getitemname(.@item[.@i]) + ".^000000:";
		else
			.@menu$ += "交出3个" + getitemname(.@item[.@i]) + ".:";
	}
	.@s = select(.@menu$) - 1;
	while(true) {
		if (countitem(.@item[.@s]) < 3) {
			emotion ET_HNG;
			mes "[寂静之心]";
			mes "！…… …… ……";
			mes "^FF0000*需要3个相同类型的灵魂才能兑换死亡之箱。*^000000";
			close;
		}
		delitem .@item[.@s],3;
		getitem 22679,1;// Chest_of_Death
		emotion ET_HUNGRY;
		mes "[寂静之心]";
		mes ". . . . . .";
		mes "...";
		mes "^FF0000*你获得了死亡之箱。要继续兑换吗？*^000000";
		next;
		if (select( "继续兑换。", "停止兑换。" ) == 2) {
			mes "[寂静之心]";
			mes ". . . . . .";
			close;
		}
	}
}

lhz_dun_n,134,265,2	script	Wandering Mind#JCv2	4_CENERE,{
	disable_items;
	npctalk "咔咔……我能……感知……", "", bc_self;
	mes "[Wandering Mind]";
	mes "咔咔……我能……感知……无数实验体的……怨念……";
	next;
	npctalk "我……是谁……？", "", bc_self;
	mes "[Wandering Mind]";
	mes "这里……是哪里……？这里……？啊啊……我……是谁？我……想不起来……";
	next;
	mes "[Wandering Mind]";
	mes "我需要……怨念……怨念的……强大力量……它会同时帮助……我……和你们所有人……咔咔……";
	next;
	switch( select( "旧头盔附魔", "重置旧头盔", "旧头盔附魔说明" ) ) {
	case 1:
		npctalk "交出来……怨念……怨念……", "", bc_self;
		mes "[Wandering Mind]";
		mes "咔咯……呵呵……交出……怨念的……强大力量……我会把特殊力量……附魔到头盔上……";
		mes "^FF0000*带来诅咒碎片，即可为旧头盔进行附魔。*^000000";
		next;
		.@equip_id = getequipid(EQI_HEAD_TOP);
		switch(.@equip_id) {
			case 18971:// Old_Rune_Circlet
			case 18972:// Old_Mitra
			case 18973:// Old_Driver_Band_R
			case 18974:// Old_Driver_Band_Y
			case 18975:// Old_Shadow_Handicraft
			case 18976:// Old_Minstrel_Song_Hat
			case 18977:// Old_Midas_Whisper
			case 18978:// Old_Magic_Stone_Hat
			case 18979:// Old_Blazing_Soul
			case 18980:// Old_Wind_Whisper
			case 18981:// Old_Dying_Swan
			case 18982:// Old_Circlet_Of_Bone
			case 18983:// Old_Protect_Of_Crown
			case 18984:// Old_Camo_RabbitHood
				break;
			default:
				npctalk "毁掉它……毁掉它……", "", bc_self;
				mes "[Wandering Mind]";
				mes "这很……有趣……那顶头盔里……没有气息……充满特殊力量……你想……毁掉它吗……咔咔……";
				mes "^FF0000*只有旧头盔可以使用诅咒碎片附魔。*^000000";
				close;
		}
		mes "[Wandering Mind]";
	
		.@requirement = 10;	// 10 Cursed Fragments by default
		setarray .@card[0], getequipcardid(EQI_HEAD_TOP,0), getequipcardid(EQI_HEAD_TOP,1), getequipcardid(EQI_HEAD_TOP,2), getequipcardid(EQI_HEAD_TOP,3);
		.@refine = getequiprefinerycnt(EQI_HEAD_TOP);
	
		if (.@card[3] == 0) {
			.@slot = 3;
			mes "要不要……先轻轻开始……？测试……你的运气……咔……呵呵……";
			mes "^FF0000*尝试附魔第4槽位。将随机附魔6种状态中的一种。*^000000";
		}
		else if (.@card[2] == 0) {
			.@slot = 2;
			mes "咔……呵呵……你……喜欢……第一次……附魔吗……？";
			mes "^FF0000*尝试附魔第3槽位。将随机附魔6种状态中的一种。*^000000";
		}
		else if (.@card[1] == 0) {
			.@slot = 1;
			mes "咔……呵呵……是否会出现……获得更强力量的……道路……现在……就要决定了……";
			mes "^FF0000*尝试附魔第2槽位。";
			mes "成功附魔坚韧、魔法精髓、锐利、神射手、金刚、不屈后，可以进行强化。*^000000";
		}
		else {
			// enchant leveling
			switch( .@card[1] ) {
			case 29061:	// Ambition1Lv
			case 29071:	// Tab1Lv
			case 29081:	// Expect1Lv
			case 29091:	// ArchLine1Lv
			case 29101:	// Steel1Lv
			case 29111:	// Mercy1Lv
			case 29706:	// Tenacity1Lv
				mes "咔……呵……呵……你……真幸运……祝你一切顺利！……这样你才会……带着更多怨念……来找我……我想……";
				.@requirement = 20;
				.@enchant_level = 1;
				.@enchant_rate = 70;
				break;
			case 29062:	// Ambition2Lv
			case 29072:	// Tab2Lv
			case 29082:	// Expect2Lv
			case 29092:	// ArchLine2Lv
			case 29102:	// Steel2Lv
			case 29112:	// Mercy2Lv
			case 29707:	// Tenacity2Lv
				mes "第3级……强化……？成功的话……你会获得……更强的力量……但失败的话……你迄今积累的力量……都会失去……";
				.@requirement = 40;
				.@enchant_level = 2;
				.@enchant_rate = 50;
				break;
			case 29063:	// Ambition3Lv
			case 29073:	// Tab3Lv
			case 29083:	// Expect3Lv
			case 29093:	// ArchLine3Lv
			case 29103:	// Steel3Lv
			case 29113:	// Mercy3Lv
			case 29708:	// Tenacity3Lv
				mes "第4级……强化……？成功的话……你会获得……更强的力量……但失败的话……你迄今积累的力量……都会失去……";
				.@requirement = 50;
				.@enchant_level = 3;
				.@enchant_rate = 35;
				break;
			case 29064:	// Ambition4Lv
			case 29074:	// Tab4Lv
			case 29084:	// Expect4Lv
			case 29094:	// ArchLine4Lv
			case 29104:	// Steel4Lv
			case 29114:	// Mercy4Lv
			case 29709:	// Tenacity4Lv
				mes "第5级……强化……？你……准备好……控制……如此巨大的力量了吗……？但失败的话……结果会……值得一看……";
				.@requirement = 70;
				.@enchant_level = 4;
				.@enchant_rate = 25;
				break;
			case 29065:	// Ambition5Lv
			case 29075:	// Tab5Lv
			case 29085:	// Expect5Lv
			case 29095:	// ArchLine5Lv
			case 29105:	// Steel5Lv
			case 29115:	// Mercy5Lv
			case 29710:	// Tenacity5Lv
				mes "第6级……强化……？你……准备好……控制……如此巨大的力量了吗……？但失败的话……结果会……值得一看……";
				.@requirement = 100;
				.@enchant_level = 5;
				.@enchant_rate = 18;
				break;
			case 29066:	// Ambition6Lv
			case 29076:	// Tab6Lv
			case 29086:	// Expect6Lv
			case 29096:	// ArchLine6Lv
			case 29106:	// Steel6Lv
			case 29116:	// Mercy6Lv
			case 29711:	// Tenacity6Lv
				// custom text
				mes "第7级……强化……？你……准备好……控制……如此巨大的力量了吗……？但失败的话……结果会……值得一看……";
				.@requirement = 150;
				.@enchant_level = 6;
				.@enchant_rate = 13;
				break;
			case 29067:	// Ambition7Lv
			case 29077:	// Tab7Lv
			case 29087:	// Expect7Lv
			case 29097:	// ArchLine7Lv
			case 29107:	// Steel7Lv
			case 29117:	// Mercy7Lv
			case 29712:	// Tenacity7Lv
				// custom text
				mes "第8级……强化……？你……准备好……控制……如此巨大的力量了吗……？但失败的话……结果会……值得一看……";
				.@requirement = 250;
				.@enchant_level = 7;
				.@enchant_rate = 9;
				break;
			case 29068:	// Ambition8Lv
			case 29078:	// Tab8Lv
			case 29088:	// Expect8Lv
			case 29098:	// ArchLine8Lv
			case 29108:	// Steel8Lv
			case 29118:	// Mercy8Lv
			case 29713:	// Tenacity8Lv
				// custom text
				mes "第9级……强化……？你……准备好……控制……如此巨大的力量了吗……？但失败的话……结果会……值得一看……";
				.@requirement = 500;
				.@enchant_level = 8;
				.@enchant_rate = 6;
				break;
			case 29069:	// Ambition9Lv
			case 29079:	// Tab9Lv
			case 29089:	// Expect9Lv
			case 29099:	// ArchLine9Lv
			case 29109:	// Steel9Lv
			case 29119:	// Mercy9Lv
			case 29714:	// Tenacity9Lv
				// custom text
				mes "第10级……强化……？你……准备好……控制……如此巨大的力量了吗……？但失败的话……结果会……值得一看……";
				.@requirement = 1000;
				.@enchant_level = 9;
				.@enchant_rate = 4;
				break;
			case 29070:	// Ambition10Lv
			case 29080:	// Tab10Lv
			case 29090:	// Expect10Lv
			case 29100:	// ArchLine10Lv
			case 29110:	// Steel10Lv
			case 29120:	// Mercy10Lv
			case 29715:	// Tenacity10Lv
				// custom text
			default:
				mes "咔咯呵呵……不可能……继续强化……这股力量……剩下的唯一办法是……重置……";
				mes "^FF0000*坚韧、魔法精髓、活力、鹰眼、金刚、慈悲";
				mes "只有装备完成附魔后，才能强化附魔等级。*^000000";
				close;
			}
			.@slot = 999;
		}
		next;
		mes "[Wandering Mind]";
		mes "不过……在那之前……我需要确认……你是否有……足够的诅咒碎片……";
		next;
		mes "[Wandering Mind]";
		mes "诅咒……碎片……" + .@requirement + "……是……必需品……不知道……你能否负担得起……？咔……咔……";
		mes "^FF0000*本次附魔需要" + .@requirement + "个诅咒碎片。*^000000";
		next;
		if (select( "支付费用。", "不支付费用。" ) == 2) {
			mes "[Wandering Mind]";
			mes "咔……咔……看来……你还没有……准备好接受……如此巨大的力量……";
			close;
		}
		if (countitem(23016) < .@requirement) {// Cursed Fragment
			mes "[Wandering Mind]";
			mes "咔……咔……你……是在开玩笑吗……？这么一点怨念……怎么能……渴望……那样的力量……？";
			mes "^FF0000*本次附魔需要Cursed Fragment(s) 10 item(s) is(are) required.";
			mes "请确认你拥有的诅咒碎片数量。*^000000";
			close;
		}
		mes "[Wandering Mind]";
		mes "咔咯……呵呵……这是……怨念的力量……我想……这股力量……已经足够强……";
		mes "^FF0000*装备熔炼等级、卡片和装备不会丢失。但根据成功或失败，附魔等级可能会下降。*^000000";
		next;
		if (select( "进行附魔。", "不进行附魔。" ) == 2) {
			mes "[Wandering Mind]";
			mes "咔……咔……看来……你还没有……准备好接受……如此巨大的力量……";
			close;
		}
		progressbar "000000",1;
		delitem 23016, .@requirement;// Cursed Fragment

		// anti-hack
		if (callfunc("F_IsEquipIDHack", EQI_HEAD_TOP, .@equip_id) || callfunc("F_IsEquipCardHack", EQI_HEAD_TOP, .@card[0], .@card[1], .@card[2], .@card[3]) || callfunc("F_IsEquipRefineHack", EQI_HEAD_TOP, .@refine))
			close;

		switch(.@slot) {
		case 3:
		case 2:
			setarray .@enchant[0],
				4700,	// Strength1
				4701,	// Strength2
				4702,	// Strength3
				4703,	// Strength4
				4704,	// Strength5
				4710,	// Inteligence1
				4711,	// Inteligence2
				4712,	// Inteligence3
				4713,	// Inteligence4
				4714,	// Inteligence5
				4720,	// Dexterity1
				4721,	// Dexterity2
				4722,	// Dexterity3
				4723,	// Dexterity4
				4724,	// Dexterity5
				4730,	// Agility1
				4731,	// Agility2
				4732,	// Agility3
				4733,	// Agility4
				4734,	// Agility5
				4740,	// Vitality1
				4741,	// Vitality2
				4742,	// Vitality3
				4743,	// Vitality4
				4744,	// Vitality5
				4750,	// Luck1
				4751,	// Luck2
				4752,	// Luck3
				4753,	// Luck4
				4754;	// Luck5
			.@card[.@slot] = .@enchant[ rand( getarraysize(.@enchant) ) ];	// unknown rates
			break;
		case 1:
			setarray .@enchant[0],
				4703,	// Strength4
				4704,	// Strength5
				4713,	// Inteligence4
				4714,	// Inteligence5
				4723,	// Dexterity4
				4724,	// Dexterity5
				4733,	// Agility4
				4734,	// Agility5
				4743,	// Vitality4
				4744,	// Vitality5
				4753,	// Luck4
				4754,	// Luck5
				29706,	// Tenacity1Lv
				29061,	// Ambition1Lv
				29071,	// Tab1Lv
				29081,	// Expect1Lv
				29091,	// ArchLine1Lv
				29101,	// Steel1Lv
				29111;	// Mercy1Lv
			.@card[1] = .@enchant[ rand( getarraysize(.@enchant) ) ];	// unknown rates
			break;
		case 999:
			// enchant leveling
			if (.@enchant_rate > rand(100))
				.@level_dt = 1;
			else
				.@level_dt = -1;
			.@enchant_level += .@level_dt;
			.@card[1] += .@level_dt;
			if ((.@card[1] < 29061 || .@card[1] > 29120) && (.@card[1] < 29706 || .@card[1] > 29715)) {
				mes "[Wandering Mind]";
				mes "发生了糟糕的事情。";
				close;
			}
			if (.@enchant_level < 1 || .@enchant_level > 10) {
				// item not deleted
				specialeffect2 EF_SUI_EXPLOSION;
				mes "[Wandering Mind]";
				mes "咔……啊啊……！！怨念的力量……陷入了狂乱……不过……幸好力量……太弱……没有爆炸。";
				close;
			}
			break;
		default:
			mes "[Wandering Mind]";
			mes "发生了糟糕的事情。";
			close;
		}
		delequip EQI_HEAD_TOP;
		getitem2 .@equip_id,1,1,.@refine,0,.@card[0],.@card[1],.@card[2],.@card[3];
		if (.@level_dt == -1) {// can only happens during enchant leveling
			specialeffect2 EF_SUI_EXPLOSION;
			mes "[Wandering Mind]";
			mes "咔……啊啊……！！怨念的力量……陷入了狂乱……原本……稳定的力量……也下降了……一级……";
			mes "^FF0000*由于附魔失败，等级下降了一级。*^000000";
			close;
		}
		specialeffect2 EF_FIREHIT;
		mes "[Wandering Mind]";
		mes "成功了……我能感受到怨念的力量变强了。";
		mes "^FF0000*恭喜你，附魔成功。*^000000";
		close;
	case 2:
		.@equip_id = getequipid(EQI_HEAD_TOP);
		switch(.@equip_id) {
			case 18971:// Old_Rune_Circlet
			case 18972:// Old_Mitra
			case 18973:// Old_Driver_Band_R
			case 18974:// Old_Driver_Band_Y
			case 18975:// Old_Shadow_Handicraft
			case 18976:// Old_Minstrel_Song_Hat
			case 18977:// Old_Midas_Whisper
			case 18978:// Old_Magic_Stone_Hat
			case 18979:// Old_Blazing_Soul
			case 18980:// Old_Wind_Whisper
			case 18981:// Old_Dying_Swan
			case 18982:// Old_Circlet_Of_Bone
			case 18983:// Old_Protect_Of_Crown
			case 18984:// Old_Camo_RabbitHood
				break;
			default:
	npctalk "毁掉它……毁掉它……", "", bc_self;
				mes "[Wandering Mind]";
				mes "这很……有趣……那顶头盔里……没有气息……充满特殊力量……你想……毁掉它吗……咔咔……";
				mes "^FF0000*只有旧头盔可以使用诅咒碎片附魔。*^000000";
				close;
		}
		setarray .@card[0], getequipcardid(EQI_HEAD_TOP,0), getequipcardid(EQI_HEAD_TOP,1), getequipcardid(EQI_HEAD_TOP,2), getequipcardid(EQI_HEAD_TOP,3);
		.@refine = getequiprefinerycnt(EQI_HEAD_TOP);

		if (.@card[3] < 1) {// one enchant required
			npctalk "你……真冷静……", "", bc_self;
			mes "[Wandering Mind]";
			mes "咔咔……你看起来很冷静……我给你的东西里……没有……蕴含力量……";
			mes "^FF0000*这顶头盔没有附魔，无法重置。*^000000";
			close;
		}
		npctalk "咔咯……呵呵……今天……我会吃得很好……", "", bc_self;
		mes "[Wandering Mind]";
		mes "咔咔……你……不喜欢这股力量吗……？带来10份心灵力量……我就让这股力量……消失……";
		mes "^FF0000*需要10个感伤碎片才能重置。";
		mes "头盔上的所有附魔都会重置，但装备熔炼等级和1张卡片除外。*^000000";
		next;
		if (select( "无视他。", "支付费用。" ) == 1) {
			npctalk "永远……", "", bc_self;
			mes "[Wandering Mind]";
			mes "我会……等着你……如果你需要我……我会永远……等着你……咔咔……";
			close;
		}
		if (countitem(22687) < 10) {// Sentimental Fragment
			mes "咔……咔……如果你……不带来……";
			mes "10份心灵力量……我会……陷入麻烦……";
			mes "^FF0000*需要10个感伤碎片才能重置。";
			mes "确认你拥有的感伤碎片数量。*^000000";
			close;
		}
		npctalk "咔……咔……", "", bc_self;
		mes "[Wandering Mind]";
		mes "好吧！……我会……重置……旧头盔的附魔……我想……我们或许能吸收……强大的心灵……";
		next;

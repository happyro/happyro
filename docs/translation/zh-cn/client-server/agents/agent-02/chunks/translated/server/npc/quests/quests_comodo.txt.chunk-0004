			mes "也许会把带着那枚硬币的人";
			mes "派来找我，作为";
			mes "对那个人信任的证明。";
			mes "那么，我会为你效劳。现在……";
			next;
			mes "[Hullaris]";
			mes "你具体需要什么？";
			mes "我猜你是来";
			mes "问我关于科莫多的事。";
			mes "作为最年长的长老之一，";
			mes "我比大多数人更了解这个村子……";
			next;
			mes "["+strcharinfo(0)+"]";
			mes "其实我想请你告诉我";
			mes "科莫多奶酪的事。";
			mes "如果它真的存在，";
			mes "我想知道在哪里能找到。";
			next;
			mes "[Hullaris]";
			mes "哦……那个。首先，";
			mes "科莫多奶酪确实存在，";
			mes "也像传说中一样珍贵。";
			mes "不过它并不是真正的奶酪，";
			mes "虽然味道会让你这么认为。";
			next;
			mes "[Hullaris]";
			mes "是的，它是非常稀有的天然物质，";
			mes "并不是用牛奶、羊奶";
			mes "或类似东西制成。";
			mes "不过科莫多奶酪不只是食物。";
			mes "不，它远不止这些……";
			next;
			mes "[Hullaris]";
			mes "吃下科莫多奶酪的人会发现";
			mes "自己的真正潜能被解锁。";
			mes "科莫多奶酪的真名是";
			mes "^3355FF觉醒石^000000。";
			mes "听起来很厉害吧？";
			next;
			mes "[Hullaris]";
			mes "觉醒石是获得某种";
			mes "禁忌力量的关键之一。";
			mes "所以只有最勇敢的冒险者";
			mes "才有机会吃到它。";
			next;
			mes "[Hullaris]";
			mes "你真的想吃科莫多奶酪，";
			mes "看看它的力量会把你带向何方吗？";
			mes "如果是这样，你必须经历巨大挑战才能得到它……";
			next;
			mes "[Hullaris]";
			mes "决定追寻觉醒石后，";
			mes "去找一个名叫";
			mes "^3355FFNigirboran^000000 的人。";
			mes "他会判断你是否";
			mes "配得上科莫多奶酪……";
			set dmdswrd_Q,11;
			next;
			mes "[Hullaris]";
			mes "现在你应该能在";
			mes "科莫多地下洞穴的某处";
			mes "找到正在训练的 Nigiroban。";
			mes "我会通知他你要来……";
			close;
		}
		mes "[Hullaris]";
		mes "爱！爱！";
		mes "一起相爱~";
		mes "爱！爱！";
		mes "一起相爱——嗯？";
		if (Sex == SEX_MALE) {
			mes "小子，你破坏了";
			mes "我的兴致！快走开！";
		}
		else {
			mes "姑娘，你破坏了";
			mes "我的兴致！走开~";
		}
		break;
	case 11:
		mes "[Hullaris]";
		mes "你真的想吃科莫多奶酪，";
		mes "看看它的力量会把你带向何方吗？";
		mes "如果是这样，你必须经历巨大挑战才能得到它……";
		next;
		mes "[Hullaris]";
		mes "决定追寻觉醒石后，";
		mes "去找 ^3355FFNigirboran^000000。";
		mes "他会判断你是否";
		mes "配得上科莫多奶酪……";
		next;
		mes "[Hullaris]";
		mes "现在你应该能在";
		mes "科莫多地下洞穴的某处";
		mes "找到正在训练的 Nigiroban。";
		mes "我会通知他你要来……";
		break;
	case 12:
		mes "[Hullaris]";
		mes "嗯？你没通过 Nigirboran 的测试吗？";
		mes "那就继续训练直到通过。";
		mes "否则，吃科莫多奶酪";
		mes "可能会送命。";
		break;
	case 13:
		mes "[Hullaris]";
		mes "啊，你回来了。";
		mes "你通过 Nigirboran 的小测试了吗？";
		mes "像你这样的冒险者";
		mes "应该不会有问题。";
		mes "我相信你~";
		next;
		mes "^3355FF你出示了那枚";
		mes "这表示你已经通过";
		mes "Nigirboran 的测试，告诉 Hullaris。^000000";
		next;
		mes "[Hullaris]";
		mes "啊，看来我果然没错。";
		mes "很高兴看到你证明了自己";
		mes "有资格吃科莫多奶酪，";
		mes "或者更准确地说，";
		mes "觉醒石。来，我去拿……";
		next;
		mes "[Hullaris]";
		mes "给你……";
		mes "只有勇敢且有资格的";
		mes "冒险者才能吃它。";
		mes "要明白，吃科莫多奶酪";
		mes "是罕见而珍贵的荣誉！";
		next;
		mes "^3355FFHullaris carefully";
		mes "你拿到一盘";
		mes "科莫多奶酪。";
		mes "每一口都香醇顺滑……";
		mes "美味无比！^000000";
		next;
		mes "^3355FF吃完";
		mes "吃下科莫多奶酪后，";
		mes "你感到一股微妙却明确的能量";
		mes "在体内轻轻脉动。";
		mes "你获得了强大而安静的自信，";
		mes "相信自己能完成任何事。^000000";
		set dmdswrd_Q,14;
		next;
		mes "[Hullaris]";
		mes "哈哈哈！怎么样？";
		mes "很棒吧？";
		mes "美味得难以置信。";
		mes "其他食物永远无法";
		mes "媲美科莫多奶酪的品质~";
		next;
		mes "[Hullaris]";
		mes "我知道你可能还有事要做，";
		mes "但我建议你去一趟艾尔帕兰。";
		mes "那里有个人能告诉你";
		mes "穆里涅尔石板的事。";
		next;
		mes "[Hullaris]";
		mes "你已经吃下觉醒石，";
		mes "不如再取得其他物品，";
		mes "争取获得";
		mes "三把禁剑之一。";
		mes "只是个建议……";
		break;
	default:
		mes "[Hullaris]";
		mes "啊……舞蹈。";
		mes "它不只是娱乐形式。";
		mes "它是艺术，是诱惑，";
		mes "是战斗，也是爱。";
		mes "只有真正的舞者才能理解……";
		next;
		mes "[Hullaris]";
		mes "你知道，科莫多以舞蹈学院";
		mes "和在那里训练的舞者闻名。";
		mes "如果你认识女弓箭手，";
		mes "为什么不建议她们";
		mes "去学校看看？";
		break;
	}
	close;
}

beach_dun3,30,220,4	script	Nigirboran#cmd	704,{
	switch (dmdswrd_Q) {
	case 11:
		mes "[Nigirboran]";
		mes "你就是 Hullaris 派来的人？";
		mes "你是来赢得";
		mes "食用觉醒石的资格……";
		mes "也就是通常所说的";
		mes "科莫多奶酪。";
		next;
		mes "[Nigirboran]";
		mes "是的，它有很多名字……";
		mes "但它不只是美味佳肴——";
		mes "觉醒石能帮助你发掘真正潜能。";
		mes "不过如果准备不足……你会死。";
		next;
		mes "[Nigirboran]";
		mes "如果你的身心";
		mes "没有充分训练，";
		mes "身体会排斥科莫多奶酪，";
		mes "你会缓慢、痛苦地死去，";
		mes "而且死得非常有“味道”。";
		next;
		mes "[Nigirboran]";
		mes "但我相信你不会这样！";
		mes "既然 Hullaris 把你送来，";
		mes "你一定有获胜的机会，对吧？";
		mes "准备好测试后再回来~";
		set dmdswrd_Q,12;
		break;
	case 12:
		mes "[Nigirboran]";
		mes "很好，你回来了——";
		mes "勇敢大胆的冒险者就该如此。";
		mes "现在别动，让我测量你体内能量，";
		mes "看看能否承受科莫多奶酪……";
		next;
		mes "[Nigirboran]";
		mes "好了。";
		mes "准备好了吗？";
		mes "现在……做好准备！";
		mes "嘿呀！呼——哈！";
		next;
		if (JobLevel > 20 && BaseLevel > 25) {
			switch(rand(1,3)) {
			case 1:
				mes "^3355FFA powerful current of";
				mes "一股暖意立刻从头到脚";
				mes "贯穿你的身体，";
				mes "你努力不让自己扭动。^000000";
				next;
				mes "[Nigirboran]";
				mes "嗯……你的身体训练得不错，";
				mes "但你的心智仍被测试冲击。";
				mes "如果现在吃科莫多奶酪，";
				mes "你会变成";
				mes "语无伦次的废人……";
				next;
				mes "[Nigirboran]";
				mes "再训练一段时间，";
				mes "努力提升心智的清明。";
				mes " ";
				mes "感觉准备好后，";
				mes "再回来找我。";
				break;
			case 2:
				mes "^3355FFA powerful current of";
				mes "暖意立刻从头到脚";
				mes "贯穿你的身体，";
				mes "你努力不让自己扭动。^000000";
				next;
				mes "[Nigirboran]";
				mes "嗯。你的身体很强，";
				mes "但精神很弱。";
				mes "你需要更多训练。";
				mes "如果现在吃科莫多奶酪……";
				mes "你会蒸发。";
				next;
				mes "[Nigirboran]";
				mes "但别灰心，";
				mes "现在放弃还太早。";
				mes "出去多训练一会儿，";
				mes "感觉准备好后再回来。";
				break;
			case 3:
				mes "^3355FFA powerful current of";
				mes "暖意立刻从头到脚";
				mes "贯穿你的身体，";
				mes "你努力不让自己扭动。^000000";
				next;
				mes "[Nigirboran]";
				mes "是的……是的……";
				mes "你的心智、灵魂和身体";
				mes "都训练有素。";
				mes "我想你能毫无副作用地";
				mes "吃科莫多奶酪。";
				mes "很好，我想你准备好了。";
				next;
				mes "[Nigirboran]";
				mes "来，把这个小信物交给 Hullaris。";
				mes "它能证明你通过了";
				mes "我的小测试。";
				mes "恭喜~";
				next;
				mes "^3355FFYou've received";
				mes "一枚信物徽章，";
				mes "由 Nigirboran 交给你";
				mes "转交 Hullaris。^000000";
				set dmdswrd_Q,13;
				next;
				mes "[Nigirboran]";
				mes "啊，我差点忘了问。";
				mes "你为什么追寻";
				mes "科莫多奶酪或觉醒石？";
				mes "你是在寻找三把禁剑之一吗？";
				next;
				mes "[Nigirboran]";
				mes "我不知道全部细节，";
				mes "但我知道你需要";
				mes "^3355FF觉醒石^000000 和 ^3355FF书籍^000000";
				mes "^3355FF羔羊之剑^000000和^3355FF穆涅尔之石板^000000，";
				mes "^3355FF才有机会获得那些剑中的一把。";
				next;
				mes "[Nigirboran]";
				mes "让我想想……和 Hullaris 谈过后，";
				mes "你应该去艾尔帕兰";
				mes "找一个能告诉你";
				mes "穆里涅尔石板的人。";
				mes "^3355FFMeteurengut^000000 to learn about";
				mes " ";
				next;
				mes "[Nigirboran]";
				mes "总之，祝你顺利实现目标。";
				mes "愿神速助你……";
				break;
			}
			close;
		}
		else {
			mes "^3355FFA torrent of warmth";
			mes "能量贯穿你的全身，";
			mes "你立刻因能量冲击而昏倒。^000000";
			next;
			mes "[Nigirboran]";
			mes "天哪……！";
			mes "你的身心太过虚弱，";
			mes "现在无法承受科莫多奶酪。";
			mes "你必须加强训练……";
			next;
			mes "[Nigirboran]";
			mes "增强实力后再回来。";
			mes "你随时可以重新参加这个小测试~";
			close;
		}
		break;
	case 13:
		mes "[Nigirboran]";
		mes "我不知道全部细节，";
		mes "但你需要 ^3355FF觉醒石、羔羊之书";
		mes "和 ^3355FF穆里涅尔石板^000000，";
		mes "才有机会得到禁剑。";
		next;
		mes "[Nigirboran]";
		mes "和 Hullaris 谈过后，";
		mes "去艾尔帕兰找";
		mes "^3355FFMeteurengut^000000，";
		mes "了解穆里涅尔石板。";
		next;
		mes "[Nigirboran]";
		mes "总之，祝你顺利实现目标。";
		mes "愿神速助你……";
		break;
	case 14:
		mes "[Nigirboran]";
		mes "在 ^3355FF艾尔帕兰^000000 的某处，";
		mes "你会找到 ^3355FFMeteurengut^000000。";
		mes "他能帮助你";
		mes "进一步了解穆里涅尔石板。";
		break;
	default:
		mes "[Nigirboran]";
		mes "哦……你好。";
		mes "可以说我是";
		mes "科莫多的训练师。";
		mes "我叫 Nigirboran。";
		mes "我知道这名字很难念……";
		next;
		mes "[Nigirboran]";
		mes "如果不是 Hullaris 派你来，";
		mes "我想自己帮不了你。";
		mes "既然如此，";
		mes "请让我继续训练……";
		break;
	}
	close;
}

aldebaran,44,53,4	script	Meteurengut#cmd	64,{
	switch (dmdswrd_Q) {
	case 14:
		mes "[Meteurengut]";
		mes "啊。你的身体被";
		mes "吃过觉醒石之人的光辉";
		mes "所包围。";
		mes "这足以证明你的冒险者价值，";
		mes "但你摆脱自私欲望了吗？";
		next;
		mes "[Meteurengut]";
		mes "哪怕最微小的贪婪或嫉妒";
		mes "也会产生腐化影响，";
		mes "尤其当力量没有受到";
		mes "智慧与真正同情心";
		mes "的约束时。";
		next;
		mes "[Meteurengut]";
		mes "像你一样的人曾来到我面前，";
		mes "希望了解穆里涅尔石板，";
		mes "最终得到三把诅咒之刃之一。";
		mes "你可能和他们没什么不同……";
		next;
		mes "[Meteurengut]";
		mes "穆里涅尔石板是炼金术遗物，";
		mes "能帮助人获得难以想象的力量，";
		mes "最初由一位名叫";
		mes "Rikaseh Sumarecon 的";
		mes "炼金术大师开发。";
		next;
		mes "[Meteurengut]";
		mes "Sumarecon 有两个徒弟。";
		mes "他只把穆里涅尔石板的秘密传给其中一人后，";
		mes "另一个徒弟因嫉妒杀害了他和那名学生。";
		next;
		mes "[Meteurengut]";
		mes "Sumarecon 的秘密被认为";
		mes "永远失传了……";
		mes "幸运的是，多年后，";
		mes "一位名叫 Kuprite 的炼金术士";
		mes "找到了包含这些知识的";
		mes "秘密文献。";
		next;
		mes "[Meteurengut]";
		mes "Kuprite 将这些秘密";
		mes "传授给一小群炼金术学生，";
		mes "其中一人就是我的祖先";
		mes "Burukesaemu。";
		mes "因此，凭借家族血脉，";
		mes "我学会了这些秘密。";
		next;
		mes "[Meteurengut]";

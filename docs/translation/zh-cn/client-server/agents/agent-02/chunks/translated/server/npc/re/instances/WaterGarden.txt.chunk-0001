// Area 1
1@ghg,216,58,3	script	Gardener#ghg_g1	4_EP17_SCISSORE,{
	if ('water_garden == 0)
		end;
	if ('water_garden == 1) {
		mes "[Hetilla]";
		mes "客人，欢迎来到水之庭院，";
		mes "你要去见帕皮拉吗？帕皮拉最近对入侵者非常敏感……";
		npctalk "客人，欢迎来到水之庭院。你要去见帕皮拉吗？帕皮拉最近对入侵者非常敏感……";
		next;
		mes "[Hetilla]";
		mes "帕皮拉们正在这里四处游荡。";
		mes "它们利用翅膀上的致幻物质进行短距离移动，或施展危险的魔法。";
		npctalk "帕皮拉们正在这里四处游荡。它们利用翅膀上的致幻物质进行短距离移动，或施展危险的魔法。";
		next;
		mes "[Hetilla]";
		mes "我已经提前警告过你了，但还是要小心。";
		mes "修剪所有过度生长的植物和动物后，3 点钟方向的门就会打开。";
		npctalk "我已经提前警告过你了，但还是要小心。修剪所有过度生长的植物和动物后，3 点钟方向的门就会打开。";
		close2;
		if ('water_garden == 1) {
			'water_garden = 2;
			donpcevent instance_npcname("#172_wg_mob_1") + "::OnStart";
			donpcevent instance_npcname("#172_wg_area_1") + "::OnStart";
		}
		end;
	}
	if ('water_garden == 2)
		npctalk "小心帕皮拉的致幻物质。";
	else
		npctalk "客人，你现在可以前往下一个区域了。";
	end;
}


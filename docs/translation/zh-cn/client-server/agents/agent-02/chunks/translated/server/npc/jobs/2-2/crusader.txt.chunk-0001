	// 翻译切片边界保留
	// 翻译切片边界保留
	// 翻译切片边界保留

// Senior Crusader: 1st Collect Items Test
//============================================================
-	script	Senior Crusader_	-1,{
	mes "[迈克尔·哈里格]";
	if (Upper == 1) { //the baby classes were totally blocked... due to missing == 1
		mes "去训练自己，为即将到来的圣战做准备。胜利属于最有准备的人。";
		next;
		mes "[迈克尔·哈里格]";
		mes "朋友，你不属于这里。";
		mes "请继续自我练习。";
		close;
	} 
	else if(BaseJob != Job_Swordman) {
		if(BaseJob == Job_Crusader) {
			mes "去训练自己，为即将到来的圣战做准备。胜利属于最有准备的人。";
			next;
			mes "[迈克尔·哈里格]";
			mes "有一天混沌会出现，挑战和平、正义与秩序的原则。在消灭邪恶、创造理想世界之前，我们不能停止训练。";
			close;
		}
		else if(BaseJob == Job_Novice) {
			mes "我们是十字军，";
			mes "为圣战而准备的";
			mes "战士。";
			next;
			mes "[迈克尔·哈里格]";
			mes "如果你想加入我们，必须先学习剑士的修行并充分训练自己……";
			close;
		}
		mes "我们是十字军，";
		mes "为圣战而准备的";
		mes "战士。";
		next;
		mes "[迈克尔·哈里格]";
		mes "就像一千年前发生过的那样，邪恶势力终有一天会大举来袭，再次企图征服世界。";
		close;
	} 
	else if(CRUS_Q <= 3 && countitem(1004) && countitem(1009)) {
		mes "啊……";
		mes "看来你已被召唤成为十字军。我们相信你的意志，但现在必须测试你的能力。";
		next;
		mes "[迈克尔·哈里格]";
		mes "去普隆德拉城堡的地下城找正在训练的莫雷纳克·米约尔。先去和他谈谈。";
		next;
		delitem 1004, 1;
		delitem 1009, 1;
		set CRUS_Q,4;
		mes "[迈克尔·哈里格]";
		mes "莫雷纳克和其他人会测试你的能力极限，帮助你找到道路。完成他们的测试后再回来……";
		close;
	}
	else if(CRUS_Q == 0) {
		mes "我们是为圣战准备的十字军。";
		mes "是什么把你";
		mes "带到这里的？";
		next;
		if (select("我想为圣战做准备！:没什么特别的。") == 1) {
			mes "[迈克尔·哈里格]";
			mes "你想成为";
			mes "十字军……？";
			mes "加入我们并不像听起来那么容易。";
			next;
			mes "[迈克尔·哈里格]";
			mes "我是迈克尔·哈里格，是众多准备圣战的十字军之一。我们以真诚信仰和无限忠诚不断训练自己。";
			next;
			mes "[迈克尔·哈里格]";
			mes "我们招募表现出非凡信仰的剑士，或那些依奥丁意志而生的战士。";
			next;
			mes "[迈克尔·哈里格]";
			mes "拥有^3355FF骑士徽章^000000和^3355FF上帝之手^000000，代表你被召唤成为十字军。";
			next;
			mes "[迈克尔·哈里格]";
			mes "取得这些物品并通过我们的测试后，你也能成为十字军。";
			next;
			mes "[迈克尔·哈里格]";
			mes "我还不知道你是什么样的人。但如果你愿意，我会测试你。你愿意为圣战承受这些测试吗？";
			next;
			if (select("是的。:让我考虑一下。") == 1) {
				if(JobLevel < 40) {
					mes "[迈克尔·哈里格]";
					mes "等等……";
					mes "你还没准备好。";
					mes "必须至少达到";
					mes "职业等级 40 才能成为十字军。";
					next;
					mes "[迈克尔·哈里格]";
					mes "继续作为剑士训练，等待召唤。我理解你的意愿，但现在还不能加入我们。";
					close;
				} 
				if (SkillPoint) {
					mes "[迈克尔·哈里格]";
					mes "你还没完成剑士的全部学习。用完剩余技能点后再回来。";
					close;
				}
				mes "[迈克尔·哈里格]";
				mes "那么……";
				mes "我会测试你是否适合成为十字军。";
				next;
				mes "[迈克尔·哈里格]";
				mes "你的名字是";
				mes "" + strcharinfo(0) + "...?";
			mes "让我们看看……";
				next;
				if (countitem(1004) && countitem(1009)) {
					mes "[迈克尔·哈里格]";
					mes "啊……看来你已被召唤成为十字军。我们相信你的意志，但现在必须测试你的能力。";
					next;
					mes "[迈克尔·哈里格]";
					mes "去普隆德拉城堡地下城找莫雷纳克·米约尔。先和他谈谈。";
					next;
					delitem 1004, 1;
					delitem 1009, 1;
					set CRUS_Q,4;
					setquest 3009;
					mes "[迈克尔·哈里格]";
					mes "莫雷纳克和其他人会测试你的能力极限，帮助你找到道路。完成测试后再回来……";
					close;
				}
				mes "[迈克尔·哈里格]";
				mes "嗯。我看不出你是否有成为十字军的内心。不过只要有意志并付出努力，你也许具备所需的条件。";
				next;
				mes "[迈克尔·哈里格]";
				mes "现在……";
				mes "这是给你的测试。带来以下物品，向我证明你的决心。";
				next;
				mes "[Michael Halig]";
				set .@cru_m1,rand(1,3);
				if(.@cru_m1 == 1) {
					set CRUS_Q, 1;
					setquest 3006;
					mes "10 ^3355FF"+getitemname(957)+"^000000";
					mes "10 ^3355FF"+getitemname(959)+"^000000";
					mes "10 ^3355FF"+getitemname(1099)+"^000000";
					mes "10 ^3355FF"+getitemname(901)+"^000000";
					next;
				}
				else if(.@cru_m1 == 2) {
					set CRUS_Q, 2;
					setquest 3007;
					mes "10 ^3355FF"+getitemname(932)+"^000000";
					mes "10 ^3355FF"+getitemname(1043)+"^000000";
					mes "10 ^3355FF"+getitemname(1098)+"^000000";
					mes "10 ^3355FF"+getitemname(1094)+"^000000";
					next;
				}
				else {
					set CRUS_Q, 3;
					setquest 3008;
					mes "10 ^3355FF"+getitemname(958)+"^000000";
					mes "10 ^3355FF"+getitemname(930)+"^000000";
					mes "10 ^3355FF"+getitemname(1041)+"^000000";
					mes "10 ^3355FF"+getitemname(1062)+"^000000";
					next;
				}
				mes "[Michael Halig]";
		mes "收集这些物品，向我展示你的意志。如果成功，你就能进入下一项测试。愿奥丁保佑你。";
				close;
			}
			mes "[Michael Halig]";
		mes "没人知道圣战何时到来。我们必须提前准备，不能放松";
		mes "训练。";
			next;
			mes "[Michael Halig]";
		mes "如果你觉得参加圣战是自己的使命，请立即回来接受测试，成为";
		mes "十字军。";
			close;
		}
		mes "[Michael Halig]";
		if (Sex == SEX_MALE) mes "如果你也是剑士，就要不断训练、做好准备。没人知道圣战何时开始。";
		else mes "作为女剑士，你必须勤奋并持续训练。做好准备，因为没人知道圣战何时到来。";
		close;
	}
	else if(CRUS_Q >= 1 && CRUS_Q <= 3) {
		mes "你是否已用我交给你的任务证明决心，或持有证明你受到召唤的物品？";
		next;
		switch(CRUS_Q) {
		case 1:
			set .@item1, 957;
			set .@item2, 959;
			set .@item3, 1099;
			set .@item4, 901;
			break;
		case 2:
			set .@item1, 932;
			set .@item2, 1043;
			set .@item3, 1098;
			set .@item4, 1094;
			break;
		case 3:
			set .@item1, 958;
			set .@item2, 930;
			set .@item3, 1041;
			set .@item4, 1062;
			break;
		}
		if (countitem(.@item1) > 9 && countitem(.@item2) > 9 && countitem(.@item3) > 9 && countitem(.@item4) > 9) {
			mes "[迈克尔·哈里格]";
			mes "啊，做得好。";
			mes "我必须肯定你的努力和决心。现在可以参加下一项测试了。";
			next;
			mes "[迈克尔·哈里格]";
			mes "去普隆德拉城堡地下城找莫雷纳克·米约尔。先和他谈谈。";
			next;
			delitem .@item1, 10;
			delitem .@item2, 10;
			delitem .@item3, 10;
			delitem .@item4, 10;
			set CRUS_Q, 4;
			if(checkquest(3006) != -1) {
				changequest 3006,3009;
			}
			else if(checkquest(3007) != -1) {
				changequest 3007,3009;
			}
			else {
				changequest 3008,3009;
			}
			mes "[迈克尔·哈里格]";
			mes "莫雷纳克和其他人会测试你的能力极限，帮助你找到道路。完成测试后再回来……";
			close;
		}
		mes "[迈克尔·哈里格]";
		mes "啊，你还没完成我交给你的任务。带来以下物品，向我证明成为十字军的意志……";
		next;
		mes "[Michael Halig]";
		mes "10 ^3355FF"+getitemname(.@item1)+"^000000";
		mes "10 ^3355FF"+getitemname(.@item2)+"^000000";
		mes "10 ^3355FF"+getitemname(.@item3)+"^000000";
		mes "10 ^3355FF"+getitemname(.@item4)+"^000000";
		next;
		mes "[迈克尔·哈里格]";
		mes "只要付出努力，你就能完成任务。愿奥丁在旅途中保护你。";
		close;
	}
	else if(CRUS_Q == 10) {
		if(SkillPoint) {
			mes "你还没有完成剑士的全部学习。用完剩余技能点后再回来。";
			close;
		}
		mes "恭喜你完成所有测试。作为十字军，你确实有资格与我们并肩参加圣战。";
		next;
		mes "[迈克尔·哈里格]";
		mes "让我们一起做好准备，战胜邪恶与暴政！";
		next;
		set .@Joblevel,JobLevel;
		completequest 3015;
		callfunc "Job_Change",Job_Crusader;
		callfunc "F_ClearJobVar";		//clears all job variables for the current player
		mes "[迈克尔·哈里格]";
		mes "看吧……！";
		mes "你现在是十字军了！";
		mes "圣战来临时，我们将并肩对抗邪恶势力。";
		next;
		mes "[迈克尔·哈里格]";
		mes "现在你是";
		mes "我们的一员了！";
		if (Sex == SEX_MALE) mes "...Brother.";
		else mes "...Comrade.";
		next;
		if(.@JobLevel != 50) getitem 504, 6;
		else getitem 504, 12;
		mes "[迈克尔·哈里格]";
		mes "在危急时刻使用这个。当伤势最重时，它会给予你力量。";
		next;
		mes "[迈克尔·哈里格]";
		mes "别忘了圣战正在逼近。我们必须准备迎接席卷世界的邪恶浪潮。现在出发，为自由与正义而战！";
		close;
	}
	mes "看来你还没有完成所有测试。在完成面前的测试前，你还没准备好成为十字军。";
	next;
	mes "[迈克尔·哈里格]";
	mes "完成所有测试后回来。当你证明自己符合资格，就能加入强大十字军的荣耀行列。";
	close;
}

// Suffering Man: 2nd Endurance Test
//============================================================
-	script	Man in Anguish_	-1,{
	mes "[莫雷纳克·米约尔]";
	if(BaseJob != Job_Swordman) {
		if (BaseJob == Job_Crusader) {
			mes "别在这种地方逗留，走自己的路，发现自身的力量。我们并肩战斗的日子很快会到来。";
			close;
		}
		else if(BaseJob == Job_Novice) {
			mes "初心者……？";
			mes "如此青涩，";
			mes "却潜力无限。";
			next;
			mes "[莫雷纳克·米约尔]";
			mes "我不是罪犯，请放心。我只是来训练自己。也许你变强后就会理解。";
			close;
		}
		mes "嗯。你不该来这里。请离开，不要打扰我的训练。";
		close;
	}
	else if(CRUS_Q >= 0 && CRUS_Q <= 3) {
		mes "你想要什么……？";
		mes "如果没事，请离开。";
		mes "宁静的心境是自我训练的关键……";
		next;
		mes "[莫雷纳克·米约尔]";
		mes "我想提升内心的宁静，为即将到来的圣战做准备。所以请不要打扰我。";
		close;
	}
	else if(CRUS_Q == 4) {
		mes "怎么了……？";
		mes "你有什么事";
		if (Sex == SEX_MALE) mes "要找我这位剑士吗？";
		else mes "要找我这位女剑士吗？";
		next;
		if (select("我想参加十字军测试。:没什么。") == 1) {
			mes "[莫雷纳克·米约尔]";
			mes "你想成为十字军……？嗯，在圣战中战斗是我们都能认同的高尚目标。";
			next;
			mes "[莫雷纳克·米约尔]";
			mes "你的名字是";
			mes "" + strcharinfo(0) + "...?";
			mes "让我看看你的脸。";
			next;
			if(getequipid(EQI_ACC_L) != 2608 && getequipid(EQI_ACC_R) != 2608) {
				mes "[莫雷纳克·米约尔]";
				mes "嗯。你想成为十字军，却没戴念珠？如果不能遵守习俗，我就没什么可和你谈的。";
				close;
			}
			mes "[莫雷纳克·米约尔]";
			mes "嗯……";
			mes "你看起来普普通通，却年轻又有野心。没有耐心约束，野心会反过来伤害你。";
			next;
			mes "[Murnak Mijoul]";
			mes "别让我有理由怀疑你，向我展示你的耐心。想成为十字军，就必须耐心通过我的测试。";
			next;
			mes "[莫雷纳克·米约尔]";
			mes "你可以立刻参加测试。其实很简单，只需走到走廊尽头。";
			next;
			mes "[莫雷纳克·米约尔]";
			mes "但是……记住一件事：无论如何都不许杀死怪物。";
			next;
			set CRUS_Q,5;
			changequest 3009,3010;
			mes "[莫雷纳克·米约尔]";
			mes "那么……祝你好运。";
			close2;
			warp "job_cru",98,40;
			end;
		}
		mes "[Murnak Mijoul]";
		mes "你似乎很有空。为什么不做点更有意义的事，比如捡捡街上的杰勒比结晶？";
		close;
	}
	else if(CRUS_Q == 5) {
		mes "怎么了……？";
		mes "你就是之前的剑士。怎么了，失败了吗？";
		next;
		if (select("让我重新测试。:那是什么测试？！") == 1) {
			mes "[Murnak Mijoul]";
			mes "我会让你随意重考。但如果你不断失败，说明你的";
			mes "心态存在根本问题。";
			next;
			if(getequipid(EQI_ACC_L) != 2608 && getequipid(EQI_ACC_R) != 2608) {
				mes "[Murnak Mijoul]";
				mes "等等……";
				mes "你的念珠放哪了？不能随便乱放。我们是神圣的战士。";
				next;
				mes "[Murnak Mijoul]";
				mes "粗心丢东西是普通剑士的态度。想重考，就必须尊重十字军传统。";
				close;
			}
			mes "[Murnak Mijoul]";
			mes "你的问题是看到怪物就立刻攻击。你必须培养耐心和耐力。";
			next;
			mes "[Murnak Mijoul]";
			mes "集中精神……";
			mes "你的唯一目标是从走廊一端走到另一端。想清楚就很简单。";
			next;
			mes "[Murnak Mijoul]";
			mes "无论如何都不要杀怪物。这次拔剑前要仔细思考。";
			next;
			set CRUS_Q,5;
			mes "[Murnak Mijoul]";
			mes "那么……";
			mes "祝你好运。";
			close2;
			warp "job_cru",98,40;
		}
		mes "[Murnak Mijoul]";
		mes "你凭什么说不喜欢我的测试？抱着这种态度，你永远成不了十字军。";
		next;
		mes "[Murnak Mijoul]";
		mes "我能理解你容易受挫，但要通过测试就必须克服挫败感。";
		close;
	}
	else if(CRUS_Q == 6) {
		mes "嗯，看起来你做得不错。应该没那么难。你已经不需要再找我了。";
		next;
		mes "[Murnak Mijoul]";
		mes "下一项测试去普隆德拉圣堂找加百列·瓦伦丁。那么，回头见。";
		close;
	}
	mes "嗯……";
	mes "想成为十字军，你还有测试要完成，对吧？";
	close;
}

// Gabriel Valentine: 3rd Knowledge Test
//============================================================
prt_church,95,127,3	script	Crusader	745,{
	mes "[加百列·瓦伦丁]";
	if(BaseJob != Job_Swordman) {
		if (BaseJob == Job_Crusader) {
			mes "欢迎，十字军同伴。";
			mes "你的训练";
			mes "进行得怎么样？";
			next;
			mes "[加百列·瓦伦丁]";
			mes "别忘了每天训练，为圣战来临的那天做好准备。";
			close;
		}
		else if(BaseJob == Job_Novice) {
			mes "欢迎，我是一名十字军。";
			mes "我正在为";
			mes "预言中的圣战";
			mes "做准备。";
			next;
			mes "[加百列·瓦伦丁]";

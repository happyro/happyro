	close;
}




	
yuno_in03,48,108,3	script	Geographer#yuno	1368,{
	end;
}
yuno_in03,46,108,1	script	#GEOGRAPHER	111,{
	mes " ";
	mes " 学名：地理学家";
	mes " 尺寸：中型";
	mes " 属性：地";
	next;
	mes "说明：";
	mes "一种外形像向日葵的";
	mes "食虫生物。它用嘴边";
	mes "花瓣般的触手";
	mes "吸引并捕捉";
	mes "猎物。";
	next;
	mes "与曼陀罗魔花不同，地理学家";
	mes "没有储存猎物的管道，";
	mes "所以会慢慢地";
	mes "一点一点吃掉猎物。";
	next;
	mes "虽然地理学家的根很小很短，";
	mes "却足够坚韧强壮，";
	mes "可以支撑";
	mes "上半身的重量。";
	next;
	mes "这种怪物的命名者是一位";
	mes "人类地理学家，他在发现";
	mes "这种野兽后立刻被吃掉，";
	mes "他的名字";
	mes "永远不会被遗忘……";
	close;
}
	

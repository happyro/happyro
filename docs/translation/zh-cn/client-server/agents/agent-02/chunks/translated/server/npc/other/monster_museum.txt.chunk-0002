yuno_in03,39,124,3	script	Ancient Mummy#yuno	1297,{
	end;
}
yuno_in03,39,122,1	script	#ANCIENT_MUMMY	111,{
	mes " ";
	mes " 学名：远古木乃伊";
	mes " 尺寸：中型";
	mes " 属性：不死";
	next;
	mes "说明：";
	mes "被诅咒获得永生的木乃伊。";
	mes "虽然缠着腐烂的绷带，";
	mes "远古木乃伊还戴着";
	mes "一件华丽的蛇形";
	mes "发饰。";
	next;
	mes "这种头饰说明远古木乃伊";
	mes "生前曾是";
	mes "地位显赫的人。";
	mes "";
	next;
	mes "由于远古木乃伊";
	mes "在冥界徘徊了很久，";
	mes "已经没有意识，";
	mes "会攻击附近的";
	mes "任何活物。";
	close;
}
	

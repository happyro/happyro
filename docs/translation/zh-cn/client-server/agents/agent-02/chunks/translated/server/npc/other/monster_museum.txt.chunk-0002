	mes " 属性：火";
	next;
	mes "说明：";
	mes "这是一种在火山地带附近";
	mes "出现的火球。";
	mes "由于这种怪物突然出现，";
	mes "贤者认为朱诺附近";
	mes "迟早会发生";
	mes "火山活动。";
	next;
	mes "火球怪会喷出伤害路人的";
	mes "有毒气体。至于这究竟是攻击，";
	mes "还是火球怪的";
	mes "交流方式，";
	mes "尚不得而知。";
	close;
}
	

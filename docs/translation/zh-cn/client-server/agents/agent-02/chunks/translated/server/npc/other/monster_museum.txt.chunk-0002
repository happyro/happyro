	mes "濒临灭绝。";
	mes "大王花是米德加尔特最稀有的";
	mes "怪物，因此受到法律保护。";
	mes "";
	next;
	mes "由于这种情况，大多数贤者";
	mes "很难研究这种怪物。";
	mes "不过，仍有少数贤者";
	mes "正在寻找培育并拯救";
	mes "大王花的方法。";
	mes "";
	close;
}
	

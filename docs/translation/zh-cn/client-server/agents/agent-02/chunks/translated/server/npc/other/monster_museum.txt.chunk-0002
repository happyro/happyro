	mes "这种恶魔以惊人的美貌";
	mes "吸引人类。它伪装成";
	mes "男性人类时被称为梦魔，";
	mes "伪装成女性时被称为魅魔。";
	next;
	mes "这种恶魔会盯上";
	mes "精神脆弱的人，";
	mes "最终将他们带入地狱。";
	close;
}
	

splendide,205,139,5	script	Exhausted Soldier#1	447,{
	if ((isequipped(2782) == 1) && (ep13_2_rhea == 100)) {
		if (ep13_2_tre1 == 5) {
			if (countitem(6082) > 0) {
				mes "[Exhausted Soldier]";
				mes "哦，我的故乡……";
				next;
				switch(select("使用香水。:不使用香水。")) {
				case 1:
					mes "(Spray-)";
					specialeffect EF_SANCTUARY;
					next;
					mes "[Exhausted Soldier]";
					mes "嗯……这是……";
					mes "我能感受到阿尔夫海姆的香气。";
					mes "我的故乡阿尔夫海姆！";
					next;
					mes "[Exhausted Soldier]";
					mes "啊！感觉好多了！";
					emotion ET_SMILE;
					delitem 6082,1; //Spirit_Of_Alfheim
					close2;
					donpcevent "#tukare_1::OnEnable";
					disablenpc "Exhausted Soldier#1";
					end;
				case 2:
					mes "- 你决定什么也不做。-";
					close;
				}
			}
			end;
		}
		else {
			mes "[Exhausted Soldier]";
			mes "哦，我的故乡……";
			close;
		}
	}
	else {
		mes "[Exhausted Soldier]";
			mes "再见，研究者。";
		close;
	}

OnInit:
	enablenpc "Exhausted Soldier#1";
	end;
}

splendide,1,1,1	script	#tukare_1	111,{
OnEnable:
	initnpctimer;
	end;

OnTimer60000:
	enablenpc "Exhausted Soldier#1";
	stopnpctimer;
	end;
}


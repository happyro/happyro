				mes "为了神圣职责与信仰，";
				mes "阻止那些企图";
				mes "毒害世界树的邪恶行为。";
				next;
				mes "[Grenouille]";
				mes "他们是训练有素的士兵，";
				mes "队长也十分器重他们，";
				mes "所以在那里过着";
				mes "舒适的生活。";
				next;
				mes "[Grenouille]";
				mes "但有句话说，";
				mes "滴水穿石。";
				mes " ";
				next;
				mes "[Grenouille]";
				mes "不断的小规模战斗却没有重大进展，";
				mes "让斯普兰迪士的士兵们疲惫不堪。";
				next;
				mes "[Grenouille]";
				mes "有一天，有人开始唱起";
				mes "阿尔夫海姆的歌曲，迅速传开……";
				mes "现在他们非常";
				mes "思念故乡。";
				next;
				mes "[Grenouille]";
				mes "我非常担心他们，";
				mes "终于找到了";
				mes "让他们摆脱深深悲伤的方法。";
				mes "希望你能帮我。";
				next;
				mes "[Grenouille]";
				mes "斯普兰迪士有一位";
				mes "名叫 Flowery 的";
				mes "拉普纳将军。";
				next;
				mes "[Grenouille]";
				mes "她是个收集狂，";
				mes "所以房子里总是";
				mes "堆满杂物，乱七八糟。";
				mes "Flowery 一定有";
				mes "阿尔夫海姆花朵的种子。";
				next;
				mes "[Grenouille]";
				mes "我会用种子让";
				mes "阿尔夫海姆之花绽放。";
				mes "那是他们故乡的花。";
				next;
				mes "[Grenouille]";
				mes "有些装置能净化环境，";
				mes "还具备";
				mes "加速植物生长的功能。";
				next;
				mes "[Grenouille]";
				mes "请把用装置催开的阿尔夫海姆之花带给我。";
				next;
				mes "[Grenouille]";
				mes "阿尔夫海姆之花无法";
				mes "仅依靠斯普兰迪士装置维持生命，";
				mes "但 ^FF0000某种方法^000000 能让";
				mes "它的香气充满斯普兰迪士，永不凋谢！";
				set ep13_2_tre1,1;
				setquest 2183;
				close;
			}
			else if ((ep13_2_tre1 == 1) || (ep13_2_tre1 == 2)) {
				mes "[Grenouille]";
				mes "从 Flowery 那里取得种子，";
				mes "然后使用净化器";
				mes "让种子开花。";
				close;
			}
			else if (ep13_2_tre1 == 3) {
				if (countitem(6079) == 1) {
					emotion ET_SWEAT;
					emotion ET_SWEAT, playerattached();
					mes "[Grenouille]";
				mes "哦，这是最普通的";
				mes "花朵之一。";
					next;
					emotion ET_SMILE;
					mes "[Grenouille]";
				mes "哈哈，别担心。";
				mes "这种普通花朵也能让士兵们感受到故乡的熟悉。";
					next;
					mes "[Grenouille]";
				mes "现在我会用蒸馏器";
				mes "提取花朵香气中的液体，";
				mes "制作 ^3131FF香水^000000。";
					next;
					mes "[Grenouille]";
				mes "请稍等一会儿好吗？";
					changequest 2183,2184;
					set ep13_2_tre1,4;
					delitem 6079,1; //Flower_Of_Alfheim
					close;
				}
				else {
					mes "[Grenouille]";
					mes "花在哪里？";
					close;
				}
			}
			else if (ep13_2_tre1 == 4) {
				set .@ttalk,rand(1,10);
				if (.@ttalk < 8) {
					mes "- clitter-clatter -";
					next;
					mes "- clitter-clatter -";
					mes "- clitter-clatter -";
					next;
					mes "- clitter-clatter -";
					mes "- clitter-clatter -";
					mes "- Spraying something -";
					next;
					mes "[Grenouille]";
					mes "还没完成。";
					mes "请稍等。";
					close;
				}
				else {
					mes "- clitter-clatter -";
					next;
					mes "- clitter-clatter -";
					mes "- clitter-clatter -";
					next;
					mes "- clitter-clatter -";
					mes "- clitter-clatter -";
					mes "- Spraying something -";
					next;
					mes "[Grenouille]";
					mes "哇，完成了！";
					next;
					mes "[Grenouille]";
					mes "我想把这款香水叫作";
					mes "^3131FF阿尔夫海姆之魂^000000！";
					next;
					mes "[Grenouille]";
					mes "这款香水能利用";
					mes "故乡阿尔夫海姆的香气抚慰他们。";
					mes "虽然不是永久解决方案，但暂时能让他们安心。";
					next;
					mes "[Grenouille]";
					mes "来，我把香水给你，";
					mes "请帮助疲惫的士兵，";
					mes "然后告诉我结果！";
					set ep13_2_tre1,5;
					getitem 6082,5; //Spirit_Of_Alfheim
					changequest 2184,2185;
					close;
				}
			}
			else if (ep13_2_tre1 == 5) {
				if (countitem(6082) < 1) {
					mes "[Grenouille]";
					mes "哦！士兵们反应如何？";
					next;
					mes "["+ strcharinfo(0) +"]";
					mes "是的，他们似乎很开心。";
					mes "但还是有人哭了，因为他大概很想念阿尔夫海姆。";
					next;
					mes "[Grenouille]";
					mes "哦！这说明有效！";
					mes "谢谢。";
					next;
					mes "[Grenouille]";
					mes "谢谢你的帮助。";
				mes "这是给你的奖励。";
				mes "希望对你有用。";
				mes "有什么想和我谈的，随时来找我。很高兴认识你，来自米德加尔特的人类。";
				//
				//
				//
				//
					set ep13_2_tre1,6;
					changequest 2185,2186;
					getitem 6081,3; //Splendide_Coin
					//getexp 0,(checkre(3))?70000:700000; //iRO only
					close;
				}
				else {
					mes "[Grenouille]";
					mes "去给斯普兰迪士疲惫的士兵喷洒这种香水！";
					close;
				}
			}
			else {
				mes "[Grenouille]";
				mes "希望这场漫长的战斗能尽快结束。";
				close;
			}
		}
		else {
			mes "[Grenouille]";
			mes "希望这场漫长的战斗能尽快结束。";
			close;
		}
	}
	else {
		mes "[High Laphine]";
		mes "BurYurDath Ee NeKoIyaz er ModRuAlah Yee VeldDuDur Yee SeYurOsa U ReNudNud Ra ";
		next;
		mes "[High Laphine]";
		mes "DiebVrumDana er TingNothDim No RasVilHir Yu YurAdorShar Yu DanaVeldDur Ha VilModMe O SharThus";
		close;
	}
}

spl_in02,139,65,3	script	Middle-Ranked Laphine#la	438,{
	if ((isequipped(2782) == 1) && (ep13_2_rhea == 100)) {
		if (checkweight(1201,1) == 0) {
			mes "[Flowery]";
			mes "你似乎带了太多东西。";
			mes "不如把一部分物品存进仓库后再回来？";
			close;
		}
		if (ep13_2_tre1 == 1) {
			mes "[Flowery]";
			mes "嗯？阿尔夫海姆之花的种子？";
			mes "我有那个吗？嗯~";
			next;
			mes "[Flowery]";
			mes "你看，我房间里东西太多了，";
			mes "所以我也不知道";
			mes "到底有什么";
			mes "或没有什么。";
			next;
			mes "[Flowery]";
			mes "不过既然你来帮助 Grenouille，";
			mes "我会努力找找看。";
			mes "他总是装得很顽强，";
			mes "但有时也很会帮助别人！呼呼！";
			next;
			mes "- rummaging -";
			emotion ET_THINK;
			next;
			mes "- rummaging -";
			mes "- rummaging -";
			emotion ET_THINK;
			next;
			mes "- rummaging -";
			mes "- rummaging -";
			mes "- rummaging -";
			emotion ET_AHA;
			next;
			mes "[Flowery]";
			mes "哇！过来！";
			mes "我找到一颗种子！";
			next;
			mes "[Flowery]";
			mes "嗯……但这是";
			mes "阿尔夫海姆最普通、最不起眼的种类，";
			mes "这种野花到处都能找到……";
			mes "这个可以吗？";
			next;
			mes "[Flowery]";
			mes "嗯……但我没有";
			mes "其他花朵的种子……";
			mes "所以就带这个吧，给你~";
			set ep13_2_tre1,2;
			getitem 7193,1; //Germinating_Sprout
			close;
		}
		else if (ep13_2_tre1 == 2) {
			mes "[Flowery]";
			mes "种子已经给你了，接下来怎么用就看你的了。";
			mes "我一看自己的房间就头晕。";
			close;
		}
		else {
			mes "[Flowery]";
			mes "嗯嗯嗯~";
			mes "你能相信眼前就是战场吗？虽然现在非常安静祥和。我也是~";
			close;
		}
		
	}
	else {
		mes "[Middle-Ranked Laphine]";
		mes "NeiKoFulo An DielOdesMush Or KoDanaOsa Ir FarBurnes Ir ";
		mes "NeOsaVa Mu BurVeTi Ra OsaDeh";
		close;
	}
}

-	script	Purifier	-1,{
	if (ep13_2_tre1 == 2) {
		if (countitem(7193) > 0) {
			mes "- 你把种子放进";
			mes "装置并按照 Grenouille 的说法观察。-";
			next;
			mes "- Booowoong -";
			specialeffect2 EF_HEALSP;
			next;
			mes "- 灯光消失后，";
			mes "你手中出现了一朵巨大的";
			mes "阿尔夫海姆之花，而不是种子。-";
			delitem 7193,1; //Germinating_Sprout
			set ep13_2_tre1,3;
			getitem 6079,1; //Flower_Of_Alfheim
			close;
		}
		else {
			mes "["+ strcharinfo(0) +"]";
			mes "种子在哪里？";
			close;
		}
	}
	end;
}


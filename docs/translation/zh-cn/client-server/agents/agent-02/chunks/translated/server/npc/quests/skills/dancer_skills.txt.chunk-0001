comodo,204,172,5	script	Canell#qsk_dan01	724,{
	if (BaseJob == Job_Dancer && JobLevel > 39) {
		if (DANCER_SK == 0) {
			mes "[Canell]";
			mes "众所周知，我们必须美丽，才能吸引观看舞蹈的人。但只依赖外表，会可怕地浪费表演者的全部潜力。";
			next;
			mes "[Canell]";
			mes "我看得出来你还不明白，正确的心态是美丽不可或缺的要素。现在告诉我，你对自己的舞蹈有信心吗……？";
			next;
			if (select("当然，老太婆！:我……我不确定……") == 1) {
				mes "[Canell]";
				mes "呵呵~我想你把自信和傲慢混为一谈了！天真之人分不清两者之间至关重要的区别。现在……准备受罚吧！";
				next;
				mes "["+ strcharinfo(0) +"]";
				mes "哎哟……！那、那条鞭子！好、好痛！";
				specialeffect2 EF_HIT2;
				percentheal -5,0;
				close;
			}
			mes "[Canell]";
			mes "意识到自己的缺点和过错，是迈向进步的第一个关键步骤。但你明显忽视了舞蹈天赋……这足以受罚！";
			next;
			mes "["+ strcharinfo(0) +"]";
			mes "什么……？啊！别、别再鞭打我了！好、好痛！";
			specialeffect2 EF_HIT2;
			percentheal -10,0;
			next;
			mes "[Canell]";
			mes "呵呵~！幸运的是，我会教你超越当前局限所需的一切。等我教完，你的魅力连天使和恶魔都无法抗拒~";
			next;
			if (select("不可能，你别想教我！:好吧，我看看能学到什么。") == 1) {
				mes "[Canell]";
				mes "所以……你还没掌握散发魅力与谦逊的艺术！公然侮辱我们职业必须付出代价！准备好吧！";
				next;
				mes "["+ strcharinfo(0) +"]";
				mes "不——！不要又是那条鞭子！啊，它——好痛！";
				specialeffect2 EF_HIT2;
				percentheal -10,0;
				close;
			}
			mes "[Canell]";
			mes "呵呵~你能认识到还有很多要学是好事。好了，别浪费时间。第一课是形象训练和自我想象。现在，为此……";
			next;
			mes "[Canell]";
			mes "……你必须带给我^FF00001 面水晶镜^000000！这件工具对课程至关重要，快去把它带来！";
			set DANCER_SK,1;
			close;
		}
		else if (DANCER_SK == 1) {
			if (countitem(747) > 0) {
				mes "[Canell]";
				mes "你终于带着镜子来了。现在仔细审视倒影，注视脸上的每个瑕疵、缺点和迷人特征。";
				next;
				mes "[Canell]";
				mes "没有脸是完美的，但要知道你的脸只属于你，也正是它赋予了你独一无二的美。现在跟我重复这些真理……";
				next;
				mes "[Canell]";
				mes "‘我很美……我无法抗拒……’";
				next;
				mes "["+ strcharinfo(0) +"]";
				mes "我很美……我无法抗拒……";
				next;
				mes "[Intoxicated Canell]";
				mes "大声点！更有感情！‘我很美！我无法抗拒！我是全世界最有魅力的女人！’";
				next;
				mes "["+ strcharinfo(0) +"]";
				mes "我很美！我无法抗拒！我是全世界最有魅力的女人！";
				specialeffect2 EF_FLASHER;
				next;
				mes "^3355FF你的自尊心直线上升。幸运的是，你成功避免变成自命不凡的人。^000000";
				delitem 747,1; //Crystal_Mirror
				set DANCER_SK,2;
				close;
			}
			else {
				mes "[Frustrated Canell]";
			mes "我不是说过要你带^FF00001面水晶镜^000000回来吗？！快去拿来，免得我找到惩罚你的理由！";
				specialeffect EF_CLAYMORE;
				close;
			}
		}
		else if (DANCER_SK == 2) {
			mes "[Canell]";
			mes "没错，变美的第一步，也是最重要的一步，就是认识并接受自己的美貌。先有自信，再有美丽，绝不能反过来。";
			next;
			mes "[Canell]";
			mes "既然你已经建立了正确的美丽观，现在该学习一种高级技巧——诱惑。我知道一位非常值得推荐的专家。";
			next;
			mes "[Canell]";
			mes "去普隆德拉教堂找我妹妹。提到我的名字，她应该愿意教你。我本来也可以教，但我得享受我的新水晶镜~";
			next;
			mes "^3355FF我就知道她会把你的镜子留下。^000000";
			emotion ET_ANGER, playerattached();
			set DANCER_SK,3;
			close;
		}
		else if (DANCER_SK > 2 && DANCER_SK < 7) {
			mes "[Canell]";
			mes "啊，多么迷人的脸庞和身材。我的美貌无与伦——哦！是你。普隆德拉教堂的妹妹教会你什么了吗？";
			emotion ET_GO;
			close;
		}
		else if (DANCER_SK == 7) {
			mes "[Canell]";
			mes "啊，你找到艾尔了吗？从她那里学到什么了吗？";
			next;
			mes "["+ strcharinfo(0) +"]";
			mes "其实，我只学到了眨眼，却没学会怎么做。她……她喝醉了，没法继续教我。";
			next;
			mes "[Canell]";
			mes "哦，我早该知道会这样。现在也没办法了。不过你应该知道，把我妹妹灌醉……是要受罚的。";
			next;
			mes "[Canell]";
			mes "砰！";
			specialeffect2 EF_HIT2;
			percentheal -5,0;
			next;
			mes "["+ strcharinfo(0) +"]";
			mes "?!";
			mes "那到底是什么？";
			next;
			mes "[Canell]";
			mes "真正的舞者应该能自己找出眨眼的秘诀。但我这么善良，就屈尊解释给你听。呵呵~";
			next;
			mes "^3355FF善良的女人……？她刚才明明打了你！当然很轻，但打了就是打了。^000000";
			set DANCER_SK,8;
			close;
		}
		else if (DANCER_SK == 8) {
			mes "[Canell]";
			mes "好吧，正确眨眼的秘诀是让眼睑以自然节奏诱人地移动。闭眼一秒，再按这个节拍慢慢睁开。";
			next;
			mes "[Canell]";
			mes "一、二、三~看着我，像这样做。一、二、三~现在让我看看你试试。";
			emotion ET_BEST;
			next;
			switch(select("一、二、三~:一、二、三~:一、二、三~")) {
			default:
				mes "[Canell]";
				mes "不，不！错了，完全错了！你就不能做对吗？！";
				next;
				mes "["+ strcharinfo(0) +"]";
				mes "哎、哎哟！求、求你……！别又用鞭子！";
				specialeffect2 EF_HIT2;
				percentheal -5,0;
				close;
			case 3:
				mes "["+ strcharinfo(0) +"]";
				mes "一、二、三~";
				emotion ET_BEST, playerattached();
				specialeffect2 EF_FLASHER;
				next;
				mes "[Canell]";
				mes "很好，就是这样。别忘了，节奏和自然感是这项诱惑技巧不可或缺的要素。";
				emotion ET_CHUP;
				next;
				mes "[Canell]";
			mes "既然你掌握了眨眼的艺术，就该知道你无法诱惑比你强大得多的人。所以眨眼不会对所有人有效。";
				next;
				mes "[Canell]";
			mes "当然，我的眨眼没有这种缺点。呵呵~总之，我们现在该分别了。希望你能成长为";
				mes "成为更加华丽迷人的舞者。";
				emotion ET_SMILE;
				next;
				mes "^3355FF你终于学会了魅惑眨眼技能。^000000";
				set DANCER_SK,9;
				specialeffect2 EF_ABSORBSPIRITS;
				skill "DC_WINKCHARM",1,SKILL_PERM;
				close;
			}
		}
		else if (DANCER_SK > 8 && getskilllv("DC_WINKCHARM")) {
			mes "[Canell]";
			mes "嗯……？你还想问什么吗？啊，你一定被我的美貌迷住了，对吧？";
			emotion ET_HNG;
			next;
			mes "[Canell]";
			mes "哦，如此美丽一定是种罪！我应该在普隆德拉教堂工作，";
			mes "像我妹妹一样，祈求宽恕~";
			close;
		}

		else if (DANCER_SK == 9 && getskilllv("DC_WINKCHARM") == 0) {
			mes "[Canell]";
			mes "嗯？哦，我记得你！现在是吉普赛人了，对吧~很适合你。我猜你超越后忘了几件事，对吗？看这个眨眼……";
			next;
			mes "[Canell]";
			mes "想起来了吗？关键就在眼睑自然、诱人而有节奏的动作。希望你用魅惑眨眼让内在美闪耀~";
			next;
			mes "^3355FF你学会了魅惑眨眼技能。^000000";
			specialeffect2 EF_ABSORBSPIRITS;
			skill "DC_WINKCHARM",1,SKILL_PERM;
			close;
		}
	}
	else if (BaseJob == Job_Dancer && JobLevel < 40) {
		mes "[Canell]";
		mes "哦，你真是个可爱的小姑娘！抱歉，等你成为真正的女士——比如达到职业等级 40——我才能教你一些东西~";
		close;
	}

	else if (BaseJob != Job_Dancer) {
		if (Sex == SEX_FEMALE) {
			mes "[Canell]";
			mes "哦，好可爱的小姑娘~！圆滚滚的小肚子，太可爱了~";
			close;
		}
		else {
			mes "[Canell]";
			mes "嘿，帅哥~";
			mes "^333333*Wink~*^000000";
			emotion ET_CHUP;
			specialeffect2 EF_VALLENTINE2;
			next;
			mes "^3355FF奇怪的是，她的眨眼让你的心怦怦直跳。^000000";
			close;
		}
	}
}

prontera,183,333,1	script	Aelle#qsk_dan02	79,{
	if (BaseJob == Job_Dancer) {
		if (DANCER_SK == 3) {
			mes "[Aelle]";
			mes "嘘，嘿！我有去兽人地下城、古城和死亡之井的便宜但稍微违法的传送。你想来一份吗？";
			next;
			mes "["+ strcharinfo(0) +"]";
			mes "其实，嗯，我是来找人的。你是不是认识卡内尔的妹妹？";
			next;
			mes "[Aelle]";
			mes "啊，是我那个自大的妹妹派你来的？看你的衣服我就该猜到。你想成为更有魅力的表演者，对吧？";
			next;
			mes "[Aelle]";
			mes "啊……真失望。所以……你不是来买传送的？真的不要吗？";
			set DANCER_SK,4;
			close;
		}
		else if (DANCER_SK == 4) {
			mes "[Aelle]";
			mes "好吧，好吧……你是来让我教你诱惑技巧之类的，对吧？嗯，我的讲解又长又复杂。";
			next;
			mes "[Aelle]";
			mes "长时间讲解所有复杂细节一定会让我口渴。所以首先，在开始前你得带一杯清凉饮料……";
			next;
			mes "["+ strcharinfo(0) +"]";
			mes "哦……好吧。我想我可以拿一两瓶药水，或者带一瓶果汁——";
			next;
			mes "[Aelle]";
			mes "等等，别拿那些垃圾！我要喝真正的饮料。你知道，更……^FF0000含酒精^000000的。";
			next;
			mes "[Aelle]";
			mes "哦，我还需要零食补充教学能量！没错，一盘美味水果，再加些饼干！";
			next;
			mes "[Aelle]";
			mes "所以，我要吃^FF00001 个苹果^000000、^FF00003 根香蕉^000000和^FF00005 块烤得很好的饼干^000000。啊，别忘了带^FF0000瓷盘^000000盛放，也别忘了^FF0000酒^000000，明白吗？";
			next;
			mes "[Aelle]";
			mes "最后一件事……！别让教堂里的人知道我们在做什么。我可不想惹上太多麻烦！";
			set DANCER_SK,5;
			close;
		}
		else if (DANCER_SK == 5) {
			if (countitem(970) > 0 && countitem(512) > 0 && countitem(513) > 2 && countitem(538) > 4 && countitem(736) > 0) {
				mes "[Aelle]";
				mes "太好了，你把食物带来了！正好我饿极了，因为我要把它全部吃光！";
				next;

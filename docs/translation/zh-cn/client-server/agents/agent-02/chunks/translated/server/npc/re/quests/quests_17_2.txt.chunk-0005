		cutin "16loo_01",2;
		mes "[Rookie]";
		mes "很难避开瓦尔蒙特宅邸里佣兵和工人的视线。";
		mes "但佣兵不是罪魁祸首。";
		next;
		cutin "",255;
		emotion ET_SURPRISE, getnpcid(0,"Dien#jh5_1");
		select( "可能是佣兵。" );
		cutin "ep162_dn03",2;
		mes "[Dien]";
		mes "你是说我们在撒谎？听过管理者们的话后还这么说？！";
		next;
		cutin "",255;
		select( "佣兵中一定有叛徒。" );
		cutin "ep162_dn03",2;
		mes "[Dien]";
		mes "你这么说一定有足够的证据。";
		mes "现在把证据给我们看。";
		next;
		cutin "",255;
		if (select( "H的可疑行为。", "与企业内部通信的证据。" ) == 1) {
			cutin "16loo_01",2;
			mes "[Rookie]";
			mes "……但没有证据。";
			mes "现在不能只依靠怀疑。我们需要证据，冒险者。";
			close3;
		}
		cutin "ep171_kaya03",2;
		mes "[Kaya Toss]";
		mes "那是……不，这是一个盖有企业印章的信封。它皱得很厉害。你从哪里得到的？这种东西严禁流出雷根贝勒。";
		emotion ET_SURPRISE, getnpcid(0,"Kaya Toss#jh5_1");
		next;
		cutin "ep162_dn01",2;
		mes "[Dien]";
		mes "看看信封里的内容。那才是重要的。";
		mes "虽然我很久没读过了，但我能完美读懂，就像命令书一样。";
		emotion ET_SURPRISE, getnpcid(0,"Dien#jh5_1");
		next;
		cutin "ep162_dn03",2;
		mes "[Dien]";
		mes "我让某人‘处理掉’政府人员，防止他们与佣兵接触……还让他闯入瓦尔蒙特宅邸，偷走瓦尔蒙特的研究数据……";
		next;
		cutin "16loo_01",2;
		mes "[Rookie]";
		mes "收件人签名是‘H.卢肯贝格’。";
		mes "这就是你提到的叛徒身份的证明。";
		next;
		cutin "ep171_kaya02",2;
		mes "[Kaya Toss]";
		mes "..........";
		emotion ET_THINK, getnpcid(0,"Kaya Toss#jh5_1");
		next;
		cutin "ep162_dn01",2;
		mes "[Dien]";
		mes "企业代表，你看起来不太好。";
		next;
		cutin "ep171_kaya01",2;
		mes "[Kaya Toss]";
		mes "……我需要一点时间，有件事想确认。";
		mes "我会联系秘书，请继续，不用等我。";
		emotion ET_THINK, getnpcid(0,"Kaya Toss#jh5_1");
		cloakonnpcself( "Kaya Toss#jh5_1" );
		close2;
		cutin "",255;
		ep17_2_main = 18;
		erasequest 16441;
		setquest 16446;
		end;
	}
	if (ep17_2_main == 18) {
		npctalk "菜鸟：听听里德什怎么说。", "", bc_self;
		end;
	}
	if (ep17_2_main == 19) {
		npctalk "菜鸟：听听企业代表怎么说。", "", bc_self;
		end;
	}
	if (ep17_2_main == 20) {
		cutin "16loo_03",2;
		mes "[Rookie]";
		mes "冒险者，嘿。卡雅先生很沮丧。你能去看看卡雅先生吗？";
		next;
		cutin "16loo_02",2;
		mes "[Rookie]";
		mes "这种时候总会发生糟糕的事……";
		mes "如果你能去看看<NAVI>[花园]<INFO>ba_maison,103,92,0,101,0</INFO></NAVI>，我会安心些。";
		close2;
		cutin "",255;
		ep17_2_main = 21;
		erasequest 16448;
		setquest 16449;
		end;
	}
	if (ep17_2_main < 25) {
		npctalk "菜鸟：这种时候，我还是少说为妙，对吧？", "", bc_self;
		end;
	}
	npctalk "菜鸟：我们取得了很大进展。全都要感谢你的帮助，冒险者。", "", bc_self;
	end;

OnInit:
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "ep17_2_main == 17 && isbegin_quest(16442) == 0 && isbegin_quest(16443) == 0 && isbegin_quest(16444) == 0 && isbegin_quest(16445) == 0 && isbegin_quest(16453) == 0" );
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "isbegin_quest(16448) == 1" );
	end;
}

ba_in01,208,110,3	script	Ridsh#jh5_1	4_F_LEEDSH,{
	if (ep17_2_main == 17) {
		cutin "ep162_rds02",2;
		mes "[Ridsh]";
	mes "希望你没有以为我们陷入困境。";
		close3;
	}
	if (ep17_2_main == 18) {
		cutin "ep162_rds01",2;
		mes "[Ridsh]";
	mes "佣兵还有其他可疑之处吗？";
		next;
		cutin "",255;
	select( "讲述各种可疑活动。 ");
		cutin "ep16_tes01",2;
		mes "[Tess]";
	mes "从佣兵的角度看，他确实可疑。";
	mes "不过似乎只有少数人知道，他们又互相信任，所以整件事没有被揭露。";
		next;
		cutin "ep162_rds01",2;
		mes "[Ridsh]";
	mes "这完全是佣兵的失误。";
	mes "如果当时我有所怀疑并深入调查，也许就会发现。";
		emotion ET_SWEAT;
		next;
		cutin "ep162_dn01",2;
		mes "[Dien]";
	mes "如果当时我们能进一步查清‘H.卢肯贝格’……";
	mes "佣兵战争也许会以不同的结局结束。";
		next;
		cutin "ep16_tes02",2;
		mes "[Tess]";
	mes "知道真相让我很高兴。";
	mes "政府曾提供援助，却被企业阻止了……";
		next;
		cutin "ep162_dn01",2;
		mes "[Dien]";
	mes "很抱歉没有听取你的请求。";
	mes "你不是在伪造证据，只是不知道真相。";
		next;
		cutin "ep16_tes01",2;
		mes "[Tess]";
	mes "我也要道歉，因为没有相信你们的说法，还强行使用我们带来的证据。";
		next;
		cloakoffnpcself( "Kaya Toss#jh5_1" );
		cutin "ep171_kaya01",2;
		mes "[Kaya Toss]";
		mes "..........";
	mes "抱歉突然离开。";
		next;
		mes "[Kaya Toss]";
	mes "我突然想到一件事，就去查了。";
	mes "我想告诉你们我这边发现的情况。";
		next;
		cutin "ep162_dn01",2;
		mes "[Dien]";
	mes "是什么？";
		next;
		cutin "ep171_kaya01",2;
		mes "[Kaya Toss]";
	mes "在企业的员工名册上……有人的经历与H.卢肯贝格当时的行动完全吻合。";
		next;
		cutin "ep162_dn01",2;
		mes "[Dien]";
	mes "我明白了。";
		next;
		cutin "ep171_kaya01",2;
		mes "[Kaya Toss]";
	mes "记录显示他在佣兵战争期间结束长期出差后返回。";
	mes "不过没有记录他去过哪里。";
		next;
		mes "[Kaya Toss]";
	mes "我的秘书格雷翻查了不完整的记录，在剩余的工作日志备忘中找到了这条记录。";
	mes "‘尽快（被删除备忘的痕迹）把他们引到宅邸’";
		next;
		mes "[Kaya Toss]";
	mes "备忘主题写得很模糊，但意思很清楚。";
	mes "那就是，他当时在瓦尔蒙特宅邸……";
		next;
		cutin "ep162_dn03",2;
		mes "[Dien]";
	mes "原来是这样。";
	mes "政府和佣兵又一次被企业玩弄了。";
		next;
		cutin "ep171_kaya02",2;
		mes "[Kaya Toss]";
	mes "真遗憾……";
		close2;
		cutin "",255;
		ep17_2_main = 19;
		erasequest 16446;
		setquest 16447;
		end;
	}
	if (ep17_2_main == 19) {
			npctalk "里德什：公司的人想说点什么。", "", bc_self;
		end;
	}
	if (ep17_2_main < 25) {
			npctalk "里德什：我现在没什么可说的。", "", bc_self;
		end;
	}
	npctalk "里德什：要喝点茶吗？这里有点心，你想吃就拿。", "", bc_self;
	end;


OnInit:
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "isbegin_quest(16446) == 1" );
	end;
}

ba_in01,207,102,3	script	Kaya Toss#jh5_1	4_EP17_KAYA,{
	if (ep17_2_main == 16) {
			npctalk "凯雅·托斯：请听长老们的话。", "", bc_self;
		end;
	}
	if (ep17_2_main == 19) {
		cutin "ep171_kaya01",2;
		mes "[Kaya Toss]";
	mes "所有背景和物证都指向企业。";
	mes "这真是令人遗憾。";
		next;
		cutin "ep171_kaya02",2;
		mes "[Kaya Toss]";
	mes "我很抱歉。";
	mes "作为副总统，我对这一切负有责任。";
		next;
		cutin "ep162_dn01",2;
		mes "[Dien]";
	mes "嗯……企业代表先生，你现在说自己负责有什么意义？";
	mes "道歉能让死者回来吗？";
		next;
		cutin "ep171_kaya01",2;
		mes "[Kaya Toss]";
	mes "我会承担全部责任，从不忘记过去开始。";
		next;
		cutin "ep162_rds03",2;
		mes "[Ridsh]";
	mes "过去？不。重要的是现在正在发生的事。那些叛乱军孩子和科尔仍在生病的人，都是现在的事。";
	mes "你所说的过去一直延续到今天。";
		next;
		cutin "ep162_dn03",2;
		mes "[Dien]";
	mes "你现在要做什么？你可以尽情道歉，但很难改变人们的想法。";
		next;
		cutin "ep162_dn01",2;
		mes "[Dien]";
	mes "现在别再谈这个了。如果你只重复承担责任，却不说打算做什么，我不想再和你谈。";
		next;
		cutin "ep171_kaya03",2;
		mes "[Kaya Toss]";
	mes "但是，长老……";
		next;
		cutin "ep162_ctn01",2;
		mes "[Cotnes]";
	mes "既然你说得如此自豪，就别做得可怜兮兮。";
	mes "呵呵呵，那么我也告辞了。";
		close2;
		cutin "",255;
		ep17_2_main = 20;
		erasequest 16447;
		setquest 16448;
	npctalk "卡雅·托斯：我整理一下思绪后再回来。", "", bc_self;
		cloakonnpcself( "Kaya Toss#jh5_1" );
		end;
	}
	cutin "ep171_kaya01",2;
	mes "[Kaya Toss]";
	mes "最近我想了很多事。";
	close3;

OnInit:
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "isbegin_quest(16447) == 1" );
	end;
}

ba_in01,205,109,3	script(CLOAKED)	Tatio#jh5_1	4_M_TATIO,{
	if (checkweight(1000103,15) == 0) {	// (custom)
		mes "^008800Wait a sec!!";
	mes "你携带的物品太多，无法再领取物品。减轻负重后再试。^000000";
		close;
	}
	if (ep17_2_main == 24) {
		cutin "ep162_dn01",2;
		mes "[Dien]";
	mes "我们散步回来后来了位新客人。";
		next;
		cutin "ep171_kaya01",2;
		mes "[Kaya Toss]";
	mes "不，塔蒂奥！我通过格雷联系了你，但没想到你这么快就到了！";
		next;
		cutin "ep15_tatio01",2;
		mes "[Tatio]";
	mes "从格雷那里听说后，我觉得事情很紧急。";
	mes "所以决定尽快亲自来一趟。";
		next;
		cutin "ep162_dn02",2;
		mes "[Dien]";
	mes "重要的是你要向我们展示你打算做什么。";
	mes "这是很好的第一步。";
		next;
		cutin "ep15_tatio01",2;
		mes "[Tatio]";
	mes "如你所知，雷根贝勒已经迈出了一步。";
	mes "贵国不是已经解除传送魔法限制了吗？";
		next;
		cutin "ep16_tes01",2;
		mes "[Tess]";
	mes "是的，这是企业做出的考量。";
		next;
		cutin "ep15_tatio01",2;
		mes "[Tatio]";
	mes "除此之外，我打算做企业应该做的事。";
		next;
		cutin "ep162_dn01",2;
		mes "[Dien]";
	mes "我已经告诉过你，但现在不是做模糊承诺的好时候。";
	mes "我想知道你具体能做什么。";
		next;
		cutin "ep15_tatio01",2;
		mes "[Tatio]";
	mes "一接到副总统卡雅·托斯的联系我就出发了，刚刚才到。";
	mes "我知道你想听什么，但不能在这里擅自决定一切。";
		next;
		mes "[Tatio]";
	mes "不过我会告诉你所有我能以职权做出的承诺。";
		next;
		mes "[Tatio]";
	mes "托斯副总统，我看过你与政府特工和冒险者合作的报告。";
	mes "感谢你的辛劳。";
		next;
		cutin "ep171_kaya01",2;
		mes "[Kaya Toss]";
	mes "谢谢你，塔蒂奥。";
		next;
		cutin "ep15_tatio01",2;
		mes "[Tatio]";
	mes "我已经看到了发生的一切。";
	mes "现在我必须采取行动。";
		next;
		cutin "16loo_01",2;
		mes "[Rookie]";
	mes "啊……你是说秘书吗？";
		next;
		cutin "ep15_tatio01",2;
		mes "[Tatio]";
		mes "为了维护企业的诚信，我们会严格执行规则，防止这些事情再次发生。";
		next;
		mes "[Tatio]";
		mes "现在很难说明一切，但我承诺将与政府和民间部门合作，而不是只依靠企业本身。";
		next;
		cutin "ep16_tes02",2;
		mes "[Tess]";
		mes "所以，你打算把秘书的意见告诉总统，对吧？";
		next;
		cutin "ep15_tatio01",2;
		mes "[Tatio]";
		mes "我们也会接受副总统卡雅·托斯的意见，彻底分析他的调查结果，并据此分配补偿和惩罚。";
		next;
		cutin "ep162_dn01",2;
		mes "[Dien]";
		mes "这是总统的意愿，对吧？";
		next;
		cutin "ep15_tatio01",2;
		mes "[Tatio]";
		mes "是的……当然。";
		next;
		mes "[Tatio]";
		mes "为此，企业希望与政府和叛乱军进一步沟通。";
		next;
		cutin "ep16_tes01",2;
		mes "[Tess]";
		mes "这也是政府所希望的。";
		mes "今后还有很多事要谈。";
		next;
		cutin "ep162_dn02",2;
		mes "[Dien]";
		mes "既然你来了，而且这里有美味的茶点，为什么不讲些故事？";
		mes "你千里迢迢来到这里，不会空手而来吧？";
		next;
		cutin "ep15_tatio01",2;
		mes "[Tatio]";
		mes "那就马上开始吧。";
		mes "这里适合长谈。";
		next;
		cutin "ep162_dn01",2;
		mes "[Dien]";
		mes "故事越精彩越好。";
		next;
		cutin "16loo_01",2;
		mes "[Rookie]";
		mes "嗯……冒险者，我想这里的代表们会长谈一番。";
		mes "我们出去吧？";
		next;
		select( "我再听一会儿。", "我去外面。" );
		cutin "16loo_02",2;
		mes "[Rookie]";
		mes "随你喜欢，冒险者。我会在外面等。";
		mes "你在宅邸里四处奔波，做得很棒。";
		next;
		mes "[Rookie]";
		mes "另外，虽然不多，但我给你一些巴尔米尔入场券。这是从这里的自动人偶那里拿到的。";
		mes "感谢你的辛勤工作！";
		close2;
		cutin "",255;
		cloakonnpcself( "Rookie#jh5" );
		ep17_2_main = 25;
		completequest 16452;
		getitem 1000103,20;
		getexp 900000,0;	// note: ~exp. getbaseexp_ratio?
		end;
	}
	npctalk "塔蒂奥：我会谦虚地听取一切。", "", bc_self;
	end;

OnInit:
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "isbegin_quest(16452) == 1" );
	end;
}

ba_in01,204,113,5	script	Cotnes#jh5_1	4_F_COATNEIS,{
	if (ep17_2_main == 17) {
		cutin "ep162_ctn01",2;
		mes "[Cotnes]";
		mes "我没空听你们的故事。";
		close3;
	}
	if (ep17_2_main == 18) {
		npctalk "科特尼斯：看来里德什有话要说。", "", bc_self;
		end;

	npctalk "科特尼斯：这里的每个人都精神饱满。呵呵呵。", "", bc_self;
	end;
}

ba_maison,103,92,3	script	Kaya Toss#jh5_2	4_EP17_KAYA,{
	if (checkweight(1000103,15) == 0) {	// (custom)
		mes "^008800Wait a sec!!";
		mes "你携带的物品太多，无法再领取物品。减轻负重后再试。^000000";
		close;
	}
	if (ep17_2_main == 21) {
		cloakoffnpcself( "Assassin#jh5_1" );
		mes "[???]";
		mes "真没想到你会为了大家取出肝脏和胆囊。";
		mes "企业以你为耻。";
		next;
		cutin "ep171_kaya01",2;
		mes "[Kaya Toss]";
		mes "?!?";
		next;
		cutin "ep171_kaya03",2;
		mes "[Kaya Toss]";
		mes "你是谁？为什么躲在这种地方？";
		next;
		cutin "",255;
		mes "[???]";
		mes "副总统，我是雷根贝勒董事会的人……你不需要知道我的身份。";
		next;
		cutin "ep171_kaya03",2;
		mes "[Kaya Toss]";
		mes "你真无礼……！这里不是谁都能随意进出的地方。你为什么偷偷来找我？";
		next;
		cutin "",255;
		mes "[???]";
		mes "企业担心副总统的行动。你还要被他们的巧言令色左右多久？如果企业代表一再做出损害企业利益的行为，你会怎么办？";
		next;
		cutin "ep171_kaya01",2;
		mes "[Kaya Toss]";
		mes "损害企业利益？我一直都在为企业的利益工作。";
		next;
		cutin "",255;
		mes "[???]";
		mes "举一个例子。对事故做出过度补偿承诺，高估企业责任。";
		mes "你不仅损害企业财务，也损害企业声誉。";
		next;
		mes "[???]";
		mes "企业为什么要为幻象造成的事故赔偿？";
		mes "相反，应该由企业获得赔偿。";
		next;
		cutin "ep171_kaya01",2;
		mes "[Kaya Toss]";
		mes "我向那些以企业名义工作、由我们雇用的人承诺福利，有什么问题吗？";
		next;
		cutin "",255;
		mes "[???]";

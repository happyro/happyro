//===== rAthena Script =======================================
//= Valentine Event Script + EXP bonus
//===== By: ==================================================
//= Lupus (based on Muad_Dib's work)
//===== Current Version: =====================================
//= 1.1
//===== Compatible With: =====================================
//= rAthena Project; SVN r4500+
//===== Description: =========================================
// Close to other official stValentine event (added white chocolate)
// Custom: Handmade choco gives some EXP bonuses to married people
//===== Additional Comments: =================================
//= WARNING!! To use this event, disable original valentinesday.txt
//= You can use this event from 12 till 16 February 8) [Lupus]
//= 1.1 Removed Duplicates [Silent]
//============================================================

// Tine - Valentine Event Chocolate Even Guide ------------------
prontera,156,172,4	script	Tine	58,{
//  Debug info for item effects and tricky conditions 8)
//	mes "@dsv: "+@dsv;
//	mes "ispartneron()=="+ispartneron();
//	mes "Sex == "+Sex;
//	if(@dsv == gettime(DT_HOUR)+1) mes "@dsv == gettime(DT_HOUR)+1";

	mes "[Tine]";
	mes "传说在 2 月 14 日，也就是圣瓦伦丁节……";
	mes "只有在卢恩·米德加尔特王国……";
	next;
	specialeffect EF_HITBODY;
	mes "[Tine]";
	mes "一些已婚的巧克力爱好者在训练时经验几乎翻倍！";
	mes "但事情并没有那么简单……";
	next;
	menu "Wow! Tell me more!",M_INFO,"Marri... what?",-;

	mes "[Tine]";
	mes "你是单身吗？";
	mes "今天是向心爱的人求婚的好日子！";
	next;
	mes "[Tine]";
	mes "最近结婚费用低得惊人！";
	close;

M_INFO:
	mes "[Tine]";
	mes "魔法效果只存在于使用祖传秘方制作的手工巧克力中！";
	next;
	mes "[Tine]";
	mes "众所周知，黑色手工巧克力对已婚男性有效……白色的则对已婚女性有效！";
	mes "如果你弄丢了结婚戒指……那就无法生效了。";
	next;
	mes "[Tine]";
	mes "吃下巧克力后，先取下戒指……再戴回去……如果伴侣在线，魔法效果会持续到下一个小时！";
	next;
	mes "[Tine]";
	mes "传闻男女双方对五种不同种族的怪物都有 +50% 经验加成……当然不包括可怕的 Boss。";
	next;
	mes "[Tine]";
	mes "普隆德拉城堡里有一位著名糕点师！你需要去找他。";
	close;

OnInit:
	//559,Hand-made_Chocolate
	setitemscript 559,"{ itemheal 50,50; if(Sex==SEX_FEMALE || @dsv == gettime(DT_HOUR)+1 || ispartneron()==0)end; set @dsv,gettime(DT_HOUR)+1; misceffect EF_MAGNUS; }";
	//560,Hand-made_White_Chocolate
	setitemscript 560,"{ itemheal 50,50; if(Sex==SEX_MALE || @dsv == gettime(DT_HOUR)+1 || ispartneron()==0)end; set @dsv,gettime(DT_HOUR)+1; misceffect EF_MAGNUS; }";

	//2634,Wedding_Ring_M,Wedding Ring,5,,10,0,,0,,0,127918079,7,1,136,,0,0,0,{ skill 334,1; skill 335,1; skill 336,1; }
	setitemscript 2634,"{ skill 334,1; skill 335,1; skill 336,1; if(@dsv == gettime(DT_HOUR)+1 && ispartneron()){ bonus2 bExpAddRace,5,50; bonus2 bExpAddRace,6,50; bonus2 bExpAddRace,7,50; bonus2 bExpAddRace,8,50; bonus2 bExpAddRace,1,50; } }";
	//2635,Wedding_Ring_F,Wedding Ring,5,,10,0,,0,,0,127918079,7,0,136,,0,0,0,{ skill 334,1; skill 335,1; skill 336,1; }
	setitemscript 2635,"{ skill 334,1; skill 335,1; skill 336,1; if(@dsv == gettime(DT_HOUR)+1 && ispartneron()){ bonus2 bExpAddRace,0,50; bonus2 bExpAddRace,9,50; bonus2 bExpAddRace,2,50; bonus2 bExpAddRace,3,50; bonus2 bExpAddRace,4,50; } }";
	end;
}

// Stephen - Valentine Event Chocolate seller ------------------
alberta,26,243,4	script	Stephen#val1	58,{
	mes "[Stephen]";
	mes "猜猜我有什么？";
	mes "这是米德加尔特不容易找到的美味点心……";
	next;
	mes "[Stephen]";
	mes "巧克力！";
	mes "没错，你不喜欢巧克力吗……我很喜欢。";
	mes "而且你很幸运，我只卖 5000 Zeny 一块！";
	next;
	menu "I want some chocolate!",M_CHOCO,"No thanks.",-;

	mes "[Stephen]";
	mes "你不想要巧克力吗？";
	mes "相信我，你会后悔的！";
	mes "现在最好买一些……以后再也遇不到这样的巧克力了！";
	mes "想清楚后再来找我。";
	close;

M_CHOCO:
	mes "[Stephen]";
	mes "哈！";
	mes "我就知道！";
	mes "不过一次最多只能卖 5 块……如果你真的需要更多……";
	mes "可以再回来购买。";
	mes "那么你想要多少？";
	next;
	set @needmon,0;
	input @flag_num;
	if (@flag_num <= 0) goto L_NONE;
	if (@flag_num > 5) goto L_ERR;
	set @needmon,@flag_num*5000;
	if (Zeny < @needmon) goto L_NOTENO;
	set Zeny,Zeny - @needmon;
	getitem 558,@flag_num;
	mes "[Stephen]";
	mes "给你！";
	mes "可以把它送给别人，也可以自己享用！";
	mes "嗯……甜美的巧克力……";
	mes "随时欢迎再来……！";
	close;

L_ERR:
	mes "[Stephen]";
	mes "抱歉，我不能给你那么多。";
L_NONE:
	close;

L_NOTENO:
	mes "[Stephen]";
	mes "抱歉，你似乎买不起这些。";
	close;
}

// Jainie -- Gives information about Valentine Event ------------------------
alberta,29,243,4	script	Jainie#val1	53,{
	mes "[Jainie]";
	mes "你知道吗？我男朋友卖的巧克力是我做的！";
	mes "我亲手制作了它们。现在我需要牛奶来制作特别的白巧克力。";
	next;
	mes "[Jainie]";
	mes "你知道吗……有些国家有把巧克力送给爱人的传统……";
	mes "他们称之为 ^3355FF情人节^000000。";
	next;
	mes "[Jainie]";
	mes "所以我把美味的巧克力给了他……";
	mes "然后他让我制作更多……";
	mes "现在他把巧克力卖给大家。";
	mes "我想他真的很喜欢。";
	mes "看到别人购买我做的东西，我也很开心。";
	next;
	mes "[Jainie]";
	mes "如果你也能买一些就太好了……";
	mes "我会制作一阵子白巧克力，所以……";
	next;
	menu "我想要白巧克力！",M_CHOCO,"不用了。",-;

	mes "[Jainie]";
	mes "你不喜欢白巧克力吗？";
	mes "那就买一些斯蒂芬的黑巧克力吧！";
	close;

M_CHOCO:
	mes "[Jainie]";
	mes "一次最多只能卖给你 5 份……但如果你需要更多……";
	mes "可以再回来购买。";
	mes "你想要多少？1 份需要 4500 Zeny + 1 瓶牛奶。";
	next;
	set @needmon,0;
	input @flag_num;
	if (@flag_num == 0) goto L_NONE;
	if (@flag_num > 5) goto L_ERR;
	set @needmon,@flag_num*4500;
	if (Zeny < @needmon) goto L_NOTENO;
	if (countitem(519) < @flag_num) goto L_NOMILK;
	set Zeny,Zeny - @needmon;
	delitem 519,@flag_num;
	getitem 561,@flag_num;
	mes "[Jainie]";
	mes "给你！";
	mes "可以送给别人当礼物，也可以自己享用！";
	mes "嗯……甜美的巧克力……";
	mes "随时欢迎再来……！";
	close;

L_ERR:
	mes "[Jainie]";
	mes "抱歉，我不能给你那么多。";
L_NONE:
	close;

L_NOTENO:
	mes "[Jainie]";
	mes "抱歉，你似乎买不起这些。";
	close;

L_NOMILK:
	mes "[Jainie]";
	mes "制作 "+@flag_num+" 份特别白巧克力需要 "+@flag_num+" 瓶牛奶……";
	close;
}

// Carl Orleans -- Valentine Event Chocolate maker ------------------
prt_castle,54,34,4	script	Carl Orleans#val1	47,{
	mes "[Carl Orleans]";
	mes "好的？想让我为你制作什么？";
	next;
	menu "请给我黑色手工巧克力",-,"我想要白色手工巧克力……",M_WHITE,"我迷路了，抱歉打扰。",M_END;
     
	mes "[Carl Orleans]";
	mes "嗯……我也许能满足你的需求……";
	next;
	if (countitem(558)<3) {
		mes "[Carl Orleans]";
	mes "抱歉，你没有足够的巧克力棒。";
	if(rand(2))mes "听说艾尔贝塔的斯蒂芬以前卖过很好的巧克力。";
		close;
	}
	delitem 558,3;
	mes "[Carl Orleans]";
	mes "我看到你带来了 3 块纯巧克力。";
	mes "把它们交给我……";
	next;
	mes "[Carl Orleans]";
	mes "好吧，只要你答应合理使用，我就制作特别的手工巧克力。";
	next;
	mes "[Carl Orleans]";
	mes "……嗯……";
	mes "好吧……";
	next;
	getitem 559,1;
	mes "[Carl Orleans]";
	mes "给你。";
	if(rand(2))close;
	mes "希望你把它送给特别的人，因为这是特别的巧克力。";
	mes "如你所知……只有我能制作它。";
	next;
	mes "[Carl Orleans]";
	mes "请享用。";
	close;

M_WHITE:
	mes "[Carl Orleans]";
	mes "嗯……我也许能满足你的需求……";
	next;
	if (countitem(561)<3) {
		mes "[Carl Orleans]";
	mes "抱歉，你没有足够的白巧克力棒。";
	if(rand(2))mes "听说艾尔贝塔的珍妮以前卖过很好的白巧克力。";
		close;
	}
	delitem 561,3;
	mes "[Carl Orleans]";
	mes "我看到你带来了 3 块纯白巧克力。";
	mes "把它们交给我……";
	next;
	mes "[Carl Orleans]";
	mes "好吧，只要你答应合理使用，我就制作特别的手工巧克力。";
	next;
	mes "[Carl Orleans]";
	mes "....Hmmmmmm.....";
	mes "好吧……";
	next;
	getitem 560,1;
	mes "[Carl Orleans]";
	mes "给你。";
	if(rand(2))close;
	mes "希望你把它送给特别的人，因为这是特别的巧克力。";
	mes "如你所知……只有我能制作它。";
	next;
	mes "[Carl Orleans]";
	mes "请享用。";
	close;

M_END:
	mes "[Carl Orleans]";
	mes "哦……如果你想让我制作特别的手工巧克力……";
	mes "你至少需要给我 ^0000FF 3 块巧克力^000000 或 ^0000FF 3 块白巧克力^000000。";
	if(rand(2))close;
	next;
	mes "[Carl Orleans]";
	mes "没错，只要 ^0000FF 3 块巧克力^000000 或 ^0000FF 3 块白巧克力^000000。";
	mes "把它们带给我，就能得到你想要的东西。";
	if(rand(2))close;
	next;
	mes "[Carl Orleans]";
	mes "再见。";
	close;
}

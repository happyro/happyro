			if ('devil_tower == 1)
				getitem 7641,1;// Medical_Cure_Box
			close;
		}
		mes "[Healer Fama]";
		mes "抱歉……现在物资供应不足，我一次只能提供一个急救包。";
		mes "用完后请再来申请。";
		close;
	}
	mes "[Healer Fama]";
	mes "嗯……好吧，我们现在可以休息了。";
	mes "非常感谢！";
	close;
}

1@tnm1,39,114,3	script	Injured Soldier#1_1	4_TOWER_01,3,3,{
	if ('devil_tower != 1)
		end;
	if (countitem(7641) < 1) {
		mes "治疗受伤士兵需要1个急救包。";
		close;
	}
	mes "这名士兵失去了意识，正在呻吟。";
	mes "要使用急救包吗？";
	next;
	if (select( "Use first-aid kit.", "Observe condition." ) == 2) {
		mes "你决定继续观察受伤士兵的状况。";
		close;
	}
	mes "你为士兵使用了急救包。";
	next;
	specialeffect EF_SPHERE;
	progressbar "000000",10;
	if ('devil_tower == 1) {
		delitem 7641,1;
		specialeffect EF_ENTRY;
		disablenpc();
		enablenpc instance_npcname( strnpcinfo(1) + "#" + replacestr( strnpcinfo(2), "_1", "" ) );
		specialeffect EF_ENTRY,AREA, instance_npcname( strnpcinfo(1) + "#" + replacestr( strnpcinfo(2), "_1", "" ) );
		mes "成功了。";
		'heal_count++;
		if ('heal_count == 7) {
			'devil_tower = 2;
			npctalk "治疗师Fama：刺客？！", instance_npcname("Healer Fama#feima");
			enablenpc instance_npcname("Lucile#tnm01");
			enablenpc instance_npcname("Magic Swordman#tnm01");
			enablenpc instance_npcname("Assassin Huey#tnm01");
			enablenpc instance_npcname("Assassin Louie#tnm01");
		}
	}
	close;

OnTouch:
	.@num = atoi( replacestr( strnpcinfo(2), "_1", "" ) );
	if (.@num == 1)
		npctalk "受伤士兵：呻吟……";
	else if (.@num == 2)
		npctalk "受伤士兵：呜啊……";
	else if (.@num == 3)
		npctalk "受伤士兵：……啊……啊……";
	else if (.@num == 4)
		npctalk "受伤士兵：呜啊……";
	else if (.@num == 5)
		npctalk "受伤士兵：我不想死……";
	else if (.@num == 6)
		npctalk "受伤士兵：呜啊～";
	else
		npctalk "受伤士兵：呻吟……";
	end;
}


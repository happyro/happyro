1@tnm1,46,105,5	script	Lucile#tnm01	4_F_LUCILE,{
	if (is_party_leader() == false) {
		cutin "tnm_lucile01.bmp",2;
		mes "[Lucile]";
		mes "谁负责带领支援队？";
		close3;
	}
	if ('devil_tower == 2) {
		.@lucile$ = instance_npcname("Lucile#tnm01");
		.@heim$ = instance_npcname("Officer Heim#heim");
		'devil_tower = 3;
		setpcblock PCBLOCK_NPC, true;
		cutin "tnm_lucile01.bmp",2;
		sleep2 1500;
		 npctalk "Lucile：我是刺客公会的Lucile。", .@lucile$;
		sleep2 2000;
		npctalk "Heim军官：我们的支援来自刺客公会？谢谢你们及时赶到。", .@heim$;
		sleep2 3000;
		npctalk "Lucile：情况似乎不太妙。", .@lucile$;
		sleep2 3000;
		npctalk "Lucile：普隆德拉的勇敢骑士们怎么了？", .@lucile$;
		sleep2 3000;
		npctalk "Heim军官：你是在嘲笑我吗？", .@heim$;
		sleep2 3000;
		npctalk "Lucile：完全不是。我是真的想知道。楼上发生了什么？", .@lucile$;
		sleep2 2500;
		emotion ET_OHNO, getnpcid(0, .@heim$);
		sleep2 1000;
		npctalk "Heim军官：你怎么知道？没错，恶魔已经停止从楼上发动攻击了。", .@heim$;
		sleep2 3000;
		emotion ET_SMILE, getnpcid(0, .@lucile$);
		npctalk "Lucile：你怎么看这个情况，魔剑士？", .@lucile$;
		cutin "tnm_lucile01.bmp",0;
		sleep2 3000;
		npctalk "魔剑士：嗯，我去调查。", instance_npcname("Magic Swordman#tnm01");
		cutin "tnm_loki.bmp",2;
		sleep2 2000;
		cutin "",255;
		disablenpc instance_npcname("Magic Swordman#tnm01");
		sleep2 1000;
		npctalk "Lucile：你怎么这么快？", .@lucile$;
		cutin "tnm_lucile01.bmp",2;
		sleep2 2000;
		npctalk "Heim军官：你在做什么？独自去会被杀的！", .@heim$;
		sleep2 3000;
		npctalk "Lucile：我不会独自行动，还有一些没有受伤的士兵！", .@lucile$;
		sleep2 2500;
		npctalk "Lucile：好吧，我要请你做我的支援。哈哈哈，对吧Dewey？", .@lucile$;
		sleep2 500;
		enablenpc instance_npcname("Assassin Dewey#tnm01");
		enablenpc instance_npcname("#tnm1stepmob");
		npctalk "Dewey：好的，我会的。", instance_npcname("Assassin Dewey#tnm01");
		'devil_tower = 4;
		sleep2 500;
		cutin "",255;
		disablenpc .@lucile$;
		disablenpc instance_npcname("Assassin Huey#tnm01");
		disablenpc instance_npcname("Assassin Louie#tnm01");
		sleep2 2000;
		npctalk "Heim军官：他们真是难以预测。你知道发生了什么，对吧？支援他们……", .@heim$;
		sleep2 2500;
		npctalk "Heim军官：帮我们处理从楼上下来的恶魔。", .@heim$;
		setpcblock PCBLOCK_NPC, false;
		end;
	}
}


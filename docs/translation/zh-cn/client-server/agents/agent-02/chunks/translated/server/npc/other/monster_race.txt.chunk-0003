	end;
}

p_track02,73,22,1	script	Ticket Helper#2	899,{
	if (!checkweight("Spawn",200)) {
				mes "[赛票助手]";
		mes "欢迎来到怪物赛跑竞技场。";
		mes "如果想参加^3131FF双怪物赛跑^000000，";
		mes "请从列表中选择 6 只怪物中的 1 只。";
		next;
				mes "[赛票助手]";
		mes "等等，等等……";
		mes "我现在什么也不能给你。";
		mes "你携带的东西太多了……";
		close;
	}
	if (!monster_race_2_1 && !monster_race_2_2) {
				mes "[赛票助手]";
		mes "你好！";
		mes "想押双怪物赛跑吗？";
		mes "有问题或想下注的话，我可以帮你。";
		next;
			switch(select("查看怪物状态:下注:怪物赛跑？:取消")) {
// 切片行数保留
// 切片行数保留
// 切片行数保留
// 切片行数保留
// 切片行数保留
// 切片行数保留
// 切片行数保留
// 切片行数保留
		case 1:
			for ( .@i = 1; .@i <= 6; .@i++ )
				mes "怪物" + .@i + " [^CC6600运气^000000: " + getd("$@mon_r02_Luk"+.@i) + "] [^EE0000HP^000000: " + getd("$@mon_r02_tire"+.@i) + "]";
			close;
		case 2:
				mes "[赛票助手]";
			mes "好，请选择";
			mes "你认为会获胜的两只怪物。";
			mes "将获得第一和第二名。";
			mes "如果两只怪物都进入";
			mes "第一和第二名（顺序不限），";
			mes "你就能赢得赌注。";
			next;
				mes "[赛票助手]";
			mes "现在请告诉我";
			mes "你的第一选择，";
			mes "参赛怪物中，";
			mes "你认为会赢得这场比赛的。";
			next;
			for ( .@i = 1; .@i <= 6; .@i++ )
				.@menu$ = .@menu$ + "怪物 "+ .@i +":";
			while (1) {
				if ( .@m1 > 0 )
					.@menu$ = replacestr( .@menu$, "怪物 "+ .@m1, "" );
				.@m = select (.@menu$);
				switch (.@m) {
					case 1: setarray .@string$, "友善的","波利型怪物"; break;
					case 2: setarray .@string$, "可爱的","疯兔型怪物"; break;
					case 3: setarray .@string$, "讨人喜欢的","小野猪怪物"; break;
					case 4: setarray .@string$, "温和的小","沙漠之狼怪物"; break;
					case 5: setarray .@string$, "小巧却","恶魔般的邪恶使者"; break;
					case 6: setarray .@string$, "淘气的","巴风特 Jr. 怪物"; break;
				}
				mes "[赛票助手]";
				mes "你选择了";
				mes "^0000FF怪物 "+.@m+"^000000，"+ .@string$[0];
				mes .@string$[1]+".";
				mes "确定要";
				mes "选择这只怪物吗？";
				next;
				if (select("是:否") == 2) {
				mes "[赛票助手]";
					mes "你取消了";
					mes "下注。好吧，";
					mes "我明白了。也许";
					mes "先查看怪物会更放心？";
					mes "先查看怪物？";
					close;			
				}
				if (.@m1 == 0) {
				mes "[赛票助手]";
					mes "现在，请做出";
					mes "你的第二个选择";
					mes "选择你认为";
					mes "会获胜的怪物。";
					mes "赢得本场比赛的第一名或第二名。";
					next;
					.@m1 = .@m;
				} else {
					if (!$@mon_time_2_2) {
				mes "[赛票助手]";
						mes "你已下注";
						mes "^0000FF怪物 "+.@m1+"^000000 和 ^0000FF怪物 "+.@m+"^000000";
						mes "赢得比赛。祝你好运！";
						mes "真心希望赔率";
						mes "对你有利~";
						emotion ET_CHUP;
						monster_race_2_1 = .@m1;
						monster_race_2_2 = .@m;
						getitem 7514,1; //Monster_Ticket
					} else {
				mes "[赛票助手]";
						mes "非常抱歉，";
						mes "怪物赛跑正在进行。";
						mes "请等待，然后为下一场比赛";
						mes "下注。";
					}
					close;
				}
			}
		case 3:
				mes "[赛票助手]";
			mes "怪物赛跑起源于";
			mes "简单的儿童游戏，";
			mes "可爱宠物互相竞赛，后来发展成流行的成人消遣，";
			mes "我们因此在胡格尔建造了赛跑竞技场。";
			next;
				mes "[赛票助手]";
			mes "怪物赛跑竞技场有";
			mes "两种比赛。首先是单怪物赛跑，";
			mes "押中第一名怪物的人会获得奖励。";
			next;
			mes "[埃克拉·埃尔比德]";
			mes "然后是双怪物赛跑，押中第一和第二名怪物的人";
			mes "会获得相同奖励。";
			mes "两只怪物同样会获奖。双赛的";
			mes "赔率和下注奖励高于单赛。";
			next;
				mes "[赛票助手]";
			mes "虽然需要少量入场费，";
			mes "但我们只用这些钱奖励";
			mes "参赛者并维护";
			mes "竞技场，因此";
			mes "我们不会";
			mes "从这项事业中牟利。";
			next;
				mes "[赛票助手]";
			mes "此外，禁止他人";
			mes "根据比赛结果";
			mes "使用物品和";
			mes "Zeny 进行私人下注。";
			mes "这种";
			mes "赌博在这里是违法的……";
			next;
				mes "[赛票助手]";
			mes "进入赛跑竞技场后，你会获得赛跑票。";
			mes "请注意，获胜赛跑票只能在比赛结束后";
			mes "5 分钟内兑换奖牌。";
			next;
				mes "[赛票助手]";
			mes "你已经在";
			mes "怪物赛跑";
			mes "竞技场内，不妨";
			mes "试着下注。这比你想象的";
			mes "更有趣~";
			close;
		case 4:
				mes "[赛票助手]";
			mes "你取消了";
			mes "下注。好吧，";
			mes "我明白了。也许";
			mes "先查看怪物会更放心？";
			mes "先查看怪物？";
			close;
		}
	} else {
		if (countitem(7514)) {
				mes "[赛票助手]";
			mes "你已下注";
		mes "^0000FF怪物 " + monster_race_2_1 + "^000000 和 ^0000FF怪物 " + monster_race_2_2 + "^000000";
			mes "参加这场双怪物赛跑。";
			next;
		} 
				mes "[赛票助手]";
		mes "比赛开始将通过广播宣布。";
		mes "比赛开始会通过广播宣布。";
		mes "你可以查看小地图";
		mes "追踪怪物的比赛";
		mes "位置。谢谢，";
		mes "祝你玩得开心！";
		viewpoint 1,43,35,0,0xFF0000;
		close;	
	}

OnInit:
	disablenpc "Ticket Helper#2";
	end;
}

p_track02,39,49,3	script	Game Guide#double	845,{
	mes "[游戏向导]";
	mes "欢迎来到";
	mes "怪物赛跑竞技场。";

	donpcevent "#savagebebe1::OnEnable";
	donpcevent "#desertwolf1::OnEnable";
	donpcevent "#deviruchi1::OnEnable";
	donpcevent "#baphomet1::OnEnable";
	stopnpctimer;
	disablenpc "#race_timer2-2";
	end;

OnInit:
	disablenpc "#race_timer2-2";
	$@mon_time_2_2 = 0;
	end;
}

p_track02,80,43,0	script	#race_timer2-3	-1,{
OnEnable:
	enablenpc "#race_timer2-3";
	initnpctimer;
	end;

OnTimer3000:
	mapannounce "p_track02","The Monster Race is finished! Congratulations to all the winners!",bc_map,"0xFFFF00";
	end;

OnTimer6000:
	mapannounce "p_track02","Please give your Racing Ticket to the Medal Distributor if you bet on the winning monster.",bc_map,"0xFFFF00";
	end;

OnTimer9000:
	mapannounce "p_track02","You have 5 minutes to exchange a winning ticket for Prize Medals from the Medal Distributor.",bc_map,"0xFFFF00";
	end;

OnTimer12000:
	mapannounce "p_track02","All tickets become void after this 5 minute period, so winners should claim their prize now.",bc_map,"0xFFFF00";
	end;

OnTimer15000:
	mapannounce "p_track02","Please leave the Race Arena before this 5 minute period elapses. Thank you.",bc_map,"0xFFFF00";
	end;

OnTimer240000:
	mapannounce "p_track02","Attention. We will being preparing for the next race shortly...",bc_map,"0xFFFF00";
	end;

OnTimer243000:
	mapannounce "p_track02","We will close the Racing Arena in 1 minute to prepare for the next race.",bc_map,"0xFFFF00";
	end;

OnTimer246000:
	mapannounce "p_track02","Participants in the last race should leave the arena as soon as possible.",bc_map,"0xFFFF00";
	end;

OnTimer249000:
	mapannounce "p_track02","Thank you for your cooperation.",bc_map,"0xFFFF00";
	end;

OnTimer252000:
	mapannounce "p_track02","We hope that you enjoyed the Monster Race arena. Come back again soon~",bc_map,"0xFFFF00";
	end;

OnTimer300000:
	mapwarp "p_track02","hugel",63,73;
	disablenpc "Medal Distributor#medal";
	donpcevent "#race_timer2-1::OnEnable";
	stopnpctimer;
OnInit:
	$@mon_race_2_1 = $@mon_race_2_2 = 0;
	disablenpc "#race_timer2-3";
	end;
}

hugel,62,69,1	script	Eckar Erenes#double	798,{
	mes "[埃卡·埃雷尼斯]";
	mes "欢迎来到怪物赛跑竞技场，";
	mes "这是胡格尔村的骄傲！";
	mes "我能为你做什么？";
	next;
	if (select("怪物赛跑介绍:进入怪物赛跑") == 1) {
		mes "[埃卡·埃雷尼斯]";
		mes "怪物赛跑起源于简单的儿童游戏，";
		mes "可爱宠物在其中互相竞赛。后来发展成流行的成人消遣，";
		mes "我们因此在胡格尔建造了赛跑竞技场。";
		next;
		mes "[埃卡·埃雷尼斯]";
		mes "怪物赛跑竞技场有两种比赛。首先是单怪物赛跑，";
		mes "押中第一名怪物的人会获得奖励。";
		next;
		mes "[埃卡·埃雷尼斯]";
		mes "然后是双怪物赛跑，赔率和奖励高于单怪物赛跑：";
		mes "你必须押两只怪物，并且它们分获第一和第二名才能获胜。";
		next;
		mes "[埃卡·埃雷尼斯]";
		mes "虽然需要少量入场费，但我们只用这些钱奖励参赛者、维护竞技场。";
		mes "所以我们不会从这项事业中牟利。";
		next;
		mes "[埃卡·埃雷尼斯]";
		mes "此外，禁止他人根据比赛结果，使用物品和 Zeny 进行私人下注。";
		mes "这种赌博在这里是违法的……";
		next;
		mes "[埃卡·埃雷尼斯]";
		mes "进入赛跑竞技场后，你会获得赛跑票。";
		mes "请注意，获胜赛跑票只能在比赛结束后 5 分钟内兑换奖牌。";
		next;
	}
	mes "[埃卡·埃雷尼斯]";
	mes "怪物赛跑竞技场所有比赛的入场费是 2,000 Zeny。";
	mes "如果想押单怪物赛跑，请找我的兄弟埃勒伯德帮忙。";
	next;
	mes "[埃卡·埃雷尼斯]";
	mes "如果对双怪物赛跑感兴趣，我可以帮你开始。";
	mes "你想押双怪物赛跑吗？";
	next;
	if (select("好的。:不用了，谢谢。") == 2) {
		mes "[埃卡·埃雷尼斯]";
		mes "好吧。希望你在怪物赛跑竞技场玩得开心~";
		close;
	}
	if (!checkweight("Jellopy",700)) {
		mes "[埃卡·埃雷尼斯]";
		mes "嗯……你现在携带的东西太多了。";
		mes "在下注前，最好把一些物品存入卡普拉仓库……";
		close;
	}
	if (Zeny < 2000) {
		mes "[埃卡·埃雷尼斯]";
		mes "抱歉，你没有足够的钱支付 2,000 Zeny 入场费。";
		close;
	}
	if (countitem(7514)) {
		mes "[埃卡·埃雷尼斯]";
		mes "嗯？你拿着过期的赛跑票做什么？";
		mes "我最好先替你处理掉它，免得和新赛跑票混在一起。";
		delitem 7514,1; //Monster_Ticket
		next;
		if ($@mon_time_2_1 == 1) {
			mes "[埃卡·埃雷尼斯]";
			mes "好了，应该准备就绪了。祝你享受比赛~";
			mes "现在我带你进入怪物赛跑竞技场。";
			Zeny -= 2000;
			monster_race_2_1 = monster_race_2_2 = 0;
			close2;
			warp "p_track02",75,41;
			end;
		}
		else if ($@mon_time_2_1 == 2) {
			mes "[埃卡·埃雷尼斯]";
			mes "我们还在为下一场双怪物赛跑做准备，";
			mes "请再稍等一会儿……";
			close;
		}
	} else {
		if ($@mon_time_2_1 == 1) {
			mes "[埃卡·埃雷尼斯]";
			mes "谢谢，希望你享受这场比赛。";
			mes "现在我带你去怪物赛跑竞技场。";
			Zeny -= 2000;
			monster_race_2_1 = monster_race_2_2 = 0;
			close2;
			warp "p_track02",75,41;
			end;
		} else if ($@mon_time_2_1 == 2) {
			mes "[埃卡·埃雷尼斯]";
			mes "我们还在为下一场双怪物赛跑做准备，";
			mes "请再稍等一会儿……";
			close;
		}
	}
	if ($@mon_time_2_2 == 1) {
		mes "[埃卡·埃雷尼斯]";
		mes "现在怪物赛跑正在进行。下注已经太晚，";
		mes "但如果想观看，费用是 500 Zeny。";
		mes "这是观众费。你想进入怪物赛跑竞技场吗？";
		next;
		if (select("进入:取消") == 2) {
			mes "[埃卡·埃雷尼斯]";
			mes "好吧。如果想下注怪物赛跑，";
			mes "请等待当前比赛结束。";
			mes "希望你在怪物赛跑竞技场玩得开心~";
			close;
		}
		if (Zeny > 499) {
			mes "[埃卡·埃雷尼斯]";
			mes "谢谢~";
			mes "希望你喜欢观看这场比赛！";
			Zeny -= 500;
			monster_race_2_1 = monster_race_2_2 = 0;
			close2;
			warp "p_track02",75,41;
			end;
		}
		mes "[埃卡·埃雷尼斯]";
		mes "抱歉，你没有足够的钱支付 500 Zeny 观众费。";
		close;
	}
	mes "[埃卡·埃雷尼斯]";
	mes "抱歉，怪物赛跑刚刚结束，现在是获胜者领取奖牌的 5 分钟时间。";
		mes "大门很快会打开，请稍候。";
// 切片行数保留
// 切片行数保留
// 切片行数保留
// 切片行数保留

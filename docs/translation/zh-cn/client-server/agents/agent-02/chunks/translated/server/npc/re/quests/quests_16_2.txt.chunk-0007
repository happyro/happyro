		sleep2 3000;
		npctalk "如果不先封锁区域，他们会立即关闭实验室并逃走。", "Philopontess#ep162_03", bc_self;
		sleep2 3000;
		npctalk "原来如此，吸毒者。你的意思是……有客人来了。", "Lazy#ep162_01", bc_self;
		sleep2 1000;
		npctalk "你说‘吸毒者’？！", "Philopontess#ep162_03", bc_self;
		sleep2 2000;
		npctalk "我们热切等待的客人来了，对吧？", "Lazy#ep162_01", bc_self;
		sleep2 2000;
		npctalk "这边。", "Nihil#ep162_02", bc_self;
		sleep2 2000;

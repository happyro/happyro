ein_fild04,284,332,3	script	Rookie#ep162_02	4_M_ROOKIE,{
	if (terra_gloria_main < 19) {
		mes "[Rookie]";
		mes "……我真的讨厌训练……";
		close;
	}
	if (terra_gloria_main == 19) {
		cutin "16loo_01.bmp",2;
		mes "[Rookie]";
		mes "^4d4dff朱利安^000000是这里的行动负责人。";
		mes "请去问他。";
		close3;
	}
	if (terra_gloria_main == 20) {// First instance completed
		cutin "16loo_01.bmp",2;
		mes "[Rookie]";
		mes "他们就像陷阱里的老鼠。我们只需要清理现场～我也要进去。";
		next;
		select("很好。拜托你了。 ");
		mes "[Rookie]";
		mes "这是当然。";
		mes "你还没找到正在寻找的东西。";
		mes "我让你过去。你只要找到那件东西就好。";
		close2;
		warp "que_swat",155,50;
		end;
	}
	cutin "16loo_01.bmp",2;
	mes "[Rookie]";
	mes "他们占领这里后，正在改造一些路线，把这里变成训练营。";
	mes "……哦……我已经开始讨厌这里了。";
	next;
	if (select( "进入军事基地。", "很好。拜托你了。" ) == 2) {
		mes "[Rookie]";
		mes "哦……啊……";
		close3;
	}
	mes "[Rookie]";
	mes "研究设施里还残留着一些东西。";
	mes "其实……更像是怪物。";
	mes "总之，照顾好自己。";
	close2;
	warp "que_swat",155,50;
	end;

OnInit:
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "isbegin_quest(12374) == 0 && isbegin_quest(7739) == 1" );
	end;
}


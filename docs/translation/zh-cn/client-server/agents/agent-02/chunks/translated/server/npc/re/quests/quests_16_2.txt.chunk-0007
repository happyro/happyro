ein_in01,269,285,5	script	Nihil#ep162_02	4_EP16_NIHIL,{
	if (terra_gloria_main == 18) {
		mes "[Nihil]";
		mes "很高兴再次见到你。";
		mes "你平安无事真是太好了。";
		cutin "ep16_nihi_miseria_heine02.bmp",2;
		next;
		mes "[Nihil]";
		mes "这件事因我而起，所以我亲自来解决危机。";
		mes "……继续依赖别人会让我感到羞耻。";
		cutin "ep16_nihi_miseria_heine04.bmp",2;
		next;
		mes "[Nihil]";
		mes "……虽然我无法在身体上帮助你，";
		mes "但我可以负责情报分析和外交事务。";
		cutin "ep16_nihi_miseria_heine01.bmp",2;
		next;
		select("你被解除禁足了吗？");
		cutin "ep16_skia_nerius01.bmp",0;
		mes "[Skia]";
		mes "嗯～很遗憾，没有。";
		mes "我向王室家族的长辈报告了这件事。他们训斥了我，我好不容易才获准来到这里。";
		next;
		mes "[Nihil]";
		mes "在这个过程中，我借用了你的名义。";
		mes "官方说法是你负责解决危机，而我承担责任。斯琪亚女士则负责监督我。";
		cutin "ep16_nihi_miseria_heine01.bmp",2;
		next;
		mes "[Nihil]";
		mes "既然他们都知道你，所有人都期待你不惜一切解决问题。";
		mes "很抱歉之前没有告知你就借用了你的名义。";
		next;
		cutin "ep16_skia_nerius01.bmp",0;
		mes "[Skia]";
		mes "没有这个，他们绝不会批准你来。";
		mes "他们会说你让事情变得更糟。";
		next;
		mes "[Nihil]";
		mes "谈谈行动吧……你叫菲洛蓬泰丝？";
		mes "既然我们现在合作，我可以说说我的看法吗？";
		cutin "ep16_nihi_miseria_heine01.bmp",2;
		next;
		cutin "ep16_tes01.bmp",0;
		mes "[Tess]";
		mes "当然。";
		mes "请叫我泰丝。";
		mes "军事行动由叛乱军负责。不过……";
		next;
		mes "[Tess]";
		mes "在战略方面，我们占据优势。";
		mes "而且我们只有一次机会。所以欢迎你提出好主意。";
		npctalk "除非你是个没用的笨蛋。", "Philopontess#ep162_03", bc_self;
		next;
		cutin "16loo_02.bmp",1;
		mes "[Rookie]";
		mes "哇，他的嘴可真大～";
		mes "要是我姐姐埃琳娜听到，可能会一枪打爆他的头！";
		next;
		cutin "16loo_01.bmp",1;
		mes "[Rookie]";
		mes "我们已经选好了战斗人员。因为这是机密行动，我们选择了完全信任的人。";
		mes "建筑和地理特征的调查呢？";
		next;
		cutin "ep16_tes01.bmp",0;
		mes "[Tess]";
		mes "当然，我们已经准备好了。";
		mes "我们调查这里已经很久了。";
		next;
		mes "[Nihil]";
		mes "我读过文件。";
		mes "奇怪的是这里……我不知道为什么。但是有一处";
		cutin "ep16_nihi_miseria_heine01.bmp",2;
		next;
		mes "[Nihil]";
		mes "设施所在区域没有撤退路线。";
		npctalk "没有撤退路线。", "Philopontess#ep162_03", bc_self;
		next;
		cutin "16loo_01.bmp",1;
		mes "[Rookie]";
		mes "嗯。那我们只要进去封锁唯一的入口就行了？";
		next;
		cutin "ep16_nihi_miseria_heine01.bmp",2;
		mes "[Nihil]";
		mes "他们可能安装了传送用的门。我们必须先让它失效。";
		npctalk "……你的意思是他们使用魔法？", "Philopontess#ep162_03", bc_self;
		next;
		mes "[Nihil]";
		mes "我们必须迅速行动，即使敌人察觉，也来不及采取对策。";
		npctalk "很有可能。", "Philopontess#ep162_03", bc_self;
		next;
		cutin "16loo_01.bmp",1;
		mes "[Rookie]";
		mes "交给我们吧！";
		mes "叛乱军可不是一直在睡大觉。";
		mes "那么这里剩下的人都是多余人手？";
		next;
		cutin "ep16_tes02.bmp",0;
		mes "[Tess]";
		mes "你说‘多余’！？";
		mes "你已经忘了是谁提供这些情报的吗？";
		next;
		cutin "",255;
		mes "……会议开得太久了。";
		next;
		cutin "ep16_skia_nerius01.bmp",0;
		mes "[Skia]";
		mes "嗯……很无聊，对吧？";
		mes "事情已经大致决定了。";
		mes "我不能直接帮助你。";
		mes "我是来监督尼希尔的。";
		next;
		mes "[Skia]";
		mes "在这个设施里，你要集中注意中央房间。";
		npctalk "没错。", "Philopontess#ep162_03", bc_self;
		next;
		cutin "ep16_tes01.bmp",1;
		mes "[Tess]";
		mes "你要找的东西可能就在^4d4dff中央房间^000000。";
		next;
		cutin "ep16_nihi_miseria_heine01.bmp",2;
		mes "[Nihil]";
		mes "我参与进来是为了确保行动安全成功。不过实际上，我们已经把能提供的一切都给你了。";
		next;
		mes "[Nihil]";
		mes "" + strcharinfo(0) + "，叛乱军占领实验室后，你必须比其他人更快冲到中央房间。";
		next;
		cutin "ep16_nihi_miseria_heine02.bmp",2;
		mes "[Nihil]";
		mes "在那里……你会找到它。";
		mes "我强烈感觉它就在这里。";
		mes "拜托你了。";
		next;
		cutin "16loo_01.bmp",1;
		mes "[Rookie]";
		mes "现在出发吧。";
		mes "天快黑了。";
		mes "现在是周末，安保可能没那么严。";
		next;
		cutin "ep16_tes01.bmp",0;
		mes "[Tess]";
		mes "地点是^4d4dff艾因布罗克北部平原一点钟方向的行动地点^000000。";
		mes "到了平原后，请与叛乱军合作。";
		next;
		cutin "16loo_01.bmp",1;
		mes "[Rookie]";
		mes "行动地点的准确^4d4dff坐标是280，332^000000。行动负责人可能是……^4d4dff朱利安^000000。";
		next;
		mes "[Rookie]";
		mes "去找朱利安！";
		mes "当然我也会去。";
		next;
		cutin "ep16_nihi_miseria_heine02.bmp",2;
		mes "[Nihil]";
		mes "……别忘了。";
		mes "你一定要到达中央房间，找到^4d4dff特拉·格洛丽亚^000000。";
		mes "祝你战场得胜。";
		next;
		cutin "ep16_skia_nerius01.bmp",0;
		mes "[Skia]";
		mes "我会冒险参加行动。";
		mes "照顾好自己！";
		erasequest 7738;// Next operation plan
		setquest 7739;// Find Star of Blessing!
		terra_gloria_main = 19;
		close3;
	}
	if (terra_gloria_main == 19) {
		mes "[Nihil]";
		mes "……别忘了。";
		mes "你一定要到达中央房间，找到^4d4dff特拉·格洛丽亚^000000。";
		mes "祝你战场得胜。";
		cutin "ep16_nihi_miseria_heine02.bmp",2;
		next;
		cutin "ep16_tes01.bmp",0;
		mes "[Tess]";
		mes "地点是^4d4dff艾因布罗克北部平原一点钟方向的行动地点^000000。";
		mes "到了平原后，请与叛乱军合作。";
		close3;
	}
	if (terra_gloria_main == 22)
		callfunc( "F_Terra_Gloria_Inn" );
	end;
OnInit:
	cloakonnpc();
	end;
}


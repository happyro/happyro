que_swat,150,58,3	script	Rookie#ep162_03	4_M_ROOKIE,{
	if (checkweight(501,1) == 0) {
		mes "- 你持有的物品太多，无法继续任务。-";
		close;
	}
	if (terra_gloria_main < 22) {
		cutin "16loo_01.bmp",2;
		mes "[Rookie]";
		mes "^4d4dff中央区域^000000似乎就在这座实验室的^4d4dff地下深处^000000。";
		mes "既然我们叛乱军已经完全占领这里，你可以放心前往。";
		next;
		mes "[Rookie]";
		mes "传送？";
		mes "他们不能使用。";
		mes "我们已经封锁了。";
		mes "其实，这是我们以前从未想过的事……";
		npctalk "你是例外！想用就用吧！", "", bc_self;
		next;
		mes "[Rookie]";
		mes "那个金色头发闪闪发亮的人让我也封锁与移动有关的魔法。";
		mes "嗯，我知道这种魔法在卢恩·米德加尔兹更常见。对吧？";
		next;
		mes "[Rookie]";
		mes "总之，希望你能尽快找到想找的东西。";
		close3;
	}
	if (terra_gloria_main == 22) {
		cutin "16loo_01.bmp",2;
		mes "[Rookie]";
	mes "哇，欢迎回来。";
		cloakoffnpcself( "Skia#ep162_07" );
		npctalk "英雄！", "Skia#ep162_07", bc_self;
		next;
		mes "[Skia]";
	mes "我听到中央房间里传来巨响。我试着进去，但那里已经被封锁了。";
		next;
		cutin "16loo_01.bmp",2;
		mes "[Rookie]";
	mes "没错。我被一股未知力量弹了出来，没能守住入口到最后。";
	mes "对不起。";
		next;
		mes "[Skia]";
	mes "……究竟是什么？";
		next;
		mes "[Skia]";
	mes "我的天……赛依连·温莎？";
	mes "你找到它了？";
		next;
		mes "[Skia]";
	mes "那么我们必须赶快回去。";
	mes "我们的任务完成了。";
	mes "先回旅馆吧。";
		next;
		cutin "16loo_01.bmp",2;
		mes "[Rookie]";
	mes "嗯。剩下的就是我们的任务。";
	mes "里面还有很多魔物实验体，不过";
	mes "那就是我们必须面对的事。";
		next;
		mes "[Rookie]";
	mes "该死，滚开！";
		close2;
		cloakonnpcself( "Skia#ep162_07" );
		warp "ein_fild04",279,339;
		end;
	}
	if (terra_gloria_main == 23) {
		cutin "16loo_01.bmp",2;
		mes "[Rookie]";
	mes "哦，我讨厌这里。";
	mes "我想尽快回我们的藏身处。";
	mes "我们离开这里吧？";
		next;
		if (select( "Leave.", "Stay." ) == 2) {
			mes "[Rookie]";
			mes "嗯，你是那种喜欢自找麻烦的人吗？";
			mes "如果你愿意帮我们清理残余，我们会很感激。";
			close3;
		}
		mes "[Rookie]";
		mes "那就跟我来。";
		close2;
		warp "ein_fild04",279,339;
		end;
	}
	if (terra_gloria_main == 24) {
		npctalk "……我现在要进去吗？", "", bc_self;
		end;
	}
	mes "[Rookie]";
	mes "我们现在离开吗？";
	cutin "16loo_01.bmp",2;
	next;
	switch( select( "About the monster in the central room", "Leave.", "Stay.", "About YSF01" ) ) {
	case 1:
		break;
	case 2:
		mes "[Rookie]";
		mes "那就跟我来。";
		close2;
		warp "ein_fild04",279,339;
		end;
	case 3:
		mes "[Rookie]";

ein_d02_i,170,193,5	script	Steven#IBT	4W_M_02,3,3,{
	if (checkweight(1201,3) == 0) {
		mes "- 请稍等！！";
		mes "- 你携带的物品太多。-";
		mes "- 无法领取这个。-";
		mes "- 请减轻负重，-";
		mes "- 然后再试一次。-";
		close;
	}
	if (ill_teddy < 3)
		end;
	if (ill_teddy == 3) {
		mes "[Steven]";
		mes "你不能放我走吗？！";
		mes "放开我！";
		mes "太糟糕了！！！！";
		npctalk "史蒂文：你不能放我走吗？！", "", bc_self;
		cloakoffnpcself( "White Teddy Bear#IBT" );
		cloakoffnpcself( "Teddy Bear#IBT" );
		next;
		mes "[Teddy Bear]";
		mes "糟糕！";
		mes "被抓住了，我被抓住了！";
		mes "快跑！！！！";
		npctalk "白色泰迪熊：被抓住了，我被抓住了！", "White Teddy Bear#IBT", bc_self;
		npctalk "泰迪熊：快跑！！！！", "Teddy Bear#IBT", bc_self;
		ill_teddy = 4;
		erasequest 11558;
		setquest 11559;
		close2;
		cloakonnpcself( "White Teddy Bear#IBT" );
		cloakonnpcself( "Teddy Bear#IBT" );
		end;
	}
	if (ill_teddy == 4) {
		mes "[Steven]";
		mes "什么……";
		mes "那是……";
		next;
		mes "[Steven]";
		mes "喂！";
		mes "那边的人！";
		mes "你也看到了吗？";
		mes "那只玩偶熊刚才……";
		next;
		select( "Tell him about the coughing young man." );
		mes "[Steven]";
		mes "嗯？艾因布洛赫那个咳嗽的年轻人让你来找我？";
		mes "是阿西德……";
		next;
		mes "[Steven]";
		mes "我告诉他会马上回去，但那个传闻到底是怎么回事？有很多人在排队，还有怪物。";
		next;
		mes "[Steven]";
		mes "阿西德怎么样了？";
		mes "他的咳嗽很严重，没法好好睡觉。";
		next;
		mes "[Steven]";
		mes "我得回去送他去医院，但是……";
		mes "如果我没看错，那是……";
		next;
		mes "[Steven]";
		mes "呃……事情变复杂了……";
		next;
		mes "[Steven]";
		mes "喂。";
		mes "帮我个忙。";
		mes "他今天必须去医院，但钱不够。";
		next;
		mes "[Steven]";
		mes "我想我得在这里做点工作。";
		mes "你回去告诉他我没事。";
		mes "把这些钱也给他。";
		next;
		mes "[Steven]";
		mes "拜托了。";
		mes "等我回去……我现在没什么东西，但会给你回报。";
		npctalk "史蒂文：拜托。", "", bc_self;
		ill_teddy = 5;
		erasequest 11559;
		setquest 11560;
		close;
	}
	if (ill_teddy == 5) {
		mes "[Steven]";
		mes "喂。";
		mes "帮我个忙。";
		mes "他今天必须去医院，但钱不够。";
		next;
		mes "[Steven]";
		mes "我想我得在这里做点工作。";
		mes "你回去告诉他我没事。";
		mes "把这些钱也给他。";
		next;
		mes "[Steven]";
		mes "拜托了。";
		mes "等我回去……我现在没什么东西，但会给你回报。";
		npctalk "史蒂文：拜托。", "", bc_self;
		close;
	}
	if (ill_teddy == 6) {
		mes "[Steven]";
		mes "哦，你在这里？";
		mes "他去医院了吗？";
		next;
		mes "[Acid]";
		mes "史蒂文！";
		mes "为什么让大家这么担心……";
		cloakoffnpcself( "Acid#IBT_inN01" );
		next;
		mes "[Steven]";
		mes "不……你为什么在这里？";
		mes "去医院！";
		next;
		mes "[Acid]";
		mes "我这里是医院还是商店？！";
		next;
		mes "[Steven]";
		mes "呃……";
		mes "好……好！";
		mes "现在先安静！";
		mes "你听到北边传来的奇怪声音了吗？";
		npctalk "史蒂文：呃……真烦……", "", bc_self;
		ill_teddy = 7;
		erasequest 11561;
		setquest 11562;
		close2;
		cloakonnpcself( "Acid#IBT_inN01" );
		end;
	}
	if (ill_teddy == 7) {
		mes "[Steven]";
		mes "呃……";
		mes "好！";
		mes "现在先安静！";
		mes "你听到北边传来的奇怪声音了吗？";
		npctalk "史蒂文：呃……真烦……", "", bc_self;
		close;
	}
	if (ill_teddy == 8) {
		if (checkquest(11563,HUNTING) != 2 || checkquest(11564,HUNTING) != 2) {
			mes "[Steven]";
		mes "太多了。";
		mes "这太危险了。";
		mes "先清理一下，再谈吧。";
			close;
		}
		mes "[Steven]";
		mes "哇……";
		mes "是你把它们放出来的吗？";
		next;
		mes "[Acid]";
		mes "那些不就是玩偶熊吗？";
		mes "入侵……它们自称纳萨里安，对吧？";
		cloakoffnpcself( "Acid#IBT_inN01" );
		next;
		mes "[Steven]";
		mes "到底发生了什么……";
		mes "我快疯了……";
		next;
		select( "About Teddy Bear" );
		mes "[Acid]";
		mes "史蒂文带来的，因为他说在找一些家里能吃的咸味食物。";
		next;
		mes "[Acid]";
		mes "和工作相比报酬太高了，而且送货地点还是矿井，所以有点可疑……";
		next;
		mes "[Acid]";
		mes "听说那个笨蛋很兴奋。";
		next;
		mes "[Steven]";
		mes "真是个笨蛋！";
		mes "多亏了你，我还要付医院账单，还要听你的咳嗽……";
		mes "哦……说起来，你已经不咳嗽了，对吧？";
		npctalk "史蒂文：真是个笨蛋！", "", bc_self;
		next;
		mes "[Acid]";
		mes "呃……是这样吗？";
		mes "说起来，我感觉呼吸轻松多了！";
		next;
		mes "[Steven]";
		mes "不管去医院多少次都没有好转……";
		mes "也许只是空气太差！";
		npctalk "史蒂文：空气比矿洞里还糟……", "", bc_self;
		next;
		mes "[Acid]";
		mes "不，现在这不重要……";
		mes "我们制作的玩偶活过来了，还会动！";
		mes "它们甚至还试图绑架你！";
		next;
		mes "[Steven]";
		mes "绑架……说起来，我回来的路上帮过一个被可怕玩偶熊追赶的男人。";
		next;
		mes "[Steven]";
		mes "……被带到这里的不只有我，对吧？";
		mes "看来我得留在这里观察情况。";
		mes "阿西德！你暂时可以回村子了。";
		next;
		mes "[Steven]";
		mes "也谢谢你帮助我。";
		mes "我没什么可给你的，但可以把之前找到的稀有矿石给你。";
		mes "也许某处用得上！";
		ill_teddy = 9;
		erasequest 11563;
		erasequest 11564;
		getitem 25271,5; // IllusionStone
		getexp 3500000,2500000;
		close2;
		cloakonnpcself( "Acid#IBT_inN01" );
		end;
	}

	// daily
	switch( checkquest(11566,PLAYTIME) ) {
	case -1:
		break;
	case 0:
	case 1:
		mes "[Steven]";
		mes "休息一下吧。";
		mes "过度勉强只会损害健康。";
		close;
	case 2:
		erasequest 11566;
		break;
	}
	switch( checkquest(11565,HUNTING) ) {
	case -1:
		mes "[Steven]";
		mes "呃……";
		mes "这些家伙怎么总是冒出来？";
		next;
		mes "[Steven]";
		mes "即使你熟悉战斗，不擅长战斗的操偶师也很难从这里脱身。";
		next;
		mes "[Steven]";
		mes "现在我也在处理，但一个人不够。";
		mes "如果你现在不忙，就帮我击败" + getmonsterinfo("ILL_PITMAN", MOB_NAME) + "、" + getmonsterinfo("ILL_MINERAL", MOB_NAME) + "和" + getmonsterinfo("ILL_OBSIDIAN", MOB_NAME) + "。";
		mes "如果能抓到10只，我应该就能轻松一点。";
		next;
		if (select( "Accept", "Quit" ) == 2) {
			mes "[Steven]";
			mes "好吧……";
			close;
		}
		mes "[Steven]";
		mes "那么请帮我击败";
		mes "10 " + getmonsterinfo("ILL_PITMAN", MOB_NAME) + ", " + getmonsterinfo("ILL_MINERAL", MOB_NAME) + ", and " + getmonsterinfo("ILL_OBSIDIAN", MOB_NAME) + "!";
		setquest 11565;
		close;
	case 0:
	case 1:
		mes "[Steven]";
		mes "你还好吗？";
		mes getmonsterinfo("ILL_PITMAN", MOB_NAME) + "、" + getmonsterinfo("ILL_MINERAL", MOB_NAME) + "和" + getmonsterinfo("ILL_OBSIDIAN", MOB_NAME) + "处理得怎么样？";
		close;
	case 2:
		mes "[Steven]";
		mes "哇……";
		mes "做得好！";
		mes "现在感觉安全一点了吗？";
		erasequest 11565;
		setquest 11566;
		getitem 25271,1; // IllusionStone
		getexp 1000000,900000;
		close;
	}
	end;

OnTouch:
	if (ill_teddy == 3) {
		mes "[Steven]";
		mes "你不能放我走吗？！";
		mes "放开我！";
		mes "太糟糕了！！！！";
		npctalk "史蒂文：你不能放我走吗？！", "", bc_self;
		cloakoffnpcself( "White Teddy Bear#IBT" );
		cloakoffnpcself( "Teddy Bear#IBT" );
		next;
		mes "[Teddy Bear]";
		mes "糟糕！";
		mes "被抓住了，我被抓住了！";
		mes "快跑！！！！";
		npctalk "白色泰迪熊：被抓住了，我被抓住了！", "White Teddy Bear#IBT", bc_self;
		npctalk "泰迪熊：快跑！！！！", "Teddy Bear#IBT", bc_self;
		ill_teddy = 4;
		erasequest 11558;
		setquest 11559;
		close2;
		cloakonnpcself( "White Teddy Bear#IBT" );
		cloakonnpcself( "Teddy Bear#IBT" );
		end;
	}
	end;

OnInit:
	// main quest
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "isbegin_quest(11558) == 1" );
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "isbegin_quest(11559) == 1" );
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "isbegin_quest(11561) == 1" );
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "checkquest(11563,HUNTING) == 2 && checkquest(11564,HUNTING) == 2" );

	// daily
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "ill_teddy == 9 && checkquest(11565,HUNTING) == -1 && checkquest(11566,PLAYTIME) == -1" );
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "checkquest(11565,HUNTING) == 2" );
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "checkquest(11566,PLAYTIME) == 2" );
	end;
}


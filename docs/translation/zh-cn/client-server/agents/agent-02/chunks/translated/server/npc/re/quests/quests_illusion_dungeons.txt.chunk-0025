ein_dun01,189,85,7	script	Teddy Bear#IBT1	4_NASARIAN,{
	if (ill_teddy < 2) {
		mes "[Teddy Bear in line]";
		mes "哎呀，很快就轮到我进去了。";
		close;
	}
	if (ill_teddy == 2) {
		mes "[Teddy Bear in line]";
		mes "怎……怎么了？";
		mes "前面那个人刚进去时，我听到了一声尖叫。";
		next;
		select( "关于那个人。" );
		mes "[Teddy Bear in line]";
		mes "什么？";
		mes "我根本没时间看！";
		next;
		mes "[Teddy Bear in line]";
		mes "哎呀……嘿嘿……";
		mes "我排了好几天队，但突然没兴趣了……";
		next;
		mes "[Teddy Bear in line]";
		mes "如果你真的好奇，我把位置让给你。你进去看看吧？";
		next;
		mes "[Teddy Bear in line]";
		mes "我……才不是因为害怕！";
		mes "只是……我觉得里面现在对我来说很无聊。";
		mes "因为我失去兴趣了？！";
		ill_teddy = 3;
		erasequest 11557;
		setquest 11558;
		close;
	}
	if (ill_teddy == 3) {
		mes "[Teddy Bear in line]";
		mes "哎呀……嘿嘿……";
		mes "我排了好几天队，但突然没兴趣了……";
		next;
		mes "[Teddy Bear in line]";
		mes "如果你真的好奇，我把位置让给你。你进去看看吧？";
		next;
		mes "[Teddy Bear in line]";
		mes "我……才不是因为害怕！";
		mes "只是……我觉得里面现在对我来说很无聊。";
		mes "因为我失去兴趣了？！";
		close;
	}
	mes "[Teddy Bear in line]";
	mes "什么？";
	mes "前面那个人已经逃走了！";
	mes "别搞混了！";
	close;

OnInit:
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "isbegin_quest(11557) == 1" );
	end;
}


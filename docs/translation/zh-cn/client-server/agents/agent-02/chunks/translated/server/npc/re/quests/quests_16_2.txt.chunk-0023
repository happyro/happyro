// Enchants
rebel_in,90,40,5	script	Hogar#pa0829	4_M_MASKMAN,{
	disable_items;
	if (checkweight(501,1) == 0) {
		mes "你带的东西似乎太多了。拿掉一些后再试吧。";
		close;
	}
	if ((MaxWeight - Weight) < 1000) {
		mes "你的物品太重了。减轻重量后再试吧。";
		close;
	}
	if (isbegin_quest(12376) != 2) {
		mes "[Hogar]";
		mes "客人？我今天本来不打算做生意。我太累了。";
		next;
		select("我好像在哪里听过类似的话。 ");
		mes "[Hogar]";
		mes "只是你的想象。世上没有像我这样的人。";
		next;
		mes "^0000ff但他看起来还是很眼熟。^000000";
		next;
		if (select( "浪费时间。", "告诉我你卖什么。" ) == 1) {
			mes "[Hogar]";
			mes "哼，走开。";
			close;
		}
		mes "[Hogar]";
		mes "施瓦茨瓦德荣誉徽章是国家发行、禁止个人交易的物品。我从人们那里收取这些物品，为他们升级装备。";
		next;
		mes "[Hogar]";
		mes "背叛同领域的竞争者后，我得到了升级的秘密方法。从那以后，我就这样在暗处工作……哦，算了。这不是愉快的故事。";
		next;
		select("（他确实很眼熟……）");
		mes "[Hogar]";
		mes "总之，如果你有一大堆徽章，不要直接扔掉，来找我。我们可以做笔好交易。";
		next;
		select("什么交易？");
		mes "[Hogar]";
		mes "我可以特殊升级议程长袍、咨询长袍，以及A型和B型佣兵戒指。作为交换，我收取施瓦茨瓦德荣誉徽章。";
		next;
		mes "[Hogar]";
		mes "好了，我不必继续这样唠叨。想升级装备时把徽章带来，我们再详细谈交易。";
		setquest 12376;// First transaction
		completequest 12376;// First transaction
		close;
	}
	mes "[Hogar]";
	mes "你是来交易的吗？告诉我你需要什么。";
	next;
	switch( select( "告诉我交易条件", "升级我的长袍", "升级我的戒指", "初始化我的长袍升级容量等级", "初始化我的戒指升级容量等级" ) ) {
	case 1:
		mes "[Hogar]";
		mes "听好了。我不会说第二遍。";
		next;
		mes "[Hogar]";
		mes "升级议程长袍或咨询长袍的插槽需要20个施瓦茨瓦德荣誉徽章。最多可升级两个插槽。初始化需要10个施瓦茨瓦德荣誉徽章。明白了吗？";
		next;
		mes "[Hogar]";
		mes "接下来是A型和B型佣兵戒指。升级一个插槽需要5个徽章，最多可升级两个插槽。初始化需要10个徽章。";
		next;
		mes "[Hogar]";
		mes "初始化不能随时进行。只有装备获得两个效果、无法继续升级后，我才会进行初始化。还有……接下来……";
		next;
		mes "[Hogar]";
		mes "有个小问题。A型和B型佣兵戒指在初始化时可能会损坏，概率约为20%。因为它们是小型物品，消除升级效果时会产生严重副作用。";
		next;
		mes "[Hogar]";
		mes "期待和你建立良好的交易关系，朋友。";
		close;
	case 2:
		mes "[Hogar]";
		mes "咨询长袍和议程长袍每个插槽需要20个施瓦茨瓦德荣誉徽章。确定要升级吗？";
		next;
		if (select( "不。", "开始吧。" ) == 1) {
			mes "[Hogar]";
			mes "我很忙，以后别再无谓地和我说话。";
			close;
		}
		.@equip_id = getequipid(EQI_ARMOR);
		setarray .@card[0],
			getequipcardid(EQI_ARMOR,0),
			getequipcardid(EQI_ARMOR,1),
			getequipcardid(EQI_ARMOR,2),
			getequipcardid(EQI_ARMOR,3);
		.@refine = getequiprefinerycnt(EQI_ARMOR);

		switch( .@equip_id ) {
		case -1:
			mes "[Hogar]";
			mes "你把装备脱下来了。";
			close;
		case 15163:
		case 15164:
			break;
		default:
			mes "[Hogar]";
			mes "成熟点。想升级装备，先把它正确装备上。";
			close;
		}
		if (.@card[2] > 0 && .@card[3] > 0) {
			mes "[Hogar]";
			mes "这件装备无法继续升级。还有其他装备吗？";
			close;
		}
		if (countitem(25155) < 20) {
			mes "[Hogar]";
			mes "听好了，朋友。没有" + getitemname(25155) + "就不能和我交易。";
			close;
		}

		// unknown rates
		setarray .@enhance[0],
			4994,	// Rune of Strength Lv 1
			4997,	// Rune of Agility Lv 1
			29009,	// Rune of Vitality Lv 1
			29000,	// Rune of Intellect Lv 1
			29003,	// Rune of Dexterity Lv 1
			29006,	// Rune of Luck Lv 1
			4995,	// Rune of Strength Lv 2
			4998,	// Rune of Agility Lv 2
			29010,	// Rune of Vitality Lv 2
			29001,	// Rune of Intellect Lv 2
			29004,	// Rune of Dexterity Lv 2
			29007,	// Rune of Luck Lv 2
			4996,	// Rune of Strength Lv 3
			4999,	// Rune of Agility Lv 3
			29011,	// Rune of Vitality Lv 3
			29002,	// Rune of Intellect Lv 3
			29005,	// Rune of Dexterity Lv 3
			29008;	// Rune of Luck Lv 3
		.@size = getarraysize(.@enhance);

		if (.@card[3] == 0)
			.@card[3] = .@enhance[ rand(.@size) ];
		else if (.@card[2] == 0)
			.@card[2] = .@enhance[ rand(.@size) ];

		delitem 25155,20;	// Swz_Honor_Token
		delequip EQI_ARMOR;
		getitem2 .@equip_id,1,1,.@refine,0,.@card[0],.@card[1],.@card[2],.@card[3];
		specialeffect2 EF_REPAIRWEAPON;
		mes "[Hogar]";
		mes "嗯，做得很好。检查你的物品吧。";
		close;
	case 3:
		mes "[Hogar]";
	mes "升级左侧装备的A型和B型佣兵戒指插槽需要5个施瓦茨瓦德荣誉徽章。确定要升级吗？";
		next;
		if (select( "No", "Let's do it" ) == 1) {
			mes "[Hogar]";
			mes "我很忙，以后别再无谓地和我说话。";
			close;
		}
		.@equip_id = getequipid(EQI_ACC_L);
		setarray .@card[0],
			getequipcardid(EQI_ACC_L,0),
			getequipcardid(EQI_ACC_L,1),
			getequipcardid(EQI_ACC_L,2),
			getequipcardid(EQI_ACC_L,3);

		switch( .@equip_id ) {
		case -1:
			mes "[Hogar]";
			mes "忘了告诉你，我只升级装备在左侧的饰品。先把它装备在左侧，再让我升级。";
			close;
		case 28425:
		case 28426:
			break;
		default:
			mes "[Hogar]";
			mes "成熟点。想升级佣兵戒指，先把它正确装备上。";
			close;
		}
		if (.@card[2] > 0 && .@card[3] > 0) {
			mes "[Hogar]";
			mes "这件装备无法继续升级。还有其他装备吗？";
			close;
		}
		if (countitem(25155) < 5) {
			mes "[Hogar]";
			mes "听好了，朋友。没有" + getitemname(25155) + "就不能和我交易。";
			close;
		}

		// unknown rates
		setarray .@enhance[0],
			4710,	// INT+1
			4730,	// AGI+1
			4740,	// VIT+1
			4720,	// DEX+1
			4750,	// LUK+1
			4700,	// STR+1
			4711,	// INT+2
			4721,	// DEX+2
			4701,	// STR+2
			4731,	// AGI+2
			4751,	// LUK+2
			4741;	// VIT+2
		.@size = getarraysize(.@enhance);

		if (.@card[3] == 0)
			.@card[3] = .@enhance[ rand(.@size) ];
		else if (.@card[2] == 0)
			.@card[2] = .@enhance[ rand(.@size) ];

		delitem 25155,5;	// Swz_Honor_Token
		delequip EQI_ACC_L;
		getitem2 .@equip_id,1,1,0,0,.@card[0],.@card[1],.@card[2],.@card[3];
		specialeffect2 EF_REPAIRWEAPON;
		mes "[Hogar]";
		mes "嗯，做得很好。检查你的物品吧。";
		close;
	case 4:
		mes "[Hogar]";
		mes "初始化咨询长袍或议程长袍需要10个施瓦茨瓦德荣誉徽章。装备本身不会损坏，已经插入的卡片和精炼等级也会保留。";
		next;
		if (select( "No", "Let's do it" ) == 1) {
			mes "[Hogar]";
			mes "我很忙，以后别再无谓地和我说话。";
			close;
		}
		.@equip_id = getequipid(EQI_ARMOR);
		setarray .@card[0],
			getequipcardid(EQI_ARMOR,0),
			getequipcardid(EQI_ARMOR,1),
			getequipcardid(EQI_ARMOR,2),
			getequipcardid(EQI_ARMOR,3);
		.@refine = getequiprefinerycnt(EQI_ARMOR);

		switch( .@equip_id ) {
		case -1:
			mes "[Hogar]";
			mes "你把装备脱下来了。";
			close;
		case 15163:
		case 15164:
			break;
		default:
			mes "[Hogar]";
			mes "糟糕，这件物品还没有完全升级，现在无法初始化。";
			close;
		}
		if (.@card[2] == 0 || .@card[3] == 0) {
			mes "[Hogar]";
			mes "糟糕，这件物品还没有完全升级，现在无法初始化。";
			close;
		}
		if (countitem(25155) < 10) {
			mes "[Hogar]";
			mes "听好了，朋友。没有" + getitemname(25155) + "就不能和我交易。";
			close;
		}
		delitem 25155,10;	// Swz_Honor_Token
		delequip EQI_ARMOR;
		getitem2 .@equip_id,1,1,.@refine,0,.@card[0],0,0,0;
		specialeffect2 EF_REPAIRWEAPON;
		mes "[Hogar]";
		mes "嗯，做得很好。检查你的物品吧。";
		close;
	case 5:
		mes "[Hogar]";
		mes "初始化左侧装备的A型和B型佣兵戒指需要10个施瓦茨瓦德荣誉徽章。";
		next;
		mes "[Hogar]";
		mes "如我之前所说，戒指初始化相当困难。^ff0000成功率为80%。^000000失败的话物品就会消失。确定要做吗？";
		next;
		if (select( "No", "Let's do it" ) == 1) {
			mes "[Hogar]";
			mes "我很忙，以后别再无谓地和我说话。";
			close;
		}
		mes "[Hogar]";
		mes "提前告诉你。每次初始化戒指都有20%的损坏概率。确定要继续吗？";
		next;
		if (select( "Stop", "Continue" ) == 1) {
			mes "[Hogar]";
			mes "是的。好主意。";
			close;
		}
		.@equip_id = getequipid(EQI_ACC_L);
		setarray .@card[0],
			getequipcardid(EQI_ACC_L,0),
			getequipcardid(EQI_ACC_L,1),
			getequipcardid(EQI_ACC_L,2),
			getequipcardid(EQI_ACC_L,3);

		switch( .@equip_id ) {
		case -1:
			mes "[Hogar]";
			mes "忘了告诉你，我只初始化装备在左侧的饰品。先把它装备在左侧，再让我初始化。";
			close;
		case 28425:
		case 28426:
			break;
		default:
			mes "[Hogar]";
			mes "糟糕，这件物品还没有完全升级，现在无法初始化。";
			close;
		}
		if (.@card[2] == 0 || .@card[3] == 0) {
			mes "[Hogar]";
			mes "糟糕，这件物品还没有完全升级，现在无法初始化。";
			close;
		}
		if (countitem(25155) < 10) {
			mes "[Hogar]";
			mes "听好了，朋友。没有" + getitemname(25155) + "就不能和我交易。";
			close;
		}
		delitem 25155,10;	// Swz_Honor_Token
		delequip EQI_ACC_L;
		if (rand(100) < 20) {
			specialeffect2 EF_LORD;
			mes "[Hogar]";
		mes "哦，你今天真倒霉。你的装备严重损坏了。";
			close;
		}
		getitem2 .@equip_id,1,1,0,0,.@card[0],0,0,0;
		specialeffect2 EF_REPAIRWEAPON;
		mes "[Hogar]";
		mes "嗯，做得很好。检查你的物品吧。";
		close;
	}
}


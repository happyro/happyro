c_tower1,232,222,5	script	Belljamin Button#ct	968,{
	mes "[贝尔贾明·巴顿]";
	mes "这里的怪物能够控制时间。";
	if( BaseLevel < 150 ){
		mes "达到^0000FF150 级^000000后再回来。";
		close;
	}
	mes "时间、记忆、环境……一切都可能在这里扭曲。";
	next;
	mes "[贝尔贾明·巴顿]";
	mes "求你别再问了，这可能会让你的生命陷入危险。";
	next;
	.@menu = select("别问了:前往扭曲钟塔二楼:前往扭曲钟塔三楼");
	switch(.@menu){
		case 1:
			break;
		case 2:
		case 3:
			if( .@menu == 2 ){
				.@map$ = "c_tower2_";
				.@x = 268;
				.@y = 26;
			}else{
				.@map$ = "c_tower3_";
				.@x = 65;
				.@y = 147;
			}
			mes "[贝尔贾明·巴顿]";
			mes "请谨慎选择。";
			next;
			mes "[贝尔贾明·巴顿]";
			mes "我需要^0000FF10,000 Zeny^000000才能让你进去。那是个非常危险的地方。";
			next;
			switch( select( "退出:支付 10,000 Zeny:你为什么需要钱？" ) ){
				case 1:
					break;
				case 2:
					if( Zeny < 10000 ){
						mes "[贝尔贾明·巴顿]";
						mes "真的吗？你没钱还让我带你去那里？";
						close;
					}
					Zeny -= 10000;
					mes "[贝尔贾明·巴顿]";
					mes "我不知道你要如何在里面记录时间，但请务必小心。";
					close2;
					warp .@map$, .@x, .@y;
					end;
				case 3:
					mes "[贝尔贾明·巴顿]";
					mes "我整天都在这里守护冒险者的安全，也会不断提醒他们危险。因此我需要一些报酬。";
					emotion ET_SWEAT;
					close;
			}
			break;
	}
	mes "[贝尔贾明·巴顿]";
	mes "呼……你做了正确的选择。这里非常残酷，你最好回到安全区域。";
	close;
}

c_tower2_,274,26,3	script	Belljamin Button#nct1	962,{
	mes "[贝尔贾明·巴顿]";
	mes "也许你以前见过我？";
	next;
	mes "[贝尔贾明·巴顿]";
	mes "你在另一个地方见过我，那时我的模样不同。";
	next;
	if( select( "你是谁？:带我离开这里！" ) == 1 ){
		mes "[贝尔贾明·巴顿]";
		mes "你能告诉我你看到了什么、做了什么吗？";
		next;
		mes "[贝尔贾明·巴顿]";
		mes "我也是。你也许是失踪者之一，浑浑噩噩，没有目的，也没有想法。";
		next;
		mes "[贝尔贾明·巴顿]";
		mes "该回去了。请再珍惜一些你的时间。";
		next;
		if( select( "再待一会儿:请带我回去" ) == 1 ){
			mes "[贝尔贾明·巴顿]";
			mes "你一定很喜欢这里。好吧，随你便。";
			close;
		}
	}else{
		mes "[贝尔贾明·巴顿]";
		mes "该继续前进了。你有喜欢的饮料吗？";
		next;
	}
	mes "[贝尔贾明·巴顿]";
	mes "想象杯中的饮料。用勺子慢慢搅拌，看着饮料变换颜色。";
	close2;
	warp "c_tower1", 235, 223;
	end;
}

c_tower3_,59,148,5	duplicate(Belljamin Button#nct1)	Belljamin Button#nct2	574

	} else if (ep14_1_rope == 5) {
		mes "[Euridi's Friend]";
		mes "快去找皮特。";
		close;
	} else if (ep14_1_rope == 6) {
		mes "[Euridi's Friend]";
		mes "尤莉迪唱着治愈之歌，";
		mes "保护她虚弱的身心。";
		mes "照这样下去，她也会出事。";
		next;
		mes "[Euridi's Friend]";
		mes "哦，我记得有个旅行者告诉我，";
		mes "他在雾之森林入口附近";
		mes "见过一个可疑的男人。";
		next;
		mes "[Euridi's Friend]";
		mes "旅行者说那个人站在那里发呆，看起来很诡异，";
		mes "但因为雾太浓，";
		mes "看不清楚。";
		mes "我觉得值得调查。";
		changequest 1114,1115;
		set ep14_1_rope,7;
		close;
	} else if (ep14_1_rope == 7) {
		mes "[Euridi's Friend]";
		mes "我听说有人在雾之森林入口附近";
		mes "看到一个可疑男人。";
		mes "旅行者说那个人站在那里发呆，看起来很诡异，";
		mes "但因为雾太浓看不清楚。";
		mes "我觉得值得调查。";
		close;
	} else if (ep14_1_rope == 8 || ep14_1_rope == 9) {
		mes "[Euridi's Friend]";
		mes "你的脸色很阴沉。";
		mes "有坏消息吗？";
		close;
	} else if (ep14_1_rope == 10) {
		mes "[Euridi's Friend]";
		mes "拉斐尔族有句谚语：";
		mes "绝望会招来灾难。";
		mes "也许发生的一切";
		mes "是我们的责任。";
		next;
		if (checkweight(6380,1) == 0) {
			mes "[Euridi's Friend]";
			mes "你带的东西太多了。";
			mes "能丢掉一些吗？";
			close;
		}
		mes "[Euridi's Friend]";

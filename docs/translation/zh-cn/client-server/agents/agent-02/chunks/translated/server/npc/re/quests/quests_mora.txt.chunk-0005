	} else if (ep14_1_rope > 10) {
		mes "[Euridi's Friend]";
		mes "谢谢你。我不会忘记你的帮助。";
		close;
	}
}

mora,65,145,3	script	Pitt#pa	519,{
	if (ep14_1_rope == 0) {
		mes "[Pitt]";
		mes "你还真厉害，";
		mes "竟然活着穿过了雾之森林。";
		mes "你看，我现在一团糟，";
		mes "没心情听你的冒险故事。";
		mes "现在离开。";
		close;
	} else if (ep14_1_rope == 1) {
		mes "[Pitt]";
		mes "你很擅长纠缠别人，对吧？";
		mes "尤莉迪派你来的，嗯？";
		mes "那对拉斐尔族夫妇";
		mes "急着要杀我。";
		next;
		mes "[Pitt]";
		mes "去告诉她！";
		mes "那个愚蠢的向导";
		mes "把我们这些不情愿的游客推进森林，";
		mes "然后逃跑保住自己的性命！";
		next;
		mes "[Pitt]";
		mes "所以你是在遗憾这里的是我，而不是他？";
		mes "他一定还活在某处，";
		mes "去找他吧！别再烦我！";
		changequest 1109,1110;
		set ep14_1_rope,2;
		close;
	} else if (ep14_1_rope == 2) {
		mes "[Pitt]";
		mes "这一切都是因为";
		mes "那个愚蠢的向导！";
		mes "我讨厌拉斐尔族！";
		close;
	} else if (ep14_1_rope == 3) {
		if (countitem(6383) < 30) {
			mes "[Pitt]";
		mes "这一切都是因为";
		mes "那个愚蠢的向导！";
		mes "我讨厌拉斐尔族！";
			close;
		}
		mes "[Pitt]";
		mes "你手里的那个东西……";
		mes "看起来很奇怪。";
		mes "我以前从没见过这种东西。";
		mes "你最好别留着。";
		mes "能给我吗？";
		next;
		switch(select("交给他。：不给他。")) {
		case 1:
			mes "[Pitt]";
			mes "那我就这样吞下去，";
			mes "看，证据消失了！";
			mes "现在我可以安心睡觉了，谢谢你！";
			delitem 6383,5; //Clue_Of_Lope
			close;
		case 2:
			mes "[Pitt]";
			mes "你为什么给我看这种东西？";
			mes "我什么都不知道！我是受害者！";
			mes "我是那对拉斐尔族夫妇阴谋的受害者。";
			mes "太不公平了……";
			next;
			mes "继续和他说话也没用。";
			mes "试着和尤莉迪谈谈。";
			changequest 1111,1112;
			set ep14_1_rope,4;
			close;
		}
	} else if (ep14_1_rope == 4) {
		mes "[Pitt]";
		mes "这不公平！";
		mes "这实在太不公平了！";
		close;
	} else if (ep14_1_rope == 5) {
		if (checkweight(6384,1) == 0) {
			mes "[Pitt]";
		mes "你是搬运工吗？";
		mes "背着一大堆东西到处踩来踩去！";
		mes "吵得我无法休息！";
		mes "把那些东西都扔掉！";
			close;
		}
		mes "[Pitt]";
		mes "我从没想过你会找到所有线索";
		mes "并把它们拼起来。";
		mes "这是神的惩罚吗……？";
		mes "还是拉斐尔族的诅咒？";
		mes "呼……";
		next;
		mes "[Pitt]";
		mes "那个向导，";
		mes "他中毒很深时，";
		mes "打开了出口的门。";
		next;
		mes "[Pitt]";
		mes "当我犹豫要不要带他一起走时，";
		mes "他把那封信和戒指交给了我。";
		mes "拉斐尔族的珠宝……";
		mes "传说除了拉斐尔族，没人能拥有，";
		mes "连神也不例外。";
		next;
		mes "[Pitt]";
		mes "所以我手里拿着的";
		mes "是宝物中的宝物！";
		mes "怎么会……！我怎么能";
		mes "让它从手中溜走！";
		next;
		mes "[Pitt]";
		mes "我本想振作起来后";
		mes "马上离开这里。";
		mes "但现在我也中了毒，";
		mes "被困在这里。";
		next;
		mes "[Pitt]";
		mes "我把戒指还给你，";
		mes "请别再烦我！";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "那么罗佩会在哪里……？";
		next;
		mes "[Pitt]";
		mes "如果他死在森林出口附近，";
		mes "那他一定就在附近，";
		mes "无论以什么形态存在。";
		changequest 1113,1114;
		set ep14_1_rope,6;
		getitem 6384,1; //Ring_Of_Lope
		close;
	} else if (ep14_1_rope == 6 || ep14_1_rope == 7) {
		mes "[Pitt]";
		mes "我也是受害者！";
		mes "所以别烦我！求你了！";
		close;
	} else if (ep14_1_rope == 8) {
		mes "[Pitt]";
		mes "...";
		close;
	} else if (ep14_1_rope > 8) {
		mes "他正在睡觉。";
		mes "他似乎睡得很沉。";
		close;
	}
}

bif_fild01,132,338,3	script	Lope#pa	461,2,2,{
	if (ep14_1_rope < 8) {
		mes "[Suspicious Man]";
		mes "......";
		close;
	} else if (ep14_1_rope == 8) {
		donpcevent "Lope#pa::OnEnable";
		mes "[Suspicious Man]";
		mes "啊啊啊啊啊！！！！！！";
		mes "我什么也看不见。";
		mes "谁在那里？";
		mes "回答我，否则我就把你当敌人杀掉。";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "尤莉迪正在找你。";
		next;
		mes "[Suspicious Man]";
		mes "......";
		next;
		mes "[Lope]";
		mes "幽灵，你怎么能如此对我？";
		mes "我承受诅咒，";
		mes "就是为了让你从我脑中抹去那个名字！";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "请冷静下来，听我说……";
		next;
		mes "[Lope]";
		mes "帮助他人的愿望";
		mes "把我引向死亡，";
		mes "而求生和复仇的愿望";
		mes "让我重生。";
		mes "我不会再站在生者一边。";
		next;
		mes "[Lope]";
		mes "变身结束后，";
		mes "我会用救了我性命的雾之森林的血腥混乱，";
		mes "惩罚你们所有人！";
		next;
		mes "你把尤莉迪拼好的信放进罗佩手中。";
		next;
		mes "[罗佩]";
		mes "……这是！";
		mes "我感受到了尤莉迪的触碰。";
		mes "所以这封信……已经交给尤莉迪了？";
		mes "难以置信……";
		next;
		mes "[罗佩]";
		mes "我现在已经变得畸形，";
		mes "不再是她爱的人。";
		mes "回去告诉她，罗佩很久以前";
		mes "就化作了雾之森林地面上的尘土。";
		next;
		mes "[Lope]";
		mes "现在走吧！";
		mes "这是我作为拉斐尔族罗佩的最后请求……";
		set ep14_1_rope,9;
		changequest 1115,1116;
		close;
	} else {
		mes "[Lope]";
		mes "我现在已经变得畸形，";
		mes "不再是她爱的人。";
		mes "回去告诉她，罗佩很久以前";
		mes "就化作了雾之森林地面上的尘土。";
		next;
		mes "[Lope]";
		mes "现在走吧！";
		mes "这是我作为拉斐尔族罗佩的最后请求……";
		next;
		mes "你看到他的左手上有一枚微微发光的戒指。";
		close;
	}
	end;
OnEnable:
	setnpcdisplay "Lope#pa",999;
	end;
OnDisable:
	disablenpc "Lope#pa";
	initnpctimer;
	end;
OnReset:
	setnpcdisplay "Lope#pa",461;
	enablenpc "Lope#pa";
	end;
OnTimer2000:
	donpcevent "Lope#pa::OnReset";
	stopnpctimer;
	end;
OnTouch:
	mes "我看到一个可疑的男人。要试着和他谈谈吗？";
	next;
	switch(select("别管他。：和他谈谈。")) {
	case 1:
		donpcevent "Lope#pa::OnDisable";
		mes "[Suspicious Man]";
		mes "......";
		close;
	case 2:
		donpcevent "Lope#pa::OnDisable";
		if (ep14_1_rope == 7) {
			mes "[Suspicious Man]";
			mes ".";
			mes "...";
			mes "........!!!";

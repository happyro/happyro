			case 1:
				mes "[Euridi]";
				mes "真是无情！";
				close;
			case 2:
				mes "[Euridi]";
				mes "我听说他带游客在村子附近游览时，";
				mes "进入了雾之森林。";
				mes "和罗佩一起去的游客中，";
				mes "有一个应该还在旅馆。";
				next;
				mes "[Euridi]";
				mes "他不肯见我，把自己锁在房间里。";
				mes "但他可能愿意见你，因为你去过雾之森林。";
				setquest 1109;
				set ep14_1_rope,1;
				close;
			}
		}
	} else if (ep14_1_rope == 1) {
		mes "[Euridi]";
		mes "游客在旅馆，";
		mes "不在我面前！";
		close;
	} else if (ep14_1_rope == 2) {
		mes "[Euridi]";
		mes "所以你见到皮特了！";
		mes "我就知道他愿意见你。";
		mes "他说了什么？";
		next;
		mes "[Euridi]";
		mes "...No way....!";
		mes "那完全是胡说。";
		mes "竟然把责任推给罗佩！";
		mes "我在雾之森林附近";
		mes "找到这张纸。";
		mes "我确定这是罗佩的。";
		next;
		mes "[Euridi]";
		mes "如果你找到剩下的^0000FF罗佩线索^000000，";
		mes "就能查出";
		mes "他在哪里。";
		mes "拜托你了，"+strcharinfo(0)+"。";
		changequest 1110,1111;
		set ep14_1_rope,3;
		close;
	} else if (ep14_1_rope == 3) {
		mes "[Euridi]";
		mes "如果你找到^0000FF罗佩的线索^000000，请拿给皮特看。";
		mes "希望他很快能说出真相。";
		close;
	} else if (ep14_1_rope == 4) {
		mes "[Euridi]";
		mes "我不明白。";
		mes "我开始怀疑他的动机了。";
		mes "他为什么如此努力地指责罗佩？";
		mes "等等……那些线索……";
		next;
		mes "[Euridi]";
		mes "那些似乎不只是普通笔记。";
		mes "我能看看吗？";
		mes "...";
		mes "这些像拼图一样可以拼在一起。";
	mes "……哦！……这是……";
		next;
		mes "[Lope's Letter]";
		mes "……我们已经在森林里徘徊了好几天。";
		mes "……所以我们没能保护游客，";
		mes "我中了致命的毒，成了大家的负担。";
		mes "真是可悲……";
		next;
		mes "[Lope's Letter]";
		mes "难怪我被赶出了";
		mes "斯普兰迪德远征队。";
		mes "……但我至少成功保护了一名游客。";
		mes "他会把这封信和戒指交给你。";
		next;
		mes "[Lope's Letter]";
	mes "……我本来想向你求婚";
		mes "以远征队自豪成员的身份。";
		mes "对不起，尤莉迪。";
		mes "很快再见。";
		next;
		mes "读完信后，";
		mes "尤莉迪呆呆地站着，仿佛失去了灵魂。";
		mes "把信拿给皮特看吧。";
		changequest 1112,1113;

		//delitem 6383,30; //Clue_Of_Lope
		set .@count, countitem(6383);
		if (.@count) delitem 6383,((.@count > 30)?30:.@count); //Clue_Of_Lope

		set ep14_1_rope,5;
		close;
	} else if (ep14_1_rope == 5) {
		mes "[Euridi]";
		mes "不，罗佩一定平安无事。";
		mes "无论如何他都会回来……";
		close;
	} else if (ep14_1_rope == 6) {
		mes "[Euridi]";
		mes "......";
		next;
		mes "你听到低着头的女孩唱着歌。";
		mes "她的朋友似乎有话要说。";
		close;
	} else if (ep14_1_rope == 7 || ep14_1_rope == 8) {
		mes "你听到轻柔的歌声。";
		mes "听不清歌词。";
		close;
	} else if (ep14_1_rope == 9) {
		mes "[Euridi]";
		mes "你找到罗佩了吗？";
		mes "他安全吗？";
		next;
		switch(select("告诉她你不可能找到他。：告诉她他死了。")) {
		case 1:
			mes "[Euridi]";
			mes "我自己去找他。";
			mes "希望……现在还不算太晚。";
			mes "让我去，不能再浪费时间了！";
			close;
		case 2:
			mes "[Euridi]";
			mes "我不相信。";
			mes "他说他很快会回来……";
			mes "他说让我坚持住。";
			mes "不可能……不可能……";
			next;
			mes "你把皮特交给你的罗佩戒指递给她。";
			mes "戒指握在手中，尤莉迪突然哭了起来。";
			mes "她一边哭，一边用沙哑的声音唱歌。";
			changequest 1116,1117;
			set ep14_1_rope,10;

			//delitem 6384,1; //Ring_Of_Lope
			if (countitem(6384)) delitem 6384,1; //Ring_Of_Lope

			close;
		}
	} else if (ep14_1_rope > 9) {
		mes "你僵在原地。";
		mes "你听到轻柔的歌声。";
		close;
	}
}

mora,115,68,3	script	Euridi's Friend#pa	520,{

				mes "这位是王位候选人彼得·海涅。";
				next;
				cutin "ep16_petter_heine01",0;
				mes "[Peter]";
				mes "很高兴见到你。";
				mes "事情就变成这样了。";
				next;
				cutin "ep16_friedrich_stolz_heine",1;
				mes "[Friedrich]";
				mes "刚才丢下我们、出丑离开房间的那个人是我的儿子尼希尔。";
				next;
				mes "[Friedrich]";
				mes "他是海涅家族的嫡系成员。";
				mes "但他还是那样像个孩子。";
				mes "请原谅他的无礼。";
				next;
				cutin "ep16_kronecker_granz_heine",2;
				mes "[Kronecker]";
				mes "随他去吧。";
				mes "我们已经管不了他了。";
				next;
				cutin "ep16_petter_heine01",0;
				mes "[Peter]";
				mes "……大公，请不要对尼希尔太严厉。";
				mes "其实尼希尔本来应该是王位候选人。";
				next;
				mes "[Peter]";
				mes "毕竟我只是家族的旁系成员……";
				next;
				cutin "ep16_kronecker_granz_heine",2;
				mes "[Kronecker]";
				mes "到此为止吧。不必再说了。";
				mes "尼希尔没有成为国王的资质。";
				next;
				mes "[Kronecker]";
				mes "他没有任何符合家族正统性的条件，不能被选为候选人。";
				mes "他甚至不知道自己的立场，却还如此渴望权力。";
				next;
				cutin "ep16_petter_heine01",0;
				mes "[Peter]";
				mes "我觉得并不是这样……";
				mes "他的权利一直被忽视，一定因此很受打击。";
				next;
				cutin "ep16_kronecker_granz_heine",2;
				mes "[Kronecker]";
				mes "海涅家族的权利，就是伴随海涅之名而来的一切。";
				mes "尼希尔拥有这一切。";
				next;
				mes "[Kronecker]";
				mes "那个孩子为什么意识不到呢？";
				mes "在客人面前谈论家事不太合适。";
				next;
				mes "[Kronecker]";
				mes "抱歉。";
				mes "呼……不知道我们做了什么，竟让家里出了那样的混账。";
				next;
				mes "[Kronecker]";
				mes "我听说你会参加仪式。";
				mes "值得庆幸的是，下一任国王可能会出自海涅家族。";
				next;
				unittalk getcharid(3), "" + strcharinfo(0) + "：你的意思是彼得会……？", bc_self;
				mes "[Kronecker]";
				mes "在刚才测试王位候选人的王室会议上……";
				next;
				cutin "ep16_friedrich_stolz_heine",1;
				mes "[Friedrich]";
				mes "瓦尔特家族的伊森纳姆本来是所有候选人中最强的，却突然威胁了其他候选人。";
				mes "乔伯格家族的恩斯特不得不处决了他。";
				next;
				mes "[Friedrich]";
				mes "看起来恩斯特本来会被任命为下一任国王，但他突然辞职了。";
				mes "……我想他是遵从了女王的意愿。";
				next;
				mes "[Friedrich]";
				mes "由于事态发展，王室会议将再次举行。";
				mes "这次彼得会作为海涅家族的代表参加。";
				next;
				npctalk "我本来没打算这样，但我会尽力而为。", "Peter Heine#ep16_01", bc_self;
				cutin "ep16_kronecker_granz_heine",2;
				mes "[Kronecker]";
				mes "而尼希尔现在竟然如此嫉妒他。";
				mes "他怎么能如此卑劣？";
				next;
				mes "[Friedrich]";
				cutin "ep16_friedrich_stolz_heine",1;
				mes "嗯……其实他并不像刚才说的那样是个坏孩子。";
				mes "他从来没有做过有辱海涅之名的事。";
				next;
				mes "[Friedrich]";
				mes "我不是因为他是我儿子才想替他说话。";
				mes "尼希尔，他只是……";
				next;
				mes "[Kronecker]";
				cutin "ep16_kronecker_granz_heine",2;
				mes "别替他说话。他的无能就是罪过。";
				mes "强大的魔力世代流淌在海涅家族血脉中。";
				next;
				mes "[Kronecker]";
				mes "他被称为米杰莉娅是有原因的。";
				unittalk getcharid(3), "" + strcharinfo(0) + "：米杰莉娅？悲惨？", bc_self;
				next;
				mes "[Friedrich]";
				cutin "ep16_friedrich_stolz_heine",1;
				mes "不要对我们的家事过于好奇。";
				mes "呼……我想我们稍后还会再见。";
				completequest 7683;
				if (achievementinfo(130000, ACHIEVEINFO_COUNT1) == 0)
					achievementupdate(130000, ACHIEVEINFO_COUNT1, 1);
				next;
				if (isbegin_quest(7682) == 1 && isbegin_quest(5402) == 2 && isbegin_quest(7683) == 2 && isbegin_quest(7684) == 2 && ep16_wal > 1 && ep16_wig > 1 && ep16_lug > 1 && ep16_gaobs > 1) {
					completequest 7682;// Socializing Starts from an Eye Contact
					setquest 7685;// What Is the Next Thing on the Schedule ?
					mes "[Kronecker]";
					cutin "ep16_kronecker_granz_heine.bmp",2;
					mes "王室会议很快就会结束，最终决定做出后便会举行仪式。";
					mes "在那之前好好享受宴会，然后参加仪式吧。";
					close3;
				}
				cutin "ep16_kronecker_granz_heine",2;
				mes "[Friedrich]";
				mes "王室会议很快就要结束了。";
				mes "我们必须为此做准备。抱歉，不能再陪你了。";
				next;
				mes "[Friedrich]";
				mes "如果你还没拜访完其他家族，就去拜访他们吧。";
				close3;
			case 2:
				npctalk "如果你还没拜访完其他家族，就去拜访他们吧。";
				end;
			}
			end;
		case 1:
			npctalk "一切很快就会尘埃落定。在那之前请待在房间里。", "Kronecker G. Heine#ep16_01", bc_self;
			end;
		default:
			end;
		}
	}
	if (ep16_royal < 8) {
		cutin "ep16_kronecker_granz_heine",2;
		mes "[Kronecker]";
		mes "王室会议很快就要结束了。";
		mes "正如我们所料，彼得似乎是个有力的候选人。";
		next;
		mes "[Kronecker]";
		mes "你享受这场宴会吗？";
		mes "王室会议一结束，我们就会进行最终仪式……";
		next;
		mes "[Kronecker]";
		mes "我会派一位宫廷魔法师去找你。";
		mes "享受宴会，并及时回到房间。";
		close3;
	}
	if (ep16_royal < 16)	// door locked
		end;
	if (ep16_royal == 16) {
		cutin "ep16_kronecker_granz_heine",2;
		mes "[Kronecker]";
		mes "我一直在等你。";
		mes "虽然我不太愿意向你透露王室有些难堪的一面，";
		next;
		mes "[Kronecker]";
		mes "无论如何，是卢恩·米德加尔兹王室允许你观礼的。";
		mes "而且你就是在那次事件中与入侵者战斗的人……";
		next;
		mes "[Kronecker]";
		mes "不绕弯子了，";
		mes "那些入侵者一定是冲着^4d4dff伊米尔之心碎片^000000来的。";
		next;
		mes "[Kronecker]";
		mes "我们不知道意识之室里的东西是^4d4dff假的伊米尔之心碎片^000000。";
		next;
		mes "[Kronecker]";
		mes "我们查遍了^4d4dff王室往事^000000的记录，寻找关于那块碎片的记载。";
		next;
		mes "[Kronecker]";
		mes "但什么也没找到。";
		mes "唯一的线索是一则谜语。";
		next;
		select("你是说，知晓真相的人？");
		mes "[Kronecker]";
		mes "你一定在王室往事中看到了它。";
		mes "你比我想象中更机敏。";
		next;
		mes "[Kronecker]";
		mes "我们该怎么做才能查明真相？";
		mes "我们必须回到过去。";
		next;
		mes "[Kronecker]";
		mes "弗里茨，情况怎么样？";
		next;
		cutin "ep16_friedrich_stolz_heine",1;
		mes "[Friedrich]";
		mes "我找到了一位专精此领域的宫廷魔法师。";
		mes "他说^4d4dff自己在王室往事中感受到巨大的魔力扭曲，我们可以依靠他^000000。";
		next;
		mes "[Friedrich]";
		mes "他很快就会带来结果。";
		mes "他说会强行连接次元裂隙。";
		next;
		mes "[Friedrich]";
		mes "他做事相当鲁莽，但据说非常有本事……";
		mes "而且你认识他。";
		next;
		select("是尼勒姆吗？");
		mes "[Friedrich]";
		mes "看来你也认识他。";
		mes "没错。";
		mes "我希望你和尼勒姆一起执行这项任务。";
		next;
		select("我？为什么？");
		mes "[Friedrich]";
		mes "我也想知道。";
		mes "尼勒姆一直缠着我，要求和你一起行动。";
		mes "……我已经尽力不杀他了。";
		next;
		mes "[Friedrich]";
		mes "王室往事是一个只有王室家族和少数其他人才能进入的特殊地方。";
		mes "为了保守秘密，我们不能冒险让更多人牵涉其中。";
		next;
		mes "[Friedrich]";
		mes "既然你已经经历过次元裂隙……";
		next;
		mes "[Friedrich]";
		mes "我们没有其他选择。";
		mes "我们会给你丰厚的报酬。请帮助我们。";
		next;
		select("既然你这么说……");
		cutin "ep16_kronecker_granz_heine",2;
		mes "[Kronecker]";
		mes "那么，就这么定了。";
		mes "尼勒姆准备好后，我们会立即让他去你的房间。";
		mes "你可以和他组队执行任务。";
		next;
		mes "[Kronecker]";
		mes "这是王室赠给有功之人的物品。";
		mes "你刚到宫殿后第一次下去时曾收到过。还记得吗？";
		next;
		mes "[Kronecker]";
		mes "它对你这样的人一定有用。";
		mes "希望能帮到你。";
		ep16_royal = 17;
		setquest 7699;// To the Past
		erasequest 7698;// Heine Now
		getitem 6919,20;// TokenOfHonor
		getexp 400000,400000;
		close3;
	}
	if (ep16_royal == 17) {
		cutin "ep16_kronecker_granz_heine",2;
		mes "[Kronecker]";
		mes "名叫尼勒姆的魔法师会来找你。";
		mes "你可以在房间里等候。";
		close3;
	}
	cutin "ep16_kronecker_granz_heine",2;
	mes "[Kronecker]";
	mes "现在放弃希望还太早。";
	mes "我相信你一定能做得很好。";
	close3;
}

prt_cas_q,22,80,3	script	Nyhill M. Heine#ep16_01	4_EP16_NIHIL,{ end; }

prt_cas_q,22,77,0	script	#ep16_heine_evt02	HIDDEN_WARP_NPC,2,2,{
	end;
OnTouch:
	if (ep16_royal == 2 && isbegin_quest(7683) == 0) {
		npctalk "你没有资格说这种话！", "Kronecker G. Heine#ep16_01", bc_self;
		setpcblock PCBLOCK_NPC, true;
		sleep2 3000;
		npctalk "我要回本家。请允许我离开。", "Nyhill M. Heine#ep16_01", bc_self;
		sleep2 3000;
		npctalk "注意你的礼仪。你已经不是孩子了。", "Friedrich S. Heine#ep16_01", bc_self;
		sleep2 3000;
		npctalk "你知道，我没有理由留在这里。", "Nyhill M. Heine#ep16_01", bc_self;
		sleep2 3000;
		npctalk "作为家族成员，留在这里是你的责任！", "Kronecker G. Heine#ep16_01", bc_self;
		sleep2 3000;
		npctalk "家族成员？我从什么时候起被当作家族成员了？", "Nyhill M. Heine#ep16_01", bc_self;
		sleep2 3000;
		npctalk "你忘了家族给我的名字吗？", "Nyhill M. Heine#ep16_01", bc_self;
		sleep2 3000;
		npctalk "尼希尔·米杰莉娅，我是一个一无所有、悲惨的海涅！因为我没用，你们才给了我这样的名字！", "Nyhill M. Heine#ep16_01", bc_self;
		sleep2 3000;
		npctalk "注意你的言辞，尼希尔。", "Friedrich S. Heine#ep16_01", bc_self;
		sleep2 3000;
		npctalk "你们从来没把我当作家族成员。", "Nyhill M. Heine#ep16_0", bc_self;
		sleep2 3000;
		npctalk "可是我必须承担所有责任。我再也受不了了。", "Nyhill M. Heine#ep16_0", bc_self;
		sleep2 1000;
		cloakonnpcself( "Nyhill M. Heine#ep16_01" );
		sleep2 500;
		unittalk getcharid(3), "" + strcharinfo(0) + "：哦，他走了。", bc_self;
		sleep2 1000;
		setpcblock PCBLOCK_NPC, false;
		npctalk "……那个没用的混账。他一点好事都做不了！", "Kronecker G. Heine#ep16_01", bc_self;
		setquest 7683;
	}
	end;
OnInit:
	cloakonnpc "Nyhill M. Heine#ep16_01";
	cloakonnpc "Peter Heine#ep16_01";
	end;
}

prt_cas_q,144,38,3	script	Nyhill#ep16_7686	4_EP16_NIHIL,{ end; }
prt_cas_q,141,39,5	script	Skia#ep16_7686	4_EP16_SKIA,{ end; }

prt_cas_q,141,36,0	script	#ep16_evt_7686	HIDDEN_WARP_NPC,3,1,{
	end;
OnTouch:
	if (isbegin_quest(7683) == 2 && isbegin_quest(7686) == 0) {
		cloakoffnpcself( "Skia#ep16_7686" );
		cloakoffnpcself( "Nyhill#ep16_7686" );
		setpcblock PCBLOCK_NPC, true;
		sleep2 2000;
		npctalk "你就是人们谈论的影之公主吗？", "Nyhill#ep16_7686", bc_self;
		sleep2 3000;
		npctalk "对你来说一定也很辛苦。这是你第一次参加正式活动吗？", "Nyhill#ep16_7686", bc_self;
		sleep2 3000;
		npctalk "哦，你一定就是海涅家族的领主。", "Skia#ep16_7686", bc_self;
		sleep2 3000;
		npctalk "没错，我确实是影子。不过我从未觉得这很辛苦。", "Skia#ep16_7686", bc_self;
		sleep2 3000;
		npctalk "我只做自己能做的事。", "Skia#ep16_7686", bc_self;
		sleep2 3000;
		npctalk "不过你并不是出于自己的意愿才以那种方式出生的，对吧？", "Nyhill#ep16_7686", bc_self;
		sleep2 3000;
		npctalk "我从小就作为影子被养大，但这从未让我悲伤。", "Skia#ep16_7686", bc_self;
		sleep2 3000;
		npctalk "我以前也曾质疑过……", "Skia#ep16_7686", bc_self;
		sleep2 3000;
		npctalk "但我选择成为现在的自己。这就是我的道路。", "Skia#ep16_7686", bc_self;
		sleep2 3000;
		npctalk "真的。我很羡慕你能这样想。", "Nyhill#ep16_7686", bc_self;
		sleep2 3000;
		npctalk "我一直想摆脱米杰莉娅这个名字。", "Nyhill#ep16_7686", bc_self;
		sleep2 3000;
		npctalk "你知道一个人不断听到自己生来一无所有时会怎样吗？", "Nyhill#ep16_7686", bc_self;
		sleep2 3000;
		npctalk "他会失去自我，仿佛内心空空如也。", "Nyhill#ep16_7686", bc_self;
		sleep2 3000;
		npctalk ".......", "Nyhill#ep16_7686", bc_self;
		sleep2 3000;
		npctalk "我在说什么……请原谅我。", "Nyhill#ep16_7686", bc_self;
		sleep2 2000;
		npctalk "你知道，当你一无所有时……", "Skia#ep16_7686", bc_self;
		sleep2 2000;
		npctalk ".......", "Nyhill#ep16_7686", bc_self;
		sleep2 2000;
		npctalk "你可以用任何东西将它填满。人的未来并不是命中注定的。", "Skia#ep16_7686", bc_self;
		sleep2 6000;
		npctalk "……是这样吗。", "Nyhill#ep16_7686", bc_self;
		sleep2 3000;
		npctalk "对了，我还没自我介绍。我叫尼希尔·米杰莉娅·海涅。", "Nyhill#ep16_7686", bc_self;
		sleep2 3000;
		npctalk "我是尼鲁斯的斯琪亚。你可以叫我斯琪亚。", "Skia#ep16_7686", bc_self;
		sleep2 3000;
		npctalk "哦，对了。我正要去见英雄！", "Skia#ep16_7686", bc_self;
		sleep2 3000;
		npctalk "那么请容我先告辞。", "Skia#ep16_7686", bc_self;
		sleep2 1000;
		cloakonnpcself( "Skia#ep16_7686" );
		sleep2 3000;
		npctalk "……斯琪亚……尼鲁斯家族里有位有趣的女士。", "Nyhill#ep16_7686", bc_self;
		sleep2 3000;
		setpcblock PCBLOCK_NPC, false;
		cloakonnpcself( "Nyhill#ep16_7686" );
		if (isbegin_quest(7686) == 0) {
			setquest 7686;// Nyhill and Skia
			completequest 7686;// Nyhill and Skia
		}
	}
	end;
OnInit:
	cloakonnpc "Skia#ep16_7686";
	cloakonnpc "Nyhill#ep16_7686";
	end;
}

// Right Side
// Roegenburg
prt_cas_q,90,186,5	script	Maximilian Roegenburg#ep16lug	4_EP16_MAX,{
	if (checkweight(1301,1) == 0) {
		mes "[Maximilian]";
		mes "你的行李似乎很多。没问题吗？";
		mes "看起来又多又大。";
		next;
		mes "[Maximilian]";
		mes "减少一些怎么样？";
		close;
	}
	if (BaseLevel < 100) {
		mes "[Maximilian]";
		mes "罗根贝格欢迎经历丰富的冒险者，但现在和你合作还稍微早了些。";
		mes "希望以后还能见到你。";
		close;
	}
	if (ep16_lug == 0) {
		if (isbegin_quest(7682) != 1) {
			mes "[Maximilian]";
		mes "你怎么能进到这里来？";
		mes "不是工作人员就不能进入这里。请到外面去。";
			close;
		}
		mes "[Maximilian]";
		mes "冒险者们，你们好。很荣幸你们来访^0000cd罗根贝格^000000。我是^0000cd马克西米利安·罗根贝格^000000。";
		next;
		mes "[Maximilian]";
		mes "我们是建立王国、为卢恩·米德加尔兹辛勤奉献的七大王室家族之一。";
		next;
		mes "[Maximilian]";
		mes "家族继承人^0000cd赫尔穆特·罗根贝格^000000应该会参加王室会议。要不要见见他？";
		next;
		cutin "16hel",0;
		mes "[Helmut]";
		mes "你好，我是^0000cd赫尔穆特·罗根贝格^000000。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "你好，我受邀参加这场宴会。我是" + strcharinfo(0) + "。很高兴见到你。";
		next;
		mes "[Helmut]";
		mes "很荣幸见到击败梦罗克的英雄。请在罗根贝格好好享受这段时光。";
		next;
		mes "[Helmut]";
		mes "如果你有时间，要不要去见见罗根贝格的其他人？";
		next;
		mes "[Helmut]";
		mes "哥哥，听^0000cd沃尔夫·罗根贝格^000000讲述家族故事会对你有所帮助。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "当然，这是个好机会。";
		setquest 14495;// To Wolf

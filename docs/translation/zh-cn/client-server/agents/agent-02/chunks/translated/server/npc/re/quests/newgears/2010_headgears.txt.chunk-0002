	mes "- 无法再获得更多。-";
	mes "- 请再来找我。-";
		mes "- after emptying some of it. -";
		close;
	}
	return;
}

gef_fild07,108,161,4	script	Roda Frog#Frog_Cap	1012,1,1,{
	if (!.Active) end;
	if (hat_2009 == 0) {
		mes "[???]";
		mes "嗯……嗯……";
		mes "看来我成功变成孩子的样子了。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "... ... ... ...";
		next;
		mes "[???]";
		mes "人类！我来请求你的帮助。";
		next;
		if (BaseLevel < 65) {
			mes "[???]";
			mes "... ... ...";
			next;
			mes "[???]";
			mes "我是伟大的蛙王七世！";
			next;
			mes "[King Froggie VII]";
			mes "但我觉得你还不够强，无法帮助我们。";
			mes "去多训练吧！";
			next;
			mes "[King Froggie VII]";
			mes "等级超过65的人类就能帮助我们。";
			close2;
			donpcevent "Roda Frog#Frog_Cap::OnDisable";
			end;
		} else {
			mes "[???]";
			mes "我是伟大的蛙王七世……";
			mes "我需要你的帮助！";
			next;
			if(select("直接无视：帮助他。") == 1) {
				mes "[" + strcharinfo(0) + "]";
				mes "会说话的青蛙……";
				next;
				mes "[" + strcharinfo(0) + "]";
				mes "现在我什么都见识过了。";
				next;
				mes "[King Froggie VII]";
			mes "呱……呱……";
				close2;
				donpcevent "Roda Frog#Frog_Cap::OnDisable";
				end;
			}
			mes "[" + strcharinfo(0) + "]";
			mes "我能帮你什么？";
			next;
			mes "[King Froggie VII]";
			mes "我们伟大的青蛙族群正濒临灭绝，因为许多旅行者来到这里，把我们的卵当作纪念品带走。我甚至听说到处还有许多卵落在地上，所以需要你的帮助。请带回^FF0000100个蛙卵^000000。";
			setquest 5000;
			set hat_2009,1;
			next;
			mes "[" + strcharinfo(0) + "]";
			mes "好的，我会的。";
			next;
			mes "[King Froggie VII]";
			mes "我会等你！";
			close2;
			donpcevent "Roda Frog#Frog_Cap::OnDisable";
			end;
		}
	} else if (hat_2009 == 1) {
		if (countitem(908) < 100) {
			mes "[King Froggie VII]";
			mes "你在这里做什么？";
			mes "去收集^FF0000100个蛙卵^000000！";
			close2;
			donpcevent "Roda Frog#Frog_Cap::OnDisable";
			end;
		} else {
			mes "[King Froggie VII]";
			mes "哦，你把它们全带来了！";
			next;
			mes "[King Froggie VII]";
			mes "非常感谢你，" + strcharinfo(0) + ".";
			emotion ET_THANKS;
			next;
			mes "[King Froggie VII]";
			mes "顺便说，我们还有另一件急事。所以再请你帮一个忙。";
			next;
			mes "[King Froggie VII]";
			mes "青蛙是蛇的健康食物。";
			next;
			mes "[" + strcharinfo(0) + "]";
			mes "我很清楚。";
			next;
			mes "[King Froggie VII]";
			mes "那很好。你不为我们的族群感到难过吗？";
			next;
			mes "[King Froggie VII]";
			mes "所以我请求你为我们复仇。请杀死^FF000050只响尾蛇^000000。";
			delitem 908,100; //Spawn
			changequest 5000,5001;
			set hat_2009,2;
			next;
			mes "[King Froggie VII]";
			mes "我会等你的消息！";
			close2;
			donpcevent "Roda Frog#Frog_Cap::OnDisable";
			end;
		}
	} else if (hat_2009 == 2) {
		set .@hunting, checkquest(5001,HUNTING);
		if (.@hunting == 0 || .@hunting == 1) {
			mes "[King Froggie VII]";
			mes "我在等你的好消息。";
			mes "对你来说";
			mes "杀死^FF000050只响尾蛇^000000应该很容易。继续加油！";
			close2;
			donpcevent "Roda Frog#Frog_Cap::OnDisable";
			end;
		} else if (.@hunting == 2) {
			mes "[" + strcharinfo(0) + "]";
			mes "我回来了。";
			next;
			mes "[King Froggie VII]";
			mes "看来你杀光了所有响尾蛇！";
			next;
			mes "[King Froggie VII]";
			mes "你成了小青蛙们的榜样。再次感谢你。";
			emotion ET_THANKS;
			next;
			mes "[King Froggie VII]";
			mes "因此我考虑把你的杰出功绩写进青蛙族群史书。但我需要你的成果证明。";
			next;
			mes "[King Froggie VII]";
			mes "请从蛇那里带来^FF0000100个^000000^FF0000毒牙^000000。";
			changequest 5001,5002;
			set hat_2009,3;
			next;
			mes "[" + strcharinfo(0) + "]";
			mes "能被写进史书我很高兴。我这就去收集。";
			next;
			mes "[King Froggie VII]";
			mes "听话又勤劳……希望我也有你这样的忠诚青蛙。";
			close2;
			donpcevent "Roda Frog#Frog_Cap::OnDisable";
			end;
		}
	} else if (hat_2009 == 3) {
		if (countitem(937) < 100) {
			mes "[King Froggie VII]";
			mes "^FF0000100个毒牙^000000怎么样？";
			mes "快点，这是写进青蛙史书的难得机会！";
			close2;
			donpcevent "Roda Frog#Frog_Cap::OnDisable";
			end;
		} else {
			mes "[King Froggie VII]";
			mes "哦，你带来了毒牙！现在我可以正式把你写进青蛙史书了。";
			next;
			mes "[" + strcharinfo(0) + "]";
			mes "这对我很好。";
			next;
			mes "[King Froggie VII]";
			mes "我有更好的消息！";
			next;
			mes "[King Froggie VII]";
			mes "我查阅史书时找到了一种保护族群的好方法！";
			next;
			mes "[King Froggie VII]";
			mes "答案就在青蛙史书里。过去，伟大的蛙王三世制作了秘密药剂，让我们能使用躲避蛇类的技能。";
			next;
			mes "[King Froggie VII]";
			mes "我应该早点知道……";
			mes "请给我^FF000050个鳞片^000000。";
			delitem 937,100; //Posionous_Canine
			changequest 5002,5003;
			set hat_2009,4;
			next;
			mes "[King Froggie VII]";
			mes "这并不容易获得，但我相信你能做到。";
			close2;
			donpcevent "Roda Frog#Frog_Cap::OnDisable";
			end;
		}
	} else if (hat_2009 == 4) {
		if (countitem(936) < 50) {
			mes "[King Froggie VII]";
			mes "还在这里？去收集^FF000050个鳞片^000000！快点！";
			close2;
			donpcevent "Roda Frog#Frog_Cap::OnDisable";
			end;
		} else {
			mes "[King Froggie VII]";
			mes "太棒了！";
			mes "你像年轻时的伟大蛙王三世！";
			next;
			mes "[King Froggie VII]";
			mes "你已经是我们青蛙族群的英雄！如果我有孩子，我会让你和我的孩子结婚。";
			next;
			mes "[" + strcharinfo(0) + "]";
			mes "啊……不用了，谢谢。";
			mes "^FF0000（你是要我和青蛙结婚吗？？？）^000000";
			next;
			mes "[King Froggie VII]";
			mes "多亏了你，青蛙数量增加了，但我们缺少食物。";
			next;
			mes "[King Froggie VII]";
			mes "我们最好的食物是^FF0000蜘蛛^000000。";
			next;
			mes "[King Froggie VII]";
			mes "那么，我们的英雄，你还在等什么？";
			mes "去收集^FF000050只蜘蛛^000000！";
			delitem 936,50; //Scales_Shell
			set hat_2009,5;
			changequest 5003,5004;
			close2;
			donpcevent "Roda Frog#Frog_Cap::OnDisable";
			end;
		}
	} else if (hat_2009 == 5) {
		set .@hunting, checkquest(5004,HUNTING);
		if (.@hunting == 0 || .@hunting == 1) {
			mes "[King Froggie VII]";
			mes "我的英雄，你要让我们饿死吗？";
			mes "去给我们带来^FF000050只蜘蛛^000000！";
			close2;
			donpcevent "Roda Frog#Frog_Cap::OnDisable";
			end;
		} else if (.@hunting == 2) {
			mes "[King Froggie VII]";
			mes "我好像刚才见过你，但现在你已经成为青蛙族群的英雄了……";
			next;
			mes "[King Froggie VII]";
			mes "能请你帮忙真是我的幸运。";
			next;
			if (MaxWeight - Weight < 500) {
				mes "[King Froggie VII]";
				mes "我们的英雄，我想给你奖励，但你的背包太重了。";
				close2;
				donpcevent "Roda Frog#Frog_Cap::OnDisable";
				end;
			}
			if (checkweight(5447,1) == 0) {
				mes "- Wait !! -";
				mes "- 你携带的物品太多，-";
				mes "- 无法再获得更多。-";
				mes "- 请再来找我。-";
				mes "- after emptying some of it. -";
				close;
			}
			mes "[King Froggie VII]";
			mes "青蛙们，你们反对把我们珍贵宝物之一的青蛙帽";
			mes "送给我们的英雄"+strcharinfo(0)+"吗？";
			next;
			mes "[Sounds from somewhere]";
			mes "呱……呱……";
			mes "呱呱呱～～～";
			mes "呱呱";
			next;
			mes "[King Froggie VII]";
			mes "嗯，没有异议。";
			next;
			mes "[King Froggie VII]";
			mes "我现在把这顶青蛙帽送给我们的英雄"+strcharinfo(0)+"。";
			specialeffect2 EF_MAPPILLAR2;
			specialeffect2 EF_BLESSING;
			erasequest 5004;
			set hat_2009,6;
			getitem 5447,1; //Frog_Cap
			next;
			mes "[King Froggie VII]";
			mes "随时欢迎你。";
			mes "任何时候都可以来这里。";
			close2;
			donpcevent "Roda Frog#Frog_Cap::OnDisable";
			end;
		}
	} else if (hat_2009 == 6) {
		mes "[King Froggie VII]";
		mes "全世界的青蛙们，赞美我们的永恒英雄"+strcharinfo(0)+"！";
		emotion ET_THANKS;
		close2;
		donpcevent "Roda Frog#Frog_Cap::OnDisable";
		end;
	}
	end;
//OnInit:
//	setnpcdisplay "Roda Frog#Frog_Cap",1012; //RODA_FROG
//	end;
OnEnable:
	setnpcdisplay "Roda Frog#Frog_Cap",716; //4_M_KID2
	set .Active,1;
	end;
OnDisable:
	set .Active,0;
	disablenpc "Roda Frog#Frog_Cap";
	initnpctimer;
	end;
OnReset:
	setnpcdisplay "Roda Frog#Frog_Cap",1012; //RODA_FROG
	enablenpc "Roda Frog#Frog_Cap";
	end;
OnTimer2000:
	donpcevent "Roda Frog#Frog_Cap::OnReset";
	stopnpctimer;
	end;
OnTouch:
	if (.Active) end;
	mes "这里有一只青蛙。我该怎么办？";
	next;
	switch(select("扔石头。：交谈。")) {
	case 1:
		donpcevent "Roda Frog#Frog_Cap::OnDisable";
		mes "哎哟～";
		close;
	case 2:
		donpcevent "Roda Frog#Frog_Cap::OnEnable";
		if (hat_2009 > 0) {
			emotion ET_THINK, playerattached();
			mes "[" + strcharinfo(0) + "]";
		mes "看到青蛙变身";
		mes "真是太神奇了。";
			close;
		} else {
			emotion ET_HUK, playerattached();
			mes "[" + strcharinfo(0) + "]";
		mes "天啊……青蛙变成孩子了……";
			close;
		}
	}
	end;
}


		}
	case 3:
		mes "[游戏管理员猫]";
		mes "你想玩什么游戏？";
		mes "‘猫咪玩家’有4种游戏的玩家，喵～";
		mes "猫咪玩家主管说之后会挑战其他游戏～";
		next;
		switch(select("石头剪刀布：空娘空：猜猜猜：旗帜游戏")) {
		case 1:
			mes "[游戏管理员猫]";
			mes "石头剪刀布，喵？没什么特别的……";
			next;
			mes "[游戏管理员猫]";
			mes "剪刀胜过布，喵。";
			mes "石头胜过剪刀，喵。";
			mes "布胜过石头，喵。";
			mes "这些是基本规则。";
			next;
			mes "[游戏管理员猫]";
			mes "你要和猫玩家进行5局石头剪刀布，喵。";
			mes "平局时要重新开始，喵。";
			next;
			mes "[游戏管理员猫]";
			mes "连续赢3次后可以得到礼物，喵。";
			mes "5局全胜还能得到大礼物，喵！！";
			next;
			mes "[游戏管理员猫]";
			mes "想玩石头剪刀布，就去找帕或瑟。";
			close;
		case 2:
			mes "[游戏管理员猫]";
			mes "空娘空不是简单的游戏，喵。";
			next;
			mes "[游戏管理员猫]";
			mes "攻击时，手要朝向和对手相同的方向，喵。";
			next;
			mes "[游戏管理员猫]";
			mes "防御时，手要朝向和对手相反的方向，喵。";
			next;
			mes "[游戏管理员猫]";
			mes "攻击成功后可以继续攻击。";
			mes "但如果失败，就必须防御，喵。";
			next;
			mes "[游戏管理员猫]";
			mes "只要小心，就能完全不受攻击地获胜，喵。";
			next;
			mes "[游戏管理员猫]";
			mes "让对手的 HP 归零后就赢了，喵。";
			mes "当然会有礼物，喵。";
			mes "祝你好运，喵。";
			next;
			mes "[游戏管理员猫]";
			mes "哦～对了喵～！！想玩空娘空就去找空空。";
			close;
		case 3:
			mes "[游戏管理员猫]";
			mes "猜猜猜是高阶心理游戏，喵。";
			next;
			mes "[游戏管理员猫]";
			mes "规则很简单，但需要多思考，喵。";
			next;
			mes "[游戏管理员猫]";
			mes "要把手指向猫转脸的方向，喵。";
			next;
			mes "[游戏管理员猫]";
			mes "连续赢3次会得到礼物，喵。";
			mes "赢得越多，礼物越多，喵。";
			next;
			mes "[游戏管理员猫]";
			mes "库卡很聪明，会记住获胜次数多的玩家，喵。";
			mes "取得第一名时会有更多礼物，喵。";
			close;
		case 4:
			mes "[游戏管理员猫]";
			mes "旗帜游戏比猜猜猜难得多，喵。";
			mes "真的～真的～真的～";
			mes "是很难的心理游戏，喵。";
			mes "难度高出1000倍，喵。";
			next;
			mes "[游戏管理员猫]";
			mes "开始时有5点旗帜点数，喵。";
			mes "挥一次旗子会减少1点，喵。";
			next;
			mes "[游戏管理员猫]";
			mes "其他猫都不挥旗子时，你就赢了，喵。";
			next;
			mes "[游戏管理员猫]";
			mes "可以预测其他猫是否会挥旗子，喵。";
			mes "通过观察它们的行动，喵。";
			next;
			mes "[游戏管理员猫]";
			mes "必须获胜才能得到礼物，喵。";
			mes "因为游戏很难，所以会得到更多礼物，喵～";
			next;
			mes "[游戏管理员猫]";
			mes "想玩旗帜游戏的话，喵～";
			mes "去找另一只正在尝试取得裁判证明的管理员猫，喵。";
			close;
		}
	}
}

malangdo,161,197,4	script	Eryu#gamer	876,{
	if (MaxWeight - Weight < 1000) {
		mes "你的物品栏太重，无法继续。减轻负重后再回来。";
		close;
	}
	if (checkweight(1201,1) == 0) {
		mes "你的物品栏太满，无法继续。清理物品后再回来。";
		close;
	}
	if (checkquest(5061) == 0 || checkquest(5061) == 1) {
		if (checkquest(5062) == -1) {
			mes "你找到了猫咪艾柳，并开始交谈。";
			next;
			mes "[艾柳]";
			mes "嗯……你是谁？";
			next;
			switch(select("游戏主管派我来的。：我是《人类》杂志的记者。：你是谁？")) {
			case 1:
				mes "[艾柳]";
				mes "啊。走开……";
				mes "我不知道你说的是谁。";
				emotion ET_FRET;
				break;
			case 2:
				mes "[艾柳]";
				mes "嗯？《人类》杂志？";
				mes "有这种东西吗？";
				emotion ET_QUESTION;
				next;
				mes "["+strcharinfo(0)+"]";
				mes "我们已经出版10年了。";
				mes "不过，猫不知道我们是谁也很正常。";
				next;
				mes "["+strcharinfo(0)+"]";
				mes "我们可是全世界都很有名的杂志！";
				mes "你不相信我吗？";
				next;
				mes "[艾柳]";
				mes "嗯……好吧。但我能为你做什么？";
				emotion ET_QUESTION;
				next;
				mes "["+strcharinfo(0)+"]";
				mes "我正在写一篇名为《玩游戏的猫》的文章……";
				mes "这是我的特别专题。";
				mes "还有一支队伍叫……嗯……狗……嗯……华尔……记不清了……";
				next;
				mes "[艾柳]";
				mes "‘狗与华尔兹’？";
				emotion ET_QUESTION;
				next;
				mes "["+strcharinfo(0)+"]";
				mes "哦！对了！";
				mes "那里的玩家‘狗与华尔兹’推荐艾柳接受采访。";
				next;
				mes "["+strcharinfo(0)+"]";
				mes "他说你是很厉害的玩家，可以帮助我完成文章。";
				next;
				mes "[艾柳]";
				mes "我不太记得‘狗与华尔兹’的人。";
				emotion ET_THINK;
				next;
				mes "["+strcharinfo(0)+"]";
				mes "那个人不重要。";
				next;
				mes "["+strcharinfo(0)+"]";
				mes "只要回答我几个问题，好吗？";
				mes "做你自己就好。";
				mes "好，第一个问题：你每天练习多久？";
				emotion ET_QUESTION, playerattached();
				next;
				mes "[艾柳]";
				mes "通常大约8小时，但我必须告诉你，我已经不在队伍里了……";
				next;
				mes "["+strcharinfo(0)+"]";
				mes "等等，什么？";
				mes "你现在不在队伍里？为什么……？";
				emotion ET_HUK, playerattached();
				next;
				mes "[艾柳]";
				mes "这个嘛……";
				mes "猫主管太可怕了……";
				mes "我病得很重，不得不请一天假……";
				mes "就他妈一天……";
				next;
				mes "["+strcharinfo(0)+"]";
				mes "然后呢……？";
				next;
				mes "[艾柳]";
				mes "然后猫主管对我大发雷霆！";
				next;
				mes "["+strcharinfo(0)+"]";
				mes "嗯，听起来很辛苦。";
				next;
				mes "["+strcharinfo(0)+"]";
				mes "‘猫咪玩家’又失去了一名优秀玩家。";
				mes "听说你不在队伍里了，我很遗憾。";
				mes "看来采访到此结束。";
				next;
				mes "["+strcharinfo(0)+"]";
				mes "因为这篇文章只采访现役玩家。";
				next;
				mes "[艾柳]";
				mes "哦……";
				mes "抱歉浪费了你的时间。";
				emotion ET_SORRY;
				next;
				mes "["+strcharinfo(0)+"]";
				mes "哦，别担心。";
				mes "该说抱歉的是我，占用了你宝贵的时间。";
				mes "祝你今天愉快。";
				next;
				mes "你发现了艾柳离开队伍的原因。";
				mes "去找其他猫吧。";
				setquest 5062;
				completequest 5062;
				break;
			case 3:
				mes "[艾柳]";
				mes "是的，我是艾柳！你想要什么，喵～";
				break;
			}
			close2;
		} else if (checkquest(5062) == 2) {
				mes "[艾柳]";
			mes "你不是杂志记者吗？";
			mes "你怎么又来了……？";
			next;
			mes "["+strcharinfo(0)+"]";
			mes "啊！";
			mes "抱歉，我本来想采访另一只猫……";
			mes "结果不小心回到了你这里。";
			mes "对不起。";
			emotion ET_SORRY, playerattached();
			next;
			mes "[艾柳]";
			mes "啊……我明白了。保重。";
			close2;
		} else {
			mes "[艾柳]";
			mes "无法完成。请联系管理员。";
			close2;
		}
	} else if (checkquest(5083) == 0 || checkquest(5083) == 1) {
			mes "[艾柳]";
		mes "你是谁？";
		next;
		mes "你想说什么？";
		next;
		input .@inputstr$;
		if (.@inputstr$ == "Come back") {
			erasequest 5083;
			setquest 5084;
			set .@str$, "You've delivered the message, so let's get away.";
		} else
			set .@str$, "You didn't deliver the right message, but let's still get away.";
		mes "[艾柳]";
		mes "这是什么？你说‘"+.@inputstr$+"’是什么意思……？";
		mes "啊……你不是记者吗？";
		emotion ET_FRET;
		next;
		mes "["+strcharinfo(0)+"]";
		mes "嗯……那是谁……？";
		next;
		mes "艾柳似乎认出了你。";
		mes .@str$;
		close2;
	} else if (checkquest(5084) == 0 || checkquest(5084) == 1) {
		mes "[艾柳]";
		mes "我觉得你就是记者……";
		mes "嘿～站住～";
		next;
		mes "被发现了。我们快走。";
		close2;
	} else {
		if (malang_gamer < 6) {
			mes "[艾柳]";
			mes "该死的‘猫咪玩家’！";
			mes "我再也不回去了……你是谁？";
			next;
			mes "这只猫可能会打你。我们快走。";
			close2;
		} else {
			mes "[艾柳]";
		mes "你不是记者吗？";
			emotion ET_QUESTION;
			next;
			mes "["+strcharinfo(0)+"]";
		mes "嗯……那是谁……？";
			next;
		mes "艾柳似乎认出了你。我们快走。";
			close2;
		}
	}
	donpcevent "Eryu#gamer::OnDisable";
	end;
OnEnable:
	enablenpc "Eryu#gamer";
	disablenpc "Stew#gamer";
	disablenpc "Ketchup#gamer";
	disablenpc "Eff#gamer";
	end;
OnDisable:
	switch(rand(3)) {
	case 0:
		donpcevent "Stew#gamer::OnEnable";
		break;
	case 1:
		donpcevent "Ketchup#gamer::OnEnable";
		break;
	case 2:
		donpcevent "Eff#gamer::OnEnable";
		break;
	}
	end;
}


izlude,146,205,7	script	Talkative Adventurer#iz	4_M_KID1,{
	end;

OnTimer69000:
		npctalk "健谈的冒险者：你可以从商人那里购买药水。";
	end;

OnTimer77000:
		npctalk "健谈的冒险者：小地图上有药水图标。";
	end;

OnTimer131000:
		npctalk "健谈的冒险者：有没有方便使用物品的方法？";
	end;

OnTimer141000:
		npctalk "健谈的冒险者：快捷栏？屏幕顶部的格子？该怎么用？";
	end;

OnTimer149000:
		npctalk "健谈的冒险者：物品栏是指‘物品’菜单吗？哦，原来如此！";
	end;

OnTimer217000:
		npctalk "健谈的冒险者：我有一大堆药水？";
	end;

OnTimer281000:
		npctalk "健谈的冒险者：什么？！我现在应该去学院！";
	end;

OnTimer279000:
		npctalk "健谈的冒险者：伊兹鲁德在哪里？在中央吗？";
	end;

OnTimer339000:
		npctalk "健谈的冒险者：我不知道该做什么。";
	end;

OnTimer349000:
		npctalk "健谈的冒险者：哦，是吗？我想知道很多事情~ 我跟你一起去！";
	end;

OnTimer411000:
		npctalk "健谈的冒险者：导航，那是什么？";
	end;

OnTimer421000:
		npctalk "健谈的冒险者：哦！我应该去找卡普拉员工吗？";
	end;

OnTimer487000:

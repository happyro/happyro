	end;

OnTimer557000:
		npctalk "健谈的冒险者：哦，你真聪明……";
	end;

OnTimer555000:
		npctalk "健谈的冒险者：刚才有个初心者对我说‘嘿，健谈的冒险者’。哈哈哈。";
	end;

OnTimer565000:
OnInit:
	initnpctimer;
	end;
}


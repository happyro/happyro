			mes "告诉他我希望他多花些时间在家。哦，你为什么不去和 Liana 谈谈？她一直等着告诉你一些事。";
			delitem 7278,1; //Wellbeing_Letter
			set sign_q,sign_q+4;
			close;
		}
		else {
		mes "Liana 的爸爸需要更常回家。^333333*叹气*^000000 虽然他长期在外，但我想这也是为了大家好……";
			close2;
			emotion ET_THINK;
			end;
		}
	}
	else if (sign_q < 67) {
		mes "你最近怎么样？你最近怎么样？和往常一样，Liana 想念爸爸，但也没办法……";
		next;
		mes "我也许不是专家，但我确定丈夫是世界上最好的铁匠！你知道霍尔格雷恩和阿拉甘曾是他的学徒吗？呵呵呵~";
		close;
	}
	else {
		mes "试着珍惜你的家人，尤其是在艰难时期。即使对他们生气，也要多一些理解。我知道这很难……";
		close;
	}
}

geffen_in,171,42,3	script	Cute Girl	703,{
	callfunc "F_UpdateSignVars";
	if (checkweight(908,200) == 0) {
		mes "^3355FF等一下！你现在携带的物品太多。腾出物品栏空间后再回来。^000000";
		close;
	}
	mes "[Liana]";
	if (sign_q < 54) {
		mes "*撅嘴* 爸爸什么时候回家？！我……我好想他~ *哭泣*";
		emotion ET_CRY;
		close;
	}
	else if (sign_q == 54) {
		mes "妈妈说今天要给我做好吃的。我想知道她会做什么？希望又是腌白菜！";
		emotion ET_SMILE;
		close;
	}
	else if (sign_q == 55) {
		mes "大家都说爸爸是全世界最好的铁匠！不过现在他让学徒工作，自己到世界各地寻找稀有矿石~很神奇吧？";
		next;
		switch(select("顺便问，你在画什么？:学徒？")) {
		case 1:
			mes "[Liana]";
			mes "哦，这个？这是给爸爸的信。妈妈说有个"+((Sex == SEX_MALE)?"人":"女士")+"要去找爸爸，所以我写好让"+((Sex == SEX_MALE)?"他":"她")+"带给他~";
			close;
		case 2:
			mes "[Liana]";
			mes "是的，霍尔格雷恩叔叔和阿拉甘有时会来，我们一起玩。不过见到爸爸更开心，虽然他还没回来。^333333*撅嘴*^000000";
			next;
			switch(select("你不想爸爸吗？:他也很想你。")) {
			case 1:
				mes "[Liana]";
				mes "我好想他！^333333*哭泣*^000000但妈妈总说他太忙。^333333*撅嘴*^000000";
				close;
			case 2:
				mes "[Liana]";
				mes "希望如此……但我讨厌他没时间回家见我。所以~~~~~我写了这封信！";
				emotion ET_THINK;
				next;
				switch(select("....:I'll bring this to him.")) {
				case 1:
					mes "[Brenda Howard]";
				mes "Liana~ 这位好心的"+((Sex == SEX_MALE)?"先生":"女士")+"要去找你爸爸。你不如请"+((Sex == SEX_MALE)?"他":"她")+"帮你把信带给爸爸？";
					next;
					mes "[Liana]";
				mes "你是……？真的吗，真的吗？太、太好了！";
					next;
					mes "[Liana]";
				mes "好吧，别忘了把这个交给爸爸，好吗？保证？";
					emotion ET_DELIGHT;
					set sign_q,56;
					getitem 7276,1; //Picture_Letter
					close;
				case 2:
					mes "[Liana]";
				mes "嗯……但我不认识你！妈妈说不能向陌生人要东西。";
					close;
				}
			}
		}
	}
	else if (sign_q < 62) {
		if (rand(1,10) < 6) {
		mes "爸爸从没弄坏客人交给他的东西。霍尔格雷恩叔叔和阿拉甘也不会让这种事发生，对吧？";
			close;
		}
		else {
		mes "请把我的信带给爸爸好吗？嘿嘿，他听到我的消息一定会很开心！";
			close;
		}
	}
	else if (sign_q < 66) {
		mes "好耶~！谢谢你把信带给爸爸。来，给你！";
		mes "你得和我分享宝藏，好吗？";
		set sign_q,sign_q+4;
		getitem 529,10; //Candy
		close;
	}
	else {
		mes "我从没见爸爸升级武器或盔甲失败过。嗯？不过，如果他有某件非常古老、稀有又特别的东西……";
		close;
	}
}

mjo_dun02,88,295,4	script	Flaming Spirit Man	85,{
	callfunc "F_UpdateSignVars";
	if (checkweight(908,200) == 0) {
		mes "^3355FF等一下！你现在携带的物品太多。清理出更多物品栏空间后再回来。^000000";
		close;
	}
	mes "[Engel]";
	if ((sign_q > 1) && (sign_q < 54)) {
		if(countitem(1002) > 0) {
			mes "正如我怀疑的……我带来的材料不够。嗯，这很严重。我该怎么办？";
			next;
			mes "[Engel]";
			mes "太好了！我看你带着铁矿石。能否借给我 1 个铁矿石？求你了……";
			next;
			switch(select("好啊，为什么不呢？:抱歉，我不能。")) {
			case 1:
				mes "[Engel]";
				mes "非常感谢！要不是你帮忙，我就麻烦了。真的很感激你主动拿出材料帮助我。";
				delitem 1002,1; //Iron_Ore
				getexp 10,0;
				close;
			case 2:
				mes "[Engel]";
				mes "我想我能理解。不过你很幸运，我没有现在就把你踢出我的熔炉~";
				close2;
				emotion ET_HNG;
				end;
			}
		}
		else {
			mes "希望你理解，这座熔炉不对公众开放。我正在进行强化训练，所以请现在离开。";
			emotion ET_HNG;
			close2;
			warp "mjo_dun02",372,346;
			end;
		}
	}
	else if (sign_q < 56) {
		mes "希望你理解，这座熔炉不对公众开放。我正在进行强化训练，所以请现在离开。";
		close2;
		emotion ET_HNG;
		end;
	}
	else if (sign_q == 56) {
		if (countitem(7276) > 0) {
		mes "^333333*叹气*^000000 我已经很久没见家人了。迟早该让他们知道我过得怎么样。嗯……";
			next;
			mes "[Engel]";
			mes "……？你在找我吗？抱歉，我现在很忙。请别打扰我工作。";
			next;
			switch(select("我需要你的帮助。:这是给你的信。:我要走了。")) {
			case 1:
				mes "[Engel]";
				mes "我很想帮你，但现在不方便。外面有很多优秀铁匠能帮你。再见。";
				close;
			case 2:
				mes "[Engel]";
				mes "哦，你是认真的吗？让我先读读。";
				next;
				mes "[Engel]";
				mes "是，是。……哈哈哈！听到我亲爱的女儿的消息真好。";
				next;
				mes "[Engel]";
				mes "谢谢你替我送信，我真的很感激。现在有什么想问我的吗？如果不是大忙，我应该能帮你。";
				next;
				switch(select("请看看这个。")) {
				case 1:
					mes "[Engel]";
					mes "哦？这不是……？我明白了，我明白了！";
					next;
					mes "[Engel]";
					mes "很久以前，我的老主人告诉我，有些奇怪的矿石从天而降。其中最美丽神秘的，就像星星一样闪耀。";
					next;
					mes "[Engel]";
					mes "多数人称它为哭泣星光，但我的主人称它为神之泪滴。";
					next;
					mes "[Engel]";
					mes "不过这块矿石已经碎成许多片。从边缘的平滑程度看，一定是内部力量让它碎裂。你想让我把它重新组合，对吧？";
					next;
					mes "[Engel]";
					mes "这对我来说是个好挑战！不过修复这种矿石需要特殊工具和材料。现在请带来以下东西……";
					next;
					mes "[Engel]";
					mes "^FF00005 Mini Furnace^000000,";
					mes "^FF00002 Oridecon Hammer^000000,";
					mes "和^ff00001 把高品质铁砧^000000。记住，普通铁砧无法胜任这种工作。";
					next;
					mes "[Engel]";
					mes "神之金属铁砧最适合这项工作。我以前有一把，但不久前送给别人了。总之，我会在这里等你收集齐所需物品。";
					next;
					mes "[Engel]";
					mes "好。我带你走一条通往矿井出口的捷径，以防你不知道怎么出去。祝你好运~";
					delitem 7276,1; //Picture_Letter
					delitem 7177,7; //Part_Of_Star's_Sob
					set sign_q,57;
					close2;
					warp "mjo_dun02",371,344;
					end;
				}
			case 3:
				mes "[Engel]";
		mes "好吧。那么保重。";
				close;
			}
		}
		else {
		mes "^333333*叹气*^000000 我已经很久没见家人了。迟早该让他们知道我过得怎么样。嗯……";
			next;
			mes "[Engel]";
		mes "……？你找我有事吗？抱歉，我现在很忙。请让我安静研究。";
			close;
		}
	}
	else if (sign_q == 57) {
		mes "正如我之前说的，使用更高品质的铁砧，我的工作成功率会更高。让我看看你带来了什么……";
		next;
		if ((countitem(612) > 4) && (countitem(615) > 1) && ((countitem(986) > 0) || (countitem(987) > 0) || (countitem(988) > 0) || (countitem(989) > 0))) {
			mes "[Engel]";
			if (countitem(986) > 0) {
				mes "啊……普通铁砧？好吧，我试试看。但不能保证成功。";
				set .@anvil,0;
			}
			else if (countitem(987) > 0) {
				mes "啊……奥里德原铁砧。这个不算太差，但失败风险仍然很高。";
				set .@anvil,1;
			}
			else if (countitem(988) > 0) {
			mes "啊……黄金铁砧。这也许能完成工作。可能要花些时间，所以我有件事想请你做。";
				set .@anvil,2;
			}
			else if (countitem(989) > 0) {
			mes "哇，神之金属铁砧！看起来像是我亲手做的。太好了，只要不犯关键错误，我应该能完成~";
				set .@anvil,3;
			}
			next;
			mes "[Engel]";
			mes "我工作期间，你能替我把信送给家人吗？抱歉，就把这当作我免除修复哭泣星光费用的交换。";
			next;
			mes "[Engel]";
			mes "那么……祝你旅途平安。";
			delitem 612,5; //Portable_Furnace
			delitem 615,2; //Oridecon_Hammer
			delitem (986+.@anvil),1; //Anvil-Oridecon_Anvil-Golden_Anvil-Emperium_Anvil
			set sign_q, (58+.@anvil);
			getitem 7278,1; //Wellbeing_Letter
			close;
		}
		else {
			if (rand(1,6) == 3) {
				mes "[Engel]";
				mes "哦，你还没准备齐？慢慢来，只要没忘记需要带什么就好。你记得吧？";
				next;
				mes "[Engel]";
				mes "^FF00005 Mini Furnace^000000,";
				mes "^FF00002 Oridecon Hammer^000000,";
				mes "和^ff00001 把高品质铁砧^000000。你只需要这些！";
				next;
				mes "[Engel]";
				mes "记住，使用更高品质的铁砧，修复哭泣星光的成功率更高。否则……";
				close;
			}
			else {
				mes "[Engel]";
				mes "还没准备齐？没关系，慢慢来。只要别忘了所需的一切。你身上有这么重要的矿石，怎么会忘呢？";
				close;
			}
		}
	}
	else if (sign_q < 66) {
			mes "你这么快就回来了？抱歉，我还没完成。还要一阵子，你为什么不先把信送给我的家人？";
		close;
	}
	else if (sign_q < 70) {
		if ((sign_q == 66 && rand(1,100) < 38) || (sign_q == 67 && rand(1,100) < 67) || (sign_q == 68 && rand(1,100) < 91) || (sign_q== 69)) {
			mes "你回来了吗？你离开期间，我成功修复了哭泣星光。来看看吧？";
			next;
			set sign_q,71;
			getitem 7178,1; //Star's_Sob
			specialeffect2 EF_YUFITELHIT;
			next;
			mes "[Engel]";
			mes "这是我做过最困难的工作之一。但看！碎片状态时很美，现在更是耀眼夺目！我的努力完全值得。";
			next;
			mes "[Engel]";
			mes "无论如何，我努力把它做好了，希望你珍惜这块哭泣星光，年轻的冒险者。";
			close;
		}
		else switch(sign_q) {
			case 66:
			case 67:
			mes "你回来了？嗯，我不知道该怎么说，但听到后别误会……";
				emotion ET_PROFUSELY_SWEAT;
				next;
				mes "[Engel]";
			mes "^333333*咳咳*^000000 正如我警告过的，这次修复哭泣星光失败了，因为你给我的铁砧不够好。很抱歉。";
				next;
				mes "[Engel]";
			mes "不过我只是弄坏了工具，矿石碎片仍然完好。你再带一次工具来，我可以再试一次。";
				next;
				mes "[Engel]";
			mes "既然我更熟悉这种材料，这次不会花太久。再告诉你一次需要带来的东西……";
				next;
				mes "[Engel]";
				mes "^FF00005 Mini Furnace^000000,";
				mes "^FF00002 个奥里德原锤^000000和^ff00001 把高品质铁砧^000000。";
			mes "这次带一把更好的铁砧，明白吗？";
				next;
				mes "[Engel]";
			mes "虽然有神之金属铁砧最好，但使用黄金铁砧应该也没问题。";
				set sign_q,70;
				close;
			case 68:
			mes "哦，很好，你回来了。我有坏消息，请别反应过度~嗯，你准备好了吗？";
				emotion ET_PROFUSELY_SWEAT;
				next;
				mes "[Engel]";
			mes "我试图修复哭泣星光时突然遭到怪物袭击。要是我更注意周围环境就好了……";
				next;
				mes "[Engel]";
			mes "请理解，我会全神贯注于锻造工作。如果你不介意，我会再试一次，你带来和上次一样的所有工具。";
				next;
				mes "[Engel]";
				mes "^FF00005 Mini Furnace^000000 and";
				mes "^FF00002 Oridecon Hammer^000000.";
				mes "别忘了^FF0000黄金铁砧^000000！不过如果能找到，^FF0000神之金属铁砧^000000会更好。";
				set sign_q,70;
				close;
		}
	}
	else if (sign_q == 70) {
		if ((countitem(612) > 4) && (countitem(615) > 1) && ((countitem(986) > 0) || (countitem(987) > 0) || (countitem(988) > 0) || (countitem(989) > 0))) {
			if ((countitem(986) > 0) || (countitem(987) > 0)) {
			mes "我不是告诉过你带黄金铁砧或神之金属铁砧吗？更差的铁砧无法修复哭泣星光。";
				next;
				mes "[Engel]";
			mes "下次来时带黄金或神之金属铁砧，并把其他铁砧放在卡普拉仓库之类的地方，明白吗？";
				close;
			}
			else if (countitem(988) > 0) {
			mes "很好，很好。你带来了黄金铁砧。现在我可以马上开始！不过我有点担心怪物再次出现，你能帮忙留意吗？";
			}
			else if (countitem(989) > 0) {
			mes "太好了！你带来了神之金属铁砧！我修复矿石碎片时请留意怪物。不能让那些野兽再次破坏我的工作，对吧？谢谢。";
			}
			next;
			mes "^3355FF*Clink*";
			mes "*Clink Clink Clink*";
			mes "*Clink Clink Clink*";
			mes "*Cliiiiiiiiiiiiink*^000000";
			next;
			specialeffect EF_REPAIRWEAPON;
			next;
			mes "^3355FF*Clink*";
			mes "*Clink-Clink*";
			mes "*Clink-Clink-Clink*";
			mes "*Claaaaaaaaaaack*^000000";
			next;
			specialeffect EF_REPAIRWEAPON;
			next;
			mes "[Engel]";
			mes "快完成了。再耐心等一会儿……";
			next;
			specialeffect EF_REPAIRWEAPON;
			next;
			mes "^3355FF*Tink Tink*^000000";
			mes " ";
			mes "...*Tonk*^000000";
			next;
			specialeffect EF_REPAIRWEAPON;
			next;
			specialeffect EF_FLASHER;
			next;
			mes "[Engel]";
			mes "终于……完成了。^333333*呼！*^000000 这是我做过最难的工作之一，但我们的努力非常值得。看看这块哭泣星光多么耀眼！";
			next;
			mes "[Engel]";
			mes "我们都为此付出了很多，希望你珍惜哭泣星光。祝你冒险顺利……";
			if (countitem(988) > 0) delitem 988,1; //Golden_Anvil
			else if (countitem(989) > 0) delitem 989,1; //Emperium_Anvil
			set sign_q,71;
			getitem 7178,1; //Star's_Sob
			specialeffect2 EF_YUFITELHIT;
			close;
		}
		else {
			if (rand(1,6) == 3) {

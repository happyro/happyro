prt_q,249,82,2	script	Han#a1	8W_SOLDIER,{
	mes "[Han]";
	mes "一定有大量魔物";
	mes "正在攻击普隆德拉中心。";
	mes "***";
	next;
	mes "[Han]";
	mes "我的家人……我的朋友……";
	mes "他们都在那里……";
	mes "我必须保护他们……";
	mes "但是……我在这里还有更重要的";
	mes "工作要做……";
	next;
	mes "[Han]";
	mes "我，科学家Doyeon，能做到。";
	mes "我可以摧毁那个肮脏的源头，";
	mes "那个不断生成魔物的地方……";
	mes "所以我才保护他。";
	mes "***";
	next;
	mes "[Han]";
	mes "保护他并摧毁这座要塞";
	mes "最终就是在保护我的家人";
	mes "和朋友。";
	close;
}

prt_q,252,79,4	script	Doek#a1	8W_SOLDIER,{
	mes "[Doek]";
	mes "你眼前的这位科学家";
	mes "真的能保护普隆德拉吗？";
	mes "她能做到吗？";
	mes "你相信她吗？";
	next;
	mes "[Doek]";
	mes "老实说，我不信……";
	mes "但是……";
	next;
	mes "[Doek]";
	mes "我所有爱的人都被……";
	mes "……那些魔物……";
	next;
	mes "[Doek]";
	mes "这是我最后的希望……";
	mes "最后的希望。";
	mes "所以请帮助我。";
	mes "帮助Doyeon……";
	next;
	mes "- 之后，她沉默了 -";
	mes "- 很长一段时间。 -";
	close;
}

prt_q,249,79,4	script	Scientist Doyeon#a1	4_M_MAYOR,{
	if (!checkweight(2104,2)) {
		mes "- 物品太多，";
		mes "无法继续对话。 -";
		close;
	}
	if (BaseLevel < 145) {
		mes "- 你应该达到145级或更高";
		mes "才能继续。 -";
		close;
	}
	switch( checkquest(9419,PLAYTIME) ) {
	case -1:
		if (is_party_leader() == false) {
			callsub S_Info;
			close;
		}
		if (isbegin_quest(9418) == 0) {// first entrance
			.@party_name$ = getpartyname(getcharid(1));
			mes "[Scientist Doyeon]";
			mes "我是生活在普隆德拉的科学家。";
			mes "只是一个教孩子、做研究的普通科学家。";
			mes "然而……普隆德拉突然发生了……";
			while(true) {
				next;
				switch( select( "About Sky Fortress", "Enter the Sky Fortress.", "End the dialogue." ) ) {
				case 1:
					callsub S_Info;
					break;
				case 2:
					mes "[Scientist Doyeon]";
					mes "我想我可以用辛苦收集的魔力，";
					mes "至少打开一次";
					mes "传送门。";
					mes "希望你能帮助我";
					mes "摧毁要塞，";
					mes "夺回我们的普隆德拉。";
					next;
					if (select( "No", "Yes" ) == 1) {
						mes "[Scientist Doyeon]";
					mes "改变主意后";
					mes "再回来吧……";
					mes "但要知道时间不多了……";
						break;
					}
					mes "[Scientist Doyeon]";
					mes "好了！我打开了通往天空要塞的传送门！";
					mes "传送门只会在有限时间内启动。快进去！";
					if (instance_create("Sky Fortress Invasion") < 0) {
						mes "队伍名称：" + .@party_name$;
						mes "队长：" + strcharinfo(0);
						mes "^0000ffSky Fortress Invasion ^000000- Reservation Failed!";
						close;
					}
					close;
				case 3:
					mes "[Scientist Doyeon]";
				mes "我很担心";
				mes "普隆德拉的未来……";
				mes "看来这座要塞";
				mes "一定是一切邪恶的源头……";
					close;
				}
			}
		}
		mes "你平安回来了。";
		mes "那么……里面";
		mes "发生了什么？";
		next;
		mes "- 我把天空要塞里发生的一切";
		mes "都告诉了她。 -";
		next;
		mes "[Scientist Doyeon]";
		mes "怎么会这样……";
		mes "不过，我认为我们仍然有理由抱持希望，";
		mes "消灭天空要塞里的";
		mes "巨大魔像。";
		next;
		mes "[Scientist Doyeon]";
		mes "但是，那些肮脏的魔物";
		mes "仍在普隆德拉不断生成。";
		mes "所以我认为我们做的";
		mes "还不够。";
		mes "***";
		next;
		mes "[Scientist Doyeon]";
		mes "要启动传送门，";
		mes "需要大量魔力。";
		mes "把名为‘地下城通行证’的物品带给我，";
		mes "否则我需要大约";
		mes "三天来收集魔力。";
		next;
		mes "[Scientist Doyeon]";
		mes "希望你能进入天空要塞，";
		mes "帮助我们拯救";
		mes "普隆德拉。";
		completequest 9418;// Attack Sky Fortress Invading Prontera
		setquest 9419;// Attack Sky Fortress Invading Prontera
		if (isbegin_quest(9427) == 0) {
			setquest 9427;// Clearing the Sky Fortress for the Same Time
			completequest 9427;
			rentitem 14505,3600;// Sky Fortress Ticket
		}
		close;
	case 0:
	case 1:
		mes "[Scientist Doyeon]";
		mes "要启动传送门，需要大量魔力。";
		mes "把名为‘地下城通行证’的物品带给我，";
		mes "否则我需要大约三天来收集魔力。";
		next;
		if (is_party_leader() == true) {
			.@party_name$ = getpartyname(getcharid(1));
			if (select( "End the dialogue.", "Show the -Dungeon Pass-." ) == 2) {
				if (rentalcountitem(14505) < 1 && rentalcountitem(14506) < 1) {// Sky Fortress Ticket
					mes "[Scientist Doyeon]";
		mes "没有‘地下城通行证’，";
		mes "我想这行不通。";
		mes "没有它我无法打开传送门。";
					close;
				}
				mes "[Scientist Doyeon]";
		mes "哦！你从哪里";
		mes "得到‘地下城通行证’的？";
		mes "有了这个物品，";
		mes "我基本就能打开传送门。";
				next;
				if (select( "End the dialogue.", "Activate the warp." ) == 1) {
					mes "[Scientist Doyeon]";
		mes "你不打算";
		mes "帮助普隆德拉吗？";
					close;
				}
				mes "[Scientist Doyeon]";
				mes "好了！我打开了通往";
				mes "天空要塞的传送门！";
				mes "传送门只会在";
				mes "有限时间内启动。";
				mes "快进去！";
				if (instance_create("Sky Fortress Invasion") < 0) {
					mes "队伍名称：" + .@party_name$;
					mes "队长：" + strcharinfo(0);
					mes "^0000ffSky Fortress Invasion ^000000- Reservation Failed!";
					close;
				}
				close;
			}
		}
		mes "[Scientist Doyeon]";
		mes "希望你能进入天空要塞，帮助我们拯救普隆德拉。";
		close;
	case 2:
		mes "[Scientist Doyeon]";
		mes "你回来了！你没有逃走！";
		mes "太感谢了！";
		next;
		mes "[Scientist Doyeon]";
		mes "但是……";
		mes "大量不死魔物不断从";
		mes "我身后的那个入口涌出，";
		mes "就像树液魔物吐出树液一样。";
		mes "无论杀死多少，";
		mes "它们仍然不断出现。";
		next;
		mes "[Scientist Doyeon]";
		mes "我想这些魔物是在要塞内部生成的。";
		mes "我猜只要击败要塞里的首领，";
		mes "魔物就会消失，";
		mes "普隆德拉也会恢复稳定。";
		mes "***";
		next;
		mes "[Scientist Doyeon]";
		mes "我想我可以用辛苦收集的魔力，至少打开一次传送门。";
		mes "希望你能帮助我摧毁要塞，夺回我们的普隆德拉。";
		if (is_party_leader() == true) {
			.@party_name$ = getpartyname(getcharid(1));
			next;
			if (select( "No", "Yes" ) == 1) {
				mes "[Scientist Doyeon]";
			mes "改变主意后再回来吧……";
			mes "但要知道时间不多了……";
				close;
			}
			mes "[Scientist Doyeon]";
			mes "好了！我打开了通往天空要塞的传送门！";
			mes "传送门只会在有限时间内启动。快进去！";
			if (instance_create("Sky Fortress Invasion") < 0) {
				mes "队伍名称：" + .@party_name$;
				mes "队长：" + strcharinfo(0);
				mes "^0000ffSky Fortress Invasion ^000000- Reservation Failed!";
				close;
			}
		}
		close;
	}
	end;

S_Info:
	mes "[Scientist Doyeon]";
	mes "我是生活在普隆德拉的科学家。";
	mes "只是一个教孩子、做研究的普通科学家。";
	next;
	mes "[Scientist Doyeon]";
	mes "但是现在……至少我熟悉的生活";
	mes "已经支离破碎。";
	next;
	mes "[Scientist Doyeon]";
	mes "多亏了这座像巨大垃圾桶一样的要塞，";
	mes "我们的村庄变成了";
	mes "连腐烂都不会的垃圾堆。";
	next;
	mes "[Scientist Doyeon]";
	mes "建筑倒塌，";
	mes "人们不断死去……";
	mes "我不禁想知道普隆德拉宫殿的贵族和士兵";
	mes "在这种情况下都在做什么。";
	next;
	mes "[Scientist Doyeon]";
	mes "大量不死魔物不断从我身后的入口涌出，";
	mes "就像树液魔物吐出树液一样。";
	mes "无论杀死多少，它们仍然不断出现。";
	next;
	mes "[Scientist Doyeon]";
	mes "我想这些魔物是在要塞内部生成的。";
	mes "我猜只要击败要塞里的首领，魔物就会消失，普隆德拉也会恢复稳定。";
	mes "***";
	next;
	mes "[Scientist Doyeon]";
	mes "所以我一直很想进入要塞，";
	mes "却找不到入口。";
	mes "我夜以继日地研究，";
	mes "终于找到了入口。";
	next;
	mes "[Scientist Doyeon]";
	mes "要进入要塞，必须启动传送门。";
	mes "为此，大量魔力";
	mes "不可或缺！";
	next;
	mes "[Scientist Doyeon]";
	mes "之后……我一直在准备传送门所需的大量魔力。";
	mes "现在，我需要一位能够摧毁要塞、";
	mes "为普隆德拉带来和平的战士。";
	return;
}

prt_q,243,75,3	script	Fortress Entry Warp Portal#1	PORTAL,{
	if (BaseLevel < 145) {
	mes "- 你应该达到145级或更高";
	mes "才能继续。 -";
		close;
	}
	if (checkquest(9419,PLAYTIME) == 2 || (checkquest(9419,PLAYTIME) == -1 && isbegin_quest(9418) != 1)) {
		setarray .@menu$[0], "Don't step into the warp.", "Step into the warp.";
		.@type = 1;
	}
	else {
	mes "- 传送门似乎无法运作。";
	mes "你似乎无法进入…… -";
		next;
		setarray .@menu$[0], "End the dialogue.", "", "Put the - Dungeon Pass - near to the warp.";
	}
	switch( select( .@menu$[0], .@menu$[1], .@menu$[2] ) ) {
	case 1:
		mes "- 传送门散发出耀眼的光芒。 -";
		close;
	case 2:
		break;
	case 3:
		if (rentalcountitem(14505) < 1 && rentalcountitem(14506) < 1) {// Sky Fortress Ticket
			mes "- 你没有-";
			mes "- 地下城通行证。-";
			close;
		}
		break;
	}
	.@md_name$ = "Sky Fortress Invasion";
	switch( instance_enter(.@md_name$) ) {
	case IE_OTHER:
		mes "发生了未知错误。";
		close;
	case IE_NOINSTANCE:
		mes "纪念地下城" + .@md_name$ + "不存在。";
		mes "队长还没有创建纪念地下城。";
		close;
	case IE_NOMEMBER:
		mes "只有队伍成员可以进入纪念地下城。";
		close;
	case IE_OK:
		mapannounce "prt_q", "" + getpartyname( getcharid(1) ) + "队伍成员" + strcharinfo(0) + "进入了" + .@md_name$ + "。", bc_map,0xFF99;
		if (.@type == 1) {
			if (isbegin_quest(9419) > 0)
				erasequest 9419;
			if (isbegin_quest(9418) > 0)
				erasequest 9418;
			setquest 9418;// Attack Sky Fortress Invading Prontera
		}
		fortress_entrance_loc = 0;	// warp back to prt_q on exit
		// warp "1@sthb",54,67;
		end;
	}
	end;

OnInit:
	while(true) {
		sleep 10000;
		specialeffect EF_ENHANCE;
	}
	end;
}

// Dali entrance
dali02,115,61,3	script	Fortress Entry Warp Portal#2	PORTAL,{
	if (BaseLevel < 145) {
		mes "- 你的等级必须达到145级或更高，";
		mes "才能继续。 -";
		close;
	}
	mes "- 传送似乎不起作用。";
	mes "你似乎无法进入。 -";
	next;
	if (select( "结束对话。", "将-地下城通行证-靠近传送门。" ) == 1) {
		mes "- 传送门正散发耀眼的光芒。-";
		close;
	}
	if (rentalcountitem(14505) < 1 && rentalcountitem(14506) < 1) {// Sky Fortress Ticket
		mes "- 你没有 -";
		mes "- 地下城通行证。 -";
		close;
	}
	.@md_name$ = "Sky Fortress Invasion";
	switch( instance_enter(.@md_name$) ) {
	case IE_OTHER:
		mes "发生了未知错误。";
		close;
	case IE_NOINSTANCE:
		mes "纪念地下城" + .@md_name$ + "不存在。";
		mes "队长还没有创建纪念地下城。";
		close;
	case IE_NOMEMBER:
		mes "只有队伍成员可以进入纪念地下城。";
		close;
	case IE_OK:
	mapannounce "prt_q", "" + getpartyname( getcharid(1) ) + "队伍成员" + strcharinfo(0) + "进入了" + .@md_name$ + "。", bc_map,0xFF99;
		// warp "1@sthb",54,67;
		fortress_entrance_loc = 1;	// warp back to dali02 on exit
		// note: no quest change when using tickets
		end;
	}
	end;

OnInit:
	while(true) {
		sleep 10000;
		specialeffect EF_ENHANCE;
	}
	end;
}


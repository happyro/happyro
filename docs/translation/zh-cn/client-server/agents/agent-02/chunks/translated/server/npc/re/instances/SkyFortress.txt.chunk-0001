	if (!checkweight(2104,2)) {
		mes "- It's full of items";
		mes "因此无法继续对话。 -";
		close;
	}
	if (BaseLevel < 145) {
		mes "- 你的等级必须达到145级或更高，";
		mes "才能继续。 -";
		close;
	}
	if (is_party_leader() == false) {
		mes "[Scientist Doyeon]";
		mes "我是生活在普隆德拉的科学家。";
		mes "只是一个教孩子、做研究的普通科学家。";
		next;
		mes "[Scientist Doyeon]";
		mes "但是现在……我平凡的生活";
		mes "已经支离破碎。";
		next;
		mes "[Scientist Doyeon]";
		mes "多亏了这座像巨大垃圾桶一样的要塞，";
		mes "我们的村庄变成了";
		mes "连腐烂都不会的垃圾堆。";
		next;
		mes "[Scientist Doyeon]";
		mes "建筑倒塌，人们不断死去……";
		mes "我不禁想知道普隆德拉宫殿的贵族和士兵在这种情况下都在做什么。";
		next;
		mes "[Scientist Doyeon]";
		mes "大量不死魔物不断从我身后的入口涌出，";
		mes "就像树液魔物吐出树液一样。";
		mes "无论杀死多少，它们仍然不断出现。";
		next;
		mes "[Scientist Doyeon]";

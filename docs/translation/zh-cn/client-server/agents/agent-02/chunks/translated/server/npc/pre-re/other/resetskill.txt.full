//===== rAthena Script =======================================
//= Hypnotist
//===== By: ==================================================
//= L0ne_W0lf
//===== Current Version: =====================================
//= 1.0
//===== Compatible With: =====================================
//= rAthena Project
//===== Description: =========================================
//= [Official Conversion]
//= Permenent first class, base level 40 and under skill resetter.
//= First Class characters and expanded classes only.
//= Baby Classes and First Class trans can't use this service.
//===== Additional Comments: =================================
//= 1.0 First version. [L0ne_W0lf]
//============================================================

prontera,146,232,4	script	Hypnotist#2	124,{
	mes "[催眠师]";
	mes "你好，冒险者。";
	mes "我是催眠师学院的成员，";
	mes "学院派我来到普隆德拉，";
	mes "为部分一转职业提供技能重置服务，";
	mes "而且价格非常优惠：完全免费！";
	next;
	mes "[催眠师]";
	mes "虽然目前我提供无限次";
	mes "技能重置，但有两个条件";
	mes "必须满足。首先，你必须";
	mes "低于^FF0000基础等级 40^000000。";
	mes "请确认你的基础等级符合要求。";
	next;
	mes "[催眠师]";
	mes "其次，你必须是";
	mes "^FF0000剑士、服事、魔法师、";
	mes "盗贼、弓箭手、商人、";
	mes "跆拳男孩、跆拳女孩、枪手或忍者^000000";
	mes "职业才符合资格。";
	mes "现在，你有什么问题吗？";
	next;
	switch(select("技能重置？:我想重置技能:没事")) {

	case 1:
		mes "[催眠师]";
		mes "技能重置可以让冒险者";
		mes "重新分配技能点，";
		mes "如果对当前技能";
		mes "感到不满意。";
		next;
		mes "[催眠师]";
		mes "进行技能重置前，";
		mes "你必须把角色携带物品的";
		mes "总重量降为 0。你可以把";
		mes "多余物品存进卡普拉仓库。";
		mes "请先整理好物品。";
		mes "这样才能继续。";
		next;
		mes "[催眠师]";
		mes "另外，如果你装备了";
		mes "^FF0000手推车^000000，也必须先卸下。";
		mes "否则催眠不会生效，";
		mes "甚至可能产生反效果……";
		mes "请务必注意。";
		close;

	case 2:
		mes "[催眠师]";
		mes "你确定要继续使用";
		mes "我的^FF0000技能重置^000000服务吗？";
		mes "请确认后再继续。";
		next;
		if (select("是:取消") == 1) {
			if (BaseLevel > 40) {
				mes "[催眠师]";
				mes "抱歉，基础等级高于 40 的";
				mes "角色不符合我提供的";
				mes "技能重置服务资格。";
				mes "请先确认你的等级。";
				close;
			}
			if ((Class > 0 && Class < 7 && Upper == 0) || (Class == Job_Gunslinger) || (Class == Job_Ninja) || (Class == Job_Taekwon)) {
				if (checkcart()) {
					mes "[催眠师]";
					mes "哦！请先卸下你的";
					mes "手推车，再继续使用";
					mes "技能重置服务。";
					mes "谢谢你的配合～";
					close;
				}
				if (Weight) {
					mes "[催眠师]";
					mes "如果你是来使用我的技能重置服务，";
					mes "请记住，在你把物品栏中";
					mes "携带物品的^FF0000重量降为 0^000000前，";
					mes "无法重置技能。";
					mes "请先整理物品。";
					mes "确认后再回来。";
					next;
					mes "[催眠师]";
					mes "不如暂时把物品";
					mes "放进卡普拉仓库？";
					mes "这样就能安全保存";
					mes "你的所有物品。";
					close;
				}
				mes "[催眠师]";
				mes "谢谢你使用我的";
				mes "技能重新分配服务。";
				mes "祝你冒险旅途";
				mes "一切顺利，冒险者。";
				mes "愿你好运。";
				ResetSkill;
				close;
			}
			mes "[催眠师]";
			mes "抱歉，你的职业";
			mes "不符合我提供的技能重置服务。";
			mes "我只能为以下职业";
			mes "提供技能重置……";
			mes "请确认你的职业。";
			mes "符合条件的职业如下。";
			next;
			mes "[催眠师]";
			mes "^FF0000剑士、服事、魔法师、";
			mes "盗贼、弓箭手、商人、";
			mes "跆拳男孩、跆拳女孩、";
			mes "枪手和忍者^000000。";
			close;
		}
		mes "[催眠师]";
		mes "谢谢你，祝你冒险好运。";
		mes "旅途请注意安全～";
		mes "下次再见。";
		close;

	case 3:
		mes "[催眠师]";
		mes "谢谢你，祝你冒险好运。";
		mes "旅途请注意安全～";
		mes "下次再见。";
		close;
	}

}

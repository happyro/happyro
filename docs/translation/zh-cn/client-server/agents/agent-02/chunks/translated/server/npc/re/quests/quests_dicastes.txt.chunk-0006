	else if (.@tut_13 == 5) {
		setquest 12152;
		setquest 12164;
		mes "[Moltuka]";
		mes "酒馆老板提出了请求……他想念年轻时吃过的红薯。他想要50个红薯。";
		next;
		mes "[Moltuka]";
		mes "他长时间离乡在外，我能理解。如果你去米德加尔特，请设法弄到它们。";
		next;
		mes "我给你安排了名为^880088家常菜的味道^000000的委托。打开^990099任务窗口^000000即可查看详情和报告对象。";
		close2;
		setquest 12152;
		setquest 12164;
		end;

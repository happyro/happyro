		next;
		mes "[Moltuka]";
		mes "看起来是他自己做的，我觉得他很可怜，所以想请你弄来20把可以在米德加尔特购买的黑色勺子。";
		next;
		mes "我给你安排了名为^880088用心的礼物^000000的委托。打开^990099任务窗口^000000即可查看详情和报告对象。";
		close2;
		setquest 12155;
		setquest 12164;
		end;
	}
	else if (.@tut_13 == 9) {
		setquest 12156;
		setquest 12164;
		mes "[Moltuka]";
		mes "大臣想要用米德加尔特水晶制成的镜子。虽然曼努坎镜子很多，但他似乎更喜欢米德加尔特的。";
		next;
		mes "[Moltuka]";
		mes "其实我有点担心，但我们‘睿智’的大臣一定有他的理由。";

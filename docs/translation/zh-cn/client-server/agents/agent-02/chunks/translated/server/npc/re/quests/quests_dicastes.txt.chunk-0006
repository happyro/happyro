}

dicastes01,175,217,5	script	Kalipo#pa0829	453,{
	if (!checkweight(1201,1)) {
		mes "你携带的物品种类太多。减少物品种类后再试。";
		close;
	}
	if ((MaxWeight - Weight) < 1000) {
		mes "物品重量太大，无法继续。减轻负重后再试。";
		close;
	}
	if (!isequipped(2782)) {
		mes "∋∀∈";
		mes "⊆⊂∬ ∀ ⊆∵∽ ⊃ ∝∑∀";
		next;
		mes "既然你什么都听不懂，我也没信心和你说话。";
		close;
	}
	if (ep13_3_invite < 6) {
		mes "即使你试图交谈，萨法也和你保持距离。看来他叫来了加尔滕守卫。该走了。";
		close;
	}
	if (BaseLevel < 100) {
		mes "[Kalipo]";
		mes "哈哈哈，许多其他冒险者也在帮忙。下次再见。";
		close;
	}
	if (checkquest(12160,PLAYTIME) == 2) {
		mes "[Kalipo]";
		mes "查看完之前的委托后";
		mes "再来找^990099狩猎部2号管理员^000000。";
		close;
	}
	else if (checkquest(12160,PLAYTIME) > -1) {
		mes "[Kalipo]";
		mes "我没有其他委托了。请向行动部的^990099狩猎部2号管理员^000000报告完成情况。";
		close;
	}
	mes "[Kalipo]";
	mes "欢迎。";
	mes "你是来接委托的吗？";
	next;
	if (select("请向我说明委托。：请给我一项委托。") == 1) {
		mes "[Kalipo]";
		mes "正如你所知，";
		mes "拉蓬特已经向你说明过，";
		mes "我每天";
		mes "只能给你一项委托。";
		next;
		mes "[Kalipo]";
		mes "当然，";
		mes "提升等级后，";
		mes "你会接到更有趣的";
		mes "委托。";
		mes "一开始的委托比较简单，";
		mes "不要因此灰心。";
		close;
	}
	mes "[Kalipo]";
	mes "我来看看";
	mes "今天收到的委托清单。";
	next;
	mes "[Kalipo]";
	mes "嗯……";
	mes "我这里正好有一项";
	mes "适合你的委托。";
	next;
	set .@tut_lv, (BaseLevel);
	set .@rand, rand(100,BaseLevel);
	if (.@rand < 109) {
		setquest 12106;
		setquest 12160;
		mes "[Kalipo]";
		mes "前往拉比内的侦察兵遭到了外表像孩子的可爱怪物攻击。";
		next;
		mes "[Kalipo]";
		mes "所以我们必须猎杀它们，而你不是拉比内人，正适合去完成这项任务。";
		next;
		mes "我给你安排了名为^990099花上的孩子^000000的委托。打开^990099任务窗口^000000即可查看详情和报告对象。";
		close;
	}
	else if (.@rand < 112) {
		setquest 12107;
		setquest 12160;
		mes "[Kalipo]";
		mes "你知道外表像孩子的捕虫堇吗？据说那种花出现了变异体。";
		next;
		mes "[Kalipo]";
		mes "它们非常暴力且具有攻击性，所以拉比内派军队去消灭它们。请前往调查并处理，别让它们扩散到整个区域。";
		next;
		mes "我给你安排了名为^990099扭曲的爱^000000的委托。打开^990099任务窗口^000000即可查看详情和报告对象。";
		close;
	}
	else if (.@rand < 116) {
		setquest 12108;
		setquest 12160;
		mes "[Kalipo]";
		mes "一些矿物采集者失踪了，肯定是捕蝇草干的。";
		next;
		mes "[Kalipo]";
		mes "捕蝇草和曼陀罗相似。我们必须采取行动，保护人们免受更多伤害。";
		next;
		mes "我给你安排了名为^990099危险植物清除^000000的委托。打开^990099任务窗口^000000即可查看详情和报告对象。";
		close;
	}
	else if (.@rand < 119) {
		setquest 12109;
		setquest 12160;
		mes "[Kalipo]";
		mes "他们发现了蜈蚣幼虫的栖息地。现在清除幼虫，就能减少成年蜈蚣。";
		next;
		mes "[Kalipo]";
		mes "你能找到并消灭它们吗？要小心周围的成年蜈蚣。";
		next;
		mes "我给你安排了名为^990099幼虫歼灭^000000的委托。打开^990099任务窗口^000000即可查看详情和报告对象。";
		close;
	}
	else if (.@rand < 124) {
		setquest 12110;
		setquest 12160;
		mes "[Kalipo]";
		mes "前往尼德霍格巢穴的矿工报告说，他们遭到了奇怪生物的攻击。";
		next;
		mes "[Kalipo]";
		mes "据说那是看起来像人形的水，但一定是邪恶的东西，不是水精灵。也许源头就在尼德霍格地下城，请前往调查。";
		next;
		mes "我给你安排了名为^990099水之恶魔^000000的委托。打开^990099任务窗口^000000即可查看详情和报告对象。";
		close;
	}
	else {
		setquest 12111;
		setquest 12160;
		mes "[Kalipo]";
		mes "塔塔丘原本是美丽且会飞的鸟。但它们定居在没有天敌的这里后，开始变得肥胖懒惰，";
		next;
		mes "[Kalipo]";
		mes "最后变成了现在这种丑陋的鸟。你会成为它们很好的天敌。";
		next;
		mes "我给你安排了名为^990099丑脸鸟^000000的委托。打开^990099任务窗口^000000即可查看详情和报告对象。";
		close;
	}
}


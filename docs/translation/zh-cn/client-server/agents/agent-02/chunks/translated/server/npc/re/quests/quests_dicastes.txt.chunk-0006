		mes "∋∀∈";
		mes "⊆⊂∬ ∀ ⊆∵∽ ⊃ ∝∑∀";
		next;
		mes "既然你什么都听不懂，我也没信心和你说话。";
		close;
	}
	if (ep13_3_invite < 6) {
		mes "即使你试图交谈，萨法也和你保持距离。看来他叫来了加尔滕守卫。该走了。";
		close;
	}
	if (BaseLevel < 80) {
		mes "[Moltuka]";
		mes "哈哈，训练得更充分后再回来吧。没有适合你的委托。";
		close;
	}
	if (checkquest(12164,PLAYTIME) == 2) {
		mes "[Moltuka]";
		mes "你见过行动部的^990099运输部2号管理员^000000吗？清除委托记录后我会给你新的委托。";
		close;
	}
	else if (checkquest(12164,PLAYTIME) != -1) {
		mes "[Moltuka]";
		mes "我现在没有委托给你。完成所有委托后，向行动部的^990099运输部2号管理员^000000报告。";
		close;
	}
	mes "[Moltuka]";
	mes "欢迎。";
	mes "你来这里有什么事？";
	next;
	if (select("请向我说明委托。：请给我一项委托。") == 1) {
		mes "[Moltuka]";
		mes "你还是去找卡里昂，让他向你说明运输部1、2号部门的情况吧。";
		next;
		mes "[Moltuka]";
		mes "因为我不擅长说话。";
		close;
	}
	mes "[Moltuka]";
	mes "委托……嗯，确实有。等一下。";
	next;
	mes "[Moltuka]";
	mes "……（翻找中）";
	next;
	mes "[Moltuka]";
	mes "…………（窸窣声）";
	next;
	set .@tut_13, rand(1,11);
	if (.@tut_13 == 1) {
		setquest 12148;
		setquest 12164;
		mes "[Moltuka]";
		mes "塔塔丘跑得太快了，要抓住它们很困难。";
		next;
		mes "[Moltuka]";
		mes "所以这里的加尔滕用怪物饲料引诱它们。据说有位专家负责这项工作，请弄来100个怪物饲料。";
		next;
		mes "我给你安排了名为^880088塔塔丘捕猎诱饵^000000的委托。打开^990099任务窗口^000000即可查看详情和报告对象。";
		close2;
		setquest 12148;
		setquest 12164;
		end;
	}
	else if (.@tut_13 == 2) {
		setquest 12149;
		setquest 12164;
		mes "[Moltuka]";
		mes "酒馆老板想要一些苹果，学习如何做好料理。";
		next;
		mes "[Moltuka]";
		mes "但我从没听说米德加尔特的冒险者喜欢他的料理。不管怎样，他说会试试，所以请给他弄100个苹果。";
		next;
		mes "我给你安排了名为^880088剑术练习^000000的委托。打开^990099任务窗口^000000即可查看详情和报告对象。";
		close2;
		setquest 12149;
		setquest 12164;
		end;
	}
	else if (.@tut_13 == 3) {
		setquest 12150;
		setquest 12164;
		mes "[Moltuka]";
		mes "这是酒馆老板的委托。他想要红色蔬菜，让料理更加丰富多彩。";
		next;
		mes "[Moltuka]";
		mes "嗯……胡萝卜，是吗？反正你们那里就是这么叫的……我其实没抱太大期待。抱歉，我刚才只是自言自语。请准备100个。";
		next;
		mes "我给你安排了名为^880088漂亮的红色蔬菜^000000的委托。打开^990099任务窗口^000000即可查看详情和报告对象。";
		close2;
		setquest 12150;
		setquest 12164;
		end;
	}
	else if (.@tut_13 == 4) {
		setquest 12151;
		setquest 12164;
		mes "[Moltuka]";
		mes "据说酒馆发生过爆炸。人们说是因为一种叫南瓜的蔬菜在火上烤得太过头。";
		next;
		mes "[Moltuka]";
		mes "因为这起事故，南瓜已经没了。所以如果你能找到100个南瓜，我会很感激。";
		next;
		mes "我给你安排了名为^880088酒馆老板的毅力^000000的委托。打开^990099任务窗口^000000即可查看详情和报告对象。";
		close2;
		setquest 12151;
		setquest 12164;
		end;

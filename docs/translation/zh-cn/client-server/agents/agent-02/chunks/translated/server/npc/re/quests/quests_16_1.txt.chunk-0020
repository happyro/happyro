prt_cas_q,153,123,3	script	Strong Guards#ep16wig01	8W_SOLDIER,{
	switch( rand(1,3) ) {
	case 1:
		emotion 25;
		mes "[Strong Guards]";
		mes "喂，那位女士！别推！";
		mes "排好队！";
		next;
		mes "[Strong Guards]";
		mes "之前有位女士因为推搡被抬出去，脚踝都摔断了！";
		mes "这都是为了你们好！";
		close;
	case 2:
		emotion ET_OHNO;
		mes "[Strong Guards]";
		mes "哈，我已经像往常一样累了。";
		mes "以前真不知道女人们这么强。";
		next;
		mes "[Strong Guards]";
		mes "我昨天才开始工作，就明白为什么以前在这里工作的人都辞职了。";
		mes "虽然身边有这么多女士，我却一点也不开心。";
		close;
	case 3:
		mes "[Strong Guards]";
		mes "如你所见，其他家族宅邸的门没有守卫。";
		mes "不过潜入维格纳宅邸、想进去见尤尔根的人太多了。现在那扇门一直有人把守。";
		close;
	}
}

prt_cas_q,153,116,1	script	Strong Guards#ep16wig02	8W_SOLDIER,{

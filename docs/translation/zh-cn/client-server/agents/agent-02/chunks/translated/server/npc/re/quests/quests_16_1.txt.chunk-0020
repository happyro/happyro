		mes "[Scarlet Jaha]";
		mes "哦！";
		mes "嗯……正因如此，王室会议结束后，乔伯格家族会暂时退隐，过一段平静的生活。";
		next;
		mes "[Scarlet Jaha]";
		mes "我真心希望凯瑟琳不再受悲伤折磨。";
		mes "所以我完全支持这个决定！";
		next;
		mes "[Scarlet Jaha]";
		mes "不过恩斯特王子不知所踪。";
		mes "他的姑姑千里迢迢赶来安慰可怜的侄子，你知道吧！";
		next;
		mes "[Scarlet Jaha]";
		mes "我姐姐说她很忙，把我赶到了宴会厅。而且我也找不到我的侄子。";
		mes "呃……";
		emotion ET_CRY;
		next;
		mes "[Scarlet Jaha]";
		mes "如果你在宴会厅遇到恩斯特，请告诉他到这边来。";
		erasequest 11404;// The Geoborgs
		setquest 11405;// The Geoborgs
		ep16_gaobs = 6;
		close;
	}
	if (ep16_gaobs >= 6 && ep16_gaobs < 13) {
		mes "[Scarlet Jaha]";
		mes "不过恩斯特王子不知所踪。";
		mes "他的姑姑千里迢迢赶来安慰可怜的侄子，你知道吧！";
		next;
		mes "[Scarlet Jaha]";
		mes "我姐姐说她很忙，把我赶到了宴会厅。而且我也找不到我的侄子。";
		mes "呃……";
		next;
		mes "[Scarlet Jaha]";
		mes "如果你在宴会厅遇到恩斯特，请告诉他到这边来。";
		close;
	}
	if (ep16_gaobs == 13) {
		if (checkweight(1119,3) == 0) {
		mes "- 你持有的物品太多了。";
		mes "请整理物品栏后再试。 -";
			close;
		}
		mes "[Scarlet Jaha]";
		mes "Oh!";
		mes "你还没找到他吗？";
		mes "要不要我去问问凯瑟琳？";
		next;
		mes "[Scarlet Jaha]";
		mes "你脸上的表情……你一定听说了人们的传言。";
		mes "肯定不是什么好故事……";
		mes "请不要太在意那些传言。";
		next;
		mes "[Scarlet Jaha]";
		mes "恩斯特一定也是为了躲避这些流言才藏起来的。";
		next;
		mes "[Scarlet Jaha]";
		mes "嗯，我想他需要休息。";
		mes "英雄，打起精神来，好好享受宴会吧！";
		next;
		mes "[Scarlet Jaha]";
		mes "让宴会这样结束真是太浪费了！";
		getexp 700000,700000;
		getitem 6919,10;// TokenOfHonor
		completequest 11412;// The Geoborgs
		ep16_gaobs = 14;
		close;
	}
	if (ep16_gaobs > 13) {
		mes "[Scarlet Jaha]";
		mes "哦，英雄！";
		mes "你玩得开心吗？";
		next;
		mes "[Scarlet Jaha]";
		mes "如果你有空，请告诉我一些冒险中的趣事。";
		mes "我已经听腻了利迪翁的挑剔。";
		close;
	}
}

prt_cas,82,240,3	script	Lidion Geoborg#ep16_1	4_M_DOCTOR,{
	if (ep16_gaobs == 4) {
		mes "[Lidion Geoborg]";
	mes "我们乔伯格家族是七大王室家族之一，也是历史上培养出国王最多的顶尖家族。";
		next;
		mes "[Lidion Geoborg]";
	mes "事实上，我们定居在卢恩·米德加尔兹的中心普隆德拉。";
		next;
		mes "[Lidion Geoborg]";
	mes "尽管特里斯坦三世国王去世后，王子们接连遭遇不幸，";
		next;
		mes "[Lidion Geoborg]";
	mes "恩斯特·乔伯格王子仍在上次王室会议中当选为最有力的候选人。这正说明乔伯格家族多么有影响力。";
		next;
		mes "[Scarlet Jaha]";
	mes "他已经放弃那个职位了。";
		next;
		mes "[Lidion Geoborg]";
	mes "什么？";
		npctalk "什么？";
		next;
		mes "[Scarlet Jaha]";
	mes "我说！";
	mes "恩斯特王子放弃了王位候选人的职位。";
		next;
		mes "[Lidion Geoborg]";
	mes "胡说八道！";
		next;
		mes "[Scarlet Jaha]";
		mes "Oh!";
	mes "你不知道吗！";
	mes "你一定和外界隔绝太久了！";
		next;
		mes "[Lidion Geoborg]";
	mes "啊啊啊！";
	mes "我不会放过这个混账……恩斯特……！";
		npctalk "啊啊啊！";
		next;
		mes "[Scarlet Jaha]";
	mes "混账？";
	mes "即使你是家族长辈，他仍然是王子。你应该对他以礼相待。";
		next;
		mes "[Lidion Geoborg]";
		mes "啊啊啊！";
		npctalk "啊啊啊！";
		erasequest 11403;// The Geoborgs
		setquest 11404;// The Geoborgs
		ep16_gaobs = 5;
		close;
	}
	if (ep16_gaobs >= 5 && ep16_gaobs <= 13) {
		mes "[Lidion Geoborg]";
		mes "啊啊啊！";
		mes "我不会放过这个混账……恩斯特……！";
		npctalk "啊啊啊！";
		next;
		mes "[Scarlet Jaha]";
		mes "混账？";
		mes "即使你是家族长辈，他仍然是王子。你应该对他以礼相待。";
		next;
		mes "[Lidion Geoborg]";
		mes "啊啊啊！";
		npctalk "啊啊啊！";
		close;
	}
	mes "[Lidion Geoborg]";
	mes "啧……";
	mes "就这样让任何人进来……宫殿的尊严已经荡然无存了。";
	close;
}


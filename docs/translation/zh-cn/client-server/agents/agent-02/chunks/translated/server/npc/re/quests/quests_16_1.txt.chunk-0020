prt_cas_q,146,121,4	script	Bachelor#ep16wig	1_M_ORIENT01,{
	emotion ET_CRY;
	mes "[Bachelor]";
	mes "这里排队的女人们真可怕。";
	mes "她们咒骂、推搡，还互相争斗……";
	next;
	mes "[" + strcharinfo(0) + "]";
	mes "那你为什么不回去？";
	next;
	emotion ET_ANGER;
	mes "[Bachelor]";
	mes "尤尔根就在门里面，你叫我回去？";
	mes "我不回去！";
	next;
	emotion ET_BIGTHROB;
	mes "[Bachelor]";
	mes "在见到他优雅而耀眼的身姿之前，我绝不离开！";
	mes "我从斐扬赶来就是为了见尤尔根！";
	close2;
	if (achievementinfo(110001, ACHIEVEINFO_COUNT5) == 0)
		achievementupdate(110001, ACHIEVEINFO_COUNT5, 1);
	end;
}

prt_cas_q,148,117,7	script	Miss#ep16wig	4_F_02,{
	mes "[Miss]";
	if (rand(2) == 0) {
		mes "尤尔根对我们一视同仁。我们应该讲求公平。";
		mes "不管是谁，快出来承认！";
		npctalk "她会出来吗？如果要自首，她就不会进去了。", "Womenfolk#ep16wig", bc_area;
		sleep2 1000;
		npctalk "为什么只有一个尤尔根……", "Gyusoo#ep16wig", bc_area;
		sleep2 1000;
		npctalk "尤尔根为什么还不从房间出来……", "Bachelorette#ep16wig", bc_area;
	}
	else {
		emotion ET_ANGER;
		mes "是谁？谁假装和凯特琳亲近，还跟她一起进去的？出来！我们约好过不能抢风头！";
		npctalk "不是我。别那样看我。", "Womenfolk#ep16wig", bc_area;
		sleep2 1000;
		npctalk "天哪！谁做了这种事？", "Gyusoo#ep16wig", bc_area;
		sleep2 1000;
		npctalk "凯特琳就是太善良了。", "Bachelorette#ep16wig", bc_area;
	}
	close2;
	if (achievementinfo(110001, ACHIEVEINFO_COUNT3) == 0)
		achievementupdate(110001, ACHIEVEINFO_COUNT3, 1);
	end;
}

prt_cas_q,148,122,4	script	Womenfolk#ep16wig	1_F_03,{
	mes "[Womenfolk]";
	if (rand(2) == 0) {
		emotion ET_FRET;
		mes "尤尔根属于我们所有人！谁也不能独占他！我不会让任何人这么做！";
		npctalk "没错！他属于我们大家！", "Miss#ep16wig", bc_area;
		sleep2 1000;
		npctalk "我也不会让它发生！", "Gyusoo#ep16wig", bc_area;
		sleep2 1000;
		npctalk "哦，我不同意你们。我很宽容。", "Bachelorette#ep16wig", bc_area;
	}
	else {
		mes "我不会让任何人独占尤尔根！天堂也许会原谅，但我不会！";
		npctalk "我也不会！", "Miss#ep16wig", bc_area;
		sleep2 1000;
		npctalk "嗯，如果是我做到了那件事，我允许。", "Gyusoo#ep16wig", bc_area;
		sleep2 1000;
		npctalk "至少天堂会原谅，这让我松了口气。", "Bachelorette#ep16wig", bc_area;
	}
	close2;
	if (achievementinfo(110001, ACHIEVEINFO_COUNT2) == 0)
		achievementupdate(110001, ACHIEVEINFO_COUNT2, 1);
	end;
}


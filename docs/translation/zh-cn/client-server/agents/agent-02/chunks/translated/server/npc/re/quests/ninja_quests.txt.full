// Armor and Weapon NPCs :: kaboro_gearmix
//============================================================
que_ng,21,72,6	script	Master Armor Craftsman	4_M_RASWORD,{
	mes "[Gyo]";
	mes "你如何定义胜利？";
	mes "击倒敌人……";
	mes "然而，最重要的是……";
	mes "永远不要让自己倒下！";
	next;
	mes "[Gyo]";
	mes "为此，你必须更好地保护自己。";
	mes "当你妨碍自己的防护时，就无法保护‘他人’。";
	next;
	if(select("合成护甲。:结束对话。") == 2) {
		mes "[Gyo]";
		mes "谨慎也是战斗中的重要美德。";
		close;
	}
	switch(select("狼臂甲[1]:新月臂甲[1]:忍者鳞甲[1]:暗影之王护甲[1]:退出。")) {
	case 1:
		mes "[Gyo]";
		mes "狼臂甲……一件野兽般的护甲。";
		next;
		callsub L_Select,2172;
		if (countitem(2171) > 0 && countitem(6252) > 9) {  //custom translation
			delitem 2171,1; //Fox_Armguard
			delitem 6252,10; //Wolf_Blood
			getitem 2172,1; //Wolf_Armguard
			mes "[Gyo]";
			mes "你感受到狼的本性了吗？";
			mes "既野性又迷人……";
			close;
		}
		break;
	case 2:
		mes "[Gyo]";
		mes "新月臂甲……美丽与力量的结合……两者缺一不可。";
		next;
		callsub L_Select,2173;
		if (countitem(2171) > 0 && countitem(7321) > 99) {  //custom translation
			delitem 2171,1; //Fox_Armguard
			delitem 7321,100; //Fragment_Of_Crystal
			getitem 2173,1; //Crescent_Armguard
			mes "[Gyo]";
			mes "真美……";
			mes "仿佛全身都溢满了魔力。";
			close;
		}
		break;
	case 3:
		mes "[Gyo]";
		mes "忍者鳞甲……据说曾有传奇忍者穿过它。";
		next;
		callsub L_Select,15054;
		if (countitem(7451) > 29 && countitem(7562) > 29 && countitem(6091) > 29) {  //custom translation
			delitem 7451,30; //Scale_Of_Red_Dragon
			delitem 7562,30; //Ice_Scale
			delitem 6091,30; //Dark_Red_Scale
			getitem 15054,1; //Ninja_Scale_Armor
			mes "[Gyo]";
			mes "这确实是传奇护甲……";
			mes "即使我并不相信传说……";
			close;
		}
		break;
	case 4:
		mes "[Gyo]";
		mes "暗影之王护甲……它是为了保护他人而制作的。";
		next;
		callsub L_Select,15055;
		if (countitem(15056) > 0 && countitem(6089) > 9) {  //custom translation
			delitem 15056,1; //Special_Ninja_Suit_
			delitem 6089,10; //Piece_Of_Darkness
			getitem 15055,1; //Tenebris_Latitantes
			mes "[Gyo]";
			mes "怎么样？";
			mes "这件护甲看起来不像有两件吗？";
			close;
		}
		break;
	case 5:
		close;
	}
	mes "[Gyo]";
	mes "你的材料不够。";
	mes "再检查一下……";
	close;

L_Select:
	.@string1$ = "检查材料。";
	.@string2$ = "检查属性。";
	while(1) {
		switch(select(.@string1$,.@string2$,"合成。","退出。")) {
		case 1:
			.@string1$ = "";
			callsub L_Ingredients, getarg(0);
			break;
		case 2:
			.@string2$ = "";
			callsub L_Stats, getarg(0);
			break;
		case 3:
			callsub L_Combine;
			return;
		case 4:
			mes "[Gyo]";
			mes "看来你需要更多时间考虑。";
			close;
		}
	}

L_Ingredients:
	mes "[Gyo]";
	switch (getarg(0)) {
	case 2172:	//Wolf_Armguard
		mes "制作^ff0000狼臂甲需要 1 个狐臂甲和 10 份狼血^000000。";
		mes "你能感受到吗？狼血正在跳动……";
		break;
	case 2173:	//Crescent_Armguard
		mes "制作^ff0000新月臂甲需要 1 个狐臂甲和 100 个水晶碎片^000000。";
		mes "上面会刻有如水晶般美丽清澈的新月。";
		break;
	case 15054:	//Ninja_Scale_Armor
		mes "制作^ff0000忍者鳞甲需要 30 个火龙鳞片、30 个冰鳞片和 30 个暗红鳞片^000000。";
		mes "你能感受到它的传奇力量。";
		break;
	case 15055:	//Tenebris_Latitantes
		mes "制作^ff0000暗影之王护甲需要带插槽的特殊忍者服和 10 个黑暗碎片^000000。";
		mes "黑暗会抹去存在本身……";
		break;
	}
	next;
	return;

L_Stats:
	mes "[" + getitemname(getarg(0)) + "]";
	switch (getarg(0)) {
	case 2172:	//Wolf_Armguard
		mes "近战攻击时有一定概率获得 5 秒 ATK+100、FLEE -50。";
		mes "盾牌类型，防御 45，插槽 1";
		mes "要求等级 100，仅限忍者类型";
		break;
	case 2173:	//Crescent_Armguard
		mes "每次精炼使技能后延迟减少 2%。";
		mes "盾牌类型，防御 70，插槽 1";
		mes "要求等级 100，仅限忍者类型";
		break;
	case 15054:	//Ninja_Scale_Armor
		mes "MHP+15%，MSP-30%";
		mes "护甲类型，防御 90，插槽 1";
		mes "要求等级 100，仅限忍者类型";
		break;
	case 15055:	//Tenebris_Latitantes
		mes "受到近战攻击时，有概率发动 1 级幻影—暗影。";
		mes "护甲类型，防御 60，插槽 1";
		mes "要求等级 100，仅限忍者类型";
		break;
	}
	next;
	return;

L_Combine:
	mes "[Gyo]";
	mes "请确认^ff0000手边有正确的材料和装备^000000。";
	mes "事后后悔也没有用。";
	next;
	switch(select("合成。:退出。")) {
	case 1:
		if (checkweight(1201,1) == 0 || MaxWeight - Weight < 2000) {
			mes "- 等一下！！ -";
			mes "- 你无法领取物品 -";
			mes "- 因为携带的物品太多。 -";
			mes "- 请减轻负重后 -";
			mes "- 再试一次。 -";
			close;
		}
		return;
	case 2:
		mes "[Gyo]";
		mes "看来你需要更多时间考虑。";
		close;
	}
	end;
}

que_ng,23,70,3	script	Master Weapon Craftsman	4_DST_SOLDIER,{
	mes "[Ki]";
	mes "进攻是最好的防御。";
	mes "强大的武器会让你真正完整。";
	next;
	mes "[Ki]";
	mes "当然，手边有特别的东西会更好。";
	next;
	if(select("合成武器。:结束对话。") == 2) {
		mes "[Ki]";
		mes "过于谨慎有时也会致命。";
		close;
	}
	switch(select("罗刹匕首[1]:三日月[1]:风魔飞花[2]:退出。")) {
	case 1:
		mes "[Ki]";
		mes "罗刹匕首只能在充分训练后使用。";
		next;
		callsub L_Select,13076;
		if (countitem(13013) > 0 && countitem(718) > 0) {  //custom translation
			delitem 13013,1; //Murasame_
			delitem 718,1; //Dark_Red_Jewel
			getitem 13076,1; //Raksasa_Dagger
			mes "[Ki]";
			mes "啊……";
			mes "多么美丽的光泽……";
			close;
		}
		mes "[Ki]";
		mes "嗯……你的材料不足以制作罗刹匕首。";
		break;
	case 2:
		mes "[Ki]";
		mes "三日月……像新月一样美丽的弧线……";
		mes "能制作它的人并不多。";
		next;
		callsub L_Select,13078;
		if (countitem(13015) > 0 && countitem(727) > 0) {  //custom translation
			delitem 13015,1; //Hakujin_
			delitem 727,1; //White_Jewel
			getitem 13078,1; //Mikatsuki
			mes "[Ki]";
			mes "真的很美……";
			mes "能看到如此华丽的匕首，我真幸运。";
			close;
		}
		mes "[Ki]";
		mes "嗯……你的材料不足以制作三日月。";
		break;
	case 3:
		mes "[Ki]";
		mes "风魔飞花……你见过花瓣飞舞吗？";
		next;
		callsub L_Select,13313;
		if (countitem(13304) > 0 && countitem(7156) > 99) {  //custom translation
			delitem 13304,1; //Huuma_Calm_Mind
			delitem 7156,100; //Broken_Shuriken
			getitem 13313,1; //Huuma_Swirling_Petal
			mes "[Ki]";
			mes "飞舞吧……花瓣！！";
			close;
		}
		mes "[Ki]";
		mes "嗯……你的材料不足以制作风魔飞花。";
		break;
	case 4:
		close;
	}
	mes "为什么不再检查一次？";
	mes "有些人就是无法放下手中的东西。";
	close;

L_Select:
	.@string1$ = "检查材料。";
	.@string2$ = "检查属性。";
	while(1) {
		switch(select(.@string1$,.@string2$,"合成。","退出。")) {
		case 1:
			.@string1$ = "";
			callsub L_Ingredients, getarg(0);
			break;
		case 2:
			.@string2$ = "";
			callsub L_Stats, getarg(0);
			break;
		case 3:
			callsub L_Combine;
			return;
		case 4:
			mes "[Ki]";
			mes "仔细考虑～～";
			close;
		}
	}

L_Ingredients:
	mes "[Ki]";
	switch (getarg(0)) {
	case 13076:	//Raksasa_Dagger
		mes "制作^ff0000罗刹匕首需要 1 把双插槽村正和 1 颗石榴石^000000。";
		mes "石榴石赋予罗刹匕首独特色泽。";
		break;
	case 13078:	//Mikatsuki
		mes "制作^ff0000三日月需要 1 把带插槽的白刃和 1 颗蛋白石^000000。";
		mes "蛋白石带来半透明的光辉。";
		break;
	case 13313:	//Huuma_Swirling_Petal
		mes "制作^ff0000风魔飞花需要 1 枚风魔平心手里剑和 100 枚破损手里剑^000000。";
		mes "看似需要太多手里剑……但这是产生美丽飞舞效果的必要材料。";
		break;
	}
	next;
	return;

L_Stats:
	mes "[" + getitemname(getarg(0)) + "]";
	switch (getarg(0)) {
	case 13076:	//Raksasa_Dagger
		mes "INT+3，MATK+100。";
		mes "匕首类型，ATK 120，插槽 1";
		mes "要求等级 110，仅限忍者类型";
		break;
	case 13078:	//Mikatsuki
		mes "MATK+120，施法波动和技能 SP 消耗降低 5%。";
		mes "匕首类型，ATK 50，武器等级 4，插槽 1";
		mes "要求等级 100，仅限忍者类型";
		break;
	case 13313:	//Huuma_Swirling_Petal
		mes "MATK+50，风魔飞花技能伤害增加 20%。";
		mes "手里剑类型，ATK 150";
		mes "武器等级 3，插槽 2";
		mes "要求等级 110，仅限忍者类型";
		break;
	}
	next;
	return;

L_Combine:
	mes "[Ki]";
	mes "请确认^ff0000手边有正确的材料和装备^000000。";
	mes "完成后无法撤销。";
	next;
	switch(select("合成。:退出。")) {
	case 1:
		if (checkweight(1201,1) == 0 || MaxWeight - Weight < 2000) {
			mes "- 等一下！！ -";
			mes "- 你无法领取物品 -";
			mes "- 因为携带的物品太多。 -";
			mes "- 请减轻负重后 -";
			mes "- 再试一次。 -";
			close;
		}
		return;
	case 2:
		mes "[Ki]";
		mes "仔细考虑～～";
		close;
	}
	end;
}

geffen,203,116,4	script	Guide#01geffen::GuideGeffen	705,{
	cutin "gef_soldier",2;
	mes "[吉芬向导]";
	mes "欢迎来到^8B4513吉芬^000000，";
	mes "魔法之城。";
	mes "需要我帮你在城里导航吗？";
	F_Navi("[吉芬向导]");
	next;
	while (1) {
		switch(select("[ 主要设施 ]:[ 商人和助手 ]:移除小地图标记:取消")) {
		case 1:
			set .@loop,1;
			while (.@loop) {
				switch(select("[ 魔法学院 ]:[ 吉芬塔 ]:[ 喷泉 ]:[ 道具店 ]:[ 购买和修理装备 ]:[ 旅馆 ]:[ 酒馆 ]:[ 克里斯托弗的锻造所 ]:上一级菜单")) {
				case 1:
					mes "[吉芬向导]";
					mes F_Navi("魔法学院","geffen,61,180","^B9062F")+"处理所有魔法相关事务，";
					mes "包括职业转职。";
					mes "让我在你的小地图上";
					mes "标记它的位置。";
					mes "还想查看其他地点吗？";
					mes "请随时查看地图。";
					viewpoint 1,61,180,0,0xFF0000;
					next;
					break;
				case 2:
					callsub L_Mark, F_Navi("Geffen Tower","geffen,120,114","^0000FF");
					viewpoint 1,120,114,1,0x0000FF;
					next;
					break;
				case 3:
					callsub L_Mark, F_Navi("Fountain","geffen,126,48","^FF5400");
					viewpoint 1,126,48,2,0xFFB400;
					next;
					break;
				case 4:
					callsub L_Mark, F_Navi("Tool Shop","geffen,44,86","^006400");
					viewpoint 1,44,86,3,0xAAFF00;
					next;
					break;
				case 5:
					mes "[吉芬向导]";
					mes "如果你想";
					mes F_Navi("购买或修理装备","geffen,99,140","^7F3300");
					mes "就应该来这里。";
					mes "让我在你的小地图上";
					mes "标记它的位置。";
					mes "还想查看其他地点吗？";
					viewpoint 1,99,140,4,0xD2691E;
					next;
					break;
				case 6:
					callsub L_Mark, F_Navi("Inn","geffen,172,174","^800080");
					viewpoint 1,172,174,5,0xDA70D6;
					next;
					break;
				case 7:
					callsub L_Mark, F_Navi("Tavern","geffen,138,138","^B9062F");
					viewpoint 1,138,138,6,0xFF0000;
					next;
					break;
				case 8:
					mes "[吉芬向导]";
					mes F_Navi("克里斯托弗的锻造所","geffen,182,59","^0000FF")+"可以";
					mes "购买精炼材料。";
					mes "这里以前是旧铁匠公会。";
					mes "如今仍然欢迎所有冒险者。";
					viewpoint 1,182,59,6,0x0000FF;
					next;
					break;
				case 9:
					set .@loop,0;
					break;
				}
			}
			break;
		case 2:
			set .@loop,1;
			while (.@loop) {
				switch(select("[ 伊甸园传送员 ]:[ 卡普拉员工 ]:[ 宠物美容师 ]:[ 厨师助手 ]:[ 次元奥术师向导 ]:上一级菜单")) {
				case 1:
					callsub L_Mark, F_Navi("伊甸园传送员","geffen,132,66","^B9062F");
					viewpoint 1,61,180,7,0xFF0000;
					viewpoint 1,132,66,8,0xFF0000;
					next;
					break;
				case 2:
					callsub L_Mark, "^FF5400卡普拉员工^000000";
					viewpoint 1,203,123,10,0xFFB400;
					viewpoint 1,120,62,11,0xFFB400;
					next;
					break;
				case 3:
					callsub L_Mark, F_Navi("宠物美容师","geffen,193,152","^006400");
					viewpoint 1,193,152,12,0xAAFF00;
					next;
					break;
				case 4:
					callsub L_Mark, F_Navi("厨师助手","geffen,196,111","^7F3300");
					viewpoint 1,196,111,13,0xD2691E;
					next;
					break;
				case 5:
					callsub L_Mark, F_Navi("次元奥术师向导","geffen,140,196","^800080");
					viewpoint 1,140,196,14,0xDA70D6;
					next;
					break;
				case 6:
					set .@loop,0;
					break;
				}
			}
			break;
		case 3:
			mes "[吉芬向导]";
			mes "好的，我会移除小地图上的所有标记。";
			mes "还有什么我能帮你的吗？";
			viewpoint 2,1,1,0,0xFFFF00;
			viewpoint 2,1,1,1,0x000000;
			viewpoint 2,1,1,2,0xFF0000;
			viewpoint 2,1,1,3,0xFFFF00;
			viewpoint 2,1,1,4,0xFFFF00;
			viewpoint 2,1,1,5,0xFFFF00;
			viewpoint 2,1,1,6,0xFFFF00;
			viewpoint 2,1,1,7,0xFFFF00;
			viewpoint 2,1,1,8,0xFFFF00;
			viewpoint 2,1,1,9,0xFFFF00;
			viewpoint 2,1,1,10,0xFFFF00;
			viewpoint 2,1,1,11,0xFFFF00;
			viewpoint 2,1,1,12,0xFFFF00;
			viewpoint 2,1,1,13,0xFFFF00;
			viewpoint 2,1,1,14,0xFFFF00;
			next;
			break;
		case 4:
			mes "[吉芬向导]";
			mes "祝你在吉芬玩得愉快。";
			close2;
			cutin "gef_soldier",255;
			end;
		}
	}
	end;
L_Mark:
	mes "[吉芬向导]";
	mes "让我在小地图上标记";
	mes getarg(0)+"^000000";
	mes "的位置。";
	mes "还想查看其他地点吗？";
	return;
}

geffen,118,62,0	duplicate(GuideGeffen)	Guide#02geffen	705
geffen,36,123,6	duplicate(GuideGeffen)	Guide#03geffen	705
geffen,123,203,4	duplicate(GuideGeffen)	Guide#04geffen	705

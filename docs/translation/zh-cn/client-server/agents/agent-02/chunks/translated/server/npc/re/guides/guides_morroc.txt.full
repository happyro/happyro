morocc,153,286,6	script	Guide#01morocc::GuideMorocc	707,{
	cutin "moc_soldier",2;
	mes "[Morocc Guide]";
	mes "欢迎来到 ^8B4513梦罗克^000000，";
	mes "沙漠之城。";
	mes "需要我帮你导航城镇吗？";
	F_Navi("[Morocc Guide]");
	next;
	while (1) {
		switch(select("[ 主要设施 ]:[ 商人和助手 ]:移除小地图标记:取消")) {
		case 1:
			set .@loop,1;
			while (.@loop) {
				switch(select("[ 盗贼公会 ]:[ 斯芬克斯地下城 ]:[ 绿洲入口 ]:[ 锻造铺 ]:[ 武器和防具商店 ]:[ 旅馆 ]:[ 酒馆 ]:上一级菜单")) {
				case 1:
					mes "[Morocc Guide]";
					mes F_Navi("盗贼公会","morocc,26,294","^B9062F")+"位于";
					mes "靠近 ^B9062F绿洲^000000 的";
					mes "^B9062F金字塔^000000 内。";
					mes "还要查看其他地点吗？";
					viewpoint 1,26,294,0,0xFF0000;
					next;
					break;
				case 2:
					mes "[Morocc Guide]";
					mes F_Navi("斯芬克斯地下城","morocc,26,164","^0000FF")+"就在";
					mes "西门外。";
					mes "还要查看其他地点吗？";
					viewpoint 1,26,164,1,0x0A82FF;
					next;
					break;
				case 3:
					mes "[Morocc Guide]";
					mes "我来在你的小地图上标记"+F_Navi("绿洲","morocc,26,294","^FF5400")+"入口。";
					mes "还要查看其他地点吗？";
					viewpoint 1,26,294,2,0xFFB400;
					next;
					break;
				case 4:
					callsub L_Mark, F_Navi("Forge","morocc,47,47","^006400");
					viewpoint 1,47,47,3,0xAAFF00;
					next;
					break;
				case 5:
					callsub L_Mark, F_Navi("Weapon & Armor Shop","morocc,253,56","^7F3300");
					viewpoint 1,253,56,4,0xD2691E;
					next;
					break;
				case 6:
					mes "[Morocc Guide]";
					mes "目前"+F_Navi("旅馆","morocc,273,269","^800080")+"已暂停营业，";
					mes "另行通知前不会开放，";
					mes "但我会在小地图上标记位置。";
					mes "还要查看其他地点吗？";
					viewpoint 1,273,269,5,0xDA70D6;
					next;
					break;
				case 7:
					callsub L_Mark, F_Navi("Tavern","morocc,52,259","^B9062F");
					viewpoint 1,52,259,6,0xFF0000;
					next;
					break;
				case 8:
					set .@loop,0;
					break;
				}
			}
			break;
		case 2:
			set .@loop,1;
			while (.@loop) {
				switch(select("[ 卡普拉员工 ]:[ 毒草商人 ]:[ 染料制作师 ]:[ Seiyablem ]:上一级菜单")) {
				case 1:
					callsub L_Mark,"^0000FFKafra Employees^000000";
					viewpoint 1,156,97,7,0x0A82FF;
					viewpoint 1,160,258,8,0x0A82FF;
					next;
					break;
				case 2:
					callsub L_Mark, F_Navi("Poison Herb Salesman","morocc,191,94","^006400");
					viewpoint 1,190,96,9,0xAAFF00;
					next;
					break;
				case 3:
					mes "[Morocc Guide]";
					mes F_Navi("染料制作师","morocc,273,269","^7F3300")+"目前";
					mes "住在";
					mes "旅馆一楼。";
					mes "我来在小地图上标记他的位置。";
					mes "还要查看其他地点吗？";
					viewpoint 1,273,269,10,0xD2691E;
					next;
					break;
				case 4:
					mes "[Morocc Guide]";
					mes F_Navi("Seiyablem","morocc,51,41","^800080");
					mes "是一名技师，";
					mes "可以为武器和防具制作^0000FF插槽^000000，";
					mes "但不是所有装备";
					mes "都能开槽。至少他是这么说的。";
					mes "还要查看其他地点吗？";
					viewpoint 1,51,41,11,0xDA70D6;
					next;
					break;
				case 5:
					set .@loop,0;
					break;
				}
			}
			break;
		case 3:
			mes "[Morocc Guide]";
			mes "好的，我会移除小地图上的所有标记。";
			mes "还有什么我能为你做的吗？";
			viewpoint 2,1,1,0,0xFFFF00;
			viewpoint 2,1,1,1,0x000000;
			viewpoint 2,1,1,2,0xFF0000;
			viewpoint 2,1,1,3,0xFFFF00;
			viewpoint 2,1,1,4,0xFFFF00;
			viewpoint 2,1,1,5,0xFFFF00;
			viewpoint 2,1,1,6,0xFFFF00;
			viewpoint 2,1,1,7,0xFFFF00;
			viewpoint 2,1,1,8,0xFFFF00;
			viewpoint 2,1,1,9,0xFFFF00;
			viewpoint 2,1,1,10,0xFFFF00;
			viewpoint 2,1,1,11,0xFFFF00;
			next;
			break;
		case 4:
			mes "[Morocc Guide]";
			mes "旅途小心。";
			close2;
			cutin "moc_soldier",255;
			end;
		}
	}
	end;
L_Mark:
	mes "[Morocc Guide]";
	mes "让我标记";
	mes getarg(0);
	mes "在你的小地图上。";
	mes "还要查看其他地点吗？";
	return;
}
morocc,154,38,6	duplicate(GuideMorocc)	Guide#02morocc	707
morocc,296,213,4	duplicate(GuideMorocc)	Guide#03morocc	707
morocc,28,170,5	duplicate(GuideMorocc)	Guide#04morocc	707

moc_ruins,159,53,3	script	Guide#01ruins::GuideMocRuins	707,{
	cutin "moc_soldier",2;
	mes "[Morocc Guide]";
	mes "欢迎来到 ^8B4513梦罗克^000000，";
	mes "沙漠之城。";
	mes "需要我帮你导航城镇吗？";
	F_Navi("[Morocc Guide]");
	next;
	while (1) {
		switch(select("[ 主要设施 ]:[ 商人和助手 ]:移除小地图标记:取消")) {
		case 1:
			set .@loop,1;
			while (.@loop) {
				switch(select("[ 盗贼公会 ]:[ 斯芬克斯地下城 ]:[ 梦罗克入口 ]:上一级菜单")) {
				case 1:
					mes "[Morocc Guide]";
					mes F_Navi("盗贼公会","moc_ruins,56,161","^B9062F")+"位于";
					mes "^B9062F金字塔^000000内。";
					mes "我来在小地图上标记其位置。";
					mes "还要查看其他地点吗？";
					viewpoint 1,56,161,0,0xFF0000;
					next;
					break;
				case 2:
					mes "[Morocc Guide]";
					mes F_Navi("斯芬克斯地下城","moc_ruins,71,19","^0000FF");
					mes "就在这个绿洲的南入口外。";
					mes "还要查看其他地点吗？";
					viewpoint 1,71,19,1,0x0A82FF;
					next;
					break;
				case 3:
					mes "[Morocc Guide]";
					mes F_Navi("Morocc","moc_ruins,158,40","^FF5400")+" is";
					mes "就在这个绿洲东南入口外。";
					mes "我来在小地图上标记其位置。";
					mes "还要查看其他地点吗？";
					viewpoint 1,158,40,2,0xFFB400;
					next;
					break;
				case 4:
					set .@loop,0;
					break;
				}
			}
			break;
		case 2:
			set .@loop,1;
			while (.@loop) {
				switch(select("[ Eden Teleport Officer ]:[ Tool Dealer ]:[ Kafra Employee ]:[ Repairman ]:[ Pet Groomer ]:[ Chef Assistant ]:[ Leablem ]:Previous Menu")) {
				case 1:
					callsub L_Mark, F_Navi("Eden Teleport Officer","moc_ruins,68,164","^006400");
					viewpoint 1,68,164,3,0xAAFF00;
					next;
					break;
				case 2:
					mes "[Morocc Guide]";
					mes "让我标记";
					mes F_Navi("Northern Tool Dealer","moc_ruins,92,128","^800080");
					mes "和"+F_Navi("南方工具商","moc_ruins,114,63","^800080")+"的位置。";
					mes "在你的小地图上。";
					mes "还要查看其他地点吗？";
					viewpoint 1,92,128,5,0xDA70D6;
					viewpoint 1,114,63,6,0xDA70D6;
					next;
					break;
				case 3:
					callsub L_Mark, "^B9062FKafra Employee^000000";
					viewpoint 1,59,157,7,0xFF0000;
					next;
					break;
				case 4:
					callsub L_Mark, F_Navi("Repairman","moc_ruins,107,94","^0000FF");
					viewpoint 1,107,94,8,0x0A82FF;
					next;
					break;
				case 5:
					callsub L_Mark, F_Navi("Pet Groomer","moc_ruins,118,170","^FF5400");
					viewpoint 1,118,170,9,0xFFB400;
					next;
					break;
				case 6:
					callsub L_Mark, F_Navi("Chef Assistant","moc_ruins,115,123","^006400");
					viewpoint 1,115,123,10,0xAAFF00;
					next;
					break;
				case 7:
					mes "[Morocc Guide]";
					mes F_Navi("Leablem","moc_ruins,154,86","^7F3300");
					mes "是一名技师，";
					mes "可以为武器和防具制作^0000FF插槽^000000，";
					mes "但不是所有装备";
					mes "都能开槽。至少他是这么说的。";
					mes "还要查看其他地点吗？";
					viewpoint 1,154,86,11,0xD2691E;
					next;
					break;
				case 8:
					set .@loop,0;
					break;
				}
			}
			break;
		case 3:
			mes "[Morocc Guide]";
			mes "好的，我会移除小地图上的所有标记。";
			mes "还有什么我能为你做的吗？";
			viewpoint 2,1,1,0,0xFFFF00;
			viewpoint 2,1,1,1,0x000000;
			viewpoint 2,1,1,2,0xFF0000;
			viewpoint 2,1,1,3,0xFFFF00;
			viewpoint 2,1,1,4,0xFFFF00;
			viewpoint 2,1,1,5,0xFFFF00;
			viewpoint 2,1,1,6,0xFFFF00;
			viewpoint 2,1,1,7,0xFFFF00;
			viewpoint 2,1,1,8,0xFFFF00;
			viewpoint 2,1,1,9,0xFFFF00;
			viewpoint 2,1,1,10,0xFFFF00;
			viewpoint 2,1,1,11,0xFFFF00;
			next;
			break;
		case 4:
			mes "[Morocc Guide]";
			mes "旅途小心。";
			close2;
			cutin "moc_soldier",255;
			end;
		}
	}
	end;
L_Mark:
	mes "[Morocc Guide]";
	mes "让我标记";
	mes getarg(0);
	mes "在你的小地图上。";
	mes "还要查看其他地点吗？";
	return;
}

}

// gef_fild02,98,226,4	script	Perishing Blessing Assistant#bl	4_FROG,{
moro_vol,1,3,4	script	Perishing Blessing Assistant#bl	4_FROG,{
	if (callfunc("F_GM_NPC",1854,0) < 1) {
		mes "咳！";
		close;
	}
	mes "[Perishing Blessing Assistant]";
	mes "你想要什么？";
	mes "大声说出来！";
	next;
	switch( select(
		"初始化任务", "火焰羽毛 15", "巡逻日志 20", "狩猎前",
		"祝福之石 40", "怪物之血 30", "最终奖励", "打开祝福之门前" ) ) {
	case 1:
		mes "[Perishing Blessing Assistant]";
		mes "完成！";
		ep14_3_fall_bless = 0;
		for ( .@i = 1264; .@i <= 1275; .@i++ ) {
			if (isbegin_quest(.@i) > 0)
				erasequest .@i;
		}
		if (isbegin_quest(1297) > 0)
			erasequest 1297;
		close;
	case 2:
		mes "[Perishing Blessing Assistant]";
		mes "完成！";
		getitem 6691,15;// BurningFeather
		close;
	case 3:
		mes "[Perishing Blessing Assistant]";
		mes "完成！";
		getitem 6692,20;// PatrolLog
		close;
	case 4:
		mes "[Perishing Blessing Assistant]";
		mes "完成！";
		setquest 1268;
		setquest 1269;
		for ( .@i = 1264; .@i <= 1267; .@i++ ) {
			if (isbegin_quest(.@i) > 0)
				erasequest .@i;
		}
		for ( .@i = 1270; .@i <= 1275; .@i++ ) {
			if (isbegin_quest(.@i) > 0)
				erasequest .@i;
		}
		if (isbegin_quest(1297) > 0)
			erasequest 1297;
		ep14_3_fall_bless = 4;
		close;
	case 5:
		mes "[Perishing Blessing Assistant]";
		mes "完成！";
		getitem 6693,40;// Stone_Of_Blessing
		close;
	case 6:
		mes "[Perishing Blessing Assistant]";
		mes "完成！";
		getitem 6694,30;// Monster_Blood
		close;
	case 7:
		mes "[Perishing Blessing Assistant]";
		mes "完成！";

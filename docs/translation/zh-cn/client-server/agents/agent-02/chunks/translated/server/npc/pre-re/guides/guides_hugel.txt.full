//===== Current Version: =====================================
//= 1.2
//===== Compatible With: =====================================
//= rAthena Project
//===== Description: =========================================
//= [Official COnversion]
//= Guides for the City of Hugel.
//===== Additional Comments: =================================
//= 1.0 Started the script. [erKURITA]
//= 1.1 Removed Duplicates [Silent]
//= 1.2 Rescripted to official 10.3 standards. [L0ne_W0lf]
//============================================================

hugel,98,56,3	script	Hugel Guide Granny#huge	863,0,0,{
	mes "[休尔格尔向导奶奶]";
	mes "哦，你好～你真是个精力充沛的冒险者。";
	mes "欢迎来到休尔格尔。能为你介绍这座美丽村庄是我的荣幸。";
	mes "如果你第一次使用向导服务，不妨先查看‘注意事项’菜单？";
	while(1) {
		next;
		switch(select("村庄指南:移除小地图标记:注意事项:取消")) {
		case 1:
			mes "[休尔格尔向导奶奶]";
			mes "只要是休尔格尔的建筑，我都能告诉你位置。";
			mes "那么你想去哪里？";
			if (.@compass_check == 0) {
				mes "要我在小地图上";
				mes "标记这些地点吗？";
				mes "这样导航会更方便。";
				next;
				if (select("是。:否。") == 1) set .@compass_check,1;
			}
			set .@loop,1;
			while(.@loop) {
				if (.@wait_button_chk == 0) set .@wait_button_chk,1;
				else next;
				switch(select("教堂:旅馆:酒馆:机场:武器店:道具店:派对用品店:^3131FF猎人转职处^000000:^3131FF神殿探险队驻地^000000:怪物赛跑竞技场:宾果游戏室:取消")) {
				case 1:
					mes "[休尔格尔向导奶奶]";
					mes "嗯，对我这样的老人来说，这座教堂就像是老人们的地方……";
					if (.@compass_check)
						viewpoint 1,156,116,2,0xFF0000;
					break;
				case 2:
					mes "与其赞美，不如吃布丁。";
					mes "在逛村子前，你最好先把行李整理好。";
					mes "旅馆就在我旁边的那栋建筑。";
					mes "在那里可以好好休息。";
					if (.@compass_check)
						viewpoint 1,104,79,3,0xFF00FF;
					break;
				case 3:
					mes "是啊，旅行时可以去酒馆结交新朋友。";
					mes "从这里向东走，就能到达酒馆。";
					mes "那里总是很热闹。";
					if (.@compass_check)
						viewpoint 1,129,66,4,0x99FFFF;
					break;
				case 4:
					mes "前阵子有陌生人来到村子，建了那个奇怪的机场……";
					mes "他们叫它什么来着？飞艇？";
					mes "真是个新奇的建筑。";
					if (.@compass_check)
						viewpoint 1,178,146,5,0x0000FF;
					break;
				case 5:
					mes "村子中央有一家武器店。";
					mes "不过我不知道有没有你用得上的武器。";
					mes "去看看也无妨。";
					if (.@compass_check)
						viewpoint 1,70,158,6,0x00FF00;
					break;
				case 6:
					mes "是的，我喜欢休尔格尔牌红色药水。还没尝过其他品牌的红色药水……呵呵呵。";
					mes "道具店位于村子中央。";
					mes "那里有旅行必需品。";
					if (.@compass_check)
						viewpoint 1,93,167,7,0x00FF00;
					break;
				case 7:
					mes "派对用品店就在村子中央附近。";
					mes "记得不要在别人附近使用爆竹之类的东西，那很危险。";
					mes "安全第一。";
					if (.@compass_check)
						viewpoint 1,91,105,8,0xFF99FF;
					break;
				case 8:
					mes "哦，你想成为猎人吗？";
					mes "沿海滩向东北走，就能找到猎人转职处。";
					mes "祝你转职顺利。";
					if (.@compass_check)
						viewpoint 1,206,228,9,0xFF9900;
					break;
				case 9:
					mes "听说神殿探险队住在西边的一所房子里。";
					mes "他们在村子中央立了某种标志，我想他们大概是在招募人手……";
					mes "不知道他们在这里做什么……嗯。";
					mes "也许你可以去问问。";
					if (.@compass_check)
						viewpoint 1,52,91,10,0xFFFFFF;
					break;
				case 10:
					mes "我也喜欢玩怪物赛跑游戏。真的很有趣。";
					mes "哦，你还没试过？不～你最好试试。相信我，你会喜欢的。";
					mes "一定要去体验一下。";
					if (.@compass_check)
						viewpoint 1,58,72,11,0xFF9900;
					break;
				case 11:
					mes "你喜欢宾果游戏吗？喜欢的话就去尤克兰的宾果游戏室看看。";
					mes "那里有许多有趣的玩法。";
					if (.@compass_check)
						viewpoint 1,55,209,12,0x66FFFF;
					break;
				case 12:
					mes "如果想移除小地图上的所有地点标记，";
					mes "再来找我并选择‘移除小地图标记’菜单即可。";
					mes "标记会立刻被清除。";
					set .@loop,0;
				}
			}
			break;
		case 2:
			viewpoint 2,156,116,2,0xFF0000;
			viewpoint 2,104,79,3,0xFF00FF;
			viewpoint 2,129,66,4,0x99FFFF;
			viewpoint 2,178,146,5,0x0000FF;
			viewpoint 2,70,158,6,0x00FF00;
			viewpoint 2,93,167,7,0x00FF00;
			viewpoint 2,91,105,8,0xFF99FF;
			viewpoint 2,206,228,9,0xFF9900;
			viewpoint 2,52,91,10,0xFFFFFF;
			viewpoint 2,58,72,11,0xFF9900;
			viewpoint 2,55,209,12,0x66FFFF;
			set .@compass_check,0;
			mes "[休尔格尔向导奶奶]";
			mes "好了，标记已经移除。如果还想询问其他地点，告诉我就行。";
			break;
		case 3:
			mes "[休尔格尔向导奶奶]";
			mes "使用‘村庄指南’菜单时，";
			mes "建筑位置会标记在屏幕右上方的小地图上。";
			mes "如果看不到小地图，可以使用快捷键‘Ctrl+Tab’，或点击基本信息窗口中的‘地图’按钮。";
			mes "如果无法看到整个村庄地图，也可以点击‘-’按钮缩小小地图。";
			break;
		case 4:
			mes "[休尔格尔向导奶奶]";
			mes "这份向导工作真让人兴奋。呵呵呵～";
			close;
		}
	}
}

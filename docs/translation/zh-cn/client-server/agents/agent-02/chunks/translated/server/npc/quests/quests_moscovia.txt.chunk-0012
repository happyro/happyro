				mes "是的，孩子们喜欢，花儿也正在盛开。";
				next;
				specialeffect2 EF_SUMMONSLAVE;
				mes "[Roza]";
				mes "谁会喜欢寒冷黑暗的冬天？希望这样的天气永远持续。";
				mos_elder = 1;

moscovia,211,215,5	script	A Young Man#mos12	4_M_RUSMAN1,{
	mes "[Izlof]";
	mes "有句老话说：";
	mes "‘机会就是机遇。’";
	next;
	mes "[Izlof]";
	mes "天气暖和、女士们心神荡漾的时候，";
	mes "最适合向她们告白！";
	if (mos_nowinter == 10) {
		if (mos_middle == 0) {
			next;
			select("天气暖和真好。");
			mes "[Izlof]";
			if (rand(1,100) > 70) {
				mes "当然。";
				mes "从现在起就是我的黄金机会时代！";
				next;
				specialeffect2 EF_SUMMONSLAVE;
				mes "[Izlof]";
				mes "如果一直都是夏天，";
				mes "我的人生会充满恋爱气息。哈哈哈！我不想让冬天到来。";
				mos_middle = 1;
				if (mos_kid == 1 && mos_elder == 1) {
					mos_nowinter = 11;
					changequest 18075,18076;
				}
				close;
			}
			mes "当然。寒冷的冬天已经过去。从现在起就是我的黄金时代！";
		}
	}
	close;
}


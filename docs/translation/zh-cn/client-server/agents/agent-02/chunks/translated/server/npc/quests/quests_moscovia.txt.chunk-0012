moscovia,252,203,5	script	A Little Girl#mos1	4_F_RUSCHILD,{
	if (mos_nowinter == 10) {
		if (mos_kid == 0) {
			.@kid = rand(1,100);
			select("小姑娘，你喜欢温暖的天气吗？");
			mes "[Yosefina]";
			if (.@kid > 70) {
				mes "是的，我非常喜欢~我永远不想让它离开，也不想让冬天到来。";
				specialeffect2 EF_SUMMONSLAVE;
				mos_kid = 1;
				if (mos_middle == 1 && mos_elder == 1) {
					mos_nowinter = 11;
					changequest 18075,18076;
				}
				close;
			}
			mes "是的，我非常喜欢~但太阳一落山我就必须回家。";
			next;
			mes "[Yosefina]";
			mes "我听说 Baba Yaga 会绑架夜里游荡的坏孩子。";
			close;
		}
	}
	mes "[Yosefina]";
	mes "可怕的食人者 Baba Yaga 住在城外。";
	next;
	mes "[Yosefina]";
	mes "妈妈告诉我她是真的。";
	close;
}

moscovia,233,204,3	script	A Young Man#mos2	4_M_RUSMAN2,{
	if (mos_nowinter == 10) {
		if (mos_middle == 0) {
			select("你不喜欢冬天，对吧？");
			.@kid = rand(1,100);
			mes "[Fedor]";
			if (.@kid > 70) {
				mes "不，我不喜欢寒冷的冬天。看到情侣时我会生气。";
				specialeffect2 EF_SUMMONSLAVE;
				mos_middle = 1;
				if (mos_kid == 1 && mos_elder == 1) {
					mos_nowinter = 11;
					changequest 18075,18076;
				}
				close;
			}
			mes "唉，我真希望有个女朋友，那样就能更好地享受温暖阳光……";
			next;
			mes "[Fedor]";
			mes "你是谁？别让事情更糟！";
			close;
		}
	}
	mes "[Fedor]";
		mes "终于，冬天结束了。春天来到我的心里……";
	close;
}

moscovia,219,229,5	script	A Middle-Aged Man#mos3	4_M_RUSBALD,{
	if (mos_nowinter == 10) {
		if (mos_elder == 0) {
			select("谁会喜欢冬天？");
			mes "[Viktor]";
			if (rand(1,100) > 70) {
				mes "可不是嘛！冬天再次到来时大家都会悲伤。我不想让冬天来。";
				specialeffect2 EF_SUMMONSLAVE;
				mos_elder = 1;
				if (mos_kid == 1 && mos_middle == 1) {
					mos_nowinter = 11;
					changequest 18075,18076;
				}
				close;
			}
			mes "嗯，你这么认为……我对夏冬都太熟悉了，不在乎偏爱哪一个。";
			close;
		}
	}
	mes "[Viktor]";
	mes "我们民族非常自豪于自身力量和不屈精神。";
	next;
	mes "[Viktor]";
	mes "冬天多冷对我们都无所谓！";
	close;
}

moscovia,255,203,3	script	A Little Boy#mos4	4_M_RUSCHILD,{
	mes "[Vasili]";
	mes "哇，他是冒险者，是冒险者！！";
	next;
	if (mos_nowinter == 10) {
		if (mos_kid == 0) {
			mes "[Vasili]";
			mes "你为什么来这里？没有同伴吗？史诗里的英雄都很高大，你为什么这么小？";
			mes "你金光闪闪的剑在哪？听说铠甲会闪耀白光，你为什么没穿？";
			mes "你不去进行另一场冒险吗？寒冷下雪的冬天怎么做到？";
			next;
			select("天气变暖我就去。");
			mes "[Vasili]";
			if (rand(1,100) > 70) {
				mes "真的吗？我有一天也要穿着闪亮铠甲，带着又长又重的剑去冒险。";
				next;
				specialeffect2 EF_SUMMONSLAVE;
				mes "[Vasili]";
				mes "如果冬天消失，冒险就容易多了。";
				mos_kid = 1;
				if (mos_middle == 1 && mos_elder == 1) {
					mos_nowinter = 11;
					changequest 18075,18076;
				}
				close;
			}
			mes "啊，你什么时候出发？这次要去哪？";
			next;
			mes "[Vasili]";
			mes "你要去屠龙吗？那条龙会喷火，挥一次翅膀就能杀死十个人！";
			close;
		}
	}
	mes "[Vasili]";
	mes "告诉我你的精彩故事。你打过龙吗？你的金光剑和盾牌在哪里？在哪里？";
	close;
}


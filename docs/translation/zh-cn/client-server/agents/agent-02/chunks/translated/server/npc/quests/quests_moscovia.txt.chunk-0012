			close;
		}
	}
	mes "[Roza]";
	mes "淘气的孩子在温暖天气里太兴奋了。";
	next;
	mes "[Roza]";
	mes "太阳在哪里？它藏到哪里去了？";
	close;
}

moscovia,202,102,3	script	A Little Boy#mos7	4_M_RUSCHILD,{
	if (mos_nowinter == 10) {
		if (mos_kid == 0) {
			select("你喜欢神秘故事吗？");
			mes "[Feliks]";
			if (rand(1,100) > 70) {
				mes "是的，我喜欢它们。";
				mes "但是冬天没人出门，所以不太有趣。";
				next;
				specialeffect2 EF_SUMMONSLAVE;
				mes "[Feliks]";
				mes "如果冬天永远不来，我就能一直开心……";
				mos_kid = 1;
				if (mos_middle == 1 && mos_elder == 1) {
					mos_nowinter = 11;
					changequest 18075,18076;
				}
				close;
			}
		mes "是的，奶奶给我讲过童话。冬天很冷，但听故事很有趣。";
			close;
		}
	}
	mes "[Feliks]";
	mes "这是关于一条可怕巨龙的故事。";
	next;
	mes "[Feliks]";
	mes "它正在巢穴中睡觉，但醒来时会摧毁周围的一切。";
	next;
	mes "[Feliks]";
	mes "这是我奶奶的奶奶的奶奶的奶奶的奶奶传下来的故事。";
	close;
}

moscovia,220,172,3	script	A Young Man#mos8	4_M_RUSMAN2,{
	mes "[Ilyav]";
	mes "我要去冒险，";
	mes "体验新的世界，";
	mes "就像你一样。";
	if (mos_nowinter == 10) {
		if (mos_middle == 0) {
			next;
			select("你什么时候感觉最好？");
			mes "[Ilyav]";
			if (rand(1,100) > 70) {
				mes "天气像最近这样好的时候，";
				mes "我每天都会多次产生冒险的冲动。";
				next;
				specialeffect2 EF_SUMMONSLAVE;
				mes "[Ilyav]";
				mes "但是寒冷的冬天我不想出门。";
				mes "唉，如果每天的天气都像最近这么好，";
				mes "我就想多出去走走。";
				mes "我讨厌冬天……";
				mos_middle = 1;
				if (mos_kid == 1 && mos_elder == 1) {
					mos_nowinter = 11;
					changequest 18075,18076;
				}
				close;
			}
			mes "嗯……";
			mes "我不知道。";
			mes "只是偶尔会这样。";
		}
	}
	close;
}

moscovia,253,175,3	script	A Man#mos9	4_M_RUSBALD,{
	if (mos_nowinter == 10) {
		if (mos_elder == 0) {
			select("你通常在冬天做什么？");
			mes "[Orek]";
			if (rand(1,100) > 70) {
				mes "冬天太冷了，所以我不出门。";
				mes "雪下得太大，让人很难到处走动。";
				next;
				specialeffect2 EF_SUMMONSLAVE;
				mes "[Orek]";
				mes "冬天钓鱼更困难，";
				mes "总之对我们很不方便。";
				mes "我觉得以后永远没有冬天也不错。";
				mos_elder = 1;
				if (mos_kid == 1 && mos_middle == 1) {
					mos_nowinter = 11;
					changequest 18075,18076;
				}
				close;
			}
			mes "冬天雪很大，";
			mes "天气也太冷。";
			mes "所以没有特别理由，";
			mes "我们不会出门。";
			next;
			mes "[Orek]";
			mes "我们一家人只会坐在火炉旁聊天，";
			mes "希望冬天快点过去。";
			close;
		}
	}
	mes "[Orek]";
	mes "现在的沙皇有些严厉，";
	mes "甚至有点可怕，";
	mes "但他其实深爱着";
	mes "自己的人民。";
	close;
}


// Sector D
prt_prison,243,17,4	script	Prisoner 243DV17#EP161D	4_PORING,{
	if (checkweight(1301,1) == 0) {
		mes "- 你持有的物品太多，无法继续任务。-";
		close;
	}
	if (isbegin_quest(5415) < 2 || BaseLevel < 140) {// Restricted Sector
		emotion ET_THINK, playerattached();
		emotion ET_THINK;
		mes "... ... ... ...";
		close;
	}
	if (isbegin_quest(5419) == 0) {
		mes "[Prisoner 243DV17]";
		mes "怎么了，人类？有什么想对我说的吗？";
		next;
		input .@string$;
		setquest 5419;// Restricted Sector D
		mes "[Prisoner 243DV17]";
		mes "你在说什么？我没时间陪你。滚吧。";
		close2;
		warp "prt_prison",160,290;
		end;
	}
	.@r = rand(1,10);
	if (.@r == 3) {
		mes "[Prisoner 243DV17]";
		mes "什么？！你有什么要对我说？那就说出来！";
		next;
		input .@string$;
		mes "[" + strcharinfo(0) + "]";
		mes "" + .@string$ + "";
		next;
		mes "[Prisoner 243DV17]";
		mes "" + .@string$ + "？就这些？";
		next;
		mapannounce "prt_prison", "神秘喊话：笨蛋" + strcharinfo(0) + "说：" + .@string$ + "", bc_map, 0x9CFF00;
		sleep2 3000;
		mapannounce "prt_prison", "神秘笑声：咯咯", bc_map, 0x9CFF00;
		mes "我被无缘无故嘲笑了，感觉真糟。";
		next;
		mes "[Prisoner 243DV17]";
		mes "什么？！你对我有意见吗？现在滚开。";
		close;
	}
	if (.@r == 7) {
		emotion ET_KIK;
		mes "[Prisoner 243DV17]";
		mes "～咯咯～我突然感觉好多了。好吧，管它呢。给我1个杰勒比，我就送你去想去的区域。";
		next;
		if (countitem(909) < 1) {
			emotion ET_HUM;
			mes "[Prisoner 243DV17]";
			mes "什么？你连杰勒比都没带？你怎么这么没用？";
			close;
		}
		delitem 909,1;// Jellopy
		setarray .@sector$[0], "Prison Entrance", "Sector A", "Sector B", "Sector C", "Sector D", "Sector E", "Sector F", "Sector G", "Sector H";
		.@s = select( implode(.@sector$,":") ) - 1;
		mes "[Prisoner 243DV17]";
		if (.@s == 4)	// Sector D
			mes "什么？D区就在这里！算了，我已经拿到杰勒比，不在乎了。送你过去吧。";
		else
			mes "谢谢你的杰勒比！那就去" + .@sector$[.@s] + "吧。出发！";
		close2;
		switch(.@s) {
		case 0:
			warp "prt_prison",160,290;	// Prison Entrance
			break;
		case 1:
			warp "prt_prison",245,255;	// Sector A
			break;
		case 2:
			warp "prt_prison",265,195;	// Sector B
			break;
		case 3:
			warp "prt_prison",255,155;	// Sector C
			break;
		case 4:
			warp "prt_prison",230,20;	// Sector D
			break;
		case 5:
			warp "prt_prison",105,75;	// Sector E
			break;
		case 6:
			warp "prt_prison",105,190;	// Sector F
			break;
		case 7:
			warp "prt_prison",95,215;	// Sector G
			break;
		case 8:
			warp "prt_prison",55,125;	// Sector H
			break;
		}
		end;
	}
	emotion ET_OHNO;
	mes "[Prisoner 243DV17]";
	mes "让我一个人待着！走开！";
	close;
}

// Sector E
prt_prison,95,72,6	script	Prisoner 95EB72#EP161E	4_BAPHOMET,{
	if (checkweight(1301,1) == 0) {
	mes "- 你持有的物品太多，无法继续任务。-";
		close;
	}
	if (isbegin_quest(5415) < 2) {// Restricted Sector
		specialeffect EF_SLEEPATTACK;
		mes "呼呼呼……～打鼾～";
		next;
		mes "囚犯呼吸平稳，一定正在睡觉。";
		close;
	}
	if (BaseLevel < 140) {
		mes "[Prisoner 95EB72]";
		mes "真是没用的人类！";
		close;
	}
	switch( isbegin_quest(5436) ) {
	case 0:
		emotion ET_SEXY;
		mes "[Prisoner 95EB72]";
		mes "～嗅闻～这个气味……没错……是人类……";
		next;
		emotion ET_KIK;
		mes "[Prisoner 95EB72]";
		mes "～咯咯～已经很久没有人类来到这片黑暗的地下了。过来，人类。难得见到你，我大发慈悲饶你一命。";
		next;
		select("靠近一些。 ");
		npctalk "～瑟缩～", "", bc_self;
		sleep2 2000;
		emotion ET_SWEAT;
		mes "[Prisoner 95EB72]";
		mes "～邪恶的笑声～你很有胆量，人类！";
		mes "我迫不及待想让愚蠢的人类尝尝我恐怖的拳头！";
		next;
		mes "[Prisoner 95EB72]";
		mes "因为胆小的人类，我现在无法离开这个阴暗潮湿的地方。一旦出去，我绝不会原谅人类。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "嗯……其实没那个必要……";
		next;
		npctalk "～瑟缩～", "", bc_self;
		sleep2 2000;
		emotion ET_KIK;
		mes "[Prisoner 95EB72]";
		mes "～邪恶的笑声～";
		mes "你竟敢顶嘴？好大的胆子！不过我也喜欢你的大胆。那你就做我的下属吧。";
		next;
		select("话说回来，你刚才不是瑟缩了吗？");
		emotion ET_QUESTION, playerattached();
		sleep2 2000;
		emotion ET_STARE;
		mes "[Prisoner 95EB72]";
		mes "哇哈哈哈！看来我有了一个狂妄的下属。";
		mes "记住。像这里这样阴暗潮湿的地方，最适合一个邪恶至极、甚至没有自己脸孔的分身。";
		next;
		mes "[Prisoner 95EB72]";
		mes "～邪恶的笑声～";
		mes "给这个有趣的下属一个证明忠诚的机会吧。首先得让这里亮起来。";
		next;
		emotion ET_BLABLA, playerattached();
		mes "[" + strcharinfo(0) + "]";
		mes "我们不是才刚……见面吗？";
		next;
		setquest 5420;// Restricted Sector E
		setquest 5436;// Finding Lights
		mes "[Prisoner 95EB72]";
		mes "下属。把监狱里燃烧得最亮的火把拿来。这里太暗了，我要让这里像我的故乡一样明亮。";
		close;
	case 1:
		if (countitem(6923) < 1) {// Bright Light
			mes "[Prisoner 95EB72]";
			mes "下属。把监狱里燃烧得最亮的火把拿来。我得让这里像我的故乡一样明亮。";
			close;
		}
		mes "[Prisoner 95EB72]";
		mes "～邪恶的笑声～";
		mes "多么忠诚的下属！多亏你的贡献，我至少暂时能过上明亮的生活。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "我的意思是，我不是你的下……";
		next;
		emotion ET_OHNO;
		mes "[Prisoner 95EB72]";
		mes "我想给你奖励，但恐怕我没什么东西。如果是我全盛时期，我会给你一世界的宝藏。";
		next;
		mes "[Prisoner 95EB72]";
		mes "下属，虽然有点寒酸，但我把之前进入这里的人类留下的东西给你。";
		next;
		completequest 5436;// Finding Lights
		setquest 5437;// [Stand by]Finding Lights
		delitem 6923,1;// Bright_Lights
		getexp 700000,500000;
		getitem 6919,4;// TokenOfHonor
		mes "[Prisoner 95EB72]";
		mes "等我再次在世间扬名立万那天，我保证给你更多奖励。";
		close;
	case 2:
		switch( checkquest(5437,PLAYTIME) ) {
		case -1:
			if (isbegin_quest(5438) == 0) {
				mes "[Prisoner 95EB72]";
				mes "现在是证明你忠诚的时候。把监狱里燃烧得最亮的火把拿来。";
				next;
				if (select( "别急。", "好吧……" ) == 1) {
					mes "[Prisoner 95EB72]";
					mes "你现在还有别的事要做吗？听到这个我很困惑，但我会尽力理解。";
					mes "不过别让我等太久。";
					close;
				}
				setquest 5438;// [Repeat]Finding Lights
				mes "[Prisoner 95EB72]";
				mes "～笑声～去吧！去拿监狱里燃烧得最亮的火把。";
				close;
			}
			if (countitem(6923) < 1) {// Bright Light
				mes "[Prisoner 95EB72]";
				mes "再去拿监狱里燃烧得最亮的火把。";
				close;
			}
			emotion ET_SMILE;
			mes "[Prisoner 95EB72]";
			mes "多么优秀的下属！多亏你的贡献，我至少暂时能过上明亮的生活。";
			next;
			erasequest 5438;// [Repeat]Finding Lights
			setquest 5437;// [Stand by]Finding Lights
			delitem 6923,1;// Bright_Lights
			getexp 700000,500000;
			getitem 6919,4;// TokenOfHonor
			mes "[Prisoner 95EB72]";
			mes "记住这一点。等我再次在世间扬名立万那天，我保证给你更多奖励。";
			close;
		case 0:
		case 1:
			mes "[Prisoner 95EB72]";
			mes "事情没有太大变化，但看到这里变亮了，感觉还是很好。";
			close;
		case 2:
			erasequest 5437;// [Stand by]Finding Lights
			mes "[Prisoner 95EB72]";
			mes "告诉你，你带来的火把光芒正在变弱。是时候再次向我证明你的价值了。";
			close;
		}
	}
}


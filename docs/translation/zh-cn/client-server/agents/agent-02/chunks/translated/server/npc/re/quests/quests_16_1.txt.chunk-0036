			close;
		case 2:
			emotion ET_SLEEPY;
			erasequest 5429;// [Stand by]Lowly Standards
			mes "[Prisoner 267BD184]";
		mes "哦，我没别的事可做。真无聊。我应该找点事做。";
			next;
			mes "[Prisoner 267BD184]";
		mes "哦！漂亮眼睛的人类！你来得正是时候。";
			close;
		}
	}
}

// Sector C
prt_prison,265,154,4	script	Prisoner 265CM154#EP161C	4_MOONLIGHT,{
	if (checkweight(1301,1) == 0) {
		mes "- 你持有的物品太多，无法继续任务。-";
		close;
	}
	if (isbegin_quest(5415) < 2) {// Restricted Sector
		mes "这里的囚犯像捕猎的狮子一样扫视角落。你最好在被抓住前离开。";
		close;
	}
	if (BaseLevel < 140) {
		mes "[Prisoner 265CM154]";
		mes "哇，这里有人类！";
		mes "抱歉，但我现在必须工作。之后再和你玩。";
		close;
	}
	switch( isbegin_quest(5431) ) {
	case 0:
		mes "[Prisoner 265CM154]";
		mes "哇，这里有人类！";
		mes "你是怎么进来的？有两下子嘛！";
		next;
		emotion ET_SEXY;
		mes "[Prisoner 265CM154]";
		mes "嘿嘿——";
		next;
		emotion ET_GOODBOY, playerattached();
		mes "～抚摸～";
		next;
		emotion ET_BEST;
		mes "[Prisoner 265CM154]";
		mes "给你一枚称赞印章。拿去！";
		next;
		mes "[Prisoner 265CM154]";
		mes "嘿嘿——不用见到那些吓人的家伙，我觉得一切都很好。对吧？";
		next;
		emotion ET_QUESTION;
		mes "[Prisoner 265CM154]";
		mes "我了解到人类为了奖励什么都愿意做。对不对？";
		next;
		emotion ET_QUESTION;
		mes "[Prisoner 265CM154]";
		mes "我给你一个很不错的奖励。只要听从我的一条‘命令’。";
		next;
		select("先听听看。 ");
		mes "[Prisoner 265CM154]";
		mes "哦，好！真不错！";
		mes "你真是个好人类。看吧？只要有眼睛就知道我的意思。";
		next;
		mes "[Prisoner 265CM154]";
		mes "这座地下城以前干净整洁。人类前段时间来过后，这里变脏了，可能是因为他们没有好好打扫。";
		next;
		mes "[Prisoner 265CM154]";
		mes "看好了，人类。相信我的侦探直觉。你看到他们在这里游荡了吗？";
		next;
		emotion ET_STARE;
		mes "[Prisoner 265CM154]";
		mes "我不知道他们是怎么进来的，但我敢肯定监狱变脏就是他们造成的。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "你想让我攻击他们吗？";
		next;
		emotion ET_HUK;
		mes "[Prisoner 265CM154]";
		mes "你在说什么，人类？他们人很好。我没想到你这么暴力。真让我失望。";
		next;
		setquest 5418;// Restricted Sector C
		setquest 5431;// Clean Life
		mes "[Prisoner 265CM154]";
		mes "别再骚扰无辜的孩子。去监狱各处把脏乱清理干净。";
		close;
	case 1:
		if (isbegin_quest(5432) == 0) {
			mes "[Prisoner 265CM154]";
			mes "人类！别想偷工减料——把这里那里都擦干净。打扫干净。认真做。";
			close;
		}
		emotion ET_BEST;
		mes "[Prisoner 265CM154]";
		mes "你打扫完了吗？太好了！这是你的称赞印章！";
		next;
		emotion ET_BEST;
		mes "[Prisoner 265CM154]";
		mes "监狱变干净了，你一定也感觉很好吧，人类？我们应该多打扫几次。";
		next;
		mes "[Prisoner 265CM154]";
		mes "哦，对了！我说过会给你奖励，对吧？";
		mes "这是之前在这里工作的人类给我的。你表现得很不错，就把这个给你。";
		next;
		completequest 5431;// Clean Life
		erasequest 5432;// Cleaning is complete.
		setquest 5433;// [Stand by]Clean Life
		getexp 700000,500000;
		getitem 6919,4;// TokenOfHonor
		mes "[Prisoner 265CM154]";
		mes "明天再回来帮我，还会有更多奖励。常来啊！";
		close;
	case 2:
		switch( checkquest(5433,PLAYTIME) ) {
		case -1:
			if (isbegin_quest(5434) == 0) {
				mes "[Prisoner 265CM154]";
				mes "监狱已经如我所愿变得乱糟糟了。终于到了打扫的时候。";
				next;
				emotion ET_WRAP;
				mes "[Prisoner 265CM154]";
				mes "打扫会让今天变得有意义！";
				next;
				if (select( "开始吧！", "不可能！我死也不做。" ) == 2) {
					emotion ET_OHNO;
					mes "[Prisoner 265CM154]";
					mes "哦，你这家伙……！我知道你本来可以更好，没想到你这么懒。太失望了！";
					close;
				}
				setquest 5434;// [Repeat]Clean Life
				emotion ET_BEST;
				mes "[Prisoner 265CM154]";
				mes "开始打扫吧！";
				close;
			}
			if (isbegin_quest(5435) == 0) {
				mes "[Prisoner 265CM154]";
				mes "人类！别想偷工减料——把这里那里都擦干净。打扫干净。认真做。";
				close;
			}
			emotion ET_BEST;
			mes "[Prisoner 265CM154]";
			mes "真是个好人类！你又赢得了一枚称赞印章！拿去！";
			next;
			erasequest 5434;// [Repeat]Clean Life
			erasequest 5435;// [Repeat]Cleaning is complete.
			setquest 5433;// [Stand by]Clean Life
			getexp 700000,500000;
			getitem 6919,4;// TokenOfHonor
			mes "[Prisoner 265CM154]";
			mes "既然你今天打扫完了，我就把这个给你。明天再来！";
			close;
		case 0:
		case 1:
			emotion ET_OHNO;
			mes "[Prisoner 265CM154]";
			mes "你好像不知道把东西弄乱的乐趣。弄乱和打扫一样有趣！";
			next;
			mes "[Prisoner 265CM154]";
			mes "今天就到这里吧。剩下的明天再做。";
			close;
		case 2:
			erasequest 5433;// [Stand by]Clean Life
			mes "[Prisoner 265CM154]";
			mes "你来得正是时候。监狱已经乱得恰到好处，是时候打扫了。";
			close;
		}
	}
}

// Rubbish heap
prt_prison,118,247,4	script	Rubbish heap#EP161C01	4_ENERGY_BLACK,{
	if ((isbegin_quest(5431) == 1 && isbegin_quest(5432) == 0) || (isbegin_quest(5434) == 1 && isbegin_quest(5435) == 0)) {
		mes "地板上散落的东西堆在了一起。";
		next;
		if (select( "清理。", "放着不管。" ) == 1) {
			progressbar "ffff00",2;
			.@r = rand(1,100);
			if (.@r < 10 || .@r > 30)
				mes "很遗憾，还有很多东西要打扫。去找些东西清理吧。";
			else {
				mes "你打扫完了。去报告结果吧。";
				if (isbegin_quest(5431) == 1)
					setquest 5432;// [Repeat]Cleaning is complete.
				else
					setquest 5435;// [Repeat]Cleaning is complete.
			}
			initnpctimer;
			disablenpc();
		}
		close;
	}
	end;
OnTimer30000:
OnTimer60000:
OnTimer90000:
OnTimer120000:
OnTimer150000:
OnTimer180000:
OnTimer210000:
OnTimer240000:
OnTimer270000:
	if (rand(1,2) == 1) {
		stopnpctimer;
		enablenpc();
	}
	end;
OnTimer300000:
	stopnpctimer;
	enablenpc();
	end;
}

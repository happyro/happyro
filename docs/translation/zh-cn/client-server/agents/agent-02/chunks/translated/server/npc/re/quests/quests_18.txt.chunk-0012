		close2;
		navigateto("oz_dun01",100,92);
		end;
	}
	end;

OnInit:
	questinfo( QTYPE_QUEST2, QMARK_YELLOW, "isbegin_quest(11728) == 1" );
	end;
}

// Quest: Investigation of Oz Labyrinth. Step 6 + 7 + 8.
oz_dun01,100,92,3	script	???#ep18_sb1	4_EP18_GW_MIDDLE02,{
	if (isbegin_quest(11729) == 1) {
		mes "[伊姆里尔]";
		mes "你还好吗，保罗？";
		cutin "ep18_imril_02.png",2;
		next;
		cutin "",255;
		mes "[保罗]";
		mes "哈哈……";
		mes "我逃离怪物时被热蒸汽击中了。";
		mes "我在一直走的路上放松了警惕。";
		next;
		mes "[保罗]";
		mes "我也不知道自己的物品掉到哪里去了。";
		mes "受伤还丢了物品，真是悲惨……";
		next;
		mes "[伊姆里尔]";
		mes "别这么说，生命比物品重要。";
		cutin "ep18_imril_02.png",2;
		next;
		cutin "",255;
		mes "[保罗]";
		mes "嗯……";
		mes "谢谢。";
		next;
		mes "[伊姆里尔]";
		mes "我这里有些药水，喝下这个，先回村子去吧。";
		mes "之后再回来找你的物品。";
		cutin "ep18_imril_01.png",2;
		next;
		cutin "",255;
		mes "[保罗]";
		mes "不，你留着吧！";
		mes "我们不能这样浪费村子的宝贵资源。";
		next;
		mes "[保罗]";
		mes "休息一会儿，然后回村子涂药膏。";
		next;
		mes "[保罗]";
		mes "不过，我不想在恢复期间被怪物攻击，所以你能帮我^e5555e清理附近的怪物^000000吗？";
		erasequest 11729;
		setquest 11730;
		close;
	}

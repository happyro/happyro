		mes "[艾莉]";
		mes "我显现出原本的形态，因为这似乎是你们需要一起听的故事。";
		next;
		cutin "ep18_maram_01.png",2;
		mes "[马拉姆]";
		mes "哦……我有时会听到某处传来微弱的呻吟声，原来是在这里？";
		next;
		cutin "ep172_beta.bmp",2;
		mes "[艾莉]";
		mes "你们看起来很镇定。确实可以说你们是冒险者队伍。";
		mes "我们直入主题吧。这个形态维持不了太久。";
		next;
		cutin "ra_gwoman.bmp",2;
		mes "[尼伦]";
		mes "确实令人惊讶，但请你说明吧。我需要了解芙蕾雅显现体的真实身份。";
		next;
		cutin "ep172_beta.bmp",2;
		mes "[艾莉]";
		mes "好。我来快速解释一下。";
		mes "从宅邸收集的残骸在结构上与胚胎完全相同，那是人造生命体的起源。";
		next;
		cutin "ep18_maram_01.png",2;
		mes "[马拉姆]";
		mes "胚胎？";
		mes "那是什么？某种炼金术吗？";
		next;
		cutin "ep172_beta.bmp",2;
		mes "[艾莉]";
		mes "你了解这个领域吗？";
		mes "胚胎是人造生命体——炼金生物的胎儿形态。";
		next;
		mes "[艾莉]";
		mes "人造生命体很美丽。根据培育它们的炼金术士不同，它们可以呈现数百种形态。";
		next;
		mes "[艾莉]";
		mes "巴戈特以胚胎为基础，按照教皇的样子制作，再将其改造成了奇美拉。";
		mes "你们在宅邸看到的，就是那种改造后的奇美拉。";
		next;
		select( "因为那是幻象。" );
		cutin "ep18_suad_01.png",0;
		mes "[苏阿德]";
		mes "我能进一步了解这个幻象吗？";
		next;
		mes "我简要说明了幻象的情况。";
		next;
		cutin "ep18_suad_02.png",0;
		mes "[苏阿德]";
		mes "所以，我们被巴戈特的诡计欺骗，为了取得一块伊米尔之心而召唤女神？";
		next;
		cutin "ep172_beta.bmp",2;
		mes "[艾莉]";
		mes "简单来说，是的。";
		mes "你理解得很快。你的头脑一定很出色。";
		next;
		cutin "ep18_suad_03.png",0;
		mes "[苏阿德]";
		mes "我明白尤瑟被幻象的诡计卷入，试图召唤女神，最后却自我毁灭。";
		mes "但幻象究竟是怎么回事？巴戈特和伊米尔之心去了哪里？";
		next;
		cutin "ep18_suad_01.png",0;
		mes "[苏阿德]";
		mes "最重要的是……我无法接受我们受苦只是因为某个人的权力游戏，而不是神的旨意。";
		next;
		cutin "ep18_miriam_03.png",0;
		mes "[米里亚姆]";
		mes "苏阿德。";
		mes "我也有同样的感受。我们都是。";
		mes "最糟糕的是，我明明离真相最近，却还是没有察觉……";
		next;
		cutin "ep18_maram_03.png",2;
		mes "[马拉姆]";
		mes "母亲。我们今后该怎么办？";
		next;
		cutin "ep172_beta.bmp",2;
		mes "[艾莉]";
		mes "组建议会。";
		mes "在我看来，这个国家缺乏沟通。";
		mes "如果本地人和移民不互相交流，又怎么能知道彼此想要什么？";
		next;
		mes "[艾莉]";
		mes "赋予本地人地位和权力，并以法律保障他们。";
		mes "这很难，却也很简单。只要给予保障就行。";
		next;
		cutin "ra_gwoman.bmp",2;
		mes "[尼伦]";
		mes "我明白了。我们不能只是等待神的旨意并强行执行，而应该倾听人们的故事。";
		mes "如此根本的问题……";
		next;
		cutin "ep18_maram_03.png",2;
		mes "[马拉姆]";
		mes "但统治阶级不会保持沉默。";
		mes "说不定会比现在出现更多的反抗和混乱。";
		next;
		cutin "ep18_suad_01.png",0;
		mes "[苏阿德]";
		mes "哈，但我们不能一直这样下去，对吧？";
		next;
		cutin "ep18_miriam_01.png",0;
		mes "[米里亚姆]";
		mes "没错。改革是必要的。";
		mes "我们不能永远对着墙喊叫，再躲进森林里。";
		next;
		cutin "ep172_beta.bmp",2;
		mes "[艾莉]";
		mes "人类，不必担心。";
		mes "时间永远站在我们这边。";
		mes "你们的职责是增强另一方的力量，使其与权力相抗衡。仅此而已。";
		next;
		mes "[艾莉]";
		mes "其余的事情会由时间和人类的适应力解决。";
		next;
		cutin "ra_gwoman.bmp",2;
		mes "[尼伦]";
		mes "这是一位外来者给我们的重要启示。";
		mes "明白了。我们正式提出这个问题进行讨论吧。";
		next;
		mes "[尼伦]";
		mes "如果是泽德宅邸，或许能提供很大帮助。";
		mes "你们决定一位本地人的代表吧。";
		next;
		cutin "ep18_miriam_01.png",0;
		mes "[米里亚姆]";
		mes "苏阿德在这里。父亲。";
		mes "还有我和马拉姆。我们不就是为了这一天而来的吗？";
		next;
		cutin "ep18_maram_01.png",2;
		mes "[马拉姆]";
		mes "灰色之子的孩子们该履行职责了。";
		mes "母亲收养我们，就是为了这一天吗？";
		next;
		cutin "ep18_suad_01.png",0;
		mes "[苏阿德]";
		mes "不用担心我们这边。只要准备好合适的议会就行。";
		next;
		cutin "ra_gwoman.bmp",2;
		mes "[尼伦]";
		mes "谢谢。你们都成长得很好……";
		next;
		cutin "ep172_beta.bmp",2;
		mes "[艾莉]";
		mes "好。这个国家的情况确实超出了我的知识范围，但看来已经得到妥善处理。";
		mes "现在回到幻象的话题吧。";
		next;
		cutin "ep18_maram_01.png",2;
		mes "[马拉姆]";
		mes "对。巴戈特带着伊米尔之心去了某处，对吧？";
		mes "而冒险者会出发寻找那颗心。";
		next;
		select( "我们需要知道巴戈特的下落。" );
		cutin "ep18_miriam_01.png",0;
		mes "[米里亚姆]";
		mes "巴戈特似乎前往了北方大陆。";
		mes "我记得曾和父亲谈过耶梦加得。";
		next;
		cutin "ep172_beta.bmp",2;
		mes "[艾莉]";
		mes "北方？";
		mes "你说的是耶梦加得，也就是结界另一侧的封锁区域？";
		next;
		cutin "ep18_miriam_01.png",0;
		mes "[米里亚姆]";
		mes "是真的吗？耶梦加得被封锁了。巴戈特似乎对此很感兴趣。";
		mes "巴戈特对复活神明很感兴趣。";
		next;
		mes "[米里亚姆]";
		mes "起初，看起来只是以神明降临为幌子，想要窃取伊米尔之心……";
		mes "没人知道他会如何利用得到的伊米尔之心。";
		next;
		mes "[米里亚姆]";
		mes "不过，巴戈特的一名同伴似乎已经前往北方大陆。";
		next;
		cutin "ep18_maram_01.png",2;
		mes "[马拉姆]";
		mes "耶梦加得真的存在？";
		next;
		cutin "ra_gwoman.bmp",2;
		mes "[尼伦]";
		mes "耶梦加得教派确实存在过。";
		mes "战胜该教派的英雄们成为了卢恩·米德加兹王国的建立者。";
		next;
		mes "[尼伦]";
		mes "当时，他们是以奥丁之名战斗，而不是像我们一样以芙蕾雅之名。";
		mes "显然，是芙蕾雅向人类揭示了其中的意义。";
		next;
		mes "[尼伦]";
		mes "然而，战胜教会的英雄家族以奥丁之名建立了国家。";
		mes "还有传说说，耶梦加得因此诅咒了胜利的英雄和第一任国王。";
		next;
		cutin "ep18_maram_01.png",2;
		mes "[马拉姆]";
		mes "我以前从没听说过？";
		mes "诅咒……？";
		next;
		select( "诅咒并不重要。" );
		cutin "ra_gwoman.bmp",2;
		mes "[尼伦]";
		mes "是的。现在王室诅咒的故事并不重要。";
		mes "重要的是，耶梦加得教派确实存在过。";
		next;
		mes "[尼伦]";
		mes "也有传说说，耶梦加得被封印在名为北方大陆的地方。";
		next;
		cutin "ep18_miriam_01.png",0;
		mes "[米里亚姆]";
		mes "如果巴戈特真的想复活神明，下一个目标就是耶梦加得。";
		next;
		cutin "ra_gwoman.bmp",2;
		mes "[尼伦]";
		mes "必须阻止他。";
		mes "那片大陆的黑暗比持续千年的神战更加深重。";
		mes "我们必须追踪并阻止巴戈特。";
		next;
		cutin "ep172_beta.bmp",2;
		mes "[艾莉]";
		mes "北方是被封锁的土地。穿过结界并不容易。";
		next;
		cutin "ep18_miriam_01.png",0;
		mes "[米里亚姆]";
		mes "因为有结界，所以我们无法穿过吗？";
		mes "那么巴戈特是利用伊米尔之心穿过结界的吗？";
		next;
		mes "[米里亚姆]";
		mes "要追踪他，我们需要找到穿过阻挡北方的结界的方法。";
		mes "这需要时间。";
		next;
		cutin "ep172_beta.bmp",2;
		mes "[艾莉]";
		mes "这件事交给我。";
		mes "让我回到宅邸，寻找穿过结界的方法。";
		next;
		mes "[艾莉]";
		mes "我不是在夸口，但如果你利用了主人的不公，你应该就能想办法穿过那道结界，对吧？";
		mes "如果利用那份不公，就能追踪到痕迹。";
		next;
		mes "[艾莉]";
		mes "我要回到管理员的本体那里。把这个外壳送给冒险者当纪念品。";
		mes "宅邸见。";
		ep18_main = 57;
		completequest 18085;
		delitem 400127,1;	// Ep18_Mini_Elly
		getitem 400128,1;	// Costume Dropping Elly
		getitem 1000405,180;	// Ep18_Amethyst_Fragment
		getexp 18252408,2000000;
		next;
		cloakonnpcself( "Elly's Figure#c12_02" );
		cutin "ep18_miriam_01.png",0;
		mes "[米里亚姆]";
		mes "在收集到更多信息之前，我们什么也做不了。";
		mes "我会再和父亲谈谈。";
		mes "谢谢你的帮助。";
		next;
		cutin "ep18_suad_01.png",0;
		mes "[苏阿德]";
		mes "那么我就回灰狼森林。";
		mes "尼伦，议会成立后请叫我回来。在那之前我会做好准备。";
		next;
		cutin "ep18_maram_01.png",2;
		mes "[马拉姆]";
		mes "那么我去和米里亚姆一起听尤瑟的故事吧？";
		mes "我想帮忙寻找伊米尔之心的碎片。";
		next;
		cutin "ra_gwoman.bmp",2;
		mes "[尼伦]";
		mes "那么我去见杰德副官。";
		mes "冒险者，你又一次帮了我们大忙。";
		next;
		mes "[尼伦]";
		mes "祈祷总是指向神明，";
		mes "用来支持许下愿望的人……";
		mes "但尤瑟祈求的究竟是什么？";
		next;
		mes "[尼伦]";
		mes "那份祈祷的尽头，只有毁灭。";
		mes "...";
		close3;
	}
	end;

OnInit:
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "isbegin_quest(18085) == 1" );
	end;
}

ra_temin,254,114,7	script(CLOAKED)	Suad#c12last	4_EP18_SUAD,{
	if (ep18_main < 57) {
		npctalk "...", "Suad#c12last", bc_self;
		end;
	}
	npctalk "谢谢你帮助灰狼森林。", "Suad#c12last", bc_self;
	end;
}

ra_temin,258,114,3	script(CLOAKED)	Niren#c12last	4_F_RACHOLD,{
	npctalk "我没想到尤特会是那样……", "Niren#c12last", bc_self;
	end;
}

ra_temin,259,111,1	script(CLOAKED)	Maram#c12last	4_EP18_MARAM,{
	if (ep18_main < 57) {
		npctalk "米里亚姆带来了一些信息，我们一起听听吧。", "Maram#c12last", bc_self;
		end;
	}
	npctalk "如果你去寻找那颗心时我能同行，我会非常感激。", "Maram#c12last", bc_self;
	end;
}




		mes "这里的道路很崎岖，小心一点。";
		mes "不注意的话可能会滑倒，扭伤脚踝。";
		cutin "ep18_imril_02.png",2;
		next;
		mes "[伊姆里尔]";
		mes "我们从这里直走下去吧。";
		if (isbegin_quest(11727) == 1) {
			erasequest 11727;
			setquest 11728;
		}
		close2;
		cutin "",255;
		navigateto("oz_dun01",111,96);
		end;
	}
	end;

OnInit:
	questinfo( QTYPE_QUEST2, QMARK_YELLOW, "isbegin_quest(11727) == 1" );
	end;
}


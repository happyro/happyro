					case 3: mes "...Behbie~"; close;
					}
				case 4:
					mes "[Uwe]";
				mes "保重，";
				mes "可爱的冒险者！";
				mes "呵呵呵！";
					close;
				}
			}
		}
		else if (ein_cook == 0) {
			mes "[Uwe]";
		mes "烹饪真是快乐~！";
		mes "香气、味道，还有纯粹^EEA9B8饱腹感^000000的体验……";
			next;
		switch(select("嗯，这不是铁匠铺吗？:忽略他。")) {
			case 1:
				mes "[Uwe]";
				set ein_cook,1000;
		mes "这是铁匠铺吗？";
		mes "哦，亲爱的，";
		mes "你以前没来过这里，";
		mes "对吧？";
				next;
				mes "[Uwe]";
		mes "我叫 Uwe Kleine，";
		mes "这里是我的铁匠铺~！";
		mes "我是施瓦茨瓦尔德共和国";
		mes "最优雅的铁匠";
		mes "也是最好的厨师~";
				next;
				mes "[Uwe]";
		mes "那么，我能怎么帮助";
		mes "你这个";
		mes "超级可爱的";
				if (Sex == SEX_MALE) {
					mes "帅气男人？";
				}
				else {
					mes "女性女士？";
				}
				next;
				switch(select("谈谈艾因布罗赫。:请他锻造武器。:师傅，我想学烹饪。:取消。")) {
				case 1:
					mes "[Uwe]";
					mes "艾因布罗赫最初是为了";
					mes "支持艾因贝赫的采矿而建。";
					mes "那里地方小、人又多，";
					mes "没有空间建造矿石精炼工厂。";
					next;
					mes "[Uwe]";
					mes "艾因布罗赫过去是一片空地，";
					mes "非常适合建工厂。";
					mes "这是我祖父很久以前告诉我的。";
					mes "总之，艾因布罗赫很快发展成了大城市。";
					next;
					mes "[Uwe]";
					mes "现在人们认为这座城市";
					mes "从未计划成为艾因贝赫的延伸。";
					mes "看到那边的城墙了吗？";
					mes "它根本没有连接艾因贝赫！";
					mes "那里的人毫无保护……";
					next;
					mes "[Uwe]";
					mes "就像政府";
					mes "已经对艾因贝赫失去兴趣。";
					mes "那里的矿工也纷纷搬来这里";
					mes "在工厂工作。";
					mes "但人口增加并没有让城市更有活力。";
					next;
					mes "[Uwe]";
					mes "艾因布罗赫现在看起来现代而热闹，";
					mes "但很快你就会发现这里没有";
					mes "温暖或生命的痕迹。";
					mes "所以……老了别住在这里。";
					next;
					switch(select("Then why are you here?:I won't. Thanks for the advice.")) {
					case 1:
						mes "[Uwe]";
					mes "嗯，我对这里有些";
					mes "珍贵的回忆。";
					mes "曾经有个住在这里的人，";
					mes "对我来说就像父亲一样。";
						next;
						mes "[Uwe]";
					mes "哦，不过我确定你不想听。";
					mes "下次来时我们聊点";
					mes "更有趣的，好吗？";
					mes "暂时再见，可爱的~";
						close;
					case 2:
						mes "[Uwe]";
					mes "哦，这是多么好的决定，";
					mes "亲爱的！哦，你们这些";
					mes "可爱的冒险者";
					mes "真是珍贵又讨人喜欢。";
						mes "^333333*Tee hee hee~*^000000";
						next;
						mes "[Uwe]";
					mes "好了，聊得很开心。";
					mes "下次再来拜访，好吗？";
					mes "在那之前我会想你的~";
						close;
					}
				case 2:
					mes "[Uwe]";
					mes "嗯……";
					mes "我其实只是锻造";
					mes "自己的烹饪工具。";
					next;
					mes "[Uwe]";
					mes "哦，我明白有人需要";
					mes "与魔物战斗，";
					mes "但你找错人锻造武器了。";
					mes "我……是严格的和平主义者~";
					next;
					mes "[Uwe]";
					mes "你在附近找找，";
					mes "一定能找到愿意";
					mes "为你锻造好武器的铁匠~";
					close;
				case 3:
					mes "[Uwe]";
					mes "嗯……？";
					mes "你刚才是说";
					mes "想学习烹饪艺术吗？";
					next;
					mes "[Uwe]";
					mes "抱歉，我不能真正教授";
					mes "烹饪课程。";
					mes "但我会给初学者";
					mes "一些好建议。";
					next;
					mes "[Uwe]";
					mes "现在……";
					mes "作为学费我需要——天哪，";
					mes "东西太多了。";
					mes "拿纸和笔记下这份清单……";
					next;
					set ein_cook,ein_cook+100;
					mes "[Uwe]";
					mes "开玩笑的！";
					mes "^333333*窃笑~*^000000我不需要";
					mes "用来制作烹饪器具。带来";
					mes "6个^0000FF大杰勒比^000000。就是这些！";
					next;
					mes "[Uwe]";
					mes "作为回报，我会给你";
					mes "1 块煤炭和烹饪初学者的实用建议。";
					mes "不过我给铁匠同事的建议";
					mes "一向是免费的……";
					next;
					mes "[Uwe]";
					mes "你为什么不成为";
					mes "^EEA9B8铁匠^000000？";
					mes "我对那个领域更有信心。^333333*嘻嘻~*^000000";
					next;
					mes "[Uwe]";
					mes "那么，我会一直";
					mes "在这里等你回来。";
					switch(rand(1,3)) {
					case 1: mes "...Ho ho~"; close;
					case 2: mes "...*Tee Hee~*"; close;
					case 3: mes "...Behbie~"; close;
					}
				case 4:
					mes "[Uwe]";
					mes "保重，亲爱的~";
					mes "呵呵呵！";
					close;
				}
			case 2:
				mes "[Uwe]";
				mes "烹饪始于火焰";
				mes "也终于火焰。";
				mes "创造美味佳肴、";
				mes "满足味蕾";
				mes "是一门艺术~";
				close;
			}
		}
	}
}


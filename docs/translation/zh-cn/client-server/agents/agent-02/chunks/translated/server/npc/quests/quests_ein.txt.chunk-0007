einbroch,132,84,3	script	Liotzburg#ein	853,2,2,{
	if (EinFactory == 13 || EinFactory == 14) {
		if (isbegin_quest(8029) == 1)
			changequest 8029,8030;
		set EinFactory,14;
		mes "[Liotzburg]";
	mes "什么……？";
	mes "工厂维修";
	mes "预算？不可能！";
		next;
		mes "[Liotzburg]";
	mes "为什么要浪费钱？";
	mes "我们一直没有";
	mes "遇到任何问题！看，";
	mes "一切都很好！为什么";
		mes "你是不是把";
		mes "这么小的细节夸大了？";
		next;
		mes "[Liotzburg]";
		mes "现场主管 Zelmeto";
		mes "刚来要求增加预算。";
		mes "我觉得他在撒谎！";
		mes "一切都很完美！";
		close;
	}
	mes "[Liotzburg]";
	mes "我是这家工厂的厂长。";
	mes "我的大多数员工都很勤奋。";
	mes "虽然不能说每个人都如此，但总体工作非常出色。哈哈哈~！";
	next;
	mes "[Liotzburg]";
	mes "只要工厂维护良好，";
	mes "我们就不用担心城市安全。";
	mes "现场主管 Zelmeto";
	mes "也非常可靠。";
	next;
	mes "[Liotzburg]";
	mes "我可以信任 Zelmeto";
	mes "照看一切，";
	mes "所以我没必要";
	mes "进入工厂。";
	mes "把工作委托出去真棒！";
	next;
	mes "[Liotzburg]";
	mes "我们的工厂会继续发展，";
	mes "每个人都会为";
	mes "我们取得的进步感到自豪。";
	mes "我可以向你保证！";
	close;

OnTouch_:
	if ($EinPolution > 9 && !$@AlrdEinPoll) {
		mes "[Liotzburg]";
		mes "发生什么了？！";
		mes "谁该负责？！";
		mes "天哪，我不敢相信";
		mes "竟然发生了这种事！";
		mes "^333333*Cough Cough!*^000000";
		next;
		mes "[Liotzburg]";
		mes "我得离开这里！";
		mes "你！做点什么，";
		mes "修好它！我得躲起来";
		mes "找个安全的地方！";
		close2;
 		if ($EinPolution > 9 && !$@AlrdEinPoll) {
			donpcevent "Einbroch Smog Alert::OnEnable";
			hideonnpc "Liotzburg#ein";
		}
		end;
	}
	else {
		end;
	}
}

ein_in01,67,242,3	script	Zelmeto	851,{
	if ($EinPolution > 9) {
		mes "[Zelmeto]";
		mes "这里出了大问题！";
		mes "感谢你一直收集材料，";
		mes "但机器已经";
		mes "坏太久了！";
		next;
		mes "[Zelmeto]";
		mes "我刚尝试修理，";
		mes "就发生了严重短路。";
		mes "我们的城镇现在";
		mes "可能充满了";
		mes "有毒烟雾！";
		next;
		mes "[Zelmeto]";
		mes "我会尽力修好，";
		mes "但我们本该早点";

hugel,107,67,3	script	Torpy	706,{
	if (BaseLevel > 49) {
		if (!hg_ubu01) {
			mes "[Torpy]";
			mes "爸、爸爸……！";
			mes "爸爸你在哪里？！哇~！";
			next;
			switch(select("怎么了？:无视")) {
			case 1:
				mes "[Torpy]";
				mes "我爸爸已经好几天";
				mes "没回家了。我担心他一定";
				mes "出了什么事。*吸鼻子*";
				next;
				mes "["+strcharinfo(0)+"]";
				mes "你爸爸失踪了？";
				mes "告诉我你最后一次见到他时的情况吧。";
				next;
				mes "[Torpy]";
				mes "我们当时在玩捉迷藏，";
				mes "轮到他躲起来，";
				mes "然后、然后……";
				mes "我一直没找到他！";
				next;
				switch(select("真的吗？再告诉我一些……:什么，就这些吗……？")) {
				case 1:
					mes "[Torpy]";
					mes "然、然后妈妈因为爸爸躲太久而生气。";
					mes "但她去找他时，也失踪了！";
					mes "我、我现在只剩一个人了！哇啊啊~！";
					next;
					emotion ET_THINK, playerattached();
					mes "["+strcharinfo(0)+"]";
					mes "别担心，我会去找你的父母。";
					mes "我一定能在城外找到他们至少一人。";
					set hg_ubu01,1;
					setquest 12044;
					close;
				case 2:
					mes "["+strcharinfo(0)+"]";
					mes "别担心，你爸爸迟早会出现的。";
					mes "孩子，祝你好运。";
					emotion ET_THINK, playerattached();
					close;
				}
			case 2:
				mes "[Torpy]";
				mes "爸、爸爸……！";
				mes "妈——妈——！";
				mes "你在哪里？！";
				mes "呜——哇啊啊啊！";
				close;
			}
		} else if (hg_ubu01 == 2) {
			mes "[Torpy]";
			mes "哦……";
			mes "妈妈只是去城外了吗？";
			mes "去城外了吗？";
			mes "*抽泣* 好吧，希望我";
			mes "爸爸很快就会回来……";
			set hg_ubu01,3;
			changequest 12045,12046;
			close;
		} else if (hg_ubu01 == 6) {
			mes "[Torpy]";
			mes "你、你找到我爸爸了！";
			mes "太好了！我一直很担心他！";
			mes "谢、谢谢你的帮助！";
			next;
			mes "[Torpy]";
			mes "嗯，嗯……爸爸";
			mes "到底躲在哪里呢？";
			mes "哦？一个桶？";
			mes "在哪来着？嘿嘿！";
			mes "现在我能找到他了！";
			next;
			mes "[Torpy]";
			mes "哦，你能去和妈妈谈谈，";
			mes "告诉她";
			mes "请她来这里，好吗？";
			mes "也告诉她爸爸";
			mes "很安全！回头见~";
			next;
			emotion ET_THINK, playerattached();
			mes "......";
			mes ".........";
			mes "............";
			next;
			mes "[Torpy]";
			mes "^333333...............................";
			mes "嘻嘻~等我找到爸爸，";
		mes "他一定要带我";

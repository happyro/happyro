		close;
	} else {
		mes "[Manainne]";
		mes "你知道，虽然这里并不富裕，";
		mes "但我真的很喜欢这个";
		mes "小而安静的城镇。";
		mes "就算能住在世界任何地方，";
		mes "我也会选择住在这里~";
		close;
	}
}

niflheim,90,106,3	script	A Spirit#HQuest	802,{
	if (hg_memory == 6) {
		mes "[Spirit]";
		mes "El Schatt……";
		mes "Manainne……";
		mes "我想念他们……";
		next;

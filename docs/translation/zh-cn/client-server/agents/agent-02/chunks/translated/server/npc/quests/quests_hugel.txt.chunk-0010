hugel,100,103,3	script	Perfitz	866,{
	if (hg_memory == 3) {
		set hg_memory,4;
		mes "[Perfitz]";
		mes "我很高兴儿子终于决定";
		mes "继承家族事业。我没想到";
		mes "他竟有成为积极企业家的潜力。";
		next;
		mes "[Perfitz]";
		mes "真有趣……以前为了在那棵树";
		mes "所在的地方建商店，他总是";
		mes "拼命和我争论。没错，我为他";
		mes "成长为商人感到骄傲。嘿嘿~";
		next;
		mes "[Perfitz]";
		mes "虽然我很高兴，但总觉得";
		mes "有哪里不对。他似乎太兴奋了，";
		mes "竟然想砍掉那棵树。也许只是";
		mes "我这个老人太多疑了~";
		changequest 8059,8060;
		close;
	} else if (hg_memory == 4) {
		mes "[Perfitz]";
		mes "事情变化得真有趣。你知道，";
		mes "El Schatt 以前其实反对我在那棵树生长的区域建商店。嗯……他到底怎么了？";
		close;
	} else {
		mes "[Perfitz]";
		mes "金钱非常可靠……但它的价值";
		mes "是相对的，随时都可能改变。";
		mes "不过到了我这个年纪，不能没有钱。";
		mes "一定要为老年做好财务准备。";
		next;
		mes "[Perfitz]";
		mes "现在大多数人以为我朋友很少，";
		mes "因为我比起人更信任金钱。";
		mes "这有一定道理：金钱永远不会背叛你，";
		mes "而且很少有朋友能如此可靠。";
		next;
		mes "[Perfitz]";
		mes "不过，值得终身信赖的朋友";
		mes "比世上的所有金钱都珍贵。";
		mes "对我这样的富人来说，";
		mes "那才是唯一值得拥有的朋友。";
		close;
	}
}

hugel,196,164,3	script	El Schatt	50,{
	if (hg_memory == 2) {
		mes "[El Schatt]";
		mes "什么？你为什么这样看我？";
		mes "哦，你一定和玛奈恩谈过了。";
		mes "听着，回忆虽然美好，但我不沉溺于过去。";
		mes "我会考虑未来，那才是最好的。";
		next;
		mes "[El Schatt]";
		mes "嘿，我对这里也有美好的回忆，";
		mes "但你知道吗？我决定在回忆变得太痛苦前放下它们。";
		mes "这就是人生。而且事情也没那么糟。";
		next;
		mes "[El Schatt]";
		mes "我父亲一直想在这里建商店，";
		mes "现在我觉得时机到了。这项生意会帮助整个社区。";
		mes "我们早就该这么做了……";
		next;
		set hg_memory,3;
		mes "[El Schatt]";
		mes "来吧……看看周围。";
		mes "我不否认这是个古朴可爱的城镇，";
		mes "但你觉得这里的人能享受多少钱？";
		mes "我必须着眼于未来……";
		changequest 8058,8059;
		close;
	} else if (hg_memory == 3) {
		mes "[El Schatt]";
		mes "这里是建商店的完美地点。";
		mes "没错，我要建一整座广场，";
		mes "租给商人。发展商业，吸引商家……";
		next;
		mes "[El Schatt]";
		mes "大家都该忘了那棵树。";
		mes "仔细想想，它只是在浪费空间……";
		close;
	} else if (hg_memory == 4) {
		set hg_memory,5;
		mes "[El Schatt]";
		mes "你和我父亲谈过了？";
		mes "哼！别告诉我你是来改变我想法的。";
		mes "我要建那些商店，就这么定了。";
		mes "想说服我改变主意是没用的。明白吗？";
		next;
		mes "[El Schatt]";
		mes "我以前确实有不同的想法……";
		mes "我曾经愿意用生命保护那棵老树，这点我不否认。";
		mes "但那已经是应该埋葬在过去的旧事了……";
		changequest 8060,8061;
		close;
	} else if (hg_memory == 5) {
		mes "[El Schatt]";
		mes "过去就让它过去吧。现在";
		mes "我必须专心发展家族事业。";
		mes "父亲一直都是对的……";
		close;
	} else if (hg_memory == 7) {
		mes "[El Schatt]";
		mes "你说什么……？";
		mes "你见过卡奈恩？";
		mes "听着，这一点都不好笑。";
		mes "我不接受这种恶心的玩笑，";
		mes "趁我还没生气，赶紧离开。";
		close;
	} else if (hg_memory == 10) {
		mes "[El Schatt]";
		mes "不可能……！";
		mes "卡奈恩死了！";
		mes "我无法相信这件事！";
		next;
		mes "[Manainne]";
		mes "......";
		mes ".........";
		mes "............";
		close;
	} else if (hg_memory == 11) {
		mes "[El Schatt]";
		mes "卡、卡奈恩！^333333*抽泣*^000000";
		mes "我好想你！";
		mes "你为什么要离开我？";
		next;
		mes "[Manainne]";
		mes "哦，亲爱的，";
		mes "我可爱的 El Schatt……";
		mes "对不起。但那就是我的命运……";
		mes "我的时间到了……";
		mes "你必须放下我……";
		next;
		mes "[El Schatt]";
		mes "我再也承受不住了！";
		mes "没有你太痛苦了！";
		mes "我无法停止想起我们，";
		mes "想起那些回忆……所有回忆";
		mes "都让我如此痛苦……";
		next;
		mes "[Manainne]";
		mes "所以你才想砍掉那棵树吗？";
		mes "因为它让你想起我们共度的时光？";
		next;
		mes "[El Schatt]";
		mes "是、是的！看到它让我又生气又难过！";
		mes "我想把它除掉！";
		mes "如果我忘不了你，那该怎么办？";
		mes "我、我能忘掉你吗？";
		next;
		mes "[Manainne]";
		mes "毁掉那棵树会让你开心吗？";
		mes "忘记我，你觉得自己会开心吗？";
		mes "我知道你不是那样的人，El Schatt。";
		mes "你没那么冷酷……";
		next;
		mes "[El Schatt]";
		mes "不……我不想忘记你，";
		mes "忘记我们所有的美好时光。但我太想你了……";
		mes "我觉得自己快疯了！不知道能否承受这种痛苦！";
		next;
		mes "[Manainne]";
		mes "为了我坚强一点，El Schatt。";
		mes "总有一天，时间会治愈你的伤口，";
		mes "你对我的回忆只会带来温暖，而非痛苦。";
		mes "我也想你，El Schatt，而且我……";
		next;
		mes "[El Schatt]";
		mes "卡奈恩……？";
		mes "卡、卡奈恩？";
		mes "发生什么事了？";
		next;
		mes "[Manainne]";
		mes "El Schatt，对不起……";
		mes "但我现在必须走了。我不能在生者的世界停留太久，";
		mes "我的时间快到了。我还……我……";
		next;
		mes "[El Schatt]";
		mes "不、不！求你留在我身边！";
		mes "我还没准备好再次失去你！别、别离开！";
		mes "me again! Nooo! Kanainne!";
		mes "我需要你留在我身边！";
		next;
		mes "[Manainne]";
		mes "我做不到……";
		mes "但求你了，El Schatt……";
		mes "答应我，从今以后做自己……";
		mes "保持善良……追随真正的梦想……";
		next;
		mes "[Manainne]";
		mes "不要砍掉那棵树……还有，创作……";
		mes "创作美妙的音乐。请完成那首为我写的歌……";
		mes "为了我们两个人……";
		next;
		mes "[El Schatt]";
		mes "为了你，什么都可以，";
		mes "卡奈恩。我发誓……";
		next;
		mes "[Manainne]";
		mes "El Schatt...";
		mes "我还……我还……";
		next;
		mes "[El Schatt]";
		mes "是、是的……";
		mes "卡奈恩……？";
		next;
		mes "[Manainne]";
		mes "......";
		mes ".........";
		mes "............";
		next;
		mes "^3355FF*Thud!*^000000";
		next;
		mes "[El Schatt]";
		mes "卡奈恩……？";
		mes "卡奈恩！";
		next;
		mes "[Manainne]";
		mes "……我……";
		mes "……El Schatt……";
		mes "她又离开了。";
		mes "我是……玛奈恩……";
		mes "^333333*吸鼻子*^000000她必须回去了……";
		next;
		specialeffect2 EF_CONE;
		set hg_memory,12;
		getexp (checkre(3))?8000:50000,0;
		completequest 8063;
		getitem 603,1; //Old Blue Box
		mes "[El Schatt]";
		mes "哦……天啊，";
		mes "亲爱的上帝……我的……";
		mes "我亲爱的卡奈恩……";
		mes "不……不……求你……";
		close;
	} else if (hg_memory == 12) {
		mes "[El Schatt]";
		mes "……请你离开我好吗？我有……";
		mes "有很多事情要想。还有音乐要写……";
		close;
	} else {
		mes "[El Schatt]";
		mes "父亲是对的……";
		mes "这里是建商店的完美地点。";
		mes "现在只要砍掉那棵老树。";
		mes "它挡住了很多东西……";
		close;
	}

}


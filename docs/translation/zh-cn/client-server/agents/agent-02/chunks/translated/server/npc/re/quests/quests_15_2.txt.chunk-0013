		mes "我太骄傲，不好意思问别人。";
		close;
	}
	if (.@cooldown_status_day[2] == 1) {
		mes "[冒险者班达库]";
		mes "我已经调查这个32天了，但仍不知道是什么。";
		next;
		mes "[冒险者班达库]";

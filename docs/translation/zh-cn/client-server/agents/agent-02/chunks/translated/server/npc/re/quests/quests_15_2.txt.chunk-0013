		next;
		mes "[化学物质专家科莉]";
		mes "我们把危险物品严密藏好，但以防万一不要碰任何东西。";
		close;
	}
	if (.@cooldown_status_day[2] == 1) {
		mes "[化学物质专家科莉]";
		mes "卡斯滕给了我葡萄。";
		next;
		mes "[化学物质专家科莉]";
		mes "真新鲜，真好吃。";
		close;
	}
	if (.@cooldown_status_day[3] == 1) {
		mes "[化学物质专家科莉]";
		mes "我的同事离开防空洞去调查，还没有回来。";
		next;
		mes "[化学物质专家科莉]";
		mes "结论是他们已经死亡，但真的全死了吗？我想见同事。";
		close;
	}
	if (.@cooldown_status_day[4] == 1) {
		mes "[化学物质专家科莉]";
		mes "做得好。";
		next;
		mes "[化学物质专家科莉]";
		mes "我们正在寻找污染物的解决方案。";
		close;
	}
	// unknown text
	end;
}

un_bk_q,161,193,6	script	Adventurer Bamdaku#EP15.2MR	4_M_ALCHE_C,{
	callfunc( "F_time_limit_recorder", .@cooldown_status_day,1,0 );

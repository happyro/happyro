		mes "首先，化学物质专家和设施管理员开始在防空洞安装空气污染检测仪。";
		next;
		mes "确认氧气浓度较低后，机械师开始组装空气净化器。";
		next;
		mes "前食堂员工洛拉被请来处理食物这一重要问题。";
		next;
		mes "根据仓库食物和幸存者人数评估，大约可以生存40天。";
		next;
		mes "因此生物工程师开始培育能够自行繁殖的植物。";
		next;
		mes "其他杂项任务由弗雷斯安排。";
		next;
		if (select( "继续听取。", "退出。" ) == 2)
			close;
		mes "爆炸第5天";
		next;
		mes "我不知道详情，但已经测量了防空洞外的空气污染程度。";
		next;
		mes "根据化学物质专家的说法，情况没有希望。";
		next;
		mes "看来必须在防空洞继续生活更久。只能安静地继续工作……";
		next;
		if (select( "继续听取。", "退出。" ) == 2)
			close;
		mes "爆炸第21天";
		next;
		mes "默默工作几天后，生物工程师带来了好消息。";
		next;
		mes "他们成功人工培育出能够自行繁殖的植物。";
		next;
		mes "幸运的是，防空洞有足够宽敞的仓库可以种植植物。";
		next;
		mes "看来现在可以不用担心食物问题了。";
		next;
		if (select( "继续听取。", "退出。" ) == 2)
			close;
		mes "爆炸第30天";
		next;
		mes "防空洞发生了小问题。最初制作的空气净化器坏了。";
		next;
		mes "幸运的是，多亏机械师未经批准制作的空气净化器，维持氧气浓度没有问题。";
		next;
		mes "它们太重了，所以派遣冒险者搬运，因为没有其他人能移动它们。";
		next;
		if (.@cooldown_status_day[1] == 1) {
			mes "没有更多记录内容。";
			next;
			if (select( "再听一次。", "退出。" ) == 2)
				close;
			continue;
		}
		if (select( "继续听取。", "退出。" ) == 2)
			close;
		mes "爆炸第32天";
		next;
		mes "今天是生物工程师培育的葡萄树第一次收获。";
		next;
		mes "虽然机械师毁掉了一棵葡萄树，造成了小问题";
		next;
		mes "防空洞居民正在举办小型聚会庆祝成功收获。";
		next;
		if (.@cooldown_status_day[2] == 1) {
			mes "没有更多记录内容。";
			next;
			if (select( "再听一次。", "退出。" ) == 2)
				close;
			continue;
		}
		if (select( "继续听取。", "退出。" ) == 2)
			close;
		mes "爆炸第38天";
		next;
		mes "一些厌倦防空洞生活的化学物质专家和冒险者离开防空洞测量空气。";
		next;
		mes "到了晚上他们还没有回来。";
		next;
		mes "外面的自由比黑暗防空洞里的生活更好吗？";
		next;
		mes "午夜后，剩下的化学物质专家判断他们已经死亡，所有人短暂默哀。";
		next;
		if (select( "继续听取。", "退出。" ) == 2)
			close;
		mes "爆炸第40天";
		next;
		mes "防空洞里流传着黑暗的传闻。";
		next;
		mes "传闻外界污染物因为此前离开的人侵入了防空洞。";
		next;
		mes "是污染物造成的吗？有些病人突然抽搐并攻击他人。";
		next;
		mes "在领袖弗雷斯决定下，所有人接受检查，发现感染者后被隔离在临时诊所。";
		next;
		if (.@cooldown_status_day[3] == 1) {
			mes "没有更多记录内容。";
			next;
			if (select( "再听一次。", "退出。" ) == 2)
				close;
			continue;
		}
		if (select( "继续听取。", "退出。" ) == 2)
			close;
		mes "爆炸第43天";
		next;
		mes "防空洞里的传闻成真了。";
		next;
		mes "剩下的化学物质专家确认污染物正在侵蚀防空洞";
		next;
		mes "弗雷斯和专家开始采取措施。";
		next;
		if (select( "继续听取。", "退出。" ) == 2)
			close;
		mes "爆炸第45天";
		next;
		mes "入侵的污染物不会停止。";
		next;
		mes "已经决定把所有设备和必需品搬到污染较少的Z-2区";
		next;
		mes "设施管理员开始在Z-0区安装隔断，防止污染物进一步进入。";
		next;
		mes "没有更多记录内容。";
		next;
		if (select( "再听一次。", "退出。" ) == 2)
			close;
	}
	end;
}

un_bk_q,108,243,4	script	Discarded Mechanical Device#EP15.2MR	4_ENERGY_BLUE,{
	callfunc( "F_time_limit_recorder", .@cooldown_status_day,1,0 );
	if (.@cooldown_status_day[0] == 1) {
		mes "扔在地上的机械装置无法判断是否还能运行。";
		close;
	}
	mes "这里有一份正在被记录的记忆记录。";
	next;
	if (select( "听取。", "退出。" ) == 2)
		close;
	while(1) {
		mes "哦——这是记忆记录吗？能用吗？哦，能用。能用！我这么无聊，要不要试试？";
		next;
		mes "我叫马索，是环游世界的冒险者。今天是进入防空洞的第4天？第3天？这里的气氛很奇怪，很难适应。";
		next;
		mes "维鲁斯城原本的居民中也有冒险者，但他们对冒险者的待遇好得奇怪。";
		next;
		mes "气氛是把冒险者当作卷入无法控制事故、需要善待的人。";
		next;
		mes "作为一个吃喝玩乐和工作一样多的冒险者，我无法忍受想行动的冲动。呃。";
		next;
		if (select( "继续听取。", "退出。" ) == 2)
			close;
		mes "今天是第6天吗？冒险者不会被告知详情，所以我不确定，但维鲁斯城的人似乎很阴郁。";
		next;
		mes "冒险者的血液沸腾，想探索各处，但没什么可做。";
		next;
		mes "我查看了防空洞，但设计它的人一点艺术细胞都没有。";
		next;
		mes "一直看着相同的走廊和房间布局，真没意思。";
		next;
		if (select( "继续听取。", "退出。" ) == 2)
			close;
		mes "今天是第21天吗？维鲁斯城的人似乎很高兴解决了食物问题。";
		next;
		mes "看着那些外表温和的研究员到处欢呼尖叫，真可爱。";
		next;
		if (select( "继续听取。", "退出。" ) == 2)
			close;
		mes "第30个夜晚，但这里总是黑暗，我不知道是白天还是夜晚。刚吃完晚饭，应该是夜晚。";
		next;
		mes "今天我和其他冒险者搬运了机械师制作的沉重空气净化器。";
		next;
		mes "防空洞太大了，我不知道它们原本在哪里，但多亏这件事，我和一些冒险者成为朋友，尤其是卡斯尔和布拉特。";
		next;
		mes "顺便说，机械师似乎有精神问题。他们因为无法制造机器而大吵大闹，被警卫拖了出去。";
		next;
		mes "机械师迟早会惹出麻烦。";
		next;
		if (.@cooldown_status_day[1] == 1) {
			mes "没有更多记录内容。";
			next;
			if (select( "再听一次。", "退出。" ) == 2)
				close;
			continue;
		}
		if (select( "继续听取。", "退出。" ) == 2)
			close;
		mes "今天是第32天，我参与了葡萄收获。";
		next;
		mes "我吃了新鲜葡萄，反正没什么事，我要早点睡。";
		next;
		mes "啊……葡萄真好吃，我还想再吃。他们说每两周可以收获一次吗？";
		next;
		if (.@cooldown_status_day[2] == 1) {
			mes "没有更多记录内容。";
			next;
			if (select( "再听一次。", "退出。" ) == 2)
				close;
			continue;
		}
		if (select( "继续听取。", "退出。" ) == 2)
			close;
		mes "今天是进入防空洞的第38天，从早上起就一片混乱。";
		next;
		mes "今天早上，招募的冒险者加入化学物质专家，在防空洞外进行调查，尽管危险，仍有许多人自愿参加。";
		next;
		mes "我认为应该避免危险，但我的朋友卡斯尔和布拉特自愿参加了。";
		next;
		mes "我理解他们已经厌倦了在防空洞生活。";
		next;
		mes "下午过后他们还没回来。维鲁斯城领袖弗雷斯判断离开的人已经死亡。";
		next;
		mes "黎明时所有人默哀了一会儿。他们是好人，以这样的方式告别令人悲伤。";
		next;
		if (select( "继续听取。", "退出。" ) == 2)
			close;
		mes "这是第40天早上吗？防空洞里出现了神秘传染病。";
		next;
		mes "有几个人突然攻击身边的人并抽搐";
		next;
		mes "许多虚弱的研究员受伤，因此派遣冒险者压制抽搐的人。";
		next;
		mes "传闻污染物是因为之前走出防空洞的人而进入的。";
		next;
		if (.@cooldown_status_day[3] == 1) {
			mes "没有更多记录内容。";
			next;
			if (select( "再听一次。", "退出。" ) == 2)
				close;
			continue;
		}
		if (select( "继续听取。", "退出。" ) == 2)
			close;
		mes "第44天午餐时，防空洞领袖弗雷斯召集冒险者并进行了说明。";
		next;
		mes "传闻已被证实，Z-0区将建造安全隔断。";
		next;
		mes "决定明天将必需品搬到Z-2区，我听说他们需要冒险者的帮助。";
		next;
		mes "我明天还要工作，所以要早点睡。";
		next;
		mes "没有更多记录内容。";
		next;
		if (select( "再听一次。", "退出。" ) == 2)
			close;
	}
	end;
}

un_bk_q,34,138,4	script	Warehouse Keeper Pik#EP15.2MR	4W_M_03,{
	callfunc( "F_time_limit_recorder", .@cooldown_status_day,1,0 );
	if (.@cooldown_status_day[0] == 1) {
		mes "[仓库管理员皮克]";
		mes "我不知道你来这里做什么，但请不要碰任何东西。";
		next;
		mes "[仓库管理员皮克]";
		mes "我还没完成库存检查，要是东西丢了会很麻烦。";
		close;
	}
	if (.@cooldown_status_day[1] == 1) {
		mes "[仓库管理员皮克]";
		mes "你是冒险者。不需要把空气净化器送到这里。";
		next;
		mes "[仓库管理员皮克]";
		mes "这里毕竟是仓库，独立空气循环系统已经够用了。";
		close;
	}
	if (.@cooldown_status_day[2] == 1) {
		mes "[仓库管理员皮克]";
		mes "啊——照看仓库真烦。";
		next;
		mes "[仓库管理员皮克]";
		mes "没有人和我轮班";
		close;
	}
	if (.@cooldown_status_day[3] == 1) {
		mes "[仓库管理员皮克]";
		mes "什……什么……等等，停下！！";
		next;
		mes "[仓库管理员皮克]";
		mes "你不是来伏击我的吧？如果不是就好。";
		close;
	}
	if (.@cooldown_status_day[4] == 1) {
		mes "[仓库管理员皮克]";
		mes "你是来搬东西的吗？";
		next;
		mes "[仓库管理员皮克]";
		mes "我想今天不该搬这个仓库里的货物吧？据我所知，今天应该先搬运必需品。";
		close;
	}
	// unknown text
	end;
}

un_bk_q,91,283,2	script	Guard#EP15.2MR	4_M_HUMAN_02,{
	callfunc( "F_time_limit_recorder", .@cooldown_status_day,1,0 );
	if (.@cooldown_status_day[0] == 1) {
		mes "[警卫]";
		mes "你好，冒险者？";
		next;
		mes "[警卫]";
		mes "我不知道原因，但弗雷斯把我安排在这里。";
		close;
	}
	if (.@cooldown_status_day[1] == 1) {
		mes "[警卫]";
		mes "我一直疑惑为什么被安排在这里，现在想我知道原因了。";
		next;
		mes "[警卫]";
		mes "这是为了监视机械师是否制造无用的东西。";
		close;
	}
	if (.@cooldown_status_day[2] == 1) {
		mes "[警卫]";
		mes "机械师偶尔想制造东西。";
		next;
		mes "[警卫]";
		mes "我的工作就是阻止他们。";
		close;
	}
	if (.@cooldown_status_day[3] == 1) {
		mes "[警卫]";
		mes "我听说最近病人会抽搐并攻击周围的人？";
		next;
		mes "[警卫]";
		mes "机械师总是抽搐着说想制造东西，所以我并不觉得奇怪。";
		close;
	}
	if (.@cooldown_status_day[4] == 1) {
		mes "[警卫]";
		mes "机械师的抽搐越来越严重。";
		next;
		mes "[警卫]";
		mes "他们抽搐得太厉害，我可能需要叫援兵。";
		close;
	}
	mes "[警卫]";
	mes "你好，冒险者？";
	close;
}

un_bk_q,56,192,4	script	Chemical Substance Specialist Kori#EP15.2MR	4_M_ALCHE_B,{
	callfunc( "F_time_limit_recorder", .@cooldown_status_day,1,0 );
	if (.@cooldown_status_day[0] == 1) {
		mes "[化学物质专家科莉]";
		mes "我们正按照紧急协议检查防空洞内的危险物质。";
		next;
		mes "[化学物质专家科莉]";
		mes "你想知道化学物质专家有多少人？去找卡斯滕。他应该就在这里某处。";
		close;
	}
	if (.@cooldown_status_day[1] == 1) {
		mes "[化学物质专家科莉]";

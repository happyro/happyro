		mes "[冒险者班达库]";
		mes "我怎么会开始调查这个？";
		close;
	}
	// unknown text
	end;
}

un_bk_q,248,258,2	script	Adventurer Dally#EP15.2MR	4_F_SITDOWN,{
	callfunc( "F_time_limit_recorder", .@cooldown_status_day,1,0 );
	mes "[冒险者达莉]";
	mes "该死！！真让人沮丧";
	next;
	npcskill "AL_INCAGI",10,0,0;
	mes "[冒险者达莉]";
	if (Sex == SEX_FEMALE)
		mes "姐姐——快跑～";
	else
		mes "哥哥——快跑～";
	close;
}


// GM NPC
sec_in02,17,13,4	script	Brigan Helper#1	4_F_HUWOMAN,{
	mes "当前布里甘进度为" + ep15_2_brigan + "，";
	mes "数值为" + ep15_2_brigan + "。";
	next;
	switch( select( "设置物品", "任务", "初始化" ) ) {
	case 1:
		mes "要设置哪个物品？";
		next;
		switch( select( "布里甘", "女朋友" ) ) {
		case 1:
			mes "布里甘数值为" + ep15_2_brigan + "。";
			next;
			switch( select( "+1", "-1", "初始化" ) ) {
			case 1:
				mes "设置物品+1";
				ep15_2_brigan++;
				close;
			case 2:
				mes "设置物品-1";
				ep15_2_brigan--;
				close;
			case 3:
				mes "新数值";
				mes "初始化";
				ep15_2_brigan = 0;
				close;
			}
		case 2:
			mes "女朋友数值为" + ep15_2_brigan + "。";
			next;
			switch( select( "+1", "-1", "取消", "开始任务（5）" ) ) {
			case 1:
				mes "新数值";
				mes "设置物品+1";
				ep15_2_brigan++;
				close;
			case 2:
				mes "新数值";
				mes "设置物品-1";
				ep15_2_brigan++;
				close;
			case 3:
				mes "新数值";
				mes "领取前的蘑菇残留";
				ep15_2_brigan = 0;
				close;
			case 4:
				mes "新数值";
				mes "蘑菇残留5";
				ep15_2_brigan = 5;
				close;
			}

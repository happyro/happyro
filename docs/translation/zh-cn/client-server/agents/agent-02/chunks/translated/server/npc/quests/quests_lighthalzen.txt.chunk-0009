		mes "我们成功了。这是科学的一大飞跃，";
		mes "即使这个仿制品不如真正的伊米尔之心强大。";
			next;
			mes "[??]";
		mes "来吧，我们必须庆祝！出去为你举杯！哈哈~";
			next;
			mes "............";
			next;
			soundeffect "loli_ruri_stand.wav",0;
			mes ".................";
			next;
			soundeffect "loli_ruri_stand.wav",0;
			mes "....................";
			next;
			soundeffect "loli_ruri_stand.wav",0;
			mes "......................";
			next;
			mes "[??]";
		mes "可是为什么，Varmunt 博士？如果你对雷根贝勒公司有任何不满……";
			next;
			mes "[Varmunt]";
		mes "我们已经完成约定的工作，我没有理由继续留下。";
		mes "是时候回去进行个人研究了。";
			next;
			mes "[??]";
		mes "请 reconsider，Varmunt 博士！你可以充分使用我们的设施进行研究。";
		mes "我愿意为你提供条件。";
			next;
			mes "[Varmunt]";
		mes "不，我不能……如果继续在这里工作，恐怕会让很多人不高兴。";
		mes "不过，感谢你的一切。";
			next;
			mes "[??]";
		mes "等等……Varmunt 博士，你忘了手杖。";
			next;
			mes "[Varmunt]";
		mes "你什么时候见过我用手杖？";
		mes "就算我用，那也不是我的——";
			next;
			mes "...";
			next;
			mes "...";
			mes "......";
			next;
			mes "...";
			mes "......";
			mes ".........";
			set lhz_curse,13;
			close2;
			warp "lhz_in01",206,129;
			end;
		}
		else {
			warp "lhz_in01",206,129;
		}
	}
	else {
		warp "lhz_in01",206,129;
	}
	end;
}

lhz_in01,282,166,0	script	#kiz10	HIDDEN_NPC,3,3,{
OnTouch_:
	if (countitem(7345) > 0) {
		if (lhz_curse == 16) {
			if (checkweight(1201,1) == 0) {
				mes "^3355FF地板上有东西，但现在无法看清。";
				mes "也许清理出更多背包空间后就能查看……";
				close;
			}
			mes "...";
			mes "......";
			next;
			mes "...";
			mes "......";
			mes ".........";
			soundeffect "loli_ruri_stand.wav",0;
			sc_start SC_Curse,1000,0;
			close2;
			warp "lhz_que01",98,59;
			end;
		}
		else if (((lhz_curse > 0) && (lhz_curse < 16)) && ((lhz_curse > 16) && (lhz_curse < 26))) {
			sc_start SC_Curse,1000,0;
		}
	}
	end;
}

lhz_que01,99,74,5	script	#li_Man	1_M_02,{
	if (lhz_curse == 16) {
		mes "[???]";
		mes "结束了。我真的想退出。这就是我的终点。";
		next;
		mes "[Peco Peco]";
		mes "^3131FF这就是终点！这就是终点！^000000";
		next;
		mes "[???]";
		mes "他说报酬丰厚确实没错，但承受这么多折磨对我来说不值得任何钱。*叹气* 钱啊……";
		next;
		mes "[???]";
		mes "她现在一定很担心我。她的身体又那么差，我把她抛下真是个傻瓜。";
		next;
		mes "[Peco Peco]";
		mes "真是个傻瓜！真是个傻瓜！*嘎——~*";
		next;
		mes "[???]";
		mes "可恶！闭嘴，你这蠢鸟！安静一分钟！";
		next;
		mes "[Peco Peco]";
		mes "*嘎——！*";
		mes "死刑！死刑！";
		next;
		mes "[???]";
		mes "死刑？你从哪里学会说这种奇怪的话？嗯，那是……";
		next;
		mes "..............";
		next;
		mes ".................";
		next;
		mes "....................";
		next;
		mes "......................";
		next;
		mes "[???]";
		mes "房间里只剩我一个人了。其他人都离开后再也没回来。";
		mes "如果他们……而我也出去……那么……也许我最好别离开。";
		next;
		mes "[???]";
		mes "如果我能把吊坠还给她，她就不会那么担心我。";
		mes "但我可能回不去了……";
		next;
		mes "[???]";
		mes "........";
		next;
		mes "[?????]";
		mes "嘿，你等很久了吗？该完成你的合约了。";
		next;
		mes "[???]";
		mes "完成我的……？不！我决定了！我不离开这个房间！";
		next;
		mes "[?????]";
		mes "嘿，你到底在说什么？你是来工作的，对吧？现在该领取报酬了，所以……";
		next;
		mes "[???]";
		mes "不、不，放开我！求你放了我！";
		mes "我想再见她一面，请让我见她……！";
		next;
		mes "...";
		mes "......";
		next;
		mes "...";
		mes "......";
		mes ".........";
		next;
		mes "^3355FF*Clink*^000000";
		next;
		mes "[??]";
		mes "嗯？谁把这廉价珠宝带进来的？一定是有人忘了扔掉垃圾……";
		next;
		mes "[????]";
		mes "没错，只是廉价小饰品。那条吊坠甚至不值得捡起来。";
		next;
		mes "^3131FF你从地上捡起一条旧吊坠。";
		mes "无论怎么尝试，都无法打开搭扣查看吊坠里面是什么。^000000";
		set lhz_curse,17;
		changequest 2090,2091;
		getitem 7341,1; //Worn_Out_Pendant
		close2;
		warp "lhz_in01",278,162;
	}
	else {
		warp "lhz_in01",278,162;
	}
	end;
}

lhz_que01,90,71,5	script	#li_bird	1019,3,3,{
	mes "[Peco Peco]";
	mes "你是个傻瓜！你是个傻瓜！你是个傻瓜！";
	close;

OnTouch_:
	mes "[Peco Peco]";
		mes "你是个傻瓜！你是个傻瓜！你是个傻瓜！";
	close;
}

lighthalzen,346,263,3	script	Elder#lhz	4_F_EINOLD,{
	if (countitem(7345) > 0) {
		if ((lhz_curse == 1) && (lhz_spi01 == 1) && (lhz_spi02 == 1) && (lhz_spi03 == 1) && (lhz_spi04 == 1)) {
			mes "[Elder]";
			mes "难怪你看起来如此疲惫。来，让我帮你减轻身上的负担。";
			next;
			switch(select("呃，负担……？:疯老太婆！")) {
			case 1:
				mes "[Elder]";
				mes "是的，你可能看不见，但我的眼睛能清楚看到。";
				mes "没错，那些东西正在跟踪你。";
				next;
				select("东西？");
				mes "[Elder]";
				mes "是的，我只能将它们描述为留在世间的邪恶意念，";
				mes "有人以怨念延续、威胁活人的方式死去时便会产生。";
				next;
				mes "[Elder]";
				mes "有时，某人心碎，或为了所爱之人执着于此世，也会产生这些残留意念。";
				mes "没错，那些意念正在跟随你。";
				next;
				mes "[Elder]";
				mes "我不知道它们为何跟随你，但我确定它们存在。";
				mes "你是否感到脊背发冷、冒冷汗，甚至听到声音？";
				soundeffect "loli_ruri_stand.wav",0;
				sc_start SC_Curse,5000,0;
				next;
				select("是的！怎样才能摆脱它们？");
				mes "[Elder]";
				mes "通常，这些残留意念都有某种实体锚点，";
				mes "即寄托情感、对死者很重要的物品。";
				next;
				mes "[Elder]";
				mes "它们对你的怒火似乎越来越强，我能看到愤怒的灵魂拉扯你的衣角。";
				mes "告诉我，你最近得罪过谁吗？！";
				next;
				select("我不……觉得有。:我记不起做过的每件坏事！");
				mes "[Elder]";
				mes "你最好尽快做点什么，否则邪恶会污染你的心智，让你发疯！";
				mes "现在我必须确定你是否听到了声音。";
				next;
				select("是、是的。");
				mes "[Elder]";
				mes "还有希望。灵魂目前正试图联系你，";
				mes "但等待太久，你可能成为它们怒火的受害者。快点，还有很多事要做！";
				next;
				mes "[Elder]";
				mes "你必须了解它们生前发生了什么，以安抚这些力量。";
				mes "我没有强大力量，但可以鼓励灵魂为你引路。";
				next;
				mes "[Elder]";
				mes "我只能让灵魂展示一次它们希望你搜索的地点。";
				mes "你必须记住我即将展示的位置。准备好……";
				specialeffect2 EF_SIGHT;
				next;
				mes "[Elder]";
				mes "呀————！";
				specialeffect2 EF_SIGHTRASHER;
				specialeffect2 EF_VOLCANO;
				specialeffect2 EF_MAPPILLAR;
				next;
				mes "[Elder]";
				mes "在那里！你现在应该清楚需要搜索的位置了！别忘记这些标记！";
				viewpoint 1,104,282,1,0x99FF33;
				viewpoint 1,105,282,2,0x99FF33;
				viewpoint 1,104,281,3,0x99FF33;
				viewpoint 1,105,281,4,0x99FF33;
				next;
				mes "[Elder]";
				mes "祝你好运，年轻人。希望你能平息这些灵魂的怒火……";
				mes "只要让它们引导你，应该就能安全。";
				set lhz_curse,6;
				changequest 2086,2087;
				close;
			case 2:
				mes "[Elder]";
				mes "疯狂……？嗯，你一定还不明白自己身上发生了什么。";
				mes "当你意识到需要我的帮助时，随时回来，年轻人。";
				close;
			}
		}
		else if ((lhz_curse > 5) && (lhz_curse < 17)) {
			mes "[Elder]";
		mes "抱歉，我现在帮不了你更多。";
		mes "但如果找到与折磨你的灵魂有关的东西，请告诉我。";
			close;
		}
		else if (lhz_curse == 17) {
			if (countitem(7341) > 0) {
				mes "[Elder]";
				mes "你好，冒险者。你寻找仍留恋此世的灵魂遗物，进展如何？";
				next;
				switch(select("向他展示吊坠。:取消")) {
				case 1:
					mes "[Elder]";
					mes "天啊……这条吊坠上附着着极其强烈的情感。";
					mes "如果我们不处理它，";
					mes "你很快就会被诅咒。你必须这样做。";
					next;
					mes "[Elder]";
					mes "快带来 ^3131FF5 瓶圣水^000000 和 ^3131FF1 束花束^000000。";
					mes "圣水会净化吊坠，花束会安慰其主人的灵魂。";
					next;
					mes "[Elder]";
					mes "你没有多少时间了，请尽快回来！";
					mes "灵魂很快就会被超自然的怒火吞噬……";
					set lhz_curse,18;
					changequest 2091,2092;
					close;
				case 2:
					close;
				}
			}
			else {
				mes "[Elder]";
				mes "你好，冒险者。寻找仍留恋此世的灵魂遗物，进展如何？";
				next;
				mes "[Elder]";
				mes "等等……我感觉你找到了什么，却没有带来。你必须回头寻找！";
				close;
			}
		}
		else if (lhz_curse == 18) {
			if ((countitem(523) > 4) && (countitem(744) > 0) && (countitem(7341) > 0)) {
				mes "[Elder]";
				mes "很好，很好。一切准备就绪。";
				mes "请保持安静，我要集中精神完成眼前的大事。";
				next;
				mes "[Elder]";
				mes "...";
				mes "......";
				mes ".........";
				mes "呼————……";
				specialeffect2 EF_BENEDICTIO;
				next;
				mes "[Elder]";
				mes "呀————！";
				specialeffect2 EF_ASPERSIO;
				next;
				mes "[Elder]";
				mes "呼！我成功为你消除了诅咒。";
				mes "但这条吊坠的主人所遭遇的悲剧仍无法改变……";
				next;
				mes "[Elder]";
				mes "为什么不把吊坠带到真正属于它的地方？";
				mes "我相信这会给它的主人带来极大安慰。";
				next;
			mes "^3355FF突然，吊坠上的搭扣";

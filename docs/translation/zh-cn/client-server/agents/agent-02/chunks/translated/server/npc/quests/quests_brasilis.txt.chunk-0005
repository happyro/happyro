							close;
						}
						else {
					mes "你冲了厕所 "+.@input+" 次。";
							next;
					mes "但什么也没发生。";
							close;
						}
					case 2:
					mes "你盖上厕所盖。";
					mes "似乎什么也没发生。";
						close;
					}
				}
				else {
				mes "什么也没发生。";
					close;
				}
			}
		case 2:
			mes "你什么也没做。";
			close;
		}
	}
	else {
		mes "- Looks like an ordinary toilet -";
		close;
	}
}


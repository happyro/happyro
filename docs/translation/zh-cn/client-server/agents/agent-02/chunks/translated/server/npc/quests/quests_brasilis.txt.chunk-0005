bra_in01,151,180,3	script	Mirror#bra	CLEAR_NPC,{
	if (brazil_ghost > 0) {
		mes "- 你看到一面没有污渍或灰尘的干净镜子 -";
		next;
		switch(select("检查它。:忽略。")) {
		case 1:
			mes "- 咒语的下一句是什么来着？-";
			input .@input$;
			next;
			mes "["+strcharinfo(0)+"]";
			mes .@input$;
			next;
			.@braspell$ = "Where are you mom?";
			.@chkspell = compare(.@braspell$,.@input$);
			if (!.@chkspell) {
				mes "看来你说错了什么。";
				close;
			}
			else {
				if (brazil_ghost == 6) {
					mes "[Distant Sound]";
					mes "^FF0000kihe! hit! hit! hit! hit!^000000";
					next;
					mes "[Distant Sound]";
					mes "^FF0000kihe! hit! hit! hit! hit!^000000";
					mes "^FF0000kihe! hit! hit! hit! hit!^000000";
					next;
					mes "[Distant Sound]";
					mes "在你身后……";
					enablenpc "Ghost#bra";
					next;
					emotion ET_HUK, playerattached();
					mes "["+strcharinfo(0)+"]";
					mes "关于幽灵的传说是真的~！";
					next;
					mes "[Ghost]";
					mes "^FF0000my baby....^000000";
					next;
					mes "[Ghost]";
					mes "^FF0000我看不见……我的眼睛……^000000";
					mes "^FF0000What's going on....?^000000";
					next;
					mes "- 你深吸一口气，看向幽灵，注意到它戴着眼罩 -";
					next;
					mes "[Ghost]";
					mes "^FF0000我的眼睛被勒得好紧……你能把这个取下来吗？^000000";
					next;
					mes "你小心地走向幽灵。";
					next;
					mes "他的脸被灰尘覆盖，扭曲成奇怪的表情。";
					next;
					mes "[Ghost]";
					mes "^FF0000Come on help mom.....^000000";
					next;
						switch(select("取下眼罩。:逃跑~。")) {
					case 1:
						while(1) {
							.@cpudice = rand(1,6);
							.@pcdice = rand(1,6);
							if (.@cpudice != .@pcdice) {
								emotion (ET_OTL+.@cpudice), getnpcid(0, "Ghost#bra");
								emotion (ET_OTL+.@pcdice), playerattached();
								break;
							}
						}
						if (.@cpudice > .@pcdice) {
							specialeffect2 EF_DEVIL;
							mes "[Ghost]";
							mes "^FF0000Go away!^000000";
							brazil_ghost = 1;
							changequest 60354,2208;
							percentheal -50,-50;
							close2;
							disablenpc "Ghost#bra";
							warp "bra_in01",12,183;
							end;
						}
						else {
							emotion ET_STARE, playerattached();
							mes "[Ghost]";
							mes "^FF0000Ahh!^000000";
							mes "幽灵消失在厕所里。";
							brazil_ghost = 7;
							changequest 60354,60355;
							close2;
							disablenpc "Ghost#bra";
							warp "bra_in01",206,100;
							end;
						}
					case 2:
						mes "你逃离了幽灵。";
						close2;
						brazil_ghost = 1;
						changequest 60354,2208;
						warp "bra_in01",12,183;
						disablenpc "Ghost#bra";
						end;
					}
					close;
				}
				else {
					mes "什么也没发生。";
					close;
				}
			}
		case 2:
			mes "你什么也没做。";
			close;
		}
	}
	else {
		mes "- 你看到一面没有痕迹和灰尘的干净镜子。-";
		close;
	}
}


bra_in01,7,181,5	script	Curator#bra	4_M_BRZ_MAN2,{
	if (BaseLevel < 40) {
		mes "[Curator]";
			mes "抱歉，这里正在施工。";
		close;
	}
	if ((brazil_ghost > 0) && (brazil_ghost < 7)) {
		if (countitem(11515) > 0) {
			mes "[Curator]";
			mes "我能为你做些什么？";
			next;
			select("I need to use the bathroom.");
			mes "[Curator]";
			mes "抱歉，里面正在改造，所以暂时关闭。";
			mes "请使用另一个厕所。";
			next;
			switch(select("But I forgot something inside.:Give up.")) {
			case 1:
				mes "[Curator]";
				mes "那太糟糕了。";
				mes "但经理命令我阻止任何人进入厕所，所以我必须服从。";
				next;
				select("It's such a hot day!");
				mes "[Curator]";
				mes "巴西利斯一直很热，但今天热得离谱。";
				mes "也许我该喝点椰汁降温。";
				next;
				mes "你把椰子交给管理员。";
				next;
				mes "[Curator]";
				mes "哦，真的可以给我吗？";
				mes "非常感谢！";
				next;
				mes "[Curator]";
				mes "这是互相帮助，对吧？";
				mes "好吧，这次让你通过。";
				next;
				mes "管理员平静地环顾四周，然后打开了门。";
				delitem 11515,1; //Coconut
				brazil_ghost = 2;
				close2;

	}
}

bra_in01,149,184,3	script	Door#bra	CLEAR_NPC,{
	if (brazil_ghost > 0) {
		mes "- 一把钥匙插在锁住的门上。-";
		next;
		switch(select("转动钥匙。:忽略。")) {
		case 1:
			mes "你开始念出魔法咒语的第一句。";
			input .@input$;
			next;
			mes "["+strcharinfo(0)+"]";
			mes .@input$;
			next;
			.@braspell$ = "Mother the door won't open!";
			.@chkspell = compare(.@braspell$,.@input$);
			if (!.@chkspell) {
				mes "看来你说错了什么。";
				close;
			}
			else {
				if (brazil_ghost == 2) {
					mes "[Sobbing Voice]";
					mes "“^FF0000彩虹有多少种颜色，就转动钥匙多少次。^000000”";
					next;
					switch(select("打开门:敲门。:转动钥匙。:拔出钥匙。")) {
					case 1:
						mes "门锁着。";
						mes "所以什么也没发生。";
						close;
					case 2:
						mes "我该敲几次？";
						input .@input,0,999;
						next;
						mes "你敲了门 "+.@input+" 次。";
						next;
						mes "但是，什么也没发生。";
						close;
					case 3:
						mes "我该转动钥匙几次？";
						input .@input,0,999;
						next;
						if (.@input == 7) {
							mes "你转动钥匙 7 次。";
							next;
							mes "咔哒！咔哒！咔哒！";
							mes "咔哒！咔哒！咔哒！";
							mes "咔哒……！";
							next;
							mes "[Distant Sound]";
							mes "^FF0000咯咯——嘻嘻嘻嘻！！！^000000";
							mes "你听到冲水声。";
							next;
							specialeffect2 EF_VENOMDUST;
							mes "厕所方向传来微弱的笑声。";
							brazil_ghost = 3;
							changequest 2208,60351;
							close;
						}
						else {
							mes "你转动钥匙 "+.@input+" 次。";
							next;
							mes "但什么也没发生。";
							close;
						}
					case 4:
						mes "我该把钥匙插进门里几次？";
						input .@input,0,999;
						next;
						mes "你把钥匙插入 "+.@input+" 次。";
						next;
						mes "但什么也没发生。";
						close;
					}
				}
				else {
					mes "妈妈，门打不开！";
					close;
				}
			}
		case 2:
			mes "你什么也没做。";
			close;
		}
	}
	else {
		mes "- 一把钥匙插在锁住的门上。-";
		close;
	}
}

bra_in01,144,187,3	script	Toilet#bra	CLEAR_NPC,{
	if (brazil_ghost > 0) {
		mes "- 看起来是普通的厕所 -";

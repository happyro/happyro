			mes .@input$;
			next;
			.@braspell$ = "Mother the water is flooding!";
			.@chkspell = compare(.@braspell$,.@input$);
			if (!.@chkspell) {
				mes "看来你说错了什么。";
				close;
			}
			else {
				if (brazil_ghost == 3) {
					mes "[Sobbing Voice]";
					mes "^FF0000如果月亮消失三次……别担心……^000000";
					next;
					switch(select("Flush the toilet.:Close the lid.")) {
					case 1:
					mes "我该冲几次？";
						input .@input,0,999;
						next;
						if (.@input == 3) {
						mes "你冲了厕所 3 次。";
							next;
						mes "哇啊啊啊啊！";
						mes "哇啊啊啊啊啊！";
						mes "哇啊啊啊啊啊啊啊啊啊！";
							next;
							mes "[Distant Sound]";
							mes "^FF0000kkkkhee- hihihihi!!!^000000";
						mes "突然，水槽传来水流畅通的声音。";
							next;
							specialeffect2 EF_VENOMDUST;

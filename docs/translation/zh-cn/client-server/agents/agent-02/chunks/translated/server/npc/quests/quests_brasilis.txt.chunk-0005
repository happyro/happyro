		if (brazil_ghost > 6) {
			switch(select("冲厕所。:什么也不做。")) {
			case 1:
				mes "冲完厕所后，你突然感到头晕，被卷到了某个地方。";
				specialeffect2 EF_WATERFALL_SMALL_T2_90;
				close2;
				warp "bra_in01",206,102;
				end;
			case 2:
				mes "厕所里的水看起来很恶心。";
				close;
			}
		}
		switch(select("使用厕所:忽略。")) {
		case 1:
			mes "- 咒语的第二句是什么来着？-";
			input .@input$;

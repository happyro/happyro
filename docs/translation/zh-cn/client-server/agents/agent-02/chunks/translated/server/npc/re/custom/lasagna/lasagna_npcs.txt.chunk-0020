		npctalk "我会尽力的。", "Daldal#dorcon02", bc_self;
		next;
		mes "[Daldal]";
		mes "我也是。";
		npctalk "我们正在交流。", "Gopara#dorcon02", bc_self;
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "照看孩子不是安静地坐着，而是照顾婴儿！";
		next;
		mes "[Gopara]";
		mes "是吗？但那太麻烦了！我连自己都照顾不好。";
		next;
		mes "[Daldal]";
		mes "照看孩子就是这么回事？我不知道。早知道我就不做了。";
		next;
		emotion ET_CRY;
		mes "[Baby]";
		mes "哇。哇。";
		next;
		mes "[Gopara]";
		mes "安静。大声说出来。";
		npctalk "我再也不想做这个了。", "Daldal#dorcon02", bc_self;
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "这样下去不行。别再照看孩子了。你们有没有一直想做的事？";
		next;
		mes "[Daldal]";
		mes "没有。我饿了。";
		npctalk "我想回去。", "Daldal#dorcon02", bc_self;
		next;
		mes "[Gopara]";
		mes "这么一想，我一直想做些^0000cd和凤尾鱼有关的事^000000。凤尾鱼很好吃。";
		npctalk "凤尾鱼听起来很棒！", "Gopara#dorcon02", bc_self;
		classchange( HIDDEN_WARP_NPC, "Daldal#dorcon02", bc_self );
		classchange( HIDDEN_WARP_NPC, "Gopara#dorcon02", bc_self );
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "好吧。我们去^0000cd码头附近的凤尾鱼工坊^000000。";
		erasequest 14569;// Babysitter
		setquest 14570;// Processing Anchovy
		lasagna_quest[2] = 4;
		close;
	}
	if (lasagna_quest[2] == 4) {
		mes "[" + strcharinfo(0) + "]";
		mes "宝宝，好可爱……";
		next;
		mes "[Baby]";
		mes "哇哇！";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "糟糕！我本来要去凤尾鱼工坊的。得快点。";
		close;
	}
	mes "[Baby]";
	mes "一闪一闪亮晶晶——满天都是小星星——";
	mes "高高挂在天空中——就像天上的钻石——";
	next;
	mes "[Baby]";
	mes "一闪一闪亮晶晶——满天都是小星星——";
	close;
}


lasagna,139,299,3	script	Captain of Anchovy Fish	4_CAT_SAILOR5,{
	if (lasagna_quest[2] == 5) {
		mes "凤尾鱼渔船船长";
		mes "什么事？";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "我想问问船上是否需要帮忙。";
		next;
		mes "凤尾鱼渔船船长";
		mes "凤尾鱼生意确实不如从前，但我总是缺人手。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "那让这两个人试试怎么样？他们想在船上工作，即使从学徒做起也好。";
		next;
		mes "[Gopara]";
		mes "感觉我们像是被卖掉了。";
		npctalk "感觉我们像是被卖掉了。", "Gopara#dorcon04", bc_self;
		next;
		mes "[Daldal]";
		mes "大概只是错觉。他不会卖掉我们的。";
		npctalk "大概只是错觉。", "Daldal#dorcon04", bc_self;
		next;
		mes "凤尾鱼渔船船长";
		mes "喂，你们两个。以前上过船吗？";
		next;
		mes "[Gopara]";
		mes "没有。";
		next;
		mes "[Daldal]";
		mes "没有。妈妈牵着我的手，随着潮水来到这里。她被潮水冲走了，我一个人漂到了这里。Legalas找到了我，从那以后我们像家人一样生活在一起。";
		next;
		mes "凤尾鱼渔船船长";
		mes "不用了解你们的过去。我只要你们在船上好好工作。既然你们都是第一次上船，看来前方还有很长的坎坷之路。";
		next;
		emotion ET_CRY, getnpcid(0, "Daldal#dorcon04");
		mes "[Daldal]";
		mes "太过分了。我分享了痛苦的过去，你却一点都不在意。";
		next;
		emotion ET_OK, getnpcid(0, "Gopara#dorcon04");
		mes "[Gopara]";
		mes "没关系，我在意。";
		next;
		mes "[Daldal]";
		mes "谢谢。";
		next;
		mes "[Gopara]";
		mes "我也想分享我的故事。可以告诉你吗？";
		npctalk "真是好多令人心碎的故事。", "Gopara#dorcon04", bc_self;
		next;
		mes "[Daldal]";
		mes "没什么兴趣。";
		next;
		emotion ET_ANGER, getnpcid(0, "Gopara#dorcon04");
		mes "[Gopara]";
		mes "来打架吧！";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "好了，冷静。上船感觉如何？这艘船把凤尾鱼从渔船运到拉扎格纳，但货物都存放在货舱里，所以你们看不到。";
		next;
		mes "[Daldal]";
		mes "这不是让我烦恼的问题。";
		next;
		mes "[Gopara]";
		mes "为什么地板看起来这么恶心？";
		next;
		mes "凤尾鱼渔船船长";
		mes "看来你晕船了。过一会儿就会好。到那时，在陆地上走路反而会觉得奇怪。";
		next;
		mes "[Gopara]";
		mes "奇怪。船明明很稳，为什么还是这么恶心？";
		next;
		mes "凤尾鱼渔船船长";
		mes "因为船会随着海浪移动。";
		next;
		mes "[Gopara]";
		mes "什么？船不是牢牢固定在水面上的吗？！";
		npctalk "别撒谎！", "Gopara#dorcon04", bc_self;
		next;
		mes "凤尾鱼渔船船长";
		mes "它是漂浮在水上，不是固定在水上。船要是固定在水上，怎么可能移动？！";
		next;
		mes "[Daldal]";
		mes "真不敢相信！这么重的船怎么可能漂在水上？！";
		npctalk "连我都知道重物会沉入水中这种常识！", "Daldal#dorcon04", bc_self;
		next;
		mes "凤尾鱼渔船船长";
		mes "喂，冒险者！";
		next;
		mes "把他们带回去。船上工作不需要很高的智力，但这两个笨蛋恐怕连打扫都做不好。不，别说打扫了，只要他们没先把我逼疯，我就算走运。";
		npctalk "你这是什么意思？", "Daldal#dorcon04", bc_self;
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "我明白了。";
		next;
		mes "[Gopara]";
		mes "你说你明白是什么意思？你不该这样说。";
		next;
		mes "[Daldal]";
		mes "你在说什么？";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "这样不行。我想我帮不了你们。我们回去和^0000cdLegalas^000000商量吧。现在就走。";
		next;
		mes "[Daldal]";
		mes "我不知道刚才发生了什么，但我很高兴回去。";
		next;
		mes "[Gopara]";
		mes "好，我们先回去吧。这里已经不好玩了。";
		classchange( HIDDEN_WARP_NPC, "Daldal#dorcon04", bc_self );
		classchange( HIDDEN_WARP_NPC, "Gopara#dorcon04", bc_self );
		erasequest 14571;// Anchovy fishing ship
		setquest 14572;// Helpless...
		lasagna_quest[2] = 6;
		close;
	}
	if (lasagna_quest[2] == 6) {
		mes "凤尾鱼渔船船长";
		mes "你不是说要回Legalas吗？下次带帮手来时，记得找些像样的。";
		close;
	}
	mes "凤尾鱼渔船船长";
	mes "如果有像样的人，就带他来。我太缺人手了，只能一个人做所有工作。";
	close;
}


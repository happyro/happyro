lasa_dun02,55,153,3	script	Panna#dorcon	4_DR_SOLDIER,{
	if (isbegin_quest(14574) > 0 || isbegin_quest(14577) > 0) {
		mes "[Panna]";
		mes "哦，我好饿。食物什么时候来？食物。";
		next;
		mes "[" + strcharinfo(0) + "]";
		if (countitem(25048) < 1) {
			mes "Panna？";
			next;
			mes "[Panna]";
			mes "便当在哪里？我的呢？没有我的！你把它丢到哪里了？我的食物！我的食物！！！";
			next;
			mes "[" + strcharinfo(0) + "]";
			mes "冷静。我现在就去找。";
			next;
			mes "[Gopara]";
			mes "他疯了。";
			next;
			mes "[Daldal]";
			mes "不过我能理解。我们去找便当吧。";
			close2;
			classchange( HIDDEN_WARP_NPC, "Daldal#dorcon06", bc_self );
			classchange( HIDDEN_WARP_NPC, "Gopara#dorcon06", bc_self );
			end;
		}
		mes "Panna？这是你的便当……";
		next;
		mes "[Panna]";
		mes "食物！！！";
		next;
		mes "[Gopara]";
		mes "真是个粗鲁又不知感恩的多兰。";
		next;
		mes "[Daldal]";
		mes "我吃东西时怎么说话？";
		next;
		mes "[Panna]";
		mes "吧唧吧唧吧唧。";
		next;
		mes "[Daldal]";
		mes "看起来真好吃……";
		npctalk "给我一口……", "Daldal#dorcon06", bc_self;
		npctalk "你怎么能想着抢他的食物？再忍一会儿。", "Gopara#dorcon06", bc_self;
		next;
		mes "[Panna]";
		mes "哈，我现在好多了。我饿得都快要吃蛇蜥了，你来得正是时候。我差点就成了无法保持多兰形态、变成野兽的多兰。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "我来收空盘子。";
		next;
		mes "[Panna]";
		mes "没关系，放在那里就好。我稍后回城时会带走。";
		next;
		mes "[Gopara]";
		mes "我走了。";
		classchange( HIDDEN_WARP_NPC, "Gopara#dorcon06", bc_self );
		next;
		mes "[Daldal]";
		mes "我先离开了。";
		classchange( HIDDEN_WARP_NPC, "Daldal#dorcon06", bc_self );
		delitem 25048,1;// Hearty Lunchbox
		if (lasagna_quest[2] == 8) {
			erasequest 14574;// Meal Box Delivery
			setquest 14575;// Delivery Complete Report
			lasagna_quest[2] = 9;
		}
		else {
			erasequest 14577;// Meal Box Delivery
			setquest 14578;// Delivery Complete Report
		}
		close;
	}
	if (isbegin_quest(14575) == 1 || isbegin_quest(14578) == 1) {
		mes "[Panna]";
		mes "多亏了你，我吃上了一顿丰盛的饭。请告诉Kalu，我很感谢这顿美味的午餐。希望今天也能平安……";
		close;
	}
	mes "[Panna]";
	mes "哦，我好饿。食物什么时候来？食物。";
	close;
}

conch_in,122,61,5	script	Crewman#dorcon01	4_CAT_ADV1,{
	npctalk "感谢你登上康奇利纳。祝你安全舒适地抵达目的地！", "", bc_self;
	end;
}

// in C_D
conch_in,59,29,5	script	Engineer#dorcon01	4_CAT_SAILOR5,{
	setpcblock PCBLOCK_NPC, true;
	npctalk "你是要前往新世界的冒险者吗？欢迎。你听说过我们的船是如何移动的吗？", "", bc_self;
	sleep2 2000;
	unittalk getcharid(3), "" + strcharinfo(0) + " : No, I have not.", bc_self;
	sleep2 2000;
	npctalk "我们的船有别于其他船只的动力系统。只有少数人知道这一点。", "", bc_self;
	sleep2 2000;
	npctalk "数百只仓鼠正在船底的跑步机上奔跑。由于这个区域连接着引擎主体，船就这样向前移动。", "", bc_self;
	sleep2 1000;
	emotion ET_HUK;
	unittalk getcharid(3), "" + strcharinfo(0) + " : Pardon???", bc_self;
	sleep2 1000;
	emotion ET_SWEAT;
	npctalk "哦，等等。你不会当真了吧？这是玩笑，玩笑！", "", bc_self;
	setpcblock PCBLOCK_NPC, false;
	end;
}

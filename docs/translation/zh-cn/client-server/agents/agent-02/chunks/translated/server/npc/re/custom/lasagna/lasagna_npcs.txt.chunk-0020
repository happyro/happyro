lasagna,225,290,5	script	Workshop Manager#dorcon	4_M_BOSSCAT,{
	if (lasagna_quest[2] == 4) {
		mes "[Workshop Manager]";
		mes "新人？有这方面的工作经验吗？没有也没关系，很容易学会。";
		next;
		mes "[Workshop Manager]";
		mes "现在跟着我。拿一条凤尾鱼，去掉鱼头，掏出内脏，再放进容器里。";
		npctalk "很简单，对吧？", "", bc_self;
		next;
		mes "[Workshop Manager]";
		mes "新人要经过这四个步骤，但熟练工会同时去掉鱼头和内脏，再扔进容器，一步就能完成。";
		next;
		mes "[Workshop Manager]";
		mes "康奇利纳的船长尤其擅长。现在你们试试看。";
		next;
		mes "[Gopara]";
		mes "这……是什么。";
		next;
		mes "[Daldal]";
		mes "这个看起来恶心的东西是什么？";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "凤尾鱼。你说想做和凤尾鱼有关的事，所以我带你们来了。";
		next;
		mes "[Gopara]";
		mes "凤尾鱼不是细长、略咸的零食吗？但这东西有头……还有眼睛！";
		npctalk "你是在嫌弃我们吗？", "Gopara#dorcon03", bc_self;
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "它当然有眼睛和头，因为它是鱼。";
		next;
		mes "[Daldal]";
		mes "凤尾鱼是鱼？";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "那你以为它是什么？";
		next;
		mes "[Gopara]";
		mes "我以为那是店里用神秘食材做成的美味食物。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "你们啊……怎么会不知道凤尾鱼是鱼？你们到底过着什么样的生活？";
		next;
		mes "[Workshop Manager]";
		mes "你到底从哪里找来这些笨蛋的？你觉得他们能做这份工作吗？";
		next;
		mes "[Gopara]";
		mes "我做不了这个。";
		npctalk "我是在保护下长大的。", "Gopara#dorcon03", bc_self;
		next;
		mes "[Daldal]";
		mes "我想我再也吃不下凤尾鱼了。刚才我们四目相对。以后每次看到凤尾鱼，它们都会跟着我。";
		npctalk "真不敢相信我一直在吃它们。", "Daldal#dorcon03", bc_self;
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "哈……是吗？看来这份工作也不适合你们。那我们去找别的吧。还有什么想尝试的工作吗？";
		next;
		mes "[Daldal]";
		mes "船。我想上^0000cd船^000000！";
		next;
		mes "[Gopara]";
		mes "没错。我一直住在拉扎格纳，却从没上过船。这是登船的好机会。";
		npctalk "我觉得这很适合我的性格。", "Gopara#dorcon03", bc_self;
		classchange( HIDDEN_WARP_NPC, "Daldal#dorcon03", bc_self );
		classchange( HIDDEN_WARP_NPC, "Gopara#dorcon03", bc_self );
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "是吗？那我们去上面的^0000cd凤尾鱼渔船^000000吧。";
		erasequest 14570;// Processing Anchovy
		setquest 14571;// Anchovy fishing ship
		lasagna_quest[2] = 5;
		close;
	}
	if (lasagna_quest[2] == 5) {
		mes "[Workshop Manager]";
		mes "你不是说要去凤尾鱼渔船吗？就算去了那里，我也不知道你能做什么。";
		close;
	}
	mes "[Workshop Manager]";
	mes "拉扎格纳的凤尾鱼很特别。上等凤尾鱼要蒸熟、烘干九次，再去掉鱼头和内脏。这是一门需要精细工艺的艺术。";
	next;
	mes "[Workshop Manager]";
	mes "它们适合下酒，也是备考学生的绝佳零食。尝一个吧。";
	close;
}


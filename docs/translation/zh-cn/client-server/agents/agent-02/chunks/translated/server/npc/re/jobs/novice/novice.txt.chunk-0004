-	script	Archer Guide#newbe10::NvArcher	-1,{
	if (job_novice_q < 15) {
		mes "[弓箭手公会成员]";
		mes "你还在布雷德先生的训练过程中。";
		close;
	}
	mes "[弓箭手公会成员]";
	mes "我能怎样帮助你？";
	next;
	switch(select("告诉我弓箭手的事：我想成为弓箭手：取消")) {
	case 1:
		mes "[弓箭手公会成员]";
		mes "弓箭手专精弓类武器，并拥有各种强大的技能。";
		mes "弓箭手擅长保持距离，逐个击倒目标。";
		next;
		mes "[弓箭手公会成员]";
		mes "弓箭手的";
		mes "体力并不强，所以必须与敌人";
		mes "保持距离。";
		next;
		mes "[弓箭手公会成员]";
		mes "另一方面，弓箭手专注敏锐，拥有极其精准的双眼。";
		mes "因此一旦准备攻击，他们甚至能在敌人察觉之前将其击杀。";
		next;
		mes "[弓箭手公会成员]";
		mes "^8E2323弓箭手可以转职为猎人等多种二转职业。";
		mes "除了猎人，男性弓箭手还可以转职为诗人。";
		mes "女性弓箭手则可以转职为舞娘^000000。";
		next;
		if (isequipped(2822) || countitem(2822)) {
			mes "[弓箭手公会成员]";
			mes "我认为你应该先体验弓箭手技能，再决定要做什么。";
			mes "我可以提供测试技能手册。";
			close;
		}
		mes "[弓箭手公会成员]";
		mes "想登记体验技能吗？";
		mes "想测试弓箭手技能吗？";
		next;
		switch(select("我想体验弓箭手技能：我不想体验。")) {
		case 1:
			mes "[弓箭手公会成员]";
			mes "这是弓箭手手册。";
			mes "你体验弓箭手手册期间，我会收走其他职业的手册。";
			next;
			callfunc "F_NvErase";
			getitem 2822,1; //Archer_Manual
			next;
			mes "[弓箭手公会成员]";
			mes "请在物品栏窗口中双击技能手册，确认装备它。";
			mes "按下^4d4dffAlt + S^000000打开技能树，再按窗口右上角的^4d4dff'-'^000000按钮缩小窗口，即可查看可用技能。";
			close;
		case 2:
			mes "[弓箭手公会成员]";
			mes "嗯，你是这么想的吗。";
			mes "好吧，我同意你的看法。选择职业是人生中非常重要的事。";
			mes "想体验弓箭手技能时，随时来和我说话。";
			close;
		}
	case 2:
		mes "[弓箭手公会成员]";
		mes "你想成为弓箭手吗？";
		mes "好吧，那么我马上把你送到弓箭手公会。";
		next;
		mes "[弓箭手公会成员]";
		mes "等等，你确认过职业等级了吗？";
		mes "要完成初心者训练场，马上前往弓箭手公会吗？";
		next;
		switch(select("我再考虑一下：是的，我要去弓箭手公会")) {
		case 1:
			mes "[弓箭手公会成员]";
			mes "需要的话就体验所有职业，但请选弓箭手，因为我们是最棒的。";
			mes "我们随时欢迎你！";
			close;
		case 2:
			mes "[弓箭手公会成员]";
			mes "太好了。";
			mes "那么我会彻底结束训练流程，把你送到弓箭手公会。";
			callfunc "F_NvErase",1;
			close2;
			savepoint "payon",256,242,1,1;
			warp "payon_in02",64,65;
			end;
		}
	case 3:
		mes "[弓箭手公会成员]";
		mes "对弓箭手有任何疑问，尽管来问我。";
		mes "我觉得你能成为强大的弓箭手，年轻的初心者。";
		close;
	}
}

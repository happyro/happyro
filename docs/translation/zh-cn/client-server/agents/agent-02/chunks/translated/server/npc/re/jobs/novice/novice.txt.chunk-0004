		mes "^8E2323成为服事后，未来可以转职为牧师或武僧。^8E2323";
		next;
		if (isequipped(2821) || countitem(2821)) {
			mes "[普隆德拉服事]";
			mes "用你拥有的手册尝试服事技能吧，这能帮助你更容易了解这个职业。";
			mes "按下^4d4dffAlt + S^000000打开技能树，再按窗口右上角的^4d4dff'-'^000000按钮缩小窗口，即可查看可用技能。";
			close;
		}
		mes "[普隆德拉服事]";
		mes "如果你愿意，我可以给你一本技能手册，让你体验服事是什么样的职业。";
		mes "想体验服事的技能吗？";
		next;
		switch(select("好的，请给我：我没兴趣。")) {
		case 1:
			mes "[普隆德拉服事]";
			mes "给你，这是服事的使用手册。";
			mes "学习这本手册期间，我会收走其他职业的手册。";
			next;
			callfunc "F_NvErase";
			getitem 2821,1; //Acolyte_Manual
			next;
			mes "[普隆德拉服事]";
			mes "请在物品栏窗口中双击技能手册，确认装备它。";
			mes "按下^4d4dffAlt + S^000000打开技能树，再按窗口右上角的^4d4dff'-'^000000按钮缩小窗口，即可查看可用技能。";
			close;
		case 2:
			mes "[普隆德拉服事]";
			mes "嗯，你是这么想的吗。";
			mes "好吧，我同意你的看法。选择职业是人生中非常重要的事。";
			mes "想了解服事时，随时来和我说话。";
			close;
		}
	case 2:
		mes "[普隆德拉服事]";
		mes "你真的想成为服事吗？";
		mes "如果是，我会把你送到普隆德拉大教堂。";
		next;
		mes "[普隆德拉服事]";
		mes "当然，我猜你已经有足够的职业等级成为服事了，对吧？";
		mes "要结束训练流程，前往普隆德拉大教堂吗？";
		next;
		switch(select("让我再考虑一下：我要去大教堂。")) {
		case 1:
			mes "[普隆德拉服事]";
			mes "你应该试试每个职业的手册。";
			mes "充分体验后再仔细决定。";
			mes "当然，我随时欢迎你。";
			close;
		case 2:
			mes "[普隆德拉服事]";
			mes "太好了。";
			mes "那么我会彻底结束训练流程，把你送到普隆德拉大教堂。";
			callfunc "F_NvErase",1;
			close2;
			savepoint "prontera",117,72,1,1;
			warp "prt_church",172,19;
			end;
		}
	case 3:
		mes "[普隆德拉服事]";
		mes "如果你对服事有任何疑问，随时问我。";
		mes "我们的神奥丁正在等待你这样的冒险者。";
		close;
	}
}
new_1-3,101,41,3	duplicate(NvAcolyte)	Acolyte Guide#nv1	95
new_2-3,101,41,3	duplicate(NvAcolyte)	Acolyte Guide#nv2	95
new_3-3,101,41,3	duplicate(NvAcolyte)	Acolyte Guide#nv3	95

-	script	Thief Guide#newbe10::NvThief	-1,{
	if (job_novice_q < 15) {
		mes "[盗贼公会成员]";
		mes "看起来你还没有完成布雷德教官的课程。";
		close;
	}
	mes "[盗贼公会成员]";
	mes "我能怎样帮助你？";
	next;
	switch(select("关于盗贼职业：我想成为盗贼：有任务吗？：取消。")) {
	case 1:
		mes "[盗贼公会成员]";
		mes "盗贼擅长使用短剑类武器。";
		mes "他们出手迅速，也能轻松闪避敌人的攻击。";
		next;
		mes "[盗贼公会成员]";
		mes "盗贼可以学习隐藏身形或从魔物身上偷取物品的技能。";
		mes "他们使用毒药的能力也令人畏惧，毒素会逐渐削弱敌人。";
		next;
		mes "[盗贼公会成员]";
		mes "遇到危险，或不想暴露自己的时候，";
		mes "他们甚至可以使用技能轻松隐藏自己。";
		next;
		mes "[盗贼公会成员]";
		mes "盗贼可以转职为^8E2323刺客^000000或^8E2323流氓^000000。";
		next;
		if (isequipped(2820) || countitem(2820)) {
			mes "[盗贼公会成员]";
			mes "使用所有盗贼都必备的技能，职业手册可以帮助你了解盗贼。";
			close;
		}
		mes "[盗贼公会成员]";
		mes "如果你愿意，我可以给你一本盗贼技能手册。";
		mes "想体验盗贼的技能吗？";
		next;
		switch(select("好的，我想体验：不了，谢谢。")) {
		case 1:
			mes "[盗贼公会成员]";
			mes "给你，请收下盗贼手册。";
			mes "同时我会收走其他职业的手册。";
			next;
			callfunc "F_NvErase";
			getitem 2820,1; //Thief_Manual
			next;
			mes "[盗贼公会成员]";
			mes "请在物品栏窗口中双击技能手册，确认装备它。";
			mes "按下^4d4dffAlt + S^000000打开技能树，再按窗口右上角的^4d4dff'-'^000000按钮缩小窗口，即可查看可用技能。";
			close;
		case 2:
			mes "[盗贼公会成员]";
			mes "哦，你确定吗？";
			mes "职业选择非常重要，请仔细考虑。";
			mes "想询问盗贼相关内容，随时来和我说话。";
			close;
		}
	case 2:
		mes "[盗贼公会成员]";
		mes "你真的想成为盗贼吗？";
		mes "如果是，我会立即把你送到盗贼公会。";
		next;
		mes "[盗贼公会成员]";
		mes "你已经达到所需的职业等级了，对吧？";
		mes "要结束初心者训练，前往盗贼公会吗？";
		next;
		switch(select("让我再考虑一下：是的，我要去。")) {
		case 1:
			mes "[盗贼公会成员]";
			mes "你已经试过所有职业手册了吗？";
			mes "如果还没决定选择哪个职业，建议先和所有向导交谈。";
			close;
		case 2:
			mes "[盗贼公会成员]";
			mes "好，我明白了。";
			mes "很好。那么你的初心者训练全部完成，现在会立即把你送到盗贼公会。";
			callfunc "F_NvErase",1;
			close2;
			savepoint "morocc",150,99,1,1;
			warp "moc_prydb1",99,185;
			end;
		}
	case 3:
		set .@quest, checkquest(7127);
		if (.@quest == -1) {
			mes "[盗贼公会成员]";
			mes "任务？";
			mes "嗯，什么任务适合你呢？";
			mes "去猎杀几只柳树精怎么样？";
			next;
			mes "[盗贼公会成员]";
			mes "这件事不能作弊，所以一定要杀死5只柳树精。完成后再回来和我说话。";
			mes "和布鲁图斯训练师交谈，他可以把你送到有柳树精的高难度训练场。";
			setquest 7127;
			next;
			mes "[盗贼公会成员]";
			mes "装备盗贼手册后，你可以获得二刀连击技能的效果。";
			mes "二刀连击和隐匿是盗贼的主要技能。";
			close;
		} else if (.@quest == 0 || .@quest == 1) {
			if (checkquest(7127,HUNTING) == 2) {
				mes "[盗贼公会成员]";
				mes "你很强。";
				mes "虽然不多，但请收下这份努力奖励。";
				completequest 7127;
				getitem 12323,50; //N_Fly_Wing
				getexp 5000,100;
				close;
			} else {
				mes "[盗贼公会成员]";
				mes "猎杀5只柳树精后回来找我完成任务。";
				close;
			}
		} else if (.@quest == 2) {
			mes "[盗贼公会成员]";
			mes "我想你已经完成那个任务了，对吧？";
			mes "成为冒险者在世界中成长后，你会体验更多这样的任务。";
			next;
			mes "[盗贼公会成员]";
			mes "你的训练现在完成了。";
			mes "如果你选择成为盗贼，祝你好运。";
			close;
		} else {
			mes "[盗贼公会成员]";
			mes "抱歉，我现在没有任务可以交给你。";
			close;
		}
	case 4:
		mes "[盗贼公会成员]";
		mes "对盗贼职业有疑问的话，尽管来问我。";
		close;
	}
}
new_1-3,105,41,3	duplicate(NvThief)	Thief Guide#nv1	118
new_2-3,105,41,3	duplicate(NvThief)	Thief Guide#nv2	118
new_3-3,105,41,3	duplicate(NvThief)	Thief Guide#nv3	118

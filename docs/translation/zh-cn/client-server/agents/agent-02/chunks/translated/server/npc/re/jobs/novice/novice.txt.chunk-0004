-	script	Merchant Guide#newbe10::NvMerchant	-1,{
	if (job_novice_q < 15) {
		mes "[商人公会成员]";
		mes "你还在布雷德先生的训练过程中。";
		close;
	}
	mes "[商人公会成员]";
	mes "我能怎样帮助你？";
	next;
	switch(select("告诉我商人的事：我想成为商人：给我一个任务：取消")) {
	case 1:
		mes "[商人公会成员]";
		mes "商人？简单来说，就是销售商品赚钱。";
		mes "这就是所有商人的主要职责。";
		next;
		mes "[商人公会成员]";
		mes "我们拥有赚钱的特殊技能。";
		mes "我们可以低价购买商品";
		mes "再以更高的价格卖出。";
		next;
		mes "[商人公会成员]";
		mes "商人还可以拥有手推车";
		mes "可以在里面存放大量物品。";
		next;
		mes "[商人公会成员]";
		mes "^8E2323商人可以转职为铁匠";
		mes "^8E2323或炼金术师^000000作为二转职业。";
		next;
		if (isequipped(2823) || countitem(2823)) {
			mes "[商人公会成员]";
			mes "我认为你应该先体验商人技能，再决定要做什么。";
			close;
		}
		mes "[商人公会成员]";
		mes "想看看成为商人是什么样吗？";
		next;
		switch(select("我想体验商人技能：我不想体验。")) {
		case 1:
			mes "[商人公会成员]";
			mes "这是商人技能手册。";
			mes "同时我会收走其他职业的手册。";
			next;
			callfunc "F_NvErase";
			getitem 2823,1; //Merchant_Manual
			next;
			mes "[商人公会成员]";
			mes "请在物品栏窗口中双击技能手册，确认装备它。";
			mes "按下^4d4dffAlt + S^000000打开技能树，再按窗口右上角的^4d4dff'-'^000000按钮缩小窗口，即可查看可用技能。";
			close;
		case 2:
			mes "[商人公会成员]";
			mes "嗯，你是这么想的吗。";
			mes "好吧，我同意你的看法。选择职业是人生中非常重要的事。";
			mes "想体验商人技能时，随时来和我说话。";
			close;
		}
	case 2:
		mes "[商人公会成员]";
		mes "你想成为商人吗？";
		mes "好吧，那么我马上把你送到商人工会。";
		next;
		mes "[商人公会成员]";
		mes "等等，你确认过职业等级了吗？";
		mes "要完成初心者训练，直接前往商人工会吗？";
		next;
		switch(select("我再考虑一下：是的，我要去商人工会")) {
		case 1:
			mes "[商人公会成员]";
			mes "好吧，希望你考虑成为商人。";
			mes "我们随时欢迎你！";
			close;
		case 2:
			mes "[商人公会成员]";
			mes "太好了。";
			mes "那么我会结束训练流程，立即把你送到商人工会。";
			callfunc "F_NvErase",1;
			close2;
			savepoint "alberta",30,232,1,1;
			warp "alberta_in",62,44;
			end;
		}
	case 3:
		set .@quest, checkquest(7126);
		if (.@quest == -1) {
			mes "[商人公会成员]";
			mes "咦？任务？？";
			mes "嗯……什么任务适合你呢……？";
			mes "好吧，把一些物品卖给土豆商人，带来^5d5dff300 Zeny^000000。";
			next;
			mes "[商人公会成员]";
			mes "装备商人手册后，你可以使用“高价卖出”和“低价买入”技能。";
			setquest 7126;
			next;
			mes "[商人公会成员]";
			mes "我会在这里等你。";
			mes "祝你好运！";
			close;
		} else if (.@quest == 0 || .@quest == 1) {
			if (Zeny >= 300) {
				mes "[商人公会成员]";
				mes "太棒了！";
				mes "Zeny是米德加尔特的货币。";
				mes "你可以通过出售战利品和明智的商业决策赚取Zeny。";
				next;
				mes "[商人公会成员]";
				mes "我们可以用Zeny施展非常强大的技能！";
				mes "金钱攻击！那是我们的终极攻击技能！！";
				mes "我们基本上是把钱贴在武器上再攻击敌人。死于Zeny！呀哈哈哈哈！";
				next;
				mes "[商人公会成员]";
				mes "对了，你做得非常好。所以我该送你些什么……送什么好呢？";
				mes "好吧！给你钢铁结晶怎么样？";
				mes "钢铁结晶是一种可以用于精炼武器的金属。";
				completequest 7126;
				getitem 1010,7; //Phracon
				getexp 5000,100;
				close;
			} else {
				mes "[商人公会成员]";
				mes "Zeny是米德加尔特的货币。";
				mes "你可以通过出售战利品和明智的商业决策赚取Zeny。";
				next;
				mes "[商人公会成员]";
				mes "你可以通过击杀魔物获得战利品。猎杀魔物后，出售战利品就能获利！";
				mes "这是多么有价值的职业啊！不是吗？";
				next;
				mes "[商人公会成员]";
				mes "要不要试着成为商人？赚钱并不容易，但会是很棒的体验！";
				close;
			}
		} else if (.@quest == 2) {
			mes "[商人公会成员]";
			mes "你已经完成这个任务了。";
			mes "进入主世界后，你可以在那里接到各种精彩任务！";
			next;
			mes "[商人公会成员]";
			mes "我想你现在已经足够强，可以转职了吧？哈哈哈，初心者，别在这里浪费太多时间。";
			close;
		} else {
			mes "[商人公会成员]";
			mes "抱歉，我现在没有任务可以交给你。";
			close;
		}
	case 4:
		mes "[商人公会成员]";
		mes "对商人有任何疑问，尽管来问我。";
		mes "我觉得你能成为富有的商人。啊哈哈哈。";
		close;
	}
}
new_1-3,109,41,3	duplicate(NvMerchant)	Merchant Guide#nv1	97
new_2-3,109,41,3	duplicate(NvMerchant)	Merchant Guide#nv2	97
new_3-3,109,41,3	duplicate(NvMerchant)	Merchant Guide#nv3	97

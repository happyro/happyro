				next;
				mes "[刺客‘凯’]";
				mes "填好后把表格";
				mes "交给我。";
				mes "好了，谢谢。";
				next;
				mes "[刺客‘凯’]";
				mes "我会把你传送到";
				mes "测试大厅。";
				mes "祝你好运～";
				close2;
				if (ASSIN_Q3 < 3)
					ASSIN_Q3 = 2;
				ASSIN_Q = 1;
				changequest 8001,8002;
				warp "in_moc_16",19,144;
				end;
			}
			else {
				mes "[刺客‘凯’]";
				mes "你到底是";
				mes "什么人？";
				mes "……守卫！";
				close2;
				warp "moc_fild16",206,229;
				end;
			}
		}
		else {
			mes "[刺客‘凯’]";
			mes "嗯……？";
			mes "怎么，你想骗我吗？你不想成为刺客？";
			next;
			if (select("不。:是的，我想成为刺客。") == 1) {
				mes "[刺客‘凯’]";
				mes "呃，滚出去。";
				mes "别浪费我的时间……";
				close2;
				ASSIN_Q = 0;
				ASSIN_Q2 = 0;
				erasequest 8001;
				warp "moc_fild16",206,229;
				end;
			}
			mes "[刺客‘凯’]";
			mes "...";
			mes "搞什么？";
			mes "好吧。";
			next;
			mes "[刺客‘凯’]";
			mes "在申请表上填写你的名字和职业等级。";
			next;
			mes "[刺客‘凯’]";
			mes "" + strcharinfo(0) + "?";
			mes "这就是你的名字？";
			mes "听起来真有趣。";
			mes "让我看看……职业等级 " + JobLevel + "……";
			next;
			if (JobLevel > 48) {
				mes "[刺客‘凯’]";
				mes "哦？职业等级 " + JobLevel + "？！你一定训练得很刻苦。上司肯定会喜欢……";
				next;
				mes "[刺客‘凯’]";
				mes "表格填好了吗？交给我，我送你去测试大厅。祝你好运～";
				next;
				if (ASSIN_Q3 < 3)
					ASSIN_Q3 = 1;
				ASSIN_Q = 1;
				changequest 8001,8002;
				warp "in_moc_16",19,144;
				end;

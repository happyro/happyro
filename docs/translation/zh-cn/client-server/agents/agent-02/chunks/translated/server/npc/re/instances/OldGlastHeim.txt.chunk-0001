//===== rAthena Script =======================================
//= Old Glast Heim
//===== Description: =========================================
//= Discover the history of events that took place in the
//= Glast Heim castle and how it ended up in ruins.
//===== Changelogs: =================================
//= 1.0 First version. [Euphy, Ziu, Heris]
//=     This is a custom version, and may contain bugs.
//= 1.1 Bug fixes; removed redundant OnInstanceInit scripts.
//= 1.2 Add NPC Hugin's Follower [exneval]
//=     NPC that give access to Glast Heim Nightmare Mode.
//= 1.3 Add some NPCs placeholder. [exneval]
//= 1.4 Update to its official text. [exneval]
//=     Support merchant, enchant, socket features.
//= 1.5 idAthena merge. Removed Hugin's Follower NPCs. [Secretdataz]
//=     Changed `set` calls to direct assignments.
//=     Cleaned up the script.
//=     TODO: Confirm Hugin NPC's code flow.
//= 1.6 Cleaned up the dialogue. [Aleos]
//= 1.7 Implemented fast mode. [Atemo]
//      Note: The treasure room is not accessible in fast mode.
//============================================================

glast_01,204,273,5	script	Hugin	4_M_SAGE_C,{
	if (BaseLevel < 130) {
		mes "[Hugin]";
		mes "变强后再回来吧。";
		mes "比如，达到130级。";
		close;
	}
	if (isbegin_quest(12316) == 0) {
		mes "[Hugin]";
		mes "很久以前，这座城堡不是现在这个样子。";
		next;
		mes "[Hugin]";
		mes "啊，抱歉。我不该在陌生人面前自言自语。";
		next;
		mes "[Hugin]";
		mes "我叫Hugin，正在研究时间与空间之间的维度裂隙。";
		next;
		select("There's something like that here?");
		mes "[Hugin]";
		mes "你有没有想过古拉斯特海姆的历史？";
		next;
		mes "[Hugin]";
		mes "卢恩-米德加尔兹王国历史上有一位名叫Shumiche的国王，被称为暴君。";
		next;
		mes "[Hugin]";
		mes "只要找对地方，时间会揭示真正的答案。";
		next;
		if (select("I don't care about history","That is interesting. Did you find anything?") == 1) {
			mes "[Hugin]";
			mes "真的吗？嗯，感兴趣的时候再回来吧。";
			close;
		}
		mes "[Hugin]";
		mes "其实，穿越维度和时间是可能的，但我太害怕去那里。";
		next;
		mes "[Hugin]";
		mes "你也许可以做到！";
		next;
		mes "[Hugin]";
		mes "你想进行时间旅行吗？";
		next;
		if (select("No, thanks.","Yes, of course I do!") == 1) {
			mes "[Hugin]";
			mes "真的吗？不过天啊，这是多么难得的机会。";
			close;
		}
		mes "[Hugin]";
		mes "我就知道你会理解我的话。请告诉我你想做什么。";
		setquest 12316;// Meeting Hugin
		completequest 12316;
	}
	else {
		mes "[Hugin]";
		mes "嗯？你在别的地方见过我吗？我不这么认为。这次又怎么了？";
		if (isbegin_quest(12322) == 1)
			erasequest 12322;
	}
	next;
	switch( checkquest(12317,PLAYTIME) ) {
	case -1:
		.@party_id = getcharid(1);
		.@p_name$ = getpartyname(.@party_id);
		.@md_name$ = "Old Glast Heim";

		if (!instance_check_party(.@party_id)) {
			mes "[Hugin]";
			mes "组建一个至少两人的队伍后，再来和我谈谈吧。";
			close;
		}
		if (is_party_leader() == true)
			.@menu$ = "Generate Time Gap";
		else {
			mes "[Hugin]";
			mes "我们以前见过吗？不可能。这是我第一次见你。你想做什么？";
		}
		if (isbegin_quest(12318) == 0)
			setquest 12318;// Corrupted Soul Hunt
		switch( select( .@menu$, "Enter Old Glast Heim", "Cancel" ) ) {
		case 1:
			switch( instance_create(.@md_name$) ) {
			case -3:
				dispbottom "纪念地下城‘古老的古拉斯特海姆’已经进行中。",0xFFFFFF;
				close;
			case -4:
			case -2:
			case -1:
				mes "队伍名称：" + getpartyname( getcharid(1) );
				mes "队长：" + strcharinfo(0);
				mes "^0000ff" + .@md_name$ + "^000000 - time gap generation failed.";
				close;
			}
			mes "[Hugin]";
			mes "时间裂隙打开后，再来告诉我。";
			close;
		case 2:
			switch( instance_enter(.@md_name$) ) {
			case IE_OTHER:
				mes "[Hugin]";
			mes "发生了未知错误。";
				close;
			case IE_NOINSTANCE:
				mes "[Hugin]";
			mes "时间裂隙还没有打开。";
				close;
			case IE_NOMEMBER:
				mes "[Hugin]";
			mes "你的身体状况不适合进入时间裂隙。不组队就无法进入。";
				close;
			case IE_OK:
			mapannounce "glast_01", "" + getpartyname( getcharid(1) ) + "队伍成员" + strcharinfo(0) + "进入了" + .@md_name$ + "。", bc_map,0x00FF99;
				setquest 12317;// Trace of Time Travel
				// warp "1@gl_k",150,20;
				end;
			}
		case 3:
			close;
		}
	case 0:
	case 1:
		mes "[Hugin]";
		mes "哦，天啊……";
		mes "你还有时间旅行的后遗症。以这种状态无法再次旅行。";
		next;
		mes "[Hugin]";
		mes "保持健康很重要，请休息一下，稍后再回来。";
		close;
	case 2:
	mes "^0000ff进入古老的古拉斯特海姆的痕迹已经全部清除。现在可以再次和Hugin交谈了。^000000";
		if (isbegin_quest(12318) == 0)
			setquest 12318;// Corrupted Soul Hunt
		erasequest 12317;
		close;
	}
}


// Control Timer
//============================================================
1@gl_k,1,1,0	script	#talkinstance1	HIDDEN_WARP_NPC,{
	end;
OnEnable:
	disablenpc instance_npcname("Heinrich#1");
	enablenpc instance_npcname("Heinrich#2");
	enablenpc instance_npcname("Himelmez#1");
	mapannounce 'map_name$[0], "？？？？：哇哈哈哈哈～！", bc_map,0xFFFF00,FW_NORMAL,18;
	initnpctimer;
	'npc_himelmez1$ = instance_npcname("Himelmez#1");
	'npc_varmundt1$ = instance_npcname("Varmundt#1");
	'npc_heinrich2$ = instance_npcname("Heinrich#2");
	'npc_heinrich3$ = instance_npcname("Heinrich#3");
	end;
OnTimer1500:
		npctalk "Heinrich：你是谁？", 'npc_heinrich2$;
	end;
OnTimer4500:
		npctalk "Himelmez：好啊好啊～我打扰到你们了吗？你们不是在等我吗？", 'npc_himelmez1$;
	end;
OnTimer10000:
		npctalk "Varmundt：Himelmez！！已经来了吗！", 'npc_varmundt1$;
	end;
OnTimer17500:
		npctalk "Himelmez：我叫Lisa Kahn Himelmez。杜拉汉的主人、亡者的女武神，他们都这样称呼我。", 'npc_himelmez1$;
	end;
OnTimer22000:
		npctalk "Heinrich：作为死亡统治者，你是不是太女性化了？我们不怕你……", 'npc_heinrich2$;
	end;
OnTimer28500:
		npctalk "Himelmez：等你知道国王在哪里后，我倒要看看你还能不能这么放松。", 'npc_himelmez1$;
	end;
OnTimer36000:
		npctalk "Heinrich：什么？", 'npc_heinrich2$;
	end;
OnTimer41000:
		npctalk "Himelmez：嗯，现在我引起你的注意了，对吧？", 'npc_himelmez1$;
	end;
OnTimer47000:
		npctalk "Himelmez：你不想知道国王的位置，那就等他回来吧。我喜欢你的纯粹。", 'npc_himelmez1$;
	end;
OnTimer54000:
		npctalk "Himelmez：在这种情况下与你相遇真遗憾。", 'npc_himelmez1$;
	end;
OnTimer59000:
		npctalk "Heinrich：我国王正在拜访卢恩-米德加尔兹王室，还没有回来。", 'npc_heinrich2$;
	end;
OnTimer66500:
		npctalk "Heinrich：现在你又想骗我，他到底怎么了？！", 'npc_heinrich2$;
	end;
OnTimer71500:
		npctalk "Himelmez：好吧～我很想坐下来给你解释，但我今天有点忙～", 'npc_himelmez1$;
	end;
OnTimer78000:
		npctalk "Himelmez：我还有事情要处理。我的部下会替我好好招待你～", 'npc_himelmez1$;
	end;
OnTimer84500:
		npctalk "Heinrich：她可能已经知道Ymir之心碎片在哪里。", 'npc_heinrich2$;
	disablenpc 'npc_himelmez1$;
	end;
OnTimer90500:
		npctalk "Heinrich：所有卡利斯格和白骑士现在跟我来……", 'npc_heinrich2$;
	end;
OnTimer92000:
	for (.@i = 1; .@i <= 20; .@i += 4) {
		hideonnpc instance_npcname("Khalitzburg Knightage#" + .@i);
		hideonnpc instance_npcname("Khalitzburg Knightage#" + (.@i+1));
		hideonnpc instance_npcname("White Knight#" + (.@i+2));
		hideonnpc instance_npcname("White Knight#" + (.@i+3));
	}
	hideonnpc instance_npcname("Khalitzburg Knightage#21");
	hideonnpc instance_npcname("Khalitzburg Knightage#22");

	.@label$ = instance_npcname("#talkinstance1") + "::OnMyMobDead";

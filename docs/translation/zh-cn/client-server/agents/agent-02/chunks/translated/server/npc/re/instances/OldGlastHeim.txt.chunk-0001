1@gl_k,149,41,5	script	Varmundt#0	4_M_BARMUND,{
	if (is_party_leader() == false) {
		mes "[Varmundt]";
		mes "你的队长在哪里？我需要他的帮助。";
		cutin "gl_barmund2",2;
		close3;
	}
	// If the instance has already been completed once, the player can skip sector 1,2,3 and starts from the 1st boss MG_CORRUPTION_ROOT
	if (isbegin_quest(12321) == 2) {
		mes "你有之前的通关记录，可以跳过剧情继续进行。";
		next;
		if (select( "Omit moderately.", "Appreciate everything." ) == 1) {
			cutin "GL_BARMUND1.bmp",2;
			mes "[Varmundt]";
			mes "我见过你，" + strcharinfo(0) + "。";
			mes "我相信你。我们马上出发。";
			close2;
			cutin "",255;
			if ('step == 0) {
				'step = 1;
				'mode = 2;
				disablenpc();
				enablenpc instance_npcname("Heinrich#1");
				enablenpc instance_npcname("Varmundt#1");
			}
			end;
		}
		// (original scenario)
	}
	.@account_id = getcharid(3);
	.@player_name$ = strcharinfo(0);
	mes "[Varmundt]";
	mes "你就是^0000ffHerico^000000派来帮助我的人吗？";
	npctalk "Varmundt：你就是Herico派来帮助我的人吗？";
	cutin "gl_barmund1",2;
	next;
	select("Oh. Well I...");
	mes "[" + .@player_name$ + "]";
	mes "是的，就是我。Herico让我来见你。";
	unittalk .@account_id, .@player_name$ + "：是的，就是我。Herico让我来见你。";
	next;
	mes "[Varmundt]";
	mes "我们没有多少时间了。必须向Heinrich大人报告Himelmez的入侵。";
	npctalk "Varmundt：我们没有多少时间了。必须向Heinrich大人报告Himelmez的入侵。";
	cutin "gl_barmund2",2;
	next;
	select("Himelmez...");
	mes "[" + .@player_name$ + "]";
	mes "Himelmez是谁？";
	unittalk .@account_id, .@player_name$ + "：Himelmez是谁？";
	next;
	mes "[Varmundt]";
	mes "Herico没告诉你吗？";
	npctalk "Varmundt：Herico没告诉你吗？";
	cutin "gl_barmund3",2;
	next;
	mes "[Varmundt]";
	mes "她是死亡统治者、亡者的女武神。Himelmez想从我们这里夺走Ymir之心。";
	npctalk "Varmundt：她是死亡统治者、亡者的女武神。Himelmez想从我们这里夺走Ymir之心。";
	cutin "gl_barmund2",2;
	next;
	mes "[Varmundt]";
	mes "如果她愿意，甚至可能摧毁整座城堡。";
	npctalk "Varmundt：如果她愿意，甚至可能摧毁整座城堡。";
	next;
	mes "[Varmundt]";
	mes "快！向Heinrich大人报告Himelmez的事。我必须检查这里的防御屏障！";
	npctalk "Varmundt：快！向Heinrich大人报告Himelmez的事。我必须检查这里的防御屏障！";
	close2;
	cutin "",255;
	if ('step == 0) {
		'step = 1;
		'mode = 1;
		disablenpc instance_npcname("Varmundt#0");
		enablenpc instance_npcname("Heinrich#1");
		enablenpc instance_npcname("Varmundt#1");
	}
	end;
}


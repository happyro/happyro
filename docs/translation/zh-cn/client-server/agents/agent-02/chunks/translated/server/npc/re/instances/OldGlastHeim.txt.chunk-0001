1@gl_k,149,100,5	script	Heinrich#1	4_M_HEINRICH,{
	if (is_party_leader() == false || 'step != 1) {
		mes "[Heinrich]";
		mes "你的队长在哪里？我必须和他谈谈。";
		cutin "gl_heinrich2",2;
		close3;
	}
	if ('mode == 2) {
		cutin "GL_HEINRICH2.bmp",2;
		select( "Heinrich, you are in the castle now..." );
		mes "[Heinrich]";
		mes "哦，" + strcharinfo(0) + "。";
		mes "我想我可以相信你。我们马上出发。";
		close2;
		cutin "",255;
		if ('step == 1) {
			'step = 2;
			donpcevent instance_npcname("#talkinstance2") + "::OnEnable";
		}
		end;
	}
	.@account_id = getcharid(3);
	.@player_name$ = strcharinfo(0);
	cutin "gl_heinrich2",2;
	select("Sir Heinrich. Varmundt...");
	mes "[" + .@player_name$ + "]";
	mes "Heinrich大人，你知道城堡现在发生了什么吗？";
	unittalk .@account_id, .@player_name$ + "：Heinrich大人，你知道城堡现在发生了什么吗？";
	next;
	mes "[Heinrich]";
	mes "你不是和Varmundt一起来的冒险者吗？";
	npctalk "Heinrich：你不是和Varmundt一起来的冒险者吗？";
	next;
	mes "[Heinrich]";
	mes "怎么了？城堡出问题了吗？";
	npctalk "Heinrich：怎么了？城堡出问题了吗？";
	next;
	select("Himelmez's invasion...");
	mes "[" + .@player_name$ + "]";
	mes "亡者的女武神Himelmez要来夺取藏在城堡里的Ymir之心碎片！";
	unittalk .@account_id, .@player_name$ + "：亡者的女武神Himelmez要来夺取藏在城堡里的Ymir之心碎片！";
	next;
	mes "[Heinrich]";
	mes "哈哈，有趣。你真的认为那可能吗？";
	npctalk "Heinrich：哈哈，有趣。你真的认为那可能吗？";
	cutin "gl_heinrich1",2;
	next;
	mes "[Varmundt]";
	mes "我不是在开玩笑，Heinrich大人。如果我没猜错，她很快就会到这里。";
	npctalk "Varmundt：我不是在开玩笑，Heinrich大人。如果我没猜错，她很快就会到这里。", instance_npcname("Varmundt#1");
	cutin "gl_barmund2",2;
	next;
	mes "[Varmundt]";
	mes "我们必须在Himelmez发动攻击前，把心之碎片藏到安全的地方！";
	npctalk "Varmundt：我们必须在Himelmez发动攻击前，把心之碎片藏到安全的地方！", instance_npcname("Varmundt#1");
	next;
	select("Even if you don't believe me...");
	mes "[" + .@player_name$ + "]";
	mes "我无法让你相信我，但已经没时间争论了！";
	unittalk .@account_id, .@player_name$ + "：我无法让你相信我，但已经没时间争论了！";
	cutin "",255;
	next;
	mes "[Heinrich]";
	mes "谢谢你的帮助。但我们的国王现在甚至不在这里。";
	npctalk "Heinrich：谢谢你的帮助。但我们的国王现在甚至不在这里。";
	cutin "gl_heinrich1",2;
	next;
	mes "[Heinrich]";
	mes "我们不能因为陌生人的一句话就冒险移动心之碎片。";
	npctalk "Heinrich：我们不能因为陌生人的一句话就冒险移动心之碎片。";
	close2;
	cutin "",255;
	if ('step == 1) {
		'step = 2;
		donpcevent instance_npcname("#talkinstance1") + "::OnEnable";
	}
	end;
}


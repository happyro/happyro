	mes "我们一直在等。";
	npctalk "我们一直在等。", instance_npcname("Devotee#1hmoon01");
	next;
	mes "[Devotee]";
	mes "不尊重时间也是对Freyja的亵渎。请谨慎行事。";
	npctalk "不尊重时间也是对Freyja的亵渎。请谨慎行事。", instance_npcname("Devotee#1hmoon03");
	next;

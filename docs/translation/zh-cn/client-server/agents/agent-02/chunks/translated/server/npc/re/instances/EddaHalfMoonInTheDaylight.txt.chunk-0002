	mes "教皇，请注意公众场合的举止。";
	npctalk "教皇，请注意公众场合的举止。", instance_npcname("Devotee#1hmoon02");
	next;
	mes "[Devotee]";
	mes "竟敢如此不尊重教皇！看看你自己！";
	npctalk "竟敢如此不尊重教皇！看看你自己！", instance_npcname("Devotee#1hmoon04");
	next;
	mes "[Devotee]";
	mes "教皇是神圣的！让我们保持这个理想。不要出声！";
	npctalk "教皇是神圣的！让我们保持这个理想。不要出声！", instance_npcname("Devotee#1hmoon05");
	next;
	mes "[Devotee]";

// Treasure Room Exit
//============================================================
gefg_cas01,152,117,0	script	#lever_G01	111,{
	mes " ";
	mes "这里有一根小拉杆。要拉动它吗？";
	next;
	if(select("拉动。:不拉。") == 1) {
		close2;
		warp "gefg_cas01",40,49;
		end;
	}
	close;
}


// President Quest, a.k.a. Schwarzwald Triology Quest
//============================================================
lighthalzen,179,170,4	script	Ordinary Man	4W_M_02,{

	if(!lhz_boss)
	{
		mes "[Ghalstein]";
		mes "你好~莱茵哈特如此壮丽美丽，令人惊叹，不是吗？";
		next;
		switch( select( "我想是吧。","是的。","嗯，我不知道。" ) )
		{
			case 1:
				mes "[Ghalstein]";
				mes "哦，今天天气真好，适合在公园散步或野餐。啊~";
				break;

			case 2:
				mes "[Ghalstein]";
				mes "哦，很高兴你同意。这里的人善良快乐，你能感受到每个人的温暖。";
				break;

			case 3:
				mes "[Ghalstein]";
				mes "也许你现在还没发现，但我相信你很快会找到喜欢这座城市的地方。";
				break;
		}
		next;
		if(BaseLevel < 60)
		{
			mes "[Ghalstein]";
			mes "哈哈哈！总之，祝你今天愉快~";
			close;
		}
		mes "[Ghalstein]";
		mes "是的，莱茵哈特不可能更完美了。啊哈哈哈……不过……嗯，没事。";
		next;
		mes "[Ghalstein]";
		mes "哈哈哈！总之，祝你今天愉快~";
		set lhz_boss,1;
		close;
	}
	else if(lhz_boss == 1)
	{
		if(rand(1,5) == 4)
		{
			mes "[Ghalstein]";
		mes "嗯？今天有点多云，不是吗？待在室内听音乐、喝热茶也不错。";
			close;
		}
		mes "[Ghalstein]";
		mes "啊！天气真舒适~我很高兴能在外面享受阳光。";
		mes "感受一下，阳光照在脸上很温暖，不是吗？";
		close;
	}
	else if(lhz_boss == 2)
	{
		mes "[Ghalstein]";
		mes "阳光柔和，微风轻拂。哦，天气好得不能更好了！";
		next;
		switch( select( "是的，你说得对。","呃，你刚才在做什么？" ) )
		{
			case 1:
				mes "[Ghalstein]";
				mes "是的，现在正适合外出享受清新的空气。来，和我深呼吸。哦……啊~太棒了！";
				close;

			case 2:
				mes "[Ghalstein]";
				mes "...";
				mes "......";
				mes "我不太明白你的意思。我只是像往常一样享受莱茵哈特的阳光……";
				next;
				switch( select( "但我听到你在谈论什么……" ) )
				{
					case 1:
						break;
				}
				mes "[Ghalstein]";
				mes "不！你一定认错人了！现在请容我告辞……";
				set lhz_boss,3;
				next;
				mes "^3355FF即使你刚才听到的不是 Ghalstein，他对你的话反应也很强烈，仿佛有什么要隐瞒……^000000";
				close;
		}
	}
	else if(lhz_boss == 3)
	{
		mes "[Ghalstein]";
		mes "嗯？看你的表情，你似乎仍相信我参与了某种秘密会议。";
		next;
		switch( select( "是的，我确定！","嗯……" ) )
		{
			case 1:
				mes "["+strcharinfo(0)+"]";
				mes "是的，我确定！那绝对是你！你的声音和说话方式不会错！";
				next;
				mes "[Ghalstein]";
				mes "......";
				mes "..........";
				mes "...............";
				next;
				mes "[Ghalstein]";
				mes "好吧，是的，我确实秘密见了某人。";
				mes "但你凭什么用这种咄咄逼人的方式审问我？";
				next;
				switch( select( "我不是在审问……","抱歉。" ) )
				{
					case 1:
						mes "["+strcharinfo(0)+"]";
						mes "我不是在审问你。不，完全不是。只是，呃……";
						next;
						switch( select( "你在和谁打交道？","我只是好奇。" ) )
						{
							case 1:
								mes "["+strcharinfo(0)+"]";
							mes "你在和谁打交道？我听说有个组织非常强大，我开始担心了。";
								next;
								mes "["+strcharinfo(0)+"]";
							mes "即使想忽视，我也无法对危险公司充耳不闻。对此置之不理似乎不对……";
								next;
								mes "[Ghalstein]";
							mes "嗯……你真的这么想？";
								next;
								mes "[Ghalstein]";
							mes "请给我一点时间。我需要想想如何最好地处理这种情况。";
								set lhz_boss,4;
								close;

							case 2:
								mes "[Ghalstein]";
								mes "只是好奇……？我希望你不要仅仅因为好奇就过多干涉他人的生活。";
								next;
								mes "[Ghalstein]";
								mes "如果你不感兴趣或不愿投入，就不该把事情当成自己的责任。现在，请容我告辞……";
								close;
						}
					case 2:
						mes "["+strcharinfo(0)+"]";
						mes "抱歉。我不是故意的。";

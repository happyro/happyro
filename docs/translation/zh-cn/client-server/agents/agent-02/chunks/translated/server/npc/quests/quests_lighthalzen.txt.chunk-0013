						mes "可以被视为证据。";
						mes "我建议你带来真正支持你主张的东西。";
						set lhz_curse,29;
						close;
					}
					break;
				case 2:
					mes "[Sueii Slierre]";
					mes "如果你说完了，我想继续工作。请原谅。";
					close2;
					set lhz_curse,30;
					end;
				}
				break;
			}
			break;
		}
	}
	else if (lhz_curse == 29) {
		mes "[Sueii Slierre]";
		mes "嗯，你回来是要处理关于 Wolfchev 工作的主张吗？";
		mes "如果没有证据，就不该散布谣言……";
		next;
		if (countitem(7345) > 0) {
			mes "^3355FF你展示了在实验室找到的手铐，Slierre 秘书的脸上立刻蒙上一层深深的忧虑。^000000";
			next;
			mes "[Sueii Slierre]";
			mes "...";
			mes "......";
			next;
			select("雷根贝勒在做什么？:Wolfchev 在做什么？");
			mes "[Sueii Slierre]";
			mes "...";
			mes "......";
			emotion ET_AHA;
			next;
			mes "[Sueii Slierre]";
			mes "所以……你怀疑 Wolfchev 在雷根贝勒实验室的研究？";
			next;
			switch(select("是:否")) {
			case 1:
				break;
			case 2:
				mes "[Sueii Slierre]";
				mes "等等，你究竟怀疑什么？";
				mes "基本上，你觉得哪一方应对此事负责？";
				next;
				switch(select("雷根贝勒:Wolfchev 先生")) {
				case 1:
					mes "[Sueii Slierre]";
					mes "我可以向你保证，雷根贝勒有严格的协议和流程，";
					mes "确保安全并防止实验中的不必要残酷。";
					next;
					switch(select("雷根贝勒里的生物呢？")) {
					case 1:
						mes "[Sueii Slierre]";
						mes "生物？我猜它们是实验的结果。";
						mes "但我无法确定。";
						next;
						break;
					}
					break;
				case 2:
					break;
				}
				break;
			}
			mes "[Sueii Slierre]";
			mes "我现在无法完全确定，但这看起来是相当确凿的证据。";
			mes "我们会立即派人前往雷根贝勒！";
			next;
			mes "[Sueii Slierre]";
			mes "目前你的主张值得调查。";
			mes "如果发现重要情况，我会通知你……";
			set lhz_curse,30;
			close;
		}
		else {
			mes "[Sueii Slierre]";
			mes "嗯，我不能把你这次带来的东西视为能消除我对你主张疑虑的证据。";
			mes "请原谅，我要继续工作了。";
			set lhz_curse,29;
			close2;
			warp "lhz_in01",228,226;
			end;
		}
	}
	else if (lhz_curse == 30) {
		set .@li_keka,rand(1,10);
		if (.@li_keka > 7) {
			if (checkweight(1201,1) == 0) {
				mes "[Sueii Slierre]";
				mes "哦，我想和你谈谈。请减少所携带物品的重量后再回来，好吗？";
				close;
			}
			mes "[Sueii Slierre]";
			mes "哦，很好，你来了。你一直都是对的。";
			mes "调查发现 Wolfchev 进行未经授权且极其危险的研究。感谢你。";
			next;
			select("他在做什么……？");
			mes "[Sueii Slierre]";
			mes "原来 Wolfchev 从贫民窟绑架虚弱病患，把他们当作实验对象。";
			mes "请放心，他会因行为受到惩罚，甚至被解雇。";
			next;
			mes "[Sueii Slierre]";
		mes "我认为你值得道歉。没有你的";
			mes "否则我们公司的声誉可能受损。谢谢你。";
			next;
			mes "[Sueii Slierre]";
			mes "是的，没有什么比在人身上进行 Homunculus 实验更禁忌！";
			mes "请收下这个作为我们的谢意，冒险者。";
			set lhz_curse,31;
			changequest 2094,2095;
			getitem 603,1; //Old_Blue_Box
			getitem 12016,10; //Speed_Up_Potion
			next;
			mes "[Sueii Slierre]";
			mes "我向你保证，雷根贝勒会确保此类事件不再发生，";
			mes "并会尽力对此进行补偿……";
			close;
		}
		else {
			mes "[Sueii Slierre]";
			mes "哦，我们仍在调查你的主张。";
			mes "有新进展时会通知你。";
			close;
		}
	}
	else if (lhz_curse > 30) {
		mes "[Sueii Slierre]";
		mes "很高兴有像你这样积极且关心公司的顾客支持雷根贝勒。";
		close;
	}
	else {
		mes "[Sueii Slierre]";
		mes "抱歉，你不允许进入这里。";
		mes "如有关于雷根贝勒的问题，请前往服务台。谢谢合作。";
		close;
	}
}

lhz_que01,94,24,0	script	#li_end	HIDDEN_NPC,2,2,{
OnTouch_:
	if (lhz_curse > 30) {
		mes "^3131FF实验室里没有那个疯狂科学家的踪迹，只剩下整齐堆放的文件。^000000";
		if (lhz_curse == 31) {
			set lhz_curse,32;
			completequest 2095;
		}
		close;
	}
	end;
}

lhz_in01,43,114,0	script	#li_toend	WARPNPC,1,1,{

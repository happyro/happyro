	warp "yuno_fild08",69,183;
	end;
}

//----------------------------------------------------------------------------
// Grave/Kiel Hyre dungeon entry
//----------------------------------------------------------------------------
yuno_fild08,71,170,0	script	Grave#kh	111,{
	if (KielHyreQuest < 36) {
		mes "^3355FF只是一座坟墓。";
		mes "也许以后对你很重要，";
		mes "但现在它";
		mes "并不能真正帮助你。^000000";
		mes "";
		close;
	}
	else if (KielHyreQuest == 36) {
		if (countitem(7492) < 1) {
			mes "^3355FF只是一座坟墓。";
			mes "也许以后对你很重要，";
			mes "但现在它";
			mes "并不能真正帮助你。^000000";
			mes "";
			close;
		}
		else {
			mes "^3355FF这座坟墓附近有一扇";
			mes "秘密门。看起来门上";
			mes "装有某种插槽";
			mes "和数字键盘。^000000";
			mes "";
			next;
			mes "^3355FF你应该把什么";
			mes "插入插槽？^000000";
			next;
			input .@KHInput$;
			if (.@KHInput$ == "Yellow Keycard") {
				mes "^3355FF插入黄色钥匙卡后，";
				mes "响起电子确认铃声，";
				mes "随后自动语音问道：^000000";
				mes "";
				next;
				mes "[Security System]";
				mes "请输入密码。";
				next;
				input .@KHInput$;
				next;
				if (.@KHInput$ == "4772961") {
					mes "[Security System]";
					mes "密码确认。";
					mes "欢迎，基尔·海勒。";
					next;
					mes "^3355FF你听到另一声";
					mes "悦耳的蜂鸣，";
					mes "一条秘密通道打开了。^000000";
					set KielHyreQuest,38;
					close;
				}
				else {
					mes "[Security System]";
					mes "密码错误。";
					mes "请重试。";
					close;
				}
			}
			else {
				mes "^3355FF无论你试图把什么";
				mes "插入插槽，";
				mes "都完全不起作用……^000000";
				close;
			}
		}
	}
	else if ((KielHyreQuest >= 38) && (KielHyreQuest < 106)) {
		mes "^3355FF工厂的门";
		mes "大敞着。^000000";
		next;
		switch(select("进入:取消")) {
		case 1:
			warp "kh_dun01",3,230;
			end;
		case 2:
			mes "......";
			mes ".........";
			mes "............";
			close;
		}
	}

	else if (KielHyreQuest >= 106) {
		if (countitem(7509) < 1) {
			mes "^3355FF秘密入口";
			mes "现在已经封闭。^000000";
			close;
		}
		else {
			mes "当你靠近坟墓时，";
			mes "它开始发出";
			mes "闪光。^000000";
			next;
			switch(select("使用 ^0000FF豪华钥匙卡^000000:忽略")) {
			case 1:
				mes "使用豪华钥匙卡后，";
				mes "一条秘密通道打开了。^000000";
				mes "";
				next;
				switch(select("进入:取消")) {
				case 1:
					warp "kh_dun01",3,230;
					end;
				case 2:
					mes "......";
					mes ".........";
					mes "............";
					close;
				}
			case 2:
				mes "......";
				mes ".........";
				mes "............";
				close;
			}
		}
	}
}


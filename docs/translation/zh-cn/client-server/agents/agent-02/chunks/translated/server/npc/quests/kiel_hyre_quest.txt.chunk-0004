yuno_fild02,93,210,4	script	Cottage Keeper#kh	85,{
	if ((KielHyreQuest < 12) || (KielHyreQuest > 12)) {
		mes "[Cottage Keeper]";
		mes "这是私人财产，";
		mes "未经许可请不要进入";
		mes "此区域。";
		close;
	}
	else if (KielHyreQuest == 12) {
		mes "[Cottage Keeper]";
		mes "这是私人财产，";
		mes "未经许可请不要进入";
		mes "此区域。";
		next;
		switch(select("我与基尔·海勒有约。:好吧。")) {
		case 1:
			mes "[Cottage Keeper]";
			mes "你和";
			mes "基尔·海勒大师有约？";
			mes "嗯，你确定吗？";
			mes "";
			next;
			switch(select("是:否")) {
			case 1:
				mes "[Cottage Keeper]";
				mes "一定是哪里出了";
				mes "错误。海勒先生如果";
				mes "要赴约，就不会";
				mes "离开这里……";
				mes "";
				set KielHyreQuest,14;
				close;
			case 2:

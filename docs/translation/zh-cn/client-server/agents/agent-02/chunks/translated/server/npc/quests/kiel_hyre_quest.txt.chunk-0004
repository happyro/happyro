		mes "应该通向艾莉的房间。";
		mes "虽然她让你找梯子";
		mes "从窗户进入，";
		mes "但你大概找不到。";
		mes "也许你可以";
		mes "爬上那根水管……^000000";
		next;
		switch(select("爬水管:寻找其他方法")) {
		case 1:
			if (rand(1,3) == 2) {
				mes "^3355FF你爬上水管，";
				mes "成功偷偷进入艾莉的";
				mes "房间。^000000";
				close2;
				warp "kh_school",185,185;
				end;
			}
			else {
				mes "^3355FF你试图爬上水管，";
				mes "却掉了下来，";
				mes "撞到了";
				mes "头。^000000";
				percentheal -10,0;
				close;
			}
		case 2:
			mes "^3355FF一定还有其他方法";
			mes "可以进入艾莉的房间，";
			mes "不必爬这根水管……^000000";
			mes "";
			close;

		}
	}
	else {
		mes "^3355FF你无法从那扇";
		mes "打开的窗户进去。^000000";
		close;
	}
}

//----------------------------------------------------------------------------
// Elly (In Dormitory)
//----------------------------------------------------------------------------
kh_school,178,180,4	script	Elly	895,{
	if (checkweight(908,200) == 0) {
		mes "^3355FF等一下……";
		mes "你现在携带了太多物品，";
		mes "所以需要先腾出";
		mes "更多背包空间……^000000";
		mes "";
		mes "";
		close;
	}
	if (KielHyreQuest < 30) {
		mes "[Elly]";
		mes "你到底是谁？";
		mes "你、你不应该";
		mes "能进来的！";
		mes "马上离开这里！";
		close2;
		percentheal -99,0;
		warp "yuno_fild08",100,100;
		end;
	}
	else if (KielHyreQuest < 32) {
		mes "[Elly]";
		mes "……";
		mes "………";
		mes "…………";
		close;
	}
	else if (KielHyreQuest == 32) {
		mes "[Elly]";
		mes "……";
		mes "………";
		mes "…………";
		next;
		mes "^3355FF艾莉似乎中了诅咒，";
		mes "完全静止，";
		mes "毫无生气。你必须";
		mes "做点什么，";
		mes "但该怎么办？^000000";
		next;
		switch(select("摇晃她叫醒她。:大喊叫醒她。:忽略")) {
		case 1:
			mes "^3355FF你抓住艾莉的肩膀，";
			mes "用力摇晃她的身体，";
			mes "试图让她";
			mes "回应。^000000";
			next;
			mes "["+strcharinfo(0)+"]";
			mes "艾莉？艾莉！不！";
			mes "快回来！";
			next;
			mes "^3355FF艾莉没有回应……^000000";
			close;
		case 2:
			input .@KHInput$;
			if (.@KHInput$ == "Wake up, Elly!") {
				mes "[Elly]";
				mes "………………";
				next;
				mes "^3355FF你说出那些话后，";
				mes "一把 ^000000小金钥匙^3355FF";
				mes "和一个 ^000000按钮^3355FF 从艾莉手中掉落。";
				mes "她似乎醒了，";
				mes "但只有一瞬间。^000000";
				getitem 7493,1; //Golden_Key
				getitem 7494,1; //Kiel_Button
				set KielHyreQuest,34;
				close;
			}
			else {
				mes "[Elly]";
				mes "......";
				mes ".........";
				mes "............";
				next;
				mes "^3355FFElly's not responding...^000000";
				close;
			}
		case 3:
			mes "^3355FF好吧……";
			mes "但迟早有一天，";
			mes "你应该尝试解除";
			mes "艾莉身上的诅咒。^000000";
			close;
		}
	}
	else if (KielHyreQuest == 34) {
		if (countitem(7491) < 1) {
			//Missing text, needs another run through.
			mes "^3355FF也许金钥匙^000000";
			mes "能打开小屋里的某样东西。^000000";
			mes "再仔细看看小屋吧。^000000";
			close;
		}
		else {
			mes "^3355FF看起来艾莉的";
			mes "金钥匙可能适合";
			mes "你在基尔·海勒小屋内";
			mes "找到的灰色箱子的锁孔。^000000";
			mes "";
			next;
			mes "^3355FF你成功用金钥匙打开";
			mes "灰色箱子，";
			mes "在里面找到蓝色钥匙卡和";
			mes "一张折叠的纸条。";
			mes "你迅速读完纸条内容……^000000";
			mes "";
			next;
			mes "亲爱的艾莉：";
			mes "基尔最终打破了禁忌，";
			mes "试图把你们变成";
			mes "可怕的东西。";
			mes "^FFFFFF_^000000";
			mes "等你读到这封信时，";
			mes "我的生命可能已经陷入危险。";
			mes "我能否活下来取决于你。";
			mes "^FFFFFF_^000000";
			mes "见到傀儡时你就会知道，";
			mes "但我想亲口告诉你：";
			mes "你不是人类。";
			mes "进入教堂旁墓地附近的工厂入口，";
			mes "你就会了解详情。然后我希望";
			mes "你在工厂的秘密房间里";
			mes "找到阿莉西亚。";
			mes "";
			mes "";
			mes "我已经把你的名字登记进";
			mes "她的安全系统，所以别担心。";
			mes "希望阿莉西亚会来";
			mes "救我……";
			mes "^FFFFFF_^000000";
			mes "抱歉，";
			mes "爷爷。";
			getitem 7495,1; //Blue_Key_Card
			delitem 7491,1; //Iron_Box
			set KielHyreQuest,36;
			close;
		}
	}
	else if (KielHyreQuest >= 36) {
		mes "^3355FF你就是在这里";
		mes "发现了那张";
		mes "锁在灰色箱子里的纸条。";
		mes "下面的消息是";
		mes "艾莉的祖父";
		mes "基尔·海勒写在纸条上的。^000000";
		next;
		mes "亲爱的艾莉：";
		mes "基尔最终打破了禁忌，";
		mes "试图把你们变成";
		mes "可怕的东西。";
		mes "^FFFFFF_^000000";
		mes "等你读到这封信时，";
		mes "我的生命可能已经陷入危险。";
		mes "我能否活下来取决于你。";
		mes "^FFFFFF_^000000";
		mes "见到傀儡时你就会知道，";
		mes "但我想亲口告诉你：";
		mes "你不是人类。";
		mes "进入教堂旁墓地附近的工厂入口，";
		mes "你就会了解详情。然后我希望";
		mes "你在工厂的秘密房间里";
		mes "找到阿莉西亚。";
		mes "";
		mes "";
		mes "我已经把你的名字登记进";
		mes "她的安全系统，所以别担心。";
		mes "希望阿莉西亚会来";
		mes "救我……";
		mes "^FFFFFF_^000000";
		mes "抱歉，";
		mes "爷爷。";
		close;
	}
}

//----------------------------------------------------------------------------
// Cookie Basket
//----------------------------------------------------------------------------
kh_school,175,176,0	script	Cookie Basket#kh	111,{
	if (KielHyreQuest < 30) {
		mes "^3355FF这是一个装满";
		mes "美味饼干的";
		mes "饼干篮。^000000";
		close;
	}
	else if (KielHyreQuest == 30) {
		mes "^3355FF这一定是";
		mes "艾莉的饼干篮。";
		mes "饼干之间似乎";
		mes "夹着一张折叠的";
		mes "纸条。^000000";
		next;
		switch(select("阅读纸条:忽略")) {
		case 1:
			mes ""+strcharinfo(0)+", help!";
			mes "有个穿黑衣服的人";
			mes "四处走动，";
			mes "还在施放奇怪的法术！";
			mes "就是他让人们变得冰冷、";
			mes "毫无生气，像傀儡一样！";
			mes "我好害怕！";
			mes "^FFFFFF_^000000";
			mes "希望你能收到这张纸条……";
			mes "他追赶我，";
			mes "但我把自己锁在房间里。";
			mes "我要把窗户打开，";
			mes "这样你还能找到我。";
			mes "希望他不要对我施放诅咒！";
			set KielHyreQuest,32;
			close;
		case 2:
			mes "^3355FF那张纸条大概";
			mes "不是专门写给你的，";
			mes "不管怎样。^000000";
			close;
		}
	}
	else if (KielHyreQuest < 108) {
		mes "^3355FF这些饼干还没有";
		mes "变质，";
		mes "但已经不再温热。";
		mes "如果不是室温，";
		mes "那就有点凉了。^000000";
		close;
	}
	else if (KielHyreQuest == 108) {
		mes "^3355FF你盯着";
		mes "饼干篮时，";
		mes "窗外的风吹动它，";
		mes "露出一封藏在下面的信。";
		mes "这封信大概是艾莉写的，";
		mes "留给你";
		mes "阅读。^000000";
		next;
		mes "^333333Dearest "+strcharinfo(0)+",";
		mes " ";
		mes "老师通常会因为我犯很多错";
		mes "而责骂我，";
		mes "但今天莱科兰夫人";
		mes "夸奖了我的美味饼干！";
		mes "这一切都要感谢你，我的朋友。";
		mes "我很高兴能遇见你：";
		mes "是你让我知道";
		mes "世界上还有好人。";
		mes "我知道爷爷也会喜欢你，";
		mes "但我不知道";
		mes "他现在在哪里……";
		mes " ";
		mes "总有一天，我希望成为";
		mes "像你一样善良的人。";
		mes "让我们保持联系，成为";
		mes "真正的好朋友，好吗？";
		mes " ";
		mes "你的艾莉^000000";
		next;
		mes "^3355FF你仿佛仍能从饼干篮中";
		mes "感受到艾莉的温暖";
		mes "与善意。";
		mes "你拿起一块饼干，";
		mes "放入口中。";
		mes "它的味道甜中带着";
		mes "苦涩。";
		set KielHyreQuest,109;
		next;
		input .@input$;
		mes "["+strcharinfo(0)+"]";
		mes ""+.@input$+"";
		mes "该回去了。我不能";
		mes "在这里待太久。";
		close2;
		warp "yuno_fild08",69,183;
		end;
	}
	else {
		mes "^3355FF这篮子里的饼干";
		mes "全都变质了！";
		mes "嗯，这并不令人意外。";
		mes "毕竟已经过了很久";
		mes "它们才被烤出来。^000000";
		mes "";
		close;
	}
	end;
}


			next;
			mes "[Aged Stranger]";
			mes "好。准备演奏 Gusli 时告诉我。";
			mos_whale_edq = 36;
			close;	
		case 3:
			mes "[Aged Stranger]";
			mes "我明白了。好，我们走吧。";
			next;
			mes "[Aged Stranger]";
			mes "想再次回来时，在莫斯科比亚码头演奏 Gusli。";
			next;
			mes "[Aged Stranger]";
			mes "即使还不会熟练演奏，也不用担心。";
		mes "只要发出声音。";
			next;
			mes "[Aged Stranger]";
		mes "这座岛……这头鲸鱼……能从无限远处感知 Gusli 的声音。";
			next;
			mes "[Aged Stranger]";
		mes "无论你在哪里，只要演奏这件乐器，我就会带着岛屿去找你。前提是你是朋友……呵呵。";
			next;
			callsub S_AS_3;
			close2;
			warp "moscovia",162,56;
			end;
	}
	
S_AS_3:
	soundeffect "mos_gusli1.wav",0;
	mes "-老人开始演奏-";
	mes "闭着眼睛演奏乐器。";
	mes "他没有反应……仿佛坠入自己的世界。";
	return;
}


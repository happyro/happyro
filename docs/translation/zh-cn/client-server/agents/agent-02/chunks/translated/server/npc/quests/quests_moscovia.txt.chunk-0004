mosk_in,131,92,3	script	Csar Alexsay III#npc	4_M_RUSKING,7,7,{
	if ((MaxWeight-Weight) < 2000) {
		mes "[Csar Alexsay III]";
		mes "你携带的物品太多。请使用卡普拉服务后再来。";
		close;
	}
	if (mos_nowinter == 12) {
		mes "[Csar Alexsay III]";
		mes "你！！！许多人看到你和 Baba Yaga 会面！";
		next;
		mes "[Csar Alexsay III]";
		mes "与女巫秘密会面时，必然感到罪恶……";
		next;
		mes "[Csar Alexsay III]";
		mes "因此，我们将不经公正审判判处你死刑！";
		next;
		mes "[Csar Alexsay III]";
		mes "但你是这片土地的外人……所以我会对你进行特别审判。";
		next;
		mes "[Csar Alexsay III]";
		mes "如果你有话要说……不要遗漏任何细节。";
		next;
		select("解释情况。");
		mes "-与芭芭谈论发生的事情-";
		mes "Baba Yaga，并继续执行计划。";
		next;
		mes "[Csar Alexsay III]";
		mes "嗯哼，这故事真丢脸……但如果你说的是真的，我的人民会很高兴。";
		next;
		mes "[Csar Alexsay III]";
		mes "好吧，带来证据，让我相信你说的话。";
		next;
		mes "[Csar Alexsay III]";
		mes "你杀死了 Baba Yaga！！如果是真的，带来 Yaga 的杵。";
		mes "这样我会确保没人再怀疑你。";
		next;
		if (countitem(7762) > 39) {
			if(select("展示 Yaga 的杵。:什么也不做。") == 1) {
				mes "[" + strcharinfo(0) + "]";
				mes "是的，给你。";
				next;
				mes "-交出了雅加的研杵。-";
				delitem 7762,40;
				next;
				mes "[Csar Alexsay III]";
				mes "嗯……你确实有。";
				mes "目前我承认你可以自由出入并猎杀 Baba Yaga。";
				next;
				mes "[Csar Alexsay III]";
				mes "但不要做可疑行为，煽动我的人民做出奇怪举动！";
				next;
				mes "[Csar Alexsay III]";
				mes "否则我会立即逮捕你！所以小心行事。";
				next;
				mes "[Csar Alexsay III]";
				mes "当你成功用魔法驱散冬天后，立即向我报告。";
				mos_nowinter = 14;
				changequest 18076,18077;
				close;
			}
		}
		mes "[Csar Alexsay III]";
		mes "我说过要你带来 40 根 Yaga 的杵，来自 Baba Yaga。";
		mos_nowinter = 13;
		close;
	}
	else if (mos_nowinter == 13) {
		mes "[Csar Alexsay III]";
		mes "旅行者，你带来解决疑问的证据了吗？";
		next;
		if(select("是的，我做到了。:我很困惑。") == 1) {
			if (countitem(7762) > 39) {
				delitem 7762,40;
				mes "[Csar Alexsay III]";
				mes "很好，我不再怀疑你了。因为你已经证明了自己，";
				mes "你可以继续自由旅行。";
				next;
				mes "[Csar Alexsay III]";
				mes "当然，我讨厌与 Baba Yaga 合作。";
				mes "但你的工作让人民高兴，我也会满意。";
				next;
				mes "[Csar Alexsay III]";
				mes "目前我承认你可以自由出入并猎杀 Baba Yaga。";
				next;
				mes "[Csar Alexsay III]";
				mes "但不要做可疑行为，煽动我的人民做出奇怪举动！";
				next;
				mes "[Csar Alexsay III]";
				mes "否则我会立即逮捕你！所以小心行事。";
				mos_nowinter = 14;
				changequest 18076,18077;
				close;
			}
			mes "[Csar Alexsay III]";
				mes "你的物品数量不是 40 根 Yaga 的杵。你是忘了数量，还是想骗我……";
			next;
			mes "[Csar Alexsay III]";
				mes "我就当这是玩笑！一种讽刺！现在离开，带来证明清白的证据。";
			close;
		}
		mes "[Csar Alexsay III]";
		mes "我说过要你带来 40 根 Yaga 的杵，来自 Baba Yaga。";
		next;
		mes "[Csar Alexsay III]";
	mes "你是来戏弄我的吗？";
		close;
	} else if (mos_nowinter == 14) {
		mes "[Csar Alexsay III]";
	mes "为了我和人民的利益，最好由我留在这里。";
	mes "我不想亲自见 Baba Yaga。";
		next;
		mes "[Csar Alexsay III]";
	mes "所以我希望你代替我去做。";

	295: [
		{
			//EF_TALK_FROSTJOKE	   Frost Joke
			type: 'FUNC',
			attachedEntity: true,
			func: function (Params) {
				if (Params.Init.ownerAID == Session.Entity.GID) {
					const msg = DB.getRandomJoke();
					if (msg) {
						ChatBox.onRequestTalk('', msg, ChatBox.TYPE.PUBLIC);
					}
				}
			}
		}
	],


cmd_in01,14,14,0	script	Examiner#sd	-1,6,6,{
OnInit:
	disablenpc "Examiner#sd";
	end;

OnTouch_:
	if (.s_check < 30) {
		if (sign_q == 30) {
			set sign_q,32;
		}
	}
	else if (.s_check < 34) {
		if (sign_q == 30) {
			set sign_q,33;
		}
	}
	else if (.s_check == 34) {
		if (sign_q == 30) {
			set sign_q,34;
		}
	}
	warp "cmd_in01",29,33;
	donpcevent "Examiner#sd::OnDisable";
	end;

OnUp:
	set .s_check,.s_check + 1;
	end;

OnDisable:
	set .s_check,0;

		mes "<FONT SIZE = 16><B>That's right!!!</FONT></B>";
		mes "<FONT SIZE = 14><B>It would be easier if we just admit it to ourselves!!!</FONT></B>";
		cutin "ep18_maram_02.png",2;
		npctalk "Forget it!", "Maram#ep18_merchant2", bc_self;

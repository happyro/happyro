		cutin "katsua01.bmp",255;
		close;
		break;
	}
	getitem .@item,1;
	cutin "katsua01.bmp",255;
	cutin "katsua02.bmp",2;
	mes "[Kachua]";
	mes "啊～那颗钻石真漂亮。";
	mes "真希望我能给你更好的回报。";
	close2;
	cutin "katsua02.bmp",255;
	end;
}

comodo,204,148,7	script	Devellin	4_F_01,{
	mes "[Devellin]";
	mes "听说不久前有个旅行者给卡秋娅看了一颗巨大的钻石。";
	mes "从那以后，她谈论的全是钻石，以及她有多想要钻石。";
	next;
	mes "[Devellin]";
	mes "她越来越执迷于此，真让我害怕。看来她愿意为了钻石牺牲自己拥有的一切。";
	next;
	mes "[Devellin]";
	mes "她是那种为了得到想要的东西什么都做得出来的人。我担心她会拿比钻石珍贵得多的东西来交换……";
	close;
}

comodo,210,154,2	script	Suspicious Guy#cmd	2_M_THIEFMASTER,{
	if (BaseClass == Job_Thief){
		mes "[Cain]";
		mes "嘿……";
		mes "看来你我从事的是同一行。嘿嘿，我给你个重要情报。";
		next;
		mes "[Cain]";
		mes "我一直向别人收取这条情报的费用，不过既然你我算是同行，我就不好意思收你的 Zeny 了。";
		next;
		mes "[Cain]";
		mes "看到那边的女士了吗？";
		mes "她对钻石如痴如醉。据我的消息，她富得流油，有成堆的贵重物品。";
		next;
		mes "[Cain]";
		mes "我是说稀有物品。";
		mes "我偷偷看过她的收藏，发现她有一顶山羊角头盔，甚至还有王冠！她富得离谱！";
		next;
		mes "[Cain]";
		mes "传闻她还藏有一批稀有装备和武器！怎么样？要不要和我合作，去抢她的房子？";
		next;
		switch(select("不用了，谢谢。:好，我加入！")){
		case 1:
			mes "[Cain]";
			mes "什么……？";
			mes "拜托！我以为你就是干这行的！算了，我自己来，但这件事要保密，明白吗？";
			close;
		case 2:
			mes "[Cain]";
			mes "哈哈哈！";
			mes "……^660000笨蛋^000000！";
			mes "我只是开玩笑，";
			mes "别放在心上！";
			next;
			mes "[Cain]";
			mes "对了，据说有座山里埋着大量钻石。我的朋友说山附近还有一座矿山，所以去那里应该能找到钻石。";
			next;
			mes "[Cain]";
			mes "去那里收集一些钻石，再拿来交换那位老妇人的收藏，应该不会有什么坏处。保重，朋友～";
			close;
		}
	}
	mes "[Cain]";
	mes "嘿……";
	mes "我有条重要情报给你。";
	mes "只要 500 Zeny，";
	mes "相信我，绝对值得。";
	mes "怎么样……？";
	next;
		switch(select("好吧。:不用了，谢谢。")){
	case 1:
		if (Zeny > 499){
			mes "[Cain]";
			mes "看到那边的女士了吗？她对钻石如痴如醉。据我的消息，她富得流油，有成堆的贵重物品。";
			next;
			mes "[Cain]";
			mes "我是说稀有物品。";
			mes "我偷偷看过她的收藏，发现她有一顶山羊角头盔，甚至还有王冠！她富得离谱！";
			next;
			mes "[Cain]";
			mes "你有机会得到稀有装备和武器！她愿意用任何东西换一颗 3 克拉钻石。如果你有，就去找她吧。";
			next;
			mes "[Cain]";
			mes "对了，据说有座山里埋着大量钻石。";
			mes "我的朋友说山附近还有一座矿山，所以去那里应该能找到钻石。";
			next;
			mes "[Cain]";
			mes "去那里收集一些钻石，再拿来交换那位老妇人的收藏，应该不会有什么坏处。保重，朋友～";
			Zeny = Zeny-500;
			close;
		}
		mes "[Cain]";
		mes "搞什么？！";
		mes "你没钱吗？我不是说要 500 Zeny 吗？这种情报可不便宜！";
		close;
	case 2:
		mes "[Cain]";
		mes "嘿，嘿！";
		mes "你是吝啬鬼吗？凡事都有代价，这条情报绝对值这个价。来吧，你不会放弃的，对吧？";
		close;
	}
}


}

job_gun,74,24,6	script	Drunken Man	4_M_LIEMAN,{
	mes "[Drunken Man]";
	mes "*Hiccups* Oh, I'm the owner here.";
	mes "Oh wait, am I in the pub or someplace else? Zzz...";
	close;
}


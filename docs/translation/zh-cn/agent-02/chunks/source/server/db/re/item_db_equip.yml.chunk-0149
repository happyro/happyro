    EquipLevelMin: 200
    Refineable: true
    Gradable: true
    Script: |
      .@g = getenchantgrade();
      .@r = getrefine();
      bonus bSMatk,1+(.@r/2);
      bonus bSpl,1;
      bonus bMatk,5*.@r;
      if (.@r>=7) {
         bonus bSMatk,2;
         bonus bSpl,2;
         if (.@r>=9) {
            bonus bMaxHPrate,5;
            bonus bMaxSPrate,5;
            if (.@r>=11) {
               bonus2 bMagicAtkEle,Ele_Ghost,35;
               bonus2 bMagicAtkEle,Ele_Dark,35;
            }
         }
      }
      if (.@g >= ENCHANTGRADE_D) {
         bonus bSMatk,2;
         if (.@g >= ENCHANTGRADE_C) {
            bonus bSMatk,1;
            bonus bSpl,3;
            if (.@g >= ENCHANTGRADE_B) {
               bonus2 bMagicAddEle,Ele_All,15;
            }
         }
      }

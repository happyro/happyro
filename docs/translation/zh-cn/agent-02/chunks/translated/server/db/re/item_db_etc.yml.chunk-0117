  - Id: 310270
    AegisName: Improve_Orb_T_ATK
    Name: T-PowerBoost
    Type: Card
    SubType: Enchant
    Script: |
      .@r = getrefine();
      bonus bBaseAtk,50;
      if (.@r>=7) {
         .@c = 35;
         .@t = 3000;
         if (.@r>=8) {
             .@c = 49;
             .@t += 1000;
         }
         if (.@r>=9) {
             .@c = 70;
             .@t += 1000;
         }
         autobonus "{ bonus bBaseAtk,100; }",.@c,.@t,BF_WEAPON;
      }
  - Id: 310271

      .@g = getenchantgrade();
      .@r = getrefine();
      bonus bUnbreakableWeapon;
      bonus bAtkRate,5;
      bonus bPow,2;
      bonus2 bSkillAtk,"IQ_THIRD_PUNISH",5;
      if (.@r>=5) {
         bonus2 bSkillAtk,"IQ_THIRD_PUNISH",10;
         if (.@r>=7) {
            bonus bShortAtkRate,5;
            if (.@r>=9) {
               bonus2 bSkillAtk,"IQ_THIRD_PUNISH",10;
               if (.@r>=10) {
                  bonus bCritical,10;

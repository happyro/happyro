            bonus2 bAddSize,Size_All,10;
            if (.@g>=ENCHANTGRADE_B) {
               bonus2 bAddRace,RC_All,10;
               if (.@g>=ENCHANTGRADE_A) {
                  bonus2 bAddEle,Ele_All,10;
               }
            }

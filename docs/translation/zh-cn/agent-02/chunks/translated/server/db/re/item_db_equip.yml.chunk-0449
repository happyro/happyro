            }
         }
      }
      if (.@g>=ENCHANTGRADE_D) {
         bonus bMatkRate,3;
         bonus bSpl,2;
         if (.@g>=ENCHANTGRADE_C) {
            bonus bSMatk,2;
            if (.@g>=ENCHANTGRADE_B) {
               bonus bSMatk,3;
               bonus bRes,20;
               if (.@g>=ENCHANTGRADE_A) {
                  bonus bSpl,2*(readparam(bInt)/15);
               }
            }
         }
      }
  - Id: 490277

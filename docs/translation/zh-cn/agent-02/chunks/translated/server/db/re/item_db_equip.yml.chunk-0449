      .@g = getenchantgrade();
      .@r = getrefine();
      bonus bAllTraitStats,3;
      bonus bVariableCastrate,-10;
      if (.@r>=7) {
         bonus bPAtk,3;
         if (.@r>=9) {
            bonus bPAtk,2*.@param;
            bonus bSta,4*.@param;
            if (.@r>=12) {
               bonus bFixedCast,-300;
            }
         }
      }
      if (.@g>=ENCHANTGRADE_D) {
         bonus bAtkRate,3;
         bonus bPow,2;
         if (.@g>=ENCHANTGRADE_C) {
            bonus bPAtk,2;
            if (.@g>=ENCHANTGRADE_B) {
               bonus bPAtk,3;
               bonus bRes,20;
               if (.@g>=ENCHANTGRADE_A) {
                  bonus bPow,2*(readparam(bStr)/15);
               }
            }
         }
      }

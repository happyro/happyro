			mes "[加尔滕]";
			mes "大家都说阿哈特像柔弱的春芽，";
			mes "但我不同意！";
			mes "我从没见过比他更强的萨帕。";
			mes "但我不明白他为什么没有成为加尔滕……";
			next;
			mes "- 继续谈论阿哈特。";
			mes "看来不会再得到更多信息了。-";
			setquest 7190;
			close;
		}
		mes "[加尔滕]";
		mes "阿哈特……";
		mes "他是个强大的萨帕。";
		mes "他也许只是处理成堆文件的部长，";
		mes "但一定隐藏了自己的力量！";
		next;
		mes "[加尔滕]";
		mes "大家都说阿哈特像柔弱的春芽，";
		mes "但我不同意！";
		mes "我从没见过比他更强的萨帕。";
		mes "但我不明白他为什么没有成为加尔滕……";
		next;
		mes "[加尔滕]";
		mes "也许他身体强壮，但内心温暖……";
		mes "不过谁知道呢……";
		close;
	}
	mes "[加尔滕]";
	mes "你看起来是个经验丰富的冒险者。";
	mes "我想试试你的实力。";
	mes "……哈哈哈。";
	mes "开玩笑的。我不能和我们土地上的客人战斗。";
	close;
}

dic_fild01,231,174,5	script	BK#ep133_18	496,{
	if (ep13_3_secret < 3) {
		mes "[BK]";
		mes "哈。我是猫商人的情报收集者。";
		mes "什么都可以问我……不过……";
		mes "喵……我可不是好对付的猫。";
		next;
		mes "[BK]";
		mes "走开，哈。";
		close;
	}
	else if ((ep13_3_secret == 3) || (ep13_3_secret == 4)) {
		mes "[BK]";
		mes "哼……";
		mes "什么事？";
		mes "……哦，是萨帕首都的人类。";
		mes "喵……";
		next;
		if (select("关于长着猫耳朵的人：你是什么？") == 1) {
			mes "[BK]";
			mes "哈，我是BK，猫商人臭名昭著的情报收集者。";
			mes "但我没有情报可以告诉你。";
			next;
			mes "[BK]";
			mes "我可不是好对付的猫。";
			mes "喵……喵。";
			mes "喵……猫耳朵。哈哈……我听说过一些……喵……";
			next;
			mes "[BK]";
			mes "我才不告诉你～！";
			close;
		}
		mes "[BK]";
		mes "哈。我是猫商人的情报收集者。";
		mes "什么都可以问我……不过……";
		mes "喵……我可不是好对付的猫。";
		close;
	}
	else if (ep13_3_secret == 5) {
		mes "[BK]";
		mes "哈。我是猫商人的情报收集者。";
		mes "..............";
		mes "我不会随便把情报告诉别人。";
		mes "喵……";
		next;
		mes "- 猫商人集团的 BK 很难对付。";
		mes "沙伊让你做什么？-";
		next;
		input .@inputstr$;
		if (.@inputstr$ == "Shay's special drink will be delivered" || .@inputstr$ == "Shay's special drink will be delivered.") {
			mes "[" + strcharinfo(0) + "]";
			mes "嗯。如果你不合作，";
			mes "沙伊的特制饮料就会送到。";
			mes "由沙伊本人亲自送来！";
			next;
			mes "[BK]";
			mes "什么？！";
			mes "你想要什么？";
			mes "为什么要骚扰我？";
			mes "欺负人……呜呜。";
			emotion ET_CRY;
			next;
			mes "[BK]";
			mes "好吧。我会合作。";
			mes "但有几个条件。";
			mes "第一，你必须告诉沙伊我和你合作了。";
			next;
			mes "[BK]";
			mes "第二，我们必须见到部长，才能扩大生意。";
			mes "但需要用萨帕证明才能见到他。";
			next;
			mes "[BK]";
			mes "所以我要用情报换取萨帕证明。";
			mes "准备好后告诉我。";
			set ep13_3_secret, 6;
			close;
		}
		mes "[" + strcharinfo(0) + "]";
		mes "" + .@inputstr$ + ".....?";
		mes "嗯……我觉得你错了？";
		mes "是什么来着……";
		next;
		mes "[BK]";
		mes "什么？你是在用那个威胁我吗？";
		mes "喵……你还不够了解我～！！";
		close;
	}
	else if (ep13_3_secret == 6) {
		mes "[BK]";
		mes "……那么你想知道什么？";
		next;
		switch (select("关于其他猫科种族")) {
		}
		mes "[BK]";
		mes "猫科？你是在问我们这些猫吗？";
		mes "嗯～";
		mes "我不了解其他种族……不过……哈哈……";
		next;
		mes "- BK 索要一张萨帕证明。-";
		next;
		if (select("没门。：给你。") == 1) {
			mes "[BK]";
			mes "哼。";
			mes "我们已经谈好了。";
			mes "把一张萨帕证明交给BK。";
			close;
		}
		if (countitem(6304)) {
			mes "[BK]";
			mes "哈哈……很好，很好。";
			mes "我不了解我们种族以外的事情，";
			mes "但我确实见过^4d4dff一个长着可爱耳朵的人，他一直在访问迪卡斯特斯迪尔^000000。";
			next;
			mes "[BK]";
			mes "我甚至看到他独自会见了^4d4dff新部长^000000。";
			mes "呼呼……";
			mes "满意了吗？";
			delitem 6304,1; //Sapa_Feat_Cert
			set ep13_3_secret, 7;
			next;
			mes "- BK 说完后从你手中拿走了萨帕证明。";
			mes "关于多哈提到的兽耳之人的情报！-";
			close;
		}
		mes "[BK]";
		mes "我提供情报，";
		mes "你给我一张萨帕证明，";
		mes "这不是很好的合作吗？";
		next;
		mes "[BK]";
		mes "如果你想知道我的情报，就必须给我一张萨帕证明。";
		close;
	}
	else if (ep13_3_secret == 7 || ep13_3_secret == 8) {
		if (ep13_3_secret == 7) {
			mes "[BK]";
			mes "……我不是刚告诉过你那个猫耳男人吗？";
			mes "我在迪尔见过他和部长在一起。";
			next;
			if (select("关于拉维尔？：部长是谁？") == 1) {
				mes "[BK]";
				mes "拉维尔是高级部长。";
				mes "类似首领。";
				mes "他们也叫他长老。";
				mes "我们会叫他领袖吧？";
				next;
				mes "[BK]";
				mes ".......ah.........";
				mes "我本该先拿到萨帕证明再回答。";
				close;
			}
			mes "[BK]";
			mes "那个臭名昭著的";
			mes "^4d4dff阿哈特^000000。";
			mes "新部长……";
			mes "（BK 搓着前爪）";
			next;
			if (select("给一张证明。：没门。") == 2) {
				mes "[BK]";
				mes "不，不，违反契约。";
				mes "不给我证明，我什么都不会说。";
				close;
			}
			if (!countitem(6304)) {
				mes "[BK]";
				mes "不给我证明，我什么都不会说。";
				close;
			}
			mes "[BK]";
			mes "新部长不是这里的人。";
			mes "下面有一道巨大的裂缝。";
			next;
			mes "[BK]";
			mes "新部长是在^4d4dff裂缝附近^000000被发现的。";
			mes "他一定是外星人！";
			delitem 6304,1; //Sapa_Feat_Cert
			set ep13_3_secret, 8;
			next;
			select("你为什么这么想？");
		}
		else if (ep13_3_secret == 8) {
			mes "[BK]";
			mes "现在又怎么了？";
			mes "又是部长的故事？";
			next;
			if (select("部长是外星人？：没什么……") == 2) {
				mes "[BK]";
				mes "喵～";
				mes "我还以为你带了沙伊的食物作为奖励。";
				mes "（BK 光是想想就发抖）";
				next;
				mes "[BK]";
				mes "呕……";
				mes "我连想象都不敢。";
				mes "…………哈！别把这件事告诉沙伊！";
				close;
			}
		}
		if (countitem(6304)) {
			mes "[BK]";
			mes "因为他不是萨帕！";
			next;
			select("他不是萨帕？");
			mes "[BK]";
			mes "是的。";
			mes "但这不是很奇怪吗？";
			mes "这里所有萨帕都认为他是美丽的萨帕……";
			mes "但我从远处见过他，他并不是。";
			next;
			mes "[BK]";
			mes "在我看来，他是猫科生物。";
			mes "甚至可能是我失散的朋友。";
			next;
			mes "[BK]";
			mes "不过我不明白为什么，因为所有萨帕";
			mes "都很美丽。";
			delitem 6304,1; //Sapa_Feat_Cert
			set ep13_3_secret, 9;
			changequest 7191,7192;
			next;
			mes "- BK 说完后从你手中拿走了萨帕证明。";
			mes "萨帕部长阿哈特不是萨帕的惊人情报！-";
			next;
			mes "[" + strcharinfo(0) + "]";
			mes "……我必须查清楚。";
			mes "他说在裂缝附近……";
			mes "我该去和沙伊谈谈吗？";
			close;
		}
		mes "- BK 对我的问题举起前爪。";
		mes "粉红色果冻般的爪子正在索要萨帕证明。-";
		close;
	}
	else if (ep13_3_secret == 9) {
		mes "[BK]";
		mes "你为什么总是回来？";
		mes "如果你对新部长好奇，为什么不自己去裂缝那里？";
		mes "他就是从那里来的，你会找到什么的。喵。";
		close;
	}
	mes "[BK]";
	mes "喵～";
	mes "我还以为你带了沙伊的食物作为奖励。";
	mes "（BK 光是想想就发抖）";
	next;
	mes "[BK]";
	mes "呕……";
	mes "我连想象都不敢。";
	mes "…………哈！别把这件事告诉沙伊！";
	close;
}

-	script	ep133_crack#main	-1,{
	// if ((GetInventoryRemainCount 1301 3 == 2) || (GetInventoryRemainCount 1301 3 == 3)) {
	if ((MaxWeight - Weight) < 1000) {
		mes "- 你携带的物品太多，无法继续任务。-";
		close;
	}
	set .@n$, strnpcinfo(1);
	setarray .@npc$, 	"Rock Pile",	"Dirt Pile",	"Split Earth";
	setarray .@item, 	6307,			6306,			6305;
	for (set .@size, getarraysize(.@npc$); .@i < .@size; set .@i, .@i + 1)
		if (.@n$ == .@npc$[.@i]) set .@type, .@i;
	
	if (ep13_3_secret == 10) {
		if (.@npc$[.@type] == "Rock Pile") {
			mes "由于地壳运动不稳定，周围有许多岩石堆。";
			mes "这堆岩石也是其中之一。";

		}
		else if (.@npc$[.@type] == "Dirt Pile") {
			mes "裂缝附近有几堆泥土。";
			mes "这就是其中一堆。";
		}
		else if (.@npc$[.@type] == "Split Earth") {
			mes "地面被次元裂缝的冲击震裂。";
			mes "裂开的地面坚硬而冰冷，看起来像锋利的刀刃。";
		}
		mes "没有发现可疑之处。";
		next;
		set .@menu$, (.@npc$[.@type] == "Rock Pile")? "Try to knock down the rock pile.:Study the pile closely." : "Stomp on it with your feet.:Poke around in the dirt pile.";
		if (select(.@menu$) == 1) {
			if (.@npc$[.@type] == "Rock Pile") mes "把组成岩石堆的小石子打散，铺开它们。";
			else if (.@npc$[.@type] == "Dirt Pile") mes "你踩在挖出的泥土堆上，把地面踩平。";
			else if (.@npc$[.@type] == "Split Earth") mes "你踩在干燥、裂开的地面上，把地面踩平。";
			donpcevent strnpcinfo(0)+"::OnDisable";
			close;
		}
		if (.@npc$[.@type] == "Rock Pile") {
			mes "你从小石块中感受到邪恶的能量。";
			mes "它看起来并不自然，更像是附近强大魔法留下的残余。";
			mes "你感受到邪恶能量。这和阿哈特有关吗？";
			mes "你收集了一块散发奇异能量的石头。";
		}
		else if (.@npc$[.@type] == "Dirt Pile") {
			mes "你翻找泥土堆，发现泥土中凝结的血迹。";
			mes "你感受到邪恶能量。这和阿哈特有关吗？";
			mes "你收集了凝结的血迹。";
		}
		else if (.@npc$[.@type] == "Split Earth") {
			mes "锋利的裂缝表面被冰霜冻住了什么东西。";
			mes "你仔细一看，发现那似乎是某种在地面爬行的生物的皮肤。";
			mes "你感受到邪恶能量。这和阿哈特有关吗？";
			mes "你收集了凝结的血迹。";
		}
		set ep13_3_secret, 11;
		getitem .@item[.@type], 1;
		erasequest 7193;
		setquest 7194;		
		donpcevent strnpcinfo(0)+"::OnDisable";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "嗯……我可能需要和沙伊讨论这些。";
		close;
	}
	else if (ep13_3_secret == 11) {
		mes "[" + strcharinfo(0) + "]";
		if (.@npc$[.@type] == "Rock Pile") mes "这里就是你捡到奇异魔法石头的地方。";
		else if (.@npc$[.@type] == "Dirt Pile") mes "你在这里的泥土堆中收集了凝结的血迹。";
		else if (.@npc$[.@type] == "Split Earth") mes "这里就是发现冻结皮肤的地方。";
		mes "周围也能感受到奇异能量。";
		mes "回酒馆和沙伊谈谈吧。";
		close;
	}
	else if (ep13_3_secret == 17) {
		if (countitem(.@item[.@type]) < 10) {
			if (.@npc$[.@type] == "Rock Pile") {
				mes "由于地壳运动不稳定，周围有许多岩石堆。";
				mes "这就是其中一堆。";
				mes "你从小石块中感受到邪恶的能量。";
			}
			else if (.@npc$[.@type] == "Dirt Pile") {
				mes "裂缝附近有几堆泥土。";
				mes "这就是其中一堆。";
				mes "你在泥土堆下发现凝结的血迹。";
			}
			else if (.@npc$[.@type] == "Split Earth") {
				mes "次元裂缝附近的地面被某种冲击震裂。";
				mes "这就是其中一处。";
				mes "锋利的裂缝表面被冰霜冻住了什么东西。";
			}
			getitem .@item[.@type], 1;
			donpcevent strnpcinfo(0)+"::OnDisable";
			next;
			if (.@npc$[.@type] == "Rock Pile") mes "你收集石头碎片。";
			else if (.@npc$[.@type] == "Dirt Pile") mes "收集血迹。";
			else if (.@npc$[.@type] == "Split Earth") mes "收集一块皮肤。";
			if (countitem(.@item[.@type]) == 10) {
				mes "收集的数量已经足够交给柴郡，但";
				mes "可能还需要一些来单独报告。";
				if (checkquest(7202) == -1) setquest 7202;
				close;
			}
			mes "收集的数量不足以完成柴郡的请求。";
			close;
		}
		else if (countitem(.@item[.@type]) == 10) {
			if (checkquest(7202) >= 0) {
				setarray .@str$, "stone fragments","bloodstains","pieces of skin";
				mes "需要更多" + .@str$[.@type] + "，才能回远征营地向多哈报告。";
			}
			else {
				if (.@npc$[.@type] == "Rock Pile") mes "需要更多石头碎片，才能回远征营地向多哈报告。";
				else if (.@npc$[.@type] == "Dirt Pile") mes "你收集的数量足够交给柴郡，但还需要更多来向多哈报告。";
				else if (.@npc$[.@type] == "Split Earth") mes "你收集的皮肤数量足够交给柴郡，但还需要更多来向多哈报告。";
				setquest 7202;
			}
			if (.@npc$[.@type] == "Rock Pile") mes "你又收集了一块散发奇异魔力的石头碎片。";
			else if (.@npc$[.@type] == "Dirt Pile") mes "你又从泥土堆中收集了一块凝结的血迹。";
			else if (.@npc$[.@type] == "Split Earth") mes "你又收集了一块冻结在裂开的地面冰霜中的皮肤。";
			getitem .@item[.@type], 1;
			donpcevent strnpcinfo(0)+"::OnDisable";
			close;
		}
		mes "不需要再收集了。";
	}
	if (ep13_3_ahtdayq == 1) {
		if (countitem(.@item[.@type]) < 10) {
			if (.@npc$[.@type] == "Rock Pile") {
				mes "你从小石块中感受到邪恶的能量。";
				mes "收集石头碎片，再打散并铺开石堆，让它看起来保持自然。";
			}
			else if (.@npc$[.@type] == "Dirt Pile") {
				mes "你在泥土堆下发现凝结的血迹。";
				mes "你收集凝结的血迹，然后踩平泥土堆，不留下痕迹。";
			}
			else if (.@npc$[.@type] == "Split Earth") {
				mes "锋利的裂缝表面被冰霜冻住了某种皮肤。";
				mes "你收集冻结的皮肤，然后踩平地面，不留下痕迹。";
			}
			getitem .@item[.@type], 1;
			donpcevent strnpcinfo(0)+"::OnDisable";
			close;
		}
		setarray .@str$, "stone fragments","bloodstains","pieces of skin";
		mes "不需要再收集更多" + .@str$[.@type] + "了。";
		close;
	}
	mes "发现了某种东西的痕迹。";
	mes "它被整齐地安排过。";
	close;
OnEnable:
	hideoffnpc strnpcinfo(0);
	end;
OnDisable:
	hideonnpc strnpcinfo(0);
	initnpctimer;
	end;
OnReset:
	hideoffnpc strnpcinfo(0);
	stopnpctimer;
	end;
OnTimer60000:
OnTimer120000:
OnTimer180000:
OnTimer240000:
	if (!rand(2)) {
		hideoffnpc strnpcinfo(0);
		stopnpctimer;
	}
	end;

OnTimer300000:
	hideoffnpc strnpcinfo(0);
	stopnpctimer;
	end;
}
dic_fild02,269,55,0	duplicate(ep133_crack#main)	Rock Pile#ep133_ef1	844

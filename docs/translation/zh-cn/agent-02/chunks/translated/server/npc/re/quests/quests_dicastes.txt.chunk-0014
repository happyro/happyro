	if (isequipped(2782)) {
		if (!ep13_3_invite) {
			mes "-看起来像来自马努克的萨帕使者。-";
			next;
			mes "[Hound]";
			mes "抱歉，请你现在离开好吗？";
			mes "你似乎没有队长或艾洛的许可。";
			close;
		}
		if (ep13_3_invite == 1) {
			mes "[Sapha]";
			mes "- 这个人看起来像来自马努克的萨帕使者。-";
			mes "你只是站在那里，";
			mes "完全听不懂他说的话，";
			mes "旁边的远征队守卫便开始说明。-";
			next;	
			callfunc "eldicastes_c",3;
		}
		else if (ep13_3_invite == 2) {
			mes "[Vyhannus]";
			mes "你们的指挥官像风一样。";
			mes "曼努克也有这样的人。";
			mes "他叫加尔滕。他动作太快，快到你察觉不到盔甲的重量。";
			next;
			callfunc "eldicastes_c",1;
		} 
		else if (ep13_3_invite == 3) {
			callfunc "eldicastes_c",2;
		}
		else if (ep13_3_invite == 4) {
			mes "[Vyhannus]";
			mes "雪崩会在曼努克行动部大楼。";
			mes "得到他的许可后，你就能使用通往首都的隧道。";
			mes "隧道可能有点吓人。";
			mes "但你很强，我相信你一定能走到尽头。";
			close;
		} 
		else if (ep13_3_invite == 5) {
			mes "[Vyhannus]";
			mes "哦，隧道吗？";
			mes "那里原本是矿井。";
			mes "但挖矿时我们发现自己到了另一边。";
			next;
			mes "[Vyhannus]";
			mes "后来我们找到了更好的矿井，曼努克也因此建立起来。";
			mes "隧道经过重新规划，连接首都和曼努克。";
			next;
			mes "[Vyhannus]";
			mes "就是这样。";
			close; 
		} 
		else if (ep13_3_invite == 6) {
			mes "[Vyhannus]";
			mes "你获得了迪卡斯特之光。";
			mes "有了它，你随时随地都能回到迪尔。";
			mes "看起来是为了方便你而制作的物品。";
			next;
			mes "[Vyhannus]";
			mes "拉维尔似乎很喜欢你。";
			mes "比起穿过漫长的隧道，使用迪卡斯特之光更加方便。";
			next;
			mes "[Vyhannus]";
			mes "哦，隧道吗？";
			mes "那里原本是矿井。";
			mes "但挖矿时我们发现自己到了另一边。";
			next;
			mes "[Vyhannus]";
			mes "后来我们找到了更好的矿井，曼努克也因此建立起来。";
			mes "隧道经过重新规划，连接首都和曼努克。";
			next;
			mes "[Vyhannus]";
			mes "就是这样。";
			close;
		}
		mes "[Vyhannus]";
		mes "连接曼努克和首都的隧道。";
		mes "那里原本是矿井。";
		mes "但挖矿时我们发现自己到了另一边。";
		next;
		mes "[Vyhannus]";
		mes "后来我们找到了更好的矿井，曼努克也因此建立起来。";
		mes "隧道经过重新规划，连接首都和曼努克。";
		next;
		mes "[Vyhannus]";
		mes "就是这样。";
	}
	mes "[Sapha]";
	mes "∃∝∪? ∀ ⊃∝...";
	mes "∽∫∠ ∃ ?";
	mes "∵∽..?";
	next;
	mes "[Hound]";
	mes "你的翻译戒指呢？";
	mes "我可不会当你的私人翻译。";
	close;
}

mid_campin,168,125,3	script	Hound#ep133_is06	997,{
	if (!isequipped(2782)) {
		mes "[Hound]";
		mes "翻译戒指在哪里？";
		mes "没有的话就应该制作一个。";
		mes "我想亲自和你交谈。";
		close;
	}
	if (!ep13_3_invite) {
		mes "[Hound]";
		mes "抱歉，请你现在离开好吗？";
		mes "你似乎没有队长或艾洛的许可。";
		close2;
	}
	else if (ep13_3_invite == 1) {
		callfunc "eldicastes_c",3;
	}
	else if (ep13_3_invite == 2) {
		callfunc "eldicastes_c",1;
	} 
	else if (ep13_3_invite == 3) {
		callfunc "eldicastes_c",2;
	} 
	else if (ep13_3_invite == 4) {
		mes "[Hound]";
		mes "到达曼努克后，你首先要去见总守卫雪崩。";
		mes "告诉雪崩你是维汉努斯邀请来的人。";
		next;
		mes "[Hound]";
		mes "之后只要经过简单确认，就能获准通过通往首都的隧道。";
		mes "只要保持礼貌，通过隧道并不难。";
		next;
		mes "[Hound]";
		mes "别忘了队长说过的话。";
		mes "多哈检查员就在隔壁房间。";
		close; 
	}
	else if (ep13_3_invite > 4) {
		mes "[Hound]";
		mes "我刚结束长期派遣，从曼努克回来，";
		mes "还没有休息。";
		mes "迪卡斯特……等你们的先遣队安顿下来，我会抽时间去拜访。";
		next;
		mes "[Hound]";
		mes "我得在这里照顾维汉努斯。";
		mes "也许有一天，像维汉努斯这样的萨帕人会和我们一起生活在这片大陆。";
		close;
	}
	mes "[Hound]";
	mes "我刚结束长期派遣，从曼努克回来，";
	mes "还没有休息。";
	mes "迪卡斯特……等你们的先遣队安顿下来，我会抽时间去拜访。";
	next;
	mes "[Hound]";
	mes "我得在这里照顾维汉努斯。";
	mes "也许有一天，像维汉努斯这样的萨帕人会和我们一起生活在这片大陆。";
	close;
}

mid_campin,165,127,5	script	Hibba Agip#ep133_is07	459,{
	mes "[Hibba Agip]";
	mes "嗯……？";
	mes "我该走了。";
	close2;
OnInit:
	disablenpc();
	end;	
}

man_in01,315,52,3	script	Guard Captain Avalanche	450,{
	mes "[Guard Captain Avalanche]";
	if (!isequipped(2782)) {
		mes "∃∝∪? ∀ ⊃∝...";
		mes "∽∫∠ ∃ ?";
		mes "∵∽..?";
		close;	
	}
	if (ep13_3_invite == 4) {
		mes "[Avalanche]";
		mes "你是人类。";
		mes "你来这里做什么？";
		next;
		select("我是应维汉努斯的邀请来的。" );
		mes "[Avalanche]";
		mes "啊，贾鲁特·维汉努斯。";
		mes "我本以为他最好带一名守卫同行，不过……";
		next;
		mes "[Avalanche]";
		mes "看来维汉努斯信任你们人类。";
		mes "只要维汉努斯认可你，我就没有意见。";
		next;
		mes "[Avalanche]";
		mes "我批准你通过这里前往首都迪卡斯特。";
		mes "大楼外有一条通往首都的隧道，沿着村庄东侧山脉向下。";
		next;
		mes "[Avalanche]";
		mes "那是一条通往首都的隧道。卡米达尔山太大，没有其他绕行路线。";
		next;
		mes "[Avalanche]";
		mes "隧道维护得很好，但曾经有一段连接";
		mes "山中最低处洞窟的隧道坍塌，还收到野生怪物出没的报告。";
		next;
		mes "[Avalanche]";
		mes "所以建议你结伴同行。";
		mes "路途危险，而且可能很长。";
		mes "我暂时就说这些。";
		next;
		mes "[Avalanche]";
		mes "回来时请告诉我首都的消息。";
		mes "哈哈……";
		set ep13_3_invite, 5;
		changequest 7183,7184;
		close2;
	}
	else if (ep13_3_invite == 5) {
		mes "[Avalanche]";
		mes "走出大楼，向村庄东侧山下直走。";
		mes "看到守卫隧道的士兵，你就知道到了。";
		next;
		mes "[Avalanche]";
		mes "希望迪卡斯特之光能为你指路。";
		close;
	}
	else if (ep13_3_invite == 6) {
		mes "[Avalanche]";
		mes "哦……你有迪卡斯特之光。";
		mes "它会让你的旅途更加方便。";
		next;
		mes "[Avalanche]";
		mes "通往首都的路以前是矿井。";
		mes "所以即使隧道维护良好，仍会有野生怪物出现的报告。";
		next;
		mes "[Avalanche]";
		mes "无论何时都要照顾好自己。";
		mes "哈哈……不过你们人类确实很强。";
		close;
	}
	mes "[Avalanche]";
	mes "通往首都的路以前是矿井。";
	mes "所以即使隧道维护良好，仍会有野生怪物出现的报告。";
	next;
	mes "[Avalanche]";
	mes "无论何时都要照顾好自己。";
	mes "哈哈……不过你们人类确实很强。";
	close;
}

dic_in01,42,264,3	script	Adventurer Clerk#ep133	453,{
	if (!isequipped(2782)) {
		mes "[Clerk Knit]";
		mes "∝∵∈ ∋ ∧∮∏ ⊆ ∫...?";
		mes "∃⊆⊂ ... ∏ ⊇∀∧ ⊂ ∠∋∩...";
		next;
		mes "- 无法与他交流。-";
		close;
	}
	mes "[Clerk Rhawyne]";
	mes "我能帮你什么？";
	next;
	switch (select("登记为冒险者。：交谈。：取消。")) {
		case 1:
			if (ep13_3_invite < 5) {
				mes "[Clerk Rhawyne]";
				mes "你想登记为冒险者吗？";
				mes "奇怪。";
				mes "访客名单上没有你。";
				mes "你是未经许可进入的吗？";
				next;
				mes "[Clerk Rhawyne]";
				mes "没有正式许可的其他种族都会受到限制。";
				mes "我马上叫加尔滕来。";
				next;
				mes "萨帕办事员随时都可以叫来加尔滕守卫。";
				mes "最好避免这种情况。";
				close;
			}
			else if (ep13_3_invite == 5) {
				mes "[Clerk Rhawyne]";
				mes "你想登记为冒险者吗？";
				mes "我会和曼努克的邀请名单进行比对。";
				mes "你的名字是？";
				next;
				mes "[" + strcharinfo(0) + "]";
				mes "是" + strcharinfo(0) + "。";
				next;
				mes "[Clerk Rhawyne]";
				mes "是的……" + strcharinfo(0) + "……";
				mes "找到了。";
				mes "欢迎来到萨帕首都迪卡斯特。";
				next;
				mes "[Clerk Rhawyne]";
				mes "在这里你会受到和其他萨帕人一样的待遇，";
				mes "可以自由行动，";
				mes "也可以接受迪卡斯特的正式委托。";
				next;
				mes "[Clerk Rhawyne]";
				mes "这是访问迪卡斯特的小纪念品。";
				mes "想回迪卡斯特时随时可以使用。";
				next;
				set ep13_3_invite, 6;
				getitem 2844,1; //El_Dicastes_Light
				completequest 7184;
				mes "[Clerk Rhawyne]";
				mes "皮奥姆住宅区下方有一处专供人类使用的地方。";
				mes "用你们的语言叫作……";
				mes "酒馆。希望你能去那里看看。";
				close;
			}
			mes "[Clerk Rhawyne]";
			mes "奇怪。";
			mes "你不是已经登记了吗？";
			mes "记录里有你的名字。";
			close;
		case 2:
			if (ep13_3_secret == 12) {
				mes "[Clerk Rhawyne]";
				mes "我认得你。";
				mes "我能帮你什么？";
				next;
				if (select("我想见大臣。：没什么特别的事。") == 1) {
					mes "[Clerk Rhawyne]";
					mes "你想见大臣？";
					mes "哪位大臣？";
					mes "即使有功绩证明，也不能亲自会见拉维尔。";
					next;
					if (select("阿哈特：另一位大臣") == 1) {
						if (countitem(6304) > 2) {
							mes "[Clerk Rhawyne]";
							mes "你真的已经收集了3张萨帕功绩证明。";
							mes "好吧。我会发出请求。";
							next;
							mes "[Clerk Rhawyne]";
							mes "请乘电梯前往行政办公室。";
							mes "行政办公室旁边的走廊里还有另一部电梯。";
							next;
							mes "[Clerk Rhawyne]";
							mes "那部电梯通往大臣办公室，";
							mes "会有人带你到办公室门前。";
							delitem 6304,3; //Sapa_Feat_Cert
							set ep13_3_secret, 13;
							changequest 7197,7198;
							close;
						}
						mes "[Clerk Rhawyne]";
						mes "你需要3张萨帕功绩证明才能见阿哈特。";
						mes "你知道萨帕功绩证明是什么，对吧？";
						mes "请努力帮助迪卡斯特的人，收集功绩证明吧。";
						close;
					}
					mes "[Clerk Rhawyne]";
					mes "另一位大臣？是谁？";
					next;
					select("抱歉，我不认识其他人。" );
					mes "[Clerk Rhawyne]";
					mes "你真难应付。";
					mes "大臣和其他萨帕人不同，他们非常忙。";
					close;
				}
				mes "[Clerk Rhawyne]";
				mes "你今天想了解什么？";
				close;
			}
			else if (ep13_3_secret == 13) {
				mes "[Clerk Rhawyne]";
				mes "阿哈特和大臣拉维尔在同一层。";
				mes "乘电梯前往行政办公室，然后会有人带你到另一部电梯前。";
				close;
			}
			mes "[Clerk Rhawyne]";
			mes "你今天想了解什么？";
			next;
			switch (select("关于正式委托：关于冒险者酒馆：阿哈特？：萨帕功绩证明？：结束谈话。")) {
				case 1:
					mes "[Clerk Rhawyne]";
					mes "如果迪尔或大臣需要首都的行动支援，";
					mes "就会在公告板上发布通知。";
					next;
					mes "[Clerk Rhawyne]";
					mes "任何能完成工作的人都可以接取委托。";
					mes "正式登记的冒险者也可以接取任务。";
					next;
					mes "[Clerk Rhawyne]";
					mes "完成委托后，";
					mes "你会因帮助迪卡斯特而获得功绩证明。";
					next;
					mes "[Clerk Rhawyne]";
					mes "空闲时最好完成这些正式委托。";
					mes "因为你是在为社区做贡献。";
					next;
					mes "[Clerk Rhawyne]";
					mes "由于来自其他世界的访客增加，";
					mes "有些委托就是为你们准备的。";
					mes "你可以自行选择。";
					close;
				case 2:
					mes "[Clerk Rhawyne]";
					mes "冒险者酒馆是为你这样的访客提供便利而开设的。";
					mes "它位于矿区和工厂区下方的皮奥姆住宅区。";
					next;
					mes "[Clerk Rhawyne]";
					mes "我们认为这里的生活环境对你们来说会很陌生、不方便。";
					mes "所以在冒险者的帮助下，我们尽量建造了类似你们故乡的地方。";
					mes "希望你喜欢。";
					close;
				case 3:
					mes "[Clerk Rhawyne]";
					mes "阿哈特是继拉维尔之后的下一任大臣。";
					mes "为什么？";
					mes "因为我们尊敬她。";
					next;
					mes "[Clerk Rhawyne]";
					mes "该怎么说呢，我们想保护她。";
					mes "但我不确定你们的语言如何表达尊敬。";
					next;
					mes "[Clerk Rhawyne]";
					mes "阿哈特很受欢迎。";
					mes "见过他的人不多，他一直在她的房间里工作。";
					next;
					mes "[Clerk Rhawyne]";
					mes "如果你想见阿哈特……嗯。";
					mes "他工作能力很强，但非常怕生……";
					next;
					mes "[Clerk Rhawyne]";
					mes "他不喜欢人多的地方。";
					mes "所以我们几乎见不到她。";
					close;
				case 4:
					mes "[Clerk Rhawyne]";
					mes "功绩证明？";
					mes "功绩证明是为你们这样的外来者准备的。";
					mes "冒险者帮助城内萨帕人完成委托时，就会获得这种奖励。";
					next;
					mes "[Clerk Rhawyne]";
					mes "功绩证明可以用来会见大臣。";
					mes "我想，要见忙碌的大臣，至少要为我们的社会做出贡献。";
					close;
				case 5:
					mes "[Clerk Rhawyne]";
					mes "需要帮助时请随时提问。";
					close;
			}
		case 3:
			mes "[Clerk Rhawyne]";
			mes "需要帮助时请随时提问。";
			close;
	}
}
// Enchantment NPCs
//============================================================
-	script	dic_enc#main	-1,{
	set .@re$, strnpcinfo(1);
	set .@n$, "["+.@re$+"]";
	if (!checkweight (1201,1)) {
		mes "你携带的物品种类太多。减少物品种类后再试。";
		close;
	}
	if ((MaxWeight - Weight) < 1000) {
		mes "物品重量太大，无法继续。减轻负重后再试。";
		close;
	}
	if (.@re$ == "Kareka") {
		if (ep13_3_ring2 > 99) {
			mes "[Kareka]";
			mes "要再次强化^990099迪卡斯特之光^000000吗？";
			next;

			// The reset feature was disabled in previous versions.
			//mes "[Kareka]";
			//mes "Ha ha ha, that is out of the question. This item is very rare and valuable so I cannot give you a new one.";
			//close;

			mes "[Kareka]";
			mes "重试需要^9900996张萨帕功绩证明^000000。";
			mes "请注意，你现在的迪卡斯特之光及其全部附魔都会被摧毁。";
			next;
			mes "[Kareka]";
			mes "确定要这样做吗？";
			next;
			if(select("不，让我考虑一下。：拿走我的迪卡斯特之光。") == 2) {
				if (countitem(2844) == 0 || countitem(6304) < 6) {
					mes "[Kareka]";
					mes "你必须带来迪卡斯特之光和6张萨帕功绩证明！";
					mes "别想骗我！";
					close;
				}
				mes "[Kareka]";
				mes "好，开始吧。";
				mes "我要移除迪卡斯特之光上的全部附魔。";
				mes "哈啊——！";
				specialeffect2 EF_REPAIRWEAPON;
				progressbar "ffff00",3;
				delitem 6304,6; //Sapa_Feat_Cert
				delitem 2844,1; //El_Dicastes_Light
				getitem 2844,1; //El_Dicastes_Light
				set ep13_3_ring2,0;
			}
			close;
		}
		if (countitem(6304) < 1) {
			mes "[Kareka]";
			mes "你通过帮助城内居民收集的萨帕功绩证明，除了会见大臣外还有其他用途。";
			next;
			mes "[Kareka]";

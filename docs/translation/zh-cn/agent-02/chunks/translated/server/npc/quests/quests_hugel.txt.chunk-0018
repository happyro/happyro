			mes "这不是可以慢慢做的工作。";
			mes "没错，我没有给你期限，";
			mes "但在你取得进展之前，";
			mes "我们的研究也无法推进。";
			close2;
			cutin "hu_laura03.bmp",255;
			end;
		case 2:
			if (countitem(7511) > 4) {
				delitem 7511,5; //Rune_Of_Darkness
				set hg_odin,16;
				changequest 11004,11005;
				getitem 603,1; //Old_Blue_Box
				mes "[Laura]";
				mes "哦，做得好。";
				mes "有更多这种东西可以研究是好事。";
				mes "不过，研究越深入，";
				mes "就越觉得";
				mes "我们没有取得任何进展……";
				next;
				mes "[Laura]";
				mes "嘿……";
				mes "Ashe，我们为什么";
				mes "没有任何进展？";
				mes "你到底在做什么？";
				mes "这些符文上都没有文字吗？";
				next;
				mes "[Ashe]";
				mes "嗯，我认为应该有文字，";
				mes "但这些符文太古老了。";
				mes "我必须在不损坏文字的情况下";
				mes "擦掉上面的污垢……";
				next;
				cutin "hu_laura01.bmp",2;
				mes "[Laura]";
				mes "对了，其他人都在做什么？";
				mes "什么，他们只是在浪费时间吗？";
				mes "啊~我明白了。";
				mes "他们把这当成放松休息的完美借口。";
				mes "毕竟他们也是这个国家的公民，对吧。";
				next;
				cutin "hu_laura02.bmp",2;
				mes "[Laura]";
				mes "你觉得那些施瓦茨瓦尔德";
				mes "自大的家伙在做什么？";
				mes "他们一定把这个项目";
				mes "当成偷懒的借口！";
				mes "显然，他们有钱这么做。哼！有钱人！";
				next;
				cutin "hu_laura03.bmp",2;
				mes "[Laura]";
				mes "他们过得太轻松了，";
				mes "而我们连研究费用";
				mes "都勉强承担！";
				mes "事实上，我们不得不";
				mes "处处节省，";
				mes "连饭菜和生活便利都省了……";
				next;
				mes "[Ashe]";
				mes "我知道！我们怎么能";
				mes "在破棚子里";
				mes "进行专业研究？";
				mes "我们这里简直过着";
				mes "贫困生活……";
				mes "我们还是研究员吗？";
				next;
				cutin "hu_laura02.bmp",2;
				mes "[Laura]";
				mes "我知道！";
				mes "我已经知道了！";
		mes "别、别再提了！";
				next;
				cutin "hu_laura01.bmp",2;
				mes "[Laura]";
		mes "真不像话。";
		mes "我连继续这场对话的精力都没有了。";
		mes "你也是，为什么不休息一下？";
				close2;
				cutin "hu_laura01.bmp",255;
				end;
			} else if (!countitem(7511)) {
				cutin "hu_laura02.bmp",2;
				mes "[Laura]";
				mes "..................";
		mes "这是什么？！";
		mes "你应该带来 5 个的！";
				next;
				cutin "hu_laura03.bmp",2;
				mes "[Laura]";
		mes "这是你不想为我们工作的一种说法吗？";
		mes "为什么不当面说出来？";
				next;
				mes "[Ashe]";
		mes "Laurence 女士，请冷静！";
		mes "我们没有资格对任何人大喊，尤其是志愿者！";
		mes "你更应该知道，他们是在帮我们的忙！";
				next;
				cutin "hu_laura02.bmp",2;
				mes "[Laura]";
		mes "好了，Ashe，我明白了！";
		mes "至于你，我再给你一次机会。";
		mes "下次见到我时，带来";
				mes "5个黑暗符文！";
				close2;
				cutin "hu_laura02.bmp",255;
				end;
			} else if (countitem(7511) == 1) {
				cutin "hu_laura03.bmp",2;
				mes "[Laura]";
				mes "……只有一个？";
		mes "看着我。我让你带五个。";
		mes "我知道一个总比没有好……";
		mes "但差得太远了。马上再去拿四个！";
				close2;
				cutin "hu_laura03.bmp",255;
				end;
			} else if (countitem(7511) == 2) {
				cutin "hu_laura03.bmp",2;
				mes "[Laura]";
		mes "一、二……";
		mes "咦？这、这就是全部？！";
		mes "我让你带 5 个黑暗符文，";
		mes "是 5 个，不是 2 个。快去照我说的做！";
				close2;
				cutin "hu_laura03.bmp",255;
				end;
			} else {
				mes "[Laura]";
		mes "一、二、三……";
		mes "就这些？你不会数到 5 吗？";
		mes "现在去多拿些黑暗符文来！";
				next;
				cutin "hu_laura03.bmp",2;
				close2;
				cutin "hu_laura03.bmp",255;
				end;
			}
		}
	} else if (hg_odin == 16) {
		cutin "hu_laura02.bmp",2;
		mes "[Laura]";
		mes "不知道那些娇生惯养的施瓦茨瓦尔德贵族到底取得了多少进展。";
		mes "他们资金充足，说不定已经领先我们了……";
		next;
		mes "[Laura]";
		mes "我必须知道……";
		mes "我需要知道他们是否已经发现了‘那个东西’。";
		mes "他们不可能比我们先找到，不可能！";
		next;
		cutin "hu_laura01.bmp",2;
		mes "[Laura]";
		mes "……喂，你。";
		next;
		if ( select( "……:……我？" ) == 1)
		{
			mes "[Laura]";
			mes "嘿，嘿！";
			mes "嘿嘿嘿！";
			next;
			mes "["+strcharinfo(0)+"]";
			mes "...Me?";
			next;
		}
		mes "[Laura]";
		mes "总之，我要你监视施瓦茨瓦尔德共和国办事处的那个傲慢女孩 Alex，";
		mes "然后把她实际在做什么报告给我。";
		next;
		cutin "hu_laura04.bmp",2;
		mes "[Laura]";
		mes "总之，把耳朵贴近门，偷听施瓦茨瓦尔德办事处里的人谈话。你愿意做吗？";
		next;
		cutin "hu_laura02.bmp",2;
		mes "[Laura]";
		mes "...............................";
		mes "当然，你会去做的，对吧？";
		next;
		cutin "hu_laura03.bmp",2;
		mes "[Laura]";
		mes "对吧？！";
		next;
		select("好啦好啦，随便吧。:没问题。:我、我、我想可以……！:是，女士！");
		set hg_odin,17;
		for(set .@i,11002; .@i<=11005; set .@i,.@i+1) {
			if (checkquest(.@i) > -1 && checkquest(.@i) < 2)
				completequest .@i;
		}
		setquest 11006;
		cutin "hu_laura04.bmp",2;
		mes "[Laura]";
		mes "很好。";
		mes "现在就去做！";
		close2;
		cutin "hu_laura04.bmp",255;
		end;
	} else if (hg_odin == 17) {
		cutin "hu_laura02.bmp",2;
		mes "[Laura]";
		mes "你还站在这里做什么？去偷听隔壁那些贵族！";
		mes "我必须知道他们到底在做什么！";
		close2;
		cutin "hu_laura02.bmp",255;
		end;
	} else if (hg_odin == 18 || hg_odin == 19) {
		cutin "hu_laura01.bmp",2;
		mes "[Laura]";
		mes "坦白说，我知道让你当间谍却不给报酬，";
		mes "但请告诉我你了解到的施瓦茨瓦尔德共和国研究团队的情况。";
		next;
		switch(select("巨人族:伊米尔之心:什么也没有")) {
			case 1:
				cutin "hu_laura04.bmp",2;
				mes "["+strcharinfo(0)+"]";
				mes "我猜你作为考古学家，已经熟悉名为巨人族的生物了。";
				next;
				cutin "hu_laura02.bmp",2;
				mes "[Laura]";
				mes "当然！那是启发守护者的古代野兽。";
				mes "不、不可能……！他们是来完成守护者研究的吗？";
				mes "你还了解到什么？";
				next;
				
			case 2:
				mes "["+strcharinfo(0)+"]";
				mes "嗯，你听说过伊米尔的……";
				next;
				emotion ET_SURPRISE, getnpcid(0, "Ashe");
				mes "[Ashe]";
				mes "……心脏？";
				mes "伊米尔之心，对吧？";
				next;
				mes "[Laura]";
				mes "Ashe，你知道这个？伊米尔之心究竟是什么？";
				next;
				switch(select("是糖果。:是书。:是个地方。:伊米尔是巨人……"))
				{
					case 1:
						mes "["+strcharinfo(0)+"]";
						mes "就是这个……";
						mes "呃，真的……";
						next;
						break;
						
					case 2:
						mes "["+strcharinfo(0)+"]";
						mes "呃，你看……";
						mes "很多人都知道伊米尔之心……";
						next;
						break;
						
					case 3:
						mes "["+strcharinfo(0)+"]";
						mes "你知道那句俗语，";
		mes "‘家就是心之所在’，";
						mes "‘家就是心之所在’吧？呃，总之，伊米尔之心……";
						next;
						break;
						
					case 4:
						mes "["+strcharinfo(0)+"]";
						mes "事实是，伊米尔是个巨人……";
						next;
						break;
				}
				emotion ET_OK, getnpcid(0, "Ashe");
				mes "[Ashe]";
				mes "伊米尔之心？那是服装品牌，对吧？";
				mes "对，在施瓦茨瓦尔德共和国的时尚人群中很受欢迎。";
				next;
				cutin "hu_laura01.bmp",2;
				mes "[Laura]";
				mes "服装品牌？";
				mes "你是说那些贵族只是在里面谈论时尚？";
				mes "哼，他们没有更重要的事可做吗？";
				next;
				cutin "hu_laura04.bmp",2;
				mes "[Laura]";
				mes "在此期间，你能再帮我一个忙吗？";
				mes "我想让你最后一次前往神殿。";
				mes "听说那里建在两座相连的岛上……";
				next;
				mes "[Laura]";
				mes "我想让你调查内岛，看看能找到什么；";
				mes "我会调查施瓦茨瓦尔德研究团队。抱歉，我只能拜托你。";
				set hg_odin,20;
				changequest 11006,11007;
				close2;
				cutin "hu_laura04.bmp",255;
				end;

			case 3:
				mes "[Laura]";
				mes "什么也没有……？";
				mes "你确定你了解到的只有这些？";
				close2;
				cutin "hu_laura01.bmp",255;
				end;
		}
	} else if (hg_odin == 20) {
		cutin "hu_laura01.bmp",2;
		mes "[Laura]";
		mes "真让人疑惑……";
		mes "到底发生了什么？";
		mes "希望我能找到答案……";
		close2;
		cutin "hu_laura01.bmp",255;
		end;
	}
}

hu_in01,18,167,4	script	Julian	86,{
	if (!hg_odin) {
		mes "[Julian]";
		mes "^333333*Sigh...*^000000";
		close;
	} else if (hg_odin == 1) {
		mes "[Julian]";
		mes "喂，你是来这里";
		mes "你是来应聘的吗？我们在寻找热爱古代历史的人。";
		mes "如果你想赚钱，那这里可不适合你~";
		next;
		mes "[Julian]";
		mes "这本应是一次合作发掘，";
		mes "但队长们太固执，拒绝任何妥协。";
		mes "真让人沮丧……";
		next;
		mes "[Julian]";
		mes "目前各队都在进行自己的研究。";
		mes "现在我们需要你帮忙寻找奥丁神殿的遗物，能带多少就带多少！";
		close;
	} else if (hg_odin == 2) {
		mes "[Julian]";
		mes "你确定要为像我老板那样的人工作吗？";
		mes "看不出她很邪恶吗？趁还能逃，赶快离开这里！";
		next;
		mes "[Alex]";
		mes "Julian……！";
		next;
		mes "[Julian]";
		mes "看到了吧？";
		close;
	} else if (hg_odin == 3) {
		mes "[Julian]";
		mes "哇，你一定很喜欢这种工作吧？";
		mes "我真没想到你会去神殿……";
		close;
	} else if (hg_odin == 4) {
		mes "[Julian]";
		mes "看到你这么努力，我很惊讶。";
		mes "你一定喜欢讨好别人吧，但别太善良，我可不希望那样……";
		close;
	} else if (hg_odin == 5) {
		mes "[Julian]";
		mes "天啊……你真是个好人，知道吗？";
		mes "只是别被人当傻瓜，好吗？";
		close;
	} else {
		mes "[Julian]";
		mes "我们的两位队长为什么都这么顽固？";
		mes "也许是因为她们年纪大又单身。别告诉她们这是我说的！";
		close;
	}
}


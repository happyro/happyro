6@tower,169,127,2	script	Lost Soul#102	796,{
	if (checkweight(1201,1) == 0) {
		mes "你携带的东西太多了。先存放一些再回来吧？";
		close;
	}
	mes "[Lost Souls]";
	mes "是你把我们从邪恶的 Naght Sieger 手中解放出来。";
	next;
	mes "[Lost Souls]";
	mes "太感谢你了。现在我们可以逃离这个冰冷黑暗的地方……前往天堂。";
	next;
	if ((countitem(13412) > 0) && (countitem(13413) > 0)) {
		mes "[Lost Souls]";
	mes "嘿，你身上有 Naght Sieger 的残骸。";
		next;
		mes "[Lost Souls]";
	mes "它们看起来是单手剑，但如果你愿意，我可以把它们合成一把双手剑。这是我报答你解放我的唯一方式。";
		next;
		switch(select("制作双手剑。:不用了，谢谢。")) {
		case 1:
			mes "[Lost Souls]";
			mes "如果它已经升级或插有卡片，这些效果都会消失。你能接受吗？";
			next;
			switch(select("没问题，请制作。:绝对不行！")) {
			case 1:
				mes "[Lost Souls]";
				mes "好，我会把它们合成为双手剑。";
				next;
				delitem 13412,1; //Twin_Edge_B
				delitem 13413,1; //Twin_Edge_R
				getitem 1185,1; //Violet_Fear
				break;
			case 2:
				mes "[Lost Souls]";
				mes "我明白了。看来你不像其他冒险者那样贪婪或野心勃勃。";
				next;
				break;
			}
			break;
		case 2:
			mes "[Lost Souls]";
			mes "我明白了。看来你不像其他冒险者那样贪婪或野心勃勃。";
			next;
			break;
		}
	}
	mes "[Lost Souls]";
	mes "我还想和你多聊聊，但我……我现在必须走了。";
	next;
	mes "[Lost Souls]";
	mes "再见，年轻的冒险者。祝你好运。";
	close2;
	warp "alberta",223,36;
	end;

OnInstanceInit:
	disablenpc instance_npcname("Lost Soul#102");
	end;

OnEnable:
	initnpctimer;
	enablenpc instance_npcname("Lost Soul#102");
	donpcevent instance_npcname("#Effect30")+"::OnEnable";
	//SetItemPartyInMap in_102floor 104
	end;

OnTimer500:
	mapannounce instance_mapname("6@tower"),"这……这不可能！我不可能被打败！",bc_map,"0xffff00";
	end;

OnTimer5500:
	mapannounce instance_mapname("6@tower"),"不——！我的灵魂……我的躯壳……！不——！",bc_map,"0xffff00";
	end;

OnTimer10500:
	mapannounce instance_mapname("6@tower"),"Naght Sieger 的身体化作黑色灰烬，随风飘散。",bc_map,"0x00ffcc";
	stopnpctimer;
	end;
}


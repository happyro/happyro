	mes "已升级为摇滚蝗虫！";
	close;

U_Puppy:
	set #monster,90;
	set #monpoints,#monpoints-1280;
	mes "[Monster Trainer]";
	mes "已升级为沙漠之狼幼崽！";
	close;

L_Up9:
	mes "你想升级成哪种怪物？";
	next;
	menu "Skeleton",U_Skeleton,"Antonio",U_Antonio,"Plankton",U_Plankton,"Thief Bug Female",U_ThiefFemale;

U_Plankton:
	set #monster,101;
	set #monpoints,#monpoints-2560;
	mes "[Monster Trainer]";
	mes "已升级为海葵！";
	close;

U_Antonio:
	set #monster,102;
	set #monpoints,#monpoints-2560;
	mes "[Monster Trainer]";
	mes "已升级为安东尼奥！";
	close;

U_ThiefFemale:
	set #monster,103;
	set #monpoints,#monpoints-2560;
	mes "[Monster Trainer]";
	mes "已升级为雌盗虫！";
	close;

U_Skeleton:
	set #monster,100;
	set #monpoints,#monpoints-2560;
	mes "[Monster Trainer]";
	mes "已升级为骷髅！";
	close;

L_NoZeny:
	mes "[Monster Trainer]";
	mes "你的 Zeny 不够！";
	close;

L_Exit:
	mes "[Monster Trainer]";
	mes "再见。";
	close;

L_Heal:
	mes "[Monster Trainer]";
	mes "你的怪物需要治疗。";
	mes "更快点击护士可以加快治疗速度。";
	set #heal,1;
	close;
}


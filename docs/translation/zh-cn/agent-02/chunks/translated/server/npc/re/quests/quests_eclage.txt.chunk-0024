
ecl_tdun03,68,80,3	script	New Oz#1	4_M_NEWOZ,1,1,{
	mes "[New Oz]";
	if (ep14_2_nines > 5) {
		.@playtime_13062 = checkquest(13062,PLAYTIME);
		.@playtime_13064 = checkquest(13064,PLAYTIME);
		.@playtime_13066 = checkquest(13066,PLAYTIME);
		if (.@playtime_13062 == 0 && .@playtime_13064 == 0 && .@playtime_13066 == 0) {
			cutin "nines02",2;
		mes "不用担心我！^FF0000这次我一定会回家！^000000谢谢你的一切帮助！下次我请你吃顿大餐！";
			emotion ET_THANKS;
			if (isbegin_quest(13058))
				erasequest 13058;
		}
		else if (.@playtime_13062 == 2 || .@playtime_13064 == 2 || .@playtime_13066 == 2) {
			cutin "nines01",2;
		mes "啊……真是松了口气……你在这里太好了。我本来想独自离开这座塔！但我好像迷路了。";
			emotion ET_SURPRISE;
			if (.@playtime_13062 == 2) {
				next;
				cutin "nines04",2;
				mes "[New Oz]";
				mes "走了这么久我又饿了……饿得都走不动了。";
				erasequest 13062;
			}
			if (.@playtime_13064 == 2) {
				next;
				cutin "nines03",2;
				mes "[New Oz]";
				mes "我是不是走太多了？身上又沾满灰尘。灰尘一直往眼睛里钻。";
				erasequest 13064;
			}
			if (.@playtime_13066 == 2) {
				next;
				cutin "nines02",2;
				mes "[New Oz]";
				mes "呼，我好像走得太辛苦了……不知怎么把他们为我收集的纪念品全弄丢了……";
				erasequest 13066;
			}
		}
		else {
			cutin "nines01",2;
		mes "很高兴再次见到你，我的朋友！";
			next;
			switch( select("我来看看你还活着吗。：给他食物：擦掉灰尘：给朋友的礼物") ) {
				mes "[New Oz]";
			case 1:
				mes "这是那个肌肉发达的拉斐内人给的，对吧？他是个好人。告诉他不用担心我。";
				next;
				mes "[New Oz]";
				if (.@playtime_13062 >= 0) {
					if (.@playtime_13064 >= 0)
						mes "我想现在应该能顺利走出这座塔了。我吃饱了……只需要再找几件纪念品……";
					else
						mes "只要清除挡路的东西就没事了，哈哈……我们快出去了，对吧？";
				}
				else {
					cutin "nines04",2;
					mes "不过我快饿死了……朋友，你能帮帮我吗？";
					emotion ET_KEK;
				}
				if (isbegin_quest(13058))
					erasequest 13058;
				break;
			case 2:
				if (.@playtime_13062 == 0) {
					cutin "nines02",2;
					mes "我很喜欢你带来的肉。只是调味不太好，口感也有点松散……但……还是能吃的，哈哈……";
				}
				else if (isbegin_quest(13061) == 1) {
					if (countitem(517) > 9 && countitem(6558) > 9) {
						cutin "nines02",2;
						mes "啊，我多久没见过食物了！真香！谢天谢地是肉！我觉得有点硬……也不够热……但它毕竟是肉！！";
						emotion ET_THANKS;
						next;
						mes "[New Oz]";
						mes "太谢谢你了！！真好吃。你真是个好朋友！嚼嚼。";
						emotion ET_BEST;
						next;
						mes "[New Oz]";
						mes "我现在该赶紧找出口了！我感觉这次一定能出去！";
						delitem 517,10;// Meat
						delitem 6558,10;// Pile_Of_Acorn
						changequest 13061,13062;
						getexp 300000,300000;
						getitem 6081,1;// Splendide_Coin
					}
					else {
						cutin "nines04",2;
						mes "食物……我需要食物……感觉天都要塌了……";
						next;
						mes "[New Oz]";
						mes "咳！咳！肉……咳！肉……肉……";
						next;
						mes "看着他的眼睛，听着他不停咳嗽，我能判断他需要吃点东西，比如肉。";
					}
				}
				else if (isbegin_quest(13061) == 2) {
					cutin "nines04",2;
					mes "如你所见……我又没能找到这座塔的出口。而且我太饿了，感觉快要昏倒……";
					erasequest 13061;
				}
				else {
					cutin "nines02",2;
					mes "啊……能遇到你这样的好朋友，我真高兴。";
					next;
					mes "[New Oz]";
					mes "我以为离开这座塔近在咫尺，但环顾四周后，我又回到了原地。";
					next;
					mes "[New Oz]";
					mes "也许这座塔被诅咒了。";
					next;
					select("也许只是你方向感太差？" );
					cutin "nines04",2;
					mes "[New Oz]";
					mes "……我也不能完全否认。不过，你能给我弄点吃的吗？我快饿死了……";
					next;
					switch( select("好！我马上回来！：你自己做！") ) {
						mes "[New Oz]";
					case 1:
						mes "谢谢。如果可以的话我想要肉……我很喜欢你上次给的东西，而且我觉得橡果和肉很搭。哈哈哈。";
						next;
						select("我拿什么你就吃什么吧！" );
						mes "[New Oz]";
						mes "只要有东西吃就行，我只是希望味道好一点。抱歉，请帮帮我。我忘不了那肉的味道。";
						emotion ET_SEXY;
						if (.@playtime_13062 == 2)
							erasequest 13062;
						setquest 13061;
						break;
					case 2:
						mes "好吧……我明白了。那我再想别的办法。如果你出去时遇到那个肌肉发达的拉斐内人，告诉他我可能再也见不到他了……";
						emotion ET_KEK;
					}
				}
				break;
			case 3:
				if (.@playtime_13064 == 0) {
					cutin "nines02",2;
					mes "啊哈哈，不用担心我！我自己能做！";
				}
				else if (checkquest(13063,HUNTING) == 2) {
					cutin "nines02",2;
					mes "嘿，你真是个好冒险者！我开始越来越喜欢你了。";
					emotion ET_SPARK;
					next;
					mes "[New Oz]";
					mes "剩下的我来处理。我不能一直麻烦你，对吧？哈哈哈。";
					changequest 13063,13064;
					getexp 300000,300000;
					getitem 6081,1;// Splendide_Coin
				}
				else if (checkquest(13063,HUNTING) == 1) {
					mes "这些家伙不太显眼，却很烦人。啊……我请你清理它们，不是因为我懒什么的。哈哈哈……";
					emotion ET_STARE_ABOUT;
				}
				else {
					cutin "nines03",2;
					mes "呀！你不在时我本来想自己出去。但后来发现了有趣的东西……所以稍微逛了一会儿……";
					next;
					mes "[New Oz]";
					mes "结果这些家伙又堆起来了！";
					next;
					cutin "nines04",2;
					mes "[New Oz]";
					mes "当然可以自己做~但一个人做会消耗太多体力，然后我又会饿……";
					emotion ET_THINK;
					next;
					switch( select("所以你想让我帮你擦掉灰尘？：那你自己做！") ) {
						mes "[New Oz]";
					case 1:
						cutin "nines02",2;
						mes "你怎么知道？我觉得我们很合得来！以后有机会我会让你加入我的公会。";
						emotion ET_OK;
						next;
						mes "[New Oz]";
						mes "那就击退一些切瑞妮吧。不用消灭太多，因为我也马上会开始战斗！哈哈。";
						if (.@playtime_13064)
							erasequest 13064;
						setquest 13063;
						break;
					case 2:
					mes "我明白了。下次你来时如果发现我死了，别太内疚。那不是你的错。";
						break;
					}
				}
				break;
			case 4:
				if (.@playtime_13066 == 0) {
					cutin "nines03",2;
					mes "我想纪念品够多了！看到这些充满回忆的纪念品，他们一定会很惊讶！";
				}
				else if (isbegin_quest(13065) == 1) {
					if (countitem(6560) > 19) {
						cutin "nines02",2;
						mes "谢谢！你太棒了！真是令人羡慕又有才华的人！";
						next;
						mes "[New Oz]";
						mes "希望在米德加尔特再见到你！我们应该组队开始伟大的冒险！";
						next;
						mes "[New Oz]";
						mes "我会把你为我收集的所有纪念品交给朋友，也会向他们介绍你！";
						emotion ET_THANKS;
						delitem 6560,20;// Leaf_Bookmark
						changequest 13065,13066;
						getexp 300000,300000;
						getitem 6081,1;// Splendide_Coin
					}
					else {
						cutin "nines01",2;
					mes "我不需要那么多。每人一件就够了吧？";
					}
				}
				else if (isbegin_quest(13065) == 2) {
					cutin "nines01",2;
					mes "哦，说起来，你帮我收集的书签丢了……就是那些落叶做的书签……我得重新收集……";
					next;
					mes "[New Oz]";
					mes "你愿意帮我吗？朋友就是用来互相帮助的！哈哈哈！谢谢！！";
					emotion ET_OTL;
					erasequest 13065;
				}
				else {
					cutin "nines03",2;
					mes "回过神来，我发现你带来的东西全没了！我明明以为放在这里！";
					next;
					mes "[New Oz]";
					mes "真的非常抱歉，但你能再帮我一次吗？一想到要见朋友我就忍不住哭。拜托~？";
					next;
					switch( select("真可怜！我帮他。：我受不了了！") ) {
						mes "[New Oz]";
					case 1:
						mes "落叶做的书签……啊，它们带回了好多回忆，让我热泪盈眶。我相信朋友们一定会喜欢！";
						if (.@playtime_13066)
							erasequest 13066;
						setquest 13065;
						break;
					case 2:
						cutin "nines04",2;
					mes "我明白了……是我的错。我可能会在这里收集纪念品直到生命结束……但与你无关……";
						break;
					}
				}
			}
		}
	}
	else if (ep14_2_nines == 5) {
		if (isbegin_quest(13065) == 1) {
			if (countitem(6560) > 19) {
				cutin "nines02",2;
				mes "你收集完书签了！？果然充满回忆。大家一定会喜欢！";
				next;
				mes "[New Oz]";
				mes "我刚写完一首歌。你想听吗？";
				next;
				mes "[New Oz]";
				mes "^D96E26又走上那条路了~我在那里徘徊了一会儿~^000000";
				next;
				mes "[New Oz]";
				mes "^D96E26Familiar dungeon~full of monsters~and hunger in a maze~^000000";
				next;
				mes "[New Oz]";
				mes "^D96E26我试图逃跑时~幸好那里没有魔物~^000000";
				next;
				mes "[New Oz]";
				mes "^D96E26但我没能走那么远~我饿得头晕。^000000";
				next;
				mes "[New Oz]";
				mes "目前还不错，对吧？如果你觉得像另一首歌，那只是你的错觉！";
				next;
				switch( select("我觉得很棒。：我觉得以前听过。") ) {
					mes "[New Oz]";
				case 1:
					mes "谢谢！有机会的话，我也会写一首关于你如何帮助我的歌！";
					break;
				case 2:
					cutin "nines04",2;
					mes "啊哈哈……真的吗？也许你是对的……算了，我再写一首，别担心……";
					break;
				}
				next;
				cutin "nines01",2;
				mes "[New Oz]";
				mes "我真的该走了。我已经去过塔里的大部分地方，也吃得很饱。";
				next;
				cutin "nines02",2;
				mes "[New Oz]";
				mes "再次感谢你，我的朋友！希望以后还能在哪里见到你。我能自己找到出口。";
				delitem 6560,20;// Leaf_Bookmark
				ep14_2_nines = 6;
				setquest 13062;
				setquest 13064;
				changequest 13065,13066;
				getexp 300000,300000;
				getitem 6081,1;// Splendide_Coin
			}
			else {
				cutin "nines03",2;
				mes "别担心。我差不多写完歌了，歌词和旋律也快完成了。";
				next;
				mes "[New Oz]";
			mes "^FF0000等你收集完纪念品时，^000000我可能也完成了。再次感谢你，我的朋友。";
			}
		}
		else {
			cutin "nines02",2;
			mes "我想过了……他们一定会喜欢^FF0000落叶做的书签！^000000里面充满过去的回忆！我确定！";
			next;
			mes "[New Oz]";
			mes "如果你看看散落在塔里的书，里面都有书签。虽然带着别人的回忆，但我觉得会是送给朋友的好礼物。";
			emotion ET_SPARK;
			next;
			mes "[New Oz]";
			mes "^FF0000一段美妙的旋律^000000刚刚浮现在我脑海中，我想现在就开始写歌。你可以趁此期间替我收集纪念品。";
			setquest 13065;
		}
	}
	else if (ep14_2_nines == 4) {
		switch( checkquest(13063,HUNTING) ) {
		case 2:
			cutin "nines02",2;
			mes "做得好！现在让我们享受剩下的……不！我是说，找出口吧！";
			next;
			mes "[New Oz]";
			mes "……不过我觉得少了些什么。既然可能再也不会来这里，我应该带些纪念品，对吧？";
			next;
			mes "[New Oz]";
			mes "其实……如果空手回去，我的朋友可能会生气。";
			next;
			mes "[New Oz]";
			mes "我该带些纪念品让他们开心。有能用的东西吗？";
			emotion ET_QUESTION;
			next;
			switch( select("果冻肉：幸运蛋：当地怪物掉落物") ) {
			case 1:
				mes "[New Oz]";
				mes "果冻肉很适合收藏……但我觉得太普通了。还有别的吗？";
				next;
				if (select("巴风特卡片：当地怪物掉落物") == 1) {
					cutin "nines04",2;
					mes "[New Oz]";
					mes "嘿……但这不是在这里能得到的东西。";
					emotion ET_PROFUSELY_SWEAT;
					next;
					select("当地怪物掉落物" );
				}
				break;
			case 2:
				mes "[New Oz]";
				mes "嗯？那是做什么的？我旅行时似乎出现了新物品。";
				emotion ET_QUESTION;
				next;
				mes "[New Oz]";
				mes "不知道是什么就无法取得。还有别的吗？";
				next;
				if (select("旧卡片册：当地怪物掉落物") == 1) {
					mes "[New Oz]";
					mes "卡片册……我不能送朋友可能什么都没有的东西！还有别的吗？";
					next;
					select("当地怪物掉落物" );
				}
				break;
			}
			cutin "nines01",2;
			mes "[New Oz]";
			mes "当地怪物掉落物……嗯，听起来很有趣！";
			emotion ET_SURPRISE;
			next;
			mes "[New Oz]";
			mes "我确定它们还没到这里。所以对他们来说也是新东西！对吧？";
			next;
			mes "[New Oz]";
			mes "而且它能告诉他们我目前去过哪些地方。";
			next;
			mes "[New Oz]";
			mes "这是个好主意。那我们想想收集什么吧。";
			erasequest 13063;
			ep14_2_nines = 5;
			getexp 300000,300000;
			getitem 6081,1;// Splendide_Coin
			break;
		case 1:
			cutin "nines03",2;
			mes "你完成了吗？我也还在写歌词……但你得快点。该离开这里了。";
			break;
		default:
			cutin "nines01",2;
			mes "我当然是因为方向感差才迷路……但还有另一个原因！";
			next;
			cutin "nines04",2;
			mes "[New Oz]";
			mes "看到那边的家伙了吗？我觉得他们不知为什么阻止我找出口。";
			next;
			select("我什么也没看到。" );
			mes "[New Oz]";
			mes "不，你要仔细看。那边的尘土块遮住了我的眼睛，看不清时我就会犯困、肚子饿……";
			emotion ET_KEK;
			next;
			select("我觉得那只是你的想象！" );
			cutin "nines03",2;
			mes "[New Oz]";
			mes "不，不。我确定他们在阻止我。请把他们清除掉。也许只要几个？我刚想到一些歌词……得先记下来……";
			setquest 13063;
		}
	}
	else if (ep14_2_nines == 3) {
		if (isbegin_quest(13061) == 1) {
			if (countitem(517) > 9 && countitem(6558) > 9) {
				cutin "nines02",2;
				mes "耶，是肉！我最爱肉了！";
				next;
				mes "[New Oz]";
				mes "好吃。嚼嚼。好吃！";
				next;
				mes "[New Oz]";
				mes "嚼嚼。好吃好吃。嚼嚼。";
				next;
				mes "[New Oz]";
				mes "天啊，真好吃！就是这个！好吃。";
				next;
				mes "[New Oz]";
				mes "如果找到出口，我该为那个肌肉发达的拉斐内人写首歌。好吃。";
				next;
				mes "[New Oz]";
				mes "不过我不确定什么时候能做到……嚼嚼。";
				next;
				select("有什么问题吗？" );
				mes "[New Oz]";
				mes "哦，没什么。别担心。我是不小心进了这座塔，然后迷路了。好吃。";
				next;
				mes "[New Oz]";
				mes "说实话，我大约两年前在某处迷路，就一路四处旅行。好吃。";
				next;
				mes "[New Oz]";
				mes "后来发现了这座塔，觉得有趣就进来了。但从那以后一直没找到出口。";
				next;
				mes "[New Oz]";
				mes "我现在舒服多了。谢谢你，我的朋友！这一定是命运！你愿意帮我吗？";
				delitem 517,10;// Meat
				delitem 6558,10;// Pile_Of_Acorn
				erasequest 13061;
				ep14_2_nines = 4;
				getexp 300000,300000;
				getitem 6081,1;// Splendide_Coin
			}
			else {
				cutin "nines04",2;
				mes "啊……这就是死亡的恐惧吗……过去的记忆像闪光一样掠过脑海……比如我们在普隆德拉南门度过的快乐时光……";
			}
		}
		else {
			cutin "nines04",2;
			mes "我想我就到此为止了……我曾经拥有美好的人生……";
			next;
			mes "[New Oz]";
			mes "我居然要饿死了，真有点悲哀……但我和亲爱的公会成员们度过了美好时光……";
			next;
			select("我从菲利那里带来了肉！" );
			mes "[New Oz]";
			mes "哦，我最爱肉了！但是……有蔬菜吗？";
			next;
			mes "[New Oz]";
			mes "比如肉的配菜。你知道，我可能会厌倦只吃肉……你能帮我弄些吗？";
			next;
			mes "[New Oz]";
			mes "比如橡果！我在塔外看到了一堆橡果。";
			setquest 13061;
		}
	}
	else if (ep14_2_nines == 2) {
		if (isbegin_quest(13055) == 1 && isbegin_quest(13058) == 1) {
			cutin "nines04",2;
			mes "你是……人类吗？咳咳。";
			next;
			select("我来看看你还好吗。" );
			mes "[New Oz]";
			mes "我不知道该说自己好……还是不好……";
			next;
			mes "[New Oz]";
			mes "我已经好几天没吃东西了……感觉随时会昏倒。";
			next;
			mes "[New Oz]";
			mes "但现在我^FF0000还^000000活着……不过谁知道能活多久……啊，我又困了……";
			next;

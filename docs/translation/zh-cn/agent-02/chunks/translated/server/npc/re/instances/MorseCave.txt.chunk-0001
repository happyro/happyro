moro_cav,61,69,3	script	Senior Tracker#a1	4_M_JOB_ASSASSIN,{
	if (ep14_3_isle == 0) {
		mes "[Senior Tracker]";
		mes "这是我们阻止Morocc的前进基地。";
		mes "我是负责带领部队前往Morocc巢穴的追踪者。";
		close;
	}
	if (checkweight(2104,2) == 0) {
		mes "你的背包太满了。";
		mes "我没法和你说话！";
		close;
	}
	if (BaseLevel < 160) {
		mes "你必须先达到160级，";
		mes "才能进入红色花朵！";
		close;
	}
	switch( checkquest(9319,PLAYTIME) ) {
	case -1:
		break;
	case 0:
	case 1:
		mes "[Senior Tracker]";
		mes "我们离阻止Morocc复活还差得很远。";
		mes "想到Morocc正在竭尽全力恢复力量，";
		mes "我晚上根本睡不着。";
		mes "你明天再回来好吗？";
		close;
	case 2:
		mes "[Senior Tracker]";
		mes "我就知道你会回来。";
		mes "看起来你休息得很好。";
		next;
		mes "[Senior Tracker]";
		mes "根据我的情报，";
		mes "Morocc正藏在这里，";
		mes "恢复他的力量。";
		next;
		mes "[Senior Tracker]";
		mes "对抗Morocc";
		mes "不是几个战士，无论他们多强，都能完成的。";
		mes "我建议你和尽可能多的同伴";
		mes "联手。";
		mes "准备好进入据说Morocc藏身的";
		mes "红色花朵了吗？";
		if (getcharid(1) < 1 || is_party_leader() == false)
			close;
		next;
		if (select( "No.", "Yes." ) == 1) {
			mes "[Senior Tracker]";
			mes "改变主意后";
			mes "再回来吧。";
			close;
		}
		if (instance_create("Morse's Cave") < 1) {
			mes "[Senior Tracker]";
			mes "红色花朵的入口";
			mes "还没有开放。";
			mes "请稍后回来";
			mes "再试一次。";
			close;
		}
		mes "[Senior Tracker]";
		mes "红色花朵的入口";
		mes "已经开放。";
		mes "它只会开放一段时间。";
		mes "你最好趁现在";
		mes "赶紧进去。";
		close;
	}
	.@hunting_9318 = checkquest(9318,HUNTING);
	if (.@hunting_9318 == -1) {
		mes "[Senior Tracker]";
		mes "这是我们阻止Morocc的前进基地。";
		mes "我是负责带领部队前往Morocc巢穴的追踪者。";
		next;
		mes "[Senior Tracker]";
		mes "经过艰苦的搜索，";
		mes "我找到了";
		mes "最有可能";
		mes "藏着Morocc的地方。";
		next;
		mes "[Senior Tracker]";
		mes "根据我的情报，";
		mes "Morocc正藏在这里，";
		mes "试图恢复";
		mes "全部力量。";
		next;
		mes "[Senior Tracker]";
		mes "虽然这是我亲自找到的地方，";
		mes "但我必须承认，";
		mes "我没有能力独自";
		mes "探索这里。";
		mes "毕竟我是追踪者，不是战士。";
		next;
		mes "[Senior Tracker]";
		mes "你看起来像是";
		mes "渴望和Morocc";
		mes "好好战斗的战士，";
		mes "我认为";
		mes "你有机会获胜。";
		next;
		mes "[Senior Tracker]";
		mes "你愿意进入Morocc的巢穴，";
		mes "击败他，";
		mes "成为从邪恶手中";
		mes "拯救世界的英雄吗？";
		next;
		if (getcharid(1) < 1 || is_party_leader() == false) {
			mes "[Senior Tracker]";
			mes "如果你对我的提议感兴趣，";
			mes "让我和你的队长谈谈。";
			mes "我们一起讨论更多细节。";
			close;
		}
		mes "[Senior Tracker]";
		mes "Morocc也许还没有恢复全部力量，但对抗他仍然";
		mes "不是几个战士，无论他们多强，都能完成的。";
		mes "我建议你和尽可能多的同伴";
		mes "联手。";
		mes "准备好进入据说Morocc藏身的";
		mes "红色花朵了吗？";
		next;
		if (select( "No.", "Yes." ) == 1) {
			mes "[Senior Tracker]";
			mes "改变主意后";
			mes "再回来吧。";
			close;
		}
		if (instance_create("Morse's Cave") < 1) {
			mes "[Senior Tracker]";
			mes "红色花朵的入口";
			mes "还没有开放。";
			mes "请稍后回来";
			mes "再试一次。";
			close;
		}
		mes "[Senior Tracker]";
		mes "红色花朵的入口";
		mes "已经开放。";
		mes "它只会开放一段时间。";
		mes "你最好趁现在";
		mes "赶紧进去。";
		close;
	}
	else {
		mes "[Senior Tracker]";
		mes "你终于回来了！";
		mes "里面发生了什么？";
		next;
		mes "- 你讲述";
		mes "你讲述在红色花朵中的经历。";
		next;
		mes "[Senior Tracker]";
		mes "所以Morocc逃走了。";
		mes "真遗憾。";
		next;
		if (checkquest(9318,HUNTING) == 2) {
			mes "[Senior Tracker]";
		mes "至少";
		mes "你消灭了";
		mes "他的军队。";
		mes "这本身就是一项成就。";
			next;
		}
		mes "[Senior Tracker]";
		mes "至少我们知道";
		mes "他在哪里。";
		mes "你明天能回来";
		mes "帮我再次追踪";
		mes "他吗？";
		mes "我会在这里等你。";
		if (checkquest(9318,HUNTING) == 2)
			getitem 6684,1;	// TokenOfHero
		erasequest 9318;// Pursuing Hiding Morocc
		setquest 9319;// Pursuing Hiding Morocc Continues
		ep14_3_mors01 = 1;
		close;
	}
}

moro_cav,57,69,3	script	Red Flower#a1	CLEAR_NPC,{
	if (ep14_3_isle == 0) {
		mes "[Senior Tracker]";
		mes "这是我们阻止Morocc的前进基地。";
		mes "我是负责带领部队前往Morocc巢穴的追踪者。";
		close;
	}
	if (BaseLevel < 160) {
		mes "你必须先达到160级，";
		mes "才能进入红色花朵！";
		close;
	}
	if (isbegin_quest(9318) > 0) {
		mes "- 红色花朵已关闭。";
		mes "你还不能进入。 -";
		close;
	}
	switch( checkquest(9319,PLAYTIME) ) {
	case -1:
		break;
	case 0:
	case 1:
		mes "- 红色花朵已关闭。";
		mes "你还不能进入。 -";
		close;
	case 2:
		break;
	}
	if (select( "Do not enter the Red Flower.", "Enter the Red Flower." ) == 1) {
		mes "- 你能感受到某种不祥的能量。 -";
		close;
	}
	switch( instance_enter("Morse's Cave") ) {
	case IE_OTHER:
		mes "发生了未知错误。";
		close;
	case IE_NOINSTANCE:
		mes "纪念地下城Morse的洞穴不存在。";
		mes "你的队长还没有创建纪念地下城。";
		close;
	case IE_NOMEMBER:
		mes "只有队伍成员可以进入这个纪念地下城。";
		close;
	case IE_OK:
		mapannounce "moro_cav", getpartyname( getcharid(1) ) + "队伍的" + strcharinfo(0) + "正在进入Morse的洞穴。", bc_map,0xFF99;
		if (isbegin_quest(9319) > 0)
			erasequest 9319;// Pursuing Hiding Morocc Continues
		if (isbegin_quest(9318) > 0)
			erasequest 9318;
		setquest 9318;// Pursuing Hiding Morocc
		// warp "1@rev",26,181;
		end;
	}
	end;

OnInit:
	initnpctimer;
	end;
OnTimer3000:
	specialeffect EF_BOTTOM_VO;
	end;
OnTimer15000:
	initnpctimer;
	end;
}

1@rev,33,117,0	script	#Pause Effect RZ1	HIDDEN_WARP_NPC,1,1,{
	end;
OnTouch:
	if (getnpctimer(0) > 0)
		end;

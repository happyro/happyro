prontera,137,125,4	script	Cash Sales Guide#prontera::cashmall_warper	4_M_HUMAN_02,{
	mes "[Guide]";
	mes "你好~";
	mes "这位向导要带你去一个特别的地方。";
	mes "那是什么地方？";
	next;
	mes "[Guide]";
	mes "那里充满了可以收集和出售的神秘物品。";
	mes "要购买东西，需要特殊货币。";
	next;
	mes "[Guide]";
	mes "那么，你准备好去那里了吗？";
	next;
	if (select( "是", "否" ) == 2) {
		mes "[Guide]";
		mes "好吧~";
		mes "但别气馁。";
		mes "总会有机会的~";
		close;
	}
	mes "[Guide]";
	mes "是的~ 你真的准备好了。";
	mes "那么，去拿些好东西吧~";
	mes "哦，我忘了。出来后记得回到这里。";
	mes "记住哦~";
	close2;
	setarray .@maparray$[0], "prontera", "morocc", "moc_ruins", "geffen", "payon", "lighthalzen", "rachel";
	.@return = inarray(.@maparray$[0], strcharinfo(3));

	if (.@return > 0)
		cashmall_return = .@return;
	else // Default to Prontera if not found
		cashmall_return = 0;

	warp "itemmall",22,43;
	end;
}
morocc,164,39,4	duplicate(cashmall_warper)	Cash Sales Guide#morocc	4_M_HUMAN_02
moc_ruins,115,143,4	duplicate(cashmall_warper)	Cash Sales Guide#moc_ruins	4_M_HUMAN_02
geffen,115,168,4	duplicate(cashmall_warper)	Cash Sales Guide#geffen	4_M_HUMAN_02
payon,164,157,4	duplicate(cashmall_warper)	Cash Sales Guide#payon	4_M_HUMAN_02
lighthalzen,206,144,4	duplicate(cashmall_warper)	Cash Sales Guide#lighthalzen	4_M_HUMAN_02
rachel,128,144,4	duplicate(cashmall_warper)	Cash Sales Guide#rachel	4_M_HUMAN_02

itemmall,21,45,4	script	Exit Guide#cashmall_exit	4_M_HUMAN_02,{
	mes "[Guide]";
	mes "玩得开心吗？";
	mes "非常感谢你使用我们的道具商城。";
	mes "我们会继续带来珍贵物品。";
	next;
	mes "[Guide]";
	mes "要返回你来的地方吗？";
	next;
	if (select( "是", "否" ) == 2) {
		mes "[Guide]";
		mes "还有更多东西可以看。";
		mes "玩得开心。";
		close;
	}
	mes "[Guide]";
	mes "感谢你的到来。";
	mes "我会把你送回来的地方。";
	close2;
	switch(cashmall_return) {
		default:
		case 0:
			.@returnmap$ = "prontera";
			setarray .@xy[0],116,72;
			break;
		case 1:
			.@returnmap$ = "morocc";
			setarray .@xy[0],159,46;
			break;
		case 2:
			.@returnmap$ = "moc_ruins";
			setarray .@xy[0],109,137;
			break;
		case 3:
			.@returnmap$ = "geffen";
			setarray .@xy[0],120,38;
			break;
		case 4:
			.@returnmap$ = "payon";
			setarray .@xy[0],161,58;
			break;
		case 5:
			.@returnmap$ = "lighthalzen";
			setarray .@xy[0],159,95;
			break;
		case 6:
			.@returnmap$ = "rachel";
			setarray .@xy[0],115,125;
			break;
	}
	cashmall_return = 0;
	warp .@returnmap$,.@xy[0],.@xy[1];
	end;
}

itemmall,41,53,3	script	Cat Hand Salesman Macaroon#cashmall	4_M_MERCAT1,{
	mes "[Macaroon]";
	mes "欢迎！";
	mes "今天可是特别的一天！";
	mes "今天有很多东西可看~ 瞧！";
	mes "只能使用 " + mesitemlink( 1000274 ) + " 兑换！";
	mes "请随意选择！";
	next;
	switch( select( "三转一系技能影子", "三转二系技能影子", "扩展职业技能影子", "职业通用影子", "影子立方体", "熔炼/改造/实用物品", "掉落箱", "魔法书" ) ){
		case 1:
			mes "[Macaroon]";
			mes "你说的是^FF0066三转一系技能影子^000000！";
			mes "在这里！";
			close2;
			callshop "CachuaCoupon01";
			end;

		case 2:
			mes "[Macaroon]";
			mes "你说的是^FF0066三转二系技能影子^000000！";
			mes "在这里！";
			close2;
			callshop "CachuaCoupon02";
			end;

		case 3:
			mes "[Macaroon]";
			mes "你说的是^FF0066扩展职业技能影子^000000！";
			mes "在这里！";
			close2;
			callshop "CachuaCoupon03";
			end;

		case 4:
			mes "[Macaroon]";
			mes "你说的是^FF0066职业通用影子^000000！";
			mes "在这里！";
			close2;
			callshop "CachuaCoupon04";
			end;

		case 5:
			mes "[Macaroon]";
			mes "你说的是^FF0066影子立方体^000000！";
			mes "在这里！";
			close2;
			callshop "CachuaCoupon05";
			end;

		case 6:
			mes "[Macaroon]";
			mes "你说的是^FF0066熔炼、改造和实用物品^000000！";
			mes "在这里！";
			close2;
			callshop "CachuaCoupon06";
			end;

		case 7:
			mes "[Macaroon]";
			mes "你说的是^FF0066掉落箱^000000！";
			mes "在这里！";
			close2;
			callshop "CachuaCoupon07";
			end;

		case 8:
			mes "[Macaroon]";
			mes "你说的是^FF0066魔法书^000000！";
			mes "在这里！";
			close2;
			callshop "CachuaCoupon08";
			end;
	}
}

itemmall,24,77,4	script	Blacksmith Basta#pr	4_M_DWARF,{
	if( !getbattleflag( "feature.refineui" ) ){
		end;
	}

	mes "[Blacksmith Basta]";
	mes "我接手了 Mighty Hammer、Brock 和影子铁匠的工作。从现在起会很忙。";
	close2;
	refineui();
	end;
}

itemmall,27,77,4	script	Mighty Hammer#im	4_M_DWARF,{
	mes "[Blacksmith Mighty Hammer]";
	mes "关于精炼请找 Basta。我已经退休了。";
	close;
}

itemmall,24,74,5	script	Blacksmith Brock#im	4_M_HUMAN_01,{
	mes "[Blacksmith Brock]";
	mes "我现在退休了。关于精炼请向那边的 Basta 提出请求。";
	close;
}

itemmall,19,74,5	script	Stylist#cash	91,{
	if( getbattleflag( "feature.stylist" ) ){
		mes "[Jeremy]";
		mes "你好，小可爱~";
		mes "请称呼我为首席造型师 Jeremy。";
		next;
		if( select( "更换造型:结束对话" ) == 2 ){
			mes "[Jeremy]";
			mes "我的店一直营业，随时欢迎回来。";
			close;
		}
		close2;
		openstylist();
		end;
	}

	mes "[Stylist]";
	mes "嘿，我是 Kaniki。";
	mes "我要通过介绍特别的新发型";
	mes "开启新的潮流！";
	mes "给我一张 ^FF0000新发型兑换券^000000，";
	mes "我就为你换发型~";
	next;
	if (Sex == SEX_MALE) {
		mes "[Kaniki]";
		mes "我有两种男性专属发型：";
		mes "紧急治疗烫发";
		mes "和灵气之刃发型。";
		mes "就是灵气之刃发型。";
		next;
		cutin "hair_m_24.bmp",4;
		mes "[Kaniki]";
		mes "这是紧急治疗烫发。";
		mes "这是我最近发明的";
		mes "全新发型。";
		mes "怎么样？很酷吧？";
		next;
		cutin "",255;
		cutin "hair_m_25.bmp",4;
		mes "[Kaniki]";
		mes "这是灵气之刃发型。";
		mes "你以前";
		mes "没见过这样的发型，";
		mes "对吧？";
		next;
		cutin "",255;
	}else{
		mes "[Kaniki]";
		mes "我有两种女性新发型：";
		mes "阿修普罗烫发";
		mes "和灵魂变换发型。";
		mes "想看看这些发型";
		mes "的效果吗？";
		next;
		cutin "hair_f_24.bmp",4;
		mes "[Kaniki]";
		mes "这是阿修普罗烫发。";
		mes "很适合你，";
		mes "对吧？";
		next;
		cutin "",255;
		cutin "hair_f_25.bmp",4;
		mes "[Kaniki]";
		mes "接下来是灵魂变换发型。";
		mes "你觉得怎么样？很漂亮吧？";
		next;
		cutin "",255;
	}
	mes "[Kaniki]";
	mes "你决定好";
	mes "要不要让我";
	mes "更换发型了吗？";
	next;
	if (select( "更换发型", "不更换" ) == 2) {
		mes "[Kaniki]";
		mes "真的吗？哦，真遗憾。";
		mes "如果你改变主意想更新发型，";
		mes "记得回来告诉我，好吗？";
		mes "";
		mes "";
		close;
	}
	if (countitem(7622) < 1) {
		mes "[Kaniki]";
		mes "抱歉，只有带来新发型兑换券，";
		mes "我才能提供造型服务。";
		mes "拿到兑换券后再回来找我，";
		mes "好吗？";
		mes "";
		mes "";
		close;
	}
	mes "[Kaniki]";
	mes "太好了，你带来了";
	mes "新发型兑换券！";
	mes "那么，你想要哪种发型？";
	mes "";
	next;
	if (Sex == SEX_MALE) {
		if(select("紧急治疗烫发", "灵气之刃发型") == 1) {
			delitem 7622,1;	// New_Style_Coupon
			setlook 1,24;
		}else{
			delitem 7622,1;	// New_Style_Coupon
			setlook 1,25;
		}
	}else{
		if(select("阿修普罗烫发", "灵魂变换发型") == 1) {
			delitem 7622,1;	// New_Style_Coupon
			setlook 1,24;
		}else{
			delitem 7622,1;	// New_Style_Coupon
			setlook 1,25;
		}
	}
	mes "[Kaniki]";
	mes "好了——完成！";
	mes "喜欢你的新发型吗？";
	mes "希望再次见到你。保重！";
	mes "";
	close;
}

itemmall,41,55,3	script	Cat Hand Salesman Tunkarom	4_M_MERCAT1,{
	mes "[Tunkarom]";
	mes "欢迎！";
	mes "如果你有特殊兑换券，我们会换给你想要的商品！";
	mes "可兑换的兑换券如下：";
	mes mesitemicon(1001583) + " " + mesitemicon(1001581) + " " + mesitemicon(1001584) + " " + mesitemicon(1001588) + " " + mesitemicon(1001809) + " " + mesitemicon(1001810);
	next;
	switch( select( "兑换善恶战靴", "兑换善恶王冠", "兑换善之武器", "兑换恶之武器", "兑换愤怒武器", "兑换愤怒王冠", "取消" ) ) {
	case 1:
		mes "[Tunkarom]";
		mes "这是善恶战靴兑换。真是个好选择~！";
		close2;
		callshop( "barter_mall_coupon_1" );
		end;
	case 2:
		mes "[Tunkarom]";
		mes "这是善恶王冠兑换。真是个好选择~！";
		close2;
		callshop( "barter_mall_coupon_2" );
		end;
	case 3:
		mes "[Tunkarom]";
		mes "这是善之武器兑换。真是个好选择~！";
		close2;
		callshop( "barter_mall_coupon_3" );
		end;
	case 4:
		mes "[Tunkarom]";
		mes "这是恶之武器兑换。真是个好选择~！";
		close2;
		callshop( "barter_mall_coupon_4" );
		end;
	case 5:
		mes "[Tunkarom]";
		mes "这是愤怒武器兑换。真是个好选择~！";
		close2;
		callshop( "barter_mall_coupon_5" );
		end;
	case 6:
		mes "[Tunkarom]";
		mes "这是愤怒王冠兑换。真是个好选择~！";
		close2;
		callshop( "barter_mall_coupon_6" );
		end;
	case 7:
		mes "[Tunkarom]";
		mes "找不到想要的东西？下次再来吧。";
		close;
	}
}

		mes "[Grer]";
		mes "现在，我得";
		mes "回去工作了。";
		mes "项链需要银饰，所以我会继续开采白银。";
		next;
		mes "[Grer]";
		mes "我要努力工作，";
		mes "打造世界上";
		mes "最美丽的饰品。";
		mes "让它成为世界上最美丽的饰品。";
		next;
		mes "[Grer]";
		mes "好了，你";
		mes "现在可以回去了！";
		mes "再见。";
		set god_brising,47;
		close2;
		hideonnpc "Grer#1";
		end;
	}
	else if (god_brising == 47) {
		mes "[Grer]";
		mes "嘿嘿……";
		mes "你怎么还在";
		mes "这里？你的工作已经完成了。";
		mes "现在，回到";
		mes "你来的地方去吧！";
		close2;
		hideonnpc "Grer#1";
		end;
	}
	else {
		mes "[Grer]";
		mes "你到底是";
		mes "什么人？！";
		close2;
		hideonnpc "Grer#1";
		end;
	}
OnInit:
	hideonnpc "Grer#1";
	end;
}

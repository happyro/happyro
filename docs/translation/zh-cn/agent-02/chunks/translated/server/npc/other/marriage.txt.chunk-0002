prt_church,100,128,4	script	Bishop#w	60,{
	cutin "wedding_bomars01",2;
	if (Upper == 2) {
		mes "[沃玛斯]";
		mes "你好，孩子。";
		mes "迷路了吗？嗯……";
		mes "你知道爸爸妈妈";
		mes "在哪里吗？";
		close2;
		cutin "wedding_bomars01",255;
		end;
	}

	if (!getpartnerid()) {
		if (!$@wedding) {
			if (wedding_sign == 1) {
				getpartymember(getcharid(1));
				set .@partymembercount,$@partymembercount;
				if (.@partymembercount == 2) {
					if (Sex == SEX_MALE) {
						set $@wedding,1;
						initnpctimer;
						mes "[沃玛斯]";
						mes "年轻的恋人，请将这一刻";
						mes "铭记一生。愿你们的未来充满和平";
						mes "与喜悦，愿分享的爱";
						mes "日益增长。";
						next;
						mapannounce "prt_church","It's the marriage proposal from the groom, Mr. " + strcharinfo(0) + "...",bc_map;
						mes "[沃玛斯]";
						mes "直到世界尽头，愿你站在";
						mes "所爱之人身旁，支持并保护她。";
						mes "现在，可以告诉我新娘的名字吗？";
						next;
						input $@wed_bride$;
						mes "[沃玛斯]";
						mes "" + strcharinfo(0) + "先生……";
						mes "你是否发誓一生珍爱并照顾";
						mes "你的新娘" + $@wed_bride$ + "小姐？";
						next;
						select("我愿意。");
						set $@wed_groom$,strcharinfo(0);
						mes "[沃玛斯]";
						mes "现在轮到你的新娘";
						mes "宣读婚礼誓言。";
						mes "请她上前……";
						close2;
						mapannounce "prt_church","The groom, Mr. " + strcharinfo(0) + ", has made his vows to Miss " + $@wed_bride$ + "...",bc_map;
						cutin "",255;
						end;
					}
					mes "[沃玛斯]";
					mes "抱歉，新郎必须先和我交谈";
					mes "才能开始婚礼。";
					mes "这是老派的礼仪，";
					mes "但确实能让流程顺利进行。";
					goto L_End;
				}
				mes "[沃玛斯]";
				mes "结婚前，你必须先和伴侣";
				mes "组成两人队伍。";
				mes "然后我们才能继续仪式。";
				goto L_End;
			}
			mes "[沃玛斯]";
			mes "结婚前必须向幸福玛丽";
			mes "申请婚姻。";
			mes "幸福玛丽会告诉你婚礼准备事项。";
// 切片行数保留
// 切片行数保留
// 切片行数保留
// 切片行数保留
// 切片行数保留
// 切片行数保留
// 切片行数保留
// 切片行数保留
// 切片行数保留
// 切片行数保留
// 切片行数保留
// 切片行数保留
// 切片行数保留
// 切片行数保留
// 切片行数保留
// 切片行数保留
// 切片行数保留
// 切片行数保留
			goto L_End;
		}
		else if ($@wedding == 1) {
			if (wedding_sign == 1) {
				getpartymember(getcharid(1));
				set .@partymembercount,$@partymembercount;
				if (.@partymembercount == 2) {
					if (Sex == SEX_FEMALE) {
						if (strcharinfo(0) == $@wed_bride$) {
							mes "[沃玛斯]";
							mes "年轻的恋人，请将这一刻";
							mes "铭记一生。愿你们的未来充满和平";
							mes "与喜悦，愿分享的爱";
							mes "日益增长。";
							next;
							mapannounce "prt_church","Let's hear what the bride, Miss "+$@wed_bride$+", has to say...",bc_map;
							mes "[沃玛斯]";
							mes ""+$@wed_bride$+"小姐……";
							mes "你是否发誓永远忠于"+$@wed_groom$+"，";
							mes "无论遇到什么危险，";
							mes "都陪伴在他身边？";
							next;
							if (select("^FF0000不。^000000:我愿意。") == 1) {
								cutin "wedding_bomars03",2;
								mapannounce "prt_church","Next couple, please proceed...",bc_map;
								mes "[Vomars]";
								mes "所以"+$@wed_groom$+"不是你";
								mes "想结婚的人？嗯。";
								mes "真的很抱歉造成这样的误会……";
								set $@wedding,0;
								close2;
								stopnpctimer;
								cutin "",255;
								end;
							}
							mes "[Vomars]";
							mes "你真的发誓忠贞且有耐心吗？";
							mes "你愿意和"+$@wed_groom$+"结婚吗？";
							next;
							if (select("是的，我愿意。:^FF0000不。^000000") == 1) {
								if (isloggedin(getcharid(3,$@wed_groom$))) {
									if (marriage($@wed_groom$)) {
										//Call Wedding effect
										wedding;
										//Give ring to Bride, and change to wedding sprite.
										sc_start SC_Wedding,3600000,1;
										getitem 2635,1; //Bride_Ring
										//Give ring to Groom, and change to wedding sprite.
										attachrid(getcharid(3,$@wed_groom$));
										sc_start SC_Wedding,3600000,1;
										getitem 2634,1; //Bridegroom_Ring
										detachrid;
										//Switch Script progression back to Bride
										attachrid(getcharid(3,$@wed_bride$));
										cutin "wedding_bomars02",2;
										mapannounce "prt_church","I now pronounce you, "+$@wed_groom$+" and "+$@wed_bride$+", husband and wife.",bc_map;
										mes "[Vomars]";
										mes "以我作为卢恩·米德加兹王国";
										mes "皇家主教的权力，";
										mes "现在宣布你们成为夫妻。";
										mes "愿未来充满喜悦。";
										next;
										mes "[Vomars]";
										mes "最后……";
										mes "永远幸福，";
							mes "亲爱的"+$@wed_bride$+"……";
// 切片行数保留
// 切片行数保留
// 切片行数保留
// 切片行数保留
// 切片行数保留
// 切片行数保留
// 切片行数保留
										set $@wed_groom$,"";
										set $@wed_bride$,"";
										set $@wedding,0;
										close2;
										stopnpctimer;
										cutin "",255;
										detachrid;
										end;
									}
								}
								cutin "wedding_bomars03",2;
								mes "[Vomars]";
								mes "嗯。看来你的新郎";
								mes "在仪式结束前离开了。";
								mes "请等他回来后再试。";
// 切片行数保留
								mes "回来后再试。";
								goto L_End;
							}
							else {
								cutin "wedding_bomars03",2;
								mapannounce "prt_church","Alas! "+$@wed_bride$+" has rejected "+$@wed_groom$+"'s marriage proposal!",bc_map;
								mes "[Vomars]";
								mes "嗯。看来你改变主意了。";
								mes "虽然我为新郎感到遗憾，";
								mes "但你必须听从内心。现在，快跑！";
							}
							set $@wed_groom$,"";
							set $@wed_bride$,"";
							set $@wedding,0;
							close2;
							stopnpctimer;
							cutin "",255;
							end;
						}
						callsub S_Busy;
					}
					callsub S_Busy;
				}
				callsub S_Busy;
			}
			if (strcharinfo(0) == $@wed_bride$) {
				mes "[Vomars]";
				mes "嗯？看来幸福玛丽还没有收到你的婚姻申请。";
				mes "请和她交谈，我们才能开始婚礼仪式。";
				goto L_End;
			}
			callsub S_Busy;
		}
		callsub S_Busy;
	}
	mes "[Vomars]";
	mes "愿你永远幸福。无论现在多么黑暗，";
	mes "都要陪伴爱人身旁，怀抱希望展望未来。";

L_End:
	close2;
	cutin  "",255;
	end;

S_Busy:
	if ($@wed_groom$ != "" && $@wed_bride$ != "") {
		mes "[Vomars]";
		mes ""+$@wed_bride$+"小姐与";
		mes ""+$@wed_groom$+"先生的婚礼";
		mes "正在进行。请保持安静。";
		goto L_End;
	}
	mes "[Vomars]";
	mes "我正在为另一对新人主持婚礼，";
	mes "请耐心等待轮到你们。感谢理解……";
	goto L_End;

OnStop:
	stopnpctimer;
	end;

OnReset:
	set $@wed_groom$,"";
	set $@wed_bride$,"";
	set $@wedding,0;
	end;

OnTimer180000:
	mapannounce "prt_church","You've responded too slowly... Next couple, please proceed.",bc_map;
	donpcevent "Bishop#w::OnReset";
	stopnpctimer;
	end;
}

prt_church,28,178,4	script	The King of Rune-Midgarts	108,{
	callfunc "F_GM_NPC";
	mes "[Vomars]";
	mes "你、你是谁？";
	mes "必须知道密码，";
	mes "才能唤起";
	mes "我强大的力量。";
	next;
	if (callfunc("F_GM_NPC",1854,0) < 1) {
		mes "[Vomars]";
		mes "这里不是";
		mes "可以";
		mes "胡闹的地方。";
		close2;
		warp "prt_church",101,102;
		end;
	}
	mes "[Wedding Switch]";
	mes "婚礼仪式出问题了吗？";
	mes "如果你愿意，我可以重置主教";
	mes "沃玛斯 NPC。";
	next;
	switch(select("不用了，谢谢:重置")) {
	case 1:
		mes "[Wedding Switch]";
		mes "好吧。";
		mes "不过，如果主教沃玛斯 NPC 卡住，";
		mes "最好将其重置。";
		close;
	case 2:
		donpcevent "Bishop#w::OnStop";
		donpcevent "Bishop#w::OnReset";
		mapannounce "prt_church","You've responded too slowly... Next couple, please proceed.",bc_map;
		mes "[Wedding Switch]";
		mes "主教沃玛斯 NPC 已重新激活。";
		mes "现在应该可以继续举行婚礼了。";
		close;
	}
}

prt_church,20,179,4	script	Divorce Staff	71,{
	callfunc "F_GM_NPC";
	mes "[Bad Ending]";
	mes "糟糕……";
	mes "你知道我无法";
	mes "为你做任何事。";
	next;
	if (callfunc("F_GM_NPC",1854,0) < 1) {
		mes "[Bad Ending]";
		mes "嗯……";
		mes "你确实不该";
		mes "出现在";
		mes "这里……";
		close;
	}
	mes "[Bad Ending]";
	mes "很好，你知道密码！现在，";
	mes "要我移除你背包里的";
	mes "婚戒吗？";
	next;
	switch(select("丢弃 1 枚婚戒。:保留。")) {
	case 1:
		set .@ring, (Sex == SEX_MALE)?2634:2635; //Bridegroom_Ring, Bride_Ring
		if (countitem(.@ring)) {
			delitem .@ring,1;
			mes "[糟糕结局]";
			mes "完成了！";
		} else {
			mes "[糟糕结局]";
			mes "找不到婚戒……";
			mes "请确认它没有被装备。";
		}
		close;
	case 2:
		mes "[糟糕结局]";
		mes "你确定要保留那枚戒指吗？";
		mes "好吧，但如果它造成问题，就来找我。";
		close;
	}
}

prt_church,22,179,4	script	Remarry Staff	71,{
	callfunc "F_GM_NPC";
	mes "[再次婚礼]";
	mes "嗯……？";
	mes "你到底在";
	mes "这里做什么？";
	next;
	if (callfunc("F_GM_NPC",1854,0) < 1) {
		mes "[再次婚礼]";
		mes "啊！";
		mes "像你这样的冒险者";
		mes "不该出现在这里！";
		close;
	}
	if (getpartnerid()) {
		mes "[再次婚礼]";
		mes "嗯……";
		mes "只有已婚角色";
		mes "才能制作婚戒。";
		close;
	}
	mes "[再次婚礼]";
	mes "啊，我看出你知道密码。";
	mes "好吧，如果你弄丢了婚戒，";
	mes "我可以为你制作新的。";
	next;
	switch(select("制作新的婚戒。:取消。")) {
	case 1:
		set .@ring, (Sex == SEX_MALE)?2634:2635; //Bridegroom_Ring, Bride_Ring
		if (countitem(.@ring) || isequipped(.@ring)) {
			mes "[再次婚礼]";
			mes "等等，等等……";
			mes "你正戴着婚戒。";
			mes "最好不要再制作一枚，";
			mes "因为你不需要多于一枚。";
		} else {
			getitem .@ring,1;
			mes "[再次婚礼]";
					mes "给你~";
					mes "这是你的全新婚戒！";

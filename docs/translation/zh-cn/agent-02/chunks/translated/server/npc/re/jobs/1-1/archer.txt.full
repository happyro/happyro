//===== rAthena Script ======================================= 
//= Renewal Archer Job Quest
//===== By: ================================================== 
//= Kisuka
//===== Current Version: ===================================== 
//= 1.1
//===== Compatible With: ===================================== 
//= rAthena Project
//===== Description: ========================================= 
//= Job Change to Archer Class
//===== Additional Comments: ================================= 
//= 1.0 First Version. [Kisuka]
//= 1.1 Added support for Baby classes. [Euphy]
//============================================================ 
payon_in02,64,71,4	script	Archer Guildsman#archer	85,{
	if (Upper == 1) {
		if (Class == Job_Novice_High && (ADVJOB == Job_Sniper || ADVJOB == Job_Clown || ADVJOB == Job_Gypsy)) {
			mes "[弓箭手公会成员]";
			mes "嘿，我认识你。";
			mes "你以前参加过";
			mes "这项考试，对吧？";
			next;
			mes "[弓箭手公会成员]";
			mes "啊，你一定去过";
			mes "英灵殿并重生了。";
			mes "哇，真了不起！";
			next;
			if (!callfunc("F_CanChangeJob")) {
				mes "[弓箭手公会成员]";
				mes "呃……";
				mes "在成为弓箭手之前，你最好先学会所有基础技能。";
				next;
				mes "[弓箭手公会成员]";
				mes "好吧，回头见。";
				close;
			}
			mes "[弓箭手公会成员]";
			mes "那么，我就不";
			mes "多说什么了。";
			mes "我知道你会成为出色的弓箭手……";
			next;
			skill "NV_TRICKDEAD",0,SKILL_PERM;
			jobchange Job_Archer_high;
			skill "AC_MAKINGARROW",1,SKILL_PERM;
			skill "AC_CHARGEARROW",1,SKILL_PERM;
			mes "[弓箭手公会成员]";
			mes "虽然这次没有特别的";
			mes "奖励，希望你能理解。请保重。";
			close;
		}else{
			mes "[弓箭手公会成员]";
			mes "哦……？";
			mes "嘿，你在";
			mes "这里做什么……？";
			next;
			mes "[弓箭手公会成员]";
			mes "我看得出你不适合成为弓箭手。你似乎应该去做";
			mes "其他事情……";
			close;
		}
	}
	mes "[弓箭手公会成员]";
	mes "很高兴见到你。我能帮你什么吗？";
	next;
	switch(select("我想成为弓箭手。:请告诉我转职要求。:没事，谢谢。")) {
	case 1:
		mes "[弓箭手公会成员]";
		if(BaseJob != Job_Novice) {
			if(BaseJob == Job_Archer)
				mes "哈哈，你在开玩笑吧……";
			else {
				mes "抱歉，只有初心者可以转职。";
				mes "你已经有自己的职业了，不是吗？";
			}
			close;
		}else{
			mes "你是……"+strcharinfo(0)+"，对吧？";
			next;
			if (!callfunc("F_CanChangeJob")) {
				mes "[弓箭手公会成员]";
				mes "你的技能等级还不够。";
				mes "职业等级至少要达到^4A4AFF10^000000，基础技能等级要达到^4A4AFF9 级。";
				next;
				mes "[弓箭手公会成员]";
				mes "弓箭手需要极高的集中力，所以我们不接受缺乏耐心的人。";
				close;
			}
			mes "[弓箭手公会成员]";
			mes "你的基础技能已经足够了……";
			mes "……嗯～你已经准备好成为弓箭手了。我马上为你办理转职。";
			next;
			mes "[弓箭手公会成员]";
			mes "恭喜你！你现在是弓箭手了！我们也希望你积极参加复兴弓箭手公会的各项活动。";
			mes "啊，生产部门送来的物品到了。来，收下吧！这些都是你的！";
			callfunc "Job_Change",Job_Archer;
			getitem 1742,1;	// N_Composite_Bow
			getitem 12004,1;	// Arrow_Container
			getitem 12009,1;	// Silver_Arrow_Container
			getitem 12008,1;	// Fire_Arrow_Container
			next;
			mes "[弓箭手公会成员]";
			mes "有了弓和箭，你现在是真正的弓箭手了。";
			mes "打开箭筒后就能取出箭并装备。";
			mes "我期待听到你的好消息。该道别了。";
			mes "再见。";
			close;
		}
	case 2:
		mes "[弓箭手公会成员]";
		mes "弓箭手擅长使用弓，并拥有各种才能。";
		mes "弓箭手最大的能力是从远距离攻击敌人。";
		next;
		mes "[弓箭手公会成员]";
		mes "虽然弓箭手的生命值较低，但可以从远距离射击敌人，";
		mes "因此在真正的战斗中更加安全。";
		next;
		mes "[弓箭手公会成员]";
		mes "虽然仙境传说中的弓箭手生命值较低，但拥有高命中和高攻击速度，能在怪物接近前将其击杀。";
		next;
		mes "[弓箭手公会成员]";
		mes "^8C2121弓箭手可以转职为猎人。^000000";
		mes "^8C2121除了猎人，男性可以转职为诗人，女性可以转职为舞娘。^000000";
		close;
	case 3:
		mes "[弓箭手公会成员]";
		mes "有任何问题都欢迎来问我。";
		close;
	}
}

//===== rAthena Script =======================================
//= Archer Skill Quest
//===== By: ==================================================
//= rAthena Dev Team
//===== Current Version: =====================================
//= 1.7
//===== Compatible With: ===================================== 
//= rAthena Project
//===== Description: ========================================= 
//= Quest for skills: Arrow Crafting, Arrow Repel
//===== Additional Comments: ================================= 
//= 1.5 Rescripted to Aegis 10.3 stadards. [L0ne_W0lf]
//= 1.6 Updated to latest available official file.
//=     also fixed Item issue [bugreport:5607]. [Masao]
//= 1.7 Fixed JobLevel requirements. [Euphy]
//============================================================

moc_ruins,118,99,5	script	Roberto	88,{
	if (BaseClass == Job_Archer) {
		if (getskilllv("AC_MAKINGARROW") == 1) {
			mes "[Roberto]";
			mes "哦，你来自我的家乡！";
			mes "见到你真好！";
			mes "你还好吗？";
			mes "啊！那支箭！";
			mes "是你做的，对吧！";
			next;
			mes "[Roberto]";
			mes "哈哈……！";
			mes "你觉得好多了吗？";
			mes "哈哈……总之我很高兴。";
			mes "偶尔带着家乡的消息";
			mes "回来看看。";
			mes "那么再见~";
			close;
		}
		else if (JobLevel >= 30 || (BaseJob == Job_Hunter || BaseJob == Job_Bard || BaseJob == Job_Dancer)) {
			mes "[Roberto]";
			mes "诶！";
			mes " ";
			mes "你是……";
			next;
			if ((countitem(907) > 19) && (countitem(921) > 6) && (countitem(906) > 40) && (countitem(1019) > 12) && (countitem(501) > 0)) {
				mes "[Roberto]";
				mes "你带来了！";
				mes "非常感谢。";
				mes "那么如我所承诺，我会教你技能。";
				next;
				delitem 907,20; //Resin
				delitem 921,7; //Mushroom_Spore
				delitem 906,41; //Pointed_Scale
				delitem 1019,13; //Wooden_Block
				delitem 501,1; //Red_Potion
				skill "AC_MAKINGARROW",1,SKILL_PERM;
				mes "[Roberto]";
				mes "现在不用担心箭了。";
				mes "哦，你有没有见过";
				mes "斐扬的 Jason？";
				mes "小心，他是个";
				mes "凶猛的家伙。";
				next;
				mes "[Roberto]";
				mes "你只要小心斐扬的 Jason。";
				mes "记住。";
				mes "那么拜拜~ 谢谢你的礼物~";
				close;
			}
			mes "[Roberto]";
			mes "梦罗克的弓箭手！？";
			mes "见到你真好！在这种地方遇到";
			mes "同为弓箭手的人！*抽泣*！";
			mes "我独自来到梦罗克……";
			mes "但我是新来者，压力好大……哇~";
			mes "我好孤独~";
			next;
			switch (select("一定很辛苦。坚持住。:继续受苦吧。")) {
			case 1:
				mes "[Roberto]";
				mes "是的。谢谢……";
				mes "在这种地方你一定";
				mes "过得很辛苦。";
				mes "找箭很难吧？";
				mes "所以我自己制作。";
				next;
				select("诶，真的吗？！");
				mes "[Roberto]";
				mes "没错！我收集各种物品，";
				mes "用它们制作箭。";
				mes "这项技能帮助我";
				mes "在艰难的世界里独自生存。";
				mes "如果你愿意，我可以教你。";
				next;
				select("那太好了。");
				mes "[Roberto]";
				mes "但是……我不能免费做。";
				mes "这个世界没有免费的东西~";
				mes "嗯……这样如何？";
				mes "带来我要求的物品。";
				mes "然后我就教你技能。";
				next;
				mes "[Roberto]";
				mes "离开家乡后我一直很孤独。";
				mes "我想用家乡的东西";
				mes "缓解思乡之情。";
				mes "从斐扬森林的树上带来 20 个树脂，";
				mes "以及商店出售的";
				mes "1 瓶红色药水。";
				next;
				mes "[Roberto]";
				mes "还要从斐扬森林附近的柳树带来 13 根树枝、";
				mes "41 个尖锐鳞片、";
				mes "7 个蘑菇孢子。";
				mes "把这些全部带来，";
				mes "";
				next;
				mes "[Roberto]";
				mes "我就教你技能。";
				mes "那么……我会等你。";
				mes "等你带来家乡的消息。";
				close;
			case 2:
				mes "[Roberto]";
				mes "……嘿，"+((Sex == SEX_MALE)?"先生":"小姐")+"。";
				mes "……晚上小心。";
				close;
			}
		}
		mes "[Roberto]";
		mes "嗯……你";
		mes "有什么要说的吗？";
		mes "我没什么可说的。";
		mes "等级差距";
		mes "让我们无法交谈。";
		close;
	}
	mes "[?]";
	mes "呃……第一次见到弓箭手吗？";
	mes "继续走你的路吧。";
	mes "我只和高等级弓箭手交谈。";
	mes "其他人休想让我开口！";
	close;
}

payon,103,63,3	script	Jason	88,3,3,{
	if (BaseClass == Job_Archer) {
		if (getskilllv("AC_CHARGEARROW") == 1) {
			mes "[Jason]";
			mes "诶，我们又见面了。";
			mes "诶诶诶，好奇怪。";
			mes "每次再次见到别人";
			mes "我就会一直发出‘诶’。";
			mes "诶……总之很高兴再见到你。";
			mes "诶诶……别再来了，诶……";
			close;
		}
		else if (JobLevel >= 35 || (BaseJob == Job_Hunter || BaseJob == Job_Bard || BaseJob == Job_Dancer)) {
			mes "[Jason]";
			mes "可恶……我的伤口还没愈合。";
			mes "呸……我太粗心了……";
			mes "才会变成这样……呃……";
			mes "不过，伤成这样";
			mes "留下了这么多伤口……";
			next;
			mes "我该拿 Roberto 怎么办。";
			mes "嗯……啊！";
			mes "是你？你在那里多久了？";
			mes "嗯……等级很高。";
			mes "像你这样的人肯定";
			mes "知道如何使用冲锋箭。";
			next;
			switch (select("那是什么？:教我。")) {
			case 1:
				mes "[Jason]";
				mes "……你在开玩笑吧？";
				mes "天啊，你那个等级竟然还不知道";
				mes "冲锋箭？";
				mes "你真奇怪。";
				next;
				mes "[Jason]";
				mes "（Jason 陷入了幻想。）";
				next;
				mes "[Jason]";
				mes "好吧。我来教你";
				mes "什么是冲锋箭。";
				next;
				mes "[Jason]";
				mes "冲锋箭是一项让你在攻击时";
				mes "立即将对手击退的技能。";
				mes "只有准确瞄准目标时才能使用。";
				mes "但它不像魔法，";
				mes "不会驱散魔法。";
				next;
				mes "[Jason]";
				mes "这对近战能力较弱的弓箭手";
				mes "非常有用。";
				mes "如果你想学习，";
				mes "再来找我。";
				mes "需要准备一些材料。";
				next;
				mes "[Jason]";
				mes "首先，因为你要改造弓，";
				mes "请带一把不用的十字弓。";
				mes "10 根触手、10 个鸟嘴、";
				mes "3 根溜溜猴尾巴……这些都很有弹性。";
				mes "还有 2 颗祖母绿。最后但同样重要的是……";
				mes "36 瓶我最喜欢的香蕉汁！";
				next;
				mes "[Jason]";
				mes "……咳咳！";
				mes "把这些全部带来，";
				mes "我就教你冲锋箭。";
				mes "那么，再见。";
				mes "（如果你不带香蕉汁，我会生气的。）";
				close;
			case 2:
				if ((countitem(721) > 1) && (countitem(942) > 2) && (countitem(962) > 9) && (countitem(925) > 9) && (countitem(532) > 35)) {
					mes "[Jason]";
					mes "好！完美！";
					mes "我会教你全国闻名的";
					mes "技能——冲锋箭！";
					next;
					delitem 721,2; //Azure_Jewel
					delitem 942,3; //Yoyo_Tail
					delitem 962,10; //Tentacle
					delitem 925,10; //Bill_Of_Birds
					delitem 532,36; //Banana_Juice
					skill "AC_CHARGEARROW",1,SKILL_PERM;
					mes "[Jason]";
					mes "哦，比我预想的效果更好！";
					mes "不需要改造弓了！";
					mes "你可以拿回这个~";
					mes "好好享受在野外和地下城";
					mes "使用新学会的技能吧！";
					mes "嘿~嘿嘿~！";
					close;
				}
				mes "[Jason]";
				mes "嗯……真遗憾。";
				mes "你缺少一些东西。";
				mes "再说一次，你需要 2 颗祖母绿、";
				mes "3 根溜溜猴尾巴、10 根触手、";
				mes "10 个鸟嘴，最后但同样重要的是";
				mes "36 瓶香蕉汁！";
				next;
				mes "[Jason]";
				mes "确认全部准备好后再来！";
				close;
			}
		}
		mes "[Jason]";
		mes "哦……你是弓箭手。";
		mes "再努力一点，";
		mes "你就会成为";
		mes "声名远扬的弓箭手！";
		mes "加油吧！";
		close;
	}
	mes "[?]";
	mes "生活对像我这样的";
	mes "孤独小伙有什么要求？";
	close;

OnTouch_:
	mes "[???]";
	mes "呃呃呃呃呃……";
	close;
}


//= rAthena Project
//===== Description: =========================================
//= Quests for skills: Fatal Blow, Mobile HP Recovery,
//  Auto-Berserk
//===== Additional Comments: =================================
//= 1.6 Rescripted to Aegis 10.3 stadards. [L0ne_W0lf]
//= 1.7 Updated to latest available official file. [Masao]
//= 1.8 Fixed JobLevel requirements. [Euphy]
//= 1.9 Moved Izlude NPC to pre-re/re paths. [Euphy]
//=     Updated "Knight De Thomas" NPC to latest version.
//============================================================

-	script	::KnightDeThomas	98,4,4,{
	if ((BaseClass == Job_Swordman) && (JobLevel >= 35 || (BaseJob == Job_Knight || BaseJob == Job_Crusader))) {
		if (getskilllv("SM_MOVINGRECOVERY") == 1) {
			mes "[De Thomas]";
			mes "哦，是你？好久不见！你看起来比以前健康。哈哈哈！保重，回头见！";
			close;
		} else if (countitem(713) >= 200 && countitem(1058) >= 1) {
			mes "[De Thomas]";
			mes "欢迎回来……准备好学习身体移动了吗？";
			next;
			switch (select("是。:不，我还没准备好。")) {
			case 1:
				mes "[De Thomas]";
				mes "让我看看……";
				next;
				mes "[De Thomas]";
				mes "好！现在我要教你……身体移动技能！";
				next;
				delitem 713,200; //Empty_Bottle
				delitem 1058,1; //Wing_Of_Moth
				skill "SM_MOVINGRECOVERY",1,SKILL_PERM;
				mes "[De Thomas]";
				mes "给你！自己试试，但别过度使用。";
				next;
				mes "[De Thomas]";
				mes "对了，我不需要你的盔甲，你可以留着。现在祝你好运！";
				close;
			case 2:
				mes "[De Thomas]";
			mes "这样啊？准备好后再来。";
				close;
			}
		} else {
			mes "[De Thomas]";
			mes "嗯……他是剑士……你知道我叫德·托马斯·卡洛斯吧？普隆德拉第三骑兵队的骑士。德·托马斯·卡洛斯！";
			next;
			mes "[De Thomas]";

			// bug: official script always states that job level is too low
			//mes "Wait a second, your Job level isn't above ^00880035^000000!";
			//mes "Come back when it is.";

			// custom: old dialog
			mes "你还没有带齐我要求的物品。";
			next;
			mes "[De Thomas]";
			mes "记住，我需要^008800200 个空瓶^000000、你的盔甲和一片^008800蛾翅^000000。带齐后再回来。";
			close;
		}
	} else {
		mes "[De Thomas]";
		mes "我叫德·托马斯·卡洛斯。普隆德拉第三骑兵队的骑士。最近我有一项职责。咳！还需要我多说吗？";
		close;
	}
	end;

OnTouch:
	if ((BaseClass == Job_Swordman) && (JobLevel >= 35 || (BaseJob == Job_Knight || BaseJob == Job_Crusader))) {
		mes "[De Thomas]";
		mes "哦，不！你一定受伤了！还好吗？你一定经历了苦战才会伤得这么重。成为剑士一定伴随着许多责任和牺牲。";
		next;
		mes "[De Thomas]";
		if (Sex == SEX_MALE)
			mes "对于剑士和骑士，有一项很棒的技能。";
		else
			mes "对于女剑士和骑士，有一项很棒的技能，年轻的小姐。";
		mes "我向你介绍——移动时恢复 HP！身体移动是很棒的技能，让你在移动时恢复体力（HP）！";
		next;
		mes "[De Thomas]";
		mes "它目前仍在开发中，所以恢复量也许不多，但总会有帮助。你觉得怎么样？想学这个技能吗？";
		next;
		switch (select("好棒的技能！我想学！:不用了，谢谢。")) {
		case 1:
			mes "[De Thomas]";
			mes "很好。我来告诉你学习这项技能所需的条件。首先，职业等级必须高于^00880035^000000。还需要^008800200 个空瓶^000000。为什么？因为用掉这么多药水证明你经历过激烈战斗。";
			next;
			mes "[De Thomas]";
			mes "还有你战斗时使用的盔甲，这也是经验丰富的战士的证明。盔甲方面……你的盔甲正合适！把它带来！最后……带给我一片^008800蛾翅^000000。";
			next;
			select("嗯？那个也需要？");
			mes "[De Thomas]";
			mes "其实不……我并不真的需要。只是我的侄女暑假把捕虫当作假期任务。当然我自己去拿容易得多，但我必须一直在这里工作，没时间出去。";
			next;
			mes "[De Thomas]";
			mes "你不觉得我每天只能待在一个地方、不能出去很可怜吗？请帮我找一片……*抽鼻子* 如果你不帮……";
			close;
		case 2:
			mes "[De Thomas]";
			mes "...";
			close;
		}
	}
	end;
}

prt_in,75,88,5	script	Leon Von Frich	85,3,3,{
	if ((BaseClass == Job_Swordman) && (JobLevel >= 25 || (BaseJob == Job_Knight || BaseJob == Job_Crusader))) {
		if (getskilllv("SM_FATALBLOW") == 1) {
			mes "[Leon]";
			mes "嗯？我还在想是谁！原来是之前见过的你！很高兴再见到你！最近好吗？小心点！哈哈哈！";
			close;
		}
		else if ((countitem(1752) > 9) && (countitem(1751) > 9) && (countitem(532) > 0) && (countitem(962) > 29) && (countitem(526) > 4)) {
			mes "[Leon]";
			mes "哦！你已经完全准备好学习致命攻击了！怎么样？想学吗？";
			next;
			switch (select("是！:不，我不想学。:不过，什么是致命攻击？")) {
			case 1:
				mes "[Leon]";
				mes "好，开始吧！";
				next;
				delitem 1752,10; //Fire_Arrow
				delitem 1751,10; //Silver_Arrow
				delitem 532,1; //Banana_Juice
				delitem 962,30; //Tentacle
				delitem 526,5; //Royal_Jelly
				skill "SM_FATALBLOW",1,SKILL_PERM;
				mes "[Leon]";
				mes "成功！去充分发挥新技能的潜力吧。哈哈哈哈哈哈！";
				close;
			case 2:
				mes "[Leon]";
				mes "我讨厌你！！！";
				close;
			case 3:
				mes "[Leon]";
				mes "我最近开发了这项技能。使用狂击时，根据你的等级可以击晕对手。你学过狂击，对吧？";
				next;
				mes "[Leon]";
				mes "你觉得怎么样？击晕是非常有用的技巧。你不觉得这项技能很有吸引力吗？想学的话就回来找我！";
				close;
			}
		}
		mes "[Leon]";
		mes "哦！年轻又强壮的剑士！";
		next;
		mes "[Leon]";
		mes "哇，看你的手臂，你一定喜欢使用狂击吧？";
		next;
		select("嗯，我……只是……");
		mes "[Leon]";
		if (Sex == SEX_FEMALE) {
			mes "不用惊讶。使用剑当然要有强壮的手臂！";
		}
		else {
			mes "没什么好害羞的。即使是女性，使用剑也需要强壮的手臂！";
		}
		mes "在尽是无用懒惰年轻人的时代，我很高兴遇到你这样强壮的人。";
		next;
		mes "[Leon]";
		mes "是的，我想送一份礼物给你这样的优秀剑士。";
		next;
		switch (select("什么礼物？:没关系。")) {
		case 1:
			mes "[Leon]";
			mes "哈哈，没什么特别的，只是一项攻击要害的技能！";
			next;
		case 2:
			mes "[Leon]";
			mes "……哈哈，没什么特别的，只是瞄准要害的技能！";
			next;
		}
		mes "[Leon]";
		mes "这是我最近开发的技能。使用狂击时，根据你的等级，对手可能会被击晕。你学过狂击，对吧？";
		next;
		mes "[Leon]";
		mes "我像你一样当剑士时，喜欢使用狂击。每次我都想——如果同时使用击晕，攻击也许会更强。";
		next;
		mes "[Leon]";
		mes "我从战场退下进行研究，终于开发出这项绝妙的新技能！你想学习吗？";
		next;
		switch (select("是。:不。:你有什么吃寿司的建议吗？")) {
		case 1:
			mes "[Leon]";
			mes "好，我告诉你要求。首先需要狂击等级 5。还要准备 10 根火箭、10 根银箭、1 瓶香蕉汁、30 根触手和 5 瓶蜂王浆。它们……有点像材料。";
			next;
			mes "[Leon]";
			mes "材料集齐后再来找我。到时我们再谈。";
			close;
		case 2:
			mes "[Leon]";
			mes "哈哈哈哈哈哈哈哈！";
			mes "... ";
			mes " ... ";
			mes " ...";
			mes "我无话可说了！？";
			close;
		case 3:
			mes "[Sushi King Leon]";
			mes "吃寿司最好的方法是用手。这是基本原则。把鱼而不是米饭蘸进酱油。";
			next;
			mes "[Sushi King Leon]";
			mes "这样味道更浓郁。另外，始终吃当季的种类。先吃白鱼再吃青鱼，味道会更好！嗯！我喜欢寿司~~！";
			close;
		}
	}
	mes "[Leon]";
	mes "哦，不！我没什么能给你的！除了剑士，我对谁都说不出好听有趣的话！来世再见！";
	close;

OnTouch_:
	mes "[Leon]";
	mes "哈哈哈哈哈哈！哈哈哈哈哈哈！";
	close;
}

prt_in,94,57,3	script	Juan	85,4,4,{
	if (BaseClass == Job_Swordman) {
		if (getskilllv("SM_AUTOBERSERK") == 1) {
			mes "[Juan]";
			mes "嗯？好久不见！最近好吗？你比以前更强了。很多人对你寄予厚望。你能做到。";
			close;
		}
		else if (JobLevel < 10 && (BaseJob != Job_Knight && BaseJob != Job_Crusader)) {
			mes "[?]";
			mes "你是什么人？呃，还是个新手。我很忙，所以多训练一阵再回来。";
			close;
		}
		else if (JobLevel < 30 && (BaseJob != Job_Knight && BaseJob != Job_Crusader)) {
			mes "[Juan]";
			mes "哦，很高兴见到你。你可以走了。（微笑~）";
			close;
		}
		else if ((countitem(924) > 34) && (countitem(958) > 9) && (countitem(957) > 9) && (countitem(518) > 9)) {
			mes "[Juan]";
			mes "哦，年轻的剑士！你准备好学习最新技能自动狂暴了吗？！";
			next;
			switch (select("呵呵，我现在就想学。:那是什么？")) {
			case 1:
				mes "[Juan]";
				mes "好。那么……";
				next;
				delitem 924,35; //Powder_Of_Butterfly
				delitem 958,10; //Horrendous_Mouth
				delitem 957,10; //Decayed_Nail
				delitem 518,10; //Honey
				skill "SM_AUTOBERSERK",1,SKILL_PERM;
				mes "[Juan]";
				mes "你现在已经成为能使用自动狂暴的剑士。你可以继续前进，成就伟业！";
				next;
				mes "[Juan]";
				mes "祝你好运！";
				next;
				mes "[Juan]";
				mes "……哦，对了。我忘了说一件事。有些事情你必须牢记。";
				next;
				mes "[Juan]";
				mes "一旦恢复健康，这项技能就会停止。此外它没有真正的时间限制，但受到能抵消挑衅的技能攻击时也会消失。";
				next;
				mes "[Juan]";
				mes "如果不记得这些特性，技能突然消失时，你可能会在战场上遇到麻烦。";
				next;
				mes "[Juan]";
				mes "那么……这次真的再见~";
				close;
			case 2:
				mes "[Juan]";
				mes "自动狂暴？这是战场上至关重要的技能。当生命值变红时，你的隐藏潜能会激发自己，帮助你战斗。";
				next;
				mes "[Juan]";
				mes "它非常适合在战场上如火焰般战斗的人！凭你的能力，现在就能学习。接下来我告诉你所需材料。";
				next;
				mes "[Juan]";
				mes "你需要 35 个蝴蝶粉末。蝴蝶华丽翅膀的能量会帮助你聚集力量！还要 10 个可怕的嘴、10 个腐烂的指甲，最后……10 个蜂蜜！";
				next;
				mes "[Juan]";
				mes "都记下来了吗？准备好后请再回来。我期待再次见到你。";
				close;
			}
		}
		mes "[Juan]";
		mes "哦，不，你比我上次见你时伤得更重。你就这样上战场了？看来你太勉强自己了。";
		next;
		mes "[Juan]";
		mes "即使你力量很强，达到极限后也无能为力，所以别高估自己。当然，你可以使用我们开发的技能突破极限。";
		next;
		switch (select("嗯！你在说什么？:哈哈，不可能有这种东西。:咳呜呜呜！")) {
		case 1:
			mes "[Juan]";
			mes "这项技能叫狂暴，被称为战场之花。当生命值变红时，你的隐藏潜能会激发自己，帮助你战斗。";
			next;
			mes "[Juan]";
			mes "它非常适合在战场上如火焰般战斗的人！凭你的能力，现在就能学习。接下来我告诉你所需材料。";
			next;
			mes "[Juan]";
			mes "你需要 35 个蝴蝶粉末、10 个可怕的嘴、10 个腐烂的指甲，最后……10 个蜂蜜！";
			next;
			mes "[Juan]";
			mes "都记下来了吗？准备好后请再回来。我期待再次见到你。";
			close;
		case 2:
			mes "[Juan]";
			mes "呸，你一辈子都被骗了吗？我不知道。别和我说话。";
			close;
		case 3:
			mes "[Juan]";
			mes "咳呜呜呜呜！哎呜呜呜呜呜呜！咳啊啊啊！";
			close;
		}
	}
	mes "[Juan]";
		mes "旅途愉快吗？希望你今后的日子美好。我只是善良的胡安骑士。别太担心我。哈哈哈……";
	close;
}


}


// Room 2
// * Events - First entrance
1@slw,72,70,3	script	Eisen Werner#werner03	4_M_EISEN,{
	if (is_party_leader() == false)
		end;
	cutin "ep16_eisen01.bmp",1;
	mes "[Eisen Werner]";
	mes "比你想象中容易？";
	mes "接下来的安全装置都差不多，我就不再解释了。";
	next;
	mes "[Eisen Werner]";
	mes "看看这里之后，你觉得怎么样？";
	mes "很惊人吧？";
	mes "你去过^4d4dffVerus^000000吗？";
	next;
	mes "[Eisen Werner]";
	mes "我参考那里建造了这座实验室。";
	mes "那就是我喜欢的类型。";
	mes "......";
	next;
	mes "[Eisen Werner]";
	mes "那里的技术和我们过去拥有的完全不同。";
	mes "我们使用了所有可用的东西。";
	next;
	mes "[Eisen Werner]";
	mes "你觉得呢？";
	mes "看起来不错吧？";
	next;
	select("Do you wonder why I'm saying these things?");
	mes "[Eisen Werner]";
	mes "嗯，因为反正你会死在这里。";
	mes "所以我想展示一下我的成就。";
	next;
	select("Die here? Me?");
	mes "[Eisen Werner]";
	mes "当然。你会死在这里。";
	mes "你以为我会蠢到独自留在这里吗？";
	next;
	mes "[Eisen Werner]";
	mes "我知道你是为了卢恩-米德加尔兹王国的事情来到这里。";
	mes "所以我准备了某种东西。";
	next;
	cutin "ep16_eisen02.bmp",1;
	mes "[Eisen Werner]";
	mes "会带来巨大的冲击。";
	mes "你会死，就在这里。";
	next;
	mes "[Eisen Werner]";
	mes "所以，请做我的客人吧。";
	mes "我们前往下一个区域。";
	close2;
	cutin "",255;
	if (is_party_leader() == true) {
		disablenpc instance_npcname("Eisen Werner#werner03");
		enablenpc instance_npcname("Security device#switch11");
		enablenpc instance_npcname("Security device#switch12");
	}
	end;
}


// Room 3
// * Events - First entrance
1@slw,57,141,3	script	Eisen Werner#werner04	4_M_EISEN,{
	if (is_party_leader() == false)
		end;
	cutin "ep16_eisen01.bmp",1;
	mes "[Eisen Werner]";
	mes "这面墙后面有你来这里想要得到的东西。";
	next;
	mes "[Eisen Werner]";
	mes "没错，就是你把它刻成宝石、装饰在王冠上的东西。";
	mes "你知道它是什么吗？";
	next;
	mes "[Eisen Werner]";
	mes "虽然只是一块碎片，但它是Ymir之心的碎片。";
	mes "它不是仿制品可以相比的。";
	next;
	mes "[Eisen Werner]";
	mes "……王国里的蠢货甚至无法利用已经拥有的力量。";
	mes "真遗憾。";
	mes "所以我决定使用它……";
	next;
	mes "[Eisen Werner]";
	mes "你想夺回它？那就看你的本事了。";
	mes "我可不是空手等着你。";
	next;
	mes "[Eisen Werner]";
	mes "让我再告诉你一次。别惊讶。";
	mes "不，如果你惊讶我会很高兴。";
	mes "呵呵呵呵……";
	next;
	cutin "ep16_eisen03.bmp",1;
	mes "[Eisen Werner]";
	mes "现在，看看我准备的礼物。";
	close2;
	cutin "",255;
	if (is_party_leader() == true) {
		disablenpc instance_npcname("Eisen Werner#werner04");
		enablenpc instance_npcname("Central Entrance#door");
	}
	end;
}

1@slw,54,146,0	script	Central Entrance#door	WARPNPC,1,1,{
	end;
OnTouch:
	if (is_party_leader() == false) {
		warp 'map_slw$,55,153;
		end;
	}
	if (instance_live_info(ILI_NAME) == "Werner Laboratory central room#1") {
		if ('event_final == 0) {
			'event_final = 1;
			enablenpc instance_npcname("Eisen Werner#werner05");
		}
		warp 'map_slw$,55,153;
		end;
	}
	switch( 'event_final ) {
	case 1:
		mes "重播剧情。";
		close2;
		warp 'map_slw$,55,153;
		end;
	case 2:
		warp 'map_slw$,55,153;
		end;
	}
	mes "下一个区域有两个选择。";
	mes "想重播Seyren Windsor的故事，请选择^4d4dff继续剧情^000000；想看看Eisen Werner的杰作，请选择^4d4dff继续战斗^000000。";
	next;
	if (select( "Proceed with the story.", "Proceed with the battle." ) == 1) {
		mes "你选择了剧情。";
		close2;
		if ('event_final == 0) {
			'event_final = 1;
			enablenpc instance_npcname("Eisen Werner#werner05");
		}
		warp 'map_slw$,55,153;
		end;
	}
	mes "你选择了战斗。";
	close2;
	if ('event_final == 0) {
		'event_final = 2;
		enablenpc instance_npcname("Pet child#boss_master");
		enablenpc instance_npcname("#boss_master_dummy");
	}
	warp 'map_slw$,55,153;
	end;
}


// Room Boss
// * Story
1@slw,56,171,3	duplicate(dummy_npc)	Seyren Windsor#seiren	4_M_SEIREN_UC

1@slw,53,171,5	script	Eisen Werner#werner05	4_M_EISEN,{
	if (is_party_leader() == false) {
		mes "^4d4dff只有队长才能继续此事件。^000000";
		close;
	}
	if (checkweight(501,1) == 0) {
		mes "- 你携带的物品太多，无法继续任务。-";
		close;
	}
	.@seyren$ = instance_npcname("Seyren Windsor#seiren");
	cutin "ep16_eisen01.bmp",1;
	mes "[Eisen Werner]";
	mes "这里是实验室的核心，包含我研究的一切。";
	npctalk "这里是实验室的核心，包含我研究的一切。";
	next;
	mes "[Eisen Werner]";
	mes "Ymir之心碎片拥有构成世界的根本力量，也蕴含生命的起源。";
	npctalk "Ymir之心碎片拥有构成世界的根本力量，也蕴含生命的起源。";
	next;
	mes "[Eisen Werner]";
	mes "仔细看看。";
	mes "你来夺回的东西正在做一件了不起的事！";
	npctalk "仔细看看。你来夺回的东西正在做一件了不起的事！";
	next;
	mes "[Eisen Werner]";
	mes "从中提取的能量流入地面的魔法阵……哈哈哈。当然，这个魔法阵经过了魔法改造。";
	npctalk "从中提取的能量流入地面的魔法阵……哈哈哈。当然，这个魔法阵经过了魔法改造。";
	next;
	mes "[Eisen Werner]";
	mes "总之，能量会进入实验对象……我利用那股力量调整了他们的时间。";
	next;
	cutin "ep16_eisen03.bmp",1;
	mes "[Eisen Werner]";
	mes "……当然，有些会因为细胞干裂而死。哈哈！";
	next;
	select("Is that all you want to say?");
	unittalk getcharid(3), "" + strcharinfo(0) + " : Is that all you want to say?";
	cutin "ep16_eisen02.bmp",1;
	mes "[Eisen Werner]";
	mes "不！绝不！";
	mes "你已经忘了我之前说的话吗？";
	mes "我说过准备了礼物。";
	next;
	cutin "ep16_eisen01.bmp",1;
	mes "[Eisen Werner]";
	mes "某种……";
	mes "会让你惊讶的东西。";
	close2;
	setpcblock PCBLOCK_NPC, true;
	cutin "",255;
	sleep2 3000;
	enablenpc .@seyren$;
	npctalk "......", .@seyren$;
	sleep2 1000;
	setpcblock PCBLOCK_NPC, false;
	unittalk getcharid(3), "" + strcharinfo(0) + " : ... Seyren?!";
	mes "[Eisen Werner]";
	mes "我准备的礼物怎么样？！";
	mes "满意吗？";
	cutin "ep16_eisen01.bmp",1;
	next;
	cutin "ep16_eisen01.bmp",1;
	mes "[Eisen Werner]";
	mes "这家伙曾是那个愚蠢王室的使节之一。";
	mes "多亏某个勇敢家伙的实验，我才得到这个杰作。";
	next;
	select("Are you talking about the In Vivo Experiment?");
	unittalk getcharid(3), "" + strcharinfo(0) + " : Are you talking about the In Vivo Experiment?";
	cutin "ep16_eisen02.bmp",1;
	mes "[Eisen Werner]";
	mes "没错，就是这样。";
	mes "除了那个人，还有很多人进行体内实验，但他是第一个敢于强化活体的家伙。";
	next;
	cutin "ep16_eisen01.bmp",1;
	mes "[Eisen Werner]";
	mes "使用仿制的Ymir之心碎片。";
	mes "这对体内实验来说是一个重大转折点。";
	next;
	mes "[Eisen Werner]";
	mes "我一直试图把它应用到各种东西上。";
	next;
	mes "[Eisen Werner]";
	mes "对了……";
	mes "你应该和它打个招呼，对吧？";
	next;
	mes "[Eisen Werner]";
	mes "啊～没错。";
	mes "你不必打招呼，因为你们两个都要死了！";
	cutin "ep16_eisen03.bmp",1;
	next;
	cutin "ep16_eisen02.bmp",1;
	mes "[Eisen Werner]";
	mes "Seyren，把这些客人送下地狱。";
	mes "你明白我的意思吗？";
	next;
	cutin "ep16_seiren02.bmp",2;
	mes "[Seyren]";
	mes ".......";
	npctalk "......", .@seyren$;
	next;
	cutin "ep16_evt_ws.bmp",4;
	mes "[Eisen Werner]";
	mes "嗯？";
	mes "这是怎么回事，Seyren？现在是负相位吗？";
	next;
	mes "[Seyren]";
	mes "我感觉自己从长眠中醒来了。";
	mes "也许就是为了这一天。";
	npctalk "我感觉自己从长眠中醒来了。也许就是为了这一天。", .@seyren$;
	next;
	mes "[Eisen Werner]";
	mes "别忘了你的职责，Seyren。";
	mes "你是一件武器。只是穿着名为Seyren Windsor的骑士服装的傀儡。";
	next;
	mes "[Eisen Werner]";
	mes "需要我一步步解释吗？";
	mes "移植Ymir之心的仿制品后，身体无法承受力量，最终崩溃。";
	next;
	mes "[Eisen Werner]";
	mes "之后它的精神复制了本体，并不断分裂。";
	mes "在这个过程中，记忆、意识、灵魂、心智和自我都像沙子一样散落，失去了意义。";
	next;
	mes "[Eisen Werner]";
	mes "我们把Ymir之心的仿制品移植给身心强大的人时，原以为他会成为更强的生物武器。";
	next;
	mes "[Eisen Werner]";
	mes "我们没想到它会自我复制并无限分裂。因此，那次实验被视为失败。";
	next;
	mes "[Eisen Werner]";
	mes "更糟的是，它变成了只充满愤怒、无法控制的生物。";
	next;
	mes "[Seyren]";
	mes "我在这里。";
	npctalk "我在这里。", .@seyren$;
	next;
	mes "[Eisen Werner]";
	mes "你知道吗？它们现在仍在分裂。";
	mes "它们只是在模仿本体，却还在其中成长。";
	next;
	mes "[Eisen Werner]";
	mes "它们是不完美的存在，所以想变得完美。";
	mes "它们不想只模仿本体、作为虚拟影像活着，而是想成为完美的存在。";
	next;
	mes "[Eisen Werner]";
	mes "它们希望作为单一实体存在。";
	next;
	mes "[Eisen Werner]";
	mes "唯一成功的实验就是你。现在我们称你为Seyren。";
	next;
	cutin "ep16_seiren02.bmp",2;
	mes "[Seyren]";
	mes "……你的意志到此为止了吗？";
	npctalk "……你的意志到此为止了吗？", .@seyren$;
	next;
	cutin "ep16_eisen03.bmp",0;
	mes "[Eisen Werner]";
	mes "嘿，宝贝？你不能这样对我。";
	mes "你必须服从我！";
	next;
	cutin "ep16_eisen02.bmp",0;
	mes "[Eisen Werner]";
	mes "你不记得我费了多大力气才把你从地狱带到这里吗？";
	mes "不要被已经死去之人的意识动摇。";
	next;
	cutin "ep16_seiren02.bmp",2;
	mes "[Seyren]";
	mes "……Eisen Werner。";
	mes "让我再问一次。你的意志到此为止了吗？";
	npctalk "……Eisen Werner。让我再问一次。你的意志到此为止了吗？", .@seyren$;
	next;
	cutin "ep16_eisen01.bmp",0;
	mes "[Eisen Werner]";
	mes "该死！";
	mes "我从没想到会这样！";
	mes "这个世界真有趣，不是吗？哈哈哈哈哈";
	next;
	mes "[Eisen Werner]";
	mes "别以为我到此为止了。";
	mes "我也不需要失败者。";
	close2;
	setpcblock PCBLOCK_NPC, true;
	cutin "",255;
	specialeffect EF_BEGINSPELL3;
	sleep2 1000;
	specialeffect EF_SCREEN_QUAKE;
	sleep2 1000;
	specialeffect EF_LORD;
	disablenpc instance_npcname("Eisen Werner#werner05");
	sleep2 2000;
	setpcblock PCBLOCK_NPC, false;
		npctalk "哦……", .@seyren$;
	mes "[Seyren]";
	mes "……Eisen。你就这样抛弃了一切。";
	npctalk "……Eisen。你就这样抛弃了一切。", .@seyren$;
	specialeffect2 EF_DEVIL3;
	cutin "ep16_seiren01.bmp",2;
	next;
	mes "[Seyren]";
	mes "……啊……";
	npctalk "……啊……", .@seyren$;
	cutin "ep16_seiren02.bmp",2;
	next;
	mes "[Seyren]";
	mes "实体又开始变弱了。";
	mes "现在，我有一条比给Eisen更紧急的信息要告诉你。";
	npctalk "实体又开始变弱了。现在，我有一条比给Eisen更紧急的信息要告诉你。", .@seyren$;
	next;
	mes "[Seyren]";
	mes "我等你很久了。";
	mes "正如Eisen所说，我是不是Seyren已经不重要。";
	npctalk "我等你很久了。正如Eisen所说，我是不是Seyren已经不重要。", .@seyren$;
	next;
	mes "[Seyren]";
	mes "从拥有思考能力开始，我就不知道自己是谁，也不知道为何存在。";
	next;
	specialeffect2 EF_DEVIL4;
	mes "[Seyren]";
	mes "不断分裂创造出了无数个我。";
	next;
	mes "[Seyren]";
	mes "这股力量与Ymir之心的仿制品交织在一起，回应着我的意志和同伴们的意志。他们想要联合，却一次又一次地分裂。";
	next;
	specialeffect2 EF_DEVIL5;
	cutin "ep16_seiren01.bmp",2;
	mes "[Seyren]";
	mes "到现在为止，究竟创造了多少个我？";
	next;
	cutin "ep16_seiren02.bmp",2;
	mes "[Seyren]";
	mes "不断分裂后我失去了自我，却以之前的形态再生。我不认为这是巧合。";
	next;
	mes "[Seyren]";
	mes "我想这一定有原因。";
	next;
	mes "[Seyren]";
	mes "看到^4d4dffTerra Gloria^000000后，我意识到了。";
	mes "这就是神赐予我这个机会的原因。";
	next;
	specialeffect2 EF_DEVIL6;
	cutin "ep16_seiren01.bmp",2;
	mes "[Seyren]";
	mes "你是来夺回这个的吗？";
	mes "……大地已经消失，只剩下星辰。";
	next;
	specialeffect2 EF_DEVIL7;
	cutin "ep16_seiren02.bmp",2;
	mes "[Seyren]";
	mes "Eisen说得对。^4d4dffSeyren Windsor已经不在这个世界上。^000000";
	mes "我现在拥有的只有不断传承某物的强烈意志。";
	next;
	specialeffect2 EF_SCREEN_QUAKE;
	specialeffect2 EF_DEVIL8;
	cutin "ep16_seiren01.bmp",2;
	mes "[Seyren]";
	mes "也许正是那一点意志让我存在。";
	mes "但现在结束了。";
	cutin "ep16_seiren02.bmp",2;
	next;
	specialeffect2 EF_DEVIL9;
	cutin "ep16_seiren01.bmp",2;
	mes "[Seyren]";
	mes ".....";
	next;
	mes "[Seyren]";
	mes "我真的没有更多时间了。";
	mes "这一刻之后，^4d4dff我会再次分裂并散落。^000000";
	next;
	mes "[Seyren]";
	mes "趁我现在还有意志，我有一条信息要告诉你。";
	next;
	if (instance_live_info(ILI_NAME) == "Werner Laboratory central room#1") {
		mes "[Seyren]";
		mes "请继续前进。";
		mes "普隆德拉的骑士Seyren Windsor任务失败了。";
		next;
		mes "[Seyren]";
		mes "^4d4dff我和所有同伴早已死去。";
		mes "请不要把感情浪费在已经死去的身体上。^000000";
		next;
		mes "[Seyren]";
		mes "它们只是披着外壳的幽灵。";
		mes "我很幸运能在你面前表达最后的意志。";
		next;
		mes "[Seyren]";
		mes "它们是我和同伴们的^4d4dff遗物^000000。";
		mes "请把它们交给我们的家人。";
		if (is_party_leader() == true) {

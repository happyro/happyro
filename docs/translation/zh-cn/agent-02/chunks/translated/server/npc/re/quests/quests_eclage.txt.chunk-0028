			}
			close2;
			cutin "",255;
			end;
		}
		if ((isbegin_quest(7418) + isbegin_quest(7419) + isbegin_quest(7420)) > 5) {
			mes "[米努埃尔]";
			mes "仔细想想，你也为其他拉斐尔族做了很多工作。";
			mes "这样就够了。现在你应该去见他。";
			next;
			mes "[米努埃尔]";
			mes "我的工作是在合适的时候传达他的意愿。";
			mes "我想现在就是时候。";
			ep14_2_mylord = 8;
			changequest 7417,7421;
			next;
			mes "[米努埃尔]";
			mes "因为经常见到你，我想我已经对你产生感情了。";
			mes "嗯，我只是说说自己的感受。";
		}
		else {
			mes "身边的其他拉斐尔族都很喜欢我用怪物副产品装饰的亚伊。";
			mes "这可能会成为新潮流。";
		}
	}
	else if (ep14_2_mylord < 8) {
		mes "[艾可拉珠卫兵]";
		if (ep14_2_mylord < 3) {
			mes "欢迎来到艾可拉珠。";
			mes "祝你旅途愉快。";
			close2;
			cutin "",255;
			end;
		}
		else if (ep14_2_mylord == 3) {
			mes "哦，你来了！";
			mes "我可以带你去见想见你的人吗？";
			next;
			if (select("当然。走吧。：我现在没时间……") == 1) {
				mes "[艾可拉珠卫兵]";
				mes "请跟我来。";
				ep14_2_mylord = 4;
				changequest 7414,7415;
				close2;
				warp "ecl_in03",244,89;
			}
			else {
				mes "啊……这样吗？";
				mes "那我等着。";
				next;
				cutin "minuel02",2;
				mes "[艾可拉珠卫兵]";
				mes "不用担心我。";
				mes "无论要多久，我都会在这里等。";
				mes "这是我的工作，不用担心。";
				close2;
			}
		}
		else if (ep14_2_mylord == 4) {
			mes "我以为你还有事情要做。";
			mes "我可以带你去吗？";
			next;
			if (select("好的。：不用了。") == 1) {
				mes "[艾可拉珠卫兵]";
				mes "请跟我来。";
				close2;
				warp "ecl_in03",244,89;
			}
			else {
				mes "[艾可拉珠卫兵]";
				mes "这样吗？";
				mes "我明白了。需要时随时来找我。";
				close2;
			}
		}
		else if (ep14_2_mylord == 5) {
			mes "我经常见到你。";
			mes "我提前接到通知，参谋长要求与你会面。";
			next;
			mes "[艾可拉珠卫兵]";
			if (checkquest(7416,PLAYTIME) == 0) {
				mes "但恐怕还太早。";
				mes "我想你还得等一会儿。";
				close2;
				cutin "",255;
				end;
			}
			mes "差不多到时间了，我现在带你进去吗？";
			next;
			if (select("好的。：我之后再来。") == 1) {
				mes "[艾可拉珠卫兵]";
				mes "请跟我来。";
				ep14_2_mylord = 6;
				close2;
				warp "ecl_in03",58,72;
			}
			else {
				mes "[艾可拉珠卫兵]";
				mes "随你的便，不过让朱恩市长等太久，他可能会不高兴。";
				close2;
			}
		}
		else if (ep14_2_mylord == 6) {
			mes "我可以带你去会客厅吗？";
			next;
			if (select("好的。：不用了。") == 1) {
				mes "[艾可拉珠卫兵]";
				mes "请跟我来。";
				close2;
				warp "ecl_in03",58,72;
			}
			else {
				mes "[艾可拉珠卫兵]";
				mes "谢谢。";
				mes "你经常来这里，我还以为你把我当传送工具了。";
				cutin "minuel02",2;
				close2;
			}
		}
		cutin "",255;
		end;
	}
	else {
		mes "[米努埃尔]";
		if (ep14_2_mylord == 8) {
			mes "朱恩市长想见你。";
			mes "我现在没时间带你去，只告诉你怎么走。";
			next;
			mes "[米努埃尔]";
			mes "从这里的出口出去，沿着螺旋道路向上走两次，就能找到会客厅入口。";
			mes "请走这边。";
		}
		else if (ep14_2_mylord == 9) {
			mes "很高兴再次见到你。";
			mes "参谋长？你得沿着螺旋道路上楼去见他。";
			mes "他在宫殿右侧的会议厅里。";
		}
		else if (ep14_2_mylord == 18) {
			if (checkquest(7440) == -1) {
				mes "你又是从宫殿过来的吗？";
				next;
				select("申米资助的魔法学者" );
				mes "[米努埃尔]";
				mes "参谋长在资助魔法学者吗？";
				mes "我完全不知道……现在想想……啊……原来如此……";
				next;
				select("你是什么意思？" );
				mes "[米努埃尔]";
				mes "他下班后，";
				mes "我经常看到他前往东侧。";
				mes "他的亚伊在另一边，但我常看到他往东走。";
				next;
				mes "[米努埃尔]";
				mes "所以我想，他可能在那里有要见的人。";
				mes "现在想想，那个人不就是他资助的学者吗？";
				next;
				mes "[米努埃尔]";
				mes "当然，这只是我的猜测……";
				mes "不过如果能帮到你，我会很高兴。";
				cutin "minuel02",2;
				if (isbegin_quest(7438) == 1)
					erasequest 7438;
				if (isbegin_quest(7439) == 1)
					erasequest 7439;
				setquest 7440;
			}
		}
		else {
			if (checkquest(7429,PLAYTIME) == 0) {
				mes "我得用你前几天带来的材料装饰亚伊，但不知道什么时候才能离开……";
				mes "希望时间尽快过去。";
			}
			else if (checkquest(7429,PLAYTIME) == 2) {
				erasequest 7429;
				mes "嘿，早晨真是强烈而愉快！";
				mes "等等，现在是早上吗？";
				mes "总之，你看起来很健康，就像刚捕到的鱼。";
				cutin "minuel02",2;
				next;
				mes "[米努埃尔]";
				mes "嗯？为什么这样看我？";
				mes "一位来自摩拉的旅行者告诉我，这是流行的问候方式……我说错了吗？";
				cutin "minuel01",2;
				next;
				mes "[米努埃尔]";
				mes "哦，对了，你带来的装饰品在其他拉斐尔族中很受欢迎。";
				mes "之后可能还要再请你帮忙。";
			}
			else if (isbegin_quest(7428) == 1) {
				if (countitem(6032) < 10 || countitem(6023) < 10 || countitem(944) < 10) {
					mes "你需要找到10个山狮角、10个神秘之角和10个马蹄。";
					close;
				}
				mes "你已经来了！";
				mes "让我检查一下物品。";
				mes "嗯……";
				next;
				mes "[米努埃尔]";
				mes "如果适当地刮花，看起来会更狂野。";
				mes "太棒了。我的朋友们一定会喜欢！";
				delitem 6032,10;// Horn_Of_Hilsrion
				delitem 6023,10;// Mystic_Horn
				delitem 944,10;// Horseshoe
				changequest 7428,7429;
				getexp 200000,200000;
				getitem 6081,1;// Splendide_Coin
			}
			else {
				mes "你有时间吗？";
				mes "我的朋友们很喜欢你前几天带来的怪物副产品，我想请你再弄一些。可以吗？";
				next;
				if (select("抱歉，我很忙。：好，我来做。") == 1) {
					mes "[米努埃尔]";
					mes "那太遗憾了。";
					mes "下次吧！";
				}
				else {
					mes "[米努埃尔]";
					mes "非常感谢。";
					mes "你带来的山狮角、神秘之角和马蹄在朋友中非常受欢迎。";
					mes "请各带10个给我。";
					next;
					mes "[米努埃尔]";
					mes "用狂野而未经雕琢的美装饰亚伊，在朋友中成了新潮流。";
					mes "哈哈……那我就在这里等着。";
					setquest 7428;
				}
			}
		}
	}
	close2;
	cutin "",255;
	end;
}

ecl_in03,245,93,3	script	Chief of Staff#tl01	4_F_FAIRY,{
	if (!checkweight(1301,3)) {
	mes "- 你携带的物品太多，无法继续任务。-";
		close;
	}
	if (ep14_2_mylord < 4) {
		mes "[参谋长]";
		mes "抱歉，这里不允许未经授权进入。";
		close;
	}
	if (ep14_2_mylord == 4) {
		mes "[参谋长]";
		mes "欢迎来到艾可拉珠。";
		mes "是我命令他们带你来这里的。";
		next;
		mes "[申米]";
		mes "我负责运往斯普兰迪德前哨的军需物资。";
		mes "我叫申米。";
		next;
		mes "[申米]";
		mes "我们送往摩拉村的物资……";
		mes "哎哟……抱歉，我最近一直头疼……";
		next;
		mes "[申米]";
		mes "总之，我听说有人";
		mes "会穿过雾之森林，把我们的物资送到斯普兰迪德。";
		next;
		mes "[申米]";
		mes "很高兴亲眼见到你。";
		mes "聪明的人已经在努力和艾可拉珠建立关系。";
		next;
		select("所以，我不是第一个？" );
		mes "[申米]";
		mes "是的，你不是……哎哟……";
		mes "不过没关系。";
		mes "你们人类已经为斯普兰迪德和我们做了很多。";
		next;
		mes "[申米]";
		mes "哦，我皱眉是因为头疼。";
		mes "别误会。";
		mes "嗯……总之，继续说我的故事……";
		next;
		mes "[申米]";
		mes "我们本来就应该欢迎你。";
		mes "现在进入正题吧？也就是我想见你的原因。";
		next;
		mes "[申米]";
		mes "如你所知，我们因彩虹桥的事故与斯普兰迪德断绝了联系。";
		mes "对我们拉斐尔族来说，很难违抗森林和彩虹桥的意志。";
		next;
		mes "[申米]";
		mes "我相信阿尔普海姆的每个妖精也有同样的感受。";
		mes "总之，我想知道现在斯普兰迪德和约顿海姆的情况。";
		next;
		mes "[申米]";
		mes "我听说最近和马努克的战斗已经缓和到停战的程度……";
		mes "也许是因为他们没能及时得到物资。";
		next;
		mes "你回答了申米严肃的问题，并尽可能描述了记得的情况。";
		next;
		select("现在想想……" );
		mes "[申米]";
		mes "是什么？";
		mes "你告诉我的事情会很有帮助。";
		mes "你还有其他想谈的吗？";
		next;
		mes "["+ strcharinfo(0) +"]";
		mes "我听说是萨帕让尤格拉德西尔树生病，";
		mes "你们为了保护树而发动了战争，";
		next;
		mes "["+ strcharinfo(0) +"]";
		mes "但我知道的情况稍有不同。";
		mes "据说战争的起因是萨帕过度采矿，导致尤格拉德西尔树受损，不过……";
		next;
		mes "[申米]";
		mes "等等，到此为止。";
		next;
		select("怎么了？" );
		mes "[申米]";
		mes "这场战争对我们来说就像圣战。";
		mes "这是我们以荣誉和尊严坚持下去的战争。";
		next;
		mes "[申米]";
		mes "所以无论你知道的真相是什么，";
		mes "如果你不打算承担它可能带来的反弹，";
		mes "就什么也别说。";
		next;
		select("你为什么要隐藏真相……" );
		mes "[申米]";
		mes "这是世界树尤格拉德西尔与其守护者之间的事情。";
		mes "应该由朱恩市长听你的故事，而不是我。";
		next;
		select("什么？" );
		mes "[申米]";
		mes "我的工作到此为止。";
		mes "我的意思是，我不是解答你问题的人。";
		mes "我会为你安排与朱恩市长的会面。";
		next;
		mes "谈话中途，申米停止说话，皱起眉头，仿佛又头疼了。";
		mes "按摩了一会儿头部后，他看起来好多了，继续说下去。";
		next;
		mes "[申米]";
		mes "答应我不要把你相信的真相";
		mes "告诉任何人。";
		next;
		if (select("不要！：好，我答应。") == 1) {
			while (1) {
				mes "[申米]";
				mes "你让我很为难。";
				mes "我不希望你成为冲突的原因。";
				next;
				mes "[申米]";
				mes "在和朱恩市长讨论前，你就不能先把这件事留在心里吗？";
				next;
				if (select("不行，我不能！：好，我不会告诉任何人。") == 2) {
					mes "[申米]";
					mes "看来你已经下定决心了。";
					next;
					break;
				}
				mes "[申米]";
				mes "那好吧……";
				mes "这是你的损失……";
				next;
			}
		}
		mes "[申米]";
		mes "我会安排会面，让朱恩市长了解你。";
		mes "你需要稍等一会儿，请耐心等待。";
		next;
		mes "[申米]";
		mes "我会通知带你来的卫兵。";
		mes "过一会儿去找那名卫兵。";
		mes "他会带你过去。";
		next;
		mes "[申米]";
		mes "在那之前，希望你过得愉快。";
		mes "我会把你送到广场。";
		mes "对了，带你去的卫兵会在东门。别忘了时间。";
		ep14_2_mylord = 5;
		changequest 7415,7416;
		close2;
		warp "ecl_in01",47,28;
		end;
	}
	if (ep14_2_mylord == 8) {
		mes "申米用手按着头，似乎头疼了。";
		next;
		mes "[申米]";
		mes "最近头疼得更厉害了。";
		mes "……你来这里做什么？";
		mes "市长不是叫你了吗？";
		mes "你应该去和他谈谈。";
		close;
	}
	if (ep14_2_mylord == 28) {
		mes "申米带着可疑的笑容伸出手。";
		next;
		switch( select("不，还没。：握住他的手。") ) {
		case 1:
			mes "[申米]";
			mes "这里是你应该仔细观察的地方之一。";
			mes "作为外来者，你不该把接受这个提议当作荣幸吗？";
			mes "你犹豫太久了。";
			close;
		case 2:
			mes "握住申米的手时，你的手感到一阵剧痛。";
			mes "你迅速收回手检查，却什么也没发现。";
			next;
			select("只是我的错觉吗……？" );
			mes "[申米]";
			mes "怎么了？";
			mes "我可以带你去吗？";
			mes "现在，这里就是你应该仔细观察的地方。";
			ep14_2_mylord = 29;
			if (isbegin_quest(7449) == 1)
				changequest 7449,7450;
			close2;
			warp "ecl_hub01",129,12;
			end;
		}
	}
	if (ep14_2_mylord > 29) {
		mes "[陌生拉斐尔族]";
		mes "你想要什么？";
		mes "如果你在找申米，那很遗憾。他突然失踪后，我刚被任命接替他的职位。";
		mes "我必须工作。所以如果不是什么重要的事，请不要打扰我。";
		close;
	}
	mes "[申米]";
	if (ep14_2_mylord == 5) {
		if (checkquest(7416,PLAYTIME) == 0) {
			mes "你还要再等一会儿才能见朱恩市长。";
			mes "他很忙，请耐心等待。";
			close;
		}
		mes "本来还有另一名卫兵要带你去……";
		mes "但我现在无法离开。";
		next;
		mes "[申米]";
		mes "广场东侧门附近有一名卫兵。";
		mes "我已经通知他了，去请他带路吧。";
	}
	else if (ep14_2_mylord == 6) {
		mes "你把想法告诉朱恩市长了吗？";
		mes "应该由他来决定。";
		next;
		mes "[申米]";
		mes "看来你还没见过他。请卫兵带你去。";
	}
	else if (ep14_2_mylord == 7) {
		mes "我听说过你的事。";
		mes "你决定为艾可拉珠工作了吗？";
		next;
		mes "[申米]";
		mes "彩虹桥起点应该有一名正在跺脚的信使。";
		next;
		mes "[申米]";
		mes "那是我们派去定期联系斯普兰迪德的信使，";
		mes "但我想现在仍然很难做到。";
		next;
		mes "[申米]";
		mes "如果你能帮忙，其他拉斐尔族不是会对你刮目相看吗？";
	}
	else if (ep14_2_mylord == 9) {
		mes "欢迎。";
		mes "你是外来者，却得到了市长的认可，这很少见。";
		next;
		select("我应该给你什么东西……" );
		mes "[申米]";
		mes "哦，对了。市长赐予你一只翅膀。";
		mes "给你。";
		ep14_2_mylord = 10;
		getitem 2916,1;// Fairy_Wing
		erasequest 7422;
		next;
		mes "[申米]";
		mes "虽然不是什么贵重物品，但也不常见。";
		mes "轻轻摇动它，你随时都能回到艾可拉珠。";
		next;
		mes "[申米]";
		mes "这件物品非常适合你，也就是为国王效力的你。嘿嘿。";
	}
	else if (ep14_2_mylord == 16) {
		mes "啊，你来得正是时候。";
		mes "我听说你最近一直去彩虹桥塔？";
		mes "既然你要去那里，我想请你帮个忙……";
		next;
		mes "[申米]";
		mes "其实，我正在资助一名魔法学者。";
		mes "他需要一些实验材料，据说你能在彩虹桥塔找到。";
		next;
		mes "[申米]";
		mes "如果可以，你能帮我吗？";
		mes "当然会给你丰厚的奖励。";
		next;
		switch( select("当然。：抱歉，我不能。") ) {
			mes "[申米]";
		case 1:
			mes "因为这是意料之外的请求，我本来还有些担心。太好了。";
			mes "请为我收集以下物品。";
			next;
			mes "[申米]";
			mes "我需要尘球和用落叶制成的书签。";
			mes "你可以在塔内找到它们。";

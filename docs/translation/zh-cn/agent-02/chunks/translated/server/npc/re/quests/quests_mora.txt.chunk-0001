-	script	#mora_bush_timer	-1,{
	end;
OnInit:
	disablenpc();
	end;
OnEnable:
	enablenpc();
	initnpctimer;
	end;
OnDisable:
	stopnpctimer;
	disablenpc();
	end;
OnTimer1000:
	donpcevent "Bush#ep14_1_bs"+charat(strnpcinfo(0),4)+"::OnDisable";
	end;

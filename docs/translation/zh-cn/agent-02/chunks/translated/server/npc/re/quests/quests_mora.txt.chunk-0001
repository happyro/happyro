// Theore's Request :: ep14_1_bs
//============================================================
mid_camp,148,222,4	script	Theore#ep14_1_bs	982,3,3,{
	if (BaseLevel < 100) {
		mes "- 一个穿白袍的人 -";
		mes "- 正在揪自己的头发。-";
		close;
	}
	if (ep14_1_bs == 0) {
		mes "[Theore]";
		mes "啊啊啊啊！！！";
		mes "可恶！！！！";
		mes "我完了！！！";
		next;
		mes "[Theore]";
		mes "这么糟糕的报告让我怎么提交！！！五岁小孩都写得比我好！！！";
		mes "不——！！！";
		set ep14_1_bs,1;
		close;
	} else if (ep14_1_bs == 1) {
		mes "- 一个穿白袍的人 -";
		mes "- 正在揪自己的头发。-";
		next;
		if(select("试着和他交谈。：真吵。") == 2) {
			mes "[Theore]";
			mes "哦，当然，抱歉。";
			mes "我会小声点。";
			close;
		}
		mes "["+strcharinfo(0)+"]";
		mes "先生……你还好吗？";
		mes "这样下去头发会掉光的。";
		mes "冷静。";
		next;
		mes "[Theore]";
		mes "呜……";
		next;
		mes "[Theore]";
		mes ".......";
		next;
		mes "[Theore]";
		mes "奥丁！！！";
		mes "芙蕾雅！！！！";
		mes "萨扎林！！！";
		mes "谢谢你们！！";
		mes "还没有结束！！";
		next;
		mes "[Theore]";
		mes "希望永远存在！我，泰奥尔，会坚持下去！！";
		next;
		mes "[Theore]";
		mes "亲爱的冒险者！！！";
		mes "不，不，亲爱的战士！！！！";
		mes "你现在忙吗？";
		mes "如果能给我一点时间，我一定会给你丰厚的奖励！";
		next;
		switch(select("我很忙。：继续听他说。")) {
		case 1:
			mes "[Theore]";
			mes ".......";
			mes "我明白了，看来没办法。";
			mes "我可能会掉光头发，只能去做生发广告。但我不会怪你，战士。";
			next;
			mes "[Theore]";
			mes "神啊！我的好运到此为止了。*呜*";
			mes "即使全世界背弃我，我也不会怪任何人！！！";
			close;
		case 2:
			mes "[Theore]";
			mes "啊！";
			mes "我感觉自己得救了。";
			mes "事情是这样的……";
			next;
			mes "[Theore]";
			mes "哦！天啊！";
			mes "真失礼，我还没自我介绍。";
			mes "我叫泰奥尔，在‘巴泽特·提布莱克异世界文化研究所’工作。";
			next;
			mes "[Theore]";
			mes "我目前正在研究斯普兰迪德前线基地的拉斐内人。";
			mes "也许是因为我工作太努力了，最近拉斐内人一看到我就全都逃跑。";
			next;
			mes "[Theore]";
			mes "截止日期快到了，我还没弄清最关键的部分。";
			mes "我的教授会非常失望……";
			next;
			mes "[Theore]";
			mes "所以你能帮我吗？！";
			mes "你的帮助一定会被充分认可——我会亲自告诉教授！";
			next;
			switch(select("帮忙。：不帮。")) {
			case 1:
				mes "[Theore]";
				mes "呜呜，战士，你最好了！";
				mes "我绝不会忘记！！！";
				mes "我要把这件事写进日记！！";
				mes "还要写进报告！！！";
				mes "还要写进寄回家的信！！";
				next;
				mes "[Theore]";
				mes "我要告诉实验室的朋友们！！！";
				mes "我要告诉鲁根！！！";
				mes "我要写在公告板上！！！";
				mes "让我想想！！！还有哪里？";
				next;
				mes "- 那个男人似乎处于狂躁状态。-";
				mes "- 等他冷静下来。-";
				mes "- and try speaking to him again. -";
				set ep14_1_bs,2;
				setquest 11182;
				close;
			case 2:
				mes "[Theore]";
				mes ".......";
				mes "你这个坏人，把我弄得这么激动。";
				mes "*sob*";
				close;
			}
		}
	} else if (ep14_1_bs == 2) {
		if (checkquest(11182,PLAYTIME) < 2) {
			mes "[Theore]";
			mes "......";
			switch(rand(1,4)) {
			case 1:
				mes "我必须告诉隔壁邻居皮科！！！";
				mes "还有卡秋娅！！！";
				break;
			case 2:
				mes "告诉街对面的商人！！！";
				mes "还要告诉管理员！！！";
				break;
			case 3:
				mes "告诉霍尔格伦先生！！！";
				mes "给国王写一份报告！！！";
				break;
			case 4:
				mes "告诉这里的人们！！！";
				mes "从观测台大声喊出来，让全世界都听见！！！";
				break;
			}
			next;
			mes "- 他仍然很狂躁。-";
			mes "- 等他冷静下来。-";
			mes "- and try speaking to him again. -";
			close;
		}
		mes "[Theore]";
		mes "抱歉。";
		mes "我有点激动。";
		mes "真的很抱歉。";
		next;
		mes "[Theore]";
		mes "我平时是个冷静理性的人，但今天感觉像去了所有地方——天堂和地狱！";
		next;
		mes "[Theore]";
		mes "言归正传：我想请你做的事并不难。";
		next;
		mes "[Theore]";
		mes "你可能知道，拉斐内人与萨帕人正在交战。";
		mes "直到最近，他们还在无情地攻击萨帕人。";
		next;
		mes "[Theore]";
		mes "但最近攻击频率大幅下降。";
		mes "我想不通为什么，他们是目标单一的生物，不可能只是同情萨帕人的处境。";
		next;
		mes "[Theore]";
		mes "另外还有传闻，说没有武装的拉斐内人在田野上飞行。";
		next;
		mes "[Theore]";
		mes "我见过一次，但他一发现我就逃走了，我没机会问他。";
		mes "我确定他回村了。但我很想问清楚，却被禁止进入斯普兰迪德前线基地。";
		next;
		select("被禁止？" );
		mes "[Theore]";
		mes "嗯……";
		mes "教授把研究项目交给我后，我太兴奋了……";
		mes "于是日夜搜查斯普兰迪德，最后被他们赶了出来。";
		mes "哈哈哈！";
		next;
		mes "[Theore]";
		mes "拉斐内人看起来很可爱，但他们是战斗专家……";
		mes "所以我现在既没胆量偷偷进去，报告也只完成了一半……";
		next;
		mes "[Theore]";
		mes "告诉我，还有比我更不幸的人生吗？";
		mes "*chuckle*";
		next;
		mes "[Theore]";
		mes "所以战士，请找到来到斯普兰迪德田野的拉斐内人，查明他们在做什么，好吗？";
		next;
		mes "[Theore]";
		mes "如果你试图和他们说话，他们可能会逃走，所以找到后要仔细观察。";
		next;
		mes "[Theore]";
		mes "拉斐内人一直很吵闹，他们最近却如此安静，实在令人不安——就像巨大雷暴前的平静。";
		set ep14_1_bs,3;
		changequest 11182,11183;
		close;
	} else if (ep14_1_bs == 3) {
		mes "[Theore]";
		mes "所以战士，请找到来到斯普兰迪德田野的拉斐内人，问问他们在做什么，好吗？";
		next;
		mes "[Theore]";
		mes "如果你试图和他们说话，他们可能会逃走，所以找到后要仔细观察。";
		next;
		mes "[Theore]";
		mes "拉斐内人一直很吵闹，他们最近却如此安静，实在令人不安——就像巨大雷暴前的平静。";
		close;
	} else if (ep14_1_bs < 10) {
		if (ep14_1_bs2 == 0) {
			mes "- 他现在不适合交谈。你应该把小袋子带到斯普伦迪德，寻找它的主人。-";
			close;
		} else if (ep14_1_bs2 < 4) {
			mes "[Theore]";
			mes "嗯……他们在翻灌木丛？";
			mes "嗯……嗯……";
			next;
			mes "[Theore]";
			mes "他们可能留下了线索，你能在附近找找吗？";
			mes "如果他们翻过灌木丛，也许是在找丢失的东西。";
			mes "或者留下了什么。";
			close;
		} else if (ep14_1_bs2 < 7) {
			if (countitem(6390) == 0) {
				mes "[Theore]";
			mes "他们可能留下了线索，你能在附近找找吗？";
			mes "如果他们翻过灌木丛，也许是在找丢失的东西。";
			mes "或者留下了什么。";
				close;
			}
			mes "[Theore]";
			mes "拉斐内人逃跑时掉下的袋子？";
			mes "嗯……嗯……用油浸泡干藤条制成绳子的柔软皮袋……太小，人类或萨帕人用不了……";
			next;
			mes "[Theore]";
			mes "难……难道是？！";
			mes "那个东西？！";
			mes "我只听说过，却从未见过的东西！！！";
			next;
			mes "[Theore]";
			mes "古代拉斐内人会把仙尘——比如飞行尘、缩小尘——装在这样的小袋子里。";
			next;
			mes "[Theore]";
			mes "他们通常喜欢华丽设计，但这种‘仙尘袋’总是随身携带，遵循传统，制作得很简单，不加华丽装饰。";
			next;
			mes "[Theore]";
			mes "我不知道现在是否还一样，但如果这是‘仙尘袋’，主人一定很急着找回它。";
			next;
			mes "[Theore]";
			mes "不过不能免费还回去。用一些情报交换——这很公平！";
			next;
			mes "[Theore]";
			mes "而且如果我们看看袋子里面，也许他们不会太生气！";
			mes "哇！！";
			mes "我小时候一直相信妖精会来给我撒飞行尘，让我飞起来！！！";
			next;
			mes "- 我还没来得及阻止他，-";
			mes "- 他就打开了小袋子。-";
			next;
			mes "[Theore]";
			mes ".......";
			next;
			mes "[Theore]";
			mes "哦……";
			mes "浆果……还有叶子？";
			mes ".......";
			next;
			mes "[Theore]";
			mes "……飞扬的尘土呢？";
			mes "不——！";
			mes "我可怜的纯真想象！！！！";
			next;
			mes "- 他现在不适合交谈。你应该把小袋子带到斯普伦迪德，寻找它的主人。-";
			set ep14_1_bs2, ep14_1_bs2+3; //4,5,6 -> 7,8,9
			changequest 11185,11186;
			close;
		} else {
			mes "- 他现在不适合交谈。你应该把小袋子带到斯普伦迪德，寻找它的主人。-";
			close;
		}
	} else if (ep14_1_bs < 18) {
		mes "- 他似乎正忙着。你应该先完成手头的任务，再回来。-";
		close;
	} else if (ep14_1_bs == 18) {
		mes "[Theore]";
	mes "你终于回来了！！！！";
	mes "调查进展如何？！";
		next;
		mes "[Theore]";
	mes "哇！！！";
	mes "难以置信！！！！！！";
	mes "不敢相信！！！";
		next;
		mes "[Theore]";
	mes "太棒了！！！！";
	mes "这些肯定足够写出优秀的报告！！";
	mes "全都多亏了你，战士！！";
		next;
		mes "[Theore]";
	mes "我永远、永远不会忘记你为我做的一切！";
	mes "不！！";
	mes "我的子孙后代都会记得！！！！";
		mes "*Sob*";
		next;
		mes "[Theore]";
	mes "那么我要去完成报告的最后润色了！！！！！！！";
	mes "哦耶！！！！";
		set ep14_1_bs,19;
		getexp 0,200000;
		getitem 6380,5; //Mora_Coin
		close;
	} else if (ep14_1_bs > 18) {
		mes "[Theore]";
	mes "我要以闪电般的速度写完报告！！！！！！！";
	mes "哦耶！！！！";
		close;
	}
	end;
OnTouch:
	if (BaseLevel > 99) {
		if (ep14_1_bs == 0) {
			mes "[Theore]";
			mes "啊啊啊啊！！！";
			mes "可恶！！！！";
			mes "我完了！！！";
			next;
			mes "[Theore]";
			mes "这么糟糕的报告让我怎么提交！！！五岁小孩都写得比我好！！！";
			mes "不——！！！";
			set ep14_1_bs,1;
			close;
		}
	}
	end;
}

-	script	#mora_bush	-1,{
	if (ep14_1_bs != 3 || rand(5)) {
		mes "- It's just an ordinary bush. -";
		close;
	}
	set .@i, atoi(charat(strnpcinfo(2),9));
	set .@rand, rand(1,3);
	mes "[Unarmed Laphine]";
	mes "啊啊啊啊啊啊啊啊啊！！！！！！！！！！！！！！！！";
	donpcevent "Fairy#cmd"+.@i+.@rand+"::OnEnable";
	set ep14_1_bs, .@i+3;
	set ep14_1_bs2, .@rand;
	changequest 11183,11184;
	next;
	mes "- 你试着和正在灌木丛周围查看的-";
	mes "- 拉菲内交谈，-";
	mes "- but it flew away -";
	mes "- while yelling fearfully. -";
	next;
	mes "- 这个精灵在做什么？-";
	mes "- 你决定四处看看。-";
	donpcevent "Bush"+.@i+"Timer::OnEnable";
	close;
OnEnable:
	enablenpc();
	donpcevent "Bush"+charat(strnpcinfo(2),9)+"Timer::OnDisable";
	end;
OnDisable:
	disablenpc();
	end;
}

-	script	#mora_pouch	-1,{
	end;
OnTouch:
	set .@i, atoi(charat(strnpcinfo(2),9));
	if (ep14_1_bs == .@i+3) {
		if (countitem(6390) == 0) {
			if (checkweight(1201,1) == 0) {
				mes " - 请稍等！！-";
				mes " - 你携带的物品种类太多，- ";
		   	mes " - 无法再领取物品。- ";
				mes " - 请减轻负重，- ";
		   	mes " - 然后再试一次。- ";
				close;
			}
			if (MaxWeight - Weight < 1000) {
				mes " - 请稍等！！-";
			 	mes " - 你携带的重量太多，- ";
				mes " - 请减轻负重，- ";
		   	mes " - 然后再试一次。- ";
				close;
			}
			mes "- Jumble Fumble -";
			mes "- Rustle Bustle -";
			next;
			if (rand(1,5) == 4) {
				mes "- 你找到一个小袋子。-";
				if (ep14_1_bs2 > 0 && ep14_1_bs2 < 4)
					set ep14_1_bs2, ep14_1_bs2+3;
				changequest 11184,11185;
				getitem 6390,1; //Small_Pocket
				close;
			} else {
				mes "- 你什么也没找到。-";
				close;
			}
		}
	}
	end;
}

-	script	#mora_fairy	-1,{
	end;
OnInit:
	disablenpc();
	end;
OnEnable:
	enablenpc();
	initnpctimer;
	end;
OnDisable:
	disablenpc();
	stopnpctimer;
	end;
OnTimer5000:
	donpcevent strnpcinfo(0)+"::OnDisable";
	stopnpctimer;
	end;
}


	case 6:
		mes "人不会因失败而结束，放弃时才算结束。";
		mes "- Richard Nixon -";
		break;
	case 7:
		mes "失败具有启发性。真正思考的人从失败中学到的，不亚于从成功中学到的。";
		mes "- John Dewey -";
		break;
	case 8:
		mes "播下思想，收获行动；播下行动，收获习惯；播下习惯，收获性格；播下性格，收获命运。";
		mes "- Erasmus -";
		break;
	case 9:
		mes "世上没有比绝望更大的愚蠢。";
		mes "- Miguel de Cervantes -";
		break;
	case 10:
		mes "谦逊是最难实现的美德，没有什么比自我欣赏的欲望更难消亡。";
		mes "- T. S. Eliot -";
		break;
	case 11:
		mes "你必须评估自己的才能……问问自己，这会是兴趣还是职业。";
		mes "- Norma Clayton -";
		break;
	case 12:
		mes "以眼还眼，最终只会让整个世界失明。";
		mes "- Gandhi-";
		break;
	case 13:
		mes "没有才能的人渴望长寿，但如果给愚人永恒，他也不知道该如何利用。";
		mes "- Solzhenitsyn -";
		break;
	case 14:
		mes "我们犯错不是因为真相太难看见……而是因为我们最容易、最舒服的做法，是在符合自己情绪、尤其是自私情绪的地方寻找答案。";
		mes "- Solzhenitsyn -";
		break;
	case 15:
		mes "当心只读一本书的人。";
		mes "- English Proverb -";
		break;
	case 16:
		mes "蜜蜂饮水酿蜜，蛇饮水制毒。";
		mes "- English Proverb -";
		break;
	case 17:
		mes "绝望是会导致死亡的疾病。";
		mes "- Kierkegaard -";
		break;
	case 18:
		mes "没有希望地吃面包，仍是在慢慢饿死。";
		mes "- Pearl Buck -";
		break;
	case 19:
		mes "乐观是通向成就的信念。没有希望和信心，什么都做不成。";
		mes "- Helen Keller -";
		break;
	case 20:
		mes "深入观察自然，然后你会更好地理解一切。";
		mes "- Albert Einstein -";
		break;
	case 21:
		mes "许多人生失败者在放弃时，并不知道自己离成功有多近。";
		mes "- Thomas Edison -";
		break;
	case 22:
		mes "当我不再试图得到想要的东西，而开始帮助别人得到他们想要的东西时，我更快乐，也获得了更多经济成功。";
		mes "- Spencer Johnson, Larry Wilson -";
		break;
	case 23:
		mes "年龄如同爱情，无法隐藏。";
		mes "- Thomas Dekker -";
		break;
	case 24:
		mes "保持现在的样子，我们无法成为应该成为的人。";
		mes "- Oprah Winfrey -";
		break;
	case 25:
		mes "把伤口化为智慧。";
		mes "- Oprah Winfrey -";
		break;
	case 26:
		mes "痛苦是人类伟大的老师。";
		mes "- Marie E. Eschenbach -";
		break;
	case 27:
		mes "君子总想着美德，普通人想着安逸。";
		mes "- Confucius -";
		break;
	case 28:
		mes "快乐常常因描述它而被破坏。";
		mes "- Stendhal -";
		break;
	case 29:
		mes "当我们不再与自己交谈时，一切便走到了尽头。这是真正思考的终结，也是最终孤独的开始。";
		mes "- Edward Gibbon -";
		break;
	case 30:
		mes "战胜怀疑和恐惧的人，也战胜了失败。";
		mes "- James Allen -";
		break;
	case 31:
		mes "我们最大的骄傲不是从未失败，而是每次跌倒后都能站起来。";
		mes "- Confucius -";
		break;
	case 32:
		mes "爱一个人时，所有恐惧都会消失；害怕时，所有爱也会消失。";
		mes "- Osho Rajneesh -";
		break;
	case 33:
		mes "潜意识的力量无比巨大；清醒状态做不到的事，可以借助比意识更明智的潜意识完成。";
		mes "- Osho Rajneesh -";
		break;
	case 34:
		mes "真理很简单，非常简单——简单到孩子都能理解。事实上，只有孩子能理解。除非再次成为孩子，否则无法理解。它是体验，而非推测。";
		mes "- Osho Rajneesh -";
		break;
	case 35:
		mes "世上最好、最美的事物无法看见，甚至无法触摸——必须用心感受。";
		mes "- Helen Keller -";
		break;
	case 36:
		mes "永远不要低头，始终抬头挺胸。直视这个世界。";
		mes "- Helen Keller -";
		break;
	case 37:
		mes "独自一人能做的很少；共同努力能做很多。";
		mes "- Helen Keller -";
		break;
	case 38:
		mes "教育的最高成果是宽容。";
		mes "- Helen Keller -";
		break;
	case 39:
		mes "我们每个人都是只有一只翅膀的天使；只有彼此拥抱才能飞翔。";
		mes "- Luciano de Crescenzo -";
		break;
	case 40:
		mes "靠等待喂养自己的人可能会饿死。";
		mes "- Danish Proverb -";
		break;
	case 41:
		mes "糟糕的和平胜过美好的战争。";
		mes "- Russian Proverb -";
		break;
	case 42:
		mes "想在老年取暖的人，必须在年轻时建好壁炉。";
		mes "- German Proverb -";
		break;
	case 43:
		mes "挑剔的人往往选到最差的。";
		mes "- Ilocano Proverb -";
		break;
	case 44:
		mes "即使是神，赌博三天后也会赔钱。";
		mes "- Chinese Proverb -";
		break;
	case 45:
		mes "我不怕只练过一次一万种踢法的人，却怕把一种踢法练过一万次的人。";
		mes "- Bruce Lee -";
		break;
	case 46:
		mes "被人铭记的最好方式，是活出值得铭记的一生。";
		mes "- Bruce Lee -";
		break;
	case 47:
		mes "了解自己，就是在与他人的行动中研究自己。";
		mes "- Bruce Lee -";
		break;
	case 48:
		mes "我不是不相信一见钟情的人，但我相信再看一眼。";
		mes "- Bruce Lee -";
		break;
	case 49:
		mes "婚姻绝不该仓促。婚姻不像水果，永远都在当季。";
		mes "- Leo Tolstoy -";
		break;
	case 50:
		mes "想成功的人会找到方法，不想成功的人会找到借口。";
		mes "- Leo Aguila -";
		break;
	case 51:
		mes "动机让你开始，习惯让你坚持。";
		mes "- Jim Ryan -";
		break;
	case 52:
		mes "活得精彩、常常欢笑、深爱他人的人，已经获得成功。";
		mes "- Bessie Stanley -";
		break;
	case 53:
		mes "穷人花掉钱，再投资剩余；富人投资钱，再花掉剩余。";
		mes "- Jim Rohn -";
		break;
	case 54:
		mes "如果找不到成功的钥匙，就撬开锁。成功最重要的原则之一，是养成额外努力的习惯。";
		mes "- Napoleon Hill -";
		break;
	case 55:
		mes "人类拥有一种真正有效的武器，那就是笑声。";
		mes "- Mark Twain -";
		break;
	case 56:
		mes "没有笑声的一天，就是被浪费的一天。";
		mes "- Charlie Chaplin -";
		break;
	case 57:
		mes "今天笑得最好的人，也会笑到最后。";
		mes "- Nietzsche -";
		break;
	case 58:
		mes "笑声是驱散人脸上冬日的阳光。";
		mes "- Victor Hugo -";
		break;
	case 59:
		mes "你笑，世界与你同笑；你哭，只有你独自哭泣。";
		mes "- Ella Wheeler Wilcox -";
		break;
	case 60:
		mes "你不可能同时生气和大笑。愤怒与笑声互不相容，而你有选择其一的力量。";
		mes "- Wayne Dyer -";
		break;
	case 61:
		mes "我们不是因为快乐才笑——而是因为笑才快乐。";
		mes "- William James -";
		break;
	case 62:
		mes "懂得自嘲的人永远不会停止获得乐趣。";
		mes "- Shirley MacLaine -";
		break;
	case 63:
		mes "不曾哭泣的年轻人是野蛮人，不愿笑的老人是傻瓜。";
		mes "- George Santayana -";
		break;
	case 64:
		mes "我不太有耐心面对必须解释才能理解的美。如果需要额外诠释，我会怀疑它是否实现了目的。";
		mes "- Charlie Chaplin -";
		break;
	case 65:
		mes "近距离看，人生是一场悲剧；远距离看，却是一场喜剧。";
		mes "- Charlie Chaplin -";
		break;
	case 66:
		mes "智慧最清晰的标志，是持续保持愉快。";
		mes "- Michel de Montaigne -";
		break;
	case 67:
		mes "你享受浪费的时间，并没有被浪费。";
		mes "- John Lennon -";
		break;
	case 68:
		mes "真正的幽默源于头脑，也源于心灵。它不是轻蔑，本质是爱。它不带来大笑，而是带来更深沉的静默微笑。";
		mes "- Thomas Carlyle -";
		break;
	case 69:
		mes "通过幽默，你可以减轻人生带来的最沉重打击。一旦找到笑声，无论处境多么痛苦，你都能挺过去。";
		mes "- Bill Cosby -";
		break;
	case 70:
		mes "我最大的希望，是笑得和哭得一样多；完成工作，努力爱一个人，并鼓起勇气接受回馈的爱。";
		mes "- Maya Angelou -";
		break;
	}
	next;
	mes "[Raffle Philosopher]";
	mes "人们对听到的内容有不同理解。";
	next;
	mes "[Raffle Philosopher]";
	mes "我想知道你对我所说的有什么看法。";
	next;
	input .@inputstr$;
	mes "[Raffle Philosopher]";
	mes "所以你认为"+.@inputstr$+"。";
	next;
	mes "[Raffle Philosopher]";
	mes "... ... ... ...";
	next;
	mes "[Raffle Philosopher]";
	mes "我不知道。这个问题没有唯一答案……保留你的想法吧。";
	close;
}

-	script	#mora_traveler	-1,{
	mes "[Upset Traveler]";
	mes "你……你敢和我玩游戏？";
	emotion ET_ANGER, getnpcid(0, "Traveler#ep14_1_1");
	next;
	mes "[提问的旅人]";
	mes "什么……？你有证据吗？你有证据吗？！";
	emotion ET_FRET, getnpcid(0, "Traveler#ep14_1_2");
	next;
	mes "[试图阻止争斗的旅人]";
	mes "好了，停下，快停下！我怕会变成大打斗……";
	emotion ET_PROFUSELY_SWEAT, getnpcid(0, "Traveler#ep14_1_3");
	next;
	mes "[试图阻止争斗的旅人]";
	mes "哦！我们为什么不问问那个人……？";
	next;
	mes "[Upset Traveler]";
	mes "哦，对！好主意。嗯~你好~那边的旅行者！";
	emotion ET_AHA, getnpcid(0, "Traveler#ep14_1_1");
	next;
	mes "他们似乎在叫你。";
	next;
	if(select("看看发生了什么。:这和我无关。") == 2) {
		mes "你继续上路，把旅行者留在身后。";
		close;
	}
	mes "["+strcharinfo(0)+"]";
	mes "这里发生了什么？";
	emotion ET_QUESTION, playerattached();
	next;
	mes "[Upset Traveler]";
	mes "我告诉你吧。Rose 的母亲有 10 个儿子。长子叫 Roseone，次子叫 Rosetwo，第三个叫 Rosethree……第九个叫 Rosenine……你懂了吧？";
	emotion ET_ANGER, getnpcid(0, "Traveler#ep14_1_1");
	next;
	mes "[提问的旅人]";
	mes "对，就是这样。所以我问最小的儿子叫什么，并告诉他答案，他却生气并开始骂我。";
	emotion ET_FRET, getnpcid(0, "Traveler#ep14_1_2");
	next;
	mes "[Upset Traveler]";
	mes "你……你这个混蛋！喂，你觉得问题的答案是什么？";
	emotion ET_ANGER, getnpcid(0, "Traveler#ep14_1_1");
	next;
		switch(select("Roseten。:Rose。:我怎么知道？")) {
	case 1:
		mes "["+strcharinfo(0)+"]";
		mes "答案是 Roseten。你们为什么为这种小事争吵？";
		next;
		mes "[Upset Traveler]";
		mes "看吧？连这位旅行者都说答案是 Roseten。你竟敢耍我？";
		emotion ET_KIK, getnpcid(0, "Traveler#ep14_1_1");
		next;
		mes "[提问的旅人]";
		mes "你这个笨蛋……你完全没搞懂！";
		emotion ET_FRET, getnpcid(0, "Traveler#ep14_1_2");
		break;
	case 2:
		mes "["+strcharinfo(0)+"]";
		mes "答案是 Rose。你说 Rose 的母亲有 10 个儿子。所以即使其他儿子叫 Roseone、Rosetwo……Rosenine，最小的必须叫 Rose，否则她就不会被称为 Rose 的母亲。";
		next;
		mes "[提问的旅人]";
		mes "我就是这个意思！我没法和他相处。看来我们生活在两个不同的世界。";
		emotion ET_OK, getnpcid(0, "Traveler#ep14_1_2");
		next;

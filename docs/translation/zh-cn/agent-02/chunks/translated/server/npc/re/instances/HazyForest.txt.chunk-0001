// Instance Creation :: md_mistwoods_enter
//============================================================
bif_fild01,158,340,5	script	Laphine Soldier#mist	447,{

	set .@party_id,getcharid(1);
	set .@md_name$,"Mistwood Maze";

	mes "[Laphine Soldier]";
	mes "你要进入森林吗？";
	next;
	if (!.@party_id) {
		mes "[Laphine Soldier]";
		mes "哎呀，你是不是太鲁莽了？";
		mes "至少先组建一支队伍吧？";
		close;
	}
	set .@playtime, checkquest(7211,PLAYTIME);
	if (is_party_leader() == true) {
		if (.@playtime == 0 || .@playtime == 1) {
			mes "[Laphine Soldier]";
			mes "……你确定没有做得太过头吗？";
			mes "我觉得你最好休息一下。";
			mes "做得太多只会让你筋疲力尽。";
			next;
			mes "[Laphine Soldier]";
			mes "我也不认为当局会批准你进入。";
			mes "……就连萨法族人也会被拦在森林外。";
			next;
			select("你说我们的语言说得很好，对吧？");
			mes "[Laphine Soldier]";
			mes "……是吗？";
			mes "其实我说的不是你们的语言。";
			mes "我说的是拉菲内语。";
			next;
			mes "[Laphine Soldier]";
			mes "但这正是彩虹桥的奥秘之一。";
			mes "即使语言不同，我们也能互相理解。";
			next;
			mes "[Laphine Soldier]";
			mes "能够和所有人交谈……";
			mes "或许这就是彩虹桥的力量。";
			close;
		} else if (.@playtime == 2) {
			mes "[Laphine Soldier]";
			mes "很好，很好。";
			mes "现在森林不会拒绝你了。";
			mes "你接下来打算做什么？";
			erasequest 7211;
		} else {
			mes "[Laphine Soldier]";
			mes "你们人类冒险者真了不起。";
			mes "总是前往其他人不敢踏足的森林。";
			next;
			mes "[Laphine Soldier]";
			mes "呼。不过为了安全起见，";
			mes "我必须向当局报告每个进入森林的人。";
			next;
			mes "[Laphine Soldier]";
			mes "登记之后";
			mes "你就能获得许可。";
			mes "你要冒险进入迷雾森林吗？";
		}
		next;
		switch(select("进入迷雾森林。:放弃。")) {
		case 1:
			mes "[Laphine Soldier]";
			mes "队伍名称："+getpartyname(.@party_id)+"……";
			mes "队伍队长："+strcharinfo(0)+"……";
			if (instance_create(.@md_name$) < 0) {
				mes "嗯……";
				next;
				mes "[Laphine Soldier]";
				if (.@playtime == -1)
					mes "森林里很危险。";
				else
					mes "森林里的气氛有些紧张。";
				mes "……你今天还是回去吧？";
				close;
			}
			mes "知道了。我已经把它们记在报告上。";
			next;
			mes "[Laphine Soldier]";
			mes "你很快就会获得许可。";
			mes "现在去木桩隧道，那是进入迷雾森林的唯一道路。";
			mes "明白了吗？";
			next;
			mes "[Laphine Soldier]";
			mes "我们无法违抗森林，";
			mes "但也许你们人类可以。";
			mes "祝你好运！";
			close;
		case 2:
			mes "[Laphine Soldier]";
			mes "嗯，你做出了正确的决定。";
			if (.@playtime == -1)
				mes "这对你来说是件好事。";
			close;
		}
	} else {
		mes "[Laphine Soldier]";
		mes "你的队长在哪里？";
		mes "里面很危险。";
		next;
		if (.@playtime == 2) {
			mes "[Laphine Soldier]";
			mes "看来你以前来过森林。";
			mes "好吧，至少森林不会拒绝你。";
			mes "不过……";
			erasequest 7211;
			next;
		}
		mes "[Laphine Soldier]";
		mes "设身处地想想，我是入口守卫，请让我见见你们队伍的代表。";
		mes "我必须和他或她商量一些事情。";
		close;
	}
}

bif_fild01,161,355,0	script	Log Tunnel	844,{
	mes "透过木桩隧道可以看到森林。";
	mes "看来我可以从木桩隧道进入森林。";
	next;
	if(select("进入隧道。:放弃。") == 2)
		close;
	switch(instance_enter("Mistwood Maze")) {
	case IE_OTHER:
		mes "[Laphine Soldier]";
		mes "感觉不太对劲。似乎发生了危险的事情，今天你最好回去。";
		close;
	case IE_NOINSTANCE:
		mes "你试着爬进木桩，却被神秘力量卷起的风推了回来。";
		mes "看来你无法强行进入森林。";
		close;
	case IE_NOMEMBER:
		mes "[Laphine Soldier]";
		mes "喂，看这里！";
		mes "你要一个人进去吗？";
		mes "那可不行，太鲁莽了。";
		mes "和朋友组队一起去吧！";
		close;
	case IE_OK:
		if (checkquest(7211,PLAYTIME) == 2) erasequest 7211;
		if (checkquest(7211,PLAYTIME) == -1) setquest 7211;
		mapannounce "bif_fild01",getpartyname(getcharid(1))+" 队伍的成员 "+strcharinfo(0)+" 正在进入迷雾森林迷宫。",bc_map,"0x00ff99"; //FW_NORMAL 12 0 0
		//warp "1@mist",89,29;
		close;
	default:
		mes "木桩隧道另一侧的世界阴暗而令人窒息。";
		mes "你的直觉在尖叫，告诉你这片森林很危险。";
		close;
	}
}

// Instance Scripts :: md_mistwoods_in
//============================================================
1@mist,89,29,0	script	#Whisper_mist	844,1,1,{
	end;
OnInstanceInit:
	enablenpc instance_npcname("#Whisper_mist");
	end;
OnTouch_:
	disablenpc instance_npcname("#Whisper_mist");
	initnpctimer;
	end;
OnTimer10000:
OnTimer20000:
	mapannounce instance_mapname("1@mist"),"低语：这是谁？这是谁！？森林开放了！汤姆、汤巴、疲惫的雷姆、雷米！醒醒！",bc_map,"0xccffcc"; //FW_NORMAL 12 0 0
	end;
OnTimer60000:
	mapannounce instance_mapname("1@mist"),"响亮的低语：森林守护者在做什么？园丁们在做什么？？",bc_map,"0xccffcc"; //FW_NORMAL 12 0 0
	end;
OnTimer120000:
	mapannounce instance_mapname("1@mist"),"响亮的低语：别出去，永远徘徊下去，和我们一起玩！",bc_map,"0xccffcc"; //FW_NORMAL 12 0 0
	end;
OnTimer180000:
	mapannounce instance_mapname("1@mist"),"响亮的低语：没用，没用。一直徘徊，你会走向终结！",bc_map,"0xccffcc"; //FW_NORMAL 12 0 0
	stopnpctimer;
	end;
}

// callfunc "F_Mora_Mist",<warp to enable>,<success message>,<fail message>{,<end flag>}
function	script	F_Mora_Mist	{
	set .@map$, instance_mapname("1@mist");
	if (mobcount(.@map$,instance_npcname(strnpcinfo(0))+"::OnMyMobDead") == 0) {
		mes "显然没人照料这里。";
		mes "看来你可以砍倒花园里的树。";
		next;
		if(select("砍倒花园的树。:放弃。") == 2)
			close;
		mes "你砍倒了挡住迷宫道路的树，"+((getarg(3,0))?"为离开森林清出了道路。":"现在可以继续前进了。");
		mapannounce .@map$,getarg(1),bc_map,"0xccffcc"; //FW_NORMAL 12 0 0
		enablenpc instance_npcname(getarg(0));
		disablenpc();
		if (getarg(4,0))
			initnpctimer;
		close;
	} else
		mapannounce .@map$,((getarg(3,0))?getarg(2):getarg(2)+"'s Cry: Huh? Who's doing bad things to my tree?!"),bc_map,"0xccffcc"; //FW_NORMAL 12 0 0
	end;
}


		mes .@npc_name$;
		mes "真清爽！";
		mes "咔哈哈～……";
		mes "...";
		mes "啊！冒险者！";
		next;
		mes .@npc_name$;
		.@skip = true;
		break;
	case 2:
		mes .@npc_name$;
		mes "你好，你今天来了！";
		erasequest 8667;
		break;
	}
	switch( checkquest(8668,HUNTING) ) {
	case -1:
		if (!.@skip) {
			mes .@npc_name$;
			mes "你好，你今天来了！";
		}
		mes "我向路过的冒险者发布魔物讨伐调查委托，怎么样？";
		mes "如果你要去附近地点，我们也提供传送服务。";
		next;
		switch( select( "讨伐任务", "前往附近城镇", "停止" ) ) {
		case 1:
			mes .@npc_name$;
			mes "如果你在这片奥杜姆拉草地、也就是我能看到的区域猎杀80只魔物，协会会认可你的成就并给予经验值。";
			next;
			if (select( "接受", "拒绝" ) == 2) {
				mes .@npc_name$;
				mes "这是互惠互利的事，你为什么拒绝……";
				close;
			}
			setquest 8668;
			mes .@npc_name$;
			mes "我喜欢，我喜欢。";
			mes "我会确认这里的魔物数量是否得到控制。";
			close;
		case 2:
			mes .@npc_name$;
			mes "这里最近的地方是^0033FF拉赫^000000，";
			mes "如果你有" + .@item_name$ + ", 请给我一瓶……我就送你过去。";
			mes "哈～最近很流行，但我没法去买。";
			next;
			if (select( "给我1瓶" + .@item_name$ + "，拉赫", "不" ) == 2) {
				mes .@npc_name$;
				mes "啊……那我能怎么办？";
				mes "我什么时候才能再试……";
				close;
			}
			if (countitem(1000374) < 1) {
				mes .@npc_name$;
				mes "你似乎没有" + .@item_name$ + "?";
				mes "我站在这里……抱歉。";
				close;
			}
			delitem 1000374,1;	// Brilliant_Soda
			warp "rachel",113,136;
			end;
		case 3:
			mes .@npc_name$;
			mes "这是互惠互利的事，你为什么拒绝……";
			close;
		}
		end;
	case 0:
	case 1:
		mes .@npc_name$;
		mes "请在附近猎杀80只魔物。";
		mes "……是吗？需要移动服务？";
		next;
		mes .@npc_name$;
		mes "这里最近的地方是^0033FF拉赫^000000，";
		mes "如果你有" + .@item_name$ + ", 请给我一瓶……我就送你过去。";
		mes "哈～最近很流行，但我没法去买。";
		next;
		if (select( "给我1瓶" + .@item_name$ + "，拉赫", "不" ) == 2) {
			mes .@npc_name$;
			mes "啊……那我能怎么办？";
			mes "我什么时候才能再试……";
			close;
		}
		if (countitem(1000374) < 1) {
			mes .@npc_name$;
			mes "你似乎没有" + .@item_name$ + "?";
			mes "我站在这里……抱歉。";
			close;
		}
		delitem 1000374,1;	// Brilliant_Soda
		warp "rachel",113,136;
		end;
	case 2:
		mes .@npc_name$;
		mes "啊，冒险者！我充分看到了你的表现。谢谢你的辛苦努力。";
		next;
		mes .@npc_name$;
		mes "我觉得适量对任何事情都很重要，对吧？";
		getexp 171420,162480;
		erasequest 8668;
		setquest 8667;
		close;
	}
	end;

OnInit:
	setunittitle getnpcid(0), "<Juno Monster Society>";

	questinfo( QTYPE_DAILYQUEST, QMARK_YELLOW, "BaseLevel >= 86 && checkquest(8668,HUNTING) == -1 && checkquest(8667,PLAYTIME) == -1" );
	questinfo( QTYPE_DAILYQUEST, QMARK_YELLOW, "checkquest(8667,PLAYTIME) == 2" );
	questinfo( QTYPE_DAILYQUEST, QMARK_YELLOW, "checkquest(8668,HUNTING) == 2" );

	// (no questinfo when playtime ongoing)
	end;
}

// note: all mobs increase the hunt count
ve_fild07,158,354,3	script	Map Examiner Shevko#chevco	2_M_DYEINGER,{
	.@npc_name$ = "[" + strnpcinfo(1) + "]";
	.@item_name$ = getitemname(1000374);

	if (BaseLevel < 86) {
		mes .@npc_name$;
		mes "朱诺魔物协会正在进行讨伐任务，但你看起来还不够强，无法执行任务。";
		close;
	}
	switch( checkquest(3478,PLAYTIME) ) {
	case -1:
		break;
	case 0:
	case 1:
		mes .@npc_name$;
		mes "今天的委托结束了。";
		next;
		mes .@npc_name$;
		mes "我明天会再次接取，所以明天见。";
		next;
		if (select( "发送" + .@item_name$ + "。", "不要传送。" ) == 2)
			end;
		if (countitem(1000374) < 3) {
			mes " - Requires 3 " + .@item_name$ + ". - ";
			close;
		}
		delitem 1000374,3;	// Brilliant_Soda
		erasequest 3478;
		mes .@npc_name$;
		mes "嗯？这是什么？我先喝了。";
		next;
		mes .@npc_name$;
		mes "呜呜呜呜呜呜呜呜呜呜呜呜呜呜呜呜～～～";
		next;
		specialeffect EF_FLASHER;
		mes .@npc_name$;
		mes "嗯！！！味道真奇怪，不过这是……呃……";
		next;
		mes .@npc_name$;
		mes ".........";
		next;
		mes .@npc_name$;
		mes "抱歉，我刚才睡了一会儿。我应该很快就能清醒，请稍等。";
		close;
	case 2:
		erasequest 3478;
		break;
	}
	switch( checkquest(3477,HUNTING) ) {
	case -1:
		mes .@npc_name$;
		mes "初次见面，我是朱诺魔物协会的地图调查员谢夫科。";
		next;
		switch( select( "领取讨伐任务。", "传送到附近城镇。", "询问讨伐任务。", "下次再来。" ) ) {
		case 1:
			mes .@npc_name$;
			mes "想领取讨伐任务吗？";
			next;
			mes .@npc_name$;
			mes "你只需在我们所在的这片区域猎杀80只魔物。";
			next;
			setquest 3477;
			mes .@npc_name$;
			mes "祝你好运。";
			close;
		case 2:
			mes .@npc_name$;
			mes "离这里最近的城镇是维因斯。";
			next;
			mes .@npc_name$;
			mes "如果你给我1瓶" + .@item_name$ + ", 我马上送你过去。";
			next;
			if (select( "移动", "不要移动" ) == 2) {
				mes .@npc_name$;
				mes "需要什么请告诉我。";
				close;
			}
			if (countitem(1000374) < 1) {
				mes .@npc_name$;
				mes "你没有" + .@item_name$ + ".";
				next;
				mes .@npc_name$;
				mes "传送需要1瓶" + .@item_name$ + ".";
				close;
			}
			mes .@npc_name$;
			mes "好，那我们走吧。";
			close2;
			delitem 1000374,1;	// Brilliant_Soda
			warp "veins",146,32;
			end;
		case 3:
			mes .@npc_name$;
			mes "不知从什么时候起，各地生活的魔物数量开始增加。";
			next;
			mes .@npc_name$;
			mes "我知道魔物数量逐渐增加，但这是因为我们没有认真对待。";
			next;
			mes .@npc_name$;
			mes "为了恢复原状，朱诺魔物协会向各地派遣了地图调查员。";
			next;
			mes .@npc_name$;
			mes "我就是其中一名地图调查员，正在等待勇敢的冒险者进行讨伐。";
			close;
		case 4:
			mes .@npc_name$;
			mes "祝你今天愉快";
			close;
		}
		end;
	case 0:
	case 1:
		mes .@npc_name$;
		mes "你只需在这片区域制服80只任意类型的魔物。";
		next;
		mes .@npc_name$;
		mes "讨伐完成后别忘了告诉我。";
		close;
	case 2:
		getexp 148560,140040;
		erasequest 3477;
		setquest 3478;
		mes .@npc_name$;
		mes "你毫发无伤地回来了……你一定很厉害。";
		next;
		mes .@npc_name$;
		mes "多亏了你，我成功完成了今天的讨伐目标，谢谢。";
		next;
		mes .@npc_name$;
		mes "如果可以，希望明天再见。";
		close;
	}
	end;

OnInit:
	setunittitle getnpcid(0), "<Juno Monster Society>";

	questinfo( QTYPE_QUEST, QMARK_YELLOW, "BaseLevel >= 86 && checkquest(3477,HUNTING) == -1" );
	questinfo( QTYPE_QUEST2, QMARK_YELLOW, "checkquest(3477,HUNTING) == 2" );
	end;
}


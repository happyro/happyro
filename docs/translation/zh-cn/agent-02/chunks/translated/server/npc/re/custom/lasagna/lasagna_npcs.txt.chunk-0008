				next;
				mes "[Chef]";
				mes "你救了我的串线，我必须报答你。非常感谢。";
				next;
				mes "[Chef]";
				mes "明天还能再帮我吗？我想把串线托付给可靠的人。";
				erasequest 14590;// Hunter's destination
				setquest 14592;// Resting Time
				getexp 400,800;
				close;
			case 14591:
				if (countitem(921) < 5) {
					mes "[Chef]";
			mes "今天能做些鱼糕吗？求你了。别让我让客人空手回去，他们可是等了很久才来吃鱼糕。";
					next;
					mes "[Chef]";
			mes "请抓十只变异孢子，再带给我五个蘑菇孢子。快点！";
					close;
				}
				mes "[Chef]";
			mes "五个蘑菇孢子。完美。请冒险者帮忙真是明智。";
				next;
				mes "[Chef]";
			mes "我们差点失去所有想吃鱼糕的客人。非常感谢！";
				delitem 921,5;// Mushroom Spore
				erasequest 14591;// Secret Ingredient
				setquest 14592;// Resting Time
				getexp 500,1000;
				close;
			}
		}
	case 0:
	case 1:
		mes "[Chef]";
		mes "什么，你已经来帮忙了？";
		next;
		mes "[Chef]";
		mes "现在还太早。催促也解决不了问题。";
		next;
		mes "[Chef]";
		mes "好好休息，明天再来。";
		close;
	case 2:
		mes "[Chef]";
		mes "你来了？正好我需要帮忙。";
		next;
		mes "[Chef]";
		mes "今天也能帮忙吗？";
		next;
		if (select( "I'll try.", "I'm busy." ) == 2) {
			mes "[" + strcharinfo(0) + "]";
			mes "我现在很忙。之后再做。";
			close;
		}
		switch(.@quest_id) {
		case 14546:
			mes "[Chef]";
			mes "请保护草地，防止草地法布尔和叶疯兔破坏。那些草是牛的食物。";
			next;
			mes "[Chef]";
			mes "草地法布尔和叶疯兔各五只。这样应该能吓退附近其他的。";
			next;
			mes "[Chef]";
			mes "过了南边的桥后会看到十字路口。走正下方的路，一直前往牧羊人所在的拉维奥尔平原。";
			next;
			mes "[Chef]";
			mes "抓完它们后可以来找我，也可以向 <NAVI>^4D4DFF[牧羊人]^000000<INFO>lasa_fild01,353,370,000,1,</INFO></NAVI> 报告。";
			next;
			mes "[Chef]";
			mes "在哪里报告报酬都一样。准备好了吗？";
			erasequest 14592;// Resting Time
			setquest 14546;// Take care of grass thief
			close;
		case 14588:
			mes "[Chef]";
			mes "新的一天开始了，野大黄蜂也要开始活动。";
			next;
			mes "[Chef]";
		mes "我们的蜂蜜有危险！";
			next;
			mes "[Chef]";
		mes "请去拉维奥尔森林抓十只野大黄蜂。";
			next;
			mes "[Chef]";
			mes "完成后可以来找我，也可以向收集蜂蜜的 <NAVI>^4D4DFF[Florin]^000000<INFO>lasa_fild02,102,372,000,1,</INFO></NAVI> 报告。";
			erasequest 14592;// Resting Time
			setquest 14588;// The Competition
			close;
		case 14589:
			mes "[Chef]";
		mes "你应该去拉维奥尔森林。请带五个黏稠脚蹼回来。";
			next;
			mes "[Chef]";
		mes "在那里抓十只甜蜜青蛙。它们最近数量增长太多了。";
			next;
			mes "[Chef]";
			mes "拿到黏稠脚蹼后可以带给我，也可以交给 <NAVI>^4D4DFF[Prok]^000000<INFO>lasa_fild02,177,241,000,1,</INFO></NAVI>，他会带来这里。";
			erasequest 14592;// Resting Time
			setquest 14589;// Sticky ingredient
			close;
		case 14590:
			mes "[Chef]";
		mes "仔细听，这是最重要的请求。";
			next;
			mes "[Chef]";
		mes "请让猎人沙漠狼远离我的串线。抓十只狼后，它们就不会再袭击我的串线。";
			next;
			mes "[Chef]";
		mes "完成后可以来找我，也可以向在拉维奥尔森林晒鱼的 <NAVI>^4D4DFF[渔夫]^000000<INFO>lasa_fild02,326,170,000,1,</INFO></NAVI> 报告。";
			erasequest 14592;// Resting Time
			setquest 14590;// Hunter's destination
			close;
		case 14591:
			mes "[Chef]";
		mes "很好。刚接到一份鱼糕订单。";
			next;
			mes "[Chef]";
		mes "我们很少收到这道菜的订单，所以突然有这么多请求很奇怪。终于传出它很好吃的消息了吗？";
			next;
			mes "[Chef]";
		mes "总之我们分秒必争，但那个瞌睡鬼可能又睡着了。冒险者，希望你能再次帮忙。";
			next;
			mes "[Chef]";
			mes "请带五个蘑菇孢子，并抓十只变异孢子。";
			next;
			mes "[Chef]";
			mes "完成后可以来找我，也可以向在森林里打瞌睡的 <NAVI>^4D4DFF[瞌睡喵]^000000<INFO>lasa_fild02,331,251,000,1,</INFO></NAVI> 报告。";
			erasequest 14592;// Resting Time
			setquest 14591;// Secret Ingredient
			close;
		}
	}
	end;

OnInit:
	questinfo( QTYPE_QUEST, QMARK_YELLOW,
		"BaseLevel >= 6 && BaseLevel <= 19 && !isbegin_quest(14546) && !isbegin_quest(14592) && !isbegin_quest(14588) && !isbegin_quest(14589) && !isbegin_quest(14590)" );
	end;
}

lasagna,85,93,5	script	Shaman meow#dorcon	4_DR_KID_01,{
	if (conch_in_boatswain == 1) {
		mes "[Shaman meow]";
		mes "今天不会无聊了？不知道谁会来拜访。是谁呢？";
		npctalk "喵喵", "", bc_self;
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "有人在吗？";
		next;
		mes "[Shaman meow]";
		mes "啊！你来了。进来吧。这是奇迹老奶奶的魔法之地，是一座神龛。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "老奶奶？她看起来不像。倒像是非常……年轻的多拉姆。";
		next;
		mes "[Shaman meow]";
		mes "不是我！";
		npctalk "喵喵", "", bc_self;
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "还有谁？";
		next;
		mes "[Shaman meow]";
		mes "奶奶听到会伤心的。这个世界充满了存在却无法看见的事物。比如，我们谈谈你的情况吧。";
		next;
		mes "[Shaman meow]";
		mes "发现新世界之前，我们多拉姆以为拉扎格纳就是世界尽头。新世界看不见，生活在那里无数的人也看不见。";
		next;
		mes "[Shaman meow]";
		mes "但新世界和人类不是确实存在吗？";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "我明白你的意思。";
		next;
		mes "[Shaman meow]";
		mes "那么是什么把你带到这里？";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "有个人在受苦，我是为他而来。";
		next;
		mes "[Shaman meow]";
		mes "是什么痛苦？如果奶奶和我能处理，我们会帮忙。不能对受苦的人置之不理。";
		npctalk "喵喵", "", bc_self;
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "他不愿承认，但我认为他被恶灵附身了。他在无人岛上打开了封印的罐子。";
		next;
		mes "[Shaman meow]";
		mes "天啊。谁能想到又有一个像^0000cd康琪莉娜船长^000000一样的笨蛋。";
		npctalk "喵喵", "", bc_self;
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "呃，那位船长就是请我帮忙的人。";
		next;
		emotion ET_HUK;
		mes "[Shaman meow]";
		mes "确实，谁会做这种蠢事？我帮不了他，请离开。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "真的没有办法帮助他吗？";
		next;
		mes "[Shaman meow]";
		mes "恶灵通常会吸收宿主的能量，试图占据宿主，宿主死后才离开。但不知为何，它们无法完全占据宿主的身体。";
		next;
		mes "[Shaman meow]";
		mes "所以它们会转移到附近的另一个人身上。因此宿主死亡时，萨满会把它们封在罐子里，丢到无人能找到的地方。";
		next;
		mes "[Shaman meow]";
		mes "但如果有人打开罐子，恶灵就会附着在那个笨蛋身上，重复同样的过程。宿主死亡前无法将它们分离。换句话说，没有能让船长高兴的解决办法。";
		npctalk "喵喵", "", bc_self;
		next;
		mes "[Shaman meow]";
		mes "我说‘新地方来的高尚之人会解决问题’，意思是问题会转移到^0000cd新的人^000000身上。看来他误解了我的意思，所以派你来了。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "那、那你也……";
		next;
		mes "[Shaman meow]";
		mes "是我打开了罐子。那是一次不幸的意外。";
		npctalk "喵喵喵喵喵喵！！！", "", bc_self;
		next;
		mes "[Shaman meow]";
		mes "我、我不是说讨厌奶奶。是，是，我会小心的。";
		next;
		mes "[Shaman meow]";
		mes "总之，船长没有选择。要么余生受折磨，要么成为萨满猫，过得稍微舒服些。萨满猫的生活也没那么糟。";
		next;
		mes "[Shaman meow]";
		mes "知识越丰富，选择就越多。";
		npctalk "喵喵。", "", bc_self;
		next;
		mes "[Shaman meow]";
		mes "如果他不成为萨满猫，就必须每天^000cd依靠新的护符^000000生活。但如果选择成为萨满猫，就告诉他来见我。";
		next;
		mes "[Shaman meow]";
		mes "不过成为萨满猫在许多方面更好。恶灵会不断削弱他，试图占据他的身体。";
		next;
		mes "[Shaman meow]";
		mes "我听说船长过去曾和甘贝里船长一起拜访过前任萨满猫。但他在解释中途冲了出去，再也没回来。";
		next;
		mes "[Shaman meow]";
		mes "他受了这么多苦，现在应该在数自己的日子了。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "其实不是。他看起来精力非常充沛。";
		next;
		mes "[Shaman meow]";
		mes "看来不是所有人都有资格成为康琪莉娜船长。他是怎么活到现在的？";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "嗯……他似乎靠一个又一个迷信活着，比如娃娃和盐。";
		next;
		mes "[Shaman meow]";
		mes "天啊，他真是个笨蛋。如果早点来找我，我会告诉他一条不那么痛苦的路。";
		npctalk "喵喵。", "", bc_self;
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "无论如何，如果他每天都必须依靠新的护符，今天的护符是什么？我想船长需要时间考虑，所以在那之前他需要护符。";
		next;
		mes "[Shaman meow]";
		mes "今天的护符……让我看看。";
		npctalk "喵喵。", "", bc_self;
		next;
		mes "[Shaman meow]";
		mes "哦，那个？真的吗？哦，太糟糕了……真是的，怎么会……呃。";
		npctalk "喵喵。", "", bc_self;
		next;
		mes "[Shaman meow]";
		mes "今天的护符是^0000cd20 株罗勒和 5 个罗勒花苞^000000。把它们牢牢绑好带在身上，这样他今天就安全了。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "罗勒和罗勒花苞？";
		next;
		mes "[Shaman meow]";
		mes "它们都来自肮脏的^0000cd巴西利斯克^000000。巴西利斯克从活了两千多年的伊穆克大人那里获得能量，所以恶灵甚至无法靠近它们的一小块。";
		next;
		mes "[Shaman meow]";
		mes "不过它们真的太脏了。我敢说船长会请你帮忙，因为他不想亲手抓。";
		npctalk "喵喵。", "", bc_self;
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "好，我会告诉他。";
		next;
		mes "[Shaman meow]";
		mes "那我们很快再见。";
		npctalk "喵喵。", "", bc_self;
		erasequest 14556;// There also is a scary thing for me
		setquest 14557;// Truth is alway harsh
		conch_in_boatswain = 2;
		close;
	}
	if (conch_in_boatswain == 2) {
		mes "[Shaman meow]";
		mes "务必把我的话带给船长。今天的护符是 20 株罗勒和 5 个罗勒花苞。";
		close;
	}
	if (conch_in_boatswain == 4) {
		switch( checkquest(14559,PLAYTIME) ) {
		case -1:
			mes "[Shaman meow]";
			if (isbegin_quest(14560) == 1)
			mes "今天的护符是^0000cd5 个罗勒花苞和 1 瓶圣水^000000。在新世界，圣水能驱除恶灵。船长接触新世界的人时一定起了作用。";
			else if (isbegin_quest(14561) == 1) {
			mes "今天的护符是^0000cd20 个罗勒花苞^000000。今天你的手会很脏。抱歉，但这是奶奶的决定。";
				next;
				mes "[Shaman meow]";
			mes "附着在船长身上的东西也是多拉姆。它尤其讨厌罗勒花苞，所以才使用罗勒花苞。";
			}
			else
			mes "今天的护符是^0000cd20 株罗勒和 5 个罗勒花苞^000000。和第一次一样。最基础的往往最有用。";
			next;
			mes "[Shaman meow]";
			mes "我祈祷你平安。告诉船长，改变主意后随时回来。";
			close;
		case 0:
		case 1:
			break;
		case 2:
			mes "[Shaman meow]";
		mes "一定是船长派你来的。我来告诉你今天能保你平安的护符。";
			next;
			mes "[Shaman meow]";
			mes "在哪里……是的，没错……今天是那个？明白了。";
			npctalk "喵喵", "", bc_self;
			next;
			mes "[Shaman meow]";
		mes "今天的护符是……";
			next;
			specialeffect EF_HITLINE;
			mes "[Shaman meow]";
			.@quest_id = rand(14560,14562);
			switch( .@quest_id ) {
			case 14560:
				mes "^0000cd5个罗勒花束和1瓶圣水^000000。在新世界，圣水可以驱赶恶灵。船长接触新世界的人们时，它一定发挥了作用。";
				break;
			case 14561:
				mes "^0000cd20个罗勒花束^000000。今天你的手会弄得很脏，抱歉。但奶奶已经发话了，事情就这样定了。";
				next;
				mes "[Shaman meow]";
			mes "附着在船长身上的东西也是多拉姆。它尤其讨厌罗勒花苞，所以才使用罗勒花苞。";
				break;
			case 14562:
				mes "^0000cd20个罗勒和5个罗勒花束^000000。和第一份一样，最基本的东西最有用。";
				break;
			}
			next;
			mes "[Shaman meow]";
		mes "我祈祷你平安。告诉船长，改变主意后随时回来。";
			erasequest 14559;// Charm Effect Duration
			setquest .@quest_id;
			close;
		}
	}
	mes "[Shaman meow]";
		mes "你想知道未来？过去？如果知道自己站在哪里，就能看见过去、未来和一切。";
	next;
	mes "[Shaman meow]";
		mes "如果你想诅咒某人、解除诅咒，或需要一点运气，就来找我。";
	close;
}

lasagna,174,160,3	script	Vigilante Guide#lasa	4_DR_SOLDIER,5,5,{
	mes "[Vigilante Guide]";
		mes "你好。今天天气很好，对吧？";
		mes "我能为你做什么？";
	next;
	switch( select( "Talk about the weather.", "Ask about the Vigilante.", "Ask about Lasagna.", "End dialogue." ) ) {
	case 1:
		mes "[Vigilante Guide]";
		mes "在拉扎格纳，清新的海风总会拂过你的胡须。多亏湿润的空气，我们的奶酪才能美味成熟。";
		close;
	case 2:
		if (lasagna_quest[1] < 2) {
			if (lasagna_quest[1] == 0) {
				mes "[Vigilante Guide]";
			mes "哦！你还没见过我们的首领吗？";
				next;
			}
			mes "[Vigilante Guide]";
			mes "嗯……我觉得你最好先去见首领。";
			next;
			mes "[Vigilante Guide]";
			mes "他现在应该在冒险者俱乐部……俱乐部就在这里东边，不难找。";
			if (isbegin_quest(11435) == 0)
				setquest 11435;// Vigilante Corp
			navigateto "lasagna",235,198, NAV_KAFRA_ONLY, 0;
			lasagna_quest[1] = 1;
			close;
		}
		mes "[Vigilante Guide]";
		mes "治安队不仅维护城镇秩序，也在城镇管理中发挥主要作用。也许我们的首领应该被称为市长。";
		close;
	case 3:
		mes "[Vigilante Guide]";
		mes "拉扎格纳是位于远星大陆尽头的港口城镇。这里虽小却很繁荣，多亏佩佩罗奇诺首领、甘贝里船长和番茄船长的努力！";
		close;
	case 4:
		mes "[Vigilante Guide]";
		mes "再见。";
		close;
	}
OnTouch:
	npctalk "治安队向导：欢迎来到港口城镇拉扎格纳。", "", bc_self;
	npctalk "治安队向导：如果需要帮助，请随时访问治安队。", "", bc_self;
	end;
OnInit:
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "!isbegin_quest(11435)" );
	end;
}
lasagna,202,291,3	duplicate(Vigilante Guide#lasa)	Vigilante Guide#lasa2	4_DR_SOLDIER,5,5

lasagna,233,197,5	script	Vigilante Olio#lasa	4_DR_OLIO,{
	if (lasagna_quest[1] == 0) {
		mes "哟！嘿！";
		close;
	}
	if (lasagna_quest[1] == 1) {
		mes "[Vigilante Olio]";
		mes "他就是佩佩罗奇诺首领，治安队的老大！";
		close;
	}
	if (lasagna_quest[1] == 2) {
		if (checkweight(1001,1) == 0) {
			mes "- Hold on a second here!! -";
			mes "- 你携带的物品太多。-";
			mes "- 因此无法再领取物品。-";
			mes "- Free up some space -";
			mes "- and try again. -";
			close;
		}
		mes "[Vigilante Olio]";
		mes "哟！需要什么尽管说！我会尽力帮你！";
		next;
		select("Ask about the Vigilante.");
		mes "[Vigilante Olio]";
		mes "让我告诉你一些治安队的事！可以说我们在城镇中扮演关键角色！所有年轻多拉姆也都想加入我们！";
		next;
		mes "[Vigilante Olio]";
		mes "治安队成立时间不长，但我们出现前拉扎格纳还是衰败的城镇。多亏我们，这里如今才繁荣起来！";
		next;

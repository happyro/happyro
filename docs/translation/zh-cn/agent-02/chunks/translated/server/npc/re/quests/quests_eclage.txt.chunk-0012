		mes "[克鲁扬]";
		mes "我离开繁花之地时，";
		mes "看见我女朋友父亲的朋友";
		mes "匆匆赶往某处。";
		next;
		mes "[克鲁扬]";
		mes "然后我回到城里去见女朋友。";
		next;
		select("你能证明自己的不在场证明吗？");
		mes "[克鲁扬]";
		mes "当然。";
		mes "我在那里猎杀怪物得到的战利品就是这瓶集中药水。";
		mes "看，现在能证明了吗？";
		next;
		mes "[克鲁扬]";
		mes "看你工作很努力，我就把猎杀得到的这瓶集中药水送给你吧～";
		next;
		mes "[克鲁扬]";
		mes "这些问题就结束了，对吧？";
		mes "我一定会找到那条项链，你大概不用再担心了。";
		next;
		mes "- 如果去繁花之地猎杀这些怪物，就能确认是否真的能获得这件物品。-";
		getitem 645,1;// Center_Potion
		changequest 9231,9232;
		setquest 9259;
		ep14_2_detect = 6;
		close;
	}
	if (ep14_2_detect == 13) {
		if (!checkweight(607,1)) {
		mes "- 再次交谈前，";
		mes "必须先减轻负重。-";
			close;
		}
		mes "[克鲁扬]";
		mes "说实话，我为这件事责怪过你很多次。";
		mes "如果成功了，本来可能成为赢得母亲信任的机会……";
		next;
		mes "[克鲁扬]";
		mes "但是……";
		mes "当我坦白一切后，";
		mes "我为自己一开始";
		mes "竟然想过那种事";
		mes "感到非常羞愧……";
		next;
		mes "[克鲁扬]";
		mes "谢谢你……";
		mes "我也听说你";
		mes "找到了项链……";
		mes "我在很多方面";
		mes "都欠你人情……";
		next;
		mes "[克鲁扬]";
		mes "今后我不会再依赖这些愚蠢的计谋。";
		mes "我会直面露恩的母亲，尽我所能。";
		next;
		mes "[克鲁扬]";
		mes "请收下这个，表达我的谢意。";
		mes "谢谢你！";
		ep14_2_detect = 14;
		changequest 9239,9262;
		getitem 608,1;// Seed_Of_Yggdrasil
		getexp 300000,150000;
		close;
	}
	mes "[克鲁扬]";
	if (ep14_2_detect == 3) {
		mes "我无论如何都会找到那条项链，";
		mes "并把它带给母亲。";
	}
	else if (ep14_2_detect == 4) {
		mes "我无论如何都会找到那条项链，";
		mes "并把它带给母亲。";
	}
	else if (ep14_2_detect == 6) {
		mes "这些问题就结束了，对吧？";
		mes "我会找到那条项链，你大概不用再担心了。";
	}
	else if (ep14_2_detect >= 7 && ep14_2_detect <= 9)
		mes "我会找到那条项链，你大概不用再担心了。";
	else {
		mes "今后我不会再依赖这些愚蠢的计谋。";
		mes "我会直面露恩的母亲，尽我所能。";
	}
	close;
}

ecl_fild01,98,299,5	script	Balumin#eclage	4_M_FAIRYSOLDIER2,{
	if (ep14_2_detect < 1 || (ep14_2_detect >= 10 && ep14_2_detect <= 13)) end;
	if (ep14_2_detect == 14) {
		if (checkweight(607,5) == 0) {
			mes "["+ strcharinfo(0) +"]";
			mes "- 我必须减轻";
			mes "再次交谈前必须先减轻负重。-";
			close;
		}
			mes "[巴鲁明]";
			mes "我听完了整个故事，但没想到会发生这种事。";
		next;
			mes "[巴鲁明]";
			mes "作为朋友，";
			mes "我觉得自己很糟糕，";
			mes "因为我带来的";
			mes "麻烦比帮助更多。";
		next;
			mes "[巴鲁明]";
			mes "我知道你在解决";
			mes "这起事件时";
			mes "起了很大作用。";
		next;
			mes "[巴鲁明]";
			mes "虽然不多，但这是我猎杀怪物时得到的战利品。";
			mes "请至少收下这个。";
		next;
			mes "[巴鲁明]";
			mes "希望你的未来";
			mes "充满";
			mes "祝福。";
		ep14_2_detect = 15;
		completequest 9262;
		getitem 6558,20;// Pile_Of_Acorn
		getexp 300000,150000;
		close;
	}
	if (ep14_2_detect == 6) {
		if (isbegin_quest(9232) != 1 || checkquest(9259,HUNTING) < 1) end;
		if (checkquest(9259,HUNTING) == 1) {
			mes "抱歉，";
			mes "我现在有点忙。";
			mes "我正在猎杀怪物……";
			mes "看来你也正在猎杀……";
			mes "等你完成后";
			mes "再来找我。";
		}
		else {
			mes "你是谁？";
			next;
			select("我是来调查抢劫事件的。" );
			mes "[巴鲁明]";
			mes "糟糕！发生过这种事吗？";
			mes "这一定给我的朋友带来了很大麻烦……";
			next;
			mes "["+ strcharinfo(0) +"]";
			mes "我负责协助抓捕抢劫犯。";
			mes "我有几个问题想问，希望你能配合。";
			next;
			select("你今天做了什么？" );
			mes "[巴鲁明]";
			mes "我一整天";
			mes "都在这里。";
			mes "靠猎杀怪物";
			mes "赚了些钱。";
			next;
			mes "[巴鲁明]";
			mes "今天早些时候，我和朋友见面，";
			mes "聊了很多事情。";
			next;
			select("你见过一个叫克鲁扬的人吗？" );
			mes "[巴鲁明]";
			mes "嗯，我一整天";
			mes "都在这里，但除了";
			mes "我的朋友戴姆斯，";
			mes "谁也没见到。";
			next;
			mes "[Balumin]";
			mes "我只看到了繁花之地和怪物。";
			next;
			select("怪物会掉落集中药水吗……" );
			mes "[巴鲁明]";
			mes "我不认为这是";
			mes "能从这里的怪物";
			mes "身上获得的东西。";
			mes "这一点我很确定。";
			next;
			mes "[Balumin]";
		mes "那似乎是可以从商人那里购买的东西……";
		mes "我觉得不是普通商人卖的……";
			next;
			mes "[Balumin]";
		mes "总之，我朋友那里发生了这么严重的事件，希望你能抓住那个抢劫犯。";
			completequest 9259;
			changequest 9232,9233;
			ep14_2_detect = 7;
		}
		close;
	}
	mes "[Balumin]";
	if (ep14_2_detect <= 5) {
		mes "抱歉，";
		mes "我现在有点忙。";
		mes "我正在猎杀怪物……";
		mes "之后再来找我。";
	}
	else if (ep14_2_detect >= 7 && ep14_2_detect <= 9)
		mes "我朋友那里发生了这么严重的事件，希望你能抓住那个抢劫犯。";
	else {
		mes "希望你的";
		mes "未来充满";
		mes "祝福。";
	}
	close;
}

eclage,222,131,3	script	Wandering Merchant#ecl	1_M_SIGNMCNT,{
	if (ep14_2_detect >= 1 && ep14_2_detect <= 6) {
		mes "- 走近后，";
		mes "我闻到一股";
		mes "可怕的酒味。-";
	}
	else if (ep14_2_detect == 7) {
		// if (isbegin_quest(9248) != 1) end;
		if (isbegin_quest(9258) != 1) end;
		mes "- Upon getting closer,";
		mes "我闻到一股";
		mes "可怕的酒味。-";
		next;
		mes "[流浪商人]";
		mes "商品都在这里～没有";
		mes "我没有的东西～上来看看～";
		mes "我什么都有～";
		mes "嗝～……";
		mes "这里大甩卖～";
		mes "找到你需要的～买下来～";
		next;
		select("你卖什么？");
		mes "[流浪商人]";
		mes "嘘～！！";
		mes "你一定是第一次来。";
		mes "我可不是什么都卖～";
		mes "只要一次性投资 Zeny，终极礼物就会 VOILA～！送到你手上～！";
		next;
		mes "[流浪商人]";
		mes "你觉得怎么样～！感兴趣吗？";
		mes "只要10000 Zeny，";
		mes "就可以试试～！";
		mes "嗝～……";
		next;
		select("你有什么可卖的？");
		mes "[流浪商人]";
		mes "嗯～～让我看看。";
		mes "是的～这瓶集中药水也是抽奖奖励之一～";
		next;
		mes "[流浪商人]";
		mes "虽然它属于‘废奖品’～！";
		mes "真正的奖励有^006400魔法卡册、旧卡册、紫罗兰之惧、妖精耳朵^000000～只要10000 Zeny！！";
		next;
		mes "[流浪商人]";
		mes "你觉得怎么样～！想试试吗？";
		mes "嗝～……";
		next;
		switch( select("试试看。：不试。") ) {
		case 1:
			setarray .@menu$[1], "Magic Card Album! Whoaaa!:Is this some kind of fraud? Huh?", "Yes.:Is this some kind of fraud?";
			while (1) {
				disable_items;
				mes "[Wandering Merchant]";
				if (checkweight(607,2) == 0) {
					mes "你携带的物品太多。";
					mes "请减少携带物品，";
					mes "之后再回来，";
					mes "现在就去整理吧～！";
					close;
				}
				if (Zeny < 10000) {
					mes "你的 Zeny 不足，无法参加抽奖～";
					mes "只需要10000 Zeny～";
					mes "你只需要10000 Zeny～";
					close;
				}
				progressbar "0xFFFF00",3;
				specialeffect2 EF_ENHANCE;
				Zeny = Zeny - 10000;
				if (rand(1,10) < 5)
					.@amount = 1;
				else
					.@amount = 2;
				getitem 645,.@amount;// Center_Potion
				mes "哦～～真遗憾～你获得了";
				mes .@amount +" ^006400Concentration Potion^000000";
				mes "~~";
				enable_items;
				next;
				mes "[流浪商人]";
				mes "再努力一点，说不定就能";
				mes "得到^006400卡册^000000之类的东西。";
				mes "……";
				mes "想再试一次吗？";
				next;
				if (select( .@menu$[.@amount] ) == 2) {
					mes "[流浪商人]";
					mes "骗子！！！你怎么敢！嗝～……";
					mes "真烦……";
					mes "我今天什么都不卖！！";
					mes "走开好吗～～嘘嘘～！！";
					changequest 9233,9234;
					setquest 9260;
					ep14_2_detect = 8;
					close;
				}
			}
		case 2:
			mes "[流浪商人]";
			mes "随便啦～";
			mes "嗝～……";
			close;
		}
	}
	mes "[流浪商人]";
	if (ep14_2_detect < 1)
		mes "走开，小鬼们～";
	else if (ep14_2_detect == 8) {
		mes "骗子！！！你怎么敢！嗝～……";
		mes "真烦……";
		mes "我今天什么都不卖！！";
		mes "走开好吗～～嘘嘘～！！";
	}
	else if (ep14_2_detect == 9) {
		mes "真烦……";
		mes "我今天什么都不卖！！";
		mes "走开好吗～～嘘嘘～！！";
	}
	else {
		mes "至少谢谢你";
		mes "帮我摆脱了";
		mes "嫌疑，好吗～～？";
		next;
		mes "[流浪商人]";
		mes "……";
		mes "我说了谢谢～～";
		next;
		mes "[流浪商人]";
		mes "谢谢，好吗？";
		mes "我说完了～没什么给你的～再见～";
	}
	close;
}


		mes "哦，冒险者？欢迎来到莱茵哈特上城区。";
		mes "不过恐怕这里没什么刺激的东西。";
		next;
		mes "[Digotz]";
		mes "不是想冒犯你，但这座城镇足够安全。";
		mes "你看起来似乎还是冒险新手……";
		close;
	}
	if (friendship > 14) {
		cutin "lhz_diguts05.bmp",2;
		mes "^3355FFDigotz 已经去世，但脸上的表情十分平静满足。^000000";
		close3;
	}
	if (friendship == 14) {
		mes "^3355FFDigotz 身受重伤，一把刀仍插在他的腹部。^000000";
		next;
		mes "["+ strcharinfo(0) +"]";
		mes "Digotz……？";
		mes "不好！让我找人帮你！";
		next;
		cutin "lhz_diguts04.bmp",2;
		mes "[Digotz]";
		mes "嘿……是那位冒险者……";
		mes "唉，那个 Maku 总给我带来坏运气……";
		mes "我已经没救了，时间不多了……";
		next;
		mes "[Digotz]";
		mes "我告诉过你的那些守卫……不想让穷人和富人来往的守卫？";
		mes "我想他们发现我要去见老朋友了。我只是想见他……";
		next;
		mes "[Digotz]";
		mes "那个穿黑衣服的家伙……他……他刺伤了我！";
		mes "我们已经很久没说话了。本想像过去一样一起玩乐。";
		next;
		cutin "lhz_diguts05.bmp",2;
		mes "[Digotz]";
		mes "我想念我的朋友们，但现在……我能听见他们在呼唤我。";
		mes "现在我们终于能像约定的那样团聚了。是啊……";
		mes "我错了，人生苦短，不该和朋友生气——";
		next;
		mes "[Digotz]";
		mes "..............";
		next;
		mes "[Digotz]";
		mes "..............";
		mes ".......................";
		next;
		mes "[Digotz]";
		mes "..............";
		mes ".......................";
		mes "...............................";
		next;
		mes "^3355FFDigotz 停止了呼吸。";
		mes "你从他失去生命的身体中拔出刀，作为对这位深爱朋友之人的最后礼节。^000000";
		next;
		set friendship,15;
		changequest 12005,12006;
		getitem 1201,1; //Knife
		cutin "",255;
		close;
	}
	if (friendship == 13) {
		cutin "lhz_diguts08.bmp",2;
		mes "[Digotz]";
		mes "哇，我得准备一下！如果看起来太富有娇气，Maku 会嘲笑我的。";
		mes "该死！我把时髦的街头服装放哪了？";
		close3;
	}
	if (friendship == 12 && countitem(7351) > 0) {
		cutin "lhz_diguts08.bmp",2;
		mes "[Digotz]";
		mes "即使 Benkaistein 回来了，我也不觉得能原谅 Maku。";
		mes "事实上，我可能会更加生气！";
		next;
		if (select("展示 Benkaistein 的日记。:不展示 Benkaistein 的日记。") == 1) {
			cutin "",255;
			mes "[Digotz]";
			mes "我为什么这么生气？";
			mes "^3355FF*叹气*^000000 你有东西给我看？";
			mes "嗯？Benkaistein 想让我读他的日记？";
			mes "好啊，为什么不呢？这些年我欠他很多……";
			next;
			mes "[Benkaistein's Journal]";
			mes "^856363今天，我、Digotz 和 Maku 玩了疯狂的飞行游戏。";
			mes "我们用木头和纸做翅膀，从山坡跳下尝试飞行。很蠢，我知道。^000000";
			next;
			mes "[Benkaistein's Journal]";
			mes "^856363今天轮到我用这些粗制滥造的假翅膀跳下去挥臂。";
			mes "现在想想，这游戏一点也不好玩。希望别再来一次。^000000";
			next;
			cutin "lhz_diguts02.bmp",2;
			mes "[Digotz]";
			mes "哦，我记得！Maku 大多时候穿着翅膀，";
			mes "但我保持着最长滞空记录！我可是小飞马~";
			next;
			cutin "",255;
			mes "[Benkaistein's Journal]";
			mes "^856363Maku、Digotz 和我去了城外。";
			mes "当然没告诉任何人，否则会惹麻烦。那天很刺激，但我们遇到了怪物！^000000";
			next;
			mes "[Benkaistein's Journal]";
			mes "^856363我想逃跑，但 Maku 和 Digotz 想打败它成为英雄。";
			mes "当然我们伤得很重，怪物也逃走了。妈妈非常不高兴……^000000";
			next;
			cutin "lhz_diguts03.bmp",2;
			mes "[Digotz]";
			mes "嗯，我不太记得了。但我知道那时我们三个什么都不怕。";
			mes "不过敢和怪物战斗，我们一定疯了。";
			next;
			cutin "",255;
			mes "[Benkaistein's Journal]";
			mes "^856363Digotz 已经病了三天。只是普通感冒，Maku 却一直说是 Digotz 害他生病。^FFFFFF ^856363";
			mes "但他总让我去探望 Digotz，看看他是否安好。^000000";
			next;
			cutin "lhz_diguts01.bmp",2;
			mes "[Digotz]";
			mes "我好像记得自己病得很重。Maku 很担心？";
			mes "我……我一定是得了可怕的致命疾病，比如淋病。";
			mes "可能就是那样。";
			next;
			cutin "",255;
			mes "[Benkaistein's Journal]";
			mes "^856363爸爸妈妈一直叫我别再和 Maku 玩。";
			mes "理由很可笑，我不在乎他是否贫穷。";
			mes "他是我认识过的最好的人之一。^000000";
			next;
			mes "[Benkaistein's Journal]";
			mes "^856363Digotz 家很有钱，也不想让他再见 Maku。";
			mes "但 Digotz 不在乎。我知道他很喜欢 Maku。^000000";
			next;
			cutin "lhz_diguts07.bmp",2;
			mes "[Digotz]";
			mes "那时我们更年轻、更亲密，所以……^333333*咳！*^000000";
			mes "Benkaistein 为什么要写这个？！";
			next;
			cutin "",255;
			mes "[Benkaistein's Journal]";
			mes "^856363今天我们三人结为兄弟，像漫画书里读到的那样。";
			mes "我们发誓无论发生什么都永远是朋友。永远永远。^000000";
			next;
			cutin "lhz_diguts07.bmp",2;
			mes "[Digotz]";
			mes "我……我是被迫立下那个誓言的！人会改变，你知道！";
			mes "我们那时只是孩子，那个誓言现在没意义了，对吧？";
			next;
			cutin "",255;
			set friendship,13;
			mes "[Digotz]";
			mes "就这样。我去见 Maku。不是想念他，只是要让他取消那个誓言。";
			mes "也许还会揍他一顿。";
			close;
		}
		mes "[Digotz]";
		mes "我不明白自己为什么这么生气！";
		mes "我开始变得更像 Maku 了，别误会，我才不在乎那家伙。";
		close3;
	}
	if (friendship == 7) {
		cutin "lhz_diguts03.bmp",2;
		mes "[Digotz]";
		mes "即使 Benkaistein 从求学之地回来，我也不认为他能让 Maku 向我道歉。";
		mes "那家伙固执得过头了！";
		close3;
	}
	if (friendship == 6) {
		cutin "lhz_diguts01.bmp",2;
		mes "[Digotz]";
		mes "哦，好久不见。你回来这里做什么？";
		mes "呃，你把口信交给 Maku 了吗？现在想想，我有点——";
		next;
		mes "["+ strcharinfo(0) +"]";
		mes "我一字不漏地转达了你的口信，Maku 很生气，骂了你，还威胁要狠狠揍你。";
		next;
		cutin "lhz_diguts08.bmp",2;
		mes "[Digotz]";
		mes "那个没用、肮脏、满口谎言的混蛋！";
		mes "要不是有那些守卫，我就去贫民窟亲自揍 Maku！那个蠢货！";
		next;
		cutin "lhz_diguts03.bmp",2;
		mes "[Digotz]";
		mes "这种时候，我真的很想念 ^FF0000Benkaistein^000000。";
		mes "那家伙总能解决这种情况。";
		mes "我想他正在某个遥远的城镇学习。";
		next;
		mes "[Digotz]";
		mes "听说那地方有大量书籍可供他使用，叫什么来着。";
		mes "总之，Benkaistein 总是充当调解人……";
		next;
		mes "[Digotz]";
		mes "以前我、他和 Maku 一起玩时，只要发生争吵，Benkaistein 就会调解。";
		mes "不过现在他也帮不了 Maku……";
		set friendship,7;
		changequest 12002,12003;
		next;
		cutin "",255;
		mes "[Digotz]";
		mes "我不知道为什么，但我好生气！";
		mes "我为什么要为这事如此烦恼？！";
		close;
	}
	if (friendship == 4 || friendship == 5) {
		cutin "lhz_diguts01.bmp",2;
		mes "[Digotz]";
		mes "还在参观莱茵哈特上城区？我才不在乎。";
		mes "不过如果你碰巧见到 Maku，请替我逐句转达这段话。";
		next;
		mes "[Digotz]";
		mes "^FF0000无可救药的混蛋！";
		mes "^FF0000你还是个顽固的蠢货！";
		mes "^FF0000你至少欠我三顿午饭！";
		mes "^FF0000更别提道歉了！";
		mes "^FF0000谁在乎你的想法？！";
		mes "没有你我开心极了！^000000";
		close3;
	}
	if (friendship == 3) {
		cutin "lhz_diguts01.bmp",2;
		mes "[Digotz]";
		mes "我知道上城区的奢华很吸引人，但相信我，这里毫无色彩。";
		mes "你去过贫民区吗？";
		next;
		select("是的，我已经去过了……");
		mes "["+ strcharinfo(0) +"]";
		mes "是的，我已经去过了……在那里遇到了一个叫 Maku 的人。";
		next;
		mes "[Digotz]";
		mes "Maku？！他一定提到了我。";
		mes "但除非他为自己的混蛋行为道歉，否则我不在乎他说什么。";
		mes "从我们小时候起就这样……";
		cutin "",255;
		next;
		cutin "lhz_diguts08.bmp",2;
		mes "[Digotz]";
		mes "总之，我们以前很亲密，但那家伙从来不是真正的朋友！";
		mes "比如他作弊赢了掰手腕，或者我请他吃午饭却从不道谢！";
		next;
		mes "[Digotz]";
		mes "好吧，他确实帮我认识了初恋女友，";
		mes "但我永远不会原谅他安排那些最糟糕的相亲！";
		next;
		cutin "lhz_diguts01.bmp",2;
		mes "[Digotz]";
		mes "Maku 根本不懂友情！即使我想见他，也有人不愿让富人和穷人见面。";
		next;
		mes "[Digotz]";
		mes "只要 Maku 没事，我听到这个就够了！我没必要大老远去确认他。";
		mes "不过我只有一个遗憾……";
		next;
		cutin "lhz_diguts07.bmp",2;
		mes "[Digotz]";
		mes "我只希望最后再见 Maku 一面……这样我就能亲自踢他的屁股！";
		mes "没错，那个傲慢的混蛋！但我做不到……";
		next;
		mes "[Digotz]";
		mes "这里的守卫绝不会让富人和穷人见面，担心穷人扰乱城市的和平秩序。";
		mes "这是为愚蠢之人制定的愚蠢规则。";
		next;
		mes "[Digotz]";
		mes "不过，违反这种愚蠢禁忌竟会受罚，确实很可怕。";
		mes "总之，如果你再见到 Maku，替我告诉他这些，明白吗？";
		next;
		mes "[Digotz]";
		mes "^FF0000无可救药的混蛋！";
		mes "^FF0000你还是个顽固的蠢货！";
		mes "^FF0000你至少欠我三顿午饭！";
		mes "^FF0000更别提道歉了！";
		mes "^FF0000谁在乎你的想法？！没有你我开心极了！^000000";
		set friendship,4;
		close3;
	}
	if (friendship == 2) {
		cutin "lhz_diguts01.bmp",2;
		mes "[Digotz]";
		mes "你还在这里闲逛做什么？上城区没什么有趣的东西可看，冒险者。";
		next;
		mes "[Digotz]";
		mes "天啊……！不知为何，光听到 Maku 的事就让我如此难受！";
		close3;
	}
	if (friendship == 1) {
		cutin "lhz_diguts02.bmp",2;
		mes "[Digotz]";
		mes "哦，冒险者？欢迎来到莱茵哈特上城区。";
		mes "不过恐怕这里没什么刺激的东西。";
		next;
		mes "[Digotz]";
		mes "我叫 Digotz，只是莱茵哈特上城区的普通市民。";
		mes "希望你在我的家乡过得愉快。";
		next;
		select("你认识一个叫 Maku 的人吗？");
		cutin "lhz_diguts01.bmp",2;
		mes "[Digotz]";

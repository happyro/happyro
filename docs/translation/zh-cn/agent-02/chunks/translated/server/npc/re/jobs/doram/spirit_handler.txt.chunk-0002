		// npctalk "Cute!!!!", "???#JQ_SH_lee", bc_self;	// bug?
		npctalk "可爱！！！！", "???#JQ_SH_k", bc_self;
		cutin "ex_sh_spirit01.png",2;
		next;
		mes "[Chulho]";
		mes "<FONT SIZE = 14>我才不想要它！</FONT>";
		mes "<FONT SIZE = 14>我只是流口水了！</FONT>";
		cutin "ex_sh_chulho02.png",2;
		next;
		mes "[???]";
		mes "而且，那些东西不能吃！";
		cutin "ex_sh_spirit01.png",2;
		next;
		mes "[Chulho]";
		mes "<FONT SIZE = 18><B>为什么？</B></FONT>";
		cutin "ex_sh_chulho02.png",2;
		emotion ET_HUK, getnpcid(0,"Chulho#JQ_SH_2");
		next;
		mes "[???]";
		mes "最近^dd5555吃了路上掉落的东西而生病的山兽^000000一直来找我，都是因为它们。";
		cutin "ex_sh_spirit02.png",2;
		next;
		mes "[Chulho]";
		mes "<FONT SIZE = 14>奇修尔真好！</FONT>";
		mes "<FONT SIZE = 14>你是在担心肚子疼吗？</FONT>";
		cutin "ex_sh_chulho03.png",2;
		next;
		mes "[Kisul]";
		mes "我来责骂那些喷洒奇怪东西的人，因为它们一直来，实在很<FONT SIZE = 14><B>烦</B></FONT>。";
		cutin "ex_sh_spirit02.png",2;
		emotion ET_HNG, getnpcid(0,"???#JQ_SH_k");
		next;
		mes "[Chulho]";
		mes "...";
		cutin "ex_sh_chulho02.png",2;
		next;
		mes "[Chulho]";
		mes "<FONT SIZE = 18>Good boy!</FONT>";
		cutin "ex_sh_chulho01.png",2;
		npctalk "真好！！！！！！！", "Chulho#JQ_SH_2", bc_self;
		next;
		mes "[Kisul]";
		mes "嘘！";
		mes "看你能听见奔跑声，看来终于发现了。";
		cutin "ex_sh_spirit02.png",2;
		npctalk "真吵。", "???#JQ_SH_k", bc_self;
		next;
		mes "[Chulho]";
		mes "<FONT SIZE = 10>什么？</FONT>";
		cutin "ex_sh_chulho01.png",2;
		next;
		mes "[Kisul]";
		mes "我一直在捉弄你们，好看看那些烦人的老白人的表情。";
		mes "别动。";
		cutin "ex_sh_spirit02.png",2;
		next;
		cutin "",255;
		mes "[???]";
		mes "<FONT SIZE = 16>大人！</FONT>";
		cloakoffnpcself( "???#JQ_SH_lee" );
		npctalk "大人！！！！！", "???#JQ_SH_lee", bc_self;
		next;
		mes "[???]";
		mes "<FONT SIZE = 16>大人！！！</FONT>";
		mes "<FONT SIZE = 16>我们遇到麻烦了！！！</FONT>";
		npctalk "我该拿这个怎么办？", "???#JQ_SH_lee", bc_self;
		emotion ET_HELP, getnpcid(0,"???#JQ_SH_lee");
		next;
		mes "[Admiral Lee Daegam]";
		mes "怎么了？";
		mes "快说明情况。";
		cloakoffnpcself( "Admiral Lee Daegam#JQ_SH_lee" );
		next;
		mes "[Lee Daegam's Subordinate]";
		mes "我把它放进谷仓了……食……食物全没了！";
		next;
		mes "[Admiral Lee Daegam]";
		mes "<FONT SIZE = 14>什么！？</FONT>";
		mes "食物都去哪了！";
		next;
		mes "[Lee Daegam's Subordinate]";
		mes "谷仓门锁得好好的，我一直在院子里，也没人经过。";
		emotion ET_PROFUSELY_SWEAT, getnpcid(0,"???#JQ_SH_lee");
		next;
		mes "[Admiral Lee Daegam]";
		mes "所以你是说食物自己走出去的？！";
		next;
		mes "[Admiral Lee Daegam]";
		mes "嗯……";
		mes "首先叫人悄悄调查谷仓。然后让他们去厨房尽快准备饭菜，因为马上需要食物。";
		npctalk "你不能把事情搞成这样！", "Admiral Lee Daegam#JQ_SH_lee", bc_self;
		next;
		mes "[Admiral Lee Daegam]";
		mes "然后去男宿舍，让他们来见Kwang Saeng。";
		npctalk "别出声，悄悄去。", "Admiral Lee Daegam#JQ_SH_lee", bc_self;
		next;
		mes "[Lee Daegam's Subordinate]";
		mes "是，大人。";
		next;
		cloakonnpcself( "???#JQ_SH_lee" );
		mes "[Admiral Lee Daegam]";
		mes "唉～";
		mes "真是见鬼了！";
		npctalk "你是怎么准备那些食物的！！！", "Admiral Lee Daegam#JQ_SH_lee", bc_self;
		next;
		mes "[Admiral Lee Daegam]";
		mes "<FONT SIZE = 14>我不知道是谁，但要是让我抓到你在我的谷仓偷东西就惨了！！！</FONT>";
		npctalk "我会抓住你的！！！", "Admiral Lee Daegam#JQ_SH_lee", bc_self;
		next;
		mes "[Kwang Saeng]";
		mes "Lee Daegam，你在找我吗？";
		cloakoffnpcself( "Kwang Saeng#JQ_SH_lee" );
		npctalk "哈哈！", "Kwang Saeng#JQ_SH_lee", bc_self;
		next;
		mes "[Admiral Lee Daegam]";
		mes "<FONT SIZE = 16>Aaah~~!</FONT>";
		mes "<FONT SIZE = 16>Kwang Saeng!!!</FONT>";
		mes "你怎么这么快就到了？！";
			npctalk "欢迎。", "Admiral Lee Daegam#JQ_SH_lee", bc_self;
		next;
		mes "[Kwang Saeng]";
		mes "你说急着找我，所以我马上就来了。";
		next;
		mes "[Admiral Lee Daegam]";
		mes "事情不大，但谷仓里有小偷，食物全消失了。";
		next;
		mes "[Kwang Saeng]";
		mes "糟糕！";
		next;
		mes "[Admiral Lee Daegam]";
		mes "所以我们要抓住犯人，但现在必须马上为大家准备新的食物……";
		emotion ET_SCRATCH, getnpcid(0,"Admiral Lee Daegam#JQ_SH_lee");
		next;
		mes "[Kwang Saeng]";
		mes "好吧。";
		mes "我去给你拿些药。";
		next;
		mes "[Kwang Saeng]";
		mes "对了……";
		mes "我是在^123456Lee Daegam^000000的要求下准备药物，但森林的建设不是Lee Daegam自己负责的吗？";
		mes "为什么不让我来处理？";
		next;
		mes "[Admiral Lee Daegam]";
		mes "低价买到好土地需要花功夫。";
		next;
		mes "[Kwang Saeng]";
		mes "哈哈。";
		mes "Lee Daegam。";
		npctalk "哈哈哈哈哈！", "Kwang Saeng#JQ_SH_lee", bc_self;
		next;
		npctalk "哈哈哈哈哈！！！", "Admiral Lee Daegam#JQ_SH_lee", bc_self;
		emotion ET_SMILE, getnpcid(0,"Admiral Lee Daegam#JQ_SH_lee");
		emotion ET_SMILE, getnpcid(0,"Kwang Saeng#JQ_SH_lee");
		sleep2 1000;
		cloakonnpcself( "Admiral Lee Daegam#JQ_SH_lee" );
		cloakonnpcself( "Kwang Saeng#JQ_SH_lee" );
		mes "[Kisul]";
		mes "哦，天啊～";
		mes "刚才那是什么。";
		mes "我还以为有重大原因，结果真无聊。";
		cutin "ex_sh_kisul00.png",2;
		npctalk "真让人失望～", "???#JQ_SH_k", bc_self;
		next;
		mes "[Kisul]";
		mes "既然没兴趣了，我就回家。";
		emotion ET_SLEEPY, getnpcid(0,"???#JQ_SH_k");
		npctalk "真无聊～", "???#JQ_SH_k", bc_self;
		next;
		mes "[Chulho]";
		mes "哦！";
		mes "你不打算阻止我吗？";
		cutin "ex_sh_chulho01.png",2;
		emotion ET_HUK, getnpcid(0,"Chulho#JQ_SH_2");
		next;
		mes "[Kisul]";
		mes "不，算了。";
		mes "他已经骑虎难下了，应该会自己处理吧？";
		cutin "ex_sh_kisul00.png",2;
		next;
		mes "[Kisul]";
		mes "看起来会很有趣。";
		mes "嘿嘿嘿。";
		cutin "ex_sh_kisul00.png",2;
		emotion ET_KIK, getnpcid(0,"???#JQ_SH_k");
		next;
		cloakonnpcself( "???#JQ_SH_k" );
		mes "[Chulho]";
		mes "<FONT SIZE = 14>啊！</FONT>";
		mes "<FONT SIZE = 14>没错！</FONT>";
		mes "<FONT SIZE = 14>我遇到麻烦了！</FONT>";
		cutin "ex_sh_chulho02.png",2;
		npctalk "太疯狂了！！！", "Chulho#JQ_SH_2", bc_self;
		next;
		mes "[Chulho]";
		mes "<FONT SIZE = 14>要是贤禄发现自己给朋友奇怪的药，还在森林里挖东西制作怪物，他就麻烦大了！！</FONT>";

			switch(select("雇用:取消")) {
			case 1:
				if (getgdskilllv(.@GID,10001) == 0) {
					mes "[管家]";
			mes "主人，我们无法雇用一名";
			mes "目前的公会技能等级不够。";
			mes "请先提升相关技能。";

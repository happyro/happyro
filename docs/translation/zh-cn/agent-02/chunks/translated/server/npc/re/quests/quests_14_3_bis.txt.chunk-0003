moro_vol,93,128,1	script	Combat Laphine#line01	4_M_FAIRYSOLDIER2,2,3,{
	.@ttemp = rand(1,5);
	if (.@ttemp == 1)
		npctalk "好啦，好啦~";
	else if (.@ttemp == 2)
		npctalk "小心！";
	else if (.@ttemp == 3)
		npctalk "*哈欠*";
	else if (.@ttemp == 4)
		npctalk "请小心。";
	else
		npctalk "退后——这里很危险！";
	end;

OnTouch:	// prevent the player from triggering the text
	end;
OnTouchNPC:
	.@hidden_name$ = strnpcinfo(2);
	if (.@hidden_name$ == "line01")      kick_mob( "发现敌人！",2000 );
	else if (.@hidden_name$ == "line03") kick_mob( "快、快走开！",2000 );
	else if (.@hidden_name$ == "line05") kick_mob( "你敢！",2000 );
	else if (.@hidden_name$ == "line07") kick_mob( "发现敌人！",2000 );
	end;
}


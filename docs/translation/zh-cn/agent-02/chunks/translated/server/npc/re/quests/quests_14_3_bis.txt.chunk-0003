	next;
	if (select( "我这就去办。", "我稍后再回来。" ) == 2) {
		mes "[Jeruth Hesranta]";
	mes "没问题。";
	mes "有空再回来吧。";
		next;
		mes "[Jeruth Hesranta]";
	mes "抱歉，";
	mes "我总是不断拜托你帮忙。";
		close3;
	}
	mes "[Jeruth Hesranta]";
	mes "就是这种精神！";
	mes "去猎杀暴走魔物箱，收集布拉迪姆。";
	setquest 7579;// Collecting Bradiums
	close3;

OnInit:
/* officially disabled
	questinfo QTYPE_QUEST2, QMARK_NONE, "BaseLevel >= 140 && BaseLevel <= 160";
	// 3650 = [ep13_3_secret]
	SetQuestItem 1 3650 24
*/
	questinfo( QTYPE_QUEST2, QMARK_NONE, "BaseLevel >= 140 && BaseLevel <= 160 && ep13_3_secret > 26 && !isbegin_quest(7579) && !isbegin_quest(7580)" );
	end;
}

// Others
function	script	kick_mob	{
	sleep2 1000;
	npctalk getarg(0);
	specialeffect EF_METEORSTORM;
	sleep2 getarg(1);
	unitwarp 0,"moro_vol",165,165;
	return;
}

moro_vol,88,107,5	script	Magic Scholar Dophe#143vol01	4_F_FAIRYKID5,{
 	mes "[Dophe]";
	mes "原来是人类。";
	mes "看着你，我不禁思考起我们的处境。";
	mes "你和我正在交谈。";
 	next;
 	mes "[Dophe]";
	mes "这个所谓的次元裂缝，魔神盘踞之处，属于彩虹桥的管辖范围。";
 	next;
	mes "[Dophe]";
	mes "他和我们就像硬币的两面，或水线的上下两侧。";
	next;
	mes "[Dophe]";
	mes "他和我们并非真正彼此平行，而是处在相互平行的宇宙中。";
	next;
	mes "[Dophe]";
	mes "...";
	next;
	mes "[Dophe]";
	mes "我的意思是：";
	mes "他可能就在我们眼皮底下，而我们却看不见。";
	mes "如果他的巢穴位于彩虹桥的某处领地，";
	next;
	mes "[Dophe]";
	mes "我们唯一可能的结局就是";
	mes "被彻底毁灭。";
	close;
}


verus04,115,221,5	script	Fallen Man#ep15_1_elyo	4_M_DIEMAN,{
	if (checkweight(1119,3) == 0) {
		mes "- 你携带的物品太多，无法继续任务。-";
		close;
	}
	.@name$ = strcharinfo(0);
	mes "- 有人死了！-";
	next;
	mes "- 不幸的是，死者被卡在电梯门里，电梯不断开合并夹住了他……-";
	next;
	mes "[" + .@name$ + "]";
	mes "你还好吗？";
	next;
	mes "[Fallen Man]";
	mes "......";
	next;
	mes "[" + .@name$ + "]";
	mes "你能听到吗？";
	next;
	mes "[Fallen Man]";
	mes "……别管我……";
	next;
	mes "[" + .@name$ + "]";
	mes "什么？";
	next;
	mes "[Fallen Man]";
	mes "我没事，放开我……";
	next;
	mes "[" + .@name$ + "]";
	mes "但你看起来不像没事……";
	mes "在这里等着，";
	mes "我会帮助你。";
	next;
	mes "[Fallen Man]";
	mes "我只是告诉你我不……嘿！我的腰！！！";
	next;
	mes "[" + .@name$ + "]";
	mes "......";
	next;
	mes "[" + .@name$ + "]";
	mes "我会帮你找医生！";
	next;
	mes "[Fallen Man]";
	mes "打扰了，谢谢。";
	next;
	.@time = checkquest(11377,PLAYTIME);
	if (.@time > 1)
		erasequest 11377;
	if (checkweight(1119,3) == 0) {
		mes "- 你携带的物品太多，无法继续任务。-";
		close;
	}
	if (.@time == 1)
		mes "后来，躺在担架上的男孩不好意思地突然抓住我的手……";
	else {
		mes "后来，躺在担架上的男孩不好意思地突然把一颗小水果放进我手里……";
		if (isbegin_quest(11377) == 0)
			setquest 11377;
		if (isbegin_quest(11376) == 0)
			getitem 522,1;// Fruit_Of_Mastela
		else {
			erasequest 11376;
			getitem 522,2;// Fruit_Of_Mastela
		}
	}
	// donpcevent "Halo#ep15_1_elyo::OnEnable";
	donpcevent "Fallen Man#ep15_1_elyo::OnDisable";
	close;

OnDisable:
	disablenpc "Fallen Man#ep15_1_elyo";
	disablenpc "Guide Elisha#ep15_1bs2";

 	enablenpc "Guide Elisha#ep15_1bs";
	enablenpc "Guide Scarlet#ep15_1bs";
	enablenpc "Du#ep15_1elb";
	enablenpc "Mark#ep15_1elb";
	enablenpc "Tamarin#ep15_1elb";
	enablenpc "Alph#ep15_1elb";
	enablenpc "Maggi#ep15_1elb";
	// disablenpc "Halo#ep15_1_elyo";
	stopnpctimer;
	end;
OnEnable:
	enablenpc "Fallen Man#ep15_1_elyo";
	enablenpc "Guide Elisha#ep15_1bs2";

	disablenpc "Guide Elisha#ep15_1bs";
	disablenpc "Guide Scarlet#ep15_1bs";
	disablenpc "Du#ep15_1elb";
	disablenpc "Mark#ep15_1elb";
	disablenpc "Tamarin#ep15_1elb";
	disablenpc "Alph#ep15_1elb";
	disablenpc "Maggi#ep15_1elb";
	initnpctimer;
	end;
OnTimer3600000:
	donpcevent "Fallen Man#ep15_1_elyo::OnDisable";
	stopnpctimer;
	end;
OnInit:
	disablenpc "Fallen Man#ep15_1_elyo";
	end;
}

yuno_fild07,216,157,5	script	Guide Elisha#ep15_1bs	4_F_ZONDAGIRL,{
	if (isbegin_quest(11376) > 0) {
		mes "[Elisha]";
		mes "奇怪！！电梯怎么突然又动了？";
		mes "难道是后面的人做了什么？";
		erasequest 11376;
		close;
	}
	.@name$ = strcharinfo(0);
	if (checkquest(11377,PLAYTIME) > 1)
		erasequest 11377;
	if (ep15_1_atnad < 4) {
		mes "[Elisha]";
		mes "我的公司雷根贝勒与伊甸园集团合作";
		mes "开展^0000FF幻象学挖掘项目^000000。";
		next;
		mes "[Elisha]";
		mes "远古文明新发现的遗产：幻象学！";
		mes "联系^0000FF伊甸园集团^000000，加入幻象学挖掘项目！";
		close;
	}
	mes "[Elisha]";
	mes "日安。";
	mes "请说出你的名字，以便我确认登记。";
	emotion ET_THROB;
	next;
	switch( select( "说出你的名字。", "询问登记。", "结束对话。" ) ) {
	case 1:
		mes "[Elisha]";
		switch(ep15_1_elb) {
		case 0:
		case 1:
			mes "嗯，让我看看……";
			mes "抱歉，你不在名单上。请确认登记状态。";
			emotion ET_PROFUSELY_SWEAT;
			close;
		case 2:
			mes "你这么快就回来了。";
			emotion ET_THROB;
			next;
			mes "[Elisha]";
			mes "让我看看……";
			mes "啊，找到你的名字了。";
			mes "现在要^0000FF前往幻象学^000000吗？";
			next;
			if (select( "不。", "是。" ) == 1) {
				mes "[Elisha]";
				mes "祝你今天愉快。";
				emotion ET_THROB;
				close;
			}
			mes "[Elisha]";
			mes "让我把你送往幻象学。";
			next;
			mes "[Elisha]";
			mes "为了安全，进入后请不要奔跑或跳跃。";
			next;
			mes "[Elisha]";
			mes "准备好了吗？";
			mes "祝你探索顺利！";
			emotion ET_THROB;
			next;
			mes "^FF0000- BEEP-! -";
			mes "- Service temporarily unavailable. -^000000";
			emotion ET_HUK, playerattached();
			next;
			mes "[Elisha]";
			mes "嗯？";
			mes "请稍等片刻好吗？";
			emotion ET_PROFUSELY_SWEAT;
			next;
			mes "^FF0000- BEEP-! -";
			mes "- Service temporarily unavailable. -^000000";
			emotion ET_HUK, playerattached();
			next;
			mes "[Elisha]";
			mes "嗯……";
			mes "它怎么了？";
			mes "请给我一点时间。";
			emotion ET_PROFUSELY_SWEAT;
			next;
			mes "^FF0000- BEEP-! -";
			mes "- Service temporarily unavailable. -^000000";
			emotion ET_HUK, playerattached();
			next;
			mes "[Elisha]";
			mes "糟糕。";
			mes "它坏了吗？";
			mes "不可能！";
			emotion ET_HUK;
			next;
			mes "^FF0000- BEEP-! -";
			mes "- Service temporarily unavailable. -^000000";
			emotion ET_HUK, playerattached();
			next;
			mes "[Elisha]";
			mes "抱歉，" + .@name$ + ".";
			mes "我知道你已经登记了服务，但它现在发生故障。";
			mes "很抱歉给你带来不便。";
			emotion ET_PROFUSELY_SWEAT;
			emotion ET_HUK, playerattached();
			next;
			mes "[Elisha]";
			mes "刚才还运作正常。";
			mes "抱歉。";
			mes "我得叫技术人员来。请改走楼梯。";
			next;
			mes "[Elisha]";
			mes "^0000FF幻影城市位于朱彼洛斯遗迹外东南门向南的隧道尽头。^000000";
			next;
			mes "[Elisha]";
			mes "中央喷泉附近有电梯门。能去看看电梯发生什么了吗？";
			mes "真的很抱歉。";
			emotion ET_CRY;
			ep15_1_elb = 3;
			completequest 11364;
			setquest 11365;
			close;
		case 3:
			mes "刚才还运作正常。";
			mes "抱歉。";
			mes "我得叫技术人员来。请改走楼梯。";
			next;
			mes "[Elisha]";
			mes "^0000FF幻影城市位于朱彼洛斯遗迹外东南门向南的隧道尽头。^000000";
			next;
			mes "[Elisha]";
			mes "中央喷泉附近有电梯门。能去看看电梯发生什么了吗？";
			mes "真的很抱歉。";
			emotion ET_CRY;
			close;
		case 4:
			mes "抱歉。";
			mes "电梯目前发生故障。";
			close;
		default:
			break;
		}
		if (checkquest(11377,PLAYTIME) > 1)
			erasequest 11377;
		if (checkquest(11377,PLAYTIME) == -1) {
			if (rand(1,100) == 77) {
				mes "天啊！怎么又来了！！！";
				mes "这台破电梯天天坏！！！";
				setquest 11376;
				donpcevent "Fallen Man#ep15_1_elyo::OnEnable";
				close;
			}
		}
		mes "让我看看……";
		mes "A……B……C……D……E……F……啊，在这里！";
		emotion ET_PROFUSELY_SWEAT;
		next;
		mes "[Elisha]";
		mes "" + .@name$ + ", your registration has been confirmed.";
		mes "想前往幻象学吗？";
		emotion ET_THROB;
		next;
		if (select( "不", "是" ) == 1) {
			mes "[Elisha]";
			mes "祝你今天愉快。";
			close;
		}
		mes "[Elisha]";
		mes "让我把你送往幻象学。";
		next;
		mes "[Elisha]";
		mes "为了安全，进入后请不要奔跑或跳跃。";
		next;
		mes "[Elisha]";
		mes "准备好了吗？";
		mes "祝你探索顺利！";
		close2;
		warp "verus04",122,217;
		end;
	case 2:
		mes "[Elisha]";
		mes "*清了清嗓子*";
		mes "这个设施由^0000FF雷根贝勒^000000提供";
		next;
		mes "[Elisha]";
		mes "供^0000FF伊甸园集团成员^000000安全前往^0000FF幻象学^000000。";
		next;
		mes "[Elisha]";
		mes "要使用该设施，必须是^0000FF登记参加幻象学挖掘项目的伊甸园集团成员^000000。";
		next;
		mes "[Elisha]";
		mes "只要你是伊甸园集团登记的挖掘者，就可以在^0000FF雷根贝勒公司总部^000000登记使用该设施。";
		if (ep15_1_elb > 1)
			close;
		next;
		if (select( "结束对话。", "询问路线。" ) == 1) {
			mes "[Elisha]";
			mes "我的公司雷根贝勒与伊甸园集团合作";
			mes "开展^0000FF幻象学挖掘项目^000000。";
			next;
			mes "[Elisha]";
			mes "远古文明新发现的遗产：幻象学！";
			mes "联系^0000FF伊甸园集团^000000，加入幻象学挖掘项目！";
			close;
		}
		mes "[Elisha]";
		mes "要登记使用设施，请前往利赫泰伦的^0000FF雷根贝勒公司总部，在一楼主入口西侧的信息台找莱特纳^000000。";
		next;
		mes "[Elisha]";
		mes "整个登记流程听起来很麻烦，但使用电梯值得。";
		if (ep15_1_elb == 0) {
			ep15_1_elb = 1;
			setquest 11363;// To Phantasmagorika!
		}
		close;
	case 3:
		mes "[Elisha]";
		mes "我的公司雷根贝勒与伊甸园集团合作";
		mes "开展^0000FF幻象学挖掘项目^000000。";
		next;
		mes "[Elisha]";
		mes "远古文明新发现的遗产：幻象学！";
		mes "联系^0000FF伊甸园集团^000000，加入幻象学挖掘项目！";
		close;
	}
	end;
OnInit:
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "!isbegin_quest(11363)" );
	end;
}

lhz_in01,75,209,3	script	莱特纳#ep15_1bs	4_LGTSCIENCE,{
	mes "[莱特纳]";
	switch(ep15_1_elb) {
	case 0:
		mes "嘿！";
		mes "亲爱的，是什么风把你吹来了？";
		mes "如果你想找个肩膀哭诉，我就在这里。";

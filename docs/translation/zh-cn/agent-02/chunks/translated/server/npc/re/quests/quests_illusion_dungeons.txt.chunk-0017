com_d02_i,228,95,4	script(CLOAKED)	Young#LuE04	4_M_THAIONGBAK,{
	if (ill_luanda == 10) {
		npctalk "哦，我为什么这么弱？和哥哥们不同，我的能力在战斗中并不特别有用。", "", bc_self;
		mes "[Young Man]";
		mes "哦，我为什么这么弱？和哥哥们不同，我的能力在战斗中并不特别有用。";
		next;
		npctalk "嗯？！你就是露安达外出狩猎时感兴趣的陌生人？", "", bc_self;
		mes "[Young Man]";
		mes "嗯？！你就是露安达外出狩猎时感兴趣的陌生人？";
		next;
		npctalk "既然见到你了，我就自我介绍吧？我叫毛，是你前几天见过的露安达的弟弟。", "", bc_self;
		mes "[Young Man]";
		mes "既然见到你了，我就自我介绍吧？我叫毛，是你前几天见过的露安达的弟弟。";
		next;
		select( "I..." );
		npctalk "哈哈哈，初次见面。我不知道你是否注意到，但我的兄弟姐妹是三胞胎。", "", bc_self;
		mes "[Young Man]";
		mes "哈哈哈，初次见面。我不知道你是否注意到，但我的兄弟姐妹是三胞胎。";
		next;
		npctalk "我的兄弟们小时候被遗弃在村里，是村民捡到并养大了他们。", "", bc_self;
		mes "[Young Man]";
		mes "我的兄弟们小时候被遗弃在村里，是村民捡到并养大了他们。";
		next;
		npctalk "他们还以城镇周围的洞窟为他们取名：卡鲁、露安达和毛。", "", bc_self;
		mes "[Young Man]";
		mes "他们还以城镇周围的洞窟为他们取名：卡鲁、露安达和毛。";
		next;
		npctalk "据说那是守护旧村庄的守护灵之名。", "", bc_self;
		mes "[Young Man]";
		mes "据说那是守护旧村庄的守护灵之名。";
		next;
		npctalk "嗯？我为什么要告诉你这些？", "", bc_self;
		mes "[Young Man]";
		mes "嗯？我为什么要告诉你这些？";
		next;
		npctalk "我想是因为练习不顺利，我已经失去理智了。", "", bc_self;
		mes "[Young Man]";
		mes "我想是因为练习不顺利，我已经失去理智了。";
		next;
		npctalk "我还在训练……白费功夫？！你不能相信别人的……", "", bc_self;
		mes "[Young Man]";
		mes "我还在训练……白费功夫？！你不能相信别人的……";
		next;
		cloakonnpcself();
		ill_luanda = 11;
		setquest 5847;
		mes "卡鲁消失了。我得告诉露安达发生了什么。";
		close;
	}
	end;
}


//===== rAthena Script =======================================
//= Jewel Case Quest
//===== By: ==================================================
//= Lupus
//===== Current Version: =====================================
//= 1.0
//===== Compatible With: =====================================
//= rAthena Project
//===== Description: =========================================
//= A quest for players at base level 99,
//= with Jewel Case as a reward.
//===== Additional Comments: =================================
//= 1.0 First Version.
//============================================================

lighthalzen,108,229,2	script	La Fenn	766,{
	mes "[La Fenn]";
	if(BaseLevel<99) {
		if(Q_99LVL) {
			mes "你……你变年轻了！！！但你确实还是你！";
			mes "没想到你真的能满足我的条件……";
			emotion ET_SCRATCH;
			next;
			mes "[La Fenn]";
			mes "这是你的奖励。它永远属于你。";
			set Q_99LVL,0;
			getitem 12106,1; //Jewel Case
			emotion ET_CONGRATULATION;
		} else {
			mes callfunc("F_Hi");
			mes "...";
			emotion ET_SLEEPY;
			next;
			mes "[La Fenn]";
		mes "我为二转且基础等级 99 的强者准备了一个谜题。";
		mes "*打哈欠* 如果你遇到这样的人，请告诉他们我的谜题。";
		}
		close;
	}
	if(BaseLevel==99 && Upper==0) {
		if(Q_99LVL) {
		mes "现在出发，让自己变年轻吧！";
		mes "解开我的谜题，我就给你一个装有稀有饰品的魔法珠宝盒。";
		} else {
			mes callfunc("F_Hi")+" The Hero!";
			if(BaseExp<1000000) {
				mes "你现在很强了。";
				mes "但是……还不足以解开我的谜题。";
				if(rand(2)) {
					mes "再击杀 "+((1000000-BaseExp)/3765+1)+" 只海豹后回来。";
				} else {
					mes "再击杀 "+((1000000-BaseExp)/81+1)+" 只波波利后回来。";
				}
			} else {
				mes "你现在真的很强了。";
				mes "如果你能变得比现在更年轻，我就把宝藏给你。";
				set Q_99LVL,1;
				emotion ET_BEST;
			}
		}
		close;
	}
	emotion ET_SCRATCH;
	mes "...";
	close;
}

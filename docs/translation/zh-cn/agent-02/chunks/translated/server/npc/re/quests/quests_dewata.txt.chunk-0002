		mes "[Tribal Chief Paiko]";
		mes "嗯……所以你还是没忍住，对吧？";
		mes "别太责怪自己。很难抵抗^006400沙嗲^000000诱人的香味。";
		next;
		mes "[Tribal Chief Paiko]";
		mes "我们部落食物短缺，不能再分给你^006400沙嗲^000000了，但听说杜瓦塔岛的餐馆老板正在制作并出售自己的^006400沙嗲^000000。";
		next;
		mes "[Tribal Chief Paiko]";
		mes "味道不如我们部落的配方，但这是紧急任务，找到后带回来吧。";
		close;
	case 2:
		return;
	case 3:
		mes "[Tribal Chief Paiko]";
		mes "好！现在就把它送来！";
		close;
	}
}

dew_fild01,78,288,6	script	Jaty Tribe Warrior#dew	541,{
	mes "[Jaty Tribe Warrior]";
	mes "我们崇尚力量与勇气。";
	mes "我们是^FF0000贾蒂^000000部落。";
	if (dew_legend != 9 || !countitem(11533))
		close;
	next;
	mes "[Jaty Tribe Warrior]";
	mes "我训练有素的双眼看出";
	mes "你似乎有话要说。";
	mes "说吧，说明来意。";
	next;
	select("^0000FFTribal Chief Paiko^000000");
	mes "[Jaty Tribe Warrior]";
	mes "我听说了你的";
	mes "善举……";
	mes "作为部落的代表，";
	mes "我要向你表示感谢。";
	next;
	mes "[Jaty Tribe Warrior]";
	mes "还有，谢谢你的^006400沙嗲^000000。";
	mes "光是想想就让我流口水了，谢谢你。";
	mes "关于我们的部落，我有件事想和你分享。";
	delitem 11533,1; //Satay
	set dew_legend,10;
	changequest 9158,9159;
	next;
	mes "[Jaty Tribe Warrior]";
	mes "与部落勇士战斗流血的古代不同，如今世界变得更加和平，但我们部落的领地却大幅缩小。";
	next;
	mes "[Jaty Tribe Warrior]";
	mes "尽管如此，我们仍会延续部落的勇士传统，守护先代勇士牺牲换来的荣耀。";
	next;
	mes "[Jaty Tribe Warrior]";
	mes "希望你在旅途中始终保持坚毅与自豪。";
	close;
}

dew_fild01,185,300,6	script	Tribe Manager#dew	541,{
	mes "[Tribe Manager]";
	mes "保持我们的文化和传统非常重要。";
	if (dew_legend != 11 || !countitem(11533)) {
		if (dew_legend < 11)
		mes "虽然有点无聊……";
		close;
	}
	next;
	mes "[Tribe Manager]";
	mes "我觉得你似乎有话";
	mes "要说，对吧？";
	next;
	select("^0000FFTribal Chief Paiko^000000");
	mes "[Tribe Manager]";
	mes "我不知道竟然有人";
	mes "付出了这样的努力，";
	mes "而你还在其中发挥了关键作用……";
	mes "你是^8B4513贾蒂部落^000000的英雄。";
	next;
	mes "[Tribe Manager]";
	mes "哇~美味自制^006400沙嗲^000000的";
	mes "香味真诱人！！";
	mes "谢谢你的款待。";
	mes "请代我向部落首领";
	mes "问好。";
	delitem 11533,1; //Satay
	set dew_legend,12;
	changequest 9160,9161;
	next;
	mes "[Tribe Manager]";
	mes "^8B4513杜瓦塔岛^000000和^8B4513贾蒂部落^000000之间";
	mes "很少联系。";
	mes "过去我们之间的纽带";
	mes "更加紧密。";
	next;
	mes "[Tribe Manager]";
	mes "但随着新文化和外国人涌入，";
	mes "^8B4513杜瓦塔岛^000000成了旅游胜地，我们也和他们失去了联系。";
	next;
	mes "[Tribe Manager]";
	mes "旅游业不断扩张，但没有影响到我们，是因为我管理的这座小神殿。";
	next;
	mes "[Tribe Manager]";
	mes "我不能让我们的传统就这样轻易消失。";
	mes "希望延续传统和文化，能让人们知道这些对我们有多重要。";
	next;
	mes "[Tribe Manager]";
	mes "从今以后，希望^8B4513杜瓦塔岛^000000和^8B4513贾蒂部落^000000的人能够和睦相处、更加频繁地交流。";
	close;
}

//Original name: Gatekeeper of Krakatau Volcano
dewata,235,56,4	script	Gatekeeper of Krakatau#1	534,{
	mes "[Gatekeeper of Krakatau Volcano]";
	mes "^8B4513喀拉喀托火山^000000正在";
	mes "是非常危险的区域";
	mes "我不能让任何人进去。";
	next;
	if (dew_legend == 13 && countitem(11533))
		set .@menu$, ":^0000FFTribal Chief Paiko^000000";
	switch(select("让我通过：我不想进去"+.@menu$)) {
	case 1:
		if (dew_legend < 8) {
			mes "[Gatekeeper of Krakatau Volcano]";
			mes "^8B4513喀拉喀托火山^000000正在";
			mes "是非常危险的区域，";
			mes "所以不能让你进去，";
			mes "除非你符合进入条件。";
			close;
		}
		mes "[Gatekeeper of Krakatau Volcano]";
		mes "你就是被部落首领认可为部落朋友，并获得^006400闪耀的天堂鸟羽毛^000000的旅行者。";
		next;
		mes "[Gatekeeper of Krakatau Volcano]";
		mes "好吧，我让你通过，但^8B4513喀拉喀托火山^000000很危险，请多加小心。";
		close2;
		warp "dew_dun01",289,160;
		end;
	case 2:
		mes "[Gatekeeper of Krakatau Volcano]";
		mes "你做出了明智的选择。";
		mes "^8B4513喀拉喀托火山^000000是";
		mes "极其危险的区域。";
		close;
	case 3:
		mes "[Gatekeeper of Krakatau Volcano]";
		mes "哦！我不知道这件事！";
		mes "这是我最近听到的";
		mes "最好的消息之一。";
		next;
		mes "[Gatekeeper of Krakatau Volcano]";
		mes "嗯，这股香味是什么？";
		mes "当然是我们的^006400沙嗲^000000！";
		mes "我正好有点饿，";
		mes "这应该能填饱肚子。";
		delitem 11533,1; //Satay
		set dew_legend,14;
		changequest 9162,9163;
		next;
		mes "[Gatekeeper of Krakatau Volcano]";
		mes "既然你大老远来到这里，";
		mes "我就和你分享一个有趣的故事。";
		next;
		mes "[Gatekeeper of Krakatau Volcano]";
		mes "这项传统近年来已经失传，但十多年前，想成为^8B4513贾蒂部落^000000的勇士，就必须攀登喀拉喀托火山证明耐力。";
		next;
		mes "[Gatekeeper of Krakatau Volcano]";
		mes "那些勇士登上^8B4513喀拉喀托火山^000000前，眼中既有不安也有决心。";
		next;
		mes "[Gatekeeper of Krakatau Volcano]";
		mes "我至今无法忘记他们眼中的神情，冒险者，我从你身上也感受到了一点相同的情绪。";
		next;
		mes "[Gatekeeper of Krakatau Volcano]";
		mes "希望你长寿兴旺。";
		mes "旅行者，愿你健康平安，能够活着讲述自己的冒险故事。";
		close;
	}
}

//Original name: Gatekeeper of Krakatau Volcano
dew_dun01,292,164,4	script	Gatekeeper of Krakatau#2	541,{
	mes "[Gatekeeper of Krakatau Volcano]";
	mes "想回";
	mes "杜瓦塔吗？";
	next;
	switch(select("是：否")) {
	case 1:
		close2;
		warp "dewata",232,53;
		end;
	case 2:
		mes "[Gatekeeper of Krakatau Volcano]";
		mes "^8B4513喀拉喀托火山^000000正在";
		mes "是危险的地方。";
		mes "你现在应该回去。";
		close;
	}
}

dewata,78,192,6	script	Borobudur Temple Manager	536,{
	mes "[Borobudur Temple Manager]";
	mes "今天天气真好。";
	if (dew_legend != 15 || !countitem(11533))
		close;
	next;
	mes "[Borobudur Temple Manager]";
	mes "对了，你有";
	mes "什么要告诉我吗……？";
	next;
	select("^0000FFTribal Chief Paiko^000000");
	mes "[Borobudur Temple Manager]";
	mes "我从不知道发生过这种事。";
	mes "如果你早点告诉我，我至少可以帮上一点忙。";
	mes "不过多亏你的帮助，事情进展得很顺利。";
	next;
	mes "[Borobudur Temple Manager]";
	mes "啊，这是部落前段时间邀请我品尝过的^006400沙嗲^00000。";
	next;
	mes "[Borobudur Temple Manager]";
	mes "好吃~~就是我记得的味道。";
	mes "为了表达感谢，我告诉你一个你可能感兴趣的故事。";
	delitem 11533,1; //Satay
	set dew_legend,16;
	changequest 9164,9165;
	next;
	mes "[Borobudur Temple Manager]";
	mes "传说中有一种名叫^FF0000迦楼罗^000000的奇鸟。";
	mes "它拥有人的躯干、手臂和双腿，却长着鹰的头和喙。";
	next;
	mes "[Borobudur Temple Manager]";
	mes "关于它的故事讲述了它帮助神明消灭邪恶的恶魔和蛇。";
	next;
	mes "[Borobudur Temple Manager]";
	mes "这个故事代代相传。";
	mes "很有趣，对吧？";
	next;
	mes "[Borobudur Temple Manager]";
	mes "我相信^8B4513贾蒂部落^000000的村子里有许多传说故事。";
	mes "以后见到首领时，我一定能听到很多这样的故事。";
	next;
	mes "[Borobudur Temple Manager]";
	mes "我不知道我们下次何时相遇，但希望有一天还能再见。";
	mes "年轻的旅行者，祝你旅途愉快。";
	close;
}

// Help Out the Old Man :: dewata_drink
//============================================================
dewata,109,262,4	script	Memo#dew_drink	534,{
	if (checkweight(1201,1) == 0 || MaxWeight - Weight < 5000) {
		if (dew_drink) {
			mes "[Memo]";
			mes "你为什么带这么多东西？背不会痛吗？";
			close;
		} else {
			mes "[Memo]";
			mes "现在的年轻人都流行带重物吗？";
			close;
		}
	}
	set .@playtime, checkquest(5044,PLAYTIME);
	if (.@playtime == 0) {
		mes "[Memo]";
		mes "明天还能再帮我吗？";
		mes "波比的背还在痛。";
		mes "背痛不是一天就能消失的。";
		close;
	} else if (.@playtime == 1) {
		erasequest 5044;
	} else if (.@playtime == 2) {
		completequest 5044;
		erasequest 5044;
	}
	if (BaseLevel < 60) {
		mes "[Memo]";
		mes "杜瓦塔总是很拥挤，但今天很安静。";
		close;
	}
	if (dew_drink == 0) {
		if (rand(3)) {
			mes "[Memo]";
			mes "天啊！我们还没有收到贾蒂部落的消息。";
			emotion ET_PROFUSELY_SWEAT;
			next;
			mes "[Memo]";
			mes "他们十年来从未违背承诺，我不知道原因。发生什么事了？";
			next;
			mes "[Memo]";
			mes "这样下去所有液体可能都会变质。";
			emotion ET_CRY;
			close;
		}
		mes "[Memo]";
		mes "我该怎么办？我还是没有贾蒂部落的消息。";
		emotion ET_PROFUSELY_SWEAT;
		next;
		mes "[Memo]";
		mes "糟糕~所有液体都要变质了……";
		next;
		select("发生了什么？");
		mes "[Memo]";
		mes "你是谁？";
		emotion ET_QUESTION;
		next;
		mes "[Memo]";
		mes "你是冒险者，对吧？";
		mes "如你从周围的罐子所见，我靠制作^0000FF传统酒^000000为生。";
		next;
		mes "[Memo]";
		mes "大家都知道这一点，所以^0000FF杜瓦塔岛^000000吸引了许多游客。";
		next;
		mes "[Memo]";
		mes "尤其是这种已经制作了四代的传统酒！但^FF0000阿尔克^000000的原料快不够了。";
		mes "阿尔克需要用油棕果制成的^0000FF棕榈油^000000。";
		next;
		mes "[Memo]";
		mes "遗憾的是，我们最近一直没收到贾蒂部落村庄送来的^0000FF棕榈油^000000。";
		mes "如果送得太晚，食材可能就没用了。";
		next;
		select("听起来问题很严重。" );
		mes "[Memo]";
		mes "问题比你想的严重。销售是赊账的，如果今天无法交货，我们会失去信用、食材，以及拿不到阿尔克的游客。这损失很大。";
		next;
		mes "[Memo]";
		mes "... ...";
		emotion ET_THINK;
		next;
		emotion ET_SURPRISE;
		mes "[Memo]";
		mes "啊，对了！你现在忙吗？";
		next;
		if(select("抱歉，我很忙。：不，我不忙。") == 1) {
			mes "[Memo]";
		mes "嗯，我别无选择。";
		mes "你不在乎别人遇到麻烦。这个世界到底怎么了？";
			emotion ET_HNG;
			close;
		}
		mes "[Memo]";
		mes "听你这么说真好。";
		mes "既然你正在这里闲逛……";
		next;
		mes "[Memo]";
		mes "能请你帮个忙吗~？其实我必须去贾蒂部落，但这批尚未成熟的^FF0000阿尔克^000000让我无法离开。";
		next;
		mes "[Memo]";
		mes "你能去贾蒂村问问^0000FF莱洛^000000发生了什么吗？";
		next;
		mes "[Memo]";
		mes "这家伙十年来从未违背承诺，所以他没来的理由一定很充分。";
		set dew_drink,1;
		setquest 5035;
		next;
		mes "[Memo]";
		mes "去找最好的榨油师。";
		mes "他叫^0000FF莱洛^000000。";
		close;
	} else if (dew_drink < 5) {
		mes "[Memo]";
		mes "那么，莱洛怎么说？";
		next;
		mes "[Memo]";
		mes "... ... ... ...";
		emotion ET_THINK;
		next;
		mes "[Memo]";
		mes "你没弄清楚发生了什么吗？";
		next;
		mes "[Memo]";
		mes "去找最好的榨油师。他叫^0000FF莱洛^000000。";
		close;
	} else if (dew_drink == 5) {
		mes "[Memo]";
		mes "那么，莱洛怎么说？";
		next;
		select("棕榈树……变成了。" );
		mes "- 你向梅莫先生说明情况。-";
		next;
		mes "[Memo]";
		mes "莱洛道歉了？";
		mes "嗯，没关系。";
		next;
		mes "[Memo]";
		mes "那一定是^0000FF波比^000000。要是他受伤了，就能解释为什么没有消息。莱洛其实很关心他……";
		next;
		mes "[Memo]";
		mes "他可能有点麻烦，但请去一趟贾蒂村。莱洛必须完成榨油。";
		next;
		mes "[Memo]";
		mes "如果还没完成，就在那里等着，带^FF000030瓶油^000000回来给我。";
		set dew_drink,6;
		changequest 5040,5041;
		close;
	} else if (dew_drink == 6) {
		mes "[Memo]";
		mes "他可能有点麻烦，但请去一趟贾蒂村。莱洛必须完成榨油。";
		next;
		mes "[Memo]";
		mes "如果还没完成，就在那里等着，带^FF000030瓶油^000000回来给我。";
		close;
	} else if (dew_drink == 7) {
		if (countitem(6401) < 30) {
			mes "[Memo]";
		mes "哦，我不是告诉过你要带30瓶油吗？你忘了吗？";
			next;
			mes "[Memo]";
		mes "回去找莱洛再拿一些，如果是你的失误，他会再给你。";
			close;
		}
		mes "[Memo]";
		mes "你把油带来了。做得好，谢谢。";
		next;
		mes "[Memo]";
		mes "抱歉，我有急事要处理。你能等一会儿，等我忙完再和我谈吗？";
		delitem 6401,30; //Palm_O
		changequest 5042,5043;
		set dew_drink,8;
		close;
	} else if (dew_drink == 8) {
		if (checkquest(5043,PLAYTIME) == 0) {
			mes "[Memo]";
			mes "... ... ...";
			emotion ET_PROFUSELY_SWEAT;
			next;
			mes "- 梅莫正在制作方舟。-";
			close;
		} else if (checkquest(5043,PLAYTIME) == -1) {
			mes "- 任务出现错误。-";
			close;
		}
		mes "[Memo]";
		mes "我让你等太久了吗？";
		next;
		mes "[Memo]";
		mes "我们家制作阿尔克已经四代了。";
		next;
		mes "[Memo]";
		mes "祖父因为卖得不好，生活一直很艰难。";
		next;
		mes "[Memo]";
		mes "杜瓦塔岛的人在炎热天气里不太喝酒。";
		next;
		mes "[Memo]";
		mes "我年轻时，杜瓦塔发展成旅游胜地，^FF00FF旅行套餐^000000阿尔克就是那时开始畅销的。";
		next;
		mes "[Memo]";
		mes "好酒需要新鲜的油。我十年来一直能制作酒并按时交货。";
		next;
		mes "[Memo]";
		mes "因为今天的油没能按时到，我想这次会很困难。";
		next;
		mes "[Memo]";
		mes "你帮助我正确地制作了酒。";
		next;
		mes "[Memo]";
		mes "这句谚语^0000FF“说起来容易，做起来难。”^000000的意思是，说一件事很容易，但真正做起来很难。";
		next;
		mes "[Memo]";
		mes "换句话说，说要帮助别人很容易，但真正采取行动很难。";
		next;
		emotion ET_THANKS;
		mes "[Memo]";
		mes "你真的做得很好。我喜欢你，因为你和现在的年轻人不同。";
		changequest 5043,5044;
		set dew_drink,10;
		getexp 50000,10000;
		getitem 617,1; //Old_Violet_Box
		next;
		mes "[Memo]";
		mes "你以后能偶尔帮我工作吗？";
		mes "我会为你做的事支付报酬。";
		close;
	} else if (dew_drink == 10) {
		for(set .@i,0; .@i<7; set .@i,.@i+1)
			if (checkquest(5045+.@i) > -1)
				set .@j, .@j | (1<<.@i);
		if (.@j == 0) {
			mes "[Memo]";
			mes strcharinfo(0)+", to what do I owe the pleasure?";
			next;
			switch(select("只是来打个招呼。：我来帮你。")) {
			case 1:
				mes "[Memo]";
				mes "我想你很忙。";
				mes "如果可以，能帮我从莱洛那里拿油吗？我会很感激……";
				close;
			case 2:
				mes "[Memo]";
				mes "谢谢。我知道你很忙，帮我可能会很麻烦。";
				next;
				mes "[Memo]";
				mes "你能帮帮莱洛，带棕榈油回来吗……？";
				setquest 5045;
				close;
			}
		} else if ((.@j & 1) || (.@j & 2) || (.@j & 8) || (.@j & 32)) {
			mes "[Memo]";
		mes "你能帮帮莱洛，带棕榈油回来吗……？";
			close;
		} else if ((.@j & 4) || (.@j & 16) || (.@j & 64)) {

			// .@i[]: <required amount>,<quest ID>,<reward amount>

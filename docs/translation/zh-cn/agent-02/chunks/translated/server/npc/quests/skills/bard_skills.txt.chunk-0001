prontera,174,328,3	script	Young Man#bard_q1	89,3,3,{
	if (BaseJob == Job_Bard) {
		emotion ET_HUK;
		mes "[Timid Young Man]";
		mes "嗯？哇啊啊——！你、你是……是……";
		if (Upper != 1)
			mes "竟然是个该死的吟游诗人！";
		else
			mes "竟然是个该死的诗人！";
		mes "别、别靠近我！我……我讨厌你们这些人！";
		next;
		if (select("什——？为什么？！:嘿，放轻松。") == 1) {
			mes "[Timid Young Man]";
			mes "不、不！别看我！我知道你想做什么！求你了，我没对你做任何事！离、离我远点！";
			next;
			mes "[" + strcharinfo(0) + "]";
			mes "嗯……我没想做什么。你为什么不放松一点，然后——";
			next;
			mes "[Timid Young Man]";
			mes "放松？！我告诉别人你们有多危险，却没人相信。你们以为靠有趣的笑话和动听的歌就很了不起，但我知道你们拥有什么力量！";
			close;
		}
		else {
			mes "[Timid Young Man]";
					mes "不、不！别看我！我知道你想做什么！求你了，我没对你做任何事！离、离我远点！";
			next;
			if (select("给他一杯饮料。:向他保证你没有危险。") == 1) {
				mes "[" + strcharinfo(0) + "]";
				mes "听着，我不知道你为什么针对我，但你真的需要放松。来，我请你喝一杯。";
				next;
				if (countitem(12112) > 0) {
					mes "[Timid Young Man]";
					mes "哦~！那不是热带索格拉特吗？那是我最喜欢的饮料！";
					if (qskill_bard == 9) {
						mes "谢谢——等一下。";
						next;
						mes "[Timid Young Man]";
						mes "这是什么奇怪的把戏吧？我差点就上当了！请、请离我远点！";
						close;
					}
					else if (qskill_bard > 0) {
						next;
						mes "[Timid Young Man]";
						mes "等等，我以前见过你。你也带过同样的饮料给我。你……";
						mes "你、你没学会那种奇、奇怪的技能吧？等等，不，你不可能学会……";
						next;
						mes "[" + strcharinfo(0) + "]";
						mes "拜托~我觉得你可能太担心了。";
						close;
					}
					else {
						next;
						mes "[Timid Young Man]";
						mes "^333333*咕噜咕噜*^000000 啊~你不知道我想喝这杯饮料多久了！味道真好，现在感觉好放松……";
						next;
						switch(select("看吧？我一点也不危险~:像我这样的人为什么会让你害怕？")) {
						case 1:
							mes "[Timid Young Man]";
							mes "嗯……也许吧。也许你们吟游诗人和诗人没那么坏。但我永远忘不了那个吟游诗人对我做的事……";
							next;
							mes "[Timid Young Man]";
							mes "一切始于我穿过乌姆巴拉时，遇见了一名奇怪的吟游诗人。他师从村里的乌坦萨满普丘查尔坦。";
							next;
							mes "[Timid Young Man]";
							mes "我和那名吟游诗人相处得不错，直到他带我去乌姆巴拉蹦极。他坚持让我至少跳一次，体验‘完整的乌姆巴拉经历’。我拒绝了，毕竟那里根本没有蹦极绳。";
							next;
							mes "[Timid Young Man]";
							mes "吟游诗人似乎被冒犯了，声称那里完全安全，只有少数人跳下去时死了。然后，他……他用锐利的目光盯着我。";
							next;
							mes "[Timid Young Man]";
							mes "他的眼中充满了愤怒！我记得他低声念了什么，突然间我失去了身体的控制！手脚竟然自行移动！";
							next;
							mes "[Timid Young Man]";
							mes "没过多久，我发现自己正在拼命阻止身体跳下蹦极处。但越是抵抗，身体就越猛烈地朝边缘挣扎。太可怕了！";
							next;
							mes "[Timid Young Man]";
							mes "那是我一生中最恐怖的经历！冒生命危险已经够糟了，但无法控制身体的感觉实在令人崩溃！";
							next;
							mes "[" + strcharinfo(0) + "]";
							mes "等等，你是说吟游诗人对你做了这种事？我从没听说过有这种效果的歌曲或技能。真奇怪……";
							next;
							mes "[Timid Young Man]";
							mes "在亲身经历之前，我也从没听说过那种力量。哦，我在噩梦中仍能看到他邪恶的笑容……";
							next;
							mes "[Timid Young Man]";
							mes "总之，谢谢你的饮料，它真的让我平静下来。但我必须警告你，别去寻找那个奇怪的吟游诗人。我确定他一定是某种恶魔……";
							next;
							if (JobLevel > 39) {
								mes "[Timid Young Man]";
								mes "不过……如果你真的想获得那种力量，我也阻止不了你。幸好没人知道他在哪里~";
								delitem 12112,1; //Tropical_Sograt
								set qskill_bard,1;
							}
							else {
								mes "[Timid Young Man]";
								mes "即使你找到那名吟游诗人，让他教你对我做的事，我确定他也提过，至少要达到^660000职业等级 40^000000才能驾驭那种力量……";
								delitem 12112,1; //Tropical_Sograt
							}
							close;
						case 2:
							mes "[Timid Young Man]";
						mes "^333333*叹气*^000000 也许并非所有吟游诗人和诗人都可怕。但任何吟游诗人都会让我想起旅途中遇到的那个人。只要想起那段经历，我就会起鸡皮疙瘩。";
							next;
							mes "[Timid Young Man]";
							mes "一切始于我穿过乌姆巴拉时，遇见了一名奇怪的吟游诗人。他师从村里的乌坦萨满普丘查尔坦。";
							next;
							mes "[Timid Young Man]";
							mes "我和那名吟游诗人相处得不错，直到他带我去乌姆巴拉蹦极。他坚持让我至少跳一次，体验‘完整的乌姆巴拉经历’。我拒绝了，毕竟那里根本没有蹦极绳。";
							next;
							mes "[Timid Young Man]";
							mes "吟游诗人似乎被冒犯了，声称那里完全安全，只有少数人跳下去时死了。然后，他……他用锐利的目光盯着我。";
							next;
							mes "[Timid Young Man]";
							mes "他的眼中充满了愤怒！我记得他低声念了什么，突然间我失去了身体的控制！手脚竟然自行移动！";
							next;
							mes "[Timid Young Man]";
							mes "没过多久，我发现自己正在拼命阻止身体跳下蹦极处。但越是抵抗，身体就越猛烈地朝边缘挣扎。太可怕了！";
							next;
							mes "[Timid Young Man]";
							mes "那是我一生中最恐怖的经历！冒生命危险已经够糟了，但无法控制身体的感觉实在令人崩溃！";
							next;
							mes "[" + strcharinfo(0) + "]";
							mes "等等，你是说吟游诗人对你做了这种事？我从没听说过有这种效果的歌曲或技能。真奇怪……";
							next;
							mes "[Timid Young Man]";
							mes "在亲身经历之前，我也从没听说过那种力量。哦，我在噩梦中仍能看到他邪恶的笑容……";
							next;
							mes "[Timid Young Man]";
							mes "总之，谢谢你的饮料，它真的让我平静下来。但我必须警告你，别去寻找那个奇怪的吟游诗人。我确定他一定是某种恶魔……";
							next;
							if (JobLevel > 39) {
								mes "[Timid Young Man]";
								mes "不过……如果你真的想获得那种力量，我也阻止不了你。幸好没人知道他在哪里~";
								delitem 12112,1; //Tropical_Sograt
								set qskill_bard,1;
							}
							else {
								mes "[Timid Young Man]";
								mes "即使你找到那名吟游诗人，让他教你对我做的事，我确定他也提过，至少要达到^660000职业等级 40^000000才能驾驭那种力量……";
								delitem 12112,1; //Tropical_Sograt
							}
							close;
						}
					}
				}
				else {
					mes "[Timid Young Man]";
							mes "呃……？！嗯，你、你愿意提供饮料真好，但我对饮料很挑剔。而、而且我不知道能不能相信你。";
					next;
					mes "[Timid Young Man]";
							mes "我不认为有什么能改变我的想法！不过……如果你带来我最喜欢的饮料热带索格拉特，我也许会重新考虑……";
					close;
				}
			}
			mes "[" + strcharinfo(0) + "]";
			mes "别担心，我不会伤害你。";
			next;
			mes "[Timid Young Man]";
			mes "他、他们在进入你的意识并狠狠扭曲它之前，都会这么说！";
			if (qskill_bard == 9) {
				mes "别、别碰我！……啊！离我远点！";
			}
			else {
				mes "即、即使你没有那种力、力量，也、也请离我远点！";
			}
			close;
		}
	}
	else {
		mes "[Timid Young Man]";
		mes "哦……天啊。刚才那里是吟游诗人吗？我好怕那些人！诗人更糟糕！";
		next;
		mes "[Timid Young Man]";
		mes "别误会，我喜欢歌曲和娱乐，但你必须明白！他们有些人拥有难以置信的力量！我……我亲眼见过！";
		close;
	}

OnTouch:
	if (BaseJob == Job_Bard) {
		emotion ET_HUK;
	}
	end;
}

morocc_in,169,72,7	script	Spiteful-Looking Bard#bs	741,3,3,{
	if (BaseJob == Job_Bard) {
		if (Class == Job_Clown && qskill_bard == 9) {
			if (getskilllv("BA_PANGVOICE") != 0) {
				mes "[Riott]";
				mes "咯嘿嘿~ 你有没有好好使用我教你的东西？小心别滥用技能，否则人们会像讨厌我一样讨厌你。";
				next;
				mes "[Riott]";
				mes "不过，你的敌人和偶尔遇到的醉汉就另当别论了！哇哈哈哈！";
				close;
			}
			else {
				mes "[Riott]";
				mes "不可能！你把我教的一切都忘了？怎么会这样？没关系，如果你愿意，我可以再教你。";
				next;
				if (select("不用了，谢谢。:谢谢，我很感激。") == 1) {
					mes "[Riott]";
					mes "什么……？你真的不想学？我保证没有附加条件。如果你改变主意……";
					close;
				}
				mes "[Riott]";
				mes "首先，你必须狠狠盯着目标的眼睛，集中于支配的念头。这是催眠的基础。现在听这段咒语……";
				next;
				mes "[Riott]";
				mes "Uuuummm Baaalaaaa";
				mes "Uuuummmm Baaalaaa~";
				mes "Kkkkuuurrirrreeee";
				mes "Kkkkuuurrirrreeee";
				mes "Oooumm guandlejdl";
				mes "Woooo Ei ei ei ei......";
				specialeffect EF_TALK_FROSTJOKE;
				next;
				mes "[Riott]";
				mes "潘利姆之声用于迷惑他人、扰乱身体控制。它不是致命技能，却能有效扰乱敌人的精神。请谨慎使用。";
				skill "BA_PANGVOICE",1,SKILL_PERM;
				close;
			}
		}
		else if (qskill_bard > 8) {
			mes "[Riott]";
			mes "咯嘿嘿~ 你有没有好好使用我教你的东西？小心别滥用技能，否则人们会像讨厌我一样讨厌你。";
			next;
			mes "[Riott]";
			mes "不过，你的敌人和偶尔遇到的醉汉就另当别论了！哇哈哈哈！";
			close;
		}
		else if (qskill_bard == 8) {
			if (countitem(7277) > 0) {
				mes "[Riott]";
				mes "啊，你带来了姚君制作的木乃伊娃娃，就像你答应的那样。没错，这是她的手艺，一如既往地完美。你做得很好~";
				next;
				mes "[Riott]";
				mes "作为交易的一部分，我现在教你我的特殊技能。这是我聆听乌姆巴拉乌坦萨满的咒语后开发的。";
				next;
				mes "[Riott]";
				mes "首先，你必须狠狠盯着目标的眼睛，集中于支配的念头。这是催眠的基础。现在听这段咒语……";
				next;
				mes "[Riott]";
				mes "‘青蛙腿，维丽特之心，旋转的星辰，洒落的 Zeny，手脚被束缚。这声音是你的，还是我的？头在旋转，头在旋转，头在旋转……！’";
				specialeffect2 EF_TALK_FROSTJOKE;
				delitem 7277,1; //Munak_Doll
				skill "BA_PANGVOICE",1,SKILL_PERM;
				set qskill_bard,9;
				next;
				mes "[Riott]";
				mes "记住，重要的不是说什么，而是怎么说。用禁忌而诱人的节奏催眠目标，你的";

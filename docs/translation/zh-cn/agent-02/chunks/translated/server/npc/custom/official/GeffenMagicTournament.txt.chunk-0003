		
		mes .@n$;
		mes "恭喜！你通过了测试！";
		next;
		mes .@n$;
		mes "告诉我你的名字，我会记录下来。";
		mes "现在你会自动注册参加大赛。";
		next;
		input .@char$;
		if(.@char$ == "") { end; }
		mes .@n$;
		mes strcharinfo(0)+"?";
		mes "好的，名字很有趣。";
		mes "总之，你已经注册完成！";
		'GMT = 5;
		erasequest 9293;
		if (checkquest(9294) > -1)
			erasequest 9294;
		setquest 9294;
		donpcevent instance_npcname("#gefmagic_warp01")+"::OnEnable";
		next;
		mes .@n$;
		mes "注册的参赛者将被随机选中。";
		next;
		mes .@n$;
		mes "魔法大赛马上就要开始了。";
		mes "进入南边的传送门即可参加。";
		next;
		mes .@n$;
		mes "祝你好运～！";
		end;
	
	}
	
	if ( checkquest(9293) == -1 ) {
		
		mes .@n$;
	mes "感谢你参观吉芬魔法大赛。";
	mes "我能为你做些什么？";
		next;
	L_Menu:
		switch(select("About Geffen Magic Tournament:How do I Register?:Collecting Rewards.:Can I get a Spectator Pass?:End Conversation")){
			case 1:
				mes .@n$;
				mes "吉芬魔法大赛每 3 年举办一次。";
				next;
				mes .@n$;
				mes "过去这是学者们讨论魔法方法的学术活动。";
				mes "现在则变成了欢乐的大型庆典。";
				next;
				mes .@n$;
				mes "如今几乎完全变成了战斗大赛。";
				mes "世界各地最著名的魔法师都会前来参赛。";
				next;
				mes .@n$;
				mes "还有其他问题吗？";
				next;
				goto L_Menu;
			case 2:
				mes .@n$;
				mes "报名不收取注册费。";
				mes "唯一要求是通过一个简单测试。";
				next;
				mes .@n$;
				mes "测试很简单。在 60 秒内击败一只沙漠之狼就算通过。";
				next;
				mes .@n$;
				mes "失败会自动从名单中移除，但可以随时重新尝试。";
				mes "你想参加测试吗？";
				next;
					switch(select("否:是")){
					case 1:
						mes .@n$;
						mes "改变主意后再回来吧。";
						close;
					case 2:
						mes .@n$;
						mes "通过测试后就能参加魔法大赛。";
						mes "那么，我们开始吧！";
						erasequest 9292;
						setquest 9293;
						'GMT = 3;
						npctalk "限时60秒！准备！开始！";
						addtimer 60000,instance_npcname("Receptionist#1_0et")+"::OnFail";
						monster instance_mapname("1@gef"),120,62,"--ja--",1106,1,instance_npcname("Receptionist#1_0et")+"::OnTest";
						hideonnpc instance_npcname("Receptionist#1_0et");	
						break;
				}
				end;
			case 3:
				mes .@n$;
				mes "在大赛中走得越远，获得的金币就越多。";
				next;
				mes .@n$;
				mes "收集金币后，可以到吉芬金币兑换员处兑换装备。";
				next;
				mes .@n$;
				mes "还有其他问题吗？";
				next;
				goto L_Menu;
			case 4:
				mes .@n$;
				mes "嗯，今年的魔法大赛似乎太受欢迎了，已经没有观众席位。";
				next;
				mes .@n$;
				mes "很抱歉给你带来不便。";
				next;
				mes .@n$;
				mes "还需要其他帮助吗？";
				next;
				goto L_Menu;
			case 5:
				mes .@n$;
				mes "请尽情享受吉芬魔法大赛。";
				close;
		}
		end;
	}
	
	end;
	
OnTest:
	deltimer instance_npcname("Receptionist#1_0et")+"::OnFail";
	'passtest = 1;
	hideoffnpc instance_npcname("Receptionist#1_0et");
	npctalk "你通过了测试！我们完成登记吧？", instance_npcname("Receptionist#1_0et");
	end;
	
OnFail:
	hideoffnpc instance_npcname("Receptionist#1_0et");
	'passtest = 2;
	killmonster instance_mapname("1@gef"),instance_npcname("Receptionist#1_0et")+"::OnTest";
	npctalk "你没有通过测试。想再试一次就来找我。", instance_npcname("Receptionist#1_0et");
	end;

}


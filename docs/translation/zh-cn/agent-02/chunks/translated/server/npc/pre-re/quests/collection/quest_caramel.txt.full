mjolnir_01,296,29,6	script	Yullo#Caramel_Hunt	95,{
	if (checkquest(60116) != -1) {
		if (checkquest(60116,HUNTING) != 2 ) {
			mes "[Yullo]";
			mes "你已经猎杀 50 只焦糖兽了吗？";
			next;
			switch(select("是:否:我想退出")) {
			case 1:
				mes "[Yullo]";
				mes "嗯，我觉得你还没猎杀 50 只……";
				close;
			case 2:
				mes "[Yullo]";
				mes "记住，我需要你帮忙猎杀焦糖兽，去猎杀 50 只吧。";
				close;
			case 3:
				mes "[Yullo]";
				mes "你确定要停止猎杀吗？";
				mes "你取得的进度都会被清除。";
				next;
				switch(select("是:否")) {
				case 1:
					mes "[Yullo]";
					mes "好吧，改变主意后再回来。";
					erasequest 60116;
					close;
				case 2:
					mes "[Yullo]";
					mes "请猎杀 50 只焦糖兽。";
					close;
				}
			}
		}
		else {
			mes "[Yullo]";
			mes "太棒了，你完成得真快。";
			getexp 10425,6272;
			erasequest 60116;
			close;
		}
	}
	if (checkquest(60117) != -1) {
		if (checkquest(60117,HUNTING) != 2 ) {
			mes "[Yullo]";
			mes "你已经猎杀 100 只焦糖兽了吗？";
			next;
			switch(select("是:否:我想退出")) {
			case 1:
				mes "[Yullo]";
				mes "嗯，我觉得你还没猎杀 100 只……";
				close;
			case 2:
				mes "[Yullo]";
				mes "记住，我需要你帮忙猎杀焦糖兽，去猎杀 100 只吧。";
				close;
			case 3:
				mes "[Yullo]";
				mes "你确定要停止猎杀吗？";
				mes "你取得的进度都会被清除。";
				next;
				switch(select("是:否")) {
				case 1:
					mes "[Yullo]";
					mes "好吧，改变主意后再回来。";
					erasequest 60117;
					close;
				case 2:
					mes "[Yullo]";
					mes "请猎杀 100 只焦糖兽。";
					close;
				}
			}
		}
		else {
			mes "[Yullo]";
			mes "太棒了，你完成得真快。";
			getexp 10425,6272;
			getexp 10425,6272;
			erasequest 60117;
			close;
		}
	}
	if (checkquest(60118) != -1) {
		if (checkquest(60118,HUNTING) != 2 ) {
			mes "[Yullo]";
			mes "你已经猎杀 150 只焦糖兽了吗？";
			next;
			switch(select("是:否:我想退出")) {
			case 1:
				mes "[Yullo]";
				mes "嗯，我觉得你还没猎杀 150 只……";
				close;
			case 2:
				mes "[Yullo]";
				mes "记住，我需要你帮忙猎杀焦糖兽，去猎杀 150 只吧。";
				close;
			case 3:
				mes "[Yullo]";
				mes "你确定要停止猎杀吗？";
				mes "你取得的进度都会被清除。";
				next;
				switch(select("是:否")) {
				case 1:
					mes "[Yullo]";
					mes "好吧，改变主意后再回来。";
					erasequest 60118;
					close;
				case 2:
					mes "[Yullo]";
					mes "请猎杀 150 只焦糖兽。";
					close;
				}
			}
		}
		else {
			mes "[Yullo]";
			mes "太棒了，你完成得真快。";
			getexp 10425,6272;
			getexp 10425,6272;
			getexp 10425,6272;
			erasequest 60118;
			close;
		}
	}
	//for minimum level
	if (BaseLevel > 23) {
		//for maximum level
		if (BaseLevel < 61) {
			mes "[Yullo]";
			mes "我不行了，真的不能再继续了。";
			mes "看看我，我是认真的，我没法再猎杀这些东西了。";
			next;
			switch(select("什么东西？:忽略。")) {
			case 1:
				mes "[Yullo]";
				mes "这样吧，我有个主意。";
				mes "你可以收集它们，我会奖励你的努力！";
				next;
				switch(select("收集物品:猎杀焦糖兽:取消")) {
				case 1:
					// Item turn in
					mes "[Yullo]";
					mes "好，我需要 25 根刺猬";
					mes "尖刺。";
					mes "请告诉我你是否有一些，或者能";
					mes "帮帮我。";
					next;
					switch(select("我有刺猬尖刺:我想我帮不了忙。")) {
					case 1:
						/*
						if (checkweight(501,10) == 0) {
							mes "[Yullo]";
							mes "嘿，你背上的重量好像要把你压垮了。";
							mes "减轻负重后再回来吧。";
							close;
						}
						*/
						if (countitem(1027) > 24) {
							mes "[Yullo]";
							mes "太好了，数量足够！";
							mes "正如我承诺的，这是小小的奖励。";
							delitem 1027,25; //Porcupine_Spike
							getexp 10425,6272;
							//getitem 501,10; //Red_Potion
							close;
						}
						else {
							mes "[Yullo]";
							mes "刺猬尖刺在哪里？";
							mes "你以为我不会发现吗？";
							close;
						}
					case 2:
						mes "[Yullo]";
						mes "我需要 ^00CE0025 25 根刺猬尖刺^000000。";
						close;
					}
				case 2:
					// Kill Count Quest
					mes "[Yullo]";
					mes "啊，好吧，我想你可以帮我猎杀一些焦糖兽。";
					mes "你想猎杀多少只？";
					next;
					switch(select("50 只焦糖兽:100 只焦糖兽:150 只焦糖兽")) {
					case 1:
						mes "[Yullo]";
						mes "完成任务后回来，我会给你一份小奖励。";
						setquest 60116;
						close;
					case 2:
						mes "[Yullo]";
						mes "完成任务后回来，我会给你一份小奖励。";
						setquest 60117;
						close;
					case 3:
						mes "[Yullo]";
						mes "完成任务后回来，我会给你一份小奖励。";
						setquest 60118;
						close;
					}
				case 3:
					mes "[Yullo]";
					mes "改变主意后，请再回来。";
					close;
				}
			case 2:
				mes "[Yullo]";
			mes "改变主意后，请再回来。";
				close;
			}
		}
		else {
			mes "[Yullo]";
			mes "你好，我叫 Yullo。";
			mes "等等，你的等级是不是有点太高了？";
			close;
		}
	}
	else {
		mes "[Yullo]";
		mes "嗯，这个请求对你来说可能有点难。";
		mes "等你长高变强后再回来。";
		close;
	}
}

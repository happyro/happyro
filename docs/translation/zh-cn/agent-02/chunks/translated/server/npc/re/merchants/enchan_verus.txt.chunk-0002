				mes "[Mass Charleston]";
				mes "发生了未知错误。";
				close3;
			}
			.@r = rand( .@en_brk1, .@en_brk2 );
			if (.@r < 11) .@en_name = 4700;	// Strength1
			else if (.@r < 21) .@en_name = 4701;	// Strength2
			else if (.@r < 31) .@en_name = 4720;	// Dexterity1
			else if (.@r < 41) .@en_name = 4721;	// Dexterity2
			else if (.@r < 50) .@en_name = 4730;	// Agility1
			else if (.@r < 59) .@en_name = 4731;	// Agility2
			else if (.@r < 69) .@en_name = 4740;	// Vitality1
			else if (.@r < 79) .@en_name = 4741;	// Vitality2
			else if (.@r < 89) .@en_name = 4710;	// Inteligence1
			else if (.@r < 99) .@en_name = 4711;	// Inteligence2
			else if (.@r < 100) .@en_name = 4869;	// Attack_Delay_1
			else if (.@r < 101) .@en_name = 4815;	// Spell1
			else .@en_name = 0;
			break;
		default:
			mes "[Mass Charleston]";
			mes "发生了未知错误。";
			close3;
		}
		if (Zeny < 100000 || countitem(6752) < 1) {
			mes "[Mass Charleston]";
			mes "商品升级所需的材料似乎不够！";
			close3;
		}

		// anti-hack
		if (callfunc("F_IsEquipIDHack", .@part, .@item_id) ||
				callfunc("F_IsEquipCardHack", .@part, .@card_saved[0], .@card_saved[1], .@card_saved[2], .@card_saved[3]) ||
				callfunc("F_IsEquipRefineHack", .@part, .@refine)) {
			mes "[Mass Charleston]";
				mes "发生了未知错误。";
			close3;
		}

		.@card[.@slot-1] = .@en_name;
		delitem 6752,1;	// Charleston_Parts
		Zeny -= 100000;
		delequip .@part;

		switch(.@en_name) {
		case 0:
			cutin "dalle02.bmp",2;
			specialeffect2 EF_SHIELDCHARGE;
			mes "[Mass Charleston]";
			mes "由于力量平衡不匹配，已有的能力被摧毁了。虽然很遗憾，请下次再试。";// unknown text
			getitem2 .@item_id,1,1,.@refine,0, .@card[0], .@card[1], .@card[2], .@card[3];
			close3;
		case 9:
			cutin "dalle04.bmp",2;
			specialeffect2 EF_SUI_EXPLOSION;
			mes "[Mass Charleston]";
			mes "糟了！";
			mes "很抱歉，装备被摧毁了。";// unknown text
			close3;
		default:
			specialeffect2 EF_REPAIRWEAPON;
			mes "[Mass Charleston]";
			mes "^990000插槽" + .@slot + "^000000 将被升级。";
			getitem2 .@item_id,1,1,.@refine,0, .@card[0], .@card[1], .@card[2], .@card[3];
			close3;
		}
	case 2:	// Reset
		// Note: the NPC doesn't check if the equipment is already enhanced
		if (getiteminfo(.@card[0], ITEMINFO_SUBTYPE) == CARD_ENCHANT) .@card[0] = 0;
		if (getiteminfo(.@card[1], ITEMINFO_SUBTYPE) == CARD_ENCHANT) .@card[1] = 0;
		if (getiteminfo(.@card[2], ITEMINFO_SUBTYPE) == CARD_ENCHANT) .@card[2] = 0;
		if (getiteminfo(.@card[3], ITEMINFO_SUBTYPE) == CARD_ENCHANT) .@card[3] = 0;
		specialeffect2 EF_REPAIRWEAPON;
		mes "[Mass Charleston]";
	mes "重置物品的能力。";
		delitem 6752,1;	// Charleston_Parts
		Zeny -= 100000;
		delequip .@part;
		getitem2 .@item_id,1,1,.@refine,0, .@card[0], .@card[1], .@card[2], .@card[3];
		close3;
	dfault:
		mes "[Mass Charleston]";
		mes "发生了未知错误。";
		close3;
	}
	end;
}

verus04,63,112,4	script	Mass Charleston#3	4_F_CHARLESTON01,{
	if (!checkweight(1201,1) || (MaxWeight - Weight) < 1000) {
	mes "^ff0000你携带的物品太多，请减少后再回来。^000000";
		close;
	}
	cutin "dalle03.bmp",2;
	mes "[Mass Charleston]";
	mes "嗯，有客人吗？启动销售员模式……";
	next;
	cutin "dalle01.bmp",2;
	mes "[Mass Charleston]";
	mes "查尔斯顿工厂的畅销商品：^FF0000升级部件板^000000和^FF0000补充部件力量^000000现已出售！";
	next;
	mes "[Mass Charleston]";
	mes "只要 ^FF00003,999,999^000000 Zeny！带走超高性能的行动装备吧！";
	next;
	mes "[Mass Charleston]";
	mes "还提供^FF0000打桩机^000000^FF0000升级^000000服务！";
	next;
	switch( select( "交谈。", "交换升级部件。", "交换补充装置。", "升级打桩机。" ) ) {
	case 1:
		if (isbegin_quest(13186) == 0) {
			mes "[Mass Charleston]";
		mes "查尔斯顿工厂关闭了，但它的技术和产品仍然留在我们这里。";
			next;
			mes "[Mass Charleston]";
		mes "哦，你没听说吗？哎呀，是我不好。请忘了我刚才说的话。";
			close3;
		}
		cutin "dalle03.bmp",2;
		mes "[Mass Charleston]";
	mes "我是量产型查尔斯顿，甚至没有序列号。谁知道制造了多少个我？也许一百个，甚至一千个。";
		next;
		mes "[Mass Charleston]";
	mes "原型查尔斯顿就站在那边，但是……";
		next;
		mes "[Mass Charleston]";
	mes "查尔斯顿 1 号和 2 号逃出工厂时已经严重受损。那天发生的战斗令人难以置信。";
		next;
		mes "[Mass Charleston]";
	mes "我仍记得查尔斯顿 1 号和 2 号摧毁 Ve 博士众多生物的情景，仿佛就在昨天。";
		next;
		mes "[Mass Charleston]";
	mes "他们还摧毁了 Ve 博士改造、听命于他的量产型查尔斯顿。";
		next;
		mes "[Mass Charleston]";
	mes "当然也有其他人——比如我们这些负责产品升级的机器人——幸运地逃离 Ve 博士的魔爪，遇到了拯救我们的查尔斯顿 1 号。";
		next;
		mes "[Mass Charleston]";
	mes "我们和改造后的查尔斯顿 3 号一起逃出来后，来到了这里。";
		next;
		mes "[Mass Charleston]";
	mes "顺便说一句，我们到这里时这里已经一片狼藉。这里的毁灭与我们无关。也许……";
		next;
		mes "[Mass Charleston]";
	mes "抱歉扯远了。总之，问题就在这里。";
		next;
		mes "[Mass Charleston]";
	mes "查尔斯顿 1 号和 2 号都损坏到无法正常运作。他们试图互相修理，却没有成功。";
		next;
		mes "[Mass Charleston]";
	mes "他们意识到损伤无法修复，于是尽可能回收零件，用一个操作系统组装了一具身体。";
		next;
		mes "[Mass Charleston]";
	mes "那就是新组装的身体。他们把工厂毁灭归咎于自己，想要修复它。恐怕他们的数据已损坏或缺失重要记忆。";
		next;
		mes "[Mass Charleston]";
	mes "数据特征更像查尔斯顿 2 号，而操作系统的访问方式更像查尔斯顿 1 号。查尔斯顿 1 号一直更感性。";
		next;
		mes "[Mass Charleston]";
	mes "我不知道新的查尔斯顿究竟是 1 号还是 2 号。我甚至无法判断它最思念或记得什么。";
		next;
		mes "[Mass Charleston]";
	mes "她一直责怪自己丢失数据、辜负朋友。每当我们试图安慰她时，";
		next;
		mes "[Mass Charleston]";
	mes "她都会说自己没有心或大脑去记忆或理解。我不知道她是否知道";
		next;
		mes "[Mass Charleston]";
	mes "人类的记忆会随时间淡去、扭曲或被美化。";
		next;
		mes "[Mass Charleston]";
	mes "人类会从错误和失败中学习。我在工厂那些名为^FF0000书籍^000000的纸质记忆装置中读到过。";
		next;
		mes "[Mass Charleston]";
	mes "工厂的^FF0000南翼^000000曾有一项小型研究。后来那里被改造成机器人开发室。";
		next;
		mes "[Mass Charleston]";
	mes "也许查尔斯顿比我们其他机器人更像人类。我只希望她不用这么悲伤。";
		next;
		mes "[Mass Charleston]";
		mes "操作系统让我感到拥堵，所以我发了牢骚。也许我该整理一下记忆。";
		close3;
	case 2:
		mes "[Mass Charleston]";
		mes "升级部件板";
		mes "类别：铠甲，不可破坏。";
		mes "受到小型和中型魔物的伤害 -10%。";
		mes "强化至 +7 时，受到大型魔物的伤害 -10%。";
		mes "强化至 +9 时，受到小型和中型魔物的伤害额外 -5%。";
		next;
		mes "[Mass Charleston]";
		mes "重量：300";
		mes "要求等级：100";
		callsub S_Buy, 15111;	// Upgrade_Part_Plate
	case 3:
		mes "[Mass Charleston]";
		mes "补充部件力量";
		mes "ATK+ 5%!";
		mes "每强化 4 级，攻击力额外 +1%。";
		mes "与体质/敏捷/灵巧补充装置一起使用效果最佳。";
		next;
		mes "[Mass Charleston]";
		mes "重量：200";
		mes "要求等级：100";
		callsub S_Buy, 15110;	// Supplement_Part_Str
	case 4:
		mes "[Mass Charleston]";
		mes "查尔斯顿工厂最后的杰作！你在其他地方绝对找不到如此优秀的装备。";
		next;
		mes "[Mass Charleston]";
		mes "升级打桩机需要：";
		mes "^FF00001 个打桩机^000000、";
		mes "^FF0000300 个凹陷铁板^000000、";
		mes "以及^FF000015 个损坏的引擎^000000。";
		next;
		switch( select( "打桩机 S", "打桩机 P", "打桩机 T" ) ) {
		case 1:
			mes "[Mass Charleston]";
			mes "打桩机 S";
			mes "类别：钝器";
			mes "ATK: 400";
			mes "每强化 2 级，攻击速度获得加成。";
			next;
			mes "[Mass Charleston]";
			mes "重量：300";
			mes "武器等级：4";
			mes "要求等级：130";
			mes "仅限机匠使用，附带 1 个卡槽。";
			.@item_id = 16030;	// Pilebuncker_S
			break;
		case 2:
			mes "[Mass Charleston]";
			mes "打桩机 P";
			mes "类别：钝器";
			mes "ATK: 450";
			mes "每强化 1 级，攻击力 +5。";
			next;
			mes "[Mass Charleston]";
			mes "重量：400";
			mes "武器等级：4";
			mes "要求等级：130";
			mes "仅限机匠使用。";
			.@item_id = 16031;	// Pilebuncker_P
			break;
		case 3:
			mes "[Mass Charleston]";
			mes "打桩机 T";
			mes "类别：钝器";
			mes "ATK: 400";
			mes "每强化 1 级，SP 消耗 -1%。";
			next;
			mes "[Mass Charleston]";
			mes "重量：350";
			mes "武器等级：4";
			mes "要求等级：130";
			mes "仅限机匠使用，附带 1 个卡槽。";
			.@item_id = 16032;	// Pilebuncker_T
			break;
		}
		break;
	}
	next;
	mes "[Mass Charleston]";
	mes "你真的要升级 ^FF0000" + getitemname(.@item_id) + "^000000 吗？";
	next;
	if (select( "建议你重新考虑。", "购买。" ) == 1) {
		mes "[Mass Charleston]";
	mes "这是笔划算的买卖，但你仍需谨慎决定。";
		close;
	}
	if (countitem(6751) > 299 && countitem(6750) > 14 && countitem(1549) > 0) {
		mes "[Mass Charleston]";
	mes "你不会后悔的！这可是查尔斯顿工厂的产品！";
		delitem 6751,300;	// Distorted_Iron_Plate
		delitem 6750,15;	// Wrong_Engine
		delitem 1549,1;		// Pilebuncker
		getitem .@item_id,1;
		close3;
	}
	mes "[Mass Charleston]";
	mes "升级所需材料不足。";
	close3;

S_Buy:
	.@item_id = getarg(0);
	mes "^FF0000仅限机匠^000000";
	mes "^FF0000价格：3,999,999 Zeny^000000";
	next;
	mes "[Mass Charleston]";
	mes "你真的要购买 ^FF0000" + getitemname(.@item_id) + "^000000 吗？";
	next;
	if (select( "建议你重新考虑。", "购买。" ) == 1) {
		mes "[Mass Charleston]";
		mes "这是笔划算的买卖，但你仍需谨慎决定。";
		close3;
	}
	//if (Zeny >= 3999998) {// typo?
	if (Zeny >= 3999999) {
		mes "[Mass Charleston]";
		mes "你不会后悔的！这可是查尔斯顿工厂的产品！";
		Zeny -= 3999999;
		getitem .@item_id,1;
		close3;
	}
	mes "[Mass Charleston]";

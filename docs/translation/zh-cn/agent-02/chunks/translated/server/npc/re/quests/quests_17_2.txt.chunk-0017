		npctalk "(◎ω◎)";
		break;
	case 9:
		npctalk "(*'▼'*)b";
		break;
	default:
		break;
	}
	sleep rand(1500,5000);
	donpcevent strnpcinfo(0) + "::OnMove";
	end;

OnInit:
	// (commented, no questinfo)
	// questinfo( QTYPE_QUEST, QMARK_YELLOW, "ep17_2_main >= 9 && isbegin_quest(5892) == 0" );

	questinfo( QTYPE_QUEST2, QMARK_YELLOW, "checkquest(5893,HUNTING) == 2 && checkquest(5894,HUNTING) == 2 && checkquest(5895,HUNTING) == 2" );
	questinfo( QTYPE_QUEST2, QMARK_YELLOW, "checkquest(5897,HUNTING) == 2 && checkquest(5898,HUNTING) == 2 && checkquest(5899,HUNTING) == 2" );

	questinfo( QTYPE_DAILYQUEST, QMARK_YELLOW, "isbegin_quest(5892) == 2 && checkquest(5896,PLAYTIME) == -1 && checkquest(5893,HUNTING) == -1" );
	questinfo( QTYPE_DAILYQUEST, QMARK_YELLOW, "isbegin_quest(5892) == 2 && checkquest(5900,PLAYTIME) == -1 && checkquest(5897,HUNTING) == -1" );

	questinfo( QTYPE_DAILYQUEST, QMARK_YELLOW, "isbegin_quest(5892) == 2 && checkquest(5896,PLAYTIME) == 2" );
	questinfo( QTYPE_DAILYQUEST, QMARK_YELLOW, "isbegin_quest(5892) == 2 && checkquest(5900,PLAYTIME) == 2" );
	donpcevent strnpcinfo(0) + "::OnMove";
	end;
}


// Sidequest quest : Be quiet in the Library! - Step 1
// ba_maison,70,145,3	script	Tamarin#ep172_bamaison-00	4_EP17_TAMARIN,{

// Sidequest quest : Be quiet in the Library! - Step 2
ba_maison,85,111,3	script	Fountain#ba	4_ENERGY_BLUE,{
	if (ep17_2_library == 1) {
		cloakoffnpcself( "Dew#ep172_fountain" );
		cutin "bu_du5",2;
		mes "[Dew]";
		mes "呃！呃！";
		mes "哈……我想我已经没事了。";
		next;
		cloakoffnpcself( "Mark#ep172_fountain" );
		cloakoffnpcself( "Magi#ep172_fountain" );
		cutin "bu_mark3",2;
		mes "[Mark]";
		mes "喂！！！";
		mes "你在喷泉里做什么！！！";
		mes "马上出来！！！";
		next;
		cloakoffnpcself( "Mansion Manager β#ep172_fountain" );
		cutin "ep172_beta",2;
		mes "[Mansion Manager β]";
		mes "警告。";
		mes "本设施不是用来清洁身体的。禁止进入。";
		next;
		cutin "bu_du5",2;
		mes "[Dew]";
		mes "呀啊啊！！！";
		mes "是谁！！！";
		next;
		cutin "ep172_beta",2;
		mes "[Mansion Manager β]";
		mes "我是[瓦尔蒙特大贤者宅邸]的宅邸管理员β。";
		mes "宅邸内的设施属于公共设施，供每位客人使用。";
		mes "使用设施时请遵守相关规定。";
		next;
		mes "[Mansion Manager β]";
		mes "设施使用异常时会被记录警告；如果警告累积，你将被请出宅邸。";
		next;
		mes "[Mansion Manager β]";
		mes "另外，宅邸地下室设有洗浴设施。我们建议来访客人前往大型浴场冥想之泉。";
		next;
		mes "[Mansion Manager β]";
		mes "那么，祝您度过舒适的时光。谢谢。";
		next;
		cloakonnpcself( "Mansion Manager β#ep172_fountain" );
		cutin "bu_du4",2;
		mes "[Dew]";
		mes "禁止在喷泉里洗澡是不是太过分了？";
		next;
		cutin "bu_mark3",2;
		mes "[Mark]";
		mes "不，这是必要的措施，但是……";
		next;
		cutin "bu_maggi4",2;
		mes "[Magi]";
		mes "马克……";
		mes "马克……";
		next;
		cutin "bu_mark2",2;
		mes "[Mark]";
		mes "嗯？";
		mes "怎么了？";
		next;
		cutin "bu_maggi4",2;
		mes "[Magi]";
		mes "看看那边的守卫。";
		mes "它们……全都被破坏了。";
		next;
		cloakoffnpcself( "Alp#ep172_fountain" );
		cutin "bu_alp3",2;
		mes "[Alp]";
		mes "我来的路上也看到了很多。";
		next;
		cutin "bu_mark4",2;
		mes "[Mark]";
		mes "不愧是心灵猎人……";
		mes "现在不是做这种事的时候。";
		mes "我们得赶快调查。";
		next;
		cutin "bu_maggi3",2;
		mes "[Magi]";
		mes "好！";
		mes "我不会让心灵猎人毁掉这个美好的地方！";
		next;
		cutin "bu_mark1",2;
		mes "[Mark]";
		mes "我们先去哪里呢……";
		next;
		cloakoffnpcself( "Oliver#ep172_fountain" );
		mes "[Oliver]";
		mes "当然是图书馆！";
		next;
		cutin "bu_alp3",2;
		mes "[Alp]";
		mes "哦！";
		mes "果然你懂行！！！那可是瓦尔蒙特大贤者！！！他是传说般的人物，无论在世时还是身后都无人超越。";
		next;
		mes "[Alp]";
		mes "据说如今的科学技术只能维持他奠定的基础，对于他的研究没有留下数据的领域便无法实现。";
		mes "这里就是收藏他所珍爱的研究资料的图书馆！！！虽然是私人图书馆，但听说比吉芬图书馆还大！！！我已经很久没有这么兴奋了！！！";
		next;
		cutin "bu_du5",2;
		mes "[Dew]";
		mes "呃……";
		mes "又来了……";
		mes "书痴发作了……";
		next;
		cutin "bu_maggi1",2;
		mes "[Magi]";
		mes "我也是！！！";
		mes "不知道里面有多少魔法书！";
		next;
		cutin "bu_mark2",2;
		mes "[Mark]";
		mes "听说瓦尔蒙特大贤者精通魔法和治愈，对吧？";
		mes "走吧！我们去图书馆。";
		ep17_2_library = 2;
		erasequest 11621;
		setquest 11622;
		close2;
		cutin "",255;
		cloakonnpcself( "Mark#ep172_fountain" );
		cloakonnpcself( "Magi#ep172_fountain" );
		cloakonnpcself( "Dew#ep172_fountain" );
		cloakonnpcself( "Alp#ep172_fountain" );
		cloakonnpcself( "Oliver#ep172_fountain" );
		navigateto("ba_in01",211,83);
		end;
	}
	if (ep17_2_library == 2) {
		cloakoffnpcself( "Mark#ep172_fountain" );
		cloakoffnpcself( "Magi#ep172_fountain" );
		cloakoffnpcself( "Dew#ep172_fountain" );
		cloakoffnpcself( "Alp#ep172_fountain" );
		cutin "bu_mark1",2;
		mes "[Mark]";
		mes "我们先去哪里呢……";
		next;
		cloakoffnpcself( "Oliver#ep172_fountain" );
		mes "[Oliver]";
		mes "当然是图书馆！";
		next;
		cutin "bu_alp3",2;
		mes "[Alp]";
		mes "哦！";
		mes "果然你懂行！！！那可是瓦尔蒙特大贤者！！！他是传说般的人物，无论在世时还是身后都无人超越。";
		next;
		mes "[Alp]";
		mes "据说如今的科学技术只能维持他奠定的基础，对于他的研究没有留下数据的领域便无法实现。";
		mes "这里就是收藏他所珍爱的研究资料的图书馆！！！虽然是私人图书馆，但听说比吉芬图书馆还大！！！我已经很久没有这么兴奋了！！！";
		next;
		cutin "bu_du5",2;
		mes "[Dew]";
		mes "呃……";
		mes "又来了……";
		mes "书痴发作了……";
		next;
		cutin "bu_maggi1",2;
		mes "[Magi]";
		mes "我也是！！！";
		mes "不知道里面有多少魔法书！";
		next;
		cutin "bu_mark2",2;
		mes "[Mark]";
		mes "听说瓦尔蒙特大贤者精通魔法和治愈，对吧？";
		mes "走吧！我们去图书馆。";
		close2;
		cutin "",255;
		cloakonnpcself( "Mark#ep172_fountain" );
		cloakonnpcself( "Magi#ep172_fountain" );
		cloakonnpcself( "Dew#ep172_fountain" );
		cloakonnpcself( "Alp#ep172_fountain" );
		cloakonnpcself( "Oliver#ep172_fountain" );
		navigateto("ba_in01",211,83);
		end;
	}
	mes "- 这是杜洗过身体的喷泉。";
	mes "幸运的是，似乎已经清理干净了。-";
	close;

OnInit:
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "isbegin_quest(11621) == 1" );
	end;
}


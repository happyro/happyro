// Sidequest quest : Be quiet in the Library! - Step 4, 6
// Daily quest : Hunting Bookworm
// Daily quest : Hunting Roaming Spellbook
ba_lib,157,19,5	script	Mansion Manager β#ep172_balib	4_EP17_BASIC_B,{
	if (checkweight(1000103,5) == 0) {
	mes "- 你的物品太多了。";
		mes "请清理背包后再试。-";
		close;
	}
	// Sidequest quest
	if (ep17_2_library < 3)	// no access, shouldn't happen
		end;
	if (ep17_2_library == 3) {
		cutin "ep172_beta",2;
		mes "[Mansion Manager β]";
		mes "在图书馆内请保持安静。另外，使用图书馆需要登记。未登记就无法阅读馆内的书籍。";
		next;
		select( "登记。" );
		mes "[Mansion Manager β]";
		mes "登记完成。";
		mes "要确认队伍成员的登记情况吗？";
		next;
		cutin "bu_du3",2;
		mes "[Dew]";
		mes "啊！";
		mes "我登记好了！";
		mes "其他人已经找到书，完全沉浸其中了……";
		mes "他们让我留在这里等着！";
		next;
		cutin "bu_du1",2;
		mes "[Dew]";
		mes "你已经登记过图书馆了，有想找的书吗？";
		mes "我对书没兴趣……你到处看看吧。";
		next;
		cutin "bu_du2",2;
		mes "[Dew]";
		mes "你参观的时候，告诉其他人也要登记……回头见~~~";
		ep17_2_library = 4;
		erasequest 11623;
		setquest 11624;
		setquest 11625;
		setquest 11626;
		setquest 11627;
		setquest 11628;
		close3;
	}
	if (ep17_2_library == 4) {
		if (F_queststatus(HAVEQUEST, 11629,11630,11631,11632,11633) != 1) {
			cutin "ep172_beta",2;
			mes "[Mansion Manager β]";
			mes "在图书馆内请保持安静。另外，使用图书馆需要登记。未登记就无法阅读馆内的书籍。";
			next;
			mes "[Mansion Manager β]";
			mes "要确认队伍成员的登记情况吗？";
			next;
			cutin "bu_du3",2;
			mes "[Dew]";
			mes "啊！";
			mes "我登记好了！";
			mes "其他人已经找到书，完全沉浸其中了……";
			mes "他们让我留在这里等着！";
			next;
			cutin "bu_du1",2;
			mes "[Dew]";
			mes "你已经登记过图书馆了，有想找的书吗？";
			mes "我对书没兴趣……你到处看看吧。";
			next;
			cutin "bu_du2",2;
			mes "[Dew]";
			mes "你参观的时候，告诉其他人也要登记……回头见~~~";
			close3;
		}
		cutin "ep172_beta",2;
		mes "[Mansion Manager β]";
		mes "感谢您确认队伍登记情况。";
		mes "" + strcharinfo(0) + "以及4……5……4……6……7……4……3……名成员已完成登记。";
		mes "感谢您的配合。";
		ep17_2_library = 5;
		erasequest 11629;
		erasequest 11630;
		erasequest 11631;
		erasequest 11632;
		erasequest 11633;
		getitem 1000103,5;
		getexp 1031336,0;
		close3;
	}
	// Daily quests
	cutin "ep172_beta",2;
	mes "[Mansion Manager β]";
	mes "您好，" + strcharinfo(0) + "。";
	mes "以下委托仅面向图书馆用户，期待得到您的协助。";
	next;
	.@quest_menu$[0] = callsub( S_Menu, 11634,11635, "终极书虫" );
	.@quest_menu$[1] = callsub( S_Menu, 11636,11637, "终极魔法书" );

	switch( select( .@quest_menu$[0], .@quest_menu$[1], "取消" ) ) {
	case 1:
		.@hunt = 11634;
		.@cooldown = 11635;
		setarray .@exp[0],910040,637040;
		break;
	case 2:
		.@hunt = 11636;
		.@cooldown = 11637;
		setarray .@exp[0],934000,653800;
		break;
	case 3:
		mes "[Mansion Manager β]";
		mes "祝您平安，度过舒适的时光。";
		close3;
	}
	switch( checkquest(.@cooldown,PLAYTIME) ) {
	case -1:
		break;
	case 0:
	case 1:
		mes "[Mansion Manager β]";
		mes "今天的工作已经完成了。";
		mes "谢谢。";

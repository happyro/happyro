dewata,75,122,6	script	Monk#dewt1	834,{
	mes "[Monk]";
	mes "你是这里的陌生人。是什么把你带到这片宁静之地？";
	next;
	switch(select("我来观光。:没什么原因。")) {
	case 1:
		mes "[Monk]";
		mes "哦，你是游客。这是供奉伟大佛陀的^0000FF佛塔^000000。请尊重在此祈祷的僧侣。";
		close;
	case 2:
		mes "[Monk]";
		mes "祝你今天愉快……";
		close;
	}
}

dewata,69,101,6	script	Monk#dewt2	834,{
	mes "[Monk]";
	mes "我们有供奉佛陀的佛塔。每座寺庙都有这样的塔，不过除了僧侣，很少有人来这里。";
	next;
	switch(select("我明白了……:解释一下佛陀:啊，好吧。")) {
	case 1:
		mes "[Monk]";
		mes "你必须感受我们佛陀的慈悲！";
		close;
	case 2:
		mes "[Monk]";
		mes "佛陀是德瓦塔神话中的神，是灵魂之王，也是善神的领袖。";
		next;
		mes "[Monk]";
		mes "佛陀是灵魂的守护者，传统舞蹈常描绘他与魔法师 Rangda 战斗。";
		next;
		mes "[Monk]";
		mes "在德瓦塔，我们相信有许多神祇守护每座岛屿和部族地区，";
		next;
		mes "[Monk]";
		mes "因此佛陀有不同化身，通常被描绘成熊、虎、龙、蛇或狮子。";
		next;
		mes "[Monk]";
		mes "伟大的狮子是德瓦塔供奉的著名佛陀之一。";
		next;
		mes "[Monk]";
		mes "希望解释得够清楚。如果还想了解其他事情，请告诉我。";
		close;
	case 3:
		mes "[Monk]";
		mes "祝你今天愉快……";
		close;
	}
}


		//============================================================
		prontera,167,281,3	script	New Guild Master#tu	4_M_MONK,{
		mes "[New Guild Master]";
		mes "听好了，所有追求名望与荣耀的人！";
		next;
	mes "[New Guild Master]";
	mes "我手中的^3131FF伊米尔之心^000000证明我受命运眷顾！勇士们，把你们的力量借给我！";
		next;
	mes "[New Guild Master]";
		mes "没有什么能阻止我们！";
		mes "只要这颗宝石在我手中，";
		mes "称自己为我同伴的人";
		mes "就永远不会尝到失败的滋味！";
		if(tu_archer02 == 3) tu_archer02 = 4;
		close;
		}

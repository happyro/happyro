			mes "趁我再次睡着前，快收下这个～！^666666*哈欠*^000000";
			} else {
		mes "好～！";
			mes "让我试着施放法术";
			mes "帮助你！呀～哈！";
			}
			switch(rand(4)) {
		case 0: npcskill "AL_HEAL",3,90,62; break;
		case 1: npcskill "AL_HEAL",10,90,62; break;
			case 2: npcskill "AL_HEAL",8,90,62; break;
			}
			switch(rand(3)) {
		case 0: npcskill "AL_INCAGI",1,0,0; break;
		case 1: npcskill "AL_INCAGI",5,0,0; break;
			case 2: npcskill "AL_INCAGI",10,0,0; break;
			}
			switch(rand(3)) {
		case 0: npcskill "AL_BLESSING",1,0,0; break;
		case 1: npcskill "AL_BLESSING",5,0,0; break;
			case 2: npcskill "AL_BLESSING",10,0,0; break;
			}
			close;
		}
		mes "...";
	mes "为、为什么旅行会让我";
	mes "这么困……？";
	mes "^666666Zzzzzzzz...^000000";
	specialeffect EF_SLEEPATTACK;
	close;
	}
	// Alchemist Guildmember
	//============================================================

pay_arche,130,113,3	script	Alchemist Guildmember#tu	2_M_ALCHE,{
mes "[Alchemist Guildmember]";
if(tu_archer02 > 0){
if((countitem(1032) > 0) || (countitem(905) > 0 )){	// Blossom_Of_Maneater & Stem
	mes "太好了……！";
	mes "我一直在等伊卡鲁斯公会";
		mes "派人来帮助我们！终于来了！";
			emotion ET_CRY;
			next;
			mes "[Alchemist Guildmember]";
			mes "你愿意把^3131FF树枝^000000和^3131FF食人花花朵^000000卖给炼金术士公会吗？";
			mes "每根树枝我们出价^3131FF30 Zeny^000000，";
			mes "每朵食人花花朵出价^3131FF130 Zeny^000000。";
			next;
			switch(select("卖出所有树枝和食人花花朵:什么也不卖。")) {
			case 1:
			mes "[Alchemist Guildmember]";
			mes "非常感谢！";
			mes "这对维护我们的植物田";
			mes "帮助很大！真的很感谢你的帮忙～";
			.@alche_f = countitem(1032); // Blossom_Of_Maneater
			.@alche_s = countitem(905); // Stem
			.@total_zeny = .@alche_f * 130 + .@alche_s * 30;
				if (countitem(1032))
				delitem 1032, .@alche_f; //Blossom_Of_Maneater
				if (countitem(905))
				delitem 905, .@alche_s; //Stem
				Zeny = Zeny+.@total_zeny;
				
close;
				case 2:
				mes "[Alchemist Guildmember]";
				mes "真是的……";
				mes "我都快要开口求你了！";
					mes "炼金术士公会真的需要大量补给来维持植物田！";
				emotion ET_CRY;
					close;
				}
				} else {
			mes "不知道你有没有听卡瓦鲁克说过，";
				mes "我们的植物田正被流浪猫破坏。";
				emotion ET_CRY;
				next;
				mes "[Alchemist Guildmember]";
				mes "不管我们怎么赶走它们，它们总能回来。";
				mes "我们只能替换被它们破坏的植物。";
			next;
		mes "[Alchemist Guildmember]";
			mes "如果你能带来^3131FF树枝^000000和^3131FF食人花花朵^000000帮助维护田地，我们会奖励你。";
			mes "这些植物为公会提供资金，非常重要。没有它们……";
			close;
			}
			}
			mes "^666666*Sigh...*^000000";
			mes "难道没人来帮我们吗？";
			mes "我们正面临一场巨大的危机！";
			close;
			}
			// Arthail
			//============================================================
		prontera,126,335,5	script	Arthail	1_M_BARD,{
	mes "[Arthail]";
	if(tu_archer02 < 3){
	mes "我是只为自己歌唱的吟游诗人。";
	mes "轻柔的微风是我唯一的听众。";
	next;
	mes "[Arthail]";

mes "我是风之阿赛尔。";
mes "我不为任何人歌唱，";
mes "你最好离开。抱歉，我没有歌可分享。";
if(tu_archer02 == 2) {
	next;
	select("卡瓦鲁克大师让我来找你！");
		mes "[Arthail]";
		mes "真的吗？";
		mes "看来也没办法。";
		mes "我确实应该联系他的。";
		next;
		mes "[Arthail]";
		mes "不过长途旅行让我很疲惫。这座城市拥挤不堪，还有数百人在说话，我实在受不了……";
		next;
		mes "[Arthail]";
		mes "为什么我不能像其他人一样？我越接近人群，内心反而越想逃离。我也不知道为什么。";
		next;
		mes "[Arthail]";
		mes "我成为吟游诗人，想解决自己的社交恐惧，却没有成功。";
		mes "不过歌唱时我会轻松许多。啊，我已经说得太多了。";
			next;
			mes "[Arthail]";
			mes "卡瓦鲁克大师让你来帮助我？";
			mes "那么，我有件事想请你帮忙。";
			next;
			mes "[Arthail]";
			mes "在卢恩·米德加尔王国的首都，中央广场据说有一座喷泉。大家似乎都会在那里停下聊天。";
			next;
			mes "[Arthail]";
			mes "不过我害怕和人相处，无法靠近那里的人群。作为吟游诗人承认这一点真丢脸……";
			next;
			mes "[Arthail]";
			mes "你能替我去看看那一带有没有什么新闻流传吗？";
			tu_archer02 = 3;
			}
			}
			else if(tu_archer02 == 3){
			mes "不好意思开口，";
			mes "但你能去普隆德拉中央广场的喷泉，看看有没有什么新闻吗？";
			}
			else if(tu_archer02 == 4){
			mes "我明白了……";
			mes "没什么特别的。";
			mes "只是又有人找到伊米尔之心，";
			mes "开始建立全新的公会……";
			next;
			mes "[Arthail]";
			mes "^3131FFEmperium^000000...";
			mes "梦罗克有很多野心勃勃的人想要它。就连我的故乡斐扬，也有人争相获取……";
			next;
			mes "[Arthail]";
			mes "据说拥有伊米尔之心就能获得改变世界的力量。人们自然会被它吸引。";
			next;
			mes "[Arthail]";
			mes "嗯……？";
			mes "我感觉到某种黑暗而不祥的气息……";
		mes "不知道那究竟是什么？";
	emotion ET_SCRATCH;
	next;
		mes "[Arthail]";
		mes "我大概只是压力太大又累了。休息后就会好些。你愿意和我一起听流水声吗？";
		next;
	mes "[Arthail]";
	mes "在这里待太久感觉并不好，但流水声让我想起家乡。你见过伊卡鲁斯公会旁的湖吗？这里的水让我想起那里。";
		next;
		mes "[Arthail]";
		mes "^333333*Yawn...*^000000";
		mes "我已经很久没这样说话了。";
		mes "我太累了，先休息一会儿……";
		next;
		mes "[Arthail]";
		mes "..........";
		next;
		mes "^3355FF风之阿泰尔";
		mes "已经沉沉睡去。^000000";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "啊……";
		mes "真平静～";
		next;
		mes "^3355FF拍岸水声的节奏让你渐渐完全放松。若把脚浸入冰凉清澈的水中，一定会非常舒爽……^000000";
		//sound "se_subterranean_waterwave.wav" 1 0 0
		next;
		mes "[???]";
		mes "...";
		soundeffectall "se_littlewaves02.wav",0;
		next;
		mes "["+strcharinfo(0)+"]";
		mes "咦？";
		mes "那是什么声音？";
		next;
		mes "[????]";
		mes "啊啊啊啊啊啊啊啊啊啊啊！！！！！";
		emotion ET_HUK;
		soundeffectall "se_scream_w01.wav",0;
		next;
		mes "["+strcharinfo(0)+"]";
		mes "什么——？！";
		mes "听起来像是";
		mes "普隆德拉城堡内部传来的尖叫声！";
		next;
		mes "^3355FF你试图叫醒阿赛尔，";
		mes "但他睡得很沉，完全不动。^000000";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "那也没办法。";
		mes "我最好自己去调查。";
		tu_archer02 = 5;
		}
		else if(tu_archer02 > 4 && tu_archer02 < 7)
		mes "^333333Zzzzz...^000000";
		else if(tu_archer02 == 8){
		mes "你去哪了？醒来发现你不在，我还以为你被绑架了。";
		next;
		mes "[Arthail]";
		mes "所以你问起听到的尖叫时，大家都说什么也没发生？";
		mes "真奇怪……";
		next;
		mes "[Arthail]";
		mes "还有你之前提到的伊米尔之心。我以为那是稀有物品，为什么这么多人都能轻易得到？真奇怪……";
		next;
		mes "[Arthail]";
		mes "嗯，我最好继续调查。我要留在这里收集更多信息。";
		mes "现在你先回斐扬，告诉卡瓦鲁克大师我一切都好。";
		next;
		mes "[Arthail]";
		mes "总有一天……";
		mes "我一定会写出一首";
		mes "能与你分享的歌。";
		tu_archer02 = 9;
		}
		else {
		mes "...";
		mes "......";
		}
		close;
		}

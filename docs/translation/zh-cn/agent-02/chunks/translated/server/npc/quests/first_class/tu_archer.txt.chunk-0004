		prontera,144,301,5	script	Mage#tu	2_F_MAGICMASTER,{
		mes "[Mage]";
		mes "你看到那个新公会会长了吗？";
		mes "真会自我吹嘘！";
		next;
		emotion ET_HNG;
		mes "[Mage]";
		mes "他不知道现在有很多著名公会吗？";
		mes "谁会想加入他那个无名小公会？";
		next;
		mes "[Mage]";
		mes "如果我成为巫师，我要加入最好的公会。";
		mes "施法帮助最强的骑士和牧师，一定很酷！";
		next;
		mes "[Mage]";
	mes "哇哈哈哈！";
	mes "光是想想就让我兴奋！";
		close;
		}
	
	// Minister
//============================================================
-	script	Minister#tu_	-1,{
mes "[Minister]";
mes "王室目前非常忙碌，";
mes "正在处理国家政务。";
	if(tu_archer02 == 5){
	next;
	mes "["+strcharinfo(0)+"]";
	mes "我听到外面有尖叫声！";
	mes "发生什么事了吗？";
	next;
	mes "[Minister]";
	mes "...";
	mes "......";
	next;
	mes "[Minister]";
	mes "啊，只是几只到处乱跑的流浪猫，也就是野玫瑰。你听到的声音一定是它们发出的。宫殿里一切正常。";
	tu_archer02 = 6;
	}
	else if(tu_archer02 == 7){
	next;
	mes "^3355FF大臣先前表现出的急切已被冰冷严肃的态度取代。无论你怎么询问，他恐怕都不会再透露更多。";
	
}
else if(tu_acolyte01 == 25){
next;
mes "["+strcharinfo(0)+"]";
mes "呃……我听说王室似乎遇到了麻烦。有什么我能帮忙的吗？";
	next;
	mes "[Minister]";
	mes "...";
	mes "......";
	next;
	mes "[Minister]";
	mes "你一定弄错了。王室很好，尤其是我们的王国正处于和平时期。";
	next;
	mes "[Minister]";
	mes "也许你这么想是因为很难见到王室成员。请理解，他们都在忙着为人民服务。";
	next;
	mes "[Minister]";
	mes "作为神圣的侍者，宫殿外还有许多需要你帮助和能力的人。";
	}
	close;
	}
	// Range NPC
	//============================================================
	-	script	#sound_tu_	-1,{
	end;
	OnTouch_:
	if(tu_archer02 == 6) {
	
mes "[Minister]";
mes "联系普隆德拉教会。";
mes "快，这很紧急！";
tu_archer02 = 7;
close;
	}
	end;
	}
	// Bishop Maugins
	//============================================================
	monk_in,19,43,1	script	Bishop Maugins	1_M_PASTOR,{
		mes "[Bishop Maugins]";
		if(tu_archer02 == 7){
		mes "你好。";
		mes "我想你不是来转职武僧的，但有什么我能帮忙的吗？你是来忏悔的吗？";
		next;
		mes "[Bishop Maugins]";
		mes "嗯？关于宫殿的工作？是的，我负责那一带。有什么事？";
		next;
		if (select("王国发生什么事了吗？:没什么。") == 1) {
		mes "[Bishop Maugins]";
		mes "...!!";
		next;
		mes "[Bishop Maugins]";
	mes "...";
	mes "......";
		next;
		mes "[Bishop Maugins]";
		mes "呵呵～";
		mes "当然没有！我和国王经常通信，但没听说什么特别的事。请不要担心。";
	next;
	tu_archer02 = 8;
		}
		mes "[Bishop Maugins]";
		mes "勇敢的冒险者，";
		mes "祝你的旅途好运。";
		npcskill "AL_INCAGI",10,0,0;
		npcskill "AL_BLESSING",10,0,0;
		close;
		}
		mes "抱歉，我现在有要紧事要考虑。";
		mes "请稍后再来好吗？";
		close;
		}

	mes "优质商品并不罕见，请先确认你的钱包够深！";
	close3;
}


// Excellion
verus04,161,222,4	script	Grandpa picking up scrap iron	1_M_HOF,{
	switch( isbegin_quest(12368) ) {
	case 0:
		mes "[Grandpa picking up scrap iron]";
		mes "我看到两块价值不菲的废铁，想捡起来卖给回收箱，结果它们不愿和我交易。";
		next;
		mes "[Grandpa picking up scrap iron]";
		mes "因为那不是铁吗？资源回收处都不肯收，真让人头疼！";
		close;
	case 1:
		mes "[Grandpa picking up scrap iron]";
		mes "嘿！你刚才是在和那块废铁说话吗？还是我的视力出问题了？";
		close;
	case 2:
		mes "[Grandpa picking up scrap iron]";
		mes "天啊！那东西不能卖给回收箱！";
		close;
	}
}

verus04,163,219,4	script	PLUTO_09#pa0829	4_SCR_AT_ROBOTS,{
	disable_items;
	if (checkweight(1201,1) == 0 || (MaxWeight - Weight) < 10000) {
	mes "^ff0000你携带的物品太多，请减少后再回来。^000000";
		close;
	}
	if (isbegin_quest(12368) < 2) {
	mes "^0000ff液晶屏仍然昏暗，但似乎已经无法工作。^000000";
		close;
	}
	mes "^0000ff出现奇怪的恐龙图案时，进入介绍画面。^000000";
	next;
	mes "[PLUTO_09]";
	mes "" + strcharinfo(0) + "，";
	mes "你好。我能帮你什么？";
	next;
	switch( select( "说明", "用旧燃料和巨大金属废料交换装备。", "附魔制作设计图" ) ) {
	case 1:
	mes "^0000ff屏幕上出现恐龙图案，还有可爱女孩声音的说明。^000000";
		next;
		mes "[PLUTO_09]";
	mes "距离新 PLUTO_09 诞生已经 100 年了。";
		next;
		mes "[PLUTO_09]";
	mes "带来巨大金属废料和旧燃料，就能制作对你有用的装备哦~";
		next;
		mes "[PLUTO_09]";
	mes "想制作附魔装备吗？把装备带来！我可以按照设计图为你附魔。祝你好运。";
		next;
		mes "[PLUTO_09]";
	mes "这是出现在恐龙童话里的霸王龙，非常美丽……（继续播放无聊的恐龙故事）";
		next;
	mes "^0000ff从这段介绍来看，机器人制造者的心理状态似乎极不稳定。^000000";
		close;
	case 2:
		setarray .@id[0],20773,15128; // Excelion_Wing, Excelion_Suit
		mes "[PLUTO_09]";
	mes "制作装备需要^0000ff10 个巨大金属废料和 5 个旧燃料^000000。";
		next;
	switch( select( "退出。", "制作" + getitemname(.@id[0]), "制作" + getitemname(.@id[1]) ) ) {
		case 1:
	mes "^0000ff恐龙盯着画面看了一会儿，然后闭上了眼睛。^000000";
			close;
		case 2:
			.@item_id = .@id[0];
			break;
		case 3:
			.@item_id = .@id[1];
			break;
		}
		if (countitem(6961) < 10 || countitem(6962) < 5) {
			mes "[PLUTO_09]";
	mes "我已经说过制作装备需要^0000ff10 个" + getitemname(6961) + "和 5 个" + getitemname(6962) + "^000000，你的材料不够。";
			close;
		}
		specialeffect EF_SPELLBREAKER;
		delitem 6962,5;// OldTank
		delitem 6961,10;// LargeScrap
		getitem .@item_id,1;
		mes "[PLUTO_09]";
	mes "你的装备做好了。看看是否合适。";
		close;
	case 3:
		while(1) {
			if (countitem(6962) < 5)
				.@string$ = "^aaaaaaInsufficient fuel for making design drawings.^000000";
			else
				.@string$ = "Production design (^ff0000 success rate 30%^000000)";
			mes "[PLUTO_09]";
	mes "如果给我 5 个" + getitemname(6962) + "，我就能制作设计图！";
	mes "----------";
	mes "^0000ff小恐龙在屏幕上跑来跑去。^000000";
			next;
	if (select( "退出。", .@string$ ) == 1) {
		mes "^0000ff画面显示恐龙吃饱后，演示结束。^000000";
				close;
			}
			.@fail = false;
			.@reac_rnd = rand(1,10000);
			if (.@reac_rnd < 26)		.@en_name = 6977;	// Reactor_A_STR_
			else if (.@reac_rnd < 51)	.@en_name = 6978;	// Reactor_A_INT_
			else if (.@reac_rnd < 251)	.@en_name = 6979;	// Reactor_A_DEF_
			else if (.@reac_rnd < 326)	.@en_name = 6981;	// Reactor_A_ATK_
			else if (.@reac_rnd < 401)	.@en_name = 6982;	// Reactor_A_MATK_
			else if (.@reac_rnd < 601)	.@en_name = 6980;	// Reactor_A_AVOI_
			else if (.@reac_rnd < 801)	.@en_name = 6983;	// Reactor_A_MHP_
			else if (.@reac_rnd < 1001)	.@en_name = 6984;	// Reactor_A_MSP_
			else if (.@reac_rnd < 1151)	.@en_name = 6986;	// Reactor_A_ASPD_
			else if (.@reac_rnd < 1401)	.@en_name = 6975;	// Reactor_Cure_201_
			else if (.@reac_rnd < 1551)	.@en_name = 6976;	// Reactor_Cure_202_
			else if (.@reac_rnd < 1751)	.@en_name = 6973;	// Reactor_Cure_101_
			else if (.@reac_rnd < 1851)	.@en_name = 6974;	// Reactor_Cure_102_
			else if (.@reac_rnd < 1901)	.@en_name = 6985;	// Reactor_A_FROZ_
			else if (.@reac_rnd < 2101)	.@en_name = 6970;	// Reactor_T_WATER_
			else if (.@reac_rnd < 2301)	.@en_name = 6971;	// Reactor_T_GROUND_
			else if (.@reac_rnd < 2501)	.@en_name = 6969;	// Reactor_T_FIRE_
			else if (.@reac_rnd < 2701)	.@en_name = 6972;	// Reactor_T_WIND_
			else if (.@reac_rnd < 2776)	.@en_name = 6966;	// Reactor_P_WATER_
			else if (.@reac_rnd < 2851)	.@en_name = 6967;	// Reactor_P_GROUND_
			else if (.@reac_rnd < 2926)	.@en_name = 6965;	// Reactor_P_FIRE_
			else if (.@reac_rnd < 3001)	.@en_name = 6968;	// Reactor_P_WIND_
			else {
				.@fail = true;
				.@reac_rnd2 = rand(1,13000);
				if (.@reac_rnd2 < 2)
					.@en_name = 969;	// Gold
				else if (.@reac_rnd2 < 1002)
					.@en_name = 999;	// Steel
				else if (.@reac_rnd2 < 3002)
					.@en_name = 998;	// Iron
				else if (.@reac_rnd2 < 8002)
					.@en_name = 1002;	// Iron_Ore
				else
					.@en_name = 7054;	// Brigan
			}
			if (countitem(6962) < 5)
	mes "^0000ff画面显示恐龙默默看着空碗，可能是材料不足的错误提示！^000000";
			else {
				specialeffect EF_SPELLBREAKER;
				delitem 6962,5;// OldTank
				getitem .@en_name,1;
				mes "[PLUTO_09]";
				if (.@fail)
	mes "真遗憾，设计失败了。";
				else
	mes "太好了，设计图制作完成。";
			}
			next;
		}
		end;
	default:
	mes "^0000ff屏幕显示恐龙嚎叫，可能是它无法理解指令。^000000";
		close;
	}
	end;
}

verus04,165,217,4	script	MARS_01#pa0829	4_SCR_MT_ROBOTS,{
	disable_items;
	if (checkweight(1201,1) == 0 || (MaxWeight - Weight) < 10000) {
		mes "^ff0000你携带的物品太多了，请减轻负重后再回来。^000000";
		close;
	}
	switch( isbegin_quest(12368) ) {
	case 0:
	mes "模糊的液晶屏可能是在害怕、开心或剧烈晃动，也许是电力不足，无法完成演示。";
		next;
	if (select( "就这样无视它。", "按下所有按钮。" ) == 1) {
		mes "它可能只是随处可见的废旧机器人，不值得关注。";
			close;
		}
		mes "[?????]";
	mes "你好！我是探索机器人 MARS_01。目前为了节省能源，我已进入休眠模式。相关功能设置如下。";
		next;
	if (select( "中断机器", "提供燃料" ) == 1) {
		mes "机器人发出微弱声音后重新进入休眠模式。";
			close;
		}
		mes "[MARS_01]";
	mes "我们是超级能源机器人，只要有 1 个旧燃料，我和伙伴 PLUTO 的电量就能超过 90%。";
		next;
		mes "[MARS_01]";
	mes "如果你找到旧燃料，请把燃料放入屏幕底部的入口，就能解除休眠模式。";
		setquest 12368;	// Operate the old robot
		close;
	case 1:
		if (countitem(6962) < 1) {
			mes "[MARS_01]";
	mes "如果你找到 1 个" + getitemname(6962) + "，请把燃料放入屏幕底部的入口，就能解除休眠模式。";
			close;
		}
	mes "我们寻找燃料时可能耗尽了电力。要放入燃料吗？";
		next;
	if (select( "退出。", "放入燃料" ) == 1) {
		mes "旧机器人可能电力耗尽，完全没有反应。";
			close;
		}
	mes "放入燃料后，屏幕发出声音并打开。";
	npctalk "哇，哇？！它动了！！！", "Grandpa picking up scrap iron";
		next;
		mes "[MARS_01]";
	mes "启动检查系统，确认各部位的损伤。";
		next;
		mes "[MARS_01]";
	mes "电量 10%，仪表盘正常，身体骨架 13%，采矿作业良好。";
		next;
		mes "[MARS_01]";
	mes "Pluto_09 开始为采矿辅助机器人注入能源。";
	npctalk "确认能量响应。正在运作。", "PLUTO_09#pa0829";
		next;
		mes "[MARS_01]";
	mes "谢谢你启动我，我会将启动我的人设为管理员。";
		next;
	select("输入姓名。" );
		mes "[MARS_01]";
	mes "" + strcharinfo(0) + "，";
	mes "你好！燃料已经充满。";
		delitem 6962,1;// OldTank
		completequest 12368;
		close;
	case 2:
		break;
	}
	mes "[MARS_01]";
	mes "" + strcharinfo(0) + "，";
	mes "你好！我能帮你吗？";
	next;
	switch( select( "说明", "强化" + getitemname(20773), "强化" + getitemname(15128) ) ) {	// Excelion_Wing, Excelion_Suit
	case 1:
		mes "^0000ff再次显示说明。^000000";
		next;
		mes "[MARS_01]";
		mes "在等待新主人期间，我们会继续更新到最新版本。";
		next;
		mes "[MARS_01]";
		mes "带来赛里翁推进翼、赛里翁夹克装备和强化设计图后，我会按照设计图强化装备。";
		next;
		mes "[MARS_01]";
		mes "根据标准设计图，装备在过程中不会损坏，但最大升级次数会因装备类型而变化。";
		next;
		mes "[MARS_01]";
		mes "欢迎再次回来~";
		close;
	case 2:
		.@part = EQI_GARMENT;
		break;
	case 3:
		.@part = EQI_ARMOR;
		break;
	}
	// <item ID required>, <item enchant ID>, <max number of this enchant on armor>, <max number of this enchant on garment>, <enchant on first slot only>
	setarray .@list[0],
		6965, 4970, 1,0,3,	// Reactor_P_FIRE_		Reactor_P_FIRE
		6966, 4971, 1,0,3,	// Reactor_P_WATER_		Reactor_P_WATER
		6967, 4972, 1,0,3,	// Reactor_P_GROUND_	Reactor_P_GROUND
		6968, 4973, 1,0,3,	// Reactor_P_WIND_		Reactor_P_WIND
		6969, 4974, 0,3,0,	// Reactor_T_FIRE_		Reactor_T_FIRE
		6970, 4975, 0,3,0,	// Reactor_T_WATER_		Reactor_T_WATER
		6971, 4976, 0,3,0,	// Reactor_T_GROUND_	Reactor_T_GROUND
		6972, 4977, 0,3,0,	// Reactor_T_WIND_		Reactor_T_WIND
		6973, 4978, 3,3,0,	// Reactor_Cure_101_	Reactor_Cure_101
		6974, 4979, 3,3,0,	// Reactor_Cure_102_	Reactor_Cure_102
		6975, 4980, 3,3,0,	// Reactor_Cure_201_	Reactor_Cure_201
		6976, 4981, 3,3,0,	// Reactor_Cure_202_	Reactor_Cure_202
		6977, 4982, 1,0,0,	// Reactor_A_STR_		Reactor_A_STR
		6978, 4983, 1,0,0,	// Reactor_A_INT_		Reactor_A_INT
		6979, 4984, 3,3,0,	// Reactor_A_DEF_		Reactor_A_DEF
		6980, 4985, 1,1,0,	// Reactor_A_AVOI_		Reactor_A_AVOI
		6981, 4986, 3,3,0,	// Reactor_A_ATK_		Reactor_A_ATK
		6982, 4987, 3,3,0,	// Reactor_A_MATK_		Reactor_A_MATK
		6983, 4988, 3,3,0,	// Reactor_A_MHP_		Reactor_A_MHP
		6984, 4989, 3,3,0,	// Reactor_A_MSP_		Reactor_A_MSP
		6985, 4990, 1,0,0,	// Reactor_A_FROZ_		Reactor_A_FROZ
		6986, 4991, 1,1,0;	// Reactor_A_ASPD_		Reactor_A_ASPD
	.@size = getarraysize(.@list);

	for ( .@i = 0; .@i < .@size; .@i += 5 ) {
		if (countitem(.@list[.@i]) < 1)
			.@menu$ += sprintf( "^aaaaaa%s (Missing)^000000:", getitemname(.@list[.@i]) );
		else
			.@menu$ += sprintf( "%s:", getitemname(.@list[.@i]) );
	}
	mes "[MARS_01]";
	mes "" + strcharinfo(0) + "，";
	mes "选择你想使用的附魔！";
	next;
	.@s = select("退出。:" + .@menu$) - 2;
	if (.@s < 0) {
		mes "[MARS_01]";
	mes "到目前为止。";
		close;
	}
	.@s *= 5;
	.@item_req = .@list[.@s];
	.@item_enchant_id = .@list[.@s+1];
	.@first_slot_only = .@list[.@s+4];

	.@equip_id = getequipid(.@part);
	.@equip_refine = getequiprefinerycnt(.@part);
	setarray .@card[0], getequipcardid(.@part,0), getequipcardid(.@part,1), getequipcardid(.@part,2), getequipcardid(.@part,3);

	if (countitem(.@item_req) < 1) {
		mes "[MARS_01]";
	mes "到目前为止。";
		close;
	}
	if (.@part == EQI_ARMOR)
		.@max_num_enchant = .@list[.@s+2];
	else if (.@part == EQI_GARMENT)
		.@max_num_enchant = .@list[.@s+3];
	else {
		mes "[MARS_01]";
		mes "请联系管理员。";
		close;
	}

	// anti-hack
	if (callfunc("F_IsEquipIDHack", .@part, .@equip_id) || callfunc("F_IsEquipCardHack", .@part, .@card[0], .@card[1], .@card[2], .@card[3]) || callfunc("F_IsEquipRefineHack", .@part, .@equip_refine)) {
		mes "[MARS_01]";
		mes "你是否卸下了装备？";
		close;
	}

	if (.@card[0] > 0 && .@item_enchant_id == .@card[0]) { .@slot_sum++; }
	if (.@card[1] > 0 && .@item_enchant_id == .@card[1]) { .@slot_sum++; }
	if (.@card[2] > 0 && .@item_enchant_id == .@card[2]) { .@slot_sum++; }
	if (.@card[3] > 0 && .@item_enchant_id == .@card[3]) { .@slot_sum++; }

	if (.@max_num_enchant < 1) {
		mes "[MARS_01]";
		mes "你选择的设计图与装备不兼容。";
		close;
	}
	if (.@first_slot_only > 0 && .@card[3] != 0) {
		mes "[MARS_01]";
		mes "这张设计图只能用于首次强化，但该装备已有其他属性，请使用其他设计图强化！";
		close;
	}
	if (.@slot_sum >= .@max_num_enchant) {
		mes "[MARS_01]";
		mes "最大附魔次数为" + .@max_num_enchant + "。物品已达到上限。";
		close;
	}
	if (.@card[1] != 0) {
		mes "[MARS_01]";
		mes "装备数量已达到上限。";
		close;
	}

	// anti-hack
	if (callfunc("F_IsEquipIDHack", .@part, .@equip_id) || callfunc("F_IsEquipCardHack", .@part, .@card[0], .@card[1], .@card[2], .@card[3]) || callfunc("F_IsEquipRefineHack", .@part, .@equip_refine)) {
		mes "[MARS_01]";
		mes "请特别注意装备是否会被移除。";
		close;
	}

	switch( .@equip_id ) {
	case 20773:	// Excelion_Wing
	case 15128:	// Excelion_Suit
		break;
	default:
		mes "[MARS_01]";
		mes "该物品没有序列号，不符合规格，无法强化。";
		close;
	}
	mes "[MARS_01]^0000ff";
	mes "选择" + getequipname(.@part) + " + " + getitemname(.@item_req) + "，";
	mes "^000000------------------";
	mes "你选择的设计图最多可以强化装备 ^0000ff" + .@max_num_enchant + " 次，^000000目前已强化 ^0000ff" + .@slot_sum + " 次^000000，要继续吗？";
	next;
	if (select( "我再考虑一下……", "继续。" ) == 1) {
		mes "[MARS_01]";
	mes "下次需要我时再回来~";
		close;
	}

	// anti-hack
	if (callfunc("F_IsEquipIDHack", .@part, .@equip_id) || callfunc("F_IsEquipCardHack", .@part, .@card[0], .@card[1], .@card[2], .@card[3]) || callfunc("F_IsEquipRefineHack", .@part, .@equip_refine))
		close;

	if (.@card[3] == 0) {
		.@enchant_count = 1;
		.@card[3] = .@item_enchant_id;
	}
	else if (.@card[2] == 0) {
		.@enchant_count = 2;
		.@card[2] = .@item_enchant_id;
	}
	else if (.@card[1] == 0) {
		.@enchant_count = 3;
		.@card[1] = .@item_enchant_id;
	}
	else {
		mes "[MARS_01]";
	mes "装备已达到强化上限，祝你好运！";
		close;
	}
	specialeffect2 EF_REPAIRWEAPON;
	mes "[MARS_01]";
	if (.@enchant_count < 5)
	mes "该装备已经强化了 ^990000" + .@enchant_count + " 次^000000。";
	else
		mes "额外性能装备^990000 ^000000强化。";	// never displayed

	delitem .@item_req, 1;
	delequip .@part;
	getitem2 .@equip_id,1,1,.@equip_refine,0,.@card[0],.@card[1],.@card[2],.@card[3];
	close;
}

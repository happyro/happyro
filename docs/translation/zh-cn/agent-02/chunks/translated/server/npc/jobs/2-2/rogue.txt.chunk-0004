		mes "如果你想学习";
		mes "如何成为盗贼，";
		mes "那就闭嘴待着。";
		next;
		mes "[安东尼奥·二世]";
		mes "^0000FF避开强者！对弱者狠辣！^000000这就是我们对付怪物的格言。";
		next;
		mes "[安东尼奥·二世]";
		mes "对付弱小怪物时不要手下留情，同时尽量远离强大的怪物。";
		next;
		mes "[安东尼奥·二世]";
		mes "现在，我要你通过这条^0000FF地下隧道^000000一路走到盗贼公会。";
		next;
		mes "[安东尼奥·二世]";
		mes "那里有怪物，不过只要避开强者、对弱者狠辣，你就会没事。";
		next;
		if (select("走吧！:等、等等~") == 1) {
			mes "[安东尼奥·二世]";
			mes "希望你";
			mes "不要在测试中失败，";
			mes "只有通过测试";
			mes "才能成为盗贼……";
			close2;
			warp "in_rogue",15,105;
			set ROGUE_Q,14;
			changequest 2023,2026;
			end;
		}
		mes "[安东尼奥·二世]";
		mes "我没时间";
		mes "陪你胡闹。";
		mes "快点";
		mes "准备好，然后";
		mes "参加测试。";
		close;
	}
	else if (ROGUE_Q == 14) {
		mes "[安东尼奥·二世]";
		mes "你失败了……？";
		mes "人生就是这样吧。";
		mes "你还要再试";
		mes "一次吗？";
		next;
		if (select("重新测试:取消") == 1) {
			mes "[安东尼奥·二世]";
			mes "记住，我是在";
			mes "帮你的忙……";
			mes "现在，成为盗贼之前";
			mes "别再回来。";
			close2;
			warp "in_rogue",15,105;
			end;
		}
		mes "[安东尼奥·二世]";
		mes "我没时间";
		mes "陪你胡闹。";
		mes "快点";
		mes "准备好，然后";
		mes "参加测试。";
		close;
	}
	else if (BaseJob != Job_Rogue) {
		mes "嗯……？";
		mes "你是谁？！";
		mes "你不是";
		mes "盗贼公会的人！！";
		next;
		mes "[安东尼奥·二世]";
		mes "你是来杀我的吗？！我不会让你得逞！！来吧，使出你的全力！要是我挖掉你的眼睛，你就没法战斗了！";
		close;
	}
	else {
		mes "[安东尼奥·二世]";
		mes "嘿，最近怎么样？";
		mes "放松点，";
		mes "离开前好好休息。";
		close;
	}
}


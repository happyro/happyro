		next;
		mes "[霍尔格伦·二世]";
		mes "我的测试是让你穿过^0000FF地下隧道^000000，沿路一直回到盗贼公会。";
		next;
		mes "[霍尔格伦·二世]";
		mes "那里有一些怪物，不过这也是训练的一部分。现在，你准备好出发了吗？";
		next;
		if (select("是的，我准备好了。:才不要~") == 1) {
			mes "[霍尔格伦·二世]";
			mes "祝你好运。";
			close2;
			warp "in_rogue",15,105;
			set ROGUE_Q,15;
			changequest 2024,2026;
			end;
		}
		mes "[霍尔格伦·二世]";
		mes "慢慢来。";
		mes "准备好后";
		mes "再回来这里。";
		close;
	}
	else if (ROGUE_Q == 15) {
		mes "[霍尔格伦·二世]";
		mes "嗯。";
		mes "你失败了。";
		mes "要再试一次吗？";
		next;
		if (select("重新测试:取消。") == 1) {
			mes "[霍尔格伦·二世]";
			mes "祝你好运。";
			close2;
			warp "in_rogue",15,105;
			end;
		}
		mes "[霍尔格伦·二世]";
		mes "慢慢来。";
		mes "准备好后";
		mes "再回来这里。";
		close;
	}
	else if (BaseJob != Job_Rogue) {
		mes "[霍尔格伦·二世]";
		mes "嗯……？";
		mes "你不是";
		mes "盗贼公会的人……";
		next;
		mes "[霍尔格伦·二世]";
		mes "如果你还想平安无事，";
		mes "最好现在就";
		mes "离开这里，";
		mes "对你有好处……";
		next;
		mes "[霍尔格伦·二世]";
		mes "现在……";
		mes "趁我还没改变";
		mes "杀你的主意，";
		mes "赶紧滚蛋。";
		close;
	}
	else {
		mes "[霍尔格伦·二世]";
		mes "嘿……";
		mes "来参观的吗？";
		mes "我们盗贼得";
		mes "团结一致，对吧？";
		close;
	}
}

in_rogue,177,109,1	script	Antonio junior#rg	88,{
	if (ROGUE_Q == 10) {
		mes "[安东尼奥·二世]";
		mes "你是";

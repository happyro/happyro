			mes "好吧……希望你能通过勤奋练习进一步了解近身束缚。祝你好运，再次感谢你的帮助。";
				set ROG_SK,12;
				skill "RG_CLOSECONFINE",1,SKILL_PERM;
				specialeffect2 EF_LIGHTSPHERE;
				close;
			}
			mes "[Haijara Greg]";
			mes "谢谢你帮我保护这本无价的技能书。希望下次见面时，我们会成为战场上的战友……";
			close;
		}
	}
	else {
		mes "[Haijara Greg]";
		mes "你、你怎么找到这里的？我以为这个紧急避难室连流氓也无法进入！";
		next;
		mes "[Haijara Greg]";
		mes "这可不妙！他们找到我只是时间问题……";
		next;
		mes "[Haijara Greg]";
		mes "求你……找一个我能信任的潜行者或流氓来帮我！我没多少时间了……";
		close;
	}
}

in_rogue,152,29,0	script	Louis Greg#rogueguild	84,{
	if (BaseJob == Job_Rogue || Class == Job_Thief_High) {
		if (ROG_SK < 1) {
			mes "[Louis Greg]";
			mes "我父亲他……他突然消失了！他正在教我和兄弟们一项新技能，但最近不知为何变得疑神疑鬼……";
			next;
			mes "[Louis Greg]";
			mes "也许他躲起来了？我知道流氓公会有一间隐藏的紧急避难室，但连我也不知道在哪里。希望一切平安……";
			set ROG_SK,1;
			close;
		}
		else if (ROG_SK == 1) {
			mes "[Louis Greg]";
			mes "父亲警告过，如果别人知道我们学习的新技能，可能会来找我们。也许他躲进了流氓公会的紧急避难室……";
			close;
		}
		else if (ROG_SK == 2) {
			mes "[Louis Greg]";
			mes "这是什么……？父亲的信？哦，他一定没事！快，让我马上读读！";
			set ROG_SK,3;
			next;
			mes "[Louis Greg]";
			mes "不好，父亲现在也许安全，但他正被危险的人追捕？哥哥托尔一定要知道。让我赶快给他写信……";
			next;
			mes "[Louis Greg]";
			mes "我知道自己没资格求你帮忙，但我想父亲一定信任你。请把我的信交给哥哥托尔好吗？";
			next;
			mes "[Louis Greg]";
			mes "你可以在流氓公会里赫尔曼索恩 Jr.旁边找到托尔。如果你能帮助我的家人，我会非常感激。";
			close;
		}
		else if (ROG_SK == 3) {
			mes "[Louis Greg]";
			mes "我的哥哥^FF0000托尔^000000必须马上知道！请替我把这封信交给他。他应该就在流氓公会的^FF0000赫尔曼索恩 Jr.^000000附近。";
			close;
		}
		else if (ROG_SK == 4) {
			mes "[Louis Greg]";
			mes "你在找我的哥哥杰伊？他通常和安东尼奥 Jr.一起待在流氓公会。";
			close;
		}
		else if (ROG_SK == 5) {
			mes "[Louis Greg]";
			mes "如果你要和父亲说话，他大概还在流氓公会的隐藏紧急避难室。我仍不知道那地方究竟在哪里……";
			close;
		}
		else if (ROG_SK == 6) {
			mes "[Louis Greg]";
			mes "你想学习流氓的秘密技能？哦，你应该和^FF0000托尔^000000谈。我……我很不擅长向别人解释事情。真的很差。";
			close;
		}
		else if (ROG_SK == 7) {
			mes "[Louis Greg]";
			mes "嗯？你正在学习流氓秘密技能，对吧？哦，那你还不该来这里。请回去再和^FF0000托尔^000000谈谈，好吗？";
			close;
		}
		else if (ROG_SK == 8) {
			mes "[Louis Greg]";
			mes "哦，哦！你完成训练了？啊，那你得再去找托尔！";
			close;
		}
		else if (ROG_SK == 9) {
			mes "[Louis Greg]";
			mes "你想进一步了解近身束缚？那你最好和父亲谈。我自己也刚学会那个技能。";
			close;
		}
		else if (ROG_SK == 11) {
			mes "[Louis Greg]";
			mes "我刚听兄弟们说，蔡泽培开发近身束缚是为了残酷击打敌人，让他们无法逃跑。是真的吗？";
			close;
		}
		mes "[Louis Greg]";
		mes "哇，你真厉害！真希望我也像你一样强大。我讨厌当小孩！";
		close;
	}
	mes "[Louis Greg]";
	mes "我为什么成为流氓？我想只是喜欢偷偷摸摸。而且，遵守道德和法律太难了，你懂的？";
	close;
}

in_rogue,268,125,2	script	Thor Greg#rogueguild	86,{
	if (BaseJob == Job_Rogue || Class == Job_Thief_High) {
		if (ROG_SK < 1) {
			mes "[Thor Greg]";
			mes "父亲去哪儿了？希望那些怪人没有抓到他。幸运的话，他躲进了紧急避难室，但还是……";
			set ROG_SK,1;
			close;
		}
		else if (ROG_SK == 1) {
			mes "[Thor Greg]";
			mes "嗯……父亲可能躲在紧急避难室。我从没找到过，但玛姬说入口巧妙地藏在她左边。嗯……";
			close;
		}
		else if (ROG_SK == 2) {
			mes "[Thor Greg]";
			mes "你在找我的弟弟^FF0000路易^000000？哦，他总是在流氓公会的^FF0000霍尔格雷恩 Jr.^000000附近。你找他做什么？";
			close;
		}
		else if (ROG_SK == 3) {
			mes "[Thor Greg]";
			mes "你给我的是什么？路易的信？让我看看……";
			set ROG_SK,4;
			next;
			mes "[Thor Greg]";
			mes "天啊，父亲遇到大麻烦了！我得马上告诉哥哥杰伊！快，在公会里^FF0000安东尼奥 Jr.^000000旁边找到^FF0000杰伊^000000！请、请快点！";
			close;
		}
		else if (ROG_SK == 4) {
			mes "[Thor Greg]";
			mes "你可以在流氓公会里找到和安东尼奥 Jr.待在一起的杰伊。请尽快把我写的信交给他！";
			close;
		}
		else if (ROG_SK == 5) {
			mes "[Thor Greg]";
			mes "希望父亲没有离开流氓公会的紧急避难室。那里可能是唯一安全的地方……";
			close;
		}
		else if (ROG_SK == 6) {
			mes "[Thor Greg]";
			mes "什么？父亲要我教你流氓秘密技能？好吧，我会像父亲教我那样训练你。你想先听解释吗？";
			next;
			mes "[Thor Greg]";
			mes "如果你不想听解释，我就直接把你送到训练场，让你学习^FF0000近身束缚^000000。";
			next;
			if (select("听解释:前往训练场") == 1) {
				mes "[Thor Greg]";
				mes "好，学习^FF0000近身束缚^000000的第一步，就是掌握阻挡敌人移动的方法。我会把你送到特殊训练场练习。";
				next;
				mes "[Thor Greg]";
				mes "在那里你会遇到训练伙伴。靠近她，预测并阻挡她向左、向右或向后移动。准备好，我现在送你过去……";
				close2;
				warp "in_rogue",89,114;
				end;
			}
			warp "in_rogue",89,114;
			end;
		}
		else if (ROG_SK == 7) {
			mes "[Thor Greg]";
			mes "好，我就打破第四面墙，假设你与游戏断开了连接。你要回训练场学习^FF0000近身束缚^000000吗？";
			next;
			if (select("好的。:不用了，谢谢。") == 1) {
				mes "[Thor Greg]";
				mes "好，学习^FF0000近身束缚^000000的第一步，就是掌握阻挡敌人移动的方法。我会把你送到特殊训练场练习。";
				next;
				mes "[Thor Greg]";
				mes "在那里你会遇到训练伙伴。靠近她，预测并阻挡她向左、向右或向后移动。准备好，我现在送你过去……";
				set ROG_SK,6;
				close2;
				warp "in_rogue",89,114;
				end;
			}
			mes "[Thor Greg]";
			mes "好，好。准备继续训练时，告诉我一声。";
			close;

		}
		else if (ROG_SK == 8) {
			mes "[Thor Greg]";
			mes "我听基娜说你完成训练了。恭喜！现在请和父亲谈谈，让他详细解释近身束缚。";
			set ROG_SK,9;
			close;
		}
		else if (ROG_SK == 9) {
			mes "[Thor Greg]";
			mes "请和父亲谈谈，让他解释近身束缚的细节。他应该还在流氓公会的紧急避难室。";
			close;
		}
		else if (ROG_SK == 11) {
			mes "[Thor Greg]";
			mes "蔡泽培会对对手说‘我是蔡泽培，你是……？’，就在对方回答前把他们打得半死。";
			next;
			mes "[Thor Greg]";
			mes "他确实是流氓中的传奇英雄……！";
			close;
		}
		mes "[Thor Greg]";
		mes "嗯……？看来你甚至比我还强。大概没多少人敢招惹你……";
		close;
	}
	mes "[Thor Greg]";
	mes "嗯，偷这个，偷那个。*叹气* 我最丢脸的缺点是：偷到 Zeny 后几乎马上就花光。不负责任……";
	close;
}

in_rogue,181,114,3	script	Jay Greg#rogueguild	85,{
	if (BaseJob == Job_Rogue || Class == Job_Thief_High) {
		if (ROG_SK < 1) {
			mes "[Jay Greg]";
			mes "我父亲一定藏在流氓公会的紧急避难室。奇怪的是，我和兄弟们一直找不到，也无法确认他是否安全……";
			set ROG_SK,1;
			next;
			mes "[Jay Greg]";
			mes "最近有些怪人追捕他，还威胁我们的家人。不过他刚教了我们一项新技能，可以用来保护自己……";
			close;
		}
		else if (ROG_SK == 1) {
			mes "[Jay Greg]";
			mes "我猜父亲藏在流氓公会的紧急避难室。我们一直找不到，但据说入口藏在玛姬附近。";
			close;
		}
		else if (ROG_SK == 2) {
			mes "[Jay Greg]";
			mes "你在找弟弟路易？他就在流氓公会，应该不难找。他大概就在霍尔格雷恩 Jr.附近。";
			close;
		}
		else if (ROG_SK == 3) {
			mes "[Jay Greg]";
			mes "托尔？他应该就在流氓公会某处。你试过在赫尔马索恩 Jr.附近找吗？";
			close;
		}
		else if (ROG_SK == 4) {
			mes "[Jay Greg]";
			mes "给我的信……？啊，是托尔寄来的，我最好马上读读。嗯……";
			set ROG_SK,5;
			next;
			mes "[Jay Greg]";
			mes "我明白了……我必须马上向流氓公会报告，并给父亲回信。嗯，让我现在写一封。请稍等……";
			next;
			mes "[Jay Greg]";
			mes "好了，写完了。请尽快把它交给父亲。我知道这要求很高，但我自己找不到隐藏的紧急避难室……";
			close;
		}
		else if (ROG_SK == 5) {
			mes "[Jay Greg]";
			mes "请尽快把我的回信交给父亲。他仍藏在流氓公会的紧急避难室，前提是敌人还没找到他。";
			close;
		}
		else if (ROG_SK == 6) {
			mes "[Jay Greg]";
			mes "你需要训练近身束缚？我想只有托尔能进入训练场，所以先去和他谈谈。";
			close;
		}
		else if (ROG_SK == 7) {
			mes "[Jay Greg]";
			mes "你需要训练近身束缚？我想只有托尔能进入训练场，所以先去和他谈谈。";
			close;
		}
		else if (ROG_SK == 8) {
			mes "[Jay Greg]";
			mes "啊，你完成近身束缚训练了？太好了，现在去告诉我哥哥托尔。";
			close;

	mes "[Crime Prevention Staff]";
	mes "一群吃了坏罐头的猫";
	mes "肚子疼。";
	mes "它们躺在北边，";
	mes "但仍然气得打滚。";
	next;
	mes "[Crime Prevention Staff]";
	mes "哈哈……村子变得";
	mes "和平又安静，但感觉";
	mes "有点空荡。这不是";
	mes "平常会看到的景象。";
	mes "去看看吧？";
	close;
}

malangdo,3,1,3	script	Guidance for quest#ml	543,{
	if (callfunc("F_GM_NPC",1854,0) < 1) {
		mes "[Helper]";
		mes "这是什么安全代码？";
		mes "走开！";
		close;
	}
	mes "[Helper]";
	mes "现在选择，快点！";
	next;
	switch(select("NPC 出现！：NPC 离场！：重置物品：30个坏罐头：收集罐头前：开始巡逻队长委托")) {
	case 1:
		donpcevent "Gobonge#ml::OnEnable";
		mes "[Helper]";
		mes "首次出现！";
		close;
	case 2:
		donpcevent "Gobonge#ml::OnDisable";
		mes "[Helper]";
		mes "离场！";
		close;
	case 3:
		mes "[Helper]";
		mes "喵！";
		set malang_bad_guys,0;
		erasequest 1152;
		close;
	case 4:
		mes "[Helper]";
		mes "欠款？";
		getitem 6426,30; //Bad_Can
		close;
	case 5:
		mes "[Helper]";
		mes "喵！";
		erasequest 1150;
		setquest 1151;
		set malang_bad_guys,7;
		close;
	case 6:
		mes "[Helper]";
		mes "喵！";
		set malang_bad_guys,10;
		close;
	}
}

// Clean the Ship :: mal_day_qook
//============================================================
mal_in02,76,63,7	script	Cleanyang	544,{
	if (checkweight(1201,1) == 0) {
		mes "- 你携带的物品太多，无法继续任务。-";
		close;
	}
	if (BaseLevel < 60) {
		mes "水手猫正在悲伤地哭泣。";
		next;
		mes "[Cleanyang]";
		mes "喵呜喵呜喵呜";
		mes "怎么了……喵……有些事……发生了……呜呜~";
		mes "你不需要知道。喵呜呜……";
		next;
		mes "他没有继续说话。";
		mes "他摇着头，仿佛在说：";
		mes "‘你还年轻，所以不明白我的痛苦和悲伤……’";
		next;
		mes "不知道反而更好。";
		close;
	}
	if (mal_qook == 0) {
		mes "水手猫正在悲伤地哭泣。";
		emotion ET_CRY;
		next;
		mes "[Cleanyang]";
		mes "喵喵喵呜~";
		mes "发生了什么……呜……呜……";
		mes "你不需要知道。呜……呜……";
		emotion ET_CRY;
		next;
		mes "无法继续交谈。";
		next;
		switch(select("鼓励他。：不予理会。")) {
		case 1:
			mes "我只是陪在他身边，安慰他受伤的心。";
			next;
			emotion ET_CRY;
			mes "[Cleanyang]";
			mes "太不公平了……呜呜……";
			mes "厨师……他总是训斥我。";
			next;
			mes "[Cleanyang]";
			mes "我一直都很勤快地打扫。";
			mes "我不知道它们从哪里来……呜呜……";
			mes "它们钻进了食材……";
			next;
			select("它们？" );
			mes "[Cleanyang]";
			mes "是的，它们又快又小又硬，还闪着黑光。";
			mes "喵……还有白色的，会蠕动……";
			mes "我的厨师非常爱干净。";
			next;
			mes "[Cleanyang]";
			mes "没关系。干净、害虫和";
			mes "其他什么的……不公平的是，";
			mes "我真的也消灭了害虫，喵。";
			mes "而且我一直勤快打扫。";
			next;
			mes "[Cleanyang]";
			mes "顺便说，它们一再出现。";
			mes "我不知道它们从哪里来。";
			next;
			switch(select("别再问了。：询问害虫来源。")) {
			case 1:
				emotion ET_CRY;
				mes "[Cleanyang]";
				mes "……你的脸怎么了？";
				mes "你害怕派我去办事吗？";
				mes "你把我当成什么了……喵，喵……？";
				mes "太不公平了……喵，喵……";
				next;
				mes "可怜的水手猫清扬哭了起来。";
				mes "让他一个人静静吧。";
				close;
			case 2:
				mes "[Cleanyang]";
				mes "有人能去那里调查吗？";
				mes "请搜查纳维号的每个角落，好吗？";
				mes "我没法这样活下去！喵，喵！";
				next;
				mes "[Cleanyang]";
			mes "肯定有我不知道的东西。喵。";
			mes "喵……我来打扫这里。请替我找出原因。";
				set mal_qook,1;
				setquest 7260;
				close;
			}
		case 2:
		mes "你留下哭泣的猫，退了回来。";
			close;
		}
	} else if (mal_qook == 1) {
		if (checkquest(7261) != -1 && checkquest(7262) != -1 && checkquest(7263) != -1) {
			emotion ET_HUK;
			mes "[Cleanyang]";
			mes "嗯，那是什么？喵。";
			mes "这是猫船饼干……可能放了很久……";
			mes "不可能……！";
			next;
			select("是的，就是这个。" );
			emotion ET_SCRATCH;
			mes "[Cleanyang]";
			mes "因为水手们把猫船饼干藏起来后遗弃，里面生了虫……";
			mes "我只是因为磨牙饼干被训斥了吗？";
			mes "喵！";
			next;
			select("磨牙饼干？" );
			mes "[Cleanyang]";
			mes "没错，喵。";
			mes "这是为了方便航行时保存而烤得很硬的面包，喵。";
			mes "它太硬了，直接咬的话，犬齿可能会断，喵。";
			next;
			mes "[Cleanyang]";
			mes "它只用盐和面粉烤制，以便长期保存，所以没有什么味道。";
			mes "更重要的是……看看这个。";
			next;
			mes "清扬用锤子和凿子敲开猫船饼干，";
			mes "然后砸在地上。接着……";
			next;
			mes "[Cleanyang]";
			mes "……你能看到有什么东西从这里出来吗？";
			mes "这是象鼻虫……";
			mes "简直是昆虫的城堡。";
			next;
			mes "[Cleanyang]";
			mes "也许真的没人想吃这个。";
			mes "这些虫子是在我们定居岛上、改换菜单之前留下的。";
			next;
			mes "[Cleanyang]";
			mes "定居岛上后，因为有新鲜食材，我们就不再制作猫船饼干。";
			mes "........";
			next;
			mes "[Cleanyang]";
			mes "请把这个给厨师看，告诉他清扬已经打扫得非常干净。";
			mes "嗯……我还是怕厨师……";
			mes "……拜托了！喵！";
			set mal_qook,2;
			erasequest 7261;
			erasequest 7262;
			erasequest 7263;
			erasequest 7260;
			setquest 7264;
			next;
			mes "[Cleanyang]";
			mes "啊，那块猫船饼干还没坏，试着吃吃看吧。";
			mes "你想知道那是什么吗？虽然卖相不好，却曾是很棒的食物……";
			close;
		}
		mes "[Cleanyang]";
		mes "请搜索纳维号，找出它的来源。";
		mes "我只能相信你了。";
		close;
	} else if (mal_qook == 2) {
		mes "[Cleanyang]";
		mes "如果你把猫船饼干给厨师看，证明虫子来自那里，";
		mes "我的误会就能解开。";
		next;
		select("你为什么不自己去？" );
		mes "[Cleanyang]";
		mes "嗯……我还得打扫……";
		mes "我还是害怕厨师，所以拜托你了。";
		close;
	} else if (mal_qook == 3) {
		mes "[Cleanyang]";
		mes "厨师生气了。";
		mes "快求他饶命！";
		close;
	} else if (mal_qook == 4) {
		mes "[Cleanyang]";
		mes "你是说厨师更在意猫船饼干？";
		mes "从现在起我不用哭了？";
		next;
		mes "[Cleanyang]";
		mes "厨师需要什么，就带给他吧~";
		mes "这样对大家都好，对吧？";
		next;
		mes "[Cleanyang]";
		mes "等厨师满意高兴时再来吧。";
		mes "在那之前我可能紧张得无法打扫。喵……";
		close;
	} else if (mal_qook == 5) {
		mes "[Cleanyang]";
		mes "你完成厨师要的工作了吗？";
		mes "对了，你为什么突然制作猫船饼干？";
		next;
		select("给你的新菜单。" );
		mes "[Cleanyang]";
		mes "喵呜呜呜——！！";
		mes "喵呜呜呜！！";
		mes "喵呜呜……喵呜呜！";
		next;
		mes "[Cleanyang]";
		mes "不！！！！！！！！！！！";
		mes "没有猫船饼干就是天堂。我不想再回地狱！！！！";
		mes "喵呜呜……喵呜呜……喵呜呜~";
		next;
		switch(select("挠下巴。：碰鼻尖。：拍拍屁股。")) {
		case 1:
			mes "[Cleanyang]";
			mes "喵……咕噜咕噜……";
			mes "喵呜……";
			mes "呼啊呼啊……咕噜咕噜……";
			next;
			break;
		case 2:
			mes "[Cleanyang]";
			mes "嗯呀——！";
			mes "呜喵喵喵喵！";
			mes "你到底在做什么！";
			next;
			break;
		case 3:
			mes "[Cleanyang]";
			mes "呜喵喵";
			mes "喵呜……呜喵——！";
			mes "你在做什么！";
			next;
			break;
		}
		mes "[Cleanyang]";
		mes "请停下……";
		mes "现在冷静。";
		mes "我明白厨师的话和宏伟计划了。";
		next;
		mes "[Cleanyang]";
		mes "喂，帮助过我的人类，是你，你！";
		mes "能帮我个忙吗？";
		mes "如果菜单改变、供应猫船饼干，它们肯定会出现……";
		next;
		select("什么？" );
		mes "[Cleanyang]";
		mes "猫中的猫！";
		mes "那些偷偷藏起猫船饼干的猫。";
		mes "它们因为害怕厨师，不敢说不想吃，只能把饼干丢掉。";
		next;
		mes "[Cleanyang]";
		mes "当然，它们会开始藏猫船饼干……";
		mes "然后饼干就会被虫子侵染！";
		mes "厨师又会训斥我！";
		next;
		mes "[Cleanyang]";
		mes "所以从明天开始，每天都让我看看供应的猫船饼干。";
		mes "你做得很好。这是谢礼。";
		set mal_qook,6;
		getitem 12636,30; //Malang_Sp_Can
		getexp 80000,80000;
		setquest 7267;
		close;
	}
	switch(rand(3)) {
	case 0:
		mes "[Cleanyang]";
		mes "呜呜呜……";
		mes "呜呜呜……";
		mes "太可怕了……我拿到了猫船饼干，却不知道是什么时候做的。";
		mes "真的很硬。我差点把牙齿弄掉。";
		break;
	case 1:
		mes "[Cleanyang]";
		mes "厨师可能会忘记因为虫子训斥我的事。";
		mes "他被猫船饼干吓到了。这比清洁工作更严重吗？";
		break;
	case 2:
		mes "[Cleanyang]";
		mes "我是清洁猫清扬~";
		mes "喵~";
		mes "在别人家的门上抓痕，喵~";
		mes "喵~嗯？你听到了吗？";
		mes "这是我的清洁歌。";
		break;
	}
	next;
	mes "[Cleanyang]";
	mes "对了，发生什么事了？";
	next;
	switch(select("约定时间到了~：我来看看结果~：扭扭屁股~")) {
	case 1:
		if (checkquest(7267,PLAYTIME) == 0) {
			mes "[Cleanyang]";
			mes "嗯？还没。";
			mes "今天的猫船饼干还没发放，再等一会儿就知道了。";
			mes "可能要等厨师分发猫船饼干后。";
			close;
		}
		if (checkquest(7268) != -1) {
			mes "[Cleanyang]";
			mes "今天为你提供的服务。";
			mes "最近还有9个藏着猫船饼干的地点。";
			next;
			mes "[Cleanyang]";
			mes "有人以为好心的天使会把我收集后扔掉的饼干全带走。";
			mes "但他仍然把饼干藏在那些地方。";
			next;
			mes "[Cleanyang]";
			mes "这很简单，因为不用到处搜索，但是……";
			mes "请搜索经常藏东西的9个地点。";
			close;
		}
		if (checkquest(7267,PLAYTIME) == 2)
			completequest 7267;
		erasequest 7267;
		mes "[Cleanyang]";
		mes "今天有人藏猫船饼干吗？";
		mes "也许就是那里？";
		next;
		switch(select("今天试着搜索。：今天还是算了。")) {
		case 1:
			mes "[Cleanyang]";
			mes "今天为你提供的服务。";
			mes "搜索纳维号内部、房屋和猫塔。连一根草都别漏掉。";
			mes "到处搜查。";
			setquest 7268;
			close;
		case 2:
			mes "[Cleanyang]";
			mes "你觉得呢？";
			mes "如果是这样，那就太好了。";
			mes "不管怎样，因为我们及时发现并清除，饼干没有被虫子侵染。";
			mes "这样就够了。";
			close;
		}
	case 2:
		if (checkquest(7268) == -1) {
			mes "[Cleanyang]";
			mes "嗯？今天没人委托收集猫船饼干。";
			mes "对了，结果报告呢？";
			mes "你生病了吗？";
			close;
		}
		if (checkquest(7261) != -1 && checkquest(7262) != -1 && checkquest(7263) != -1 && checkquest(7269) != -1 && checkquest(7270) != -1 &&
		    checkquest(7271) != -1 && checkquest(7272) != -1 && checkquest(7273) != -1 && checkquest(7274) != -1 && checkquest(7275) != -1) {
			mes "[Cleanyang]";
			mes "嗯，出现猫船饼干的地点！";
			mes "你全都收集了吗？";
			mes "我想这样就够了。";
			next;
			mes "[Cleanyang]";
			mes "把找到的猫船饼干全带来吧。";
			mes "味道不差，口感也很有韧性……";
			next;
			mes "[Cleanyang]";
			mes "好，今天的工作够了。明天请再来！";
			mes "明天会有新的猫船饼干！";
			mes "喵哈哈呜~";
			setquest 7267;
			erasequest 7268;
			erasequest 7261;
			erasequest 7262;
			erasequest 7263;
			erasequest 7269;
			erasequest 7270;
			erasequest 7271;
			erasequest 7272;
			erasequest 7273;
			erasequest 7274;
			erasequest 7275;
			getexp 30000,40000;
			getitem 12636,10; //Malang_Sp_Can
			close;
		}
		mes "[Cleanyang]";
		mes "你全都找到了吗？";
		next;
		mes "[Cleanyang]";
		mes "有人以为好心的天使会把我收集后扔掉的饼干全带走。";
		mes "但他仍然把饼干藏在那些地方。";
		next;
		mes "[Cleanyang]";
		mes "这很简单，因为不用到处搜索，但是";
		mes "请搜索经常藏东西的9个地点。";
		close;
	case 3:
		mes "[Cleanyang]";
		mes "喵呜——！";
		mes "你在做什么？喵！";
		mes "咕噜咕噜……";
		next;
		mes "[Cleanyang]";
		mes "嗯嗯。";
		mes "嘿，别那样。";
		mes "...isn't it a crime? Meow.";
		close;
	}
}

mal_in02,29,67,0	script	#CaptainRoom3	844,{
	if (checkweight(1201,1) == 0) {
		mes "- 你携带的物品太多，无法继续任务。-";
		close;
	}
	if (mal_qook == 1) {
		if (checkquest(7261) == -1) {
			mes "船长房间的角落堆着很多杂物。";
			mes "清扬可能没打扫那个角落，因为手够不到。";
			next;
			mes "[Admiral Thomas]";
			mes "嗯？你在那里做什么？";
			mes "别碰那个！";
			cutin "ma_tomas03",2;
			next;
			switch(select("抱歉。：我来打扫！")) {
			case 1:
				mes "[Admiral Thomas]";
				mes "我们没有共同话题可聊。";
				mes "没有理由像你这样搜查那里。";
				mes "请别管我。";
				cutin "ma_tomas01",2;
				cutin "ma_tomas03",255;
				break;
			case 2:
				cutin "ma_tomas03",255;
				mes "无视托马斯，在杂物下面搜索。";
				mes "就在这时……";
				next;
				emotion ET_HUK;
				mes "黑影刚才经过的地方，不知道放了多久。";
				mes "找到一块猫船饼干。";
				switch(rand(3)) {
					case 0: monster "mal_in02",30,67,"Quick Dark Shadow",2209,1;
					case 1: monster "mal_in02",30,65,"Quick Dark Shadow",2209,1;
					case 2: monster "mal_in02",29,65,"Quick Dark Shadow",2209,1;
				}
				setquest 7261;
				getitem 11536,1; //Cat_Hard_Biscuit
				next;
				if (checkquest(7261) != -1 && checkquest(7262) != -1 && checkquest(7263) != -1) {
					mes "我想已经搜得够彻底了。";
					mes "告诉清扬，虫子是因为猫船饼干放太久才出现的。";
					close;
				}
				mes "这就是虫子出现的原因之一。";
				close;
			}
		}
		mes "这里曾是昆虫的栖息地，因为有人留下了猫船饼干。";
	

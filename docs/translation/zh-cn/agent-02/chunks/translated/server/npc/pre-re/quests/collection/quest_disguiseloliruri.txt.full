//===== rAthena Script =======================================
//= iRO Repeatable EXP Quests.
//===== By: ==================================================
//= Masao
//===== Current Version: =====================================
//= 1.0
//===== Compatible With: =====================================
//= rAthena Project
//===== Description: =========================================
//= Custom Version.
//= Repeatable EXP Quest : Kill 50 Disguise or Loli Ruri.
//===== Additional Comments: =================================
//= 1.0 First version.
//============================================================

nif_fild01,332,327,4	script	Deadman	795,{

	if (checkquest(60173) != -1) {
		if (checkquest(60173,HUNTING) != 2 ) {
			mes "[Deadman]";
			mes "你已经猎杀 50 只伪装怪了吗？";
			next;
			switch(select("是:否:我想退出")) {
			case 1:
				mes "[Deadman]";
				mes "嗯，我觉得你还没猎杀 50 只。";
				close;
			case 2:
				mes "[Deadman]";
				mes "记住，我需要你帮忙猎杀伪装怪，去猎杀 50 只吧。";
				close;
			case 3:
				mes "[Deadman]";
				mes "你确定要停止猎杀吗？";
				mes "你取得的进度都会被清除。";
				next;
				switch(select("是:否")) {
				case 1:
					mes "[Deadman]";
					mes "好吧，改变主意后再回来。";
					erasequest 60173;
					close;
				case 2:
					mes "[Deadman]";
					mes "请猎杀 50 只伪装怪，让这里成为人们可以获得经验的地方。";
					close;
				}
			}
		}
		mes "[Deadman]";
		mes "太棒了，你完成得真快。";
		getexp 140600,95800;
		erasequest 60173;
		close;
	}
	if (checkquest(60176) != -1) {
		if (checkquest(60176,HUNTING) != 2 ) {
			mes "[Deadman]";
			mes "你已经猎杀 50 只洛丽鲁丽了吗？";
			next;
			switch(select("是:否:我想退出")) {
			case 1:
				mes "[Deadman]";
				mes "嗯，我觉得你还没猎杀 50 只。";
				close;
			case 2:
				mes "[Deadman]";
				mes "记住，我需要你帮忙猎杀洛丽鲁丽，去猎杀 50 只吧。";
				close;
			case 3:
				mes "[Deadman]";
				mes "你确定要停止猎杀吗？";
				mes "你取得的进度都会被清除。";
				next;
				switch(select("是:否")) {
				case 1:
					mes "[Deadman]";
					mes "好吧，改变主意后再回来。";
					erasequest 60176;
					close;
				case 2:
					mes "[Deadman]";
					mes "请猎杀 50 只洛丽鲁丽，让这里成为人们可以获得经验的地方。";
					close;
				}
			}
		}
		mes "[Deadman]";
		mes "太棒了，你完成得真快。";
		getexp 332000,239500;
		erasequest 60176;
		close;
	}
	if ((BaseLevel > 59) && (BaseLevel < 99)) {
		mes "[Deadman]";
		mes "太好了！";
		mes "你是来帮助我的，对吧？";
		mes "否则我真不知道该拿这里的怪物怎么办！";
		next;
		switch(select("当然:不")) {
		case 1:
			mes "[Deadman]";
			mes "太好了！我一看到你就知道可以依靠你！";
			mes "我需要你减少目前在这张地图上肆虐的怪物数量！";
			mes "这里的伪装怪和洛丽鲁丽太多了，低等级玩家根本无法获得好的经验。";
			next;
			mes "[Deadman]";
			mes "那么，你想帮我猎杀哪种怪物？";
			next;
			switch(select("伪装怪:洛丽鲁丽:取消")) {
			case 1:
				if (BaseLevel > 90) {
					mes "[Deadman]";
					mes "感谢你对伪装怪提供的巨大帮助！";
					mes "目前情况已经稳定，我不再需要你帮忙猎杀它们了。";
					close;
				}
				mes "[Deadman]";
				mes "猎杀 50 只伪装怪，完成后告诉我。我会奖励你的努力。";
				setquest 60173;
				close;
			case 2:
				if (BaseLevel > 98) {
					mes "[Deadman]";
					mes "感谢你对洛丽鲁丽提供的巨大帮助！";
					mes "目前情况已经稳定，我不再需要你帮忙猎杀它们了。";
					close;
				}
				mes "[Deadman]";
				mes "猎杀 50 只洛丽鲁丽，完成后告诉我。我会奖励你的努力。";
				setquest 60176;
				close;
			case 3:
				mes "[Deadman]";
				mes "改变主意后，请再回来。";
				close;
			}
		case 2:
			mes "[Deadman]";
		mes "改变主意后，请再回来。";
			close;
		}
	}
	mes "[Deadman]";
	mes "哎呀，哎呀！";
	next;
	mes "[Deadman]";
	mes "抱歉，我现在没法聊天，这里的伪装怪和洛丽鲁丽快把我折磨死了。";
	close;
}

// Treasure Room Exit
//============================================================
aldeg_cas01,123,223,0	script	#lever_A01	111,{
	mes " ";
	mes "这里有一根小拉杆。要拉动它吗？";
	next;
	if(select("拉动。:不拉。") == 1) {
		close2;
		warp "aldeg_cas01",218,176;
		end;
	}
	close;
}


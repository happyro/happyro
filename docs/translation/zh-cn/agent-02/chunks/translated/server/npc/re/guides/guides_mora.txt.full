mora,25,158,5	script	Raffle Guide#north	516,{
	mes "[Raffoh]";
	mes "Laoh~!";
	mes "欢迎来到莫拉村。";
	mes "关于村子的任何事情，我都可以告诉你~！";
	F_Navi("[Raffoh]");
	next;
	switch(select("[ 旅馆 ]:[ 住宅区 ]:[ 商店 ]:[ 仓库 ]:移除小地图标记:退出")) {
	case 1:
		mes "[Raffoh]";
		mes "Laoh~!";
		mes "这里有一间"+F_Navi("旅馆","mora,44,138")+"，但我们不能像拉弗斯那样让旅客睡觉……";
		mes "好好休息吧！";
		viewpoint 1,44,134,0,0x0A82FF;
		close;
	case 2:
		mes "[Raffoh]";
		mes "Laoh~!";
		mes F_Navi("这里","mora,119,170")+"是拉弗斯的住宅……";
		mes "不过请保持安静，因为大家都在睡觉~！";
		viewpoint 1,119,170,1,0xAAFF00;
		close;
	case 3:
		mes "[Raffoh]";
		mes "Laoh~!";
		mes "如果你想买纪念品，可以在这个"+F_Navi("区域","mora,112,110")+"购买。";
		viewpoint 1,112,110,2,0xDA70D6;
		close;
	case 4:
		mes "[Raffoh]";
		mes "Laoh~!";
		mes F_Navi("这里","mora,182,161")+"存放着各种包裹和杂货。";
		mes "里面有许多不属于拉弗斯的东西，请小心！";
		viewpoint 1,182,161,3,0xFF1493;
		close;
	case 5:
		mes "[Raffoh]";
		mes "拉哦~！我会把它们全部移除~！";
		viewpoint 2,1,1,0,0xFFFF00;
		viewpoint 2,1,1,1,0xFFFF00;
		viewpoint 2,1,1,2,0xFFFF00;
		viewpoint 2,1,1,3,0xFFFF00;
		close;
	case 6:
		mes "[Raffoh]";
		mes "Laoh~!";
		mes "你的家乡流行什么运动？";
		close;
	}
}

mora,167,76,3	script	Raffle Guide#east	522,{
	mes "[Raffuh]";
	mes "Uh...";
	mes "这、这里是莫拉村。";
	mes "呃……你想了解哪个地方？";
	F_Navi("[Raffuh]");
	next;
	switch(select("[ 旅馆 ]:[ 住宅区 ]:[ 商店 ]:[ 仓库 ]:移除小地图标记:退出")) {
	case 1:
		mes "[Raffuh]";
		mes "Uh...";
	mes "你、你困了吗？";
	mes "你可以在"+F_Navi("这里","mora,44,138")+"睡觉，呃！！把东西放下，呃！然后——然后——";
		viewpoint 1,44,134,0,0x0A82FF;
		close;
	case 2:
		mes "[Raffuh]";
		mes "Uh...";
	mes "你为什么想知道我住"+F_Navi("在哪里","mora,119,170")+"？";
	mes "呃，不……我想和朋友一起住——";
		viewpoint 1,119,170,1,0xAAFF00;
		close;
	case 3:
		mes "[Raffuh]";
		mes "Uh...";
	mes "那些"+F_Navi("商店","mora,112,110")+"里有很多东西——哦，还有温泉，呃！";
		viewpoint 1,112,110,2,0xDA70D6;
		close;
	case 4:
		mes "[Raffuh]";
		mes "Uh...";
	mes "你不能直接闯进"+F_Navi("仓库","mora,182,161")+"，否则会惹麻烦——";
	mes "那里很多东西来自村外——拉弗曾多次惹上麻烦——";
		viewpoint 1,182,161,3,0xFF1493;
		close;
	case 5:
		mes "[Raffuh]";
	mes "你确定要移除它们吗？";
		viewpoint 2,1,1,0,0xFFFF00;
		viewpoint 2,1,1,1,0xFFFF00;
		viewpoint 2,1,1,2,0xFFFF00;
		viewpoint 2,1,1,3,0xFFFF00;
		close;
	case 6:
		mes "[Raffuh]";
		mes "Uh...";
	mes "当导游并不能缓解我的社交恐惧——";
		close;
	}
}

mora,115,138,5	script	Raffle Guide#center	524,{
	mes "[Raffla]";
	mes "Lala!";
	mes "欢迎来到莫拉村啦！";
	mes "想知道村子的任何事情，问我就好啦！";
	F_Navi("[Raffla]");
	next;
	switch(select("[ 旅馆 ]:[ 住宅区 ]:[ 商店 ]:[ 仓库 ]:移除小地图标记:退出。")) {
	case 1:
		mes "[Raffla]";
		mes "Lala!";
		mes F_Navi("这里","mora,44,138")+"是旅客休息的地方啦！";
		mes "旅馆老板很亲切，要多和他聊聊天啦！";
		viewpoint 1,44,134,0,0x0A82FF;
		close;
	case 2:
		mes "[Raffla]";
		mes "Lala!";
		mes F_Navi("这里","mora,119,170")+"是拉弗斯居住的地方啦！";
		mes "去那里看看吧啦！";
		viewpoint 1,119,170,1,0xAAFF00;
		close;
	case 3:
		mes "[Raffla]";
		mes "Lala!";
		mes "你想买东西啦？";
		mes "那里有很多"+F_Navi("商店和咖啡馆","mora,112,110")+"，去逛逛吧啦！";
		viewpoint 1,112,110,2,0xDA70D6;
		close;
	case 4:
		mes "[Raffla]";
		mes "Lala!";
		mes F_Navi("仓库","mora,182,161")+"是存放贵重物品的地方啦！";
		mes "小心别被抢啦！";
		viewpoint 1,182,161,3,0xFF1493;
		close;
	case 5:
		mes "[Raffla]";
		mes "好的，我会移除地图上的所有标记啦！";
		viewpoint 2,1,1,0,0xFFFF00;
		viewpoint 2,1,1,1,0xFFFF00;
		viewpoint 2,1,1,2,0xFFFF00;
		viewpoint 2,1,1,3,0xFFFF00;
		close;
	case 6:
		mes "[Raffla]";
		mes "Lala!";
		mes "我真不知道我的家人怎么会做这些事啦！";
		close;
	}
}

mora,72,51,3	script	Raffle Guide#south	518,{
	mes "[Raffli]";
	mes "Lali?";
	mes "欢迎来到莫拉村。";
	mes "想知道村子的任何事情，问我就好。";
	F_Navi("[Raffli]");
	next;
	switch(select("[ 旅馆 ]:[ 住宅区 ]:[ 商店 ]:[ 仓库 ]:移除小地图标记:退出")) {
	case 1:
		mes "[Raffli]";
		mes "Lali?";
		mes F_Navi("这里","mora,44,138")+"是旅客休息的地方。";
		mes "旅馆老板很亲切，去认识一下他吧。";
		viewpoint 1,44,134,0,0x0A82FF;
		close;
	case 2:
		mes "[Raffli]";
		mes "Lali?";
		mes F_Navi("这里","mora,119,170")+"是拉弗斯居住的地方。";
		mes "你要来拉弗利的家吗？我好开心。";
		viewpoint 1,119,170,1,0xAAFF00;
		close;
	case 3:
		mes "[Raffli]";
		mes "Lali?";
		mes "有很多东西我想买。";
		mes "那里有许多"+F_Navi("吃饭和购物的地方","mora,112,110")+"，也有许多商品。";
		viewpoint 1,112,110,2,0xDA70D6;
		close;
	case 4:
		mes "[Raffli]";
		mes "Lali?";
		mes F_Navi("仓库","mora,182,161")+"是存放贵重物品的地方。";
		mes "但别被抢了。";
		viewpoint 1,182,161,3,0xFF1493;
		close;
	case 5:
		mes "[Raffli]";
		mes "我会移除所有标记。";
		viewpoint 2,1,1,0,0xFFFF00;
		viewpoint 2,1,1,1,0xFFFF00;
		viewpoint 2,1,1,2,0xFFFF00;
		viewpoint 2,1,1,3,0xFFFF00;
		close;
	case 6:
		mes "[Raffli]";
		mes "Lali?";
		mes "哥哥今天好像不高兴。我做错什么了吗？";
		close;
	}
}

//===== rAthena Script ======================================= 
//= Luoyang Guide
//===== By: ================================================== 
//= L0ne_W0lf
//===== Current Version: ===================================== 
//= 1.1
//===== Compatible With: ===================================== 
//= rAthena Project
//===== Description: ========================================= 
//= [Official Conversion]
//= Guide for the city of Luoyang.
//===== Additional Comments: ================================= 
//= 1.0 First version, Renewal guide.
//= 1.1 Navigation system update. [Euphy]
//============================================================ 

louyang,224,104,4	script	Luoyang Guide#01louyang	818,{
	mes "[代表]";
	mes "欢迎来到^8B4513洛阳^000000，";
	mes "这片古老土地";
	mes "拥有充满英勇故事的历史。";
	mes "愿你在这里留下自己的故事。";
	next;
	mes "[代表]";
	mes "我们现在开通了海上航线，方便外国旅客往来并促进文化交流，让所有人都能从中受益。";
	next;
	mes "[代表]";
	mes "^8B4513洛阳^000000以";
	mes "悠久的历史以及独特的特产而闻名。请慢慢游览，享受你的旅程。";
	F_Navi("[代表]");
	set .@str$,"还有什么我能帮你的吗？";
	while (1) {
		next;
		switch(select("[ 龙城 ]:[ 医生办公室 ]:[ 市政厅 ]:[ 武器店 ]:[ 道具店 ]:[ 酒馆 ]:[ 天文台 ]:[ 返回艾尔贝塔 ]:移除小地图标记:取消")) {
		case 1:
			mes "[代表]";
			mes F_Navi("龙城","louyang,218,253")+"位于^0A82FF+^000000处。那里住着包括领主在内的所有贵族。";
			mes "你是外来者，我想你应该先去拜访我们的领主。";
			mes .@str$;
			viewpoint 1,218,253,0,0x0A82FF;
			break;
		case 2:
			mes "[代表]";
			mes "传闻中著名的"+F_Navi("医生办公室","louyang,261,93","^AAFF00")+"可以治愈所有疾病。";
			mes "不过我不确定这是否是真的。";
			mes .@str$;
			viewpoint 1,261,93,1,0xAAFF00;
			break;
		case 3:
			mes "[代表]";
			mes "我们有一座"+F_Navi("市政厅","louyang,309,78")+"，联邦政府就在这里办公。";
			mes "它位于^008080+^000000处。";
			next;
			mes "[代表]";
			mes "如果你遇到任何问题，";
			mes "可以和那里的";
			mes "工作人员谈谈。";
			mes .@str$;
			viewpoint 1,309,78,2,0x20B2AA;
			break;
		case 4:
			mes "[代表]";
			mes F_Navi("武器店","louyang,145,172")+"位于^55FF33+^000000处。";
			next;
			mes "[代表]";
			mes "你会看到";
			mes "由洛阳经验丰富的";
			mes "铁匠们锻造的";
			mes "精美武器。";
			mes .@str$;
			viewpoint 1,145,172,3,0xFF1493;
			break;
		case 5:
			mes "[代表]";
			mes F_Navi("道具店","louyang,138,99")+"位于^3355FF+^000000处。";
			next;
			mes "[代表]";
			mes "了解你的敌人";
			mes "就是胜利的一半！";
			mes "提前准备总比事后后悔安全。何不去看看他们的库存？";
			mes .@str$;
			viewpoint 1,138,99,4,0xFF0000;
			break;
		case 6:
			mes "[代表]";
			mes "旅途中感到疲惫时，建议你去"+F_Navi("酒馆","louyang,280,165")+"。它位于^00FF00+^000000处。";
			next;
			mes "[代表]";
			mes "酒馆是结识其他游客的好地方，";
			mes "也能听到许多有用的消息。";
			mes .@str$;
			viewpoint 1,280,165,5,0xDAA520;
			break;
		case 7:
			mes "[代表]";
			mes "没有比"+F_Navi("天文台","louyang,136,245")+"更好的观景地点了。";
			mes "这是这里必看的景点。";
			mes .@str$;
			viewpoint 1,136,245,6,0xD8BFD8;
			break;
		case 8:
			mes "[代表]";
			mes "如果你想返回艾尔贝塔，";
			mes "去城外码头找"+F_Navi("女孩","louyang,218,22","^00BFFF")+"。";
			mes .@str$;
			viewpoint 1,218,22,7,0x00BFFF;
			break;
		case 9:
			mes "[代表]";
			mes "我会移除小地图上的所有标记。";
			mes .@str$;
			viewpoint 2,1,1,0,0xFFFFFF;
			viewpoint 2,1,1,1,0xFFFFFF;
			viewpoint 2,1,1,2,0xFFFFFF;
			viewpoint 2,1,1,3,0xFFFFFF;
			viewpoint 2,1,1,4,0xFFFFFF;
			viewpoint 2,1,1,5,0xFFFFFF;
			viewpoint 2,1,1,6,0xFFFFFF;
			viewpoint 2,1,1,7,0xFFFFFF;
			break;
		case 10:
			mes "[代表]";
			mes "旅途愉快～！";
			close;
		}
	}
}

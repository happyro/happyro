						mes "如果你从某些魔物那里获得5个粗制神之金属，就可以将它们精炼成1个神之金属。";
						next;
						continue;
					case 4:
						mes "[Locas]";
						mes "精炼4级武器需要^3E86C3神之金属和20,000 Zeny。^000000";
						next;
						mes "[Locas]";
						mes "铝原石和神之金属一样稀有。如果你带来5个铝原石，我会帮你精炼成1个铝。";
						next;
						continue;
					case 5:
						mes "[Locas]";
						mes "精炼防具需要^3E86C3铝和20,000 Zeny。^000000";
						next;
						mes "[Locas]";
						mes "铝原石和神之金属一样稀有。如果你带来5个铝原石，我会帮你精炼成1个铝。";
						next;
						continue;
					case 6:
						mes "[Locas]";
						mes "关于精炼价格的说明，你应该已经听够了。";
						next;
						break;
					}
					break;
				}
				continue;
			case 2:
				mes "[Locas]";
				mes "与其只听说明，我认为让你亲自体验精炼效果更好。不过我还是先简单说明一下。";
				next;
				mes "[Locas]";
				mes "我们从1级武器开始。";
				next;
				mes "[Locas]";
				mes "1级武器每精炼+1，^A20B09攻击力增加2^000000。明白了吗？";
				next;
				select("怎么样？？？");
				mes "[Locas]";
				mes "我以为已经解释得很简单了，看来并没有……";
				next;
				mes "[Locas]";
				mes "比如，攻击力17的短剑精炼+1后会变成攻击力19，就是这样。";
				next;
				mes "[Locas]";
				mes "其实这里不用说太多，你之后亲自体验就明白了。";
				next;
				mes "[Locas]";
				mes "2级武器每精炼1级，攻击力增加^A20B093^000000。";
				next;
				mes "[Locas]";
				mes "3级武器每精炼1级，攻击力增加^A20B095^000000。";
				next;
				mes "[Locas]";
				mes "最后，4级武器每精炼1级，攻击力增加^A20B097^000000。";
				next;
				mes "[Locas]";
				mes "啊，我漏说防具了。防具每精炼1级，防御力增加^A20B091^000000。";
				next;
				mes "[Locas]";
				mes "好了，刚才说明的只是安全精炼的效果……";
				next;
				mes "[Locas]";
				mes "不管潜在风险如何，你最好亲自了解^A20B09过度精炼的效果^000000。";
				next;
				mes "[Locas]";
				mes "如果把所有细节都告诉你，你可能要开始读一部一万页的史诗小说了，我直接告诉你结局吧。";
				next;
				mes "[Locas]";
				mes "有一点必须明确：过于急切时要小心装备被毁。";
				next;
				continue;
			case 3:
				break;
			}
			break;
		}
		mes "[Locas]";
		mes "感谢你听完这么长的故事。这就是我能说明的全部内容。";
		next;
		mes "[Locas]";
		mes "关于武器等级和安全精炼，请咨询塔德先生。他会耐心回答你的问题。";
		close;
	}
}

izlude_a,155,132,3	duplicate(Locas#iz)	Locas#iz_a	4_M_02
izlude_b,155,132,3	duplicate(Locas#iz)	Locas#iz_b	4_M_02
izlude_c,155,132,3	duplicate(Locas#iz)	Locas#iz_c	4_M_02
izlude_d,155,132,3	duplicate(Locas#iz)	Locas#iz_d	4_M_02

// - Enchanter Mounds
// - Teaches the player about enchanting.
// -----------------------------------------------------------------------------
izlude,96,125,7	script	Enchanter Mounds#iz	4_CAT_SAILOR2,{
	if (!checkweight(1301,1)) {
		mes "- 你的物品栏中物品太多，无法继续任务。-";
		close;
	}
	disable_items;
	.@in_tutorial = isbegin_quest(5157) + isbegin_quest(5158) + isbegin_quest(5159);
	if (.@in_tutorial == 0) {
		mes "[Mounds]";
		mes "欢迎。欢迎来到附魔协会。我是^142CEB芒兹^000000，附魔协会依兹路得分部的负责人。";
		next;
		select("哦……猫会说话？？？");
		mes "[Mounds]";
		mes "你从没见过会说话的猫吗？";
		next;
		mes "[Mounds]";
		mes "有一座名为^FD4F02喵扬多^000000的岛，那里只住着猫，我就来自那里。";
		next;
		mes "[Mounds]";
		mes "有些像我一样的猫能流利地说人类语言，但也有些同时说人类语和猫语的猫，语言会变得一团糟。";
		next;
		mes "[Mounds]";
		mes "这个之后可以在喵扬多确认。你对^FD4F02附魔^000000感兴趣吗？";
		next;
		select("附魔协会？");
		mes "[Mounds]";
		mes "附魔协会是由我们这些会附魔的人组成的团体。";
		next;
		mes "[Mounds]";
		mes "协会由^FD4F02插槽附魔部门^000000和^FD4F02隐藏附魔部门^000000两个部门组成。";
		next;
		mes "[Mounds]";
		mes "你想了解这两个部门吗？";
		while(1) {
			next;
			switch(select("插槽附魔？", "隐藏附魔", "问题问完了")) {
			case 1:
				mes "[Mounds]";
				mes "你对插槽附魔感到好奇……下面是说明。";
				next;
				mes "[Mounds]";
				mes "不知什么原因，从魔物那里获得的装备上一直存在^FD4F02卡槽^000000。";
				next;
				mes "[Mounds]";
				mes "人们开始疑问：“能不能制作把卡片插入其中的装置？”";
				next;
				mes "[Mounds]";
				mes "终于有一天，一位名叫^142CEB赛亚布雷姆^000000的人带来了插槽附魔技术。";
				next;
				mes "[Mounds]";
				mes "没人知道他是如何获得这项技术的……";
				next;
				mes "[Mounds]";
				mes "后来某天，赛亚布雷姆的弟弟^142CEB雷亚布雷姆^000000带来了不同于哥哥的装置，用于给其他装备进行插槽附魔。";
				next;
				mes "[Mounds]";
				mes "许多人使用兄弟俩的插槽附魔服务，于是他们偷走了这项技术";
				next;
				select("好像挺简单的……");
				mes "[Mounds]";
				mes "兄弟俩后来加入了附魔协会。他们还会时不时在喵扬多把技术传授给我们。";
				next;
				mes "[Mounds]";
				mes "只要勤奋学习这项技术，总有一天其他人也能进行插槽附魔。";
				next;
				mes "[Mounds]";
				mes "啊，我的话题跑远了。";
				next;
				mes "[Mounds]";
				mes "总之，插槽附魔就是给商店出售的普通装备增加卡槽。";
				next;
				mes "[Mounds]";
				mes "这就叫插槽附魔。你想了解另一个部门吗？";
				continue;
			case 2:
				mes "[Mounds]";
				mes "啊！你对隐藏附魔感到好奇吗？";
				next;
				mes "[Mounds]";
				mes "好吧。首先，我要告诉你隐藏附魔技术是如何诞生的。";
				next;
				mes "[Mounds]";
				mes "最初的发明者一直在寻找解锁3槽武器第4个槽位的方法。";
				next;
				mes "[Mounds]";
				mes "于是他研究了利用剩余槽位的技术。";
				next;
				mes "[Mounds]";
				mes "研究终于成功后，他把技术传给了徒弟，之后便再无音讯。";
				next;
				mes "[Mounds]";
				mes "他的技术使用具有类似魔物卡片特殊属性的宝石强化装备。";
				next;
				mes "[Mounds]";
				mes "这项技术不断发展改进，最终形成如今的^FD4F02附魔协会^000000。";
				next;
				mes "[Mounds]";
				mes "简单来说，用特殊附魔制造更强的装备就是隐藏附魔。";
				next;
				mes "[Mounds]";
				mes "你想了解另一个部门吗？";
				continue;
			case 3:
				break;
			}
			break;
		}
		mes "[Mounds]";
		mes "你没有其他问题了。";
		next;
		mes "[Mounds]";
		mes "以后如果你想体验隐藏附魔或插槽附魔，我会帮助你。";
		next;
		setquest 5157;
		mes "[Mounds]";
		mes "随时都可以来找我。";
		close;
	} else if (.@in_tutorial == 1) {
		mes "[Mounds]";
		mes "欢迎……啊，我们以前见过吧？";
		next;
		mes "[Mounds]";
		mes "你是来体验隐藏附魔还是插槽附魔的？";
		next;
		if (select("我只是路过。", "我是来体验的。") == 1) {
			mes "[Mounds]";
			mes "你可能正要前往普隆德拉。路上小心，记得回来。";
			close;
		}
		mes "[Mounds]";
		mes "你想体验一下。";
		next;
		mes "[Mounds]";
		mes "体验课程从简单的插槽附魔开始。";
		next;
		mes "[Mounds]";
		mes "为此你需要材料。去依兹路得防具店买一件棉衬衫吧？";
		next;
		setquest 5158;
		mes "[Mounds]";
		mes "带来棉衬衫后，我们就立即开始^FD4F02插槽附魔体验^000000课程。";
		close;
	} else if (.@in_tutorial == 2) {
		mes "[Mounds]";
		if (countitem(2302) > 0) {
			mes "哦，这件衬衫已经有插槽了！";
			next;
			mes "[Mounds]";
			mes "请带来没有插槽的普通衬衫。";
			close;
		} else if (countitem(2301) > 0) {
			mes "必须是普通棉衬衫。";
			next;
		} else {
			mes "从防具店带来普通棉衬衫后，我们就开始插槽附魔体验。";
			close;
		}
		mes "[Mounds]";
		mes "与其他附魔不同，插槽附魔是在未装备物品时进行的。";
		next;
		mes "[Mounds]";
		mes "那么，我们开始插槽附魔吧。";
		next;
		mes "[Mounds]";
		mes "一！";
		next;
		mes "[Mounds]";
		mes "一！ Two!";
		next;
		mes "[Mounds]";
		mes "一！ Two! Three!";
		next;
		specialeffect2 EF_SANCTUARY;
		completequest 5158;
		delitem 2301,1;// Cotton_Shirt
		getitem 2302,1;// Cotton_Shirt_
		mes "[Mounds]";
		mes "你成功完成了插槽附魔。";
		close;
	} else if (.@in_tutorial == 3) {
		mes "[Mounds]";
		mes "你检查过装备了吗？现在它已经有一个空插槽了。";
		next;
		mes "[Mounds]";
		mes "不过，像这次这样的成功率并不总是^FD4F02100%^000000，因为你还处于学习阶段。";
		next;
		mes "[Mounds]";
		mes "请记住，附魔始终有失败的风险，失败后装备会损坏。";
		next;
		mes "[Mounds]";
		mes "如果想进一步了解插槽附魔，请去咨询在普隆德拉或斐扬工作的雷亚布雷姆或赛亚布雷姆。";
		next;
		select("我明白了。");
		mes "[Mounds]";
		mes "现在该体验隐藏附魔了。";
		next;
		mes "[Mounds]";
		mes "装备刚完成插槽附魔的棉衬衫，去找";
		next;
		setquest 5159;
		mes "[Mounds]";
		mes "负责隐藏附魔的猫阿尔蒙德J。";
		close;
	} else if (.@in_tutorial == 4) {
		mes "[Mounds]";
		mes "穿着完成插槽附魔的棉衬衫，从阿尔蒙德J那里获得隐藏附魔。";
		close;
	} else if (.@in_tutorial == 5) {
		mes "[Mounds]";
		mes "咦？你比想象中来得早？我还以为听完这么多说明会花些时间。";
		next;
		select("说明一下情况。");
		mes "[Mounds]";
		mes "呃～～事情就是这样……";
		next;
		mes "[Mounds]";
		mes "你刚才大声嚷嚷着要进行隐藏附魔，我可得小心你了。";
		next;
		mes "[Mounds]";
		mes "总之，抱歉……虽然很简短，我还是给你说明一下。";
		next;
		mes "[Mounds]";
		mes "你检查过隐藏附魔了吗？";
		next;
		if (select("检查过了。", "还没有。") == 1) {
			mes "[Mounds]";
			mes "既然你已经检查过了，我的说明就简单多了。";
			next;
		} else {
			mes "[Mounds]";
			mes "嗯……建议你打开物品窗口，检查棉衬衫的状态。";
			next;
		}
		mes "[Mounds]";
		mes "既然你已经检查过了，我的说明就简单多了。";
		next;
		mes "[Mounds]";
		mes "正如我刚才说明的，隐藏附魔就是把带有特殊选项的宝石嵌入武器或防具。";
		next;
		mes "[Mounds]";
		mes "如果你检查过，就会注意到物品信息窗口底部的第3、第4槽位出现了新内容。";
		next;
		mes "[Mounds]";
		mes "隐藏附魔就是对类似阿尔蒙德J所穿装备进行的附魔。";
		next;
		mes "[Mounds]";
		mes "当然，还有其他地方可以进行隐藏附魔。";
		next;
		if (select("满意。", "有点不足。") == 1) {
			mes "[Mounds]";
			mes "那太好了。还有什么体验想补充吗？有的话请告诉我。";
			next;
		} else {
			mes "[Mounds]";
			mes "看来这次体验并不令你满意。能告诉我哪里需要改进吗？";
			next;
			mes "[Mounds]";
			mes "我会参考这些意见来规划下一次体验。";
			next;
		}
		input .@advice$;
		mes "[Mounds]";
		mes "感谢你宝贵的建议。";
		next;
		mes "[Mounds]";
		mes "感谢你耐心听完我无聊的说明。";
		next;
		mes "[Mounds]";
		mes "这是份小礼物，希望你继续支持我们的附魔协会。";
		next;
		completequest 5157;
		if (Class == Job_Novice) {
			getexp 1200,500;
			mes "获得了附魔说明、一些经验值和卡普拉仓库免费券。";
		} else {
			mes "获得了附魔说明和卡普拉仓库免费券。";
		}
		getitem 7059,1;// Cargo_Free_Ticket
		next;
		mes "[Mounds]";
		mes "那么，回头见。";
		close;
	} else if (.@in_tutorial == 6) {
		mes "[Mounds]";
		mes "欢迎来到附魔协会。我是芒兹，附魔协会依兹路得分部的负责人。";
		next;
		mes "[Mounds]";
		mes "咦？你的样子很眼熟。我们以前见过吗？";
		next;
		mes "[Mounds]";
		mes "我见过的人太多，记不住所有人的脸，但奇怪的是，你的脸让我难以忘记。";
		next;
		mes "[Mounds]";
		mes "你是来学习附魔的吗？我会详细为你说明。";
		next;
		while(1) {
		switch(select("插槽附魔", "隐藏附魔", "问候", "没有问题。")) {
			case 1:
				mes "[Mounds]";
				mes "插槽附魔是在武器或防具上产生卡槽的技能。";
				next;
				mes "[Mounds]";
				mes "在卢恩·米德加尔特各城镇遇到赛亚布雷姆和雷亚布雷姆兄弟时，他们可以为你提供这项服务。";
				next;
				mes "[Mounds]";
				mes "如果他们没能在你的物品上增加新槽位，就只能和它道别了……";
				next;
				mes "[Mounds]";
				mes "通常最好准备不止1件要增加槽位的物品，因为这项操作有时很容易失败。";
				next;
				break;
			case 2:
				mes "[Mounds]";
				mes "隐藏附魔就是把附魔宝石放入物品的隐藏槽位。";
				next;
				mes "[Mounds]";
				mes "你必须穿戴要附魔的物品，因为成功率取决于穿戴者的运气。";
				next;
				mes "[Mounds]";
				mes "许多地方都以不同方式提供隐藏附魔服务，有时间的话请去其中一处看看。";
				next;
				break;
			case 3:
				mes "[Mounds]";
				mes "消息？附魔协会最近没有什么大事。";
				next;
				mes "[Mounds]";
				mes "啊！！我想起来了，和我一起从依兹路得分部来的阿尔蒙德J想做宣传……";
				next;
				mes "[Mounds]";
				mes "他提出了为初心者武器提供免费隐藏附魔服务的计划。我觉得不错，就批准了。";
				next;
				mes "[Mounds]";
				mes "怎么？如果你有初心者武器，不妨试试看。";
				next;
				break;
			case 4:
				mes "[Mounds]";
				mes "对附魔协会有任何疑问，随时来找我。";
				close;
			}
			mes "[Mounds]";
			mes "还有其他问题吗？";
			next;
		}
	} else {
		mes "[Mounds]";
		mes "一定发生了什么奇怪的事。如果问题持续，请联系客服。";
		close;
	}

OnInit:
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "BaseLevel <= 20 && !isbegin_quest(5157)" );
	end;
}

izlude_a,96,125,7	duplicate(Enchanter Mounds#iz)	Enchanter Mounds#iz_a	4_CAT_SAILOR2
izlude_b,96,125,7	duplicate(Enchanter Mounds#iz)	Enchanter Mounds#iz_b	4_CAT_SAILOR2
izlude_c,96,125,7	duplicate(Enchanter Mounds#iz)	Enchanter Mounds#iz_c	4_CAT_SAILOR2
izlude_d,96,125,7	duplicate(Enchanter Mounds#iz)	Enchanter Mounds#iz_d	4_CAT_SAILOR2

// - Enchanter Almond J
// - Teaches the player about enchanting.
// -----------------------------------------------------------------------------
izlude,108,139,7	script	Enchanter Almond J#iz	4_CAT_SAILOR3,{
	if (!checkweight(1301,1)) {
		mes "- 你的物品栏中物品太多，无法继续任务。-";
		close;
	}
	disable_items;
	.@in_tutorial = (isbegin_quest(5157) + isbegin_quest(5158) + isbegin_quest(5159));
	if (.@in_tutorial < 4) {
		mes "[Almond J]";
		mes "你好，我是附魔协会的阿尔蒙德J～";
		next;
		mes "[Almond J]";
		mes "如果你有关于附魔协会的事情，请进去咨询芒兹。";
		close;
	} else if (.@in_tutorial == 4) {
		.@part = EQI_ARMOR;
		mes "[Almond J]";
		mes "欢迎……我一直在等你。你是来为棉衬衫进行隐藏附魔的吗？";
		next;
		if (select("附魔？那是什么？", "是的。") == 1) {
			mes "[Almond J]";

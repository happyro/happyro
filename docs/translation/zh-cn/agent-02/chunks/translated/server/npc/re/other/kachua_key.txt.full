//===== rAthena Script =======================================
//= Dynamic NPC: Kachua's Secret Box
//===== Description: =========================================
//- [Official conversion]
//= Kachua's Secret Box is a Gachapon NPC.
//= It lets the player exchange a Kachua's Secret Key for a random item.
//= It also gives a Kachua's Mileage Coupon for each pull.
//===== Changelogs: ==========================================
//= 1.0 First version. [secretdataz]
//============================================================

sec_in02,126,178,3	script	Kachua's Secret Box#bm	4_TREASURE_BOX,{
	.@key$ = "K_Secret_Key";
	.@keyname$ = getitemname( .@key$ );
	.@box$ = "Main_Lucky_Box";
	.@boxname$ = getitemname( .@box$ );
	mes "这是一个没人知道里面有什么的秘密箱子。";
	mes "^4d4dff消耗" + mesitemlink( .@key$ ) + "即可打开这个箱子。^000000";
	next;
	switch(select("^4d4dff打开 1 次（1 个" + .@keyname$ + "）^000000","^4d4dff打开 10 次（10 个" + .@keyname$ + "）^000000")) {
		case 1:
			mes "^FF0000【注意】^000000";
			mes "^FF0000使用 1 个" + .@keyname$ + "兑换 1 件随机物品。^000000";
			mes "^FF0000兑换得到的物品无法取回，也不能兑换成" + .@keyname$ + "。^000000";
			next;
			if(select("继续。","结束对话。") == 2) {
				mes "你决定不打开箱子。";
				close;
			} else if (countitem(.@key$) < 1) {
				mes "没有足够的" + mesitemlink( .@key$ ) + "。";
				close;
			} else {
				if (checkweight(1201,1) == 0 || ((MaxWeight - Weight) * 100 / MaxWeight) < 10) {
					mes "^4d4dff请确认你的物品栏有足够空间。^000000";
					close;
				}
				delitem(.@key$, 1);
				consumeitem(.@box$);
				mes .@boxname$ + "已打开！";
				mes "运气好吗？";
				specialeffect2 EF_VALLENTINE;
				close;
			}
		case 2:
			mes "^FF0000【注意】^000000";
			mes "^FF0000使用 10 个" + .@keyname$ + "兑换 10 件随机物品。^000000";
			mes "^FF0000兑换得到的物品无法取回，也不能兑换成" + .@keyname$ + "。^000000";
			next;
			if(select("继续。","结束对话。") == 2) {
				mes "你决定不打开箱子。";
				close;
			} else if (countitem(.@key$) < 10) {
				mes "你没有足够的" + mesitemlink( .@key$ ) + "。";
				close;
			} else {
				for (.@i = 1; .@i <= 10; ++.@i) {
					progressbar "4d4dff",2;
					if (checkweight(1201,1) == 0 || ((MaxWeight - Weight) * 100 / MaxWeight) < 10) {
						mes "^4d4dff请确认你的物品栏有足够空间。^000000";
						close;
					}
					if (countitem(.@key$) < 1) { // Custom check, just in case
						close;
					}
					delitem(.@key$, 1);
					consumeitem(.@box$);
					dispbottom .@boxname$ + "已打开 " + .@i + " 次，正在打开下一个。",0xFFFFFF;
					specialeffect2 EF_VALLENTINE;
				}
				mes .@boxname$ + "已打开 10 次！";
				mes "运气好吗？";
				close;
			}
	}
}

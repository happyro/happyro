					mes "要与他人交易物品";
					mes "或 Zeny，";
					mes "必须至少学会^3355FF基础技能等级 1^000000。";
					next;
					mes "[利奥·亨德森]";
					mes "交易时必须";
					mes "靠近交易对象，否则距离超过 2 格时交易无法进行。";
					next;
					mes "[利奥·亨德森]";
					mes "右键点击对方";
					mes "一次，会出现小菜单。";
					mes "从菜单中选择：";
					mes "^800fff请求交易^000000。";
					next;
					mes "[利奥·亨德森]";
					mes "之后对方可以";
					mes "选择是否接受请求。接受后会出现交易窗口。";
					next;
					mes "[利奥·亨德森]";
					mes "交易物品时，从物品栏窗口（‘^3355FFAlt^000000’+‘^3355FFE^000000’）拖动物品，放到交易窗口左侧。";
					next;
					mes "[利奥·亨德森]";
					mes "对方提供的物品会出现在交易窗口右侧。务必确认";
					mes "对方交易的是否是约定物品。";
					next;
					mes "[利奥·亨德森]";
					mes "交易 Zeny 时输入交易金额。放入物品或 Zeny 后，按窗口底部的‘OK’按钮确认。";
					next;
					mes "[Leo Handerson]";
					mes "交易确认后，";
					mes "按‘Trade’按钮完成交易。任一方不按‘OK’按钮，交易都无法完成。";
					next;
					mes "[Leo Handerson]";
					mes "任一方按窗口右侧的‘Cancel’按钮，交易就会取消。";
					next;
					break;
				case 2:
					mes "[Leo Handerson]";
					mes "现在让我说明";
					mes "队伍系统。";
					next;
					mes "[Leo Handerson]";
					mes "队伍系统允许你";
					mes "和他人组织小队，共同狩猎怪物或一起娱乐。";
					next;
					mes "[Leo Handerson]";
					mes "你可以通过输入以下命令";
					mes "组建队伍：";
					mes "命令：";
					mes "^4F4FFF//organize ''Party Name''^000000";
					mes "在聊天窗口中输入。";
					next;
					mes "[Leo Handerson]";
					mes "当然，你必须至少";
					mes " ";
					mes "^4d4dff基础技能等级 7^000000";
					mes "才能使用队伍系统。";
					next;
					mes "[Leo Handerson]";
					mes "我可以进一步说明";
					mes "物品和队伍经验分配，但你以后可以自己尝试。";
					next;
					mes "[Leo Handerson]";
					mes "以上就是";
					mes "队伍系统~";
					mes "像你这样可爱的初心者";
					mes "应该很快就能掌握";
					mes "这些内容~";
					emotion ET_CHUP;
					next;
					break;
				case 3:
					mes "[Leo Handerson]";
					mes "当你达到";
					mes "^4D4DFFLevel 4 Basic Skill^000000";
					mes "或更高时，可以创建聊天室。你可以点击";
					mes "基础信息窗口的^3355FF聊天^000000按钮，或按‘^3355FFAlt^000000’+‘^3355FFC^000000’。";
					next;
					mes "[Leo Handerson]";
					mes "打开聊天室后，";
					mes "右键点击角色名称即可查看聊天室成员信息。";
					next;
					mes "[Leo Handerson]";
					mes "你也可以用同样方式将角色登记为好友。如果你是房主，";
					mes "可以改变";
					mes "房间设置。";
					next;
					mes "[Leo Handerson]";
					mes "在聊天室中，";
					mes "听不到聊天室外的聊天。记住，好吗？";
					next;
					break;
				case 4:
					mes "[Leo Handerson]";
					mes "卡普拉公司的职员遍布世界各地，";
					mes "提供便利的服务和仓库。";
					next;
					mes "[Leo Handerson]";
					mes "其实这房间外就有一名卡普拉职员。和她交谈，她会详细说明卡普拉服务。";
					next;
					mes "[Leo Handerson]";
					mes "无论如何，你可以";
					mes "使用你的";
					mes "^4d4dffpersonal Kafra Storage^000000";
					mes "^4D4DFF基础技能等级 6^000000或更高的";
					next;
					mes "[Leo Handerson]";
					mes "携带太多物品会导致负重过高，无法休息恢复 HP/SP，甚至无法战斗！请将不需要的物品存入卡普拉仓库。";
					next;
					break;
				case 5:
					mes "[Leo Handerson]";
					mes "哦，是吗？";
					mes "不出所料，";
					mes "你和你可爱一样";
					mes "聪明~！";
					mes "我，利奥，对你印象深刻。";
					next;
					set .@end,1;
				}
				if (.@end) break;
			}
			mes "[Leo Handerson]";
			mes "你想进一步了解";
			mes "其他主题吗？";
			mes " ";
			next;
			break;
		case 3:
			mes "[Leo Handerson]";
			mes "^4d4dff表情符号^000000通常用于";
			mes "在线使用^4D4DFF表达感情^000000。这是有趣的交流方式！";
			next;
			mes "[Leo Handerson]";
			mes "首先必须达到";
			mes "^4D4DFFBasic Skill Level 2^000000";
			mes "或更高才能使用表情。";
			next;
			mes "[Leo Handerson]";
			mes "你可以查看";
			mes "表情图标列表";
			mes "（'^3355FFAlt^000000' + '^3355FFL^000000'）并点击各个图标查看显示命令";
			mes "来选择表情。";
			next;
			mes "[Leo Handerson]";
			mes "你也可以将表情";
			mes "登记到快捷栏（‘^3355FFAlt^000000’+‘^3355FFM^000000’），使用快捷键发送。官网也有完整说明。";
			next;
			mes "[Leo Handerson]";
			mes "啊~ 我必须说，";
			mes "坦诚表达";
			mes "自己的感情对关系";
			mes "非常重要。";
			next;
			mes "[Leo Handerson]";
			mes "你可以通过按住";
			mes "石头、剪刀、布";
			mes "按 ^4D4DFFCtrl^000000 及 ^4D4DFF - ^000000、^4D4DFF = ^000000 或 ^4D4DFF \\ ^000000 键来玩。";
			next;
			mes "[Leo Handerson]";
			mes "当然，你必须至少 can type ^4D4DFF//bawi^000000, ^4D4DFF//bo^000000 and ^4D4DFF//gawi^000000, which mean rock, paper, scissors in Korean, into your Chat Window.";
			next;
			mes "[Leo Handerson]";
			mes "要查看更多表情命令，在聊天窗口输入^4d4dff//emotion^000000即可~";
			emotion ET_THROB;
			next;
			break;
		case 4:
			mes "[Leo Handerson]";
			mes "我明白了……";
			mes "你不再需要我";
			mes "了！哦！现在的孩子";
			mes "成长得真快";
			mes "啊！";
			close;
		}
	}
}

new_1-2,121,101,2	script	Guide Soldier#nv1	105,{
	mes "[Guide Soldier]";
	mes "我们这些导游士兵会在每座城镇入口提供地点信息。穿着特殊制服的我们很容易辨认。";
	next;
	mes "[Guide Soldier]";
	mes "每当你第一次来到一座城镇，";
	mes "我们建议你先向我们了解城镇中重要地点的位置。";
	next;
	mes "[Guide Soldier]";
	mes "如果你想参加信息课程，请在训练场四处走走，和不同的导师交谈。祝你今天愉快。";
	close;
}

new_1-2,17,182,5	script	Helper#nv	84,{
	if (nov_2nd_cos < 11) {
		mes "[Elmeen]";
		mes "恭喜你！";
		mes "你通过了第一项训练课程！哇~看来你现在更了解《仙境传说》了。";
		next;
		mes "[Elmeen]";
		mes "你将在这门课程中学习实际战斗的基础。如果你认真完成了信息课程，应该已经获得了一些初始装备。";
		next;
		mes "[Elmeen]";
		mes "请在战斗前检查你的装备。";
		mes "你确定已经装备好所有武器和防具了吗？";
		next;
		switch(select("是:否")) {
		case 1:
			mes "[Elmeen]";
			mes "首先把光标放在怪物上。左键点击会攻击怪物一次。";
			next;
			mes "[Elmeen]";
			mes "如果懒得一直点击，按住^4D4DFFCtrl^000000键左键点击怪物。你会持续攻击，直到一方死亡或逃跑。";
			next;
			mes "[Elmeen]";
			mes "也可以在光标放在怪物上时按住鼠标左键。不过有人懒得每次攻击都使用^4D4DFFCtrl^000000键。";
			next;
			mes "[Elmeen]";
			mes "如果你属于这种人，在聊天窗口输入命令^E79E29//nc^000000。之后左键点击";
			mes "怪物就会持续攻击！";
			next;
			mes "[Elmeen]";
			mes "如果怪物是不死属性，且你拥有‘治愈术’，可以用它攻击。";
			next;
			mes "[Elmeen]";
			mes "按住^4D4DFFShift^000000键使用治愈术，就能以怪物为目标造成伤害。";
			next;
			mes "[Elmeen]";
			mes "当然，这项技能也有方便懒人的选项。在聊天窗口输入^E79E29//ns^000000。";
			next;
			mes "[Elmeen]";
			mes "这样无需按 Shift 键也能用治愈术攻击怪物。方便吧？";
			next;
			mes "[Elmeen]";
			mes "理解这些战斗指令了吗？现在我会教你怪物行为与属性、战斗获得的经验以及怪物掉落物品。";
			next;
			mes "[Elmeen]";
			mes "野外战斗训练对新冒险者可能很危险。让我用魔法给你";
			mes "增加一点力量。";
			next;
			mes "[Elmeen]";
			mes "哈啊啊啊~！";
			if (nov_2nd_cos < 1) {
				if (BaseLevel == 1) {
					set nov_2nd_cos,12;
					getexp 9,0;
				}
				else if (BaseLevel == 2) {
					set nov_2nd_cos,13;
					getexp 16,0;
				}
				else if (BaseLevel == 3) {
					set nov_2nd_cos,14;
					getexp 25,0;
				}
				else if (BaseLevel == 4) {
					set nov_2nd_cos,15;
					getexp 36,0;
				}
				else if (BaseLevel == 5) {
					set nov_2nd_cos,16;
					getexp 77,0;
				}
				else if (BaseLevel == 6) {
					set nov_2nd_cos,17;
					getexp 112,0;
				}
				else if (BaseLevel >= 7) {
					set nov_2nd_cos,18;
					getexp 153,0;
				}
			}
			next;
			mes "[Elmeen]";
			mes "你想先学习哪个主题";
			mes "？";
			mes " ";
			next;
			while(1) {
				switch(select("怪物:经验:物品:退出。")) {
				case 1:
					mes "[Elmeen]";
					mes "有许多主动怪物，即使你还没靠近也会先攻击。 ";
					next;
					mes "[Elmeen]";
					mes "有些怪物会互相协作。攻击其中一只，整群都会包围你并寻求报复。";
					next;
					mes "[Elmeen]";
					mes "每只怪物都有种族、体型和属性。例如有半人、动物、圣属性和恶魔属性怪物。";
					next;
					mes "[Elmeen]";
					mes "了解怪物属性后，就能利用这些知识帮助战斗。";
					next;
					mes "[Elmeen]";
					mes "如果取得能增加对特定属性伤害或减少特定属性伤害的卡片，战斗会轻松许多。";
					next;
					mes "[Elmeen]";
					mes "怪物按体型分为小、中、大。有些卡片能让你对";
					mes "特定体型怪物造成更多伤害。";
					next;
					mes "[Elmeen]";
					mes "每种武器都有优缺点。武器类型会影响对怪物造成的伤害。";
					next;
					mes "[Elmeen]";
					mes "例如短剑类武器对小型怪物造成 100% 伤害，但对大型怪物只有 50%。";
					next;
					mes "[Elmeen]";
					mes "常见怪物属性有水、风、地、火、暗、念和圣。用克制属性攻击怪物可以造成额外伤害~";
					next;
					mes "[Elmeen]";
					mes "但如果你用";
					mes "与怪物同属性的技能或武器攻击，伤害会大幅降低甚至完全无效，甚至可能治疗怪物！";
					next;
					mes "[Elmeen]";
					mes "对于念属性怪物，普通武器无法造成伤害，但其他属性武器可以造成一些伤害。";
					next;
					break;
				case 2:
					mes "[Elmeen]";
					mes "基本上，对怪物造成最多伤害的角色会获得最多经验值。";
					next;
					mes "[Elmeen]";
					mes "因此，你获得的经验值比例取决于造成的伤害占怪物总 HP 的比例。";
					next;
					mes "[Elmeen]";
					mes "假设有个角色叫‘Z’。Z 对总 HP 100 的怪物造成 65 点伤害，怪物死亡时提供 1000 经验。因此 Z 会获得 650 经验。";
					next;
					mes "[Elmeen]";
					mes "不过，在某些情况下规则会有所不同。";
					next;
					mes "[Elmeen]";
					mes "如果两人对同一怪物都造成 65 点伤害，各自获得的经验会根据怪物剩余 HP 而不同。";
					next;
					mes "[Elmeen]";
					mes "例如你正在攻击怪物时，另一个人造成了与你相同的伤害。";
					next;
					mes "[Elmeen]";
					mes "此时你会获得怪物总经验的 2/3，另一个人获得 1/3。";
					next;
					mes "[Elmeen]";
					mes "在 Ragnarok Online 中，不建议攻击别人已经开始攻击的怪物，这被视为无礼行为。";
					next;
					mes "[Elmeen]";
					mes "组队时，队长可以将经验分配设置为平均分配。";
					next;
					mes "[Elmeen]";
					mes "通过这种方式，队员会根据角色等级和队伍人数分享经验。";
					next;
					mes "[Elmeen]";
					mes "组队还有经验加成，比单人获得更多经验。利用这个系统可以更快升级。";
					next;
					break;
				case 3:
					mes "[Elmeen]";
					mes "击杀怪物时，";
					mes "有机会获得物品。此外，某些角色可以用‘偷窃’技能从怪物身上偷取物品。";
					next;
					mes "[Elmeen]";
					mes "别担心偷窃技能会导致击杀后没有掉落物。使用偷窃完全不会影响怪物死亡后的掉落率。";
					next;
					mes "[Elmeen]";
					mes "多人击杀怪物时，造成最多伤害的人优先拾取掉落物。";
					next;
					break;
				case 4:
					mes "[Elmeen]";
					mes "有问题尽管";
					mes "问我，";
					mes "我会回答。";
					close;
				}
			}
		case 2:
			mes "[Elmeen]";
			mes "请保管好训练课程中获得的装备。装备丢失后无法找回。";
			close;
		}
	}
	else {
		mes "[Elmeen]";
		mes "你想先学习哪个主题";
		mes "？";
		next;
		while(1) {
			switch(select("怪物:经验:物品:退出。")) {
			case 1:
				mes "[Elmeen]";
				mes "有许多主动怪物，即使你还没靠近也会先攻击。 ";
				next;
				mes "[Elmeen]";
				mes "有些怪物会互相协作。攻击其中一只，整群都会包围你并寻求报复。";
				next;
				mes "[Elmeen]";
				mes "每只怪物都有种族、体型和属性。例如有半人、动物、圣属性和恶魔属性怪物。";
				next;
				mes "[Elmeen]";
				mes "了解怪物属性后，就能利用这些知识帮助战斗。";
				next;
				mes "[Elmeen]";
				mes "如果取得能增加对特定属性伤害或减少特定属性伤害的卡片，战斗会轻松许多。";
				next;
				mes "[Elmeen]";
				mes "怪物按体型分为小、中、大。有些卡片能让你对 a specific monster size.";
				next;
				mes "[Elmeen]";
				mes "每种武器都有优缺点。武器类型会影响对怪物造成的伤害。";
				next;
				mes "[Elmeen]";
				mes "例如短剑类武器对小型怪物造成 100% 伤害，但对大型怪物只有 50%。";
				next;
				mes "[Elmeen]";
				mes "常见怪物属性有水、风、地、火、暗、念和圣。用克制属性攻击怪物可以造成额外伤害~";
				next;
				mes "[Elmeen]";
				mes "但如果你用";
				mes "与怪物同属性的技能或武器攻击，伤害会大幅降低甚至完全无效，甚至可能治疗怪物！";
				next;
				mes "[Elmeen]";
				mes "对于念属性怪物，普通武器无法造成伤害，但其他属性武器可以造成一些伤害。";
				next;
				break;
			case 2:
				mes "[Elmeen]";
				mes "基本上，对怪物造成最多伤害的角色会获得最多经验值。";
				next;
				mes "[Elmeen]";
				mes "因此，你获得的经验值比例取决于造成的伤害占怪物总 HP 的比例。";
				next;
				mes "[Elmeen]";
				mes "假设有个角色叫‘Z’。Z 对总 HP 100 的怪物造成 65 点伤害，怪物死亡时提供 1000 经验。因此 Z 会获得 650 经验。";
				next;
				mes "[Elmeen]";
				mes "不过，在某些情况下规则会有所不同。";
				next;
				mes "[Elmeen]";
				mes "如果两人对同一怪物都造成 65 点伤害，各自获得的经验会根据怪物剩余 HP 而不同。";
				next;
				mes "[Elmeen]";
				mes "例如你正在攻击怪物时，另一个人造成了与你相同的伤害。";
				next;
				mes "[Elmeen]";
				mes "此时你会获得怪物总经验的 2/3，另一个人获得 1/3。";
				next;
				mes "[Elmeen]";
				mes "在 Ragnarok Online 中，不建议攻击别人已经开始攻击的怪物，这被视为无礼行为。";
				next;
				mes "[Elmeen]";
				mes "组队时，队长可以将经验分配设置为平均分配。";
				next;
				mes "[Elmeen]";
				mes "通过这种方式，队员会根据角色等级和队伍人数分享经验。";
				next;
				mes "[Elmeen]";
				mes "组队还有经验加成，比单人获得更多经验。利用这个系统可以更快升级。";
				next;
				break;
			case 3:
				mes "[Elmeen]";
				mes "击杀怪物时，";
				mes "有机会获得物品。此外，某些角色可以用‘偷窃’技能从怪物身上偷取物品。";
				next;
				mes "[Elmeen]";
				mes "别担心偷窃技能会导致击杀后没有掉落物。使用偷窃完全不会影响怪物死亡后的掉落率。";
				next;
				mes "[Elmeen]";
				mes "多人击杀怪物时，造成最多伤害的人优先拾取掉落物。";
				next;
				break;
			case 4:
				mes "[Elmeen]";
				mes "有问题尽管";
				mes "问我，";
				mes "我会回答。";
				close;
			}
		}
	}
}


		next;
		mes "[Sous Chef]";
		mes "下次我还能再拜托你吗？就是帮忙找食材。";
		npctalk "发现压榨行为！", "Boatswain#dorcon", bc_self;
		npctalk "他拜托别人帮忙真是熟练！", "Helmsman#dorcon", bc_self;
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "有时间我再过来。";
		next;
		mes "[Sous Chef]";
		mes "谢谢。";
		completequest 14555;// Whole new world of taste
		setquest 14563;// Free time
		delitem 522,4;// Mastela Fruit
		delitem 11536,1;// Cat's Ship Biscuit
		close;
	case 2:
		switch( checkquest(14563,PLAYTIME) ) {
		case -1:
			for ( .@quest_id = 14565; .@quest_id < 14567 && isbegin_quest(.@quest_id) == 0; .@quest_id++ )
				continue;
			switch( .@quest_id ) {
			case 14564:
				if (countitem(553) < 20) {
					mes "[Sous Chef]";
					mes "你离开还没多久，已经拿到了吗？还是忘了我拜托你的东西？";
					next;
					mes "[Sous Chef]";
					mes "^0000cd20个面包^000000。为了保持新鲜，你应该快一点。";
					close;
				}
				mes "[Sous Chef]";
				mes "哦，这就是包子……又热又大，和我们这里的完全不同。";
				npctalk "给我一个吧，一个就够我吃一整天了。", "Boatswain#dorcon", bc_self;
				npctalk "没错。", "Boatswain#dorcon", bc_self;
				next;
				mes "[Sous Chef]";
				mes "谢谢你把它们带给我。多亏了你，拉扎格纳的料理又能向前迈进一步了。";
				delitem 553,20;// Bao
				erasequest 14564;// I love buns, too
				setquest 14563;// Free time
				close;
			case 14565:
				if (countitem(11536) < 5 || countitem(12636) < 5) {
					mes "[Sous Chef]";
					mes "你离开还没多久，已经拿到了吗？还是忘了我拜托你的东西？";
					next;
					mes "[Sous Chef]";
					mes "请带来^0000cd5份猫咪硬饼干和5份马兰岛罐头食品^000000。请快一点。";
					close;
				}
				mes "[Sous Chef]";
				mes "猫咪硬饼干和马兰岛罐头食品……嗯，保存时间够长。";
				npctalk "我可以拿给孙子们吃。", "Boatswain#dorcon", bc_self;
				npctalk "前提是你有孙子。", "Helmsman#dorcon", bc_self;
				next;
				mes "[Sous Chef]";
				mes "谢谢你帮我找来这些东西。现在康奇利纳可以想出自己的长期储存食物方法了。";
				delitem 11536,5;// Cat's Ship Biscuit
				delitem 12636,5;// Malang Sp Can
				erasequest 14565;// Emergency food supplies
				setquest 14563;// Free time
				close;
			case 14566:
				if (countitem(7066) < 20) {
					mes "[Sous Chef]";
					mes "你离开还没多久，已经拿到了吗？还是忘了我拜托你的东西？";
					next;
					mes "[Sous Chef]";
					mes "请带来^0000cd20块冰块^000000，给储存的食物保鲜。请快一点。";
					close;
				}
				mes "[Sous Chef]";
				mes "冰块。我真期待看到它们。不融化的冰块！这就是新大陆。";
				npctalk "冰凉的卡鲁格纳牛奶最棒了。", "Boatswain#dorcon", bc_self;
				npctalk "随时都能喝新鲜牛奶！", "Helmsman#dorcon", bc_self;
				next;
				mes "[Sous Chef]";
				mes "谢谢你把它们带给我。多亏了你，康奇利纳的船员可以吃到新鲜食物了。";
				delitem 7066,20;// Ice Cubic
				erasequest 14566;// Brilliant idea
				setquest 14563;// Free time
				close;
			}
			end;
		case 0:
		case 1:
			mes "[Sous Chef]";
			mes "你来这里做什么？是昨天拜托你的事吗？";
			next;
			mes "[Sous Chef]";
			mes "我正在值班，不能继续私人的料理研究。天亮后再来吧。";
			npctalk "年纪轻轻，为什么这么急躁？", "Boatswain#dorcon", bc_self;
			npctalk "因为年轻所以急躁。", "Helmsman#dorcon", bc_self;
			npctalk "做料理时一味着急没有帮助。", "", bc_self;
			close;
		case 2:
			mes "[Sous Chef]";
			mes "来得正好。我刚好有一点空闲，想继续研究新大陆的料理。能帮我找些食材吗？";
			next;
			mes "[Sous Chef]";
			switch( rand(3) ) {
			case 0:
				mes "今天我需要的是^0000cd包子^000000。拉扎格纳也有类似的食物，但配方完全不同。";
				npctalk "包子听起来超级美味。", "Helmsman#dorcon", bc_self;
				npctalk "对你来说有什么听起来不美味吗？", "Boatswain#dorcon", bc_self;
				next;
				mes "[Sous Chef]";
				mes "我想知道它是怎么做的。请带一些给我。^0000cd20个包子^000000就够了。";
				erasequest 14563;// Free time
				setquest 14564;// I love buns, too
				close;
			case 1:
				mes "今天我需要的是^0000cd猫咪硬饼干和马兰岛罐头食品^000000。我很好奇Navi的船员是如何完成如此漫长的航行的。";
				npctalk "听起来很可爱，但不怎么好吃。", "Boatswain#dorcon", bc_self;
				npctalk "但你还是会吃，对吧？", "Helmsman#dorcon", bc_self;
				npctalk "是的。", "Boatswain#dorcon", bc_self;
				next;
				mes "[Sous Chef]";
				mes "我想知道它们是怎么做的。请带一些给我。^0000cd5份猫咪硬饼干和5份马兰岛罐头食品^000000就够了。";
				erasequest 14563;// Free time
				setquest 14565;// Emergency food supplies
				close;
			case 2:
				mes "今天我需要^0000cd冰块^000000。听说某个洞穴里的冰块即使在盛夏也不会融化。";
				npctalk "天啊！为什么不会融化？", "Helmsman#dorcon", bc_self;
				npctalk "我也不知道。这个世界充满了谜团。", "Boatswain#dorcon", bc_self;
				next;
				mes "[Sous Chef]";
				mes "有了它们，我们就能保持食物新鲜，随时喝冰凉的卡鲁格纳牛奶。^0000cd20块冰块^000000就够了，谢谢。";
				erasequest 14563;// Free time
				setquest 14566;// Brilliant idea
				close;
			}
		}
	}
	end;

S_Check:
	.@arg_count = getargcount();
	for ( .@i = 0; .@i < .@arg_count; .@i += 2 ) {
		if ((.@i+2) >= .@arg_count)
			.@tmp$ = "";
		else if ((.@i+4) >= .@arg_count)
			.@tmp$ = " and ";
		else
			.@tmp$ = ", ";
		.@string$ = .@string$ + getarg(.@i+1) + " " + getitemname( getarg(.@i) ) + .@tmp$;
		.@countitem = .@countitem || ( countitem(getarg(.@i)) < getarg(.@i+1) );
	}
	if (.@countitem == 1) {
		mes "没有食材，你想让我怎么办？";
		next;
		mes "[Sous Chef]";
		mes "现在把" + .@string$ + "带给我！";
		close;
	}
	emotion ET_SPARK;
	mes "哦，你把它们全都带来了！我马上为你烹饪。";
	next;
	mes "[Sous Chef]";
	return;
}

lasagna,298,84,5	script	Vigilante#dorcon01	4_DR_SOLDIER,{
	if (lasagna_quest[1] == 21) {
		if (Class != Job_Summoner) {
			mes "[" + strcharinfo(0) + "]";
			mes "你好，我是";
			next;
			mes "[Vigilante]";
			mes "来自新大陆的冒险者。你来这里做什么？需要帮助吗？";
			next;
			mes "[" + strcharinfo(0) + "]";
			mes "我听说我们因为雾气无法出发。我是来确认洞穴里龙的状况的。";
			next;
			mes "[Vigilante]";
			mes "你要独自去做吗？";
			npctalk "以前从没发生过这种事。", "", bc_self;
			next;
			mes "[" + strcharinfo(0) + "]";
			mes "我很着急。";
			next;
			mes "[Vigilante]";
			mes "雾气遮蔽了天空。^0000cd巡逻队^000000还没有回来，可能需要一些时间。";
			next;
			mes "[" + strcharinfo(0) + "]";
			mes "请告诉我龙住在哪里。";
			npctalk "你要自己去那里吗？万一出了什么事怎么办？不会引发外交问题吗……哦……拉扎格纳要完了……不行！", "", bc_self;
			next;
			mes "[Vigilante]";
			mes "那就跟我来。<NAVI>^4D4DFF[龙之巢穴]^000000<INFO>lasa_fild02,340,244,000,1,</INFO></NAVI>在村外田野尽头右侧的洞穴里。";
			erasequest 14548;// Crazy Dragon
			setquest 14549;// No news is not a good news
			lasagna_quest[1] = 22;
			close;
		}
		mes "[" + strcharinfo(0) + "]";
		mes "你好，我是";
		next;
		mes "[Vigilante]";
		mes "你在这里做什么？错过船了吗？";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "我听说我们因为雾气无法出发。我是来确认洞穴里龙的状况的。";
		next;
		mes "[Vigilante]";
		mes "雾气？啊！雾气！什么时候发生的？而且巡逻队还没回来。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "那么龙它……";
		next;
		mes "[Vigilante]";
		mes "前去检查的巡逻队^0000cd还没有回来^000000。一定发生了什么事。你说要去确认龙的状况，对吧？跟我来。";
		npctalk "如果出了什么事，他会需要帮助。", "", bc_self;
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "去哪里？";
		next;
		mes "[Vigilante]";
		mes "就是<NAVI>^4D4DFF[龙之巢穴]^000000<INFO>lasa_fild02,340,244,000,1,</INFO></NAVI>。它在村外田野尽头右侧的洞穴里。你先去，我准备好后跟上。";
		erasequest 14539;// Crazy Dragon
		setquest 14541;// No news is not a good news
		lasagna_quest[1] = 22;
		close;
	}
	if (lasagna_quest[1] == 22) {
		mes "[Vigilante]";
		if (Class != Job_Summoner)
			mes "<NAVI>^4D4DFF[龙之巢穴]^000000<INFO>lasa_fild02,340,244,000,1,</INFO></NAVI>在右侧的洞穴里。那就跟我来。";
		else
			mes "我会跟上你。<NAVI>^4D4DFF[龙之巢穴]^000000在村外田野尽头右侧的洞穴里。";
		close;
	}
	mes "[Vigilante]";
	mes "今天的风很不安定。";
	close;
OnInit:
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "isbegin_quest(14548) == 1 || isbegin_quest(14539) == 1" );
	end;
}

lasa_dun01,29,146,5	script	Vigilante#dorcon03	HIDDEN_WARP_NPC,5,5,{
	end;
OnTouch:
	if (lasagna_quest[1] == 22) {// summoner
		classchange( 4_DR_SOLDIER, "", bc_self );
		mes "[Vigilante]";
		mes "附近看不到它。我们应该继续深入！";
		npctalk "附近看不到它。我们应该继续深入！", "", bc_self;
		close2;
		classchange( HIDDEN_WARP_NPC, "", bc_self );
		end;
	}
	end;
}

lasa_dun01,151,102,5	script	Machie#dorcon01	4_CAT_SAILOR4,{
	if (lasagna_quest[1] == 22) {
		mes "[Machie]";
		mes "......";
		close;
	}
	if (lasagna_quest[1] >= 23 || lasagna_quest[1] < 27) {
		mes "[Machie]";
		mes "我可能装死了，但我不是胆小鬼。它真的又大又吓人。不过现在这不重要。去找Tartufi吧，告诉他我今天没法过去，很抱歉。";
		close;
	}
	if (lasagna_quest[1] == 27) {
		mes "[Machie]";
		mes "你已经处理好了吗？真快。我现在要休息了，你可以走了！";
		close;
	}
	mes "[Machie]";
	mes "蛇蜥今天的行为很奇怪。";
	close;
}

lasa_dun01,153,103,3	script	Vigilante#dorcon02	4_DR_SOLDIER,{
	if (lasagna_quest[1] == 22) {
		mes "[Machie]";
		mes "呃……";
		next;
		mes "[Vigilante]";
		if (Class == Job_Summoner) {
			mes "喂！Machie！醒醒！这是怎么回事？天啊……";
			next;
			mes "[Vigilante]";
			mes "你不是说想把家乡的母亲接过来吗？你不能这样死去！喂，伙计！Machie！别死啊！";
		}
		else {
			mes "喂！Machie！醒醒！这是怎么回事？你不是说想把家乡的母亲接过来吗？你不能这样死去！";
			next;
			mes "[Vigilante]";
			mes "喂，伙计！Machie！别死啊！";
		}
		next;
		mes "[Machie]";
		mes "别用话语杀人。";
		next;
		mes "[Vigilante]";
		mes "Machie？";
		next;
		mes "[Machie]";
		mes "呼……我费了好大劲才装死。它现在走了吗？";
		npctalk "走了。真让人松了口气！", "Machie#dorcon01", bc_self;
		next;
		mes "[Vigilante]";
		mes "什么？";
		next;
		mes "[Machie]";
		mes "最凶猛、最邪恶、最残暴的蛇蜥。这东西很危险，是我见过最可怕的蛇蜥。我吓得脚都扭伤了。";
		npctalk "要不是我的演技，我可能已经死了。", "Machie#dorcon01", bc_self;
		next;
		mes "[Vigilante]";
		mes "所以你装死了？干得好。巡逻队员就该知道如何保命。做得不错。";
		npctalk "耍小聪明这方面你最厉害。", "Machie#dorcon01", bc_self;
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "情况有那么糟吗？";
		next;
		mes "[Machie]";
		if (Class == Job_Summoner)
			mes "这是谁？新人吗？";
		else {
			mes "这是谁？来自新大陆的人？巡逻队的新成员？";
			npctalk "我们现在也接收新大陆的人了吗？", "", bc_self;
		}
		next;
		mes "[Vigilante]";
		mes "不，是在等船出航的冒险者。我猜船因为雾气无法出发。他是来这里调查情况的。";
		next;
		mes "[Machie]";
		mes "我明白了。又是Tartufi惹的麻烦。蛇蜥今天到处乱跑。";
		next;
		if (Class == Job_Summoner) {
			mes "[Vigilante]";
			mes "也许是好天气让它们不舒服。或者它们听到了笛子的曲调之类的。";
			next;
			mes "[Machie]";
			mes "呃……请扶我一下。我没法正常走路。";
			next;
			mes "[Vigilante]";
			mes "冒险者，我应该把他带回基地。你能独自去那里吗？";
			next;
			mes "[Vigilante]";
			mes "^0000cd塔尔图菲^000000就在楼上。去问他出了什么问题。他不会咬人的，你不用害怕。";
			npctalk "他只是个宝宝。", "Machie#dorcon01", bc_self;
			next;
			mes "[" + strcharinfo(0) + "]";
			mes "好的，我去那里。";
			next;
			mes "[Vigilante]";
			mes "不用着急，Tartufi平静下来之前船不会出航。慢慢来，船不能没有你。";
			next;
			mes "[Machie]";
			mes "听起来压力很大。";
			npctalk "你真坏。", "Machie#dorcon01", bc_self;
			next;
			mes "[Vigilante]";
			mes "是吗？我只是希望你慢慢来。好了，进去吧。记住，Tartufi的平静就是海洋的和平，也意味着希望。";
			next;
			mes "[Machie]";
			mes "抱歉让你一个人去！";
			next;
			mes "[" + strcharinfo(0) + "]";
			mes "那么，我该怎么找到龙之巢穴？";
			next;
			mes "[Machie]";
			mes "它很显眼，不会错过的。你一看到就知道那是龙之巢穴。它位于高处，非常醒目……总之你一看就明白。";
			next;
			mes "[" + strcharinfo(0) + "]";
			mes "好，我会回来的。";
			next;
			mes "[Vigilante]";
			mes "好！别害怕！";
			erasequest 14541;// No news is not a good news
			setquest 14542;// How is the Dragon
			lasagna_quest[1] = 23;
			close2;
			warp "lasa_dun_q",190,20;
			end;
		}
		else {
			mes "[Machie]";
			mes "我听说^0000cd有个外来者在捣乱蛇蜥^000000。";
			npctalk "是那边的家伙吗？", "", bc_self;
			next;
			mes "[" + strcharinfo(0) + "]";
			mes "我想可能是我造成的。";
			next;
			mes "[Vigilante]";
			mes "什么？";
			next;
			mes "[Machie]";
			mes "真的吗？";
			npctalk "对吧！我就说嘛！", "", bc_self;
			next;
			mes "[Vigilante]";
			mes "为什么？猎杀蛇蜥对你没有任何好处。";
			next;
			mes "[Machie]";
			mes "也许只是出于好奇。如果我去了新大陆，也会对所有东西都戳一戳。呃……请扶我一下，我没法正常走路。";
			next;
			mes "[Vigilante]";
			mes "冒险者，我应该把他带回基地。你能独自去那里吗？^0000cdTartufi^000000就在楼上，去问问他出了什么问题。";
			next;
			mes "[Vigilante]";
			mes "我想冒险者已经知道问题所在了。";
			emotion ET_SWEAT;
			next;
			mes "[Machie]";
			mes "你不用这样说。";
			npctalk "什么！这就是真的！", "", bc_self;
			next;
			mes "[Vigilante]";
			mes "如果那家伙不去招惹蛇蜥，就不会发生这种事。好了，去吧。";
			next;
			mes "[Vigilante]";
			mes "记住，Tartufi的平静就是海洋的和平，也意味着希望。请设法取得Tartufi的好感。";
			npctalk "拜托了。", "", bc_self;
			next;
			mes "[" + strcharinfo(0) + "]";
			mes "好的。我会设法解决问题。";
			close2;
			erasequest 14549;// No news is not a good news
			setquest 14550;// How is the Dragon
			lasagna_quest[1] = 23;
			end;
		}
	}
	if (lasagna_quest[1] >= 23 && lasagna_quest[1] < 27) {
		mes "[Vigilante]";
		mes "你先去见Tartufi。我休息后就带Machie回去。记住，Tartufi的平静就是海洋的和平，也意味着希望。";
		close2;
		if (Class == Job_Summoner)
			warp "lasa_dun_q",190,20;
		end;
	}
	if (lasagna_quest[1] == 27) {
		mes "[Vigilante]";
		mes "Tartufi应该已经平静下来了。请你先去。Machie能走一点后我就和他一起过去。把他背在背上太重了。";
		close;
	}
	mes "[Vigilante]";
	mes "你能站起来吗？";
	next;
	mes "[Machie]";
	mes "不能。我希望有人能背我……";
	next;
	mes "[Vigilante]";
	mes "你是故意说给我听的吧。想都别想。我也累得很。";
	next;
	mes "[Machie]";
	mes "切。";
	close;
OnInit:
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "isbegin_quest(14541) == 1 || isbegin_quest(14549) == 1" );
	end;
}

lasa_dun_q,162,158,3	script	Tartufi#dorcon01	4_TARUTUPI,{
	if (lasagna_quest[1] == 23) {
		mes "[Tartufi]";
		mes "讨厌的苍蝇，讨厌的蚊子，真烦人。我到底是为了什么名声和财富，独自待在这里……";
		npctalk "妈妈，爸爸……我想你们了。", "", bc_self;
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "Tartufi？";
		next;
		mes "[Tartufi]";
		mes "你们今天已经够烦人了。你们到底怎么回事？难道全都是虎斑蛾吗？";
		npctalk "想来点虎斑猛击之类的吗？", "", bc_self;
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "听着，我不是蛇蜥。";
		next;
		mes "[Tartufi]";
		mes "你是谁？话说回来，我以前从没见过你……Magchi在哪里？";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "Magchi在巡逻时受了伤，已经回去了。";
		next;
		mes "[Tartufi]";
		mes "糟糕，发生了什么？";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "一只巨大的蛇蜥出现了，他受惊后弄伤了腿。另一名巡逻队员带他回去了，我相信他已经安全返回。";
		next;
		mes "[Tartufi]";
		mes "是吗？那我想他还没死。我一直很好奇Magchi每天讲给我的故事后续。哦，你也知道那个故事吗？";
		next;
		mes "[Tartufi]";
		mes "就是《我在满月之夜目睹了谋杀》。如果你知道这个故事，就讲给我听。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "完全不知道。我从没听说过。";
		next;
		mes "[Tartufi]";
		mes "真的吗？那是Magchi编的故事吗？你要去处理它们吗？";

		next;
		mes "[考古学家莱芬]";
		mes "哦，果然是你……！！";
		mes "是你救了艾尔瓦。谢谢你帮助我的朋友！";
		next;
		npctalk "纳林：我是为自己做的。不用道谢。", "", bc_self;
		mes "[纳林]";
		mes "我只是想这么做。我的执念是……";
		mes "^0000CD我不想让任何人死在这里。我想拯救所有生命。^000000……";
		mes "仅此而已。";
		next;
		emotion ET_ANGER;
		mes "[纳林]";
		mes "哦……真的，这故事太傻了。很难继续说下去。";
		mes "能暂时让我一个人待着吗？抱歉耽误了这么久。";
		next;
		mes "[考古学家莱芬]";
		mes "没关系。我暂时离开一下。" + .@player_name$ + "，我们一起走吧。";
		emotion ET_OK, .@account_id;
		ill_turtle = 10;
		erasequest 16116;	// Continuous story
		setquest 16117;	// Continuous story 2
		close2;
		cloakonnpcself( "Archeologist Leiphen#illtur01" );
		end;
	}
	if (ill_turtle == 10) {
		mes "[纳林]";
		mes "谢谢你等我。我现在没事了。让我说完吧。";
		next;
		cloakoffnpcself( "Archeologist Leiphen#illtur01" );
		emotion ET_DELIGHT, getnpcid(0,"Archeologist Leiphen#illtur01");
		npctalk "考古学家莱芬：我准备好了。这里有很多有趣的东西。", "Archeologist Leiphen#illtur01", bc_self;
		mes "[纳林]";
		mes "不是第一次有人来到这里，但这种事很少见。我第一次看到有人时，想起了自己的愿望。";
		next;
		mes "[纳林]";
		mes "那个人害怕得要死，但他活着离开了这里。";
		mes "从那以后……我就能多待一会儿。";
		next;
		mes "[纳林]";
		mes "过了一段时间，我没有失去理智。没有被怨恨冲走，也没有失去理性和感情。";
		next;
		mes "[纳林]";
		mes "所以我想拯救所有生命，无论是流入这里的，还是永远被负担困住的。";
		mes "我意识到，被我救下的人都回到了他们来的地方。";
		npctalk "纳林：只有我独自知道并感受着自己是谁、在做什么。", "", bc_self;
		next;
		mes "[纳林]";
		mes "这……很难。连我都羡慕那些被负担困住的人。但是……我无法对处于危险中的人视而不见。";
		mes "……";
		mes "但我不想抱有希望。抱有希望……就可能被背叛。";
		npctalk "纳林：……我的故事到这里结束。现在把碎片给我，你们两个就可以回去了……", "", bc_self;
		next;
		mes "[纳林]";
		mes "哦，我差点忘了。让我再对你们施一次法术。法术很弱，维持不了多久。";
		mes "在它结束前离开吧。";
		specialeffect EF_DETECT3;
		sleep2 1000;
		specialeffect2 EF_DETECT3;
		specialeffect EF_DETECT3, AREA, "Archeologist Leiphen#illtur01";
		specialeffect2 EF_CIRCLEPOWER8;
		specialeffect EF_CIRCLEPOWER8, AREA, "Archeologist Leiphen#illtur01";
		next;
		if (select( "你独自一人一定很难受。", "我不会回去。" ) == 2) {
			mes "[纳林]";
			mes "……我说这么长的故事，不是想听这个……";
			mes "请不要在意我……";
			next;
			unittalk .@account_id, "" + .@player_name$ + " : Please, we do care. I will be glad when I get back again. I will be sad if you are cold when I come here again.", bc_self;
			mes "[考古学家莱芬]";
			mes "" + .@player_name$ + "，没想到你很会说话。";
		}
		else {
			mes "[纳林]";
			mes "你在说什么？！我说听完我的故事就回去……！";
			mes "我不想再担心了！";
			next;
			unittalk .@account_id, "" + .@player_name$ + " : Please, we do care. Archeologist Leiphen and myself will meet your expectations.", bc_self;
			mes "[考古学家莱芬]";
			mes "是的。这正是我想说的。";
		}
		next;
		mes "[纳林]";
		mes "你是什么意思……？";
		next;
		unittalk .@account_id, "" + .@player_name$ + " : We will come back. Do not feel alone.", bc_self;
		mes "[考古学家莱芬]";
		mes "让我们帮助这里其他像你一样的灵魂，纳林，让他们得到解脱。";
		next;
		mes "[纳林]";
		mes "哦，真的吗……";
		emotion ET_THINK;
		mes "……不，那只是巧合。他们和我不一样。";
		next;
		mes "[考古学家莱芬]";
		mes "我们走着瞧。对吧？";
		unittalk .@account_id, "" + .@player_name$ + " : Of course. And if it doesn't work, we'll come back to try again and again.", bc_self;
		next;
		npctalk "纳林：不，别回来。这里非常危险。不要试图回来。", "", bc_self;
	mes "[纳林]";
		mes "没关系。我会忘记你们两个。这里所有灵魂都是这样。";
		mes "我可能会记得久一点，但最终还是会忘记。";
		next;
		emotion ET_SURPRISE, .@account_id;
		unittalk .@account_id, "" + .@player_name$ + " : But you still remember the turtle shell pieces. You can remember again.", bc_self;
		next;
		mes "[考古学家莱芬]";
		mes "我们可以推测一件事。所有失去的记忆都存在于纳林的潜意识中。";
		unittalk .@account_id, "" + .@player_name$ + " : You said you want to save all life. If you haven't given up on that wish, you can surely remember it.", bc_self;
		next;
		unittalk .@account_id, "" + .@player_name$ + " : If you forget us, we will remind you. As much as you forget.", bc_self;
		sleep2 2000;
		unittalk .@account_id, "" + .@player_name$ + " : I'll help you when you feel lonely. You won't have to forget everything.", bc_self;
		mes "[考古学家莱芬]";
		mes "我会回来。为了研究，也为了你，纳林。";
		next;
		mes "[纳林]";
		mes "真的……真的吗？你们会回来这里找我吗？";
		next;
	mes "[纳林]";
		mes "我不必……独自一人吗……？";
		next;
		select( "我不会让你孤单。", "别担心。", "我保证。", "我会回来。" );	// note: the selection doesn't change the dialog
		mes "[纳林]";
		mes ".........";
		next;
	mes "[纳林]";
		mes "……谢谢……";
		next;
		mes "[纳林]";
		mes "谢谢……真的……";
		next;
		delitem 25315, countitem(25315);	// Piece_Of_Shell
		specialeffect2 EF_CIRCLEPOWER2;
		specialeffect EF_CIRCLEPOWER2, AREA, "Archeologist Leiphen#illtur01";
		sleep2 500;
		emotion ET_SURPRISE, getnpcid(0,"Archeologist Leiphen#illtur01");
		mes "[考古学家莱芬]";
		mes "嗯？什么？它消失了。" + getitemname(25315) + "。";
		mes "突然从我手中消失……像融化了一样。";
		next;
	mes "[纳林]";
		mes "它承载着我的愿望。现在……它不需要继续存在了。";
		npctalk "考古学家莱芬：这是什么意思？", "Archeologist Leiphen#illtur01", bc_self;
		next;
		emotion ET_ANGER;
		mes "[纳林]";
		mes "……我、我不知道具体原因……只是可能如此。";
		next;
		mes "[纳林]";
		mes "……哦，对了。给……这个给你。教授，你也拿着。";
		unittalk .@account_id, "" + .@player_name$ + " : What's this?", bc_self;
		npctalk "考古学家莱芬：这……这是" + getitemname(25271) + "！", "Archeologist Leiphen#illtur01", bc_self;
		next;
		npctalk "纳林：……是吗？其实我是因为它漂亮才留着的。", "", bc_self;
		mes "[纳林]";
		mes "这是约定的证明。我会努力记住你们两个。所以来吧……来找我。";
		mes "明天，还有后天……我会等着……哥哥和教授。";
		next;
		mes "[纳林]";
		mes "还有其他人……你说过会帮助他们。我会告诉你方法，告诉你如何帮助……";
		next;
		mes "[纳林]";
		mes "^0000CD听听他们想要什么。兄弟，即使你觉得事情微不足道，也做些让他们高兴的事。^000000";
		mes "请……也许有一天……";
		next;
		select("别担心。我会的。" );
		mes "[纳林]";
		mes ":)...";
		next;
		mes "[纳林]";
		mes "我、我之所以能一直独自待到现在，是因为总有一天还能再次见到你们两个吗？";
		emotion ET_OK;
		mes "我会……记住……请……回来。";
		next;
		mes "[考古学家莱芬]";
		mes "在找到所有秘密之前，我会留在这里。";
		mes "别担心。" + .@player_name$ + "和我不会忘记你，纳林。";
		unittalk .@account_id, "" + .@player_name$ + " : We must remember.", bc_self;
		ill_turtle = 11;
		erasequest 16117;	// Continuous story 2
		setquest 16105;	// A short break, and a promise
		getitem 25271,5;	// IllusionStone
		getexp 2880000,1920000;
		close2;
		npctalk "考古学家莱芬：好，再见！", "Archeologist Leiphen#illtur01", bc_self;
		cloakonnpcself( "Archeologist Leiphen#illtur01" );
		end;
	}
	switch( checkquest(16105,PLAYTIME) ) {
	case -1:
		break;
	case 0:
	case 1:
		mes "[纳林]";
		mes "我让你回来……但你今天必须离开。继续待在这里很危险。";
		mes "保护法术是有时限的。";
		next;
		mes "[纳林]";
		mes "一天结束了，你们两个要待在一起。我会给你们新的法术。";
		mes "如果我又忘记了……请让我努力记住……";
		close;
	case 2:
		erasequest 16105;	// A short break, and a promise
		break;
	}
	switch( checkquest(16108,PLAYTIME) ) {
	case -1:
		break;
	case 0:
	case 1:
		mes "[纳林]";
		mes "哥哥……你还在吗？法术一天后就会消失，请天亮后再回来。";
		next;
		mes "[纳林]";
		mes "即使我忘记了你，哥哥，也不要离开……求你了。";
		close;
	case 2:
		erasequest 16108;	// A memory that should not be forgotten - Cooldown
		break;
	}
	switch( isbegin_quest(16106) ) {
	case 0:
		mes "[纳林]";
		mes "又来了……陌生人。";
		mes "回去。这里很危险……";
		next;
		mes " - ^424242她想不起来了，但即使没有记忆，她也和其他幽灵不同。^000000 -";
		next;
		mes "[纳林]";
		mes "……你为什么那样喃喃自语？";
		mes "回去。你不属于这里。";
		next;
		if (select( "她想要什么……", "现在回去。" ) == 2) {
		mes " - ^424242我们现在回去吧。教授似乎还没出事。我稍后再回来。^000000 -";
			next;
			mes "[纳林]";
			mes "回去，陌生人。永远不要再回来。";
			close;
		}
		mes " - ^424242……她希望我和考古学家莱芬一起离开。这样她就会想起来……";
		mes "教授会回来的。我们去找他吧。^000000-";
		setquest 16106;	// A memory that should not be forgotten 1
		close;
	case 1:
		mes "[纳林]";
		mes "回去……你不该在这里。";
		next;
		mes " - ^424242……她希望我和考古学家莱芬一起离开。这样她就会想起来……";
		mes "教授会回来的。我们去找他吧。^000000-";
		close;
	case 2:
		cloakoffnpcself( "Archeologist Leiphen#illtur01" );
		mes "[考古学家莱芬]";
		mes "我又来这里了。嗯，每天都来。";
		sleep2 500;
		unittalk .@account_id, "" + .@player_name$ + " : I am here too. Are you doing well?", bc_self;
		next;
		mes "[纳林]";
		mes "......";
		next;
		mes "[纳林]";
		mes "............";
		next;
		mes "[纳林]";
		mes ".................";
		next;
		mes "[纳林]";
		mes "................Aww..";
		unittalk .@account_id, "" + .@player_name$ + " : Hey? What's going on?", bc_self;
		next;
		emotion ET_SWEAT;
		mes "[纳林]";
		mes "……又一次……我又忘了……";
		unittalk .@account_id, "" + .@player_name$ + " : It's ok. We are here again.", bc_self;
		next;
		npctalk "纳林：从我记事起，我就一直在等待……", "", bc_self;
		mes "[纳林]";
		mes "谢谢……嗯，让我给你们施个法术。今天你们也要去找其他人吗？";
		next;
		mes "[纳林]";
		mes "希望你们两个平安……";
		specialeffect EF_DETECT3;
		sleep2 500;
		specialeffect2 EF_DETECT3;
		specialeffect EF_DETECT3, AREA, "Archeologist Leiphen#illtur01";
		specialeffect2 EF_CIRCLEPOWER8;
		specialeffect EF_CIRCLEPOWER8, AREA, "Archeologist Leiphen#illtur01";
		next;
		mes "[纳林]";
		mes "还有这个，作为约定的证明。教授和哥哥。很高兴你们来了。";
		mes "我会等到明天。";
		npctalk "考古学家莱芬：明天见，纳林。还有你。", "Archeologist Leiphen#illtur01", bc_self;
		erasequest 16106;	// A memory that should not be forgotten 1
		erasequest 16107;	// A memory that should not be forgotten 2
		setquest 16108;	// A memory that should not be forgotten - Cooldown
		getitem 25271,1;	// IllusionStone
		getexp 1200000,1000000;
		close2;
		cloakonnpcself( "Archeologist Leiphen#illtur01" );
		end;
	}
	end;

OnInit:
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "ill_turtle == 1" );
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "ill_turtle == 8" );
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "ill_turtle == 9" );
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "ill_turtle == 10" );

	// daily
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "ill_turtle > 10 && checkquest(16105,PLAYTIME) == 2" );
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "ill_turtle > 10 && checkquest(16108,PLAYTIME) == 2" );
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "ill_turtle > 10 && isbegin_quest(16106) == 2" );
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "ill_turtle > 10 && isbegin_quest(16106) == 0 && checkquest(16105,PLAYTIME) == -1 && checkquest(16108,PLAYTIME) == -1" );
	end;
}

tur_d03_i,136,187,5	duplicate(dummy_cloaked_npc)	Archeologist Leiphen#illtur01	2_M_ALCHE


tur_d03_i,80,180,1	script	Impatient Man#illtur	4_M_URGENT_MAN,{
	if (ill_turtle == 2) {
		.@account_id = getcharid(3);
		.@player_name$ = strcharinfo(0);

		mes "[焦躁的男人]";
		mes "我弄丢她了。我弄丢她了。我的孩子，我漂亮的孩子。你在哪里？我的孩子。她叫什么？我的女儿。女儿？我的孩子。";
		next;
		unittalk .@account_id, "" + .@player_name$ + " : Hey, hello?", bc_self;
		mes " - ^424242正如她告诉我的，还有其他人……但他看起来不像考古学家莱芬。^000000 - ";
		next;
		mes "[焦躁的男人]";
		mes "是谁？我的孩子，你在哪里？我的女儿？我的……女儿？哈，哈哈哈。我弄丢她了。我弄丢她了。";
		next;
		npctalk "我的孩子不见了……我的孩子，我可爱的孩子。", "", bc_self;
		unittalk .@account_id, "" + .@player_name$ + " : Did he lose his baby...?", bc_self;
		select( "你在找你的孩子吗？", "你需要我的帮助吗？" );
		npctalk "我的孩子，我弄丢她了。我弄丢了我的孩子。你在哪里？", "", bc_self;
		mes "[焦躁的男人]";
		mes "不。^FF0000你不能^000000。";
		next;
		npctalk "我的孩子？孩子？我弄丢了、弄丢了我的女儿……孩子。在哪里……在哪里？", "", bc_self;
		unittalk .@account_id, "" + .@player_name$ + " : ...Excuse me?", bc_self;
		mes "[焦躁的男人]";
		mes "不。^FF0000不。^000000找不到她。";
		next;
		mes "[焦躁的男人]";
		mes "不，^FF0000不可能。我的女儿。^000000孩子……孩子？不。哈，哈哈^FF0000哈。不要。哈，哈。^000000我的^FF0000漂亮孩子，^000000孩子。我的^FF0000漂亮孩子。不。^000000不。";
		ill_turtle = 3;
		erasequest 16097;	// Stranger on Turtle Island 1
		questinfo_refresh();
		next;
		unittalk .@account_id, "" + .@player_name$ + " : He's...a strange man.", bc_self;
		mes " - ^424242很难与他交流……^000000 - ";
		mes " - ^424242去看看另一个地点。走吧……^000000 - ";
		close;
	}
	if (ill_turtle == 3) {
		mes "[焦躁的男人]";
		mes "^FF0000不，我的女儿。我的^000000漂亮孩子。不。丢了，^FF0000弄丢她了^000000。丢了。呜呜……我的^FF0000漂亮……孩子……找不到，^000000^FF0000找不到^000000，不能……^FF0000找到^000000……";
		if (!.talk)
			donpcevent "Impatient Man#illtur::OnTalk";
		close;
	}
	mes "[焦躁的男人]";
	mes "我弄丢她了。我弄丢她了。我的孩子，我漂亮的孩子。你在哪里？我的孩子。她叫什么？我的女儿。女儿？我的孩子。";
	next;
	mes "[焦躁的男人]";
	mes "是谁？我的孩子……是谁？";
	if (!.talk)
		donpcevent "Impatient Man#illtur::OnTalk";
	close;

OnTalk:
	.talk = 1;
	switch( rand(2) ) {
	case 0:
		npctalk "我找不到……我的孩子。不见了。我的……可爱的女儿。";
		sleep 3000;
		npctalk "我找不到。消失了……我的女儿，我的……女儿？我的？孩子……";
		break;
	case 1:
		npctalk "我的孩子，我弄丢她了。我弄丢了我的孩子。你在哪里？";
		sleep 3000;
		npctalk "我的孩子？孩子？我弄丢了、弄丢了我的女儿……孩子。在哪里……在哪里？";
		break;
	}
	.talk = 0;
	end;

OnInit:
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "ill_turtle == 2" );
	end;
}


tur_d03_i,235,187,7	script	Susceptible Soldier#	4_M_KEEN_SOLDIER,{
	if (ill_turtle == 3) {
		.@account_id = getcharid(3);
		.@player_name$ = strcharinfo(0);

		mes "[易受影响的士兵]";
		mes "喃喃……^FF0000咀嚼^000000，咀嚼。^FF0000喃喃^000000……";
		mes "该死的^BDBDBD呃……^000000怪……^BDBDBD怪物^000000……";
		next;
		mes "[易受影响的士兵]";
		mes "这一切……都是我的。^BDBDBD这一切^000000都能^BDBDBD成为^000000我的……";
		mes "我的……我珍贵的^BDBDBD宝藏^000000……^FF0000喃喃^000000……";
		next;
		unittalk .@account_id, "" + .@player_name$ + " : Hum... Hey, hello?", bc_self;
		mes " - ^424242那里有人。他似乎在喃喃自语，但听不清。他看起来不像考古学家莱芬。^000000 - ";
		next;
		mes " - ^424242他在咬指甲，指尖也被弄得乱七八糟……^000000 - ";
		next;
		npctalk "我的宝藏，如果" + getmonsterinfo("ILL_ASSULTER", MOB_NAME) + "消失了……全部，咀嚼……咀嚼……", "Susceptible Soldier#", bc_self;
		mes "[易受影响的士兵]";

gl_prison1,137,138,5	script	Zealotus#LhzHat	1200,{
	if(ZLMASKQ == 0)
	{
		mes "[Zealotus]";
		mes "跪下，虫子！";
		mes "作为这座";
		mes "地下监狱的统治者，";
		mes "我命令所有踏入";
		mes "我私人领域的人！";
		next;
		mes "[Zealotus]";
		mes "反抗就会受到惩罚！";
		mes "匍匐下来亲吻我的脚，";
		mes "也许我会饶你一命。";
		mes "呵呵呵呵呵！";
		next;
		switch( select(  "哦，殿下！", "随便吧。" ) )
		{
			case 1:
				mes "[Zealotus]";
				mes "顺从的女人只是";
				mes "傲慢男人的理想梦境！";
				mes "真正的女人享受";
				mes "让男人听从自己命令的力量！";
				mes "";
				next;
				switch( select( "是的，太对了！", "嘘——！" ) )
				{
					case 1:
						mes "[Zealotus]";
						mes "然而，我对力量的渴望可能无意中";
						mes "过分压垮了爱人的精神。他的骄傲崩溃，";
						mes "我的男人甚至在人类面前瑟瑟发抖！这让我很痛苦。";
						next;
						mes "[Zealotus]";
						mes "向你提出这个请求有失我的身份，";
						mes "但只有像你这样的人类";
						mes "才能让他记起真正的自己，";
						mes "一个骄傲的黑暗生物，";
						mes "只应该害怕我！";
						mes "";
						next;
						mes "[Zealotus]";
						mes "人类。如果你能让监狱角落里";
						mes "那个哭泣的可怜魔物";
						mes "认识到自己的真实本性，";
						mes "我会分给你一小部分力量。";
						mes "";
						mes "";
						set ZLMASKQ,1;
						close;
					case 2:
						mes "[Zealotus]";
						mes "你这个肮脏的人类……";
						mes "竟敢拥有与我不同的";
						mes "意见！";
						mes "无所谓。总有一天，";
						mes "你们全族都会";
						mes "只称我为‘女王’。";
						close;
				}
			case 2:
				mes "[Zealotus]";
				mes "凡人蠢货！";
				mes "呸！粗野畜生的嘲弄";
				mes "对我毫无价值。";
				mes "我有的是时间，";
				mes "把你的骄傲碾成尘土，";
				mes "踩在我的脚下。";
				close;
		}
	}
	else if(ZLMASKQ > 0 && ZLMASKQ < 6)
	{
		mes "[Zealotus]";
		mes "嗯。如果我的爱人";
		mes "固执或拒绝听从，";
		mes "尽管采取极端措施。想想";
		mes "换成我的话会怎么做。";
		mes "呵呵呵呵呵~！";
		mes "";
		close;
	}
	else if(ZLMASKQ == 6)
	{
		mes "[Zealotus]";
		mes "哦，你回来了。";
		mes "菲恩达克确实";
		mes "恢复了原来的样子，";
		mes "多亏了你的努力，人类。";
		mes "是的，他的愤怒、勇气";
		mes "和热情都恢复了~";
		next;
		mes "[Zealotus]";
		mes "如我所承诺，我会";
		mes "分给你一部分力量。";
		mes "不过，我需要一些物品";
		mes "来形成你我之间的契约。";
		mes "";
		next;
		mes "[Zealotus]";
		mes "我需要";
		mes "^3131FF1 个猫眼^000000、";
		mes "^3131FF1 根禁忌红蜡烛^000000 和";
		mes "^3131FF30 张旧魔法卷轴^000000。";
		mes "这样我就能按约定";
		mes "赐予你一部分力量。";
		set ZLMASKQ,7;
		close;
	}
	else if(ZLMASKQ == 7)
	{
		if(countitem(7263) && countitem(660) && countitem(7099) > 29)
		{
			mes "[Zealotus]";

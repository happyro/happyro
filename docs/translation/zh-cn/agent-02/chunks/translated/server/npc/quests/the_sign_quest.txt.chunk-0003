				mes "告诉我，"+ strcharinfo(0) +"。";
				close;
			case 2:
				mes "[Elle]";
			mes "嗯……我不知道该说什么？";
				next;
				mes "[Elle]";
			mes "他是我的雇主，我对他有自己的看法，但告诉你可能显得不专业。不过如果你之后有时间，我也许会告诉你。呵呵~";
				close;
			}
		}
		else {
			switch(select("艾尔小姐，你的皮肤真好。:告诉我关于 Metz 的事。")) {
			case 1:
				mes "[Elle]";
				mes "嗯……？谢谢！也许是因为我不常出门。你的皮肤也很好，我也不常出门，"+ strcharinfo(0) +"~";
				close;
			case 2:
				mes "[Elle]";
			mes "嗯……我不知道该说什么？";
				next;
				mes "[Elle]";
			mes "他是我的雇主，我对他有自己的看法，但告诉你可能显得不专业。不过如果你之后有时间，我也许会告诉你。";
				close;
			}
		}
	}
	else if (sign_q < 13) {
			mes "我最近不太忙，但之前努力工作了一阵，身体都酸痛了。哦，我在说什么？请别在意——！呵呵呵~";
		emotion ET_PROFUSELY_SWEAT;
		close;
	}
	else if (sign_q < 15) {
			mes "男人永远不懂女孩真正想要什么！他们总是害怕表达兴趣~";
		next;
		mes "[Elle]";
			mes "即使他们约我，我也不会轻易接受。哼，反正外面也没多少我喜欢的男孩。";
		emotion ET_HNG;
		close;
	}
	else if (sign_q < 20) {
			mes "^333333*呼……*^000000 今天明明没怎么工作，我却好累。有些日子毫无理由地感到精疲力竭……";
		next;
		mes "[Elle]";
			mes "我该请假休息。如果有些饮料，那就完美了……";
		close2;
		if (countitem(504) > 0) {
			select("你为什么不拿这个？");
			mes "[Elle]";
			mes "哦，你不用这么做，但还是非常感谢你！啊~~~~~";
			delitem 504,1; //White_Potion
			close2;
			emotion ET_CHUPCHUP;
			end;
		}
		end;
	}
	else if (sign_q < 25) {
		mes "洁斯奎安？她既美丽又有才华，真的很优秀。所以……";
		next;
		mes "[Elle]";
		mes "我把她当作对手！她也许比我聪明，但也许我能比她更美……";
		emotion ET_THINK;
		close;
	}
	else if (sign_q < 35) {
		mes "你以前去过科莫多吗？那里很美，有很多事情可以做！";
		next;
		mes "[Elle]";
		mes "我喜欢在科莫多赌博，但觉得有点上瘾。我甚至见过以赌博为生的人……";
		close;
	}
	else if (sign_q < 54) {
		mes "我记得有位为贝克兰大师工作的女士，名叫赛琳。听说她来自遥远的国家……";
		next;
		mes "[Elle]";
		mes "我见过她一次，我觉得她有独特的美丽风格。总之和我的或洁斯奎安的都不同……";
		close;
	}
	else if (sign_q == 54) {
		emotion ET_DELIGHT;
		mes "啦啦啦~~哦，你好。";
		mes "好久不见。啦啦啦~~";
		next;
		switch(select("怎么了？:发生了什么？")) {
		case 1:
			mes "[Elle]";
			mes "哦……？糟糕……！我看起来真的那么兴奋吗？";
			next;
			mes "[Elle]";
			mes "我刚开始和某人交往！他是个高个帅哥，我太爱他了，而且他……";
			next;
			mes "^3355FF即使你离开房间后，Elle 仍继续谈论她有多爱新男友。^000000";
			close;
		case 2:
			mes "[Elle]";
			mes "嗯……是的，我遇到了非常好的事。呵呵呵呵！但这是秘密~";
			close;
		}
	}
	else if (sign_q == 97) {
		mes "啊~你好！很高兴再次见到你~";
		next;
		mes "[Elle]";
		mes "呃，抱歉，我听说你遇到了糟糕的事。不过别担心，下次也许会更幸运~";
		close;
	}
	else {
		mes "^333333*叹气……*^000000 最近拜访 Metz 大师的客人太多了。他们为什么不能把脏东西留在庄园外？";
		emotion ET_HNG;
		close;
	}
}


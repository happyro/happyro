				if (.@black_q == 100) {
					set BSMITH_Q,3;
					if (checkquest(2001) != -1) {
						changequest 2001,2002;
					} else {
						changequest 2000,2002;
					}
					mes "哦呵呵～";
					mes "这个分数";
					mes "对你来说";
					mes "完全没问题！";
					next;
					mes "[基修彭斯特]";
					mes "我会交给你一项工作！";
					mes "给我一点时间准备必要的安排。";
					mes "你回来时我就准备好了！";
					close;
				}
				set BSMITH_Q,2;
				if (checkquest(2001) == -1) {
					changequest 2000,2001;
				}
				mes ".............";
				next;
				mes "[基修彭斯特]";
				if (BSMITH_Q == 2) {
					mes "这要怎么说呢？";
					mes "你怎么又失败了？！";
					mes "如果你打算这样执行任务，我无法把任何工作交给你……";
					close;
				}
				mes "嗯……";
				mes "虽然不想这么说，但看来你还需要多学习。";
				mes "凭这个分数，";
				mes "你永远成不了铁匠！";
				close;
			}
			mes "[基修彭斯特]";
			mes "啊，晚点回来当然没关系。提前准备可以避免灾难。";
			mes "毕竟，小心一点";
			mes "没有坏处～";
			close;
		}
		/*
		else if (BSMITH_Q == 2) {
			mes "[基修彭斯特]";
			mes "那么，你这次";
			mes "这次有没有";
			mes "多学一点？";
			next;
			mes "[基修彭斯特]";
			mes "我承认要求第一次就满分不太合理，所以我会给你";
			mes "稍微放宽一些……";
			next;
			mes "[基修彭斯特]";
			mes "你可以答错";
			mes "答错一道题！";
			mes "好了，开始吧";
			mes "开始答题吧～";
			next;
			goto L_AskQuestions;
		}
		*/
		else if (BSMITH_Q == 3) {
			mes "[基修彭斯特]";
			mes "嗯……";
			mes "那些订单申请表";
			mes "放在哪里了……";
			next;
			mes "^3355FF*翻动纸张*";
			mes "*纸张沙沙作响*^000000";
			next;
			mes "[基修彭斯特]";
			mes "哦！在这里！";
			mes "这是拖延";
			mes "最久的订单……";
			mes "嘿嘿～";
			next;
			mes "[基修彭斯特]";
			mes "好吧，要制作";
			mes "这个，你需要……";
			next;
			switch(rand(1,5)) {
			//Steel, Rotten_Bandage, Blue_Gemstone, Arc_Wand
			case 1: setarray .@items[0], 999,1, 930,1, 717,2, 1610,1, 4; changequest 2002,2003; break;
			//Sparkling_Dust, Skel_Bone, Zargon, Gladius
			case 2: setarray .@items[0], 1001,2, 932,1, 912,1, 1219,1, 5; changequest 2002,2004; break;
			//Coal, Shell, Boody_Red, Tsurugi
			case 3: setarray .@items[0], 1003,1, 935,2, 990,2, 1119,1, 6; changequest 2002,2005; break;
			//Iron_Ore, Eye_Bandage, Blue_Gemstone, Arbalest
			case 4: setarray .@items[0], 1002,1, 2212,1, 717,2, 1713,1, 7; changequest 2002,2006; break;
			//Iron, Green_Herb, Animal's_Skin, Ring_Pommel_Saber
			default: setarray .@items[0], 998,1, 511,1, 919,2, 1122,1, 8; changequest 2002,2007; break;
			}
			set BSMITH_Q,.@items[8];
			mes "[基修彭斯特]";
			mes "^8E6B23"+.@items[1]+" "+getitemname(.@items[0])+"^000000,";
			mes "^8E6B23"+.@items[3]+" "+getitemname(.@items[2])+"^000000,";
			mes "^8E6B23"+.@items[5]+" "+getitemname(.@items[4])+"^000000, and";
			mes "^8E6B23"+.@items[7]+" "+getitemname(.@items[6])+"^000000，这种材料";
			mes "可以从 NPC 商店购买。";
			next;
			mes "[基修彭斯特]";
			mes "收集这些物品就是你的测试。巧的是，这也能帮我省点钱。我再重复一次你需要带回的材料……";
			next;
			mes "[基修彭斯特]";
			mes "好～";
			mes "祝你好运，";
			mes "完成第一项工作！";
			close;
		}
		else if (BSMITH_Q > 3 && BSMITH_Q < 9) {
			switch(BSMITH_Q) {
			case 4: setarray .@items[0], 999,1, 930,1, 717,2, 1610,1, 9; break;
			case 5: setarray .@items[0], 1001,2, 932,1, 912,1, 1219,1, 10; break;
			case 6: setarray .@items[0], 1003,1, 935,2, 990,2, 1119,1, 11; break;
			case 7: setarray .@items[0], 1002,1, 2212,1, 717,2, 1713,1, 12; break;
			case 8: setarray .@items[0], 998,1, 511,1, 919,2, 1122,1, 13; break;
			}
			mes "[基修彭斯特]";
			mes "啊，你回来了！";
			mes "把我要求的";
			mes "东西都带来了吗？";
			next;
			if (countitem(.@items[0]) >= .@items[1] && countitem(.@items[2]) >= .@items[3] && countitem(.@items[4]) >= .@items[5] && countitem(.@items[6]) >= .@items[7]) {
				mes "[基修彭斯特]";
				mes "等等……";
				mes "我不是说过要";
				mes "3 个钢铁吗？";
				next;
				mes "[基修彭斯特]";
				mes "哦，看来其实是";
				mes "两个。让我看看……";
				mes "没错，你都带来了！";
				mes "现在等我一下。";
				next;
				mes "[基修彭斯特]";
				mes "注意不要携带^FF0000超过一个 "+getitemname(.@items[6])+"^000000，物品栏里只能有从 NPC 商店购买的 "+getitemname(.@items[6])+"。";
				next;
				if (select("哦，能再等我一下吗？:哦，我带来了你要求的东西。") == 1) {
					mes "[基修彭斯特]";
					mes "嗯，把其余物品";
					mes "存进卡普拉仓库";
					mes "会比较好。";
					close;
				}
				mes "[基修彭斯特]";
				mes "好。";
				mes "太好了～！！";
				next;
			mes "[基修彭斯特]";
				mes "^3355FF*Clang...!*^000000";
				next;
			mes "[基修彭斯特]";
				mes "^3355FF*Crash Crash!*^000000";
				next;
				delitem .@items[0],.@items[1];
				delitem .@items[2],.@items[3];
				delitem .@items[4],.@items[5];
				delitem .@items[6],.@items[7];
				set BSMITH_Q,.@items[8];
				mes "[基修彭斯特]";
				mes "呜～～～";
				mes "完成了……";
				switch(BSMITH_Q) {
				case 9:
					mes "好了，把这个交给卢恩·米德加尔特王国吉芬的^8E6B23拜苏利斯特^000000，再把收据带回来。";
					getitem 1610,1; //Arc_Wand
					if (checkquest(2003) != -1) {
						changequest 2003,2008;
					}
					next;
					mes "[基修彭斯特]";
					mes "嗯……？";
					mes "你那是什么表情？";
					mes "这不是普通的奥术之杖！";
					mes "仔细看看手柄……";
					next;
					mes "^3355FF手柄上写着：";
					mes "‘基修彭斯特的超级奥术之杖";
					mes "Mark 2。’摸起来确实";
					mes "完全不同。^000000";
					next;
					mes "[基修彭斯特]";
					mes "总之，把这个交给卢恩·米德加尔特王国吉芬的^8E6B23拜苏利斯特^000000，";
					break;
				case 10:
					mes "好了，把这个交给梦罗克的^8E6B23维克贝因^000000，再把收据带回来。";
					getitem 1219,1; //Gladius
					if (checkquest(2004) != -1) {
						changequest 2004,2009;
					}
					next;
			mes "[基修彭斯特]";
			mes "嗯……？";
			mes "你那是什么表情？";
					mes "这不是普通的格拉迪乌斯！";
					mes "仔细看看手柄……";
					next;
					mes "^3355FF手柄上写着：‘基修彭斯特的超级格拉迪乌斯 Mark 2。’";
					mes "摸起来确实完全不同。^000000";
					next;
					mes "[基修彭斯特]";
					mes "总之，把这个交给卢恩·米德加尔特王国梦罗克的^8E6B23维克贝因^000000，";
					break;
				case 11:
					mes "好了，把这个交给里希塔乐镇的^8E6B23克隆加斯特^000000，再把收据带回来。";
					getitem 1119,1; //Tsurugi
					if (checkquest(2005) != -1) {
						changequest 2005,2010;
					}
					next;
					mes "[基修彭斯特]";
					mes "嗯……？你那是什么表情？";
					mes "这不是普通的村正！仔细看看刀刃……";
					next;
					mes "^3355FF刀刃上写着：‘锋利的基修彭斯特村正特别版。’";
					mes "摸起来和普通村正完全不同……^000000";
					next;
					mes "[基修彭斯特]";
					mes "总之，把这个交给里希塔乐镇的^8E6B23克隆加斯特^000000，";
					break;
				case 12:
					mes "好了，把这个交给斐扬的^8E6B23塔尔皮兹^000000，再把收据带回来。";
					getitem 1713,1; //Arbalest
					if (checkquest(2006) != -1) {
						changequest 2006,2011;
					}
					next;
			mes "[基修彭斯特]";
			mes "嗯……？";
			mes "你那是什么表情？";
			mes "这不是普通的";
			mes "弩！仔细看看";
			mes "弩身……";
					next;
			mes "^3355FF弩身上写着：";
			mes "基修彭斯特";
			mes "豪华弩特别版。";
			mes "看起来确实比普通弩";
			mes "豪华多了。^000000";
					next;
			mes "[基修彭斯特]";
			mes "总之，把这个交给";
			mes "卢恩·米德加尔特王国斐扬的^8E6B23塔尔皮兹^000000，";
					break;
				case 13:
					mes "好了，把这个交给休尔格尔的^8E6B23比斯马克^000000，再把收据带回来。";
					getitem 1122,1; //Ring_Pommel_Saber
					if (checkquest(2007) != -1) {
						changequest 2007,2012;
					}
					next;
					mes "[基修彭斯特]";
					mes "嗯……你那是什么表情？";
					mes "这不是普通的环柄军刀！";
					mes "仔细看看手柄……";
					next;
					mes "^3355FF手柄上写着：‘基修彭斯特的青草环柄军刀 Mark 2。’";
					mes "摸起来确实完全不同。^000000";
					next;
					mes "[基修彭斯特]";
					mes "这把剑注入了青草的力量，非常有用！用它迅速刺伤中毒者，就能救他免于慢慢死去！";
					next;
					mes "[基修彭斯特]";
					mes "总之，把这个交给休尔格尔的^8E6B23比斯马克^000000，";
				}
				mes "别忘了";
				mes "收据！";
				close;
			}
			else {
				mes "[基修彭斯特]";
				mes "你还没有";
				mes "带齐所有物品。";
				mes "需要我提醒你吗？";
				mes "把这些带给我……";
				next;
			mes "[基修彭斯特]";
				mes "^8E6B23"+.@items[1]+" "+getitemname(.@items[0])+"^000000,";
				mes "^8E6B23"+.@items[3]+" "+getitemname(.@items[2])+"^000000,";
				mes "^8E6B23"+.@items[5]+" "+getitemname(.@items[4])+"^000000, and";
			mes "^8E6B23"+.@items[7]+" "+getitemname(.@items[6])+"^000000，这类物品";
			mes "可以从";
			mes "NPC 商店购买。";
				next;
				mes "[基修彭斯特]";
				mes "回来时一定要带齐";
				mes "我需要的一切。记住，";
				mes "这是测试！偷懒的话";
				mes "你就成不了铁匠！";
				close;
			}
		}
		else if (BSMITH_Q > 8 && BSMITH_Q < 14) {
			mes "[基修彭斯特]";
			mes "你还在这里做什么？";
			mes "快把包裹送去～！";
			mes "你忘了目的地吗？";
			next;
			mes "[基修彭斯特]";
			if (BSMITH_Q == 9) {
				mes "在吉芬城中心 11 点钟方向，";
				mes "找到^8E6B23拜苏利斯特^000000。别忘了收据。";
			}
			else if (BSMITH_Q == 10) {
				mes "去梦罗克找钝器商人";
				mes "^8E6B23维克贝因^000000。别忘了收据。";
			}
			else if (BSMITH_Q == 11) {
				mes "在里希塔乐镇中心 6 点钟方向、武器店附近找到^8E6B23克隆加斯特^000000。别忘了收据。";
			}
			else if (BSMITH_Q == 12) {
				mes "在斐扬城中心 5 点钟方向找到^8E6B23塔尔皮兹^000000。别忘了收据。";
			}
			else {
				mes "在休尔格尔城中心 1 点钟方向的飞艇附近找到^8E6B23比斯马克^000000。别忘了收据。";
			}
			close;
		}
		else if (BSMITH_Q == 14) {
			mes "[基修彭斯特]";
			mes "嗯……？";
			mes "你完成";
			mes "交付了吗？";
			mes "让我看看收据～";
			next;
			if (select("是的，给你。:收据？呃，我好像放在哪儿了。") == 1) {
				if (countitem(1073) > 0) {
					set BSMITH_Q,15;
					delitem 1073,1; //Merchant_Voucher_1
					if (checkquest(2008) != -1) {
						changequest 2008,2013;
					}
					else if (checkquest(2009) != -1) {
						changequest 2009,2013;
					}
					else if (checkquest(2010) != -1) {
						changequest 2010,2013;
					}
					else if (checkquest(2011) != -1) {
						changequest 2011,2013;
					}
					else {
						changequest 2012,2013;
					}
					mes "[基修彭斯特]";
					mes "哦呵呵～";
					mes "太好了！";
					mes "你真是";
					mes "优秀的商人！";
					next;
					mes "[基修彭斯特]";
					mes "干得好！";
					mes "回到艾音布罗克找^8E6B23艾尔蒂雷根^000000，就是你申请铁匠职业时遇到的人。";
					next;
					mes "[基修彭斯特]";
					mes "我相信你会";
					mes "成为优秀的铁匠！";
					close;
				}
				set BSMITH_Q,3;
				mes "[基修彭斯特]";
				mes "你的意思是……你没拿到收据？";
				mes "什么……？";
				next;
				mes "[基修彭斯特]";
				mes "收据是商人最好的朋友！";
				mes "这是工作所必需的！";
				mes "你必须从头开始测试！";
				close;
			}
		mes "[基修彭斯特]";
		mes "找到收据后再回来～";
		mes "你没忘记领取收据吧。";
		mes "对吧……？";
			close;
		}
		else if (BSMITH_Q == 15) {
		mes "[基修彭斯特]";
		mes "非常感谢";
		mes "你的帮助。";
		mes "回到艾音布罗克";
		mes "去见^8E6B23艾尔蒂雷根^000000！";
			close;
		}
		mes "[基修彭斯特]";
		mes "嗯……？";
		mes "你已经完成了";
		mes "在我这里的测试！";
		mes "令人意外的是，今天我不再需要帮助。";
		close;
	}

	else {
		mes "[基修彭斯特]";
		mes "成为";
		mes "铁匠";
		mes "真是太棒了！";
		mes "你不这么觉得吗？";
		mes "哇哈哈哈哈！！";
		close;
	}
}

geffen,46,164,1	script	Baisulist#BLS	69,{
	if (BSMITH_Q == 9 && countitem(1610) > 0) {
		mes "[拜苏利斯特]";
		mes "哦，你好！";
		mes "你是来送我的";
		mes "奥术之杖的吗？";
		next;
		mes "[拜苏利斯特]";
		mes "这确实是我订购的东西吧？如果用过了，";
		mes "我可不要。";
		next;
		if (select("糟糕，这是我用过的物品……:当然！这是全新的！") == 1) {
			mes "[拜苏利斯特]";
			mes "好吧……";
			mes "我可以再等一会儿。";
			mes "请尽快把我的货送来～";
			close;
		}
		mes "[拜苏利斯特]";
		mes "你";
		mes "确定吗？";
		set BSMITH_Q,14;
		delitem 1610,1; //Arc_Wand
		next;
		mes "[拜苏利斯特]";
		mes "非常感谢你远道而来。见到基修彭斯特时，帮我揍他一顿，他这订单拖得太久了……";
		next;
		mes "[拜苏利斯特]";
		mes "请等一下，";
		mes "我给你一张收据～";
		next;
		getitem 1073,1; //Merchant_Voucher_1
		mes "[拜苏利斯特]";
		mes "给你。";
		mes "太感谢你了！";
		mes "哦，祝你好运～";
		mapannounce "geffen","Hey, " +strcharinfo(0)+ ", thank you so much for the delivery~",bc_map;
		close;
	}
	else if (BSMITH_Q == 14) {
		mes "[拜苏利斯特]";
		mes "非常感谢你";
		mes "送来的货物～";
		close;
	}
	// 切片末端暂存：源文件在此处结束

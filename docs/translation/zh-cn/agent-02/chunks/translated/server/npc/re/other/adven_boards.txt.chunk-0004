}

pay_arche,39,134,0	script	Signposts#Payon Cave	2_BULLETIN_BOARD,{
	while(1) {
		mes "[Payon Cave]";
		mes "为了让冒险者能够在世界各地轻松冒险，我们会公开各位冒险者收集的信息。请向冒险者小组提供情报建议，以便修订资料。";
		mes "-- 冒险者小组 --";
		next;
		.@mo_board = callfunc( "F_AvenBoard",
			1015,"僵尸","Dead soul trapped by unholy necromancer in a rotting corpse, cursed to live without being able to feel pain. Its impurity is capable of inflicting poison.",
			1005,"小恶魔蝙蝠","栖息在黑暗洞穴中的群居蝙蝠。小小的尖牙足以吸食附近生物的血液。",
			1076,"骷髅","充满悔恨的骷髅。这种不死魔物具有攻击性。",
			1031,"波波利","在沼泽地区发现的波利兄长。身体由有毒物质构成，比波利更加坚韧。",
			1028,"骷髅士兵","骷髅士兵只能在阳光无法到达的地下城深处看到。与骷髅弓箭手不同，它使用双剑攻击。",
			1111,"吸血蝙蝠","Colonial bat that inhabits dark caves. It uses its big, sharp teeth to attack nearby creatures and sucks in blood. It's bigger than a 小恶魔蝙蝠.",
			1016,"骷髅弓箭手","骷髅弓箭手只能在阳光无法到达的地下城深处看到。这个魔物的箭袋似乎永远不会耗尽。",
			1116,"蛋黄波利","蛋形魔物。蛋壳比大嘴鸟蛋的蛋壳更坚硬，会在地下城中漫无目的地游荡。",
			1020,"曼陀罗魔花","需要冒险者提供情报。",
			1068,"九尾狐","海葵魔物。虽然外表如此，但它深深扎根于地面，并用固定的触手攻击附近生物。",
			1277,"最强将军","曾经是城镇的守护者，后来被人们遗忘。这个魔物具有攻击性，会攻击路过的冒险者，但无法移动。",
			1188,"僵尸男","为了保护梦罗克，自愿成为魔物的男性僵尸。",
			1026,"僵尸女","死去女孩的灵魂寄宿在尸体中，使其变成僵尸魔物。它会吸食附近生物的血液。",
			1180,"九尾狐","九尾狐。它比普通狐狸聪明得多，不知道是否能够变身为人类。",
			1129,"火焰精灵","外形像鬼火的火焰魔物。这个魔物的起源不明。",
			1110,"狸猫","只能在斐扬附近看到的恶魔魔物。有时会向路过的冒险者出谜语。",
			1301,"阿木图","斐扬传说中的魔物。看起来像个小孩子，但据说会骚扰路过的冒险者。",
			1290,"骷髅 General","曾经保护斐扬城堡的将军。死后变成在斐扬洞窟中游荡的魔物。",
			1186,"巨大白幽灵","需要冒险者提供情报。",
			1170,"水灵龟","悲惨死去的处女。只能在斐扬附近找到，性情被动。",
			1307,"九尾狐","九尾恶魔。它利用铃铛引诱并攻击人类。",
			1150,"月夜猫","中阶恶魔，狐狸女王。低估它可爱的外表会导致死亡。" );		
		if (.@mo_board == 1) {
			mes "[Payon Cave]";
			mes "斐扬洞窟共有5层。大多数魔物是不死或恶魔种族，圣属性武器在这个地下城中很有用。";

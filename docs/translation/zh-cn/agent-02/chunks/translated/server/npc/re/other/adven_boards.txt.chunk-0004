moc_ruins,61,164,0	script	Signposts#Pyramid	2_BULLETIN_BOARD,{
	while(1) {
		mes "[Pyramid]";
		mes "为了让冒险者能够在世界各地轻松冒险，我们会公开各位冒险者收集的信息。请向冒险者小组提供情报建议，以便修订资料。";
		mes "-- 冒险者小组 --";
		next;
		.@mo_board = callfunc( "F_AvenBoard",
			1005,"小恶魔蝙蝠","栖息在黑暗洞穴中的群居蝙蝠。小小的尖牙足以吸食附近生物的血液。",
			1031,"波波利","在沼泽地区发现的波利兄长。身体由有毒物质构成，比波利更加坚韧。",
			1028,"骷髅士兵","骷髅士兵只能在阳光无法到达的地下城深处看到。与骷髅弓箭手不同，它使用双剑攻击。",
			1111,"吸血蝙蝠","Colonial bat that inhabits dark caves. It uses its big, sharp teeth to attack nearby creatures and sucks in blood. It's bigger than a 小恶魔蝙蝠.^000000",
			1016,"骷髅弓箭手","骷髅弓箭手只能在阳光无法到达的地下城深处看到。这个魔物的箭袋似乎永远不会耗尽。",
			1041,"木乃伊","木乃伊 monster found within the forgotten pyramid. It sometimes appears with 贝斯蒂亚 monster, surprising nearby adventurer. It's an aggressive monster.",
			1029,"伊西斯","与国王遗体一起被活埋的变异女性仆从。她变成了蛇形魔物，仍然忠于国王。",
			1032,"贝斯蒂亚","曾经是人类伙伴的木乃伊宠物。看到任何物品都会吞食。",
			1191,"宝箱怪","需要冒险者提供情报。",
			1146,"玛塔","国王的守护者和看门人。有人用禁忌魔法以狗为媒介召唤看门人。它的身体被黑雾笼罩，行动非常敏捷。",
			1297,"远古木乃伊","远古木乃伊曾是高级官员。与普通木乃伊不同，它裹着高品质的深红绷带。",
			1149,"米诺斯","生活在迷宫深处的未知生物。它与兽人关系不佳，但双方很少相遇。遇到生物时，它会追击目标并用巨锤攻击。",
			1194,"石砾怪","拥有坚硬外壳的魔物。它会蜷缩身体，用外壳攻击。",
			1038,"俄塞里斯","金字塔之王。曾被民众作为太阳神崇拜，如今只是强大的MVP魔物。",
			1511,"阿蒙·拉","坐在椅子上发动攻击的MVP魔物。这个MVP似乎可能是另一位金字塔之王。它的椅子后面发生了什么？" );
		if (.@mo_board == 1) {
			mes "[Pyramid]";
			mes "金字塔由地上B1至B4层和地下B2至B3层组成。这个地下城适合从初心者到专家级的冒险者，盗贼公会位于地下B1层。";
			next;
			while(1) {
				switch( select( "金字塔地上层 B1","金字塔地上层 B2","金字塔地上层 B3","金字塔地上层 B4","金字塔地下层 B2","金字塔地下层 B3","取消" ) ) {
				case 1:
					mes "[金字塔地上层 B1]";
					mes "------------ 魔物 ------------";
					mes "小恶魔蝙蝠(24)";
					mes "波波利(30)";
					mes "--------------------------------";
					F_InfoBoard;
					continue;
				case 2:
					mes "[金字塔地上层 B2]";
					mes "------------ 魔物 ------------";
					mes "波波利(30)";
					mes "骷髅士兵(34)";
					mes "吸血蝙蝠(47)";
					mes "骷髅弓箭手(50)";
					mes "木乃伊(55)";
					mes "伊西斯(59)";
					mes "--------------------------------";
					F_InfoBoard;
					continue;
				case 3:
					mes "[金字塔地上层 B3]";
					mes "------------ 魔物 ------------";
					mes "吸血蝙蝠(47)";
					mes "贝斯蒂亚(52)";
					mes "木乃伊(55)";
					mes "宝箱怪(56)";
					mes "玛塔(58)";
					mes "--------------------------------";
					F_InfoBoard;
					continue;
				case 4:
					mes "[金字塔地上层 B4]";
					mes "------------ 魔物 ------------";
					mes "木乃伊(55)";
					mes "宝箱怪(56)";
					mes "玛塔(58)";
					mes "伊西斯(59)";
					mes "远古木乃伊(114)";
					mes "--------------------------------";
					next;
					mes "<金字塔之王！我该给他换绷带了。经过岁月，他的绷带已经变成紫色了。他很危险？没关系～没关系～——携带绷带的探险者葡萄>";
					F_InfoBoard;
					continue;
				case 5:
					mes "[金字塔地下层 B2]";
					mes "------------ 魔物 ------------";
					mes "贝斯蒂亚(52)";
					mes "木乃伊(55)";
					mes "米诺斯(58)";
					mes "--------------------------------";
					F_InfoBoard;
					continue;
				case 6:
					mes "[金字塔地下层 B3]";
					mes "------------ 魔物 ------------";
					mes "贝斯蒂亚(52)";
					mes "宝箱怪(56)";
					mes "石砾怪(107)";
					mes "远古木乃伊(114)";
					mes "--------------------------------";
					next;
					mes "<有一只坐在椅子上攻击的MVP魔物。他一定非常懒，甚至都没有离开原地。有时就是会这样。——懒惰的探险者葡萄>";
					F_InfoBoard;
					continue;
				}
				break;
			}
		}
	}
}


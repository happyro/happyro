				close;
			}
			mes "[Vassili Grandpapa]";
			mes "嗯？你想问我什么？";
			next;
			input .@input$;
			if (.@input$ == "Red Ring") {
				mes "[Vassili Grandpapa]";
				mes "红色戒指？！你为什么找它？";
				next;
			} else {
				mes "[Vassili Grandpapa]";
				mes "嗯，什么？我听不懂你说的话。";
				close;
			}
			mes "- 你向他讲述灰狼和玛丽亚的事 -";
			next;
			mes "[Vassili Grandpapa]";
			mes "哦，我明白了。";
			next;
			mes "[Vassili Grandpapa]";
			mes "我该怎么办？";
			mes "我想帮忙却无能为力。";
			mes "我把它作为礼物送给了";
			mes "最小的女儿玛申卡，";
			mes "可是她……";
			next;
			mes "["+ strcharinfo(0) +"]";
			mes "你还好吗？";
			next;
			mes "[Vassili Grandpapa]";
			mes "只是玛申卡她……";
			mes "..........";
			mes "……她去世了……";
			next;
			mes "[Vassili Grandpapa]";
			mes "她既漂亮又聪明。我的大女儿柳巴巴也漂亮聪明，但她的脾气……";
			mes "比伊夫利特的火焰还要炽烈！";
			mes "你明白我的意思吗？";
			next;
			mes "[Vassili Grandpapa]";
			mes "总之，玛申卡是个善良温柔的女儿。寒冷的冬夜我晚归时，她总会端着一碗我最喜欢的热炖菜等我。";
			next;
			mes "[Vassili Grandpapa]";
			mes "这样的体贴怎能不让我感动？所以我把红色戒指作为礼物送给了她。";
			mes "我至今记得送给她时她有多么开心。";
			next;
			mes "[Vassili Grandpapa]";
			mes "不久后她就失踪了……现在我只剩下柳巴巴。她也漂亮聪明，但失去玛申卡的悲伤无法消解……";
			rhea_rus_ring = 1;
			// setquest 8143;
			close;
		} else if (rhea_rus_ring < 8) {
			mes "[Vassili Grandpapa]";
			mes "我至今记得送给她时她有多么开心。";
			next;
			mes "[Vassili Grandpapa]";
			mes "不久后她就失踪了……现在我只剩下柳巴巴。她也漂亮聪明，但失去玛申卡的悲伤无法消解……";
			close;
		} else if (rhea_rus_ring == 8) {
			if (getequipid(EQI_SHOES) != 2429 && getequipid(EQI_SHOES) != 2430) {
				mes "["+ strcharinfo(0) +"]";
				mes "……嗯，我是不是忘了穿什么？";
				close;
			}
			mes "[Vassili Grandpapa]";
			mes "咦？你就是我之前见过的冒险者。有什么要告诉我吗？";
			next;
			mes "["+ strcharinfo(0) +"]";
			mes "……听听这个……";
			next;
			if (countitem(7883)) {// Pointed_Wooden_Flute
				mes "- 你吹奏长笛 -";
				next;
				mes "^ff0000父亲送我的红色戒指^000000";
				mes "^ff0000父亲送我的红色戒指^000000";
				mes "^ff0000被施法的红色戒指^000000";
				mes "^ff0000献给最可爱的女儿^000000";
				next;
				mes "^ff0000引发嫉妒的红色戒指^000000";
				mes "^ff0000引发嫉妒的红色戒指^000000";
				mes "^ff0000被施法的红色戒指^000000";
				mes "^ff0000我的姐姐心生嫉妒^000000";
				next;
				mes "^ff0000冰冷的手扼紧我的脖颈^000000";
				mes "^ff0000冰冷的目光揪紧我的心^000000";
				mes "^ff0000冰冷的沼泽吞噬我的身体^000000";
				mes "^ff0000红色戒指被夺走^000000";
				mes "^ff0000被施法的红色戒指^000000";
				emotion ET_HUK;
				emotion ET_THINK, playerattached();
				next;
				mes "[Vassili Grandpapa]";
				mes "……这、这是什么？咦？";
				mes "我的女儿玛申卡，是被柳巴巴……！？";
				next;
				mes "[Vassili Grandpapa]";
				mes "不……这不是真的吧？";
				mes "别想骗我……你说什么……那支长笛是……玛申卡……";
				next;
				mes "["+ strcharinfo(0) +"]";
				mes "这不是……这不是玛申卡的声音吗？";
				next;
				mes "[Vassili Grandpapa]";
				mes "别对我说那些谎话……！！我的女儿们……那……";
				next;
				mes "[Vassili Grandpapa]";
				mes ".............................";
				next;
				mes "[Vassili Grandpapa]";
				mes ".............................";
				next;
				mes "[Vassili Grandpapa]";
				mes ".............................";
				next;
				mes "[Vassili Grandpapa]";
				mes ".............................";
				next;
				mes "[Vassili Grandpapa]";
				mes ".............................";
				next;
				mes "[Vassili Grandpapa]";
				mes ".............................";
				next;
				mes "[Vassili Grandpapa]";
				mes ".............................";
				next;
				mes "["+ strcharinfo(0) +"]";
				mes "……呃……我很抱歉……";
				next;
				mes "[Vassili Grandpapa]";
				mes "……你能……再吹一次长笛吗？";
				next;
				mes "- 你吹奏长笛 -";
				mes "- 发出玛申卡的声音 -";
				next;
				mes "^ff0000父亲送我的红色戒指^000000";
				mes "^ff0000父亲送我的红色戒指^000000";
				mes "^ff0000被施法的红色戒指^000000";
				mes "^ff0000献给最可爱的女儿^000000";
				next;
				mes "^ff0000引发嫉妒的红色戒指^000000";
				mes "^ff0000引发嫉妒的红色戒指^000000";
				mes "^ff0000被施法的红色戒指^000000";
				mes "^ff0000我的姐姐心生嫉妒^000000";
				next;
				mes "^ff0000冰冷的手扼紧我的脖颈^000000";
				mes "^ff0000冰冷的目光揪紧我的心^000000";
				mes "^ff0000冰冷的沼泽吞噬我的身体^000000";
				mes "^ff0000红色戒指被夺走^000000";
				mes "^ff0000被施法的红色戒指^000000";
				emotion ET_THINK;
				emotion ET_THINK, playerattached();
				next;
				mes "[Vassili Grandpapa]";
				mes "这……这是真的……";
				mes "我在柳巴巴房间看到这枚戒指时从未想到这一点，但这一定是真的……";
				next;
				mes "[Vassili Grandpapa]";
				mes "该死的诅咒戒指！！！我的女儿们为什么会遭遇这种悲剧……？呜呜！";
				next;
				mes "["+ strcharinfo(0) +"]";
				mes "......................";
				next;
				mes "[Vassili Grandpapa]";
				mes "……对不起。我知道告诉我这些并不容易。谢谢你说出真相。";
				next;
				mes "[Vassili Grandpapa]";
				mes "你说需要这枚戒指，对吧？拿去吧……";
				mes "它带给我的只有悲伤。";
				// if (isbegin_quest(8147) == 1)
					// completequest 8147;
				next;
				mes "[Vassili Grandpapa]";
				mes "……女儿们之间发生这场悲剧是我的错。我会用余生弥补这一切……";
				delitem 7883,1; // Pointed_Wooden_Flute
				getitem 7877,1; // Red_Ring
				rhea_rus_ring = 10;
				// completequest 8144;
				if (checkre(3)) {
					if (BaseLevel < 56) getexp 470,0;
					//
					else if (BaseLevel < 61) getexp 615,0;
					else if (BaseLevel < 66) getexp 750,0;
					else if (BaseLevel < 71) getexp 1000,0;
					else if (BaseLevel < 76) getexp 1500,0;
					else if (BaseLevel < 81) getexp 2000,0;
					else if (BaseLevel < 86) getexp 4500,0;
					else if (BaseLevel < 91) getexp 8500,0;
					else if (BaseLevel < MAX_LEVEL) getexp 30000,0;
					else {
						getitem 607,1; //Yggdrasilberry
						getexp 30000,0;
					}
				} else {
					if (BaseLevel < 56) getexp 4700,0;
					else if ( BaseLevel < 61) getexp 6150,0;
					else if (BaseLevel < 66) getexp 10605,0;
					else if (BaseLevel < 71) getexp 16223,0;
					else if (BaseLevel < 76) getexp 41227,0;
					else if (BaseLevel < 81) getexp 69073,0;
					else if (BaseLevel < 86) getexp 85102,0;
					else if (BaseLevel < 91) getexp 104615,0;
					else if (BaseLevel < 99) getexp 222035,0;
					else getitem 607,1; //Yggdrasilberry
				}
				close;
			}
			mes "[Vassili Grandpapa]";
			mes "...............................";
			mes "...............................";
			mes "……你说什么？";
			next;
			mes "["+ strcharinfo(0) +"]";
			mes "咦？！真奇怪。长笛在哪里？！";
			emotion ET_HUK, playerattached();
			close;
		} else if (rhea_rus_ring == 9) {
			mes "[Vassili Grandpapa]";
			mes "你可能觉得这很愚蠢，但我无法排解失去女儿的悲伤。";
			next;
			mes "[Vassili Grandpapa]";
			mes "是父母们在村口徘徊，等待自己的孩子……";
			close;
		}
	}
	mes "[Vassili Grandpapa]";
	mes "……女儿们之间发生这场悲剧是我的错。我会用余生弥补这一切……";
	close;
}

//----------------------------------------------------------------------------
// Ryubaba (Red Ring)
//----------------------------------------------------------------------------
moscovia,213,216,3	script	Ryubaba#rus08	4_F_RUSWOMAN2,{
	if ((MaxWeight-Weight) < 3500) {
		mes "[Ryubaba]";
		mes "你的包里到底装了什么？";
		mes "你是在为某件事训练吗？";
		close;
	}
	if (rhea_rus_main < 8) {
		mes "[Ryubaba]";
		mes "啊，我真美。";
		next;
		mes "[Ryubaba]";
		mes "嗯，你一定是冒险者吧？你觉得呢？见过比我更美的人吗？我不信。你怎么可能找到比我更美的人？";
		emotion ET_SMILE;
		close;
	}
	else if (rhea_rus_main == 8) {
		if (!rhea_rus_ring) {
			mes "[Ryubaba]";
			mes "啊，我真美。";
			next;
			mes "[Ryubaba]";
			mes "嗯，你一定是冒险者吧？你觉得呢？见过比我更美的人吗？我不信。你怎么可能找到比我更美的人？";
			emotion ET_SMILE;
			close;
		} else if (rhea_rus_ring == 1) {
			if (getequipid(EQI_SHOES) != 2429 && getequipid(EQI_SHOES) != 2430) {
				mes "["+ strcharinfo(0) +"]";
				mes "……嗯，我是不是忘了穿什么？";
				close;
			}
			mes "[Ryubaba]";
			mes "啊，我真美。";
			next;
			mes "[Ryubaba]";
			mes "嗯，你一定是冒险者吧？你觉得呢？见过比我更美的人吗？我不信。你怎么可能找到比我更美的人？";
			next;
			if(select("你疯了吗！:你说得对。") == 1) {
				mes "["+ strcharinfo(0) +"]";
				mes "你疯了吗！？你不知道世界有多大、美女有多少吗？你这乡下姑娘真自以为是！";
				next;
				mes "["+ strcharinfo(0) +"]";
				if (Sex == SEX_FEMALE)
					mes "再说了，如果世上有最美的女孩，那就是我、我、我！";
				else {
					mes "你见过跳舞的舞者吗？见过美丽纯洁的祭司吗？！";
					mes "还有谁能比得上亲切的卡普拉员工！！！";
				}
				next;
				mes "[Ryubaba]";
				mes "什么！？你这个混蛋！！";
				mes "我讨厌你！滚开！";
				rhea_rus_ring = 2;
				close2;
				warp "moscovia",220,210;
				end;
			}
			mes "["+ strcharinfo(0) +"]";
			mes "是的，你真的很美。";
			emotion ET_SMILE, playerattached();
			next;
			mes "[Ryubaba]";
			mes "呵呵，你真会开玩笑。你很懂嘛。啊，这是我做的巧克力饮料。尝尝看，好喝吗？";
			rhea_rus_ring = 4;
			getitem 573,1;// Chocolate_Drink
			close;
		} else if (rhea_rus_ring == 2) {
			mes "[Ryubaba]";
			mes "我从没见过比你更粗鲁的人！";
			mes "我讨厌你！滚开！";
			close2;
			warp "moscovia",220,210;
			end;
		} else if (rhea_rus_ring == 3) {
			if (countitem(748) > 0 || countitem(749) > 0) {// Witherless_Rose, Frozen_Rose
				mes "[Ryubaba]";
				mes "什么？你为什么在这里？你给我……";
				next;
				mes "[Ryubaba]";
				mes "……那是给我的吗？";
				next;
				mes "[Ryubaba]";
				if (countitem(748))
					delitem 748,1;
				else if (countitem(749))
					delitem 749,1;
				else {
					mes "好吧，我原谅你……咦？";
					next;
					mes "[Ryubaba]";
					mes "什么？你想骗我吗！？";
					mes "我从没见过比你更粗鲁的人！";
					mes "我讨厌你！滚开！";
					close2;
					warp "moscovia",220,210;
					end;
				}
				mes "好吧，我原谅你。";
				rhea_rus_ring = 4;
				close;
			}
			mes "[Ryubaba]";
			mes "我从没见过比你更粗鲁的人！";
			mes "我讨厌你！滚开！";
			close2;
			warp "moscovia",220,210;
			end;
		} else if (rhea_rus_ring == 4) {
			mes "[Ryubaba]";
			mes "呵呵，你见过像我这么美的人吗？";
			next;
			select("你是……");
			mes "["+ strcharinfo(0) +"]";
			mes "……你是最美的……";
			next;
			mes "[Ryubaba]";
			mes "真的吗？大家都这么认为。";
			mes "啊，我忘了问你。";
			mes "你为什么来这里？";
			next;
			input .@input$;
			mes "[Ryubaba]";
			if (.@input$ == "Red Ring") {
				mes "红色戒指？！";
				next;
			} else { 
				mes "哼，你在说什么？那是什么？";
				close;
			}
			mes "[Ryubaba]";
			mes "啊，那枚戒指……是的，父亲把它给了我的小妹妹玛申卡。";
			mes "但她出去散步后，在沼泽附近失踪了。";
			next;
			mes "["+ strcharinfo(0) +"]";
			mes "等等，你父亲告诉我她已经死了！";
			next;
			mes "[Ryubaba]";
			mes "对……让我说完。我们试着找过她，却没能找到。她在沼泽附近失踪时一定戴着那枚戒指。";
			rhea_rus_ring = 5;
			// changequest 8143,8144;
			close;
		} else if (rhea_rus_ring > 4 && rhea_rus_ring < 7) {
			mes "[Ryubaba]";
			mes "啊，那枚戒指……是的，父亲把它给了我的小妹妹玛申卡。";
			mes "但她出去散步后，在沼泽附近失踪了。";
			next;
			mes "["+ strcharinfo(0) +"]";
			mes "等等，你父亲告诉我她已经死了！";
			next;
			mes "[Ryubaba]";
			mes "对……让我说完。我们试着找过她，却没能找到。她在沼泽附近失踪时一定戴着那枚戒指。";
			close;
		} else if (rhea_rus_ring == 7) {
			if (getequipid(EQI_SHOES) != 2429 && getequipid(EQI_SHOES) != 2430) {
				mes "["+ strcharinfo(0) +"]";
				mes "……嗯，我是不是忘了穿什么？";
				close;
			}
			mes "[Ryubaba]";
			mes "啊，你又来了。我能为你做什么？";
			next;
			mes "["+ strcharinfo(0) +"]";
			mes "……听听这首歌。";
			next;
			if (countitem(7883) > 0) {// Pointed_Wooden_Flute
				mes "- 你吹奏长笛 -";
				next;
				mes "^ff0000父亲送我的红色戒指^000000";
				mes "^ff0000父亲送我的红色戒指^000000";
				mes "^ff0000被施法的红色戒指^000000";
				mes "^ff0000献给最可爱的女儿^000000";
				next;
				mes "^ff0000引发嫉妒的红色戒指^000000";
				mes "^ff0000引发嫉妒的红色戒指^000000";
				mes "^ff0000被施法的红色戒指^000000";
				mes "^ff0000我的姐姐心生嫉妒^000000";
				next;
				mes "^ff0000冰冷的手扼紧我的脖颈^000000";
				mes "^ff0000冰冷的目光揪紧我的心^000000";
				mes "^ff0000冰冷的沼泽吞噬我的身体^000000";
				mes "^ff0000红色戒指被夺走^000000";
				mes "^ff0000被施法的红色戒指^000000";
				emotion ET_HUK;
				emotion ET_THINK, playerattached();
				next;
				mes "[Ryubaba]";
				mes "停、停下！你最好停下！？";
				next;
				mes "["+ strcharinfo(0) +"]";
				mes "这不是玛申卡的声音吗！？你对她做了什么！？";
				next;
				mes "[Ryubaba]";
				mes "……我恨她。父亲……父亲只爱她！他不和我说话，只和她说！";
				next;
				mes "[Ryubaba]";
				mes "我让她给我看看戒指，但她不肯。她总是让我烦躁！这个笨女孩！";
				next;
				mes "["+ strcharinfo(0) +"]";
				mes "她可是你的妹妹！你怎么能这样说！？";
				mes "你父亲必须知道这一切！";
				next;
				mes "[Ryubaba]";
				mes "不！！！";
				mes "把那支长笛给我！";
				next;
				mes "["+ strcharinfo(0) +"]";
				mes "不！你父亲必须知道！";
				next;
				mes "[Ryubaba]";
				mes "求求你，我拜托你……别告诉我父亲……";
				emotion ET_CRY;
				next;
			mes "- 她突然流下眼泪 -";
			mes "- 跪倒在地 -";
				next;
				mes "[Ryubaba]";
				mes "我一直担心有人会发现……事情发生后他一直很难过。如果知道真相，他会更加痛苦吧……？";
				next;
				mes "[Ryubaba]";
				mes "你能不能装作没看见？把长笛给我……啊……红色戒指？不如用它交换长笛？你不是需要这枚戒指吗？";
				next;
				mes "["+ strcharinfo(0) +"]";
				mes "可是……";
				next;
				mes "[Ryubaba]";
				mes "求求你……这不仅是为了我，也是为了我年迈的父亲……求你了。";
				next;
				mes "["+ strcharinfo(0) +"]";
				mes "……嗯，我该怎么办……";
				next;
				if(select("交换:不交换") == 1) {
					mes "["+ strcharinfo(0) +"]";
					mes "……嗯，我该怎么办……";
					mes "好吧，我答应。";
					next;
				} else {
					mes "["+ strcharinfo(0) +"]";
					mes "……嗯，我该怎么办……";
					mes "不，我做不到！";
					next;
					mes "[Ryubaba]";
					mes "什么！！！";
					next;
					mes "["+ strcharinfo(0) +"]";
					mes "我必须把真相告诉你父亲！他必须知道你做了什么！";
					next;
					mes "[Ryubaba]";
					mes "等、等等！！！";
					rhea_rus_ring = 8;
					// changequest 8146,8147;
					close2;
					warp "moscovia",203,80;
					end;
				}
				mes "[Ryubaba]";
				mes "你确定吗！？谢谢你！";
				// completequest 8146;
				next;
				mes "[Ryubaba]";
				mes "我必须为自己的罪过忏悔，并用余生赎罪。";
				delitem 7883,1; // Pointed_Wooden_Flute
				getitem 7877,1; // Red_Ring
				rhea_rus_ring = 9;

gef_fild05,80,149,3	script	Myu#08_hat	877,{
	mes "[Myu]";
	mes "喵……";
	emotion ET_HUK;
	next;
	if(hatcat2008 == 0) {
		mes "[Myu]";
		mes "哦？你不是冒险者吗？";
		mes "你来这里做什么？喂，你不是来伤害野玫瑰的吧？";
		mes "（喵！）";
		next;
		select("喵……？");
		mes "[Myu]";
		mes "啊，别在意。";
		mes "这里是被遗弃者的村庄。";
		mes "是那些行走于阴影中、低调生活者的故乡。";
		next;
		mes "[Myu]";
		mes "……然而，那些吠叫的狗打扰了我们的和平。";
		mes "没错，冒险者。";
		mes "你愿意惩罚那些狗头人弓箭手吗？";
		next;
		mes "[Myu]";
		mes "他们在这里南方有自己的领地，却仍然试图入侵我们的领地。";
		next;
		mes "[Myu]";
		mes "真是无礼。我试过和平交涉，甚至把他们赶走，但都没有用。";
		next;
		mes "[Myu]";
		mes "所以我想请你……用一切必要手段把他们赶出我们的领地。";
		next;
		mes "[Myu]";
		mes "如果你能做到，我会给你一件我非常珍爱的宝物。";
		next;
		switch(select("听起来很麻烦……:我该怎么做？")){
		case 1:
			mes "[Myu]";
			mes "哼，是啊，好像有点好笑。";
			mes "来这里的人……全都想伤害野玫瑰。";
			mes "我竟然没注意到。";
			next;
			mes "[Myu]";
			mes "……真是白费力气，喵……";
			next;
			mes "["+strcharinfo(0)+"]";
			mes "（又是喵……真是个怪人。）";
			close;
		case 2:
			mes "[Myu]";
			mes "当然是处理那些狗头人弓箭手，喵！";
			mes " ";
			mes "（喵！）";
			next;
			select("又喵？！");
			mes "[Myu]";
			mes "嗯嗯，我告诉过你别在意。";
			mes "正如我刚才所说……";
			mes "我是说……喵……呃……";
			next;
			mes "[Myu]";
			mes "正好 1,000 次，不多不少。";
			mes "警告他们 1,000 次，他们就会退缩。";
			next;
			select("你说的 1,000 次警告是什么意思……？");
			mes "[Myu]";
			mes "唉~非要我明说吗？";
			next;
			mes "说着，缪模仿割喉的动作在脖子上比划。";
			next;
			switch(select("这不是太多了吗？:很简单")){
			case 1:
				mes "[Myu]";
				mes "……但如果不真正教训他们，他们不会放弃。";
				mes "如果你觉得太多，那就算了。";
				close;
			case 2:
				mes "[Myu]";
				mes "但你必须记住一件事：";
				mes "显然，绝对绝对不能伤害野玫瑰。";
				next;
				mes "[Myu]";
				mes "如果你伤害它们，一切就完了。";
				mes "所以你最好小心……";
				mes "喵喵喵……";
				set hatcat2008,1;
				setquest 7054;
				setquest 7055;
				close;
			}
		}
	} else if(hatcat2008 == 1) {
		if(checkquest(7055,HUNTING) == 2) {
			mes "[Myu]";
			mes "你以为我不知道你做了什么吗？";
			mes "嗯？";
			next;
			mes "[Myu]";
			mes "你、你怎么能杀死那些珍贵的孩子……？";
			mes "你还说自己是站在我们这边的？！";
			next;
			mes "[Myu]";
			mes "我们之间的交易结束了！！！";
			mes " ";
			mes "(Meow..)";
			set hatcat2008,0;
			erasequest 7054;
			erasequest 7055;
			close;
		} else if(checkquest(7054,HUNTING) == 2) {
			mes "[Myu]";
			mes "哦……哇，难以置信！";
			mes "现在那些狗头人应该学到教训了吧？";
			mes "喵喵喵！";
			next;
			mes "[Myu]";
			mes "来，拿着这个。";
			mes "这是我们‘勇敢猫咪’的印记。";
			mes "它非常珍贵，可别弄丢了。";
			next;
			select("This is it?");
			mes "[Myu]";
			mes "你还期待什么？";
			mes "那股力量可是非常珍贵的东西！";
			mes "现在拿着它离开吧。野玫瑰不喜欢冒险者待在附近。";
			set hatcat2008,2;
			getitem 5446,1;
			erasequest 7054;
			erasequest 7055;
			close;
		}
		mes "[Myu]";
		mes "现在明白了吧？";
		mes "一千次！——咯咯笑——";
		mes "(Meow Meow Meow~)";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "（真是个怪人……不过，那阵喵喵声是怎么回事？）";
		mes "只要你遵守承诺。";
		mes "事情完成后……好吗？";
		next;
		mes "[Myu]";
		mes "当然！不用担心~";
		close;
	} else if(hatcat2008 == 2) {
		mes "[Myu]";
		mes "这里是被遗弃者的村庄。";
		mes "是那些行走于阴影中、低调生活者的故乡。";
		next;
		mes "[Myu]";
		mes "哦，你不是拿走我们‘勇敢猫咪’印记的冒险者吗？";
		mes "你来这里做什么？";
		next;
		mes "[Myu]";
		mes "哦，对了，即使我们威胁了狗头人……";
		mes "情况也完全没有改变。能再帮我们一次吗？";
		next;
		mes "缪模仿割喉动作在脖子上比划。";
		mes "她的嘴巴看起来在说：";
		mes "‘一、千、次。’";
		next;
		switch(select("不要！:当然。")) {
		case 1:
			mes "[Myu]";
			mes "...!...";
			mes "……啊……真遗憾。";
			mes "看来诱饵坏掉了……";
			mes "没关系，事情就是这样。喵。";
			close;
		case 2:
			mes "[Myu]";
			mes "你知道该怎么做，对吧？";
			mes "绝对不能碰野玫瑰，只猎杀狗头人弓箭手。";
			mes "让他们绝望一千次！";
			set hatcat2008,1;
			setquest 7054;
			setquest 7055;
			close;
		}
	}
	mes "[Myu]";
	mes "喵……";
	mes "阳光……让我犯困……";
	close;
}

morocc_in,137,102,5	script	Trainee#2008hat01	82,{
	mes "[Trainee Elgo]";
	mes "欢迎。";
	mes "如果你来制作染料，请和我们的老师交谈。";
	mes "如果是关于交付，请和我旁边的朋友交谈。";
	next;
	switch(select("你到底在做什么？:我明白了。")){
	case 1:
		mes "[Elgo]";
		mes "我给衣物染色，";
		mes "比如手帕或丝带。";
		next;
		mes "[Elgo]";
		mes "我能把小物品染得很漂亮……";
		mes "比如 ^4d4dff可爱丝带^000000。";
		mes "想染色的话，带一条可爱丝带给我。";
		next;
		mes "[Elgo]";
		mes "这也是我练习的好机会，";
		mes "而且你不用支付任何 Zeny。";
		mes "不过我至少需要指定的^4d4dff染料^000000。";
		next;
		mes "[Elgo]";
		mes "当然，我不会失败。";
		mes "我会全力以赴。";
		mes "我要挑战自己的技艺！";
		next;
		if (countitem(2250) > 0 || countitem(5441) > 0 || countitem(5439) > 0 || countitem(5440) > 0 || countitem(5438) > 0) {
			mes "["+strcharinfo(0)+"]";
			mes "（我有一条可爱丝带……该怎么办呢……？）";
			next;
			switch(select("请埃尔戈染色。:就这样吧。")){
			case 1:
				mes "[Elgo]";
				mes "哦，你想给可爱丝带染色，对吗？";
				mes "你的可爱丝带是什么颜色？";
				mes "你想染成哪一种？";
				next;
				switch(select("黄色……:白色……:蓝色……:红色……:绿色……:算了。")){
				case 1:
					if(countitem(2250) > 0) {
						mes "[Elgo]";
						mes "好好好，黄色可爱丝带，对吧？";
						mes "你想染成什么颜色？";
						next;
						switch(select("白色:蓝色:红色:绿色")){
						case 1:
							if(countitem(982) > 0) {
								mes "[Elgo]";
								mes "哇，纯洁无瑕的白色！";
								mes "好，就这么做。";
								next;
								mes "- 埃尔戈将染料和化学品溶解在水中，然后开始给可爱丝带染色。-";
								next;
								mes "[Elgo]";
								mes "……嗯……";
								mes "应该可以了。";
								mes "你觉得怎么样？";
								mes "这个颜色好看吗？";
								delitem 2250,1;
								delitem 982,1;
								getitem 5441,1;
								close;
							}
							mes "[Elgo]";
							mes "想染成白色，就带给我 ^4d4dff1 个白色染料^000000。";
							close;
						case 2:
							if(countitem(978) > 0) {
								mes "[Elgo]";
								mes "酷蓝色！！";
								mes "就这么做！";
								next;
								mes "- 埃尔戈将染料和化学品溶解在水中，然后开始给可爱丝带染色。-";

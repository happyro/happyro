			switch( select( "你的发型是在哪里做的？", "请为我唱首歌。", "你有女朋友吗？", "关于Aigu" ) ) {
				mes "[Ragi]";
			case 1:
				mes "艾尔贝塔有一位出色的发型师。他用烹饪剪刀把我的头发剪得乱七八糟，看起来像是违法操作。";
				next;
				mes "[Ragi]";
				mes "有时发型或发色会很奇怪……但我很幸运没有因此丧命。";
				break;
			case 2:
				mes "我还没有作为乐队成员创作过歌曲。总有一天，我会为你写一首伟大的歌！";
				break;
			case 3:
				cutin "ragi03",0;
				mes "……";
				next;
				cutin "ragi02",0;
				mes "[Ragi]";
				mes "我心里只有Aigu，无法想其他事情。即使是单恋，我也觉得没关系……";
				break;
			case 4:
				mes "我永远不会忘记第一次见到她的那天。在伊兹鲁德港口那么多人中，她只注视着我。现在我靠做些小差事来帮助她。";
				next;
				mes "[Ragi]";
				mes "不过，Aigu 好像喜欢别人。^FF0000我们从未见过……但我讨厌他。^000000";
				next;
				mes "[Ragi]";
				mes "但我更讨厌自己，因为即使她永远看不到我，我还是想待在她身边。哈哈，我是不是太认真了？";
				next;
				mes "[Ragi]";
				mes "我只是个讲故事的人……任何故事都可以编造。大多数时候，其中都包含真相。";
			}
		}
	}
	close2;
	cutin "",255;
	end;
S_Quest:
	if (isbegin_quest(getarg(0)))
		erasequest getarg(0);
	setquest getarg(1);
	if (getarg(2,0))
		getexp getarg(2),getarg(3);
	return;
S_Erasequest:
	.@total = getargcount();
	for ( .@i = 0; .@i < .@total; .@i += 3 ) {
		.@quest_id = getarg(.@i);
		switch( checkquest(.@quest_id,HUNTING) ) {
		case -1:
			if (checkquest(.@quest_id+1) > -1)
				erasequest (.@quest_id+1);
			continue;
		case 0:
		case 1:
			mes "[Ragi]";
			switch( getarg(.@i+1) ) {
			case 1:
				mes getarg(.@i+2) + " 的故事剩下部分就这样吧，我去问问其他人。";
				break;
			case 2:
			case 3:
				mes "我去问其他冒险者关于" + getarg(.@i+2) + "的故事。";
				break;
			}
			break;
		case 2:
			mes "[Ragi]";
			switch( getarg(.@i+1) ) {
			case 1:
				mes "你听过" + getarg(.@i+2) + "的故事吗？谢谢你。我保证会写出一首好歌。";
				getexp 1100000,300000;
				break;
			case 2:
				mes "摩洛克的故事够写成歌曲吗？你做得很好。";
				getexp 1100000,200000;
				break;
			case 3:
				mes "你的冒险怎么样？有趣吗？以后请让我听听你的冒险故事。";
				getexp 1100000,200000;
				break;
			}
		}
		erasequest .@quest_id;
		next;
	}
	return;
}

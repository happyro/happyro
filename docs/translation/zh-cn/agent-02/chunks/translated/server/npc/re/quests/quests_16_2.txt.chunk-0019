		next;
		emotion ET_QUESTION, playerattached();
		mes "[" + strcharinfo(0) + "]";
	mes "什么……你为什么这么说？";
	mes "好像你要去很远的地方一样？";
		next;
		emotion ET_SMILE;
		mes "[Arivero Yurhik]";
	mes "你这是什么表情？哈哈哈。我想给你拍张照片。嗯……";
		next;
		specialeffect EF_MAGICCRASHER2;
		mes "[Arivero Yurhik]";
	mes "我现在应该向你表达谢意。不过还得请你再帮一个忙。请偶尔和我的姐姐聊聊。她经常感到孤独……";
		next;
		mes "[Arivero Yurhik]";
	mes "哦……时间到了……再见……谢谢……";
		next;
		specialeffect EF_MAPPILLAR;
		sleep2 4000;
		npctalk "哦……", "Arivero Yurhik#TFQ13", bc_self;
		cloakonnpcself( "Arivero Yurhik#TFQ13" );
		delitem 997,1;// Great Nature
		delitem 994,3;// Flame Heart
		erasequest 5736;	// To Einbroch
		setquest 5737;	// Clana Namieri
		yurhik_quest = 10;
	mes "维罗道别后突然消失了。这是怎么回事？他被召去执行紧急任务了吗？";
	mes "维罗不见了。我该回克拉纳·奈米里吗？";
		close;
	}
	end;
OnInit:
	cloakonnpc();
	end;
}

einbroch,260,40,0	script	Einbroch Prohibition equipment	HIDDEN_WARP_NPC,5,5,{
	end;
OnTouch:
	if (yurhik_quest == 9) {
		cloakoffnpcself( "Arivero Yurhik#TFQ13" );
		npctalk "朋友！你来了！", "Arivero Yurhik#TFQ13", bc_self;
	}
	end;
}

einbroch,260,40,0	duplicate(dummy_cloaked_npc)	Teleport Prohibition equipment#4	2_MONEMUS


rebel_in,91,67,3	script	Ericsson Adler#16.2rm	4_MAL_CAPTAIN,{
	if (terra_gloria_main < 17) {
		mes "[Detached Force commander Ericsson]";
		mes "你……？";
		close;
	}
	if (lebedev_quest_16_2 == 6) {
		mes "[Detached Force commander Ericsson]";
		mes "你……你就是和秘密之翼一起来的冒险者。";
		mes "有什么事吗？";
		next;
		mes "你告诉他从埃琳娜·沃尔科娃那里听到的消息，并请他提供意见。";
		next;
		mes "[Detached Force commander Ericsson]";
		mes "如果是秘密之翼的事，我本来不会说什么。但这件事我会帮助你。";
		mes "正如沃尔科娃指挥官所说，是我带来了那些孩子。";
		next;
		mes "[Detached Force commander Ericsson]";
		mes "……我听说了他们最近发生的事。但我不知道他们遭受了那样的痛苦。";
		next;
		mes "[Detached Force commander Ericsson]";
		mes "我想亲自和列别捷夫双胞胎谈谈。但那会显得越权，也会给沃尔科娃指挥官带来麻烦。";
		mes "沃尔科娃指挥官也知道这一点。所以她派你来。";
		next;
		mes "[Detached Force commander Ericsson]";
		mes "有些人不喜欢沃尔科娃指挥官。";
		mes "她的部队是USU。指挥官没能照顾好自己的部下，于是部下去找前任指挥官？这会变成很糟的局面。";
		next;
		mes "[Detached Force commander Ericsson]";
		mes "把这个给你。和双胞胎一起吃。告诉他们相信我，并把他们的问题告诉你。";
		mes "别讲建议或训诫，只要听他们说一会儿。他们是好孩子，一定会理解你。明白了吗？";
		next;
		mes "[" + strcharinfo(0) + "]";
	mes "（……饼干……？）";
		erasequest 16016;// Borrowing wisdom of the experts
		setquest 16033;// Bring dessert and listen the story
		getitem 25161,1;// Handmade_cookie2
		lebedev_quest_16_2 = 7;
		questinfo_refresh();
		close;
	}
	if (lebedev_quest_16_2 == 7 && countitem(25161) < 1) {
		mes "[Detached Force commander Ericsson]";
		mes "你回来了！别这么紧张。他们是好孩子，去和他们聊聊吧。";
		next;
		mes "[Detached Force commander Ericsson]";
		mes "别对他们说教太多。如果他们有问题，就听他们说。记得把饼干给他们。";
		getitem 25161,1;// Handmade_cookie2
		close;
	}
	// twins daily quest
	if (isbegin_quest(16030) == 1) {
		mes "[Detached Force commander Ericsson]";
		mes "饼干？列别捷夫双胞胎做的？";
		mes "那我只能吃掉了。把它们给我。";
		next;
		if (countitem(25161) < 1) {
			mes "[Detached Force commander Ericsson]";
		mes "你说有饼干。饼干在哪里？";
			close;
		}
		mes "[Detached Force commander Ericsson]";
		mes "闻起来不错。当然比不上露西做的……";
		next;
		mes "[Detached Force commander Ericsson]";
		mes "嗯，很好吃！替我谢谢他们。";
		completequest 16030;// Service: Cookies delivery
		delitem 25161,1;// Handmade_cookie2
		close;
	}

	// Veteran's small memorial service quest
	switch( checkquest(16049,PLAYTIME) ) {
	case -1:
		break;
	case 0:
	case 1:
		mes "[Detached Force commander Ericsson]";
	mes "我很高兴，谢谢你。今天一束花就够了。";
		next;
		mes "[Detached Force commander Ericsson]";
	mes "你一定还有其他事要做，明天再来吧。";
		close;
	case 2:
		erasequest 16049;// Quiet dawn
		break;
	}
	switch( isbegin_quest(16050) ) {
	case 0:// first time
		switch( isbegin_quest(16045) ) {
		case 0:
			mes "[Detached Force commander Ericsson]";
			mes "...?";
		mes "你……";
			next;
			mes "[Detached Force commander Ericsson]";
		mes "你就是在我们藏身处制造巨大骚动的冒险者。";
		mes "话说回来……嗯，算了。";
			next;
			mes "[" + strcharinfo(0) + "]";
		mes "（……他好像想说什么。）";
			next;
			if (select( "Would you like to say anything?", "See you." ) == 2) {
				mes "[Detached Force commander Ericsson]";
				mes "哎呀，抱歉。回头见。";
				close;
			}
			mes "[Detached Force commander Ericsson]";
			mes "哦，其实……我想请你帮个小忙。";
			mes "你需要去一趟艾因布罗克。愿意接受吗？";
			next;
			if (select( "I will help you.", "Sorry, I'm busy." ) == 2) {
				mes "[Detached Force commander Ericsson]";
				mes "抱歉给你添麻烦了。";
				close;
			}
			mes "[Detached Force commander Ericsson]";
			mes "谢谢。这不是什么难事。";
			mes "从艾因布罗克天文台向南走，你会找到一位^0000CD卖花女孩^000000。";
			next;
			mes "[Detached Force commander Ericsson]";
			mes "你能从那个孩子那里买一束花，放在她旁边的树下吗？";
			mes "树下有一块小牌子，很容易找到。";
			next;
			mes "[Detached Force commander Ericsson]";
			mes "拜托你了。回来报告，呃……告诉我一声。";
			setquest 16045;// Veteran's small memorial service
			close;
		case 1:
			mes "[Detached Force commander Ericsson]";
			mes "从^0000CD卖花女孩^000000那里买一束花，放在树下。";
			mes "从艾因布罗克天文台向南走就能找到她。";
			close;
		case 2:
			break;
		}
		switch( isbegin_quest(16048) ) {
		case 0:
			mes "[Detached Force commander Ericsson]";
			mes "从^0000CD卖花女孩^000000那里买一束花，放在树下。";
			mes "从艾因布罗克天文台向南走就能找到她。";
			close;
		case 1:
			mes "[Detached Force commander Ericsson]";
			mes "哦，是你。";
			next;
			mes "[" + strcharinfo(0) + "]";
			mes "我和露西谈过了。";
			next;
			mes "[Detached Force commander Ericsson]";
			mes "很好。她的身体怎么样？";
			next;
			if (select( "She was fine.", "She was talking about you." ) == 1) {
				mes "[Detached Force commander Ericsson]";
				mes "真的吗？那太好了。她没对你说别的吗？";
				mes "很好。请不要把这件事告诉列别捷夫双胞胎以外的任何人。";
				next;
				mes "[Detached Force commander Ericsson]";
				mes "他们以前会帮我做这件事。但现在我不能再拜托他们。";
			}
			else {
				mes "[Detached Force commander Ericsson]";
				mes "我明白了。她说了什么？";
				next;
			mes "你告诉他从露西那里听到的事。";
				next;
				mes "[Detached Force commander Ericsson]";
				mes "……也许其中有很大的误会。";
				mes "请不要把这件事告诉叛乱军里的其他人，列别捷夫双胞胎除外。";
				next;
				mes "[Detached Force commander Ericsson]";
				mes "要是她还活着就好了……";
				next;
				mes "[Detached Force commander Ericsson]";
				mes "不，我不该这样想。";
			}
			next;
			mes "[Detached Force commander Ericsson]";
			mes "谢谢你前去。";
			mes "如果你不介意，偶尔来这里放些花好吗？";
			completequest 16048;// Traces of old story
			setquest 16049;// Quiet dawn
			getitem 25155,10;// Swz_Honor_Token
			getexp 200000,200000;
			close;
		case 2:	// daily
			break;
		}
		// fall through
	case 1:// daily
		mes "[Detached Force commander Ericsson]";
		mes "你愿意再去艾因布罗克献花吗？";
		next;
		if (select( "I will help you.", "Sorry, I'm busy." ) == 2) {
			mes "[Detached Force commander Ericsson]";
			mes "是这样吗。";
			mes "抱歉，反正也不是什么有趣的事。";
			next;
			mes "[Detached Force commander Ericsson]";
			mes "希望你有时间时能再来。";
			close;
		}
		mes "[Detached Force commander Ericsson]";
		mes "艾因布罗克天文台南边有一棵树，附近能找到^0000CD卖花女孩^000000。";
		mes "非常感谢。";
		if (isbegin_quest(16050) == 0)
			setquest 16050;// Tribute hour
		close;
	case 2:
		if (isbegin_quest(16053) == 1) {
			mes "我去过艾因布罗克了。";
			next;
			mes "[Detached Force commander Ericsson]";
			mes "谢谢你前去。我本来应该亲自去，但很少有时间。";
			mes "因为现在正是忙碌时期。";
			erasequest 16053;// Ongoing old story
			erasequest 16050;// Tribute hour
			setquest 16049;// Quiet dawn
			getitem 25155,3;// Swz_Honor_Token
			getexp 170000,200000;
			close;
		}
		mes "[Detached Force commander Ericsson]";
		mes "从^0000CD卖花女孩^000000那里买一束花，放在树下。";
		mes "从艾因布罗克天文台向南走就能找到她。";
		close;
	}
	end;

OnInit:
	// Ericsson daily
	.@terra_main$ = "terra_gloria_main > 16";
	questinfo( QTYPE_QUEST, QMARK_NONE, (.@terra_main$ + " && checkquest(16049,PLAYTIME) == -1 && isbegin_quest(16045) == 0") );
	questinfo( QTYPE_QUEST, QMARK_NONE, (.@terra_main$ + " && checkquest(16049,PLAYTIME) == 2") );
	questinfo( QTYPE_QUEST, QMARK_NONE, (.@terra_main$ + " && isbegin_quest(16048) == 1") );
	questinfo( QTYPE_QUEST, QMARK_NONE, (.@terra_main$ + " && isbegin_quest(16053) == 1") );

	// twins main quest
	questinfo( QTYPE_QUEST, QMARK_NONE, "lebedev_quest_16_2 == 6" );
	end;

	// twins daily quest : "Service: Cookies delivery"
	questinfo( QTYPE_QUEST, QMARK_NONE, "isbegin_quest(16030) == 1 && countitem(25161) > 0" );
	end;
}

einbroch,167,160,3	script	Flower Girl#16.2rm	1_M_SIZ,{
	if (isbegin_quest(16045) == 1) {
		mes "[Flower Girl]";
		mes "你好。要买花吗？";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "请给我一束花。";
		next;
		mes "[Flower Girl]";
		mes "好的，我明白了！";
		mes "哦，我该怎么办……";
		next;
		mes "[Flower Girl]";
		mes "我有花，但用来做花束的纸用完了。";
		mes "我平时买纸的商店关门了……";
		mes "我不能独自走太远。";
		next;
		mes "[Flower Girl]";
		mes "拜托了。";
		mes "如果你带来^0000CD3张光滑纸^000000，我就免费为你做一束花。";
		completequest 16045;// Veteran's small memorial service
		setquest 16046;// DIY obtaining bouquet materials
		close;
	}
	if (isbegin_quest(16046) == 1 || isbegin_quest(16051) == 1) {
		mes "[Flower Girl]";
		mes "你带来^0000CD3张光滑纸^000000了吗？";
		mes "带来的话，我就免费为你做一束花。";
		if (countitem(7111) < 3)
			close;
		next;
		if (select( "Hand over the slick paper.", "Do not give the paper." ) == 2) {
			mes "[Flower Girl]";
			mes "哦，对不起……你不需要花束了吗？";
			close;
		}
		mes "[Flower Girl]";
		mes "给，这束花真漂亮。";
		delitem 7111,3;// Smooth_Paper
		getitem 25152,1;// Cherish_Bouquet
		if (isbegin_quest(16046) == 1) {
			erasequest 16046;// DIY obtaining bouquet materials
			setquest 16047;// Quiet memorial ceremony
		}
		else if (isbegin_quest(16051) == 1) {
			erasequest 16051;// DIY obtaining bouquet materials
			setquest 16052;// Quiet memorial ceremony
		}
		close;
	}
	if (isbegin_quest(16047) == 1 || isbegin_quest(16052) == 1) {
		if (countitem(25152) < 1) {
			mes "[Flower Girl]";
			mes "你好，欢迎回来。你需要什么花？";
			next;
			mes "[" + strcharinfo(0) + "]";
		mes "能用康乃馨帮我做一束花吗？";
			next;
			mes "[Flower Girl]";
		mes "糟糕……你知道，我还是没有足够的纸来包花。";
		mes "如果你带来^0000CD三张光滑纸^000000，我就帮你做。";
			next;
			if (select( "Hand over the slick paper.", "Do not give the paper." ) == 2) {
				mes "[Flower Girl]";
				mes "糟糕！对不起。一束花……你不需要了吗？";
				close;
			}
			if (countitem(7111) < 3) {
				mes "[Flower Girl]";
				mes "抱歉。没有足够的光滑纸，我没法做一束花……";
				close;
			}
			mes "[Flower Girl]";
			mes "给，这束花真漂亮。";
			delitem 7111,3;// Smooth_Paper
			getitem 25152,1;// Cherish_Bouquet
			close;
		}
		mes "[Flower Girl]";
		mes "花朵很快就会凋谢，但盛开时很美。";
		close;
	}
	if (isbegin_quest(16050) == 1) {
		mes "[Flower Girl]";
		mes "你好，你又来了。需要什么花？";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "能帮我做一束康乃馨吗？";
		next;
		mes "[Flower Girl]";
		mes "哦天哪……抱歉，我还是没有足够的纸来做花束……";
		mes "如果你带来3张^0000CD光滑纸^000000，我就帮你做。";
		completequest 16050;// Tribute hour
		setquest 16051;// DIY obtaining bouquet materials
		close;
	}
	mes "[Flower Girl]";
	mes "花朵，买些花吧。";
	mes "呼……空气太浑浊，花朵凋谢得很快……";
	close;

OnInit:
	questinfo( QTYPE_QUEST,QMARK_YELLOW, " isbegin_quest(16045) == 1 " );
	questinfo( QTYPE_QUEST,QMARK_YELLOW, "(isbegin_quest(16046) == 1 || isbegin_quest(16051) == 1) && countitem(7111) > 2" );
	questinfo( QTYPE_QUEST,QMARK_YELLOW, " isbegin_quest(16050) == 1 " );
	end;
}

einbroch,162,153,3	script	Huge Tree#16.2rm	4_BULLETIN_BOARD2,{
	if (isbegin_quest(16047) == 1) {
		if (countitem(25152) < 1) {
			mes "你翻找了背包。";
			next;
			mes "[" + strcharinfo(0) + "]";
			mes "我把花放在哪里了……？";
			mes "不在那里。也许我该再买一束……";
			close;
		}
		mes "[Strange Voice]";
		mes "树前有一块小牌子。";
		mes " ";
		mes "- 这里长眠着一位善良的" + (Sex ? "男孩" : "女孩") + " -";
		mes " ";
		mes "要把花束放下吗？";
		next;
		if (select( "Put the bouquet down.", "Don't put the bouquet down." ) == 2) {
			mes "放花前，你确认了这棵树是否正确。";
			close;
		}
		mes "我放下珍爱花束，默哀片刻。";
		next;
		mes "[Strange Voice]";
		mes "谁在那里？";
		next;
		mes "树旁，一位矮小的老妇人伸出了手。";
		next;
		mes "[Grandma]";
		mes "你……知道她是谁吗？你认识艾琳吗？";
		mes "看你的衣服，我想你是旅行者。我的记忆正在衰退。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "我是受人所托来这里的。";
		next;
		mes "[Grandma]";
		mes "受人所托？是阿德勒那件事吗？";
		mes "我是睡着在这里的艾琳的祖母。我叫露西。";
		next;
		mes "[Grandma Lucy]";
		mes "每年这个时候，阿德勒都会带孩子来找我，但今年我没法点蜡烛了。";
		next;
		if (select( "Goodbye.", "Report on Commander Ericsson and Mrs. Irene." ) == 1) {
			mes "[Grandma Lucy]";
			mes "再见。谢谢你千里迢迢来到这片乡间。";
			next;
			mes "[Grandma Lucy]";
			mes "艾琳会感谢你的。再见……";
			erasequest 16047;// Quiet memorial ceremony
			setquest 16048;// Traces of old story
			delitem 25152,1;// Cherish_Bouquet
			close;
		}
		mes "[" + strcharinfo(0) + "]";
		mes "阿德勒指挥官怎么认识艾琳的？";
		next;
		mes "[Grandma Lucy]";
		mes "指挥官？";
		mes "……原来是真的。阿德勒先生果然是位高级军官。";
		next;
		mes "[Grandma Lucy]";
		mes "虽然把这段往事告诉陌生人太长了，但我会告诉你。你也是阿德勒先生派来的……";
		next;
		mes "[Grandma Lucy]";
		mes "我和艾琳在艾因贝赫生活了很久。";
		mes "艾琳的父母为了找更好的工作离开了家。我们失去联系已经超过十年。";
		next;
		mes "[Grandma Lucy]";
		mes "如你所知，艾因贝赫发生过很多事故。";
		mes "村里只剩下老人，所以艾琳一定觉得很无聊。但她相信父母总有一天会回来，不愿搬到别的村子。";
		next;
		mes "[Grandma Lucy]";
		mes "还有……那年这个时候，矿井还没关闭。我听说矿井深处有一群叫叛乱军的坏人。";
		next;
		mes "[Grandma Lucy]";
		mes "她每天都会去矿井卖些食物。那天我告诉她不要去。";
		mes "但她说没事，还是去了矿井……";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "（露西奶奶开始流泪，你把手帕递给了她。）";
		next;
		mes "[Grandma Lucy]";
		mes "谢谢你……那天发生了事故……一条隧道坍塌，有些人再也没有回来。";
		mes "艾琳就是其中之一……";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "你一定遭受了毁灭性的打击……";
		next;
		mes "[Grandma Lucy]";
		mes "虽然他们说那是事故，但还有一个传闻。";
		mes "人们告诉我，矿井里藏着坏人，士兵是来抓他们的。";
		next;
		mes "[Grandma Lucy]";
		mes "但那对我来说一点也不重要。";
		mes "失去儿子、儿媳和孙女让我彻底崩溃。我心不在焉，找不到继续活下去的理由……";
		next;
		mes "[Grandma Lucy]";

2@gl_k,158,241,1	script	Hugin#21	4_M_SAGE_C,{
	if ('step != 9)
		end;
	if (checkquest(12319,HUNTING) == 2) {// note: complete hunting 'Corrupted Soul Hunt' prerequis
		if (checkweight(6607,5, 6608,5) == 0) {
		mes "^ff0000你携带的物品种类或重量似乎太多了。请整理物品栏。^000000";
			close;
		}
		mes "[Hugin]";
		mes "嗯，你做得很好。首先，这是 Amdarais 的战利品。";
		erasequest 12319;
		setquest 12322;// Space Distortion
		if (isbegin_quest(12321) == 0) {
			setquest 12321;// Time Conqueror
			completequest 12321;
			getitem 6607,5;// Temporal_Crystal
			getitem 6608,5;// Coagulated_Spell
			getexp 350000,350000;
		}
		else {
			getitem 6607,1;// Temporal_Crystal
			getitem 6608,1;// Coagulated_Spell
		}
		next;
		mes "[Hugin]";
		mes "Varmundt 的时间被我停止了。";
		mes "你的时间很快也会被扭曲。";
		specialeffect2 EF_BLIND;
		soundeffect "_blind.wav",0;
		next;
		mes "[Hugin]";
		mes "也许这个可怜的时间旅行者会试图阻止古城悲剧发生。";
		next;
		mes "[Hugin]";
		mes "不过，我们现在以及永远都不会放过他的行为……";
		next;
		mes "[Hugin]";
		mes "现在让我抹去你的记忆。下次见到我时，你会面对全新的我。";
		specialeffect2 EF_FREEZE;
		close2;
		warp 'map_name$[1],158,244;
		end;
	}
	mes "[Hugin]";
	mes "糟糕。我差点扭曲时间间隙。到这边来，我们得出去！";
	next;
	select("你刚才明明和我在一起……");
	mes "[Hugin]";
	mes "你刚才说什么？";
	mes "总之那不重要。时间间隙会关闭，我们得离开这里。";
	next;
	if (select("让我再看看:请让我出去") == 1) {
		mes "[Hugin]";
		mes "真的吗？这里很快就会崩塌。请快点看看。";
		close;
	}
	close2;
	warp "glast_01",204,270;
	end;
}


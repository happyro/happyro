		npctalk "Varmundt 的幽灵：现在是攻击的机会！靠近我并出手！";
	else if (.@num == 3)
		npctalk "Varmundt 的幽灵：不想被 Amdarais 的僵尸攻击，就到我这里获得更多力量！";
	else
		npctalk "Varmundt 的幽灵：不想被 Amdarais 的力量攻击，就到我这里获得更多力量！";
	end;
OnTimer10000:
	stopnpctimer;
	disablenpc();
	end;
}
2@gl_k,165,247,3	duplicate(Varmundt's Ghost#Buff1)	Varmundt's Ghost#Buff2	4_M_BARMUND,2,2
2@gl_k,150,232,8	duplicate(Varmundt's Ghost#Buff1)	Varmundt's Ghost#Buff3	4_M_BARMUND,2,2

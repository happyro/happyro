		next;
		mes "[Shiroan]";
	mes "他太固执了，根本不听我的话……真让人担心。";
		next;
		completequest 3499;
		for ( .@i = 3493; .@i <= 3502; ++.@i )
			.@total += isbegin_quest(.@i);
		if (.@total == 12)
			setquest 3505;
		mes "[Shiroan]";
	mes "那么，祝你度过平静的一天。";
		next;
	mes "- 我已经和希罗安谈完了。-";
		next;
	mes "- 去找下一个人吧。-";
		if (.@total == 12) {
			next;
	mes "- 你已经和全部6个人谈过了。回朱诺克那里吧。-";
		}
		close;
	}
	mes "[Shiroan]";
	mes "希望贾佩尔别再争吵了。";
	close;

OnTouch_:
	end;

OnInit:
	questinfo( QTYPE_QUEST2, QMARK_YELLOW, "isbegin_quest(3499) == 1" );
	end;
}

rachel,88,151,3	script	Ishira#atm8	1_F_03,2,2,{
	if (isbegin_quest(3500) == 1) {
		mes "[Isira]";
	mes "你好，初次见面。我是伊希拉。有什么可以帮你的吗？";
		next;
		mes "[Isira]";
	mes "我是芙蕾雅的虔诚信徒。";
		next;
		mes "[Isira]";
	mes "最近信徒之间的气氛很紧张吗？";
		next;
		mes "[Isira]";
	mes "我之前没有察觉，但从现在的情况来看，原住民和移民之间的矛盾似乎最近升级了。";
		next;
		mes "[Isira]";
	mes "这片原本贫瘠的土地在女神恩泽下变成了肥沃的田野，为生存和生活带来了道路……";
		next;
		mes "[Isira]";
	mes "我们难道不应该心怀感激吗？";
		next;
		mes "[Isira]";
	mes "尽管如此，刚才发生的骚乱……唉……";
		next;
		mes "[Isira]";
	mes "我不确定究竟是什么造成了这种不满。";
		next;
		completequest 3500;
		for ( .@i = 3493; .@i <= 3502; ++.@i )
			.@total += isbegin_quest(.@i);
		if (.@total == 12)
			setquest 3505;
		mes "[Isira]";
	mes "那么，祝你度过平静的一天。";
		next;
	mes "- 和伊希拉的谈话结束了。-";
		next;
	mes "- 去找下一个人吧。-";
		if (.@total == 12) {
			next;
	mes "- 你已经和全部6个人谈过了。回朱诺克那里吧。-";
		}
		close;
	}
	mes "[Isira]";
	mes "多亏了移民，原住民得到的好处一定很大……";
	next;
	mes "[Isira]";
	mes "我不太明白他们为什么会那样做。";
	close;

OnTouch_:
	end;

OnInit:
	questinfo( QTYPE_QUEST2, QMARK_YELLOW, "isbegin_quest(3500) == 1" );
	end;
}

rachel,240,182,5	script	Dina#atm9	1_F_04,2,2,{
	if (isbegin_quest(3501) == 1) {
		mes "[Dina]";
	mes "你好，是什么风把你吹来了？";
		next;
		mes "[Dina]";
	mes "啊~ 看来最近有各种对我不利的传闻在流传，对吧？";
		next;
		mes "[Dina]";
	mes "希望你不要只相信听到的片面内容。";
		next;
		mes "[Dina]";
	mes "为了积累如今的财富，我一直以战略和务实的方式行事。";
		next;
		mes "[Dina]";
	mes "考虑到我们有建立在相互理解上的契约关系，最近听到各种负面传闻实在令人遗憾。";
		next;
		mes "[Dina]";
	mes "如果你说的是收购建筑，我打算维持现状。";
		next;
		mes "[Dina]";
	mes "这是正当获利的过程。反对这一点是不合理的。";
		next;
		completequest 3501;
		for ( .@i = 3493; .@i <= 3502; ++.@i )
			.@total += isbegin_quest(.@i);
		if (.@total == 12)
			setquest 3505;
		mes "[Dina]";
	mes "祝你今天愉快！";
		next;
	mes "- 我已经和迪娜谈完了。-";
		next;
	mes "- 去找下一个人吧。-";
		if (.@total == 12) {
			next;
	mes "- 你已经和全部6个人谈过了。回朱诺克那里吧。-";
		}
		close;
	}
	mes "[Dina]";
	mes "唉，我也不知道为什么只有我在处理这件事。";
	close;

OnTouch_:
	end;

OnInit:
	questinfo( QTYPE_QUEST2, QMARK_YELLOW, "isbegin_quest(3501) == 1" );
	end;
}

rachel,212,52,3	script	Hari#atm10	1_F_MERCHANT_02,2,2,{
	if (isbegin_quest(3502) == 1) {
		mes "[Hari]";
	mes "你好，我是贾佩尔的妻子哈莉。";
		next;
		mes "[Hari]";
	mes "他性格急躁，发生意外时有时需要我来收拾残局。";
		next;
		mes "[Hari]";
	mes "因为原住民加薪一事没有达成妥协，我吃了不少苦。";
		next;
		mes "[Hari]";
	mes "其实我也不觉得需要加薪，但我更不喜欢和丈夫争吵。";
		next;
		mes "[Hari]";
	mes "不管怎样，看来已经有了一些妥协，我很高兴。";
		next;
		mes "[Hari]";
	mes "现在我想请你安静。";
		next;
		completequest 3502;
		for ( .@i = 3493; .@i <= 3502; ++.@i )
			.@total += isbegin_quest(.@i);
		if (.@total == 12)
			setquest 3505;
		mes "[Hari]";
	mes "那么就进去吧~";
		next;
	mes "- 和哈莉的谈话结束了。-";
		next;
	mes "- 去找下一个联系人吧。-";
		if (.@total == 12) {
			next;
	mes "- 你已经和全部6个人谈过了。回朱诺克那里吧。-";
		}
		close;
	}
	mes "[Hari]";
	mes "你好，我是哈莉。";
	next;
	mes "[Hari]";
	mes "她就是我面前那个固执又不屈服的女人。";
	close;

OnTouch_:
	end;

OnInit:
	questinfo( QTYPE_QUEST2, QMARK_YELLOW, "isbegin_quest(3502) == 1" );
	end;
}

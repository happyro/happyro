rachel,170,80,6	duplicate(dummy_cloaked_npc)	Greedy Man#E18_1	4_M_RASWORD
rachel,172,80,4	duplicate(dummy_cloaked_npc)	Abused Child#E18_2	4_M_DST_CHILD

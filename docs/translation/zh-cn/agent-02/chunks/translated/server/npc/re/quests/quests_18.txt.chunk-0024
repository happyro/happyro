rachel,176,80,0	script	#Hoesopflowerstart	HIDDEN_WARP_NPC,10,10,{
	end;
OnTouch:
	if (BaseLevel < 170)
		end;
	switch( isbegin_quest(5932) ) {
	case 0:
		cloakoffnpcself( "#Directing Warp" );
		cloakoffnpcself( "Greedy Man#E18_1" );
		cloakoffnpcself( "Abused Child#E18_2" );

		mes "- 一个看起来很贪婪的男人";
		mes "- 正在对孩子大吼。";
		next;
		if (select( "听听发生了什么。", "不予理会。" ) == 2)
			end;
		emotion ET_FRET, getnpcid(0,"Greedy Man#E18_1");
		npctalk "男人：我供一个无处可去的部落孩子吃住，得到的回报就只有这些吗？", "Greedy Man#E18_1", bc_self;
		emotion ET_SURPRISE, playerattached();
		unittalk getcharid(3), "" + strcharinfo(0) + " : ??", bc_self;
		next;
		emotion ET_ANGER, getnpcid(0,"Greedy Man#E18_1");
		npctalk "男人：什么？！这根本不好笑。你竟敢碰客人的钱包？", "Greedy Man#E18_1", bc_self;
		next;
		emotion ET_FRET, getnpcid(0,"Greedy Man#E18_1");
		npctalk "男人：呃……我只是听从了不要对原住民宽容的建议。", "Greedy Man#E18_1", bc_self;
		next;
		npctalk "男人：我刚才一定是失去理智了。这次就算了，但马上从我眼前消失。", "Greedy Man#E18_1", bc_self;
		specialeffect EF_HIT1, AREA, "Abused Child#E18_2";
		npctalk "孩子：啊！", "Abused Child#E18_2", bc_self;
		emotion ET_PROFUSELY_SWAT, getnpcid(0,"Abused Child#E18_2");
		cloakonnpcself( "Abused Child#E18_2" );
		cloakoffnpcself( "Abused Child#E18_3" );
		next;
		emotion ET_STARE, getnpcid(0,"Greedy Man#E18_1");
		npctalk "男人：你不能安静点吗？在整个街区吵吵嚷嚷的干什么？！", "Greedy Man#E18_1", bc_self;
		next;
		emotion ET_CRY, getnpcid(0,"Abused Child#E18_3");
		npctalk "孩子：我什么都没做。我从没见过客人的钱包。", "Abused Child#E18_3", bc_self;
		next;
		npctalk "男人：你……你……", "Greedy Man#E18_1", bc_self;
		next;
		npctalk "男人：这孩子竟敢顶嘴，不求我原谅？！", "Greedy Man#E18_1", bc_self;
		next;
		npctalk "男人：我都打算放过你、原谅你了，你现在还要撒谎？", "Greedy Man#E18_1", bc_self;
		next;
		emotion ET_BLABLA, getnpcid(0,"Greedy Man#E18_1");
		npctalk "男人：我不需要你这种无礼的小鬼！你马上被解雇！", "Greedy Man#E18_1", bc_self;
		next;
		cloakonnpcself( "Abused Child#E18_3" );
		cloakoffnpcself( "Abused Child#E18_2" );
		emotion ET_CRY, getnpcid(0,"Abused Child#E18_2");
		npctalk "孩子：先生，你错了。", "Abused Child#E18_2", bc_self;
		next;
		npctalk "孩子：请不要解雇我……我需要赚钱给父亲买药。", "Abused Child#E18_2", bc_self;
		next;
		emotion ET_FRET, getnpcid(0,"Greedy Man#E18_1");
		npctalk "男人：？！药费？", "Greedy Man#E18_1", bc_self;
		next;
		npctalk "男人：那是你的事。我为什么要在意？", "Greedy Man#E18_1", bc_self;
		next;
		npctalk "孩子：先生，那我工作至今赚到的钱呢？", "Abused Child#E18_2", bc_self;
		next;
		emotion ET_QUESTION, getnpcid(0,"Greedy Man#E18_1");
		npctalk "男人：什么？你赚到的钱？", "Greedy Man#E18_1", bc_self;
		next;
		npctalk "男人：什么？这是什么时代？我听过各种胡话，但偷窃被抓后还厚颜无耻地要钱？", "Greedy Man#E18_1", bc_self;
		next;
		emotion ET_QUESTION, getnpcid(0,"Greedy Man#E18_1");
		npctalk "男人：为偷来的钱包索要赔偿已经够丢人了，现在还要钱？真可笑。", "Greedy Man#E18_1", bc_self;
		next;
		emotion ET_CRY, getnpcid(0,"Abused Child#E18_2");
		specialeffect EF_HIT1, AREA, "Abused Child#E18_2";
		npctalk "孩子：啊！", "Abused Child#E18_2", bc_self;
		cloakonnpcself( "Abused Child#E18_2" );
		cloakoffnpcself( "Abused Child#E18_4" );
		next;
		npctalk "男人：喂！你不能小声点吗？", "Greedy Man#E18_1", bc_self;
		next;
		npctalk "男人：小鬼，如果你再在这里闲逛被我抓到，可要做好准备。", "Greedy Man#E18_1", bc_self;
		next;
		setquest 5932;
		emotion ET_FRET, getnpcid(0,"Greedy Man#E18_1");
		npctalk "男人：啊，运气就是不站在我这边。", "Greedy Man#E18_1", bc_self;
		cloakonnpcself( "#Directing Warp" );
		cloakonnpcself( "Greedy Man#E18_1" );
		close;
	case 1:
		cloakonnpcself( "#Directing Warp" );
		cloakonnpcself( "Greedy Man#E18_1" );
		cloakoffnpcself( "Abused Child#E18_4" );
		end;
	case 2:
		end;
	}
}

rachel,180,80,4	script(CLOAKED)	Abused Child#E18_4	4_M_DST_CHILD,{
	if (checkweight(1000405,10) == 0) {
		mes "- 你的物品太多，无法继续。-";
		close;
	}
	if (isbegin_quest(5932) == 1) {
		mes "[Kid]";
		mes "啊……真倒霉，不是吗？居然要和一个区区原住民打交道。";
		next;
		mes "[Kid]";
		mes "啊……我在钱方面给了他一点自由，但没有给太多，所以还挺痛快的。我以为会一直这样。";
		next;
		select( "你还好吗？" );
		mes "[Kid]";
		mes "叔叔，什么？";
		next;
		mes "[Kid]";
		mes "先生，你看起来是外来者，就别给我肤浅的同情了。这种待遇对原住民来说很常见。";
		next;
		mes "[Kid]";
		mes "那么先生请继续赶路吧。见到你并不愉快，我们别再见面了~";
		next;
		emotion ET_STARE_ABOUT;
		mes "[Kid]";
		mes "哈……我就知道会被抓到。";
		next;
		emotion ET_KIK;
		mes "[Kid]";
		mes "连老板都是笨蛋。我偷的根本不是客人的钱包。";
		next;
		mes "[Kid]";
		mes "哦！那到底是谁偷了客人的钱包？要是那个也是我偷的，感觉反而公平些。";
		next;
		mes "[Kid]";
		mes "让我看看……我拿了多少？";
		next;
		emotion ET_MONEY;
		mes "[Kid]";
		mes "一、二……三、四、五，鱿鱼、香辣牛肉汤、七、章鱼、十字螺丝刀。";
		next;
		mes "[Kid]";
		mes "哎呀，好咸。真咸。";
		next;
		emotion ET_THINK;
		sleep2 3000;
		emotion ET_SWEAT;
		mes "[Kid]";
		mes "哈哈？先生……你还在这里？你看到我数钱了吗？打算逼老板就范吗？";
		next;
		select( "既然你不用，为什么不还回去？" );
		mes "[Kid]";
		mes "哈……这位先生！你还在说漂亮话，刚才没看见吗？";
		next;
		mes "[Kid]";
		mes "我辛苦工作了几个月，连一份像样的工资都没拿到。";
		next;
		mes "[Kid]";
		mes "就算做不到，至少拿走老板的钱包，也能稍微弥补没发的工资。";
		next;
		mes "[Kid]";
		mes "哦，随便吧！你要逼我就逼吧。现在我父亲已经恢复到可以自己走动了。";
		next;
		mes "[Kid]";
		mes "我们也在慢慢筹集创业资金。";
		next;
		select( "什么生意？不会违法吧？" );
		mes "[Kid]";
		mes "嘿嘿……先生！你可是要做大事的人啊，先生。";
		next;
		mes "[Kid]";
		mes "你是想用伶俐的口才套走别人的生意点子吗？";
		next;
		mes "[Kid]";
		mes "我一个人做起来不容易，而且你看起来不是坏大人，所以我就破例吧。";
		next;
		mes "[Kid]";
		mes "我会给你一张我为生意预留地点的草图。如果你真的对我的生意感兴趣，就来找我。";
		next;
		completequest 5932;
		setquest 5933;
		mes "[Kid]";
		mes "哦！我的名字叫梅杰。再见。";
		close2;
		cloakonnpcself( "Abused Child#E18_4" );
		end;
	}
	end;

OnInit:
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "isbegin_quest(5932) == 1" );
	end;
}

// Quest: Picking Half Flowers. Step 2.
rachel,70,135,4	script(CLOAKED)	Mejai#E18_5	4_M_DST_CHILD,{
	if (checkweight(1000405,10) == 0) {
		mes "- 请稍等！！-";
		mes "- 你目前携带了-";
		mes "- 太多物品。-";
		mes "- 请减轻负重-";
		mes "- 后再试。-";
		close;
	}
	if (isbegin_quest(5933) == 1) {
		mes "[Mejai]";
		mes "哎呀，哎呀。这位先生真的来了。你来到这里就说明对我的生意感兴趣，对吧？";
		next;
		mes "[Mejai]";
		mes "嗯……我该怎么办呢……";
		next;
		mes "[Mejai]";
		mes "啊，隐瞒事情不符合我的性格，我就坦白说吧。";
		next;
		mes "[Mejai]";
		mes "有几个人来听过我的商业计划，但他们一听完就都离开了。";
		next;
		if (select( "怎么回事？", "我没兴趣。" ) == 2) {
			mes "[Mejai]";
			mes "哼！";
			mes "叔叔，既然没兴趣，何必来这里浪费时间？";
			close;
		}
		mes "[Mejai]";
		mes "哼！听到这个可别惊讶，我要在这片沙漠卖花。";
		next;
		emotion ET_QUESTION, playerattached();
		sleep2 3000;
		emotion ET_THINK, playerattached();
		mes "[Mejai]";
		mes "为什么？什么？看这个，看。这就是外来者说不可能的原因。你知道花在沙漠里有多珍贵吗？";
		next;
		mes "[Mejai]";
		mes "先生，你在拉谢尔见过花店吗？";
		next;
		emotion ET_OK, playerattached();
		mes "[Mejai]";
		mes "当然，你肯定见过。拉谢尔应该有花店，对吧？";
		next;
		mes "[Mejai]";
		mes "如果只卖花束、不卖鲜花的店也能叫花店的话。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "可是那要去哪里买花呢？";
		next;
		mes "[Mejai]";
		mes "问题正是在这里。先生，你很敏锐，我喜欢这一点。";
		next;
		mes "[Mejai]";
		mes "在这里弄到鲜花并非不可能。虽然很少见，但还是有办法得到。";
		next;
		mes "[Mejai]";
		mes "你听说过半花吗？外来者应该不熟悉。你问过艾尔帕兰的当地人吗？";
		next;
		mes "[Mejai]";
		mes "那是只在灰狼森林盛开的美丽神秘之花。父亲说他曾摘下一朵向母亲求婚。";
		next;
		mes "[Mejai]";
		mes "自从母亲去世后，父亲只有喝醉时才会谈起采集半花的方法。";
		next;
		mes "[Mejai]";
		mes "据说半花会在树下、岩石旁或草边盛开。";
		next;
		mes "[Mejai]";
		mes "必须考虑花朵周围的湿度，并以10度、20度和30度的角度采摘。";
		next;
		emotion ET_THINK;
		mes "[Mejai]";
		mes "啊……我有点激动了。父亲每次谈起这个都会让我压力很大。";
		next;
		mes "[Mejai]";
		mes "不过最后这成了我的生意，所以他那些说教也算有价值了。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "那么，我能帮你什么？";
		next;
		mes "[Mejai]";
		mes "我认为维持充足的半花供应，对我计划中的生意稳定运营至关重要。";
		next;
		mes "[Mejai]";
		mes "所以我计划和许多冒险者签约。当然，先生你也会成为其中一员，对吧？";

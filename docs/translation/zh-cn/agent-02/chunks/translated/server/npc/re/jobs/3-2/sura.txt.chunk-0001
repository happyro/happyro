ve_in,237,125,0	script	King Crab#job_shu	107,{
	if (job_shu == 0) {
		if (BaseJob == Job_Monk && BaseLevel >= 99 && JobLevel >= 50) {
			set .@job_check,1;
			if (VIP_SCRIPT) {
				callfunc "VIP_Third_Class";
				set job_shu,1;
				setquest 11155;
				next;
			}
		}
		mes "[King Crab]";
		mes "咔哈哈哈哈哈哈。";
		mes "那个小菜鸟被我一拳打倒了！";
		next;
		mes "[Sludge Worm]";
		mes "那些傲慢的家伙该受点教训。";
		mes "小菜鸟竟敢攻击老大！";
		next;
		if (!.@job_check) {
			mes "[King Crab]";
			mes "咔哈哈哈哈哈哈！！！！";
			mes "再来一杯啤酒！！！";
			mes "今天我要喝个痛快！！！";
			next;
			mes "[Sludge Worm]";
			mes "King Crab！！！我永远追随你！！";
			close;
		}
		mes "[King Crab]";
		mes "哈哈哈哈哈哈！！！！";
		next;
		mes "[Sludge Worm]";
		mes "嘿！这边！！！再来一杯啤酒！！！";
		mes "你在做什么？我老大的杯子已经空了！快来！";
		next;
		mes "[Waitress]";
		mes "好的，我马上拿来。";
		next;
		mes "[Sludge Worm]";
		mes "太慢了！！！你以为我老大是谁？嗯！？";
		next;
		mes "[Waitress]";
		mes "我……真的很抱歉，先生……";
		next;
		mes "[King Crab]";
		mes "咔咔咔咔咔。够了。";
		mes "那个可爱的女孩好像被你吓到了！";
		mes "嘿，小姐～我们不是可怕的人～～";
		next;
		mes "[Waitress]";
		mes "啊啊啊啊啊！别这样！！";
		next;
		mes "- Bang -";
		donpcevent "???#bcmd::OnEnable";
		next;
		mes "[???]";
		mes "嘿，你们。";
		mes "我一直看着你们，像这里是你们的一样大吵大闹。";
		next;
		mes "[???]";
		mes "太吵了。如果还想说那些废话，就回家去。";
		next;
		mes "[Sludge Worm]";
		mes "什么？！";
		mes "我不知道你是谁，但你一定疯了！";
		mes "你知道我老大是谁吗？！！";
		next;
		mes "[Sludge Worm]";
		mes "这就是大名鼎鼎的King Crab！！！";
		mes "一拳就能消灭整支军队！！！";
		next;
		mes "[???]";
		mes "你做尽肮脏的事，和你肮脏的脸一样。";
		mes "你只是个满足欲望的恶棍。";
		next;
		mes "[King Crab]";
		mes "什么？";
		mes "你竟敢说这种话？";
		mes "别以为你是女孩我就会放过你。";
		next;
		mes "[Sludge Worm]";
		mes "哼！老大真的生气了！";
		mes "我一拳就能打倒你……";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "嘿！你竟敢对女士使用暴力！？";
		next;
		mes "[???]";
		mes "退后，你这个小东西……";
		next;
		mes "[???]";
		mes "哦，听你这么说我很高兴。";
		mes "我正在训练，所以不会先攻击。";
		next;
		mes "[King Crab & Sludge Worm]";
		mes "什么？";
		next;
		mes "[King Crab & Sludge Worm]";
		mes "呃呃呃？！";
		next;
		mes "[King Crab & Sludge Worm]";
		mes "啊啊啊啊啊啊啊！！！！！！";
		specialeffect EF_FIRESPLASHHIT,AREA,"King Crab#job_shu";
		specialeffect EF_FIRESPLASHHIT,AREA,"Sludge Worm#job_shu";
		next;
		mes "- 那是什么惊人的力量？ -";
		mes "- 我从没见过这种 -";
		mes "- 技能…… -";
		next;
		mes "[???]";
		mes "唉，气氛被破坏了……";
		next;
		mes "[Waitress]";
		mes "谢……非常感谢……";
		mes "我该怎么报答你？";
		next;
		mes "[???]";
		mes "没什么大不了的。没关系。";
		next;
		mes "[Waitress]";
		mes "你要回住处吗？";
		mes "如果你不介意，我可以给你送一餐吗？";
		next;
		mes "[???]";
		mes "哦，不用麻烦了。";
		mes "一片面包和热汤就够了。";
		mes "那么，我该告辞了。再见。";
		donpcevent "???#bcmd::OnDisable";
		next;
		mes "[Waitress]";
		mes "再见……";
		mes "……";
		mes "……";
		mes "…………（脸颊发红）";
		set job_shu,1;
		setquest 11155;
		close;
	} else {
		if (strnpcinfo(0) == "King Crab#job_shu") {
			mes "[King Crab]";
			mes "小菜鸟怎么能打倒我！我可是伟大的King Crab……";
		} else {
			mes "[Sludge Worm]";
			mes "老大……我们真的过气了吗？";
			mes "呜……呜……";
		}
		close;
	}
}
ve_in,241,128,4	duplicate(King Crab#job_shu)	Sludge Worm#job_shu	110

ve_in,244,126,3	script	Waitress#job_shu	69,{
	mes "[Waitress]";
	if (job_shu == 0) {
		mes "哦，不～";
		mes "我讨厌那些吵闹又没礼貌的客人！";
		mes "希望有人能替我骂他们。";
		close;
	} else if (job_shu == 1) {
		if (BaseJob == Job_Monk) {
		mes "哎呀～";
		mes "真的很感谢你，"+jobname(Class)+"，刚才帮了我。";
			next;
		}
		mes "啊，就是之前见过的那个人？";
		mes "她已经在这个村子住了好几天，";
		mes "她是不是很厉害？";
		next;
		mes "[Waitress]";
		mes "虽然她和我一样是女性，但真是太帅了！";
		mes "啊～那美丽又威严的身姿……";
		next;
		mes "[Waitress]";
		mes "哦，天啊！！";
		mes "我忘了要做什么！";
		mes "我得马上做饭，然后把餐点送到旅馆。啊～";
		next;
		mes "[Waitress]";
		mes "如果你还不知道住在哪里，请使用^f57d7d这栋建筑上方的旅馆^000000。";
		close;
	}
	mes "现在客人们安静多了。";
	mes "啊啊啊，我感觉好多了！！";
	close;
}

ve_in,240,131,0	script	???#bcmd	484,{
	end;
OnInit:
	disablenpc "???#bcmd";
	end;
OnEnable:
	enablenpc "???#bcmd";
	initnpctimer;
	end;
OnDisable:
	disablenpc "???#bcmd";
	stopnpctimer;
	end;
OnTimer600000:
	donpcevent "???#bcmd::OnDisable";
	stopnpctimer;
	end;
}

ve_in,97,149,0	script	#Suraryokan	139,3,3,{
OnTouch:
	if (job_shu == 1) {
		set .@n$, "["+strcharinfo(0)+"]";
		mes "[???]";
		mes "谁啊？！";
		next;
		mes .@n$;
		mes "我就是刚才在酒吧的人。";
		mes "我有事要问。";
		next;
		mes "[???]";
		mes "别烦我，走开！";
		next;
		mes .@n$;
		mes "拜托，我只是想谈谈。";
		next;
		mes "[???]";
		mes "...";
		next;
		mes .@n$;
		mes "别无视我，和我谈谈。";
		next;
		mes .@n$;
		mes "就一会儿，不行吗？";
		next;
		mes .@n$;
		mes "我不是来伤害你的。";
		next;
		mes .@n$;
		mes "你怎么能这样对待来到你门前的人？";
		next;
		mes .@n$;
		mes "你太过分了。";
		next;
		mes .@n$;
		mes "看到你战斗后……";
		next;
		mes .@n$;
		mes "我想你一定练过武术，所以来见你。";
		next;
		mes .@n$;
		mes "但看到你这样把我晾在门外……";
		next;
		mes .@n$;
		mes "你一定精通武术……";
		next;
		mes "[???]";
		mes "真执着……";
		next;
		mes "[???]";
		mes "你到底想做什么？";
		set job_shu,2;
		close;
	}
	end;
}

ve_in,98,159,0	script	Fighter#job_shu	484,{
	if (job_shu < 2) {
		mes "[Fighter]";
		mes "啊啊啊～我好累。";
		mes "训练太辛苦了，我还有很长的路要走！";
		close;
	} else if (job_shu == 2) {
		mes "["+strcharinfo(0)+"]";
		mes "我想知道你刚才使用的技能。";
		next;
		mes "[???]";
		mes "……";
		mes "……";
		mes "……";
		mes "…………像你这样的菜鸟不需要知道。";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "菜鸟？！";
		mes "我一直在认真练习武术。";
		mes "我有信心永远不会输。";
		next;
		mes "[???]";
		mes "那你也能打败我？";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "不……";
		mes "我想那太难了……";
		mes "老实说，我很佩服你。";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "我原以为自己已经够强，但看过你的战斗后，才发现自己太自负了。";
		next;
		mes "[???]";
		mes "呼～无论你多强，";
		mes "都无法逃避触及真正的极限。";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "你正是我期待的人。";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "我想你应该知道";
		mes "如何突破这个极限。";
		next;
		mes "[???]";
		mes "住口。";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "什么？为什么？";
		next;
		mes "[???]";
		mes "你是人类吗？";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "什么？";
		mes "当然是人类。";
		next;
		mes "[???]";
		mes "对普通人来说，变强太困难了。";
		mes "想变强就买更好的装备。";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "那么，你是什么？";
		mes "你的意思是你不是人类？";
		next;
		mes "[???]";
		mes "跨越极限……";
		mes "对人类来说是不可能的。";
		mes "那是鬼魂的道路……";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "鬼魂？";
		next;
		mes "[???]";
		mes "选择这条路后，我放弃了做人。";
		mes "放弃神的庇护，成为修罗的道路。";
		next;
		mes "[???]";
		mes "选择这条路后，你连休息的时间都没有。";
		mes "你会成为战争的傀儡……";
		next;
		switch(select("但我还是想知道更多。:好吧，那我放弃。")) {
		case 1:
			mes "[???]";
			mes "你不是傻瓜吗？";
			mes "为什么对成为鬼魂这么高兴？";
			next;
			mes "[???]";
			mes "你会后悔的，所以满足于现在的生活吧。";
			next;
			mes "["+strcharinfo(0)+"]";
			mes "既然遇到了你，我就不再这样生活了！";
			next;
			mes "[???]";
			mes "哈……你真的让我很累。";
			next;
			mes "[???]";
			mes "好吧，那么^f57d7d去杀死100只沙漠狼。^000000";
			mes "之后我再考虑。";
			set job_shu,3;
			changequest 11155,11156;
			close;
		case 2:
			mes "[???]";
			mes "好，明智的选择。";
			mes "你不必自找麻烦。";
			close;
		}
	} else if (job_shu == 3) {
		if (checkquest(11156,HUNTING) == 2) {
			mes "[???]";
			mes "哇～";
			mes "你真的杀死了那些狼？";
			mes "我还以为你会放弃。";
			next;
			mes "[???]";
			mes "女子一言，驷马难追！！";
			mes "承诺就是承诺。";
			next;
			mes "[???]";
			mes "去^f57d7dJuno东南方的El Mes峡谷^000000。";
			mes "我的同伴^f57d7dBuddy^000000会在那一带中央训练。";
			next;
			mes "[Bruno]";
			mes "告诉他是‘Bruno’派你去的，之后随你便。";
			set job_shu,4;
			changequest 11156,11157;
			close;
		}
		mes "[???]";
		mes "哈……你真的让我很累。";
		next;
		mes "[???]";
		mes "好吧，那么^f57d7d去杀死100只沙漠狼。^000000";
		mes "之后我再考虑。";
		close;
	} else if (job_shu == 4) {
		mes "[Bruno]";
		mes "去^f57d7dJuno东南方的El Mes峡谷^000000。";
		mes "我的同伴^f57d7dBuddy^000000会在那一带中央训练。";
		next;
		mes "[Bruno]";
		mes "告诉他是‘Bruno’派你去的，之后随你便。";
		close;
	} else if (job_shu == 100) {
		mes "[Bruno]";
	mes "嘿～！";
	mes "你过得怎么样？";
		next;
		mes "[Bruno]";
	mes "没有给老师的礼物吗？";
		close;
	}
	mes "[Bruno]";
	mes "我建议你重新考虑是否成为修罗。";
	mes "修罗强大又帅气，但不只是这样。";
	next;
	mes "[Bruno]";
	mes "我？";
	mes "如果能重新选择职业，我一定会选修罗。";
	close;
}

yuno_fild07,254,176,7	script	Buddy#job_shu	753,{
	if (job_shu < 4) {
		mes "[Buddy]";
		mes "哈啊！！！哈啊！！！呼！！哈啊！！！";
		next;
		mes "[Buddy]";
		mes "我不知道你为什么在这里，但除非你想死，否则别站在我身后。";
		close;
	} else if (job_shu == 4) {
		mes "[Buddy]";
		mes "哈啊！！！哈啊！！！呼！！哈啊！！！";
		next;
		mes "[Buddy]";
		mes "我不知道你为什么在这里，但除非你想死，否则别站在我身后。";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "'Bruno' sent me here.";
		next;
		mes "[Buddy]";
		mes "啊！我的同伴把你介绍给我了！";
		mes "总之，你来找我做什么？";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "我问过Bruno她的实力，她把我推荐给你。";
		next;
		mes "[Buddy]";
		mes "那个难缠的女孩……不，开玩笑的。";
		mes "她把你送到我这里，你一定是特别的人。";
		next;
		mes "[Buddy]";
		mes "我正在自我训练，无法回答你的问题，所以我带你去见我们的师父。";
		next;
		mes "[Buddy]";
		mes "我师父不喜欢噪音，所以请^f57d7d在客厅安静等待。^000000";
		next;
		mes "[Buddy]";
		mes "这边……";
		set job_shu,5;
		changequest 11157,11158;
		close2;
		warp "sword_1-1",215,244;
		end;
	} else if (job_shu == 100) {
		mes "[Buddy]";
		mes "啊，好久不见，"+strcharinfo(0)+"。";
		mes "你是来见我师父的吗？";
		next;
		switch(select("是:否")) {
		case 1:
			mes "[Buddy]";
			mes "我马上带你去。";
			close2;
			warp "sword_1-1",216,168;
			end;

			mes "唉……";
			mes "这只是……";
			close;
		}
		mes "[鲁根教官]";
		mes "我能怎样帮助你？";
		mes "如果你需要医疗帮助，请在接待处描述症状，然后等待救援。";
		next;
		select("交出索尼娅茎。");
		if (countitem(6690) < 25) {
			mes "[鲁根教官]";
			mes "这些不够。";
			mes "请确认你拥有的索尼娅茎数量。";
			close;
		}
		mes "[鲁根教官]";
		mes "你是认真的吗？";
		mes "蒂布莱克博士派你来的，所以我应该相信你。";
		mes "我会把这些喂给病人。";
		delitem 6690,25;// YummyStem
		erasequest 11359;// Antidote
		setquest 11360;// Antidote
		ep14_3_newerabs = 21;
		close;
	}
	if (ep14_3_newerabs == 21) {
		mes "[鲁根教官]";
		mes "你是认真的吗？";
		mes "蒂布莱克博士派你来的，所以我应该相信你。";
		mes "我会把这些喂给病人。";
		close;
	}
	if (ep14_3_newerabs == 22) {
		mes "[鲁根教官]";
		mes "哦！";
		mes "奥托！";
		mes "你能看到我吗？";
		next;
		mes "[Otto]";
		mes "呃……";
		next;
		mes "[鲁根教官]";
		mes "哦！";
		mes "成功了！";
		next;
		mes "[鲁根教官]";
		mes "病人们恢复得非常明显，不过现在还需要卧床。";
		mes "我会把茎喂给病情最重的病人，并等待蒂布莱克博士完成研究。";
		next;
		mes "[鲁根教官]";
		mes "我会给你一份病人对茎的反应报告。请把报告带给^0000FF蒂布莱克博士^000000。";
		mes "哈哈。";
		mes "成功了！";
		erasequest 11361;// Antidote
		setquest 11362;// Antidote
		ep14_3_newerabs = 23;
		close;
	}
	if (ep14_3_newerabs == 23) {
		mes "[鲁根教官]";
		mes "病人们恢复得非常明显，不过现在还需要卧床。";
		mes "我会把茎喂给病情最重的病人，并等待蒂布莱克博士完成研究。";
		next;
		mes "[鲁根教官]";
		mes "我会给你一份病人对茎的反应报告。请把报告带给^0000FF蒂布莱克博士^000000。";
		mes "哈哈。";
		mes "成功了！";
		close;
	}
	mes "[鲁根教官]";
	mes "我很高兴研究结果对我们有利。";
	mes "我的同伴们正在顺利恢复。";
	mes "多亏了你。";
	close;
}


// Flaming Basin and Doom Prayers
// gef_fild02,106,225,4	script	Base Investigator#bl	4_M_KY_HEAD,{
moro_vol,131,103,3	script	Base Investigator#bl	4_M_KY_HEAD,{
	if (checkweight(1301,3) == 0) {
		mes "- 物品太多，无法继续对话。-";
		close;
	}
	if (BaseLevel < 150) {
		mes "[基地调查员]";
		mes "你看起来非常弱！";
		mes "你为什么来这里？？";
		next;
		mes "[基地调查员]";
		mes "唉，人手不够！";
		mes "但我们会等你达到150级。";
		mes "请稍后再来！";
		close;
	}
	if (ep14_3_fall_bless == 0) {
		mes "[基地调查员]";
		mes "你也注意到了吗？";
		mes "是的，这里的魔物真的很奇怪。";
		next;
		mes "[基地调查员]";
		mes "它们似乎是米德加尔特魔物的变种";
		next;
		mes "[基地调查员]";
		mes "更糟的是，它们的数量正在快速增加。";
		mes "我们必须密切关注它们。";
		next;
		mes "[基地调查员]";
		mes "遗憾的是，调查非常重要，但大家似乎都很忙，我无法请他们帮忙。";
		mes "这里并不安全。";
		next;
		switch( select( "发生什么事了？", "你为什么不能自己做？", "想让我来做吗？" ) ) {
		case 1:
			mes "[基地调查员]";
			mes "这里的环境特征让调查变得非常困难。";
			mes "景色看起来很熟悉，但又有些……奇怪。";
			mes "这里看似濒临彻底崩溃，但我能看到充满活力的生长。";
			next;
			mes "[基地调查员]";
			mes "这里是什么地方？";
			close;
		case 2:
			mes "[基地调查员]";
			mes "和所有贵族出身的人一样，";
			mes "我只知道如何命令别人。";
			emotion 4, playerattached();
			close;
		case 3:
			mes "[基地调查员]";
			mes "在那些魔物中，";
			mes "^0000FF火焰秃鹰^000000看起来最危险。";
			mes "那些尾巴燃烧的鸟会冲向它们看到的所有人。你也许能逃跑，但总会被烧伤。";
			next;
			select("想让我猎杀火焰秃鹰吗？");
			mes "[基地调查员]";
			mes "不，我没有人处理它们的尸体。";
			mes "毕竟我的目的是调查。";
			mes "只要带给我";
			mes "15根^FF0000燃烧羽毛^000000";
			mes "来自^0000FF火焰秃鹰^000000。";
			next;
			if (select( "我和你一样忙！", "明白了。" ) == 1) {
				mes "[基地调查员]";
				mes "你表现得好像会帮我。";
				mes "你是在耍我吗？";
				close;
			}
			mes "[基地调查员]";
			mes "带给我";
			mes "^FF000015 Burning Feathers^000000";
			mes "来自^0000FF火焰秃鹰^000000。";
			mes "快点，别让更多人受害于那些凶恶的鸟！";
			setquest 1264;	// Flaming Basin and Doom Prayers
			ep14_3_fall_bless = 1;
			close;
		}
	}
	if (ep14_3_fall_bless == 1) {
		if (countitem(6691) < 15) {
			mes "[基地调查员]";
			mes "我以为你现在应该在努力工作，";
			mes "收集^FF000015根燃烧羽毛^000000";
			mes "来自^0000FF火焰秃鹰^000000，";
			mes "所以我召集了";
			mes "我的调查员举行紧急会议。";
			next;
			mes "[基地调查员]";
			mes "而你还在城里，";
			mes "悠闲地散步。";
			close;
		}
		mes "[基地调查员]";
		mes "你带来了";
		mes "全部^FF000015根燃烧羽毛^000000。";
		mes "谢谢。现在我可以";
		mes "继续调查。";
		next;
		mes "[基地调查员]";
		mes "最重要的是，我终于可以享受火焰的温暖了！";
		emotion 21;
		next;
		mes "[Base Investigator]";
		mes "你注意到我脸上担忧的表情了吗？";
		next;
		if (select( "没有，从没注意。", "我马上就注意到了。" ) == 1) {
			mes "[Base Investigator]";
			mes "这不是我期待的回答，";
			mes "但我还是会继续准备好的演讲，";
			mes "继续说。";
			mes "唉……";
			next;
			mes "[Base Investigator]";
			mes "一名侦察员还没回来";
			mes "从火焰盆地回来。";
			mes "我想让你去确认";
			mes "他发生了什么。";
			next;
			if (select( "做不到。", "好的。" ) == 1) {
				mes "[Base Investigator]";
				mes "我知道你最终会做的！";
				close;
			}
			mes "[Base Investigator]";
			mes "侦察员前往了魔物密集的区域。";
			mes "仔细寻找他。";
			delitem 6691,15;// BurningFeather
			completequest 1264;	// Flaming Basin and Doom Prayers
			setquest 1265;	// Flaming Basin and Doom Prayers
			ep14_3_fall_bless = 2;
			close;
		}
		mes "[Base Investigator]";
		// google translate..
		mes "不错！你们这些人……";
		mes "请吃三碗贡菜！";
		next;
		mes "[Base Investigator]";
		mes "一名侦察员还没回来";
		mes "从火焰盆地回来。";
		mes "我想让你去确认";
		mes "他发生了什么。";
		next;
			if (select( "做不到。", "好的。" ) == 1) {
			mes "[Base Investigator]";
			mes "我知道你最终会做的！";
			close;
		}
		mes "[Base Investigator]";
		mes "侦察员前往了魔物密集的区域。";
		mes "仔细寻找他。";
		delitem 6691,15;// BurningFeather
		completequest 1264;	// Flaming Basin and Doom Prayers
		setquest 1265;	// Flaming Basin and Doom Prayers
		ep14_3_fall_bless = 2;
		close;
	}
	if (ep14_3_fall_bless < 4) {
		mes "[Base Investigator]";
		mes "我派你去寻找侦察员。";
		mes "你是回来了，还是根本没出发？";
		next;
		mes "[Base Investigator]";
		mes "去魔物密集的地方寻找侦察员！";
		close;
	}
	if (ep14_3_fall_bless == 4) {
		mes "[Base Investigator]";
		mes "找到侦察员了吗？";
		mes "他正在休息并重写侦察日志？";
		next;
		mes "[Base Investigator]";
		mes "他没有让我失望。";
		mes "他是个好士兵！";
		emotion 21;
		emotion 4, playerattached();
		next;
		mes "[Base Investigator]";
		mes "既然找到了失踪的侦察员，";
		mes "我想让你继续下一个任务。";
		next;
		mes "[Base Investigator]";
		mes "你知道神秘魔物的数量";
		mes "在这片火焰盆地中一直在增加。";
		next;

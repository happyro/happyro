}

//----------------------------------------------------------------------------
// Empty Room 201
//----------------------------------------------------------------------------
ein_in01,227,279,3	script	#door_ein	-1,5,5,{
OnTouch_:
	if (kain_ticket == 5) {
		kain_ticket = 6;
		mes "["+strcharinfo(0)+"]";
		mes "打扰一下……？";
		next;

		mes "^3355FF这里没人！^000000";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "这里应该就是房间……";
		mes "但他到底在哪里？";
		mes "如果他不回来，";
		mes "我不能把这些东西留在这里。";
		next;
		mes "["+ strcharinfo(0) +"]";
		mes "算了……";
		mes "我想我可以";
		mes "把这些东西";
		mes "还给飞艇上的";
		mes "Kain。";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "既然我在艾因布罗赫，";
		mes "不如在附近看看，";
		mes "说不定能找到有趣的东西。";
		mes "不过我还是忍不住想起 Kain";
		mes "Himere 那个失踪已久的女儿……";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "也许……";
		mes "只是也许……";
		mes "我能找到一些";
		mes "关于她下落的线索。";
		mes "她甚至可能";
		mes "就住在艾因布罗赫。";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "我想我就这么做。";
		mes "也许就从现在开始。";
		mes "把它当作";
		mes "某种任务之类的。";
		mes "嗯，应该可行。";
		close;
	}
}

//----------------------------------------------------------------------------
// Elle Cherno
//----------------------------------------------------------------------------
ein_in01,261,241,3	script	Elle Cherno	4_F_KID2,3,3,{
OnTouch_:
	mes "[Elle Cherno]";
	mes "开始工作吧，";
	mes "无畏的伙伴们~！";
	mes "尽我们所能！没有什么";
	mes "能阻挡我们，小伙子们~！";
	if (kain_ticket == 6) {
		next;
			switch(select("你好！:你在唱什么？")) {
		case 1:
			mes "[Elle Cherno]";
			mes "开始工作吧，";
			mes "无畏的伙伴们~！";
			mes "尽我们所能！没有什么";
			mes "能阻挡我们，小伙子们~！";
			next;
			mes "[Elle Cherno]";
			mes "我非常喜欢这首歌！";
			mes "尤其是大喊";
			mes "“伙伴们！”伙伴们！";
			close;
		case 2:
			changequest 2079,2080;
			kain_ticket = 7;
			mes "[Elle Cherno]";
			mes "这个……？";
			mes "这是“矿工之歌”！";
			mes "妈妈教我的，";
			mes "她经常唱。";
			mes "不过爸爸说太吵了。";
			next;
			mes "[Elle Cherno]";
			mes "嗯，妈妈唱这首歌时";
			mes "有时看起来有点悲伤。";
			mes "今天她唱了一会儿，像是要哭了。^666666*倒吸气！*^000000 等等，你觉得";
			mes "妈妈是不是生病了？";
			next;
			mes "[Elle Cherno]";
			mes "不好，不好……";
			mes "你能替我去看看";
			mes "妈妈是否安好吗？";
			mes "拜托？我们家在";
			mes "酒店后面，如果她不舒服，";
			mes "请告诉我，好吗？";
			close;
		}
	} else if (kain_ticket == 7) {
		next;
		mes "[Elle Cherno]";
		mes "我们家就在";
		mes "酒店后面。";
		mes "你能去那里";
		mes "替我看看妈妈吗？";
		mes "我很担心……";
	} else if (kain_ticket == 13) {
		next;
		if (checkweight(7276,1) == 0) {
			mes "[Elle Cherno]";
			mes "嘿！我有东西";
			mes "要给你，但你带的东西";
			mes "太多了！请稍后再来，";
			mes "这样我才能";
			mes "把东西给你，好吗？";
			close;
		}
		mes "[Elle Cherno]";
		mes "你见到我爷爷了？";
		mes "你是他的朋友，对吧？";
		mes "你、你之后还会见他吗？";
		mes "因为……因为……";
		next;
		mes "[Elle Cherno]";
		mes "这是我为他做的。";
		mes "我不会写字，";
		mes "但我尽力给爷爷写了信。";
		mes "你能答应替我";
		mes "把它交给他吗？";
		mes "拜托~~~~~~？";
		next;
		mes "^3355FFElle 把一张写满涂鸦的";
		mes "留言放到你手中。^000000";
		mes " ";
		changequest 2084,2085;
		kain_ticket = 14;
		getitem 7276, 1; //Picture_Letter
	}
	close;
}

//----------------------------------------------------------------------------
// Theo Cherno
//----------------------------------------------------------------------------
ein_in01,123,94,1	script	Theo Cherno	4_M_REPAIR,{
	if (kain_ticket == 7) {
		callfunc "F_Cherno";
		kain_ticket = 8;
	} else if (kain_ticket > 7 && kain_ticket < 10) {
		mes "[Theo Cherno]";
		mes "你真善良，";
		mes "冒险者。";
		mes "世上应该多一些";
		mes "像你这样的人。";
	} else if (kain_ticket > 9 && kain_ticket < 13) {
		mes "[Theo Cherno]";
		mes "你确定";
		mes "能找到";
		mes "Tarsha 的父亲吗？哦，";
		mes "你一定是上天的恩赐！";
		mes " ";
	} else if (kain_ticket > 12) {
		emotion ET_SMILE;
		mes "[Theo Cherno]";
		mes "我真为妻子";
		mes "感到高兴。我……";
		mes "我不知道";
		mes "该如何感谢你……";
	} else {
		mes "[Theo Cherno]";
		mes "嗯……";
		mes "我们之后再聊好吗？";
		mes "我现在正忙着";
		mes "修理这个东西。";
	}
	close;
}

//----------------------------------------------------------------------------
// Tarsha Cherno
//----------------------------------------------------------------------------
ein_in01,125,99,3	script	Tarsha Cherno	4_F_EINWOMAN,{
	if (kain_ticket == 7) {
		callfunc "F_Cherno";
		kain_ticket = 8;
	} else if (kain_ticket == 8) {
		mes "[Tarsha Cherno]";
		mes "虽然这些装置大多";
		mes "不值得炫耀，";
		mes "但我们为发明这些机器";
		mes "付出了大量努力。";
		mes "所以当然会为它们自豪~";
		mes " ";
		next;
		mes "[Tarsha Cherno]";
		mes "也许这些小项目";
		mes "并不怎么了不起，";
		mes "但我喜欢把它们看作";
		mes "通往未来成就的";
		mes "垫脚石。";
	} else if (kain_ticket == 9) {
		mes "["+strcharinfo(0)+"]";
		mes "打扰一下，女士，";
		mes "你肩膀上有一道伤疤。";
		mes "那是";
		mes "事故留下的吗？";
		next;
		mes "[Tarsha Cherno]";
		mes "哦，那是多年前";
		mes "留下的旧伤。";
		mes "我想，对于抚养我的人来说，";
		mes "我当时";
		mes "一定是个";
		mes "麻烦制造者……";
		next;
		mes "[Tarsha Cherno]";
		mes "你看，我很小的时候";
		mes "就失去了父母。";
		mes "后来我才知道";
		mes "自己是由养父母抚养长大的。";
		mes "我得知亲生母亲";
		mes "很久以前就去世了……";
		next;
		mes "[Tarsha Cherno]";
		mes "至于父亲，没人知道";
		mes "他是死是活。";
		mes "我努力让养父母开心，";
		mes "但最后却太过叛逆，";
		mes "给他们带来了很多烦恼。";
		next;
		mes "[Tarsha Cherno]";
		mes "最后我离开家，";
		mes "学习机械学。";
		mes "我在学校遇见了丈夫，";
		mes "那是我一生中";
		mes "最美好的事情~";
		emotion ET_THROB, getnpcid(0, "Theo Cherno");
		next;
		mes "["+ strcharinfo(0) +"]";
		mes "对了，我听到";
		mes "你女儿在唱";
		mes "什么矿工之歌。";
		mes "是你教她的吗？";
		emotion ET_HUK;
		emotion ET_HUK, getnpcid(0, "Theo Cherno");
		next;
		mes "[Theo Cherno]";
		mes "我不明白";
		mes "小 Elle 为什么喜欢";
		mes "这么喧闹的男人歌曲。";
		mes "这全都是你的错，Tarsha！";
		emotion ET_ANGER, getnpcid(0, "Theo Cherno");
		next;
		emotion ET_SMILE;
		mes "[Tarsha Cherno]";
		mes "哦~呵呵呵呵~";
		mes "我那时太小，";
		mes "记不太清楚，";
		mes "但我确定亲生父亲";
		mes "很喜欢那首歌。";
		next;
		mes "[Tarsha Cherno]";
		mes "我只依稀记得";
		mes "他过去会在";
		mes "打扫旧房子时唱歌。";
		mes "我不记得他的长相，";
		mes "但他以前";
		mes "一定是矿工。";
		next;
		mes "["+ strcharinfo(0) +"]";
		mes "矿工……？";
		mes "（等等，那个船员，";
		mes "Kain Himere！他就是";
		mes "失去女儿的矿工！";
		mes "难道……）";
		next;
		emotion ET_SURPRISE;
		mes "["+ strcharinfo(0) +"]";
		mes "……！";
		mes "Tarsha……";
		mes "你的父亲";
		mes "也许还活着！";
		next;
		mes "[Tarsha Cherno]";
		mes "……什么？";
		next;
		mes "["+ strcharinfo(0) +"]";
		mes "我现在得去确认一件事，";
		mes "希望很快就能";
		mes "带着好消息";
		mes "回来！";
		changequest 2080,2081;
		kain_ticket = 10;
	} else if (kain_ticket == 10 || kain_ticket == 11) {
		mes "["+strcharinfo(0)+"]";
		mes "Tarsha，我认识一个";
		mes "可能是你父亲的人！";
		mes "等着我，希望我很快";
		mes "就能带回好消息！";
	} else if (kain_ticket == 12) {
		mes "[Tarsha Cherno]";
		mes "哦，欢迎回来~";
		mes "你带回";
		mes "好消息了吗？";
		emotion ET_SMILE;
		next;
		mes "["+strcharinfo(0)+"]";
		mes "是的。";
		mes "说到这个，";
		mes "请允许我……";
		mes "先确认一件事……";
		next;
		switch(select("检查她的脖子。:检查她的手。:检查她的腿。:检查她的额头。")) {
		case 1:
			mes "^3355FF糟糕……";
			mes "那里什么都没有！^000000";
			next;
			mes "[Theo Cherno]";
			mes "你、你真无礼！";
			mes "竟敢触碰";
			mes "别人的妻子……？！";
			next;
			specialeffect2 EF_PIERCE;
			percentheal -10,0;
			close;
		case 2:
			mes "^3355FF你在她的手上";
			mes "发现了烧伤痕迹。^000000";
			next;
			mes "["+strcharinfo(0)+"]";
			mes "就是这个！";
			mes "Tarsha，你的父亲叫";
			mes "Kain Himere，他在飞艇上";
			mes "担任船员。";
			mes " ";
			mes " ";
			next;
			mes "["+ strcharinfo(0) +"]";
			mes "他非常想念你，";
			mes "希望有一天";
			mes "你能原谅他……";
			mes " ";
			next;
			mes "[Tarsha Cherno]";
			mes "你……";
			mes "你说真的吗？";
			mes "我的父亲还活着！";
			mes "感谢上天！";
			mes "太谢谢你了，冒险者！";
			next;
			mes "[Tarsha Cherno]";
			mes "……";
			mes "这么说，我的";
			mes "真名应该是";
			mes "^3131FFTarsha Himere Cherno^000000。";
			next;
			mes "[Tarsha Cherno]";
			mes "哦，你是上天的恩赐！";
			mes "我永远不会忘记你";
			mes "为我做的一切！";
			mes "我一定要想办法报答你！";
			mes "但我只懂机械工程……";
			next;
			mes "[Tarsha Cherno]";
			mes "哦，我知道了~";
			mes "如果你有";
			mes "^3131FF损坏的装备^000000，";
			mes "我可以用这个";
			mes "专家修理工修好。";
			mes "这是我们最好的发明之一！";
			next;
			mes "[Tarsha Cherno]";
			mes "我必须尽快去见";
			mes "亲生父亲！";
			mes "我已经想念他很多年了！";
			mes "再次感谢你";
			mes "为我的家人所做的一切~";
			next;
			mes "[Tarsha Cherno]";
			mes "哦，在你离开前，";
			mes "能再去见见 Elle 吗？";
			mes "她似乎有事";
			mes "想和你谈谈。";
			changequest 2083,2084;
			kain_ticket = 13;
			close;
		case 3:
			mes "^3355FFUh oh...";
			mes "那里什么都没有！^000000";
			next;
			mes "[Theo Cherno]";
			mes "你、你真无礼！";
			mes "竟敢触碰";
			mes "别人的妻子……？！";
			next;
			specialeffect2 EF_PIERCE;
			percentheal -20,0;
			close;
		case 4:
			mes "^3355FFUh oh...";
			mes "那里什么都没有！^000000";
			next;
			mes "[Theo Cherno]";
			mes "你、你真无礼！";
			mes "竟敢触碰";
			mes "别人的妻子……？！";
			next;
			specialeffect2 EF_PIERCE;
			percentheal -10,0;
			close;
		}
	} else if (kain_ticket > 12) {
		mes "[Tarsha Cherno]";
		mes "多亏你为我们做的一切，";
		mes "我一直感觉很好。";
		mes "再次感谢你，";
		mes "善良的冒险者。";
	} else {
		mes "[Tarsha Cherno]";
		mes "抱歉，";
		mes "我们现在很忙。";
		mes "请原谅我们~";
	}
	close;
}

ein_in01,127,94,3	script	#exp_ein	HIDDEN_NPC,{ end; }

function	script	F_Cherno	{
	specialeffect EF_COMBOATTACK1,AREA,"#exp_ein";
	mes "^33355F*Bang*^000000";
	next;
	specialeffect EF_COMBOATTACK2,AREA,"#exp_ein";
	mes "^33355F*Bang*^000000";
	next;
	specialeffect EF_COMBOATTACK3,AREA,"#exp_ein";
	mes "^33355F*Bang*^000000";
	next;
	specialeffect EF_POISONATTACK,AREA,"#exp_ein";
	mes "^33355F*Crash!*^000000";
	mes ".....";
	emotion ET_SWEAT, getnpcid(0, "Theo Cherno");
	emotion ET_SWEAT, getnpcid(0, "Tarsha Cherno");
	next;
	mes "[Theo Cherno]";
	mes "亲爱的……";
	mes "我觉得这个连接处";
	mes "存在严重的";
	mes "结构问题。";
	next;
	mes "[Tarsha Cherno]";
	mes "它们一定没有";
	mes "正确连接。";
	mes "也许我们可以……嗯。";
	next;
	mes "[Theo Cherno]";
	mes "那么今天就到这里，";
	mes "明天再完成它，";
	mes "怎么样？";
	next;
	emotion ET_QUESTION, getnpcid(0, "Tarsha Cherno");
	mes "[Tarsha Cherno]";
	mes "哦~";
	mes "我不知道家里来了客人。";
	mes "你好，最近怎么样？";
	mes "你对我们的发明";
	mes "感兴趣吗？";
	mes " ";
	next;
	switch(select("Nothing.:Your daughter asked me to visit you.")) {
	case 1:
		mes "[Theo Cherno]";
		mes "哦，是的，我和妻子";
		mes "一直忙于研究。";
		mes "我们努力发明";
		mes "改善生活的新东西。";
		mes "这就是我们的工作……";
		mes " ";
		close;
	case 2:
		emotion ET_SWEAT, getnpcid(0, "Tarsha Cherno");
		emotion ET_SWEAT, getnpcid(0, "Theo Cherno");
		mes "[Tarsha Cherno]";
		mes "哈哈哈，Elle？";
		mes "我们的女儿";
		mes "为什么会让你";
		mes "来拜访我们？";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "嗯，这个……";
		mes "她想让我确认";
		mes "她妈妈是否";
		mes "生病或悲伤";
		mes "……之类的？";
		next;

		mes "先把你关进牢里，再听听你想说什么。";
		mes "来，你被指控盗窃，现在感觉如何？";
		next;
		mes "[Cecilia]";
		switch( select("你在做什么？：……") ) {
		case 1:
			mes "你看，我们有时会在生活中遭遇意外的不幸。";
			mes "大家都一样。";
			next;
			mes "[Cecilia]";
			mes "这是你最后的机会！";
			mes "这件事能救我们两个。";
			mes "你想听听吗？";
			break;
		case 2:
			mes "哦，你想行使权利保持沉默？";
			mes "让我看看你能闭嘴多久！";
			mes "我有个主意。你想听吗？";
			break;
		}
		next;
		if (select("我不想听！：好吧。") == 1) {
			mes "[Cecilia]";
			mes "哦，好吧！";
			mes "那我只能把你交出去，证明自己的清白。";
			next;
			mes "["+ strcharinfo(0) +"]";
			mes "（这是什么妖精，怎么这么不道德？！）";
			next;
			mes "[Cecilia]";
			mes "现在，要不要开始给你栽赃？";
			mes "只要三个妖精，就能捏造任何事，哪怕是世界树。";
			next;
			mes "["+ strcharinfo(0) +"]";
			mes "（也许我还是逃跑吧。）";
			close2;
			warp "eclage",296,306;
			end;
		}
		mes "[Cecilia]";
		mes "这件事有个简单普通的解决办法。";
		next;
		mes "[Cecilia]";
		mes "就是由你找回缺失的东西，重新填满货架。";
		mes "我得照看仓库，哪里也去不了。";
		mes "吃点苦总比被指控盗窃好，对吧？";
		next;
		mes "[Cecilia]";
		mes "我来告诉你要找什么。";
		mes "首先是^66000010堆橡果^000000、^66000010磨损的书页^000000，最后是^66000010霉菌粉末^000000。";
		mes "奇怪的是，每种物品刚好都少了10个……";
		setquest 4256;
		next;
		mes "[Cecilia]";
		mes "现在我们是一条船上的人了。";
		mes "严格来说，这叫‘共犯’。";
		mes "那么，祝你好运！";
		mes "你很容易就能在附近找到它们。";
		close;
	case 1:
		mes "[Cecilia]";
		mes "你没被抓到吧？";
		mes "那让我看看你带了什么……";
		next;
		mes "[Cecilia]";
		if (countitem(6558) < 10 || countitem(1097) < 10 || countitem(7001) < 10 ) {
			mes "还是不够……";
			mes "你没忘记我要什么吧？";
			next;
			mes "[Cecilia]";
			mes "你需要找堆橡果、磨损的书页和霉菌粉末，各10个。";
			mes "这次别忘了。";
			next;
			mes "[Cecilia]";
			mes "你下次回来时最好带齐我们需要的一切。";
			mes "如果他们发现物品缺失，那就……";
			mes "不，我不想去想。";
			close;
		}
		delitem 6558,10;// Pile_Of_Acorn
		delitem 1097,10;// Worn_Out_Page
		delitem 7001,10;// Mould_Powder
		completequest 4256;
		getexp 300000,0;
		mes "你比我想象的更有本事。";
		mes "现在一切都和书上记载的一样。";
		mes "这样我们都安全了。";
		next;
		mes "[Cecilia]";
		mes "我们现在是一条船上的人，所以不用道谢，对吧？";
		next;
		mes "[Cecilia]";
		mes "我也去检查还有没有其他缺失的东西。";
		mes "奇怪的是，丢失的物品全都很普通。";
		mes "而且每种物品恰好都被偷了10个。";
		mes "我觉得这不只是盗窃。";
		close;
	case 2:
		switch( isbegin_quest(4257) ) {
		case 0:
			mes "[Cecilia]";
			if (isbegin_quest(4254) != 2 || isbegin_quest(4255) != 2) {
				mes "真奇怪……";
				mes "我明明整理好了一切，为什么这里这么乱。";
				mes "难道真的有人讨厌我……？";
				close;
			}
			mes "哦，对了，";
			mes "听说你见过艾琳和波旁。";
			next;
			mes "[Cecilia]";
			mes "听说艾琳胃痛，还听说你帮波旁找回了丢失的物品。";
			next;
			mes "- Cecilia seems to be lost in deep thought -";
			next;
			mes "[Cecilia]";
			mes "............";
			next;
			mes "[Cecilia]";
			mes "如果发生了以前从未发生过的事，那就说明有新情况。";
			next;
			mes "[Cecilia]";
			mes "现在，我们去查清楚是什么吧？";
			mes "当然，这次不是盗窃。";
			next;
			mes "[Cecilia]";
			mes "你能去问问艾琳和波旁读书的事吗？";
			mes "问问他们最近有没有借书或读书。";
			setquest 4257;
			setquest 4258;
			setquest 4259;
			close;
		case 1:
			if (isbegin_quest(4258) != 2 || isbegin_quest(4259) != 2) {
				mes "[Cecilia]";
				mes "你能去问问艾琳和波旁读书的事吗？";
				mes "问问他们最近有没有借书或读书。";
				close;
			}
			mes "["+ strcharinfo(0) +"]";
			mes "我见过他们两个了。";
			next;
			mes "^000088你告诉塞西莉亚艾琳和波旁说过的话。^000000";
			next;
			mes "[Cecilia]";
			mes "嗯，我明白了。";
			next;
			mes "[Cecilia]";
			mes "所以，他们最近也借书并读了书？";
			mes "很好，谜团解开了！";
			next;
			mes "[Cecilia]";
			mes "我也借了一些书，想了解米德加尔特的人，因为最近那里来了很多访客。";
			next;
			mes "[Cecilia]";
			mes "艾琳、波旁和我有一个共同点。";
			mes "那就是我们最近都读了书。";
			mes "但我不明白为什么这会给我们三人带来厄运。";
			completequest 4257;
			getexp 50000,0;
			next;
			mes "[Cecilia]";
			mes "我觉得多米尼克可能知道些什么。";
			mes "他也许知道……或者……";
			close;
		case 2:
			mes "[Cecilia]";
			switch( isbegin_quest(4260) ) {
			case 0:
				mes "艾琳、波旁和我有一个共同点。";
				mes "那就是我们最近都读了书。";
				mes "但我不明白为什么这会给我们三人带来厄运。";
				next;
				mes "[Cecilia]";
				mes "我觉得多米尼克可能知道些什么。";
				mes "他也许知道……或者……";
				close;
			case 1:
				mes "哦，你去过多米尼克那里吗？";
				mes "多米尼克负责照看书架，我觉得他可能知道些什么。";
				next;
				select("把多米尼克的事告诉塞西莉亚。" );
				mes "[Cecilia]";
				mes "............";
				next;
				mes "[Cecilia]";
				mes "所以我猜对了。";
				mes "这是某人的恶作剧。";
				mes "多米尼克一直都这么小气又奇怪。";
				next;
				mes "[Cecilia]";
				mes "希望你不要误会我们。";
				mes "艾克拉治的大多数居民——";
				mes "不，绝大多数居民都不反对外来者。";
				next;
				mes "[Cecilia]";
				mes "只是多米尼克的行为非常奇怪，希望你不要因此对我们抱有偏见。";
				next;
				mes "[Cecilia]";
				mes "不管怎样，既然我查清楚了，";
				mes "就不能再默默坐着！";
				next;
				mes "[Cecilia]";
				mes "我们开始计划报复吧？";
				mes "我会提前通知艾琳和波旁。";
				mes "你去和他们谈谈吧。";
				completequest 4260;
				getexp 100000,0;
				close;
			case 2:
				if (checkquest(4265) == -1) {
					mes "哦，作为仓库管理员，我也给你一些回报吧。";
					mes "你找回了失物，也到处帮了忙……就把它当作奖励吧。";
					next;
					mes "[Cecilia]";
					mes "我会向上级申请，让你可以阅读多米尼克负责的书架上的所有书。";
					next;
					mes "[Cecilia]";
					mes "这些书讲的是你的故乡，我相信你会喜欢。";
					mes "看待事物的角度改变，对它的评价也会改变。";
					mes "从我们的角度探索米德加尔特吧~！";
					setquest 4265;
					completequest 4265;
					close;
				}
				mes "你可以随意阅读广场书架上的书。";
				next;
				mes "[Cecilia]";
				mes "希望你在艾克拉治过得愉快。";
				mes "我现在要盘点，";
				mes "所以不能再和你聊天了，抱歉~";
				close;
			}
		}
	}
}

ecl_in01,80,77,5	script	Dominic#nk	4_M_FAIRYKID4,3,3,{
	mes "[Dominic]";
	switch( isbegin_quest(4260) ) {
	case 0:
		if (checkquest(4257) == 2) {
			mes "嗯……你想要什么？";
			mes "我不会阻止你在艾克拉治走动，但希望你别来烦我。";
			next;
			select("塞西莉亚说……" );
			mes "["+ strcharinfo(0) +"]";
			mes "塞西莉亚说，最近有人在捉弄借书的人。";
			next;
			mes "[Dominic]";
			mes "什么？呵呵呵。";
			mes "原则上，住在艾克拉治首都的人不该歧视外来者，但不是所有人都这样。";
			next;
			mes "[Dominic]";
			mes "我讨厌艾克拉治的人谈论米德加尔特。";
			mes "这里完美又和平，他们为什么对外国如此着迷？";
			next;
			mes "[Dominic]";
			mes "我不喜欢这里的妖精最近写米德加尔特，也讨厌那些书到处流传。";
			mes "所以我决定稍微捉弄他们一下。";
			next;
			mes "[Dominic]";
			mes "哼，想告诉他们就告诉吧！";
			mes "我一点也不害怕。";
			mes "他们应该知道我有多可怕。";
			setquest 4260;
			close;
		}
		mes "我不会阻止你在艾克拉治走动，但别来烦我，外来者！";
		close;
	case 1:
		mes "哼，想告诉他们就告诉吧！";
		mes "我一点也不害怕。";
		mes "他们应该知道我有多可怕。";
		close;
	default:
		mes "我觉得……有些不对劲。";
		mes "我感觉坏事随时都会发生……";
		close;
	}

OnTouch:
	if (isbegin_quest(4264) == 1) {
		mes "- 你想扔掉老鼠尾巴吗？-";
		next;
		if (select("不。：是。") == 2) {
			mes "- 老鼠尾巴还没落地就变成了一只老鼠。-";
			delitem 6562,1;// Tiny_Mouse_Tail
			completequest 4264;
			donpcevent "#call_ne::OnCall";
			getexp 300000,0;
			next;
			mes "[Dominic]";
			mes "什么，怎么突然冒出来了！";
			mes "肯定是米德加尔特的人带来的！";
			mes "你这个肮脏的小东西，啊！";
			next;
			mes "["+ strcharinfo(0) +"]";
		mes "（他的反应没那么有趣。）";
		}
		close;
	}
}

ecl_in01,79,84,0	script	#kusa	HIDDEN_WARP_NPC,3,3,{
	end;
OnTouch:
	if (isbegin_quest(4262) == 1) {
		mes "- 有人告诉你去种杂草。-";
		next;
		if (select("别这么做。：这么做。") == 2) {
			mes "- Plant weeds secretly . -";
			delitem 6563,1;// Weeds
			completequest 4262;
			donpcevent "#call_kusa::OnCall";
			getexp 300000,0;
			next;
			mes "[Dominic]";
			mes "喂，你在那里做什么？";
			mes "你最好别做什么奇怪的事。";
			next;
			mes "[Dominic]";
			mes "嗯……这是什么……";
			mes "为什么这里长着杂草？";
			next;
			mes "[Dominic]";
			mes "算了，我不在乎。";
			mes "我想根本没有‘杂草’这种东西。每种植物都有自己的特别之处。";
			next;
			mes "["+ strcharinfo(0) +"]";
		mes "（他的反应是怎么回事？）";
		}
		close;
	}
}


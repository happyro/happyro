function	script	PranksterDiag	{
	if (checkquest(4265) <= 1) {
		mes "- 你看到一本书，伸手去拿。你觉得那是关于米德加尔特的书。-";
		next;
		mes "[Dominic]";
		mes "喂，外来者，谁允许你碰我的书？";
		mes "离我的书架远点！";
		close;
	}
	return;
}

ecl_in01,80,86,4	script	Midgard Exploration#bok1	HIDDEN_NPC,{
	PranksterDiag;
	mes "- 你看到一本书，伸手去拿。你觉得那是关于卢恩·米德加尔兹城镇的书。-";
	next;
	while (1) {
		if (select("离书架远点。：看看书架。") == 1) {
			mes "["+ strcharinfo(0) +"]";
			mes "我不该读它。";
			close;
		}
		switch(rand(1,10)) {
		case 1:
			mes "卢恩·米德加尔兹的首都普隆德拉，到处都是精心设计的美丽建筑。";
			next;
			mes "那里有一位被称为‘国王’的领袖，过去还负责安排婚姻。";
			break;
		case 2:
			mes "那里有许多竞技场，战士们通过赛跑和摔跤互相较量。";
			next;
			mes "据说获胜者会得到某种奖励，但如今似乎已经不再流行。";
			break;
		case 3:
			mes "你要小心，因为普隆德拉有些人拥有超人的力量。";
			next;
			mes "他们几拳就能摧毁任何武器或护甲，而使用的只是一把小锤子。";
			next;
			mes "我不明白冒险者为什么总把工具放在他们脚边。难道他们是祭司，人们在向他们献祭？";
			break;
		case 4:
			mes "森林里有个叫斐扬的村庄。那里还有一处叫‘宫殿’的地方，不过用途不明。";
			next;
			mes "也许那是普隆德拉成为卢恩·米德加尔兹首都以前使用的地方……";
			break;
		case 5:
			mes "人类也会在居住区边界附近建立边境城镇，艾尔帕兰就是其中之一。";
			next;
			mes "村子中央的钟塔里住着钟表形状的怪物。还需要进一步调查怪物为何会出现在村子中央。";
			next;
			mes "虽然叫钟塔，但里面的怪物比钟还多。我亲自数过，真的数过！";
			break;
		case 6:
			mes "由伟大魔法师建造的吉芬，以城市中央的魔法师之塔为特色。";
			next;
			mes "说起来，普隆德拉中央有喷泉，艾尔帕兰有钟塔，吉芬也有塔。";
			next;
			mes "也许人类的城市规划基于对称或环形布局。我觉得不够精巧。";
			break;
		case 7:
			mes "依斯鲁得是港口城市，也是通往普隆德拉的门户。因为人类不会飞，他们乘坐大箱子旅行。";
			next;
			mes "我相信他们认为大箱子为文明做出了巨大贡献……但真是这样吗？";
			break;
		case 8:
			mes "艾尔贝塔是卢恩·米德加尔兹的人前往其他国家时会去的地方。";
			next;
			mes "那里有许多船——漂浮在水上的移动箱子——供人们乘坐。";
			next;
			mes "说真的，人类的能力……太令人失望了。足够聪明的话就该使用传送门。";
			break;
		case 9:
			mes "梦罗克村据说是梦罗克魔王休息的地方。";
			next;
			mes "在荒凉恶劣的沙漠中建造水道和湖泊……人类真是做出了不得了的工程。";
			next;
			mes "我觉得那里很和平……至少在怪物出现在埋葬他们领袖的建筑里之前。";
			break;
		case 10:
			mes "卢恩·米德加尔兹东边是大海，南边是沙漠，中间是森林和植被，北边是山脉。";
			next;
			mes "如果让孩子画一个世界，他们不是会画成这样吗？";
			next;
			mes "不过，那不是理想的地方，也不是适合居住的好地方。";
			break;
		}
		next;
	}
}

ecl_in01,82,84,4	script	Midgard Exploration#bok2	HIDDEN_NPC,{
	PranksterDiag;
	mes "- 你看到一本书，伸手去拿。你觉得那是关于卢恩·米德加尔兹城镇的书。-";
	next;
	while (1) {
		if (select("离书架远点。：看看书架。") == 1) {
			mes "["+ strcharinfo(0) +"]";
			mes "我不该读它。";
			close;
		}
		switch(rand(1,10)) {
		case 1:
			mes "人类常常从把生命投入未知的未来中获得巨大快乐。";
			next;
			mes "科莫多是人们为所谓的‘幸运’赌上未来的地方。不过这似乎与治理王国无关。";
			next;
			mes "‘女子和脚排球’、‘游戏排名委员会’等无法辨认的团体，取消了那座城市的游戏。";
			break;
		case 2:
			mes "科莫多曾是充满欢乐的海滨城市，可以找到各种娱乐。但现在是否还是这样，我就不知道了。";
			next;
			mes "那里有一位受村民敬仰的女祭司，她的存在似乎有充分理由。";
			next;
			mes "人们把钻石作为贡品献给她，她则回赠神明的礼物。不过想收到礼物似乎需要相当好的运气……";
			break;
		case 3:
			mes "首先，我想以对人类挑战精神的敬意开始这本书。";
			next;
			mes "在由巨树构成村庄的乌巴拉，有人因为各种原因挑战从高树上跳下。";
			next;
			mes "仔细想想真奇怪。我以为从树上跳下是人类男性的成年仪式，没想到还有别的理由。";
			break;
		case 4:
			mes "科莫多是这片大陆南部唯一的村庄。";
			next;
			mes "那么，帕罗斯灯塔是做什么的？";
			next;
			mes "进一步调查被推迟了，因为那里目前只有一名水手驻守，我也没找到政治或社会组织参与其中的证据。";
			break;
		case 5:
			mes "乘船可以到达名叫巴希亚的岛，那里有一座地下洞窟。";
			next;
			mes "岛上存在如此深长的洞窟，真是地理学上的谜团！";
			next;
			mes "而且，这里充满水，人类没有鳃却能呼吸，有学者能解释吗？";
			break;
		case 6:
			mes "普隆德拉是大城市，确保资源稳定供应非常重要。";
			next;

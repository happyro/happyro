					mes "决定哪家公司将";
					mes "提供地下城传送";
					mes "服务。可是，";
					mes "由于你已经投过票，不能在本次选举中再次投票。";
					next;
					mes "[卡普拉投票员]";
					mes "非常感谢你参与本次";
					mes "选举，";
					mes "也鼓励你在下一次选举中";
					mes "再次投票。";
					mes "谢谢，祝你今天愉快~";
				}
			}
			else {
				mes "[卡普拉投票员]";
				mes "抱歉，";
				mes "目前没有正在进行的选举。";
				mes "投票开放后，";
				mes "欢迎你参与";
				mes "并表达自己的意见。";
				mes "感谢你的支持~";
			}
		//}
		break;
	case 3:
		if ($DTS_Result == 2) {
		mes "[卡普拉投票员]";
		mes "感谢你选择";
		mes "地下城传送服务。";
		mes "请注意，免费传送券和";
		mes "卡普拉特别储备点数";
		mes "不适用于这项";
		mes "特殊服务。";
			next;
			if ($DTS_KafraWins == 0) {
					switch(select("玩具工厂，2 层 -> 4,000 Zeny:取消")) {
				case 1:
					if (Zeny >= 4000) {
						cutin "",255;
						set Zeny, Zeny-4000;
						warp "xmas_dun02",130,123;
						end;
					}
					else {
						mes "[卡普拉投票员]";
						mes "抱歉，你没有足够的";
						mes "资金";
						mes "支付 4,000 Zeny 的传送费";
						mes "前往玩具工厂。请";
						mes "再次检查你的资金。";
					}
					break;
				case 2:
					mes "[卡普拉投票员]";
					mes "我们卡普拉公司始终";
					mes "努力为你提供最优质的服务，希望满足你的冒险需求和卓越标准。";
					break;
				}
			}
			else if ($DTS_KafraWins == 1) {
					switch(select("玩具工厂，2 层 -> 4,000 Zeny:钟楼，3 层 -> 4,000 Zeny:取消")) {
				case 1:
					if (Zeny >= 4000) {
						set Zeny, Zeny-4000;
						cutin "kafra_09",255;
						warp "xmas_dun02",130,123;
						end;
					}
					else {
						mes "[卡普拉投票员]";
						mes "抱歉，你没有足够的";
						mes "资金";
						mes "支付 4,000 Zeny 的传送费";
						mes "前往玩具工厂。请";
						mes "再次检查你的资金。";
					}
					break;
				case 2:
					if (Zeny >= 4000) {
						set Zeny, Zeny-4000;
						cutin "kafra_09",255;
						warp "alde_dun03",265,22;
						end;
					}
					else {
						mes "[卡普拉投票员]";
						mes "抱歉，你没有足够的";
						mes "资金支付 4,000 Zeny 的传送费";
						mes "前往钟楼。请";
						mes "再次检查你的资金。";
					}
					break;
				case 3:
					mes "[卡普拉投票员]";
					mes "我们卡普拉公司始终努力";
					mes "为你提供最优质的服务，希望满足你的冒险需求和卓越标准。";
					break;
				}
			}
			else {
						switch(select("玩具工厂，2 层 -> 4,000 Zeny:钟楼，3 层 -> 4,000 Zeny:熔岩洞，2 层 -> 4,000 Zeny:取消")) {
				case 1:
					if (Zeny >= 4000) {
						set Zeny, Zeny-4000;
						cutin "kafra_09",255;
						warp "xmas_dun02",130,123;
						end;
					}
					else {
						mes "[卡普拉投票员]";
						mes "抱歉，你没有足够的";
						mes "资金";
						mes "支付 4,000 Zeny 的传送费";
						mes "前往玩具工厂。请";
						mes "再次检查你的资金。";
					}
					break;
				case 2:
					if (Zeny >= 4000) {
						set Zeny, Zeny-4000;
						cutin "kafra_09",255;
						warp "alde_dun03",265,22;
						end;
					}
					else {
						mes "[卡普拉投票员]";
						mes "抱歉，你没有足够的";
						mes "资金";
						mes "支付 4,000 Zeny 的传送费";
						mes "前往钟楼。请";
						mes "再次检查你的资金。";
					}
					break;
				case 3:
					if (Zeny >= 4000) {
						set Zeny, Zeny-4000;
						cutin "kafra_09",255;
						warp "mag_dun02",47,40;
						end;
					}
					else {
						mes "[卡普拉投票员]";
						mes "抱歉，你没有足够的";
						mes "资金";
						mes "支付 4,000 Zeny 的传送费";
						mes "前往熔岩洞。请";
						mes "再次检查你的资金。";
					}
					break;
				case 4:
					mes "[卡普拉投票员]";
					mes "我们卡普拉公司始终努力";
					mes "为你提供最优质的服务，希望满足你的冒险需求和卓越标准。";
					break;
				}
			}
		}
		else if ($DTS_Result == 1) {
			mes "[卡普拉投票员]";
			mes "抱歉，由于最近一次选举的结果，";
			mes "目前由酷暑活动公司负责";
			mes "地下城传送服务。";
			mes "给你带来不便，";
			mes "敬请谅解。";
		}
		else {
			mes "[卡普拉投票员]";
			mes "抱歉，地下城";
			mes "传送服务在投票期间";
			mes "不会开放。";
			mes "选举结束后，";
			mes "地下城传送服务将恢复";
			mes "并重新开放。";
		}
		break;
	case 4:
		mes "[卡普拉投票员]";
		mes "我们卡普拉公司始终努力";
		mes "为你提供最优质的服务，希望满足你的冒险需求和卓越标准。";
		break;
	}
	close2;
	cutin "",255;
	end;
}


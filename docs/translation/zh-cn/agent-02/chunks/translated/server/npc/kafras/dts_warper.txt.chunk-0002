		mes "能成为地下城传送服务的提供者。";
		mes "因此，我们将通过选举让客户决定。";
		next;
		mes "[酷暑活动公司投票员]";
		mes "我们会举行多次选举，";
		mes "让客户亲自体验各公司的特殊服务。";
		mes "不过请注意，必须符合资格才能投票。";
		next;
		mes "[酷暑活动公司投票员]";
		mes "关于投票资格的详情，";
		mes "请访问位于施瓦茨瓦尔德共和国";
		mes "拉赫的总部。";
		mes "感谢你的时间。";
		break;
	case 2:
		//if (lhz_boss < 17) {
		//	mes "[酷暑活动公司投票员]";
		//	mes "I'm sorry, but you are not";
		//	mes "eligible to vote at this time.";
		//	mes "Please visit our headquarters";
		//	mes "in Lighthalzen for information";
		//	mes "related to acquiring voting rights. Thank you for your time.";
		//	close2;
		//	cutin "zonda_01",255;
		//	end;
		//}
		//else {
			if ($DTS_Result == 0) {
				if (lhz_vote <= $DTS_VoteCount) {
					mes "[酷暑活动公司投票员]";
					mes "酷暑活动公司若被选中";
					mes "提供地下城传送服务，";
					mes "将把冒险者传送到";
					mes "以下地下城……";
					next;
					mes " ";
					mes " ";
					if ($DTS_JondaWins == 0) {
						mes "^FF0000Byalan Dungeon, Level 3^000000";
					}
					else if ($DTS_JondaWins == 1) {
						mes "^FF0000Byalan Dungeon, Level 3^000000";
						mes "^FF0000Clock Tower, 3rd Floor^000000";
					}
					else {
						mes "^FF0000Byalan Dungeon, Level 3^000000";
						mes "^FF0000Clock Tower, 3rd Floor^000000";
						mes "^FF0000Glast Heim Entrance^000000";
					}
					next;
					mes "[酷暑活动公司投票员]";
					mes "如果你对这些目的地感兴趣，";
					mes "投票给我们会更符合你的利益。";
					mes "你想投票给";
					mes "酷暑活动公司吗？";
					next;
					switch(select("否:是")) {
					case 1:
						mes "[酷暑活动公司投票员]";
						mes "啊，我明白了……如果你";
						mes "改变主意，欢迎回来";
						mes "投票给酷暑活动公司，";
						mes "好吗？祝你今天愉快~";
						break;
					case 2:
						set lhz_vote,$DTS_VoteCount+1;
						set $DTS_JondaVotes,$DTS_JondaVotes+1;
						mes "[酷暑活动公司投票员]";
						mes "感谢你的投票！";
						mes "正是像你这样的客户，";
						mes "确保了酷暑活动公司的成功与优质服务。";
						mes "感谢你，祝你今天愉快~";
						break;
					}
				}
				else {
					mes "[酷暑活动公司投票员]";
					mes "抱歉，你已经在本次选举中";
					mes "投过票了。不过，";
					mes "下次选举仍欢迎你";
					mes "投票给酷暑活动公司~";
				}
			}
			else if ($DTS_Result == 3) {
				if (lhz_vote <= $DTS_VoteCount) {
					mes "[酷暑活动公司投票员]";
					mes "很遗憾，上次选举的";

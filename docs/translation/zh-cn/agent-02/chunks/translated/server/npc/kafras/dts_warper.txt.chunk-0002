					mes "[酷暑活动公司投票员]";
					mes "很遗憾，上次选举的投票人数不足，";
					mes "所以我们再次举行选举，";
					mes "以决定哪家公司提供";
					mes "地下城传送服务。";
					next;
					mes "[酷暑活动公司投票员]";
					mes "感谢你已经参与第二次选举，";
					mes "并投出了自己的票。";
					mes "谢谢你的支持~";
				}
			}
			else {
				mes "[酷暑活动公司投票员]";
				mes "抱歉，目前没有举行选举。";
				mes "请在下一次选举中前来投票，决定哪家公司提供";
				mes "地下城传送服务。";
			}
		//}
		break;
	case 3:
		if ($DTS_Result == 1) {
			mes "[酷暑活动公司投票员]";

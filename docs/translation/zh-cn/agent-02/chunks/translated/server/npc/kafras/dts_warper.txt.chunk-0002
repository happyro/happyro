-	script	Cool Event Staff::VotingStaffCCE	874,{
	callfunc "F_ClearGarbage";				//Clear outdated, unused variables
	cutin "zonda_01",2;
	mes "[酷暑活动公司投票员]";
	mes "你好！别忘了发出你的声音，";
	mes "务必在酷暑活动公司与";
	mes "卡普拉公司争夺地下城传送服务控制权的选举中投票！";
	next;
	switch(select("选举缘由:投票:使用传送服务:取消")) {
	case 1:
		mes "[酷暑活动公司投票员]";
		mes "酷暑活动公司一直计划";

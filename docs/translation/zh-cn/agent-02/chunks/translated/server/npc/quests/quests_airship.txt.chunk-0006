			mes "那你是船员之一吗？";
			mes "我想我们以前没见过，";
			mes "而且我应该已经熟悉";
			mes "这里工作的每个人了……";
			next;
			emotion ET_SURPRISE;
			mes "[Hallen]";
			mes "嘿……！";
			mes "如果你在值班，";
			mes "不应该穿制服吗？";
			mes "看来你果然不在这里工作！";
			mes "嘿，我自己想明白了~";
			next;
			mes "[Hallen]";
			mes "嗯，我得先扫完甲板。";
			mes "然后休息时，";
			mes "我可以和 Kaci 玩小游戏";
			mes "赢苹果。";
			mes "我就是这样，伙计。";
			break;
		case 2:
			mes "[Hallen]";
			mes "嗯……这不是很明显吗？";
			mes "我在扫甲板。我是";
			mes "最年轻的船员，";
			mes "所以总被安排最无聊的";
			mes "工作。不过做完后就能";
			mes "和 Kaci 玩骰子了。哦耶~";
			break;
		}
		next;
		select("Kaci？");
		mes "[Hallen]";
		mes "Kaci……就是那个";
		mes "骰子游戏的庄家？";
		mes "你应该试试：掷骰子";
		mes "就有机会赢苹果。嘿，";
		mes "你可能会走大运！";
		next;
		mes "[Hallen]";
		mes "嘿，有个人从 Kaci 那里";
		mes "赢了很多苹果，";
		mes "最后成了苹果商人。";
		mes "你敢相信吗？是的……";
		mes "Kaci 不太喜欢他……";
		close2;
		lhz_heart = 1;
		end;
	} else if (lhz_heart == 1) {
		mes "哦，嘿，是你~";
		mes "我们之前聊过，";
		mes "对吧？是的……";
		mes "我还在扫地板。";
		mes "还要花不少时间。";
		next;
		emotion ET_SURPRISE;
		mes "[Hallen]";
		mes "看来我很快完不成。";
		mes "嘿，既然我不能离开这里，";
		mes "你能不能";
		mes "帮我一个忙？";
		next;
		switch(select("抱歉，我很忙……:什么事？")) {
		case 1:
			mes "[Hallen]";
			mes "嗯，好吧。我能理解。";
			mes "不过，如果你懂我的意思，";
			mes "我本来可以让你";
			mes "觉得这趟很值得~";
			close;
		case 2:
			mes "[Hallen]";
			mes "别担心，工作不多。";
			mes "我本该把朱诺机场的信";
			mes "交给其他船员，但没时间。";
			mes "现在，我这里有一封";
			mes "给 Kaci 的信……";
			next;
			mes "[Hallen]";
			mes "你能替我把这封信";
			mes "交给她吗？";
			mes "寄信的人叫 Mawong 先生，";
			mes "好像是她的导师之类的。";
			next;
		mes "^3355FFHallen 把 Mawong 的信";
		mes "交给你，让你转交 Kaci。^000000";
			setquest 8036;
			lhz_heart = 2;
			next;
			mes "[Hallen]";
			mes "嘿，非常感谢，朋友~";
			mes "你可以在飞艇上找到";
			mes "主持骰子游戏的 Kaci。";
			close;
		}
	} else if (lhz_heart == 2) {
		mes "^333333*Sigh...*^000000";
		mes "我真是又累又烦";
		mes "一直扫地。";
		mes "简直像个";
		mes "没用的小舱童。";
		mes "不过……我确实是！";
		next;
		mes "[Hallen]";
		mes "哦，嘿，你把那封信";
		mes "交给 Kaci 了吗？";
		mes "我觉得它很重要，";
		mes "所以别花太久时间，";
		mes "好吗？";
		mes " ";
	} else if (lhz_heart == 3) {
		mes "^333333*Sigh...*^000000";
		mes "我真是又累又烦";
		mes "一直扫地。";
		mes "简直像个没用的小舱童。";
		mes "不过……我确实是！";
	} else if (lhz_heart == 4) {
		mes "嘿，谢谢你替我";
		mes "把信交给 Kaci。";
		mes "她不太高兴我让乘客帮忙，";
		mes "但她也明白";
		mes "我的工作忙得不可开交。";
		next;
		mes "[Hallen]";
		mes "你不觉得";
		mes "人们应该在危机时刻";
		mes "互相帮助吗？";
		next;
		switch(select("Not at all. Every man for himself!:Yes, I do.")) {
		case 1:
			mes "[Hallen]";
			mes "什、什么……？";
			mes "我真没想到";
			mes "你居然会";
			mes "这么想……";
			lhz_heart = 5;
			changequest 8038,8039;
			close;
		case 2:
			mes "[Hallen]";
			mes "啊，真的吗？";
			mes "我就知道你和我";
			mes "想法一样。";
			mes "你和我，我们在同一波长上~";
			next;
			if (checkweight(501,1) != 1) {
				mes "[Hallen]";
				mes "哦……嘿，我本来";
				mes "想给你点东西，";
				mes "但你现在带的";
				mes "东西太多了……";
				close;
			}
			lhz_heart = 5;
			getitem 501,1;// Red_Potion
			mes "[Hallen]";
			mes "我知道这不算什么，";
			mes "但我想把它给你。";
			mes "而且，紧急时刻";
			mes "总会派上用场。";
			mes "那么，回头见~";
			close;
		}
	} else if (lhz_heart == 5) {
		mes "嘿，嘿~最近怎么样？";
		mes "我知道，我知道，我本该扫地，";
		mes "但还没扫完。不过有时，";
		mes "你知道的，总得";
		mes "休息一下，对吧？";
		next;
		mes "[Hallen]";
		mes "啊，这样忙碌的日子";
		mes "让我想起在朱诺老家";
		mes "和邻居 Gyver 一起工作。";
		mes "他是天才发明家，";
		mes "对我来说像英雄";
		mes "或榜样一样。";
		next;
		mes "[Hallen]";
		mes "Guyver 非常聪明，";
		mes "几乎什么都能制造。";
		mes "有一天，我也想达到他的水平，";
		mes "创造帮助人们";
		mes "并让他们开心的东西。";
		next;
		mes "[Hallen]";
		mes "这就是我的人生志向——";
		mes "也就是我想为世界";
		mes "贡献的东西。当然，";
		mes "我怀疑自己能否比得上";
		mes "伟大的贤者 Varmunt。";
		next;
		select("Sage Varmunt?");
		mes "[Hallen]";
		mes "是的，Varmunt……他是";
		mes "历史上最伟大的贤者之一。";
		mes "没人太了解他，但 300 年前，";
		mes "他完成了许多";
		mes "划时代的成就。";
		next;
		mes "[Hallen]";
		mes "据说他凭一己之力革新了科学。";
		mes "如今许多便利生活的机器";
		mes "都是他的发明。";
		mes "遗憾的是，他从历史中消失，没人知道他去了哪里。";
		next;
		mes "[Hallen]";
		mes "伟大的贤者 Varmunt……";
		mes "这是施瓦茨瓦尔德共和国";
		mes "广为人知的传说。";
		mes "总之，为了我的项目，";
		mes "我想更多了解这些飞艇。";
		next;
		mes "[Hallen]";
		mes "这些飞艇又大又重，";
		mes "我很难相信它们能飞。";
		mes "这究竟是怎么做到的？";
		mes "如果你能替我查清楚，";
		mes "那就帮大忙了。";
		if (isbegin_quest(8039) == 0)
			changequest 8038,8039;
		lhz_heart = 6;
	} else if (lhz_heart == 6) {
		mes "嘿，你查到这么大、这么重的飞艇";
		mes "为什么能长时间";
		mes "飞在天空中了吗？";
		next;
		if (lght_air == 7) {
			select("Umm, yeah, kind of.");
			mes "[Hallen]";
			mes "真的吗……？";
			mes "你是认真的吗？";
			mes "秘密是什么？";
			mes "快告诉我，我太想知道了！";
			next;
			mes "^3355FFYou tell Hallen everything";
			mes "你从 Tarlock 船长那里了解到，";
			mes "但你小心地没有提及";
			mes "伊米尔之心碎片。^000000";
			next;
			mes "[Hallen]";
			mes "所以……螺旋桨";
			mes "是由蒸汽驱动的？";
			mes "这说不通。";
			mes "不可能这么简单，而且蒸汽也有局限。";
			mes "你确定这就是全部吗？";
			next;
			select("Actually, there's another power source.");
			mes "^3355FF你说出你";
			mes "了解了符文石，";
			mes "一种伊米尔之心碎片的仿制品。";
			mes "Hallen 是个善良的孩子，";
			mes "应该不会将这些知识";
			mes "用于邪恶目的。";
			next;
			mes "[Hallen]";
			mes "太、太棒了！原来有某种";
			mes "特殊魔力来源帮助飞艇飞行！";
			mes "我就知道！它叫什么来着？";
			mes "啊，是符文石，对吧？";
			next;
			mes "[Hallen]";
			mes "模仿伊米尔之心的";
			mes "碎片。这个我以前";
			mes "在哪里听过？";
			mes "嗯，让我想想……";
			changequest 8039,8040;
			lhz_heart = 7;
		} else {
			select("Actually...");
			mes "[Hallen]";
			mes "你还没了解到飞艇的任何信息，对吧？";
			mes "也许 Ferlock 船长或其他飞艇船长";
			mes "知道些什么。";
			mes "希望有人能告诉你……";
			next;
			mes "[Hallen]";
			mes "我知道飞艇飞行的秘密属于机密，";
			mes "但如果有人能揭开它，";
			mes "一定是你们这些冒险者。";
			mes "所以请帮帮我……";
		}
	} else if (lhz_heart == 7) {
		mes "所以符文石";
		mes "只是伊米尔之心";
		mes "的一块仿制品。";
		mes "但我以前在哪里";
		mes "听过这个名字……？";
		next;
		emotion ET_SURPRISE;
		mes "[Hallen]";
		mes "哦，对了！";
		mes "Kaci 告诉过我一个";
		mes "酒鬼，他玩苹果骰子游戏时";
		mes "总会提到伊米尔之心！";
		next;
		if (Shinokas_Quest > 9) {
			mes "["+strcharinfo(0)+"]";
			mes "（^333333等等，我在";
			mes "我曾帮助 Shinokas。";
			mes "他是艾因布罗赫实验室的";
			mes "一名主管，那里有一块";
			mes "伊米尔之心碎片。";
			mes "值得调查……^000000）";
			next;
		}
		mes "[Hallen]";
			mes "总之，这不算什么，";
			mes "但感谢你费心";
			mes "为我调查机密信息，";
			mes "让我送你一点东西……";
		next;
		if (checkweight(501,1) != 1) {
			mes "[Hallen]";
				mes "哎呀，糟糕……";
				mes "你的背包没有足够空间";
				mes "收下我的小礼物。";
				mes "请腾出更多空间，好吗？";
			close;
		}
		if (Shinokas_Quest > 9) {
			lhz_heart = 9;
			changequest 8040,8042;
		} else {
			lhz_heart = 8;
			changequest 8040,8041;
		}
		getitem 501,1;
		mes "[Hallen]";
		mes "给你~";
		mes "我知道和你们冒险者";
		mes "通常得到的奖励相比很少，";
		mes "但心意才是最重要的，对吧？";
		mes "回头见~";
	} else if (lhz_heart == 8) {
		mes "嘿，你为什么不问问 Kaci";
		mes "那个总是玩骰子游戏的";
		mes "酒鬼？";
		mes "你也许能更多了解";
		mes "伊米尔之心碎片。";
	} else {
		mes "谢谢你上次帮我。";
		mes "了解符文石让我受到启发，";
		mes "也许有一天我会";
		mes "建造属于自己的飞艇……";
	}
	close;
}

airplane,33,69,4	script	Kaci	1_F_MERCHANT_01,{
	mes "[Kaci]";

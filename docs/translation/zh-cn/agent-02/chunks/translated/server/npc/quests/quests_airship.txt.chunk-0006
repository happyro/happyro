				mes "不用客气~";
				next;
			}
			switch(select("Ask about Hallen:Ask about Mawong:Ask about the Airship")) {
			case 1:
				.@a = 1;
				mes "[Kaci]";
				mes "Hallen？嗯，我和他是";

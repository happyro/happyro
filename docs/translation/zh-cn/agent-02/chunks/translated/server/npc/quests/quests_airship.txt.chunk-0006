		next;
		mes "[Kaci]";
		mes "哦……天哪……真不敢相信 Euslan 生病了……哦……";
		next;
		mes "- 这样的坏消息似乎让 Kaci 震惊了。-";
		mes "- 她喃喃自语了一会儿，才恢复意识。-";
		next;
		mes "[Kaci]";
		mes "我很为她难过……我真的想帮忙……但我已经很久没见他们了，所以不知道他在哪里。";
		next;
		mes "[Kaci]";
		mes "不过，让我想想……";
		next;
		mes "[Kaci]";
		mes "哦，对了！飞艇船长也许能帮你，因为他负责乘客名单。";
		next;
		mes "[Kaci]";
		mes "虽然乘客名单属于机密，严格禁止公开……";
		next;
		mes "[Kaci]";
		mes "但如果你把事情告诉他，他也许能帮忙。请去问问他。";
		next;
		mes "[Kaci]";
		mes "如果你再次见到 Euslan，请替我向她致意并送上祝福。";
		next;
		mes "- 你答应替她向 Euslan 致意并送上祝福。-";
		changequest 8044,8045;
		hg_ma1 = 4;
	} else if (hg_ma1 == 4)
		mes "飞艇船长也许能帮你找到 Thierry 的下落。";
	else if (lhz_heart == 2) {
		mes "你一定很无聊，冒险者~";
		mes "想玩一局骰子游戏吗？";
		next;
		select("把 Hallen 的信交给她。");
		mes "[Kaci]";
		mes "哦，一定是 Hallen";
		mes "让你来送这封信。";
		mes "这种事他应该自己做，";
		mes "不该麻烦客人！";
		mes "不过，他确实很忙……";
		next;
		changequest 8036,8037;
		lhz_heart = 3;
		mes "[Kaci]";
		mes "谢谢你把它带给我。";
		mes "如果以后需要我";
		mes "帮一点小忙，";
		mes "尽管来找我，好吗？回头见~";
	} else if (lhz_heart == 3) {
		mes "哦，你好。谢谢你把";
		mes "Mawong 先生的信交给我，";
		mes "尤其是 Hallen 太忙";
		mes "没法亲自送来。";
		mes "读到那封信让我非常开心~";
		next;
		while (.@a == 0 || .@b == 0 || .@c == 0) {

//============================================================

moc_para01,25,35,4	script	Instructor Boya#para01	4_M_KNIGHT_GOLD,{
	mes "[博雅]";
	if (!callfunc("F_HasEdenGroupMark")) {
		mes "你不属于我的团队，对吧？";
		mes "我没什么要和外人说的。";
		mes "想要什么就先加入我的团队。";
		next;
		mes "[博雅]";
		mes "想登记加入伊甸园集团，就去问我旁边的莱姆·伊维诺。";
		close;
	}
	if (para_suv01 == 0) {
		mes "怎么了？";
		mes "普通任务请使用公告板。";
		next;
		switch (select("你的职责是什么？：你没有装备吗？：无视。")) {
			mes "[博雅]";
		case 1:
			mes "我给成员发布训练任务。";
			mes "所以他们会参加。";
			mes "如果不想遇到麻烦，这些训练很重要。";
			next;
			mes "[博雅]";
			mes "通过战斗训练，他们可以提升实战经验。";
			mes "证明自己的成员甚至能获得奖励。";
			next;
			mes "[博雅]";
			mes "我们给他们发放亲手制作的特殊装备。";
			mes "这些礼物属于真正努力的人。";
			next;
			mes "[博雅]";
			mes "如果你感兴趣，可以参加。";
			mes "战斗训练课程并不难。";
			mes "没什么好担心的。";
			next;
			mes "[博雅]";
			mes "想参加就别犹豫。";
			next;
			switch (select("参加训练：无视。")) {
				mes "[博雅]";
			case 1:
				callsub S_Quest1;
				callsub S_Quest2;
				callsub S_Quest3;
			case 2:
				mes "一切由你决定。";
				mes "虽然与我无关，但你最好重新考虑。";
				close;
			}
		case 2:
			mes "咦？";
			mes "你真诚实！";
			mes "天啊。你想了解装备吗？";
			next;
			mes "[博雅]";
			mes "我有一套供团队成员免费使用的制服。";
			mes "但我不能直接免费送给你。";
			next;
			mes "[博雅]";
			mes "我们会把它给训练中表现优秀、努力奋斗的参加者。";
			next;
			mes "-博雅从头到脚打量着你。";
			mes "嗯……他似乎觉得哪里不对劲。-";
			next;
			mes "[博雅]";
			mes "因为情绪。";
			next;
			select("什么？！");
			mes "[博雅]";
			mes "那么，你到底参加不参加训练？";
			mes "我看起来有点滑稽？其实我很忙，我可是闪耀的符文骑士。";
			mes "快做决定。";
			next;
			switch (select("参加训练：拒绝！！")) {
				mes "[博雅]";
			case 1:
				callsub S_Quest1;
				callsub S_Quest2;
				callsub S_Quest3;
			case 2:
				mes "你太无礼了！";
				specialeffect2 EF_HIT1;
				percentheal -50,0;
				next;
				mes "-他快速挥拳，闪耀的符文骑士变得隐形。";
				mes "太痛了-";
				close;
			}
		case 3:
			mes "别烦我。";
			close;
		}
	}
	else if (para_suv01 < 5) {
		mes "嘿，我已经把所有训练区域都讲过了。";
		mes "我再解释一遍，请集中注意力。";
		next;
		mes "[博雅]";
		mes "梦罗克东南方的一片绿洲。";
		mes "中央有一只大狗。";
		mes "详细内容写在日志里，看到了吗？";
	}
	else if (para_suv01 == 5) {
		mes "哦，你回来了。";
		mes "做得好。";
		mes "现在你已经适应了。";
		next;
		mes "[Boya]";
		mes "完成第1步。";
		mes "恭喜。";
		mes "我们会给你制服和一些装备。";
		next;
		mes "[Boya]";
		mes "你看到公告板旁边的大蓝门了吗？";
		mes "进去后沿右侧通道一直走到尽头，那里有装备仓库。";
		next;
		mes "[Boya]";
		mes "告诉管理员是我派你来的。他会给你一些东西。";
		mes "去吧去吧去吧！";
		para_suv01 = 11;
		completequest 7132;
	}
	else if (para_suv01 < 10) {
		mes "训练名称是“征服下水道！”。";
		mes "你已经完整探索下水道了吗？";
		next;
		mes "[Boya]";
		mes "完成当地训练师的所有课程后再回来。";
	}
	else if (para_suv01 == 10) {
		mes "哦，你回来了。";
		mes "做得好。";
		mes "现在你已经适应了。";
		next;
		mes "[Boya]";
		mes "完成第1步。";
		mes "恭喜。";
		mes "我的团队会给你制服和一些装备。";
		next;
		mes "[Boya]";
		mes "你看到公告板旁边的大蓝门了吗？";
		mes "进去后沿右侧通道一直走到尽头，那里有装备仓库。";
		next;
		mes "[Boya]";
		mes "告诉管理员是我派你来的。他会给你一些东西。";
		mes "去吧去吧去吧！";
		para_suv01 = 11;
		completequest 7137;
	}
	else if (para_suv01 == 11) {
		mes "你在做什么？";
		mes "去仓库管理员那里领取装备。";
		mes "我们的制服很帅，哈哈。";
	}
	else if (para_suv01 == 12) {
		mes "嗯，你喜欢这些补给吗？";
		mes "我喜欢红帽子。";
		mes "红色缎带真可爱。";
		next;
		mes "[Boya]";
		if (BaseLevel > 25) {
			mes "而且你似乎……";
			mes "现在可以参加进阶课程了。";
			mes "怎么样，你想参加吗？";
			next;
			switch (select("不可能：当然，我要参加。")) {
				mes "[Boya]";
			case 1:
				mes "真的吗？";
				mes "其实我不在乎，不过制服会换成进阶款式。";
				close;
			case 2:
				mes "很好。";
				mes "让我为你选择合适的地点。";
				next;
				mes "[Boya]";
				callsub S_Quest2;
				callsub S_Quest3;
			}
		}
		else {
			mes "战斗训练分为多个步骤。";
			mes "达到等级后可以参加下一步训练，再升级后回来吧。";
			next;
			mes "[Boya]";
			mes "下一步训练对等级26以上的冒险者开放。";
			mes "达到那个等级后再来。明白了吗？";
		}
	}
	else if (para_suv01 < 16) {
		mes "训练区域在斐扬北部洞窟。";
		mes "我们已经派了一名工作人员在那里。";
		mes "找到他并听从他的指示。";
	}
	else if (para_suv01 == 16) {
		mes "你完成了第二步训练。";
		mes "现在你明白这个世界是如何组织的吗？";
		next;
		mes "[Boya]";
		mes "我会证明你完成了训练。";
		mes "装备仓库负责人会提供你所需的物品。";
		next;
		mes "[Boya]";
		mes "选择适合你技能组合的装备。";
		para_suv01 = 22;
		completequest 7141;
	}
	else if (para_suv01 < 21) {
		mes "训练区域在梦罗克西南方。";
		mes "进入圣达尔梅因要塞即可直接抵达。";
		next;
		mes "[Boya]";
		mes "那里有个人叫……呃……他会等你并指导你。";
	}
	else if (para_suv01 == 21) {
		mes "你完成了第二步训练。";
		mes "现在你明白这个世界是如何组织的吗？";
		next;
		mes "[Boya]";
		mes "我会证明你完成了训练。";
		mes "装备仓库负责人会提供你所需的物品。";
		para_suv01 = 22;
		completequest 7146;
	}
	else if (para_suv01 == 22) {
		mes "通过第二步训练后，我们会为学员提供装备和防具。";
		mes "去仓库找负责人。";
		next;
		mes "[Boya]";
		mes "要找仓库，穿过任务公告板旁的蓝门，然后走到走廊右侧尽头。";
	}
	else if (para_suv01 == 23) {
		mes "嘿，好久不见。";
		mes "怎么了？";
		next;
		switch (select("我想参加训练：没事。")) {
			mes "[Boya]";
		case 1:
			mes "嗯……真的吗？";
			mes "让我看看……哪一步适合你……";
			next;
			mes "[Boya]";
			if (BaseLevel < 40) {
				mes "非常抱歉，参加这项训练至少需要等级40。";
				mes "努力提升等级后再回来。";
				close;
			}
			callsub S_Quest3;
		case 2:
			mes "你是来看我的吗？";
			mes "就这样？什么也没带？";
			mes "至少也可以带点巧克力……";
			next;
			mes "[Boya]";
			mes "香蕉卷或条纹草莓……什么都行。";
			mes "哦，我不吃肉桂零食……";
			close;
		}
	}
	else if (para_suv01 < 28) {
		mes "嗯。兽人村有卡普拉职员，你可以使用卡普拉服务。";
		next;
		mes "[Boya]";
		mes "我们派出的一名成员正在卡普拉职员附近的建筑里等你。";
	}
	else if (para_suv01 == 28) {
		mes "很好！你通过了第三步训练。";
		mes "我会证明你完成了训练。";
		mes "装备仓库负责人会提供一些装备。";
		next;
		mes "[Boya]";
		mes "通过第二步训练后，我们会为学员提供装备和防具。";
		mes "去仓库找负责人。";
		next;
		mes "[Boya]";
		mes "要找仓库，穿过任务公告板旁的蓝门，然后走到走廊右侧尽头。";
		para_suv01 = 37;
		completequest 7151;
	}
	else if (para_suv01 < 32) {
		mes "嗯。兽人村有卡普拉职员，你可以在那里使用卡普拉服务。";
		next;
		mes "[Boya]";
		mes "我们派出的一名成员正在卡普拉职员附近的建筑里等你。";
	}
	else if (para_suv01 == 32) {
		mes "很好！你通过了第三步训练。";
		mes "我会证明你完成了训练。";
		mes "装备仓库负责人会提供一些装备。";
		next;
		mes "[Boya]";
		mes "通过第二步训练后，我们会为学员提供装备和防具。";
		mes "去仓库找负责人。";
		next;
		mes "[Boya]";
		mes "要找仓库，穿过任务公告板旁的蓝门，然后走到走廊右侧尽头。";
		para_suv01 = 37;
		completequest 7155;
	}
	else if (para_suv01 < 36) {
		mes "先从依兹路得乘船前往海底洞穴！";
		mes "那里有一座地下洞窟。进去并到达最底层，你会找到一座历史悠久的海底城市……";
		next;
		mes "[Boya]";
		mes "海底城市入口附近有一名派遣学员。";
	}
	else if (para_suv01 == 36) {
		mes "很好！你通过了第三步训练。";
		mes "我会证明你完成了训练。";
		mes "装备仓库负责人会提供一些装备。";
		next;
		mes "[Boya]";
		mes "通过第二步训练后，我们会为学员提供装备和防具。";
		mes "去仓库找负责人。";
		next;
		mes "[Boya]";
		mes "要找仓库，穿过任务公告板旁的蓝门，然后走到走廊右侧尽头。";
		para_suv01 = 37;
		completequest 7159;
	}
	else if (para_suv01 == 37) {
		mes "[Boya]";
	mes "完成所有步骤后去领取补给。";
	mes "我们会为完成训练的人提供装备。";
		next;
		mes "[Boya]";
	mes "我们也许还能提供其他东西。";
	mes "有疑问就询问军械库负责人。";
		next;
		mes "[Boya]";
	mes "军械库在蓝门后、通道右侧尽头。";
	}
	else if (para_suv01 >= 38) {
		mes "我的老板设计了所有训练课程。";
		mes "他制作制服和补给后改变了主意，说不能免费送出。";
		next;
		mes "[Boya]";
		mes "为我的团队和世界付出努力的人可以获得补给。";
		mes "所以才设立了这些课程。";
		next;
		mes "[Boya]";
		mes "原则上这些补给是给初心者的";
		mes "但专家想参加训练，我们也会接受。";
		next;
		mes "[Boya]";
		mes "虽然制服和装备可能没什么用，";
		mes "参加训练就代表他们想成为我们团队的一员。";
		next;
		mes "[Boya]";
		mes "是的，就这些。";
		mes "所以决定帽子设计时非常困难。";
		next;
		mes "[Boya]";
		mes "使用装备时记住这一点。";
		mes "但如果你决定出售或交易它们，那就与我们无关。";
	}
	else {
		mes "你想要什么？";
		mes "我怀疑你还需要更多训练。";
		next;
		mes "[Boya]";
		mes "像你这样的战斗大师，已经没有什么可教了。";
	}
	close;
S_Quest1:
	mes "真的吗？你看起来已经准备好了。";
	mes "训练总共有3个步骤。";
	mes "让我看看……";
	next;
	mes "[Boya]";
	if (BaseLevel < 12) {
		mes "嗯。你应该再提升等级！";
		mes "你至少需要达到等级12！";
		mes "抱歉，但规定就是这样。";
		close;
	}
	if (BaseLevel < 20) {
		mes "第一步是A课程。";
		mes "A课程叫“征服沙漠！”。";
		mes "这是最适合你等级的任务。";
		next;
		mes "[Boya]";
		mes "^4d4dff有一座名为梦罗克的沙漠城镇。";
		mes "从那里向南再向东走。那片区域中央有一小片绿洲。^000000";
		next;
		mes "[Boya]";
		mes "去那里就能在绿洲附近找到一只狗。";
		mes "他非常神秘，而且会说话，不要惊讶。";
		next;
		mes "[Boya]";
		mes "告诉那只狗^4d4dff博雅真的很棒。^000000";
		mes "有疑问就问那只狗。";
		next;
		mes "[Boya]";
		mes "你为什么盯着我？";
		mes "我总得想个密码吧？";
		mes "那个密码有什么问题？";
		next;
		mes "[Boya]";
		mes "总之，那里离这里不远，是适合你这样的初心者的地方。";
		mes "好，愿芙蕾雅保佑你～！";
		para_suv01 = 1;
		setquest 7128;
		close;
	}
	if (BaseLevel < 26) {
		mes "我会把你送到B课程的第一步。";
		mes "B课程叫“征服下水道！”。";
		mes "这是最适合你等级的任务。";
		next;
		mes "[Boya]";
		mes "你需要在普隆德拉的骑士团登记，才能探索下水道。";
		mes "登记后前往普隆德拉西门。下水道管理员就在入口附近。";
		next;
		mes "[Boya]";
		mes "进入下水道后，你会找到一只派遣的猫。他跟你说话时别惊讶。";
		next;
		mes "[Boya]";
		mes "告诉那只猫^4d4dff博雅的帮助像巨大又美味的金枪鱼。^000000";
		mes "他非常神秘，而且会说话，不要惊讶。";
		mes "告诉他后，他会给你一个战斗目标。";
		mes "有疑问就问那只猫。";
		next;
		mes "[Boya]";
		mes "你为什么那样盯着我？";
		mes "这只是我编的密码。";
		next;
		mes "[Boya]";
		mes "总之……";
		mes "那里离这里不远，是适合你这样的初心者的地方。";
		mes "好，愿芙蕾雅保佑你～！";
		para_suv01 = 6;
		setquest 7133;
		close;
	}
	return;
S_Quest2:
	if (BaseLevel < 33) {
		mes "很好。";
		mes "让我为你选择合适的地点。";
		next;
		mes "[Boya]";
		mes "我会把你送到A课程的第二步。";
		mes "这门课程叫“征服鬼洞！”。";
		mes "这是最适合你等级的任务。";
		next;
		mes "[Boya]";
		mes "斐扬北方有一个小型弓箭手村落。";
		mes "弓箭手村落西侧的山丘上有一个洞窟。";
		next;
		mes "[Boya]";
		mes "我们已经派人驻守在洞窟前。";
		mes "他的名字是……嗯……";
		mes "...";
		next;
		mes "[Boya]";
		mes "总之他是我们的人，所以认识我。";
		mes "他会给你一个任务。";
		mes "有疑问就问他。";
		next;
		mes "[Boya]";
		mes "你为什么盯着我？";
		mes "我们很久没见了，所以我想不起他的名字！";
		next;
		mes "[Boya]";
		mes "总之……";
		mes "那里离这里不远，所以快点回来。";
		mes "好，愿芙蕾雅保佑你～！";
		para_suv01 = 13;
		setquest 7138;
		close;
	}
	if (BaseLevel < 40) {
		mes "我会把你送到B课程的第二步。";
		mes "这门课程叫“征服蚁穴！”。";
		mes "这是最适合你等级的任务。";
		next;
		mes "[Boya]";

			next;
			mes "[Stello]";
			mes "不是。这片雾是^0000cd洞穴中的龙^000000生气时喷出的烟雾形成的。请等^0000cd巡逻队^000000处理好它。";
			npctalk "他们是专业人士，很快就能处理好！", "Stello#dorcon", bc_self;
			next;
			mes "[" + strcharinfo(0) + "]";
			mes "那我们什么时候才能出发？";
			next;
			mes "[Stello]";
			mes "也许明天吧。";
			next;
			mes "[" + strcharinfo(0) + "]";
			mes "雾不是笼罩着岸边一带吗？直接出航不会有问题吗？";
			next;
			mes "[Stello]";
			mes "我们要走的航线是^0000cd非同寻常的航线^000000。你必须观察星辰和风的动向，走地图上没有标记的路，甚至会怀疑自己是否还能找到陆地。";
			npctalk "找路真是麻烦。", "Stello#dorcon", bc_self;
			next;
			mes "[Stello]";
			mes "所以我们必须清除阻碍我们观察日光和风向的^0000cd雾气^000000。";
			next;
			mes "[" + strcharinfo(0) + "]";
			mes "看来我别无选择了。我应该去那里。";
			next;
			mes "[Stello]";
			mes "你不必这样做。";
			next;
			mes "[Captain Gamberi]";
			mes "Stello，这位冒险者经验丰富。这也许会成为一场新的冒险，说不定能帮助我们。";
			npctalk "我想也是。这位冒险者看起来确实很强。", "Stello#dorcon", bc_self;
			npctalk "你怎么看，Stello？", "", bc_self;
			next;
			mes "[Stello]";
			mes "嗯……好吧。请去见^0000cd守卫村庄南桥的巡逻队员^000000，确认龙的状况。";
			next;
			mes "[Stello]";
			mes "龙的状况对拉扎格纳非常重要，所以巡逻队一直在检查。";
			next;
			mes "[Stello]";
			mes "向巡逻队员询问龙的情况；如果发生了问题，就和巡逻队一起解决。";
			next;
			mes "[" + strcharinfo(0) + "]";
			mes "我明白了。我去快速调查一下。";
			npctalk "请多加小心。", "", bc_self;
			erasequest 14547;// Can we set out the sailing?
			setquest 14548;// Crazy Dragon
			lasagna_quest[1] = 21;// jump to 21
			close;
		}
		mes "[Captain Gamberi]";
		mes "Stello，我说过穿着能体现一个多兰的品格。请调整一下你的服装。";
		next;
		mes "[Stello]";
		mes "这衣服又重又紧，还很碍事，穿着太不舒服了。";
		next;
		mes "[Captain Gamberi]";
		mes "你必须克服不便，保持正确姿势。正确姿势是成为绅士的第一步。明白了吗，Stello？";
		next;
		emotion ET_OK, getnpcid(0, "Stello#dorcon");
		mes "[Captain Gamberi]";
		mes "Stello，再说一遍。";
		npctalk "Stello？", "", bc_self;
		next;
		mes "[Stello]";
		mes "是，长官。";
		npctalk "他每次都必须听到回答吗？", "Stello#dorcon", bc_self;
		npctalk "Stello？", "", bc_self;
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "嗯，这样吗……";
		next;
		mes "[Stello]";
		mes "你是谁？未经许可不得进入这里。请离开。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "你好，我是" + strcharinfo(0) + "，正在踏上新的冒险。";
		next;
		mes "[Captain Gamberi]";
		mes "新来的冒险者。礼貌的多兰进门前总会敲门。既然你是冒险前太紧张了，这次就算了。";
		npctalk "敲门……是的，敲门非常重要。", "Stello#dorcon", bc_self;
		next;
		mes "[Captain Gamberi]";
		mes "我是负责这艘船的^0000cdGamberi^000000船长。欢迎登船。";
		npctalk "我是负责这艘船的Gamberi船长。", "Stello#dorcon", bc_self;
		npctalk "Stello？", "", bc_self;
		npctalk "啊！对不起。", "Stello#dorcon", bc_self;
		next;
		mes "[Stello]";
		mes "一定是事务长又派来了一个无关紧要的访客。他肯定告诉你同乡之间应该互相照应之类的话。";
		next;
		mes "[Stello]";
		mes "我不是在责怪你。我会尽力让你拥有最棒的航海冒险。我是^0000cdStello^000000。";
		npctalk "大副。", "Stello#dorcon", bc_self;
		next;
		mes "[Captain Gamberi]";
		mes "在船上走走也许能帮你放松。只要注意礼仪，大家都会欢迎你。";
		next;
		mes "[Stello]";
		mes "尤其要调整你的服装。合适的服装带来正确的姿势，而正确的姿势是成为绅士的第一步。";
		npctalk "没错。", "", bc_self;
		next;
		mes "[Stello]";
		mes "所有船员都是绅士，但他们对无礼行为毫不留情。你要当心。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "好的，我会注意。谢谢。";
		erasequest 14532;// Greetings to Captain Gamberi
		setquest 14533;// Say hi to recorder
		getexp 200,300;
		lasagna_quest[1] = 15;
		close;
	}
	if (lasagna_quest[1] < 21) {
		if (Class != Job_Summoner) {
			mes "[Captain Gamberi]";
			mes "很高兴有你这样的老练冒险者帮助我们。去向巡逻队员询问龙的状况。";
			close;
		}
		mes "[Captain Gamberi]";
		mes "去见见其他船员也是个不错的主意。";
		close;
	}
	if (lasagna_quest[1] < 29) {
		if (lasagna_quest[1] == 28 && Class != Job_Summoner) {
			mes "[Captain Gamberi]";
			mes "请把这件事告诉Stello。";
			close;
		}
		mes "[Captain Gamberi]";
		mes "你必须让龙平静下来才能出航。请尽力而为。";
		close;
	}

	if (conch_in_recorder == 1) {
		mes "[" + strcharinfo(0) + "]";
		mes "打扰了，船长。";
		next;
		mes "[Captain Gamberi]";
		mes "你来这里做什么？";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "我是来履行^0000cd冒险者的职责^000000的。";
		next;
		mes "[Captain Gamberi]";
		mes "冒险者的职责？";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "除了踏上冒险，我也会收集他人的冒险故事。我听说Gamberi船长，你在拉扎格纳生活了很长时间。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "大家都说我可以从你这里听到关于拉扎格纳和康奇利纳的冒险故事。";
		next;
		mes "[Captain Gamberi]";
		mes "嗯！那你找对人了。向冒险者讲述冒险故事，对我来说也是一场冒险。你现在想听哪个故事？";
		npctalk "已经很久没有像你这样的访客了。", "Stello#dorcon", bc_self;
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "我最想听关于你的故事。";
		next;
		mes "[Gamberi]";
		mes "我来自拉扎格纳，出生于名门，父母都很温和。我成长为一个好奇又爱冒险的孩子。";
		npctalk "村里没有人不认识我。", "Stello#dorcon", bc_self;
		next;
		mes "[Gamberi]";
		mes "我想摆脱家族的名号，于是离家出走，在拉扎格纳四处游荡。";
		npctalk "我的家是囚禁我的无形牢笼，而我是渴望自由的鸟……", "Stello#dorcon", bc_self;
		next;
		mes "[Stello]";
		mes "哦，奇怪。这和我从你母亲那里听到的故事不一样，船长。她说你不愿帮忙经营肉店，所以一大早就出门了。";
		npctalk "到底是谁在撒谎？", "Stello#dorcon", bc_self;
		npctalk "Stello？", "", bc_self;
		next;
		mes "[Gamberi]";
		mes "Stello，打断别人说话很不礼貌。我正义感很强，不能放任那些坏多兰扰乱拉扎格纳的和平。我必须^0000cd引导他们走上正途^000000。";
		next;
		mes "[Gamberi]";
		mes "后来我遇到了Pepperoncino。";
		next;
		mes "[Stello]";
		mes "我听过那个故事。所以你才被称为疯狂的……";
		npctalk "Stello？", "", bc_self;
		npctalk "不，没什么。", "Stello#dorcon", bc_self;
		next;
		mes "[Gamberi]";
		mes "我对渔业很感兴趣，于是和Pepperoncino一起投身^0000cd凤尾鱼加工^000000生意。我们赚了很多钱，便开始思考该如何使用这笔钱……";
		next;
		mes "[Stello]";
		mes "确实是……";
		npctalk "确实是？", "", bc_self;
		npctalk "不，别在意我……", "Stello#dorcon", bc_self;
		next;
		mes "[Gamberi]";
		mes "你现在可能看不出来，但拉扎格纳过去曾是个黑暗的地方。街上到处都是坏多兰，冲突也屡见不鲜。";
		next;
		mes "[Gamberi]";
		mes "我的职责就是^0000cd引导那些坏多兰走上正途^000000。";
		next;
		mes "[Gamberi]";
		mes "十年前，Pepperoncino和Thomas齐心协力，为这座城镇带来了和平……";
		next;
		mes "[Stello]";
		mes "你需要一些人手……";
		npctalk "......", "", bc_self;
		npctalk "....... Huh...", "Stello#dorcon", bc_self;
		next;
		mes "[Gamberi]";
		mes "那时我遇见了Stello。我^0000cd纠正了当时还是扒手的Stello^000000。他后来成了大副。";
		next;
		mes "[Stello]";
		mes "嗯，别再说了。那都是很久以前的事了。";
		npctalk "你在和客人说什么？", "", bc_self;
		next;
		mes "[Gamberi]";
		mes "我、Pepperoncino和Thomas想做一件大事。一件前所未有的大事——我是说，做一笔生意。";
		next;
		mes "[Gamberi]";
		mes "我们开始的生意是^0000cd把拉扎格纳的特产卖到其他城市^000000。生意进展顺利，我们又雇了更多人来扩大规模。";
		next;
		mes "[Gamberi]";
		mes "与此同时，我们组建了^0000cd巡逻队^000000，整顿拉扎格纳的街道。许多人为了我们的目标加入了进来。";
		npctalk "我组建巡逻队时，很多人被我的人格魅力吸引，加入了我。", "", bc_self;
		next;
		mes "[Stello]";
		mes "你是要加入我，还是想挨一拳？你还要继续住在阴沟里吗？听到这种威胁，谁会不加入巡逻队呢……";
		next;
		mes "[Gamberi]";
		mes "Stello？";
		npctalk "真的吗？你是被强迫加入的吗？", "", bc_self;
		next;
		mes "[Stello]";
		mes "不！我是真的想加入！";
		npctalk "不！我是真的想加入！", "Stello#dorcon", bc_self;
		next;
		mes "[Gamberi]";
		mes "我纠正了那些坏多兰，并组建商人团体和巡逻队来从事^0000cd贸易^000000。生意蒸蒸日上，附近所有城市都充满了拉扎格纳的商品。";
		next;
		mes "[Gamberi]";
		mes "总之，我们决定把舞台扩展到^0000cd海上^000000。这个决定源于我的冒险精神。";
		next;
		mes "[Stello]";
		mes "那是因为Pepperoncino……";
		npctalk "是因为Pepperoncino。", "", bc_self;
		npctalk "嗯，他可能确实有些影响……", "Stello#dorcon", bc_self;
		next;
		mes "[Gamberi]";
		mes "后来我们遭遇风暴，与^0000cdThomas的船Navi^000000失散了。我们一直在寻找Navi。";
		next;
		mes "[Gamberi]";
		mes "之后，我和被我纠正过的^0000cdStello^000000开辟了前往马兰岛的航线，并与Thomas重聚。最终，我们决定向新大陆进发。";
		npctalk "咳，请详细说说那一段！", "", bc_self;
		next;
		mes "[Gamberi]";
		mes "从那以后，我们不仅主导着与新大陆的贸易，也连接起两片大陆。两片大陆的冒险者都使用^0000cd康奇利纳^000000，能做到这一点我们深感自豪。";
		next;
		mes "[Gamberi]";
		mes "这样够了吗？";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "哦，真是精彩的故事。非常感谢你分享。我相信无数次冒险造就了今天的你，亲爱的船长。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "好了，我想是时候带着这段宝贵经历，出去寻找新的冒险了。";
		next;
		mes "[Captain Gamberi]";
		mes "以后请回来告诉我你的故事。";
		npctalk "我也想听。", "Stello#dorcon", bc_self;
		erasequest 14579;// Interview with Captain
		setquest 14580;// To Recorder
		conch_in_recorder = 2;
		close;
	}
	if (conch_in_recorder == 2) {
		mes "[Captain Gamberi]";
		mes "有问题就来找我。";
		close;
	}
	mes "[Captain Gamberi]";
	if (Class != Job_Summoner)
		mes "总有一天我想听听你的冒险故事。";
	else
		mes "总有一天我想听你讲述来自新大陆的冒险故事。冒险期间请偶尔来看看我。";
	close;
}

// in G_H
conch_in,96,29,5	script	Recorder#dorcon	4_CAT_MERMASTER,{
	if (checkweight(1001,1) == 0) {
		mes "[Recorder]";
		mes "看起来又多又大。要不要先减少一些？";
		close;
	}
	if (lasagna_quest[1] < 15) {
		mes "[Recorder]";
		mes "我需要集中精神，请不要打扰我。";
		close;
	}
	if (lasagna_quest[1] == 15) {
		mes "[" + strcharinfo(0) + "]";
		mes "打扰了。";
		next;
		mes "[Recorder]";
		mes "我说过不要打扰……哦，你是谁？";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "你好，我是" + strcharinfo(0) + "，正在寻找来自新大陆的冒险。事务长建议我来打个招呼。";
		npctalk "哦，我明白了。", "", bc_self;
		next;
		mes "[Recorder]";
		mes "很高兴见到你。我是这艘船的记录员，负责管理船上的所有记录。有问题随时可以来找我。除了机密记录，其他记录你都可以查阅。";
		next;
		mes "[Recorder]";
		mes "现在让我记录你的资料。哦，你什么都不用做，站在那里就好。";
		next;
		mes "[Recorder]";
		mes "你的名字是……" + strcharinfo(0) + "……身高应该是……颜色是……这样……你的口音……你一定在帕内生活过，后来搬到了邦戈拉。";
		npctalk "而且你现在来到了拉扎格纳……", "", bc_self;
		next;
		mes "[Recorder]";
		mes "你脚上的泥土和草屑……你不是个整洁的人……哦，算了。我不会记下你的缺点……这样就够了。";
		next;
		emotion ET_HUK;
		mes "[" + strcharinfo(0) + "]";
		mes "你怎么知道得这么详细？";
		next;
		mes "[Recorder]";
		mes "只要稍微留心就能发现。这是我长时间观察他人后掌握的技巧。";
		next;
		mes "[Recorder]";
		mes "让我看看，你应该已经见过船长和大副了。这里一定是你的第二站。";
		next;
		emotion ET_HUK;
		mes "[" + strcharinfo(0) + "]";
		mes "没错！";
		next;
		mes "[Recorder]";
		mes "现在该去见^0000cd主厨、舵手和水手长^000000了。他们应该在走廊尽头的^0000cd餐厅^000000里。祝你航行平安。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "哈！好的，谢谢。";
		erasequest 14533;// Say hi to recorder
		setquest 14534;// To the kitchen
		getexp 200,300;
		lasagna_quest[1] = 16;
		close;
	}
	if (lasagna_quest[1] == 16) {
		mes "[Recorder]";
		mes "你应该去见主厨、舵手和水手长。他们在走廊尽头的餐厅里。";
		close;
	}
	if (lasagna_quest[1] == 17) {
		mes "[Recorder]";
		mes "现在不是该去见事务长了吗？";
		close;
	}
	if (lasagna_quest[1] == 18) {
		mes "[Recorder]";
		mes "你正要去见副厨师长。他在走廊尽头的餐厅里。";
		close;
	}
	if (lasagna_quest[1] == 19) {
		mes "[Recorder]";
		mes "你应该正要回去见事务长。我正纳闷为什么过了预定时间还没有出航信号。";
		close;
	}
	if (lasagna_quest[1] == 20) {
		mes "[Recorder]";
		mes "大副和船长负责发出航信号。直接问他们是最快的办法。";
		close;
	}
	if (lasagna_quest[1] == 21) {
		mes "[Recorder]";
		mes "你要去那里见巡逻队员吗？我正打算去看看新成员。这里的事情一处理完我就下去，当然要带上笔记本。";
		close;
	}
	if (lasagna_quest[1] <= 28) {
		mes "[Recorder]";
		mes "你应该去见船长和大副。大家都在等着出发。";
		close;
	}

	if (conch_in_recorder == 0) {
		mes "[" + strcharinfo(0) + "]";
		mes "打扰了。";
		next;
		mes "[Recorder]";
		mes "我说过不要打扰……哦，你是谁？";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "你好，我是" + strcharinfo(0) + "，正在寻找来自新大陆的冒险。事务长建议我来打个招呼。";
		next;
		mes "[Recorder]";
		mes "哦，我明白了。很高兴见到你。我是这艘船的记录员，负责管理船上的所有记录。有问题随时可以来找我。除了机密记录，其他记录你都可以查阅。";
		next;
		mes "[Recorder]";
		mes "现在让我记录你的资料。哦，你什么都不用做，站在那里就好。你的名字是……" + strcharinfo(0) + "……身高应该是……颜色是……这样……";
		npctalk "新大陆的人真高。", "", bc_self;
		next;
		mes "[Recorder]";
		mes "哦，算了。我不会记下你的缺点……这样就够了。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "你怎么知道得这么详细？";
		next;
		mes "[Recorder]";
		mes "只要稍微留心就能发现。这是我长时间观察他人后掌握的技巧。";
		npctalk "这也是一种职业病。", "", bc_self;
		next;
		mes "[Recorder]";
		mes "总之，你来得正是时候。刚刚发生了一件神秘的事，我需要^0000cd与此事无关的新鲜视角^000000。";
		npctalk "我谁也不能相信。", "", bc_self;
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "我有种预感，自己现在必须离开这里。";
		next;
		mes "[Recorder]";
		mes "至少听我说完吧。作为冒险者，多听些故事会有帮助。";
		next;
		if (select( "I will hear the story.", "I won't hear the story." ) == 2) {
			mes "[" + strcharinfo(0) + "]";
			mes "我不想听。我不想再卷入另一件麻烦事。";
			next;
			mes "[Recorder]";
			mes "这样啊。好吧，抓住忙碌的人不放也不礼貌。";
			next;
			mes "[Recorder]";
			mes "不过，如果你改变主意，随时都可以回来。我会等你。";
			close;
		}
		mes "[" + strcharinfo(0) + "]";
		mes "我愿意听这个故事。";
		next;
		mes "[Recorder]";
		mes "很好。请看看这里的书架。";
		npctalk "它们是不是很漂亮？", "", bc_self;
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "这里有好多书。";
		next;
		mes "[Recorder]";
		mes "它们看起来像书，但其实不是。它们记录了船上发生的一切。";
		next;
		mes "[Recorder]";
		mes "其中不仅记录了船上发生的事件，也记录了几乎所有与康奇利纳有关的人的历史。";
		emotion ET_SWEAT, playerattached();
		next;
		mes "[Recorder]";
		mes "透过过去可以看见未来。";
		next;
		mes "[Recorder]";
		mes "我不只是制作新记录，也会尽力让记录保持最佳状态。";
		next;
		mes "[Recorder]";
		mes "然而，有人^0000cd损坏了这里的一份记录^000000。";
		next;
		mes "[Recorder]";
		mes "犯人甚至没有试图掩饰自己的行为，只是残忍地撕毁了整本书。它已经毁了。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "啊！这是要我找出失踪页面的案件吗？你寻找的这个局外人，是要为调查提供新的视角来破案吗？";
		next;
		mes "[Recorder]";
		mes "不，缺失的页面已经找到了，就在厨房的烤箱里。";
		npctalk "我猜你一定是推理迷。", "", bc_self;
		next;
		mes "[Recorder]";
		mes "遗憾的是，大部分页面都在火中烧毁了。我只能勉强辨认出剩余的文件。";
		npctalk "幸好没有全部烧光……", "", bc_self;
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "缺失的页面是关于什么的？";
		next;
		mes "[Recorder]";
		mes "遗憾的是，那些页面记载着^0000cdGamberi船长的经历^000000。因为Gamberi是我们的船长，我一直尽力完善这份记录。";
		npctalk "那是最漫长、也最费时费力的一份记录。", "", bc_self;
		next;
		mes "[Recorder]";
		mes "所有书里也都收录了Gamberi船长的故事，而这些内容全都化为了灰烬。";
		next;
		mes "[Recorder]";
		mes "遗失的记录讲述的是Gamberi船长成为康奇利纳船长之前的故事，非常珍贵。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "为什么？";
		next;
		mes "[Recorder]";
		mes "这是由拉扎格纳居民的特点造成的。这里大多是来自其他地区的人。Gamberi船长和Navi的Thomas船长几乎是仅有的拉扎格纳本地人。";
		next;
		mes "[Recorder]";
		mes "了解Gamberi船长过去的人大多已经离开拉扎格纳。如今这里几乎没有人知道他的过去。";
		next;
		mes "[Recorder]";
		mes "所以调查并制作这份记录花了很长时间。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "那我该帮你找出小偷吗？";
		next;
		mes "[Recorder]";
		mes "不用，我已经找到了小偷。我打算用最痛苦的方式惩罚他。不过在那之前还有些事情要处理，所以我暂时保持沉默。";
		npctalk "凡事都有合适的时机。", "", bc_self;

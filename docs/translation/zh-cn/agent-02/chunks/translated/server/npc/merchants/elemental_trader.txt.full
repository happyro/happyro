//===== rAthena Script ======================================= 
//= 元素石商人
//===== By: ================================================== 
//= rAthena Team & MasterOfMuppets
//===== Current Version: ===================================== 
//= 1.1
//===== Compatible With: ===================================== 
//= rAthena Project
//===== Description: ========================================= 
//= [Official Conversion]
//= 将不纯元素石交换为纯元素石。
//===== Additional Comments: ================================= 
//= 1.0 Rescripted to Aegis 10.3 standards. [L0ne_W0lf]
//= 1.1 Optimized. [Euphy]
//============================================================ 

ama_in02,61,27,7	script	Alchemist#ama	749,{
	mes "[Laspuchin Gregory]";
	mes "嘻嘻嘻嘻呵呵呵。";
	mes "真是太棒了！";
	mes "结果非同寻常！！";
	next;
	mes "[Laspuchin Gregory]";
	mes "没想到能在这片遥远的";
	mes "土地上施展我的技能……";
	mes "呵呵呵……宫殿领主";
	mes "真是相当配合。";
	next;
	mes "[Laspuchin Gregory]";
	mes "糟糕，我得小心点……";
	mes "要是公会发现我的";
	mes "位置，愚蠢的 Myster 会";
	mes "对我发火。呵呵呵呵……";
	next;
	mes "[Laspuchin Gregory]";
	mes "什么？想说点什么吗？";
	mes "如果你是来观光的，";
	mes "好好享受假日，然后回你的家乡。";
	mes "嘻嘻嘻……否则，";
	mes "我就让你尝尝我的酸液瓶……！";
	next;
	if (select("请原谅我:你需要帮助吗？") == 1) {
		mes "[Laspuchin Gregory]";
	mes "呵呵呵……你听见";
	mes "我说的话了吗？最好";
	mes "把它忘掉……";
	mes "嘻嘻嘻嘻嘻……";
		close;
	}
	mes "[Laspuchin Gregory]";
	mes "帮助，嗯……？";
	mes "这么一想……";
	mes "我现在确实需要一些物品……";
	mes "嘻嘻嘻嘻……";
	next;
	mes "[Laspuchin Gregory]";
	mes "Laspuchin 大人需要一些";
	mes "附魔石来进行实验。";
	mes "我会有效利用它们……";
	mes "你现在有吗？";
	next;
	if (select("没有:我有一些") == 1) {
		mes "[Laspuchin Gregory]";
	mes "那么，找来同一种类的 8 块石头。";
	mes "如果你带来同一种类的";
	mes "8 块附魔石，我会把它们变成";
	mes "更好的石头……";
		next;
		mes "[Laspuchin Gregory]";
	mes "那么，找来同一种类的 8 块石头。";
	mes "不是圆形宝石，";
	mes "而是附魔石。";
	mes "如果你带错石头，";
	mes "我就扔出火焰瓶！";
		next;
		mes "[Laspuchin Gregory]";
	mes "把石头带给我，奴隶~！！";
	mes "记住你的承诺！呵呵呵呵呵……";
		close;
	}
	mes "[Laspuchin Gregory]";
	mes "嗯哼，你带来了什么？";
	next;
	setarray .@Items[1],995,997,994,996;
	set .@i, .@Items[select("神秘冰块:大地之力:火焰之心:粗糙风")];
	mes "[Laspuchin Gregory]";
	if (countitem(.@i) > 7) {
	mes "我会拿走其中 8 个，";
	mes "给你一块附魔石。";
	mes "听起来怎么样？";
	mes "呵呵呵……";
		next;
		mes "[Laspuchin Gregory]";
	mes "嘻嘻，你想要什么？选一个吧！";
		next;
		set .@menu$, "";
		for(set .@j,1; .@j<5; set .@j,.@j+1) {
			if (.@Items[.@j] != .@i) set .@menu$, .@menu$+getitemname(.@Items[.@j]);
			set .@menu$, .@menu$+":";
		}
	set .@menu$, .@menu$+"取消交易";
		set .@j, select(.@menu$);
		mes "[Laspuchin Gregory]";
		if (.@j == 5) {
			mes "哦，那就算了。";
			mes "别把我的位置告诉任何人……";
			mes "呵呵呵……毕竟你答应过的~";
			close;
		}
		else if (.@j == 4) {
			if (countitem(.@i) > 11) {
				delitem .@i,12;
				getitem 996,1;
				mes "呵呵呵，你知道吗？";
				mes "我手头没有多少那种石头，";
				mes "所以我要拿走你的 ^0000FF12^000000 个，好吗？";
				mes "当然，没问题。";
				mes "能帮助 Laspuchin 是你的荣幸！";
				close;
			}
			mes "呵呵呵，你知道吗？";
			mes "我手头没有多少这种石头，";
			mes "不能只拿走你的 8 个。";
			mes "如果你想把它们换成粗糙风，";
			mes "再带 4 块石头来。8 + 4 = 12……";
			mes "需要 ^0000FF12^000000 块石头。";
			next;
			mes "[Laspuchin Gregory]";
			mes "把石头带给我，奴隶~！！";
			mes "记住你的承诺！呵呵呵呵呵……";
			close;
		}
		else {
			delitem .@i,8;
			getitem .@Items[.@j],1;
			mes "呵呵呵！你选得很好！";
			mes "好好使用它……";
			mes "还有其他石头的话也带给我！";
			close;
		}
	} else if (countitem(.@i)) {
		mes "只有几块附魔石可帮不了 Laspuchin，";
		mes "我说的是 8 块！";
		mes "带 8 块石头来！";
		mes "呵呵呵……";
		next;
		mes "[Laspuchin Gregory]";
	mes "把石头带给我，奴隶~！！";
	mes "记住你的承诺！呵呵呵呵呵……";
		close;
	}
	mes "呵呵呵~ 在告诉我";
	mes "你有多愚蠢之前，";
	mes "先检查一下你的口袋……";
	next;
	mes "[Laspuchin Gregory]";
	mes "把石头带给我！你说过要帮助我！";
	mes "遵守你的承诺！呵呵呵呵呵……";
	close;
}

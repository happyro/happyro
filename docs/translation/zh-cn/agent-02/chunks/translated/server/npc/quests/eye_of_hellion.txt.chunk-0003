	mes "向西三步。然后是……";
	mes "蔬菜女士。好吧，好吧……";
	next;
	mes "[" + strcharinfo(0) + "]";
	mes "嗯，真诡异。";

mes "那里正好有一个在盯着我。";
mes "但在‘蔬菜女士’之后，";
mes "文字只剩下……嗯，";
	mes "最后那个词是什么来着？";
		next;
		input .@input$;
		if (.@input$ == "BINGO") {
		mes "[" + strcharinfo(0) + "]";
		mes "当然！";

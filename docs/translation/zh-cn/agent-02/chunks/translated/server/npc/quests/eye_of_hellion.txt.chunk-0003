			set HELLIONQ,42;
			else if (HELLIONQ == 41)
			set HELLIONQ,43;
			next;
			mes "["+ strcharinfo(0) +"]";
			mes "我的天……";
			mes "这一切简直像";
			mes "披风与匕首般的";
			mes "秘密行动！";
			close;
			}
			mes "[" + strcharinfo(0) + "]";
			mes ""+ .@input$ + "!";
			mes "嗯……不，不可能是那个。";
			mes "那个词到底是什么？为什么偏偏在最需要时想不起来？";
			close;
			}
			end;
			}
			prt_in,128,79,0	script	Unknown Machine#prt_key	111,{

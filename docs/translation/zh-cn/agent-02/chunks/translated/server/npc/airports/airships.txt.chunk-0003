		mes "穿着它在飞艇上走动";
		mes "实在太厚重了。";
		next;
		mes "[Pilot]";
	mes "……";
	mes "…………";
	mes "平时根本没人会";
	mes "进入这个房间。";
	mes "而且船长真的是一头驯鹿。";
	mes "我干脆脱到只剩内裤吧。";
		next;
		emotion ET_HUK;
		mes "[Pilot]";
	mes "哦……！你好！";
	mes "飞行还愉快吗？！";
		close;
	}
}

	mes "结果只看到一头";
	mes "奇怪的驯鹿。哦！";
	mes "你觉得那会不会……";
	close;

OnTouch_:
	emotion ET_CRY;
	end;
}

airplane_01,69,63,2	script	Mendel#01airplane_01	55,{

}

function	script	Func_Are_Rew	{
	.@item_id = getarg(0);
	.@amount = getarg(1);
	.@arena_point = getarg(2);

	mes "[Givu]";
	mes "要用竞技场积分兑换 "+ getitemname(.@item_id) +" 吗？";
	mes "你可以用 ^3131FF"+ .@arena_point +" 点竞技场积分兑换 "+ .@amount +" 个 "+ getitemname(.@item_id) +"^000000。";
	mes "要取消请输入 0，否则请输入要花费竞技场积分的^3131FF次数^000000。";
	next;
+// 切片行数保留
// 切片行数保留
// 切片行数保留
// 切片行数保留
// 切片行数保留
// 切片行数保留

harboro1,352,154,0	script	#r_q1	HIDDEN_WARP_NPC,5,5,{
	end;
OnTouch:
	if (isbegin_quest(12389) == 2)
		end;
	.@r = rand(1,6);
	if (.@r == 1)
		npctalk "热情的求职者：我马上就能工作。你为什么不雇我？", "Enthusiastic Job Seeker#1";
	else if (.@r == 2)
		npctalk "热情的求职者：我来这里不是为了打瞌睡。给我工作！", "Enthusiastic Job Seeker#3";
	else if (.@r == 3)
		npctalk "嘿，你挡着我的位置了。能走开吗？", "Enthusiastic Job Seeker#5";
	else if (.@r == 4)
		npctalk "热情的求职者：你刚下船来到这里吗？别来回踱步了，真让人心烦。", "Enthusiastic Job Seeker#7";
	else if (.@r == 5)
		npctalk "热情的求职者：你为什么不接受我？我足够强大，能在外面猎杀郊狼！", "Enthusiastic Job Seeker#9";
	else
		npctalk "热情的求职者：加入水牛强盗/郊狼讨伐队。能在5分钟内完成的人欢迎加入。", "Enthusiastic Job Seeker#11";
	end;

OnEnable:
	.@r = rand(1,4);
	if (.@r == 1)
		npctalk "热情的求职者：嘿，那我们呢？！", "Enthusiastic Job Seeker#4";
	else if (.@r == 2)
		npctalk "热情的求职者：我也想工作！", "Enthusiastic Job Seeker#7";
	else if (.@r == 3)
		npctalk "热情的求职者：你不能偏袒别人！", "Enthusiastic Job Seeker#9";
	else
		npctalk "热情的求职者：这不公平！", "Enthusiastic Job Seeker#2";
	end;
}

harboro1,357,155,3	script	Steel Vigilante#1	4_M_MASKMAN,{
	disable_items;
	if (checkweight(1201,1) == 0) {
		mes "我携带的物品种类太多。得先清理背包。";
		close;
	}
	if ((MaxWeight - Weight) < 10000) {
		mes "我超重了。最好先减轻负重。";
		close;
	}
	if (BaseLevel < 100) {
		mes "[Steel Vigilante]";
		mes "抱歉，我们需要比你更强的人。";
		close;
	}
	if (isbegin_quest(12389) == 0) {// first time
		mes "[Steel Vigilante]";
		mes "嘿，朋友。你看起来很强。你是来工作的吗？";
		next;
		select("不，我只是游客。" );
		mes "[Steel Vigilante]";
		mes "别这么无情嘛。我只是想和你聊聊。我有个你可能感兴趣的提议。怎么样？";
		next;
		if (select( "Alright, let me hear it.", "No, thanks." ) == 2) {
			mes "[Steel Vigilante]";
	
	
	
	
	
	

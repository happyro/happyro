//============================================================
//= Illusion of Moonlight
//============================================================
pay_d03_i,160,45,3	script	Gemcutter#ilp20	4_TOWER_17,3,3,{
	mes "[宝石切割师]";
	mes "你找我有事吗？";
	next;
	switch( select( "你在这里做什么？", "升级装备" ) ) {
	case 1:
		mes "[宝石切割师]";
		mes "我来到这座废墟村庄，";
		mes "寻找一些材料。接触到奇怪的光后，我就来到了这里。";
		next;
		mes "[宝石切割师]";
		mes "我决定在这里待一阵子。只要靠近这名士兵，应该就很安全。";
		mes "我有个提议。我需要一些只有这里才有的材料。";
		next;
		mes "[宝石切割师]";
		mes "把材料带给我，我就帮你升级装备。不过先说好，我只能升级特定类型的装备。";
		next;
		mes "[宝石切割师]";
		mes "如果你感兴趣，我们可以讨论交易的细节。";
		close;
	case 2:
		mes "[宝石切割师]";
		mes "带来之前，确认^0000FF装备至少精炼到+9^000000。";
		mes "这是我的升级服务能对装备产生明显效果的最低要求。";
		next;
		mes "[宝石切割师]";
		mes "确认你^0000FF装备了想要升级的物品。^000000";
		mes "否则我无法评估它的状态。";
		next;
		mes "[宝石切割师]";
		mes "如你所料，装备完成升级后会变成新的物品。";
		mes "换句话说，^0000FF它会失去当前的精炼等级、卡片和附魔。^000000";
		next;
		mes "[宝石切割师]";
		mes "升级装备需要^0000FF幻影石和其他一些材料^000000。";
		mes "选择你想升级的物品，我会告诉你所需材料。";
		close2;
		callshop( "barter_ill_moonlight" );
		end;
	}
	end;

OnTouch:
	if (illusion_moonlight > 7)
		npctalk "这是什么地方？", "", bc_self;
	end;
}


//============================================================
//= Illusion of Vampire
//============================================================
gef_dun01,139,228,3	script	Great Merchant#illgef	4_M_HUMERCHANT,{
	mes "[大商人]";
	mes "冒险者，你有^0000cd幻影石^000000吗？如果你有一件^0000cd武器、防具^000000，或^0000cd精炼等级9以上的饰品^000000，";
	mes "我可以用一些幻影石和其他材料，把它兑换成更好的装备。";
	next;
	mes "[大商人]";
	mes "那么，你想要什么？";
	next;
	switch( select( "兑换幻影装备", "幻影石是什么？", "兑换的装备可以强化吗？", "取消" ) ) {
	case 1:
		specialeffect EF_HFLIMOON3;
		emotion ET_BEST;
		mes "[大商人]";
		mes "好好使用它。如果找到更多幻影石，之后再来找我！*呵呵*";
		close2;
		callshop( "barter_ill_vampire" );
		end;
	case 2:
		mes "[大商人]";
		mes "你问^0000cd幻影石^000000是什么？嗯……我想没人确切知道它们是什么。";
		next;
		mes "[大商人]";
		mes "我只知道它们很稀有，只能在一些特殊地点找到，而我在这里替客户收集它们。";
		next;
		mes "[大商人]";
		mes "我的客户想弄清这些石头是什么。他们付给我很多钱，";
		next;
		mes "[大商人]";
		mes "所以我可以用^0000cd昂贵装备换取石头^000000，给你这样的冒险者，同时自己也能获利。";
		next;
		mes "[大商人]";
		mes "带来^0000cd精炼装备、幻影石^000000和这里只有的各种材料。我会为你^0000cd升级装备、武器、防具或饰品。^000000";
		next;
		mes "[大商人]";
		mes "这对我们双方都有好处。如果你对我的提议感兴趣，请告诉我。";
		close;
	case 3:
		mes "[大商人]";
		mes "所以你想强化获得的装备。你很认真，我喜欢！";
		next;
		mes "[大商人]";
		mes "不久前，一名路过这里的冒险者告诉我，普隆德拉有位炼金术师可以用幻影石精炼幻影装备。";
		next;
		mes "[大商人]";
		mes "看来幻影石到处都是热门话题。每个人都想知道它们是什么。";
		next;
		mes "[大商人]";
		mes "如果你想精炼装备，就去城镇办公室附近的<NAVI>幻影附魔师<INFO>prontera,90,115,000,0,</INFO></NAVI>。";
		close;
	case 4:
		mes "[大商人]";
		mes "找到喜欢的东西了吗？需要什么的话，随时告诉我。";
		close;
	}
	end;
}

//============================================================
//= Illusion of Frozen
//============================================================

// illusion exchange npc - trade items for illusion gears
ice_dun02,153,18,3	script	Illusion Stone Research	4_M_ALCHE_B,{
	disable_items;
	mes "[幻影石研究员]";
	mes "啊，幻影石真是神秘……";
	next;
	switch( select( "你在这里做什么？", "升级装备", "取消" ) ) {
	case 1:
		mes "[幻影石研究员]";
		mes "我来这里寻找研究所需的幻影石。";
		next;
		mes "[幻影石研究员]";
		mes "这个洞穴非常神秘，但我的实力不足以独自探索。";
		mes "如果你要进去，能帮我找些东西吗？";
		next;
		mes "[幻影石研究员]";
		mes "作为交换，我会帮你升级装备。";
		mes "你觉得怎么样？";
		close;
	case 2:
		mes "[幻影石研究员]";
		mes "带来之前，确认^4d4dff装备至少精炼到+9^000000。";
		mes "确认你^4d4dff装备了想要升级的物品^000000。";
		next;
		mes "[幻影石研究员]";
		mes "如你所料，装备完成升级后会变成新的物品。";
		mes "换句话说，^4d4dff它会失去当前的精炼和升级等级。^000000";
		next;
		mes "[幻影石研究员]";
		mes "升级装备需要^4d4dff幻影石和其他一些材料^000000。";
		mes "选择你想要的物品。我会告诉你所需材料。";
		close2;
		callshop( "barter_ill_frozen" );
		end;
	case 3:
		mes "[幻影石研究员]";
		mes "只是很难获得……";
		close;
	}
	end;
}


// illusion enhancing - enhance the illusion gears
// note: unknown enhance rate
prontera,90,115,5	script	Illusion Enchanter#0	4_GEFFEN_09,3,3,{
	if (checkweight(1201,1) == 0 || MaxWeight - Weight < 2000) {
		mes "我负重过高，最好先清理一下背包。";
		close;
	}
	disable_items;
	if (isbegin_quest(12415) == 0) {
		mes "[幻影附魔师]";
		mes "哦，你有幻影装备吗？";
		next;
		select("没有。我甚至不知道幻影装备是什么。");
		mes "[幻影附魔师]";
		mes "哎呀，抱歉。我应该先自我介绍。";
		next;
		mes "[幻影附魔师]";
		mes "我是专门研究幻影石的炼金术师。幻影石最近在冒险者之间流传。";
		next;
		select("幻影石？");
		mes "[幻影附魔师]";
		mes "你不知道吗？它们可是最近最热门的潮流。";
		next;
		select("我不关心潮流。");
		mes "[幻影附魔师]";
		mes "你一定听说过最近各处出现的奇怪地点。幻影石只能在那里找到，";
		next;
		mes "[幻影附魔师]";
		mes "它们的原子结构和我见过的任何矿物都不同。*喋喋不休*……它们的化学链……*喋喋不休*";
		next;
		select("（糟糕，他开始神游了！）");
		mes "[幻影附魔师]";
		mes "总之，我可以为用幻影石兑换或购买的装备附魔。我把它们称为幻影装备。";
		next;
		select("（他起名字真没品味。）");
		mes "[幻影附魔师]";
		mes "这种装备至少会对幻影石产生积极反应，或者有成功附魔的潜力。";
		next;
		mes "[幻影附魔师]";
		mes "探索幻影世界，收集幻影石并兑换装备。我可以为你附魔装备。";
		next;
		mes "[幻影附魔师]";
		mes "这对我们双方都有好处。我研究需要幻影石，而你冒险需要强力装备。";
		next;
		mes "[幻影附魔师]";
		mes "不过，我的服务不是免费的。需要一些幻影石和Zeny。";
		next;
		mes "[幻影附魔师]";
		mes "如果你感兴趣，要不要成为我的服务会员？这样可以享受折扣！";
		next;
		if (select( "好的！", "没兴趣。" ) == 2) {
			mes "[幻影附魔师]";
			mes "好吧，但改变主意后记得告诉我。";
			close;
		}
		mes "[幻影附魔师]";
		mes "好，那么我会把你加入会员名单。希望下次见面时你已经有幻影装备。";
		setquest 12415;
		completequest 12415;
		close;
	}
	mes "[幻影附魔师]";
	mes "我可以为幻影装备附魔。";
	next;
	switch( select( "你收费多少？", "为幻影装备增加属性。", "重置已附魔的幻影装备。" ) ) {
	case 1:
		mes "[幻影附魔师]";
		mes "首先要说明，我只能为某些类型的幻影装备附魔。";
		next;
		mes "[幻影附魔师]";
		mes "最多可以附魔2个槽位，每个槽位需要5个幻影石。你可以随时重置已附魔的幻影装备。";
		next;
		mes "[幻影附魔师]";
		mes "附魔不会失败，但重置有时会失败。即使现代科学也无法改变这一点。";
		next;
		mes "[幻影附魔师]";
		mes "重置所需的Zeny数量取决于你选择的成功率。想查看可用的付款选项，请选择菜单。";
		close;
	case 2:
		.@reset = false;
		break;
	case 3:
		.@reset = true;
		break;
	}
	setarray .@location[0], EQI_HAND_R, EQI_ARMOR, EQI_SHOES, EQI_GARMENT, EQI_ACC_R, EQI_ACC_L, EQI_HEAD_TOP, EQI_HAND_L;
	.@s = select( "右手武器", "防具", "鞋子", "披风", "右侧饰品", "左侧饰品", "头饰（上）", "左手武器/盾牌" ) - 1;
	.@loc = .@location[.@s];
	.@eq_id = getequipid(.@loc);

	switch(.@eq_id) {
	// Illusion of Moonlight
		case 15195:	// Puente_Robe_IL
		case 16063:	// Long_Mace_IL
		case 19209:	// Nurse_Cap_IL
		case 20838:	// Muffler_IL
		case 19210:	// Apple_Of_Archer_IL
		case 22133:	// Shoes_IL
		case 26007:	// Spectral_Spear_IL
		case 26109:	// Staff_Of_Bordeaux_IL
		case 28725:	// Moonlight_Sword_IL
	// Illusion of Vampire
		case 28022:	// Infiltrator_IL
		case 28023:	// Ghoul_Leg_IL
		case 2039:	// Wizardy_Staff_IL
		case 18149:	// Balistar_IL
		case 28612:	// Book_Of_The_Apo_IL
		case 20840:	// Cape_Of_Ancient_Lord_IL
		case 28508:	// Skul_Ring_IL
		case 28509:	// Ring_IL
	// Illusion of Frozen
		case 1846:	// Combo_Battle_Glove_IL
		case 13337:	// Huuma_Flutter_Snow_IL
		case 19223:	// Cap_IL
		case 28922:	// Herald_Of_GOD_IL
		case 20847:	// Clack_Of_Servival_IL
	// Illusion of Teddy bear
		case 28745:	// Illusion_Counter_Dagger
		case 28244:	// Illusion_Gate_Keeper_DD
		case 2051:	// Illusion_Survivor's_Staff
		case 22190:	// Illusion_Boots
		case 19344:	// Illusion_Hot_blooded_Headband
	// Illusion of Turtle
		case 13469:	// Illusion_Immaterial_Sword
		case 1326:	// Illusion_War_Axe
		case 32005:	// Illusion_Pole_Axe
		case 13338:	// Illusion_Wing_Shuriken
		case 16065:	// Illusion_Iron_Driver
		case 19247:	// Illusion_Fancy_Flower
	// Illusion of Twins
		case 450182:	// Sprint_Mail_IL
		case 470066:	// Sprint_Shoes_IL
		case 490120:	// Sprint_Ring_IL
		case 490121:	// Sprint_Glove_IL
		case 550030:	// Thorn_Staff_IL
		case 550031:	// Dea_Staff_IL
		case 530015:	// Gelerdria_IL
		case 500030:	// Excalibur_IL
		case 620010:	// Doom_Slayer_IL
		case 510034:	// Ancient_Dagger_IL
		case 460017:	// Guard_IL
		case 460018:	// Siver_Guard_IL
	// Illusion of Luanda
		case 28626:	// Illusion_Tablet
		case 18174:	// Illusion_Hunter_Bow
		case 19366:	// Illusion_Goibne_Helm
		case 15348:	// Illusion_Goibne_Armor
		case 20923:	// Illusion_Goibne_Spaulders
		case 22192:	// Illusion_Goibne's_Greaves
	// Illusion of Labyrinth
		case 19428:	// Illusion_Morpheus's_Hood
		case 20948:	// Illusion_Morpheus's_Shawl
		case 32238:	// Illusion_Morpheus's_Ring
		case 32239:	// Illusion_Morpheus's_Bracelet
		case 28254:	// Illusion_Butcher
		case 21050:	// Illusion_Tae_Goo_Lyeon
		case 32301:	// Illusion_Gold_Lux
		case 28762:	// Illusion_Bazerald
	// Illusion of underwater
		case 570008:	// Electronic_Guitar_IL
		case 580008:	// Electric_Eel_IL
		case 630006:	// Brionac_IL
		case 610012:	// KatarOfCold_Icicle_IL
		case 600011:	// Death_Guidance_IL
		case 630007:	// Zephyrus_IL
		case 450144:	// Saint_Robe_IL
		case 450145:	// Water_Sprits_Armor_IL
		case 450146:	// Chain_Mail_IL
		case 400053:	// Morrigane's_Helm_IL
		case 480054:	// Morrigane's_Manteau_IL
		case 490069:	// Morrigane's_Belt_IL
		case 490070:	// Morrigane's_Pendant_IL
			break;
		case -1:
			mes "[Illusion Enchanter]";
			mes "你必须在所选位置装备物品，才能为其附魔。";
			close;
		default:
			mes "[Illusion Enchanter]";
			mes "这件装备并非来自幻影世界。你居然拿给我看，真让人恼火。";
			close;
	}

	for ( .@i = 0; .@i < MAX_ITEM_RDM_OPT-1; ++.@i ) {
		if (getequiprandomoption(.@loc, .@i, ROA_ID) > 0) {
			mes "^ff0000该装备已设置随机属性，无法附魔。^000000";
			close;
		}
	}

	.@weapon_lvl = getequipweaponlv(.@loc);
	.@loc_enchant = .@loc;	// variable for enhancing function

	switch(.@weapon_lvl) {
	case 0:
		break;
	case 1:
	case 2:
	case 3:
		if (.@loc_enchant == EQI_HAND_L)
			.@loc_enchant = EQI_HAND_R;	// the equipment is a weapon so the enchantments must be for weapons
		break;
	default:	// illusion weapon level 4 can't be enhanced
		mes "[Illusion Enchanter]";
		mes "这是所有幻影装备中最好的。如今没有任何技术能够为它附魔，即使最优秀的附魔师也做不到。";
		next;
		mes "[Illusion Enchanter]";
		mes "除非他愿意拿自己的身心健康冒险。";
		next;
		mes "[Illusion Enchanter]";
		mes "不过谁知道呢？也许将来你会遇到有能力处理这件珍贵装备的人。";
		close;
	}

	.@refine = getequiprefinerycnt(.@loc);
	.@card[0] = getequipcardid(.@loc,0);
	.@card[1] = getequipcardid(.@loc,1);
	.@card[2] = getequipcardid(.@loc,2);
	.@card[3] = getequipcardid(.@loc,3);

	switch(.@reset) {
	case false:
		.@item_req = 25271;	// IllusionStone
		.@item_req_count = 5;

		if (.@card[2] > 0 && .@card[3] > 0) {
			mes "[Illusion Enchanter]";
			mes "这件装备已经附魔到最大上限。";
			close;
		}
		if (.@weapon_lvl > 0) {
			mes "[Illusion Enchanter]";
			mes "你想添加哪种效果？";
			next;
			.@weapon_enchant_type = select( "近战", "远程", "魔法" );
		}
		mes "[Illusion Enchanter]";
		if (.@card[3] > 0) {
			.@slot = 2;
			.@string$ = "第二个";
		}
		else {
			.@slot = 3;
			.@string$ = "第一个";
		}
		mes "我会尝试为你的物品附魔" + .@string$ + " 属性。^ff0000现有精炼等级和卡片不会受到影响，即使本次尝试失败，装备也不会损坏。^000000要继续吗？";
		next;
		if (select( "我稍后再来。", "当然！" ) == 1) {
			mes "[Illusion Enchanter]";
			mes "没问题。改变主意后再回来。";
			close;
		}
		if (countitem(.@item_req) < .@item_req_count) {
			mes "[Illusion Enchanter]";
			mes "该物品需要" + .@item_req_count + " " + getitemname(.@item_req) + "，但你没有带齐我需要的材料。";
			close;
		}

		// anti-hack
		if (callfunc("F_IsEquipIDHack", .@loc, .@eq_id) || callfunc("F_IsEquipCardHack", .@loc, .@card[0], .@card[1], .@card[2], .@card[3]) || callfunc("F_IsEquipRefineHack", .@loc, .@refine))
			close;

		.@card[.@slot] = callsub( S_Enchant, .@loc_enchant, .@slot, .@weapon_enchant_type );
		delitem .@item_req, .@item_req_count;
		delequip .@loc;
		getitem2 .@eq_id,1,1,.@refine,0,.@card[0],.@card[1],.@card[2],.@card[3];
		mes "[Illusion Enchanter]";
		mes "完成了，请检查。";
		specialeffect2 EF_REPAIRWEAPON;
		close;

	case true:
		if (!F_IsCharm(.@card[2]) || !F_IsCharm(.@card[3])) {
			mes "[Illusion Enchanter]";
			mes "只有完成两次附魔的物品才能重置。请先附魔两次，如果仍想重置，再带来找我。";
			close;
		}
		mes "[Illusion Enchanter]";
		mes "重置成功率取决于你支付的Zeny数量。你想怎么做？";
		next;
		.@s = select( "我稍后再来。", "100,000 Zeny（50%）", "200,000 Zeny（60%）", "300,000 Zeny（70%）", "400,000 Zeny（80%）", "500,000 Zeny（90%）" ) - 1;
		if (.@s == 0) {
			mes "[Illusion Enchanter]";
			mes "没问题。改变主意后再回来。";
			close;
		}
		.@cost = 100000 * .@s;
		.@rate = 40 + 10 * .@s;

		if (Zeny < .@cost) {
			mes "[Illusion Enchanter]";
			mes "你的钱不够。";
			close;
		}

		// anti-hack
		if (callfunc("F_IsEquipIDHack", .@loc, .@eq_id) || callfunc("F_IsEquipCardHack", .@loc, .@card[0], .@card[1], .@card[2], .@card[3]) || callfunc("F_IsEquipRefineHack", .@loc, .@refine))
			close;

		Zeny -= .@cost;
		delequip .@loc;
		if (rand(100) < .@rate) {
			getitem2 .@eq_id,1,1,.@refine,0,.@card[0],.@card[1],0,0;
			mes "[Illusion Enchanter]";
			mes "完成了，请检查。";
			specialeffect2 EF_REPAIRWEAPON;
			close;
		}
		mes "[Illusion Enchanter]";
		mes "啊，真遗憾。好运不可能永远伴随你。";
		specialeffect2 EF_LORD;
		close;
	}
	end;


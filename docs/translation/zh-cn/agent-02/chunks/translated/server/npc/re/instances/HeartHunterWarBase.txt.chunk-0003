1@swat,56,283,1	script	Julian#6	4_M_REBELLION2,{
	mes "[Julian]";
	mes "这里的安全系统控制着那边的许多系统设备。";
	next;
	mes "[Julian]";
	mes "激活设备后会打开一条狭窄通道，你勉强可以通过。";
	next;
	mes "[Julian]";
	mes "不激活设备，防御训练就不会开始。准备好后再激活。";
	close;

OnStart:
	initnpctimer;
	npctalk "Julian：你轻松歼灭了第二区的升级部队。我最好改变防御战术。";
	end;
OnTimer6000:
	npctalk "Julian：顺便说，面前留下的防御装置与之前遇到的完全不同。";
	end;
OnTimer10000:
	npctalk "Julian：我大量安装 Heart Hunter 的安全系统，构建了自动防御系统。";
	end;
OnTimer16000:
	npctalk "Julian：目的是测试在防御战术中结合自动装置和部队时如何阻挡敌人。";
	end;
OnTimer20000:
	npctalk "Julian：操作我面前的控制器，第三区训练就会开始。";
	end;
OnTimer24000:
	stopnpctimer;
	npctalk "Julian：如果你通过狭窄通道并歼灭一半兵力，我就判定防御失败。";
	end;
}

1@swat,60,286,4	script	SWT_8309#1	4_SCR_MT_ROBOTS,{
	if ('status_instance != 1)
		end;
	mes "你看到一个异常醒目的";
	mes "红色按钮。";
	mes "---------------------";
	mes "^ff0000[不要按]^000000";
	next;
	if (select( "忽略", "按下" ) == 1) {
		mes "你忽略按钮并退后。什么也没发生。";
		close;

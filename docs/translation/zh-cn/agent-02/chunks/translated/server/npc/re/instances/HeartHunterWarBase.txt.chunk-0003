1@swat,151,266,0	warp	#wp_out	2,2,ein_fild04,279,339


// Entrance
1@swat,53,122,1	script	Julian#4	4_M_REBELLION2,{
	if (is_party_leader() == false) {
		mes "[Julian]";
		mes "我正在和你的队长交谈，" + strcharinfo(0) + "。";
		close;
	}
	mes "[Julian]";
	mes "" + strcharinfo(0) + "，这是你第一次来这里吗？";
	next;
	.@s = select( "是的。", "不是，我以前来过。" );
	if ('status_instance != 0)
		end;
	'status_instance = 1;
	if (.@s == 1)
		donpcevent instance_npcname("Julian#4_1") + "::OnStart";
	else
		donpcevent instance_npcname("Julian#4") + "::OnStart";
	end;

OnStart:
	disablenpc instance_npcname("Julian#4");
	enablenpc instance_npcname("Julian#4_1");
	npctalk "Julian：哦，我们到目前为止训练过多少次？", instance_npcname("Julian#4_1");
	initnpctimer;
	end;
OnTimer3000:
	npctalk "Julian：和之前一样，请像实战一样毫不留情地攻击。", instance_npcname("Julian#4_1");
	end;
OnTimer9000:
	stopnpctimer;
	disablenpc instance_npcname("Julian#4_1");
	donpcevent instance_npcname("#remaining_hunter2_step1") + "::OnStart";
	end;
}

1@swat,53,122,1	script	Julian#4_1	4_M_REBELLION2,{
	end;
OnStart:
	disablenpc instance_npcname("Julian#4");
	enablenpc instance_npcname("Julian#4_1");
	npctalk "Julian：你可能不熟悉这个地方。";
	initnpctimer;
	end;
OnTimer3000:
	npctalk "Julian：我们占领的区域后方有一片很大的空间。";
	end;
OnTimer7000:
	npctalk "Julian：虽然不能用它调动部队，但非常适合体验模拟战斗。";
	end;
OnTimer12000:
	npctalk "Julian：所以我们把它改造成训练场，进行类似之前战斗的模拟战。";
	end;
OnTimer17000:
	npctalk "Julian：你们将扮演入侵者。我们的部队会伪装成 Heart Hunter 进行防守。";
	end;
OnTimer22000:
	npctalk "Julian：这是一种防御训练，用来了解防守该区域需要多少兵力。";
	end;
OnTimer27000:
	npctalk "Julian：现在请像实战一样毫不留情地攻击。";
	end;
OnTimer33000:
	stopnpctimer;
	disablenpc instance_npcname("Julian#4_1");
	donpcevent instance_npcname("#remaining_hunter2_step1") + "::OnStart";
	end;
}

// Step 1
1@swat,1,1,1	script	#remaining_hunter2_step1	-1,{
	end;
OnStart:
	enablenpc instance_npcname("#remaining_hunter2_step1");
	.@label$ = instance_npcname("#remaining_hunter2_step1") + "::OnMobDead";
	mapannounce 'map_swat$, "检测到对基地的攻击。所有人开始防御战术。", bc_map,0xFF5555;
	for ( .@y = 145; .@y <= 199; .@y += 9 ) {
		for ( .@x = 28; .@x <= 48; .@x += 10 ) {
			monster 'map_swat$,.@x,.@y, "Heart Hunter Guard",3627,1, .@label$;	// EP16_2_H_HUNTER_MD
		}
	}
	end;
OnMobDead:
	.@label$ = instance_npcname("#remaining_hunter2_step1") + "::OnMobDead";
	if (rand(100) < 5)
		areamonster 'map_swat$, 28,145,48,199, "Upgraded Heart Hunter",3626,1, .@label$;		// EP16_2_H_HUNTER_V
	.@count = mobcount( 'map_swat$, .@label$ );
	mapannounce 'map_swat$, "剩余 Heart Hunter：" + .@count, bc_map,0xFFFFFF;
	if (.@count < 1)
		initnpctimer;
	end;
OnTimer1000:
	stopnpctimer;
	mapannounce 'map_swat$, "Julian：第一区已占领。负责第一区防御的人稍后在营房后集合。", bc_map,0xFF99;
	disablenpc instance_npcname("#remaining_hunter2_step1");
	enablenpc instance_npcname("#start2_1_1");
	end;
}


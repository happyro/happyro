OnStart:
	mapannounce 'map_swat$, "语音通信：我们已占领 Heart Hunter 通讯室。战斗似乎结束了。所有部队成员防守占领的据点并待命。", bc_map,0x77FFFF;
	initnpctimer;
	end;
OnTimer6000:
	npctalk "Julian：既然我们占领了通讯室，基本就算胜利了。我们似乎没有受到太大损伤。";
	end;
OnTimer11000:
	npctalk "Julian：主力部队还要一段时间才到。保持警惕并待命。";
	end;
OnTimer16000:
	mapannounce 'map_swat$, "？？？：谁在那里……？", bc_map,0xFF5555;
	end;
OnTimer20000:
	npctalk "Julian：什么？还有敌军？";
	end;
OnTimer24000:
	emotion ET_SURPRISE;
	npctalk "Julian：有东西来了！！躲开！！";
	end;
OnTimer28000:
	specialeffect EF_LORD, AREA, "Julian#3";
	cloakonnpc instance_npcname("Julian#3");	// cloakonnpc to display EF_LORD properly
	enablenpc instance_npcname("Ebel#1_1");
	npctalk "Ebel：我错过了吗……", instance_npcname("Ebel#1_1");
	end;
OnTimer32000:
	npctalk "Ebel：……你是谁？", instance_npcname("Ebel#1_1");
	end;
OnTimer36000:
	mapannounce 'map_swat$, "Julian：现在躲开敌人！她不是普通人类。", bc_map,0xFF99;
	end;
OnTimer40000:
	npctalk "Ebel：要逃跑吗？", instance_npcname("Ebel#1_1");
	end;
OnTimer45000:
	npctalk "Ebel：抱歉，逃不掉的。", instance_npcname("Ebel#1_1");
	end;
OnTimer50000:
	disablenpc instance_npcname("Ebel#1_1");
	enablenpc instance_npcname("#wp_b1_1");
	enablenpc instance_npcname("#wp_b1_2");
	enablenpc instance_npcname("#wp_b1_3");
	enablenpc instance_npcname("#wp_b1_4");
	enablenpc instance_npcname("#wp_b1_5");
	donpcevent instance_npcname("#hunter_instance_ebel") + "::OnStart";
	end;
OnTimer53000:
	mapannounce 'map_swat$, "Julian：可恶，逃跑很难。", bc_map,0xFF99;
	end;
OnTimer56000:
	mapannounce 'map_swat$, "Julian：嘿！我会从远处支援你。坚持到那时！", bc_map,0xFF99;
	end;
OnTimer64000:
	mapannounce 'map_swat$, "Julian：再坚持一会儿。我正在准备压制她。", bc_map,0xFF99;
	end;
OnTimer71000:
	mapannounce 'map_swat$, "Julian：快完成了！坚持住！", bc_map,0xFF99;
	end;
OnTimer80000:
	mapannounce 'map_swat$, "Julian：很好！离她远点！让我给她致命一击！", bc_map,0xFF99;
	end;
OnTimer82000:
	donpcevent instance_npcname("#hunter_instance_ebel") + "::OnStop";
	specialeffect EF_LORD, AREA, instance_npcname("#expl1");
	end;
OnTimer83000:
	specialeffect EF_LORD, AREA, instance_npcname("#expl2");
	end;
OnTimer84000:
	specialeffect EF_LORD, AREA, instance_npcname("#expl3");
	end;
OnTimer85000:
	specialeffect EF_LORD, AREA, instance_npcname("#expl4");
	stopnpctimer;
	donpcevent instance_npcname("Julian#3_1") + "::OnStart";
	end;
}

1@swat,1,1,0	script	#hunter_instance_ebel	HIDDEN_WARP_NPC,{
	end;
OnStart:
	enablenpc instance_npcname("#hunter_instance_ebel");
	monster 'map_swat$,315,47, "Heart Hunter Ebel",3628,1, instance_npcname("#hunter_instance_ebel") + "::OnMobDead";	// EP16_2_H_HUNTER_EV
	'boss_id = $@mobid[0];
	initnpctimer;
	end;
OnTimer7000:
	unittalk 'boss_id, "这伤不到我……";
	end;
OnTimer14000:
	unittalk 'boss_id, "你……太慢。";
	end;
OnTimer21000:
	unittalk 'boss_id, "弱……";
	end;
OnTimer30000:
	unittalk 'boss_id, "Weak...";
	end;
OnStop:
	killmonster 'map_swat$, instance_npcname("#hunter_instance_ebel") + "::OnMobDead";
	// continue
OnMobDead:
	'boss_id = 0;
	stopnpctimer;
	disablenpc instance_npcname("#hunter_instance_ebel");
	end;
}

1@swat,315,47,3	script	Ebel#1_1	4_F_HUNTER_EVIL,{
	cutin "ep16_evil101.bmp",2;
	mes "[Ebel]";
	mes "你……敌人？我们的部队？你站在哪一边？";
	close3;
}

1@swat,320,47,4	script	Julian#3_1	4_M_REBELLION2,{
	end;
OnStart:
	enablenpc instance_npcname("Julian#3_1");
	enablenpc instance_npcname("Ebel#1_3");
	npctalk "Julian：很高兴你们都安全。";
	initnpctimer;
	end;
OnTimer3000:
	npctalk "Ebel：你刚才使用的是什么？", instance_npcname("Ebel#1_3");
	end;
OnTimer6000:
	npctalk "Julian：那是麻痹射击。命中目标时会扰乱神经系统。";
	end;
OnTimer10000:
	npctalk "Ebel：你为什么不杀我？", instance_npcname("Ebel#1_3");
	end;
OnTimer13000:
	npctalk "Julian：我不想同时杀死自己人。而且……你对我们来说是未知力量。";
	end;
OnTimer18000:
	npctalk "Julian：我们必须活捉你，查清你的情况。";
	end;
OnTimer22000:
	enablenpc instance_npcname("#ext1_1");
	enablenpc instance_npcname("#ext1_2");
	end;
OnTimer23000:
	npctalk "外围的所有残余敌军已经清除。", instance_npcname("#ext1_1");
	end;
OnTimer25000:
	npctalk "主力部队将在五分钟后抵达。", instance_npcname("#ext1_2");
	end;
OnTimer30000:
	npctalk "Julian：很好。把她关进牢房。她是研究对象，要小心处理。";
	end;
OnTimer35000:
	npctalk "是！", instance_npcname("#ext1_1");
	end;
OnTimer36000:
	npctalk "明白了。", instance_npcname("#ext1_2");
	end;
OnTimer40000:
	stopnpctimer;
	disablenpc instance_npcname("Ebel#1_3");
	disablenpc instance_npcname("#ext1_1");
	disablenpc instance_npcname("#ext1_2");
	disablenpc instance_npcname("Julian#3_1");
	enablenpc instance_npcname("Julian#3_2");
	end;
}

1@swat,308,49,6	duplicate(dummy_npc)	#ext1_1	4_F_ESTLOVELOY
1@swat,308,45,6	duplicate(dummy_npc)	#ext1_2	4_F_ESTLOVELOY

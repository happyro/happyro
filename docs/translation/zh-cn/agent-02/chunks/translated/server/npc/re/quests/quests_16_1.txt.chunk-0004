		cutin "ep16_nihi_miseria_heine04",2;
		mes "[Nyhill]";
		mes "……我喝醉了吗？";
		mes "我的头好痛。";
		mes "……我感觉头晕……";
		next;
		cutin "ep16_skia_nerius01",0;
		mes "[Skia]";
		mes "你为什么会在这里？";
		next;
		cutin "ep16_nihi_miseria_heine01",2;
		mes "[Nyhill]";
		mes "……哦……我感觉有些醉了，就让侍从带我去可以休息的地方。";
		mes "……嗯……";
		next;
		cutin "ep16_nihi_miseria_heine04",2;
		mes "[Nyhill]";
		mes "他说那是低度香槟……";
		mes ".....";
		next;
		select("你发生什么事了吗？");
		cutin "ep16_nihi_miseria_heine01",2;
		mes "[Nyhill]";
		mes "我不记得了。";
		mes "我记得这里好像有位客人……";
		mes "话说回来，你为什么会来这里？";
		next;
		cutin "ep16_skia_nerius01",0;
		mes "[Skia]";
		mes "嗯，时间快到了，所以……";
		unittalk getcharid(3), "" + strcharinfo(0) + "：时间？", bc_self;
		next;
		cutin "ep16_nihi_miseria_heine01",2;
		mes "[Nyhill]";
		mes "这样啊。我想准备工作现在应该都完成了。";
		mes "我可不能再浪费时间待在这里。";
		next;
		mes "[Nyhill]";
		mes "我该回去了。";
		mes "呼……幸好我的头脑清醒多了。";
		next;
		mes "[Nyhill]";
		mes "那么，失陪了。";
		next;
		cloakonnpcself( "Unstable Nyhill#ep16_7690" );
		cutin "ep16_skia_nerius03",0;
		mes "[Skia]";
		mes "哇！他跑得真快。";
		mes "好了，英雄。我们也回去吧？";
		mes "不过我们很快还会再见的。";
		next;
		cutin "ep16_skia_nerius01",0;
		mes "[Skia]";
		mes "宫廷魔法师现在应该已经到了。";
		mes "你应该回自己的房间。";
		erasequest 7690;// Where Is Nyhill?
		setquest 7691;// Waiting for the Ritual
		ep16_royal = 7;
		close3;
	}
	else {
		if (strnpcinfo(0) == "Skia Nerius#ep16_7690")
				npctalk "我们也该回去了。", "Skia Nerius#ep16_7690", bc_self;
		end;
	}
}
prt_cas,27,34,3	duplicate(Skia Nerius#ep16_7690)	Unstable Nyhill#ep16_7690	4_EP16_NIHIL

prt_cas,27,43,0	script	#ep16_evt_7690	HIDDEN_WARP_NPC,1,1,{
	end;
OnTouch:
	if (ep16_royal == 6) {
		cloakoffnpcself( "Unstable Nyhill#ep16_7690" );
		cloakoffnpcself( "Skia Nerius#ep16_7690" );
		setpcblock PCBLOCK_NPC, true;
		sleep2 1000;
		setpcblock PCBLOCK_NPC, false;
			npctalk "你没事吧？", "Skia Nerius#ep16_7690", bc_self;
	}
	end;
OnInit:
	cloakonnpc "Skia Nerius#ep16_7690";
	cloakonnpc "Unstable Nyhill#ep16_7690";
	end;
}

// prt_lib
prt_lib,76,80,3	script	Lindt the Librarian#ep16_lindt	1_M_01,{
	if (ep16_royal == 11) {
		mes "[图书管理员]";
		mes "你想看看这份资料吗？";
		mes "我还没有收起来，所以它还在这里。";
		next;
		mes "这份文件是关于意识之室的王室记录。";
		npctalk "不过应该也没什么用……", "", bc_self;
		next;
		mes "中间夹着几页空白页。";
		unittalk getcharid(3), "" + strcharinfo(0) + "：为什么这里会有空白页？", bc_self;
		next;
		mes "[图书管理员]";
		mes "读读上面写的文字。";
		mes "没错，就是这里。";
		next;
		mes "[图书管理员]";
		mes "^4d4dff只有知晓真相的人才能读到这段文字。^000000";
		mes "看到了吗？";
		next;
		mes "[图书管理员]";
		mes "考虑到已经过去的时间，现在应该没有知晓这个真相的人了。";
		mes "换句话说，这部分将永远成为谜团。";
		next;
		mes "[图书管理员]";
		mes "所以斯托尔兹大公放弃后离开了。";
		mes "既然你已经看到了，那我把它放回原处。";
		ep16_royal = 12;
		close;
	}
	if (ep16_royal == 22) {
		mes "[图书管理员]";
		mes "哦，你来了。";
		mes "格兰兹大公已经等你一会儿了。";
		close;
	}
	mes "[图书管理员]";
	mes "我们家族世代负责管理王室往事。";
	mes "毕竟这里是王室专属的文书馆。";
	next;
	mes "[图书管理员]";
	mes "我接任这个职位还没多久，所以其实还不太习惯。";
	mes "我没想到会有这么多大公前来拜访……";
	close;
}

prt_lib,91,85,3	script	Mage Nillem#ep16_warp	4_M_JOB_WIZARD,{
	if (ep16_royal < 8)
		end;
	switch( ep16_royal ) {
	case 8:
		if (getcharid(1) == 0 || is_party_leader() == false) {// solo instance
			mes "^4d4dff这是通过纪念仪式进行的活动。";
			mes "只有队长才能进行纪念仪式。请组建队伍后再试。^000000";
			close;
		}
		mes "[Nillem]";
		mes "呼，你看到了吗？我们是最后进入的人。";
		mes "其他人应该已经进去了。";
		next;
			if (select( "现在进入。", "暂不进入。" ) == 2) {
			mes "[Nillem]";
			mes "哈哈，太晚了也不太好……";
			close;
		}
		if (instance_create("Ritual of Blessing") < 0) {
			mes "[Nillem]";
			mes "嗯？我不知道发生了什么。我们现在似乎进不去了。";
			mes "这是一个只有展现魔力后才会开启的秘密区域。";
			next;
			mes "[Nillem]";
			mes "等它稳定下来吧。";
			close;
		}
		mes "[Nillem]";
		mes "哇！通往下一个区域的门启动了！";
		mes "好了，我们进去吧！";
		cloakoffnpcself( "Room of Consciousness#evt_gate01" );
		close;
	case 9:
		mes "[Nillem]";
		mes "里面发生什么事了吗？";
		mes "究竟是怎么回事……";
		next;
		mes "[Nillem]";
		mes "那不是我该知道的事，也不是我该参与的地方。不过我还是很好奇。";
		next;
		mes "[Nillem]";
		mes "魔力流动似乎很奇怪。";
		mes "……我觉得那扇门不稳定，不知道是不是我的错觉。";
		close;
	case 10:
		mes "[Nillem]";
		mes "哦，这可麻烦了。";
		mes "门现在似乎出了问题。";
		next;
		mes "[Nillem]";
		mes "这个区域限制使用魔法。我能做的只有启动这里的门……";
		next;
		select("你到底想说什么……");
		mes "[Nillem]";
		mes "哦，我是说……";
		mes "你应该从这里步行出去。";
		mes "既然事情变成这样了。";
		next;
		mes "[Nillem]";
		mes "^4d4dff这是大公刚才看过的资料。^000000";
		mes "" + strcharinfo(0) + "，你也来看看吧？";
		next;
		mes "[Nillem]";
		mes "嗯，我才不是对此感到好奇。";
		npctalk "（其实我真的很好奇……！）", "", bc_self;
		next;
		mes "[Nillem]";
		mes "只是出于好奇……不，我是说出于研究热情。哈哈……";
		mes "……什么？一起看看吧……记得把里面的内容告诉我——";
		next;
		mes "[Nillem]";
		mes "你不好奇吗？";
		mes "既然你和大公一起来了，图书管理员肯定会给你看的。";
		next;
		mes "[Nillem]";
		mes "我会想办法重新启动这扇门。";
		ep16_royal = 11;
		setquest 7694;// I'd Like to See that Too
		close;
	case 11:
		mes "[Nillem]";
		mes "你不好奇吗？";
		mes "既然你和大公一起来了，图书管理员肯定会给你看的。";
		next;
		mes "[Nillem]";
		mes "我会想办法重新启动这扇门。";
		close;
	case 12:
		mes "[Nillem]";
		mes "……算了。^4d4dff只有知晓真相的人才能开启^000000……";
		mes "啊，真是浪费。";
		next;
		mes "[Nillem]";
		mes "嗯，继续留在这里也没用。";
		mes "刚才的气氛简直紧张得像能用刀切开。我们现在出去吧。";
		next;
		mes "[Nillem]";
		mes "我观察了一下那扇门。";
		mes "里面之前发生过大规模的魔力爆炸吗？";
		next;
		mes "[Nillem]";
		mes "我感受到某种魔力扭曲，和……";
		mes "^4d4dff次元裂隙^000000很相似！";
		next;
		mes "[Nillem]";
		mes "我们能在这里制造次元之门吗？";
		mes "那也会很有趣。";
		unittalk getcharid(3), "" + strcharinfo(0) + "：那我们要怎么出去？", bc_self;
		next;
		mes "[Nillem]";
		mes "对了。";
		mes "既然这扇门已经没用了……";
		mes "我们走出去吧。";
		next;
		mes "[Nillem]";
		mes "你看到那边的十字军了吗？";
		mes "他负责管理入口。";
		mes "他会带你出去。";
		erasequest 7694;// I'd Like to See that Too
		setquest 7695;// Escape from the Past Memories of the Royal Family
		ep16_royal = 13;
		close;
	case 13:
	case 14:
	case 15:
	case 16:
	case 17:
		mes "[Nillem]";
		mes "虽然为了方便，宫殿里设置了直达的门，";
		mes "但也有可以直接步行通过的通道。";
		next;
		mes "[Nillem]";
		mes "这是难得一次使用秘密通道的机会。";
		mes "哈哈哈哈……";
		close;
	case 18:
		mes "[Nillem]";
		mes "哈哈，我要准备好了吗？";
		mes "到这里来！^4d4dff次元转移装置 MkII^000000！";
		next;
		mes "[Nillem]";
		mes "好了，我们走吧，尊贵的客人。";
		mes "不知道这次会看到什么！";
		setquest 7700;// Once More!
		erasequest 7699;// To the Past
		cloakoffnpcself( "Dimension Warper MkII#ep16_lib" );
		close;
	case 19:
	case 20:
	case 21:
		mes "[Nillem]";
		mes "我们还没有解开所有秘密！";
		mes "好了，我们得回去了！";
		next;
		cloakoffnpcself( "Dimension Warper MkII#ep16_lib" );
		mes "[Nillem]";
		mes "这次一定要彻底解决！";
		close;
	case 22:
		mes "[Nillem]";
		mes "你在做什么？";
		mes "去追问图书管理员，把真相挖出来！";
		next;
		cloakoffnpcself( "Kronecker G. Heine#ep16_01_lib01" );
		mes "[Nillem]";
		mes "我们费了这么大劲是为了什么？";
		mes "看，格兰兹大公在那里。";
		close;
	case 23:
		mes "[Nillem]";
		mes "^4d4dff海涅家族会获准进入‘王室往事’^000000，对吧？";
		mes "从今以后我们就能更常见面了。";
		mes "哈哈，这一定就是别人所说的命运吧——？";
		next;
		mes "[Nillem]";
		mes "你在做什么？";
		mes "我们去见^4d4dff弗里德里希公爵，确认许可是否已经下达吧！^000000";
		close;
	default:
		mes "[Nillem]";
		mes "今天我们又要一起进行秘密旅行了！";
		mes "哈哈哈。你最好兴奋起来！";
		mes "我会让你享受头等舱待遇！";
		next;
		mes "[Nillem]";
		mes "好了，我们走吧，尊贵的客人。";
		mes "今天会有什么在等着我们呢？";
		mes "不过我猜这次又会以失败告终。";
		mes "哈哈哈——";
		cloakoffnpcself( "Dimension Warper MkII#ep16_lib" );
		close;
	}
}

prt_lib,88,90,1	script	Room of Consciousness#evt_gate01	PORTAL,{
	if (getcharid(1) == 0 || is_party_leader() == false) {
		mes "^4d4dff只有队长才能进入副本［祝福仪式］。^000000";
		close;
	}
	if (ep16_royal == 8) {
		mes "你可以前往举行祝福仪式的地方。";
		next;
		if (select( "进入。", "暂不进入。" ) == 2) {
			mes "[Nillem]";
			mes "嗯……这扇门只是暂时启动，无法维持太久。";
			close;
		}
		if (getcharid(1) == 0 || is_party_leader() == false) {
			mes "^4d4dff只有队长才能进入副本［祝福仪式］。^000000";
			close;
		}
		switch( instance_enter("Ritual of Blessing") ) {
		case IE_OTHER:
			mes "[Nillem]";
			mes "哦，魔力的流动似乎不太稳定。";
			mes "嗯，我们稍后再试试吧？";
			close;
		case IE_NOINSTANCE:
			mes "[Nillem]";
			mes "通往举行仪式地点的门还没有正式启动。";
			mes "请稍等。";
			close;
		case IE_NOMEMBER:
			mes "^4d4dff这是通过纪念仪式进行的活动。";
			mes "只有队长才能进入。^000000";
			close;
		case IE_OK:
			mapannounce "prt_lib", "队伍成员" + strcharinfo(0) + "（队伍：" + getpartyname( getcharid(1) ) + "）进入了祝福仪式。", bc_map,0xFF99,FW_NORMAL,12;
			//warp "2@mir",101,12;
			end;
		}
		end;
	}
	npctalk "现在无法使用！", "Mage Nillem#ep16_warp", bc_self;
	end;
OnInit:
	cloakonnpc "Room of Consciousness#evt_gate01";
	end;
}

prt_lib,56,61,4	script	Guardian Knight#ep16_roomguard	4_M_CRU,{
	if (ep16_royal < 13)
		npctalk "正在值勤。一切正常。", "", bc_self;
	else {
		mes "[守护骑士]";
		mes "你要通过通道出去吗？";
		mes "我准备送你去的地方还有另一位守卫。";
		next;
		mes "[守护骑士]";
		mes "别被吓到，在他的帮助下你就能出去。";
		next;
		if (select( "现在出去。", "稍后再出去。" ) == 2) {
			mes "[守护骑士]";
			mes "你需要的时候我随时都可以送你出去。";
			mes "只是别在这里浪费太多时间。";
			close;
		}
		mes "[守护骑士]";
		mes "我现在就带你过去。";
		close2;
		warp "prt_pri00",60,127;
	}
	end;
}

prt_lib,88,80,0	script	#ep16_lib_evt01	HIDDEN_WARP_NPC,1,1,{
	end;
OnTouch:
	if (ep16_royal == 9) {
		cloakoffnpcself( "Ian Walther#ep16_lib01" );
		cloakoffnpcself( "Levuiere Wigner#ep16_lib01" );
		cloakoffnpcself( "Maximilian Roegenburg#ep16_lib01" );
		cloakoffnpcself( "Kronecker G. Heine#ep16_01_lib01" );
		cloakoffnpcself( "Nyhill M. Heine#ep16_lib01" );
		setpcblock PCBLOCK_NPC, true;
		sleep2 2000;
		 npctalk "你终于来了。", "Ian Walther#ep16_lib01", bc_self;
		sleep2 3000;
		setpcblock PCBLOCK_NPC, false;
		 npctalk "特别的客人，我有些事要告诉你。", "Ian Walther#ep16_lib01", bc_self;
	}
	if (ep16_royal == 22)
		cloakoffnpcself( "Kronecker G. Heine#ep16_01_lib01" );
	end;
OnInit:
	cloakonnpc "Ian Walther#ep16_lib01";
	cloakonnpc "Levuiere Wigner#ep16_lib01";
	cloakonnpc "Maximilian Roegenburg#ep16_lib01";
	cloakonnpc "Kronecker G. Heine#ep16_01_lib01";
	cloakonnpc "Nyhill M. Heine#ep16_lib01";
	end;
}

prt_lib,80,79,3	script	Kronecker G. Heine#ep16_01_lib01	4_EP16_GRANZ,{
	if (ep16_royal == 22) {
		cutin "ep16_kronecker_granz_heine",2;
		mes "[Kronecker]";
		mes "你发现什么了吗？";
		next;
		select("告诉他你看到的一切。");
		mes "[Kronecker]";
		mes "……竟然发生过这种事？";
		mes "普隆德拉确实有过这场灾难的记录。";
		next;
		mes "[Kronecker]";
		mes "我不知道意识之室里的伊米尔之心被女武神偷走了！";
		mes "为什么没有记录这种事？";
		next;
		mes "[Kronecker]";
		mes "那么现在你能读这份文件了吗？";
		mes "如果你看到的是真的，封印应该已经解开了。";
		next;
		cutin "",255;
		mes "当你触碰克罗内克给你的书的空白页时，";
		mes "文字伴随着光芒浮现出来。";
		next;
		mes "^4d4dff......";
		mes "由于女武神之战，封印在意识之室里的伊米尔之心消失了。";
		next;
		mes "王室持有的正统象征消失了，这让我感到恐惧。";
		mes "我担心加冕仪式上我们将无法看到特拉·格洛丽亚的光芒。";
		next;
		mes "问题会从下一次加冕仪式开始出现。";
		mes "如果国王加冕时没有得到大地的祝福，王国人民会感到沮丧，也会担忧自己的未来。";
		next;
		mes "为此我咨询了大贤者瓦尔蒙特。";
		mes "他说他可以帮忙，并在意识之室里安装了某种装置。";
		next;
		mes "看到那里安装的东西与特拉·格洛丽亚产生反应，我很惊讶。";
		mes "它为特拉·格洛丽亚的祝福之星提供了足够的魔力，";
		next;
		mes "于是特拉·格洛丽亚便能像往常一样赐予大地祝福。";
		next;
		mes "一切都没问题。";
		mes "即使那是靠假的伊米尔之心实现的。";
		next;
		mes "特拉·格洛丽亚，我们美丽的王冠。";
		mes "在受到祝福的王冠中，还留有一块世代守护普隆德拉的伊米尔之心。";
		next;
		mes "这就够了。";
		mes "这对我们的后代来说也足够了。";
		next;
		mes "因此，我不希望其他任何人读到这份记录，";
		mes "并用一个无法满足的条件将其封印。";
		next;
		mes "如果我们的后代中有人碰巧读到了这份记录，";
		mes "一定要守护好特拉·格洛丽亚。";
		mes "这是我们仅剩的最后一块伊米尔之心。^000000";
		next;
		mes "......";
		next;
		select("就这些了……");
		mes "[Nillem]";
		mes "我现在要被杀了吗？";
		mes "我想我刚刚已经发现了王室的所有秘密。";
		mes "你不打算处决我吗？";
		next;
		mes "[Kronecker]";
		mes "…………嗯……";
		mes "如果你愿意，我会满足你的愿望。";
		mes "但不是现在。";
		next;

}

job_gun,86,29,3	script	Kulbertinov	4_M_REBELLION,{
	if (Class == Job_Rebellion) {
		mes "[Kulbertinov]";
	mes "你想见老板吗？";
		next;
		if (select("Yes.:No.") == 1) {
			close2;
			warp "job_gun",220,130;
			end;
		}
		end;
	}
	if (Class != Job_Gunslinger) {
		mes "[Kulbertinov]";
	mes "你在找我吗？";
		close;
	}
	switch( isbegin_quest(12340) ) {
	case 0:
		mes "[Kulbertinov]";
	mes "我能帮你吗？";
		close;
	case 1:
		mes "[Kulbertinov]";
	mes "你想要什么？";
		next;
		select("I'm mistaken for a criminal!.");
		mes "[Kulbertinov]";
	mes "等一下……哇哈哈哈！";
		next;
	mes "^0000ff他扫描你的脸，然后大笑起来。^000000";
		next;
		mes "[Kulbertinov]";
	mes "抱歉。我刚才以为Spike死而复生了。他三天前被发现死亡。";
		next;
		select("He was captured already?");
		mes "[Kulbertinov]";
	mes "是的，赏金猎人已经拿到报酬。消息还没传开，而你和他一模一样。真是奇怪。";
		next;
		select("You have to do something!");
		mes "[Kulbertinov]";
	mes "抱歉，我不能替你和每个赏金猎人交涉。当然，我愿意补偿你的不便。";
		next;
		mes "[Kulbertinov]";
	mes "嘿，要不要加入我们的行列？至少你不会被枪杀。";
		next;
		select("你想让我成为赏金猎人吗？");
		mes "[Kulbertinov]";
	mes "不，赏金猎人只是消遣。我们才是世界上所有枪械的专家。";
		next;
		mes "[Kulbertinov]";
	mes "无拘无束的灵魂！";
	mes "神奇的爆脾气！";
	mes "我们称自己为^0000ff反叛者^000000。";
		next;
		mes "[Kulbertinov]";
	mes "你看起来很会用枪。要加入我们吗？以后也不用担心其他赏金猎人。";
		next;
		if (select("Let me think it over.:I don't think I have a choice.") == 1) {
			mes "[Kulbertinov]";
			mes "你可以反复考虑，但答案不会改变。接受邀请吧。";
		}
		else {
			mes "[Kulbertinov]";
			mes "想得好。不如现在就做决定，结束这件事。";
		}
		next;
		mes "[Kulbertinov]";
	mes "去和Enwin Conick谈谈。她会引导你这样的漂泊灵魂走上反叛者之路。我会通知她。啊，别把枪指着她。";
		completequest 12340;
		setquest 12341;// Rebellion Job Change Quest
		close2;
		warp "job_gun",19,15;
		end;
	case 2:
		mes "[Kulbertinov]";
		mes "你找Elwin Conick有事吗？";
		next;
		if (select("No.:Send me to Elwin Conick.") == 1) {
			mes "[Kulbertinov]";
			mes "好吧。来一杯伏特加吗？";
			close;
		}
		mes "[Kulbertinov]";
		mes "好的，我会告诉她。";
		close2;
		warp "job_gun",19,15;
		end;
	}
}

job_gun,19,24,3	script	Elwin Conick#1	4_F_REBELLION,{
	if (Class != Job_Gunslinger) {
		mes "[Elwin Conick]";
		mes "如果你不想加入反叛者，就出去。";
		close2;
		warp "job_gun",81,29;
		end;
	}
	if (isbegin_quest(12341) == 1) {
		mes "[Elwin Conick]";
		mes "你想加入我们反叛者吗？";
		next;
		mes "^0000ff这个身材矮小、目光锐利的女人注视着你的眼睛。^000000";
		next;
		mes "[Elwin Conick]";
		mes "在这里签字。";
		next;
		mes "^0000ff签署人‘_____’承诺，即使在测试中遭遇意外而受伤、残疾或死亡，也不会透露测试内容。^000000";
		next;
		select("WHAT?!");
		mes "[Elwin Conick]";
		mes "你到底要不要加入？";
		next;
		if (select("I give up.:...I'll sign.") == 1) {
			mes "[Elwin Conick]";
		mes "随你的选择。";
			close2;
			warp "job_gun",81,29;
			end;
		}
		mes "[Elwin Conick]";
		mes "很好。现在跟我来。";
		close2;
		warp "job_gun",117,41;
		end;
	}
	if (isbegin_quest(12342) == 1) {
		mes "[Elwin Conick]";
		mes "你想再试一次吗？";
		next;
		if (select("I give up.:Do it.") == 1) {
			mes "[Elwin Conick]";
			mes "随你的选择。";
			close2;
			warp "job_gun",81,29;
			end;
		}
		mes "[Elwin Conick]";
		mes "跟我来。";
		close2;
		warp "job_gun",117,41;
		end;
	}
	if (isbegin_quest(12343) > 0) {
		mes "[Elwin Conick]";
		if (isbegin_quest(12343) == 1)
			mes "你还要进行Ivan的射击测试，要再试一次吗？";
		else
			mes "Ivan的射击测试还没完成，要再试一次吗？";
		next;
		if (select("I give up.:Do it.") == 1) {
			mes "[Elwin Conick]";
			mes "不值得放弃，现在出去放松一下吧。";
			close2;
			warp "job_gun",81,29;
			end;
		}
		mes "[Elwin Conick]";
		mes "记得全力以赴。";
		close2;
		warp "job_gun",120,130;
		end;
	}
	if (isbegin_quest(12345) == 1) {
		mes "[Elwin Conick]";
		mes "Ivan在等你，去找他吧。";
		close2;
		warp "job_gun",81,29;
		end;
	}
	mes "[Elwin Conick]";
	mes "你没有要参加的测试了。为什么不出去喝一杯？";
	close2;
	warp "job_gun",81,29;
	end;
}

job_gun,117,46,3	script	Elwin Conick#2	4_F_REBELLION,{
	if (Class != Job_Gunslinger) {
		mes "[Elwin Conick]";
		mes "如果你不想加入反叛者，就出去。";
		close2;
		warp "job_gun",81,29;
		end;
	}
	.@emt_chk = getstatus(SC_MONSTER_TRANSFORM,1);
	.@quest_12341 = isbegin_quest(12341);
	.@quest_12342 = isbegin_quest(12342);
	if (.@emt_chk == 3169) {
		mes "^0000ff你已经处于测试形态。如果完成了所有测试，请向议事厅的埃尔温·科尼克报告。^000000";
		close;
	}
	if (.@emt_chk) {
		mes "[Elwin Conick]";
		mes "看看你自己，你真的想测试吗？";
		next;
		mes "^0000ff埃尔温看到你变成了另一种形态，非常生气。等当前形态结束后再来找她。^000000";
		next;
		if (select("Wait.:Go away.") == 2) {
			mes "[Elwin Conick]";
			mes "不处于任何形态时再回来。";
			close2;
			warp "job_gun",81,29;
			end;
		}
		mes "[Elwin Conick]";
		mes "不值得放弃，现在出去放松一下吧。";
		close;
	}
	if (.@quest_12341 == 1 || .@quest_12342 == 1) {
		if (countitem(6746)) {
			mes "[Elwin Conick]";
			mes "测试结束后必须归还所有剩余的钢铁材料。";
			delitem 6746,countitem(6746);// Steel_Article
			close;
		}
		if (countitem(6747)) {
			mes "[Elwin Conick]";
			mes "测试结束后必须归还所有剩余的钢铁材料。";
			delitem 6747,countitem(6747);// Steel_Article_
			close;
		}
		if ((countitem(13118) - isequipped(13118)) > 0) {
			mes "[Elwin Conick]";
			mes "时间到了。你测试失败。把剩余的测试材料交给我。";
			delitem 13118,1;// Tiny_Flame
			close;
		}
		if (.@quest_12342 == 1)
			.@menu$ = "Got it.";
		else {
			.@menu$ = "Okay.";
			setquest 12342;// Rebellion Job Change Quest
			completequest 12341;
		}
		mes "[Elwin Conick]";
		mes "听好了。我不会费力向你详细解释测试。";
		next;
		select( .@menu$ );
		mes "[Elwin Conick]";
		if (.@quest_12341 == 1) {
			mes "这里是铸造枪械模具的地方。你看到的钢铁材料都在这里生产。";
			next;
			mes "[Elwin Conick]";
			mes "我们反叛者本质上都是武器专家。在这里你会学习制作和组装枪械。";
			next;
			mes "[Elwin Conick]";
			mes "你需要操作入口附近的熔炉控制器，并选择5个标准钢铁材料。";
			next;
			mes "[Elwin Conick]";
			mes "然后把它们带到下一个装配室，组装成枪械。你有3分钟完成全部工作。最好快而专注，否则会测试失败。";
			next;
			mes "[Elwin Conick]";
			mes "我会在下一个房间等你带来完整枪械。为了检查经过的时间，你会变成另一种职业。^0000ff如果超过3分钟并恢复正常，就回来重新开始测试。^000000";
		}
		else {
			mes "你需要操作机器上的开关，并选择5个标准钢铁材料。";
			next;
			mes "[Elwin Conick]";
			mes "然后把它们带到下一个装配室，组装成完整枪械。你有3分钟完成。^0000ff为了检查经过的时间，你会变成另一种职业^000000。";
			next;
			mes "[Elwin Conick]";
			mes "我会在下一个房间等你带来完整枪械。记住，^0000ff3分钟后变身结束，你就会测试失败^000000。";
		}
		transform 3169,180000;
		close;
	}
	mes "[Elwin Conick]";
	mes "啊？你迷路了吗？先登记，然后再回到这里。";
	close2;
	warp "job_gun",81,29;
	end;
}

job_gun,198,39,3	script	Elwin Conick#3	4_F_REBELLION,{
	if (Class != Job_Gunslinger) {
		mes "[Elwin Conick]";
		mes "如果你不想加入反叛者，就出去。";
		close2;
		warp "job_gun",81,29;
		end;
	}
	if (isbegin_quest(12342) == 1) {
		.@emt_chk = getstatus(SC_MONSTER_TRANSFORM,1);
		if (.@emt_chk == 3169) {
			if ((countitem(13118) - isequipped(13118)) < 1) {// don't count if equipped
				mes "[Elwin Conick]";
		mes "完成了吗？我没在你的物品栏看到完整枪械。";
				close;
			}
			mes "[Elwin Conick]";
		mes "虽然粗糙，但考虑到时间还不错。你通过了。";
			delitem 13118,1;// Tiny_Flame
			next;
			mes "[Elwin Conick]";
		mes "把剩余的测试材料都交给我。";
			delitem 6746,countitem(6746);// Iron_Artifact
			delitem 6747,countitem(6747);// Steel_Artifact
			next;
			mes "[Elwin Conick]";
		mes "现在你可以进入下一课程。Ivan Sidorenko会负责你的测试。";
			completequest 12342;
			close2;
			warp "job_gun",120,133;
			end;
		}
		if (.@emt_chk) {
			mes "[Elwin Conick]";
		mes "看看你自己，你真的想测试吗？";
			next;
			mes "^0000ff埃尔温看到你变成了另一种形态，非常生气。等当前形态结束后再来找她。^000000";
			next;
			if (select("Wait.:Go away.") == 2) {
				mes "[Elwin Conick]";
			mes "不处于任何形态时再回来。";
				close2;
				warp "job_gun",81,29;
				end;
			}
			mes "[Elwin Conick]";
		mes "不值得放弃，现在出去放松一下吧。";
			close;
		}
		mes "[Elwin Conick]";
		mes "时间到了。你测试失败。把剩余的测试材料交给我。";
		delitem 6746,countitem(6746);// Iron_Artifact
		delitem 6747,countitem(6747);// Steel_Artifact
		delitem 13118,(countitem(13118) - isequipped(13118));// Tiny_Flame
		next;
		mes "[Elwin Conick]";
		mes "我们重新开始吧。";
		close2;
		warp "job_gun",117,41;
		end;
	}
	mes "[Elwin Conick]";
	mes "啊？你迷路了吗？先登记，然后再回到这里。";
	close2;
	warp "job_gun",81,29;
	end;
}

job_gun,165,18,0	script	Furnace Controller#1	CLEAR_NPC,{
	if (Class != Job_Gunslinger) {
		mes "只有授权用户可以操作。";
		close;
	}
	if (getstatus(SC_MONSTER_TRANSFORM,1) == 3169) {// J_REB_SHECIL1
		if (isbegin_quest(12342) == 1) {
			mes "要从熔炉中捞出模具吗？";
			next;
			if (select("Quit.:Begin.") == 1) {
				mes "切换到待机模式。";
				close;
			}
			mes "正在初始化熔炉控制器ZX-3100……";
			disablenpc "Furnace Controller#1";
			donpcevent "Furnace Controller#2::OnStart";
			close;
		}
	}
	mes "不是授权用户。中止操作。";
	close;
}

job_gun,214,36,0	script	Auto Anvil#1	CLEAR_NPC,{
	if (Class != Job_Gunslinger) {
		mes "只有授权用户可以操作。";
		close;
	}
	if ((countitem(13118) - isequipped(13118)) > 0) {// Tiny_Flame
		mes "检测到未授权的枪械制作。请向Elwin主管报告。";

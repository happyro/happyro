//===== rAthena Script =======================================
//= Rebellion Job Quest
//===== Description: =========================================
//= [Official Conversion]
//= Job change Quest from Gunslinger -> Rebellion.
//===== Changelogs: ==========================================
//= 1.0 First version. [exneval]
//= 1.1 Syntax change. [Capuche]
//============================================================

moc_fild12,261,318,3	script	Suspicious Man	4_M_MOCASS2,2,2,{
	end;
OnTouch:
	if (Class == Job_Gunslinger && BaseLevel >= 99 && JobLevel >= 70) {
		if (isbegin_quest(12340) == 0) {
			mes "[Suspicious Man]";
			mes "终于找到你了，流浪者Spike！我要取你的首级！";
			next;
			select("Say what?");
			mes "[Suspicious Man]";
			mes "*哼*别装作不知道。看看这张海报！上面就是你！";
			next;
			select("I see the resemblance, but that's not me.");
			mes "["+strcharinfo(0)+"]";
		mes "别说相像了。你从哪里得到那张海报的？我从没犯罪。";
			next;
			mes "[Suspicious Man]";
		mes "我就知道你会想靠撒谎脱身。";
			next;
			mes "[Suspicious Man]";
		mes "^0000ff艾音布罗克私人酒吧^000000发布了那张通缉海报。许多像我这样的赏金猎人都在追你。";
			next;
			mes "[Suspicious Man]";
		mes "只要你看起来像，我不在乎你是不是本人。我要把你活捉或杀死。";
		}
		else {
			mes "[Suspicious Man]";
		mes "又是你！竟然还有胆子回来！";
		}
		next;
		if (select("逃跑。:和他战斗。") == 1)
			mes "^0000ff我现在应该先逃跑，之后再想办法。^000000";
		else
			mes "^0000ff如果他说的是真的，追捕我的赏金猎人不止他一个。我需要时间制定策略。^000000";
		close2;
		if (isbegin_quest(12340) == 0)
			setquest 12340;// Rebellion Job Change Quest
		warp "moc_fild12",186,83;
	}
	end;
}

einbroch,54,97,3	script	Bouncer	4_M_REBELLION,{
	if (BaseClass != Job_Gunslinger) {
		mes "[Bouncer]";
		mes "不要在场地附近闲逛。";
		close;
	}
	switch( isbegin_quest(12340) ) {
	case 0:
		mes "[Bouncer]";
		mes "正在施工，不能进入。";
		close;
	case 1:
		mes "[Bouncer]";
		mes "*倒吸气*是你！我以为你已经被抓了。哦，现在不重要了。你就是我的免罪卡！";
		next;
		select("I'm not the criminal you think I am!");
		mes "[Bouncer]";
		mes "你不是？";
		next;
		mes "^0000ff门卫检查了你的脸。^000000";
		next;
		mes "[Bouncer]";
		mes "嗯，你们非常相像，不过你看起来没有那个罪犯Spike那么凶。";
		next;
		select("I want to talk to the poster publisher.");
		mes "[Bouncer]";
		mes "你的问题超出我的能力范围。进去吧。如果发现你真的是本人，我会让你再也见不到外面。";
		close2;
		warp "job_gun",81,29;
		end;
	case 2:
		mes "[Bouncer]";
		mes "你回来了。为什么？";
		next;
		if (select("I want in.:I was passing by.") == 2) {
			mes "[Bouncer]";
			mes "你真傻。";
			close;
		}
		mes "[Bouncer]";
		mes "去吧。别惹麻烦。";
		close2;
		warp "job_gun",70,28;
		end;
	}
}


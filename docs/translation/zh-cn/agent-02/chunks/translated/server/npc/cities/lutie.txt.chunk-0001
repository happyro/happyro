//===== rAthena Script =======================================
//= Lutie Town
//===== Description: =========================================
//= Lutie - City NPCs
//===== Additional Comments: =================================
//= 1.1 Edited some text and updated/enabled some triggers
//=     for the quest.[kobra_k88]
//= 1.2 Fixed exploit. Checked for Bard Job Quest compatibility [Lupus]
//= 1.3 Fixed typos [Nexon]
//= 1.4 Fixed exploit [Lupus]
//= 1.5 Fixed a bug that could reset Lutie quest state [Lupus]
//= 1.6 Heavy optimization to all the NPCs [DZeroX]
//= 1.7 Updated to match AEGIS script. [Kisuka]
//= 1.8 Split Mr. Claus to pre-re and re [Lemongrass]
//============================================================

// Teleport to Lutie
//============================================================
-	script	Mr. Claus	718,{
	mes "[克劳斯先生]";
	mes "呵呵呵～";
	mes "圣诞快乐！！";
	mes "祝你们每个人都幸福";
	mes "并充满圣诞喜悦！";
	next;
	switch(select("卢蒂耶介绍:前往“卢蒂耶”:取消")) {
	case 1:
		mes "[克劳斯先生]";
		mes "^3355FF卢蒂耶^000000，梦幻的圣诞城镇！这里总是洋溢着分享的精神，有美味的蛋糕、迷你玩具士兵和各种奇妙的东西～！";
		next;
		mes "[克劳斯先生]";
		mes "呵呵呵～";
		mes "这是被冬日之美祝福的奇妙土地，一年四季都洋溢着节日气氛！";
		next;
		mes "[克劳斯先生]";
		mes "我是带领人们前往圣诞城镇卢蒂耶的圣诞老人。随时来问我，我会用魔法把你送到那里～";
		close;
	case 2:
		mes "[克劳斯先生]";
		mes "呵呵呵～";
		mes "前往卢蒂耶的唯一途径就在这里的艾尔迪巴兰！";
		next;
		mes "[克劳斯先生]";
		mes "我负责这里，也亲自运送想去卢蒂耶的人。如果想离开城镇，请询问那边的圣诞老人，他会告诉你离开卢蒂耶的方法。";
		next;
		mes "[克劳斯先生]";
		mes "呵呵呵～";
		mes "准备好了吗？";
		mes "祝你旅途愉快！";
		mes "圣诞快乐～～～～！";
		close2;
		warp "xmas_fild01",78,68;
		end;
	case 3:
		mes "[克劳斯先生]";
		mes "呵呵呵～";
		mes "无论何时想来卢蒂耶都欢迎。想离开时告诉我一声就行。";
		next;
		mes "[克劳斯先生]";
		mes "呵呵呵呵呵！！";
		mes "节日快乐～～～～！";
		close;
	}
}

// Inside Lutie
//============================================================
xmas_in,100,96,4	script	Santa Claus	718,{
	mes "[圣诞老人]";
	mes "呵呵呵～";
	mes "圣诞快乐！！";
	next;
	mes "^3355FF是……^000000";
	mes "^3355FF是传说中的圣诞老人！^000000";
	next;
	mes "[圣诞老人]";
	mes "呵呵呵～";
	mes "我是圣诞老人，圣诞节会给每个乖孩子带来礼物！";
	next;
	mes "[圣诞老人]";
	mes "如果想离开卢蒂耶，请出城向南走到看到的第一片原野。那里有一处魔法传送点，会把你送到艾尔迪巴兰。";
	next;
	mes "[圣诞老人]";
	mes "呵呵呵～";
	mes "圣诞快乐～～～～～～！";
	close;
}

xmas_in,167,173,4	script	Duffle	711,{
	if (xmas_npc == 1) {
		mes "[达夫尔]";
		mes "圣诞快乐！";
		mes "欢迎来到卢蒂耶！";
		next;
		mes "[达夫尔]";
		mes "你收到圣诞老人的";
		mes "礼物了？！";
		mes "哈哈，你一定";
		mes "特别兴奋吧！";
		next;
		mes "[达夫尔]";
		mes "嘿，你听说过吗？卢蒂耶有个和圣诞老人一样出名的景点。";
		next;
		mes "[达夫尔]";
		mes "那就是^3355FF雪雪^000000，";
		mes "神奇的";
		mes "会说话的雪人！";
		next;
		mes "[达夫尔]";
		mes "离开前，你真的应该去见见雪雪，哪怕只聊一次。他是个很好、很有趣的人。";
		next;
		mes "[达夫尔]";
		mes "那么……";
		mes "圣诞快乐！！";
		set xmas_npc,2;
		close;
	}
	else if (xmas_npc > 1) {
		mes "[达夫尔]";
		mes "你和城镇前的雪人说过话吗？那个孤零零站着的雪人……";
		next;
		mes "[达夫尔]";
		mes "但他非常热心～！我有时会和雪雪说话。不知为何，他能像我们一样说话！";
		next;
		mes "[达夫尔]";
		mes "和雪雪说话时，我总会想他是怎么诞生的。你和他聊过后，应该也会有同样的感觉。";
		next;
		mes "[达夫尔]";
		mes "他是如何被创造出来的，又为何能像人类一样思考和说话，真是个谜……";
		next;
		mes "[达夫尔]";
		mes "他来自哪里，那里又是什么样的地方？没有腿的他又是怎么来到卢蒂耶的……？";
		next;
		mes "[达夫尔]";
		mes "最近，来城镇看雪雪的人似乎越来越多了。";
		next;
		mes "[达夫尔]";
		mes "如果想了解更多关于雪雪的谜团，你应该和卢蒂耶的其他居民聊聊……";
		close;
	}
	else {
		mes "[达夫尔]";
		mes "哦……！";
		mes "既然来了，别忘了拜访卢蒂耶的真正圣诞老人。";
		close;
	}
}

xmas_in,27,103,4	script	Lenient Aunt	701,{
	switch (xmas_npc) {
	case 5:
		mes "[塔琴泽]";
		mes "嗯？那个毛茸茸的家伙";
		mes "说了我的好话，";
		mes "是吗？真是的……";
		next;
		mes "[塔琴泽]";
		mes "我知道他在想什么……呵呵呵～！他想让我开心，好让我送他几罐免费腌菜！真是的～！";
		next;
		mes "[塔琴泽]";
		mes "他太了解我了。我差点忍不住给那个人一些腌菜。是的，连我都知道我的腌菜是城里最好的！";
		next;
		mes "[塔琴泽]";
		mes "嗯～？";
		mes "你想知道";
		mes "^3355FF雪雪^000000的事？";
		mes "哦，好，好，我明白了……";
		next;
		mes "[塔琴泽]";
		mes "我不能随便把关于雪雪这么重要的事情告诉别人。嗯……";
		next;
		mes "[塔琴泽]";
		mes "雪雪一直替我保管一样东西，那就是我用来腌卷心菜的^3355FF世界上最粗的盐^000000。";
		next;
		mes "[塔琴泽]";
		mes "如果你真是雪雪的朋友，他应该会信任你，把盐交给你，让你带给我。无论如何，我很快还需要更多盐。";
		next;
		mes "[塔琴泽]";
		mes "乖孩子，";
		mes "快点去吧。";
		mes "要赶快回来～";
		set xmas_npc,6;
		close;
	case 6:
		mes "[塔琴泽]";
		mes "呵呵呵呵～";
		mes "你回来了！";
		next;
		mes "[塔琴泽]";
		mes "你带来了吗？";
		mes "天哪……！";
		mes "我的卷心菜";
		mes "很快就要变酸了！";
		next;
		mes "[塔琴泽]";
		mes "你……";
		mes "没有带来？";
		next;
		mes "[塔琴泽]";
		mes "*叹气*";
		mes "你真是个粗心的孩子。快去找雪雪，把^3355FF世界上最粗的盐^000000带给我。";
		next;
		mes "[塔琴泽]";
		mes "快点，乖孩子，";
		mes "赶紧行动～！";
		close;
	case 7:
		mes "[塔琴泽]";
		mes "呵呵呵呵呵呵呵呵呵！";
		mes "让我看看，让我看看……";
		mes "谢谢你，乖孩子，谢谢。";
		next;
		set xmas_npc,8;
		mes "^3355FF你把世界上最粗的盐";
		mes "交给了她。^000000";
		next;
		mes "[Thachentze]";
		mes "现在我可以好好腌制卷心菜了。谢谢你，亲爱的，谢谢……";
		next;
		mes "...";
		next;
		mes "...";
		mes "......";
		next;
		mes "[塔琴泽]";
		mes "对了，抱歉。我差点忘了答应你的事。你是想问雪雪的魔法礼物袋，对吧？";
		next;
		mes "[塔琴泽]";
		mes "如果你已经见过坎塔塔叔叔，现在应该知道雪雪是由覆盖着一大片魔法花田的神秘积雪制成的。";
		next;
		mes "[塔琴泽]";
		mes "具体过程我也说不清，但雪雪复活时，炼金术士的材料和雪雪积雪中的能量发生了反应。";
		next;
		mes "[塔琴泽]";
		mes "不知为何，雪雪的礼物袋现在能像圣诞老人一样，制造出雪雪想要的任意数量的礼物。";
		next;
		mes "[塔琴泽]";
		mes "当然，如果这股力量落入邪恶之手，我们所有人都会遭殃。";
		next;
		mes "[塔琴泽]";
		mes "不过大家都知道雪雪善良又关爱他人，所以我们从不担心雪雪的力量。";
		next;
		mes "[塔琴泽]";
		mes "还有，我刚从小丑^3355FF哈索奇^000000那里听到一个令人震惊的消息。其实是个很有趣的故事，你不妨去多问问他？";
		close;
	default:
		mes "[塔琴泽]";
		mes "圣诞快乐～";
		mes "呵！呵！呵！";
		next;
		mes "[塔琴泽]";
		mes "我能感受到四周的圣诞气氛！就连远道来到卢蒂耶的年轻旅客眼中也闪烁着这股气氛。呵呵，祝你圣诞快乐！";
		next;
		mes "[塔琴泽]";
		mes "这附近有个叫作";
		mes "‘圣诞节地下城’的地方。如果你已经听说过，我想也不用多说了。";
		mes "算了……";
		next;
		mes "[塔琴泽]";
		mes "几天前我想明白了一件事。在圣诞节地下城里，你会遇到和城外相似的生物。";
		next;
		mes "[塔琴泽]";
		mes "我猜那些怪物是从城外游荡来的，被这里的寒冷天气改变了，于是适应了这里的环境。";
		next;
		mes "[塔琴泽]";
		mes "...";
		mes "好了，我得准备腌卷心菜了。你还不知道吧，我做的腌菜可是附近最棒的！以后来找我尝尝吧？";
		close;
	}
}

// Lutie
//============================================================
xmas,117,304,4	script	Poze	713,{
	if (xmas_npc == 3 || xmas_npc == 4) {
		mes "[波泽]";
		mes "你去找过";
		mes "^3355FF雪雪^000000，";
		mes "他还提到我了？";
		next;
		mes "[波泽]";
		mes "哦，我明白了……";
		mes "他是个没有腿的雪人，难怪没法来找我。真遗憾，真遗憾。看来我得去拜访他才行。";
		next;
		mes "[波泽]";
		mes "有个人知道雪雪为什么会说话，那就是^3355FF毛茸茸的坎塔塔叔叔^000000……";
		next;
		mes "[波泽]";
		mes "有一天，那位伟大炼金术士的学徒来到卢蒂耶，我偶然听到了他和毛茸茸叔叔的谈话。";
		next;
		mes "[波泽]";
		mes "很久以前，一位伟大的炼金术士来到雪雪的故乡，碰巧遇到正在融化、即将化为水的雪雪。然而，雪雪被那位炼金术士奇迹般地复活了。";
		next;
		mes "[波泽]";
		mes "我知道的就这些。想了解详情，就去问^3355FF毛茸茸的坎塔塔叔叔^000000吧。";
		set xmas_npc,4;
		close;
	} else {
		mes "[波泽]";
		mes "欢迎来到卢蒂耶，";
		mes "这座将圣诞精神";
		mes "赐予每位访客的城镇！";
		mes "圣诞快乐！";
		next;
		mes "[波泽]";
		mes "在这片充满欢乐与幻想的魔法土地上，一年四季都能享受圣诞气氛～！很棒吧？";
		next;
		mes "[波泽]";
		mes "卢蒂耶不只是普通的观光景点。这里和其他城镇一样设施齐全，只是置身于节日氛围之中。";
		next;
		mes "[波泽]";
		mes "所以如果你决定在这里住一阵子，所需的一切便利都能得到满足。圣诞快乐～";
		close;
	}
}

xmas,176,236,4	script	Uncle Hairy	712,{
	if (xmas_npc == 4) {
		if (countitem(1024) > 0 && countitem(938) > 0) {
			mes "[坎塔塔]";
			mes "哦？你、你带来那东西了？太、太好了。好久没尝到这个了……快、快给我！";
			next;
			delitem 1024,1;// Chinese_Ink
			delitem 938,1;// Sticky_Mucus
			mes "^3355FF你迅速把乌贼墨汁和黏液交给他，带着几分厌恶看着他享受那种味道。^000000";
			next;
			mes "[坎塔塔]";
			mes "*Burrrrpppp~*";
			mes "好了，现在该讲我的故事了。记住，这就是我所知道的全部；不过我不知道你已经听过多少……";
			next;
			mes "[坎塔塔]";
			mes "很久以前，";
			mes "遥远的北方";
			mes "住着一位伟大的";
			mes "炼金术士。";
			mes "他的名字是";
			mes "^3355FF菲利普·瓦尔泽斯^000000！";
			next;
			mes "[坎塔塔]";
			mes "他一直走在炼金术研究的最前沿，需要稀有材料进行研究。因此，他不得不周游世界，寻找蕴含魔法能量的材料……";
			next;
			mes "[坎塔塔]";
			mes "一天，他来到一个以严寒闻名的北方村庄。可抵达时，迎接他的却是一座刚被摧毁、仍在冒烟的村庄。";
			next;
			mes "[坎塔塔]";
			mes "眼前是一幅凄惨景象：人们躺在路边痛苦呻吟。瓦尔泽斯走过时，每个村民都哀求‘杀、杀了我……’，请求他结束自己的痛苦。";
			next;
			mes "[坎塔塔]";
			mes "在绝望的悲鸣中，两个婴儿的哭声传入菲利普·瓦尔泽斯耳中。他赶去查看，发现两个婴儿正被一名融化中的雪人护在怀里。";
			next;
			mes "[坎塔塔]";
			mes "那个雪人……";
			mes "就是^3355FF雪雪^000000。";
			next;
			mes "[坎塔塔]";
			mes "瓦尔泽斯是睿智的炼金术士，他推断雪雪牺牲自己，保护了两个婴儿免受摧毁村庄的巨大灾难侵袭。";
			next;
			mes "[坎塔塔]";
			mes "瓦尔泽斯深受感动，决心用炼金术救活这个雪人，然后把他带到世界上最安全的地方——卢蒂耶。";
			next;
			mes "[坎塔塔]";
			mes "当然，还有另一个传闻：除了那位炼金术士的慈悲，雪雪能活下来也得益于他积雪的特殊性质。";
			next;
			mes "[坎塔塔]";
			mes "据说雪雪的积雪曾覆盖一片神秘田野，那里盛开着魔法花朵。";
			next;
			mes "[坎塔塔]";
			mes "呜哈哈哈～";
			mes "好了，我知道的就这些。希望你从我的故事里听到了想知道的事！哈！哈！哈！";
			next;
			mes "[坎塔塔]";
			mes "嗯……";
			mes "现在想想……";
			next;
			mes "[坎塔塔]";
			mes "雪雪不但会说话，似乎还能制造无穷无尽的圣诞礼物。至少我是这么听说的。";
			next;
			mes "[坎塔塔]";
			mes "可爱的腌菜师^3355FF塔琴泽^000000对此知道得更多。你好奇的话就去找她聊聊吧。好了，圣诞快乐！";
			set xmas_npc,5;
			close;
		} else {
			mes "[坎塔塔]";
			mes "哦？是波泽告诉你我的事的？哈！哈！哈！我确实知道一点雪雪的事。事实上，我甚至可能是他的弱点，因为……";
			next;
			mes "[坎塔塔]";
			mes "我知道";
			mes "雪雪诞生的";
			mes "^3355FF秘密^000000！！";
			next;
			mes "[坎塔塔]";
			mes "你好奇吗？";
			mes "嘿嘿嘿～除非你拿东西来交换，否则别想让我告诉你！";
			next;
			mes "[坎塔塔]";
			mes "住在这座城镇里，";
			mes "我没多少机会";
			mes "享用男人的美酒。嗯，带给我……";
			next;
			mes "[坎塔塔]";
			mes "^3355FF乌贼墨汁 1 个^000000和";
			mes "^3355FF黏液 1 个^000000！";
			next;
			mes "[坎塔塔]";
			mes "哇哈哈哈！你那是什么表情？！别管我独特的美食品味！快去干活～！";
			close;
		}
	}
	else {
		mes "[坎塔塔]";
		mes "圣诞快乐！";
		mes "欢迎来到卢蒂耶！";
		next;
		mes "[坎塔塔]";
		mes "看来寒冷让你的脸颊泛起了红润。";
		mes "哈！哈！哈！";
		next;
		mes "[坎塔塔]";
		mes "小心点，染上卢蒂耶流感可不是什么好事。";
		mes "...";
		next;
		mes "[坎塔塔]";
		mes "*叹气* 这让我想起……";
		mes "前阵子我家小儿子得了很严重的卢蒂耶流感。";
		next;
		mes "[坎塔塔]";
		mes "那是在夜里，我根本找不到买药的地方。看起来我什么也做不了。";
		next;
		mes "[坎塔塔]";
		mes "我想至少可以找些冰冷的东西给他降温，可卢蒂耶的雪放到他额头上就不断融化。他烧得厉害，我却没法让他舒服些。";
		next;
		mes "[坎塔塔]";
		mes "那时我才";
		mes "知道自己需要";
		mes "一些魔法冰块。";
		next;
		mes "[坎塔塔]";
		mes "最后，我漫无目的地来到了圣诞节地下城。在里面，谢天谢地，我发现了一种完全由冰构成的生物！";
		next;
		mes "[坎塔塔]";
		mes "那是^3355FF冰波利^000000！当地人以前叫它‘冰潘泽林’。总之，我靠它救了儿子的命。幸好这座城镇附近有那种东西。";
		next;
		mes "[坎塔塔]";
		mes "哎呀，我好像说得太多了。圣诞快乐～！";
		close;
	}
}


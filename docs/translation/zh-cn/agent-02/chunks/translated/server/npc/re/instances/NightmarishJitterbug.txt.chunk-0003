	close3;
}

1@jtb,115,113,4	script	Aigu#07	4_F_IU,{
	cutin "igu01",0;
	mes "[Aigu]";
	mes "我感觉很棒——自从负责照顾其他冒险者后，这是我很久以来第一次冒险。而且我还遇到了偶像Newoz！";
	close3;
}


// Room 8
1@jtb,206,107,5	script	Mingmin#08	4_F_GENETIC,{
	if ('room != 8 || is_party_leader() == false) {
		mes "[Mingmin]";
	mes "她的一切都透露着可疑。";
		close;
	}
	if (select( "Talk.", "Hurry." ) == 2 && isbegin_quest(13183) == 2) {
		mes "一边赶路一边努力回忆。";
		if ('room == 8 && is_party_leader() == true) {
			if ('additionnal_option) {
				disablenpc instance_npcname("Newoz#08");
				disablenpc instance_npcname("Shaloshi#08");
				disablenpc instance_npcname("Mingmin#08");
			}
			donpcevent 'jitterbug_main$ + "::OnNextIs9";
		}
		end;
	}
	.@shaloshi$ = instance_npcname("Shaloshi#08");
	.@newoz$ = instance_npcname("Newoz#08");

	cutin "min02",2;
	mes "[Mingmin]";
	mes "Newoz！";
	npctalk "Mingmin：Newoz！";
	next;
	cutin "nines01",0;
	mes "[Newoz]";
	mes "嗯，怎么了？";
	npctalk "Newoz：嗯，怎么了？", .@newoz$;
	next;
	if ('room == 8 && is_party_leader() == true)
		donpcevent 'jitterbug_main$ + "::OnNextIs9";
	cutin "min03",2;
	emotion ET_HUK;
	mes "[Mingmin]";
	mes "你还需要问吗？那个女孩是谁？她是你的吗？";
	npctalk "Mingmin：你还需要问吗？那个女孩是谁？她是你的吗？";
	next;
	cutin "nines04",0;
	emotion ET_HUK, getnpcid(0,.@newoz$);
	mes "[Newoz]";
	mes "什、什么……？！别胡说，我刚刚才找到她。";
	npctalk "Newoz：什、什么……？！别胡说，我刚刚才找到她。", .@newoz$;
	next;
	cutin "min02",2;
	mes "[Mingmin]";
	mes "一个小女孩独自待在这种奇怪的地方？嗯，你不觉得奇怪吗？";
	npctalk "Mingmin：一个小女孩独自待在这种奇怪的地方？嗯，你不觉得奇怪吗？";
	next;
	cutin "shaloshi01",0;
	mes "[Shaloshi]";
	mes "你才奇怪。";
	npctalk "Shaloshi：你才奇怪。", .@shaloshi$;
	next;
	emotion ET_STARE;
	cutin "min01",2;
	mes "[Mingmin]";
	mes "我才不奇怪！你不会想惹我生气的，小姑娘。";
	npctalk "Mingmin：我才不奇怪！你不会想惹我生气的，小姑娘。";
	emotion ET_FRET;
	next;
	emotion ET_THINK, getnpcid(0,.@shaloshi$);
	cutin "shaloshi01",0;
	mes "[Shaloshi]";
	mes "它们来了……";
	npctalk "Shaloshi：它们来了……", .@shaloshi$;
	next;
	cutin "nines04",0;
	mes "[Newoz]";
	mes "这些魔物没完没了地出现。但那些巨大、稀有又美丽的在哪里？";
	npctalk "Newoz：这些魔物没完没了地出现。但那些巨大、稀有又美丽的在哪里？", .@newoz$;
	next;
	cutin "min02",2;
	mes "[Mingmin]";
	mes "之后我得好好研究你，小姑娘。";
	npctalk "Mingmin：之后我得好好研究你，小姑娘。";
	next;
	cutin "shaloshi01",0;
	mes "[Shaloshi]";
	mes "...";
		npctalk "Shaloshi：……", .@shaloshi$;
	close2;
	cutin "",255;
	disablenpc .@newoz$;
	disablenpc .@shaloshi$;
	disablenpc instance_npcname("Mingmin#08");
	end;
}

1@jtb,206,114,5	script	Shaloshi#08	4_F_SHALOSH,{
	cutin "shaloshi01",0;
	mes "[Shaloshi]";
	mes "Newoz的手……好热。";
	close3;
}

1@jtb,203,112,5	script	Newoz#08	4_M_NEWOZ,{
	cutin "nines03",0;
	mes "[Newoz]";
	mes "不知道通道尽头有什么在等我们。期待得让我坐立不安！";
	close3;
}


// Room 9 (menu affects the boss encounter in the next room)
1@jtb,285,114,5	script	Newoz#09	4_M_NEWOZ,{
	if ('room != 9 || is_party_leader() == false) {
		cutin "nines01",0;
		mes "[Newoz]";
	mes "我一直喜欢唱歌。";
		close3;
	}
	if (select( "Talk.", "Hurry." ) == 2 && isbegin_quest(13183) == 2) {
		mes "一边赶路一边努力回忆。";
		if ('room == 9 && is_party_leader() == true) {
			donpcevent 'jitterbug_main$ + "::OnNextIs10";
			if (jitterbug_options & 1)
				areamonster 'map_jtb$,351,131,389,96, "--ja--", 3108,1;	// no label
			disablenpc instance_npcname("Newoz#09");
			disablenpc instance_npcname("Shaloshi#09");
			disablenpc instance_npcname("Lagi#09");
		}
		close3;
	}
	.@shaloshi$ = instance_npcname("Shaloshi#09");
	.@lagi$ = instance_npcname("Lagi#09");

	cutin "nines01",0;
	mes "[Newoz]";
	mes "我总是把其他人弄丢。他们明明就在我面前。";
	npctalk "Newoz：我总是把其他人弄丢。他们明明就在我面前。";
	next;
	cutin "ragi01",0;
	mes "[Lagi]";
	mes "我们又见面了。";
	npctalk "Lagi：我们又见面了。", .@lagi$;
	next;
	cutin "nines03",0;
	mes "[Newoz]";
	mes "你很有品味。这首歌刚好浮现在我的脑海里。听听吧。";
	npctalk "Newoz：你很有品味。这首歌刚好浮现在我的脑海里。听听吧。";
	next;
	if ('room == 9 && is_party_leader() == true)
		donpcevent 'jitterbug_main$ + "::OnNextIs10";
	cutin "nines02",0;
	emotion ET_DELIGHT;
	mes "[Newoz]";
	mes "季节又一次变换～可我还没有机会用凤仙花染指甲～";
	npctalk "Newoz：季节又一次变换～可我还没有机会用凤仙花染指甲～";
	next;
	cutin "ragi02",0;
	emotion ET_DELIGHT, getnpcid(0,.@lagi$);
	mes "[Lagi]";
	mes "等待雪花～";
	npctalk "Lagi：等待雪花～", .@lagi$;
	next;
	cutin "nines01",0;
	emotion ET_BEST;
	mes "[Newoz]";
	mes "你很棒。你会成为优秀的舞娘和吟游诗人。";
	npctalk "Newoz：你很棒。你会成为优秀的舞娘和吟游诗人。";
	next;
	cutin "ragi01",0;
	mes "[Lagi]";
	mes "我想暂时继续当吟游诗人。";
	npctalk "Lagi：我想暂时继续当吟游诗人。", .@lagi$;
	next;
	cutin "nines01",0;
	mes "[Newoz]";
	mes "只要会唱歌和演奏，职业其实无所谓，对吧？";
	npctalk "Newoz：只要会唱歌和演奏，职业其实无所谓，对吧？";
	next;
	cutin "shaloshi01",0;
	mes "[Shaloshi]";
	mes "喜欢你的歌。";
	npctalk "Shaloshi：喜欢你的歌。", .@shaloshi$;
	next;
	cutin "nines02",0;
	mes "[Newoz]";
	mes "Shaloshi，你有喜欢的歌吗？";
	npctalk "Newoz：Shaloshi，你有喜欢的歌吗？";
	next;
	cutin "shaloshi01",0;
	emotion ET_DELIGHT, getnpcid(0,.@shaloshi$);
	mes "[Shaloshi]";
	mes "Runane唱歌好听，吹口哨也好听。";
	npctalk "Shaloshi：Runane唱歌好听，吹口哨也好听。", .@shaloshi$;
	next;
	cutin "",255;
	mes "- Shaloshi嘟起嘴想吹口哨，但失败了。 -";
	next;
	cutin "ragi01",0;
	mes "[Lagi]";
	mes "嗯，你是在尝试吹口哨吗？";
	npctalk "Lagi：嗯，你是在尝试吹口哨吗？", .@lagi$;
	next;
	cutin "nines01",0;
	mes "[Newoz]";
	mes "哈哈，之后我教你怎么吹，Shaloshi。";
	npctalk "Newoz：哈哈，之后我教你怎么吹，Shaloshi。";
	next;
	mes "[Newoz]";
	mes "" + strcharinfo(0) + "，你有喜欢的歌吗？";
	npctalk "Newoz：" + strcharinfo(0) + "，你有喜欢的歌吗？";
	next;
	switch( select("Aigu's debut song- Lost Poring", "Aigu's single- Only I Didn't Know about the Card Album", "Newoz's Red Potion (feat. Muka)", "Laggi's Self-composed song- Accidental Moonlight" ) ) {
	case 1:
		jitterbug_options &= ~1;
		unittalk getcharid(3), "" + strcharinfo(0) + "：我喜欢Aigu的出道曲《迷路波利》。";
		mes "[Newoz]";
		mes "你知道她的出道曲。你是她的粉丝吧？";
		npctalk "Newoz：你知道她的出道曲。你是她的粉丝吧？";
		break;
	case 2:
		jitterbug_options &= ~1;
		unittalk getcharid(3), "" + strcharinfo(0) + "：我喜欢Aigu的单曲《只有我不知道卡片专辑的事》。";
		mes "[Newoz]";
		mes "Aigu现在是卢恩-米德加尔兹最火的歌手！";
		npctalk "Newoz：Aigu现在是卢恩-米德加尔兹最火的歌手！";
		break;
	case 3:
		jitterbug_options |= 1;
		areamonster 'map_jtb$,351,131,389,96, "--ja--", 3108,1;	// no label
		unittalk getcharid(3), "" + strcharinfo(0) + "：我喜欢你的《红色药水》（与Muka合作）。";
		mes "[Newoz]";
		mes "哈哈，真让人不好意思，不过谢谢你。";
		npctalk "Newoz：哈哈，真让人不好意思，不过谢谢你。";
		break;
	case 4:
		jitterbug_options &= ~1;
		unittalk getcharid(3), "" + strcharinfo(0) + "：我喜欢Lagi的自创曲《意外月光》。";
		mes "[Lagi]";
		mes "但是怎么会……？！这还没发行。";
		npctalk "Lagi：但是怎么会……？！这还没发行。";
		break;
	}
	next;
	cutin "nines01",0;
	mes "[Newoz]";
	mes "嗯，各有所好。";
	npctalk "Newoz：嗯，各有所好。";
	next;
	cutin "ragi01",0;
	emotion ET_SURPRISE, getnpcid(0,.@lagi$);
	mes "[Lagi]";
	mes "又有别的东西出现了。";
	npctalk "Lagi：又有别的东西出现了。", .@lagi$;
	next;
	cutin "nines04",0;
	mes "[Newoz]";
	mes "啊，我饿了。别管那些魔物了。Shaloshi，我们走！";
	npctalk "Newoz：啊，我饿了。别管那些魔物了。Shaloshi，我们走！";
	next;
	cutin "shaloshi01",0;
	mes "[Shaloshi]";
	mes "好的。";
	npctalk "Shaloshi：好的。", .@shaloshi$;
	next;
	cutin "ragi01",0;
	mes "[Lagi]";
	mes "嘿，跟我来！";
	npctalk "Lagi：嘿，跟我来！", .@lagi$;
	sleep2 1000;
	disablenpc instance_npcname("Newoz#09");
	disablenpc .@shaloshi$;
	disablenpc .@lagi$;
	close3;
}

1@jtb,290,114,4	script	Lagi#09	4_M_RAGI,{
	cutin "ragi01",0;
	mes "[Lagi]";
	mes "我没有多少冒险经验，但还挺有趣的。";
	close3;
}

1@jtb,286,117,5	script	Shaloshi#09	4_F_SHALOSH,{
	cutin "shaloshi01",0;
	mes "[Shaloshi]";
	mes "（尝试吹口哨）我不会。";
	close3;
}

// Room 10
1@jtb,375,117,4	script	Newoz#10	4_M_NEWOZ,{
	if ('room != 10 || is_party_leader() == false) {
		cutin "nines01",2;
		mes "[Newoz]";
		mes "这些家伙不一样。他们似乎理解音乐……也可能不是。";
		close3;
	}
	if (select( "Talk.", "Hurry." ) == 2 && isbegin_quest(13183) == 2)
		mes "一边赶路一边努力回忆。";
	else {
		.@runane$ = instance_npcname("Runane#10");
		.@shaloshi$ = instance_npcname("Shaloshi#10");
		.@roel$ = instance_npcname("Roel#10");

		emotion ET_DELIGHT;
		cutin "nines01",2;
		mes "[Newoz]";

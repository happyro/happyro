// Room 7
1@jtb,111,115,5	script	Roel#07	4_M_ROEL,{
	if ('room != 7 || is_party_leader() == false) {
		cutin "roel01",0;
		mes "[Roel]";
	mes "我这是怎么了？心脏一直砰砰跳。";
		close3;
	}
	if (select( "Talk.", "Hurry." ) == 2 && isbegin_quest(13183) == 2)
		mes "一边赶路一边努力回忆。";
	else {
		.@aigu$ = instance_npcname("Aigu#07");
		.@runane$ = instance_npcname("Runane#07");

		cutin "lunain01",2;
		mes "[Runane]";
	mes "雾散了。";
	npctalk "Runane：雾散了。", .@runane$;
		next;
		cutin "roel01",0;
		mes "[Roel]";
	mes "但雾持续得够久，让我们彼此走散了。";
	npctalk "Roel：但雾持续得够久，让我们彼此走散了。";
		next;
		cutin "igu05",2;
		mes "[Aigu]";
	mes "刚才我还牵着Shaloshi的手，下一刻她就不见了。";
	npctalk "Aigu：刚才我还牵着Shaloshi的手，下一刻她就不见了。", .@aigu$;
		next;
		cutin "lunain01",2;
		mes "[Runane]";
	mes "她叫Shaloshi？我问过她好几次，她都没告诉我。";
	npctalk "Runane：她叫Shaloshi？我问过她好几次，她都没告诉我。", .@runane$;
		next;
		cutin "igu01",2;
		mes "[Aigu]";
	mes "真奇怪。她一开始就告诉Newoz了。";
	npctalk "Aigu：真奇怪。她一开始就告诉Newoz了。", .@aigu$;
		next;
		cutin "lunain04",2;
		mes "[Runane]";
	mes "哼，我讨厌女孩子。我感觉我们还会遇到更多魔物。";
	npctalk "Runane：哼，我讨厌女孩子。我感觉我们还会遇到更多魔物。", .@runane$;
		next;
		cutin "roel01",0;
		mes "[Roel]";
	mes "别担心——我会保护你！";
	npctalk "Roel：别担心——我会保护你！";
		next;
		cutin "igu04",2;
		mes "[Aigu]";
	mes "你最好比我认识的某个人可靠。";
	npctalk "Aigu：你最好比我认识的某个人可靠。", .@aigu$;
		next;
		cutin "lunain03",2;
		mes "[Runane]";
	mes "别太相信这个孩子。我最好去找Newoz。";
	npctalk "Runane：别太相信这个孩子。我最好去找Newoz。", .@runane$;
		next;
		cutin "roel01",0;
		mes "[Roel]";
		mes "...";
		npctalk "Roel：……";
		next;
		cutin "roel03",0;
		mes "[Roel]";
	mes "（她就是我喜欢的类型！）";
	npctalk "Roel：（她就是我喜欢的类型！）";
	}
	if ('room == 7 && is_party_leader() == true)
		donpcevent 'jitterbug_main$ + "::OnNextIs8";
	close3;
}


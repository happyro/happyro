	else {
		.@aigu$ = instance_npcname("Aigu#06");
		.@arang$ = instance_npcname("Arang#06");
		.@shaloshi$ = instance_npcname("Shaloshi#06");

		cutin "igu05",2;
		mes "[Aigu]";
	mes "Newoz！你这次跑到哪里去了？";
	npctalk "Aigu：Newoz！你这次跑到哪里去了？", .@aigu$;
		next;
		cutin "nines04",0;
		mes "[Newoz]";
	mes "抱歉。";
	mes "这里像迷宫一样，岔路和空地太多，我都数不清了。";
	npctalk "Newoz：抱歉。这里像迷宫一样，岔路和空地太多，我都数不清了。";
		next;
		cutin "arang01",2;
		mes "[Arang]";
	mes "*哼*你在普隆德拉下水道也这么说。";
	npctalk "Arang：*哼*你在普隆德拉下水道也这么说。", .@arang$;
		next;
		cutin "igu04",2;
		mes "[Aigu]";
	mes "你在说什么？为什么不能跟着我们？Runane呢？我刚才还看到她在旁边。";
	npctalk "Aigu：你在说什么？为什么不能跟着我们？Runane呢？我刚才还看到她在旁边。", .@aigu$;
		next;
		cutin "shaloshi01",2;
		mes "[???]";
	mes "有歌声的男人。";
	npctalk "？？？：有歌声的男人。", .@shaloshi$;
		next;
		cutin "nines02",0;
		mes "[Newoz]";
	mes "哦，你好。请问你是谁，小姑娘？";
	npctalk "Newoz：哦，你好。请问你是谁，小姑娘？";
		next;
		cutin "shaloshi01",2;
		mes "[Shaloshi]";
	mes "我是Shaloshi。为我唱歌。";
	npctalk "Shaloshi：我是Shaloshi。为我唱歌。", .@shaloshi$;
		next;
		cutin "nines03",0;
		mes "[Newoz]";
	mes "哈哈，你真可爱。我之后为你唱。";
	npctalk "Newoz：哈哈，你真可爱。我之后为你唱。";
		next;
		cutin "shaloshi01",2;
		mes "[Shaloshi]";
	mes "你答应了。你真善良。";
	npctalk "Shaloshi：你答应了。你真善良。", .@shaloshi$;
		next;
		cutin "igu03",2;
		mes "[Aigu]";
	mes "魔物开始出现，而且数量增长得很快。";
	npctalk "Aigu：魔物开始出现，而且数量增长得很快。", .@aigu$;
		next;
		cutin "arang02",2;
		mes "[Arang]";
	mes "只要和我们待在一起，你就没事，Aigu……嗯，大家去哪了？";
	npctalk "Arang：只要和我们待在一起，你就没事，Aigu……嗯，大家去哪了？", .@arang$;
		next;
		cutin "nines01",0;
		mes "[Newoz]";
	mes "哈哈，别担心，小姑娘们。我会保护你们。";
	npctalk "Newoz：哈哈，别担心，小姑娘们。我会保护你们。";
		next;
		cutin "arang03",2;
		mes "[Arang]";
	mes "Newoz，我爱你！";
	npctalk "Arang：Newoz，我爱你！", .@arang$;
		next;
		cutin "shaloshi01",2;
		mes "[Shaloshi]";
	mes "你保护我。你真善良。";
	npctalk "Shaloshi：你保护我。你真善良。", .@shaloshi$;
		next;
		cutin "igu05",2;
		mes "[Aigu]";
	mes "你会比这里的其他人先逃跑。好了，我们不能待在这里。继续前进吧。";
	npctalk "Aigu：你会比这里的其他人先逃跑。好了，我们不能待在这里。继续前进吧。", .@aigu$;
	}
	if ('room == 6 && is_party_leader() == true)
		donpcevent 'jitterbug_main$ + "::OnNextIs7";
	close3;
}


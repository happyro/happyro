prt_monk,59,247,1	script	Guarding Monk#mk	120,6,2,{
	if (Upper == 1) {
		mes "[托霍布]";
		mes "嗯？你来这里有什么事？";
		mes "如果你想进入这片圣地，";
		mes "必须告诉我你的姓名和职业等级！";
		next;
		mes "[托霍布]";
		mes "……嗯？";
		mes "哦！^FF0000天哪^000000！抱歉，我好像把你误认成认识的人了。";
		next;
		mes "[托霍布]";
		mes "……";
		mes "……";
		next;
		mes "[托霍布]";
		mes "真奇怪……我从没认错过人……算了。祝你今天愉快。";
		close;
	}
	if (BaseJob == Job_Acolyte && MONK_Q == 0) {
		mes "[托霍布]";
		mes "嗯？你来这里有什么事？";
		mes "如果你想进入这片圣地，";
		mes "必须告诉我你的姓名和职业等级！";
		next;
		mes "[托霍布]";
		mes "现在，请告诉我你的姓名和职业等级。";
		next;
		if (select("无视他。:告诉他。") == 1) {
			mes "[托霍布]";
			mes "无视他人是无礼的，出去！";
			close2;
			warp "prt_fild03",357,256;
			end;
		}
		mes "[托霍布]";
		mes "嗯……" + strcharinfo(0) + "是你的名字？";
		mes "……我说对了吗？";
		mes "好，那么你的职业等级是" + JobLevel + "，对吗？";
		next;
		mes "[托霍布]";
		mes "很好……你为什么来到这里，";
		mes "" + strcharinfo(0) + "?";
		next;
		switch(select("参观并了解修道士。:我想成为修道士……:我累了，需要休息……")) {
		case 1:
			mes "[托霍布]";
			mes "我明白了……";
			mes "我们修道士为追求精神觉悟而活。";
			mes "我们同时磨炼身体与心灵，以抵达真正的内心平静。";
			mes "愿你也能找到内心的平静。";
			set MONK_Q,1;
			close;
		case 2:
			if (BaseJob == Job_Acolyte && JobLevel > 39) {
				mes "[托霍布]";
				mes "嗯，看起来你一直在为此训练……";
				mes "很好。去见我们的师范穆海，和他谈谈。";
				mes "他会帮助你开始训练。";
				set MONK_Q,2;
				setquest 3016;
				close;
			}
			else if (BaseJob == Job_Acolyte && JobLevel < 40) {
				mes "[托霍布]";
				mes "嗯，你似乎还没准备好成为修道士。";
				mes "要成为修道士，你必须是";
				mes "至少职业等级 40 的服事。";
				mes "否则，你还没有成为修道士的资格。";
				next;
				mes "[托霍布]";
				mes "再多训练一些后回来找我，";
				mes "我会告诉你是否已经准备好。";
				next;
				mes "[托霍布]";
				mes "希望你很快能加入我们，走上";
				mes "追求内心平静与觉悟的道路。";
				mes "我会在这里等你。";
				set MONK_Q,1;
				close;
			}
			else {
				mes "[托霍布]";
				mes "哈哈哈，真是个好笑话！";
				close;
			}
		case 3:
			mes "[托霍布]";
			mes "是啊，我们偶尔都需要休息一下……";
			mes "不要让自己压力太大，这个主意不错。";
			mes "进来坐坐，让自己舒服些。";
			mes "需要休息多久都可以。";
			next;
			mes "[托霍布]";
			mes "希望你在观察我们的同伴";
			mes "追求精神觉悟的过程中";
			mes "恢复活力。";
			mes "也希望你能达到那种境界。";
			set MONK_Q,1;
			close;
		}
	}
	else {
		if (MONK_Q == 1 && BaseJob == Job_Acolyte) {
			mes "[托霍布]";
			mes "你觉得怎么样？这次参观让你的心灵有所收获吗？";
			next;
			switch(select("没有……:我想成为修道士。:我需要休息……")) {
			case 1:
				mes "[托霍布]";
				mes "我明白了，这没什么可羞愧的。";
				mes "希望你在这里与同伴相处的经历，";
				mes "能让你更接近";
				mes "真正的觉悟。";
				set MONK_Q,1;
				close;
			case 2:
				if (BaseJob == Job_Acolyte && JobLevel > 39) {
					mes "[托霍布]";
					mes "嗯，看起来你一直在为此训练……";
					mes "很好。去见我们的师范穆海，和他谈谈。";
					mes "他会帮助你开始训练。";
					set MONK_Q,2;
					setquest 3016;
					close;
				}
				else if (BaseJob == Job_Acolyte && JobLevel < 40) {
					mes "[托霍布]";
					mes "嗯，你似乎还没准备好成为修道士。";
					mes "要成为修道士，你必须是";
					mes "至少职业等级 40 的服事。";
					mes "否则，你还没有成为修道士的资格。";
					next;
					mes "[托霍布]";
					mes "自己再多训练一些后回来找我，";
					mes "我会告诉你是否已经准备好。";
					next;
					mes "[托霍布]";
					mes "希望你很快能加入我们，走上";
					mes "追求内心平静与觉悟的道路。";
					mes "我会在这里等你。";
					set MONK_Q,1;
					close;
				}
				else {
					mes "[托霍布]";
					mes "哈哈哈，真是个好笑话！";
					close;
				}
			case 3:
				mes "[Tohobu]";
				mes "是啊，我们偶尔都需要休息一下……";
				mes "不要让自己压力太大，这个主意不错。";
				mes "进来坐坐，让自己舒服些。";
				mes "需要休息多久都可以。";
				next;
				mes "[Tohobu]";
				mes "希望你在观察我们的同伴";
				mes "追求精神觉悟的过程中";
				mes "恢复活力。";
				mes "也希望你能达到那种境界。";
				set MONK_Q,1;
				close;
			}
		}
		if (MONK_Q == 0) {
			mes "[托霍布]";
			mes "嗯？你来这里有什么事？";
			mes "如果你想进入这片圣地，";
			mes "必须告诉我你的姓名、职业等级和等级！";
			next;
			mes "[托霍布]";
			mes "现在，请告诉我你的姓名和职业等级！";
			next;
			if (select("无视。:告诉他。") == 1) {
				mes "[托霍布]";
				mes "无视他人是无礼的，出去！";
				close2;
				warp "prt_fild03",357,256;
				end;
			}
			mes "[托霍布]";
			mes "嗯……" + strcharinfo(0) + "是你的名字？";
			mes "……我说对了吗？";
			mes "好，那么你的职业等级是" + JobLevel + "，对吗？";
			next;
			mes "[托霍布]";
			mes "好，现在你为什么来到这里，";
			mes "" + strcharinfo(0) + "?";
			next;
			switch(select("参观并了解修道士。:我想成为修道士……:我累了，需要休息……")) {
			case 1:
				mes "[托霍布]";
				mes "我明白了……";
				mes "我们修道士为侍奉神明、追求精神觉悟而活。";
				mes "我们同时磨炼身体与心灵，以抵达真正的内心平静。";
				mes "愿你也能找到内心的平静。";
				set MONK_Q,1;
				close;
			case 2:
				if (BaseJob == Job_Acolyte && JobLevel > 39) {
					mes "[托霍布]";
					mes "嗯，看起来你一直在为此训练……";
					mes "很好。去见我们的师范穆海，和他谈谈，";
					mes "他会帮助你开始新的训练。";
					set MONK_Q,2;
					setquest 3016;
					close;
				}
				else if (BaseJob == Job_Acolyte && JobLevel < 40) {
					mes "[托霍布]";
					mes "嗯，你似乎还没准备好成为修道士。";
					mes "要成为修道士，你必须是";
					mes "至少职业等级 40 的服事。";
					mes "否则，你还没有成为修道士的资格。";
					next;
					mes "[托霍布]";
					mes "自己再多训练一些后回来找我，";
					mes "我会告诉你是否已经准备好。";
					next;
					mes "[托霍布]";
					mes "希望你很快能加入我们，走上";
					mes "追求内心平静与觉悟的道路。";
					mes "我会在这里等你。";
					set MONK_Q,1;
					close;
				}
				else {
					mes "[托霍布]";
					mes "哈哈哈，真是个好笑话！";
					close;
				}
			case 3:
				mes "[托霍布]";
				mes "是啊，我们偶尔都需要休息一下……";
				mes "不要让自己压力太大，这个主意不错。";
				mes "进来坐坐，让自己舒服些。";
				mes "需要休息多久都可以。";
				next;
				mes "[托霍布]";
				mes "希望你在观察我们的同伴";
				mes "追求精神觉悟的过程中";
				mes "恢复活力。";
				mes "也希望你能达到那种境界。";
				set MONK_Q,1;
				close;
			}
		}
		else if (MONK_Q == 1) {
			mes "[托霍布]";
			mes "旅途中请仔细聆听。";
			mes "还有许多东西要学习。";
			close;
		}
		else if (BaseJob == Job_Acolyte && MONK_Q == 2) {
			mes "[托霍布]";
			mes "嗯……你想见师范穆海吗？";
			mes "他在‘修道士大厅’的东南区域。";
			close;
		}
		else if (BaseJob == Job_Acolyte && MONK_Q > 2) {
			mes "[托霍布]";
			mes "希望你训练顺利，期待再次见到你。";
			close;
		}
		else {
			mes "[托霍布]";
			mes "欢迎来到我们教会的中央大厅。";
			mes "请尽量不要打扰其他修道士。";
			mes "即使你自己也是修道士。";
			close;
		}
	}

OnTouch_:
	if (MONK_Q == 0) {
		mes "[托霍布]";
		mes "你竟敢踏入";
		mes "这座神圣的建筑！！！";
		mes "你的敬意在哪里？！";
		next;
		mes "[托霍布]";
		mes "离开这里！！！";
		close;
	}
	if (MONK_Q == 1) {
		mes "[托霍布]";
		mes "嗯……进来吧。";
		mes "也许你能学到些什么……";
		close;
	}
	if (BaseJob == Job_Acolyte && MONK_Q == 2) {
		mes "[托霍布]";
		mes "嗯……你想见我们的师范穆海？";
		mes "他在这座建筑的东南区域。";
		close;
	}
	if (BaseJob == Job_Acolyte && MONK_Q > 2) {
		mes "[托霍布]";
		mes "期待看到你成为修道士并加入我们。";
		close;
	}
	end;
}

monk_in,99,58,1	script	Sensei Moohae#mk	60,{
	mes "[师范穆海]";
	mes "你好，你似乎走在纯净的道路上。";
	mes "进来吧、进来吧，今天我能为你做什么？";
	next;
	if (SkillPoint) {
		mes "[师范穆海]";
		mes "如果你有未分配的技能点，转职时会失去它们。";
		mes "请务必使用所有技能点。";
		close;
	}
	if (BaseJob == Job_Acolyte && MONK_Q == 2 && JobLevel > 39) {
		mes "[师范穆海]";
		mes "我感受到了战斗精神，你想成为修道士吗？";
		next;
		if (select("是。:否。") == 2) {
			mes "[师范穆海]";
			mes "抱歉……我已经有一段时间";
			mes "没有感受到像你这样强大的人了。";
			mes "年轻人，希望你能找到自己的道路。";
			close;
		}
		mes "[师范穆海]";
		mes "仍有人希望遵循古老的道路。";
		if (Sex == SEX_MALE)
			mes "强壮的年轻人。我很高兴你愿意加入我们。";
		else
			mes "如此娇嫩的花朵。我很高兴看到你愿意加入我们。";
		next;
		mes "[师范穆海]";
		mes "哦，你就是想加入我们的新学徒……";
		mes "在开始训练前，有几件事你应该知道。";
		next;
		mes "[师范穆海]";
		mes "我们修道士走的是追求内心平静与觉悟的道路。";
		mes "我们用最大的关怀，努力将这种平静带给所有人。";
		next;
		mes "[师范穆海]";
		mes "我们修道士通过身心训练来实现这一点。";
		mes "我们在周遭环境和大自然中寻找觉悟。";
		next;
		mes "[师范穆海]";
		mes "当然，始终保持对神明的初始信仰也很重要。";
		next;
		mes "[师范穆海]";
		mes "这不是轻松的生活，成为修道士的真正考验，就是能忍受我所说的一切……";
		mes "修道士的生活并不适合所有人，只有足够坚强的人才能成为修道士。";
		next;
		mes "[师范穆海]";
		mes "现在，既然你已经明白了这一切，";
		mes "准备好训练";
		mes "你的力量与精神。";
		next;
		mes "[师范穆海]";
		mes "让我们从一项简单的任务开始。";
		next;
		switch(rand(1,7)) {
		case 1: setarray .@items[0], 938,5, 1055,10, 511,20, 3; changequest 3016,3017; break;
		case 2: setarray .@items[0], 942,20, 1002,5, 510,3, 4; changequest 3016,3018; break;
		case 3: setarray .@items[0], 905,30, 909,5, 955,10, 5; changequest 3016,3019; break;
		case 4: setarray .@items[0], 943,5, 935,20, 912,5, 6; changequest 3016,3020; break;
		case 5: setarray .@items[0], 7053,5, 509,10, 508,10, 7; changequest 3016,3021; break;
		case 6: setarray .@items[0], 913,10, 948,5, 7033,20, 8; changequest 3016,3022; break;
		case 7: setarray .@items[0], 1027,5, 1025,20, 1042,10, 9; changequest 3016,3023; break;
		}
		mes "[师范穆海]";
		mes .@items[1]+" "+getitemname(.@items[0])+",";
		mes .@items[3]+" "+getitemname(.@items[2])+",";
		mes .@items[5]+" "+getitemname(.@items[4])+".";
		mes "找到这些物品后回来找我。";
		set MONK_Q,.@items[6];
		next;
		mes "[师范穆海]";
		switch (.@items[6]) {
		case 3: mes "干嘛摆出那副表情？这是对你能力的考验。"; break; 
		case 4: mes "怎么了？这是对你能力的考验。"; break; 
		case 5: mes "你明白了吧？这是对你能力的考验。"; break; 
		case 6: mes "别那样看着我。这是对你能力的考验。"; break; 
		case 7: mes "你似乎并不在意，这是对你能力的考验。你应该认真对待。"; break; 
		case 8: mes "这是对你能力的考验，请确保靠自己取得这些物品。"; break; 
		case 9: mes "别担心，我相信你能做到。这只是对你能力的考验。"; break; 
		}
		next;
		mes "[师范穆海]";
		mes "如果你无法带着这些物品回来，就说明你还没准备好成为修道士。";
		mes "务必收集我列出的所有物品。";
		mes "愿神明与你同在。";
		close;
	}
	else if (MONK_Q == 3) {
		mes "[师范穆海]";
		mes "你回来了，带来我要求的物品了吗？";
		next;
		if (countitem(938) > 4 && countitem(1055) > 9 && countitem(511) > 19) {
			mes "[师范穆海]";
			mes "做得好，你找齐了所有物品。";
			mes "我会把这件事告诉长老们。";
			set MONK_Q,10;
			changequest 3017,3024;
			delitem 938,5; //Sticky_Mucus
			delitem 1055,10; //Earthworm_Peeling
			delitem 511,20; //Green_Herb
			next;
			mes "[师范穆海]";
			mes "让我们看看接下来该去见谁……";
			mes "啊……去找长老图哈。";
			mes "他在西北方。";
			close;
		}
		else {
			mes "[师范穆海]";
			mes "你怎么会以为已经完成了？";
			mes "你没有带来我要求的物品！";
			mes "5 个黏稠液体，";
			mes "10 个蚯蚓皮，";
			mes "20 个绿色药草。";
			mes "这些就是我需要的物品，去把它们全部找来。";
			close;
		}
	}
	else if (MONK_Q == 4) {
		mes "[师范穆海]";
		mes "……嗯？";
		next;
		if (countitem(942) > 19 && countitem(1002) > 4 && countitem(510) > 2) {
			mes "[师范穆海]";
			mes "很好，你找齐了所有物品。";
			mes "我会把这件事告诉长老们。";
			set MONK_Q,10;
			changequest 3018,3024;
			delitem 942,20; //Yoyo_Tail
			delitem 1002,5; //Iron_Ore
			delitem 510,3; //Blue_Herb
			next;
			mes "[师范穆海]";
			mes "让我们看看接下来该去见谁……";
			mes "啊……去找长老图哈。";
			mes "他在西北方。";
			close;
		}
		else {
			mes "[师范穆海]";
			mes "你为什么回来了？";
			mes "你没有带来我要求的物品！";
			mes "20 个溜溜猴尾巴，";
			mes "5 个铁矿石，";
			mes "3 个蓝色药草。";
			mes "这些就是我需要的物品，去把它们全部找来。";
			close;
		}
	}
	else if (MONK_Q == 5) {
		mes "[师范穆海]";
		mes "嗯？";
		next;
		if (countitem(905) > 29 && countitem(909) > 4 && countitem(955) > 9) {
			mes "[师范穆海]";
			mes "看吧，没那么难，你真的找齐了所有物品。";
			mes "我会把这件事告诉长老们。";
			set MONK_Q,10;
			changequest 3019,3024;
			delitem 905,30; //Stem
			delitem 909,5; //Jellopy
			delitem 955,10; //Worm_Peelings
			next;
			mes "[师范穆海]";
			mes "下一步会由图哈";
			mes "交给你。";

// Room 23 (Boss Room entrance)
1@jtb,320,323,5	script	Newoz#23	4_M_NEWOZ,{
	if ('room != 23 || is_party_leader() == false) {
		cutin "nines01",0;
		mes "[Newoz]";
		mes "*喘气*很高兴你没有走太远。";
		close3;
	}
	.@shaloshi$ = instance_npcname("Shaloshi#23");
	.@ferre_23$ = instance_npcname("Ferre#23");
	.@ferre_24$ = instance_npcname("Ferre#24");
	cutin "nines04",0;
	mes "[Newoz]";
	mes "*喘气*我找到你了，Shaloshi。";
	npctalk "Newoz：*喘气*我找到你了，Shaloshi。";
	next;
	cutin "shaloshi01",2;
	mes "[Shaloshi]";
	mes "Newoz……";
	npctalk "Shaloshi：Newoz……", .@shaloshi$;
	next;
	cutin "nines04",0;
	mes "[Newoz]";
	mes "*喘气*很高兴你没有走太远。";
	npctalk "Newoz：*喘气*很高兴你没有走太远。";
	next;
	cutin "",255;
	mes "[Ferre]";
	mes "Ferre，Ferre，Fe——！";
	npctalk "Ferre：Ferre，Ferre，Fe——！", .@ferre_23$;
	next;
	cutin "shaloshi01",2;
	mes "[Shaloshi]";
	mes "Ferre生气了。";
	npctalk "Shaloshi：Ferre生气了。", .@shaloshi$;
	next;
	cutin "nines01",0;
	mes "[Newoz]";
	mes "你不用生气。我不是来带走你朋友的。我只是想……";
	npctalk "Newoz：你不用生气。我不是来带走你朋友的。我只是想……";
	next;
	cutin "",255;
	mes "[Ferre]";
	mes "Ferre，Ferre，Ferre！";
	npctalk "Ferre：Ferre，Ferre，Ferre！", .@ferre_23$;
	next;
	cutin "shaloshi01",2;
	mes "[Shaloshi]";
	mes "Ferre真的生气了。";
	npctalk "Shaloshi：Ferre真的生气了。", .@shaloshi$;
	next;
	cutin "nines01",0;
	mes "[Newoz]";
	mes "是啊，你不用告诉我。";
	npctalk "Newoz：是啊，你不用告诉我。";
	next;
	cutin "shaloshi01",2;
	mes "[Shaloshi]";
	mes "这不妙。Ferre……";
	npctalk "Shaloshi：这不妙。Ferre……", .@shaloshi$;
	next;
	mes "[Shaloshi]";
	mes "不，不！";
	npctalk "Shaloshi：不，不！", .@shaloshi$;
	next;
	cutin "",255;
	mes "[Ferre]";
	mes "Ferre，Ferre，Ferre，Ferre——！";
	npctalk "Ferre：Ferre，Ferre，Ferre，Ferre——！", .@ferre_23$;
	next;
	sleep2 400;
	disablenpc .@ferre_23$;
	enablenpc .@ferre_24$;
	disablenpc .@ferre_24$;
	enablenpc .@ferre_23$;
	sleep2 800;
	disablenpc .@ferre_23$;
	enablenpc .@ferre_24$;
	disablenpc .@ferre_24$;
	enablenpc .@ferre_23$;
	disablenpc .@ferre_23$;
	enablenpc .@ferre_24$;
	disablenpc .@ferre_24$;
	enablenpc .@ferre_23$;
	disablenpc .@ferre_23$;
	enablenpc .@ferre_24$;
	sleep2 700;
	specialeffect EF_LORD,AREA, .@ferre_24$;
	specialeffect EF_SUI_EXPLOSION,AREA, .@ferre_24$;
	cutin "shaloshi01",2;
	mes "[Shaloshi]";
	mes "Ferre变成了真正的形态！";
	npctalk "Shaloshi：Ferre变成了真正的形态！", .@shaloshi$;
	next;
	cutin "",255;
	mes "^FF0000出现了强大的敌人！^000000";
	next;
	mes "[Ferre]";
	mes "FERRE——FERRE——FERRE——FERRE——！！";
	npctalk "Ferre：FERRE——FERRE——FERRE——FERRE——！！", .@ferre_24$;
	next;
	cutin "shaloshi01",2;
	mes "[Shaloshi]";
	mes "Ferre，你不用这样做！";
	npctalk "Shaloshi：Ferre，你不用这样做！", .@shaloshi$;
	next;
	cutin "nines03",0;
	mes "[Newoz]";
	mes "好吧，既然说服不了他，那我们只能打一架了。";
	npctalk "Newoz：好吧，既然说服不了他，那我们只能打一架了。";
	next;
	mes "[Newoz]";
	mes "其他人在哪里？嘿，新来的，帮我一下。那个Ferre看起来很能打。";
	npctalk "Newoz：其他人在哪里？嘿，新来的，帮我一下。那个Ferre看起来很能打。";
	next;
	cutin "",255;
	mes "[Ferre]";
	mes "FERRE，FERRE，FERRE——！";
	npctalk "Ferre：FERRE，FERRE，FERRE——！", .@ferre_24$;
	next;
	cutin "nines02",0;
	mes "[Newoz]";
	mes "开始吧！";
	npctalk "Newoz：开始吧！";
	close2;
	cutin "",255;
	if ('room == 23 && is_party_leader() == true) {
		'party_id = getcharid(1);
		donpcevent 'jitterbug_main$ + "::OnNextIs23";
		if (jitterbug_options & 16)
			monster 'map_jtb$,327,331, "--ja--", 3108,2;	// JITTERBUG1 - no label
	}
	end;
}

1@jtb,324,327,4	duplicate(???#02)	Ferre#23	4_F_PERE01
1@jtb,324,327,4	duplicate(???#02)	Ferre#24	4_JITTERBUG

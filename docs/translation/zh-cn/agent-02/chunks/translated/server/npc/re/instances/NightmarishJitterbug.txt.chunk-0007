// Room 21 (menu affects the boss encounter in the next room)
1@jtb,198,369,5	script	Newoz#21	4_M_NEWOZ,{
	if ('room != 21 || is_party_leader() == false) {
		mes "[Newoz]";
		mes "Shaloshi……";
		close;
	}
	if (select( "Talk.", "Hurry." ) == 2 && isbegin_quest(13183) == 2) {
		mes "一边赶路一边努力回忆。";
		if ('room == 21 && is_party_leader() == true) {
			disablenpc instance_npcname("Shaloshi#21");
			disablenpc instance_npcname("Aigu#21");
			disablenpc instance_npcname("Newoz#21");
			donpcevent 'jitterbug_main$ + "::OnNextIs22";
		}
		close3;
	}
	.@aigu$ = instance_npcname("Aigu#21");
	.@mingmin$ = instance_npcname("Mingmin#21");
	.@roter$ = instance_npcname("Roter#21");
	.@runane$ = instance_npcname("Runane#21");
	.@shaloshi$ = instance_npcname("Shaloshi#21");
	.@melody$ = instance_npcname("Melody-Jack#21");

	cutin "shaloshi03",0;
	mes "[Shaloshi]";
	mes "……";
	npctalk "Shaloshi：……", .@shaloshi$;
	next;
	cutin "",255;
	mes "[Melody-Jack]";
	mes "恐怕这个地方正在我们周围坍塌。";
	npctalk "Melody-Jack：恐怕这个地方正在我们周围坍塌。", .@melody$;
	next;
	cutin "shaloshi03",0;
	mes "[Shaloshi]";
	mes "Ferre们生气了。";
	npctalk "Shaloshi：Ferre们生气了。", .@shaloshi$;
	next;
	cutin "min02",2;
	mes "[Mingmin]";
	mes "哇，你连魔物在想什么都能听见？";
	npctalk "Mingmin：哇，你连魔物在想什么都能听见？", .@mingmin$;
	next;
	if ('room == 21 && is_party_leader() == true)
		donpcevent 'jitterbug_main$ + "::OnNextIs22";
	cutin "shaloshi03",0;
	mes "[Shaloshi]";
	mes "它们是我的朋友。";
	npctalk "Shaloshi：它们是我的朋友。", .@shaloshi$;
	next;
	cutin "lunain04",0;
	mes "[Runane]";
	mes "不，它们不是。朋友不会互相攻击！";
	npctalk "Runane：不，它们不是。朋友不会互相攻击！", .@runane$;
	next;
	cutin "shaloshi01",0;
	mes "[Shaloshi]";
	mes "它们只是想保护我。";
	npctalk "Shaloshi：它们只是想保护我。", .@shaloshi$;
	next;
	cutin "rote01",2;
	mes "[Roter]";
	mes "保护你免受什么？";
	npctalk "Roter：保护你免受什么？", .@roter$;
	next;
	cutin "shaloshi01",0;
	mes "[Shaloshi]";
	mes "免受Rot所想的东西。";
	npctalk "Shaloshi：免受Rot所想的东西。", .@shaloshi$;
	next;
	cutin "",255;
	emotion ET_THINK, getnpcid(0,.@melody$);
	mes "[Melody-Jack]";
	mes "...";
	npctalk "Melody-Jack：……", .@melody$;
	next;
	cutin "shaloshi01",0;
	mes "[Shaloshi]";
	mes "Ferre？";
	npctalk "Shaloshi：Ferre？", .@shaloshi$;
	next;
	enablenpc instance_npcname("Ferre#21");
	enablenpc instance_npcname("Ferre#22");
	cutin "",255;
	emotion ET_FRET, getnpcid(0,instance_npcname("Ferre#21"));
	mes "[Ferre]";
	mes "Ferre，Ferre！";
	npctalk "Ferre：Ferre，Ferre！", instance_npcname("Ferre#21");
	next;
	emotion ET_FRET, getnpcid(0,instance_npcname("Ferre#22"));
	mes "[Ferre]";
	mes "Ferre，Ferre，Ferre！";
	npctalk "Ferre：Ferre，Ferre，Ferre！", instance_npcname("Ferre#21");
	specialeffect EF_READYPORTAL2,AREA, .@shaloshi$;
	specialeffect EF_PORTAL2,AREA, .@shaloshi$;
	next;
	cutin "nines01",0;
	mes "[Newoz]";
	mes "！！！";
	npctalk "Newoz：！！！";
	next;
	disablenpc .@shaloshi$;
	disablenpc instance_npcname("Ferre#21");
	disablenpc instance_npcname("Ferre#22");
	cutin "rote01",2;
	mes "[Roter]";
	mes "我们要被埋在这里了。找出口吧。";
	npctalk "Roter：我们要被埋在这里了。找出口吧。", .@roter$;
	next;
	cutin "nines01",0;
	mes "[Newoz]";
	mes "我们必须找到Shaloshi！";
	npctalk "Newoz：我们必须找到Shaloshi！";
	next;
	emotion ET_THINK, getnpcid(0,.@melody$);
	cutin "",255;
	mes "[Melody-Jack]";
	mes "Newoz，我知道你脑子有点奇怪，但她……";
	npctalk "Melody-Jack：Newoz，我知道你脑子有点奇怪，但她……", .@melody$;
	next;
	cutin "nines04",0;
	mes "[Newoz]";
	mes "我知道。你不用提醒我。";
	npctalk "Newoz：我知道。你不用提醒我。";
	next;
	cutin "min02",2;
	mes "[Mingmin]";
	mes "那我们离开这里吧。我们现在正处于严重危险中。";
	npctalk "Mingmin：那我们离开这里吧。我们现在正处于严重危险中。", .@mingmin$;
	next;
	cutin "nines01",0;
	mes "[Newoz]";
	mes "我必须找到她。我必须和她谈谈。";
	npctalk "Newoz：我必须找到她。我必须和她谈谈。";
	next;
	cutin "rote01",2;
	mes "[Roter]";
	mes "NEWOZ！";
	npctalk "Roter：NEWOZ！", .@roter$;
	next;
	cutin "nines01",0;
	mes "[Newoz]";
	mes "我已经不是你的主人了。你不用跟着我。";
	npctalk "Newoz：我已经不是你的主人了。你不用跟着我。";
	next;
	cutin "lunain01",0;
	mes "[Runane]";
	mes "！！！";
	npctalk "Runane：！！！", .@runane$;
	next;
	disablenpc instance_npcname("Newoz#21");
	cutin "igu05",0;
	mes "[Aigu]";
	mes "Newoz，我和你一起去！";
	npctalk "Aigu：Newoz，我和你一起去！", .@aigu$;
	next;
	cutin "min02",0;
	mes "[Mingmin]";
	mes "由你决定，新主人。";
	npctalk "Mingmin：由你决定，新主人。", .@mingmin$;
	next;
	disablenpc .@aigu$;
	cutin "gelca04",2;
	mes "[Gelka]";
	mes "主人！";
	npctalk "Gelka：主人！", instance_npcname("Gelka#21");
	next;
	cutin "rote01",2;
	mes "[Roter]";
	mes "...";
	npctalk "Roter：……", .@roter$;
	next;
	cutin "rote01",2;
	mes "[Roter]";
	mes "我们会找到Newoz和Shaloshi。找到后我要杀了他们两个。";
	npctalk "Roter：我们会找到Newoz和Shaloshi。找到后我要杀了他们两个。", .@roter$;
	next;
	cutin "roel04",0;
	mes "[Roel]";
	mes "Newoz，你知道会发生这种事吗？你真幸运，有这么好的朋友。";
	npctalk "Roel：Newoz，你知道会发生这种事吗？你真幸运，有这么好的朋友。", instance_npcname("Roel#21");
	next;
	emotion ET_THINK, getnpcid(0,.@melody$);
	cutin "",255;
	mes "[Melody-Jack]";
	mes "他不知道，因为他从来不思考。";
	npctalk "Melody-Jack：他不知道，因为他从来不思考。", .@melody$;
	next;
	cutin "arang01",2;
	mes "[Arang]";
	mes "耶！走吧！";
	npctalk "Arang：耶！走吧！", instance_npcname("Arang#21");
	next;
	cutin "rote01",2;
	mes "[Roter]";
	mes "我们分成两队。小心别在迷宫般的岔路里迷路。";
	npctalk "Roter：我们分成两队。小心别在迷宫般的岔路里迷路。", .@roter$;
	next;
	if (select( "Follow Roter and Gelka.", "Search alone." ) == 1)
		jitterbug_options &= ~16;
	else
		jitterbug_options |= 16;
	cutin "min02",0;
	mes "[Mingmin]";
	mes "准备好了吗？走吧！";
	npctalk "Mingmin：准备好了吗？走吧！", .@mingmin$;
	close3;
}


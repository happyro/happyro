//===== rAthena Script =======================================
//= God Items Quest
//===== Description: =========================================
//= [Official Conversion]
//= God Item Jormungand Creation script (WoE TE)
//===== Changelogs: ==========================================
//= 1.0 First Version. [Capuche]
//============================================================

te_aldecas1,226,34,3	script	Blacksmith Cano#tegod01	4_M_RACHMAN1,{
	if (checkweight(1201,1) == 0) {
		mes "你携带的物品太多，无法继续任务。";
		mes "请减轻负重后再试。";
		close;	}

	.@guild_id = getcastledata("te_aldecas1",1);
	.@economy  = getcastledata("te_aldecas1",2);
	.@npc_name$ = "Cano";

	mes "["+ .@npc_name$ +"]";
	if (.@guild_id != getcharid(2)) {
		mes "你……看起来很面生……？";
		mes "你是要威胁我吗？";
		mes "不是吧？";
		next;
		mes "["+ .@npc_name$ +"]";
		mes "我有自己的理由。";
		mes "请假装没看到我。";
		close;
	}
	if (WoeTETimeStart(14400) == 1 || agitcheck3() == 1) {// cannot start the quest 4 hours before and during WOE TE
		mes "从现在起，我会安静待在这里，直到攻城战结束，不打扰任何人。";
		mes "不用担心我。";
		close;
	}
	if (is_guild_leader() == false) {
		mes "你允许我留在这里，我一直都很感激。";
		mes "这没什么特别的……不过如果你愿意，我可以制作一些有用的工具。";
		next;
		mes "["+ .@npc_name$ +"]";
		mes "我的意思是，如果公会会长需要的话。";
		mes "我也是追求终极之道的大师。";
		mes "希望能在这里找到那条道路。";
		close;
	}
	if ($2012_tegod_kafra == 0) {// event status
		mes "啊……主人。";
		mes "我一直都非常感激。";
		mes "既然我欠你这么多，我随时都会帮你。";
		next;
		switch( select( "制作耶梦加得。","融合材料。","休息。" ) ) {
		case 1:
			if (.@economy > 29) {
				if (countitem(6603) > 3 && countitem(6599) > 0 && countitem(6598) > 0 && countitem(6601) > 3 && countitem(6600) > 0 && countitem(6605) > 0 && countitem(6604) > 0 && countitem(1473) > 0) {
					mes "^ff0000制作耶梦加得需要巫术法杖。";
					mes "继续任务时，除了巫术法杖外不应持有其他物品。^ff0000";
					next;
					mes "^ff0000即使物品已经精炼并镶嵌卡片，制作过程仍需要你拥有的一把巫术法杖。";
					mes "整理物品后再试。^000000";
					next;
					if (select( "整理物品。","继续。" ) == 1) {
						mes "你决定只保留巫术法杖。";
						close;
					}
					mes "["+ .@npc_name$ +"]";
				mes "我看到你如约发展了要塞。";
				mes "而且你还找到了黄昏之路……";
					next;
					mes "["+ .@npc_name$ +"]";
				mes "……那么……开始工作吧。";
				mes "在那些女孩找到我们之前……";
					next;
					mes "[" + strcharinfo(0) + "]";
				mes "女孩们……？";
					next;
					mes "["+ .@npc_name$ +"]";
				mes "……是啊，确实有几个女孩……";
				mes "我不得不躲开她们……";
					donpcevent "#tequest_master_alde01::OnCommandOn";
					mapannounce "te_aldecas1","A girl's voice: Hey, were you talking about us? It's "+ .@npc_name$ +", right? I can't believe you ran away to a place like this.",bc_map,"0x00FF00",FW_BOLD,20,0,40;
					next;
					mes "["+ .@npc_name$ +"]";
				mes "哦，不……！";
				mes "她们来了……！！";
					next;
					mes "[" + strcharinfo(0) + "]";
				mes "交给我吧。";
					next;
					mes "^4d4dff!- Instruction -!";
				mes "很快，7名盯上"+ .@npc_name$ +"的女孩会试图入侵要塞。";
				mes "你必须保护"+ .@npc_name$ +"1小时。^000000";
					next;
					mes "^4d4dff!- Instruction -!";
				mes "实际攻击开始后，为了防御，黄金区域的入口会被封锁。^000000";
					close;
				}
				mes "["+ .@npc_name$ +"]";
			mes "耶梦加得是一把以拥抱世界的神之子耶梦加得为原型制作的法杖。";
			mes "它也指诸神黄昏，众神的暮光。";
				next;
				mes "["+ .@npc_name$ +"]";
			mes "但是，这里有象征众神暮光的物品……";
			mes "真不敢相信我要亲手用它们制作耶梦加得……用我自己的双手！";
				next;
				mes "["+ .@npc_name$ +"]";
				mes "不过，看来我们还需要更多材料。";
				mes "你能再确认一下吗？我会给你需要的材料清单。";
				callsub S_Material, .@npc_name$,1,"since Jormungand has a great power.";
			}
			mes "["+ .@npc_name$ +"]";
			mes "不过，我能说几句吗？";
			mes "耶梦加得是我制作的最强战具之一，你值得从我这里得到这样的东西……";
			next;
			mes "["+ .@npc_name$ +"]";
			mes "但我希望你至少具备最低资格。";
			mes "管理好要塞，将^4d4dff商业等级提升到30或更高^000000。";
			next;
			mes "["+ .@npc_name$ +"]";
			mes "力量越大，责任和义务也越大。";
			mes "我希望你先掌握基础。";
			next;
			mes "["+ .@npc_name$ +"]";
			mes "之后我会制作耶梦加得。";
			mes "如果你愿意，我把材料清单给你。";
			callsub S_Material, .@npc_name$,0,"since Jormungand has a great power.";
		case 2:
			callsub S_Fuse, .@npc_name$, "Jormungand";
		case 3:
			mes "["+ .@npc_name$ +"]";
			mes "你这么说真好。";
			mes "对了，不知道我哥哥凯怎么样了？";
			next;
			mes "["+ .@npc_name$ +"]";
			mes "我相信他和我一样过得很好。";
			mes "……希望一切能一直像现在这样和平。";
			close;
		}
	}
	if ($2012_tegod_kafra == 1) {// event started
		mes "你听说消息了吗？";
		mes "那些女孩要来了。";
		mes "无情的女孩们！！！";
		next;
		mes "["+ .@npc_name$ +"]";
		mes "她们已经宣战，随时都会到。";
		mes "我确定她们是来抢耶梦加得的。";
		next;
		mes "["+ .@npc_name$ +"]";
		mes "阻止她们。拜托了！";
		next;
		switch( select( "Leave it to me.","What do you mean 'the girls?'" ) ) {
		case 1:
			mes "["+ .@npc_name$ +"]";
			mes "谢谢……";
			mes "抱歉给你添麻烦，但我无能为力。";
			next;
			mes "["+ .@npc_name$ +"]";
			mes "请替我阻止她们！";
			close;
		case 2:
			mes "["+ .@npc_name$ +"]";
			mes "……她们就是想成为女武神的女孩……";
			mes "而且她们总是七人一组行动。";
			next;
			mes "["+ .@npc_name$ +"]";
			mes "她们想要的是强大的战具……";
			mes "她们一直威胁我和哥哥凯。";
			next;
			mes "["+ .@npc_name$ +"]";
			mes "起初她们满足于基础武器，但";
			mes "很快就开始威胁我们，说要更强大的东西才能成为女武神。";
			next;
			mes "["+ .@npc_name$ +"]";
			mes "我受不了了，所以逃走了……但她们还是来了……";
			mes "你要小心，因为她们已经知道耶梦加得的材料在这里。";
			close;
		}
	}
	if ($2012_tegod_kafra == 2) {// after 10 minutes delay
		mes "啊，别再跟着我了！";
		mes "如果你能摆脱她们……耶梦加得，对了！我会为你制作耶梦加得！";
		next;
		mes "["+ .@npc_name$ +"]";
		mes "她们什么时候才会停止跟踪我……";
		mes "现在我看到女孩就害怕……吓得什么都做不了……";
		next;
		mes "他现在开始胡言乱语了。";
		mes "等一等，他会冷静下来。";
		mes "你必须先摆脱那些女孩。";
		close;
	}
	if ($2012_tegod_kafra == 3) {// event failed
		mes "……虽然我又一次成功逃离了他们……";
		mes "太难了。";
		mes "生活……真是太难了。";
		next;
		mes "["+ .@npc_name$ +"]";
		mes "我累得什么都做不了。";
		mes "……我觉得暂时什么都做不了，无论是生产、锻造还是其他事情。";
		mes "抱歉。我先休息一下。";
		close;
	}
	if ($2012_tegod_kafra == 4) {
		mes "我终于能呼吸了。";
		mes "我会按约定开始制作耶梦加得。";
		next;
		switch( select( "Make Jormungand.","Fuse materials.","Not now." ) ) {
		case 1:
			if (countitem(6603) > 3 && countitem(6599) > 0 && countitem(6598) > 0 && countitem(6601) > 3 && countitem(6600) > 0 && countitem(6605) > 0 && countitem(6604) > 0 && countitem(1473) > 0) {
			mes "^ff0000制作耶梦加得的过程中需要魔法师法杖。";
				mes "继续任务时，除了巫术法杖外不应持有其他物品。^ff0000";
				next;
			mes "^ff0000即使已经应用精炼等级和卡片，制作过程仍需要你拥有的任意一把魔法师法杖。";
				mes "整理物品后再试。^000000";
				next;
				if (select( "Organize possessions.","Continue as it is." ) == 1) {
					mes "你决定只保留巫术法杖。";
					close;
				}
				mes "["+ .@npc_name$ +"]";
				mes "哦……谢谢。";
				mes "真不敢相信我终于亲手接触这些材料了……";
				next;
				mes "["+ .@npc_name$ +"]";
				mes "就是它。";
				mes "虽然要经过很多步骤，但不是很快吗？";
				mes "我太激动了，感觉时间一瞬间就过去了。";
				next;
				mes "耶梦加得，这件强大的武器、神话中所有痕迹的集合，终于完成了";
				mes "在"+ .@npc_name$ +"手中。";
				delitem 6603,4;// Skin_Of_Hraesvelg
				delitem 6599,1;// Spirit_Of_Hugin
				delitem 6598,1;// Rib_Of_Jormungand
				delitem 6601,4;// Chisel_Of_Giant
				delitem 6600,1;// Spirit_Of_Munin
				delitem 6605,1;// Muspellium
				delitem 6604,1;// Essence_Of_Rune
				delitem 1473,1;// Wizardy_Staff
				$2012_tegod_kafra = 5;
				getitem 2020,1;// Jormungand
				announce "Twilight of trail [ Jormungand ] is introduced to this world by ["+ strcharinfo(0) +"] of ["+ getguildname(.@guild_id) +"] Guild.",bc_all,"0x70dbdb",FW_NORMAL,12;
				if (.@economy > 20)
					setcastledata "te_aldecas1",2,(.@economy -20);
				else
					setcastledata "te_aldecas1",2,1;// min is 1 for WOE TE
				next;
				mes "["+ .@npc_name$ +"]";
				mes "呼……我想一阵子都不能工作了。";
				mes "我筋疲力尽。哈哈哈……";
				close;
			}
			mes "["+ .@npc_name$ +"]";
			mes "不过，看来我们还需要更多材料。";
			mes "你能再确认一下吗？我会给你需要的材料清单。";
			callsub S_Material, .@npc_name$,1;
		case 2:
			callsub S_Fuse, .@npc_name$, "Jormungand";
		case 3:
			mes "["+ .@npc_name$ +"]";
			mes "现在正是制作它的好时机。";
			mes "等下一个黄金出现时，就没有机会了。";
			next;
			mes "["+ .@npc_name$ +"]";
			mes "另外请记住，我每周只能制作一次。";
			close;
		}
	}
	if ($2012_tegod_kafra == 5) {
		mes "我有点累。";
		mes "我想应该休息几天。";
		mes "我看起来可能没事，但精神上非常疲惫。";
		close;
	}
	mes "真奇怪。";
	mes "我说不清自己的感受。";
	mes "我是不是有什么健康问题？";
	mes "是不治之症吗？";
	close;

S_Material:
	.@npc_name$ = getarg(0);
	next;
	mes "["+ .@npc_name$ +"]";
	mes "^4d4dff4 Presberk's Leather";
	mes "1 Spirit of Hugin";
	mes "1 Spirit of Munin";
	mes "4 Giant's Chisel";
	mes "1 Jormungand's Rib";
	mes "1 Wizardry Staff";
	mes "1 Muspellium and Essence of Rune, respectively^000000";
	next;
	mes "["+ .@npc_name$ +"]";
	mes "我们需要这些数量的材料。";
	mes getarg(2,"");
	mes "顺便说，穆斯贝尔海姆和符文精髓需要额外材料单独制作。";
	next;
	mes "["+ .@npc_name$ +"]";
	mes "制作穆斯贝尔海姆需要^4d4dff合成50个铝和50个神之金属^000000。";
	mes "制作符文精髓需要^4d4dff合成200个古代粗糙符文石和100个神秘粗糙符文石^000000。";
	next;
	mes "["+ .@npc_name$ +"]";
	mes "你提出请求时，我随时可以制作穆斯贝尔海姆和符文精髓，";
	mes "当然，收集齐所需材料后，我也会制作耶梦加得。";
	next;
	mes "["+ .@npc_name$ +"]";
	if (getarg(1))
		mes "和你为我做的相比，我做的永远不够。";
	else {
		mes "不过，你无法找到黄昏之路。";
		mes "……但人们说，它一定会出现在真正渴望它的人面前。祝你好运。";
	}
	close;

S_Fuse:
	.@npc_name$ = getarg(0);
	mes "["+ .@npc_name$ +"]";
	mes "你想制作哪种材料？";
	next;
	switch( select( "Muspellium","Essence of Rune","Forget it." ) ) {
	case 1:
		mes "["+ .@npc_name$ +"]";
		if (countitem(985) > 49 && countitem(984) > 49) {
		mes "我会用你准备的材料制作穆斯贝尔海姆。";
			next;
			mes "["+ .@npc_name$ +"]";
		mes "不会花太久。";
		mes "就是它。";
		mes "这是制作赫尔沃和耶梦加得的必要材料。";
			delitem 985,50;// Elunium
			delitem 984,50;// Oridecon
			getitem 6605,1;// Muspellium
			close;
		}
	mes "为了制作穆斯贝尔海姆，";
		mes "^4d4dff你需要50个铝和50个神之金属。^000000";
		next;
		mes "["+ .@npc_name$ +"]";
	mes "我们应该准备好所有材料了，对吧？";
		close;
	case 2:
		mes "["+ .@npc_name$ +"]";
		if (countitem(12735) > 199 && countitem(12736) > 99) {
		mes "我会用你准备的材料制作符文精髓。";
			next;
			mes "["+ .@npc_name$ +"]";
		mes "不会花太久。";
		mes "就是它。";
		mes "这是制作赫尔沃和耶梦加得的必要材料。";
			delitem 12735,200;// Runstone_Ancient
			delitem 12736,100;// Runstone_Mystic
			getitem 6604,1;// Essence_Of_Rune
			close;
		}
	mes "至于符文精髓，";
		mes "^4d4dff你需要200个远古粗糙符文石和100个神秘粗糙符文石。^000000";
		next;
		mes "["+ .@npc_name$ +"]";
	mes "确实需要很多材料……";
		close;
	case 3:
		mes "["+ .@npc_name$ +"]";
	mes "需要时随时告诉我。";
	mes "我很高兴至少能为你做这些。";
		next;
		mes "["+ .@npc_name$ +"]";
	mes "另外，能找到"+ getarg(1) +"材料的地方……";
	mes "对我来说也像梦境一样。";
		close;
	}

OnInit:
	if ($2012_tegod_kafra == 3 || agitcheck3())// 3 -> quest failed
		disablenpc();
	else
		enablenpc();
	end;
}

te_aldecas1,3,2,0	script	#tequest_master_alde01	CLEAR_NPC,{
	mes "密码？";
	next;
	if ( callfunc( "F_GM_NPC", 1854,0, 0,9999 ) < 1 ) {
	mes "走开。";
		close;
	}
	.@map$ = "te_aldecas1";
	mes "当前状态：" + $2012_tegod_kafra;
	mes "0：可以继续任务";
	mes "1：继续任务，等待10分钟";
	mes "2: Quest in progress";
	mes "3: Quest failed";
	mes "4: Able to produce items , 5: Items produced successfully.";
	next;
	mes "女孩状态：" + $@2012_tegirls_alde01;
	mes "要塞当前商业等级：" + getcastledata(.@map$,2);
	next;
	switch( select( "Do not proceed","Initialization","Raise Commerce Level","Lower Commerce Level" ) ) {
	case 1:
		end;
	case 2:
	mes "初始化";
		donpcevent "#tequest_master_alde01::OnReset";
		close;
	case 3:
		.@economy = getcastledata(.@map$,2) +30;
		.@economy = .@economy > 100 ? 100 : .@economy;
		setcastledata .@map$,2,.@economy;
	mes "提高商业等级30点";
	mes "修改后商业等级：" + .@economy;
		close;
	case 4:
		.@economy1 = getcastledata(.@map$,2);
		.@economy2 = .@economy1 > 30 ? (.@economy1 -30) : 1;
		if (.@economy1 > 30) {
		mes "降低商业等级30点";
			setcastledata .@map$,2,.@economy2;
		}
		else {
		mes "由于当前等级低于30，商业等级降为0。";
			setcastledata .@map$,2,1;// min is 1 for WOE TE
		}
	mes "修改后商业等级：" + .@economy2;
		close;
	}

OnReset:// gm Initialization
	callsub S_EventReset;// kill all quests mobs and stop timer of others npcs
	callsub S_EventOff;// clear setnpcdisplay
	$2012_tegod_kafra = 0;
	$@2012_tegirls_alde01 = 0;
	.npc_name$ = "";
	enablenpc "aldeg-1-11_aldeg-1-15#te";
	enablenpc "Blacksmith Cano#tegod01";
	stopnpctimer;
	end;

OnCommandOn:
	$2012_tegod_kafra = 1;
	.npc_name$ = strnpcinfo(0);// for script readability
	initnpctimer;
	end;

OnTimer10000:
	announce "Girls' voices: Cano~ We already know where you are. It's over!",bc_all,"0xFF0000",FW_NORMAL,10;
	end;
OnTimer15000:
	announce "Girls' Voices: We'll wait just 10 minutes. If you don't show up in the meantime, we'll storm the fortress!",bc_all,"0xFF0000",FW_NORMAL,10;
	end;
OnTimer595000:
	mapannounce "te_aldecas1","A girl's voice: Cano! How dare you ignore our warning! So, you have company there, huh? But how long do you think they'll stay with you?!",bc_map,"0x00ff00",FW_NORMAL,12;
	end;
OnTimer598000:
	mapannounce "te_aldecas1","You are forced out of the fortress by unknown power.",bc_map,"0x00ff00",FW_NORMAL,12;
	end;

OnTimer600000:
	$2012_tegod_kafra = 2;
	mapwarp "te_aldecas1", "te_alde_gld",130,264;
	donpcevent "Aira#fake01_alde01::OnCommandOn";
	donpcevent "Kuluna#fake01_alde01::OnCommandOn";
	donpcevent "Mallina#fake01_alde01::OnCommandOn";
	donpcevent "Ezella#fake01_alde01::OnCommandOn";
	donpcevent "Lune#fake01_alde01::OnCommandOn";
	donpcevent "Morin#fake01_alde01::OnCommandOn";
	donpcevent "Nasarin#fake01_alde01::OnCommandOn";

	disablenpc "aldeg-1-11_aldeg-1-15#te";// warp to emperium room
	end;

OnTimer602000:
	announce "Glaris in Kafragarten region is being attacked by a group of unidentified beings.",bc_all,"0xFF0000",FW_NORMAL,10;

t_garden,166,217,3	script(CLOAKED)	Rigel#life2	4_CS_RIGEL,{
	if (isbegin_quest(12594) == 1) {
		cutin "rigel01.png",2;
		mes "[里格尔]";
		mes "你来了，" + strcharinfo(0) + ".";
		mes "离宅邸这么远又不会打扰奥斯卡，正合适，对吧？";
		next;
		select( "你要在这里做什么？" );
		cutin "rigel02.png",2;
		mes "[里格尔]";
		mes "从现在开始，我们要建造一座监狱，用来关押非常危险且不稳定的囚犯。";
		next;
		select( "你要在花园里建监狱？" );
		cutin "rigel01.png",2;
		mes "[里格尔]";
		mes "总之，这里只作为通道，监狱本身连接着另一个次元。我会把它们留在那里，不打算破坏花园。";
		next;
		mes "[里格尔]";
		mes "我们在北边不远处建立了监狱进入名单。只有名单上的人才能进入监狱，先去登记吧。";
		close2;
		completequest 12594;
		setquest 12597;
		cutin "",255;
		end;
	}
	cutin "rigel01.png",2;
	mes "[里格尔]";
	mes "先去寻找我在北边不远处设置的封印灵石。";
	close3;

OnInit:
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "isbegin_quest(12594) == 1" );
	end;
}



t_garden,166,235,3	script(CLOAKED)	Sealing Spirit Stone#life2	HEROS_OUT_ORB,{
	switch( isbegin_quest(12597) ) {
	case 0:
		end;
	case 1:
		mes "[封印灵石]";
		mes "^ff0000未认证用户。^000000";
		next;
		cutin "rigel_halfeyes01.png",2;
		mes "[Rigel]";
		mes "别发呆，伸出手。";
		mes "将拇指放在展开灵石的右下方，其余手指放在上方，集中精神。";
		next;
		select( "把手放在引导装置上。" );
		setpcblock PCBLOCK_NPC, true;
		cutin "",255;
		specialeffect2 EF_BEGINSPELL_N5;
		sleep2 2000;
		specialeffect EF_LORD, AREA, "Dimension Prison#1";
		sleep2 500;
		specialeffect EF_LORD, AREA, "Dimension Prison#2";
		sleep2 1500;
		specialeffect EF_BAKU, AREA, "Dimension Prison#1";
		sleep2 500;
		specialeffect EF_BAKU, AREA, "Dimension Prison#2";
		sleep2 500;
		specialeffect EF_THUNDERSTORM2, AREA, "Dimension Prison#1";
		sleep2 500;
		setpcblock PCBLOCK_NPC, false;
		specialeffect EF_THUNDERSTORM2, AREA, "Dimension Prison#2";
		cloakoffnpcself( "Dimension Prison#1" );
		cloakoffnpcself( "Dimension Prison#2" );
		sleep2 1500;
		cutin "rigel_halfeyes01.png",2;
		mes "[Rigel]";
		mes "看来登记成功了。现在你已经完成识别监狱、进出监狱的基本准备。还有问题请参考这份指南。";
		next;
		select( "你打算把谁关进那座监狱？" );
		cutin "rigel_annoying01.png",2;
		mes "[Rigel]";
		mes "^bb0000变身怪。^000000";
		next;
		cutin "rigel_halfeyes01.png",2;
		mes "[Rigel]";
		mes "你可能觉得只是变身怪而已，但你要关押的家伙和你想象中的变身怪完全不是一个层次。";
		next;
		mes "[Rigel]";
		mes "它不仅模仿目标的能力或外表，还会吞噬目标灵魂并变成目标本身，是最糟糕的存在。";
		next;
		select( "它现在变成了谁的样子？" );
		cutin "rigel_annoying01.png",2;
		mes "[Rigel]";
		mes "是我。";
		next;
		select( "这是什么意思？" );
		cutin "rigel_halfeyes01.png",2;
		mes "[Rigel]";
		mes "这个囚犯吞噬了来自第326次元的我——里格尔，变成了自称生命星座的存在。";
		next;
		mes "[Rigel]";
		mes "当我逃跑自救时已经太晚了。看到那个与我一模一样的昏迷者时，我立刻知道那不是我。";
		next;
		cutin "rigel_annoying01.png",2;
		mes "[Rigel]";
		mes "虽然我们成功封印了那个无法正确使用力量的家伙，但它有一天可能会成功破除封印。";
		next;
		select( "你为什么不亲自解决罪犯？" );
		cutin "rigel01.png",2;
		mes "[Rigel]";
		mes "我不知道错误在哪里，但世界将它认作另一个生命星座。如果星座攻击同一星座，就会违反次元规则并立即失去力量。";
		next;
		mes "[Rigel]";
		mes "而且，如果它碰巧夺取了我的存在，就会陷入不可逆的局面。";
		next;
		select( "囚犯有可能夺取我们的身体吗？" );
		cutin "rigel_close02.png",2;
		mes "[Rigel]";
		mes "这是我几百年来听过的最有趣笑话之一。";
		next;
		cutin "rigel_halfeyes02.png",2;
		mes "[Rigel]";
		mes "你会放弃辛苦占据的不朽身体，回到自己的凡人身体吗？";
		next;
		select( "也许在生命受到威胁时会。" );
		cutin "rigel_halfeyes01.png",2;
		mes "[Rigel]";
		mes "我完全不同意这个看法，但我来消除你的担忧。它被我设置的层层封印包围。";
		next;
		mes "[Rigel]";
		mes "即使它想夺取你和朋友们的身体，也无法施展那种力量。";
		next;
		cutin "rigel_close01.png",2;
		mes "[Rigel]";
		mes "说来话长。监狱入口会单独张贴监狱信息，请定期查看。";
		next;
		mes "[Rigel]";
		mes "期待看到你和同伴在这里出色完成工作。";
		close2;
		cutin "",255;
		completequest 12597;
		cloakonnpcself( "Rigel#life2" );
		end;
	case 2:
		break;
	}
	mes "[Sealing Spirit Stone]";
	mes "正确管理监狱的指南。你想查看哪项？";
	next;
	while(1) {
		switch( select( "停止查看", "重新发放星座守护", "囚犯信息", "监狱进入信息", "屏障信息", "陷阱信息", "圣域信息", "里世界信息", "危险征兆信息", "囚犯恢复力信息" ) ) {
		case 1:
			end;
		case 2:
			if (countitem(420231) - isequippedcnt(420231) < 1) {
				mes "[Sealing Spirit Stone]";
				mes "请再次确认它是否已在^ff0000装备套装设置^000000中登记，以及是否已经安装。";
				mes " ";
				mes "即使你拥有两个或更多祝福，冒险者^ff0000灵魂中刻下的记录优先^000000，因此建议你将多余的祝福在商店处理掉。";
				next;
				if (select( "取消", "重新发放" ) == 1)
					continue;
				mes "[Sealing Spirit Stone]";
				mes "根据刻在冒险者灵魂中的记录";
				mes "我们重新发放了刻有^0000ff1级屏障^000000的守护。";
				getitem2 420231,1,1,0,0,0,0,0,312453;	// MD_Hol_Protection
				close;
			}
			mes "[Sealing Spirit Stone]";
			mes "你的物品栏中已有发放的守护。只有物品栏中没有星座守护时才能重新发放。";
			close;
		case 3:
			mes "[囚犯信息指南]";
			mes "根据这本书，左侧是关押管理次元罪犯的守卫的熔岩湖，右侧是关押次元管理者的生命大厅。";
			mes " ";
			mes "守卫原本负责监视次元罪犯，但某个时候开始表现出保护次元罪犯的意图。";
			next;
			mes "[囚犯信息指南]";
			mes "因此，生命星座将作为守卫的4名神圣囚犯关押在与次元罪犯完全分离的次元中。";
			mes " ";
			mes "主要囚犯是次元罪犯，一种窃取第326次元生命星座外表和能力的变身怪型魔物。目前从未测量过它的危险等级，因此没有记录。";
			next;
			mes "[囚犯信息指南]";
			mes "有一点可以确定：次元罪犯劫持了次元生命星座的身体和力量。";
			mes " ";
			mes "由于这一连串事件，第326次元不仅缺少生命星座，4只神兽的位置也空缺。因此，管理者必须带着两个主要目标管理这座监狱。";
			next;
			mes "-第一-";
			mes "你必须定期攻击次元罪犯，防止它们积蓄力量。";
			mes " ";
			mes "即使现在，它也在积累大量生命能量，可能对次元世界造成严重危险。";
			next;
			mes "-第二-";
			mes "必须测量并记录次元罪犯释放的力量等级。";
			mes " ";
			mes "进入监狱时，可以装备被星座触碰过的守护，并根据其附带屏障等级测量和记录风险等级。";
			next;
			mes "-第三-";
			mes "虽然重要性较低，但仍需定期前往狱卒的监狱削弱其力量。";
			mes " ";
			mes "当前关押的守卫是危险力量，可能同情次元罪犯逃脱。定期用武力压制它们，并没收它们管理或制造的监狱钥匙。";
			next;
			mes "[囚犯信息指南]";
			mes "这就是监狱囚犯的信息。还需要其他信息吗？";
			break;
		case 4:
			mes "[Access information information]";
			mes "监狱分为关押守卫的区域和关押次元罪犯的区域。";
			mes " ";
			mes "首先，每天可以进入一次关押守卫的熔岩湖。没有额外封印，只要遵守每天一次的限制，进入没有特别限制。";
			next;
			mes "[Access information information]";
			mes "关押次元罪犯的生命大厅";
			mes "持有" + mesitemlink(1001415) + ".";
			mes " ";
			mes "记住，除了一小时的地下城时间限制外，只要有钥匙，你可以随意进入。";
			next;
			mes "[Access information information]";
			mes "但是，领取一次奖励后，^ff0000一周内^000000无法再次在生命大厅领取奖励。当然，即使如此，进入仍然免费。";
			mes " ";
			mes "还需要其他信息吗？";
			break;
		case 5:
			mes "[屏障信息指南]";
			mes "次元罪犯的力量被生命星座里格尔牢牢束缚在屏障中。";
			mes " ";
			mes "因此，进入监狱管理时，遇到的第一个次元罪犯会被调整屏障，只能释放最低等级的力量。";
			next;
			mes "[屏障信息指南]";
			mes "不过，如果你适当修正次元罪犯并使其屈服，就能获得相应的^ff0000补偿^000000，或延后奖励并获得解锁下一个^ff0000屏障^000000等级的机会。";
			next;
			mes "[屏障信息指南]";
			mes "想要更高的奖励等级，请记住，清除屏障比选择奖励更有利于快速升级。";
			next;
			mes "[屏障信息指南]";
			mes "不过，单纯提升屏障等级并没有好处。";
			mes " ";
			mes "如果修正次元罪犯失败，下次进入监狱时你能处理的屏障等级会下降1级。^000000";
			next;
			mes "[屏障信息指南]";
			mes "我建议不要过度关注无法处理的屏障，努力进行稳定修正。";
			mes " ";
			mes "还需要其他信息吗？";
			break;
		case 6:
			mes "[陷阱信息指南]";
			mes "次元罪犯使用力量，让空间中出现时间流动陷阱，以阻止外来入侵者。";
			mes " ";
			mes "陷阱危险程度取决于屏障等级，离监狱中心越远，破坏力越强。";
			next;
			mes "[陷阱信息指南]";
			mes "此外，^ff0000你或队友每次受到陷阱伤害，次元罪犯的攻击力都会增强。^000000";
			next;
			mes "[陷阱信息指南]";
			mes "如果监狱充满陷阱，可以利用里世界重置陷阱。相关内容请参考里世界信息。";
			mes " ";
			mes "还需要其他信息吗？";
			break;
		case 7:
			mes "[圣域信息指南]";
			mes "次元罪犯可以定期在周围建立圣域，使自己免疫物理和魔法攻击。";
			mes " ";
			mes "这似乎是高阶星座拥有的能力，无法通过任何手段解除。";
			next;
			mes "[圣域信息指南]";
			mes "不过，如果把已宣告圣域的次元罪犯拉出圣域，圣域就会取消。如果次元罪犯利用圣域横行，就把它拉出圣域。";
			mes " ";
			mes "还需要其他信息吗？";
			break;
		case 8:
			mes "[里世界信息指南]";
			mes "监狱中的陷阱超过一定数量时，监狱北侧会出现通往里世界的传送门。";
			mes " ";
			mes "里世界中有次元罪犯的不完整幻象，这些幻象与次元罪犯存在不完整的联系。";
			next;
			mes "[里世界信息指南]";
			mes "里世界的所有幻象被击败的瞬间，原世界的次元罪犯会受到强力打击，并在一段时间内陷入昏沉状态。";
			mes " ";
			mes "此时监狱内的陷阱会重置，次元罪犯积累的所有攻击力恢复原状，其防御力也会在短时间内大幅降低。";
			next;
			mes "[里世界信息指南]";
			mes "不过，不应让太多人使用通往里世界的传送门。";
			mes " ";
			mes "因为每有一人通过传送门，次元罪犯每秒恢复量就会增加一定数值，数值叠加后可能瞬间恢复生命。";
			next;
			mes "[里世界信息指南]";
			mes "记住，为了消灭里世界幻象，最好由少数拥有强大攻击力和机动性的队员组成队伍。";
			mes " ";
			mes "还需要其他信息吗？";
			break;
		case 9:
			mes "[危险征兆指南]";
			mes "修正次元罪犯时，如果看到地面出现异常效果，请迅速离开区域。";
			mes " ";
			mes "这种效果是次元罪犯即将释放大范围强力影响的前兆。";
			next;
			mes "[危险征兆指南]";
			mes "次元罪犯的影响可能造成禁锢、严重割伤和冻伤，有时甚至导致死亡。";
			mes " ";
			mes "一刻也不要移开对地面的视线，并警惕四面八方。";
			mes " ";
			mes "还需要其他信息吗？";
			break;
		case 10:
			mes "[恢复力信息指南]";
			mes "次元罪犯拥有实时恢复生命的能力。因此，除非一次攻击超过恢复能力，否则可能无法正常修正。";
			mes " ";
			mes "里世界被净化的瞬间，次元罪犯陷入昏沉状态期间，恢复速度会大幅下降。";
			next;
			mes "[恢复力信息指南]";
			mes "不过别忘了，^ff0000使用传送门净化里世界的人数越多，恢复量也会相应增加。^000000";
			mes "如果传送门使用者过多，恢复力快速增加，正常修正可能会失败。";
			mes " ";
			mes "还需要其他信息吗？";
			break;
		}
		next;
	}
	end;

OnInit:
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "isbegin_quest(12597) == 1" );
	end;
}



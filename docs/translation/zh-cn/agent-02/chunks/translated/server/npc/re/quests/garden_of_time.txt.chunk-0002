// t_garden,118,142,3	script(CLOAKED)	Oscar#life2	4_ED_OSCAR,2,2,{	// unknown OnTouch effect
t_garden,118,142,3	script(CLOAKED)	Oscar#life2	4_ED_OSCAR,{
	if (isbegin_quest(12618) == 1) {
		cutin "OSCAR01.bmp",2;
		mes "[奥斯卡]";
		mes "啊 " + strcharinfo(0) + ".";
		next;
		cutin "OSCAR09.bmp",2;
		mes "[奥斯卡]";
		mes "确实如此。很抱歉无意中让你卷入了我们的工作。";
		next;
		select( "你要进入宅邸吗？" );
		cutin "OSCAR01.bmp",2;
		mes "[奥斯卡]";
		mes "看来只能这样了。这座宅邸是多条时间线错综交织的空间，我想其他人无法触及。";
		next;
		select( "我能在宅邸里帮忙吗？" );
		cutin "OSCAR05.bmp",2;
		mes "[奥斯卡]";
		mes "" + strcharinfo(0) + "我和你合作过很多次，很想请你同行，但这次恐怕不行。";
		next;
		cutin "OSCAR09.bmp",2;
		mes "[奥斯卡]";
		mes "这座宅邸内的时间流速与外界大不相同。我的猜测是……大约1/1000？甚至更慢？";
		next;
		select( "也就是说……" );
		cutin "OSCAR07.bmp",2;
		mes "[奥斯卡]";
		mes "这意味着即使你只在宅邸内待几天，外界也可能过去数年甚至数十年。对人类来说可能很难承受，" + strcharinfo(0) + " to endure it";
		next;
		cutin "OSCAR01.bmp",2;
		mes "[奥斯卡]";
		mes "清理宅邸内部时，外界很可能已经过去很长时间。必须尽快结束……";
		next;
		cloakoffnpcself( "Leticia#life3" );
		cutin "4job_leticia_01.png",2;
		mes "[莱蒂西亚]";
		mes "哦，你现在要进去吗？";
		next;
		cutin "OSCAR01.bmp",2;
		mes "[奥斯卡]";
		mes "是的，我必须进去。莱蒂西亚，希望你别惹麻烦，在我清理完宅邸出来前好好照顾花园。";
		next;
		cutin "4job_leticia_05.png",2;
		mes "[莱蒂西亚]";
		mes "哦，别担心。我会确保你与现实世界隔离。";
		next;
		cutin "OSCAR01.bmp",2;
		mes "[奥斯卡]";
		mes "好。那么请多关照。哦，还有" + strcharinfo(0) + "，如果你有时间，希望你能帮帮莱蒂西亚。她太懒了……";
		next;
		cutin "4job_leticia_04.png",2;
		mes "[莱蒂西亚]";
		mes "我会照顾这里的冒险者，就这样吧，我们进去。";
		next;
		cutin "OSCAR03.bmp",2;
		mes "[奥斯卡]";
		mes "好，我会尽快完成工作出来。到时见。";
		close2;
		cutin "",255;
		specialeffect EF_BEGINSPELL_N4;
		setpcblock PCBLOCK_NPC, true;
		sleep2 2000;
		cloakonnpcself( "Oscar#life2" );
		setpcblock PCBLOCK_NPC, false;
		cutin "4job_leticia_02.png",2;
		mes "[莱蒂西亚]";
		mes "嗯，我相信奥斯卡会处理好……别傻站着，来帮里格尔和我的工作。";
		close2;
		cutin "",255;
		cloakonnpcself( "Leticia#life3" );
		completequest 12618;
		end;
	}
	end;

OnInit:
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "isbegin_quest(12618) == 1" );
	end;
}


		emotion ET_ANGER, getnpcid(0,"Passionate Youth#Radica");
		mes "[Radical Man]";
		mes "拉谢尔的土地原本属于我们原住民。";
		mes "现在是夺回它的时候了！";
		npctalk "我们必须打破并夺回它！", "Hot-blooded Youth#Radic", bc_self;
		npctalk "没错，我们现在必须战斗！这是战争！", "Hot-blooded Youth#Radic", bc_self;
		next;
		mes "[Native old man]";
		mes "说起来容易，做起来难。没有准备你打算怎么办？";
		mes "而且你不知道一旦流血，就再也无法挽回吗？";
		npctalk "连战斗都没试过就谈战争，太荒谬了！", "Timid Old Man#Elder3", bc_self;
		next;
		mes "[Radical Man]";
		mes "我们至今难道还没流过血吗？";
		mes "他们也许一滴血都没流过。";
		next;
		mes "[Radical Man]";
		mes "可是被边缘化的原住民遭受暴力，忍受了无数年，甚至连应得的工资都拿不到。";
		mes "如果他们流下的不是血和泪，那还能叫做什么？";
		npctalk "我们只剩战争这一条路了！", "Radical Youth#Radical2", bc_self;
		npctalk "反对的人就是同样的压迫者！", "Angry Youth#Radical5", bc_self;
		next;
		cutin "ep18_maram_03.png",2;
		mes "[Maram]";
		mes "呃，气氛似乎有点过热了。";
		mes "苏阿德，你不觉得该冷静一点吗？";
		next;
		cutin "ep18_suad_03.png",2;
		emotion ET_THINK, getnpcid(0,"Suad#1");
		mes "[Suad]";
		mes "我们再观察一会儿。";
		next;
		cutin "",255;
		mes "[Mini Elly]";
		mes "有点奇怪。";
		mes "连反对者都逼入绝境的说辞，看起来像是敌人的策略。";
		next;
		mes "[Radical Man]";
		mes "我们已经忍够了！";
		mes "把我们的愤怒展现给那些只被女神迷住的人看看！";
		npctalk "让我们展现愤怒！", "Radical Youth#Radical2", bc_self;
		next;
		mes "[Elderly Man]";
		mes "他们看起来是些无所畏惧的年轻人，对吧？";
		mes "一步走错，他们全都会死！为什么要冒这种险？";
		next;
		mes "[Radical Man]";
		mes "哼，只为了保住卑微性命而躲在这里的人不会理解。";
		mes "我们早已赌上性命，准备以血还血！";
		next;
		cutin "ep18_maram_01.png",2;
		mes "[Maram]";
		mes "你做了吗？我还没做……听说用冷水才能把血洗干净。";
		next;
		cutin "ep18_miriam_03.png",2;
		mes "[Miriam]";
		mes "现在不是开玩笑的时候，马拉姆。";
		mes "还有苏阿德，如果你不妥善组织，森林居民的意见就会像这样彻底分裂。";
		next;
		mes "[Miriam]";
		mes "即使我不愿意，现在似乎也到了组织起来的时候。";
		next;
		cutin "ep18_suad_03.png",2;
		emotion ET_THINK, getnpcid(0,"Suad#1");
		mes "[Suad]";
		mes "够了，这里不是让我们彼此争得面红耳赤的地方，而是收集意见、继续前进的场所。";
		mes "到此为止吧，我们建立这里不是为了让彼此脸红争吵。";
		npctalk "苏阿德：够了，这里不是让我们彼此争得面红耳赤的地方。", "Suad#1", bc_self;
		next;
		cutin "",255;
		emotion ET_ANGER, getnpcid(0,"Passionate Youth#Radica");
		mes "[Radical Man]";
		mes "那么从现在开始，我们要摧毁挡在路上的一切吗？";
		mes "苏阿德先生，你不会和那些失败主义者站在一起吧？";
		next;
		mes "[Elderly Man]";
		mes "听好了。我可不会被那些穿着亮蓝色、无知又吵闹的孩子胡说八道所左右，对吧？";
		next;
		cutin "ep18_suad_02.png",2;
		mes "[Suad]";
		mes "你想离开我吗？";
		mes "如果你以为有人会听你们这一边的话，那看来我一直误会你了。";
		next;
		cutin "ep18_suad_03.png",2;
		mes "[Suad]";
		mes "我会听取双方的观点和理由。";
		mes "有人认为不可能永远留在这里，也有人认为毫无准备地贸然行动会招致耻辱。两种观点都没有错。";
		next;
		cutin "ep18_suad_01.png",2;
		mes "[Suad]";
		mes "所以不要想着在我们内部选边站，而是试着互相说服。";
		mes "也就是说，说明应该如何以及为什么实现各自的意见。";
		npctalk "...", "Embarrassed Old Man#Eld", bc_self;
		npctalk "...", "Radical Youth#Radical2", bc_self;
		next;
		cutin "",255;
		mes "[Radical Man]";
		mes "我们已经有武装自己的能力。";
		mes "说我们没有准备毫无意义。";
		next;
		cutin "ep18_maram_03.png",2;
		emotion ET_QUESTION, getnpcid(0,"Maram#1");
		mes "[Maram]";
		mes "咦？你的意思是有一条我不知道的武器采购渠道？";
		mes "我还是第一次听说这种事……";
		next;
		cutin "",255;
		mes "[Radical Man]";
		mes "你打算准备到什么时候！";
		mes "准备到我们老死吗？准备到下一代学会彻底放弃吗？";
		next;
		mes "[Native old man]";
		mes "但武装冲突很危险。一旦失败就无法挽回。";
		mes "叛乱不是选项。我们最多只能支持抗议。";
		npctalk "我们也同意抗议。", "Timid Old Man#Elder4", bc_self;
		npctalk "我们反对战争，但如果是抗议……", "Timid Youth#Neutral1", bc_self;
		next;
		mes "[Timid Old-man]";
		mes "当然。我们不想被彻底当成反动分子！";
		mes "如果被贴上这样的标签，在这里生活也会变得困难。";
		next;
		mes "[Timid Old-man]";
		mes "我只是想表明我们有这么多不满。";
		mes "我反对砸毁一切之类的做法。";
		npctalk "是的，没错。尽量低调吧。", "Neutral Youth#Neutral3", bc_self;
		next;
		mes "[Timid Man]";
		mes "如果大家能团结起来，我们也支持抗议。";
		mes "让我们表达自己的意见。";
		next;
		mes "[Radical Man]";
		mes "就算抗议，只靠言语进行的非暴力抗议也完全不起作用！";
		mes "至少要占领神殿进行抗议。";
		next;
		mes "[Passionate Man]";
		mes "没错。假装听见了吗，大声说出来，好吗？";
		mes "如果夺走他们最重视的东西，他们就会开始注意我们。";
		next;
		mes "[Mini Elly]";
		mes "原本看似和平地汇集意见，却又再次转向暴力了……";
		next;
		cutin "ep18_suad_01.png",2;
		emotion ET_SURPRISE, getnpcid(0,"Suad#1");
		mes "[Suad]";
		mes "停下，我们收集到的意见够多了吗？";
		mes "我们是否赞成进行抗议、占领神殿并表明意图？";
		next;
		cutin "",255;
		mes "[Radical Man]";
		mes "虽然不完全合我心意……但这似乎是共识。";
		next;
		mes "[Native old man]";
		mes "看起来仍然很危险，但无论如何我们必须表明意图。";
		next;
		cutin "ep18_suad_01.png",2;
		mes "[Suad]";
		mes "那么，为了进一步讨论细节，我们会另行召开会议。";
		mes "你明白这次会议必须保密，对吧？";
		npctalk "苏阿德：主要会议就到这里吧。", "Suad#1", bc_self;
		next;
		mes "[Suad]";
		mes "冒险者、马拉姆和米里亚姆。除少数人外，暂时解散吧。";
		mes "行动方案确定后，我们会通知你们详细计划。";
		next;
		cutin "",255;
		mes "[Radical Man]";
		mes "让我们通过非暴力抗议展现些什么吧！";
		mes "加油，加油！";
		next;
		mes "[Elderly Man]";
		mes "我们的判断正确吗？";
		mes "我认为不该被阿德尔的建议左右。";
		cloakonnpcself( "Passionate Youth#Radica" );
		cloakonnpcself( "Quiet Youth#Neutral2" );
		cloakonnpcself( "Timid Old Man#Elder3" );
		cloakonnpcself( "Angry Youth#Radical5" );
		next;
		mes "[Neutral Youth]";
		mes "我们真的能做到吗？";
		mes "不过既然已经在会议上决定了，我们就尽量配合吧。";
		cloakonnpcself( "Native Old Man#Elder1" );
		cloakonnpcself( "Embarrassed Old Man#Eld" );
		cloakonnpcself( "Hot-blooded Youth#Radic" );
		cloakonnpcself( "Timid Youth#Neutral1" );
		next;
		cutin "ep18_miriam_03.png",2;
		cloakonnpcself( "Passionate Old Man#Weap" );
		cloakonnpcself( "Radical Youth#Radical2" );
		cloakonnpcself( "Neutral Youth#Neutral3" );
		cloakonnpcself( "Timid Old Man#Elder4" );
		mes "[Miriam]";
		mes "冒险者，我有件小事要商量，你能过来一下吗？";
		mes "苏阿德、马拉姆，也请你们在会议前抽点时间。";
		erasequest 16572;
		setquest 16573;
		ep18_main = 41;
		close3;
	}
	if (ep18_main == 41) {
		cutin "ep18_suad_03.png",2;
		mes "[Suad]";
		mes "怎么了？如果是突然做出的决定，之后在现实中可能很难执行。";
		next;
		cutin "ep18_miriam_03.png",2;
		mes "[Miriam]";
		mes "重要的谈话。请给我一点时间。";
		close3;
	}
	if (ep18_main == 42) {
		cutin "ep18_suad_01.png",2;
		mes "[Suad]";
		mes "那么就拜托你了。";
		mes "我也会在这里尽力而为。";
		next;
		mes "[Suad]";
		mes "尽可能减少冲突，确保抗议安全结束……我的意思是这样。";
		close3;
	}
	end;

OnInit:
	questinfo( QTYPE_QUEST2, QMARK_YELLOW, "isbegin_quest(16567) == 1" );
	questinfo( QTYPE_QUEST2, QMARK_YELLOW, "isbegin_quest(16572) == 1" );
	end;
}

// Main Quest: Step 37.
wolfvill,145,146,5	script(CLOAKED)	Passionate Youth#Radica	4_EP18_GW_MAN01,{
	if (ep18_main < 38)
		end;
	if (ep18_main == 39) {
		if (isbegin_quest(16568) == 1) {
			mes "[Radical Man]";
			mes "所有神殿，包括芙蕾雅神殿，都必须摧毁！";
			mes "让我们看看谁才是这片土地真正的主人！";
			next;
			mes "[Radical Man]";
			mes "吼！吼！吼！吼！";
			mes "我们必须变强！必须武装自己！";
			next;
			mes "[Passionate Man]";
			mes "呜！呜！让我们获胜！战斗吧！";
				npctalk "赢下来！战斗吧！", "Radical Youth#Radical2", bc_self;
				npctalk "赢下来！战斗吧！", "Radical Young Man#Radic", bc_self;
				npctalk "赢下来！战斗吧！", "Excited Youth#Radical3", bc_self;
				npctalk "赢下来！战斗吧！", "Hot-blooded Youth#Radic", bc_self;
				npctalk "赢下来！战斗吧！", "Angry Youth#Radical5", bc_self;
			next;
			mes "[Radical Man]";
			mes "这是为了保护自己、寻找安身之处！";
			mes "这是我们现在必须做的事！";
			completequest 16568;
			if (isbegin_quest(16568) == 2 && isbegin_quest(16569) == 2 && isbegin_quest(16570) == 2 && isbegin_quest(16571) == 2) {
				erasequest 16568;
				erasequest 16569;
				erasequest 16570;
				erasequest 16571;
				setquest 16572;
				ep18_main = 40;
			}
			close3;
		}
	}
	mes "[Radical Man]";
	mes "让我们看看谁才是这片土地的主人！";
	close;

OnInit:
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "isbegin_quest(16568) == 1" );
	end;
}

// Main Quest: Step 38.
wolfvill,139,148,5	script(CLOAKED)	Native Old Man#Elder1	4_EP18_GW_OLD01,{
	if (ep18_main < 38)
		end;
	if (ep18_main == 39) {
		if (isbegin_quest(16569) == 1) {
			mes "[Native old man]";
			mes "我出生以来从未离开过这个村庄。";
			mes "我在这座城镇出生、长大、老去。";
			next;
			mes "[Native old man]";
			mes "虽然我一直这样生活，但并不代表从来没有问题……";
			mes "可是现在真的必须采取极端措施吗？";
			next;
			mes "[Native old man]";
			mes "年轻人难道是因为一时冲动才做这些无意义的事吗？";
			mes "如果他们犯下大错，承担后果怎么办？";
			next;
			mes "[Native old man]";
			mes "不，我并不完全反对年轻人的想法。";
			mes "但我们还是别做太极端的事。";
			completequest 16569;
			if (isbegin_quest(16568) == 2 && isbegin_quest(16569) == 2 && isbegin_quest(16570) == 2 && isbegin_quest(16571) == 2) {
				erasequest 16568;
				erasequest 16569;
				erasequest 16570;
				erasequest 16571;
				setquest 16572;
				ep18_main = 40;
				unittalk getcharid(3), "" + strcharinfo(0) + " : It seems like I've heard enough at this point. Let's go back to Suad.", bc_self;
			}
			close3;
		}
	}
	end;

OnInit:
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "isbegin_quest(16569) == 1" );
	end;
}

// Main Quest: Step 39.
wolfvill,150,147,1	script(CLOAKED)	Passionate Old Man#Weap	4_M_MIDDLE,{
	if (ep18_main < 38)
		end;
	if (ep18_main == 39) {
		if (isbegin_quest(16570) == 1) {
			mes "[Passionate Man]";
			mes "哎呀！这不是冒险者吗！";
			mes "比赛前一定很紧张吧？来喝一杯放松一下。";
			next;
			select( "I'll have what you're having.", "Where then, bottoms up!" );
			mes "[Passionate Man]";
			mes "嘿，那个苏阿德真是讲究，太一丝不苟了。";
			mes "真的有必要那么死板吗？";
			next;
			mes "[Passionate Man]";
			mes "别因为是正式场合就太紧张，放松地说吧。";
			mes "如果可以的话，冒险者也支持我们的意见就更好了！";
			next;
			mes "[Passionate Man]";
			mes "你觉得我们的意见是什么？当然是战争。";
			mes "看看这些武器。我们已经全副武装、准备好了！";
			next;
			mes "[Passionate Man]";
			mes "直接去拉谢尔，把一切都扫除，不管是女神还是什么。";
			mes "这就能展现我们至今忍受并坚持了多久！";
			completequest 16570;
			if (isbegin_quest(16568) == 2 && isbegin_quest(16569) == 2 && isbegin_quest(16570) == 2 && isbegin_quest(16571) == 2) {
				erasequest 16568;
				erasequest 16569;
				erasequest 16570;
				erasequest 16571;
				setquest 16572;
				ep18_main = 40;
			}
			close3;
		}
	}
	mes "[Passionate Man]";
	mes "这是比赛，是比赛。一场盛大的活动！";
	mes "来，我们喝一杯！干杯，干杯！";
	close;

OnInit:
	questinfo( QTYPE_QUEST2, QMARK_YELLOW, "isbegin_quest(16570) == 1" );
	end;
}

// Main Quest: Step 40.
wolfvill,152,145,1	script(CLOAKED)	Timid Youth#Neutral1	4_M_RACHMAN1,{
	if (ep18_main < 39)
		end;
	if (ep18_main == 39) {
		if (isbegin_quest(16571) == 1) {
			mes "[Timid Man]";
			mes "哦，我们的意见？";
			mes "我们还年轻，说这些话真的好吗？";
			next;
			mes "[Timid Man]";
			mes "那边喊得那么大声的家伙毕竟还年轻。";
			mes "我不知道他们信什么，也不明白为什么要闹成这样去战斗……";
			next;
			mes "[Timid Man]";
			mes "我不认为我们真的能把所有拉谢尔移民打倒并赶走。";
			mes "光是人数差距就这么悬殊。";
			next;
			mes "[Timid Man]";
			mes "我们连特种部队训练都没接受过，对吧？";
			mes "但我也不知道是谁先开始的，那些人突然变多，让我很不安。";
			completequest 16571;
			if (isbegin_quest(16568) == 2 && isbegin_quest(16569) == 2 && isbegin_quest(16570) == 2 && isbegin_quest(16571) == 2) {
				erasequest 16568;
				erasequest 16569;
				erasequest 16570;
				erasequest 16571;
				setquest 16572;
				ep18_main = 40;
			}
			close3;
		}
	}
	mes "[Timid Man]";
	mes "我们还年轻，这样大声表达意见真的好吗？";
	mes "虽然是比赛，但我想成年人不会这么大声，对吧？";
	close;

OnInit:
	questinfo( QTYPE_QUEST2, QMARK_YELLOW, "isbegin_quest(16571) == 1" );
	end;
}

wolfvill,149,152,3	script(CLOAKED)	Maram#1	4_EP18_MARAM,{
	if (ep18_main == 38) {
		cutin "ep18_maram_01.png",2;
		mes "[Maram]";
		mes "呼呼呼，你终于来到这里了。";
		mes "你相信了我的判断，但冒险者，你比我想象的还要出色。";
		next;
		mes "[Maram]";
		mes "希望你也能积极参加会议。";
		mes "苏阿德有点固执，需要有人稍微缓和一下气氛~";
		next;
		cutin "ep18_maram_02.png",2;
		mes "[Maram]";
		mes "我就指望冒险者了。我仍然相信自己的直觉。";
		mes "我相信自己的眼光和话语。";
		close3;
	}
	if (ep18_main == 39) {
		cutin "ep18_maram_01.png",2;
		mes "[Maram]";
		mes "嘘！比赛马上就要开始了。";
		mes "如果我发出声音，米里亚姆和苏阿德会骂我的。";
		close3;
	}
	if (ep18_main == 40) {
		cutin "ep18_maram_01.png",2;
		mes "[Maram]";
		mes "嘘！比赛马上就要开始了。";
		mes "如果我提前发出声音，会被米里亚姆和苏阿德骂吗？";
		next;
		mes "[Maram]";
		mes "所以，冒险者，请和我们一起听苏阿德的故事。";
		mes "当然，也听听其他人的故事。";
		close3;
	}
	end;
}

// Main Quest: Step 42.
wolfvill,148,153,3	script(CLOAKED)	Miriam#1	4_EP18_MIRIAM,{
	if (checkweight(1000405,40) == 0) {
		mes "- 请稍等！！-";
		mes "- 你目前携带了-";
		mes "- 太多物品。-";
		mes "- 请减轻负重-";
		mes "- 后再试。-";
		close;
	}
	if (getequipid(EQI_HEAD_TOP) != 400127) {	// Ep18_Mini_Elly
		mes "[Mini Elly]";
		mes "请从背包里取出它，戴在头上。";
		close;
	}
	if (ep18_main == 38) {
		cutin "ep18_miriam_01.png",2;
		mes "[Miriam]";
		mes "啊，我就知道你最终会来参加比赛。";
		mes "没有人反对冒险者参加。";
		next;

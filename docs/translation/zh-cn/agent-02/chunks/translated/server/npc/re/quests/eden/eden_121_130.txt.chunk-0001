//===== rAthena Script =======================================
//= Eden Group Quests - Mission [121-130]
//===== By: ==================================================
//= Capuche
//===== Current Version: =====================================
//= 1.2
//===== Compatible With: =====================================
//= rAthena Project
//===== Description: =========================================
//= [Official Conversion]
//= Repeatable quests for players between BaseLevel 121 - 130.
//===== Additional Comments: =================================
//= 1.0 First version.
//= 1.1 Added support to Para_Team_Mark_ in Eden Group. [Ragno]
//= 1.2 Added use of F_HasEdenGroupMark function. [Ragno]
//============================================================

moc_para01,44,81,3	script	Melody-Jack#1	4_M_MELODY,8,8,{
	mes "[Melody-Jack]";
	if (!callfunc("F_HasEdenGroupMark")) {
		mes "你到底是谁？滚出去！";
		mes "我只和基础等级^FF0000121～130^000000的冒险者说话。";
	}
	else if (para_120lv01 == 0)
		mes "什么？别烦我。我现在很忙。";
	else if (para_120lv01 == 1) {
		mes "你收到了那个小女孩的委托？就是那边那个矮小、话多又半裸的女孩？";
		next;
		select("说是。", "避免回答。");
		mes "[Melody-Jack]";
		mes "不，我不在乎。只要你不是因为迷路才走进这房间就行。我需要任何人，唯独不需要那种蠢货。";
		next;
		mes "[Melody-Jack]";
		mes "听我说，我会给你一个诱人的提议。";
		next;
		mes "[Melody-Jack]";
		mes "我是^ff0000梅洛迪·杰克！^000000拥有最强短剑技巧的男人。";
		next;
		mes "梅洛迪·杰克朝你的方向挥了挥短剑。";
		next;
		mes "[Melody-Jack]";
		mes "我有资格执行秘密任务。而现在你走运了。";
		next;
		mes "[Melody-Jack]";
		mes "看来我必须放弃一份委托、一次交易和一个承诺，现在无法亲自接下它。";
		next;
		mes "[Melody-Jack]";
		mes "接下我的任务并完成艾古的委托。我会补偿你。";
		next;
		mes "[Melody-Jack]";
		mes "这笔交易要对艾古保密。如果你不是有九条命，就开始吧。";
		para_120lv01 = 2;
	}
	else if (para_120lv01 > 1) {
		mes "......";
		next;
		if (select( "给我看看委托！", "闲聊。" ) == 2) {
			mes "[Melody-Jack]";
			mes "什么？你对我感兴趣？";
			next;
			switch( select( "我感兴趣。", "关于委托", "关于交易", "承诺是什么？" ) ) {
				mes "[Melody-Jack]";
			case 1:
				mes "那就走开。我对你没兴趣。";
				close;
			case 2:
				mes "因为我的信誉不好，我无法停止。这让我很疯狂。";
				next;
				mes "[Melody-Jack]";
				mes "能和你这样的冒险者签订双重合同，我很幸运。他们不在我们的合同范围内。";
				close;
			case 3:
				mes "老实说，我认为没有人值得信任。信任和承诺都很可笑。";
				next;
				mes "[Melody-Jack]";
				mes "我只相信自己和交易。信任或承诺一旦破裂就毫无意义，但交易破裂会带来补偿或复仇。";
				close;
			case 4:
				mes "这些孩子是谁？";
				next;
				mes "[Melody-Jack]";
				mes "我出来不是为了别的，只是应该履行职责。我不欠任何人什么。";
				close;
			}
		}
		mes "[Melody-Jack]";
		if (BaseLevel < 121)
			mes "哦，我弄错了。你不是我要找的等级冒险者。我寻找的是基础等级121到130的冒险者。";
		else if (BaseLevel < 131) {
			mes "我不喜欢这样，但交易就是交易。清除艾古要求搜索地点的魔物后再回来。";
			next;
			switch( select( "塔纳托斯之塔相关", "拉赫神殿相关", "无名岛相关", "深渊湖相关" ) ) {
				mes "[Melody-Jack]";
			case 1:
				mes "塔纳托斯之塔是最令人头疼的地方。别担心报酬，我说到做到。";
				next;
				switch( select( "复仇女伯爵", "慰藉女士", "庇护女王", "哨兵女士" ) ) {
					mes "[Melody-Jack]";
				case 1:
					if (checkquest(13120,PLAYTIME) == 0)
						mes "我想今天的演出结束了。可我无法放松，万一魔物突然出现怎么办？";
					else if (checkquest(13119,HUNTING) == 1) {
						cutin "�Ź��Ǵ�����ī��",3;  //retribution_card
						mes "我不喜欢那个生物，并不是因为艾古讨厌它们……你竟敢这样？到底是谁在惩罚谁？";
						next;
						mes "[Melody-Jack]";
						mes "这些是世界上最危险的生物。这些生物不值得任何正义。";
						next;
						cutin "",255;
						mes "[Melody-Jack]";
						mes "当然可以相信我，因为我相信真正的交易。让我们清除这些生物。";
					}
					else if (checkquest(13119,HUNTING) == 2) {
						mes "你清除它们了吗？这样那个小男孩就能清静一天了。做得好。";
						callsub S_Quest,13119,13120,1;
					}
					else {
						cutin "�Ź��Ǵ�����ī��",3;  //retribution_card
						mes "如你所知，塔纳托斯之塔是艾古最在意的地方。在某些方面，它也是最危险的地方。";
						next;
						mes "[Melody-Jack]";
						mes "请清除魔物帮助艾古。外行只会把事情弄得一团糟。";
						next;
						cutin "",255;
						if (select( "接受委托。", "停止。" ) == 1) {
							mes "[Melody-Jack]";
							mes "它们一定很多。别忘了保守秘密。";
							callsub S_Quest,13120,13119;
						}
					}
					close;
				case 2:
					if (checkquest(13122,PLAYTIME) == 0)
						mes "我想今天的演出结束了。可我无法放松，万一魔物突然出现怎么办？";
					else if (checkquest(13121,HUNTING) == 1) {
						cutin "�����ϴ���",3;  //solace_card
						mes "那座建筑似乎不是人类建造的，里面总是播放着奇怪的旋律。";
						next;
						mes "[Melody-Jack]";
						mes "不要沉浸在旋律的情绪中，因为那可能是你听到的最后一首歌。";
						next;
						cutin "",255;
						mes "[Melody-Jack]";
						mes "记住，世上有像刀一样锋利的奇怪音乐，足以杀人。";
					}
					else if (checkquest(13121,HUNTING) == 2) {
						mes "你听过他们演奏的旋律吗？如果那个小男孩再次开始演出，你就有机会听到。";
						callsub S_Quest,13121,13122,1;
					}
					else {
						cutin "�����ϴ���",3;  //solace_card
						mes "美妙的旋律。也许因为演奏者是那些生物，所以听起来才美。";
						next;
						mes "[Melody-Jack]";
						mes "不过那是另一个障碍。交易永远优先于个人兴趣。所以清除慰藉女士。";
						next;
						cutin "",255;
						if (select( "接受委托。", "停止。" ) == 1) {
							mes "[Melody-Jack]";
							mes "我们只是履行交易的一方。现在清除那些生物。";
							callsub S_Quest,13122,13121;
						}
					}
					close;
				case 3:
					if (checkquest(13124,PLAYTIME) == 0)
						mes "我想今天的演出结束了。可我无法放松，万一魔物突然出现怎么办？";
					else if (checkquest(13123,HUNTING) == 1) {
						cutin "�Ƚ����ִ���ī��",3;  //shelter_card
						mes "你知道变成魔物的天使吗？我不知道它是否真是天使，但外表像天使。";
						next;
						mes "[Melody-Jack]";
						mes "无论是天使还是生物，都不要因美丽的外表而慌张。你应该完成工作。";
						next;
						mes "[Melody-Jack]";
						mes "万物皆有时。也许你提出这份请求，是因为时机已到。";
						cutin "",255;
					}
					else if (checkquest(13123,HUNTING) == 2) {
						mes "很好。如果有人找我，告诉我一声。那样我可能需要改变交易细节。";
						callsub S_Quest,13123,13124,1;
					}
					else {
						cutin "�Ƚ����ִ���ī��",3;  //shelter_card
						mes "你知道变成魔物的天使吗？我不知道它是否真是天使，但外表像天使。";
						next;
						mes "[Melody-Jack]";
						mes "不管它是真天使还是普通生物，我都不在乎。清除庇护女王。";
						next;
						cutin "",255;
						if (select( "接受委托。", "停止。" ) == 1) {
							mes "[Melody-Jack]";
							mes "凋零的花朵会随风雨落下。这就是你要做的事。";
							emotion ET_BEST;
							callsub S_Quest,13124,13123;
						}
					}
					close;
				case 4:
					if (checkquest(13126,PLAYTIME) == 0)
						mes "我今天的演出结束了。可我无法放松，万一魔物突然出现怎么办？";
					else if (checkquest(13125,HUNTING) == 1) {
						cutin "�����ϴ���ī��",3;  //observation_card
						mes "踏入塔纳托斯之塔上层后，你可能已经感到它们在注视。";
						next;
						mes "[Melody-Jack]";
						mes "哨兵女士不好对付，务必做好战斗准备。";
						next;
						mes "[Melody-Jack]";
						mes "今天是适合赴死的好日子。死的是你还是它们，就看你的努力了。";
						cutin "",255;
					}
					else if (checkquest(13125,HUNTING) == 2) {
						mes "你看起来不错。也许比我想象中更强？不过我还没亲眼确认。";
						callsub S_Quest,13125,13126,1;
					}
					else {
						cutin "�����ϴ���ī��",3;  //observation_card
						mes "如果艾古提出委托，你就会遇到它们。哨兵女士。";
						next;
						mes "[Melody-Jack]";
						mes "希望它们也被清除，这样她就能顺利提出这份委托。";
						next;
						cutin "",255;
						if (select( "接受委托。", "停止。" ) == 1) {
							mes "[Melody-Jack]";
							mes "为了委托而提出的委托……随便吧。";
							callsub S_Quest,13126,13125;
						}
					}
					close;
				}
			case 2:
				mes "艾古的冒险指向拉赫神殿。好吧……艾古寻找的^FF0000那个人^000000出现在任何地方都不奇怪。";
				next;
				switch( select( "凡贝尔克和依莎", "霍德雷姆林", "阿加布和艾希欧" ) ) {
					mes "[Melody-Jack]";
				case 1:
					if (checkquest(13128,PLAYTIME) == 0)
						mes "你可以休息一天。你已经清除得够多了，但狂热正在增加。";
					else if (checkquest(13127,HUNTING) == 1) {
						cutin "�̽Ƕ�ī��",3;  //isilla_card
						mes "自以为正确的人最危险。这个世界充满了蠢货。";
						next;
						mes "[Melody-Jack]";
						mes "他们最终会强迫别人相信自己的信念。让我们清除凡贝尔克和依莎。";
						next;
						mes "[Melody-Jack]";
						mes "这本来与我无关。但这次不同，小男孩可能有危险，所以赶快清除这些魔物。";
						cutin "",255;
					}
					else if (checkquest(13127,HUNTING) == 2) {
						mes "只需一天。会没事的。";
						callsub S_Quest,13127,13128,1;
					}
					else {
						cutin "�Ǻ���ũī��",3;  //vanberk_card
						mes "拉赫神殿禁止普通人进入。你应该知道这一点。";
						next;
						mes "[Melody-Jack]";
						mes "他们以为能在那里找到线索，但那里并不安全。你应该提前清除凡贝尔克和依莎。";
						next;
						cutin "",255;
						if (select( "接受委托。", "停止。" ) == 1) {
							mes "[Melody-Jack]";
							mes "尽快全部清除。";
							emotion ET_SPARK;
							callsub S_Quest,13128,13127;
						}
					}
					close;
				case 2:
					if (checkquest(13130,PLAYTIME) == 0)
						mes "未知魔物很危险，所以先清除它们。有什么事我会通知你。";
					else if (checkquest(13129,HUNTING) == 1) {
						cutin "ȣ�巽��ī��",3;  //hodremlin_card
						mes "冰冷的牙齿可能正在逼近。它的牙齿比你的手更快。";
						next;
						mes "[Melody-Jack]";
						mes "拉赫神殿的危险可能从四面八方逼近。你要小心这个家伙。";
						next;
						mes "[Melody-Jack]";
						mes "专心做好手头的工作就够了。";
						cutin "",255;
					}
					else if (checkquest(13129,HUNTING) == 2) {
						mes "我没那么担心，但你还安全吗？没被咬吧？";
						callsub S_Quest,13129,13130,1;
					}
					else {
						cutin "ȣ�巽��ī��",3;  //hodremlin_card
						mes "狂热者是个问题。更严重的是，他们会突然出现。";
						next;
						mes "[Melody-Jack]";
						mes "毫不犹豫地消灭^FF0000霍德雷姆林^000000，因为它们非常危险。";
						next;
						cutin "",255;
						if (select( "接受委托。", "停止。" ) == 1) {
							mes "[Melody-Jack]";
							mes "它们需要比头脑更快的双手。我不担心，但你要小心。";
							callsub S_Quest,13130,13129;
						}
					}
					close;
				case 3:
					if (checkquest(13132,PLAYTIME) == 0)
						mes "如果你能说话的话，现在没有委托。今天休息吧。";
					else if (checkquest(13131,HUNTING) == 1) {
						cutin "��Ű��ī��",3;  //echio_card
						mes "这里充满疯狂。我只觉得恶心。";
						next;
						mes "[Melody-Jack]";
						mes "这是我的感受，但你可能会喜欢。我敢肯定^FF0000阿加布^000000和^FF0000艾希欧^000000不会喜欢你。";
						next;
						mes "[Melody-Jack]";
						mes "它们会主动冲向你。不要犹豫，专心完成任务。";
						cutin "",255;
					}
					else if (checkquest(13131,HUNTING) == 2) {
						mes "找到人了吗？我不担心。承诺就是承诺，交易就是交易。";
						callsub S_Quest,13131,13132,1;
					}
					else {
						cutin "�ư���ī��",3;  //agav_card
						mes "拉赫神殿内部确实越来越危险，但艾古不会在意我们无法确认的事情。";
						next;
						mes "[Melody-Jack]";
						mes "没那么糟。但有人需要帮助。让我们清除拉赫神殿内的^FF0000阿加布^000000和^FF0000艾希欧^000000。";
						next;
						cutin "",255;
						if (select( "接受委托。", "停止。" ) == 1) {
							mes "[Melody-Jack]";
							mes "我不能离开，就此告别。";
							callsub S_Quest,13132,13131;
						}
					}
					close;
				}
			case 3:
				mes "普通冒险者并不了解无名岛。艾古也对那里感兴趣。";
				next;
				switch( select( "猎杀破烂僵尸", "猎杀僵尸屠杀者", "猎杀女妖" ) ) {
					mes "[Melody-Jack]";
				case 1:
					if (checkquest(13134,PLAYTIME) == 0)
						mes "破烂僵尸数量减少了。现在是暂时推进艾古委托的好时机。";
					else if (checkquest(13133,HUNTING) == 1) {
						cutin "����������ī��",3;  //ragged_zombie_card
						mes "在无名岛上什么都很容易遇到。真无聊。";
						next;
						mes "[Melody-Jack]";
						mes "消灭它，帮助艾古和其他冒险者。";
						cutin "",255;
					}
					else if (checkquest(13133,HUNTING) == 2) {
						mes "你洗澡了吗？这里有味道。不过我相信你一定被这股气味折磨得够呛。";
						callsub S_Quest,13133,13134,1;
					}
					else {
						cutin "����������ī��",3;  //ragged_zombie_card
						mes "死人会在夜里回来。回来这个说法真奇怪。别废话了。";
						next;
						mes "[Melody-Jack]";
						mes "清除^FF0000破烂僵尸^000000。它们到处出现，很容易。";
						next;
						cutin "",255;
						if (select( "接受委托。", "停止。" ) == 1) {
							mes "[Melody-Jack]";
							mes "洗个^FF0000澡^000000，你就不会再有味道了。";
							callsub S_Quest,13134,13133;
						}
					}
					close;
				case 2:
					if (checkquest(13136,PLAYTIME) == 0)
						mes "我知道无名岛的委托不容易，但你愿意再次参加我会很高兴。";
					else if (checkquest(13135,HUNTING) == 1) {
						cutin "���񽽷���ī��",3;  //zombie_slaughter_card
						mes "对我来说进入无名岛也不容易。我没那么有耐心。";
						next;
						mes "[Melody-Jack]";
						mes "但冒险者应该挑战一次。^FF0000僵尸屠杀者^000000值得清除。";
						cutin "",255;
					}
					else if (checkquest(13135,HUNTING) == 2) {
						mes "你做得很好！你清除了它们。返回需要一些时间。";
						callsub S_Quest,13135,13136,1;
					}
					else {
						cutin "���񽽷���ī��",3;  //zombie_slaughter_card
						mes "它们不像破烂僵尸那样危险，因为它们挥舞着锋利的东西。";
						next;
						mes "[Melody-Jack]";
						mes "请清除^FF0000僵尸屠杀者^000000。小心避开它们的刀刃。";
						next;
						cutin "",255;
						if (select( "接受委托。", "停止。" ) == 1) {
							mes "[Melody-Jack]";
							mes "你还有很多事要处理，我就不多说了。清除它们。";
							callsub S_Quest,13136,13135;
						}
					}
					close;
				case 3:
					if (checkquest(13138,PLAYTIME) == 0)
						mes "女妖已被清除。委托虽然解决了，但事情还没结束。迟早还会再次需要你。";
					else if (checkquest(13137,HUNTING) == 1) {
						cutin "���ī��",3;  //banshee_card
						mes "冒险时有时会遇到不受欢迎的事物，无论是魔物还是同伴。";
						next;
						mes "[Melody-Jack]";
						mes "这份委托对我来说就是这样。我只是不喜欢这些生物，也不喜欢提出委托的理由。";
						cutin "",255;
					}
					else if (checkquest(13137,HUNTING) == 2) {
						mes "你一定累了。你去了超出能力范围的艰难地方。别生气，我会为此奖励你。";
						callsub S_Quest,13137,13138,1;
					}
					else {
						cutin "���ī��",3;  //banshee_card
						mes "请清除无名岛内的^FF0000女妖^000000。别说不，你知道这也是为了艾古。";
						next;
						mes "[Melody-Jack]";
						mes "女妖和艾古都很烦人。我才不会做这份委托，但你不一样，对吧？";
						next;
						cutin "",255;
						if (select( "接受委托。", "停止。" ) == 1) {
							mes "[Melody-Jack]";
							mes "看吧？有人需要这份委托。清除无名岛的^FF0000女妖^000000。";
							callsub S_Quest,13138,13137;
						}
					}
					close;
				}
			case 4:
				mes "深渊湖有一名小女孩发布的委托。她非常勤奋。";
				next;
				if (select( "清除菲鲁斯和贝鲁", "清除金色和蓝色艾西拉" ) == 1) {
					mes "[Melody-Jack]";
					if (checkquest(13140,PLAYTIME) == 0)
						mes "绿色龙和红色龙让我想起西瓜。";
					else if (checkquest(13139,HUNTING) == 1) {
						cutin "�����䷯��ī��",3;  //ferus_card
						mes "深渊湖……你知道怎么进去吗？知道这个情报的你，应该不是普通冒险者吧？";
						next;
						mes "[Melody-Jack]";
						mes "以防万一，我给你一个提示：钥匙和入口就在附近。";
						cutin "",255;
					}
					else if (checkquest(13139,HUNTING) == 2) {
						mes "你清除所有龙了吗？休息一天吧。";
						callsub S_Quest,13139,13140,1;
					}
					else {
						cutin "�׸��䷯��ī��",3;  //ferus__card
						mes "深渊湖内外到处都是龙。龙并不特别，但数量太多了。";
						next;
						mes "[Melody-Jack]";
						mes "菲鲁斯和贝鲁哪个更危险？我不知道。把它们都清除。";
						next;
						cutin "",255;
						if (select( "接受委托。", "停止。" ) == 1) {
							mes "[Melody-Jack]";
							mes "无论绿色还是红色都不算麻烦。但不管怎样，清除全部后再回来。";
							callsub S_Quest,13140,13139;
						}
					}
				}
				else {
					mes "[Melody-Jack]";
					if (checkquest(13142,PLAYTIME) == 0)
						mes "休息一下。我们得再次去制服艾西拉龙。";
					else if (checkquest(13141,HUNTING) == 1) {
						cutin "�����ô���ī��",3;  //acidus__card
						mes "深渊湖并不近，但值得一去。";
						next;
						mes "[Melody-Jack]";
						mes "严格来说这是训练，但你就当是在帮助别人吧。会有奖励。";
						cutin "",255;
					}
					else if (checkquest(13141,HUNTING) == 2) {
						mes "你比我想象中更有天赋。如果找到了战术，下次处理它。这项研究就交给你了。";
						callsub S_Quest,13141,13142,1;
					}
					else {
						cutin "����ô���",3;  //acidus_card
						mes "深渊湖里有一座住着龙的洞窟。龙太多了，而且会飞的家伙很烦。";
						next;
						mes "[Melody-Jack]";
						mes "尽你所能制服它们。别在意颜色，因为它们都要被清除。";
						next;
						cutin "",255;
						if (select( "接受委托。", "停止。" ) == 1) {
							mes "[Melody-Jack]";
							mes "在深渊湖最后一层制服金色和蓝色艾西拉魔物。";
							callsub S_Quest,13142,13141;
						}
					}
				}
				close;

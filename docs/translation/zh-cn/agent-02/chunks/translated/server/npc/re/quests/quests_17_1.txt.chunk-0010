		case 51: .@talk$ = "我不知道……"; break;
		case 52: .@talk$ = "我们突然自我介绍吗？"; break;
		case 53: .@talk$ = "哦，我觉得不是这样。"; break;
		case 54: .@talk$ = "他们是用阳光做那个，对吧？"; break;
		case 55: .@talk$ = "对。我看到了。"; break;
		case 56: .@talk$ = "咦，你做了违法的事吗？"; break;
		case 57: .@talk$ = "所以你认为我们做了非法实验？"; break;
		case 58: .@talk$ = "是你们在做违法的事！"; break;
		case 59: .@talk$ = "我以为你是副总统。"; break;
		case 60: .@talk$ = "他是假冒的吗？"; break;
		case 61: .@talk$ = "你为什么对自己的员工这么说？"; break;
		case 62: .@talk$ = "就像我说的，他看起来像冒牌货。"; break;
		case 63: .@talk$ = "这确实很奇怪，对吧？"; break;
		case 64: .@talk$ = "没错！他身边为什么没有十几个官僚？"; break;
		case 65: .@talk$ = "我不这么认为。"; break;
		case 66: .@talk$ = "确实如此。"; break;
		case 67: .@talk$ = "也许别人看起来更合适？"; break;
		case 68: .@talk$ = "你把我们当傻瓜吗？你打算利用我们？"; break;
		case 69: .@talk$ = "慢慢来。"; break;
		case 70: .@talk$ = "哦，看看那个！总统现在来了～"; break;
		case 71: .@talk$ = "他不是总统，是总统办公室的人。"; break;
		case 72: .@talk$ = "什么？我听到的是真的吗？"; break;
		case 73: .@talk$ = "没错，我也听说了。"; break;
		case 74: .@talk$ = "为什么把我们说成罪犯？我们都是勤劳的人！"; break;
		case 75: .@talk$ = "对！看不到我们勤劳的双手吗？"; break;
		case 76: .@talk$ = "我们还得对付这些罪人！"; break;
		case 77: .@talk$ = "我知道，我也不想待在这里。"; break;
		case 78: .@talk$ = "我们是劳动者！"; break;
		case 79: .@talk$ = "我一整天都在搬东西"; break;
		case 80: .@talk$ = "不觉得太安静了吗？"; break;
		case 81: .@talk$ = "那就回去吧。"; break;
		case 82: .@talk$ = "使用武力，也就是杀了我们吗？"; break;
		case 83: .@talk$ = "我们从一开始就处理得很好！"; break;
		case 84: .@talk$ = "你们听听自己在说什么？"; break;
		case 85: .@talk$ = "喂，别动！"; break;
		case 86: .@talk$ = "嗯，现在事情闹大了。"; break;
		case 87: .@talk$ = "高级研究员来了。"; break;
		case 88: .@talk$ = "我们的研究员一直都是这种性格吗？"; break;
		case 89: .@talk$ = "嗯，我从没和她说过话，你呢？"; break;
		case 90: .@talk$ = "怎么了？"; break;
		case 91: .@talk$ = "哦！！！这都是些什么！"; break;
		case 92: .@talk$ = "请别这样，你不是一个人！"; break;
		case 93: .@talk$ = "啊啊啊！！研究员！！是我们！我们也在这里！"; break;
		case 94: .@talk$ = "埃尔，埃尔尤米娜！等一下！"; break;
		case 95: .@talk$ = "研究员疯了！"; break;
		case 96: .@talk$ = "她疯了！！"; break;
		case 97: .@talk$ = "喂！！你没事吧？！"; break;
		case 98: .@talk$ = "那是什么声音！！"; break;
		case 99: .@talk$ = "啊啊！！"; break;
		case 100: .@talk$ = "不！求你了！！"; break;
		case 101: .@talk$ = "研究员疯了！！！"; break;
		case 102: .@talk$ = "呃，我们也来了！"; break;
		case 103: .@talk$ = "喂，快过来！！"; break;
		case 104: .@talk$ = "饶了我！！"; break;
		case 105: .@talk$ = "干得好！"; break;
		case 106: .@talk$ = "叛乱军，你们做得很好！"; break;
		case 107: .@talk$ = "现在！"; break;
		case 108: .@talk$ = "哦，听到了吗？现在开火！"; break;
		case 109: .@talk$ = "他们走了吗？"; break;
		case 110: .@talk$ = "呃……嗯……"; break;
		case 111: .@talk$ = "喂，你没事吧？"; break;
		case 112: .@talk$ = "啊……啊！！我要……死了！！"; break;
		case 113: .@talk$ = "我觉得不是……"; break;
		case 114: .@talk$ = "我们会帮你！"; break;
	}
	npctalk .@talk$,.@npc$,bc_self;
	return;
}


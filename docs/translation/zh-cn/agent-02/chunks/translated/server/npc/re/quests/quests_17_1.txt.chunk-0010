sp_cor,168,81,7	script	Advance Squad#171_rvs_1	4_F_REBELLION3,{
	if (isbegin_quest(11603) != 2) {
		mes "[Advance Squad]";
		mes "待在这种地方对你来说很危险，即使是有经验的人也一样。下次再来吧。";
		close;
	}
	if (isbegin_quest(11603) == 2 && isbegin_quest(17015) == 0) {
		.@old$ = "Worker#171_rvs_3";
		.@poor$ = "Worker#171_rvs_2";
		.@moc$ = "Worker#171_rvs_4";
		.@cook$ = "Worker#171_rvs_5";
		.@man$ = "Worker#171_rvs_1";
		mes "[Worker]";
		mes "带我出去！";
		171_worker_talk(1,.@old$);
		next;
		cloakoffnpc "Worker#171_rvs_2",getcharid(0);
		cloakoffnpc "Worker#171_rvs_4",getcharid(0);
		mes "[Worker]";
		mes "这些枪手以为可以随便来这里制造骚乱！";
		171_worker_talk(2,.@poor$);
		171_worker_talk(3,.@moc$);
		171_worker_talk(4,.@old$);
		next;
		mes "[Advance Squad]";
		mes "各位，请不要这样。我们不是来伤害你们的。";
		next;
		cloakoffnpc "Worker#171_rvs_5",getcharid(0);
		cloakoffnpc "Worker#171_rvs_1",getcharid(0);
		mes "[Worker]";
		mes "当然不是。我们只是被你们叛乱军攻击了。";
		171_worker_talk(5,.@man$);
		171_worker_talk(6,.@poor$);
		171_worker_talk(7,.@moc$);
		171_worker_talk(8,.@cook$);
		171_worker_talk(9,.@old$);
		next;
		mes "[Advance Squad]";
		mes "情绪激动无法解决问题。";
		next;
		mes "[Worker]";
		mes "你现在是在威胁我们吗？";
		171_worker_talk(10,.@man$);
		next;
		select("里面发生什么了？");
		mes "[Advance Squad]";
		mes "啊！你还活着！冒险者！有人和你一起吗？";
		171_worker_talk(11,.@poor$);
		next;
		select("我是第一个到的……");
		mes "[Advance Squad]";
		mes "我派人去接负责人了。我们是来这里搜索和侦察的先遣队，但你也看到了……";
		next;
		select("这些人是谁？");
		mes "[Worker]";
		mes "这就是这一切的负责人吗？";
		171_worker_talk(12,.@cook$);
		171_worker_talk(13,.@man$);
		171_worker_talk(14,.@old$);
		next;
		mes "[Worker]";
		mes "我觉得不是？那个人看起来很蠢。";
		171_worker_talk(15,.@cook$);
		next;
		mes "[Advance Squad]";
		mes "他们是^0000CD在这里工作的人员^000000。";
		mes "如你所见，我们没有伤害他们……";
		next;
		mes "[Advance Squad]";
		mes "我们真的不知道该怎么办。";
		mes "这里有^0000FF实验室工作人员^000000";
		mes "负责这里的日常杂务，而我们试图进入时，他们阻止了我们。";
		next;
		mes "[Worker]";
		mes "你说什么日常杂务？";
		171_worker_talk(16,.@moc$);
		171_worker_talk(17,.@man$);
		next;
		mes "[Worker]";
		mes "你们为什么评判别人的工作？你们又不是负责人，对吧？";
		171_worker_talk(18,.@old$);
		171_worker_talk(19,.@poor$);
		next;
		mes "[Worker]";
		mes "我觉得你们只是些什么都不懂的无知之人。";
		171_worker_talk(20,.@moc$);
		next;
		mes "[Worker]";
		mes "拜托，他们全都是枪手！";
		171_worker_talk(21,.@old$);
		next;
		mes "[Advance Squad]";
		mes "不是那样！我们想保护平民，让事情恢复正常！";
		next;
		mes "[Worker]";
		mes "如果我们拒绝服从，会发生什么？你们要开枪打我们吗？";
		171_worker_talk(22,.@moc$);
		sleep2 1500;
		171_worker_talk(23,.@poor$);
		next;
		select("为什么你们要挡路？");
		mes "[Worker]";
		mes "为什么不？如果有人闯进你家，你会让他们进来吗？";
		mes "这些人疯了，把这里弄得一团糟。";
		171_worker_talk(24,.@man$);
		next;
		mes "[Worker]";
		mes "看吧！你为什么要插手别人的事？";
		mes "就这样！出去！现在就出去！";
		171_worker_talk(25,.@cook$);
		next;
		mes "[Advance Squad]";
		mes "也许你不知道，但这座^0000FF实验室正在进行非法实验。^000000";
		mes "我们与政府和雷根贝勒合作，前来逮捕负责人。";
		next;
		mes "[Worker]";
		mes "什么？非法实验是什么意思？能告诉我们在哪里进行的吗？";
		171_worker_talk(26,.@poor$);
		next;
		mes "[Advance Squad]";
		mes "我知道很难相信，我自己也很难相信，但这里确实被用来进行非法实验。";
		171_worker_talk(27,.@moc$);
		next;
		select("这座宅邸属于谁？");
		select("我没看到研究员。 ");
		mes "[Advance Squad]";
		mes "也许他们^0000FF逃到宅邸里了。^000000";
		171_worker_talk(28,.@old$);
		171_worker_talk(29,.@moc$);
		171_worker_talk(30,.@cook$);
		next;
		mes "[Advance Squad]";
		mes "这些人看起来是体力劳动者，不是研究员。";
		next;
		mes "[Advance Squad]";
		mes "仓促逃离时留下的人和材料，很可能是被留下的无辜者。";
		next;
		mes "[Worker]";
		mes "你在说我们什么？";
		171_worker_talk(31,.@cook$);
		next;
		mes "[Worker]";
		mes "什么？我们只是可以随手丢掉的垃圾吗？";
		171_worker_talk(32,.@old$);
		next;
		mes "[Worker]";
		mes "有多少研究员像我们一样！";
		mes "没有我们，他们根本无法让这里运转！";
		171_worker_talk(33,.@moc$);
		next;
		mes "[Worker]";
		mes "现在出去！这是雷根贝勒的实验室！你们正在侵入私人财产！";
		171_worker_talk(34,.@man$);
		next;
		mes "[Advance Squad]";
		mes "什么？我们现在该怎么办？不能对手无寸铁的平民使用武力。";
		171_worker_talk(35,.@poor$);
		next;
		select("我绝不会伤害你们。 ");
		mes "[Worker]";
		mes "我们为什么要退让？你们才是入侵者！";
		171_worker_talk(36,.@cook$);
		171_worker_talk(37,.@man$);
		next;
		mes "[Worker]";
		mes "我不想任何人受伤，你们的武器会伤害我们！";
		171_worker_talk(38,.@old$);
		next;
		mes "[Advance Squad]";
		mes "我们要冲进去吗？";
		171_worker_talk(39,.@moc$);
		next;
		cloakoffnpc "Tes#171_rvs_1",getcharid(0);
		cloakoffnpc "Kaya#171_rvs_1",getcharid(0);
		cloakoffnpc "Aas#171_rvs_1",getcharid(0);
		cloakoffnpc "Magenta#171_rvs_1",getcharid(0);
		cloakoffnpc "Denny#171_rvs_1",getcharid(0);
		cloakoffnpc "Tommy#171_rvs_1",getcharid(0);
		cloakoffnpc "Goni#171_rvs_1",getcharid(0);
		cutin "ep16_tes01",2;
		mes "[Tes]";
		mes "你为什么未经命令就要冲进去？";
		171_worker_talk(40,.@poor$);
		171_worker_talk(41,.@cook$);
		next;
		select("副总统！泰丝！");
		cutin "",255;
		mes "[Worker]";
		mes "你为什么一直来？出去！出去！";
		171_worker_talk(42,.@moc$);
		next;
		mes "[Advance Squad]";
		mes "这些员工帮助实验室运转，但他们不相信我说他们一直在进行非法实验。";
		next;
		cutin "ep171_kaya01",2;
		mes "[Kaya]";
		mes "好吧。让我和他们谈谈。";
		next;
		cutin "",255;
		mes "[Worker]";
		mes "你现在又是谁？！";
		171_worker_talk(43,.@old$);
		setquest 17015;
		close;
	}
	if (isbegin_quest(17015) == 1) {
		mes "[Advance Squad]";
		mes "副总统想和他们谈谈。";
		close;
	}
	if (isbegin_quest(17016) == 1) {
		mes "[Advance Squad]";
		mes "快去安全地点！";
		close;
	}
	mes "[Advanced Team]";
	mes "冒险者，这里很危险。前往安全地点。";
	close;

OnInit:
	questinfo(QTYPE_QUEST,QMARK_YELLOW,"isbegin_quest(11603) == 2 && isbegin_quest(17015) == 0");
	end;
}

sp_cor,165,79,1	script	Kaya#171_rvs_1	4_EP17_KAYA,{
	if (isbegin_quest(17015) == 1) {
		.@old$ = "Worker#171_rvs_3";
		.@poor$ = "Worker#171_rvs_2";
		.@moc$ = "Worker#171_rvs_4";
		.@cook$ = "Worker#171_rvs_5";
		.@man$ = "Worker#171_rvs_1";
		cutin "ep171_kaya01",2;
		mes "[Kaya]";
		mes "大家好，我是卡雅·托斯，雷根贝勒的副总统。";
		next;
		cutin "",255;
		mes "[Worker]";
		mes "副总统？副总统？";
		mes "这不是你们的又一个谎言吗？";
		171_worker_talk(44,.@moc$);
		next;
		mes "[Worker]";
		mes "咦？我认识他！他确实是副总统卡雅。";
		mes "我在总部时见过他几次。";
		171_worker_talk(45,.@old$);
		next;
		mes "[Worker]";
		mes "哦，真的吗？我以前从没见过你的脸，所以不知道。";
		171_worker_talk(46,.@cook$);
		171_worker_talk(47,.@poor$);
		next;
		mes "[Worker]";
		mes "副总统为什么在这里？";
		171_worker_talk(48,.@man$);
		next;
		cutin "ep171_kaya01",2;
		mes "[Kaya]";
		mes "你们都是被雷根贝勒研究所雇来建造和维护这座新实验室的吗？";
		next;
		cutin "",255;
		mes "[Worker]";
		mes "没错。";
		171_worker_talk(49,.@old$);
		next;
		mes "[Worker]";
		mes "是的，我是雷根贝勒雇来的。";
		171_worker_talk(50,.@cook$);
		next;
		cutin "ep171_kaya01",2;
		mes "[Kaya]";
		mes "这里穿蓝衣服的人负责什么？";
		next;
		cutin "",255;
		mes "[Worker]";
		mes "我？嗯……我负责给这里工作的人制作和运送食物。";
		171_worker_talk(51,.@cook$);
		next;
		cutin "ep171_kaya01",2;
		mes "[Kaya]";
		mes "那你旁边的人呢？";
		next;
		mes "[Worker]";
		mes "我搬运废料和实验室设备。";
		171_worker_talk(52,.@poor$);
		next;
		cutin "ep171_kaya01",2;
		mes "[Kaya]";
		mes "如果你知道这里研究什么，请举手。";
		next;
		cutin "",255;
		mes "[Worker]";
		mes "嗯……可再生能源？";
		171_worker_talk(53,.@poor$);
		next;
		mes "[Worker]";
		mes "哦，我知道！不是农业研究吗？";
		171_worker_talk(54,.@moc$);
		next;
		mes "[Worker]";
		mes "看起来像是牲畜研究。";
		mes "有时会有奇怪的野兽经过。";
		171_worker_talk(55,.@man$);
		next;
		cutin "ep171_kaya01",2;
		mes "[Kaya]";
		mes "你们只做自己的工作，并不知道这里真正的用途。事实上，我很庆幸如此。";
		next;
		mes "[Kaya]";
		mes "这座设施正在进行政府和雷根贝勒严令禁止的非法实验。";
		next;
		cutin "",255;
		mes "[Worker]";
		mes "你是说我们的研究员……？不可能。";
		171_worker_talk(56,.@poor$);
		next;
		mes "[Worker]";
		mes "那些人在进行违法实验？";
		171_worker_talk(57,.@moc$);
		next;
		mes "[Worker]";
		mes "什么非法实验？";
		171_worker_talk(58,.@cook$);
		next;
		cutin "ep171_kaya01",2;
		mes "[Kaya]";
		mes "具体情况我还不知道。";
		next;
		cutin "",255;
		mes "[Worker]";
		mes "你不能再告诉我们一些他们做的事吗？";
		171_worker_talk(59,.@old$);
		171_worker_talk(60,.@man$);
		next;
		mes "[Worker]";
		mes "你们应该是好人，那为什么把我们叫作坏人？";
		171_worker_talk(61,.@cook$);
		next;
		mes "[Worker]";
		mes "没错！这意味着这些人做了坏事？雷根贝勒的高层要进来拿走我们科学家的研究成果吗？";
		171_worker_talk(62,.@man$);
		next;
		mes "[Worker]";
		mes "对吧？否则副总统带来的就该是守卫，而不是叛乱军。";
		171_worker_talk(63,.@moc$);
		next;
		mes "[Worker]";
		mes "他们真的是企业的人吗？副总统为什么不带行动人员来？";
		171_worker_talk(64,.@poor$);
		next;
		mes "[Worker]";
		mes "你是一个人行动吗？";
		171_worker_talk(65,.@old$);
		next;
		mes "[Worker]";
		mes "不过他确实很像副总统。";
		171_worker_talk(66,.@cook$);
		171_worker_talk(67,.@man$);
		next;
		cutin "ep171_as01",0;
		mes "[Aas]";
		mes "这是个大问题。他们完全不相信我们。";
		next;
		cutin "",255;
		mes "[Advance Squad]";
		mes "我的意思是，你觉得研究员这些年来是如何给他们洗脑的？";
		171_worker_talk(68,.@cook$);
		next;
		cutin "ep16_tes01",2;
		mes "[Tes]";
		mes "我来和他们谈谈，让我试试。";
		171_worker_talk(69,.@old$);
		next;
		mes "[Tes]";
		mes "大家好。我叫泰丝，来自施瓦茨瓦德总统办公室。";
		171_worker_talk(70,.@poor$);

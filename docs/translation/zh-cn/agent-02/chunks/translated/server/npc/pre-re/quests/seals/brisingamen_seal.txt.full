//===== rAthena Script ======================================= 
//= God Item Quest - Brisingamen Seal
//===== Description: ========================================= 
//= [Official Conversion]
//= Quest for breaking the seal of Brisingamen.
//===== Changelogs: ==========================================
//= 1.0 Renewal script update for ep16.1 [Capuche]
//============================================================

prt_castle,80,52,0	script	Personnel Record#book1	HIDDEN_NPC,{
	if ($God2 < $@god_check1) {
		mes "[Librarian]";
		mes "你在做什么？";
		mes "别碰任何东西！";
		close;
	}
	if ($God3 >= $@god_check2) {
		mes "[Librarian]";
		mes "你在做什么？";
		mes "别碰任何东西！";
		close;
	}
	if (god_brising == 26) {
		mes "[" + strcharinfo(0) + "]";
		mes "我应该从";
		mes "上次读到的地方";
		mes "继续读……";
		next;
		mes "["+ strcharinfo(0) +"]";
		mes "嗯……？";
		mes "底部这里的";
		mes "标记是什么？";
		mes "某种秘密吗？";
		next;
		mes "["+ strcharinfo(0) +"]";
		mes "难怪图书管理员";
		mes "在开口前显得犹豫。嗯。";
		mes "现在让我看看……";
		mes "";
		next;
		set .@bookrand,rand(1,3);
		if (.@bookrand == 1) {
			mes "[Personnel Record]";
			mes "^663300第二小队的 Lowen 在事件发生 3 天后回到了部队。随后举行了审判，她被判定犯有接到战斗命令却逃跑的罪行。^000000";
			next;
			mes "[Personnel Record]";
			mes "^663300尽管罪行严重，她只是被逐出十字军，获赐的神圣力量也被强行剥夺……^000000";
			next;
			mes "[" + strcharinfo(0) + "]";
			mes "她被迫离开十字军？！太荒谬了！";
			next;
			mes "["+ strcharinfo(0) +"]";
			mes "他们难道想判她死刑吗？这未免太残酷了。她一定受尽屈辱……";
			next;
			mes "[Personnel Record]";
			mes "^663300事件发生 2 年后，一支探险队发现了生锈的铠甲碎片、一把断剑";
			mes "以及属于";
			mes "Lowen Ellenen 的一些遗物。^000000";
			next;
			mes "[Personnel Record]";
			mes "^663300然而，这项信息";
			mes "属于高度机密。官方说法是 Lowen Ellenen 在任务中死亡。^000000";
			next;
			mes "[" + strcharinfo(0) + "]";
			mes "他们认为她给十字军";
			mes "带来了耻辱？";
			mes "听起来真是一团乱。";
			mes "我该再去见她吗？";
			next;
			mes "[Librarian]";
			mes "^666666*Yawn...*^000000";
			mes "什么……？";
			mes "你是谁！";
			mes "赶紧";
			mes "滚出去！";
			set god_brising,30;
			close2;
			warp "prt_castle",94,37;
			end;
		}
		else {
			mes "[Librarian]";
			mes "^666666*Yawn...*^000000";
			mes "什么……？";
			mes "你是谁！";
			mes "赶紧";
			mes "滚出去！";
			close2;
			warp "prt_castle",94,37;
			end;
		}
	}
	else if (god_brising == 25) {
		mes "^3355FF图书管理员打瞌睡时，你从书架上取下了书。根据十字军人事记录，只有一名新兵名叫洛文·埃伦南。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "Lowen Ellenen……";
		mes "第二小队成员……";
		mes "22 岁……";
		mes "女性……";
		mes "";
		next;
		mes "["+ strcharinfo(0) +"]";
		mes "变成了逃犯？";
		mes "这和图书管理员告诉我的";
		mes "信息";
		mes "不一样！";
		next;
		set .@bookrand,rand(1,3);
		if (.@bookrand == 1) {
			mes "[" + strcharinfo(0) + "]";
			mes "我应该从";
			mes "上次读到的地方";
			mes "继续读……";
			next;
			mes "[" + strcharinfo(0) + "]";
			mes "嗯……？";
			mes "底部这里的";
			mes "标记是什么？";
			mes "某种秘密吗？";
			next;
			mes "[" + strcharinfo(0) + "]";
			mes "难怪图书管理员";
			mes "在开口前显得犹豫。嗯。";
			mes "现在让我看看……";
			mes "";
			next;
			mes "[Personnel Record]";
		mes "^663300第二小队的洛文在事件发生三天后回到部队。经过审判，她被判定在接到战斗命令时逃跑，有罪。^000000";
			next;
			mes "[Personnel Record]";
		mes "^663300尽管罪行严重，她只是被十字军开除，授予她的神圣力量也被强行剥夺……^000000";
			next;
			mes "[" + strcharinfo(0) + "]";
			mes "她被迫离开十字军？！太荒谬了！";
			next;
			mes "[" + strcharinfo(0) + "]";
			mes "他们难道想判她死刑吗？这未免太残酷了。她一定受尽屈辱……";
			next;
			mes "[Personnel Record]";
			mes "^663300事件发生 2 年后，一支探险队发现了生锈的铠甲碎片、一把断剑";
			mes "以及属于";
			mes "Lowen Ellenen 的一些遗物。^000000";
			next;
			mes "[Personnel Record]";
			mes "^663300然而，这项信息";
			mes "属于高度机密。官方说法是 Lowen Ellenen 在任务中死亡。^000000";
			next;
			mes "[" + strcharinfo(0) + "]";
			mes "他们认为她给十字军";
			mes "带来了耻辱？";
			mes "听起来真是一团乱。";
			mes "我该再去见她吗？";
			next;
			mes "[Librarian]";
			mes "^666666*Yawn...*^000000";
			mes "什么……？";
			mes "你是谁！";
			mes "赶紧";
			mes "滚出去！";
			set god_brising,30;
			close2;
			warp "prt_castle",94,37;
			end;
		}
		else {
			mes "[Librarian]";
			mes "^666666*Yawn...*^000000";
			mes "什么……？";
			mes "你是谁！";
			mes "赶紧";
			mes "滚出去！";
			set god_brising,26;
			next;
			mes "["+ strcharinfo(0) +"]";
			mes "(Nuts...!";
			mes "我没能";
			mes "读完！）";
			close2;
			warp "prt_castle",94,37;
			end;
		}
	}
	else  {
		mes "[Librarian]";
		mes "你在这里做什么？";
		mes "别碰任何东西！";
		close;
	}
}

//-----------librarian----------------------------------------------------------
prt_castle,84,51,5	duplicate(Librarian#2_)	Librarian#2	8W_SOLDIER

			mes "[Hatbyr Mhore]";
			mes "有了这些材料后随时回来。";
			mes "我制作的饰品能赋予你天使的优雅或恶魔的魅力。";
			close;
		}
		mes "[Hatbyr Mhore]";
		mes "没问题。";
		mes "我总是在这个风景优美的地方欣赏景色。想来时随时回来。";
		close;
	}
}


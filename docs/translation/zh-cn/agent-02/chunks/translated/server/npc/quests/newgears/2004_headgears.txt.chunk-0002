		mes "把这个放在地上……";
		mes "好了，我准备好了……";
		next;
		mes "^FF0000林赛把狸猫帽放在地上，将溜溜猴叶子扔到帽子上，抱着自己喃喃念咒。^000000";
		next;
		mes "^FF0000突然，一道耀眼的光芒闪过，狸猫帽变成蓝色，慢慢变成海獭帽。^000000";
		specialeffect EF_FLASHER;
		next;
		mes "[Pretty Lindsay]";
		mes "呼！完成了！";

		mes "^FF0000如果你带来的物品有精炼等级或插卡，制作新物品后卡片和精炼效果都会消失。请不要忘记！^000000";
		next;
		mes "[Nephia]";
		mes "哦，快点快点！我等不及要为你的头发添上饰品了！";
		close;
	}
}

// Indian Headband

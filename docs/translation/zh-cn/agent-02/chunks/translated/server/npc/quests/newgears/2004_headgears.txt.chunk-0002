		mes "- 太多物品。-";
		mes "- 请先把一些物品 -";
		mes "- 存进卡普拉仓库后再试。-";
		close;
	}
	mes "[Skillful Looking Artisan]";
	mes "啊哈~";
	mes "你一定很喜欢旅行！你肯定不是这里的人。";
	next;
	mes "[Skillful Looking Artisan]";
	mes "请允许我自我介绍。我叫哈特比尔·莫尔，是一名旅行铁匠。";
	next;
	if (countitem(2254) > 0 && countitem(2286) > 0) {
		mes "[Hatbyr Mhore]";
		mes "哦？看来你带着一些贵重物品。";
		next;
		mes "[Hatbyr Mhore]";
		mes "嗯，如果你愿意，我可以用你带的 ^4d4dff天使之翼^000000 和 ^4d4dff精灵耳朵^000000 制作真正惊人的东西。";
		next;
		mes "[Hatbyr Mhore]";
		mes "听起来怎么样？";
		mes "哦，不用担心我的技艺！我的才能和化废为宝的本领在铁匠中很有名。";
		next;
		switch(select("嗯，让我想想。:好，那就帮我做吧。:能用恶魔之翼制作吗？")) {
		case 1:
			mes "[Hatbyr Mhore]";
			mes "嗯？有什么好想的？！我正要用全部技艺为你制作特别的东西。好吧……";
			close;
		case 2:
			mes "[Hatbyr Mhore]";
			mes "啊哈~ 好好好。";
			mes "让我看看，让我看看……";
			mes "1 个天使之翼";
			mes "1 个精灵耳朵……";
			next;
			mes "[Hatbyr Mhore]";
			mes "一些其他杂物以及";
			mes "……20,000 Zeny。";
			mes "制作这么棒的物品，这个价格非常便宜。但开始前我得告诉你……";
			next;
			mes "[Hatbyr Mhore]";
			mes "不管你带来的物品精炼过多少次，请^4d4dff只携带制作此物品所需的物品。^000000 我不能因为你的失误毁掉我的作品。";
			next;
			if (select("我准备好了。:好，我先去存放其他物品。") == 1) {
				if (MaxWeight - Weight < 2000) {
					mes "[Hatbyr Mhore]";
					mes "哎哟……！";
					mes "你为什么带这么多物品？把多余行李存到别处再回来。";
					close;
				}
				else {
					if (countitem(2254) > 0 && countitem(2286) > 0 && Zeny > 19999) {
						mes "[Hatbyr Mhore]";
						mes "好了……";
						mes "让我们进入状态！";
						specialeffect EF_REPAIRWEAPON;
						next;
						mes "[Hatbyr Mhore]";
						mes "给你，朋友。";
						mes "我自豪地说这是我的杰作。请收下，我称它为……";
						mes "‘天使之翼耳饰！’";
						delitem 2254,1; //Angelic_Chain
						delitem 2286,1; //Elven_Ears
						set Zeny, Zeny-20000;
						getitem 5074,1; //Ear_Of_Angel's_Wing
						next;
						mes "[Hatbyr Mhore]";
						mes "戴上这件时尚饰品，你一定会成为街头话题。";

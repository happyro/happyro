comodo,237,217,5	script	Meruntei#1	732,{
	if (checkweight(1201,1) == 0) {
		mes "- 等一下！ -";
		mes "- 你现在携带了 -";
		mes "- 太多物品。-";
		mes "- 请先把一些物品 -";
		mes "- 存进卡普拉仓库后再试。-";
		close;
	}
	if (countitem(5010) > 0 && countitem(5049) > 0 && countitem(7101) > 9 && Zeny > 9999) {
		mes "[Meruntei]";
		mes "哦！你全都带来了！现在我就为你制作专属的印度头巾。";
		next;
		mes "[Meruntei]";
		mes "拿着！你带来的物品将帮助我继续在米德加尔特推广头巾。";
		delitem 5010,1; //Indian_Hair_Piece
		delitem 5049,1; //Stripe_Band
		delitem 7101,10; //Peco_Wing_Feather
		set Zeny, Zeny-10000;
		getitem 5071,1; //Indian_Headband
		next;
		mes "[Meruntei]";
		mes "咿呀呀呀呀呀呀呀~~！";
		close;
	}
	mes "[Meruntei]";
	mes "咿呀呀呀呀呀呀呀~~！";
	mes " ";
	mes "印度精神，永存~！";
	mes "我代表可莫多印第安人，向所有印第安部落致敬！";
	next;
	mes "[Meruntei]";
	mes "你想要一条印度头巾吗？你不会因此成为部落正式成员，但冒险中遇到部落居民时，佩戴它能表达你的尊重。";
	next;
	mes "[Meruntei]";
	mes "你只需要带来……";
	mes "1 个 ^FF0000印度发片^000000、";
	mes "1 个 ^FF0000条纹发带^000000、";
	mes "10 根 ^FF0000波波利羽毛^000000";
	mes "以及 ^FF000010,000 Zeny！";
	next;
	mes "[Meruntei]";
	mes "我会使用你给我的物品，继续推广印度头巾，并向米德加尔特的部落致敬。";
	next;
	mes "[Meruntei]";
	mes "^FF0000请注意，如果你带来的物品插了卡或经过精炼，使用后物品的附加能力会消失。请牢记这一点。^000000";
	next;
	mes "[Meruntei]";
	mes "咿呀呀呀呀呀呀呀~~！";
	close;
}

// Mushroom Band
//============================================================
geffen,67,87,3	script	Ipore#1	700,{
	if (checkweight(1201,1) == 0) {
		mes "- 等一下！ -";
		mes "- 你现在携带了 -";
		mes "- 太多物品。-";
		mes "- 请先把一些物品 -";
		mes "- 存进卡普拉仓库后再试。-";
		close;
	}
	if (countitem(921) > 299) {
		mes "[Ipore]";
		mes "哇！这些 300 个蘑菇孢子真的是你独自收集的吗？不错！现在该施展我的魔法了~";
		next;
		mes "^3355FF*撒呀撒呀*";
		mes "伊波尔把蘑菇孢子倒在你的头上。^000000";
		next;
		mes "[Ipore]";
		mes "魔法变变变！";
		next;
		mes "[Ipore]";
		mes ".......................";
		mes "呼！成功了！你的头上长出了一朵蘑菇！";
		next;
		mes "[Ipore]";
		mes "但是……";
		mes "我不喜欢它倾斜的方向。它本该朝^FF3333另一边^000000生长。";
		next;
		mes "[Ipore]";
		mes "我想……";
		mes "我们应该把那朵蘑菇做成头带，这样你就能调整成自己的风格。";
		next;
		mes "[Ipore]";
		mes "我知道，我知道……";
		mes "虽然不如把蘑菇直接长在头骨上酷，但我们只能这样了。抱歉让你失望。";
		next;
		mes "[Ipore]";
		mes "……好了。";
		mes "完成了。你还好吗？幸好我想我没有剥掉你的头皮。";
		next;
		mes "[Ipore]";
		mes "总之，现在你可以以帅气的角度佩戴这朵蘑菇，这才是正确的戴法。保持酷劲，你这个时尚叛逆者。";
		delitem 921,300; //Mushroom_Spore
		getitem 5082,1; //Mushroom_Band
		close;
	}
	mes "[Ipore]";
	mes "终于……";
	mes "我创造了让蘑菇在任何地方生长的魔法！只要你想得到的地方，我都能让蘑菇在那里长出来。";
	next;
	mes "[Ipore]";
	mes "甚至……";
	mes "在人类头顶……";
	next;
	mes "[Ipore]";
	mes "有人可能觉得这很怪诞，但你不觉得从头上长出蘑菇会掀起艺术革命吗？";
	next;
	mes "[Ipore]";
	mes "想想看！这是魔法与艺术、时尚与生命的完美融合……";
	mes "人类与蘑菇？";
	mes "啊……我看出你被勾起好奇心了。";
	next;
	mes "[Ipore]";
	mes "那么……";
	mes "要施展这个魔法，我需要 ^FF0000300 个蘑菇孢子^000000 的魔力。带齐蘑菇孢子，就能亲眼见识我的魔法！";
	next;
	mes "[Ipore]";
	mes "好了，你要明白我必须让蘑菇从你的头上长出来。换作其他地方，你可能会怀疑这是某种魔术或幻觉。";
	next;
	mes "[Ipore]";
	mes "而且，没有什么比头上长蘑菇更能表达‘无因叛逆’了！你会看起来超酷、独立又反主流！";
	next;
	mes "[Ipore]";
	mes "记住，带给我……";
	mes "^FF0000300 个蘑菇孢子^000000，";
	mes "这样你就能亲身体验我惊人的魔法~！";
	close;
}


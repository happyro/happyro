	mes "[Karian]";
	mes "宴会真有趣！";
	mes "美食！美妙的音乐！人们互相交谈！";
	cutin "3rd_mins_song04",2;
	close3;
}

prt_cas,85,223,1	script	Maximilian Roegenburg#ep16wig01	4_EP16_MAX,{
	mes "[Maximilian]";
	mes "我听说最近我的孙子承蒙你儿子的照顾。";
	next;
	mes "[Levuiere]";
	mes "哪里的话。我的儿子应该向你聪明的孙子学习。哈哈。";
	next;
	mes "[Catherine]";
	mes "请多关照我们的儿子艾萨克。";
	close;
}

prt_cas,85,225,4	script	Catherine Wigner#ep16wig01	1_F_LIBRARYGIRL,{
	mes "[Catherine]";
	mes "自从上次来到宫殿后，很多事情都变了。我想更常来这里，但找不到前来的借口……";
	next;
	mes "[Levuiere]";
	mes "有邀请就可以来。来这里并不难。";
	next;
	mes "[Catherine]";
	mes "你知道我不是这个意思……";
	close;
}

prt_cas,84,225,4	script	Levuiere Wigner#ep16wig01	4_EP16_LOUVIERE,{
	mes "[Levuiere]";
	mes "亲爱的罗根贝格，你的孩子们最近怎么样？我经常从艾萨克那里听到你三孙子的事。";
	next;
	mes "[Maximilian]";
	mes "哦，他们都很好。有时间请来我们家做客。";
	close;
}

prt_cas,76,236,3	script	Bagette Teeblack#ep16_1	4_M_ALCHE_D,{
	mes "[Bagette Teeblack]";
	mes "我还有很多研究要做……被拖来参加这种宴会真让我难受。";
	next;
	mes "[Bagette Teeblack]";
	mes "不知道西奥多一个人能不能处理好工作。";
	close;
}

prt_cas,105,221,1	script	Isabella#ep16wig	4_F_01,{
	mes "[Isabella]";
	mes "我真的很喜欢宴会，尤其是宫殿举办的宴会！一切都如此华丽耀眼！";
	close;
}

prt_cas,105,224,4	script	Beatrice#ep16wig	4_F_02,{
	mes "[Beatrice]";
	mes "在这样的宴会上，我们女人会观察其他女人。谁穿什么裙子、戴什么首饰……";
	next;
	mes "[Beatrice]";
	mes "那些评判的目光像猛兽一样锐利。如果发现哪位女士打扮得出色，我们就会单纯地欣赏她的美貌。";
	close;
}

prt_cas,107,225,5	script	Isaac Wigner#ep16wig01	4_EP16_ISAAC,{
	mes "[Isaac]";
	mes "哈哈哈哈哈！";
	mes "我真该看看那张脸！下次请邀请我参加那种活动。";
	next;
	mes "[Isabella]";
	mes "哦，你总是这么忙，艾萨克。像这样的宴会是我唯一能见到你的机会。";
	next;
	mes "[Beitrice]";
	mes "没错！艾萨克，你现在一定是普隆德拉最忙的前三名。";
	next;
	mes "[Sophia]";
	mes "他每天和艾萨克讨论生意后也很晚回家。我真的不喜欢这样。";
	next;
	mes "[Bryan]";
	mes "别这么说！";
	next;
	mes "[Isaac]";
	mes "哦！很抱歉一直让布莱恩陪着我。请原谅。";
	next;
	mes "[Isaac]";
	mes "不过请理解，现在是我们生意最重要的时期。等这段时间过去，我会让他专心陪你，亲爱的索菲娅。";
	next;
	mes "[Sophia]";
	mes "哦，你可要说到做到！";
	next;
	mes "[Isaac]";
	mes "我保证。我以艾萨克·维格纳之名发誓。";
	next;
	mes "[Isabella]";
	mes "哈哈，既然你以家族之名向我保证，我想我可以相信你，艾萨克。";
	close;
}

prt_cas,108,223,3	script	Bryan#ep16wig	4_M_CASMAN1,{
	mes "[Bryan]";
	mes "今天别留下我一个人。你不在我身边我会紧张。";
	next;
	mes "[Sophia]";
	mes "亲爱的，我想和那些很久没见的人叙叙旧。你可以去和其他人聊天。";
	next;
	mes "[Bryan]";
	mes "他们只谈生意。我一点也不喜欢。我不想来到这里还感觉像在工作。";
	next;
	mes "[Sophia]";
	mes "那么你就跟着我吧。";
	next;
	mes "[Bryan]";
	mes "嗯……我不太自在……周围女士太多了……";
	close;
}

prt_cas,107,222,1	script	Sophia#ep16wig	1_F_LIBRARYGIRL,{
	mes "[Sophia]";
	mes "哦，亲爱的，隔了这么久能来到宫殿我真开心。这里有这么多熟悉的面孔。";
	mes "不过……";
	next;
	mes "[Sophia]";
	mes "其他人看起来都很漂亮，反而显得我穿得太朴素。";
	next;
	mes "[Bryan]";
	mes "不是这样的！你是这里最美的人。我在这里眼里只有你。";
	next;
	mes "[Sophia]";
	mes "哦，我真不好意思……";
	close;
}

// Library
prt_cas,343,67,4	script	Uptight Librarian#ep16lug0	1_F_LIBRARYGIRL,{
	if (checkweight(1304,3) == 0) {
		mes "[Uptight Librarian]";
		mes "如果你要借书，最好先减少行李。看起来没有放书的空间了。";
		close;
	}
	.@name$ = strcharinfo(0);
	if (ep16_lug == 5) {
		if (countitem(6926) > 0) {
			mes "[Uptight Librarian]";
			mes "你读完那本书了吗？你是来还书的吗？嗯，看你的双手空空，似乎还没读完。";
			next;
			mes "[Uptight Librarian]";
			mes "慢慢看看吧。取出任何你喜欢的书来读。";
			mes "书籍总能丰富心灵。";
			close;
		}
		mes "[" + .@name$ + "]";
		mes "你好，我在找一本书。能告诉我它在哪里吗？";
		next;
		mes "[Uptight Librarian]";
		mes "你在找什么书？";
		next;
		mes "[" + .@name$ + "]";
		mes "一本关于卢恩·米德加尔兹历史的书。";
		next;
		mes "[Uptight Librarian]";
		mes "嗯……卢恩·米德加尔兹的历史。";
		mes "你要借这本书吗？";
		next;
		mes "[" + .@name$ + "]";
		mes "是的。";
		next;
		mes "[Uptight Librarian]";
		mes "请出示你的借书证。";
		next;
		emotion ET_HUK, playerattached();
		mes "[" + .@name$ + "]";
		mes "借书证？我没有那种东西。";
		next;
		mes "[Uptight Librarian]";
		mes "那么我不能把书借给你。";
		next;
		emotion ET_SWEAT, playerattached();
		mes "[" + .@name$ + "]";
		mes "怎样才能办理借书证？";
		next;
		mes "[Uptight Librarian]";
		mes "出示身份证明，我们马上就能为你办理。";
		next;
		emotion ET_SWEAT, playerattached();
		mes "[" + .@name$ + "]";
		mes "啊……我没有。我来参加宴会时把所有东西都留下了。";
		next;
		mes "[Uptight Librarian]";
		mes "宴会？你是说宫殿举办的宴会？你就是受邀参加宴会的冒险者吗？";
		next;
		mes "[" + .@name$ + "]";
		mes "是的……";
		next;
		mes "[Uptight Librarian]";
		mes "那么你是王国认可的人，我可以通过简单流程把书借给你。";
		next;
		mes "[Uptight Librarian]";
		mes "王国已经传达了你的资料，并要求为你提供最大便利。";
		next;
		mes "[" + .@name$ + "]";
		mes "这倒不错，但我觉得隐私没有得到保护。";
		next;
		mes "[Uptight Librarian]";
		mes "先生，你叫什么名字？";
		next;
		mes "[" + .@name$ + "]";
		mes "" + .@name$ + ".";
		next;
		mes "[Uptight Librarian]";
		mes "让我看看……";
		mes "是的，在这里。" + .@name$ + "先生……";
		emotion ET_SURPRISE;
		next;
		mes "[Uptight Librarian]";
		mes "不过这本书共有12卷。这里只有第一卷，其他的已经借出。";
		mes "你可以接受吗？";
		next;
		mes "[" + .@name$ + "]";
		mes "可以。";
		next;
		mes "[Uptight Librarian]";
		mes "嗯。对了，我能问你几个问题吗？我整天待在图书馆，对外面的事一无所知。";
		next;
		mes "[" + .@name$ + "]";
		mes "可以，只要是我知道的，我都会告诉你。";
		next;
		mes "[Uptight Librarian]";
		mes "宫殿里举办的^0000cd是什么宴会^000000？为什么邀请你和王室家族成员？";
		next;
		while( select( "王子诞生。", "国王生日。", "纪念击败梦罗克。" ) != 3 ) {
			mes "[" + .@name$ + "]";
			mes "对不起，我刚才想着别的事，说错了。";
			mes "我弄错了。你刚才说什么？";
			next;
			mes "[Uptight Librarian]";
			mes "宫殿里举办的^0000cd是什么宴会^000000？为什么邀请你和王室家族成员？";
			next;
		}
		mes "[Uptight Librarian]";
		mes "啊，我明白了。";
		next;
		mes "[Uptight Librarian]";
		mes "^0000cd所有王室家族^000000都参加宴会了吗？";
		next;
		while( select( "8个王室家族参加了。", "7个王室家族参加了。", "6个王室家族参加了。" ) != 2 ) {
			mes "[" + .@name$ + "]";
		mes "对不起，我刚才想着别的事，说错了。";
		mes "我弄错了。你刚才说什么？";
			next;
			mes "[Uptight Librarian]";
			mes "^0000cd所有王室家族^000000都参加宴会了吗？";
			next;
		}
		mes "[Uptight Librarian]";
		mes "宫殿一定很拥挤。所有王室家族像这样聚集非常罕见，不过……";
		next;
		mes "[Uptight Librarian]";
		mes "我听说有王室家族^0000cd不参加王室会议^000000。是哪两个？";
		next;
		while( select( "维格纳和海涅。", "罗根贝格和理查德。", "乔伯格和瓦尔特。" ) != 3 ) {
			mes "[" + .@name$ + "]";
			mes "对不起，我刚才想着别的事，说错了。";
			mes "我弄错了。你刚才说什么？";
			next;
			mes "[Uptight Librarian]";
			mes "我听说有王室家族^0000cd不参加王室会议^000000。是哪两个？";
			next;
		}
		mes "[Uptight Librarian]";
		mes "嗯，乔伯格和瓦尔特不参加会议也是可以理解的。";
		next;
		mes "[Uptight Librarian]";
		mes "前任国王的家族^0000cd因为古老的诅咒而变成这样^000000……";
		next;
		while( select( "你是说尼鲁斯？", "你是说乔伯格？", "你是说理查德？" ) != 2 ) {
			mes "[" + .@name$ + "]";
			mes "对不起，我刚才想着别的事，说错了。";
			mes "我弄错了。你刚才说什么？";
			next;
			mes "[Uptight Librarian]";
			mes "前任国王的家族^0000cd因为古老的诅咒而变成这样^000000……";
			next;
		}
		mes "[Uptight Librarian]";
		mes "是的，你说得对。是^0000cd乔伯格^000000。王后一定很孤独。";
		mes "谢谢你百忙之中给我建议。";
		next;
		mes "[Uptight Librarian]";
		mes "最近因为宴会没人来图书馆，我一直很孤单。";
		mes "卢恩·米德加尔兹的历史。";
		next;
		mes "[Uptight Librarian]";
		mes "你可以借一周。逾期还书本来要收费，但我接到指示可以免除你的费用。";
		next;
		mes "[Uptight Librarian]";
		mes "嗯，如果你重视荣誉，就不会逾期。";
		next;
		mes "[Uptight Librarian]";
		mes "那么，好好享受这本书吧！";
		if (isbegin_quest(14500) == 0) {
			setquest 14500;// Complete checking out the book
			completequest 14500;// Complete checking out the book
		}
		getitem 6926,1;// Midgards_Histories
		close;
	}
	mes "[Uptight Librarian]";
	mes "慢慢看看吧。取出任何你喜欢的书来读。";
	mes "书籍总能丰富心灵。";
	close;
}

prt_cas,321,25,1	script	Erich Nerius#ep16_erihi	4_M_SITDOWN,{
	if (ep16_royal < 2) {
		mes "[Erich]";
		mes "有这么多客人参加宴会。";
		mes "不过这里是图书馆，请保持安静。";
		close;
	}
	if (ep16_royal == 2) {// buggy officially (never displayed)
		if (isbegin_quest(7684) == 0) {
			mes "[Erich]";
			mes "你是在参加宴会并与各家族互相问候吗？";
			mes "那么你应该去见斯皮卡·尼鲁斯，而不是我。";
			next;
			mes "[Erich]";
			mes "虽然现任家主谢达尔不在这里，但斯皮卡掌握着所有实际权力。";
			next;
			mes "[Erich]";
			mes "我只是作为尼鲁斯家族成员代替家主参加王室会议。";
			next;
			mes "[Erich]";
			mes "我对王位完全不感兴趣。";
			mes "所以你应该去见斯皮卡。";
			next;
			mes "[Erich]";
			mes "你也好好享受宴会吧。";
			close;
		}
		mes "[Erich]";
		mes "你见过斯皮卡了吗？";
		mes "她是个很开朗的女孩，对吧？";
		next;
		mes "[Erich]";
		mes "她会成为尼鲁斯家族的家主。";
		close;
	}
	mes "[Erich]";
	mes "虽然我是被迫收养的，但一直被当作王子对待。不过家主谢达尔一直对我很好。";
	next;
	mes "[Erich]";
	mes "她告诉我想做什么就做什么。";
	mes "……她甚至让我自己决定是否参加仪式，";
	next;
	mes "[Erich]";
	mes "我想无论做什么都会被原谅。";
	mes "我似乎同时获得了自由和放任。";
	next;
	mes "[Erich]";
	mes "不过我喜欢现在这样。";
	mes "我可以做任何想做的事。";
	close;
}
prt_cas,373,57,8	script	Oliver#ep16_1	4_M_OLIVER,{
	mes "[Oliver]";
	mes "哦！这个！那个！这个！";
	mes "找到了！";
	npctalk "哦，宫殿！", "Oliver#ep16_1", bc_self;
	cutin "bu_oliver4",0;
	next;
	mes "[Oliver]";
	mes "哦，我的收藏里没有这本书！";
	next;
	mes "[Oliver]";
	mes "在宫殿里真棒！这里什么都有！";
	close3;
}
prt_cas,341,79,2	script	Alf Ocat#ep16_1	4_M_BLACKMAN,{
	mes "[Alf]";
	mes "哦！这本书一定就是传说中的那本……";
	cutin "bu_alp4",2;
	npctalk "哦！太不可思议了！", "Alf Ocat#ep16_1", bc_self;
	next;
	mes "[Alf]";
	mes "我本来对参加王室宴会没兴趣……";
	mes "不过能来这里我很高兴！";
	close3;
}

// prt_cas,364,69,3	script	Nervous Man#ep16lug01	4_M_ALCHE_A,5,5,{
prt_cas,364,69,3	script	Nervous Man#ep16lug01	4_M_ALCHE_A,{
	if (ep16_lug > 12) {
		mes "[Nervous Man]";
		mes "这里也没有……";
		next;
		mes "[Taunting Man]";
		mes "你为什么需要那本书？没有它就走吧。";
		next;
		mes "[Nervous Man]";
		mes "第一印象最重要。第一次问候影响很大！话说回来，我该说什么作为问候？";
		next;
		mes "[Nervous Man]";
		mes "‘早上好，先生。我这个无足轻重的人住在普隆德拉……’不。不行，我不能这样对比我年轻的人说话。";
		npctalk "这样不错！！", "Taunting Man#ep16lug01";
		next;
		mes "[Nervous Man]";
		mes "你好？你哥哥让我来参加宴会。不，不对。我的伴侣可是公主！";
		npctalk "真恶心～", "Taunting Man#ep16lug01";
		next;
		mes "[Nervous Man]";
		mes "为什么没有《王室礼仪——初次见到公主》之类的书？这里可是王室图书馆。";
		npctalk "因为这里是宫殿。", "Taunting Man#ep16lug01";
		next;
		mes "[Nervous Man]";
		mes "他借口忙，把我派来了。乔纳森，我不会放过你。";
		npctalk "如果你伤害乔纳森，你会被逮捕。", "Taunting Man#ep16lug01";
		close;
	}
	mes "[Nervous Man]";
	mes "这里也没有。我要怎么找到它？这里的书太多了。";
	close;
}
prt_cas,365,68,3	script	Taunting Man#ep16lug01	4_M_HUMAN_01,{ end; }



prt_cas,218,182,3	script	Royal Guardian Knight#01	4_M_CRU,{
	mes "[Royal Guardian Knight]";
	npctalk "你要参加宴会吗？", "", bc_self;
	mes "你要进入宴会厅吗？";
	next;
	if (select( "进入。", "暂不进入。" ) == 2) {
		mes "[Royal Guardian Knight]";
		mes "宴会厅随时开放。请赏光参加宴会。";
		close;
	}
	mes "[Royal Guardian Knight]";
	mes "让我带你进去。";
	close2;
	warp "prt_cas",93,212;
	end;
}

prt_cas,97,248,5	script	Court Musician#orint	2_M_BARD_ORIENT,{
	mes "[Court Musician Orint]";
	mes "工作期间禁止聊天。";
	next;
	if (select( "请演奏一曲", "结束对话" ) == 1) {
		specialeffect EF_CHEMICAL_ALLRANGE,AREA, "Court Musician#3";
		mes "[Court Musician Orint]";
		.@r = rand(1,100);
		if (.@r < 12) {
			mes "我将演奏《我想你》。";
			playbgm "04";
		}
		else if (.@r < 22) {
			mes "我将演奏《高山玫瑰》。";
			playbgm "109";
		}
		else if (.@r < 30) {
			mes "我将演奏《东方传说》。";
			playbgm "115";
		}
		else if (.@r < 37) {
			mes "我将演奏《鲸鱼之梦》。";
			playbgm "117";
		}
		else if (.@r < 44) {
			mes "我将演奏《耀眼的雪》。";
			playbgm "137";
		}
		else if (.@r < 51) {
			mes "我将演奏《棉花糖华尔兹》。";
			playbgm "145";
		}
		else if (.@r < 58) {
			mes "我将演奏《艾可拉珠》。";
			playbgm "155";
		}
		else if (.@r < 65) {
			mes "我将演奏《更近一步》。";
			playbgm "30";
		}
		else if (.@r < 72) {
			mes "我将演奏《并不遥远》。";
			playbgm "30";
		}
		else if (.@r < 79) {
			mes "我将演奏《艾尔贝塔主题曲》。";
			playbgm "15";
		}
		else if (.@r < 86) {
			mes "我将演奏《绚丽梦境》。";
			playbgm "128";
		}
		else if (.@r < 93) {
			mes "我将演奏《颤栗噩梦》。";
			playbgm "160";
		}
		else if (.@r < 100) {

		mes "我们每年都会举行仪式并准备食物。";
		mes "但似乎没有办法平息";
		mes "老妇人不断增长的怒火。";
		next;
		mes "[Old Fortune Teller]";
		mes "那一天快到了。我能感觉到。";
		mes "巴科纳瓦很快会吞下月亮，";
		mes "前来惩罚村庄。";
		close;
	} else {
		mes "[Old Fortune Teller]";
		mes "你怎么能说传说是假的！";
		mes "因为你，巴科纳瓦的怒火";
		mes "变得更强了！";
		mes "如果村庄毁灭，";
		mes "全都是你的错！";
		close;
	}
}

malaya,285,332,4	script	Old Legend Teller#bako1	574,{
	if (checkweight(1301,3) == 0) {
		mes "无法开始对话。你携带的物品太多了。-";
		close;
	}
	if (BaseLevel < 120) {
		mes "[Old Legend Teller]";
		mes "有件事需要完成，";
		mes "但你看起来太脆弱，";
		mes "帮不上我的忙。";
		next;
		mes "[Old Legend Teller]";
		mes "等你的力量";
		mes "足以匹敌梦魇时，";
		mes "再回来吧。";
		close;
	}
	if (malaya_hi < 20) {
		mes "- 他似乎对你很警惕。-";
		close;
	}
	if (malaya_bakona1 == 0) {
		mes "[Old Legend Teller]";
		mes "老妇人以巴科纳瓦的形态";
		mes "复活了。";
		mes "她很快会回来向村庄复仇。";
		mes "我们必须平息她，";
		mes "防止进一步的破坏……";
		next;
		switch(select("平息巴科纳瓦？：进一步的破坏？")) {
		case 1:
			mes "[Old Legend Teller]";
			mes "老妇人因村民的自私";
			mes "遭遇了不公正的死亡。";
			mes "她是一位关爱孩子的母亲，";
			mes "深爱着自己的儿子。";
			next;
			mes "[Old Legend Teller]";
			mes "如果我们找到她儿子的下落，并用儿子的遗物";
			mes "举行仪式，";
			mes "就能平息她不安的灵魂，";
			mes "让她放过我们，不再破坏村庄。";
			next;
			mes "[Villagers]";
			mes "没用的，先生！！";
			next;
			mes "[Villagers]";
			mes "那样是阻止不了怪物的！";
			next;
			mes "[Old Legend Teller]";
			mes "当然，追查一个";
			mes "已经消失百年之人的下落并不容易。";
			mes "...";
			next;
			mes "[Old Legend Teller]";
			mes "不过，你不觉得";
			mes "值得试一试吗？";
			mes "请帮助我们脱离苦难。";
			next;
			switch(select("没用的。：我来帮忙。")) {
			case 1:
				mes "[Old Legend Teller]";
				mes "是的，你说得也对。";
				mes "你面对的不是人类，";
				mes "而是怪物。";
				mes "不过，我相信那位老妇人的";
				mes "善良本性。";
				close;
			case 2:
				mes "[Old Legend Teller]";
				mes "你愿意做吗？";
				mes "根据传说，";
				mes "老妇人的儿子腿脚不便，";
				mes "是一名售卖木偶的旅行商人。";
				next;
				mes "[Old Legend Teller]";
				mes "他留下了一块^FF0000石板碎片^000000。";
				mes "但碎片很小且已损坏，";
				mes "很难辨认。";
				next;
				mes "[Old Legend Teller]";
				mes "先把它带给我。";
				mes "沿这条路往下走，";
				mes "你会在港口附近遇到我的孙女。";
				mes "从她那里拿到石板碎片。";
				set malaya_bakona1,1;
				setquest 1174;
				close;
			}
		case 2:
			mes "[Old Legend Teller]";
			mes "对巴科纳瓦——我是说，死去的老妇人——";
			mes "对人们的怨恨。";
			mes "月亮和这个村庄……";
			mes "她会试图摧毁它们。";
			next;
			select("复仇？过了这么多年还要复仇？" );
			mes "[Old Legend Teller]";
			mes "有一段时间，她一直";
			mes "责怪月亮，";
			mes "怨恨村民。";
			mes "随着时间过去，这种情绪越来越强烈。";
			next;
			mes "[Old Legend Teller]";
			mes "你觉得她为什么会变成那样的怪物？";
			mes "你觉得她这些年来";
			mes "脑中一直想着什么？";
			mes "愤怒和复仇。";
			next;
			mes "[Old Legend Teller]";
			mes "她被抛弃的";
			mes "无法忘却的怨恨，";
			mes "以及对月亮和村庄的怨恨。";
			mes "所以必须化解这份怨恨。";
			close;
		}
	} else if (malaya_bakona1 == 1) {
		mes "[Old Legend Teller]";
		mes "请带来^FF0000石板碎片^000000。";
		mes "沿这条路往下走，";
		mes "你会在港口附近遇到我的孙女。";
		mes "从她那里拿到石板碎片。";
		close;
	} else if (malaya_bakona1 == 2) {
		mes "[Old Legend Teller]";
		mes "很好，你拿到了石板碎片。";
		mes "保管好，别弄丢。";
		mes "它有助于追查传说。";
		next;
		mes "[Old Legend Teller]";
		mes "我听说有个男人独自住在";
		mes "森林田野西北尽头。";
		mes "听说有人在那里见过木偶。";
		mes "那地方太偏远，";
		mes "我们这种人根本无法前往。";
		mes "你能替我们去看看吗？";
		next;
		switch(select("你自己去吧！：你的说明太模糊。：我这就去！")) {
		case 1:
			mes "[Old Legend Teller]";
			mes "你这狡猾的年轻人！";
			close;
		case 2:
			mes "[Old Legend Teller]";
			mes "你说得有道理，但";
			mes "我现在只能说这么多。";
			mes "地点在森林西北尽头。";
			mes "过桥后向西走，";
			mes "你会看到一个人。";
			break;
		case 3:
			mes "[Old Legend Teller]";
			mes "你真是个善良的年轻人！";
			mes "地点在森林西北尽头。";
			mes "过桥后向西走，";
			mes "你会看到一名^0000FF马来亚移民^000000。";
			break;
		}
		mes "祝你好运……为了我们……";
		erasequest 1175;
		setquest 1176;
		set malaya_bakona1,3;
		close;
	} else if (malaya_bakona1 == 3) {
		mes "[Old Legend Teller]";
		mes "地点在森林西北尽头。";
		mes "过桥后向西走，";
		mes "你会看到一个人。";
		mes "祝你好运……为了我们……";
		close;
	} else if (malaya_bakona1 < 6) {
		mes "[Old Legend Teller]";
		mes "老妇人儿子的踪迹";
		mes "一直延伸到了";
		mes "巴里奥·马希瓦加？";
		mes "他可能不是商人……";
		mes "我真的很好奇他是谁……";
		next;
		mes "[Old Legend Teller]";
		mes "你为什么回到这里，";
		mes "而不是直接前往";
		mes "巴里奥·马希瓦加？";
		close;
	} else if (malaya_bakona1 == 6) {
		mes "[Old Legend Teller]";
		mes "这是真的吗？";
		mes "巴科纳瓦变成老妇人，";
		mes "捏造了传说……";
		mes "看来至今为止所有村民";
		mes "都被那个可怕的怪物操纵了。";
		next;
		mes "[Old Legend Teller]";
		mes "那就没有犹豫的理由了。";
		mes "你必须在巴科纳瓦先发动攻击前，";
		mes "进入它的巢穴。";
		mes "我相信我们可以把这件事托付给你，对吧？";
		next;
		switch(select("嗯……：当然！")) {
		case 1:
			mes "[Old Legend Teller]";
			mes "气氛本来很好，";
			mes "但突然全毁了。";
			mes "没想到你这么害羞……";
			close;
		case 2:
			mes "[Old Legend Teller]";
			mes "我会替你和村长谈谈，";
			mes "让你能够进入巴科纳瓦湖。";
			mes "请替我们消灭这个怪物。";
			erasequest 1179;
			set malaya_bakona1,7;
			if (!VIP_SCRIPT || vip_status(VIP_STATUS_ACTIVE))
				getitem 6499,5; //Ancient_Grudge
			else
				getitem 6499,3; //Ancient_Grudge
			getexp 500000,200000;
			close;
		}
		close;
	} else if (malaya_bakona1 == 7) {
		if (malaya_bakona2 < 15) {
			mes "[Old Legend Teller]";
			mes "如果你不介意，";
			mes "能帮帮村长吗？";
			mes "因为巴科纳瓦，";
			mes "大家已经不再互相关心……";
			next;
		}
		mes "[Old Legend Teller]";
		mes "我们相信了一百年的传说，";
		mes "全都是谎言……";
		mes "请替我们消灭这个怪物。";
		close;
	}
}

ma_fild02,40,240,4	script	Malaya Immigrant#bako1	578,{
	if (malaya_bakona1 < 3) {
		mes "[Malaya Immigrant]";
		mes "你一定很勇敢，";
		mes "才能来到如此偏远的地方。";
		mes "最近马来港怎么样？";
		mes "我听说住在湖里的怪物巴科纳瓦";
		mes "正在威胁村民。";
		mes "我一直待在这里，对发生的事一无所知。";
		close;
	} else if (malaya_bakona1 == 3) {
		mes "[Malaya Immigrant]";
		mes "你一定很勇敢，";
		mes "才能来到如此偏远的地方。";
		mes "最近马来港怎么样？";
		mes "我听说住在湖里的怪物巴科纳瓦";
		mes "正在威胁村民。";
		mes "我一直待在这里，对发生的事一无所知。";
		next;
		mes "[Malaya Immigrant]";
		mes "你就是以前卖木偶的旅行商人，对吧？";
		mes "我不知道什么旅行商人，但说到木偶，";
		mes "（翻找东西）你是指这个吗？";
		mes "具体情况我不清楚，";
		mes "但我觉得和很久以前听到的事有关。";
		next;
		switch(select("你在这里做什么？：你知道这块石板碎片吗？：请告诉我故事。：旅行商人是谁？")) {
		case 1:
			mes "[Malaya Immigrant]";
			mes "我喜欢这里的环境，";
			mes "所以决定留下生活。";
			mes "这里没有义务束缚。";
			mes "对我来说，这就和天堂一样。";
			close;
		case 2:
			mes "[Malaya Immigrant]";
			mes "这是非常古老的石板碎片。";
			mes "抱歉，我以前从没见过。";
			mes "上面似乎有某种文字，";
			mes "但我看不懂。";
			close;
		case 3:
			mes "[Malaya Immigrant]";
			mes "这是个简单的故事。";
			mes "^0000FF一个我从未见过的受伤男人^000000";
			mes "^0000FFcame to my house and asked for help.^000000";
			mes "^0000FF伤愈后，他制作了一个木偶^000000";
			next;
			mes "[Malaya Immigrant]";
			mes "^0000FF据说可以驱赶恶灵^000000";
			mes "^0000FFas a token of gratitude,^000000";
			mes "^0000FFand left for Baryo Mahiwaga.^000000";
			next;
		select("他去了巴里奥·马希瓦加？" );
			mes "[Malaya Immigrant]";
		mes "根据我听到的消息，";
		mes "确实如此。但这个故事";
		mes "口口相传了很久，";
		mes "我也无法确定。";
			next;
			mes "从巴里奥·马希瓦加村出发，使用关键词^0000FF马来亚^000000";
			mes "或^0000FF巴科纳瓦^000000，";
			mes "也许就能查出旅行商人的身份";
			mes "和下落。";
			erasequest 1176;
			setquest 1177;
			set malaya_bakona1,4;
			close;
		case 4:
			mes "[Malaya Immigrant]";
		mes "嗯，信息太少，";
		mes "所以我不能确定，但";
		mes "我怀疑他是否真的是商人。";
		mes "带着重伤来到城镇，";
		mes "实在太可疑了……";
			next;
			mes "[Malaya Immigrant]";
		mes "而且渴望得到木偶，";
		mes "可能有某种仪式意义。";
		mes "比如保护某人免受邪恶力量……";
		mes "大概就是这种事。";
			next;
		mes "旅行商人的身份……";
		mes "看来又有一个";
		mes "谜团要解开。";
		mes "我想很快就会";
		mes "真相大白。";
			close;
		}
	} else {
		mes "[Malaya Immigrant]";
		mes "我再慢慢告诉你";
		mes "流传下来的故事。";
		mes "仔细听，然后重复……";
		mes "不，我是说，你不用重复。";
		next;
		mes "[Orally Transmitted Story]";
		mes "^0000FF一个我从未见过的受伤男人^000000";
		mes "^0000FFcame to my house and asked for help.^000000";
		mes "^0000FF伤愈后，为了表达感谢，他制作了一个木偶^000000";
		mes "^0000FF据说可以驱赶恶灵。^000000";
		mes "^0000FF然后他前往了巴里奥·马希瓦加。^000000";
		next;
		mes "从巴里奥·马希瓦加村出发，使用关键词^0000FF马来亚^000000";
		mes "或^0000FF巴科纳瓦^000000，";
		mes "也许就能查出旅行商人的身份";
		mes "和下落。";
		close;
	}
}

ma_fild01,165,237,4	script	Malaya Immigrant#bako2	582,{
	if (malaya_bakona1 < 4) {

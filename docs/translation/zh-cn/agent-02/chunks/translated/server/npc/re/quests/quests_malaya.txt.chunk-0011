ma_fild01,171,235,0	script	#bako1	139,2,2,{
	end;
OnTouch_:
	if (malaya_bakona1 == 5) {
		mes "损坏非常严重，";
		mes "记录已经无法辨认。";
		mes "把石板碎片插入墙上的孔洞后，";
		mes "它像拼图一样完美契合。";
		mes "文字虽然不清楚，但仍然可以阅读。";
		next;
		callsub L_Record;
		set malaya_bakona1,6;
		erasequest 1178;
		setquest 1179;
		close;
	} else if (malaya_bakona1 == 6) {
		mes "这是百年前一名剑士留下的记录。";
		next;
		switch(select("我不需要阅读。：再次阅读记录。")) {
	
	
	
	

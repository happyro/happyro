lasagna,226,196,5	script	Aram#dorcon01	4_DR_F_02,{
	setpcblock PCBLOCK_NPC, true;
	npctalk "这就是著名的酒馆烤箱？", "Tos#dorcon01", bc_self;
	sleep2 2000;
	npctalk "别像乡巴佬一样东张西望！", "", bc_self;
	sleep2 2000;
	npctalk "哇！看这个！这就是他们三人坐过的地方吗？", "Porto#dorcon01", bc_self;
	sleep2 2000;
	npctalk "天啊！你简直是在大声宣布自己是乡巴佬！", "", bc_self;
	sleep2 2000;
	npctalk "既然来了，我们就来许下烤箱誓言！", "Tos#dorcon01", bc_self;
	sleep2 2000;
	npctalk "这就是我们费心来这里的原因！像 Peperoncino、Thomas 和 Gamberry 一样，我们团结起来就会成功！", "Porto#dorcon01", bc_self;
	sleep2 2000;
	npctalk "老板！请用力摇三杯 Kaluna 牛奶！上面再加蛋黄！", "Tos#dorcon01", bc_self;
	sleep2 2000;
	npctalk "哦，太丢脸了！我得告诉你多少次，这里的人都把它搅拌？！", "", bc_self;
	sleep2 2000;
	npctalk "搅拌还是摇晃，管它呢，只要好喝就行！", "Porto#dorcon01", bc_self;
	sleep2 1000;
	npctalk "别让别人发现你们是外地人！", "", bc_self;
	sleep2 2000;
	npctalk "被发现又怎样？！显然这里没有多少拉扎格纳本地人。", "Tos#dorcon01", bc_self;
	sleep2 2000;
	npctalk "是啊，既然来了就好好享受吧。我会尽量不表现得太明显。", "Porto#dorcon01", bc_self;
	sleep2 2000;
	npctalk "好，好。我不会表现出来。", "Tos#dorcon01", bc_self;
	sleep2 2000;
	classchange( 4_CAT_SAILOR3, "Employee#dorcon01", bc_self );
	npctalk "三杯 Kaluna 牛奶，给你。", "Employee#dorcon01", bc_self;
	sleep2 2000;
	classchange( HIDDEN_WARP_NPC, "Employee#dorcon01", bc_self );
	npctalk "终于！", "Porto#dorcon01", bc_self;
	sleep2 2000;
	npctalk "让我们干杯。举起酒杯！", "Tos#dorcon01", bc_self;
	sleep2 2000;
	npctalk "我们不能同年同月同日生，但可以同年同月同日死！", "", bc_self;
	sleep2 2000;
	npctalk "为什么提死？", "Tos#dorcon01", bc_self;
	sleep2 2000;
	npctalk "那就人人为一，一人为人人！", "Porto#dorcon01", bc_self;
	sleep2 1000;
	npctalk "......", "", bc_self;
	sleep2 2000;
	npctalk "真俗……", "", bc_self;
	setpcblock PCBLOCK_NPC, false;
	end;
}

lasagna,228,193,5	script	Porto#dorcon01	4_DR_M_01,{
	setpcblock PCBLOCK_NPC, true;

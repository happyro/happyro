lasagna,236,179,5	script	Meow goon#dorcon01	4_DR_M_01,{
	mes "[Meow goon]";
	mes "遇到问题就找他们帮忙。就是治安队里的双胞胎。Aglio……Ali……Olio……";
	next;
	mes "[Meow goon]";
	mes "对！他们是 Aglio 和 Oligo！";
	npctalk "Aglio 和 Oligo！", "", bc_self;
	next;
	emotion ET_SWEAT, getnpcid(0, "Goon meow#dorcon01");
	mes "[Goon meow]";
	mes "嘿，不是这样……不对……";
	next;
	mes "[Meow goon]";
	mes "不对？";
	next;
	mes "[Goon meow]";
	mes "他们是 Aglio 和 Olio，不是 Aglio 和 Oligo。你把他们说得像一种糖。";
	npctalk "他们是 Aglio 和 Olio。", "Goon meow#dorcon01", bc_self;
	next;
	mes "[Meow goon]";
	mes "随便吧。";
	close;
}

lasagna,235,178,5	script	Goon meow#dorcon01	4_DR_M_02,{
	mes "[Goon meow]";
	mes "踏入世界很危险。拿着这些三色凤尾鱼。";
	npctalk "踏入世界很危险。", "", bc_self;
	next;
	mes "[Meow goon]";
	mes "大家离远点！我很危险。嘎啊！三色凤尾鱼能撑多久？！";
	npctalk "大家离远点！我很危险。", "Meow goon#dorcon01", bc_self;
	next;
	mes "[Goon meow]";
	mes "我……结束了……你先走……";
	next;
	mes "[Meow goon]";
	mes "咳……一直睡在我包里的恶灵暴走了！";
	next;
	emotion ET_BEST;
	emotion ET_BEST, getnpcid(0, "Meow goon#dorcon01");
	mes "[Goon meow]";
	mes "很好！这些应该足以让我在新世界不被冷落。";
	npctalk "我们准备得非常充分！", "Meow goon#dorcon01";
	close;
}

lasagna,232,187,6	script	Fettuccina#dorcon01	4_CAT_SAILOR2,{

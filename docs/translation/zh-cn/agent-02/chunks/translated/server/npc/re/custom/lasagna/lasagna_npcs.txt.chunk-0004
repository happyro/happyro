	else if (.@r == 2)
		npctalk "风属性克制水属性。", "", bc_self;
	else if (.@r == 3)
		npctalk "火属性克制地属性。", "", bc_self;
	else
		npctalk "圣属性与暗属性相互对立。", "", bc_self;
	mes "[Property Cat]";
	mes "世上的每个生命都有属性。属性有中性、四大自然属性，以及圣和暗等多种。";
	next;
	mes "[Property Cat]";
	mes "最具代表性的是自然属性，简单来说就是水、风、地和火。此外还有不死、圣和暗属性。";
	next;
	mes "[Property Cat]";
	mes "各属性彼此交织。聪明地使用相克属性吧。";
	next;
	mes "[Property Cat]";
	mes "这样你就能在战斗中占据上风。我简单举例说明它们的关系。";
	next;
	mes "[Property Cat]";
	mes "火属性高度抵抗地属性，而地属性明显克制风属性。";
	next;
	mes "[Property Cat]";
	mes "风属性克制水属性，而水属性克制火属性。";
	next;
	mes "[Property Cat]";
	mes "圣属性与暗属性直接对立，请牢记这一点。";
	next;
	mes "[Property Cat]";
	mes "除此之外还有中性和不死属性。你很快就会了解它们。你必须亲自体验。";
	close;
}

lasagna,208,188,3	script	Cat Paw Service#lasagna	4_M_MERCAT1,4,4,{
	if (Class == Job_Summoner && isbegin_quest(7720) == 0) {
		if (checkweight(1001,2) == 0) {
			mes "- Hold on a second here!! -";
			mes "- 你携带的物品太多。-";
			mes "- 因此无法再领取物品。-";
			mes "- Free up some space -";
			mes "- and try again. -";
			close;
		}
		mes "[Cat Paw Commerce Group]";
		mes "嘿，小家伙！你要前往米德加尔特大陆吗？那最好听我说！";
		next;
		mes "[Cat Paw Commerce Group]";
		mes "和猫爪商贸团一样，还有其他团体提供^4d4dff位置共享服务^000000和^4d4dff仓库服务^000000。";
		next;
		mes "[Cat Paw Commerce Group]";
		mes "它们是：^4d4dff卡普拉^000000和^4d4dffZonda^000000。当然别忘了猫爪商贸团！";
		next;
		mes "[Cat Paw Commerce Group]";
		mes "^4d4dff位置共享^000000会保存你可以返回的位置。冒险中因疲劳倒下时，你应该回到村庄，这项服务就能做到。";
		next;
		mes "[Cat Paw Commerce Group]";
		mes "使用^4d4dff蝴蝶翅膀^000000道具即可直接飞到那里。";
		next;
		mes "[Cat Paw Commerce Group]";
		mes "共享的位置大多是安全的村庄或城市。";
		next;
		mes "[Cat Paw Commerce Group]";
		mes "^4d4dff仓库服务^000000也类似。支付少量服务费，就能安全存放物品。";
		next;
		mes "[Cat Paw Commerce Group]";
		mes "你不可能把所有物品都随身带着，对吧？这就是仓库派上用场的地方。";
		next;
		mes "[Cat Paw Commerce Group]";
		mes "只要支付服务费，你随时随地都能在仓库存取物品！现在明白了吗？";
		setquest 7720;// Service Manual
		completequest 7720;// Service Manual
		getitem 12323,10;// Novice Fly Wing
		getitem 12324,10;// Novice Butterfly Wing
		getexp 50,50;
		next;
		mes "[Cat Paw Commerce Group]";
		mes "哦，要我再解释一次吗？";
		next;
		if (select( "No.", "Please." ) == 2) {
			mes "[Cat Paw Commerce Group]";
			mes "和猫爪商贸团一样，还有其他团体提供^4d4dff位置共享服务^000000和^4d4dff仓库服务^000000。";
			next;
			mes "[Cat Paw Commerce Group]";
			mes "它们是：^4d4dff卡普拉^000000和^4d4dffZonda^000000。当然别忘了猫爪商贸团！";
			next;
			mes "[Cat Paw Commerce Group]";
			mes "^4d4dff位置共享^000000会保存你可以返回的位置。冒险中因疲劳倒下时，你应该回到村庄，这项服务就能做到。";
			next;
			mes "[Cat Paw Commerce Group]";
			mes "使用^4d4dff蝴蝶翅膀^000000道具即可直接飞到那里。";
			next;
			mes "[Cat Paw Commerce Group]";
			mes "共享的位置大多是安全的村庄或城市。";
			next;
			mes "[Cat Paw Commerce Group]";
			mes "^4d4dff仓库服务^000000也类似。支付少量服务费，就能安全存放物品。";
			next;
			mes "[Cat Paw Commerce Group]";
			mes "你不可能把所有物品都随身带着，对吧？这就是仓库派上用场的地方。";
			next;
			mes "[Cat Paw Commerce Group]";
			mes "只要支付服务费，你随时随地都能在仓库存取物品！现在明白了吗？";
			close;
		}
		mes "[Cat Paw Commerce Group]";
		mes "那么，你想让我帮你什么？";
	}
	else {
		mes "[Cat Paw Commerce Group]";
		mes "来吧！欢迎！你想让我帮你什么？";
	}
	next;
	switch( select( "Location sharing service", "Warehouse service", "Quit." ) ) {
	case 1:
		mes "[Cat Paw Commerce Group]";
		mes "保存好了，喵！";
		savepoint "lasagna",193,183,1,1;
		close;
	case 2:
		if (!callfunc("F_CanOpenStorage")) {
			mes "[Cat Paw Commerce Group]";
		mes "抱歉，但是……";
			if (Class == Job_Summoner) {
				mes "你应该先学习新的基础技能。想使用仓库就去学习技能。";
			}
			else {
				mes "想使用仓库，应该先学习一些基础技能。去学习技能，直到达到使用仓库的等级。我想人类应该是^4d4dff基础等级 6^000000。";
			}
			close;
		}
		if (countitem(7059) > 0)// Free Ticket for Kafra Storage
			delitem 7059,1;
		else {
			if (Zeny < 50) {
				mes "[Cat Paw Commerce Group]";
				mes "如果你没有奶酪，我也很乐意收 Zeny。仓库服务费是 50 Zeny。";
				close;
			}
			Zeny = Zeny - 50;
		}
		// todo kafra points
		mes "[Cat Paw Commerce Group]";
		mes "我会为你打开仓库。下次再来！";
		close2;
		openstorage();
		end;
	case 3:
		mes "[Cat Paw Commerce Group]";
		mes "那下次再来。";
		close;
	}
OnTouch:
	if (Class == Job_Summoner && isbegin_quest(7720) != 2)
		npctalk "喵！嘿，新朋友！我有个故事要讲给你听。你可别错过！", "", bc_self;
	end;
OnInit:
	// note: permanent for human
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "!isbegin_quest(7720)" );
	end;
}


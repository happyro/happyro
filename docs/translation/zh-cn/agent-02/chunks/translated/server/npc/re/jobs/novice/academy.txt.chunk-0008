// - Dacquoise
// - Teaches the player about Cooking.
// -----------------------------------------------------------------------------
iz_ac01,147,50,3	script	Dacquoise#ac	4_COOK,{
	if (!checkweight(1304,3)) {
		mes "你为什么带着这么多东西？";
		mes "放下后再回来。";
		close;
	}
	if (Class == Job_Novice || (isbegin_quest(14154) == 1 || isbegin_quest(14155) == 1 || isbegin_quest(14156) == 1 || isbegin_quest(14157) == 1)) {
		if (!new_cook) {
			mes "[Dacquoise]";
		mes "多么诱人的香味！";
			next;
			mes "[Eclaire]";
		mes "刺激五感的各种料理。哦，这是天堂！";
			next;
			mes "[Mille Feuille]";
		mes "你来到这里绝不是偶然！";
			next;
			mes "[Dacquoise]";
		mes "陌生人，你叫什么？";
			next;
			mes "["+strcharinfo(0)+"]";
			mes ""+strcharinfo(0)+", hello.";
			next;
			emotion ET_BEST;
			mes "[Dacquoise]";
		mes "我是Dacquoise，卢恩-米德加尔兹传奇厨师^0000cdCharles Orleans^000000的弟子。";
			next;
			emotion ET_BEST, getnpcid(0, "Eclaire#"+strnpcinfo(2));
			mes "[Eclaire]";
		mes "我们也是Orleans先生^0000cd粉丝俱乐部Loverleans^000000的成员。";
			next;
			emotion ET_THROB, getnpcid(0, "Mille Feuille#"+strnpcinfo(2));
			mes "[Mille Feuille]";
		mes "Orleans属于我们所有人！";
			next;
			emotion ET_CRY;
			mes "[Dacquoise]";
		mes "啊，大地上的傻瓜们都吃什么？";
			next;
			mes "[Dacquoise]";
		mes "水果？当然可以生吃，但看到红色草莓铺在奶油蛋糕上时，不就是艺术吗？";
			next;
			mes "[Eclaire]";
		mes "面包？当然可以直接吃，但你能抵抗完美三明治中肉、奶酪和蔬菜的绝妙和谐吗？";
			next;
			mes "[Mille Feuille]";
		mes "我喜欢蒸Minourus马蹄！";
			next;
			mes "[Dacquoise]";
		mes "吃下专门料理可以^0000cd提升特定属性^000000，另外还能^0000cd恢复生命^000000，为什么不烹饪呢？";
			next;
			mes "[Eclaire]";
		mes "你想进一步了解烹饪吗？";
			next;
			emotion ET_THROB, getnpcid(0, "Mille Feuille#"+strnpcinfo(2));
			mes "[Mille Feuille]";
		mes "要体验烹饪的各种可能吗？";
			next;
			if (select("我没兴趣，告辞……", "哇！我想了解更多！") == 1) {
				mes "[Dacquoise]";
				mes "真的吗？那好吧……改变主意时再回来。";
				next;
				mes "[Eclaire]";
				mes "我有预感你会再回来！";
				next;
				mes "[Mille Feuille]";
				mes "吃红薯噎住时，别忘了捶胸口！";
				close;
			}
			emotion ET_BEST;
			mes "[Dacquoise]";
			mes "好，我们会成为你烹饪之旅的友善向导！！";
			next;
			emotion ET_BEST, getnpcid(0, "Eclaire#"+strnpcinfo(2));
			mes "[Eclaire]";
			mes "没关系，想知道什么都可以问我。";
			next;
			emotion ET_THROB, getnpcid(0, "Mille Feuille#"+strnpcinfo(2));
			mes "[Mille Feuille]";
			mes "善意就是我们的香料～";
			next;
				switch(select("烹饪的好处", "烹饪方法", "其实我得走了……")) {
			case 1:
				mes "[Dacquoise]";
				mes "啊哈！你想知道烹饪的好处？料理有两种好处！";
				next;
				emotion ET_SURPRISE;
				mes "[Dacquoise]";
				mes "第一，^0000cd提升属性！^000000砰！！";
				next;
				mes "[Eclaire]";
				mes "料理分为6类，分别提升^0000cdStr、Agi、Vit、Int、Dex、Luk^000000。";
				next;
				mes "[Mille Feuille]";
				mes "属性提升量会根据烹饪等级变化。";
				next;
				emotion ET_SURPRISE;
				mes "[Dacquoise]";
				mes "下一个好处？砰砰！";
				next;
				mes "[Eclaire]";
				mes "^0000cdHP和SP恢复^000000效果！";
				next;
				mes "[Mille Feuille]";
				mes "这也会随烹饪等级变化，有些料理只能恢复HP。";
				next;
				mes "[Dacquoise]";
				mes "怎么样？听起来很好吃吧？";
				next;
				mes "[Eclaire]";
				mes "你现在等级太低，无法体验效果。等级提高后，你会体验料理效果并感动落泪。";
				next;
				mes "[Mille Feuille]";
				mes "准备好蕾丝手帕。";
				next;
				select("我该怎么烹饪？");
				mes "[Dacquoise]";
				mes "这就对了！现在你似乎感兴趣了！";
				next;
				mes "[Dacquoise]";
				mes "但烹饪不能急于求成！正确烹饪需要准备。";
				next;
				mes "[Eclaire]";
				mes "只有准备充分的人才能进入烹饪世界！";
				next;
				mes "[Mille Feuille]";
				mes "准备工作并不难！";
				next;
				mes "[Dacquoise]";
				mes "准备也可以分为两个阶段。";
				next;
				emotion ET_SURPRISE;
				break;
			case 2:
				mes "[Dacquoise]";
				mes "没错，烹饪需要准备。这也可以分为两类。";
				next;
				emotion ET_SURPRISE, getnpcid(0, "Dacquoise#"+strnpcinfo(2));

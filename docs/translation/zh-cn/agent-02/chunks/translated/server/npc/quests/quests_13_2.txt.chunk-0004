			next;
	mes "- 他们主要在谈城镇琐事，没有多少有用信息。-";
			next;
	mes "- 最好在他们怀疑我之前离开。-";
			close;
		}
		else {
			mes "[Villager]";
	mes "……外来者吗……";
	mes "我们什么时候允许外来者来访了？";
	mes "对了……你听得懂我吗？";
			next;
			mes "[Villager]";
	mes "……我想没关系……";
	mes "啊，我们真的能互相理解吗？";
			close;
		}
	}
	else {
		mes "[Villager]";
	mes "Fsd a idh as?";
	mes "Nsf iu ai sd a sd!";
	mes "Asd fo sdj fso df.";
		close;
	}
}

man_in01,175,59,5	script	Snorren#ep13_13	454,{
	if (checkweight(1201,2) == 0) {

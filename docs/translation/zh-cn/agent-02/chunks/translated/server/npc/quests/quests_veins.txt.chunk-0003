// Escort Dancers to Schwarzwald Republic
job_duncer,93,106,6	script	Dance Instructor#sch	892,{
	if ((MaxWeight-Weight) < 2000 || checkweight(1201,1) == 0) {
		mes "^3355FF等一下！你现在携带的东西太多了。请使用卡普拉服务存放一些物品后再回来。^000000";
		close;
	}

	if (que_sch < 11) {
		mes "[Hianna]";
		mes "大家继续加油！距离大型演出只剩几天了！嘿……你！不能好好做吗？腰转快一点！";
		close;
	}
	else if (que_sch == 11) {
		mes "[Hianna]";
		mes "喂，你是谁？盯着舞者看的色狼已经够多了。我希望你别来观看我们的练习。";
		next;
		if (select("我想要扩音器。:呃……") == 2) {
			mes "[Hianna]";
			mes "如果你真的想看我们跳舞，就来演出并买票。免费观看可不算支持艺术。";
			close;
		}
		mes "[Hianna]";
		mes "你想要扩音器？抱歉，这不是我能借给任何人的东西。而且你在其他地方也找不到一个。";
		next;
		if (select("拜托！我什么都愿意做！:以后再说。") == 2) {
			mes "[Hianna]";
			mes "好吧。抱歉，我帮不了你。";
			close;
		}
		mes "[Hianna]";
		mes "什么都愿意做？好，你刚才说中了关键词。仔细听听我的要求吧。";

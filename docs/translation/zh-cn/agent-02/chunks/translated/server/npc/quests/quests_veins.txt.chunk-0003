		close;
	}
	else if (que_sch == 11) {
		mes "[Ruan]";
		mes "真糟糕。我为什么会被关在这里？我什么也没做，不该受到这种待遇！";
		next;
		mes "[Ruan]";
		mes "事情糟到我甚至开始想念希安娜的声音了。她的声音大得吓人，就算拿扩音器也喊不过她。";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "什么……？！";

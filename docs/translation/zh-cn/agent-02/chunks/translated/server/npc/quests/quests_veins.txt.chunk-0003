		mes "[Jesse]";
		mes "什么？你想见那名囚犯？抱歉，他因涉嫌间谍活动被捕后，不允许见任何人。";
		set que_sch,5;
		close;
	}
	else if (que_sch == 5) {
		mes "[Jesse]";
		mes "嗯，你还真执着。好吧，如果你能帮我一个忙，我就让你进去。给我带一份^FF0000炸猴尾^000000。";
		next;
		mes "[Jesse]";
		mes "当然，我只能让你进入里面。至于他们是否真的让你见囚犯，那是另一回事。成交吗？";
		set que_sch,6;
		close;
	}
	else if (que_sch == 6) {
		if (countitem(12066) > 0) {
			mes "[Jesse]";
			mes "啊，就是这个！谢谢你的炸猴尾~ 好了，去梦罗克城堡找^FF0000克里格爵士^000000。得到他的批准后，我就让你进去。";
			delitem 12066,1; //Luk_Dish01
			set que_sch,7;
			close;
		}
		mes "[Jesse]";
		mes "给我带一盘^FF0000炸猴尾^000000。否则我不会帮你。我知道你是好意，但我也在拿自己的工作冒险……";
		close;
	}
	else if (que_sch < 10) {
		mes "[Jesse]";
		mes "你还没得到克里格爵士的批准？最好快去，否则进入这座监狱也没有意义。你知道，不能在里面随便偷偷溜达。";
		close;
	}
	else if (que_sch == 10) {
		mes "[Jesse]";
		mes "你真的得到克里格爵士的批准了吗？好吧，现在你可以进去了。";
		close2;
		warp "ra_in01",48,355;
		end;
	}
	else if (que_sch < 19) {
		mes "[Jesse]";
		mes "你想进去吗？";
		next;
		if (select("是。:否") == 1) {
			mes "[Jesse]";
			mes "和那家伙说话时小心点：他很会说话，差点就说服许多守卫放他自由了。";
			close2;
			warp "ra_in01",48,355;
			end;
		}
		mes "[Jesse]";
		mes "慢慢来。如果你还没有做好心理准备，就不适合和囚犯交谈。";
		close;
	}
	else if (que_sch < 19) {
		mes "[Jesse]";
		mes "糟糕，我有麻烦了。囚犯逃跑了。我怎么会让这种事……发生？！该死，我得把这件事报告给克里格先生。";
		close;
	}
	mes "[Jesse]";
	mes "真是松了口气！他们真的安排好让囚犯逃跑了吗？我还以为自己会因为那件事被解雇。";
	close;
}

morocc_in,79,163,0	script	Public Security Officer	748,{
	if (que_sch < 7) {
		mes "[Krieg]";
		mes "我负责梦罗克的公共治安。最近扰乱公共秩序的事件越来越多，也流传着许多令人不安的传闻……";
		close;
	}
	else if (que_sch == 7) {
		mes "[Krieg]";
		mes "你好，冒险者。我能为你做什么？";
		next;
		select("我想见一名囚犯，克里格先生。");
		mes "[Krieg]";
		mes "维特？抱歉，我不能批准。普通囚犯可以接受探视，但涉嫌间谍活动的人不行。这就是他入狱的原因。";
		next;
		mes "[Krieg]";
		mes "如果我认识你，或者有我信任的人能为你担保，我会重新考虑让你见维特。否则，我不能这么做。";
		set que_sch,8;
		close;
	}
	else if (que_sch == 8) {
		mes "[Krieg]";
		mes "在确定你没有参与任何间谍活动之前，我不能让你见维特。";
		close;
	}
	else if (que_sch == 9) {
		mes "[Krieg]";
		mes "在确定你没有参与任何间谍活动之前，我不能让你见维特。";
		next;
		select("这是拉斯达的信。");
		mes "[Krieg]";
		mes "拉斯达？那可是我非常敬重的人。请让我看看他写了什么。嗯……";
		next;
		mes "[Krieg]";
		mes "好吧，我允许你探视维特。我会给监狱看守发消息，让他允许你和维特交谈。";
		set que_sch,10;
		close;
	}
	else if (que_sch < 26) {
		mes "[Krieg]";
		mes "嗯……这几乎超出我的处理能力了。我该怎么办？";
		close;
	}
	mes "[Krieg]";
	mes "我知道你在解决公共安全问题时发挥了重要作用。我只是想感谢你，并为可能给你造成的麻烦道歉。";
	close;
}

ra_in01,48,352,0	warp	que_sch_jail	1,1,morocc,56,89

ra_in01,50,387,4	script	Upset Looking Bard#sch	51,{
	if (que_sch < 10) {
		mes "[Vitre]";
		mes ".............";
		close;
	}
	else if (que_sch == 10) {
		mes "[Vitre]";
		mes "...............................\n...............................\n...............................\n该死，我该怎么办？";
		next;
		select("打扰一下……");
		mes "[Vitre]";
		mes "嗯？我是维特·比兹利塔。你也看到了，我现在实在没法帮你。不过，你想问我什么吗？";
		next;
		switch(select("没什么。:我是拉斯达先生派来的。")) {
		case 1:
			mes "[Vitre]";
			mes "嗯……能接待访客真好。监狱里很孤独……";
			close;
		case 2:
			mes "[Vitre]";
			mes "哦，太好了。拉斯达终于收到我的信了，是吧？我不知道到底发生了什么。我只记得那些陌生人把我带到了这里。";
			next;
			mes "[Vitre]";
			mes "我……我觉得他们不会放我出去。我被关进监狱，却没有证据证明我做错了什么。";
			next;
			mes "[Vitre]";
			mes "只要待在这里，我的生命就有危险，所以必须尽快离开。幸运的是，我发现只要有两样东西，就能打开这些门。";
			next;
			mes "[Vitre]";
			mes "我只需要一把^FF0000扩音器^000000和一把^FF0000小提琴^000000。幸好它们都是普通物品，带到这里也不会引起怀疑。呃……你会帮我的，对吧？";
			next;
			mes "[Vitre]";
			mes "如果你怀疑我的清白，我也能理解。但想想看：你难道不想看看我用扩音器和小提琴做什么吗？听起来很酷，对吧？";
			next;
			mes "^3355FF你听见维特旁边的牢房里有人低声嘟囔。^000000";
			next;
			mes "[????]";
			mes "不知道舞者转职处的那位女士现在怎么样了……";
			set que_sch,11;
			close;
		}
	}
	else if (que_sch < 18) {
		mes "[Vitre]";
		mes "你没带扩音器和小提琴来吗？我坐在这里的时间越长，他们杀我的可能性就越大！";
		close;
	}
	else if (que_sch == 18) {
		if (countitem(7040) > 0 && countitem(1901) > 0) {
			mes "[Vitre]";
			mes "你带来了扩音器和小提琴？太好了！现在退后，小心别伤到你。";
			next;
			mes "...............................\n...............................\n...............................";
			next;
			mes "^3355FF维特深吸一口气，然后用小提琴砸向牢房的钢栏杆。令人意外的是，牢门伴随着巨大的声响打开了。^000000";
			next;
			mes "[Vitre]";
			mes "嘿！比我想象的难了一点，不过看来我自由了~ 好了，我们走吧。";
			next;
			mes "[Jesse]";
			mes "什么？！这是什么声音？！";
			next;
			enablenpc "Jesse#sch";
			mes "[Jesse]";
			mes "喂！你怎么从牢房里出来的？！现在就给我回去！";
			next;
			mes "[Vitre]";
			mes "如果你是我，难道会因为有人对你大喊大叫，就乖乖回牢房吗？算了吧~";
			next;
			mes "^3355FF维特把扩音器举到嘴边，又深吸了一口气。^000000";
			next;
			mes "[Vitre]";
			mes "哇！";
			next;
			mes "[Jesse]";
			mes "呃……哦，天啊……！我、我的耳朵……";
			next;
			mes "[Vitre]";
			mes "嘿！我就喜欢计划顺利进行~ 我们离开这里吧！";
			next;
			delitem 1901,1; //Violin
			delitem 7040,1; //Megaphone
			set que_sch,19;
			close2;
			disablenpc "Jesse#sch";
			warp "morocc",294,153;
			end;
		}
		mes "[Vitre]";
		mes "你没带扩音器和小提琴来吗？请快一点，我剩下的时间不多了！";
		close;
	}
	else {
		mes "[Vitre]";
		mes "嘿！我就喜欢计划顺利进行~ 我们离开这里吧！";
		close2;
		warp "morocc",294,153;
		end;
	}
}


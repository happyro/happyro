				mes "^0099FFItem Drops^000000: Nipper, Garlet, Solid";
				mes "甲壳、甲壳";
				next;
				mes "^FF0000[Byalan Cave 1F Monsters]^000000";
				mes "5. Marina";
				mes "透明水母会像鞭子一样伸展柔软身体攻击，生活在水边凉爽处。";

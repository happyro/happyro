				next;
				mes "^FF0000[Sphinx 3F Monsters]^000000";
				mes "2. Whisper";
				mes "散发诡异气息的活布。有时喜欢隐形……";
				mes "^0099FFItem Drops^000000: Fabric";
				next;
				mes "^FF0000[Sphinx 3F Monsters]^000000";
				mes "3. Marduk";
				mes "身形瘦长的黑暗巫师。小心，它会魔法！";
				mes "^0099FFItem Drops^000000: Flame Heart";
				next;
				break;
			case 4:
				mes "^FF0000[Sphinx 4F Monsters]^000000";
				mes "1. Whisper";
				mes "散发诡异气息的活布。有时喜欢隐形……";
				mes "^0099FFItem Drops^000000: Fabric";
				next;

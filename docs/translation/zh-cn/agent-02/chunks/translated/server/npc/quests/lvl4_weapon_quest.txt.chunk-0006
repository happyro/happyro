		if (.@npchand1 == 1) {
		mes "剪刀";
		}
		else if (.@npchand1 == 2) {
		mes "石头";
		}
		else if (.@npchand1 == 3) {
		mes "布";
		}
		if (.@npchand2 == 1) {
			mes "剪刀";
		}
		else if (.@npchand2 == 2) {
			mes "石头";
		}
		else if (.@npchand2 == 3) {
			mes "布";
		}
		if (.@npchand3 == 1) {
			mes "剪刀";
		}
		else if (.@npchand3 == 2) {
			mes "石头";
		}
		else if (.@npchand3 == 3) {
			mes "布";
		}
		next;
		mes "[Hein]";
		mes "你写下的答案";
		mes "按这个顺序排列……";

			mes "剪刀";
		}
		else if (.@myhand3 == 2) {
			mes "Rock";
		}
		else if (.@myhand3 == 3) {
			mes "布";
		}
		next;
		if (.@shobu > 1) {
			mes "[Hein]";
		mes "让我看看……";
		mes "你赢了 " + shobu + " 次。";
		mes "你很擅长这个游戏！";
		mes "没错，你今天运气极佳！";
			next;

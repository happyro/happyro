		mes "[Hein]";
		mes "这是一张纸。";
		mes "我让你写时，就写“石头”“布”或“剪刀”。我也会写，最后比较结果，好吗？开始吧！";
		next;
		set .@npchand1,rand(1,3);
		set .@myhand1,select("剪刀:石头:布");
		if (((.@myhand1 == 1) && (.@npchand1 == 3)) || ((.@myhand1 == 2) && (.@npchand1 == 1)) || ((.@myhand1 == 3) && (.@npchand1 == 2))) {
			set .@shobu,.@shobu+1;

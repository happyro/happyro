	input .@reward;
	if (.@reward <= 0) {
		mes "[Givu]";
		mes "你取消了请求。";
		close;
	} else if (.@reward > 1500) {
		mes "[Givu]";
		mes "你已超过最大容量。";
		close;
	}
	if (arena_point < (.@reward * .@arena_point)) {
		mes "[Givu]";
		mes "你的竞技场积分不足。请查看当前积分总数。";
		close;
	}
	arena_point = arena_point - (.@reward * .@arena_point);
	getitem .@item_id,.@reward * .@amount;
	mes "[Givu]";
	mes "谢谢，请下次再来。";
	close;
}
// 切片行数保留

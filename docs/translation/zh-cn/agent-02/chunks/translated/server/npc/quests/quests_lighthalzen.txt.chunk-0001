// Cube Room Quest
//============================================================
lighthalzen,341,224,3	script	Fishbone	4_M_LGTGUARD,{
	// Quest is finished.
	if (MISC_QUEST&512) {
		mes "[Fishbone]";
		mes "哦，原来是你！听着，如果你想再次进入雷根贝勒，";
		mes "就得进入我东北方的那根下水道管道。虽然很恶心，但你必须进去……";
		next;
		mes "[Fishbone]";
		mes "总之，祝你在莱茵哈特顺利。还有，一定要小心！";
		mes "这座大城市里正发生比我更可疑的事情~";
		close;
	}
	// Apparently if the boss quest progress is at 6, you skip the level requirement.
	if (lhz_boss == 6 || BaseLevel >= 60) {
		if (lhz_sincube == 0) {
			mes "[Fishbone]";
			mes "什么……？我脸上有什么吗？别盯着我，让我工作。";
			lhz_sincube = 1;
			close;
		}
		if (lhz_sincube == 1) {
			mes "[Fishbone]";
			mes "嘿，喂你。你还在看我。别看了，我很忙，你妨碍到我了。";
			lhz_sincube = 2;
			close;
		}
		if (lhz_sincube == 2) {
			mes "[Fishbone]";
			mes "说真的，你开始让我火大了！你到底想从我这里得到什么？！";
			next;
			mes "[" + .@player_name$ + "]";
			mes "没什么。只是想看看你工作。";
			mes "你到底在做什么，嗯？";
			next;
			mes "[Fishbone]";
			mes "嘿！如果我能直接告诉你我在做什么，就不会介意你看了，对吧？";
			next;
			mes "[" + .@player_name$ + "]";
			mes "不……我只是觉得你平时就很紧张。";
			next;
			mes "[Fishbone]";
			mes "真是见鬼！你打算坐着看我一整天吗？！好，那我就无视你这个混蛋！";
			next;
			mes "[Fishbone]";
			mes "...";
			mes "......";
			mes "可恶！这真的让我很生气！你为什么不走开？！";
			next;
			mes "[" + .@player_name$ + "]";
			mes "嗯，我也想知道你为什么在这么……令人沮丧的地方工作。";
			next;
			mes "[Fishbone]";
			mes "好吧，行！但我告诉你这里的工作后，你就得离开！明白吗？";
			mes "现在，把嘴给我封严。看，我做的事有点违法。";
			next;
			mes "[Fishbone]";
			mes "我提供路线，让人们无需授权就能进入莱茵哈特，甚至前往城里的任何地方。";
			mes "见鬼，我甚至能让你进入那座实验室……";
			next;
			mes "[" + .@player_name$ + "]";
			mes "等、等等！实验室？！你是认真的吗？你能让我进去吗？";
			next;
			mes "[Fishbone]";
			mes "该死——你不会放过我，对吧？听着，你看起来还行，虽然有点固执。";
			mes "但我绝不信任或服务陌生人。";
			next;
			mes "[" + .@player_name$ + "]";
			mes "难道我不能做些什么，让你帮我进入实验室吗？";
			next;
			mes "[Fishbone]";
			mes "不可能。无论你怎么哀求，我都不会冒险相信想知道秘密路线的人。现在滚出去！";
			lhz_sincube = 3;
			close;
		}
		if (lhz_sincube == 3) {
			mes "[" + strcharinfo(0) + "]";
		mes "求你……告诉我怎样才能进入实验室。我……我求你了！";
			next;
			mes "[Fishbone]";
		mes "不！闭嘴，别再求了，好吗？";
		mes "你只是在自取其辱！天啊……";
			lhz_sincube = 4;
			close;
		}
		if (lhz_sincube == 4) {
			.@player_name$ = strcharinfo(0);
			mes "[" + .@player_name$ + "]";
		mes "你为什么不帮帮我？求求你~";
		mes "只有你知道方法~";
			next;
			mes "[Fishbone]";
		mes "啧，你这孩子真疯。听着，‘不’就是";
			mes "‘不。’就是这样。那就是";
		mes "最终答案。还要我解释多少次？";
			next;
			mes "[" + .@player_name$ + "]";
			mes "但我一定能做些什么，让你帮我吧？";
			mes "事、事情一直都是这样运作的。你不能——你不能……";
			next;
			mes "[Fishbone]";
			mes "好吧，你说服我了。";
			mes "但如果我要冒生命危险帮你进实验室，我要得到回报。明白吗？";
			next;
			mes "[Fishbone]";
			mes "你只需带着";
			mes "^FF000071,381,305,294,921,000 zeny^000000.";
			mes "回到这里。然后我会尽力帮助你。";
			mes "好了，祝你好运，勇敢的冒险者。";
			next;
			mes "[" + .@player_name$ + "]";
			mes "你在开玩笑吧？！";
			mes "我怎么可能弄到那么多 Zeny！我得至少征服世界，或者……";
			next;
			mes "[Fishbone]";
			mes "有道理。好吧，那个价格可能太高了。";
			mes "我就把它减半。还想要我的帮助吗？那就带来……";
			next;
			mes "[Fishbone]";
			mes " ";
			mes " ";
		mes "……^FF000020 个果冻^000000。";
			next;
			mes "[Fishbone]";
		mes "天啊。简直像是我在免费帮忙……";
			next;
			if (select( "好。", "不！不可能！" ) == 1) {
				mes "[Fishbone]";
				mes "好，那就带回总共 20 个果冻。";
				mes "你身上必须正好有 20 个，明白吗？再见，朋友~";
				lhz_sincube = 5;
				setquest 12014;// More missions
				close;
			}

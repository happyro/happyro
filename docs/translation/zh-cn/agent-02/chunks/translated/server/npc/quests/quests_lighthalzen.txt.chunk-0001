			mes "[Fishbone]";
			mes "你说什么——";
			mes "好了，现在是你在开玩笑。";
			mes "听着，要么带来 20 个果冻，要么带来我说的那个数量的 Zeny！";
			close;
		}
		if (lhz_sincube == 5) {
			mes "[Fishbone]";
			mes "那么……你把东西带来了吗？";
			next;
			switch( select( "我还在努力。", "给你！", "呃……东西？" ) ) {
			case 1:
				mes "[Fishbone]";
				mes "还在努力？好吧，我知道我没要求太多，";
				mes "但请尊重我，认真对待！只是 20 个果冻而已！";
				close;
			case 2:
				if (countitem(909) < 20) {
					mes "[Fishbone]";
					mes "呃……我说的是 20 个果冻，对吧？";
					mes "这不够，朋友，再去弄一些来！";
					close;
				}
				mes "[Fishbone]";
				mes "哦，干得好。看来你是可靠的人。";
				mes "一言为定，我告诉你如何进入实验室。";
				next;
				mes "[Fishbone]";
				mes "你可能奇怪我为什么愿意帮你，";
				mes "因为我以前在实验室工作……但他们不公平地解雇了我。";
				next;
				mes "[Fishbone]";
				mes "总之，只要能给他们找麻烦，我都愿意。";
				mes "让我准备一些东西，然后告诉你真正需要知道的事。";
				delitem 909,20;// Jellopy
				lhz_sincube = 6;
				close;
			case 3:
				mes "[Fishbone]";
				mes "什么……？你怎么能忘记这种事？";
				mes "总之，我让你带 20 个果冻。";
				close;
			}
		}
		if (lhz_sincube == 6) {
			mes "[Fishbone]";
			if (lhz_boss == 6) {
				mes "进入雷根贝勒实验室的方法。";
				mes "不过我知道一座秘密迷宫，应该能带你到那里。";
				mes "如果你愿意并准备出发……";
			}
			else {
				mes "好……现在准备好了吗？";
				mes "我会把你送到能找到实验室入口的地方。";
			}

			sc_start SC_STONE,4000,0;
			end;
		case 4:
			sc_start SC_SLEEP,4000,0;
			end;
		case 6:
			sc_start SC_FREEZE,4000,0;
			emotion ET_PROFUSELY_SWEAT, playerattached();
			end;
		case 8:
			sc_start SC_STUN,4000,0;
			end;
		case 10:
			sc_start SC_CURSE,80000,0;
			end;
	}
}

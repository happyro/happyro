-	script	Trap#tt_main	-1,{
OnTouch_:
	if (rand(1,3) == 1) {
		set .@w$,callfunc("F_tt");
		cutin "kafra_03",2;
		mes "^4d4dff艾尔迪巴兰";
		mes "Turbo Track";
		mes "由";
		mes "^800000卡普拉公司^4d4dff 提供。^000000";
		next;
		mes "^4d4dff祝今天所有 Turbo Track 参赛者好运，";
		mes "并衷心感谢大家使用";
		mes "卡普拉服务。^000000";
		next;
		mes "^800000卡普拉公司^4d4dff 多年来一直为尊贵的顾客提供仓库服务、";
		mes "保存点服务和传送服务。^4d4dff 听听这些真实顾客的评价……^000000";
		next;
		if (.@w$ == "e4") {
			mes "^4d4dff[卡秋娅]";
			mes "没错，他们提供最棒的仓库！";
			mes "连我的钻石都有足够空间存放！";
			mes " ";
			mes "[曼修斯长老]";
			mes "我爱你，卡普拉！^000000";
		} else if (.@w$ == "e8" || .@w$ == "n8") {
			mes "^4d4dff[艾伦黛]";
			mes "卡普拉小姐？太棒了！她们的服务也很好～！^000000";
			mes " ";
			mes "[特里斯坦三世]";
			mes "以我的王冠起誓！价格真低！";
		} else if (.@w$ == "e16" || .@w$ == "n16") {
			mes "^4d4dff[联盟职员凯]";
			mes "当然喜欢，尤其是他们的手推车服务～";
			mes " ";
			mes "[圣诞老人]";
			mes "呵呵呵！";
			mes "价格真喜庆！";
		} else if (.@w$ == "n4") {
			mes "^4d4dff[色诺芬·佐洛塔斯]";
			mes "没有卡普拉服务，我根本无法做生意。谢谢你，卡普拉！";
			mes " ";
			mes "[曼修斯长老]";
			mes "我爱你，卡普拉！^000000";
		} else {
			mes "^4d4dff[卡卡坦]";
			mes "我的家乡曾饱受糟糕服务之苦……直到卡普拉出现！";
			mes " ";
			mes "[馆长吉斯]";
			mes "啊，卡普拉就是最棒的！^000000";
		}			
		next;
		mes "^ff0000Turbo Track";
		mes "^ff0000诅咒沙漠中的陷阱！";
		mes "^4d4dff由 ^800000卡普拉公司^4d4dff 赞助";
		mes "‘我们永远在你身边。’^000000";
		close2;
		cutin "kafra_03",255;
		end;
	}
	sc_start SC_CONFUSION,4000,0;
	end;
}

//= Eden Group Quests - Common NPCs
//===== By: ================================================== 
//= L0ne_W0lf
//===== Current Version: ===================================== 
//= 2.0
//===== Compatible With: ===================================== 
//= rAthena Project
//===== Description: ========================================= 
//= Eden Group Headquarter NPC's.
//===== Additional Comments: ================================= 
//= 1.0 First Version.
//= 1.1 Removed showevent use, and use of duplicates.
//=     Commented out warps that should not be active.
//= 1.2 Reduced 300+ copy-paste lines to 1 duplicated NPC. [Brian]
//= 1.3 Some little optimization here and there. [Masao]
//= 1.4 Updated to match the new Izlude Map. [Masao]
//= 1.5 Added some missing Eden Group Teleport Officers. [Masao]
//= 1.6 Added Izlude RE coordinates. [Euphy]
//= 1.7 Added Malaya teleporter. [Euphy]
//= 1.8 Updated to match the latest official script. [Euphy]
//= 1.9 Added support to Para_Team_Mark_ in Eden Group. [AtlantisRO/Ragno]
//= 2.0 Added use of F_HasEdenGroupMark function. [Ragno]
//============================================================

// Common NPCs :: lv_tre
//============================================================
moc_para01,27,35,5	script	Secretary Lime Evenor	4_F_EDEN_OFFICER,{
	if (checkweight(1201,1) == 0 || (MaxWeight - Weight) < 2000) {
		mes "- 请稍等！！-";
		mes "- 你目前携带了-";
		mes "- 太多物品。-";
		mes "- 请再试一次-";
		mes "- 减轻负重后。-";
		close;
	}
	if (countitem(6219) > 0) {
		mes "[莱姆·伊维诺]";
		mes "多亏许多冒险者造访伊甸园集团，我们最近为访客准备了新版伊甸园集团徽章。";
		mes "旧版伊甸园集团徽章也可以兑换成新版。";
		next;
		mes "[莱姆·伊维诺]";
		mes "虽然会有轻微延迟，但新版伊甸园集团徽章会将你送回当前保存的位置。";
		mes "想兑换你的徽章吗？";
		next;
		if (select("好的:不用了。") == 2){
			mes "[莱姆·伊维诺]";
			mes "你有什么理由……不愿意兑换？";
			close;
		}
		delitem 6219,1;
		getitem 22508,1;
		mes "[莱姆·伊维诺]";
		mes "给你。欢迎再次光临～";
		close;
	}
	mes "[莱姆·伊维诺]";
	mes "追逐梦想与浪漫的人，请听我说。我们是名为“伊甸园”的乐园代表，也就是伊甸园集团。这里是独一无二的地方。";
	mes "你好。我能帮助你吗？";
	next;
	while (1) {
		switch (select("伊甸园集团是什么？：加入伊甸园集团：登记新任务：搜索任务：取消。")) {
		case 1:
			mes "[莱姆·伊维诺]";
			mes "伊甸园集团是帮助米德加尔特受苦人们的组织。";
			next;
			mes "[莱姆·伊维诺]";
		mes "如果有人需要帮助，我们会把事情贴在公告板上，介绍给热心帮助他人的成员。";
			next;
			mes "[莱姆·伊维诺]";
			mes "伊甸园成员会查看任务，并帮助发布任务的人。";
			mes "成员会为了奖励完成这些任务。";
			next;
			mes "[莱姆·伊维诺]";
		mes "如果你还不熟悉米德加尔特，这是探索世界的好方法。";
		mes "或者，如果你已经足够成熟，可以在完成任务时环游世界、结交新朋友。你的光荣之名会传遍各地。";
			next;
			break;
		case 2:
			if (!callfunc("F_HasEdenGroupMark")) {
				mes "[莱姆·伊维诺]";
				mes "只要向我登记，就能成为伊甸园成员。";
				mes "想加入伊甸园集团吗？";
				next;
				switch (select("是的，我想加入：不，我不想加入。")) {
				case 1:
					mes "[莱姆·伊维诺]";
					mes "好的。太棒了！请在这里写下你的名字。";
					input .@input$;
					next;
					mes "[莱姆·伊维诺]";
					mes "写完了吗？";
					mes "让我看看。";
					next;
					mes "[莱姆·伊维诺]";
					mes "你的名字是^3131FFBo"+.@input$+"Ba^000000……？对吗？";
					mes "咦？不是吗？？";
					next;
					emotion ET_SWEAT;
					mes "[莱姆·伊维诺]";
					mes "嗯，那不是你写的？";
					mes "好吧，嗯，似乎有点难读。";
					next;
					mes "[莱姆·伊维诺]";
					mes "请再写一次名字好吗？请^3131FF清楚地^000000写。";
					input .@input$;
					next;
					mes "[莱姆·伊维诺]";
					mes "啊～哈。你是^3131FF"+strcharinfo(0)+"^000000。";
					mes "这次我写对了。";
					next;
					emotion ET_BEST;
					mes "[莱姆·伊维诺]";
					mes "我们已经把你的名字写进名单。";
					mes "欢迎加入伊甸园集团，新成员！";
					next;
					mes "[莱姆·伊维诺]";
					mes "希望你能作为伊甸园成员做出优秀的工作。";
					getitem 22508,1; //Para_Team_Mark_
					next;
					break;
				case 2:
					mes "[莱姆·伊维诺]";
					mes "你对伊甸园集团还有问题吗？";
					next;
					break;
				}
			} else {
				mes "[莱姆·伊维诺]";
				mes "你已经是伊甸园集团成员。";
				next;
			}
			break;
		case 3:
			mes "[莱姆·伊维诺]";
			mes "想登记一些希望我们完成的任务吗？";
			next;
			if(select("是的，我想登记：不，我不想。") == 1) {
				mes "[莱姆·伊维诺]";
					mes "好的。请在上面写下你的名字。";
				input .@input$;
				next;
				mes "[莱姆·伊维诺]";
				mes "^3131FF"+strcharinfo(0)+"^000000.. Is that your name?";
					mes "嗯，你的字迹不清楚。我看不懂。";
				next;
				mes "[莱姆·伊维诺]";
				mes "^3131FF"+strcharinfo(0)+"^000000, tell me what you want to register for.";
				mes "我们应该去哪个地图？";
				input .@input$;
				next;
				mes "[莱姆·伊维诺]";
				mes "^3131FFMission Map: "+.@inputstr$+"^000000";
				mes "嗯，我会记下。";
				next;
				mes "[莱姆·伊维诺]";
				mes "请告诉我你在寻找什么类型的任务。";
				mes "应该简短些，比如“猎杀10只波利”。";
				input .@input$;
				next;
				mes "[莱姆·伊维诺]";
				mes "写完了吗？";
				mes "让我检查一下。";
				next;
				mes "[莱姆·伊维诺]";
					mes "咦…………";
				next;
				mes "[莱姆·伊维诺]";
					mes "嗯……什么？？………………";
				next;
				emotion ET_THINK;
				mes "[莱姆·伊维诺]";
				mes "我想你应该先完成我们的一项任务，再接新的任务。";
				next;
				emotion ET_HNG;
				mes "[莱姆·伊维诺]";
				mes "^3131FFClient: Lime Evenor^000000";
				mes "^3131FF任务：练习一个月的书写。^000000";
				mes "你的字迹实在太差了！";
				next;
				mes "[莱姆·伊维诺]";
				mes "^3131FFMission:"+.@input$+"^000000";
				mes "总之，你已经完成新任务登记。";
				next;
				mes "[莱姆·伊维诺]";
				mes "任务已经满额。你必须等空出位置。";
				mes "请耐心等待轮到你。";
				next;
			}
			break;
		case 4:
			if (callfunc("F_HasEdenGroupMark")) {
				mes "[莱姆·伊维诺]";
				mes "想以伊甸园成员身份尝试一些任务吗？";
				next;
				mes "[莱姆·伊维诺]";
				mes "查看公告板右侧，那里有各种任务等着你。";
				mes "请仔细阅读任务列表和资格要求，选择其中一项。";
				next;
			}
			else {
				mes "[莱姆·伊维诺]";
				mes "想做任务，必须先加入伊甸园集团。";
				close;
			}
			break;
		case 5:
			mes "[莱姆·伊维诺]";
			mes "有问题请再来。";
			close;
		}
	}
	close;
}

-	script	Eden Teleport Officer#0::eto	-1,{
	mes "[伊甸园传送人员]";
	mes "那些在这个奇怪世界里漫无目的游荡的人听着，来找我吧！";
	mes "伊甸园集团会帮助你，为你展示美好的未来。";
	next;
	mes "[伊甸园传送人员]";
	mes "你无事可做，只能浪费时间吗？";
	mes "你想做好事，却没人给你工作吗？";
	mes "想成为解决问题的人吗？";
	mes "伊甸园集团可以解决你的问题。";
	next;
	switch (select("前往伊甸园集团：不想再说话了。")) {
	case 1:
		mes "[伊甸园传送人员]";
		mes "去我们的秘密基地吧！";
		set nak_warp,strnpcinfo(2);
		close2;
		warp "moc_para01",31,14;
		end;
	case 2:
		mes "[伊甸园传送人员]";
		mes "如果不知道未来该做什么，不要犹豫，来找我聊聊吧！好吗？";
		close;
	}
}

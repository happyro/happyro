	end;
}

moc_para01,47,39,3	script	#warp_2_pass	111,{
	if (callfunc("F_HasEdenGroupMark")) {
		mes "[Lime Evenor]";
		mes "哦，这里是伊甸园成员专属的地方。";
		mes "如果你是成员，随时都可以来！";
		next;
		switch (select("进入：不进入。")) {
		case 1:
			mes "这扇门装饰得很漂亮，但似乎有点太沉重。";
			close2;
			warp "moc_para01",106,14;
			end;
		case 2:
			mes "[Lime Evenor]";
			mes "好吧，既然你没兴趣。";
			close;
		}
	}
	mes "[Lime Evenor]";
	mes "哦，这里只对伊甸园成员开放。";
	mes "想进去就必须加入伊甸园集团。";
	close;
}

moc_para01,16,22,7	script	Old Adventurer#eden	900,{
	mes "[老冒险者]";
	mes "哼，就算看起来老，我也很强！她叫什么？莱姆·伊维诺？她完全无视我，好像我是个老糊涂蛋。";
	next;
	mes "[老冒险者]";
	mes "我来这里是为了加入伊甸园集团！我不该受到这种待遇！";
	mes "你也觉得我看起来老糊涂吗？";
	close;
}

moc_para01,182,48,3	script	Eden's Chief#eden	886,{
	set .@eggf,rand(1,118);
	set .@eggf_1,.@eggf + 1;
	set .@eggf_2,.@eggf + 2;
	set .@eggf_6,.@eggf + 6;
	mes "[伊甸园主管]";
	mes ""+.@eggf+".. "+.@eggf_1+"... "+.@eggf_2+".... "+.@eggf_6+"..?";
	next;
	emotion ET_CRY;
	mes "[伊甸园主管]";
	mes "哦，糟糕！我煎了多少个蛋？";
	mes "啊！！！我完全忘了！得重新数一遍！";
	next;
	emotion ET_CRY;
	mes "[伊甸园主管]";
	mes "你为什么让我做这个？这是什么任务？";
	next;
	emotion ET_CRY;
	mes "[伊甸园主管]";
	mes "你打算拿那些煎蛋做什么？你肯定吃不完。你只是想烦我，对吧？";
	close;
}

moc_para01,172,28,5	script	Eden's Intern#eden	883,{
	mes "[伊甸园实习生]";
	mes "其实，我意识到了。";
	next;
	mes "[伊甸园实习生]";
	mes "除非你想失败，否则必须非常努力地工作。";
	next;
	mes "[伊甸园实习生]";
	mes "但是，我还没学过药剂学。";
	next;
	mes "[伊甸园实习生]";
	mes "我要失败了。我做不到。";
	close;
}

moc_para01,20,35,5	script	Office Assistant Neede	814,{
	mes "[尼迪]";
	mes "我几年前成为伊甸园成员，但感觉就像昨天一样。";
	mes "我一直在做很多工作，甚至没注意自己在这里度过了多少年。";
	next;
	mes "[尼迪]";
	mes "这让我想起每天都像一场战争。";
	next;
	mes "[尼迪]";
	mes "^3131FF右侧餐厅^000000的主管";
	mes "每次做饭都放太多调味料，气味弥漫整个大厅。我们必须经常开窗，因为实在受不了这味道！";
	next;
	mes "[尼迪]";
	mes "你看到^3131FF大厅北侧^000000交叉口的^3131FF健身房^000000了吗？他们锻炼时总是大喊，我在这里都听得到！";
	next;
	emotion ET_ANGER;
	mes "[尼迪]";
	mes "另外，^3131FF二楼^000000那个奇怪女孩一直在哭。她的哭声让我抓狂。";
	next;
	mes "[尼迪]";
	mes "啊，那个奇怪女孩其实是我们的老板……";
	next;
	mes "[尼迪]";
	mes "我不知道她在做什么。但她总是哭喊。哦，有时我会听到“砰！”的巨大声响……不知道从哪里传来的。";
	next;
	emotion ET_HUK;
	mes "[尼迪]";
	mes "等等！";
	mes "嘘！这是秘密，不能告诉任何人！";
	next;
	mes "[尼迪]";
	emotion ET_OHNO;
	mes "我不信任伊维诺。她从不表露感情……她会向老板告我的状。";
	next;
	emotion ET_HNG, getnpcid(0, "Secretary Lime Evenor");
	mes "[Lime Evenor]";
	mes "我不是那种女孩。";
	next;
	emotion ET_KEK;
	mes "[尼迪]";
	mes "咦？你听到了吗？天啊～！";
	close;
}

function	script	F_HasEdenGroupMark	{
	return (countitem(6219) > 0 || countitem(22508) > 0);
}

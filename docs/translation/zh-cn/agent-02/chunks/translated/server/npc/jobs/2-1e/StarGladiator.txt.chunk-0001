payon,215,102,3	script	Moohyun#job_star	828,3,3,{
	if (Class == Job_Taekwon) {
		if (STGL_Q == 0) {
			mes "[武贤]";
			if (Sex == SEX_MALE)
				mes "嘿，跆拳男孩！";
			else
				mes "嘿，跆拳女孩！";
			mes "过来一下。";
			mes "如果你愿意听，";
			mes "我有个提议给你！";
			next;
			if (select( "好啊。","不用了，谢谢！") == 1) {
				mes "[武贤]";
				mes "好，孩子。";
				mes "你叫什么名字？";
				next;
				mes "[" + strcharinfo(0) + "]";
				mes "" + strcharinfo(0) + ".";
				next;
				mes "[武贤]";
				mes "真是的，你太直接了。";
				mes "多一点热情和友善，";
				mes "又不会害了你，对吧？";
				mes "总之，你有没有想过";
				mes "自己想成为什么？";
				next;
				mes "[武贤]";
				mes "如果你还没决定，为什么不成为";
				mes "^4D4DFF太阳、月亮和星星的战士^000000？考虑一下吧。";
				next;
				mes "[" + strcharinfo(0) + "]";
				mes "什么战士——？";
				mes "我从没听说过这个职业。";
				mes "但我知道自己可以转职为";
				mes "灵魂行者或跆拳宗师。";
				next;
				mes "[武贤]";
				mes "是啊，没错。";
				mes "跆拳宗师是太阳、月亮和星星的战士，";
				mes "掌握宇宙的力量！";
				mes "很酷吧？总之，你对成为跆拳宗师感兴趣吗？";
				next;
				if (select("是的！:没那么感兴趣。") == 1) {
					if (JobLevel > 39) {
						mes "[武贤]";
						mes "太好了～我就知道你会同意。";
						mes "好，你看起来已经准备好了。";
						mes "现在只需要找人训练你成为跆拳宗师。";
						next;
						mes "[武贤]";
						mes "你想^4D4dff转职为跆拳宗师^000000吗？";
						mes "我会介绍能帮助你实现目标的人。";
						next;
						if (select("是的。","让我考虑一下……") == 1) {
						mes "[武贤]";
						mes "太好了！如你所料，跆拳宗师没有正式公会。";
						mes "我们不容易聚集，但规则更少、自由更多。";
							next;
						mes "[武贤]";
						mes "现在谁在附近……？嗯……";
						mes "你应该去找^4D4DFF武刚^000000。";
						mes "他是少数愿意接收新学生的";
						mes "跆拳宗师，一定会指导你的训练。";
							next;
						mes "[武贤]";
						mes "你可以在科莫多找到武刚，";
						mes "据说他在最接近天空的地方。";
						mes "我会写一封推荐信，替你寄给他。";
							set STGL_Q,1;
							setquest 7007;
							close;
						}
						mes "[武贤]";
						mes "没关系。转职是重要决定，";
					mes "所以你要慎重考虑一切。但我可以向你保证，";
					mes "成为伟大的宇宙战士绝不会让你后悔！";
						close;
					}
					mes "[Moohyun]";
					mes "很好，很好～";
					mes "但首先，";
					mes "职业等级至少要达到 40，";
					mes "才能开始跆拳宗师训练。否则，";
					mes "你会难以理解。";
					next;
					mes "[Moohyun]";
					mes "我知道你做得到，";
					mes "也不会花太久。答应我";
					mes "你会回来，让我帮助你成为";
					mes "伟大的跆拳宗师～";
					close;
				}
				mes "[Moohyun]";
				mes "真的吗？不过我仍认为你";
				mes "比起灵魂行者更适合";
				mes "成为跆拳宗师。";
				mes "但最终决定权在你。";
				next;
				mes "[武贤]";
				mes "如果你改变主意，回来告诉我。";
				mes "只要真正努力，你一定能成为";
				mes "优秀的跆拳宗师。";
				close;
			}
			mes "[武贤]";
			mes "哎，别这样。";
			mes "听我说又不会花你一枚 Zeny。";
			mes "来，听我讲完……";
			close;
		}
		else if (STGL_Q == 1) {
			mes "[武贤]";
			mes "我已经把你的推荐信寄给他了，";
			mes "去科莫多找武刚吧。";
			mes "他会开始训练你成为跆拳宗师。";
			close;
		}
		else if (STGL_Q == 7) {
			mes "[武贤]";
			mes "测试进行得怎么样？";
			mes "嘿，你看起来很担心。";
			mes "遇到什么麻烦了吗？";
			next;
			if (select("不，我没事。:关于贝里尤的谜语……") == 1) {
				mes "[武贤]";
				mes "独立解决问题很好，";
				mes "但真正需要时也应寻求帮助。";
				mes "无法独自完成某事并不可耻……";
				close;
			}
			mes "[武贤]";
			mes "啊，是那个。贝里尤给了你谜语。";
			mes "首先，你必须带给他非常重要的东西，";
			mes "但它不是物质物品。";
			next;
			mes "[武贤]";
			mes "你必须向他证明某件事。";
			mes "告诉我，当你面对生活困难和目标障碍时，";
			mes "你会如何回应？内心有什么感受？";
			next;
			mes "[武贤]";
			mes "我知道贝里尤要求你证明耐心，";
			mes "但这才是耐心背后最重要的因素。";
			mes "当生活看似无望时，你会对自己说什么？";
			next;
			if (select("我不会放弃！:我……我不知道？") == 1) {
				mes "[" + strcharinfo(0) + "]";
				mes "我不会放弃！";
				mes "无论需要多久，";
				mes "我都会让梦想成真！";
				next;
				mes "[武贤]";
				mes "没错，就是这样！";
				mes "当决心由钢铁般的意志支撑，";
				mes "你就能耐心面对一切。";
				mes "向贝里尤展示你的决心……";
				next;
				mes "[武贤]";
				mes "很好，我想你准备好了。";
				mes "去找武刚，然后回月之房。";
				mes "很快，也许我们就能以跆拳宗师的身份相见！";
				set STGL_Q,8;
				close;
			}
			mes "[武贤]";
			mes "你……你不知道？";
			mes "如果你正面面对障碍，";
			mes "直接面对恐惧、敌人和人生挑战，答案自然会出现。";
			next;
			mes "[武贤]";
			mes "嗯……";
			mes "不妨花点时间思考勇气的价值？";
			mes "是的，那现在可能很有用。";
			close;
		}
		else if (STGL_Q == 8) {
			mes "[武贤]";
			mes "很好，我想你准备好了。";
			mes "去找武刚，然后回月之房。";
			mes "很快，也许我们就能以跆拳宗师的身份相见！";
			close;
		}
		mes "[武贤]";
		mes "最近过得怎么样？";
		mes "我相信你会成为优秀的跆拳宗师，";
		mes "所以对你期待很高。";
		close;
	}
	else if (BaseJob == Job_Star_Gladiator) {
		mes "[武贤]";
		mes "嘿，最近怎么样？";
		mes "看来你已经与自然相合。";
		mes "嘿嘿，宇宙不是很奇妙吗？";
		close;
	}
	else if (Class== Job_Novice) {
		mes "[武贤]";
		mes "嘿，孩子。你想学习";
		mes "跆拳道吗？";
		mes "学会它，你一定会";
		mes "变得更强！";
		next;
		mes "[武贤]";
		mes "让我想想……";
		mes "有个叫菲尼克斯的人";
		mes "可以教你跆拳道。";
		mes "他应该就在附近……";
		next;
		mes "[武贤]";
		mes "总之，学习一段时间跆拳道后，";
		mes "如果你想继续深造，";
		mes "掌握超越身心的力量，";
		mes "就回来找我。";
		close;
	}
	mes "[Moohyun]";
	mes "伙计……";
	mes "你想要什么？";
	if (Sex == SEX_MALE) {
		mes "你想加入我的武术学校？";
		mes "对你来说太晚了，";
		mes "抱歉，朋友～";
	}
	else {
		mes "哦，我没注意到——";
		mes "你、你是位美丽的女士！";
		mes "我想我应该为无礼道歉。";
	}
	next;
	mes "[武贤]";
	mes "总之，如果你觉得我只是个小混混，";
	mes "我承认自己的外表和行为确实像。";
	mes "但实际上，我是太阳、月亮和星星的战士。";
	next;
	mes "[武贤]";
	mes "对你来说可能有点晚了，";
	mes "但如果你认识想成为跆拳宗师的人，";
	mes "就把他们带来。我会确保他们遇到合适的人～";
	close;

OnTouch_:
	if (Class == Job_Taekwon) {
		if (STGL_Q == 0) {
			mes "[武贤]";
			mes "嗯……？哦，你正是我";
			mes "要找的那种人。来吧，";
			mes "如果愿意听，我有个提议……";
			close;
		}
	}
	else if (BaseJob == Job_Star_Gladiator) {
		mes "[武贤]";
		mes "怎么样，战士？";
		mes "继续为正确的事业使用你的技能。";
		mes "为所有跆拳宗师带来荣耀！";
		close;
	}
	mes "[武贤]";
	mes "哇，哇～";
	mes "让开，好吗？";
	mes "你挡住我的太阳了！";
	close;
}
	
comodo,172,230,3	script	Wandering Master#job_sta	730,{
	if (Class == Job_Taekwon) {
		if (STGL_Q == 1) {
			mes "[武刚]";
			mes ""+ strcharinfo(0) + "...";
			mes "我一直在等你。";
			mes "武贤告诉我你会来，";
			mes "以及你想成为跆拳宗师的愿望。";
			mes "我相信他的判断……";
			next;
			mes "[武刚]";
			mes "是的，武贤擅长辨识他人的内在力量。";
			mes "你应该会表现得很好。";
			mes "准备好进行第一项测试了吗？用拳脚";
			mes "为伟大的宇宙服务。";
			next;
			if (select("是的，让我参加测试！:等等，我需要考虑一下！") == 1) {
				if (SkillPoint) {
					mes "[武刚]";
					mes "嗯？你还有尚未分配的技能点。";
					mes "先使用技能点，学习并提升";
					if (Sex == SEX_FEMALE)
						mes "你的跆拳女孩技能";
					else
						mes "你的跆拳男孩技能";
					mes "。完成后回来接受训练。";
					close;
				}
				mes "[武刚]";
				mes "跆拳道奠定基础。";
				mes "心、身、魂不是分离的部分，而是一个整体。";
				mes "你与自己相连，但是否也与外部世界相连？";
				next;
				mes "[武刚]";
				mes "闭上眼睛，感受风的气息。";
				mes "张开双臂拥抱天空。";
				mes "你能感受到吗？那是宇宙";
				mes "无边无际的流动。";
				next;
				mes "[武刚]";
				mes "自然法则不可违背，但随着你对自然的理解加深，";
				mes "你将能够掌握阳光、拥抱月光、塑造星光。";
				mes "这项测试会帮助你调和自身……";
				next;
				mes "[武刚]";
				mes "出发，收集散布世界各处的自然力量。";
				mes "带给我狂风、坚实大地、";
				mes "冰冷寒冰和燃烧火焰的碎片。";
				next;
				mes "[武刚]";
				mes "换句话说……";
				mes "^4D4DFF粗糙的风^000000、^4D4DFF大自然^000000、";
				mes "^4D4DFF神秘的冰冻^000000和^4D4DFF火焰之心^000000。";
				mes "现在出发……";
				set STGL_Q,2;
				changequest 7007,7008;
				close;
			}
			mes "[武刚]";
			mes "我尊重你的决定，虽然我不明白你为何犹豫。";
			mes "但就像月相一样，一切变化都必须遵循宇宙的安排。";
			close;
		}
		else if (STGL_Q == 2) {
			if (countitem(996) > 0 && countitem(997) > 0 && countitem(995) > 0 && countitem(994) > 0) {
				mes "[Moogang]";
				mes "啊，你完成了我交给你的";
				mes "任务。很好。现在，拿着这些";
				mes "风、大地、冰与火的碎片时，";
				mes "你感受到它们之间的";
				mes "联系了吗？";
				next;
				mes "[武刚]";
				mes "风能带来温柔舒适的微风，";
				mes "也能带来破坏性的飓风。";
				mes "大地是万物生活的坚实根基，";
				mes "但也会下沉、震动建筑。";
				next;
				mes "[武刚]";
				mes "水赋予生命，也带来清凉，";
				mes "但也会淹没、冻结生命。";
				mes "火能带来温暖，";
				mes "也能把生命化为灰烬。";
				mes "这就是自然。";
				next;
				mes "[武刚]";
				mes "这就是自然的力量。";
				mes "任何力量都能行善或作恶，";
				mes "取决于你如何使用。";
				mes "现在明白了吗？这就是宇宙彼此交织的方式。";
				next;
				mes "[武刚]";
				mes "然而，宇宙最原始、最纯粹的元素";
				mes "就是太阳、月亮和星星。";
				mes "花点时间思考这个真理……";
				next;
				mes "[武刚]";
				mes "理解宇宙的本质，";
				mes "就会尊重自然与万物。";
				mes "当你准备好下一项测试时，";
				mes "我会带你前往祭坛。";
				delitem 996,1; //Rough_Wind
				delitem 997,1; //Great_Nature
				delitem 995,1; //Mistic_Frozen
				delitem 994,1; //Flame_Heart
				set STGL_Q,3;
				changequest 7008,7009;
				close;
			}
			mes "[武刚]";
			mes "作为成为跆拳宗师之旅的第一项测试，";
			mes "带给我自然元素的碎片。";
			mes "我希望你理解它们与生俱来的和谐。";
			next;
			mes "你能感受自然力量";
			mes "在宇宙中不断扩散的流动吗？";
			next;
			mes "[武刚]";
			mes "自然法则不可违背，";
			mes "但随着你对自然的理解加深，你将能够掌握";
			mes "阳光、持握月光、塑造星光。这项测试将";
			mes "帮助你与自然协调……";
			next;
			mes "[武刚]";
			mes "去收集散落世界各处的";
			mes "自然力量。带来";
			mes "狂风、坚实大地、";
			mes "冻结之冰和燃烧之火的碎片。";
			next;
			mes "[武刚]";
			mes "换句话说……";
			mes "^4D4DFF粗糙的风^000000、";
			mes "^4D4DFF大地之精华^000000、";
			mes "^4D4DFF神秘冰晶^000000和";
			mes "^4D4DFF火焰之心^000000。";
			mes "现在出发吧……";
			set STGL_Q,2;
			changequest 7007,7008;
			close;
		}
		mes "[武刚]";
		mes "我尊重你的决定，";
		mes "虽然我不明白你为何犹豫。";
		mes "但就像月相一样，一切变化都必须遵循宇宙的安排。";
		close;
	}
	else if (STGL_Q == 2) {
		if (countitem(996) > 0 && countitem(997) > 0 && countitem(995) > 0 && countitem(994) > 0) {
			mes "[武刚]";
			mes "啊，你完成了我交给你的";
			mes "任务。很好。现在，拿着这些";
			mes "风、大地、冰与火的碎片时，";
			mes "你感受到它们之间的联系了吗？";
			next;
			mes "[武刚]";
			mes "风能带来温柔舒适的微风，";
			mes "也能带来破坏性的飓风。大地";
			mes "是万物生活的坚实根基，";
			mes "但也会下沉、震动建筑。";
			next;
			mes "[武刚]";
			mes "水赋予生命并带来清凉，";
			mes "但也会淹没、冻结生命。火能带来温暖，";
			mes "也能把生命化为灰烬。这就是自然。";
			next;
			mes "[武刚]";
			mes "这就是自然的力量。";
			mes "任何力量都能行善或作恶，";
			mes "取决于你如何使用。现在明白了吗？";
			mes "这就是宇宙彼此交织的方式。";
			next;
			mes "[武刚]";
			mes "然而，宇宙最原始、最纯粹的元素";
			mes "就是太阳、月亮和星星。";
			mes "花点时间思考这个真理……";
			next;
			mes "[武刚]";
			mes "理解宇宙的本质，";
			mes "就会尊重自然与万物。";
			mes "当你准备好下一项测试时，";
			mes "我会带你前往祭坛。";
			delitem 996,1; //Rough_Wind
			delitem 997,1; //Great_Nature
			delitem 995,1; //Mistic_Frozen
			delitem 994,1; //Flame_Heart
			set STGL_Q,3;
			changequest 7008,7009;
			close;
		}
		mes "[武刚]";
		mes "作为成为跆拳宗师之旅的第一项测试，";
		mes "带给我自然元素的碎片。";
		mes "我希望你理解它们与生俱来的和谐。";
		next;
		// 切片行数保留
		// 切片行数保留
		// 切片行数保留
		// 切片行数保留
		// 切片行数保留

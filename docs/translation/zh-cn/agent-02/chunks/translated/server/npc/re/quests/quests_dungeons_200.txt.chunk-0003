nif_dun01,140,202,3	script	Piano#lv200	CLEAR_NPC,{
	if (isbegin_quest(8647) == 1) {
		mes "我什么也听不见，但周围的死者似乎一片骚动。";
		mes "去向米拉报告吧。";
		completequest 8647;
		setquest 8649;
		npctalk "叮叮……咔嚓！", "Piano#lv200", bc_self;
		npctalk "活人睡觉吧！咿呀！", "Exciting Cello#lv200", bc_self;
		npctalk "活人弹钢琴了！", "Dancing Cello#lv200", bc_self;
		npctalk "我的天，他真的不会弹……", "Quiet Cello#lv200", bc_self;
		npctalk "怎么会这样……", "Stranger Cello#lv200", bc_self;
		npctalk "你毁了气氛！", "Happy Cello#lv200", bc_self;
		npctalk "钢琴，呜哦！！！", "Serious Contrabass#lv2", bc_self;
		npctalk "钢琴被吓住了……", "Sleek Harp#lv200", bc_self;
		close;
	}
	// note: no text
	end;

OnInit:
	questinfo( QTYPE_DAILYQUEST, QMARK_YELLOW, "isbegin_quest(8647) == 1" );
	end;
}

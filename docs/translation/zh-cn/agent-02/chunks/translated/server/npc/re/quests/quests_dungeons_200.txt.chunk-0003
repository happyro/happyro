}


// amicitia1
ein_fild08,158,96,3	script	Lana#ami	4_M_ILYA,{
	if (BaseLevel < 215) {
		mes "[拉娜]";
		mes "前方很危险，只有达到一定等级的冒险者才能进入。";
		next;
		mes "- 该区域需要达到215级或更高等级才能进入。-";
		close;
	}
	mes "[拉娜]";
	mes "要前往阿米希提亚综合研究所一楼吗？";
	next;
	if (select( "Go", "Stay" ) == 2) {
		mes "[拉娜]";
		mes "好。祝你冒险愉快。";
		close;
	}
	mes "[拉娜]";
	mes "好。我会把你传送到阿米希提亚综合研究所。";
	close2;
	warp "amicitia1",242,244;
	end;
}

pub_cat,86,33,5	script	Ansuriya#ami	4_F_REBELLION2,{
	if (BaseLevel < 215) {
		mes "[安苏莉亚]";
		mes "哦，你就是上次行动的英雄。";
		mes "能在这里见到你真是荣幸。我可以请你喝一杯吗？";
		next;
		mes "- 该任务需要达到215级或更高等级才能进行。-";
		close;
	}
	if (isbegin_quest(16529) == 0) {
		mes "[安苏莉亚]";
		mes "哦，你就是上次行动的英雄。";
		mes "能在这里见到你真是荣幸。我可以请你喝一杯吗？";
		next;
		mes "[格尔贝娜]";
		mes "哇，" + strcharinfo(0) + "！可以给我签名吗？";
		mes "真是荣幸！嘿嘿～";
		next;
		mes "[安苏莉亚]";
		mes "请来一杯热带苏格拉德！";
		mes "哦，你能喝热带苏格拉德吗？";
		next;
		mes "[格尔贝娜]";
		mes "我喜欢巧克力牛奶。";
		next;
		mes "[安苏莉亚]";
		mes "你自己付钱。";
		mes "对了，格尔贝娜，阿米希提亚小队怎么样？";
		next;
		emotion ET_PROFUSELY_SWAT, getnpcid(0,"Gerbena#ami");
		mes "[格尔贝娜]";
		mes "这个嘛……我暂时整理完了。";
		mes "不过，成员总数太少，能够派出的反叛军确实有点不足。";
		next;
		mes "[安苏莉亚]";
		mes "嗯，我该怎么办？格尔贝娜，你想去吗？";
		next;
		emotion ET_SWEAT, getnpcid(0,"Gerbena#ami");
		mes "[格尔贝娜]";
		mes "啊，你看。光是这些工作人员就让我头疼。";
		next;
		mes "[安苏莉亚]";
		mes "我该怎么办？每层需要两支队伍……";
		next;
		emotion ET_AHA, getnpcid(0,"Gerbena#ami");
		mes "[格尔贝娜]";
		mes "你是英雄。";
		mes "能帮帮我们吗？";
		next;
		emotion ET_QUESTION;
		mes "[安苏莉亚]";
		mes "格尔贝娜，你突然在说什么啊！";
		next;
		mes "[格尔贝娜]";
		mes "不，英雄在上次行动中接受了与反叛军合作的任务。";
		mes "所以我在想，这次能不能再次请你帮忙……";
		next;
		emotion ET_SURPRISE;
		mes "[安苏莉亚]";
		mes "呃！好。";
		mes "冒险者，你觉得怎么样？";
		next;
		select( "Listen to what's going on..." );
	mes "[安苏莉亚]";
		mes "哦，对。就是这样。";
		mes "除此之外，我们在艾因布洛赫附近发现了一座新研究所。";
		next;
		mes "[安苏莉亚]";
		mes "它的名字是<FONT COLOR = 0000CD>阿米希提亚综合研究所</FONT>。根据雷根贝勒提供的资料，据说它是维尔纳研究所的姊妹研究所。";
		next;
	mes "[安苏莉亚]";
		mes "那里似乎没有进行特别非法的实验，而是专注于将奇美拉培育为炼金生物的研究，但据说地下魔力发电厂爆炸后，研究所就被废弃了。";
		next;
		mes "[安苏莉亚]";
		mes "由于那座废弃研究所的管理员之一是维尔纳，所以它受到了调查。";
		next;
	mes "[安苏莉亚]";
		mes "调查结果显示，培育中的奇美拉因爆炸事故失去控制，变成怪物后被弃置不管。";
		next;
		mes "[安苏莉亚]";
		mes "我无法判断这是疏于管理，还是故意为之。";
		next;
	mes "[安苏莉亚]";
		mes "那里离城市不远，所以反叛军出于安全考虑负责整理……正如你听说的，我们正为人手不足而苦恼。";
		next;
		mes "[格尔贝娜]";
		mes "有你的帮助，我们就能更轻松地清理那里！";
		next;
		mes "[安苏莉亚]";
		mes "好。你能帮我讨伐吗？";
		next;
		if (select( "Help", "Don't help" ) == 2) {
	mes "[安苏莉亚]";
			mes "啊……抱歉。";
			mes "这是我们的工作，我们只是想找人帮忙。";
			next;
	mes "[安苏莉亚]";
			mes "你一定也有自己的事情要做！";
			mes "我们会自己想办法解决。";
			close;
		}
		mes "[格尔贝娜]";
		mes "能和你一起工作是我们的荣幸！";
		next;
		mes "[安苏莉亚]";
		mes "谢谢你的合作！";
		mes "我们再重新组织队伍吧……";
		next;
		mes "[安苏莉亚]";
		mes "你更愿意独自执行任务，还是和反叛军任务队伍一起？";
		next;
		select( "I'm comfortable alone" );
		mes "[安苏莉亚]";
		mes "既然如此，就把反叛军任务队伍合并成一支，再安排英雄单独执行任务……嘀咕嘀咕。";
		mes "哦，为什么只有我一个人在想。格尔贝娜，帮帮我！";
		next;
		mes "[格尔贝娜]";
		mes "啊，对！";
		setquest 16529;
		completequest 16529;
		next;
	}
	mes "[安苏莉亚]";
	mes "英雄，这些是阿米希提亚想请你帮忙的事情。";
	mes "你想帮助哪一项？";
	next;
	switch( select( "土与火", "水与风", "维尔纳的踪迹", "不帮忙" ) ) {
	case 1:
		switch( checkquest(16530,PLAYTIME) ) {
		case -1:
			break;
		case 0:
		case 1:
			mes "[安苏莉亚]";
			mes "现在反叛军小队正在跟进处理。";
			mes "英雄，你可以再休息一会儿。";
			next;
			mes "[安苏莉亚]";
			mes "谢谢你积极帮助我们。";
			mes "天亮后可以再来吗？";
			close;
		case 2:
			erasequest 16530;
			break;
		}
		switch( checkquest(16531,HUNTING) ) {
		case -1:
			mes "[安苏莉亚]";
			mes "我想请你在培育中的奇美拉里猎捕<FONT COLOR = 0000CD>" + getmonsterinfo("CHIMERA_AMITERA", MOB_NAME) + "和" + getmonsterinfo("CHIMERA_FILLIA", MOB_NAME) + "</FONT>。";
			next;
			mes "[安苏莉亚]";
			mes "你马上就能认出它们，因为土和火的属性特征比现有个体强得多。";
			mes "实际上，它们更像怪物，而不是炼金生物……";
			next;
			mes "[安苏莉亚]";
			mes "尽管培育设施已经被破坏，个体数量仍在增加，所以想请你各猎捕15只左右！";
			next;
			if (select( "猎捕", "不猎捕" ) == 2) {
				mes "[安苏莉亚]";
				mes "嗯？你改变主意了吗？";
				next;
				mes "[安苏莉亚]";
				mes "好吧！我们得重新组织！唉。";
				mes "英雄，你不如冷静地再考虑一下？";
				close;
			}

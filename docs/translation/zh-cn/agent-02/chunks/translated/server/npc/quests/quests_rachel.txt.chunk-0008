// Donation Lottery Quest/High Priest Quest :: rachel_oz & rachel_ma1
//============================================================ 
ra_temple,119,180,0	script	Temple Entrance#ra_tem	45,1,1,{
OnTouch:
	if ($rachel_donate >= 10000) {
		if (MISC_QUEST & 8192) { warp "ra_temin",169,23; end; }

		if (ra_tem_q < 10) {
		mes "^3355FF神殿入口锁着。^000000";
			next;
		select("踢门。:用武器砸门。");
			emotion ET_HUK, getnpcid(0, "Nemma#ra_temple");
			mes "[Priestess Nemma]";
		mes "请不要这样做！";
			close;
		}
	}
	warp "ra_temin",169,23;
	end;
}

ra_temple,116,174,3	script	Nemma#ra_temple	920,{
	cutin "ra_nemma02",2;
	if ($rachel_donate < 10000) {
		if (ra_have_donated == 0) {
			cutin "ra_nemma03",2;
			mes "[Priestess Nemma]";
		mes "你好，冒险者。请问你今天为何来到神殿？";
			next;
			if (select("只是观光。:我是来祈祷的。") == 1) {
				cutin "ra_nemma01",2;
				mes "[Priestess Nemma]";
				mes "我想大多数外国人不熟悉我们的信仰，所以不会来这里祈祷……希望你在这里过得愉快，冒险者。";
				close3;
			}
			mes "[Priestess Nemma]";
			mes "哦！很高兴看到其他国家也信仰我们的精神。切斯赫鲁姆尼尔神殿将举办节日。";
			next;
			cutin "ra_nemma01",2;
			mes "[Priestess Nemma]";
			mes "我们正在为节日接受捐赠，如果你愿意捐助我们将非常感激。无论如何，欢迎和我们一起庆祝女神的恩典。";
			emotion ET_DELIGHT;
			next;
			mes "[Priestess Nemma]";
			mes "有位大祭司反对向神殿信徒收钱，但是否捐赠由你决定。捐赠还有机会赢得奖品！";
			next;
			mes "[Priestess Nemma]";
			mes "你可以用彩票从神殿仓库赢取好东西。每张彩票需捐赠 50,000 Zeny，这也是最低捐款金额。";
			next;
			cutin "ra_nemma03",2;
			mes "[Priestess Nemma]";
			mes "给捐赠者的奖品也是随机选择的，所以我无法告诉你会得到什么。你有兴趣捐赠吗？";
			next;
			if (select("不用了，谢谢。:当然。") == 1) {
				cutin "ra_nemma01",2;
				mes "[Priestess Nemma]";
			mes "我明白了。也许下次吧。愿芙蕾雅保佑你的旅程，愿女神恩典永远支持我们所做的一切~";
				close3;
			}
			mes "[Priestess Nemma]";
			mes "太好了！你想捐多少？我们只能接受 50,000 Zeny 的倍数，单次最多 150,000 Zeny。有点复杂，我知道……";
			next;
			switch(select("50,000z - 1 Lottery Ticket:100,000z - 2 Lottery Ticket:150,000z - 3 Lottery Ticket:Cancel")) {
			case 1:
				callsub S_Donate,1,"50,000";
				break;
			case 2:
				callsub S_Donate,2,"100,000";
				break;
			case 3:
				callsub S_Donate,3,"150,000";
				break;
			case 4:
				cutin "ra_nemma02",2;
				mes "[Priestess Nemma]";
			mes "我明白捐出 50,000 Zeny 需要考虑。不过无论你去哪里，芙蕾雅总会保护你~";
				break;
			}
			close3;
		}
		else {
			cutin "ra_nemma03",2;
			mes "[Priestess Nemma]";
			mes "哦，是" + strcharinfo(0) + "！欢迎回来！我记得你刚才捐过款。今天怎么又来神殿了，嗯？";
			next;
			switch(select("我来再次捐赠。:只是观光。:我是来参加仪式的。:我只是想再见你。")) {
			case 1:
				mes "[Priestess Nemma]";
				mes "你又来捐赠？太好了！这次想捐多少？记住，我们只接受 50,000 Zeny 的倍数，最多 150,000 Zeny。";
				next;
				switch(select("50,000z - 1 Lottery Ticket:100,000z - 2 Lottery Ticket:150,000z - 3 Lottery Ticket:Cancel")) {
				case 1:
					callsub S_Donate,1,"50,000";
					break;
				case 2:
					callsub S_Donate,2,"100,000";
					break;
				case 3:
					callsub S_Donate,3,"150,000";
					break;
				case 4:
					cutin "ra_nemma02",2;
					mes "[Priestess Nemma]";
					mes "我明白捐出 50,000 Zeny 需要考虑。不过无论你去哪里，芙蕾雅总会保护你~";
					break;
				}
				close3;
			case 2:
				mes "[Priestess Nemma]";
				mes "哦！如果想了解神殿信息，为什么不去里面的帮助台问帕诺祭司？";
				next;
				mes "[Priestess Nemma]";
				mes "佩诺也会把彩票兑换成奖品，虽然她似乎不喜欢那份工作。总之，她会帮助你。回头见！";
				break;
			case 3:
				mes "[Priestess Nemma]";
				mes "你是来参加仪式的？太好了~希望你能从芙蕾雅女神那里找到平静~";
				break;
			case 4:
				mes "[Priestess Nemma]";
				mes "哦，你真贴心~";
				break;
			}
			close3;
		}
	}
	else {
		if (MISC_QUEST & 8192) {
			cutin "ra_nemma01",2;
			mes "[Priestess Nemma]";
		mes "欢迎来到我们的神殿！";
			close3;
		}
		if (ra_tem_q < 1) {
			mes "[Priestess Nemma]";
		mes "你好！";
			mes "...............................";
		mes "嗯，不知为何神殿大门还没打开。不过现在应该开了。这种事偶尔会发生……";
			next;
			mes "[Priestess Nemma]";
			mes "你看，神殿建造时大门安装了自动锁定系统，但现在它更像是麻烦而非安全措施。";
			next;
			mes "[Priestess Nemma]";
			mes "每次有人弄坏锁，或锁自行故障，我们都必须等它自动……";
	//

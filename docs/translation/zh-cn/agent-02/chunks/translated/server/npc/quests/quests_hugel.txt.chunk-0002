ein_in01,16,36,3	script	Morriphen	86,{
	if (hg_bio == 0) {
		if (hg_herb == 13) {
			mes "[Morriphen]";
			mes "你、你是谁？在找什么？";
			mes "如果你是来拿东西的，";
			mes "那你来得太早了。";
			mes "如你所见，";
			mes "我现在身体不适，";
			mes "没法和你说话。";
			next;
			mes "[Morriphen]";
			mes "^333333*Cough Cough*";
			mes "*Cough Cough*^000000";
			next;
			mes "["+strcharinfo(0)+"]";
			mes "天啊——！你没事吧？";
			mes "你、你咳血了！";
			mes "别紧张，我只是路过！";
			next;
			mes "[Morriphen]";
			mes "真、真的吗？那我很抱歉";
			mes "打扰到你了。";
			mes "我只是有点神经过敏。";
			mes "只是有点神经过敏。^333333*咳咳~*^000000";
			next;
			mes "["+strcharinfo(0)+"]";
			mes "嘿……你的声音听起来";
			mes "不太对劲。要我带你去医院吗？";
			mes "你的咳嗽很严重，";
			mes "也许应该去检查一下。";
			next;
			mes "[Morriphen]";
			mes "不用了，谢谢，我没事。";
			mes "我只是几个月没回家，";
			mes "没能续上处方药，";
			mes "就是这样。^333333*哈啊*";
			mes "*Cough-cough-cooooooough!*^000000";
			next;
			mes "["+strcharinfo(0)+"]";
			mes "Hmm...";
			mes "我该怎么办？";
			next;
			switch(select("离开他:帮助他")) {
			case 1:
				mes "["+strcharinfo(0)+"]";
				mes "你知道，我有点担心你的咳嗽，";
				mes "但我好像也帮不了你……";
				next;
				mes "[Morriphen]";
				mes "^333333*Cough cough*^000000";
				mes "别担心，我会没事的。";
				mes "你也要照顾好自己，听见了吗？";
				close;
			case 2:
				mes "["+strcharinfo(0)+"]";
				mes "嘿……";
				mes "你真的没事吗？";
				next;
				mes "[Morriphen]";
				mes "^333333*Cough cough*^000000";
				mes "别担心，我会没事的。";
				mes "你也要照顾好自己，听见了吗？";
				mes "^333333*Haaaak* *Reeetch*^000000";
				next;
				mes "["+strcharinfo(0)+"]";
				mes "...";
				mes "......";
				mes ".........";
				next;
				mes "[Morriphen]";
				mes "^333333*Reeeeetch*";
				mes "*Cooooough Cough*";
				mes "*Hhhh, Hhhhh, Hhhh*";
				mes "*Haaaaack* *Retch*^000000";
				next;
				mes "["+strcharinfo(0)+"]";
				mes "先生，拜托了。";
				mes "让我帮你吧。";
				mes "你咳成这样，";
				mes "我不能把你一个人";
				mes "留在这里。";
				next;
				mes "[Morriphen]";
				mes "...............................";
				mes "我、我本来不想";
				mes "打扰你，但、但你坚持要";
				mes "帮我的话，也许我可以拜托你一件事。";
				next;
				mes "[Morriphen]";
				mes "你能去汶格的我家，";
				mes "向我的妻子西莉娅要药吗？";
				mes "她知道药在哪里，会交给你。";
				mes "还有，请不要告诉她其他事情，好吗？";
				next;
				mes "[Morriphen]";
				mes "她总是担心我的病情恶化，";
				mes "我不想让她有任何理由";
				mes "继续焦虑。请只告诉她";
				mes "我的药吃完了。";
				next;
				mes "["+strcharinfo(0)+"]";
				mes "好。";
				mes "我会尽快回来。";
				next;
				mes "[Morriphen]";
				mes "非常感谢。";
				mes "^333333*Cough Cough*";
				mes "*Cough Cough*^000000";
				set hg_bio,1;
				setquest 11009;
				close;
			}
		} else {
			mes "[Morriphen]";
			mes "呃……我感觉不太好。";
			mes "看来今天还是到此为止吧……";
			close;
		}
	} else if (hg_bio == 1) {
		mes "[Morriphen]";
		mes "请向我在汶格家中的妻子西莉娅";
		mes "要我的^333333*咳嗽*^000000药。";
		mes "^333333*呕吐*^000000谢、谢谢……";
		mes "^333333*Haaaaack* *Hhh, haaaack*^000000";
		close;
	} else if (hg_bio == 2) {
		mes "["+strcharinfo(0)+"]";
		mes "不好……莫里芬的情况";
		mes "看起来很糟！我得尽快从";
		mes "汶格的西莉娅那里拿药给他！";
		close;
	} else if (hg_bio == 3) {
		mes "["+strcharinfo(0)+"]";
		mes "不好……莫里芬的情况";
		mes "看起来很糟！我得尽快从";
		mes "汶格的多诺那里拿药给他！";
		close;
	} else if (hg_bio == 4) {
		mes "["+strcharinfo(0)+"]";
		mes "不好……莫里芬的情况";
		mes "看起来很糟！我得尽快从";
		mes "汶格的多诺那里拿药给他！";
		close;
	} else if (hg_bio == 5) {
		mes "["+strcharinfo(0)+"]";
		mes "不好……莫里芬的情况";
		mes "看起来很糟！我得尽快从";
		mes "汶格的多诺那里拿药给他！";
		close;
	} else if (hg_bio == 6) {
		mes "^3355FF你给莫里芬服下药物，";
		mes "他慢慢恢复了意识。^000000";
		next;
		mes "[Morriphen]";
		mes "^333333*Cough, cough*^000000";
		mes "我、我在哪里？";
		mes "我……还没死吗？";
		mes "哦，是你！看来我信任你是对的。";
		mes "我妻子把我的药给你了吗？";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "其实我到你家时，西莉娅的药也吃完了，";
		mes "所以她让我去你的朋友多诺那里取一些。";
		next;
		mes "[Morriphen]";
		mes "不，你做了什么？";
		mes "我妻子的命也依靠那种药！";
		mes "糟了，她没有药就会死！";
		mes "都是我的愚蠢造成的！拜托！";
		mes "求你把这个带给她！";
		next;
		mes "[Morriphen]";
		mes "那个女人就是我的一切。";
		mes "如果她不在了，我不知道该怎么办。";
		mes "请尽快把这药带给她！";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "别担心，我这就去。";
		mes "我会尽快赶回汶格，把药交给西莉娅。";
		set hg_bio,7;
		changequest 11014,11015;
		close;
	} else if (hg_bio == 7) {
		mes "["+strcharinfo(0)+"]";
		mes "我在做什么……？";
		mes "我得尽快回汶格，把药交给西莉娅！";
		close;
	} else if (hg_bio == 8) {
		mes "[Morriphen]";
		mes "你回来了！你见到我妻子了吗？";
		mes "她没事，对吧？你为什么不说话——";
		mes "不好，天啊，";
		mes "不。别告诉我她死了！";
		next;
		mes "[Morriphen]";
		mes "她一定没事……！";
		mes "如果她出了什么事，";
		mes "我、我不会原谅你！";
		mes "没人会找到你的尸体！";
		mes "不，等等……抱歉，我只是太焦虑了……！";
		next;
		mes "[Morriphen]";
		mes "^333333*抽泣*^000000请原谅我！";
		mes "请告诉我妻子没事。";
		mes "对不起，一切";
		mes "现在实在让人难以承受。^333333*抽泣*^000000";
		mes "求求你……";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "Siria 没事。";
		mes "现在满意了吗？";
		mes "如果你那么担心她，";
		mes "就应该多去看看她。真是的……";
		next;
		mes "[Morriphen]";
		mes "哈利路亚！我真是";
		mes "放心了！她还活着！";
		mes "抱歉，我也想常回家，";
		mes "但总是在这里";
		mes "为生计奔波。";
		mes "真的非常感谢你！";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "别放在心上。";
		mes "这只是应该做的事，";
		mes "仅此而已。";
		next;
		mes "[Morriphen]";
		mes "你真是个善良的人……";
	mes "你救了我和妻子的命，";
	//
	//
	//
	//
	//
	//
	//
	//
	//
	//
	//

			close;
		}
	} else if (hg_herb > 1) {
		mes "[Postell]";
		mes "Kolbun A，Kolbun A……";
		mes "让我看看，爸爸服用它";
		mes "真的安全吗？";
		mes "如果不安全，";
		mes "我最好想办法替代……";
		close;
	} else {
		mes "[Postell]";
		mes "我很喜欢住在呼噜呼噜。";
		mes "空气清新，水很干净，";
		mes "每个人都友好亲切。";
		mes "我还能想要什么呢？";
		close;
	}
}


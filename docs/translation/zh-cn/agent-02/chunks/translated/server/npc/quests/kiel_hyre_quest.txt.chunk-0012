		mes "你现在携带了太多物品，";
		mes "所以需要先腾出";
		mes "更多背包空间……^000000";
		mes "";
		mes "";
		close;
	}
	if ((KielHyreQuest < 62) || (KielHyreQuest >= 64)) {
		mes "^3355FF灌木丛里有一块";
		mes "没用的木板。^000000";
		mes "";
		close;
	}
	else if (KielHyreQuest == 62) {
		mes "^3355FF你找到一块长木板，";
		mes "上面刻着缩写‘K.H.’^000000";
		mes "";
		next;
		cutin "kh_kyel_port",2;
		mes "^3355FF你在旧木板下面";
		mes "破碎的相框里找到一幅";
		mes "年轻人的肖像，他看起来";
		mes "像年轻时的基尔·海勒。^000000";
		mes "";
		mes "";
		getitem 7503,1;	//Man_Portrait
		set KielHyreQuest,64;
		next;
		cutin "",255;
		mes "^3355FF你现在已经获得了足够的信息，";
		mes "应该回去向米切尔报告。^000000";
		mes "";
		mes "";
		close;
	}
}

//============================================================================
// Kiehl Hyre's Room and Boss NPCs
//============================================================================
// Beyond here the NPC for the final areas.
// Now, this area is not someplace you wanna slow down so
// you can pick up dialog. I used packet logging to pull
// what I could and for the sake of the two people with me,
// did not bother doing all the proper NPC positioning
// or some of the 'error/wrong option' dialogs.
// All the doors are kind of weird.
//============================================================================

//----------------------------------------------------------------------------
// Kiehl's Room; Receiver (Gives black keycards upon killing mobs)
//----------------------------------------------------------------------------
kh_kiehl01,17,39,0	script	Receiver#kh	111,{
	if (mobcount("kh_kiehl01","Receiver#kh::OnMyMobDead") < 1) {
		mes "^333333*BBBZZZ*^000000";
		if (KielHyreQuest == 74) {
			next;
			mes "[????]";
			mes "^333333*Bzzzz...*";
			mes "我从未见过你。";
			mes "是父亲派你来杀我的吗？";
			mes "那就走着瞧！来吧，";
			mes "试着找到我，冒险者。^000000。";
			mes "";
			set KielHyreQuest,76;
		}
		close2;
		monster "kh_kiehl01",16,32,"Alicel",1739,1,"Receiver#kh::OnMyMobDead";
		monster "kh_kiehl01",18,31,"Aliot",1740,1,"Receiver#kh::OnMyMobDead";
		end;
	}

	else {
		end;
	}

OnMyMobDead:
	if (mobcount("kh_kiehl01","Receiver#kh::OnMyMobDead") <1) { 
		makeitem 7506,1,"this",19,36;
	}
	end;
}

//----------------------------------------------------------------------------
// Kiehl's Room; Flower Vase (Gives...password...for Box)
//----------------------------------------------------------------------------
kh_kiehl01,13,40,0	script	Flower Vase#kh1	111,{
	if (KielHyreQuest < 74) {
		mes "^3355FF你找到";
		mes "一个花瓶。^000000";
		close;
	}
	if (KielHyreQuest >= 74) {
		mes "^3355FF你找到";
		mes "一个花瓶。^000000";
		next;
		switch(select("拿起花瓶:打破花瓶:把花瓶倒过来")) {
		case 1:
			mes "^3355FF花瓶是空的。^000000";
			close;
		case 2:
			mes "^3355FF即使你用尽全力，";
			mes "也无法打破这个花瓶。";
			mes "它一定是由";
			mes "雷根贝勒公司特别制造的。^000000";
			mes "";
			mes "";
			close;
		case 3:
			mes "^3355FF花瓶底部";
			mes "写着以下文字。^000000";
			mes "";
			next;
			mes "[Vase Message]";
			mes "‘兔子经常";
			mes "观察门。";
			mes "夜晚吞食";
			mes "腌橙。’";
			close;
		}
	}
	else{
		mes "^3355FF花瓶底部";
		mes "写着以下文字。^000000";
		mes "";
		next;
		mes "[Vase Message]";
		mes "‘兔子经常";
		mes "观察门。";
		mes "夜晚吞食";
		mes "腌橙。’";
		close;
	}
}


//----------------------------------------------------------------------------
// Kiehl's Room; Box
//----------------------------------------------------------------------------
kh_kiehl01,19,25,0	script	Box#kh1	111,{
	if (checkweight(7505,1) == 0) {
		mes "^3355FF等一下……";
		mes "你现在携带了太多物品，";
		mes "所以需要先腾出";
		mes "更多背包空间……^000000";
		mes "";
		mes "";
		close;
	}
	if (KielHyreQuest < 74) {
		mes "^3355FF你找到一个箱子，顶部有";
		mes "字母表中每个字母对应的按钮。^000000";
		mes "";
		next;
		input .@KHInput$;
		mes "^3355FF什么也没发生。^000000";
		close;
	}
	if (KielHyreQuest >= 74) {
		if (countitem(7505) < 1) {
			mes "^3355FF你找到一个箱子，顶部有";
			mes "字母表中每个字母对应的按钮。^000000";
			mes "";
			next;
			input .@KHInput$;
			if (.@KHInput$ == "open the door") {

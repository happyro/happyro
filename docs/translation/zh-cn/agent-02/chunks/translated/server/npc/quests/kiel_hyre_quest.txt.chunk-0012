// Rosimier Mansion, first floor; Shelf
//----------------------------------------------------------------------------
kh_rossi,92,40,0	script	Shelf#khr	111,{
	if (checkweight(7500,1) == 0) {
		mes "^3355FF等一下……";
		mes "你现在携带了太多物品，";
		mes "所以需要先腾出";
		mes "更多背包空间……^000000";
		mes "";
		mes "";
		close;
	}
	if (KielHyreQuest < 58) {
		mes "^3355FF这里没有";
		mes "对你重要的东西。^000000";
		close;
	}
	else if (KielHyreQuest < 60) {
		if (countitem(7500) < 1) {
			mes "^3355FF书架上有上锁的箱子。";
			mes "也许使用这座宅邸的";
			mes "万能钥匙，";
			mes "就能打开它们。^000000";
			mes "";
			next;
			switch(select("使用钥匙:放弃")) {
			case 1:
				mes "^3355FF你想尝试打开";
				mes "哪个箱子？^000000";
				next;
				switch(select("第一个箱子:第二个箱子")) {
				case 1:
					mes "^3355FF你用万能钥匙打开箱子，";
					mes "得到一幅女人的肖像，";
					mes "她看起来和基尔·海勒的";
					mes "助手阿莉西亚一模一样。^000000";
					mes "";
					next;
					cutin "kh_ellisia_port",2;
					mes "^3355FF背面写着：‘致我的爱，";
					mes "阿莉西亚。来自詹姆斯。’^000000";
					mes "";
					getitem 7500,1; //Elysia_Portrait
					close2;
					cutin "",255;
					end;
				case 2:
					mes "^3355FF这个箱子是空的。^000000";
					close;
				}
			case 2:
				mes "^3355FF这个箱子是空的。^000000";
				close;
			}
		}
		else {
			mes "^3355FF你在书架上的一个箱子里";
			mes "找到了一幅女人的肖像。^000000";
			mes "";
			close;
		}
	}
	else {
		mes "^3355FF你在书架上的一个箱子里";
		mes "找到了一幅女人的";
		mes "肖像。";
		mes "这个箱子现在是空的。^000000";
		close;
	}
}


//----------------------------------------------------------------------------
// Rosimier Mansion, top floor; Desk
//----------------------------------------------------------------------------
kh_rossi,144,286,0	script	Desk#khr3	111,{
	if (checkweight(7501,1) == 0) {
		mes "^3355FF等一下……";
		mes "你现在携带了太多物品，";
		mes "所以需要先腾出";
		mes "更多背包空间……^000000";
		mes "";
		mes "";
		close;
	}
	if (KielHyreQuest < 58) {
		mes "^3355FF只是一张书桌。^000000";
		close;
	}
	else if (KielHyreQuest < 60) {
		mes "^3355FF书桌有";
		mes "三个抽屉。^000000";
		next;
		switch(select("第一个抽屉:第二个抽屉:第三个抽屉:取消")) {
		case 1:
			mes "^3355FF第一个抽屉上锁了。^000000";
			close;
		case 2:
			if (countitem(7501) < 1) {
				mes "^3355FF第二个抽屉里有一封信。";
				mes "它由一位名字缩写为 K.H. 的人寄出，";
				mes "收信人是阿莉西亚。^000000";
				mes "";
				mes "";
				getitem 7501,1; //Kyll_Hyre_Letter2
				close;
			}
			else {
				mes "^3355FF这个抽屉现在是空的。^000000";
				close;
			}
		case 3:
			mes "^3355FF第三个抽屉里有一张小纸条。";
			mes "詹姆斯写道，他想";
			mes "和阿莉西亚结婚，";
			mes "而她已经收到了订婚戒指。^000000";
			mes "";
			mes "";
			close;
		case 4:
			mes "……";
			mes "………";
			mes "…………";
			close;
		}
	}
	else{
		mes "^3355FF这就是那张书桌，你在这里";
		mes "找到了一封由 K.H. 写的信，";
		mes "以及詹姆斯·罗西米尔写的纸条。";
		mes "两者都是写给";
		mes "同一位女性阿莉西亚的。^000000";
		mes "";
		close;
	}
}


//----------------------------------------------------------------------------
kh_rossi,154,286,0	script	Bed#khr	111,{
	if (KielHyreQuest < 58) {
		mes "^3355FF你找到一张制作精良的";
		mes "床，积了厚厚一层灰尘，";
		mes "多年无人使用。^000000";
		mes "";
		close;
	}
	else if (KielHyreQuest < 60) {
		mes "^3355FF你找到一张制作精良的";
		mes "床，积了厚厚一层灰尘，";
		mes "多年无人使用。^000000";
		mes "";
		next;
		switch(select("检查床单:检查床下")) {
		case 1:
			mes "^3355FF你用手拂过床面，";
			mes "扬起一团讨厌的灰尘，";
			mes "刺激你的鼻子和喉咙。";
			mes "呃，好恶心！^000000";
			mes "";
			percentheal -10,0;
			close;
		case 2:
			mes "^3355FF你搜索床底，";
			mes "找到一个空的订婚戒指盒。^000000";
			mes "";
			close;
		}
	}
	else {
		mes "^3355FF这是一张肮脏的床。^000000";
		close;
	}
}

//----------------------------------------------------------------------------
// Fisherman
//----------------------------------------------------------------------------
yuno_fild12,232,222,0	script	Old Fisherman	709,{
	if (KielHyreQuest < 60) {
		mes "[Fisherman]";
		mes "最近越来越难";
		mes "捕到鱼了。";
		mes "自从他们建造这座工厂，";
		mes "鱼开始发生变化，";
		mes "看起来也不一样了……";
		mes "";
		close;
	}
	else if (KielHyreQuest == 60) {
		mes "[Fisherman]";
		mes "咦？你想要什么？";
		mes "嘿，年轻人！我知道";
		mes "你多么喜欢白拿东西，";
		mes "但你什么也拿不到。";
		mes "如果你带些生鱼来，";
		mes "我会更友好~";
		if (countitem(544) >= 10)  {
			next;
			mes "[Fisherman]";
			mes "哦，这些鱼都是";
			mes "给我的吗？";
			mes "嘿，你真慷慨。";
			mes "既然你这么好心，";
			mes "我想我得报答你。";
			mes "问我什么都行~";
			next;
			select("30 years ago, a woman killed herself...");
			mes "[Fisherman]";
			mes "哦？哦……对了。";
			mes "我记得。没错。";
			mes "那是 8 月 20 日，";
			mes "我妻子的生日。那天，";
			mes "我没有捕到鱼，";
			mes "却捕到了一具女尸。";
			next;
			mes "[Fisherman]";
			mes "当然，我向朱诺警察报告了！";
			mes "他们告诉我，她因为被恋人背叛";
			mes "而自杀了，";
			mes "因为她被恋人背叛。";
			mes "而那人恰好也是她的";
			mes "雇主。真是悲惨。";
			next;
			mes "[Fisherman]";
			mes "总之，他们把她的尸体";
			mes "从河里捞出来时，";
			mes "她的手掉出一枚戒指。";
			mes "我捡了起来，";
			mes "希望以后卖掉换些 Zeny。";
			mes "我知道，我知道……";
			next;
			mes "[Fisherman]";
			mes "我很幸运，警察没有看到我拿走它。";
			mes "那天晚些时候，有个人来找我，";
			mes "愿意出很多钱买它。";
			mes "看来那天是我的幸运日！";
			mes "";
			next;
			mes "[Fisherman]";
			mes "后来我才知道他是";
			mes "机械维修师之类的人。";
			mes "他卖掉所有东西买下戒指，";
			mes "看来他非常想要它。";
			mes "然后他就消失了。";
			mes "";
			next;
			select("你记得他的名字吗？");
			mes "[Fisherman]";
			mes "他的名字……？";
			mes "好像是……";
			mes "海尔？海勒？总之，";
			mes "那是很久以前的事了。哦，";
			mes "他的旧宅还在。";
			next;
			mes "[Fisherman]";
			mes "既然你这么好奇，";
			mes "不妨去看看。";
			mes "让我想想，他住在";
			mes "东北森林守卫营地";
			mes "附近的一间小屋里。";
			mes "";
			mes "";
			delitem 544,10; //Fish_Slice
			set KielHyreQuest,62;
			close;
		}
		else {
			close;
		}
	}
	else if (KielHyreQuest >= 62) {
		mes "[Fisherman]";
		mes "你不记得我说过的吗？";
		mes "那个人住在东北森林";
		mes "守卫营地附近的小屋里！";
		mes "为什么不去那里看看？";
		mes "";
		mes "";
		close;
	}
}


		mes "[Mr. Irrelevant]";
		mes "嗯……";
		mes "你是来参加考试的吧？从你的眼神里，我看得出你知道些什么。";
		next;
		mes "[Mr. Irrelevant]";
		mes "你的名字是" + strcharinfo(0) + "？啊，在名单上。好吧，我让你进入蘑菇农场，但无法保证你的安全……";
		close2;
		set job_thief_q,3;
		switch(rand(5)) {
		case 1: warp "job_thief1",228,106; end;
		case 2: warp "job_thief1",38,50; end;
		case 3: warp "job_thief1",66,331; end;
		case 4: warp "job_thief1",196,331; end;
		default: warp "job_thief1",309,234; end;
		}
	}
	else if (job_thief_q == 1) {
		mes "[Mr. Irrelevant]";
		mes "有一股奇怪的气味从……你身上传来。现在知道为什么了吧？";
		close;
	}
	mes "[Mr. Irrelevant]";
	mes "嘿，新手！为什么不加入盗贼公会？我们总是欢迎你们这些新手加入我们和自私的事业。";
	next;
	mes "[Mr. Irrelevant]";
	mes "你可以在金字塔地下1层的地下室了解更多信息。";
	close;
}


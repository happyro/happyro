// - Airship Sign
// -----------------------------------------------------------------------------
izlude,179,75,3	script	Airship#iz	4_BULLETIN_BOARD2,3,3,{
	.@total = isbegin_quest(7475) + isbegin_quest(7476) + isbegin_quest(7477);
	if (isbegin_quest(7474) == 1) {
		if (!isbegin_quest(7475)) {
			mes "==== Airship Information====";
			mes "伊兹鲁德 - Juno - Rachel";
			mes "前往^4d4dffSchwarzwalt共和国^000000或^4d4dffArunafeltz^000000的旅客可以在这里搭乘飞艇。";
			next;
			if (.@total == 1) {
				mes "除了免费飞艇的告示牌，什么也找不到。";
				next;
				select("Where's the hidden treasure?");
				mes "[Lumin]";
				mes "哟。";
				mes "抱歉，朋友，我先到这里了。";
				mes "你应该像我一样使用苍蝇翅膀。";
				cutin "nov_lumin01.bmp", 2;
				next;
				mes "[Lumin]";
				mes "这些翅膀为什么能传送？";
				mes "我猜是因为它们来自奶油怪……";
				next;
				mes "[Lumin]";
				mes "正如船长所说，眼见为实。世界充满了谜团。";
				next;
				cutin "", 255;
				mes "看来Lumin又赢了。";
				mes "最好在Lumin之前到达下一个地点。";
				setquest 7475;
				viewpoint 2,179,75,1,0xFF0000;
				close;
			} else if (.@total > 1) {
				mes "[Lumin]";
				mes ".......";
				cutin "nov_lumin01.bmp", 2;
				next;
				mes "[Lumin]";
				mes "哇哈哈哈哈。";
				cutin "nov_lumin03.bmp", 2;
				next;
				if (select("Are you kidding me?!", "Where's the treasure?") == 1) {
					mes "[Lumin]";
					mes "不……";
					mes "一天见三次一定是命运。";
					mes "你和我可以成为朋友。";
					cutin "nov_lumin05.bmp", 2;
					next;
					select("Or Frenemies!");
					mes "[Lumin]";
					mes "什么仇敌？算了，我的任务完成了。";
					mes "保重。";
					cutin "nov_lumin02.bmp", 2;
					next;
					cutin "", 255;
					mes "[" + strcharinfo(0) + "]";
					mes "你到底有没有听我说话？！";
					setquest 7475;
					viewpoint 2,179,75,1,0xFF0000;
					next;
					mes "^4d4dff……我必须向信息人员报告结果……^000000。";
					close;
				}
				mes "[Lumin]";
				mes "哦，蝴蝶翅膀。";
				mes "交给你也只会被浪费，所以我自己留着。";
				cutin "nov_lumin01.bmp", 2;
				next;
				mes "[Lumin]";
				mes "来吧，这只是友好的竞争。";
				cutin "nov_lumin05.bmp", 2;
				next;
				mes "[Lumin]";
				mes "我这么做是为了让你变强。";
				mes "那么，再见。";
				cutin "nov_lumin03.bmp", 2;
				next;
				cutin "", 255;
				mes "^4d4dff……我必须向信息人员报告结果……^000000。";
				setquest 7475;
				viewpoint 2,179,75,1,0xFF0000;
				close;
			} else {
				mes "除了免费飞艇的告示牌，没发现特别的东西。";
				next;
				select("Why is there nothing here?");
				mes "[Lumin]";
				mes "当然。";
				mes "我已经把它装进包里了。";
				mes "这里原本有蝴蝶翅膀。";
				cutin "nov_lumin01.bmp", 2;
				next;
				select("So can I have some?");
				mes "[Lumin]";
				mes "这不公平，我先到，所以它们是我的。";
				mes "想要奖品就快点去下一站。";
				cutin "nov_lumin02.bmp", 2;
				next;
				mes "[Lumin]";
				mes "那么……";
				cutin "nov_lumin03.bmp", 2;
				next;
				cutin "", 255;
				mes "Lumin长发飘扬，消失了。";
				mes "......";
				setquest 7475;
				viewpoint 2,179,75,1,0xFF0000;
				close;
			}
		} else {
			mes "==== Airship Information ====";
			mes "伊兹鲁德 - Juno - Rachel";
			mes "前往^4d4dffSchwarzwalt共和国^000000或^4d4dffArunafeltz^000000的旅客可以在这里搭乘飞艇。";
			close;
		}
	} else {
		mes "==== Airship Information ====";
		mes "伊兹鲁德 - Juno - Rachel";
		mes "前往^4d4dffSchwarzwalt共和国^000000或^4d4dffArunafeltz^000000的旅客可以在这里搭乘飞艇。";
		close;
	}

OnInit:
	questinfo( QTYPE_QUEST, QMARK_NONE, "!isbegin_quest(7475) && isbegin_quest(7474) == 1" );
	end;

OnTouch:
	if (isbegin_quest(7474) == 1 && !isbegin_quest(7475))
		emotion ET_SURPRISE;
	end;
}


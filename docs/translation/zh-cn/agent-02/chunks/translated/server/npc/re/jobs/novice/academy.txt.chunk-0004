					mes "保重。";
					cutin "nov_lumin02.bmp", 2;
					next;
					cutin "", 255;
					mes "[" + strcharinfo(0) + "]";
					mes "你到底有没有听我说话？！";
					setquest 7476;
					viewpoint 2,207,167,3,0xFF0000;
					next;
					mes "^4d4dff……我必须向信息人员报告结果……^000000。";

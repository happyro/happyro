						mes "在小地图上。";
						mes "需要更详细的指引吗？";
						viewpoint 1, 108, 179, 4, 0xFFAAFF;
						next;
						continue;
					case 6:
						mes "[Information Staff]";
						mes "<NAVI>[剑士公会]<INFO>izlude,51,172,</INFO></NAVI>是办理剑士转职的地方。";
						mes "我会在小地图上标记剑士公会的位置。";
						mes "需要更详细的指引吗？";
						viewpoint 1, 52, 172, 5, 0xFFDA70;
						next;
						continue;
					case 7:
						mes "[Information Staff]";
						mes "我会在小地图上标记";
						mes "<NAVI>[附魔协会]<INFO>izlude,97,125,</INFO></NAVI>";
						mes "的位置。";
						mes "需要更详细的指引吗？";
						viewpoint 1, 97, 125, 6, 0xFFDA70;
						next;
						continue;
					case 8:
						mes "[Information Staff]";
						mes "我会在小地图上标记";
						mes "<NAVI>[铁匠工坊]<INFO>izlude,153,126,</INFO></NAVI>";
						mes "的位置。";
						mes "需要更详细的指引吗？";
						viewpoint 1, 153, 126, 7, 0xFFAAFF;
						next;
						continue;
					case 9:
						break;
					}
					break;
				}
				break;
			case 2:
				while (1) {
					switch(select("[ Eden Group Teleporter ]:[ Kafra Employee ]:[ Mesmerizer ]:[ Wedding Secretary ]:[ Mercenary Guild Official ]:[ Taming Merchant ]:Go back to the previous menu")) {
					case 1:
						mes "[Information Staff]";
						mes "现在我会在小地图上标记";
						mes "<NAVI>[伊甸园传送员]<INFO>izlude,131,148,</INFO></NAVI>";
						mes "的位置。";
						mes "需要更详细的指引吗？";
						viewpoint 1, 131, 148, 8, 0xFF0A82;
						next;
						continue;
					case 2:
						mes "[Information Staff]";
						mes "我会在小地图上标记";
						mes "<NAVI>[卡普拉职员]<INFO>izlude,128,148,</INFO></NAVI>";
						mes "的位置。";
						mes "需要更详细的指引吗？";
						viewpoint 1, 128, 148, 9, 0xFFFF54;
						next;
						continue;
					case 3:
						mes "[Information Staff]";
						mes "我会在小地图上标记";
						mes "<NAVI>[催眠师]<INFO>izlude,124,127,</INFO></NAVI>";
						mes "的位置。";
						mes "需要更详细的指引吗？";
						viewpoint 1, 125, 127, 10, 0xFF0064;
						next;
						continue;
					case 4:
						mes "[Information Staff]";
						mes "如果想去^8B4513Jawaii^000000——情侣度假地，";
						mes "请和<NAVI>[婚礼秘书]<INFO>izlude,180,224,</INFO></NAVI>交谈。";
						mes "直接询问相关问题即可。";
						mes "需要更详细的指引吗？";
						viewpoint 1, 180, 224, 11, 0xFFFF00;
						next;
						continue;
					case 5:
						mes "[Information Staff]";
						mes "如果想了解佣兵公会，请向西前往并与";
						mes "<NAVI>[Mercenary Guild Official]<INFO>izlude,47,170,</INFO></NAVI>.";
						mes "需要更详细的指引吗？";
						viewpoint 1, 47, 170, 12, 0xFFDA70;
						next;
						continue;
					case 6:
						mes "[Information Staff]";
						mes "我会在小地图上标记";
						mes "<NAVI>[Taming Merchant]<INFO>izlude,118,163,</INFO></NAVI>";
						mes "的位置。";
						mes "需要更详细的指引吗？";
						viewpoint 1, 118, 163, 13, 0xFF0064;
						next;
						continue;
					case 7:
						break;
					}
					break;
				}
				break;
			case 3:
				mes "[Information Staff]";
				mes "我会清除标记。";
				mes "需要更详细的指引吗？";
				viewpoint 2, 197, 205, 1, 0xFF0000;
				viewpoint 2, 210, 73, 2, 0xFF0000;
				viewpoint 2, 213, 161, 3, 0xFF0000;
				viewpoint 2, 108, 179, 4, 0xFF0000;
				viewpoint 2, 52, 172, 5, 0xFF0000;
				viewpoint 2, 97, 125, 6, 0xFF0000;
				viewpoint 2, 153, 126, 7, 0xFF0000;
				viewpoint 2, 131, 148, 8, 0xFF0000;
				viewpoint 2, 128, 148, 9, 0xFF0000;
				viewpoint 2, 125, 127, 10, 0xFF0000;
				viewpoint 2, 180, 224, 11, 0xFF0000;
				viewpoint 2, 47, 170, 12, 0xFF0000;
				viewpoint 2, 118, 163, 13, 0xFF0000;
				next;
				break;
			case 4:
				mes "[Information Staff]";
				mes "祝你冒险愉快。";
				mes "再见～～！";
				close;
			}
		}
	}

OnInit:
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "BaseLevel <= 14 && !isbegin_quest(7474)" );
	// questinfo( QTYPE_QUEST, QMARK_YELLOW, "!isbegin_quest(7495) && isbegin_quest(7475) == 1 && isbegin_quest(7476) == 1 && isbegin_quest(7477) == 1" );// officially disabled
	end;
}

izlude_a,120,207,4	duplicate(Information Staff#0)	Information Staff#a	8W_SOLDIER
izlude_b,120,207,4	duplicate(Information Staff#0)	Information Staff#b	8W_SOLDIER

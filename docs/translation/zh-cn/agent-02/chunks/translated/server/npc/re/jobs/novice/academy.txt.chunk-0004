				}
				mes "[Lumin]";
				mes "红色药水。";
				mes "交给你也只会被浪费，所以我自己留着。";
				cutin "nov_lumin01.bmp", 2;
				next;
				mes "[Lumin]";
				mes "来吧，这只是友好的竞争。";
				cutin "nov_lumin05.bmp", 2;
				next;
				mes "[Lumin]";
				mes "我这么做是为了让你变强。";
				mes "那么，再见。";
				cutin "nov_lumin03.bmp", 2;
				next;
				cutin "", 255;
				mes "^4d4dff……我必须向信息人员报告结果……^000000。";
				setquest 7476;
				viewpoint 2,207,167,3,0xFF0000;
				close;
			} else {
				mes "除了竞技场宣传牌，什么也找不到。";

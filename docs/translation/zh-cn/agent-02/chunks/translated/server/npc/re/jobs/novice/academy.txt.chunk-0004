					mes "不……";
					mes "一天见三次一定是命运。";
					mes "你和我可以成为朋友。";
					cutin "nov_lumin05.bmp", 2;
					next;
					select("Or Frenemies!");
					mes "[Lumin]";
					mes "什么仇敌？算了，我的任务完成了。";
					mes "保重。";
					cutin "nov_lumin02.bmp", 2;
					next;

					mes "[" + strcharinfo(0) + "]";
					mes "你到底有没有听我说话？！";
					setquest 7477;
					viewpoint 2,45,94,2,0xFF0000;
					next;
					mes "^4d4dff……我必须向信息人员报告结果……^000000。";
					close;
				}
				mes "[Lumin]";
				mes "苍蝇翅膀。";
				mes "交给你也只会被浪费，所以我还是留着吧。";
				cutin "nov_lumin01.bmp", 2;
				next;
				mes "[Lumin]";
				mes "来吧，这只是友好的竞争。";
				cutin "nov_lumin05.bmp", 2;
				next;
				mes "[Lumin]";
				mes "我这么做是为了让你变强。";
				mes "那么，再见。";

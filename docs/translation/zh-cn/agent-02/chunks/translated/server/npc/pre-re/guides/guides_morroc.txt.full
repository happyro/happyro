morocc,153,286,6	script	Guide#moc::MocGuide	707,{
	cutin "moc_soldier",2;
	mes "[梦罗克向导]";
	mes "欢迎来到梦罗克，";
	mes "卢恩·米德加尔兹王国的";
	mes "边境城镇。";
	mes "如果在城里遇到任何困难，";
	mes "或者找不到想去的地方，";
	mes "请随时来找我。";
	set .@loop1,1;
	while (.@loop1) {
		next;
		switch(select("城市指南:移除小地图标记:注意事项:取消")) {
		case 1:
			mes "[梦罗克向导]";
			mes "请从下面的菜单";
			mes "选择一个地点。";
			mes "请选择你想查看的位置。";
			if (.@compass_check == 0) {
				mes "要我在小地图上";
				mes "标记这些地点吗？";
				mes "这样导航会更方便。";
				next;
				if (select("是。:否。") == 1) set .@compass_check,1;
			}
			set .@loop2,1;
			while(.@loop2) {
				if (.@wait_button_chk == 0) set .@wait_button_chk,1;
				else next;
				
				switch(select("^FF0000盗贼公会^000000:武器店:旅馆:酒馆:佣兵公会:锻造所:取消")) {
				case 1:
					mes "[梦罗克向导]";
					mes "盗贼公会负责";
					mes "盗贼职业的所有转职。";
					mes "听说他们就在附近的";
					mes "金字塔里面……";
					mes "去那里就能找到他们。";
					mes "请查看地图标记。";
					if (.@compass_check)
						viewpoint 1,24,297,2,0xFF0000;
					break;
				case 2:
					mes "[梦罗克向导]";
					mes "武器店位于";
					mes "梦罗克的东南部。";
					mes "在那里可以买到武器。";
					if (.@compass_check)
						viewpoint 1,253,56,3,0xFF00FF;
					break;
				case 3:
					mes "[梦罗克向导]";
					mes "梦罗克的东南和东北";
					mes "都有可以休息的旅馆。";
					mes "需要时请查看地图标记。";
					mes "旅馆能让你恢复精力。";
					if (.@compass_check) {
						viewpoint 1,197,66,4,0xFF00FF;
						viewpoint 1,273,269,5,0xFF00FF;
					}
					break;
				case 4:
					mes "[梦罗克向导]";
					mes "酒馆位于梦罗克东北部。";
					mes "那里适合休息和交友。";
					if (.@compass_check)
						viewpoint 1,52,259,6,0xFF00FF;
					break;
				case 5:
					mes "[梦罗克向导]";
					mes "佣兵公会位于";
					mes "梦罗克东部。";
					mes "请沿标记前往。";
					if (.@compass_check)
						viewpoint 1,284,171,7,0x00FF00;
					break;
				case 6:
					mes "[梦罗克向导]";
					mes "锻造所位于";
					mes "梦罗克中心的";
					mes "西南方。";
					mes "需要装备时可以去那里。";
					if (.@compass_check)
						viewpoint 1,47,47,7,0xFF00FF;
					break;
				case 7:
					mes "[梦罗克向导]";
					mes "如果不想继续显示地点标记，";
					mes "请让我‘移除小地图标记’。";
					mes "这样就会清除";
					mes "小地图上的地点标记。";
					mes "需要时可以再次设置。";
					set .@loop2,0;
				}
			}
			break;
		case 2:
			viewpoint 2,237,41,2,0x00FF00;
			viewpoint 2,237,41,3,0x0000FF;
			viewpoint 2,46,345,4,0x00FF00;
			viewpoint 2,175,220,5,0xFF0000;
			viewpoint 2,175,220,6,0xFF0000;
			viewpoint 2,175,220,7,0xFF0000;
			set .@compass_check,0;
			break;
		case 3:
			mes "[梦罗克向导]";
			mes "魔法与科技的发展让我们";
			mes "能够更新信息系统，";
			mes "并在小地图上标记地点，";
			mes "让导航变得更加方便。";
			mes "现在就可以使用这项功能。";
			mes "请好好利用它。";
			next;
			mes "[梦罗克向导]";
			mes "小地图位于屏幕的右上角。";
			mes "如果看不到，请按 Ctrl + Tab 键，";
			mes "或者点击基本信息窗口中的‘地图’按钮。";
			mes "这样就能显示小地图了。";
			mes "请记得使用导航功能。";
			next;
			mes "[梦罗克向导]";
			mes "在小地图上点击‘+’和‘-’";
			mes "符号可以放大或缩小。";
			mes "希望你能享受";
			mes "在梦罗克的旅程。";
			mes "请注意旅途安全。";
			mes "记得随时查看地图。";
			break;
		case 4:
			mes "[梦罗克向导]";
			mes "好吧，那么";
			mes "冒险者，外出时";
			mes "尽量别惹上";
			mes "太多麻烦。";
			close2;
			set .@loop1,0;
		}
	}
	cutin "moc_soldier",255;
	end;
}

morocc,54,97,0	duplicate(MocGuide)	Guide#2moc	707

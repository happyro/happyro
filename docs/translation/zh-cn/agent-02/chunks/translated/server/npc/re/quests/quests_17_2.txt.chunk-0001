ba_maison,70,145,3	script	Tamarin#ep172_bamaison-00	4_EP17_TAMARIN,{
	if (checkweight(1000103,5) == 0) {
		mes "- 你持有的物品太多。";
		mes "请整理物品栏后再试。-";
		close;
	}
	if (ep17_2_main == 7 || ep17_2_main == 8) {
		if (ep17_2_main == 7) {
			cutin "ep172_tamarin02",2;
			mes "[Tamarin]";
		mes "你来了？";
		mes "为什么这么晚？";
			next;
			cloakoffnpcself( "Dew#ep172_bamaison-00" );
			cloakoffnpcself( "Mark#ep172_bamaison-00" );
			cloakoffnpcself( "Magi#ep172_bamaison-00" );
			cutin "bu_mark1",2;
			mes "[Mark]";
		mes "抱歉～迪尤又突然消失了。";
			next;
			cutin "bu_du5",2;
			mes "[Dew]";
		mes "咔哈哈哈哈哈！！！";
		mes "你的衣服怎么回事！！";
			next;
		}
		else {
			cloakoffnpcself( "Dew#ep172_bamaison-00" );
			cloakoffnpcself( "Mark#ep172_bamaison-00" );
			cloakoffnpcself( "Magi#ep172_bamaison-00" );
		}
		cutin "ep172_tamarin03",2;
		mes "[Tamarin]";
		mes "他们说要登记才能在宅邸里活动，所以我登记后，他们突然把我的衣服换成了这样！";
		next;
		cutin "bu_du5",2;
		mes "[Dew]";
		mes "咕哈哈哈哈哈哈！！！";
		mes "我笑得肚子都痛了！！！";
		next;
		cutin "ep172_tamarin03",2;
		mes "[Tamarin]";
		mes "别笑了！";
		next;
		mes "[Tamarin]";
		mes "别笑了，马上登记。";
		mes "和门附近的阿尔法谈谈，她会把你登记为访客。";
		if (ep17_2_main == 7) {
			ep17_2_main = 8;
			completequest 11620;
			getitem 1000103,5;
			getexp 401075,0;
		}
		close2;
		cutin "",255;
		cloakonnpcself( "Dew#ep172_bamaison-00" );
		cloakonnpcself( "Mark#ep172_bamaison-00" );
		cloakonnpcself( "Magi#ep172_bamaison-00" );
		end;
	}
	if (ep17_2_main < 10) {
		mes "[Tamarin]";
	mes "我听说瓦尔蒙特的宅邸在佣兵叛乱时被烧毁了……我想这和书里写的很不一样。";
		cutin "ep172_tamarin01.bmp",2;
		close3;
	}

	// Start Library Quest
	if (ep17_2_library == 0) {
		cloakoffnpcself( "Dew#ep172_bamaison-00" );
		cloakoffnpcself( "Mark#ep172_bamaison-00" );
		cloakoffnpcself( "Magi#ep172_bamaison-00" );
		cutin "ep172_tamarin02",2;
		mes "[Tamarin]";
	mes "大家为什么都这样……";
		next;
		cutin "bu_du5",2;
		mes "[Dew]";
	mes "咔哈哈哈哈哈哈！！！！";
		next;
		cutin "ep172_tamarin03",2;
		mes "[Tamarin]";
	mes "别笑了！！！";
	mes "你应该换衣服的……";
		next;
		cutin "ep172_tamarin02",2;
		mes "[Tamarin]";
	mes "咔！！！！！！";
	mes "这个气味！！！！！！！！！！";
	mes "闻起来太糟了！！！！";
		next;
		cutin "bu_mark4",2;
		mes "[Mark]";
	mes "说起来，在明亮的地方看，你真脏。";
	mes "呃……你闻起来糟透了！！";
		next;
		cutin "bu_maggi3",2;
		mes "[Magi]";
	mes "迪尤。";
	mes "你身上有腐臭味……";
		next;
		cutin "bu_du1",2;
		mes "[Dew]";
	mes "咦？";
	mes "是因为我掉进下水道吗？";
		next;
		cutin "bu_du2",2;
		mes "[Dew]";
	mes "对！！";
	mes "听我说，我之前掉进下水道了，真的很危险！";
	mes "救命恩人是……";
		next;
		cutin "bu_mark3",2;
		mes "[Mark]";
	mes "你臭死了，别靠近我，笨蛋！！！";
		next;
		cutin "bu_du5",2;

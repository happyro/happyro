ba_pw01,87,290,3	script	Alp#ep172_bapw1-00	4_M_BLACKMAN,{
	if (ep17_2_main < 5) {
		cutin "bu_alp3",2;
		mes "[Alp]";
		mes "这台装置可以为一座城市供能……不，它能提供国家规模的能源。";
		mes "这台装置究竟是做什么的？";
		close3;
	}
	if (ep17_2_main == 5 || ep17_2_main == 6) {
		if (ep17_2_main == 5) {
			ep17_2_main = 6;
			erasequest 11617;
			setquest 11618;
		}
		cutin "bu_alp3",2;
		mes "[Alp]";
		mes "你来了……";
		mes "这边……";
		close2;
		cutin "",255;
		navigateto("ba_in01",20,319);
		warp "ba_in01",23,315;
		end;
	}
	mes "[����]";
	mes "��û�� ��ġ�顦";
	mes "���á� �ƴ� ���� ������ �Ը� �������� ������ �� �ְڱ�.";
	mes "��ü �� ���� �̷��� ������";
	cutin "bu_alp1.bmp",2;
	close3;

OnInit:
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "isbegin_quest(11617) == 1" );
	end;
}

ba_in01,20,319,3	script	Lasis#ep172_bain1-00	4_M_REBELLION,{
	if (ep17_2_main == 6 || ep17_2_main == 7) {
		mes "[Lasis]";
		mes "我们终于到了。";
		mes "我还要等人，我们就在这里分开吧。";
		next;
		mes "[Lasis]";
		mes "即使在这里分开，我想我也会在这片区域待一阵。有事就告诉我。";
		next;
		cloakoffnpcself( "Dew#ep172_bain01-00" );
		cloakoffnpcself( "Mark#ep172_bain01-00" );
		cloakoffnpcself( "Magi#ep172_bain01-00" );
		 npctalk "迪尤：哦，又是一间奇怪的房间？！我们不是应该出去吗？！哦！！！看那边的窗户。那里有好多惊人的机器！！！", "Dew#ep172_bain01-00", bc_self;
		cutin "bu_mark2",2;
		mes "[Mark]";
		mes "我们先走了。";
		mes "谢谢你，拉西斯。";
		next;
		cutin "bu_maggi2",2;
		mes "[Magi]";
		mes "回头见～";
		next;
		cutin "bu_mark2",2;
		mes "[Mark]";
		mes "通往内部的门锁上了，我们出去吧。";
		if (ep17_2_main == 6) {
			ep17_2_main = 7;
			erasequest 11618;
			setquest 11620;
		}
		close2;
		cutin "",255;
		cloakonnpcself( "Dew#ep172_bain01-00" );
		cloakonnpcself( "Mark#ep172_bain01-00" );
		cloakonnpcself( "Magi#ep172_bain01-00" );
		navigateto("ba_maison",70,145);
		end;
	}
	mes "[Lasis]";
	mes "话说回来，你为什么迟到了？";
	close;

OnInit:
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "isbegin_quest(11618) == 1" );
	end;
}


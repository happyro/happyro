// Main quest
ba_pw02,90,93,0	script	???????????????#ep172_bapw2-00	4_ENERGY_BLUE,{
	if (ep17_2_main == 2) {
		cutin "bu_du5",2;
		mes "[???????????????]";
		mes "呜呜呜呜呜呜呜呜！！！！";
		mes "咕呃呃呃……！！！";
		next;
		cutin "",255;
		mes "- 我循着奇怪的声音看去，发现一个似乎快要溺水的人。-";
		next;
		if (select( "帮助他。", "不管他。" ) == 2) {
			cutin "bu_du5",2;
			mes "[???????????????]";
			mes "呜呜呜……";
			close2;
			cutin "",255;
			cloakonnpcself( "Dew#ep172_bapw2-00" );
			end;
		}
		mes "- 他似乎已经无法行动。去给他找一片世界树叶吧。-";
		ep17_2_main = 3;
		erasequest 18001;
		setquest 11615;
		close2;
		cloakonnpcself( "Dew#ep172_bapw2-00" );
		end;
	}
	if (ep17_2_main == 3) {
		if (countitem(610) < 1) {
		mes "- 他似乎已经无法行动。去给他找一片世界树叶吧。-";
			close;
		}
		cloakoffnpcself( "Dew#ep172_bapw2-01" );
		mes "[Dew]";
		mes "咳咳！！！！";
		mes "呜呜呜。";
		delitem 610,1;
		ep17_2_main = 4;
		erasequest 11615;
		setquest 11616;
		next;
		mes "[Dew]";
		mes "呜哇！！！！";
		next;
		cutin "bu_du4",2;
		mes "[Dew]";
		mes "咳嗯……";
		mes "我还以为自己要死了！";
		next;
		mes "[Dew]";
		mes "谢谢你！！";
		mes "你救了我的命！";
		mes "我永远不会忘记你的恩情……";
		next;
		cutin "bu_du5",2;
		mes "[Dew]";
		mes "……啊！！";
		mes "啊啊啊啊啊啊啊啊！！";
		next;
		cutin "bu_du2",2;
		mes "[Dew]";
		mes "看看谁来了！！！";
		mes "" + strcharinfo(0) + "!!!";
		next;
		mes "[Dew]";
		mes "能在这种地方再次遇到你，真是命运！！！";
		next;
		cutin "bu_du3",2;
		mes "[Dew]";
		mes "如果不是你，我现在就会在普隆德拉教堂醒来！";
		mes "刚才我仿佛看到马克提着捐款袋，灿烂地对我微笑……";
		next;
		cutin "bu_du5",2;
		mes "[Dew]";
		mes "太可怕了……我不想……再想起它……";
		next;
		cutin "bu_du4",2;
		mes "[Dew]";
		mes "总之，先不说那个可怕的故事……你在这里救了我……";
		mes "你是来调查宅邸的吗？";
		next;
		cutin "bu_du2",2;
		mes "[Dew]";
		mes "不愧是我认可的对手！";
		mes "这里不是很棒吗？？？";
		mes "真不敢相信这个地方一直隐藏到现在……";
		next;
	}
	if (ep17_2_main == 4) {
		cloakoffnpcself( "Dew#ep172_bapw2-01" );
		cutin "bu_du1",2;
		mes "[Dew]";
		mes "现在不是说这些的时候！";
		mes "我们上去！！！";
		mes "现在！！";
		next;
		mes "[Dew]";
		mes "我敢肯定其他人会把所有乐趣都抢走！！！";
		next;
		cutin "bu_du3",2;
		mes "[Dew]";
		mes "好了，我们去和马克他们汇合吧。";
		mes "嗯……";
		mes "哦哦哦哦哦哦哦哦！！";
		next;
		cutin "bu_du1",2;
		mes "[Dew]";
		mes "好了，在那边！";
		mes "我好像听到玛姬的声音了！！！";
		close2;
		cutin "",255;
		navigateto("ba_pw01",14,115);
		cloakonnpcself( "Dew#ep172_bapw2-01" );
		end;
	}
	mes "- 这似乎是净化污水的装置。-";
	close;

OnInit:
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "isbegin_quest(18001) == 1 && BaseLevel > 130" );
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "isbegin_quest(11615) == 1 && countitem(610) > 0" );
	end;
}

ba_pw02,90,93,5	duplicate(dummy_cloaked_npc)	Dew#ep172_bapw2-00	4_M_REDMAN
ba_pw02,93,93,3	duplicate(dummy_cloaked_npc)	Dew#ep172_bapw2-01	4_M_REDMAN

ba_pw01,14,115,0	script	#ep172_ev_00	HIDDEN_WARP_NPC,2,2,{
	end;
OnTouch:
	if (ep17_2_main == 4) {
		cloakoffnpcself( "Magi#ep172_bapw1-00" );
		cutin "bu_maggi4",2;
		mes "[Magi]";
		mes "啊啊啊！！！";
		mes "别……别靠近我！！";
		mes "你再靠近我就攻击你！！！";
		next;
		cloakoffnpcself( "Dew#ep172_bapw1-00" );
		cutin "bu_du5",2;
		mes "[Dew]";
		mes "啊啊啊！！！";
		mes "玛姬！！！";
		next;
		mes "[Dew]";
		mes "这些家伙～～～";
		mes "你们竟敢这样，玛姬！";
		next;
		mes "[Dew]";
		mes "点火斩……！！！";
		next;
		cutin "",255;
		cloakoffnpcself( "Lasis#ep172_bapw1-00" );
		specialeffect EF_DESPERADO, AREA, "Lasis#ep172_bapw1-00";
		mes "[Lasis]";
		mes "玛姬，你没事吧？";
		mes "哪里受伤了吗？";
		mes "呼……我还以为是心脏猎人……在这种地方再次遭到伏击会很危险。";
		next;
		mes "[Lasis]";
		mes "呃……";
		mes "我用了大招，伤口很痛……";
		next;
		cutin "bu_maggi4",2;
		mes "[Magi]";
		mes "拉西斯，你的伤口才刚愈合，别勉强。不要太逞强！！！";
		mes "来，这边……";
		next;
		cutin "",255;
		mes "[Lasis]";
		mes "没事，马克的治疗技能几乎把我完全治好了。";
		next;
		cutin "bu_du1",2;
		mes "[Dew]";
		mes "玛姬，你没事吧？";
		mes "其他人在哪里？";
		mes "这个人是谁？";
		next;
		cutin "bu_maggi3",2;
		mes "[Magi]";
		mes "迪尤？！";
		mes "你去哪儿了！！";
		mes "你知道你突然消失时我有多担心吗？";
		mes "我们等了很久你都没出现，所以马克去找你了！";
		next;
		cutin "",255;
		mes "[Lasis]";
		mes "哦！";
		mes "这就是马克要找的人吗？";
		next;
		mes "[Lasis]";
		mes "很高兴见到你。";
		mes "我是叛乱军的拉西斯。";
		mes "你是迪尤，而你是……我以前在基地见过你……";
		next;
		cutin "bu_maggi1",2;
		mes "[Magi]";
		mes "我之前在上来的路上遇到了拉西斯。";
		mes "马克和我独处时，突然有大量敌人从四面八方出现。";
		next;
		cutin "bu_du3",2;
		mes "[Dew]";
		mes "也没有我……";
		next;
		cutin "",255;
		mes "砰！！！";
		next;
		cutin "bu_du4",2;
		mes "[Dew]";
		mes "哎哟！！！";
		next;
		cloakoffnpcself( "Mark#ep172_bapw1-00" );
		cutin "bu_mark3",2;
		mes "[Mark]";
		mes "你在做什么！！！";
		mes "你以为我在说什么？";
		mes "我说过不许到处乱跑！！！！";
		next;
		cutin "bu_du5",2;
		mes "[Dew]";
		mes "好痛！！！";
		next;
		cutin "bu_mark3",2;
		mes "[Mark]";
		mes "我的天。这个家伙真是……";
		mes "唉……";
		next;
		cutin "",255;
		mes "[Lasis]";
		mes "马克，看看这里。";
		next;
		cutin "bu_mark1",2;
		mes "[Mark]";
		mes "你确定吗？";
		next;
		cutin "",255;
		mes "[Lasis]";
		mes "是的，这是你之前击倒心脏猎人时我们得到的同一种宝石。";
		mes "不知道它真的只是一块宝石吗。";
		next;
		cutin "bu_mark1",2;
		mes "[Mark]";
		mes "心脏猎人持有这种东西，所以我确定它很重要。";
		mes "暂时先保管好。";
		mes "之后我会想办法弄清楚。";
		next;
		mes "[Mark]";
		mes "阿尔普通知我，他们回来的路上找到了门。趁情况还没变得更危险，我们上去吧。";
		ep17_2_main = 5;
		erasequest 11616;
		setquest 11617;
		close2;
		cutin "",255;
		cloakonnpcself( "Dew#ep172_bapw1-00" );
		cloakonnpcself( "Mark#ep172_bapw1-00" );
		cloakonnpcself( "Magi#ep172_bapw1-00" );
		cloakonnpcself( "Lasis#ep172_bapw1-00" );
		navigateto("ba_pw01",87,290);
		end;
	}
	if (ep17_2_main == 5) {
		cloakoffnpcself( "Mark#ep172_bapw1-00" );
		cutin "bu_mark1",2;
		mes "[Mark]";
	mes "阿尔普通知我，他们回来的路上找到了门。趁情况还没变得更危险，我们上去吧。";
		close2;
		cutin "",255;
		navigateto("ba_pw01",87,290);
		cloakonnpcself( "Mark#ep172_bapw1-00" );
		end;
	}
	end;

OnInit:
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "isbegin_quest(11616) == 1" );
	end;
}


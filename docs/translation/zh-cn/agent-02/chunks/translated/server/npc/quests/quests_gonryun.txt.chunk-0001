gon_in,17,93,5	script	Chief#gon	775,{
	if (BaseLevel > 50) {
		if (b_sword == 0) {
			set b_sword,1;
			mes "[Shi Yan Wen]";
			mes "嗯……？";
			mes "哦，你好~";
			mes "我是 Shi Yan Wen，这个村子的首领。";
			mes "请允许我亲自欢迎你来到昆仑。";
			next;
			mes "[Shi Yan Wen]";
			mes "虽然我们村子过去";
			mes "很少与其他城镇来往，";
			mes "但最近开始";
			mes "允许来自艾尔贝塔的访客。";
			next;
			mes "[Shi Yan Wen]";
			mes "我觉得这个城镇";
			mes "孤立太久了。";
			mes "所以这里的人还不太友好。";
			next;
			mes "[Shi Yan Wen]";
			mes "此外，最近我们一直被小偷困扰，";
			mes "他们在昆仑闹得太过分了……";
			mes "既然你来这里参观，";
			mes "希望你旅途愉快。";
			close;
		}
		else if (b_sword < 18) {
			switch (b_sword) {
			case 1:
				mes "[Shi Yan Wen]";
			mes "哦，你好~";
			mes "我是 Shi Yan Wen，这个村子的首领。";
			mes "请允许我亲自欢迎你来到昆仑。";
				next;
				mes "[Shi Yan Wen]";
			mes "虽然我们村子过去很少与其他城镇来往，";
			mes "但最近开始允许来自艾尔贝塔的访客。";
				next;
				mes "[Shi Yan Wen]";
			mes "我觉得这个城镇孤立太久了，";
			mes "所以这里的人还不太友好。";
				next;
				mes "[Shi Yan Wen]";
			mes "此外，最近我们一直被小偷困扰，";
			mes "他们在昆仑闹得太过分了……";
			mes "既然你来这里参观，";
			mes "希望你旅途愉快。";
				close;
			case 2:
				mes "[Shi Yan Wen]";
				mes "哦，是你~";
				mes "目前觉得这里怎么样？";
				mes "如你所见，";
				mes "村子并不太平，对吧？";
				next;
				if (select("还好。:我听说有人被偷了东西……") == 1) {
					mes "[Shi Yan Wen]";
					mes "那就好。";
					mes "小心盗贼，";
					mes "在村里尽量";
					mes "别表现得可疑。";
					close;
				}
				mes "[Shi Yan Wen]";
				mes "嗯……你听说过？";
				mes "抢劫就发生在昨晚。";
				mes "传言是真的。";
				mes "可悲的是，村里有很多小偷……";
				next;
				switch(select("......:What was stolen?:Was anyone hurt?")) {
				case 1:
					mes "[Shi Yan Wen]";
					mes "真不敢相信竟然发生了……";
					mes "如果你看到可疑人物，";
					mes "或找到被盗物品，请告诉我。";
					set b_sword,3;
					close;
				case 2:
					mes "[Shi Yan Wen]";
					mes "嗯……";
					mes "呃……那是……";
					mes "……只是普通的剑。";
					mes "但对我们来说，它是传承多代的家族宝物。";
					next;
					mes "[Shi Yan Wen]";
					mes "无论如何";
					mes "我都必须找到这把剑！";
					mes "……但我没法亲自去找，";
					mes "亲自去找。只是我太忙了。";
					next;
					mes "[Shi Yan Wen]";
					mes "你知道，做村长非常忙。";
					mes "这真令人烦恼……*叹气*";
					next;
					if (select("希望你早日找到。:我可以替你找吗？") == 1) {
						mes "[Shi Yan Wen]";
					mes "嗯……谢谢。";
					mes "如果你碰巧找到它，";
					mes "请告诉我。";
						set b_sword,11;
						close;
					}
					mes "[Shi Yan Wen]";
					mes "哦！~真的吗？？";
					mes "……村里的人最近";
					mes "这些天大家因为小偷";
					mes "都非常害怕。";
					mes "很难请他们帮忙……";
					next;
					mes "[Shi Yan Wen]";
					mes "如果你能帮我找到剑，我一定会报答你的努力。";
					set b_sword,3;
					close;
				case 3:
					mes "[Shi Yan Wen]";
					mes "幸运的是没有人受伤。";
					mes "不过小偷拿走了";
					mes "代代相传的";
					mes "珍贵家族宝物。";
					next;
					mes "[Shi Yan Wen]";
				mes "无论如何";
				mes "我都必须找到这把剑！";
					mes "……但我没法亲自去找，";
				mes "亲自去找。只是我太忙了。";
					next;
					mes "[Shi Yan Wen]";
				mes "你知道做村长非常忙。";
				mes "这真令人烦恼……*叹气*";
					next;
					if (select("希望你早日找到。:我可以替你找吗？") == 1) {
						mes "[Shi Yan Wen]";
					mes "嗯……谢谢。";
					mes "如果你碰巧找到它，";
					mes "请告诉我。";
						set b_sword,11;
						close;
					}
					mes "[Shi Yan Wen]";
					mes "哦！~真的吗？？";
					mes "……村里的人最近";
					mes "这些天大家因为小偷";
					mes "都非常害怕。";
					mes "很难请他们帮忙……";
					next;
					mes "[Shi Yan Wen]";
					mes "如果你能帮我找到剑，我一定会报答你的努力。";
					set b_sword,3;
					close;
				}
			case 3:
			case 4:
			case 5:
				mes "[Shi Yan Wen]";
				mes "还没找到吗？";
				mes "别急，慢慢来。";
				mes "帮助别人之前，";
				mes "先照顾好自己。";
				close;
			case 6:
				mes "[Shi Yan Wen]";
				mes "哦，你找到线索了？";
				mes "到目前为止，";
				mes "你做得很好。";
				mes "拿着这份家传药物，也许很快就能派上用场。";
				set b_sword,7;
				getitem 504,3; //White_Potion
				close;
			case 7:
				mes "[Shi Yan Wen]";
				mes "你最好知道，小偷受了伤，";
				mes "所以他应该就在附近。";
				close;
			case 8:
				mes "[Shi Yan Wen]";
				mes "什么……？";
				mes "我的剑被折断了！？";
				mes "难以置信~！！";
				mes "怎么会这样？？";
				next;
				mes "[Shi Yan Wen]";
				mes "先是被偷，现在又";
				mes "变成碎片……*抽泣*";
				mes "请你继续寻找";
				mes "剩下的剑身好吗？";
				mes "它对我的家族意义重大……";
				close;
			case 9:
				mes "[Shi Yan Wen]";
				mes "*Sob*...";
				mes "...my sword... in pieces...";
				mes "求求你，帮我找到它们";
				mes "我会给你回报。";
				close;
			case 10:
				mes "[Shi Yan Wen]";
				mes "哦！~";
				mes "你帮我找到了碎片~";
				mes "我就知道你能做到。";
				mes "但剑还是碎的。";
				mes "我该怎么办……？";
				next;
				mes "[Shi Yan Wen]";
				mes "如果你愿意，";
				mes "能帮我修复这把剑吗？";
				mes "我会报答你的帮助。";
				next;
				if (select("No way.:Alright.") == 1) {
					mes "[Shi Yan Wen]";
					mes "嗯，我明白了……你真是个";
					mes "善良的人。非常感谢你的努力。";
					mes "如果你能帮我修复这把剑";
					mes "就太好了，但我";
					mes "不会强迫你。";
					next;
					mes "[Shi Yan Wen]";
					mes "我会想办法修复它。";
					mes "没有你的帮助，";
					mes "我永远找不到它。";
					mes "请收下这个作为";
					mes "这是我的感谢信物……";
					set b_sword,15;
					getitem 603,1; //Old_Blue_Box
					next;
					mes "[Shi Yan Wen]";
					mes "如果你找到关于那个可恶小偷的";
					mes "任何信息或线索，请告诉我。";
					mes "虽然剑已经回来了，";
					mes "但我无法原谅他对祖先的冒犯……";
					close;
				}
				mes "[Shi Yan Wen]";
				mes "你真慷慨……";
				mes "我真的欠你一份人情……";
				mes "但我不知道这把剑";
				mes "为什么会碎成这样。";
				mes "你可能需要找一位著名铁匠来修复它。";
				next;
				mes "[Shi Yan Wen]";
				mes "正如我之前所说，这是重要的家族宝物……";
				mes "哦！我想起来了——";
				next;
				mes "[Shi Yan Wen]";
				mes "村里有个叫 ^555555Zuo Hei^000000 的人。";
				mes "他去过世界各地。";
				mes "也许知道这样的武器匠。请去找找他。";
				next;
				mes "[Shi Yan Wen]";
				mes "哦，还有最后一件事。这只是个小物件，";
				mes "请收下我的礼物。";
				set b_sword,14;
				getitem 603,1; //Old_Blue_Box
				close;
			case 11:
				mes "[Shi Yan Wen]";
				mes "村里最近气氛不太好，";
				mes "但昆仑还有很多值得一看的地方。";
				close;
			case 12:
				mes "[Shi Yan Wen]";
				mes "嗯……没有痕迹？没有线索？";
				mes "……什么都没有？好吧。";
				mes "谢谢你愿意帮忙。";
				mes "Hmm....";
				next;
				mes "[Shi Yan Wen]";
				mes "给……拿着这个。";
				mes "祝你在昆仑玩得开心~";
				set b_sword,13;
				getitem 504,1; //White_Potion
				close;
			case 13:
				mes "[Shi Yan Wen]";
				mes "一切还顺利吗？";
				mes "村里最近气氛不太好。";
				mes "不过，还是请好好享受这里。";
				close;
			case 14:
			case 15:
			case 16:
			case 17:
				mes "[Shi Yan Wen]";
				mes "我真的很感谢你所做的一切。";
				mes "终于有人处理这些盗窃案，";
				mes "让我如释重负。";
				next;
				mes "[Shi Yan Wen]";
				mes "也许村子终于能恢复和平，就像过去一样……";
				close;
			}
		}
		else if (b_sword < 32) {
			mes "[Shi Yan Wen]";
			mes "我很感谢你所做的一切，你的帮助让我如释重负。";
			mes "村里的气氛没那么紧张了，和过去很像。";
			next;
			mes "[Shi Yan Wen]";
			mes "虽然我希望你能尽快修好我的剑，";
			mes "但你已经为我做了很多。";
			mes "再要求你做更多，我很过意不去。";
			close;
		}
		else if (b_sword == 32) {
			if (countitem(1123) < 1) {
				mes "[Shi Yan Wen]";
				mes "Hm.....";
				mes "Not finished yet, huh?";
				mes "Still, it's good to know";
				mes "it's being repaired...";
				mes "那我等着。";
				close;
			}
			mes "[Shi Yan Wen]";
			mes "哦，是你啊~你好。";
			mes "............";
			mes "那是我的剑吗？";
			mes "哇，你做到了！";
			mes "干得好！";
			next;
			mes "[Shi Yan Wen]";
			mes "这是给你的小礼物。";
			mes "请收下，感谢你出色完成任务！";
			delitem 1123,1; //Haedonggum
			set b_sword,33;
			getitem 2404,1; //Shoes_
			next;
			mes "[Shi Yan Wen]";
			mes "谢谢你的所有努力。";
			mes "剑修好后，我不再觉得";
			mes "自己辜负了祖先……";
			mes "嘿嘿……";
			mes "祝你在昆仑玩得愉快。";
			close;
		}
		mes "[Shi Yan Wen]";
		mes "哦，是你~";
		mes "再次感谢你";
		mes "提供的所有帮助。";
		mes "希望你在村里过得愉快。";
		mes "嘿嘿~";
		close;
	}
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
	//
	mes "[Shi Yan Wen]";
	mes "嗯……？";
	mes "哦，你好~";
	mes "我是 Shi Yan Wen，这个村子的首领。";
	mes "请允许我亲自欢迎你来到昆仑。";
	next;
	mes "[Shi Yan Wen]";
	mes "虽然我们村子过去很少与其他城镇来往，";
	mes "但最近开始允许来自艾尔贝塔的访客。";
	next;
	mes "[Shi Yan Wen]";
	mes "我觉得这个城镇孤立太久了。";
	mes "所以";
	mes "所以这里的人还不太友好。";
	next;
	mes "[Shi Yan Wen]";
	mes "此外，最近我们一直被小偷困扰，";
	mes "他们在昆仑闹得太过分了……";
	mes "既然你来这里参观，";
	mes "希望你旅途愉快。";
	close;
}

gon_in,152,35,4	script	Hostess#gon	702,{
	if (b_sword < 1) {
		mes "[Mei Yen Fang]";
		mes "哦……你是新来的吧？";
		mes "从外地来的吗？";
		mes "最近经常能看到";
		mes "外国人。";
		mes "村里因此热闹起来了。";
		next;
		mes "[Mei Yen Fang]";
		mes "哦，我在说什么……";
		mes "要喝点酒吗？";
		next;
		if (select("Yes, please:No, it's okay.") == 1) {
			mes "[Mei Yen Fang]";
			mes "哎呀~！糟糕……";
			mes "刚才来了很多客人，";
			mes "所以酒已经卖光了……";
			mes "客人越来越多，越来越难应付了……";
			close;
		}
		mes "[Mei Yen Fang]";
		mes "好好享受村里的时光。";
		mes "以后再来看看。";
		close;
	}
	switch(b_sword) {
	case 1:
	case 2:
		mes "[Mei Yen Fang]";
		mes "嘿，你知道吗？";
		mes "首领家昨晚被盗了。";
		mes "真不敢相信会发生这种事……";
		mes "我猜是那些小偷干的……";
		next;
		mes "[Mei Yen Fang]";
		mes "真让人担心……";
		mes "甚至可能发生在我身上！";
		mes "我最好小心点……";
		mes "哦，我在说什么呢？";
		mes "在我的店里好好享受吧……呵呵~";
		set b_sword,2;
		close;
	case 3:
		mes "[Mei Yen Fang]";
		mes "哦，又是你~";
		mes "我听说你决定";
		mes "帮助我们的首领。";
		mes "请为他尽力！";
		mes "村里每个人";
		mes "都很紧张……";
		next;
		mes "[Mei Yen Fang]";
		mes "你看到那边靠着桌子的人了吗？";
		mes "他似乎知道昨晚发生了什么，";
		mes "但……";
		mes "他整晚都在喝酒。";
		set b_sword,4;
		close;
	}
	if (b_sword > 3 && b_sword < 11) {
		mes "[Mei Yen Fang]";
		mes "你好~";
		mes "感受到村里的紧张气氛了吗？";
		mes "都是那些小偷造成的……";
		next;
		mes "[Mei Yen Fang]";
		mes "他们也让我的生意很难做……";
		mes " ";
		mes "*Sigh*";
		close;
	}
	else if (b_sword == 11 || b_sword == 12) {
		mes "[Mei Yen Fang]";
		mes "感受到村里的紧张气氛了吗？";
		mes "希望小偷能尽快被抓住。";
		mes "...";
		close;
	}

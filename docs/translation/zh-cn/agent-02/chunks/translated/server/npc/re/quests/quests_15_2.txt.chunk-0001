//===== rAthena Script =======================================
//= Phantasmagorika Quests (episodes 15.2).
//===== Description: =========================================
//= [Official Conversion]
//--- Memory Record Daily Quests:
//- 'Help Her'
//- 'Air Purifier'
//- 'Grape Harvest'
//- 'Subdue Hysterical Patients'
//- 'Daily Necessities Transport'
//--- Others Quests:
//- Final part of the Phantasmagorika Main Quest
//- 'Vestige' (part 3 of 'To Phantasmagorika!')
//- 'Krotzel's Request'
//===== Changelogs: ==========================================
//= 1.0 First version. [Capuche]
//= 2.0 Updated using Aegis files [Capuche]
//============================================================

// Main quest
moc_para01,133,170,4	script	Commander Arquien#e152a1	4_F_EDEN_MASTER,{
	if (checkweight(1301,3) == 0) {
		mes "- 你携带的物品太多，无法继续任务。-";
		close;
	}
	if (ep15_1_atnad == 0) {
		cutin "Arquien_n_atnad02.bmp",2;
		mes "[阿奎恩指挥官]";
		mes "嗯？我不知道你是谁，但未经许可别进来。";
		mes "请你马上离开。";
		close3;
	}
	if (ep15_1_atnad < 3) {
		if (ep15_1_atnad == 1) {
			mes "[阿奎恩指挥官]";
			cutin "Arquien_n_atnad01.bmp",2;
			mes "哦，你就是那位著名的" + strcharinfo(0) + "?";
			mes "我本该给你茶之类的东西，但我没有茶。";
			mes "很抱歉。";
			next;
			mes "[阿奎恩指挥官]";
			mes "先自我介绍。我是伊甸园集团创始人兼指挥官阿奎恩·尼尔·阿特纳德。";
			mes "我的名字很复杂，叫我尼尔就好。";
			next;
			switch( select( "你为什么来见我？", "你的中间名？" ) ) {
			case 1:
				cutin "Arquien_n_atnad03.bmp",2;
				mes "[Nile]";
				mes "嗯，直入主题？";
				mes "我喜欢这样。";
				mes "你知道最近城里最大的传闻是什么吗？";
				break;
			case 2:
				mes "[Nile]";
				mes "这是我小时候母亲给我的名字……";
				mes "听起来比那个该死的父亲给我的名字舒服，好吗？";
				next;
				mes "[Nile]";
				mes "与其对别人的私生活感兴趣，不如关注别的事？";
				mes "最近大家都在谈论它。";
				break;
			}
			next;
			cutin "Arquien_n_atnad01.bmp",2;
			mes "[Nile]";
			mes "没错。关于朱比特遗迹的扩展挖掘。";
			mes "他们已经尽可能挖掘了……";
			mes "人们把它当作未知机械文明、科学力量的产物，翻来覆去讨论也有一段时间了吧？";
			next;
			mes "[Nile]";
			mes "那么……为什么现在又宣传并招募挖掘者？";
			mes "你没看到小队办公室张贴的招募公告吗？";
			next;
			mes "[Nile]";
			mes "首先，这是我们掌握的信息。";
			mes "朱比特遗迹区域发现了一条新通道。";
			mes "所以我们以为那是朱比特遗迹的另一个区域……";
			next;
			mes "[Nile]";
			mes "令人惊讶的是，新区域与朱比特遗迹相连，却是一个形态不同的地点。";
			mes "这次挖掘的目标就是那个新区域。";
			next;
			cutin "Arquien_n_atnad04.bmp",2;
			mes "[Nile]";
			mes "名字……是什么来着。啊……我不知道。";
			mes "通常称为“幻象学”计划。";
			mes "利赫泰伦的雷根贝勒负责挖掘招募和支援。";
			next;
			select("所以呢？");
			mes "[Nile]";
			mes "嗯？没那么有趣？";
			mes "要我就讲到这里？";
			mes "因为拉希姆推荐了你，我才做了准备。";
			next;
		if (select( "请继续。", "请停止。" ) == 2) {
				cutin "Arquien_n_atnad02.bmp",2;
				mes "[Nile]";
				mes "好吧，我也没兴趣继续告诉一个不感兴趣的人。";
				mes "登记在伊甸园集团名下的不只有你。";
				next;
				mes "[Nile]";
				mes "我该让拉希姆推荐其他人。";
				mes "明白了，现在走吧。";
				ep15_1_atnad = 2;
				close3;
			}
			cutin "Arquien_n_atnad01.bmp",2;
			mes "[Nile]";
			mes "当然。我们也想参加幻象学计划。";
		}
		else {
			cutin "Arquien_n_atnad02.bmp",2;
			mes "[Nile]";
			mes "……什么，你现在又感兴趣了？";
			next;
			if (select("是","不。") == 2) {
				cutin "Arquien_n_atnad01.bmp",2;
				mes "[Nile]";
				mes "如你所愿。";
				close3;
			}
			cutin "Arquien_n_atnad01.bmp",2;
			mes "[Nile]";
			mes "要我继续说吗？";
			mes "我们也想参加幻象学计划。";
		}
		mes "当然是以伊甸园集团的名义。";
		next;
		mes "[Nile]";
		mes "虽然我们主要作为客户和执行者之间的中介，";
		mes "也不能永远困在梦罗克。";
		next;
		mes "[Nile]";
		mes "拉希姆认为我们可以利用这个机会继续前进。";
		mes "通过这项工作，我们结识了许多像你一样的冒险者和强大战士，建立了人脉……";
		next;
		cutin "Arquien_n_atnad03.bmp",2;
		mes "[Nile]";
		mes "我是说我们想利用你的人力。我们不就是介绍人力资源的专家吗？啊哈哈哈哈哈～";
		next;
		cutin "Arquien_n_atnad01.bmp",2;
		mes "[Nile]";
		mes "说实话，是那个出了名傲慢的雷根贝勒请求我们。";
		mes "他们需要大量人手，所以需要我们做中介。";
		next;
		mes "[Nile]";
		mes "提议不错。老实说，这是个好机会。";
		mes "我们介绍人并获得报酬，你工作并获得报酬。";
		next;
		select("想参加幻象学吗？");
		mes "[Nile]";
		mes "大致就是这样。";
		mes "基本上你会参加现场挖掘工作，但";
		mes "也可以顺便帮忙处理私人请求。";
		next;
		mes "[Nile]";
		mes "如果你加入挖掘队，能帮我确认一件事吗？";
		mes "拉希姆会告诉你更多细节……";
		next;
		mes "[Nile]";
		mes "我只有一个要求。";
		mes "目前有多支挖掘队和组织参加幻象学挖掘。";
		mes "我希望你加入拉希姆介绍的挖掘队。";
		next;
		cutin "Arquien_n_atnad02.bmp",2;
		mes "[Nile]";
		mes "另外，在挖掘队工作时，^4d4dff询问最后探索^000000。";
		mes "拉希姆会告诉你详情。";
		next;
		cutin "Arquien_n_atnad01.bmp",2;
		mes "[Nile]";
		mes "就在隔壁房间，你可以在那里了解详情。";
		mes "如果发现什么就告诉我，不必告诉其他人。";
		mes "马上回来这里。明白了吗？";
		ep15_1_atnad = 3;
		erasequest 7607;// Eden Group Leader
		setquest 7608;// Atnad Excavation Team 1
		close3;
	}
	if (ep15_1_atnad == 3) {
		cutin "Arquien_n_atnad04.bmp",2;
		mes "[Nile]";
		mes "拉希姆在隔壁房间等你。";
		mes "他是最先开始这项工作的人，去向他了解详情。";
		close3;
	}
	if (ep15_1_atnad == 4) {
		cutin "Arquien_n_atnad01.bmp",2;
		mes "[Nile]";
		mes "嘿，你现在要认真开始了吗？";
		mes "那你还在这里做什么？现在就跑吧！";
		next;
		cutin "Arquien_n_atnad04.bmp",2;
		mes "[Nile]";
		mes "跑去替我看看那个傲慢的医生。";
		mes "啊……他没有饿着、变虚弱吧？嗯？";
		mes "观察后告诉我。";
		next;
		mes "[Nile]";
		mes "现在！马上去！";
		close3;
	}
	if (ep15_1_atnad < 21) {
		cutin "Arquien_n_atnad01.bmp",2;
		mes "[Nile]";
		mes "挖掘队工作怎么样？";
		mes "……拉希姆还好吗？";
		next;
		cutin "Arquien_n_atnad02.bmp",2;
		mes "[Nile]";
		mes "……那个老头。他还好吗？什么？是吗？现在这样或许很可笑又幼稚。";
		mes "该死！我不知道。出去！";
		close3;
	}
	if (ep15_1_atnad == 21) {
		cutin "Arquien_n_atnad03.bmp",2;
		mes "[Nile]";
		mes "嗯？发生什么事了？";
		mes "如果是报告，我会通过卢克收到。";
		mes "听说你工作很努力？";
		next;
		mes "[Nile]";
		mes "多亏如此，你在阿特纳德挖掘队和伊甸园集团中的地位都提高了，很好。";
		mes "……如果不是我那该死的父亲就更好了。";
		next;
		cutin "Arquien_n_atnad01.bmp",2;
		mes "[Nile]";
		mes "总之，你为什么来？";
		mes "你知道最后探索的事了吗？";
		next;
		mes "[Nile]";
		mes "他让你带东西回来？";
		mes "是什么？";
		next;
		input .@string$;
		while(.@string$ != "Record Player" && .@string$ != "record player" && .@string$ != "Record player") {
			cutin "Arquien_n_atnad01.bmp",2;
			mes "[Nile]";
			mes "我不确定你在说什么，但是……";
			mes "他让你带回来？";
			mes "我为什么要？";
			next;
			mes "[Nile]";
			mes "准确告诉我你要带回什么。";
			next;
			input .@string$;
		}
		cutin "Arquien_n_atnad02.bmp",2;
		mes "[Nile]";
		mes "嗯……唱片机？";
		mes "他居然记得房子里有那种东西？";
		next;
		cutin "Arquien_n_atnad04.bmp",2;
		mes "[Nile]";
		mes "我不知道这会如何影响你的地位，但是……";
		mes "我觉得不行。";
		mes "拒绝！";
		ep15_1_atnad = 22;
		close3;
	}
	if (ep15_1_atnad == 22) {
		cutin "Arquien_n_atnad02.bmp",2;
		mes "[Nile]";
		mes "......";
		next;
		mes "[Nile]";
		mes "......";
		mes "........";
		next;
		cutin "Arquien_n_atnad04.bmp",2;
		mes "[Nile]";
		mes "该死。";
		mes "好，我明白了。";
		mes "我有唱片机。";
		mes "如果你有记忆记录就交给我！";
		next;
		if (countitem(6757) < 1) {
			cutin "Arquien_n_atnad04.bmp",2;
			mes "[Nile]";
			mes "什么？没有？";
			mes "嗯……这很糟，";
			mes "想拿到唱片机。";
			mes "带来记忆唱片机！";
			close3;
		}
		cutin "Arquien_n_atnad01.bmp",2;
		mes "[Nile]";
		mes "嗯……是这个吗？";
		mes "看起来能装上。";
		mes "你是说这个来自那个地方？";
		mes "不过这可能有点难。";
		next;
		mes "[Nile]";
		mes "我愚蠢的父亲因为忙于外面的事，根本不在乎房子里的东西。";
		mes "他怎么会没注意到这种东西。";
		next;
		mes "[Nile]";
		mes "哼。遗憾的是，我认为有人故意拆开了这份记忆记录。";
		mes "只有一块无法运转。";
		mes "我至少需要五块。";
		next;
		mes "[Nile]";
		mes "嗯……";
		mes "好。那么就这样吧。";
		mes "我会带着唱片机去挖掘现场。";
		next;
		mes "[Nile]";
		mes "这期间你收集剩余的记忆记录。";
		mes "有人可能故意拆开了它，所以碎片会散落各处。";
		next;
		mes "[Nile]";
		mes "你明白我说的话了吗？";
		mes "那我们在维鲁斯见。";
		erasequest 7644;// Record Player
		setquest 7645;// Piece of Memory Record
		ep15_1_atnad = 23;
		close3;
	}
	if (ep15_1_atnad == 23) {
		cutin "Arquien_n_atnad01.bmp",2;
		mes "[Nile]";
		mes "收集^4d4dff5块记忆记录之类的物品^000000。";
		mes "它们会藏在维鲁斯各处，祝你好运。";
		next;
		mes "[Nile]";
		mes "……你……我去挖掘现场……";
		mes "对我父亲保密……";
		mes "..嗯……";
		mes "好吧，也没有特别理由要保密。";
		mes "随你。";
		close3;
	}
	cutin "Arquien_n_atnad01.bmp",2;
	mes "[Nile]";
	mes "我不会因为好奇亲自去那里。";
	mes "我自己也很忙。";
	close3;
}

lhz_in01,277,234,3	script	Rekenber Guard#e152i01	4_M_LGTGUARD,{
	mes "[Rekenber Guard]";
	if (ep15_1_atnad < 31) {
		mes "抱歉，未经批准你不能继续进入。";
		close;
	}
	mes "你是阿特纳德挖掘队成员。";
	mes "我会带你进去。";
	close2;
	warp "lhz_in01",275,241;
	end;
}

lhz_in01,275,251,3	script	Luke Lapez#ep152i01	4_M_EDEN_GUARDER,{
	cutin "looke_rapez04.bmp", 0;
	mes "[Luke]";
	mes "嘘。我只是来护送的。";
	close2;
	cutin "",255;
	npctalk "这该死的护送真够呛……", "Luke Lapez#ep152i01";
	setpcblock PCBLOCK_NPC, true;
	sleep2 500;
	setpcblock PCBLOCK_NPC, false;
	emotion ET_FRET, getnpcid(0, "Commander Arquien#ep152i");
	emotion ET_THINK, getnpcid(0, "Luke Lapez#ep152i01");
	end;
}

lhz_in01,270,257,4	script	Rekenber Chairman#e152i	4_M_REKENBER,{
	if (ep15_1_atnad < 31)
		end;
	if (ep15_1_atnad == 31) {
		cutin "ep15_rekenber01.bmp",0;
		mes "[Rekenber Chairman]";
		mes "我是雷根贝勒的主席。";
		mes "是我邀请你来的。";
		next;
		mes "[Rekenber Chairman]";
		mes "我听说了很多，也熟悉阿特纳德挖掘队的活动。";
		mes "作为公司，你们取得了许多重大成果。";
		mes "多亏了你们。";
		next;
		mes "[Rekenber Chairman]";
		mes "我邀请你的原因……";
		mes "你作为队长阿特纳德博士，可能已经知道了。";
		next;
		cutin "verus_ian02.bmp",2;
		mes "[Ian Atnad]";
		mes "难道是……";
		next;
		cutin "ep15_rekenber01.bmp",0;
		mes "[Rekenber Chairman]";
		mes "正如你猜测的那样。";
		mes "是关于你们努力收集的记忆记录内容。";
		next;
		mes "[Rekenber Chairman]";
		mes "我们计划销毁通过记忆记录得知的内容，以及记忆记录本身，就当一切从未发生。";
		mes "希望你能配合。";
		next;
		select("你说什么？");
		mes "[Rekenber Chairman]";
		mes "如果这些信息泄露出去，公司愿意优待你们的挖掘队。";
		next;
		cutin "verus_ian03.bmp",2;
		mes "[Ian Atnad]";
		mes "优待？礼遇？";
		mes "你到底想推销什么！";
		next;
		mes "[Ian Atnad]";
		mes "为什么人们不能知道地下城市的过去！";
		mes "你凭什么这样做！";
		next;
		mes "[Ian Atnad]";
		mes "我们是通过过去追寻真相与事实的人。";
		mes "你现在是想蒙住自己的眼睛和耳朵吗？";
		next;
		cutin "ep15_tatio01.bmp",0;
		mes "[首席秘书]";
		mes "作为替代，我们会把与记忆记录有关的一切独家权利交给你们。";
		next;
		cutin "verus_ian02.bmp",2;
		mes "[Ian Atnad]";
		mes "你现在又在说什么？";
		next;
		cutin "ep15_tatio01.bmp",0;
		mes "[首席秘书]";
		mes "我们不是要你们停止工作。";
		mes "也不是要你们丢弃所有发现的信息。";
		mes "不过，我们想要的是……";
		next;
		mes "[首席秘书]";
		mes "我想把我和你之间的故事埋葬。";
		mes "你不记得了吗？";
		mes "我们应该认识。";
		mes "虽然我已经做了一些准备。";
		next;
		cutin "verus_ian02.bmp",2;
		mes "[Ian Atnad]";
		mes "……现在想想，你确实很眼熟……";
		mes "朱比特遗迹！";
		mes "是的，我在朱比特遗迹见过你。";
		next;
		cutin "verus_ian03.bmp",2;
		mes "[Ian Atnad]";
		mes "那次你在……看起来像通道的裂缝里……";
		mes "……你袭击了我！";
		mes "你这个混蛋……都是因为你……！！";
		next;
		cutin "verus_aures.bmp",0;
		mes "[Aures]";
		mes "呵呵。我见到了毁灭我家族的主犯。";
		mes "这是命中注定吗？";
		next;
		select("你说的家族毁灭是什么意思？");
		mes "[Aures]";
		mes "那段时间，那场事故，或者你怎么称呼它。";
		mes "我在朱比特遗迹挖掘中发现一个似乎是人工制造的障碍……";
		mes "伊恩突然消失了。";
		emotion ET_SURPRISE, getnpcid(0, "Commander Arquien#ep152i");
		next;
		cutin "verus_ian01.bmp",2;
		mes "[Ian Atnad]";
		mes "我醒来时发现自己在朱诺的旅馆房间里。";
		mes "我甚至不知道过去了多长时间。";
		next;
		cutin "verus_aures.bmp",0;
		mes "[Aures]";
		mes "那个人去查看挖掘现场，超过一周都没有回来……";
		mes "你觉得我们会怎么想？";
		mes "我们以为他遭遇了不幸的事故。";
		next;
		cutin "verus_ian01.bmp",2;
		mes "[Ian Atnad]";
		mes "每当想起那段时间，我就咬牙切齿。";
		mes "因为那段模糊的记忆……";
		mes "我像疯子一样执着于朱比特遗迹。";
		next;
		cutin "ep15_tatio02.bmp",0;
		mes "[首席秘书]";
		mes "……对此我很抱歉。";
		next;
		cutin "verus_ian01.bmp",2;
		mes "[Ian Atnad]";
		mes "袭击我的人就是你，对吧？";
		mes "我失去的那一周到底发生了什么。";
		mes "……之后，我追逐着一个无法确定是梦还是幻觉的幻影。";
		next;
		mes "[Ian Atnad]";
		mes "我盲目地在朱比特遗迹四处游走。";
		mes "我失去了队员……甚至忘了自己还有家人和可以回去的家。";
		next;

yuno,153,47,4	script	Juno Guide#yuno	700,{
	mes "[尹女士]";
	mes "这里将未来的愿景化为现实。欢迎来到";
	mes "朱诺城！";
	next;
	switch(select("武器店:道具店:贤者城堡（贤者转职处）:书店街:朱菲罗广场:共和国图书馆:施瓦希尔比尔魔法学院:怪物博物馆:锻造所:机场:结束对话")) {
	case 1:
		viewpoint 1,120,138,0,0xFF3355;
		mes "[尹女士]";
		mes "请查看";
		mes "小地图。";
		mes "^FF3355+^000000 -> 武器店";
		mes "谢谢，";
		mes "祝你今天愉快。";
		close;
	case 2:
		viewpoint 1,193,142,1,0x3355FF;
		mes "[尹女士]";
		mes "请查看";
		mes "小地图。";
		mes "^3355FF+^000000 -> 道具店";
		mes "谢谢，";
		mes "祝你今天愉快。";
		close;
	case 3:
		viewpoint 1,90,318,2,0x33FF55;
		mes "[尹女士]";
		mes "请查看";
		mes "小地图。";
		mes "^33FF55+^000000 -> 贤者城堡";
		mes "（贤者转职处）";
		mes "谢谢，祝你今天愉快。";
		close;
	case 4:
		viewpoint 1,257,102,3,0xFF3355;
		mes "[尹女士]";
		mes "请查看";
		mes "小地图。";
		mes "^FF3355+^000000 -> 书店街";
		mes "谢谢，祝你今天愉快。";
		close;
	case 5:
		viewpoint 1,157,170,4,0x3355FF;
		mes "[尹女士]";
		mes "请查看";
		mes "小地图。";
		mes "^3355FF+^000000 -> 朱菲罗广场";
		mes "谢谢，";
		mes "祝你今天愉快。";
		close;
	case 6:
		viewpoint 1,336,204,5,0x33FF55;
		mes "[尹女士]";
		mes "请查看";
		mes "小地图。";
		mes "^33FF55+^000000 -> 共和国图书馆";
		mes "谢谢，祝你今天愉快。";
		close;
	case 7:
		viewpoint 1,323,281,6,0xFF3355;
		mes "[尹女士]";
		mes "请查看小地图。";
		mes "^FF3355+^000000 -> 施瓦希尔比尔魔法学院";
		mes "谢谢，祝你今天愉快。";
		close;
	case 8:
		viewpoint 1,278,288,7,0x3355FF;
		mes "[尹女士]";
		mes "请查看小地图。";
		mes "^3355FF+^000000 -> 怪物博物馆";
		mes "谢谢，祝你今天愉快。";
		close;
	case 9:
		viewpoint 1,120,138,8,0xFF3355;
		mes "[尹女士]";
		mes "请查看小地图。";
		mes "^FF3355+^000000 -> 锻造所";
		mes "锻造所位于武器店下方。";
		mes "谢谢，祝你今天愉快。";
		close;
	case 10:
		viewpoint 1,53,214,9,0xFF3355;
		mes "[尹女士]";
		mes "请查看小地图。";
		mes "^FF3355+^000000 -> 机场";
		mes "谢谢，祝你今天愉快。";
		close;
	case 11:
		mes "[尹女士]";
		mes "这是智者之城。";
		mes "知识之城！";
		mes "欢迎来到朱诺。";
		close;
	}
}

		mes "[Goni]";
	mes "*点头*";
		close3;
	case 1:
		cutin "16go_01",0;
		mes "[Goni]";
	mes "……";
		next;
		cutin "16loo_01",2;
		cloakoffnpcself( "Rookie#rm171_1" );
		cloakoffnpcself( "Elena Volkova#rm171_2" );
		cloakoffnpcself( "Philopontes#rm171_1" );
		mes "[Rookie]";
	mes "啊，你来得很早。我以为你休息后会晚些来。";
	mes "懒惰先生，请把囚犯带出来。";
		next;
		cutin "16lei_01",2;
		cloakoffnpcself( "Lazy#rm171_1" );
		cloakoffnpcself( "Elyumina#rm171_1" );
		mes "[Lazy]";
	mes "是，长官。他在这里。";
	mes "我们才见面没多久，你就开始对我指手画脚了。";
		next;
		emotion 14, getnpcid(0,"Lazy#rm171_1");
		emotion 6, getnpcid(0,"Rookie#rm171_1");
		mes "[Lazy]";
	mes "我就知道你有这本事，幸运的菜鸟。我看人很准。我真厉害！";
		npctalk "懒惰：我迫不及待想把你拉到我这边。光是想想就让我兴奋！", "Lazy#rm171_1", bc_self;
		npctalk "菜鸟：……别在别人面前说这种话。", "Rookie#rm171_1", bc_self;
		next;
		cutin "ep171_elyumina02",0;
		npctalk "懒惰：哦～～真霸道！我也喜欢你这一点。", "Lazy#rm171_1", bc_self;
		emotion 6, getnpcid(0,"Elyumina#rm171_1");
		mes "[Elyumina]";
	mes "啊，你们这些笨蛋！别粗暴地对我！我的身体很宝贵！比你们这些肌肉笨蛋加起来都值钱！";
		next;
		cutin "16lei_01",2;
		mes "[Lazy]";
	mes "哎呀，抱歉。菜鸟，祝你好运。";
		completequest 16358;
		setquest 16359;
		close3;
	case 2:
		if (isbegin_quest(16359) < 2) {
			cloakoffnpcself( "Rookie#rm171_1" );
			cloakoffnpcself( "Elena Volkova#rm171_2" );
			cloakoffnpcself( "Philopontes#rm171_1" );
			cloakoffnpcself( "Lazy#rm171_1" );
			cloakoffnpcself( "Elyumina#rm171_1" );
		}
		cutin "16go_01",0;
		mes "[Goni]";
		mes "...";
		next;
		mes "[Goni]";
		mes "...?";
		close3;
	}
	end;

OnInit:
	questinfo (QTYPE_QUEST, QMARK_YELLOW, " isbegin_quest(16358) == 1 ");
	end;
}

sp_cor,135,216,5	script	Rookie#rm171_1	4_M_ROOKIE,{
	switch (isbegin_quest(16359)) {
	case 0:
		cutin "16loo_01",2;
		mes "[Rookie]";
	mes "不该发生这种事。";
	mes "请联系行动队。";
		close3;
	case 1:
		cutin "16loo_01",2;
		mes "[Rookie]";
	mes "呃，那么……";
	mes "（我真的在审问他吗？）";
		emotion 21, getnpcid(0,"Lazy#rm171_1");
		emotion 21, getnpcid(0,"Elena Volkova#rm171_2");
		npctalk "*Nod*", "Lazy#rm171_1", bc_self;
		npctalk "*Nod*", "Elena Volkova#rm171_2", bc_self;
	npctalk "埃尔尤米娜：放开我！呃，我不会逃跑！我的智能机器和愚蠢下属在哪里？", "Elyumina#rm171_1", bc_self;
		next;
		emotion 4, getnpcid(0,"Rookie#rm171_1");
		cutin "16loo_03",2;
		mes "[Rookie]";
	mes "……喂，冷静点。你没有资格要求任何事。";
	mes "你给我们造成了严重损失。";
		next;
		cutin "ep171_elyumina02",0;
		emotion 7, getnpcid(0,"Elyumina#rm171_1");
		mes "[Elyumina]";
	mes "闭嘴！那你对我造成的损失呢？";
	mes "你们入侵我的实验室，还想偷走我的研究成果！";
		next;
	npctalk "菜鸟：偷窃？这可不好。", "Rookie#rm171_1", bc_self;
		cutin "16loo_01",2;
		mes "[Rookie]";
	mes "如果你指的是非法实验成果，";
	mes "你难道不知道总有一天会惹上麻烦吗？";
		next;
		mes "[Rookie]";
	mes "不过那不重要。你很在乎自己的研究，对吧？";
	mes "和我们合作，我们会帮你继续研究。";
		next;
		mes "[Rookie]";
	mes "当然只能是合法的部分。但我们会确保你能保留它。所以，把你知道的关于这里和同事的一切告诉我们。";
		next;
		cutin "ep171_elyumina03",0;
		mes "[Elyumina]";
	mes "我的同事？我才不在乎那些疯子。";
	mes "他们不是我的同事。我只是用他们进行研究。";
		next;
		cutin "16loo_01",2;
		mes "[Rookie]";
	mes "说起来，公司的员工名单上没有你的名字。";
	mes "你是谁？你需要他们做什么研究？";
		next;
		cutin "ep171_elyumina01",0;
		mes "[Elyumina]";
	mes "你不知道我是谁吗？我是施瓦茨瓦德——不，是大陆最伟大的机器学习研究员。我敢说你们都见过我的服务机器人。";
		next;
		cutin "16loo_03",2;
		mes "[Rookie]";
	mes "……没有。";
		npctalk "你见过吗？", "Elena Volkova#rm171_2", bc_self;
		npctalk "没有。", "Lazy#rm171_1", bc_self;
		next;
		cutin "ep171_elyumina01",0;
		mes "[Elyumina]";
	mes "哼，你们可能连它们是服务机器人都不知道。";
	mes "我差一点就能把人类意识移植到我的机器里。";
		next;
		cutin "ep171_elyumina04",0;
		mes "[Elyumina]";
	mes "我本可以给你们美丽的机械身体，让你们永远保存辛苦积累的知识。";
		next;
		cutin "ep171_elyumina03",0;
		mes "[Elyumina]";
	mes "明白了吗？我做的是你们这些蠢货任何人都无法想象的伟业。";
	mes "和沃尔、维尔，不管他们叫什么的幼稚作品相比，我的研究根本不是一个层次。";
	npctalk "谁说我需要机械身体？", "Elena Volkova#rm171_2", bc_self;
	npctalk "我也不需要。", "Lazy#rm171_1", bc_self;
	npctalk "沃尔？……我明白了。", "Rookie#rm171_1", bc_self;
		next;
		cutin "16loo_01",2;
		mes "[Rookie]";
	mes "沃尔是谁？沃尔塞夫？还是沃纳？你认识他们吗？";
		next;
		cutin "ep171_elyumina03",0;
		mes "[Elyumina]";
	mes "嗯，我知道这两个名字，但他们没什么值得我在意的。他们都为了愚蠢的事冒险。";
		next;
		cutin "16loo_01",2;
		mes "[Rookie]";
	mes "也许你该多关心一点了。我们要你开口。";
	mes "听好了。你有两个选择。";
		next;
		npctalk "Elyumina: ...", "Elyumina#rm171_1", bc_self;
		cutin "16loo_02",2;
		mes "[Rookie]";
	mes "第一，你可以选择固执到底，";
	mes "不告诉我们你的非法研究和同伴的事。";
	mes "你可以忠于他们，代价是……死刑。那样你就没有未来。";
		next;
		cutin "16loo_01",2;
		mes "[Rookie]";
	mes "或者你可以多为自己的未来考虑，";
	mes "向我们提供那些只是生意伙伴的同事的情报。这样你可以保留研究，但会受到限制。";
		next;
		cutin "16loo_03",2;
		mes "[Rookie]";
	mes "当然你必须为自己的行为付出代价，但最终你仍能做想做的事。";
		next;
		cutin "ep171_elyumina03",0;
		mes "[Elyumina]";
		mes "...";
		next;
		cutin "16loo_01",2;
		mes "[Rookie]";
	mes "我们是在和你谈认罪协商。因为真的相信你做出了伟大的研究，所以才愿意做出牺牲。";
	mes "希望你做出正确决定。";
		next;
		cutin "ep171_elyumina03",0;
		mes "[Elyumina]";
	mes "……我真的不知道其他人在房间里做了什么。";
	mes "……我还可以保留这份协商吗？";
		next;
		cutin "16loo_02",2;
		mes "[Rookie]";
	mes "嗯……当然，为什么不呢？只要你尽力与我们合作，小细节可以不追究。";
		mes "现在进入正题吧。懒惰先生，请把他送到这里。";
		npctalk "懒惰：加油，伟大的科学家女士。", "Lazy#rm171_1", bc_self;
		next;
		cloakonnpcself( "Elyumina#rm171_1" );
		cloakoffnpcself( "Elyumina#rm171_2" );
		cutin "16lei_01",2;
		npctalk "菜鸟：……所以……啊，我明白了……", "Rookie#rm171_1", bc_self;
		mes "[Lazy]";
		mes "...";
		next;
		mes "[Lazy]";
		mes "...";
		mes "喂，那边的热血队长。";
		next;
		cutin "162elena_01",2;
		npctalk "埃尔尤米娜：……是的，但其他事我不……", "Elyumina#rm171_2", bc_self;
		mes "[Elena Volkova]";
		mes "……你是在和我说话吗？";
		next;
		cutin "16lei_02",2;
		npctalk "埃尔尤米娜：……所以，原因是……还有……", "Elyumina#rm171_2", bc_self;
		mes "[Lazy]";
		mes "那还能是谁？这里就你一个队长。";
		mes "他现在愿意合作，我正要请你别再瞪他。";
		next;
		cutin "162elena_01",2;
		npctalk "菜鸟：……好吧，所以你在这里……", "Rookie#rm171_1", bc_self;
		mes "[Elena Volkova]";
		mes "啊……嗯，是的。";
		mes "菜鸟做得很好。我不知道他这么擅长说服人。";
		next;
		cutin "16lei_03",2;
		npctalk "埃尔尤米娜：……明白了吗？你最好遵守承诺，否则我不会……", "Elyumina#rm171_2", bc_self;
		mes "[Lazy]";
		mes "当然不会。你从没给他机会。";
		mes "不过既然你知道了，就让他处理剩下的事。";
		next;
		npctalk "菜鸟：好，干得不错！别担心，我会照顾你。", "Rookie#rm171_1", bc_self;
		cutin "162elena_01",2;
		mes "[Elena]";
		mes "Hm...";
		next;
		cutin "16loo_01",2;
		mes "[Rookie]";
		mes "你们刚才在谈什么？他把我们需要知道的一切都告诉我了。";
		mes "他的组织叫^0000CD幻象^000000，由^0000Cd雷根希尔姆的前成员^000000组成。";
		next;
		cutin "16loo_03",2;
		mes "[Rookie]";
		mes "不过埃尔尤米娜似乎不太了解他的组织。";
		mes "他几乎不和公司联系，用研究成果换取幻象的资金。这就是他不在名单上的原因。";
		npctalk "懒惰：所以他就像分包商的分包商。", "Lazy#rm171_1", bc_self;
		npctalk "埃尔尤米娜：不！我是他们的研究支持者！", "Elyumina#rm171_2", bc_self;
		next;
		cutin "16loo_01",2;
		mes "[Rookie]";
		mes "而这座实验室后面是曾经隐藏的^0000CDBarmund宅邸^000000。";
		mes "发现宅邸后，幻象成立，企图垄断其中的知识。";
		next;
		mes "[Rookie]";
		mes "埃尔尤米娜不知道宅邸内部是什么样，";
		mes "因为她选择留在进入宅邸的其他人后方，保护自己的研究数据。";
		next;
		cutin "16loo_02",2;
		npctalk "菜鸟：但她说自己知道怎么进去。", "Rookie#rm171_1", bc_self;
		mes "[Rookie]";
		mes "从围栏最右侧的<NAVI>[水道]<INFO>sp_cor,255,285,0,101,0</INFO></NAVI>进去。";
		mes "我们需要更多情报，也要把研究员集中起来。大家一起去吧？队长？冒险者？";
		completequest 16359;
		setquest 16360;
		close2;
		cloakonnpcself( "Rookie#rm171_1" );
		cloakonnpcself( "Elena Volkova#rm171_2" );
		cloakonnpcself( "Lazy#rm171_1" );
		cloakonnpcself( "Elyumina#rm171_2" );
		cloakonnpcself( "Philopontes#rm171_1" );
		cutin "",255;
		end;
	case 2:
		if (isbegin_quest(16360) < 2) {
			cutin "16loo_02",2;
			mes "[Rookie]";
			mes "从围栏最右侧的<NAVI>[水道]<INFO>sp_cor,255,285,0,101,0</INFO></NAVI>进去。";
			mes "我们需要更多情报，也要把研究员集中起来。大家一起去吧？队长？冒险者？";
			navigateto "sp_cor",254,279;
			close3;
		}
		cutin "16loo_02",2;
		mes "[Rookie]";
		mes "冒险者，有消息时你会第一个知道。";
		close3;
	}
	end;

OnInit:
	cloakonnpc();
	questinfo (QTYPE_QUEST, QMARK_YELLOW, " isbegin_quest(16359) == 1 ");
	end;
}

// In front of waterway - Rookie, Goni, and Elyumina
sp_cor,255,285,1	script	Rookie#rm171_2	4_M_ROOKIE,{
	switch (isbegin_quest(16360)) {
	case 0:
		cutin "16loo_01",2;
		mes "[Rookie]";
		mes "呃，我们还在调查这一侧，冒险者。";
		mes "我们不知道这里潜伏着什么危险。请不要再靠近。";
		next;
		cutin "16loo_02",2;
		mes "[Rookie]";
		mes "这条水道里的水看起来很干净，但我们想送去分析。";
		next;
		cutin "16loo_01",2;
		mes "[Rookie]";
		mes "这里充满令人不快的意外，我一直提醒自己要警惕看到的一切。";
		close3;
	case 1:
		if (checkweight(1201,3) == 0) {
			mes "[Alert]";
		mes "- 你的背包满了。请检查负重和携带物品数量后再来找我。-";
			close;
		}
		cloakoffnpcself( "Goni#rm171_2" );
		cloakoffnpcself( "Elyumina#rm171_3" );
		cloakoffnpcself( "Elena Volkova#rm171_3" );
		cutin "16loo_03",2;
		emotion 19;
		mes "[Rookie]";
		mes "啊，真是的。我想就是这个，但打不开。是生锈太严重了吗？";
		next;
		cutin "16go_01",0;
		mes "[Goni]";
		mes "...";
		next;
		cutin "16loo_02",2;
		mes "[Rookie]";
		mes "啊，你想试试？谢谢你，戈尼。";
		next;
		cutin "16go_01",0;
		mes "[Goni]";
		mes "...";
		next;
		mes "[Goni]";
		mes "...";
		mes "... ...";
		next;
		mes "[Goni]";
		mes "...";
		mes "... ...";
		mes "... ... ...";
		next;
		emotion 29;
		cutin "16loo_01",2;
		mes "[Rookie]";
		mes "戈尼，你是认真的吗？哦，我明白了。有意思……";
		next;
		cutin "ep171_elyumina03",0;
		emotion 23, getnpcid(0,"Elyumina#rm171_3");
		mes "[Elyumina]";
		mes "你为什么那样看我？我说的全是实话。那确实是入口。";
		mes "我为什么要在这种情况下撒谎？我没那么蠢。";
		next;
		cutin "16loo_01",2;
		mes "[Rookie]";
		mes "谁说你蠢了？我们找到入口了。";
		mes "但它从里面锁上了。连戈尼也打不开，而他是我们中最强的。这正是有趣之处。";
		next;
		emotion 18;
		cutin "16loo_02",2;
		mes "[Rookie]";
		mes "我本该先确认你是否和其他人谈过，再来和我们说话。现在已经晚了。";
		mes "你比我想象中更忠诚，也并不愚蠢。";
		next;
		cutin "16loo_01",2;
		npctalk "埃尔尤米娜：……别取笑我！啊！", "Elyumina#rm171_3", bc_self;
		mes "[Rookie]";
		mes "冒险者，叛乱军会包围这里并调查周边。";
		mes "既然知道那是什么地方，就不能放任不管。";
		next;
		cutin "16loo_03",2;
		mes "[Rookie]";
		mes "我们和政府、企业都有着漫长的爱恨纠葛。即使幻象与他们都无关，我们也必须从那里取回巴尔蒙德的遗产。";
		next;
		cutin "16loo_01",2;
		mes "[Rookie]";
		mes "但现在大门关闭，我们进不去。";
		mes "有更多情报时我会告诉你。在那之前请休息一下。";
		next;
		cutin "162elena_01",2;
		mes "[Elena Volkova]";
		mes "啊，对了。埃尔尤米娜也会暂时留在这里。";
		mes "他比我们更了解幻象，我们不能失去他。";
		next;
		cutin "162elena_01",2;
		mes "[Elena Volkova]";
		mes "他和我们在一起时，我们也会看看他能否改造这里找到的损坏武器。";
		next;
		mes "[Elena Volkova]";
		mes "如果你对此感兴趣，可以向我聪明的<NAVI>[部下]<INFO>sp_cor,108,130,0,101,0</INFO></NAVI>询问详情。";
		next;
		cutin "16loo_02",2;
		mes "[Rookie]";
		mes "这里还有很多事要做。如果你不忙，也许可以留下来帮忙。";
		mes "那么祝你好运，冒险者！有新情报时我们会联系你！";
		completequest 16360;
		getexp2 getbaseexp_ratio(15,110),0;
		getexp 0,400000;
		getexp 0,400000;
		getexp 0,400000;
		close2;
		cloakonnpcself( "Goni#rm171_2" );
		cloakonnpcself( "Elyumina#rm171_3" );
		cloakonnpcself( "Elena Volkova#rm171_3" );
		cutin "",255;
		end;
	case 2:
		break;
	}
	// Episode 17.2 - START - (Walkthrough Conversion)
	if (BaseLevel < 130) {
		mes "[Rookie]";
		mes "有更多情报时我会联系你。现在先休息一下。";
		mes "埃尔尤米娜暂时也会负责这里。";
		next;
		cutin "16loo_01.bmp",2;
		mes "[Rookie]";
		mes "我们会继续观察，并考虑改造这里找到的损坏武器供自己使用。";
		next;
		mes "[Rookie]";
		mes "冒险者，如果你感兴趣，这由沃尔科娃队长的<NAVI>[部下]<INFO>sp_cor,108,130,0,101,0</INFO></NAVI>负责，去问问吧。";
		next;
		cutin "16loo_02.bmp",2;
		mes "[Rookie]";
		mes "这里还有不少工作要做，有空的话欢迎帮忙。";
		mes "那么祝你好运，冒险者！有新消息时我会联系你！";
		next;
		cutin "",255;
		mes "^4d4dff这些任务需要130级或更高等级。^000000";
		close;
	}
	if (ep17_2_main == 0) {
		cutin "16loo_01",2;
		mes "[Rookie]";
		mes "不客气。";
		mes "我昨晚打开了这里的入口。";
		mes "埃尔尤米娜说，不知怎么回事，从内部封锁入口的装置坏了。";
		next;
		mes "[Rookie]";
		mes "那一定是幻象或心脏猎人用来封锁入口的装置。";
		mes "很高兴我们能打开入口并进入。";
		next;
		mes "[Rookie]";

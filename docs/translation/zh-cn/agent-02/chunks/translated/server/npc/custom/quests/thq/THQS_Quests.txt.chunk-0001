//3-3 Goes to 7-3 using callfunc
prt_sewb1,120,245,6	script	Sewer Management Knight	705,{
	if (three_qset == 3 && countitem(955) > 149) goto N_QuestComp;
	if (three_qset == 3) goto N_QuestStart;
	if (seven_qset == 3) goto N_QuestStart2;
	mes "[下水道管理人员]";
	mes "每天在虫子遍地的下水道工作，我的生活不能更糟了……";
	close;
N_QuestComp:
	mes "[下水道管理人员]";
	mes "看来这对你来说不算难。";
	mes "谢谢，拿着这 4 枚寻宝代币。";
	delitem 955,150;
	set #Treasure_Token,#Treasure_Token+4;
	set three_qset,0;
	set On_Quest,0;
	close;
N_QuestStart:
	mes "[下水道管理人员]";
	mes "这段时间一直有怪物，主要是虫子，侵占着下水道……";
	mes " ";
	mes "我想让你清理掉一部分，能清多少是多少。";
	mes "带给我 150 个蠕虫皮屑。";
	close;
N_QuestStart2:
	callfunc "seven_qset-3";
	close;
}
//3-4
mjolnir_02,87,357,6	script	Man#01	51,{
	if (three_qset == 4 && countitem(1041) > 49) goto N_QuestComp;
	if (three_qset == 4) goto N_QuestStart;
	mes "[鲁道夫]";
	mes "危险，煤矿现在是敌对区域。";
	close;
N_QuestComp:
	mes "[鲁道夫]";
	mes "很高兴看到你活着回来。";
	mes "我曾经对此感到怀疑，不过谢谢你的帮助。";
	mes " ";
	mes "来，拿着这 4 枚寻宝代币。";
	delitem 1041,50;
	set three_qset,0;
	set On_Quest,0;
	set #Treasure_Token,#Treasure_Token+4;
	close;
N_QuestStart:
	mes "[鲁道夫]";
	mes "你好，你一定是寻宝猎人公会的人。";
	mes " ";
	mes "他们应该已经告诉你煤矿下层发生的事了。我知道那令人不安，我们还在调查两名邪恶德鲁伊为何以及如何下到那里。";
	mes " ";
	mes "我要你带回 50 盏提灯，证明你清理了一部分怪物。你可以保留在那里找到的战利品，但我要求你带回的东西除外。";
	close;
}
///////Job list 4///////
//4-1;
pay_arche,45,138,6	script	Flora	724,{
	if (four_qset == 1 && countitem(957) > 49) goto N_QuestComp;
	if (four_qset == 1) goto N_QuestStart;
	mes "[弗洛拉]";
	mes "你好，小心洞窟。我们听说有不死族怪物在那里游荡。";
	close;
N_QuestComp:
	mes "[弗洛拉]";
	mes "欢迎回来，干得好，你成功了。（不知道那个火焰混蛋还活着吗。）";
	mes "希望这能减少一些怪物，拿着这 2 枚代币。";
	delitem 957,50;
	set #Treasure_Token,#Treasure_Token+2;
	set four_qset,0;
	set On_Quest,0;
	killmonster "pay_dun00","Flora::OnMobDead";
	close;
N_QuestStart:
	mes "[弗洛拉]";
	mes "你好。";
	mes " ";
	mes "我要你带回 50 根腐朽的钉子。以前斐扬洞窟是安全的地方……但现在事情失控了，僵尸侵入了第一层……";
	mes " ";
	mes "还有些刚刚凭空出现的新怪物，我们叫它们火焰混蛋……如果你还不够强，一定要小心，它们非常厉害。";
	next;
	mes "[弗洛拉]";
	mes "祝你好运";
	mes "记住，我需要 50 根钉子。";
	monster "pay_dun00",0,0,"Flaming Bastard",1072,1,"Flora::OnMobDead";
	monster "pay_dun00",0,0,"Flaming Bastard",1072,1,"Flora::OnMobDead";
	close;
OnMobDead:
	end;
}

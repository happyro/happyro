//3-1;
moc_fild04,208,322,6	script	Clark	65,{
	if (three_qset == 1 && countitem(1040) > 29) goto N_QuestComp;
	if (three_qset == 1) goto N_QuestStart;
	mes "[克拉克]";
	mes "我很想聊天，但正在等人。";
	close;
N_QuestComp:
	mes "[克拉克]";
	mes "好吧，这是个开始。";
	mes " ";
	mes "希望这个洞有一天会消失，以后我可能还有任务交给你。";
	mes "来，拿着这 2 枚寻宝代币。";
	delitem 1040,30;
	set #Treasure_Token,#Treasure_Token+2;
	set three_qset,0;
	set On_Quest,0;
	close;
N_QuestStart:
	mes "[克拉克]";
	mes "你好。";
	mes "你一定是寻宝猎人公会的人。";
	mes " ";
	mes "事情是这样的，你看到地上的洞了吗？那东西几年前突然出现，里面满是丑陋的蚂蚁和一种叫基尔瑟的怪物。";
	next;
	mes "[克拉克]";
	mes "我要你杀掉一些基尔瑟，带给我 30 根它们的小胡子。";
	close;
}

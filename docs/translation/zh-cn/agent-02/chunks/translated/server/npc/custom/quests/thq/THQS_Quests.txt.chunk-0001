//2-3;
prt_fild07,316,263,6	script	Marsh Man	84,{
	if (two_qset == 3 && countitem(518) > 19) goto N_QuestComp;
	if (two_qset == 3) goto N_QuestStart;
	mes "[莱妮丝]";
	mes "你好，抱歉我没时间聊天，我正在等人。";
	close;
N_QuestComp:
	mes "[莱妮丝]";
	mes "哦，你好！你带来了蜂蜜，我和蜜蜂都要感谢你。";

//= 1.6 Changed "Caral" coordinates because moc_fild04 no longer exists. [Euphy]
//============================================================

///////Job list 1///////
//1-1
mjolnir_09,187,189,6	script	Old Man	107,{
	if (one_qset==1) goto N_QuestStart;
	mes "[老人]";
	mes "喂！老人家连安静走路都不行了吗？！";
	close;
N_QuestStart:
	mes "[老人]";
	mes "咦？那是什么？！";
	mes " ";
	mes "我妻子叫我回家？！好，好……我这就走，这就走。谢谢你来传话。";
	mes " ";
	mes "来，拿着这枚寻宝代币。";
	set one_qset,0;
	set On_Quest,0;
	set #Treasure_Token,#Treasure_Token+1;
	close;
}
//1-2;
pay_arche,86,129,6	script	Archer	732,{
	if (one_qset == 2) goto N_QuestStart;
	mes "[基思]";
	mes "抱歉，没空聊天。我很忙，正在等我的包裹。";
	close;
N_QuestStart:
	mes "[基思]";
	if (countitem(1072) < 1) {
		mes "你不是应该给我送箱子吗？箱子在哪里？";
		close;
	}
	mes "啊，你一定是寻宝猎人协会的人。我的弓带来了吗？";
	mes " ";
	mes "啊，太好了，谢谢你抽空帮忙。拿着这枚寻宝代币。";
	delitem 1072,1;
	set one_qset,0;
	set On_Quest,0;
	set #Treasure_Token,#Treasure_Token+1;
	close;
}
//1-3
prt_fild06,37,192,6	script	Farmer	125,{
	if (one_qset == 3 && countitem(909) > 19 && countitem(955) > 19 && countitem(914) > 19 && countitem(705) > 19) goto N_QuestComp;
	if (one_qset==3) goto N_QuestStart;
	mes "[比利·鲍勃]";
	mes "啊啊啊……！那些该死的虫子把一切都吃光了，这地方已经一点也不像我的农场了！！";
	close;
N_QuestComp:
	mes "[比利·鲍勃]";
	mes "哦，谢谢，这对我来说是个很好的开始。";
	mes "那些虫子最好滚远点……";
	mes " ";
	mes "来，拿着这 2 枚寻宝代币。";
	delitem 909,20;
	delitem 955,20;
	delitem 914,20;
	delitem 705,20;
	set one_qset,0;
	set #Treasure_Token,#Treasure_Token+2;
	set On_Quest,0;
	close;
N_QuestStart:
	mes "[比利·鲍勃]";
	mes "那些该死的虫子到处都是！！！";
	mes "你一定是公会派来的！好吧，带给我 20 个蠕虫皮屑、20 个杰勒比结晶、20 个绒毛和 20 个四叶草。";
	close;
}
//1-4
prontera,264,353,6	script	Old Lady#thq	103,{
	if (one_qset == 4 && countitem(934) > 14) goto N_QuestComp;
	if (one_qset == 4) goto N_QuestStart;
	mes "[老太太]";
	mes "这是我丈夫的坟墓……我只是来看看他。";
	close;
N_QuestComp:
	mes "[老太太]";
	mes "你都带来了吗？！";
	next;
	mes "[老太太]";
	mes "太感谢你了，拿着这 3 枚寻宝代币。";
	delitem 934,15;
	set #Treasure_Token,#Treasure_Token+3;
	set one_qset,0;
	set On_Quest,0;
	close;
N_QuestStart:
	mes "[老太太]";
	mes "你就是来帮助我的人吗？";
	mes " ";
	mes "好吧，我希望你做的是：旁边这座坟是我丈夫的，我答应过要把纪念品和他一起埋葬。问题是，我没有纪念品……";
	next;
	mes "[老太太]";
	mes "请带给我 15 件纪念品。";
	close;
}
///////Job list 2///////
//2-1;
morocc,59,109,6	script	Erika	700,{
	if (two_qset == 1 && countitem(1072) > 0) goto N_QuestComp;
	if (two_qset == 1) goto N_QuestStart;
	mes "[艾丽卡]";
	mes "你好，我叫艾丽卡。";
	close;
N_QuestComp:
	mes "[艾丽卡]";
	mes "什么？你有我的信！！";
	mes "哦哦，我最喜欢信了:D。来，我马上打开。";
	next;
	mes "[信件]";
	mes "亲爱的艾丽卡：";
	mes " ";
	mes "很遗憾通知你，你已被驱逐，请在 3～5 天内搬走。";
	mes " ";
	mes "——管理处";
	next;
	mes "[艾丽卡]";
	mes "哦……呃……可恶，那个混蛋以为能把我赶出去吗！！！！！他会后悔的！";
	mes " ";
	mes "不管怎样，谢谢你帮忙送信。拿着这枚寻宝代币。";
	delitem 1072,1;
	set two_qset,0;
	set #Treasure_Token,#Treasure_Token+1;
	set On_Quest,0;
	close;
N_QuestStart:
	mes "[艾丽卡]";
	mes "你就是拿着我的信来的人吗？";
	mes " ";
	mes "好吧，信在哪里？";
	close;
}

}
//2-4;
payon,161,72,6	script	Molly	714,{
	if (two_qset == 4 && countitem(7005) > 0) goto N_QuestComp;
	if (two_qset == 4) goto N_QuestStart;
	mes "[莫莉]";
	mes "抱歉，没空聊天，我正在等人。";
	close;
N_QuestComp:
	mes "[莫莉]";
	mes "哇，你做到了！！！";
	mes " ";
	mes "我就知道你看起来很强，但真不知道你是怎么杀掉那个怪物的。";
	mes "太感谢你了，拿着这 3 枚公会代币作为奖励。";
	delitem 7005,1;
	set two_qset,0;
	set On_Quest,0;
	set #Treasure_Token,#Treasure_Token+3;
	close;
N_QuestStart:
	mes "[莫莉]";
	mes "哇，你一定是寻宝猎人公会派来的勇士！";
	mes "事情是这样的，我不知道起因，但这里以东两格的树林里有一具奇怪的罗南骷髅到处游荡。";
	next;
	mes "[莫莉]";
	mes "我们以前试过杀它，但那……呃……不是个好主意。我要你去那里带回它的头骨，证明你杀了它。";
	mes " ";
	mes "祝你好运";
	close;
}

job3_guil01,79,15,1	script	Estillda#3rdgc11	919,{
	if (job_3rd_gc == 11) {
		mes "Estillda面带焦虑地四处张望。";
		next;
		switch(select("Are you ok?:Intimidate her.")) {
		case 1:
			mes "[Estillda]";
		mes "嗯？嗯……";
		mes "我以为刺客很可怕。";
		mes "但现在不这么觉得了……";
			next;
			select("You don't look like you're from Veins");
			mes "[Estillda]";
		mes "嗯？嗯……";
		mes "我来自Rachel。";
		mes "我是来赚Zeny的。";
		mes "我在Rachel过着孤寂的生活。";
			next;
			switch(select("You came here with alone?:Had a desolate life...")) {
			case 1:
				mes "[Estillda]";
				mes "不。";
				mes "我不这么认为。";
				mes "我是和一个男人一起来的。";
				next;
				mes "[Estillda]";
				mes "我通常一个人来这里。有时他会确认我的目的地。";
				mes "我以为他是某家公司的重要人物。";
				next;
				mes "[Estillda]";
				mes "但我不知道他是谁。";
				break;
			case 2:
				mes "[Estillda]";
				mes "我是本地人，";
				mes "在他家工作。";
				mes "我觉得还不错。";
				mes "我只是离开了家……";
				next;
				mes "[Estillda]";
				mes "他说需要女仆，而且会付给我足够的钱。";
				break;
			}
			next;
			mes "[Estillda]";
			mes "其实我不太了解他。";
			mes "……我再也不做了。";
			mes "我想回家。我想妈妈。";
			next;
			switch(select("What can you tell me?:Tell me what you know!")) {
			case 1:
				mes "[Estillda]";
				mes "好。对吧？";
				mes "我会把知道的一切告诉你。";
				break;
			case 2:
				mes "[Estillda]";
				mes "对不起。很抱歉。";
				mes "我会照你说的做……";
				next;
				mes "["+strcharinfo(0)+"]";
				mes "你的态度有问题。";
				mes "我们谈正事吧。";
				break;
			}
			next;
			mes "[Estillda]";
			mes "我通常供应食物";
			mes "和其他生活必需品。";
			next;
			mes "[Estillda]";
			mes "我会买些食物给自己吃。";
			mes "每天也会给他买昂贵的食物。";
			next;
			mes "[Estillda]";
			mes "我觉得他很挑食……";
			mes "每次送食物我都会拿到钱……";
			next;
			select("Where did you sleep?");
			mes "[Estillda]";
			mes "嗯？嗯，就在附近。";
			mes "有个士兵住宿的地方。";
			mes "他希望我住在那里……";
			next;
			select("When are you supposed to meet?");
			mes "[Estillda]";
			mes "几个小时后。";
			mes "在南边地下的仓库。";
			next;
			mes "["+strcharinfo(0)+"]";
			mes "谢谢你的配合。";
			mes "你的家在Rachel？";
			mes "Estillda是你的真名？";
			mes "好，我会在Rachel领取他的物资。";
			next;
			mes "["+strcharinfo(0)+"]";
			mes "平安回家。";
			set job_3rd_gc, 12;
			changequest 7106,7107;
			close;
		case 2:
			mes "[Estillda]";
			mes "嗯？";
			mes "请……";
			mes "不要杀我。";
			next;
			mes "- Estillda看起来很害怕。你需要换个话题。 -";
			close;
		}
	} else if (job_3rd_gc == 12) {
		mes "[Estillda]";
		mes "我们通常在同一时间、同一地点见面。";
		mes "在南边地下的仓库。";
		mes "别告诉他是我告诉你的。";
		close;
	}
	end;
}


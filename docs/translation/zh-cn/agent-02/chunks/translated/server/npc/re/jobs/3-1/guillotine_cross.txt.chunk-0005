					mes "中年。";
					break;
				case 4:
					mes "[Melissa]";
					mes "是的，非常老。";
					break;
				}
				next;
				mes "[Melissa]";
		mes "你好，"+((Sex == SEX_MALE)?"弟弟":"妹妹")+"～让我收集你提供的所有信息……";
				next;
		mes "- 她开始喃喃自语，并朝天空比划。说话时头发竖了起来…… -";
				next;
				if (.@ans00 == 3) {
					mes "[Melissa]";
			mes "明白了！";
			mes "我认识她。";
			mes "她叫^4d4dffEstillda^000000。";
			mes "对吧？";
					next;
					mes "[Melissa]";
			mes "你为什么找她？她是你的朋友吗？";
			mes "前几天她给了我糖果。";
					next;
					mes "[Melissa]";
			mes "嗯……这个女孩……";
			mes "大约一小时后";
			mes "会经过一条";
			mes "死胡同！";
			mes "嘿嘿嘿！";
					erasequest 7103;
					setquest 7104;
					set job_3rd_gc, 9;
					next;
					mes "[Melissa]";
			mes "她一定就是你要找的人。我从不会错。";
			mes "快说我做得好！";
					next;
					switch(select("Pat Melissa on the head.:Giver her a thumbs up sign.")) {
					case 1:
					mes "你拍了拍Melissa的头。";
					mes "她像小狗一样做出反应。";
						next;
						mes "[Melissa]";
					mes "嘿嘿嘿……";
					mes "我会帮忙的～！";
						close;
					case 2:
						mes "[Melissa]";
					mes "嘿嘿嘿……";
					mes "我做得好！";
						close;
					}
				} else {
					mes "[Melissa]";
					mes "嗯……";
					mes "具备这些特征的人是……";
					next;
					mes "[Melissa]";
					mes "什……？呃，我从没错过。";
					mes "不知道为什么，我看不到那个人。";
					next;
					mes "[Melissa]";
					mes "啊啊啊！哇啊！";
					next;
					mes "- 我只能安慰哭泣的梅丽莎。看来我得重新思考那个人的特征。-";
					close;
				}
			}
		case 2:
			mes "[Melissa]";
			mes "真奇怪。";
			mes "这个村子里的人总是在找谁。";
			close;
		}
	} else if (job_3rd_gc == 9) {
		mes "你找到她了吗？";
		mes "替我谢谢她前几天给我的糖果。";
		close;
	} else {
		mes "我找人的时候，一个穿黑衣服的天使会给我情报。";
		next;
		mes "[Melissa]";
		mes "我把这件事告诉Daora，她让我不要再这样做。";
		mes "也许她不是个好天使。";
		close;
	}
}


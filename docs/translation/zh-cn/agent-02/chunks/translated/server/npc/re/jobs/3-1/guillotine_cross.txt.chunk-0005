				next;
				mes "[Estillda]";
		mes "我什么都不知道，也不知道他是不是坏人。";
		mes "我只是买了些东西……（抽泣）……";
				next;
		mes "- Estillda以为自己惹上麻烦，陷入了震惊。 -";
				next;
				select("Calm her down.");
				mes "["+strcharinfo(0)+"]";
		mes "先冷静一下。";
		mes "我完全明白你在说什么。";
		mes "你不会惹上麻烦。";
				next;
				mes "["+strcharinfo(0)+"]";
		mes "我在找一个犯罪后逃跑的男人。";
		mes "我必须抓住他。";
				next;
				mes "["+strcharinfo(0)+"]";
		mes "那么，是谁让你去买那些物资的？";
				next;
				mes "["+strcharinfo(0)+"]";
		mes "如果你配合我，我会保护你直到事情结束。";
		mes "刺客公会会保护你。";
				next;
				mes "[Estillda]";
		mes "你保证，对吧？";
		mes "我能怎么帮你？";
				next;
				select("When are you supposed to meet?");
				mes "[Estillda]";
		mes "哦，我已经把东西送到了。";
		mes "我正准备回去。";
				next;
				mes "[Estillda]";
		mes "啊，这些是我的。";
		mes "我拿到了很多Zeny。";
				next;
				mes "["+strcharinfo(0)+"]";
		mes "那就直走，假装什么也没发生。";

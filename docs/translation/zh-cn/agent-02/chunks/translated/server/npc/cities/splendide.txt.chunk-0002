		case 2:
			cutin "god_nelluad02",2;
			mes "[Poet Nell]";
		mes "永恒的混沌……";
		mes "这是伟大的作品，但不建议用餐时听……";
			soundeffect "chaos_of_eternity.wav",0;
			break;
		case 3:
			cutin "god_nelluad02",2;
			mes "[Poet Nell]";
		mes "落日刺客！";
		mes "你喜欢刺客吗？";
		mes "这首歌讲述了生活在沙漠中的传奇十字刺客。";
			soundeffect "assassin_of_sunset.wav",0;
			break;
		case 4:
			cutin "god_nelluad02",2;
			mes "[Poet Nell]";
		mes "尼伯龙根之戒……";
		mes "这首歌有一个非常有趣的故事~";
			next;
			soundeffect "ring_of_nibelungen.wav",0;
		mes "^4d4dff有一条名为莱茵的河流，";
		mes "闪耀得仿佛由黄金制成。";
		mes "它的秘密从未向任何人透露，";
		mes "直到这个故事被讲述……^000000";
			next;
		mes "^4d4dff瓦尔哈拉由女神芙蕾雅创造。";
		mes "嫉妒的 Rocky 摧毁了美丽女神。^000000";
		mes "^4d4dff火焰之戒从其深处诞生。";
		mes "那枚戒指强大到承载了神的欲望~^000000";
			next;
		mes "^4d4dff如今 Alberich 的宝藏拥有那种力量。";
		mes "那是承载神所有欲望的戒指之力。^000000";
			next;
		mes "^4d4dff宝藏被用来买下世界的灵魂。";
		mes "用黄金的重量买来的灵魂。^000000";
			next;
		mes "^4d4dffRocky 害怕失去控制，于是把可怜的 Alberich 变成了蟾蜍。";
			next;
		mes "^4d4dffAlberich 用最后一口气发誓，他珍爱的戒指会诅咒佩戴者至死。";
			next;
		mes "^4d4dff佩戴者将永远被 Rocky 的嫉妒诅咒。";
			break;
		}
		break;
	case 2:
		cutin "god_nelluad03",2;
		mes "[Poet Nell]";
		mes "为什么不呢？";
		mes "如果不想听我演奏，为什么那样盯着我？";
		next;
		select("你看起来像我认识的人。");
		cutin "god_nelluad04",2;
		mes "[Poet Nell]";
		mes "诶？";
		mes "不可能！";
		mes "你可能认错人了……！";
		next;
		mes "[Poet Nell]";
		mes "是的，我看起来很普通……";
		mes "但我不记得我们以前见过。";
		next;
		cutin "god_nelluad01",255;
		mes "- Nell 似乎有些尴尬，然后开始演奏非常复杂的音乐 -";
		break;
	}
	close2;
	cutin "god_nelluad01",255;
	end;
}


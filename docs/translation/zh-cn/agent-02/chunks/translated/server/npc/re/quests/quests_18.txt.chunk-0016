// Quest: Collecting Folklore. Step 1 + 5 (final).
wolfvill,61,170,5	script	Folklorist Gudra#ep18	4_F_SHABBY,{
	if (checkweight(1000405,20) == 0) {
		mes "- 请稍等！！-";
		mes "- 你目前携带了-";
		mes "- 太多物品。-";
		mes "- 请减轻负重-";
		mes "- 后再试。-";
		close;
	}
	if (ep18_main < 36) {
		mes "[Folklorist Gudra]";
		mes "你应该是附近的新村民。你是谁？";
		close;
	}
	switch( isbegin_quest(16554) ) {
	case 0:
		if ((isbegin_quest(16551)+isbegin_quest(16552)+isbegin_quest(16553)) == 0) {
			select( "学者，你在做什么？" );
			mes "[Folklorist Gudra]";
			mes "哦，哦哦。";
			mes "……我看起来像学者吗？";
			next;
			select( "你不是学者？" );
			mes "[Folklorist Gudra]";
			mes "不！我以前是学者，很久以前。";
			mes "很高兴外来者一眼就认出我是学者。";
			next;
			mes "[Folklorist Gudra]";
			mes "嗯，嗯。你问我在做什么。";
			mes "我在整理收集到的故事。";
			next;
			mes "[Folklorist Gudra]";
			mes "这是在收集流传下来的神话和民间故事。";
			mes "也是为了保存原住民珍贵的文化遗产。";
			next;
			mes "[Folklorist Gudra]";
			mes "为了不让这些故事失传并传给后代，我们会把它们出版成书。";
			next;
			mes "[Folklorist Gudra]";
			mes "看来你很感兴趣。";
			mes "……你对这项工作感兴趣吗？";
			next;
			if (select( "感兴趣。", "没兴趣。" ) == 2)
				end;
			mes "[Folklorist Gudra]";
			mes "那么，你感兴趣就代表愿意帮忙吗？";
			mes "我们总是欢迎多一双手。如果你能帮忙，我会很高兴。";
			next;
			mes "[Folklorist Gudra]";
			mes "你会写字吗？太好了。";
			mes "请收集村民们的故事。";
			next;
			mes "[Folklorist Gudra]";
			mes "我答应听村里一个孩子、一个年轻人和一位祖母的故事。";
			next;
			mes "[Folklorist Gudra]";
			mes "听说故事很长，可能一天讲不完。需要你的耐心。";
			mes "给你，这是用来收集故事的笔记本。";
			next;
			mes "[Folklorist Gudra]";
			mes "孩子叫迪纳尔。年轻人是名叫阿米拉的女子。";
			mes "之后你可以去找莎妮娜奶奶，记下她的故事。";
			setquest 16551;
			setquest 16552;
			setquest 16553;
			getitem 1000408,1;	// Ep18_Recording_Note
			close;
		}
		if (countitem(1000408) < 1) {
			getitem 1000408,1;	// Ep18_Recording_Note
		}
		mes "[Folklorist Gudra]";
		mes "我们约好了听村里一个孩子、一个年轻人和一位祖母的故事。";
		next;
		mes "[Folklorist Gudra]";
		mes "故事很长，一天听不完，需要你的耐心。";
		next;
		mes "[Folklorist Gudra]";
		mes "孩子叫迪纳尔。年轻女子叫阿米拉。";
		mes "接下来去莎妮娜奶奶那里，听她的故事并记下来。";
		close;
	case 1:
		mes "[Folklorist Gudra]";
		mes "迪纳尔和阿米拉，你们是来给莎妮娜奶奶讲故事的吗？";
		mes "我很期待听听是什么故事。请把笔记本给我看看。";
		next;
		mes "[Folklorist Gudra]";
		mes "这是阿米拉告诉你的故事吗？";
		mes "真是丰富又精彩！我年轻时也记得听过这些神明的故事。";
		next;
		mes "[Folklorist Gudra]";
		mes "但故事中动物神明的名字与我年轻时听过的相似，却又有些不同。";
		mes "嗯，我需要研究一下。";
		next;
		mes "[Folklorist Gudra]";
		mes "这些精彩的故事激发了我的研究兴趣！";
		mes "以后请继续帮我记录阿米拉的故事。";
		next;
		mes "[Folklorist Gudra]";
		mes "如果你明天能回来记录故事的下一部分，我会很感激。";
		mes "谢谢。这是今天工作的报酬。";
		delitem 1000408,1;	// Ep18_Recording_Note
		completequest 16554;
		setquest 16559;
		getitem 1000405,20;	// Ep18_Amethyst_Fragment
		getexp 7769124,3000000;
		mes " ";
		mes "^4d4dff你获得了良好的评价。^000000";
		add_reputation_points(REPUTATION_EP18, 100);
		if (get_reputation_points(REPUTATION_EP18) >= 1000 && ep18_main == 36) {// Custom implementation: reputation 1000 on wolfvill => player can continue the main quest
			ep18_main = 37;
			setquest 18082;
		mes "^4d4dff灰狼村民已接受你成为村子的一员。^000000";
		mes "你有资格参加^4d4dff会议。^000000";
		}
		close;
	case 2:
		break;
	}
	switch( checkquest(16559,PLAYTIME) ) {
	case -1:
		break;
	case 0:
	case 1:
		mes "[Folklorist Gudra]";
		mes "虽然我很想今天听完所有故事……";
		mes "冒险者和村民都会累的。";
		next;
		mes "[Folklorist Gudra]";
		mes "今天剩下的时间好好休息，天亮后再回来。";
		mes "这期间我会整理并分析你收集的故事。";
		close;
	case 2:
		erasequest 16559;
		break;
	}
	switch( isbegin_quest(16558) ) {
	case 0:
		if ((isbegin_quest(16555)+isbegin_quest(16556)+isbegin_quest(16557)) == 0) {
			mes "[Folklorist Gudra]";
		mes "感谢你上次来访。";
		mes "今天我们也想记录我们的谈话。";
			next;
			mes "[Folklorist Gudra]";
		mes "迪纳尔和阿米拉，请去找莎妮娜奶奶听她的故事，然后记下来。";
		mes "这是给你们的空白笔记本。";
			next;
			if (select( "我去。", "现在有点困难。" ) == 2) {
				mes "[Folklorist Gudra]";
				mes "啊，现在有困难吗？没关系，我们之后再做。";
				mes "记住，这项工作需要耐心和坚持。";
				next;
				mes "[Folklorist Gudra]";
				mes "我们已经是同路的同事了，不是吗？";
				mes "如果累了就休息一下，只要继续稳步前进就好。";
				close;
			}
			mes "[Folklorist Gudra]";
			mes "谢谢你总是愿意帮忙。";
			mes "我会制作一本好故事书来回报这份好意。";
			next;
			mes "[Folklorist Gudra]";
			mes "哦，当然，今天的工作也会付给你报酬。";
			mes "这也很重要，对吧？我明白。";
			setquest 16555;
			setquest 16556;
			setquest 16557;
			getitem 1000408,1;	// Ep18_Recording_Note
			close;
		}
		if (countitem(1000408) < 1) {
			getitem 1000408,1;	// Ep18_Recording_Note
		}
		break;
	case 1:
		if (countitem(1000408) < 1) {
			getitem 1000408,1;	// Ep18_Recording_Note
		}
		mes "[Folklorist Gudra]";
		mes "迪纳尔和阿米拉，你们带来了莎妮娜奶奶的故事吗？";
		mes "我很期待听听是什么故事。请把笔记本给我看看。";
		next;
		mes "[Folklorist Gudra]";
		mes "阿米拉的故事中也有许多我熟悉的神话。";
		mes "这是这里所有原住民都听过、伴随成长的故事。";
		next;
		mes "[Folklorist Gudra]";
		mes "当然，这和我知道的神话有些不同……";
		mes "但研究这些差异和共同点正是我的工作，不是吗？";
		next;
		mes "[Folklorist Gudra]";
		mes "这些故事点燃了我的研究热情！";
		mes "希望你继续抄录阿米拉的故事。";
		next;
		mes "[Folklorist Gudra]";
		mes "如果你明天能回来抄录故事的下一部分，我会很感激。";
		mes "谢谢。这是今天工作的报酬。";
		delitem 1000408,1;	// Ep18_Recording_Note
		erasequest 16555;
		erasequest 16556;
		erasequest 16557;
		erasequest 16558;
		setquest 16559;
		add_reputation_points(REPUTATION_EP18, 30);
		if (get_reputation_points(REPUTATION_EP18) >= 5000)
			.@bonus = 1;
		if (get_reputation_points(REPUTATION_EP18) >= 1000 && ep18_main == 36) {// Custom implementation: reputation 1000 on wolfvill => player can continue the main quest
			ep18_main = 37;
			setquest 18082;
			mes "^4d4dff 灰狼村的村民接受你成为村子的一员。^000000";
		mes "你有资格参加^4d4dff会议。^000000";
		}
		getitem 1000405,3+.@bonus;	// Ep18_Amethyst_Fragment
		getexp 18252408,2000000;
		close;
	case 2:	// shouldn't happen
		break;
	}
	mes "[Folklorist Gudra]";
	mes "迪纳尔和阿米拉，请去莎妮奶奶家听她的故事并记下来。";
	close;

OnInit:
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "isbegin_quest(11724) == 2 && isbegin_quest(16554) == 0 && isbegin_quest(16551) == 0" );
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "isbegin_quest(16554) == 1" );

	// note: QTYPE_DAILYQUEST to take the quest, QTYPE_QUEST otherwise
	questinfo( QTYPE_DAILYQUEST, QMARK_YELLOW, "isbegin_quest(16554) == 2 && isbegin_quest(16558) == 0 && isbegin_quest(16555) == 0 && (checkquest(16559,PLAYTIME) == -1 || checkquest(16559,PLAYTIME) == 2)" );
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "isbegin_quest(16554) == 2 && isbegin_quest(16558) == 1" );
	end;
}

// Quest: Collecting Folklore. Step 2.
wolfvill,106,224,3	script	Dinar#ep18	4_F_DST_CHILD,{
	if (isbegin_quest(16551) == 1) {
		mes "[Dinar]";
		mes "你是来听我的故事的，对吧？";
		mes "哦，对了。我答应过古德拉奶奶！";
		next;
		mes "[Dinar]";
		mes "嗯，嗯。我只讲一次，所以仔细记下来。";
		mes "这是我亲身经历的事。";
		next;
		select( "不只是传闻？" );
		mes "[Dinar]";
		mes "传闻是什么？总之请注意听！";
		mes "很久以前，那时我还年轻。";
		next;
		select( "你现在还年轻……" );
		mes "[Dinar]";
		mes "哦，你总是打断我！";
		mes "在灰狼森林的灰狼中，有一只似乎是首领……";
		completequest 16551;
		if (isbegin_quest(16552) == 2 && isbegin_quest(16553) == 2) {
			unittalk getcharid(3), "" + strcharinfo(0) + "：三个故事都记下来了。我们回古德拉那里吧。", bc_self;
			setquest 16554;
		}
		close;
	}
	if (isbegin_quest(16555) == 1) {
		mes "[Dinar]";
		mes "你今天又来听我的故事了！";
		mes "古德拉阿姨说以后会把它写成书。";
		next;
		mes "[Dinar]";
		mes "嗯……上次讲到哪里了？";
		mes "是不是停在龙和精灵最终决战的场景中间？";
		next;
		mes "[Dinar]";
		mes "龙最后一次召唤巨大金属高塔时，精灵召唤巨大的火焰精灵与之对抗……";
		completequest 16555;
		if (isbegin_quest(16557) == 2 && isbegin_quest(16556) == 2) {
			unittalk getcharid(3), "" + strcharinfo(0) + "：三个故事都记下来了。我们回古德拉那里吧。", bc_self;
			setquest 16558;
		}
		close;
	}
	mes "[Dinar]";
	mes "我很喜欢阅读有趣的故事。";
	mes "阅读并想象接下来的故事更棒！";
	next;
	mes "[Dinar]";
	mes "角色会在我的脑海中活起来。";
	mes "我只要像看戏一样看着他们就好。";
	close;

OnInit:
	questinfo( QTYPE_QUEST2, QMARK_YELLOW, "isbegin_quest(16551) == 1" );
	questinfo( QTYPE_QUEST2, QMARK_YELLOW, "isbegin_quest(16555) == 1" );
	end;
}

// Quest: Collecting Folklore. Step 3.
wolfvill,180,204,3	script	Amira#ep18	4_F_DESERT,{
	if (isbegin_quest(16552) == 1) {
		mes "[Amira]";
		mes "你是古德拉姐姐请来的人吗？";
		mes "她提出了奇怪的请求，想听我知道的一个古老……故事。";
		next;
		mes "[Amira]";
		mes "总之，我答应讲述来到灰狼森林前从祖父那里听到的故事。";
		next;
		mes "[Amira]";
		mes "准备好听了吗？好，我慢慢讲。";
		mes "世界上的神明比我们知道的多得多……";
		completequest 16552;
		if (isbegin_quest(16551) == 2 && isbegin_quest(16553) == 2) {
			unittalk getcharid(3), "" + strcharinfo(0) + "：三个故事都记下来了。我们回古德拉那里吧。", bc_self;
			setquest 16554;
		}
		close;
	}
	if (isbegin_quest(16556) == 1) {
		mes "[Amira]";
		mes "你今天又来帮古德拉姐姐办事了。";
		mes "她想用这些故事做什么？";
		next;
		mes "[Amira]";
		mes "总之，我来讲下一个故事。";
		mes "这也是祖父告诉我们的故事，有些神明仍然……";
		next;
		mes "[Amira]";
		mes "……那么，嗯，名字是什么来着？我记不太清了，不过重要的是……";
		completequest 16556;
		if (isbegin_quest(1655) == 2 && isbegin_quest(16557) == 2) {
			unittalk getcharid(3), "" + strcharinfo(0) + "：三个故事都记下来了。我们回古德拉那里吧。", bc_self;
			setquest 16558;
		}
		close;
	}
	mes "[Amira]";
	mes "祖父就是这么说的。不能忘记我们的神明很重要。";
	mes "所以他才把这些故事都告诉我。";
	next;
	mes "[Amira]";
	mes "我听过很多故事，但现在有些已经忘记了……";
	mes "如果古德拉姐姐把它们写成书，我就不会再忘记了。";
	close;

OnInit:
	questinfo( QTYPE_QUEST2, QMARK_YELLOW, "isbegin_quest(16552) == 1" );
	questinfo( QTYPE_QUEST2, QMARK_YELLOW, "isbegin_quest(16556) == 1" );
	end;
}

// Quest: Collecting Folklore. Step 4.
wolfvill,154,184,5	script	Shanina#ep18	4_F_DST_GRAND,{
	if (isbegin_quest(16553) == 1) {
		mes "[Shanina]";
		mes "啊，古德拉的委托？你是来听古老传说的，对吧？";
		mes "我给你讲个故事。这是很古老的故事，也许不是所有人都喜欢，但这是我祖母曾经讲给我的故事。";
		next;
		mes "[Shanina]";
		mes "担心不够有趣？别担心，会是愉快的消遣。";
		next;
		mes "[Shanina]";
		mes "很久很久以前，在遥远的过去，住着一位铁匠……";
		completequest 16553;
		if (isbegin_quest(16551) == 2 && isbegin_quest(16552) == 2) {
			unittalk getcharid(3), "" + strcharinfo(0) + "：三个故事都记下来了。我们回古德拉那里吧。", bc_self;
			setquest 16554;
		}
		close;
	}
	if (isbegin_quest(16557) == 1) {
		mes "[Shanina]";
		mes "你又来帮古德拉办事了。真勤快。";
		mes "你说我讲的故事还不错，对吧？";
		next;
		mes "[Shanina]";
		mes "如果能帮到古德拉，我就很高兴。";
		mes "故事讲到哪里了？今天该讲新故事了吗？";
		next;
		mes "[Shanina]";
		mes "哦，上个故事还没讲完，对吧？我的记性有点模糊。";
		mes "我说过铁匠骑着猫头鹰从天上下来吗？";
		next;
		mes "[Shanina]";
		mes "对，我记起来了。";
		mes "那么请讲下一部分。可怜的妖精……";
		completequest 16557;
		if (isbegin_quest(16555) == 2 && isbegin_quest(16556) == 2) {
			unittalk getcharid(3), "" + strcharinfo(0) + "：三个故事都记下来了。我们回古德拉那里吧。", bc_self;
			setquest 16558;
		}
		close;
	}
	mes "[Shanina]";
	mes "我现在的生活没什么刺激，但给孩子们讲古老传说很快乐。";
	next;
	mes "[Shanina]";
	mes "有人愿意倾听，我非常感激。愿祝福降临于他们。";
	close;

OnInit:
	questinfo( QTYPE_QUEST2, QMARK_YELLOW, "isbegin_quest(16553) == 1" );
	questinfo( QTYPE_QUEST2, QMARK_YELLOW, "isbegin_quest(16557) == 1" );
	end;
}

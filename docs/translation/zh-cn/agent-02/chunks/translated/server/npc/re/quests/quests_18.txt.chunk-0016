}

// Quest: Ahab's Request. Step 5.
rachel,135,64,3	script	Shopkeeper#ep18	4_M_RACHMAN2,{
	if (isbegin_quest(16563) == 1) {
		mes "[Shop Owner]";
		mes "欢迎光临，这里是穆诺玛特杂货店。";
		mes "您在找什么食材？";
		next;
		if (select( "奥比雷格酱", "奥比格酱", "奥伊格酱", "奥伊格酱" ) != 3) {
			mes "[Shop Owner]";
		mes "嗯？我们没有那种酱。";
		mes "我以前甚至没听说过这个名字的酱。";
			close;
		}
		mes "[Shop Owner]";
		mes "啊，奥伊格酱！让我看看……在这里。";
		mes "这种酱含有黄瓜和酸奶，非常清爽。涂在面包上味道很棒。";
		next;
		mes "[Shop Owner]";
		mes "您要多少？一瓶？给您。";
		mes "请存放在阴凉处，开封后尽快食用。";
		erasequest 16563;
		setquest 16564;
		close;
	}
	mes "[Shop Owner]";
	mes "欢迎光临，这里是穆诺玛特杂货店。";
	mes "没错，这是拉谢尔最好的杂货店。";
	next;
	mes "[Shop Owner]";
	mes "大多数餐厅都使用我们的食材。";
	mes "带回家加热、烹饪，瞧！马上就能做出美味的一餐！";
	close;

OnInit:
	questinfo( QTYPE_QUEST2, QMARK_YELLOW, "isbegin_quest(16563) == 1" );
	end;
}

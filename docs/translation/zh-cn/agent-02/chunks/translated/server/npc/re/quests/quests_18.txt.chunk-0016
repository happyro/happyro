// Quest: Purifying Water. Step 1 + 4 (final).
wolfvill,103,230,3	script	Budan#ep18	4_M_RACHMAN1,{
	if (checkweight(1000405,20) == 0) {
		mes "- Wait a minute !! -";
		mes "- 你目前携带了-";
		mes "- 太多物品。-";
		mes "- 请减轻负重后-";
		mes "- 再试一次。-";
		close;
	}
	if (ep18_main < 36) {
		mes "[Budan]";
		mes "外来者一直进进出出。";
		mes "如果你只是出于好奇来探听，我不能让你进去。";
		close;
	}
	switch( isbegin_quest(8693) ) {
	case 0:
		if (isbegin_quest(8691) == 1 || isbegin_quest(8692) == 1) {
			mes "[Budan]";
			mes "如果你去神殿前面，那天应该会有做善事的信徒在那里。";
			mes "说几句话把它买来就好。";
			mes "拜托你了。";
			close;
		}
		// isbegin_quest(8691) == 0
		mes "[Budan]";
		mes "我们听说你一直在插手我们的事……";
		mes "我还听说他们会教你轻松完成。";
		mes "你也能帮我吗？";
		next;
		mes "[Budan]";
		mes "如你所见，我们不容易前往拉谢尔。";
		mes "所以冒险者，我真的想请你帮忙。";
		next;
		mes "[Budan]";
		mes "我想请你弄来一些只有拉谢尔塞斯鲁姆尼尔神殿才能制作的东西。";
		mes "如你所见，拉谢尔周边有火山灰和沙尘，这一带很难获得干净的水。";
		next;
		mes "[Budan]";
		mes "所以我开发了净水神器……";
		mes "这东西会通过某种未知的魔法过程吸收水中的污物。";
		mes "连各种杂乱的魔力也能吸收。";
		next;
		mes "[Budan]";
		mes "即使是含有这片森林神秘魔力的硫磺泉水，也能变成饮用水。";
		mes "但魔力持续不了多久……所以需要时必须购买。";
		next;
		mes "[Budan]";
		mes "你明白了吧。";
		mes "能请你帮忙吗？";
		mes "就算我们亲自去……他们也不会卖给我们。";
		next;

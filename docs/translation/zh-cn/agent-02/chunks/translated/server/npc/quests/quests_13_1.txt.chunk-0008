mid_camp,188,254,3	script	Monster Scholar#ep13	883,{
	if (ep13_ryu < 100 && ep13_start < 100) {
		mes "[Monster Scholar]";
		mes "你……你是谁？";
		mes "你来自空间裂隙的另一";
		mes "边吗？";
		mes "你是学者、士兵，还是";
		mes "村庄";
		mes "代表？";
		next;
		mes "[Monster Scholar]";
		mes "哦，抱歉。";
		mes "如果你不想说，";
		mes "可以不用告诉我……";
		close;
	}
	else {
		if (ep13_animal == 0) {
			mes "[Monster Scholar]";
			mes "你……你是谁？";
			mes "你来自空间裂隙的另一";
			mes "边吗？";
			mes "你是学者、士兵，还是";
			mes "村庄";
			mes "代表？";
			next;
			mes "[Monster Scholar]";
			mes "哦，抱歉。";
			mes "如果你不想说，";
			mes "可以不用告诉我……";
			next;
			mes "[Monster Scholar]";
			mes "请继续做你该做的事。";
			mes "请按你的需要行动。";
			mes "哦，我？不用担心。";
			mes "我自己没问题。";
			next;
			select("你是谁？");
			mes "[Monster Scholar]";
			mes "我是鲁米斯·布洛克，";
			mes "代表施瓦尔茨瓦德共和国的";
			mes "魔物经济学学院";
			mes "在这里工作。";
			mes "植物学家特里斯·布洛克是";
			mes "我的双胞胎哥哥。";
			next;
			emotion ET_THINK;
			mes "[Rumis Block]";
			mes "这里冷得要命。不仅如此，";
			mes "这里荒无人烟，安静得过分。";
			mes "……周围的一切都在监视";
			mes "并威胁我们。";
			mes "你知道，我本来不想";
			mes "来这里……";
			next;
			select("你是怎么来到这里的？");
			mes "[Rumis Block]";
			mes "事实上，我们谁都不想";
			mes "来这里。";
			mes "我的意思是，没人知道";
			mes "这个未知世界潜藏着";
			mes "什么样的危险。";
			next;
			mes "[Rumis Block]";
			mes "是我哥哥特里斯想让我";
			mes "一起过来的。";
			mes "他最先被选为大陆远征队的";
			mes "植物学家。";
			mes "因为我不想来，";
			mes "他只好把我拖到这里。";
			next;
			mes "[Rumis Block]";
			mes "我想，他是不愿独自待在";
			mes "这个远离文明的世界。于是他";
			mes "决定把我拖到这里，";
			mes "强迫我加入远征队，";
			mes "这样他就不会感到孤单了！";
			mes "真是的！";
			next;
			mes "[Rumis Block]";
			mes "你那副嫌弃的表情是怎么回事？";
			mes "怎么，我听起来像是在";
			mes "把自己生活的不幸";
			mes "归咎于别人吗？";
			next;
			mes "[Rumis Block]";
			mes "我告诉你，这是真的。";
			mes "有些人想逃离远征队，";
			mes "故意把自己弄生病，";
			mes "好借此离开。";
			next;
			mes "[Rumis Block]";
			mes "我知道现在抱怨已经太晚，";
			mes "但是……";
			next;
			mes "[Rumis Block]";
			mes "我每天都向神祈祷，";
			mes "让我平安回家。";
			mes "只有这件事";
			mes "支撑着我。这里的一切";
			mes "都在监视我。";
			mes "很让人窒息，你知道吗？";
			next;
			select("你什么时候回去？");
			mes "[Rumis Block]";
			mes "问题就在这里。";
			mes "我们这些专家必须";
			mes "向远征队的领导者";
			mes "提交研究报告。";
			mes "我们来这里是为了探索";
			mes "并研究这个世界。";
			next;
			mes "[Rumis Block]";
			mes "我相信管理层会";
			mes "告诉我何时回去，但";
			mes "我不认为会很快。至少要等到";
			mes "我提交报告之后";
			mes "才有可能回去。";
			next;
			mes "[Rumis Block]";
			mes "我必须告诉你，";
			mes "我讨厌这里！";
			mes "这里让我毛骨悚然！";
			next;
			mes "[Rumis Block]";
			mes "是的，我是魔物学者，";
			mes "但即使在米德加尔特大陆时，我也一直害怕魔物……";
			next;
			mes "[Rumis Block]";
			mes "不，但你难道看不出来吗？";
			mes "这里对我来说完全陌生，";
			mes "一切都如此未知……";
			next;
			mes "[Rumis Block]";
			mes "我也许是魔物学者，";
			mes "但我很害怕……";
			mes "害怕很多事情……";
			next;
			mes "[Rumis Block]";
			mes "米德加尔特联合公司的";
			mes "总裁要求我寻找一些";
			mes "可以食用的魔物。";
			mes "这就是我的任务。";
			next;
			mes "[Rumis Block]";
			mes "但看看外面，快看！";
			mes "你看到曼陀罗花了吗？";
			mes "它们藏在冰冷的灌木丛里。";
			mes "那些叫作 ^3131FF奈蓬特斯^000000。";
			next;
			mes "[Rumis Block]";
			mes "它们是不是看起来十分";
			mes "凶猛又吓人？";
			mes "它们好像想用";
			mes "那些尖刺蛰我！";
			mes "啊……";
			mes "真可怕……";
			next;
			mes "[Rumis Block]";
			mes "我宁愿饿死，";
			mes "也不愿研究";
			mes "那些危险又";
			mes " 丑陋的魔物！";
			mes "我不会走出";
			mes "我的帐篷。";
			next;
			mes "[Rumis Block]";
			mes "绝不。";
			mes "没人敢穿过";
			mes "如此危险的";
			mes "这样令人恐惧的";
			mes "环境！";
			set ep13_animal,1;
			setquest 2147;
			close;
		}
		else if (ep13_animal == 1) {
			mes "[Rumis Block]";
			mes "我不会走出";
			mes "我的帐篷。";
			mes "绝不。";
			close;
		}
		else if (ep13_animal == 2) {
			if (countitem(6041) > 0) {
				mes "[Rumis Block]";
				mes "我害怕这里。";
				mes "但我不会向";
				mes "哥哥求助，";
				mes "他讨厌我。";
				next;
				mes "[Rumis Block]";
				mes "如果奈蓬特斯";
				mes "靠近我，";
				mes "面带微笑，";
				mes "亲切地对我说话……";
				next;
				mes "[Rumis Block]";
				mes "*叹气* 我听起来很疯狂，对吧？";
				mes "……这就是我不想";
				mes "离开实验室的原因……";
				next;
				switch(select("展示奈蓬特斯的战利品。:责骂他。:安慰他。")) {
				case 1:
					mes "["+strcharinfo(0)+"]";
					mes "嘿，看看这里……";
					mes "这些奈蓬特斯并不";
					mes "比家乡的更凶猛或丑陋";
					mes "。";
					next;
					mes "[Rumis Block]";
					mes "……这是什么？";
					mes "这不是奈蓬特斯的";
					mes "东西吗？";
					next;
					mes "["+strcharinfo(0)+"]";
					mes "没错！";
					mes "我解决了它们。";
					mes "很简单，哈哈！";
					next;
					mes "[Rumis Block]";
					mes "真不敢相信你真的";
					mes "解决了它们！告诉我，";
					mes "你到底是谁？";
					mes "你是士兵吗？";
					mes "队长？还是特工？";
					next;
					mes "["+strcharinfo(0)+"]";
					mes "不，我只是一个四处游历的";
					mes "冒险者。我来到这里";
					mes "是为了挑战这个新地方，";
					mes "也为了帮助大家~";
					next;
					mes "[Rumis Block]";
					mes "我……我明白了。";
					mes "我听说过一些冒险者";
					mes "为米德加尔特";
					mes "带来了积极影响。";
					mes "你就是其中之一，对吧？";
					next;
					mes "[Rumis Block]";
					mes "……太好了！";
					mes "我想我终于找到了";
					mes "一线希望。神为我";
					mes "派来了救星。";
					mes "我想那就是你！";
					next;
					mes "[Rumis Block]";
					mes "求你了，别说你";
					mes "不想帮我。";
					mes "你难道看不出来吗？";
					mes "我害怕得直发抖。";
					mes "请帮帮我，好吗？";
					next;
					mes "[Rumis Block]";
					mes "正如我之前告诉你的，";
					mes "我有一个双胞胎哥哥，";
					mes "特里斯·布洛克……";
					next;
					mes "[Rumis Block]";
					mes "他是植物学家，非常";
					mes "强壮而且外向，和我不同。";
					mes "我想他讨厌我是因为";
					mes "我代表着软弱，";
					mes "而他完全相反。";
					mes "他是个截然不同的人。";
					next;
					mes "[Rumis Block]";
					mes "……哦，我不是想说这个。";
					mes "我想把关于奈蓬特斯的";
					mes "发现展示给我的哥哥。";
					mes "这才是我想说的。";
					next;
					mes "[Rumis Block]";
					mes "我需要一份奈蓬特斯标本，";
					mes "但我没有制作标本的工具，";
					mes "我的行李还在转运中。";
					mes "而且我也没带够工具，";
					mes "所以……";
					next;
					mes "[Rumis Block]";
					mes "要制作标本工具，";
					mes "我需要 ^3131FF1 个空瓶、";
					mes "5 瓶圣水，和";
					mes "30 个黏液^000000。";
					next;
					mes "[Rumis Block]";
					mes "你知道我在";
					mes "请求什么，对吧？";
					mes "帮帮我，求你了。";
					delitem 6041,1; //Strong_Bine
					set ep13_animal,3;
					changequest 2147,2148;
					close;
				case 2:
					mes "["+strcharinfo(0)+"]";
					mes "你自称魔物学者，";
					mes "却害怕运用自己的专业知识。";
					mes "你不过是个胆小鬼。";
					mes "真是名不副实。";
					next;
					mes "[Rumis Block]";
					mes "我可以接受你的批评，";
					mes "但我无法隐藏真实感受。";
					close;
				case 3:
					mes "["+strcharinfo(0)+"]";
					mes "别这样，你可是受人尊敬的";
					mes "魔物学者。你会发现";
					mes "这个世界的魔物";
					mes "和米德加尔特的并没有太大不同。";
					mes "为什么不亲自";
					mes "看看呢？";
					next;
					mes "- 鲁米斯似乎-";
					mes "- 没有被说服。-";
					mes "- 他摇头表示拒绝。-";
					close;
				}
			}
			else {
				mes "[Rumis Block]";
				mes "我不会走出";
				mes "我的帐篷。";
				mes "绝不。";
				close;
			}
		}
		else if (ep13_animal == 3) {
			if ((countitem(713) > 0) && (countitem(523) > 4) && (countitem(938) > 29)) {
				mes "[Rumis Block]";
				mes "谢谢你。";
				mes "你带来了材料。";
				next;
				mes "[Rumis Block]";
				mes "你收集材料时，";
				mes "我派出了士兵";
				mes "去抓几只奈蓬特斯。";
				next;
				mes "[Rumis Block]";
				mes "奈蓬特斯看起来非常";
				mes "像米德加尔特大陆上的";
				mes "曼陀罗花。";
				next;
				mes "[Rumis Block]";
				mes "它们一定拥有相同的";
				mes "祖先，不过显然";

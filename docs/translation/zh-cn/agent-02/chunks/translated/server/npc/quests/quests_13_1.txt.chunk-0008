		mes "- 寻找修理它的材料。-";
		close;
	}
	else if (ep13_newbs == 7) {
		mes "- 柱子坏了。-";
		mes "- 如果不尽快修好，-";
		mes "- 营房就会倒塌。-";
		next;
		while(1) {
			switch(select("安装树枝横杆。:用藤蔓捆起来。")) {
			case 1:
				mes "- 你把树枝横杆-";
				mes "- 接到断裂的柱子上。-";
				next;
				break;
			case 2:
				if (rand(1,5) == 2) {
					mes "- 你把断裂的柱子捆好。-";
					next;
					mes "- 看起来修好了。-";
					next;
					mes "[Diego]";
					mes "哦！现在你需要把它";
					mes "打结并完成修理。";
					next;
					switch(select("把它打结。:放着不管。")) {
					case 1:
						mes "- 你打了一个完美的结。-";
						next;
						mes "[Diego]";
						mes "这根柱子也应该打结。";
						mes "请把那根柱子也修好。";
						set ep13_newbs,8;
						changequest 11088,11089;
						close;
					case 2:
						mes "- 你决定离开。-";
						next;
						mes "- 树枝滑落了。-";
						mes "- 你没能修好它。-";
						next;
						mes "[Diego]";
						mes "...";
						mes "你为什么不帮忙？";
						emotion ET_CRY;
						close;
					}
				}
				else {
					mes "- 你用藤蔓-";
					mes "- 修好了断裂的柱子。-";
					mes "- 看来你-";
					mes "- 还需要更多树枝。-";
					next;
				}
				break;
			}
		}
	}
	else if (ep13_newbs == 8) {
		mes "[Diego]";
		mes "这根柱子修好了。";
		mes "请对其他柱子";
		mes "也做同样的事。";
		close;
	}
	else {
		mes "- 用藤蔓捆住的柱子-";
		mes "- 看起来不太稳固，-";
		mes "- 但我的修理很完美。-";
		close;
	}
}


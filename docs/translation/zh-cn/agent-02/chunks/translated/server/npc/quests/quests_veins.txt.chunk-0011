ra_temin,5,5,3	script	vol_time	844,{
OnInit:
	stopnpctimer;
	end;

OnEnable:
	initnpctimer;
	enablenpc "Rachel Guard#vol1_1";
	end;

OnTimer10000:
	mapannounce "ra_temin","守卫卡鲁姆：拉米尔！是我，卡鲁姆！你的爱人来了！",bc_map,"0xFFCE00";
	end;

OnTimer15000:
	mapannounce "ra_temin","拉米尔：卡鲁姆？你来这里做什么？",bc_map,"0xFFCE00";
	end;

OnTimer20000:
	mapannounce "ra_temin","守卫卡鲁姆：你不用再装了。现在我明白你的冷漠是在掩饰爱意~",bc_map,"0xFFCE00";
	end;

OnTimer30000:
	mapannounce "ra_temin","拉米尔：你在说什么？抱歉，卡鲁姆，但我对你没有特别的感情。",bc_map,"0xFFCE00";
	end;

OnTimer35000:
	mapannounce "ra_temin","守卫卡鲁姆：我知道，承认真心很让人难为情~",bc_map,"0xFFCE00";
	end;

OnTimer40000:
	mapannounce "ra_temin","守卫卡鲁姆：不过，我不能否认你的羞涩让我的心都碎了。",bc_map,"0xFFCE00";
	end;

OnTimer45000:
	mapannounce "ra_temin","拉米尔：卡鲁姆，你什么时候才能明白我从未爱过你，也永远不会爱上你？",bc_map,"0xFFCE00";
	end;

OnTimer50000:
	mapannounce "ra_temin","守卫卡鲁姆：.............",bc_map,"0xFFCE00";
	end;

OnTimer55000:
	mapannounce "ra_temin","守卫卡鲁姆：什——？可是我以为……？呃，抱歉。我该走了……",bc_map,"0xFFCE00";
	stopnpctimer;
	disablenpc "Rachel Guard#vol1_1";
	enablenpc "Rachel Guard#vol1";
	end;
}


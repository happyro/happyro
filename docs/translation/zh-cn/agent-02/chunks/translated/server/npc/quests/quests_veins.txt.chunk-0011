ra_temin,115,140,1	script	Flower Vase#vol	111,{
	if ((aru_vol > 2) && (aru_vol < 5)) {
		mes "^3355FF你发现一个巨大的花瓶，里面装满了看起来刚从花园摘下来的美丽鲜花。^000000";
		next;
		if (select("砸碎花瓶:不砸花瓶") == 1) {
			mes "^3355FF你双手抓住花瓶，然后把它扔到地上。^000000";
			next;
			mes "^3355FF*哐！*^000000";
			next;
			mes "[Guard Krodger]";
			mes "谁在那里？！";
			disablenpc "Rachel Guard#vol2";
			enablenpc "Rachel Guard#vol2_1";
			donpcevent "vol_time2::OnEnable";
			set aru_vol,4;
			disablenpc "Flower Vase#vol";
			close;
		}
		mes "["+strcharinfo(0)+"]";
		mes "这些花经过了精心照料和布置……我不忍心破坏它们的美丽。";
		next;
		mes "^3355FF于是你站在那里，看起来有点可怜，但还没到真正悲惨的程度。^000000";
		close;
	}
	mes "^3355FF你发现一个巨大的花瓶，里面装满了看起来刚从花园摘下来的美丽鲜花。^000000";
	close;
}


ra_temin,85,118,3	script	Drawer#vol3	111,{
	if ((MaxWeight-Weight) < 2000 || checkweight(1201,1) == 0) {
		mes "^3355FF等一下！你现在携带的东西太多了。请使用卡普拉服务存放一些物品后再回来。^000000";
		close;
	}
	if (aru_vol == 4) {
		mes "^3355FF你在这个抽屉里找到一大叠提交给大祭司的报告。^000000";
		next;
		if (select("查看报告:取消") == 1) {
			mes "["+strcharinfo(0)+"]";
			mes "嗯，这也许不太道德，但我觉得至少应该看看其中一些。";
			next;
			mes "^3355FF你开始翻阅文件，浏览几份感兴趣的报告。^000000";
			next;
			mes "["+strcharinfo(0)+"]";
			mes "哦……这可能就是我要找的。";
			next;
			mes "^3355FF你取出封面上标有“维恩斯地质研究所”的厚重报告，然后关上抽屉。^000000";
			changequest 2114,2115;
			set aru_vol,5;
			getitem 7342,1; //File01
			close;
		}
		mes "["+strcharinfo(0)+"]";
		mes "算了。我没有获得查看这些文件的许可。";
		close;
	}
	else if (aru_vol == 5) {
		if (countitem(7342) < 1) {
			mes "["+strcharinfo(0)+"]";
			mes "哦！这里还有一份我想要的报告副本！真幸运~";
			getitem 7342,1; //File01
			close;
		}
		mes "^3355FF你在这个抽屉里找到一大叠提交给大祭司的报告。^000000";
		close;
	}
	mes "^3355FF你在这个抽屉里找到一大叠提交给大祭司的报告。^000000";


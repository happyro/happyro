		mes "[Toby]";
		mes "洛肯洛克先生？那我该去哪里找他？";
		next;
		mes "[Toby]";
		mes "他总是坐在市场街的某个地方。不过他酒喝得很多，宿醉时可不会工作。";
		next;
		mes "[Toby]";
		mes "不过你知道什么能让他立刻清醒吗？黄色药水！对那家伙从来都有效！";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "原来如此。谢谢你的建议。";
		next;
		mes "[Toby]";
		mes "不用客气！只是……这么多年来……我终于对某个人有用了！";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "……哈……？";
		next;
		mes "^3355FF去市场街找洛肯洛克先生，并带给他一瓶黄色药水。^000000";
		changequest 3062,3063;
		set rachel_camel,4;
		close;
	}
	else if (rachel_camel == 4) {
		mes "[Toby]";
		mes "这么多年来……我终于对某个人有用了！";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "……哈……？";
		next;
		mes "^3355FF去市场街找洛肯洛克先生，并带给他一瓶黄色药水。^000000";
		close;
	}
	else {
		mes "[Native Young Man]";
		mes "我叫托比。我在这里出生长大，没有人比我更了解这座城镇。需要找路的话，尽管问我。";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "不用了，谢谢。";
		next;
		mes "[Native Young Man]";
		mes "你不需要我……^333333*抽泣*^000000 你完全不需要我吗？";
		close;
	}
}


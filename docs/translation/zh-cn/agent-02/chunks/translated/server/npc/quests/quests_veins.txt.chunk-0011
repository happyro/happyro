ra_temin,40,124,3	script	Female Follower#vol	920,{
	mes "[Lamir]";
	mes "^333333*叹气*^000000 维尔特大祭司吃完后剩下了好多食物。他难道不知道要把饭吃完吗？";
	next;
	mes "[Lamir]";
	mes "我小时候，如果不把饭吃完，妈妈总会威胁说要让我嫁给卡鲁姆。于是我学会了再也不留下剩饭~";
	next;
	select("卡鲁姆是谁？");
	mes "[Lamir]";
	mes "卡鲁姆？哦，他从我们小时候起就一直追着我，宣称爱着我什么的。即使长大后，他在这件事上还是很固执。";
	next;
	mes "[Lamir]";
	mes "呃！直到今天他还让我烦透了！他在维尔特大祭司的办公室当守卫是很好，但拜托！他为什么不能去烦别的女孩？";
	if (aru_vol == 1) {
		set aru_vol,2;
	}
	close;
}


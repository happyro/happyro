ra_temin,87,133,1	script	Rachel Guard#vol1	934,5,2,{
	if (aru_vol == 2) {
		mes "[Guard Karlum]";
		mes "维尔特大祭司现在不在。想见他的话，请稍后再来。";
		next;
		select("想办法引开他");
		mes "["+strcharinfo(0)+"]";
		mes "这家伙不会让我通过。让我想想……有没有办法让他离开？什么，或者^FF0000谁^000000能引开他？";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "等一下……当然了！我应该和他谈谈……";
		next;
		input .@input$;
		mes "["+strcharinfo(0)+"]";
		mes "等一下……当然了！我应该和他谈谈^FF0000"+.@input$+"^000000！！";
		next;
		if (.@input$ != "Lamir") {
			mes "["+strcharinfo(0)+"]";
			mes "什么……？我怎么会想到这个？完全说不通……";
			close;
		}
		mes "["+strcharinfo(0)+"]";
		mes "没错！我之前和拉米尔谈过。如果她说得对，这家伙一定是卡鲁姆，也就是那个深爱着她的人。嗯……我知道该说什么了……";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "^333333*清嗓*^000000 打扰一下，你是卡鲁姆吗？我有句话要带给你。";
		next;
		mes "[Guard Karlum]";
		mes "给我的话？你还在这里徘徊就是因为这个？那就快说。我工作时可没多少空闲……";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "你认识^3131FF拉米尔^000000，对吧？";
		next;
		emotion ET_HUK;
		mes "[Guard Karlum]";
		mes "拉米尔？哦……天啊。糟了！她出什么事了吗？快告诉我！";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "不，没那回事。她只是告诉我有重要的事要对你说，让你有空时去见她。";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "我试着多问几句，但她只是一直脸红并转过身去。你们之间是不是发生了什么？";
		next;
		mes "[Guard Karlum]";
		mes "……我不敢相信。终于，在这么多年之后，她对我的感情也是一样的！几天前我午夜时分的 serenade 一定打动了她的心。";
		next;
		mes "[Guard Karlum]";
		mes "去他的破工作！我已经做出选择，我选择真爱！不能再让拉米尔等下去了！";
		set aru_vol,3;
		donpcevent "vol_time::OnEnable";
		close2;
		disablenpc "Rachel Guard#vol1";
		end;
	}
	else if ((aru_vol > 2) && (aru_vol < 5)) {
		mes "[Guard Karlum]";
		mes "嘿！拉米尔告诉我她根本不想见我！你到底想干什么？你以为我这么容易被骗吗？";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "什么？事情是这样吗？我明明以为她——哦，我明白了。她一定是在欲擒故纵。这说明她真的非常喜欢你。";
		next;
		mes "[Guard Karlum]";
		mes "啊！这样就说得通了！难怪她那样对我！哈哈哈！我早该想到的！那么，我也该去见她，和她玩玩欲擒故纵！";
		donpcevent "vol_time::OnEnable";
		close2;
		disablenpc "Rachel Guard#vol1";
		end;
	}
	mes "[Guard Karlum]";
	mes "维尔特大祭司现在不在。想见他的话，请稍后再来。";
	close;

OnInit:
	enablenpc "Rachel Guard#vol1";
	end;

OnTouch:
	warp "ra_temin",85,137;
	end;
}


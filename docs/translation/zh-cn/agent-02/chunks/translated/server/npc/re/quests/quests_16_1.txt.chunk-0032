prt_q,111,166,0	script	Emergency Medicine#EP161BU05	HIDDEN_WARP_NPC,6,6,{
	end;
OnTouch:
	if (isbegin_quest(5464) == 1)
		cloakoffnpcself( "Female#EP161BU03" );
	else if (isbegin_quest(5466) == 1) {
		mes "这似乎是艾莉逃跑时掉落的一包药。";
		next;

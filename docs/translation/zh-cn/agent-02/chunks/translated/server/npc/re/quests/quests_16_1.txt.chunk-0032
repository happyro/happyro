prt_q,38,261,0	script	Married couple Quest_START#EP161QU04	HIDDEN_WARP_NPC,6,6,{
	end;
OnTouch:
	if (isbegin_quest(5451) == 1) {
		cloakoffnpcself( "Eryus#EP161BU01" );

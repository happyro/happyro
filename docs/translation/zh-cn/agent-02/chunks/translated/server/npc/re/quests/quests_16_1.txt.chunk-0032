prt_q,140,304,6	script	Soldier#EP161HU01	4_M_GEF_SOLDIER,{
	if (checkweight(1301,1) == 0) {
		mes "- 你持有的物品太多，无法继续任务。-";
		close;
	}
	if (isbegin_quest(5450) == 1) {
		emotion ET_KEK;
		mes "[Soldier]";
		mes "啊！不死族！放马过来！";
		next;
		emotion ET_SCRATCH, playerattached();
		mes "[" + strcharinfo(0) + "]";
		mes "喂，你躲在里面还叫它们放马过来，有什么用……";
		next;
		emotion ET_SWEAT;
		mes "[Soldier]";
		mes "冒险者，你不明白。我和不死族苦战很久后被逼到了这个角落。";
		next;
		mes "[Soldier]";
		mes "在这种情况下还敢在城里四处走动，你一定很勇敢。";
		next;
		emotion ET_OK;
		mes "[Soldier]";
		mes "你一定和我一样勇敢……那个在吉芬讨伐狗头人的英雄……";
		next;
		mes "[Soldier]";
		mes "哈哈哈哈哈";
		mes "来得正好。不死族的攻击让我快累坏了。";
		next;
		mes "[Soldier]";
		mes "我正要去附近的避难所躲起来。你愿意和我一起去吗？";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "嗯，当然。";
		next;
		erasequest 5450;// Request from Chief Guard
		setquest 5460;// Blatant Bluff(1)
		emotion ET_PROFUSELY_SWEAT;
		viewpoint 2,140,304,1,0xFF0000;
		mes "[Soldier]";
		mes "很好。我在之前的战斗中累坏了，请护送我去骑士楼。";
		close2;
		cloakonnpcself( "Soldier#EP161HU01" );
		end;
	}
	mes "[Soldier]";
	mes "哈哈，你看得见我吗？真奇怪。我本来不该被看见。";
	close2;
	cloakonnpcself( "Soldier#EP161HU01" );
	end;
}

prt_q,68,336,4	script	Soldier#EP161HU02	4_M_GEF_SOLDIER,{
	if (checkweight(1301,1) == 0) {
		mes "- 你持有的物品太多，无法继续任务。-";
		close;
	}
	if (isbegin_quest(5460) == 1) {
		emotion ET_BEST;
		mes "[Soldier]";

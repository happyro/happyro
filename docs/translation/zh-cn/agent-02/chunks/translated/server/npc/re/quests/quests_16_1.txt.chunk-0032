		next;
		emotion ET_PROFUSELY_SWEAT;
		mes "[Soldier]";
		mes "亲爱的冒险者，你什么都不懂。";
		next;
		mes "[Soldier]";
		mes "哦，我本来不想告诉你这件事，因为不想炫耀……";
		next;
		mes "[Soldier]";
		mes "以前曾有数百万狗头人入侵吉芬。";
		next;
		emotion ET_PROFUSELY_SWEAT;
		mes "[Soldier]";
		mes "狗头人无尽的行军……";
		next;
		mes "[Soldier]";
		mes "啊……一想到这件事我就冒汗……";
		next;
		emotion ET_QUESTION;
		mes "[Soldier]";
		mes "嗯，根据我的经验，敌人突然进攻时，像这里这样的地方最难守卫。";
		next;
		mes "[Soldier]";
		mes "有个秘密：这正是英雄崛起的最佳时机。";
		next;
		mes "[Soldier]";
		mes "我会在里面休息，等这里遇到危险时再出来拯救大家。你去拯救其他地方吧。";

		mes "[Soldier]";
		mes "祝你好运。";
		close2;
		cloakonnpcself( "Soldier#EP161HU03" );
		end;
	}
	mes "[Soldier]";
		mes "哈哈，你看得见我吗？真奇怪。我本来不该被看见。";
	close2;
	cloakonnpcself( "Soldier#EP161HU03" );
	end;

OnInit:
	cloakonnpc();
	end;

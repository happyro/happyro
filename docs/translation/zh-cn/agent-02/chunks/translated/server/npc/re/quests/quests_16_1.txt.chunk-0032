prt_q,38,261,6	script	Eryus#EP161BU01	4_F_03,{
	if (checkweight(1301,1) == 0) {
		mes "- 你持有的物品太多，无法继续任务。-";
		close;
	}
	if (isbegin_quest(5451) == 1) {
		emotion ET_THANKS;
		mes "[Eryus]";
		mes "你是冒险者吗？";
		mes "哦，奥丁……谢谢你！亲爱的冒险者，请帮我找找妻子。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "这里发生了什么？";
		next;
		mes "[Eryus]";
		mes "事情发生在傍晚，天黑的时候。";
		mes "我们听到一声巨响，好像有什么东西掉在老剑士公会附近。";
		next;
		mes "[Eryus]";
		mes "许多居民聚集到那里，想弄清是什么引起了骚动。";
		next;
		mes "[Eryus]";
		mes "我和妻子艾莉一起去了那里。";
		next;
		emotion ET_OTL;
		mes "[Eryus]";
		mes "人们聚集起来、夜幕降临后，埋在普隆德拉地下的不死族开始苏醒。";
		next;
		mes "[Eryus]";
		mes "人们都吓坏了。慌乱逃跑时，我松开了妻子的手。";
		next;
		emotion ET_CRY;
		mes "[Eryus]";
		mes "哦，艾莉……我的妻子很脆弱。希望她平安无事。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "我去找她。你应该去大教堂躲起来。我送你过去。";
		next;
		erasequest 5451;// Request from Chief Guard
		setquest 5463;// Mad Love for Wife(1)
		emotion ET_CRY;
		viewpoint 2,38,261,1,0xFF0000;
		mes "[Eryus]";
		mes "呜……请帮帮我。请找到我的妻子。";
		close2;
		cloakonnpcself( "Eryus#EP161BU01" );
		end;
	}
	mes "[Eryus]";
	mes "呜……我得找到妻子……而且我本来不该被看见。";
	close2;
	cloakonnpcself( "Eryus#EP161BU01" );
	end;

OnInit:
	cloakonnpc();
	end;
}

prt_q,231,310,4	script	Eryus#EP161BU02	4_F_03,{
	if (checkweight(1301,1) == 0) {
		mes "- 你持有的物品太多，无法继续任务。-";
		close;
	}
	if (isbegin_quest(5463) == 1) {
		emotion ET_CRY;
		mes "[Eryus]";
		mes "呜……请帮帮我。请找到我的妻子……我真的很担心她。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "在大教堂等着。我去找你的妻子。你在哪里和她走散的？";
		next;
		mes "[Eryus]";
		mes "啊……我一定忘了告诉你。";
		next;
		mes "[Eryus]";
		mes "我在普隆德拉就业介绍所附近松开了她的手。";
		next;
		emotion ET_THINK;
		mes "[Eryus]";
		mes "我不确定她是否还在那里……";
		next;
		erasequest 5463;// Mad Love for Wife(1)
		setquest 5464;// Mad Love for Wife(2)
		mes "[Eryus]";
		mes "啊……请帮帮我，亲爱的冒险者。";
		close;
	}
	if (isbegin_quest(5464) == 1) {
		mes "[Eryus]";
		mes "我在普隆德拉就业介绍所附近松开了她的手。";
		next;
		mes "[Eryus]";
		mes "啊……请帮帮我，亲爱的冒险者。";
		close;
	}
	if (isbegin_quest(5465) == 1) {
		emotion ET_THANKS;
		mes "[Eryus]";
		mes "哦！感谢神明！亲爱的冒险者……";
		next;
		emotion ET_PROFUSELY_SWEAT, getnpcid(0, "Female#EP161BU04");
		mes "[Ellie]";
		mes "哦，埃尤斯……咳……咳……";
		next;
		emotion ET_HUK;
		mes "[Eryus]";
		mes "艾莉，这是怎么回事？你又生病了吗？你的药在哪里？";
		next;
		emotion ET_PROFUSELY_SWEAT, getnpcid(0, "Female#EP161BU04");
		mes "[Ellie]";
		mes "咳……咳……我一定是在逃跑时把它弄掉了……";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "你把药掉在哪里了？";
		next;
		emotion ET_PROFUSELY_SWEAT, getnpcid(0, "Female#EP161BU04");
		mes "[Ellie]";
		mes "咳……咳……我不知道。咳，可能在那里……咳……咳……";
		next;
		mes "[Eryus]";
		mes "就是你之前所在的地方？等一下，我去帮你拿。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "外面很危险。我去吧。你留在这里照顾妻子。";
		next;
		erasequest 5465;// Mad Love for Wife(3)
		setquest 5466;// Mad Love for WifeQuest(4)
		mes "[Eryus]";
		mes "你愿意帮我们吗？拜托了。时间不多了。艾莉，坚持住……";
		close2;
		cloakonnpcself( "Female#EP161BU04" );
		end;
	}
	if (isbegin_quest(5466) == 1) {
		mes "[Eryus]";
		mes "拜托了。时间不多了。";
		close;
	}
	if (isbegin_quest(5467) == 1) {
		mes "[Eryus]";
		mes "哦，你来了。";
		mes "大教堂的牧师正在里面照顾我的妻子。";
		next;
		mes "[Eryus]";
		mes "谢谢你帮助我们。我应该尽快把药送给她。";
		next;
		erasequest 5467;// Mad Love for WifeQuest(5)
		setquest 5468;// Mad Love for Wife(6)
		mes "[Eryus]";
		mes "非常感谢。愿神保佑你的旅程……";
		close2;
		cloakonnpcself( "Eryus#EP161BU02" );
		end;
	}
	mes "[Eryus]";
		mes "呜……我得找到妻子……而且我本来不该被看见。";
	close2;
	cloakonnpcself( "Eryus#EP161BU02" );
	end;

OnInit:
	cloakonnpc();
	end;
}




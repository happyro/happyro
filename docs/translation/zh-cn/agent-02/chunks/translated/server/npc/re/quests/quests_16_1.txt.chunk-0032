		mes "哦！亲爱的冒险者，谢谢你。你知道，她实在让人操心。";
		next;
		mes "[Rosa Erinin]";
		mes "她很脆弱，却又很鲁莽。我很担心她。";
		next;
		mes "[Rosa Erinin]";
		mes "好了，我们去那里躲起来，这样这里的骑士就不用再担心我们了。";
		next;
		erasequest 5458;// Find My Sister(2)
		setquest 5459;// Find My Sister(3)
		emotion ET_WRAP, getnpcid(0, "Girl#EP161GU06");
		mes "[Lowen]";
		mes "谢谢你。再见！";
		close2;
		cloakonnpcself( "Rosa Erinin#EP161GU07" );
		cloakonnpcself( "Girl#EP161GU06" );
		end;
	}
	if (strnpcinfo(1) == "Girl") {
		mes "[Lowen]";
		mes "哦？你看得见我吗？真奇怪。我本来不该被看见。";
		close2;
		cloakonnpcself( "Girl#EP161GU06" );
		end;
	}
	mes "[Rosa Erinin]";
	mes "亲爱的冒险者，你看得见我吗？真奇怪。我本来不该被看见。";
	close2;
	cloakonnpcself( "Rosa Erinin#EP161GU07" );
	end;

OnInit:
	cloakonnpc();
	end;
}

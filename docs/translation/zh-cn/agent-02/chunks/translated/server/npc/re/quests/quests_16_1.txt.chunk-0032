		next;
		mes "[Soldier]";
		mes "我听说许多居民逃到了骑士楼，本来想去帮助守卫那里的骑士。不过这里的兵力似乎已经足够。";
		next;
		emotion ET_OK;
		mes "[Soldier]";
		mes "如果我露面，反而可能影响他们的注意力。我还是不见他们为好。";
		next;
		mes "[Soldier]";
		mes "我去其他地方参加防守。我想可以加入下面村公所的部队。";
		next;
		erasequest 5460;// Blatant Bluff(1)
		setquest 5461;// Blatant Bluff(2)
		emotion ET_PROFUSELY_SWEAT;
		mes "[Soldier]";
		mes "我想把体力留给战斗，请护送我去村公所。";
		close2;
		cloakonnpcself( "Soldier#EP161HU02" );
		end;
	}
	mes "[Soldier]";
	mes "哈哈，你看得见我吗？真奇怪。我本来不该被看见。";
	close2;
	cloakonnpcself( "Soldier#EP161HU02" );
	end;

OnInit:
	cloakonnpc();
	end;
}

prt_q,79,102,8	script	Soldier#EP161HU03	4_M_GEF_SOLDIER,{

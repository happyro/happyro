gef_fild04,191,54,3	script	Halgus#Pupa_Hunt	123,{
	if (checkquest(60110) != -1) {
		if (checkquest(60110,HUNTING) != 2 ) {
			mes "[Halgus]";
			mes "你已经清除蛹虫了吗？";
			next;
			switch(select("是:否:我想退出")) {
			case 1:
				mes "[Halgus]";
				mes "嗯，我觉得你还没清除 50 只蛹虫……";
				close;
			case 2:
				mes "[Halgus]";
				mes "记住，把田野里的 50 只蛹虫清除掉。";
				close;
			case 3:
				mes "[Halgus]";
				mes "你确定要停止猎杀吗？";
				mes "你取得的进度都会被清除。";
				next;
				switch(select("是:否")) {
				case 1:
					mes "[Halgus]";
					mes "好吧，改变主意后再回来。";
					erasequest 60110;
					close;
				case 2:
					mes "[Halgus]";
					mes "记住，把田野里的 50 只蛹虫清除掉。";
					close;
				}
			}
		}
		else {
			mes "[Halgus]";
			mes "哦，太感谢你了。";
			mes "我本来或许能自己完成，但一直站在这里可不容易。";
			getexp 385,30;
			erasequest 60110;
			close;
		}
	}
	if (checkquest(60111) != -1) {
		if (checkquest(60111,HUNTING) != 2 ) {
			mes "[Halgus]";
			mes "你已经清除蛹虫了吗？";
			next;
			switch(select("是:否:我想退出")) {
			case 1:
				mes "[Halgus]";
			mes "嗯，我觉得你还没清除 100 只蛹虫……";
				close;
			case 2:
				mes "[Halgus]";
			mes "记住，把田野里的 100 只蛹虫清除掉。";
				close;
			case 3:
				mes "[Halgus]";
				mes "你确定要停止猎杀吗？";
				mes "你取得的进度都会被清除。";
				next;
				switch(select("是:否")) {
				case 1:
					mes "[Halgus]";
					mes "好吧，改变主意后再回来。";
					erasequest 60111;
					close;
				case 2:
					mes "[Halgus]";
					mes "记住，把田野里的 100 只蛹虫清除掉。";
					close;
				}
			}
		}
		else {
			mes "[Halgus]";
			mes "哦，太感谢你了。";
			mes "我本来或许能自己完成，但一直站在这里可不容易。";
			getexp 385,30;
			getexp 385,30;
			erasequest 60111;
			close;
		}
	}
	if (checkquest(60112) != -1) {
		if (checkquest(60112,HUNTING) != 2 ) {
			mes "[Halgus]";
			mes "你已经清除蛹虫了吗？";
			next;
			switch(select("是:否:我想退出")) {
			case 1:
				mes "[Halgus]";
			mes "嗯，我觉得你还没清除 150 只蛹虫……";
				close;
			case 2:
				mes "[Halgus]";
			mes "记住，把田野里的 150 只蛹虫清除掉。";
				close;
			case 3:
				mes "[Halgus]";
				mes "你确定要停止猎杀吗？";
				mes "你取得的进度都会被清除。";
				next;
				switch(select("是:否")) {
				case 1:
					mes "[Halgus]";
					mes "好吧，改变主意后再回来。";
					erasequest 60112;
					close;
				case 2:
					mes "[Halgus]";
					mes "记住，把田野里的 150 只蛹虫清除掉。";
					close;
				}
			}
		}
		else {
			mes "[Halgus]";
			mes "哦，太感谢你了。";
			mes "我本来或许能自己完成，但一直站在这里可不容易。";
			getexp 385,30;
			getexp 385,30;
			getexp 385,30;
			erasequest 60112;
			close;
		}
	}
	//for minimum level
	if (BaseLevel > 1) {
		//for maximum level
		if (BaseLevel < 21) {
			mes "[Halgus]";
			mes "你是新来的吗？";
			mes "我喜欢帮助这里的新面孔。";
			mes "不过说实话，你不是我见过最好看的脸。";
			next;
			mes "[Halgus]";
			mes "尽管如此，我女儿觉得在这片田野收集蛹虫很有趣，现在这里变得很难看。";
			mes "你愿意帮我清除一些蛹虫，让田野恢复整洁吗？";
			next;
			switch(select("当然，我不介意:不")) {
			case 1:
				mes "[Halgus]";
				mes "真的吗？你想怎样帮忙？";
				next;
				switch(select("收集物品:清除蛹虫:取消")) {
				case 1:
					// Item turn in
					mes "[Halgus]";
					mes "你能收集 ^00CE0025 蛹壳^000000 带回来吗？我保证会好好奖励你。";
					next;
					switch(select("我有蛹壳:你需要什么？")) {
					case 1:
						if (countitem(915) > 24) {
							mes "[Halgus]";
							mes "真厉害，你这么快就找到了这么多。";
							mes "正如我承诺的，把蛹壳给我，我会用我的智慧奖励你。";
							delitem 915,25; //Chrysalis
							getexp 385,30;
							close;
						}
						else {
							mes "[Halgus]";
							mes "我需要 ^00CE0025 蛹壳^000000，不能少。";
							close;
						}
					case 2:
						mes "[Halgus]";
						mes "我需要 ^00CE0025 蛹壳^000000。";
						close;
					}
				case 2:
					// Kill Count Quest
					mes "[Halgus]";
				mes "太感谢你了！";
				mes "你想清除多少只？";
					next;
					switch(select("50 只蛹虫:100 只蛹虫:150 只蛹虫")) {
					case 1:
						mes "[Halgus]";
						mes "如果你能清除田野里的 50 只蛹虫，我会非常感激。";
						setquest 60110;
						close;
					case 2:
						mes "[Halgus]";
						mes "如果你能清除田野里的 100 只蛹虫，我会非常感激。";
						setquest 60111;
						close;
					case 3:
						mes "[Halgus]";
						mes "如果你能清除田野里的 150 只蛹虫，我会非常感激。";
						setquest 60112;
						close;
					}
				case 3:
					mes "[Halgus]";
					mes "改变主意后，请再回来。";
					close;
				}
			case 2:
				mes "[Halgus]";
			mes "改变主意后，请再回来。";
				close;
			}
		}
		else {
			mes "[Halgus]";
			mes "你或许能轻松帮我，但我想把机会留给不如你强壮的人。";
			close;
		}
	}
	else {
		mes "[Halgus]";
		mes "等你再强壮一些后，请回来找我。";
		close;
	}
}

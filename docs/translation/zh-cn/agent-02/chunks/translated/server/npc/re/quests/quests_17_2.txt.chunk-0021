			mes "进入那里可能很危险，但这是冒险者自己的选择，请多加小心。";
			close3;
		case 2:
			cloakoffnpcself( "Elyumina#jh_ba3" );
			cloakoffnpcself( "Rookie#jh_ba3" );
			cloakoffnpcself( "Lazy#jh_ba3" );
			cutin "16loo_02",2;
			mes "[菜鸟]";
			mes "你平安回来了。";
			mes "干得好，冒险者！";
			next;
			cutin "16lei_01",2;
			mes "[懒鬼]";
			mes "我们拿到了银色乳突叶，所以我会找人制作解毒剂。";
			next;
			cutin "ep172_beta",2;
			mes "[西休]";
			mes "我可以制作解毒剂。";
			mes "首先，银色乳突叶本身就能解多种症状，所以只要改变配方，让客人更容易服用即可。";
			next;
			cutin "16loo_02",2;
			mes "[菜鸟]";
			mes "那么……你能做出来吗？";
			next;
			cutin "ep172_beta",2;
			mes "[西休]";
			mes "好。把银色乳突叶给我。";
			next;
			cutin "",255;
			select( "交出银色乳突叶" );

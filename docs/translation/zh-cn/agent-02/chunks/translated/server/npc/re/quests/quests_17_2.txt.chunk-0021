			mes "[哈拉德]";
			mes "谢谢你帮助园丁们。";
			mes "下次如果你有时间，我还会再请你帮忙。";
			next;
			mes "[哈拉德]";
			mes "我会给你一些巴迈尔餐券作为谢礼。你可以在宅邸餐厅自由使用。";
			close2;
			cutin "",255;
			setquest 16432;
			erasequest 16431;
			getitem 1000103,4;
			getexp 800000,500000;

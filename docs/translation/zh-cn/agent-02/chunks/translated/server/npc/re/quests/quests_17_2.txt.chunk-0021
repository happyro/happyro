		mes "虽然不多，但我会给你一些餐券。你收下吧？";
		next;
		cutin "16loo_02",2;
		mes "[菜鸟]";
		mes "期待帮助西休工作。等我想来的时候，我会来帮忙的！";
		close2;
		cutin "",255;
		cloakonnpcself( "Elyumina#jh_ba3" );
		cloakonnpcself( "Rookie#jh_ba3" );
		cloakonnpcself( "Lazy#jh_ba3" );
		ep172_watergarden = 5;
		completequest 16430;
		getitem 1000103,20;
		getexp2 3094009,0;	// note: no jexp and ignores the adjustment factors
		end;
	}
	cutin "ep171_elyumina03",2;
	mes "[艾露米娜]";
	mes "冒险者，安静！我不能被发现独自在这里！";
	next;
	cutin "ep171_elyumina02",2;
	mes "[艾露米娜]";
	mes "你要是夺走我和瓦尔蒙特自动人偶交谈的宝贵机会，我就杀了你！";
	close2;
	cutin "",255;
	cloakonnpcself();
	end;

OnInit:
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "isbegin_quest(16430) == 1" );
	end;
}

ba_maison,235,45,3	script(CLOAKED)	Rookie#jh_ba3	4_M_ROOKIE,{
	npctalk "菜鸟：让你独自受苦是我的罪过。我们也该一起去的。", "", bc_self;
	cloakonnpcself();
	end;
}

ba_maison,233,48,5	script(CLOAKED)	Lazy#jh_ba3	4_M_LAZY,{
	npctalk "懒鬼：我不负责战斗。所以，冒险者，你有什么忙要我帮吗？", "", bc_self;
	cloakonnpcself();
	end;
}

// Daily quests
ba_maison,239,47,3	script	Seihyu#jh_ba	4_EP17_SCISSORE,{
	if (checkweight(1000103,4) == 0) {	// (custom)
		mes "^008800等一下！";
		mes "你携带的物品太多，无法再接收物品。请清理一些物品后再试。^000000";
		close;
	}
	if (ep172_watergarden < 2) {
		cutin "ep172_beta",2;
		mes "[西休]";
		mes "你好，客人。";
		mes "这里是码头，但目前没有船只运行。";
		close3;
	}
	if (ep172_watergarden == 2) {
		cloakoffnpcself( "Elyumina#jh_ba3" );
		cloakoffnpcself( "Rookie#jh_ba3" );
		cloakoffnpcself( "Lazy#jh_ba3" );
		cutin "ep172_beta",2;
		mes "[西休]";
		mes "......................";
		next;
		cutin "16lei_02",2;
		mes "[懒鬼]";
		mes "你的目光让人感觉很冷。";
		next;
		cutin "ep172_beta",2;
		mes "[西休]";
		mes "欢迎，客……";
		mes "有什么我能为你做的吗？";
		next;
		cutin "16loo_02",2;
		mes "[菜鸟]";
		mes "我想取得许可。";
		mes "我们可以进入水之庭院吗？我必须在里面取得一片^0000CD银色乳突叶^000000。";
		next;
		cutin "ep172_beta",2;
		mes "[西休]";
		mes "啊～她来了！你就是提出请求的人！";
		mes "我不想帮助入侵者！";
		next;
		cutin "16lei_03",2;
		mes "[懒鬼]";
		mes "我从刚才就一直想问，我们明明属于同一群体，你是怎么区分入侵者和客人的？";
		next;
		mes "[懒鬼]";
		mes "这位犯罪科学家的脸上可没有写着‘入侵者’。";
		next;
		cutin "ep172_beta",2;
		mes "[西休]";
		mes "我们无法直接区分。这只是数据收集。你说的每句话和做出的每个行动，都是我们收集的数据。";
		next;
		mes "[西休]";
		mes "我们会比较这些数据，得出最佳结果。然后排除入侵者，这是阿尔法的行动方针。";
		next;
		mes "[西休]";
		mes "我想问你。你为什么要救那个人？";
		mes "她不是也伤害过你吗？";
		next;
		mes "[西休]";
		mes "是因为你仍然需要她吗？";
		mes "人类都会这样做吗？";
		next;
		cutin "16loo_03",2;
		mes "[菜鸟]";
		mes "这个嘛……";
		next;
		cutin "",255;
		switch( select( "艾露米娜是我们的同伴。", "她已经帮了我们足够多，足以抵偿她做过的事。", "我不想杀死敌人，也不想杀死同伴。") ) {
		case 1:
			cutin "ep172_beta",2;
			mes "[西休]";
			mes "为什么？我正在学习什么是同伴。";
			mes "按照定义，她绝对不是同伴。";
			next;
			cutin "ep171_elyumina03",2;
			mes "[艾露米娜]";
			mes "人类很愚蠢。所以我才会做出不同于机器美好思考的事情……虽然有点悲惨，但这就是我的故事。";
			next;
			cutin "ep171_elyumina04",2;
			mes "[艾露米娜]";
			mes "不管怎样，这样好奇的机器真有魅力。我想更多了解你的思考方式。";
			next;
			cutin "ep172_beta",2;
			mes "[西休]";
			mes "我排除了你。";
			mes "人类的判断对我来说也太难了。但谢谢你的意见。";
			break;
		case 2:
			cutin "ep172_beta",2;
			mes "[西休]";
			mes "是吗？你是因为她将来可能派得上用场才救她的吗？";
			next;
			cutin "ep171_elyumina04",2;
			mes "[艾露米娜]";
			mes "哈，哈哈……这不是和自动人偶很像吗？";
			mes "你也是为了派上用场、帮助人们，才这样工作的。";
			next;
			cutin "ep172_beta",2;
			mes "[西休]";
			mes "别把我们和你相提并论。";
			mes "……不过，我觉得人类的判断标准稍微可以理解一些了。";
			break;
		case 3:
			cutin "ep172_beta",2;
			mes "[西休]";
			mes "我没想到你会这么说。";
			mes "根据长期收集的数据，人类是一个在必要时会互相伤害的种族。";
			next;
			cutin "ep171_elyumina03",2;
			mes "[艾露米娜]";
			mes "我不想杀任何人。";
			mes "但他们太弱、太愚蠢，不断自己送命。";
			next;
			cutin "ep172_beta",2;
			mes "[西休]";
			mes "被排除者的意见毫无价值。";
			next;
			mes "[西休]";
			mes "……人类真是棘手。";
			mes "我不理解你们的标准，但我姑且明白了。";
			break;
		}
		next;
		cutin "ep172_beta",2;
		mes "[西休]";
		mes "……好吧。既然如此，帮我一个忙。";
		mes "我们会允许你进入水之庭院，但请帮我们完成工作。";
		next;
		mes "[西休]";
		mes "由于入侵者的干扰，水之庭院的多项工作都陷入停滞。";
		mes "如果你答应帮忙，我就为你开放水之庭院。";
		next;
		cutin "",255;
		if (select( "帮忙。", "不帮忙。" ) == 2) {
			mes "[西休]";
			mes "那就没什么好谈的了。";
			mes "正如我之前所说，我有排除入侵者的职责。";
			close3;
		}
		cutin "ep172_beta",2;
		mes "[西休]";
		mes "成交。";
		mes "这只是交易。我仍然清楚自己有排除入侵者的职责。";
		next;
		cutin "ep171_elyumina04",2;
		mes "[艾露米娜]";
		mes "到这个地步，我开始觉得恶心了。我一定会让你爱上我。";
		next;
		cutin "16lei_02",2;
		mes "[懒鬼]";
		mes "你听起来像恋爱小说的女主角，不过对方的身份很模糊。";
		next;
		cutin "16loo_03",2;
		mes "[菜鸟]";
		mes "好了好了。不管是复仇剧还是恋爱小说，我们都该先做解毒剂，等你好些后再聊。";
		mes "米娜，你能动吗？听说里面很危险……";
		next;
		cutin "ep171_elyumina03",2;
		mes "[艾露米娜]";
		mes "……抱歉，我不能勉强。";
		mes "现在连走路都很困难。";
		next;
		cutin "16loo_01",2;
		mes "[菜鸟]";
		mes "那我只能留下来照看米娜了。";
		mes "冒险者，你能进去取些银色乳突叶吗？";
		next;
		cutin "16lei_01",2;
		mes "[懒鬼]";
		mes "我不参加战斗，所以会留在外面。我的力量只能保护自己。这是为了尽量减少痛苦而采取的预防措施。";
		next;
		cutin "",255;
		if (select( "我马上回来。", "我也是非战斗人员。" ) == 2) {
			cutin "16lei_01",2;
			mes "[懒鬼]";
			mes "嗯？冒险者……回想一下你一路经历的战斗。";
			mes "把手放在胸口，再好好想想。";
		}
		else {
			cutin "16loo_03",2;
			mes "[菜鸟]";
			mes "我相信冒险者。";
			mes "请小心。";
		}
		next;
		cutin "16loo_01",2;
		mes "[菜鸟]";
		mes "那么，我们会在这里等着。";
		mes "请再去和西休谈谈。";
		next;
		cutin "ep172_beta",2;
		mes "[西休]";
		mes "你可以和我旁边的<NAVI>[哈拉德]<INFO>ba_maison,238,44,0,101,0</INFO></NAVI>交谈，然后进入水之庭院。";
		mes "进入那里可能很危险，但这是冒险者自己的选择，请多加小心。";
		next;
		cutin "16lei_02",2;
		mes "[懒鬼]";
		mes "我觉得那个自动人偶的精神状态不太稳定……";
		next;
		cutin "ep171_elyumina01",2;
		mes "[艾露米娜]";
		mes "不过，那个自动人偶没问题。";
		close2;
		cutin "",255;
		ep172_watergarden = 3;
		erasequest 16428;
		setquest 16429;
		end;
	}
	if (ep172_watergarden == 3) {
		switch( checkquest(16429,HUNTING) ) {
		case -1:
			end;
		case 0:
		case 1:

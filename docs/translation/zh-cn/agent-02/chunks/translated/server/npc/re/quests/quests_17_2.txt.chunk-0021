	}
	cutin "ep172_beta",2;
	mes "[西休]";
	mes "欢迎回来，亲爱的客人。";
	mes "你是来遵守诺言的吗？今天我有几件事想请你帮忙。";
	next;
	cutin "",255;
	switch( select( "狩猎银色乳突", "狩猎巨型乳突", "失踪的园丁", "不帮忙。" ) ) {
	case 1:
		switch( checkquest(16432,PLAYTIME) ) {
		case -1:
			break;
		case 0:
		case 1:
			cutin "ep172_beta",2;
			mes "[西休]";
			mes "你需要休息一下。哦，不只是你，水之庭院也需要休息。";

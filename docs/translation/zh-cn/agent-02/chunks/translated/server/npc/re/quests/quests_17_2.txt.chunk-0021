			mes "你可以和我旁边的<NAVI>[哈拉德]<INFO>ba_maison,238,44,0,101,0</INFO></NAVI>交谈，然后进入水之庭院。";
			close2;
			setquest 16431;
			end;
		case 0:
		case 1:
			cutin "ep172_beta",2;
			mes "[西休]";
			mes "由于最近发生了入侵事件，人偶数量大幅减少，我们的园丁现在无法应付这种棘手的植物。";

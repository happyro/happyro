			mes ".....................";
			mes ".....................";
			next;
			mes "[西休]";
			mes ".....................";
			mes ".....................";
			mes ".....................";
			next;
			cutin "ep171_elyumina01",2;
			mes "[艾露米娜]";
			mes "看到别人制造的聪明自动人偶真是太好了。";
			mes "我想研究分析……要是头晕能消失就好了……";
			next;
			cutin "ep172_beta",2;
			mes "[西休]";
			mes "你的夸奖并不能让我高兴。";
			mes "……给，解毒剂。";
			next;
			cutin "",255;
			select( "领取解毒剂。" );
			cutin "ep172_beta",2;
			mes "[西休]";
			mes "那么，完成这件事后，我还想请你继续帮忙。";
			mes "我相信你会遵守诺言。";
			next;
			cutin "16loo_01",2;

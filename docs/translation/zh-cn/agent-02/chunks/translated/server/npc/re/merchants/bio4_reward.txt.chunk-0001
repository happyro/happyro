//===== rAthena Script =======================================
//= Lighthalzen rewards NPCs
//===== Description: =========================================
//= Enchant and reward NPCs from Bio instance/dungeon item drop.
//===== Changelogs: ==========================================
//= 1.0 Moved the NPCs from WolfchevLaboratory.txt. [Capuche]
//============================================================

// Weird Old Man (Rewards)
//============================================================
lighthalzen,342,291,4	script	Weird old man#Bio4Reward	4_M_EINOLD,{
	if ((MaxWeight - Weight) < 2800 || !checkweight(1201, 1)) {
		mes "^FF0000请检查你的物品栏。你携带的物品太多，无法继续任务。^000000";
		close;
	}
	mes "[怪老头]";
	mes "呼，如今的年轻人真粗鲁，一点礼貌都没有。";
	next;
	if (select("无视他", "和他交谈") == 1) {
		mes "[怪老头]";
		mes "你这个坏年轻人！";
		close;
	}
	mes "["+ strcharinfo(0) +"]";
	mes "老先生，你还好吗？？";
	next;
	mes "[怪老头]";
	mes "……？？你和其他年轻人不一样，很有礼貌！想知道我遇到了什么吗？";
	next;
	switch(rand(1,2)) {
	case 1:
		mes "[怪老头]";
		mes "我正要去探望住在卢恩·米德加尔特的儿子。那里很远，所以我乘坐了飞机，然后……";
		next;
		mes "[怪老头]";
		mes "那些年轻人……太吵了……我站着，却没有一个人给我让座……他们还大声喧哗，打扰了所有人。";
		next;
		mes "[怪老头]";
		mes "要是我年轻10岁，肯定会好好教训他们……";
		next;
		mes "[怪老头]";
		mes "唉……我从来不喜欢时间流逝……";
		next;
		mes "[怪老头]";
		mes "那么，你……你会怎么做？？";
		next;
		mes "[怪老头]";
		mes "在开放的公共场所，应该安静地待到目的地，并给老人和病弱者让座。";
		next;
		break;
	case 2:
		mes "[怪老头]";
		mes "我正要去探望住在卢恩·米德加尔特的儿子。那里很远，所以我乘坐了飞机，然后……";
		next;
		mes "[怪老头]";
		mes "那些年轻人……太吵了……我站着，却没有一个人给我让座……他们还大声喧哗，打扰了所有人。";
		next;
		mes "[怪老头]";
		mes "要是我年轻10岁，肯定会好好教训他们……";
		next;
		mes "[怪老头]";
		mes "唉……我从来不喜欢时间流逝……";
		next;
		mes "[怪老头]";
		mes "那么，你……你会怎么做？？";
		next;
		mes "[怪老头]";
		mes "在开放的公共场所，应该安静地待到目的地，并给老人和病弱者让座。 对吧？";
		next;
		mes "[怪老头]";
		mes "难道不是吗？！";
		next;
		switch(rand(1,2)) {
		case 1:
			mes "[怪老头]";
			mes "哦，对了，你知道吗……？";
			next;
			mes "[怪老头]";
			mes "有一次我在城里散步，一些男孩在街上吐痰，还骚扰路过的女孩……啧啧！";
			next;
			mes "[怪老头]";
			mes "这个世界真是越来越糟……以后会变成什么样？？他们甚至还是在白天做的……啧啧。";
			next;
			switch(rand(1,2)) {
			case 1:
				mes "[怪老头]";
				mes "哦，对了，你知道吗……？";
				next;
				break;
			case 2:
				mes "[怪老头]";
				mes "哦，对了，你知道吗……？";
				next;
				mes "[怪老头]";
				mes "最近的年轻人真没耐心！！！！";
				next;
				mes "[怪老头]";
				mes "他们总说要辞职……说自己做不下去了。抱着那种心态要怎么生活……啧啧。";
				next;
				mes "[怪老头]";
				mes "找工作并不容易。被录用很难，可他们甚至坚持不了一周就离开工作岗位。";
				next;
				mes "[怪老头]";
				mes "真是既没耐心又不负责任！！";
				next;
				mes "[怪老头]";
				mes "哦，对了，你知道吗……？";
				next;
				break;
			}
		case 2:
			mes "[怪老头]";
			mes "哦，对了，你知道吗……？";
			next;
			break;
		}
	}
	mes "^E7A43D老头不停地说个没完。^000000";
	next;
	mes "[怪老头]";
	mes "嗯……你不像普通的年轻人，似乎也很有耐心。我喜欢这样！！！";
	next;
	mes "[怪老头]";
	mes "现在我只是个虚弱的老头，但年轻时曾是城里有名的商人。";
	next;
	mes "[怪老头]";
	mes "我停止经商已经有一段时间了，";
	mes "但以前的一位客户联系了我，问我能否";
	next;
	mes "[怪老头]";
	mes "帮他弄到一些名为“战士意志”、“嗜血”和“死者寒气”的未知物品。";
	next;
	mes "[怪老头]";
	mes "我喜欢你的礼貌，大多数年轻人都没有这种品质。如果你能找到那些东西，我会把一些视为宝物的物品送给你。";
	next;
	while(1) {
		switch(select("收集齐后我会回来", "让我看看防具", "让我看看武器")) {
		case 1:
			mes "[怪老头]";
			mes "好的，年轻人。回头见。";
			close;
		case 2:
			mes "[Weird old man]";
		mes "看来你对防具感兴趣。";
			next;
			mes "[Weird old man]";
		mes "这些是我拥有的防具。";
			next;
			for(.@i = 1; .@i < 8; .@i++) {
				if (((.@i == 1 || .@i == 5) && (countitem(6469) >= 100) && (countitem(6470) >= 50) && (countitem(6471) >= 35)) || 
				    ((.@i == 2 || .@i == 3) && (countitem(6469) >= 100) && (countitem(6470) >= 50) && (countitem(6471) >= 22)) ||
				    ((.@i == 4 || .@i == 7) && (countitem(6469) >= 300) && (countitem(6470) >= 300) && (countitem(6471) >= 400)) ||
				    ((.@i == 6) && (countitem(6469) >= 100) && (countitem(6470) >= 50) && (countitem(6471) >= 30))) {
					.@armor$[.@i] = "^0000FF";
				} else {
					.@armor$[.@i] = "^FF0000";
				}
			}
			while(1) {
				switch(select(
					"让我看看其他物品。",
					""+.@armor$[1]+"巨人盾牌^000000",
					""+.@armor$[2]+"吉芬尼亚古书-水^000000",
					""+.@armor$[3]+"约定圣书（第2卷）^000000",
					""+.@armor$[4]+"打捞斗篷^000000",
					""+.@armor$[5]+"刺客手铐^000000",
					""+.@armor$[6]+"绿色手术服^000000",
					""+.@armor$[7]+"远古黄金装饰^000000"
				)) {
				case 1:
					mes "[Weird old man]";
					mes "请看。";
					next;
					.@break = 1;
					break;
				case 2:
					mes "<<巨人盾牌[1]>>";
					mes "受到大型魔物的伤害减少5%；精炼等级达到9时，伤害额外减少5%。";
					mes "盾牌 / 防御 130 / 重量 280 / 要求等级 100 / 插槽 1 / 适用三转剑士系职业";
					callsub L_Reward, 2160, 100, 50, 35; //Giant_Shield
					break;
				case 3:
					mes "<<吉芬尼亚古书-水[1]>>";
					mes "INT + 1，MDEF + 2。基础INT达到120时，MATK + 10，MHP + 800。";
					mes "与拉克利玛魔杖一起装备时，暴风雪、霜冻迷雾和冰冻术的吟唱时间减少，数值相当于精炼等级的4倍。";
					mes "盾牌 / 防御 30 / 重量 100 / 要求等级 100 / 插槽 1 / 适用术士";
					callsub L_Reward, 2161, 100, 50, 22; //Geffenia_Book_Water
					break;
				case 4:
					mes "<<约定圣书（第2卷）[1]>>";
					mes "MDEF + 5，可使用“奥丁之力”（Lv 2）。治疗术效果额外增加5%。";
					mes "盾牌 / 防御 20 / 重量 50 / 要求等级 140 / 插槽 1 / 适用大主教";
					callsub L_Reward, 2162, 100, 50, 22; //Bible_Of_Promise2
					break;
				case 5:
					mes "<<打捞斗篷[0]>>";
					mes "可使用“蝉蜕”（Lv 1）。该技能冷却时间为30秒。装备时使用任何技能的SP消耗加倍，卸下时SP - 1200。";
					mes "披风 / 防御 1 / 重量 40 / 要求等级 130 / 插槽 0 / 适用大主教";
					callsub L_Reward, 2582, 300, 300, 400; //Salvage_Cape
					break;
				case 6:
					mes "<<刺客手铐[1]>>";
					mes "MSP + 20，CRI + 3。与克里希纳一起装备时，ATK + 50，音速投掷攻击力增加50%，FLEE - 30。与查克拉姆一起装备时，CRI + 4，暴击攻击力增加40%，MHP - 10%。";
					mes "饰品 / 防御 3 / 重量 40 / 要求等级 100 / 插槽 1 / 适用十字斩首者";
					callsub L_Reward, 2892, 100, 50, 35; //Assassin_Handcuffs
					break;
				case 7:
					mes "<<绿色手术服[1]>>";
					mes "DEX + 1，MSP + 30。与手术刀一起装备时，猎杀人类、动物型魔物有一定概率掉落“不朽之心”和“酒精”。掉落率受精炼等级影响。";
					mes "防具 / 防御 66 / 重量 66 / 要求等级 100 / 插槽 1 / 通用";
					callsub L_Reward, 15044, 100, 50, 30; //Green_Operation_Coat
					break;
				case 8:
					mes "<<远古黄金装饰[1]>>";
					mes "基础等级达到150时，全属性 + 2。剑士、商人、盗贼系职业ATK + 8%；魔法师、服事系职业MATK + 8%，治疗效果 + 7%；弓箭手系职业DEX + 3，远程攻击力 + 10%。";
					mes "头饰 / 防御 7 / 位置-上 / 重量 40 / 要求等级 100 / 插槽 1 / 适用三转职业";
					callsub L_Reward, 18570, 300, 300, 400; //Ancient_Gold_Deco
					break;
				}
				if (.@break) {
					.@break = 0;
					break;
				}
			}
			break;
		case 3:
			mes "[Weird old man]";
			mes "看来你对武器感兴趣。";
			next;
			mes "[Weird old man]";
			mes "这些是我拥有的武器。";
			next;
			for(.@i = 1; .@i < 15; .@i++) {
				if (((.@i == 1) && (countitem(6469) >= 50) && (countitem(6470) >= 100) && (countitem(6471) >= 10)) ||
				((.@i == 2) && (countitem(6469) >= 50) && (countitem(6470) >= 100) && (countitem(6471) >= 85)) ||
				((.@i == 3 || .@i == 4 || (.@i >= 8 && .@i < 11) || .@i >= 12) && (countitem(6469) >= 50) && (countitem(6470) >= 100) && (countitem(6471) >= 35)) ||
				((.@i == 5 || .@i == 7 || .@i == 11) && (countitem(6469) >= 50) && (countitem(6470) >= 100) && (countitem(6471) >= 40)) ||
				((.@i == 6) && (countitem(6469) >= 300) && (countitem(6470) >= 300) && (countitem(6471) >= 400))) {
					.@weapon$[.@i] = "^0000FF";
				} else {
					.@weapon$[.@i] = "^FF0000";
				}
			}
			while(1) {
				switch(select(
					"让我看看其他物品。",
					""+.@weapon$[1]+"特工拳刃^000000",
					""+.@weapon$[2]+"断头台拳刃^000000",
					""+.@weapon$[3]+"伊格尼斯斧^000000",
					""+.@weapon$[4]+"终结斧^000000",
					""+.@weapon$[5]+"加农炮矛^000000",
					""+.@weapon$[6]+"巨人长枪^000000",
					""+.@weapon$[7]+"寒冷魔法书^000000",
					""+.@weapon$[8]+"恢复之光^000000",
					""+.@weapon$[9]+"阿佐托之钉^000000",
					""+.@weapon$[10]+"猩红之钉^000000",
					""+.@weapon$[11]+"血腥十字^000000",
					""+.@weapon$[12]+"弹射弓^000000",
					""+.@weapon$[13]+"大型十字弓^000000",
					""+.@weapon$[14]+"蔓藤弓^000000"
				)) {
				case 1:
					mes "[Weird old man]";
					mes "请看。";
					next;
					.@break = 1;
					break;
				case 2:
					mes "<<特工拳刃[1]>>";
					mes "每2点基础LUK额外获得1点HIT";
					mes "拳刃 / ATK 170 / 重量 120 / 武器等级 3 / 要求等级 100 / 插槽 1 / 适用十字斩首者";
					callsub L_Reward, 1290, 50, 100, 10; //Agent_Katar
					break;
				case 3:
					mes "<<断头台拳刃[1]>>";
					mes "DEX + 2，FLEE - 30。对人类型魔物伤害增加50%。十字冲击伤害额外增加30%。";
					mes "拳刃 / ATK 200 / 重量 150 / 武器等级 4 / 要求等级 140 / 插槽 1 / 适用十字斩首者";
					callsub L_Reward, 1291, 50, 100, 85; //Guillotine_Katar
					break;
				case 4:
					mes "<<伊格尼斯斧[1]>>";
					mes "进行近距离攻击时，有一定概率使自己和敌人陷入灼烧状态。";
					mes "双手斧 / ATK 250 / 重量 190 / 火属性 / 武器等级 4 / 要求等级 95 / 插槽 1 / 适用高阶剑士/商人系职业";
					callsub L_Reward, 1392, 50, 100, 35; //Ygnus_Stale
					break;
				case 5:
					mes "<<终结斧[1]>>";
					mes "进行近距离攻击时，有一定概率使自己和敌人陷入冻结状态。";
					mes "双手斧 / ATK 250 / 重量 190 / 水属性 / 武器等级 4 / 要求等级 95 / 插槽 1 / 适用高阶剑士/商人系职业";
					callsub L_Reward, 1393, 50, 100, 35; //End_Sektura
					break;
				case 6:
					mes "<<加农炮矛[1]>>";
					mes "MSP - 100，加农炮矛造成的伤害增加10%，加农炮矛的额外ATK相当于精炼等级的3倍。";
					mes "单手矛 / ATK 180 / 重量 160 / 武器等级 4 / 要求等级 100 / 插槽 1 / 适用皇家卫士";
					callsub L_Reward, 1435, 50, 100, 40; //Cannon_Spear
					break;
				case 7:
					mes "<<巨人长枪[0]>>";
					mes "ASPD - 10，卸下时角色SP - 600。再次使用螺旋击刺前额外增加20秒延迟。如果基础STR达到120，ATK + 300。";
					mes "双手长枪 / ATK 20 / 重量 2000 / 武器等级 4 / 要求等级 140 / 插槽 0 / 适用符文骑士";
					callsub L_Reward, 1490, 300, 300, 400; //Giant_Lance
					break;
				case 8:
					mes "<<寒冷魔法书[2]>>";
					mes "MATK + 160，DEX + 1。冰箭术、钻石星尘的ATK增加相当于精炼等级3倍的数值，这些技能的SP消耗也增加相当于精炼等级5倍的数值。不可破坏。";
					mes "书 / ATK 100 / 重量 100 / 水属性 / 武器等级 4 / 要求等级 100 / 插槽 2 / 适用元素使";
					callsub L_Reward, 1584, 50, 100, 40; //Chilly_Spell_Book
					break;
				case 9:
					mes "<<恢复之光[1]>>";
					mes "MATK + 160。治疗能力和技能SP消耗会根据精炼等级增加。不可破坏。";
					mes "单手杖 / ATK 30 / 重量 40 / 圣属性 / 武器等级 4 / 要求等级 110 / 插槽 1 / 适用大主教。";
					callsub L_Reward, 1659, 50, 100, 35; //Recovery_Light
					break;
				case 10:
					mes "<<阿佐托之钉[0]>>";
					mes "MATK + 80。物理近战攻击时，有一定概率对目标施加冻结。概率受精炼等级影响。";
					mes "短剑 / ATK 160 / 重量 50 / 风属性 / 武器等级 4 / 要求等级 110 / 插槽 0 / 适用高阶剑士/商人/盗贼系职业";
					callsub L_Reward, 13069, 50, 100, 35; //Aztoe_Nail
					break;
				case 11:
					mes "<<猩红之钉[0]>>";
					mes "MATK + 80。物理近战攻击时，有一定概率对目标施加石化诅咒。概率受精炼等级影响。";
					mes "短剑 / ATK 160 / 重量 50 / 火属性 / 武器等级 4 / 要求等级 110 / 插槽 0 / 适用高阶剑士/商人/盗贼系职业";
					callsub L_Reward, 13070, 50, 100, 35; //Scarletto_Nail
					break;
				case 12:
					mes "<<血腥十字[0]>>";
					mes "物理近战攻击时，有一定概率自动施放“地狱烈焰”（Lv 1）。概率受精炼等级影响。";
					mes "钝器 / ATK 170 / 重量 150 / 暗属性 / 武器等级 4 / 要求等级 100 / 插槽 0 / 适用高阶服事系职业";
					callsub L_Reward, 16017, 50, 100, 40; //Bloody_Cross
					break;
				case 13:
					mes "<<弹射弓[2]>>";
					mes "三角射击的ATK增加相当于精炼等级2倍的数值，技能SP消耗也会增加。";
					mes "弓 / ATK 150 / 重量 110 / 武器等级 4 / 要求等级 100 / 插槽 2 / 适用魅影追踪者";
					callsub L_Reward, 18109, 50, 100, 35; //弹射弓
					break;
				case 14:
					mes "<<大型十字弓[2]>>";
					mes "箭雨的ATK增加相当于精炼等级5倍的数值。技能SP消耗也会增加；基础AGI达到120时，ASPD + 1。";
					mes "弓 / ATK 160 / 重量 90 / 武器等级 4 / 要求等级 110 / 插槽 2 / 适用游侠";
					callsub L_Reward, 18110, 50, 100, 35; //Big_CrossBow
					break;
				case 15:
					mes "<<蔓藤弓[2]>>";
					mes "DEX + 1。物理攻击时，有一定概率自动施放“纤维锁链”（Lv 1）。";
					mes "弓 / ATK 150 / 重量 150 / 武器等级 3 / 要求等级 120 / 插槽 2 / 适用三转弓箭手系职业";
					callsub L_Reward, 18111, 50, 100, 35; //Creeper_Bow
					break;
				}
				if (.@break) {
					.@break = 0;
					break;
				}
			}
		}
	}
	close;

L_Reward:
	setarray .@amount[0], getarg(1), getarg(2), getarg(3);
	next;
	mes ""+ .@amount[0] +"个战士意志、"+ .@amount[1] +"个嗜血、"+ .@amount[2] +"个死者寒气是兑换所需的材料。";
	next;
	if (countitem(6469) >= .@amount[0] && countitem(6470) >= .@amount[1] && countitem(6471) >= .@amount[2]) {
		if (select("不兑换", "兑换") == 1) {
			mes "[怪老头]";
			mes "好的……";
			close;
		}
		emotion ET_PROFUSELY_SWEAT;
		progressbar "FF00FF", 2;
		delitem 6469, .@amount[0]; //Will_Of_Warrior
		delitem 6470, .@amount[1]; //Blood_Thirst
		delitem 6471, .@amount[2]; //Goast_Chill
		getitem getarg(0), 1;
		mes "[怪老头]";
		mes "给你。偶尔来找我，我们可以聊聊。";
		close;
	}
	return;
}

// Sorcerer (Rewards)
//============================================================
lhz_cube,233,24,4	script	Sorcerer#Bio4Reward	4_M_UMDANCEKID,{
	if ((MaxWeight - Weight) < 1200 || !checkweight(1201, 1)) {
		mes "^FF0000请检查你的物品栏。你携带的物品太多，无法继续任务。^000000";
		close;
	}
	disable_items;
	mes "[布丁]";
	mes "…… …… ……";
	next;
	switch(select("呜巴呜巴哼巴", "你在这里做什么？", "目前发现了哪些装备？", "给你，先生。")) {
	case 1:
		emotion ET_FRET;
		mes "[布丁]";
		mes "嘿，打扰一下，我不是来自乌巴拉的！你真没礼貌。";
		close;
	case 2:
		mes "[布丁]";
		mes "如你所见，我是正在训练中的元素使，我叫布丁。";
		next;
		select("……？");
		emotion ET_FRET;
		mes "[布丁]";
		mes "……你那是什么表情？我开始觉得不舒服了……";
		next;
		emotion ET_OK;
		mes "[布丁]";
		mes "几天前我接受训练时感到一种奇怪的异样感，于是循着感觉来到了这里。";
		next;
		select("我明白了。");
		mes "[布丁]";
		mes "好，让我继续说。说话时被打扰会让我很困扰。";
		next;
		mes "[布丁]";
		mes "我为了调查进入了这里的实验室，天啊！我发现了那些像“吉芬地下城”分身一样的魔物，里面到处都是。";
		next;
		mes "[布丁]";
		mes "从那些魔物身上，我找到了其他地方无法获得的稀有物品，例如“^F2766E战士意志^000000”、“^952420嗜血^000000”和“^88C6F7死者寒气^000000”。";
		next;
		emotion ET_QUESTION;
		mes "[布丁]";
		mes "经过数小时独自研究，我终于找到了使用这些物品的方法。想知道吗？";
		next;
		switch(select("哦……请再说一遍？！", "当然，我很想知道。")) {
		case 1:
			emotion ET_HUK, playerattached();
			emotion ET_FRET;
			mes "[布丁]";
			mes "天啊！你问完问题就睡着了吗？算了，我懒得再解释一遍，就继续说吧。";
			next;
			break;
		case 2:
			emotion ET_SMILE;
			mes "[布丁]";
			mes "很好，你认真听我的故事让我很满意。那我继续说明。";
			next;
			break;
		}
		mes "[布丁]";
		mes "“^F2766E战士意志^000000”与“^952420嗜血^000000”……是具有攻击性但温暖的材料。";
		next;
		mes "[布丁]";
		mes "所以“^F2766E战士意志^000000”可以将特殊力量赋予装备的第4槽位，";
		next;
		mes "[布丁]";
		mes "而“^952420嗜血^000000”可以将特殊力量赋予第3槽位。";
		next;
		mes "[布丁]";
		mes "然而！！！";
		mes "“^88C6F7死者寒气^000000”是寒冷类型的材料，";
		mes "它可以取回“^F2766E战士意志^000000”或“^952420嗜血^000000”赋予的力量，使装备恢复为未附魔状态。";
		next;
		mes "[布丁]";
		mes "怎么样？听起来很有趣吧？不过有个问题……";
		next;
		mes "[布丁]";
		mes "由于这些材料只能从实验室的魔物身上获得，特殊力量也只能赋予从实验室取得的特定装备。";
		next;
		select("所以结论是什么？");
		emotion ET_QUESTION, playerattached();
		emotion ET_FRET;
		mes "[布丁]";
		mes "唉……我不是说过我讲话时不要插嘴吗？好吧，我会回答，因为这很重要。";
		next;
		mes "[布丁]";
		mes "带来10个“^F2766E战士意志^000000”或10个“^952420嗜血^000000”，我就会把力量赋予你能在实验室找到的特定装备……";
		next;
		mes "[布丁]";
		mes "如果你对获得的力量不满意，带来10个“^88C6F7死者寒气^000000”，我就会移除那股力量。";
		next;
		mes "[布丁]";
		mes "怎么样？拥有两个选择……很不错吧？";
		next;
		mes "[布丁]";
		mes "如果你获得“^F2766E战士意志^000000”或“^952420嗜血^000000”，并拥有能够接受其力量的装备，就带来找我。我会等着你。";
		close;
	case 3:
		mes "[布丁]";
		mes "嗯……目前发现的装备有……";
		next;
		mes "- 检查中 -";
		mes "布丁从口袋里拿出一张纸。";
		next;
		mes "[布丁]";
		mes "让我看看……目前发现的装备有……";
		mes "7件防具，14件武器。";
		next;
		while(1) {
			switch(select("好，我不用知道更多了。", "7件防具", "14件武器")) {
			case 1:
				mes "[布丁]";
				mes "如果你获得“^F2766E战士意志^000000”或“^952420嗜血^000000”，并拥有能够接受其力量的装备，就带来找我。我会等着你。";
				close;

airplane,246,47,1	script	Eocatt#decoy01	878,{
	mes "[Eocatt]";
	mes "施瓦茨瓦尔德共和国边境有一座";
	mes "古老而朴素的村庄。";
	mes "在建成怪物赛跑竞技场之前，";
	mes "它在地图上只是一个小点！";
	mes "如今这里已经热闹非凡，";
	mes "因为他们开放了怪物赛跑竞技场！";
	next;
	mes "[Eocatt]";
	mes "如果你在怪物赛跑中下注获胜，";
	mes "就会得到这些奖牌。";
	mes "奖牌由非常稀有的金属制成，";
	mes "据说这种金属在艾音布罗克很受欢迎……";
	mes "你可以把它们带回去。";
	next;
	mes "[Eocatt]";
	mes "对，对……";
	mes "我想起来了，";
	mes "那座城镇叫做赫尔。";
	mes "那里一定还有其他有趣的事情，";
	mes "但赛跑竞技场绝对不能错过！";
	close;
}

hugel,85,93,5	script	Mudie#dummy01	866,{
	mes "[Mudie]";
	mes "怪物赛跑大概是";
	mes "赫尔这里最大的景点。";
	mes "除此之外我们没什么";
	mes "其他活动，真遗憾。";
	mes "你一定要去看看。";
	next;
	mes "[Mudie]";
	mes "如果你想去怪物赛跑竞技场，";
	mes "只要朝小地图上的";
	mes "7 点钟方向前进，";
	mes "寻找被栅栏围住的山丘。";
	mes "竞技场就在那附近。";
	mes "沿着道路走就能找到。";
	next;
	mes "[Mudie]";
	mes "你应该能在那一带找到竞技场。";
	mes "无论是下注还是观看比赛，";
	mes "都可以去找埃卡尔兄弟中的一人。";
	mes "希望你喜欢我们的小镇～";
	mes "祝你玩得开心。";
	close;
}

p_track02,32,45,5	script	Eccentric Scholar#double	755,{
	mes "[Eccentric Scholar]";
	mes "让我看看……";
	mes "1 号怪物的平均速度和运气，";
	mes "受到风阻和疲劳影响……";
	mes "大概的获胜概率是多少……？";
	mes "需要继续计算。";
	mes "结果马上就出来了。";
	next;
	mes "[Eccentric Scholar]";
	mes "代入我的算法……";
	mes "进位……";
	mes "等等，我应该使用几位";
	mes "有效数字？";
	mes "啊，对了，7 位，";
	mes "代表 x 的数值——";
	next;
	mes "["+ strcharinfo(0) +"]";
	mes "不好意思，";
	mes "你在做什么？";
	next;
	mes "[Eccentric Scholar]";
	mes "安、安静！";
	mes "我必须完成";
	mes "我的计算！";
	mes "我刚才算到哪里了……？";
	specialeffect EF_CLAYMORE;
	emotion ET_FRET;
	close;
}

p_track02,69,31,1	script	Blacksmith Guildsman#dou	726,{
	if (!$@mon_time_2_2) {
		mes "[Blacksmith Guildsman]";
		mes "我还要在这些比赛上下注多少次？！";
		mes "我一次都没赢过！";
		mes "我的下注运气";
		mes "一定是历史上最差的！";
		mes "真是太倒霉了！";
		emotion ET_CRY;
		next;
		mes "[Blacksmith Guildsman]";
		mes "公会派我带回一些";
		mes "奖牌到艾音布罗克……";
		mes "据说它们由稀有金属制成，";
		mes "但……";
		mes "我实在太难赢到了～！";
		mes "请给我一点好运吧！";
		emotion ET_PROFUSELY_SWEAT;
		close;
	} 
	mes "[Blacksmith Guildsman]";
	mes "跑啊！快跑快跑！";
	mes "我必须赢得一些奖牌！";
	mes "否则我没脸回到";
	mes "艾音布罗克的家！";
	mes "快、快一点！";
	emotion ET_FLAG;
	close;
}

p_track02,53,45,3	script	Valiant Knight#double	733,{
	mes "[Valiant Knight]";
	mes "嘿，你一直在比赛上下注吗？";
	mes "如果你有可靠的情报，";
	mes "能和我分享吗？";
	mes "我赢过几次下注……";
	mes "但我真的想赢得更多！";
	mes "拜托了！";
	next;
	mes "[Valiant Knight]";
	mes "哈哈！就像我告诉那些铁匠的那样！";
	mes "如果他们不想总是输，";
	mes "就应该一直押同一只怪物。";
	mes "至于我？我总是押黑色小恶魔～";
	mes "它一定会赢！";
	next;
	mes "[Valiant Knight]";
	mes "你也一样……！";
	mes "永远押注";
	mes "小恶魔！";
	emotion ET_BEST;
	close;
}

p_track01,27,47,5	script	Drunkard#single	853,{
	mes "[Familiar Drunkard]";
	mes "呜……！^333333*打嗝*^000000";
	mes "我一定要赢下";
	mes "下一场比赛！必须赢！";

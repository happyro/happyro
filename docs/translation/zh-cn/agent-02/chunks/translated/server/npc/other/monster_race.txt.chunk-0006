				mes "哦，好吧……";
				mes "不过我真的需要那些奖牌，";
				mes "如果你改变主意，";
				mes "请尽快回来。";
				mes "我会等着你。";
				close;
			}
		case 4:
			mes "[Ei'felle]";
			mes "我已经能够用你带来的奖牌";
			mes "制作闪光外套了。";
			mes "但我知道只要你再带一些，";
			mes "我就能做出更好的东西！";
			mes "请继续帮助我。";
			mes "带来的越多越好！";
			next;
			mes "[Ei'felle]";
			mes "目前我拥有你捐赠的奖牌中";
			mes "^FF0000"+ ein_medal01 +"^000000 枚的金属。";
			mes "你带来的越多，";
			mes "我就越接近新的突破！";
			close;
	}

S_BonusReward:
	mes "[Ei'felle]";
	.@arg1 = getarg(1);
	if (.@arg1 == 2319) {
		mes "你真的想要";
		mes "这件 "+getitemname(.@arg1)+" 吗？";
		mes "也许你可以放弃这份奖励，";
		mes "以后换取";
		mes "更好的东西……";
	} else if (.@arg1 == 2345 || .@arg1 == 2347 || .@arg1 == 2349 || .@arg1 == 2351) {
		mes "你确定要接受这套带插槽的";
		mes "属性护甲吗？接受后，";
		if (.@arg1 == 2345) mes "火属性护甲会被领取。";
		else if (.@arg1 == 2351) mes "地属性护甲会被领取。";
		else if (.@arg1 == 2349) mes "风属性护甲会被领取。";
		else if (.@arg1 == 2347) mes "水属性护甲会被领取。";
		mes "我还需要更多奖牌";
		mes "来推进制造研究。";
		mes "你愿意继续吗？";
	} else {
		mes "所以你想要";
		mes getitemname(.@arg1)+"？如果你选择";
		mes "这件 4 级武器，";
		mes "我就必须熔化许多你捐赠的";
		mes "奖牌。要继续吗？";
		mes "请仔细考虑。";
	}
	next;
	if (select("拒绝:接受") == 1) {
		mes "["+ strcharinfo(0) +"]";
		mes "等、等等，我改变主意了。";
		mes "我可以请你";
		mes "以后再给我奖励吗？";
		mes "请让我稍后决定。";
		next;
		mes "[Ei'felle]";
		if (getiteminfo( .@arg1, ITEMINFO_TYPE ) == IT_ARMOR) {
			mes "当然，当然。";
			mes "记住，只要再捐赠更多奖牌，";
			mes "我就能为你制作";
			mes "品质更高的物品～";
			mes "请继续支持我的研究。";
		} else {
			mes "我不认为还能开发出比这些 4 级武器更好的东西，";
			mes "但投入了这么多之后，";
			mes "你应该仔细决定想要什么。";
		}
		close;
	}
	mes "[Ei'felle]";
	if (.@arg1 == 2319) {
		mes "给你。我相信这件";
		mes getitemname(.@arg1)+" 会很好用。";
		mes "谢谢你的帮助，也希望你";
		mes "继续捐赠奖牌，";
		mes "支持我的金属研究～";
		mes "拜托了。";
	} else if (.@arg1 == 2345 || .@arg1 == 2347 || .@arg1 == 2349 || .@arg1 == 2351) {
		mes "选得好！我相信";
		if (.@arg1 == 2345) mes "这套火属性插槽护甲";
		else if (.@arg1 == 2351) mes "这套地属性插槽护甲";
		else if (.@arg1 == 2349) mes "这套风属性插槽护甲";
		else if (.@arg1 == 2347) mes "这套水属性插槽护甲";
		mes "一定会很好用。谢谢你的帮助，";
		mes "如果你得到更多奖牌，";
		mes "请继续捐给我～";
		mes "我会继续研究。";
	} else {
		mes "再次感谢你提供这么多奖牌。";
		mes "我想这一定很不容易。";
		mes "无论如何，";
		mes "我会感激你继续提供帮助～";
		mes "拜托你了。";
		mes "谢谢。";
	}
	ein_medal01 -= getarg(0);
	getitem .@arg1,1;
	close;
}

hugel,71,83,4	script	Wayne	900,{
	if (!checkweight("Knife",1)) {
		mes "[Wayne]";
		mes "等一下……";
		mes "如果你想用奖牌兑换物品，";
		mes "最好先在背包里腾出空间。";
		mes "为什么不使用卡普拉仓库呢？";
		mes "先整理好物品再来吧。";
		close;
	}
	mes "[Wayne]";
	mes "你好！你有没有想过";
	mes "怪物赛跑竞技场赢来的";
	mes "奖牌能做什么？你可以在艾音布罗克";
	mes "把它们捐给铁匠公会……";
	mes "帮助他们进行研究。";
	mes "这也是一种选择。";
	next;
	mes "[Wayne]";
	mes "……或者现在就来找我兑换物品。";
	mes "和往常一样，选择权在你手里。";
	mes "你可以自行决定。";
	mes "我不会强迫你。";
	next;
	if (select("奖牌兑换:取消") == 2) {
		mes "[Wayne]";
		mes "记住，你随时可以来找我，";
		mes "用奖牌换取消耗品。";
		mes "至于艾音布罗克那家伙？";
		mes "我也不知道他会拿什么交换……";
		mes "你可以自己去问他。";
		mes "也许会有惊喜。";
		next;
		mes "[Wayne]";
		mes "我只知道他需要大量奖牌";
		mes "来完成手头的工作。";
		mes "不过听说他也许会让你的捐赠";
		mes "值得你付出的全部努力。";
		mes "你可以考虑一下。";
		mes "总之，选择由你决定。";
		close;
	}
	if (!checkweight("Jellopy",550)) {
		mes "[Wayne]";
		mes "等一下……";
		mes "如果你想用奖牌兑换物品，";
		mes "最好先在背包里腾出空间。";
		mes "为什么不使用卡普拉仓库呢？";
		mes "先整理好物品再来吧。";
		close;
	} else {
		mes "[Wayne]";
		mes "你想兑换多少枚奖牌？";
		mes "不难看出，一次兑换的奖牌越多，";
		mes "就能得到价值更高的物品。";
		mes "请根据自己的需要选择。";
		mes "你可以慢慢考虑。";
		mes "准备好后告诉我。";
		next;
		setarray .@pm, 1,3,7,8,16,25,42,59;
		.@total_pm = getarraysize(.@pm);
		for ( .@i = 0; .@i < .@total_pm; .@i++ )
			.@menu$ = .@menu$ + .@pm[.@i] + " 枚奖牌：";
		.@m = select(.@menu$) - 1;
		switch (.@m) {
			case 0: 
				.@items$ = "2 赫纳叶:2 芦荟叶:1 马斯特拉果实:5 魔女之砂:4 浓缩红色药水";
				setarray .@item_array, 520,2,521,2,522,1,1061,5,545,4;
				break;
			case 1:
				.@items$ = "1 皇家果冻:6 圣水";
				setarray .@item_array, 526,1,523,6;
				break;
			case 2:
				.@items$ = "1 饼干袋:1 急救箱";
				setarray .@item_array, 12130,1,12110,1;
				break;
			case 3:
				.@items$ = "1 礼物盒";
				setarray .@item_array, 644,1;
				break;
			case 4:
				.@items$ = "1 古旧的蓝色箱子";
				setarray .@item_array, 603,1;
				break;
			case 5:
				.@items$ = "1 驯服礼盒";
				setarray .@item_array, 12105,1;
				break;
			case 6:
				.@items$ = "1 古旧的紫色箱子";
				setarray .@item_array, 617,1;
				break;
			case 7:
				.@items$ = "1 波利箱子";
				setarray .@item_array, 12109,1;
				break;
		}
		mes "[Wayne]";
		mes "请选择你想获得的物品套装，";
		mes "用 "+.@pm[.@m]+" 枚奖牌兑换。";
		mes "请确认你的选择。";
		mes "如果只有一套物品，我们也会提示你。";
		next;
		.@m2 = ( select(.@items$) -1 ) *2;
		if (countitem("Marvelous_Medal") < .@pm[.@m]) {
			mes "[Wayne]";
			mes "嘿，你身上没有足够的奖牌。";
			mes "想和我兑换物品的话，";
			mes "先去收集更多奖牌吧。";
			mes "收集好后再回来。";
			mes "我会为你兑换。";
			close;
		}
		mes "[Wayne]";
		mes "给你～";
		mes "谢谢使用我的服务，";
		mes "希望你很快再来找我。";
		mes "祝你享受怪物赛跑，";
		mes "正直的冒险者～";
		mes "下次再见！";
		delitem 7515,.@pm[.@m];// Marvelous_Medal
		getitem .@item_array[.@m2], .@item_array[(.@m2+1)];
		close;		
	}
}


}

p_track01,69,31,1	script	Blacksmith Guildsman#sin	107,{
	mes "[Blacksmith Guildsman]";
	mes "怎么会这么难？";
	mes "为什么我连一场比赛";
	mes "都赢不了？啊！";
	mes "至少赢得一枚奖牌前，";
	mes "我绝不能回去！";
	next;
	mes "[Blacksmith Guildsman]";
	mes "是的，艾音布罗克工厂派我";
	mes "来收集一些奖牌，";
	mes "因为它们由稀有金属制成。";
	mes "但看来他们选错了人……";
	mes "我根本不擅长下注。";
	next;
	mes "[Blacksmith Guildsman]";
	mes "我的意思是，我已经在这里待了很久，";
	mes "却什么都没赢到！嘿，帮我个忙，";
	mes "把你多余的奖牌";
	mes "交给艾音布罗克工厂，好吗？";
	mes "他们一定会感谢你的。";
	mes "拜托了！";
	close;
}

p_track01,45,42,3	script	Absent Minded Man#single	881,{
	mes "[Absent Minded Man]";
	mes "你是来给怪物赛跑下注的吗？";
	mes "我大老远来到这里，";
	mes "只是因为一个奇怪的人";
	mes "让我赢得奖牌。";
	mes "这就是我来到赫尔的唯一原因……";
	mes "我也不知道该怎么办。";
	next;
	mes "[Absent Minded Man]";
	mes "但我已经下注超过 100 次，";
	mes "一次都没赢过！我的意思是，";
	mes "如果我对同一只怪物下注 6 次，";
	mes "至少应该赢一次，";
	mes "对吧？到底怎么回事？！";
	mes "这太奇怪了！";
	close;
}

hugel,5,5,3	script	Monster Race Manager	868,{
	callfunc "F_GM_NPC";
	mes "[Monster Race Manager]";
	mes "我可以启用或停用";
	mes "单人和双人怪物赛跑的";
	mes "竞技场入口 NPC。";
	mes "请选择要执行的操作。";
	next;
	.@select = select("单人赛入口—开启:双人赛入口—开启:单人赛入口—关闭:双人赛入口—关闭");
	mes "[Monster Race Manager]";
	mes "请输入";
	mes "密码。";
	next;
	.@i = callfunc("F_GM_NPC",1854,0,0,2000);
	if (.@i == -2) {
		mes "[Monster Race Manager]";
		mes "错误。";
	} else if (.@i == -1) {
		mes "[Monster Race Manager]";
		mes "密码错误。";
	} else if (.@i == 1) {
		mes "[Monster Race Manager]";
		switch(.@select) {
		case 1:
			mes "单人怪物赛跑";
			mes "入口 NPC 已开启。";
			donpcevent "Eckar Ellebird#single::OnEnable";
			close;
		case 2:
			mes "双人怪物赛跑";
			mes "入口 NPC 已开启。";
			donpcevent "Eckar Erenes#double::OnEnable";
			close;
		case 3:
			mes "单人怪物赛跑";
			mes "入口 NPC 已关闭。";
			donpcevent "Eckar Ellebird#single::OnDisable";
			close;
		case 4:
			mes "双人怪物赛跑";
			mes "入口 NPC 已关闭。";
			donpcevent "Eckar Erenes#double::OnDisable";
			close;
		}
	}
	close;
}

S_Warp:
	.@npc_name$ = "[" + strnpcinfo(1) + "]";
	.@item_name$ = getitemname(1000374);

	mes .@npc_name$;
	mes "这里最近的地方是 ^0033FF维因斯^000000，";
	mes "如果你有" + .@item_name$ + "，请给我一个……我会传送你过去。";
	next;
	if (select( "给我 1 个" + .@item_name$ + "，前往维因斯", "不" ) == 2) {
		mes .@npc_name$;
		mes "啊……那我能怎么办？";
		close;
	}
	if (countitem(1000374) < 1) {
		mes .@npc_name$;
		mes "你似乎没有" + .@item_name$ + "？";
		close;
	}
	delitem 1000374,1;	// Brilliant_Soda
	warp "veins",208,124;
	end;

OnInit:
	setunittitle getnpcid(0), "<Juno Monster Society>";

	questinfo( QTYPE_DAILYQUEST, QMARK_YELLOW, "BaseLevel >= 90 && checkquest(8675,HUNTING) == -1" );
	questinfo( QTYPE_DAILYQUEST, QMARK_YELLOW, "isbegin_quest(8675) == 2 && checkquest(8677,HUNTING) == -1 && checkquest(8676,PLAYTIME) == -1" );
	questinfo( QTYPE_DAILYQUEST, QMARK_YELLOW, "checkquest(8676,PLAYTIME) == 2" );
	questinfo( QTYPE_DAILYQUEST, QMARK_YELLOW, "checkquest(8675,HUNTING) == 2" );
	questinfo( QTYPE_DAILYQUEST, QMARK_YELLOW, "checkquest(8677,HUNTING) == 2" );

	// (no questinfo when playtime ongoing)
	end;
}

ra_fild06,292,39,5	script	Map Examiner Kantu#85	4_M_MOC_SOLDIER,{
	.@npc_name$ = "[" + strnpcinfo(1) + "]";
	.@item_name$ = getitemname(1000374);

	if (BaseLevel < 93) {
		mes .@npc_name$;
		mes "朱诺怪物协会正在进行讨伐任务。不过你似乎还太弱，无法执行任务。";
		close;
	}
	switch( checkquest(8673,PLAYTIME) ) {
	case -1:
		break;
	case 0:
	case 1:
		if (countitem(1000374) < 3) {
			mes .@npc_name$;
			mes "原则上，讨伐任务每天只能进行一次。";
			mes "今天先休息，下次再来……";
			close;
		}
		mes .@npc_name$;
		mes "原则上，讨伐任务每天只能进行一次。";
		mes "今天先休息，下次再来……";
		next;
		if (select( "I recommend " + .@item_name$ + "", "See you tomorrow" ) == 2) {
			mes .@npc_name$;
			mes "好的！明天见。";
			close;
		}
		delitem 1000374,3;	// Brilliant_Soda
		erasequest 8673;
		mes .@npc_name$;
	mes "哦，这是我最喜欢的" + .@item_name$ + "！";
	mes "我可以拿走吗？谢谢！";
		next;
		specialeffect EF_FLASHER;
		mes .@npc_name$;
	mes "真清爽！";
	mes "咔哈哈~……";
		next;
		mes .@npc_name$;
	mes "啊，冒险者。今天我要发布怪物讨伐调查委托，怎么样？";
		.@skip = true;
		break;
	case 2:
		erasequest 8673;
		break;
	}
	if (isbegin_quest(8672) == 2)
		.@quest_id = 8674;
	else
		.@quest_id = 8672;

	switch( checkquest(.@quest_id,HUNTING) ) {
	case -1:
		if (!.@skip) {
			mes .@npc_name$;
			mes "你好，冒险者！我是朱诺怪物协会的 Kantu。";
			mes "我想请冒险者调查怪物讨伐，你觉得如何？";
			next;
			mes .@npc_name$;
		}
		mes "或者，如果你要前往附近地区，我们也提供传送服务。";
		next;
		switch( select( "听取情况", "前往附近城镇", "停止" ) ) {
		case 1:
			if (.@quest_id == 8672) {
				mes .@npc_name$;
				mes "最近包括这里在内的一些地区怪物数量正在增加。";
				mes "这意味着已经无法自然控制它们。";
				next;
				mes .@npc_name$;
				mes "为了阻止进一步扩张，朱诺怪物协会计划进行大规模讨伐。";
				mes "无论多少冒险者前来，只要怪物侵入人们居住的地方，就会造成大问题……";
				next;
			}
			mes .@npc_name$;
			mes "那么，可以请你帮忙讨伐吗？";
			mes "在这片波托鲁纳原野猎杀 80 只怪物后，协会会认可你的成就并给予经验值。";
			next;
			if (select( "Accept", "Refuse" ) == 2) {
				mes .@npc_name$;
				mes "啊……你能帮帮我们吗？";
				close;
			}
			setquest .@quest_id;
			mes .@npc_name$;
			mes "好的，我已经登记了！";
			mes "我会确认这里的怪物数量是否受到控制。";
			close;
		case 2:
			mes .@npc_name$;
			mes "这里最近的地方是 ^0033FF拉赫^000000，";
			mes "如果你有" + .@item_name$ + "，请给我一个……我会传送你过去。";
			mes "哈~ 最近很流行，但我没法去买。";
			next;
			if (select( "Give me 1 " + .@item_name$ + ", Rachel", "No" ) == 2) {
				mes .@npc_name$;
				mes "我也没办法。";
				close;
			}
			if (countitem(1000374) < 1) {
				mes .@npc_name$;
				mes "你似乎没有" + .@item_name$ + "？";
				mes "我只能站在这里……抱歉。";
				close;
			}
			delitem 1000374,1;	// Brilliant_Soda
			warp "rachel",113,136;
			end;
		case 3:
			mes .@npc_name$;
			mes "啊……请帮帮我们……";
			close;
		}
		end;
	case 0:
	case 1:
		mes .@npc_name$;
		mes "请猎杀附近的 80 只怪物。";
		mes "……是的？需要传送服务？";
		next;
		mes .@npc_name$;
		mes "这里最近的地方是 ^0033FF拉赫^000000，";
		mes "如果你有" + .@item_name$ + "，请给我一个……我会传送你过去。";
		next;
		if (select( "Give me 1 " + .@item_name$ + ", Rachel", "No" ) == 2) {
			mes .@npc_name$;
				mes "我也没办法。";
			close;
		}
		if (countitem(1000374) < 1) {
			mes .@npc_name$;
				mes "你似乎没有" + .@item_name$ + "？";
				mes "我只能站在这里……抱歉。";
			close;
		}
		delitem 1000374,1;	// Brilliant_Soda
		warp "rachel",113,136;
		end;
	case 2:
		mes .@npc_name$;
		mes "你好，冒险者！我是朱诺怪物协会的 Kantu。";
		mes "我想请冒险者调查怪物讨伐，你觉得如何？";
		next;
		getexp 194712,185136;
		mes .@npc_name$;
		mes "啊，冒险者！我看到了你的出色表现。感谢你的努力。";
		if (.@quest_id == 8672)
			completequest 8672;
		else
			erasequest 8674;
		setquest 8673;
		close;
	}
	end;

OnInit:
	setunittitle getnpcid(0), "<Juno Monster Society>";

	questinfo( QTYPE_DAILYQUEST, QMARK_YELLOW, "BaseLevel >= 93 && checkquest(8672,HUNTING) == -1 && checkquest(8673,PLAYTIME) == -1" );
	questinfo( QTYPE_DAILYQUEST, QMARK_YELLOW, "isbegin_quest(8672) == 2 && checkquest(8674,HUNTING) == -1 && checkquest(8673,PLAYTIME) == -1" );
	questinfo( QTYPE_DAILYQUEST, QMARK_YELLOW, "checkquest(8673,PLAYTIME) == 2" );
	questinfo( QTYPE_DAILYQUEST, QMARK_YELLOW, "checkquest(8672,HUNTING) == 2" );
	questinfo( QTYPE_DAILYQUEST, QMARK_YELLOW, "checkquest(8674,HUNTING) == 2" );
	end;
}


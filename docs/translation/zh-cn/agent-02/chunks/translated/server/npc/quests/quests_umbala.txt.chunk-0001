//===== rAthena Script ======================================= 
//= Quest NPCs related to Umbala
//===== By: ================================================== 
//= sabernet09 & rAthena Team
//===== Current Version: ===================================== 
//= 2.2a
//===== Compatible With: ===================================== 
//= rAthena Project; 7.15 +
//===== Description: ========================================= 
//= [Official Conversion]
//= Umbalian Language Quest, Umbala Skeletal Gate Quest,
//= Umbala Event, Create Essence/Dismantle Stone
//	Phase 1. Learning the Language
//	  (Elder) First discussion
//	  (Elder) Asking about learning the language
//	  (Elder) Final step (understanding NPC speech)
//	------------------------------------------
//	Phase 2. Create Essence/Dismantle Stone
//	 (Shaman) Get permission to speak with her from the chief
//	  (Elder) Ask about conditions needed to be fulfilled to get permission
//	  (Elder) Get permission
//	 (Shaman) Use the shaman to create essences and dismantle elemental stones.
//= Umbala Domestic Dispute?
//= - This quest is only avaliable if you have not done language quest.
//= - Variables in use: um_wind, MISC_QUEST (Bit 32768)
//===== Additional Comments: ================================= 
//= fixed by x[tsk], Lupus, PoW
//= Quest completion is now registered
//= 1.1 fixed Poporing Egg ID -> Poring Egg, fixed condition
//= 1.2-1.6 fixed some Umbalian Language quests [Lupus]
//= 1.7 Moved Umbala Event, Create Essence/Dismantle Stone, and Skeletal Gate from npc/cities/umbala.txt [Evera]
//= 1.7a Removed all custom quests to custom folder [Lupus]
//= 1.8 Added official chance of failure to Create Essence/Dismantle Stone [Lupus]
//= 1.9 Added functionality to allow players to dismantle more
//=     than a stone at once, up to 10. [SinSloth]
//= 2.0 Updated hack check and added a weight check to dismantling. [SinSloth]
//= 2.1 Rescripted to Aegis 10.3 standards. Added strange quest. [L0ne_W0lf]
//= 2.2 Readded the ability to dismantle multiple stones at once. [L0ne_W0lf]
//= 2.2a Fixed weight check from previous update. [L0ne_w0lf]
//============================================================ 

// Umbalian Language Quest :: um_trans
//============================================================
um_in,39,122,5	script	Utan Chief	784,{
	if (event_umbala == 0) {
		mes "[Karkatan]";
		mes "呵呵，来自卢恩-米德加兹的人。";
		mes "我猜你是第一次";
		mes "来我的村子，对吧？";
		next;
		mes "[Karkatan]";
		mes "我遇到的每个卢恩-米德加兹人";
		mes "第一次来到这里时，";
		mes "脸上都有和你现在";
		mes "一样的表情。";
		mes "看来大家都差不多。";
		next;
		mes "[Karkatan]";
		mes "也许是因为语言障碍，";
		mes "他们无法与我们交流，";
		mes "所以不知道发生了什么。";
		mes "嗯，我理解……";
		mes "总之，欢迎来到我的村子。";
		next;
		mes "[Karkatan]";
		mes "我叫卡尔卡坦，";
		mes "是乌坦部族的首领。";
		mes "你一定很好奇";
		mes "我为什么会说你们的语言。";
		next;
		mes "[Karkatan]";
		mes "很久以前，一位来自你们土地的";
		mes "冒险者教会了我。已经过去很久，";
		mes "我也不知道他后来怎么样了……";
		next;
		mes "[Karkatan]";
		mes "无论如何，我学到了很多";
		mes "关于卢恩-米德加兹文化";
		mes "和语言的知识。";
		next;
		mes "[Karkatan]";
		mes "有时我会教乌坦语，";
		mes "但不会让所有人享有这个特权。";
		mes "如果不怀好意的外来者学会乌坦语，";
		mes "他们可能会伤害我的部族。";
		next;
		mes "[Karkatan]";
		mes "在学习乌坦语之前，";
		mes "先探索我们的村子，";
		mes "通过探索了解";
		mes "乌坦文化吧。";
		next;
		mes "[Karkatan]";
		mes "虽然你现在还无法和我的族人交流，";
		mes "但请通过观察，";
		mes "试着理解我们的生活方式。";
		mes "慢慢了解我们。";
		next;
		mes "[Karkatan]";
		mes "注意当地人的服饰、";
		mes "外表和生活方式。";
		mes "当你觉得已经充分了解乌坦文化时，";
		mes "回来告诉我你学到了什么。";
		mes "记住这些细节。";
		mes "观察得越仔细，";
		mes "就越能理解我们。";
		mes "这是学习语言的第一步。";
		mes "完成后再来找我。";
		mes "我会继续指导你。";
		mes "等你回来。";
		set event_umbala,1;
		close;
	}
	else if (event_umbala == 1) {
		mes "[Karkatan]";
		mes "哦，又是你。那么……";
		mes "你了解乌坦文化了吗？";
		mes "我想听听你的意见，";
		mes "以及你的感想。";
		mes "我很想听听。";
		next;
		mes "[Karkatan]";
		mes "仍有一些村民对卢恩-米德加兹人很天真。";
		mes "通常他们害怕与你们接触，";
		mes "会把自己藏起来。";
		mes "他们总是这样。";
		next;
		mes "[Karkatan]";
		mes "那么……";
		mes "有什么我能帮你的吗？";
		mes "我想你参观村子时没遇到什么问题，";
		mes "但看来你有事要问我。";
		mes "说说看吧。";
		next;
		switch(select("我想学习乌坦语。:乌姆巴巴 乌姆巴巴？:没什么。")) {
		case 1:
			if (isequipped(2278) || isequipped(2297) || isequipped(2288) || isequipped(2292) || isequipped(5005) || isequipped(2281) || isequipped(5043)) {
				mes "[Karkatan]";
				mes "嗯……你戴的面具真棒。";
				mes "我们乌坦人喜欢戴面具，";
				mes "这样就不用显露";
				mes "自己的表情。";
				next;
				mes "[Karkatan]";
				mes "所以我们一直戴着面具。";
				mes "我们相信人与人的互动和相处";
				mes "不应该取决于";
				mes "外表。";
				next;
				mes "[Karkatan]";
				mes "好，我确定你有资格学习乌坦语。";
				mes "从现在起我会教你";
				mes "用乌坦语说话和阅读。";
				mes "请认真学习。";
				mes "从今天开始。";
				next;
				mes "[Karkatan]";
				mes "不过你需要准备一些物品，";
				mes "这样我们才能继续课程。首先，";
				mes "需要两种不同的纸张。";
				mes "请把它们带来。";
				mes "^3377FF10 Oil Paper^000000 and ";
				mes "^3377FF5 Slick Paper^000000.";
				next;
				mes "[Karkatan]";
				mes "我们还需要书写工具。";
				mes "就使用这个吧：";
				mes "^3377FF1 Squid Ink^000000 and";
				mes "^3377FF1 Feather of Birds^000000.";
				mes "请把这些带给我，";
				mes "准备好后我就会教你。";
				set event_umbala,2;
				close;
			}
			else {
				mes "[Karkatan]";
				mes "看来你还不了解我们的文化。";
				mes "如果不理解文化，";
				mes "就无法学习另一种语言。";
				mes "请先继续观察。";
				next;
				mes "[Karkatan]";
				mes "当你脸上出现那种表情时，";
				mes "乌坦人会感到害怕……";
				mes "因为我们不向他人展示脸，";
				mes "所以其实很容易";
				mes "受到面部表情影响。";
				mes "请理解这一点。";
				next;
				mes "[Karkatan]";
				mes "再去村子里探索一会儿。";
				mes "觉得准备好后随时回来。";
				mes "我会等着你。";
				next;
				mes "[Karkatan]";
				mes "无论如何，你觉得我的面具怎么样？";
				mes "这是我们乌坦人目前的潮流……";
				mes "你不觉得很棒吗？";
				mes "是不是很酷？";
				close;
			}
		case 2:
			mes "[Karkatan]";
			mes "哈哈～如果你只是模仿声音，";
			mes "说出来的话不会有意义。";
			mes "语言是沟通思想和感情的";
			mes "共同系统。";
			next;
			mes "[Karkatan]";
			mes "遗憾的是，如今各族人民";
			mes "似乎不再对其他文化";
			mes "保持敏感。";
			mes "至少在这方面是这样。";
			next;
			mes "[Karkatan]";
			mes "我看到有人鄙视或嘲笑";
			mes "不了解他们的其他人。";
			mes "这种偏见至今仍存在，";
			mes "实在令人悲伤……";
			next;
			mes "[Karkatan]";
			mes "如果你对乌坦语感兴趣，";
			mes "请更好地理解我们的文化，";
			mes "准备好后再回来。";
			mes "我会教你理解";
			mes "那些声音的含义。";
			close;
		case 3:
			mes "[Karkatan]";
			mes "有时漫无目的地漫步也不错。";
			mes "但如果想从旅途中学到东西，";
			mes "最好还是为旅程设定目标。";
			mes "这样才能有所收获。";
			mes "记住这一点。";
			mes "继续探索吧。";
			close;
		}
	}
	else if (event_umbala == 2) {
		if ((countitem(7151) > 9) && (countitem(7111) > 4) && (countitem(1024) > 0) && (countitem(916) > 0)) {
			mes "[Karkatan]";
			mes "好，我想可以开始了。";
			mes "让我们开始课程吧。";
			mes "希望课程结束后，";
			mes "你能更好地与乌坦人交流。";
			next;
			mes "[Karkatan]";
			mes "..............";
			next;
			mes "[Karkatan]";
			mes "..............";
			mes ".....................";
			next;
			mes "[Karkatan]";
			mes "..............";
			mes ".....................";
			mes "............................";
			next;
			mes "[Karkatan]";
			mes "好了，就这样。忘掉学习语言前";
			mes "你对乌坦人的看法吧。";
			mes "现在去试着和乌坦人交谈。";
			mes "交流是理解他人的重要方式。";
			mes "去和大家聊聊吧。";
			delitem 7151,10; //Oil_Paper
			delitem 7111,5; //Smooth_Paper
			delitem 1024,1; //Chinese_Ink
			delitem 916,1; //Feather_Of_Birds
			set event_umbala,3;
			next;
			mes "[Karkatan]";
			mes "好，如果以后在村里有事，";
			mes "尽管来找我说话。";
			mes "我会尽力帮助你，";
			mes "能帮多少就帮多少。";
			close;
		}
		else {
			mes "[Karkatan]";
			mes "看来你还没准备好……";
			mes "你忘了需要哪些物品吗？";
			mes "我再告诉你一次，";
			mes "请把它们带来，";
			mes "这样我们才能开始课程。";
			next;
			mes "[Karkatan]";
			mes "^3377FF10张油纸^000000、";
			mes "^3377FF5张光滑纸^000000、";
			mes "^3377FF1瓶乌贼墨水^000000、";
			mes "^3377FF1根鸟羽毛^000000。";
			mes "把这些全部带来后，";
			mes "我就会教你我们的语言。";
			close;
		}
	}
	else if (event_umbala >= 3) {
		if (event_umbala == 4) {
			mes "[Karkatan]";
			mes "一定是普丘查坦让你来找我的。";
			mes "我需要确认你是否有资格请求她的帮助……";
			mes "我们乌坦人不愿帮助邪恶之人。";
			mes "请证明自己。";
			mes "我会仔细检查。";
			next;
			mes "[Karkatan]";
			mes "嗯嗯……";
			mes "如果能有一副在卢恩-米德加兹";
			mes "制作的面具就好了……";
			next;
			mes "[Karkatan]";
			mes "我想要^3377FF1个微笑先生^000000。";
			mes "对乌坦人来说，收到面具礼物";
			mes "是一种荣誉。也许普丘查坦";
			mes "希望你这样向我们表示尊敬。";
			mes "带来后我就会认可你。";
			set event_umbala,5;
			close;
		}
		else if (event_umbala == 5) {
			if (countitem(2278) > 0) {
				mes "[Karkatan]";
				mes "哦，你带来了！是的，我一直";
				mes "希望拥有这副面具！这真是";
				mes "一种荣誉！谢谢你，";
				mes "来自卢恩-米德加兹的冒险者。";
				mes "我会记住你的帮助。";
				next;
				mes "[Karkatan]";
				mes "我会告诉普丘查坦，";
				mes "我已经确认了你的资格。";
				mes "去和她谈谈吧。虽然我不确定";
				mes "她能给你什么帮助，";
				mes "但希望我们能回报这份情谊。";
				delitem 2278,1; //Mr_Smile
				set event_umbala,6;
				close;
			}
			else {
				mes "[Karkatan]";
				mes "我告诉过你需要";
				mes "^3377FF1个微笑先生^000000吗？";
				mes "请把它带来，证明你的善意";
				mes "以及你的荣誉感。";
				mes "这是你对部族的承诺。";
				close;
			}
		}
		else {
			mes "[Karkatan]";
			mes "最近怎么样？";
			mes "我真想带你参观村子，";
			mes "但不能忽视";
			mes "作为部族首领的职责。";
			next;
			mes "[Karkatan]";
			mes "领导部族并不像看起来那么容易。";
			mes "如果你处在我的位置就会明白。";
			mes "无论如何，希望你在村子里过得愉快。";
			mes "欢迎继续留在村里。";
			close;
		}
	}
}

// Create Essence/Dismantle Stone Quest :: um_npc
//============================================================
um_in,44,71,2	script	Utan Shaman	782,{
	if (checkweight(908,600) == 0) {
		mes "^3355FF等一下！";
		mes "你现在携带的物品太多了。";
		mes "请使用卡普拉服务";
		mes "先把物品存起来，";
		mes "然后再回来。";
		mes "存放一些物品后再回来。^000000";
		close;
	}
	switch(event_umbala) {
	default:
		mes "[??????????]";
		mes "Umbah umbah umbabah Utan umbah";
		mes "Umbah mookala umbabah..";
		mes "Umbabahumbah umbabah";
		mes "Umbabah umbaba umbaumbah umbah";
		mes "Hum umbah umbah.";
		close2;
		warp "umbala",217,186;
		end;
	case 3:
		mes "[Puchuchartan]";
		mes "没想到竟然还有更多卢恩-米德加兹人";
		mes "找到我的村子。我担心";
		mes "大地母亲会因为这些事";
		mes "而遭受苦难……";
		mes "请你理解我的担忧。";
		mes "我们必须谨慎。";
		next;
		mes "[Puchuchartan]";
		mes "你们卢恩-米德加兹人是非常邪恶的部族……";
		mes "总是不择手段达成目标，";
		mes "从不犹豫破坏他人的财产，";
		mes "只为了得到自己想要的东西。";
		mes "这让我们无法信任你们。";
		mes "请不要伤害我们的村子。";
		next;
		mes "[Puchuchartan]";
		mes "我担心继续与外界接触";
		mes "会如何影响我们的未来……";
		mes "我们必须保护族人。";
		next;
		mes "[Puchuchartan]";
		mes "没有哪个卢恩-米德加兹人";
		mes "会毫无目的地来找我，";
		mes "我想你也不例外。";
		mes "你来这里有什么目的？";
		next;
		mes "[Puchuchartan]";
		mes "我只为部族使用自己的力量，";
		mes "不会帮助陌生人。如果你真的需要我的帮助，";
		mes "就去请求首领的许可。";
		mes "这是我们的规矩。";
		mes "请不要违反它。";
		next;
		mes "[Puchuchartan]";
		mes "另外，我不赞成外来者";
		mes "与部族交谈超过必要程度……";
		mes "我们想过平静的生活，";
		mes "所以请不要打扰我们。";
		set event_umbala,4;
		close;
	case 4:
	case 5:
		mes "[Puchuchartan]";
		mes "我已经告诉过你要取得首领的同意。";
		mes "我还有自己的事情要处理。";
		mes "请不要再来烦我。";
		next;
		mes "[Puchuchartan]";
		mes "我知道你历经许多困难来到这里，";
		mes "但你现在必须离开。";
		mes "这是为了大家的安全。";
		close;
	case 6:
		mes "[Puchuchartan]";
		mes "我听首领说，他已经同意了……";
		mes "虽然我不喜欢这样，";
		mes "但我会遵守承诺。";
		mes "是否真的需要我的帮助，由你决定。";
		mes "我会尽力协助你。";
		next;
		mes "[Puchuchartan]";
		mes "我的力量可以制造粗制魔法石，";
		mes "也能将纯净魔法石分解成";
		mes "粗制魔法石。";
		mes "也许我能这样帮助你。";
		mes "请告诉我你的需要。";
		next;
		mes "[Puchuchartan]";
		mes "当你觉得我的力量";
		mes "可能对你有用时，";
		mes "就来和我谈谈。";
		set event_umbala,7;
		close;
	case 7:
		mes "[Putsuchiritan]";
		mes "我不知道自己的才能是否对你有用，";
		mes "但无论如何我都会帮助你。";
		mes "这是我的承诺。";
		next;
		mes "[Putsuchiritan]";
		mes "我可以从自然物品中制造元素精华，";
		mes "也可以把元素石分解成组成精华。";
		mes "你想做哪一种？";
	}
	next;
	mes "[Puchuchartan]";
	mes "请求我帮助的卢恩-米德加兹人……";
	mes "虽然我不确定你是否真的需要我的力量，";
	mes "但我会尽力提供帮助。";
	mes "请说明你的请求。";
	next;
	if (checkweight(1101,10) == 0) {
		mes "[Puchuchartan]";
		mes "等等——！";
		mes "你携带的某件物品";
		mes "扰乱了我的心境。";
		mes "这样不行……";
		next;
		mes "[Puchuchartan]";
		mes "把你的物品放到别处，";
		mes "现在只带上";
		mes "你需要的物品。";
		next;
		mes "[Puchuchartan]";
		mes "如果你拒绝这样做，";
		mes "我就无法为你做任何事。";
		mes "准备好之后";
		mes "再回来吧。";
		close;
	}
	mes "[Puchuchartan]";

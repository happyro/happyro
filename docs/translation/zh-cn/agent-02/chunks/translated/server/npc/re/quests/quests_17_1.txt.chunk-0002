lighthalzen,55,278,3	script	Rekenber Guard Oscar#171_light	4_M_LGTGUARD,{
	if (isbegin_quest(7862) == 0) {
		npctalk "雷根贝勒守卫：此处禁止进入。","",bc_self;
		end;
	}
	if (isbegin_quest(7862) == 1) {
		mes "[Oscar]";
		mes "实验室入口有双重锁。";
		mes "从里面锁上了。";
		mes "很难打开。";
		next;
		mes "[Oscar]";
		mes "我不太了解里面的锁，所以还不清楚。";
		mes "先确保‘雷根希尔姆’安全，再查清楚。";
		mes "准备好了吗？";
		next;
		.@md_name$ = "Regenschirm";
		.@party_id = getcharid(1);
		.@party_name$ = getpartyname(.@party_id);
		if (!.@party_id) {
			mes "^4D4DFF这里是纪念副本。";
			mes "请组队后再试。^000000";
			mes "请使用以下命令组队：^4D4DFF‘/organize 队伍名称’。^000000";
			close;
		}
		if (select("Create '" + .@md_name$ + "'","Enter '" + .@md_name$ + "'") == 1) {
			if (!is_party_leader()) {
				mes "[Oscar]";
				mes "路线还没有确保安全。请让队长准备路线吧？";
				close;
			}
			mes "[Oscar]";
			mes "准备好后请进入。";
			mes "里面的锁由阿斯负责。";
			if (instance_create(.@md_name$) == -3)
				dispbottom "The reservation of the instance '" + .@md_name$ + "' has failed due to an active instance.";
		} else {
			if (instance_enter(.@md_name$) == IE_OK) {
				mes "[Oscar]";
				mes "他们已经确保路线安全。";
				mes "我们悄悄进去吧。";
				close2;
				mapannounce "lighthalzen", strcharinfo(0) + " of the party, "+ .@party_name$ +", is entering the " + .@md_name$ + ".", bc_map, "0x00FF99";
			} else {
				mes "[Oscar]";
				mes "我们确保安全的路线出现了动静。";
				mes "再等一会儿吧。";
			}
		}
		close;
	}
	if (isbegin_quest(7862) == 2) {
		mes "[Oscar]";
		mes "子弹上的猫那里有泰丝给你的消息。";
		mes "请尽快回去。";
	}
	close;

OnInit:
	questinfo(QTYPE_QUEST,QMARK_YELLOW,"isbegin_quest(7862) == 1");
	end;
}

lighthalzen,259,215,3	script	Lazy#171_lhz	4_M_LAZY,{
	if (isbegin_quest(7850) < 2) {
		cutin "16lei_01",2;
		mes "[Lazy]";
	mes "雷根贝勒的道路宽阔闪亮～人人都知道施瓦茨瓦德共和国～";
		close3;
	}
	if (isbegin_quest(17004) == 1) {
		cutin "16lei_01",2;
		mes "[Lazy]";
	mes "大家集合～我们数数人数！卡雅·托斯！卡雅·托斯？";
		next;
		cloakoffnpc "Kaya Tos#171_lhz",getcharid(0);
		cloakoffnpc "Aas#171_lhz",getcharid(0);
		cutin "ep171_kaya01",0;
		mes "[Kaya]";
		mes ".....";
		next;
		cutin "16lei_01",2;
		mes "[Lazy]";
	mes "哦，你在这里！大家集合！";
	mes "现在人都到齐了！";
	npctalk "这位冒险者是我的秘书，也是我的护卫。","",bc_self;
	unittalk getcharid(3),strcharinfo(0) + "：我是什么？",bc_self;
		next;
		cutin "ep171_kaya03",0;
		mes "[Kaya]";
	mes "调查进展不错，但你能不能停止这种荒唐行为。";
		next;
		cutin "16lei_02",2;
		mes "[Lazy]";
	mes "我以为贵宾说只有两个条件？而且大家已经听到我说话了。";
	npctalk "难道我应该做一切来讨好你？","",bc_self;
		next;
		cutin "16lei_03",2;
		mes "[Lazy]";
	mes "我们现在是施瓦茨瓦德共和国的正式旅行者。无论如何，去哪里都躲躲藏藏的话，很难进行调查。";
		next;
		mes "[Lazy]";
	mes "来这里旅行真棒～我能感受到这种兴奋。你觉得历史学家会如何记载今天？";
		next;
		cutin "16lei_02",2;
		mes "[Lazy]";
	mes "卡雅，放松。把烦恼抛在脑后，假装自己在度假吧。你会看得更清楚。";
		next;
		mes "[Lazy]";
	mes "首先，试着在这次旅行中四处看看。感受一下自己的想法。";
	mes "如果你感受到什么，就应该采取行动。";
		next;
		mes "[Lazy]";
	mes "写一份小报告～总不能只是欣赏一番却什么都不做，对吧？";
	mes "当然……你和我们一起旅行一定有原因。";
		next;
		cutin "16lei_01",2;
		mes "[Lazy]";
	mes "话说回来，贵宾对不正当使用头等舱感到不舒服吗？开头虽然不舒服，但接下来的旅程会很顺利。";

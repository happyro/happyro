		mes "是的……确实如此。";
		npctalk "是的……确实如此。","Aas#171_einf",bc_self;
		npctalk "如果你愿意，我可以再教你一些技巧。在现实世界很有用。","Lazy#171_einf",bc_self;
		next;
		cutin "16lei_02",2;
		mes "[Lazy]";
		mes "喂，你已经到了。怎么样？你亲眼发现了什么？";
		npctalk "哦……还有更多技巧吗？听起来不错。","Aas#171_einf",bc_self;
		next;
		cutin "ep171_kaya02",0;
		mes "[Kaya]";
		mes "我意识到，文件很容易欺骗那些只坐在办公桌前、只顾自己事情的人。";
		next;
		cutin "ep171_as01",1;
		mes "[Aas]";
		mes "这里没有实验室。我们那边也什么都没有。";
		mes "什么都没有。";
		next;
		cutin "ep171_kaya01",0;
		mes "[Kaya]";
		mes "如果文件上的一切都是假的，我们就找不到更多情报了。";
		next;
		cutin "ep171_as01",1;
		mes "[Aas]";
		mes "我们现在怎么办？";
		next;
		cutin "16lei_01",2;
		mes "[Lazy]";
		mes "嗯。我们必须继续寻找这座新实验室的位置。找到后还要从内部调查。";
		npctalk "谁还有更好的主意？","Lazy#171_einf",bc_self;
		next;
		select("懒惰，你没有别的办法吗？");
		cutin "16lei_02",2;
		mes "[Lazy]";
		mes "亲爱的冒险者，你忘了是谁在帮助你吗？叛乱军一直在这些区域活动。";
		next;
		cutin "16lei_01",2;
		mes "[Lazy]";
		mes "我之前发现的实验室和废弃场。我确定它很快就会暴露。一定就在附近。";
		next;
		select("你怎么知道？");
		cutin "ep171_kaya01",0;
		mes "[Kaya]";
		mes "建造研究设施需要大量人力和材料。建成后也必须持续运入材料。";
		mes "这些物资要通过边境，不是很困难吗？";
		next;
		mes "[Kaya]";
		mes "所以实验室可能还在施瓦茨瓦德。材料不能公开运输，";
		mes "我们必须寻找秘密地点，我想应该就在这些地方之一。";
		next;
		cutin "16lei_01",2;
		mes "[Lazy]";
		mes "你听到了吗？真聪明。";
		next;
		cutin "ep171_kaya01",0;
		mes "[Kaya]";
		mes "从现在起，雷根贝勒将^0000FF全力配合调查。^000000请告诉我你需要的一切，我们会尽力支持。";
		next;
		cutin "16lei_01",2;
		mes "[Lazy]";
	mes "好，我很高兴听到这个，也很乐意接受你的合作。";
		next;
		cutin "ep171_kaya01",0;
		mes "[Kaya]";
	mes "我想亲自向黛西道歉。对不起，我没有相信你。谢谢你来找我们。";
		next;
		mes "[Kaya]";
	mes "黛西，如果你有任何需要，随时来找我。";
	mes "我随时欢迎你。";
	npctalk "嗯……我对此没有异议。","Lazy#171_einf",bc_self;
		next;
		cutin "16lei_01",2;
		mes "[Lazy]";
	mes "今后请叫我懒惰。以后找一天和我一起去冒险吧。偶尔来朱诺。";
	npctalk "我总是躲在朱诺的餐馆里～","Lazy#171_einf",bc_self;
		next;
		mes "[Lazy]";
	mes "不过那是以后的事。先专注于眼前的任务。";
		next;
	select("我还要继续调查吗？");
		mes "[Lazy]";
	mes "为什么不呢？你还能在这里做什么？嗯，我有点饿了，腿也疼。我得回去工作，还要处理贵宾的事。";
		next;
		mes "[Lazy]";
	mes "那么，我要报告关于帕特旅程的调查结果。";
	mes "大家回<NAVI>[子弹上的猫]<INFO>pub_cat,93,105,0,000,0</INFO></NAVI>吧～";
		getexp 600000,600000;
		completequest 17013;
		setquest 17014;
		getitem 25723,20;
		close3;
	}
	cutin "ep171_kaya01",0;
	mes "[Kaya]";
	mes "你去过<NAVI>[子弹上的猫]<INFO>pub_cat,93,105,0,000,0</INFO></NAVI>了吗？";
	mes "快一点。还有很多事要做。";
	close3;

OnInit:
	cloakonnpc();
	questinfo(QTYPE_QUEST,QMARK_YELLOW,"isbegin_quest(17013) == 1");
	end;
}


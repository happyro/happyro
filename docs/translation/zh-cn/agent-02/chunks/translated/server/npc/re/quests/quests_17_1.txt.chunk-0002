lighthalzen,56,270,3	script	Republic Guard#171_light	4_M_EIN_SOLDIER,{
	if (isbegin_quest(7861) == 0) {
		npctalk "禁止继续前进，请后退。","",bc_self;
		end;
	}
	if (isbegin_quest(7861) == 1) {
		mes "[Republic Guard]";
		mes "泰丝联系过我。";
		mes "别担心，我属于秘密之翼。";
		mes "阿斯和埃斯特去调查这片区域了。";
		next;
		cloakoffnpc "Commander Est#171_light",getcharid(0);
		cloakoffnpc "Aas#171_light",getcharid(0);
		cloakoffnpc "Emily#171_light",getcharid(0);
		npctalk "埃斯特：现在可以进去了。","Commander Est#171_light",bc_self;
		mes "[Republic Guard]";
		mes "哦，他们在那里。";
		next;
		cutin "ep162_est01",2;
		mes "[Est]";
		mes "你来得正是时候。";
		mes "我正准备进去。";
		mes "我带来的人已经全部派出去了，所以需要一些支援。";
		next;
		mes "[Est]";
		mes "看来人数还不够进去……";
		next;
		cutin "ep171_as01",0;
		mes "[Aas]";
		mes "计划就是这样。我告诉士兵不要伤害任何人，并保持警戒。他们不会贸然战斗。";
		next;
		mes "[Aas]";
		mes "我需要了解更多当前情况。";
		mes "所以首先，这次行动是为了收集更多情报，之后再发动全面攻击……";
		next;
		cutin "ep162_est01",2;
		mes "[Est]";
		mes "嘿嘿。没错。我和阿斯先进去。";
		mes "其余人会等待，收到信号后再进来。";
		next;
		npctalk "埃米莉：是，队长，别担心！","Emily#171_light",bc_self;
		mes "[Est]";
		mes "更重要的是封锁所有出口，不能让任何人逃走。";
		mes "其他人知道该做什么吧？";
		next;
		mes "[Est]";
		mes "我会走另一条路线，剩下的交给阿斯和冒险者。";
		mes "里面见。";
		next;
		cutin "ep171_as01",0;
		mes "[Aas]";
		mes "好的，我明白。";
		mes "那么我去告诉奥斯卡开门。我们必须做到！";
		completequest 7861;
		setquest 7862;
		cloakonnpc "Commander Est#171_light",getcharid(0);
		cloakonnpc "Emily#171_light",getcharid(0);
		close3;
	}
	if (isbegin_quest(7862) == 1) {
		mes "[Republic Guard]";
		mes "入口由站在前门附近的奥斯卡守卫。";
		mes "我和叛乱军留在外面。阿斯会进去。";
		mes "祝你好运！";
	}
	close;

OnInit:
	questinfo(QTYPE_QUEST,QMARK_YELLOW,"isbegin_quest(7861) == 1");
	end;
}


verus04,75,114,5	script	Charleston#mcd	4_F_CHARLESTON02,{
	cutin "nale01.bmp",0;
	if (BaseLevel < 130) {
		mes "[Charleston]";
		mes "我正在寻找至少130级、身体健康、没有慢性病且不服用处方药的冒险者。";
		close3;
	}
	if (isbegin_quest(13186) == 0) {
		switch( isbegin_quest(13184) ) {
		case 0:
			mes "[Charleston]";
			mes "你好，冒险者。我是独立计划的发起者Charleston。";
			next;
			mes "[Charleston]";
			mes "我的一个组件出了问题，目前无法移动。能帮我从工厂取回替换部件吗？";
			next;
			if (select( "Sure.", "No." ) == 1) {
				mes "[Charleston]";
				mes "如果你至少130级、身体健康、没有慢性病且不服用处方药，这项任务不会很难。";
				next;
				mes "[Charleston]";
				mes "请使用右侧的机器进入工厂。进去后保持冷静并遵循指示。";
				setquest 13184;
			}
			close3;
		case 1:
			mes "[Charleston]";
			mes "请使用我旁边的机器进入工厂。进去后保持冷静并遵循指示。";
			close3;
		case 2:
			cutin "nale03.bmp",0;
			mes "[Charleston]";
			mes "我不知道自己在这里站了多久，但已经很久不能移动了……";
			next;
			mes "[Charleston]";
			mes "现在只有头部能动，是Saleh帮助我打开了器官，才能回到那段时间……";
			next;
			mes "[Charleston]";
			mes "如果当时有人劝阻我，我就不会那样做了。";
			next;
			mes "[Charleston]";
			mes "总之，我现在一无所有……只希望能再次站起来，所以希望那时能派出像你这样的冒险者。";
			next;
			mes "[Charleston]";
			mes "^FF0000It didn't change anything.^000000";
			next;
			mes "[Charleston]";
			mes "只依靠OS的努力……感谢你在世界另一端的帮助，Charleston 2会成为‘非常优秀’的机器人！";
			next;
			mes "[Charleston]";
			mes "好朋友可以让机器人变得更好，所以我必须继续下去，谢谢！";
			erasequest 13184;
			if (isbegin_quest(13186) == 0) {
				setquest 13186;
				completequest 13186;
			}
			if (isbegin_quest(13187) > 0)
				erasequest 13187;
			getexp 1500000,500000;
			close3;
		}
		end;
	}
	cutin "nale03.bmp",0;
	switch( isbegin_quest(13184) ) {
	case 0:
		mes "[Charleston]";
		mes "你不失望吗？真的要让自己的努力白费吗？那可太傻了。我建议你重新考虑。";
		next;
		if (select( "I'll try again if there's a sliver of hope.", "I'll think again." ) == 1) {
			mes "[Charleston]";
			mes "我是机器人。我只做被编程要做的事，其他都不重要。";
			next;
			mes "[Charleston]";
			mes "很讽刺，不是吗？机器人本应没有情感，可我现在却在为过去感到遗憾。";
			next;
			mes "[Charleston]";
			mes "你可以评判我，却无法阻止我。只要还有一线希望，我就会继续尝试。";
			next;
			mes "[Charleston]";
			mes "我的心脏停止了，但我仍然能说话。请帮助我。";
			setquest 13184;
		}
		close3;
	case 1:
		mes "[Charleston]";
		mes "如果你因无法改变的过去、模糊的未来和令人沮丧的现在而幻灭，我不会强迫你。";
		next;
		if (select( "I'll try again if there's a sliver of hope.", "I give up." ) == 1) {
			mes "[Charleston]";
			mes "只要还有一线希望，我就会继续尝试。";
			close3;
		}
		erasequest 13184;
		close3;
	case 2:
		mes "[Charleston]";
		mes "我无法阻止事情发生，也无法改变过去。但也许别人可以。";
		next;
		mes "[Charleston]";
		mes "无论要等多久，我都会等那个人。";
		erasequest 13184;
		getexp 1500000,500000;
		close3;
	}
	end;
/*
// The sprite is supposed to be changed
OnInit:
	end;
*/
}

verus04,81,112,5	script	Machine#mcd	PORTAL,{
	if (BaseLevel < 130) {
		mes "[Machine]";
		mes "^ff0000你必须达到130级才能使用这台机器。^000000";
		close;
	}
	if (isbegin_quest(13184) != 1) {
		mes "^ff0000你需要得到查尔斯顿的许可才能使用这台机器。^000000";
		close;
	}
	.@party_id = getcharid(1);
	if (.@party_id < 1) {
		mes "^ff0000你必须先组建或加入至少有1人的队伍，才能进入此地下城。^000000";
		close;
	}
	switch( checkquest(13185,PLAYTIME) ) {
	case -1:
		break;
	case 0:
	case 1:
		mes "^ff0000上次访问后20小时内无法使用这台机器。^000000";
		close;
	case 2:
		mes "机器现在可以使用了。";
		erasequest 13185;
		close;
	}
	.@p_name$ = getpartyname(.@party_id);
	.@p_leader$ = getpartyleader(.@party_id);
	.@md_name$ = "Charleston in Distress";
	if (is_party_leader() == true)
		.@menu$ = "Open the dimensional portal.";

	switch( select( .@menu$, "Enter the Charleston Factory.", "Cancel." ) ) {
	case 1:
		if (instance_create(.@md_name$) < 0) {
			mes "队伍：" + .@p_name$ + "";
			mes "队长：" + .@p_leader$ + "";
			mes "^0000ff" + .@md_name$ + " ^000000- Unknown error";
			close;
		}
		mes "^ff0000Preparing to teleport...^000000";
		mes "^ff0000Please wait.^000000";
		close;
	case 2:
		if (is_party_leader() == false) {
			mes "[Machine]";
			mes "正在传送……";
			next;
			mes "[Machine]";
			mes "^ff0000上次访问后20小时内无法使用这台机器。^000000";
			next;
		}
		switch( instance_enter(.@md_name$) ) {
		case IE_OTHER:
			mes "[Machine]";
			mes "^ff0000An unknown error occurred.^000000";
			close;
		case IE_NOINSTANCE:
			mes "[Machine]";
			mes "^ff0000你的队长还没有创建时空裂缝。^000000";
			close;
		case IE_NOMEMBER:
			mes "[Machine]";
			mes "^ff0000只有队伍成员才能进入纪念地下城。^000000";
			close;
		case IE_OK:
			setquest 13185;
			specialeffect2 EF_READYPORTAL2;
			specialeffect2 EF_PORTAL2;
			mapannounce "verus04", "队伍" + getpartyname( getcharid(1) ) + "的" + strcharinfo(0) + "正在进入" + .@md_name$ + "。", bc_map, 0x00ff99;
			end;
		}
		end;
	case 3:
		end;
	}
	end;
}

// GM NPC
sec_in02,10,13,3	script	Charleston#sara	4_F_CHARLESTON01,{
	mes "Charleston危机测试 ver130603a";
	if (callfunc("F_GM_NPC",1854,0,0,9999) < 1)
		close;
	switch( select( "20 hour cooldown reset", "Returns the status of the initial solution task", "Establish a copy clearance status" ) ) {
	case 1:
		if (isbegin_quest(13185))
			erasequest 13185;
		close;
	case 2:
		if (isbegin_quest(13184))
			erasequest 13184;
		if (isbegin_quest(13186))
			erasequest 13186;
		if (isbegin_quest(13188))
			erasequest 13188;
		close;
	case 3:
		if (isbegin_quest(13184) == 0)
			setquest 13184;
		if (isbegin_quest(13184) == 1)
			completequest 13184;
		close;
	}
	end;
}

1@mcd,127,277,4	script	Charleston 1#0	4_F_CHARLESTON01,3,3,{
	cutin "dalle01.bmp",2;
	if ('ep15_1_mcd01 == 0) {
		mes "[Charleston 1]";
		mes "嗯……我还要等多久？";
		emotion 19;
		close3;
	}
	mes "[Charleston 1]";
	mes "沿左侧走廊前进，记住只有你自己能保护自己。";
	close3;

OnTouch_:
	cutin "dalle01.bmp",2;
	if ('ep15_1_mcd01 != 0) {
		mes "[Charleston 1]";
		mes "沿左侧走廊前进，记住只有你自己能保护自己。";
		close3;
	}
	mes "[Charleston 1]";
		mes "你终于来了！我一直在等你。";
		npctalk "你终于来了！我一直在等你。";
	emotion 0;
	next;
	mes "[Charleston 1]";
		mes "我们没时间了，我就直说吧。目前Charleston工厂处于B级安全警戒，意味着安全装置已经启动。";
		npctalk "我们没时间了，我就直说吧。目前Charleston工厂处于B级安全警戒，意味着安全装置已经启动。";
	next;
	mes "[Charleston 1]";
		mes "前往左侧走廊，摧毁那里的安全装置，然后前往下一个区域。";
		npctalk "前往左侧走廊，摧毁那里的安全装置，然后前往下一个区域。";
	emotion 19;
	next;
	mes "[Charleston 1]";
		mes "不用担心安全装置，它们很容易修复。Ve博士在工厂3号线北侧的实验室里。";
		npctalk "不用担心安全装置，它们很容易修复。Ve博士在工厂3号线北侧的实验室里。";
	next;
	mes "[Charleston 1]";
		mes "Ve博士会告诉你一切。快去！";
		npctalk "Ve博士会告诉你一切。快去！";
	emotion 19;
	'ep15_1_mcd01 = 1;
	monster 'map_name$,24,275, "Security Robot", 3127,1, instance_npcname("Charleston 1#0") + "::OnMyMobDead";	// KICK_STEP
	close3;

OnMyMobDead:
	if (mobcount( 'map_name$, instance_npcname("Charleston 1#0") + "::OnMyMobDead" ) < 1) {
		initnpctimer;
		mapannounce 'map_name$, "Charleston 1: Gate 1 has been disarmed. Please move southwest for the next gate.", bc_map, 0xffff00;
	}
	end;
OnTimer1000:
	donpcevent instance_npcname("1gate#1") + "::OnStart";
	stopnpctimer;
	end;
}

1@mcd,120,224,5	script	Charleston 2#0	4_F_CHARLESTON02,{
	cutin "nale04.bmp",0;
	mes "[Charleston 2]";
	mes "#%@EGD&#(@#...";
	emotion 53;
	next;
	mes "- 她发出奇怪的声音，却无法动弹。-";
	close3;
}

1@mcd,116,213,5	script	Dr. Ve#1	4_M_DOCTOR,2,2,{
	if ('ep15_1_mcd01 == 1) {
		mes "- 他正忙着写东西。靠近他就能交谈。";
		close;
	}
	mes "- 他正忙着写东西。你不该打扰他。";
	close;

OnTouch_:
	if (is_party_leader() == false) {
		mes "[Dr. Ve]";
		mes "让我和你的队长谈。我没时间和所有人说话。";
		close;
	}
	if ('ep15_1_mcd01 > 2)
		end;
	if ('ep15_1_mcd01 == 2) {
		mes "[Dr. Ve]";
		mes "我不在乎你和谁一起来的。我只需要知道你能不能帮我。";
		'ep15_1_mcd01 = 2;
		next;
		if (select( "I can help.", "I'm busy." ) == 2) {
			mes "[Dr. Ve]";
			mes "唉，我不在乎是谁，只要能得到需要的帮助就行。";
			npctalk "Ve博士：唉，我不在乎是谁，只要能得到需要的帮助就行。";
			close;
		}
		mes "[Dr. Ve]";
		mes "你就是我们一直等待的救世主！Charleston 1会告诉你修复Charleston 2需要什么。";
		npctalk "Ve博士：你就是我们一直等待的救世主！Charleston 1会告诉你修复Charleston 2需要什么。";
		if ('ep15_1_mcd01 == 2)
			'ep15_1_mcd01 = 3;
		close;
	}
	if ('ep15_1_mcd01 == 1) {
		.@charleston_1$ = instance_npcname("Charleston 1#1");
		mes "[Dr. Ve]";
		mes "Charleston 1，Charleston 2被强行连接到主电脑的一部分，我无法控制她。";
		npctalk "Ve博士：Charleston 1，Charleston 2被强行连接到主电脑的一部分，我无法控制她。";
		next;
		cutin "dalle02.bmp",2;
		mes "[Charleston 1]";
		mes "她是机器人，迟早会停下来。";
		npctalk "Charleston 1：她是机器人，迟早会停下来。", .@charleston_1$;
		next;
		cutin "",255;
		mes "[Dr. Ve]";
		mes "她体内的长寿装置至少能让她运行50年。可是工厂撑不了那么久。";
		npctalk "Ve博士：她体内的长寿装置至少能让她运行50年。可是工厂撑不了那么久。";
		next;
		cutin "dalle01.bmp",2;
		mes "[Charleston 1]";
		mes "那我们别无选择了。幸好有专家和我们在一起。";
		npctalk "Charleston 1：那我们别无选择了。幸好有专家和我们在一起。", .@charleston_1$;
		next;
		select("Are you talking about me?");
		unittalk getcharid(3), "Are you talking about me?";
		mes "[Charleston 1]";
		mes "不久前，Charleston 2正在包装待运产品时，一位名叫^FF0000Shalosh^000000的女士来访。";
		npctalk "Charleston 1：不久前，Charleston 2正在包装待运产品时，一位名叫^FF0000Shalosh^000000的女士来访。", .@charleston_1$;
		next;
		mes "[Charleston 1]";
		mes "事故发生时，Shalosh和她的朋友正在和Charleston 2交谈。";
		npctalk "Charleston 1：事故发生时，Shalosh和她的朋友正在和Charleston 2交谈。", .@charleston_1$;
		next;
		cutin "",255;
		mes "[Dr. Ve]";
		mes "我认为有人试图入侵工厂的主电脑。";
		npctalk "Ve博士：我认为有人试图入侵工厂的主电脑。";
		next;
		cutin "dalle01.bmp",2;
		mes "[Charleston 1]";
		mes "更新过程中，服务器连接被阻塞了。我们追问Shalosh时，";
		npctalk "Charleston 1：更新过程中，服务器连接被阻塞了。我们追问Shalosh时，", .@charleston_1$;
		next;
		mes "[Charleston 1]";
		mes "Shalosh说她的朋友可以帮助我们。于是Newoz和她的其他朋友来了，但她们没帮上什么忙。";
		npctalk "Charleston 1：Shalosh说她的朋友可以帮助我们。于是Newoz和她的其他朋友来了，但她们没帮上什么忙。", .@charleston_1$;
		next;
		mes "[Charleston 1]";
		mes "看来你认识她们。能帮助我们吗？";
		npctalk "Charleston 1：看来你认识她们。能帮助我们吗？", .@charleston_1$;
		if ('ep15_1_mcd01 == 1)
			'ep15_1_mcd01 = 2;
		next;
		if (select( "I can help.", "I don't know them." ) == 2) {
			mes "[Charleston 1]";
			mes "我刚才看到你们在交谈，那我就等别人来帮忙吧！";
			close3;
		}
		unittalk getcharid(3), "I can help.";
		mes "[Charleston 1]";
		mes "非常感谢！给我一点时间整理数据，然后我会告诉你发生了什么。";
		npctalk "Charleston 1：非常感谢！给我一点时间整理数据，然后我会告诉你发生了什么。", .@charleston_1$;
		if ('ep15_1_mcd01 == 2)
			'ep15_1_mcd01 = 3;
		emotion 2, .@charleston_1$;
		close3;
	}
	mes "[Dr. Ve]";
	mes "当电压转换成两条主线并注入核心时……嗯？我没有打扰你的计算吧。";
	npctalk "Ve博士：当电压转换成两条主线并注入核心时……嗯？我没有打扰你的计算吧。";
	close;
}

1@mcd,121,217,4	script	Charleston 1#1	4_F_CHARLESTON01,{
	if (is_party_leader() == false) {
		cutin "dalle01.bmp",2;
		mes "[Charleston 1]";
		mes "请让我和你的队长谈。工厂的未来取决于这次行动能否成功。";
		close3;
	}
	if ('ep15_1_mcd01 > 5)
		end;
	if ('ep15_1_mcd01 == 4) {
		cutin "dalle01.bmp",2;
		mes "[Charleston 1]";
		mes "Steps和Locksteps正在工厂内制造混乱。请先摧毁3个Lockstep。我可以告诉你它们的大概位置。";
		viewpoint 1,84,226,1,0xFF00FF;
		viewpoint 1,126,84,2,0xFF00FF;
		viewpoint 1,111,68,3,0xFF00FF;
		viewpoint 1,210,181,4,0xFF00FF;
		viewpoint 1,183,192,5,0xFF00FF;
		viewpoint 1,130,124,6,0xFF00FF;
		viewpoint 1,54,108,7,0xFF00FF;
		close3;
	}
	if ('ep15_1_mcd01 == 3) {
		cutin "dalle01.bmp",2;
		mes "[Charleston 1]";
		mes "让我解释该怎么做。哦，我先关上工厂入口，免得有什么东西擅自闯进来。";
		npctalk "Charleston 1：让我解释该怎么做。哦，我先关上工厂入口，免得有什么东西擅自闯进来。";
		next;
		mes "[Charleston 1]";
		mes "Charleston配备了许多Nanostep，这是一种能与其他AI芯片有机协作、指挥Charleston正确判断和行动的AI芯片。";
		npctalk "Charleston 1：Charleston配备了许多Nanostep，这是一种能与其他AI芯片有机协作、指挥Charleston正确判断和行动的AI芯片。";
		next;
		mes "[Charleston 1]";
		mes "Charleston的数据必须每天通过实验室的主电脑更新。我们称之为定期维护。";
		npctalk "Charleston 1：Charleston的数据必须每天通过实验室的主电脑更新。我们称之为定期维护。";
		next;
		mes "[Charleston 1]";
		mes "更新程序目前无法工作。我们不知道原因，但Charleston 2连接主电脑时出了问题。";
		npctalk "Charleston 1：更新程序目前无法工作。我们不知道原因，但Charleston 2连接主电脑时出了问题。";
		next;
		mes "[Charleston 1]";
		mes "我告诉Charleston 2她正在进行延长维护，但不知道这种状态会持续多久。";
		npctalk "Charleston 1：我告诉Charleston 2她正在进行延长维护，但不知道这种状态会持续多久。";
		next;
		mes "[Charleston 1]";
		mes "Steps和Locksteps正在工厂内制造混乱。请先摧毁3个Lockstep。我可以告诉你它们的大概位置。";
		npctalk "Charleston 1：Steps和Locksteps正在工厂内制造混乱。请先摧毁3个Lockstep。我可以告诉你它们的大概位置。";
		next;
		mes "[Charleston 1]";
		mes "如果能把它们全部消灭当然最好，但现在我们应该专注于让工厂恢复运行。";
		npctalk "Charleston 1：如果能把它们全部消灭当然最好，但现在我们应该专注于让工厂恢复运行。";
		next;
		mes "[Charleston 1]";
		mes "摧毁太多Steps可能会导致工厂无法重新启动。你应该去咨询左侧的主电脑。";
		npctalk "Charleston 1：摧毁太多Steps可能会导致工厂无法重新启动。你应该去咨询左侧的主电脑。";
		emotion 2;
		if ('ep15_1_mcd01 != 3)
			close3;
		'ep15_1_mcd01 = 4;
		.@label$ = instance_npcname("Charleston 1#1") + "::OnMyMobDead";
		monster 'map_name$, 84,226, "Lockstep", 3126,1, .@label$;	// ROCK_STEP
		monster 'map_name$,126, 84, "Lockstep", 3126,1, .@label$;
		monster 'map_name$,111, 68, "Lockstep", 3126,1, .@label$;
		monster 'map_name$,210,181, "Lockstep", 3126,1, .@label$;
		monster 'map_name$,183,192, "Lockstep", 3126,1, .@label$;
		monster 'map_name$,130,124, "Lockstep", 3126,1, .@label$;
		monster 'map_name$, 54,108, "Lockstep", 3126,1, .@label$;

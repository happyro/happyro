//===== rAthena Script ======================================= 
//= Mr. Smile Quest
//===== By: ================================================== 
//= kobra_k88, Akaru
//===== Current Version: ===================================== 
//= 1.4a
//===== Compatible With: ===================================== 
//= rAthena Project
//===== Description: ========================================= 
//= [Official Conversion]
//= Trade Clover, Fluff and Jellopy for a Mr. Smile mask.
//===== Additional Comments: ================================= 
//= 1.4 Rescripted to Aegis 10.3 standards. [L0ne_W0lf]
//= 1.4a Fixed a little Typo error in duplicates. (bugreport:749) [Samuray22]
//============================================================ 

-	script	Smile Assistance::SmileHelper	92,{
	mes "[微笑女孩]";
	mes "嗨～嗨～";
	mes "这里是微笑助手。";
	mes "我能帮你什么吗？";
	next;
	switch(select("^3355FF微笑先生^000000？:制作 ^3355FF微笑先生^000000:退出")) {
	case 1:
		mes "[微笑女孩]";
		mes "这是^5577FF特里斯坦三世陛下^000000下令举办的全国活动，";
		mes "旨在鼓励卢恩·米德加尔兹王国的国民";
		mes "在更加愉快的氛围中游戏！";
		mes "我是^3355FF‘微笑助手’^000000，";
		mes "负责以";
		mes "^3355FF微笑^000000之名领导整个王国的活动～";
		next;
		mes "[微笑女孩]";
		mes "只要一些简单易得的物品，";
		mes "我就能为你提供";
		mes "^3355FF‘微笑先生’^000000。";
		mes "所需物品如下。";
		next;
		mes "[Smile Girl]";
		mes "^3355FF10 个杰勒比^000000";
		mes "^3355FF10 个毛^000000";
		mes "^3355FF10 叶子^000000";
		next;
		mes "[微笑女孩]";
		mes "通过这项活动，";
		mes "大家都会开心地微笑，";
		mes "与其他人一起聚会，";
		mes "努力让仙境传说成为世界上最有趣的游戏。";
		close;
	case 2:
		if (countitem(909) > 9 && countitem(914) > 9 && countitem(705) > 9) {
			mes "[微笑女孩]";
			mes "恭喜你！";
			mes "请收下这个微笑先生。";
			next;
			delitem 909,10; //Jellopy
			delitem 914,10; //Fluff
			delitem 705,10; //Clover
			getitem 2278,1; //Mr_Smile
			mes "[微笑女孩]";
			mes "特里斯坦三世陛下";
			mes "承诺会尽最大努力让仙境传说变得更好、更有趣。";
			next;
			mes "以上内容";
			mes "由卢恩·米德加尔兹王国";
			mes "公共信息局公布。";
			close;
		}
		else {
			mes "[微笑女孩]";
			mes "哦……很遗憾，";
			mes "你带来的物品";
			mes "还不足以制作微笑先生。";
			mes "^3355FF10 个杰勒比^000000";
			mes "^3355FF10 个毛^000000";
			mes "^3355FF10 叶子^000000";
			mes "请确认上面的要求。";
			close;
		}
	case 3:
		mes "[微笑女孩]";
		mes "谢谢你来找我们。";
		mes "我们……";
		mes "卢恩·米德加尔兹王国";
		mes "一直努力让仙境传说";
		mes "成为更好、更有趣的游戏。";
		next;
		mes "[微笑女孩]";
		mes "我们诚恳地请求你";
		mes "配合活动。";
		mes "以上内容";
		mes "由卢恩·米德加尔兹王国公共信息局公布。";
		close;
	}
}

// Additional Smile Assistance staff
alberta,113,53,4	duplicate(SmileHelper)	Smile Assistance#alb	92
aldebaran,136,135,4	duplicate(SmileHelper)	Smile Assistance#alde	92
geffen,119,107,4	duplicate(SmileHelper)	Smile Assistance#gef	92
moc_ruins,59,154,3	duplicate(SmileHelper)	Smile Assistance#moc	92
payon,186,104,5	duplicate(SmileHelper)	Smile Assistance#pay	92
prontera,157,187,4	duplicate(SmileHelper)	Smile Assistance#prt	92


//= sabernet09
//===== Current Version: ===================================== 
//= 1.1
//===== Compatible With: ===================================== 
//= rAthena Project
//===== Description: ========================================= 
//= 1.1 Removed it from offical Umbala Quests [Lupus]
//============================================================ 

prontera,145,290,5	script	Mason	742,{
	mes "[Mason]";
	if(umb_lang==0) goto L_NOT_GOT_QUEST;
	if(umb_lang==2 || umb_mason==1) goto L_AGAIN;

	mes "你好，我来普隆德拉寻找一位能从装备槽中取出卡片的老太太。你知道在哪里能找到她吗？";
	menu "Yes",-, "No",M_NO;

	mes "哦哦，你能告诉我她在哪里吗？我会非常感激。";
	menu "Swordsman Association",-, "Sanctuary",M_Boo1,"Prontera Chivalry",M_Boo2,"Trading Post",M_Boo3,"Kit Shop",M_Boo4,"Inn",M_Boo5,"Armory",M_DONE,"Library",M_Boo6,"Job Agency",M_Boo7,"Prontera Castle",M_Boo8,"City Hall",M_Boo9;

	next;
	mes "[Mason]";
	mes "嗯……不知道她为什么会在那里……我去看看吧。";
	close;
M_Boo1:
	next;
	mes "[Mason]";
	mes "哇，我从不知道她是虔诚的人……谢谢，我会去看看的。";
	close;
M_Boo2:
	next;
	mes "[Mason]";
	mes "嗯……你确定吗？";
	close;
M_Boo3:
	next;
	mes "[Mason]";
	mes "她为什么要去那里？我觉得你可能弄错了。";
	close;
M_Boo4:
	next;
	mes "[Mason]";
	mes "她去药品店只会是为了买风湿药。现在她可能早就离开那里了。";
	close;
M_Boo5:
	next;
	mes "[Mason]";
	mes "我不认为她需要去那里，她就住在普隆德拉。";
	close;
M_Boo6:
	next;
	mes "[Mason]";
	mes "啊，我明白了。如果她在学习，我就不打扰她了。还是谢谢你。";
	close;
M_Boo7:
	next;
	mes "[Mason]";
	mes "职业介绍所？我不这么认为。请别带着我在普隆德拉到处跑！她已经是这里的老师了。";
	close;
M_Boo8:
	next;
	mes "[Mason]";
	mes "城堡吗？我不想进去……那不太适合我。我不喜欢那种贵族式的权威感。";
	close;
M_Boo9:
	next;
	mes "[Mason]";
	mes "哦，她已经成为普隆德拉的重要人物了吗？看来她太忙了，没空见我。我稍后再试。";
	close;
M_DONE:
	next;
	mes "[Mason]";
	mes "啊，我听说她的教室就在那附近……非常感谢！这是给你的谢礼。";
	getitem 7117,1;//Items: Torn Spell Book,
	set umb_mason,1;
	close;

L_AGAIN:
	emotion ET_THANKS;
	mes "耶，我找到她了！非常感谢你的帮助！";
	close;

L_NOT_GOT_QUEST:
	mes "嗨！我来普隆德拉寻找一位老太太……但是……";
	close;
M_NO:
	mes "哦……好吧……还是谢谢你。";
	close;
}

aldebaran,153,212,1	script	Mojo	740,{
	mes "[Mojo]";
	if(umb_lang!=1) goto L_NOT_GOT_QUEST;
	mes "糟糕！我弄丢了老师的^FF0000旧魔法书^000000！";
	mes "我该怎么办……都是那些笨巴风特……";
	if(umb_lang==1) set umb_mojo,1;
	close;
L_NOT_GOT_QUEST:
	emotion ET_QUESTION;
	mes "我弄丢了老师的书！我该怎么办……";
	close;
}

amatsu,267,189,4	script	Marie	744,{
	mes "[Marie]";
	if(umb_lang==0) goto L_NOT_GOT_QUEST;
	if(umb_lang==2 || umb_marie==1) goto L_AGAIN;
	if(countitem(9001)>0 && countitem(643)>0) goto L_DONE;//Items: Poring Egg, Pet Incubator,
	mes "你好，需要什么吗？";
	next;
	menu "No nothing at all.",M_NO,"Your teacher sent me.",-;

	mes "[Marie]";
	mes "他想从我这里得到什么？";
	emotion ET_QUESTION;
	next;
	mes "[Marie]";
	mes "等等，我明白了……他想要回参考卷轴，对吗？我还在使用它，不过……如果你能给我一个波利蛋和孵化器，我就还给你。那些东西太可爱了！";
	close;

L_NOT_GOT_QUEST:
	emotion ET_QUESTION;
	mes "嗨！你想从我这里得到什么？";
	close;

M_NO:
	mes "[Marie]";
	mes "嗯……好吧？那再见……";
	close;

L_DONE:
	mes "嘿，你带来了波利蛋和宠物孵化器！这是给我的吗？";
	menu "Yep!",-, "Sorry, no.",M_DOH;

	mes "[Marie]";
	if(countitem(9001)==0 && countitem(643)==0) goto M_DOH;//Items: Poring Egg, Pet Incubator,
	mes "太好了！这是给你的回礼。";
	delitem 9001,1;//Items: Poring Egg,
	delitem 643,1;//Items: Pet Incubator,
	getitem 7118,1;//Items: Torn Scroll,
	set umb_marie,1; //got Torn Scroll
	close;

M_DOH:
	mes "哦……波利……唉……";
	close;

L_AGAIN:
	emotion ET_THANKS;
	mes "耶！我喜欢波利！";
	close;
}

yuno,157,366,2	script	Wise Man Fabius	743,{
	mes "[Fabius]";
	if(event_umbala >= 3) set umb_lang,2; //You already learned Umbalian language from Umbalian Chief. So this Quest is disabled
	if(umb_lang<2) goto L_QUEST;
	mes "你已经能流利地说乌姆巴拉语了！这样就永远不会忘记乌姆巴拉人的语言！";
	close;
L_QUEST:
	if((countitem(1006) < 1) || (countitem(7118) < 1) || (countitem(7117) < 1)) goto L_DONE;//Items: Old Magic Book, Torn Scroll, Torn Spell Book,
	delitem 1006,1;	//Items: Old Magic Book,
	delitem 7118,1;	//Items: Torn Scroll,
	delitem 7117,1;//Items: Torn Spell Book,
	emotion ET_THANKS;
	mes "啊，你很好地取回了我的参考资料。这些文物记录着世界各地遗迹的信息，从熔岩地牢的燃烧地狱，到诡异的世界树隐藏森林。";
	next;
	mes "[Fabius]";
	mes "闲话少说，你已经迫不及待想要奖励了吧？虽然听起来不多，但我的奖励是知识……";
	next;
	mes "[Fabius]";
	mes "是关于乌姆巴拉人的知识。他们以某种特殊方式与米德加尔特相连，只是我们还无法确认。有理论认为他们像精灵一样守护着古老的世界树。";
	next;
	mes "[Fabius]";
	mes "而我，朱诺的伟大学者，将教你他们的语言！";
	next;
	mes "^0000FF 你学会了乌姆巴拉人的语言！^000000";
	set umb_lang,2;
	//clear subquests
	set umb_marie,0;
	set umb_mason,0;
	set umb_mojo,0;
	//make you understand Umbalian people
	//it's an alternative way to learn Umbalian Language
	if(event_umbala < 3) set event_umbala,3;
	close;
L_DONE:
	set umb_lang,1; //got Quest
	mes "啊！我的三个学生带着参考资料跑掉了！喂，你能帮我找回来吗？我会给你丰厚奖励。";
	next;
	mes "[Fabius]";
	mes "据我所知，他们在不同城镇努力闯出自己的事业。";
	if(umb_marie==0 && umb_mason==0 && umb_mojo==0) goto L_NOT_MET;
	if(umb_marie==1) mes "哦……你在天津找到了玛丽。";
	if(umb_mojo==1) mes "你在艾尔贝塔见到了莫乔？";
	if(umb_mason==1) mes "所以……梅森现在在普隆德拉……嗯……";
	if(umb_marie==0) mes "我们的海姑娘玛丽在哪里呢？";
	if(umb_mojo==0) mes "莫乔应该在水边……";
	if(umb_mason==0) mes "那么梅森去哪儿了……";
	mes "对了，告诉他们是我派你去的。";
	close;
L_NOT_MET:
	mes "对了，告诉他们是我派你去的，他们的名字是玛丽、梅森和莫乔。";
	close;
}

		next;
		mes "就这些。文字化作红色钥匙飞走了……";
		set thana_tower, 5;
		changequest 7048,7049;
		specialeffect2 EF_COMBOATTACK1;
		close;
	}
}

tha_t04,195,195,0	script	Rune Device#tt2	111,3,3,{
	if ((countitem(7422) == 0) && (countitem(7427) == 0)) {
		mes "^3355FF你发现一块屏幕，下方有三个小面板和数字键盘。按下数字键时，屏幕启动并发出哔声。^000000";
		next;
		mes "[Screen]";
		mes "请输入三位数字。数字不能重复，也不能使用数字 0。";
		next;
		while (1) {
			set .@yagu100, rand(1,9);
			set .@yagu10, rand(1,9);
			set .@yagu1, rand(1,9);
			if (((.@yagu100 != .@yagu10) && (.@yagu100 != .@yagu1)) && (.@yagu10 != .@yagu1))
				break;
		}
		while (1) {
			while (1) {
				input .@input;
				if (.@input < 100 || .@input > 999) {
					mes "[Screen]";
					mes "数字输入条件不满足。请输入三位数字。";
					close;
				}
				set .@input100, .@input / 100;
				set .@input10, (.@input % 100) / 10;
				if (((.@input100 > 0) && (.@input10 > 0)) && (.@input % 10 > 0)) {
					if (((.@input100 != .@input10) && (.@input100 != .@input % 10)) && (.@input10 != .@input % 10))
						break;
					mes "[Screen]";
					mes "违反数字输入规则。输入了数字 0，或某个数字重复出现。";
					next;
				}
			}
			set .@retry, .@retry + 1;
			mes "[Screen]";
			mes "你输入了……";
			mes "^0000ff" + .@input100 + "^000000, ^0000ff" + .@input10 + "^000000, ^0000ff" + (.@input % 10) + "^000000";
			mes " ";
			mes "正在计算结果……请稍候……";
			next;
			set .@strike, 0;
			set .@ball, 0;
			if (.@yagu100 == .@input100) set .@strike, .@strike + 1;
			if (.@yagu10 == .@input10) set .@strike, .@strike + 1;
			if (.@yagu1 == .@input % 10) set .@strike, .@strike + 1;
			if ((.@yagu100 == .@input10) || (.@yagu100 == .@input % 10)) set .@ball, .@ball + 1;
			if ((.@yagu10 == .@input100) || (.@yagu10 == .@input % 10)) set .@ball, .@ball + 1;
			if ((.@yagu1 == .@input100) || (.@yagu1 == .@input10)) set .@ball, .@ball + 1;
			if (.@strike == 3) {
				mes "[Screen]";
				mes "输入数字正确。访问授权。";
				next;
				mes "^3355FF屏幕显示访问授权通知后，魔力凝聚并出现在表面。一个物体形成了……^000000";
				next;
				mes "^4d4dff强大的黄色钥匙出现了。^000000";
				getitem 7422,1; //Key_Yellow
				if (thana_tower != 5) close;
				mes "^4d4dff强烈的感觉穿过你的头脑。你看见光的幻象，就像获得第一把钥匙时一样。^000000";
				next;
				switch(select("忽略它。:集中精神。")) {
				case 1:
					mes "你决定忽略它。";
					close;
				case 2:
					mes "你集中于光芒。文字开始出现……";
					next;
					mes "^b22222你找到第二把钥匙了吗？我想告诉你封印在哪里，但不会轻易揭示。提示：去五楼的鹰那里。";
					next;
					mes "^b22222我来到这里的原因是……寻找某个人。我们人类无法理解这一点……";
					next;
					mes "^b22222我在朱佩洛斯找到她时，无法放松。洞穴深处与她在一起的巨大男人，让我匆忙结束调查……";
					next;
					mes "^b22222确认她存在后，我盲目地执着于寻找她的踪迹。";
					mes "你问‘她’是谁？她的外形像个女人……";
					next;
					mes "^b22222我跟随着她的踪迹，却不知道她十年前就已存在。然后我来到了这里。";
					next;
					mes "^b22222This tower set up for...^000000";
					next;
					mes "它突然震动，然后消失了。";
					set thana_tower, 6;
					changequest 7049,7050;
					specialeffect2 EF_COMBOATTACK1;
					close;
				}
			}
			else {
				mes "[Screen]";
				mes "*哔——* 数字序列未授权。";
				next;
				mes "[Screen]";
				mes "数字位置正确总数：^FF0000" + .@strike + "^000000";
				mes " ";
				mes "正确数字总数：^FF0000" + .@ball + "^000000";
				next;
				if (.@retry > 4) {
					mes "[Screen]";
				mes "正确的数字授权序列是……";
					mes "^ff0000" + .@yagu100 + "^000000, ^ff0000" + .@yagu10 + "^000000, ^ff0000" + .@yagu1 + "^000000";
				mes "重试后授权数字会改变。";
					close;
				}
			}
		}
	}
		mes "你已经从这个符文装置取得了所需的一切。";
	close;

OnTouch_:
	if ((countitem(7422) == 0) && (countitem(7427) == 0))
		specialeffect EF_LEVEL99_4;
	end;
}

tha_t05,62,179,0	script	Brilliant Statue#tt3	111,3,3,{
	if ((countitem(7423) == 0) && (countitem(7428) == 0)) {
		mes "我能从这座美丽的石像中感受到魔力。翅膀之间有一道小裂缝。";
		next;
		mes "红光照在左翼的裂缝上，金光照在右翼的裂缝上。你要做什么？";
		next;
		if(select("把钥匙插进裂缝……:忽略它。") == 2) {
			mes "^3355FF你决定不去碰这座石像。^000000";
			close;
		}
		if ((countitem(7421) > 0) && (countitem(7422) > 0)) {
			mes "["+strcharinfo(0)+"]";
			mes "我先试试左翼。应该插入哪把钥匙？";
			next;
			input .@inputstr$;
			if ((.@inputstr$ != "Red Key") && (.@inputstr$ != "red key")) {
				mes "它无法插入裂缝。";
				close;
			}
			mes "钥匙正好插入并发出咔嗒声。你感觉魔力变得更强了……";
			next;
			mes "["+strcharinfo(0)+"]";
			mes "现在是右边……";
			next;
			input .@inputstr$;
			if ((.@inputstr$ != "Yellow Key") && (.@inputstr$ != "yellow key")) {
				mes "它无法插入裂缝。";
				close;
			}
			mes "钥匙正好插入并发出咔嗒声。";
			mes "鸟嘴突然张开，强光从中射出。里面有一个钥匙形状的物体……";
			next;
			mes "^4d4dffThe powerful Blue Key appears.^000000";
			getitem 7423,1; //Key_Blue
			if (thana_tower != 6) close;
			mes "^4d4dff你拿起钥匙后，一阵震撼的感觉穿过头脑。你看见光的幻象……^000000";
			next;
			switch(select("集中精神。:忽略它。")) {
			case 1:
				mes "这一部分不像之前那么清晰。你试着弄清它在说什么……";
				next;
				mes "^b22222……这座塔由魔法族而非人类建造。这让我很感兴趣……我开始调查他们为何建造这座塔……";
				next;
				mes "^b22222我发现这座塔曾是千年战争期间魔法族的门户。^000000";
				next;
				mes ".........It's not clearly shown......";
				mes "^b22222……千年战争结束后，梦罗克通过这扇门从魔法世界来到米德加尔特大陆……";
				next;
				mes "^b22222问题在于，她来到这里时，撒旦也同时出现了……真相是……^000000";
				next;
				mes "幻象摇晃，然后化作光融入钥匙表面。";
				set thana_tower, 7;
				changequest 7050,7051;
				specialeffect2 EF_COMBOATTACK1;
				close;
			case 2:
				mes "你决定忽略它。";
				close;
			}
		}
		mes "你试着把东西插入裂缝，但没有用。";
		close;
	}
	mes "你已经从这座石像取得了所需的一切。";
	close;

OnTouch_:
	if ((countitem(7423) == 0) && (countitem(7428) == 0))
		specialeffect EF_LEVEL99_4;
	end;
}

tha_t06,226,230,0	script	Brilliant Statue#tt4	111,3,3,{
	if ((countitem(7424) == 0) && (countitem(7429) == 0)) {
		mes "我能从这座闪耀的石像中感受到魔力。这一定是封印之一。";
		next;
		mes "你看见一个带孔的漂浮圆形物体。红、黄、蓝三色光依次排列。你要做什么？";
		next;
		if(select("调查。:忽略它。") == 2) {
			mes "^3355FF如果没有异常或奇怪之处，你觉得没必要调查……^000000";
			close;
		}
		if ((countitem(7421) > 0) && (countitem(7422) > 0) && (countitem(7423) > 0)) {
		mes "当你把钥匙插入装饰物的钥匙孔并按颜色对应，石像啪地打开了。你看见里面的小齿轮正在转动。";
			next;
		switch(select("调查机器外壳:调查齿轮:取消")) {
			case 1:
			mes "^3355FF你物品栏里的钥匙似乎没有影响机器外壳。侧面的屏幕仍是一片空白，没有启动。^000000";
				close;
			case 2:
				set .@small_1, 0;
				set .@small_2, 0;
				set .@big_1, 0;
				set .@big_2, 0;
				set .@big_3, 0;
			mes "^3355FF你触摸齿轮，发现它们其实转得很慢。你注意到有 2 个小齿轮和 3 个大齿轮，这台机器共有 5 个齿轮。^000000";
				next;
			mes "^3355FF大齿轮上下垂直移动，压住小齿轮使其旋转。^000000";
				next;
			mes "^3355FF从机器的震动和抖动声来看，齿轮可能没有对齐。正确调整所有齿轮，也许就能启动机器。^000000";
				while (1) {
					next;
					mes "^3355FF你想调整哪个齿轮？^000000";
					switch(select("第一个小齿轮:第二个小齿轮:第一个大齿轮:第二个大齿轮:第三个大齿轮:查看当前齿轮配置:重置为默认配置")) {
					case 1:
						switch(select("升高齿轮:降低齿轮:按压齿轮")) {
						case 1:
							mes "^EE0000*Choom*^000000";
							set .@small_1, 2;
							if ((.@small_1 == 2) && (.@small_2 == 2) && (.@big_1 == 2) && (.@big_2 == 2) && (.@big_3 == 2)) break;
							continue;
						case 2:
							mes "^00B2EE*Sneeeep*^000000";
							set .@small_1, 1;
							if ((.@small_1 == 1) && (.@small_2 == 1) && (.@big_1 == 1) && (.@big_2 == 1) && (.@big_3 == 1)) break;
							continue;
						case 3:
							mes "^5C246E*Mrreeem*^000000";
							set .@small_1, 3;
							if ((.@small_1 == 3) && (.@small_2 == 3) && (.@big_1 == 3) && (.@big_2 == 3) && (.@big_3 == 3)) break;
							continue;
						}
						break;
					case 2:
						switch(select("升高齿轮:降低齿轮:按压齿轮")) {
						case 1:
							mes "^5C246E*Mrreeem*^000000";
							set .@small_2, 3;
							if ((.@small_1 == 3) && (.@small_2 == 3) && (.@big_1 == 3) && (.@big_2 == 3) && (.@big_3 == 3)) break;
							continue;
						case 2:
							mes "^EE0000*Choom*^000000";
							set .@small_2, 2;
							if ((.@small_1 == 2) && (.@small_2 == 2) && (.@big_1 == 2) && (.@big_2 == 2) && (.@big_3 == 2)) break;
							continue;
						case 3:
							mes "^00B2EE*Sneeeep*^000000";
							set .@small_2, 1;
							if ((.@small_1 == 1) && (.@small_2 == 1) && (.@big_1 == 1) && (.@big_2 == 1) && (.@big_3 == 1)) break;
							continue;
						}
						break;
					case 3:
						switch(select("升高齿轮:降低齿轮:垂直移动齿轮")) {
						case 1:
							mes "^00B2EE*Sneeeep*^000000";
							set .@big_1, 1;
							if ((.@small_1 == 1) && (.@small_2 == 1) && (.@big_1 == 1) && (.@big_2 == 1) && (.@big_3 == 1)) break;
							continue;
						case 2:
							mes "^5C246E*Mrreeem*^000000";
							set .@big_1, 3;
							if ((.@small_1 == 3) && (.@small_2 == 3) && (.@big_1 == 3) && (.@big_2 == 3) && (.@big_3 == 3)) break;
							continue;
						case 3:
							mes "^EE0000*Choom*^000000";
							set .@big_1, 2;
							if ((.@small_1 == 2) && (.@small_2 == 2) && (.@big_1 == 2) && (.@big_2 == 2) && (.@big_3 == 2)) break;
							continue;
						}
						break;
					case 4:
						switch(select("升高齿轮:降低齿轮:垂直移动齿轮")) {
						case 1:
							mes "^EE0000*Choom*^000000";
							set .@big_2, 2;
							if ((.@small_1 == 2) && (.@small_2 == 2) && (.@big_1 == 2) && (.@big_2 == 2) && (.@big_3 == 2)) break;
							continue;
						case 2:
							mes "^5C246E*Mrreeem*^000000";
							set .@big_2, 3;
							if ((.@small_1 == 3) && (.@small_2 == 3) && (.@big_1 == 3) && (.@big_2 == 3) && (.@big_3 == 3)) break;
							continue;
						case 3:
							mes "^00B2EE*Sneeeep*^000000";
							set .@big_2, 1;
							if ((.@small_1 == 1) && (.@small_2 == 1) && (.@big_1 == 1) && (.@big_2 == 1) && (.@big_3 == 1)) break;
							continue;
						}
						break;
					case 5:
						switch(select("升高齿轮:降低齿轮:垂直移动齿轮")) {
						case 1:
							mes "^EE0000*Choom*^000000";
							set .@big_3, 2;
							if ((.@small_1 == 2) && (.@small_2 == 2) && (.@big_1 == 2) && (.@big_2 == 2) && (.@big_3 == 2)) break;
							continue;
						case 2:
							mes "^00B2EE*Sneeeep*^000000";
							set .@big_3, 1;
							if ((.@small_1 == 1) && (.@small_2 == 1) && (.@big_1 == 1) && (.@big_2 == 1) && (.@big_3 == 1)) break;
							continue;
						case 3:
							mes "^5C246E*Mrreeem*^000000";
							set .@big_3, 3;
							if ((.@small_1 == 3) && (.@small_2 == 3) && (.@big_1 == 3) && (.@big_2 == 3) && (.@big_3 == 3)) break;
							continue;
						}
						break;
					case 6:
						if (.@small_1 == 0) mes "1st Small Wheel: No Change";
						else if (.@small_1 == 1) mes "1st Small Wheel: Down";
						else if (.@small_1 == 2) mes "1st Small Wheel: Up";
						else mes "1st Small Wheel: Pressed";

						if (.@small_2 == 0) mes "2nd Small Wheel: No Change";
						else if (.@small_2 == 1) mes "2nd Small Wheel: Pressed";
						else if (.@small_2 == 2) mes "2nd Small Wheel: Down";
						else mes "2nd Small Wheel: Up";

						if (.@big_1 == 0) mes "1st Big Wheel: No Change";
						else if (.@big_1 == 1) mes "1st Big Wheel: Up";
						else if (.@big_1 == 2) mes "1st Big Wheel: Moved";
						else mes "1st Big Wheel: Down";

						if (.@big_2 == 0) mes "2nd Big Wheel: No Change";
						else if (.@big_2 == 1) mes "2nd Big Wheel: Moved";
						else if (.@big_2 == 2) mes "2nd Big Wheel: Up";
						else mes "2nd Big Wheel: Down";

						if (.@big_3 == 0) mes "3rd Big Wheel: No Change";
						else if (.@big_3 == 1) mes "3rd Big Wheel: Down";
						else if (.@big_3 == 2) mes "3rd Big Wheel: Up";
						else mes "3rd Big Wheel: Moved";
						continue;
					case 7:
						set .@small_1, 0;
						set .@small_2, 0;
						set .@big_1, 0;
						set .@big_2, 0;
						set .@big_3, 0;
						continue;
					}
					break;
				}
				mes "你调整齿轮时，它们突然启动，发出清脆的咔嗒声。";
				next;
				mes "石像中的一部分装饰开始旋转，明亮光束沿着优雅的石像上升。强大的诅咒之力出现，发出耀眼的绿光。";
				specialeffect EF_DISPELL;
				specialeffect EF_POTION6;
				next;
				mes "^4d4dff突然，绿色钥匙出现了，你能感受到其中强大的力量。^000000";
				getitem 7424,1; //Key_Green
				if (thana_tower != 7) close;
				mes "^4d4dff你拿起钥匙时，身体因未知力量而颤抖，看见带有文字的幻象。^000000";
				next;
				switch(select("集中精神。:忽略它。")) {
				case 1:
					mes "^b22222……你找到四把钥匙，终于释放了四道魔法……这座塔曾是很久以前召唤恶魔的门户。最后一位访客是臭名昭著的撒旦梦罗克。";
					next;
					mes "^b22222沿着她的踪迹，我发现她的魔法散落在塔中。然后不知为何，它们消失在地面里。";
					next;
					mes "^b22222伟大的战斗与漫长的战争……但她的目的……是封印门户……所以我试着封印……却并不完整……门户的守卫是……^000000";
					next;
					mes "["+strcharinfo(0)+"]";
					mes "很难读懂。";
					next;
					mes "^b22222……所以我改变了连接点的位置……我是说，穿过塔去缠住它……无论如何，我想尊重她的忠诚，封锁门户……";
					next;
					mes "^b22222如果我想……就必须释放最后一道魔法……他终于来相见……带着他的碎片……然后……^000000";
					next;
				mes "幻象摇晃着融入钥匙。";
					set thana_tower, 8;
					changequest 7051,7052;
					specialeffect2 EF_BEGINSPELL6;
					specialeffect2 EF_SPELLBREAKER;
					close;
				case 2:
				mes "幻象太强烈了，你放弃了阅读。";
					close;

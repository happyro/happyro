airplane,31,77,5	script	Drunken Man#ein	853,{
	if (Shinokas_Quest == 8) {
		mes "[Drunken Man]";
		mes "好，好……";
		mes "爸爸这次";
		mes "一定会赢到苹果！";
		next;
		mes "[Drunken Man]";
		mes "开始吧！";
		mes "^3131FF伊米尔之心^000000正在";
		mes "站在我这边！冲啊！";
		emotion ET_GO;
		next;
		mes "["+strcharinfo(0)+"]";
		mes "嗯……？";
		mes "他刚才说了什么？";
		mes "听起来很重要！";
		next;
		mes "^3355FF*Rolling and rumbling*^000000";
		next;
		emotion ET_CHUP;
		mes "[Kaci]";
		mes "我的总数是 ^FF000011^000000，";
		mes "而你总数是 ^FF00005^000000。";
		mes "你输了这局。抱歉，";
		mes "希望以后再玩。";
		next;
		mes "[Drunken Man]";
		mes "哇啊啊啊啊啊啊！";
		mes "苹果！我的苹果！";
		mes "苹果，我还需要更多……！";
		if (countitem(512) < 11) {
			close;
		}
		else if ((countitem(512) > 10) && (countitem(512) < 100)) {
			next;
			mes "["+strcharinfo(0)+"]";
			mes "你想要";
			mes "我的一些吗？";
			next;
			mes "[Drunken Man]";
			mes "什么……？";
			mes "这么少的苹果";
			mes "什么也玩不了！";
			mes "我是豪赌客，";
			mes "这是高风险游戏！";
			close;
		}
		else {
			delitem 512,countitem(512); //Apple
			next;
			mes "["+strcharinfo(0)+"]";
			mes "你想要";
			mes "我的一些吗？";
			next;
			mes "[Drunken Man]";
			mes "什——？好……";
			mes "当然！给我";
			mes "一些你的苹果！";
			mes "耶————————！";
			mes "我回来了，宝贝！";
			next;
			mes "[Drunken Man]";
			mes "现在，赢给他们看！";
			mes "爸爸需要爱……";
			mes "是时候从糟糕变高级了！";
			next;
			mes "^3355FF*滚动与轰鸣*^000000";
			next;
			if (rand(1,10) > 7) {
				emotion ET_CHUP;
				mes "[Kaci]";
				mes "我的总数是 ^FF00008^000000，";
				mes "而你总数是 ^FF000011^000000。";
				mes "恭喜，你赢了！";
				mes "我把奖金给你，";
				mes "以后再来玩吧~";
				next;
			}
			else {
				emotion ET_HUK;
				mes "[Kaci]";
				mes "哦哦……";
				mes "我总数是 ^FF000010^000000，";
				mes "而你总数是 ^FF00007^000000。";
				mes "抱歉，你又输了。";
				mes "下次好运……";
				next;
				mes "[Drunken Man]";
				mes "哇啊啊啊啊啊啊啊！";
				mes "哇啊啊啊啊啊啊！";
				close;
			}
		}
		mes "[Drunken Man]";
		mes "哇哈哈哈哈哈哈！";
		mes "哇哈哈哈哈哈哈哈哈！";
		mes "所以他们叫我";
		mes "“复活小子！”";
		mes "我总会回来的！";
		next;
		mes "[Drunken Man]";
		mes "哦，对了！";
		mes "你……！你借给我";
		mes "那些幸运苹果。^333333*打嗝*^000000";

		mes "[Shinokas]";
		mes "那么，你从 Kapellthaine 先生那里";
		mes "找到什么了吗？";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "嗯，Kapellthaine 先生";
		mes "有点暴力，但我没发现";
		mes "什么真正可疑的东西。";
		next;
		mes "[Shinokas]";
		mes "嗯……";
		mes "看来是我错了……";
		mes "还可能在哪里呢？";
		next;
		mes "[Shinokas]";
		mes "哦，对了！艾因布罗赫的";
		mes "巨大工厂！";
		mes "还有什么比它更可疑？";
		mes "那里有很多工人，";
		mes "但没人真正知道他们在做什么……";
		next;
		mes "[Shinokas]";
		mes "如果他们如此神秘，";
		mes "很可能把矿石藏在那里。";
		mes "请尽快去工厂";
		mes "寻找那些矿石。";
		changequest 2074,2075;
		set Shinokas_Quest,6;
		close;
	}
	else if (Shinokas_Quest == 6) {
		if (EinFactory > 12) {
			mes "[Shinokas]";
			mes "那么……？";
			mes "你在工厂";
			mes "发现新东西了吗？";
			next;
			mes "["+strcharinfo(0)+"]";
			mes "嗯……";
			mes "工厂里有很多";
			mes "可疑的事情，";
			mes "但我觉得都和";
			mes "你说的矿石无关。";
			next;
			mes "[Shinokas]";
			mes "该死……";
			mes "那他们把它藏在哪里？";
			mes "你觉得矿石";
			mes "可能在哪里？";
			next;
			switch(select("Airport:Factory:Train Station:Airship Repairshop:Laboratory")) {
			case 1:
				mes "[Shinokas]";
				mes "不……";
				mes "机场总是人来人往。";
				mes "把这么重要的东西藏在";
				mes "那种地方不是好主意。";
				close;
			case 2:
				mes "[Shinokas]";
				mes "你不是刚检查过工厂吗？";
				mes "你在那里";
				mes "没找到矿石的线索……";
				close;
			case 3:
				mes "[Shinokas]";
				mes "嗯……";
				mes "火车站总有人进进出出。";
				mes "那里不是藏这种重要矿石的好地方。";
				close;
			case 4:
				mes "[Shinokas]";
				mes "飞艇？嗯，它确实";
				mes "靠某种神秘力量飞行……";
				mes "但我已经亲自检查过";
				mes "飞艇修理厂。";
				mes "那里没有矿石的踪迹。";
				close;
			case 5:
				mes "[Shinokas]";
				mes "...!";
				mes "对。对……！";
				mes "可能就是那里！";
				mes "我怎么没想到";
				mes "实验室？";
				mes "这太合理了！";
				next;
				mes "[Shinokas]";
				mes "我有种预感。";
				mes "请潜入那个实验室，";
				mes "看看能否找到矿石！";
				next;
				mes "[Shinokas]";
				mes "记住……";
				mes "不是任何人都能进入";
				mes "那种地方。";
				mes "但我相信你会想办法。";
				changequest 2075,2076;
				set Shinokas_Quest,7;
				close;
			}
		}
		else {
			mes "[Shinokas]";
			mes "我确实没立场要求你，";
			mes "也不是故意为难你，";
			mes "但能请你";
			mes "再去工厂";
			mes "检查一次矿石的踪迹吗？";
			close;
		}
	}
	else if (Shinokas_Quest == 9) {
		mes "["+strcharinfo(0)+"]";
		mes "Shinokas，";
		mes "我找到东西了！";
		next;
		mes "[Shinokas]";
		mes "你……";
		mes "回来了……";
		mes "即使……";
		mes "已经……太迟了。";
		mes "^333333*Cough Cough*^000000";
		next;
		mes "^3355FFYou help Shinokas";
		mes "你想坐起来，却发现";
		mes "双手";
		mes "沾满了他的血。^000000";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "血……？！";
		mes "Shinokas！";
		mes "谁对你做了这种事？";
		mes "我、我们得呼救！";
		next;
		mes "[Shinokas]";
		mes "不……";
		mes "对我来说已经";
		mes "太迟了。";
		mes "我早就该死了……";
		next;
		mes "[Shinokas]";
		mes "^333333*Cough*^000000";
		mes "我唯一遗憾的是";
		mes "一直没能向";
		mes "朋友道歉……^333333*咳！*^000000";
		next;
		mes "[Shinokas]";
		mes "但是你查到了吗？";
		mes "你、你找到了吗？";
		mes "你查到那矿石";
		mes "究竟有什么特别了吗？";
		mes "它、它是什么……真的？";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "它是……";
		next;
		input .@input$;
		mes "["+strcharinfo(0)+"]";
		mes "它是";
		mes "^3131FF"+.@input$+"^000000!";
		next;
		if (.@input$ == "Ymir") {
			mes "[Shinokas]";
			mes "伊、伊米尔……？";
			mes "伊米尔之心？";
			mes "控制世界的力量……";
			mes "我们真的";
			mes "找到了不得了的东西，";
			mes "对吧？";
			next;
			mes "[Shinokas]";
			mes "我记得……";
			mes "第一次看到它时。";
			mes "我们……";
			mes "既兴奋又惊讶，";
			mes "还感到骄傲……";
			next;
			mes "[Shinokas]";
			mes "但是挖掘出……";
			mes "如此伟大的东西……";
			mes "只有靠——^333333*咳*^000000——";
			mes "我、我的伙伴们……";
			next;
			mes "[Shinokas]";
			mes "^333333*Cough*^000000";
			mes "越来越……";
			mes "黑暗……我……";
			mes "不用再";
			mes "逃跑了。";
			next;
		}
		else {
			mes "[Shinokas]";
			mes "等、等等……！";
			mes "你说了什么……";
			mes "我听不懂——";
			mes "^333333*Cough cough!*^000000";
			next;
		}
		mes "["+strcharinfo(0)+"]";
		mes "不……！";
		mes "告诉我是谁";
		mes "对你做了这种事！";
		mes "他们在哪里？";
		mes "请告诉我！";
		next;
		mes "[Shinokas]";
		mes "什、什么……？";
		mes "我告诉过你。";
		mes "他、他们——";
		next;
		mes "[Shinokas]";
		mes "...";
		mes "......";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "不！";
		mes "Shinokas！";
		mes "为什么，上天？";
		mes "为什么……";
		changequest 2077,2078;
		set Shinokas_Quest,10;
		close;
	}
	else if (Shinokas_Quest > 9) {
		mes "^3355FFShinokas's";
		mes "身体已经";
		mes "冰冷。^000000";
		close;
	}
	else {
		mes "[Shinokas]";
		mes "...";
		mes "......";
		close;
	}
}

ein_in01,32,133,7	script	Maid#ein	850,{
	if (Shinokas_Quest == 4) {
		mes "[Maid]";
		mes "你是在问我";
		mes "有没有看到";
		mes "附近的矿石吗？";
		mes "真奇怪……";
		next;
		mes "[Maid]";
		mes "我和这个家族相处";
		mes "已经很久了。";
		mes "我可以保证，";
		mes "这个家里没有";
		mes "任何秘密能瞒过我！";
		next;
		mes "[Maid]";
		mes "抱歉，我不认为庄园里";
		mes "有任何矿石，";
		mes "无论特殊与否。";
		mes "你到底需要它们做什么？";
		set Shinokas_Quest,5;
		close;
	}
	else {
		mes "[Maid]";
		mes "这些要清洗的盘子";
		mes "永远也没有尽头……！";
		close;
	}
}

ein_in01,254,35,1	script	Scientist#ein	749,{
	mes "[Scientist]";
	mes "^333333*Grumble grumble*^000000";
	next;
	mes "[Scientist]";
	mes "嗯……？";
	mes "你是怎么";
	mes "进来的？";
	next;
	mes "["+strcharinfo(0)+"]";
	mes "哦！啊……";
	mes "我是新来的……";
	mes "守卫。很高兴";
	mes "认识你。";
	next;
	mes "[Scientist]";
	mes "哦。是的。";
	mes "很高兴认识你。";
	mes "..............";
	mes "^333333*Grumble grumble*^000000";
	if (Shinokas_Quest == 7) {
		next;
		switch(select("怎么了？:下次见。")) {
		case 1:
			mes "[Scientist]";
			mes "怎么了……？！";
			mes "别让我说起来！";
			mes "我被困在这里做所有工作，";
			mes "实验室主任却每天都出去！";
			next;
			mes "[Scientist]";
			mes "我在这里苦干，";
			mes "他却在飞艇上";
			mes "忙着和那个女人调情。";
			mes "天哪……！";
			mes "我真是气死了！";
			set Shinokas_Quest,8;
			close;
		case 2:
			mes "[Scientist]";
			mes "好。";
			mes "是的。";
			mes "回头见，伙计。";
			close;
		}
	}
	else if (Shinokas_Quest == 8) {
		next;
		mes "[Scientist]";
		mes "我的天！";
		mes "实验室主任进来";
		mes "做点工作";
		mes "会要命吗？！";
		next;
		mes "[Scientist]";
		mes "拜托！";
		mes "我不该替他";
		mes "承担工作量！";
		close;
	}
	close;
}


			close;
		}
		else if (god_brising == 45) {
			mes "[Enrico Kaili]";
			mes "嗯……？";
			mes "你忘了歌词吗？我也没把它们写下来。哈哈哈！看来你只有一个办法了~";
			next;
			mes "[Enrico Kaili]";
			mes "你得回去找贝尔林，再向他要一次歌词。祝你好运，这次可别忘了把它们记住。";
			close;
		}
		else if (god_brising == 44) {
			mes "[Enrico Kaili]";
			mes "看来你答出了那个谜语。做得好！";
			next;
			mes "[Enrico Kaili]";
			mes "那种奇怪而非尘世的湿润感……啊，你带来了芙蕾雅的泪滴！这意味着格雷尔现在一定已经自行苏醒了。";
			next;
			mes "[Enrico Kaili]";
			mes "我想你下一步应该进入矿井。抱歉又要麻烦你，但我们每了解一件新事，我就越兴奋。";
			next;
			mes "[Enrico Kaili]";
			mes "多亏你的帮助，我的研究才能取得这样的进展。总之，之后我会与你分享结论。";
			next;
			mes "[Enrico Kaili]";
			mes "那么，你现在要去矿井吗？小心那些怪物。";
			close;
		}
		else if (god_brising == 43) {
			mes "[Enrico Kaili]";
			mes "德瓦林的谜语？";
			mes "他一定是在说";
			mes "芙蕾雅不得不引发的";
			mes "那场无休止的战争。";
			next;
			mes "[Enrico Kaili]";
			mes "有两位国王，每人麾下都有二十名骑士。国王和骑士们彼此战斗并杀死对方，第二天早晨又由芙蕾雅复活，如此反复，直到成千上万的女武神充满英灵殿。";
			next;
			mes "[Enrico Kaili]";
			mes "他们四十二人";
			mes "每天都这样做……";
			mes "这是人人都知道的";
			mes "古老故事。";
			next;
			mes "[Enrico Kaili]";
			mes "无论如何，你该去调查贝尔林了。有一条溪流从普隆德拉西北方发源，穿过妙勒尼山的矿井。";
			next;
			mes "[Enrico Kaili]";
			mes "从那里开始寻找也许比较明智，调查你能找到的溪流和水洼。";
			close;
		}
		else if (god_brising == 42) {
			mes "[Enrico Kaili]";
			mes "你确定吗？！";
			mes "那些物品原本是用来制作";
			mes "芙蕾雅的项链，";
			mes "布里辛嘉曼的吗？";
			next;
			mes "[Enrico Kaili]";
			mes "如果四名矮人苏醒，";
			mes "布里辛嘉曼就可能";
			mes "出现在人类眼前？";
			mes "真迷人，太迷人了。";
			next;
			mes "[Enrico Kaili]";
			mes "让我想想……";
			mes "德瓦林沉睡的地方？";
			mes "我猜可能在修道士";
			mes "训练的地方附近，但不确定。";
			next;
			mes "[Enrico Kaili]";
			mes "无论如何，调查任何线索";
			mes "都不会有坏处，对吧？我想";
			mes "修道院在普隆德拉的";
			mes "东边。";
			close;
		}
		else if (god_brising == 41) {
			mes "[Enrico Kaili]";
			mes "什么……？";
			mes "你真的见到了";
			mes "阿尔弗里克……？";
			mes "真不敢相信，";
			mes "传说中的阿尔弗里克";
			mes "竟然还活着……";
			next;
			mes "[Enrico Kaili]";
			mes "阿尔弗里克是为女神芙蕾雅制作世界上最美项链布里辛嘉曼的四名矮人之一。";
			next;
			mes "[Enrico Kaili]";
			mes "我现在明白了……我们一直在收集与一件蕴含神之力量的物品有关的信息！";
			next;
			mes "[Enrico Kaili]";
			mes "让我想想……还有另一名矮人，德瓦林。阿尔弗里克有没有告诉你德瓦林可能沉睡在哪里？嗯……";
			close;
		}
		else if (god_brising == 40) {
			mes "[Enrico Kaili]";
			mes "目前看来，调查";
			mes "鲁提耶应该是";
			mes "最好的选择。";
			next;
			mes "[Enrico Kaili]";
			mes "我相信你能在那里找到女神芙蕾雅留下的痕迹。既然你能见到女武神，应该也能做到。";
			next;
			mes "[Enrico Kaili]";
			mes "我一直在想……女武神让你记住的那些话……";
			next;
			mes "[Enrico Kaili]";
			mes "^4d4dff群星的美丽";
			mes "与之相比也黯然失色。";
			mes "我们将心交给了";
			mes "那金色的头发";
			mes "和那双耀眼的眼睛。^000000";
			next;
			mes "[Enrico Kaili]";
			mes "那是什么意思？我开始怀疑自己以为了解的一切了……";
			close;
		}
		else if (god_brising == 35) {
			mes "[Enrico Kaili]";
			mes "我看得出来你经历了很多……你从赫米特那里听到了什么？";
			next;
			mes "^3355FF你把赫米特告诉你的事情，以及自己与女武神相遇的经历告诉了恩里科·凯利。^000000";
			next;
			mes "[Enrico Kaili]";
			mes "我几乎不敢相信！但如果你说的是真的，人类也许真的能够拥有神之力量。";
			next;
			mes "[Enrico Kaili]";
			mes "嗯？王室送来的这件东西有反应了。嗯，靠近些看看。";
			next;
			mes "^3355FF恩里科打开上锁的箱子，露出一颗无比清澈、闪闪发光的宝石。^000000";
			next;
			mes "[Enrico Kaili]";
			mes "很神奇吧？如果女武神说的是真的，这颗宝石一定是芙蕾雅泪滴中的水晶。";
			next;
			mes "[Enrico Kaili]";
			mes "我不明白这一切为什么突然发生。目前我得好好想想你从女武神那里听到的诗。";
			next;
			mes "[Enrico Kaili]";
			mes "女神踏过的寒冷雪路。";
			mes "女神渡过的蓝色河流。";
			mes "女神经过的狭窄小径。";
			mes "女神遇见的四名矮人……";
			next;
			mes "[Enrico Kaili]";
			mes "我确定四名矮人就是我研究过的著名工匠，但无法判断诗的其他部分是什么意思。";
			next;
			mes "[Enrico Kaili]";
			mes "现在……我又需要你的帮助了！";
			next;
			switch(select("哇？还没结束？！:这次又是什么？")) {
			case 1:
				mes "[Enrico Kaili]";
			mes "哈……！我们的工作才刚开始！现在去鲁提耶寻找线索。";
				next;
				mes "[Enrico Kaili]";
			mes "诗中提到了雪路，而这颗宝石就是在那里发现的，所以把鲁提耶当作下一条线索的地点是很合理的推测。";
				next;
				mes "[Enrico Kaili]";
			mes "希望我们能了解女神芙蕾雅在米德加尔特留下了什么……";
				set god_brising,40;
				close;
			case 2:
				mes "[Enrico Kaili]";
			mes "哈哈哈……！我喜欢你的态度！尼利尔德再次证明了自己是优秀的识人者。";
				next;
				mes "[Enrico Kaili]";
			mes "诗中提到了雪路，而这颗宝石是在鲁提耶发现的。因此鲁提耶是寻找下一条线索的好地方。";
				next;
				mes "[Enrico Kaili]";
			mes "希望我们能了解女神芙蕾雅在米德加尔特留下了什么……";
				set god_brising,40;
				close;
			}
		}
		else if ((god_brising > 9) && (god_brising < 35)) {
			mes "[Enrico Kaili]";
			mes "嗯……？我明白了……我知道让你做的工作可能相当麻烦……";
			next;
			mes "[Enrico Kaili]";
			mes "放心吧，工作完成后我会奖励你。像你这样好的帮手很难找到。";
			close;
		}
		else if ((god_brising > 3) && (god_brising < 10)) {
			mes "[Enrico Kaili]";
			mes "那么，你见到赫米特了吗？嗯？他真的要求你做那件事？";
			next;
			mes "[Enrico Kaili]";
			mes "目前看来你可能没有别的选择。照他说的做也许比较明智。了解查尔斯的话，这应该不会太糟。";
			close;
		}
		else if (god_brising == 3) {
			mes "[Enrico Kaili]";
			mes "赫米特……？你需要更多关于他的资料吗？让我想想……";
			next;
			mes "[Enrico Kaili]";
			mes "哦，对了！他是那个怪物研究组织的注册成员。你为什么不去问那位女士更多关于他的资料？";
			next;
			mes "[Enrico Kaili]";
			mes "如果她允许你查看记录，你大概就能找到他的住处。现在去和房间左侧的那位女士谈谈吧。";
			close;
		}
		else if (god_brising == 2) {
			mes "[Enrico Kaili]";
			mes "那么，你考虑过我的提议吗？为我工作，我一定会报答你。";
			next;
			switch(select("不用了，谢谢。:好啊，为什么不呢？")) {
			case 1:
				mes "[Enrico Kaili]";
				mes "什么……？！那你为什么还要来找我？如果只是想打扰我，请马上离开。";
				close;
			case 2:
				mes "[Enrico Kaili]";
				mes "真的吗？如果你能帮忙就太好了！开始之前，你能看看这个吗？";
				next;
				mes "^3355FF恩里科·凯利给你看了盒子里一小块白色结晶。它看起来非常脆弱，却散发出强烈的寒气。^000000";
				next;
				mes "[Enrico Kaili]";
				mes "我称它为雪晶。看起来就像雪花，对吧？奇怪的是，它从来没有融化。";
				next;
				mes "[Enrico Kaili]";
				mes "几年前，一名年轻冒险者把它交给了我。我需要找到那个人，弄清楚这究竟是什么，以及它来自哪里。";
				next;
				mes "[Enrico Kaili]";
				mes "让我想想，把它带给我的人是……啊，赫米特·查尔斯。";
				next;
				mes "[Enrico Kaili]";
				mes "找到他后，请把这封信交给他。";
				next;
				mes "^3355FF恩里科给了你一封写给赫米特·查尔斯的小信，信封用红蜡封好。^000000";
				set god_brising,3;
				close;
			}
		}
		else if (god_brising == 1) {
			mes "[Enrico Kaili]";
			mes "啊，你来了！";
			mes "" + strcharinfo(0) + "，对吧？";
			mes "是的，尼利尔德告诉我你会来。他总能帮我找到可靠的好帮手。";
			next;
			mes "[Enrico Kaili]";
			mes "正如尼利尔德可能提过的，我需要一些帮助来完成研究。你们冒险者总是在各地旅行，所以我希望你能帮我找一个人。";
			next;
			switch(select("我不擅长找人。:我能做到！")) {
			case 1:
				mes "[Enrico Kaili]";
				mes "哦……真的吗？我本来很希望你能帮忙。不过如果这超出你的能力，我也理解。";
				next;
				mes "[Enrico Kaili]";
				mes "看来我只能再找一名冒险者帮忙了。不过如果你之后改变主意，请不要犹豫，尽管来帮我。";
				set god_brising,2;
				close;
			case 2:
				mes "[Enrico Kaili]";
				mes "真的吗？如果你能帮忙就太好了！开始之前，你能看看这个吗？";
				next;
				mes "^3355FF恩里科·凯利给你看了盒子里一小块白色结晶。它看起来非常脆弱，却散发出强烈的寒气。^000000";
				next;
				mes "[Enrico Kaili]";
				mes "我称它为雪晶。看起来就像雪花，对吧？奇怪的是，它从来没有融化。";
				next;
				mes "[Enrico Kaili]";
				mes "几年前，一名年轻冒险者把它交给了我。我需要找到那个人，弄清楚这究竟是什么，以及它来自哪里。";
				next;
				mes "[Enrico Kaili]";
				mes "让我想想，把它带给我的人是……啊，赫米特·查尔斯。";
				next;
				mes "[Enrico Kaili]";
				mes "找到他后，请把这封信交给他。";
				next;
				mes "^3355FF恩里科给了你一封写给赫米特·查尔斯的小信，信封用红蜡封好。^000000";
				set god_brising,3;
				close;
			}
		}
		else {
			mes "[Enrico Kaili]";
			mes "我不太明白你为什么来找我，但很抱歉我现在无法帮助你。";
			next;
			mes "[Enrico Kaili]";
			mes "我现在正忙于完成研究。请让我安静地工作。";
			close;
		}
	}
	else {
		mes "[Studying Scholar]";
		mes "你知道怎么制作红色药水吗？把很多红色药草研磨后仔细摇晃液体，直到达到理想的浓度。";
		next;
		mes "[Studying Scholar]";
		mes "如果我能找到更快的生产方法，很快就能发财……";
		close;
	}
}

prt_church,113,103,1	script	Praying Man	798,{
 	if ($God2 < $@god_check1) {
		mes "[Praying Man]";
		mes "愿所有人都过上幸福的生活，愿世界和平……";
		next;
		mes "[Praying Man]";
		mes "愿我用这个月薪水买来的旧蓝箱子能让我发大财……";
		close;
	}
	if ($God3 >= $@god_check2) {
		mes "[Praying Man]";
		mes "现在正是回顾过去、准备未来的时候。";
		next;
		mes "[Praying Man]";
		mes "在宁静中，我们才能获得知道下一步该怎么走的智慧。让我们祈祷吧。";
		close;
	}
	if (god_brising > 34) {
		mes "^3355FF赫米特·查尔斯仍在虔诚地祈祷。他闭着眼，双手交握在胸前，身上似乎笼罩着淡淡的悲伤。^000000";
		close;
	}
	else if (god_brising == 34) {
		mes "[Hermite Charles]";
		mes "你刚才说什么？她真的成为英灵了吗？那是任何战士都梦寐以求的最高荣誉……";
		next;
		mes "[Hermite Charles]";
		mes "她一定很幸福。我想归根结底，我从未真正占据她心中的位置。洛温……";
		next;
		mes "[Hermite Charles]";
		mes "但有一件事我很确定。她本该责怪我发生的一切。她为什么要独自承担所有事情？";
		next;
		mes "[Hermite Charles]";
		mes "我想她只是把我当成弟弟。显然，她从没真正把我当回事。";
		next;
		mes "[Hermite Charles]";
		mes "哈哈……哈哈哈……现在我感觉好多了！那么，你刚才说什么？";
		next;
		mes "[Hermite Charles]";
		mes "对了，请把这些告诉恩里科。他感兴趣的物品是陛下赐给一座城堡所属公会的。";
		next;
		mes "[Hermite Charles]";
		mes "单凭人类技术绝不可能制造它。不过，如果学者证明自己有能力，陛下或许会允许他们研究并持有它。";
		next;
		mes "[Hermite Charles]";
		mes "我没有足够力量赢得它。坦白说，我偷走了它。但很快我开始害怕它，每次看到它，心脏都会因恐惧而狂跳。";
		next;
		mes "[Hermite Charles]";
		mes "有一天，我觉得它真的附身于我，于是踏上了旅程。不过我也不太清楚究竟去了哪里……";
		next;
		mes "[Hermite Charles]";
		mes "我只记得自己在雪之城鲁提耶。我过桥后向西边的山丘走去……";
		next;
		mes "[Hermite Charles]";
		mes "但一到那里，我就被一种无法解释的恐惧攫住了。";
		next;
		mes "[Hermite Charles]";
		mes "最后我逃跑了。所以我才把它交给恩里科先生。你想嘲笑我是胆小鬼，就笑吧。";
		next;
		mes "[Hermite Charles]";
		mes "现在你什么都知道了。请让我一个人待着。^333333*叹气……*^000000";
		set god_brising,35;
		close;
	}
	else if (god_brising > 19 && god_brising < 34) {
		mes "[Hermite Charles]";
		mes "我会等着。出于某种原因，我相信你总有一天能找到过去两年发生之事的线索。";
		close;
	}
	else if (god_brising == 12) {
		mes "[Hermite Charles]";
		mes "洛恩·菲莉西亚？我让你找的是洛温，不是洛恩。洛温·埃伦南。";
		next;
		mes "[Hermite Charles]";
		mes "抱歉给你添麻烦了，但我想你最好再试一次。";

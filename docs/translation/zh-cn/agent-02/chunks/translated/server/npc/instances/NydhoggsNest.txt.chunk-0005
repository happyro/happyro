// GM Management NPCs
//============================================================
sec_in02,36,167,3	script	Nidhoggur Manager	447,1,1,{
	callfunc "F_GM_NPC";
	mes "请输入密码。";
	next;
	if (callfunc("F_GM_NPC","1854",1) == 0) {
		mes "密码错误。";
		close;
	}
	mes "你需要做什么？";
	next;
	switch(select("重置变量以允许进入尼德霍格:修改变量 ‘ins_nyd’:移除 3 天计时器 3135:确认变量数值")) {
	case 1:
		set ins_nyd,200;
		set ins_nyd2,0;
		erasequest 3135;
		mes "ins_nyd 已设为 200，ins_nyd2 已设为 0。";
		mes "任务 3135 已清除。";
		close;
	case 2:
		mes "你想修改哪个变量？";
		next;
		switch(select("ins_nyd:ins_nyd2")) {
			case 1: set .@var$,"ins_nyd"; break;
			case 2: set .@var$,"ins_nyd2"; break;
		}
		mes "输入变量数值";
		next;
		input .@input;
		setd .@var$, .@input;
		mes .@var$+" 已设为 "+.@input+"。";
		close;
	case 3:
		mes "关闭此对话框时会移除 3 天计时器。";
		next;
		erasequest 3135;
		mes "任务计时器已移除。";
		close;
	case 4:
		mes "ins_nyd 的值为 "+ins_nyd+"。";
		mes "ins_nyd2 的值为 "+ins_nyd2+"。";
		close;
	}
}

nyd_dun02,7,7,2	script	Purification Admin#nyd2	844,2,0,{
	callfunc "F_GM_NPC";
	mes "请输入密码";
	set .@i, callfunc("F_GM_NPC","dragonslayer",1);
	next;
	if (.@i == 0) {
		mes "请准确输入密码。";
		close;
	}
	switch(select("生成净化石:移除净化石:关闭入口 NPC:开启入口 NPC:取消")) {
	case 1:
		mes "净化石已生成，将持续 30 分钟。";
		donpcevent "Purification Stone#nyd2::OnEnable";
		close;
	case 2:
		mes "净化石已摧毁。";
		donpcevent "Purification Stone#nyd2::OnDisable";
		close;
	case 3:
		mes "nyd_dun02 100 201 的尤格德拉希尔守门人现已关闭。";
		disablenpc "Yggdrasil Gatekeeper";
		close;
	case 4:
		mes "nyd_dun02 100 201 的尤格德拉希尔守门人现已开启。";
		enablenpc "Yggdrasil Gatekeeper";
		close;
	case 5:
		close;
	}
}

nyd_dun02,88,195,4	script	Purification Stone#nyd2	406,{
	erasequest 3135;
	erasequest 3136;
	set ins_nyd,200;
	set ins_nyd2,0;
	mes "^0000FF尼德霍格巢穴相关记录和后续效果已移除。你可以再次生成并进入地下城。^000000";
	close;
OnInit:
	disablenpc "Purification Stone#nyd2";
	end;
OnEnable:
	initnpctimer;
	end;
OnDisable:
	stopnpctimer;
	disablenpc "Purification Stone#nyd2";
	end;
OnTimer1000:
	enablenpc "Purification Stone#nyd2";
	end;
OnTimer1740000:
	mapannounce "nyd_dun02","净化石将在一分钟后摧毁。",bc_map,"0x00FF99",FW_NORMAL,12;
	end;
OnTimer1800000:
	disablenpc "Purification Stone#nyd2";
	end;
}

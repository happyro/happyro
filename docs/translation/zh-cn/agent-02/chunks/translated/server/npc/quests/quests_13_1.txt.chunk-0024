}

mid_camp,256,272,3	script	Defaria#moc2	897,{
	if (checkweight(714,1) == 0) {
		mes "- 你携带的物品太多，无法继续任务。-";
		close;
	}
	if (mao_morocc2 < 14) {
		mes "[Defaria]";
		mes "请让开。";
		mes "我现在正经历人生的转折点。";
		mes ".....";
		specialeffect EF_BEGINSPELL2;
		next;
		mes "- 火花刚冒出就立刻熄灭了。-";
		specialeffect EF_FIREARROW,AREA,"Wet Firewood#moc2";
		next;
		mes "[Defaria]";
		mes "...............";
		mes "你知道吗，那是我用湿柴生火的第九十三次尝试。";
		next;
		mes "[Defaria]";
		mes "等等，那是第九十四次还是第九十五次？";
		mes "……我、我数不清了。";
		close;
	}
	else if (mao_morocc2 == 14) {
		mes "[Defaria]";
		mes "请让开。";
		mes "我现在正经历人生的转折点。";
		mes "......";
		specialeffect EF_BEGINSPELL2;
		next;
		mes "- 火花刚冒出就立刻熄灭了。-";
		specialeffect EF_FIREARROW,AREA,"Wet Firewood#moc2";
		next;
		mes "[Defaria]";
		mes "...............";
		mes "你也是来这里…………………";
		mes "嘲笑我用湿柴烤红薯的愚蠢尝试的吗？";
		next;
		select("...No.");
		mes "[Defaria]";
		mes "……没有？那你来这里做什么？";
		mes "...Huh?";
		mes "法术卷轴？可以让我看看吗？";
		next;
		mes "[Defaria]";
		mes "……这不是……这不是吗？！";
		mes "...Hmm...";
		mes "呀……所以是紫锥花介绍你来找我的？";
		mes "……这意味着她什么都知道吗……？";
		next;
		mes "[Defaria]";
		mes "……好吧，那我告诉你。";
		mes "如你所见，这卷轴被封印了。";
		mes "只有用秘密方法才能解封。";
		mes "...And...";
		next;
		mes "[Defaria]";
		mes "……这是来自……";
		mes "...Arunafeltz?";
		mes "它的封印方式与神殿使用的方法相同……";
		next;
		mes "[Defaria]";
		mes "我不知道你是怎么得到这卷轴的，";
		mes "……但我会代表阿鲁纳佩茨的优秀学者尽力帮助你。";
		next;
		mes "[Defaria]";
		mes "但记住，我不是以官方身份做这件事。请别让我因为帮助你而使国家蒙羞。明白我的意思吗？";
		next;
		switch(select("明白了。:不。")) {
		case 1:
			mes "[Defaria]";
			mes "很好。那么请帮我收集解封卷轴所需的物品：";
			mes "^4d4dff30 瓶圣水、暗之符文和血之符文^000000。";
			next;
			mes "[Defaria]";
			mes "我会等你回来。";
			set mao_morocc2,15;
			changequest 7023,7024;
			close;
		case 2:
			mes "[Defaria]";
			mes "一开始，你看起来像是可靠且懂得公私之分的人。";
			mes "你的回答证明我看错了。";
			mes "紫锥花一定是走投无路了，才会向你这样的人求助。";
			close;
		}
	}
	else if (mao_morocc2 == 15) {
		if ((countitem(523) > 29) && (countitem(7511) > 29) && (countitem(7563) > 29) && (countitem(6028) > 0)) {
			mes "[Defaria]";
			mes "哦，你把东西都带来了！";
			mes "很好，不难吧？";
			mes "好了，你过一会儿再回来好吗？";
			delitem 523,30; //Holy_Water
			delitem 7511,30; //Rune_Of_Darkness
			delitem 7563,30; //Bloody_Rune
			delitem 6028,1; //Seal_Scroll
			set mao_morocc2,16;
			changequest 7024,7025;
			close;
		}
		else {
			mes "[Defaria]";
			mes "要解封卷轴，";
			mes "我需要 ^4d4dff30 瓶圣水、暗之符文和血之符文^000000。";
			mes "别忘了把法术卷轴也带来。";
			next;
			mes "[Defaria]";
			mes "你收集物品时，我会烤红薯。";
			mes "要是我能让这火烧起来就好了……";
			close;
		}
	}
	else if (mao_morocc2 == 16) {
		if (rand(1,3) == 2) {
			mes "[Defaria]";
			mes "欢迎回来，你来得正是时候。";
			mes "首先，这卷法术卷轴包含传送法术。";
			mes "你知道传送是什么吧？";
			next;
			mes "[Defaria]";
			mes "你知道，";
			mes "那是一种能立即将你移动到其他地点的法术。";
			mes "这卷轴里就有这种法术。";
			next;
			mes "[Defaria]";
			mes "唯一的区别是……";
			mes "这卷轴会把你传送到特定地点。";
			mes "这类卷轴通常由 ^4d4dff组织用来召集成员^000000。";
			next;
			mes "[Defaria]";
			mes "我不知道这卷轴会把你带到哪里……";
			mes "你要使用这卷轴，对吧？";
			mes "来，请拿着。";
			next;
			mes "[" + strcharinfo(0) + "]";
			mes "‘召集成员……？’";
			mes "……对了！我记得";
			mes "拉扬提过某处的集会！";
			mes "所以这卷轴会把我带到那个集会？";
			next;
			mes "[Defaria]";
			mes "嗯，你介意吗？别再自言自语了，赶紧离开吧。";
			mes "抱歉，但这个老人需要休息，好吗？";
			set mao_morocc2,17;
			getitem 14595,1; //Unsealed_Magic_Spell
			changequest 7025,7026;
			close;
		}
		else {
			mes "[Defaria]";
			mes "别这么急躁。";
			mes "你可以晚些时候再来。";
			mes "这需要一些时间。";
			close;
		}
	}
	else if (mao_morocc2 == 17) {
		mes "[Defaria]";
		mes "你在担心什么？";
		mes "使用后你就会知道它如何运作。";
		close;
	}
	else if (mao_morocc2 == 101) {
		mes "[" + strcharinfo(0) + "]";
		mes "....";
		next;
		mes "[Defaria]";
		mes "……嗯？你想要什么？";
		next;
		input .@input$;
		if (.@input$ == "Dandelion") {
			mes "[Defaria]";
			mes "……我知道他们和这件事有关，但是";
			mes "我们不该谈论它们。";
			next;
			switch(select("Just tell me what you know.:Alright..:")) {
			case 1:
				mes "[Defaria]";
				mes "我为什么要费那么大劲？";
				mes "你可以去问问紫锥花。";
				mes "这个老人需要休息，好吗？";
				next;
				select("I'll do anything for you.");
				mes "[Defaria]";
				mes "什么？";
				mes "你是认真的吗？";
				next;
				switch(select("Haha, got you!:Yes!")) {
				case 1:
					mes "[Defaria]";
					mes "什么——！你竟敢欺骗老人！";
					mes "你这个小混蛋！";
					specialeffect2 EF_HIT2;
					percentheal -10,0;
					next;
					mes "[Defaria]";
					mes "我可能年纪大了，";
					mes "但我是伟大的阿鲁纳佩茨学者代表！";
					mes "戏弄我可是大错特错！";
					specialeffect2 EF_HIT2;
					percentheal -10,0;
					next;
					mes "[Defaria]";
					mes "你以为我因为用湿柴生火就很蠢吗？！";
					mes "..*Pant Pant*.. Phew, even yelling tires me out..";
					close;
				case 2:
					mes "[Defaria]";
					mes "那么……";
					mes "……嗯……你能带些木材给我吗？";
					mes "……如果方便的话，再带些红薯。";
					next;
					select("当然。要多少？");
					mes "[Defaria]";
					mes "……让我看看……";
					mes "我需要红薯，给我、基德先生和紫……嗯……";
					mes "……然后我还需要……对了！";
					next;
					mes "[Defaria]";
					mes "请带给我 ^4d4dff20 个红薯和 30 根木材^000000。";
					mes "我会等你回来。";
					set mao_morocc2,102;
					changequest 7037,7038;
					close;
				}
			case 2:
				mes "[Defaria]";
				mes "你似乎很容易放弃。";
				mes "我不怪你。有时放弃是最好的决定，";
				mes "更不用说这也需要某种勇气。";
				next;
				mes "[Defaria]";
				mes "比如，知道何时放弃奶酪——也就是陷阱诱饵——的塔罗斯，反而最难捕捉。明白吗？";
				mes "..Hahaha!";
				close;
			}
		}
		else if (.@input$ == "Arunafeltz") {
			mes "[Defaria]";
			mes "...Arunafeltz...?";
			mes "是的，我来自阿鲁纳佩茨……";
			mes "那又怎样？";
			close;
		}
		else {
			mes "[Defaria]";
			mes "请把问题说得具体些，";
			mes "别再含糊其辞了。";
			close;
		}
	}
	else if (mao_morocc2 == 102) {
		if ((countitem(516) > 19) && (countitem(7201) > 29)) {
			mes "[Defaria]";
			mes "哦，你真的带来了我想要的东西！";
			mes "请把它们给我……";
			mes "不，等等，你能把它们堆在那边的柴火上吗？";
			next;
			mes "[Defaria]";
			mes "请堆得整齐漂亮些。";
			mes "哦，你忘了把红薯放在上面。";
			mes "很好，这样就完美了。";
			next;
			mes "[Defaria]";
			mes "希望我能用你带来的好木材生起火……";
			specialeffect EF_BEGINSPELL2;
			next;
			specialeffect EF_FIREWALL,AREA,"Wet Firewood#moc2";
			specialeffect EF_TORCH,AREA,"Wet Firewood#moc2";
			mes "[Defaria]";
			mes "哦，效果比我希望的还好！";
			mes "看来我的魔法还没有生疏到那种程度……";
			delitem 516,20; //Sweet_Potato
			delitem 7201,30; //Log
			set mao_morocc2,103;
			close;
		}
		else {
			mes "[Defaria]";
			mes "如果你想让我帮忙，";
			mes "就请带来 ^4d4dff20 个红薯和 30 根木材^000000 作为回报。";
			close;
		}
	}
	else if (mao_morocc2 == 103) {
		mes "- 德法丽娅正在给烤红薯吹气，并剥去外皮。-";
		next;
		select("打扰了，先生……");
		mes "[Defaria]";
		mes "什么……？";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "你是不是忘了什么？";
		mes "……蒲公英？我想让你告诉我你知道的事。";
		mes "我希望你能想起一些关于蒲公英的事。";
		next;
		mes "[Defaria]";
		mes "所以，";
		mes "你想让我确认";
		mes "蒲公英是否真的得到阿鲁纳佩茨支持？";
		next;
		mes "[Defaria]";
		mes "嗯……我不知道该说什么……我不太愿意谈政治。";
		next;
		mes "[Defaria]";
		mes "……你介意把这些送给基德先生吗？";
		next;
		mes "- 德法丽娅给了你 2 个优质红薯。-";
		set mao_morocc2,104;
		getitem 549,2; //Nice_Sweet_Potato
		changequest 7038,7039;
		close;
	}
	else if (mao_morocc2 == 104) {
		mes "[Defaria]";
		mes "嗯，我刚才让你把那些红薯送给基德先生。";
		close;
	}
	else if (mao_morocc2 == 105) {
		mes "[Defaria]";
		mes "对了，他喜欢吗？";
		mes "哈哈哈……";
		mes "…… ……";
		next;
		mes "[Defaria]";
		mes "蒲公英就像幽灵一样。";
		mes "这个世界上有许多不同类型的人。";
		mes "有些人想要战争，另一些人反对战争。";
		next;
		mes "[Defaria]";
		mes "蒲公英属于前者。";
		mes "那些右翼分子相信扭曲的爱国主义。他们认为流血是实现和平的唯一途径。";
		next;
		mes "[Defaria]";
		mes "他们组织了蒲公英，";
		mes "并恰好与政府中的好战分子结盟。";
		next;
		mes "[Defaria]";
		mes "他们就是这样变得强大的。";
		mes "起初，他们的目的仅限于收集情报和监视其他国家。";
		mes "这只是我的想法，但正确的情报足以在一个国家引发混乱。";
		next;
		select("那又怎样……？");
		mes "[Defaria]";
		mes "你现在还看不出来吗？这不是很明显吗？";
		mes "如果你连自己的问题都解决不了，";
		mes "那就无法应付敌人。";
		next;
		select("所以这一切都是阿鲁纳佩茨策划的！");
		mes "[Defaria]";
		mes "不，事情没那么简单。这个世界不是非黑即白，你知道吗？";
		mes "把这些带给紫锥花，好吗？";
		mes "它们烤得很好。";
		next;
		mes "- 你收到了 2 个热腾腾的优质红薯。-";
		set mao_morocc2,106;
		getitem 549,2; //Nice_Sweet_Potato
		changequest 7039,7040;
		close;
	}
	else if (mao_morocc2 == 106) {
		mes "[Defaria]";
		mes "我让你把那些烤好的红薯送给紫锥花。";
		mes "别吃掉它们，好吗？";
		close;
	}
	else if (mao_morocc2 == 107) {
		mes "[Defaria]";
		mes "呜哈哈哈哈！";
		mes "紫锥花真的这么说吗？";
		mes "她是卢恩·米德加尔特军队的高层。";
		mes "我能看出她说的是发自内心的话。";
		next;
		mes "[Defaria]";
		mes "事情能这样发展，我松了口气。";
		mes "毕竟，正是他们让三个国家决定合作。";
		mes "当然，现在说合作能否长久还为时过早。";
		next;
		mes "[Defaria]";
		mes "我只希望三个国家能借此机会建立长久友好的关系。为了全世界的人，这不是很好吗？";
		mes "嗯，不过我可不指望世界和平。";
		next;
		mes "[Defaria]";
		mes "我只是个无法预见未来的普通人，你知道吗？";
		mes "..Hahaha..";
		next;
		mes "[Defaria]";
		mes "啊，你的红薯烤得非常好。";
		mes "来，享用吧。";
		mes "谢谢你如此努力地满足这个古怪的老人。";
		set mao_morocc2,108;
		getitem 633,5; //Baked_Yam
		completequest 7041;
		close;
	}
	else if (mao_morocc2 > 108) {
		mes "- 德法丽娅陷入沉思，一手拿着火钳，-";
		mes "- 另一手拿着红薯。-";
		next;
		mes "- 他有时望向天空，叹气，然后说：‘我真羡慕现在的年轻人……’-";
		mes "- 或者说：‘不管发生什么，我都不在乎了。’-";
		next;
		mes "- 他似乎正沉浸在深刻的思绪中，我们别打扰他。-";
		close;
	}
	else {
		mes "[Defaria]";
		mes "除非有非常重要的事，否则请让我一个人待着。";
		mes "我还有很多想做的事……";
		close;
	}
}

mid_camp,255,269,0	script	Wet Firewood#moc2	844,{
	if (mao_morocc2 > 102) {
		mes "你发现了一些高品质的半烧木材。";
		mes "看来有人已经用这些木材烤过红薯。";
		close;
	}
	else {
		mes "你发现营地的木材太湿，无法生火。";
		mes "看来有人一直徒劳地试图用它们生火。";
		close;
	}
}

morocc,43,108,5	script	Sharp-Looking Boy#dan_07	82,{
	mes "[Jack]";
	if (BaseClass == Job_Assassin) {
		mes "这座城镇几乎一半都被摧毁了，";
		mes "但仍有人来访。";
		mes "不得不说，我们的据点依然完好、经受住了所有破坏，真是不可思议。";
		close;
	}
	else {
		mes "如你所见，这座城镇有一半已经消失。我想没有必要限制进入这家酒馆。";
		mes "请随意进去。";
		next;
		mes "[Jack]";
		mes "你敢踏入这地狱般的地方，勇气可嘉。";
		close;
	}
}


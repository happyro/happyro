		close2;
	}
	else {
		cutin "mocseal_kid01",2;
		mes "[Mr. Kidd]";
		mes "……最好不要偏离官方路线接近空间裂缝。";
		mes "如果你没有得到授权，就请离开。这东西太危险，不容随意探索。";
		close2;
	}
	cutin "mocseal_kid01",255;
	end;

OnInit:
	set $@moc_mao_gate1,0; //Global Variable
	end;
}

mid_camp,205,312,0	script	#moc2_talkevent01	-1,1,1,{

			mes "去约会吧！哈哈哈哈哈哈~！";
			close2;
		}
	}
	cutin "god_kukur01",255;
	end;
}

que_god01,66,125,6	script	Researcher#G1	89,{
	if ($God1 < $@god_check2) {
		if (god_sl_1 == 2) {
			set god_sl_1,11;
		}
		if ((god_sl_1 == 11) || (god_sl_1 == 22) || (god_sl_1 == 33) || (god_sl_1 == 44)) {
			if (god_sl_2 == 0) {
				mes "[Hallandaute]";
				mes "啊，你就是基琳女士提到的人？她说你会帮我研究。";
				next;
				mes "[Hallandaute]";
				mes "坦白说，我们不太需要不专长于这个研究领域的人。";
				next;
				mes "[Hallandaute]";
				mes "不过，如果你不介意做些琐碎工作来帮忙，应该能减轻我们的负担。";
				next;
				mes "[Hallandaute]";
				mes "现在……什么工作适合你？让我想想……";
				next;
				mes "[Hallandaute]";
				mes "有了！你为什么不替我去拜访^FF0000梅托^000000？请把他想报告的消息带回来。";
				next;
				mes "[Hallandaute]";
				mes "他正在研究与我相似的项目，也许能帮到我。梅托住在朱诺，你很容易找到他。";
				set god_sl_2,1;
				close;
			}
			else if (god_sl_2 == 1) {
				if (metto_q == 0) {
					mes "[Hallandaute]";
				mes "看来你还没找到梅托。虽然他有时过于热情，但绝不是坏人。";
					next;
					mes "[Hallandaute]";
				mes "我们在同一领域工作了很久，也做了很久的朋友。不知道他最近怎么样？";
					next;
					mes "[Hallandaute]";
				mes "总之，问问他的研究进展。如果他请你帮忙，请伸出援手。";
					close;
				}
				else if (metto_q < 9) {
					mes "[Hallandaute]";
				mes "嗯……梅托怎么样？嗯？他似乎变了……";
					close;
				}
				else {
					mes "[Hallandaute]";
				mes "嗯……梅托怎么样？";
					next;
					mes "[Hallandaute]";
				mes "疯狂科学家？这听起来不对。我做梦也没想到梅托会变成那样……";
					emotion ET_SCRATCH;
					next;
					mes "[Hallandaute]";
				mes "嗯……真遗憾。我不知道该说什么。我们以前一起看电影、庆祝生日。请、请让我静一静……";
					emotion ET_THINK;
					set god_sl_2,2;
					close;
				}
			}
			else if (god_sl_2 == 2) {
				if (rand(1,10) == 7) {
					mes "[Hallandaute]";
				mes "啊……你回来了。好吧，我简要告诉你我的研究内容。";
					next;
					mes "[Hallandaute]";
				mes "我想进一步了解^FF0000未知之轮^000000，它被发现是名为^FF0000斯莱普尼尔^000000的神器碎片。";
					next;
					mes "[Hallandaute]";
				mes "它看起来像普通齿轮……但我无法弄清它应该如何运作。";
					next;
					mes "[Hallandaute]";
				mes "这个齿轮最奇特之处在于它所使用的金属。";
					next;
					mes "[Hallandaute]";
				mes "它看起来摸起来都像钢，但极热和极冷都无法影响它。我施加的任何冲击或力量也无法让它凹陷。";
					next;
					mes "[Hallandaute]";
				mes "有时未知之轮会与某些物体共鸣，但我无法让它一直发生。";
					next;
					mes "[Hallandaute]";
				mes "我猜自己缺少某种特殊条件，才能让未知之轮与特定材料共鸣。";
					next;
					mes "[Hallandaute]";
				mes "总之，谢谢你之前的帮助。这就是我需要的全部，所以请去和其他研究者谈谈，看看他们是否需要协助。";
					set god_sl_2,0;
					if (god_sl_1 == 11) {
						set god_sl_1,12;
					}
					if (god_sl_1 == 22) {
						set god_sl_1,23;
					}
					if (god_sl_1 == 33) {
						set god_sl_1,34;
					}
					if (god_sl_1 == 44) {
						set god_sl_1,50;
					}
					close;
				}
				else {
					mes "[Hallandaute]";
				mes "哦，抱歉。我现在正忙着整理这些资料。";
					next;
					mes "[Hallandaute]";
				mes "让我看看……接下来该怎么做……^333333*喃喃自语*^000000";
					close;
				}
			}
			else {
				mes "[Hallandaute]";
			mes "嗯……这该怎么运作？关于神器，我们仍有太多未知。^333333*叹气*^000000";
				close;
			}
		}
		else {
			mes "[Hallandaute]";
			mes "独自进行研究并不容易。多一双手总是好的。";
			next;
			mes "[Hallandaute]";
			mes "现在我只需要有人分担工作。不过，根据项目不同，合适的助手也不同。";
			next;
			mes "[Hallandaute]";
			mes "基本上，如果助手特别受过当前研究领域的训练，他可能比外行更有用。";
			next;
			mes "[Hallandaute]";
			mes "当然，也有人什么都擅长。但这种人很少，所以我会为每个项目选择最合适的助手。";
			close;
		}
	}
	else {
		mes "[Hallandaute]";
		mes "独自进行研究并不容易。多一双手总是好的。";
		next;
		mes "[Hallandaute]";
		mes "现在我只需要有人分担工作。不过，根据项目不同，合适的助手也不同。";
		next;
		mes "[Hallandaute]";
		mes "基本上，如果助手特别受过当前研究领域的训练，他可能比外行更有用。";
		next;
		mes "[Hallandaute]";
		mes "当然，也有人什么都擅长。但这种人很少，所以我会为每个项目选择最合适的助手。";
		close;
	}
}

que_god01,11,136,6	script	Researcher#G2	742,{

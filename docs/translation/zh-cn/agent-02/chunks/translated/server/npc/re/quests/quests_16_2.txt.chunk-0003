		sleep2 3000;
		npctalk "布鲁诺，你最好和我们合作。", "Skia#ep162_04", bc_self;
		sleep2 2500;
		npctalk "否则你一辈子都会被那些家伙追杀，对吧？如果你帮助我们，我们就不杀你。", "Skia#ep162_04", bc_self;
		sleep2 1000;
		npctalk "....", "", bc_self;
		sleep2 3000;
		npctalk "什么？你不回答吗？", "Skia#ep162_04", bc_self;
		sleep2 3000;
		npctalk "好吧。那就拜托你了，克鲁克斯。", "Skia#ep162_04", bc_self;
		sleep2 2000;
		npctalk "好的，女士。宫殿见。", "Crux#ep162_02", bc_self;
		sleep2 2000;
		setpcblock PCBLOCK_NPC, false;
		cloakonnpcself( "Crux#ep162_02" );
		cloakonnpcself( "Man#ep162_02" );
		erasequest 7733;// Pursuit!
		setquest 7734;// Arrest
		terra_gloria_main = 6;
		npctalk "英雄，我们也回宫殿吧？", "Skia#ep162_04", bc_self;
	}
	end;

OnMobDead:
	end;

OnInit:
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "isbegin_quest(7733) == 1" );
	end;
}

// Yuno Airport
y_airport,168,41,3	script	Crux#ep162_04	4_EP16_CRUX,{
	if (terra_gloria_main < 7) {
		npctalk "……啊……我想念他。", "", bc_self;
		end;
	}
	if (terra_gloria_main == 7) {
		cutin "ep16_crux_findel01.bmp",2;
		mes "[Crux]";
		mes "我一直在等你。";
		mes "因为行程有变，我们可能会错过彼此。";
		next;
		select("你在护送斯皮卡，对吧？");
		mes "[Crux]";
		mes "我正想谈这件事。";
		mes "你知道我和斯琪亚女士之前请求在朱诺会面吗？";
		next;
		mes "[Crux]";
		mes "朱诺和总统府都有太多双眼睛，所以她们想在其他地方与我们见面。";
		next;
		mes "[Crux]";
		mes "我想斯皮卡女士如果在朱诺待太久会引起注意，所以她立刻去了约定地点。";
		next;
		mes "[Crux]";
		mes "她伪装成游客……现在就在^4d4dff莱赫尔恩的旅馆^000000里。";
		next;
		mes "[Crux]";
		mes "我本想给她送信，告知行程变更。但我以为会在这里遇到她……所以一直等到现在。";
		next;
		cutin "ep16_crux_findel02.bmp",2;
		mes "[Crux]";
		mes "…… ……";
		mes "我们秘密行动时，这种事经常发生。";
		mes "我知道这很可笑，但很抱歉让你白跑一趟。";
		next;
		cutin "ep16_crux_findel01.bmp",2;
		mes "[Crux]";
		mes "不过施瓦茨瓦德政府对此持积极态度。";
		mes "但我不知道那些女士向他们打出了什么牌……";
		next;
		mes "[Crux]";
		mes "好了，我得处理自己的任务。";
		mes "那么我们去^4d4dff莱赫尔恩^000000吧。";
		next;
		if (select( "拜托你了。", "等一下。" ) == 2) {
			mes "[Crux]";
			mes "准备好后告诉我。";
			mes "然后我们就出发。";
			close3;
		}
		mes "[Crux]";
		mes "这边……";
		erasequest 7735;// Secret Action 2
		setquest 7736;// Small differences between sightseeing and secret bussiness
		terra_gloria_main = 8;
		close2;
		warp "lhz_airport",185,37;
		end;
	}
	if (terra_gloria_main == 8) {
		cutin "ep16_crux_findel01.bmp",2;
		mes "[Crux]";
		mes "我们去莱赫尔恩吧。";
		next;
		if (select( "I will count on you.", "Wait a minute." ) == 2) {
			mes "[Crux]";
			mes "准备好后告诉我。";
			mes "然后我们就出发。";
			close3;
		}
		mes "[Crux]";
		mes "这边……";
		close2;
		warp "lhz_airport",185,37;
		end;
	}
	if (terra_gloria_main < 18) {
		cutin "ep16_crux_findel01.bmp",2;
		mes "[Crux]";
		mes "约定地点是^4d4dff艾因布罗克火车站^000000。";
		mes "一名叫^4d4dff懒惰^000000的特工在那里等我们。";
		mes "我们得快点。";
		close3;
	}
	cutin "ep16_crux_findel01.bmp",2;
	mes "[Crux]";
	mes "我从没想过自己会出国旅行……希望一切顺利。";
	close3;

OnInit:
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "isbegin_quest(7735) == 1" );
	end;
}


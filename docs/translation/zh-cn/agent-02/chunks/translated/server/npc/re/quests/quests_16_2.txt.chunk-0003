lhz_in02,239,148,4	script	Philopontess#ep162_01	4_M_PHILOFONTES,{
	if (terra_gloria_main == 8) {
		cutin "ep16_tes01.bmp",2;
		mes "[Tess]";
		mes "我叫菲洛蓬泰丝。你可以叫我泰丝。";
		mes "当然，这件事本该和总统谈……很抱歉只能这样与你见面。";
		next;
		mes "[Tess]";
		mes "大致计划已经确定……";
		mes "需要详细说明吗？";
		next;
		if (select( "请说吧。", "请告诉我们接下来该做什么。" ) == 2) {
			cutin "ep16_tes01.bmp",2;
			mes "[Tess]";
			mes "谢谢你的关心……";
			mes "重复说明同一件事确实很难。";
		}
		else {
			cutin "ep16_spica_nerius01.bmp",0;
			mes "[Spica]";
			mes "哈哈，看来这工作很辛苦。";
			mes "菲洛蓬泰丝？请继续。";
			npctalk "请叫我泰丝。", "Philopontess#ep162_01", bc_self;
			next;
			cutin "ep16_tes01.bmp",2;
			mes "[Tess]";
			mes "" + strcharinfo(0) + "，我不知道你对此了解多少。施瓦茨瓦德的政治局势并不好。";
			next;
			mes "[Tess]";
			mes "如果你记得秘密之翼的崩溃，或许就知道不少。";
			mes "但秘密之翼并没有被完全摧毁。";
			next;
			mes "[Tess]";
			mes "虽然人数不多，但仍有特工从事情报战。";
			next;
			mes "[Tess]";
			mes "我就是其中之一。平时我以秘书身份工作。";
			next;
			mes "[Tess]";
			mes "我之所以参与此事，是因为尼鲁斯家族委托的案件非常特殊。";
			mes "如你所知，政府与企业的关系并不好，而我们需要企业设施方面的合作。";
			next;
			mes "[Tess]";
			mes "所以我们借此机会执行已经制定的计划。";
			next;
			cutin "ep16_spica_nerius02.bmp",0;
			mes "[Spica]";
			mes "那个组织曾被摧毁过，所以武装力量一定不足。我们会支援他们。";
			next;
			cutin "ep16_spica_nerius01.bmp",0;
			mes "[Spica]";
			mes "而你是这项任务的关键人物。";
			mes "拜托你了。";
			next;
			cutin "ep16_tes01.bmp",2;
			mes "[Tess]";
			mes "所以这将是一种合作关系。";
			mes "我们提供情报，并解除对该设施的监控和法律限制。";
			next;
			mes "[Tess]";
			mes "然后我们要让企业彻底失去运转能力。";
			next;
			mes "[Tess]";
			mes "为了避免被企业监视，总统秘密来到这里后立即返回。";
			mes "总统阁下把剩下的工作交给我，所以今后你可以和我合作。";
		}
		next;
		cutin "ep16_tes01.bmp",2;
		mes "[Tess]";
		mes "现在告诉你们今后的计划。";
		mes "公主想夺回你们家族的秘密宝藏，对吧？";
		next;
		mes "[Tess]";
		mes "我们推测拿走宝藏的人是企业的受托人。我们要调查的设施是^4d4dff艾因布罗克附近的废弃工厂区^000000。";
		next;
		mes "[Tess]";
		mes "我们对这个设施了解很多。";
		mes "它正是我们原本计划调查的设施之一。";
		next;
		mes "[Tess]";
		mes "我们可以向企业发公函，请求他们配合调查。但在我们看来，正式请求只会给他们藏匿证据的时间。";
		next;
		mes "[Tess]";
		mes "既然卢恩·米德加尔兹王室正在帮助我们，我们决定进行随机检查。";
		next;
		cutin "ep16_crux_findel03.bmp",1;
		mes "[Crux]";
		mes "抱歉打断你，但这里能战斗的特工只有冒险者和我……";
		next;
		cutin "ep16_tes01.bmp",2;
		mes "[Tess]";
		mes "我明白了。一位经验丰富的冒险者和一名护卫……";
		mes "我们知道武装力量不足，所以准备了其他策略。";
		next;
		mes "[Tess]";
		mes "不过必要时我们需要冒险者的帮助……你叫什么？";
		mes "" + strcharinfo(0) + "，需要你的协助。";
		next;
		select("没问题。 ");
		mes "[Tess]";
		mes "其实我已经想好要与哪个军事团体合作。我相信你认识他们。";
		mes "就是^4d4dff叛乱军^000000。";
		next;
		mes "[Tess]";
		mes "佣兵叛乱后，反对企业的人联合起来，建立了叛乱军。";
		mes "他们会接受我们的提议。";
		next;
		cutin "ep16_spica_nerius05.bmp",0;
		mes "[Spica]";
		mes "叛乱军？那些人？你是认真的吗？";
		mes "当初是政府无视了陷入困境的佣兵。";
		next;
		mes "[Spica]";
		mes "所以他们才自行组织军事团体，并发展到今天……你真的认为他们会站在我们这边？";
		next;
		cutin "ep16_tes03.bmp",2;
		mes "[Tess]";
		mes "你知道得还真不少。";
		mes "当然，我预料到会有些波折。";
		mes "所以我们才需要" + strcharinfo(0) + "。";
		next;
		cutin "ep16_tes01.bmp",2;
		mes "[Tess]";
		mes "他们憎恨我们，所以谈判一直没有进展。这就是问题。";
		mes "这次" + strcharinfo(0) + "和王室家族都站在我们这边。因此总统认为我们胜算很大。";
		next;
		cutin "ep16_tes02.bmp",2;
		mes "[Tess]";
		mes "如果冒险者去和他们谈，他们会听。";
		npctalk "我也不太想面对他们。", "Philopontess#ep162_01", bc_self;
		next;
		cutin "ep16_tes01.bmp",2;
		mes "[Tess]";
		mes "重要的是我们必须得到叛乱军的合作。";
		mes "我们必须能够借用叛乱军的军事力量。";
		next;
		mes "[Tess]";
		mes "而且必须通过叛乱军和该组织来检查设施。只有这样，我们才能批准你调查并夺回秘密宝藏。";
		next;
		cutin "ep16_spica_nerius02.bmp",0;
		mes "[Spica]";
		mes "你的意思是……如果得不到叛乱军的帮助，你们就不能批准调查设施？";
		next;
		mes "[Spica]";
		mes "你已经知道，如果政府联系他们，他们会非常反感。";
		mes "那么我们只有一件事要做。";
		next;
		cutin "ep16_spica_nerius01.bmp",0;
		mes "[Spica]";
		mes "我们必须依靠英勇的冒险者借用叛乱军的军事力量……";
		mes "我明白了。";
		next;
		mes "[Spica]";
		mes "毕竟我们需要的只是调查^4d4dff设施^000000。";
		mes "没有其他要求了。现在结束谈话吧。";
		next;
		cutin "ep16_tes01.bmp",2;
		mes "[Tess]";
		mes "接下来，" + strcharinfo(0) + "，我想说明我们的行程……";
		next;
		cutin "ep16_spica_nerius05.bmp",0;
		mes "[Spica]";
		mes "我们没有其他选择。";
		mes "他们说必须是你。不能是其他人……";
		mes "" + strcharinfo(0) + "……你愿意帮助我们吗？";
		next;
		select("既然开始了，就要完成。 ");
		cutin "ep16_spica_nerius07.bmp",0;
		mes "[Spica]";
		mes "哈哈。" + strcharinfo(0) + "，你从没让我失望。";
		mes "但我不能离开岗位太久。";
		mes "很抱歉不能陪你完成整个任务。";
		npctalk "不过我相信那个人会做得很好……", "Spica Nerius#ep162_02", bc_self;
		next;
		cutin "ep16_tes01.bmp",2;
		mes "[Tess]";
		mes "那么公主，你要回去了。";
		mes "" + strcharinfo(0) + "，请在^4d4dff艾因布罗克^000000与^4d4dff懒惰^000000会面并与他合作。他是我们安排的谈判代表。";
		next;
		mes "[Tess]";
		mes "一名叫^4d4dff懒惰^000000的特工会在^4d4dff艾因布罗克火车站^000000等你。";
		mes "请不要忘记。";
		mes "可以的话请尽快。";
		next;
		mes "[Tess]";
		mes "从现在起，这是一场与时间的赛跑。";
		mes "先谢谢你的支持。";
		mes "我去向总统报告。";
		next;
		cloakonnpcself( "Philopontess#ep162_01" );
		cutin "ep16_spica_nerius05.bmp",0;
		mes "[Spica]";
		mes "……真是个直率的人。";
		mes "我们现在回去吧。";
		mes "看来我们的工作完成了。";
		next;
		cutin "ep16_spica_nerius01.bmp",0;
		mes "[Spica]";
		mes "要拜托你在艾因布罗克与^4d4dff懒惰^000000会面……至于其他问题，我会回宫殿和海涅家族的王子一起处理。";
		next;
		mes "[Spica]";
		mes "那么，" + strcharinfo(0) + "。";
		mes "祝你战场得胜。";
		mes "克鲁克斯，我们回去吧。";
		erasequest 7736;// Small differences between sightseeing and secret bussiness
		setquest 7737;// Together with Rebel
		terra_gloria_main = 9;
		close2;
		setpcblock PCBLOCK_NPC, true;
		npctalk "回头见。", "Crux#ep162_05", bc_self;
		sleep2 2000;
		setpcblock PCBLOCK_NPC, false;
		cloakonnpcself( "Spica Nerius#ep162_02" );
		cloakonnpcself( "Crux#ep162_05" );
		cutin "",255;
		end;
	}
	end;

OnInit:
	cloakonnpc "Spica Nerius#ep162_02";
	cloakonnpc "Crux#ep162_05";
	cloakonnpc "Philopontess#ep162_01";
	end;
}



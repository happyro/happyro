einbroch,239,269,3	script	Unusual person#16nego01	4_M_LAZY,{
	if (terra_gloria_main < 9) {
		cutin "16lei_01.bmp",2;
		mes "[Someone crazy about Yuno]";
		mes "朱诺～来朱诺吧～如果你生而为人，就去朱诺～如果你来到施瓦茨瓦德，就去朱诺～只要你还在呼吸，就去朱诺～";
		close3;
	}
	if (terra_gloria_main == 9) {
		cutin "16lei_01.bmp",2;
		mes "[???]";
		mes "朱诺～来朱诺吧～如果你生而为人，就去朱诺～如果你来到施瓦茨瓦德，就去朱诺～只要你还在呼吸，就去朱诺～";
		emotion ET_BLABLA;
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "他们让我与秘密之翼的特工会面。难道是那个人？不可能……";
		unittalk getcharid(3), "" + strcharinfo(0) + "：和他在一起的每一刻都会很痛苦……一定不是他。", bc_self;
		next;
		mes "[???]";
		mes "哟！很高兴见到你！";
		emotion ET_SURPRISE;
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "不，绝不可能是他……先别理他。";
		emotion ET_THINK, playerattached();
		next;
		mes "[???]";
		mes "苍鹭独自吞鱼。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "苍鹭想喝水？";
		emotion ET_QUESTION, playerattached();
		next;
		cutin "16lei_03.bmp",2;
		mes "[???]";
		mes "那样的话，你应该说‘苍鹭把秘密藏在翅膀里’。离开前没听到吗？";
		npctalk "我的意思是，我的代号是苍鹭。", "", bc_self;
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "你一定把我和别人弄混了……";
		next;
		mes "[???]";
		mes "" + strcharinfo(0) + "，不是你吗……？一定是你！为什么要装作不是？";
		emotion ET_QUESTION;
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "我是" + strcharinfo(0) + "，就是那个人。但是……";
		next;
		cutin "16lei_01.bmp",2;
		mes "[???]";
		mes "你确定什么都不知道吗？我的名字是^0000cd懒惰^000000。当然不是真名。暂时记住这个名字就好。";
		next;
		mes "[???]";
		mes "我被指派与你一起执行这项任务。我们必须请求叛乱军合作。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "如果你是懒惰，那你一定是秘密之翼的特工。对吧？";
		emotion ET_SWEAT, playerattached();
		next;
		cutin "16lei_03.bmp",2;
		mes "[Lazy]";
		mes "小声点～在这种公共场所绝不能说那个词！你必须时刻小心！记住我们正在执行任务！";
		npctalk "我把代号‘苍鹭’教给了他们，你却不知道！谁负责这次联络？吸毒者吗？", "", bc_self;
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "好，好。";
		emotion ET_SWEAT, playerattached();
		next;
		cutin "16lei_02.bmp",2;
		mes "[Lazy]";
		mes "只看你的样子，我就知道他们带来了一个非常聪明的人。而你手上的老茧说明你见多识广。";
		emotion ET_BEST;
		next;
		cutin "16lei_01.bmp",2;
		mes "[Lazy]";
		mes "你还会装作有点天真来让别人放松警惕。你值得卢恩·米德加尔兹王室家族信任。";
		unittalk getcharid(3), "" + strcharinfo(0) + "：请放开我的手。", bc_self;
		npctalk "你的脸为什么在发光！", "", bc_self;
		next;
		cutin "16lei_02.bmp",2;
		mes "[Lazy]";
		mes "我在报告里读到你的资料时，以为你看起来会有点可怕。但亲眼见到你后，你似乎和传闻不同。所以我们必须亲自见面，才能真正了解一个人。";
		next;
		cutin "16lei_01.bmp",2;
		mes "[Lazy]";
		mes "话说回来，你最近怎么样？去过阿鲁纳佩尔兹吗？";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "嗯，去过。算是吧……";

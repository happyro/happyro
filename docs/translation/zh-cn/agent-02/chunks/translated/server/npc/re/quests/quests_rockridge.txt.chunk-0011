			close;
		}
		select("展示你手里的东西。" );
		mes "[麦克菲夫人]";
		mes "这是岩脊山脉硬币。在村子里可以当钱用。我不愿意让你免费帮助我们。至少请收下这个。";
		next;
		mes "[麦克菲夫人]";
		mes "那枚岩脊山脉硬币归你。谢谢你帮助我们。";
		erasequest 1330;// Spotty's Holes
		completequest 1322;// Found Something
		getitem 25250,1;// Coin_Of_Rr
		setquest 1329;// Spotty in the Dreamland
		next;
		mes "[麦克菲夫人]";
		mes "还有，嗯……明天能再帮我们吗？斯波蒂总把家里的东西带到荒地，我们需要找回来。";
		next;
		mes "[麦克菲夫人]";
		mes "斯波蒂累得睡着了。你能明天凌晨4点后再来吗？下次我们会给你东西。";
		// 1329 is here on official but it can bring a potential bug
		// setquest 1329;// Spotty in the Dreamland
		close;

	case 1328:
		if (checkweight(1301,1) == 0) {
			mes "[麦克菲夫人]";
		mes "你找到我们要的东西了吗？你带的东西太多，我看不见。能先^FF0000减轻背包负重^000000吗？";
			close;
		}
		mes "[麦克菲夫人]";
		mes "你找到了！非常感谢。我们一直努力纠正斯波蒂的行为，很不容易。";
		next;
		mes "[麦克菲夫人]";
		mes "这是我们承诺的岩脊山脉硬币。谢谢你替我们搜索荒地。";
		erasequest 1328;// Found Missing Items
		erasequest 1330;// Spotty's Holes
		getitem 25250,1;// Coin_Of_Rr
		setquest 1329;// Spotty in the Dreamland
		next;
		mes "[麦克菲夫人]";
		mes "你能再回来吗？如果不忙，每天凌晨4点后随时欢迎你。";
		close;

	default:// first time
		mes "[麦克菲夫人]";
		mes "我要说多少次，你才会让你的狗离我们的东西远点？你真想让我把它用船送走吗？";
		next;
		mes "[麦克菲先生]";
		mes "为什么？这次它做了什么？";
		next;
		mes "[麦克菲夫人]";
		mes "我再也不能这样生活了！猜猜斯波蒂这次偷了什么？我的戒指！";
		next;
		if (select( "看看发生了什么。", "退出。" ) == 2) {
			mes "[麦克菲夫人]";
			mes "亲爱的！你到底有没有听我说？！";
			close;
		}
		mes "[麦克菲夫人]";
		mes "我来到这片异乡前，妈妈把戒指给了我。我一直珍藏着，结果那条杂种狗偷走了！";
		next;
		mes "[麦克菲先生]";
		mes "你说的是你珍爱的金戒指？糟糕，斯波蒂惹大麻烦了。";
		next;
		mes "[麦克菲夫人]";
		mes "它拿走鞋子和衣物埋进地里时，我努力理解它，但这次不行，不能偷我的戒指！";
		next;
		mes "[麦克菲先生]";
		mes "亲爱的，冷静点。有没有可能是你把它放在了它够得到的地方？";
		next;
		mes "[麦克菲夫人]";
		mes "你在开玩笑吗？除了洗碗或洗衣服，我从不摘下它，";
		mes "即使那时也会放在口袋里。只有这次掉了出来，结果被那条杂种狗拿走了！";
		next;
		mes "[麦克菲夫人]";
		mes "你辞职已经两个月了，不帮忙做家务，反而一直宠着那条狗。它的坏行为都是你的责任！";
		next;
		mes "[麦克菲夫人]";
		mes "我看到它跑进荒地。去找我的戒指。你最好别空手回家！";
		next;
		mes "[麦克菲先生]";
		mes "什么？我是矿工，不是战士。我不能去那里！你知道我的帽子被风吹走时，我都没能在外面待到找到它。";
		next;
		mes "[麦克菲夫人]";
		mes "我不知道，也不在乎！";
		next;
		if (select( "加入谈话。", "算了。" ) == 2) {
			mes "- 这不关我的事。我还是算了。-";
			close;
		}
		mes "[麦克菲先生]";
		mes "哇！天啊，你是谁？";
		next;
		mes "[麦克菲先生]";
		mes "啊，你就是刚来到这里的冒险者。哈哈，别惊讶。我知道是因为";
		next;
		mes "[麦克菲夫人]";
		mes "你整天坐在码头边和狗玩。当然，来来往往的人我都认识。";
		next;
		mes "[麦克菲先生]";
		mes "（咬紧牙关）亲爱的，现在别开始。";
		mes "总之，我们能为你做什么？";
		next;
		if (select( "说你想帮他们找戒指。", "打招呼。" ) == 2) {
			mes "[麦克菲先生]";
			mes "你好，你也好。";
			mes "你真傻。";
			close;
		}
		mes "[麦克菲夫人]";
		mes "嗯？你想帮助我们。谢谢，但不用了。我们付不起钱。";
		next;
		mes "[麦克菲夫人]";
		mes "而且我很清楚，现在没人会免费提供帮助。";
		next;
		mes "[麦克菲先生]";
		mes "等等，亲爱的。你再想想。我们都太害怕水牛强盗，不敢去荒地。";
		next;
		mes "[麦克菲先生]";
		mes "我们没有其他人可求助，我想不到更好的办法。就赌一把，相信这位冒险者。";
		next;
		mes "[麦克菲夫人]";
		mes "你说得对，但是……唉……";
		emotion ET_THINK;
		next;
		mes "[麦克菲夫人]";
		mes "嗯，冒险者，我收回刚才的话。请帮助我们。";
		next;
		mes "[麦克菲夫人]";
		mes "斯波蒂每天挖洞埋东西。如果你在荒地找到洞，请看看里面。";
		next;
		mes "[麦克菲夫人]";
		mes "我和丈夫会在村里找找，以防万一。如果找到什么，请回到这里。";
		setquest 1321;// Spotty and Her Ring
		next;
		mes "[麦克菲先生]";
		mes "我是在荒地捡到斯波蒂的。也许这就是它喜欢待在那里那么久的原因。但它从没走远到无法在吃饭前回家。至少目前没有。";
		next;
		mes "[麦克菲先生]";
		mes "去荒地吧，你会看到我在地图上留下的标记。不用搜索标记以外的地方。";
		next;
		mes "[麦克菲夫人]";
		mes "亲爱的，你至少应该跟冒险者到大门，告诉他该去哪里找。";
		setquest 1330;// Spotty's Holes
		next;
		mes "[麦克菲先生]";
		mes "我、我该去吗？呃，嗯……好吧。";
		close;
	}
	end;

OnInit:
	questinfo( QTYPE_QUEST, QMARK_YELLOW,
		"BaseLevel > 99 && checkquest(1329,PLAYTIME) == -1 && !isbegin_quest(1321) && !isbegin_quest(1322) && !isbegin_quest(1323) && !isbegin_quest(1324) && !isbegin_quest(1325) && !isbegin_quest(1326) && !isbegin_quest(1327) && !isbegin_quest(1328)" );
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "BaseLevel > 99 && (isbegin_quest(1322) == 1 || isbegin_quest(1328) == 1)" );
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "BaseLevel > 99 && checkquest(1329,PLAYTIME) == 2" );
	end;
}

rockrdg1,36,250,5	script	Mr. McPhy#rkdlout	4W_M_02,{
	if (isbegin_quest(1330) == 1) {
		if (isbegin_quest(1321) == 1) {
			mes "[麦克菲先生]";
			mes "我妻子说斯波蒂从后门出去，直接跑过了铁丝网。";
			next;
			mes "[麦克菲先生]";
			mes "但它不可能走太远，因为很快就回到我身边。你沿着围栏走，找找周围飘着白毛的洞吧？";
			cloakoffnpcself( "#rkq1321" );
			cloakoffnpcself( "#rkdqgd11" );
			cloakoffnpcself( "#rkdqgd22" );
			cloakoffnpcself( "#rkdqgd33" );
			close;
		}
		if (isbegin_quest(1322) == 1 || isbegin_quest(1328) == 1) {
			mes "[麦克菲先生]";
		mes "找到什么了吗？那我们回去吧！";
			cloakonnpcself( "Mr. McPhy#rkdlout" );
			close;
		}
		mes "[麦克菲先生]";
		mes "我妻子让我来给你指路，但我不知道它可能去过哪里。";
		next;
		mes "[麦克菲先生]";
		mes "哦，对了！斯波蒂最近掉了很多毛。也许你该找找周围飘着白毛的洞。";
		cloakoffnpcself( "#rkq1321" );
		cloakoffnpcself( "#rkq1323" );
		cloakoffnpcself( "#rkq1324" );
		cloakoffnpcself( "#rkq1325" );
		cloakoffnpcself( "#rkq1326" );
		cloakoffnpcself( "#rkq1327" );
		cloakoffnpcself( "#rkdqgd11" );
		cloakoffnpcself( "#rkdqgd22" );
		cloakoffnpcself( "#rkdqgd33" );
		next;
		mes "[麦克菲先生]";
		mes "而且它似乎不会走太远。大概是因为它还小。我在你的地图中间标了三个可能的位置。不用去更远的地方。";
		close;
	}
	if (isbegin_quest(1322) == 2) {
		mes "[麦克菲先生]";
		mes "啊，冒险者。嘘！请小声点，水牛强盗可能会听到我们。";
		next;
		mes "[麦克菲先生]";
		mes "只要有机会我就来这里，想在斯波蒂把更多东西带到荒地前抓住它。";
		next;
		mes "[麦克菲先生]";
		mes "我妻子说要把它赶走，但她不是认真的。无论多生气，她也从不打它，还总记得给它喂维生素、接种疫苗。";
		next;
		mes "[麦克菲先生]";
		mes "我因为太害怕水牛强盗而辞职时，她什么也没说。她是个好女人。";
		close;
	}
	mes "[麦克菲先生]";
	mes "*倒吸一口气* 水牛强盗！";
	cloakonnpcself( "Mr. McPhy#rkdlout" );
	close;

OnInit:
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "isbegin_quest(1330) == 1 && isbegin_quest(1322) == 0" );
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "isbegin_quest(1330) == 1 && isbegin_quest(1322) == 2 && isbegin_quest(1328) == 0 && isbegin_quest(1329) == 0" );
	end;
}

rockrdg1,170,233,3	script	Hole#rkdqgd1	4_CRACK,{
	setarray .@list[0],1321,1323,1324,1325,1326,1327;
	.@size = getarraysize(.@list);
	for ( .@i = 0; .@i < .@size; .@i++ ) {
		if (isbegin_quest(.@list[.@i]))
			break;
	}
	if (.@list[.@i] == 0) {
		mes "- 地上有一个洞。";
		mes "里面散落着一些白毛。-";
		close;
	}
	mes "- 地上有一个洞。";
	if (strnpcinfo(2) == "rkdqgd3")
		mes "里面只有湿泥土。-";
	else
		mes "里面是空的。-";
	next;
	mes "- 我不用再往更远的地方找了。-";
	close;
}
rockrdg1,183,143,3	duplicate(Hole#rkdqgd1)	Hole#rkdqgd2	4_CRACK
rockrdg1,215,72,3	duplicate(Hole#rkdqgd1)	Hole#rkdqgd3	4_CRACK


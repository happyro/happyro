// Mr. McPhy quests
harboro1,345,61,3	script	Spotty#rockdaily	4_DOG01,{
	if (isbegin_quest(1329) == 1) {
		mes "- 它看起来更像郊狼，而不是狗。-";
		next;
		mes "- 它睡着了，身上沾满泥土，好像在泥里打过滚。我不该叫醒它。-";
		close;
	}
	mes "- 它看起来更像郊狼，而不是狗。-";
	next;
	mes "- 它掉了很多毛。无论走到哪里，肯定都会留下白毛。-";
	close;
}

harboro1,344,61,5	script	Mr. McPhy#rockdaily	4W_M_02,{
	switch( isbegin_quest(1321) ) {
	case 0:
		mes "[麦克菲先生]";
		mes "斯波蒂，你想吃点心吗？嗯？";
		close;
	case 1:
		mes "[麦克菲先生]";
		mes "我和妻子决定分头检查村子，但不知道你回来前能不能完成。";
		close;
	case 2:
		break;
	}
	if (isbegin_quest(1322) == 2 && isbegin_quest(1331) == 0 && isbegin_quest(1332) == 0) {
		mes "[麦克菲先生]";
		mes "冒险者，谢谢你为我妻子去危险区域寻找金戒指。";
		next;
		mes "[麦克菲先生]";
		mes "我相信宇宙安排你来到我们身边是天意。能再帮我一个忙吗？";
		next;
		if (select( "听他说什么。", "拒绝。" ) == 2) {
			mes "[麦克菲先生]";
			mes "这次我真的能报答你。如果改变主意，请告诉我。";
			close;
		}
		mes "[麦克菲先生]";
		mes "我们家里有一把用于自卫的步枪，前几天我发现斯波蒂看到它时抖得像片叶子。";
		next;
		mes "[麦克菲先生]";
		mes "幸好我害怕到没给它装弹。斯波蒂闻到火药味就不会回家了。";
		next;
		mes "[麦克菲先生]";
		mes "我想有人在斯波蒂附近开了枪，但不是在村里。要是在村里，我们一定听得到。";
		next;
		mes "[麦克菲先生]";
		mes "我想是在荒地发生的，某个水牛强盗朝我们的狗开枪。你能替我为斯波蒂报仇吗？";
		next;
		mes "[麦克菲先生]";
		mes "自从你带回我妻子的金戒指，我一直接零工补贴收入。现在我们付得起报酬了。";
		next;
		if (select( "帮助他。", "拒绝。" ) == 2) {
			mes "[麦克菲先生]";
			mes "你不怕强盗，对吧？";
			mes "好吧，如果你帮不了我们，我理解。";
			close;
		}
		mes "[麦克菲先生]";
		mes "既然无法确定是谁吓到了斯波蒂，我想请你各猎杀3个黄鬃、黑鬃和白鬃强盗。";
		next;
		mes "[麦克菲先生]";
		mes "我会等你。";
		setquest 1331;
		close;
	}
	if (isbegin_quest(1331) == 1) {
		switch( checkquest(1331,HUNTING) ) {
		case -1:
			mes "[麦克菲先生]";
			mes "斯波蒂，你没事吧？别害怕，爸爸在这里。";
			close;
		case 0:
		case 1:
			mes "[麦克菲先生]";
			mes "那些邪恶的强盗，怎么能在小狗附近开枪？";
			next;
			mes "[麦克菲先生]";
			mes "啊，冒险者。你猎杀了^FF0000每种3个黄鬃、黑鬃和白鬃强盗^000000吗？";
			close;
		case 2:
			if (checkweight(1301,1) == 0) {
				mes "[麦克菲先生]";
				mes "啊，你一定忘了领取报酬。请^FF0000在背包里腾出空间^000000。";
				close;
			}
			mes "[麦克菲先生]";
			mes "你处理掉所有该死的水牛强盗了吗？";
			next;
			mes "[麦克菲先生]";
			mes "但他们数量太多，这点根本不会伤筋动骨。我想继续下去。";
			next;
			mes "[麦克菲先生]";
			mes "我们每天只能做一次。如果一次消灭太多，他们会察觉异常。请明天凌晨4点后再回来。";
			next;
			mes "[麦克菲先生]";
			mes "哦，对了？这是我答应的报酬。谢谢你。";
			erasequest 1331;
			setquest 1332;
			getitem 25250,2;// Coin_Of_Rr
			getexp 14499,13863;
			close;
		}
	}
	if (isbegin_quest(1332) == 1) {
		switch( checkquest(1332,PLAYTIME) ) {
		case -1:
			mes "[麦克菲先生]";
			mes "亲爱的！斯波蒂拿走我的手表了吗？";
			close;
		case 0:
		case 1:
			mes "[麦克菲先生]";
			mes "让我看看现在几点……还没过^FF0000凌晨4点^000000。你能晚点再来吗？";
			close;
		case 2:
			mes "[麦克菲先生]";
			mes "冒险者，我一直在等你！你是来替斯波蒂向水牛强盗复仇的，对吧？";
			next;
			mes "[麦克菲先生]";
			mes "和往常一样，请猎杀^FF0000黄鬃、黑鬃和白鬃强盗各3个^000000。";
			mes "拜托你了！";
			erasequest 1332;// Blood for Blood
			setquest 1331;// Avenging Spotty
			close;
		}
	}
	mes "[麦克菲先生]";
	mes "哦，可怜的斯波蒂。掉了这么多毛，你一定很痒吧。要爸爸帮你梳梳吗？";
	close;

OnInit:
	questinfo( QTYPE_QUEST, QMARK_YELLOW,
		"isbegin_quest(1322) == 2 && (checkquest(1332,PLAYTIME) == 2 || checkquest(1332,PLAYTIME) == -1 && (checkquest(1331,HUNTING) == -1 || checkquest(1331,HUNTING) == 2))" );
	end;
}

// Misc NPCs
rockrdg1,330,104,3	script	Curt Snake#rockc05	4_M_CACTUSMAN2,{
	mes "[柯特·斯内克]";
	mes "最近郊狼经常袭击我们的村庄，所以我们请了一些冒险者来减少它们的数量。";
	next;
	mes "[柯特·斯内克]";
	mes "我们的孩子把狩猎当成娱乐，这让我很担心。";
	mes "我们很早就开始教导孩子如何狩猎，";
	next;
	mes "[柯特·斯内克]";
	mes "我也理解他们想变得和那些冒险者一样强大。";
	mes "但我们仙人掌族狩猎并不是为了取乐。冒险者一直在孩子们身边，让他们明白这一点很困难。";
	close;
}

rockrdg1,299,82,3	script	Tagliatelle#rockc07	4_DR_M_02,{
	mes "[塔利亚泰勒]";
	mes "我喜欢旅行。在帕斯塔旅行时我很开心，也决心用余生游历卢恩·米德加尔兹，以及从王国能够抵达的其他城镇和村庄。";
	next;
	mes "[塔利亚泰勒]";
	mes "我喜欢到新的地方，和当地居民交谈。从他们的生活方式中，我能学到很多东西。";
	next;
	npctalk "*倒吸一口气* 塔内斯卡，我不是告诉过你别敲它吗！", "", bc_self;
	mes "[塔内斯卡]";
	mes "我喜欢这些新乐器！";
	close;

gon_in,18,27,5	script	Madam#gnbs	771,{
	mes "[Shang Hua Yen]";
	mes "呵呵呵~";
	mes "这位是谁？";
	mes "是从外地来的访客~";
	mes "欢迎！";
	next;
	if (select("你好，夫人~:首领在哪里？") == 1) {
		mes "[Shang Hua Yen]";
		mes "你好，亲爱的~";
		close;
	}
	if (Sex == SEX_FEMALE) {
		mes "[Shang Hua Yen]";
		mes "呵呵~他在楼上。";
		mes "哎呀，你真是位漂亮女士~";
		mes "不过别太迷恋我丈夫，好吗？";
		mes "嘻嘻~";
		close;
	}
	mes "[Shang Hua Yen]";
	mes "哦，他在楼上……";
	mes "哎呀~！你真是可爱的年轻人。";
	mes "不过还是远不如我丈夫英俊~";
	mes "嘻嘻~";
	emotion ET_THROB;
	close;
}

gon_dun03,62,222,0	script	Strange dead body#gnbs	111,{
	if (b_sword < 7) {
	mes "这里有一具正在腐烂的尸体。";
	mes "看起来像是被魔物吃掉了。";
		close;
	}
	else if (b_sword > 6 && b_sword < 11) {
	mes "尸体骨头之间有一封留言。";
	mes "要看看吗？";
		next;
		if (select("Yes.:Eew, no!") == 1) {
			mes "^3355FF纸张已经陈旧褪色，";
			mes "上面写着文字。";
			mes "是用血写的。";
			mes "字迹已经褪色，几乎无法阅读……^000000";
			next;
			mes "^FF0000该死，我不敢相信……失败了……";
			mes "Sayum……我本该……";
			mes "小心……呃……但是……断了";
			mes "..pieces.. and separate..";
			mes "我……和";
			mes "这个……^000000";
			next;
			mes "^3355FF其余部分无法辨认……";
			mes "他可能已经无法再坚持……^000000";
			close;
		}
		mes "[ ^6699FF" + strcharinfo(0) + "^000000 ]";
		mes "呃，不要！";
		mes " ";
		mes "好恶心，好恶心，太恶心了！";
		next;
		mes "^3355FFYou feel like there's something important here...";
		mes "但腐烂尸体散发出";
		mes "令人作呕的恶臭。^000000";
		close;
	}
	else if (b_sword == 11 || b_sword == 12) {
		mes "^3355FFIt's a rotting human corpse...";
		mes "我还是直接路过吧。^000000";
		close;
	}
	mes "^3355FFA skeleton chewed up by";
	mes "魔物……我很同情他，";
	mes "但盯着看了一会儿后";
	mes "开始觉得毛骨悚然。^000000";
	close;
}

gonryun,139,142,7	script	Girl##gnbs1	772,{
	if (b_sword < 12) {
		mes "[Shi Ying Xiao]";
		mes "..........";
		mes "我很高兴能遇到";
		mes "来自村外的访客，";
		mes "但因为小偷，我现在很难过……";
		emotion ET_THINK;
		close;
	}
	mes "[Shi Ying Xiao]";
	mes "嘿嘿……";
	mes "我现在好开心~";
	mes "现在有很多访客来到村子。";
	mes "最重要的是，";
	mes "有人找到了我父亲的传家宝~";
	next;
	if (select("I'm glad you're relieved.:That would be me!") == 1) {
		mes "[Shi Ying Xiao]";
		mes "是的，整个村子的气氛";
		mes "似乎平静下来了……";
		mes "找到我父亲宝剑的人一定是伟大的人。";
		close;
	}
	mes "[ ^6699FF" + strcharinfo(0) + "^000000 ]";
	mes "那个人就是我！";
	next;
	mes "[ ^6699FF" + strcharinfo(0) + "^000000 ]";
	mes "我就是你的英雄！";
	next;
	emotion ET_SMILE;
	mes "[Shi Ying Xiao]";
	mes "英雄，非常感谢你给村子带来希望~";
	close;
}


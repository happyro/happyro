prontera,155,285,3	script	Familiar#06_hw01::HWFamiDup	799,{
	mes "[使魔]";
	mes "你好。";
	mes "我是洛莉·露莉忠诚又可爱的使魔。";
	mes "你有洛莉·露莉的邀请函吗？";
	mes "那是一种^4d4dffa前往尼夫海姆的特殊门票^000000。";
	next;
	if (select( "有。:没有。") == 1) {
		mes "[使魔]";
		mes "你想去尼夫海姆吗？";
		mes "万圣节期间可以前往。";
		next;
		if (select( "想去:不想去") == 1) {
			if (countitem(7460) > 0) {
				mes "[使魔]";
				mes "我检查过你的门票了。";
				mes "你现在可以出发。";
				delitem 7460,1; //Nifl_Express_Ticket
				close2;
				warp "nif_in", 18, 20;
				end;
			}
			else {
				mes "[使魔]";
				mes "你这个骗子。";
				mes "你根本没有门票！";
				mes "我要把你的血全吸干，骗子！";
				percentheal -20,0;
				emotion ET_HUK, playerattached();
				close;
			}
		}
		mes "[使魔]";
		mes "好吧。";
		mes "其实有没有前往尼夫海姆的特殊门票都没用。";
		close;
	}
	mes "[使魔]";
	mes "好吧。";
	mes "如果你想问些什么，就给洛莉·露莉一块南瓜派。";
	mes "他喜欢南瓜派。";
	close;
}

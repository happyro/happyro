1@gef,114,137,4	script	Geffen Shoplifter#33	671,4,4,{
	end;
OnTouch:
	if ('gmt_chase != 33) end;
	if('OnTouchOnce9) end;
	set 'OnTouchOnce9,1;
	if (Zeny > 2000) Zeny -= 2000;
	npctalk "吉芬小偷：别跟着我，快把我逼疯了！10000 Zeny~！", instance_npcname("Geffen Shoplifter#33");
	atcommand "@effect 18";
	sleep2 3000;
	unittalk 'gmt_account_id, "You can't run away anymore. I've got you now!";
	sleep2 3000;
	npctalk "吉芬小偷：你真让我火大！看来得把你打趴下！", instance_npcname("Geffen Shoplifter#33");
	sleep2 3000;
	hideonnpc instance_npcname("Geffen Shoplifter#33");
	monster instance_mapname("1@gef"), 114, 137, "Geffen Shoplifter", 2914, 1, instance_npcname("Geffen Shoplifter#33") + "::OnMobKilled";
	end;
OnMobKilled:
	hideoffnpc instance_npcname("Geffen Shoplifter#1");
	//completequest 9288;
	//setquest 9288; // State = 1, Time = 0
	//completequest 9288;
	//setquest 9289; // State = 1, Time = 0
	'gmt_timer_evt3 = 0;
	initnpctimer;
	end;
OnTimer1000:
	'gmt_timer_evt3++;
	
	switch('gmt_timer_evt3) {
		case 1: specialeffect EF_PATTACK, AREA, instance_npcname("Geffen Shoplifter#1"); break;
		case 4: npctalk "吉芬小偷：呃，我不该和别人正面交战……", instance_npcname("Geffen Shoplifter#1"); break;
		case 7: unittalk 'gmt_account_id, "Don't want to be in a fair fight, huh thief?"; break;
		case 10: npctalk "吉芬小偷：嗯……偷 Zeny 是我的工作~我没做错什么~！", instance_npcname("Geffen Shoplifter#1"); break;
		case 13: unittalk 'gmt_account_id, "What? You're stealing from needy people."; break;
		case 16: npctalk "吉芬小偷：好吧，玩得很开心~！我先走了~", instance_npcname("Geffen Shoplifter#1"); break;
		case 17: unittalk 'gmt_account_id, "Hey! Give back what you stole thief!"; break;
		case 20: npctalk "吉芬小偷：哈哈哈~！你什么也得不到~！", instance_npcname("Geffen Shoplifter#1"); break;
		case 22: hideonnpc instance_npcname("Geffen Shoplifter#1"); break;
		case 24:
			if (attachrid('gmt_account_id)) {
				mes "[Geffen 居民]", "我的月薪……", "我该怎么办？", "我还要吃饭……"; next;
				mes "[Geffen 居民]", "你不是小偷吧？", "我的 Zeny 被偷了，我不知道该怎么办。"; next;
				mes "[Lydia]", "哇，真是漫长的一天～", "看来吉芬的小偷都很有钱。", "他们擅长偷窃，但也很容易被偷。";
				cutin "lydia_a.bmp", 0;
				next;
				hideoffnpc instance_npcname("Lydia#1");
				mes "[Lydia]", "喂，你为什么哭？", "发生什么事了？"; next;
				mes "你把扒手的事情告诉了 Lydia。";
				cutin "", 255;
				next;
				mes "[Geffen 居民]", "我该怎么办？", "*抽泣*"; next;
				mes "[Lydia]", "（我从一个看起来像恶棍的家伙那里偷了这个信封）", "……", "你被偷了多少 Zeny？";
				cutin "lydia_a.bmp", 0;
				next;
				mes "[Geffen 居民]", "1,000,000 Zeny！", "那是我的全部积蓄。";
				cutin "", 255;
				next;
				mes "[Lydia]", "哇！这正好和我从扒手那里偷来的信封金额一样。";
				cutin "lydia_a.bmp", 0;
				next;
				mes "[Lydia]", "也许你找的就是这个？", "看看吧！"; next;
				mes "[Geffen 居民]", "让我看看……", "等等，这一定是我的 Zeny！", "非常感谢你帮我找到它！";
				cutin "", 255;
				next;
				hideonnpc instance_npcname("Geffen Resident#1");
				hideoffnpc instance_npcname("Geffen Resident#2");
				mes "[Lydia]", "嗯……这个嘛……", "我可没说要把它还给你……";
				cutin "lydia_a.bmp", 0;
				next;
				mes "[Geffen 居民]", "非常感谢！！", "我永远不会忘记你的善良～！", "我现在就把钱存进银行！", "祝你今天愉快～！！！嗖～！！";
				cutin "", 255;
				next;
				hideonnpc instance_npcname("Geffen Resident#2");
				mes "[Lydia]", "……", "我想……我做了一件好事……？";
				cutin "lydia_a.bmp", 0;
				next;
				mes "你把 Zeny 被盗的事情告诉了 Lydia。";
				cutin "", 255;
				next;
				mes "[Lydia]";
				mes "所以你是想向我要更多 Zeny？";
				mes "Zeny 又不是树上长出来的！";
				cutin "lydia_a.bmp", 0;
				next;
				mes "[Lydia]";
				mes "毕竟那是她的钱……";
				mes "我就把它当作对吉芬魔法大赛的捐赠吧。";
				next;
				mes "[Lydia]";
				mes "我不能把 Zeny 送给大赛参赛者……";
				next;
				mes "[Lydia]";
				mes "我从另一个小偷那里偷来了这张魔法卷轴，拿走它不用担心。";
				sc_start4 SC_GEFFEN_MAGIC1, 3600000, 5, 0, 0, 0, 10000, 1; // flag = 1
				atcommand "@effect 220";
				next;
				mes "[Lydia]";
				mes "我得去参加吉芬魔法大赛。";
				mes "先走了！";
				close2;
				cutin "", 255;
				hideonnpc instance_npcname("Lydia#1");
				sleep2 2000;
				unittalk 'gmt_account_id, "She disappeared before I could thank her...";
				sleep2 3000;
				unittalk 'gmt_account_id, "She seems like a good person...";
				sleep2 3000;
				unittalk 'gmt_account_id, "Well, time to register for the Magic Tournament.";
				stopnpctimer;
				end;
			}
		
			stopnpctimer;
			end;
	}
	
	initnpctimer;
	end;
	
}

1@gef,114,143,0	script	#Event 3 start	139,5,5,{
	end;
OnTouch:
	if ('gmt_event != 0) end;
	if('OnTouchOnce10) end;
	set 'OnTouchOnce10,1;
	'gmt_char_name$ = strcharinfo(0);
	hideonnpc instance_npcname("#Event 3 start");
	disablenpc instance_npcname("#Event 3 start");
	hideoffnpc instance_npcname("Geffen Resident#1");
	//setquest 9288;
	'gmt_timer_evt3 = 0;
	initnpctimer;
	end;
OnTimer1000:
	'gmt_timer_evt3++;
	
	switch('gmt_timer_evt3) {
		case 1: npctalk "吉芬居民：小偷……！小偷~！！", instance_npcname("Geffen Resident#1"); break;
		case 3: npctalk "吉芬居民：帮帮我~！！有人偷走了我的工资！", instance_npcname("Geffen Resident#1"); break;
		case 6: 
			hideoffnpc instance_npcname("Geffen Shoplifter#1");
			'gmt_chase = 1;
			break;
		case 8: npctalk "吉芬小偷：该死……有人看见我了……", instance_npcname("Geffen Shoplifter#1"); break;
		case 11:
			unittalk 'gmt_account_id, "What can I do? I gotta help.";
			stopnpctimer;
			end;
	}
	
	initnpctimer;
	end;
}


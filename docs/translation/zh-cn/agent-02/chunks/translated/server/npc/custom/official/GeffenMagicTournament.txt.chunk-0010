	if ('gmt_event != 0) end;
	'gmt_event = 3;
	unittalk 'gmt_account_id, "Thief! Give that zeny back!! Don't move!!";
	sleep2 3000;
	npctalk "吉芬小偷：威胁我？~！！哎呀，好可怕！你真吓到我了~！！", instance_npcname("Geffen Shoplifter#1");
	sleep2 2000;

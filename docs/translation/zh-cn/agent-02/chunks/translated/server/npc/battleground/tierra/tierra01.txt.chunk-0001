bat_a01,185,270,1	script	Guillaume Blacksmith#a01	851,{
	if (getcharid(4) == $@TierraBG1_id1) {
		mes "[Guillaume Blacksmith]";
		mes "情况紧急！路障被摧毁了！";
		mes "我们可以用 ^3131FF50 个石头、3 个熊筋、500 个金属碎片、30 个粗糙铝和 100 个黄金^000000 修复路障。";
		mes "除了 50 个石头，我们其他材料都有！";
		next;
		switch(select("Repair.:Leave it.")) {
		case 1:
			if (countitem(7049) > 49) {
				mes "[Guillaume Blacksmith]";
				mes "你带来了足够的石头！我们开始修理吧。";
				next;
				mes "..";
				next;
				mes "....";
				next;
				mes "......";
				next;
				mes "........";
				next;
				mes "..........";
				next;
				mes "............";
				next;
				mes "..............";
				next;
				mes "[Guillaume Blacksmith]";
				mes "按正确比例混合石头和黄金。";
				next;
				mes "[Guillaume Blacksmith]";
				mes "按正确比例混合石头和黄金，并塑造路障。";
				next;
				mes "[Guillaume Blacksmith]";
				mes "按正确比例混合石头和黄金，塑造路障，再加入粗糙铝使其更坚固。";
				next;
				mes "[Guillaume Blacksmith]";
				mes "按正确比例混合石头和黄金，塑造路障并加入粗糙铝使其更坚固。现在用金属碎片装饰。";
				next;
				mes "[Guillaume Blacksmith]";
				mes "按正确比例混合石头和黄金，塑造路障并加入粗糙铝使其更坚固。用金属碎片装饰，再用熊筋编织石头！";
				next;
				mes "..............";
				mes "..............";
				mes "..............";
				mes "..............";
				mes "..............";
				next;
				specialeffect EF_REPAIRWEAPON;
				mes "[Guillaume Blacksmith]";
				mes "哇！完成了。";
				mes "我们终于放心了。";
				if (mobcount("bat_a01","barricade#bat_a01_a::OnMyMobDead") < 17) {
					delitem 7049,50; //Stone
					donpcevent "barricade#bat_a01_a::OnEnable";
				}
				close2;
				disablenpc "Guillaume Blacksmith#a01";
				end;
			}
			else {
				mes "[Guillaume Blacksmith]";
				mes "你的石头不够！";
				next;
				mes "[Guillaume Blacksmith]";
				mes "^3131FF我们需要 50 个石头。^000000";
				mes "我们很忙，请快一点。";
				close;
			}
		case 2:
			mes "[Guillaume Blacksmith]";
			mes "敌人来了！我们撤离这里吧！";
			close;
		}
	}
	else {
		mes "[Guillaume Blacksmith]";
		mes "看，敌人来了！";
		close;
	}

OnInit:
	disablenpc "Guillaume Blacksmith#a01";
	end;
}


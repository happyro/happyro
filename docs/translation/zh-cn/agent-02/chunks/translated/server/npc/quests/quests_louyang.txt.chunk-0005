lou_in02,123,39,4	script	Poison King#lou	824,{
	// Attempt to preserve prior quest progress.
	if (ch_poison == 0 && CL_POISONKING != 0) {
		if (QL_POISONKING <= 12) set ch_poison,QL_POISONKING;
		else if (QL_POISONKING == 16) set ch_poison,19;
		else if (QL_POISONKING >= 17) set ch_poison,20;
		// Remove outdated variable.
		set QL_POISONKING,0;
	}
	if (checkweight(1201,1) == 0) {
		mes "^3355FF * Wait a minute! *";
	mes "你现在携带的物品太多。请把一些物品存入卡普拉仓库后再试。^000000";
		close;
	}
	if (ch_poison < 6) {
		mes "[Nagash Arses]";
		mes "我来到这里已经 40 年了。哈哈哈，但感觉没那么久。";
		next;
		mes "[Nagash Arses]";
		mes "过去我是最著名的用毒专家之一。我还以毒创立武术，并组建了自己的武术组织。";
		next;
		mes "[Nagash Arses]";
		mes "如今那些记忆仿佛不真实。我只记得这首诗……";
		next;
		mes "[Nagash Arses]";
		mes "我躺在床上仰望月光";
		mes " ";
		mes "看起来像地上的霜。";
		next;
		mes "[Nagash Arses]";
		mes "抬头仰望明月，";
		mes " ";
		mes "低头思念故乡。";
		next;
		if ((countitem(506) > 0 || countitem(511) > 0 || countitem(716) > 0) && (ch_poison > 0 && rand(1,300) > 99)) {
			switch(select("询问诗歌。:询问故乡。:询问用毒。:询问他的处境。")) {
			case 1:
				mes "[Nagash Arses]";
				mes "啊，你听说过这首诗吗？随着年纪增长，我的记忆越来越差，";
				mes "但我很喜欢这首诗，不想忘记。";
				next;
				mes "[Nagash Arses]";
				mes "希望你愿意帮我记住这首诗……";
				next;
				set .@question_poet,rand(1,4);
				if (.@question_poet == 1) {
					mes "[Nagash Arses]";
					mes "‘^3355FF我躺在床上^000000 [ ] ^3355FF仰望月光^000000。’第一句中 [ ] 里应填什么？";
					next;
					if (select("在地上:和你一起:在床上:在星空中") == 3)
						set .@answer_poet,.@answer_poet + 10;
					mes "[Nagash Arses]";
					mes "‘^3355FF看起来像地上的^000000 [ ] ^3355FF。’第二句中 [ ] 里应填什么？";
					next;
					if (select("霜:露珠:鹅卵石:雪") == 1)
						set .@answer_poet,.@answer_poet + 10;
					mes "[Nagash Arses]";
					mes "现在看看你是否真正理解诗歌。只知道词语没用，它们也必须成为你的一部分。";
					next;
					mes "[Nagash Arses]";
					mes "你如何描述这首诗说话者的整体情绪和语调？";
					next;
					if (select("浪漫:惆怅:后悔:热情") == 2)
						set .@answer_poet,.@answer_poet + 10;
					mes "[Nagash Arses]";
		mes "你认为这首诗的主题是什么？";

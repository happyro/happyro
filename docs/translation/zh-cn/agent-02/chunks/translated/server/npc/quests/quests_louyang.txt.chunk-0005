		mes "嗯……";
			mes "...";
		mes "我明白了……";
			mes "^666666*Mumble mumble...*^000000";
			close;
		}
		mes "[Huang Zhishu]";
		mes ".........";
		mes "^666666*Mumble mumble*^000000";
		close;
	}
	else if (ch_par < 9) {
		mes "[Huang Zhishu]";
		mes "书籍承载作者的精神与思想。任何艺术作品都可以视为通往创作者灵魂的窗口。";
		next;
		mes "[Huang Zhishu]";
		mes "^666666*Mumble mumble...*^000000";
		mes "嗯……我明白了……啊，我明白了……";
		mes "^666666*Mumble mumble...*^000000";
		close;
	}
	else if (ch_par == 9) {
		mes "[Huang Zhishu]";
		mes "书不只是纸张的集合，文字也不只是毫无意义的字母排列。";
		next;
		mes "[Huang Zhishu]";
		mes "对于想丰富人生的人，书籍是教育的重要部分，因为书能传授各种知识。";
		next;
		mes "[Huang Zhishu]";
		mes "尽可能多读书。没有书籍和他人的知识，你永远无法理解生命的本质。";
		next;
		mes "^3355FF*Rummage rummage...*^000000";
		close;
	}
	else if (ch_par == 10) {
		mes "[Huang Zhishu]";
		mes "书不只是纸张的集合，文字也不只是字母排列。";
		next;
		mes "[Huang Zhishu]";
		mes "对于想丰富人生的人，书籍是教育的重要部分，因为它能传授各种知识。";
		next;
		mes "[Huang Zhishu]";
		mes "尽可能多读书。没有书籍和他人的知识，你永远无法理解生命的本质。";
		next;
		mes "[Huang Zhishu]";
		mes "^3355FF*Rummage rummage...*^000000";
		close;
	}
	else if (ch_par < 15) {
		mes "[Huang Zhishu]";
		mes "嗯？你在这里做什么？请别打扰我，我正在学习。";
		next;
		mes "^3355FF*Rummage rummage...*^000000";
		next;
		if (select("抱歉。:我是来取文件的。") == 1) {
			mes "[Huang Zhishu]";
			mes "接受你的道歉。嗯……哦，我明白了……";
			next;
			mes "^3355FF*Rummage rummage...*";
			mes ".........^000000";
			emotion ET_SURPRISE;
			close;
		}
		mes "[Huang Zhishu]";
		mes "嗯？啊……你就是我在等的人。你需要什么文件？";
		next;
		input .@input$;
		switch (ch_par) {
		case 11:
			if (.@input$ == "Residence Transfer Application")
				set .@paper,1;
			break;
		case 12:
			if (.@input$ == "Summer SAT Class Application")
				set .@paper,1;
			break;
		case 13:
			if (.@input$ == "Sandy Dust Phenomenon Report")
				set .@paper,1;
			break;
		case 14:
			if (.@input$ == "Communication Proposal")
				set .@paper,1;
			break;
		}
		mes "[Huang Zhishu]";
		mes "让我看看。你想要……";
		mes ""+ .@input$ +" 文件？";
		next;
		if (.@paper == 1) {
			mes "[Huang Zhishu]";
			mes "我把它放哪了？你要 "+.@input$+"，对吧？我得花点时间找。啊，我想起来放在哪了。";
			next;
			mes "...";
			next;
			mes "...";
			mes "......";
			next;
			mes "...";
			mes "......";
			mes ".........";
			next;
			mes "...";
			mes "......";
			mes ".........";
			mes "............";
			next;
			mes "...";
			mes "......";
			mes ".........";
			mes "............";
			mes "...............";
			next;
			mes "[Huang Zhishu]";
			mes "在这里。几天前有人也要过同一份文件，所以我很容易又找到了。希望对你有用。";
			set ch_par,15;
			for(set .@i,11051; .@i<=11054; set .@i,.@i+1) {
				if (checkquest(.@i) > -1 && checkquest(.@i < 2))
					completequest .@i;
			}
			setquest 11055;
			close;
		}
		mes "[Huang Zhishu]";
		mes "嗯？什么……？";
		next;
		mes "[Huang Zhishu]";
		mes "抱歉，我想我们没有那份文件。你最好确认文件名称后再来问我。";
		close;
	}
	mes "[Huang Zhishu]";
	mes "嗯……？你觉得我该多出去走走吗？不知为何我感觉不太舒服。确实该呼吸新鲜空气了。^666666*哈欠……*^000000";
	emotion ET_OK;
	next;
	mes "[Huang Zhishu]";
		mes "不过你自己也应该多出门！总待在家里不好。年轻时不锻炼，可能影响以后的健康。";
	close;
}

lou_in02,204,169,0	script	Supply Stack#1lou	111,{
	if (MaxWeight - Weight < 2000) {
		mes "^3355FF* Wait a minute! *";
		mes "你携带的物品太多了。请把一些物品存入卡普拉仓库后再试。^000000";
		close;
	}
	if (ch_par == 4) {
		if (rand(1,20) == 7) {
			mes "^3355FF*Rummage rummage*";
		mes "这堆东西里似乎有什么。翻找一下也许能发现东西。^000000";
			next;
			if (rand(1,100) == 67) {
				mes "^3355FF*Rummage rummage*";
				mes "*Rummage rummage*";
				mes "*Rummage rummage*";
				mes "你找到了一剂药。^000000";
				set ch_par,9;
				changequest 11050,11056;
				getitem 7252,1; //Herb_Medicine
				next;
				mes "[Jiang Xiayou]";
			mes "什么……！你找到了……？！";
			mes "呸，真不敢相信！你只是走运！";
				mes "^666666*Grumble grumble*^000000";
				close;
			}
			mes "^3355FF*Rummage rummage*";
			mes "*Rummage rummage*";
			mes "*Rummage rummage*";
		mes "你什么也没找到。^000000";
			next;
			mes "[Jiang Xiayou]";
		mes "嘿，嘿……我告诉过你！现在帮我还不晚。我只请求你一次！";
			emotion ET_FRET, getnpcid(0, "Storage Keeper#lou");
			close;
		}
		mes "^3355FF*Rummage rummage*";
		mes "你什么也没找到，决定放弃搜索。^000000";
		close;
	}
	mes "^3355FF许多东西堆到了天花板。物品杂乱地堆在一起，看起来不可能在这里找到任何东西。^000000";
	next;
	mes "[Jiang Xiayou]";
	mes "嘿，别碰任何东西！弄乱了就得重新堆好，明白吗？不想收拾就别制造混乱！";
	close;
}


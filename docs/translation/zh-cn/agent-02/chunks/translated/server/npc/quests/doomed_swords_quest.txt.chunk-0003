		getitem 1138,1; //Mysteltainn_
		close;
	}
	else if (dmdswrd_Q == 44) {
		callsub S_GetSword,1169,2,0,0;
		getitem 1169,1; //Executioner_
		close;
	}
	else if (dmdswrd_Q == 45) {
		mes "[Huey]";
		mes "那么，你打算如何处理";
		mes "那把被诅咒的剑？无论";
		mes "你做什么，都不要滥用它的力量，";
		mes "这样应该就没事。我相信";
		mes "你永远不会屈服于剑的诅咒。";
		mes "我相信你能战胜它。";
		next;
		mes "[Huey]";
		mes "总之，我真的应该感谢你";
		mes "给我使用技能的机会。";
		mes "我不想让从矮人那里学到的";
		mes "本领白白浪费。";
		mes "谢谢你给了我这个机会。";
		mes "我不会忘记你的帮助。";
		close;
	}
	else {
		mes "[Huey]";
		mes "你知道，我去过很多地方，";
		mes "但摩洛克这里的炎热";
		mes "是我经历过最糟糕的！";
		mes "这里又潮湿又不舒服……";
		mes "我实在受不了这里的天气。";
		mes "真希望这里能凉快一些。";
		close;
	}

S_GetSword:
	if (getarg(2) == 1) {
		mes "^3355FF你伸手进入耀眼的光芒，握住剑柄。光芒消散后，";
		mes "你发现自己已经获得了";
		mes "+getitemname(getarg(0))+"。^000000";
		mes "请好好使用这把剑。";
		mes "它的力量属于值得之人。";
		mes "愿你谨慎对待它。^000000";
		set magum,getarg(3);
		next;
	}
	if (checkweight(getarg(0),1) == 0) {
		mes "[Huey]";
		mes "等等，你身上带了";
		mes "太多东西。";
		mes "最好先存放一些物品，";
		mes "腾出更多物品栏空间。这样我们才能领取那把被诅咒的剑。";
		mes "请先整理你的物品。";
		close;
	}
	.@num = getarg(1);
	mes "[Huey]";
	if (.@num == 0) {
		mes "那、那是血腥之牙！";
		mes "自从矮人教会我五芒星技巧后，";
		mes "我从没想过会看到那把剑。";
		mes "请谨慎使用这件武器。";
		mes "千万不要滥用它的力量。";
	}
	else if (.@num == 1) {
		mes "我不敢相信！";
		mes "你……你被认为";
		mes "有资格使用米斯特汀？";
		mes "小心，不要让";
		mes "它的力量压倒你。";
		mes "只为正义挥舞它……";
	}
	else if (.@num == 2) {
		mes "那、那是……！";
		mes "处刑者选择了";
		mes "让你来挥舞它？";
		mes "你的意志一定非常";
		mes "坚定，或者有其他原因……";
		mes "不要屈服于嗜血冲动。";
	}
	next;
	mes "[Huey]";
	mes "看来我在这里的工作";
	mes "已经完成了。很高兴";
	mes "有机会运用这些古老技能，";
	mes "也很荣幸见到一位值得信赖的冒险者。";
	mes "我的兄弟们应该会感到骄傲。";
	next;
	mes "[Huey]";
	mes "说到这个，";
	mes "如果你遇到 Morf 和";
	mes "Walker，请代我向他们问好。";
	mes "那么，照顾好自己，使用那把剑时务必小心。";
	mes "记得谨慎使用它。";
	set dmdswrd_Q,45;
	return;
}

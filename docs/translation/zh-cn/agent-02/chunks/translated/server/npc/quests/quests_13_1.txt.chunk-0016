			mes "我相信你会觉得我们的交易条件很合理。";
			set ep13_yong1,1;
			close;
		case 2:
			mes "[Cat Paw Agent]";
			mes "好吧，改变主意时随时欢迎回来。";
			close;
		}
	}
	else if (ep13_yong1 == 1) {
		mes "[Cat Paw Agent]";

		mes "我猜你是第一次来的";
		mes "客人，对吧？";
		next;
		mes "[Cat Paw Agent]";
		mes "想和我们签订";
		mes "契约吗？";
		mes "我们保证你在这个远征营地";
		mes "逗留期间，";
		mes "会享受到各种";
		mes "便利服务。";

		case 11: warp "spl_fild02",32,225; end;
		case 12: warp "man_fild02",129,61; end;
	}
}
}

mid_camp,72,94,4	script	Fluffy Gyaruk	421,{
	if (ep13_yong1 < 1) {
		mes "[Fluffy Gyaruk]";
		mes "*吸鼻子* 你闻不到鱼味吗？";
		mes "这里的情况怎么样？";
		close;
	}
	else if (ep13_yong1 == 1) {
		mes "[Fluffy Gyaruk]";
		mes "嗯？";
		mes "哦，是猫掌特工派你来的吗？";
		next;
		select("是。 ");
		mes "[Fluffy Gyaruk]";
		mes "哦，好吧……";
		mes "那么，我该从哪里开始呢？";
		mes "(Mumble Mumble)";
		next;
		select("你们是做什么的？");
		mes "[Fluffy Gyaruk]";
		mes "哦，当然。";
		mes "我可以从那里开始。";
		mes "你在米德加尔特大陆使用过卡普拉公司的服务，对吧？";
		next;
		select("是。 ");
		mes "[Fluffy Gyaruk]";
		mes "猫咪交易所是一家以这片未开发大陆为基地的新贸易公司。";
		next;
		mes "[Fluffy Gyaruk]";
		mes "坦率地说，我们想加入米德加尔特市场，但竞争太激烈了……";
		mes "不仅如此，那里也没有足够的鱼供我们所有人食用……（嘟囔）";
		next;
		select("你们提供什么服务？");
		mes "[Fluffy Gyaruk]";
		mes "*呼噜* 哦，我们的服务范围和卡普拉的地点保存、仓库服务、传送服务等类似。";

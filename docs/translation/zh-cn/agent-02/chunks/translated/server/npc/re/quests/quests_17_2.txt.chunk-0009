
OnInit:
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "isbegin_quest(18016) == 1" );
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "checkquest(18017,HUNTING) == 0 || checkquest(18017,HUNTING) == 1" );
	questinfo( QTYPE_QUEST2, QMARK_YELLOW, "checkquest(18017,HUNTING) == 2" );
	end;
}


// ba_in01,26,266,3	script	Smart Elly#ep18ely01	4_EP17_TABLET,{
ba_in01,26,266,3	script	Smart Elly#ep172_ely01	4_EP17_TABLET,{
	if (checkweight(1000103,15) == 0) {
		mes "你持有的物品太多，无法继续任务。";
		mes "请整理物品栏后再试。";
		close;
	}
	if (ep17_2_main < 32) {
		cutin "ep172_beta.bmp", 2;
		mes "[Elly]";
		mes "你好，客人。";
		mes "我负责飞艇机库的情报。";
		mes "请叫我艾莉。";
		close3;
	}
	if (ep17_2_main == 32) {
		cutin "ep172_beta",2;
		mes "[Elly]";
		mes "你好，客人。";
		mes "我负责飞艇机库的情报。";
		mes "请叫我艾莉。";
		next;
		mes "[Elly]";
		mes "主人摧毁这里后，我暂时去做了其他事，但是……";
		next;
		mes "[Elly]";
		mes "现在应阿尔法的请求回来了。";
		mes "机库的事就交给我艾莉吧。";
		next;
		mes "[Elly]";
		mes "‘入侵者’的首领曾自由进出主人收藏3所在的区域……";
		mes "所以我回来管理这里。";
		npctalk "听起来很麻烦。", "", bc_self;
		next;
		mes "[Elly]";
		mes "收到事件报告后，我们正在追踪推测的路线。";
		mes "不过3号的主系统完全断开，所以追踪并不容易。";
		next;
		mes "[Elly]";
		mes "‘客人’称为‘幻象’的‘入侵者’，有99.9%的可能改动了系统。";
		next;
		mes "[Elly]";
		mes "亲爱的‘客人’，你们在吗？";
		cloakoffnpcself( "Est#ep172_est02" );
		cloakoffnpcself( "Rookie#ep172_rk03" );
		next;
		cutin "ep162_est01",1;
		mes "[Erst]";
		mes "嗯，是啊。怎么了？";
		mes "你从昨晚开始就一直很辛苦。";
		next;
		cutin "16loo_01",0;
		mes "[Rookie]";
		mes "我已经告诉阿尔法，目前能分析的数据已经结束了。";
		next;
		cutin "ep172_beta",2;
		mes "[Elly]";
		mes "是的。我已经发送了数据。";
		mes "目前收不到主人收藏3的信号，但我们捕捉到了一些异常信号。";
		next;
		mes "[Elly]";
		mes "这座设施已经很久没使用，但‘入侵者’秘密使用过它，而且……";
		npctalk "异常信号？", "Rookie#ep172_rk03", bc_self;
		next;
		mes "[Elly]";
		mes "有与宅邸外某些地点进行魔法通信的痕迹。";
		mes "这是间歇性信号。";
		next;
		cutin "ep162_est01",0;
		mes "[Erst]";
		mes "什么，他们经常和外界联系吗？";
		mes "在哪里？企业？";
		next;
		cutin "ep172_beta",2;
		mes "[Elly]";
		mes "根据分析，这是单向接收。";
		mes "似乎在收集外界的报告……";
		next;
		mes "[Elly]";
		mes "因为‘入侵者’使用它进行单向接收，彻底分析代码需要一些时间。";
		next;
		cutin "16loo_01",0;
		mes "[Rookie]";
		mes "那么，艾莉，我想请你做一件事。";
		mes "假装‘入侵者’首领还在这里，继续接收信号。";
		next;
		cutin "ep162_est01",1;
		mes "[Erst]";
		mes "这是个聪明的做法，菜鸟。";
		mes "这样我们就能追踪外面的其他同伙。";
		next;
		cutin "ep172_beta",2;
		mes "[Elly]";
		mes "我会照你说的做。";
		mes "我们会维持‘入侵者’的信息模式，收集宅邸外同伙传来的情报。";
		next;
		cutin "16loo_03",0;
		mes "[Rookie]";
		mes "如果幸运的话，我们也许能找到‘幻象’逃跑时使用的飞艇路线。";
		next;
		cutin "ep162_est01",1;
		mes "[Erst]";
		mes "所以我们最终还是没能在这里抓住‘幻象’。";
		mes "除了那个孩子。";
		next;
		cutin "16loo_01",0;
		mes "[Rookie]";
		mes "我们保护了宅邸……不能稍微满足一下吗？";
		mes "泰丝似乎正在努力与企业协调，所以我们就做到这里。";
		next;
		cutin "16loo_03",0;
		mes "[Rookie]";
		mes "和往常一样，你做得很好。";
		mes "我们差一点就成功了，下次一定抓住剩下的人。";
		mes "我一直在收集这些，就送给你吧，冒险者。";
		ep17_2_main = 33;
		completequest 18018;
		// note: unlock episode 18 main quest
		getitem 1000103,15;
		getexp 1547004,0;	// getbaseexp_ratio?
		next;
		cutin "ep162_est01",1;
		mes "[Erst]";
		mes "我会待在客房，需要什么就到那里找我。";
		next;
		cutin "16loo_03",0;
		mes "[Rookie]";
		mes "那我去通知大家，并帮助阿尔法。";
		mes "好好照顾艾莉！";
		next;
		cutin "ep172_beta",2;
		mes "[Elly]";
		mes "不用担心这里。";
		mes "我和阿尔蒙德会照顾好。";
		mes "放心吧。";
		close2;
		cutin "",255;
		cloakonnpcself( "Est#ep172_est02" );
		cloakonnpcself( "Rookie#ep172_rk03" );
		end;
	}
	if (ep18_main == 0 && BaseLevel >= 170) {
		cutin "ep172_beta.bmp",2;
		mes "[Elly]";
		mes "还没有收到规律信号。";
		mes "我们也在追踪你的收藏3的下落。";
		next;
		mes "[Elly]";
		mes "不用担心。";
		mes "时间站在我们这边。";
		next;
		mes "[Elly]";
		mes "我们会好好分析情报，如果客人能清理留下的残余就太好了……哦！";
		next;
		mes "[Elly]";
		mes "等一下，请留在这里。";
		mes "很快就结束。";
		mes "时间站在我们这边，对吧？";
		next;
		mes "[Elly]";
		mes "等一下……";
		mes "...";
		mes "...";
		// note: progressbar_npc must be after "next" otherwise the client may crash
		// progressbar_npc "FFFF00",4;
		next;
		progressbar_npc "FFFF00",4;
		mes "[Elly]";
		mes "一旦解密代码，就会很快。";
		mes "最漫长的部分已经结束，感觉转眼就过去了。";
		next;
		mes "[Elly]";
		mes "^0000FF拉赫尔^000000有些东西。";
		mes "当然，我只听说过拉赫尔，从没去过那里。";
		mes "那里的‘同伙’似乎还不知道首领的动向。";
		next;
		mes "[Elly]";
		mes "虽然还不知道主人收藏3的下落，但必须继续收集从这里传来的情报……";
		mes "我们该怎么办？";
		next;
		select( "什么？" );
		mes "[" + strcharinfo(0) + "]";
		mes "我该怎么办？";
		next;
		mes "[Elly]";
		mes "已经大致确定同伙的位置。根据报告，他们正在等待进一步指示，所以……";
		mes "既然如此，我们应该在下达下一步指示前彻底调查那里……";
		cloakoffnpcself( "Rookie#ep181_rk01" );
		cloakoffnpcself( "Est#ep181_est01" );
		 npctalk "新手：你叫我吗？", "Rookie#ep181_rk01", bc_self;
		 npctalk "埃丝特：比我想的快。", "Est#ep181_est01", bc_self;
		next;
		cutin "ep162_est01.bmp",1;
		mes "[Est]";
		mes "好，那么拉赫尔……";
		next;
		cutin "16loo_01.bmp",0;
		mes "[Rookie]";
		mes "拉赫尔……谁去？";
		next;
		cutin "ep172_beta.bmp",2;
		mes "[Elly]";
		mes "我们意见不一致吗？";
		next;
		cutin "16loo_03.bmp",0;
		mes "[Rookie]";
		mes "不完全是……";
		mes "我觉得如果大家都去，会有点尴尬。";
		next;
		cutin "ep162_est01.bmp",1;
		mes "[Est]";
		mes "啊，我明白了。";
		mes "是的，如果叛乱军行动，可能会变成外交问题。";
		next;
		cutin "16loo_03.bmp",0;
		mes "[Rookie]";
		mes "是的，尤其是拉赫尔。";
		mes "……而且宅邸和企业之间的问题还没有全部解决。";
		next;
		cutin "ep172_beta.bmp",2;
		mes "[Elly]";
		mes "我明白了。";
		next;
		mes "[Elly]";
		mes "既然如此……";
		next;
		select( "他们为什么看着我？" );
		cutin "",255;
		mes "[" + strcharinfo(0) + "]";
		mes "我该怎么办？";
		next;
		cutin "ep172_beta.bmp",2;
		mes "[Elly]";
		mes "我们去拉赫尔吧。";
		npctalk "菜鸟：所以是地名啊？", "Rookie#ep181_rk01", bc_self;
		npctalk "埃斯特：地名。", "Est#ep181_est01", bc_self;
		next;
		mes "[Elly]";
		mes "但其他客人都有各自的组织归属，对吧？";
		mes "如果因管辖权发生冲突，会很麻烦。";
		mes "你不知道会花多久，所以不适合陪他们去。";
		next;
		cutin "ep162_est01.bmp",1;
		mes "[Est]";
		mes "听起来你是说一定要亲自去。";
		next;
		cutin "ep172_beta.bmp",2;
		mes "[Elly]";
		mes "是的。";
		mes "请稍等。";
		next;
		progressbar_npc "CCFF",7;
		mes "[Elly]";
		mes "...";
		next;
		mes "[Elly]";
		mes "你已获准。";
		npctalk "会议结束。", "Smart Elly#ep18ely01", bc_self;
		next;
		mes "[Elly]";
		mes "目的不是阻碍，而是支援。";
		mes "我们会跟着你，不会施加压力。";
		mes "把这个给你。";
		next;
		cutin "",255;
		mes "艾莉给的是一个和艾莉长得一模一样、摸起来有些松软的人偶。";
		mes "它也许不是艾莉本人，但是……";
		next;
		cutin "ep172_beta.bmp",2;
		mes "[Elly]";
		mes "我们还有能进行远距离数据收发的设备。";
		mes "因为我们就是这样的存在。";
		next;
		mes "[Elly]";
		mes "不过现在情况有些不同，所以给你一个测试版。";
		 npctalk "别忘了带上它。", "Smart Elly#ep18ely01", bc_self;
		next;
		cutin "16loo_02.bmp",0;
		mes "[Rookie]";
		mes "呃……迷你艾莉？";
		next;
		cutin "ep172_beta.bmp",2;
		mes "[Elly]";
		mes "太好了，我就采用这个名字。";
		mes "我可以收集视觉和听觉等信息，并用自己的资源像化身一样交流。";
		next;
		mes "[Elly]";
		mes "它没有独立核心，所以除非我更新，获得的信息不会在测试版之间共享，";
		mes "如果通信中断，它就只是一具人偶。";
		next;
		cutin "16loo_01.bmp",0;
		mes "[Rookie]";
		mes "需要支援时就联系我们。";
		mes "除了人手之外，我会像艾莉一样毫无保留地支援你。";
		next;
		cutin "ep172_beta.bmp",2;
		mes "[Elly]";
		mes "好的，我会的。";
		mes "请保重自己。";
		npctalk "明明要一起行动，却这样互相道别，真奇怪。", "Smart Elly#ep18ely01", bc_self;
		next;
		mes "[Elly]";
		mes "信号源的大致准确坐标是……";
		mes "大约在<NAVI>[这里]<INFO>rachel,182,176,0,101,0</INFO></NAVI>。";
		ep18_main = 1;
		setquest 8681;
		getitem 400127,1;	// Ep18_Mini_Elly
		close3;
	}
	if (ep18_main == 1) {
		mes "[Elly]";
	mes "祝你前往拉赫尔一路顺风。";
		close;

	}
	cutin "ep172_beta",2;
	mes "[Elly]";
	mes "还没有收到间歇信号。";
	mes "我们也在同时追踪主人收藏3的下落。";
	next;
	mes "[Elly]";
	mes "不用担心。";
	mes "时间站在我们这边。";
	next;
	mes "[Elly]";
	mes "我和阿尔法会好好分析情报，所以请你清理入侵者留下的残余。";
	close3;

OnInit:
	// note: commented (no questinfo at this point)
	// questinfo( QTYPE_QUEST, QMARK_YELLOW, "isbegin_quest(18018) == 1" );

	// check for episode 17.2 completion
	questinfo( QTYPE_QUEST2, QMARK_YELLOW, "isbegin_quest(8681) == 0 && isbegin_quest(18018) == 2 && BaseLevel >= 170" );
	end;
}

ba_in01,22,262,5	duplicate(dummy_cloaked_npc)	Est#ep172_est02	4_F_ESTLOVELOY
ba_in01,24,262,7	duplicate(dummy_cloaked_npc)	Rookie#ep172_rk03	4_M_ROOKIE

ba_maison,33,220,0	script	#ep172_main_evt02	HIDDEN_WARP_NPC,3,3,{
	end;
OnTouch:
	if (ep17_2_main == 33) {
		cloakoffnpcself( "Philofontes#ep172_tes02" );
		cloakoffnpcself( "Crux#ep172_clx02" );
		end;
	}
	end;
}

ba_maison,36,221,3	script(CLOAKED)	Philofontes#ep172_tes02	4_M_PHILOFONTES,{
	mes "[Philofontes]";
	mes "很高兴再次见到你。";
	mes "这位克鲁克斯先生来自卢恩·米德加尔兹。";
	mes "我想他是来传达重要消息的。";
	close;
}

ba_maison,38,219,5	script(CLOAKED)	Crux#ep172_clx02	4_EP16_CRUX,{
	if (ep17_2_main == 33) {
		cutin "ep16_crux_findel02",2;
		mes "[Crux]";
		mes "冒险者！好久不见！";
		mes "我偶尔会从宫廷魔法师那里听到你的消息……";
		next;
		mes "[Crux]";
		mes "如果你有空，要不要和我一起去普隆德拉宫殿？";
		next;
		select( "发生什么事了？" );
		mes "[Crux]";
		mes "王位不能空缺太久。";
		mes "多亏你上次访问特拉·格洛丽亚，加冕仪式很快就会举行。";
		next;
		mes "[Crux]";
		mes "王室家族的每个人都想向你道谢，冒险者。";
		mes "当然，包括我家族的女士们。";
		mes "如果现在出发……";
		next;
		mes "[Crux]";
		mes "我们能及时赶上加冕仪式。";
		mes "我是来接你的。";
		next;
		mes "[Crux]";
		mes "我们走吗？";
		ep17_2_main = 34;
		setquest 18021;
		next;
		if (select( "Let's go right now.", "Let's go a bit later." ) == 2) {
			mes "[Crux]";
			mes "我明白了。你毕竟日程很忙。";
			mes "有什么地方可以让我等吗？";
			next;
			cutin "ep16_tes01",0;
			mes "[Philofontes]";
			mes "宅邸北部有一间客房。";
			mes "叛乱军现在把那里当作休息室，你去那里等可以吗？";
			next;
			cutin "ep16_crux_findel02",2;
			mes "[Crux]";
			mes "是这样吗？";
			mes "那我就在客房等。";
			mes "回头见，" + strcharinfo(0) + "。";
			npctalk "我先走了。";
			close2;
			cutin "",255;
			cloakonnpcself( "Philofontes#ep172_tes02" );
			cloakonnpcself( "Crux#ep172_clx02" );
			end;
		}
		cutin "ep16_tes01",0;
		mes "[Philofontes]";
		mes "我会告诉其他人。";
		mes "回头见。";
		next;
		cutin "ep16_crux_findel02",2;
		mes "[Crux]";
		mes "那么，我们走吧。";
		close2;
		cutin "",255;
		cloakonnpcself( "Philofontes#ep172_tes02" );
		cloakonnpcself( "Crux#ep172_clx02" );
		warp "prt_cas",138,342;
		end;
	}
	end;
}

ba_in01,37,138,0	script	#ep172_main_evt03	HIDDEN_WARP_NPC,2,2,{
	end;
OnTouch:
	if (ep17_2_main == 34)
		cloakoffnpcself( "Crux#ep172_clx01" );
	end;
}

ba_in01,48,146,3	script(CLOAKED)	Crux#ep172_clx01	4_EP16_CRUX,{
	if (ep17_2_main == 34) {
		cutin "ep16_crux_findel02",2;
		mes "[Crux]";
		mes "这里舒适又不错。";
		mes "尼鲁斯家族主宅还有一处美丽的休息区。";
		mes "下班后我们通常一起玩骰子。";
		next;
		mes "[Crux]";
		mes "好了，我们现在走吗？";
		next;
		if (select( "Let's go right now.", "Let's go a bit later." ) == 2) {
			mes "[Crux]";
			mes "我等你。";
			close3;
		}
		mes "[Crux]";
		mes "那么，我们走吧。";
		close2;
		cutin "",255;
		cloakonnpcself();
		warp "prt_cas",138,342;
		end;
	}
	end;
}

prt_cas,138,342,0	script	#ep172_main_evt04	HIDDEN_WARP_NPC,3,3,{
	end;
OnTouch:
	if (ep17_2_main == 34) {
		setpcblock PCBLOCK_NPC, true;
		sleep2 2000;
		specialeffect2 EF_DEVIL10;
		setpcblock PCBLOCK_NPC, false;
	mes "我和克鲁克斯抵达普隆德拉宫殿，宫殿里充满奇妙的兴奋气氛。";
		next;
	mes "大厅里的人，是我们之前见过的王室家族和王室贵族。";
		next;
		cutin "ep171_coronation",4;
	mes "红毯尽头，一名年轻人跪在那里，头上戴着王冠。";
		next;
	mes "他重新获得失去的荣耀，也恢复了自己的尊严。";
		next;
	mes "他曾经只有‘悲惨’这个名字。";
		next;
	mes "上一次，他还只是和我一起看着这个世界。";
		next;
	mes "如今他戴着名为荣耀的王冠，低头面向大地。";
		next;
	mes "宣告的那一刻，新的时代将会开始。";
		next;
	mes "想到自己站在时间流逝的正中央，我的心开始剧烈跳动。";
		next;
	mes "这证明我一直走的道路没有错。";

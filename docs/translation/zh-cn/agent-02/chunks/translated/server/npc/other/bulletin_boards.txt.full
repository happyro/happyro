alberta,111,59,5	script	Bulletin Board#1	837,{
	mes "[艾尔贝塔：港口城市]";
	mes "欢迎来到港口城市艾尔贝塔。";
	next;
	mes "[艾尔贝塔：港口城市]";
	mes "在艾尔贝塔可以找到商人公会，冒险者能在那里转职为商人。";
	next;
	mes "[艾尔贝塔：港口城市]";
	mes "艾尔贝塔提供可靠的海上航行，促进了卢恩·米德加尔王国的对外贸易与繁荣。";
	next;
	mes "[艾尔贝塔：港口城市]";
	mes "码头上能找到外国代表，他们会带游客前往自己的国家。";
	next;
	mes "[艾尔贝塔：港口城市]";
	mes "水手间流传着^338C60海龟岛^000000的传闻。勇敢的冒险者可以调查传闻，亲自了解真相。";
	next;
	mes "[艾尔贝塔：港口城市]";
	mes "艾尔贝塔附近还发现了一艘沉船，已成为冒险者热门的探索地点。";
	next;
	mes "[艾尔贝塔：港口城市]";
	mes "从艾尔贝塔向西北是^1F3A11斐扬^000000。你可以在码头搭乘客船前往^5E5C69依斯鲁得^000000。";
	mes "祝你旅途愉快。";
	close;
}

geffen,124,65,5	script	Bulletin Board#2	837,{
	mes "[吉芬：魔法之城]";
	mes "欢迎来到魔法之城吉芬。吉芬以各种魔法传说闻名。";
	next;
	mes "[吉芬：魔法之城]";
	mes "城内景点包括可转职铁匠的锻造所、培养魔法师的魔法学院，以及巫师转职所需的吉芬塔。";
	next;
	mes "[吉芬：魔法之城]";
	mes "吉芬塔地下有一座地牢，据说会出现可怕魔物。";
	next;
	mes "[吉芬：魔法之城]";
	mes "据说精灵传说中的失落城市盖菲尼亚隐藏在地牢深处。";
	next;
	mes "[吉芬：魔法之城]";
	mes "从吉芬向南是^828E28兽人村^000000，向西是^4C6055古城^000000，向东远处是^6D6FE0普隆德拉^000000，向北是^744B2D米德加尔特山^000000。祝你在吉芬过得愉快。";
	close;
}

izlu2dun,104,92,5	script	Bulletin Board#4	837,{
	mes "[巴亚兰岛]";
	mes "^6B1312注意！^000000";
	mes "依斯鲁得地牢共有 5 层，前几层适合初出茅庐的冒险者。";
	next;
	mes "[巴亚兰岛]";
	mes "深入海底洞穴后，你会遇到更强大的魔物。";
	next;
	mes "[巴亚兰岛]";
	mes "除少数例外，这座地牢的大多数魔物都是水属性。因此，风属性武器会对你很有帮助。";
	close;
}

payon,178,108,5	script	Bulletin Board#06	837,{
	mes "[斐扬：山岳城市]";
	mes "欢迎来到山岳之城斐扬。斐扬最近完成了翻修，希望你喜欢这里整洁美观的街道和建筑。";
	next;
	mes "[斐扬：山岳城市]";
	mes "斐扬以弓术之城闻名。长久以来，居民都靠弓箭狩猎为生。斐扬的弓制作和训练也十分发达。";
	next;
	mes "[斐扬：山岳城市]";
	mes "斐扬有各种护具和武器，尤其适合弓箭手。如果你想成为弓箭手，最好先熟悉这座城市。";
	next;
	mes "[斐扬：山岳城市]";
	mes "斐扬宫位于城市中心。弓箭手村位于斐扬北部，人们可以在那里转职为弓箭手。";
	next;
	mes "[斐扬：山岳城市]";
	mes "弓箭手村附近有^2F0400斐扬洞穴^000000，那里栖息着不死魔物。";
	next;
	mes "[斐扬：山岳城市]";
	mes "从斐扬向东南是^123972艾尔贝塔^000000，向西是^866C4B梦罗克^000000。^5E5C69依斯鲁得^000000和^6D6FE0普隆德拉^000000位于斐扬北方。";
	mes "祝你旅途愉快。"; 
	close;
}

pay_arche,79,31,5	script	Bulletin Board#07	837,{
	mes "[弓箭手村]"; 
	mes "欢迎来到斐扬弓箭手村，新手可以在这里转职为弓箭手。";
	next;
	mes "[弓箭手村]";
	mes "弓箭手村出售弓和紧身衣，这是新晋弓箭手与猎人的必需品。";
	next;
	mes "[弓箭手村]";
	mes "如果你想成为弓箭手，建议先熟悉这个村庄。想成为猎人的话，猎人公会位于斐扬东边的原野。";
	close;
}

prontera,148,49,5	script	Bulletin Board#09	837,{
	mes "[普隆德拉：首都]";
	mes "[卢恩·米德加尔王国]";
	mes "欢迎来到卢恩·米德加尔王国的首都普隆德拉。";
	next;
	mes "[普隆德拉：首都]";
	mes "[卢恩·米德加尔王国]";
	mes "普隆德拉位于卢恩·米德加尔大陆中央，是繁荣的商业城市。";
	next;
	mes "[普隆德拉：首都]";
	mes "[卢恩·米德加尔王国]";
	mes "城内有大教堂，人们可以在那里转职为服事和牧师。";
	next;
	mes "[普隆德拉：首都]";
	mes "[卢恩·米德加尔王国]";
	mes "这里还有城堡，人们可以在那里转职为十字军。";
	next;
	mes "[普隆德拉：首都]";
	mes "[卢恩·米德加尔王国]";
	mes "请尽情探索普隆德拉的街道，城内有各种观光景点。";
	next;
	mes "[普隆德拉：首都]";
	mes "[卢恩·米德加尔王国]";
	mes "需要升级武器和护具时，请前往普隆德拉中央喷泉 5 点钟方向的建筑。";
	next;
	mes "[普隆德拉：首都]";
	mes "[卢恩·米德加尔王国]";
	mes "从普隆德拉向东南是^5E5C69依斯鲁得^000000，最南方是^1F3A11斐扬^000000，最西方是^683C1F吉芬^000000，最北方是^2D3832艾尔帕兰^000000。";
	mes "祝你在普隆德拉玩得愉快。";
	close;
}

morocc,152,110,5	script	Bulletin Board#11	837,{
	mes "[梦罗克：边境城镇]";
	mes "欢迎来到沙漠之城梦罗克。梦罗克建在绿洲上，因此能容纳众多访客与旅人。";
	next;
	mes "[梦罗克：边境城镇]";
	mes "梦罗克城堡位于城市中央。请尽情探索这座城镇，享受独特氛围。不过请看好财物，小心流氓和盗贼。";
	next;
	mes "[梦罗克：边境城镇]";
	mes "从梦罗克向西北可以找到^660000金字塔地牢^000000，向西是^660000斯芬克斯地牢^000000，向东南则是^660000蚂蚁地狱^000000。";
	next;
	mes "[梦罗克：边境城镇]";
	mes "据说刺客公会位于东南方。从梦罗克向东再向北，就能到达^3355FF普隆德拉^000000。";
	close;
}

comodo,210,148,5	script	Bulletin Board#12	837,{
	mes "[科莫多：海滨城市]";
	mes "欢迎！科莫多城被许多";
	mes "来自失落时代的古老遗迹";
	mes "包围着。";
	next;
	mes "[科莫多：海滨城市]";
	mes "只有在科莫多才能找到";
	mes "舞娘公会和诗人公会，";
	mes "冒险者可以在那里";
	mes "转职为舞娘和诗人。";
	next;
	mes "[科莫多：海滨城市]";
	mes "你还可以参观赌场，";
	mes "那里是热门的观光景点";
	mes "和休闲场所。";
	next;
	mes "[科莫多：海滨城市]";
	mes "你可以从当地的工具商人处";
	mes "购买科莫多特产";
	mes "狂暴药水。";
	next;
	mes "[科莫多：海滨城市]";
	mes "科莫多周围有 3 座洞穴，";
	mes "栖息着许多不同的魔物。";
	mes "进入这些区域时，";
	mes "请务必小心。";
	next;
	mes "[科莫多：海滨城市]";
	mes "从科莫多可以通过东洞穴前往";
	mes "^866C4B梦罗克^000000，";
	mes "也可以通过北洞穴前往^7D2272乌姆巴拉^000000。";
	next;
	mes "[科莫多：海滨城市]";
	mes "向东可以找到^BF2B0D帕罗斯";
	mes "^BF2B0D灯塔^000000，流氓公会就在那里。";
	mes "享受科莫多的夜生活吧~";
	close;
}

umbala,137,94,5	script	Bulletin Board#13	837,{
	mes "[乌姆巴拉：乌坦村]";
	mes "欢迎来到乌姆巴拉，";
	mes "乌坦族的村庄。";
	next;
	mes "[乌姆巴拉：乌坦村]";
	mes "乌姆巴拉和使用独特语言的";
	mes "乌坦族，最近才被几位";
	mes "勇敢的冒险者发现。";
	next;
	mes "[乌姆巴拉：乌坦村]";
	mes "学者认为乌姆巴拉可能是";
	mes "我们世界与另一个领域的边界。";
	mes "他们相信两个世界的连接点";
	mes "可能就是北方的世界树。";
	next;
	mes "[乌姆巴拉：乌坦村]";
	mes "景点包括酋长的房子、萨满的房子";
	mes "以及蹦极区。成千上万的游客";
	mes "来到蹦极区挑战自己的勇气。";
	next;
	mes "[乌姆巴拉：乌坦村]";
	mes "从乌姆巴拉向南前往";
	mes "^D91B73科莫多^000000。请享受在乌姆巴拉的";
	mes "时光。";
	close;
}


}

niflheim,200,191,5	script	Bulletin Board#25	837,{
	mes "[死者之城，尼夫海姆]";
	mes "欢迎来到死者之城尼夫海姆。";
	mes "尼夫海姆被称为人死后";
	mes "会来到的另一个世界。";
	mes "不过最近，人们发现了神秘树木后方的一条秘密通道。";
	mes "因此，你会看到许多人在这片区域旅行。";
	next;
	mes "[死者之城，尼夫海姆]";
	mes "推荐参观景点是女巫的城堡。";
	mes "与普通城镇不同，尼夫海姆内禁止设置";
	mes "复活点或传送点，城镇内也会刷新魔物。";
	next;
	mes "[死者之城，尼夫海姆]";
	mes "尤其要注意名为";
	mes "^6B1312死灵之王^000000的首领魔物。";
	next;
	mes "[死者之城，尼夫海姆]";
	mes "向西前进会到达^6B1312吉约尔谷^000000，";
	mes "那里栖息着强大而可怕的魔物。";
	mes "新手单人冒险者应立即离开该区域。";
	close;
}


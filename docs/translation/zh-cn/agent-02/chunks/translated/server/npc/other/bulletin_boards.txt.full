glast_01,369,308,5	script	Bulletin Board#28	837,{
	mes "[古城格拉斯特海姆]";
	mes "古城格拉斯特海姆是一座拥有无数层的巨大地牢。";
	mes "这座地牢绝不适合新手或普通冒险者，";
	mes "而是地牢专家的挑战之地。";
	next;
	mes "[古城格拉斯特海姆]";
	mes "这里有许多可怕的魔物，例如^6B1312黑暗领主^000000、";
	mes "^6B1312猫头鹰男爵^000000、^6B1312猫头鹰公爵^000000、^6B1312黑暗幻影^000000、^6B1312血腥骑士^000000、^6B1312深渊骑士^000000、^6B1312奇美拉^000000以及各种被诅咒之剑。";
	next;
	mes "[古城格拉斯特海姆]";
	mes "不过，探险越困难，奖励就越丰厚。";
	mes "因此这座地牢在专家中很受欢迎。";
	mes "祝你地牢探险愉快。";
	close;
}

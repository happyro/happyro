yuno,154,112,5	script	Bulletin Board#17	837,{
	mes "[朱诺：首都]";
	mes "[施瓦茨瓦尔德共和国]";
	mes "欢迎来到贤者之城朱诺。";
	mes "朱诺依靠";
	mes "尤弥尔之心碎片的力量";
	mes "漂浮在空中。";
	next;
	mes "[朱诺：首都]";
	mes "[施瓦茨瓦尔德共和国]";
	mes "想成为贤者的人";
	mes "应该前往贤者城堡，了解";
	mes "贤者职业";
	mes "及其要求。";
	next;
	mes "[朱诺：首都]";
	mes "[施瓦茨瓦尔德共和国]";
	mes "其他著名地点包括";
	mes "魔物博物馆、魔法学院";
	mes "和朱诺图书馆。";
	next;
	mes "[朱诺：首都]";
	mes "[施瓦茨瓦尔德共和国]";
	mes "朱诺附近某处有关于秘密通道的";
	mes "情报，通道通往一个世界，";
	mes "冒险者可以在那里";
	mes "以全新的力量重生。";
	next;
	mes "[朱诺：首都]";
	mes "[施瓦茨瓦尔德共和国]";
	mes "朱诺东南方是^6B1312诺格";
	mes "^6B1312之路^000000，熔岩地牢。诺格之路";
	mes "因凶猛的魔物而臭名昭著，";
	mes "请务必小心。";
	next;
	mes "[朱诺：首都]";
	mes "[施瓦茨瓦尔德共和国]";
	mes "从朱诺向南是卢恩·米德加尔王国的城市";
	mes "^2D3832艾尔帕兰^000000。";
	close;
}

aldebaran,145,105,5	script	Bulletin Board#18	837,{
	mes "[艾尔帕兰：边境城市]";
	mes "欢迎来到艾尔帕兰，卢恩·米德加尔王国的";
	mes "边境城市。";
	mes "艾尔帕兰美丽的运河和";
	mes "雄伟的钟楼是市民的";
	mes "骄傲。";
	next;
	mes "[艾尔帕兰：边境城市]";
	mes "冒险者可以探索位于城市中央的";
	mes "钟楼。其他著名地点包括卡普拉";
	mes "公司总部，以及提供";
	mes "炼金术士转职服务的";
	mes "炼金术士公会。";
	next;
	mes "[艾尔帕兰：边境城市]";
	mes "艾尔帕兰某处有一位训练有素的";
	mes "圣诞老人，可以把你送往魔法小镇";
	mes "^1D2585卢蒂耶^000000。想亲眼看看那里，";
	mes "就去寻找圣诞老人吧。";
	next;
	mes "[艾尔帕兰：边境城市]";
	mes "从这座城市向北是^60D5FD朱诺^000000，";
	mes "向南是^6D6FE0普隆德拉^000000。";
	close;
}

xmas_fild01,75,80,5	script	Bulletin Board#22	837,{

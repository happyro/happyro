//===== rAthena Script =======================================
//= Dynamic NPC: HelpMeShorty.
//===== Description: =========================================
//- [Walkthrough conversion]
//= Short quest to allow the player to summon, via an item, a dynamic NPC that gives basic game information.
//= After level 30, the player can get a costume in exchange for the item.
//===== Changelogs: ==========================================
//= 1.0 First version. [Capuche]
//============================================================

// Starter
izlude,173,210,3	script	Black Shadow#fgtg01	4_CENERE,5,5,{
	if (isbegin_quest(14688) == 0 && BaseLevel < 31) {
		mes "[Black Shadow]";
		mes "带我走！你和我对视了，就必须对我负责！";
		next;
		mes "[Black Shadow]";
		mes "如果你带我走，^0000cd我也会帮忙^000000。我真的能在很多方面帮助你！还会教你^0000cd很多事情^000000！！";
		next;
		mes "[Shorty Notice]";
		mes "^EE0000如果你选择和 Shorty 一起行动，物品^0000cd<帮助我，Shorty>^EE0000会自动放入背包。";
		next;
		mes "[Shorty Notice]";
		mes "在^EE0000背包中使用<帮助我，Shorty>，就能召唤 Shorty 并获得^0000cd帮助和建议^EE0000。";
		next;
		mes "[Shorty Notice]";
		mes "^EE0000达到 31 级后，可以接取前往 Shorty 身边的任务。完成任务后，Shorty 会离开，同时你会获得奖励。";
		next;
		mes "[Shorty Notice]";
		mes "^EE0000在达到 31 级前，可以随时通过^0000cd<分手吧>^EE0000菜单让 Shorty 离开，但之后将再也无法让 Shorty 成为伙伴。";
		next;
		if (select( "好吧，我们一起走。", "我不想一起走。" ) == 2) {
			mes "[Black Shadow]";
			mes "没有我的帮助你能做到吗？你肯定走不了十步就会想起我。人生不就是互相帮助吗？不能这样啊。";
			close;
		}
		mes "[Black Shadow]";
		mes "呼——太好了。我们现在是朋友了吗？";
		next;
		mes "[Black Shadow]";
		mes "顺便问一下，你那是什么眼神……？你害怕我吗？我只是想引人注意，等一下……";
		next;
		cloakonnpcself();
		cloakoffnpcself("Mysterious Creature#fgtg01" );
		mes "[Black Shadow]";
		mes "这样够了吗？";
		next;
		mes "[Shorty]";
		mes "我的名字是 Shorty！！";
		next;
		mes "[Shorty]";
		mes "你的名字是什么？";
		next;
		select( "我的名字是 " + strcharinfo(0) + "." );
		mes "[Shorty]";
		mes "这个名字很好叫。你有包吗？就是挂在腰间的那个。大小刚好能让我进去。";
		next;
		select( "你想进包里？" );
		mes "[Shorty]";
		mes "我能装进你的包。你干嘛这么惊讶？不会太久的，我很快就会离开。";
		next;
		mes "[Shorty]";
		mes "按^0000cdALT+E^000000查看包内，点击消耗品标签就能看到我。";
		next;
		mes "[Shorty]";
		mes "想叫我出来时，快速按两次^0000cd<帮助我，Shorty>^000000，我就会从包里出来帮助你。怎么样？很棒吧？";
		next;
		mes "[Shorty]";
		mes "如果你不想让我待在包里，就带我去^0000cdSalty^000000那里。那是我的目的地，时机到了我就会离开^0000cd你的包^000000。";
		next;
		select( "那个人在哪里？" );
		mes "[Shorty]";
		mes "以后告诉你。我现在想休息。";
		next;
		mes "[Shorty]";
		mes "未来祝你好运！";
		setquest 14688;
		completequest 14688;
		getitem 23278,1;	// HelpmeShorty
		cloakonnpcself("Mysterious Creature#fgtg01" );
		close;
	}
	end;

OnTouch:
	if (isbegin_quest(14688) == 0 && BaseLevel < 31)
		npctalk "救救我！快抱住我！救救我！", "", bc_self;
	end;

OnInit:
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "isbegin_quest(14688) == 0 && BaseLevel < 31" );
	cloakonnpc();
	end;
}

//izlude,173,210,3	script	Mysterious Creature#fgtg01	4_GALAPAGO,5,5,{	// unknown OnTouch effect
izlude,173,210,3	duplicate(dummy_cloaked_npc)	Mysterious Creature#fgtg01	4_GALAPAGO

izlude,161,199,0	script	#fgtg01	HIDDEN_WARP_NPC,3,5,{
	end;
OnTouch:
	if (isbegin_quest(14688) == 0 && BaseLevel < 31)
		cloakoffnpcself( "Black Shadow#fgtg01" );
	end;
}
izlude,194,209,0	duplicate(#fgtg01)	#fgtg02	HIDDEN_WARP_NPC,3,5
izlude,173,210,0	duplicate(#fgtg01)	#fgtg03	HIDDEN_WARP_NPC,3,5


// Exchange npc. Step 1 of 2
payon_in01,193,23,3	script	Chanmo#fgtg01	1_F_ORIENT_01,{
	if (isbegin_quest(14693) == 1) {
		cloakoffnpcself( "Shorty#fgtg004" );
		mes "[Shorty]";
		mes "Salty！Salty～我来了～你等我了吗？等了很久吗？";
		next;
		mes "[In the inn]";
		mes "……";
		next;
		mes "[Shorty]";
		mes "Salty，Salty？Salty？你去哪儿了，Salty？";
		next;
		mes "[Chanmo]";
		mes "你在说谁？";
		next;
		mes "[Shorty]";
		mes "我是来找 Salty 的……我来了，但 Salty 不在。";
		next;
		mes "[Chanmo]";
		mes "Salty？啊，你说的是住在房间里的那位女士。我让她跑腿去了。";
		next;
		mes "[Shorty]";
		mes "跑腿？为什么？";
		next;
		mes "[Chanmo]";
		mes "我很无聊，就让她去取果冻和橡子。";
		next;
		mes "[Shorty]";
		mes "嘿！你从哪里来的？我们是来看 Salty 的，你为什么把她支走了～";
		next;
		mes "[Chanmo]";
		mes "我没有强迫任何人来，而且我拽着 Zug 的脑袋把他滚了出去。所以我把他送走了。";
		next;
		mes "[Shorty]";
		mes "那我能在这里等吗？";
		next;
		mes "[Chanmo]";
		mes "如果你很着急，可以帮忙。你可以在";
		mes "普隆德拉西南偏南的<NAVI>[Coco 的巢穴]<INFO>prt_fild10,318,191,0,101,0</INFO></NAVI>找到 Coco。你可以从 Coco 那里获得很多橡子。";
		next;
		mes "[Shorty]";
		mes "嗯……好吧。主人，我们也一起去 Coco 的巢穴吧。";
		next;
		select("你在这里吗？");
		mes "[Shorty]";
		mes "我想念 Salty。我们去见 Salty 吧。";
		next;
		select("好吧。");
		mes "[Shorty]";
		mes "那么，出发吧！！！";
		cloakonnpcself("Shorty#fgtg004");
		completequest 14693;
		setquest 14694;
		close;
	}
	mes "[Chanmo]";
	mes "我今天需要采集一些橡子和果冻。";
	close;
}

payon_in01,190,24,5	duplicate(dummy_cloaked_npc)	Shorty#fgtg004	4_GALAPAGO



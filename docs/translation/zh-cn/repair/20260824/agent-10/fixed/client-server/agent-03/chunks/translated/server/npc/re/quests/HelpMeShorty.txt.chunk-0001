prt_fild10,318,191,3	script	Salty#fgtg01	4_F_ALCHE_A,{
	if (isbegin_quest(14694) == 1) {
		mes "[Salty]";
		mes "啊！橡子！嗯嗯，橡子果冻！橡子能做什么？当然是吃橡子果冻～";
		next;
		cloakoffnpcself( "Shorty#fgtg005" );
		mes "[Shorty]";
		mes "你看起来很兴奋，Salty。没有我你过得开心吗？";
		next;
		mes "[Salty]";
		mes "嗯？呃嗯？？？Shorty！！！！！！！！！！";
		next;
		mes "[Shorty]";
		mes "没有我你玩得开心吗？没有我你玩得开心吗……";
		next;
		mes "[Salty]";
		mes "Shorty，你为什么在这里？有一天我收到信，说你要离开！！！";
		next;
		mes "[Shorty]";
		mes "事情有很多原因。这件事由我的主人来解释。";
		next;
		mes "[Salty]";
		mes "什么？你绑架了我们的 Shorty？？";
		next;
		select( "不，不是那样……" );
		mes "[Salty]";
		mes "是吗？但是 Shorty！这到底是怎么回事？";
		next;
		mes "[Shorty]";
		mes "我去了斐扬，因为做橡子果冻的奶奶说你来了这里，所以我也来了。";
		next;
		mes "[Salty]";
		mes "好！我也正要出发，不过我们先在普隆德拉停留一会儿，再去斐扬。收拾东西，开始大陆旅行吧！";
		next;
		mes "[Shorty]";
		mes "是啊！主人，和你一起经历的冒险很有趣！";
		next;
		mes "[Salty]";
		mes "我得向你道谢。看来你一直把 Shorty 装在那个小包里。";
		next;
		mes "[Shorty]";
		mes "主人，非常感谢你。";
		next;
		select( "你要离开了吗？" );
		mes "[Shorty]";
		mes "我们的关系不会在这里结束。记住你曾遇见我。Salty，还有其他东西吗？留个纪念。";
		next;
		mes "[Salty]";
		mes "嗯，大概就是这样。";
		next;
		mes "[Shorty]";
		mes "就这些？企鹅？企鹅？你更喜欢企鹅而不是我吗？";
		next;
		mes "[Salty]";
		mes "不，不是……我原本在 Paros 买它是为了纪念你，但现在想想你不是企鹅，所以我就留下了。很可爱吧？";
		next;
		mes "[Shorty]";
		mes "可爱。";
		next;
		mes "[Salty]";
		mes "这个送给你。谢谢你照顾 Shorty！Shorty，我们走吧！";
		next;
		specialeffect EF_TELEPORTATION2;
		cloakonnpcself();
		mes "[Shorty]";
		mes "主人，即使时间过去很久，也别忘了我，成为在大陆上扬名的伟大冒险者！";
		specialeffect EF_TELEPORTATION2, AREA, "Shorty#fgtg005";
		cloakonnpcself( "Shorty#fgtg005" );
		erasequest 14694;
		if (isbegin_quest(14695) > 0)
			erasequest 14695;
		delitem 23278,1;	// HelpmeShorty
		getitem 20267,1;	// C_Penguin_Cap
		getexp 4000,1000;
		close;
	}
	end;

OnInit:
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "isbegin_quest(14694) == 1" );
	cloakonnpc();
	end;
}

prt_fild10,315,189,7	duplicate(dummy_cloaked_npc)	Shorty#fgtg005	4_GALAPAGO


// Base for the dynamic npc
izlude,1,1,0	script	Shorty#fgtg01	4_GALAPAGO,{
	if (isbegin_quest(14689) == 0) {
		mes "[Shorty]";
		mes "做得好。如果以后需要我的帮助，可以这样叫我。";
		next;
		select( "你能怎么帮助我？" );
		mes "[Shorty]";
		mes "你第一次来到这里时什么都不知道，对吧？我会把知道的一切都教给你。^0000cd什么都可以问我！^000000";
		next;
		mes "[Shorty]";
		mes "我还会提供各种有用的^0000cd服务^000000来帮助你狩猎。";
		next;
		mes "[Shorty]";
		mes "我能做的只有用^0000cd速度激发^000000让你快速移动，用^0000cd天使之赐福^000000提升力量、敏捷和智力，但肯定会有帮助，对吧？";
		next;
		mes "[Shorty]";
		mes "是的！如果你叫我出来后一分钟没有说话，我就会回到包里。";
		next;
		mes "[Shorty]";
		mes "事情办完后，让我待着就好。我会四处找你，然后回到包里。我很会跟随。";
		next;
		select( "你什么时候去找名叫 Salty 的人？" );
		mes "[Shorty]";
		mes "不是现在，主人。来自加拉帕戈斯的 Shorty 懂得分寸。等你脱下新手服、开始独自冒险后，Shorty 就会离开。";
		next;
		mes "[Shorty]";
		mes "到那时，即使你抱着我哭，我也会离开你。在那之前，你必须将等级提升到^0000cd31 级^000000左右。在那之前，让我们一起努力吧。";
		setquest 14689;
		completequest 14689;
		next;
	}
	.@state = isbegin_quest(14693);
	.@state = ((.@state == 2 && isbegin_quest(14694) == 1) ? 1 : .@state);

	switch( .@state ) {
	case 0:
		if (BaseLevel < 31)
			break;
		mes "[Shorty]";
		mes "你成长得非常好。所以我现在想去见 Salty。她会担心我的。";
		next;
		select( "现在明白了吗？" );
		mes "[Shorty]";
		mes "Salty 的上一封信说她在^0000cd斐扬旅馆^000000。";
		next;
		mes "[Shorty]";
		mes "我们走";
		mes "去斐扬找到<NAVI>[旅馆]<INFO>payon_in01,193,23,0,101,0</INFO></NAVI>。";
		setquest 14693;
		close;
	case 1:
		break;
	case 2:
		mes "[Shorty]";
		mes "你是谁？你在和我说话吗？我不喜欢陌生人和我说话或碰我。";
		close;
	}
	if (BaseLevel < 31) {
		switch( rand(4) ) {
		case 0:
			mes "[Shorty]";
			mes "打开物品窗口，你会看到^0000cd四个标签^000000。看到了吗？";
			next;
			mes "[Shorty]";
			mes "把不常用或不该卖给 NPC 的物品拖放到^0000cd<个人标签>^000000中，再按底部的交易锁定按钮，就不会误卖这些物品。";
			break;
		case 1:
			mes "[Shorty]";
			mes "主人，你按过^0000cdF12 键^000000吗？周围会出现小白方块。";
			next;
			mes "[Shorty]";
			mes "把技能图标或物品拖到那里。松开后，只要按^0000cd快捷键^000000就能快速方便地使用技能和物品。非常方便。";
			break;
		case 2:
			mes "[Shorty]";
			mes "他说，如果你不需要学院获得的帽子或衣服，可以在^0000cd各职业转职处的自动售货机^000000兑换有用的东西。";
			next;
			mes "[Shorty]";
			mes "Salty 也很会使用。我想要蛤蜊，如果可以的话。";
			break;
		case 3:
			mes "[Shorty]";
			mes "确认狩猎地点后我们就离开吧。那里可能还留有怪物卡片。";
			next;
			mes "[Shorty]";
			mes "这是 Salty 教我的宝贵技巧～你有怪物卡片吗？";
			break;
		}
		setarray .@menu$[0], "Give me strength!", "Where should I go?", "Isn't there anything good?", "How do I take skills and stats?", "Tell me how to operate." ;
	}
	else {
		switch( rand(4) ) {
		case 0:
			mes "[Shorty]";
			mes "主人，你知道除了我们熟悉的米德加尔特大陆，还能乘船去神秘的新地方吗？主要是 Al……Al……Allegro？";
			next;
			mes "[Shorty]";
			mes "^0000cd啊！可以从艾尔贝塔乘船前往^000000！主人，我们以后一起去吧！这是新的冒险！";
			break;
		case 1:
			mes "[Shorty]";
			mes "我听说有不少地下城，连你这样的年轻冒险者也能去。";
			next;
			select( "我怎么这么笨！" );
			mes "[Shorty]";
			mes "主人，你在说什么？总之，有下水道、斐扬洞穴、蚂蚁地下城和沉船。主人，你不想成为地下城之王吗？";
			next;
			select( "如果你替我战斗的话。" );
			mes "[Shorty]";
			mes "主人，你要保护好身体，毕竟只有一条命。";
			break;
		case 2:
			mes "[Shorty]";
			mes "主人准备好了吗？我真的很想去！";
			next;
			select( "那是什么？在哪里？" );
			mes "[Shorty]";
			mes "你不知道 Ohiso、Boiso、Saiso 和^0000cdParamarket^000000吗？没有我主人可怎么办啊？";
			next;
			mes "[Shorty]";
			mes "Paramarket 是一个限量、限时出售市场或街边摊难以找到物品的地方。是个非常适合交易的地方。";
			next;
			select( "怎么去那里？" );
			mes "[Shorty]";
			mes "和^0000cd天堂走廊^000000的 Paramarket 风之人交谈，他会送你过去。";
			break;
		case 3:
			mes "[Shorty]";
			mes "主人，有时你想从街边摊买东西，会想知道现在是否有人出售、是谁在出售。";
			next;
			select( "没错。我甚至没法看完所有摊位。" );
			mes "[Shorty]";
			mes "那样的话可以使用^0000cd目录^000000。现在据说^0000cd天堂或艾尔贝塔商人的自动售货机^000000正在出售。";
			next;
			mes "[Shorty]";
			mes "我今天也想去购物。";
			break;
		}
		setarray .@menu$[5], "Anything good?";
	}
	next;
	mes "[Shorty]";
	mes "你还需要我的帮助吗？";
	next;
	switch( select( .@menu$[0], .@menu$[1], .@menu$[2], .@menu$[3], .@menu$[4], .@menu$[5 ], "信息指南", "我对你说的内容很好奇。", "现在分手。" ) ) {
	case 1:
		switch( checkquest(14695,PLAYTIME) ) {
		case -1:
			mes "[Shorty]";
			mes "主人，我会提供之前答应你的帮助：速度激发和天使之赐福。";
			next;
			mes "[Shorty]";
			mes "但这是我偷学来的，使用后灵魂会疲惫，所以不能无限提供。大约需要半小时才能恢复。";
			next;
			mes "[Shorty]";
			mes "想知道什么时候能再次获得帮助，就用 ALT+U 打开任务窗口，查看底部显示的时间。";
			next;
			mes "[Shorty]";
			mes "去吧！主人！！";
			npcskill "AL_INCAGI",10,99,60;
			npcskill "AL_BLESSING",10,99,60;
			setquest 14695;
			close;
		case 0:
		case 1:
			mes "[Shorty]";
			mes "主人，还没到 30 分钟。我还在努力恢复。等我恢复后会给你更多力量，请稍等。";
			close;
		case 2:
			mes "[Shorty]";
			mes "去吧！主人！！";
			npcskill "AL_INCAGI",10,99,60;
			npcskill "AL_BLESSING",10,99,60;
			erasequest 14695;
			setquest 14695;
			close;
		}
		end;
	case 2:
		mes "[Shorty]";
		mes "主人，你想了解什么？";
		next;
		switch( select( "初心者冒险者之路！", "我想帮助身边的人。", "我不喜欢固定的道路。", "没有我想去的地方。" ) ) {
		case 1:
			mes "[Shorty]";
			mes "我好像在伊兹鲁德入口附近见过一位^0000cd<思考中的弓箭手>^000000老师，但他似乎想了很多事情。去问问发生了什么吧？走吧，走吧～";
			close;
		case 2:
			mes "[Shorty]";
			mes "不如去^0000cd普隆德拉西门^000000外见 Paul 和 Anne？我路过时听说他们需要帮助。";
			next;
			mes "[Shorty]";

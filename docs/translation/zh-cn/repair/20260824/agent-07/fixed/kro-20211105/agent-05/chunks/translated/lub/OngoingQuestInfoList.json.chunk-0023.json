    "13002":{"Title":"冒险者的条件-收集布里甘","Summary":"^FF0000브리간^000000을 ^0000FF50개^000000 수집","IconName":"","NpcSpr":"","NpcNavi":"","NpcPosX":0,"NpcPosY":0,"RewardItemList":[],"RewardEXP":0,"RewardJEXP":0,"Description":["仓库里应该堆着很多布里甘吧？如果不够就赶紧收集。格拉斯特海姆或乌龟岛似乎很容易找到。"]},
    "13003":{"Title":"我笑不出来","Summary":"消灭^FF000030只胡萝卜^000000。","IconName":"","NpcSpr":"","NpcNavi":"","NpcPosX":0,"NpcPosY":0,"RewardItemList":[],"RewardEXP":0,"RewardJEXP":0,"Description":["这是梦罗克一名商人发来的委托。据说格拉斯特海姆的怪物胡萝卜全年供应冰淇淋，生意实在做不下去。乐园团当然知道原因并不是这个……但委托就是委托。"]},
    "13004":{"Title":"处理胡萝卜-等待","Summary":"","IconName":"","NpcSpr":"","NpcNavi":"","NpcPosX":0,"NpcPosY":0,"RewardItemList":[],"RewardEXP":0,"RewardJEXP":0,"Description":["休息也是执行任务的一部分！为了下一项委托，好好休息后再来吧。"]},
    "13005":{"Title":"别碰豆……豆子！","Summary":"消灭^FF000022只阿克拉乌斯^000000。","IconName":"","NpcSpr":"","NpcNavi":"","NpcPosX":0,"NpcPosY":0,"RewardItemList":[],"RewardEXP":0,"RewardJEXP":0,"Description":["你知道异国水果中有一种叫^FF0000豆子^000000的东西吗？听说阿克拉乌斯蜷缩起来时很像那种叫^FF0000豆子^000000的水果。因为^FF0000豆子^000000开出的花被定为异国国花，怪物让它的地位下降，引起了很大骚动。"]},
    "13006":{"Title":"处理阿克拉乌斯-等待","Summary":"","IconName":"","NpcSpr":"","NpcNavi":"","NpcPosX":0,"NpcPosY":0,"RewardItemList":[],"RewardEXP":0,"RewardJEXP":0,"Description":["委托很重要，豆子也很重要。为了不让阿克拉乌斯灭绝，适量完成委托吧。"]},
    "13007":{"Title":"圣地巡礼-1","Summary":"消灭^FF000030只安诺利安^000000。","IconName":"","NpcSpr":"","NpcNavi":"","NpcPosX":0,"NpcPosY":0,"RewardItemList":[],"RewardEXP":0,"RewardJEXP":0,"Description":["听说从修道院经由下水道到达最底层，就是巡礼的旅程。为了让巡礼安全，请消灭下水道里的^FF0000安诺利安^000000。"]},

    "13012":{"Title":"处理牛头人-等待","Summary":"","IconName":"","NpcSpr":"","NpcNavi":"","NpcPosX":0,"NpcPosY":0,"RewardItemList":[],"RewardEXP":0,"RewardJEXP":0,"Description":["休息也是执行任务的一部分！为了下一项委托，好好休息后再来吧。"]},
    "13013":{"Title":"为冒险者着想","Summary":"处理^FF000030只彩蝶精^000000。","IconName":"","NpcSpr":"","NpcNavi":"","NpcPosX":0,"NpcPosY":0,"RewardItemList":[],"RewardEXP":0,"RewardJEXP":0,"Description":["彩蝶精大概是前往异界的冒险者最先遇到的怪物之一。远征队基地似乎希望减少周围的怪物。怪物越多，事故自然就越多。这是一项难得的普通委托。"]},
    "13014":{"Title":"处理彩蝶精-等待","Summary":"","IconName":"","NpcSpr":"","NpcNavi":"","NpcPosX":0,"NpcPosY":0,"RewardItemList":[],"RewardEXP":0,"RewardJEXP":0,"Description":["休息也是执行任务的一部分！为了下一项委托，好好休息后再来吧。"]},
    "13015":{"Title":"创伤","Summary":"处理^FF000030只卢西奥拉·维斯帕^000000。","IconName":"","NpcSpr":"","NpcNavi":"","NpcPosX":0,"NpcPosY":0,"RewardItemList":[],"RewardEXP":0,"RewardJEXP":0,"Description":["这是非常私人的委托。小时候被蜜蜂蜇过成了心理创伤，给这次异界旅行带来了很大障碍……咳咳……对最近增加的异界旅行者来说，似乎确实是必要的委托。"]},
    "13016":{"Title":"处理卢西奥拉·维斯帕-等待","Summary":"","IconName":"","NpcSpr":"","NpcNavi":"","NpcPosX":0,"NpcPosY":0,"RewardItemList":[],"RewardEXP":0,"RewardJEXP":0,"Description":["暂时忘掉这种愚蠢的委托，好好休息后再来吧。"]},
    "13017":{"Title":"与狼共舞","Summary":"处理^FF000030只沙漠之狼^000000。","IconName":"","NpcSpr":"","NpcNavi":"","NpcPosX":0,"NpcPosY":0,"RewardItemList":[],"RewardEXP":0,"RewardJEXP":0,"Description":["听说拉赫尔北方的冰洞窟正在成为新的观光景点。请处理冰洞窟周围的^FF0000沙漠之狼^000000。"]},

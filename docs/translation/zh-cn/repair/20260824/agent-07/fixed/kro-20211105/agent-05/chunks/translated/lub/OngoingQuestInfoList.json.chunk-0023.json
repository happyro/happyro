    "13036":{"Title":"为了亲爱的奶奶-等待中","Summary":"","IconName":"","NpcSpr":"","NpcNavi":"","NpcPosX":0,"NpcPosY":0,"RewardItemList":[],"RewardEXP":0,"RewardJEXP":0,"Description":["奶奶似乎比起故事内容，更享受与人见面。如果有时间，再去拜访吧。"]},
    "13037":{"Title":"咆哮姑娘的故事","Summary":"","IconName":"","NpcSpr":"","NpcNavi":"","NpcPosX":0,"NpcPosY":0,"RewardItemList":[],"RewardEXP":0,"RewardJEXP":0,"Description":["听了咆哮姑娘的故事。虽然微妙地有些奇怪，但奶奶也许会喜欢。"]},

    "13039":{"Title":"拿到艾草糕了","Summary":"去见咆哮姑娘吧。","IconName":"","NpcSpr":"","NpcNavi":"","NpcPosX":0,"NpcPosY":0,"RewardItemList":[],"RewardEXP":0,"RewardJEXP":0,"Description":["拿到艾草糕了！现在还要找柿饼……刚才咆哮姑娘似乎让我们去找她。"]},
    "13040":{"Title":"哈啊哈啊","Summary":"处理^FF000030只洛丽鲁丽^000000。","IconName":"","NpcSpr":"","NpcNavi":"","NpcPosX":0,"NpcPosY":0,"RewardItemList":[],"RewardEXP":0,"RewardJEXP":0,"Description":["秘密结社组织之一“女神与族球”请求我们讨伐尼弗海姆的洛丽鲁丽，理由是这种怪物会对冒险者的心情造成不良影响。在提出更过分的要求之前，似乎只能答应了。"]},
    "13041":{"Title":"处理洛丽鲁丽-等待","Summary":"","IconName":"","NpcSpr":"","NpcNavi":"","NpcPosX":0,"NpcPosY":0,"RewardItemList":[],"RewardEXP":0,"RewardJEXP":0,"Description":["休息也是执行任务的一部分！为了下一项委托，好好休息后再来吧。"]},
    "13042":{"Title":"某位美容师的哀嚎","Summary":"处理^FF000030只梅杜莎^000000。","IconName":"","NpcSpr":"","NpcNavi":"","NpcPosX":0,"NpcPosY":0,"RewardItemList":[],"RewardEXP":0,"RewardJEXP":0,"Description":["这是阿尔贝塔一位美容师发来的委托。她只要看到科莫都西部洞窟的梅杜莎，就想剪掉它蛇一般的头发，甚至已经到了梦里都会出现的程度。为了美容师，处理梅杜莎吧。"]},

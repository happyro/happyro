    "13021":{"Title":"是石头人？是石头人！","Summary":"处理^FF000030只冰巨人^000000。","IconName":"","NpcSpr":"","NpcNavi":"","NpcPosX":0,"NpcPosY":0,"RewardItemList":[],"RewardEXP":0,"RewardJEXP":0,"Description":["你去过拉赫尔地区的冰洞窟吧？下到3楼就能看到一种叫冰巨人的怪物。学者们似乎正在热烈研究它究竟是不是石头人。研究固然重要，但这样下去很危险，请帮忙减少数量。"]},
    "13022":{"Title":"处理冰巨人-等待","Summary":"","IconName":"","NpcSpr":"","NpcNavi":"","NpcPosX":0,"NpcPosY":0,"RewardItemList":[],"RewardEXP":0,"RewardJEXP":0,"Description":["休息也是执行任务的一部分！为了下一项委托，好好休息后再来吧。"]},
    "13023":{"Title":"模糊记忆中的你","Summary":"处理^FF000030只梦魇恐惧者^000000。","IconName":"","NpcSpr":"","NpcNavi":"","NpcPosX":0,"NpcPosY":0,"RewardItemList":[],"RewardEXP":0,"RewardJEXP":0,"Description":["委托人曾和恋人去熔岩地城野餐，拥有幸福的回忆。分手后再次前往，却发现那里全是凶暴的怪物，感到非常悲伤。少女的回忆很珍贵！请守护这份珍贵回忆！"]},
    "13024":{"Title":"处理梦魇恐惧者-等待","Summary":"","IconName":"","NpcSpr":"","NpcNavi":"","NpcPosX":0,"NpcPosY":0,"RewardItemList":[],"RewardEXP":0,"RewardJEXP":0,"Description":["休息也是执行任务的一部分！为了下一项委托，好好休息后再来吧。"]},
    "13025":{"Title":"最后一支舞与我共舞","Summary":"处理^FF000030只迪塔勒^000000。","IconName":"","NpcSpr":"","NpcNavi":"","NpcPosX":0,"NpcPosY":0,"RewardItemList":[],"RewardEXP":0,"RewardJEXP":0,"Description":["因为迪塔勒的袭击，舞会被破坏，几天后还收到恋人的^FF0000分手通知^000000……无法原谅迪塔勒，所以才提出了委托……大概就是这样。妨碍爱情和少女回忆的邪恶之徒！请处理^FF0000迪塔勒^000000。"]},

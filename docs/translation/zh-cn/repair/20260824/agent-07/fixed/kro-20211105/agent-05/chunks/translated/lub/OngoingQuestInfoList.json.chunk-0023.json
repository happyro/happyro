    "13019":{"Title":"吵闹的家伙们","Summary":"处理^FF000030只雪兽^000000。","IconName":"","NpcSpr":"","NpcNavi":"","NpcPosX":0,"NpcPosY":0,"RewardItemList":[],"RewardEXP":0,"RewardJEXP":0,"Description":["据说雪兽粗重的呼吸声给冒险者造成了精神伤害。如果有信心克服噪音，请消灭它们吧。"]},

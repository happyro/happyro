}

alde_alche,13,15,7	script	Studying Man#am	750,{
	if (checkweight(1201,1) == 0) {
		mes "- 等一下！-";
		mes "- 你目前携带了-";
		mes "- 太多物品。-";
		mes "- 请先将物品存入卡普拉仓库-";
		mes "- 再回来。-";
		close;
	}
	mes "[达尔文]";
	if (BaseJob != Job_Merchant) {
		if (BaseJob == Job_Alchemist) {
			mes "啊……";
			mes "你……";
			mes "已经成为";
			mes "炼金术士了。";
			next;
			mes "[达尔文]";
			mes "记住……";
			mes "为了实现梦想，";
			mes "不要失去你珍视的东西。";
			next;
			mes "[达尔文]";
			mes "啊……哈莫娜……我的爱……";
			close;
		}
		else {
			mes "拥有梦想时，";
			mes "你就拥有一切。";
			mes "没有梦想，";
			mes "就再也没有什么可失去。";
			next;
			mes "[达尔文]";
			mes "这双被诅咒的眼睛……";
			mes "很久以前就看不见";
			mes "我的梦想了。哈哈哈哈……";
			next;
			mes "[达尔文]";
			mes "天堂真的存在吗……？";
			mes "没有我的爱……";
			mes "没有哈莫娜……";
			close;
		}
	}
	if (ALCH_Q == 6) {
		mes "...";
		next;
		mes "[Darwin]";
		mes "...";
		mes "......";
		next;
		mes "[Darwin]";
		mes "...";
		mes "......";
		mes "是谁……？";
		next;
		monster "alde_alche",13,15,"Wolf",1013,1;
		killmonsterall "alde_alche";
		mes "[Darwin]";
		mes "是狼？";
		mes "还是人？";
		mes "你一定是在寻找";
		mes "某种东西，对吧？";
		next;
		mes "[Darwin]";
		mes "毕竟……";
		mes "每个人都有想实现的愿望。";
		mes "要小心。";
		mes "别像被花朵吸引的";
		mes "野狼一样。";
		next;
		mes "[Darwin]";
		mes "为了得到别的东西，你可能最终牺牲对自己很珍贵的事物。";
		next;
		mes "[Darwin]";
		mes "培育喜悦和幸福";
		mes "就像培育花朵。";
		mes "如果缺少某样东西，";
		mes "花朵就会枯萎……";
		next;
		mes "[Darwin]";
		mes "是什么带你";
		mes "来到这种地方？";
		next;
		switch(select("我想学习如何进行实验。:再多告诉我一些花的事。:没什么。")) {
		case 1:
			mes "[Darwin]";
			mes "你想学习";
			mes "炼金术？";
			mes "我所知道的一切，";
			mes "都是为了实现";
			mes "自己的梦想而学……";
			next;
			mes "[Darwin]";
			mes "我会教你";
			mes "基础知识……";
			mes "但之后学到的一切";
			mes "都必须由";
			mes "你自己的动机引导。";
			next;
			mes "[Darwin]";
			mes "我会教你";
			mes "制作简单药剂。请立刻";
			mes "带来以下";
			mes "材料。";
			next;
			mes "[Darwin]";
			mes "^551A8B3 Medicine Bowls^000000,";
			mes "^551A8B3 Empty Bottles^000000,";
			mes "^551A8B1 Red Herb^000000,";
			mes "^551A8B1 Yellow Herb^000000 and";
			mes "^551A8B1 White Herb^000000.";
			set ALCH_Q,7;
			changequest 2032,2033;
			next;
			mes "[Darwin]";
			mes "准备好一切后，";
			mes "再回来找我。";
			close;
		case 2:
			mes "[Darwin]";
			mes "花朵……？";
			mes "在我心灵最深处，";
			mes "有一朵";
			mes "依稀记得的花……";
			next;
			mes "[Darwin]";
			mes "为了我所爱的人，";
			mes "我倾尽全部努力";
			mes "研究那件";
			mes "事情。";
			next;
			mes "[Darwin]";
			mes "细节我不会告诉你，";
			mes "但我主要研究的是";
			mes "狼与";
			mes "花朵之间的关系。";
			next;
			mes "[Darwin]";
			mes "但是……";
			mes "那是一朵花。";
			mes "据说它的光芒";
			mes "能让人看见天堂。";
			mes "那朵^551A8B幻觉之花^000000……";
			next;
			mes "[达尔文]";
			mes "我甚至制作了";
			mes "一个炼金生物，";
			mes "但没人相信我能从花朵创造新的生命……";
			next;
			mes "[达尔文]";
			mes "然后……";
			mes "发生了一些事，如今我什么都没有了。时间对我也失去了意义。";
			next;
			mes "[达尔文]";
			mes "啊……哈莫娜……你去了哪里？";
			mes "希望你身处美丽的花田……";
			close;
		case 3:
			mes "[达尔文]";
			mes "想想对你来说最珍贵的东西。";
			mes "如果你不认识它，就无法保护它。";
			close;
		}
	}
	else if (ALCH_Q == 7) {
		mes "...";
		mes "......";
		next;
		mes "[Darwin]";
		mes "...";
		mes "......";
		mes "是谁……？";
		next;
		mes "[达尔文]";
		mes "啊……";
		mes "你就是想学习炼金术的人。";
		mes "一切都准备好了吗？";
		next;
		if (countitem(710) > 0) {
			mes "[达尔文]";
			mes "等等。";
			mes "那朵幻觉之花。";
			mes "你是怎么得到的？";
			next;
			mes "[达尔文]";
			mes "嗯……看来你确实找到了它。";
			mes "幻觉之花很危险，也很珍贵。";
			mes "请务必谨慎保管。";
			mes "它可能会改变你的命运。";
			next;
			mes "那么……";
			mes "你找到了它。";
			mes "幻觉之花很危险，也很珍贵。";
			mes "请务必谨慎保管。";
			mes "它可能会改变你的命运。";
			next;
		}
		else {
			mes "看来你还没找到幻觉之花。";
			mes "继续寻找并完成准备后再回来。";
		}
		close;
	}
	else {
		mes "你还没有完成炼金术士的测试。";
		close;
	}

yuno,111,156,3	script	Euslan	90,{
	if (BaseLevel < 60) {
		mes "[尤斯兰]";
		mes "^333333*咳咳*";
		mes "*咳咳咳*";
		mes "*咳——咳* *抽泣*^000000";
		close;
	}
	if (!hg_ma1) {
		mes "[尤斯兰]";
		mes "^333333*咳咳*";
		mes "*咳咳咳*";
		mes "*咳——咳* *抽泣*^000000";
		next;
		switch(select("无视:和尤斯兰交谈")) {
		case 1:
			mes "[尤斯兰]";
			mes "^333333*吸鼻子*";
			mes "*呼哧 呼哧*";
			mes "*咳咳*^000000";
			close;
		case 2:
			mes "[尤斯兰]";
			mes "*呼哧 呼哧*";
			mes "*咳咳*^000000";
			next;
			mes "^3355FF尤斯兰情绪激动，";
			mes "她带着情绪回应：已经很久没人试图和她说话了。^000000";
			set hg_ma1,1;
			close;
		}
	} else if (hg_ma1 == 1) {
		mes "[尤斯兰]";
		mes "^333333*吸鼻子* *咳嗽";
		mes "*咳咳*";
		mes "*抽泣* *吸鼻子*^000000";
		next;
		switch(select("无视:和尤斯兰交谈")) {
		case 1:
			mes "[尤斯兰]";
			mes "^333333*吸鼻子*";
			mes "*呼哧 呼哧*";
			mes "*咳咳*^000000";
			close;
		case 2:
			mes "[尤斯兰]";
			mes "^333333*吸鼻子*";
			mes "*呼哧 呼哧*";
			mes "*咳咳*^000000";
			next;
			mes "[尤斯兰]";
			mes "哦……";
			mes "你好，你、你想要什么？^333333*咳嗽、^333333抽泣*^000000";
			next;
			break;
		}
		switch(select("没什么！:你还好吗？")) {
		case 1:
			mes "[尤斯兰]";
			mes "哦，对、对不起……";
			mes "^333333*咳咳*^000000我可能认错人了……";
			close;
		case 2:
			mes "[尤斯兰]";
			mes "非、非常感谢你的关心。";
			mes "我的名字是尤斯兰，很高兴认识你。^333333*咳嗽*^000000";
			mes "谢谢你的关心。";
			next;
			mes "[尤斯兰]";
			mes "我一直在这里等未婚夫回来，";
			mes "但好几天没听到他的消息，我开始担心了。";
			mes "我真想自己出去找他。^333333*咳嗽*^000000";
			next;
			mes "[尤斯兰]";
			mes "我真的想见我的蒂埃里。";
			mes "要是我没病，就不会有这些麻烦。^333333*抽泣*^000000哪里";
			mes "是他？^333333*吸鼻子*^000000我的蒂埃里在哪里？";
			mes "我想见他……";
			next;
			break;
		}
		switch(select("让她独处:主动寻找蒂埃里")) {
		case 1:
			mes "[尤斯兰]";
			mes "蒂埃里……^333333*抽泣*^000000";
			mes "你什么时候回家？";
			mes "我好担心……";
			mes "^333333*咳咳*^000000";
			set hg_ma1,2;
			close;
		case 2:
			mes "[尤斯兰]";
			mes "……你真的愿意出去帮我找蒂埃里吗？";
			mes "哦，太谢谢你了！";
			mes "你不知道你的好意对我意义有多大。";
			mes "现在，让我想想……";
			next;
			mes "[尤斯兰]";
			mes "^333333*咳嗽*^000000对了，蒂埃里去旅行了，";
			mes "他乘坐飞艇寻找医生说我治病需要的药。";
			mes "^333333*咳咳*^000000";
			next;
			mes "[尤斯兰]";
			mes "我知道这就像大海捞针，";
			mes "但我能想到的唯一办法，";
			mes "就是问飞艇船员是否知道未婚夫的下落。";
			next;
			mes "[尤斯兰]";
			mes "^333333*咳嗽*^000000哦，对了……";
			mes "我的未婚夫计划调查施瓦茨瓦尔德共和国，";
			mes "所以施瓦茨瓦尔德共和国国内航班的船员也许认识他。";
			next;
			mes "[尤斯兰]";
			mes "如果你找到蒂埃里可能去的地方，";
			mes "请尽快告诉我，好吗？谢谢你让我振作起来，"+strcharinfo(0)+"。";
			set hg_ma1,3;
			setquest 8044;
			close;
		}
	} else if (hg_ma1 == 2) {
		mes "[尤斯兰]";
		mes "我一直在这里等未婚夫回来，";
		mes "但好几天没听到他的消息，我开始担心了。";
		mes "我真想自己出去找他。^333333*咳嗽*^000000";
		next;
		mes "[尤斯兰]";
		mes "我真的想见我的蒂埃里。";
		mes "要是我没病，就不会有这些麻烦。^333333*抽泣*^000000哪里";
		mes "是他？^333333*吸鼻子*^000000我的蒂埃里在哪里？";
		mes "我想见他……";
		next;
		switch(select("让她独处:主动寻找蒂埃里")) {
		case 1:
			mes "[尤斯兰]";
			mes "蒂埃里……^333333*抽泣*^000000";
			mes "你什么时候回家？";
			mes "我好担心……";
			mes "^333333*咳咳*^000000";
			close;
		case 2:
			mes "[尤斯兰]";
			mes "……你真的愿意出去帮我找蒂埃里吗？";
			mes "哦，太谢谢你了！你的好意对我意义重大。";
			mes "现在，让我想想……";
			next;
			mes "[尤斯兰]";
			mes "^333333*咳*^000000没错，蒂埃里乘飞艇去旅行，";
			mes "寻找医生说我治病需要的药。^333333*咳咳*^000000";
			next;
			mes "[尤斯兰]";
			mes "我知道这就像大海捞针，";
			mes "但我能想到的唯一办法，";
			mes "就是问飞艇船员是否知道未婚夫的下落。";
			next;
			mes "[尤斯兰]";
			mes "^333333*咳嗽*^000000哦，对了……";
			mes "我的未婚夫计划调查施瓦茨瓦尔德共和国，";
			mes "所以国内航班的船员也许认识他。";
			next;
			mes "[尤斯兰]";
			mes "如果你找到蒂埃里可能去的地方，";
			mes "请尽快告诉我，好吗？谢谢你让我振作起来，"+strcharinfo(0)+"。";
			set hg_ma1,3;
			setquest 8044;
			close;
		}
	} else if (hg_ma1 == 3 || hg_ma1 == 4) {
		mes "^333333尤斯兰仍在耐心等待蒂埃里回来。";
		mes "你应该遵守对她的承诺，向国内航班的船员询问";
		mes "施瓦茨瓦尔德共和国国内航班上尤斯兰未婚夫的下落。^000000";
		close;
	} else if (hg_ma1 == 5) {
		mes "[尤斯兰]";
		mes "哦，你回来了！";
		mes "^333333*咳嗽*^000000也许希望太渺茫，";
		mes "但你查到我的未婚夫可能在哪里了吗？";
		next;
		select("我在飞艇上遇到了卡茜。");
		mes "[尤斯兰]";
		mes "哦，卡茜在飞艇上工作？";
		mes "我很久没见她了。";
		mes "自从我生病后，我们就失去联系了……不过听到她的消息我很高兴。";
		next;
		mes "[尤斯兰]";
		mes "哦，太幸运了！卡茜知道蒂埃里可能在哪里？";
		mes "^333333*咳嗽*^000000哦，他去了胡格。";
		mes "我有个哥哥住在那里，不过我也有一阵子没听到他的消息了……";
		next;
		mes "[尤斯兰]";
		mes "呃，如果你不介意，能再帮我一个忙吗？";
		mes "如果你去胡格，能找到蒂埃里并告诉他我没事吗？";
		mes "他现在一定很担心……";
		next;
		mes "[尤斯兰]";
		mes "^333333*咳咳*^000000问问我的哥哥可能更好，";
		mes "他在胡格担任";
		mes "宾果游戏协调员，";
		mes "也许知道蒂埃里在哪里。^333333*咳嗽*^000000";
		next;
		mes "[尤斯兰]";
		mes "我知道这要求很多，";
		mes "所以如果不顺路，请别勉强自己。";
		mes "不过，如果你碰巧经过胡格，";
		mes "我还是非常感谢你的帮助。";
		set hg_ma1,6;
		changequest 8046,8047;
		close;
	} else if (hg_ma1 == 6 || hg_ma1 == 7) {
		mes "[尤斯兰]";
		mes "如果你有机会，";
		mes "请去胡格拜访我的哥哥";
		mes "尤克兰，问问他我的蒂埃里可能在哪里。";
		mes "再次感谢你的好意。";
		close;
	} else if (hg_ma1 == 8 || hg_ma1 == 9 || hg_ma1 == 10 || hg_ma1 == 11) {
		mes "^3355FF尤斯兰正在等你带回";
		mes "她未婚夫蒂埃里的消息。你最好";
		mes "回胡格去找他。^000000";
		close;
	} else if (hg_ma1 == 12) {
		mes "[尤斯兰]";
		mes "哦，你回来了！";
		mes "^333333*咳嗽*^000000你能和我的哥哥说上话，";
		mes "并找到我的未婚夫蒂埃里吗？";
		next;
		mes "^333333你告诉尤斯兰，你找到了蒂埃里，";
		mes "并且他设法找到了药。";
		mes "你按照蒂埃里的请求，把药交给了尤斯兰。^000000";
		next;
		mes "[尤斯兰]";
		mes "*吸鼻子* 我配不上这么好的男人。";
		mes "那个傻瓜为什么要为一个";
		mes "像我这样没用的女人费这么多心思。*咳嗽* 我还是不明白……我不明白……";
		next;
		mes "[尤斯兰]";
		mes "非常感谢你的帮助，冒险者，";
		mes "也谢谢你给我带来了这份药。";
		mes "我会等蒂埃里回家，";
		mes "并尽力让自己好起来。^333333*咳嗽*^000000";
		next;
		mes "[尤斯兰]";
		mes ""+strcharinfo(0)+"……";
		mes "我永远不会忘记你为蒂埃里";
		mes "和我所做的一切。";
		mes "我会一直祈祷你冒险时平安。";
		mes "请照顾好自己……";
		close2;
		set hg_ma1,13;
		completequest 8052;
		specialeffect EF_ABSORBSPIRITS;
		if (checkre(3))
			getexp 90000,60000;
		else
			getexp 900000,600000;
		end;
	} else if (hg_ma1 == 13) {
		mes "^3355FF尤斯兰仍在等待她的未婚夫回家，";
		mes "但她看起来比过去安心、";
		mes "放松多了。^000000";
		close;
	}
	
}

que_bingo,49,12,0	script	#Hg_Quest	139,4,4,{

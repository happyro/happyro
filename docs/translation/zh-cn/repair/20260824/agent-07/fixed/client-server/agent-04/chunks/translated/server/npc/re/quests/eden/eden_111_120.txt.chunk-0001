								next;
								cutin "min01",0;
								if (select( "接受委托。", "退出" ) == 1) {
									mes "[Mingmin]";
									mes "请逐一处理它们。这些书包含米德加尔特珍贵的历史，所以我想研究它们。";
									callsub S_Quest,13076,13075;
								}
							}
							break;
						case 3:
							if (checkquest(13078,PLAYTIME) == 0)
								mes "猫头鹰男爵的研究进展顺利。样本越多越好！";
							else if (checkquest(13077,HUNTING) == 1) {
								cutin "아울바론카드",3;  //owl_baron_card
								mes "据说爬上那座塔就能遇到它。至于我，我从没上去过。";

//===== rAthena Script =======================================
//= Eden Group Quests - Mission [111-120]
//===== By: ==================================================
//= Capuche
//===== Current Version: =====================================
//= 1.2
//===== Compatible With: =====================================
//= rAthena Project
//===== Description: =========================================
//= [Official Conversion]
//= Repeatable quests for players between BaseLevel 111 - 120.
//===== Additional Comments: =================================
//= 1.0 First version.
//= 1.1 Added support to Para_Team_Mark_ in Eden Group. [Ragno]
//= 1.2 Added use of F_HasEdenGroupMark function. [Ragno]
//============================================================

moc_para01,17,95,5	script	Mingmin#1	4_F_GENETIC,{
	mes "[Mingmin]";
	if (!callfunc("F_HasEdenGroupMark")) {
		cutin "min02",0;
		mes "陌生人。这里仅限伊甸园成员。";
		mes "我需要基础等级^FF0000111-120^000000的冒险者帮助研究。";
	}
	else if (para_110lv01 == 0) {
		cutin "min02",0;
		mes "......";
		emotion ET_THINK;
		next;
		mes "[Mingmin]";
		mes "（哇……）";
		next;
		mes "基因研究者在自言自语。";
		next;
		mes "[Mingmin]";
		mes "...";
		next;
		mes "[Mingmin]";
		mes "......";
		next;
		mes "[Mingmin]";
		mes "^0000ff问：你是我的仆人吗？^000000";
		next;
		mes "["+ strcharinfo(0) +"]";
		mes "(这个女人在说什么？)";
		emotion ET_THINK, playerattached();
		next;
		mes "[Mingmin]";
		mes "回答我！";
		mes "你是我的仆人吗？";
		emotion ET_THINK;
		next;
		select( "我不是。", "你在胡说？" );
		mes "[Mingmin]";
		mes "你不是？太好了……因为我认为我的仆人应该更有尊严。";
		emotion ET_OHNO;
		next;
		mes "[Mingmin]";
		mes "那么，非仆人……你来这里找什么？";
		next;
		if (select( "没什么特别的。", "任务！你是谁？" ) == 1) {
			mes "[Mingmin]";
			mes "可以，希望你找到所求。";
			emotion ET_OK;
		}
		else {
			mes "[Mingmin]";
			mes "哦我？我是^E51BD8Busaner Mingmin^000000，受伊甸园委托研究怪物。";
			next;
			mes "[Mingmin]";
			mes "我过去在山中实验室独自收集真菌和霉菌。从那以后，我加入了寻找新魔物的小组……";
			next;
			mes "[Mingmin]";
			mes "凭借我的经验，他们让我成为伊甸园的教授。";
			next;
			mes "[Mingmin]";
			mes "总之，我有紧急任务要完成，请稍等。";
			para_110lv01 = 1;
		}
	}
	else if (para_110lv01 == 1) {
		cutin "min02",0;
		mes "^0C0CF2Pop quiz hot shot: 你是我的仆人吗？^000000";
		next;
		select("不是～我是"+ strcharinfo(0) +"，记得吗？");
		mes "[Mingmin]";
		mes "哦，我以前见过你。住在满是真菌的房子里似乎会导致记忆力下降。";
		emotion ET_SURPRISE;
		next;
		mes "[Mingmin]";
		mes "你是谁来着？";
		emotion ET_QUESTION;
		next;
		select("伊甸园委托与研究");
		mes "[Mingmin]";
		mes "啊，这个我记得。";
		next;
		mes "[Mingmin]";
		mes "我正在为伊甸园收集米德加尔特动植物信息。";
		next;
		mes "[Mingmin]";
		mes "目的是科学地分类记录世界的危险。我个人并不喜欢这个想法。";
		next;
		mes "[Mingmin]";
		mes "在这个世界，理论只能带你走到这里。";
		next;
		mes "[Mingmin]";
		mes "此外，走出卢恩-米德加尔特旅行的冒险者，应该有足够经验了解自己。";
		next;
		mes "[Mingmin]";
		mes "这只是^ff0000我的意见^000000，别放在心上。";
		next;
		mes "[Mingmin]";
		mes "好了，说了这么多我需要休息。我的脚相当疲惫。";
		emotion ET_SLEEPY;
		para_110lv01 = 2;
	}
	else if (para_110lv01 == 2) {
		cutin "min02",0;
		mes "哦，"+ strcharinfo(0) +"是你……你来了真好，我正无聊呢。";
		next;
		mes "[Mingmin]";
		mes "我说到哪里了？我刚讲完伊甸园保护他人免受危险的职责。";
		next;
		mes "[Mingmin]";
		mes "为了保护更多人，我认为他们需要亲身经历过各种事情的冒险者。";
		next;
		mes "[Mingmin]";
		mes "所以我们需要足够勇敢或鲁莽的人外出收集现场信息。";
		next;
		select("听起来很危险……我什么时候开始？");
		mes "[Mingmin]";
		mes "稍后和我谈，我们就出发。";
		emotion ET_SLEEPY;
		para_110lv01 = 3;
	}
	else if (para_110lv01 == 3) {
		cutin "min02",0;
		mes "提问，"+ strcharinfo(0) +"！我是在练习，因为新仆人很快就要来了。";
		next;
		select("新仆人是什么意思？");
		mes "[Mingmin]";
		mes "哦……抱歉，我是说侍从……";
		mes "我是说冒险者……";
		emotion ET_SURPRISE;
		next;
		mes "[Mingmin]";
		mes "抱歉，我家里的真菌长得太疯狂了。";
		next;
		mes "[Mingmin]";
		mes "我带着伊甸园的委托来到这里时，发现 Rohtert 正在工作。";
		next;
		if (para_100lv02 > 100) {
			mes "[Mingmin]";
			mes "你以前见过他？我和他确实有些渊源。";
		}
		else {
			mes "[Mingmin]";
			mes "就是入口处那个白发的人。如果你感兴趣可以去看看，他负责 100-110 级冒险者。";
		}
		next;
		mes "[Mingmin]";
		mes "总之，他一直在这里工作，所以比我更了解。我只是来向他请教。";
		next;
		mes "[Mingmin]";
		mes "那并不难，所以……";
		next;
		cutin "min01",0;
		mes "[Mingmin]";
		mes "愚蠢的冒险者会来求我：^ff0000‘我的女王，请把我当成淘气的仆人！’^000000";
		next;
		select("......Uh......");
		cutin "min02",0;
		mes "[Mingmin]";
		mes "不知为什么，到现在还没有多少人排队来帮我。";
		emotion ET_THINK, playerattached();
		next;
		mes "[Mingmin]";
		mes "我认为接受新委托需要^ff0000勇气^000000。";
		next;
		mes "[Mingmin]";
		mes "别再磨蹭了，我想和真正渴望冒险的人签订契约。";
		next;
		mes "[Mingmin]";
		mes "也许，"+ strcharinfo(0) +"，如果你有兴趣为我的研究完成伊甸园委托，我可以让你成为我的仆人。";
		para_110lv01 = 4;
	}
	else if (para_110lv01 > 3) {
		cutin "min01",0;
		if (para_110lv01 == 5)
			mes "欢迎！"+ strcharinfo(0) +"……";
		else
			mes "你好，"+ strcharinfo(0) +"。";
			next;
		switch( select( "申请魔物研究委托", "闲聊" ) ) {
			mes "[Mingmin]";
		case 1:
			if (BaseLevel < 111) {
				cutin "min02",0;
				mes "我应该已经告诉过你，我正在寻找经验更丰富的冒险者进行魔物研究。";
				next;
				mes "[Mingmin]";
				mes "因为这项任务包含非常危险的委托。";
				next;
				mes "[Mingmin]";
				mes "让我看看。如果你能完成那边 Rohtert 的所有委托，我会重新考虑。";
				next;
				mes "[Mingmin]";
				mes "等你达到基础等级 111，我会重新考虑。";
			}
			else if (BaseLevel < 121) {
				if (para_110lv01 == 4) {
					cutin "min02",0;
					mes "哦，你想帮我做研究？";
					next;
					mes "她似乎在等待^FF0000特殊信号。^000000你想做什么？";
					next;
					while(select( "用双手比心。", "像疯子一样跳舞", "向她眨眼", "向她吹口哨。" ) != 2) {
						mes "[Mingmin]";
						mes "那是做什么？";
						emotion ET_SCRATCH;
						next;
						mes "嗯，她不喜欢那个。";
						next;
					}
					mes "[Mingmin]";
					mes "这个信号！？";
					emotion ET_SPARK;
					next;
					cutin "min01",0;
					mes "[Mingmin]";
					mes "^FF0000..................now?^000000";
					emotion ET_SPARK;
					next;
					select("什么也不说，点点头……");
					mes "[Mingmin]";
					mes "......";
					next;
					mes "[Mingmin]";
					mes "问题……！你是我的仆人吗？";
					next;
					select("是的，我的陛下……");
					cutin "min02",0;
					mes "[Mingmin]";
					mes "............";
					next;
					cutin "min01",0;
					mes "[Mingmin]";
					mes "好，那就这么定了！你必须签署这份表格。";
					next;
					mes "[Contract]";
					mes "A——冒险者不得顶撞 Busaner Mingmin，在任何情况下都不得抱怨。";
					next;
					mes "[Contract]";
					mes "B——冒险者必须以人类所能达到的最快速度完成 Busaner Mingmin 的委托。";
					next;
					mes "[Contract]";
					mes "C——本契约在冒险者完成委托当日终止。";
					next;
					cutin "min02",0;
					mes "[Contract]";
					mes "D——本契约仅限冒险者与 Mingmin 知悉，^FF0000违者处死。^000000";
					next;
					mes "[Mingmin]";
					mes "不用太担心。公会要求这样做。只要在虚线处签名。";
					next;
					if (select( "签署契约。", "花时间考虑。" ) == 2) {
						mes "[Mingmin]";
						mes "你可以慢慢考虑……";
					}
					else {
						cutin "min01",0;
						mes "[Mingmin]";
						mes "你签了吗？";
						next;
						mes "[Mingmin]";
						mes "............";
						next;
						cutin "min03",0;
						mes "[Mingmin]";
						mes "哈哈！我现在感觉好多了。";
						emotion ET_BLABLA;
						next;
						mes "[Mingmin]";
						mes "谢谢你接受这份奇怪的契约。期待与你合作。";
						next;
						mes "[Mingmin]";
					mes "我对公开委托很谨慎，因为必须礼貌对待冒险者。";
						next;
						mes "[Mingmin]";
					mes "我试着礼貌一点，但这实在不符合我的性格。";
						next;
						cutin "min02",0;
						mes "[Mingmin]";
						mes "你应该更小心……你注意到签名用的笔有什么问题吗？上面有^FF0000橙色香菇孢子^000000。";
						next;
						mes "[Mingmin]";
					mes "如果孢子进入你的血液，身体里可能会长出蘑菇。";
						next;
						mes "[Mingmin]";
					mes "这需要相当长的时间，所以尽力而为吧。如果你表现好，我也许会给你解药。";
						next;
						cutin "min03",0;
						mes "[Mingmin]";
						mes "好了，我们已经很熟悉了。那么，开始工作吧？";
						para_110lv01 = 5;
					}
				}
				else if (para_110lv01 > 4) {
					cutin "min01",0;
					mes "我们需要更多关于以下魔物的信息。请选择。";
					next;
					switch( select( "克雷斯特汉姆相关委托", "达纳托斯塔相关委托", "艾音布罗克相关委托", "Mingmin 的个人委托" ) ) {
						mes "[Mingmin]";
					case 1:
						mes "我听说克雷斯特汉姆发生了什么。魔物正在四处活动。";
						next;
						switch( select( "瑞克研究", "卡利斯格研究", "流浪者研究" ) ) {
							mes "[Mingmin]";
						case 1:
							if (checkquest(13068,PLAYTIME) == 0)
								mes "瑞克的研究进展顺利。样本越多越好！";
							else if (checkquest(13067,HUNTING) == 1) {
								cutin "레이드릭카드",3;  //daydric_card
								mes "你可以在克雷斯特汉姆西入口或二楼找到瑞克。";
								next;
								mes "[Mingmin]";
								mes "无论如何我都需要信息和文件。处理完^FF000030瑞克^000000后回来找我。";
								next;
								cutin "min01",0;
								mes "[Mingmin]";
								mes "与魔物战斗获得的经验，会成为研究的好记录！";
							}
							else if (checkquest(13067,HUNTING) == 2) {
								cutin "min03",0;
								mes "对付强大的魔物感觉如何？既能获得好资料，也能积累经验。";
								callsub S_Quest,13067,13068,700000,200000;
							}
							else {
								cutin "레이드릭카드",3;  //daydric_card
								mes "克雷斯特汉姆正在发生什么，而瑞克那里有相关线索，这是我掌握的信息。";
								next;
								mes "[Mingmin]";
						mes "无论如何我都需要信息和文件。处理完^FF000030瑞克^000000后回来找我。";
								next;
								cutin "min01",0;
								if (select( "接受委托。", "退出" ) == 1) {
									mes "[Mingmin]";
									mes "处理完魔物后请回来。我需要你的全部经历作为记录。";
									callsub S_Quest,13068,13067;
								}
							}
							break;
						case 2:
							if (checkquest(13070,PLAYTIME) == 0)
								mes "卡利斯格的研究进展顺利。样本越多越好！";
							else if (checkquest(13069,HUNTING) == 1) {
								cutin "스켈나이트카드",3;  //skullknight_card
								mes "你可以在克雷斯特汉姆西入口找到卡利斯格。";
								next;
								mes "[Mingmin]";
								mes "无论如何我都需要信息和文件。处理完^FF000030卡利斯格^000000后回来找我。";
								next;
								cutin "min01",0;
								mes "[Mingmin]";
								mes "与魔物战斗获得的经验，会成为研究的好记录！";
							}
							else if (checkquest(13069,HUNTING) == 2) {
								cutin "min03",0;
								mes "对付强大的魔物感觉如何？既能获得好资料，也能积累经验。";
								callsub S_Quest,13069,13070,700000,200000;
							}
							else {
								cutin "스켈나이트카드",3;  //skullknight_card
								mes "也许卡利斯格与克雷斯特汉姆发生的事有关，我们来研究一下。";
								next;
								mes "[Mingmin]";
						mes "无论如何我都需要信息和文件。处理完^FF000030卡利斯格^000000后回来找我。";
								next;
								cutin "min01",0;
								if (select( "接受委托。", "退出" ) == 1) {
									mes "[Mingmin]";
									mes "逐一处理后请告诉我经过。他们会成为重要资料……";
									callsub S_Quest,13070,13069;
								}
							}
							break;
						case 3:
							if (checkquest(13072,PLAYTIME) == 0)
								mes "流浪者的研究进展顺利。样本越多越好！";
							else if (checkquest(13071,HUNTING) == 1) {
								cutin "배회하는자카드",3;  //wander_man_card
								mes "从北入口进入克雷斯特汉姆，沿道路走到中央的大入口就能找到流浪者。";
								next;
								mes "[Mingmin]";
								mes "无论如何我都需要信息和文件。去处理^FF000030流浪者^000000怎么样？";
								next;
								cutin "min01",0;
								mes "[Mingmin]";
								mes "与魔物战斗获得的经验，会成为研究的好记录！";
							}
							else if (checkquest(13071,HUNTING) == 2) {
								cutin "min03",0;
								mes "对付强大的魔物感觉如何？既能获得好资料，也能积累经验。";
								callsub S_Quest,13071,13072,700000,200000;
							}
							else {
								cutin "배회하는자카드",3;  //wander_man_card
								mes "流浪者是克雷斯特汉姆的代表。那里危险，但很酷！";
								next;
								mes "[Mingmin]";
								mes "这会是很好的研究。处理完^FF000030流浪者^000000后回来。";
								next;
								cutin "min01",0;
								if (select( "接受委托。", "退出" ) == 1) {
									mes "[Mingmin]";
									mes "逐一处理后请告诉我经过。他们会成为重要资料……";
									emotion ET_BEST;
									callsub S_Quest,13072,13071;
								}
							}
						}
						break;
					case 2:
					mes "我们需要研究达纳托斯塔的魔物。";
						next;
						switch( select( "远古宝箱研究", "死亡之词研究", "猫头鹰男爵研究", "血腥之页研究" ) ) {
							mes "[Mingmin]";
						case 1:
							if (checkquest(13074,PLAYTIME) == 0)
								mes "远古宝箱的研究进展顺利。样本越多越好！";
							else if (checkquest(13073,HUNTING) == 1) {
								cutin "에인션트미믹",3;  //ancient_mimic_card
								mes "从朱诺或胡格尔前往达纳托斯塔或深渊湖并不远。";
								next;
								mes "[Mingmin]";
								mes "别抱怨！这会成为很好的经验！";
								next;
								cutin "min01",0;
								mes "[Mingmin]";
								mes "与魔物战斗获得的经验，会成为研究的好记录！";
							}
							else if (checkquest(13073,HUNTING) == 2) {
								cutin "min02",0;
								mes "你今天做得很好！";
								callsub S_Quest,13073,13074,700000,300000;
							}
							else {
								cutin "에인션트미믹",3;  //ancient_mimic_card
								mes "你经常能在达纳托斯塔或深渊湖看到它们。它们不太慷慨，但这不影响完成委托。";
								next;
								mes "[Mingmin]";
								mes "我找不到两个区域的联系，但它们不断出现，值得研究。处理完^FF000030远古宝箱^000000后回来。";
								next;
								cutin "min01",0;
								if (select( "接受委托。", "退出" ) == 1) {
									mes "[Mingmin]";
								mes "如果你从它们那里获得了好掉落，记得告诉我！别忘了我！";
									emotion ET_SPARK;
									callsub S_Quest,13074,13073;
								}
							}
							break;
						case 2:
							if (checkquest(13076,PLAYTIME) == 0)
								mes "死亡之词的研究进展顺利。样本越多越好！";
							else if (checkquest(13075,HUNTING) == 1) {
								mes "达纳托斯塔会比你想象的更危险。去那里前最好组建队伍。";
								next;
								mes "[Mingmin]";
								mes "我想研究这个，所以请接受这份委托！";
								next;
								mes "[Mingmin]";
								mes "我会给你奖励……";
							}
							else if (checkquest(13075,HUNTING) == 2) {
								cutin "min03",0;
								mes "非常感谢。这会是很棒的研究。";
								callsub S_Quest,13075,13076,700000,300000;
							}
							else {
								mes "这就是我选择研究达纳托斯塔的原因。别惊讶，这是一部变成魔物的古书！";
								next;
								mes "[Mingmin]";

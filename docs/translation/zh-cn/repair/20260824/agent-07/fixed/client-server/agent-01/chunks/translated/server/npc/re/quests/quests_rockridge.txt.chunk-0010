		mes "我怀念石头地板的气味，还有那份凉爽。";
		next;
		mes "[Demon]";
		mes "我也喜欢那里的食物。在进监狱前我讨厌豆子。我吃过的所有豆子都不如那里的一半好吃。";
		sleep2 1000;
		npctalk "你随时都可以回去，你知道的。", "Midnight#srdg01", bc_self;
		sleep2 1500;
		npctalk "我知道。你可以和我一起去。", "", bc_self;
		sleep2 1500;
		npctalk "...", "Midnight#srdg01", bc_self;
		next;
		select("你为什么进了监狱？");
		mes "[Demon]";
		mes "哦，说到这个。";
		next;
		mes "[Midnight]";
		mes "你也要告诉他那个吗？";
		next;
		mes "[Demon]";
		mes "为什么不？我喜欢那个故事。你想听，对吧？";
		sleep2 1000;
		unittalk .@account_id, "" + .@player_name$ + " : Sure.", bc_self;
		next;
		mes "[Demon]";
		mes "我手很巧，也喜欢烟花。你觉得像我这样的人最适合做什么工作？";
		next;
		mes "[" + .@player_name$ + "]";
		mes "烟花制造者？";
		sleep2 1000;
		npctalk "他真可爱。", "Midnight#srdg01", bc_self;
		next;
		mes "[Demon]";
		mes "差不多，但我制造更强的东西：^0000cd炸弹^000000。对我这种人来说，矿山简直是最棒的工作地点。";
		next;
		mes "[Demon]";
		mes "矿山里的人总是需要炸弹。我来到这里，希望在做喜欢的事时赚点钱。";
		next;
		mes "[Midnight]";
		mes "但事情没有如愿。";
		next;
		emotion ET_HNG;
		mes "[Demon]";
		mes "而且都是因为你！一天晚上，有些人来找我，说听说我是炸弹专家。他们要求我捐出炸弹。";
		next;
		mes "[Demon]";
		mes "看他们一眼，我就知道他们是臭名昭著的^0000cd水牛强盗^000000。很明显他们为什么想要我的炸弹。";
		next;
		mes "[Midnight]";
		mes "而你还是给了他们。";
		next;
		mes "[Demon]";
		mes "我还能怎么办？一群看起来很可怕、至少比我高一头的水牛，命令我交出炸弹。";
		next;
		mes "[Midnight]";
		mes "你本可以反抗？";
		next;
		emotion ET_FRET;
		mes "[Demon]";
		mes "不，我无法坚持立场。你当时不在。总之，那些水牛用我的炸弹炸毁矿石列车并占领矿山。猜猜后来我怎么样了。";
		sleep2 1000;
		unittalk .@account_id, "" + .@player_name$ + " : I can't.", bc_self;
		next;
		mes "[Demon]";
		mes "治安官追查到炸弹来自我，把我也带走了。";
		next;
		mes "[Midnight]";
		mes "你就被扔进了监狱。";
		next;
		mes "[Demon]";
		mes "猜猜我在那里遇到了谁：就是这个家伙。他被炸毁列车的爆炸卷入，那些无情的水牛把他丢在那里等死。";
		unittalk .@account_id, "" + .@player_name$ + " : Holy crap.", bc_self;
		sleep2 1000;
		emotion ET_OK;
		npctalk "天哪，没错。", "", bc_self;
		next;
		mes "[Demon]";
		mes "治安官也不比他们好。他们把他留在牢房里，任由他流血。我能怎么办？只要能帮忙，我就不能让任何人死去，所以我救治了他。";
		next;
		mes "[Demon]";
		mes "从那以后他就一直跟着我。";
		next;
		mes "[Midnight]";
		mes "谁？我？";
		next;
		mes "[Demon]";
		mes "是的。否则我来矿山向水牛复仇时，你为什么要救我？他们还因为我把你赶了出去。";
		emotion ET_KIK;
		npctalk "这就说明他有多喜欢我。", "", bc_self;
		next;
		mes "[" + .@player_name$ + "]";
		mes "你获释后报仇了吗？";
		next;
		mes "[Demon]";
		mes "我不想谈这个。我犯了很多愚蠢的错误，完全不像平时的我。所以我们才躲在这个阴暗潮湿的地方。";
		npctalk "这完全就是你会做的事。", "Midnight#srdg01", bc_self;
		sleep2 2000;
		emotion ET_OK;
		npctalk "好吧，好吧。我也爱你。", "", bc_self;
		sleep2 1500;
		npctalk "总有一天我要把你的牙全拔掉。", "Midnight#srdg01", bc_self;
		sleep2 1500;
		emotion ET_KIK;
		npctalk "听见了吗？这就是他表达爱意的方式。", "", bc_self;
		next;
		select("那么，我能帮什么忙？");
		mes "[Demon]";
		mes "你确定要帮忙吗？我不喜欢强迫别人，也不想把人送进危险。如果你真的想帮忙，可以替我弄些炸弹材料。";
		next;
		mes "[" + .@player_name$ + "]";
		mes "怎么，想去抢矿山吗？";
		next;
		mes "[Demon]";
		mes "No. Technically speaking, we'd ^0000cdreclaim the mine^000000. Have you seen what's going in the village? Since those buffaloes took over the mine, most of the people lost their jobs.";
		next;
		mes "[Demon]";
		mes "没有工作就赚不到钱，没有钱就养活不了自己。这太糟糕了。";
		next;
		emotion ET_SPARK;
		mes "[Demon]";
		mes "我想在矿山内举办^0000cd烟花派对^000000，^0000cd把强盗吓走^000000。";
		next;
		mes "[" + .@player_name$ + "]";
		mes "但是，午夜先生，他们曾经是你的……";
		npctalk "我的什么？", "Midnight#srdg01", bc_self;
		next;
		mes "[Demon]";
		mes "别担心他。他很久以前就和他们断绝关系了。他不爱那些抛弃他的水牛。对吧？";
		next;
		mes "[Midnight]";
		mes "...";
		next;
		emotion ET_HUK;
		mes "[Demon]";
		mes "好吧，我真是惊呆了。";
		next;
		mes "[Midnight]";
		mes "不，我不是担心他们，而是担心我们。如果事情出错呢？";
		next;
		mes "[Demon]";
		mes "如果不被强盗杀死，治安官也会把我们扔进监狱。不过没关系，我喜欢那里的豆子。";
		npctalk "你真的很喜欢豆子，对吧？", "Midnight#srdg01", bc_self;
		next;
		mes "[Demon]";
		mes "如果顺利，我们就能离开这个污水坑，我也能再次在矿山工作。你也一样。";
		npctalk "试过才知道行不行。其他事情以后再担心。而且我们现在还什么都没准备好。", "", bc_self;
		next;
		mes "[Demon]";
		mes "总之，小家伙，你确定能帮我们吗？矿山里有看起来像棉花球的怪物。猎杀它们，就会留下致命毒粉和爆炸粉。";
		next;
		mes "[Demon]";
		mes "我需要 10 个致命毒粉……让我看看……以及 1 个爆炸粉。";
		next;
		mes "[" + .@player_name$ + "]";
		mes "致命毒粉？你要杀了它们吗？你不是说只想把它们吓走吗？";
		next;
		mes "[Demon]";
		mes "它只对人类和杜兰族致命。对那些金牛族来说，只会引起瘙痒、打喷嚏等过敏反应。";
		npctalk "所以东西的名字必须谨慎命名。", "", bc_self;
		next;
		mes "[Midnight]";
		mes "我可以去。";
		next;
		mes "[Demon]";
		mes "不行。你会被抓住，在计划开始前就把它毁掉。";
		next;
		mes "[Demon]";
		mes "啊，小家伙，说到这个，你能消灭一些气体怪吗？这样能帮助我们之后布置炸弹。";
		next;
		mes "[Demon]";
		mes "烟花开始时水牛会逃出矿山，但那些气团可能引发连锁反应，炸毁整座矿山。先猎杀 15 只。能做到吗？";
		next;
		mes "[" + .@player_name$ + "]";
		mes "当然。";
		next;
		mes "[Demon]";
		mes "我问的是能或不能。算了，我就当你答应了。";
		next;
		mes "[Demon]";
		mes "那么，任务内容是：取得^0000cd10 个致命毒粉和 1 个爆炸粉^000000，并^0000cd猎杀 15 只气体怪^000000。明白了吗？";
		next;
		emotion ET_GOODBOY, .@account_id;
		mes "[Demon]";
		mes "我们就靠你了，小家伙！回来时我会给你丰厚报酬。我在治安官办公室坐牢时弄到了几样东西。现在，出发吧！";
		setquest 14672;// Preparing for the Firework Festival
		close;
	case 0:
	case 1:
		mes "[Demon]";
		mes "让我看看……嗯，小家伙，你忘了猎杀所有气体怪。工作时不能让气体怪留在附近。";
		next;
		mes "[Demon]";
		mes "只要猎杀 15 只气体怪。不用着急，可以慢慢来。今天结束前回来就好。我想再见到你。";
		close;
	case 2:
		if (countitem(25277) < 10) {
			mes "[Demon]";
		mes "让我看看……嗯，你没有带来 10 个致命毒粉。这是我制作炸弹所需的最低数量。";
			next;
			mes "[Demon]";
		mes "小家伙，你能做到，对吧？从气体怪身上取得 10 个致命毒粉和 1 个爆炸粉。";
			close;
		}
		if (countitem(6213) < 1) {
			mes "[Demon]";
		mes "让我看看……嗯，你没有带来 1 个爆炸粉。这是我制作炸弹所需的最低数量。";
			next;
			mes "[Demon]";
		mes "小家伙，你能做到，对吧？从气体怪身上取得 1 个爆炸粉。";
			close;
		}
		mes "[Demon]";
		mes "让我看看……哦，小家伙，你全部完成了！你猎杀了气体怪，也带来了我要求的东西。";
		npctalk "我该怎么办？我好像爱上这个小家伙了。", "", bc_self;
		next;
		mes "[Demon]";
		mes "这些足够让我忙一整夜了。";
		npctalk "午夜，你最好趁我工作时睡一会儿。", "", bc_self;
		sleep2 1000;
		npctalk "让我帮忙吧。这样会更快。", "Midnight#srdg01", bc_self;
		sleep2 1500;
		npctalk "……哇。你真的很喜欢我，对吧？", "", bc_self;
		next;
		mes "[Demon]";
		mes "嘿，小家伙，明天也能再帮我吗？举办烟花派对需要不止一枚炸弹。";
		next;
		mes "[Demon]";
		mes "今天先去休息，明天早上再来。再见！";
		delitem 25277, countitem(25277);// DeadlyPoisonPowder
		delitem 6213, countitem(6213);// Explosive_Powder
		erasequest 14672;// Preparing for the Firework Festival
		setquest 14673;// Time to Make Bombs
		getitem 25250,3;// Coin_Of_Rr
		getexp 76200,70740;
		close;
	}
	end;

OnInit:
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "rock_main_quest == 22 && BaseLevel >= 140 && !isbegin_quest(14672) && checkquest(14673,PLAYTIME) == -1" );
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "checkquest(14672,HUNTING) == 2 && countitem(25277) > 9 && countitem(6213) > 0" );
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "checkquest(14673,PLAYTIME) == 2" );
	end;
}

harboro2,166,80,5	script	Traces of Fire#srdg01	4_TRACE,{
	end;
OnEffect:
	specialeffect EF_SPR_SOULE;
	specialeffect EF_MAGMA_FLOW;
	initnpctimer;
	end;
OnTimer1000:
	specialeffect EF_SPR_LIGHTPRINT;
	end;
OnTimer10000:
	specialeffect EF_M03;
	specialeffect EF_FIREHIT2;
	end;
OnTimer18000:
	specialeffect EF_FIREHIT2;
	end;
OnTimer24000:
	specialeffect EF_M03;
	end;
OnTimer30000:
	specialeffect EF_EL_HEATER;
	stopnpctimer;
	end;
}

harboro2,165,77,5	duplicate(dummy_npc)	Tool#srdg01	4_ROPEPILE
harboro2,164,78,5	duplicate(dummy_npc)	Tool#srdg02	4_BRICKPILE
harboro2,166,78,5	duplicate(dummy_npc)	Tool#srdg03	4_WOODPILE


// Gas! Gas!
rockrdg2,295,328,5	script	Frail Ghast#rockdaily	4_M_COWRAIDERS2,{
	if (rock_main_quest < 22) {
		mes "[Frail Ghast]";
		mes "啊，只要看它们一眼，";
		mes "我就只想打喷嚏……";
		next;
		mes "[Frail Ghast]";
		mes "你在看什么？你刚才在偷听我吗？";
		mes "赶紧滚出去！走！";
		close;
	}
	switch( checkquest(1299,PLAYTIME) ) {
	case -1:
		break;
	case 0:
	case 1:
		mes "[Frail Ghast]";
		mes "哦，你又想帮我。";
		mes "谢谢，但我每天只需要巡逻一次。明天凌晨 4 点后再来吧。";
		close;
	case 2:
		mes "[Frail Ghast]";
		mes "啊，陌生人！你又来帮忙了，对吧？";
		next;
		if (select( "帮忙。", "拒绝。" ) == 2) {
			mes "[Frail Ghast]";
			mes "为什么？你今天太忙了吗？";
			close;
		}
		mes "[Frail Ghast]";
		mes "不用担心报酬，我会负责。去完成任务吧。";
		erasequest 1299;// Patrol Once a Day
		setquest 1298;// Gas! Gas!
		close;
	}
	switch( checkquest(1298,HUNTING) ) {
	case -1:
		mes "[Frail Ghast]";
		mes "*呻吟* 我该怎么办？";
		mes "也许我该带一把大扇子。";
		mes "不，不行，那样大家都会发现。";
		mes "谁在那里？！";
		emotion ET_SURPRISE, playerattached();
		next;
		mes "[Frail Ghast]";
		mes "嗯？我很确定以前没在附近见过你。";
		mes "你不是那些义警之一。";
		next;
		mes "[Frail Ghast]";
		mes "等等，你就是那个";
		mes "一直妨碍我们的陌生人！";
		next;
		mes "[Frail Ghast]";
		mes "……哦，对了！嘿，陌生人，";
		mes "你见过矿山里的";
		mes "气体怪吗？";
		next;
		select("见过。","气体怪？");
		mes "[Frail Ghast]";
		mes "就是那些气团。它们让我疯狂打喷嚏，";
		mes "变得哭泣、流口水、流鼻涕。*发抖*";
		next;
		mes "[Frail Ghast]";
		mes "现在我被安排在矿山内巡逻，但因为它们我没法完成。";
		mes "但我们金牛族以身体优势为荣。我怎么能告诉别人，我因为对气体过敏而无法工作？";
		next;
		mes "[Frail Ghast]";
		mes "所以我在想，";
		mes "也许你可以帮我。";
		next;
		mes "[Frail Ghast]";
		mes "在我进去之前，先猎杀^FF00002020 只气体怪^000000。";
		mes "我会报答你。拜托？";
		next;
		if (select( "帮忙。", "拒绝。" ) == 2) {
			mes "[Frail Ghast]";
			mes "拜托，我说过会报答你。";
			mes "唉！好吧，那我不强迫你。";
			mes "但你最好别把这件事告诉任何人。明白吗？";
			close;
		}
		mes "[Frail Ghast]";
		mes "真的吗？谢谢！我就靠你了！";
		next;
		mes "[Frail Ghast]";
		mes "哦，别忘了不能让任何人知道。";
		mes "这对我们双方都不好。";
		setquest 1298;// Gas! Gas!
		close;
	case 0:
	case 1:
		mes "[Frail Ghast]";
		mes "你猎杀了多少只气体怪？";
		mes "我准备去巡逻了。完成后告诉我。";
		mes "我就靠你了，陌生人。";
		close;
	case 2:
		if (checkweight(1301,1) == 0) {
			mes "[Frail Ghast]";
			mes "你把它们全都猎杀了吗？对了，你为什么带这么多东西？";
			mes "先去^FF0000减轻负重^000000。";
			close;
		}
		mes "[Frail Ghast]";
		mes "你全都抓到了吗？我最好在它们再次出现前完成巡逻。";
		mes "谢谢！给，拿着这个。";
		erasequest 1298;// Gas! Gas!
		setquest 1299;// Patrol Once a Day
		getitem 25250,3;// Coin_Of_Rr
		getexp 101600,94320;
		next;
		mes "[Frail Ghast]";
		mes "如果你不忙，明天再来帮我吧。我会报答你。";
		mes "这对我们双方都有好处，对吧？";
		close;
	}
	end;

OnInit:
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "rock_main_quest == 22 && !isbegin_quest(1298) && checkquest(1299,PLAYTIME) == -1" );
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "rock_main_quest == 22 && checkquest(1298,HUNTING) == 2" );
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "rock_main_quest == 22 && checkquest(1299,PLAYTIME) == 2" );
	end;
}


// Mrs. McPhy
harboro1,347,65,3	script	Mrs. McPhy#rockdaily	1_F_MERCHANT_02,{
	if (BaseLevel < 100) {
		mes "[Mrs. McPhy]";
		mes "你好。你是第一次来这里吗？至少要达到^FF0000100 级^000000才能舒适地待在这里。";
		next;
		mes "[Mrs. McPhy]";
		mes "等等，我丈夫在喂那只狗什么？亲爱的！那可是我们的晚餐！";
		next;
		mes "[Mr. McPhy]";
		mes "亲、亲爱的，风这么大你不该待在外面。我们进去吧。";
		next;
		mes "[Mrs. McPhy]";
		mes "哼，我真不敢相信你！今晚你只能吃一半晚餐！";
		close;
	}
	switch( checkquest(1329,PLAYTIME) ) {
	case -1:
		break;
	case 0:
	case 1:
		mes "[Mrs. McPhy]";
		mes "他睡着时像天使，但……唉……一想到他^FF0000凌晨 4 点后^000000醒来会做什么，我就头疼。";
		close;
	case 2:
		mes "[Mrs. McPhy]";
		mes "冒险者，谢谢你回来。我们检查了 Spotty 在村里挖的所有洞，但没找到要找的东西。他一定把它带到荒地去了。";
		next;
		mes "[Mrs. McPhy]";
		mes "正如之前告诉你的，这次我们有东西给你：^0000CD1 枚岩脊硬币^000000。你能帮我们吗？";
		next;
		if (select( "帮忙。", "拒绝。" ) == 2) {
			mes "[Mrs. McPhy]";
			mes "我们没有其他人可以求助。改变主意后请回来。";
			close;
		}
		.@r = rand(1,8);
		if (.@r == 1)
			.@string$ = "slipper";
		else if (.@r == 2)
			.@string$ = "spoon";
		else if (.@r == 3)
			.@string$ = "work boot";
		else if (.@r == 4)
			.@string$ = "glove";
		else if (.@r == 5)
			.@string$ = "hat";
		else if (.@r == 6)
			.@string$ = "pillow cover";
		else if (.@r == 7)
			.@string$ = "alarm clock";
		else
			.@string$ = "flyswatter";
		mes "[Mrs. McPhy]";
		mes "今天 Spotty 拿走了一个" + .@string$ + "。你能帮忙找找吗？它也许很容易替换，但我不能每次 Spotty 拿走东西都重新购买。";
		next;
		mes "[Mrs. McPhy]";
		mes "到村外和我丈夫谈谈。他会告诉你东西可能在哪里。";
		erasequest 1329;// Spotty in the Dreamland
		setquest rand(1323,1327);// Spotty, No!
		if (isbegin_quest(1330))	// debug

//===== rAthena Script =======================================
//= Eden Group Quests - Mission [91 - 99]
//===== By: ==================================================
//= Chilly
//===== Current Version: =====================================
//= 1.5
//===== Compatible With: =====================================
//= rAthena Project
//===== Description: =========================================
//= Repetable Quests for Players between Baselevel 91 - 99.
//===== Additional Comments: =================================
//= 1.0 First Version. [Chilly]
//= 1.1 Some little improvements here and there. [Masao]
//= 1.2 Optimized. [Euphy]
//= 1.3 Updated to match the official script. [Euphy]
//= 1.4 Added support to Para_Team_Mark_ in Eden Group. [Ragno]
//= 1.5 Added use of F_HasEdenGroupMark function. [Ragno]
//============================================================

moc_para01,48,177,3	script	91-99 Mission Board	857,{
	if (!callfunc("F_HasEdenGroupMark")) {
		mes "等一下！";
		mes "-你必须拥有-";
		mes "-^4d4dff“伊甸园标志”^000000-";
		mes "-才能接受这些任务。-";
		next;
		switch(select("直接离开。:^0000FF伊甸园^000000任务？:如何成为^0000FF伊甸园^000000成员？")) {
		case 1:
			close;
		case 2:
			mes "::伊甸园任务";
			mes "::基本上是";
			mes "::王国各地的人们";
			mes "::提出的任务。";
			mes "::我们只是分类整理。";
			next;
			mes "::在伊甸园，";
			mes "::我们按难度";
			mes "::整理任务。";
			mes "::根据这个等级，";
			mes "::你可以找到";
			mes "::适合你的";
			mes "::任务。";
			next;
			mes "::完成后，";
			mes "::你可以回到";
			mes "::任务板。";
			next;
			mes "::然后你会";
			mes "::获得奖励！！";
			mes "::很简单，对吧！！";
			mes "::无需佣金！！";
			close;
		case 3:
			mes "::你可以成为";
			mes "::伊甸园成员，";
			mes "::去找^0000FFLaime Evenor^000000，";
			mes "::他在一楼等候。";
			next;
			mes "::成为成员后，";
			mes "::你会得到";
			mes "::\"^006400Eden Group Mark^000000\".";
			mes "::然后你会 able";
			mes "::看到任务板。";
			close;
		}
	}
	if (BaseLevel < 91 || BaseLevel > 99) {
		// Quest IDs: 4181-4196
		// Quest cooldown IDs: 4212-4227
		setarray .@names$[0],
			"Solider","Freezer","Heater",
			"Injustice","Rybio","Dark Priest",
			"Stapo","Roween","Siroma",
			"Shinobi","Evil Nymph",
			"Deviruchi","Mineral","Kaho","Neraid","Disguise";
		setarray .@exp[0],
			90000,94000,114000,
			96000,96000,146000,
			96000,102000,110000,
			102000,108000,
			110000,138000,118000,96000,134000;
		mes "你必须达到 91-99 级才能接受这些任务。";
		for(set .@quest,4181; .@quest<=4196; set .@quest,.@quest+1) {
			set .@hunting, checkquest(.@quest,HUNTING);
			if (.@hunting == 0 || .@hunting == 1) {
				next;
				mes "::你无法继续";
				mes ":: ^0000FF"+.@names$[.@quest-4181]+" Hunting^000000.";
				mes "::该任务的登记";
				mes "::已取消。";
				erasequest .@quest;
				close;
			} else if (.@hunting == 2) {
				next;
				mes "::你已将任务信息";
				mes "::添加到";
				mes ":: ^0000FF"+.@names$[.@quest-4181]+" Hunting^000000";
				mes "::任务板上。";
				mes "::你获得了";
				mes "::宝贵的经验。";
				erasequest .@quest;
				getexp .@exp[.@quest-4181],0;
				close;
			}
		}
		close;
	}
	mes "[91-99 Mission Board]";
	mes "这块任务板上有多个委托。";
	next;
	switch(select("^8B4513Turtle Island^000000:^8B4513Glast Heim^000000:^8B4513Rachel / Veins^000000:^8B4513Expansion Cities^000000:^8B4513Other regions^000000")) {
	case 1:
		mes "^8B4513Turtle Island^000000.";
		mes "你要狩猎哪种怪物，还是已经完成狩猎？";
		next;
		switch(select("^0000FFSolider^000000:^0000FFFreezer^000000:^0000FFHeater^000000")) {
			case 1: callsub L_Quest,4181,"Solider",90000,"솔리더카드","这种魔物只能在^8B4513龟岛^000000找到。";
			case 2: callsub L_Quest,4182,"Freezer",94000,"프리저카드","这种魔物只能在^8B4513龟岛^000000找到。";
			case 3: callsub L_Quest,4183,"Heater",114000,"히터카드","这种魔物只能在^8B4513龟岛^000000找到。";
		}
	case 2:
		mes "^8B4513Glast Heim^000000.";
		mes "你要狩猎哪种怪物，还是已经完成狩猎？";
		next;
		switch(select("^0000FFInjustice^000000:^0000FFRybio^000000:^0000FFDark Priest^000000")) {
			case 1: callsub L_Quest,4184,"Injustice",96000,"인저스티스카드","这种魔物只能在^8B4513克雷斯特汉姆监狱^000000找到。";
			case 2: callsub L_Quest,4185,"Rybio",96000,"리비오카드","这种魔物只能在^8B4513克雷斯特汉姆监狱^000000找到。";
			case 3: callsub L_Quest,4186,"Dark Priest",146000,"다크프리스트카드","这种魔物只能在^8B4513克雷斯特汉姆监狱^000000找到。";
		}
	case 3:
		mes "^8B4513Rachel / Veins^000000.";
		mes "你要狩猎哪种怪物，还是已经完成狩猎？";
		next;
		switch(select("^0000FFStapo^000000:^0000FFRoween^000000:^0000FFSiroma^000000")) {
			case 1: callsub L_Quest,4187,"Stapo",96000,"스태포카드","这种魔物只能在^8B4513维因斯^000000找到。";
			case 2: callsub L_Quest,4188,"Roween",102000,"로우윈카드","这种魔物只能在^8B4513拉赫^000000找到。";
			case 3: callsub L_Quest,4189,"Siroma",110000,"시로마카드","这种魔物只能在^8B4513冰洞^000000找到。";
		}
	case 4:
		mes "^8B4513Expansion Cities^000000.";
		mes "你要狩猎哪种怪物，还是已经完成狩猎？";
		next;
		switch(select("^0000FFShinobi^000000:^0000FFEvil Nymph^000000")) {
			case 1: callsub L_Quest,4190,"Shinobi",102000,"시노비카드","这种魔物只能在^8B4513天津地下城^000000找到。";
			case 2: callsub L_Quest,4191,"Evil Nymph",108000,"요선녀카드","这种魔物只能在^8B4513昆仑地下城^000000找到。";
		}
	case 5:
		mes "其他地区。";
		mes "你要狩猎哪种怪物，还是已经完成狩猎？";
		next;
		switch(select("^0000FFDeviruchi^000000:^0000FFMineral^000000:^0000FFKaho^000000:^0000FFNeraid^000000:^0000FFDisguise^000000")) {
			case 1: callsub L_Quest,4192,"Deviruchi",110000,"데비루치카드","这种魔物只能在^8B4513吉芬地下城^000000找到。";
			case 2: callsub L_Quest,4193,"Mineral",138000,"미네랄","这种魔物只能在^8B4513艾因贝赫地下城^000000找到。";
			case 3: callsub L_Quest,4194,"Kaho",118000,"카호카드","这种魔物可以在^8B4513诺格罗德熔岩 1^000000找到。";
			case 4: callsub L_Quest,4195,"Neraid",96000,"네레이드카드","这种魔物只能在^8B4513科摩多地下城^000000找到。";
			case 5: callsub L_Quest,4196,"Disguise",134000,"디스가이즈카드","这种魔物只能在^8B4513尼夫海姆^000000找到。";
		}
	}
	end;

//callsub L_Quest,<quest ID>,"<monster name>",<reward EXP>,"<cutin image>","<description>"{,"s"};
L_Quest:
	set .@quest1, getarg(0);
	set .@quest2, .@quest1+31;
	.@cutin$ = getarg(3);
	set .@playtime, checkquest(.@quest2,PLAYTIME);
	if (.@playtime == 0 || .@playtime == 1) {
		mes "[91-99 Mission Board]";
		mes "再次接受该任务前需要等待 3 小时。";
		close;
	}
	set .@hunting, checkquest(.@quest1,HUNTING);
	if (.@hunting == 0 || .@hunting == 1) {
		mes "[91-99 Mission Board]";
		mes "你已经猎杀完全部 30 只"+getarg(1)+getarg(5,"")+"了吗？";
		close;
	} else if (.@hunting == 2) {
		mes "[91-99 Mission Board]";
		mes "你完成了狩猎。";
		mes "请收下这份奖励。";
		erasequest .@quest1;
		if (.@playtime > -1) erasequest .@quest2;
		setquest .@quest2;

		// Job Experience calculation.
		if (JobLevel > 50 && JobLevel < 56) set .@jexp,67000;
		else if (JobLevel > 55 && JobLevel < 61) set .@jexp,94000;
		else if (JobLevel > 60 && JobLevel < 66) set .@jexp,141000;
		else if (JobLevel > 65 && JobLevel < 69) set .@jexp,212000;
		else if (JobLevel == 69) set .@jexp,311000;

		getexp getarg(2),.@jexp;
		close;
	}/* else if (.@hunting == 3) {
//		recall_completequest .@quest1
		erasequest .@quest1;
		mes "[91-99 Mission Board]";
		mes "你重新接受了"+getarg(1)+"狩猎任务。";
		close;
	}*/ else {
		mes "[91-99 Mission Board]";
		mes getarg(4);
		next;
		if (.@cutin$ != "") cutin .@cutin$,3;
		mes "[91-99 Mission Board]";
		mes "在那里猎杀 30 只"+getarg(1)+"怪物，并在这块告示牌上报告成功。";
		next;
		if (.@cutin$ != "") cutin .@cutin$,255;
		if(select("我去狩猎。:不用，谢谢。") == 1) {
			mes "[91-99 Mission Board]";
			mes "完成任务后，在任务板登记并领取奖励。";
			if (.@playtime > -1) erasequest .@quest2;
			setquest .@quest1;
		}
		close;
	}
}

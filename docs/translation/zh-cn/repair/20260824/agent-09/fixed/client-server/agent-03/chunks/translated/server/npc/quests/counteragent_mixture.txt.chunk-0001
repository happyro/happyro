			mes "[商人路易兹]";
			mes "你知道他住在哪里";
			mes "却没去看看？嘿，";
			mes "他也许疯疯癫癫，但";
			mes "大多数天才都";
			mes "这样。不过，见见他应该是个^FFFFFF^000000好主意。";
			next;
			mes "[商人路易兹]";
			mes "我的意思是……";
			mes "像他这样的聪明人";
			mes "迟早会创造出";
			mes "某种奇妙的东西，";
			mes "对吧？";
			close;
		}
		mes "[商人路易兹]";
		mes "……你好？";
		mes "喂？嘿。";
		mes "嘿！我在和你说话";
		mes "呢！我讨厌";
		mes "你们冒险者";
		mes "突然闭嘴发呆……";
		close;
	}
	mes "[商人路易兹]";
	mes "嘿。";
	mes "怎么了？";
	next;
	if (countitem(971) > 0 && countitem(972) > 0) {
		switch(select("交谈:谈谈溶液。:取消")) {
		case 1:
			mes "[商人路易兹]";
			mes "我在吉芬";
			mes "寻找魔法物品时，";
			mes "听说了一个";
			mes "疯狂科学家的传闻。于是我";
			mes "很好奇，四处打听，";
			mes "最后找到了这个人。";
			next;
			mes "[商人路易兹]";
			mes "哎呀，这家伙真是";
			mes "古怪。他甚至不知道";
			mes "我一直都在旁边，";
			mes "却只是不停地喃喃自语，";
			mes "一边做着他的";
			mes "实验。比如，呃……";
			next;
			mes "[商人路易兹]";
			mes "是的，他一直念叨着";
			mes "诸如“Karvodailnirol”";
			mes "和“Detrimindexta”。";
			mes "我第一次听到时，以为";
			mes "那只是疯话，你懂的吧？";
			next;
			mes "[商人路易兹]";
			mes "但结果证明，";
			mes "这个 Karvodailnirol";
			mes "和 Detrimindexta 确实";
			mes "存在。我想它们是特殊的";
			mes "液体，作用方式并不像";
			mes "我们熟悉的普通液体。";
			close;
		case 2:
			set molgenstain,1;
			mes "[商人路易兹]";
			mes "嘿，这是那位";
			mes "科学家一直提到的";
			mes "其中一种溶液。";
			mes "你居然弄到了一瓶";
			mes "这种东西？嗯……我现在";
			mes "完全不知道该拿它做什么…… ";
			next;
			mes "[商人路易兹]";
			mes "啊，不过那个疯狂的";
			mes "科学家肯定知道。";
			mes "我不太记得";
			mes "他住在哪里，但我知道";
			mes "他在吉芬，而且他的";
			mes "名字是 ^0000FF莫根斯坦^000000.";
			next;
			mes "[商人路易兹]";
			mes "嗯……你最好";
			mes "去吉芬四处";
			mes "打听一下。我知道";
			mes "先打听一下。我知道";
			mes "肯定有人知道";
			mes "在哪里能找到莫根斯坦。";
			close;
		case 3:
			mes "[商人路易兹]";
			mes "呃……";
			mes "和你聊天很愉快";
			mes "朋友。呃，";
			mes "回头见。照顾好";
			mes "自己，好吗？";
			close;
		}
	}
	if (countitem(972) > 0) {
		switch(select("交谈:谈谈 Karvodailnirol:取消")) {
		case 1:
			mes "[商人路易兹]";
			mes "我在吉芬";
			mes "寻找魔法物品时，";
			mes "听说了一个";
			mes "疯狂科学家的传闻。于是我";
			mes "很好奇，四处打听，";
			mes "最后找到了这个人。";
			next;
			mes "[商人路易兹]";
			mes "哎呀，这家伙真是";
			mes "古怪。他甚至不知道";
			mes "我一直都在旁边，";
			mes "却只是不停地喃喃自语，";
			mes "一边做着他的";
			mes "实验。比如，呃……";
			next;
			mes "[商人路易兹]";
			mes "是的，他一直念叨着";
			mes "诸如“Karvodailnirol”";
			mes "和“Detrimindexta”。";
			mes "我第一次听到时，以为";
			mes "那只是疯话，你懂的吧？";
			next;
			mes "[商人路易兹]";
			mes "但结果证明，";
			mes "这个 Karvodailnirol";
			mes "和 Detrimindexta 确实";
			mes "存在。我想它们是特殊的";
			mes "液体，作用方式并不像";
			mes "我们熟悉的普通液体。";
			close;
		case 2:
			set molgenstain,1;
			mes "[商人路易兹]";
			mes "哦，这就是那个";
			mes "老科学家提到的";
			mes "Karvodailnirol，";
			mes "对吧？当然，只有";
			mes "那样的人才知道";
			mes "该怎么使用它……";
			next;
			mes "[商人路易兹]";
			mes "嘿，你为什么不去";
			mes "问问他呢？";
			mes "我不太记得";
			mes "他住在哪里，但我知道";
			mes "他在吉芬，而且他的";
			mes "名字是 ^0000FF莫根斯坦^000000.";
			next;
			mes "[商人路易兹]";
			mes "嗯……你最好";
			mes "去吉芬四处";
			mes "打听一下。我知道";
			mes "先打听一下。我知道";
			mes "肯定有人知道";
			mes "在哪里能找到莫根斯坦。";
			close;
		case 3:
			mes "[商人路易兹]";
			mes "呃……";
			mes "和你聊天很愉快";
			mes "朋友。呃，";
			mes "回头见。照顾好";
			mes "自己，好吗？";
			close;
		}
	}
	if (countitem(971) > 0) {
		switch(select("交谈:谈谈 Detrimindexta:取消")) {
		case 1:
			mes "[商人路易兹]";
			mes "我在吉芬";
			mes "寻找魔法物品时，";
			mes "听说了一个";
			mes "疯狂科学家的传闻。于是我";
			mes "很好奇，四处打听，";
			mes "最后找到了这个人。";
			next;
			mes "[商人路易兹]";
			mes "哎呀，这家伙真是";
			mes "古怪。他甚至不知道";
			mes "我一直都在旁边，";
			mes "却只是不停地喃喃自语，";
			mes "一边做着他的";
			mes "实验。比如，呃……";
			next;
			mes "[商人路易兹]";
			mes "是的，他一直念叨着";
			mes "诸如“Karvodailnirol”";
			mes "和“Detrimindexta”。";
			mes "我第一次听到时，以为";
			mes "那只是疯话，你懂的吧？";
			next;
			mes "[商人路易兹]";
			mes "但结果证明，";
			mes "这个 Karvodailnirol";
			mes "和 Detrimindexta 确实";
			mes "存在。我想它们是特殊的";
			mes "液体，作用方式并不像";
			mes "我们熟悉的普通液体。";
			close;
		case 2:
			set molgenstain,1;
			mes "[商人路易兹]";
			mes "哦，这就是那个";
			mes "老科学家提到的";
			mes "Karvodailnirol，";
			mes "对吧？当然，只有";
			mes "那样的人才知道";
			mes "该怎么使用它……";
			next;
			mes "[商人路易兹]";
			mes "嘿，你为什么不去";
			mes "问问他呢？";
			mes "我不太记得";
			mes "他住在哪里，但我知道";
			mes "他在吉芬，而且他的";
			mes "名字是 ^0000FF莫根斯坦^000000.";
			next;
			mes "[商人路易兹]";
			mes "嗯……你最好";
			mes "去吉芬四处";
			mes "打听一下。我知道";
			mes "先打听一下。我知道";
			mes "肯定有人知道";
			mes "在哪里能找到莫根斯坦。";
			close;
		case 3:
			mes "[商人路易兹]";
			mes "呃……";
			mes "和你聊天很愉快";
			mes "朋友。呃，";
			mes "回头见。照顾好";
			mes "自己，好吗？";
			close;
		}
	}
	if (select("交谈:取消") == 1) {
		mes "[商人路易兹]";
		mes "我在吉芬";
		mes "寻找魔法物品时，";
		mes "听说了一个";
		mes "疯狂科学家的传闻。于是我";
		mes "很好奇，四处打听，";
		mes "最后找到了这个人。";
		next;
		mes "[商人路易兹]";
		mes "哎呀，这家伙真是";
		mes "古怪。他甚至不知道";
		mes "我一直都在旁边，";
		mes "却只是不停地喃喃自语，";
		mes "一边做着他的";
		mes "实验。比如，呃……";
		next;
		mes "[商人路易兹]";
		mes "是的，他一直念叨着";
		mes "诸如“Karvodailnirol”";
		mes "和“Detrimindexta”。";
		mes "我第一次听到时，以为";

geffen,181,114,3	script	Aure Dupon#cm	82,{
	if (molgenstain == 2) {
		mes "[奥尔·杜邦]";
		mes "看来我们的";
		mes "道路又一次交汇。";
		mes "这是巧合吗？不，这更像是";
		mes "^0000FF命运^000000。";
		next;
		if (select("谈谈莫根斯坦:取消") == 1) {
			mes "[奥尔·杜邦]";
			mes "你还没见过";
			mes "莫根斯坦吗？他";
			mes "住在锻造所的";
			mes "二楼。虽然我们";
			mes "才刚见面，但我必须警告你不要";
			mes "和他走得太近……";
			close;
		}
		mes "[奥尔·杜邦]";
		mes "去吧，";
		mes "愿命运的潮汐";
		mes "带你前往";
		mes "你该去的地方。";
		close;
	}
	mes "[奥尔·杜邦]";
	mes "时间温柔地";
	mes "缓慢流淌，但这个世界上";
	mes "没有任何力量";
	mes "能阻止它。";
	mes "人类甚至连";
	mes "宏大格局中的尘埃都算不上。";
	next;
	if (molgenstain > 0) {
		switch(select("交谈:询问莫根斯坦:取消")) {
		case 1:
			mes "[奥尔·杜邦]";
			mes "拥有目标并专注其中";
			mes "是好事，但执着于";
			mes "单一事物可能";
			mes "造成破坏。放松，清空";
			mes "你的思绪，让自己";
			mes "随命运潮汐漂流。";
			close;
		case 2:
			set molgenstain,2;
			mes "[奥尔·杜邦]";
			mes "莫根斯坦……？";
			mes "那个人痴迷于";
			mes "征服那些";
			mes "支配世界的力量。但是";
			mes "你似乎出于某种原因";
			mes "对他感到好奇。嗯……";
			next;
			mes "[奥尔·杜邦]";
			mes "最好还是由你";
			mes "去见莫根斯坦";
			mes "并亲自判断他的为人。你可以在";
			mes "吉芬锻造所的";
			mes "二楼找到他。";
			mes "去吧：这是你的命运。";
			close;
		case 3:
			mes "[奥尔·杜邦]";
			mes "去吧，";
			mes "愿命运的潮汐";
			mes "带你前往";
			mes "你该去的地方。";
			close;
		}
	}
	if (select("交谈:取消") == 1) {
		mes "[奥尔·杜邦]";
		mes "拥有目标并专注其中";
		mes "是好事，但执着于";
		mes "单一事物可能";
		mes "造成破坏。放松，清空";
		mes "你的思绪，让自己";
		mes "随命运潮汐漂流。";
		close;
	}
	mes "[奥尔·杜邦]";
	mes "去吧，";
	mes "愿命运的潮汐";
	mes "带你前往";
	mes "你该去的地方。";
	close;
}

geffen_in,141,140,3	script	Morgenstein#cm	121,{
	if (checkweight(1201,1) == 0) {
		mes "- 请稍等！！ -";
		mes "- 你当前携带的物品 -";
		mes "- 太多了。 -";
		mes "- 请稍后再试 -";
		mes "- 丢弃一些物品后。 -";
		close;
	}
	if (MISC_QUEST & 4) {
		mes "[化学家莫根斯坦]";
		mes ".....";
		mes "欢迎。";
		mes "嘿嘿嘿……";
		mes "嘿嘿嘿嘿嘿……";
		next;
		switch(select("询问他的研究:请他制作新溶液:取消")) {
		case 1:
			mes "[化学家莫根斯坦]";
			mes "嘿嘿嘿嘿嘿……";
			mes "你一定听说过我的研究传闻。没错！既然你可能已经知道了，我就不再隐瞒——我的意思是，根本没什么可隐瞒的。";
			next;
			mes "[化学家莫根斯坦]";
			mes "实际上，可以说我的研究已经完成了！凭我的天才，没有什么是不可能的！哇哈哈，只是时间问题！";
			next;
			mes "[化学家莫根斯坦]";
			mes "你还在这里？对了，你想知道我的研究。其实很简单。我只是想发明一种能融化一切的超级液体！";
			next;
			mes "[化学家莫根斯坦]";
			mes "很有趣吧？无论你多强，都无法打碎石头或钢铁，但用我的新液体，就能融化它们，让它们变得像泥巴一样柔软！";
			next;
			mes "[化学家莫根斯坦]";
			mes "它还不能融化一切，但我发现用我的发明可以把以前绝对无法混合的东西结合起来。嘿嘿嘿嘿~！";
			next;
			mes "[化学家莫根斯坦]";
			mes "你可以制作出许多从未想过可能存在的东西！只要你愿意，我就能用这种方法为你制作许多新东西……！！";
			next;
			mes "[化学家莫根斯坦]";
			mes "内啡肽涌上脸庞的速度至少是平时的2.1倍！啊！我太兴奋了！我……我根本藏不住！";
			close;
		case 2:
			mes "[化学家莫根斯坦]";
			mes "那么……";
			mes "你想让我制作全新的东西，对吧？嘿嘿嘿！我喜欢你的科学冒险精神！";
			next;
			switch(select("反制剂:混合剂")) {
			case 1:
				mes "[化学家莫根斯坦]";
				mes "哦……！";
				mes "你想制作反制剂？呵呵呵呵呵，让我们看看需要什么……";
				next;
				mes "[化学家莫根斯坦]";
				mes "哦，我想起来了，需要酒精、呃，Detrimindexta，还有装它们的空瓶。就这三样物品和3000 Zeny。";
				next;
				mes "[化学家莫根斯坦]";
				mes "哇哈哈哈哈！";
				mes "哦，我已经迫不及待要制作了！准备开始了吗？";
				next;
				if (select("制作:取消") == 1) {
					if (countitem(970) == 0 || countitem(971) == 0 || countitem(713) == 0 || Zeny < 3000) {
						mes "[化学家莫根斯坦]";
						mes "嘿嘿嘿嘿……不够……不够……哈啊……哈啊……去……把剩下的材料拿来！";
						mes "那就把乐趣推迟到那时吧……嘿嘿嘿嘿嘿。";
						close;
					}
					mes "[化学家莫根斯坦]";
					mes "哦哦哦哦哦……嘿嘿嘿嘿嘿……是的……就是这样……是的……更多……更多……嘿嘿嘿嘿。";
					mes "……啊啊……啊哈……哈……啊哈哈哈哈哈哈！";
					next;
					if (countitem(970) < 1 || countitem(971) < 1 || countitem(713) < 1) {
						mes "[化学家莫根斯坦]";
						mes "呵呵呵呵……不够……不够……哈啊……哈啊……去……把剩下的材料拿来！！";
						close;
					}
					delitem 970,1; //Alchol
					delitem 971,1; //Detrimindexta
					delitem 713,1; //Empty_Bottle
					set Zeny, Zeny-3000;
					getitem 973,1; //Counteragent
					mes "[化学家莫根斯坦]";
					mes "嘿嘿嘿……";
					mes "哈啊……";
					mes "哦？已经完成了吗？！";
					close;
				}
				mes "[化学家莫根斯坦]";
				mes "嘿嘿嘿……!";
				mes "准备好后";
				mes "再回来吧~";
				close;
			case 2:
				mes "[化学家莫根斯坦]";
				mes "哦……！";
				mes "你想制作混合剂？呵呵呵呵呵，让我们看看需要什么……";
				next;
				mes "[化学家莫根斯坦]";
				mes "哦，我想起来了，需要酒精、呃，Karvodailnirol，还有装它们的空瓶。就这三样物品和4000 Zeny。";
				next;
				mes "[化学家莫根斯坦]";
				mes "哇哈哈哈哈！";
				mes "哦，我已经迫不及待要制作了！准备开始了吗？";
				next;
				if (select("制作:取消") == 1) {

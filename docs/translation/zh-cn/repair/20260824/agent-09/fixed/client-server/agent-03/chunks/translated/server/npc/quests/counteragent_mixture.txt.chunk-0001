alberta_in,133,55,3	script	Louitz#cm	84,{
	if (molgenstain == 2) {
		mes "[商人路易兹]";
		mes "哦，又是你。";
		mes "你试着找";
		mes "那个疯狂科学家";
		mes "住在吉芬的吗？";

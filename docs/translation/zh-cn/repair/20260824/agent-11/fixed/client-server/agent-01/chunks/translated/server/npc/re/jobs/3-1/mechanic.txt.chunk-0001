//===== rAthena Script ======================================= 
//= Mechanic Job Quest
//===== By: ================================================== 
//= Muad_Dib
//===== Current Version: ===================================== 
//= 1.3
//===== Compatible With: ===================================== 
//= rAthena Project
//===== Description: ========================================= 
//= [Official Conversion]
//= Jobchange Quest from Blacksmith / Whitesmith -> Mechanic.
//===== Additional Comments: ================================= 
//= 1.0 First Version. [Masao]
//= 1.1 Fixed the Door NPC [JayPee].
//= 1.2 Updated script. [Euphy]
//= 1.3 Added VIP features. [Euphy]
//============================================================ 

yuno,129,156,3	script	Chainheart	923,{
	mes "[链心]";
	if (eaclass() & EAJL_THIRD) {
		mes "作为机匠生活很辛苦，但我很高兴能一直做自己想做的事。";
		close;
	}
	if (job__mechanic == 12) {
		mes "关于机匠或魔导机械，没有什么特别要说的。";
		mes "现在你比任何人都更了解它们。";
		next;
		mes "[链心]";
		mes "通过体验世界提供的一切，继续增长你的知识。";
		close;
	} else if (job__mechanic == 11) {
		if (BaseJob == Job_Blacksmith && BaseLevel > 98 && JobLevel > 49 && SkillPoint == 0) {
			if (ismounting()) {
			mes "你正在骑乘宠物，不能转职。";
			mes "请卸下骑乘宠物后再试！";
				close;
			}
			mes "怎么了？是你吗？";
			mes "等等，你看起来和我上次见你时很不一样。发生了什么？";
			next;
			mes "[链心]";
			mes "啊！你去了我说的朱佩洛斯，就像弗兰克森一样。";
			next;
			mes "[链心]";
			mes "看来没必要再问了。";
			mes "我确定你已经获得成为真正机匠所需的知识。";
			next;
			mes "[链心]";
			mes "我没有更多要说的了。你已经是一名优秀的机匠。";
			mes "不要被称号影响。最重要的是你拥有知识。";
			next;
			mes "[链心]";
			mes "你不像是会把自己关在实验室或图书馆里的人。";
			mes "你会通过积极参与来学习。";
			next;
			mes "[链心]";
			mes "我喜欢现在的你，我认为机匠需要这样的新血液。";
			next;
			mes "[链心]";
			mes "科学是寻找并研究能够用逻辑证明的事物。";
			mes "讽刺的是，科学通常也像魔法一样从不确定的理论开始。";
			next;
			mes "[链心]";
			mes "正如我之前说的，只要热情和才能真实存在，就不会有问题！";
			mes "恭喜你作为机匠踏上新的道路！";
			next;
			set job__mechanic,12;
			completequest 10101;
			if (Sex == SEX_MALE)
				getitem 5749,1; //Driver_Band
			else
				getitem 5760,1; //Driver_Band_
			getitem 2795,1; //Green_Apple_Ring
			jobchange roclass(eaclass()|EAJL_THIRD);
			mes "[链心]";
			mes "这是我送给你的礼物。";
			mes "好好保管它，总有一天你会感谢我的。";
			next;
			mes "[链心]";
			mes "去吧。这个广阔世界就是你的实验室，世界上的一切都是你的教材。";
			mes "愿机匠的未来充满希望！";
			close;
		}
		mes "好像还缺少什么？";
		close;
	} else if (job__mechanic >= 3) {
		mes "对了，弗兰克森失踪了。";
		mes "他说想去学习，然后就消失了。";
		mes "他会去哪儿呢？";
		next;
		mes "[链心]";
		mes "如果你继续走上机匠之路，也许会遇到他。";
		mes "命运的安排总是很奇妙，朋友。";
		next;
		mes "[链心]";
		mes "总之，再见。";
		close;
	} else if (job__mechanic == 2) {
		mes "我想该解释的都解释了，你还想知道什么吗？";
		next;
		switch(select("我想知道更多。:没什么。")) {
		case 1:
			mes "[链心]";
			mes "嗯……？你想进一步了解魔导机械，对吗？";
			next;
			mes "[链心]";
			mes "你似乎很有天赋，如果能成为机匠，对我们来说也不错。";
			mes "但遗憾的是事情没那么简单。";
			next;
			mes "[链心]";
			mes "机匠学者不会轻易认可你，也不会在你展现真正努力前把知识交给你。";
			next;
			mes "[链心]";
			mes "当然，我就是那些学者之一，所以我可以考虑你。";
			next;
			mes "[链心]";
			mes "无论如何，我觉得不经过测试就排除有天赋的人是不公平的。";
			next;
			mes "[链心]";
			mes "嗯……";
			next;
			mes "[链心]";
			mes "其实，如果别人无法教你，你也可以自学。";
			mes "既然别人能做到，任何人都能自己弄明白，对吧？";
			next;
			mes "[链心]";
			mes "这不会容易，但只要你有强烈的热情和真正的天赋，就不会有问题。";
			next;
			mes "[链心]";
			mes "说起来……弗兰克森是独自开发魔导机械的。";
			mes "所以你为什么不去朱佩洛斯遗迹？";
			next;
			mes "[链心]";
			mes "正如我之前说的，只要你的热情和天赋真实存在，就一定能找到些什么。";
			next;
			mes "[链心]";
			mes "像我们一样自己找出知识。";
			mes "别只是等别人教你，展现你所说的热情。";
			next;
			set job__mechanic,3;
			changequest 10091,10092;
			mes "[链心]";
			mes "无论你做出什么选择，我都希望你尽力而为。";
			close;
		case 2:
			mes "[链心]";
			mes "真是个奇怪的人。我还以为你有成为真正机匠的资质。";
			close;
		}
	} else if (job__mechanic == 1) {
		mes "好，让我喘口气。";
		mes "你一定对魔导机械和机匠的世界感兴趣。";
		mes "好，那我来解释一下。";
		next;
		mes "[链心]";
		mes "魔导机械诞生于机械与魔法的融合。直到现在，这两者才真正成功结合。";
		next;
		mes "[链心]";
		mes "如果使用魔导机械，就必须熟悉机械的内部运作。";
		next;
		mes "[链心]";
		mes "它既高效，又不需要依赖像魔法一样不确定且不稳定的东西，还有什么比这更好？";
		next;
		mes "[链心]";
		mes "魔导机械的发明者是来自施瓦茨瓦尔德共和国的学者弗兰克森。";
		next;
		mes "[链心]";
		mes "弗兰克森在^FF0000朱佩洛斯遗迹^000000发现古代机器，并将其与魔法力量融合，这就是起点。";
		next;
		mes "[链心]";
		mes "因此弗兰克森自然将这台新生机器命名为魔导机械。";
		next;
		mes "[链心]";
		mes "由于朱诺以外的地方还不太了解它，魔导机械的研究一直在持续发展。";
		next;
		mes "[链心]";
		mes "因为我们不断研究魔导机械，人们开始称我们为^FF0000机匠^000000。";
		mes "这个名字简单明了，就这样沿用了下来。";
		next;
		mes "[链心]";
		mes "嗯，我想魔导机械就解释到这里。";
		mes "我想继续说明，但内容太专业了，不想再让你感到无聊。";
		next;
		set job__mechanic,2;
		changequest 10090,10091;
		mes "[链心]";
		mes "总之，如果你成为我们的一员，就能自己定义和解释机匠。";
		close;
	}
	if (BaseJob == Job_Blacksmith) {
		if (BaseLevel > 98 && JobLevel > 49 && SkillPoint == 0) {
			if (VIP_SCRIPT) {
				callfunc "VIP_Third_Class";
				set job__mechanic,1;
				setquest 10090;
				next;
			}
			mes "乍看之下，你似乎很擅长处理各种事情。";
			mes "你的技能很不错。你可以成为机匠。";
			next;
			mes "[链心]";
			mes "啊，我还没自我介绍。";
			mes "我是著名的链心。我是一名机匠。";
			mes "嗯，其实我没那么有名。";
			next;
			mes "[链心]";
			mes "我想你对‘机匠’这个词还不熟悉。";
			mes "简单来说，这是一个全新的职业。";
			next;
			mes "[链心]";
			mes "研究并使用魔导机械的人，就是机匠。";
			next;
			mes "[链心]";
			mes "那么，机匠研究和使用的魔导机械是什么？";
			mes "这不容易解释，但我试试看。";
			next;
			setquest 10090;
			set job__mechanic,1;
			mes "[链心]";
			mes "抱歉，我好像说太多了。让我喘口气。";
			mes "如果你感兴趣，请再来和我谈谈。";
			close;
		}
		mes "你看起来很擅长处理各种事情。";
		next;
		mes "[链心]";
		mes "那种力量只用于处理简单事情，无法带给你真正的乐趣。";
		next;
		mes "[链心]";
		mes "没错……如果你想体验真正的操控感和深度，";
		mes "就需要使用^FF0000魔导机械^000000！";
		next;
		mes "[链心]";
		mes "魔导机械出现的时间还不长，所以还不为世人熟知。";
		mes "它非常精密，与这个世界上你体验过的一切都完全不同。";
		next;
		mes "[链心]";
		mes "对，使用魔导机械的人被称为^FF0000机匠^000000。";
		mes "我也是这些光荣机匠中的一员。";
		next;
		mes "[链心]";
		mes "看来你具备成为优秀机匠的资质。以下是基本要求。";
		next;
		mes "[链心]";
		mes "达到^FF0000基础等级 99^000000和^FF0000职业等级 50^000000后回来找我，";
		mes "我会带你进入机匠的世界。";
		close;
	}
	mes "作为机匠生活很辛苦，但我很高兴能一直做自己想做的事。";
	next;
	mes "[链心]";
	mes "你不也想成为机匠，享受真正的幸福吗？";
	close;
}

jupe_cave,37,55,5	script	Scholar#Mechanic	883,{
	if (checkweight(1201,1) == 0 || MaxWeight - Weight < 300) {
		mes "—你的负重太高了。—";
		mes "—请先减轻负重后再试。—";
		close;
	}
	mes "[学者]";
	if (job__mechanic > 10) {
		mes "朱佩洛斯怎么样？我太害怕了，至今还不敢去那里。";
		close;
	} else if (job__mechanic > 3) {
		mes "^FF0000你无法步行抵达目的地。";
		mes "^FF0000这里的问题不是强大的敌人，而是你根本无法走到目的地。^000000";
		next;
		mes "[学者]";
		mes "无论那里多么舒适，我都不打算去。";
		next;
		mes "[学者]";
		mes "那么，你准备好去朱佩洛斯的中途地点了吗？";
		next;
		switch(select("我准备好了！:还没有")) {
		case 1:
			mes "[学者]";
			mes "呃……你这么坚定，反而让我有点后悔没去过那里。";
			mes "我是不是也该去？呃……覆水难收！";
			next;
			mes "[学者]";
			mes "好吧，我送你过去。希望你能获得想要的知识。";
			close2;
			warp "jupe_core2",149,288;
			end;
		case 2:
			mes "[学者]";
			mes "嗯……当然，你会犹豫也不奇怪。";
			next;
			mes "[学者]";
			mes "但如果不使用我为你打开的传送，就无法到达目的地。请不要浪费力气。";
			next;
			mes "[学者]";
			mes "当然，无论那里多么舒适，我都不会去。";
			close;
		}
	}
	mes "我是来朱佩洛斯研究遗迹的学者。";
	next;
	mes "[学者]";
	mes "但是……每当我试图继续深入就会害怕，几乎无法进去。我该怎么办？";
	next;
	mes "[学者]";
	mes "听说人类不受欢迎，但研究里面那些奇妙机器应该很有用。";
	if (job__mechanic != 3) close;
	next;
	mes "[学者]";
	mes "嗯？你也要去朱佩洛斯取什么东西吗？我没有勇气进去。祝你好运。";
	next;
	mes "[学者]";
	mes "我知道去中途地点的路，也有所有需要的东西，但我就是太害怕了。";
	next;
	mes "[学者]";
	mes "如果你愿意，我可以送你去朱佩洛斯。长老学者告诉过我如何传送到中途地点。";
	next;
	set job__mechanic,4;
	mes "[学者]";
	mes "这样确实会方便些，但恐惧还是无法避免，真遗憾。";
	mes "总之，准备好出发时告诉我。";
	close;
}

jupe_core2,149,273,3	script	Ghostfire#1	802,{
	mes "[?]";
	if (job__mechanic == 11) {
		mes "我失去了身体，只剩灵魂留在这里。";
		mes "我会永远在朱佩洛斯生活与死亡……";
		close;
	} else if (job__mechanic == 10) {
		mes "那个样子……是这样吗？你也获得了知识。";
		mes "当未来充满可能……像纯真孩子一样，相信自己无所不能……";
		next;
		mes "[?]";
		mes "现在想来，眼下最珍贵的也许不是知识本身，而是获得自信……";
		next;
		mes "[?]";
		mes "请不要像我一样再犯错误。希望有一天你能自己获得知识。";
		next;
		mes "[?]";
		mes "那么回去吧，找到了解魔导机械的人类，证明你已经获得了知识……";
		next;
		mes "[?]";
		mes "我就是那个失去身体、灵魂也被扰乱的人。";
		mes "我被困在朱佩洛斯……我要永远与朱佩洛斯共存亡……";
		next;
		mes "[?]";
		mes "我的名字……名字是……弗……";
		close2;
		set job__mechanic,11;
		changequest 10100,10101;
		warp "yuno",157,83;
		end;
	} else if (job__mechanic > 4) {
		mes "我失去了身体，只剩灵魂留在这里。";
		mes "我会永远在朱佩洛斯生活与死亡……";
		close;
	} else if (job__mechanic > 2) {
		mes "有天赋的人，确认周围没有敌人。";
		mes "如果你专注于我，可能会受到攻击。";
		next;
		if(select("那就下次见。:专心。") == 1) close;
		mes "[?]";
		mes "我曾经是人类学者。";
		mes "我想了解人类未知的科学极限，所以学习、研究并不断探索……";
		next;
		mes "[?]";
		mes "那时我发现了不确定的魔法力量。";
		next;
		mes "[?]";
		mes "不确定的魔法高度不稳定且无法预测。";
		mes "研究期间，我遇到了一小片极其不稳定的魔法。";
		next;
		mes "[?]";
		mes "我只有从那天开始的记忆。从那以后就被困在这里。";
		next;
		mes "[?]";
		mes "现在我所知道的只有朱佩洛斯。我会死在这里。";
		next;
		mes "[?]";
		mes "我不知道你是谁……";
		mes "如果你想获得知识，就去找愿意关心你的人。";
		next;
		if (job__mechanic == 3 || job__mechanic == 4)
			changequest 10092,10094;
		set job__mechanic,5;
		mes "[?]";
		mes "知识不是从别人那里得到的，而是通过自己的努力发现的。";
		mes "找到属于你自己的知识之路。";
		close;
	}
	end;
}

jupe_core2,53,75,3	script	Ghostfire#2	802,{
	mes "[?]";
	if (job__mechanic > 5) {
		mes "朱佩洛斯……我……";
		mes "朱佩洛斯……我想要的一切都在这里……";
		mes "科学的力量……机器的天堂……";
		close;
	} else if (job__mechanic == 5) {
		mes "有天赋的人，确认周围没有敌人。";
		mes "如果你专注于我，可能会受到攻击。";
		next;
		if(select("那就下次见:专心") == 1) close;
		mes "[?]";
		mes "当我还拥有身体时，我想证明";

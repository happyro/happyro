		mes "我们的怪物赛跑竞技场有";
		mes "两种赛跑。首先是单怪物赛跑，";
		mes "押注第一名怪物的人会获奖。";
		next;
		mes "[埃卡尔·埃勒比德]";
		mes "此外还有双怪物";
		mes "赛跑，赔率和奖励高于单怪物赛跑：";
		mes "你必须押注两只怪物，它们必须分别获得";
		mes "第一和第二名才能获胜。";
		next;
		mes "[埃卡尔·埃勒比德]";
		mes "虽然需要少量入场费，";
		mes "但我们只用这些钱";
		mes "奖励";
		mes "参赛者并维护";
		mes "竞技场，不会";
		mes "从中获利。";
		next;
		mes "[埃卡尔·埃勒比德]";
		mes "此外，我们禁止他人";
		mes "私下注";
		mes "或使用物品和";
		mes "Zeny，根据赛果";
		mes "进行赌博。这种";
		mes "赌博在这里违法……";
		next;
		mes "[埃卡尔·埃勒比德]";
		mes "进入赛跑竞技场后会获得赛跑券。";
		mes "请注意，获胜赛跑券只能在赛跑结束后 5 分钟内兑换";
		mes "奖牌。";
		next;
	}
	mes "[埃卡尔·埃勒比德]";
	mes "怪物赛跑竞技场所有比赛的";
	mes "入场费为";
	mes "2,000 Zeny。若想押注双怪物赛跑，";
	mes "请询问我的兄弟埃雷涅斯，";
	mes "他会帮助你。";
	next;
	mes "[埃卡尔·埃勒比德]";
	mes "否则如果你对单怪物赛跑感兴趣，";
	mes "我会帮你开始。";
	mes "";
	mes "要押注";
	mes "单怪物赛跑吗？";
	next;
	if (select("好的，请。:不用了，谢谢。") == 2) {
		mes "[埃卡尔·埃勒比德]";
		mes "很好，希望你";
		mes "在这里度过愉快时光";
		mes "怪物赛跑竞技场~";
close;
}

	if (!checkweight("Spawn",700)) {
		mes "[埃卡尔·埃勒比德]";
		mes "哦，哇。你带了";
		mes "太多物品……是的，";
		mes "最好把一部分存入";
		mes "卡普拉仓库。";
		close;
	}
	if (Zeny < 2000) {
		mes "[埃卡尔·埃勒比德]";
		mes "抱歉，你";
		mes "没有足够";
		mes "支付";
		mes "2,000 Zeny 入场费。";
		close;
	}
	if (countitem("Monster_Ticket")) {
		mes "[埃卡尔·埃勒比德]";
		mes "嗯？你拿着过期赛跑券";
		mes "在做什么？";
		mes "我最好在它与新赛跑券混淆前帮你处理掉";
		mes "。";
		delitem 7514,1; //Monster_Ticket
		next;
		if ($@mon_time_1_1 == 1) {
			if (Zeny < 2000) {
				mes "[埃卡尔·埃勒比德]";
				mes "抱歉，你";
				mes "没有足够";
				mes "支付";
				mes "2,000 Zeny 入场费。";
				close;
			}
			mes "[埃卡尔·埃勒比德]";
			mes "好，我想你已经准备好了。希望你享受比赛~现在我带你进入怪物赛跑竞技场。";
			Zeny -= 2000;
			monster_race_1 = 0;
			close2;
			warp "p_track01",75,41;
			end;
		}
	} else if ($@mon_time_1_1 == 1) {
		mes "[埃卡尔·埃勒比德]";
		mes "谢谢，希望你享受比赛。我现在带你去怪物赛跑竞技场。";
		Zeny -= 2000;
		monster_race_1 = 0;
		close2;
		warp "p_track01",75,41;
		end;
	}
	if ($@mon_time_1_1 == 2) {
		mes "[埃卡尔·埃勒比德]";
		mes "我们还在准备下一场单怪物赛跑，请再等一会儿……";
		close;
	}
	if ($@monster_race == 0) {
		mes "[埃卡尔·埃勒比德]";
		mes "现在正在进行怪物赛跑，已经来不及下注了。但如果想观看，观众费用为 500 Zeny。要进入竞技场吗？";
		next;
		if (select("进入:取消") == 2) {
			mes "[埃卡尔·埃勒比德]";
			mes "好吧。如果想下注，请等当前比赛结束。希望你在这里度过愉快时光。";
			mes "怪物赛跑竞技场~";
			close;
		}
		if (Zeny > 499) {
			mes "[埃卡尔·埃勒比德]";
		mes "谢谢~希望你享受观看比赛！";
			Zeny -= 500;
			monster_race_1 = 0;
			close2;
			warp "p_track01",75,41;
			end;
		}
		mes "[埃卡尔·埃勒比德]";
		mes "抱歉，你 don't";
		mes "没有足够的钱支付 500 Zeny 观众费用。";
		close;
	}
	mes "[埃卡尔·埃勒比德]";
	mes "抱歉，怪物赛跑刚结束，现在是获胜者领取奖牌的 5 分钟时间。入口很快开放，请耐心等待。";
	close;
OnEnable:
	enablenpc "Eckar Ellebird#single";
	end;
OnDisable:
	disablenpc "Eckar Ellebird#single";
	end;
}

p_track01,39,49,3	script	Game Guide#single	845,{
		mes "[比赛指南]";
		mes "欢迎来到";
		mes "怪物赛跑竞技场。";
		mes "我能帮你什么？";
	next;
	switch(select("怪物赛跑说明:投注说明:赛跑券兑换说明")) {
	case 1:
		mes "[比赛指南]";
		mes "怪物赛跑起源于";
		mes "让可爱宠物互相竞速的";
		mes "简单儿童游戏。后来发展成受欢迎的成人";
		mes "娱乐活动，我们还在胡格尔建了赛跑竞技场。";
		next;
		mes "[比赛指南]";
		mes "我们的怪物赛跑竞技场有";
		mes "两种赛跑。首先是单怪物赛跑，";
		mes "押注第一名怪物的人会获奖。";
		next;
		mes "[比赛指南]";
		mes "此外还有双怪物";
		mes "赛跑，赔率和奖励高于单怪物赛跑：";
		mes "你必须押注两只怪物，它们必须分别获得";
		mes "第一和第二名才能获胜。";
		next;
		mes "[比赛指南]";
		mes "虽然需要少量入场费，";
		mes "但我们只用这些钱";
		mes "奖励";
		mes "参赛者并维护";
		mes "竞技场，不会";
		mes "从中获利。";
		next;
		mes "[比赛指南]";
		mes "此外，我们禁止他人";
		mes "私下注";
		mes "或使用物品和";
		mes "Zeny，根据赛果";
		mes "进行赌博。这种";
		mes "赌博在这里违法……";
		next;
		mes "[Game Guide]";
		mes "进入赛跑竞技场后会获得赛跑券。";
		mes "请注意，获胜赛跑券只能在赛跑结束后 5 分钟内兑换";
		mes "奖牌。";
		next;
		break;
	case 2:
		mes "[比赛指南]";
		mes "投注前，你必须先获得";
	mes "免费的赛跑券。";
		mes "虽然需要少量入场费，";
		mes "但我们只用这些钱奖励参赛者并维护竞技场。";
		mes "因此，我们并不是从这项事业中获利。";
		next;
		mes "[比赛指南]";
		mes "此外，我们禁止他人根据赛果进行私下注或使用物品、Zeny 赌博。";
		mes "这种赌博在这里是违法的……";
		next;
		mes "[比赛指南]";
		mes "进入赛跑竞技场后，你会获得一张赛跑券。";
		mes "请注意，获胜赛跑券只能在比赛结束后的 5 分钟内兑换奖牌。";
		next;
		break;
	case 2:
		mes "[比赛指南]";
		mes "下注前，必须先从赛跑券助手那里领取免费的赛跑券。";
		mes "我已经在小地图上标记了赛跑券助手的位置，很容易找到。";
		viewpoint 1,73,22,1,0xFF3355;
		next;
		break;
	case 3:
		mes "[比赛指南]";
		mes "如果你押中了单怪物赛跑的冠军，";
		mes "或押中了双怪物赛跑的第一、第二名，";
		mes "就可以用赛跑券兑换奖牌。";
		next;
		mes "[比赛指南]";
		mes "不过，你必须在比赛结束后的 5 分钟内，";
		mes "向奖牌兑换员兑换赛跑券。^FF0000这 5 分钟后，赛跑券将失效。^000000";
		next;
		mes "[比赛指南]";
		mes "5 分钟窗口结束后，你会被传送到场外，我们也会立即开始准备下一场比赛。";
		mes "下注时请务必记住这一点。";
		next;
		mes "[比赛指南]";
		mes "如果你还没有领取免费的赛跑券，";
		mes "请前往赛跑券助手处。";
		mes "我已经在小地图上标记了他的位置。";
		viewpoint 1,67,45,2,0xCE6300;
		next;
		break;
	}
	mes "[比赛指南]";
	mes "谢谢你，";
	mes "希望你在怪物赛跑竞技场";
	mes "度过愉快的时光。";
	close;
}

-	script	starting_1	-1,{
OnTouchNPC:
	// .@speed = 10 * ( 6 + rand(100)/10 );// speed 60-150
	.@start = rand(1,100);
	if (.@start < 11) .@speed = 60;
	else if (.@start < 21) .@speed = 70;
	else if (.@start < 31) .@speed = 80;
	else if (.@start < 41) .@speed = 90;
	else if (.@start < 51) .@speed = 100;
	else if (.@start < 61) .@speed = 110;
	else if (.@start < 71) .@speed = 120;
	else if (.@start < 81) .@speed = 130;
	else if (.@start < 91) .@speed = 140;
	else .@speed = 150;
	sc_start SC_WALKSPEED,5000,.@speed;
	end;
	
OnInit:
	disablenpc();
	end;
}


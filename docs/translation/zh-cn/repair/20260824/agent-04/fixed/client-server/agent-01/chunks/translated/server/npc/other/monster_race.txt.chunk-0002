// 怪物赛跑——双怪物赛跑
//============================================================
hugel,47,56,0	script	#race_timer2-1	-1,{
OnEnable:
	enablenpc "#race_timer2-1";
OnInit:
	$@mon_time_2_1 = 2;
	initnpctimer;
	end;

OnTimer10000:
	mapannounce "hugel","双怪物赛跑即将开始，欢迎大家踊跃参加！",bc_map,"0xffb6c1";
	end;

OnTimer30000:
	mapannounce "hugel","双怪物赛跑竞技场现已开放。",bc_map,"0xffb6c1";
	$@mon_time_2_1 = 1;
	donpcevent "#race_timer2-2::OnEnable";
	donpcevent "TrapGlobal#race02::OnEnable";
	enablenpc "Ticket Helper#2";
	end;

OnTimer90000:
	mapannounce "hugel","双怪物赛跑竞技场现已开放，参赛者请尽快进入竞技场。",bc_map,"0xffb6c1";
	end;

OnTimer210000:
	mapannounce "hugel","双怪物赛跑竞技场入口即将关闭，请参赛者现在进入竞技场。",bc_map,"0xffb6c1";
	end;

OnTimer270000:
	mapannounce "hugel","双怪物赛跑竞技场入口即将关闭。",bc_map,"0xffb6c1";
	end;

OnTimer272000:
	mapannounce "hugel","参赛者请在入口关闭前进入竞技场。",bc_map,"0xffb6c1";
	end;

OnTimer330000:
	mapannounce "hugel","比赛现在开始。如果错过了本场比赛，请下次再来～！",bc_map,"0xffb6c1";
	$@mon_time_2_1 = 0;
	disablenpc "#race_timer2-1";
	stopnpctimer;
	end;
}

p_track02,42,23,0	script	#race_timer2-2	-1,{
OnEnable:
	enablenpc "#race_timer2-2";
	$@mon_time_2_2 = 0;
	initnpctimer;
	end;

OnTimer5000:
	mapannounce "p_track02","欢迎来到怪物赛跑竞技场。",bc_map,"0x87ceeb";
	end;

OnTimer7000:
	mapannounce "p_track02","如有疑问，欢迎随时向服务台咨询。",bc_map,"0x87ceeb";
	end;

OnTimer120000:
	mapannounce "p_track02","双怪物赛跑将在 3 分钟后开始。",bc_map,"0x87ceeb";
	end;

OnTimer122000:
	mapannounce "p_track02","想下注的话，请向赛跑券助手咨询。",bc_map,"0x87ceeb";
	end;

OnTimer240000:
	mapannounce "p_track02","双怪物赛跑即将开始。",bc_map,"0x87ceeb";
	end;

OnTimer242000:
	mapannounce "p_track02","想下注的话，请向赛跑券助手咨询。",bc_map,"0x87ceeb";
	end;

OnTimer300000:
	mapannounce "p_track02","怪物赛跑现在开始。祝大家好运！",bc_map,"0x87ceeb";
	$@mon_time_2_2 = 1;
	disablenpc "Ticket Helper#2";
	donpcevent "#poring1::OnEnable";
	donpcevent "#lunatic1::OnEnable";

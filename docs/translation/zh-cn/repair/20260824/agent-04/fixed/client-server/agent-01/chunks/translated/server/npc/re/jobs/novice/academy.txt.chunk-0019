					switch(select("真无聊。", "我需要更多训练。", "我想马上成为剑士！")) {
					case 1:
						mes "[训练师阿德里克]";
						mes "简单回答‘不’就够了。";
						cutin "", 255;
						close;
					case 2:
						mes "[训练师阿德里克]";
						mes "去一楼军械室找战斗教官苏比诺。";
						mes "准备好后再回来。你很快就该转职为剑士了！";
						nov_3_swordman = 3;
						if (isbegin_quest(1230))
							erasequest 1230;
						cutin "", 255;
						close;
					case 3:
						mes "[训练师阿德里克]";
						mes "看来你已经学得够多了。";
						mes "前往剑士公会继续剑士转职！";
						next;
						mes "[训练师阿德里克]";
						mes "剑士公会位于依斯鲁德广场中心的西边。";
						mes "应该很容易找到。";
						cutin "", 255;
						nov_3_swordman = 4;
						if (isbegin_quest(1230))
							erasequest 1230;
						close;
					}
				case 3:
					mes "[训练师阿德里克]";
					mes "看来你已经学得够多了。";
					mes "前往剑士公会继续剑士转职！";
					next;
					mes "[训练师阿德里克]";
					mes "剑士公会位于依斯鲁德广场中心的西边。";
					mes "应该很容易找到。";
					cutin "", 255;
					nov_3_swordman = 4;
					if (isbegin_quest(1230))
						erasequest 1230;
					close;
				}
			}
		} else if (nov_3_swordman == 3) {
			if (JobLevel < 10) {
				mes "[训练师阿德里克]";
				mes "你还不具备成为剑士的条件。";
				next;
				mes "[训练师阿德里克]";
				mes "如果需要战斗训练，就去学院一楼军械室找苏比诺。";
				cutin "", 255;
				close;
			} else {
				mes "[训练师阿德里克]";
				mes "看来你已经学得够多了。前往剑士公会继续剑士转职！";
				next;
				mes "[训练师阿德里克]";
				mes "剑士公会位于依斯鲁德广场中心的西边，应该很容易找到。";
				cutin "", 255;
				nov_3_swordman = 4;
				if (isbegin_quest(1230))
					erasequest 1230;
				close;
			}
		} else if (nov_3_swordman == 4) {
			mes "[训练师阿德里克]";
			mes "这段时间你必须努力训练。";
			next;
			mes "[训练师阿德里克]";
			mes "继续提升能力，转职成为出色的职业！";
			cutin "", 255;
			close;
		}
	} else if (Class == Job_Swordman) {
		mes "[训练师阿德里克]";
		mes "你已经是剑士了！";
		next;
		mes "[训练师阿德里克]";
		mes "没有其他特别的东西可以教你。";
		cutin "", 255;
		close;
	} else {
		mes "[训练师阿德里克]";
		mes "嘿！你已经有职业了！";
		next;
		mes "[训练师阿德里克]";
		mes "走开！";
		cutin "", 255;
		close;
	}
}

iz_ac02_a,60,51,5	duplicate(Swordman Trainer#ac)	Swordman Trainer#ac_a	4_M_SWORDMAN
iz_ac02_b,60,51,5	duplicate(Swordman Trainer#ac)	Swordman Trainer#ac_b	4_M_SWORDMAN
iz_ac02_c,60,51,5	duplicate(Swordman Trainer#ac)	Swordman Trainer#ac_c	4_M_SWORDMAN
iz_ac02_d,60,51,5	duplicate(Swordman Trainer#ac)	Swordman Trainer#ac_d	4_M_SWORDMAN

// - Swordman Assistant (Neals)
// -----------------------------------------------------------------------------
iz_ac02,53,48,5	script	Swordman Assistant#ac	4_M_KY_KNT,{
	if (isbegin_quest(4269) != 2) {
			mes "[助理训练师尼尔斯]";
			mes "你想了解剑士吗？如果想参加课程，必须先登记，然后回来这里。";
		close;
	}
	if (Class == Job_Novice && JobLevel >= 10) {
			mes "[助理训练师尼尔斯]";
			mes "你的职业等级已经足够，不需要再听课了。";
		next;
		if (select("那我就停下。", "马上成为剑士！") == 1) {
			mes "[助理训练师尼尔斯]";
			mes "训练开始前你就已经提升了等级。真令人印象深刻。";
			close;
		}
			mes "[助理训练师尼尔斯]";
			mes "看来你已经成长充分。前往剑士公会成为剑士吧！";
		next;
			mes "[助理训练师尼尔斯]";
			mes "剑士公会位于依斯鲁德广场，从中心向西走。应该很容易找到。";
		cutin "", 255;
		if (isbegin_quest(1230))
			erasequest 1230;
		close;
	} else {
		if (Class == Job_Swordman) {
			mes "[助理训练师尼尔斯]";
			mes "你现在是剑士了！没有其他特别的东西可以教你。";
			close;
		} else if (Class != Job_Novice) {
			mes "[助理训练师尼尔斯]";
			mes "你已经有其他职业了！走开！";
			close;
		} else {
			if (isbegin_quest(1229) == 2) {
				mes "[助理训练师尼尔斯]";
				mes "我们来复习剑士的前置知识，这是复习课程！";
				next;
				while(1) {
					switch(select("剑士要点", "提升攻击与防御。", "相关属性", "其他剑士职业？", "我已经学够了。")) {
					case 1:
						mes "[助理训练师尼尔斯]";
						mes "剑士体质强健，能轻松承受敌人伤害；组队时是领导者和保护者。";
						next;
						break;
					case 2:
						mes "[助理训练师尼尔斯]";
						mes "剑士偏好使用长矛、双手剑或剑盾组合。";
						next;
						mes "[助理训练师尼尔斯]";
						mes "剑士通常活力很高，因此可以携带大量重量。";
						next;
						break;
					case 3:
						mes "[助理训练师尼尔斯]";
						mes "通常推荐的属性是^0000FF力量、^0000FF敏捷^000000、^0000FF体质^000000和^0000FF灵巧^000000，当然由你决定。";
						next;
						mes "[助理训练师尼尔斯]";
						mes "^0000FF体质^000000影响^FF0000HP恢复速度^000000。";
						mes "^0000FF力量^000000影响^FF0000力量和攻击力^000000。";
						mes "^0000FF灵巧^000000提高^FF0000攻击命中率^000000。";
						next;
						mes "[训练师阿德里克]";
						mes "^0000FF敏捷^000000提高^FF0000攻击速度^000000和^FF0000回避率^000000。";
						mes "^0000FF幸运^000000影响^FF0000暴击概率^000000。";
						next;
						break;
					case 4:
						mes "[助理训练师尼尔斯]";
						mes "转职为剑士后，可以转职为^0000FF骑士^000000或^0000FF十字军^000000。";
						next;
						mes "[助理训练师尼尔斯]";
						mes "确定自己偏向攻击还是防御的同时，去提升你的力量。这是你应该做的事。";
						break;
					case 5:
						mes "[助理训练师尼尔斯]";
						mes "随时可以再来问。我会回答一切！";
						close;
					}
					mes "[助理训练师尼尔斯]";
					mes "我们来复习剑士的前置知识，这是复习课程！";
					next;
				}
			} else {
				mes "[助理训练师尼尔斯]";
				mes "像你这样弱小的人也能很快成为英勇的剑士。";
				mes "没错，你可以。要有抱负。";
				close;
			}
		}
	}
}

iz_ac02_a,53,48,5	duplicate(Swordman Assistant#ac)	Swordman Assistant#ac_a	4_M_KY_KNT
iz_ac02_b,53,48,5	duplicate(Swordman Assistant#ac)	Swordman Assistant#ac_b	4_M_KY_KNT
iz_ac02_c,53,48,5	duplicate(Swordman Assistant#ac)	Swordman Assistant#ac_c	4_M_KY_KNT
iz_ac02_d,53,48,5	duplicate(Swordman Assistant#ac)	Swordman Assistant#ac_d	4_M_KY_KNT

// =============================================================================
// = Magician
// =============================================================================

// - Mage Chuck
// -----------------------------------------------------------------------------
iz_ac02,148,110,3	script	Mage Chuck#ac	4_M_JOB_WIZARD,{
	cutin "nov_magicsoul01.bmp", 2;
	if (Class == Job_Novice) {
		if (isbegin_quest(4269) == 2) {
			mes "[法师查克]";
			mes "我负责克里阿图拉学院的魔法研究，";
			mes "是^0000FF天才法师^000000~！";
			mes "^0000FF法师查克^000000。";
			next;
			mes "[法师查克]";
			mes "像你这样有魔法天赋却不知道如何成为法师的人，";
			mes "我愿意为^FF0000初心者^000000提供训练。";
			next;
			mes "[法师查克]";
			mes "怎么样？想试试我无价的课程吗？";
			next;
			if (select("我要学习。", "不用了，谢谢！") == 2) {
				mes "[法师查克]";
				mes "不听我的话，你会后悔的。";
				next;
				mes "[法师查克]";
				mes "改变主意后就回来找我。";
			} else {
				mes "[法师查克]";
				mes "很好！既然你决定了，我会尽力。";
				mes "你能学多少取决于自己的努力。";
				next;
				mes "[法师查克]";
				mes "要成为法师，你必须勤奋好学。问我你想学什么吧！";
				while(1) {
					next;
					switch(select("法师的主要职责是什么？", "哪些^8B4513属性^000000适合法师？", "法师有哪些^8B4513技能^000000？", "我可以试试技能吗？！", "我想^8B451C转职^000000为法师！", "我之后再来")) {
					case 1:
						mes "[法师查克]";
						mes "法师的主要职责是使用魔法发动强力攻击。";
						next;
						mes "[法师查克]";
						mes "我们的防御力较低，但拥有各种攻击^006400技能^000000。";
						mes "作为法师要小心承受的伤害。";
						next;
						mes "[法师查克]";
						mes "记住这些小事，你就能成为优秀的法师。";
						mes "随着魔力增长，骄傲地前进吧~";
						next;
						mes "[法师查克]";
						mes "还想了解法师的其他事情吗？";
						break;
					case 2:
						mes "[法师查克]";
						mes "说到法师，你是不是想到了某种坚实的东西？";
						next;
						mes "[法师查克]";
						mes "纯粹的物理力量属于提升^006400力量^000000的莽夫。";
						mes "对我这样的^0000FF天才法师^000000来说那是浪费。";
						next;
						mes "[法师查克]";
						mes "用^006400心灵力量^000000变得聪明睿智。";
						mes "法师的主要属性是^006400智力^000000，这最重要！";
						next;
						mes "[法师查克]";
						mes "记住这些小事，你就能成为优秀的法师。";
						mes "随着魔力增长，骄傲地前进吧~";
						next;
						mes "[法师查克]";
						mes "还想了解法师的其他事情吗？";
						break;
					case 3:
						mes "[法师查克]";
						mes "法师拥有强大的魔法技能。";
						mes "这些技能以^006400<水、风、地、火>^000000属性为基础。";
						next;
						mes "[法师查克]";
						mes "每种元素都有自己的^006400范围攻击魔法^000000，面对大量敌人时非常有用~！！";
						next;
						mes "[法师查克]";
						mes "好了，废话到此为止。";
						mes "我会用演示展现我的力量，你应该感到荣幸！";
						next;
						mes "[法师查克]";
						switch(rand(1,7)) {
						case 1:
							mes "探测隐藏敌人";
							mes "^006400洞察^000000!!!!";
							specialeffect EF_SIGHT;
							break;
						case 2:
							mes "抵挡所有物理攻击";
							mes "^006400能量外套^000000!!!!";
							specialeffect EF_GLASSWALL;
							break;
						case 3:
							mes "火焰伤害第一~！！！";
							mes "^006400火球术^000000!!!!";
							specialeffect EF_FIREBALL;
							break;
						case 4:
							mes "火墙~！！";
							mes "^006400火墙术^000000!!!!";
							specialeffect EF_FIREWALL;
							break;
						case 5:
							mes "想尝尝雷电的滋味吗？";
							mes "^006400雷击术^000000!!!!";
							specialeffect EF_LIGHTBOLT;
							break;
						case 6:
							mes "迷失在风暴中吧！";
							mes "^006400雷暴术^000000!!!!";
							specialeffect EF_THUNDERSTORM;
							break;
						case 7:
							mes "是什么杀死了恐龙？";
							mes "冰河时代！";
							mes "^006400冰冻术^000000!!!!";
							specialeffect EF_FROSTDIVER2;
							break;
						}
						next;
						mes "[法师查克]";
						mes "看到我的技能是不是很震撼？你不会受伤的，别担心~！";
						next;
						mes "[法师查克]";
						mes "还想了解法师的其他事情吗？";
						break;
					case 4:
						if (isequippedcnt(2824) > 0 || countitem(2824) > 0) {
							mes "[法师查克]";
							mes "我想你已经拿过^FF0000法师手册^000000了~！";
							mes "我不能给你两本，一本就够了~！";
							next;
							mes "[法师查克]";
							mes "装备^006400法师手册^000000后试用技能。";
							mes "然后使用技能窗口中的技能狩猎。";
							next;
							mes "[法师查克]";
							mes "还想了解法师的其他事情吗？";
						} else {
							if (checkweight(607,1)) {
								mes "[法师查克]";
								mes "对，你一定已经下定决心成为法师了。";
								next;
								mes "[法师查克]";
								mes "好！我就给你体验成为法师的机会。";
								mes "拿着这本^006400法师手册^000000，我借给你！";
								next;
								mes "[法师查克]";
								mes "装备^006400法师手册^000000后试用技能，然后使用技能窗口中的技能狩猎。";
								next;
								mes "[法师查克]";
								mes "这是珍贵物品，不要弄丢。";
								mes "如果想成为像我一样的^0000FF天才法师^000000，就沿着我的道路前进。";
								getitem 2824,1;// Mage_Manual
								break;
							} else {
								mes "[法师查克]";
								mes "如果想成为法师，请减轻库存负重。";
								next;
								mes "[法师查克]";
								mes "还想了解法师的其他事情吗？";
							}
						}
						break;
					case 5:
						if (isbegin_quest(9264) == 2) {
							mes "[法师查克]";
							mes "啊~你想转职为魔法师？";
							next;
							mes "[法师查克]";
							mes "我之前送你们过去似乎消耗了太多魔力……";
							mes "像你这样的学生太多了，我不能再送你一次！";
							next;
							mes "[法师查克]";
							mes "如果真的想去，请找卡普拉员工使用传送服务。";
						} else {
							mes "[法师查克]";
							mes "啊~你想转职为魔法师？";
							next;
							mes "[法师查克]";
							mes "要转职为魔法师，必须前往魔法师公会。";
							mes "我可以送你到附近，但是……";
							next;
							mes "[法师查克]";
							mes "你必须先达到^006400职业等级 10^000000和^006400基本技能等级 9^000000。";
							next;
							if (!callfunc("F_CanChangeJob")) {
								mes "[法师查克]";
								mes "你还没准备好！";
								mes "想转职必须先达到^006400职业等级 10^000000和^006400基本技能等级 9^000000。";
								mes "之后再回来找我！";
								next;
								mes "[法师查克]";
								mes "还想了解魔法师的什么事情？";
							} else {
								mes "[法师查克]";
								mes "啊，看来你已经满足这些条件了！要现在转职吗？";
								next;
								if (select("不", "是") == 1) {
									mes "[法师查克]";
									mes "好吧，决定后再回来！";
									next;
									mes "[法师查克]";
									mes "还想了解魔法师的什么事情？";
								} else {
									mes "[法师查克]";
									mes "那么我会用魔法把你送到^8B4513吉芬^000000附近的魔法师公会。";
									mes "你可以在那里转职为魔法师。";
									next;
									mes "[法师查克]";
									mes "送你过去后，请和^0000FF魔法师公会指南^000000交谈。";
									mes "他们会进一步帮助你。走吧！我准备送你过去了！";
									next;
									mes "[法师查克]";
									mes "呼——呼——";
									mes "哦……哦……嗯……嗯！";
									mes "传送！";
									cutin "", 255;
									next;
									setquest 9264;
									savepoint "geffen",120,38,1,1;
									warp "gef_fild07", 88, 205;
									end;
								}
							}
						}
						break;
					case 6:
						mes "[法师查克]";
						mes "是的~去见见其他老师，然后再回来。";
						mes "当然，法师是所有职业中最迷人的~";
						next;
						mes "[法师查克]";
						mes "我相信你还会选择法师~~！！哈哈，回头见~";
						break;
					}
					break;
				}
			}
		} else {
			mes "[法师查克]";
			mes "首先要在学院前台完成^8B4513登记^000000。";
			mes "去学院一楼，会有人帮你登记。";
		}
	} else {
		mes "[法师查克]";
		mes "你已经不再是那个一无所知的^8b4513初心者^000000了~？";
		mes "我没什么可教你的了~！";
	}
	close2;
	cutin "", 255;
	end;
}

iz_ac02_a,148,110,3	duplicate(Mage Chuck#ac)	Mage Chuck#ac_a	4_M_JOB_WIZARD
iz_ac02_b,148,110,3	duplicate(Mage Chuck#ac)	Mage Chuck#ac_b	4_M_JOB_WIZARD

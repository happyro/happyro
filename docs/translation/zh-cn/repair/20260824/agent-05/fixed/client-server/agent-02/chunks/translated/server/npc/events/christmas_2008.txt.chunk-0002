// Louise Kim - Santa Suit
//============================================================
xmas_in,89,92,4	script	Louise Kim#iROxmas08	714,{
	mes "[路易丝·金]";
	mes "我一直觉得圣诞老人穿着太无聊的服装，实在太无聊了。";
	mes "太无聊了！";
	next;
	mes "[路易丝·金]";
	mes "我可以给他设计一套华丽的款式！";
	next;
	mes "[路易丝·金]";
	mes "我曾为臭名昭著的安东尼奥制作过服装！";
	mes "之所以很难追上他，是因为他的衣服被赋予了强大力量！";
	mes "我还为它们施加了好运祝福！";
	next;
	emotion ET_THROB;
	mes "[路易丝·金]";
	mes "普莱塔·波特！！";
	mes "既豪华，价格又实惠～";
	next;
	mes "[路易丝·金]";
	mes "嘿，失败者们！";
	mes "只要替我完成一个小任务，就能分享我的时尚品味，穿上我的设计。";
	next;
	mes "[路易丝·金]";
	mes "你感兴趣吗？";
	next;
	if (select("不要。:好的，请给我任务。") == 1) {
		mes "[路易丝·金]";
		mes "啊！";
		mes "你真傻！错过大好机会了！";
		next;
		emotion ET_SMILE;
		mes "[路易丝·金]";
		mes "以后想接任务再来找我。";
		mes "我路易丝·金很慷慨，下次也会接受你。";
		close;
	}
	mes "[路易丝·金]";
	mes "你真酷。";
	next;
	mes "[路易丝·金]";
	mes "别担心这个任务。";
	mes "并不难。";
	mes "我只是需要一些材料，那些超出我能力范围的东西……";
	next;
	mes "[路易丝·金]";
	mes "总之，你能带些东西给我吗？";
	next;
	if (select("没问题。你需要什么？:抱歉，没时间。") == 2) {
		emotion ET_SMILE;
		mes "[路易丝·金]";
		mes "什么？";
		mes "你一定会后悔的。";
		mes "以后不会再有机会了。";
		close;
	}
	mes "[路易丝·金]";
	mes "好，你很酷！！";
	mes "你需要带给我：^0000FF棉衬衫、红色药水 3 瓶、圣水、包装纸 4 张、包装丝带^000000。";
	next;
	mes "[路易丝·金]";
	mes "如果你把这些东西都带来，我就能为你制作华丽的圣诞服装。";
	next;
	if (countitem(2301) < 1 || countitem(501) < 3 || countitem(523) < 1 || countitem(7175) < 4 || countitem(7174) < 1) {
		mes "[路易丝·金]";
		mes "只要把这些东西都带来，我就免费为你制作漂亮的服装……";
			next;
			emotion ET_THROB;
		mes "[路易丝·金]";
		mes "感兴趣的话再来找我。";
			close;
	} else {
		select("给你。");
		emotion ET_OK;
		mes "[路易丝·金]";
		mes "哦！很好！";
		mes "别耽搁了。";
		mes "让我展示无穷的能力。";
		next;
		mes "-她把所有东西倒进锅里-";
		mes "-连衬衫也放了进去！-";
		mes "-她熟练地将其取出-";
		mes "-唱着祝福之歌。-";
		next;
		specialeffect EF_BLESSING;
		emotion ET_DELIGHT;
		mes "[路易丝·金]";
		mes "艺术家路易丝·金出手！";
		mes "今晚全世界都会受到祝福！";
		next;
		mes "-把红色药水倒进另一口锅-";
		mes "-搅拌其中的每一部分。-";
		mes "-放入棉衬衫-";
		mes "-为感恩的心染上色彩。-";
		mes "-一根线一根线-";
		mes "-一缕丝一缕丝-";
		mes "-数着祝福放声歌唱！-";
		next;
		specialeffect EF_GLORIA;
		emotion ET_DELIGHT;
		mes "[路易丝·金]";
		mes "艺术家路易丝·金出手！";
		mes "今晚全世界都会受到祝福！";
		next;
		mes "-她正在编织服装-";
		mes "-用一根钩针-";
		mes "-凭借高超技艺。-";
		mes "-传播你的祝福-";
		mes "-欢呼与善意！-";
		next;
		specialeffect EF_BENEDICTIO;
		emotion ET_THROB;
		mes "[路易丝·金]";
		mes "这真是奇迹！";
		mes "我是世界级天才。";
		mes "艺术家路易丝·金！！！";
		next;
		mes "[路易丝·金]";
		mes "好了！是不是很棒？";
		mes "你想叫什么都可以。";
		mes "我的时尚光彩夺目。";
		mes "我才不羡慕设计师皮埃尔。";
		next;
		emotion ET_SMILE;
		mes "[路易丝·金]";
		mes "我本该收取高额报酬，不过现在是圣诞节，就免费送给你吧！";
		next;
		delitem 2301,1;
		delitem 501,3;
		delitem 523,1;
		delitem 7175,4;
		delitem 7174,1;
		getitem 12132,1;
		mes "[路易丝·金]";
		mes "去炫耀这身漂亮的衣服吧。没有我路易丝·金，就不会有它。";
		close;
	}
}


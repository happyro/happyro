		mes "整个圣诞季我都会待在这里。改变主意后再来找我吧。";
			close;
		}
		if (gettimetick(2) < SantaCardTime) {
			mes "[圣诞老人]";
			mes "嗯……你最近已经玩过这个游戏了，对吧？";
			next;
			mes "[圣诞老人]";
			mes "每小时可以玩一次。";
			mes "一小时后再来找我吧。";
			close;
		}
		set .@SantaCardTurn,0;
		set .@SantaCardWins,0;
		mes "[圣诞老人]";
		mes "哇！你真酷！";
		next;
		mes "[圣诞老人]";
		mes "让我解释一下游戏玩法。";
		next;
		mes "[圣诞老人]";
		mes "很简单。";
		mes "我会从三张牌中选一张：波利卡片、幽灵波利卡片或天使波利卡片。";
		mes "猜中我选的牌，你就是赢家！";
		next;
		mes "[圣诞老人]";
		mes "五次中猜对三次，我就送你礼物。";
		mes "开始吧！";
		next;
		while(.@SantaCardTurn != 5) {
			emotion ET_BLABLA;
			mes "[圣诞老人]";
			mes "先把这些牌洗一洗……好了！！！";
			next;
			specialeffect EF_HIT1;
			mes "[圣诞老人]";
			mes "一！";
			next;
			specialeffect EF_HIT2;
			mes "[圣诞老人]";
			mes "二！";
			next;
			specialeffect EF_HIT3;
			mes "[圣诞老人]";
			mes "三！";
			next;
			specialeffect EF_STEAL;
			mes "[圣诞老人]";
			mes "我只拿一张！";
			next;
			cutin "sorry",4;
			mes "[圣诞老人]";
			mes "我只拿一张！";
			mes "请猜猜这是什么。";
			next;
			switch(select("波利:天使波利:幽灵波利")) {
				case 1:
					mes "["+strcharinfo(0)+"]";
					mes "嗯……我选波利！";
					set .@SantaCardP,1;
					next;
					break;

				case 2:
					mes "["+strcharinfo(0)+"]";
					mes "嗯……我选天使波利！";
					set .@SantaCardP,2;
					next;
					break;

				case 3:
					mes "["+strcharinfo(0)+"]";
					mes "嗯……我选幽灵波利！";
					set .@SantaCardP,3;
					next;
			}
			mes "[圣诞老人]";
			mes "看看吧！！";
			mes "一！二！三！";
			set .@SantaCardNpc, rand(1,3);
			next;
			mes "[圣诞老人]";
			mes "看看吧！！";
			mes "一！二！三！";
			if (.@SantaCardNpc == 1) {
				cutin "포링카드",4; // Poring Card
			}
			else if (.@SantaCardNpc == 2) {
				cutin "엔젤링카드",4; // Angeling Card
			}
			else if (.@SantaCardNpc == 3) {
				cutin "고스트링카드",4; // Ghostring Card
			}
			next;
			set .@SantaCardTurn,.@SantaCardTurn+1;
			if (.@SantaCardP == .@SantaCardNpc) {
				set .@SantaCardWins,.@SantaCardWins+1;
				emotion ET_SURPRISE;
				emotion ET_AHA, playerattached();
				cutin "",255;
			mes "[圣诞老人]";
			mes "你真幸运。";
			mes "下次还能猜中吗？";
				next;
			} else {
				emotion ET_SURPRISE;
				emotion ET_HUK, playerattached();
				cutin "",255;
				mes "[圣诞老人]";
				mes "哎呀，也许下次吧……";
				next;
			}
		}
		if (.@SantaCardWins < 3) {
			mes "["+strcharinfo(0)+"]";
			mes "这只是运气。";
			mes "让我再试一次！！";
			next;
			mes "[圣诞老人]";
			mes "随时都可以。";
			close;
		} else {
			mes "[圣诞老人]";
			mes "你真厉害！";
			next;
			mes "[圣诞老人]";
			mes "这份礼物现在属于你。";
			mes "把手伸进袋子，只拿一件。";
			set .@SantaCardPrize, rand(1,12);
			next;
			if (.@SantaCardPrize == 1) {
				getitem 12354,2;
			}
			else if (.@SantaCardPrize == 2) {
				getitem 595,3;
			}
			else if (.@SantaCardPrize == 3) {
				getitem 593,3;
			}
			else if (.@SantaCardPrize == 4) {
				getitem 12236,3;
			}
			else if (.@SantaCardPrize == 5) {
				getitem 538,10;
			}
			else if (.@SantaCardPrize == 6) {
				getitem 14546,10;
			}
			else if (.@SantaCardPrize == 7) {
				getitem 5136,1;
			}
			else if (.@SantaCardPrize == 8) {
				getitem 603,1;
			}
			else if (.@SantaCardPrize == 9) {
				getitem 12130,1;
			}
			else if (.@SantaCardPrize == 10) {
				getitem 14550,10;
			}
			else if (.@SantaCardPrize == 11) {
				getitem 12132,3;
			}
			else if (.@SantaCardPrize == 12) {
				getitem 594,3;
			}
			set SantaCardTime,gettimetick(2)+3600;
			mes "[圣诞老人]";
			mes "干得好！谢谢你和我一起玩卡牌游戏！";
			mes "圣诞快乐！";
			close;
		}

	case 4:
		mes "[圣诞老人]";
		mes "你是说那套非常时髦、适合圣诞老人和年轻人的服装吗？！？";
		mes "轻便、时髦，而且保暖！";
		next;
		mes "[圣诞老人]";
		mes "以前有位设计师会来我家制作圣诞服装。";
		mes "你有什么想法吗？";
		close;
	
	case 5:
		mes "[圣诞老人]";
		mes "........................";
		next;
		mes "[圣诞老人]";
		mes "........................";
		if (Sex == SEX_MALE) {
			mes "哦！可怜的男孩……";
		} else {
			mes "哦！可怜的女孩……";
		}
		next;
		mes "[圣诞老人]";
		mes "........................";
		if (Sex == SEX_MALE) {
			mes "哦！可怜的男孩……";
		} else {
			mes "哦！可怜的女孩……";
		}
		mes "...";
		next;
		mes "[圣诞老人]";
		mes "你应该向圣诞精神敞开心扉！";
		mes "这样一来，我相信你就能想到办法。";
		close;
	}
}


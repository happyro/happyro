		mes "嘿，你怎么知道走私犯的事？";
		mes "消息已经传遍城里了吗？";
		mes "抱歉，我不能透露正在调查的细节。";
		next;
		mes "[Al Hamad]";
		mes "^9370DB如果你坚持了解更多，";
		mes "就带来上级军官的书面命令。^000000";
		mes "另外禁止你询问其他人，规矩点。";
		set aru_monas,11;
		//changequest 17006,17007;
		close;
	}
	else if (aru_monas < 13) {
		mes "[Al Hamad]";
		mes "我不怪你有好奇心，但不该插手时介入只会惹麻烦。小心点，明白吗？";
		close;
	}
	else if (aru_monas == 13) {
		mes "[Al Hamad]";
		mes "嗯，真奇怪。你甚至不是阿鲁纳佩尔兹的居民，";
		mes "却认识那位高级祭司。好吧，我可以多告诉你一些调查情况。";
		next;
		mes "[Al Hamad]";
		mes "先说好，我告诉你的内容可能不值得你费这么多事。";
		mes "这些信息也许没有你想的那么重要。";
		next;
		mes "[Al Hamad]";
		mes "我们抓到的走私犯是最恶劣的那种败类：";
		mes "他们从事人口贩卖。这次他们渡海时被我们抓住，背景也很普通。";
		next;
		mes "[Al Hamad]";
		mes "让我想想……他们绑架了一个来自科莫多的人。";
		mes "那是卢恩-米德加尔特西南部的地方。";
		mes "走私犯以为他很有钱，所以设下了陷阱。";
		next;
		mes "[Al Hamad]";
		mes "他们派一名女子把他从护卫身边引开，抓住后才发现他不但有钱，还是卢恩-米德加尔特的高级官员。";
		next;
		mes "[Al Hamad]";
		mes "他们因此慌了手脚：害怕王国军队追捕，竟渡过我们巡逻的海域，于是被我们抓住。";
		next;
		mes "[Al Hamad]";
		mes "我不明白他们为什么那么害怕。他们主要做人口贩卖，所以……绑架官员也没什么不同吧？";
		next;
		mes "[Al Hamad]";
		mes "我们联系了神殿，报告了走私犯、调查情况以及卢恩-米德加尔特王国的高级官员。";
		next;
		mes "[Al Hamad]";
		mes "随后神殿的人打断调查，在我们审讯完之前带走了走私犯，从那以后我们再也没见过他们。";
		next;
		mes "[Al Hamad]";
		mes "我问过一位在神殿工作的熟人，但他也不知道发生了什么。^32CD32卢恩-米德加尔特官员^000000也失踪了。真让人恼火。";
		next;
		mes "[Al Hamad]";
		mes "这就是我知道的一切。难道我们还要再次抓捕走私犯？我不知道到底怎么回事……";
		set aru_monas,14;
		//changequest 17009,17010;
		next;
		mes "[Al Hamad]";
		mes "即使调查有进展，上级也命令我停止。看来这案子对他们来说麻烦大于价值。";
		next;
		mes "[Al Hamad]";
		mes "我不想再参与了。我早该退休！想知道更多就只能靠你自己调查。机会渺茫，对吧？";
		close;
	}
	else {
		mes "[Al Hamad]";
		mes "我已经受够了！这案子为什么不能结束？！";
		close;
	}
}

ve_in,81,296,3	script	Soldier#Aru	946,{
	if (aru_monas < 9) {
		mes "[Himus]";
		mes "嗯。那位治安官似乎仍在为几个月前的案子烦恼……";
		close;
	}
	else if (aru_monas == 9) {
		mes "[Himus]";
		mes "嗯？治安官把你打发走了？自从几个月前我们逮捕那些^32CD32来自南方的走私犯^000000后，他就一直不太正常。";
		next;
		mes "[Himus]";
		mes "我们向神殿报告逮捕后，教皇的士兵前来带走了走私犯。我们完全不知道他们发生了什么、现在在哪里。";
		next;
		mes "[Himus]";
		mes "这对你来说可能不算大事，但治安官很讲究细节，也讨厌别人干涉他的工作。";
		next;
		select("走私犯是什么人？");
		mes "[Himus]";
		mes "我其实不知道。也许治安官审讯完走私犯后会知道，但他们被带走了，我不确定他是否完成了审讯。";
		set aru_monas,10;
		//changequest 17005,17006;
		close;
	}
	else if (aru_monas == 10) {
		mes "[Himus]";
		mes "治安官快退休了，希望他能终于离职，忘掉这件事。他只会为此焦虑！";
		close;
	}
	else {
		mes "[Himus]";
		mes "天气不错，对吧？";
		close;
	}
}

ve_in,239,115,0	script	Drunkard#Aru	943,{
	if (aru_monas < 14) {
		mes "[Drunkard]";
		mes "伙计，我感觉棒极了！哈哈！";
		mes "喂，再给我一杯！";
		close;
	}
	if (aru_monas == 14) {
		if (rachel_camel == 25) {
			mes "[Drunkard]";
			mes "所以——*嗝* 我说的是……";
			mes "呃，好晕……那个^32CD32偷偷乘船出海的人^000000，";
			mes "你知道他为什么这么早回来吗？*嗝* 你绝对想不到！";
			next;
			mes "[Drunkard]";
			mes "哈哈！他——*嗝*";
			mes "他以为自己看到了^DBDB70鬼^000000！";
			mes "哇哈哈哈！呃……喂……";
			set aru_monas,15;
			//changequest 17010,17011;
			next;
			mes "["+strcharinfo(0)+"]";
			mes "没错！也许我该去问问^32CD32库尔迪的父亲，他是渔夫^000000。";
			close;
		}
		else {
			mes "[Drunkard]";
			mes "呼……";
			mes "嗯……呼……";
			close;
		}
	}
	else {
		mes "[Drunkard]";
		mes "为什么？！为什么不让我驾船出海？我得捕鱼谋生！";
		mes "难道他们想让我饿死吗？！啊？！";
		close;
	}
}

ve_in,238,120,4	script	Drunkard#Aru1	940,{
	mes "[Drunkard]";
	mes "呵呵呵呵~";
	mes "哦~ 呵呵呵呵~";
	next;
	mes "[" + strcharinfo(0) + "]";
	mes "她有点奇怪……";
	close;
}

ve_fild07,125,128,0	script	Boat#Aru	111,{
	if (aru_monas < 16) {
		mes "^3355FF这艘船看起来状况不错。";
		mes "它的主人会是谁？^000000";
		close;
	}
	else if (aru_monas == 16) {
		mes "^3355FF这一定是凯琳提到的船。";
		mes "看起来状况很好。修道院应该在这里的西南方……^000000";
		next;
		hideoffnpc "Secret Agent#Aru";
		next;
		mes "[Larjes]";
		mes "好久不见，";
		mes ""+strcharinfo(0)+".";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "拉杰斯！";
		next;
		mes "[Larjes]";
		mes "跟踪你可不容易。我差点跟丢过一次。你一定想知道我为什么在这里。听我说，我会解释一切。";
		next;
		mes "[Larjes]";
		mes "根据调查，阿鲁纳佩尔兹确实牵涉此案。因为你似乎与那位阿鲁纳佩尔兹高级官员有关，我们一直在监视你。对此我很抱歉。";
		next;
		mes "[Larjes]";
		mes "这是一起国际事件。为防止情报泄露给阿鲁纳佩尔兹，我们必须更加严格地保护此案的所有信息。";
		next;
		mes "[Larjes]";
		mes "总之，我决定向你现身，因为现在只有我能帮你。你打算使用那艘船，对吧？";
		next;
		mes "[Larjes]";
		mes "如果你没有航行前方海域的技能、知识和准备，很可能会弄坏船。运气好也许能成功，但……那得非常走运。";
		next;
		mes "[Larjes]";
		mes "我会帮你驾船到目的地。但如果失败，而我不在，你可能得独自驾船。所以，准备好了吗？";
		next;
		switch(select("是的，我准备好了。:再给我一点时间。")) {
		case 1:
			mes "[Larjes]";
			mes "好，我们走。";
			mes "抓紧东西：";
			mes "这一路可能会很颠簸……";
			set aru_monas,17;
			//changequest 17012,17013;
			close2;
			hideonnpc "Secret Agent#Aru";
			warp "nameless_i",257,217;
			end;
		case 2:
			mes "[Larjes]";
			mes "好。准备好后告诉我。";
			close;
		}
	}
	else if (aru_monas < 20) {
		mes "^3355FF这艘船可以带你前往修道院。^000000";
		next;
		switch(select("前往修道院:取消")) {
		case 1:
			mes "^3355FF你扬帆驶向修道院……^000000";
			close2;
			warp "nameless_i",257,217;
			end;
		case 2:
			mes "^3355FF你决定留在岸上。^000000";
			close;
		}
	}
	else {
		mes "^3355FF这艘船可以带你前往修道院。^000000";
		next;
		switch(select("前往修道院:取消")) {
		case 1:
			mes "^3355FF你扬帆驶向修道院……^000000";
			close2;
			warp "nameless_n",257,217;
			end;
		case 2:
			mes "^3355FF你决定留在岸上。^000000";
			close;
		}
	}
}


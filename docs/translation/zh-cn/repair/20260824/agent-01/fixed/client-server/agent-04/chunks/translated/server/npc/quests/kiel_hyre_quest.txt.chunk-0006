						mes "奇怪声音。^000000";
						set KHCottagePoem1,4;
						close;
					case 2:
						mes "^3355FF最好别按";
						mes "这个按钮。敌人一定小心藏好它，";
						mes "";
						mes "让你发现，肯定是";
						mes "邪恶陷阱。^000000";
						close;
					}
				}
			}
		case 2:
			mes "^3355FF你决定不";
			mes "拉任何把手。^000000";
			close;
			mes "";
			mes "";
			mes "";
			mes "";
			mes "";
			mes "";

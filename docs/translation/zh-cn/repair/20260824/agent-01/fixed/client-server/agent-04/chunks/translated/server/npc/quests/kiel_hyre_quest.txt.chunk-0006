				mes "^3355FF把手，水就会^000000";
				mes "从狮子";
				mes "口中喷出。看起来很酷～^000000";
				close;
			case 2:
				mes "^3355FF你一拉";
				mes "左把手，池中的水";
				mes "就会流走。池子排空后，你会";
				mes "看到一层绿色苔藓";
				mes "覆盖池底。^000000";
				mes "";
				next;
				switch(select("忽略:调查")) {
				case 1:
					mes "^3355FF你认为";
					mes "池子不过是";
					mes "没有水的洞，";

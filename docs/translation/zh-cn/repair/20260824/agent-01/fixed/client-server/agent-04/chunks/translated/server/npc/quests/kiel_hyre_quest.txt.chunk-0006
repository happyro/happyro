//----------------------------------------------------------------------------
// Cottage interior, upstairs; Vicious Dog
//----------------------------------------------------------------------------
kh_vila,181,178,4	script	Vicious Dog#khp1	81,7,3,{
OnTouch:
	mes "*咕噜～*";
	next;
	mes "^3355FF一只极其凶恶的";
	mes "狗正盯着你。";
	mes "你真的能";
	mes "不受伤地经过它吗？^000000";
	mes "";
	next;
	switch(select("继续前进:逃跑")) {
	case 1:
		if (countitem(537) >= 1) {
			mes "^3355FF等等！也许可以用";
			mes "食物安抚";
			mes "这只凶恶野兽。看看会";
			mes "发生什么吧？^000000";
			mes "";
			next;
			switch(select("给宠物食品:这不管用！")) {
			case 1:
				mes "^3355FF你小心地把宠物食品";
				mes "扔向狗。";
				mes "它狼吞虎咽时尾巴剧烈摇摆。";
				mes "趁机会";
				mes "赶快通过这只狗，";
				mes "^000000";
				delitem 537,1; //Pet_Food
				close2;
				warp "kh_vila",173,182;
				end;
			case 2:
				break;
			}
		}
		mes "^3355FF你慢慢接近";
		mes "狗，但它不停";
		mes "对你咆哮。";
		mes "你试图跑过狗，";
		mes "但它挡住你所有动作。怎么办？^000000";
		mes "";
		next;
		mes "[凶恶的狗]";
		mes "汪汪！";
		mes "汪汪！";
		mes "汪汪汪！";
		next;
		mes "^3355FF狗把你追";
		mes "下楼，像你这个";
		mes "笨蛋一样。^000000";
		close2;
		warp "kh_vila",126,70;
		end;
	case 2:
		mes "^3355FF我们离开这里吧！^000000";
		close2;
		warp "kh_vila",126,70;
		end;
	}
}

//----------------------------------------------------------------------------
// Cottage interior, upstairs; Drawer, first room nightstand
//----------------------------------------------------------------------------
kh_vila,115,186,0	script	Drawer#khp1	111,{
	if (checkweight(7492,1) == 0) {
		mes "^3355FF抽屉里有东西，";
		mes "但你携带太多物品，";
		mes "无法拿走。也许该先去";
		mes "可靠的卡普拉仓库，";
		mes "";
		mes "^000000";
		close;
	}
	if ((countitem(7492) < 1) && (KielHyreQuest <= 36)) {
		mes "^3355FF你发现一个旧抽屉，";
		mes "^已关上。";
		mes "^如果打开，";
		mes "^也许能找到东西，";
		mes "^里面也可能";
		mes "^是空的。谁知道呢？^000000";
		next;
		switch(select("打开抽屉:忽略")) {
		case 1:
			mes "^3355FF你从抽屉里获得";
			mes "黄钥匙卡。打开抽屉";
			mes "证明是值得的。^000000";
			mes "";
			getitem 7492,1; //Yellow_Key_Card
			close;
		case 2:
			mes "^3355FF算了，别打开";
			mes "抽屉。打开它有什么意义？^000000";
			mes "";
			close;
		}
	}
	else {
		mes "^3355FF你在这里";
		mes "找到黄钥匙卡。";
		mes "抽屉现在是空的。^000000";
		close;
	}
}

//----------------------------------------------------------------------------
// Cottage interior, upstairs; Box
//----------------------------------------------------------------------------
kh_vila,107,126,0	script	Box#khp2	111,{
	if ((countitem(7329) < 1) && (countitem(7516) < 1) && (countitem(7491) < 1) && (KielHyreQuest < 38)) {
		mes "^3355FF地板上放着一个坚固的箱子，";
		mes "里面还有一个";
		mes "上锁的小箱子。^000000";
		close;
	}
	else if ((countitem(7329) >= 1) && (countitem(7516) < 1) && (countitem(7491) < 1) && (KielHyreQuest < 38)) {
		mes "^3355FF地板上放着一个坚固的箱子，";
		mes "里面还有一个上锁的小箱子。";
		mes "也许可以用你的";
		mes "旧青铜钥匙打开它。^000000";
		next;
		switch(select("使用旧青铜钥匙:不行，肯定打不开。")) {
		case 1:
			mes "^3355FF你的直觉没错！";
			mes "旧青铜钥匙真的";
			mes "打开了箱子！你打开内箱，";
			mes "取得了锁在里面的";
			mes "绿色钥匙卡。";
			getitem 7516,1; //Green_Key_Card
			delitem 7329,1; //Old_Bronze_Key
			close;
		case 2:
			mes "^3355FFWhat...?";
			mes "什么？用钥匙";
			mes "开锁？";
			mes "拜托，这简直是";
			mes "疯话！^000000";
			close;
		}
	}
	else {
		mes "^3355FF这就是你取得";
		mes "绿色钥匙卡的箱子。^000000";
		close;
	}
}

//----------------------------------------------------------------------------
// Cottage interior, upstairs; Bookshelf.
//----------------------------------------------------------------------------
kh_vila,181,138,0	script	Bookshelf#khp1	111,{
	if ((countitem(7491) < 1) && (countitem(7329) >= 1) || (countitem(7516) >= 1)) {
		mes "^3355FF拥挤书架上的一本书";
		mes "贴着‘给艾莉’的便签。";
		mes "一定是她祖父";
		mes "留下的。^000000";
		next;
		switch(select("检查书本:忽略")) {
		case 1:
			mes "^3355FF你快速翻过书页，";
			mes "没有发现特别有趣的内容。";
			mes "不过把书放回去时，";
			mes "你注意到书架后有一块钢板。^000000";
			next;
			switch(select("检查钢板:忽略")) {
			case 1:
				mes "^3355FF你移开更多书本，发现";
				mes "钢板其实是藏在书架后的保险箱。";
				mes "钢制保险箱上有两个";
				mes "钥匙孔。^000000";
				next;
				switch(select("尝试所有钥匙:取消")) {
				case 1:
					mes "^3355FF要把哪把钥匙";
					mes "插入";
					mes "第一个钥匙孔？^000000";
					next;
					if (countitem(7329) >= 1) {
						select("Old Bronze Key:Cottage Key");
						mes "^3355FF要把哪把钥匙";
						mes "插入第二个钥匙孔？^000000";
						next;
						select("Old Bronze Key:Cottage Key");
					}
					else if (countitem(7516) >= 1) {
						switch(select("Green Keycard:Cottage Key")) {
						case 1:
							set .@KHFirstKeyhole,1;
							break;
						case 2:
							set .@KHFirstKeyhole,2;
							break;
						}
						mes "^3355FF要把哪把钥匙";
						mes "插入第二个钥匙孔？^000000";
						next;
						switch(select("Green Keycard:Cottage Key")) {
						case 1:
							set .@KHSecondKeyhole,1;
							break;

						case 2:
							set .@KHSecondKeyhole,2;
							break;

						}
						if (.@KHFirstKeyhole == 2) && (.@KHSecondKeyhole == 1) {
							mes "^3355FF保险箱咔哒一声打开，";
							mes "你看到里面有一个灰色箱子。";
							mes "你把灰色箱子带走，";
							mes "希望以后能派上用场。^000000";
							delitem 7489,1; //Villa_Spare_Key
							delitem 7516,1; //Green_Key_Card
							getitem 7491,1; //Iron_Box
							close;
						}

					}
				mes "^3355FF保险箱打不开。^000000";
					close;
				case 2:
				mes "^3355FF也许应该先调查小屋，";
				mes "寻找能打开这个保险箱的";
				mes "钥匙……^000000";
					close;
				}
			case 2:
				mes "^3355FF你把书放回书架。^000000";
				close;
			}
		case 2:
			mes "^3355FF也许在附近其他地方";
			mes "能找到更好的线索。^000000";
			close;
		}
	}
	else {
		mes "^3355FF你找到一个";
		mes "堆满书的书架。^000000";
		close;
	}
}

//----------------------------------------------------------------------------
// Cottage interior, upstairs; Desk
//----------------------------------------------------------------------------
kh_vila,118,144,0	script	Desk#khp1	111,{
	if (KHCottagePoem2 < 1) {
		mes "^3355FF桌上堆着成摞的文件";
		mes "和书籍，内容涉及人工能源、";
		mes "贤者瓦尔蒙特的研究、工厂机器人化";
		mes "以及魔法卷轴……^000000";
		next;
		mes "^3355FF你翻找书籍和文件时，";
		mes "找到一张盖有基尔·海伊尔基金会";
		mes "官方印章的纸。你决定";
		mes "以后也许能派上用场。^000000";
		next;
		mes "^3355FF你取得一张";
		mes "盖有基尔·海伊尔基金会";
		mes "印章的空白纸。^000000";
		set KHCottagePoem2,1;
		close;
	}
	else if (KHCottagePoem2 >= 1) {
		mes "^3355FF桌上堆着文件和书籍，";
		mes "涵盖各种科学与魔法主题。^000000";
		close;
	}
}

//----------------------------------------------------------------------------
// Cottage interior, upstairs; Medicine Chest
//----------------------------------------------------------------------------
kh_vila,123,170,0	script	Medicine Chest#khp1	111,{
	if ((KHCottagePoem2 < 1) && (KielHyreQuest < 30)) {
		mes "^3355FF药柜里装满了各种颜色的瓶子。";
		mes "这里面会有什么药呢？^000000";
		close;
	}
	else if ((KHCottagePoem2 == 1) && (KielHyreQuest < 30)) {
		mes "^3355FF这个药柜";
		mes "装满各种颜色的瓶子。";
		mes "里面会有什么药呢？^000000";
		next;
		mes "^3355FF等等，你有一张盖着基尔·海伊尔";
		mes "基金会印章的空白纸！";
		mes "印章盖在空白纸上很奇怪。";
		mes "也许上面用特殊墨水写了什么？^000000";
		next;
		mes "^3355FF这想法很疯狂，但也许";
		mes "你真的能用药柜里的某样东西";
		mes "显现写在这份文件上的";
		mes "隐形墨水！^000000";
		next;
		switch(select("什么？太疯狂了！:当然！试试看！")) {
		case 1:
			mes "^3355FF抱歉。";
			mes "我还以为";
			mes "这是个好主意……^000000";
			close;
		case 2:
			switch(select("尝试红色液体:尝试蓝色液体:尝试黄色液体:尝试绿色液体:取消")) {
			case 1:
				set .@KHPotionColor$,"red";
				break;
			case 2:
				mes "^3355FF有效！";
				mes "蓝色液体显现出";
				mes "写在纸上的小字。";
				mes "看起来像一首很长的诗……^000000";
				next;
				mes "[Poem]";
				mes "第一条蛇由钢铁制成，";
				mes "但我用愤怒摧毁了它。第二条";
				mes "蛇由魔法构成，";
				mes "但我的爱刺穿了它的心。";
				next;
				mes "[Poem]";
				mes "第三条蛇由血肉组成，";
				mes "但我的希望最终击败了它。";
				mes "然而，第四条也是最后一条蛇";
				mes "没有形体，没人知道它的模样。";
				next;
				mes "[Poem]";
				mes "我把绝望抛向空中，";
				mes "但没人知道它是否杀死了蛇。";
				mes "我只是一个有四把剑和四条蛇的";
				mes "^0000FF迷途小恶魔^000000，";
				mes "在黑暗中寻找那个女孩。";
				next;
				mes "^3355FF这是一首很奇怪的诗。";
				mes "它究竟是什么意思？^000000";
				set KHCottagePoem2,2;
				close;
			case 3:
				set .@KHPotionColor$,"yellow";
				break;
			case 4:
				set .@KHPotionColor$,"green";
				break;
			case 5:
				mes "^3355FF算了。";
				mes "这个想法太疯狂，";
				mes "根本不可能成功……";
				mes "就像把人送上月球。你能";
		mes "相信这种胡说八道吗？^000000";
				close;
			}
			mes "^3355FF你把药柜里的";
			mes "你把药柜里的"+.@KHPotionColor$+"液体洒在";
			mes "盖有基尔·海伊尔基金会印章的";
			mes "空白纸上。";
			mes "然而什么也没发生……^000000";
			close;
		}
	}
	else if ((KHCottagePoem2 >= 2) || (KielHyreQuest >= 30)) {
		mes "^3355FF你曾在这里把蓝色液体";
		mes "倒在空白纸上，阅读用隐形墨水";
		mes "写下的诗。纸上盖有";
		mes "基尔·海伊尔基金会印章。";
		mes "要读一读吗？^000000";
		next;
		switch(select("没时间！:阅读")) {
		case 1:
			mes "^3355FF时间不多了！现在最好";
			mes "把这座小屋的每个角落";
			mes "都调查一遍。^000000";
			close;
		case 2:
			mes "[Poem]";
			mes "第一条蛇由钢铁制成，";
			mes "但我用愤怒摧毁了它。第二条";
			mes "蛇由魔法构成，";
			mes "但我的爱刺穿了它的心。";
			next;
			mes "[Poem]";
			mes "第三条蛇由血肉组成，";
			mes "但我的希望最终击败了它。";
			mes "然而，第四条也是最后一条蛇";
			mes "没有形体，没人知道它的模样。";
			next;
			mes "[Poem]";
			mes "我把绝望抛向空中，";
			mes "但没人知道它是否杀死了蛇。";
			mes "我只是一个有四把剑和四条蛇的";
			mes "^3355FF迷途小恶魔^000000，";
			mes "在黑暗中寻找那个女孩。";
			close;

				next;
				break;
			case 4:
				mes "^3355FF你没有力气把棺材倒过来。^000000";
				next;
				break;
			case 5:
				close;
			}
		}
	}
}

in_sphinx2,13,163,0	script	Stone Statue#qsk_as	-1,7,7,{
OnTouch_:
	if (ASSN_SK == 3) {
		specialeffect EF_CONE;
		mes "^3355FF这座古老石像布满裂痕，看起来快要崩塌。";
		mes "一件发光物体从脚下露出一角。地面看起来可以挖掘……^000000";
		specialeffect EF_CONE;
		next;
		if (select("挖掘发光物体:忽略") == 1) {
			mes "^3355FF当你的手指挖进松软地面时，地面释放出^000000";
			if (rand(1,3) != 3){
				mes "^3355FF黄色气体，使你的感官模糊并短暂昏迷。^000000";
				sc_start SC_Sleep,30000,0;
				close;
			}
			mes "^3355FF黄色气体。不过你及时屏住呼吸，排出肺中的气体，躲过了影响。";
			mes "你为埃斯米尔取得了红宝石。^000000";
			set ASSN_SK,5;
			getitem 723,1; //Cardinal_Jewel
		}
		close;
	}
}


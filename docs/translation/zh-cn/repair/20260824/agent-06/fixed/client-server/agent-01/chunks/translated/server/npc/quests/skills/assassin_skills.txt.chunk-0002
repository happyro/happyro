moc_pryd04,85,96,0	script	¡¡#crypt	-1,3,3,{
OnTouch_:
	if (ASSN_SK == 4) {
		specialeffect EF_CONE;
		mes "^3355FF水面下有什么东西在闪光……^000000";
		next;
		if (select("捡起来:忽略") == 1) {
			mes "^3355FF你一把手伸进水里，刺骨寒意立刻窜过手臂。";
			mes "最好快点，否则你会被冻住！^000000";
			next;
			if (rand(1,3) != 3) {
				mes "^3355FF太迟了！你的身体已经完全冻住。^000000";
				sc_start SC_Freeze,10000,0;
				close;
			}
			mes "^3355FF你迅速捡起发光物体，赶在水冻结你之前脱身。";
			mes "你为埃斯米尔取得了海蓝宝石。^000000";
			set ASSN_SK,5;
			getitem 720,1; //Skyblue_Jewel
		}
		close;
	}
}


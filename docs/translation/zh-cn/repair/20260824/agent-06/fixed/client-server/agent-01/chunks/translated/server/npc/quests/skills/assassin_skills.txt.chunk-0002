			next;
			mes "[埃斯米尔]";
			mes "仔细看，这是最重要的部分。";
			mes "注意我的手的位置和手臂角度？";
			mes "这是你必须记住的姿势。";
			specialeffect EF_SONICBLOW;
			next;
			mes "[埃斯米尔]";
			mes "好了，这就是你需要知道的一切。";
			mes "现在请试试看，我可以指导你的姿势。";
			next;
			specialeffect2 EF_SONICBLOW;
			next;
			mes "[埃斯米尔]";
			mes "嗯，你的重心移动得不太稳定。";
			mes "如果重心像这样，也许会更好……";
			next;
			specialeffect2 EF_SONICBLOW;
			next;
			mes "[埃斯米尔]";
			mes "这样好多了。嗯……试着想着敌人的弱点，";
			mes "然后完成刺击动作。";
			next;
			specialeffect2 EF_SONICBLOW;
			next;
			mes "[埃斯米尔]";
			mes "对，就是这样……！";
			mes "执行得非常好。做得不错，"+ strcharinfo(0) +"。";
			skill "AS_SONICACCEL",1,SKILL_PERM;
			set ASSN_SK,7;
			next;
			mes "[埃斯米尔]";
			mes "现在明白了吗？你应该不会再忘记这个技能了。";
			mes "我没有更多可教的了，只能祝你旅途顺利。";
			close;
		}
		else {
			mes "[埃斯米尔]";
			mes "嗯……";
			close;
		}
	}
	else if (ASSN_SK == 2 || ASSN_SK == 3 || ASSN_SK == 4) {
		mes "[埃斯米尔]";
		mes "你的小任务进展如何？";
		mes "如果忘了我让你寻找宝藏的地点，";
		mes "我可以简单提醒你。";
		next;
		mes "[埃斯米尔]";
		mes "去寻找有价值的东西";
		if (ASSN_SK == 2) {
			mes "在斯芬克斯搜索^FF0000棺材^000000。";
		}
		else if (ASSN_SK == 3) {
			mes "在斯芬克斯搜索^FF0000石像^000000。";
		}
		else if (ASSN_SK == 4) {
			mes "在金字塔^FF0000最底层的积水墓穴^000000中。";
		}
		mes "只有强者才能探索那个区域，";
		mes "完成任务就能向我证明你的能力。";
		close;
	}
	else if (ASSN_SK == 1) {
		mes "[埃斯米尔]";
		mes "啊，你好，同伴。";
		mes "你听说刺客公会的最新消息了吗？";
		mes "啊，你已经和基尔丁谈过了。很好，很好……";
		next;
		mes "[埃斯米尔]";
		mes "现在，我负责向所有感兴趣的刺客教授音速加速技能。";
		mes "如果基尔丁没有解释清楚，我可以告诉你更多。";
		next;
		while(1) {
			switch(select("请告诉我更多……:我想学习音速加速！")) {
			case 1:
				mes "[埃斯米尔]";
				mes "音速加速是与^FF0000音速投掷^000000配合使用的辅助技能。";
				mes "刺客只能对自己施放这个技能。";
				next;
				mes "[埃斯米尔]";
				mes "如果你熟悉音速投掷，就知道很难用它造成致命伤害。";
				mes "它的速度太快，难以准确攻击……";
				next;
				mes "[埃斯米尔]";
				mes "不过学习音速加速后，你可以克服准确度不足的问题，";
				mes "发挥音速投掷的全部伤害潜力。";
				next;
				mes "[埃斯米尔]";
				mes "这个技能真的很棒。我们的公会会长就是发明它的人……";
				mes "我必须说，他是人中豪杰。";
				emotion ET_THROB;
				next;
				break;
			case 2:
				mes "[埃斯米尔]";
				mes "啊，很高兴看到你对学习这个技能如此热心。";
				mes "不过首先要满足前置条件……";
				next;
				if (getskilllv("AS_SONICBLOW") == 0) {
					mes "[埃斯米尔]";
					mes "首先去学习音速投掷。";
					mes "除非你学会施放音速投掷，否则我教你的技能完全没用。";
					mes "在那之前我会一直在这里等你。";
					close;
				}
			mes "[埃斯米尔]";
				mes "你的任务是带来";
				switch(rand(1,3)) {
				case 1:
					mes "斯芬克斯的宝藏。";
					mes "搜索那里的^FF0000棺材^000000，寻找珍贵物品。";
					mes "把这当作对你力量的考验。";
					set ASSN_SK,2;
					next;
					mes "[埃斯米尔]";
					mes "你能否完成任务，将决定你是否有资格学习音速加速。";
					mes "祝你好运，请尽快行动。";
					close;
				case 2:
					mes "斯芬克斯的宝藏。";
					mes "搜索那里的^FF0000石像^000000，寻找珍贵物品。";
					mes "把这次行动当作对你力量的考验。";
					set ASSN_SK,3;
					next;
					mes "[埃斯米尔]";
					mes "你能否完成任务，将决定你是否有资格学习音速加速。";
					mes "祝你好运，请尽快行动。";
					close;
				case 3:
					mes "金字塔的宝藏。";
					mes "在最底层搜索^FF0000积水墓穴^000000中的珍贵物品。";
					mes "把这当作对你力量的考验。";
					set ASSN_SK,4;
					next;
					mes "[埃斯米尔]";
					mes "你能否完成任务，将决定你是否有资格学习音速加速。";
					mes "祝你好运，请尽快行动。";
					close;
				}
			}
		}
	}
	else {
		if (BaseJob == Job_Assassin) {
			mes "[刺客]";
			mes "啊，你好，同伴。";
			mes "你听说刺客公会的最新消息了吗？";
			emotion ET_SMILE;
			next;
			select("刺客公会的消息？");
			mes "[刺客]";
			mes "嗯，那你一定还没听说。";
			mes "如果想知道更多，就去和我旁边的基尔丁谈谈。";
			mes "他会解释清楚一切。";
			close;
		}
		mes "[刺客]";
		mes "嗯。你认识其他刺客吗？";
		mes "如果他们还没来，就叫他们到这里来。";
		close;
	}
}

in_sphinx2,259,213,0	script	Old Coffin#qsk_as	-1,7,8,{
OnTouch_:
	if (ASSN_SK == 2) {
		mes "^3355FF这是一个盖子破损、微微敞开的古老棺材。";
		mes "你短暂地看到里面有某件东西闪闪发光。^000000";
		specialeffect EF_CONE;
		next;
		while(1) {
			switch(select("把手伸进去:检查棺材缝隙:掀开盖子:把棺材倒过来:忽略")) {
			case 1:
				mes "^3355FF你小心地把手伸进棺材，试图取出刚才看到的发光物体。^000000";
				mes "...............................";
				next;
				mes "^3355FF棺材里的某种东西狠狠咬了你的手！^000000";
				sc_start SC_Poison,30000,0;
				sc_start SC_Bleeding,10000,0;
				emotion ET_HUK, playerattached();
				close;
			case 2:
				mes "^3355FF你试图从棺材边缘和盖子之间的缝隙窥视内部。";
				mes "...............................^000000";
				next;
				mes "^3355FF你勉强察觉到棺材里有什么东西在蠕动，但太暗了，无法看清其他东西。^000000";
				sc_start SC_Blind,30000,0;
				next;
				break;
			case 3:
				mes "^3355FF你没有力气移动这么重的棺材盖……^000000";
				sc_start SC_Curse,30000,0;
				next;
				break;
			case 4:
				mes "^3355FF你没有力气把棺材倒过来。^000000";
				next;
				break;
			case 5:
				close;
			}
		}
	}
}


				close;
			}
		}
	}
	if (!isbegin_quest(2293)) {
		mes "[Adept Adventurer]";
		mes "你可以通过北边的传送门返回学院。";
		close;
	} else if (isbegin_quest(2293) == 1) {
		mes "[Adept Adventurer]";
		mes "你看……关闭的克里图拉学院花园里长满了像果冻宝宝一样的小波利。";
		next;
		mes "[Adept Adventurer]";
		mes "米德加尔特并非所有魔物都想要你的血，只是大多数而已。";
		next;
		mes "[Adept Adventurer]";
		mes "看那个，^3131FF波利^000000似乎有话要对你说。";
		completequest 2293;
		setquest 2294;
		close;
	} else {
		if (isbegin_quest(2296) == 1) {
			mes "[Adept Adventurer]";
		mes "如果感到困惑，请随时按 ^3131FF<Alt+U>^000000 查看任务状态。";
			next;
			if (select("如何获得未成熟苹果", "结束对话") == 1) {
				mes "[Adept Adventurer]";
				mes "你可以去药房学习如何制作^3131FF未成熟苹果^000000。";
				next;
				mes "[Adept Adventurer]";
				mes "那里的工作人员应该有一本给新手的^3131FF物品合成书^000000，主题之一就是^3131FF如何制作未成熟苹果^000000。";
				close;
			}
		}
		if (isbegin_quest(2297) == 1) {
			mes "[Adept Adventurer]";
			mes "所以你对小波利使用了驯服道具，它们就变成蛋了？";
			next;
			mes "[Adept Adventurer]";
			mes "哈哈哈，别担心，我的小宠物。";
			mes "你刚刚通过了^3131FF驯服^000000测试。";
			next;
			select("驯服？");
			mes "[Adept Adventurer]";
			mes "没错，这意味着你已经准备好成为像我和黛比·鲁奇一样的朋友。";
			next;
			mes "[Adept Adventurer]";
			mes "外面有许多不同的魔物和可驯服生物。";
			next;
			mes "[Adept Adventurer]";
			mes "成功驯服后，它就会变成一枚小蛋。";
			next;
			mes "[Adept Adventurer]";
			mes "再次恭喜你通过友谊测试！";
			mes "关于可爱宠物有问题时随时来问我。";
			next;
			mes "[Adept Adventurer]";
			mes "看到那边发抖的波利了吗？对这个小家伙温柔一点，好吗？";
			completequest 2297;
			setquest 2298;
			close;
		}
		mes "[Adept Adventurer]";
		mes "如果感到困惑，请随时点击 ^3131FF<Alt+U>^000000 查看任务状态。";
		close;
	}
}

// - Friendly Poring
// -----------------------------------------------------------------------------
new_1-3,99,169,3	script	Friendly Poring#ac	4_PORING,{
	if (!checkweight(1301,3)) {
	mes "[波利]";
		mes "你携带的物品太多，无法继续任务。";
		next;
	mes "[波利]";
		mes "按 ^3131FFAlt+E^000000 打开背包；如果发现不需要的物品，可以卖给^3131FF商人^000000，或使用卡普拉服务存入^3131FF仓库^000000~";
		close;
	}
	if (!isbegin_quest(2294)) {
	mes "[波利]";
		mes "新手，帮帮我……";
		close;
	} else if (isbegin_quest(2294) == 1) {
	mes "[波利]";
		mes "哎呀呀……这里发生了什么？";
		next;
		if (select("发生了什么？", "无视他/它？") == 2) {
	mes "[波利]";
			mes "哎呀，哎呀……";
			close;
		}
	mes "[波利]";
		mes "真是悲惨的状况。";
		next;
	mes "[波利]";
		mes "那个家伙幽灵波利在自己的地下城被打败后，跑到这里欺负像我这样的其他魔物。";
		next;
	mes "[波利]";
		mes "我的等级太低，阻止不了它，你现在都能听到它们在欢呼……";
		next;
	mes "[幽灵波利]";
		mes "喂，你们这些家伙！告诉我想听的答案！";
		emotion ET_SURPRISE, getnpcid(0, "Ghostring#cupet");
		next;
		mes "[Unskilled Poring]";
		mes "幽灵波利是世界上最强的！";
		emotion ET_WRAP, getnpcid(0, "Cowardly Poring#pet_1");
		emotion ET_WRAP, getnpcid(0, "Unskilled Poring#pet_2");
		emotion ET_WRAP, getnpcid(0, "Foolish Poring#pet_3");
		next;
	mes "[幽灵波利]";
		mes "你问我是什么魔物？";
		emotion ET_SURPRISE, getnpcid(0, "Ghostring#cupet");
		next;
		mes "[Unskilled Poring]";
		mes "幽灵波利是老大！";
		emotion ET_WRAP, getnpcid(0, "Cowardly Poring#pet_1");
		emotion ET_WRAP, getnpcid(0, "Unskilled Poring#pet_2");
		emotion ET_WRAP, getnpcid(0, "Foolish Poring#pet_3");
		next;
	mes "[幽灵波利]";
		mes "哇哈哈哈~";
		emotion ET_SMILE, getnpcid(0, "Ghostring#cupet");
		next;
		emotion ET_CRY;
	mes "[波利]";
		mes "真是丢脸……";
		mes "小波利跟着那种混蛋，已经不再可爱了。";
		next;
	mes "[波利]";
		mes "小波利并不坏，只是从没去过外面的世界。";
		next;
	mes "[波利]";
		mes "这样下去，米德加尔特所有的波利都会被幽灵波利控制。";
		next;
		if (select("我能帮你吗？", "真遗憾。") == 2) {
	mes "[波利]";
			mes "哎呀，哎呀……";
			close;
		}
	mes "[波利]";
		mes "既然你这么说，先生，我确实需要帮助。";
		next;
		mes "[Unskilled Poring]";
		mes "那是什么？一只波利在和人类说话。";
		mes "我们要不要揍他？";
		emotion ET_WRAP, getnpcid(0, "Cowardly Poring#pet_1");
		emotion ET_WRAP, getnpcid(0, "Unskilled Poring#pet_2");
		emotion ET_WRAP, getnpcid(0, "Foolish Poring#pet_3");
		next;
	mes "[波利]";
		mes "天哪！";
		mes "救救我！快救我！";
		emotion ET_HUK;
		next;
		select("我能做什么？");
	mes "[波利]";
		mes "我有个好主意！";
		mes "过来！";
		completequest 2294;
		setquest 2295;
		close;
	} else if (isbegin_quest(2295) == 1) {
	mes "[波利]";
		mes "这是^3131FF未成熟苹果^000000。";
		mes "小波利最喜欢吃的东西。";
		next;
	mes "[波利]";
		mes "也许你可以用它把小波利从幽灵波利身边引开。";
		next;
	mes "[波利]";
		mes "^3131FF双击我给你的未成熟苹果^000000，再^3131FF选择^000000你喜欢的^3131FF小波利^000000。";
		cutin "pet_ex_01.bmp", 3;
		next;
	mes "[波利]";
		mes "然后点击老虎机中央。";
		cutin "pet_ex_02.bmp", 3;
		next;
	mes "[波利]";
		mes "这样就能把它们从幽灵波利的影响中引开。";
		cutin "", 255;
		completequest 2295;
		setquest 2296;
		getitem 12846,5;// Little_Unripe_Apple
		close;
	} else if (isbegin_quest(2296) == 1) {
		if (countitem(9062) > 0) {
	mes "[波利]";
		mes "你好，朋友。成功了吗？那些小家伙在哪里？";
			next;
		select("展示蛋");
	mes "[波利]";
		mes "冷静点，先生……";
		mes "你对未驯服的波利做了什么！？！初心者！！！！！！";
			next;
			mes "["+strcharinfo(0)+"]";
		mes "我用了你给我的未成熟苹果，然后它们就变成蛋了。";
			next;
			emotion ET_CRY;
	mes "[波利]";
		mes "哦，我没想到这么容易就能把它们变成宠物！";
			next;
			mes "["+strcharinfo(0)+"]";
		mes "好，别担心，我会确保";
		mes "它们有一个温暖的家。";
			completequest 2296;
			setquest 2297;
			close;
		} else {
	mes "[波利]";
		mes "^3131FF双击我给你的未成熟苹果^000000，再^3131FF选择^000000你喜欢的^3131FF小波利^000000。";
			cutin "pet_ex_01.bmp", 3;
			next;
	mes "[波利]";
		mes "然后只需^3131FF点击^0000老虎机中央。";
			cutin "pet_ex_02.bmp", 3;
			next;
	mes "[波利]";
		mes "可能会失败，但继续尝试把那些小波利引开！";
			close3;
		}
	} else if (isbegin_quest(2297) == 1) {
	mes "[波利]";
		mes "你听说过从初心者成为熟练冒险者的变化吗？";
		close;
	} else if (isbegin_quest(2298) == 1) {
	mes "[波利]";
		mes "未成熟苹果是用来驯服的道具。";
		mes "它只对附近跳来跳去的小波利有效。";
		next;
	mes "[波利]";
		mes "如果你要把它们变成可爱的宠物……";
		mes "就必须照顾好你的小波利！";
		next;
		select("什么？");
	mes "[波利]";
		mes "即使在幽灵波利来这里之前，小波利也有些胆小。";
		next;
	mes "[波利]";
		mes "因为它们从未去过真正的世界，就像人类初心者一样。";
		next;
	mes "[波利]";
	mes "你才刚开始冒险，对吧？你会走访许多城镇，遇到许多人，也会遭遇可怕的首领魔物。";
		next;
	mes "[波利]";
		mes "你不考虑带一只这样的家伙一起走吗？";
		next;
	mes "[波利]";
		mes "它们虽然特别吵，但会成为忠诚的朋友！";
		next;
	mes "[波利]";
	mes "我想^31311F熟练冒险者^000000很了解宠物，你可以向他询问新小波利伙伴的事情。";
		next;
	mes "[波利]";
		mes "顺便说一句，你应该有一个^3131FF便携式孵蛋器^000000。";
		mes "这是一个粗心的^3131FF宠物美容师^000000旅行时掉下的。";
		next;
	mes "[波利]";
		mes "我还会给你小波利最喜欢的^3131FF苹果汁^000000，记得一直喂饱它！";
		next;
	mes "[波利]";
		mes "喂，小波利。";
		mes "期待你探索米德加尔特后再回来！";
		mes "祝你顺利，朋友。";
		completequest 2298;
		if (Class == Job_Novice)
			getexp 500,50;
		getitem 531,3;// Apple_Juice
		getitem 643,1;// Pet_Incubator
		close;
	} else {
	mes "[波利]";
		mes "好好照顾你的小波利。有关于可爱宠物的问题，就去问熟练冒险者！";
		close;
	}
}

// - Ghostring
// -----------------------------------------------------------------------------
new_1-3,108,165,3	script	Ghostring#cupet	4_GHOSTRING,{
	mes "[幽灵波利]";
	mes "我是最大、最凶恶的幽灵波利！";
	close;
}

// - Little Porings
// -----------------------------------------------------------------------------
new_1-3,105,165,5	script	Cowardly Poring#pet_1	2398,{ end; }
new_1-3,105,164,5	script	Unskilled Poring#pet_2	2398,{ end; }
new_1-3,105,163,5	script	Foolish Poring#pet_3	2398,{ end; }

// - Kafra Guide Trainer
// - Teaches the player about Kafra Services.
// -----------------------------------------------------------------------------
iz_ac01,95,46,5	script	Kafra Guide Trainer#ac	4_F_KAFRA1,{
	cutin "kafra_01.bmp", 2;
	if (isbegin_quest(4269) == 2) {
	mes "[卡普拉指导员]";
		mes "欢迎，卡普拉服务始终陪伴在你身边。";
		next;
	mes "[卡普拉指导员]";
		mes "这是给第一次使用卡普拉服务的人。";
		mes "卡普拉服务会为你详细介绍相关信息~！";
		while(1) {
			next;
	mes "[卡普拉指导员]";
		mes "告诉我们你想了解";
		mes "卡普拉服务的哪一部分~！";
			next;
		switch(select("保存服务", "仓库服务", "传送服务", "手推车服务", "查看其他信息", "取消")) {
			case 1:
	mes "[卡普拉指导员]";
				mes "保存服务会在你^8B4513战斗死亡^000000或使用^8B4513蝴蝶翅膀^000000等物品时，将你送回保存地点。";
				next;
	mes "[卡普拉指导员]";
				mes "很容易理解吧~？";
				mes "想试试保存服务吗~？";
				next;
				if (select("不想", "想") == 1) {
	mes "[卡普拉指导员]";
					mes "不用害怕~！";
					mes "保存服务不会把你吞掉。";
					mes "如果改变主意，最好一定要试试看~！";
				} else {
	mes "[卡普拉指导员]";
					mes "那么~ 现在就把克里图拉学院所在的^8B4513依斯鲁得广场^000000设为保存点~！";
					next;
	mes "[卡普拉指导员]";
					mes "完成~！";
					next;
	mes "[卡普拉指导员]";
					mes "已经完成了。很简单吧？";
					savepoint "izlude",128,98,1,1;
					next;
	mes "[卡普拉指导员]";
					mes "现在使用^006400蝴蝶翅膀^000000时，就会被送到上次保存的地点。";
				}
				break;
			case 2:
	mes "[卡普拉指导员]";
				mes "仓库服务可以安全地存放物品。";
				mes "账号中的所有角色都可以访问这些物品。";
				next;
	mes "[卡普拉指导员]";
				mes "使用仓库需要初心者职业等级 6 以上。";
				next;
	mes "[卡普拉指导员]";
				mes "支付少量费用后，大多数卡普拉员工都会为你打开仓库。";
				mes "你甚至可以从道具商城购买卡普拉卡，在任何地方打开仓库！";
				mes "想使用仓库吗？";
				next;
				if (select("不想", "想") == 1) {
	mes "[卡普拉指导员]";
					mes "仓库对生存很重要，请定期使用。";
				} else {
					if (!callfunc("F_CanOpenStorage")) {
	mes "[卡普拉指导员]";
						mes "使用仓库需要初心者等级 6 以上。";
					} else if (countitem(7059) || Zeny >= 500) {
						if (countitem(7059)) {
							delitem 7059,1;// Cargo_Free_Ticket
						} else {
							Zeny -= 500;
							RESRVPTS += 5;
						}
	mes "[卡普拉指导员]";
						mes "我来打开仓库~。";
						mes "感谢使用~！";
						close2;
						cutin "", 255;
						openstorage;
						end;
					} else {
	mes "[卡普拉指导员]";
						mes "亲爱的客人，你的钱不够~！";
						mes "使用仓库需要 500 Zeny~！";
					}
				}
				break;
			case 3:
	mes "[卡普拉指导员]";
				mes "传送服务会把你送往米德加尔特各地。";
				next;
	mes "[卡普拉指导员]";
				mes "不同的卡普拉员工负责不同的传送地点，你需要询问他们各自能传送到哪里。";
				next;
	mes "[卡普拉指导员]";
				mes "好，为了教学，我在学院提供免费传送服务。";
				mes "要不要试试看~！";
				next;
				if (select("不", "是") == 1) {
	mes "[卡普拉指导员]";
					mes "你害怕细胞被切碎之类的吗？别担心，这非常安全~！";
					mes "这是必不可少的服务~";
					mes "所以最好习惯它，好吗？";
					break;
				} else {
					switch(select("学院一楼大厅", "学院二楼校长办公室", "依斯鲁得南入口", "以后使用")) {
					case 1:
						cutin "", 255;
						warp "iz_ac01", 97, 86;
						end;
					case 2:
						cutin "", 255;
						warp "iz_ac02", 101, 36;
						end;
					case 3:
	mes "[卡普拉指导员]";
							mes "这会把你送到克里图拉学院外面，可以吗？";
							mes "如果想回学院，请寻找依斯鲁得北边的入口。";
						next;
							if (select("不", "是") == 1) {
	mes "[卡普拉指导员]";
							mes "你害怕细胞被切碎之类的吗？别担心，这非常安全~！";
							break;
						} else {
							cutin "", 255;
							warp "izlude", 128, 98;
							end;
						}
						break;
					case 4:
	mes "[卡普拉指导员]";
					mes "你害怕细胞被切碎之类的吗？别担心，这非常安全~！";
						break;
					}
				}
				break;
			case 4:
	mes "[卡普拉指导员]";
				mes "手推车服务供职业为^8B4513商人^000000的人使用。";
				mes "商人只需支付少量 Zeny 就能租用手推车。";
				next;
	mes "[卡普拉指导员]";
				mes "如果你不是商人，或尚未学习手推车技能，就不能使用这项卡普拉服务。";
				break;
			case 5:
	mes "[卡普拉指导员]";
				mes "在我们提供的其他服务中，还有卡普拉客户积分系统！";
				next;
	mes "[卡普拉指导员]";
				mes "每次使用卡普拉服务，都能获得特别储备积分~";
				mes "你可以在艾尔帕兰的卡普拉总部用积分兑换特定物品。";
				next;
	mes "[卡普拉指导员]";
				mes "现在我来告诉你目前拥有多少特别储备积分。";
				next;
				if (select("查看特别储备积分。", "取消") == 2) {
	mes "[卡普拉指导员]";
					mes "以后再看吧~~！！";
					mes "请查看你积累的客户积分~！";
				} else {
	mes "[卡普拉指导员]";
					mes ""+strcharinfo(0)+"，你积累了 "+RESRVPTS+" 点积分。";
					next;
	mes "[卡普拉指导员]";
					mes "你可以在艾尔帕兰卡普拉总部";
					mes "用特别储备积分兑换奖励。";
					mes "请使用我们便捷的服务，享受奖励计划的好处。";
				}
				break;
			case 6:
	mes "[卡普拉指导员]";
				mes "卡普拉服务会竭尽全力，为你提供作为客人应得的满意体验。";
				mes "感谢你的使用。";
				close2;
				cutin "", 255;
				end;
			}
		}
	} else {
	mes "[卡普拉指导员]";
	mes "首先，你需要在学院前台完成^8B4513登记^000000。";
	mes "完成后就能继续学院课程。";
	mes "去一楼后，";
	mes "会有人";
	mes "为你办理登记。";
		close2;
		cutin "", 255;
		end;
	}
}

iz_ac01_a,95,46,5	duplicate(Kafra Guide Trainer#ac)	Kafra Guide Trainer#ac_a	4_F_KAFRA1
iz_ac01_b,95,46,5	duplicate(Kafra Guide Trainer#ac)	Kafra Guide Trainer#ac_b	4_F_KAFRA1

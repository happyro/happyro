		emotion ET_QUESTION;
		next;
		mes "[Crumpler]";
		mes "我不知道那是什么。不过我想它总不至于像魔法师那么糟。";
		next;
		mes "[Crumpler]";
		mes "所以……";
		mes "要和我一起喝一杯吗？";
		close;
	}
	else {
		mes "[Crumpler]";
		mes "等一下……";
		mes "你不是魔法师！";
		mes "我、我到底醉成什么样了？！";
		next;
		mes "[Crumpler]";
		mes "我恨死魔法师了！整天学习、吟唱，还把税弄得那么高……";
		next;
		mes "[Crumpler]";
		mes "抢走我们的工作、审查媒体、破坏教育制度、造成空气污染、发动战争、制作说唱音乐……";
		close;
	}
}

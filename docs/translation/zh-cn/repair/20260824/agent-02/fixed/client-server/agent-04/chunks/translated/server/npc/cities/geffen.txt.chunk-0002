		mes "[Elenore]";
		mes "嗯……";
		mes "如果你想喝酒，特里斯坦三世国王不久前已经禁酒了。听说现在只有特定地方供应。";
		next;
		mes "[Elenore]";
		mes "不过人们还是能靠这里供应的仿制饮料喝醉。我想这全是心理作用。";
		next;
	mes "[Elenore]";
	mes "我真的好想去那个供应真正酒水的地方。据说那里简直像天堂！";
	close;
		}
		switch(rand(1,4)) {
		case 1:
		mes "[Elenore]";
		mes "传闻……？";
		mes "我听说他们要在朱诺开设新的飞空艇服务！";
		next;
		mes "[Elenore]";
		mes "至少他们是这么计划的。飞空艇还没准备好起飞。与此同时，那边有个奇怪的客服代表提供传送服务。";
		next;
		mes "[Elenore]";
	mes "看来卡普拉公司终于有竞争对手了！不过我觉得很少有女孩能像卡普拉职员那么漂亮……";
		break;
		case 2:
		mes "[Elenore]";
		mes "你听说了吗？";
		mes "卢恩-米德加尔特王国最近流行一些新时尚！";
		next;
		mes "[Elenore]";
		mes "最近有人戴着可爱的新帽子进来。有顶我从没见过的可爱泰迪熊帽，还有个女孩戴着黑色猫耳……";
		next;
		mes "[Elenore]";
		mes "当然，不是所有流行款式都合我口味。我见过有人把蘑菇顶在头上。还听说有人用鱼做帽子？";
		next;
		mes "[Elenore]";
		mes "我想那种帽子";
		mes "对我来说";
	mes "太艺术了。";
		break;
		case 3:
		mes "[Elenore]";
		mes "传闻，是吗？";
		next;
		mes "[Elenore]";
		mes "嗯……";
		mes "我听说卢恩-米德加尔特某处有个人……";
		next;
			mes "[Elenore]";
		if (Sex == SEX_MALE)
			mes "告诉我，你听说过"+strcharinfo(0)+"吗？据说他是附近最潇洒的英雄！";
		else
	mes "你听说过"+strcharinfo(0)+"吗？大家都说她是整个卢恩-米德加尔特最漂亮的女孩之一！";
		break;
		case 4:
			switch(rand(1,2)) {
			case 1:
			mes "[Elenore]";
			mes "传闻，是吗？";
			mes "等、等一下……";
			next;
			mes "[Elenore]";
			mes "呃……";
			mes "哦哦……";
			mes "我、我的头……";
			mes "好痛……";
			next;
			mes "[William's Spirit]";
		mes "^990000你这个败类，离我女儿远点！否则我就把你的器官卖掉换 Zeny！";
			mes "听见了吗？！^000000";
			next;
			mes "[Elenore]";
			mes "*Cough*";
			mes "哦……！";
			mes "抱歉！";
			mes "我一定是";
			mes "得流感了！";
		mes "……或者什么别的。";
			next;
			mes "^3355FFWeird...";
			mes "她刚才的声音";
			mes "有一会儿";
		mes "特别低沉……";
			break;
			case 2:
			mes "[William's Spirit]";
		mes "^990000嘿，你这个色鬼！！别那样盯着我女儿，否则我就挖出你的眼睛，和意大利面一起吃掉！^000000";
			next;
				mes "["+strcharinfo(0)+"]";
				if (Sex == SEX_MALE) {
				mes "嗯……？";
				mes "你、你再说一遍？";
				next;
				mes "[Elenore]";
				mes "嗯……？";
				mes "哦，爸爸一定又附身到我身上了。这种事经常发生在我和妹妹身上。";
				next;
				mes "["+strcharinfo(0)+"]";
				mes "不会吧？";
				mes "唉，真倒霉。";
				next;
				mes "[Elenore]";
				mes "是啊……";
			mes "可不是嘛。";
			break;
				}
				else {
				mes "等、等等～";
				mes "可、可我是女孩！";
				next;
				mes "[William's Spirit]";
				mes "^990000你听不懂^FF0000我会当场揍你^000000吗？！^990000现在滚开，你这个变态！^000000";
				next;
				mes "^3355FFWaaah~!";
				mes "她怎么";
			mes "突然变得这么可怕？！^000000";
		break;
	}
}
	}

close;
}
	

	geffen_in,79,76,2	script	Merchant Daven	120,{
	mes "[Merchant Daven]";
	mes "我记得以前的吉芬";
	mes "还很无聊。";
	next;
	mes "[Merchant Daven]";
	mes "但现在城里有了魔法师和巫师，经济也繁荣起来了！";
	next;
	switch(select("Mages...?:Economy?:Who are you?")) {
		case 1:
			if (BaseJob == Job_Mage) {
			mes "[Merchant Daven]";
		mes "魔法师是施展魔法的人。不过你现在应该更了解这个话题吧？";
		}
			else {
			mes "[Merchant Daven]";
			mes "魔法师和巫师总是带着书研究魔法。他们就是这样。";
			next;
			mes "[Merchant Daven]";
			mes "城镇西北部有一所魔法学校，想成为魔法师的初心者可以在那里学习魔法基础。";
			next;
			mes "[Merchant Daven]";
			mes "熟练掌握魔法后，魔法师就有资格成为巫师。";
			next;
			mes "[Merchant Daven]";
		mes "巫师可以使用比魔法师更强大、更具破坏力的魔法。魔法师可以在吉芬塔顶申请转职为巫师。";
		}
	break;
		case 2:
			if (Class == Job_Blacksmith) {
			mes "[Merchant Daven]";
			mes "经济……？";
		mes "当然要感谢铁匠！不过你应该早就知道了吧？";
		}
			else {
			mes "[Merchant Daven]";
			mes "我想吉芬的经济应该感谢铁匠。没错，他们总是又脏、又臭、满身汗，说话也很粗鲁……";
			next;
			mes "[Merchant Daven]";
			mes "但他们很勤劳。而且他们精炼的矿石和制造的武器需求量很高。";
			next;
			mes "[Merchant Daven]";
		mes "冒险者愿意用辛苦赚来的大量 Zeny，购买只有铁匠才能制造的高品质武器。";
		}
	break;
		case 3:
		mes "[Merchant Daven]";
		mes "我？我是世界上最漂亮的街头商人。嘿嘿～";
		next;
		select("...^EE0000Magnum Break^000000!");
			if (Class == Job_Swordman) {
			mes "[Merchant Daven]";
			mes "喂，喂！";
			mes "我只是开玩笑！";
		mes "原谅我吧！";
		}
			else {
			mes "[Merchant Daven]";
			mes "怒爆？";
		mes "但你连那个也不会，对吧？";
		}
	break;
	}
close;
}

	geffen_in,114,73,5	script	Hadenheim	709,{
	mes "[Hans Hadenheim]";
	mes "米德加尔特大陆真大！最近怎么样，年轻人？";
	next;
	mes "[Hans Hadenheim]";
	mes "吉芬真奇怪。不过从施瓦尔兹瓦德共和国一路来到这里很值得。";
	next;
		if (select("施瓦尔兹瓦德共和国？:那么，你为什么旅行？") == 1) {
		mes "[Hans Hadenheim]";
		mes "你……";
		mes "不知道";
		mes "施瓦尔兹瓦德共和国？";
		next;
		mes "[Hans Hadenheim]";
		mes "就是卢恩-米德加尔特王国的盟友。嗯……我们的首都是朱诺？";
		next;
		mes "[Hans Hadenheim]";
		mes "你真该多了解";
		mes "世界大事！";
		close;
	}
	mes "[Hans Hadenheim]";
	mes "当然是为了生意。看来对外贸易很赚钱。";
	next;
	mes "[Hans Hadenheim]";
	mes "我的意思是，探险家发现了这么多新城市，进出口贸易当然兴旺！";
	next;
	mes "[Hans Handenheim]";
	if (BaseJob == Job_Merchant)
		mes "你自己也做贸易，对吧？所以你当然明白我们正处于贸易黄金时代！";
	else if (Class == Job_Novice) {
		mes "我想……";
		mes "这种概念对你这样的新手来说可能太高深了。";
	}
	else
		mes "总之……";
	next;
	mes "[Hans Hadenheim]";
	mes "你去过这些新大陆吗？那里很有趣，还能从异国文化中学到很多东西。";
	next;
	mes "[Hans Hadenheim]";
	mes "如果你想观光，我个人推荐去我的故乡朱诺。那里非常美丽。";
	close;
}

geffen_in,39,127,2	script	Psychic Advisor	704,{
	mes "[Psychic Advisor]";
	mes "啊……";
	mes "不用说了！你是来算命的，对吧？我知道，";
	mes "我知道……我能看见未来！你想算哪方面？";
	next;
	switch(select("人生！:爱情！:金钱！:成绩！:未来！:时尚！")) {
	case 1:
		mes "[Psychic Advisor]";
		switch(rand(1,5)) {
		case 1:
			mes "人生……？";
			mes "哇，这个范围真广。不过让我联系灵界的灵魂，看看能做些什么。";
			next;
			mes "[Psychic Advisor]";
			mes "嗯……";
			mes "好了，我得到一些信息。嗯，你会活得非常非常久。你问有多久？";
			next;
			mes "[Psychic Advisor]";
			mes "^333333*咳！*^000000九岁。是不是好消息？这是很长的寿命，你还有许多年可以享受幸福。";
			next;
			mes "[Psychic Advisor]";
			mes "而且你总会成功。你会成功地赢得人生，也会成功地输掉人生！";
			next;
			mes "[Psychic Advisor]";
			mes "你现在可能不理解这句箴言，但当你更了解这个疯狂的世界后，就会明白了。";
			next;
			break;
		case 2:
			mes "嗯……";
			mes "关于人生我能告诉你什么？让我马上联系灵界～";
			next;
			mes "[Psychic Advisor]";
			mes "好了，我知道了！";
			mes "你的梦想";
			mes "会成真！";
			next;
			mes "[Psychic Advisor]";
			mes "当然，我不确定具体哪些梦想会实现，但希望成真的会是美好梦想，而不是奇怪的噩梦。";
			next;
			mes "[Psychic Advisor]";
			mes "具体是哪一个？灵魂们今天特别沉默，不太想说话。灵魂也有自己的生活嘛。等等，我说得有道理吗？";
			next;
			break;
		case 3:
			mes "我感觉你即将做出可能后悔的草率决定。我建议你放慢脚步，先思考。";
			next;
			mes "[Psychic Advisor]";
			mes "即使压力很大，也要记住在激动时做出的决定通常都不好。深呼吸，放松。";
			next;
			mes "[Psychic Advisor]";
			mes "即使时间所剩无几，也最好慢慢规划，避免浪费努力或犯下代价高昂的错误。";
			next;
			mes "[Psychic Advisor]";
			mes "记住，冷静、";
			mes "沉着的耐心";
			mes "是克服危机的关键。";
			next;
			break;
		case 4:
			mes "嗯……我感觉你在人生中迷失了方向。你应该优先追求安全还是幸福？";
			next;
			mes "[Psychic Advisor]";
			mes "我建议你充分而谨慎地思考，再决定哪条路最适合自己。记住，人只能从错误中学习。";
			next;
			mes "[Psychic Advisor]";
			mes "只要认真规划，以良好态度采取积极且有建设性的行动，你就能";
			mes "拥有一切！";
			next;
			break;
		case 5:
			mes "嗯……";
			mes "我感觉你和亲近的人发生了争吵，那是你非常在乎的人。";
			next;
			mes "[Psychic Advisor]";
			mes "你必须主动采取行动！试着解决这件事，不要被情绪牵着走。";
			next;

ayothaya,233,105,3	script	Powerful-Looking Woman	838,2,2,{
	if (thai_find == 14) {
	mes "";
	mes "";
	mes "";
	mes "";
	mes "";
	mes "";
		mes "";
		mes "";
		mes "";
		mes "你找到";
		mes "安农了吗？";
		next;
		mes "";
		mes "";
		mes "";
		mes "";
		mes "";
		mes "";
		mes "你还没";
		mes "找到他？";
		mes "那他到底";
		mes "在哪里？！";
		next;
		mes "";
		mes "";
		mes "";
		mes "";
		mes "哦，好吧……";
		mes "我不确定是否该相信你说的一切，但你找回了戒指，这就够了。谢谢你的帮助。";
		next;
		mes "";
		mes "";
		mes "";
		mes "";
		mes "旅途中遇到安农的话，让他马上回来。你可以继续冒险了～";
		next;
		mes "";
		mes "";
		mes "";
		mes "";
		mes "";
		mes "如果我再";
		mes "见到他……";
		mes "他会受到 ^660000惩罚^000000……";
		mes "^666666*咬牙*^000000";
		close;
	} else if (thai_find > 2 && thai_find < 14) {
		mes "[舒达]";
		mes "^666666*叹气……*^000000";
		mes "你还没";
		mes "找到安农了吗？";
		mes "我明白了。没关系。";
		mes "时间对我们不是问题。";
		next;
		mes "[舒达]";
		mes "而我说的“我们”是指 ^660000你^000000。我不在乎你的计划，因为你会腾出";
		mes "时间帮我！哦呵呵呵呵！";
		close;
	} else if (thai_find == 2) {
		if (countitem(7288)) {
			mes "[舒达]";
			mes "啊……是吗……？！";
			mes "对，就是它！";
			mes "我的订婚戒指，";
			mes "被那个笨蛋安农扔进了水里！";
			next;
			mes "[舒达]";
			mes "非常感谢！为了纪念你，我们前七个孩子都用你的名字命名！哦呵呵呵呵～";
			next;
			mes "[舒达]";
			mes "现在……";
			mes "我只需要";
			mes "找到安农。";
			mes "那个笨蛋";
			mes "到底去哪了？！";
			next;
			mes "[舒达]";
			mes "^666666*咳*^000000";
			mes "我、我不是想";
			mes "吓他，我只是想";
			mes "拿回订婚戒指。";
			next;
			mes "[舒达]";
			mes "^666666*叹气*^000000";
			mes "看来成为幸福新娘的日子";
			mes "";
			mes "离我还很远……";
			next;
			mes "^3355FF舒达直直地";
			mes "用小狗般的眼神看着你。^000000";
			next;
			switch(select("别、别那样看我！:好吧好吧。")) {
			case 1:
				mes "[舒达]";
				mes "拜托，你知道发生的一切，我知道你还会继续在这里冒险";
				mes "";
				next;
				mes "[舒达]";
				mes "我只是想让你冒险时找找安农。这点小事不难，对吧？谢谢你～";
				next;
				mes "[舒达]";
				mes "同时我会想办法报复让我们痛苦的安农！快去找他！呵呵呵呵！";
				emotion ET_SMILE;
				next;
				emotion ET_THINK, playerattached();
				mes "["+strcharinfo(0)+"]";
				mes "(她好可怕！";
				mes "又让我";
				mes "替她做事……）";
				next;
				mes "["+strcharinfo(0)+"]";
				mes "(我为什么总是";
				mes "替别人";
				mes "做事？！）";
				break;
			case 2:
				mes "[舒达]";
				mes "是的，我就知道能指望你！去找安农！他注定属于 ^660000我^000000。呵呵呵呵！";
				next;
				mes "[舒达]";
				mes "我有段时间没在村里见到他。我不认为他会跳水找戒指，他太胆小了。没有戒指他大概没勇气见我。";
				next;
				mes "[舒达]";
				mes "请告诉安农";
				mes "我拿回戒指了，他现在可以回到我身边。冒险者，请记住。";
				break;
			}
			delitem 7288,1; //Thai_Ring
			changequest 12030,12031;
			set thai_find,3;
			close;
		} else {
			mes "[舒达]";
			mes "咦……？";
			mes "你找到我的戒指了吗？";
			mes "给我看看，快给我看看！";
			next;
			mes "[舒达]";
			mes "什么……";
			mes "你什么都没拿到！";
			mes "别骗我，";
			mes "把我的戒指带回来！";
			next;
			mes "[舒达]";
			mes "快去找我的戒指。";
			mes "我会在这里等好消息。";
			mes "哦呵呵呵呵～！";
			if (checkquest(12029) == -1)
				setquest 12029;
			close;
		}
	} else if (thai_find == 1) {
		mes "[舒达]";
		mes "让你做这件事我有点过意不去，毕竟你是外来者。";
		next;
		mes "[舒达]";
		mes "但那枚戒指对我非常重要。如果你能找到，我会是全世界最幸福的女人。";
		next;
		mes "[舒达]";
		mes "所以，求求你。";
		mes "请把戒指带回来。";
		mes "我想和安农永远幸福生活。你能理解吗？！";
		close;
	} else {
		mes "[Powerful-Looking Woman]";
		mes "嗯……？";
		mes "啊，你一定是游客。我本想带你参观并听你讲外面的世界，但……";
		next;
		if (rand(0,1)) {
			mes "[Powerful-Looking Woman]";
			mes "我现在真的";
			mes "很忙。";
			mes "非常忙。";
			next;
			mes "[Powerful-Looking Woman]";
			mes "什么……？";
			mes "你不会因为我站着不动就觉得我不忙吧？！天啊，你真没礼貌！";
			next;
			mes "[Powerful-Looking Woman]";
			mes "现在我得找订婚戒指。";
			mes "要是未婚夫没有把它扔掉……";
			next;
			switch(select("什么……？:骗人～！")) {
			case 1:
				mes "[Powerful-Looking Woman]";
				mes "什么‘什么’？";
				mes "你还以为我站着不动";
				mes "只是为了自娱自乐吗？！";
				next;
				emotion ET_KIK, playerattached();
				mes "["+strcharinfo(0)+"]";
				mes "不不不不……";
				mes "我的意思是，真不敢相信";
				mes "你竟然和别人订婚了！";
				next;
				mes "[Powerful-Looking Woman]";
				mes "呜哇啊啊啊！";
				mes "你凭什么对我这样的好女人说这么无礼的话。走开，我不想和你说话！";
				close;
			case 2:
				mes "[Powerful-Looking Woman]";
				mes "什么谎话？";
				mes "如果你要说‘真不敢相信你订婚了！’这种话，";
				mes "我可不会忍。";
				next;
				mes "["+strcharinfo(0)+"]";
				mes "哇哇哇～";
				mes "冷静，女士。";
				mes "先听我说完。";
				mes "我想知道的是……";
				next;
				mes "[Powerful-Looking Woman]";
				mes "我知道，我知道。";
				mes "你想知道我为什么站在水边，对吧？";
				mes "因为我的戒指被扔在那里，我得把它找回来。";
				next;
				mes "[Powerful-Looking Woman]";
				mes "我干嘛和游客说这些？^666666*叹气……*^000000 好了，你知道想知道的了。现在满意了吗？";
				next;
				mes "[Powerful-Looking Woman]";
				mes "...";
				next;
				mes "[Powerful-Looking Woman]";
				mes "...";
				mes "......";
				next;
				mes "[Powerful-Looking Woman]";
				mes "...";
				mes "......";
				mes "........嘿。";
				next;
				mes "[Powerful-Looking Woman]";
				mes "你为什么盯着我？";
				mes "你没有别的事做吗？";
				next;
					switch(select("不。:不～你是个有趣的女孩。")) {
				case 1:
					mes "[Powerful-Looking Woman]";
					mes "我明白了。嗯……";
					mes "你有点符合我的类型。";
					if (Sex == SEX_MALE) {
						mes "不不，不代表我对你有兴趣。而且我已经订婚了。";
					} else
						mes "别想歪了，我是说我觉得你和我很像。";
					next;
					mes "[Powerful-Looking Woman]";
					mes "让我自我介绍。";
					mes "我叫舒达，一生都住在阿由他亚。既然你没事做，";
					mes "我想请你帮个忙。";
					next;
					mes "[舒达]";
					mes "我的未婚夫安农总是对我以外的东西感兴趣。我不明白为什么，也不该被忽视！";
					next;
					mes "[舒达]";
					mes "^666666*叹气……*^000000";
					mes "总之，我们订婚了，";
					mes "还互换了戒指……";
					next;
					mes "[舒达]";
					mes "我以为订婚会改善关系。但他拿走我的戒指，扔进了水里。";
					next;
					mes "[舒达]";
					mes "我很生气，叫他把戒指捡回来，然后";
					mes "就再也没见过他。";
					mes "所以我想请你……";
					next;
					mes "[" +strcharinfo(0)+ "]";
					mes "你想让我";
					mes "找到你的";
					mes "戒指，对吧？";
					next;
					mes "[舒达]";
					mes "啊……";
					mes "你知道";
					mes "我想要什么。";
					mes "这样简单多了。";
					next;
					mes "[舒达]";
					mes "拿回戒指后，我会让他带我去爪哇伊度假……";
					next;
					mes "[舒达]";
					mes "……在那里我会";
					mes "^660000奴役^000000他。";
					mes "^666666*咬牙*^000000";
					next;
					emotion ET_SURPRISE, playerattached();
					mes "[" +strcharinfo(0)+ "]";
					mes "（……好、好可怕！）";
					next;
					mes "[舒达]";
					mes "总之，我要你出去寻找订婚戒指。这里水面平静，戒指应该还在水下，没有被冲走。";
					next;
					mes "[舒达]";
					mes "这就是你的任务，够你忙一阵了。下水吧，我会在这里监督。";
					mes "哦呵呵呵呵呵！";
					emotion ET_SMILE;
					set thai_find,1;
					close;
				case 2:
					mes "[Powerful-Looking Woman]";
					mes "^666666*叹气……*^000000";
					mes "你打算只站着发呆，";
					mes "完全不帮忙吗？我以为冒险者等于英雄，";
					mes "而不是懒鬼。";
					next;
					mes "[Powerful-Looking Woman]";
					mes "哦，我明白了……";
					mes "你不帮助陌生人，对吧？";
					mes "我叫舒达，是等待订婚戒指从水中浮起的美丽少女。";
					next;
					mes "[Powerful-Looking Woman]";
					mes "在那里……！";
					mes "我们不是";
					mes "陌生人！";
					mes "哦呵呵呵呵呵！";
					next;
					mes "[舒达]";
					mes "你不怜悯我悲惨的处境吗？如果有人帮这位可怜少女找到戒指，她就会成为世上最幸福的新娘。";
					next;
					mes "[舒达]";
					mes "她的救命恩人";
					mes "会被称为";
					mes "阿由他亚的英雄。";
					next;
					mes "[" +strcharinfo(0)+ "]";
					mes "……你说什么？！";
					next;
					mes "[舒达]";
					mes "总之，你要找到我的订婚戒指，我会成为世上最幸福的新娘，永远幸福。";
					mes "这有什么难懂的？";
					next;
					mes "[舒达]";
					mes "安农是我的未婚夫，没骨气，我说重话就会消失。";
					mes "真像个小姑娘！难道看不出我是在让他成为更好的男人吗？！";
					next;
					mes "[" +strcharinfo(0)+ "]";
					mes "他从你身边";
					mes "逃走了，对吧？";
					next;
					mes "[舒达]";
					mes "Eh...?";
					mes "你说什么？";
					next;
					mes "["+strcharinfo(0)+"]";
					mes "^666666*咳*^000000";
					mes "你对他来说";
					mes "太好了。";
					mes "（换成我也会逃跑！）";
					next;
					mes "[舒达]";
					mes "是的是的，我知道。";
					mes "重要的是拿回戒指后，安农就永远属于我。直到 ^660000死亡将我们分开^000000。";
					next;
					mes "[舒达]";
					mes "那么，你到底";
					mes "要不要帮我？！";
					mes "如果帮忙，我和安农会用你的名字给前七个孩子命名。";
					next;
					mes "[舒达]";
					mes "去水下找吧！没有水流，戒指肯定还在那里！等什么，你游过去应该很容易！哦呵呵呵呵呵！";
					if (checkquest(12029) == -1)
						setquest 12029;
					set thai_find,1;
					close;
				}
			break;
			}
		} else {
			mes "[Powerful-Looking Woman]";
			mes "^666666*叹气……*^000000";
			mes "为什么还没从水里浮上来？也许用木棍搅一搅……？";
			next;
			mes "[Powerful-Looking Woman]";
			mes "...?!";
			mes "你在看什么？！";
			mes "我很忙，如果你想要什么，";
			mes "我帮不了你！";
			next;
			mes "[Powerful-Looking Woman]";
			mes "^666666愚蠢的游客到处跑，";
			mes "在阿由他亚骚扰";
			mes "像我这样的美女……^000000";
			close;
		}
	}

OnTouch_:
	if (thai_find == 0) {
		mes "[Powerful-Looking Woman]";
		mes "^666666*叹气……*^000000";
		mes "到底";
		mes "在哪里！？";
		next;
		mes "[Powerful-Looking Woman]";
		mes "你在看什么？";
		mes "没见过柔弱少女叹气吗？别烦我！";
		close;
	}
}

ayo_dun02,91,263,0	script	#Annonblood	111,2,3,{
if (!$@annonactive) {
	if (thai_find == 13) {
		mes "["+strcharinfo(0)+"]";
		mes "血迹？";
		mes "发生什么事了？";
		mes "我该看看……";
		next;
		mes "^3355FF在一棵大树下，";
		mes "你发现灌木丛里一些叶子沾有血迹。^000000";
		next;
		mes "^3355FF灌木丛中，血迹仍在延伸，";
		mes "仿佛受伤动物挣扎着躲进了灌木。^000000";
		next;
		mes "[" +strcharinfo(0)+ "]";
		mes "嗯……";
		next;
		switch(select("拨开灌木。:挖开灌木。")) {
		case 1:
			if (!rand(0,2)) {
				mes "[" +strcharinfo(0)+ "]";
				mes "^666666*Cough cough*^000000";
				mes "灰尘真多！";
				next;
				mes "[?]";
				mes "……呜呜呜";
				mes "哦……天啊……！";
				next;
				emotion ET_SURPRISE, playerattached();
				mes "[" +strcharinfo(0)+ "]";
				mes "咦……？";
				mes "我听到下面有声音！";
				mes "挖开看看！";
				next;
				mes "^3355FF你拔开灌木，";
				mes "^3355FF在灰尘和枝叶下发现";
				mes "^3355FF一个小洞穴。^000000";
				next;
				set $@annonactive,1;
				enablenpc "Haggard Man";
				mes "[Haggard Man]";
				mes "^666666*Cough cough!*^000000";
				mes "谁……谁在那里？";
				mes "舒达？！如果是你，";
				mes "别靠近，否则我就自杀！";
				emotion ET_HUK, playerattached();
				next;
				switch(select("你在这里做什么？:我不是舒达！")) {
				case 1:
					mes "["+strcharinfo(0)+"]";
					mes "嘿……";
					mes "你在做什——";
					next;
					set $@annonactive,0;
					disablenpc "Haggard Man";
					mes "^3355FFHe vanished!^000000";
					close;
				case 2:
					mes "[Haggard Man]";
				mes "嗯……？";

			mes "[Tutorial Instructor]";
			mes "负责^006400插槽附魔^000000的人位于^8B4513普隆德拉、梦罗克、斐扬^000000。^8B4513里希塔乐镇^000000在精炼所，^0000FFSeiyablem^000000和^0000FFReiablem^000000在入口附近。";
			next;
			mes "[Tutorial Instructor]";
			mes "负责^006400隐藏插槽附魔^000000的人位于^8B4513普隆德拉^000000 6 点钟方向。寻找^0000FF工匠学徒^000000。";
			next;
			mes "[Tutorial Instructor]";
			mes "你现在更了解^006400附魔^000000了吗？";
			close;
		case 4:
			mes "[Tutorial Instructor]";
			mes "使用^006400万能银目录^000000道具可以进行^006400摊位搜索^000000。它会搜索地图上的摊位，让你更容易找到想要的物品。";
			next;
			mes "[Tutorial Instructor]";
			mes "^006400万能银目录^000000";
			mes "可以从";
			mes "^0000FF目录巫师^000000";
			mes "他位于伊甸园集团总部。";
			next;
			mes "[Tutorial Instructor]";
			mes "一个只需 200 Zeny，";
			mes "使用它可以";
			mes "搜索最多 10 次。";
			mes "可以说这是必需品。";
			next;
			mes "[Tutorial Instructor]";
			mes "那么，你熟悉^006400摊位搜索^000000了吗？别只站在那里听我说，自己试试看！";
			close;
		case 5:
			mes "[Tutorial Instructor]";
			mes "根据你的需要，^006400佣兵^000000和^006400宠物^000000有多种用途。";
			next;
			mes "[Tutorial Instructor]";
	mes "006400佣兵^000000会直接";
			mes "为你战斗并产生效果，";
			mes "而^006400宠物^000000会通过";
			mes "能力和多样外表间接帮助你，";
			mes "并俘获你的心。";
			next;
			mes "[Tutorial Instructor]";
			mes "要雇佣佣兵，";
			mes "去寻找^006400佣兵公会^000000";
			mes "它就在^8B4513普隆德拉^000000正门附近。";
			mes "去找^006400信息员^000000";
			mes "询问^006400佣兵公会职员^000000";
			mes "的位置，他们会告诉你。";
			next;
			mes "[Tutorial Instructor]";
			mes "要获得^006400宠物^000000，狩猎时会获得驯服道具。对对应怪物使用驯服道具，就能获得宠物。";
			next;
			mes "[Tutorial Instructor]";
			mes "由于可能失败，请谨慎使用驯服道具。";
			next;
			mes "[Tutorial Instructor]";
			mes "除此之外……你可以从佣兵公会获得^006400佣兵^000000，也可以和其他玩家交易或购买^006400宠物^000000。";
			next;
			mes "[Tutorial Instructor]";
			mes "现在你更了解如何使用^006400佣兵^000000和^006400宠物^000000了吗？希望将来你有机会使用它们。";
			close;
		case 6:
			mes "[Tutorial Instructor]";
			mes "有问题就再来找我。";
			close;
		}
	}
	mes "[Tutorial Instructor]";
	mes "最近据说";
	mes "人们正在研究给装备添加选项";
	mes "将选项放入插槽，或添加属性";
	mes "给原本没有这些属性的装备。";
	close;
}

moc_para01,32,179,4	script	Tutorial Goal	895,{
	if (checkweight(608,7) == 0) {
		if (MaxWeight - Weight < getiteminfo(608, ITEMINFO_WEIGHT)) {
			mes "[Tutorial Goal]";
			mes "你携带的物品过重。先存放一些物品再回来。";
			close;
		} else {
			mes "[Tutorial Goal]";
			mes "你携带的物品太多。先存放一些物品再回来。";
			close;
		}
	}
	if (checkquest(4161) == 0 || checkquest(4161) == 1) {
		mes "[Tutorial Goal]";
		mes "好～我们要去挑战专家，对吧？";
		mes "先去找^006400攻城战专家^000000吧！";
		close;
	} else if (checkquest(4162) == 0 || checkquest(4162) == 1) {
		mes "[Tutorial Goal]";
		mes "你通过了^006400攻城战专家^000000的测试！恭喜！";
		mes "现在去找^006400组队招募专家^000000！";
		close;
	} else if (checkquest(4163) == 0 || checkquest(4163) == 1) {
		mes "[Tutorial Goal]";
		mes "哦！你通过了^006400组队招募专家^000000的测试！恭喜！";
		mes "现在去找^006400战场专家^000000！";
		close;
	} else if (checkquest(4164) == 0 || checkquest(4164) == 1) {
		mes "[Tutorial Goal]";
		mes "耶！你通过了^006400战场专家^000000的测试！恭喜！";
		mes "接下来去找^006400纪念地下城专家^000000！";
		close;
	} else if (checkquest(4165) == 0 || checkquest(4165) == 1) {
		mes "[Tutorial Goal]";
		mes "你通过了^006400纪念地下城专家^000000的测试！太好了！";
		mes "试着去找^006400地图专家^000000！";
		close;
	} else if (checkquest(4166) == 0 || checkquest(4166) == 1) {
		mes "[Tutorial Goal]";
		mes "你通过了^006400地图专家^000000的测试！恭喜！";
		mes "我很高兴你通过了所有专家的测试！你比我预想的更优秀！！";
		next;
		mes "[Tutorial Goal]";
		mes "现在，你也是^006400专家^000000了！！这个称号非常适合你！";
		mes "非常感谢你的努力。如约，这是给你的小奖励。";
		next;
		mes "[Tutorial Goal]";
		mes "我想它会在你的冒险中派上用场。祝你未来冒险好运～";
		completequest 4166;
		getitem 510,5; //Blue_Herb
		getitem 511,5; //Green_Herb
		getitem 504,5; //White_Potion
		getitem 608,1; //Seed_Of_Yggdrasil
		close;
	} else if (checkquest(4166) == 2) {
		mes "[Tutorial Goal]";
		mes "现在，你也是^006400专家^000000了！！这个称号非常适合你！";
		mes "非常感谢你的努力。";
		mes "祝你未来的冒险好运相伴。";
		close;
	}
	if (Class == Job_Novice) {
		mes "[Tutorial Goal]";
		mes "嗯，不知道有没有足够聪明的冒险者能挑战我们的专家……";
		close;
	}
	mes "[Tutorial Goal]";
	mes "嘿，你！你看起来像冒险者……不过似乎有点迟钝……";
	next;
	if(select("你说什么？我很聪明！:是啊……我很迟钝。") == 1) {
		mes "[Tutorial Goal]";
		mes "真的吗？虽然我不知道该不该相信。看看我面前的专家！他专攻一个领域 16 年，现在已经非常威严！";
		next;
		mes "[Tutorial Goal]";
		mes "好吧，如果你能通过他们所有的测试，我就相信你的能力。";
		next;
		mes "[Tutorial Goal]";
		mes "我也会为称你迟钝道歉。怎么样，迟钝专家？你想挑战他们吗？";
		next;
		if(select("挑……挑战！！:嗯……我想现在还是放弃吧……") == 1) {
			mes "[Tutorial Goal]";
			mes "你比看起来勇敢。既然决定挑战，就不能回头了！";
			next;
			mes "[Tutorial Goal]";
			mes "好～先去和面前的^006400攻城战专家^000000谈谈。";
			setquest 4161;
			close;
		}
	}
	mes "[Tutorial Goal]";
	mes "别灰心……改变主意想挑战时就来找我。";
	close;
}

moc_para01,24,175,4	script	Siege Master	734,{
	set .@checkquest, checkquest(4161);
	if (.@checkquest == 2) {
		mes "[Siege Expert]";
		mes "既然你又来了，我猜你对^006400攻城战^000000感兴趣？";
		next;
		switch(select("听攻城战介绍。:结束对话。")) {
		case 1:
			callsub L_Info;
			mes "[Siege Expert]";
			mes "听专家讲过这些后，是不是很容易理解？想复习什么就来找我。";
			close;
		case 2:
			mes "[Siege Expert]";
			mes "想复习什么就来找我。";
			close;
		}
	} else if (.@checkquest == 0 || .@checkquest == 1) {
		mes "[Siege Expert]";
		mes "我研究攻城战 16 年了！所以我是专家！既然你来找我，我猜你想进一步了解^006400攻城战^000000。";
		next;
		mes "[Siege Expert]";
		mes "你充满热情和渴望。作为^006400攻城战^000000专家，你也激励了我！其他专家都在等你！去挑战吧！";
		next;
		mes "[Siege Expert]";
		mes "如果通过所有专家测试会有大奖～你愿意挑战吗？";
		next;
		mes "[Siege Expert]";
		mes "作为第一位专家，我可以教你^006400攻城战^000000。怎么样？想了解^006400攻城战^000000吗？";
		next;
		switch(select("听攻城战介绍。:结束对话。")) {
		case 1:
			callsub L_Info;
			mes "[Siege Expert]";
			mes "听专家讲过这些后，是不是很容易理解？";
			mes "现在我会问 3 个问题～全部答对就算通过！想挑战吗？";
			while(1) {
				set .@correct,0;
				next;
				switch(select("挑战我！:再听一次:退出")) {
				case 1:
					switch(rand(1,3)) {
					case 1:
						mes "[Siege Expert]";
						mes "攻城战是为了占领[]而进行的。";
						mes "这是一个发生在[]与另一个[]之间的战争。";
						mes "[] 中的空格应该填什么？";
						next;
						if(select("城堡、用户、公会:城堡、公会、公会:城镇、公会、公会:城镇、用户、用户") == 2)
							set .@correct, .@correct+10;
						mes "[Siege Expert]";
						mes "哪个不是正确的攻城战时间？";
						next;
						if(select("攻城战 1 周二 9-11:攻城战 1 周六 4-6:攻城战 1 周四 8-10") == 3)
							set .@correct, .@correct+10;
						mes "[Siege Expert]";
						mes "获得城堡后，必须提升[]才能获得更好收益。";
						mes "[] 中的空格应该填什么？";
						next;
						if(select("商业发展:工业发展:公会发展:城镇发展") == 1)
							set .@correct, .@correct+10;
						break;
					case 2:
						mes "[Siege Expert]";
						mes "攻城战有 2 种。";
						mes "一种是普通的天地树攻城战";
						mes "另一种是[]。";
						mes "[] 中的空格应该填什么？";
						next;
						if(select("天地树攻城战 MO:天地树攻城战 NE:天地树攻城战 SK:天地树攻城战 SE") == 4)
							set .@correct, .@correct+10;
						mes "[Siege Expert]";
						mes "作为城堡所有公会，你必须保护[]。";
						mes "[] 中的空格应该填什么？";
						next;
						if(select("皇宫:Emperium:Emperiom:帝国") == 2)
							set .@correct, .@correct+10;
						mes "[Siege Expert]";
						mes "公会赢得攻城战后有什么好处？";
						next;
						if(select("购买所有物品打 7 折:获得经验增加 20%:进入公会地下城:每天午夜获得武器。") == 3)
							set .@correct, .@correct+10;
						break;
					case 3:
						mes "[Siege Expert]";
						mes "公会赢得攻城战后有什么好处？";
						next;
						if(select("获得经验增加 20%:购买所有物品打 7 折:进入公会原野:每天午夜获得宝箱") == 4)
							set .@correct, .@correct+10;
						mes "[Siege Expert]";
						mes "攻城战持续多少小时？";
						next;
						if(select("1 小时:2 小时:3 小时:4 小时") == 2)
							set .@correct, .@correct+10;
						mes "[Siege Expert]";
						mes "获得城堡后，必须提升[]才能获得更好收益。";
						mes "[] 中的空格应该填什么？";
						next;
						if(select("城镇发展:工业发展:公会发展:商业发展") == 4)
							set .@correct, .@correct+10;
						break;
					}
					if (.@correct == 30) {
						mes "[Siege Expert]";
						mes "哇！3 个问题全答对了！现在你对^006400攻城战^000000很有信心了吧？";
						next;
						mes "[Siege Expert]";
						mes "想了解^006400攻城战^000000时，随时来找我。";
						next;
						mes "[Siege Expert]";
						mes "现在去找^0000FF组队招募专家^000000。他在等你。";
						completequest 4161;
						setquest 4162;
						getexp 2000,1000;
						close;
					}
					mes "[Siege Expert]";
					mes "只有 3 个问题，而你没有全部答对！这样下去你会通不过所有专家的测试。";
					next;
					mes "[Siege Expert]";
					mes "但我看得出你有潜力。想再试一次吗？";
					break;
				case 2:
					callsub L_Info;
					mes "[Siege Expert]";
					mes "听专家讲过这些后，是不是很容易理解？";
					mes "现在我会问 3 个问题～全部答对就算通过！想挑战吗？";
					break;
				case 3:
					mes "[Siege Expert]";
					mes "哼！你真没意思……太容易放弃了！改变主意后再来找我。";
					close;
				}
			}
			close;
		case 2:
			mes "[Siege Expert]";
			mes "你要放弃吗？改变主意后再来找我。";
			close;
		}
	}
	mes "[Siege Expert]";
	mes "如果你想向我学习，先去见^006400教程目标^000000。";
	close;

L_Info:
	mes "[Siege Expert]";
	mes "^006400攻城战^000000是为了占领城堡而进行的^0000FF公会对公会^000000战争！";
	next;
	mes "[Siege Expert]";
	mes "^006400攻城战^000000有两种。";
	mes "一种是标准的^006400天地树攻城战^000000，另一种稍有不同，称为^006400天地树攻城战 2^000000。";
	next;
	mes "[Siege Expert]";
	mes "因此战争中有两个阵营。";
	mes "^0000FF城堡所有公会^000000试图保护^006400Emperium^000000，^0000FF攻击城堡的公会^000000试图摧毁^006400Emperium^000000。";
	next;
	mes "[Siege Expert]";
	mes "你可以在我们的网站上查看^006400攻城战^000000时间。";
	mes "获胜公会还会得到一些特别奖励。";
	next;
	mes "[Siege Expert]";
	mes "攻城战中获胜的公会";
	mes "可以进入^006400公会地下城^000000";
	mes "公会会长可以在^0000FF每天午夜^000000打开^006400宝箱^000000。";
	mes "这不是很棒的福利吗？";
	next;
	mes "[Siege Expert]";
	mes "赢得城堡后还必须进行^006400商业发展^000000。做得越多，福利越好。";
	next;
	return;
}

moc_para01,21,172,4	script	Party Recruiting Expert	878,{
	set .@checkquest, checkquest(4162);
	if (.@checkquest == 2) {
		mes "[Party Recruiting Expert]";
		mes "既然你来找我，看来你对^006400组队招募^000000感兴趣？";
		next;
		switch(select("听组队招募介绍。:结束对话。")) {
		case 1:
			callsub L_Info;
			mes "[Party Recruiting Expert]";
			mes "这位专家的讲解很棒，对吧？需要复习时再来找我。";
			close;
		case 2:
			mes "[Party Recruiting Expert]";
			mes "有问题就来找我。";
			close;
		}
	} else if (.@checkquest == 0 || .@checkquest == 1) {
		mes "[Party Recruiting Expert]";
		mes "我研究^006400组队招募^000000 16 年，所以我是专家！你通过了^006400攻城战专家^000000的测试，他才把你介绍给我，对吧？";
		next;
		mes "[Party Recruiting Expert]";
		mes "你可能已经听说，答对所有专家的测验就能获得丰厚奖励！";
		next;
		mes "[Party Recruiting Expert]";
		mes "作为第二位专家，我会告诉你^006400组队招募^000000的一切！怎么样？";
		next;
		switch(select("听组队招募介绍。:结束对话。")) {
		case 1:
			callsub L_Info;
			mes "[Party Recruiting Expert]";
			mes "现在～我的讲解像滑头罪犯一样顺滑，对吧？接下来有 3 道题，全部答对就算通过。要挑战吗？";
			while(1) {
				set .@correct,0;
				next;
				switch(select("开始测验！:请再解释一次？:放弃。")) {
				case 1:
					switch(rand(1,3)) {
					case 1:
						mes "[Party Recruiting Expert]";
						mes "组队招募用于帮助";
						mes "寻找[]的用户";
						mes "以及寻找[]的用户。";
						mes "[] 中的空格应该填什么？";
						next;
						if(select("公会、公会成员:俱乐部、俱乐部成员:巴黎、队伍成员:队伍、队伍成员") == 4)
							set .@correct, .@correct+10;
						mes "[Party Recruiting Expert]";
						mes "帮助用户寻找和搜索队伍的窗口叫作[]。";
						mes "[] 中的空格应该填什么？";
						next;
						if(select("队伍列表:队伍需求列表:组队招募列表:服装队伍列表") == 3)
							set .@correct, .@correct+10;
						mes "[Party Recruiting Expert]";
						mes "创建组队招募公告时，以下哪个选项不会列出？";
						next;
						if(select("等级:技能:职业:地图") == 2)
							set .@correct, .@correct+10;
						break;
					case 2:
						mes "[Party Recruiting Expert]";
						mes "组队招募有两种。";
						mes "一种是登记组队招募";
						mes "另一种是[]。";
						mes "[] 中的空格应该填什么？";
						next;
						if(select("搜索正在招募的队伍:开始狩猎的队伍:队伍招募和物品分配:队伍物品") == 1)
							set .@correct, .@correct+10;
						mes "[Party Recruiting Expert]";
						mes "要开始组队招募，必须点击左上方信息区域的[]按钮。";
						mes "[] 中的空格应该填什么？";
						next;
						if(select("队伍:公会:预约:技能") == 3)
							set .@correct, .@correct+10;
						mes "[Party Recruiting Expert]";
						mes "想了解组队招募命令，必须按下组队招募列表窗口中的[]按钮。";
						mes "[] 中的空格应该填什么？";
						next;
						if(select("基本信息:帮助:队伍:确认") == 2)
							set .@correct, .@correct+10;
						break;
					case 3:
						mes "[Party Recruiting Expert]";
						mes "要进行组队招募并让";
						mes "组队招募窗口弹出，";
						mes "请输入命令[]。";
						mes "[] 中的空格应该填什么？";
						next;
						if(select("/队伍收集窗口: /队伍收集:/队伍招募窗口:/队伍招募") == 4)
							set .@correct, .@correct+10;
						mes "[Party Recruiting Expert]";
						mes "招募队伍时可以设置 3 个参数，分别是";
						mes "等级、职业和[]。";
						mes "[] 中的空格应该填什么？";
						next;
						if(select("技能:公会:地图:选项") == 3)
							set .@correct, .@correct+10;
						mes "[Party Recruiting Expert]";
						mes "组队招募用于帮助";
						mes "寻找[]的用户";
						mes "以及寻找[]的用户。";
						mes "[] 中的空格应该填什么？";
						next;
						if(select("格挡、队伍成员:俱乐部、俱乐部成员:队伍、队伍成员:公会、公会成员") == 3)
							set .@correct, .@correct+10;
						break;
					}
					if (.@correct == 30) {
						mes "[Party Recruiting Expert]";
						mes "很好！3 道题全答对了！现在你更有信心进行^006400组队招募^000000了吗？";
						next;
						mes "[Party Recruiting Expert]";
						mes "想了解更多^006400组队招募^000000内容，随时来找我。";
						next;
						mes "[Party Recruiting Expert]";
						mes "好了，去找^0000FF战场专家^000000吧！他应该在等你。";
						completequest 4162;
						setquest 4163;
						getexp 2000,1000;
						close;
					}
					mes "[Party Recruiting Expert]";
					mes "只有 3 个问题，而你没有全部答对！这样下去你会通不过所有专家的测试。";
					next;
					mes "[Party Recruiting Expert]";
					mes "但如果你想重考测验，就去做吧！我觉得你有潜力！想再试一次吗？";
					break;
				case 2:
					callsub L_Info;
					mes "[Party Recruiting Expert]";
					mes "现在～我的讲解像滑头罪犯一样顺滑，对吧？接下来有 3 道题，全部答对就算通过。要挑战吗？";
					break;
				case 3:
					mes "[Party Recruiting Expert]";
					mes "别放弃！你能做到！改变主意后再来和我谈谈！";
					close;
				}
			}
			close;
		case 2:
			mes "[Party Recruiting Expert]";
			mes "你连听都不听就要放弃吗？改变主意后再来和我谈谈！";
			close;
		}
	}
	mes "[Party Recruiting Expert]";
	mes "如果你想向我学习，先和^006400攻城战大师^000000谈谈。";
	close;

L_Info:
	mes "[Party Recruiting Expert]";
	mes "^006400Party Recruiting^000000 is pretty self explanatory. It helps people find party members and it helps people find parties.";
	next;
	mes "[Party Recruiting Expert]";
	mes "组队招募分为两部分。";
	mes "1st step is ^0000FFRegistering Party Recruiting^000000,";
	mes "第二步是^0000FF队伍搜索^000000。";
	next;
	mes "[Party Recruiting Expert]";
	mes "要查看组队招募，请点击左上方信息窗口中的^006400预约^000000按钮。之后会显示^006400组队招募列表^000000。";

			break;
		case 65:
			mes "浮游虫警告你，暴食会让自己变得迟钝。";
			mes "吃东西是好事，但野外很危险。让胃保持部分空腹。";
			next;
			mes "[Lhimetorra]";
			mes "这样才能迅速应对危机。";
			break;
		case 66:
			mes "如果到了被浮游虫警告的地步……你一定是个不得了的人。";
			next;
			mes "[Lhimetorra]";
			mes "它说要做得更好……我不知道是什么意思。";
			break;
		case 67:
			mes "公牛警告你腐化：懒惰、享乐而不勤奋。";
			mes "它认为这就像无法切除的癌细胞。";
			next;
			mes "[Lhimetorra]";
			mes "小心别让那种细胞附着在你身上。";
			break;
		case 68:// Minorous Card
			mes "公牛警告你对危机无知。";
			mes "不知道危机是危机，是最危险的事。";
			next;
			mes "[Lhimetorra]";
			mes "你需要学会读懂危险。接受公牛的建议。";
			break;
		case 69:
			mes "公牛警告某件会让生活悲伤的事。";
			mes "悲伤是自然情感，但别因此消沉。";
			next;
			mes "[Lhimetorra]";
			mes "公牛是诚实的劳动者，即使工作也会哭泣。它知道即使表达悲伤，也不能懒于完成该做的事。";
			mes "它似乎想把这些告诉你。";
			break;
		case 70:
			mes "公牛警告你不要吃注水牛肉。";
			mes "据说这种行为一定会招来怪物的诅咒。";
			next;
			mes "[Lhimetorra]";
			mes "我不知道它为何警告这个……你是不是养牛？";
			break;
		}
		next;
		mes "[Lhimetorra]";
		mes "警告总是有用的命运指引。你永远不会失去什么。";
		next;
		cutin "",255;
		mes "[Lhimetorra]";
		mes "希望你能凭这份警告避开不幸。那么……";
		close;
	}
}


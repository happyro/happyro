lhz_dun02,282,278,0	script	Broken Machine	HIDDEN_NPC,{

	if(checkweight(7346,1) != 1)
	{
		mes "^3355FFWait a second!";
		mes "你现在携带的物品太多了。请使用卡普拉服务存放物品后再回来。^000000";
		close;
	}
	if(lhz_boss < 6)
	{
		mes "^3355FF这里有几块";
		mes "周围有几台破损机器，看起来完全没用。^000000";
		close;
	}
	else if(lhz_boss == 6)
	{
		mes "^3355FF这里有几块";
		mes "周围有几台破损机器，看起来完全没用。";
		mes "不过，你在废金属中发现了一丝微弱的光。^000000";
		next;
		switch( select( "调查。","忽略。" ) )
		{
			case 1:
				mes "^3355FF翻过废弃机器后，你找到一块拳头大小、闪烁微光的奇怪岩石。^000000";
				next;
				switch( select( "这可能很重要。","看起来没用。" ) )
				{
					case 1:
						mes "^3355FF这块怪石可能正是 ^000000Ghalstein^3355FF 派你寻找的东西。";
						mes "他不向你描述它是对的，单靠语言无法说明……^000000";
						set lhz_boss,7;
						getitem 7346,1;
						close;

					case 2:
						mes "^3355FF这块岩石长得奇怪，并不比你一生见过的无数岩石更特别。^000000";
						close;
				}

			case 2:
				mes "^3355FF这堆无用垃圾里怎么可能有值钱的东西？^000000";
				close;
		}
	}
	else
	{
		mes "^3355FF这里有几块";
		mes "周围有几台破损机器，看起来完全没用。^000000";
		close;
	}
}

sec_in02,17,170,4	script	boss::lght_boss_admin	1_M_SIGNMONK,{
	callfunc "F_GM_NPC";
	mes "[Patch]";
	mes "告诉我你想要什么。";
	next;
	switch(select("Current Variables:How Many:Shinokas - Quest Complete")) {
	case 1:
		break;
	case 2:
		input .@input,0,1000;
		set lght_boss,.@input;
		break;
	case 3:
		set Shinokas_Quest,11;
		close;
	}
	mes " ";
	mes ""+lght_boss;
	close;
}

lhz_in02,19,274,2	script	Maintenance Guy	4_M_REPAIR,{

	mes "[Kudiuu]";
	mes "天啊……！这里到底能不能打扫干净？！^333333*咳咳*^000000";
	mes "这里灰尘太多，简直危害健康！";
	close;
}

// Rekenber Job Quest
//============================================================
lhz_in01,174,258,3	script	Young Man#reken	4_M_LGTGUARD,{

	if(lhz_rekenber > 21)
	{
		cutin "lhz_kaz10",2;
		mes "[Kazien]";
		mes "只是……别管我。看到你我只有内疚。";
		next;
		mes "[Kazien]";
		mes "别误会。不是你做错了什么，是我……唉。真希望我能像你一样生活。总有一天我会足够坚强……";
		close2;
		cutin "",255;
		end;
	}
	else if(lhz_rekenber == 21)
	{
		cutin "lhz_kaz03",2;
		mes "[Kazien]";
		mes "嘿，你回来了。和往常一样干得不错。你看起来很累，又遇到那些暴徒了吗？休息一下吧。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "Kazien……我和暴徒战斗时，一个包裹意外打开了，我看到了里面的东西。";
		next;
		cutin "lhz_kaz06",2;
		next;
		mes "[Kazien]";
		mes "......";
		mes ".........";
		mes "............";
		cutin "lhz_kaz08",2;
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "你、你为什么供应那些东西？如果这些包裹被其他国家进口，会造成大麻烦……！";
		next;
		cutin "lhz_kaz10",2;
		mes "[Kazien]";
		mes "住手。求你了。别再说了。我不想再听。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "等等，我应得到答案！你怎么能视而不见，向任何人提供 ^FF0000高科技武器和守护者^000000？这简直是在助长战争与暴力！";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "那你弟弟 Lyozien 呢？他根本不知道自己在做什么！";
		mes "我们难道不该对世界负责，确保这些武器不被分发吗？";
		next;
		cutin "lhz_kaz11",2;
		mes "[Kazien]";
		mes "闭嘴！你什么都不知道！闭嘴！我这是为了家人！";
		mes "你不知道住在莱茵哈特贫民窟是什么滋味！";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes ".................";
		next;
		cutin "lhz_kaz04",2;
		mes "[Kazien]";
		mes "有些日子我和弟弟甚至没东西吃。所以听说这份工作时我就接受了。";
		mes "如果我活不到享受世界和平那天，和平又有什么用，嗯？";
		next;
		cutin "lhz_kaz11",2;
		mes "[Kazien]";
		mes "我的弟弟 Lyozien 心地善良，只有对所有人的爱。";
		mes "所以我不能告诉他真相——相信我，他绝不会同意。";
		next;
		cutin "lhz_kaz10",2;
		mes "[Kazien]";
		mes "我讨厌这份工作和自己做的事，也想辞职。";
		mes "但那又怎样？回贫民窟吗？算了。只要 Lyozien 幸福，即使要做恶魔的工作我也不在乎。";
		next;
		cutin "lhz_kaz11",2;
		mes "[Kazien]";
		mes "至少这样秘密进行，我能保护 Lyozien 不受这份工作的丑陋影响，";
		mes "即使弄脏双手，从他人的死亡中赚钱。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "但这仍然不对。你出售武器让人们互相残杀！即使是为了养活家人……";
		next;
		cutin "lhz_kaz05",2;
		mes "[Kazien]";
		mes "听着，这是我的决定。我不在乎别人怎么想。";
		mes "死后也许会下地狱，但那是我的问题。";
		next;
		mes "[Kazien]";
		mes "况且你们冒险者总是带着剑和魔法到处跑……那不也一样糟吗？";
		mes "武器和力量本身没有错，错的是使用方式。";
		next;
		cutin "lhz_kaz11",2;
		mes "[Kazien]";
		mes "当然，我的大多数客户";
		mes "确实很可疑，而且你们冒险者通常用力量行善，但是……";
		mes "可恶！总之……别再回来。我没法这样工作……";
		next;
		set lhz_rekenber,22;
		getexp (checkre(3))?55000:550000,0;
		completequest 12013;
		cutin "lhz_kaz01",2;
		mes "[Kazien]";
		mes "听着，我不能再让你和我、Lyozien 一起工作了。";
		mes "抱歉，这是为了 Lyozien 好。而且你让我感到内疚……";
		close2;
		cutin "",255;
		end;
	}
	else if(lhz_rekenber > 16)
	{
		cutin "lhz_kaz02",2;
		mes "[Kazien]";
		mes "嘿，你最好快点。你得协助另一批送往卢恩-米德加尔特王国的货物。";
		close2;
		cutin "",255;
		end;
	}
	else if(lhz_rekenber == 16)
	{
		cutin "lhz_kaz03",2;
		mes "[Kazien]";
		mes "啊，我听 Lyozien 说你们完成了配送。你大概是我很久以来遇到的最佳兼职。";
		next;
		cutin "lhz_kaz10",2;
		mes "[Kazien]";
		mes "总之，我们又有一批货要送往卢恩-米德加尔特王国。";
		mes "奇怪的是那里的订单增加了，其他国家的订单却在减少。";
		next;
		cutin "lhz_kaz07",2;
		mes "[Kazien]";
		mes "呃，我没时间思考这种事。Lyozien 正在等你，快去吧，好吗？";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "等、等等！上次配送时，有群想摧毁包裹的暴徒袭击了我。他们为什么要这么做？";

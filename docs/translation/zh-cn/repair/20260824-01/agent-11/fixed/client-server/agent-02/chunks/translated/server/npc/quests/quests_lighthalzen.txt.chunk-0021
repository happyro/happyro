	}
	else
	{
		mes "^3355FF这份文件似乎不包含能帮助你的证据。";
		mes "你应该继续搜索其余文件。^000000";
		close;
	}
}

lhz_in01,184,46,0	script	Area 3-2	HIDDEN_NPC,{

	if((lhz_boss > 28) && (lhz_boss < 30))
	{
		mes "^3355FF这里有成千上万份文件要整理。";
		mes "你不可能在短短三分钟内找到有价值的东西……^000000";

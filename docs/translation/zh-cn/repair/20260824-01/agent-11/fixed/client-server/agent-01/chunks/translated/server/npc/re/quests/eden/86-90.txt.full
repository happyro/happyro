//===== rAthena Script =======================================
//= Eden Group Quests - Mission [86 - 90]
//===== By: ==================================================
//= Chilly
//===== Current Version: =====================================
//= 1.5
//===== Compatible With: =====================================
//= rAthena Project
//===== Description: =========================================
//= Repetable Quests for Players between Baselevel 86 - 90.
//===== Additional Comments: =================================
//= 1.0 First Version. [Chilly]
//= 1.1 Some little improvements here and there. [Masao]
//= 1.2 Optimized. [Euphy]
//= 1.3 Updated to match the official script. [Euphy]
//= 1.4 Added support to Para_Team_Mark_ in Eden Group. [Ragno]
//= 1.5 Added use of F_HasEdenGroupMark function. [Ragno]
//============================================================

moc_para01,48,175,3	script	86-90 Mission Board	857,{
	if (!callfunc("F_HasEdenGroupMark")) {
		mes "请稍等！";
		mes "-你需要拥有-";
		mes "-^4d4dff‘伊甸园徽章’^000000-";
		mes "-才能接受这些任务。-";
		next;
		switch(select("就此离开。:^0000FF伊甸园^000000任务？:如何成为^0000FF伊甸园^000000成员？")) {
		case 1:
			close;
		case 2:
			mes "::伊甸园任务基本上是";
			mes "::王国各地的人们";
			mes "::委托的任务。";
			mes "::我们只是对它们进行";
			mes "::分类。";
			next;
			mes "::在伊甸园里，";
			mes "::我们会按照任务难度";
			mes "::对任务进行分类。";
			mes "::根据这个等级，";
			mes "::你可以找到";
			mes "::适合自己的";
			mes "::任务。";
			next;
			mes "::完成任务后，";
			mes "::你可以回到";
			mes "::任务公告板。";
			next;
			mes "::然后你就能获得";
			mes "::奖励！！";
			mes "::很简单吧！！";
			mes "::而且不收取手续费！！";
			close;
		case 3:
			mes "::你可以成为伊甸园的";
			mes "::成员，";
			mes "::去找正在一楼等候的";
			mes "::^0000FF莱姆·伊维诺^000000。";
			next;
			mes "::成为成员后，";
			mes "::你会获得一个";
			mes "::\"^006400伊甸园徽章^000000\"。";
			mes "::这样就能查看";
			mes "::任务公告板了。";
			close;
		}
	}
	if (BaseLevel < 86  || BaseLevel > 90) {
		// Quest IDs: 4167-4180
		// Quest cooldown IDs: 4198-4211
		setarray .@names$[0],
			"龙尾","春兔","害虫",
			"巴风特女巫","警报魔",
			"芭芭雅嘎","姚君","火枪兵","拉链熊",
			"地面小精灵","拉弗莱西亚","毒液怪","矿工","黄色诺博斯";
		setarray .@exp[0],
			76000,82000,82000,
			72000,76000,
			72000,78000,82000,80000,
			72000,72000,72000,86000,80000;
		mes "等级必须在 86～90 之间才能接受这些任务。";
		for(set .@quest,4167; .@quest<=4180; set .@quest,.@quest+1) {
			set .@hunting, checkquest(.@quest,HUNTING);
			if (.@hunting == 0 || .@hunting == 1) {
				next;
				mes "::你无法继续进行";
				mes "::^0000FF"+.@names$[.@quest-4167]+"狩猎任务^000000。";
				mes "::任务登记";
				mes "::任务登记已取消。";
				erasequest .@quest;
				close;
			} else if (.@hunting == 2) {
				next;
				mes "::你已在任务公告板上";
				mes "::登记了";
				mes "::^0000FF"+.@names$[.@quest-4167]+"狩猎任务^000000。";
				mes "::你获得了";
				mes "::经验奖励：";
				mes "::相应的经验奖励。";
				erasequest .@quest;
				getexp .@exp[.@quest-4167],0;
				close;
			}
		}
		close;
	}
	mes "[86～90 级任务公告板]";
	mes "公告板上有几个委托。";
	next;
	switch(select("^8B4513海龟岛^000000:^8B4513钟楼地下城^000000:^8B4513扩展城镇^000000:^8B4513其他地区^000000")) {
	case 1:
		mes "^8B4513海龟岛^000000。";
		mes "你要猎杀哪种怪物，或已经完成哪种猎杀？";
		next;
		switch(select("^0000FF龙尾^000000:^0000FF春兔^000000:^0000FF害虫^000000")) {
			case 1: callsub L_Quest,4167,"Dragon Tail",76000,"드래곤테일카드","There is a monster that only can be found on ^8B4513Turtle Island^000000.","s";
			case 2: callsub L_Quest,4168,"Spring Rabbit",82000,"스프링래빗카드","There is a monster that only can be found on ^8B4513Turtle Island^000000.","s";
			case 3: callsub L_Quest,4169,"Pest",82000,"페스트카드","There is a monster that only can be found on ^8B4513Turtle Island^000000.","s";
		}
	case 2:
		mes "^8B4513钟楼地下城^000000。";
		mes "你要猎杀哪种怪物，或已经完成哪种猎杀？";
		next;
		switch(select("^0000FF巴风特女巫^000000:^0000FF警报魔^000000")) {
			case 1: callsub L_Quest,4170,"Bathory",72000,"바소리카드","The Clock Tower Dungeon is full of dangerous monsters.";
			case 2: callsub L_Quest,4171,"Alarm",76000,"알람카드","The Clock Tower Dungeon is full of dangerous monsters.";
		}
	case 3:
		mes "^8B4513扩展城镇^000000";
		mes "你要猎杀哪种怪物，或已经完成哪种猎杀？";
		next;
		switch(select("^0000FF芭芭雅嘎^000000:^0000FF姚君^000000:^0000FF火枪兵^000000:^0000FF拉链熊^000000")) {
			case 1: callsub L_Quest,4172,"芭芭雅嘎",72000,"","莫斯科比亚郊外可以找到女巫芭芭雅嘎。";
			case 2: callsub L_Quest,4173,"Yao Jun",117000,"혜군카드","There are human-like monsters that roam around the dungeon in Luoyang.";
			case 3: callsub L_Quest,4174,"Firelock Soldier",82000,"구식조총병카드","There are human-like monsters that roam around the dungeon in Amatsu.","s";
			case 4: callsub L_Quest,4175,"Zipper Bear",120000,"지퍼베어카드","There are bear monsters swarming in the Kunlun dungeon.";
		}
	case 4:
		mes "[86～90 级任务公告板]";
		mes "这里列出在米德加尔德其他地区猎杀怪物的随机委托。";
		mes "你要猎杀哪种怪物，或已经完成哪种猎杀？";
		next;
		switch(select("^0000FF地面小精灵^000000:^0000FF拉弗莱西亚^000000:^0000FF毒液怪^000000:^0000FF矿工^000000:^0000FF黄色诺博斯^000000")) {
			case 1: callsub L_Quest,4176,"Ground Petite",72000,"지상쁘띠카드","There are dragon type monsters swarming the western region of Geffen.";
			case 2: callsub L_Quest,4177,"Rafflesia",72000,"라플레시아카드","There are plant type monsters infesting the fields of Lighthalzen.";
			case 3: callsub L_Quest,4178,"Venomous",72000,"베노머스","There are formless monsters floating around the fields of Einbroch.";
			case 4: callsub L_Quest,4179,"Pitman",86000,"핏맨","There are undead monsters pushing a cart around the fields and dungeons of Einbroch.";
			case 5: callsub L_Quest,4180,"Yellow Novus",80000,"옐로우노버스","There are yellow dragon type monsters terrorizing the fields of Hugel.";
		}
	}
	end;

//callsub L_Quest,<quest ID>,"<monster name>",<reward EXP>,"<cutin image>","<description>"{,"s"};
L_Quest:
	set .@quest1, getarg(0);
	set .@quest2, .@quest1+31;
	.@cutin$ = getarg(3);
	set .@playtime, checkquest(.@quest2,PLAYTIME);
	if (.@playtime == 0 || .@playtime == 1) {
		mes "[86～90 级任务公告板]";
		mes "你需要等待 3 小时才能再次接受这个任务。";
		close;
	}
	set .@hunting, checkquest(.@quest1,HUNTING);
	if (.@hunting == 0 || .@hunting == 1) {
		mes "[86～90 级任务公告板]";
		mes "你已经猎杀完 30 只"+getarg(1)+getarg(5,"")+"了吗？";
		close;
	} else if (.@hunting == 2) {
		mes "[86～90 级任务公告板]";
		mes "你完成了猎杀。";
		mes "请收下这份奖励。";
		erasequest .@quest1;
		if (.@playtime > -1) erasequest .@quest2;
		setquest .@quest2;
		getexp getarg(2),0;
		close;
	}/* else if (.@hunting == 3) {
//		recall_completequest .@quest1
		erasequest .@quest1;
		mes "[86～90 级任务公告板]";
		mes "你重新接受了"+getarg(1)+"猎杀任务。";
		close;
	}*/ else {
		mes "[86～90 级任务公告板]";
		mes getarg(4);
		next;
		if (.@cutin$ != "") cutin .@cutin$,3;
		mes "[86～90 级任务公告板]";
		mes "在那里猎杀 30 只"+getarg(1)+"，然后在公告板上登记成功。";
		next;
		if (.@cutin$ != "") cutin .@cutin$,255;
		if(select("我去猎杀。:不用了，谢谢。") == 1) {
			mes "[86～90 级任务公告板]";
			mes "完成任务后，在公告板上登记并领取奖励。";
			if (.@playtime > -1) erasequest .@quest2;
			setquest .@quest1;
		}
		close;
	}
}

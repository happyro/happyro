		mes "[班卡斯坦]";
		mes "总之，祝你";
		mes "旅途平安，";
		mes "冒险者。我们三人";
		mes "聚齐时我会";
		mes "告诉你～";
		close3;
	}
	if (friendship == 11 && countitem(7351) > 0) {
		mes "[班卡斯坦]";
		mes "糟糕，这比我预想";
		mes "花的时间更长。";
		mes "";
		mes "我把那东西放哪了？";
		mes "嗯嗯……";
		next;
		cutin "lhz_benkaistin02.bmp",2;
		mes "[班卡斯坦]";
		mes "哦，是那个吗？";
		mes "你找到我的";
		mes "日记了吗？快让我";
		mes "检查一下。对，对……";
		mes "就是这个！谢谢你";
		mes "帮我找到了它！";
		next;
		cutin "",255;
		mes "[班卡斯坦]";
		mes "能帮我一个忙吗？";
		mes "我亲自去找他们会更好，";
		mes "但我正忙着写论文……";
		mes "实在抽不开身。";
		mes "拜托你了。";
		next;
		mes "[班卡斯坦]";
		mes "请把这本日记交给迪戈茨和马库好吗？";
		mes "这是我们年幼时写的，";
		mes "记录了我们共同度过的";
		mes "美好时光。";
		mes "我们的美好时光。";
		mes "请让他们看看。";
		next;
		set friendship,12;
		changequest 12004,12005;
		cutin "lhz_benkaistin04.bmp",2;
		mes "[班卡斯坦]";
		mes "总之，这至少能让他们意识到";
		mes "自己的行为有多愚蠢。";
		mes "先谢谢你，";
		mes "请替我照顾好马库和迪戈茨。";
		mes "拜托了。";
		mes "祝你顺利。";
		close3;
	}
	if (friendship == 10 || friendship == 11) {
		mes "[班卡斯坦]";
		mes "糟糕，这比我预想";
		mes "花的时间更长。";
		mes "";
		mes "我把那东西放哪了？";
		mes "嗯嗯……";
		next;
		mes "^3355FF也许你最好帮班卡斯坦";
		mes "寻找他正在找的东西。^000000";
		mes "这样能节省不少时间。";
		mes "请尽快开始。";
		close;
	}
	if (friendship == 9) {
		cutin "lhz_benkaistin03.bmp",2;
		mes "[Passionate Student]";
		mes "哦，你吓到我了！";
		mes "不过我知道，一旦沉浸在书里，";
		mes "就很难注意到周围。";
		mes "那么我能帮你什么，冒险者？";
		mes "请告诉我。";
		mes "我会尽力帮忙。";
		next;
		select("告诉他马库和迪戈茨的事。");
		cutin "lhz_benkaistin02.bmp",2;
		mes "[班卡斯坦]";
		mes "哦，我的朋友们怎么样？";
		mes "什么？他们只是因为一个有钱、";
		mes "另一个贫穷就大吵一架？";
		mes "真幼稚！";
		mes "他们怎么还没长大。";
		next;
		mes "[班卡斯坦]";
		mes "不过这确实很像他们。*唉*";
		mes "我真想回家让他们和好，";
		mes "但还得完成论文。";
		mes "让我想想……我在这里能做什么？";
		mes "一定有办法。";
		mes "不能让他们继续争吵。";
		next;
		set friendship,10;
		changequest 12003,12004;
		mes "[班卡斯坦]";
		mes "哦，我知道该怎么做了！";
		mes "等等，但我把它放哪了？";
		mes "这么重要的东西怎么会丢？";
		mes "等等！请稍等一会儿，";
		mes "让我找找看。";
		mes "很快就好。";
		close3;
	}
	if (friendship == 8) {
		cutin "lhz_benkaistin04.bmp",2;
		mes "[Passionate Student]";
		mes "让我看看。";
		mes "风魔法、黑魔法、波利……啊，在这里。";
		mes "魔物种族属性。";
		mes "希望里面有我需要的信息……";
		mes "这些资料很有价值。";
		mes "我得仔细研究。";
		next;
		mes "^3355FFUpon briefly glancing at";
		mes "你快速浏览这名学生的物品，";
		mes "注意到上面印着‘班卡斯坦’的名字。";
		mes "这就是马库和迪戈茨提到的朋友！^000000";
		mes "终于找到线索了。";
		mes "请继续调查。";
		next;
		select("打扰了……");
		mes "["+ strcharinfo(0) +"]";
		mes "打扰了……";
		mes "班卡斯坦？";
		next;
		mes "[Passionate Student]";
		mes "……人类世界和恶魔世界，";
		mes "是的，是的……不，我要找的是";
		mes "关于天堂或阿斯加德的资料。";
		mes "嗯，这里也许有帮助……";
		mes "请不要打扰我。";
		mes "我正在思考。";
		next;
		select("嘿……");
		mes "["+ strcharinfo(0) +"]";
		mes "嘿……";
		mes "我在这里。";
		mes "班卡斯坦！";
		next;
		mes "[Passionate Student]";
		mes "……哦，这是个非常有趣的观察。";
		mes "如果能把它加入论文，";
		mes "我的论点会更加可靠……";
		mes "这可能改变研究方向。";
		mes "我得记下来。";
		mes "谢谢你的提醒。";
		next;
		select("喂，你……！");
		mes "["+ strcharinfo(0) +"]";
		mes "喂，你……！";
		mes "班卡斯坦～！";
		cutin "",255;
		next;
		cutin "lhz_benkaistin02.bmp",2;
		mes "[Passionate Student]";
		mes "哦，天哪！";
		mes "能、能不能保持";
		mes "能不能小声一点？";
		mes "我、我正在学习！";
		mes "不，等等。你一直在叫我吗？";
		mes "我怎么现在才注意到。";
		set friendship,9;
		close3;
	}
	mes "[Passionate Student]";
	mes "让我看看。";
	mes "风魔法、黑魔法、波利……啊，在这里。";
	mes "魔物种族属性。";
	mes "希望里面有我需要的信息……";
	mes "这些资料很有价值。";
	mes "我得仔细研究。";
	next;
		mes "^3355FF这个学生似乎正在";
	mes "他正在专心进行";
	mes "某个学术主题的深入研究。";
	mes "现在最好不要打扰他，";
	mes "让他继续学习。^000000";
	mes "请保持安静。";
	close;
}

yuno_in04,168,117,3	script	Book#lhz	HIDDEN_NPC,{

		mes "太多物品。";
		mes "请先回来，";
		mes "使用卡普拉服务";
		mes "存放部分物品。^000000";
		close;
	}
	if (friendship == 15) {
		cutin "lhz_benkaistin01.bmp",2;
		mes "[班卡斯坦]";
		mes "你把我的日记带给";
		mes "迪戈茨和马克了吗？";
		mes "我相信它会让他们想起";
		mes "我们的美好时光。";
		mes "他们肯定很固执……";
		mes "";
		next;
		mes "[班卡斯坦]";
		mes "总之，我真的";
		mes "很感谢你的";
		mes "帮助。回家后我期待";
		mes "再次见到他们。";
		mes "";

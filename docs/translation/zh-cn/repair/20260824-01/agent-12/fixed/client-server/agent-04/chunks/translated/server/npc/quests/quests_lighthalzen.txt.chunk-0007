		next;
		mes "[马克]";
		mes "当你厌倦";
		mes "贫民窟后，";
		mes "真的应该去看看";
		mes "城镇的富人区。";
		mes "我很嫉妒，但也承认";
		mes "那里比这里好太多。";
	}
	close2;
	cutin "",255;
	end;
}



prt_maze02,16,183,3	script	Pleur#sign	91,{
	callfunc "F_UpdateSignVars";
	mes "[Pleur]";
	if (sign_q < 19) {
		mes "啦啦啦~";
		mes "啦啦啦~";
	}
	else {
		mes "嗯……？贤者之石……";
	}
	close;

OnHo:
	emotion ET_DELIGHT;
	end;
OnKis2:
	emotion ET_CHUPCHUP;
	end;
OnGasp:
	emotion ET_SURPRISE;
	end;
OnOmg:
	emotion ET_HUK;
	end;
}

prt_maze02,14,183,4	script	Gordon#sign	51,{
	callfunc "F_UpdateSignVars";
	mes "[Gordon]";
	if (sign_q < 18) {
		emotion ET_DELIGHT;
		mes "你好，亲爱的。今天做了什么？";
		next;
		donpcevent "Pleur#sign::OnHo";
		mes "[Pleur]";
		mes "我和白熊、蓝熊玩捉迷藏了，爸爸。";
		next;
		emotion ET_DELIGHT;
		mes "[Gordon]";
		mes "亲爱的……你不厌倦和动物玩吗？我们已经在这片森林住了很久……";
		next;
		donpcevent "Pleur#sign::OnKis2";
		mes "[Pleur]";
		mes "别担心，爸爸，我明白。目前这里是我们唯一能放松、平静生活的地方。我想完成目标后，我们值得休息……";
		next;
		emotion ET_CRY;
		mes "[Gordon]";
		mes "谢谢你，Pleur。我不后悔我们的工作，但有时真希望你能过更无忧无虑的生活……";
		if (sign_q < 17) close;
		else if (sign_q == 17) {
			next;
			switch(select("咆哮~！:打扰一下。")) {
			case 1:
				set sign_q,18;
				donpcevent "#skill::OnEnable";
				emotion ET_HUK;
				donpcevent "Pleur#sign::OnOMG";
				mes "[Pleur]";
				mes "不，不，不！召唤植物！";
				next;
				mes "[Gordon]";
				mes "伟大的肖特！召唤……海洋之珠！";
				close;
			case 2:
				emotion ET_SURPRISE;
				donpcevent "Pleur#sign::OnGasp";
				mes "[Gordon]";
				mes "嗯？！你不知道这里有多危险吗？你在这片森林中间做什么？";
				next;
				mes "["+ strcharinfo(0) +"]";
				mes "其实，我正是在找你们。我受托寻找这两位著名炼金术士。";
				next;
				mes "[Gordon]";
				mes "嗯……？我们现在已经退休了，不过如果你有问题，回答一下也无妨……";
				next;
				switch(select("询问贤者之石:询问炼金术:退出")) {
				case 1:
					set sign_q,19;
					mes "[Gordon]";
					mes "贤者之石？嗯，坦白说，我完全不了解。我想它的存在基本只是传闻。";
					next;
					mes "[Gordon]";
					mes "我只听说贤者之石可能是把材料炼成黄金的催化剂。如果它真的存在，那将是终极炼金物品。";
					next;
					mes "[Pleur]";
				mes "不过我也听说它是红色的，能让人类永生，治愈任何疾病。这些传闻到底从何而来？太疯狂了……";
					next;
					mes "[Gordon]";
				mes "现在我甚至听说有人在尝试自己制造贤者之石。如果成功，会对整个世界产生巨大影响！";
					next;
					mes "[Gordon]";
				mes "抱歉你为了这种消息费心找到我们。毕竟我们已经退休，可能不了解最新情况。";
					next;
					mes "[Pleur]";
			mes "虽然我们退休了，但如果有人真的成功制造出这种石头，我们也很想知道。如果发生了，请告诉我们好吗？";
					next;
					mes "[Gordon]";
			mes "现在让我带你沿安全路线离开迷宫。我住在这里很久了，闭着眼也能找到出口。再见，冒险者~";
					close2;
					warp "mjolnir_12",44,23;
					end;
				case 2:
					mes "[Pleur]";
			mes "希望你能理解，我和父亲为工作投入并牺牲了很多。最后，我们发现了用药水召唤怪物的方法。";
					next;
					mes "[Pleur]";
			mes "不过研究结果公布后，太多炼金术士追问我们的资料。那超出了我们的承受能力……";
					next;
					mes "[Gordon]";
			mes "抱歉，如果你对炼金术有疑问，外面有很多合格的研究者和实践者。我们来到这片森林是为了寻找平静……";
					close;
				case 3:
					mes "[Gordon]";
			mes "哈哈哈~你忘了要问我什么吗？";
					close;
				}
			}
		}
	}
	else if (sign_q == 18) {
		emotion ET_HNG;
		mes "哦……！你吓到我们了！像动物一样咆哮！你以为自己在做什么？";
		next;
		mes "["+ strcharinfo(0) +"]";
		mes "其实，我正是在找你们。我受托寻找这两位著名炼金术士。";
		next;
		mes "[Gordon]";
		mes "嗯……？我们现在已经退休了，不过如果你有问题，回答一下也无妨……";
		next;
		switch(select("询问贤者之石:询问炼金术:退出")) {
		case 1:
			set sign_q,19;
			mes "[Gordon]";
			mes "贤者之石？嗯，坦白说，我完全不了解。我想它的存在基本只是传闻。";
			next;
			mes "[Gordon]";
			mes "我只听说贤者之石可能是把材料炼成黄金的催化剂。如果它真的存在，那将是终极炼金物品。";
			next;
			mes "[Pleur]";
			mes "不过我也听说它是红色的，能让人类永生，治愈任何疾病。这些传闻到底从何而来？太疯狂了……";
			next;
			mes "[Gordon]";
			mes "现在我甚至听说有人在尝试自己制造贤者之石。如果成功，会对整个世界产生巨大影响！";
			next;
			mes "[Gordon]";
			mes "抱歉你为了这种消息费心找到我们。毕竟我们已经退休，可能不了解最新情况。";
			next;
			mes "[Pleur]";
			mes "虽然我们退休了，但如果有人真的成功制造出这种石头，我们也很想知道。如果发生了，请告诉我们好吗？";
			next;
			mes "[Gordon]";
			mes "现在让我带你沿安全路线离开迷宫。我住在这里很久了，闭着眼也能找到出口。再见，冒险者~";
			close2;
			warp "mjolnir_12",44,23;
			end;
		case 2:
			mes "[Pleur]";
			mes "希望你能理解，我和父亲为工作投入并牺牲了很多。最后，我们发现了用药水召唤怪物的方法。";
			next;
			mes "[Pleur]";
			mes "不过研究结果公布后，太多炼金术士追问我们的资料。那超出了我们的承受能力……";
			next;
			mes "[Gordon]";
			mes "抱歉，如果你对炼金术有疑问，外面有很多合格的研究者和实践者。我们来到这片森林是为了寻找平静……";
			close;
		case 3:
			mes "[Gordon]";
			mes "哈哈哈~你忘了要问我什么吗？";
			close;
		}
	}
	else if (sign_q > 18) {
		mes "有时我会想念当炼金术士的日子。不过，像我这样聪明有才华的人，会让那些新手科学家自惭形秽~";
		next;
		emotion ET_SWEAT;
		mes "[Pleur]";
		mes "爸……爸爸！！";
		next;
		emotion ET_SMILE;
		mes "[Gordon]";
		mes "嘿嘿~我是不是太傲慢了？";
		close;
	}
}

geffen_in,59,74,4	script	Jesqurienne#sign	803,{
	callfunc "F_UpdateSignVars";
	mes "[Jesqurienne]";
	if (sign_q < 21) {
		mes "酒保~？再给我一杯。";
		if (sign_q < 20) close;
		else if (sign_q == 20) {
			next;
			mes "[Jesqurienne]";
			mes "啊~~~~~嗯？你好呀，";
			if (Sex == SEX_MALE) mes "你这位英俊的男士~";
			else mes "你这个珍贵可爱的女孩~";
			mes "我是洁斯奎安。你听说过我吧？见到我不惊讶吗？";
			next;
			switch(select("我从没听说过你。:天啊，是洁斯奎安！")) {
			case 1:
				mes "[Jesqurienne]";
				emotion ET_SWEAT;
				mes "呵呵呵~！你一定是在开玩笑~";
				next;
					switch(select("你说得对，你说得对。:不，完全没听说过。")) {
				case 1:
					emotion ET_HNG;
					mes "[Jesqurienne]";
					mes "哦呵呵呵呵呵~！我就知道！不过，像我这样的著名天才没有什么^333333不知道^000000的事！";
					next;
					mes "[Jesqurienne]";
					mes "啊——！我的杯子已经空了？酒保，再来一杯~";
					next;
					break;
				case 2:
					emotion ET_THINK;
					mes "[Jesqurienne]";
					mes "...";
					mes "……我明白了。你一直与世隔绝地生活，对吧？";
					next;
					mes "[Jesqurienne]";
					mes "不过像你这么头脑简单的人，见到著名的天才也认不出来，对吧？";
					next;
					break;
				}
				break;
			case 2:
				mes "[Jesqurienne]";
				mes "哦呵呵呵呵呵~！我就知道！不过，像我这样的著名天才没有什么^333333不知道^000000的事！";
				next;

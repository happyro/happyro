			mes "但我们还不能睡。*抽泣* 大师，今天就到此为止不行吗？";
			next;
			select("你在这里做什么？");
			mes "[Piru Piru]";
			mes "我的主人乔尔爵士正在研究创造人工生命的方法！不过这并不容易，我们还没有取得成果……";
			next;
			mes "[Piru Piru]";
			mes "主人把所有时间都花在研究上，也不好好照顾自己，体重下降了很多。我真的很担心他。";
			close;
		}
	}
	else if ((gettime(DT_HOUR) >= 6) && (gettime(DT_HOUR) < 12)) {
		mes "每天我们学习、做笔记、测试、实验、记录结果……太可怕了！";
		next;
		mes "[Piru Piru]";
		mes "虽然只有主人和我使用实验室，但我们有固定作息。上午 10 点到下午 5 点工作，下午 5 点到晚上 10 点是自由时间，之后主人就睡觉。";
		next;
		mes "[Piru Piru]";
		mes "当然，只要能多做研究，主人就很开心。无论如何，如果有事找我们，请在下午 5 点后再来。";
		close;
	}
	else {
		mes "……呼……呼……";
		next;
		switch(select("叫醒她:让她继续睡")) {
		case 1:
			mes "[Piru Piru]";
			mes "什、什么……？为什么叫醒我？明天上午 10 点后再来，好吗？";
			close;
		case 2:
			mes "[Piru Piru]";
			mes "呼呼……呼呼……";
			close;
		}
	}
}

prt_maze02,57,151,1	script	Pleur#warp	91,{
	mes "^3355FF你瞥见一个女孩径直走进深林。你决定跟上去，看看能否了解更多。^000000";
	close2;
	set .@warp_s,rand(1,10);
	if (.@warp_s < 5) warp "prt_maze02",11,146;
	if (.@warp_s > 7) warp "prt_maze03",55,8;
	if ((.@warp_s > 4) && (.@warp_s < 8)) warp "prt_maze01",62,129;
	end;
}


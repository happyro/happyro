	arena_room,94,82,7	script	Arena Record Staff#aco	79,{
	mes "[Mathea]";
	mes "你好，我负责竞技场服事者职业记录。";
	mes "如果想查看其他记录，请找竞技场记录员 Owen Kheuv，他会帮助你。";
	next;
	mes "[Mathea]";
	mes "你想查看服事者职业竞技场挑战的顶尖玩家吗？";
	mes "请从菜单选择。";
		next;
		switch(select("服事者模式:牧师 - 等级 70 以下:牧师 - 等级 80 以下:牧师 - 等级 90 以下:牧师 - 等级 91～"+(checkre(0)?"160":"99"))) {
		case 1:
		set .@acotop_t,$arn_acotop;
		set .@acotop_n$,$arn_acotopn$;
		set .@acotopbun, ((.@acotop_t % 3600) / 60 );
		set .@acotopcho, (.@acotop_t % 60);
		mes "[Mathea]";
		mes "^3131FF"+.@acotop_n$+"^000000";
		mes "是服事者模式的第一名，";
		mes "完成时间为 ^3131FF"+.@acotopbun+"^000000 分钟 ^3131FF"+.@acotopcho+"^000000 秒。";
		mes "感谢参加竞技场。";
	close;
		case 2:
		set .@pritop_t,$arn_pritop60;
		set .@pritop_n$,$arn_pritopn60$;
	break;
		case 3:
		set .@pritop_t,$arn_pritop70;
		set .@pritop_n$,$arn_pritopn70$;
	break;
		case 4:
		set .@pritop_t,$arn_pritop80;
		set .@pritop_n$,$arn_pritopn80$;
	break;
		case 5:
		set .@pritop_t,$arn_pritop90;
		set .@pritop_n$,$arn_pritopn90$;
	break;
	}
	set .@pritopbun, ((.@pritop_t % 3600) / 60 );
	set .@pritopcho, (.@pritop_t % 60);
	mes "[Mathea]";
	mes "^3131FF"+.@pritop_n$+"^000000";
	mes "是牧师模式的第一名，完成时间为";
	mes "完成时间为 ^3131FF"+.@pritopbun+" 分钟";
	mes "^3131FF"+.@pritopcho+" 秒。谢谢你";
	mes "参加竞技场。";
	close;

OnInit:
	if ($arn_acotopn$ == "") {
		set $arn_pritop60, 480;
		set $arn_pritop70, 480;
		set $arn_pritop80, 480;
		set $arn_pritop90, 480;
		set $arn_acotop, 480;
		set $arn_pritopn60$, "Default";
		set $arn_pritopn70$, "Default";
		set $arn_pritopn80$, "Default";
		set $arn_pritopn90$, "Default";
		set $arn_acotopn$, "Default";
	}
	end;
}


-	script	#Vendigos	-1,{
OnLineRec_aco:
	mapannounce "arena_room","Vendigos: "+$arn_acotopn$+" has made a new record in the Arena Time Force Battle - Acolyte Mode. Congratulations!",bc_map,"0xFFFF00";
	end;

OnLineRec_pri60:
	mapannounce "arena_room","Vendigos: "+$arn_pritopn60$+" has made a new record in the Arena Time Force Battle - Priest: Level 70 or lower. Congratulations!",bc_map,"0xFFFF00";
	end;

OnLineRec_pri70:
	mapannounce "arena_room","Vendigos: "+$arn_pritopn70$+" has made a new record in the Arena Time Force Battle - Priest: Level 80 or lower. Congratulations!",bc_map,"0xFFFF00";
	end;

OnLineRec_pri80:
	mapannounce "arena_room","Vendigos: "+$arn_pritopn80$+" has made a new record in the Arena Time Force Battle - Priest: Level 90 or lower. Congratulations!",bc_map,"0xFFFF00";
	end;

OnLineRec_pri90:
	mapannounce "arena_room","Vendigos: "+$arn_pritopn90$+" has made a new record in the Arena Time Force Battle - Priest: Level 91~"+(checkre(0)?"160":"99")+". Congratulations!",bc_map,"0xFFFF00";
	end;
}

arena_room,140,136,3	script	Guide Alias	729,{
	mes "[Alias]";
	mes "你好，我来这里是为了";
	mes "向你介绍";
	mes "伊兹鲁德竞技场的";
	mes "服事职业模式。";
	mes "我叫 Alias，";
	mes "是你的竞技场向导。";
	next;
	mes "[Alias]";
	mes "服事职业模式下有两种模式：";
	mes "^3131FF服事者模式^000000和";
	mes "^3131FF牧师模式^000000。无论哪种模式，";
	mes "你都需要在^3131FF服事职业等候室^000000内等待。";
	mes "";
	next;
	mes "[Alias]";
	mes "轮到你时，";
	mes "你会被送出等候室，";
	mes "并被引导到竞技场。哦，";
	mes "入场费是 1,000 Zeny。";
	mes "";
	next;
	mes "[Alias]";
	mes "你最好知道，服事职业模式中的";
	mes "红色植物和佩米特会掉落物品";
	mes "并提供经验值。";
	mes "不过其他魔物不会。";
	mes "";
	mes "";
	next;
	mes "[Alias]";
	mes "被引导到真正的竞技场后，";
	mes "听取 ^3131FFTrocco^000000 说明任务目标，";
	mes "你必须在^3131FF 8 分钟^000000内完成。别忘了～";
	mes "";
	mes "";
	next;
	mes "[Alias]";
	mes "完成整个阶段后，你会被传送到";
	mes "^3131DD决赛等候室^000000，";
	mes "在那里领取竞技场点数奖励。";
	mes "但必须在 1 分钟内领取点数。";
	mes "";
	next;
	mes "[Alias]";
	mes "你被自动送出决赛等候室后，";
	mes "如果没有在那里领取竞技场点数，";
	mes "就没有机会再领取了，";
	mes "所以要小心～";
	mes "";
	mes "";
	next;
	mes "[Alias]";
	mes "希望你享受服事者模式竞技场！";
	mes "祝你好运，战斗愉快！";
	close;
}

arena_room,195,5,3	script	log-on-aco#arena	802,{
	set .@i, callfunc("F_GM_NPC",1357,0);
	if (.@i == -1) {
		mes "^3355FF密码错误。^000000";
		close;
	} else if (.@i == 0) {
		end;
	} else {
		mes "[!!CAUTION!!]";
		mes "^3355FF以下菜单用于查看";
		mes "竞技场服事职业模式中";
		mes "指定模式的记录。^000000";
		mes "";
		next;
		switch(select("取消:服事者:～70 级:～80 级:～90 级:～"+(checkre(0)?"160":"99")+"级"))) {
		case 1:
			mes "^3355FF命令已";
			mes "取消。^000000";
			close;
		case 2:
			set $arn_acotop, 480;
			set $arn_acotopn$, "Default";
			break;
		case 3:
			set $arn_pritop60, 480;
			set $arn_pritopn60$, "Default";
			break;
		case 4:
			set $arn_pritop70, 480;
			set $arn_pritopn70$, "Default";
			break;
		case 5:
			set $arn_pritop80, 480;
			set $arn_pritopn80$, "Default";
			break;
		case 6:
			set $arn_pritop90, 480;
			set $arn_pritopn90$, "Default";
			break;
		}
		close;
	}
}

arena_room,195,10,3	script	acolink#arena	802,{
	set .@i, callfunc("F_GM_NPC",1357,0);
	if (.@i == -1) {
		mes "命令已";
		mes "取消。";
		close;
	} else if (.@i == 0) {
		end;
	} else {
		mes "这个 NPC 负责开启和关闭";
		mes "竞技场服事职业模式的传送门。";
		mes "请从菜单中选择";
		mes "一个选项。";
		mes "";
		next;
		switch(select("取消:开启传送:关闭传送")) {
		case 1:
			mes "命令已";
			mes "取消。";
			close;
		case 2:
			enablenpc "onlyaco#arena";
			mes "传送门";
			mes "即将开启。";
			close;
		case 3:
			disablenpc "onlyaco#arena";
			mes "传送门";
			mes "即将关闭。";
			close;
		}
	}
}

//===== rAthena Script ======================================= 
//= Hunter Skills Quests
//===== By: ================================================== 
//= Lupus, Reddozen, Kisuka
//===== Current Version: ===================================== 
//= 1.4
//===== Compatible With: ===================================== 
//= rAthena Project
//===== Description: ========================================= 
//= [Official Conversion]
//= Quests for skills: Phantasmic Arrow
//===== Additional Comments: ================================= 
//= 1.0 for fully working skills only [Lupus]
//= 1.1 Added more new skill quests for more classes [Lupus]
//=     Somehow eA engine doesn't let you keep learn't skill V_V'
//= 1.2 Added to correct locations, correct NPC's, fixed
//=     some of the items required and made them into real
//=     quests. [Reddozen] 
//= 1.3 Fixed bugs and minor typos. Optimized [Lupus]
//= 1.3a fixed an item ID typo, thx 2Spiritual Kid
//= 1.3b Splitted into different files [DracoRPG]
//= 1.3c Fixed some typos [IVBela]
//= 1.3d Changed NPC Name to the official [Lupus]
//= 1.4 Moved Arpesto from tu_archer and added his script. [Kisuka]
//============================================================

pay_arche,109,169,3	script	Arpesto	712,{
	if (BaseJob == Job_Hunter) {
		if (qskill_hunter == 100) {
			if (getskilllv("HT_PHANTASMIC")) {
				mes "[Arpesto]";
				mes "嗯，如果你刚才的攻击不小心擦到我时我反应太大，抱歉。只是我训练得太认真，血糖很低，又很疲劳……";
				next;
				mes "[Reidin Corse]";
				mes "哈！承认吧，老头！你只是害怕了！而我嘛……";
				emotion ET_KIK, getnpcid(0, "Reidin Corse#tu");
				next;
				mes "[Arpesto]";
				mes "你这个小毛孩子！我不知道你在说什么！";
				close;
			} else {
				mes "[Arpesto]";
				mes "我好像在哪里见过你。雷丁，你记得这个人吗？";
				next;
				mes "[Reidin Corse]";
				mes "拜托，我们见过几百名弓箭手、猎人和神射手……我不可能全记住。不过我想这家伙够格，相信我！";
				next;
				mes "[Arpesto]";
				mes "好，好。如果雷丁认为你够格，那你应该确实够格。这样的话，我愿意教你我的秘密技能‘幻影箭’。";
				next;
				mes "[Reidin Corse]";
				mes "等等。这个人只需要复习。我很确定你以前来这里学过这个技能。对，我有这种直觉。";
				next;
				mes "[Arpesto]";
				mes "该死，只是复习？那你可以免费学习。好吧……你现在应该能使用幻影箭了。旅途小心，听到了吗？";
				skill "HT_PHANTASMIC",1,SKILL_PERM;
				close;
			}
		}
		else if (qskill_hunter == 1) {
			if (countitem(724) > 4 && countitem(7115) > 4 && countitem(537) > 29) {
				mes "[Arpesto]";
				mes "嗯？你回来了？哦，你把东西都带来了？啊，确实带来了。好！现在我要展示我的超级秘密技能……阿佩斯托第一式！";
				next;
				mes "[Reidin Corse]";
				mes "等等！等等……你一开始不是叫它阿佩斯托第三式吗？";
				emotion ET_SWEAT, getnpcid(0, "Reidin Corse#tu");
				next;
				mes "[Arpesto]";
				mes "呃，是的，阿佩斯托第三式，没错。只是式子太多了……总之，我来教你‘紧急箭’技能。";
				next;
				mes "[Reidin Corse]";
				mes "等等！‘紧急箭？！’那不是你给这个技能起的旧名字吗？你不是改名了吗？";
				emotion ET_HUK;
				next;
				emotion ET_HUK;
				mes "[Arpesto]";
				mes "你到底在说——";
				next;
				mes "[Arpesto]";
				mes "哦，你说得对。我们同意那个名字太俗了。现在叫什么来着？嗯……‘幻影箭？’";
				emotion ET_THINK;
				next;
				mes "[Arpesto]";
				mes "...";
				mes "......";
				emotion ET_CRY;
				next;
				mes "[Reidin Corse]";
				mes "嗯……嗯嗯……";
				next;
				mes "[Reidin Corse]";
				mes "对，就是这个！‘^3131FF幻影箭^000000’比你想出的另一个名字酷多了！";
				emotion ET_AHA, getnpcid(0, "Reidin Corse#tu");
				next;
				mes "[Arpesto]";
				mes "你有时还挺有用的，雷丁。回到正题。我来教你厉害的幻影箭。现在……准备好身心！";
				next;
				mes "[Arpesto]";
				mes "幻——！影——！箭——！";
				next;
				mes "[Arpesto]";
				mes "箭——！";
				specialeffect EF_FLASHER;
				specialeffect2 EF_FLASHER;
				next;
				mes "[Arpesto]";
				mes "^333333*喘气*^000000 好了，我用特殊技巧把技能直接教进你的脑子。你现在应该能用了。试试看吧？";
				next;
				mes "^3355FF*Swwwwwww!*";
				mes "*Bang!*^000000";
				specialeffect EF_HIT2;
				emotion ET_HUK;
				emotion ET_HUK, playerattached();
				next;
				mes "[Arpesto]";
				mes "^333333*Pant Pant*";
				mes "*Cough Cough*";
				mes "*Cough Cough*^000000";
				next;
				mes "[Arpesto]";
				mes "为——什——么——是——我？！";
				emotion ET_HUK, getnpcid(0, "Reidin Corse#tu");
				next;
				mes "^3355FF*Thump*^000000";
				next;
				mes "[Reidin Corse]";
				mes "阿、阿佩斯托，不要！……哦，拜托！箭只是擦过你！你会没事的。别像个孩子。";
				next;
				mes "[Reidin Corse]";
				mes "呃，别担心阿佩斯托。他只是个疯狂的老头。我会照顾他，你只要好好使用新技能。保重~";
				delitem 724,5; //Cardinal_Jewel_
				delitem 7115,5; //Harpy's_Feather
				delitem 537,30; //Pet_Food
				set qskill_hunter,100;
				skill "HT_PHANTASMIC",1,SKILL_PERM;
				close;
			} else {
				mes "[Arpesto]";
				mes "快带来^3131FF5 个诅咒红宝石^000000、^3131FF30 个宠物食品^000000和^3131FF5 根鹰身女妖羽毛^000000。这样我就能教你紧急箭技能。";
				close;
			}
		}
		else {
			if (getskilllv("HT_PHANTASMIC")) {
				mes "[Arpesto]";
			mes "啊，很好。嗯，正如你刚才演示的，我的教学技巧完美无缺。不过下次请把技能用在该被打败的敌人身上，好吗？很好。";
				set qskill_hunter,100;
				close;
			}
			if (BaseJob == Job_Hunter && JobLevel < 40) {
				mes "[Arpesto]";
				mes "是师父派你来的吗？嗯……看起来你还很生疏。是的，我现在还没什么能教你的。";
				next;
				mes "[Arpesto]";
				mes "再训练一阵，积累更多职业经验。等你更擅长狩猎，就能理解我教给猎人和神射手的东西。";
				close;
			} else {
				mes "[Arpesto]";
				mes "是师父派你来的吗？啊，你确实拥有真正猎人般敏锐的秃鹫之眼。你应该能学会我的秘密技能，阿佩斯托第三式……";
				next;
				mes "[Arpesto]";
				mes "这是我与美杜莎战斗、箭矢耗尽时开发的实用技能。我称它为‘^3131FF紧急箭^000000’。你有兴趣学习吗？";
				next;
				switch(select("好的，请教我！:嗯……")) {
				case 1:
					mes "[Arpesto]";
					mes "太好了。当然，认识到这项技能的价值后你无法拒绝。不过，教你技能需要收取一点学费。";
					next;
					mes "[Arpesto]";
					mes "虽然向同为猎人的你收费让我愧疚，但创造这项技能让我付出了巨大牺牲和难以想象的鲜血……";
					next;
					mes "[Reidin Corse]";
					mes "嘿！你这个骗子！你无聊时摆弄弓箭，偶然编出那个技能时我就在场！";
					emotion ET_KIK, getnpcid(0, "Reidin Corse#tu");
					next;
					emotion ET_HUK;
					mes "[Arpesto]";
					mes "^333333*咳咳*^000000 雷丁，请别传播没有根据的传闻。我是在与虎王无数次战斗后，才发明并完善紧急箭的。";
					next;
					mes "[Reidin Corse]";
					mes "^333333*啧啧*^000000 嗯。我记得你说过是在与美杜莎战斗时开发的。";
					next;
					mes "[Arpesto]";
					mes "总、总之，请带来以下物品作为学费，换取我教你这项技能。";
					next;
					mes "[Arpesto]";
					mes "请带给我^3131FF5 个诅咒红宝石^000000、^3131FF30 个宠物食品^000000和^3131FF5 根鹰身女妖羽毛^000000。这样我就能教你这项技能。";
					next;
					mes "[Reidin Corse]";
					mes "30 个宠物食品？你要那么多做什么？";
					next;
					mes "[Arpesto]";
					mes "我……我要用它喂我的宠物猎鹰。";
					next;
					mes "[Reidin Corse]";
					mes "...";
					mes "......";
					mes ".........";
					mes "......Riiiight.";
					emotion ET_THINK, getnpcid(0, "Reidin Corse#tu");
					set qskill_hunter,1;
					close;
				case 2:
					mes "[Arpesto]";
				mes "好吧，由你决定。不过我相信你迟早会非常需要我的技能，改变主意后再回来找我。";
					close;
				}
			}
		}
	} else {
		mes "[Arpesto]";
		mes "天空仍然晴朗，但最近吹过大地的风似乎带着不祥的气息。";
		next;
		emotion ET_HNG, getnpcid(0, "Reidin Corse#tu");
		mes "[Reidin Corse]";
		mes "所以……危险要来了吗？嘿！放松点，老头~交给我吧！";
		next;
		emotion ET_PROFUSELY_SWEAT;
		mes "[Arpesto]";
		mes "呵呵……精力充沛，却很自大。现在的年轻人啊……";
		close;
	}
}

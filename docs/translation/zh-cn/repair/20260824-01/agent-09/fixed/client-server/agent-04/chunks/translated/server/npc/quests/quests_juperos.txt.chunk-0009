//============================================================
// Elevator Reception Room
//============================================================
	jupe_ele_r,51,98,0	script	Switch#ufe	844,{
		if ($@JupeElevatorInUse == 1) {
		mes "^3355FF这似乎是某种";
		mes "杠杆，看起来像是";
		mes "已经被别人拉过。^000000";
		mes "";
	close;
	}
		else {
		cutin "5",2;
		mes "^3355FF这似乎是某种";
		mes "杠杆旁";
		mes "有四个空插槽。^000000";
		next;
		switch(select("拉动杠杆:别管它")) {
			case 1:
			mes "^3355FF*咔嚓 咔嚓*^000000";
			next;
			mes "^3355FF你拉动杠杆，";
			mes "但什么也没发生。";
			mes "也许需要把正确物品";
			mes "插入插槽";
			mes "才能让杠杆";
			mes "运作。^000000";
			next;
				if (countitem(7356) > 0 && countitem(7359) > 0 && countitem(7357) > 0 && countitem(7358) > 0) {
				switch(select("插入全部纹章碎片。")) {
					case 1:
					mes "^3300FF*咔嚓！*^000000";
					mes "^3300FF奇怪的是，";
					mes "四块纹章";
					mes "碎片完美嵌入";
					mes "插槽并开始";
					mes "发出奇怪光芒。^000000";
					cutin "5-1",2;
					specialeffect EF_SPHERE;
					delitem 7356,1; //Piece_Of_Crest1
					delitem 7359,1; //Piece_Of_Crest4
					delitem 7357,1; //Piece_Of_Crest2
					delitem 7358,1; //Piece_Of_Crest3
					next;
					switch(select("取出纹章碎片:拉动杠杆")) {
						case 1:
						cutin "5",2;
						mes "^3355FF你取出所有";
						mes "";
						mes "插入插槽的";
						mes "纹章碎片。^000000";
						getitem 7356,1; //Piece_Of_Crest1
						getitem 7359,1; //Piece_Of_Crest4
						getitem 7357,1; //Piece_Of_Crest2
						getitem 7358,1; //Piece_Of_Crest3
						close2;
						cutin "5",255;
					end;
						case 2:
							if ($@JupeElevatorInUse == 1) {
							mes "^3355FF奇怪，";
							mes "但这个杠杆";
							mes "已经被拉过。^000000";
							close2;
							cutin "5",255;
						end;
						}
							else {
							mes "^3355FF拉动杠杆后，纹章碎片插槽";
							mes "会突然被覆盖，";
							mes "无法取回，";
							mes "地面开始剧烈震动";
							mes "这不正常！";
							mes "^000000";
							next;
							set $@JupeElevatorInUse,1;
							disablenpc "Switch#ufe";
							enablenpc "Switch On#ufe";
							initnpctimer;
							specialeffect2 EF_SCREEN_QUAKE;
							soundeffectall "earth_quake.wav",0;
							close2;
							cutin "5-1",255;
						end;
					}
				}
			}
			}
				else if (countitem(7356) > 0 || countitem(7359) > 0 || countitem(7357) > 0 || countitem(7358) > 0) {
				select("Insert Crest Pieces.");
				mes "^3355FF现在你没有足够的";
				mes "纹章碎片";
				mes "放入四个插槽。";
				mes "^FFFFFF ^3355FF你需要找到全部碎片才能启动。^000000";
				close2;
				cutin "5-1",255;
			end;
			}
				else {
				mes "^3355FF你需要找到";
				mes "某种物品";
				mes "放入";
				mes "四个插槽……^000000";
				close2;
				cutin "5-1",255;
			end;
		}
			case 2:
			mes "^3355FF谁知道这个杠杆";
			mes "会做什么？";
			mes "除非你有勇气尝试，";
			mes "否则永远不会知道。^000000";
			close2;
			cutin "5",255;
		end;
	}
	}
end;

	OnTimer2000:
	mapannounce "jupe_ele_r","我的后代……",bc_map,"0x66FF00";
end;

	OnTimer3000:
	mapannounce "jupe_ele_r","想知道这座城市为何被埋在地下吗……？",bc_map,"0x66FF00";
end;

	OnTimer7000:
	mapannounce "jupe_ele_r","那就跟随我的声音……",bc_map,"0x66FF00";
end;

	OnTimer10000:
	mapannounce "jupe_ele_r","我会让你亲眼看看你想知道的事……",bc_map,"0x66FF00";
end;

	OnTimer17000:
	mapannounce "jupe_ele_r","克服所有幻觉。",bc_map,"0xCC6600";
end;

	OnTimer20000:
	mapannounce "jupe_ele_r","睁开眼睛，看穿所有谎言。",bc_map,"0xFF0000";
end;

	OnTimer23000:
	mapannounce "jupe_ele_r","我只能为你维持这个幻象 20 分钟。",bc_map,"0xFF0000";
	donpcevent "Elevator Guard1#ufe::OnEnable";
end;

	OnTimer27000:
	mapannounce "jupe_ele_r","看吧！记住这一切！",bc_map,"0xFF0000";
	stopnpctimer;
end;
}


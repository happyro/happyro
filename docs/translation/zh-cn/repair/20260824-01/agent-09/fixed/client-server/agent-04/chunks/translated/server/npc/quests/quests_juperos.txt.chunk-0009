	jupe_area2,51,162,0	script	Lever#ufe2	844,{
	mes "^3355FF这是一个";
	mes "功能";
	mes "未知的杠杆。^000000";
	next;
	switch(select("拉动:取消。")) {
		case 1:
		if ($@JupreArea2InUse == 1) close;
		initnpctimer;
		donpcevent "LeverWarp#ufe2::OnEnable";
		disablenpc "Lever#ufe2";
	close;
		case 2:
		mes "[" + strcharinfo(0) + "]";
		mes "拉这个杠杆？";
		mes "我甚至不知道";
		mes "会发生什么……";
	close;
	}
close;

	OnTimer3000:
	enablenpc "Lever#ufe2";
	stopnpctimer;
end;
}


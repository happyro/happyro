		mes "某种物品……^000000";
		close2;
		cutin "4",255;
		end;
	}
	end;

OnStop_Timer:
	stopnpctimer;
	end;

OnTimer5000:
	stopnpctimer;
	enablenpc "#hole#2-4";
	disablenpc "Red Alarm#2-4";
	end;
}



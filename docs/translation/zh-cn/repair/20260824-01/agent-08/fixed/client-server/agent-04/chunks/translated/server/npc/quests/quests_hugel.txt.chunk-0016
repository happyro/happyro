hugel,91,152,1	script	Sign	837,{
	mes "**招募公告**";
	mes " ";
	if (hg_odin < 60) {
		mes "现招募奥丁神殿远征队员。";
		mes "欢迎有志者报名。";
		mes " ";
		mes "- 神殿远征部";
		if (!hg_odin) set hg_odin,1;
		close;
	}
	mes "加入我们的魔法师社区，";
	mes "让每一天都成为节日！";
	mes "一起交流魔法。";
	mes " ";
	mes "- 胡格尔魔法师社区";
	close;
}

hu_in01,19,161,0	script	Alex	803,{
	if (!hg_odin) {
		mes "[Alex]";
		mes "不管你想卖给我什么，";
		mes "我都没兴趣！";
		mes "现在离开这里！";
		mes "别来打扰我。";
		close;
	} else if (hg_odin == 1) {
		cutin "hu_alex01.bmp",2;
		mes "[Alex]";
		mes "嗯……？";
		mes "你想做什么？";
		next;
		switch(select("打扰了……:我看到了招募公告……")) {
		case 1:
			mes "[Alex]";
			mes "不管你想卖给我什么，";
			mes "我都没兴趣！";
			mes "现在离开这里！";
			mes "别来打扰我。";
			close2;
			cutin "",255;
			end;
		case 2:
			mes "[Alex]";
			mes "哦，你看到了";
			mes "奥丁神殿远征的招募公告，对吧？";
			if (BaseLevel > 59) {
				mes "嗯……好吧，你看起来";
				mes "足够强壮。";
				mes "我认为你符合条件。";
				next;
			} else {
				cutin "hu_alex02.bmp",2;
				mes "嗯，我不知道。我觉得那种远征";
				mes "会把你活活吞掉。";
				mes "别介意，我只是实话实说……";
				next;
				mes "[Alex]";
				mes "这样吧，等你再训练一阵、";
				mes "提升技能、变得更强后，";
				mes "我会重新考虑你是否合格。";
				mes "不过现在我们还不能录用你。";
				close2;
				cutin "",255;
				end;
			}
			break;
		}
		cutin "hu_alex03.bmp",2;
		mes "[Alex]";
		mes "我是亚历克斯·赫尔穆特，负责这次远征。";
		mes "看到那边那个人了吗？";
		mes "那是我的弟弟朱利安，";
		mes "他也在参与挖掘工作。";
		next;
		mes "[Alex]";
		mes "我们这次挖掘的主要目标是";
		mes "挖掘的主要目标是取出";
		mes "神殿内部极其珍贵的物品。";
		mes "不过如果不够强，进入那里非常危险。";
		mes "请务必小心。";
		next;
		mes "[Alex]";
		mes "总之，如果你想帮助我们，";
		mes "请先参观神殿，看看是否愿意为我们工作。";
		mes "和船夫谈谈，";
		mes "乘船前往神殿，好吗？";
		mes "回来后再告诉我。";
		mes "我会等你的消息。";
		set hg_odin,2;
		setquest 11000;
		close2;
		cutin "",255;
		end;
	} else if (hg_odin == 2) {
		cutin "hu_alex03.bmp",2;
		mes "[Alex]";
		mes "你真的应该先亲自";
		mes "去看看神殿。";
		mes "只要和船夫谈谈，";
		mes "他就会带你过去。";
		mes "别忘了回来。";
		close2;
		cutin "",255;
		end;
	} else if (hg_odin == 3) {
		cutin "hu_alex01.bmp",2;
		mes "[Alex]";
		mes "哦，你已经去过";
		mes "神殿了。";
		mes "那么愿意帮助我们的远征吗？";
		mes "请认真考虑。";
		next;
		switch(select("隔壁房间里的人是谁？:嗯……:是的，我愿意。")) {
		case 1:
			cutin "hu_alex02.bmp",2;
			mes "[Alex]";
			mes "哦……他们啊。";
			mes "名义上是我的同事，";
			mes "但说实话，是卢恩-米德加兹王国";
			mes "强行安排给我的。";
			mes "也没办法……";
			mes "只能暂时合作。";
			next;
			mes "[Alex]";
			mes "总之，为了国际关系之类的蠢事，";
			mes "我必须接受他们。";
			mes "他们说来这里是为了研究宗教遗物，";
			mes "但我就是不信任他们。";
			mes "总觉得另有目的。";
			next;
			cutin "hu_alex04.bmp",2;
			mes "[Alex]";
			mes "事实上，我觉得很明显，";
			mes "他们来这里另有目的，";
			mes "只是我还不知道是什么。";
			mes "还有那个灰发女人……";
			mes "她让我浑身不舒服！";
			close2;
			cutin "",255;
			end;
		case 2:
			mes "[Alex]";
			mes "是啊，我知道这可能是个艰难的决定。";
			mes "慢慢考虑吧。";
			mes "我理解你必须权衡风险和其他因素。";
			mes "不要急着答复。";
			mes "安全最重要。";
			mes "考虑清楚再来。";
			close2;
			cutin "",255;
			end;
		case 3:
			mes "[Alex]";
			mes "太好了！那么你的第一个任务是";
			mes "从神殿带回";
			mes "^3355FF5 个黑暗符文^000000。";
			mes "别担心，我会确保";
			mes "你的努力得到奖励。";
			mes "现在就出发吧。";
			set hg_odin,4;
			changequest 11000,11001;
			next;
			mes "[Alex]";
			mes "这是证明你可靠、";
			mes "有责任感的机会。";
			mes "完成后，我们再进行";
			mes "更重要的工作。";
			mes "千万别失败。";
			mes "我期待你的表现。";
			close2;
			cutin "",255;
			end;
		}
	} else if (hg_odin == 4) {
		cutin "hu_alex02.bmp",2;
		mes "[Alex]";
		mes "你怎么还在这里？";
		mes "不是应该已经";
		mes "前往神殿了吗？";
		mes "快去吧。";
		next;
		switch(select("我应该收集什么？:我这就走，这就走！")) {
		case 1:
			cutin "hu_alex03.bmp",2;
			mes "[Alex]";
			mes "你已经忘了吗？";
			mes "我让你带回^3355FF5 个黑暗符文^000000。";
			mes "好了，现在快去完成。";
			mes "不要浪费时间。";
			mes "快点行动。";
			close2;
			cutin "",255;
			end;
		case 2:
			mes "[Alex]";
			mes "好吧……";
			mes "不过记住我们已经落后进度。";
			mes "要是那个灰发老太婆不在这里……";
			mes "我们现在早就完成了！";
			mes "别让我继续等。";
			mes "快去神殿。";
			close2;
			cutin "",255;
			end;
		}
	} else if (hg_odin == 5) {
		cutin "hu_alex01.bmp",2;
		mes "[Alex]";
		mes "嗯，你终于回来了。";
		mes "你把^3355FF5 个黑暗符文^000000带来了吗？";
		mes "我一直在等。";
		mes "别让我失望。";
		next;
		switch(select("呃，还没有……:给你！")) {
		case 1:
			cutin "hu_alex02.bmp",2;
			mes "[Alex]";
			mes "什、什么？！";
			mes "你来这里就为了告诉我这个？";
			mes "完成后再回来，";
			mes "别浪费我的时间！";
			mes "快去收集。";
			next;
			emotion ET_DELIGHT, getnpcid(0, "Julian");
			mes "[Julian]";
			mes "嘿，亚历克斯，你知道吗？";
			mes "你不能这样对待别人。";
			mes "而且这位冒险者";
			mes "也不是好欺负的，对吧？";
			next;
			cutin "hu_alex03.bmp",2;
			emotion ET_FRET;
			mes "[Alex]";
			mes "你说什么……？";
			mes "朱利安，你想惹我生气吗？";
			mes "别再插嘴了。";
			next;
			cutin "hu_alex02.bmp",2;
			mes "[Julian]";
			mes "我只是说，大多数冒险者都知道";
			mes "你给不起与他们价值相称的报酬。";
			mes "所以他们才不断进出隔壁房间，";
			mes "你明白的。";
			mes "别把责任推给别人。";
			next;
			cutin "hu_alex04.bmp",2;
			mes "[Alex]";
			mes "那个……灰……发女人……！";
			mes "N-no... Calm down, Alex...";
			mes "失去理智就会失去一切……";
			mes "别、别把自己降到她的水平。";
			mes "冷静下来。";
			next;
			cutin "hu_alex01.bmp",2;
			mes "[Alex]";
			mes "好吧，我没资格要求你……";
			mes "但如果你能尽快带来";
			mes "5 个黑暗符文，";
			mes "我会非常感激。";
			mes "拜托了。";
			mes "越快越好。";
			close2;
			cutin "",255;
			end;
		case 2:
			if (countitem(7511) > 4) {
				delitem 7511,5; //Rune_Of_Darkness
				set hg_odin,6; //Old_Blue_Box
				changequest 11001,11002;
				getitem 603,1;
				mes "[Alex]";
				mes "哦！非常感谢，";
				mes "这些符文一定能帮助我们的研究。";
				mes "我知道这不算什么，";
				mes "但请收下这个旧蓝箱。";
				mes "这是给你的奖励。";
				mes "希望你喜欢。";
				next;
				mes "[Julian]";
				mes "等等……";
				mes "研究？";
				mes "你什么时候开始";
				mes "做研究了？";
				next;
				cutin "hu_alex03.bmp",2;
				mes "[Alex]";
				mes "天啊，朱利安，";
				mes "你能不能暂时";
				mes "闭嘴一会儿？";
				next;
				mes "[Julian]";
				mes "为什么？所有杂活和真正的研究";
				mes "都是我在做。";
				mes "你以为自己只负责‘监督’";
				mes "就很了不起吗……";
				mes "别太自大。";
				next;
				cutin "hu_alex04.bmp",2;
				mes "[Alex]";
				mes "J-Julian!";
				next;
				mes "[Julian]";
				mes "对，对，我们有客人。";
				mes "好吧，刚才真抱歉。";
				mes "请别介意。";
				next;
				cutin "hu_alex02.bmp",2;
				mes "[Alex]";
				mes "很抱歉发生这些。";
				mes "如果你不介意，";
				mes "我们会继续研究，";
				mes "希望能完成我们的工作。";

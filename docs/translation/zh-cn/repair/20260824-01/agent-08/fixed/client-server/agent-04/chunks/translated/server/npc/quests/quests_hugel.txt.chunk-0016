		break;
	}
	close2;
	if (checkquest(12042) > -1) erasequest 12042;
	end;
}

hugel,68,99,3	script	Booboo the Cow	889,{
	if (hg_milk == 7 || hg_milk == 12) {
		mes "[布布]";
		mes "哞哞哞～";
		mes "布布哞！";
		next;
		mes "^804000布布这头牛";
		mes "";
		mes "似乎有话";
		mes "想告诉你。^000000";
		next;
		switch(select("尝试给布布挤奶:现在不是时候！")) {
		case 1:
			if (countitem(645) > 2) {
				switch(rand(1,5)) {
					case 1: callsub L_MilkCow,"cow_01.wav",3; break;
					case 2: callsub L_MilkCow,"cow_02.wav",5; break;
					case 3: callsub L_MilkCow,"cow_03.wav",10; break;
					case 4: callsub L_MilkCow,"cow_04.wav",0; break;
					case 5: callsub L_MilkCow,"cow_05.wav",1; break;
				}
				end;
			}
			mes "^3355FF要用这把梳子";
			mes "梳毛时，";
			mes "需要放入";
			mes "3 瓶集中药水。";
			mes "你只能用这把豪华魔法梳子";
			mes "给布布梳毛。^000000";
			close;
		case 2:
			mes "^3355FF也许你应该先了解";
			mes "了解她的心情，";
			mes "";
			mes "再尝试给她挤奶。^000000";
			close;
		}
	}
	mes "[布布]";
	mes "哞～哞！！";
	mes "布布布布 哞～～～";
	mes "布布哞～";
	close;

L_MilkCow:
	mes "^3355FF这把巨型魔法梳子";
	mes "是从吉芬";
	mes "魔法学院特别订购的，设计为";
	mes "放入";
	mes "3 瓶集中药水";
	mes "特殊插槽后运行。^000000";
	next;
	mes "^3355FF放入";
	mes "3 瓶集中药水";
	mes "梳子后，它开始";
	mes "发出铃声，布布";
	mes "^FFFFFF ^3355FF开始在赫格尔中心表达感情。^000000";
	delitem 645,3; //Center_Potion
	soundeffect ""+getarg(0)+"",0;
	next;
	soundeffect ""+getarg(0)+"",0;
	mes "^3355FF现在轮到你";
	mes "给她梳毛。";
	mes "根据她的心情，";
	mes "需要梳";
	mes "指定次数。^000000";
	next;
	input .@cowbrush;
	if (.@cowbrush != getarg(1)) {
		soundeffect "taming_fail.wav",0;
		mes "^3355FF啊……";
		mes "看起来";
		mes "非常失望，";
		mes "与世界隔绝……^000000";
		mes "";
		mes "";
		close;
	}
	soundeffect "cow_06.wav",0;
	mes "^3355FF";
	mes "看起来很满足，";
	mes "正在唱小夜曲。^000000";
	next;
	soundeffect "cow_06.wav",0;
	mes "[布布夫人]";
	switch(rand(1,6)) {
	case 1:
		set .@cowsong$,"Brrbrr";
		mes "^ff0000Brr~ Brrboo~ Boobooboo~^000000";
		mes "^0000ffBrrrrrr~ Booboo~ Boorrboo~^000000";
		mes "^ff0000Booruboorubrr~ Rrrrboo~^000000";
		mes "^0000ffRrrr~ Booboorrrr~ Boobooru~^000000";
		mes "^ff0000Boobooboo~ Rururu~ Booruboorub~^000000";
		mes "^0000ffBoo! B! Boo~~~^000000";
		break;
	case 2:
		set .@cowsong$,"Brrrrrr";
		mes "^ff0000Brr~ Brrboo~ Boobooboo~^000000";
		mes "^0000ffRrrururu~ Booboo~ Boorrboo~^000000";
		mes "^ff0000Booruboorubrr~ Rrrrboo~^000000";
		mes "^0000ffRrrr~ Booboorrrr~ Boobooru~^000000";
		mes "^ff0000Boobooboo~ Rururu~ Booruboorub~^000000";
		mes "^0000ffBoo! B! Boo~~~^000000";
		break;
	case 3:
		set .@cowsong$,"Rrrrboo";
		mes "^ff0000Brr~ Brrbrr~ Boobooboo~^000000";
		mes "^0000ffBrrrrrr~ Booboo~ Boorrboo~^000000";
		mes "^ff0000Booruboorubrr~ Rurub~^000000";
		mes "^0000ffRrrr~ Booboorrrr~ Boobooru~^000000";
		mes "^ff0000Boobooboo~ Rururu~ Booruboorub~^000000";
		mes "^0000ffBoo! B! Boo~^000000";
		break;
	case 4:
		set .@cowsong$,"Boobooru";
		mes "^ff0000Brr~ Brrbrr~ Boobooboo~^000000";
		mes "^0000ffBrrrrrr~ Booboo~ Boorrboo~^000000";
		mes "^ff0000Booruboorubrr~ Rrrrboo~^000000";
		mes "^0000ffRrrr~ Booboorrrr~ Bbrrrr~^000000";
		mes "^ff0000Boobooboo~ Rururu~ Booruboorub~^000000";
		mes "^0000ffBoo! B! Boo~^000000";
		break;
	case 5:
		set .@cowsong$,"Boobooboo";
		mes "^ff0000Brr~ Brrbrr~ Boobooboo~^000000";
		mes "^0000ffBrrrrrr~ Booboo~ Boorrboo~^000000";
		mes "^ff0000Booruboorubrr~ Rrrrboo~^000000";
		mes "^0000ffRrrr~ Booboorrrr~ Boobooru~^000000";
		mes "^ff0000Bbb~ Rururu~ Booruboorub~^000000";
		mes "^0000ffBoo! B! Boo~^000000";
		break;
	case 6:
		set .@cowsong$,"B";
		mes "^ff0000Brr~ Brrbrr~ Boobooboo~^000000";
		mes "^0000ffBrrrrrr~ Booboo~ Boorrboo~^000000";
		mes "^ff0000Booruboorubrr~ Rrrrboo~^000000";
		mes "^0000ffRrrr~ Booboorrrr~ Boobooru~^000000";
		mes "^ff0000Boobooboo~ Rururu~ Booruboorub~^000000";
		mes "^0000ffBoo! Boo! Boo~^000000";
		break;
	}
	next;
	mes "^3355FF快点回应布布的歌！找出那个";
	mes "与布布平时歌声略有不同的词，";
	mes "然后告诉她正确的词，不要带波浪号";
	mes "（‘～’）。^000000";
	next;
	input .@cowanswer$;
	if (.@cowanswer$ == .@cowsong$) {
		soundeffect "tming_success.wav",0;
		mes "^3355FF成功！";
		mes "";
		mes "她非常开心，";
		mes "你成功给她挤了奶。";
		mes "现在去向库鲁佩报告。^000000";
		mes "任务完成。";
		if (hg_milk == 12) set hg_milk,13;
		else set hg_milk,8;
		setquest 12043;
		close;
	}
	soundeffect "taming_fail.wav",0;
	mes "^3355FF糟糕……";
	mes "她开始";
	mes "猛烈地喷鼻息！她似乎";
	mes "非常生你的气，";
	mes "你最好暂时离开……^000000";
	close;
}


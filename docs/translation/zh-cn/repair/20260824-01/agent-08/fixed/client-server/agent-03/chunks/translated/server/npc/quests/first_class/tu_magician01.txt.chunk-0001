// Sign
//============================================================
geffen,61,174,4	script	Sign#M	HIDDEN_NPC,{
	mes "- 魔法师转职 -";
	close;
}

// New Mage Manager
//============================================================
geffen,67,180,4	script	New Mage Manager#M	8_F,{
	mes "[玛娜]";
	if(Class == Job_Novice){
		mes "你还没准备好接受我提供的";
		mes "任何训练。你需要继续训练，";
		mes "先成为";
		mes "魔法师。好吗，亲爱的？";
		mes "来吧。";
		close;
	}
	if(BaseClass != Job_Mage || (eaclass()&EAJL_BABY)){
		mes "你知道，有时";
		mes "其他职业在某些战斗情形下";
		mes "可能看起来更好，但要";
		mes "始终为自己感到";
		mes "骄傲。不是";
		mes "任何人都能做你所做的事~";
		close;
	}
	if(Class != Job_Mage && tu_magician01 < 7){
		mes "虽然我提供魔法训练，";
		mes "但如果你已经有";
		mes "魔法使用经验，帮助不大。抱歉，";
		mes "不过，";
		mes "你只能依靠自己";
		mes "磨炼技能。";
		close;
	}
	switch(tu_magician01){
	case 0:
		mes "啊，欢迎~";
		mes "我叫玛娜，";
		mes "是负责";
		mes "魔法师公会新成员的";
		mes "训练员。这意味着";
		mes "我负责指导你~";
		next;
		mes "[玛娜]";
		mes "我做这件事";
		mes "还没多久，";
		mes "但如果你想了解更多";
		mes "魔法师职业的";
		mes "基础知识，我会帮助你。";
		next;
		switch(select("你会教我吗？:以后再说……")) {
		case 1:
			mes "[玛娜]";
			mes "当然！";
			mes "别担心，";
			mes "每个人都曾是";
			mes "新手。";
			mes "你只会越来越好！";
			next;
			break;
		case 2:
			mes "[玛娜]";
			mes "好吧，我想";
			mes "一切都会顺利。";
			mes "但如果你决定";
			mes "接受指导，";
			mes "我期待再次";
			mes "见到你~";
			close;
		}
		mes "[玛娜]";
		mes "好，我们先从";
		mes "职业的一般介绍";
		mes "开始，好吗？";
		mes "魔法师究竟是什么？";
		next;
		mes "[玛娜]";
		mes "魔法师不使用身体力量，";
		mes "而是在战斗中使用";
		mes "元素力量。它们是";
		mes "^ff0000火^000000、^5C4033地^000000、^93DB70风^000000、^0000FF水^000000。";
		mes "我们还可以使用带有";
		mes "^CFB53B念^000000属性的法术。";
		next;
		mes "[玛娜]";
		mes "当敌人拥有某种";
		mes "元素属性时，会";
		mes "抵抗该元素，但容易受到其他元素伤害。";
		mes "所以了解元素属性对我们非常重要。";
		next;
		mes "[玛娜]";
		mes "仔细听这些";
		mes "元素关系。";
		mes "^FF0000火^000000克制地，";
		mes "但被水克制。";
		mes "^5C4033地^000000克制风，";
		mes "但被火克制。";
		next;
		mes "[玛娜]";
		mes "^0000FF水^000000克制";
		mes "火，但被风克制。";
		mes "最后，^93DB70风^000000克制";
		mes "水，但被地克制。";
		next;
		mes "[玛娜]";
		mes "我不记得";
		mes "上次一次性";
		mes "说这么多话是什么时候了！我累了，";
		mes "该休息了。但我们";
		mes "稍后继续，好吗？";
		mes "休息一下吧。";
		tu_magician01 = 1;
		if (checkre(3))
			getexp BaseLevel*3,BaseLevel*2;
		else
			getexp BaseLevel*30,BaseLevel*15;
		specialeffect2 EF_HIT5;
		close;
	case 1:
		mes "准备好";
		mes "继续";
		mes "讨论";
		mes "元素属性了吗？";
		next;
		mes "[玛娜]";
		mes "你应该知道";
		mes "每个怪物都有";
		mes "元素属性，而且";
		mes "每种元素都有不同等级。理解这些";
		mes "很重要……";
		mes "这些等级差异很重要。";
		next;
		mes "[玛娜]";
		mes "让我向你解释";
		mes "每种元素的";
		mes "细节。你只要告诉我";
		mes "想了解哪种";
		mes "元素即可。";
		next;
		mes "[玛娜]";
		mes "换句话说，即使是相同属性";
		mes "也有必须考虑的不同特征。";
		mes "现在我来解释属性。";
		while((1)){
			next;
			switch(select("^ff0000火^000000", "^5C4033地^000000", "^93DB70风^000000", "^0000FF水^000000", "^CFB53B念^000000", "退出。")){
			case 1:
				mes "[玛娜]";
				mes "拥有^ff0000火^000000属性的怪物";
				mes "通常攻击力很强。因为魔法师";
				mes "身体较弱，哪怕这些怪物的轻微";
				mes "攻击";
				mes "也可能";
				mes "对我们造成巨大伤害。";
				next;
				mes "[玛娜]";
				mes "所以如果必须独自对付";
				mes "^FF0000火^000000属性的怪物，";
				mes "我们可以用冰冻之枪";
				mes "把它们冻在原地。";
				mes "记住这一点。";
				next;
				mes "[玛娜]";
				mes "但如果对火属性怪物使用";
				mes "火属性技能，";
				mes "几乎不会造成伤害，";
				mes "这可不好。";
				next;
				mes "[玛娜]";
				mes "供你参考，我们的火属性技能";
				mes "包括火之领域、火箭术、火球术和";
				mes "火墙。哦，我再多讲讲火墙。";
				mes "关于火墙，";
				mes "我再多讲一点。";
				next;
				mes "[玛娜]";
				mes "火墙很特别，";
				mes "因为同一画面最多可以使用";
				mes "3次。撞上它的怪物会";
				mes "受到伤害，然后";
				mes "向相反方向";
				mes "移动。";
				next;
				mes "[玛娜]";
				mes "但如果不死怪物";
				mes "撞上火墙，";
				mes "它只会轻微受伤，火墙";
				mes "不一定能";
				mes "阻挡它前进。所以要小心！";
				.@eread_1 = 1;
				break;
			case 2:
				mes "[玛娜]";
				mes "好，^5C4033地^000000属性";
				mes "属性怪物通常";
				mes "瞄准能力很强，所以即使";
				mes "你的闪避率很高，";
				mes "也可能很难";
				mes "躲开全部攻击。";
				next;
				mes "[玛娜]";
				mes "对付这些";
				mes "怪物时使用火属性";
				mes "法术。火墙通常";
				mes "很有效，因为它会";
				mes "阻挡怪物并造成";
				mes "可观伤害。";
				next;
				mes "[玛娜]";
				mes "还要知道，使用";
				mes "石化术时，怪物会";
				mes "变成地属性，直到法术";
				mes "效果";
				mes "结束。很酷，对吧？";
				mes "很酷，对吧？";
				next;
				mes "[玛娜]";
				mes "所以如果使用石化术，";
				mes "好的策略是";
				mes "随后使用火属性技能，";
				mes "比如火箭术和";
				mes "火球术，利用";
				mes "怪物的地属性。";
				.@eread_2 = 1;
				break;
			case 3:
				mes "[玛娜]";
				mes "现在，如果你攻击";
				mes "^93DB70风^000000属性怪物时总是";
				mes "命中失败，不要惊讶。";
				mes "它们大多能凭高闪避率";
				mes "很好地躲开物理";
				mes "攻击。";
				next;
				mes "[玛娜]";
				mes "不过魔法师主要用";
				mes "法术攻击，";
				mes "不必太担心。";
				mes "但仍要小心。";
				mes "不过风属性怪物通常";
				mes "很快，要小心。";
				next;
				mes "[玛娜]";
				mes "攻击风属性怪物时，";
				mes "最好使用地属性技能。";
				mes "理想情况下，";
				mes "但只有巫师能使用";
				mes "地属性攻击，";
				mes "所以我们只能使用火属性技能。";
				next;
				mes "[玛娜]";
				mes "火属性技能可能";
				mes "伤害不高，";
				mes "但效果比风或水属性技能好，后两者几乎无法伤害风属性怪物。";
				next;
				mes "[玛娜]";
				mes "顺便说，";
				mes "我们魔法师能用的^93DB70风^000000属性技能";
				mes "是";
				mes "雷击和雷暴。";
				.@eread_3 = 1;
				break;
			case 4:
				mes "[玛娜]";
				mes "^0000FF水^000000属性怪物";
				mes "通常生命值很高，";
				mes "所以能承受更多伤害，";
				mes "让与它们的";
				mes "战斗持续更久。";
				next;
				mes "[玛娜]";
				mes "还记得我说过";
				mes "元素属性有不同等级吗？";
				mes "水属性怪物在高等级时其实更";
				mes "容易受到克制属性的伤害。";
				next;
				mes "[玛娜]";
				mes "换句话说，";
				mes "等级更高的";
				mes "水属性怪物会";
				mes "受到更多伤害";
				mes "来自风属性的攻击。";
				next;
				mes "[玛娜]";
				mes "水属性技能";
				mes "包括魔法师技能中的";
				mes "冰箭术和冰冻之枪。它们";
				mes "对火属性怪物非常";
				mes "有效。";
				next;
				mes "[玛娜]";
				mes "冰冻之枪很特别，";
				mes "因为有机会";
				mes "真正冻住怪物。";
				mes "被冰冻之枪冻住时，怪物";
				mes "会被视为水属性。很有趣吧？";
				.@eread_4 = 1;
				break;
			case 5:
				mes "[玛娜]";
				mes "现在，";
				mes "^CFB53B念^000000属性怪物";
				mes "并不多。但如果遇到它们，";
				mes "就使用你的";
				mes "念属性技能，应该";
				mes "会有效。";
				next;
				mes "[玛娜]";
				mes "魔法师能使用的念属性攻击";
				mes "是";
				mes "火焰冲击和灵魂打击。";
				mes "这些技能通常";
				mes "效果很好，但对";
				mes "高等级圣属性怪物例外。";
				next;
				mes "[玛娜]";
				mes "安全墙法术";
				mes "有点像念属性";
				mes "但很难分类。施放安全墙会创造";
				mes "一道防御";
				mes "近距离物理攻击的屏障。";
				next;
				mes "[玛娜]";
				mes "However, th包括 barrier only";
				mes "不能防御远距离";
				mes "或强属性";
				mes "攻击，";
				mes "所以一定要小心！";
				.@eread_5 = 1;
				break;
			case 6:
				mes "[玛娜]";
				mes "你确定已经";
				mes "听够了";
				mes "元素属性的";
				mes "细节吗？如果你";
				mes "准备好了，我们会学习新的";
				mes "内容。";
				next;
				if(select("等、等等，还没好！:我准备继续了。") == 2) {
					mes "[玛娜]";
					mes "好啦，我们将";
					mes "继续下一个";
					mes "继续下一个主题。呵呵呵～！";
					tu_magician01 = 2;
					specialeffect2 EF_HIT5;
					.@total = .@eread_1 + .@eread_2 + .@eread_3 + .@eread_4 + .@eread_5;
					if (.@total) getexp (.@total*150),(.@total*70);
					close;
				}
				break;
			}
		}
	case 2:
		mes "我知道元素属性的概念";
		mes "现在可能";
		mes "很让人困惑，但随着时间";
		mes "你会逐渐掌握。现在该";
		mes "深入谈谈";
		mes "魔法技能了~";
		next;
		mes "[玛娜]";
		mes "最基础的魔法攻击";
		mes "法术是火箭术、";
		mes "冰箭术、雷击和";
		mes "火焰冲击。学习它们能让魔法师";
		mes "学会更高级的";
		mes "技能。";
		specialeffect2 EF_NAPALMBEAT;
		next;
		mes "[玛娜]";
		mes "提高这些技能的等级";
		mes "不仅能解锁";
		mes "其他法术，还会";
		mes "提高基础攻击";
		mes "attack skills 包括 also increased.";
		specialeffect2 EF_LIGHTBOLT;
		next;
		mes "[玛娜]";
		mes "其他属于";
		mes "魔法师基础的技能包括";
		mes "火之领域、石化术和";
		mes "增加SP恢复。它们";
		mes "不是攻击法术，但在特定情况下很有用。";
		next;
		specialeffect2 EF_SIGHT;
		mes "[玛娜]";
		mes "火之领域用于";
		mes "发现";
		mes "隐藏的敌人。记住，技能";
		mes "请记住，这项技能的";
		mes "并不远。";
		next;
		specialeffect2 EF_STONECURSE;
		mes "[玛娜]";
		mes "石化术有机会诅咒目标，";
		mes "暂时使其无法移动，并变成";
		mes "^5C4033地^000000属性。不过每次施放";
		mes "都需要 1 颗红色宝石。";
		next;
		mes "[玛娜]";
		mes "增加 SP 恢复是一项被动技能，";
		mes "能帮助你";
		mes "你坐下休息时能恢复更多SP。它不会直接影响战斗，但SP越多越好。";
		next;
		mes "[玛娜]";
		mes "好了，我觉得我已经";
		mes "充分解释基础法术。现在，在讲解高级技能前，";
		mes "够了。在讲解高级技能前，";
		mes "我有一项训练任务要你完成。";
		mes "";
		mes "有项训练任务要你完成。";
		next;
		mes "[玛娜]";
		mes "从这里向西走，你会找到";
		mes "一座大桥，";
		mes "在那里会遇到叫做";
		mes "蛹的怪物。";
		mes "蛹不会移动，也无法";
		mes "攻击。";
		next;
		mes "[玛娜]";
		mes "猎杀这些蛹";
		mes "直到收集到";
		mes "10个蛹壳。";
		mes "然后带给我，好吗？";
		tu_magician01 = 3;
		getexp 400,200;
		specialeffect2 EF_HIT5;
		close;
	case 3:
	case 4:
		if (tu_magician01 == 3) {
			mes "啊，你回来了？";
			mes "让我看看你是否从所有蛹身上";
			mes "收集了10个蛹壳。嗯……";
			mes "";
		}
		else {
		mes "那么……";
			mes "你拿到了";
		mes "10 个蛹壳，";
			mes "从蛹身上收集的吗？";
			mes "按我的要求？希望如此……";
			mes "因为我要检查~";
		}
		next;
		mes "[玛娜]";
		if (countitem(915) < 10){// Chrysalis
			if (tu_magician01 == 3) {
				mes "哎呀，你还没有";
				mes "足够的";
				mes "数量。向西走";
				mes "猎杀蛹";
				mes "收集更多蛹壳，好吗？";
				mes "现在我先治疗你。";
				tu_magician01 = 4;
				percentheal 100,100;
			}
			else {
				mes "哇，你需要的";
		mes "不只是这些。";
				mes "我知道你能做到……";
		mes "蛹是完全没有防御能力的魔物！";
			}
		}
		else {
			mes "...Nine, ten.";
			mes "好了，你通过了！";
			mes "现在你一定更习惯";
			mes "使用技能了，对吧？";
			mes "无论如何，准备好下一课时告诉我，好吗？";
			tu_magician01 = 5;
			getexp 400,200;

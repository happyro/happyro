//===== Description: ========================================= 
//= Quest for breaking the seal of Megingjard.
//===== Additional Comments: =================================
//= 1.0 First version. Thanks to SinSloth for scripting it. [MasterOfMuppets]
//= 1.1 fixed exploit [Lupus]
//= 1.2 Fixed experience gains to match upcoming rate adjustments. [SinSloth]
//= 1.3 Updated several aspects of the script. [L0ne_W0lf]
//= 1.4 Minor Touchups to quest. [L0ne_W0lf]
//= 1.5 Fixed missing close2 in Rebarev Doug. [L0ne_w0lf]
//= 1.6 Corrected mismatched variables. [L0ne_W0lf]
//= 1.7 Replaced effect numerics with constants. [Samuray22]
//= 1.8 Corrected how exp reward is applied. [L0ne_W0lf]
//= 1.9 Fixed some input checks and variable types. [brianluau]
//= 2.0 Updated RE/Pre-RE EXP. [Euphy]
//= 2.1 Fixed minor bug with the Librarian Jekan
//= 2.2 Renewal script update. [Euphy]
//= 2.3 Renewal script update for ep16.1 [Capuche]
//============================================================

-	script	Rebarev Doug_	-1,{
	if (checkweight(1301,3) == 0) {
		mes "- 你携带的物品太多了！-";
		close;
	}
	cutin "god_rebeireb",2;
	if ((countitem(7080) > 3) && (countitem(7081) > 4) && (countitem(7082) > 3) && (countitem(7084) > 2) && (countitem(7085) > 2)) {
		mes "[Rebarev Doug]";
		mes "这是什么？你……！你带齐了制作格莱普尼尔所需的一切！";
		next;
		switch(select("制作格莱普尼尔。:取消。")) {
		case 1:
			mes "[Rebarev Doug]";
			mes "我是世上唯一拥有制作格莱普尼尔能力的人类。除了矮人，我是唯一能制作这件物品的人！";
			next;
			delitem 7080,4;  //Foot_Step_Of_Cat
			delitem 7081,5;  //Beard_Of_Women
			delitem 7082,4;  //Root_Of_Stone
			delitem 7084,3;  //Saliva_Of_Bird
			delitem 7085,3;  //Tendon_Of_Bear
			getitem 7058,1; // Gullraifnir
			mes "[Rebarev Doug]";
			mes "给你！";
			next;
			mes "[Rebarev Doug]";
			mes "据说格莱普尼尔坚固到连芬里尔之狼也无法挣断！我能制作它，实在深感自豪！";
			break;
		case 2:
			break;
		}
	}
	if ($God1 < $@god_check1) {
		mes "[Rebarev Doug]";
		mes "我们是正在训练的十字军，为即将到来的圣战做准备。";
		next;
		mes "[Rebarev Doug]";
		mes "就像祖先在一千年前所做的那样，时机到来时我们将消灭恶魔大军。";
		next;
		mes "[Rebarev Doug]";
		mes "如果你对十字军有任何疑问，尽管问我。我也许年老体弱，无法战斗，但会尽力传播我们的信念。";
		next;
		switch(select("什么是圣十字攻击？:什么是圣十字军？:什么是牺牲？:什么是格莱普尼尔？")) {
		case 1:
			mes "[Rebarev Doug]";
			mes "圣十字攻击是十字军信仰的第一种表现。通过画十字，十字军可以对敌人发动神圣攻击。";
			next;
			mes "[Rebarev Doug]";
			mes "弱于神圣属性的怪物，尤其是不死族，会被圣十字的光芒致盲，只能等待神圣审判。";
			next;
			mes "[Rebarev Doug]";
			mes "根据我们最新的研究，圣十字攻击熟练后能造成普通攻击 4.5 倍的伤害。";
			break;
		case 2:
			mes "[Rebarev Doug]";
			mes "圣十字军……！上帝的正义之怒在这项破坏性技能中化为实体。";
			next;
			mes "[Rebarev Doug]";
			mes "上帝赐予我们力量，让我们惩罚邪恶势力；个人的愤怒则化为巨大的十字架之力。";
			next;
			mes "[Rebarev Doug]";
			mes "光之十字架的力量能对敌人造成三次伤害，每次攻击都是普通攻击力量的五倍。";
			next;
			mes "[Rebarev Doug]";
			mes "不过，十字军使用圣十字军时必须格外小心。人类的身体太脆弱，无法完全承受上帝的意志。";
			next;
			mes "[Rebarev Doug]";
			mes "因此，使用这项技能会让十字军受到伤害。不过，信仰可以将伤害降低一半。";
			break;
		case 3:
			mes "[Rebarev Doug]";
			mes "十字军身体力行，选择通过承担同伴的痛苦来保护他人。";
			next;
			mes "[Rebarev Doug]";
			mes "牺牲技能让十字军承受原本会落在同伴身上的伤害，保护他们免受伤害。";
			next;
			mes "[Rebarev Doug]";
			mes "这是信仰和对同伴之爱的最高体现。这样的态度是上帝仆人不可或缺的品质！";
			next;
			mes "[Rebarev Doug]";
			mes "不过，如果你要保护的人离你太远，除非他们再次靠近，否则你无法对他们使用牺牲技能。";
			next;
			mes "[Rebarev Doug]";
			mes "只要想象着被保护者的痛苦，你就永远不会犹豫牺牲自己。";
			next;
			mes "[Rebarev Doug]";
			mes "感谢上帝赐予我保护人民的力量。";
			break;
		case 4:
			mes "[Rebarev Doug]";
			mes "格莱普尼尔是我一直研究的梅金吉奥德核心。";
			next;
			mes "[Rebarev Doug]";
			mes "只有它的束缚力足够强，能让人类把梅金吉奥德佩戴在腰间。";
			next;
			mes "[Rebarev Doug]";
			mes "虽然我已经不能战斗，但多年来一直研究格莱普尼尔的制作方法。只要你能带来以下材料，我很愿意为你制作……";
			next;
			mes "[Rebarev Doug]";
			mes "^0000FF4 个猫脚印^000000、^0000FF5 根女人胡须^000000、^0000FF4 个石头根^000000、^0000FF3 份鸟唾液^000000和^0000FF3 根熊筋^000000。";
			break;
		}
	}
	else if ($God1 >= $@god_check1 && $God2 < $@god_check2) {
		if (BaseLevel > 59) {
			if (god_eremes == 0) {
				mes "[Rebarev Doug]";
				mes "...";
				next;
				mes "[Rebarev Doug]";
				mes "你为什么在这片圣地徘徊？难道不明白我们必须为圣战做准备吗？";
				next;
				mes "[Rebarev Doug]";
				mes "无论我解释多少次，无知之人都无法完全理解我们任务的重要性。力量的平衡会在我们意想不到的时候改变！";
				next;
				mes "[Rebarev Doug]";
				mes "我真希望能回到过去训练十字军的日子，而不是向无知之人说教。";
				next;
				mes "[Rebarev Doug]";
				mes "我想念那些热心听我讲话、忠诚执行命令的十字军。";
				next;
				mes "[Rebarev Doug]";
				mes "我真想知道他们现在都去哪儿了……";
				next;
				mes "[Rebarev Doug]";
				mes "...";
				mes "......";
				mes ".........";
				next;
				mes "[Rebarev Doug]";
				mes "冒险者，既然你有时间听我自言自语，为什么不替我完成一项任务？";
				next;
				mes "[Rebarev Doug]";
				mes "这可能会成为一次充实的经历，也许还能让你更了解十字军。";
				next;
				switch(select("是什么？:我已经厌倦帮忙了。")) {
				case 1:
					mes "[Rebarev Doug]";
					mes "我希望你找到第三连第三排第一小队的成员。如果旅行中遇到他们，请问问他们过得怎么样。";
					next;
					mes "[Rebarev Doug]";
					mes "这应该不难。如果你本来就打算探索世界，也不会浪费时间。";
					next;
					switch(select("好啊，为什么不呢？:抱歉，我不做。")) {
					case 1:
						mes "[Rebarev Doug]";
						mes "太好了！我只希望你找到我的老战友，并告诉我他们过得怎么样。";
						next;
						mes "[Rebarev Doug]";
						mes "不过……有一个问题。我不知道他们在哪里。";
						next;
						mes "[Rebarev Doug]";
						mes "你可以去普隆德拉图书馆查找卢恩-米德加尔特王国居民迁徙记录……";
						next;
						mes "[Rebarev Doug]";
						mes "不过，十字军人员记录属于机密，所以我不确定你能否查看。";
						next;
						mes "[Rebarev Doug]";
						mes "你必须理解，我的职位要求我每周七天、每天二十四小时留在这里。没有上级许可，我不能离开。";
						next;
						mes "[Rebarev Doug]";
						mes "不过，我知道你有自由和时间去任何想去的地方。如果你愿意替我做这件事，我会很感激。";
						next;
						mes "[Rebarev Doug]";
						mes "我的老战友们……你不知道我有多想念他们……";
						set god_eremes,1;
						break;
					case 2:
						mes "[Rebarev Doug]";
						mes "^333333*叹气……*^000000 请理解，如果不是职位限制，我不会请求你做这件事。";
						next;
						mes "[Rebarev Doug]";
						mes "我有责任守在岗位上，向冒险者介绍十字军职业。因为这项重任，我必须永远警戒地留在这里。";
						next;
						mes "[Rebarev Doug]";
						mes "如果你无法理解，那你一定把自由视为理所当然了……";
						break;
					}
					break;
				case 2:
					mes "[Rebarev Doug]";
					mes "据我所知，这是我第一次请你帮忙。";
					next;
					mes "[Rebarev Doug]";
					mes "和你不同，我知道责任的意义。为了国王和国家，我留在这里帮助求知的冒险者。";
					next;
					mes "[Rebarev Doug]";
					mes "不过……记住，帮助他人时，即使结果不会立刻出现，你也总会得到回报。";
					next;
					mes "[Rebarev Doug]";
					mes "有机会时请重新考虑。";
					break;
				}
			}
			else if (god_eremes > 0 && god_eremes < 4) {
				if (rand(1,10) > 6 && god_eremes == 2) {
					mes "[Rebarev Doug]";
					mes "不知道我的老战友们现在过得怎么样。我甚至想不起上次见到他们是什么时候了……";
					next;
					mes "[Rebarev Doug]";
					mes "嗯……？你还没出发去找他们吗？";
					next;
						switch(select("我该去哪里？:我正准备出发。:你说的最终任务是什么意思？")) {
					case 1:
						mes "[Rebarev Doug]";
							mes "嗯……你应该能通过普隆德拉图书馆的^0000FF排记录^000000找到他们的线索。";
						break;
					case 2:
						mes "[Rebarev Doug]";
							mes "哦，你要出发了……不知道他们在我们的^0000FF最终任务^000000后都做了什么……";
						break;
					case 3:
						mes "[Rebarev Doug]";
							mes "最终任务……？我现在记不起全部细节了，但那就是我们小队解散的原因。";
						next;
						mes "[Rebarev Doug]";
							mes "我们曾是优秀的团队。但在军队体制中，你必须服从上级的命令……";
						next;
						mes "[Rebarev Doug]";
							mes "要是……^660000他^000000没有插手就好了……";
						next;
						mes "[Rebarev Doug]";
						mes "...";
						next;
						mes "[Rebarev Doug]";
						mes "...";
						mes "......";
						next;
						mes "[Rebarev Doug]";
							mes "别谈这件事了。重要的是，我们因最终任务失败而解散。现在，请替我去普隆德拉图书馆找^0000FF第三排记录^000000好吗？";
						set god_eremes,3;
						next;
						mes "[Rebarev Doug]";
							mes "记住，向图书管理员询问记录^660000第一小队最终任务^000000的文件，可能会有帮助。";
						break;
					}
				}
				else {
					mes "[Rebarev Doug]";
					mes "不知道我的老战友们现在过得怎么样。我甚至想不起上次见到他们是什么时候了……";
					next;
					mes "[Rebarev Doug]";
					mes "嗯……？你还没出发去找他们吗？";
					next;
						switch(select("我该去哪里？:我正准备出发。")) {
					case 1:
						mes "[Rebarev Doug]";
							mes "嗯……你应该能通过普隆德拉图书馆的^0000FF第三排记录^000000找到他们的线索。";
						break;
					case 2:
						mes "[Rebarev Doug]";
							mes "哦，你要出发了……不知道他们在我们的^0000FF最终任务^000000后都做了什么……";
						set god_eremes,2;
						break;
					}
				}
			}
			else if (god_eremes > 3 && god_eremes < 18) {
				mes "[Rebarev Doug]";
			mes "嗯……？图书管理员不让你读记录？";
				next;
				mes "[Rebarev Doug]";
			mes "他也许有责任，但归根结底和你我一样。我相信你一定能想办法说服他帮忙。";
				next;
				mes "[Rebarev Doug]";
			mes "求求你，能不能查清第一小队其他成员发生了什么？";
				next;
				mes "[Rebarev Doug]";
			mes "哦……也许知道我们是^660000十字军第三连、第三排、第一小队^000000会有帮助。";
			}
			else if (god_eremes > 17 && god_eremes < 20) {
				if (god_megin_1 > 0 || god_megin_2 > 0 || god_megin_3 > 0 || god_megin_4 > 0 || god_megin_5 > 0 || god_megin_6 > 0) {
					mes "[Rebarev Doug]";
			mes "哦……你见到他们了吗？他们都还好吗？";
					next;
			mes "^3355FF你告诉雷巴列夫·道格，第一小队其他成员虽然患有偏头痛和失忆症，但都平安无事。";
				}
				else {
					mes "^3355FF你告诉雷巴列夫·道格，你读过第三排记录，并说明了自己了解到的情况。^000000";
					next;
					mes "[Rebarev Doug]";
					mes "哦，很高兴听说你读到了记录！但我不相信纸上的内容，毕竟它可能已经过时……";
					next;
					mes "[Rebarev Doug]";
					mes "如果可以，我希望你能亲自见见第一小队的其他成员，这样我才能确定他们都平安无事。";
					next;
					mes "[Rebarev Doug]";
					mes "人的一生太短，朋友也太少。请替我查清老战友们过得怎么样。";
				}
			}
			else if (god_eremes > 19 && god_eremes < 23) {
				mes "[Rebarev Doug]";
			mes "欢迎回来~ 好久没见你了。你见过第一小队的其他成员了吗？";
				next;
				mes "[Rebarev Doug]";
			mes "嗯……？你为什么露出那种奇怪的表情？";
				next;
				switch(select("质问雷巴列夫·道格。:装作毫无察觉。")) {
				case 1:
			mes "^3355FF你向雷巴列夫·道格质问第一小队的失忆和偏头痛问题……^000000";
					next;
			mes "^3355FF想到罗伊尔·米斯特的故事和关于埃吉尼格姆的提及，你的思绪开始混乱……^000000";
					next;
					mes "[Rebarev Doug]";
			mes "你在说什么？我听不懂，你一下子说了太多不同的事情！";
					next;
					mes "[Rebarev Doug]";
			mes "别那样看我。如果你说完了，请先告辞，之后再告诉我消息。";
					next;
					mes "[Rebarev Doug]";
			mes "谢谢你把老战友的消息带给我。现在，我得继续在陛下的指挥下研究。";
					set god_eremes,21;
					break;
				case 2:
					mes "^3355FF你把怀疑藏在心里，只告诉雷巴列夫·道格第一小队成员的情况。^000000";
					next;
					mes "^3355FF当然，你隐瞒了一些细节，只告诉他似乎想听的内容。^000000";
					next;
					mes "[Rebarev Doug]";
					mes "太好了！很高兴听说他们过得这么好！哈哈！哈哈哈哈哈哈！";
					next;
					mes "[Rebarev Doug]";
					mes "谢谢你把老战友的消息带给我。现在，我得继续在陛下的指挥下研究。再次感谢你的帮助。";
					set god_eremes,22;
					break;
				}
			}
			else if (god_eremes > 22 && god_eremes < 25) {
				mes "^3355FF你用从埃吉尼格姆那里了解到的信息质问雷巴列夫·道格。^000000";
				next;
				mes "^3355FF然而，他看起来丝毫没有慌乱。事实上，他散发出的镇静让你感到不安。^000000";
				next;
				mes "[Rebarev Doug]";
				mes "现在谈那件事已经太晚了。知道太多的你真可怜。事到如今，你什么也证明不了。";
				next;
				mes "[Rebarev Doug]";
				mes "你还不明白吗？这个世界由精英和强者统治。我是不可触碰的！弱者和卑微之人就烂在地狱里吧！嘿嘿！";
				next;
				mes "[Rebarev Doug]";
				mes "你恨我吗？你真的恨我吗？看看这张脸。";
				next;
				mes "[Rebarev Doug]";
				mes "这就是……";

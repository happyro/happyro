				mes "关系很近。你知道吗，";
				mes "我们其实是表亲。事实上，";
				mes "他的父亲、我的叔叔，在我父亲";
				mes "去世后把我带回家，";
				mes "那已经是 20 年前的事了。";
				next;
				mes "[卡西]";
				mes "艾音贝赫发生过一次";
				mes "矿井爆炸事故，我记不清了。";
				mes "总之，我和哈伦情同姐弟，";
				mes "我们总是形影不离。";
				mes "一直都是这样。";
				mes "我们从小一起长大。";
				next;
				mes "[卡西]";
				mes "弗雷洛克船长偶然看到我";
				mes "主持骰子游戏，后来雇我到飞艇工作，";
				mes "哈伦坚持要一起去。";
				mes "他就是这么固执，";
				mes "但人也非常温柔。";
				break;
			case 2:
				.@b = 1;
				mes "[卡西]";
				mes "毛翁先生？别误会！他是我的";
				mes "导师，教会我玩这些";
				mes "精彩游戏的人。";
				mes "他在朱诺一带很有名，";
				mes "你应该知道吧。";
				mes "大家都认识他。";
				next;
				mes "[卡西]";
				mes "父亲去世后，我曾经非常消沉，";
				mes "完全不在乎这个世界。";
				mes "后来我遇到了毛翁先生，";
				mes "是他教我重新找到";
				mes "生活中的快乐。";
				mes "我真的很感谢他。";
				next;
				mes "[卡西]";
				mes "所以我决定学习他的游戏，";
				mes "帮助人们忘记烦恼，";
				mes "尽情享受当下，";
				mes "哪怕只有短短一会儿。";
				mes "这就是我的愿望。";
				mes "希望大家都能开心。";
				break;
			case 3:
				.@c = 1;
				mes "[卡西]";
				mes "飞艇？它又大又漂亮，";
				mes "我总是惊叹它能如此优雅地";
				mes "在空中飞行。";
				mes "它在空中飞行的姿态如此优雅，";
				mes "我一直想住在靠近天空的地方……";
				next;
				mes "[卡西]";
				mes "在那里我能看见云朵，";
				mes "沐浴在阳光下。";
				mes "所以弗雷洛克船长邀请我来这里工作时，";
				mes "就像梦想成真一样~";
				mes "我真的非常开心。";
				break;
			}
			next;
		}
		mes "[卡西]";
		mes "对了，如果哈伦又来";
		mes "拜托你做什么，请下次拒绝";
		mes "帮助他，好吗？";
		mes "我不会让他被宠坏的！";
		mes "呵呵呵呵~";
		mes "我可不想把他宠坏！";
		next;
		mes "[卡西]";
		mes "好了，我得回去工作了。";
		mes "祝你今天愉快，";
		mes "我们下次再见~";
		mes "一路顺风。";
		changequest 8037,8038;
		lhz_heart = 4;
	} else if (lhz_heart == 8) {
		mes "你好，"+strcharinfo(0)+"。";
		mes "很高兴再次见到你。";
		mes "今天有什么我能";
		mes "帮上忙的吗？";
		next;
		select("那边那个醉汉是谁？");
		mes "[卡西]";
		mes "哦，他？他是我的常客，";
		mes "据说是艾因布洛克";
		mes "实验室主任。";
		mes "他每次玩骰子都会输掉苹果，";
		mes "我觉得他是赌博成瘾了~";
		mes "真让人担心。";
		next;
		mes "[卡西]";
		mes "事实上，他输掉的苹果正好弥补了";
		mes "苹果商人在这里玩时让我输掉的数量。";
		mes "现在大家都把那当成传奇故事，";
		mes "但当时我差点承受不住。";
		mes "想起来仍然很感慨。";
		next;
		mes "[卡西]";
		mes "总之，除了知道艾因布洛克实验室主任";
		mes "喝醉时有点爱抱怨，";
		mes "而且赌运很差之外，";
		mes "我对他了解不多。";
		mes "他平时很少谈自己的事。";
		mes "就这些了。";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "(^333333艾因布洛克实验室……";
		mes "真可疑。那个主任知道尤弥尔";
		mes "之心碎片的事，他们一定在那边";
		mes "保管着非常重要的东西。^000000)";
		mes "必须调查清楚。";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "(^333333我最好尽快调查";
		mes "艾因布洛克的那座实验室，";
		mes "即使那里是严格限制进入的区域。^000000)";
		mes "不能再拖了。";
		changequest 8041,8042;
		lhz_heart = 9;
	} else {
		mes "你一定很无聊吧，冒险家~";
		mes "要不要来玩一局骰子？";
		mes "消磨一下时间吧。";
		mes "我随时可以开始。";
		next;
		callfunc "applegamble","Kaci";
	}
	close;
}

ein_in01,279,25,0	script	#lab01_heart	HIDDEN_WARP_NPC,1,1,{
	end;
OnTouch_:
	if (lhz_heart == 9) {
		mes "["+strcharinfo(0)+"]";
		mes "(^333333我……我必须调查";
		mes "那座实验室，";
		mes "看看里面是否发生了";
		mes "什么可疑的事情。^000000)";
		mes "不能放过任何线索。";
		close;
	}
}

ein_in01,264,17,0	script	#lab02_heart	HIDDEN_WARP_NPC,1,1,{
	end;
OnTouch_:
	if (lhz_heart == 9) {
		mes "["+strcharinfo(0)+"]";
		mes "什么……";
		mes "这好像是某种奇怪的装置。";
		mes "标签上写着‘密码检查器？’";
		mes "嗯，这东西以后";
		mes "也许能派上用场。";
		mes "先带在身上吧。";
		next;
		mes "^3355FF你决定带着密码检查器";
		mes "装置进入实验室。^000000";
		mes "或许它能打开某扇门。";
		mes "你把装置收好。";
		lhz_heart = 10;
		close;
	}
}

ein_in01,263,35,3	script	Ferlock#lab	4_M_REINDEER,{
	end;

OnEnter:
	enablenpc "Ferlock#lab";
	initnpctimer;
	end;

OnTimer120000:
OnInit:
	disablenpc "Ferlock#lab";
	stopnpctimer;
	end;
}

ein_in01,261,35,0	script	lab03#heart	HIDDEN_WARP_NPC,1,1,{
	end;
OnTouch_:
	if (lhz_heart == 9) {
		mes "[安全系统]";
		mes "^FF0000检测到未授权人员。";
		mes "未检测到密码检查器。";
		mes "拒绝访问。^000000";
		mes "安全协议验证失败。";
		close;
	} else if (lhz_heart == 10) {
		mes "[安全系统]";
		mes "^FF0000请输入 3 位密码。";
		mes "你有 3 分钟时间尝试 5 次，";
		mes "输入正确密码，否则密码将被重置。^000000";
		mes "请谨慎输入。";
		mes "超过时限将自动重置。";
		next;
		mes "[密码检查器]";
		mes "^333333提示：";
		mes "不要使用数字 0，";
		mes "也不要重复输入任何数字。";
		mes "请确认密码为 3 位数。";
		mes "每一位必须各不相同。";
		mes "输入后请等待结果。";
		while (.@yagu100 == .@yagu10 || .@yagu100 == .@yagu1 || .@yagu10 == .@yagu1) {
			.@yagu100 = rand(1,9);
			.@yagu10 = rand(1,9);
			.@yagu1 = rand(1,9);
		}
		while (1) {
			while (1) {
				next;
				input .@input;
				if (.@input < 100 || .@input > 999) {
					mes "[安全系统]";
					mes "^FF0000错误。";
					mes "输入的密码超过位数限制。";
					mes "你只能输入 3 位密码。^000000";
					mes "请重新输入。";
					mes "输入范围为 100 至 999。";
					close;
				}
				.@input100 = .@input / 100;
				.@input10 = (.@input % 100) / 10;
				.@input1 = .@input % 10;
				if ((.@input100 + .@input10 + .@input1 == 0) || .@input100 == .@input10 || .@input100 == .@input1 || .@input10 == .@input1) {
					mes "[安全系统]";
					mes "^FF0000错误。";
					mes "不能输入数字 0，";
					mes "也不能重复使用其他数字。";
					mes "请重试。^000000";
					mes "每一位必须不同。";
					continue;
				}
				break;
			}
			.@retry++;
			mes "[安全系统]";
			mes "^ff0000"+ strcharinfo(0) +"^000000";
			mes "输入了以下密码：";
			mes "^0000ff"+ .@input100 +"^000000 - ^0000ff"+ .@input10 +"^000000 - ^0000ff"+ .@input1 +"^000000.";
			mes "请等待授权完成。";
			next;
			.@strike = (.@yagu100 == .@input100) + (.@yagu10 == .@input10) + (.@yagu1 == .@input1);
			.@ball = (.@yagu100 == .@input10 || .@yagu100 == .@input1) + (.@yagu10 == .@input100 || .@yagu10 == .@input1) + (.@yagu1 == .@input100 || .@yagu1 == .@input10);
			if (.@strike == 3) {
				mes "[安全系统]";
				mes "授权完成。";
				mes "已允许访问档案。";
				next;
				mes "^3355FF档案室的门打开了，";
				mes "里面是一排排归档文件。";
				mes "其中一份文件";
				mes "吸引了你的注意。^000000";
				mes "你走近查看。";
				next;
				mes "瓦尔蒙特计划 3 号";
				mes "安全等级：1-C 级";
				mes " ";
				mes "注意：只有尤弥尔之心合成计划的";
				mes "项目成员才有权查看此机密文件。";
				mes "未经授权不得阅读。";
				next;
				mes "瓦尔蒙特计划 3 号";
				mes "安全等级：1-C 级";
				mes " ";
				mes "其他任何阅读此文件的人";
				mes "都将受到惩罚或解雇。";
				mes "请严格遵守规定。";
				next;
				mes "^3355FF你听到了脚步声，连忙想把文件";
				mes "放回原处。然而，来到档案室的人";
				mes "已经看见你拿着文件了。^000000";
				mes "情况不妙。";
				mes "你赶紧转身。";
				mes "对方已经发现了你。";
				mes "无法再隐藏。";
				next;
				donpcevent "Ferlock#lab::OnEnter";
				mes "[弗洛克]";
				mes "不好意思，你是这里的员工吗？";
				mes "我是来为飞艇领取新的符文石的。";
				mes "等等，等等……";
				mes "你看起来很眼熟……";
				mes "我们是不是在哪里见过？";
				mes "让我想想。";
				next;
				emotion ET_HUK, getnpcid(0, "Ferlock#lab");
				mes "[弗洛克]";
				mes "没错，你就是给我带来";
				mes "弟弟信件的那个人？";
				mes "对，你还问过我飞艇的飞行原理。";
				mes "所以你不是这里的员工……";
				mes "那你为什么会在这里？";
				mes "真是奇怪。";
				next;
				mes "[弗洛克]";
				mes "年轻人，你一定不只是好奇，";
				mes "才会在限制区域查找这些信息。";
				mes "不过别担心，你一定有自己的理由，";
				mes "所以我不会叫卫兵。";
				mes "但这里确实很危险。";
				mes "下次一定要小心。";
				next;
				mes "[弗洛克]";
				mes "不过你最好赶快离开。卫兵会";
				mes "定期巡逻这里，你很可能被抓住。";
				mes "嗯，之后到飞艇上来找我，";
				mes "好吗？现在快走！";
				mes "别再逗留了。";
				mes "祝你好运。";
				close2;
				donpcevent "Ferlock#lab::OnInit";
				changequest 8042,8043;
				lhz_heart = 11;
				end;
			}
			mes "[密码检查器]";
			mes " ";
			mes "^333333位置正确的数字总数：";
			mes "位置正确的数字数量：^ff0000"+.@strike+"^333333";
			mes "数字正确但位置错误的数量：^ff0000"+.@ball+"^333333。";
			mes "请根据这些结果";
			mes "做出更准确的猜测。^000000";
			next;
			if (.@retry > 4) {
				mes "[安全系统]";
				mes "^FF0000本次会话的正确密码是";
				mes "";
				mes "^000000"+.@yagu100+"^FF0000 - ^000000"+.@yagu10+"^000000 - ^000000"+.@yagu1+"^FF0000.";
				mes "密码现在将被重置。^000000";
				close;
			}
			mes "[安全系统]";
			mes "哔——！";
			mes "密码错误。";
			mes " ";
			switch (.@retry) {
				case 1: mes "开始第 2 次尝试……^000000"; break;
				case 2: mes "开始第 3 次尝试……^000000"; break;
				case 3: mes "开始第 4 次尝试……^000000"; break;
				case 4: mes "开始最后一次尝试……^000000"; break;
			}
		}
	}
	end;
}

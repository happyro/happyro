// Daily Quest : Cleaning Robot Omega
ba_in01,24,322,3	script	Cleaning Robot Ω#ba_pw01_02Q	20640,{
	if (checkweight(1000103,2) == 0) {
		mes "- 你携带的物品太多，无法继续。-";
		close;
	}
	setpcblock PCBLOCK_NPC, true;
		npctalk "(θ_θ?) ☎ 正在加载……", "", bc_self;
	sleep2 1000;
	npctalk "清洁机器人Ω：正在进行用户识别通信。", "", bc_self;
	sleep2 2000;
		npctalk "(⊙_⊙*) ☎ 已连接！！", "", bc_self;
	sleep2 1000;
	if (ep17_2_main < 9) {
		npctalk "清洁机器人Ω：用户未授权。通信终止。", "", bc_self;
		setpcblock PCBLOCK_NPC, false;
		end;
	}
	npctalk "清洁机器人Ω：用户已授权。很高兴见到你。";
	sleep2 1000;
	setpcblock PCBLOCK_NPC, false;

	if (isbegin_quest(5892) == 0) {
		mes "[清洁机器人Ω]";
		mes "你好，客人！很高兴见到你~我是清洁机器人Ω~";
		next;
		select( "你好，很高兴见到你。" );
		mes "[清洁机器人Ω]";
		mes "清洁机器人的任务是清理污水处理厂和第一发电厂。";
		npctalk "┏(^▽^)┛清扫中……", "", bc_self;
		next;
		mes "[清洁机器人Ω]";
		mes "但是清洁机器人Ω现在无法清扫~好伤心~";
		npctalk "ㆀ(X_X)ㆀ", "", bc_self;
		next;
		mes "[清洁机器人Ω]";
		mes "未经授权的用户阻止了我们清洁机器人工作~";
		npctalk "(-_-a);;;", "", bc_self;
		next;
		mes "[清洁机器人Ω]";
		mes "清洁机器人Ω遇到了困难。好客人，我需要你的帮助~拜托~";
		npctalk "☞☜ ☞♥☜ ☞☜", "", bc_self;
		next;
		if (select( "好吧，我会帮你。", "我不想帮！" ) == 2) {
			mes "[清洁机器人Ω]";
			mes "清洁机器人Ω~好伤心……";
			npctalk "(ㅠ_ㅠ)ㆀ", "", bc_self;
			close;
		}
		mes "[清洁机器人Ω]";
		mes "客人真善良~";
		mes "清洁机器人Ω~非常开心";
		npctalk "(≥▽≤)♥♡♥♡♥♡", "", bc_self;
		setquest 5892;
		completequest 5892;
		close;
	}
	.@status[0] = F_queststatus(HUNTING,5893,5894,5895);
	.@status[1] = F_queststatus(HUNTING,5897,5898,5899);

	if (.@status[0] == 2 || .@status[1] == 2) {
		mes "[清洁机器人Ω]";
		mes "非常感谢，清洁机器人Ω终于可以去清扫了，真开心。";
		if (.@status[0] == 2) {
			erasequest 5893;
			erasequest 5894;
			erasequest 5895;
			setquest 5896;
			getitem 1000103,2;
			getexp 5065368,3500000;
		}
		if (.@status[1] == 2) {
			erasequest 5897;
			erasequest 5898;
			erasequest 5899;
			setquest 5900;
			getitem 1000103,2;
			getexp 5197368,3500000;
		}
		close;
	}
	switch( rand(1,4) ) {
	case 1:
		npctalk "(≥▽≤)/", "", bc_self;
		break;
	case 2:
		npctalk "┗(^▽^)┛动力……", "", bc_self;
		break;
	case 3:
		npctalk "(≥▽≤)~♬", "", bc_self;
		break;
	case 4:
		npctalk "┏(^▽^)┛清扫中……", "", bc_self;
		break;
	}
	.@quest_menu$[0] = callsub( S_Menu, 5893,5894,5895,5896, "污水处理厂清扫" );
	.@quest_menu$[1] = callsub( S_Menu, 5897,5898,5899,5900, "第一发电厂清扫" );

	mes "[清洁机器人Ω]";
	mes "清扫真有趣~";
	next;
	switch( select( .@quest_menu$[0], .@quest_menu$[1], "祝你好运。" ) ) {
	case 1:
		setarray .@quest[0],5893,5894,5895;
		.@cd = 5896;
		break;
	case 2:
		setarray .@quest[0],5897,5898,5899;
		.@cd = 5900;
		break;
	case 3:
		npctalk "(Θ_Θ). .(θ_θ). .(zZzZ)", "", bc_self;
		mes "[清洁机器人Ω]";
		mes "对话结束。";
		close;
	}
	switch( checkquest(.@cd,PLAYTIME) ) {
	case -1:
		break;
	case 0:
	case 1:
		if (.@quest[0] == 5893) {
			mes "[清洁机器人Ω]";
			mes "谢谢你，好客人~清洁机器人Ω已经处理过污水处理厂了。";
		}
		else {
			mes "[清洁机器人Ω]";
			mes "谢谢你，好客人~清洁机器人Ω已经清理过第一发电厂了。";
		}
		close;
	case 2:
		erasequest .@cd;
		break;
	}
	switch( checkquest(.@quest[0],HUNTING) ) {
	case -1:
		if (.@quest[0] == 5893) {
			mes "[清洁机器人Ω]";
			mes "清洁机器人Ω本来应该负责处理污水处理厂。";
			mes "但那里还有维内努姆、瀑布和痉挛者，所以我们无法清理~";
		}
		else {
			mes "[清洁机器人Ω]";
			mes "清洁机器人Ω无法清理第一发电厂，因为那里有许多精英贝拉雷、魔法多洛尔和解放魔法。";
		}
		npctalk "(ㅠ^ㅠ) OTL ..", "", bc_self;
		next;
		if (.@quest[0] == 5893) {
			mes "[清洁机器人Ω]";
			mes "清洁机器人Ω好伤心~";
			mes "如果你能处理 44 只维内努姆、瀑布和痉挛者，我想我就能清理污水处理厂。";
		}
		else {
			mes "[清洁机器人Ω]";
			mes "清洁机器人Ω好伤心~";
			mes "如果你能处理 44 只精英贝拉雷、魔法多洛尔和解放魔法，我想我就能清理第一发电厂。";
		}
		npctalk "(?▽?)~♡", "", bc_self;
		next;
		if (select( "我会帮忙。", "拒绝。" ) == 2) {
			npctalk "ㆀ(@ㅠ@)ㆀ", "", bc_self;
			mes "[清洁机器人Ω]";
			mes "清洁机器人Ω~好伤心……";
			close;
		}
		mes "[清洁机器人Ω]";
			mes "非常感谢~";
		npctalk "(♡З♡)~♥", "", bc_self;
		for ( .@i = 0; .@i < 3; ++.@i )
			setquest .@quest[.@i];
		close;
	case 0:
	case 1:
	case 2:
		if (.@quest[0] == 5893) {
			mes "[清洁机器人Ω]";
			mes "清洁机器人Ω本来应该负责处理污水处理厂。";
			mes "我无法清扫，好伤心~怪物太可怕了~";
		}
		else {
			mes "[清洁机器人Ω]";
			mes "清洁机器人Ω本来应该负责清理第一发电厂。";
			mes "我无法清扫，好伤心~怪物太可怕了~";
		}
		npctalk "ㆀ(ㅠ_≤)ㆀ", "", bc_self;
		close;
	}
	end;

S_Menu:
	.@string$ = getarg(4);

	switch( checkquest(getarg(3),PLAYTIME) ) {
	case -1:
		for ( .@i = 0; .@i < 3; ++.@i ) {
			if (checkquest(getarg(.@i),HUNTING) == 0 || checkquest(getarg(.@i),HUNTING) == 1)
				return "^777777[进行中]^000000 " + .@string$;
		}
		.@menu$ = "[每日] " + .@string$;
		break;
	case 0:
	case 1:
		.@menu$ = "^777777[等待中]^000000 " + .@string$;
		break;
	case 2:
		.@menu$ = "[每日] " + .@string$;
		break;
	}
	return .@menu$;

OnMove:
	.@gid = getnpcid(0);
	npcspeed rand(50,200);
	do {
		.@x = rand(16,31);
		.@y = rand(311,332);
	}
	while (!checkcell("ba_in01",.@x,.@y,cell_chkpass));

	unitstopwalk .@gid, USW_FORCE_STOP;
	unitwalk .@gid,.@x,.@y;

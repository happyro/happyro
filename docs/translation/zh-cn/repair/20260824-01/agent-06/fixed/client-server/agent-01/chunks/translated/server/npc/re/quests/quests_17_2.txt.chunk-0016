		mes "……其实，我对外面的世界和过去都一无所知。";
		mes "我从出生起就一直在这里。我只知道主人告诉我的故事。";
		next;
		mes "[T2WH-0448]";
		mes "他说以后完成我的制作后会带我去外面，还会把我和其他自动人偶连接起来。所以我一直在等主人回来。";
		next;
		mes "[T2WH-0448]";
		mes "主人已经很久没来了。我睡了多久？";
		next;
		mes "[T2WH-0448]";
		mes "你是怎么到这里的？他们说只有主人能进来，对吧？除非发生紧急情况……哦！主人死了吗？他受伤了吗？所以才没能来？";
		next;
		select( "不是那样……" );
		mes "[T2WH-0448]";
		mes "真的吗？你是很久以前来过这里的客人的后代，来处理入侵者的吗？你真是个酷酷的第二人类，对吧？";
		next;
		mes "[T2WH-0448]";
		mes "主人也很久没来宅邸了吗？出什么事了？";
		next;
		mes "[T2WH-0448]";
		mes "那么你为什么会在这里？还用紧急钥匙开了门。你不能随便拿走那些钥匙。";
		next;
		select( "地下室里有可疑的声音。" );
		mes "[T2WH-0448]";
		mes "哦，是我唱歌的声音？你把我误认成坏掉的自动人偶了？不过那是什么？你身后的东西？";
		next;
		mes "[T2WH-0448]";
		mes "你说它们坏了，但为什么没有倒下或闪烁？为什么会攻击？自动人偶不该攻击客人，对吧？";
		next;
		select( "这些是被入侵者弄坏的人偶。" );
		mes "[T2WH-0448]";
		mes "真的吗？但你把它带到这里来了？为什么？";
		next;
		select( "这不是原本就在这里的吗？" );
		mes "[T2WH-0448]";
		mes "不，这里原本什么都没有，完全是空的。是你进来时把它带进来的。";
		next;
		select( "抱歉。它们一定是我开门时跟进来的。" );
		mes "[T2WH-0448]";
		mes "我无法在那些恶魔之间移动，该怎么做？如果它们伤害我，我会不会毫无抵抗地消失？";
		next;
		select( "我该把你带出去吗？" );
		mes "[T2WH-0448]";
		mes "不行。主人把我留在这里，所以我必须待在这里，直到主人回来。";
		next;
		mes "[T2WH-0448]";
		mes "可是那些东西怎么办？我不想连外面都没去过就消失。";
		next;
		mes "[T2WH-0448]";
		mes "你可以保护我，这样就行。另外请带些零件来，让我组装身体。";
		next;
		select( "什么？" );
		mes "[T2WH-0448]";
		mes "是你把它们带来的，所以你应该负责。";
		mes "我会尽量藏好不被发现，但如果它们攻击，我至少还能逃跑，尽管无法反击。";
		next;
		mes "[T2WH-0448]";
		mes "这样不行。你不该打开那扇门。我太小也太脆弱了。";
		next;
		select( "我该怎么办？" );
		mes "[T2WH-0448]";
		mes "主人过去会在这里用收集来的东西制作物品。";
		mes "我就是这样诞生的。";
		mes "所以请带些我能^0000CD使用并制作身体的物品^000000给我。";
		next;
		mes "[T2WH-0448]";
		mes "身体……包括手臂和腿，对吧？";
		mes "只有一条腿也没关系，但大家好像都有手臂。";
		next;
		mes "[T2WH-0448]";
		mes "除非主人把它们挪走了。";
		mes "我相信下面有适合身体、手臂和腿的房间。";
		next;
		mes "[T2WH-0448]";
		mes "最近的地方就是<NAVI>[身体]<INFO>ba_2whs02,31,50,0,101,0</INFO></NAVI>所在处，先去那里。快带一个回来，我害怕。";
		ep17_2_chirp = 7;
		erasequest 17349;
		setquest 17350;
		close;
	}
	if (ep17_2_chirp < 10) {
		mes "[T2WH-0448]";
		mes "最近的地方就是身体所在处，先去那里。快带一个回来，我害怕。";
		close;
	}
	if (ep17_2_chirp == 10) {
		mes "[T2WH-0448]";
		mes "你带回来了吗？来吧，把它组装起来。";
		next;
		progressbar_npc "00FF00",2;
		mes "[T2WH-0448]";
		mes "完成了吗？它在哪里……";
		next;
		specialeffect EF_GUARD2;
		setnpcdisplay( "Head#ep172_2whs01", 4_F_KR_TIGER );
		cloakoffnpcself( "Head#ep172_2whs01" );
		if (isbegin_quest(17355) == 0) {
			setquest 17355;
			completequest 17355;
		}
		mes "[T2WH-0448]";
		mes "你觉得怎么样？奇怪吗？";
		next;
		select( "很可爱。" );
		mes "[T2WH-0448]";
		mes "我很喜欢。谢谢你，现在我安心多了。";
		next;
		select( "我得回去报告情况。" );
		mes "[T2WH-0448]";
		mes "向谁报告？她叫什么？";
		mes "她是自动人偶还是人类？";
		next;
		select( "哦，向另一个人偶……" );
		mes "[T2WH-0448]";
		mes "真的吗？外面的旧自动人偶都有名字？那也给我取个名字吧。主人没给我取名，我只有一个序列号。";
		next;
		select( "突然要取名？" );
		mes "[T2WH-0448]";
		mes "你不能给我取名吗？只有特殊的人类才能做到？但你也是特殊的客人。";
		next;
		mes "[T2WH-0448]";
		mes "那么也没办法了。我只能自己想想。嗯……这个怎么样？瓦尔蒙特。";
		next;
		select( "什么？？" );
		mes "[T2WH-0448]";
		mes "为什么？很奇怪吗？我不认识什么名字。地下入口的看守者怎么样？家……我还要再想想名字。反正我得在这里等主人回来。";
		next;
		mes "[T2WH-0448]";
		mes "我可以一边躲避它们一边思考。或者等主人回来时请他给我命名。";
		next;
		mes "[T2WH-0448]";
		mes "你说要上去向另一个自动人偶报告，对吧？那么，再见！谢谢你的帮助。";
		ep17_2_chirp = 11;
		erasequest 17353;
		setquest 17358;
		getitem 1000103,3;
		close;
	}
	if (ep17_2_chirp == 11) {
		mes "[T2WH-0448]";
		mes "你说要上去向另一个自动人偶报告，对吧？你觉得我能做到吗？";
		close;
	}
	mes "我还没决定给它取什么名字。奇怪的是，那些家伙居然没有碰我。";
	close;

OnInit:
	questinfo( QTYPE_QUEST2, QMARK_YELLOW, "isbegin_quest(17349) == 1" );
	questinfo( QTYPE_QUEST2, QMARK_YELLOW, "isbegin_quest(17353) == 1" );
	end;
}

ba_2whs02,31,50,0	script	Junk#ep172_whs2body	4_ENERGY_BLACK,{

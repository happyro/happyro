			mes "[Ghenirhemin]";
			mes "我们家族很幸运，拥有带来财富的伟大祖先。";
			mes "要列出每一位成功的祖先，至少得花一周。";
			next;
			mes "[Ghenirhemin]";
			mes "不过我想告诉你一位令人惊叹的祖先，他已经成为家族英雄。";
			next;
			mes "[Ghenirhemin]";
			mes "其实我不知道他具体做了什么，但我知道他第一次为家族带来了荣耀和名声。";
			mes "不过时间太久了，我们没有关于他的任何文献，所以……";
			next;
			mes "[Ghenirhemin]";
			mes "不过有一件事我记得很清楚。";
			mes "他是唯一能接近神明的人类，还展示神力为我们人类带来光明。";
			next;
			mes "[Ghenirhemin]";
			mes "我不知道他如何获得神力，也不知道如何接近神明。";
			mes "我只是从出生起不断听人讲述他的传奇故事，所以记住了这些……";
			next;
			mes "[Ghenirhemin]";
			mes "我可以证明自己没有胡说。";
			mes "我说过我们没有关于他的文献，对吧？";
			mes "不过有一样东西可以给你看。现在看看这个。";
			next;
			set moza_valkylie,1;
			mes "[Ghenirhemin]";
		mes "看到了吗？这足以证明我没有胡说！";
		mes "这是我祖先曾经使用的东西！";
			close;
		}
		mes "[Ghenirhemin]";
		mes "真遗憾！不过我不想强迫你做不愿意做的事。哈哈哈。";
		mes "记住，你刚刚为自己的人生做出了另一个选择。";
		close;
	}
	mes "[Ghenirhemin]";
	mes "世间万物都有存在的意义和理由。你我注定今天相遇。";
	next;
	mes "[Ghenirhemin]";
	mes "嗯……虽然我说万物都有意义，但很遗憾你对我毫无吸引力。";
	mes "叫我拜金也好，我喜欢有钱人。";
	next;
	mes "[Ghenirhemin]";
	mes "证明你很富有，我也许会改变想法并对你感兴趣。";
	mes "不过要等你拿出钱来，我才会决定是否感兴趣。哈哈哈哈！";
	close;
}
// Hahoe Mask / Mythical Lion Mask / Bride Mask
//============================================================
payon,135,320,3	script	Chungwolmang	97,{
	if (moza_tal == 2) {
		if (countitem(7015) > 19 && countitem(952) > 99 && countitem(1028) > 99) {
			//Hahoe_Mask: Bookclip_In_Memory, Cactus_Needle, Wild_Boar's_Mane
			callsub S_MakeMask,5176,7015,20,952,100,1028,100,0,0;
		}
		if (countitem(1048) > 499 && countitem(1053) > 1 && countitem(980) > 0) {
			//Guardian_Lion_Mask: Slender_Snake, Tooth_Of_Ancient_Fishm Orange_Dyestuffs
			callsub S_MakeMask,5177,1048,500,1053,2,980,1,0,0;
		}
		if (countitem(1049) > 19 && countitem(1059) > 499 && countitem(1054) > 1 && countitem(1024) > 99) {
			//Bride_Mask: Skirt_Of_Virgin, Transparent_Cloth, Lip_Of_Ancient_Fish, Chinese_Ink
			callsub S_MakeMask,5169,1049,20,1059,500,1054,2,1024,100;
		}
		mes "[Chungwolmang]";
		mes "哎呀，你还没收集齐材料吗？";
		mes "最好快点，我可等不了太久！";
		mes "等等，你到底要我做哪种面具？";
		next;
		switch(select("河回面具:新娘面具:神话狮子面具")) {
		case 1:
			mes "[Chungwolmang]";
			mes "哦，对了，你要河回面具。";
			mes "需要带来^FF000020个记忆书签^000000、^FF0000100根仙人掌刺^000000和^FF0000100个鬃毛^000000。";
			break;
		case 2:
			mes "[Chungwolmang]";
			mes "哦，对了，你要新娘面具。";
			mes "需要带来^FF000020条处女的裙子^000000、^FF0000500块布料^000000、^FF00002个古代鱼唇^000000和^FF0000100份乌贼墨汁^000000。";
			break;
		case 3:
			mes "[Chungwolmang]";
			mes "哦，对了，你要神话狮子面具。";
			mes "需要带来^FF0000500根可怕的毛发^000000、^FF00002颗古代牙齿^000000和^FF00001个橙色染料^000000。";
			break;
		}
		mes "带来准确数量的材料，我马上把面具给你。";
		close;
	}
	if (countitem(7201) > 499) && (countitem(7200) > 9 && moza_tal == 1) {
		mes "[Chungwolmang]";
		mes "啊，四叶草一定给我带来了好运，你比我想象中回来得快！哇……";
		mes "太谢谢你了，我觉得好运已经站在我这边。哈哈哈！";
		next;
		mes "[Chungwolmang]";
		mes "好了！我会如约报答你。";
		mes "我把一切都告诉你。事实上，我是传统面具工匠。";
		mes "我很自豪地说，制作传统面具没人能胜过我！咳咳！";
		next;
		mes "[Chungwolmang]";
		mes "由于各种原因，我曾情绪不稳，做什么都倒霉。";
		mes "但那已经是过去了！我回来了，哈哈哈哈！";
		next;
		mes "[Chungwolmang]";
		mes "我感觉很好，好运也回来了。";
		mes "非常感谢你让我恢复状态。作为回报，我要为你制作传统面具！哈哈哈！";
		mes "我送你珍贵礼物，你应该感到感激。";
		next;
		mes "[Chungwolmang]";
		mes "知道为什么吗？除了我，没人能给你如此珍贵的物品。";
		mes "总之，我能制作三种面具：河回面具、新娘面具和神话狮子面具。";
		mes "你想要哪一种？选一个吧。";
		next;
		switch(select("河回面具:新娘面具:神话狮子面具")) {
		case 1:
			mes "[Chungwolmang]";
			mes "很好，你要河回面具，对吧？很简单！";
			mes "需要带来^FF000020个记忆书签^000000、";
		mes "^FF0000100 根仙人掌刺^000000和";
			mes "^FF0000100 根鬃毛^000000。";
			mes "带来准确数量的材料，我马上把面具给你。";
			break;
		case 2:
			mes "[Chungwolmang]";
			mes "很好，你要新娘面具，对吧？很简单！";
			mes "需要带来^FF000020条处女的裙子^000000、";
			mes "^FF0000500 块布料^000000、^FF00002 个古代鱼唇^000000、";
			mes "和^FF0000100份乌贼墨汁^000000。带来准确数量的材料，我马上把面具给你。";
			break;
		case 3:
			mes "[Chungwolmang]";
			mes "很好，你要神话狮子面具，对吧？很简单！";
			mes "需要带来^FF0000500根可怕的毛发^000000、";
		mes "^FF00002 颗远古牙齿^000000和";
		mes "^FF00001 个橙色染料^000000。";
			mes "带来准确数量的材料，我马上把面具给你。";
			break;
		}
		delitem 7201,500; //Log
		delitem 7200,10; //Flexible_String
		set moza_tal,2;
		next;
		mes "[Chungwolmang]";
		mes "……你为什么盯着我看？";
		mes "什么，你以为我会免费制作面具？";
		mes "如果是这样，你应该换个角度想。";
		mes "我的报答方式是使用技艺，让你得到珍贵面具，";
		mes "而不是免费为你制作，明白了吗？";
		next;
		mes "[Chungwolmang]";
		mes "至少我没收服务费，不是吗？";
		mes "只要带来材料，我会尽力为你制作令人惊叹的面具！";
		next;
		mes "[Chungwolmang]";
		mes "在此期间，我会用这些木头和弹性带准备工作。";
		mes "尽快回来，好吗？";
		close;
	}
	if (moza_tal == 1) {
		mes "[Chungwolmang]";
		mes "嗯……我要求的是";
	mes "^FF0000500 根木材^000000和^FF000010 条橡皮筋^000000。";
		mes "提前谢谢你。";
		close;
	}
	if (countitem(706) > 0) {
		mes "[Chungwolmang]";
		mes "啊……！嘿！我发现你身上有特别之处。";
		mes "你是不是有四叶草？";
		mes "可以把四叶草给我吗？";
		next;
		mes "[Chungwolmang]";
		mes "我不是白拿。虽然无法保证，";
		mes "但迟早会报答你的恩情。可以给我吗？";
		next;
		if (select("当然。:不行。") == 1) {
			mes "[Chungwolmang]";
			mes "哦！太谢谢你了！";
			mes "呜哈哈哈哈！我现在要成为幸运的人了！";
			mes "有了四叶草，好运会再次站在我这边！";
			next;
			mes "[Chungwolmang]";
			mes "哦，对了！我差点忘了。";
			mes "我答应过要报答你的恩情，对吧？";
			mes "我知道这听起来有点自私，";
			mes "但能再帮我一次吗？";
			mes "你已经帮过我了，再帮一次应该不难吧？";
			mes "请展现你的慷慨～";
			next;
			mes "[Chungwolmang]";
			mes "我需要……^FF0000500根木头^000000和";
			mes "^FF000010 条橡皮筋^000000。";
			mes "可以帮我带来吗？没有它们我就无法报答你。";
			next;
			delitem 706,1; //Four_Leaf_Clover
			set moza_tal,1;
			mes "[Chungwolmang]";
			mes "你想让我报答你，对吧？所以请把它们带给我吧～";
			close;
		}
		mes "[Chungwolmang]";
		mes "我明白了……把幸运护符毫不犹豫地给陌生人确实不容易。";
		mes "……哈哈，但这并不能让我不再生气。";
		mes "你竟敢拒绝我的请求？哈！";
		close;
	}
	mes "[Chungwolmang]";
	mes "啊啊啊……我需要……我需要……";
	next;
	mes "[Chungwolmang]";
	mes "我想要好运！谁来给我带来好运！";
	mes "我没有要求太多！我只需要一样东西！";
	next;
	mes "[Chungwolmang]";
	mes "我需要一株^FF0000四叶草^000000！";
	mes "谁来给我带一株四叶草！";
	close;

S_MakeMask:
	.@item_id = getarg(0);
	mes "[Chungwolmang]";
		mes "哦，你带齐了制作"+getitemname(.@item_id)+"的全部材料。太好了。";
		mes "把材料给我，我马上制作面具。";
	next;
	if (select("把物品给他。:不给他物品。") == 1) {
		mes "[Chungwolmang]";
		mes "很好，我喜欢你毫不犹豫的态度！";
		mes "那我就尽快制作面具！";
		next;
		mes "[Chungwolmang]";
			mes "- 翻找 翻找 翻找 -";
			mes "- 翻找 翻找 翻找 -";
			mes "- 翻找 翻找 翻找 -";
			mes "- 砰 砰 砰 砰 -";
		next;
		mes "[Chungwolmang]";
			mes "- 翻找 翻找 翻找 -";
			mes "- 翻找 翻找 翻找 -";
			mes "- 翻找 翻找 翻找 -";
			mes "- 砰 砰 砰 砰 -";
		next;
		delitem getarg(1),getarg(2);
		delitem getarg(3),getarg(4);
		delitem getarg(5),getarg(6);
		if (.@item_id == 5169) 
			delitem getarg(7),getarg(8);
		getitem .@item_id,1;
		set moza_tal,0;
		mes "[Chungwolmang]";
		mes "哇，真是小菜一碟！";
		mes "你知道吗，我可不只是名义上的工匠。";
		mes "哈哈哈，拿着你的"+getitemname(.@item_id)+"。希望你自豪地戴上它，哈哈哈！";
		next;
		mes "[Chungwolmang]";
		mes "好了，在下一位客人来之前我得休息一下。哈哈哈，再见！";
		close;
	}
	mes "[Chungwolmang]";
	mes "咦？你不想要"+getitemname(.@item_id)+"吗？";
	mes "好吧……胆小鬼。";
	close;
}


// Magistrate Hat / Ayam
//============================================================
payon_in03,139,124,3	script	Han Garam	88,{
	if (moza_korea == 2 && countitem(954) > 299 && countitem(733) > 4 && countitem(975) > 0 && countitem(7166) > 49) {
		mes "[Han Garam]";
		mes "你比我预想的回来得快。";
		mes "太好了，我也很有动力，因为我的阿亚姆将属于像你这样能干又可靠的人。";
		next;
		mes "[Han Garam]";
		mes "好，我会尽快制作帽子。现在把所有材料交给我。";
		next;
		if (select("把物品给他。:不给他物品。") == 1) {
			mes "[Han Garam]";
			mes "太好了！这次不用龙神帮我变大，";
			mes "我自己就能完美完成。先在这里等着，好吗？";
			next;
			mes "[Han Garam]";
			mes "好……对……嗯嗯。";
			next;
			mes "[Han Garam]";
			mes ".................";
			next;
		mes "- 韩加兰开始敲打，-";
		mes "- 一言不发地组装材料。-";
			next;
			mes "[Han Garam]";
			mes ".................";
			next;
			mes "[Han Garam]";
			mes "呼，真不容易，毕竟我已经很久没做这个了。";
			next;
			mes "[Han Garam]";
			mes "不过能有机会施展技艺，我还是很开心，也很有趣。";
			mes "请收下这顶阿亚姆。正如承诺，这是送给你的礼物。";
			next;
			delitem 954,300; //Shining_Scales
			delitem 733,5; //Crystal_Jewel___
			delitem 975,1; //Scarlet_Dyestuffs
			delitem 7166,50; //Soft_Silk_Cloth
			set moza_korea,0;
			getitem 5174,1; //A_yam
			mes "[Han Garam]";
			mes "如果想再做一顶帽子，我得再次去见龙神……嗯……";
			mes "算了，这次在你的帮助下总算做成了，时机到了自然会再做。";
			next;
			mes "[Han Garam]";
			mes "太谢谢你了！请珍惜我的阿亚姆，";
			mes "并为自己成为阿亚姆的主人感到骄傲！";
			close;
		}
		mes "[Han Garam]";
		mes "……？怎么了？还需要更多时间吗？";
		mes "你不能直接把它们给我吗？";
		close;
	}
	else if (moza_korea == 2 && countitem(954) > 299 && countitem(733) > 4 && countitem(983) > 0 && countitem(2221) > 0) {

			mes "太好了！这次不用龙神帮我变大，";
			mes "我自己就能完美完成。先在这里等着，好吗？";
			next;
			mes "[Han Garam]";
			mes "好……对……嗯嗯。";
			next;
			mes "[Han Garam]";
			mes ".................";
			next;
			mes "- 韩加兰开始敲打，-";
			mes "- 一言不发地组装材料。-";
			next;
			mes "[Han Garam]";
			mes ".................";
			next;
			mes "[Han Garam]";
			mes "呼，真不容易，毕竟我已经很久没做这个了。";
			next;
			mes "[Han Garam]";
			mes "不过能有机会施展技艺，我还是很开心，也很有趣。";
			mes "请收下这顶法官帽。正如承诺，这是送给你的礼物。";
			next;
			delitem 954,300; //Shining_Scales
			delitem 733,5; //Crystal_Jewel___
			delitem 983,1; //Black_Dyestuffs
			delitem 2221,1; //Hat_

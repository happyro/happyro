		mes "所以选一顶帽子，把它所需的材料一件不漏地带给我。";
		next;
		mes "[Han Garam]";
		mes "啊～我已经很久没感受到体内的龙神了。";
		mes "感觉自己学到了超凡的东西。";
		close;
	}
	else if (moza_korea == 1) {
		mes "[Han Garam]";
		mes ".............";
		next;
		mes "[Han Garam]";
		mes ".............";
		next;
		mes "[Han Garam]";
		mes ".............";
		next;
		mes "[Han Garam]";
		mes "……*颤抖、颤抖*……他……他来了……他来了！";
		mes "*颤抖、颤抖* 我能感受到";
		mes "我体内的龙神！哇啊！";
		mes "他正在摇尾巴，向我展示未来！啊啊啊啊啊！";
		next;
		specialeffect EF_LORD;

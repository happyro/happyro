	next;
	mes "[Party Recruiting Expert]";
	mes "^006400组队招募列表^000000窗口显示其他用户发布的招募队伍，你可以搜索。";
	next;
	mes "[Party Recruiting Expert]";
	mes "如果你不想加入队伍，但想招募队员，请输入/Party Recruit^000000命令，然后在^006400队伍招募^000000窗口中招募成员！";
	next;
	mes "[Party Recruiting Expert]";
	mes "在^006400队伍招募^000000窗口登记招募公告后，其他用户就能搜索你的^006400队伍招募列表^000000。";
	next;
	mes "[Party Recruiting Expert]";
	mes "在^006400队伍招募列表^000000中，";
	mes "^006400Party Recruiting^000000 you can put in basic information of what you're going to be doing, or what you're looking for like ";
	mes "^006400LEVEL^000000, ^006400MAP^000000, ^006400JOB^000000.";
	mes "用户就能利用这些参数和^006400队伍招募^000000系统进行搜索。";
	next;
	mes "[Party Recruiting Expert]";
	mes "如果想了解更多^006400队伍招募^000000命令，请点击^006400队伍招募列表^000000右下方的^006400帮助^000000按钮。";
	next;
	return;
}

moc_para01,12,179,6	script	Battleground Master	419,{
	set .@checkquest, checkquest(4163);
	if (.@checkquest == 2) {
		mes "[Battleground Expert]";
		mes "看你来找我，应该是想了解^006400战场^000000吧？";
		next;
		switch(select("了解战场。:结束对话。")) {
		case 1:
			callsub L_Info;
			mes "[Battleground Expert]";
			mes "没有什么比直接听专家讲解更好了！如果想再复习一遍，就来和我交谈。";
			close;
		case 2:
			mes "[Battleground Expert]";
			mes "如果想复习任何内容，告诉我就好。";
			close;
		}
	} else if (.@checkquest == 0 || .@checkquest == 1) {
		mes "[Battleground Expert]";
		mes "我在^006400战场^000000经历了 16 年激烈战斗……我是^006400战场^000000专家！";
		mes "看来你通过了^006400队伍招募专家^000000的测验，所以他把你介绍给我。";
		next;
		mes "[Battleground Expert]";
		mes "你可能已经知道，但通过所有专家测验会获得奖励！";
		next;
		mes "[Battleground Expert]";
		mes "我来告诉你^006400战场^000000的事！我会把知道的一切都告诉你！怎么样？想听吗？";
		next;
		switch(select("了解战场。:结束对话。")) {
		case 1:
			callsub L_Info;
			mes "[Battleground Expert]";
			mes "没有比专家亲自讲解更好的了！现在要参加我的 3 题测验吗？必须全部答对才能通过！";
			while(1) {
				set .@correct,0;
				next;
				switch(select("开始测验！:请再解释一次？:放弃。")) {
				case 1:
					switch(rand(1,3)) {
					case 1:
						mes "[Battleground Expert]";
						mes "首先，你必须选择[]阵营或[]阵营才能参加战场。";
						mes "[]的空格中应该填什么？";
						next;
						if(select("Guillaume, Tierra:Rachel, KVM:Guillaume, Croix:Maroll, KVM") == 3)
							set .@correct, .@correct+10;
						mes "[Battleground Expert]";
						mes "[]是 10 对 10，你要攻击对方的水晶，同时保护自己的水晶。";
						mes "[]的空格中应该填什么？";
						next;
						if(select("Tierra:Flavius:KVM:Maroll") == 2)
							set .@correct, .@correct+10;
						mes "[Battleground Expert]";
						mes "完成战斗后可能获得奖励！KVM 战斗会奖励[]。";
						mes "[]的空格中应该填什么？";
						next;
						if(select("KVM Badge:Valor Badge:Bravery Badge:Honor Badge") == 1)
							set .@correct, .@correct+10;
						break;
					case 2:
						mes "[Battleground Expert]";
						mes "[]是 10 对 10。你还要攻击敌人的补给仓库，同时保护自己的仓库。";
						mes "[]的空格中应该填什么？";
						next;
						if(select("Maroll:KVM:Flavius:Tierra") == 4)
							set .@correct, .@correct+10;
						mes "[Battleground Expert]";
						mes "想进入战场，以下哪一个不是你需要寻找的招募员？";
						next;
						if(select("Maroll Mercenary Recruiter:KVM Mercenary Recruiter:Tierra Mercenary Recruiter:Flavius Mercenary Recruiter") == 1)
							set .@correct, .@correct+10;
						mes "[Battleground Expert]";
						mes "参加 Tierra 战场可以获得[]。";
						mes "[]的空格中应该填什么？";
						next;
						if(select("KVM Badge:Valor Badge:Bravery Badge:Honor Badge") == 2)
							set .@correct, .@correct+10;
						break;
					case 3:
						mes "[Battleground Expert]";
						mes "在每个主要城镇，你都能找到[]进入战场。";
						mes "[]的空格中应该填什么？";
						next;
						if(select("Maroll Battleground Recruiter:Tierra Battleground Recruiter:Flavius Battleground Recruiter:KVM Battleground Recruiter") == 1)
							set .@correct, .@correct+10;
						mes "[Battleground Expert]";
						mes "[]是 5 对 5，目标是减少对方人数。";
						mes "[]的空格中应该填什么？";
						next;
						if(select("Maroll:Flavius:KVM:Tierra") == 3)
							set .@correct, .@correct+10;
						mes "[Battleground Expert]";
						mes "完成战斗后可以获得奖品。Flavius 的奖品叫作[]。";
						mes "[]的空格中应该填什么？";
						next;
						if(select("KVM Badge:Valor Badge:Bravery Badge:Honor Badge") == 3)
							set .@correct, .@correct+10;
						break;
					}
					if (.@correct == 30) {
						mes "[Battleground Expert]";
						mes "3 题全对！我觉得你很聪明。你已经了解一些^006400战场^000000知识了。";
						next;
						mes "[Battleground Expert]";
						mes "如果想复习^006400战场^000000的内容，随时可以来找我！";
						next;
						mes "[Battleground Expert]";
						mes "去找^0000FF纪念地下城专家^000000交谈吧！";
						completequest 4163;
						setquest 4164;
						getexp 2000,1000;
						close;
					}
					mes "[Battleground Expert]";
					mes "只有 3 题，但你没有全答对！照这样下去，你会通不过所有专家的测试。";
					next;
					mes "[Battleground Expert]";
					mes "不过如果你想再挑战一次，也可以。";
					break;
				case 2:
					callsub L_Info;
					mes "[Battleground Expert]";
					mes "没有比专家亲自讲解更好的了！现在要参加我的 3 题测验吗？必须全部答对才能通过！";
					break;
				case 3:
					mes "[Battleground Expert]";
					mes "别因放弃让我失望。如果改变主意，再来找我。";
					close;
				}
			}
			close;
		case 2:
			mes "[Battleground Expert]";
			mes "还没开始就放弃的人是胆小鬼。如果改变主意，再来找我。";
			close;
		}
		close;
	}
	mes "[Battleground Expert]";
	mes "如果想从我这里学习，就先得到^006400队伍招募专家^000000的认可。";
	close;

L_Info:
	mes "[Battleground Expert]";
	mes "简单来说，^006400战场^000000就是……";
	mes "选择^006400Guillaume 阵营^000000或^006400Croix 阵营^000000，然后彼此战斗。";
	next;
	mes "[Battleground Expert]";
	mes "^006400战场^000000有 3 种。";
	mes "第一种是^006400KVM^000000，5 对 5 的战斗，目标是减少对方人数。";
	next;
	mes "[Battleground Expert]";
	mes "第二种是 10 对 10。攻击对手的补给仓库，同时保护自己的补给仓库，称为^006400Tierra^000000。";
	next;
	mes "[Battleground Expert]";
	mes "第三种也是最后一种叫^006400Flavius^000000，同样是 10 对 10。攻击对手的水晶，同时保护自己的水晶。";
	next;
	mes "[Battleground Expert]";
	mes "想进入^006400战场^000000，去找各大城镇都有的^006400招募员 Maroll^000000。";
	next;
	mes "[Battleground Expert]";
	mes "进入后选择支持 Guillaume 或 Croix，然后在对应阵营中选择……";
	mes "^006400KVM Mercenary Recruiter^000000,";
	mes "^006400Tierra Mercenary Recruiter^000000, or";
	mes "^006400Flavius Mercenary Recruiter^000000,";
	mes "之后就能参加^006400战场^000000。";
	next;
	mes "[Battleground Expert]";
	mes "根据^006400战场^000000的结果，你也能获得奖励。";
	mes "从^006400KVM^000000获得 KVM 徽章，";
	mes "从^006400Tierra^000000获得勇气徽章，";
	mes "从^006400Flavius^000000获得英勇徽章。";
	next;
	mes "[Battleground Expert]";
	mes "使用^006400战场^000000奖励，可以获得平时无法从其他地方取得的物品。";
	mes "每种^006400战场^000000的奖励都不同，请自行确认。";
	next;
	return;
}

moc_para01,28,167,3	script	Memorial Dungeon Expert	868,{
	set .@checkquest, checkquest(4164);
	if (.@checkquest == 2) {
		mes "[Memorial Dungeon Expert]";
		mes "既然你来到这里，看来是想了解^006400纪念地下城^000000。";
		next;
		switch(select("Listen about Memorial Dungeon.:结束对话。")) {
		case 1:
			callsub L_Info;
			mes "[Memorial Dungeon Expert]";
			mes "听过专家的讲解后就很容易理解了吧？如果想再听一次，就来找我。";
			close;
		case 2:
			mes "[Memorial Dungeon Expert]";
			mes "如果想再听一次，就来找我。";
			close;
		}
	} else if (.@checkquest == 0 || .@checkquest == 1) {
		mes "[Memorial Dungeon Expert]";
		mes "我是^006400纪念地下城^000000专家！我研究^006400纪念地下城^000000已经 16 年了！";
		mes "既然你来找我，我想你已经通过了^006400战场专家^000000的测验。";
		next;
		mes "[Memorial Dungeon Expert]";
		mes "如你所知，通过所有专家的测验就能获得奖励。";
		next;
		mes "[Memorial Dungeon Expert]";
		mes "作为第四位专家，我会向你说明^006400纪念地下城^000000的一切。";
		mes "想听听^006400纪念地下城^000000的介绍吗？";
		next;
		switch(select("Listen about Memorial Dungeon.:结束对话。")) {
		case 1:
			callsub L_Info;
			mes "[Memorial Dungeon Expert]";
			mes "听过专家的讲解后就很容易理解了吧？如果想再听一次，就来找我。";
			mes "好，现在我要出一份测验。必须全部答对才能通过。准备好了吗？";
			while(1) {
				set .@correct,0;
				next;
				switch(select("开始测验！:请再解释一次？:放弃。")) {
				case 1:
					switch(rand(1,3)) {
					case 1:
						mes "[Memorial Dungeon Expert]";
						mes "^006400Memorial Dungeon^000000 isn't a dungeon that is open to all users. It's only available to you and your [].";
						mes "[]的空格中应该填什么？";
						next;
						if(select("Party Members:Guildmates:Friends:Family") == 1)
							set .@correct, .@correct+10;
						mes "[Memorial Dungeon Expert]";
						mes "前往[]找到[]，他会告诉你关于无限塔的信息——那是一座巨大高耸的地下城。";
						mes "[]的空格中应该填什么？";
						next;
						if(select("Prontera, Seiyablem:Alberta, Leyablem:Alberta, Captain Jansen:Prontera, Captin Jansen") == 3)
							set .@correct, .@correct+10;
						mes "[Memorial Dungeon Expert]";
						mes "要进入纪念地下城，[]必须先申请并待命。进入顺序按申请时间决定。";
						mes "[]的空格中应该填什么？";
						next;
						if(select("Guild Member:Guild Leader:Party Leader:Party Member") == 3)
							set .@correct, .@correct+10;
						break;
					case 2:
						mes "[Memorial Dungeon Expert]";
						mes "完成[]后，一段时间内不能再次进入同一个地下城。";
						mes "[]的空格中应该填什么？";
						next;
						if(select("Buff:Ritual:Exploration:Inspection") == 3)
							set .@correct, .@correct+10;
						mes "[Memorial Dungeon Expert]";
						mes "前往兽人居住的兽人地图，就能找到[]。他应该能告诉你关于兽人记忆地下城的信息。";
						mes "[]的空格中应该填什么？";
						next;
						if(select("Insane Scientist:Crazy Scientist:Insane Alchemist:Crazy Alchemist") == 1)
							set .@correct, .@correct+10;
						mes "[Memorial Dungeon Expert]";
						mes "要进入纪念地下城，[]必须申请，然后按申请时间依次进入。";
						mes "你必须为此待命。";
						mes "[]的空格中应该填什么？";
						next;
						if(select("Guild Leader:Guildmate:Party Member:Party Leader") == 4)
							set .@correct, .@correct+10;
						break;
					case 3:
						mes "[Memorial Dungeon Expert]";
						mes "前往可以转职为武僧的修道院，就能遇到[]。他会告诉你关于封印巴风特地下城的信息。";
						mes "[]的空格中应该填什么？";
						next;
						if(select("Agent Patrick:Patrolman Patrick:Drunken Patrick:Detective Patrick") == 4)
							set .@correct, .@correct+10;
						mes "[Memorial Dungeon Expert]";
						mes "完成[]后，一段时间内不能再次进入同一个地下城。";
						mes "[]的空格中应该填什么？";
						next;
						if(select("Exploration:Inspection:Buff:Ritual") == 1)
							set .@correct, .@correct+10;
						mes "[Memorial Dungeon Expert]";
						mes "^006400Memorial Dungeon^000000 is not just open to all users. It is open available for you and your [].";
						mes "[]的空格中应该填什么？";
						next;
						if(select("Friends:Family:Party Members:Guildmates") == 3)
							set .@correct, .@correct+10;
						break;
					}
					if (.@correct == 30) {
						mes "[Memorial Dungeon Expert]";
						mes "你真聪明～三个问题全答对了。现在了解^006400纪念地下城^000000了吗？";
						next;
						mes "[Memorial Dungeon Expert]";
						mes "如果想复习^006400纪念地下城^000000的内容，随时来找我。";
						next;
						mes "[Memorial Dungeon Expert]";
						mes "现在去找^0000FF地图专家^000000吧！";
						completequest 4164;
						setquest 4165;
						getexp 2000,1000;
						close;
					}
					mes "[Memorial Dungeon Expert]";
					mes "测验没那么难……";
					next;
					mes "[Memorial Dungeon Expert]";
					mes "你看起来很有潜力……应该再试一次。";
					break;
				case 2:
					callsub L_Info;
					mes "[Memorial Dungeon Expert]";
					mes "由我这样的专家讲解当然容易理解。现在是测验时间，必须全部答对才能通过。准备好了吗？";
					break;
				case 3:
					mes "[Memorial Dungeon Expert]";
					mes "放弃很没意思。如果改变主意，就来找我。";
					close;
				}
			}
			close;
		case 2:
			mes "[Memorial Dungeon Expert]";
			mes "还没尝试就放弃很没意思。如果改变主意，就来找我。";
			close;
		}
		close;
	}
	mes "[Memorial Dungeon Expert]";
	mes "如果想从我这里学习，就先和^006400战场大师^000000交谈并得到他的认可。";
	close;

L_Info:
	mes "[Memorial Dungeon Expert]";
	mes "^006400纪念地下城^000000不是对所有人开放的地下城，只对^0000FF你和队伍成员^000000开放。";
	next;
	mes "[Memorial Dungeon Expert]";
	mes "因此，进入^006400纪念地下城^000000需要由队长申请。进入顺序按申请时间决定，所以必须排队等待。";
	next;
	mes "[Memorial Dungeon Expert]";
	mes "此外，探索完纪念地下城后，一段时间内不能再次进入同一个^006400纪念地下城^000000。";
	next;
	mes "[Memorial Dungeon Expert]";
	mes "米德加尔特有许多^006400纪念地下城^000000，我们会提供提示帮助你找到它们。";
	next;
	mes "[Memorial Dungeon Expert]";
	mes "首先，前往^8B4513艾尔贝塔^000000寻找^006400Jansen 船长^000000。";
	mes "他会告诉你关于巨大高塔^006400无限塔^000000的信息。";
	next;
	mes "[Memorial Dungeon Expert]";
	mes "其次，前往兽人居住的^8B4513兽人地图^000000寻找^006400疯狂科学家^000000。";
	mes "你或许能得到关于^006400兽人记忆^000000地下城的信息。";
	next;
	mes "[Memorial Dungeon Expert]";
	mes "第三也是最后，前往可以转职为武僧的^8B4513修道院^000000，寻找^006400侦探 Patrick^000000。";
	mes "他会告诉你关于^006400封印巴风特^000000地下城的信息。";
	next;
	mes "[Memorial Dungeon Expert]";
	mes "当然还有其他纪念地下城，但最好先从容易找到的地方开始。";
	mes "随着冒险继续，你会越来越容易找到它们。";
	next;
	return;
}

moc_para01,14,168,6	script	Map Expert	743,{
	set .@checkquest, checkquest(4165);
	if (.@checkquest == 2) {
		mes "[Map Expert]";
		mes "既然你来找我，我想你一定对^006400地图^000000有些疑问？";
		next;
		switch(select("List about the Map.:结束对话。")) {
		case 1:
			callsub L_Info;
			mes "[Map Expert]";
			mes "冒险时如果到达那些区域，记得把见闻都告诉我！";
			mes "现在，既然你通过了所有专家的测验，就去和^006400教程目标^000000交谈吧。";
			close;
		case 2:
			mes "[Map Expert]";
			mes "如果还有问题，就来找我。";
			close;
		}
	} else if (.@checkquest == 0 || .@checkquest == 1) {
		mes "[Map Expert]";
		mes "我研究^006400地图^000000已经 16 年，所以现在是^006400地图^000000专家！";
		mes "既然你来找我，看来你已经通过了^006400纪念地下城专家^000000的测验。";
		next;
		mes "[Map Expert]";
		mes "如你所知，通过所有专家的测验就能获得奖励。";
		next;
		mes "[Map Expert]";
		mes "作为最后一位专家，我会尽量把^006400地图^000000讲得简单易懂。准备开始了吗？";
		next;
		switch(select("Listen about Maps.:结束对话。")) {
		case 1:
			callsub L_Info;
			mes "[Map Expert]";
			mes "我的说明怎么样？现在来个小测验！必须全部答对才能通过。准备好了吗？";
			while(1) {
				set .@correct,0;
				next;
				switch(select("开始测验！:请再解释一次？:放弃。")) {
				case 1:
					switch(rand(1,3)) {
					case 1:
						mes "[Map Expert]";
						mes "点击左上方的[]按钮即可查看地图。";
						mes "[]的空格中应该填什么？";
						next;
						if(select("SKILL:GUILD:MAP:BOOKING") == 3)
							set .@correct, .@correct+10;
						mes "[Map Expert]";
						mes "查看地图时，每个区域都会提供怪物的[]和[]信息，帮助你决定该去哪里狩猎。";
						mes "[]的空格中应该填什么？";
						next;
						if(select("Name, Age:Attributes, Level:Attributes, Tribe:Name, Level") == 4)
							set .@correct, .@correct+10;
						mes "[Map Expert]";
						mes "如果想停止查看地图，只需按[]快捷键或 ESC，即可关闭地图。";
						mes "[]的空格中应该填什么？";
						next;
						if(select("ALT + F4:CTRL + %:CTRL + M:ALT + ESC") == 2)
							set .@correct, .@correct+10;
						break;
					case 2:
						mes "[Map Expert]";
						mes "打开地图后，";
						mes "将鼠标悬停在特定区域上，";
						mes "就能看到该区域的[]和[]。";
						mes "[]的空格中应该填什么？";

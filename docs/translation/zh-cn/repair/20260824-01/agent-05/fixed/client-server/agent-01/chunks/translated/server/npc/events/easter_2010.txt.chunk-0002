			mes "如果你感兴趣，";
			mes "赚到 Zeny 后再来。";
			mes "哈哈……";
			mes "我会等着你。";
			close2;
			playbgm "08.mp3"; // Theme of Prontera
			emotion ET_KIK;
			end;
		}
	}
	emotion ET_MERONG;
	mes "[Rina's Little Friend]";
	mes "咳咳！";
	mes "怎么了？看到我说话很惊讶吗？";
	mes "我理解你。";
	mes "只有参加过";
	mes "宣誓仪式的人才能和我交谈。";
	next;
	mes "[Rina's Little Friend]";
	mes "如果 Rina 的诅咒被解除，";
	mes "我也可以";
	mes "给你建议";
	mes "一件有趣的事。";
	next;
	mes "[Rina's Little Friend]";
	mes "详细说明以后再告诉你。";
	mes "那么回头见，我的朋友。";
	close;
	}



	
	prontera,116,82,5	script	Traveler#01Easter	85,{
	mes "[Traveler]";
	mes "我是旅行者，";
	mes "经常造访 ^8B4513普隆德拉^000000。";
	mes "嗯，我想以前可能";
	mes "在这里见过你。";
		next;
		if(select("继续听。:别理他。") == 2) {
		mes "[Traveler]";
		mes "正如我所料，";
		mes "你是个沉默的人。哈哈。";
	mes "再见。";
	close;
	}
	mes "[Traveler]";
	mes "几天前，";
	mes "我看到一位新冒险者";
	mes "站在^8B4513大教堂^000000附近。";
	next;
	emotion ET_THROB;
	mes "[Traveler]";
	mes "那位冒险者看起来很漂亮。";
	mes "但是……";
	mes "我感觉到奇怪的能量，";
	mes "所以没有靠近。";
	next;
	mes "[Traveler]";
	mes "看起来";
	mes "你对那位新冒险者";
	mes "很感兴趣？";
	mes "还是你只是这副表情？哈哈。";
	next;
		if(select("我对此感兴趣。:我完全不在乎。") == 2) {
		mes "[Traveler]";
		mes "啊~我明白了~！";
		mes "那么，再见。";
	close;
	}
	mes "[Traveler]";
	mes "正如我所料！";
	mes "你可以在前往^8B4513大教堂^000000的路上，";
	mes "^8B4513普隆德拉^000000 1 点钟方向";
	mes "找到那位新冒险者。";
	next;
	mes "[Traveler]";
	mes "她带着";
	mes "^800080一个大蛋状物^000000。";
	mes "我只知道这些。";
	close;
OnInit:
	initnpctimer;
	end;
OnTimer5000:
	emotion ET_SURPRISE;
	stopnpctimer;
	initnpctimer;
	end;
}


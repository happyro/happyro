				mes "在洞穴中徘徊的年老小妖精";
				mes "收集矿石。他们是惊人的";
				mes "老烟枪。";
				mes "^0099FF掉落物^000000：老皮克西的胡须";
				next;
				break;
			case 2:
				mes "^FF0000[第 11 卷：中型地属性怪物]^000000";
				mes "1. 树精";
				mes "从古树中重生的生物。";
				mes "它的外貌和声音";
				mes "令人毛骨悚然。";
				mes "^0099FF掉落物^000000：树根、树干、红色";
				mes "药草、甜薯";
				next;
				mes "^FF0000[第 11 卷：中型地属性怪物]^000000";
				mes "2. 摇滚蝗虫";
				mes "喜欢";
				mes "拉小提琴的懒惰蚱蜢，就像";
				mes "伊索寓言一样。";
				mes "^0099FF掉落物^000000：蝗虫后腿、";
				mes "凝固的液体";
				next;
				mes "^FF0000[第 11 卷：中型地属性怪物]^000000";
				mes "3. 曼陀罗魔花";
				mes "虽然它待在原地，";
				mes "却能从远处攻击路人，";
				mes "使用地下";
				mes "茎。";
				mes "^0099FF掉落物^000000：茎、绿色药草、";
				mes "新芽";
				next;
				mes "^FF0000[第 11 卷：中型地属性怪物]^000000";
				mes "4. 狼";
				mes "拥有蓝色鬃毛的野狼。";
				mes "鬃毛。当其中一只受到威胁时，";
				mes "它们往往会成群攻击。";
				mes "它们往往会成群攻击。";
				mes "^0099FF掉落物^000000：狼爪、肉、";
				mes "魔物饲料、动物皮";
				next;
				mes "^FF0000[第 11 卷：中型地属性怪物]^000000";
				mes "5. 蛇";
				mes "生活在";
				mes "森林和沙漠中的绿色蛇。它们无毒，";
				mes "但咬伤仍然";
				mes "很痛。";
				mes "^0099FF掉落物^000000：蛇鳞、红色药草";
				next;
				mes "^FF0000[第 11 卷：中型地属性怪物]^000000";
				mes "6. 大角";
				mes "虽然看起来凶猛，其实是";
				mes "和平的昆虫。它";
				mes "在田野中发出";
				mes "嘎吱声游荡。";
				mes "^0099FF掉落物^000000：角、贝壳、硬";
				mes "壳";
				next;
				mes "^FF0000[第 11 卷：中型地属性怪物]^000000";
				mes "7. 兽人战士";
				mes "骄傲的";
				mes "兽人战士。曾经兽人和人类";
				mes "是盟友，但现在他们是";
				mes "死敌。";
				mes "^0099FF掉落物^000000：兽人凭证";
				next;
				mes "^FF0000[第 11 卷：中型地属性怪物]^000000";
				mes "8. 土人魔";
				mes "通常藏在地下的巨大蚯蚓。";
				mes "通常可以";
				mes "在沙漠中找到。";
				mes "^0099FF掉落物^000000：蚯蚓皮、";
				mes "粘稠液体";
				next;
				mes "^FF0000[第 11 卷：中型地属性怪物]^000000";
				mes "9. 螳螂";
				mes "它在田野间徘徊，挥舞着一把";
				mes "小扇子。整套武术招式都源自";
				mes "这种昆虫的动作。";
				mes "^0099FF掉落物^000000：螳螂镰刀、甲壳碎片、";
				mes "硬壳、红色药草";
				next;
				mes "^FF0000[第 11 卷：中型地属性怪物]^000000";
				mes "10. 野猪";
				mes "一只四处游荡、";
				mes "焦躁地哼叫的野猪。它粗糙的獠牙";
				mes "让人很难相信它小时候";
				mes "曾经那么可爱。";
				mes "^0099FF掉落物^000000：鬃毛、动物皮";
				next;
				mes "^FF0000[第 11 卷：中型地属性怪物]^000000";
				mes "11. 小龙";
				mes "可爱的步行龙。还有一种会飞的";
				mes "小龙，";
				mes "但那一种属于风属性。";
				mes "^0099FF掉落物^000000：龙牙、龙";
				mes "尾、杰勒比结晶";
				next;
				break;
			case 3:
				mes "^FF0000[第 12 卷：大型地属性怪物]^000000";
				mes "1. 蚯蚓尾";
				mes "一种奇怪的魔物，会用看起来像";
				mes "草叶的尾巴发动鞭打攻击。";
				mes "^0099FF掉落物^000000：尖锐鳞片、黄色";
				mes "药草";
				next;
				mes "^FF0000[第 12 卷：大型地属性怪物]^000000";
				mes "2. 木卡";
				mes "沙漠中常见的可爱仙人掌。它试图";
				mes "用咆哮吓唬路人，但发出的声音";
				mes "实在太滑稽，根本无法让人害怕。";
				mes "^0099FF掉落物^000000：仙人掌刺、空";
				mes "瓶、绿色药草、红色药草";
				next;
				mes "^FF0000[第 12 卷：大型地属性怪物]^000000";
				mes "3. 大脚熊";
				mes "虽然名字可能会误导人，但大脚熊";
				mes "其实是一只巨大的熊。它走在森林里，";
				mes "就像森林属于它一样，而事实也确实如此。";
				mes "^0099FF掉落物^000000：熊掌皮、";
				mes "动物皮、甜薯";
				next;
				mes "^FF0000[第 12 卷：大型地属性怪物]^000000";
				mes "4. 花妖";
				mes "一种食人的植物。它的部位被认为";
				mes "对炼金术士很有用，可以用来";
				mes "制造属于自己的魔物……";
				mes "^0099FF掉落物^000000：食人花花瓣、茎";
				next;
				break;
			case 4:
				close;
			}
		}

	case 2:
		while(1) {
				switch(select("小型魔物:中型魔物:大型魔物:取消")) {
			case 1:
				mes "^FF0000[第 13 卷：小型火属性怪物]^000000";
				mes "1. 皮奇";
				mes "可爱的小鸡，长大后可能会变成";
				mes "大嘴鸟，当然，前提是你不把它杀掉。";
				mes "^0099FF掉落物^000000：鸟羽、";
				mes "羽毛、红色药草、牛奶";
				next;
				mes "^FF0000[第 13 卷：小型火属性怪物]^000000";
				mes "2. 小沙狼";
				mes "小沙狼试图用可爱的呜咽声";
				mes "吓唬冒险者。";
				mes "^0099FF掉落物^000000：动物皮、肉";
				next;
				mes "^FF0000[第 13 卷：小型火属性怪物]^000000";
				mes "3. 火球怪";
				mes "一种阴森而狂暴的火球。";
				mes "在这个复仇的灵魂附近使用隐藏技能";
				mes "是没有用的。";
				mes "^0099FF掉落物^000000：石心、杰勒比结晶、";
				mes "火箭";
				next;
				break;
			case 2:
				mes "^FF0000[第 14 卷：中型火属性怪物]^000000";
				mes "1. 波利";
				mes "波利的沙漠版本，颜色是淡橙色。";
				mes "不过，它似乎比普通波利";
				mes "稍微强一点。";
				mes "^0099FF掉落物^000000：凝固的液体、粘稠液体、";
				mes "苹果、空瓶、红色药草";
				next;
				mes "^FF0000[第 14 卷：中型火属性怪物]^000000";
				mes "2. 老树精";
				mes "树精的老年形态。它是红色的，";
				mes "甚至会使用一些魔法。";
				mes "^0099FF掉落物^000000：树脂、树干、甜";
				mes "薯";
				next;
				mes "^FF0000[第 14 卷：中型火属性怪物]^000000";
				mes "3. 金属波利";
				mes "摇滚蝗虫的进化形态。它呈暗褐色，";
				mes "生活在沙漠中。";
				mes "这种蟋蟀会把地上的物品";
				mes "捡起来。";
				mes "^0099FF掉落物^000000：红色血液、";
				mes "蝗虫后腿、甲壳碎片、贝壳";
				next;
				mes "^FF0000[第 14 卷：中型火属性怪物]^000000";
				mes "4. 僵尸";
				mes "一个不死的奴隶。可悲的是，即使死亡";
				mes "也无法让它从法老施加的残酷劳役中";
				mes "得到安宁。";
				mes "^0099FF掉落物^000000：内裤";
				next;
				mes "^FF0000[第 14 卷：中型火属性怪物]^000000";
				mes "5. 蝎子";
				mes "沙漠地区可以找到蝎子。它颜色漂亮，";
				mes "却也可能很危险。";
				mes "^0099FF掉落物^000000：蝎尾、绿色";
				mes "药草、黄色药草";
				next;
				mes "^FF0000[第 14 卷：中型火属性怪物]^000000";
				mes "6. 沙狼";
				mes "沙漠中的狼比森林里的狼强得多。";
				mes "如果你攻击其中一只，";
				mes "就得面对整个狼群。";
				mes "掉落物：动物皮、貂皮外套、";
				mes "肉、狼爪";
				next;
				mes "^FF0000[第 14 卷：中型火属性怪物]^000000";
				mes "7. 独角蜥蜴";
				mes "一种脖子上长着褶边、像扇子一样的蜥蜴。";
				mes "虽然看起来很可笑，但其实相当强。";
				mes "^0099FF掉落物^000000：蜥蜴褶边、爬虫舌头、";
				mes "红色药草、杰勒比结晶";
				next;
				mes "^FF0000[第 14 卷：中型火属性怪物]^000000";
				mes "8. 哥布灵三号";
				mes "一种蓝色、像狼一样、异常亲人的魔物。";
				mes "不过，所有哥布灵都发誓憎恨人类。";
				mes "哥布灵有很多种，使用的武器也各不相同。";
				mes "^0099FF掉落物^000000：蓝色头发、杰勒比结晶、";
				mes "黄色药草";
				next;
				mes "^FF0000[第 14 卷：中型火属性怪物]^000000";
				mes "9. 杰克";
				mes "一个长着南瓜头、穿着考究正装的阴森魔物。";
				mes "过去据说它会在万圣节前夜入侵普隆德拉。";
				mes "^0099FF掉落物^000000：杰克南瓜、杰勒比结晶";
				next;
				break;
			case 3:
				mes "^FF0000[第 15 卷：大型火属性怪物]^000000";
				mes "1. 大嘴鸟";
				mes "如今，大嘴鸟很受骑士和十字军欢迎，";
				mes "是他们常用的坐骑。";
				mes "它们生活在沙漠或森林中，";
				mes "其中一只受到威胁时也会成群攻击。";
				mes "^0099FF掉落物^000000：鸟嘴、黄色";
				mes "药草、红色药草";
				next;
				mes "^FF0000[第 15 卷：大型火属性怪物]^000000";
				mes "2. 玛尔杜克";
				mes "一个身形瘦长的黑暗巫师。小心，";
				mes "它会使用魔法！";
				mes "^0099FF掉落物^000000：火焰心脏";
				next;
				break;
			case 4:
				close;
			}
		}

	case 3:
		while(1) {
		switch(select("小型魔物:中型魔物:大型魔物:取消")) {
			case 1:
				mes "^FF0000[第 16 卷：小型无属性怪物]^000000";
				mes "1. 疯兔";
				mes "一种毛茸茸、长得有点像兔子的魔物。";
				mes "虽然有些人觉得它可爱，";
				mes "但作者认为它丑陋至极。";
				mes "也许这是因为作者对它过敏。";
				mes "^0099FF掉落物^000000：四叶幸运草、羽毛、";
				mes "胡萝卜、红色药草";
				next;
				mes "^FF0000[第 16 卷：小型无属性怪物]^000000";
				mes "2. 大嘴鸟蛋";
				mes "大嘴鸟的蛋。它又小又没有防备，";
				mes "是初心者的完美目标。";
				mes "^0099FF掉落物^000000：贝壳、红色药草、";
				mes "空瓶";
				next;
				mes "^FF0000[第 16 卷：小型无属性怪物]^000000";
				mes "3. 蚂蚁卵";
				mes "同样毫无防备的蚂蚁卵。";
				mes "不过，其中一些确实会孵化。";
				mes "^0099FF掉落物^000000：贝壳、凝固的液体、粘稠";
				mes "液体、空瓶";
				next;
				mes "^FF0000[第 16 卷：小型无属性怪物]^000000";
				mes "4. 小盗虫";
				mes "肮脏污秽、喜欢成群行动的生物。";
				mes "无论如何，都别让它们污染普隆德拉";
				mes "下水道，否则会是一场灾难！";
				mes "^0099FF掉落物^000000：蚯蚓皮、红色药草、";
				mes "凝固的液体";
				next;
				break;
			case 2:
				mes "^FF0000[第 17 卷：中型无属性怪物]^000000";
				mes "^0099FF...^000000";
				next;
				mes "^FF0000[第 17 卷：中型无属性怪物]^000000";
				mes "^0099FF...^000000";
				mes "^0099FF......^000000";
				next;







				mes "^0099FF这本书有几页^000000";
				mes "^0099FF似乎被撕掉了，^000000";
				mes "^0099FF取而代之的是伊希斯魔物的写真。^000000";
				mes "^0099FF看来你得^000000";
				mes "^0099FF自己了解中型无属性^000000";
				mes "^0099FF魔物的知识了。^000000";
				next;
				break;
			case 3:
				mes "^FF0000[第 18 卷：大型无属性怪物]^000000";
				mes "1. 石头人";
				mes "一种被黑魔法赋予生命的石头生物。";
				mes "它能识别施法，但由于体重问题，";
				mes "移动速度极其缓慢。";
				mes "^0099FF掉落物^000000：甲壳碎片";
				next;
				break;
			case 4:
				close;
			}
		}
	case 4:
		close;
	}
}

prt_in,161,50,4	script	Monster Encyclopedia#3pr	HIDDEN_NPC,{
	mes "^FF0000[魔物图鉴]^000000";
	mes "这是一本魔物图鉴，";
	mes "收录暗属性、毒属性和不死属性";
	mes "魔物的信息。";
	next;
	switch(select("暗属性魔物:毒属性魔物:不死属性魔物:取消")) {
	case 1:
		while(1) {
				switch(select("小型魔物:中型魔物:大型魔物:取消")) {
			case 1:
					mes "^FF0000[第 19 卷：小型暗属性怪物]^000000";
					mes "1. 盗虫蛋";
					mes "来自肮脏盗虫的肮脏虫卵。";
					mes "用它做出的煎蛋会非常可怕。";
					mes "^0099FF掉落物^000000：蛹壳、粘稠";
					mes "液体";
				next;
				mes "^FF0000[第 19 卷：小型暗属性怪物]^000000";
				mes "2. 吸血蝙蝠";
				mes "一种灰色蝙蝠，实力不强，";
				mes "却非常烦人，因为它攻击速度极快，";
				mes "会不停追逐路人。";
				mes "^0099FF掉落物^000000：蝙蝠牙、苍蝇翅膀、";
				mes "葡萄、红色药草";
				next;
				mes "^FF0000[第 19 卷：小型暗属性怪物]^000000";
				mes "3. 塔鲁";
				mes "一只小小的白色老鼠。在死亡之井";
				mes "和普隆德拉下水道都能听见它的吱吱声。";
				mes "^0099FF掉落物^000000：鼠尾、动物";
				mes "皮、羽毛、魔物饲料";
				next;
				mes "^FF0000[第 19 卷：小型暗属性怪物]^000000";
				mes "4. 吸血鬼蝙蝠";
				mes "一种血红色的蝙蝠，比吸血蝙蝠强得多。";
				mes "它还会追逐遇到的任何人。";
				mes "^0099FF掉落物^000000：蝙蝠牙、红色药草";
				next;
				mes "^FF0000[第 19 卷：小型暗属性怪物]^000000";
				mes "5. 哥布灵";
				mes "一种能带来财富的传统韩国妖怪。";
				mes "对它们来说，使用金钱攻击并不是什么难事。";
				mes "^0099FF掉落物^000000：哥布灵角";
				next;
				mes "^FF0000[第 19 卷：小型暗属性怪物]^000000";
				mes "6. 小恶魔";
				mes "一个用干草叉反复刺向人类的小恶魔。";
				mes "它很可爱，但仍是真正的黑暗恶魔。";
				mes "^0099FF掉落物^000000：小恶魔角、";
				mes "小恶魔翅膀、杰勒比结晶";
				next;
				break;
			case 2:
				mes "^FF0000[第 20 卷：中型暗属性怪物]^000000";
				mes "1. 盗虫（雌）";
				mes "体型庞大的棕色昆虫，看起来十分可怕，";
				mes "摸起来也令人恶心。它们臭名昭著，";
				mes "会迅速抓走掉在地上的任何物品。";
				mes "^0099FF掉落物^000000：蚯蚓皮、红色药草、";
				mes "凝固的液体、加勒结晶、昆虫触角";
				next;
				mes "^FF0000[第 20 卷：中型暗属性怪物]^000000";
				mes "2. 盗虫（雄）";
				mes "一种大型绿色昆虫，盗虫（雄）相当强大，";
				mes "对人类也非常具有攻击性。";
				mes "^0099FF掉落物^000000：蚯蚓皮、红色药草、";
				mes "凝固的液体、加勒结晶、昆虫触角、";
				mes "黄色药草";
				next;
				mes "^FF0000[第 20 卷：中型暗属性怪物]^000000";
				mes "3. 玛特瑞";
				mes "一只浑身充满邪恶的猎犬。它总是在睡觉，";
				mes "但闻到冒险者的气味后就会立刻行动。";
				mes "^0099FF掉落物^000000：魔物饲料、动物皮";
				next;
				mes "^FF0000[第 20 卷：中型暗属性怪物]^000000";
				mes "4. 僵尸兽人";
				mes "一种身体受到诅咒、没有荣誉的兽人。";
				mes "它们继续以卑劣的方式行事，";
				mes "掠夺掉在地上的物品。";
				mes "^0099FF掉落物^000000：僵尸兽人的獠牙、粘稠";
				mes "液体、黄色药草";
				next;
				mes "^FF0000[第 20 卷：中型暗属性怪物]^000000";
				mes "5. 安魂者";
				mes "一个背着沉重棺材的古代奴隶。";

//===== Description: ========================================= 
//= Gunslinger Job Change Quest
//===== Additional Comments: ================================= 
//= 1.0 Made the NPC [erKURITA]
//= 1.5 Couple fixes to the npc, aswell as adding the missing
//=     3 green herbs. [erKURITA]
//= 1.6 job number->const, commonized variable name,
//=     optimized [Lupus]
//= 1.7 Now uses only ONE variable GUNS_Q [Lupus]
//= 1.7a Grammar fixes, few spelling fixes, etc [CBMaster]
//= 1.7b Parenthesis fixes [KarLaeda]
//= 1.8 Fixed the reward you can get [Playtester]
//= 1.9 Removed some 'clever' script constructs [ultramage]
//= 2.0 Updated to official version - Thanks to Omega for
//=     his first try [SinSloth] 1.10b - removed .GATs [Lupus]
//= 2.1 Wise Bull Horn now deletes all items. Thanks to yyCC. [L0ne_W0lf]
//= 2.1a Corrected a Typo error ";;". [Samuray22]
//= 2.1b Corrected some typos errors. (bugreport:1549) [Samuray22]
//= 2.1c Fixed some missing/messed up item checks. (bugreport:2693) [Kisuka]
//= 2.2 Updated to match AEGIS script and Added Quest Log commands. [Kisuka]
//============================================================ 

que_ng,152,167,3	script	Master Miller	901,{
	if (Upper == 2) {
		mes "[Master Miller]";
		mes "哎呀，这不是可爱的小孩吗～";
		mes "你的妈妈在哪里？";
		mes "这里很危险，请快回家，好吗？";
		mes "";
		mes "";
		close;
	}
	if (Class == Job_Novice) {
		if (!callfunc("F_CanChangeJob")) {
			mes "[Master Miller]";
			mes "想成为枪手吗？你有潜力，";
			mes "但经验还不够。";
			mes "再训练一阵子后回来，听到了吗？";
			mes "";
			mes "";
			mes "";
			close;
		}
		if (GUNS_Q == 0) {
			mes "[Master Miller]";
			mes "我是 Miller，全职枪手教官，";
			mes "也是 Selena 女士的守卫。";
			mes "你需要什么？如果不重要，我没时间陪你。";
			mes "";
			mes "";
			next;
			if(select("没什么。:我想成为枪手。") == 1) {
				mes "[Master Miller]";
				mes "别浪费我的时间。";
				mes "想成为枪手就回来找我。";
				mes "";
				mes "";
				close;
			}
			mes "[Master Miller]";
			mes "嗯，你很年轻，但你的眼神告诉我你很有野心。";
			mes "成为枪手必须通过面试和教育课程。你要申请吗？";
			mes "";
			mes "";
			next;
			if(select("给我时间想想。:当然！") == 1) {
				mes "[Master Miller]";
				mes "可以理解。";
				mes "如果决定成为枪手，马上告诉我。";
				mes "我会帮你开始。";
				mes "";
				mes "";
				mes "";
				close;
			}
			mes "[Master Miller]";
			mes "太好了。那么开始吧。";
			mes "把这封信交给斐扬的 Wise Bull Horn 先生。";
			mes "他是萨满，会判断你是否有资格成为枪手。";
			mes "";
			mes "";
			mes "";
			set GUNS_Q,1;
			setquest 6020;
			close;
		}
		else if (GUNS_Q == 1) {
			mes "[Master Miller]";
			mes "把我写的介绍信交给斐扬的 Wise Bull Horn 先生。";
			mes "他会测试你是否具备枪手资质。";
			mes "";
			mes "";
			mes "";
			mes "";
			close;
		}
		else if (GUNS_Q == 2) {
			mes "[Master Miller]";
			mes "嗯……Wise Bull Horn 让你收集制作凭证的材料？";
			mes "嗯，我想这是资格测试的一部分。";
			mes "";
			mes "";
			mes "";
			close;
		}
		else if (GUNS_Q == 3) {
			mes "[Master Miller]";
			mes "Wise Bull Horn 让你带牛奶给他？";
			mes "他已经开始拜托你，看来很喜欢你。朋友，祝你好运。";
			mes "";
			mes "";
			mes "";
			close;
		}
		else if (GUNS_Q == 4) {
			mes "[Master Miller]";
			mes "我期待很快听到你的好消息。";
			mes "我确信你会成为枪手。";
			mes "";
			mes "";
			close;
		}
		else if (GUNS_Q == 5) {
			if (SkillPoint != 0) {
				mes "[Master Miller]";
				mes "嘿，你还有剩余技能点。";
				mes "在回来找我前最好全部用掉。";
				mes "";
				mes "";
				close;
			}
			mes "[Master Miller]";
			mes "哦，你带来了 Wise Bull Horn 的凭证？";
			mes "他很久没给别人凭证了，我真为你骄傲！";
			mes "";
			mes "";
			mes "";
			next;
			mes "[Master Miller]";
			mes "如果 Wise Bull Horn 认可你，";
			mes "我没有理由拒绝。好吧，我会把你转职为枪手。";
			mes "但先让我详细说明我们的工作。";
			mes "";
			mes "";
			mes "";
			next;
			mes "[Master Miller]";
			mes "作为枪手，你必须随身携带枪。";
			mes "枪手公会监管所有枪械和子弹，";
			mes "所以只能从公会成员那里购买。";
			mes "";
			mes "";
			mes "";
			next;
			mes "[Master Miller]";
			mes "别担心，现在到处都能找到枪手公会成员。";
			mes "这是公会领袖 Selena 女士的命令。";
			mes "";
			mes "";
			next;
			mes "[Master Miller]";
			mes "总有一天你也许能见到她。";
			mes "我们必须规范枪械和子弹销售，避免落入邪恶或不负责任的人手中。";
			mes "";
			mes "";
			mes "";
			next;
			mes "[Master Miller]";
			mes "无论如何，和另一位枪手交谈总是很愉快。保持联系吧。";
			mes "愿大地之力在你的冒险中保护你～";
			mes "";
			mes "";
			mes "";
			mes "";
			callfunc "Job_Change",Job_Gunslinger;
			set GUNS_Q,6;
			completequest 6024;
			if (checkre(0)) {
				getitem 13180,1;		// Novice_Rifle
				getitem 12149,2;		// Bullet_Case
				getitem 12151,1;		// Bullet_Case_Silver
			} else {
				if (rand(2))
					getitem 13100,1;	// Six_Shooter
				else
					getitem 13150,1;	// Branch
			}
			close;
		}
	} else {
		if (Class == Job_Gunslinger) {
			mes "[Master Miller]";
			mes "哦！好久不见，朋友。最近好吗？";
			mes "希望你一直把枪保养好。照顾好它，它也会照顾你。记住这点。";
			mes "";
			mes "";
			mes "";
			mes "";
			close;
		} else {
			mes "[Master Miller]";
			mes "如果没事找我，";
			mes "那就请离开吧。";
			mes "";
			close;
		}
	}
}

payon,184,65,3	script	Wise Bull Horn	866,{
	if (GUNS_Q == 1) {
		mes "[Wise Bull Horn]";
		mes "你好，年轻的狼。";
		mes "是什么事让你来到我面前？";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "Miller 先生让我把这封信交给你。";
		mes "其实，我想成为一名枪手……";
		next;
		mes "[Wise Bull Horn]";
		mes "你说 Miller？Black Fox 不会为他认为无法成为优秀枪手的人写介绍信。";
		mes "嗯，我想我知道他为什么派你来。";
		next;
		mes "[Wise Bull Horn]";
		mes "我能从你的眼神看出来：你有一颗温暖的心，也有强烈的责任感。";
		mes "你只需要大地的祝福来守护枪手之路。";
		next;
		mes "[Wise Bull Horn]";
		mes "我可以制作一张凭证，证明你立志成为大地战士，再把它交给枪手教官。";
		mes "我需要这些材料……";
		next;
		mes "[Wise Bull Horn]";
		mes "^3355FF1 个树干^000000，";
		mes "^3355FF3 个绒毛^000000，";
		mes "^3355FF3 个刹勒空结晶^000000，";
		mes "^3355FF10 个硬壳^000000，";
		mes "^3355FF3 个绿色药草^000000，以及";
		mes "^3355FF3 个彩色外皮^000000。";
		next;
		mes "[Wise Bull Horn]";
		mes "凭证完成后，把它带给 Black Fox。";
		mes "他会帮助你实现成为枪手的目标。";
		set GUNS_Q,2;
		changequest 6020,6021;
		close;
	}
	else if (GUNS_Q == 2) {
		if (countitem(912) < 3 || countitem(914) < 3 || countitem(1019) < 1 || countitem(935) < 10 || countitem(511) < 3 || countitem(1013) < 3) {
			mes "[Wise Bull Horn]";
			mes "我可以制作一张凭证，证明你立志成为大地战士，再把它交给枪手教官。";
			mes "我还需要这些材料……";
			next;
			mes "[Wise Bull Horn]";
			mes "^3355FF1 个树干^000000，";
			mes "^3355FF3 个绒毛^000000，";
			mes "^3355FF3 个刹勒空结晶^000000，";
			mes "^3355FF10 个硬壳^000000，";
			mes "^3355FF3 个绿色药草^000000，以及";
			mes "^3355FF3 个彩色外皮^000000。";
			next;
			mes "[Wise Bull Horn]";
			mes "凭证完成后，把它带给 Black Fox。";
			mes "他会帮助你实现成为枪手的目标。";
			close;
		}
		delitem 912,3; // Zargon
		delitem 914,3; // Fluff
		delitem 1019,1; // Wooden_Block
		delitem 935,10; // Shell
		delitem 511,3; // Green_Herb
		delitem 1013,3; // Colorful_Shell
		set GUNS_Q,3;
		changequest 6021,6022;
		mes "[Wise Bull Horn]";
		mes "啊，你把需要的东西都带来了。";
		mes "请给我一点时间制作凭证，过一会儿再来，我应该就能完成。";
		close;
	}
	else if (GUNS_Q == 3) {
		mes "[Wise Bull Horn]";
		mes "哦，你来得正好。我已经很久没有制作这种凭证了，手法可能有些生疏。";
		mes "不过，这真让我想起年轻时的日子。";
		next;
		mes "[Wise Bull Horn]";
		mes "几十年来，我一直负责挑选值得获得枪手凭证的人。";
		mes "在那之前，我也曾是像你一样的年轻冒险者。";
		next;
		mes "[Wise Bull Horn]";
		mes "仿佛就在昨天，我还握着自己的枪手凭证，成为大地战士。";
		mes "也是那时，我认识了 Selena 的父亲……时间怎么过得这么快？";
		next;
		mes "[Wise Bull Horn]";
		mes "我很感谢 Selena 和 Black Fox 帮忙招募年轻枪手。";
		mes "我已经老了，无法独自完成所有事情。唉……人生就是如此。";
		next;
		mes "[Wise Bull Horn]";
		mes "离开前，能请你帮个小忙吗？";
		mes "我有些口渴，想喝一杯冰牛奶。能帮我带来吗？";
		set GUNS_Q,4;
		changequest 6022,6023;
		close;
	}
	else if (GUNS_Q == 4) {
		if (countitem(519) < 1) {
			mes "[Wise Bull Horn]";
			mes "我已经是个快要回归大地母亲怀抱的老人了。";
			mes "能帮老枪手一个忙，带一杯冰牛奶来吗？";
			close;
		}
		delitem 519,1; // Milk
		set GUNS_Q,5;
		changequest 6023,6024;
		mes "[Wise Bull Horn]";
		mes "谢谢你的慷慨！你真的带来了牛奶。啊，真美味～";
		next;
		mes "[Wise Bull Horn]";
		mes "你用行动证明了自己的耐心、温和与善良。";
		mes "是的，这正是我们希望所有枪手都具备的品质。";
		next;
		mes "[Wise Bull Horn]";
		mes "现在，请带着我完全认可的这张凭证去找 Black Fox Miller。";
		mes "愿你作为高尚的大地战士，用枪维护正义。";
		next;
		mes "[Wise Bull Horn]";
		mes "咿～呀～咿～吼～";
		mes "咿～呀～咿～吼～";
		mes "玛～啦～呢～";
		mes "咿哈，咿哈，呀咿哟～";
		close;
	}
	else if (GUNS_Q == 5) {
		mes "[Wise Bull Horn]";
		mes "请带着我完全认可的这张凭证去找 Black Fox Miller。";
		mes "愿你作为高尚的大地战士，用枪维护正义。";
		next;
		mes "[Wise Bull Horn]";
		mes "咿～呀～咿～吼～";
		mes "咿～呀～咿～吼～";
		mes "玛～啦～呢～";
		mes "咿哈，咿哈，呀咿哟～";
		close;
	}
	else if (GUNS_Q == 6) {
		mes "[Wise Bull Horn]";
		mes "啊，好久不见。";
		mes "希望你成为聪明勇敢的人，用枪手的力量守护善良与正义。";
		close;
	}
	else {
		mes "[Wise Bull Horn]";
		mes "呼噜噜～";
		mes "^333333*呼～*^000000";
		close;
	}
}

			break;
		case 53:
			mes "杰克说，为了准备未来，需要进行愉快的准备。愉快的准备？我不明白……我大概太老了，年轻人也许能理解……";
			next;
			mes "[莉米托拉]";
			mes "你觉得呢？有什么猜想吗？";
			break;
		case 54:
			mes "杰克嫉妒了，因为未来有一个出色的人正朝你走来。我很好奇那是什么样的人，竟会让杰克嫉妒！";
			next;
			mes "[莉米托拉]";
			mes "有一件事可以确定：你会非常幸福！恭喜你，年轻人！";
			break;
		case 56:
			mes "杰克说你未来可能会感到沮丧。要克服沮丧，就必须想些快乐的事情。";
			next;
			mes "[莉米托拉]";
			mes "这意味着你的未来会成为快乐与沮丧之间的战斗……";
			break;
		case 57:// 小丑卡片
			mes "小丑想要欺骗你。这张牌带来各种不祥的占卜，它想看着你因焦虑而颤抖。";
			next;
			mes "[莉米托拉]";
			mes "悲伤、失败、黑暗、孤独……你可能感受到这些情绪，但它们并不致命。别担心。";
			break;
		case 58:
			mes "小丑不会只是出现后离开，它们会在未来回来，并多次诱惑你。";
			next;
			mes "[莉米托拉]";
			mes "所以训练自己不要受到诱惑，否则你会面对挫折或犯下错误。";
			break;
		case 59:
			mes "你看到小丑身边飞舞的叶状物了吗？那是黑桃标记。黑桃意味着死亡，小丑故意留下那种标记。";
			next;
			mes "[莉米托拉]";
			mes "不要被死亡标记扰乱，那只是小丑的玩笑。";
			break;
		case 60:
			mes "小丑提供保险并说要为未来做准备，但大部分只是浪费时间。";
			next;
			mes "[莉米托拉]";
			mes "不要漫不经心地为未来准备。松散的措施比准备好的冒险更糟。";
			break;
		case 61:// 霍德卡片
			mes "霍德不知道明天会怎样，但它们虽然安静，却会危害其他生物。努力提升自己，会让单纯的存在拥有巨大力量。";
			next;
			mes "[莉米托拉]";
			mes "别忘了，你最应该思考的是自己。";
			break;
		case 62:
			mes "霍德不知道明天会怎样，但它们仍然知道死亡。即使你诚实而单纯，危机时也必须保持警觉。";
			next;
			mes "[莉米托拉]";
			mes "否则你真的会成为一个单纯诚实的傻瓜，那可能很麻烦。";
			next;
			mes "[莉米托拉]";
			mes "霍德不思考生命，但求生意志非常强。仅凭坚持活下去的意志，你就能获得很多。";
			next;
			mes "[莉米托拉]";
			mes "感谢自己还活着。感恩本身会带来很大帮助。";
			break;
		case 63:
			mes "霍德害怕危机。你也应该努力不要害怕危机。";
			next;
			mes "[莉米托拉]";
			mes "别想得太多。危机就只是危机。";
			break;
		case 64:// 米诺斯卡片
			mes "过去，人们认为公牛是愚蠢而诚实的工人，但如今公牛是强大的战士。";
			next;
			mes "[莉米托拉]";
			mes "发现自己的不同面向是进步之道。了解自己。";
			break;
		case 65:
			mes "公牛死后会留下皮革吗？还是老虎？无论如何，它嫉妒那些在历史上留下名字的人类。";
			next;

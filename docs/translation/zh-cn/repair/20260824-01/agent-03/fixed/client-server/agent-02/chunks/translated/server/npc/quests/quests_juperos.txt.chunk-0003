					mes "还不够完善，";
					mes "尚不能算真正的论文……";
					close;
				}
				else if (yuno_hist == 9) {
					mes "^8B6914朱诺斯建于一千多年前，";
					mes "那是大战结束后的和平时代。";
					mes "与普遍看法相反，没有证据证明朱诺斯源自朱佩洛斯。^000000";
					next;
					mes "^8B6914事实上，很可能是朱诺斯与朱佩洛斯之间的另一场战争，";
					mes "导致朱诺斯独立，并摧毁了那个时代的所有现存文献。^000000";
					next;
					mes "["+strcharinfo(0)+"]";
					mes "是的……当然！";
					mes "现在一切都说得通了！";
					close;
				}
				mes "^8B6914朱佩洛斯建于一千多年前，那是大战后的和平时代。";
				mes "现在有直接证据将朱诺斯与朱佩洛斯联系起来，证明朱诺斯只是朱佩洛斯的一部分。^000000";
				next;
				mes "^8B6914与朱诺斯一样，朱佩洛斯社会以科学进步为傲，";
				mes "科学渗透文明生活，也造成了朱佩洛斯的兴盛与衰亡。";
				close;
			case 3:
				if (yuno_hist < 10) {
					mes "^8B6914...";
					mes "......";
					mes "..........^000000";
					next;
					mes "["+strcharinfo(0)+"]";
					mes "嗯，这位作者一直在谈理论，";
					mes "但我越读越不明白理论究竟是什么。";
					mes "我觉得根本没有理论……";
					emotion ET_SWEAT, playerattached();
					close;
				}
				mes "^8B6914最令人不安的是最近的证据，";
				mes "包括一份亲笔记录，描述朱佩洛斯最杰出的科学家之一在该城兴衰中的作用。";
				next;
				mes "^8B6914如果这些文字属实，那么事情的真相是：";
				mes "一名科学家试图操纵名为伊米尔之心的神器能量，直接引发了科学革命。";
				next;
				mes "^8B6914这名男子与伊米尔之心被认为带来了朱佩洛斯文明的成功与繁荣。";
				mes "然而，朱佩洛斯覆灭前的多份记录详细描述了他与奇美拉的研究……^000000";
				next;
				mes "^8B6914据说这名科学家为了造福人民，";
				mes "用奇美拉寻找科学的永生方法，最终陷入疯狂。";
				mes "他在自己身上进行实验，结果酿成灾难。^000000";
				next;
			mes "^8B6914记录中出现了错误。";
				mes "伊米尔之心的能量校准出现错误，科学家变成了我们如今所知的奇美拉。";
				mes "他和实验对象被放入朱佩洛斯城。^000000";
				next;
				mes "^8B6914These immortal Chimeras";
				mes "这些不死奇美拉摧毁了整座城市，杀死无数人。";
				mes "据说一队科学家抢救出一块伊米尔之心碎片，将朱佩洛斯的一部分升入天空。^000000";
				next;
				mes "^8B6914That section of Juperos";
				mes "那部分最终发展成朱诺斯城。";
				mes "由于将朱诺斯升入天空的科学家随后全因不明原因立即死亡，没有留下任何文献。^000000";
				next;
			mes "^8B6914奇美拉，以及";
				mes "据说奇美拉及其诞生的实验室，仍位于昔日伟大城市朱佩洛斯的废墟之下。^000000";
				close;
			case 4:
				mes "["+strcharinfo(0)+"]";
				mes "呃……读这种聪明人写的书让我头疼。";
				mes "对了！我去玩电子游戏！";
				close;
			}
		}
		switch(select("Preface:Close the file.")) {
		case 1:
			mes "^8B6914学者确信朱佩洛斯文明曾位于地表，";
			mes "如今却埋在埃尔梅斯高原之下。";
			mes "城市毁灭的原因仍然模糊不清……^000000";
			next;
			mes "^8B6914有许多猜测";
			mes "关于朱佩洛斯衰亡的原因众说纷纭，但那个时代的任何文献都很难找到。";
			mes "那个时代的文献很难找到，目前关于朱佩洛斯的证据也无法定论。^000000";
			next;
			mes "^8B6914尽管缺乏关于朱佩洛斯文明的实证或具体数据，";
			mes "现代世界仍能从那座古城的遗迹中学到许多。";
			mes "..................^000000";
			if (!yuno_hist) set yuno_hist,1;
			next;
			mes "["+strcharinfo(0)+"]";
			mes "这……";
			mes "这应该是研究论文？";
			mes "里面几乎没有研究内容……";
			close;
		case 2:
			mes "["+strcharinfo(0)+"]";
			mes "嗯……";
			mes "这还不够严谨，算不上真正的学术作品。";
			mes "一定还没完成。";
			close;
		}
	case 2:
		if (yuno_hist < 5) {
			mes "["+strcharinfo(0)+"]";
			mes "算了……";
			mes "我读累了。真是讽刺。";
			close;
		}
		else if (yuno_hist < 7) {
			mes "["+strcharinfo(0)+"]";
			mes "我不想读这个，图片太少了……";
			close;
		}
		else if (yuno_hist < 9) {
			mes "["+strcharinfo(0)+"]";
			mes "看起来很深奥……";
			close;
		}
		else if (yuno_hist < 10) {
			mes "["+strcharinfo(0)+"]";
			mes "我知道这本书……但现在不想读。";
			close;
		}
		else {
			mes "["+strcharinfo(0)+"]";
			mes "这篇论文看起来很不错~";
			mes "当然，我也参与了撰写……";
			close;
		}
	}
}

yuno_in04,188,118,4	script	Book#juperos	111,{
	if (yuno_hist > 7) {
		mes "^8B6914《自我诚实》";
		mes "《生活的益处！》";
		mes "作者：Stephen Oyoung";
		mes " ";
		mes " ";
		mes "出版商：";
		mes "Wushu 出版社^000000";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "哇！";
		mes "这本书之前还不在这里！看起来很有趣……";
		close;
	}
	mes "["+strcharinfo(0)+"]";
	mes "你知道吗？我随便翻翻一本书的几页吧。嗯，让我看看……";
	next;
	mes "^8B6914‘上将，基洛里安人";
	mes "仍在前进！’麦肯里克指挥官失去平日的傲气宣布。‘他们……他们没有停下！’";
	mes "然而莱赫上将的双眼冷酷而严厉。^000000";
	next;
	mes "^8B6914‘让该死的空间";
	mes "让那些该死的外星人来吧。’莱赫嘶声道。";
	mes "‘我们毫无胜算";
	mes "没有泽诺伊之剑召唤 GOD-POING 的力量，我们毫无胜算。结束了……可恶……’^000000";
	next;
	mes "^8B6914The doors burst open as";
	mes "巴奇飞进房间。";
	mes "‘泽诺伊之剑！";
	mes "泽诺伊之剑！有人找到它了！’男孩喊道。";
	mes "‘真的吗？！我们得快点：";
	mes "地球没有多少时间了！’^000000";
	next;
	mes "["+strcharinfo(0)+"]";
	mes "...";
	mes "......";
	mes "哇，我真该从头读起这部杰作……";
	close;
}

// Bronze Statue - juperos_01 99 112

juperos_01,99,112,4	script	Bronze Statue#1	844,{
	if (yuno_hist > 3) {
		mes "^3355FF‘你想看看";
		mes "疯狂的终点？他正在三根柱子被摧毁、两百个幻影游荡之处等待。’^000000";
		close;
	}
	else if (yuno_hist == 3) {
		mes "["+strcharinfo(0)+"]";
		mes "我最好去朱诺斯图书馆找 Fayruz，告诉她这段铭文。";
		close;
	}
	else {
		mes "^3355FFThere's a peculiar";
		mes "青铜雕像的杖上有奇怪的雕刻。^000000";
		next;
		switch(select("Investigate:Ignore it")) {
		case 1:
			mes "^3355FF这是刻在上面的铭文，";
			mes "这是用古老语言写成的铭文，你本应无法理解，";
			mes "却不知为何能读出并分辨其中的声音。^000000";
			next;
			mes "["+strcharinfo(0)+"]";
			mes "真诡异！我本不该读懂它，可我现在就是能读。";
			mes "我知道这些字母发出的所有声音……";
			next;
			if (yuno_hist == 2) {
				mes "["+strcharinfo(0)+"]";
				mes "不过 Fayruz 说过这东西被施了魔法。";
				mes "好吧，我回朱诺斯图书馆告诉她我的发现。";
				set yuno_hist,3;
				changequest 11017,11018;
				close;
			}
			mes "["+strcharinfo(0)+"]";
			mes "嗯，只有学者，或许朱诺斯的某个人，才能看懂这些内容。";
			close;
		case 2:
			close;
		}
	}
}


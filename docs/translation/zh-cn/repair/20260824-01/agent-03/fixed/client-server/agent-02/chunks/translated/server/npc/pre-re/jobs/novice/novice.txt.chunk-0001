// Receptionist
new_1-2,100,29,4	script	Receptionist#nv1	86,{
	mes "[训练场接待员]";
	mes "你好，你看起来是新来的。";
	mes "你叫什么名字？";
	next;
	input .@charname$;
	if (.@charname$!=strcharinfo(0)) {
		mes "[训练场接待员]";
		mes "抱歉，我好像没有听清";
		mes "你的话。";
		close;
	}
	mes "[训练场接待员]";
	mes "欢迎！";
	mes "你现在位于";
	mes "^3355FF训练场^000000入口。";
	next;
	mes "[训练场接待员]";
	mes "如果你是";
	mes "Ragnarok 世界的新手，";
	mes "请选择";
	mes "^3355FF训练场介绍^000000";
	mes "菜单了解更多信息。";
	next;
	while (1) {
		switch(select("申请训练。:直接进入 Ragnarok Online。:^3355FF训练场介绍^000000:我需要考虑一下。")) {
		case 1:
			mes "[训练场接待员]";
			mes "感谢申请初心者训练。各训练课程详情请向指导员咨询。";
			next;
			mes "[训练场接待员]";
			mes "对训练流程有疑问时，欢迎向任何导师提问。";
			next;
			mes "[训练场接待员]";
			mes "现在将把你传送到";
			mes "训练场。";
			close2;
			warp "new_1-2",100,70;
			end;
		case 2:
			mes "[训练场接待员]";
			mes "我明白了。";
			mes "请尽你";
			mes "最大努力，祝你";
			mes "好运！";
			close2;
			set nov_1st_cos,0;
			set nov_2nd_cos,0;
			set nov_3_swordman,0;
			set nov_3_archer,0;
			set nov_3_thief,0;
			set nov_3_magician,0;
			set nov_3_acolyte,0;
			set nov_3_merchant,0;
			switch(rand(6)) {
			case 0:
				savepoint "prontera",273,354,1,1;
				warp "prontera",273,354;
				break;
			case 1:
				savepoint "morocc",160,94,1,1;
				warp "morocc",160,94;
				break;
			case 2:
				savepoint "geffen",120,100,1,1;
				warp "geffen",120,100;
				break;
			case 3:
				savepoint "payon",70,100,1,1;
				warp "payon",70,100;
				break;
			case 4:
				savepoint "alberta",116,57,1,1;
				warp "alberta",116,57;
				break;
			case 5:
				savepoint "izlude",94,103,1,1;
				warp "izlude",94,103;
			}
			end;
		case 3:
			mes "[Training Grounds Receptionist]";
			mes "卢恩·米德加兹王国教育委员会建立训练场，为 Ragnarok Online 新玩家提供有用信息。";
			next;
			mes "[Training Grounds Receptionist]";
			mes "训练课程分为两部分：基础知识课程和野外战斗训练。";
			next;
			mes "[Training Grounds Receptionist]";
			mes "通过第一部分，玩家将学习必要知识，获得更顺畅的游戏体验。";
			next;
			mes "[Training Grounds Receptionist]";
			mes "在野外战斗训练中，";
			mes "玩家将与弱小怪物实战，学习战斗基础。";
			next;
			mes "[Training Grounds Receptionist]";
			mes "通过战斗练习，";
			mes "玩家可以在进入真实世界前积累更多经验。";
			next;
			mes "[Training Grounds Receptionist]";
			mes "训练结束时，我们会介绍一转职业，帮助玩家决定最适合自己的职业。";
			next;
			mes "[Training Grounds Receptionist]";
			mes "想参加训练场，请在菜单中选择‘^3355FF申请训练^000000’。";
			next;
			mes "[Training Grounds Receptionist]";
			mes "如果想跳过基础训练、立即进入 Ragnarok Online 世界，请选择‘^3355FF直接进入 Ragnarok Online^000000’。";
			next;
			break;
		case 4:
			mes "[Training Grounds Receptionist]";
			mes "我明白了。";
			mes "请慢慢来。";
			close;
		}
	}
}	
new_2-2,100,29,4	duplicate(Receptionist#nv1)	Receptionist#nv2	86
new_3-2,100,29,4	duplicate(Receptionist#nv1)	Receptionist#nv3	86
new_4-2,100,29,4	duplicate(Receptionist#nv1)	Receptionist#nv4	86
new_5-2,100,29,4	duplicate(Receptionist#nv1)	Receptionist#nv5	86

new_1-1,53,114,4	script	Shion#nv1	727,{
	if (nov_get_item04 > 9 || nov_get_item05 > 9) {
		mes "[希恩]";
		mes "嗯……？";
		mes "你还在这里";
		mes "做什么？";
		mes "哦，你用了^3355FF蝴蝶翅膀^000000，对吧？";
		next;
		mes "[希恩]";
		mes "不，不，不~";
		mes "^666666完成^000000这里的训练后，想回城镇时才应该使用蝴蝶翅膀，明白吗？";
		next;
		mes "[希恩]";
		mes "现在让我把你送回";
		mes "训练场。";
		mes " ";
		close2;
		warp "new_1-2",99,99;
		end;
	}
	else if (nov_1st_cos > 2) {
		mes "[希恩]";
		mes "训练场";
		mes "就在";
		mes "右侧桥梁";
		mes "的另一边。";
		next;
		mes "[希恩]";
		mes "虽然你要";
		mes "参加一些课程，";
		mes " ";
		mes "但不会后悔。";
		mes "现在，去吧！";
		close;
	}
	else if (nov_1st_cos == 2) {
		mes "[Shion]";
		mes "嘿……";
		mes "你这个小淘气！";
		next;
		mes "[Shion]";
		mes "等等……";
		mes "冷静，希恩。";
		mes "你是专业的";
		mes "训练员！别因为";
		mes "初心者而生气！";
		next;
		mes "[Shion]";
		mes "现在就穿过右侧的桥！^666666*咳咳*^000000你会看到城堡，里面有各种导师。";
		next;
		mes "[Shion]";
		mes "如果看不到入口，按住^3355FF鼠标右键^000000拖动鼠标改变镜头角度。很简单，对吧？";
		next;
		mes "[Shion]";
		mes "要重置镜头角度，";
		mes "只需双击鼠标右键。好了，保重！";
		next;
		mes "[Shion]";
		mes "哦，离开前，";
		mes "学会善待女士，好吗？她们可能会送你这样的礼物！";
		set nov_1st_cos,3;
		getexp 9,0;
		close;
	}
	else if (nov_1st_cos == 1) {
		mes "[Shion]";
		mes "嗯……？";
		mes "你为什么还";
		mes "在这里？";
		mes "^666666*Sigh...*^000000";
		next;
		mes "[Shion]";
		mes "嘿，进入训练场后，你会学习各种有助于游戏的知识，还有机会获得 Zeny 和其他奖励。";
		next;
		mes "[Shion]";
		mes "你甚至可以获得";
		mes "这样的经验值！";
		set nov_1st_cos,3;
		getexp 9,0;
		next;
		mes "[Shion]";
		mes "在训练场学到的一切都会帮助你进行游戏。所以保持积极，好吗？";
		close;
	}
	else {
		mes "[Shion]";
		mes "你好~";
		mes "欢迎来到";
		mes "训练场！";
		next;
		mes "[Shion]";
		mes "让我看看。";
		mes "你的名字是……";
		mes "" + strcharinfo(0) + ".";
		next;
		mes "[Shion]";
		mes "我叫希恩。";
		mes "没错，我们当然是第一次见面。哈哈哈~！";
		next;
		mes "[Shion]";
		mes "既然认识了，有什么我能帮你的吗？";
		mes "有问题尽管问我~";
		next;
		switch(select("我该去哪里？:关于基础界面。:你到底是谁？")) {
		case 1:
			mes "[Shion]";
			mes "你看到右侧的桥了吗？";
			mes "穿过桥就会到达城堡。你只需走进去！";
			next;
			mes "[Shion]";
			mes "城堡入口是";
			mes "^4D4DFF旋转的白光^000000。这些传送门能让你从一个区域移动到另一个区域。";
			next;
			mes "[Shion]";
			mes "你知道怎么移动吗？";
			mes "左键点击某处，你就会走过去。很简单吧？";
			next;
			mes "[Shion]";
			mes "去试试吧！";
			mes "总之，你必须进入城堡才能开始冒险。";
			next;
			mes "[Shion]";
			mes "入口有士兵，";
			mes "所以不用";
			mes "担心迷路。";
			mes "保重~！";
			set nov_1st_cos,1;
			close;
		case 2:
			mes "[Shion]";
			mes "基础界面……";
			mes "你知道点击、双击和拖动是什么意思吗？";
			next;
			mes "[Shion]";
			mes "按下";
			mes "鼠标左键一次，";
			mes "这就是点击。连续按鼠标键两次就是双击。";
			next;
			mes "[Shion]";
			mes "拖动是按住鼠标键后移动鼠标，";
			mes "也就是点击某物后按住鼠标键移动。";
			next;
			mes "[Shion]";
			mes "在开始讲解";
			mes "基础界面前，请记住这些术语，因为我们会经常使用。";
			next;
			mes "[Shion]";
			mes "城堡内有基础界面导师，会更清楚地教你基础知识。进入城堡开始训练吧。";
			next;
			mes "[Shion]";
			mes "入口";
			mes "城堡是";
			mes "^4D4DFF旋转的白光^000000。";
			next;
			mes "[Shion]";
			mes "入口有士兵，";
			mes "所以不用";
			mes "担心迷路。";
			mes "保重~！";
			set nov_1st_cos,1;
			close;
		case 3:
			mes "[Shion]";
			mes "我？我是希恩！";
			mes "但这样问很没礼貌！我在这里无偿投入时间和精力，你至少应该表示一点尊重！";
			set nov_1st_cos,2;
			close;
		}
	}
}

new_2-1,53,114,4	duplicate(Shion#nv1)	Shion#nv2	727
new_3-1,53,114,4	duplicate(Shion#nv1)	Shion#nv3	727
new_4-1,53,114,4	duplicate(Shion#nv1)	Shion#nv4	727
new_5-1,53,114,4	duplicate(Shion#nv1)	Shion#nv5	727


// Interfaces Tutor
new_1-2,99,105,3	script	Interfaces Tutor#nv1	751,{
	if (nov_get_item02 > 9 && nov_get_item03 > 9 && nov_get_item04 > 9) {
		mes "[Kris]";
		mes "你已完成所有基础课程。和助理导师谈过了吗？下一课是野外战斗训练。要继续吗？";
		next;
		switch(select("当然！:不了，我稍后再来。:送我去城镇！")) {
		case 1:
			mes "[Kris]";
			mes "下一课是野外战斗训练。请认真听下一位训练员指导，希望你通过课程。祝你好运。";
			close2;
			warp "new_1-2",28,178;
			end;
		case 2:
			mes "[Kris]";
			mes "好吧。在此期间，你可以和助理导师谈谈，基础课程的信息可能不足以帮助新冒险者。";
			next;
			mes "[Kris]";
			mes "需要帮助时随时回来。";
			close;
		case 3:
			mes "[Kris]";
			mes "想被送到城镇吗？如果觉得学得够多了，就去右边和^3355FF卡普拉职员^000000交谈。";
			next;
			mes "[Kris]";
			mes "进入现实世界后，卡普拉服务非常方便。传送服务可往返城镇，卡普拉仓库可安全保管物品。";
			next;
			mes "[Kris]";
			mes "我们也许不会再见，但希望你变强，成为伟大的冒险者。祝你好运。";
			close;
		}
	}
	else if (nov_get_item02 < 10) {
		mes "[Kris]";
		mes "你好，可以看看你的";
		mes "登记证明吗？";
		next;
		if (NEW_MES_FLAG0) {
			mes "[Kris]";
			mes "啊，" + strcharinfo(0) + ", you've applied for an old training course that we no longer provide for our trainees. Let me issue a new proof of registration for you.";
			set NEW_MES_FLAG0,0;
			set NEW_MES_FLAG1,0;
			set NEW_MES_FLAG2,0;
			set NEW_MES_FLAG3,0;
			set NEW_MES_FLAG4,0;
			set NEW_MES_FLAG5,0;
			set NEW_LVUP0,0;
			set NEW_LVUP1,0;
			set NEW_JOBLVUP,0;
			next;
		}
		mes "[Kris]";
		mes "好，现在";
		mes "你准备好了。";
		mes "在我的课程中，我会教";
		mes "最基础界面的";
		mes "使用方法。";
		next;
		mes "[Kris]";
		mes strcharinfo(0)+".";
		mes "你想学习更多";
		mes "界面";
		mes "基础吗？";
		next;
		switch(select("是。:不用了，我是高手~:取消。")) {
		case 1:
			mes "[Kris]";
			mes "首先，可以拖动窗口移动屏幕上的所有界面窗口。点击窗口，按住鼠标键并移动鼠标即可。";
			next;
			mes "[Kris]";
			mes "现在让我按屏幕默认位置说明各个界面窗口。";
			next;
			mes "[Kris]";
			mes "屏幕左上方会看到显示角色姓名和等级的窗口，这就是^3355FF基础信息窗口^000000。";
			next;
			mes "[Kris]";
			if (BaseLevel < 8) {
				mes "让我给你";
				mes "一些经验值。";
				mes "观察基础信息窗口，看看基础等级经验条的变化。";
				next;
				mes "[Kris]";
				mes "看到了吗……？";
				mes "获得经验后，";
				mes "经验条会填充。";
				mes "经验条达到 100% 后，你会提升经验等级，经验条重置为 0。";
				set nov_get_item02,10;
				switch (BaseLevel) {
				case 1: getexp 10,0; break;
				case 2: getexp 17,0; break;
				case 3: getexp 26,0; break;
				case 4: getexp 37,0; break;
				case 5: getexp 78,0; break;
				case 6: getexp 115,0; break;
				case 7: getexp 155,0; break;
				}
			}
			else {
				mes "但是……";
				mes "我想你已经熟悉基础等级经验条了。";
			}
			next;
			mes "[Kris]";
			mes "基础信息窗口底部有两条经验条。上方显示基础等级，下方显示职业等级。";
			next;
			mes "[Kris]";
			mes "当职业等级";
			mes "经验条填满时，你会获得职业等级和^3355FF技能点^000000。技能点用于学习角色技能。";
			next;
			mes "[Kris]";
			mes "基础信息窗口右侧";
			mes "会看到各种";
			mes "菜单按钮。";
			next;
			mes "[Kris]";
			mes "点击这些菜单按钮会打开其他界面窗口，例如物品栏窗口";
			mes "或队伍窗口。";
			next;
			mes "[Kris]";
			mes "现在……";
			mes "^3355FF聊天窗口^000000是";
// 切片行数保留

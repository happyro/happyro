new_3-1,144,116,2	duplicate(Guard#nv1)	Guard#nv3-1	105
new_4-1,144,116,2	duplicate(Guard#nv1)	Guard#nv4-1	105
new_5-1,144,116,2	duplicate(Guard#nv1)	Guard#nv5-1	105

new_1-1,144,107,2	script	Guard#nv2	105,{
	mes "[训练场守卫]";
	if(rand(2)) {
		mes "进来吧！";
		mes "我想";
		mes "欢迎你来到";
		mes "训练场！";
		next;
		mes "[训练场守卫]";
		mes "在这里，你可以为未来";
		mes "在 Ragnarok 世界中的";
		mes "冒险";
		mes "做好准备！";
	}
	else {
		mes "去吧，初心者，去吧！";
		mes "战斗并变强！向更光明的明天前进！";
	}
	close;
}


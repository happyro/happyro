// Bulletin Board
new_1-1,66,114,4	script	Bulletin Board#nv	111,{
	mes "^FF0000=================================^000000";
	mes "^FF0000 ^000000 ^E40CAA[欢迎]^CC0000来到^FF9000初心者^7FFF00训练^00FF00场地^E40CAA[欢迎]^FF0000^000000";
	mes "^FF0000=================================^000000";
	close;
}


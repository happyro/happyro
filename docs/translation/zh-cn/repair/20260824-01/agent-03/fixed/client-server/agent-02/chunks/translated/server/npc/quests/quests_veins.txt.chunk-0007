		}
		else if (rachel_camel == 24) {
			mes "["+strcharinfo(0)+"]";
			mes "嘿，凯琳！我用蝴蝶翅膀把你的妹妹送回城里了。她平安回来了吗？";
			next;
			mes "[Kid Karyn]";
			mes "是的，柯蒂回来了，现在正在医院休息。谢谢你一直以来的帮助！她回来后，只要看到城里的士兵就会害怕。";
			next;
			mes "[Kid Karyn]";
			mes "爸爸从海外回来后，我会告诉他你为我们做的一切。谢谢你！";
			next;
			mes "["+strcharinfo(0)+"]";
			mes "嗯……我明白了……等柯蒂出院后，我再来看她。";
			next;
			mes "[Kid Karyn]";
			mes "好，请一定要来。我保证你需要我的时候会帮你！";
			next;
			mes "["+strcharinfo(0)+"]";
			mes "哈哈哈！那确实让人安心。在那之前，照顾好你的妈妈和妹妹。明白了吗？";
			next;
			mes "[Kid Karyn]";
			mes "明白了！";
			next;
			mes "["+strcharinfo(0)+"]";
			mes "好，好……那就这么约定了。回头见~";
			next;
			completequest 3083;
			set rachel_camel,25;
			specialeffect2 EF_ABSORBSPIRITS;
			if (checkre(3))
				getexp 100000,50000;
			else
				getexp 1000000,700000;
			close;
		}
		else {
// Start Nameless Island Access Quest Addition
			if (aru_monas < 15) {
				mes "[Kid Karyn]";
				mes "哦，你好！谢谢你上次帮助我！等我长大后，也会尽力像你帮助我那样帮助你！";
				close;
			}
			else if (aru_monas == 15) {
				mes "[Kid Karyn]";
				mes "嗨！很高兴再次见到你！柯蒂刚从医院回家，每天都在好转。我也一直像答应过的那样照顾她~";
				next;
				mes "["+strcharinfo(0)+"]";
				mes "真的吗？那太好了。你应该感到骄傲~";
				next;
				mes "[Kid Karyn]";
				mes "^666666*脸红*^000000 嘿嘿！";
				next;
				mes "["+strcharinfo(0)+"]";
				mes "我想请你帮个忙。你爸爸是渔夫，对吧？能不能问他是否可以借我他的船？";
				next;
				mes "[Kid Karyn]";
				mes "嗯……教皇说爸爸暂时不允许使用他的船……我也不知道为什么……";
				next;
				mes "[Kid Karyn]";
				mes "爸爸现在不能出海。不过如果是你，应该没关系吧？你帮助过我，所以我也得帮你，对吧？";
				next;
				mes "[Kid Karyn]";
				mes "爸爸不能用船很生气，我们最好别告诉他你想用。把这当成我们的秘密，好吗？";
				next;
				mes "["+strcharinfo(0)+"]";
				mes "当、当然！";
				next;
				mes "[Kid Karyn]";
				mes "南边海滩上只有爸爸的船，其他渔夫都把船停在别处。而且船一直不用会生锈。";
				next;
				mes "["+strcharinfo(0)+"]";
				mes "太好了！谢谢你的帮助，凯琳~ 我会好好照顾你爸爸的船，只用一会儿。";
				next;
				mes "[Kid Karyn]";
				mes "嘿嘿！谢谢！我也很高兴能帮助你！";
				set aru_monas,16;
				//changequest 17011,17012;
				close;
			}
			else if (aru_monas < 26) {
				mes "[Kid Karyn]";
				mes "嗨！你觉得坐我爸爸的船钓鱼怎么样？哦，柯蒂也向你问好！";
				close;
			}
			else {
				mes "[Kid Karyn]";
				mes "爸爸说他很快就能再次出海了！希望他能钓到很多鱼！";
				close;
			}
// End Nameless Island Access Quest Addition.
		}
	}
	else {
		mes "[Kid Karyn]";
		mes "^333333*抽泣*^000000……";
		mes "^333333*抽泣*^000000……";
		close;
	}
}

que_thor,36,66,5	script	Little Curdie	941,{
	if (rachel_camel == 1) {
		mes "^3355FF你发现一个小女孩昏迷着躺在地上。^000000";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "嘿，小姑娘！醒醒！你听得到我吗？";
		next;
		mes "^3355FF她还有脉搏，但无论你怎么呼唤，她都不睁眼。你轻轻拍了拍她的脸颊，让她醒来。^000000";
		next;
		mes "[Little Curdie]";
		mes "嗯？！……啊，好痛~ 哇啊啊啊！";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "对不起！我不是想让你哭！你还好吗？";
		next;
		mes "[Little Curdie]";
		mes "嗯？你、你是谁？不好，你得离开这里！他们抓到你的话，你会有麻烦的！";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "你是柯蒂吗？你的哥哥凯琳请我来救你。来吧，我们得带你离开这里。";
		next;
		mes "[Little Curdie]";
		mes "凯琳……？他们把我锁在这些镣铐里，我动不了！那些可怕的人回来之前你必须离开！";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "什么……？！那些混蛋！竟然这样绑住一个小女孩……";
		mes "["+strcharinfo(0)+"]";
		mes "我也不能用蛮力砸碎镣铐，那样可能会伤到你……！";
		next;
		mes "[Little Curdie]";
		mes "别担心我……快离开！我没事的！快点！有人来了！";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "好，我走……但你坚持住，等我回来。我会想办法救你出来。";
		next;
		mes "[Little Curdie]";
		mes "^333333*抽泣*^000000 真、真的吗……？";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "我保证。城里一定有人知道如何打开你的镣铐。我会尽快回来！";
		next;
		changequest 3060,3061;
		set rachel_camel,2;
		close;
	}
	else if (rachel_camel == 2) {
		mes "^3355FF城里一定有人有打开这些镣铐的专业知识。这是救柯蒂脱离锁链的唯一希望。^000000";
		close;
	}
	else if (rachel_camel == 3 || rachel_camel == 6 || rachel_camel == 8 || rachel_camel == 22) {
		mes "^3355FF柯蒂虚弱地躺在地上。^000000";
		close;
	}
	else if (rachel_camel == 4) {
		mes "[Little Curdie]";
		mes "我讨厌金属碰撞的声音……那、那些火花，它们……它们……";
		next;
		mes "^3355FF柯蒂蜷缩在地上，紧紧闭着眼睛，整个身体因恐惧而颤抖。^000000";
		close;
	}
	else if (rachel_camel == 5) {
		mes "^3355FF你在地上看到一些设备，看起来和拉赫士兵使用的设备很相似。^000000";
		close;
	}
	else if (rachel_camel == 7) {
		mes "^3355FF似乎有人来给柯蒂送食物和水。^000000";
		close;
	}
	else if (rachel_camel == 9) {
		mes "^3355FF你经过时，柯蒂眯眼看着你。她被关在这座洞穴里的时间越长，视力似乎就越差。";
		close;
	}
	else if (rachel_camel == 10) {
		mes "^3355FF如果你真的想解救柯蒂，最好找到丝沙骆驼，并取得制作肥皂的材料。^000000";
		close;
	}
	else if (rachel_camel == 11) {
		mes "["+strcharinfo(0)+"]";
		mes "如果想救柯蒂，我最好找到萨拉曼先生丢失的骆驼，喂它骆驼食欲刺激剂，然后取得肥皂材料和 5 块骆驼粪便。";
		close;
	}
	else if (rachel_camel > 11 && rachel_camel < 17) {
		mes "^3355FF你已经找到骆驼，所以接下来需要收集肥皂材料，才能救出柯蒂。^000000";
		close;
	}
	else if (rachel_camel == 17) {
		mes "["+strcharinfo(0)+"]";
		mes "我拿到了肥皂材料：5 块骆驼粪便。我该回去告诉萨拉曼先生他的骆驼在哪里，然后去找象牙女士。";
		close;
	}
	else if (rachel_camel == 18) {
		mes "^3355FF如果你真的想解救柯蒂，现在应该去见象牙女士了。^000000";
		close;
	}
	else if (rachel_camel == 19) {
		mes "^3355FF既然你拿到了丝沙骆驼肥皂，就应该把它带给洛肯洛克先生。^000000";
		close;
	}
	else if (rachel_camel == 20) {
		mes "^3355FF柯蒂还在你离开时的位置。她旁边有一碗冷汤，显然有人一直在给她喂食。^000000";
		next;
		mes "^3355FF你把肥皂倒进镣铐的锁孔，制作出模具，让洛肯洛克先生用它制作钥匙。^000000";
		next;
		mes "[Little Curdie]";
		mes "我会一直被困在这里吗？我……我想妈妈了……";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "哦……你醒了？别担心，柯蒂，我相信很快就能救你出来。再坚持一会儿。";
		next;
		mes "[Little Curdie]";
		mes "门打开时，我看见耀眼的火焰……还听见机器的声音？那些穿着同样衣服的人一直从我面前走过……";
		next;
		mes "[Little Curdie]";
		mes "我……他们太可怕了！给我送饭的人说，他们不会放我走，因为我看到了里面的东西。他们不会让我回家……";
		next;
		mes "^3355FF柯蒂的双眼失去焦点，望向你的头顶。如果她再被迫留在这里太久，可能无法活下去。^000000";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "别担心。我做出打开这些可怕镣铐的钥匙后，就会马上回来救你。别担心……";
		next;
		mes "[Little Curdie]";
		mes "如果你下次来时我不在，就快逃。甚至不要告诉我哥哥。趁他们还没抓到你，跑得越远越好。我是认真的……";
		next;
		mes "[Little Curdie]";
		mes "即使我再也见不到你……我只是想谢谢你尽力帮助我。";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "一切都会好起来的。我只是得再快一点。好了，该走了。";
		next;
		mes "^3355FF你从锁孔中取出肥皂，小心地包好。现在把模具带回城里交给洛肯洛克先生。^000000";
		changequest 3079,3080;
		set rachel_camel,21;
		close;
	}
	else if (rachel_camel == 21) {
		mes "^3355FF你必须赶快回城，把钥匙模具交给洛肯洛克先生，让他制作打开柯蒂镣铐的钥匙。^000000";
		close;
	}
	else if (rachel_camel == 23) {
		mes "[Little Curdie]";
		mes "你、你……真的是你吗？";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "坚持住，柯蒂！希望这把钥匙有用……";
		next;
		mes "^3355FF你用洛肯洛克先生制作的钥匙打开了镣铐。^000000";
		next;
		mes "^333333*咔嚓*^000000";
		next;
		mes "[Little Curdie]";
		mes "啊啊啊！我、我的……！";
		next;
		mes "^3355FF柯蒂的双腿因长时间佩戴镣铐所承受的重量和压力而肿胀。^000000";
		next;
		mes "[Little Curdie]";
		mes "我的腿动不了了！";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "没办法了。柯蒂，我要用蝴蝶翅膀把你送回城里。尽量别动，好吗？";
		next;
		mes "[Little Curdie]";
		mes "哦！谢谢你……我可以回家了……真、真的非常感谢你……";
		next;
		mes "^3355FF你使用蝴蝶翅膀的力量把柯蒂送回城里。希望她能平安抵达，再次见到她的哥哥凯琳。^000000";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "她在那扇老旧钢门后面看到了什么？";

  - Id: 22035
    AegisName: Vet_Nepen_Heel
    Name: 英雄猪笼草之鞋
    Type: Armor
    Buy: 10
    Weight: 300
    Defense: 10
    Slots: 1
    Locations:
      Shoes: true
    ArmorLevel: 1
    EquipLevelMin: 160
    Refineable: true
    Script: |
      .@r = getrefine();
      if (.@r>=8 && .@r<=10)
         .@i=5+(.@r-8);
      else if (.@r>=11 && .@r<=13)
         .@i=5+((.@r*3)-28);
      else if (.@r>13)
         .@i=16;
      bonus bVariableCastrate,-10-.@i;

  - Id: 24722
    AegisName: S_AutoSpell_Shield
    Name: 自动法术暗影之盾
    Type: ShadowGear
    Locations:
      Shadow_Shield: true
    Refineable: true
    Script: |
      .@r = getrefine();
      bonus bMaxHP,.@r*10;
      bonus bMatk,15+(.@r/2);
      if (.@r==9)
         bonus3 bAutoSpell,"MG_NAPALMBEAT",7,70;
      else if (.@r>9)
         bonus3 bAutoSpell,"MG_NAPALMBEAT",10,100;

  - Id: 560048
    AegisName: Mocadas_Knuckle
    Name: 穆卡达斯拳套
    Type: Weapon
    SubType: Knuckle
    Weight: 2000
    Attack: 220
    Range: 1
    Slots: 2
    Jobs:
      Monk: true
    Classes:
      Fourth: true
    Locations:
      Right_Hand: true
    WeaponLevel: 5
    EquipLevelMin: 250
    Refineable: true
    Gradable: true
    Script: |
      .@g = getenchantgrade();
      .@r = getrefine();
      bonus bMaxHPrate,10;
      bonus2 bSkillAtk,"IQ_THIRD_FLAME_BOMB",10;
      if (.@r>=7) {
         bonus bShortAtkRate,10;
         if (.@r>=9) {
            bonus2 bSkillAtk,"IQ_THIRD_FLAME_BOMB",10;
            if (.@r>=11) {
               bonus2 bSkillAtk,"IQ_THIRD_FLAME_BOMB",10;
            }
         }
      }
      if (.@g>=ENCHANTGRADE_D) {
         bonus2 bAddSize,Size_Small,15;
         if (.@g>=ENCHANTGRADE_C) {
            bonus2 bAddSize,Size_Medium,15;
            if (.@g>=ENCHANTGRADE_B) {
               bonus2 bAddSize,Size_Large,15;
               if (.@g>=ENCHANTGRADE_A) {
                  bonus bPAtk,5;
               }
            }
         }
      }

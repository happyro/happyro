    Name: 医疗服
    Type: Armor
    Buy: 20
    Weight: 1000
    Defense: 50
    Slots: 1
    Locations:
      Armor: true
    ArmorLevel: 1
    EquipLevelMin: 100
    Refineable: true
    Script: |
      .@r = getrefine();
      bonus bMdef,10;
      bonus bDelayrate,-10;
      .@val = 1;
      if (.@r >= 7) {
         .@def = 50;
         bonus bUnbreakableArmor,1;
         .@val += 2;
         if (.@r >= 8) {
            .@def += 100;
            .@val += 3;
            bonus2 bSubRace,RC_DemiHuman,7;
            bonus2 bSubRace,RC_Player_Human,7;
            if (.@r >= 9) {
               .@def += 150;
               .@val += 4;
               bonus2 bResEff,Eff_Stone,5000;
            }
         }
         bonus bDef,.@def;
      }
      bonus bHealPower,2*.@val;
      bonus bHealPower2,.@val;
      bonus bAddItemHealRate,.@val;

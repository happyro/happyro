         autobonus "{ bonus bLuk,50; }",(8+(.@r2*5)),(4+(.@r2*3))*1000,BF_MAGIC;
      }
      else {
         autobonus "{ bonus bLuk,50; }",8,4000,BF_NORMAL;
         autobonus "{ bonus bLuk,50; }",8,4000,BF_MAGIC;
      }

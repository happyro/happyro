      bonus2 bAddRace,RC_All,5*(.@r/3);
      bonus bLongAtkRate,7*(.@r/4);
      bonus bShortAtkRate,7*(.@r/4);
      if (.@r>=7) {
         bonus bRes,50;
         if (.@r>=9) {
            bonus bAspdRate,5;
            bonus bCritical,5;

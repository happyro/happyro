  - Id: 21019
    AegisName: Onimaru
    Name: 鬼丸
    Type: Weapon
    SubType: 2hSword
    Weight: 4200
    Attack: 75
    Range: 1
    Slots: 2
    Jobs:
      Knight: true
    Classes:
      All_Third: true
      Fourth: true
    Locations:
      Both_Hand: true
    WeaponLevel: 4
    EquipLevelMin: 130
    Refineable: true
    Script: |
      .@bStr = readparam(bStr);
      .@r = getrefine();
      bonus bBaseAtk,(min(120,.@bStr));
      if (.@bStr > 119)
         bonus bBaseAtk,160;
      else if (.@bStr > 107)
         bonus bBaseAtk,80;
      else if (.@bStr > 94)
         bonus bBaseAtk,40;
      if (.@r > 6)
         bonus bUnbreakableWeapon;
      bonus4 bAutoSpell,"NPC_WIDECURSE",4,100,0;
      if (.@r > 8)
         bonus4 bAutoSpellOnSkill,"LK_BERSERK","BS_OVERTHRUST",5,100;

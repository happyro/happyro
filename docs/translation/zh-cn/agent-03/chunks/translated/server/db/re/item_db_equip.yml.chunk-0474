      .@r = getrefine();
      bonus bUnbreakableWeapon;
      bonus bAtkRate,5;
      bonus2 bSkillAtk,"MT_TRIPLE_LASER",10;
      if (.@r>=7) {
         bonus bLongAtkRate,10;
         if (.@r>=9) {
            bonus2 bSkillAtk,"MT_TRIPLE_LASER",10;

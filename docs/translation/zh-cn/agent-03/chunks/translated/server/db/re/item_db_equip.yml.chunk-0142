  - Id: 15096
    AegisName: Hero_Trade_Mail
    Name: 英雄贸易铠甲
    Type: Armor
    Buy: 10
    Weight: 500
    Defense: 100
    Slots: 1
    Jobs:
      Alchemist: true
      Blacksmith: true
      Merchant: true
    Classes:
      Upper: true
      All_Third: true
      Fourth: true
    Locations:
      Armor: true
    ArmorLevel: 1
    EquipLevelMin: 160
    Refineable: true
    Script: |
      bonus bMaxHPrate,5;
      bonus bMaxSPrate,5;
      bonus bMatk,10;
      bonus bBaseAtk,10;
      .@r = getrefine();
      if (readparam(bStr) >= 90)
         bonus bStr,.@r/2;
      if (readparam(bInt) >= 90)
         bonus bInt,.@r/2;
      if (readparam(bAgi) >= 90)
         bonus bAgi,.@r/2;
      if (readparam(bVit) >= 90)
         bonus bVit,.@r/2;
      if (readparam(bDex) >= 90)
         bonus bDex,.@r/2;
      if (readparam(bLuk) >= 90)
         bonus bLuk,.@r/2;
      .@c = (.@r+1)*30;
      bonus2 bAddEff,Eff_Stun,.@c;
      bonus2 bAddEff,Eff_Silence,.@c;
      bonus2 bAddEff,Eff_Curse,.@c;
      bonus2 bAddEff,Eff_Poison,.@c;

//===== rAthena Script =======================================
//= Wolfchev's Laboratory
//===== By: ==================================================
//= Kisuka
//===== Current Version: =====================================
//= 1.0
//===== Compatible With: =====================================
//= rAthena Project
//===== Description: =========================================
//= Defeat Wolfchev's human experimentations.
//===== Additional Comments: =================================
//= 1.0 First version, edited. [Euphy]
//= 1.1 Moved the Enchant (Sorcerer#Bio4Reward) and Reward
//=		(Weird old man#Bio4Reward) NPC in merchant folder. [Capuche]
//============================================================

// Giacomo Girolam
//============================================================
lighthalzen,303,303,6	script	Giacomo Girolamo#kiup2	4_M_KHMAN,3,3,{
	if ((MaxWeight - Weight) < 1000 || !checkweight(1201, 1)) {
		mes "^FF0000检查背包。物品太多，无法进行任务。^000000";
		close;
	}
	if (lhz_curse > 30) {
		if (!lght_duk01) {
			if (Sex == SEX_MALE) {
				emotion ET_HNG;
				mes "[Giacomo Girolamo]";
				mes "....a guy....?";
				next;
				mes "[Giacomo Girolamo]";
				mes "啊！嘿！伙计！";
				next;
				select("怎么了？");
				emotion ET_QUESTION, playerattached();
				mes "[Giacomo Girolamo]";
				mes "你听说过总部位于这里的雷根贝勒公司进行可怕的人体实验吗？";
				next;
				select("什么？！人体实验？");
				emotion ET_HUK, playerattached();
				mes "[Giacomo Girolamo]";
				mes "没错！人体实验！！";
				mes "有很多传闻说他们真的进行可怕的人体实验，但贫民窟的人……因为雷根贝勒的福利活动，不愿相信。";
				next;
				emotion ET_PROFUSELY_SWEAT;
				mes "[Giacomo Girolamo]";
				mes "那些有钱人似乎知道些什么，却从不提起……";
				next;
				mes "[Giacomo Girolamo]";
				mes "啊！！而且这只有少数人知道。我从雷根贝勒实验室听说，有个人叫……呃……Wol……";
				next;
				emotion ET_SCRATCH;
				mes "[Giacomo Girolamo]";
				mes "总之！！有个叫 Wolf……的科学家突然被解雇了。我觉得他一定和传闻有关……";
				next;
				select("你是说……沃尔夫切夫？");
				emotion ET_SURPRISE;
				mes "[Giacomo Girolamo]";
				mes "哦？！对，是 Wolfchev！！名字就是 Wolfchev……那个疯狂科学家……";
				next;
				emotion ET_OK;
				mes "[Giacomo Girolamo]";
				mes "这样你应该更容易理解了……我发誓，他一定和传闻有关。";
				next;
				mes "[Giacomo Girolamo]";
				mes "顺便问问你，你知道他的什么事吗？";
				next;
				if (select("假装什么都不知道。", "告诉他你知道的事。") == 1) {
					mes "["+ strcharinfo(0) +"]";
					mes "不太清楚。我听过他的名字，但不了解他……";
					next;
					mes "[Giacomo Girolamo]";
					mes "嗯……你听起来很可疑，伙计！是吧？";
					next;
				} else {
					mes "["+ strcharinfo(0) +"]";
					mes "他瞒着雷根贝勒公司研究人类‘生命体’，有人向公司举报，所以他被解雇了。";
					next;
					emotion ET_BEST;
					mes "[Giacomo Girolamo]";
					mes "哦！伙计！你似乎知道很多！难道你和雷根贝勒有关？";
					next;
					emotion ET_THINK;
					mes "["+ strcharinfo(0) +"]";
					mes "... .... ...";
					next;
				}
				emotion ET_SCRATCH;
				mes "[Giacomo Girolamo]";
				mes "别担心。我没别的意思。";
				next;
				mes "[Giacomo Girolamo]";
				mes "我只是好奇，因为贫民窟的一些人和冒险者失踪了，";
				mes "我听说雷根贝勒用那些失踪者进行人体实验。希望你别误会。";
				next;
				lght_duk01 = 1;
				setquest 5109;
				mes "其实，这不是有趣的传闻。";
				mes "应该调查进行实验的实验室。";
				close;
			} else {
				emotion ET_THROB;
				mes "[Giacomo Girolamo]";
				mes "哦！多么美丽的女士！！";
				next;
				emotion ET_QUESTION;
				mes "[Giacomo Girolamo]";
				mes "美人怎么会来到这个充满危险传闻的地方？";
				next;
			switch(select("散步……", "出去玩……", "购物……")) {
				case 1:
					mes "[Giacomo Girolamo]";
					mes "啊……女士，你连走路都如此优雅……";
					next;
					break;
				case 2:
					mes "[Giacomo Girolamo]";
					mes "女士，即使在这个贫穷城镇闲逛，你也如此高贵……";
					next;
					break;
				case 3:
					mes "[Giacomo Girolamo]";
					mes "啊……女士……在贫民窟购物！！你是那种要逛遍每家店的人吗？";
					next;
					break;
				}
			}
			select("... .... ... ....");
			mes "[Giacomo Girolamo]";
			mes "我怎么敢询问女士的事情，还对她感兴趣……";
			next;
			emotion ET_OK;
			mes "[Giacomo Girolamo]";
			mes "我只希望女士能离开这个充满危险传闻的城镇……";
			next;
			select("危险的传闻？");
			emotion ET_QUESTION, playerattached();
			mes "[Giacomo Girolamo]";
			mes "啊……女士可能还没听说传闻。";
			next;
			mes "[Giacomo Girolamo]";
			mes "最近这个城镇，准确说是贫民窟的一些人……还有一些冒险者失踪了……";
			next;
			mes "[Giacomo Girolamo]";
			mes "因为失踪事件频繁发生，于是传出雷根贝勒在秘密实验室进行可怕人体实验的传闻。";
			next;
			select("什么？！人体实验？");
			emotion ET_HUK, playerattached();
			mes "[Giacomo Girolamo]";
			mes "没错！人体实验！！";
			mes "有很多传闻说确实进行了可怕的人体实验，但贫民窟的人……因为雷根贝勒的福利活动不愿相信。";
			next;
			mes "[Giacomo Girolamo]";
			mes "那些有钱人似乎愿意相信……我想……啊！！几周前那个人叫什么？Wolfchev？";
			next;
			mes "[Giacomo Girolamo]";
			mes "总之！！那个研究员被实验室解雇了。我觉得他一定和传闻有关。";
			next;
			mes "[Giacomo Girolamo]";
			mes "所以女士，请别待在这种地方，要注意安全。";
			next;
			lght_duk01 = 1;
			setquest 5109;
			mes "............ It seems a pretty serious matter.";
			mes "应该调查进行实验的实验室。";
			close;
		} else {
			mes "[Giacomo Girolamo]";
			if (Sex == SEX_MALE) {
				emotion ET_WRAP;
				mes "保重，别失踪了！";
			} else {
				emotion ET_BIGTHROB;
				mes "女士，小心。";
			}
			close;
		}
	} else {
		if (Sex == SEX_MALE) {
			emotion ET_DELIGHT;
			mes "[Giacomo Girolamo]";
			mes "只有那些美丽女士才是我活着的理由～！";
			mes "我 Giacomo Girolamo Casanova de Seingalt，可对你这样的男人没兴趣！！";
			next;
			emotion ET_FRET;
			mes "[Giacomo Girolamo]";
			mes "不过我可以听你说……你想对我说什么？";
			next;
			switch(select("不……？", "关于女士……", "你这个花花公子！！", "真羡慕你……", "最近有什么传闻？")) {
			case 1:
				emotion ET_SCRATCH;
				mes "[Giacomo Girolamo]";
				mes "喂，你挡路了，快走开……";
				close;
			case 2:
				emotion ET_FRET;
				mes "[Giacomo Girolamo]";
				mes "我不想谈论我珍贵的女士，更不想拿她们开玩笑。你和朋友聊吧。";
				close;
			case 3:
				mes "[Giacomo Girolamo]";
				mes "嘿……失礼了！！！我不是‘花花公子’，只是仰慕女士的人。";
				next;
				emotion ET_OK;
				mes "[Giacomo Girolamo]";
				mes "当然……是啊……如果我是花花公子，那全世界男人都是！我只是 Casanova。呜哈哈哈哈。";
				close;
			case 4:
				emotion ET_QUESTION;
				mes "[Giacomo Girolamo]";
				mes "哈……你……身边除了姐姐和母亲就没有其他女性吗？";
				next;
				mes "[Giacomo Girolamo]";
				mes "... .... ...";
				next;
				emotion ET_PROFUSELY_SWEAT;
				mes "[Giacomo Girolamo]";
				mes "哦……抱歉……我明白你的意思了……";
				close;
			case 5:
				mes "[Giacomo Girolamo]";
				mes "你……和表面看起来不一样？有意思……";
				next;
				mes "[Giacomo Girolamo]";
				mes "是的，最近贫民窟很多人和一些流浪冒险者失踪了，我也不知道原因。";
				next;
				mes "[Giacomo Girolamo]";
				mes "你也要小心……";
				close;
			}
		} else {
			emotion ET_QUESTION;
			mes "[Giacomo Girolamo]";
			mes "嘿，女士？";
			next;
			mes "[Giacomo Girolamo]";
			switch(rand(1,10)) {
			case 1:
				mes "从天堂坠落时一定很痛吧，我的天使？";
				next;
				break;
			case 2:
				mes "你一定累了，因为你一直在我的脑海中徘徊。";
				next;
				break;
			case 3:
				mes "昨晚一直在我的梦里走来走去，不累吗？";
				next;
				break;
			case 4:
				mes "不好意思，我好像丢了心。可以把你的借给我吗？";
				next;
				break;
			case 5:
				mes "你相信一见钟情吗？还是我们重新开始……？";
				next;
				break;
			case 6:
				mes "很抱歉，能和刚见面的人接吻吗？不行？那我先自我介绍。";
				next;
				break;
			case 7:
				mes "我第一次来这里，完全迷路了。能告诉我通往你心里的路吗？";
				next;
				break;
			case 8:
				mes "请给我一张地图……好找到路……我已经沉沦在你的眼眸里。";
				next;
				break;
			case 9:
				mes "你的眼睛……我想永远待在那里。";
				next;
				break;
			case 10:
				mes "我保证无论何时、无论遇到什么困难，我都会成为你的一切。";
				next;
				break;
			}
			emotion ET_BIGTHROB;
			mes "[Giacomo Girolamo]";
			mes "今天是我们初次见面，但我爱你，女士 <3";
			next;
			mes "[Giacomo Girolamo]";
			mes "我告诉你这些是因为担心你。你必须离开这个充满失踪案件的城镇。";
			close;
		}
	}

OnTouch:
	if (!lght_duk01)
		emotion (Sex == SEX_MALE? ET_HNG : ET_BIGTHROB), "Giacomo Girolamo#kiup2";
	end;
}

// Warp portal to the 4th Fl.
//============================================================
lhz_dun03,239,78,1	script	lhz_dun03_lhz_dun04	WARPNPC,1,1,{
	end;

OnTouch:
	if (lght_duk01 > 0 && lght_duk01 < 6) {
		mes "为了调查人体实验，我不得不下去，尽管那可怕的声音让我不想靠近。";
		close2;
		if (lght_duk01 < 3) {
			warp "que_lhz", 245, 56;
		} else if (lght_duk01 == 3) {
			warp "que_lhz", 96, 136;
		} else {
			warp "que_lhz", 148, 215;
		}
	} else {
		if (lhz_curse < 31) {
			mes "- Whistling sound -";
			mes "下方传来与风声混杂的可怕声音。";
			close2;
		}
		warp "lhz_dun04", 245, 56;
	}
	end;
}

// Warp Portal to the 3rd Fl.
//============================================================
lhz_dun04,244,61,1	warp	lhz_dun04_lhz_dun03	1,1,lhz_dun03,240,75

// Inside the Lab
//============================================================
que_lhz,242,50,0	script	#01Startpoint	-1,3,3,{
	end;

OnInit:
	initnpctimer;
	end;

OnTimer60000:
	mapannounce "que_lhz", "Man's whisper: Pl.. please.. save me.. I don't wanna die.. wouaaaa..", bc_map, "0x7DCBF0";
	end;

OnTimer120000:
	mapannounce "que_lhz", "Woman's whisper: .. Save.. aaaah.. us...", bc_map, "0x7DCBF0";
	end;

OnTimer180000:
	mapannounce "que_lhz", "Kid's whisper: Bawwww~ Where am I? Mama......aaaa....", bc_map, "0x7DCBF0";
	end;

OnTimer240000:
	mapannounce "que_lhz", "Oldman's whisper: Kirk...hel...help......", bc_map, "0x7DCBF0";
	end;

OnTimer300000:
	stopnpctimer;
	initnpctimer;
	end;

OnTouch:
	if (lght_duk01 == 1) {
		mes "我来到一处研究设施，看起来直到最近还在使用。";
		next;
		mes "虽然有些地方损毁，但基本设施还算完好。";
		next;
		lght_duk01 = 2;
		mes "再四处看看……";
		close;
	}
	end;
}

que_lhz,206,74,4	script	Researcher#02	4_LGTSCIENCE,3,3,{
	end;

OnTouch:
	if (lght_duk01 == 2) {
		emotion ET_HUK, playerattached();
		mes "["+ strcharinfo(0) +"]";
		mes "你！！！！就是 Wolfchev？";
		next;
		emotion ET_KIK;
		mes "[Wolfchev]";
		mes "人类！咔哈哈哈。人们通常讨厌这里，你为什么来？";
		next;
		mes "["+ strcharinfo(0) +"]";
		mes "你！！！我听说你在进行人体实验。Wolfchev！！";
		next;
		mes "["+ strcharinfo(0) +"]";
		mes "看来你现在还在继续！！！";
		next;
		emotion ET_KIK;
		mes "[Wolfchev]";
		mes "嘻嘻嘻。我看得出你知道我的事。是你指控我的吗？";
		mes "做了那种事还敢回来找我。嘻嘻嘻。";
		next;
		mes "[Wolfchev]";
		mes "很久没见到人类了，感觉不错，";
		mes "但我得走了。嘻嘻嘻。";
		next;
		mes "- Wolfchev 发出尴尬笑声逃走了。-";
		next;
		erasequest 5109;
		setquest 5110;
		lght_duk01 = 3;
		emotion ET_HUK, playerattached();
		mes "["+ strcharinfo(0) +"]";
		mes "哇！Wolfchev，站住！";
		close2;
		warp "que_lhz", 96, 136;
	}
	end;
}

que_lhz,94,119,4	script	Researcher#03	4_LGTSCIENCE,{
	if ((MaxWeight - Weight) < 1000 || !checkweight(1201, 1)) {
		mes "^FF0000检查背包。物品太多，无法进行任务。^000000";
		close;
	}
	if (lght_duk01 == 3) {
		emotion ET_PROFUSELY_SWEAT;
		mes "[Wolfchev]";
		mes "（喘气）呸……你还在跟着我。喂，为什么一直跟着我？";
		next;
		mes "["+ strcharinfo(0) +"]";
		mes "Wolfchev……你之前说是在为所有人研究。";
		next;
		mes "[Wolfchev]";
		mes "我可能说过……那又怎样？";
		next;
		mes "["+ strcharinfo(0) +"]";
		mes "但是你的实验似乎很危险。为什么这会是所有人想要的？";
		next;
		emotion ET_KIK;
		mes "[Wolfchev]";
		mes "每个人都想变强，想支配他人，让别人服从并崇拜自己。你没有这种欲望吗？";
		next;
		mes "["+ strcharinfo(0) +"]";
		mes "... .... ...";
		next;
		mes "[Wolfchev]";
		mes "想自救就别再跟着我。滚开。";
		next;
		mes "Wolfchev 发出怪声再次逃走。";
		next;
		lght_duk01 = 4;
		mes "["+ strcharinfo(0) +"]";
		mes "啊啊啊！！你！！又逃跑……站住！";
		close2;
		warp "que_lhz", 148, 215;
	}
	end;
}

que_lhz,147,224,4	script	Researcher#04	4_LGTSCIENCE,{
	if ((MaxWeight - Weight) < 1000 || !checkweight(1201, 1)) {
		mes "^FF0000 Check up your inventory. You got too many items to carry out the quest. ^000000";
		close;
	}
	if (lght_duk01 == 4) {
		mes "[Wolfchev]";
		mes "你真是坚持不懈。还是说……你喜欢我？嘻嘻嘻。";
		next;
		emotion ET_THINK;
		mes "["+ strcharinfo(0) +"]";
		mes "... .... ...";
		next;
		specialeffect EF_SIGHTRASHER;
		mes "你沉默不语，Wolfchev 嘲笑你并按下手中按钮。周围的实验豚鼠随即醒来。";
		next;
		for(.@i = 1; .@i < 9; .@i++)
			donpcevent "Human Guinea pig#0"+.@i+"::OnEnable";
		mes "[Wolfchev]";
		mes "又到了……道别的时间。";
		next;
		emotion ET_SURPRISE;
		mes "[Wolfchev]";
		mes "嗯！也许……";
		next;
		mes "[Wolfchev]";
		mes "如果你是来找我做实验的，我可以对你更好。";
		next;
		donpcevent "#Eventctrl::OnEnable";
		progressbar "FF00FF", 5;
		emotion ET_HUK;
		mes "[Wolfchev]";
		mes "我的天……发生了什么？";
		next;
		donpcevent "#Eventctrl::OnEnable2";
		for(.@i = 1; .@i < 9; .@i++)
			donpcevent "Human Guinea pig#0"+.@i+"::OnDisable";
		mes "[Wolfchev]";
		mes "不！别靠近我！不要！！";
		next;
		lght_duk01 = 5;
		mes "首先，我得处理那些实验豚鼠！";
		close;
	} else if (lght_duk01 == 5) {
		.@i = rand(1,3);
		if (.@i == 2) {
			mes "怪物也在攻击 Wolfchev，他陷入混乱，不知所措。";
			next;
			specialeffect EF_STUNATTACK;
			specialeffect EF_STUNATTACK;

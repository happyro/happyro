// Timeless Item Quests
// The Owner Of Old Ring
//============================================================
payon,157,54,5	script	An Old Woman#pa0829	8_F_GRANDMOTHER,{
	if (!checkweight(1201,1)) {
		mes "你携带的物品种类太多。减少物品种类后再试。";
		close;
	}
	if (MaxWeight - Weight < 1000) {
		mes "你携带的物品太重，无法继续。减轻重量后再试。";
		close;
	}
	if (BaseLevel < 140) {
		mes "[Jeum-sun]";
		mes "我仍活在记忆中。创造更多回忆吧……";
		next;
		mes "[Jeum-sun]";
		mes "哦，你达到 140 级了吗？我不和弱小的冒险者说话。";
		close;
	}
	switch( checkquest(12326,PLAYTIME) ) {
	case -1:
		mes "[Jeum-sun]";
		mes "很多年前我还是女孩时，曾喜欢过一个男人。我不知道该如何告诉他我的感受……";
		next;
		mes "[Jeum-sun]";
		mes "我以前常逗他的鸟，希望他注意到我对他有兴趣。这样的日子持续了一阵子。";
		next;
		mes "[Jeum-sun]";
		mes "后来我们不知怎么开始交往。现在谈起来仍然很害羞。";
		next;
		mes "[Jeum-sun]";
		mes "总之，到了适婚年龄我们就结婚了。他常为买不起戒指向我道歉。";
		next;
		mes "[Jeum-sun]";
		mes "我们结婚 40 年了，他仍会说^0000ff‘亲爱的~你想要戒指吗？’^000000。";
		next;
		mes "[Jeum-sun]";
		mes "我告诉他……老太婆要戒指有什么用？";
		next;
		mes "[Jeum-sun]";
		mes "我本该阻止他的。我仍清楚记得他的脸。";
		next;
		select("他发生了什么？" );
		mes "[Jeum-sun]";
		mes "他离家去买戒指后就再也没回来。";
		next;
		mes "^0000ff老妇人低下头，双眼泛红。^000000";
		if (countitem(6650)) {// Shabby_Ring
			next;
			if (select("停止交谈。:展示脸虫巢穴中的戒指。") == 2) {
				mes "[Jeum-sun]";
				mes "这枚戒指怎么样？";
				next;
				mes "[Jeum-sun]";
				mes "哦……亲爱的~";
				next;
				mes "^0000ff老妇人读着戒指内的刻字，开始哭泣。";
				mes "[正善，我亲爱的花儿]^000000";
				next;
				mes "^0000ff你感受到温暖的能量。也许这是制作戒指的男人的愿望。^000000";
				specialeffect EF_SPHERE;
				next;
				mes "温暖的能量赋予你力量。";
				delitem 6650,1;// Shabby_Ring
				setquest 12326;// The owner of old ring
				getexp 70000,55000;
			}
		}
		close;
	case 0:
	case 1:
		mes "老妇人抱着戒指不停哭泣。现在似乎没法和她交谈。";
		close;
	case 2:
		mes "遗憾的是，这位女士因情绪突然变化，似乎无法记起过去。我们谨慎交谈，听听她的故事。";
		erasequest 12326;
		close;
	}
}

// The Memory Of Old Photo Album
//============================================================
payon,161,54,3	script	Exotic Merchant#pa0829	4W_M_03,{
	if (!checkweight(1201,1)) {
		mes "你携带的物品种类太多。减少种类后再试。";
		close;
	}
	if (MaxWeight - Weight < 1000) {
		mes "你携带的物品太重，无法继续。减轻重量后再试。";
		close;
	}
	if (BaseLevel < 140) {
		mes "[Sergio]";
		mes "财富或名声不重要。最重要的是家人。";
		next;
		mes "[Sergio]";
		mes "你至少达到 140 级了吗？";
		close;
	}
	switch( checkquest(12327,PLAYTIME) ) {
	case -1:
		mes "[Sergio]";
		mes "我模糊记得曾和父亲的武装商队一起旅行。";
		next;
		mes "[Sergio]";
		mes "我隐约记得商队遭到巨大蛇形生物攻击后，所有人都四散了。";
		next;
		mes "[Sergio]";
		mes "那时我失去了家人，甚至记不清他们的脸。";
		next;
		mes "[Sergio]";
		mes "现在我组建了自己的武装商队，重新开始生活。但过去的记忆一直困扰着我。";
		next;
		mes "[Sergio]";
		mes "我来到这个城镇，是想找家人和武装商队的记录，但至今一无所获。";
		if (countitem(6652)) {
			next;
			if (select("停止交谈。:给他看旧相册") == 2) {
				mes "[Sergio]";
				mes "对！我想起来了。这是曾为我父亲的武装商队工作的人。";
				next;
				mes "[Sergio]";
				mes "天啊……这里还有其他照片……";
				next;
				mes "^0000ffA smile of lonely satisfaction spreads over the face of Sergio while looking at a photo album.^000000";
				next;
				mes "^0000ffA gentle energy surrounds Sergio.^000000";
				specialeffect EF_SPHERE;
				next;
				mes "看到塞尔吉奥脸上的满足，你深受触动。";
				delitem 6652,1;// Aged_Photo_Album
				setquest 12327;// The memory of old photo album
				getexp 70000,55000;
			}
		}
		close;
	case 0:
	case 1:
		mes "塞尔吉奥继续看着相册。我们别打扰他。";
		close;
	case 2:
		mes "从脸虫巢穴拿到新相册后，就能再次和塞尔吉奥交谈。";
		erasequest 12327;
		close;
	}
}

// Dol-Seoi's Sorrow
//============================================================
payon,161,50,1	script	Strong Looking Man#pa829	4_M_ORIENT01,{
	if (!checkweight(1201,1)) {
		mes "你携带的物品种类太多。减少种类后再试。";
		close;
	}
	if (MaxWeight - Weight < 1000) {
		mes "你携带的物品太重，无法继续。减轻重量后再试。";
		close;
	}
	if (BaseLevel < 140) {
		mes "[Dol-Seoi]";
		mes "我能为你做什么？";
		next;
		mes "[Dol-Seoi]";
		mes "你至少达到 140 级了吗？";
		close;
	}
	switch( checkquest(12328,PLAYTIME) ) {
	case -1:
		mes "[Dol-Seoi]";
		mes "我曾是一个富有女士的仆人。她一直很善良，但患有严重咳嗽，只有服用特殊药丸才能缓解。";
		next;
		mes "[Dol-Seoi]";
		mes "我以前从武装商队那里取得药丸，但听说他们遭到蛇攻击，从那以后就再也拿不到药了。";
		next;
		mes "[Dol-Seoi]";
		mes "我到处寻找，却没人能给我药丸，最后我的主人去世了。要不是那条蛇……";
		next;
		select("你想复仇吗？" );
		mes "[Dol-Seoi]";
		mes "嗯……";
		next;
		mes "[Dol-Seoi]";
		mes "是的……但我和那条蛇没有关系。我只是曾侍奉主人的无用仆人。";
		next;
		mes "^0000ffYou catch a glimpse of complicated rage and sorrow in his eyes.^000000";
		if (countitem(6653)) {
			next;
			if (select("停止交谈。:给他看旧药丸。") == 2) {
				mes "[Dol-Seoi]";
				mes "等等！你从哪里得到的？";
				next;
				select("我杀了一条蛇……" );
				mes "[Dol-Seoi]";
				mes "这颗药丸……我的主人，如果我有这颗药丸……";
				next;
				mes "^0000ffHe begins to weep like a wounded Muka. She must have meant a lot to him...^000000";
				next;
				mes "^0000ffI feel gentle energy around Dol-Seoi.^000000";
				specialeffect EF_SPHERE;
				delitem 6653,1;// Aged_Tablet
				setquest 12328;// Dol-Seoi's Sorrow
				getexp 70000,55000;
			}
		}
		close;
	case 0:
	case 1:
		mes "多尔·西奥茫然地握着旧药丸。现在别打扰他。";
		close;
	case 2:
		mes "从脸虫巢穴拿到另一颗旧药丸后，就能再次和多尔·西奥交谈。";
		erasequest 12328;
		close;
	}
}

// Keaton's Bracelet
//============================================================
payon,139,68,4	script	A dreary man#pa0829	4_M_NFDEADMAN,{
	if (!checkweight(1201,1)) {
		mes "你携带的物品种类太多。减少种类后再试。";
		close;
	}
	if (MaxWeight - Weight < 1000) {
		mes "你携带的物品太重，无法继续。减轻重量后再试。";
		close;
	}
	if (BaseLevel < 140) {
		mes "[Keaton]";
		mes "...";
		next;
		mes "[Keaton]";
		mes "除非你达到 140 级，否则我不会认真和你交谈。";
		close;
	}
	switch( checkquest(12329,PLAYTIME) ) {
	case -1:
		mes "^0000ffIt looks like a dead soul but you don't feel maliciousness from it. His thoughts have been delivered piece by piece so it isn't easy to understand.^000000";
		next;
		mes "^999999[Keaton]";
		mes "基顿……不擅长说话。^000000";
		next;
		mes "^999999[Keaton]";
		mes "基顿很久以前就去世了。基顿并不坏。^000000";
		next;
		mes "^999999[Keaton]";
		mes "基顿……需要手镯，那很重要。基顿的朋友给了手镯。^000000";
		next;
		mes "^999999[Keaton]";
		mes "基顿为了寻找手镯去追蛇。坏蛇杀死了基顿。^000000";
		if (countitem(6651)) {
			next;
			if (select("停止交谈。:给他看生锈的手镯。") == 2) {
				mes "^999999[Keaton]";
				mes "这是基顿的手镯！！^000000";
				specialeffect EF_MAPPILLAR2;
				next;
				mes "^999999[Keaton]";
				mes "基顿……高兴。打败坏蛇！！^000000";
				next;
				mes "^0000ffKeaton seems to shine brighter.^000000";
				delitem 6651,1;// Rusted_Bracalet
				setquest 12329;// Keaton's Bracelet
				getexp 70000,55000;
			}
		}
		close;
	case 0:
	case 1:
		mes "基顿的灵魂似乎在微笑。现在最好让他得到应有的安宁。";
		close;
	case 2:
		mes "基顿很悲伤，也许是因为手镯坏了。把在脸虫巢穴找到的其他生锈手镯带给他。";
		erasequest 12329;
		close;
	}
}

dali,83,67,5	script	Old Sign#1	4_BOARD3,{
	.@face_name$ = $120719_str_face$;
	.@face_timer  = $120719_num_face;
	.@face_member = $120903_num_face;
	.@time_m = .@face_timer / 60;
	.@time_s = .@face_timer - (.@time_m * 60);
	if (.@face_name$ == "") {
		mes "没有记录，因为没人更新数据。";// Custom text
		close;
	}
	if (.@face_timer < 60)
		.@time_txt$ = callfunc( "F_InsertPlural", .@time_s, "Second" );
	else
		.@time_txt$ = callfunc( "F_InsertPlural", .@time_m, "Minute" ) + " " + callfunc( "F_InsertPlural", .@time_s, "Second" );
	if (.@face_member > 0)
		.@string$ =  " with ^ff0044" + .@face_member + " party " + ( .@face_member > 1 ? "members" : "members" )  + "^000000";
	mes "-- Faceworm's Nest Records --";
	mes "最佳时间属于冒险者 ^ff0044" + .@face_name$ + "^000000" + .@string$ + "。";
	mes "当前记录时间为 ^0000ff" + .@time_txt$ + "^000000。";
	close;

OnInit:
	if (!$120719_num_face)
		$120719_num_face = 3600;
	if (rand(1,100) > 97) {
		$120719_num_face = 3600;
		$120719_str_face$ = "";
	}
	end;
}

dali,80,60,4	script	Magic Scholar	4_M_SAGE_C,{
	if (BaseLevel < 140) {
		mes "[Magic Scholar]";
		mes "你的资格不足，无法进入。达到 140 级前，先去其他地方看看吧。";
		close;
	}
	.@party_id = getcharid(1);
	.@md_name$ = "Faceworm's Nest";
	if (.@party_id < 1) {
		mes "[Magic Scholar]";
		mes "你没有队伍？即使独自前来，也请组队后再回来。";
		close;
	}
	switch( checkquest(12325,PLAYTIME) ) {
	case -1:
		if (is_party_leader() == true) {
			mes "[Magic Scholar]";
			mes "我能为你做什么？";
			next;
			switch( select("预约脸虫巢穴:你在这里做什么？:停止交谈。") ) {
			case 1:
				switch( instance_create(.@md_name$) ) {
				case -3:
					dispbottom "Memorial Dungeon, '" + .@md_name$ + "' is already in progress.",0xFFFFFF;
					break;
				case -4:
				case -2:
				case -1:
					mes "[Magic Scholar]";
					mes "糟糕，我的手滑了。需要再次激活裂缝。";
					close;
				}
				mes "[Magic Scholar]";
				mes "空间已经稳定。";
				mes "请稍等。";
				close;
			case 2:
				break;
			case 3:
				mes "[Magic Scholar]";
				mes "好，我明白了。改变主意后请再回来。";
				close;
			}
		}
		mes "[Magic Scholar]";
		mes "我正在研究这里的时空裂缝。";
		next;
		mes "[Magic Scholar]";
		mes "我的研究是用魔法稳定这里的空间，以便进行次元旅行。";
		next;
		mes "[Magic Scholar]";
		mes "这道空间裂缝通往过去的记忆。许多冒险者进去过，却没人告诉我里面有什么……";
		next;
		mes "[Magic Scholar]";
		mes "这里还有一块记录名字和时间的奇怪牌子，我只能推测属于那些冒险者。";
		next;
		mes "[Magic Scholar]";
		mes "总之，如果你是队长，我可以为你激活通道。";
		close;
	case 0:
	case 1:
		mes "[Magic Scholar]";
		mes "时空裂缝还不够安全，无法往返。余效计时结束后再回来。";
		close;
	case 2:
		mes "^0000ffThe trace of dimensional space travelling has disappeared. You can now move between dimensions.^000000";
		erasequest 12325;
		close;
	}
}

dali,72,55,4	script	Interdimensional Device	CLEAR_NPC,{
	if (BaseLevel < 140) {
		mes "[Interdimensional Device]";
		mes "你的力量等级不足，无法穿越空间。达到 140 级后再回来。";
		close;
	}
	.@party_id = getcharid(1);
	.@md_name$ = "Faceworm's Nest";
	if (.@party_id < 1) {
		mes "[Interdimensional Device]";
		mes "没有队伍？即使独自前来，也请组队后再回来。";
		close;
	}
	switch( checkquest(12325,PLAYTIME) ) {
	case -1:
		switch( instance_enter(.@md_name$) ) {
		case IE_OTHER:
			mes "[Interdimensional Device]";
			mes "发生未知错误。";
			close;
		case IE_NOINSTANCE:
			mes "[Interdimensional Device]";
			mes "空间旅行通道尚未激活。";
			close;
		case IE_NOMEMBER:// Custom text
			mes "[Interdimensional Device]";
			mes "你无权访问该装置。";
			close;
		case IE_OK:
			mapannounce "dali", getpartyname(.@party_id) + " party's party member " + strcharinfo(0) + " enters " + .@md_name$ + ".",bc_map,"0x00ff99";
			setquest 12325;// Faceworm's Nest after-effects
			//warp "1@face",112,374;
			end;
		}
	case 0:
	case 1:
		mes "[Interdimensional Device]";
		mes "检测到近期空间旅行痕迹。禁止访问。";
		close;
	case 2:
		mes "^0000ffThe trace of dimensional space travelling has disappeared. You can now move between dimensions.^000000";
		erasequest 12325;
		close;
	}
}

// Instance Scripts :: in_face
// 1st Stage
//============================================================
1@face,110,348,6	script	Chaos#0	4_M_CHAOS,{
	cutin "h_chaos01",2;
	if (is_party_leader() == false) {
		mes "[Chaos]";
		mes "我不知道这是怎么回事，但我正在和你的队长交谈，请稍等好吗？";
		close2;
		cutin "",255;
		end;
	}
	.@account_id = getcharid(3);
	.@player_name$ = strcharinfo(0);
	mes "[Chaos]";
	mes "真的吗？我不知道会有赏金猎人来这里。";
	npctalk "Chaos: Really? I didn't know that a bounty hunter was coming here.";
	next;
	select("等等！这是误会。" );
	cutin "",255;
	mes "[" + .@player_name$ + "]";
	mes "不！我想你误会了！我们不是赏金猎人……";
	unittalk .@account_id, .@player_name$ + ": No! I think you're mistaken! We are not bounty hunters...";
	next;
	cutin "h_chaos01",2;
	mes "[Chaos]";
	mes "不，不必解释……脸虫不属于任何人。";
	npctalk "Chaos: No, No need to make an excuse... The faceworm belongs to nobody.";
	next;
	select("脸虫？" );
	cutin "",255;
	mes "[" + .@player_name$ + "]";
	mes "脸虫？我从没听说过。";
	unittalk .@account_id, .@player_name$ + ": Faceworm? I've never heard about it.";
	close2;
	donpcevent instance_npcname("Chaos#01") + "::OnStart";
	end;
}

1@face,110,348,6	script	Chaos#01	4_M_CHAOS,{
	end;
OnStart:
	.@iris_name$ = instance_npcname("Iris#0");
	donpcevent instance_npcname("#globaltimer22") + "::OnT_s";
	hideoffnpc instance_npcname("Chaos#01");
	hideonnpc instance_npcname("Chaos#0");
	sleep 5000;
	npctalk "Chaos: Hahaha, you really never heard about it? Faceworm is the name of a monster which has recently showed up in this area.";
	sleep 5000;
	npctalk "Chaos: I don't care. I would not care as long as you don't disturb me.";
	sleep 5000;
	npctalk "Iris: Ah~ A gentle breeze~", .@iris_name$;
	sleep 3000;
	npctalk "Iris: Hehe, the weather has been great. I'm so happy~", .@iris_name$;
	sleep 3000;
	npctalk "Iris: How about you Chaos?", .@iris_name$;
	sleep 3000;
	npctalk "Chaos: It will only be for the time being.";
	sleep 3000;
	npctalk "Chaos: A black wind has started blowing.";
	sleep 4000;
	npctalk "Chaos: Iris! I feel like faceworms are around here. Maybe, the queen's nest is in the deepest side of this forest!";
	sleep 5000;

poring_w02,98,113,0	script	Deviling Guardian#wop_dd	111,{
	cutin "wop_emb0" + $@wop_doorcount_d,1;
	if ($@wop_doorcount_d < 4) {
		if (wop_team == 1) {
			mes "这里有一台安装战争徽章的装置。";
			mes "可以看到用于安装徽章的空槽。";
			next;
			switch(select("安装战争徽章。:取消。")) {
			case 1:
				if (countitem(7773)) {
					if ($@wop_doorcount_d < 4) {
						mes "战争徽章已安装。";
						delitem 7773,1; // War_Badge
						set $@wop_doorcount_d,$@wop_doorcount_d + 1;
						cutin "wop_emb0" + $@wop_doorcount_d,1;
						if ($@wop_doorcount_d == 4) {
							next;
							mes "大门已启动。";
							donpcevent "#droom_ingate_wop::OnEnable";
							donpcevent "#droom_outgate_wop::OnEnable";
						}
						close2;
					}
					else {
						mes "所有战争徽章均已安装。";
						mes "无需继续安装。";
						close2;
					}
				}
				else {
					mes "^4d4dff-缺少战争徽章。击杀对方队伍成员可以获得战争徽章。-^000000";
					close2;
				}
				break;
			case 2:
				mes "取消。";
				close2;
			}
		}
		else {
			mes "这里有一台安装战争徽章的装置。";
			mes "小心别让敌人夺走战争徽章并安装在这里。";
			close2;
		}
	}
	else {
		mes "所有战争徽章均已安装。";
		close2;
	}
	cutin "",255;
	end;

OnInit:
	set $@wop_doorcount_d,0;
	end;
}


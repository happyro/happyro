// Deviruchi
//============================================================
poring_w02,99,201,3	script	Deviruchi#wop_endmaster	738,{
	if (MaxWeight-Weight < 2000 || checkweight(1201,1) == 0) {
		mes "- 等一下！！-";
		mes "- 你现在携带的物品 -";
		mes "- 太多了。-";
		mes "- 请先减轻负重 -";
		mes "- 再试一次。-";
		close;
	}
	set .@a_point,$@wop_deadcount_a;
	set .@d_point,$@wop_deadcount_d;
	if (getcharid(1) == $@wop_team_a) {
		if (.@a_point < .@d_point) {
			mes "[Devi]";
			mes "干得好！";
			mes "多亏了你，我们提高了获胜机会。";
			mes "请收下这些波利硬币，以表达我们的感谢。";
			next;
			if (wop_team == 1) {
				mes "[Devi]";
				mes "再见，我的人类朋友。";
				close2;
				getitem 7539,3; // Poring_Coin
				warp "prt_fild08",150,370;
				end;
			}
			else {
				mes "[Devi]";
				mes "等一下，你看起来很可疑！！";
				mes "啊，我明白了！你是恶魔波利那边的？！";
				mes "你在监视我们！";
				mes "我绝不会原谅你！";
				close2;
				percentheal 99,0;
				warp "prt_fild08",150,370;
				end;
			}
		}
		else if (.@a_point == .@d_point) {
			mes "[Devi]";
			mes "你已经尽力了。";
			mes "真遗憾，战斗打成了平局……";
			mes "即便如此，还是感谢你为我们而战。请收下这枚波利硬币。";
			next;
			if (wop_team == 1) {
				mes "[Devi]";
				mes "再见，我的人类朋友。";
				close2;
				getitem 7539,1; // Poring_Coin
				warp "prt_fild08",150,370;
				end;
			}
			else {
				mes "[Devi]";
				mes "等一下，你看起来很可疑！！";
				mes "啊，我明白了！你是恶魔波利那边的？！";
				mes "你在监视我们！";
				mes "一定是你让战斗打成平局！！";
				mes "我绝不会原谅你！";
				close2;
				percentheal 99,0;
				warp "prt_fild08",150,370;
				end;
			}
		}
		else {
			if (wop_team == 1) {
				mes "[Devi]";
				mes "看来我们的运气不好……";
				mes "我们输了，什么也没法给你……";
				next;
				mes "[Devi]";
				mes "再见，我的人类朋友。";
				close2;
				warp "prt_fild08",150,370;
				end;
			}
			else {
				mes "[Devi]";
				mes "等一下……这里有叛徒！";
				mes "啊，我明白了！你是恶魔波利那边的？！";
				mes "你在监视我们，天使波利！";
				next;
				mes "[Devi]";
				mes "你应该感到羞愧！";
				close2;
				percentheal 99,0;
				warp "prt_fild08",150,370;
				end;
			}
		}
	}
	else if (getcharid(1) == $@wop_team_d) {
		if (.@a_point > .@d_point) {
			mes "[Devi]";
			mes "干得好！";
			mes "多亏了你，我们提高了获胜机会。";
			mes "请收下这些波利硬币，以表达我们的感谢。";
			next;
			if (wop_team == 2) {
				mes "[Devi]";
				mes "再见，我的人类朋友。";
				close2;
				getitem 7539,3; // Poring_Coin
				warp "prt_fild08",150,370;
				end;
			}
			else {
				mes "[Devi]";
				mes "等一下，你看起来很可疑！！";
				mes "啊，我明白了！你是天使波利那边的？！";
				mes "你在监视我们！！";
				mes "我绝不会原谅你！";
				close2;
				percentheal 99,0;
				warp "prt_fild08",150,370;
				end;
			}
		}
		else if (.@a_point == .@d_point) {
			mes "[Devi]";
			mes "你已经尽力了。";
			mes "真遗憾，战斗打成了平局……";
			mes "即便如此，还是感谢你为我们而战。请收下这枚波利硬币。";
			next;
			if (wop_team == 2) {
				mes "[Devi]";
				mes "再见，我的人类朋友。";
				close2;
				getitem 7539,1; // Poring_Coin
				warp "prt_fild08",150,370;
				end;
			}
			else {
				mes "[Devi]";
				mes "等一下，你看起来很可疑！！";
				mes "啊，我明白了！你是天使波利那边的？！";
				mes "你在监视我们！";
				mes "一定是你让战斗打成平局！！";
				mes "我绝不会原谅你！";
				close2;
				percentheal 99,0;
				warp "prt_fild08",150,370;
				end;
			}
		}
		else {
			if (wop_team == 2) {
				mes "[Devi]";
				mes "看来我们的运气不好……";
				mes "我们输了，什么也没法给你……";
				next;
				mes "[Devi]";
				mes "我允许你回到人类世界。";
				close2;
				warp "prt_fild08",150,370;
				end;
			}
			else {
				mes "[Devi]";
				mes "等一下，你看起来很可疑！！";
				mes "啊，我明白了！你是天使波利那边的？！";
				mes "你在监视我们，恶魔波利！";
				next;
				mes "[Devi]";
				mes "你应该感到羞愧！";
				close2;
				percentheal 99,0;
				warp "prt_fild08",150,370;
				end;
			}
		}
	}
	else {
		mes "[Devi]";
		mes "真奇怪……你的队伍名称没有登记。";
		mes "抱歉，规则就是规则。队伍未登记的话我无法帮助你。";
		close;
	}
OnInit:
	disablenpc "Deviruchi#wop_endmaster";
	end;

OnEnable:
	enablenpc "Deviruchi#wop_endmaster";
	initnpctimer;
	end;

OnDisable:
	disablenpc "Deviruchi#wop_endmaster";
	end;

OnTimer3000:
	mapwarp "poring_w02","poring_w02",99,196;
	end;

OnTimer5000:
	mapannounce "poring_w02","Doppel先生：请允许我向为波利英勇奋战的人类赠送纪念品！请去找Devi。",0,0x00ff00;
	end;

OnTimer65000:
	mapannounce "poring_w02","Doppel先生：时间到！让我把你们传送出去。",0,0x00ff00;
	end;

OnTimer68000:
	mapwarp "poring_w02","poring_w01",112,138;
	end;

OnTimer68100:
	donpcevent "#wop_master::OnStop";
	donpcevent "#wop_devillium1::OnReset";
	donpcevent "#wop_devillium2::OnReset";
	donpcevent "#wop_angellium1::OnReset";
	donpcevent "#wop_angellium2::OnReset";
	set $@wop_team_a,0;
	set $@wop_team_d,0;
	set $@wop_deadcount_a,0;
	set $@wop_deadcount_d,0;
	set $@wop_teamcount,0;
	set $@wop_doorcount_a,0;
	set $@wop_doorcount_d,0;
	donpcevent "#wop_warp_a::OnDisable";
	donpcevent "#wop_warp_d::OnDisable";
	donpcevent "Mr. Doppel#wop_team_a::OnDisable";
	donpcevent "Mr. Doppel#wop_team_d::OnDisable";
	donpcevent "#wop_warp_rtry::OnDisable";
	donpcevent "Poring#wop_door_a::OnEnable";
	donpcevent "Poring#wop_door_d::OnEnable";
	donpcevent "Poring#wop_door_all::OnEnable";
	stopnpctimer;
	end;
}

// Gate Guardian
//============================================================
poring_w02,99,52,0	script	Angeling Guardian#wop_da	111,{
	cutin "wop_emb0" + $@wop_doorcount_a,1;
	if ($@wop_doorcount_a < 4) {
		if (wop_team == 2) {
			mes "这里有一个装备战争徽章的装置。";
			mes "我能看到用于装备徽章的空槽。";
			next;
			switch(select("装备战争徽章:取消")) {
			case 1:
				if (countitem(7773)) {
					if ($@wop_doorcount_a < 4) {
						mes "战争徽章已装备。";
						delitem 7773,1; // War_Badge
						set $@wop_doorcount_a,$@wop_doorcount_a + 1;
						cutin "wop_emb0" + $@wop_doorcount_a,1;
						if ($@wop_doorcount_a == 4) {
							next;
							mes "大门已启动。";
							donpcevent "#aroom_ingate_wop::OnEnable";
							donpcevent "#aroom_outgate_wop::OnEnable";
						}
						close2;
					}
					else {
						mes "所有战争徽章都已装备。";
						mes "不需要再装备了。";
						close2;
					}
				}
				else {
					mes "^4d4dff - 缺少战争徽章。击败敌方队员即可获得战争徽章。- ^000000";
					close2;
				}
				break;
			case 2:
				mes "取消。";
				close2;
			}
		}
		else {
			mes "这里有一个装备战争徽章的装置。";
			mes "小心不要让敌人夺走并在这里装备你的战争徽章。";
			close2;
		}
	}
	else {
		mes "所有战争徽章都已装备。";
		close2;

1@tnm3,43,175,3	script	Young Girl#tnm01	4_F_DST_CHILD,{
	if ('devil_tower < 9)
		end;
	if ('devil_tower == 9) {
		mes "[Young Girl]";
		mes "城堡里为什么有恶魔？！";
		mes "救救我！";
		close;
	}
	if ('devil_tower == 10) {
		if (is_party_leader() == false) {
			mes "[Young Girl]";
			mes "*哭泣* 恶魔太可怕了。";
			close;
		}
		mes "[Young Girl]";
		mes "恶魔为什么突然出现，";
		mes "好多守卫都受伤了。";
		npctalk "小女孩：恶魔为什么突然出现，好多守卫都受伤了。";
		next;
		select("他们在哪里？");
		unittalk getcharid(3), "" + strcharinfo(0) + "：他们在哪里？";
		mes "[Young Girl]";
		mes "他们在摩洛克城堡。我父亲是骑士。";
		npctalk "他们在摩洛克城堡。我父亲是骑士。";
		next;
		mes "[Young Girl]";
		mes "好像发生了什么事，我听到楼下有奇怪的声音。";
		npctalk "小女孩：好像发生了什么事，我听到楼下有奇怪的声音。";
		next;
		mes "[Young Girl]";
		mes "我看见几个黑衣人进去了。城堡里究竟发生了什么？";
		npctalk "小女孩：我看见几个黑衣人进去了。城堡里究竟发生了什么？";
		next;
		mes "[Young Girl]";
		mes "爸爸……爸爸请你平安。*抽泣*";
		mes "请跟我从那个架子后面的通道走！";
		npctalk "小女孩：请跟我从那个架子后面的通道走！";
		close2;
		if (is_party_leader() == true && 'devil_tower == 10) {

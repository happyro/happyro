	mes "[Mei Yen Fang]";
	mes "你抓到他了？！";
	mes "哇，你真勇敢。";
	mes "我该准备重新开店了。";
	mes "不过得先订些酒。";
	next;
	mes "[Mei Yen Fang]";
	mes "薛峰喝光了店里的酒，";
	mes "而且盗窃事件吓跑了客人，";
	mes "我也没补货……";
	mes "下次再来吧。";
	mes "我会准备好酒。";
	close;
}

gon_in,165,16,4	script	Man in hangover#gon	748,{
	if (b_sword < 4) {
		mes "[Xue Bong]";
		mes "啊……我的胃……我的头……";
		mes "我不该喝这么多……";
		mes "呃……";
		emotion ET_PROFUSELY_SWEAT;
		close;
	}
	else if (b_sword < 6) {
		switch(b_sword) {
		case 4:
			if (countitem(506) < 1) {
				mes "[Xue Bong]";
				mes "*呃！*我感觉不舒服……";
				mes "有人能给我带瓶药吗？";
				mes "*呻吟*……";
				emotion ET_PROFUSELY_SWEAT;
				close;
			}
			mes "[Xue Bong]";
			mes "哦……我的胃……";
			mes "我需要点东西……";
			mes "呜~呃，喂！";
			mes "能给我一瓶你的";
			mes "^00FF00绿色药水^000000吗？";
			mes "我好像要吐了……";
			next;
			switch(select("不要。:给你，喝这个！")) {
			case 1:
				mes "[Xue Bong]";
				mes "呃……";
				mes "你确定吗？";
				next;
				switch(select("抱歉，我没有。:给你，拿去吧！")) {
				case 1:
					mes "[Xue Bong]";
					mes "拜托……";
					mes "我、我真的很痛苦……";
					set b_sword,12;
					close;
				case 2:
					delitem 506,1; //Green_Potion
					set b_sword,5;
					mes "[Xue Bong]";
					mes "天啊……谢谢。";
					mes "我还以为你在逗我。";
					mes "现在舒服多了。";
					mes "那么……呃，你来这里做什么？";
					next;
					if (select("听说小偷的事？:没什么。") == 1) {
						mes "[Xue Bong]";
						mes "啊，小偷~";
						mes "嗯……让我想想……";
						mes "我喝酒时半夜出去散步，";
						mes "听到了一阵声音。";
						next;
						mes "[Xue Bong]";
						mes "我环顾四周，发现首领家附近";
						mes "比其他地方都亮……";
						mes "真奇怪……";
						mes "[Xue Bong]";
						mes "于是我继续盯着那里，突然看到";
						mes "有什么东西在屋顶上移动……";
						next;
						mes "[Xue Bong]";
						mes "它一瞬间就消失了。";
						mes "我喝醉了，外面又很黑。";
						mes "不知道那是人、波利，";
						mes "还是我喝得太多……嘿嘿。";
						set b_sword,6;
						close;
					}
					mes "[Xue Bong]";
				mes "好吧，再次谢谢你。";
				mes "别像我一样酗酒，";
				mes "除非你想承受严重宿醉。回头见~";
					close;
				}
			case 2:
				delitem 506,1; //Green_Potion
				set b_sword,5;
				emotion ET_THANKS;
				mes "[Xue Bong]";
				mes "呼，谢谢！";
				mes "我感觉好多了。";
				mes "嗯……你看起来是新来的。";
				mes "有什么想知道的吗？";
				next;
				switch(select("关于小偷……:你喝了多少？:没什么~")) {
				case 1:
					mes "[Xue Bong]";
					mes "啊，小偷吗？让我想想……";
					mes "我喝酒时半夜出去散步。";
					mes "突然听到奇怪的声音……";
					next;
					mes "[Xue Bong]";
					mes "我环顾四周，发现首领家附近比其他地方都亮。真奇怪……";
					next;
					mes "[Xue Bong]";
					mes "于是我继续盯着那里，突然看到有什么东西在屋顶上移动……";
					next;
					if (select("去哪儿？:也许是野玫瑰。") == 1) {
						mes "[Xue Bong]";
						mes "嗯？";
						mes "让我想想……";
						mes "它从……前往……呃……";
						mes "嘟囔……";
						next;
						mes "^3355FFHe started mumbling for a bit^000000";
						mes "......";
						next;
						mes "[Xue Bong]";
						mes "啊哈！！对了……";
						mes "是神社，小偷正前往神社，";
						mes "然后消失了。我不确定那是人还是动物……";
						set b_sword,6;
						next;
						mes "[Xue Bong]";
					mes "还有什么需要我帮忙的吗？";
					mes "谢谢你的药水。";
						next;
						switch(select("谢谢你的消息。:别喝太多。:好的，再见")) {
						case 1:
							mes "[Xue Bong]";
							mes "那下次见。";
							mes "我会一直在这里喝酒……嘿嘿。";
							close;
						case 2:
							mes "[Xue Bong]";
							mes "呃……别管我。";
							mes "我是社交型饮酒者……";
							mes " ";
							mes "只是没有人陪我社交。";
							close;
						case 3:
							mes "[Xue Bong]";
							mes "好吧。";
							mes "有其他问题时再来。";
							close;
						}
					}
					mes "[Xue Bong]";
					mes "嗯……也许吧。外面太黑，我又喝醉了，记不清楚。";
					mes "不过我确定它比那个大。";
					close;
				case 2:
					mes "[Xue Bong]";
				mes "啊……呃……我、我不记得。";
				mes "醒来时身边有很多空瓶子。";
					mes "...";
					next;
					mes "^3355FF.......";
				mes "不知为何，你无法判断他的证词是否可靠……^000000";
					close;
				case 3:
					mes "[Xue Bong]";
				mes "好吧。希望你以后别像我一样喝酒。";
				mes "否则会痛苦很久。";
				mes "你知道宿醉是什么吧？";
					close;
				}
			}
		case 5:
			mes "[Xue Bong]";
			mes "哦，是你。嘿。";
			mes "谢谢你上次的药水。";
			mes "你在忙什么？";
			mes "有什么问题要问我吗？";
			next;
			switch(select("关于昨晚的小偷……:没事，只是路过……")) {
			case 1:
				mes "[Xue Bong]";
				mes "啊~小偷……？";
				mes "嗯……让我想想……";
				mes "我喝酒时半夜出去散步，突然听到奇怪的声音……";
				next;
				mes "[Xue Bong]";
				mes "我环顾四周，发现首领家附近比其他地方都亮。真奇怪……";
				next;
				mes "[Xue Bong]";
				mes "于是我继续盯着那里，突然看到有什么东西在屋顶上移动……";
				next;
				mes "[Xue Bong]";
				mes "它一瞬间就消失了。";
				mes "我喝醉了，外面又很黑。";
				mes "不知道那是人、波利，还是我喝太多了……嘿嘿~";
				set b_sword,6;
				close;
			case 2:
				mes "[Xue Bong]";
				mes "好吧，再次谢谢你。";
				mes "别像我一样酗酒，除非你想承受严重宿醉。回头见~";
				close;
			}
		}
	}
	else if (b_sword < 11) {
		mes "[Xue Bong]";
		mes "希望你能找到那些小偷。为了村子的和平，我们必须帮助首领……";
		close;
	}
	else if (b_sword <14) {
		switch(b_sword) {
		case 11:
			mes "[Xue Bong]";
			mes "啊……我的胃……我的头……";
			mes "我不该喝这么多……";
			mes "呃……";
			emotion ET_PROFUSELY_SWEAT;
			close;
		case 12:
			mes "[Xue Bong]";
			mes "呃……走开。";
			mes "你太无情了……";
			mes "怎么能对醉鬼的痛苦";
			mes "视而不见？";
			mes "呃……！";
			emotion ET_FRET;
			close;
		case 13:
			mes "[Xue Bong]";
			mes "呃……走开。";
			mes "你真冷酷……";
			mes "怎么能拒绝一个需要帮助的醉鬼……？";
			mes "*呻吟*……";
			emotion ET_FRET;
			close;
		}
	}
	mes "[Xue Bong]";
	mes "你找到首领的物品了？！我就知道！";
	mes "我就知道你能做到！";
	mes "你勇敢到什么都敢做！干得好！";
	close;
}


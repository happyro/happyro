		monster 'map_lost$,38,257,"Big Meow",20662,1, instance_npcname("Wooden Box#10") + "::OnMobDead";
		end;
	}
	npctalk "大喵：*喷嚏*";
	warp 'map_lost$,38,226;
	end;
}


//===== rAthena Script ======================================= 
//= Sage Job Quest
//===== By: ==================================================
//= jAthena (0.9) - I guess
//= Unknown Translator (1.0)
//= Darkchild (1.2)
//===== Current Version: ===================================== 
//= 2.8
//===== Compatible With: ===================================== 
//= rAthena Project
//===== Description: ========================================= 
//= [Official Conversion]
//= Job quest for Sage classes
//===== Additional Comments: ================================= 
//= 2.1 Rescripted to Aegis 10.3 stadards. [L0ne_W0lf]
//=     No longer uses function "F_BlockHigh"
//= 2.2 Small bug fix (== -> !=) thanks to Saithis. [L0ne_W0lf]
//= 2.2b ANotehr smaLL bugfix, pointed out by Cara. [L0ne_W0lf]
//= 2.3 Corrected NPC names to fall within proper restrictions. [L0ne_W0lf]
//= 2.4 Fixes bug with first room monsters not being reset. [L0ne_W0lf]
//= 2.4a Deleted unused variables. [Samuray22]
//= 2.5 Updated waiting room. (Removes global var) [L0ne_W0lf]
//= 2.5a Corrected some "mes"s without the getitemname. (bugreport:1564) [Samuray22]
//=     -Changed an incorrect "!=" to "==". (bugreport:1572) 
//=     -And Small Typo Error
//= 2.6 Fixed Kayron Grik cutin not being removed as reported by jc1991, bugreport:1825 [Brainstorm]
//= 2.6a Fixed a Little Bug with Whispers Summoned in the Last Test. (bugreport:2253) [Samuray22]
//= 2.7 Added Quest Log commands. [Kisuka]
//= 2.8 Removed the need for use of 'goto.' [L0ne_W0lf]
//============================================================ 

yuno_in02,38,61,5	script	Dean of the Academy#sa	743,{
	cutin "job_sage_kayron",2;
	mes "[凯隆·格里克]";
	if (Upper == 1) {
		mes "哈哈，我见过很多人，";
		mes "但你似乎拥有特殊的力量和能力。";
		next;
		mes "[凯隆·格里克]";
		mes "你最好离开并提高声望。";
		mes "别忘了你也曾是初心者。";
		close2;
		cutin "job_sage_kayron",255;
		end;
	}
	if (BaseJob != Job_Mage) {
		if (BaseJob == Job_Sage) {
			mes "你为什么来这里？最近有什么烦恼吗？";
			mes "即使你已经是贤者，也不能停止学习。";
			next;
			mes "[凯隆·格里克]";
			mes "我们的知识是推动王国快速发展的源动力。";
			mes "请记住：你必须学习并记录发现的一切，让王国所有人受益。";
		}
		else if (BaseJob == Job_Novice) {
			mes "哈哈，我的小初心者，你为什么来这里？……我猜你是来观光的？";
			mes "你一定费了很大力气才来到这里。我得说，你似乎对贤者职业感兴趣。";
			next;
			mes "[凯隆·格里克]";
			mes "如果你想成为贤者，必须先作为魔法师生活。只有这样才有机会。";
			mes "期待再次见到你。";
		}
		else {
			mes "*轻笑* 虽然我们研究这个世界很久了，但我知道学习本身会满足人们的需求。";
			mes "其他职业对鲁恩·米德加尔特的福祉同样重要……";
			next;
			mes "[凯隆·格里克]";
			mes "不过，如果你在路上遇到贤者，希望你能帮助他。";
			mes "如果你这样做，他也会回报你……";
		}
		close2;
		cutin "job_sage_kayron",255;
		end;
	}
	if (SAGE_Q == 0) {
		cutin "job_sage_kayron",2;
		mes "欢迎，年轻人。我看得出你对魔法的奇迹很感兴趣。";
		mes "是什么事情让你来找我？";
		next;
		switch(select("我想成为贤者。:告诉我贤者转职的事。:没什么。")) {
		case 1:
			mes "[Kayron Grik]";
			mes "嗯？你想成为贤者吗？";
			mes "那么，我来介绍贤者必须具备的条件。";
			next;
			mes "[Kayron Grik]";
			mes "贤者通过不断学习和记录与世界相关的知识，推动大陆发展。";
			mes "成为贤者不只是换件服装：这是重要职业，必须时刻意识到对人民的职责与责任。";
			next;
			mes "[Kayron Grik]";
			mes "你可以向施威彻贝尔魔法学院提交入学申请。";
			mes "他们会详细说明成为贤者的条件。";
			break;
		case 2:
			mes "[Kayron Grik]";
			mes "贤者转职……嗯……这个说法很有趣。";
			mes "虽然我们这样说，但把成为贤者仅仅看作换职业并不合适。";
			next;
			mes "[Kayron Grik]";
			mes "要成为贤者，你必须向施威彻贝尔魔法学院提交申请。";
			mes "然后参加入学考试。";
			next;
			mes "[Kayron Grik]";
			mes "考试后，你会被安排学习特定科目……";
			mes "最后向学院提交论文。";
			next;
			mes "[Kayron Grik]";
			mes "我负责评估你的论文。";
			mes "通过所有课程后，你就会成为贤者。";
			next;
			mes "[Kayron Grik]";
			mes "请前往施威彻贝尔魔法学院。";
			mes "名叫梅修斯·西尔菲的年轻贤者会接受你的申请。";
			break;
		case 3:
			mes "[Kayron Grik]";
			mes "我明白了……既然你有空闲时间，我鼓励你尽可能多读书。";
			mes "你可以在书页中寻找并研究世间万物。";
			next;
			mes "[Kayron Grik]";
			mes "当然，仅仅读遍身边的书也不能成为最聪明的人……";
			mes "不过对我这样的贤者来说，书中的知识最为重要。";
		}
		close2;
		cutin "job_sage_kayron",255;
		end;
	}
	else if (SAGE_Q == 15) {
		if (countitem(1550) > 0) {
			if (JobLevel < 40) {
				set SAGE_Q,0;
				mes "你似乎还不符合资格。";
				mes "记住，必须达到职业等级40才能成为贤者。";
				close2;
				cutin "job_sage_kayron",255;
				end;
			}
			if (SkillPoint) {
				mes "你还有剩余技能点……";
				mes "提交论文前，请先处理好这件事。";
				close2;
				cutin "job_sage_kayron",255;
				end;
			}
			mes "哦~ 是吗？你终于完成论文了？做得好。";
			mes "让我看看。";
			next;
			mes "[Kayron Grik]";
			mes "嗯……";
			next;
			mes "[Kayron Grik]";
			mes "咦……";
			next;
			mes "[Kayron Grik]";
			mes "有趣……";
			next;
			mes "[Kayron Grik]";
			mes "虽然写得粗略，但对初学者来说已经很好。";
			mes "啊，是的……你似乎很擅长学习。";
			next;
			completequest 2052;
			callfunc "Job_Change",Job_Sage;
			callfunc "F_ClearJobVar";
			mes "[Kayron Grik]";
			mes "恭喜！你现在成为贤者了。";
			mes "永远保持勤学与分析的思维。";
			next;
			mes "[Kayron Grik]";
			mes "还要保管好这篇论文，因为这是你写的唯一一本书。";
			mes "将来某天也许会用到它，它会永远提醒你这个伟大时刻。";
			next;
			mes "[Kayron Grik]";
			mes "那么……愿上帝以知识充满你的道路。";
			mes "勤奋学习！！";
		}
		else {
			mes "嗯？你怎么了？把论文放在哪里了？";
			mes "请把它带给我，才能通过测试。";
			next;
			mes "[Kayron Grik]";
			mes "等等……你不会把它弄丢了吧？";
			mes "嗯……那是你的事。遗憾的是，你再也没有机会写书了。";
		}
	}
	else {
		mes "*轻笑* 成为贤者并没有你想的那么简单。";
		mes "你的魔法技能不足，无法成为贤者……";
		next;
		mes "[Kayron Grik]";
		mes "勤奋学习，完成论文后再回来。";
		mes "在那之前，再见！";
	}
	close2;
	cutin "",255;
	end;
}

yuno_in03,154,35,4	script	Staff of the Academy#a	742,{
	mes "[Metheus Sylphe]";
	if (Upper == 1) {
		mes "欢迎来到";
		mes "施威彻贝尔魔法";
		mes "学院。等、等一下……";
		mes "我在哪里见过你吗？";
		next;
		mes "[Metheus Sylphe]";
		mes "我们以前见过，对吧？";
		mes "天啊，我听起来一定很疯狂。抱歉，可能是因为最近";
		mes "没睡好？算了，";
		mes "最近总觉得很困。";
		mes "祝你今天愉快，冒险者~";
		close;
	}
	if (BaseJob != Job_Mage) {
		if (BaseJob == Job_Sage) {
			mes "哦，很高兴再次见到你，好久不见。";
			mes "学习进行得怎么样？";
			next;
			mes "[Metheus Sylphe]";
			mes "整天学习书籍和魔法卷轴没问题，";
			mes "但你必须尽可能外出与怪物战斗，才能成为经验丰富的贤者。";
			next;
			mes "[Metheus Sylphe]";
			mes "如果你认识贤者候选人，请给他们一些建议……";
			mes "也请代我向你的同伴问好。";
		}
		else if (BaseJob == Job_Novice) {
			mes "欢迎来到施威彻贝尔魔法学院。";
			next;
			mes "[Metheus Sylphe]";
			mes "这里专门进行贤者职业训练。我们主要研究怪物和魔法咒语。";
			mes "我们随时欢迎新学生。";
			next;
			mes "[Metheus Sylphe]";
			mes "魔法师职业等级达到40的人才有资格申请入学。";
			mes "通过指定课程后，我们会批准其成为贤者。";
			next;
			mes "[Metheus Sylphe]";
			mes "如果你对贤者职业感兴趣，请再来。";
			mes "祝你今天愉快。";
		}
		else {
			mes "欢迎来到施威彻贝尔魔法学院。";
			next;
			mes "[Metheus Sylphe]";
			mes "这里专门进行贤者职业训练。我们研究怪物和魔法咒语。";
			mes "魔法师职业等级达到40的人才有资格申请入学。";
			next;
			mes "[Metheus Sylphe]";
			mes "如果你有魔法师朋友，请告诉他们这所学院。";
			mes "祝你今天愉快。";
		}
		close;
	}
	if (SAGE_Q == 0) {
		mes "欢迎来到施威彻贝尔魔法学院。";
		mes "哦，你是魔法师。我能为你做什么？";
		next;
		switch(select("告诉我贤者转职的事。:我想入学。:没什么。")) {
		case 1:
			mes "[Metheus Sylphe]";
			mes "我明白了。你想成为贤者吗？";
			mes "遗憾的是，我们不负责将你转职为贤者。";
			next;
			mes "[Metheus Sylphe]";
			mes "进入学院并通过特定课程后……";
			mes "你会获得作为贤者进行研究的正式许可。";
			next;
			mes "[Metheus Sylphe]";
			mes "因此我们不把这个过程称为转职，而称为毕业。";
			mes "如果你申请本学院，我会告知注册费并让你参加考试。";
			next;
			mes "[Metheus Sylphe]";
			mes "顺便说，如果你带来^3355FF古老魔法书^000000和^3355FF智慧项链^000000，";
			mes "入学时可以免交注册费。";
			next;
			mes "[Metheus Sylphe]";
			mes "注册后你就能参加入学考试。";
			mes "通过考试后，你要为指定科目撰写论文。";
			next;
			mes "[Metheus Sylphe]";
			mes "学院院长会决定你是否符合资格。";
			mes "获准入学后，你就能作为贤者参加学习和研究活动。";
			next;
			mes "[Metheus Sylphe]";
			mes "我们随时欢迎你加入。";
			mes "祝你今天愉快。";
			close;
		case 2:
			mes "[Metheus Sylphe]";
			mes "我明白了，你想加入学院。再次欢迎来到施威彻贝尔魔法学院。";
			next;
			mes "[Metheus Sylphe]";
			mes "达到魔法师职业等级40这一基本要求的人才有资格入学。";
			mes "还需要支付少量注册费。";
			next;
			mes "[Metheus Sylphe]";
			mes "注册费是70,000 Zeny。";
			mes "不过，如果你带来^3355FF古老魔法书^000000和^3355FF智慧项链^000000，就可以免除费用。";
			next;
			mes "[Metheus Sylphe]";
			mes "那么，你要立即申请吗？";
			next;
			switch(select("是的。:费用太贵了。:我稍后再来。")) {
			case 1:
				if (JobLevel < 40) {
					mes "[Metheus Sylphe]";
					mes "抱歉，你还未满足基本要求。";
					mes "请继续学习，先达到魔法师职业等级40。";
					close;
				}
				if (SkillPoint) {
					mes "[Metheus Sylphe]";
					mes "你还有未使用的技能点。请先学习计划中的所有技能。";
					mes "我们不接受准备不充分的候选人。";
					close;
				}
				mes "[Metheus Sylphe]";
				mes "很好。让我们完成你的申请表。";
				mes "请在这里签名。";
				next;
				select(strcharinfo(0));
				mes "[Metheus Sylphe]";
				mes "你的名字是……" + strcharinfo(0) + "。真是好名字。";
				next;
				if (JobLevel == 50) {
					mes "[Metheus Sylphe]";
					mes "哦，你已经精通魔法师职业了！太棒了！！*鼓掌鼓掌鼓掌*";
					mes "作为努力的奖励，你可以免交注册费！";
					next;
					mes "[Metheus Sylphe]";
					mes "好，一切准备就绪。";
					mes "接下来参加入学考试。";
					set SAGE_Q,4;
					setquest 2041;
					next;
					mes "[Metheus Sylphe]";
					mes "请去拜访克莱托斯教授。";
					mes "他在左侧房间。";
					close;
				}
				mes "[Metheus Sylphe]";
				mes "你要支付70,000 Zeny注册费吗？";
				mes "还是交给我^3355FF古老魔法书^000000和^3355FF智慧项链^000000？";
				next;
				if (select("支付70,000 Zeny。:给他古老魔法书和智慧项链。") == 1) {
					if (Zeny > 69999) {
						set Zeny, Zeny-70000;
						mes "[Metheus Sylphe]";
						mes "谢谢，你的申请已被接受。";
						mes "接下来参加入学考试。";
						set SAGE_Q,4;
						setquest 2041;
						next;
						mes "[Metheus Sylphe]";
						mes "请拜访克莱托斯教授。";
						mes "他在左侧房间。";
						close;
					}
					mes "[Metheus Sylphe]";
					mes "真遗憾！看来你没有带够学费。";
					mes "请确保至少有70,000 Zeny才能注册课程。";
					close;
				}
				if (countitem(1006) > 0 && countitem(1007) > 0) {
					delitem 1006,1; //Old_Magic_Book
					delitem 1007,1; //Penetration
					mes "[Metheus Sylphe]";
					mes "谢谢，你的申请已被接受。";
					mes "接下来参加入学考试。";
					set SAGE_Q,4;
					setquest 2041;
					next;
					mes "[Metheus Sylphe]";
					mes "请拜访克莱托斯教授。";
					mes "他在左侧房间。";
					close;
				}
				mes "[Metheus Sylphe]";
				mes "嗯……看来你一样都没带？";
				mes "我想你把它们落在别处了。请取来后再回来。";
				close;
			case 2:
				if (JobLevel < 40) {
					mes "[Metheus Sylphe]";
					mes "在讨论注册费前，看来你还没达到魔法师职业等级40这一基本要求。";
					mes "请继续学习，再回来注册。";
					close;
				}
				if (JobLevel == 50) {
					mes "[Metheus Sylphe]";
					mes "嗯，我无法帮你解决。如果没有费用，就不能进入学院。";
					mes "即使你觉得贵得离谱，为成为贤者付出这笔费用也是合理的。";
					next;
					mes "[Metheus Sylphe]";
					mes "总之……哦！你精通了魔法师职业！真是优秀！！*鼓掌鼓掌鼓掌*。";
					mes "作为努力的奖励，你可以免交注册费！";
					next;
					mes "[Metheus Sylphe]";
					mes "好，让我们完成申请表。";
					mes "请在这里签名。";
					next;
					select(strcharinfo(0));
					mes "[Metheus Sylphe]";
					mes "你的名字是……" + strcharinfo(0) + "。真是好名字。";
					next;
					mes "[Metheus Sylphe]";
					mes "好，一切准备就绪。";
					mes "接下来参加入学考试。";
					set SAGE_Q,4;
					setquest 2041;
					next;
					mes "[Metheus Sylphe]";
					mes "请拜访克莱托斯教授。";
					mes "他在左侧房间。";
					close;
				}
				if (Zeny > 43210) {
					mes "[Metheus Sylphe]";
					mes "嗯，我无法帮你解决。如果没有费用，就不能进入学院。";
					mes "即使你觉得贵得离谱，为成为贤者付出这笔费用也是合理的。";
					next;
					mes "[Metheus Sylphe]";
					mes "或者你可以寻找^3355FF古老魔法书^000000和^3355FF智慧项链^000000。";
					mes "如果不想这样，就必须攒钱支付注册费。";
					next;
					mes "[Metheus Sylphe]";
					mes "再见，祝你今天愉快。";
					close;
				}
				else {
					mes "[Metheus Sylphe]";
					mes "哦，我猜你没有足够的钱？";
					mes "按照规定，申请需要支付70,000 Zeny……";
					next;
					if (select("请问……有办法吗？:好吧，我稍后再来。") == 1) {
						mes "[Metheus Sylphe]";
						mes "嗯……那么我提供一个特别选项！";
						mes "支付30,000 Zeny并带来一些物品，就能享受学费折扣。";
						next;
						switch(rand(1,3)) {
						case 1:
							set SAGE_Q,1;
							setquest 2043;
							mes "[Metheus Sylphe]";
							mes "请收集以下物品。";
							mes "50 ^3355FFFeather of Birds^000000";
							mes "50 ^3355FFFluff^000000";
							mes "25 ^3355FFIron Ore^000000";
							next;
							mes "[Metheus Sylphe]";
							mes "带来这些物品后，学费为30,000 Zeny，而不是原本的70,000 Zeny。";
							break;
						case 2:
							set SAGE_Q,2;
							setquest 2044;
							mes "[Metheus Sylphe]";
							mes "请收集以下物品。";
							mes "50 ^3355FFClover^000000";
							mes "50 ^3355FFFeather^000000";
							mes "25 ^3355FFSquid Ink^000000";
							next;
							mes "[Metheus Sylphe]";
							mes "带来上述物品后，学费为30,000 Zeny，而不是原本的70,000 Zeny。";
							break;
						case 3:
							set SAGE_Q,3;
							setquest 2045;
							mes "[Metheus Sylphe]";
							mes "请收集以下物品。";
							mes "50 ^3355FFFeather of Birds^000000";
							mes "50 ^3355FFFluff^000000";
							mes "50 ^3355FFClover^000000";
							mes "50 ^3355FFFeather^000000";
							next;
							mes "[Metheus Sylphe]";
							mes "带来这些物品后，学费只需30,000 Zeny，而不是原本的70,000 Zeny。";
						}
						mes "我相信这是非常合理的选择。";
						next;
						mes "[Metheus Sylphe]";
						mes "啊，在收集这些物品前，如果你有70,000 Zeny，我也很乐意收取全额。";
						mes "毕竟这才是我们的原政策。";
						next;
						mes "[Metheus Sylphe]";
						mes "或者，你可以带来^3355FF古老魔法书^000000和^3355FF智慧项链^000000。";
						mes "再见，祝你今天愉快。";
						close;
					}
					mes "[Metheus Sylphe]";
					mes "啊，慢慢来……";
					mes "再见，祝你今天愉快。";
					close;
				}
			case 3:
				mes "[Metheus Sylphe]";
				mes "啊，慢慢来……";
				mes "再见，祝你今天愉快。";
				close;
			}

		mes "所以它们成真了。";
		mes "你不知道为什么，对吧？";
		next;
		mes "[ Muyeon ]";
		mes "也许是因为现实与梦境之间的墙倒塌了。";
		mes "否则你怎么能进出别人的梦？";
		next;
		mes "[ Muyeon ]";
		mes "我知道它们是^0000FF月光花编织的梦。^000000";
		mes "但不知道它们如何成真。我怀疑真的没人知道。";
		next;
		mes "[ Muyeon ]";
		mes "据我所知，以前从未发生过这种事。想查清楚的话只能靠我们自己。";
		next;
		mes "[ Muyeon ]";
		mes "好吧，让春海来查清楚。";
		mes "那么，我最好去休息一下。";
		next;
		mes "[ Muyeon ]";
		mes "现在知道那些噩梦确实源自月光花，我感觉好多了。";
		mes "我终于能睡觉了。";
		next;
		mes "[ Muyeon ]";
		mes "处理完噩梦后就不需要更多仪式了。";
		mes "这意味着我自由了吗？终于自由了！";
		mes "我都不知道该怎么感谢你。";
		next;
		mes "[ Muyeon ]";
		mes "我在那里找到了这些奇怪的石头。虽然不多，";
		mes "但也许你能派上用场？";
		mes "非常感谢你，冒险者。";
		illusion_moonlight = 9;
		completequest 7788;
		getitem 25271,5;
		getexp 500000,500000;
		close;
	}
	mes "[ Muyeon ]";
	mes "祝你和春海调查现象顺利！";
	mes "噩梦消失后，我们就不必再举行仪式了！";
	next;
	mes "[ Muyeon ]";
	mes "你问我怎么确定？";
	mes "我也不确定。嘿嘿。";
	mes "它们可能不会完全消失。";
	mes "谁知道呢？";
	close;

OnInit:
	questinfo QTYPE_QUEST,QMARK_YELLOW,"illusion_moonlight == 2";
	questinfo QTYPE_QUEST,QMARK_YELLOW,"illusion_moonlight == 3";
	questinfo QTYPE_QUEST,QMARK_YELLOW,"illusion_moonlight == 4";
	questinfo QTYPE_QUEST,QMARK_YELLOW,"illusion_moonlight == 8";
	end;
}

payon_in03,30,96,5	script	Jagyeom#ill_moon_pin	4_M_HUOLDARMY,{
	if (illusion_moonlight == 2) {
		npctalk "茂言……如果你做不到，就没人能做到！","",bc_self;
		end;
	}
	if (illusion_moonlight == 3 || illusion_moonlight == 4) {
		npctalk "我们先听听吧。","",bc_self;
		end;
	}
	if (illusion_moonlight == 5 || illusion_moonlight == 8) {
		mes "[ Jagyeom ]";
		mes "我们应该先掌握情况。";
		mes "冒险者，如果你能帮助我们就太好了。";
		close;
	}
	if (illusion_moonlight == 9) {
		mes "[ Jagyeom ]";
		mes "月光花在噩梦中重现过去。";
		mes "从某种意义上说，它们也是受害者。";
		next;
		mes "[ Jagyeom ]";
		mes "我会确保村民不靠近现实与梦境之间倒塌的墙。";
		close;
	}
	mes "[ Jagyeom ]";
	mes "请在宫殿内遵守礼仪。";
	close;
}

payon_in03,33,93,1	script	Young Scholar#ill_moon_pin	4_F_03,{
	if (illusion_moonlight < 2) {
		mes "[ Young Scholar ]";
		mes "斐扬自古以来就是神圣生物的家园。";
		mes "斐扬被群山与世隔绝，这里人的思维方式与外界不同。";
		close;
	}
	if (illusion_moonlight == 2) {
		npctalk "茂言真的很苦恼。我们应该问问她发生了什么。","",bc_self;
		end;
	}
	if (illusion_moonlight < 5) {
		npctalk "我们应该问问茂言发生了什么。";
		end;
	}
	if (illusion_moonlight == 5) {
		mes "[ Young Scholar ]";
		mes "太糟糕了。";
		mes "真不敢相信茂言必须独自面对。";
		mes "那些狐狸一定比我想象中更愤怒。";
		next;
		mes "[ Young Scholar ]";
		mes "我们需要进一步调查。我最好去废弃村庄。";
		close;
	}
	mes "[ Young Scholar ]";
	mes "我会留在废弃村庄调查这个现象。";
	mes "但需要某种保护。我会带着正熙一起。";
	next;
	mes "[ Young Scholar ]";
	mes "如果你能再次加入我们就太好了。废弃村庄见。";
	close;
}

payon_in03,30,96,5	duplicate(dummy_cloaked_npc)	Nine Tail Spirit#ill_moon_0	NINE_TAIL
payon_in03,35,96,3	duplicate(dummy_cloaked_npc)	Nine Tail Spirit#ill_moon_1	NINE_TAIL
payon_in03,30,93,7	duplicate(dummy_cloaked_npc)	Nine Tail Spirit#ill_moon_2	NINE_TAIL
payon_in03,35,93,1	duplicate(dummy_cloaked_npc)	Nine Tail Spirit#ill_moon_3	NINE_TAIL

pay_dun03,140,46,0	script	Shimmering Portal#ill_moon_in	4_ENERGY_BLUE,{
	if (illusion_moonlight < 5) {
		mes "- The air is brimming with strange energy. -";
		mes "这让我感到不安。";
		close;
	}
	if (illusion_moonlight == 5) {
		mes "空气中有一个闪烁的传送门。";
		next;
		cloakoffnpcself( "Young Scholar#ill_moon_pdun" );
		cloakoffnpcself( "Junghee#ill_moon_pdun" );
		npctalk "*Panting* You're here.","Young Scholar#ill_moon_pdun",bc_self;
		mes "[ Young Scholar ]";
		mes "你突然消失时我吓了一跳。";
		mes "你觉得这是不是茂言提到的噩梦之一……";
		next;
		select("我得查清楚。" );
		npctalk "我？如果我不想呢？","Junghee#ill_moon_pdun",bc_self;
		mes "[ Young Scholar ]";
		mes "那么，我跟着一起去可以吗？";
		mes "不用担心我。正熙会保护我。";
		next;
		npctalk "别、别碰任何东西！","Junghee#ill_moon_pdun",bc_self;
		mes "[ Young Scholar ]";
		mes "那么……我该碰这个吗？";
		illusion_moonlight = 6;
		completequest 7780;
		setquest 7781;
		close2;
		setpcblock PCBLOCK_NPC, true;
		specialeffect EF_SPINMOVE,AREA,"Young Scholar#ill_moon_pdun";
		specialeffect EF_DQ9_CHARGE,AREA,"Young Scholar#ill_moon_pdun";
		sleep2 350;
		npctalk "啊啊啊啊——！","",bc_self;
		cloakonnpcself( "Young Scholar#ill_moon_pdun" );
		sleep2 500;
		npctalk "春海！","Junghee#ill_moon_pdun",bc_self;
		sleep2 2000;
		npctalk "那个粗心的笨蛋！","Junghee#dun_dummy",bc_self;
		sleep2 500;
		specialeffect EF_SPINMOVE,AREA,"Junghee#ill_moon_pdun";
		specialeffect EF_DQ9_CHARGE,AREA,"Junghee#ill_moon_pdun";
		sleep2 350;
		setpcblock PCBLOCK_NPC, false;
		cloakonnpcself( "Junghee#ill_moon_pdun" );
		end;
	}
	mes "闪烁传送门的另一边似乎有东西。";
	mes "我该怎么办？";
	next;
	if (select("进入传送门。:退出。") == 2) {
		mes "放弃调查。";
		close;
	}
	warp "pay_d03_i",140,44;
	end;

OnInit:
	questinfo QTYPE_QUEST,QMARK_YELLOW,"illusion_moonlight == 5";
	end;
}

pay_dun03,143,45,4	duplicate(dummy_cloaked_npc)	Junghee#ill_moon_pdun	4_M_PAY_SOLDIER

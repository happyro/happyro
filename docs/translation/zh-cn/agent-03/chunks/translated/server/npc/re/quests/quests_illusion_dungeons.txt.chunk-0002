pay_d03_i,140,46,0	script	Shimmering Portal#ill_moon_out	4_ENERGY_BLUE,{
	mes "我可以回废弃村庄。";
	mes "我该怎么办？";
	next;
	if (select("退出。:不退出。") == 2)
		end;
	warp "pay_dun03",140,44;
	end;
}

pay_d03_i,149,45,4	script	Scholar Chunghae#ill_moon_ind	4_F_03,{
	if (illusion_moonlight < 6)
		end;
	if (illusion_moonlight == 6) {
		mes "[ Chunghae ]";
		mes "看看这个地方！";
		mes "它看起来和我们刚才所在的废弃村庄一模一样，但……又不一样！";
		next;
		mes "[ Chunghae ]";
		mes "这里的人和狐狸也有些不对劲，我还看到其中有个长相奇怪的魔法师。";
		mes "如果这次事件是他造成的呢？";
		next;
		mes "[ Chunghae ]";
		mes "这些狐狸、村民和愤怒的灵魂……";
		mes "让我想起村庄被山体滑坡掩埋的那次。";
		next;
		mes "[ Chunghae ]";
		mes "我们需要四处寻找更多线索。";
		mes "你会帮忙的，对吧？";
		next;
		mes "[ Chunghae ]";
		mes "准备好后告诉我。";
		illusion_moonlight = 7;
		completequest 7781;
		close;
	}
	if (checkweight(25271,1) == 0 || (MaxWeight - Weight) < 1000) {
		mes "- You're carrying too many items to proceed with this quest. -";
		close;
	}
	switch (checkquest(7783,PLAYTIME)) {
		case -1:
			break;

		case 0:
		case 1:
			mes "[ Chunghae ]";
			mes "现在我知道这里不是废弃村庄。";
			mes "我们真的在月光花的噩梦里吗？";
			next;
			mes "[ Chunghae ]";
			mes "茂言就是这么说的。";
			mes "它们的噩梦正在成真。";
			next;
			mes "[ Chunghae ]";
			mes "这里值得认真研究。";
			close;

		case 2:
			mes "[ Chunghae ]";
			mes "我们开始今天的调查吧？";
			mes "也许因为这里是梦，但这里的一切都没有改变。";
			erasequest 7783;
			next;
			mes "[ Chunghae ]";
			mes "准备好后告诉我。";
			close;
	}
	switch (checkquest(7782,HUNTING)) {
		case -1:
			mes "[ Chunghae ]";
			mes "我和村民们谈过了，";
			mes "很多人都提到一个奇怪的魔法师。";
			next;
			mes "[ Chunghae ]";
			mes "据说他所到之处都会施展强力魔法，其中一个魔法震动大地，引发致命山体滑坡。结果许多村民和狐狸死亡。";
			next;
			mes "[ Chunghae ]";
			mes "我确信这个魔法师要为这些不断出现的噩梦负责。";
			mes "如果消除源头，也许噩梦就不会再成真。";
			next;
			mes "[ Chunghae ]";
			mes "当然，也可能是我错了。";
			mes "他也许只是噩梦中的另一个角色。";
			next;
			mes "[ Chunghae ]";
			mes "我最想知道是什么撕裂了现实与梦境之间的墙。";
			mes "也许其他地方也发生着同样的事？";
			next;
			mes "[ Chunghae ]";
			mes "总之，请处理这里的^0000FF真理魔法师^000000。";
			mes "是时候解决这个准现实了。";
			next;
			mes "[ Chunghae ]";
			mes "他非常强大。我不建议^0000FF独自与他战斗。^000000";
			next;
			if (select("我会做。:不用了，谢谢。") == 2) {
				mes "[ Chunghae ]";
				mes "呃，那我只能调查别的事了。";
				mes "但我保证不会因此怨你。";
				close;
			}
			mes "[ Chunghae ]";
			mes "祝你好运。";
			mes "那个魔法师看起来很强。";
			mes "请小心。";
			setquest 7782;
			close;

		case 0:
		case 1:
			mes "[ Chunghae ]";
			mes "那个^0000CD觉醒魔法师^000000看起来很危险。";
			mes "请阻止他。";
			close;

		case 2:
			mes "[ Chunghae ]";
			mes "你和传闻中一样经验丰富。";
			mes "现在让我们看看这对情况有什么影响。";
			next;
			if (illusion_moonlight == 7) {
				mes "[ Chunghae ]";
				mes "还记得茂言说的吗？";
				mes "我是说狐狸的噩梦成真那件事。";
				next;
				mes "[ Chunghae ]";
				mes "我四处观察时一直在思考。";
				mes "我觉得我们可能在月光花的梦里。";
				next;
				mes "[ Chunghae ]";
				mes "我不知道它如何与现实连接，";
				mes "但有一件事我很确定：";
				next;
				mes "[ Chunghae ]";
				mes "月光花的灵魂仍活在过去。";
				mes "就在它们的村庄被掩埋的时候……";
				next;
				mes "[ Chunghae ]";
				mes "它们死得太惨，无法前往冥界。";
				mes "某种东西点燃了它们积压的愤怒。";
				next;
				mes "[ Chunghae ]";
				mes "这里有我们在其他地方找不到的真相。";
				mes "在找到全部真相前，我大概会留在这里。";
				next;
				mes "[ Chunghae ]";
				mes "请把消息带给离宫斐扬的茂言。";
				mes "我和正熙会继续探索这里。";
				illusion_moonlight = 8;
				setquest 7788;
				next;
			}
			mes "[ Chunghae ]";
			mes "希望我们能找到这个现象的答案。";
			erasequest 7782;
			setquest 7783;
			getitem 25271,1;
			getexp 300000,300000;
			close;
	}
	end;

OnInit:
	questinfo QTYPE_QUEST,QMARK_YELLOW,"illusion_moonlight == 6";
	questinfo QTYPE_QUEST,QMARK_YELLOW,"illusion_moonlight == 7 && checkquest(7782,HUNTING) == -1";
	questinfo QTYPE_QUEST,QMARK_YELLOW,"illusion_moonlight == 7 && checkquest(7782,HUNTING) == 2";
	questinfo QTYPE_DAILYQUEST,QMARK_YELLOW,"iillusion_moonlight > 7 && checkquest(7783,PLAYTIME) == 2";
	questinfo QTYPE_DAILYQUEST,QMARK_YELLOW,"iillusion_moonlight > 7 && checkquest(7782,HUNTING) == 2";
	questinfo QTYPE_DAILYQUEST,QMARK_YELLOW,"iillusion_moonlight > 7 && checkquest(7783,PLAYTIME) == -1 && checkquest(7782,HUNTING) == -1";
	end;
}

pay_d03_i,152,45,4	script	Soldier Junghee#ill_moon_ind	4_M_PAY_SOLDIER,{
	if (illusion_moonlight < 6)
		end;
	if (illusion_moonlight == 6) {
		mes "[ Junghee ]";
		mes "进来时我就知道最好跟紧春海。";
		mes "我果然没错。";
		next;
		mes "[ Junghee ]";
		mes "我从这些狐狸和幽灵身上感受到非常不好的气息。";
		mes "这可不好。";
		close;
	}
	if (checkweight(25271,1) == 0 || (MaxWeight - Weight) < 1000) {
		mes "- You're carrying too many items to proceed with this quest. -";
		close;
	}
	if (checkquest(7784,HUNTING) == 2) {
		mes "[ Junghee ]";
		mes "无论它们是真是假，都同样危险。";
		mes "干得好。";
		next;
		mes "[ Junghee ]";
		mes "春海快调查完这里了。我最好准备离开。";
		erasequest 7784;
		setquest 7785;
		getitem 25271,1;
		close;
	}
	if (checkquest(7786,HUNTING)  == 2) {
		mes "[ Junghee ]";
		mes "无论它们是真是假都无所谓。";
		mes "我能理解那个士兵。";
		next;
		mes "[ Junghee ]";
		mes "他只想保护别人，却没能实现愿望就死去了。";
		mes "谢谢你帮助他们安息。";
		erasequest 7786;
		setquest 7787;
		getitem 25271,1;
		close;
	}
	mes "[ Junghee ]";
	mes "那里还有一个看起来和我们进来的传送门一样的门。";
	mes "我碰了它，它把我送回最初的废弃村庄。";
	next;
	switch( select( "About the angry Nine Tails.", "About the angry Soldiers." ) ) {
	case 1:
		switch( checkquest(7785,PLAYTIME) ) {
		case -1:
			if (checkquest(7784,HUNTING) == -1) {
				mes "[ Junghee ]";
				mes "愤怒的狐狸让春海难以调查这里。";
				mes "如果你能处理它们，我会很感激。";
				break;
			}
			mes "[ Junghee ]";
			mes "请猎杀这里附近的^0000FF愤怒九尾狐^000000。";
			mes "这样能保证春海调查时的安全。";
			close;
		case 0:
		case 1:
			mes "[ Junghee ]";
			mes "春海说我们在月光花的噩梦里。";
			mes "它们也许不是真的，但如果威胁活人，就必须处理。";
			next;
			mes "[ Junghee ]";
			mes "这和我对它们的同情无关。";
			mes "失陪了，我和春海要去调查其他地方。";
			close;
		case 2:
			erasequest 7785;
			mes "[ Junghee ]";
			mes "你休息好了吗？";
			mes "这里和你离开时一样，但我想清理这个地方，";
			mes "这样春海才能调查。";
			mes "能猎杀一些^4d4dff愤怒九尾狐^000000吗？";
			break;
		}
		next;
		if (select( "Accept.", "Decline." ) == 2) {
			mes "[ Junghee ]";
			mes "否则春海就无法完整调查这里。";
			close;
		}
		mes "[ Junghee ]";
		mes "谢谢。";
		mes "我理解那些^0000FF狐狸为何愤怒^000000，但必须这么做。";
		setquest 7784;
		close;
	case 2:
		switch( checkquest(7787,PLAYTIME) ) {
		case -1:
			if (checkquest(7786,HUNTING) == -1) {
				mes "[ Junghee ]";
				mes "这些士兵直到最后一刻都在保护村民，";
				mes "却和村民一起被掩埋。难怪他们如此愤怒。";
				break;
			}
			mes "[ Junghee ]";
			mes "请处理这里的^0000FF愤怒士兵^000000。";
			mes "我的意思是……送他们去天堂。";
			close;
		case 0:
		case 1:
			mes "[ Junghee ]";
			mes "如果我们真的像春海所想，在月光花的噩梦里，";
			mes "那么那边的愤怒士兵一定是这个村庄的守卫。";
			next;
			mes "[ Junghee ]";
			mes "无论这是真是假都无所谓。看着祖先受苦很难受。";
			mes "也许会浪费我们的时间，但我想试着让他们安息。";
			close;
		case 2:
			erasequest 7787;
			mes "[ Junghee ]";
			mes "我们能做什么来消除这些噩梦？";
			mes "我说过，看到那些士兵却不感到痛苦，对我来说很难。";
			break;
		}
		next;
		mes "[ Junghee ]";
		mes "能请你帮我让他们安息吗？";
		next;
		if (select( "Accept.", "Decline." ) == 2) {
			mes "[ Junghee ]";
			mes "我真的不想亲自处理他们，";
			mes "但看来我不得不这么做。";
			close;
		}
		mes "[ Junghee ]";
		mes "谢谢。";
		mes "^0000FF愤怒士兵^000000就交给你了。";
		mes "请送他们上天堂。";
		setquest 7786;
		close;
	}
	end;

			changequest 7430,7431;
			getexp 200000,200000;
			getitem 6081,1;// Splendide_Coin
		}
		else {
			mes "嗯，抱歉，";
			mes "你能再去一次吗？";
			mes "去Splendide收取邮件……";
			next;
			switch( select("好的。:今天不太想去。") ) {
				mes "[Roy]";
			case 1:
				mes "非常感谢。";
				mes "去Splendide找到联络官，收取邮箱。";
				next;
				mes "[Roy]";
				mes "Eclage的邮件会和基地补给一起送来，";
				mes "但他们无法给我们寄邮件。";
				next;
				mes "[Roy]";
				mes "这件事必须定期进行，你帮了大忙。";
				mes "我会在这里等你。";
				setquest 7430;
				close;
			case 2:
				mes "呃！";
				mes "没想到你会这样拒绝……";
				close;
			}
		}
	}
	close;
}

splendide,267,368,3	script	Contact Officer#tl	4_M_FAIRYKID5,{
	if (!checkweight(1301,3)) {
		mes "- 你携带的物品太多，无法继续任务。 -";
		close;
	}
	mes "[Contact Officer]";
	if (ep14_2_mylord < 7) {
		mes "你是从营地来的吗？";
		mes "你去过Eclage吗？";
		mes "既然你都去过Mora，也应该去Eclage看看。";
		mes "那里非常美丽。";
	}
	else if (ep14_2_mylord == 7) {
		if (isbegin_quest(7419) == 1) {
			if (countitem(6552)) {
				mes "嗯……请把那个箱子交给Roy。";
				mes "Roy会处理的。";
				close;
			}
			mes "这是什么？";
			mes "是营地的人吗？";
			next;
			mes "[Contact Officer]";
			mes "你来自Eclage？";
			mes "嗯？Roy？原来如此。我等了很久。";
			next;
			mes "[Contact Officer]";
			mes "我知道来到这里几乎不可能……但为了确认，我还是一直等着。";
			mes "你代表Roy前来，真是太好了！";
			mes "请把这个箱子交给Roy。";
			getitem 6552,1;// Mail_Package
			next;
			mes "[Contact Officer]";
			mes "嗯，大多是私人信件，所以更像是送信。";
			mes "请帮帮我们。";
		}
		else {
			mes "嗯，我们很难穿过Hazy Forest，而且道路因裂隙被封锁了……";
			mes "这真是个大问题，我都要操心老了！";
		}
	}
	else if (isbegin_quest(7430) == 1) {
		if (countitem(6552) > 0) {
			mes "谢谢你再次帮助我们。";
			mes "把它带给Roy，他知道该怎么做。";
			close;
		}
		mes "你又来收邮件了吗？";
		mes "我这里有一个装满邮件的邮箱……";
		next;
		switch( select("是的，我就是来做这个的。:不，我不是为此而来。") ) {
			mes "[Contact Officer]";
		case 1:
			mes "来，拿着这个。";
			mes "基地里的每个人都很兴奋，";
			mes "因为他们可以寄出任何想寄的东西。";
			getitem 6552,1;// Mail_Package
			next;
			mes "[Contact Officer]";
			mes "路上不要丢弃或扔掉任何东西，";
			mes "请安全地把它们送到。";
			close;
		case 2:
			mes "啊……真的吗。";
			mes "真遗憾。";
			mes "嗯……我还能说什么呢。";
			close;
		}
	}
	else {
		mes "Eclage的邮件会和基地补给一起送来。";
		mes "以前双方很难互寄邮件。但多亏了你，我们寄信不再有问题，大家都很高兴。";
	}
	close;
}

eclage,274,294,5	script	Laphines Conversation#tl	4_F_FAIRYKID,3,3,{
	if (ep14_2_mylord < 11) {
		mes "一名女性Laphine和一名男性Laphine正在谈论什么。";
		mes "但他们一看到我就停止了谈话。";
		mes "我想我打断了他们的对话。";
		close;
	}
	mes "[Female Laphine]";
	mes "啊，我什么都没说。我没有……";
	mes "我确实是城里最健谈的Laphine之一，但我不会把每个细节都说出来。";
	next;
	mes "[Female Laphine]";
	mes "所以，外来者，你最好别想从我这里打听什么！";
	close;

OnTouch_:
	if (ep14_2_mylord == 10)
		doevent "Eclage Resident#tl02::OnTalk";
	else if (ep14_2_mylord == 11) {
		mes "[Male Laphine]";
		mes "你不该介入其他种族的事务。";
		mes "尤其是家庭事务之类的事情。";
		close;
	}
	else {
		mes "[Male Laphine]";
		mes "你来Eclage参观吗？";
		mes "希望你在这里过得愉快。";
		close;
	}
}

eclage,275,294,3	script	Eclage Resident#tl02	4_M_FAIRYKID4,{
OnTalk:
	if (ep14_2_mylord == 10 && checkquest(7425) == -1) {
		mes "[Female Laphine]";
		mes "说实话，你不担心吗？";
		mes "虽然已经过去很久了，";
		mes "但不能说它永远不会再次发生。";
		next;
		mes "[Male Laphine]";
		mes "……嗯。";
		mes "确实违背常识。";
		mes "但只要他不像Seneth那样实行暴政，不就没关系了吗？";
		next;
		mes "[Female Laphine]";
		mes "这正是我担心的。";
		mes "没人能保证他不会做同样的事。";
		mes "说实话，我自己没有经历过。但光是听说Seneth担任Mayor时的事情就够了。";
		next;
		mes "[Female Laphine]";
		mes "我很庆幸当时不在那里。";
		mes "你不觉得Mayor……必须是完美的吗？";
		next;
		mes "[Male Laphine]";
		mes "但是，也不能保证新Mayor不会做同样的事吧？";
		mes "你也觉得换一个新Mayor是好事。";
		next;
		mes "[Female Laphine]";
		mes "确实如此。但为什么偏偏是'他'……";
		mes "如果不是这样，我也不会如此担心……";
		next;
		mes "[Male Laphine]";
		mes "够了。";
		mes "那个外国人听得见。";
		next;
		if (select("其实我已经听到了。能再告诉我一些吗？:你们在说什么？") == 1) {
			mes "[Male Laphine]";
			mes "不，我觉得不该说。";
			mes "哈哈哈……";
			mes "这是我们Laphine的事，所以……";
			next;
		}
		mes "[Female Laphine]";
		mes "你这样的外国人没必要知道。";
		mes "别再偷听了，管好你自己的事。";
		next;
		setquest 7425;
		if ((isbegin_quest(7423) + isbegin_quest(7424) + isbegin_quest(7425) + isbegin_quest(7426)) > 3) {
			mes "Mayor和暴君？Seneth又是谁？";
			mes "总之，他们似乎很担心现任Mayor Kardui。";
			mes "别再担心了，直接去问Kardui吧！";
			ep14_2_mylord = 11;
			erasequest 7423;
			erasequest 7424;
			erasequest 7425;
			changequest 7426,7427;
			close;
		}
		mes "Laphine说的话很有意思。";
		mes "关于暴君的故事……我该听听其他Laphine怎么说吗？";
		close;
	}
}

ecl_in03,244,57,5	script	Resting Laphine#tl01	4_F_FAIRYKID5,3,3,{
	if (ep14_2_mylord < 11) {
		mes "两名上层阶级的Laphine正在谈论什么。";
		mes "其中一人似乎正在工作，非常恼火。";
		mes "他们仿佛察觉到我的注视，恼怒地挥手让我离开。";
		close;
	}
	mes "[Visitor Laphine]";
	mes "外国人不应该过度关注我们的内部事务。";
	close;
OnTouch:
	if (ep14_2_mylord == 10 && checkquest(7426) == -1) {
		mes "[Visitor Laphine]";
		mes "我不明白城里为什么接连发生坏事……";
		mes "Mayor与Yggdrasil断开了联系，";
		mes "因此变得过时，";
		mes "而且还出现了裂隙。";
		next;
		mes "[Visitor Laphine]";
		mes "我听说裂隙是魔王制造的，Sapha也因此陷入困境。";
		mes "更何况，新Mayor他……有点……";
		next;
		mes "[Visitor Laphine]";
		mes "这会是世界末日的征兆吗？";
		mes "以前不是也发生过类似的事吗？";
		mes "你怎么看？";
		next;
		mes "[Working Laphine]";
		mes "...I'm working. Don't bother me.";
		mes "一想到裂隙我就头疼。因为它，向Splendide运送补给遇到了大麻烦。";
		next;
		mes "[Visitor Laphine]";
		mes "啊，说起来，你知道那些穿过Hazy Forest来的人类。";
		mes "我不知道Mayor在想什么，但他邀请他们，还给他们工作。";
		next;
		mes "[Visitor Laphine]";
		mes "现任Mayor异常年轻，";
		mes "而且'那个'……";
		mes "还试图会见外国人……";
		mes "他为什么会这样？";
		next;
		mes "[Working Laphine]";
		mes "你是说像那边一直偷听我们的家伙一样的外国人？";
		mes "Mayor最近经常见他。";
		next;
		mes "[Visitor Laphine]";
		mes "咦？！";
		mes "你什么时候来的？！";
		mes "别这样突然出现，你不该在这里。";
		next;
		select("'那个'是什么？");
		mes "[Working Laphine]";
		mes "不关你的事。";
		mes "这只是我们两个人之间的闲聊，别放在心上。";
		mes "现在，所有访客都该离开房间。";
		next;
		setquest 7426;
		if ((isbegin_quest(7423) + isbegin_quest(7424) + isbegin_quest(7425) + isbegin_quest(7426)) > 3) {
			mes "Laphine们说的'那个'是什么？似乎与Kardui有关。";
			mes "别再担心了，直接去问Kardui吧！";
			ep14_2_mylord = 11;
			setquest 7427;
			erasequest 7423;
			erasequest 7424;
			erasequest 7425;
			erasequest 7426;
			close;
		}
		mes "Laphine说的话很有意思。";
		mes "我想继续听，但必须走了。我该听听其他Laphine怎么说吗？";
		close;
	}
}

ecl_in03,245,54,2	script	Laphine official duty#tl	4_F_FAIRYKID4,{
	if (ep14_2_mylord == 10)
		doevent "Resting Laphine#tl01::OnTouch";
	else if (ep14_2_mylord == 11) {
		mes "[Working Laphine]";
		mes "你对我们的国王有疑问吗？";
		mes "不过，人类的国王和我们的Mayor完全不同。";
		mes "思考我们的Mayor时，不要套用同样的概念。";
		next;
		mes "[Working Laphine]";
		mes "希望你不要再表现出好奇心。";
		mes "明白了吗？";
		close;
	}
	else {
		mes "[Working Laphine]";
		mes "这里是处理公务的办公区域。";
		mes "你不该在这里。";
		close;
	}
}

ecl_tdun04,32,35,3	script	Hisie#tlord	4_M_FARIY_HISIE,{
	mes "[Hisie]";
	if (ep14_2_mylord < 14) {
		cutin "hisie01",0;
		mes "如果你只是出于好奇才一路爬到这里，最好现在就下去。";
		mes "Professor最近身体不太舒服。";
	}
	else if (ep14_2_mylord == 14) {
		cutin "hisie01",0;
		mes "旅行者，你在盯着什么看？";
		next;
		mes "站在你面前的Laphine身材高大、皮肤黝黑，还有一对小翅膀。";
		mes "他似乎是上层阶级Dona与下层阶级Papang的混合体。";
		mes "而且……";
		next;
		select("他看起来一模一样！！");
		cutin "",255;
		mes "["+ strcharinfo(0) +"]";
		mes "你是Laphine？";
		mes "为什么你和Kardui长得一模一样？";
		next;
		cutin "hisie03",0;
		mes "[Hisie]";
		mes "你的工作就是随便说话吗？";
		mes "还是在评论我的外表？";
		mes "你到底是谁？";
		next;
		mes "[Hisie]";
		mes "是Kar派你来的吗？";
		next;
		select("我需要见Kardui的哥哥。");
		cutin "hisie01",0;
		mes "[Hisie]";
		mes "……我想Kar没有告诉你我的事。";
		mes "你连他哥哥的名字都没问就来了？";
		next;
		mes "[Hisie]";
		mes "我是Hisie，Kar的哥哥。";
		mes "我们长得像是因为我们是双胞胎。";
		mes "你是来把手里的那封信交给我的，对吧？";
		next;
		mes "[Hisie]";
		mes "也许这就是他告诉我很快会有客人来访的意思。";
		mes "我会读这封信，你先在那边等着。";
		ep14_2_mylord = 15;
		changequest 7434,7435;
		next;
		mes "[Hisie]";
		mes "只需要几分钟。";
	}
	else if (ep14_2_mylord == 15) {
		if (checkquest(7435,PLAYTIME) == 0) {
			cutin "hisie01",0;
			mes "还没读完，我还在看。";
			mes "再等一会儿。";
		}
		else {
			cutin "hisie01",0;
			mes "抱歉让你久等了。";
			mes "我读完信了。";
			mes "他说想介绍他的朋友，我想那个人就是你。";
			next;
			cutin "hisie02",0;
			mes "[Hisie]";
			mes "他大概是想给我一个惊喜。";
			mes "他一点也没变。";
			mes "如你所知，我一半是Dona，一半是Papang，所以看起来很特别。";
			next;
			mes "[Hisie]";
			mes "说来话长，但我认为你应该知道。";
			mes "除了介绍你之外，Kar还在信里提到了一件事。";
			next;
			mes "[Hisie]";
			mes "但是……";
			mes "他为什么现在要找Avant？";
			next;
			if (select("Avant？:还有一件事？") == 2) {
				mes "[Hisie]";
				mes "他想让我找到Avant。";
				mes "而且他说你会提供很大帮助？";
				next;
			}
			cutin "hisie01",0;
			mes "[Hisie]";
			mes "Avant是魔力方面的学者……";
			mes "...and the father of me and Kar.";
			mes "但他为什么选择你？";
			mes "如果是不想告诉其他人的事，他本可以直接告诉我。";
			next;
			mes "[Hisie]";
			mes "总之，我不知道Avant的下落。";
			mes "我不想知道，也想阻止Kar找他。但他一定有自己的理由。";
			next;
			select("但他是你的父亲？");
			cutin "hisie02",0;
			mes "[Hisie]";
			mes "他只是我们的生物学父亲。";
			mes "实际上，我们不过是他实验用的材料。";
			mes "我们只是为了证明他的假说而制造的对象。";
			next;
			mes "[Hisie]";
			mes "所以我们之间不可能存在亲情或爱。";
			mes "Kar可能是为了消灭Avant才去找他。";
			next;
			select("实验？假说？:被制造的对象？");
			cutin "hisie01",0;
			mes "[Hisie]";
			mes "你知道Seneth吗？他是混血，却成为了Mayor。";
			mes "Avant一定对混血成为Mayor这件事感兴趣。";
			next;
			mes "[Hisie]";
			mes "所以他提出了几个假说，并通过实验来证明。";
			mes "Kar是Avant经过充分准备创造出的成果，";
			next;
			cutin "hisie02",0;
			mes "[Hisie]";
			mes "而我是实验中总会出现的意外。";
			mes "总之，Kar成为了国王，却失去了整个人生。";
			mes "不过，他对Avant的憎恨丝毫没有改变。";
			next;
			mes "[Hisie]";
			mes "但现在Kar正在寻找Avant……？";
			mes "也许他改变了想法，或者有什么计划。";
			mes "成为Mayor后，那个爱哭鬼成长了很多。";
			next;
			select("爱哭鬼？");
			mes "["+ strcharinfo(0) +"]";
			mes "你一定是在开玩笑，他怎么会是爱哭鬼。";
			mes "我认识的Kardui非常自信而且能干……";
			next;
			cutin "hisie04",0;
			mes "[Hisie]";
			mes "你说得对，我知道。";
			mes "自从成为Mayor后，他的性格改变了很多。";
			mes "我一直想亲眼看看。";
			next;
			select("你亲自去见他怎么样？");
			cutin "hisie03",0;
			mes "[Hisie]";
			mes "如果我去，年轻的Laphine会害怕。";
			mes "我既不是Dona，也不是Papang。我无处归属。";
			mes "Florence曾经想做的事，就是创造混血的血脉。";
			mes "他难道不想创造出像我这样的存在吗？";
			next;
			cutin "hisie01",0;
			mes "[Hisie]";
			mes "总之，我们该找Avant吗？";
			mes "他的愚蠢实验被长老发现并失踪，已经过去几十年了。";
			mes "我相信他正在某处庆祝实验成功。";
			mes "他就是那样的人。";
			next;
			mes "[Hisie]";
			mes "Eclage内部就交给你寻找。";
			mes "他是优秀的魔法学者，真理之门的学者或许知道些什么。";
			next;
			mes "[Hisie]";
			mes "我会独自搜索Eclage外部。";
			mes "只要能找到一丝线索，我就算幸运。";
			mes "现在，出发吧！";
			changequest 7435,7436;
			ep14_2_mylord = 16;
		}
	}
	else if (ep14_2_mylord == 16) {
		cutin "hisie01",0;
		mes "我请你负责搜索Eclage内部。";
		mes "线索应该很少，所以会相当困难。";
	}
	else if (ep14_2_mylord == 17) {
		cutin "hisie01",0;
		mes "你找到什么了吗？";
		mes "Chief of Staff资助的魔法学者？";
		mes "我们最好问问他是谁、来自哪里。";
		next;
		mes "[Hisie]";
		mes "在这座塔的任何地方都能轻易找到Dustball和落叶制成的书签。";
		mes "现在先照他说的做，尽量收集一些信息。";
	}
	else if (ep14_2_mylord == 18) {
		if (isbegin_quest(7440) == 1) {
			cutin "hisie01",0;
			mes "有进展吗？";
			next;
			mes "告诉他你从Minuel那里得到的信息。";
			next;
			mes "[Hisie]";
			mes "我们应该去确认Shenime资助的魔法学者是谁。";
			mes "我偶然在东边发现了一座实验室Yai。";
			next;
			mes "[Hisie]";
			mes "但那是一座像其他Yai一样开放、用于居住或简单研究的Yai……";
			mes "可能不是进行秘密实验或Avant藏身的地方。";
			next;
			mes "[Hisie]";
			mes "既然除此之外没有任何线索，我们就去确认他是谁。";
			mes "这就是我的计划。";
			next;
			mes "[Hisie]";
			mes "我希望你假装是Shenime派来的，带一个Dustball和10个书签给他。";

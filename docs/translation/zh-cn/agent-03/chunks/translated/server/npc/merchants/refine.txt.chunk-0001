// Christopher: Geffen Blacksmith
//============================================================
geffen_in,110,172,0	script	Christopher#1	63,{
	mes "[Christopher Guillenrow]";
	mes "欢迎来到Christopher的工坊。锻造所需的一切都能在这里获得。";
	mes "你想办理什么业务？";
	next;
	switch(select("购买铁砧:购买锻造物品:购买金属:提纯粗矿:取消")) {
	case 1:
		mes "[Christopher Guillenrow]";
		mes "更好的铁砧能提高锻造优质武器的机会，但价格也更高。想清楚后购买最适合你的吧，小伙子。";
		next;
		switch(select("铁砧-30,000 Zeny:神之金属铁砧-120,000 Zeny:黄金铁砧-300,000 Zeny:更好的铁砧:取消")) {
		case 1:
			if (Zeny < 30000) {
				mes "[Christopher Guillenrow]";
				mes "你带的钱不够，我不能把它卖给你。我可不能因为你而亏本。";
				close;
			}
			getitem 986,1; // Anvil
			Zeny = Zeny-30000;
			mes "[Christopher Guillenrow]";
			mes "这是最便宜的一种，但足以锻造大多数物品。感谢光临我的工坊，有需要随时再来。";
			close;
		case 2:
			if (Zeny < 120000) {
				mes "[Christopher Guillenrow]";
				mes "你带的钱不够，我不能把它卖给你。我可不能因为你而亏本。";
				close;
			}
			getitem 987,1; // Oridecon_Anvil
			Zeny = Zeny-120000;
			mes "[Christopher Guillenrow]";
			mes "不错，朋友，你很懂铁砧。这才是铁匠该用的铁砧，对吧？感谢光临我的工坊，有需要随时再来。";
			close;
		case 3:
			if (Zeny < 300000) {
				mes "[Christopher Guillenrow]";
				mes "你带的钱不够，我不能把它卖给你。我可不能因为你而亏本。";
				close;
			}
			getitem 988,1; // Golden_Anvil
			Zeny = Zeny-300000;
			mes "[Christopher Guillenrow]";
			mes "这是我工坊里最好的东西！有了它，你就能称霸铁匠界！感谢光临我的工坊，有需要随时再来。";
			close;
		case 4:
			mes "[Christopher Guillenrow]";
			mes "抱歉，我没有比黄金铁砧更坚固的东西。";
			next;
			mes "[Christopher Guillenrow]";
			mes "我想传奇铁砧制造师Ringgel应该有，但你恐怕找不到他，虽然他就在这个世界的某处。";
			close;
		case 5:
			mes "[Christopher Guillenrow]";
			mes "好，有需要随时再来。祝你平安。";
			close;
		}
	case 2:
		mes "[Christopher Guillenrow]";
		mes "受人尊敬的铁匠会使用优质工具。用我的工具，你也能成为那样的人。选你想要的吧。";
		next;
		switch(select("小型熔炉-150 Zeny:铁锤-1000 Zeny:黄金锤-3000 Zeny:神之金属锤-5000 Zeny:取消")) {
		case 1:
			mes "[Christopher Guillenrow]";
			mes "这是提炼金属必不可少的工具！要买多少？想退出就输入‘0’。";
			next;
			while(1) {
				input .@input;
				if (.@input == 0) {
					mes "[Christopher Guillenrow]";
					mes "好，交易取消。祝你平安。";
					close;
				}
				else if ((.@input < 0) || (.@input > 500)) {
					mes "[Christopher Guillenrow]";
					mes "一次最多购买500个。";
					next;
				}
				else {
					break;
				}
			}
			.@sell = .@input * 150;
			if (Zeny < .@sell) {
				mes "[Christopher Guillenrow]";
				mes "你带的钱不够，我不能把它卖给你。我可不能因为你而亏本。";
				close;
			}
			if (checkweight(612,.@input) == 0) {
				mes "[Christopher Guillenrow]";
				mes "你的背包似乎没有足够空间。先把一些物品存入卡普拉仓库吧。";
				close;
			}
			getitem 612,.@input; // Portable_Furnace
			Zeny = Zeny-.@sell;
			mes "[Christopher Guillenrow]";
			mes "感谢光临我的工坊，有需要随时再来。";
			close;
		case 2:
			if (Zeny < 1000) {
				mes "[Christopher Guillenrow]";
				mes "你带的钱不够，我不能把它卖给你。我可不能因为你而亏本。";
				close;
			}
			getitem 613,1; // Iron_Hammer
			Zeny = Zeny-1000;
			mes "[Christopher Guillenrow]";
			mes "感谢光临我的工坊，有需要随时再来。";
			close;
		case 3:
			if (Zeny < 3000) {
				mes "[Christopher Guillenrow]";
				mes "你带的钱不够，我不能把它卖给你。我可不能因为你而亏本。";
				close;
			}
			getitem 614,1; // Golden_Hammer
			Zeny = Zeny-3000;
			mes "[Christopher Guillenrow]";
			mes "感谢光临我的工坊，有需要随时再来。";
			close;
		case 4:
			if (Zeny < 5000) {
				mes "[Christopher Guillenrow]";
				mes "你带的钱不够，我不能把它卖给你。我可不能因为你而亏本。";
				close;
			}
			getitem 615,1; // Oridecon_Hammer
			Zeny = Zeny-5000;
			mes "[Christopher Guillenrow]";
			mes "感谢光临我的工坊，有需要随时再来。";
			close;
		case 5:
			mes "[Christopher Guillenrow]";
			mes "有需要随时再来。祝你平安。";
			close;
		}
	case 3:
		mes "[Christopher Guillenrow]";
		mes "我准备了各种高品质金属。现在，你需要哪一种？";
		next;
		switch(select("铝-200 Zeny:神之金属-1000 Zeny:取消")) {
		case 1:
			mes "[Christopher Guillenrow]";
			mes "要买多少？不想买就输入‘0’。";
			next;
			while(1) {
				input .@input;
				if (.@input == 0) {
					mes "[Christopher Guillenrow]";
					mes "交易已";
					mes "取消。";
					mes "祝你平安。";
					close;
				}
				else if ((.@input < 0) || (.@input > 500)) {
					mes "[Christopher Guillenrow]";
					mes "一次最多购买500个。";
					next;
				}
				else {
					break;
				}
			}
			.@sell = .@input * 200;
			if (Zeny < .@sell) {
				mes "[Christopher Guillenrow]";
				mes "你的钱不够。我不能再降价了……你知道我老婆多爱唠叨Zeny。";
				close;
			}
			if (checkweight(1010,.@input) == 0) {
				mes "[Christopher Guillenrow]";
				mes "你的背包没有空间携带新物品。先把东西存进卡普拉仓库再回来吧。";
				close;
			}
			getitem 1010,.@input; // Phracon
			Zeny = Zeny-.@sell;
			mes "[Christopher Guillenrow]";
			mes "感谢光临我的工坊，有需要随时再来。";
			close;
		case 2:
			mes "[Christopher Guillenrow]";
			mes "要买多少？不想买就输入‘0’。";
			next;
			while(1) {
				input .@input;
				if (.@input == 0) {
					mes "[Christopher Guillenrow]";
					mes "交易已";
					mes "取消。";
					mes "祝你平安。";
					close;
				}
				else if ((.@input < 0) || (.@input > 500)) {
					mes "[Christopher Guillenrow]";
					mes "一次最多购买500个。";
					next;
				}
				else {
					break;
				}
			}
			.@sell = .@input * 1000;
			if (Zeny < .@sell) {
				mes "[Christopher Guillenrow]";
				mes "你带的钱不够，我不能把它卖给你。我可不能因为你而亏本。";
				close;
			}
			if (checkweight(1011,.@input) == 0) {
				mes "[Christopher Guillenrow]";
				mes "朋友……你的背包似乎没有空间。先把东西存进卡普拉仓库吧。";
				close;
			}
			getitem 1011,.@input; // Emveretarcon
			Zeny = Zeny-.@sell;
			mes "[Christopher Guillenrow]";
			mes "感谢光临我的工坊，有需要随时再来。";
			close;
		case 3:
			mes "[Christopher Guillenrow]";
			mes "有需要随时再来。祝你平安。";
			close;
		}
	case 4:
		mes "[Christopher Guillenrow]";
		mes "我可以提纯神之金属和铝。每5个粗矿可提炼成1个精炼矿石。你想制作哪一种？";
		next;
		switch(select("制作神之金属:制作铝:取消")) {
		case 1:
			if (countitem(756) < 5) {
				mes "[Christopher Guillenrow]";
				mes "我说过，1个神之金属需要5个粗神之金属。";
				close;
			}
			else {
				delitem 756,5;  //Oridecon_Stone
				getitem 984,1; // Oridecon
				mes "[Christopher Guillenrow]";
				mes "这是你的神之金属。欢迎随时光临，我会等着你。";
				close;
			}
		case 2:
			if (countitem(757) < 5) {
				mes "[Christopher Guillenrow]";
				mes "我说过，1个铝需要5个粗铝。";
				close;
			}
			else {
				delitem 757,5;  //Elunium_Stone
				getitem 985,1; // Elunium
				mes "[Christopher Guillenrow]";
				mes "啊，这是你的铝。欢迎再次光临。";
				close;
			}
		case 3:
			mes "[Christopher Guillenrow]";
			mes "有需要随时再来。祝你平安。";
			close;
		}
	case 5:
		mes "[Christopher Guillenrow]";
		mes "有需要随时再来。祝你平安。";
		close;
	}
}

// Paul Spanner: Einbroch Blacksmith Supplier
//============================================================
ein_in01,38,29,0	script	Paul Spanner	63,{
	if (checkweight(1201,1) == 0) {
		mes "- 等一下！！-";
		mes "- 你现在携带的物品 -";
		mes "- 太多了。-";
		mes "- 请先减轻负重 -";
		mes "- 再试一次。-";
		close;
	}
	mes "[Paul Spanner]";
	mes "欢迎，朋友。";
	mes "我的店里有锻造所需的一切。";
	mes "告诉我你需要什么。";
	next;
	switch(select("购买铁砧:购买锻造物品:购买金属:加工矿石:退出")) {
	case 1:
		mes "[Paul Spanner]";
		mes "铁砧是铁匠最必需的物品。";
		mes "你会多次使用铁砧，所以最好买一台好的。";
		next;
		switch(select("铁砧-30,000 Zeny:神之金属铁砧-120,000 Zeny:黄金铁砧-300,000 Zeny:我需要更好的铁砧:取消")) {
		case 1:
			if (Zeny < 30000) {
				mes "[Paul Spanner]";
				mes "这么点钱连玩具铁砧都买不起！";
				close;
			}
			getitem 986,1; //Anvil
			Zeny = Zeny-30000;
			mes "[Paul Spanner]";
			mes "这是最便宜、功能最基本的铁砧。";
			mes "感谢光临我的店。有需要就告诉我。";
			close;
		case 2:
			if (Zeny < 120000) {
				mes "[Paul Spanner]";
				mes "这么点钱连玩具铁砧都买不起！";
				close;
			}
			getitem 987,1; //Oridecon_Anvil
			Zeny = Zeny-120000;
			mes "[Paul Spanner]";
			mes "啊，你很懂铁砧。铁匠至少需要这么好的铁砧。";
			mes "感谢光临我的店。有需要就告诉我。";
			close;
		case 3:
			if (Zeny < 300000) {
				mes "[Paul Spanner]";
				mes "这么点钱连玩具铁砧都买不起！";
				close;
			}
			getitem 988,1; //Golden_Anvil
			Zeny = Zeny-300000;
			mes "[Paul Spanner]";
			mes "从你选择黄金铁砧就能看出你想成为优秀铁匠的志向！";
			mes "这台铁砧一定能帮助你打造最好的武器。";
			close;
		case 4:
			mes "[Paul Spanner]";
			mes "抱歉，我不出售比黄金铁砧更好的铁砧。";
			mes "除非你找到传说中的‘Linggell’铁砧，否则别处不会有更好的。";
			close;
		case 5:
			mes "[Paul Spanner]";
			mes "有需要就告诉我。";
			close;
		}
	case 2:
		mes "[Paul Spanner]";
		mes "加工矿石和锻造武器需要各种材料。";
		mes "我这里都有，看看吧。";
		next;
		switch(select("小型熔炉-150 Zeny:铁锤-1,000 Zeny:黄金锤-3,000 Zeny:神之金属锤-5,000 Zeny:取消")) {
		case 1:
			.@item = 612;
			.@item_cost = 150;
			.@item_weight = 200;
			mes "[Paul Spanner]";
			mes "加工矿石一定需要这台熔炉！";
			next;
			break;
		case 2:
			.@item = 613;
			.@item_cost = 1000;
			.@item_weight = 200;
			break;
		case 3:
			.@item = 614;
			.@item_cost = 3000;
			.@item_weight = 300;
			break;
		case 4:
			.@item = 615;
			.@item_cost = 5000;
			.@item_weight = 400;
			break;
		case 5:
			mes "[Paul Spanner]";
			mes "有需要就告诉我。";
			close;
		}
		mes "[Paul Spanner]";
		mes "需要多少？想取消交易就输入‘0’。";
		next;
		while(1) {
			input .@input;
			if (.@input == 0) {
				mes "[Paul Spanner]";
				mes "你取消了交易。有需要就告诉我。";
				close;
			}
			else if ((.@input < 0) || (.@input > 500)) {
				mes "[Paul Spanner]";
				mes "一次最多购买500个。";
				next;
			}
			else {
				break;
			}
		}
		.@sell = .@input * .@item_cost;
		if (Zeny < .@sell) {
			mes "[Paul Spanner]";
			mes "你的钱不够。抱歉，我不能亏本出售。";
			close;
		}
		if (checkweight(.@item,.@input) == 0) {
			mes "[Paul Spanner]";
			mes "嘿，你脸色很差。先减轻负重再来吧。";
			close;
		}
		Zeny = Zeny-.@sell;
		getitem .@item,.@input;
		mes "[Paul Spanner]";
		mes "感谢光临我的店。有需要就告诉我。";
		close;
	case 3:
		mes "[Paul Spanner]";
		mes "我有高品质金属。";
		mes "你想买哪种金属？";
		next;
		switch(select("铝-200 Zeny:神之金属-1,000 Zeny:退出")) {
		case 1:
			.@item = 1010;
			.@item_price = 200;
			break;
		case 2:
			.@item = 1011;
			.@item_price = 1000;
			break;
		case 3:
			mes "[Paul Spanner]";
			mes "有需要就告诉我。";
			close;
		}
		mes "[Paul Spanner]";
		mes "需要多少？想取消交易就输入‘0’。";
		next;
		while(1) {
			input .@input;
			if (.@input == 0) {
				mes "[Paul Spanner]";
				mes "交易已取消。有需要就告诉我。";
				close;
			}
			else if ((.@input < 0) || (.@input > 500)) {
				mes "[Paul Spanner]";
				mes "一次最多购买500个。";
				next;
			}
			else {
				break;
			}
		}
		.@sell = .@input * .@item_price;
		if (Zeny < .@sell) {
			mes "[Paul Spanner]";
			mes "你的钱不够。抱歉，我不能亏本出售。";
			close;
		}
		if (checkweight(.@item,.@input) == 0) {
			mes "[Paul Spanner]";
			mes "嘿，你脸色很差。先减轻负重再来吧。";
			close;
		}
		getitem .@item,.@input;
		Zeny = Zeny-.@sell;
		mes "[Paul Spanner]";
		mes "感谢光临我的店。有需要就告诉我。";
		close;
	case 4:
		mes "[Paul Spanner]";
		mes "我可以帮你加工神之金属和铝。";
		mes "5个矿石可以加工成1个神之金属或铝。";
		mes "你想加工哪一种？";
		switch(select("神之金属:铝:退出")) {
		case 1:
			if (countitem(756) < 5) {
				mes "[Paul Spanner]";
				mes "需要5个矿石才能加工成1个纯神之金属。";
				close;
			}
			else {
				delitem 756,5; //Oridecon_Stone
				getitem 984,1; //Oridecon
				mes "[Paul Spanner]";
				mes "给你。感谢使用我的服务。";
				close;
			}
		case 2:
			if (countitem(757) < 5) {

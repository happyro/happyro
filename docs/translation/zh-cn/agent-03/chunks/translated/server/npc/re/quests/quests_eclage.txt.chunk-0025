	}
	close2;
	cutin "",255;
	end;
}

sec_in02,16,11,5	script	New Oz Image#1	4_M_MINSTREL1,1,1,{
	callfunc "F_GM_NPC";
	if (!isequipped(2199)) {
		mes "你没有装备正确的装备。";
		mes "你的盾牌呢？";
		close;
	}
	mes "Mushroom当前状态为-" + ep14_2_oliver + "，";
	mes "Nine状态为-" + ep14_2_nines;
	next;
	switch( select("设置物品:任务:确认图像") ) {
		mes "New Oz";
	case 1:
		mes "要设置哪件物品？";
		next;
		switch( select("九:蘑菇") ) {
		case 1:
			mes "Nine状态为-" + ep14_2_nines;
			next;
			switch( select("+1:-1:初始化") ) {
				mes "New Oz";
			case 1:
				mes "设置物品+1";
				ep14_2_nines++;
				close;
			case 2:
				mes "设置物品+1";
				close;
			case 3:
				mes "初始化";
				ep14_2_nines = 0;
				close;
			}
		case 2:
			mes "Mushroom状态为-" + ep14_2_oliver;
			next;
			switch( select("+1:-1:我不要:开始任务(5)") ) {
				mes "New Oz";
			case 1:
				mes "设置物品+1";
				ep14_2_oliver++;
				close;
			case 2:
				mes "设置物品+1";
				close;
			case 3:
				mes "在获得Mushroom的";
				ep14_2_oliver = 0;
				close;
			case 4:
				mes "Mushroom的5";
				ep14_2_oliver = 5;
				close;
			}
		}
	case 2:
		mes "删除所有任务";
		for ( .@i = 13050; .@i < 13067; .@i++ )
			if (isbegin_quest(.@i)) erasequest .@i;
		close;
	case 3:
		cutin "nines01",2;
		mes "你是来确认图像的吗？";
		next;
		mes "New Oz";
		mes "你现在看到的是普通表情。";
		next;
		mes "New Oz";
		mes "这是微笑表情。";
		cutin "nines02",2;
		next;
		mes "New Oz";
		mes "想看更灿烂的笑容吗？";
		cutin "nines03",2;
		next;
		mes "New Oz";
		mes "这是饥饿的表情……";
		cutin "nines04",2;
		next;
		mes "New Oz";
		mes "确认后报告给我，好吗？";
		close2;
		cutin "",255;
		end;
	}
}

// Memory of Professor Worm
//============================================================
sec_in02,10,17,4	script	Professor Aide#worm	4_BULL,{
	if (callfunc("F_GM_NPC",1917,0) != 1) {
		mes "呀！";
		close;
	}
	mes "[Briquet toothpick]";
	mes "把你想做的事都告诉我！";
	next;
	switch( select("初始化任务:20个星形蘑菇:涂鸦调查前:最终奖励前") ) {
		mes "[Operation Briquet]";
	case 1:
		mes "就是这个！";
		ep14_2_profe = 0;
		for (.@i = 1214; .@i < 1226; .@i++)
			if (isbegin_quest(.@i))
				erasequest .@i;
		close;
	case 2:
		mes "就是这个！";
		getitem 6542,20;// Star_Shape_Mushroom
		close;
	case 3:
		mes "就是这个！";
		ep14_2_profe = 4;
		close;
	case 4:
		mes "就是这个！";
		ep14_2_profe = 11;
		close;
	}
}

ecl_tdun04,26,39,1	script	Professor Worm#worm	4_M_PROFESSORWORM,{
	if (!checkweight(1301,3)) {
		mes "- 你携带的物品太多，无法继续对话。";
		close;
	}
	mes "[Professor Worm]";
	if (BaseLevel < 120) {
		mes "你是怎么来到这里的？";
		mes "你看起来也太虚弱了！";
		mes "你是我创造的怪物吗？";
		next;
		mes "[Professor Worm]";
		mes "我有一项工作要交给你，所以先把自己锻炼到Incubus的等级，再回来找我！";
	}
	else if (ep14_2_profe == 0) {
		mes "忙、忙、忙！怪物，我还得创造更多怪物！";
		mes "危险！我不知道攻击什么时候会来！";
		mes "它要来了！全都要来了！";
		mes "就像海啸一样！！";
		next;
		switch( select("什么要来了？:你在这里做什么？:请告诉我Bifrost的事。") ) {
			mes "[Professor Worm]";
		case 1:
			mes "呀！";
			mes "你是怎么来到这里的？我在塔周围放了很多怪物！";
			mes "不可能有人闯进来！也就是说，你……你是！";
			next;
			mes "[Professor Worm]";
			mes "你是我创造的怪物吗？";
			mes "一定是！";
			next;
			switch( select("我想知道这座塔的事。:这是会说话的虫子！") ) {
				mes "[Professor Worm]";
			case 1:
				mes "塔？什么塔？";
				mes "这里是塔？";
				mes "我为什么会在塔里？";
				mes "过了这么久，我什么都忘了！";
				close;
			case 2:
				mes "我为什么变成虫子了？";
				mes "你这个怪物！";
				mes "我没费多少力气创造你，你的眼睛就这么差吗？！";
				next;
				mes "Professor Worm摸了摸自己的脸，震惊地发现自己透过银盘看到了自己的脸。";
				next;
				mes "[Professor Worm]";
				mes "我英俊的脸什么时候变成这样了？我的名字是……";
				next;
				mes "["+ strcharinfo(0) +"]";
				mes "Professor Worm！";
				next;
				mes "[Professor Worm]";
				mes "没错！";
				mes "等等，不对……";
				mes "天啊，我连名字都忘了！";
				mes "别傻站着，去找找我的画像！";
				next;
				switch( select("我很忙！:为什么要我做！") ) {
					mes "[Professor Worm]";
				case 1:
					mes "你特意抽空来到这里，却告诉我你很忙？！";
					close;
				case 2:
					mes "你一定会好奇的。";
					mes "虽然我的记忆变差了，但直觉却变得敏锐多了！";
					mes "如果你想听到想听的事，就帮我找回记忆吧！";
					next;
					mes "[Professor Worm]";
					mes "这房间书架上的许多书中，有一本夹着我的画像。请把它找出来！";
					setquest 1214;
					ep14_2_profe = 1;
					close;
				}
			}
		case 2:
			mes "这是个难题。";
			mes "几百年前我明明还知道答案，现在却完全忘记了。";
			mes "我现在只能做自己最擅长的事。";
			mes "创造怪物并把它们放出去。";
			close;
		case 3:
			mes "Bifrost？它正在睡觉。";
			mes "睡得很沉。";
			mes "之后我可能也会睡很久……";
			mes "接下来就轮到我了！";
			mes "不，不！我不能独自承担这一切。";
			mes "怪物，我得放出更多怪物！";
			close;
		}
	}
	else if (ep14_2_profe == 1)
		mes "这房间书架上的许多书中，有一本夹着我的画像。请把它找出来！";
	else if (ep14_2_profe == 2) {
		mes "这是我的画像？";
		next;
		cutin "ep14_pro_worm",3;
		mes "[Professor Worm]";
		mes "我以前是这个样子？";
		mes "……";
		mes "哦，对，这就是我！";
		mes "但我怎么会变成这样？";
		mes "等一下……";
		next;
		mes "[Professor Worm]";
		mes "我模模糊糊想起了一些事……";
		mes "当时的天气、风景……";
		next;
		mes "[Professor Worm]";
		mes "我……对，那是一片百花盛开的土地，我在那里收集某种东西……没错！";
		mes "我当时在收集^FF0000星形蘑菇^000000！";
		cutin "",255;
		next;
		mes "[Professor Worm]";
		mes "我为什么要做那件事……";
		mes "喂，怪物，如果你去百花盛开的土地，带些^FF0000星形蘑菇^000000回来，";
		mes "我或许就能想起一切！";
		next;
		switch( select("请现在试着回忆吧。:我会替你带回来。") ) {
			mes "[Professor Worm]";
		case 1:
			mes "我连自己的名字都忘了，现在什么也想不起来！";
			close;
		case 2:
			mes "从百花盛开的土地带回20个^FF0000星形蘑菇^000000。";
			mes "我想，名为'Petal'的怪物通常会把它们叼在嘴里到处游荡。";
			mes "只带几个蘑菇，可别指望我能想起什么！";
			changequest 1215,1216;
			ep14_2_profe = 3;
			close;
		}
	}
	else if (ep14_2_profe == 3) {
		if (countitem(6542) < 20) {
			mes "^FF0000星形蘑菇^000000不够！";
			mes "我当时正要用20个蘑菇做什么事。你带来的不够的话，";
			mes "我可能也无法想起足够多的事情！";
			next;
			mes "[Professor Worm]";
			mes "在百花盛开的土地上寻找四处游荡的Petal，就能轻松找到^FF0000星形蘑菇^000000。";
		}
		else {
			mes "你带来了20个^FF0000星形蘑菇^000000。";
			mes "对，对，我感觉记忆马上就要涌回来了！";
			next;
			mes "[Professor Worm]";
			mes "我用这些做……一些药水的材料！";
			mes "不过可不是什么好东西……";
			mes "我还有其他材料……";
			next;
			mes "[Professor Worm]";
			mes "趁我还没忘，我应该把这些事记在墙上。等等……";
			mes "是谁在这面墙上画了这么多东西？！";
			mes "字迹和我的一模一样！";
			mes "... I must have done it!";
			next;
			mes "每面墙上都写满了Professor Worm的笔记。";
			mes "如果仔细研究墙壁，也许能得到一些关于这座塔或Bifrost的信息。";
			delitem 6542,20;// Star_Shape_Mushroom
			changequest 1216,1217;
			ep14_2_profe = 4;
		}
	}
	else if (ep14_2_profe == 4) {
		.@quest_status = isbegin_quest(1218) + isbegin_quest(1219) + isbegin_quest(1220) + isbegin_quest(1221) + isbegin_quest(1222);
		if (.@quest_status < 10) {
			mes "每面墙上都有这么多涂鸦。";
			mes "看起来像我的字迹，一定是我画的。";
			mes "请查看五面不同的墙，分析我的涂鸦，然后告诉我你的发现。";
			mes "我太好奇了，好奇得记忆都快飘走了。";
		}
		else {
			mes "你研究完所有涂鸦了？";
			next;
			mes "涂鸦的内容已经分析完毕，并报告给教授了。";
 			next;
			mes "[Professor Worm]";
			mes "原来如此。我当时正在制造让Bifrost沉睡的药物。因此受到惩罚，变成了虫子，记忆也迅速衰退。";
			mes "让我想一会儿。";
			erasequest 1217;
			ep14_2_profe = 5;
		}
	}
	else if (ep14_2_profe == 5) {
		mes "喂，怪物，多亏了你，我的记忆似乎一点点回来了。";
		mes "但我为什么会被困在这座塔里？";
		mes "我又为什么要让Bifrost沉睡？";
		next;
		if (select("别问我！:再仔细想想！") == 1) {
			mes "[Professor Worm]";
			mes "怪物竟敢惹恼自己的创造者！";
			close;
		}
		mes "[Professor Worm]";
		mes "啊，我的头感觉快要爆炸了。";
		mes "我应该在墙上再记些笔记。";
		mes "等等，墙上已经没有空位了！";
		mes "是谁在墙上画了这么多东西？";
		mes "是你吗，怪物？";
		emotion ET_SWEAT, playerattached();
		next;
		mes "[Professor Worm]";
		mes "看来我得写日记了……";
		mes "对了，我以前会写日记！";
		next;
		if (select("你又把日记怎么处理了？:拿给我看看。") == 1) {
			mes "[Professor Worm]";
			mes "我一定写下了本不该忘记的事情！";
			mes "不过你为什么这么讽刺？";
			close;
		}
		mes "[Professor Worm]";
		mes "嗯……那不是普通的笔记本……我用的是能记录事情的青蛙，也就是^0000FF日记青蛙^000000。";
		mes "每次我真的生气时，就把它们扔得到处都是，所以全都散落了。";
		next;
		if (select("你的脾气真大！:要我去找日记青蛙吗？") == 1) {
			mes "[Professor Worm]";
			mes "你为什么不试试被关起来生活？";
			mes "如果你处在我的位置，你扔掉的就不只是几只青蛙，而是整个房间的东西！";
			close;
		}
		mes "[Professor Worm]";
		mes "我把它们扔得到处都是。";
		mes "如果它们没有散得太远，我相信还在附近某处。";
		mes "让我想想，也许能记起几只……";
		next;
		mes "[Professor Worm]";
		mes "对了，我把一只日记青蛙扔到了正下方的地板上。";
		mes "你去找那一只时，";
		mes "我会试着想起其他的被我扔在哪里。";
		setquest 1223;
		ep14_2_profe = 6;
	}
	else if (ep14_2_profe == 6) {
		mes "我把一只日记青蛙扔到了正下方的地板上。";
		mes "你去找那一只时，我会试着想起其他的被我扔在哪里。";
	}
	else if (ep14_2_profe == 7 || ep14_2_profe == 8) {
		mes "我想起来了！我把一只日记青蛙扔到了塔的一楼。";
		mes "它肯定滚到了很远的地方。";
	}
	else if (ep14_2_profe == 9 || ep14_2_profe == 10) {
		mes "我想起来了！我随手扔出一只日记青蛙，它一直滚动，最后滚出了塔。";
		mes "它一定还在塔附近的某处。";
	}
	else if (ep14_2_profe == 11) {
		mes "你找到所有日记青蛙了吗？";
		mes "只找到三只？";
		mes "其余的都被毁掉了吗？";
		mes "我本该扔得更轻一点……";
		mes "非常感谢。多亏了你，我找到了画像，也找回了一部分记忆。";
		next;
		mes "[Professor Worm]";
		mes "但一切仍然不够清晰。";
		mes "我好奇得都要生气了，可已经没有日记青蛙可以扔了……";
		next;
		mes "[Professor Worm]";
		mes "我会想办法用其他方式找回记忆。到时候请再帮我一次。";
		erasequest 1228;
		ep14_2_profe = 12;
		getexp 1100000,700000;
		getitem 6081,1;// Splendide_Coin
	}
	else if (ep14_2_profe > 11) {
		mes "非常感谢你帮我找回记忆。";
		mes "但一切仍然不够清晰。";
		mes "我好奇得都要生气了，可已经没有日记青蛙可以扔了……";
		next;
		mes "[Professor Worm]";
		mes "我会想办法用其他方式找回记忆。到时候请再帮我一次。";
	}
	close;
}

ecl_tdun04,21,41,0	script	#pf	HIDDEN_WARP_NPC,2,2,{
	end;
OnTouch:
	if (ep14_2_profe == 1) {
		.@pro = rand(1,100);
		if (.@pro < 21) {
			mes "它好像就在这里某处。";
			mes "我们再仔细找找。";
		}
		else if (.@pro < 41)
			mes "每本书里都夹着便笺和图画，画像可能就在附近某处。";
		else if (.@pro < 61) {
			mes "找到了！";
			mes "……不对，只是一幅涂鸦。";
			mes "我们再在附近找找。";
		}
		else if (.@pro < 81) {
			mes "只是一些乱七八糟的东西。";
			mes "我们把所有地方都找一遍。";
		}
		else {
			mes "找到画像了！";
			next;
			cutin "ep14_pro_worm",3;
			mes "他看起来完全不同。";
			mes "如此浮夸的样子，他以前似乎是个自负的魔法师。";
			mes "遗憾的是纸张磨损严重，名字已经被抹去了。";
			next;
			mes "把这个拿给Professor Worm看看吧。";
			cutin "",255;
			changequest 1214,1215;
			ep14_2_profe = 2;
		}
		close;
	}
	else if (ep14_2_profe == 2) {
		mes "Professor Worm的画像已经找到了。";
		next;
		cutin "ep14_pro_worm",3;
		mes "既然找到了Professor Worm的画像，就不用再翻找书籍了。";
		next;
		mes "去拿给Professor Worm看看吧。";
		cutin "",255;
		close;
	}
}
ecl_tdun04,37,21,0	duplicate(#pf)	#pf3	HIDDEN_WARP_NPC,2,2

function	script	Wallnotes	{
	next;
	if (getarg(1,0) == 0) {
		if (select("别读了！:阅读。") == 1) {
			mes "看起来一点也不有趣！";
			close;
		}
		mes "阅读笔记。";
		next;
	}
	else if (select("停止阅读。:再读一遍。") == 1) {
		mes "反正也不需要记住，我就不读了。";
		close;
	}
	mes "[Wall Note "+ getarg(0) +"]";
	switch( getarg(0) ) {
	case 1:
		mes "我成功让Bifrost沉睡了。";
		mes "我真是太厉害了！";
		mes "但我为什么也必须留在这种地方？";
		return;
	case 2:
		mes "我被囚禁在塔里还没多久，记忆却流失得如此迅速。";
		mes "也许是Bifrost想保持清醒的强烈意志影响了我。";
		next;
		mes "[Wall Note 2]";
		mes "不知道连名字会不会忘记……真令人担心……";
		return;
	case 3:
		mes "我的外表正在改变！";
		mes "我的手，我的皮肤……";
		mes "这毫无疑问是虫子的形态！";
		mes "我不敢相信自己变成了虫子……";
		mes "怎么会这样！";
		next;
		mes "[Wall Note 3]";
		mes "这也是因为Bifrost吗？";
		mes "这是Bifrost因为我让她沉睡而施加的诅咒吗？";
		mes "她沉睡时也能对我做这种事吗？";
		mes "我不敢相信……天啊！";
		return;
	case 4:
		mes "Bifrost的头还在不断长大。我不敢相信……她一直延伸到了塔外！";
		mes "难道是她强烈的意志仍保持清醒，正试图传递信息？";
		return;
	case 5:
		mes "Bifrost之后下一个遭到攻击的人就是我！";
		mes "我感觉到一道诡异的目光正盯着我！";
		mes "我不能坐在这里任其摆布。";
		next;
		mes "[Wall Note 5]";

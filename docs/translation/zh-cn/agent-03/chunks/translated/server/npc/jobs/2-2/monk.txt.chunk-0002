			mes "30根树枝，";
			mes "5个杰勒比结晶";
			mes "10个毛虫皮";
			mes "这些是我需要的物品，全部找来。";
			close;
		}
	}
	else if (MONK_Q == 6) {
		mes "[茂海大师]";
		mes "我一直在等你。";
		next;
		if (countitem(943) > 4 && countitem(935) > 19 && countitem(912) > 4) {
			mes "[Sensei Moohae]";
			mes "真了不起，你找齐了所有物品。";
			mes "我会把这件事告诉长老。";
			set MONK_Q,10;
			changequest 3020,3024;
			delitem 943,5; //Solid_Shell
			delitem 935,20; //Shell
			delitem 912,5; //Zargon
			next;
			mes "[Sensei Moohae]";
			mes "你的下一步是去找……";
			mes "图哈长老。去找他。";
			mes "他在西北方。";
			close;
		}
		else {
			mes "[Sensei Moohae]";
			mes "你怎么会以为完成了？";
			mes "你没有我要求的物品！";
			mes "5个坚硬外壳，";
			mes "20个外壳，";
			mes "5个扎根。";
			mes "这些是我需要的物品，全部找来。";
			close;
		}
	}
	else if (MONK_Q == 7) {
		mes "[Sensei Moohae]";
		mes "又见面了。这么快就回来？";
		next;
		if (countitem(7053) > 4 && countitem(509) > 9 && countitem(508) > 9) {
			mes "[Sensei Moohae]";
			mes "很好，你找齐了所有物品。";
			mes "我会把这件事告诉长老。";
			set MONK_Q,10;
			changequest 3021,3024;
			delitem 7053,5; //Cyfar
			delitem 509,10; //White_Herb
			delitem 508,10; //Yellow_Herb
			next;
			mes "[Sensei Moohae]";
			mes "让我看看你接下来该见谁……";
			mes "啊……去找图哈长老。";
			mes "他在西北方。";
			close;
		}
		else {
			mes "[Sensei Moohae]";
			mes "物品在哪里……？";
			mes "你没有我要求的物品！";
			mes "5个赛依伐，";
			mes "10个白草，";
			mes "10个黄草。";
			mes "这些是我需要的物品，全部找来。";
			close;
		}
	}
	else if (MONK_Q == 8) {
		mes "[Sensei Moohae]";
		mes "嗯？";
		next;
		if (countitem(913) > 9 && countitem(948) > 4 && countitem(7033) > 19) {
			mes "[Sensei Moohae]";
			mes "很好，所有我要求的物品都齐了。";
			mes "我会把这件事告诉长老。";
			set MONK_Q,10;
			changequest 3022,3024;
			delitem 913,10; //Tooth_Of_Bat
			delitem 948,5; //Bear's_Foot
			delitem 7033,20; //Poison_Spore
			next;
			mes "[Sensei Moohae]";
			mes "让我看看你接下来该见谁……";
			mes "啊……去找图哈长老。";
			mes "他在西北方。";
			close;
		}
		else {
			mes "[Sensei Moohae]";
			mes "你怎么会以为完成了？";
			mes "你没有我要求的物品！";
			mes "10个蝙蝠牙，";
			mes "5个熊掌皮，";
			mes "20个毒魔菇孢子。";
			mes "这些是我需要的物品，全部找来。";
			close;
		}
	}
	else if (MONK_Q == 9) {
		mes "[Sensei Moohae]";
		mes "欢迎回来。";
		next;
		if (countitem(1027) > 4 && countitem(1025) > 19 && countitem(1042) > 9) {
			mes "[Sensei Moohae]";
			mes "哇，你找齐了所有物品！！";
			mes "我会把这件事告诉长老。";
			set MONK_Q,10;
			changequest 3023,3024;
			delitem 1027,5; //Porcupine_Spike
			delitem 1025,20; //Spiderweb
			delitem 1042,10; //Short_Leg
			next;
			mes "[Sensei Moohae]";
			mes "让我看看你接下来该见谁……";
			mes "啊……去找图哈长老。";
			mes "他在西北方。";
			close;
		}
		else {
			mes "[Sensei Moohae]";
			mes "你怎么会以为完成了？";
			mes "你没有我要求的物品！";
			mes "5根豪猪刺，";
			mes "20张蜘蛛丝，";
			mes "10条虫腿。";
			mes "这些是我需要的物品，全部找来。";
			close;
		}
	}
	else if (MONK_Q > 9 && MONK_Q < 14) {
		mes "[Sensei Moohae]";
		mes "我已经告诉过你了。";
		mes "去找^CC0000图哈^000000。";
		mes "他在这里的西北方。";
		close;
	}
	else if (MONK_Q > 13 && MONK_Q < 26) {
		mes "[Sensei Moohae]";
		mes "哦，你还在训练吗？";
		mes "快点完成！";
		close;
	}
	else if (MONK_Q > 25 && MONK_Q < 27) {
		mes "[Sensei Moohae]";
		mes "我听说你的训练进展很好。";
		mes "祝你好运并努力工作。你会成为出色的武僧。";
		close;
	}
	else if (MONK_Q == 27 && BaseJob == Job_Acolyte) {
		mes "[Sensei Moohae]";
		mes "……嗯……";
		mes "去找图蒙，从他那里拿一瓶特殊药剂。它看起来像绿色药水，但不是。带给我……";
		close;
	}
	else if (MONK_Q == 28 && BaseJob == Job_Acolyte) {
		if (countitem(506) > 0) {
			mes "[Sensei Moohae]";
			mes "你还带着应该带来的药吗？";
			mes "你必须喝下绿色药水，强化自己以成为武僧。";
		}
		else if (countitem(506) == 0) {
			mes "[Sensei Moohae]";
			mes "你完成任务了吗？很好，你具备成为武僧的条件。";
			mes "你没有把珍贵的药水丢掉吧？";
			next;
			mes "[Sensei Moohae]";
			mes "你之前喝下的药水现在应该起效了。";
			mes "既然你喝了药水，成为武僧的训练即将开始……";
			next;
			mes "[Sensei Moohae]";
			mes "但首先，回答我的问题。";
			mes "你愿意将余生奉献给追求纯洁吗？";
			next;
			if (select("是。:否。") == 2) {
				mes "[Sensei Moohae]";
				mes "....with that kind of reply...";
				mes "你没有成为武僧的决心吗？";
				mes "你觉得自己还没受够苦吗？";
				next;
				mes "[Sensei Moohae]";
				mes "再多想想后回来！";
				mes "我们不能接受被怀疑玷污的武僧……";
				close;
			}
			mes "[Sensei Moohae]";
			mes "你会利用训练获得的能力谋取个人利益吗？";
			next;
			if (select("是。:否。") == 1) {
				mes "[Sensei Moohae]";
				mes "……那我们不能接受你成为武僧。武僧不会为个人利益修行。";
				mes "我们光荣地生活，成为惩罚罪恶的圣洁执行者。";
				next;
				mes "[Sensei Moohae]";
				mes "回去重新思考武僧的意义……";
				mes "以你现在的状态，永远无法成为武僧，会被邪恶玷污……";
				close;
			}
			mes "[Sensei Moohae]";
			mes "你愿意惩罚那些违背";
			mes "veritas和aequitas的人吗？^CCCCCC（真理与正义）^000000";
			next;
			if (select("是。:否。") == 2) {
				mes "[Sensei Moohae]";
				mes "你以为我们武僧是为了谁！";
				mes "违背意志的生物都来自世界的污秽！";
				mes "它们不配存在！";
				next;
				mes "[Sensei Moohae]";
				mes "准备好面对并消灭邪恶后再回来。";
				mes "那时不用我指示，你也会知道下一步该做什么。";
				close;
			}
			mes "[Sensei Moohae]";
			mes "你愿意与目标相同的人合作，并牺牲自己达成目标吗？";
			next;
			if (select("是。:否。") == 2) {
				mes "[Sensei Moohae]";
				mes "你说不……？不可接受……";
				mes "如果能牺牲自己帮助同伴，那才是真正的纯洁。";
				next;
				mes "[Sensei Moohae]";
				mes "回去思考为在乎的人牺牲自己的意义。";
				mes "为他人牺牲看似容易，却是人类最难做到的事。";
				close;
			}
			mes "[Sensei Moohae]";
			mes "你愿意引来怪物跟随自己，以帮助同伴吗？";
			next;
			if (select("是。:否。") == 1) {
				mes "[Sensei Moohae]";
				mes "不可接受。故意挑衅怪物跟随你非常危险，会伤害他人。这不是武僧之道。";
				mes "……这种行为被视为粗心，不能容忍。";
				next;
				mes "[Sensei Moohae]";
				mes "即使硬化身体时几乎无敌，这项技能也只能用于紧急情况，不能如此无礼地使用！";
				next;
				mes "[Sensei Moohae]";
				mes "你可能觉得这是在帮助他人，但事实并非如此。";
				mes "重新思考作为武僧应该为他人做什么。";
				close;
			}
			mes "[Sensei Moohae]";
			mes "你会在城镇或野外一遍遍喊叫相同的内容吗？";
			next;
			if (select("是。:否。") == 1) {
				mes "[Sensei Moohae]";
				mes "不允许这样做。这不只适用于武僧，也适用于所有人。";
				mes "没人想让自己的安宁被打扰！";
				mes "即使你的本意是好的，这也无礼且不被允许。";
				close;
			}
			mes "[Sensei Moohae]";
			mes "在成为圣洁执行者的武僧道路上，你愿意为他人而死吗？";
			next;
			if (select("是。:否。") == 2) {
				mes "[Sensei Moohae]";
				mes "有这种态度无法成为武僧！！！";
				mes "如果牺牲自己能消灭至少一个敌人，这就是我们训练的圣洁执行者对你的期望。";
				next;
				mes "[Sensei Moohae]";
				mes "如果你不愿为在乎的人牺牲自己，";
				mes "又怎能期待达到真正的觉悟？";
				mes "思考生与死的真正意义！！";
				close;
			}
			mes "最后，立誓遵守这些誓言。";
			next;
			if (select("我发誓遵守这些誓言。:呃……不……") == 2) {
				mes "[Sensei Moohae]";
				mes "..............";
				next;
				mes "[Sensei Moohae]";
				mes "那么你的训练还未完成。";
				if (Sex == SEX_MALE)
					mes "孩子，你不会被接纳为武僧。";
				else
					mes "姑娘，你不会被接纳为武僧。";
				next;
				mes "[Sensei Moohae]";
				mes "因此，你的训练将从头开始……";
				next;
				mes "冷静下来……我重新考虑了……也许你还没准备好承担承诺。";
				mes "准备好后再回来……";
				next;
				mes "[Sensei Moohae]";
				if (Sex == SEX_MALE)
					mes "希望你很快明白自己要成为什么，孩子……";
				else
					mes "希望你很快明白自己要成为什么，姑娘……";
				close;
			}
			mes "[Sensei Moohae]";
			mes "那么你的训练完成了……";
			mes "请靠近一些。";
			if (Sex == SEX_MALE)
				mes "兄弟，欢迎你加入我们对抗邪恶的圣战！";
			else
				mes "姐妹，欢迎你加入我们对抗邪恶的圣战！";
			next;
			mes "[Sensei Moohae]";
			if (Sex == SEX_MALE)
				mes "兄弟，你的誓言已被周围所有人听见。";
			else
				mes "姐妹，你的誓言已被周围所有人听见。";
			next;
			mes "[Sensei Moohae]";
			mes "现在我会对你的身体施展终极技巧……";
			next;
			mes "[Sensei Moohae]";
			mes "我会使用古老技巧，通过刺激身体穴位增强你的力量。";
			next;
			mes "[Sensei Moohae]";
			mes "闭上眼睛……";
			next;
			mes "[Sensei Moohae]";
			mes "放松身体……";
			next;
			mes "["+ strcharinfo(0) +"]";
			mes "^00CCCC- You breathe in deeply -^000000";
			next;
			mes "["+ strcharinfo(0) +"]";
			mes "^CC0000- You feel fingers poking you all over your body with swiftness -^000000";
			next;
			mes "[Sensei Moohae]";
			mes "咿——呀哈哈哈哈！！";
			next;
			mes "[Sensei Moohae]";
			mes "哦哦哦啊啊！！！";
			next;
			mes "[Sensei Moohae]";
			mes "咿——呀哈哈哈哈！！";
			next;
			mes "[Sensei Moohae]";
			mes "哈~ 哈~ 哈~！！！！！";
			next;
			mes "[Sensei Moohae]";
			mes ".... now open your eyes......";
			next;
			mes "[Sensei Moohae]";
			mes "....and see life through the eyes of a monk.";
			next;
			set .@jlevel,JobLevel;
			completequest 3032;
			callfunc "Job_Change",Job_Monk;
			callfunc "F_ClearJobVar";
			mes "[Sensei Moohae]";
			mes "....You are a monk.";
			next;
			mes "[Sensei Moohae]";
			mes "...heh.";
			next;
			mes "[Sensei Moohae]";
			mes "嗯……我想我已经老了，做不了那个……年轻时我更厉害……";
			next;
			mes "[Sensei Moohae]";
			mes "...anyways, you are a monk now.";
			mes "欢迎！";
			next;
			mes "[Sensei Moohae]";
			mes "希望你遵守誓言……";
			next;
			mes "[Sensei Moohae]";
			mes "继续你的道路训练并更加努力。";
			next;
			mes "[Sensei Moohae]";
			mes "现在……你可以随风而行。";
			mes "哦，离开前我有礼物给你。";
			if (.@jlevel == 50)
				getitem 1804,1; //Knuckle_Duster_
			else
				getitem 1801,1; //Waghnakh
		}
		close;
	}
	else if (BaseJob == Job_Acolyte) {
		mes "[Sensei Moohae]";
		mes "你是……服事……？";
		mes "如果需要咨询，请去普隆德拉圣所。这里是武僧的地方，不适合你。";
		mes "除非你打算成为武僧……否则请离开。";
		close;
	}
	else if (BaseJob == Job_Monk) {
		mes "[Sensei Moohae]";
		mes "你的修行进展如何？";
		mes "希望你仍在训练并遵守誓言。";
		next;
		mes "[Sensei Moohae]";
		mes "我们必须一生继续训练，坚守道路。";
		mes "否则邪恶会用污秽玷污我们的心。";
		next;
		mes "[Sensei Moohae]";
		mes "别忘记誓言，坚守道路，";
		mes "别让任何邪恶玷污纯洁的心。";
		close;
	}
	else {
		mes "[Sensei Moohae]";
		mes "如果需要咨询，请去普隆德拉圣所。";
		mes "这里没有你感兴趣的东西，请离开，不要打扰其他武僧。";
		close;
	}
}

prt_monk,251,255,1	script	Touha#mk	79,{
	if (MONK_Q >= 10 && MONK_Q < 14) {
		if (MONK_Q == 10) {
			mes "[Touha]";
			mes "你为什么来找我？";
			mes "想和我聊聊吗？";
			next;
			mes "[Touha]";
			mes "哦，我明白了。你正在接受武僧训练。";
			mes "你已经拥有武僧般的精神。";
			next;
			mes "[Touha]";
			mes "从你的样子看来，";
			mes "你已经拜访过茂海大师了。很好。";
			next;
			mes "[Touha]";
			mes "让我告诉你作为武僧必须知道的事。";
			mes "然后我会帮助你强化身体，以承受下一阶段训练。";
			next;
			mes "[Touha]";
			mes "平静心灵。";
			mes "放松身体……准备好了吗？";
			next;
			if (select("是。:否。") == 2) {
				mes "[Touha]";
				mes "准备好后再回来。";
				close;
			}
			mes "[Touha]";
			mes "好……那么。";
			next;
			mes "[Touha]";
			mes "请跟着我重复。";
			next;
			changequest 3024,3025;
		}
		else {
			mes "[Touha]";
			mes "这次请集中注意力……";
			next;
		}
		mes "[Touha]";
		set .@rand,rand(1,3);
		if ((.@rand == 1) || (MONK_Q == 11)) {
			set MONK_Q,11;
			mes "我追寻";
			next;
			mes "[Touha]";
			mes "觉悟之道。";
			next;
			mes "[Touha]";
			mes "我们武僧";
			next;
			mes "[Touha]";
			mes "将忠于";
			next;
			mes "[Touha]";
			mes "我们的信念";
			next;
			mes "[Touha]";
			mes "并帮助保护他人";
			next;
			mes "[Touha]";
			mes "通过";
			next;
			mes "[Touha]";
			mes "一生所学的教诲。";
			next;
			mes "[Touha]";
			mes "因父及子之名";
			next;
			mes "[Touha]";
			mes "及圣神。";
		}
		else if ((.@rand == 2) || (MONK_Q == 12)) {
			set MONK_Q,12;
			mes "我将自己奉献给";
			next;
			mes "[Touha]";
			mes "真理与正义。";
			next;
			mes "[Touha]";
			mes "我将沿着自己的道路";
			next;
			mes "[Touha]";
			mes "走向觉悟与纯洁。";
			next;
			mes "[Touha]";
			mes "我会保护我的";
			next;
			mes "[Touha]";
			mes "兄弟，用我的生命。";
			next;
			mes "[Touha]";
			mes "邪恶永远不会";

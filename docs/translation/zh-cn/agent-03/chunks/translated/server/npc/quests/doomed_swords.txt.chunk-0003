					next;
					mes "[神秘铁匠]";
					mes "我愿意锻造";
					mes "Grimtooth，只要你能";
					mes "证明自己配得上驾驭它的";
					mes "力量，并提供全部";
					mes "制作所需的材料。";
					next;
					mes "[Mysterious Blacksmith]";
					mes "我需要……";
					mes "^0099FF1个Emperium^000000，";
					mes "^0099FF100颗食人魔牙齿^000000，";
					mes "^0099FF10把黑暗之刃^000000，";
					mes "^0099FF5颗诅咒红宝石^000000以及";
					mes "^0099FF1个断裂的剑柄^000000。";
					next;
					mes "[Mysterious Blacksmith]";
					mes "制作这把诅咒之剑不需要";
					mes "Emperium，但我确实";
					mes "需要你证明自己";
					mes "配得上Grimtooth的";
					mes "力量。你真的能";
					mes "驾驭它吗？";
					set dmdswrd_Q2,dmdswrd_Q2 | 16;
					close;
				}
				mes "[神秘铁匠]";
				mes "嗯。你对它了解得太少，";
				mes "我连为你锻造Grimtooth";
				mes "都无法考虑。";
				mes "在再次向我询问之前，";
				mes "你最好先多了解那把剑。";
				mes "";
				close;
			case 3:
				if (dmdswrd_Q2 & 32) {
					mes "[Mysterious Blacksmith]";
					mes "Executioner之剑。";
					mes "让我看看你是否准备好";
					mes "挥舞那把刀刃";
					mes "……";
					next;
					if (countitem(7017) < 2) {
						mes "[Mysterious Blacksmith]";
						mes "嗯。要锻造Executioner，";
						mes "我需要你带来";
						mes "^0099FF2个Executioner's Gloves^000000。";
						mes "";
						close;
					}
					if (countitem(7024) < 10) {
						mes "[Mysterious Blacksmith]";
						mes "要制作剑刃，";
						mes "我至少需要^0099FF10把Bloody Edges^000000。尽快";
						mes "";
						mes "找到它们并";
						mes "带回来。";
						close;
					}
					if (countitem(1008) < 3) {
						mes "[Mysterious Blacksmith]";
						mes "要为Executioner附魔";
						mes "黑暗力量，";
						mes "我需要你带来";
						mes "^0099FF3条Necklaces of Oblivion^000000。";
						mes "";
						mes "去吧，快把它们找来！";
						close;
					}
					if (countitem(609) < 50) {
						mes "[Mysterious Blacksmith]";
						mes "嗯。你忘了带来";
						mes "^0099FF50个护身符^000000。";
						mes "我需要它们注入";
						mes "赋予Executioner";
						mes "可怕力量的惊人能量……";
						mes "";
						close;
					}
					if (countitem(714) < 1) {
						mes "[Mysterious Blacksmith]";
						mes "你带齐了我需要的一切";
						mes "来锻造Executioner，但";
						mes "我仍不确定你是否";
						mes "能够驾驭它的";
						mes "力量。只要你带来";
						mes "^0099FF1个Emperium^000000，便能消除我的疑虑。";
						close;
					}
					if (countitem(7017) > 1 && countitem(7024) > 9 && countitem(1008) > 2 && countitem(609) > 49 && countitem(714) > 0) {
						mes "[Mysterious Blacksmith]";
						mes "很好，我看你已经";
						mes "准备好我要求的全部东西。";
						mes "稍等片刻，";
						mes "我会召唤锻造Executioner所需的";
						mes "黑暗力量……";
						mes "";
						next;
						mes "[Mysterious Blacksmith]";
						mes "我已经很久";
						mes "没见过这把";
						mes "可怕的剑了。现在";
						mes "拿去吧！小心，别让";
						mes "它的嗜血欲望吞噬你！";
						delitem 7017,2; //Executioner's_Mitten
						delitem 7024,10; //Bloody_Edge
						delitem 1008,3; //Frozen_Heart
						delitem 609,50; //Amulet
						getitem 1169,1; //Executioner_
						close;
					}
				}
				else if (dmdswrd_Q2 & 4) {
					mes "[Mysterious Blacksmith]";
					mes "你的意思是，你想要一把";
					mes "被所有因它执行的";
					mes "数千次死刑中丧生的灵魂";
					mes "诅咒过的剑？";
					mes "哈哈哈！真有意思！";
					next;
					mes "[Mysterious Blacksmith]";
					mes "是的……每当这把";
					mes "剑斩杀一个有罪的";
					mes "罪犯，剑刃就会被";
					mes "死者的愤怒与";
					mes "悔恨所诅咒。";
					next;
					mes "[Mysterious Blacksmith]";
					mes "随着时间流逝，Executioner";
					mes "从被它杀死之人的";
					mes "憎恨中积累了真正可怕的力量。";
					mes "不过，使用这把剑的人";
					mes "有被疯狂与憎恨吞噬的危险。";
					next;
					mes "[Mysterious Blacksmith]";
					mes "上一个让我";
					mes "制作这把剑的人要求我";
					mes "摧毁它，因为他害怕";
					mes "它的嗜血欲望会腐蚀他的心智。";
					mes "但如果你认为自己能承受，我或许可以锻造它……";
					next;
					mes "[Mysterious Blacksmith]";
					mes "只要带来……";
					mes "^0099FF50个护身符^000000，";
					mes "^0099FF1个Emperium^000000，";
					mes "^0099FF2个Executioner's Gloves^000000，";
					mes "^0099FF10把Bloody Edges^000000以及";
					mes "^0099FF3条Necklaces of Oblivion^000000。";
					next;
					mes "[Mysterious Blacksmith]";
					mes "这些就是我需要的物品，";
					mes "用来制作一把蕴含";
					mes "邪恶力量的剑。至于Emperium，就把它当成我的测试，看看你是否";
					mes "真的能够挥舞";
					mes "被诅咒的Executioner……";
					set dmdswrd_Q2,dmdswrd_Q2 | 4;
					close;
				}
				mes "[Mysterious Blacksmith]";
				mes "哼。我不认为";
				mes "你已经足够了解";
				mes "Executioner，足以";
				mes "让我为你锻造。你最好";
				mes "进一步了解那把诅咒之剑，";
				mes "如果你真的想要它……";
				close;
			case 4:
				mes "[Mysterious Blacksmith]";
				mes "嗯……？";
				mes "是这样吗？";
				close;
			}
		case 3:
			mes "[Mysterious Blacksmith]";
			mes "哼……";
			mes "那就等你";
			mes "确切知道";
			mes "自己想从我这里得到什么时，";
			mes "再回来吧，冒险者。";
			close;
		}
	}
}

				cutin "nov_lumin03.bmp", 2;
				next;
				cutin "", 255;
				mes "^4d4dff……我必须向信息人员报告结果……^000000。";
				setquest 7477;
				viewpoint 2,45,94,2,0xFF0000;
				close;
			} else {
				mes "除了简单的告示牌，什么也找不到。";
				next;
				select("为什么什么都没有？");
				mes "[Lumin]";
				mes "当然。";
				mes "苍蝇的翅膀就在这里，所以我已经装进包里了。";
				cutin "nov_lumin01.bmp", 2;
				next;
				select("那我能拿一些吗？");
				mes "[Lumin]";
				mes "这不公平，我先到这里，所以它们是我的。";
				mes "如果你想要奖励，最好快点去下一个地点。";
				cutin "nov_lumin03.bmp", 2;
				next;
				mes "[Lumin]";
				mes "好吧，那就……";
				next;
				cutin "", 255;
				mes "Lumin 飘着长发消失了。";
				mes "这个家伙……";
				setquest 7477;
				viewpoint 2,45,94,2,0xFF0000;
				close;
			}
		} else {
			mes "==== 信息 ====";
			mes "普隆德拉原野。";
			mes "普隆德拉城位于北方。";
			close;
		}
	} else {
		mes "==== 信息 ====";
		mes "普隆德拉原野。";
		mes "普隆德拉城位于北方。";
		close;
	}

OnInit:
	questinfo( QTYPE_QUEST, QMARK_NONE, "!isbegin_quest(7477) && isbegin_quest(7474) == 1" );
	end;

OnTouch:
	if (isbegin_quest(7474) == 1 && !isbegin_quest(7477))
		emotion ET_SURPRISE;
	end;
}

izlude_a,45,94,3	duplicate(Bulletin Board#iz)	Bulletin Board#iz_a	4_BULLETIN_BOARD2,3,3
izlude_b,45,94,3	duplicate(Bulletin Board#iz)	Bulletin Board#iz_b	4_BULLETIN_BOARD2,3,3
izlude_c,45,94,3	duplicate(Bulletin Board#iz)	Bulletin Board#iz_c	4_BULLETIN_BOARD2,3,3
izlude_d,45,94,3	duplicate(Bulletin Board#iz)	Bulletin Board#iz_d	4_BULLETIN_BOARD2,3,3

// - Therapist (Red Herb Quest + First Aid)
// - Gives the player a basic quest and teaches them First Aid.
// -----------------------------------------------------------------------------
iz_ac01,59,43,3	script	Therapist#ac	4_M_6THPRIN1,{
	if (!checkweight(1304,3)) {
		mes "由于背包过满，任务无法继续。";
		mes "整理物品后请再试一次。";
		close;
	}
	mes "[Therapist]";
	if (isbegin_quest(4269) == 2) {
		mes "你是学生吗？";
		mes "你的身体有什么问题吗？";
		next;
		.@menu$ = "Help me!:Teach me the First Aid Skill:^ff0000Red Herb Quest^000000:Save Location";
	} else {
		mes "这里是皇家克里图拉学院的医务室。";
		mes "我能帮你什么？";
		next;
		.@menu$ = "Help me!:First Aid Skill::I want to rest.";
	}
	switch(select(.@menu$)) {
	case 1:
		if (BaseLevel <= 20) {
			mes "[Therapist]";
			mes "你受伤了吗？";
			mes "连紧急治疗也对你不起作用吗？";
			next;
			npcskill "AL_HEAL", 3, 50, 60;
			percentheal 0,50;
			mes "[Therapist]";
			mes "这样就够了吗？";
			mes "你恢复了吗？";
			mes "如果你清醒了，就先上床休息再离开。";
			close;
		} else {
			mes "[Therapist]";
			mes "我很同情你，但是……";
			mes "我只能为基础等级 20 以下的人提供免费治疗。";
			mes "反正你看起来也不像快死了。";
			next;
			mes "[Therapist]";
			mes "就在这里休息到恢复为止。";
			mes "这里有很多空床！";
			close;
		}
		break;
	case 2:
		if (getskilllv("NV_FIRSTAID")) {
			mes "[Therapist]";
			mes "你已经知道急救了。";
			mes "我们都很忙。别来打扰我。";
			close;
		} else {
			mes "[Therapist]";
			mes "你做得很好！";
			mes "急救是在紧急情况下将 SP 转换为 HP 的技能。";
			next;
			mes "[Therapist]";
			mes "恢复比例非常低……";
			mes "它能帮你避免死亡，但不会恢复很多 HP。";
			specialeffect2 EF_BEGINSPELL6;
			specialeffect2 EF_SPELLBREAKER;
			next;
			mes "[Therapist]";
			mes "按 ^4d4dffALT + S^000000 打开技能窗口查看技能。";
			skill "NV_FIRSTAID", 1, 0;
			skill_nov = 3;
			getexp 1000,40;
			next;
			mes "[Therapist]";
			mes "如果你按下 ^4d4dffF12^000000……";
			mes "快捷栏窗口会打开，里面有九个小格子可以登记技能。";
			next;
			mes "[Therapist]";
			mes "拖动快捷栏窗口的右下角，可以打开更多技能快捷页。";
			next;
			mes "[Therapist]";
			mes "使用很简单……^4d4dff每个栏位对应 F1 到 F9 的单独按键^000000。";
			mes "登记到对应栏位后，就能立即使用所需技能或物品。";
			next;
			cutin "tutorial05.bmp", 4;
			mes "!- Information -!";
			mes "拖动图标即可将所需物品或技能登记到^4d4dff快捷栏位^000000。";
			next;
			mes "!- Information -!";
			mes "按对应的 F1～F9 按键，即可立即使用或装备^4d4dff快捷栏位中的物品和装备。";
			next;
			mes "!- Information -!";
			mes "设置好^4d4dff快捷键^000000后，就可以使用对应的快捷键。";
			next;
			mes "!- Information -!";
			mes "^4d4dff你可以登记经常使用的物品和技能，方便地使用它们。";
			cutin "", 255;
			next;
			mes "[Therapist]";
			mes "现在打开技能窗口，将[急救]登记为快捷键，然后使用它。";
			mes "你会发现这样使用更加方便。";
			close;
		}
	case 3:
		if (!isbegin_quest(7478)) {
			mes "[Therapist]";
			mes "你调查过原野上生长的植物吗？";
			mes "^4d4dff红色植物、蓝色植物、绿色植物、白色植物^000000等等……";
			next;
			mes "[Therapist]";
			mes "你可以从不同植物中获得各种颜色的草药。";
			mes "加工草药可以制作出各种有用的药水。";
			next;
			mes "[Therapist]";
			mes "现在，我们亲手采集红色草药吧？";
			next;
			mes "[Therapist]";
			mes "学院建筑附近长着一株^4d4dff红色植物^000000。";
			mes "这是我为了今天偷偷种下的。";
			mes "去取得^4d4dff1 个红色草药^000000。";
			setquest 7478;
			close;
		} else if (isbegin_quest(7478) == 1) {
			if (countitem(507) > 0) {
				mes "[Therapist]";
				mes "你拿到了。";
				mes "^4d4dff你可以直接吃掉草药并立即获得效果，但把它制成药水会更有效。^000000";
				next;
				mes "[Therapist]";
				mes "草药的功效会因颜色而异。";
				mes "^4d4dff绿色草药^000000可以解毒。";
				mes "^4d4dff蓝色草药^000000可以恢复 SP。";
				next;
				mes "[Therapist]";
				mes "还有别的吗？";
				mes "嗯，HP 就像这种红色草药一样可以恢复。";
				mes "像这样……制成果汁，再装进瓶子……";
				next;
				mes "[Therapist]";
				mes "这样就成了随时随地都能使用的恢复药水。";
				mes "我把它作为纪念品送给你。";
				mes "我也会给你制作药水的配方。";
				next;
				mes "[Therapist]";
				mes "这是关于简单药水合成的书。";
				mes "使用^4d4dff合成工具或烹饪工具^000000即可轻松制作。";
				completequest 7478;
				getexp 2000,50;
				getitem 569,30;// Novice_Potion
				getitem 11058,1;// Novice_Combi_Book
				getitem 12849,10;// Combination_Kit
				getitem 507,1;// Red_Herb
				getitem 512,1;// Apple
				next;
				mes "[Therapist]";
				mes "不只是药水，其他容易获得的东西也能制作成各种工具。请善加利用。";
				next;
				mes "[Therapist]";
				mes "为了让你尝试制作，我给你一株红色草药和一个苹果，";
				mes "用合成工具制作一下怎么样？";
				next;
				mes "[Therapist]";
				mes "^4d4dff右键点击^000000阅读合成工具，再^4d4dff点击书本形状的图标^000000打开说明窗口。";
				close;
			} else {
				mes "[Therapist]";
				mes "要不要了解一下草药的功效？";
				mes "击败学院建筑附近生长的红色植物，带一株红色草药回来。";
				next;
				mes "[Therapist]";
				mes "你可以在学院入口附近找到它。";
				close;
			}
		} else {
			mes "[Therapist]";
			mes "我已经告诉过你基础医药植物学了。";
			mes "顺便说，米德加尔特有一种叫做^4d4dff闪耀植物^000000的东西。";
			next;
			mes "[Therapist]";
			mes "没人知道这种植物会产出什么草药。";
			mes "我曾经从中得到过世界树果实。";
			next;
			mes "[Therapist]";
			mes "另外，艾尔贝塔商人公会里有一位制作药水的老人。";
			mes "你可以向他求助。";
			next;
			mes "[Therapist]";
			mes "^4d4dff炼金术士^000000、^4d4dff创造者^000000以及更高阶职业^4d4dff基因学者^000000都擅长制作药水。";
			next;
			mes "[Therapist]";
			mes "如果你想要制作精良的药水，找专业人士帮忙是个好主意。";
			close;
		}
	case 4:
		mes "[Therapist]";
		mes "我明白了……";
		mes "为了应对紧急情况，如果你昏倒后想被带回这里，我会保存你当前的位置。";
		savepoint "iz_ac01",45,46,1,1;
		close;
	}

OnInit:
	questinfo( QTYPE_QUEST, QMARK_NONE, "!isbegin_quest(7478) && isbegin_quest(4269) == 2" );
	end;
}

iz_ac01_a,59,43,3	duplicate(Therapist#ac)	Therapist#ac_a	4_M_6THPRIN1
iz_ac01_b,59,43,3	duplicate(Therapist#ac)	Therapist#ac_b	4_M_6THPRIN1
iz_ac01_c,59,43,3	duplicate(Therapist#ac)	Therapist#ac_c	4_M_6THPRIN1
iz_ac01_d,59,43,3	duplicate(Therapist#ac)	Therapist#ac_d	4_M_6THPRIN1

// - Cultivated Red Plant (Red Herb Quest)
// -----------------------------------------------------------------------------
izlude,141,251,0	script	Cultivated Red Plant#0	1078,3,3,{
	end;

OnTouch:
	if (isbegin_quest(7478) == 1 && !isbegin_quest(7479)) {
		specialeffect EF_STEAL;
		emotion ET_SMILE, getnpcid(0, "Academy Student#"+strnpcinfo(2));
		emotion ET_SURPRISE, playerattached();
		donpcevent "Cultivated Red Plant#"+strnpcinfo(2)+"::OnDisable";
	}
	end;

OnDisable:
	disablenpc "Cultivated Red Plant#"+strnpcinfo(2);
	initnpctimer;
	end;

OnTimer30000:
	enablenpc "Cultivated Red Plant#"+strnpcinfo(2);
	stopnpctimer;
	end;
}

izlude_a,141,251,0	duplicate(Cultivated Red Plant#0)	Cultivated Red Plant#a	1078,3,3
izlude_b,141,251,0	duplicate(Cultivated Red Plant#0)	Cultivated Red Plant#b	1078,3,3
izlude_c,141,251,0	duplicate(Cultivated Red Plant#0)	Cultivated Red Plant#c	1078,3,3
izlude_d,141,251,0	duplicate(Cultivated Red Plant#0)	Cultivated Red Plant#d	1078,3,3

// - Academy Student (Red Herb Quest)
// -----------------------------------------------------------------------------
izlude,140,249,7	script	Academy Student#0	4_M_NOV_RUMIN,{
	if (!checkweight(1304,3)) {
		mes "你的背包太满，无法继续这个任务。";
		mes "整理物品后请再试一次。";
		close;
	}
	if (isbegin_quest(7478) == 1 && !isbegin_quest(7479)) {
		specialeffect EF_STEAL, AREA, "Cultivated Red Plant#"+strnpcinfo(2);
		donpcevent "Cultivated Red Plant#"+strnpcinfo(2)+"::OnDisable";
		emotion ET_SURPRISE, playerattached();
		emotion ET_SMILE;
		mes "[Lumin]";
		mes "嘿，乌龟";
		mes "你真的很慢。";
		mes "这株红色植物对你已经没用了。";
		cutin "nov_lumin01.bmp", 2;
		next;
		if (select("你在说什么？", "你是谁？") == 1) {
			mes "[Lumin]";
			mes "你听见我说的了。";
			mes "你不是来为学院治疗师收集红色植物的吗？";
			next;
			mes "[Lumin]";
			mes "但、但刚才发生了奇怪的事。";
			mes "就在我眼前发生的。";
			next;
		} else {
			if (isbegin_quest(7472) > 0 || isbegin_quest(7474) > 1) {
				mes "[Lumin]";
				mes "你失忆了吗？";
				mes "如果船长听说这件事，他会哭的。";
				mes "只要我还记得你，就没关系。";
				cutin "nov_lumin02.bmp", 2;
				next;
			} else {
				mes "[Lumin]";
				mes "Lumin.";
				mes ".......";
				mes "开心一点怎么样？";
				cutin "nov_lumin04.bmp", 2;
				next;
			}
		}
		mes "[Lumin]";
		mes "总之，我来解释一下，我刚刚把这株红色植物的叶子全剪掉了。";
		mes "你再也不能采集这株红色植物了。";
		cutin "nov_lumin02.bmp", 2;
		next;
		select("好，那就给我一株^ff0000红色草药^000000");
		mes "[Lumin]";
		mes "好吧……那么……";
		mes "反正我也不需要它。我已经了解基础医药植物学了。";
		cutin "nov_lumin03.bmp", 2;
		next;
		select("那你为什么要这么做？");
		mes "[Lumin]";
		mes "不是我做的！";
		mes "我只是站在这里。";
		cutin "nov_lumin05.bmp", 2;
		next;
		mes "[Lumin]";
		mes "给，拿着这株红色草药。";
		cutin "nov_lumin01.bmp", 2;
		setquest 7479;
		completequest 7479;
		getitem 507,1;// Red_Herb
		next;
		mes "[Lumin]";
		mes "啊……看，它又长出来了。";
		enablenpc "Cultivated Red Plant#"+strnpcinfo(2);
		close2;
	} else {
		if (Class == Job_Novice) {
			if (isbegin_quest(7478) == 1) {
				mes "[Lumin]";
				mes "我想你应该回去找治疗师。";
				mes "他可能正在等你……";
				cutin "nov_lumin01.bmp", 2;
				close2;
			} else {
				mes "他好像在深思什么。";
				mes "别管他。";
				close;
			}
		} else {
			if (isbegin_quest(7479) == 2) {
				mes "[Criatura Student]";
				mes ".......";
				next;
				mes "这个学生看起来很眼熟……";
				close;
			} else {
				mes "[Criatura Student]";
				mes ".......";
				close;
			}
		}
	}
	cutin "", 255;
	end;

OnInit:
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "!isbegin_quest(7479) && isbegin_quest(7478) == 1" );
	end;
}

izlude_a,140,249,7	duplicate(Academy Student#0)	Academy Student#a	4_M_NOV_RUMIN
izlude_b,140,249,7	duplicate(Academy Student#0)	Academy Student#b	4_M_NOV_RUMIN
izlude_c,140,249,7	duplicate(Academy Student#0)	Academy Student#c	4_M_NOV_RUMIN
izlude_d,140,249,7	duplicate(Academy Student#0)	Academy Student#d	4_M_NOV_RUMIN

// - Instructor Argos (Trick Dead Quest)
// -----------------------------------------------------------------------------
izlude,140,260,3	script	Instructor Argos#iz	4_M_LIEMAN,{
	if (Class != Job_Novice || getskilllv("NV_TRICKDEAD") != 0) {
		mes "[Instructor Argos]";
		mes "呼噜……呼噜……";
		close;
	}
	if (isbegin_quest(15001) == 2) {
		mes "[Instructor Argos]";
		mes "呼噜……呼噜……";
		close;
	}
	if (checkquest(15001,PLAYTIME) == -1) {
		mes "- ……";
		next;
		mes "- 这里躺着一个人";
		mes "- 他几乎没有呼吸。";
		next;
		mes "- 这难道是……？！";
		next;
		mes "- 一场事故……";
		mes "- 不，这是谋杀！";
		mes "- 这里有杀人犯！";
		next;
		mes "- 我对某位老人的坟墓发誓";
		mes "- 我一定会解决这起案件！";
		next;
		mes "[Instructor Argos]";
		mes "哈欠。你是谁，为什么在我旁边制造这么大噪音……";
		next;
		select("你没死？");
		emotion ET_HUK, playerattached();
		mes "[Instructor Argos]";
		mes "死了？！谁……？";
		mes "我？噗哈哈哈！！";
		next;
		emotion ET_SMILE;
		mes "[Instructor Argos]";
		mes "抱歉笑出声了。哈哈哈！";
		mes "只是天气很好，所以我在小睡。";
		next;
		select("但你刚才没有呼吸……");
		mes "[Instructor Argos]";
		mes "啊……那个？";
		mes "难怪你会误会。";
		next;
		mes "[Instructor Argos]";
		mes "我使用了<^ff0000装死^000000>技能，因为不想被怪物或其他人打扰。";
		next;
		mes "[Instructor Argos]";
		mes "我从没想过会有人把我当成真正的尸体。";
		next;
		mes "[Instructor Argos]";
		mes "哦，我明白了……你是刚到这里的新手？";
		next;
		mes "[Instructor Argos]";
		mes "这确实出乎意料，但你想学习<^ff0000装死^000000>吗？";
		next;
		mes "[Instructor Argos]";
		mes "我相信它会对你有帮助。你觉得怎么样？";
		next;
		if (select("对不起，但我很忙。", "我想学！") == 1) {
			mes "[Instructor Argos]";
			mes "真的吗？如果你很忙，那也没关系。";
			mes "我还是继续睡吧。";
			mes "打哈欠……";
			close;
		}
		mes "[Instructor Argos]";
		mes "你做了正确的决定！";
		mes "我想好好教你。";
		emotion ET_BEST;
		next;
		mes "[Instructor Argos]";
		mes "新手不了解自己的潜力，也不知道敌人有多强。";
		next;
		mes "[Instructor Argos]";
		mes "有些新手很勤奋、学习很好……但我想我们不是那种人。";
		next;
		mes "[Instructor Argos]";
		mes "只管迅速行动。";
		mes "有时你会被强大的敌人击败……";
		next;
		mes "[Instructor Argos]";
		mes "嗯？你说得对，这就是我的故事。";
		mes "我已经厌倦了失败。";
		next;
		mes "[Instructor Argos]";

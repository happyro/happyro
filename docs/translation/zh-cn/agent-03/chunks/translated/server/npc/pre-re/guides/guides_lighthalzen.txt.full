lighthalzen,207,310,5	script	Guide#lhz::LhzGuide	852,{
	cutin "ein_soldier",2;
	mes "[莱茵哈特向导]";
	mes "欢迎来到莱茵哈特，";
	mes "这座企业城邦。";
	mes "如果你需要城镇导航，";
	mes "尽管来问我，";
	mes "我会尽最大努力";
	mes "帮助你。";
	set .@loop1,1;
	while (.@loop1) {
		next;
		switch(select("城镇指南:移除小地图标记:注意事项:取消")) {
		case 1:
			mes "[莱茵哈特向导]";
			mes "请注意，我负责提供";
			mes "关于莱茵哈特";
			mes "西区的信息。现在请选择";
			mes "你想进一步了解的";
			mes "地点。";
			mes "";
			if (.@compass_check == 0) {
				next;
				mes "[莱茵哈特向导]";
				mes "不过在此之前，";
				mes "要我";
				mes "标记地点";
				mes "在你的小地图上吗？";
				next;
				if (select("是:否") == 1) set .@compass_check,1;
			}
			set .@loop2,1;
			while(.@loop2) {
				if (.@wait_button_chk == 0) set .@wait_button_chk,1;
				else next;
				switch(select("^FF0000雷根贝勒公司^000000:火车站:警察局:银行:酒店:机场:商人公会:珠宝店:武器商店:百货商店:取消")) {
				case 1:
					mes "[莱茵哈特向导]";
					mes "雷根贝勒公司，";
					mes "黑色波利共和国";
					mes "最大的公司，";
					mes "位于莱茵哈特西北部。";
					mes "总部大楼非常醒目。";
					mes "";
					if (.@compass_check)
						viewpoint 1,102,247,2,0xFF0000;
					break;
				case 2:
					mes "[莱茵哈特向导]";
					mes "火车站";
					mes "位于城镇中心，";
					mes "这里有通往艾因布洛克的";
					mes "直达铁路。";
					if (.@compass_check)
						viewpoint 1,233,164,3,0xFF00FF;
					break;
				case 3:
					mes "[莱茵哈特向导]";
					mes "警察局就在城镇中心";
					mes "正北方。";
					mes "如发现可疑人员或活动，";
					mes "请不要犹豫，立即报告；";
					mes "如遇到任何问题，";
					mes "也可以告诉我们。";
					if (.@compass_check)
						viewpoint 1,236,276,4,0x99FFFF;
					break;
				case 4:
					mes "[莱茵哈特向导]";
					mes "银行位于";
					mes "莱茵哈特警察局";
					mes "正对面，";
					mes "这其实是个不错的安排，";
					mes "至少我是这么想的。^FFFFFFspacer^000000";
					if (.@compass_check)
						viewpoint 1,198,257,5,0x0000FF;
					break;
				case 5:
					mes "[莱茵哈特向导]";
					mes "酒店位于";
					mes "南广场中央。";
					mes "凭借优质服务和";
					mes "豪华住宿条件，酒店";
					mes "非常受欢迎。";
					if (.@compass_check)
						viewpoint 1,159,133,6,0x00FF00;
					break;
				case 6:
					mes "[莱茵哈特向导]";
					mes "机场位于中央大道";
					mes "最西侧。";
					mes "乘坐飞艇，";
					mes "可以前往黑色波利共和国";
					mes "的任何地方。";
					if (.@compass_check)
						viewpoint 1,267,75,7,0x00FF00;
					break;
				case 7:
					mes "[莱茵哈特向导]";
					mes "商人公会位于莱茵哈特";
					mes "西南部。";
					mes "";
					if (.@compass_check)
						viewpoint 1,74,53,8,0xFF99FF;
					break;
				case 8:
					mes "[莱茵哈特向导]";
					mes "珠宝店";
					mes "位于南广场";
					mes "正西方。";
					if (.@compass_check)
						viewpoint 1,93,110,9,0xFF9900;
					break;
				case 9:
					mes "[莱茵哈特向导]";
					mes "武器商店";
					mes "位于中央大道";
					mes "尽头。";
					mes "如果你认真考虑";
					mes "在这里冒险，";
					mes "至少值得去看看。";
					if (.@compass_check)
						viewpoint 1,196,46,10,0x330033;
					break;
				case 10:
					mes "[莱茵哈特向导]";
					mes "百货商店位于";
					mes "莱茵哈特中心，";
					mes "是最大、最方便的";
					mes "购物地点，";
					mes "几乎什么都能买到。";
					if (.@compass_check)
						viewpoint 1,199,163,11,0xFFFF00;
					break;
				case 11:
					mes "[莱茵哈特向导]";
					mes "如果不想继续显示";
					mes "小地图标记，请让我";
					mes "‘移除小地图标记’，";
					mes "即可取消显示";
					mes "地点标记。";
					set .@loop2,0;
				}
			}
			break;
		case 2:
			viewpoint 2,102,247,2,0xFF0000;
			viewpoint 2,233,164,3,0xFF00FF;
			viewpoint 2,236,276,4,0x99FFFF;
			viewpoint 2,198,257,5,0x0000FF;
			viewpoint 2,159,133,6,0x00FF00;
			viewpoint 2,267,75,7,0x00FF00;
			viewpoint 2,74,53,8,0xFF99FF;
			viewpoint 2,93,110,9,0xFF9900;
			viewpoint 2,196,46,10,0x330033;
			viewpoint 2,199,163,11,0xFFFF00;
			set .@compass_check,0;
			break;
		case 3:
			mes "[莱茵哈特向导]";
			mes "魔法与科技的进步";
			mes "让我们更新了信息";
			mes "系统，可以在小地图上";
			mes "标记地点，";
			mes "方便导航。";
			mes "方便导航。";
			next;
			mes "[莱茵哈特向导]";
			mes "你的小地图位于";
			mes "屏幕右上角。";
			mes "如果看不到，";
			mes "请按 Ctrl + Tab";
			mes "或点击基本信息窗口中的‘地图’按钮。";
			next;
			mes "[莱茵哈特向导]";
			mes "在小地图上，";
			mes "点击‘+’和‘-’";
			mes "符号可以放大或";
			mes "缩小小地图。希望你";
			mes "在莱茵哈特";
			mes "旅途愉快。";
			break;
		case 4:
			mes "[莱茵哈特向导]";
			mes "莱茵哈特由铁路";
			mes "分为东区和西区，";
			mes "铁路正好穿过城镇中央。";
			mes "";
			mes "总有卫兵";
			mes "值守维护和平。";
			next;
			mes "[莱茵哈特向导]";
			mes "如发现任何";
			mes "可疑活动或人员，";
			mes "请立即向我们报告。";
			mes "希望你能享受";
			mes "这座美丽的城市，冒险者。";
			close2;
			set .@loop1,0;
		}
	}
	cutin "ein_soldier",255;
	end;
}

lighthalzen,220,311,3	duplicate(LhzGuide)	Guide#2lhz	852

lighthalzen,154,100,5	duplicate(LhzGuide)	Guide#3lhz	852

lighthalzen,307,224,3	duplicate(LhzGuide)	Guide#4lhz	852

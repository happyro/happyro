				mes "你目前登记了……"+Val09Rings+" 枚戒指。";
				mes "以及……";
				next;
				mes "[情人节投票管理者]";
				mes "当前记录显示……"+$Val09name_M$+" 是男性票选冠军，共登记 "+$Val09votes_M+" 枚戒指。";
				next;
				mes "[情人节投票管理者]";
				mes "当前记录显示……"+$Val09name_F$+" 是女性票选冠军，共登记 "+$Val09votes_F+" 枚戒指。";
				next;
				break;

			case 3:
				mes "[情人节投票管理者]";
				mes "嘿，你也可以受欢迎！";
				mes "真的，任何人都可以！";
				mes "虽然要更加努力，但还是有机会~哈哈哈！";
				close;
		}
	}
}


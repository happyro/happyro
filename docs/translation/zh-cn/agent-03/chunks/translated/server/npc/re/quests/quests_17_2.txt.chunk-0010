		next;
		mes "漫长的冒险结束时，那个站在王座前的年轻人由我亲手引导。";
		next;
		mes "知晓未被选择之人的悲伤，也知晓无法挽回的过去之痛。";
		next;
		mes "我知道你会站在未来的道路上，你并不鲁莽，也懂得寻求帮助。";
		next;
		mes "你会成为一位伟大的国王。";
		ep17_2_main = 35;
		completequest 18021;
		close2;
		cutin "",255;
		removespecialeffect2 EF_DEVIL10;
		end;
	}
	end;
}

prt_cas,140,344,3	script	Chamberlain Bell#ep172	4_M_RUSMAN1,{
	if (ep17_2_main < 35)
		end;
	mes "[Bell]";
	mes "我一直在等你回来。";
	mes "我该带你去哪儿？";
	next;
	if (select( "出去。", "交谈。" ) == 2) {
		mes "[Bell]";
		mes "我完全没想到事情会变成这样。";
		close;
	}
	mes "[Bell]";
	mes "那么，我们走吧。";
	close2;
	warp "prt_cas",215,160;
	end;
}

prt_cas,325,263,3	script	Nyhill M. Heine#ep172	4_EP17_NIHIL_K,{
	if (ep17_2_main < 35)
		end;
	if (ep17_2_main == 35) {
		cutin "ep171_nihil01",2;
		mes "[Nyhill]";
		mes "真是位意外的访客！";
		mes "我没想到我们会这样见面。";
		mes "谢谢你百忙之中前来。";
		next;
		select( "你穿那身很好看。" );
		mes "[Nyhill]";
		mes "我感觉像穿着别人的衣服……";
		mes "我还在怀疑自己是否真的能做到。";
		mes "我的意思是，真的没问题吗？";
		next;
		select( "你会做得很好。" );
		cutin "ep171_nihil02",2;
		mes "[Nyhill]";
		mes "既然你这么说，那我就相信你。";
		mes "如果有一天我走上歧途，你会阻止我，对吧？";
		next;
		mes "[Nyhill]";
		mes "我相信你会。";
		mes "因为你是个正直的人。";
		mes "还有……";
		next;
		mes "[Nyhill]";
		mes "你想休息时随时都可以。";
		mes "毕竟，你不是一个人。";
		ep17_2_main = 36;
		setquest 18020;
		completequest 18020;
		close3;
	}
	cutin "ep171_nihil01",2;
	mes "[Nyhill]";
	mes "我现在只能见你一会儿。";
	mes "我很快就要接过国王的责任。";
	next;
	cutin "ep171_nihil02",2;
	mes "[Nyhill]";
	mes "所以，请保重身体。如果有一天你需要帮助，我会竭尽全力帮助你。";
	close3;
}

// End of main quest


ba_in01,14,257,5	script	Automatic Doll Guard Beta#172_hangar_0	4_EP17_GUARD_B,{
	npctalk "不用担心。这里守卫森严。";
	end;
}

ba_in01,30,252,5	script	Automatic Doll Guard Beta#ep172_hangar_1	4_EP17_GUARD_B,{
	npctalk "我们全天24小时监控。";
	end;
}

ba_in01,30,248,3	script	Automatic Doll Guard Beta#ep172_hangar_2	4_EP17_GUARD_B,{
	npctalk "放心吧。人偶甚至不用眨眼就能监视这里。", "Automatic Doll Guard Beta#ep172_hangar_1";
	end;
}



// Sidequest quest : Exploring bathhouse - Step 1
ba_in01,384,38,3	script	Shrine#172ba01	4_EP17_BUCKETS,5,5,{
	if (ep17_2_main < 10) {
		mes "[Shrine]";
		mes "抱歉，浴场因内部情况暂时关闭，我们无法保证重新开放的时间。请稍后再来。如果你想安静地洗澡，请使用客房内提供的私人浴室。";
		close;
	}
	if (ep17_2_bath == 0) {
		cloakoffnpcself( "Rookie#172ba01" );
		cloakoffnpcself( "Denny#172ba01" );
		cloakoffnpcself( "Molar#172ba01" );
		cloakoffnpcself( "Canine#172ba01" );
		cloakoffnpcself( "Danae#172ba01" );
		cloakoffnpcself( "Magenta#172ba01" );
		cloakoffnpcself( "Cyan#172ba01" );
		cutin "ep172_beta",2;
		mes "[Shrine]";
		mes "抱歉。瓦尔蒙特宅邸的规定是不让访客遭遇^0000CD危险情况^000000。请再等一会儿。";
		npctalk "为什么搜索要花这么久？让我们进去。我能更快找到它。", "Denny#172ba01", bc_self;
		npctalk "我们是这方面的专家。", "Molar#172ba01", bc_self;
		next;
		cutin "",255;
		mes "[Magenta]";
		mes "不要把危险藏在心里，请告诉我们。";
		npctalk "我们站在这里的时间正在流逝。", "Canine#172ba01", bc_self;
		next;
		cutin "ep172_beta",2;
		mes "[Shrine]";
		mes "抱歉，我们还没查清楚。搜索是为了调查风险因素是否存在。请再等一会儿。这是必要流程，希望你能理解。";
		npctalk "如果出了问题，我会追究你的责任！", "Cyan#172ba01", bc_self;
		npctalk "我们也有自己的流程！你正在妨碍行动！", "Denny#172ba01", bc_self;
		next;
		mes "[Shrine]";
		mes "我再说一次，确认安全之前你不能进去。收到同事的消息后我会满足你的请求。";
		next;
		cutin "16loo_01",2;
		mes "[Rookie]";
		mes "我们被要求尽可能与宅邸的自动人偶合作。但如果你们最后仍不行动，我们也只能使用武力，对吧？";
		next;
		if (select( "新手？发生什么事了？", "看起来很复杂，我还是先不管了。" ) == 2) {
			cutin "ep172_beta",2;
			mes "[Shrine]";
			mes "那么，我们只能叫卫兵了。";
			next;
			cutin "16loo_03",2;
			mes "[Rookie]";
			mes "嗯……我该拿这个怎么办？";
			close3;
		}
		cutin "16loo_02",2;
		mes "[Rookie]";
		mes "哦，冒险家也在这里。如果你是来洗澡的，恐怕暂时还不能使用。看，那个人偶挡住了入口。";
		next;
		cutin "ep172_beta",2;
		mes "[Shrine]";
		mes "这里有鬼出来，你也要小心。";
		next;
		select( "鬼？？" );
		cutin "16loo_01",2;
		mes "[Rookie]";
		mes "我还不知道那是什么。你也知道，我们进入宅邸后，所有人都分散去检查设施了。";
		mes "去浴场检查幻影残留的侦察队回来了，但都死了。^0000CD浴场里有某种东西^000000。";
		npctalk "不是鬼，只是围绕宅邸的阴谋！", "Denny#172ba01", bc_self;
		npctalk "是鬼。一定是鬼！", "Magenta#172ba01", bc_self;
		npctalk "里面有东西。太可怕了。我好兴奋！", "Cyan#172ba01", bc_self;
		next;
		cutin "16loo_02",2;
		mes "[Rookie]";
		mes "我必须查清里面到底是什么，是不是幻影的恶作剧，所以这次让^0000CDGonie^000000进去。独自行动最适合悄悄调查。";
		next;
		select( "那你为什么在这里……？" );
		cutin "16loo_01",2;
		mes "[Rookie]";
		mes "嗯……Gonie进去已经有一段时间了，却还没出来。像Gonie这样强大的人超过时限还没出来，就说明出问题了。";
		next;
		mes "[Rookie]";
		mes "我来遵循流程，查明那个危险的东西是什么，因为我确定存在未知风险。我们不能让未知风险干扰在这座宅邸的任务。";
		npctalk "里面有东西吗？", "Danae#172ba01", bc_self;
		next;
		cutin "16loo_03",2;
		mes "[Rookie]";
		mes "我们派进去的队伍失败了……我们应该更谨慎。而且你也看到了，他们挡住了我们。";
		npctalk "Gonie只是普通战力吗？在这种时候损失他太可惜了。", "Molar#172ba01", bc_self;
		npctalk "他还活着。这是我的直觉！", "Denny#172ba01", bc_self;
		npctalk "我们快进去找他。冒险家也在这里，我们能更快找到他！", "Magenta#172ba01", bc_self;
		next;
		cutin "ep172_beta",2;
		mes "[Shrine]";
		mes "抱歉，我们还在搜索。结束后请听取结果再做决定。";
		next;
		cutin "16loo_01",2;
		mes "[Rookie]";
		mes "宅邸现在存在某些危险。是否还有更多危险，对我们来说非常重要。";
		next;
		mes "[Rookie]";
		mes "我们首先要确认风险来自超自然现象，还是来自^0000CD幻影^000000。你能告诉我更多吗？这也许就是幻影来到宅邸的原因。";
		mes "否则，它很可能会落入他们手中。";
		next;
		cutin "ep172_beta",2;
		mes "[Shrine]";
		mes "我完全明白你的意思。但流程……";
		mes "哦！去搜索的人回来了。和他们谈谈。";
		next;
		cloakoffnpcself( "Boiler#172ba01" );
		cloakoffnpcself( "Sweep#172ba01" );
		cutin "ep172_beta",0;
		mes "[Boiler]";
		mes "不对，你们全都错了。没有危险。";
		next;
		cutin "ep172_beta",1;
		mes "[Sweep]";
		mes "没有听说有访客死亡。他们真的进去了吗？";
		npctalk "不！怎么会！你们甚至可能不知道他们管理下潜藏的危险！", "Denny#172ba01", bc_self;
		npctalk "很多人都看到了。", "Cyan#172ba01", bc_self;
		next;
		cutin "16loo_01",2;
		mes "[Rookie]";
		mes "里面真的没有失踪人员吗？";
		next;
		cutin "ep172_beta",1;
		mes "[Sweep]";
		mes "也许他逃跑了。";
		npctalk "你只是被骗了。", "Boiler#172ba01", bc_self;
		next;
		cutin "16loo_01",2;
		mes "[Rookie]";
		mes "如果是那样，我早就回来了。即使不是，我也相信分散在宅邸各处的队伍会联系我。";
		next;
		select( "有什么猜测吗？" );
		cutin "ep172_beta",2;
		mes "[Shrine]";
		mes "在你说的这些事中，最可疑的是入侵者的行动。";
		next;
		cutin "ep172_beta",0;
		mes "[Boiler]";
		mes "Shrine，不是那个吗？那头长长的深绿色^0000CD头发^000000。它很久以前就出现了。";
		npctalk "头发……有这种可能。它和浴场里任何东西都不匹配。", "", bc_self;
		next;
		select( "头发？" );
		cutin "ep172_beta",2;
		mes "[Shrine]";
		mes "正如Boiler所说。很久以前就经常发现不明头发。也许这头发和浴场的未知危险是同一个东西。";
		npctalk "你现在在说什么？", "Denny#172ba01", bc_self;
		next;
		cutin "ep172_beta",1;
		mes "[Sweep]";
		mes "我觉得最好让人类访客进去自行搜索。";
		mes "我们没有察觉未知危险，也没找到人类访客。也许是因为我们没有人类的感知能力。";
		next;
		cutin "ep172_beta",0;
		mes "[Boiler]";
		mes "你说得对。人类拥有感知能力。也许我们能发现作为自动人偶时遗漏的东西，也许这次能确认那是谁的头发。";
		next;
		cutin "ep172_beta",1;
		mes "[Sweep]";
		mes "我们听说过失踪人员的特征，但我相信人类访客更可能认出他们。";
		npctalk "这里有一个会思考的自动人偶。", "Cyan#172ba01", bc_self;
		next;
		cutin "ep172_beta",2;
		mes "[Shrine]";
		mes "......that makes sense. All right.";
		mes "从现在起，我们会向访客开放浴场。搜索时请特别注意，因为目前有情况和证词怀疑存在未知生物。";
		next;
		mes "[Shrine]";
		mes "如果你在浴场内看到怪物，请不要急着接触它，并告诉附近的人偶。如果寻找失踪人员时需要帮助，请告诉我。";
		next;
		mes "[Shrine]";
		mes "那么，我带你进去。";
		npctalk "他们互相打了起来，然后突然……", "Denny#172ba01", bc_self;
		next;
		mes "[Shrine]";
		mes "在我们进去之前，我想问你一件事。";
		mes "冥想大浴场禁止使用^CC0000水球术和圣水术^000000等技能。";
		mes "希望你能理解。";
		next;
		cutin "",255;
		mes "[Magenta]";
		mes "那个……你知道，Lucky。呃……呃……别误会。Lucky留在这里不是更好吗？";
		npctalk "没错。我们会去找Gonie。你最好留在这里。", "Cyan#172ba01", bc_self;
		next;
		cutin "16loo_01",2;
		mes "[Rookie]";
		mes "你在说什么？我很擅长寻找失物。虽然我不够格执行实地任务，但至少能保护自己。你就这么不信任我吗？";
		next;
		cutin "",255;
		mes "[Magenta]";
		mes "不！！Lucky你最棒！最棒！！你知道我们真的不能没有Lucky！但是……";
		next;
		cutin "16loo_01",2;
		mes "[Rookie]";
		mes "好。我会留下。那我去看看入口区域。反正我也得确认谁进谁出。浴场只有一个入口。";
		next;
		select( "我和你一起去。" );
		cutin "16loo_02",2;
		mes "[Rookie]";
		mes "有冒险家和我们在一起，真让人安心。";
		mes "那么，进出都走<NAVI>[内部]<INFO>ba_bath,165,43,0,101,0</INFO></NAVI>。如果发现什么，我们会发出信号。";
		ep17_2_bath = 1;
		setquest 17363;
		close2;
		cutin "",255;
		cloakonnpcself( "Rookie#172ba01" );
		cloakonnpcself( "Denny#172ba01" );
		cloakonnpcself( "Molar#172ba01" );
		cloakonnpcself( "Canine#172ba01" );
		cloakonnpcself( "Danae#172ba01" );
		cloakonnpcself( "Magenta#172ba01" );
		cloakonnpcself( "Cyan#172ba01" );
		cloakonnpcself( "Boiler#172ba01" );
		cloakonnpcself( "Sweep#172ba01" );
		end;
	}
	if (ep17_2_bath < 13) {
		mes "[Shrine]";
		mes "请前往<NAVI>[内部]<INFO>ba_bath,165,43,0,101,0</INFO></NAVI>。如果你在浴场内看到怪物，请不要急着接触它，并告诉附近的人偶。";
		navigateto("ba_bath",165,43);
		next;
		mes "^EE0000[ ��Caution�� ]^000000";
		mes "为保护和管理设施，冥想大浴场禁止使用^CC0000水球术和圣水术^000000等技能。";
		close;
	}
	mes "[Shrine]";
	mes "你好。请随意使用浴场，舒适地缓解疲劳。";
	next;
	mes "^EE0000[ ��Caution�� ]^000000";
	mes "为保护和管理设施，冥想大浴场禁止使用^CC0000水球术和圣水术^000000等技能。";
	close;

OnTouch:
	if (ep17_2_main >= 9 && ep17_2_bath == 0) {
		cloakoffnpcself( "Rookie#172ba01" );
		cloakoffnpcself( "Denny#172ba01" );
		cloakoffnpcself( "Molar#172ba01" );
		cloakoffnpcself( "Canine#172ba01" );
		cloakoffnpcself( "Danae#172ba01" );
		cloakoffnpcself( "Magenta#172ba01" );
		cloakoffnpcself( "Cyan#172ba01" );
		end;
	}
	end;

OnInit:
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "ep17_2_main >= 9 && ep17_2_bath == 0" );
	end;
}

ba_in01,381,39,5	duplicate(dummy_cloaked_npc)	Rookie#172ba01	4_M_ROOKIE
ba_in01,379,36,7	duplicate(dummy_cloaked_npc)	Danae#172ba01	4_F_REBELLION2
ba_in01,385,41,3	duplicate(dummy_cloaked_npc)	Canine#172ba01	4_F_REBELLION3
ba_in01,383,41,5	duplicate(dummy_cloaked_npc)	Denny#172ba01	4_M_REBELLION3
ba_in01,379,42,5	duplicate(dummy_cloaked_npc)	Magenta#172ba01	4_M_GUNSLINGER2
ba_in01,379,38,5	duplicate(dummy_cloaked_npc)	Molar#172ba01	4_M_REBELLION
ba_in01,383,36,7	duplicate(dummy_cloaked_npc)	Cyan#172ba01	4_F_REBELLION3
ba_in01,384,40,3	duplicate(dummy_cloaked_npc)	Boiler#172ba01	4_EP17_BASIC_B
ba_in01,385,37,3	duplicate(dummy_cloaked_npc)	Sweep#172ba01	4_EP17_CLEANER

// Sidequest quest : Exploring bathhouse - Step 2, 5
ba_bath,165,43,3	script	Shrine#172ba02	4_EP17_BUCKETS,5,5,{
	if (checkweight(1201,3) == 0) {
		mes "你持有的物品数量太多，无法继续对话。";
		mes "请整理背包后再试。";
		close;
	}
	if (ep17_2_bath == 0) {
		cutin "ep172_beta",0;
		mes "[Shrine]";
		mes "瓦尔蒙特宅邸的浴场早已闻名遐迩。瓦尔蒙特很重视在疲惫的一天结束后休息。";
		next;
		mes "[Shrine]";
		mes "他喜欢泡澡，因为泡澡能缓解疲劳、为明天补充活力、整理思绪，还能改善血液循环并补充皮肤水分。";
		next;
		mes "[Shrine]";
		mes "由于他对各种沐浴方式感兴趣，浴场不断扩建，最终达到今天的规模。宅邸访客使用浴场后都称赞其设施。";
		next;
		mes "[Shrine]";
		mes "因此，宅邸浴场变得非常有名。希望你能在这座历史悠久的浴场恢复精神。";
		close3;
	}
	if (ep17_2_bath == 1) {
		cloakoffnpcself( "Rookie#172ba02" );
		cloakoffnpcself( "Denny#172ba02" );
		cloakoffnpcself( "Molar#172ba02" );
		cloakoffnpcself( "Canine#172ba02" );
		cloakoffnpcself( "Danae#172ba02" );
		cloakoffnpcself( "Magenta#172ba02" );
		cloakoffnpcself( "Cyan#172ba02" );
		cutin "ep172_beta",0;
		mes "[Shrine]";
		mes "请过来，你的队伍已经到了。";
		next;
		cutin "16loo_01",2;
		mes "[Rookie]";
		mes "大家都到齐了吗？两人一组，按照流程搜索危险物品和失踪人员。发现任何东西就发送信号，集合地点在休息室。";
		next;
		cutin "16loo_03",2;
		mes "[Rookie]";
		mes "我们应该重点搜索危险物品，而不是失踪人员。危险存在的身份尚未确定，各种证词和情况推测它可能是人类、怪物、自动人偶或超自然生物。";
		next;
		cutin "16loo_01",2;
		mes "[Rookie]";
		mes "Denny和Canine。人类可能是单个或成群的幻影残留，也可能是第三方。他们也可能使用了已知出口之外的其他出口，所以请仔细检查设施。";
		npctalk "好。", "Denny#172ba02", bc_self;
		npctalk "我们走。", "Canine#172ba02", bc_self;
		next;
		cloakonnpcself( "Denny#172ba02" );
		cloakonnpcself( "Canine#172ba02" );
		mes "[Rookie]";
		mes "Cyan和Danae。接下来是怪物。这里是浴场，所以应该有水生怪物或类似的东西。重点检查浴池和管道。";
		npctalk "交给我吧。", "Cyan#172ba02", bc_self;
		npctalk "收到！", "Danae#172ba02", bc_self;
		next;
		cloakonnpcself( "Cyan#172ba02" );

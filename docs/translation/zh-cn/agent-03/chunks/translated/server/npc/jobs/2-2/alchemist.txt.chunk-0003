			mes "[达尔文]";
			mes "你在哪里找到的？！";
			mes "那朵在月光下";
			mes "缓缓绽放的花。";
			mes "它真美……！";
			mes "我从没见过这样的花。";
			next;
			mes "[Darwin]";
			mes "那、那朵花……";
			mes "请让我看看。";
			mes "幻影之花！";
			mes "呜啊啊啊啊！！";
			next;
			mes "[Darwin]";
			mes "你能否把这朵花";
			mes "送给我？";
			mes "我确定这就是我一直寻找的月光花！";
			next;
			if (select("抱歉，我不能给你。:我就是带来送你的。") == 1) {
				mes "[Darwin]";
				mes "我明白。";
				mes "你不能把如此珍贵的";
				mes "花送给随便什么人。";
				mes "嗯……没关系。";
				mes "我会理解的。";
				next;
				mes "[Darwin]";
				mes "它只是勾起了旧回忆。我一开始就不该开口。总之，请带来实验所需的东西。";
				next;
				mes "[Darwin]";
				mes "请把那朵花放到别处。";
				mes "它勾起了太多回忆……";
				mes "我需要冷静。";
				close;
			}
			mes "[Darwin]";
			mes "你是";
			mes "认真的吗？！";
			mes "谢谢你！";
			mes "如此珍贵的花。";
			mes "啊，哈莫娜，我的爱……";
			next;
			mes "[Darwin]";
			mes "是的……";
			mes "我会报答你的。";
			mes "我会把所有炼金术知识直接植入你的脑海……";
			next;
			mes "[Darwin]";
			mes "睁大眼睛，";
			mes "看着我的眼睛！！";
			mes "直到最后都不要停！！";
			next;
			mes "Lorem ipsum dolor sit amet,";
			next;
			mes "Lorem ipsum dolor sit amet,";
			mes "consectetuer adipiscing elit.";
			next;
			mes "Lorem ipsum dolor sit amet,";
			mes "consectetuer adipiscing elit.";
			mes "Aenean fermentum ullamcorper.";
			next;
			mes "Lorem ipsum dolor sit amet,";
			mes "consectetuer adipiscing elit.";
			mes "Aenean fermentum ullamcorper.";
			mes "Vestibulum ante ipsum primis in";
			next;
			mes "Lorem ipsum dolor sit amet,";
			mes "consectetuer adipiscing elit.";
			mes "Aenean fermentum ullamcorper.";
			mes "Vestibulum ante ipsum primis in";
			mes "faucibus orci luctus et ultrices";
			next;
			mes "Lorem ipsum dolor sit amet,";
			mes "consectetuer adipiscing elit.";
			mes "Aenean fermentum ullamcorper.";
			mes "Vestibulum ante ipsum primis in";
			mes "faucibus orci luctus et ultrices";
			mes "posuere cubilia Curae; Morbi";
			next;
			mes "Lorem ipsum dolor sit amet,";
			mes "consectetuer adipiscing elit.";
			mes "Aenean fermentum ullamcorper.";
			mes "Vestibulum ante ipsum primis in";
			mes "faucibus orci luctus et ultrices";
			mes "posuere cubilia Curae; Morbi";
			mes "massa, fermentum vitae...";
			next;
			delitem 710,1; //Illusion_Flower
			mes "[Darwin]";
			mes "^666666*Gasp...*^000000";
			mes "你现在是";
			mes "炼金术士了！！";
			mes "去联盟";
			mes "抛弃最后的";
			mes "商人生活痕迹吧！！";
			set ALCH_Q,40;
			changequest 2033,2034;
			close;
		}
		else if (countitem(7134) > 2 && countitem(713) > 2 && countitem(507) > 0 && countitem(508) > 0 && countitem(509) > 0) {
			mes "[Darwin]";
			mes "看来你已经准备好一切。按约定，我会教你制作简单药剂。";
			next;
			mes "[Darwin]";
			mes "首先准备药碗。然后像这样把草药放进去，慢慢捣碎。";
			next;
			mes "[Darwin]";
			mes "倒入少量";
			mes "净水并搅拌";
			mes "直到混合物变稠。";
			mes "之后再加入一些草药。";
			next;
			mes "[Darwin]";
			mes "这就是制作方法。如果觉得分量足够，就把混合物轻轻倒入空瓶。";
			delitem 7134,3; //Medicine_Bowl
			delitem 713,3; //Empty_Bottle
			delitem 507,1; //Red_Herb
			delitem 508,1; //Yellow_Herb
			delitem 509,1; //White_Herb
			next;
			mes "[Darwin]";
			mes "好了，";
			mes "完成了。";
			mes "现在用我刚才解释的";
			mes "简单步骤";
			mes "制作一些药剂。";
			next;
			switch(select("准备药碗。:把药碗顶在头上。:踢药碗。")) {
			case 1:
				break;
			case 2:
				set .@w_point,.@w_point+1;
				mes "[Darwin]";
				mes "什么……？";
				next;
				break;
			case 3:
				set .@w_point,.@w_point+1;
				mes "[Darwin]";
				mes "不！";
				next;
				break;
			}
			switch(select("把泥土放进药碗。:把草药放进药碗。:把竖琴放进药碗。")) {
			case 1:
				set .@w_point,.@w_point+1;
				mes "[Darwin]";
				mes "...Eh!?";
				mes "那不是";
				mes "药剂！";
				next;
				break;
			case 2:
				break;
			case 3:
				set .@w_point,.@w_point+1;
				mes "[Darwin]";
				mes "竖琴？";
				mes "你要怎么";
				mes "做那种事？";
				next;
				break;
			}
			switch(select("捣碎草药。:捣碎药碗。:踩达尔文的脚。")) {
			case 1:
				break;
			case 2:
				set .@w_point,.@w_point+1;
				mes "[Darwin]";
				mes "你、你在";
				mes "做什么！？";
				next;
				break;
			case 3:
				set .@w_point,.@w_point+1;
				mes "[Darwin]";
				mes "啊……！";
				mes "你到底在";
				mes "做什么？！";
				mes "快停下！";
				next;
				break;
			}
			switch(select("喷洒净水。:喝净水。:倒入净水。")) {
			case 1:
				set .@w_point,.@w_point+1;
				mes "[Darwin]";
				mes "咦？";
				mes "你在做什么？";
				next;
				break;
			case 2:
				set .@w_point,.@w_point+1;
				mes "[Darwin]";
				mes "等、等等……";
				mes "你是在";
				mes "休息吗？";
				next;
				break;
			case 3:
				break;
			}
			switch(select("继续捣碎草药。:继续吃草药。:继续唱歌跳舞。")) {
			case 1:
				break;
			case 2:
				set .@w_point,.@w_point+1;
				mes "[Darwin]";
				mes "吃草药？";
				mes "我觉得你需要";
				mes "专注于";
				mes "眼前的任务……";
				next;
				break;
			case 3:
				set .@w_point,.@w_point+1;
				mes "[Darwin]";
				mes "唱歌跳舞？炼金术士";
				mes "不会做那种事，";
				mes "你疯了吗？";
				mes "请清醒一点。";
				next;
				break;
			}
			switch(select("放入面条并煎炒。:倒入空瓶。:拿着药碗把它喝掉。")) {
			case 1:
				set .@w_point,.@w_point+1;
				mes "[Darwin]";
				mes "我们是炼金术士，";
				mes "不是餐厅厨师。";
				next;
				break;
			case 2:
				break;
			case 3:
				set .@w_point,.@w_point+1;
				mes "[Darwin]";
				mes "嗯……";
				mes "真是马虎……";
				next;
				break;
			}
			if (.@w_point > 0) {
				mes "[Darwin]";
				mes "...";
				mes "......";
				next;
				mes "[Darwin]";
				mes "你没有遵循步骤，弄坏了混合物！再拿些材料，";
				mes "继续尝试直到成功。";
				mes "请记住正确流程。";
				close;
			}
			getitem 501,1; //Red_Potion
			getitem 503,1; //Yellow_Potion
			getitem 504,1; //White_Potion
			mes "[Darwin]";
			mes "做得好。";
			mes "第一次能做成这样已经很好了。把刚才制作的药剂留下吧。";
			set ALCH_Q,8;
			changequest 2033,2035;
			next;
			mes "[Darwin]";
			mes "现在去下一个房间";
			mes "和范·赫尔蒙特交谈，";
			mes "继续训练。";
			next;
			mes "[Darwin]";
			mes "永远不要忘记……";
			mes "你必须始终保护";
			mes "对你最珍贵的东西。";
			close;
		}
		else {
			mes "[Darwin]";
			mes "你忘记";
			mes "需要带什么了吗？";
			mes "让我再提醒你一次。";
			mes "你必须带着……";
			mes "回来。";
			next;
			mes "[Darwin]";
			mes "^551A8B3 Medicine Bowls^000000,";
			mes "^551A8B3 Empty Bottle^000000,";
			mes "^551A8B1 Red Herb^000000,";
			mes "^551A8B1 Yellow Herb^000000 and";
			mes "^551A8B1 White Herb^000000.";
			next;
			mes "[Darwin]";
			mes "准备好后";
			mes "再回来……";
			mes "我会等你。";
			close;
		}
	}
	else if (ALCH_Q == 8) {
		mes "我说过要去";
		mes "找范·赫尔蒙特。";
		mes "我想教你更多，";
		mes "但现在不行。";
		next;
		mes "[Darwin]";
		mes "啊……";
		mes "哈莫娜，我的爱。";
		mes "我甚至已经看不到那朵花了。我的灵魂也在";
		mes "悄悄枯萎……";
		close;
	}
	else if (ALCH_Q == 40) {
		mes "我已经把所有知识都交给你，没有更多";
		mes "可以教你的了。";
		next;
		mes "[Darwin]";
		mes "去二楼和联盟领袖交谈。";
		mes "完成后，你的炼金术士生涯就会开始。";
		close;
	}
	else {
		mes "拥有梦想时，";
		mes "你就拥有一切。";
		mes "没有梦想，";
		mes "你会失去一切。";
		mes "也就没有更多可失去。";
		next;
		mes "[Darwin]";
		mes "这双被诅咒的眼睛……";
		mes "很久以前就看不见";
		mes "我的梦想了。";
		mes "哈哈哈哈……";
		next;
		mes "[Darwin]";
		mes "天堂";
		mes "真的存在吗……？";
		mes "没有我的爱就不存在……";
		mes "没有哈莫娜就不存在……";
		close;
	}
}

alde_alche,79,19,5	script	Experiment Expert#am	748,{
	mes "[Van Helmont]";
	if (BaseJob != Job_Merchant) {
		if (BaseJob == Job_Alchemist) {
			mes "你想要什么？";
			mes "我很忙！！别";
			mes "打扰我，快走。";
			mes "请不要碍事。";
			next;
			mes "[Van Helmont]";
			mes "好了，快点……";
			mes "如果你偷懒，永远";
			mes "无法完成研究。出去尽可能多学习吧。";
			next;
			mes "[Van Helmont]";
			mes "阅读科学期刊并进行实验，这就是炼金术。现在让我继续工作！";
			close;
		}
		else {
			mes "再一点……";
			mes "再多一点……";
			mes "不——！只差一点点";
			mes "就能完成了！";
			mes "真可惜！";
			next;
			mes "[Van Helmont]";
			mes "为什么……？！";
			mes "为什么又失败了？！";
			mes "我的计算";
			mes "明明都正确！等、等等……！";
			next;
			mes "[Van Helmont]";
			mes "也许，如果用中子梯度调节热通量，就可能成功……！";
			close;
		}
	}
	if (ALCH_Q == 8) {
		mes "啊啊啊……！";
		mes "为什么这个公式不工作？哪里错了？理论上都正确，但公式某处一定有错误……";
		next;
		mes "[Van Helmont]";
		mes "我把它倒进这里就该停止。等等，这是错误的溶液！我怎么会犯这种";
		mes "愚蠢的错误？！这些东西什么时候";
		mes "被调换了？！";
		next;
		mes "[Van Helmont]";
		mes "好，好……";
		mes "我只需修正这一部分。";
		mes "不用从头开始。只要";
		mes "修好它……等等。等等……";
		next;
		mes "[Van Helmont]";
		mes ".................";
		next;
		mes "[Van Helmont]";
		mes "嗯……";
		mes "你是谁？";
		next;
		if (select("我想成为炼金术士。:……") == 2) {
			mes "[Van Helmont]";
			mes "嗯……？";
			mes "你只是想旁观吗？好吧，但请安静，结束后立即离开。";
			next;
			mes "[Van Helmont]";
			mes "别挡我的路，也别到处乱碰。这里可能有易挥发材料，发生事故会很危险。";
			close;
		}
		mes "[Van Helmont]";
		mes "你……？";
		mes "炼金术士？";
		mes "真有趣的商人。";
		next;
		mes "[Van Helmont]";
		mes "那很好，但我有需要立即处理的实验，";
		mes "所以别";
		mes "妨碍我。";
		next;
		if (select("教我一些东西。:……") == 1) {
			mes "[Van Helmont]";
			mes "啊……！";
			mes "我不是刚说过别打扰我吗？这有什么难理解的？";
			next;
			mes "[Van Helmont]";
			mes "好，好。我给你一项任务。学习一些";
			mes "新东西后回来。让我想想。";
			mes "学什么好呢……";
			next;
			mes "[Van Helmont]";
			mes "好了，我知道了。";
			mes "去向莫尔根斯坦学习";
			mes "制作对抗剂和混合剂，";
			mes "回来后告诉我。";
			next;
			mes "[Van Helmont]";
			mes "你不必带任何东西。去看他工作，让他告诉你如何制作那些溶液。明白了吗？";
			next;
			mes "[Van Helmont]";
			set ALCH_Q,9;
			changequest 2035,2036;
			mes "那么，回头见。";
			mes "你最好尽快";
			mes "出发。";
			close;
		}
		mes "[Van Helmont]";
		mes "...";
		next;
		mes "[Van Helmont]";
		mes "...";
		mes "......";
		next;
		mes "[Van Helmont]";
		mes "...";
		mes "......";
		next;
		mes "[Van Helmont]";
		mes "如果重新校准这种化合物的燃烧率，应该能抵消粒子流中的凝聚趋势……";
		next;
		mes "[Van Helmont]";
		mes "但我该怎么处理这些";
		mes "自发结晶？！我不能随便移除基质，催化剂需要它达到三相点。";
		mes "必须想办法。";
		next;
		mes "[Van Helmont]";
		mes "该死！";
		mes "我该";
		mes "怎么办？！";
		close;
	}
	else if (ALCH_Q == 9) {
		mes "好，如果我在触手这里切开，再把杰勒比结晶和粘稠液体溶液加入……我的药碗到底去哪了？";
		next;
		mes "[Van Helmont]";
		mes "我把它们都用光了吗？！不知道尼古拉斯还有没有。唉，真麻烦。等等，等一下……";
		next;
		mes "[Van Helmont]";
		mes "...";
		next;
		mes "[Van Helmont]";
		mes "...";
		mes "......";
		mes "你是谁？";
		next;
		if (select("我想成为炼金术士？:……") == 2) {
			mes "[Van Helmont]";
			mes "嗯……？";
			mes "你只是想旁观吗？好吧，但请安静，结束后立即离开。";
			next;
			mes "[Van Helmont]";
			mes "别挡我的路，也别到处乱碰。这里可能有易挥发材料，发生事故会很危险。";
			close;
		}
		mes "[Van Helmont]";
		mes "啊，当然。是之前的商人。你从莫尔根斯坦那里学到了什么？我可不是随便把你送去的。";
		next;
		mes "[Van Helmont]";
		mes "让我问你几个问题，";
		mes "检查你";
		mes "学到了什么。";
		mes "请认真回答。";
		next;

//===== rAthena Script ======================================= 
//= Sphinx Mask Quest (custom)
//===== By: ================================================== 
//= sabernet09
//===== Current Version: ===================================== 
//= 1.3
//===== Compatible With: ===================================== 
//= rAthena Project
//===== Description: ========================================= 
//= This quest is related to Umbalian Chief.
//= 1.1 Removed it from official Umbala quests [Lupus]
//= 1.2 Added a missing variable (sphmask_q) [erKURITA]
//= 1.3 Optimized, and coordinates moved. [Euphy]
//============================================================ 

morocc,208,90,6	script	Turban Thief	58,{
	mes "[头巾小偷]";
	if(event_umbala < 2) {
		mes "你想对我做什么？滚开！";
		close; }
	if(sphmask_q) {
		mes "你和我已经没有别的事了，走开！";
		close; }
	mes "嘿，朋友，想不想买这件稀有的面具？我保证它价值不菲，朋友。这可是精品！";
	next;
	callsub L_Menu,1,"1,000,000",1000000;
	callsub L_Menu,2,"750,000",750000;
	callsub L_Menu,3,"500,000",500000;
	next;
	mes "[头巾小偷]";
	mes "啊！算了！我在别的地方能卖得更好！";
	set sphmask_q,1;
	close;

L_Menu:
	mes "[头巾小偷]";
	switch(getarg(0)) {
		case 1: mes "什么？哦呵呵呵，你知道这是我从那些野蛮人手里偷来的，对吧？我不会还回去。不过我可以按价出售……你出多少？"; break;
		case 2: mes "啊，原来你是个商人？好吧，那就……"; break;
		case 3: mes "嗯……你还真会砍价。好吧……这是我的最终报价……"; break; }
	next;
	if(select("支付 "+getarg(1)+"Zeny:不成交")==2) return;
	mes "[头巾小偷]";
	if (Zeny < getarg(2)) {
		mes "你在耍我吗？你根本没有钱！";
		close; }
	set Zeny, Zeny-getarg(2);
	mes "哦呵呵，成交！";
	getitem 7114,1;
	set sphmask_q,1;
	close;
}

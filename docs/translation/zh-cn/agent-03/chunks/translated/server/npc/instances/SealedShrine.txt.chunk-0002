// Bobbing Torches
//============================================================
-	script	Bobbing Torch#SS	-1,{
	if (is_party_leader() == true) {
		if (('ins_baphomet == 3) && (countitem(6001) < 11)) {
			mes "一支仿佛能燃尽一切的巨大火炬在我面前上下摇摆。";
			next;
			mes "火焰的壮观外形和热量让我后退……但我鼓起勇气伸手拿起火炬。";
			next;
			specialeffect2 EF_HOLYHIT;
			getitem 6001,1; //Essence_Of_Fire
			mes "继承者的徽记发出光芒。随后一枚小水晶从火炬中落入我的手中。";
			disablenpc();
			close;
		}
		else if (('ins_baphomet == 3) && (countitem(6001) > 10)) {
			mes "你已经有10个火焰精华，不需要再收集了。";
			close;
		}
		else {
			mes "你不需要再收集火焰精华了。";
			close;
		}
	}
	else {
		mes "一支仿佛能燃尽一切的巨大火炬在我面前上下摇摆……";
		next;
		mes "[Unknown Voice]";
		mes "你不是信仰继承者。不要用不敬之手亵渎火焰精华。";
		specialeffect2 EF_FIRESPLASHHIT;
		percentheal -50,0;
		close;
	}

OnInstanceInit:
	disablenpc();
	end;
}

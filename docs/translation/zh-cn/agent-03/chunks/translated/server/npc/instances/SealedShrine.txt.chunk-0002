				next;
				mes "[Voice of the Gravestone]";
				mes "如你们所知……我们时间不多了。你们无法独自阻止巴风特。多年来恶魔的力量越来越强。";
				next;
				mes "[Voice of the Gravestone]";
				mes "过去，我和同伴在地下二层的祭坛封印了巴风特，并封锁了入口。";
				next;
				mes "[Voice of the Gravestone]";
				mes "我将灵魂精华转移到吊坠中，得以留在这个世界。那时我成为了这座墓地的守护者。";
				next;
				break;
			case 2:
				mes "[Voice of the Gravestone]";
				mes "巴风特的力量即将打破我们设下的封印。如果不重新激活……巴风特复活只是时间问题。";
				next;
				mes "[Voice of the Gravestone]";
				mes "要打开入口，你必须让我的灵魂实体化。实体化后我会打开入口并重新激活减弱的封印。";
				next;
				mes "[Voice of the Gravestone]";
				mes "要让我的灵魂实体化，请找到我的吊坠。我的遗体就在这里一座墓附近。";
				next;
				mes "[Voice of the Gravestone]";
				mes "如果^0000FF队长^000000把吊坠带给我，我的灵魂就能实体化。快点。";
				set 'ins_baphomet,1;
				close;
			case 3:
				mes "我感觉声音越来越微弱。";
				close;
			}
		}
	}
	else if ('ins_baphomet == 1) {
		mes "[Voice of the Gravestone]";
		mes "要打开入口，你必须让我的灵魂实体化。实体化后我会打开入口并重新激活减弱的封印。";
		next;
		mes "[Voice of the Gravestone]";
		mes "要让我的灵魂实体化，请找到我的吊坠。我的遗体就在这里一座墓附近。";
		next;
		mes "[Voice of the Gravestone]";
		mes "如果^0000FF队长^000000把吊坠带给我，我的灵魂就能实体化。快点。";
		close;
	}
	else if (('ins_baphomet == 2) && is_party_leader(.@party_id) == true) {
		mes "[Voice of the Gravestone]";
		mes "你找到吊坠了吗？";
		next;
		if (countitem(6003) > 0) {
			specialeffect EF_MAPPILLAR;
			mes "[Voice of the Gravestone]";
			mes "是的……这就是……我的吊坠……";
			next;
			delitem 6003,1; //Soul_Pendant
			enablenpc instance_npcname("Ancient Hero's Soul#1F");
			disablenpc instance_npcname("Gravestone#");
			mes "[Voice of the Gravestone]";
			mes "现在我可以让灵魂实体化了。我会在墓地中央的火焰祭坛前等你。那里见。";
			next;
			mapannounce instance_mapname("1@cata"), "古代英雄之魂：我会在中央的火焰祭坛前等你。",bc_map,"0xFFFF00";
			mes "我感觉声音越来越微弱。";
			close;
		}
		else {
			mes "[Voice of the Gravestone]";
			mes "你还在那里吗？请尽快把我的吊坠带回来。";
			next;
			mes "[Voice of the Gravestone]";
			mes "我的遗体就在这里一座墓附近。去那里拿回我的吊坠。";
			close;
		}
	}
	else {
		mes "[Voice of the Gravestone]";
		mes "我想和你们队伍中的^0000FF代表^000000谈谈。其他人请在这里等候。";
		close;
	}
	end;

OnTouch:
	if ('ins_baphomet == 0) {
		mes "‘咔啊……咔啊……’";
		next;
		mes "我能感觉到墓地有异常。仿佛有人在无声呼唤……";
		close;
	}
	end;

OnInstanceInit: // Temporary fix for @reloadscript.
	set 'ins_baphomet,0;
	end;
}

1@cata,176,119,4	script	Ancient Hero's Soul#1F	411,{
	set .@party_id,getcharid(1);
	cutin "ins_cata_champ_n",2;
	if ('ins_baphomet == 2) {
		mes "[Ancient Hero's Soul]";
		mes "多亏你的帮助，我的灵魂可以实体化了。我想多说一些，但时间不多了……";
		next;
		mes "[Ancient Hero's Soul]";
		mes "我必须在一小时内实体化。要到达地下主祭坛，你必须帮助我举行开启每道封印的仪式。";
		next;
		mes "[Ancient Hero's Soul]";
		mes "现在告诉你该做什么。首先，从墓地的火炬收集^0000FF火焰精华^000000……";
		next;
		mes "[Ancient Hero's Soul]";
		mes "其次，所有要进入地下的成员都必须携带一种象征物，叫做使徒徽记。";
		next;
		while(1) {
			cutin "ins_cata_champ_n",2;
			switch(select("什么是火焰精华？:什么是使徒徽记？:我该做什么？:我准备好了。")) {
			case 1:
				set .@ins_baphomet_1f_1,.@ins_baphomet_1f_1+1;
				mes "[Ancient Hero's Soul]";
				mes "你能看到四处的火炬。这些火炬是雷神Thor的精华，由先辈传承下来，用于阻止巴风特的黑暗……";
				next;
				mes "[Ancient Hero's Soul]";
				mes "要打开地下封印之门，我必须用拥有Thor力量的^0000FF火焰精华^000000净化。请从火炬收集^0000FF10个火焰精华^000000。";
				next;
				mes "[Ancient Hero's Soul]";
				mes "请记住……只有信仰继承者才能收集^0000FF火焰精华^000000。";
				next;
				mes "[Ancient Hero's Soul]";
				mes "我会把信仰继承者徽记交给队长。只有队长才能收集^0000FF火焰精华^000000。";
				next;
				break;
			case 2:
				set .@ins_baphomet_1f_2,.@ins_baphomet_1f_2+1;
				mes "[Ancient Hero's Soul]";
				mes "当时我们无法独自消灭恶魔巴风特。无数英雄牺牲生命后，才勉强将他封印在修道院地下。";
				next;
				mes "[Ancient Hero's Soul]";
				mes "然而巴风特从未放弃。他不断增强力量，并为这座圣地带来了新的生命。";
				next;
				mes "[Ancient Hero's Soul]";
				mes "其中一些怪物拥有魔力。巴风特称它们为‘使徒’。";
				next;
				mes "[Ancient Hero's Soul]";
				mes "使徒不断复制自己，用邪恶能量充满圣地。它们就是墓穴中的怪物。";
				next;
				mes "[Ancient Hero's Soul]";
				mes "杀死使徒。它们与分身的区别在于会持有^0000FF使徒徽记^000000……";
				next;
				mes "[Ancient Hero's Soul]";
				mes "如果每名队员都持有^0000FF使徒徽记^000000，巴风特就无法察觉你们进入地下主祭坛。";
				next;
				mes "[Ancient Hero's Soul]";
				mes "如果巴风特在你们通过封印之门时察觉到你们，可能会释放强大魔力，修道院将被摧毁。";
				next;
				mes "[Ancient Hero's Soul]";
				mes "杀死使徒并取得^0000FF使徒徽记^000000。";
				next;
				break;
			case 3:
				set .@ins_baphomet_1f_3,.@ins_baphomet_1f_3+1;
				if (is_party_leader(.@party_id) == true) {
					mes "[Ancient Hero's Soul]";
					mes "你看起来是队长。去火炬处收集^0000FF10个火焰精华^000000。";
					next;
					mes "[Ancient Hero's Soul]";
					mes "现在我会刻下信仰继承者的徽记。注意，队伍中只有你能收集火焰精华。";
					next;
					specialeffect2 EF_HOLYHIT;
					mes "[Ancient Hero's Soul]";
					mes "你还必须携带^0000FF使徒徽记^000000，也为自己找一个。";
					next;
					mes "[Ancient Hero's Soul]";
					mes "大家准备好后告诉我，我会打开封印之门。";
					next;
				}
				else {
					mes "[Ancient Hero's Soul]";
					mes "确保队长听过我对你们要做之事的说明。";
					next;
					mes "[Ancient Hero's Soul]";
					mes "杀死巴风特的使徒并找到^0000FF使徒徽记^000000。";
					next;
					mes "[Ancient Hero's Soul]";
					mes "最好全部杀死，因为无法区分它们和分身。";
					next;
					mes "[Ancient Hero's Soul]";
					mes "准备好了吗？";
					mes "说准备好之前，确保你听完了我说的一切。";
					next;
				}
				break;
			case 4:
				if ((.@ins_baphomet_1f_1 > 0) && (.@ins_baphomet_1f_2 > 0) && (.@ins_baphomet_1f_3 > 0)) {
					cutin "ins_cata_champ_n",2;
					mes "[Ancient Hero's Soul]";
					mes "准备出发了吗？那我现在打开封印之门。";
					next;
					set .@exitloop,1;
				}
				else {
					cutin "ins_cata_champ_a",2;
					mes "[Ancient Hero's Soul]";
					mes "这可能很困难，但祝你勇敢面对墓穴危险。";
					next;
					mes "[Ancient Hero's Soul]";
					mes "记住，你需要从火炬收集^0000FF10个火焰精华^000000，并从巴风特使徒处取得^0000FF使徒徽记^000000。";
					next;
				}
				break;
			}
			if (.@exitloop) break;
		}
		if (is_party_leader(.@party_id) == true) {
			mes "[Ancient Hero's Soul]";
			mes "再提醒一次，我必须在一小时内实体化。大家要在这段时间内完成任务！";
			set 'ins_baphomet,3;
			donpcevent instance_npcname("ins_baphomet_1f_timer")+"::OnEnable";
			donpcevent instance_npcname("ins_baphomet_lotto2")+"::OnEnable";
			donpcevent instance_npcname("ins_baphomet_lotto3")+"::OnEnable";
		}
		else {
			mes "[Ancient Hero's Soul]";
			mes "再提醒一次，我能在一小时内实体化。大家要在这段时间内完成任务。";
			//set 'ins_baphomet,3;
		}
		close2;
		cutin "",255;
		end;
	}
	else if (('ins_baphomet == 3) && is_party_leader(.@party_id) == true) {
		cutin "ins_cata_champ_n",2;
		mes "[Ancient Hero's Soul]";
		mes "你拿到10个^0000FF火焰精华^000000和^0000FF使徒徽记^000000了吗？";
		next;
		if ((countitem(6001) > 9) && (countitem(6002) > 0)) {
			delitem 6001,countitem(6001); //Essence_Of_Fire
			set 'ins_baphomet,4;
			mes "[Ancient Hero's Soul]";
			mes "好，你完成了任务。检查同伴，所有人完成后告诉我。";
		}
		else {
			mes "[Ancient Hero's Soul]";
			mes "还没准备好？请准备10个^0000FF火焰精华^000000和^0000FF使徒徽记^000000。";
		}
		close2;
		cutin "",255;
		end;
	}
	else if ('ins_baphomet == 3) {
		cutin "ins_cata_champ_n",2;
		mes "[Ancient Hero's Soul]";
		mes "你有^0000FF使徒徽记^000000吗？";
		next;
		if (countitem(6002) > 0) {
			set 'ins_baphomet,4;
			mes "[Ancient Hero's Soul]";
			mes "好，你完成了任务。让代表检查同伴，所有人完成后再来找我。";
		}
		else {
			mes "[Ancient Hero's Soul]";
			mes "还没准备好？请准备^0000FF使徒徽记^000000。";
		}
		close2;
		cutin "",255;
		end;
	}
	else if (('ins_baphomet == 4) && is_party_leader(.@party_id) == true) {
		cutin "ins_cata_champ_n",2;
		mes "[Ancient Hero's Soul]";
		mes "准备好了吗？我已打开封印之门。通过大门必须携带^0000FF使徒徽记^000000。";
		next;
		set 'ins_baphomet,5;
		specialeffect EF_TELEPORTATION;
		enablenpc instance_npcname("ins_bapho_to_2f");
		donpcevent instance_npcname("ins_baphomet_1f_timer")+"::OnDisable";
		mes "[Ancient Hero's Soul]";
		mes "现在可以前往主祭坛了。它位于本层右下角。";
		next;
		mes "[Ancient Hero's Soul]";
		mes "真正的战斗即将开始……我很快会跟上并想办法帮助你。";
		next;
		mes "[Ancient Hero's Soul]";
		mes "前进吧，战士们。";
		cutin "",255;
		mapannounce instance_mapname("1@cata"), "古代英雄之魂：现在可以前往主祭坛入口了。它位于东南方。",bc_map,"0xFFFF00";
		close;
	}
	else if ('ins_baphomet == 4) {
		cutin "ins_cata_champ_n",2;
		mes "[Ancient Hero's Soul]";
		mes "准备好了吗？我已打开封印之门。通过大门必须携带^0000FF使徒徽记^000000。";
		next;
		mes "[Ancient Hero's Soul]";
		mes "代表告诉我你们准备好后，我会完成封印之门的开启。";
		cutin "",255;
		close;
	}
	else if ('ins_baphomet == 5) {
		cutin "ins_cata_champ_n",2;
		mes "[Ancient Hero's Soul]";
		mes "你在做什么？主祭坛入口已经打开，去战斗吧！入口就在本层右下方。";
		cutin "",255;
		close;
	}
	else {
		cutin "ins_cata_champ_n",2;
		mes "[Ancient Hero's Soul]";
		mes "我没什么要对你说的……";
		cutin "",255;
		close;
	}

OnInstanceInit:
	disablenpc instance_npcname("Ancient Hero's Soul#1F");
	end;
}

// To 2F Warp
//============================================================
1@cata,281,12,0	script	ins_bapho_to_2f	45,1,1,{
OnTouch:
	if (countitem(6002) > 0) {
		delitem 6002,countitem(6002); //Token_Of_Apostle
		set 'ins_baphomet,5;
		warp instance_mapname("2@cata"),80,144;
		end;
	}
	else {
		mes "[Ancient Hero's Soul]";
		mes "你的使徒徽记在哪里？我说过通过这扇门必须携带使徒徽记。";
		close;
	}

OnInstanceInit:
	disablenpc instance_npcname("ins_bapho_to_2f");
	end;
}

// Gravestones
//============================================================
-	script	Gravestone#SS1	-1,{
	if ('ins_baphomet == 1) {
		getitem 6003,1; //Soul_Pendant
		set 'ins_baphomet,2;
		mes "一件小物体在倾斜的墓碑下闪闪发光。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "我想这就是吊坠……";
		close;
	}
	else {
		mes "我只能从这块墓碑感受到阴郁。";
		close;
	}
}

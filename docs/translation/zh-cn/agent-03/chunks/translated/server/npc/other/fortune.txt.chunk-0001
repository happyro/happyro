payon_in03,117,128,5	script	Fortune Teller	4_M_BIBI,{
	mes "[利梅托拉]";
	mes "你是这个世界的冒险者……" +strcharinfo(0)+ "，对吧？那么，像我这样的老人能为你做什么？";
	next;
	if (select("我想进行塔罗牌占卜。:什么是塔罗牌占卜？") == 2) {
		mes "[利梅托拉]";
		mes "怪物卡片占卜使用我们身边熟悉怪物的卡片，为未来、爱情和许多事情提供建议。";
		mes "像我这样的占卜师会听取问题并询问卡片。卡片回答后，我再告诉你。";
		next;
		mes "[Lhimetorra]";
		mes "一天不要占卜超过一次，也别太频繁，因为卡片可能生气或困惑。";
		mes "而且这也可能对你的生活产生坏影响！";
		next;
		mes "[Lhimetorra]";
		mes "还有一件事。";
		mes "占卜终究只是占卜……无论结果多么奇妙，都别太沉迷。请记住。";
		close;
	}
	mes "[利梅托拉]";
	mes "是这样吗……？";
	mes "如果想进行怪物卡片占卜，必须先向我展示你的信仰。否则怪物灵魂会生气并诅咒你。";
	next;
	mes "[利梅托拉]";
	mes "那么，你想进行怪物卡片占卜吗？";
	next;
	if (select("是。:我想再考虑一下。") == 2) {
		mes "[利梅托拉]";
		mes "好吧。年轻的冒险者，愿幸运与你同在……";
		close;
	}
	mes "[利梅托拉]";
	mes "那么……";
	mes "请用你全部的诚意支付费用。";
	next;
	input .@input;
	if (.@input == 0) {
		mes "[Lhimetorra]";
		mes "啊……？！";
		mes "你激怒了怪物灵魂！";
		close;
	}
	else if (.@input > zeny) {
		mes "[Lhimetorra]";
		mes "不用做得太过。只要全心全意地给予……*啧啧*";
		close;
	}
	else {
		mes "[Lhimetorra]";
		mes "我满怀感激地接受你的心意与奉献。给占卜师付费时，心意比金额重要。";
		Zeny = Zeny-.@input;
	}
	next;
	mes "[Lhimetorra]";
	mes "那么，我开始为你的愿望占卜。请专注于自己……";
	next;
	mes "[Lhimetorra]";
	mes "...";
	mes "清空你的思绪……";
	next;
	mes "[Lhimetorra]";
	mes "...";
	mes "清空思绪后，想想你最想知道的事。";
	next;
	switch(select("（我想知道爱情运势。）","（我会多富有？）","（我需要未来建议。）","（能警告我将面临的危险吗？）")) {
	case 1:
		mes "[利梅托拉]";
		mes "我看到了……我看到了爱情的征兆……";
		next;
		.@card_1_love = rand(1,74);
		if (.@card_1_love < 5) cutin "°¡ÀÌ¾Æ½ºÄ«µå",4;		// Giearth Card
		else if (.@card_1_love < 10) cutin "´õ½ºÆ¼³×½ºÄ«µå",4;// Dustiness Card
		else if (.@card_1_love < 18) cutin "µå¶óÅ¥¶óÄ«µå",4;	// Dracula Card
		else if (.@card_1_love < 26) cutin "¸¶¸®³ªÄ«µå",4;	// Marina Card
		else if (.@card_1_love < 30) cutin "¸ÞµÎ»çÄ«µå",4;	// Medusa Card
		else if (.@card_1_love < 35) cutin "¹ÙÆ÷¸ÞÆ®Ä«µå",4;	// Baphomet Card
		else if (.@card_1_love < 39) cutin "»÷µå¸ÇÄ«µå",4;	// Sandman Card
		else if (.@card_1_love < 43) cutin "¼ÒÈñÄ«µå",4;		// Sohee Card
		else if (.@card_1_love < 51) cutin "½ºÄÌ¿öÄ¿Ä«µå",4;	// Skel Worker Card
		else if (.@card_1_love < 55) cutin "¾Æ´©ºñ½ºÄ«µå",4;	// Anubis Card
		else if (.@card_1_love < 59) cutin "¿ÀÅ©·ÎµåÄ«µå",4;	// Orc Lord Card
		else if (.@card_1_love < 63) cutin "ÀèÄ«µå",4;		// Jakk Card
		else if (.@card_1_love < 67) cutin "Á¶Ä¿Ä«µå",4;		// Joker Card
		else if (.@card_1_love < 71) cutin "È£µåÄ«µå",4;		// Hode Card
		else cutin "È²¼ÒÄ«µå",4;// Minorous Card
		
		mes "[Lhimetorra]";
		switch(.@card_1_love) {
		case 1:
			mes "你害怕让爱人看到努力工作的自己……";
			mes "但那不是爱。不要害怕向爱人展现不同的一面……";
			next;
			mes "[Lhimetorra]";
			mes "所以别担心，继续前进。";
			break;
		case 2:
			mes "也许你把爱情当作工作的借口？卡片说要尝试从不同角度观察爱情。";
			next;
			mes "[Lhimetorra]";
			mes "铲土也需要技巧。";
			break;
		case 3:
			mes "不如暂时放下爱情，给自己时间放松……我同意卡片的说法。";
			next;
			mes "[Lhimetorra]";
			mes "爱情不该如此艰难。";
			break;
		case 4:
			mes "一把铲子……？";
			next;
			mes "[Lhimetorra]";
			mes "爱情占卜出现铲子真奇怪……你不是要用它向某人复仇吧？";
			mes "别产生恶意想法。保持善良。";
			next;
			mes "[Lhimetorra]";
			mes "不如暂时放下爱情，给自己时间放松……我同意这张卡片。";
			break;
		case 5:// Dustiness Card
			mes "它用纯洁的眼睛看着爱人却无法认出，翅膀朝爱人振动，却无力地停在原地，";
			mes "它呼唤爱人，却无人听见……";
			next;
			mes "[Lhimetorra]";
			mes "多么悲伤的运势……";
			mes "确实是悲伤的爱情……也许很难克服。";
			break;
		case 6:
			mes "爱情的激情如怒涛……你甚至无法隐藏。";
			mes "面对如此热烈的爱情，难道只有一条路……？";
			next;
			mes "[Lhimetorra]";
			mes "热烈的爱情就在附近。这是好兆头。";
			break;
		case 7:
			mes "尘埃的牙齿非常强。这意味着……用你的牙齿取得胜利？！";
			break;
		case 8:
			mes "卡片告诉我：‘像蝴蝶一样飞向爱人，像星星一样向他射击。’";
			mes "……虽然这不像飞蛾会说的话。";
			next;
			mes "[Lhimetorra]";
			mes "爱情的激情如怒涛……你甚至无法隐藏。";
			break;
		case 9:
			mes "也许你以为是蝴蝶的人其实是飞蛾。这份运势需要谨慎判断。";
			next;
			mes "[Lhimetorra]";
			mes "爱情确实需要谨慎对待。记住这一点，年轻人。";
			break;
		case 10: // Dracula Card
			mes "你爱的人会给你死亡之吻。";
			mes "无法抗拒的吻……是否躲开由你决定。";
			next;
			mes "[Lhimetorra]";
			mes "魅力……是最甜美的毒药。";
			break;
		case 11:
			mes "你注视着一个出色的人，但他的眼睛凝视着黑暗。";
			mes "不如试着吸引他的注意？";
			next;
			mes "[Lhimetorra]";
			mes "所以，你需要尝试魅力之外的东西。";
			break;
		case 12:
			mes "你的爱情需要新鲜血液。健康运动和饮食习惯很重要！";
			mes "你必须先改变生活方式。";
			next;
			mes "[Lhimetorra]";
			mes "健康最重要。";
			break;
		case 13:
			mes "你是不是迷恋外表，在爱情上赌博？这次你可能要更谨慎。";
			next;
			mes "[Lhimetorra]";
			mes "美丽只是表面的。";
			break;
		case 14:
			mes "成为爱情海盗吧！这是简单却强烈的运势！";
			break;
		case 15:
			mes "无论爱情多么浪漫美丽，它也可能不正当、不可取……";
			mes "这就是这张卡片的含义。";
			next;
			mes "[Lhimetorra]";
			mes "希望这份运势的寓意不会让你失望。";
			break;
		case 16:
			mes "在名为世界的汹涌大海中，只有爱情海盗、爱情的法外之徒才是法则。";
			mes "这张卡片支持坚强的爱情。";
			next;
			mes "[Lhimetorra]";
			mes "无论浪潮多么强烈，你都必须克服它。";
			break;
		case 17:
			mes "这是警告，不要卷入像盗版一样虚假的爱情！";
			mes "你现在可能需要重新考虑自己的爱情。";
			next;
			mes "[Lhimetorra]";
			mes "非法复制不是爱情！";
			break;
		case 18:// Marina Card
			mes "这在赞美一种一直存在，却几乎没有形态的爱情。";
			mes "你正经历这种爱情吗？";
			next;
			mes "[Lhimetorra]";
			mes "爱情的形态很模糊。";
			break;
		case 19:
			mes "你必须小心。爱情正在悄悄靠近并散播毒药。小心爱情之毒。";
			next;
			mes "[Lhimetorra]";
			mes "这种毒无药可救！";
			break;
		case 20:
			mes "你是不是已经陷入无法逃离的爱情？看看周围。";
			mes "你可能被困在无形的墙里。";
			next;
			mes "[Lhimetorra]";
			mes "你被爱情蒙蔽，成了囚徒！难道不该逃走吗？";
			break;
		case 21:
			mes "这份运势说爱情摇摇晃晃、轻柔地靠近~然后砰~拥抱彼此。";
			mes "非常浪漫。呵呵。";
			next;
			mes "[Lhimetorra]";
			mes "浪漫是爱情最美好的部分~";
			break;
		case 22:
			mes "这张卡片警告你不要把爱人当作木偶。";
			mes "你没有这样做吧？";
			next;
			mes "[Lhimetorra]";
			mes "爱情不该是控制与束缚~嗯~";
			break;
		case 23:
			mes "木偶比人更懂人心。试着把爱人当作木偶对待。";
			next;
			mes "[Lhimetorra]";
			mes "你的爱人不会比木偶更糟，对吧？";
			break;
		case 24:
			mes "你害怕直视木偶的眼睛，是因为黑影笼罩着你的爱情。";
			mes "摆脱那道阴影，木偶也会微笑。";
			next;
			mes "[Lhimetorra]";
			mes "这就是爱情。";
			break;
		case 25:
			mes "木偶越被接触就越习惯主人。多关注你的木偶。";
			mes "木偶渴望关注，非常多的关注。";
			next;
			mes "[Lhimetorra]";
			mes "细致的对待与关注是爱情中最好的东西。";
			break;
		case 26:// Medusa Card
			mes "你害怕美杜莎的蛇发吗？但爱情不能靠恐惧实现。";
			mes "你必须前进！";
			next;
			mes "[Lhimetorra]";
			mes "爱情必须向前推进！";
			break;
		case 27:
			mes "仓促攻击美杜莎的战士都失败了，但使用镜子的英雄成功了。";
			mes "爱情不能靠蛮力成功。必须运用智慧。";
			next;
			mes "[Lhimetorra]";
			mes "年轻人，你明白我的意思吗？";
			break;
		case 28:
			mes "你一定要爱上那个长着蛇发的人吗？重新考虑这段爱情，认真想想吧。";
			next;
			mes "[Lhimetorra]";
			mes "你觉得呢？这不是思考这段关系的好机会吗？";
			break;
		case 29:
			mes "这是在提示你：强大的发型是扭转局面的关键。换个发型吧！";
			next;
			mes "[Lhimetorra]";
			mes "时尚掌握在走在前面的人手中！";
			break;
		case 30:// Baphomet Card
			mes "爱情需要两样东西：强大的力量和求生意志。你想过凭现在的自己能否克服这一切吗？";
			next;
			mes "[Lhimetorra]";
			mes "了解爱情，也了解自己！";
			break;
		case 31:
			mes "镰刀看起来很沉重，但强壮的巴风特可以自如使用。";
			mes "道理是一样的。只要你准备好了，任何形式的爱情都可能实现。没有什么是不可能的。";
			next;
			mes "[Lhimetorra]";
			mes "爱情也需要准备！";
			break;
		case 32:
			mes " Love must have two things: great strength and the will to live. Have you thought about whether or not you can overcome this with your current self? ";
			next;
			mes "[Lhimetorra]";
			mes " Know love and know thyself! ";
			break;
		case 33:
			mes "有些人生来就注定会撞上这面墙、这个障碍。你的爱情似乎也到了那面墙……一定很难受。";
			next;
			mes "[Lhimetorra]";
			mes "真遗憾。";
			break;
		case 34:
			mes "这只巴风特看起来很辛苦。那个人即使表面看不出来，也一定已经筋疲力尽。";
			next;
			mes "[Lhimetorra]";
			mes "那就带着关怀接近他吧。";
			break;
		case 35:// Sandman Card
			mes "你听不到卡片的哭喊吗？它正在受苦。爱情就是这样……";
			next;
			mes "[Lhimetorra]";
			mes "所以别为此烦恼！";
			break;
		case 36:
			mes "你现在的爱情无聊得让人打哈欠。不如尝试新鲜事物？";
			next;
			mes "[Lhimetorra]";
			mes "试着改变约会方式。";
			break;
		case 37:
			mes "深度睡眠带来幸福和梦想。我想你现在需要睡觉。";
			next;
			mes "[Lhimetorra]";
			mes "去睡一觉。";
			break;
		case 38:
			mes "我感到某种空虚……也许你的爱情存在空缺？";
			next;
			mes "[Lhimetorra]";
			mes "仔细看看。";
			break;
		case 39:// Sohee Card
			mes "即使传统美人也可能让人觉得冷漠。试着从不同角度看爱人。";
			next;
			mes "[Lhimetorra]";
			mes "从不同角度看爱情。你永远不知道何时会发现新东西。";
			break;
		case 40:
			mes "他们看起来阴沉不祥，但衣着一尘不染，展现了对方的虔诚。";
			mes "即使你现在对爱情不满意，也看看对方的装扮。";
			next;
			mes "[Lhimetorra]";
			mes "衣着如此讲究，其中也能看出他们对你的心意……";
			break;
		case 41:
			mes "附近有一个你不能轻率对待的人。别随便说或做，和他相处必须小心。";
			next;
			mes "[Lhimetorra]";
			mes "请记住。";
			break;
		case 42:
			mes "即使风吹动衣摆，她的姿势也不变。爱上拥有这种心灵的人会带来善意与幸福。";
			next;
			mes "[Lhimetorra]";
			mes "保持正直的心与思想。";
			break;
		case 43:// Skel Worker Card
			mes "它举起灯并用镐攻击！你必须积极前进。怎么样？这是好运势。";
			next;
			mes "[Lhimetorra]";
			mes "年轻人，你的心准备好了吗？";
			break;
		case 44:
			mes "卡片只显示瘦骨，但注意它拥有所有必要工具吗？";
			mes "即使你的爱情看似空无一物，其实拥有你所需的一切。";
			next;
			mes "[Lhimetorra]";
			mes "别太贪心。";
			break;
		case 45:
			mes "它背上和手中都有灯……它认为一盏灯不够。";
			mes "你只向爱人展示一种光，展示另一种也许有帮助。";
			next;
			mes "[Lhimetorra]";
			mes "他们可能觉得一盏灯不够。";
			break;
		case 46:
			mes "你知道蒙娜丽莎的微笑……也许你注视的人有着同样表情？";
			next;
			mes "[Lhimetorra]";
			mes "别一直直视他们。努力接近他们。";
			break;
		case 47:
			mes "骑马的骑士是每个人心中的幻想。让这个幻想成为现实。";
			next;
			mes "[Lhimetorra]";
			mes "这样一定会有进展。";
			break;
		case 48:
			mes "那个士兵在等待攻击吗？我能感到马与骑士之间的紧张。";
			mes "别轻率前冲。举起剑等待机会。";
			next;
			mes "[Lhimetorra]";
			mes "这意味着现在该等待。怎么样，要等一会儿吗？";
			break;
		case 49:
			mes "他在等待战斗时睡着了。是因为悠闲，还是可悲？要看情况。";
			mes "但必须称赞他的大胆。";
			next;
			mes "[Lhimetorra]";
			mes "不如成为爱情战场上的勇敢战士？";
			break;
		case 50:
			mes "非常有利。我能从卡片感受到强大能量。我要把部分能量给你。";
			next;
			mes "[Lhimetorra]";
			mes "把那份能量奉献给爱情吧……！";
			break;
		case 51:// Anubis Card
			mes "死神对爱情有什么要说的？肯定是不祥之兆。";
			next;
			mes "[Lhimetorra]";
			mes "我想它是在发出警告。小心。";
			break;
		case 52:
			mes "嗯。不如送一只可爱的小狗作为礼物？要圆鼻子的。这样他们一定会开心。";
			next;
			mes "[Lhimetorra]";
			mes "不过如果他们不喜欢小狗，也没办法。";
			break;
		case 53:
			mes "从它哭泣时握着血斧的样子，我能看出它经历了什么。它被爱情深深伤害。";
			next;
			mes "[Lhimetorra]";
			mes "如果伤口不尽快治愈，它会变成阿努比斯想要的样子。";
			break;
		case 54:
			mes "衣服的图案象征警告。它说要小心爱情。";
			next;
			mes "[Lhimetorra]";
			mes "要谨慎。";
			break;
		case 55:// Orc Lord Card
			mes "他警告你不要对别人垂涎。";
			next;
			mes "[Lhimetorra]";
			mes "那很糟！你会受到惩罚！";
			break;
		case 56:
			mes "他用强壮的肌肉和凶狠目光看着谁？他肯定在看别人。";
			next;
			mes "[Lhimetorra]";
			mes "别分心看向别处！你会被诅咒！";
			break;
		case 57:
			mes "强化身体并观察目标。这是成功的第一步。";

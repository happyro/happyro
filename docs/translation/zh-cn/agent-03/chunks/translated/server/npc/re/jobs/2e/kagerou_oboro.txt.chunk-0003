job_ko,57,16,4	script	Sight#ko_00	858,1,1,{
	callfunc "F_KO_Survival_mes",0;
	end;
OnTouch:
	if (job_kagero != 5) {
		mes "你不该在这里。";  //custom translation
		close2;
		warp "amatsu",147,136;
		end;
	}
	if (isbegin_quest(5137) == 1 && isbegin_quest(5140) == 0) {
		mes "牌子上写着细小的字。";
		next;
		callsub L_Description;
		setquest 5140;
		set job_kagero_lp,100;
		mes "你获得了100点生命点（LP）。";
		next;
	} else {
		if (checkquest(5141,PLAYTIME) > -1)
			erasequest 5141;
		set job_kagero_lp,100;
		mes "你回到了第一格。LP已恢复。";
		next;
		callsub L_Description;
	}
	callfunc "F_KO_Survival_dice",0;
	end;

L_Description:
	while (1) {
		if(select("阅读说明。:开始测试。") == 2)
			break;
		mes "生存测试从这里开始。你使用^FD0260100点生命点（LP）^000000并掷骰子前进。";
		next;
		mes "测试从第0格到第40格，每格都可能增加或减少LP。";
		next;
		mes "到达终点格前必须保有^FD0260LP^000000，才能通过测试。";
		next;
		mes "但是！到达终点格时^FD0260LP^000000变为0，仍然可以通过测试。";
		next;
		mes "游戏说明到此结束。祝你好运。";
		next;
	}
	return;
}

job_ko,49,16,4	script	Sight#ko_01	858,1,1,{
	callfunc "F_KO_Survival_mes",1;
	end;
OnTouch:
	set .@life_p, job_kagero_lp;
	mes "牌子上写着细小的字。";
	next;
	mes "你掷骰子的运气真差。怎么一开始就掷出1？在这格支付10点LP即可移动到第9格。";
	next;
	if(select("使用10点LP:掷骰子。") == 1) {
		if (job_kagero_lp > 9) {
			set .@reset_p, .@life_p - 10;
			set job_kagero_lp, .@reset_p;
			mes "< 已使用10点LP >";
			mes "按关闭键移动到第9格。";
			callfunc "F_KO_Survival_warp",9;
			end;
		} else {
			mes "< 未使用10点LP >";
			mes "^FD0260LP^000000不足！";
			next;
		}
	}
	mes "掷骰子。";
	next;
	callfunc "F_KO_Survival_dice",1;
	end;
}


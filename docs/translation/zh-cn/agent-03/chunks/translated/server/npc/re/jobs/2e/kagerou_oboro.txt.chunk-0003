//  Templates
// -----------------------------------------------------------
-	script	Sight#ko_trap	-1,{
	callfunc "F_KO_Survival_mes", atoi(substr(strnpcinfo(2),3,4));
	end;
OnTouch:
	mes "牌子上写着细小的字。";
	next;
	switch (atoi(substr(strnpcinfo(2),3,4))) {
		case  2: set .@id,0; break;
		case  7: set .@id,5; break;
		case 11: set .@id,9; break;
		case 23: set .@id,18; break;
		case 26: set .@id,20; break;
		case 30: set .@id,9; break;
		case 35: set .@id,29; break;
	}
	mes "这格有陷阱。";
	mes "按关闭键返回第" + .@id + "格。";
	callfunc "F_KO_Survival_warp", .@id;
	end;
}

-	script	Sight#ko_trap2	-1,{
	callfunc "F_KO_Survival_mes", atoi(substr(strnpcinfo(2),3,4));
	end;
OnTouch:
	set .@id, atoi(substr(strnpcinfo(2),3,4));
	switch (.@id) {
		case 10: set .@var$, "$20110808_vko01"; break;
		case 28: set .@var$, "$20110808_vko03"; break;
		//case 38: set .@var$, "$20110808_vko04"; break;
	}
	mes "牌子上写着细小的字。";
	next;
	mes "如果不想被抓住，就设置陷阱。";
	next;
	if (getd(.@var$) == 0) {
		mes "目前没有设置陷阱。";
		next;
		mes "要使用10点^FD0260LP^000000设置陷阱吗？";
		next;
		if(select("设置陷阱。:掷骰子。") == 1) {
			if (job_kagero_lp > 9) {
				mes "< Used 10 LP >";
				set job_kagero_lp, job_kagero_lp - 10;
				setd .@var$,1;
				next;
				mes "陷阱已设置。请掷骰子。";
				next;
			} else {
				mes "< Did not use 10 LP >";
				mes "^FD0260LP^000000不足！请掷骰子。";
				next;
			}
		}
	} else {
		set job_kagero_lp,0;
		setd .@var$,0;
		mes "你中了设置的陷阱。";
		mes "按关闭键返回第0格。";
		callfunc "F_KO_Survival_warp",0;
		end;
	}
	callfunc "F_KO_Survival_dice",.@id;
	end;
}

-	script	Sight#ko_heal	-1,{
	callfunc "F_KO_Survival_mes", atoi(substr(strnpcinfo(2),3,4));
	end;
OnTouch:
	set .@id, atoi(substr(strnpcinfo(2),3,4));
	mes "牌子上写着细小的字。";
	next;
	mes "这格受到祝福。";
	mes "生命点恢复7点^FD0260LP^000000。";
	mes "不能超过最大值100点^FD0260LP^000000。";
	next;
	mes "< 已恢复" + ((job_kagero_lp + 7 > 100) ? "" : "7") + "点LP >";
	next;
	set job_kagero_lp, ((job_kagero_lp + 7 > 100) ? 100 : job_kagero_lp + 7);
	callfunc "F_KO_Survival_dice",.@id;
	end;
}

-	script	Sight#ko_curse	-1,{
	callfunc "F_KO_Survival_mes", atoi(substr(strnpcinfo(2),3,4));
	end;
OnTouch:
	set .@id, atoi(substr(strnpcinfo(2),3,4));
	set .@playtime, checkquest(5141,PLAYTIME);
	if (.@playtime == -1) {
		mes "牌子上写着细小的字。";
		next;
		mes "如果不支付5点^FD0260LP^000000，你会被诅咒并禁锢2分钟。";
		next;
		if(select("使用 5 点 LP:不支付。") == 1) {
			if (job_kagero_lp > 4) {
				set job_kagero_lp, job_kagero_lp - 5;
				mes "<Used 5 LP>";
	mes "你可以掷骰子。";
				next;
				callfunc "F_KO_Survival_dice",.@id;
				end;
			} else {
				mes "< Did not use 5 LP >";
				mes "无法承受诅咒。";  //custom translation
				next;
			}
		}
		setquest 5141;
		mes "你被诅咒，2分钟内无法移动到其他格。";
		close;
	} else if (.@playtime == 0 || .@playtime == 1) {
		mes "你被诅咒，2分钟内无法移动到其他格。";
		close;
	} else if (.@playtime == 2) {
		mes "禁锢诅咒持续2分钟后消失。";
		next;
		erasequest 5141;
		callfunc "F_KO_Survival_dice",.@id;
		end;
	} else {
		erasequest 5141;
		mes "发生未知错误。";
		mes "请联系客服。";
		close;
	}
}

-	script	Sight#ko_gravity	-1,{
	callfunc "F_KO_Survival_mes", atoi(substr(strnpcinfo(2),3,4));
	end;
OnTouch:
	set .@id, atoi(substr(strnpcinfo(2),3,4));
	mes "牌子上写着细小的字。";
	next;
	mes "区域受到正常重力10倍的诅咒。掷骰子需要10点^FD0260LP^000000。";
	next;
	callfunc "F_KO_Survival_dice",.@id,10;
	end;
}


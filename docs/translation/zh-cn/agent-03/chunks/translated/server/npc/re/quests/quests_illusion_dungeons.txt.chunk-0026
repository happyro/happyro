		mes "[Nazarians]";
		mes "哇啊啊啊啊！！！！";
		mes "皇帝万岁！！！！";
		mes "万岁！！！万岁！！！";
		cloakoffnpcself( "Steven#IBT_inN" );
		cloakoffnpcself( "Acid#IBT_inN" );
		next;
		mes "[Steven]";
		mes "等等，那是什么？";
		mes "那不是我们做的玩偶吗？";
		next;
		mes "[Acid]";
		mes "我想是吧？";
		next;
		mes "[Steven]";
		mes "不只是看起来像，它就是我们做的那个！";
		next;
		mes "[Steven]";
		mes "就是你缝错后搞得一团糟的那个？？没错！";
		next;
		mes "[Acid]";
		mes "真是一团糟……";
		mes "那个有自己的可爱之处？";
		next;
		mes "[Steven]";
		mes "……可爱的角……";
		next;
		mes "[Emperor of Nazarians]";
		mes "Hmm...";
		mes "Oops...";
		next;
		mes "[Emperor of Nazarians]";
		mes "看起来有只老鼠潜入了神圣集会。";
		next;
		mes "[Emperor of Nazarians]";
		mes "纳撒里安的战士们！！！！";
		mes "惩罚入侵者！！！";
		next;
		mes "[Nazarians]";
		mes "以我们的名义！";
		mes "我们会做到！";
		next;
		mes "[Nazarians]";
		mes "哇啊啊啊！！！";
		mes "惩罚他们！";
		mes "是入侵者！！！";
		next;
		mes "[Steven]";
		mes "糟糕！";
		mes "看来我们被抓住了？！";
		next;
		mes "[Steven]";
		mes "嘿！";
		mes "敌人太多了，我们分散逃跑吧！";
		next;
		mes "[Steven]";
		mes "适当应付追兵。";
		mes "一分钟后在出口附近见！";
		ill_teddy = 8;
		erasequest 11562;
		setquest 11563;
		setquest 11564;
		close2;
		cloakonnpcself( "Steven#IBT_inN" );
		cloakonnpcself( "Acid#IBT_inN" );
		cloakonnpcself( "??????#IBT_inB01" );

prt_castle,176,170,5	script	Guard#princein	105,{
	if (nk_prince > 4) {
		mes "[奇异之地的卫兵]";
		mes "你可以通过隐藏门前往王子们聚集的房间。出于安全原因，那里受到严密守卫并且隐蔽。";
		next;
		mes "[奇异之地的卫兵]";
		mes "让我打开门。";
		close2;
		warp "prt_castle",220,312;
		end;
	}
	else {
		mes "[奇异之地的卫兵]";
		mes "我只是来这里休息。位置情报可以问其他人。";
		close;
	}
}

prt_castle,121,168,0	script	#arm	111,4,4,{
OnTouch:
	if (nk_prince == 8) {
		mes "[" + strcharinfo(0) + "]";
		mes "..............";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "牛奶已经洒光了。";
		mes "忘了这件事吧。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "谁会代替他登上王位？";
		next;
		set nk_prince,9;
		mes "[" + strcharinfo(0) + "]";
		mes "Oh no...";
		close;
	}
}

prt_castle,316,313,0	script	#arm1	111,3,3,{
OnTouch:
	if (nkprince_eisen > 14) {
		mes "[" + strcharinfo(0) + "]";
		mes "..............";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "他当时在想什么？又是如何在这个房间决定成为国王的？";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "什么样的情形……";
		mes "把他拉回了无法挽回的境地？";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "我再也无法问他，也没有留下任何线索。剩下的只有……";
		next;
		mes "[阿鲁姆]";
		mes "~~如果你错误地应对这件事，我的死就毫无意义……咳……明白吗？~~";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "..............";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "……替他保持沉默。";
		mes "背负他留下的重担……贯穿我的一生。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "……安息吧。";
		close;
	}
	end;
}

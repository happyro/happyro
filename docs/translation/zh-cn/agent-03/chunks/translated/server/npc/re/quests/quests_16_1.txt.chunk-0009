			cutin "ep16_spica_nerius05",1;
			mes "[Spica]";
			mes "这是尼鲁斯家族的特点之一。";
			mes "这个家族世代由女性领导。因此，我们的女王比国王更多。";
			next;
			cutin "ep16_spica_nerius03",1;
			mes "[Spica]";
			mes "如果埃里希没有出现，我和斯基娅其中一人可能会被选为女王候选人。";
			next;
			cutin "ep16_spica_nerius02",1;
			mes "[Spica]";
			mes "母亲不喜欢这样。";
			mes "所以埃里希成了王位候选人。可怜的表亲……";
			next;
			cutin "ep16_spica_nerius01",1;
			mes "[Spica]";
			mes "好了，我想关于我们家族的信息就这些。";
			mes "你和其他家族都互相致意了吗？";
			next;
			mes "[Spica]";
			mes "自由对我们来说很难得，所以我总想尽情享受。";
			mes "所以……";
			next;
			cutin "ep16_skia_nerius03",0;
			mes "[Skia]";
			mes "不如和我们一起享受吧？";
			mes "我相信海涅家族的家主也会成为好朋友。";
			next;
			cutin "ep16_spica_nerius06",1;
			mes "[Spica]";
			mes "斯基娅，我亲爱的双胞胎。";
			mes "你得学会说话更优雅。";
			npctalk "天啊，别唠叨了……", "Skia Nerius#ep16_room01", bc_self;
			next;
			npctalk "我听得见。", "", bc_self;
			cutin "ep16_spica_nerius07",1;
			mes "[Spica]";
			mes "总之，我想说的是，";
			mes "尼鲁斯家族永远欢迎你，" + strcharinfo(0) + "，所以请";
			mes "随时来拜访我们。";
			npctalk "......", "Bodyguard Crux#ep16_room01", bc_self;
			next;
			setquest 7684;// Visit the Nerius
			completequest 7684;// Visit the Nerius
			if (achievementinfo(130000, ACHIEVEINFO_COUNT2) == 0)
				achievementupdate(130000, ACHIEVEINFO_COUNT2, 1);
			break;
		case 1:
			completequest 7684;
			break;
		case 2:
			if (isbegin_quest(7685) == 1) {
				mes "[Spica]";
				mes "其他家族现在应该准备好了，很快就要行动。";
				mes "我们可能还有一点时间。";
				cutin "ep16_spica_nerius01.bmp",1;
				next;
				mes "[Spica]";
				mes "" + strcharinfo(0) + "，不如回房间等消息？";
				close3;
			}
			mes "[Spica]";
			mes "如果还没拜访完所有家族，不如去拜访其他家族？";
			close;
		}
		if (isbegin_quest(7682) == 1 && isbegin_quest(5402) == 2 && isbegin_quest(7683) == 2 && isbegin_quest(7684) == 2 && ep16_wal > 1 && ep16_wig > 1 && ep16_lug > 1 && ep16_gaobs > 1) {
			completequest 7682;// Socializing Starts from an Eye Contact
			setquest 7685;// What Is the Next Thing on the Schedule ?
			mes "[Spica]";
			mes "其他家族现在应该准备好了，很快就要行动。";
			mes "我们可能还有一点时间。";
			cutin "ep16_spica_nerius01.bmp",1;
			next;
			mes "[Spica]";
			mes "" + strcharinfo(0) + "，不如回房间等消息？";
			close3;
		}
		cutin "ep16_spica_nerius01.bmp",1;
		mes "[Spica]";
		mes "我们现在必须为宴会做准备。换装需要一些时间。";
		next;
		mes "[Spica]";
		mes "如果还没拜访完所有家族，不如去拜访其他家族？";
		next;
		mes "[Spica]";
		mes "我会另发一份正式邀请函给你作为补偿。";
		close3;
	}
	if (ep16_royal < 7)
		end;
	if (ep16_royal == 7) {
		mes "[Spica]";
		mes "我从斯基娅那里简单听说了这件事。";
		mes "尼希尔大人一定天生不胜酒力。";
		cutin "ep16_spica_nerius01",1;
		next;
		mes "[Spica]";
		mes "你没有隐瞒什么吧？";
		next;
		if (select( "我看到了可疑的人。", "没有。" ) == 2) {
			mes "[Spica]";
			mes "你在撒谎。";
			mes "无论如何，我得把这件事告诉长辈。";
			cutin "ep16_spica_nerius02",1;
			next;
			mes "[Spica]";
			mes "不知道那些老人会不会听我说。";
			close3;
		}
		mes "[Spica]";
		mes "斯基娅告诉了我类似的事。";
		mes "克鲁克斯没查到多少。";
		next;
		mes "[Spica]";
		mes "我想一些可疑人物一定混进了为宴会雇用的临时工里。";
		next;
		cutin "ep16_spica_nerius02",1;
		mes "[Spica]";
		mes "……总之，我们得警告长辈。";
		close3;
	}
	if (ep16_royal < 17)
		end;
	mes "[Spica]";
	mes "很抱歉给你添了这么多麻烦。";
	mes "你卷入这场混乱真是不幸。";
	cutin "ep16_spica_nerius01",1;
	next;
	mes "[Spica]";
	mes "嗯，我这边也不顺利。";
	mes "王室正在集中调查幕后操纵者。";
	next;
	mes "[Spica]";
	mes "……他们能做的只是找出潜入宫殿的傀儡。";
	mes "但总比什么都不做强。";
	mes "现在……那么。";
	next;
	select("斯基娅在哪里？");
	mes "[Spica]";
	mes "她去和尼希尔大人一起玩了！";
	mes "我不知道她看上了那个华而不实的美男子什么。";
	cutin "ep16_spica_nerius03",1;
	next;
	mes "[Spica]";
	mes "难道……";
	mes "难道是那样？";
	mes "她被他的外表迷住了吗？";
	mes "克鲁克斯，你回答我！";
	cutin "ep16_spica_nerius05",1;
	next;
	cutin "ep16_crux_findel03",2;
	mes "[Crux]";
	mes "什……什么？嗯……";
	mes "听起来有可能……";
	mes "顺便说，尼希尔大人正在接受监管，不该离开房间。";
	next;
	mes "[Spica]";
	mes "好吧，我纠正一下。她去尼希尔的房间找他了。";
	mes "……这不是一回事吗？";
	cutin "ep16_spica_nerius06",1;
	next;
	select("克鲁克斯，振作起来……");
	cutin "ep16_crux_findel03",2;
	mes "[Crux]";
	mes "哦，你现在要走了吗？";
	mes "在那位女士的脑袋爆炸前离开，确实是明智之举。";
	next;
	cutin "ep16_crux_findel02",2;
	mes "[Crux]";
	mes "回头见。";
	close2;
	cutin "",255;
	npctalk "你为什么让客人出去？", "", bc_self;
	setpcblock PCBLOCK_NPC, true;
	sleep2 3000;
	npctalk "是，是，小姐。我随时听候差遣。你在哪里？", "Bodyguard Crux#ep16_room01", bc_self;
	sleep2 3000;
	npctalk "你不是我要找的人！", "", bc_self;
	sleep2 3000;
	npctalk "我也要离开吗？", "Bodyguard Crux#ep16_room01", bc_self;
	sleep2 3000;
	npctalk "我不是那个意思！", "", bc_self;
	sleep2 3000;
	setpcblock PCBLOCK_NPC, false;
	unittalk getcharid(3), "" + strcharinfo(0) + " : (Oh my, I'd better get out now.)", bc_self;
	end;
}

prt_cas_q,21,140,3	script	Bodyguard Crux#ep16_room01	4_EP16_CRUX,{
	cutin "ep16_crux_findel01",1;
	mes "[Crux]";
	mes "别在意我。";
	close3;
}

prt_cas_q,23,133,2	script	Nyhill M. Heine#ep16_nroom01	4_EP16_NIHIL,{
	if (ep16_royal == 16) {
		cutin "ep16_nihi_miseria_heine01",2;
		mes "[Nyhill]";
		mes "情况不太妙，我们最好现在就走。";
		close3;
	}
}

prt_cas_q,18,136,3	script	Spica Nerius#ep16_room02	4_EP16_SPICA,{
	if (ep16_royal == 15) {
		mes "[Spica]";
		mes "你走得真慢。";
		mes "我收到你回来的消息已经有一阵子了。";
		cutin "ep16_skia_shadow01",1;
		next;
		mes "[Spica]";
		mes "我邀请你没有特别的理由。";
		mes "只是他们一直召集会议，讨论仪式期间发生的事。";
		next;
		cloakoffnpcself( "Nyhill M. Heine#ep16_nroom01" );
		mes "[Spica]";
		mes "海涅家族的家主来了。";
		mes "考虑到你正在禁闭，你似乎行动得相当自由。";
		next;
		mes "[Nyhill]";
		mes "……？";
		mes "" + strcharinfo(0) + "，我有话要告诉你。";
		mes "至于禁闭，只要我待在王室别墅的西翼就没问题……";
		cutin "ep16_nihi_miseria_heine01",2;
		next;
		mes "[Nyhill]";
		mes "对了，斯基娅？你在做什么？";
		mes "……";
		next;
		mes "[Spica]";
		mes "斯基娅？";
		mes "她现在不在这里。";
		cutin "ep16_skia_shadow03",0;
		next;
		mes "[Nyhill]";
		mes "哦，一定是这样。";
		mes "影子职责。";
		mes "这是怎么回事？";
		cutin "ep16_nihi_miseria_heine01",2;
		next;
		mes "[Skia]";
		mes "……你怎么一眼就看出来了？";
		mes "我被识破了。";
		mes "我是不是什么糟糕的演员？";
		cutin "ep16_skia_shadow04",0;
		next;
		mes "[Nyhill]";
		mes "即使是双胞胎，你们看起来也不完全一样。";
		mes "我只是注意到了一些差异。";
		cutin "ep16_nihi_miseria_heine02",2;
		next;
		mes "[Skia]";
		mes "真的吗？你这么说我很荣幸。";
		mes "我很高兴你看的是我，而不是斯皮卡。";
		cutin "ep16_skia_shadow05",0;
		next;
		select("你为什么穿成这样？");
		mes "[Skia]";
		mes "嗯……这是为了保护将成为尼鲁斯家族家主的斯皮卡。";
		mes "有时我会代替斯皮卡出面。";
		cutin "ep16_skia_shadow01",0;
		next;
		mes "[Skia]";
		mes "姐姐从母亲那里学习家主必须知道的事时，";
		mes "我学习了隐藏和战斗。";
		cutin "ep16_skia_shadow02",0;
		next;
		mes "[Skia]";
		mes "所以人们称我为影之公主。";
		mes "这是我第一次在光明中参加正式活动。";
		next;
		mes "[Skia]";
		mes "总之，斯皮卡现在出去办事了，我来代替她。";
		mes "我得展现她如何优雅地参加王室宴会。";
		cutin "ep16_skia_shadow04",0;
		next;
		mes "[Nyhill]";
		mes "多亏斯皮卡小姐，我现在可以尽可能自由地走动……";
		cutin "ep16_nihi_miseria_heine01",2;
		next;
		mes "[Nyhill]";
		mes "她什么时候回来？";
		mes "代表会议已经结束了……";
		next;
		select("你为什么来这里？");
		mes "[Nyhill]";
		mes "我是来告诉你有一项任务要交给你。";
		next;
		cutin "ep16_nihi_miseria_heine04",2;
		mes "[Nyhill]";
		mes "准确地说，我听说你要拜访尼鲁斯家族，所以主动来了。";
		npctalk "……房间里太闷了。", "Nyhill M. Heine#ep16_nroom01";
		next;
		cutin "ep16_skia_shadow03",0;
		mes "[Skia]";
		mes "一定是关于仪式期间发生的事件吧？";
		mes "英雄和王室家族的事务有什么关系？";
		next;
		cutin "ep16_nihi_miseria_heine01",2;
		mes "[Nyhill]";
		mes "你之后可以问斯皮卡。";
		mes "她当时也在会议上。";
		next;
		mes "[Nyhill]";
		mes "这段对话太长了。";
		mes "请先去见我的祖父和父亲。";
		next;
		mes "[Nyhill]";
		mes "他们一定在等你。";
		next;
		cutin "ep16_skia_shadow04",0;
		mes "[Skia]";
		mes "嗯……我明白了。斯皮卡回来后，我会让她告诉我详情。";
		next;
		cutin "ep16_nihi_miseria_heine01",2;
		mes "[Nyhill]";
		mes "那么，我们走吧。";
		next;
		cutin "ep16_skia_shadow04",0;
		mes "[Skia]";
		mes "" + strcharinfo(0) + "，请稍后再来看我！";
		ep16_royal = 16;
		setquest 7698;// Heine Now
		erasequest 7697;// Invitation from the Nerius
		close3;
	}
	if (ep16_royal == 16) {
		mes "[Skia]";
		mes "我得等斯皮卡回来并换衣服。";
		mes "现在不能离开。";
		cutin "ep16_skia_shadow04",1;
		next;
		mes "[Skia]";
		mes "我这样出去，路上遇到斯皮卡会怎样？";
		mes "我们会有麻烦的。";
		close3;
	}
	end;
OnInit:
	cloakonnpc();
	cloakonnpc "Nyhill M. Heine#ep16_nroom01";
	end;
}

prt_cas_q,23,187,3	script	Mysterious Person#ep16wal	4_M_04,{
	end;
OnInit:
	cloakonnpc();
	end;
}

// Walther
prt_cas_q,20,184,3	script	Ian Walther#ep16wal	1_M_JOBTESTER,5,5,{
	if (BaseLevel < 100) {
		mes "[Ian]";
		mes "你这个小子在这里做什么？";
		mes "趁我叫人把你拖出去之前，马上滚出去！";
		close;
	}
	if (ep16_wal == 0) {
		if (isbegin_quest(7682) != 1) {
			mes "[Ian]";
			mes "你是怎么进来的？";
			mes "只有获准的人才能来这里。";
			next;
			mes "[Ian]";
			mes "趁我叫人把你拖出去之前，马上滚出去！";
			close;
		}
		mes "[Ian]";
		mes "你就是受邀参加宴会的英雄？准确地说，是王室议会的宾客。";
		mes "幸会。我是^0000cd伊恩·沃尔特^000000。";
		next;
		mes "[Ian]";
		mes "虽然^0000cd沃尔特家族不参加王室议会^000000，仍以七大王室家族之一的身份参加宴会。";
		next;
		mes "[Ian]";
		mes "这是^0000cd沃尔特家族继承人伊森霍诺尔^000000，我的侄子。";
		next;
		mes "[Ian]";
		mes "他今年成年后将成为家主。目前由我负责家族事务。";
		next;
		mes "[Isenhonor]";
		mes "你好。我是^0000cd伊森霍诺尔·沃尔特^000000。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "既然有继承人，你们为什么不参加王室议会？";
		next;
		mes "[Ian]";
		mes "不知道你是否知道，^0000cd我们家族的候选人在^0000cd上一次王室议会^000000中卷入了不幸事件^000000。";
		next;
		mes "[Ian]";
		mes "王位候选人^0000cd伊森阿姆^000000突然变得暴力。^0000cd最后被乔博格家族的继承人杀死^000000。";
		next;
		mes "[Ian]";
		mes "讨论后，我们家族决定这次不参加^0000cd王室议会^000000。";
		next;
		mes "[Isenhonor]";
		mes "......";
		next;
		mes "[Ian]";
		mes "那么，希望你享受宴会。毕竟这场宴会就是为你举办的。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "好的。谢谢你抽时间陪我。";
		setquest 14469;// Look around the Walther Family
		ep16_wal = 1;
		close;
	}
	if (ep16_wal == 1)
		callsub S_Mysterious;
	mes "[Ian]";
	mes "你享受宴会吗？";
	mes "希望你喜欢这场为你举办的宴会。";
	close;

S_Mysterious:
	if (isbegin_quest(14516) != 2) {
		cloakoffnpcself( "Mysterious Person#ep16wal" );
		mes "[Man from the Richard]";
		mes "好久不见，伊恩。";
		next;
		mes "[Ian]";
		mes "你为什么在这里？我以为我们说好^0000cd上次王室议会后永远不再见面^000000。";
		next;
		mes "[Man from the Richard]";
		mes "我记得，但你们家族的继承人最近很忙。";
		next;
		mes "[Man from the Richard]";
		mes "他一直四处调查，事情都传到我这里来了。";
		mes "似乎没人太在意，但谁知道呢。";
		next;
		mes "[Ian]";
		mes "我告诉伊森霍诺尔^0000cd停止调查他哥哥的死^000000。";
		next;
		mes "[Man from the Richard]";
		mes "他应该停止。如果^0000cd我们要杀死乔博格家族帝国候选人^000000的事实泄露，我们都会有麻烦。";
		next;
		mes "[Ian]";
		mes "没人知道这件事。";
		mes "^0000cd计划毁了^000000，伊森阿姆在暴走时被杀。";
		next;
		mes "[Man from the Richard]";
		mes "我很遗憾你们的继承人遭遇不幸。";
		next;
		mes "[Ian]";
		mes "只要能带领家族走好，我不在乎谁成为继承人。";
		mes "不过我不明白一向表现良好的伊森阿姆为什么会那样做……";
		next;
		mes "[Ian]";
		mes "他在即将被选为国王时一定察觉到了什么……现在已经无从得知……";
		mes "听说乔博格从那以后也一直保持沉默。";
		next;
		mes "[Man from the Richard]";
		mes "是的，大家都这么说。";
		next;
		mes "[Ian]";
		mes "既然伊森阿姆被乔博格杀死，^0000cd沃尔特家族这次被排除在王室议会之外^000000。";
		mes "他是个好孩子。真遗憾，他本是完美的王位候选人。";
		next;
		mes "[Man from the Richard]";
		mes "重要的是，只要我们都保持沉默，真相就永远不会被发现。";
		mes "那么，我想我们再也不会见面了。";
		next;
		mes "[Man from the Richard]";
		mes "一定要警告你的继承人别再调查这件事。";
		mes "如果事情曝光，我的家族可以否认。";
		next;
		mes "[Man from the Richard]";
		mes "不过伊恩，你也是家族成员，会陷入麻烦，因为现在没有留下证人或证据。";
		next;
		mes "[Ian]";
		mes "你在威胁我吗？";
		next;
		mes "[Man from the Richard]";
		mes "嘘……你最好小声点。你的继承人可能会听见。";
		mes "我是说，我们应该小心。";
		next;
		mes "[Man from the Richard]";
		mes "好了，我不能离开太久。现在回去了。";
		next;
		cloakonnpcself( "Mysterious Person#ep16wal" );
		mes "[Ian]";
		mes "啊……怎么敢……！";
		mes "我一开始就不该和他合作。我白白失去了可怜的侄子。";
		setquest 14516;// Suspicious Shadow
		completequest 14516;// Suspicious Shadow
		close;
	}
	return;

OnTouch:
	if (ep16_wal == 1)
		callsub S_Mysterious;
	end;
}

prt_cas_q,14,184,5	script	Isenhonor Walther#ep16wal	4_M_1STPRIN1,{
	if (checkweight(1304,3) == 0) {

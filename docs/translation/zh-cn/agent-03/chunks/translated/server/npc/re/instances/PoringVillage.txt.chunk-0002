	mapannounce 'map_begi$, "波利王：不好意思……但是……你能现在回去吗？……", bc_map, 0xFFFF;
	sleep 2000;
	mapannounce 'map_begi$, "Emily：什么？你是谁？", bc_map, 0xFFFF00;
	sleep 2000;
	mapannounce 'map_begi$, "波利王：我是波利村的首领。抱歉这么晚才自我介绍。", bc_map, 0xFFFF;
	sleep 2000;
	mapannounce 'map_begi$, "波利王：我们的传单可能有些误会。这个村子很穷，没有任何值钱的东西。", bc_map, 0xFFFF;
	sleep 2000;
	mapannounce 'map_begi$, "Emily：我再逛逛后自然会判断……", bc_map, 0xFFFF00;
	sleep 2000;
	mapannounce 'map_begi$, "波利王：唉……我不喜欢战斗，但别无选择。", bc_map, 0xFFFF;
	sleep 2000;
	monster 'map_begi$,182,194,"--en--","PORING",10;
	for ( .@i = 0; .@i < 10; ++.@i ) {
		setunitdata $@mobid[.@i], UMOB_MODE, (MD_CANMOVE | MD_LOOTER | MD_AGGRESSIVE | MD_CANATTACK);
		setunitdata $@mobid[.@i], UMOB_SPEED, 200;
	}
	monster 'map_begi$,182,194,"--en--","MD_KING_PORING",1, instance_npcname("poring_village_3") + "::OnBossDead";
	end;
OnBossDead:
	if (mobcount( 'map_begi$, instance_npcname("poring_village_3") + "::OnBossDead" ) > 0)
		end;
	killmonster 'map_begi$, instance_npcname("poring_village_3") + "::OnBossDead";
	enablenpc instance_npcname("#gift");
	end;
}

1@begi,117,108,5	script	Blue Light Column#1	4_ENERGY_BLUE,4,4,{
	end;
OnTouch:
	switch( rand(3) ) {
	case 0:
		unittalk getcharid(3), "" + strcharinfo(0) + "：哦哦哦！！！放出里面的鹦鹉！！！！";
		break;
	case 1:
		unittalk getcharid(3), "" + strcharinfo(0) + "：我觉得现在啄人也没关系！！";
		break;
	case 2:
		unittalk getcharid(3), "" + strcharinfo(0) + "：你被疯狂的鹦鹉咬过吗？";
		break;
	}
	transform 1629,60000;
	specialeffect2 EF_ENHANCE;
	sc_start SC_GLASTHEIM_STATE,30000,20;
	end;
}

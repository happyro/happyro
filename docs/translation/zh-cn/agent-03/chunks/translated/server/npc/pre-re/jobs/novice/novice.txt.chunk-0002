			mes "位于屏幕底部。";
			mes "";
			next;
			mes "[Kris]";
			mes "聊天窗口右下角有两个蓝色按钮。左侧按钮可以更改聊天选项。";
			next;
			mes "[Kris]";
			mes "‘^3355FF发送给所有人^000000’选项";
			mes "可以和屏幕上的所有人聊天。";
			mes "";
			next;
			mes "[Kris]";
			mes "‘^3355FF发送给队伍^000000’和‘^3355FF发送给公会^000000’选项可以只向队伍或公会成员发送消息，无论他们距离多远。";
			next;
			mes "[Kris]";
			mes "你可以拖动聊天窗口右侧的滚动条查看对话。聊天窗口一直处于活动状态，因此和其他玩家交流不会有问题。";
			mes "";
			next;
			mes "[Kris]";
			mes "现在，最重要的界面之一是位于屏幕右上角的^3355FF小地图^000000。";
			next;
			mes "[Kris]";
			mes "小地图上的红点表示连接不同区域的^3355FF传送门^000000位置。";
			next;
			mes "[Kris]";
			mes "如果加入了队伍或公会，小地图还会显示同一地图上队伍或公会成员的位置。";
			next;
			mes "[Kris]";
			mes "请点击基本信息窗口右侧的菜单按钮，熟悉其他界面。";
			mes "";
			next;
			mes "[Kris]";
			mes "这就是游戏界面的简要介绍。现在信息可能很多，但很快就会变得自然。";
			if (JobLevel < 7) {
				next;
				mes "[Kris]";
				mes "我给你一些职业经验。打开技能窗口，把技能点分配到^3355FF基础技能^000000。";
				set nov_get_item02,11;
				switch (JobLevel) {
				case 1: getexp 0,10; break;
				case 2: getexp 0,18; break;
				case 3: getexp 0,28; break;
				case 4: getexp 0,40; break;
				case 5: getexp 0,91; break;
				case 6: getexp 0,151; break;
				}
			}
			else {
				mes "[Kris]";
				mes "你的职业等级比我预期的高很多。你现在应该已经了解基础信息了。";
			}
			next;
			mes "[Kris]";
			mes "现在去和Edwin谈谈吧。他会教你更多技能基础用法。还有，送你一件小礼物：破旧的初心者忍者服！";
			set nov_get_item02,12;
			getitem 2352,1; //Novice_Plate
			close;
		case 2:
			mes "[Kris]";
			mes "我带你去";
			mes "野外战斗";
			mes "训练课程。";
			mes "需要复习时随时可以回来。";
			close2;
			warp "new_1-2",28,178;
			end;
		case 3:
			emotion ET_PROFUSELY_SWEAT;
			close;
		}
	}
	else if (nov_get_item03 < 10) {
		mes "[Kris]";
		mes "我能帮你什么？";
		mes "可以看看你的登记证明吗？";
		next;
		mes "[Kris]";
		mes "你似乎还没参加技能信息课程。请和房间最左侧的导师交谈参加课程。";
		next;
		switch(select("谢谢！:我厌倦上课了～:取消")) {
		case 1:
			mes "[Kris]";
			mes "参加技能信息课程能帮助你更好地理解技能使用。";
			next;
			mes "[Kris]";
			mes "技能使用对在米德加尔特生存至关重要，强烈建议你参加课程。来，我带你去。";
			close2;
			warp "new_1-2",84,107;
			end;
		case 2:
			mes "[Kris]";
			mes "我明白了。那你一定准备好参加野外战斗训练课程了。现在送你过去吗？";
			next;
			if (select("不！等、等等！:请送我过去～！") == 1) {
				mes "[Kris]";
				mes "...?!";
				mes "好……吧。";
				mes "准备好后";
				mes "再回来。";
				close;
			}
			else {
				mes "[Kris]";
				mes "愿你好运，";
				mes "年轻的初心者。";
			mes "";
				close2;
				warp "new_1-2",28,178;
				end;
			}
		case 3:
			emotion ET_PROFUSELY_SWEAT;
			close;
		}
	}
	else if (nov_get_item04 < 10) {
		mes "[Kris]";
		mes "我能帮你什么？";
		mes "可以看看你的登记证明吗？";
		next;
		mes "[Kris]";
		mes "你似乎还没参加物品信息课程。请和房间最右侧的导师交谈参加课程。";
		next;
		switch(select("谢谢。:我厌倦上课了～:取消")) {
		case 1:
			mes "[Kris]";
			mes "物品信息课程能帮助你学习使用快捷键和快捷栏。来，我带你去。";
			close2;
			warp "new_1-2",115,107;
			end;
		case 2:
			mes "[Kris]";
			mes "我明白了。那你一定准备好参加野外战斗训练课程了。现在送你过去吗？";
			next;
			if (select("不！等、等等！:请送我过去～！") == 1) {
				mes "[Kris]";
				mes "...?!";
				mes "好……吧。";
				mes "准备好后再回来。";
				close;
			}
			else {
				mes "[Kris]";
				mes "愿你好运，";
				mes "年轻的初心者。";
				close2;
				warp "new_1-2",28,178;
				end;
			}
		case 3:
			emotion ET_PROFUSELY_SWEAT;
			close;
		}
	}
}

new_1-2,83,111,3	script	Skill Tutor#nv	753,{
	if (nov_get_item02 > 9 && nov_get_item03 > 9 && nov_get_item04 > 9) {
		mes "[Cecil]";
		mes "Huh...?";
		mes "还需要帮助吗？";
		mes "你已经完成所有基础课程。也和助教谈过了吗？";
		next;
		switch(select("送我去下一门课程！:助教？:带我去城镇！")) {
		case 1:
			mes "[Cecil]";
			mes "啊！对，对。";
			mes "你总得参加野外战斗训练课程。";
			next;
			mes "[Cecil]";
			mes "真羡慕野外战斗训练课程的教官。教基础知识一点也没有打怪那么酷。";
			next;
			mes "[Cecil]";
			mes "啊，对了。";
			mes "野外战斗。";
			mes "现在送你过去。";
			mes "祝你好运，小家伙！";
			close2;
			warp "new_1-2",28,178;
			end;
		case 2:
			mes "[Cecil]";
			mes "你知道";
			mes "助教吧？";
			next;
			mes "[Cecil]";
			mes "听着。这个房间里的三位导师只教最基础的信息，课程本来就应该快速完成。";
			next;
			mes "[Cecil]";
			mes "但有些人学习更详细的信息会更有帮助。";
			next;
			mes "[Cecil]";
			mes "如果你刚接触Ragnarok，至少参加一次助教的课程也无妨。";
			next;
			mes "[Cecil]";
			mes "Leo Handerson似乎很了解技能，我想他的知识对你有用。";
			close;
		case 3:
			mes "[Cecil]";
			mes "城镇……？";
			mes "我看起来像你的私人小鸟吗？";
			next;
			mes "[Cecil]";
			mes "对了，你可能太年轻，不知道这些。想去城镇就和右边的卡普拉小姐谈谈，好吗？";
			close;
		}
	}
	if (nov_get_item03 < 10) {
		mes "[Cecil]";
		mes ""+strcharinfo(0)+"";
		mes "嘿，我喜欢你的名字！";
		if (NEW_MES_FLAG0) {
			mes "顺便说，你的登记证明过期了，我给你一张新的。";
			mes "给你新的。";
			set NEW_MES_FLAG0,0;
			set NEW_MES_FLAG1,0;
			set NEW_MES_FLAG2,0;
			set NEW_MES_FLAG3,0;
			set NEW_MES_FLAG4,0;
			set NEW_MES_FLAG5,0;
			set NEW_LVUP0,0;
			set NEW_LVUP1,0;
			set NEW_JOBLVUP,0;
		}
		mes "那么，开始课程吧？";
		next;
		switch(select("你教什么？:我现在想参加野外战斗训练！:取消")) {
		case 1:
			mes "[Cecil]";
			mes "我为力量而生，";
			mes "也为力量而死！";
			mes "我要教你";
			mes "我著名的致命一击！";
			next;
			mes "[Cecil]";
			mes "我只是逗你玩！";
			mes "其实我只是教你如何使用技能。不过我仍然为力量而活。";
			next;
			mes "[Cecil]";
			mes "在基本信息窗口点击^3355FF技能^000000按钮打开技能窗口。也可以同时按‘^3355FFAlt^000000’和‘^3355FFS^000000’键。";
			next;
			mes "[Cecil]";
			mes "打开技能窗口后，";
			mes "你会看到标有‘^3355FF基础技能^000000’的图标。";
			mes "";
			mes "";
			if (JobLevel < 7) {
				next;
				mes "[Cecil]";
				mes "技能窗口底部会显示剩余技能点数量。";
				next;
				mes "[Cecil]";
				mes "打开技能窗口（‘Alt’+‘S’），点击基础技能图标旁的‘^3355FF升级^000000’按钮，将技能点分配给基础技能。";
				set nov_get_item03,10;
				switch (JobLevel) {
				case 1: getexp 0,10; break;
				case 2: getexp 0,18; break;
				case 3: getexp 0,28; break;
				case 4: getexp 0,40; break;
				case 5: getexp 0,91; break;
				case 6: getexp 0,151; break;
				}
			}
			else {
				next;
				mes "[Cecil]";
				mes "咦。你的职业等级比我想的高。看来你已经了解技能基础了。";
			}
			next;
			mes "[Cecil]";
			mes "你把技能点分配给基础技能了吗？最终需要掌握基础技能，早点分配是个好主意。";
			next;
			mes "[Cecil]";
			mes "想了解更多技能信息，就去找助教Leo Handerson。";
			next;
			mes "[Cecil]";
			mes "哦，我差点忘了！";
			mes "让我教你^3355FF急救^000000技能。危险时这个技能会帮你很多。";
			next;
			mes "^3355FF你学会了^4A708B急救^3355FF技能。^000000";
			mes "";
			skill "NV_FIRSTAID",1,SKILL_PERM;
			set NOV_SK,3;
			set nov_get_item03,11;
			next;
			if (JobLevel < 7) {
				mes "^3355FF你获得了少量";
				mes "职业经验。^000000";
				set nov_get_item03,12;
				switch (JobLevel) {
				case 1: getexp 0,10; break;
				case 2: getexp 0,18; break;
				case 3: getexp 0,28; break;
				case 4: getexp 0,40; break;
				case 5: getexp 0,91; break;
				case 6: getexp 0,151; break;
				}
			}
			next;
			mes "[Cecil]";
			mes "现在打开技能窗口，";
			mes "确认是否有^3355FF急救^000000图标。双击图标即可使用。";
			mes "现在试试看！";
			percentheal -50,0;
			next;
			mes "[Cecil]";
			mes "急救等主动技能需要SP才能使用。急救对初心者很有用，因为它能恢复少量HP。";
			next;
			mes "[Cecil]";
			mes "你是个好学生，";
			mes "所以我要奖励你！";
			if (BaseLevel < 8) {
				mes "看，额外经验！";
				set nov_get_item03,13;
				switch (BaseLevel) {
				case 1: getexp 10,0; break;
				case 2: getexp 17,0; break;
				case 3: getexp 26,0; break;
				case 4: getexp 37,0; break;
				case 5: getexp 78,0; break;
				case 6: getexp 115,0; break;
				case 7: getexp 155,0; break;
				}
			}
			else {
				next;
				mes "[Cecil]";
				mes "等等，你的等级比我想的高很多。不过我还是为你骄傲！";
			}
			next;
			mes "[Cecil]";
			mes "基础要点就这些。如果想要更全面的课程，就去找助教。";
			mes "";
			next;
			switch(select("好。:现在送我去野外战斗训练！:取消")) {
			case 1:
				mes "[Cecil]";
				mes "训练场里的每个人";
				mes "都很愿意帮助你。";
				mes "祝你好运！";
				mes "";
				close;
			case 2:
				mes "[Cecil]";
				mes "Heh heh~!";
				mes "好，熟能生巧！我送你去野外战斗训练的教官那里。保重！";
				close2;
				warp "new_1-2",28,178;
				end;
			case 3:
				emotion ET_HUK;
				close;
			}
		case 2:
			mes "[Cecil]";
			mes "Heh heh~!";
			mes "好啦，熟能生巧！我送你去野外战斗训练找那些人。保重！";
			close2;
			warp "new_1-2",28,178;
			end;
		case 3:
			emotion ET_HUK;
			close;
		}
	}
	else if (nov_get_item02 < 10) {
		mes "[Cecil]";
		mes "那么，我能为你做些什么";
		mes "我能帮你吗？";
		mes "哇，你还没参加基础界面课程？那门课有点无聊～";
		next;
		switch(select("哦，我最好去上课。:送我去野外战斗训练。:取消")) {
		case 1:
			mes "[Cecil]";
			mes "这是个好主意。上课时还能获得经验和物品。界面导师就在房间中央，去吧～";
			close;
		case 2:
			mes "[Cecil]";
			mes "Heh heh~!";
			mes "好，熟能生巧！我送你去野外战斗训练的教官那里。保重！";
			close2;
			warp "new_1-2",28,178;
			end;
		case 3:
			emotion ET_HUK;
			close;
		}
	}
	else if (nov_get_item04 < 10) {
		mes "[Cecil]";
		mes "So how may";
		mes "我能帮你吗？";
		mes "哇，你还没参加物品信息课程？那门课有点无聊～";
		next;
		switch(select("哦，我最好去上课。:送我去野外战斗训练。:取消")) {
		case 1:
			mes "[Cecil]";
			mes "这是个好主意。上课时还能获得经验和物品。物品导师就在房间最右边，去吧～";
			close;
		case 2:
			mes "[Cecil]";
			mes "Heh heh~!";
			mes "好，熟能生巧！我送你去野外战斗训练的教官那里。保重！";
			close2;
			warp "new_1-2",28,178;
			end;
		case 3:
			emotion ET_HUK;
			close;
		}
	}
}

new_1-2,115,111,3	script	Item Tutor#nv	726,{
	if (nov_get_item02 > 9 && nov_get_item03 > 9 && nov_get_item04 > 9) {
		mes "[Alice]";
		mes "Huh...?";
		mes "需要我帮你找人吗？你似乎完成了所有基础课程。你要去哪里？";
		next;
		switch(select("我不确定～！:送我去城镇。:取消")) {
		case 1:
			mes "[Alice]";
			mes "Hmm...";
			mes "你已经学完其他内容，";
			mes "所以只剩野外战斗训练了。现在要参加吗？";
			next;
			switch(select("是。:哦，等、等等。")) {
			case 1:
				mes "[Alice]";
				mes "记得随身携带我给你的物品，并装备好所有防具，明白吗？现在，保重。";
				close2;
				warp "new_1-2",28,178;
				end;
			case 2:
				mes "[Alice]";
				mes "好，没问题。";
				mes "需要帮助时";
				mes "就来找我。";
				close;
			}
		case 2:
			mes "[Alice]";
			mes "啊，我明白了。";
			mes "想去城镇的话，我右边的卡普拉小姐会传送你。现在保重～";
			close;
		case 3:
			mes "[Alice]";
			mes "哼……！";
			close;
		}
	}
	else if (nov_get_item04 < 10) {
		mes "[Alice]";
		mes "^666666*哈欠～*^000000";
		mes "真无聊。";
		mes "哦！你好，你是新来的。";
		if (NEW_MES_FLAG0) {
			mes "哦，你的登记证明过期了。不过没关系，我给你一张新的！给你。";
			set NEW_MES_FLAG0,0;
			set NEW_MES_FLAG1,0;
			set NEW_MES_FLAG2,0;
			set NEW_MES_FLAG3,0;
			set NEW_MES_FLAG4,0;
			set NEW_MES_FLAG5,0;
			set NEW_LVUP0,0;
			set NEW_LVUP1,0;
			set NEW_JOBLVUP,0;
		}
		mes "那么，你是来参加";
		mes "我的物品信息课程吗？";
		next;
		switch(select("是！:不了，谢谢。:怎样去城镇？")) {
		case 1:
			mes "[Alice]";
			mes "别担心，很快就结束。";
			mes "通过基本信息窗口的‘^3355FF物品^000000’按钮打开物品窗口，";
			mes "也可以同时按‘^3355FFAlt^000000’和‘^3355FFE^000000’键。";
			next;
			mes "[Alice]";
			mes "物品窗口中有^3355FF物品^000000、^3355FF装备^000000和^3355FF其他^000000三个标签。可消耗物品位于^4A708B物品^000000标签。";
			next;
			mes "[Alice]";
			mes "现在点击物品窗口的^4A708B物品^000000标签。我刚给你一瓶初心者药水。双击即可饮用。试试看！";
			set nov_get_item04,10;
			getitem 569,1; //Novice_Potion
			percentheal -50,0;
			next;
			mes "[Alice]";
			if (countitem(569) < 1) {
				if (BaseLevel < 8) {
					mes "不错～！";
					mes "这是给你的";
					mes "小奖励，";
					mes "感谢你听课。";
					set nov_get_item04,11;
					switch (BaseLevel) {
					case 1: getexp 10,0; break;
					case 2: getexp 17,0; break;
					case 3: getexp 26,0; break;
					case 4: getexp 37,0; break;

1@rgsr,127,164,3	script	Aas#rgsr4	4_EP17_AS,{
	if ('rgsr != 15)
		end;
	cutin "ep171_as01",2;
	mes "[Aas]";
	mes "里面剩下的事情Est都处理好了。";
	mes "抱歉完全没能帮上你。";
	next;
	mes "[Aas]";
	mes "回艾因布洛克吧。";
	mes "我……我会去办公室和你会合。";
	next;
	.@s = select("前往艾因布洛克。:前往莱赫伦。:暂时留下。" );
	if (.@s == 3) {
		cutin "ep171_as02",2;
		mes "[Aas]";
		mes "还有其他要调查的吗？";
		mes "我会在这里等。";
		close3;
	}
	mes "[Aas]";
	mes "我们会在子弹猫等你。";
	mes "请去那里，在总部与我们会合。";
	completequest 7862;
	close2;
	if (.@s == 1)
		warp "einbroch",301,324;
	else
		warp "lighthalzen",54,272;
	end;
}


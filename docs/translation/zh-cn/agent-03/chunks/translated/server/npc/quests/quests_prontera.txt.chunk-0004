mjolnir_01,313,269,5	script	Dazed Boy#prt	706,{
	if (prt_curse == 11) {
		mes "[Absent-Minded Boy]";
		mes "巨蛇吞下了大海。彩虹之鹰吞下了巨蛇。然后蛇鳞在鹰身上长出，它慢慢死去。";
		next;
		mes "[Exhausted-Looking Woman]";
		mes "天啊……！你能别再唱那首歌了吗？";
		next;
		mes "[Absent-Minded Boy]";
		mes "..................";
		next;
		mes "^3355FFThe little boy quietly";
		mes "盯着女人看了一会儿，然后蹲下抚摸身边的狗。^000000";
		next;
		if (select("你刚唱了什么？:不理他们") == 1) {
			mes "[Absent-Minded Boy]";
			mes "...";
			mes "......";
			mes ".........";
			next;
			mes "[Absent-Minded Boy]";
			mes "汪汪，你听过这首歌吗？妈妈教我唱的。她说人们唱了很久~";
			next;
			mes "^3355FF男孩继续把狗当作老朋友说话，";
			mes "无视你的存在，仿佛你根本不存在。^000000";
			mes "";
			mes "";
			next;
			mes "[Exhausted-Looking Woman]";
			mes "Kaanu……我怎么告诉你的，不要无视别人的问题！";
			next;
			mes "[Kaanu]";
			mes ".........";
			mes "..................";
			mes "糟糕，汪汪。妈妈似乎不知为何生气了。";
			next;
			mes "[Exhausted-Looking Woman]";
			mes "抱歉，我的孩子……你想了解那首歌吗？别担心，它只是一首古老的儿歌。";
			next;
			if (select("你为什么在这里？:我能再听一次那首歌吗？") == 1) {
				mes "[Exhausted-Looking Woman]";
				mes ".................";
				next;
				mes "^3355FF女人羞愧地抿紧嘴唇。";
				mes "显然这个话题让她非常不自在。^000000";
				mes "";
				mes "";
				next;
				mes "[Kaanu]";
				mes "...";
				mes "......";
				mes ".........";
				next;
				mes "[Kaanu]";
				mes "汪汪，你知道妈妈为什么总是这么悲伤吗？";
				mes "我真希望知道妈妈为什么从不微笑……";
				mes "";
				mes "";
				next;
				mes "[Exhausted-Looking Woman]";
				mes "........";
				set prt_curse,12;
				close;
			}
			mes "[Exhausted-Looking Woman]";
			mes "..................";
			next;
			mes "[Exhausted-Looking Woman]";
			mes "好吧。我可以为你做这件小事。";
			mes "让我背诵这首歌……";
			mes "";
			next;
			mes "[Exhausted-Looking Woman]";
			mes "巨蛇吞下了大海。";
			mes "彩虹之鹰";
			mes "吞下了巨蛇。然后蛇鳞在鹰身上长出，它慢慢死去。";
			set prt_curse,12;
			close;
		}
		mes "[Absent-Minded Boy]";
		mes "...";
		mes "......";
		mes ".........";
		close;
	}
	else if (prt_curse == 36) {
		mes "^3355FFThe little boy looked";
		mes "看起来非常疲惫、厌倦生活，年轻孩子脸上的神情令人不安。^000000";
		close;
	}
	else if (prt_curse == 45) {
		mes "^3355FFThe little boy still";
		mes "不会和你说话，但会通过与你对视来回应你的存在。";
			mes "与你对视并微笑。^000000";
		close;
	}
	else if (prt_curse > 54) {
		mes "^3355FFThe little boy still";
			mes "不会和你说话，但会用温暖的微笑让你感到受欢迎。^000000";
		close;
	}
	else {
		mes "[Absent-Minded Boy]";
		mes "...";
		mes "......";
		mes ".........";
		next;
		mes "^3355FFYou find it difficult";
			mes "无视小男孩投向你的探究、警惕目光。很明显，他不信任你。^000000";
		close;
	}
}


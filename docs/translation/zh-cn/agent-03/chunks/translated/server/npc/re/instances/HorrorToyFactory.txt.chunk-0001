1@xm_d,1,5,3	script	#alert1	CLEAR_NPC,{
	end;
OnStart:
	.@r = rand(1,10);
	if (.@r == 1)
		mapannounce 'xm_d_map$, "工厂广播：生产线上发现外来者。守卫请立即出动。",bc_map,"0x00ffff";
	else if (.@r == 2)
		mapannounce 'xm_d_map$, "工厂广播：已确认入侵者。识别代码 AX0829。类型：人类。将他们赶走。", bc_map, "0x00ffff";
	else if (.@r == 3)
		mapannounce 'xm_d_map$, "Guard's announcement: Please leave here immediately, outsiders.", bc_map, "0xffff00";
	else if (.@r == 4)
		mapannounce 'xm_d_map$, "工厂广播：外来者，举起双手投降。否则我会开枪。", bc_map, "0x00ffff";
	else if (.@r == 5)
		mapannounce 'xm_d_map$, "工厂广播：派出守卫。镇压入侵者。", bc_map, "0x00ffff";
	else if (.@r == 6)
		mapannounce 'xm_d_map$, "CAUTION: The plant manger is coming to inspect. Wipe out the outsiders.", bc_map, "0xff4444";
	else if (.@r == 7)
		mapannounce 'xm_d_map$, "工厂广播：情况不妙。检测到外来生物。守卫请动员。", bc_map, "0x00ff88";
	else if (.@r == 8)
		mapannounce 'xm_d_map$, "工厂广播：外来者或入侵者会妨碍工厂运作。必要时可以杀死他们。", bc_map, "0xff9999";
	else if (.@r == 9)
		mapannounce 'xm_d_map$, "工厂广播：好了，就这样，派对结束了！滚出我的房子！", bc_map, "0x00ffff";
	else
		mapannounce 'xm_d_map$, "Guard's announcement: Invaders are spotted! They seem human! I will blip them off!", bc_map, "0xffff00";
	end;
}

1@xm_d,10,24,0	script	alert#61	-1,10,10,{
	end;
OnTouch_:
	if (getstatus(SC_MONSTER_TRANSFORM,1) != 1246) {
		switch( atoi(strnpcinfo(2)) ) {
			case 63: case 66:
			case 69: case 72:
			case 79: case 82:
			case 85: case 88:
				.@count = 4;
				break;
			case 61: case 64:
			case 67: case 70:
			case 73: case 75:
			case 77: case 80:
			case 83: case 86:
			case 89:
				.@count = 6;
				break;
			default:
				.@count = 5;
				break;
		}
		getmapxy .@map$, .@x, .@y;
		.@npc_name$ = instance_npcname( strnpcinfo(0) );

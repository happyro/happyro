//===== rAthena Script =======================================
//= Horror Toy Factory
//===== Description: =========================================
//= [Official Conversion]
//= Horror Toy Factory Instance
//===== Changelogs: ==========================================
//= 1.0 First version. Uses official script structure and text
//=     from iRO. [Capuche]
//============================================================

xmas,237,303,3	script	Catherine Jet Johnson	4_F_SKULL06GIRL,{
	if (getstatus(SC_MONSTER_TRANSFORM,1) > 0) {
		mes "[Catherine Jet Johnson]";
		mes "啊……你要进去那里吗？";
		next;
		mes "[Catherine Jet Johnson]";
		mes "想进去的话最好解除变身。那可能很危险。";
		close;
	}

	if (BaseLevel < 140) {
		mes "[Catherine Jet Johnson]";
		mes "啊，等等！请等一下。这不是适合你这样的年轻"+ ( Sex ? "男士" : "女士" ) +"的地方！";
		next;
		mes "[Catherine Jet Johnson]";
		mes "如果一定要来，等变得更强后再回来。嗯……至少140级？";
		close;
	}

	mes "^ff0000请注意，驯服或其他非狩猎方式不会计入正常击杀数。^000000";
	next;
	mes "[Catherine Jet Johnson]";
	switch( isbegin_quest(12330) ) {
	case 0:
		mes "别、别怕我。我现在看起来很丑，但以前不是这样。";
		next;
		mes "^0000ff面前的骷髅脸女孩用哭泣的声音说话。眼睛本应存在的位置只剩空洞，正凝视着你。^000000";
		next;
		select("你的脸怎么了？");
		mes "[Catherine Jet Johnson]";
		mes "这是个很长的故事……你介意听我说吗？会不会浪费你和我这种人的时间？";
		next;
		if (select( "离开。", "请继续说。" ) == 1) {
			mes "[Catherine Jet Johnson]";
			mes "好吧，保重。千万别靠近那个奇怪的入口。";
			close;
		}
		mes "[Catherine Jet Johnson]";
		mes "嗯……我该从哪里开始……先讲这个城镇的故事？";
		next;
		mes "^0000ff女孩叹了口气，用讲述古老故事的吟游诗人般低沉的语调开始诉说。^000000";
		next;
		mes "[Catherine Jet Johnson]";
		mes "这个城镇有一家玩具工厂。镇上的人都在那里工作，我也是其中一员。";
		next;
		mes "[Catherine Jet Johnson]";
		mes "一开始我们都很幸福。下班后会聚在一起，一边吃姜饼、喝热茶，一边愉快聊天。";
		next;
		select("看到现在这样，真难想象……");
		mes "[Catherine Jet Johnson]";
		mes "是的，因为不可能永远靠包装玩具为生。村民三三两两离开后，情况变得艰难。";
		next;
		mes "[Catherine Jet Johnson]";
		mes "我曾是玩偶工匠的助手，陪他制作玩偶直到最后。";
		next;
		mes "^0000ffI could feel her slender jawbone is trembling due to the subtle change of her emotion.^000000";
		next;
		select("请她继续。");
		mes "[Catherine Jet Johnson]";
		mes "工厂决定关闭那天，玩偶工匠为最后制作的玩偶穿好衣服，流下了眼泪。";
		next;
		mes "[Catherine Jet Johnson]";
		mes "也许他以为再也不会制作玩偶了。";
		next;
		mes "[Catherine Jet Johnson]";
		mes "他给最后的玩偶取名^0000ff希琳·基米^000000，并停止了工厂的所有生产线。";
		next;
		select("他给玩偶取了名字？");
		mes "[Catherine Jet Johnson]";
		mes "对玩偶工匠来说，有时会像对待孩子一样倾注大量心血。基米就是他的孩子。";
		next;
		mes "[Catherine Jet Johnson]";
		mes "我想他的真诚赋予了基米生命。";
		next;
		select("你是说玩偶活着？");
		mes "[Catherine Jet Johnson]";
		mes "是的，^0000ff她^000000变成了活物。我不知道为什么，但她带着深沉的悲伤和愤怒在玩具工厂里游荡。";
		next;
		mes "[Catherine Jet Johnson]";
		mes "我第一次见到她时，她站在已经死亡倒下的玩偶工匠身边，面无表情。";
		next;
		mes "[Catherine Jet Johnson]";
		mes "事情就是这样。我昏迷后醒来时已经在外面，脸也变成了这样。";
		next;
		select("是基米做的吗？");
		mes "[Catherine Jet Johnson]";
		mes "我不知道……可能是她，也可能是其他问题。我对此毫无记忆。";
		next;
		select("你责怪她吗？");
		mes "[Catherine Jet Johnson]";
		mes "不，我不责怪她！我只是想知道那天玩偶工匠发生了什么。";
		next;
		mes "[Catherine Jet Johnson]";
		mes "我认为看到的场景并不是全部。但再次进入工厂……重新进去……";
		next;
		mes "[Catherine Jet Johnson]";
		mes "是的，我害怕也不愿意进去。如果有人能帮助我……";
		next;
		if (select( "我帮不上什么忙。", "也许我能帮你。" ) == 1) {
			mes "[Catherine Jet Johnson]";
			mes "谢谢你……谢谢你听我说。祝你旅途愉快……";
			close;
		}
		mes "[Catherine Jet Johnson]";
		mes "咦？你愿意帮我？";
		next;
		select("我们进入工厂吧。");
		mes "[Catherine Jet Johnson]";
		mes "我……嗯，除了指路什么也帮不了你。而且，这对你来说可能非常危险。";
		next;
		select("你可以和基米重逢，对吧？");
		mes "[Catherine Jet Johnson]";
		mes "Kimi，你是说 Kimi……";
		next;
		mes "^0000ff她睁大空洞的双眼，专注地思考着什么。^000000";
		next;
		mes "[Catherine Jet Johnson]";
		mes "我……我决定了。虽然帮不上太多，但可以告诉你方向。";
		next;
		mes "[Catherine Jet Johnson]";
		mes "等等，请等我准备好。准备好后我会为你带路。";
		setquest 12330;// Skull-faced Girl
		close;
	case 1:
		mes "好了。我试着打开那扇关闭的门。";
		completequest 12330;
		break;
	case 2:
		mes "基米的灵魂仍留在这片土地上。什么时候才能让她安息……";
		break;
	}
	next;
	if (getcharid(1) < 1) {
		mes "^0000ff需要组织至少两人的队伍才能进入恐怖玩具工厂。^000000";
		close;
	}
	switch( checkquest(12331,PLAYTIME) ) {
	case -1:
		if (is_party_leader() == false) {
			mes "[Catherine Jet Johnson]";
			mes "呃……等一下。我正在和负责人谈话，请稍等。";
			close;
		}
		if (select( "解锁恐怖玩具工厂", "取消" ) == 1) {
			mes "门很快就会……打开……请稍等。";
			instance_create("Horror Toy Factory");
		}
		close;
	case 0:
	case 1:
		mes "[Catherine Jet Johnson]";
		mes "工厂的防腐剂气味还没散去。现在不能进入。";
		next;
		mes "[Catherine Jet Johnson]";
		mes "防腐剂气味完全消失前，我不会让你进入。";
		close;
	case 2:
		mes "^0000ff防腐剂气味已消失。可以和凯瑟琳·杰特·约翰逊交谈。^000000";
		erasequest 12331;
		close;
	}
}

xmas,233,305,4	script	Factory Dimension Telep	PORTAL,{
	if (getstatus(SC_MONSTER_TRANSFORM,1) > 0) {
		mes "[Factory Dimension Teleporter]";
		mes "参观恐怖玩具工厂时有怪物工人实习项目。因此，^ff0000变身状态下无法进入。^000000";
		close;
	}
	if (BaseLevel < 140) {
		mes "[Factory Dimension Teleporter]";
		mes "你没有资格进行空间转移。至少需要140级。";
		close;
	}
	if (getcharid(1) < 1) {
		mes "[Factory Dimension Teleporter]";
		mes "没有支援吗？独自进入的话，请组队后再来。";
		close;
	}
	switch( checkquest(12331,PLAYTIME) ) {
	case -1:
		switch( instance_enter("Horror Toy Factory") ) {
		case 3:
			mes "发生未知错误。";
			close;
		case 2:
			mes "空间转移网关尚未激活。";
			close;
		case 1:// dummy
			mes "[Factory Dimension Teleporter]";
			mes "没有支援吗？独自进入的话，请组队后再来。";
			close;
		case 0:
			mapannounce "xmas", getpartyname( getcharid(1) ) +" party's party member "+ strcharinfo(0) +" has entered the Horror Toy Factory.", bc_map, "0x00ff99";
			setquest 12331;// Trail of Toy Factory
			end;
		}
	case 0:
	case 1:
		mes "你已经有空间转移轨迹。拒绝进入。";
		close;
	case 2:
		mes "^0000ff空间转移轨迹已消失。允许使用工厂空间传送器。^000000";
		erasequest 12331;
		close;
	}
}

1@xm_d,112,20,6	script	Catherine Jet Johnson#0	4_F_SKULL06GIRL,{
	if (getstatus(SC_MONSTER_TRANSFORM,1) > 0) {
		mes "[Catherine Jet Johnson]";
		mes "处于怪物变身状态时不能来这里。";
		next;
		mes "[Catherine Jet Johnson]";
		mes "请等变身结束。恢复正常前不能移动到其他区域。";
		close;
	}
	if (is_party_leader() == false) {
		mes "[Catherine Jet Johnson]";
		mes "呃……等一下。我正在和负责人谈话，请稍等。";
		close;
	}
	mes "[Catherine Jet Johnson]";
	mes "大家都处于凡人的脆弱状态，对吧？";
	npctalk "凯瑟琳·杰特·约翰逊：大家都处于凡人的脆弱状态，对吧？";
	next;
	switch( select( "退出故事", "听她的故事。", "我了解你的情况。快开始吧！" ) ) {
	case 1:
		mes "[Catherine Jet Johnson]";
		mes "哦，亲爱的。准备好后告诉我。";
		close;
	case 2:
		donpcevent instance_npcname("Catherine Jet Johnson#01") + "::OnStart";
		close;
	case 3:
		donpcevent instance_npcname("Catherine Jet Johnson#01") + "::OnStart2";
		close;
	}
}

1@xm_d,112,20,1	script	Catherine Jet Johnson#01	4_F_SKULL06GIRL,{
	end;
OnStart:
	enablenpc instance_npcname("#bgm01");
	enablenpc instance_npcname("Catherine Jet Johnson#01");
	disablenpc instance_npcname("Catherine Jet Johnson#0");
	sleep 3000;
		npctalk "凯瑟琳·杰特·约翰逊：这里是 1 号工厂。过去这里存放着准备作为礼物送出的玩具和娃娃。";
	sleep 5000;
	npctalk "凯瑟琳·杰特·约翰逊：啊，我想起一些事。如果有人没有穿员工制服，守卫就会过来训斥他们……";
	sleep 5000;
	npctalk "凯瑟琳·杰特·约翰逊：话说回来……";
	donpcevent instance_npcname("#fac1ct") + "::OnStart";
	sleep 3000;
	mapannounce 'xm_d_map$, "工厂广播：起床了，玩具工厂的工作时间到了……", bc_map, "0x00ff44";
	sleep 6000;
		npctalk "凯瑟琳·杰特·约翰逊：怎……怎么回事？到处游荡的不是人类工人，而是玩具和娃娃。就好像它们是员工……";
	sleep 5000;
	npctalk "凯瑟琳·杰特·约翰逊：我觉得其他灵魂已经在这座空工厂里寄居太久了。";
	sleep 3000;
	mapannounce 'xm_d_map$, "工厂广播：工作区域必须保持没有废弃物和其他杂物，以确保你始终安全。", bc_map, "0x00ff44";
	sleep 3000;
		npctalk "凯瑟琳·杰特·约翰逊：就像以前人类在这里工作时一样。";
	sleep 3000;
	mapannounce 'xm_d_map$, "工厂广播：今天让我们为每个孩子的梦想制作礼物。", bc_map, "0x00ff44";
	sleep 3000;
	npctalk "凯瑟琳·杰特·约翰逊：但现在还不是高兴的时候。找到最后一个工厂区域后，我们必须停止所有生产线。";
	sleep 1000;
	mapannounce 'xm_d_map$, "工厂广播：请启动 1 号生产线。别忘了戴安全帽！说的就是你，鲍勃！", bc_map, "0x00ff44";
	sleep 3000;
	npctalk "凯瑟琳·杰特·约翰逊：啊，也许我们应该把那些玩具和礼盒恢复成原来的样子。";
	sleep 5000;
	npctalk "凯瑟琳·杰特·约翰逊：咦？我的意思是……让它们恢复原状……对……我们需要和它们战斗吗？我也不太清楚。";
	sleep 2000;
	mapannounce 'xm_d_map$, "工厂广播：所有员工必须穿着合适的制服并佩戴身份证明。没有的话请向保安确认。", bc_map, "0x00ff44";
	sleep 3000;
		npctalk "凯瑟琳·杰特·约翰逊：天哪，希望守卫还是真正的人类。以前这里附近有几箱制服……";
	enablenpc instance_npcname("Employees' Uniform Box#1");
	enablenpc instance_npcname("Employees' Uniform Box#2");
	enablenpc instance_npcname("Employees' Uniform Box#3");
	sleep 5000;
	npctalk "凯瑟琳·杰特·约翰逊：啊，它们就在我身后。你最好换上制服。幸好我的员工卡还在。";
	sleep 5000;
		npctalk "凯瑟琳·杰特·约翰逊：我会自己找到路。我们在第二生产线附近见吧。振作起来，这里是玩具工厂，不会糟到哪里去的！！";
	sleep 6000;
	disablenpc instance_npcname("Catherine Jet Johnson#01");
	disablenpc instance_npcname("#bgm01");
	end;

OnStart2:
	enablenpc instance_npcname("#bgm01");
	enablenpc instance_npcname("Catherine Jet Johnson#01");
	disablenpc instance_npcname("Catherine Jet Johnson#0");
	sleep 3000;
	npctalk "凯瑟琳·杰特·约翰逊：啊……我们以前探索过这里？好，那我们再在同一个地方见面吧。";
	sleep 6000;
	disablenpc instance_npcname("Catherine Jet Johnson#01");
	enablenpc instance_npcname("Employees' Uniform Box#1");
	enablenpc instance_npcname("Employees' Uniform Box#2");
	enablenpc instance_npcname("Employees' Uniform Box#3");
	mapannounce 'xm_d_map$, "工厂广播：起床了，玩具工厂的工作时间到了……", bc_map, "0x00ff44";
	sleep 6000;
	mapannounce 'xm_d_map$, "工厂广播：工作区域必须保持没有废弃物和其他杂物，以确保你始终安全。", bc_map, "0x00ff44";
	sleep 6000;
	mapannounce 'xm_d_map$, "工厂广播：今天让我们为每个孩子的梦想制作礼物。", bc_map, "0x00ff44";
	donpcevent instance_npcname("#fac1ct") + "::OnStart";
	disablenpc instance_npcname("#bgm01");
	end;
}

1@xm_d,112,20,0	script	#bgm01	-1,9,9,{
	end;
OnTouch:
	playBGM "99";
	end;
}

1@xm_d,13,105,6	script	Employees' Uniform Box#1	4_NONMYSTCASE,{
	progressbar "ffff00",1;
	playBGM "52";
	.@mob_id_transform = getstatus(SC_MONSTER_TRANSFORM,1);
	if (.@mob_id_transform == 1246 || .@mob_id_transform < 1) {
		mes "^0000ff你穿上了工厂制服。箱子里似乎还剩几套制服。^000000";
		transform 1246,180000;// COOKIE_XMAS
		close;
	}
	mes "^ff0000你处于变身状态。";
	mes "已经变身时不能使用制服箱。^000000";
	close;
}
1@xm_d,116,16,6	duplicate(Employees' Uniform Box#1)	Employees' Uniform Box#2	4_NONMYSTCASE
1@xm_d,10,20,6	duplicate(Employees' Uniform Box#1)	Employees' Uniform Box#3	4_NONMYSTCASE

1@xm_d,1,5,3	script	#fac1ct	CLEAR_NPC,{
	end;
OnStart:
	.@event$ = instance_npcname("#fac1ct") + "::OnMyMobDead";
	killmonster 'xm_d_map$, .@event$;
	areamonster 'xm_d_map$,16,24,114,112, "Vicious Cookie",2989,31, .@event$;	// XM_COOKIE
	areamonster 'xm_d_map$,16,24,114,112, "Evil Dwelling Box",2991,36, .@event$;// XM_MYSTCASE
	end;

OnMyMobDead:
	if (mobcount( 'xm_d_map$, instance_npcname("#fac1ct") + "::OnMyMobDead" ) < 30)
		initnpctimer;
	end;

OnTimer1000:
	killmonster 'xm_d_map$, instance_npcname("#fac1ct") + "::OnMyMobDead";
	enablenpc instance_npcname("#fac1bs");
	mapannounce 'xm_d_map$, "Coordinator's announcement: Huh? Where's everyone! How dare workers be absent from the line!", bc_map, "0xff8800";
	for ( .@i = 61; .@i <= 89; .@i++ )
		disablenpc instance_npcname( "alert#"+ .@i );
	stopnpctimer;
	end;
}

1@xm_d,71,129,3	script	#fac1bs	4_M_COOKIE,{
	if (is_party_leader() == true) {
		.@mob_id_transform = getstatus(SC_MONSTER_TRANSFORM,1);
		mes "[Coordinator]";
		if (.@mob_id_transform == 1246) {
			mes "我找不到其他工人。没时间磨蹭，孩子们在等礼物。";
			next;
			mes "[Coordinator]";
			mes "快点！搬着^ff0000那边的礼物箱^000000向东走。";
			enablenpc instance_npcname("#pck1");
			npctalk "Coordinator: Hurry up! Carry the gift box over there and move to the east.";
		}
		else if (.@mob_id_transform == 1249)
			mes "你还在这里磨蹭什么！搬着^ff0000这里的礼物箱^000000向东走。";
		else {
			mes "什么！？人类！！！";
			donpcevent instance_npcname("#fac1bs") + "::OnAlert";
		}
		close;
	}
	end;

OnAlert:
	.@npc_name$ = instance_npcname("#fac1bs");
	.@event$ = .@npc_name$ + "::OnMyMobDead";
	killmonster 'xm_d_map$, .@event$;
	npctalk "Coordinator: Guard! Where is a guard! Humans are invading!!";
	sleep 3000;
	disablenpc .@npc_name$;
	for ( .@i = 0; .@i <= 10; .@i++ ) {
		areamonster 'xm_d_map$,61,118,71,128, "Guard",2990,1, .@event$;// XM_CRUISER
		sleep 300;
	}
	initnpctimer;
	end;
OnMyMobDead:
	end;

OnTimer60000:
	.@npc_name$ = instance_npcname("#fac1bs");
	killmonster 'xm_d_map$, .@npc_name$ + "::OnMyMobDead";
	enablenpc .@npc_name$;
	npctalk "Coordinator: This kind of thing happens a lot these days...";
	stopnpctimer;
	end;
}

1@xm_d,65,127,6	script	#pck1	4_NONMYSTCASE,{
	progressbar "ffff00",1;
	.@mob_id_transform = getstatus(SC_MONSTER_TRANSFORM,1);
	if (.@mob_id_transform == 1246) {
		mes "^0000ff你正携带包装好的礼物。^000000";
		transform 1249,180000;// MYSTCASE
	}
	else if (.@mob_id_transform == 1249)
		mes "^009900你手里已经有箱子。不能携带多个箱子。^000000";
	else
		mes "^ff0000你没有穿制服。协调员不会让你捡起它。^000000";
	close;
}


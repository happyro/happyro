				break;
			case 3:
				emotion ET_FRET;
				mes "[Dacquoise]";
				mes "这是什么？真是浪费时间！";
				next;
				emotion ET_ANGER, getnpcid(0, "Eclaire#"+strnpcinfo(2));
				mes "[Eclaire]";
				mes "我还以为会有更多成员加入！";
				next;
				emotion ET_THROB, getnpcid(0, "Mille Feuille#"+strnpcinfo(2));
				mes "[Mille Feuille]";
				mes "别再出现了！！";
				close;
			}
			mes "[Dacquoise]";
			mes "首先，你需要一本^0000cd食谱。^000000";
			next;
			mes "[Eclaire]";
			mes "假设你有堆积如山的食材，却不知道该怎么处理？";
			next;
			mes "[Mille Feuille]";
			mes "这时候就要打开食谱。";
			next;
			mes "[Dacquoise]";
			mes "你需要食谱来了解如何准备烹饪食材。";
			next;
			mes "[Eclaire]";
			mes "那我要怎样才能得到这些食谱？";
			next;
			mes "[Mille Feuille]";
			mes "食谱可以通过^0000cd任务^000000获得，也可以通过猎杀^0000cd怪物^000000找到。";
			next;
			emotion ET_SURPRISE;
			mes "[Dacquoise]";
			mes "拿到食谱后，下一步准备的是！";
			mes "^0000cd食材！^000000";
			next;
			mes "[Eclaire]";
			mes "没有食材就不能烹饪！连初心者都知道！";
			next;
			mes "[Mille Feuille]";
			mes "你可以通过击败或打倒^0000cd怪物^000000获得食材，也可以从^0000cd烹饪食材商人^000000那里购买。";
			next;
			mes "[Dacquoise]";
			mes "烹饪需要一些准备，但收获绝对值得。";
			next;
			mes "[Dacquoise]";
			mes "还有一点要记住，^0000cd烹饪有失败的可能^000000。请注意，结果取决于你的厨具和烹饪等级。";
			next;
			if (new_cook == 1) {
				select("我想烹饪！");
				mes "[Dacquoise]";
				mes "就是这个精神！我们来真正烹饪吧！";
				mes "准备好后再回来！";
				emotion ET_BEST;
			} else {
				mes "[Eclaire]";
				mes "即使失败了我们也不负责！";
			}
			new_cook = 1;
			close;
		} else if (new_cook >= 1) {
			if (isbegin_quest(14154) == 1 || isbegin_quest(14155) == 1 || isbegin_quest(14156) == 1 || isbegin_quest(14157) == 1) {
				mes "[Dacquoise]";
				mes "你都带来了吗？";
				next;
				if (select("是的！我带来了！", "不，我放弃了。") == 2) {
					mes "[Dacquoise]";
					mes "我可是用宝贵的时间向你介绍烹饪世界。";
					mes "结果你就这样放弃了？";
					emotion ET_FRET;
					next;
					mes "[Eclaire]";
					mes "你侮辱了我们！";
					emotion ET_ANGER, getnpcid(0, "Eclaire#"+strnpcinfo(2));
					next;
					mes "[Mille Feuille]";
					mes "以后想学的话再回来吧～大概……";
					emotion ET_THINK, getnpcid(0, "Mille Feuille#"+strnpcinfo(2));
					close2;
					if (isbegin_quest(14154) == 1)
						erasequest 14154;
					if (isbegin_quest(14155) == 1)
						erasequest 14155;
					if (isbegin_quest(14156) == 1)
						erasequest 14156;
					if (isbegin_quest(14157) == 1)
						erasequest 14157;
					end;
				}
				mes "[Dacquoise]";
				mes "我能看看吗？";
				next;
				if (isbegin_quest(14154) == 1 && countitem(705) > 0 && countitem(511) > 0 && countitem(507) > 0) {
					mes "[Dacquoise]";
					mes "你带来了我需要的东西！好，那我就按约定为你烹饪。";
					mes "现在要像闪电一样行动！！！！";
					emotion ET_SPARK;
					next;
					mes "[Eclaire]";
					mes "吃下这个后去猎杀怪物吧。你会感到力量增强。";
					emotion ET_BEST, getnpcid(0, "Eclaire#"+strnpcinfo(2));
					next;
					mes "[Mille Feuille]";
					mes "如果你真的想烹饪，就去^0000ff普隆德拉城堡地下室找 Charles Orleans 爵士^000000！！";
					mes "呀……Orleans 爵士！！";
					emotion ET_THROB, getnpcid(0, "Mille Feuille#"+strnpcinfo(2));
					close2;
					delitem 705,1;// Clover
					delitem 511,1;// Green_Herb
					delitem 507,1;// Red_Herb
					getitem 11551,1;// Savory_Herb_Salad
					erasequest 14154;
					end;
				}
				if (isbegin_quest(14155) == 1 && countitem(512) > 0 && countitem(515) > 1) {
					mes "[Dacquoise]";
					mes "你带来了我需要的东西！好，那我就按约定为你烹饪。";
					mes "现在要像闪电一样行动！！！！";
					emotion ET_SPARK;
					next;
					mes "[Eclaire]";
					mes "试试这个。它会让你像飞行的蜜蜂一样奔跑。";
					emotion ET_BEST, getnpcid(0, "Eclaire#"+strnpcinfo(2));
					next;
					mes "[Mille Feuille]";
					mes "如果你真的想烹饪，就去^0000ff普隆德拉城堡地下室找 Charles Orleans 爵士^000000！！你一定会被他吸引！！";
					emotion ET_THROB, getnpcid(0, "Mille Feuille#"+strnpcinfo(2));
					close2;
					delitem 512,1;// Apple
					delitem 515,2;// Carrot
					getitem 11552,1;// Apple_Carrot_Salad
					erasequest 14155;
					end;
				}
				if (isbegin_quest(14156) == 1 && countitem(909) > 0 && countitem(914) > 0 && countitem(949) > 0) {
					mes "[Dacquoise]";
					mes "你带来了我需要的东西！好，那我就按约定为你烹饪。";
					mes "现在要像闪电一样行动！！！！";
					emotion ET_SPARK;
					next;
					mes "[Eclaire]";
					mes "你能感受到未知力量在血管中流动吗？你正在吃的就是它！";
					emotion ET_BEST, getnpcid(0, "Eclaire#"+strnpcinfo(2));
					next;
					mes "[Mille Feuille]";
					mes "如果你真的对烹饪好奇，就去普隆德拉城堡地下室找 Charles Orleans 爵士。";
					emotion ET_THROB, getnpcid(0, "Mille Feuille#"+strnpcinfo(2));
					close2;
					delitem 909,1;// Jellopy
					delitem 914,1;// Fluff
					delitem 949,1;// Feather
					getitem 11553,1;// Casual_Stew
					erasequest 14156;
					end;
				}
				if (isbegin_quest(14157) == 1 && countitem(512) > 0 && countitem(705) > 0) {
					mes "[Dacquoise]";
					mes "你带来了我需要的东西！好，那我就按约定为你烹饪。";
					mes "现在要像闪电一样行动！！！！";
					emotion ET_SPARK;
					next;
					mes "[Eclaire]";
					mes "吃下这个，你就不会错过目标！";
					mes "事实上，1 级时也绝不会错过目标！";
					emotion ET_BEST, getnpcid(0, "Eclaire#"+strnpcinfo(2));
					next;
					mes "[Mille Feuille]";
					mes "去普隆德拉城堡地下室找 Charles Orleans 爵士！！";
					mes "你可以向他学习真正的烹饪！";
					emotion ET_THROB, getnpcid(0, "Mille Feuille#"+strnpcinfo(2));
					close2;
					delitem 512,1;// Apple
					delitem 705,1;// Clover
					getitem 11554,1;// Golden_Roasted_Apple
					erasequest 14157;
					end;
				}
				mes "[Dacquoise]";
				mes "没有食材你要我做什么？难道要我自己去拿？";
				close;
			}
			if (new_cook == 2) {
				mes "[Dacquoise]";
				mes "你又回来找我，是因为想烹饪，对吧？";
				next;
				mes "[Eclaire]";
				mes "那你想烹饪什么？";
				next;
				mes "[Mille Feuille]";
				mes "哦？那个孩子又回来了。"+strcharinfo(0)+" right? So what do you want?";
				next;
			} else {
				mes "[Dacquoise]";
				mes "准备好了吗？实践才是最好的证明！我们来烹饪吧！";
				next;
				mes "[Eclaire]";
				mes "这次演示会缩短烹饪时间。";
				next;
				mes "[Mille Feuille]";
				mes "接下来要展示的烹饪需要食谱和烹饪设备，但对初心者来说太难了，所以我来为你烹饪。";
				next;
				emotion ET_STARE;
				mes "[Dacquoise]";
				mes "你为什么说你要做？";
				next;
				emotion ET_SCRATCH, getnpcid(0, "Mille Feuille#"+strnpcinfo(2));
				mes "[Mille Feuille]";
				mes "啊，为什么不呢？";
				next;
				mes "[Dacquoise]";
				mes "我是火焰烹饪三人厨师组的领袖！";
				next;
				emotion ET_HUK, getnpcid(0, "Eclaire#"+strnpcinfo(2));
				mes "[Eclaire]";
				mes "什么？！！什么时候决定的？";
				next;
				emotion ET_STARE_ABOUT;
				mes "[Dacquoise]";
				mes "有人比我年长吗？";
				next;
				emotion ET_HUK, getnpcid(0, "Eclaire#"+strnpcinfo(2));
				mes "[Eclaire]";
				mes "年龄！我对此无能为力。";
				next;
				emotion ET_OK, getnpcid(0, "Mille Feuille#"+strnpcinfo(2));
				mes "[Mille Feuille]";
				mes "就因为你大一岁，就想自动当领袖。有人反对吗？";
				next;
				emotion ET_FRET;
				mes "[Dacquoise]";
				mes "安静！";
				next;
				mes "[Dacquoise]";
				mes "那么你想做什么？Int 和 Luk 餐对你没有帮助，所以我准备了另外 4 种食物。";
				next;
			}
			switch(select("香草混合", "爽脆沙拉", "什锦涮涮锅", "黄金苹果烤肉")) {
			case 1:
				// Fragrant Herb Mix
				mes "[Dacquoise]";
				mes "^0000cd香草混合^000000。它会提升^0000cdStr^000000。";
				next;
				mes "[Equazu]";
				mes "通常由力量型的人食用。";
				next;
				mes "[Mille Feuille]";
				mes "食材——^0000cd1 个四叶草、1 个绿色草药、1 个红色草药^000000。";
				next;
				cutin "�糪ƽī��.bmp", 3;
				mes "[Dacquoise]";
				mes "四叶草和红色草药由伊兹鲁德城外原野上到处游荡的疯兔或苍蝇掉落。";
				next;
				cutin "�ĺ긣ī��.bmp", 3;
				mes "[Eclaire]";
				mes "绿色草药由苍蝇掉落。";
				next;
				cutin "", 255;
				mes "[Mille Feuille]";
				mes "你带齐所有食材后，我们就能烹饪。";
				close2;
				new_cook = 2;
				setquest 14154;
				end;
			case 2:
				// Crunchy Salad
				mes "[Dacquoise]";
				mes "爽脆沙拉。我很喜欢这个。你很懂烹饪嘛。";
				next;
				mes "[Eclaire]";
				mes "爽脆沙拉会提升^0000cdAgi^000000，适合快速攻击和躲避怪物伤害。";
				next;
				mes "[Mille Feuille]";
				mes "食材是^0000cd1 个苹果和 2 根胡萝卜^000000。";
				next;
				cutin "����ī��.bmp", 3;
				mes "[Dacquoise]";
				mes "苹果由伊兹鲁德城外原野上蹦跳的波利掉落。";
				next;
				cutin "�糪ƽī��.bmp", 3;
				mes "[Eclaire]";
				mes "胡萝卜由疯兔掉落。";
				next;
				cutin "", 255;
				mes "[Mille Feuille]";
				mes "带齐所有食材后我们就能烹饪。";
				close2;
				new_cook = 2;
				setquest 14155;
				end;
			case 3:
				// Mixed Shabu Shabu
				mes "[Dacquoise]";
				mes "可怕的^0000cd什锦涮涮锅！^000000它会提升^0000cdVit^000000。即使一小份也能让你吃饱。";
				next;
				mes "[Eclaire]";
				mes "吃下这个，你会感觉怪物造成的痛苦减轻了。";
				next;
				mes "[Mille Feuille]";
				mes "食材是^0000cd1 个杰勒比结晶、1 个绒毛、1 根羽毛^000000。";
				next;
				cutin "����ī��.bmp", 3;
				mes "[Dacquoise]";
				mes "杰勒比结晶由伊兹鲁德原野上蹦跳的波利掉落。";
				next;
				cutin "�ĺ긣ī��.bmp", 3;
				mes "[Eclaire]";
				mes "绒毛可以从苍蝇或疯兔那里获得。";
				next;
				cutin "�糪ƽī��.bmp", 3;
				mes "[Mille Feuille]";
				mes "羽毛由疯兔或苍蝇掉落。";
				next;
				cutin "", 255;
				mes "[Dacquoise]";
				mes "你带齐所有食材后，我会为你制作。";
				close2;
				new_cook = 2;
				setquest 14156;
				end;
			case 4:
				// Golden Apple Roast
				mes "[Dacquoise]";
				mes "^0000cd黄金苹果吐司～^000000闪耀的金色糖衣……味道和外观一样好。";
				next;
				mes "[Eclaire]";
				mes "它会提升^0000cdDex^000000，主要受到想提高攻击力的弓箭手，或想提升命中率的人喜爱。";
				next;
				mes "[Mille Feuille]";
				mes "食材是——^0000cd1 个苹果和 1 个四叶草^000000。";
				next;
				cutin "����ī��.bmp", 3;
				mes "[Dacquoise]";
				mes "苹果可以从伊兹鲁德城外原野的波利身上获得。";
				next;
				cutin "�糪ƽī��.bmp", 3;
				mes "[Eclaire]";
				mes "四叶草由伊兹鲁德城外原野的疯兔或苍蝇掉落。";
				next;
				cutin "", 255;
				mes "[Mille Feuille]";
				mes "你带齐所有食材后，我会为你制作。";
				close2;
				new_cook = 2;
				setquest 14157;
				end;
			}
		} else {
			emotion ET_BEST;
			mes "[Dacquoise]";
			mes "我是 Dacquoise，卢恩·米德加尔特传奇厨师^0000cdCharles Orleans^000000的弟子。";
			next;
			emotion ET_BEST, getnpcid(0, "Eclaire#"+strnpcinfo(2));
			mes "[Eclaire]";
			mes "牛排不仅提升属性，还能同时恢复 HP 和 SP。";
			next;
			emotion ET_THROB, getnpcid(0, "Mille Feuille#"+strnpcinfo(2));
			mes "[Mille Feuille]";
			mes "如果你真的想烹饪，就去^0000cd普隆德拉城堡地下室找 Charles Orleans 爵士^000000！！你一定会被他吸引！！";
			close;
		}
	} else {
		mes "[Dacquoise]";
		mes "看来你已经不再是新手了。最近在烹饪吗？";
		next;
		mes "[Eclaire]";
		mes "如果还没有，不如现在开始？";
		next;
		mes "[Mille Feuille]";
		mes "牛排不仅提升属性，还能同时恢复 HP 和 SP。";
		next;
		mes "[Flame Cook Trio Chefs]";
		mes "如果你真的想烹饪，就去^0000cd普隆德拉城堡地下室见 Charles Orleans 爵士^000000！你一定会被他吸引。";
		close;
	}

OnInit:
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "Class == Job_Novice && (!isbegin_quest(14154) || !isbegin_quest(14155) || !isbegin_quest(14156) || !isbegin_quest(14157))" );
	end;
}

iz_ac01_a,147,50,3	duplicate(Dacquoise#ac)	Dacquoise#ac_a	4_COOK
iz_ac01_b,147,50,3	duplicate(Dacquoise#ac)	Dacquoise#ac_b	4_COOK
iz_ac01_c,147,50,3	duplicate(Dacquoise#ac)	Dacquoise#ac_c	4_COOK
iz_ac01_d,147,50,3	duplicate(Dacquoise#ac)	Dacquoise#ac_d	4_COOK

// - General Store Owner
// - Sells the player the Novice Combination Book and Kit.
// -----------------------------------------------------------------------------
iz_ac01,68,49,3	script	General Store Owner#ac	4_F_03,{
	if (!checkweight(1304,3)) {
		mes "由于背包过满，任务无法继续。";
		mes "整理物品后请再试一次。";
		close;
	}
	mes "[Querrie]";
	mes "你对初心者公会感兴趣吗？";
	mes "我出售合成书和合成工具。";
	next;
	mes "[Querrie]";
	mes "20 级以下的克里图拉学生享有特别优惠。希望你多买一些！！！";
	next;
	switch(select("初心者合成书", "合成工具", "取消。")) {
	case 1:
		if (isbegin_quest(4269) && isbegin_quest(7478)) {
			mes "[Querrie]";
			mes "你接受过治疗师的治疗吗？";
			mes "你可以在医药植物学课程中获得公会书。";
			next;
			if (select("啊……是这样吗？", "我弄丢了。") == 1) {
				mes "[Querrie]";
				mes "之后多买些公会合成工具吧～～～";
				mes "我正以惊人的低价卖给基础等级 20 以下的学生。";
				close;
			}
			mes "[Querrie]";
			mes "你说什么？";
		} else {
			mes "[Querrie]";
			mes "你是说合成书。";
		}
		mes "一本书售价 1000z。";
		next;
		if (select("购买", "不买。") == 2) {
			mes "[Querrie]";
			mes "下次再用吧。";
		} else {
			if (Zeny >= 1000) {
				mes "[Querrie]";
				mes "给你。";
				mes "这是给初心者的书。正确使用的话，它能让你合成有用的工具。";
				Zeny -= 1000;
				getitem 11058,1;// Novice_Combi_Book
			} else {
				mes "[Querrie]";
				mes "这本书售价 1000 Zeny。";
				mes "看来你的 Zeny 不够。";
			}
		}
		close;
	case 2:
		if (BaseLevel <= 20) {
			mes "[Querrie]";
			mes "重大消息！只为你准备的特别优惠！";
			mes "一个合成工具只要 30z！";
			mes "你需要多少个？";
		} else {
			mes "[Querrie]";
			mes "今天没有优惠。";
			mes "一个合成工具售价 500z。";
			mes "告诉我你需要多少个？";
		}
		next;
		input .@input;
		if (!.@input) {
			mes "[Querrie]";
			mes "好吧，你现在不必购买。";
			mes "下次再用吧。";
			close;
		}
		if (.@input > 99) {
			mes "[Querrie]";
			mes "你需要多少个？";
			mes "一次最多可以买 99 个。";
			close;
		}
		set .@cost, .@input * (BaseLevel <= 20 ? 30 : 500);
		mes "[Querrie]";
		mes .@input+" 个合成工具需要支付 "+.@cost+"……Zeny。";
		if (Zeny < .@cost) {
			mes "看来你的钱不够支付这个金额。";
			close;
		}
		mes "谢谢。欢迎下次再来。";
		Zeny -= .@cost;
		getitem 12849,.@input;// Combination_Kit
		close;
	case 3:
		close;
	}
}

iz_ac01_a,68,49,3	duplicate(General Store Owner#ac)	General Store Owner#ac_a	4_F_03
iz_ac01_b,68,49,3	duplicate(General Store Owner#ac)	General Store Owner#ac_b	4_F_03

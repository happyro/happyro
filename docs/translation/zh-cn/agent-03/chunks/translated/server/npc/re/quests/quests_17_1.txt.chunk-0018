pub_cat,84,66,3	script	Wilde#171_pub	1_M_SIGNROGUE,2,2,{
	if (isbegin_quest(7864) == 0) {
		mes "[Wilde]";
		mes "什么？你第一次来这里吗？";
		mes "饮料从那边送来。";
		next;
		mes "[Wilde]";
		mes "这里仅限成年人进入。";
		close;
	}
	if (isbegin_quest(7864) == 1) {
	OnTalk:
		mes "[Wilde]";
		mes "嘿！这里发生什么事了？";
		npctalk "嘿！这里发生什么事了？","",bc_self;
		next;
		mes "[Wilde]";
		mes "什么？你就是他们在等的人吗？看到我身后的房间了吗？进去吧。";
		close;
	}
	if (isbegin_quest(17001) != 2) {
	OnTalk2:
		mes "[Wilde]";
		mes "你要进去吗？里面很吵，所以我晚点再进去。";
		close;
	}
	mes "[Wilde]";
	mes "等等，现在后面没人，你在等谁吗？";
	close;

OnTouch:
	if (isbegin_quest(7864) == 1)
		goto OnTalk;
	if (isbegin_quest(17000) == 1 || isbegin_quest(17001) == 1)
		goto OnTalk2;
	if (isbegin_quest(17001) == 2)
		npctalk "你好！","",bc_self;
	end;

OnInit:
	questinfo(QTYPE_QUEST,QMARK_YELLOW,"isbegin_quest(7864) == 1");
	end;
}


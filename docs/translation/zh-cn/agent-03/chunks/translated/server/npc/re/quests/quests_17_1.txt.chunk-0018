pub_cat,104,106,3	script	Retired Rebellion#backroom_ent	4_M_SEAMAN,{
	if (isbegin_quest(7859) < 2) {
		npctalk "退役反叛军：去别的地方。这地方不适合你。","",bc_self;
		end;
	}
	mes "[Retired Rebellion]";
	mes "你要去后面的房间吗？";
	next;
	if (select("是的。:还没。") == 2) {
		mes "[Retired Rebellion]";
		mes "慢慢来。";
		close;
	}
	warp "pub_cat",150,105;
	end;
}


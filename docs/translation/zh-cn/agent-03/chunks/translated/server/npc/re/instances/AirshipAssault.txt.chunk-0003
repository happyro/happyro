	end;
OnStart:
	'airship_status = 9;
	for ( .@i = 1; .@i <= 8; .@i++ )
		disablenpc instance_npcname("Gremlin#" + .@i + "air2");
	disablenpc instance_npcname("Captain Ferlock#air2");
	disablenpc instance_npcname("Iris#2air2");
	enablenpc instance_npcname("callb#air2");
	monster 'map_air2$,247,51,"Out of control Captain",3181,1, instance_npcname("callb#air2") + "::OnMyMobDead";// E1_FELOCK
	end;
OnMyMobDead:
	if (mobcount( 'map_air2$, instance_npcname("callb#air2") + "::OnMyMobDead" ) < 1)
		initnpctimer;
	end;
OnTimer6000:
	enablenpc instance_npcname("Chaos#air2");
	enablenpc instance_npcname("Captain Ferlock#2air2");
	disablenpc instance_npcname("callb#air2");
	'airship_status = 10;
	stopnpctimer;
	end;
}

// Final
1@air2,239,58,5	script	Chaos#air2	4_M_CHAOS,{
	if ('airship_status > 10) {
		cutin "h_chaos02",2;
		mes "[Chaos]";
		mes "你现在就离开这里！！这艘船很危险！！";
		close3;
	}
	cutin "fly_felrock2",2;
	mes "[Captain Ferlock]";
	mes "糟糕……我刚才疯狂射击。看来很多小恶魔都消失了？嘿嘿嘿。";
	next;
	cutin "h_iris01",2;
	mes "[Iris]";
	mes "船被你弄坏了！！";
	next;
	cutin "h_arcana02",2;
	mes "[Arcana]";
	mes "替我们做了工作。嗯，我想这样就够了？";
	next;
	mes "[Arcana]";
	mes "那么我们该溜走了……";
	next;
	cutin "h_guardian1",1;
	mes "[Laksmi]";
	mes "哦？……看，Basara。他们似乎撤退了。";
	next;
	mes "[Basara]";
	mes "当然！！他们感受到我们的实力了！！呵呵呵～";
	next;
	mes "[Basara]";
	mes "说到这个，再来一发风魔手里剑！！";
	next;
	for ( .@i = 1; .@i < 4; .@i++ ) {
		enablenpc instance_npcname("Gremlin#" + .@i + "air2");
		hideonnpc instance_npcname("Gremlin#" + .@i + "air2");
	}
	donpcevent instance_npcname("Gremlin#1air2") + "::OnExplosion1";
	cutin "",255;
	mes "- 砰砰！砰！";
	next;
	cutin "fenrir_b",2;
	mes "[Fenrir]";
	mes "呀！！看来我们要掉下去了！！";
	mes "……太矮了……够不到……";
	next;
	mes "[Fenrir]";
	mes "……这就是结局吗？";
	mes "……又是一个我无法到达的地方……";
	mes "Chaos……";
	next;
	cutin "ep14_roki02",2;
	mes "[Loki]";
	mes "……抓住我";
	next;
	cutin "fenrir_b",2;
	mes "[Fenrir]";
	mes "Lo……ki？";
	next;
	cutin "ep14_roki02",2;
	mes "[Loki]";
	mes "你在看什么？来，上来……";
	next;
	cutin "",255;
	mes "[Guard]";
	mes "确认所有引擎停止！！";
	mes "我们必须赶快逃离！";
	next;
	cutin "fly_felrock2",2;
	mes "[Captain Ferlock]";
	mes "该死……";
	mes "所有人上救生艇！";
	mes "优先让乘客登上救生艇！登满后立即放艇！";
	next;
	cutin "h_chaos02",2;
	mes "[Chaos]";
	mes "等等！！还有人没上来！！";
	next;
	cutin "fly_felrock2",2;
	mes "[Captain Ferlock]";
	mes "我们无能为力！";
	mes "继续拖延会让其他人陷入危险！！很遗憾，但我们已经尽力了！";
	next;
	cutin "h_chaos03",2;
	mes "[Chaos]";
	mes "但留下的人也是宝贵的生命！你要抛下他们吗？！什么？！";
	next;
	cutin "fly_felrock2",2;
	mes "[Captain Ferlock]";
	mes "是的，你说得对……";
	mes "那么善后就交给你了。我走了！！";
	disablenpc instance_npcname("Captain Ferlock#2air2");
	next;
	cutin "h_chaos03",2;
	mes "[Chaos]";
	mes "喂！你要去哪！啊！！";
	mes "我会抓住你。我会杀了你！！";
	next;
	cutin "h_guardian1",1;
	mes "[Basara]";
	mes "现在不是对付这些小恶魔的时候。";
	next;
	mes "[Basara]";
	mes "我能感受到更大的邪恶浪潮。";
	mes "把这些小家伙交给他们。走！";
	next;
	mes "[Laksmi&Shiva]";
	mes "收到！！游侠飞行形态！！";
	next;
	cutin "h_iris01",2;
	mes "[Iris]";
	mes "嗯？嘿！！";
	mes "毁掉船后你们想去哪？！";
	next;
	mes "[Iris]";
	mes "下次抓到你们，我一定让你们死！！紧张起来！！听懂了吗？！准备好，乡巴佬！！";
	next;
	cutin "h_guardian3",1;
	mes "[Guardian Heroines]";
	mes "……乡巴佬？（愤怒）";
	next;
	mes "[Guardian Heroines]";
	mes "那些贬低并谴责正义之路的人……我们应该毫不留情地施以正义审判，对吧？";
	next;
	mes "[Guardian Heroines]";
	mes "去死吧，恶徒！！风魔手里剑！！";
	next;
	donpcevent instance_npcname("Gremlin#1air2") + "::OnExplosion1";
	cutin "",255;
	mes "- 砰！砰砰！砰！";
	next;
	cutin "h_iris01",2;
	mes "[Iris]";
	mes "呀！！";
	next;
	cutin "h_guardian1",1;
	mes "[Guardian Heroines]";
	mes "啊哈哈哈哈！！";
	mes "活该～！！走吧！！";
	next;
	cutin "h_chaos03",2;
	mes "[Chaos]";
	mes "Iris！！到这里来！！";
	mes "我们赶快找到Fenrir和Loki，离开这里！！";
	next;
	cutin "h_chaos02",2;
	mes "[Chaos]";
	mes "你现在就离开这里！！这艘船很危险！！";
	close2;
	if ('airship_status == 10){
		'airship_status = 11;
		enablenpc instance_npcname("warp5a#air2");
		cutin "",255;
		getexp 100000,65000;
	}
	end;
}


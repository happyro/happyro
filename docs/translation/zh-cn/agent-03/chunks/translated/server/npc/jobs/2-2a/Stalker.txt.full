//===== rAthena Script ======================================= 
//= Advance Class jobchanger after kRO Normals.
//===== By: ==================================================
//= Nana
//= finished, optimized and tested by Lupus
//===== Current Version: ===================================== 
//= 1.3
//===== Compatible With: ===================================== 
//= rAthena Project
//===== Description: ========================================= 
//= Advance Class jobchanger after kRO Normals.
//===== Additional Comments: ================================= 
//= 1.1 Made all into functions, additional checks, etc. [Lupus]
//= 1.2 Made numbers into constants. [Vicious]
//= 1.3 Now saves/restores all the quest skills [Lupus]
//============================================================ 

valkyrie,53,58,3	script	Stalker#Valkyrie	747,{
	if (ADVJOB == 0 || Upper != 1) {
		set .@karma_d,rand(1,10);
		if (.@karma_d > 4) {
			mes "[神行太保]";
			mes "恭喜。";
			mes "向战士致敬！";
			close;
		}
		mes "[神行太保]";
		mes "嘿……";
		mes "成为英雄";
		mes "很辛苦，";
		mes "还要阴险、";
		mes "不可信、";
		mes "偷偷摸摸……";
		next;
		mes "[神行太保]";
		mes "但当事情";
		mes "变得艰难时，";
		mes "我的伙伴知道";
		mes "可以依靠我。";
		mes "我需要他们，";
		mes "他们也需要我。";
		close;
	}
	else if (ADVJOB == Job_Stalker && Class == Job_Thief_High && JobLevel > 39) {
		mes "[神行太保]";
		mes "这个世界需要";
		mes "更多愿意在";
		mes "秩序与无法无天之间";
		mes "走钢丝的英雄。";
		next;
		mes "[神行太保]";
		mes "你准备好";
		mes "加入最";
		mes "狡猾的";
		mes "warriors? 你准备好";
		mes "成为神行太保了吗？";
		next;
		if (select("不:是") == 1) {
			mes "[神行太保]";
			mes "准备好后";
			mes "随时回来。";
			mes "向战士致敬！";
			close;
		}
		if (SkillPoint) {
			mes "[神行太保]";
			mes "你还可以学习更多技能。请在回来前用完";
			mes "所有剩余技能点。";
			close;
		}
		jobchange Job_Stalker;
		set ADVJOB,0;
		mes "[神行太保]";
		mes "恭喜！";
		mes "作为神行太保，希望你";
		mes "刺中正确的人";
		mes "的后背，用他们";
		mes "自己的卑鄙手段";
		mes "消灭邪恶！";
		close;
	}
	mes "[神行太保]";
	mes "欢迎";
	mes "来到英灵殿，";
	mes "荣誉大厅。";
	next;
	mes "[神行太保]";
	mes "请在这里";
	mes "安心休息。";
	mes "趁你在这里。";
	mes "向战士致敬！";
	close;
}

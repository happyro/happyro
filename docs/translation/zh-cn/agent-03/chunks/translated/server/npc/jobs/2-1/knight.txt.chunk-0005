	end;
}

// Test 5, and creates Claymores for knights
//==========================================================
prt_in,87,92,4	script	Sir Gray#knt	119,{
	mes "[格雷爵士]";
	if (BaseJob != Job_Swordman) {
		if (BaseJob == Job_Knight) {
			mes "刀刃上闪耀的光芒";
			mes "无法用言语形容。这是每位骑士都必须拥有的武器。";
			next;
			mes "[Sir Gray]";
			mes "是的……";
			mes "^3355FF双手剑^000000！";
			mes "每位骑士";
			mes "都想要一把！";
			next;
			switch(select("关于^3355FF双手剑^000000:购买双手剑:结束对话")) {
			case 1:
				mes "[Sir Gray]";
				mes "双手剑是鲁恩·米德加尔特普隆德拉能获得的名剑之一！！对骑士而言价值无可估量。";
				next;
				mes "[Sir Gray]";
				mes "现在普隆德拉骑士团正在制作这种华丽的双手剑。骑士只需支付^3355FF74,000^000000 Zeny。";
				next;
				mes "[Sir Gray]";
				mes "不仅如此，由于双手剑的特性，你还需要";
				mes "1块^3355FF钢铁^000000。如果愿意，我可以为你制作。为了普隆德拉骑士团的荣耀！";
				close;
			case 2:
				if (MaxWeight - Weight < 1800) {
					mes "[Sir Gray]";
					mes "哦，不……";
					mes "看来你带了太多东西。背包没有空间放沉重的双手剑。";
					next;
					mes "[Sir Gray]";
					mes "不如先去";
					mes "整理一下";
					mes "你的物品。";
					close;
				}
				else {
					if ((Zeny > 73999) && (countitem(999) > 0) && (BaseJob == Job_Knight)) {
						mes "[Sir Gray]";
						mes "你准备好了！";
						mes "你一定知道";
						mes "双手剑的真正价值！";
						mes "我现在就来制作！！";
						mes "请稍等。";
						mes "马上完成。";
						next;
						mes "[Sir Gray]";
						mes "制作双手剑的";
						mes "基本方法很简单。";
						mes "看好了~！";
						next;
						mes "^3355FF*搅拌搅拌*^000000";
						mes "^3355FF*咚嚓咚嚓*^000000";
						next;
						mes "[Sir Gray]";
						mes "好了，完成了！";
						mes "每位骑士的骄傲：";
						mes "一把精良的^3355FF双手剑^000000。";
						mes "你获得了可靠的物品。";
						mes "它会成为冒险中的好伙伴。";
						delitem 999,1; //Steel
						set Zeny, Zeny - 74000;
						getitem 1163,1; //Claymore
						close;
					}
					mes "[Sir Gray]";
					mes "我知道你很想要双手剑，但没有材料我无法制作。";
					mes "需要^3355FF74,000 Zeny^000000和^3355FF1块钢铁！^000000";
					next;
					mes "[Sir Gray]";
					mes "准备好所有材料后";
					mes "再回来。我会";
					mes "等着你……";
					mes "请不要忘记。";
					close;
				}
			case 3:
				mes "[Sir Gray]";
				mes "每位骑士都应该能像使用身体延伸一样挥舞双手剑。我曾期待在战斗中挥舞我的双手剑……";
				close;
			}
		}
		else if (BaseClass == Job_Novice) {
			mes "信不信由你，";
			mes "我也曾经是";
			mes "一名初心者。";
			mes "真的。";
			next;
			mes "[Sir Gray]";
			mes "我从没计划成为骑士，但决定成为强者。不知不觉旅途中加入了普隆德拉骑士团。哈哈哈！";
			close;
		}
		mes "年轻人，";
		mes "请明智地";
		mes "利用时间。";
		next;
		mes "[Sir Gray]";
		mes "时间过去后";
		mes "再后悔";
		mes "也没有意义。";
		close;
	}
	if (KNIGHT_Q == 0) {
		mes "年轻人，";
		mes "请明智地";
		mes "利用时间。";
		next;
		mes "[Sir Gray]";
		mes "时间过去后";
		mes "再后悔";
		mes "也没有意义。";
		close;
	}
	else if ((KNIGHT_Q == 12) || (KNIGHT_Q == 13)) {
		if (KNIGHT_Q == 12) {
			mes "哦……";
			mes "一名年轻的剑士。";
			mes "是的，我能";
			mes "为你做什么？";
			next;
			if (select("我想参加转职测试。:哦，没什么。") == 1) {
				mes "[Sir Gray]";
				mes "呵呵，我明白了。";
				mes "所以你已经参加了";
				mes "其他人的";
				mes "测试？";
				next;
				mes "[Sir Gray]";
				mes "那么要不要";
				mes "开始我的测试？";
				mes "不过这不算";
				mes "真正的测试。";
				next;
				mes "[Sir Gray]";
				mes "我们随意";
				mes "聊聊吧，";
				mes "怎么样？";
				next;
				mes "[Sir Gray]";
				mes "首先……";
				mes "你为什么";
				mes "决定成为";
				mes "骑士？";
				next;
			}
			else {
				mes "[Sir Gray]";
				mes "保重！";
				close;
			}
		}
		else if (KNIGHT_Q == 13) {
			mes "啊，又是你。";
			mes "你为什么";
			mes "来找我？";
			next;
			if (select("我想了很多。:哦，没什么。") == 1) {
				mes "[Sir Gray]";
				mes "是这样吗……";
				mes "不知道你是否";
				mes "真的想过……";
				next;
				mes "[Sir Gray]";
				mes "那么……";
				mes "和上次一样，";
				mes "我再问一次……";
				next;
				mes "[Sir Gray]";
				mes "首先……";
				mes "你为什么";
				mes "决定成为";
				mes "骑士？";
				next;
			}
			else {
				mes "[Sir Gray]";
				mes "保重！";
				mes "健康是";
				mes "每个人的";
				mes "财富！";
				close;
			}
		}
		switch(select("为了变强……:为了帮助公会……:因为我对现在的自己不满意……")) {
		case 1:
			mes "[Sir Gray]";
			mes "你说是为了变强？";
			mes "没错，骑士确实很强。";
			mes "但为什么要变强？";
			next;
			mes "[Sir Gray]";
			mes "是为了向别人炫耀？为了获得名声？还是有别的理由？你觉得成为骑士变强有什么好处？";
			next;
			switch(select("获得财富和名声。:我能保护自己。:我能保护他人。")) {
			case 1:
				set .@knight_t,.@knight_t+10;
				mes "[Sir Gray]";
				mes "当然，财富和名声有其价值。但我们骑士必须为更高尚的美德而活。";
				next;
				break;
			case 2:
				mes "[Sir Gray]";
				mes "想得好。要保护他人，首先必须能保护自己。为此你必须不断训练，绝不能向懒惰屈服。";
				next;
				break;
			case 3:
				mes "[Sir Gray]";
				mes "啊，绝妙的想法。骑士的力量必须用来保护弱者、捍卫正义。";
				next;
				mes "[Sir Gray]";
				mes "遗憾的是，有些骑士忘记了骑士应有的理想，让我们蒙羞……";
				next;
				break;
			}
			break;
		case 2:
			mes "[Sir Gray]";
			mes "啊，为了帮助你的公会，甚至队伍。我们睿智仁慈的特里斯坦三世国王曾留下这些金句……";
			next;
			mes "[Sir Gray]";
			mes "^8B7500平静的河流之外，是危险的瀑布。因此，你必须时刻为一切做好准备……^000000";
			next;
			mes "[Sir Gray]";
			mes "那么你认为";
			mes "自己可以怎样";
			mes "帮助公会？";
			next;
			switch(select("公会需要我。:我能为公会筹集资金。:我能保护公会成员。")) {
			case 1:
				mes "[Sir Gray]";
				mes "在这个世界的任何地方，每个人";
				mes "都有被需要的位置。即使不是公会成员，也不要忽视需要帮助的人。";
				next;
				break;
			case 2:
				set .@knight_t,.@knight_t+10;
				mes "[Sir Gray]";
				mes "当然财富很重要。";
				mes "但我们骑士必须为更高尚的美德而活。";
				next;
				break;
			case 3:
				mes "[Sir Gray]";
				mes "啊，绝妙的想法。骑士的力量必须用来保护弱者、捍卫正义。";
				next;
				mes "[Sir Gray]";
				mes "遗憾的是，有些骑士忘记了骑士应有的理想，让我们蒙羞……";
				next;
				break;
			}
			break;
		case 3:
			set .@knight_t,.@knight_t+5;
			mes "[Sir Gray]";
			mes "你说是满足感。";
			mes "看来你已经是";
			mes "优秀的剑士。";
			mes "你想成为骑士有什么特别理由吗？";
			next;
			mes "[Sir Gray]";
			mes "我不了解剑士，";
			mes "但骑士不能放纵自己。有些人痴迷于获得力量，最终无法控制自己。";
			next;
			mes "[Sir Gray]";
			mes "那么……";
			mes "你现在对自己的哪一部分";
			mes "感到不满意？";
			mes "请告诉我。";
			next;
			switch(select("技能。:目标。:外貌。")) {
			case 1:
				set .@knight_t,.@knight_t+5;
				mes "[Sir Gray]";
				mes "技能是成为骑士后通过经验获得的。它不能成为最高目标，否则你永远不会满足。";
				next;
				break;
			case 2:
				set .@knight_t,.@knight_t-5;
				mes "[Sir Gray]";
				mes "我明白了……";
				mes "始终拥有目标非常重要。成为骑士时你可能满怀想法，但它们会随时间改变。";
				next;
				break;
			case 3:
				set .@knight_t,.@knight_t+5;
				mes "[Sir Gray]";
				mes "哦，不……";
				mes "外表并不重要。剑士可能比骑士更强，骑士懒惰也会变弱。";
				next;
				break;
			}
			break;
		}
		mes "[Sir Gray]";
		mes "我理解你的想法，";
		mes "但有些人不经思考";
		mes "就想成为骑士。";
		next;
		mes "[Sir Gray]";
		mes "他们会制造问题，玷污骑士荣誉，造成无法挽回的后果。";
		next;
		mes "[Sir Gray]";
		mes "你也一样。一旦成为骑士，就再也不能变回剑士。骑士的职责与责任将永远伴随你。";
		next;
		mes "[Sir Gray]";
		mes "如果你马上成为骑士，第一件事想做什么？";
		next;
		switch(select("我要直接去战斗。:有人在等我。:我要更多了解骑士。")) {
		case 1:
			mes "[Sir Gray]";
			mes "战斗……？";
			mes "然后呢？";
			next;
			switch(select("我会在短时间内成长。:我想测试骑士能力。:我想去更具挑战的地方。")) {
			case 1:
				set .@knight_t,.@knight_t+10;
				mes "[Sir Gray]";
				mes "别急着变强。即使成为";
				mes "骑士，你仍然是你自己。";
				next;
				break;
			case 2:
				mes "[Sir Gray]";
				mes "挑战自己是好事。为自己的变化感到高兴没问题，但别忘记骑士的真正品质。";
				next;
				break;
			case 3:
				mes "[Sir Gray]";
				mes "即使成为骑士，你的内心也不会改变。不必过度劳累自己。";
				mes "放松下来，一步一步来。";
				next;
				break;
			}
			break;
		case 2:
			mes "[Sir Gray]";
			mes "谁在";
			mes "等你？";
			next;
			switch(select("我的朋友。:我的公会成员。:我的恋人。")) {
			case 1:
				mes "[Sir Gray]";
				mes "我明白了，他们会分享你成就的喜悦。永远不要失去善良的心，并始终帮助朋友。";
				next;
				break;
			case 2:
				mes "[Sir Gray]";
				mes "他们会与你分享幸福与困难。作为骑士，你必须始终保护他们。";
				next;
				break;
			case 3:
				mes "[Sir Gray]";
				mes "哦，青春！";
				mes "为了心爱之人成为";
				mes "骑士！";
				mes "永远保护"+((Sex==SEX_MALE)?"她":"他")+"……";
				mes "即使牺牲";
				mes "自己的生命！";
				next;
				mes "[Sir Gray]";
				mes "还有……";
				mes "永远爱他们。";
				mes "真挚的感情";
				mes "很难找到。";
				next;
				break;
			}
			break;
		case 3:
			mes "[Sir Gray]";
			mes "态度不错……";
			mes "你打算";
			mes "学习什么？";
			next;
			switch(select("适合骑士前往的地方……:骑士的不同道路……:作为骑士赚更多钱的方法……")) {
			case 1:
				set .@knight_t,.@knight_t+5;
				mes "[Sir Gray]";
				mes "世上有许多舒适或不舒适的地方。但骑士必须";
				mes "能够在任何地方生存。";
				next;
				break;
			case 2:
				mes "[Sir Gray]";
				mes "外面有许多类似的骑士。把他们当作前辈，多问问题。";
				next;
				break;
			case 3:
				set .@knight_t,.@knight_t+15;
				mes "[Sir Gray]";
				mes "哦，不。你把财富作为骑士的首要目标吗？我们不该这样。想清楚后再来";
				mes "……";
				next;
				break;
			}
			break;
		}
		mes "[Sir Gray]";
		mes "哦，不知不觉我们";
		mes "聊了太久……";
		mes "很抱歉让你";
		mes "在这里待了";
		mes "这么久。";
		next;
		if (.@knight_t == 0) {
			set KNIGHT_Q,14;
			changequest 9011,9012;
			mes "[Sir Gray]";
			mes "我很享受与你交谈。你让我想起年轻时的自己。我们去找队长决定你的";
			mes "转职吧？";
			next;
			mes "[Sir Gray]";
			mes "别太担心，";
			mes "我非常看好你。";
			mes "现在，去吧~";
			mes "祝你好运。";
			close;
		}
		else if (.@knight_t == 5) {
			set KNIGHT_Q,14;
			changequest 9011,9012;
			mes "[Sir Gray]";
			mes "我很高兴与你交谈。成为骑士后，你可以进一步思考骑士的原则。";
			next;
			mes "[Sir Gray]";
			mes "那么，我们去找队长决定你的转职吧？别太担心。你足够优秀，可以成为骑士！";
			close;
		}
		else if (.@knight_t == 10) {
			set KNIGHT_Q,14;
			changequest 9011,9012;
			mes "[Sir Gray]";
			mes "我很高兴与你交谈。不过，有些";
			mes "事情让我有些在意……";
			next;
			mes "[Sir Gray]";
			mes "你应该去找";
			mes "队长，";
			mes "这样我们才能决定";
			mes "你的转职。";
			next;
			mes "[Sir Gray]";
			mes "别太担心，来参加我的测试意味着其他人也认可你。";
			mes "现在就去吧……！";
			close;
		}
		else {
			set KNIGHT_Q,13;
			mes "[Sir Gray]";
			mes "和年轻人";
			mes "交谈总是很愉快……";
			mes "我很享受。";
			next;
			mes "[Sir Gray]";
			mes "不过你的梦想似乎在别处，或者目标还不清晰。作为剑士再多历练一段时间，然后";
			mes "再回来找我。";
			next;
			mes "[Sir Gray]";
			mes "如果你真的想成为骑士，必须先改变观念。之后我们再看。";
			close;
		}
	}
	else if (KNIGHT_Q == 14) {
		mes "我告诉过你";
		mes "去找";
		mes "队长。";
		next;
		mes "[Sir Gray]";
		mes "大家都会";
		mes "仔细做出";
		mes "决定，";
		mes "所以现在就去！";
		close;
	}
	else {
		mes "哦……";
		mes "一名年轻的剑士。";
		mes "我能为你做什么？";
		next;
		if (select("我想参加转职测试。:哦，没什么。") == 1) {
			mes "[Sir Gray]";
			mes "呵呵~";
			mes "这里还有许多";
			mes "年轻的";
			mes "骑士。";
			next;
			mes "[Sir Gray]";
			mes "如果你和他们";
			mes "全部交谈，";
			mes "我也许会";
			mes "重新考察你。";
			close;
		}
		mes "[Sir Gray]";

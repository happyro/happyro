geffen,203,116,0	script	Guide#gef::GefGuide	705,{
	cutin "gef_soldier",2;
	mes "[吉芬向导]";
	mes "欢迎来到吉芬，";
	mes "这里是魔法之城。";
	mes "如果你需要城镇导航，";
	mes "尽管来问我，";
	mes "我会尽力帮助你。^FFFFFFcobo^000000";
	set .@loop1,1;
	while (.@loop1) {
		next;
		switch(select("城镇指南:移除小地图标记:注意事项:取消")) {
		case 1:
			mes "[吉芬向导]";
			mes "请选择";
			mes "一个地点，";
			mes "从下面的菜单中选择。";
			if (compass_check == 0) {
				mes "要我";
				mes "标记地点";
				mes "在你的小地图上吗？";
				next;
				if (select("是:否") == 1) set .@compass_check,1;
			}
			set .@loop2,1;
			while (.@loop2) {
				if (.@wait_button_chk == 0) set .@wait_button_chk,1;
				else next;
//				next;
				switch(select("^FF0000魔法学院^000000:铁匠铺:武器商店:工具商店:酒吧:旅馆:吉芬塔:取消")) {
				case 1:
					mes "[吉芬向导]";
					mes "吉芬西北部的魔法学院";
					mes "负责";
					mes "转职为魔法师。";
					if (.@compass_check)
						viewpoint 1,61,180,2,0xFF0000;
					break;
				case 2:
					mes "[吉芬向导]";
					mes "铁匠铺";
					mes "位于吉芬中心";
					mes "东南方。";
					if (.@compass_check)
						viewpoint 1,182,59,3,0x00FF00;
					break;
				case 3:
					mes "[吉芬向导]";
					mes "武器商店";
					mes "位于吉芬中心";
					mes "东南方。";
					if (.@compass_check)
						viewpoint 1,99,140,4,0xFF00FF;
					break;
				case 4:
					mes "[吉芬向导]";
					mes "你可以在";
					mes "前往工具商店，";
					mes "从吉芬中心";
					mes "向西南方走。";
					if (.@compass_check)
						viewpoint 1,44,86,5,0xFF00FF;
					break;
				case 5:
					mes "[吉芬向导]";
					mes "酒吧";
					mes "位于吉芬塔";
					mes "东北方。";
					if (.@compass_check)
						viewpoint 1,138,138,6,0xFF00FF;
					break;
				case 6:
					mes "[吉芬向导]";
					mes "旅馆";
					mes "位于";
					mes "吉芬中心";
					mes "向西南方走。";
					if (.@compass_check)
						viewpoint 1,172,174,7,0xFF00FF;
					break;
				case 7:
					mes "[吉芬向导]";
					mes "吉芬塔位于";
					mes "城镇中心。";
					mes "巫师公会在塔顶，";
					mes "塔下甚至还有一座地下城。";
					mes "那座塔周围有许多";
					mes "神秘传说……";
					if (.@compass_check)
						viewpoint 1,120,114,8,0x00FF00;
					break;
				case 8:
					mes "[吉芬向导]";
					mes "如果不想继续显示";
					mes "小地图标记，请让我";
					mes "‘移除小地图标记’，";
					mes "即可取消显示";
					mes "地点标记。";
					set .@loop2,0;
					break;
				}
			}
			break;
		case 2:
			viewpoint 2,237,41,2,0xFF0000;
			viewpoint 2,237,41,3,0x00FF00;
			viewpoint 2,46,345,4,0xFF00FF;
			viewpoint 2,175,220,5,0xFF00FF;
			viewpoint 2,134,221,6,0xFF00FF;
			viewpoint 2,204,214,7,0xFF00FF;
			viewpoint 2,204,214,8,0x00FF00;
			set .@compass_check,0;
			break;
		case 3:
			mes "[吉芬向导]";
			mes "魔法与科技的进步";
			mes "让我们更新了信息";
			mes "系统，可以在小地图上";
			mes "标记地点，";
			mes "方便导航。";
			mes "方便导航。";
			next;
			mes "[吉芬向导]";
			mes "你的小地图位于";
			mes "屏幕右上角。";
			mes "如果看不到，";
			mes "请按 Ctrl + Tab";
			mes "或点击基本信息窗口中的‘地图’按钮。";
			next;
			mes "[吉芬向导]";
			mes "在小地图上，";
			mes "点击‘+’和‘-’";
			mes "符号可以放大或";
			mes "缩小小地图。希望你";
			mes "在吉芬城镇中";
			mes "旅途愉快。";
			break;
		case 4:
			mes "[吉芬向导]";
			mes "好的，冒险者。";
			mes "祝你在旅途中";
			mes "一路平安，";
			mes "无论前往何方……";
			close2;
			set .@loop1,0;
		}
	}
	cutin "gef_soldier",255;
	end;
}

geffen,118,62,0	duplicate(GefGuide)	Guide#2gef	705

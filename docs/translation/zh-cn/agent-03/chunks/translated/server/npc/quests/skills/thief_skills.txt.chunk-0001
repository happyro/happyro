moc_prydb1,154,128,4	script	Alcouskou	118,{
	if (BaseClass == Job_Thief) {
		mes "[Alcouskou]";
		mes "生活中会遇到许多事。有时你不理解，会疑惑某些事为何重要。你可能认为这是无用知识，但并非如此。让我解释。";
		next;
		switch (select("砂尘攻击:后退:寻找石头:投掷石头:我稍后再来。")) {
		case 1:
			switch (skill_thief_1) {
			case 0:
				if ((countitem(7041) > 4) && ((JobLevel > 24) || (BaseJob == Job_Assassin || BaseJob == Job_Rogue))) {
					mes "[Alcouskou]";
					mes "幸运的是，你带了一些沙子。盗贼随身带少量沙子很重要。大多数人不明白这种普通物质的价值。";
					next;
					mes "[Alcouskou]";
					mes "如果在没有沙子的地下城遇到强大魔物，可以用这些沙子弄瞎魔物后逃走。你应该准备专用沙袋。";
					next;
					mes "[Alcouskou]";
				mes "什么？你不会也想让我替你做吧？你一定很懒！！！好吧，去找 RuRumuni。他会做坚固的皮袋。";
					next;
					mes "[Alcouskou]";
				mes "我会等你回来。去斐扬西部找 RuRumuni，我听说他最近在那里。";
					delitem 7041,5; //Fine_Grit
					set skill_thief_1,1;
					close;
				}
				mes "[Alcouskou]";
			mes "优秀盗贼最重要的是隐匿。除非自己愿意，盗贼不该被看见或触碰。有些人认为这是懦弱，但我不这么想。";
				next;
				mes "[Alcouskou]";
			mes "在我看来，我们生活在弱肉强食的世界。这项特殊技能可能让人轻视我……这是什么技能？这是砂尘致盲技能。";
				next;
				mes "[Alcouskou]";
			mes "如果能把沙子扔进或踢进对手眼睛，不仅会降低防御，还会削弱攻击能力。效果非常好，甚至能使其昏迷。";
				next;
				mes "[Alcouskou]";
			mes "我们也得生存。不是我们就是他们……准备一些沙子很重要。你觉得呢？如果喜欢，就去找 5 份细沙砾。";
				next;
				mes "[Alcouskou]";
			mes "我知道你急着学，但必须先收集 5 份细沙砾。在收集前我不能教。别失望，快去收集。";
				next;
				mes "[Alcouskou]";
			mes "哦，差点忘了！！！想学这项技能，必须有足够经验正确使用。也就是说，职业等级至少 25。";
				close;
			case 1:
				mes "[Alcouskou]";
			mes "去斐扬西部找 RuRumuni。他会为你的沙子做精致耐用的袋子。";
				next;
				mes "[Alcouskou]";
			mes "我会收下这 5 份细沙砾，等候期间为你准备。";
				close;
			case 2:
				mes "[Alcouskou]";
			mes "好！太棒了！！真是精美的袋子！";
				mes "小巧易携，而且容量足够装沙子。";
				mes "这是使用该技能的完美^3355FF无限皮袋^000000！";
				mes "";
				mes "";
				next;
				mes "[Alcouskou]";
				mes "好，让我看看你的技能如何——";
				mes "试试看！！";
				mes "";
				next;
				mes "[Alcouskou]";
				mes "啊，注意我的眼睛！！";
				mes "^5533FF- *throwing sand* -^000000";
				next;
				mes "^5533FF- *tossing sand* -^000000";
				next;
				mes "[Alcouskou]";
				mes "呼呼呼……你真是天生的！";
				mes "太棒了！";
				mes "看来我没什么别的";
				mes "可以教你了。";
				mes "希望这项技能将来能帮到你。";
				mes "";
				delitem 7042,1; //Leather_Bag_Of_Infinity
				skill "TF_SPRINKLESAND",1,SKILL_PERM;
				close;
			}
	case 2:
		if ((countitem(940) > 19) && ((JobLevel > 34) || (BaseJob == Job_Assassin || BaseJob == Job_Rogue))) {
			mes "[Alcouskou]";
			mes "好！我们来练习！";
			next;
			mes "[Alcouskou]";
			mes "Suuu Suuu uk -";
			next;
			mes "[Alcouskou]";
			mes "Suuuuk - -";
			next;
			mes "[Alcouskou]";
			mes "Suk - Suuuk - - -";
			next;
			mes "[Alcouskou]";
			mes "很好！以你现在的水平，";
			mes "我相信你可以自己提高技能。";
			mes "";
			delitem 940,20; //Grasshopper's_Leg
			skill "TF_BACKSLIDING",1,SKILL_PERM;
			close;
		}
		mes "[Alcouskou]";
		mes "我们通常会考虑攻击和伤害，";
		mes "但必须意识到，逃跑和攻击";
		mes "同样重要！";
		mes "我们以自己的";
		mes "";
		mes "";
		next;
		mes "[Alcouskou]";
		mes "速度和快速闪避为傲，";
		mes "但战斗时你肯定也发现了，";
		mes "即使我们的闪避很优秀，";
		mes "只要被击中一次，就会陷入";
		mes "严重的危险。";
		mes "";
		next;
		mes "[Alcouskou]";
		mes "确实，有时我们轻松闪避攻击时，";
		mes "会觉得对手很可笑。";
		mes "但如果同时遭到多人攻击，";
		mes "你必须记住，我们甚至可能";
		mes "没有闪避的空间。";
		mes "";
		next;
		mes "[Alcouskou]";
		mes "你必须迅速决定逃跑。";
		mes "大多数人会立即逃走，但我们不必如此。";
		mes "即使看不到突破口，";
		mes "我们的技能也能让我们";
		mes "从非常危险的困境中脱身。";
		mes "";
		next;
		mes "[Alcouskou]";
		mes "这项技能会运用我们的能量，";
		mes "让我们悄无声息地脱身。";
		mes "我们可以在短时间内使用它，";
		mes "迅速拉开与对手的距离。";
		mes "这项技能需要无数小时的";
		next;
		mes "[Alcouskou]";
		mes "练习才能掌握。";
		mes "如果你想学习并练习，";
		mes "就需要准备一些物品。";
		mes "准备 ^3355FF20 个蝗虫后腿^";
		mes "开始训练。";
		next;
		mes "[Alcouskou]";
		mes "哦，顺便说一下……";
		mes "你需要具备盗贼技能基础，";
		mes "才能正确掌握这项技能。";
		mes "也就是说，你至少需要达到职业等级";
		mes "^3355FF35^000000 的经验。";
		mes "否则我无法教你。";
		close;
	case 3:
		if ((countitem(912) > 0) && (countitem(948) > 0) && (countitem(908) > 4) && ((JobLevel > 19) || (BaseJob == Job_Assassin || BaseJob == Job_Rogue))) {
			mes "[Alcouskou]";
			mes "哇，你已经准备好了吗？";
			mes "很好，我看到了你的潜力。";
			mes "你的热情确实很真诚。";
			mes "好，我们开始训练吧？";
			mes "投掷石头……";
			mes "找一块重量合适的光滑石头。";
			next;
			mes "[Alcouskou]";
			mes "选对石头非常重要，";
			mes "这是成功的关键。";
			mes "我可以告诉你无数次，";
			mes "但你亲自看看会更好。";
			mes "来，就在这里试试技能，";
			mes "我会看着你。";
			next;
			mes "^3355FF- Shweeput ! -^000000";
			next;
			mes "^3355FF- Cheeeguk! -^000000";
			next;
			mes "^3355FF- Shyaaaakkk ! -^000000";
			next;
			mes "[Alcouskou]";
			mes "很好。你似乎很容易掌握了这项技能。";
			mes "你可以在闲暇时自行练习提高。";
			mes "希望它将来能帮助你。";
			mes "……希望很快再见到你。";
			mes "";
			delitem 912,1; //Zargon
			delitem 948,1; //Bear's_Foot
			delitem 908,5; //Spawn
			skill "TF_PICKSTONE",1,SKILL_PERM;
			close;
		}
		mes "[Alcouskou]";
		mes "我们公会中技艺娴熟、经验丰富的成员通常都很能干！";
		mes "他们可以捡起路边的小石头，";
		mes "从远处准确而迅速地击中对手。";
		mes "";
		mes "";
		mes "";
		next;
		mes "[Alcouskou]";
		mes "他们意识到不把这项技能教给别人太浪费了。";
		mes "于是成立了训练这项技能的团体……";
		mes "^3355FF‘寻找石头’^000000和^3355FF‘投掷石头’^000000技能";
		mes "就是这样诞生的。";
		mes "";
		mes "";
		next;
		mes "[Alcouskou]";
		mes "能够在大多数地方找到石头，";
		mes "并把它投向远处的敌人非常方便。";
		mes "这确实是很有价值的技能。";
		mes "无需花费 Zeny，你就能使用它。";
		mes "";
		mes "";
		next;
		mes "[Alcouskou]";
		mes "我真的觉得这是项很棒的技能。";
		mes "你觉得呢？";
		mes ". . . . . Hah Hah Hah . . . . . .";
		next;
		mes "[Alcouskou]";
		mes "^3355FF‘寻找石头！’^000000技能几乎可以在任何地方使用。";
		mes "从地面捡起适合投掷的";
		mes "光滑且重量合适的石头。";
		mes "要熟练掌握这项技能，";
		mes "需要一些熟悉和技巧。";
		mes "";
		next;
		mes "[Alcouskou]";
		mes "虽然训练量不大，";
		mes "但仍需要你全力以赴……";
		mes "";
		mes ". . . . . *Ahem* . . . . .";
		mes "先练习捡起一份^3355FF熊足皮^000000，熟悉动作。";
		mes "";
		next;
		mes "[Alcouskou]";
		mes "没有石头的话，试着捡起一个^3355FF魔菇芽孢^000000！";
		mes "这会不会太少？";
		mes "再加上^3355FF5 个魔菇芽孢^000000！";
		mes "让我看看你的本领！";
		mes "用你认为合适的方法找回这些物品。";
		close;
	case 4:
		if ((countitem(910) > 1) && (countitem(911) > 1) && ((JobLevel > 14) || (BaseJob == Job_Assassin || BaseJob == Job_Rogue))) {
			mes "[Alcouskou]";
			mes "哇！你已经收集好物品了吗？";
			mes "很好，你想开始吗？";
			mes "准备好你收集的物品……";
			next;
			mes "^3355FF- Shyuuk ! -^000000";
			next;
			mes "^3355FF- Shyuuuk Tuk. . -^000000";
			next;
			mes "^3355FF- Shyupattt !! - Tauk !! -^000000";
			next;
			mes "[Alcouskou]";
			mes "攻击～～～！！";
			mes "做得非常好！";
			mes "你现在拥有足够的力量和技巧。";
			mes "";
			next;
			mes "[Alcouskou]";
			mes "好，训练就是这样。";
			mes "今后如何使用它由你决定……";
			mes "祝你好运！";
			mes "";
			delitem 910,2; //Garlet
			delitem 911,2; //Scell
			skill "TF_THROWSTONE",1,SKILL_PERM;
			close;
		}
		mes "[Alcouskou]";
		mes "我们公会中技艺娴熟、经验丰富的成员通常很能干！";
		mes "他们可以捡起路边的小石头，";
		mes "从远处准确而迅速地击中对手。";
		mes "";
		mes "";
		mes "";
		next;
		mes "[Alcouskou]";
		mes "他们意识到不把这项技能教给别人太浪费了。";
		mes "于是成立了训练这项技能的团体……";
		mes "^3355FF‘寻找石头’^000000和^3355FF‘投掷石头’^000000技能";
		mes "就是这样诞生的。";
		mes "";
		mes "";
		next;
		mes "[Alcouskou]";
		mes "能够在大多数地方找到石头，";
		mes "并把它投向远处的敌人非常方便。";
		mes "这确实是很有价值的技能。";
		mes "无需花费 Zeny，你就能使用它。";
		mes "";
		mes "";
		next;
		mes "[Alcouskou]";
		mes "我真的觉得这是项很棒的技能。";
		mes "你觉得呢？";
		mes ". . . . . Hah Hah Hah . . . . . .";
		next;
		mes "[Alcouskou]";
		mes "^3355FF投掷石头！！^000000";
		mes "这项技能使用方便，";
		mes "如果你会挑石头，就不需要额外花钱。";
		mes "";
		mes "如果你不知道如何挑选";
		next;
		mes "[Alcouskou]";
		mes "石头，也可以从会挑的人那里购买。";
		mes "如果你能挑到好石头，";
		mes "这项技能也会很有利可图。";
		mes "你觉得呢？喜欢这个想法吗？";
		next;
		mes "[Alcouskou]";
		mes "如果你想精通这项技能，";
		mes "你需要大量训练。训练还需要一些不容易找到的物品……当然，以你的本领应该不难……";
		next;
		mes "[Alcouskou]";
		mes "首先需要两个 ^3355FF‘Garlet’^000000 和两个 ^3355FF‘Scell’^000000。确保它们像石头一样可以投掷。集齐后我会教你。";
		close;
	case 5:
		mes "[Alcouskou]";
		mes "看来你经验不足……我们可能需要更多时间考虑你。";
		close;
	}
}
	mes "[Alcouskou]";
	mes "大多数盗贼和刺客都有做好工作的基础技能。不过，我能教他们的技能在其他地方学不到。如果你决定";
	next;
	mes "[Alcouskou]";
	mes "成为盗贼或刺客，或认识这样的人，就来找我或把他们带来。这些新技能应该教给所有想学习的人。";
	close;
}

payon,91,77,3	script	Bag Seller	99,{
	mes "[RuRumuni]";
	mes "我只是这里一名普通的商人";
	mes "在斐扬。我购买猎人带来的动物皮革，制作皮袋出售。我从小接触皮革工艺，非常擅长。";
	next;
	switch (skill_thief_1) {
	case 0:
		mes "[RuRumuni]";
	mes "梦罗克一带有盗贼公会。我认识那里的人，他们会把需要我制作物品的盗贼送来，比如";
		mes "^3355FF' Leather Bag of Infinity '^000000.";
	mes "他们经常光顾我的店。";
		close;
	case 1:
		if ((countitem(952) > 0) && (countitem(1055) > 0) && (countitem(1025) > 0)) {
			mes "[RuRumuni]";
		mes "啊……你是来取皮袋的。很好，很好。稍等一下，我马上制作。TuTak TuTak Shyuku Shyuku Shyuku";
			mes "- - - - -";
			next;
			mes "[RuRumuni]";
		mes "好了，完成了。把这个皮袋交给盗贼公会的 Alcouskou，他会教你想学的技能。";
			delitem 952,1; //Cactus_Needle
			delitem 1055,1; //Earthworm_Peeling
			delitem 1025,1; //Spiderweb
			set skill_thief_1,2;
			getitem 7042,1; //Leather_Bag_Of_Infinity
			close;
		}
		mes "[RuRumuni]";
		mes "找盗贼公会的 Alcouskou 订购无限皮袋。你应该知道，无限皮袋需要大量时间和技巧制作。要制作它，你必须提供材料。";
		next;
		mes "所需材料如下……";
		mes "^3355FF' Earthworm Peeling '^000000";
		mes "^3355FF' Cobweb '^000000";
		mes "^3355FF' Cactus Needle '^000000";
		mes "每种各需要一个。";
		close;
	case 2:
		mes "[RuRumuni]";
		mes "这是你的无限皮袋。把它带给盗贼公会的 Alcouskou，告诉他你已经准备好学习技能。";
		close;
	}

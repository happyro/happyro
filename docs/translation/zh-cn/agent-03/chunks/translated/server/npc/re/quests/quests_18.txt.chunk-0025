			mes "[Mejai]";
			mes "好吧，如果不方便，那也没办法。";
			next;
			mes "[Mejai]";
			mes "人生中总会有再次合作的一天，对吧？如果你改变主意，我们就再试着一起工作吧。";
			close;
		}
		mes "[Mejai]";
		mes "好。我认为老板和员工之间相互尊重很重要。你应该能猜到我为什么这么说。";
		next;
		mes "[Mejai]";
		mes "既然我们开始合作，以后请称呼我为梅杰总裁。我会像尊重员工一样尊重你。";
		next;
		mes "[Mejai]";
		mes "我不会亏待你。我已经厌倦那种做法了……";
		next;
		mes "[Mejai]";
		mes "首先，我要教你最重要的工作：如何采集半花。";
		next;
		erasequest 5933;
		setquest 5934;
		mes "[Mejai]";
		mes "准备好后再来和我说话。";
		close;
	}
	if (isbegin_quest(5933) == 2) {
		mes "[Mejai]";
		mes "又回来了？我正忙着准备生意，没重要的事就别来打扰我，好吗？";
		next;
		if (select( "抱歉，也许下次。", "我可以参与这项生意吗？" ) == 1) {
			mes "[Mejai]";
			mes "小心点。我心事很多，可能会说话尖锐。";
			close;
		}
		mes "[Mejai]";
		mes "真的吗？嗯！";
		mes "明白了。我认为雇主和员工相互尊重至关重要。你应该能猜到我为什么这么说。";
		next;
		mes "[Mejai]";
		mes "既然我们开始合作，以后请称呼我为梅杰经理。我也会把你当作团队成员来尊重，而不只是先生。";
		next;
		mes "[Mejai]";
		mes "你不会看到我鲁莽行事。我已经厌倦那种行为了……";
		next;
		mes "[Mejai]";
		mes "首先，应该教你最重要的工作，也就是采集半花的方法。";
		next;
		erasequest 5933;
		setquest 5934;
		mes "[Mejai]";
		mes "准备好后再来和我说话。";
		close;
	}
	if (isbegin_quest(5934) == 1) {
		mes "[Mejai]";
		mes "准备开始半花采集教学了吗？";
		next;
		if (select( "经理，请继续。", "请稍等。" ) == 2) {
			mes "[Mejai]";
			mes "不着急。";
			close;
		}
		mes "[Mejai]";
		mes "嗯，欢迎参加半花采集教学。";
		next;
		mes "[Mejai]";
		mes "采集过程分为四个主要步骤。首先，剪下花茎。";
		next;
		mes "[Mejai]";
		mes "第二，去除剪下花茎上的叶子。";
		next;
		mes "[Mejai]";
		mes "第三，将花茎末端浸入装有水和秘粉的小容器中并充分混合。";
		next;
		mes "[Mejai]";
		mes "最后，将花茎末端小心装入容器，防止花朵枯萎。";
		next;
		mes "[Mejai]";
		mes "单看方法本身，应该不难，对吧？";
		next;
		mes "[Mejai]";
		mes "不过在进阶阶段，花茎剪切角度、根据半花生长位置去除的叶片数量，以及容器中的水和秘粉量都可能不同……";
		next;
		mes "[Mejai]";
		mes "别担心。你正式接手任务时，我会提供详细说明，保证你不会忘记任何步骤。";
		next;
		mes "[Mejai]";
		mes "你看到旁边的练习半花了吗？";
		next;
		mes "[Mejai]";
		mes "我创业时似乎把一半资金都投入制作这朵练习半花了。";
		next;
		mes "[Mejai]";
		mes "不过我不后悔，因为它让员工培训更容易。我们就把它当成真的来练习吧？";
		next;
		erasequest 5934;
		setquest 5935;
		mes "[Mejai]";
		mes "你觉得呢？假设半花在树下盛开，用我旁边的练习半花来练习吧？";
		close;
	}
	if (isbegin_quest(5935) == 1) {
		mes "[Mejai]";
		mes "请注意我旁边的练习半花。";
		close2;
		cloakoffnpcself( "Half Flower#E18_6" );
		end;
	}
	if (isbegin_quest(5936) == 1) {
		// if (rentalcountitem(1000407) < 1)
		mes "[Mejai]";
		mes "做得好。今后的半花采集也要按照刚才的方法进行。";
		next;
		mes "[Mejai]";
		mes "你的任务是把采集到的花交给我。";
		next;
		mes "[Mejai]";
		mes "作为员工，你还要同时处理其他工作……";
		next;
		mes "[Mejai]";
		mes "工作时请在半花枯萎前把它们带给我，我会很感激。";
		next;
		mes "[Mejai]";
		mes "哦！还有一点：用我教的方法采集，花朵保存的时间会更长。";
		next;
		select( "When shall we start our work?" );
		mes "[Mejai]";
		mes "今天我也忙着准备商店开业，不如从明天开始？";
		next;
		select( "Sure. See you tomorrow." );
		mes "[Mejai]";
		mes "哎呀，我得把这个给你。";
		next;
		mes "[Mejai]";
		mes "我已经完成了自己的工作，不过培训期间不能让你在这事那事上敷衍过去。";
		next;
		if (rentalcountitem(1000407) > 0)
			delitem 1000407,1;	// Ep18_Half_Flower
		completequest 5936;
		setquest 5937;
		getitem 1000405,10;	// Ep18_Amethyst_Fragment
		getexp 7769124,3000000;	// dummy value
		mes "[Mejai]";
		mes "现在给你的东西是今天培训的奖励。好好休息，明天见。";
		close;
	}
	mes "[Mejai]";
	mes "好好休息，明天见。";
	close;

OnInit:
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "isbegin_quest(5933) == 1" );
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "isbegin_quest(5934) == 1" );
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "isbegin_quest(5936) == 1" );
	end;
}

// Quest: Picking Half Flowers. Step 3 (final).
rachel,72,133,4	script(CLOAKED)	Half Flower#E18_6	4_EP18_HALFFLOWER,{
	if (checkweight(1000407,1) == 0) {
		mes "- Wait a minute !! -";
		mes "- Currently you're carrying -";
		mes "- too many items with you. -";
		mes "- Please try again -";
		mes "- after you loose some weight. -";
		close;
	}
	if (isbegin_quest(5935) == 1) {
		setarray .@good_answer[0],2,2,2,3;
		.@time = 86400;
		mes "这是练习半花。";
		next;
		npctalk "梅杰：假设半花在树下盛开，我们开始练习吧。", "Mejai#E18_5", bc_self;
		next;
		npctalk "梅杰：先剪下半花的花茎，怎么样？", "Mejai#E18_5", bc_self;
		next;
		if (select( "Cut at 10° angle.", "Cut at 20° angle.", "Cut at 30° angle.", "Cut at 40° angle." ) != .@good_answer[0])
			.@time /= 2;
		progressbar "FFFF00",1;
		npctalk "梅杰：谢谢你的决定。我们先从剪花茎开始。", "Mejai#E18_5", bc_self;
		next;
		npctalk "梅杰：明白。接下来去除叶子，留下足够的，其余全部去掉。", "Mejai#E18_5", bc_self;
		next;
		if (select( "Leave 2 leaves.", "Leave 4 leaves.", "Leave 6 leaves.", "Leave 8 leaves." ) != .@good_answer[1])
			.@time /= 2;
		progressbar "FFFF00",1;
		npctalk "梅杰：做得好。接下来准备浸泡花茎末端的罐子。", "Mejai#E18_5", bc_self;
		next;
		npctalk "梅杰：首先，请在小罐子里装满水。", "Mejai#E18_5", bc_self;
		next;
		if (select( "Pour 20 ml.", "Pour 30 ml.", "Pour 40 ml.", "Pour 50 ml." ) != .@good_answer[2])
			.@time /= 2;
		progressbar "FFFF00",1;
		npctalk "梅杰：现在把我制作的秘粉加入水中并混合。", "Mejai#E18_5", bc_self;
		next;
		npctalk "梅杰：请按正确的量混合。", "Mejai#E18_5", bc_self;
		next;
		if (select( "Add 2 grams.", "Add 4 grams.", "Add 6 grams.", "Add 8 grams." ) != .@good_answer[3])
			.@time /= 2;
		npctalk "梅杰：现在是最后一步。", "Mejai#E18_5", bc_self;
		next;
		npctalk "梅杰：把剪下的花茎末端放入刚才混合了水和秘粉的容器中，包装就完成了！", "Mejai#E18_5", bc_self;
		next;
		progressbar "FFFF00",1;
		// note: the timer decreases according to the answer but no idea of the ratio
		rentitem 1000407,.@time;	// Ep18_Half_Flower
		erasequest 5935;
		setquest 5936;
		cloakonnpcself( "Half Flower#E18_6" );
		npctalk "梅杰：完成！请把刚采集的半花带给我，好吗？", "Mejai#E18_5", bc_self;
		close;
	}
	end;

OnInit:
	setunittitle( getnpcid(0), "For Practice" );

	questinfo( QTYPE_QUEST, QMARK_YELLOW, "isbegin_quest(5935) == 1" );
	end;
}

// daily quest
rachel,70,135,4	script(CLOAKED)	Mejai#E18_7	4_M_DST_CHILD,{
	if (checkweight(1000405,3) == 0) {
		mes "- Wait a minute !! -";
		mes "- Currently you're carrying -";
		mes "- too many items with you. -";
		mes "- Please try again -";
		mes "- after you loose some weight. -";
		close;
	}
	if (isbegin_quest(5933) == 1) {
		if (checkquest(5937,PLAYTIME) == 2)
			erasequest 5937;
		npctalk "梅杰：哦，你来了？今天也要精神饱满地开始吗？", "Mejai#E18_7", bc_self;
		mes "[Mejai]";
		mes "欢迎。我们正准备为‘花房’举行一个小型开业仪式。";
		next;
		mes "[Mejai]";
		mes "嗯……";
		next;
		mes "[Mejai]";
		mes "虽然不能请所有人参加，但我真心感谢愿意到场、为这次活动增光的人。";
		next;
		mes "[Mejai]";
		mes "我必须在这里成功。";
		next;
		mes "[Mejai]";
		mes "我知道这并不理想，但这门生意是我用攒下的每一分钱创办的。";
		next;
		mes "[Mejai]";
		mes "没有退路。所以我会尽力，也希望我的员工们同样努力。";
		next;
		mes "[Mejai]";
		mes "我会努力成为以自身行动回报你们努力的老板。";
		next;
		setquest 5942;
		completequest 5942;
		mes "[Mejai]";
		mes "开业仪式结束！现在让我们全心投入工作吧？";
		next;
	}
	switch( checkquest(5937,PLAYTIME) ) {
	case -1:
		break;
	case 0:
	case 1:
		setpcblock PCBLOCK_NPC, true;
		npctalk "梅杰：好了！今天的工作结束了。", "Mejai#E18_7", bc_self;
		sleep2 1000;
		setpcblock PCBLOCK_NPC, false;
		npctalk "梅杰：回家陪伴家人吧。你不只有这一件事要做。", "Mejai#E18_7", bc_self;
		end;
	case 2:
		setpcblock PCBLOCK_NPC, true;
		npctalk "梅杰：你好。今天也一起努力吧。", "Mejai#E18_7", bc_self;
		sleep2 1000;
		setpcblock PCBLOCK_NPC, false;
		break;
	}
	switch( select( "I'm currently busy..", "Harvesting Half Flowers", "Delivering Half Flowers" ) ) {
	case 1:
		npctalk "梅杰：你似乎在忙别的事？有空时来见我。", "Mejai#E18_7", bc_self;
		end;
	case 2:
		for ( .@id = 5938; .@id < 5942; .@id++ ) {
			if (isbegin_quest(.@id) == 1) {
				.@quest_id = .@id;
				break;
			}
		}
		if (.@quest_id == 0)
			.@quest_id = rand(5938,5941);

		switch( isbegin_quest(.@quest_id) ) {
		case 0:
			npctalk "梅杰：你打算采集半花吗？", "Mejai#E18_7", bc_self;
			if (select( "I'll go collect them.", "I'll skip today." ) == 2)
				end;
			switch( checkquest(5937,PLAYTIME) ) {
			case -1:
				break;
			case 0:
			case 1:
				npctalk "梅杰：哦！你确定吗？", "Mejai#E18_7", bc_self;
				setpcblock PCBLOCK_NPC, true;
				sleep2 1000;
				setpcblock PCBLOCK_NPC, false;
				npctalk "梅杰：今天还没结束，如果你提前完成任务，也请考虑来花房帮忙。", "Mejai#E18_7", bc_self;
				end;
			case 2:
				break;
			}
			setquest .@quest_id;
			npctalk "梅杰：今天请小心树旁盛开的半花。", "Mejai#E18_7", bc_self;
			setpcblock PCBLOCK_NPC, true;
			sleep2 1000;
			setpcblock PCBLOCK_NPC, false;
			npctalk "梅杰：好！加油！今天也精神饱满地带回新鲜半花。", "Mejai#E18_7", bc_self;
			end;
		case 1:
			if (rentalcountitem(1000407) < 1) {
				npctalk "梅杰：今天也请继续为新鲜半花努力。", "Mejai#E18_7", bc_self;
				end;
			}
			delitem 1000407,1;	// Eps18_Half_Flower
			erasequest .@quest_id;
			if (checkquest(5937,PLAYTIME) == 2)
				erasequest 5937;
			setquest 5937;
			getitem 1000405,3;	// Ep18_Amethyst_Fragment
			getexp 18252408,2000000;
			npctalk "梅杰：今天也辛苦了。剩下的交给我吧。", "Mejai#E18_7", bc_self;
			end;
		case 2:
			end;	// impossible
		}
		end;
	case 3:
		npctalk "梅杰：这项服务我还在考虑。等生意稳定一些后，也许可以开始？", "Mejai#E18_7", bc_self;
		setpcblock PCBLOCK_NPC, true;
		sleep2 1000;
		setpcblock PCBLOCK_NPC, false;
		npctalk "梅杰：到那时就拜托你帮忙了。", "Mejai#E18_7", bc_self;
		end;
	}
	end;

OnInit:
	questinfo( QTYPE_DAILYQUEST, QMARK_YELLOW, "isbegin_quest(5936) == 2 && isbegin_quest(5938) == 0 && isbegin_quest(5939) == 0 && isbegin_quest(5940) == 0 && isbegin_quest(5941) == 0 && checkquest(5937,PLAYTIME) == 2" );
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "isbegin_quest(5936) == 2 && rentalcountitem(1000407) > 0" );
	end;
}

gw_fild01,325,376,1	script	Half Flower#EP18_R01	4_EP18_HALFFLOWER,7,7,{
	if (checkweight(1000407,1) == 0) {
		mes "- Wait a minute !! -";
		mes "- Currently you're carrying -";
		mes "- too many items with you. -";
		mes "- Please try again -";
		mes "- after you loose some weight. -";
		close;
	}
	for ( .@id = 5938; .@id < 5942; .@id++ ) {
		if (isbegin_quest(.@id) == 1) {
			.@quest_id = .@id;
			break;
		}
	}
	if (.@quest_id == 0) {
		unittalk getcharid(3), "Half flower is blooming", bc_self;
		end;
	}
	// player interacts with the npc according to the quest ID
	// 5938 requires EP18_R (flower near a Rock)
	// 5939 requires EP18_L (?)
	// 5940 requires EP18_T (Tree)
	// 5941 requires EP18_W (Water)
	switch( .@quest_id ) {
	case 5938:
		.@string$ = "EP18_R";
		setarray .@good_answer[0],4,1,4,1;
		break;
	case 5939:
		.@string$ = "EP18_L";
		setarray .@good_answer[0],3,2,3,2;
		break;
	case 5940:
		.@string$ = "EP18_T";
		setarray .@good_answer[0],2,2,2,3;
		break;
	case 5941:
		.@string$ = "EP18_W";
		setarray .@good_answer[0],1,4,1,4;
		break;
	}
	if (compare(strnpcinfo(2), .@string$) == false) {
		cloakonnpc strnpcinfo(0), getcharid(0);
		end;
	}
	if (rentalcountitem(1000407) > 0) {
		mes "- the Half Flower is more";
		mes "- not necessary, before wither";
		mes "- Bring it to Mejai.";
		close;
	}
	.@time = 86400;
	mes "- The Half Flower is in bloom. Let's";
	mes "- gather the required materials from the";
	mes "- harvesting tool provided by Mejai.";
	next;
	unittalk getcharid(3), "" + strcharinfo(0) + " : What angle should I cut the stem?", bc_self;
	next;
	if (select("以 10° 角切割", "以 20° 角切割", "以 30° 角切割", "以 40° 角切割" ) != .@good_answer[0])
		.@time /= 2;
	progressbar "FFFF00",1;
	unittalk getcharid(3), "" + strcharinfo(0) + " : How many leaves should I leave?", bc_self;
	next;
	if (select("留下 2 片叶子", "留下 4 片叶子", "留下 6 片叶子", "留下 8 片叶子" ) != .@good_answer[1])
		.@time /= 2;
	progressbar "FFFF00",1;
	unittalk getcharid(3), "" + strcharinfo(0) + " : How many milliliters of water should I put in the small bottle?", bc_self;
	next;
	if (select("加入 20 毫升", "加入 30 毫升", "加入 40 毫升", "加入 50 毫升" ) != .@good_answer[2])
		.@time /= 2;
	progressbar "FFFF00",1;
	unittalk getcharid(3), "" + strcharinfo(0) + " : How many grams of secret powder should I put in?", bc_self;
	next;
	if (select( "Put in 2 grams.", "Put in 4 grams.", "Put in 6 grams.", "Put in 8 grams." ) != .@good_answer[3])
		.@time /= 2;
	progressbar "FFFF00",1;
	cloakonnpcself();
	// note: the timer decreases according to the answer but no idea of the ratio
	rentitem 1000407, .@time;	// Ep18_Half_Flower
	mes "- You have harvested the Half Flower.";
	mes "- Let's deliver it to Mejai before it withers.";
	close;

OnTouch:
	for ( .@id = 5938; .@id < 5942; .@id++ ) {
		if (isbegin_quest(.@id) == 1) {
			.@quest_id = .@id;
			break;
		}
	}
	if (.@quest_id == 0)
		end;
	setarray .@string$[5938], "EP18_R", "EP18_L", "EP18_T", "EP18_W";
	if (compare(strnpcinfo(2), .@string$[.@quest_id]) == false) {
		cloakonnpc strnpcinfo(0), getcharid(0);
		end;
	}
	end;
}

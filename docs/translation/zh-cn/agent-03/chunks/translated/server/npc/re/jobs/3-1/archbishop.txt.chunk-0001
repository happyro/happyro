//===== rAthena Script =======================================
//= Arch Bishop Job Quest
//===== By: ==================================================
//= L0ne_W0lf
//= Credits: Gepard
//===== Current Version: =====================================
//= 2.0
//===== Compatible With: =====================================
//= rAthena Project
//===== Description: =========================================
//= [Official Conversion]
//= Job change Quest from Priest / High Priest -> Arch Bishop.
//===== Additional Comments: =================================
//= 1.0 First version.
//= 1.1 Fixed class checks for arch bishops.
//= 1.2 Fixed Job tags typos.
//= 1.3 Made some NPC's into duplicates and fixed some && / || checks. [Masao]
//= 1.4 Fixed Job_Archbishop/Job_Archbishop_T typos. [Euphy]
//= 1.5 Redone the whole Script. [Masao]
//= 1.5a Fixed little typo in Baby Priest & Baby Arch Bishop checks. [Masao]
//= 1.5b More small fixes. [Euphy]
//= 1.6 Fixed bugs where players unable to continue the quest. [Joseph]
//= 1.7 Updated script, many bugs fixed. [Euphy]
//= 1.7a Moved warps to separate file. [Euphy]
//= 1.8 Bug fixes and corrections. [Euphy]
//= 1.9 Added GM management function. [Euphy]
//= 2.0 Added VIP features. [Euphy]
//============================================================

prt_church,103,88,3	script	Praying Minister#arch	60,{
	if (BaseJob != Job_Priest) {
		if (Class == Job_Arch_Bishop || Class == Job_Arch_Bishop_T || Class == Job_Baby_Arch_Bishop) {
			mes "[Praying Minister]";
			mes "啊！大主教。";
			mes "你已经抵达光明之境。";
			mes "希望你在冒险中为人们带来幸福与荣耀。";
			close;
		}
		mes "[Praying Minister]";
		mes "在全能的奥丁神面前，";
		mes "没有人比他更睿智，";
		mes "也没有人比他更仁慈。";
		next;
		mes "[Praying Minister]";
		mes "奥丁的所有牧师都应勤勉，绝不能懒于侍奉奥丁。";
		next;
		mes "[Praying Minister]";
		mes "最近我听说，牧师们对奥丁的职责日渐懈怠，沉迷于世俗的华丽。";
		next;
		mes "[Praying Minister]";
		mes "如果你见到这些牧师，能请他们前往普隆德拉教堂吗？";
		next;
		mes "[Praying Minister]";
		mes "他们会散发特殊气息，很容易辨认。";
		mes "我要让他们成为配得上侍奉奥丁的牧师。";
		close;
	}
	if ((BaseLevel > 98) && (JobLevel > 49)) {
		if (job_arch == 0) {
			if (SkillPoint) {
			mes "不使用全部技能点就无法转职。申请转职前请使用所有技能点～";
				close;
			}
			if (VIP_SCRIPT) {
				callfunc "VIP_Third_Class";
				set job_arch,1;
				setquest 2187;
				next;
			}
			mes "[Praying Minister]";
			mes "在全能的奥丁神面前，没有人比他更睿智，也没有人比他更仁慈。";
			next;
			mes "[Praying Minister]";
			mes "奥丁的所有牧师都应勤勉，绝不能懒于侍奉奥丁。";
			next;
			mes "[Praying Minister]";
			mes (Sex == SEX_MALE?"Brother":"Sister")+", how has your life been? Have you lived it to its fullest?";
			mes "你是否在奥丁的光明中度过一生？";
			next;
			mes "[Praying Minister]";
			mes "我们是牧师，一举一动都被视为神明的行为。";
			mes "我们必须时刻谨记这一点。";
			next;
			mes "[Praying Minister]";
			mes "我们应永远说真话。";
			mes "不能沦为谎言与欺骗的受害者。";
			next;
			mes "[Praying Minister]";
			mes (Sex == SEX_MALE?"Brother":"Sister")+"...";
			mes "即使侍奉奥丁，我们也是普通人。";
			mes "我们可能在不知不觉中堕落，必须认识到这一点。";
			next;
			mes "[Praying Minister]";
			mes "我们始终牢记初心，传播奥丁的教诲。";
			next;
			select("我要怎样才能成为那样的人？");
			mes "[Praying Minister]";
			mes "这是个好问题。";
			mes "方法有很多。";
			mes "不过我推荐这个。";
			next;
			mes "[Praying Minister]";
			mes "你听说过^3131FF圣地巡礼^000000吗？";
			mes "圣地巡礼就是前往圣地，向奥丁神祈求保护与恩典。";
			next;
			mes "[Praying Minister]";
			mes "在圣地向奥丁祈祷时，你会感到自己重获新生。";
			next;
			mes "[Praying Minister]";
			mes "你觉得怎么样？";
			mes "想进行圣地巡礼吗？";
			next;
			switch(select("是的，我想。:我再考虑一下。")) {
			case 1:
				mes "[Praying Minister]";
				mes "这才是正确的态度。";
				mes "生活在凡俗世界的人应获得全新的身心，朝真正的奥丁牧师之路进化。";
				next;
				mes "[Praying Minister]";
				mes "远方有个名叫乌波拉的小村庄。";
				mes "那里住着与自然和谐相处的部落。";
				next;
				mes "[Praying Minister]";
				mes "去那里寻找 Dayan 祭司。";
				mes "准确告诉他：";
				mes "'^3131FFI'm here for the Holy Pilgrimage.^000000'";
				next;
				mes "[Praying Minister]";
				mes "他年纪很大，听力不好。";
				mes "你必须大声清楚地说话。明白了吗？";
				mes "希望这能为你铺平沐浴奥丁之光的道路。";
				set job_arch,1;
				setquest 2187;
				close;
			case 2:
				mes "[Praying Minister]";
				mes "嗯……";
				mes "圣地巡礼并不难。";
				mes "只要记住，一旦踏上这条路，你就走上了成为真正奥丁牧师的道路。";
				next;
				mes "[Praying Minister]";
				mes "改变想法的话，随时来找我。";
				mes "我永远会在这里支持你。";
				close;
			}
		}
		mes "[Praying Minister]";
		mes "进展如何？";
		mes "你在乌波拉见到 Dayan 祭司了吗？";
		close;
	}
	mes "[Praying Minister]";
	mes "在全能的奥丁神面前，没有人比他更睿智，也没有人比他更仁慈。";
	next;
	mes "[Praying Minister]";
	mes "奥丁的所有牧师都应勤勉，绝不能懒于侍奉奥丁。";
	next;
	mes "[Praying Minister]";
	mes "最近我听说牧师们对奥丁的职责日渐懈怠，沉迷于世俗的华丽。";
	next;
	mes "[Praying Minister]";
	mes "如果你见到这些牧师，能请他们前往普隆德拉教堂吗？";
	next;
	mes "[Praying Minister]";
	mes "他们会散发特殊气息，很容易辨认。";
	mes "我要让他们成为配得上侍奉奥丁的牧师。";
	close;
}

umbala,137,227,5	script	Utan Boy#arch	787,{
	mes "[Utan Boy]";
	mes "........";
	close;
}

umbala,139,227,3	script	Priest#arch	60,{
	if (job_arch == 0) {
		mes "[Priest]";
		mes "嗯……巴……恩巴？";
		close;
	} else if (job_arch == 1) {
		mes "[Priest]";
		mes "嗯……巴……恩巴？";
		next;
		mes "[Utan Boy]";
		mes "...............";
		next;
		mes "[Priest]";
		mes "是这样……对吗？";
		mes "嗯……那么……";
		mes "嗯……吗？嗯啊……吗？";
		emotion ET_SWEAT;
		next;
		mes "[Utan Boy]";
		mes "...............";
		next;
		mes "[Priest]";
		mes "呼呜呜呜……";
		mes "哎呀，我感觉好沉重。";
		mes "呵呵呵呵。";
		next;
		mes "- mumbling~ -";
		next;
		mes "[Priest]";
		mes "哈哈哈哈哈。";
		mes "呼呼呼。嗯嗯。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "你好，你是……Dayan 祭司吗？";
		next;
		mes "[Priest]";
		mes "嗯？";
		next;
		mes "他转过头看向你。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "你不是 Dayan 祭司吗？";
		next;
		mes "[Priest]";
		mes "喃喃自语……";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "祭司！Da～yan！对吧！？";
		next;
		mes "[Priest Dayan]";
		mes "啊～，是的。";
		mes "没错，就是我。";
		mes "我是 Dayan。很高兴见到你，"+(Sex?"兄弟。":"姐妹。");
		next;
		mes "老祭司对你露出灿烂笑容。";
		next;
		mes "[Priest Dayan]";
		mes "我忘了戴助听器。嘿嘿。";
		mes "总之，你为什么来这里？";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "嗯，我想告诉你……";
		next;
		input .@inputstr$;
		mes "[" + strcharinfo(0) + "]";
		mes "" + .@inputstr$ + "";
		next;
		if (.@inputstr$ != "I'm here for the Holy Pilgrimage") {
			mes "Dayan 祭司似乎没听懂，只是盯着你微笑。";
			next;
			mes "[Priest]";
			mes "嗯？你说什么？";
			close;
		}
		mes "[Priest Dayan]";
		mes "..............?";
		next;
		mes "他把手拢在耳边朝向你。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "^FF0000我是来进行圣地巡礼的！^000000";
		mes "^FF0000我是来进行圣地巡礼的！^000000";
		mes "^FF0000我是来进行圣地巡礼的！^000000";
		mes "^FF0000我是来进行圣地巡礼的！^000000";
		next;
		mes "[Priest Dayan]";
		mes "嗯……是吗？";
		mes "前往圣地巡礼……";
		mes "我很久没见过如此虔诚的牧师了。";
		mes "欢迎你，"+(Sex?"兄弟。":"姐妹。");
		next;
		mes "老祭司对你露出慈祥的微笑。";
		next;
		mes "[Priest Dayan]";
		mes "看看这座被巨大森林环绕的村庄。";
		mes "你能看到一棵巨树吗？";
		next;
		mes "[Priest Dayan]";
		mes "那棵大树叫作^3131FF Yggdrasil^000000。";
		mes "奥丁创造你所知的米德加尔特世界后，这棵树由 Ymir 的身体形成。";
		next;
		mes "[Priest Dayan]";
		mes "Yggdrasil 的根系延伸到每个世界，根端喷涌出泉水。";
		next;
		mes "[Priest Dayan]";
		mes "根系通往尼弗海姆，那里有赫瓦格密尔泉。";
		mes "米德加尔特有密米尔之泉。";
		mes "众神的世界阿斯加德则有智慧之泉。";
		next;
		mes "[Priest Dayan]";
		mes "传说密米尔之泉涌出智慧，若奥丁赐予你他的眼睛，你就能获得泉水中的全部知识。";
		next;
		mes "[Priest Dayan]";
		mes Sex?"Brother.":"Sister.";
		mes "通过圣地巡礼，我们可以净化身心，使自己更加虔诚。";
		next;
		mes "[Priest Dayan]";
		mes "进入 Yggdrasil。";
		mes "里面的生物可能会攻击你，";
		mes "但请记住，它们只是为了保护 Yggdrasil。";
		next;
		mes "[Priest Dayan]";
		mes "带着明确的目标前进。";
		mes "只要奥丁没有抛弃你，就能在 Yggdrasil 的树干抵达世界起源。";
		mes "到达那里后，找一个安静的地方。";
		next;
		mes "[Priest Dayan]";
		mes "祈祷自己拥有信仰的一生，以虔诚之心赎清罪孽。";
		next;
		mes "[Priest Dayan]";
		mes "赞叹奥丁的全知全能，祈求选择正确道路的智慧。";
		mes "^3131FF关于祈祷方式可以随时问我。^000000";
		next;
		mes "[Priest Dayan]";
		mes "让我想想，去奥丁最著名的造物所在之处。";
		next;
		mes "[Priest Dayan]";
		mes "完成巡礼后，我们一起喝一杯，聊聊你的经历。";
		next;
		mes "- Dayan 祭司再次微笑。-";
		set job_arch,2;
		changequest 2187,2188;
		close;
	} else if (job_arch == 2) {
		mes "[Priest Dayan]";
		mes "这里是世界上最神圣的地方，Yggdrasil。";
		mes "这场神圣仪式会照亮你的灵魂。";
		next;
		switch(select("我该如何祈祷？:取消。")) {
		case 1:
			mes "[Priest Dayan]";
			mes "通过祈祷，我们可以遵循四条道路。";
			mes "记住我现在告诉你的话。";
			next;
			mes "[Priest Dayan]";
			mes "第一条是^3131FF冥想之道^000000。";
			mes "走冥想之道时，必须做好准备，以清明的良知迎接奥丁。";
			next;
			mes "[Priest Dayan]";
			mes "冥想从^3131FF祝福^000000开始，使心灵平静。";
			next;
			mes "[Priest Dayan]";
			mes "第二条是^3131FF苦痛之道^000000。";
			mes "通过苦痛之道，我们忏悔前世行为的报应，反省自身。";
			next;
			mes "[Priest Dayan]";
			mes "不要害怕痛苦。那是必要的，也是清算过往创伤的第一步。";
			next;
			mes "[Priest Dayan]";
			mes "第三条是^3131FF喜悦之道^000000。";
			mes "摆脱痛苦后，心灵会少受折磨；帮助并安慰他人时，你会体验生命的喜悦。";
			next;
			mes "[Priest Dayan]";
			mes "他们会祝福你，因为你是战胜苦难的喜悦存在。这称为^3131FF洒水^000000。";
			mes "你必须饮用^3131FF圣水^000000，感受洒水的意义。";
			next;
			mes "[Priest Dayan]";
			mes "最后一条是^3131FF光明之道^000000。";
			mes "万物都祝福了你，因此你从所有罪孽中解脱。";
			next;
			mes "[Priest Dayan]";
			mes "你重生为光，唱响爱你的喜悦与灵魂的^3131FF荣耀赞歌^000000。";
			next;
			mes "[Priest Dayan]";
			mes "完成所有祈祷后，以虔诚之心起身。";
			mes "如果你的祈祷真诚，奥丁会借给你他的智慧。";
			next;
			mes "[Priest Dayan]";
			mes "准备好了吗？";
			mes "好了，该出发赎清自己了。";
			mes "祈祷完成后再来找我。";
			close;
		case 2:
			mes "[Priest Dayan]";
			mes "希望我的祈祷能减轻你的痛苦……";
			close;
		}
	} else if (job_arch == 3) {
		mes "[Priest Dayan]";
		mes "哦，你回来了。";
		mes "我能感受到你焕然一新的力量。";
		mes "也许你确实真诚祈祷了。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "我感觉心情轻盈，仿佛刚刚重生……";
		next;
		mes "[Priest Dayan]";
		mes "你的信仰给予你信心与勇气。";
		mes "平静心灵的微笑能轻易消除人们的戒备。";
		mes "请用爱与活力激励人们。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "谢谢你的好意。";
		next;
		mes "[Priest Dayan]";
		mes Sex?"Brother.":"Sister.";
		mes "现在，有个地方你应该去。";
		next;
		mes "[Priest Dayan]";
		mes "那地方是施瓦茨瓦尔德的胡格尔。";
		mes "那里有一位名叫 Vinue 的修女祈祷，";
		mes "她是真正为世间受苦之人祈祷的牧师。";
		mes "但我上次见她时，她似乎很悲伤。";
		next;
		mes "[Priest Dayan]";
		mes "你能说服她前往 Yggdrasil 巡礼吗？";
		mes "我想她因为过度祈祷而疲惫不堪。";
		mes "希望 Yggdrasil 的空气能帮助她。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "别担心。";
		mes "我会去见她。";
		next;
		mes "[Priest Dayan]";
		mes "非常感谢。";
		mes "想祈祷时随时来这里，"+(Sex == SEX_MALE?"兄弟。":"姐妹。");
		mes "朋友来访总让我开心。";
		set job_arch,4;
		changequest 2188,2189;
		close;
	}
	mes "[Dayan]";
	mes "你在胡格尔找到 Vinue 了吗？她怎么样？";
	close;
}

yggdrasil01,220,47,0	script	#arch_pilgrimage	139,5,5,{
OnTouch:
	if (job_arch == 2) {
		mes "[" + strcharinfo(0) + "]";
		mes "这是赫瓦格密尔泉吗？";
		mes "这里生机盎然又宁静。";
		mes "很适合祈祷。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "该跪下了……";
		mes "该开始了……";
		mes "嗯，那个祭司对我说了什么？";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "嗯……第一条道路是什么？";
		next;
		switch(select("沉默之道。:忏悔之道。:冥想之道。")) {
		case 1:
			mes "[" + strcharinfo(0) + "]";
			mes "沉默之道……？";
			mes "我觉得不是。";
			close;
		case 2:
			mes "[" + strcharinfo(0) + "]";
			mes "忏悔之道……？";
			mes "我觉得不是。";
			close;
		case 3:
			mes "[" + strcharinfo(0) + "]";
			mes "冥想之道……？";
			mes "没错，是冥想之道。";
			next;
		}
		mes "^3131FF[Priest Dayan]^000000";
		mes "^3131FFThe 1st way is the way of meditation.^000000";
		mes "^3131FFIn the way of meditation, we have to be ready to greet Odin with a clear conscience.^000000";
		next;
		mes "^3131FF[Priest Dayan]^000000";
		mes "^3131FFMeditation starts with a Blessing which calms your mind down.^000000";
		next;
		mes "- You close your eyes slowly and take a deep breath. -";
		next;
		mes "- * BLESSING! * -";
		specialeffect2 EF_BLESSING;
		next;
		mes "祝福效果让你的心灵焕然一新。";
		mes "你继续冥想，试图消除心中的负面情绪。";
		next;
		mes "^3131FF[Priest Dayan]^000000";
		mes "^3131FFThe 2nd is the way of agony^000000.";
		mes "^3131FFThrough the way of agony, we reflect on ourselves with confession about our retribution for the deeds of a former life.^000000";
		next;
		mes "^3131FF[Priest Dayan]^000000";
		mes "^3131FFDon't be afraid of pain. That is a necessity and will be a first step to enter a way to liquidate past wounds.^000000";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "痛苦……我犯过什么错？";
		input .@inputstr$;
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "我向全能的奥丁神忏悔自己的罪过。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "^3131FF" + .@inputstr$ + ".^000000";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "仁慈的奥丁啊，请怜悯我，因为我未能尽到牧师的职责。";
		mes "请指引道路，用你的智慧拯救愚蠢的牧师。";
		next;
		mes "你回想自己的忏悔，再次陷入沉思。";
		next;
		mes ".............................";
		next;
		mes ".............................";
		mes ".........................";

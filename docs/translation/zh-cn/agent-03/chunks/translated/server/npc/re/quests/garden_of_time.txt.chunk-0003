	if (checkweight(1201,1) == 0) {
		mes "^ff0000你携带的物品种类或重量过多，请整理背包。^000000";
		close;
	}
	// ...
	end;
}



// Daily Quests
// t_garden,105,118,0	script	#wp01	HIDDEN_WARP_NPC,6,5,{	// (NPC name is not unique)
t_garden,105,118,0	script	#wp01_t_garden_2	HIDDEN_WARP_NPC,6,5,{
	end;
OnTouch:
	.@state = isbegin_quest(12620);
	if (.@state == 0)
		end;
	cloakoffnpcself( "Ardor#life2" );
	cloakoffnpcself( "Diluvio#life2" );
	cloakoffnpcself( "Procella#life2" );
	cloakoffnpcself( "Terremotus#life2" );
	cloakoffnpcself( "Serpens#life2" );

	if (.@state == 1) {
		mes "[特雷莫图斯]";
		mes "^777700哦，莱蒂西亚派来的冒险者终于到了。";
		next;
		mes "[阿尔多]";
		mes "^aa0000冒险者！你愿意战斗吗？我们不需要弱者！";
		next;
		mes "[迪卢维奥]";
		mes "^0000ff阿尔多！你忘了莱蒂西亚说过至少要礼貌吗？";
		next;
		mes "[普罗切拉]";
		mes "^00cc00迪卢维奥说得对。对前来帮助我们的​​人类表示礼貌比较好。";
		next;
		select( "没问题，请告诉我该做什么" );
		mes "[塞彭斯]";
		mes "^aa00aa我们是来自与花园相连世界的古老灵魂。帮助每种自然元素保持和谐，是刻在灵魂体内的本能。";
		next;
		mes "[塞彭斯]";
		mes "^aa00aa然而，被奇异次元风暴卷走后，与花园相连世界的元素开始失控，最终逐渐变成灵魂。";
		next;
		mes "[特雷莫图斯]";
		mes "^777700如果元素继续变成元素精灵，构成这个世界的物质世界最终会崩溃。必须阻止这一切。";
		next;
		mes "[迪卢维奥]";
		mes "^0000ff冒险者，不能再让元素变成灵魂。用你的力量将它们送回自然。";
		next;
		mes "[特雷莫图斯]";
		mes "^777700这不是破坏自然，而是将变成灵魂、正在消失的元素送回原本位置。你愿意听从请求吗？";
		next;
		select( "我愿意。" );
		mes "[阿尔多]";
		mes "^aa0000你很会沟通！好吧，我每天都会告诉你该做什么！^000000";
		next;
		mes "[阿尔多]";
		mes "^aa0000把星座准备的圣物放在我们对面。用人类语言来说，它叫自动贩卖机。^000000";
		next;
		mes "[阿尔多]";
		mes "^aa0000帮助我们和星座工作的奖励，可以通过那件圣物领取。^000000";
		next;
		completequest 12620;
		navigateto("t_garden",126,117);
		end;
	}
	end;
}

t_garden,97,114,5	script(CLOAKED)	Diluvio#life2	4_EM_DILUVIO,{
	if (isbegin_quest(12620) != 2)
		end;
	if (checkweight(1201,1) == 0) {	// Useless check ?
		mes "由于物品种类或重量过多，我无法与灵魂交流。";
		close;
	}
	switch( checkquest(12598,PLAYTIME) ) {
	case -1:
		break;
	case 0:
	case 1:
		mes "^ff0000Today's request has already been received. You can't receive any more.^000000";
		close;
	case 2:
		erasequest 12598;
		break;
	}
	if (F_queststatus( HAVEQUEST,12633,12634,12635,12636 ) == -1) {
		mes "^0000ff仍有未完成任务。在通过 " + F_mesnavi("灵魂自动贩卖机", "t_garden",128,122) + " 完成所有请求前，无法接收新请求或重置。^000000";
		close;
	}
	mes "[迪卢维奥]";
	mes "我的目标是将逐渐在遗忘记忆中实体化的水之灵魂送回元素。我需要你的帮助。";
	next;
	if (select( "下次再帮你。", "我来帮你" ) == 1)
		end;
	mes "[迪卢维奥]";
	mes "这是给你的请求列表。非常感谢。";
	close2;
	.@quest_id[0] = rand(12633,12634);
	.@quest_id[1] = rand(12635,12636);
	setquest .@quest_id[0];
	setquest .@quest_id[1];
	setquest 12598;
	open_quest_ui(.@quest_id[0]);
	end;

OnInit:
	questinfo( QTYPE_DAILYQUEST, QMARK_YELLOW, "isbegin_quest(12620) == 2 && (checkquest(12598,PLAYTIME) == -1 || checkquest(12598,PLAYTIME) == 2) && F_queststatus( HAVEQUEST,12633,12634,12635,12636 ) == 0" );
	end;
}


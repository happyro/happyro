			mes "[Ansuriya]";
			mes "非常感谢你的支持。这两种奇美拉可能会在封锁的阿米希提亚实验室一楼游荡。";
			next;
			mes "[Ansuriya]";
			mes "请不要让奇美拉离开实验室。";
			setquest 16531;
			close;
		case 0:
		case 1:
			mes "[Ansuriya]";
			mes "<FONT COLOR = 0000CD>" + getmonsterinfo("CHIMERA_AMITERA", MOB_NAME) + " and " + getmonsterinfo("CHIMERA_FILLIA", MOB_NAME) + "</FONT> will be roaming the first floor of the closed lab Amicitia.";
			next;
			mes "[Ansuriya]";
			mes "请分别猎杀 15 只。";
			close;
		case 2:
			mes "[Ansuriya]";
			mes "你去过那里了吗？我提到的任务你都完成了。";
			next;
			mes "[Ansuriya]";
			mes "叛乱军部队也在执行任务。";
			mes "多亏英雄提前组织了行动，看来进入那里变得容易多了。";
			next;
			mes "[Ansuriya]";
			mes "不愧是英雄。在叛乱军之外，很少能找到这样认真、干净利落地工作的人。";
			mes "如果你明天也能参加任务，我会非常感激。";
			erasequest 16531;
			setquest 16530;
			getexp 17726670,12408690;	// TODO: the amount has been changed with the monster update
			close;
		}
		end;
	case 2:
		switch( checkquest(16532,PLAYTIME) ) {
		case -1:
			break;
		case 0:
		case 1:
			mes "[Ansuriya]";
			mes "现在，叛乱军部队正在进行后续行动。";
			mes "英雄，再多休息一会儿也没关系。";
			next;
			mes "[Ansuriya]";
			mes "谢谢你一直积极地和我们并肩作战。";
			mes "天亮后你能回来吗？";
			close;
		case 2:
			erasequest 16532;
			break;
		}
		switch( checkquest(16533,HUNTING) ) {
		case -1:
			mes "[Ansuriya]";
			mes "我想请你猎杀 <FONT COLOR = 0000CD>" + getmonsterinfo("CHIMERA_LITUS", MOB_NAME) + " and " + getmonsterinfo("CHIMERA_VANILAQUS", MOB_NAME) + "</FONT> among the chimeras that were being cultured.";
			next;
			mes "它们已经变异成明显展现风属性和水属性的外形，因此并不难区分。";
			next;
			mes "[Ansuriya]";
			mes "即使没有培养设施，它们的数量仍在增加，所以请分别猎杀 15 只。";
			next;
			if (select( "猎杀", "不猎杀" ) == 2) {
				mes "[Ansuriya]";
				mes "嗯？你改变主意了吗？";
				next;
				emotion ET_KEK;
				mes "[Ansuriya]";
				mes "好吧！我们得重新组织行动了！唉。";
				mes "英雄，你不再冷静考虑一下吗？";
				close;
			}
			mes "[Ansuriya]";
			mes "非常感谢你的支持。这两种奇美拉正待在封锁的阿米希提亚实验室一楼。";
			next;
			mes "[Ansuriya]";
			mes "请不要让奇美拉离开实验室。";
			setquest 16533;
			close;
		case 0:
		case 1:
			mes "[Ansuriya]";
			mes "<FONT COLOR = 0000CD>" + getmonsterinfo("CHIMERA_LITUS", MOB_NAME) + " and " + getmonsterinfo("CHIMERA_VANILAQUS", MOB_NAME) + "</FONT> are staying on the first floor of the closed lab Amicitia.";
			next;
			mes "[Ansuriya]";
			mes "请分别猎杀 15 只。";
			close;
		case 2:
			mes "[Ansuriya]";
			mes "任务完成，确认无误。";
			mes "现在部署叛乱军部队。";
			next;
			mes "[Ansuriya]";
			mes "多亏英雄提前组织了行动，我们就能轻松进入了……";
			mes "非常感谢你。";
			next;
			mes "[Ansuriya]";
			mes "这是我第一次和叛乱军以外的人合作，却感到如此默契。";
			mes "英雄，明天也来参加任务怎么样？";
			setquest 16532;
			erasequest 16533;
			getexp 17724090,12406890;	// TODO: the amount has been changed with the monster update
			close;
		}
		end;
	case 3:
		switch( checkquest(16534,PLAYTIME) ) {
		case -1:
			break;
		case 0:
		case 1:
			mes "[Ansuriya]";
			mes "现在，叛乱军部队正在进行后续行动。";
			mes "英雄，再多休息一会儿也没关系。";
			next;
			mes "[Ansuriya]";
			mes "谢谢你一直积极地和我们并肩作战。";
			mes "天亮后你能回来吗？";
			close;
		case 2:
			erasequest 16534;
			break;
		}
		switch( isbegin_quest(16535) ) {
		case 0:
			mes "[Ansuriya]";
			mes "这是高度机密的任务，所以我只想请英雄帮个忙。";
			next;
			mes "[Ansuriya]";
			mes "我不想让这件事经过太多人的嘴，所以没有让叛乱军部队参与这项任务。";
			next;
			mes "[Ansuriya]";
			mes "没有别的要求，只要在废弃的阿米希提亚实验室一楼找到 <FONT COLOR = 0000CD>维尔纳的痕迹</FONT>。";
			next;
			mes "[Ansuriya]";
			mes "例如维尔纳负责管理阿米希提亚的哪一部分、进行了什么实验……";
			mes "如果有任何对研究所产生影响的发现，请告诉我。";
			next;
			mes "[Ansuriya]";
			mes "文件、档案、数据！什么都可以。";
			mes "你愿意替我去吗？";
			next;
			if (select( "我去", "我不去" ) == 2) {
				mes "[Ansuriya]";
				mes "没关系。不过这也挺让人烦恼的……";
				next;
				mes "[Ansuriya]";
				mes "如果你能对这次请求保密，我会很感激。";
				close;
			}
			mes "[Ansuriya]";
			mes "好。寻找痕迹并不容易……所以请至少找到一处再回来找我。";
			mes "到时候我会好好感谢你。";
			setquest 16535;
			close;
		case 1:
			mes "[Ansuriya]";
			mes "寻找痕迹并不容易……所以请至少找到一处再回来找我。";
			mes "到时候我会好好感谢你。";
			close;
		case 2:
			mes "[Ansuriya]";
			mes "你找到什么痕迹了吗？";
			mes "你找对地方了。这张便条是维尔纳的笔迹。";
			next;
			mes "[Ansuriya]";
			mes "谢谢。我们会把它交给秘密部门的特工调查。";
			mes "那么你应该得到辛勤工作的奖励。";
			next;
			mes "[Ansuriya]";
			mes "谢谢你明天回来继续和我合作。";
			mes "因为这件事不能随便交给任何人。";
			erasequest 16535;
			erasequest 16545;
			setquest 16534;
			getexp 17000000,12000000;
			close;
		}
		end;
	case 4:
		mes "[Ansuriya]";
		mes "嗯？你改变主意了吗？";
		next;
		mes "[Ansuriya]";
		mes "好吧！我们得重新组织行动了！唉。";
		mes "英雄，你不再冷静考虑一下吗？";
		close;
	}
	close;

OnInit:
	questinfo( QTYPE_QUEST2, QMARK_YELLOW, "checkquest(16531,HUNTING) == 2" );
	questinfo( QTYPE_QUEST2, QMARK_YELLOW, "checkquest(16533,HUNTING) == 2" );
	questinfo( QTYPE_QUEST2, QMARK_YELLOW, "isbegin_quest(16535) == 2" );

	questinfo( QTYPE_DAILYQUEST, QMARK_YELLOW, "checkquest(16530,PLAYTIME) == 2" );
	questinfo( QTYPE_DAILYQUEST, QMARK_YELLOW, "checkquest(16532,PLAYTIME) == 2" );
	questinfo( QTYPE_DAILYQUEST, QMARK_YELLOW, "checkquest(16534,PLAYTIME) == 2" );

	questinfo( QTYPE_DAILYQUEST, QMARK_YELLOW, "BaseLevel >= 215 && (checkquest(16531,HUNTING) == -1 && checkquest(16530,PLAYTIME) == -1)" );
	questinfo( QTYPE_DAILYQUEST, QMARK_YELLOW, "BaseLevel >= 215 && (checkquest(16533,HUNTING) == -1 && checkquest(16532,PLAYTIME) == -1)" );
	questinfo( QTYPE_DAILYQUEST, QMARK_YELLOW, "BaseLevel >= 215 && (isbegin_quest(16535) == 0 && checkquest(16534,PLAYTIME) == -1)" );
	end;
}

amicitia1,57,242,3	script	Something#ami1	4_GC109,{
	if (isbegin_quest(16535) == 1) {
		mes "[Something]";
		mes "地板上有个东西。要不要仔细看看？";
		next;
		mes "[Something]";
		mes "一份字迹工整的研究备忘录。维尔纳的笔迹正是这样。";
		next;
		mes "[Something]";
		mes "拿起来看看吧。";
		setquest 16545;
		completequest 16535;
		close2;
		initnpctimer;
		disablenpc();
		end;
	}
	mes "[Something]";
	mes "地板上有个东西。";
	mes "看起来只是垃圾。";
	close;

OnTimer300000:	// unknown timer
	stopnpctimer;
	enablenpc();
	end;
}
amicitia1,152,159,3	duplicate(Something#ami1)	Something#ami2	4_GC109
amicitia1,262,139,3	duplicate(Something#ami1)	Something#ami3	4_GC109
amicitia1,36,106,3	duplicate(Something#ami1)	Something#ami4	4_GC109
amicitia1,244,49,3	duplicate(Something#ami1)	Something#ami5	4_GC109


// amicitia2
pub_cat,89,32,3	script	Gerbena#ami	4_M_REBELLION2,{
	if (BaseLevel < 230) {
		mes "[Gerbena]";
		mes "哇，" + strcharinfo(0) + "! Can I get an autograph?";
		mes "这是我的荣幸！嘿嘿～";
		next;
		mes "- 这是一个需要 230 级或更高等级才能进行的任务 -";
		close;
	}
	mes "[Gerbena]";
	mes "英雄，阿米希提亚实验室二楼有一间人造生命体集中培养室。";
	mes "他们在那里制造更强大的变异奇美拉。";
	next;
	mes "[Gerbena]";
	mes "这很令人惋惜，但如果它们从实验室逃出，会造成难以想象的破坏。";
	mes "你能帮我清理这些奇美拉吗？";
	next;
	switch( select( "仿制与真实", "自然变化", "不帮忙" ) ) {
	case 1:
		switch( checkquest(16536,PLAYTIME) ) {
		case -1:
			break;
		case 0:
		case 1:
			mes "[Gerbena]";
			mes "你今天已经去过那里了吗？如果是的话，不如休息一下？";
			mes "如果过度劳累，状态可能会变差。";
			next;
			mes "[Gerbena]";
			mes "天亮后回来和我们一起行动吧！";
			close;
		case 2:
			erasequest 16536;
			break;
		}
		switch( checkquest(16537,HUNTING) ) {
		case -1:
			mes "[Gerbena]";
			mes "他们在培养舱里进行的工作之一，就是批量生产变异奇美拉。";
			next;
			mes "[Gerbena]";
			mes "他们再次改造变异的人造生命体，进一步强化了它们的攻击性。";
			next;
			mes "[Gerbena]";
			mes "请分别猎杀 15 只 <FONT COLOR = 0000CD>" + getmonsterinfo("CHIMERA_NAPEO", MOB_NAME) + " and " + getmonsterinfo("CHIMERA_GALENSIS", MOB_NAME) + "</FONT> each.";
			mes "它们都是模仿人类外形的生物，同时还拥有强大的奇美拉特性变身能力。";
			next;
			mes "[Gerbena]";
			mes "实验室关闭并无人看管已经有一段时间了。";
			mes "尽快猎杀它们，我才能安心。";
			next;
			if (select( "帮助猎杀", "不猎杀" ) == 2) {
				mes "[Gerbena]";
				mes "啊，你改口了！";
				mes "Gerbena 心碎了！";
				next;
				mes "[Gerbena]";
				mes "但这只是我们单方面的请求。";
				mes "即使你拒绝，我们也无能为力……";
				close;
			}
			mes "[Gerbena]";
			mes "你愿意帮助我们是我们的荣幸！";
			mes "英雄，我能和你一起参加吗？";
			next;
			mes "[Ansuriya]";
			mes "他不喜欢这样。他更习惯独自行动，冷静点，Gerbena。";
			next;
			mes "[Gerbena]";
			mes "呜！请帮我处理掉它们！！";
			setquest 16537;
			close;
		case 0:
		case 1:
			mes "[Gerbena]";
			mes "请分别猎杀 15 只 <FONT COLOR = 0000CD>" + getmonsterinfo("CHIMERA_NAPEO", MOB_NAME) + " and " + getmonsterinfo("CHIMERA_GALENSIS", MOB_NAME) + "</FONT> each.";
			mes "它们都是模仿人类外形的生物，同时还拥有强大的奇美拉特性变身能力。";
			close;
		case 2:
			mes "[Gerbena]";
			mes "现在幻影部队已经出动，继续执行任务。";
			mes "多亏英雄，我们可以轻松进入并制服奇美拉。";
			next;
			mes "[Gerbena]";
			mes "呜，我也想亲眼看看英雄精彩的战斗……";
			mes "也许 someday 我会有机会见到你？";
			next;
			mes "[Gerbena]";
			mes "如果你不介意，明天回来和我们一起行动怎么样？";
			erasequest 16537;
			setquest 16536;
			getexp 37253672,26077570;	// rebalance (unknown jexp, 70% of baseexp)
			close;
		}
		end;
	case 2:
		switch( checkquest(16538,PLAYTIME) ) {
		case -1:
			break;
		case 0:
		case 1:
			mes "[Gerbena]";
			mes "你今天已经去过那里了吗？如果是的话，不如休息一下？";
			mes "如果过度劳累，状态可能会变差。";
			next;
			mes "[Gerbena]";
			mes "天亮后回来和我们一起行动吧！";
			close;
		case 2:
			erasequest 16538;
			break;
		}
		switch( checkquest(16539,HUNTING) ) {
		case -1:
			mes "[Gerbena]";
			mes "集中培养室里的人造生命体中，有变异奇美拉 Lavaeter 和变异奇美拉 Fulgor。";
			next;
			mes "[Gerbena]";
			mes "它看起来像现有的人造生命体 Dieter 和 Bayeri，但实际上完全不同。";
			mes "它与普通人造生命体不同，会自行繁殖，并且不需要主人就能自行做决定。";
			next;
			mes "[Gerbena]";
			mes "你无法救助它们，也不能对它们做任何事。所有这些个体，一个也不能留下，必须全部杀死。";
			next;
			mes "[Gerbena]";
			mes "所以，英雄，你愿意帮我们猎杀 15 只 <FONT COLOR = 0000CD>" + getmonsterinfo("CHIMERA_LAVA", MOB_NAME) + " and " + getmonsterinfo("CHIMERA_FULGOR", MOB_NAME) + "</FONT> each?";
			next;
			if (select( "帮助猎杀", "不猎杀" ) == 2) {
				mes "[Gerbena]";
				mes "啊，你改口了！";
				mes "Gerbena 心碎了！";
				next;
				mes "[Gerbena]";
				mes "但这只是我们单方面的请求。";
				mes "即使你拒绝，我们也无能为力……";
				close;
			}
			mes "[Gerbena]";
			mes "你愿意帮助我们是我们的荣幸！";
			mes "英雄，我能和你一起参加吗？";
			next;
			mes "[Ansuriya]";
			mes "他说他不喜欢这样。他更习惯独自行动，冷静点，Gerbena。";
			next;
			mes "[Gerbena]";
			mes "呜！请帮我处理掉它们！！";
			setquest 16539;
			close;
		case 0:
		case 1:
			mes "[Gerbena]";
			mes "英雄，你愿意猎杀 15 只 <FONT COLOR = 0000CD>" + getmonsterinfo("CHIMERA_LAVA", MOB_NAME) + " and " + getmonsterinfo("CHIMERA_FULGOR", MOB_NAME) + "</FONT> each?";
			mes "你无法救助它们，也不能对它们做任何事。所有这些个体，一个也不能留下，必须全部杀死。";
			close;
		case 2:
			mes "[Gerbena]";
			mes "是的！任务完成，确认无误。现在幻影部队进场！";
			mes "多亏了你，他们可以轻松进入并制服奇美拉。";
			next;
			mes "[Gerbena]";
			mes "呜，我也想亲眼看看英雄漂亮的战斗……";
			mes "也许 someday 我会有机会见到你？";
			next;
			mes "[Gerbena]";
			mes "如果你不介意，明天回来和我们一起行动怎么样？";
			erasequest 16539;
			setquest 16538;
			getexp 37325968,26128177;	// rebalance (unknown jexp, 70% of baseexp)
			close;
		}
		end;
	case 3:
		mes "[Gerbena]";
		mes "啊，你改口了！";
		mes "Gerbena 心碎了！";
		next;
		mes "[Gerbena]";
		mes "但这只是我们单方面的请求。";
		mes "即使你拒绝，我们也无能为力……";
		close;
	}
	end;

OnInit:
	questinfo( QTYPE_QUEST2, QMARK_YELLOW, "checkquest(16537,HUNTING) == 2" );
	questinfo( QTYPE_QUEST2, QMARK_YELLOW, "checkquest(16539,HUNTING) == 2" );

	questinfo( QTYPE_DAILYQUEST, QMARK_YELLOW, "checkquest(16536,PLAYTIME) == 2" );
	questinfo( QTYPE_DAILYQUEST, QMARK_YELLOW, "checkquest(16538,PLAYTIME) == 2" );

	questinfo( QTYPE_DAILYQUEST, QMARK_YELLOW, "BaseLevel >= 230 && (checkquest(16537,HUNTING) == -1 && checkquest(16536,PLAYTIME) == -1)" );
	questinfo( QTYPE_DAILYQUEST, QMARK_YELLOW, "BaseLevel >= 230 && (checkquest(16539,HUNTING) == -1 && checkquest(16538,PLAYTIME) == -1)" );
	end;
}

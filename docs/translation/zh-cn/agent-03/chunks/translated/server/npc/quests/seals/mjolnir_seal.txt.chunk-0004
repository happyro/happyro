						mes "攻击 Sudri 的头部！";
					}
					else if (.@p_atk == 2) {
						mes "" + strcharinfo(0) + "";
						mes "攻击 Sudri 的胸口！";
					}
					else if (.@p_atk == 3) {
						mes "" + strcharinfo(0) + "";
						mes "瞄准 Sudri 的腿！";
					}
					else if (.@p_atk == 4) {
						mes "" + strcharinfo(0) + "";
						mes "请求休息！";
					}
					else {
						mes "" + strcharinfo(0) + "'s";
						mes "弱点暴露！";
					}
					if (.@p_atk == .@n_def) {
						specialeffect EF_GUARD;
						if (.@n_def == 1) {
							mes "--------------------";
						mes "Sudri 扭动纤细身躯，轻松躲开你的攻击。";
							mes "--------------------";
							mes "" + strcharinfo(0) + " misses!";
						}
						else if (.@n_def == 2) {
							mes "--------------------";
						mes "Sudri 交叉粗壮双臂挡住你的攻击。";
							mes "--------------------";
							mes "" + strcharinfo(0) + "'s attack is blocked!";
						}
						else if (.@n_def == 3) {
							mes "--------------------";
						mes "Sudri 优雅跃向空中，躲开你的攻击。";
							mes "--------------------";
							mes "" + strcharinfo(0) + " misses!";
						}
					}
					else if (.@p_atk == 4) {
						specialeffect2 EF_HEAL;
						set .@p_vit,.@p_vit + 10;
						mes "--------------------";
						mes "" + strcharinfo(0) + "";
						mes "恢复了 10 点 HP！";
					}
					else if (.@p_atk == 1) {
						specialeffect EF_HIT5;
						set .@n_vit,.@n_vit - .@damage;
						mes "--------------------";
						mes "你成功击中 Sudri 的头部！";
						mes "--------------------";
						mes "Sudri 失去 " + .@damage + " 点 HP！";
					}
					else if (.@p_atk == 2) {
						specialeffect EF_HIT2;
						set .@n_vit,.@n_vit - .@damage;
						mes "--------------------";
						mes "你成功击中 Sudri 的胸口！";
						mes "--------------------";
						mes "Sudri 失去 " + .@damage + " 点 HP！";
					}
					else if (.@p_atk == 3) {
						specialeffect EF_HIT4;
						set .@n_vit,.@n_vit - .@damage;
						mes "--------------------";
						mes "你成功击中 Sudri 的腿！";
						mes "--------------------";
						mes "Sudri 失去 " + .@damage + " 点 HP！";
					}
					else if (.@p_atk == 0) {
						specialeffect2 EF_HIT5;
						set .@p_vit,.@p_vit - 10;
						mes "--------------------";
						mes "你被 Sudri 的反击击中！";
						mes "--------------------";
						mes "" + strcharinfo(0) + " 失去 10 点 HP！";
						if (.@p_vit < 1) {
						mes "被击败了……";
							next;
							break;
						}
					}
					else {
						mes "--------------------";
						mes "发生了意外，战斗停止！";
						close;
					}
					if (.@n_vit < 1) {
						mes "" + strcharinfo(0) + " 获胜！";
						next;
						break;
					}
					next;
					mes "Sudri : " + .@n_vit + " HP";
					mes "" + strcharinfo(0) + " : " + .@p_vit + " HP";
					mes "--------------------";
					mes "Sudri 攻击……！";
					next;
					switch(select("……？！:闪避！:格挡！:跳跃！:反击！")) {
					case 1:
						set .@p_def,0;
						break;
					case 2:
						set .@p_def,1;
						break;
					case 3:
						set .@p_def,2;
						break;
					case 4:
						set .@p_def,3;
						break;
					case 5:
						set .@p_def,4;
						break;
					}
					set .@n_atk,rand(1,3);
					set .@damage,rand(20,25);
					if (.@n_atk == 1) {
						mes "Sudri 瞄准头部！";
					}
					else if (.@n_atk == 2) {
						mes "Sudri 攻击胸口！";
					}
					else {
						mes "Sudri 攻击腿部！";
					}
					if (.@n_atk == .@p_def) {
						specialeffect2 EF_GUARD;
						if (.@p_def == 1) {
							mes "--------------------";
							mes "" + strcharinfo(0) + " 迅速闪避，";
							mes "Sudri 的手臂太短，够不到你。";
							mes "--------------------";
							mes "Sudri 攻击失败。";
						}
						else if (.@p_def == 2) {
							mes "--------------------";
							mes "" + strcharinfo(0) + "";
							mes "勉强挡住了 Sudri 的攻击。";
							mes "--------------------";
							mes "Sudri 攻击失败。";
						}
						else if (.@p_def == 3) {
							mes "--------------------";
							mes "" + strcharinfo(0) + " 跳起来，";
							mes "轻松躲开 Sudri 的攻击。";
							mes "--------------------";
							mes "Sudri 攻击失败。";
						}
					}
					else if (.@p_def == 4) {
						set .@count,rand(1,4);
						mes "--------------------";
						mes "" + strcharinfo(0) + "";
						mes "反击！";
						if (.@count == 1) {
							specialeffect2 EF_AUTOCOUNTER;
							specialeffect EF_MAGNUMBREAK;
							set .@n_vit,.@n_vit - 20;
							mes "你成功进行了反击！";
							mes "";
							mes "--------------------";
							mes "Sudri 失去 20 点 HP！";
							if (.@n_vit < 1) {
								mes "" + strcharinfo(0) + " 获胜！";
								next;
								break;
							}
						}
						else {
							specialeffect2 EF_CRASHEARTH;
							set .@p_vit,.@p_vit - 30;
							mes "你的弱点受到致命伤害！";
							mes "";
							mes "";
							mes "--------------------";
							mes "" + strcharinfo(0) + " 失去 30 点 HP！";
						}
					}
					else if (.@n_atk == 1) {
						specialeffect2 EF_HIT5;
						set .@p_vit,.@p_vit - .@damage;
						mes "--------------------";
						mes "Sudri 成功击中 " + strcharinfo(0) + " 的头部！";
						mes "";
						mes "";
						mes "--------------------";
						mes "" + strcharinfo(0) + " 失去 " + .@damage + " 点 HP！";
					}
					else if (.@n_atk == 2) {
						specialeffect2 EF_HIT2;
						set .@p_vit,.@p_vit - .@damage;
						mes "--------------------";
						mes "Sudri 成功击中 " + strcharinfo(0) + " 的胸口！";
						mes "";
						mes "";
						mes "--------------------";
						mes "" + strcharinfo(0) + " has lost " + .@damage + " HP!";
					}
					else if (.@n_atk == 3) {
						specialeffect2 EF_HIT4;
						set .@p_vit,.@p_vit - .@damage;
						mes "--------------------";
						mes "Sudri 成功击中 " + strcharinfo(0) + " 的腿部！";
						mes "";
						mes "";
						mes "--------------------";
						mes "" + strcharinfo(0) + " has lost " + .@damage + " HP!";
					}
					else if (.@n_atk == 0) {
						specialeffect2 EF_HIT5;
						set .@p_vit,.@p_vit - .@damage;
						mes "--------------------";
						mes "Sudri 趁 " + strcharinfo(0) + " 走神时成功击中！";
						mes "";
						mes "";
						mes "--------------------";
						mes "" + strcharinfo(0) + " has lost " + .@damage + " HP!";
					}
					else {
						mes "--------------------";
						mes "发生了意外，战斗停止！";
						mes "";
						close;
					}
					if (.@p_vit < 1) {
						mes "Sudri 获胜！";
						next;
						break;
					}
					next;
				}
				if (.@p_vit < .@n_vit) {
					mes "[Sudri]";
				mes "呜哈哈哈哈！";
				mes "你还不够强，无法打败我！我想要能给我挑战的人！";
				mes "";
					next;
					mes "[Sudri]";
				mes "出去训练变强，想好之后再回来！";
					close;
				}
				else if (.@n_vit < .@p_vit) {
					set god_mjo_3,2;
					mes "[Sudri]";
				mes "你比我强。我没想过会遇到像你这么强的人类。";
					next;
					mes "[Sudri]";
				mes "我很佩服！好吧，我会向朋友称赞你。希望我的兄弟能给你需要的帮助。";
					next;
					mes "[Sudri]";
				mes "好吧，旅途平安！";
				mes "";
				mes "";
					close;
				}
			}
			else if (god_mjo_3 == 0) {
				mes "[Sudri]";
				mes "是什么让你来找我？";
				next;
				switch(select("没什么。:打扰了，先生。")) {
				case 1:
					mes "[Sudri]";
				mes "你时间太多了。";
				mes "为什么不下线和朋友出去玩？";
					close2;
				case 2:
					mes "[Sudri]";
				mes "嗯，你和其他人类不同。不过，仅因为你说话有礼貌就信任你，也不明智。";
					next;
					mes "[Sudri]";
				mes "如果说我喜欢什么，";
				mes "那就是老派的徒手格斗。";
				mes "";
					next;
					mes "[Sudri]";
				mes "言语可能骗人，但如果你能在战斗中击败我，";
				mes "我也许就会和你谈谈。怎么样？";
				mes "";
				mes "";
					next;
					switch(select("……:好，我接受你的挑战。:不，我害怕！")) {
					case 1:
						set god_mjo_3,3;
						mes "[Sudri]";
						mes "你甚至没回答我！好吧！随便！";
						close;
					case 2:
						set god_mjo_3,1;
						mes "[Sudri]";
						mes "啊，我已经喜欢你了，人类！先去热身，准备好后我们战斗。";
						close;
					case 3:
						set god_mjo_3,1;
						mes "[Sudri]";
						mes "呃……？你为什么这么胆小？你害怕吗？";
			mes "这个又老又矮的矮人？";
						next;
						mes "[Sudri]";
			mes "来吧，我甚至让你先出手。准备战斗时就来找我！";
						close;
					}
				}
			}
			else {
				mes "[Sudri]";
		mes "呼呼……";
				close;
			}
		}
		else if (god_mjo_0 == 0) {
			mes "[Sudri]";
		mes "一对一战斗时，你会赌上一切向对手展示实力。";
			next;
			mes "[Sudri]";
		mes "你曾有过和我一样的感受吗，人类？无论输赢，全力以赴就是最令人满足的成就。";
			close;
		}
		else {
			mes "[Sudri]";
			mes "呼呼……";
			close;
		}
	}
}

mjolnir_01,35,136,7	script	Dwarf Blacksmith#west	826,{
	if ($God3 < $@god_check1) {
		mes "[Vestri]";
		mes "想要什么，就应该靠自己的努力获得。";
		next;
		mes "[Vestri]";
		mes "无论别人怎么说，只要你有自信、意志坚定，就会对结果满意。";
		next;
		mes "[Vestri]";
		mes "你觉得呢？现在的孩子啊……";
		close;
	}
	else {
		if ($God4 >= $@god_check2) {
			mes "[Vestri]";
		mes "我今天什么都不想做，什么都不想……";
			next;
			mes "[Vestri]";
		mes "一定有人锻造了什么可怕东西，否则我不会如此无用！";
			next;
			mes "[Vestri]";
		mes "是的，我想休息一下！你不觉得我需要休息吗，人类？";
			close;
		}
		else if (god_mjo_0 == 11) {
			mes "[Vestri]";
		mes "全心投入工作后，没有什么比放松休息更好了。";
			next;
			mes "[Vestri]";
		mes "你觉得呢，人类？这不是生活中简单的乐趣吗？";
			close;
		}
		else if (god_mjo_0 == 10) {
			mes "[Vestri]";
		mes "想要什么，就应该靠自己的努力获得。";
			next;
			mes "[Vestri]";
		mes "无论别人怎么说，只要你有自信、意志坚定，就会对结果满意。";
			next;
			mes "[Vestri]";
		mes "你觉得呢？现在的孩子啊……";
			close;
		}
		else if (god_mjo_0 == 1) {
			if (god_mjo_1 == 3 || god_mjo_2 == 3 || god_mjo_3 == 3 || god_mjo_4 == 3) {
				mes "[Vestri]";
				mes "真希望下次遇到一个像样的人类。到目前为止，我还没遇到有用的人类。";
				close;
			}
			else if (god_mjo_3 == 2) {
				mes "[Vestri]";
				mes "完美准备不一定带来成功。有时你必须直接行动。";
				next;
				mes "[Vestri]";
				mes "我不知道你的目标有多大，但无论人生想完成什么，都要全心投入。";
				close;
			}
			else if (god_mjo_1 == 0 || god_mjo_1 == 1 || god_mjo_2 == 0 || god_mjo_2 == 1 || god_mjo_4 != 0) {
				mes "[Vestri]";
				mes "你想要什么？";
				next;
				switch(select("没什么。:打扰一下。")) {
				case 1:
					mes "[Vestri]";
				mes "如果你想要什么，就应该通过自己的努力获得。";
					next;
					mes "[Vestri]";
				mes "不管别人怎么说，只要你有信心、意志坚定，就会对结果满意。";
					close;
				case 2:
					set god_mjo_3,3;
					mes "[Vestri]";
				mes "你没有回答问题！看来你找错矮人了……";
					next;
					mes "[Vestri]";
				mes "离开这里！想升级装备就去找你们人类铁匠！";
					close;
				}
			}
			else if (god_mjo_3 == 1) {
				disable_items;
				mes "[Vestri]";
				mes "太好了……！先升级哪个？我的心激动得怦怦直跳……";
				next;

				setarray .@indices[1], EQI_HEAD_TOP, EQI_ARMOR, EQI_HAND_L, EQI_HAND_R, EQI_GARMENT, EQI_SHOES, EQI_ACC_L, EQI_ACC_R, EQI_HEAD_MID, EQI_HEAD_LOW;
				for(set .@i,1; .@i <= 10; set .@i,.@i+1) {
					if (getequipisequiped(.@indices[.@i]))
						set .@menu$, .@menu$ + F_getpositionname(.@indices[.@i]) + "-[" + getequipname(.@indices[.@i]) + "]";
					set .@menu$, .@menu$ + ":";
				}
				set .@part, .@indices[ select(.@menu$) ];

				if (getequipisequiped(.@part) == 0)
					close;

				if (getequipisenableref(.@part) == 0) {
					mes "[Vestri]";
					mes "什么……？！这个不能升级！你到底想让我怎么办？";
					close;
				}
				.@equip_id = getequipid(.@part);
				.@itemtype = getiteminfo( .@equip_id, ITEMINFO_TYPE );
				.@equip_refine = getequiprefinerycnt(.@part);
				setarray .@card[0], getequipcardid(.@part,0), getequipcardid(.@part,1), getequipcardid(.@part,2), getequipcardid(.@part,3);
				if (.@equip_refine >= 10) {
					mes "[Vestri]";
					mes "哦，这件很棒！它已经精炼得很完美！但这不是我想要的，我完全无法加工。";
					close;
				}
				if (GetEquipPercentRefinery(.@part) == 100) {
					mes "[Vestri]";
					mes "升级这件物品毫无挑战。这种入门工作找人类做吧，先让他们精炼。";
					next;
					mes "[Vestri]";
					mes "来吧……";
					mes "带来能带来风险的东西！";
					mes "";
					mes "";
					close;
				}
				if( .@itemtype != IT_WEAPON ){
					mes "[Vestri]";
					mes "盔甲？！";
					mes "我不是说过我只加工 4 级武器吗？";
					mes "";
					mes "";
					next;
					mes "[Vestri]";
					mes "这种东西可以交给人类铁匠！";
					mes "像我这样的矮人需要更有挑战性的工作！";
					close;
				}
				if( getequipweaponlv( .@part ) != 4 ){
					mes "[Vestri]";

// Amatsu Transportation
//============================================================
-	script	::Sea_Captain_amatsu	-1,{
	mes "[沃尔特·莫尔斯]";
	mes "嗨，你好。";
	mes "你听说过吗？除了卢恩·米德加尔兹王国，";
	mes "还有完全不同的国家。";
	next;
	switch(select("关于天津町……:前往天津町:取消")) {
	case 1:
		mes "[沃尔特·莫尔斯]";
		mes "听说有艘漂泊的船";
		mes "意外发现了那里……";
		mes "船在浓雾中的狂风暴雨里";
		mes "被彻底摧毁了。";
		mes " ";
		next;
		mes "[沃尔特·莫尔斯]";
		mes "总之，船在海滩搁浅了。";
		mes "他在那里";
		mes "抵达了名为天津町的城镇。";
		next;
		mes "[沃尔特·莫尔斯]";
		mes "镇民同情他，";
		mes "照料他的伤口。";
		mes "他住在那里，直到绘制完地图。";
		next;
		mes "[沃尔特·莫尔斯]";
		mes "他返回卢恩·米德加尔兹时去世了。";
		mes "幸运的是，";
		mes "地图被交给了我们的国王特里斯坦三世。";
		next;
		mes "[沃尔特·莫尔斯]";
		mes "特里斯坦三世国王宣布，";
		mes "任何有勇气前往天津町的人";
		mes "都能获得奖励，并将这张地图的副本传播开来。";
		next;
		mes "[沃尔特·莫尔斯]";
		mes "许多勇敢而富有冒险精神的船长";
		mes "接受了挑战。";
		mes "与天津町贸易可以赚取巨额财富，";
		mes "还能得到特里斯坦三世国王的奖励……";
		next;
		mes "[沃尔特·莫尔斯]";
		mes "然而，他们全都失败了！";
		mes "要克服各种洋流和恶劣天气，";
		mes "需要丰富的经验。";
		mes "但他们都被贪欲蒙蔽了双眼……";
		next;
		mes "[沃尔特·莫尔斯]";
		mes "最后，一位伟大的人发现了";
		mes "通往天津町的完美航线……";
		mes "没错！那个人就是我，沃尔特·";
		mes "莫尔斯爵士。我开创了与天津町的贸易！哈哈哈！关于天津町就是这些。";
		next;
		mes "[沃尔特·莫尔斯]";
		mes "多年来我靠贸易赚了不少钱，";
		mes "现在我对旅游产生了兴趣。";
		mes "想去天津町的话，告诉我一声~！";
		close;
	case 2:
		mes "[沃尔特·莫尔斯]";
		mes "是吗？去天津町路途遥远，";
		mes "所以我们要收取费用。";
		mes "你不会以为穿越海洋和洋流很容易吧？";
		next;
		mes "[沃尔特·莫尔斯]";
		mes "往返票 10,000 Zeny！我会为你准备坚固安全的贸易船上的";
		mes "豪华房间。考虑到这不是单程旅行，";
		mes "这个价格很合理。";
		next;
		mes "[沃尔特·莫尔斯]";
		mes "现在出发吗？你没忘记票价吧？走吧。";
		next;
		if (select("全员上船！:取消") == 1) {
			if (Zeny > 9999) {
				mes "[沃尔特·莫尔斯]";
				mes "好，我要发动引擎了！";
				close2;
				set Zeny, Zeny-10000;
				warp "amatsu",197,83;
				end;
			}
			mes "[沃尔特·莫尔斯]";
			mes "你到底有没有在听我说？";
			mes "10,000 Zeny。如果你没有钱，";
			mes "就去沉船之类的地方找些宝藏……把钱拿出来！";
			close;
		}
		mes "[沃尔特·莫尔斯]";
		mes "如果你是冒险者，";
		mes "这是体验不同文化的好机会……";
		mes "当然，由你决定。";
		close;
	case 3:
		mes "[沃尔特·莫尔斯]";
		mes "如果你厌倦了日常生活，";
		mes "就去海洋彼岸的遥远国度旅行吧。";
		mes "比如……天津町~";
		close;
	}
}

amatsu,194,79,5	script	Sea Captain#ama2	709,{
	mes "[沃尔特·莫尔斯]";
	mes "你回来了……天津町之旅";
	mes "还愉快吗？";
	mes "好，我送你回艾尔贝塔。";
	next;
	if (select("返回艾尔贝塔:取消") == 1) {
		mes "[沃尔特·莫尔斯]";
		mes "那就出发吧。你一定有很多话要说，";
		mes "对吧？现在上船。";
		close2;
		if (checkre(0))
			warp "alberta",245,87;
		else
			warp "alberta",243,91;
		end;
	}
	mes "[沃尔特·莫尔斯]";
	mes "慢慢来。";
	mes "前往艾尔贝塔的船随时可以出发……";
	close;
}

// Generic Amatsu NPCs
//============================================================
amatsu,230,160,3	script	Well-side Maiden#ama	757,{
	mes "[Yuuko]";
	mes "我通常来这口井打水，";
	mes "但起雾或下雨时从不来。";
	mes "不知为什么，每当天气变成某种样子，";
	mes "我就觉得……";
	next;
	mes "[Yuuko]";
	mes "...someone...or some thing is";
	mes "仿佛有什么东西在努力从井底爬出来……";
	mes "真让人毛骨悚然。";
	close;
}

amatsu,179,107,4	script	John#ama	86,{
	mes "[John]";
	mes "哟~";
	mes "你不是本地人。";
	mes "嘿，又一个外乡人。";
	mes "和我一样……";
	next;
	mes "[约翰]";
	mes "我来这里做生意";
	mes "已经整整五年了……";
	mes "";
	next;
	mes "[约翰]";
	mes "一开始，卢恩·米德加尔兹王国和天津町开始贸易时，";
	mes "我想：‘真是个好机会！’";
	mes "";
	mes "";
	next;
	mes "[约翰]";
	mes "我想做点大事，充分利用这个新机会。";
	mes "";
	mes "";
	next;
	mes "[约翰]";
	mes "于是我决定前往天津町，学习制作天津町料理。";
	mes "然后回到家乡，为大家制作这种异国美食。";
	mes "";
	mes "";
	mes "";
	next;
	mes "[约翰]";
	mes "但是我爱上了天津町，结果在这里一住就是五年。";
	mes "这段时间里，我一直学习天津町料理。";
	mes "";
	mes "";
	mes "";
	next;
	mes "[约翰]";
	mes "我为镇民烹饪这些菜肴，和当地人聊天，";
	mes "在这里度过快乐时光。";
	mes "";
	mes "";
	next;
	mes "[约翰]";
	mes "但最近，街对面的寿司大师开了店。";
	mes "";
	mes "...";
	mes "现在我的顾客只剩苍蝇了。";
	next;
	mes "[约翰]";
	mes "我本想实现成为天津町名厨的梦想，";
	mes "但……看来一切都结束了……";
	mes "";
	mes "";
	close;
}

amatsu,205,163,3	script	Mimi#ama	759,{
	mes "[米米]";
	mes "噗呼呼~！";
	mes "你看到港口附近的天津町小姐了吗？";
	mes "她是不是特别漂亮？";
	next;
	mes "[米米]";
	mes "我长大后要参加";
	mes "天津町小姐选美比赛。";
	next;
	mes "[米米]";
	mes "我肯定是镇上最漂亮的，";
	mes "不过……女士总是可以多化一点妆。";
	close;
}

amatsu,185,115,3	script	Drunken Man#ama	765,{
	mes "[小酒]";
	mes "*嗝*……我老婆简直就像个，";
	mes "……像个男人……*嗝*……";
	mes "这次我真的……*嗝*……不回家了……嗝";
	next;
	if (select("别喝了，回家吧:一起喝酒") == 1) {
		mes "[小酒]";
		mes "什么？！你想让我被老婆的拳头打吗？";
		mes "没错！我说的是‘大拳头’！";
		next;
		mes "[小酒]";
		mes "说来惭愧，我娶了一个";
		mes "长着男人般双手的女人……";
		mes "那双手又大又强壮，能打死老虎。";
		next;
		mes "[醉汉]";
		mes "是在科……科科什么镇。";
		mes "我因为丢了点钱被她打了……*嗝*";
		next;
		mes "[醉汉]";
		mes "人生~~什么都不是~~~";
		mes "Zeny 是什么~~~~";
		mes "*Hiccup*...... *Hiccup*.......";
		mes ".......................";
		mes "........Z.z..z...zzz...";
		close;
	}
	mes "[小酒]";
	mes "嘿嘿……好小伙……";
	mes "不过你知道吗 *嗝*";
	mes "我可不能把我的酒给你！嘿嘿嘿……";
	next;
	mes "[小酒]";
	mes "如果你请我喝一杯，我可以考虑一下……嘿嘿……*嗝*……";
	close;
}

amatsu,217,179,1	script	Grandma#ama	760,{
	mes "[初江]";
	mes "我很担心我的丈夫。";
	mes "他今天在某个遥远的城镇输了很多钱。";
	next;
	mes "[初江]";
	mes "我气得骂了他几句，他竟然害怕地跑掉了！";
	mes "我真担心……要是他又去酒吧喝酒怎么办？";
	mes "这个男人真没骨气。*呼*";
	close;
}

amatsu,287,266,3	script	Jyaburo#ama	766,{
	mes "[吉亚布罗]";
	mes "这个地方对我意义特殊。";
	mes "这里充满了我和妻子的回忆。";
	next;
	mes "[吉亚布罗]";
	mes "我就是在那棵大树下第一次向她表白的。";
	mes "当时我并不知道她也对我有感情。";
	mes "";
	next;
	mes "[吉亚布罗]";
	mes "那天之后，我们经常在这里聊天。";
	mes "这里安静祥和，是我们最喜欢一起待着的地方。";
	mes "";
	mes "";
	next;
	mes "[吉亚布罗]";
	mes "在这里闭上眼睛，我就能想起我们的美好时光，";
	mes "仿佛一切都发生在昨天。";
	mes "";
	mes "...";
	next;
	mes "[吉亚布罗]";
	mes "我的妻子去世了……";
	mes "所以现在我只能独自来这里……";
	mes "但每当来到这里，我都觉得她陪在身边。";
	next;
	mes "[吉亚布罗]";
	mes "你有牵挂的人吗？如果有特别的人，";
	mes "不要犹豫，也不要退缩。一定要好好珍惜那个人。";
	mes "";
	mes "";
	mes "";
	next;
	mes "[吉亚布罗]";
	mes "人的一生很短。";
	mes "但我们可以用笑容度过一生，忘记悲伤。";
	mes "……一定要幸福。";
	mes "";
	close;
}

// Legendary Tree
//============================================================
amatsu,269,221,1	script	Propose Girl#ama	758,{
	set jap_tree,1;
	mes "[胡太郎诗织]";
	mes "很高兴见到你。";
	mes "我叫胡太郎诗织。";
	mes "我的爱好是听音乐。";
	mes "我是古典音乐的忠实爱好者。";
	next;
	mes "[胡太郎诗织]";
	mes "关于镇上的那座山丘，";
	mes "有一个古老的传说。";
	mes "你听说过吗？";
	next;
	mes "[胡太郎诗织]";
	mes "据说如果在那棵树下求婚，";
	mes "你和恋人就能永远幸福地生活。";
	mes "";
	next;
	mes "[胡太郎诗织]";
	mes "不过求婚不能随时进行。";
	mes "传说只有星期六晚上才能求婚。";
	next;
	mes "[胡太郎诗织]";
	mes "求婚后，必须在星期日晚上之前得到答复。";
	mes "这是最关键的一点。";
	next;
	emotion ET_BIGTHROB;
	mes "[胡太郎诗织]";
	mes "如果你喜欢某个人……";
	mes "应该试着在那棵树下求婚。";
	mes "我相信那样一定会有幸福的事情发生。";
	mes "";
	close;
}

amatsu,243,202,3	script	Drama Teacher#ama	760,{
	set jap_tree,2;
	mes "[加拉卡梅老师]";
	mes "这是一个美丽的地方，";
	mes "樱花四季盛开。";
	mes "而且，这个城镇还是传奇戏剧《白色树妖》的发源地。";
	mes "";
	next;
	if (Sex == SEX_MALE) {
		mes "[加拉卡梅老师]";
		mes "如果你认识擅长表演的女孩，";
		mes "请把她带来。我一直在寻找";
		mes "能出演‘白色树妖’的女孩。";
		mes "";
		mes "";
		next;
		mes "[加拉卡梅老师]";
		mes "‘白色树妖’是樱树的仙女……";
		mes "很难找到能出演‘白色树妖’的女孩……";
		mes "";
		mes "";
		close;
	}
	emotion ET_SURPRISE;
	mes "[加拉卡梅老师]";
	mes "你对表演感兴趣吗？";
	mes "我需要一个热爱表演、";
	mes "并能理解我愿景的人。";
	mes "";
	next;
	mes "[加拉卡梅老师]";
	mes "站在舞台上时，你必须成为角色。";
	mes "你的表演要触动观众的心灵。";
	mes "";
	mes "";
	mes "";
	next;
	mes "[加拉卡梅老师]";
	mes "每个人的人生都像一出戏，对吧？";
	mes "做真实的自己，享受人生。准备好后再来找我。";
	mes "";
	mes "";
	close;
}

amatsu,283,203,1	script	Bonubonu#ama1	1323,{
	end;
}

amatsu,283,203,1	script	Bonubonu#ama2	111,{
	set jap_tree,3;
	emotion ET_PROFUSELY_SWEAT;
	mes "[波努波努]";
	mes "山丘上的那棵树非常古老。";
	mes "那是一棵永远盛开的巨大樱树。";
	mes "";
	next;
	emotion ET_PROFUSELY_SWEAT;
	mes "[波努波努]";
	mes "坐在树下时，不知为何我会忘记生活中的所有烦恼。";
	mes "";
	mes "";
	next;
	emotion ET_PROFUSELY_SWEAT;
	mes "[波努波努]";
	mes "这棵树的一切都美妙无比……";
	mes "我无法描述看着它时的感受……";
	mes "它让我屏息……";
	mes "";
	mes "";
	next;
	emotion ET_PROFUSELY_SWEAT;
	mes "[波努波努]";
	mes "你应该去看看那棵树，在那里待一会儿。";
	mes "那真是一棵神奇而优雅的树……";
	mes "";
	close;
}

amatsu,274,178,7	script	Veterinarian#ama	735,{
	set jap_tree,4;
	mes "[樱井诚一]";
	mes "啊……我不是怪人，别紧张。";
	mes "我只是普通的兽医，工作是治疗生病的动物。";
	mes "";
	mes "";
	mes " ";
	next;
	mes "[樱井诚一]";
	mes "顺便问问……你知道吗？";
	mes "关于山丘上那棵樱树的故事……";
	mes "我猜你还没听说过……";
	next;
	mes "[樱井诚一]";
	mes "那棵树保持美丽与洁白的秘密是……";
	mes "树下埋着尸体……";
	mes "就在那棵树下……";
	mes "";
	mes "";
	next;
	if (select("太可怕了！:你一定是在开玩笑。") == 1) {
		mes "[樱井诚一]";
		mes "咕呼呼……也许吧……";
		mes "顺便问问，你想打个赌吗……？";
		next;
		emotion ET_THINK;
		mes "[Sakura Seiichi]";
		mes "如果我……";
		mes "............";
		mes ".........";
		next;
		mes "^3355FFHis voice was getting lower";
		mes "声音随着风越来越低。";
		mes "最后，我甚至听不见他的声音，也想不起他到底想告诉我什么……^000000";
		close;
	}
	mes "[Sakura Seiichi]";
	mes "你要那样想我也没办法。不过有一天，你也可能被埋在下面……";
	next;
	emotion ET_THINK;
	mes "[Sakura Seiichi]";
	mes "哈哈……哈哈哈……";

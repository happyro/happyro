}

gef_tower,116,37,0	script	Enoz#hellion	748,{
	if (HELLIONQ == 59 || HELLIONQ == 62) {
		mes "[伊诺兹]";
		mes "它不见了，不见了！";
		mes "到底跑到哪里去了？！";
		mes "天啊，谁会";
		mes "拿走它？等等，是你吗？！";
		next;
		if (select("其实是威尔什云派我来的。:不可能，别发疯。") == 1) {
			mes "[伊诺兹]";
			mes "我的导师威尔什云？";
			mes "嗯。有一份报告";
			mes "我还没交给他";
			mes "吗？它叫什么？";
			next;
			input .@input$;
			if (.@input$ == "Monster Life in the Geffen Area") {
				mes "[伊诺兹]";
				mes "“怪物生活在";
				mes "吉芬地区？”";
				mes "哦不。我的导师三天前";
				mes "拿走了它！";
				mes "他还在做";
				mes "那些老把戏吗？";
				next;
				mes "[伊诺兹]";
				mes "哎呀，该死！";
				mes "我的《大师科学";
				mes "参考书";
				mes "到底在哪里？";
				mes "三天前它还在这里";
				mes "……";
				set HELLIONQ,63;
				close;
			}
			mes "[伊诺兹]";
			mes "" + .@input$ + "?";
			mes "我没有完成";
			mes "与那个主题有关的";
			mes "研究。还是完成了？";
			mes "总之，我需要你要找的报告";
			mes "确切名称！";
			close;
		}
		mes "[伊诺兹]";
		mes "发疯？！哦，你想";
		mes "看疯子，是吗？！你想";
		mes "看疯子吗？！";
		mes "你再烦我，我就让你见识";
		mes "中世纪的恐怖！！";
		close;
	}
	else if (HELLIONQ == 63) {
		mes "[伊诺兹]";
		mes "我的导师威尔什云";
		mes "又在开玩笑，";
		mes "你最好去找他。";
		mes "该死。《大师科学";
		mes "参考书》在哪里？";
		close;
	}
	else if (HELLIONQ == 64) {
		mes "[伊诺兹]";
		mes "哦，我记得你~";
		mes "我导师又因为某种原因";
		mes "把你派来找我吗？";
		next;
		mes "^3355FF你小心地把《大师科学";
		mes "参考书》交给伊诺兹。^000000";
		next;
		mes "[伊诺兹]";
		mes "是的！没错！";
		mes "这就是我";
		mes "三天前";
		mes "丢失的书！太感谢了！";
		mes "现在我终于可以完成";
		mes "这个研究项目了——";
		next;
		mes "[伊诺兹]";
		mes "等等，我真正需要的页面";
		mes "不见了！还有一张";
		mes "便条……嗯……";
		mes "^333333“伊诺兹，我觉得这一页";
		mes "至少值一瓶苹果";
		mes "汁。对吧？——威尔什云。”^000000";
		next;
		mes "[伊诺兹]";
		mes "不不不不！";
		mes "又来了！";
		mes "他为什么总是";
		mes "开这种玩笑？！";
		mes "苹果汁！我需要";
		mes "一些苹果汁！";
		set HELLIONQ,65;
		next;
		mes "^3355FF看来现在该去拿";
		mes "1颗蓝色宝石，";
		mes "然后带回去";
		mes "交给贤者威尔什云。^000000";
		close;
	}
	mes "[伊诺兹]";
	mes "没了！不见了！";
	mes "我需要的书";
	mes "到底去哪了？";
	mes "哦不哦不哦不哦不！";
	mes "哇啊啊啊，我要哭了！";
	close;
}

gef_fild09,296,59,0	script	Hidden Cave#hellion	111,3,3,{
	if (HELLIONQ == 68) {
		mes "^3355FF在野生灌木";
		mes "和杂草丛中，你";
		mes "看到一块巨大的石板，";
		mes "看起来像一扇门。靠近后，";
		mes "你可以看到石头表面有一道";
		mes "凹槽。^000000";
		next;
		if (select("插入石板。:忽略。") == 1) {
			mes "^3355FF你把石板插入";
			mes "石头的凹槽，";
			mes "地狱之眼宝石开始嗡鸣";
			mes "并发光。石头滑开，";
			mes "露出刻在地面上的消息";
			mes "供你阅读。^000000";
			next;
			mes "^4D4DFF“找到这里的你，";
			mes "我将揭示关于";
			mes "地狱之眼亡灵的真相。它";
			mes "从来不是我们以为的恶魔，而是一个逐渐";
			mes "被黑暗";
			mes "腐化的人类。^000000”";
			next;
			mes "^4D4DFF“我太晚才知道这个";
			mes "可怕的真相。现在，";
			mes "我能感到黑暗";
			mes "正在我体内涌动。";
			mes "我只能把自己困在";
			mes "这个房间里，";
			mes "以免彻底失去理智。”^000000";
			next;
			mes "^4D4DFF“我失败了，对我来说已经太晚，";
			mes "但我希望";
			mes "未来有人";
			mes "能封印地狱之眼宝石的";
			mes "黑暗力量。我还希望";
			mes "有人能给予我";
			mes "渴望的甜蜜解脱……”^000000";
			next;
			mes "^4D4DFF“勇敢的英雄，我求你";
			mes "杀了我，";
			mes "拯救我的灵魂。";
			mes "请解放我，让我";
			mes "终于能与朋友们团聚。";
			mes "^FFFFFF_^000000";
			mes "^FFFFFF哦哦哦哦哦^4D4DFF——泰乌斯”^000000";
			close2;
			warp "gef_dun03",140,119;
			end;
		}
		mes "^3355FF你什么也没做。";
		mes "什么也没发生。^000000";
		close;
	}

OnTouch_:
	if (HELLIONQ == 68 && countitem(7332) > 0) {
		specialeffect2 EF_HEAL2;
		specialeffect EF_HEAL2;
		mes "^3355FF你手中的石板";
		mes "开始闪耀光芒，";
		mes "回应";
		mes "附近的某种事物。^000000";
		close;
	}
	end;
}


		emotion ET_HUK, getnpcid(0, "Tarsha Cherno");
		mes "[Tarsha Cherno]";
		mes "天啊……！";
		mes "她到底在想什么？";
		mes "很抱歉因为这种小错误";
		mes "给你添麻烦了，";
		mes "冒险者！";
		next;
		mes "[Theo Cherno]";
		mes "但是等等，亲爱的。";
		mes "我承认，有时候你望着窗外，";
		mes "那双眼睛忧郁得难以置信，";
		mes "看起来像是世界上";
		mes "最孤独的人。";
		next;
		mes "[Tarsha Cherno]";
		mes "哦，我一定让家人";
		mes "非常担心了。";
		mes "不过别担心，亲爱的。";
		mes "和你还有艾尔在一起，";
		mes "我非常幸福。";
		next;
		mes "[Tarsha Cherno]";
		mes "还有……";
		mes "善良的冒险者，";
		mes "可以告诉我你的名字吗？";
		next;
		mes "["+ strcharinfo(0) +"]";
		mes "我叫";
		mes ""+ strcharinfo(0) +"。";
		emotion ET_SMILE;
		next;
		mes "[Tarsha Cherno]";
		mes ""+ strcharinfo(0) +"，";
		mes "谢谢你的关心。";
		mes "留下来喝杯茶，";
		mes "好吗？";
		next;
		mes "[Tarsha Cherno]";
		mes "请原谅这里有些杂乱。";
		mes "我和丈夫都是机械工程师，";
		mes "专注于制造能够降低";
		mes "矿石开采风险的机器。";
		next;
		mes "[Tarsha Cherno]";
		mes "因为我们在家工作，";
		mes "有时难免把机器零件";
		mes "随处放置。不管怎样，";
		mes "我们希望制造出能让矿工";
		mes "生活更安全的机器……";
		next;
		mes "["+ strcharinfo(0) +"]";
		mes "啊……";
		mes "原来如此，";
		mes "难怪你家里有这么多";
		mes "有趣的东西……";
		next;
		mes "^3355FF你开始四处观察";
		mes "切尔诺家的内部。^000000";
		return;
	}
}

//----------------------------------------------------------------------------
// Unidentified Machine
//----------------------------------------------------------------------------
ein_in01,122,103,5	script	Unidentified Machine#ein	HIDDEN_NPC,{
	mes "^3355FF这是……";
	mes "一台外形非常奇怪的";
	mes "机器。它到底";
	mes "有什么用呢？^000000";
	close;
}

//----------------------------------------------------------------------------
// Mirror
//----------------------------------------------------------------------------
ein_in01,121,99,3	script	Mirror#ein	HIDDEN_NPC,{
	if (kain_ticket == 8) {
		mes "^3355FF这是一面镜子。";
		mes "所以，你首先看到的";
		mes "当然是自己。";
		next;
		.@r = rand(1,5);
		if (.@r == 5) {
			mes "["+strcharinfo(0)+"]";
			mes "哦，哇……";
			mes "我看起来真不错。";
			mes "不，等等，是真的非常好。";
			mes "难怪我在餐厅总能";
			mes "得到这么好的服务……";
		} else if (Sex == SEX_MALE) {
			switch(.@r) {
			case 1:
				mes "["+strcharinfo(0)+"]";
				mes "天啊……";
				mes "我不知道自己";
				mes "看起来这么帅！";
				mes "哦耶~";
				break;
			case 2:
				mes "["+strcharinfo(0)+"]";
				mes "哇……";
				mes "难怪女士们总是";
				mes "盯着我看。";
				mes "我简直就是移动的";
				mes "免费健身展示！";
				break;
			case 3:
				mes "["+strcharinfo(0)+"]";
				mes "真遗憾我不能转职";
				mes "成为男模。";
				mes "我肯定能达到";
				mes "87级之类的。";
				mes "天啊，我真美……";
				break;
			case 4:
				mes "["+strcharinfo(0)+"]";
				mes "这是我的倒影？！";
				mes "没人能长得这么好看，";
				mes "除非用了特殊效果！";
				mes "这对其他人来说不公平……";
				break;
			}
		} else {
			switch(.@r) {
			case 1:
				mes "["+strcharinfo(0)+"]";
				mes "哦，哇。";
				mes "我从没意识到……";
				mes "一切都如此";
				mes "比例完美！";
				mes "难怪大家都想";
				mes "和我组队~";
				break;
			case 2:
				mes "["+strcharinfo(0)+"]";
				mes "天哪~";
				mes "不化妆也能看起来";
				mes "这么漂亮吗？";
				mes "这、这对其他女孩不公平……";
				mes "哇，这真的是我吗？";
				break;
			case 3:
				mes "["+strcharinfo(0)+"]";
				mes "我是不是疯了？";
				mes "镜子里的女孩";
				mes "真的是我吗……？";
				mes "我怎么没发现自己";
				mes "竟然这么漂亮？";
				break;
			case 4:
				mes "["+strcharinfo(0)+"]";
				mes "所以……";
				mes "你对这面镜子做了什么？";
				mes "因为我看着自己的倒影，";
				mes "却找不到身材的任何缺点……";
				next;
				emotion ET_PROFUSELY_SWEAT, getnpcid(0, "Tarsha Cherno");
				mes "[Tarsha Cherno]";
				mes "其实……";
				mes "那不是我们的发明。";
				mes "只是一面普通的镜子……";
				next;
				mes "["+strcharinfo(0)+"]";
				mes "好吧……！";
				mes "你确定吗？";
				mes "因为我的脸看起来";
				mes "简直完美无瑕！";
				mes "我都快性感过头了！";
				break;
			}
		}
		next;
		mes "^3355FF这番小小的自我陶醉后，";
		mes "你把镜子放回原处时，";
		mes "看到了塔莎脖子的倒影。^000000";
		next;
		mes "^3355FF仔细观察后，你发现她的";
		mes "脖子周围有个奇怪的印记。";
		mes "那究竟意味着什么？^000000";
		kain_ticket = 9;
		close;
	}
}

//----------------------------------------------------------------------------
// Tree from Einbech
//----------------------------------------------------------------------------
einbech,45,113,5	script	Tree#t1-1::Tree	HIDDEN_NPC,{
	if (kain_ticket == 11) {
		mes "^3355FF你蹲在树下，";
		mes "开始挖掘地面。^000000";
		next;
		mes "...";
		mes "......";
		next;
		mes "...";
		mes "......";
		mes ".........";
		next;
		.@find_diary = rand(1,100);
		if (.@find_diary > 10) {
			mes "^3355ff遗憾的是，";
			mes "你什么也没找到。^000000";
		} else {
			mes "^3355FF你在凯恩埋藏的其他物品中";
			mes "发现了一本日记。";
			mes "你打开日记，开始阅读里面的内容。^000000";
			callsub L_Diary;
			next;
			mes "...";
			mes "......";
			next;
			mes "^3355FF这是日记的最后一页。你捡起日记，准备把它交给^3131FF塔莎。^000000";
			changequest 2082,2083;
			kain_ticket = 12;
		}
	} else if (kain_ticket == 12) {
		mes "^3355FF你打开日记，";
		mes "开始阅读……^000000";
		callsub L_Diary;
	}
	else
		end;
	close;

L_Diary:
	next;
	mes "...";
	mes "......";
	next;
	mes "<日期：OX OX>";
	mes "^856363我和凯恩在一起";
	mes "真的好幸福。";
	mes "他是个诚实真挚的人，";
	mes "虽然有时很沉默。";
	next;
	mes "^856363虽然他是个很好的丈夫，";
	mes "但我不太擅长做家庭主妇。";
	mes "不过我会为了我们俩";
	mes "尽最大的努力。";
	next;
	mes "<日期：OX OX>";
	mes "^856363我做晚饭时睡着了，";
	mes "把食物全烧焦了。怎么会这么粗心？";
	mes "但凯恩把每一口都吃了，";
	mes "即使他必须假装喜欢。^000000";
	next;
	mes "<日期：OX OX>";
	mes "^856363凯恩和我很快就要有孩子了！";
	mes "我好幸福，虽然有时也有点担心。";
	mes "不过凯恩总是面带笑容，";
	mes "让我安心。^000000";
	next;
	mes "<日期：OX OX>";
	mes "^856363越来越多人离开矿山，";
	mes "去新工厂工作，其中很多是凯恩的朋友。";
	mes "我想凯恩的自尊心受到了伤害。";
	mes "不知道我该怎样帮助他？^000000";
	next;
	mes "<日期：OX OX>";
	mes "^856363凯恩和我现在是一个漂亮女婴的骄傲父母。";
	mes "我们给她取名为^000000塔莎^856363，";
	mes "她有一双父亲般的眼睛。";
	mes "我会尽力成为她最好的母亲。";
	next;
	mes "<日期：OX OX>";
	mes "^856363塔莎第一次叫我‘妈妈’！";
	mes "这是奇迹！";
	mes "我在世上别无所求，";
	mes "只希望她幸福健康。^000000";
	next;
	mes "<日期：OX OX>";
	mes "^856363凯恩在矿山出了事故。";
	mes "他们挖矿时不知怎的释放了毒气。";
	mes "虽然没有致命，";
	mes "但凯恩的手臂部分瘫痪了……^000000";
	next;
	mes "^856363医生说这甚至可能影响他的记忆，";
	mes "他变得非常抑郁。";
	mes "我煮了他最喜欢的汤，";
	mes "试着让他感觉好一些。";
	mes "他笑了，但我看得出来……^000000";
	next;
	mes "^856363我看得出他对此很难受。";
	mes "希望他很快好起来。";
	mes "他的绝望至少和他对工作的热情一样强烈。^000000";
	next;
	mes "...";
	mes "......";
	next;
	mes "<日期：OX OX>";
	mes "^856363凯恩酗酒越来越严重。";
	mes "他回家时经常尖叫大喊。";
	mes "他心中充满怒火，";
	mes "已经不再是从前的他了……";
	next;
	mes "...";
	mes "......";
	next;
	mes "<日期：OX OX>";
	mes "^856363塔莎在厨房玩耍时，";
	mes "手被沸水烫伤了。";
	mes "虽然接受了治疗，";
	mes "但她永远会留下那个^000000烧伤痕迹^856363。^000000";
	next;
	mes "^856363离开医生那里后，塔莎笑着";
	mes "和她的娃娃玩耍，仿佛什么都没发生。";
	mes "但不知为什么，我忍不住哭了……^000000";
	next;
	mes "...";
	mes "......";
	next;
	mes "<日期：OX OX>";
	mes "^856363凯恩最近很少回家。";
	mes "我们的积蓄花光后，";
	mes "我不得不开始在店里工作。";
	mes "既要工作又要照顾家庭，真的很辛苦。";
	next;
	mes "^856363不过看到塔莎的笑容，";
	mes "一切都值得。";
	mes "但我永远无法停止担心";
	mes "我可怜的凯恩……";
	next;
	mes "...";
	mes "......";
	next;
	mes "<日期：OX OX>";
	mes "^856363我每天都感觉越来越虚弱，";
	mes "仿佛每天都离死亡更近一点。";
	mes "我想告诉凯恩医生说的话，";
	mes "但他还没有准备好接受这个消息……^000000";
	next;
	mes "^856363最近塔莎经常哭。";
	mes "可怜的孩子爱着父亲，";
	mes "但他总是那么疏远。";
	mes "不过有时我会看到他为塔莎";
	mes "悲伤地微笑，哪怕只有一瞬间。^000000";















































	return;



}
einbech,36,100,5	duplicate(Tree)	Tree#t1-2	HIDDEN_NPC
einbech,44,90,5	duplicate(Tree)	Tree#t1-3	HIDDEN_NPC

//----------------------------------------------------------------------------
// Expert Repairman
//----------------------------------------------------------------------------
ein_in01,117,80,5	script	Unidentified Machine#as	HIDDEN_NPC,{
	if (kain_ticket > 12) {
		mes "["+strcharinfo(0)+"]";
		mes "这是";
		mes "^FF0000专家修理工^000000吗？！";
		mes "看起来它自己";
		mes "也需要修理……";
		next;
		if (select("修理物品", "取消。") == 1) {
			if (getbrokenid(1) == 0) {
				mes "*Beep-*";
				mes "你没有";
				mes "需要修理的物品。";
				close;
			}
			getinventorylist;
			for (.@i = 0; .@i < @inventorylist_count; .@i++)
				.@total = .@total + @inventorylist_attribute[.@i];
			mes "*Beep-*";
			mes "你总共有";
			mes "" + .@total + " 件损坏的物品。";
			mes "要修理它们吗？";
			next;
			if (select("是", "否") == 1) {
				getinventorylist;
				for (.@i = 0; .@i < @inventorylist_count; .@i++)
					.@total2 = .@total2 + @inventorylist_attribute[.@i];
				if (.@total == .@total2) {
					repairall;
					mes "*Beep-*";
					mes "修理完成。";
				} else {
					mes "*Beep-*";
					mes "请再次检查";
					mes "你的物品。";
				}
				close;
			}
		}
		mes "你选择停止修理。";
	} else {
		mes "^3355FF这似乎是一台";
		mes "奇怪的机器。";
		mes "它的功能和用途";
		mes "完全无法辨认。^000000";
	}
	close;
}


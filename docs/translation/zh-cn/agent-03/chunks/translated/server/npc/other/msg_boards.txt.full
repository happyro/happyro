morocc,32,174,1	script	Bulletin#Moc3	111,{
	mes "^993300- 公告栏写着 -^000000";
	mes "^0099FF梦罗克女性怒火中烧！^000000";
	mes "最近研究显示，梦罗克的大多数男性市民";
	mes "更喜欢吉芬女性。100名梦罗克男性中有90人声称";
	mes "他们与梦罗克地区以外的吉芬女性";
	mes "有过多次交往。";
	next;
	mes "^993300- 公告栏续写 -^000000";
	mes "‘我只是更喜欢和她们相处，仅此而已……’一名梦罗克男子说。";
	mes "‘我又不是反对梦罗克女性，问题到底在哪……’";
	mes "除了这些男性日常活动中";
	mes "的情感和压力问题外，";
	mes "打猎似乎仍是他们的第一要务，";
	mes "而不是在本地区寻找合适的女性……";
	close;
}


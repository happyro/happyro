prontera,158,213,1	script	Sign Post#Prt1	111,{
	mes "^993300- 路牌写着 -^000000";
	mes "北：普隆德拉城堡";
	mes "北：艾尔帕兰";
	mes "西北：吉芬";
	mes "东：普隆德拉原野";
	mes "南：普隆德拉原野";
	mes "东南：艾尔贝塔";
	mes "西南：梦罗克";
	mes "西南：科摩罗";
	mes "西：普隆德拉原野";
	close;
}


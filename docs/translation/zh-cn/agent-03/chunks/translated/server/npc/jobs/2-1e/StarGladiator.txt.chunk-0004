			mes "[Cheehee]";
			mes "嗯……";
			mes "你必须进一步了解";
			mes "星辰的本质。若想成为";
			mes "跆拳大师，你必须理解";
			mes "宇宙。";
			mes "";
			next;
			mes "[Cheehee]";
			mes "如果你能理解";
			mes "这首歌的歌词，";
			mes "就应该明白成为跆拳";
			mes "大师的本质。记住，光";
			mes "有不同的色调……";
			mes "";
			next;
			mes "[Cheehee]";
			mes "太阳的荣耀、";
			mes "温柔的月光，和";
			mes "星辰忧郁的闪烁，";
			mes "彼此都独一无二。";
			mes "请尽情享受这个房间里的星光。";
			next;
			mes "[Cheehee]";
			mes "准备好后，";
			mes "请再去和Moogang";

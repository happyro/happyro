		else if (STGL_Q == 12) {
			mes "[Cheehee]";
			mes "你想离开星之房间吗？";
			mes "";
			next;
			if (select("是:否") == 1) {
				mes "[Cheehee]";
				mes "那么，我带你去";
				mes "最近的城镇斐扬。";
				mes "暂时再见……";

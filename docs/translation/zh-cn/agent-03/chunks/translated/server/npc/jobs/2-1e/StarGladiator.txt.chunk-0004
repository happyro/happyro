				mes "太阳的荣耀、";
				mes "温柔的月光，和";
				mes "星辰忧郁的闪烁，";
				mes "彼此都独一无二。";
				mes "请尽情享受这个房间里的星光。";
				next;
				mes "[Cheehee]";
				mes "准备好后，";
				mes "请再去和Moogang";

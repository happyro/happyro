			mes "月亮驱使着它的群狼。";
			mes "深洞是星辰之地，骑士受群星魔力加持。^000000''";
			next;
			mes "[Cheehee]";
			mes "现在……";
			mes "以下哪一组";
			mes "闪耀着最明亮的";
			mes "星光？";
			next;

tra_fild01,128,142,7	script	Nine Oranges#npc04	4_F_ROGUE,{
	mes "[Nine Oranges]";
	mes "记住！名字一旦选定就很难更改，所以要慎重选择。";
	next;
	mes "[Nine Oranges]";
	mes "对了，不死假人在哪里？";
	next;
	mes "[Nine Oranges]";
	mes "朋友说它头上有骨头图标……？你得先见到它。";
	close;
}

tra_fild01,97,64,3	script	Village#npc01	4_M_CHN8GUEK,{
	mes "[Village ]";
	mes "你好！天气真好，不是吗？我来看看新的训练场。";
	next;
	mes "[Village ]";
	mes "旧训练场不坏，但其实租用了初学者长期使用的场地，所以有些不便。";
	next;
	mes "[Village ]";
	mes "不过他们建造了宽敞漂亮的新训练场。看来最近资金很充足！";
	close;
}

tra_fild02,101,90,5	script	Jar Cat#npc09	4_CAT_SAILOR5,{
	mes "[Jar Cat]";
	mes "你第一次来训练场吗？让我这个老手给你讲讲。";
	next;
	mes "[Jar Cat]";
	mes "训练场有三个：基础训练场、1/10训练场和1/100训练场。它们的区别就留给你自己发现。";
	next;
	mes "[Jar Cat]";
	mes "哦，对了！要前往其他训练场，可以使用3点和9点方向的传送门。记住！";
	close;
}


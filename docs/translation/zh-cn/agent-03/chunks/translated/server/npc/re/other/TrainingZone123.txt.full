// Storage
tra_fild01,204,110,2	script	Training Ground Warehouse Soldier#fild01_1	8W_SOLDIER,{
	mes "[Training Ground Warehouse Soldier]";
	mes "要使用仓库吗？训练场仓库需要1000 Zeny。请选择要使用的仓库。";
	next;
	// switch( select( "¢º Storage 1", "¢º Storage 2", "¢º Storage 3", "¢º Guild Storage", "¢º Cancel" ) ) {
	switch( select( "仓库1", "", "", "公会仓库", "取消" ) ) {
	case 1:
		.@storage_num = 1;
		break;
	case 2:
		.@storage_num = 2;
		break;
	case 3:
		.@storage_num = 3;
		break;
	case 4:
		// copied from npc/re/merchants/guild_warehouse.txt
		.@guildid = getcharid( 2 );

		if( .@guildid == 0 ){
			mes "[Training Ground Warehouse Soldier]";
			mes "公会仓库仅供公会成员使用。";
			close;
		}

		if( getgdskilllv( .@guildid, "GD_GUILD_STORAGE" ) == 0 || !guild_has_permission( GUILD_PERM_STORAGE ) ){
			mes "[Training Ground Warehouse Soldier]";
			mes "你的公会似乎还不能使用公会仓库，或者你没有仓库权限。";
			mes "请确认公会技能和仓库权限后再回来。";
			close;
		}

		if( Zeny < 1000 ){
			mes "[Training Ground Warehouse Soldier]";
			mes "恐怕你的钱不够支付费用。";
			mes "费用是1000 Zeny。";
			close;
		}

		mes "[Training Ground Warehouse Soldier]";
		mes "那我为你打开公会仓库。祝你留下难忘回忆！";
		close2;

		if( Zeny < 1000 ){
			// Cheat prevention
			end;
		}

		if( guildopenstorage() == GSTORAGE_OPEN ){
			Zeny -= 1000;
			end;
		}else{
			mes "[Training Ground Warehouse Soldier]";
			mes "恐怕现在有人正在使用仓库。";
			mes "过一会儿再试。";
			close;
		}
	case 5:
		end;
	}
	// TODO (custom text)
	if (!callfunc("F_CanOpenStorage")) {
		mes "[Training Ground Warehouse Soldier]";
		mes "抱歉，你需要";
		mes "新手的";
		mes "基础技能达到6级，才能";
		mes "使用仓库服务。";
		close2;
		cutin "",255;
		end;
	}

	if (Zeny < 1000) {
		mes "[Training Ground Warehouse Soldier]";
		mes "^4d4dff使用训练场仓库需要1000 Zeny。^000000";
		close;
	}
	Zeny -= 1000;
	openstorage; // TODO: open correct storage 1-3
	end;
}

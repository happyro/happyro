1@sthb,34,85,1	script	Deactivated Warp#sthd_mov_1	4_ENERGY_WHITE,{
	if (select( "关闭传送。", "启动传送。" ) == 1) {
		mes "- 将要塞移动到特殊地点 -";
		mes "- 可通行的门 -";
		mes "- 你发现了一扇可通行的门 -";
		close;
	}
	if (countitem(6960) < 1) {
		mes "- 要操作传送 -";
		mes "- 你需要天空要塞的钥匙。-";
		close;
	}
	delitem 6960,1;
	mes "- Warp has been -";
	mes "- 成功启动 -";
	mes "- 阴沉的传送 -";
	mes "- 已出现 -";
	mes "- 闪耀黑光 -";
	disablenpc();
	enablenpc instance_npcname("Activated Warp#" + strnpcinfo(2));
	close;
}


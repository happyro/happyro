		mes "所以我很想进入要塞，";
		mes "却找不到入口。";
		mes "我日夜研究，";
		mes "终于找到了入口。";
		next;
		mes "[Scientist Doyeon]";
		mes "要进入要塞，";
		mes "必须启动传送。";
		mes "为此，";
		mes "-副本通行证-";
		mes "不可或缺！";
		next;
		mes "[Scientist Doyeon]";
		mes "另外……我一直在准备";
		mes "传送所需的大量魔法。";
		mes "现在我需要一名战士，";
		mes "能够粉碎要塞";
		mes "为普隆德拉带来和平。";
		close;
	}
	.@party_name$ = getpartyname(getcharid(1));
	mes "[Scientist Doyeon]";
	mes "我是居住在普隆德拉的";
	mes "科学家。";
	mes "我教孩子们，也进行研究。";
	mes "但那里变得";
	mes "太危险了，";
	mes "所以我搬到了这里。";
	next;
	switch( select( "关于天空要塞", "进入天空要塞。", "结束对话。" ) ) {
	case 1:
		mes "[Scientist Doyeon]";
		mes "但现在……我的日常生活";
		mes "已经支离破碎。";
		next;
		mes "[Scientist Doyeon]";
		mes "因为这座要塞";
		mes "看起来像巨大的垃圾桶，";
		mes "我们的村庄变成了垃圾堆，";
		mes "甚至不会腐烂。";
		next;
		mes "[Scientist Doyeon]";
		mes "建筑倒塌，";
		mes "人们不断死去……";
		mes "我真想知道普隆德拉宫殿的贵族和士兵";
		mes "在这种情况下究竟在做什么。";
		next;
		mes "[Scientist Doyeon]";
		mes "大量不死怪物不断涌来，";
		mes "就像树液怪吐出树液。";
		mes "无论杀死多少，";
		mes "它们都不停出现。";
		mes "***";
		next;
		mes "[Scientist Doyeon]";
		mes "我猜这些怪物是在";
		mes "要塞内部制造的。";
		mes "我认为只要打败要塞里的首领，";
		mes "怪物就会消失，";
		mes "普隆德拉也会恢复稳定。";
		mes "***";
		next;
		mes "[Scientist Doyeon]";
		mes "所以我很想进入要塞，";
		mes "却找不到入口。";
		mes "我日夜研究，";
		mes "终于找到了入口。";
		next;
		mes "[Scientist Doyeon]";
		mes "要进入要塞，";
		mes "必须启动传送。";
		mes "为此需要大量魔法，";
		mes "不可或缺！";
		next;
		mes "[Scientist Doyeon]";
		mes "另外……我一直在准备";
		mes "传送所需的大量魔法。";
		mes "现在我需要一名战士，";
		mes "能够粉碎要塞";
		mes "为普隆德拉带来和平。";
		mes "所以我才在这里。";
		close;
	case 2:
		mes "[Scientist Doyeon]";
		mes "要启动传送，";
		mes "需要大量魔法。";
		mes "别忘了带给我";
		mes "-副本通行证-。";
		mes "这是打开";
		mes "通往天空要塞传送的唯一方法。";
		next;
		if (select( "结束对话。", "出示-副本通行证-。" ) == 1) {
			mes "[Scientist Doyeon]";
			mes "别忘了带给我";
			mes "-副本通行证-。";
			mes "进入天空要塞，";
			mes "帮助我们拯救";
			mes "被入侵的普隆德拉。";
			close;
		}
		if (rentalcountitem(14505) < 1 && rentalcountitem(14506) < 1) {// Sky Fortress Ticket
			mes "[Scientist Doyeon]";
			mes "没有-副本通行证-，";
			mes "恐怕无法启动。";
			mes "没有它我无法打开传送。";
			close;
		}
		mes "[Scientist Doyeon]";
		mes "哦！你从哪里";
		mes "拿到-副本通行证-的？";
		mes "这件物品足够了。";
		mes "打开传送门。";
		next;
		if (select( "结束对话。", "启动传送。" ) == 1) {
			mes "[Scientist Doyeon]";
			mes "你不打算";
			mes "帮助普隆德拉吗？";
			close;
		}
		mes "[Scientist Doyeon]";
		mes "好了！我打开了";
		mes "通往天空要塞的传送！";
		mes "传送只会在有限时间内";
		mes "保持激活。";
		mes "快进去！";
		if (instance_create("Sky Fortress Invasion") < 0) {
			mes "队伍名称：" + .@party_name$;
			mes "队长：" + strcharinfo(0);
			mes "^0000ff天空要塞入侵^000000- 预约失败！";
			close;
		}
		close;
	case 3:
		close;
	}
}


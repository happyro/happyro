		mes "天啊！我想我";
		mes "已经用尽力气了。";
		mes "好了，拿去吧～";
		delitem 5033,1; //Smokie_Hat
		delitem 5064,1; //Leaf_Headgear
		getitem 5078,1; //Sea_Otter_Cap
		next;
		mes "[Pretty Lindsay]";
		mes "我用尽心意做了这顶帽子，你一定要答应我好好爱护它，好吗？";
		close;
	}
	if (Sex == SEX_MALE) {
		mes "[Pretty Lindsay]";
		mes "你好呀？";
		mes "先生……？";
		next;
		emotion ET_SMILE;
		mes "[Pretty Lindsay]";
		mes "你看起来快冻僵了……";
		mes "嗯，我知道了！我给你做一顶可爱、温暖又毛茸茸的海獭帽怎么样？";
		next;
		mes "[Pretty Lindsay]";
		mes "它真的真的很可爱！而且这是我唯一会做的帽子，因为我太喜欢和海獭一起玩了！";
		next;
		mes "[Pretty Lindsay]";
		mes "不过，我需要把 ^0000FF1 顶浣熊帽^000000 和 ^0000FF1 片狸猫树叶^000000 组合起来，才能为你做出 ^4D4DFF海獭帽^000000。";
		next;
		if (select("好，我会带材料回来。:嗯……你为什么需要浣熊帽？") == 1) {
			emotion ET_SMILE;
			mes "[Pretty Lindsay]";
			mes "太好了～！尽快回来哦～！";
			close;
		}
		mes "[Pretty Lindsay]";
		mes "这个嘛，本来应该是个秘——密，不过妈妈教了我用浣熊帽制作海獭帽的魔法。";
		next;
		mes "[Pretty Lindsay]";
		mes "这是最棒的魔法，因为它来自我的心！";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "这……";
		mes "这还是完全解释不了啊！";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "好吧……";
		mes "嗯……";
		mes "我之后再来找你，小姑娘。";
		close;
	}
	mes "[Pretty Lindsay]";
	mes "你好，你好～！";
	mes "你真是位漂亮的女士！";
	next;
	emotion ET_SMILE;
	mes "[Pretty Lindsay]";
	mes "嘿嘿！我可以给你做一顶海獭帽吗？它真的真的真的真的很可爱！";
	next;
	mes "[Pretty Lindsay]";
	mes "我需要 ^0000FF1 顶浣熊帽^000000 和 ^0000FF1 片狸猫树叶^000000，才能为你做 ^4D4DFF海獭帽^000000。";
	next;
	if (select("好，我会带材料回来。:嗯，你为什么这么喜欢做帽子？") == 1) {
		emotion ET_SMILE;
		mes "[Pretty Lindsay]";
		mes "太好了～！";
		mes "尽快";
		mes "回来哦～！";
		close;
	}
	mes "[Pretty Lindsay]";
	mes "因为……！";
	mes "如果卢迪所有人都戴着毛茸茸的海獭帽，一定会超级可爱！";
	next;
	mes "[Pretty Lindsay]";
	mes "我们可以在雪地里玩游戏，和真正的海獭一起玩，让它们载着我们兜风，还有……";
	mes "……";
	close;
}

// Teddybear Hat
//============================================================
xmas,175,156,3	script	Fuzzy Fuzz#1	712,{
	disable_items;
	if (checkweight(1201,1) == 0) {
		mes "- 等一下！-";
		mes "- 你现在携带了 -";
		mes "- 太多物品。-";
		mes "- 请先把一些物品 -";
		mes "- 放进卡普拉仓库后再试。-";
		close;
	}
	if (countitem(5030) > 0 && countitem(7213) > 99  && countitem(7217) > 99 && countitem(7161) > 299) {
		if ((MaxWeight-Weight) < 2000) {
			mes "[Fuzzy Fuzz]";
			mes "你带来了我需要的全部材料，但很遗憾，你的物品栏没有足够空间。请先把一些物品放进卡普拉仓库。";
			close;
		}
		mes "[Fuzzy Fuzz]";
		mes "太棒了！你把东西都带齐了！我为你制作泰迪熊帽时，请稍等片刻。";
		next;
		emotion ET_DELIGHT;
		mes "[Fuzzy Fuzz]";
		mes "嗯嗯嗯……";
		mes "把这个拆下来……";
		mes "把这个缝上去……";
		mes "好了，快完成了……";
		next;
		mes "[Fuzzy Fuzz]";
		emotion ET_FRET;
		mes "有句老话说：‘耐心等待，终会如愿。’哦，你冻着了吗？搓搓手吧？";
		next;
		mes "[Fuzzy Fuzz]";
		emotion ET_AHA;
		mes "完成了！给你。我觉得这顶帽子戴在你身上一定很好看！请好好爱护它。";
		delitem 5030,1; //Panda_Cap
		delitem 7213,100; //Needle_Pouch
		delitem 7217,100; //Spool
		delitem 7161,300; //Black_Bear's_Skin
		getitem 5059,1; //Brown_Bear_Cap
		close;
	}
	emotion ET_SURPRISE;
	mes "[Fuzzy Fuzz]";
	mes "你好，年轻人。";
	mes "是什么风把你吹到卢迪？这里是充满善意、全年洋溢圣诞欢乐的小镇。";
	next;
	mes "[Fuzzy Fuzz]";
	mes "我是制作毛绒玩具的大师，它们是很棒的礼物。大家都喜欢拥抱可爱又柔软的毛绒玩具。";
	next;
	mes "[Fuzzy Fuzz]";
	mes "我的专长是‘泰迪熊帽’。戴上它，你会像泰迪熊一样可爱，拥抱也会加倍温暖柔软。";
	next;
	mes "[Fuzzy Fuzz]";
	if (Sex == SEX_MALE) {
		mes "‘泰迪熊帽’不是谁都能戴的，因为它的拥抱力量很容易被滥用。";
		next;
		mes "[Fuzzy Fuzz]";
		mes "但我感觉你是心地纯洁的冒险者，不会为了私利使用泰迪熊帽。";
		next;
		mes "[Fuzzy Fuzz]";
		mes "为圣诞老人工作了很——长时间后，我学会了分辨好人和坏人……";
	}
	else {
		mes "我感觉你是心地善良的冒险者，像你这样可爱的女孩值得一份好礼物。";
		next;
		mes "[Fuzzy Fuzz]";
		mes "为圣诞老人工作这么久后，我对这些事更了解了。";
	}
	next;
	mes "[Fuzzy Fuzz]";
	mes "遗憾的是，我现在没有制作头饰的材料。但如果你带来材料，我可以免费为你制作‘泰迪熊帽’。";
	next;
	mes "[Fuzzy Fuzz]";
	mes "让我看看……";
	mes "我需要……";
	mes "^0000FF1 Panda Hat^000000,";
	mes "^0000FF100 Needle Packet^000000,";
	mes "^0000FF100 Spool^000000 and";
	mes "^0000FF300 Black Bear Skin^000000.";
	next;
	mes "[Fuzzy Fuzz]";
	mes "你能把这些都找来吗？我会在这里等你。";
	emotion ET_SMILE;
	close;
}

// Model Training Hat
//============================================================
payon_in03,8,193,4	script	Nanhyang#1	77,{
	disable_items;
	if (checkweight(1201,1) == 0) {
		mes "- Wait a minute! -";
		mes "- Currently you're carrying -";
		mes "- too many items with you. -";
		mes "- Please try again after -";
		mes "- you put some items into Kafra Storage. -";
		close;
	}
	if ((MaxWeight-Weight) < 2430) {
		mes "[Nanhyang]";
		mes "嗯……";
		mes "你带的东西似乎太多了。把多余物品放进卡普拉仓库怎么样？";
		close;
	}
	if (countitem(5073) > 0 && countitem(1750) > 0) {
		mes "[Nanhyang]";
		mes "你好。";
		mes "啊，我看得出来你已经有一顶 ^8C1717‘模特训练帽’^000000。看来它已经纠正了你的姿势。";
		next;
		mes "[Nanhyang]";
		mes "哦……";
		mes "我忘了告诉你，我不只能制作‘模特训练帽’，也能把它拆回原来的材料。";
		next;
		mes "[Nanhyang]";
		mes "如果你给我 ^0000FF1 顶‘模特训练帽’^000000 和 ^0000FF1 支‘箭’^000000， 我会给你 ^8C17171 个‘弓箭手苹果’^000000 和 ^8C17171 本‘书’^000000。要拆解这些物品吗？";
		next;
		if (select("拆解:取消") == 1) {
			mes "[Nanhyang]";
			mes "谢谢。";
			mes "制作这顶帽子不会花太久，请稍等片刻。";
			next;
			mes "[Nanhyang]";
			mes " . . . . . . . . . . . . . .";
			mes " . . . . . . . . . . . . . ";
			mes " . . . . . . . . . . . . . .";
			mes " . . . . . . . . . . . . . ";
			next;
			mes "[Nanhyang]";
			delitem 5073,1; //Cap_Of_Concentration
			delitem 1750,1; //Arrow
			getitem 2285,1; //Apple_Of_Archer
			getitem 1550,1; //Book
			mes "给你。";
			next;
			mes "[Nanhyang]";
			mes "如果你想再制作一顶";
			mes "'Model Training Hat' again,";
			mes "欢迎随时回来。";
			close;
		}
		mes "[Nanhyang]";
		mes "我明白了。";
		mes "希望你继续";
		mes "使用那顶帽子";
		mes "改善你的姿势";
		mes "和优雅仪态。";
		close;
	}
	if (countitem(2285) > 0 && countitem(1550) > 0) {
		mes "[Nanhyang]";
		emotion ET_SMILE;
		mes "你把材料带来了～";
		next;
		mes "[Nanhyang]";
		mes "在我开始制作前，必须先提醒你……";
		next;
		mes "[Nanhyang]";
		mes "如果你带来的 ^FF0000‘书’和‘弓箭手苹果’^000000 曾被^FF0000升级^000000，制作模特训练帽后，^FF0000这些升级（包括插卡）都会消失。^000000";
		next;
		mes "[Hanhyang]";
		mes "那么现在要制作模特训练帽吗？";
		next;
		if (select("制作:取消") == 1) {
			mes "[Nanhyang]";
			emotion ET_OK;
			mes "谢谢。";
			mes "我马上为你制作一顶。请坐下稍作休息。";
			next;
			mes "[Nanhyang]";
			mes "通常我们会收取 Zeny 服务费，但既然你已经拥有^3355FF那种气质^000000，我就免收了。";
			next;
			mes "[Nanhyang]";
			mes "请稍等片刻，我马上把它组装好。";
			next;
			mes " . . . . . . . . . . . . . .";
			mes " . . . . . . . . . . . . . ";
			mes " . . . . . . . . . . . . . .";
			mes " . . . . . . . . . . . . . ";
			next;
			mes "[Nanhyang]";
			emotion ET_AHA;
			mes "这并不难。希望你每天戴着这顶帽子，改善自己的姿势。";
			next;
			mes "[Nanhyang]";
			mes "刚开始你可能很难保持平衡，不让苹果掉下来，甚至会感到脖子剧痛。但为了美丽，一切都是值得的。";
			next;
			mes "[Nanhyang]";
			mes "给你。";
			mes "对了，弓箭手苹果上的这支箭剩下了，你可以拿走。";
			delitem 2285,1; //Apple_Of_Archer
			delitem 1550,1; //Book
			getitem 5073,1; //Cap_Of_Concentration
			next;
			mes "[Nanhyang]";
			mes "另外，我可以把模特训练帽拆回原材料。如果你想取回原来的物品，请带来模特训练帽和我给你的箭。";
			getitem 1750,1; //Arrow
			next;
			mes "[Nanhyang]";
			mes "希望你";
			mes "今天过得";
			mes "愉快。";
			mes "再见。";
			close;
		}
		mes "[Nanhyang]";
		emotion ET_THINK;
		mes "我明白了。你一定是带来了不想失去的插卡或升级物品。准备好后随时可以回来。";
		close;
	}
	mes "[Nanhyang]";
	emotion ET_SURPRISE;
	mes "你好～";
	mes "欢迎来到英俊魅力模特学校。有什么可以帮你的吗？";
	next;
	if (select("我想成为模特～！:取消") == 1) {
		mes "[Nanhyang]";
		mes "我明白了～";
		mes "虽然很明显你拥有‘^3355FF那种气质^000000’，但我们目前无法接收学生。";
		next;
		mes "[Nanhyang]";
		mes "最近校长外出了，我们不知道他什么时候回来。^333333*叹气* 我甚至不记得上次领工资是什么时候了。^000000";
		next;
		mes "[Nanhyang]";
		mes "嗯……等等！";
		mes "至少我们可以训练你改善姿势，让你走路时拥有王者般的仪态。";
		next;
		mes "[Nanhyang]";
		mes "虽然现在无法开课，但我可以为你制作一顶特殊的‘模特训练帽’。这样你就能自己练习在 T 台上优雅走秀。";
		next;
		mes "[Nanhyang]";
		emotion ET_QUESTION;
		mes "但校长不在，我们不能动用预算送你帽子。如果你愿意，请带来以下物品……";
		next;
		mes "[Nanhyang]";
		mes "请带来……";
		mes "^0000FF1 Apple of Archer^000000 and";
		mes "^0000FF1 Book^000000.";
		mes "这样我就能马上为你制作‘模特训练帽’。";
		close;
	}
	mes "[Nanhyang]";
	mes "我明白了。";
	mes "祝你今天愉快。";
	mes "谢谢～";
	close;
}

// Tulip Hairpin
//============================================================
geffen,83,189,5	script	Seth#1	716,{
	disable_items;
	if (checkweight(1201,1) == 0) {
		mes " [Seth]";
		mes "哇，你怎么带了这么多东西？";
		mes "看起来好重……！把一些东西收起来，也许走路会轻松些？";
		close;
	}
	mes " [Seth]";
	mes "你好，我叫塞斯！";
	mes "我喜欢折纸和做纸艺。我给妈妈做了一艘大纸船，她对我笑了笑，还摸了摸我的头！";
	emotion ET_SMILE;
	next;
	mes "[Seth]";
	mes "今天在学校，我学会了做纸花！纸花有点难，但现在我会做了！后来我做了一朵小小小小的花，戴在头上～";
	emotion ET_THROB;
	next;
	if (countitem(2278) > 0 && countitem(975) > 0) {
		mes "[Seth]";
		mes "嘿～！";
		mes "你有微笑先生和猩红染料！呀～！我可以用它们给你做一朵纸花。来，让我给你看看！";
		emotion ET_PROFUSELY_SWEAT;
		next;
		mes "[Seth]";
		mes "让我做";
		mes "一朵给你，";
		mes "好不好嘛？";
		emotion ET_PROFUSELY_SWEAT;
		next;
		switch(select("好啊！:不用了，小鬼。:男孩子不该做花。")) {
		case 1:
			emotion ET_SMILE;
			mes "[Seth]";
			mes "耶～";
			mes "你最好了！";
			next;
			mes "[Seth]";
			mes "让我看看……";
			mes "我把微笑先生这样剪～。";
			mes "*Snip Snip Snip~~*";
			mes "*Snip...Snip...*";
			mes "呀——啊——……";
			emotion ET_DELIGHT;
			next;
			mes "[Seth]";
			mes "锵锵～！";
			next;
			delitem 2278,1; //Mr_Smile
			delitem 975,1; //Scarlet_Dyestuffs
			getitem 5077,1; //Tulip_Hairpin
			mes "[Seth]";
			mes "嘿嘿嘿～！";
			mes "完成了！";
			mes "我做得很好，对吧？";
			next;
			if (BaseJob == Job_Novice || BaseJob == Job_Super_Novice) {
				mes "[Seth]";
				mes "哦，这是剩下的材料。妈妈说东西应该好好保存。嘿嘿～";
				getitem 935,1; //Shell
				next;
			}
			mes "[Seth]";
			mes "我是个好孩子！";
			mes "我要给妹妹做一朵～！也给所有我喜欢的人做！";
			next;
			mes "[Seth]";
			mes "如果你还想看我做一朵，就再带些猩红染料和微笑先生来，好吗？拜拜～！";
			close;
		case 2:
			mes "[Seth]";
			mes "*Sniff sniff*";
			mes "好、好吧……";
			mes "我只是想让你看看我有多厉害……";
			emotion ET_CRY;
			close;
		case 3:
			mes "[" + strcharinfo(0) + "]";
			mes "喂。";
			next;
			mes "[" + strcharinfo(0) + "]";
			mes "男孩子不该做花。";
			next;
			mes "[Seth]";
			mes "哇啊啊啊～！";
			mes "可是花朵又漂亮又可爱！！！";
			emotion ET_CRY;
			close;
		}
	}
	else {
		mes "[Seth]";
		mes "你想让我给你看？嗯？";
		mes "你想的话我可以做！";
		next;
		mes "[Seth]";
		mes "糟糕……";
		mes "可是我没有做纸花的材料。";
		next;
		if (select("我去找你需要的东西。:真遗憾！") == 1) {
			mes "[Seth]";
			mes "好吧好吧……";
			mes "我需——要……";
			mes "^3131FF1 Mr. Smile^000000 and";
			mes "^3131FF1 Scarlet Dyestuffs^000000.";
			mes "这样我就能给你做一朵小小小花。";
			next;
			mes "[Seth]";
			mes "塞斯会在这里等你。答应我一定会回来，好吗？";
			close;
		}
		emotion ET_CRY;
		mes "[Seth]";
		mes "哇~~~~~！";
		close;
	}
}
	
// Party Hat, Straw Hat, Cowboy Hat, Sombrero, Beanie
//============================================================
xmas_in,35,30,3	script	Hat Merchant#zero	797,{
	disable_items;
	if (checkweight(1201,1) == 0) {
		mes "- Wait a minute !! -";
		mes "- Currently you're carrying -";
		mes "- too many items with you. -";
		mes "- Please try again -";
		mes "- after you lose some weight. -";
		close;
	}
	mes "[Mad Hatter]";
	mes "你好。嗯……";
	mes "我是‘疯狂帽客’。至少我这么称呼自己。";
	next;
	mes "[Mad Hatter]";
	mes "如果你给我一些材料，我可以翻新你的旧帽子，让它真正展现你的个性。无论你悠闲自在还是热爱派对，我都能为你制作专属帽子！";
	next;
	mes "[Mad Hatter]";
	mes "想看看我能为你制作的时髦帽子吗？";
	next;
	switch(select("派对帽:草帽:牛仔帽:宽边帽:针织帽")) {
	case 1:
		if (countitem(2236) > 0 && countitem(7151) > 99 && countitem(7111) > 99) {
			mes "[Mad Hatter]";
			mes "派对帽！这是我加上彩纸、重新制作的圣诞帽，充满节日气氛。戴上派对帽庆祝欢乐时光吧！来！";
			next;
			mes "[Mad Hatter]";
			mes "等等！开始前请确认一件事。";
			next;
			mes "[Mad Hatter]";
			mes "如果用来制作这顶帽子的圣诞帽曾被升级或插卡，所有升级都会消失。为安全起见，我建议你把除派对帽材料外的所有物品放进卡普拉仓库。";
			next;
			mes "[Mad Hatter]";
			mes "看来你把东西都带齐了。好！要我为你制作派对帽吗？";
			next;
			if (select("不用了，谢谢。:好的。") == 1) {
				mes "[Mad Hatter]";
				mes "嗯，好吧……";
				mes "看来成为派对核心对你来说有点勉强，是吧？哼。我知道朱诺有个不错的图书馆，你可以去那里消磨时间……";
				close;
			}
			mes "^3355FF*Rustle Rustle Splat Splat*^000000";
			mes "^3355FF*Squick Squick Grind Grind*^000000";

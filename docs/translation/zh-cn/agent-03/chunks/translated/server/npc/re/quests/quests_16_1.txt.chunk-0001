	if (isbegin_quest(7681) == 1) {
		mes "[Chamberlain Bell]";
		mes "特殊客房就是这样准备的。";
		mes "那是你进去后看到的^4d4dff第一间房^000000。";
		next;
		mes "[Chamberlain Bell]";
		mes "进房间后我再详细告诉你情况。";
		mes "请往这边走。";
		close2;
		cloakonnpcself( "Chamberlain Bell#ep16_02" );
	}
	end;
}


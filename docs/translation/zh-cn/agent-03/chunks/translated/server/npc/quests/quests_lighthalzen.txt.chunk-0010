			mes "吊坠打开，露出一对幸福情侣的照片。照片里的女孩不舒服地坐在旧椅子上，却莫名让你觉得熟悉……^000000";
				set lhz_curse,19;
				changequest 2092,2093;
				delitem 523,5; //Holy_Water
				delitem 744,1; //Bunch_Of_Flowers
				close;
			}
			else {
				mes "[Elder]";
			mes "快带来^3131FF5 瓶圣水^000000和^3131FF1 束花^000000，让我解除诅咒。别忘了带吊坠。";
				close;
			}
		}
		else {
			mes "[Elder]";
		mes "捕食者总在寻找容易下手的猎物。年轻人，小心！你看起来很天真，容易成为城里的受害者。";
			next;
			switch(select("关于拉赫:关于贫民窟:????")) {
			case 1:
				mes "[Elder]";
				mes "拉赫起初看起来可能很辉煌，但你很快会发现穷人和富人隔离，被当作低等公民。";
				next;
				mes "[Elder]";
				mes "起初，贫富区隔离执行得很隐蔽。他们在两区之间修铁路，方便富人忽视穷人。";
				next;
				mes "[Elder]";
				mes "现在他们甚至派卫兵确保穷人不会打扰富人。我确信这种隔离短期内不会结束……";
				next;
				mes "[Elder]";
				mes "听说 Rekenber 公司为贫民窟居民提供工作。乞丐没有选择，所以这些工作肯定不怎么样。";
				close;
			case 2:
				mes "[Elder]";
				mes "住在贫民窟意味着熟悉贫穷、疾病、谴责与蔑视。但我们仍是人，请放下成见。";
				next;
				mes "[Elder]";
				mes "我们只是在努力生存。至少请尊重这一点。富人区的人似乎总忘记这个事实。";
				close;
			case 3:
				mes "[Elder]";
				mes "如果需要帮助或有问题，回来问我吧。我觉得我们还会再见。";
				close;
			}
		}
	}
	else {
		if (lhz_curse < 1) {
			mes "[Elder]";
			mes "捕食者总在寻找容易下手的猎物。年轻人，小心！你看起来很天真，容易成为城里的受害者。";

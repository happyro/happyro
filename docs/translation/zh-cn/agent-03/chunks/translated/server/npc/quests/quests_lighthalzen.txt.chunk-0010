lhz_in03,32,162,3	script	Crippled Girl#li_tre	1_M_INNKEEPER,{
	if (lhz_curse == 23) {
		if (countitem(7341) > 0) {
			mes "["+strcharinfo(0)+"]";
			mes "嘿，你感觉还好吗？";
			next;
			mes "[Crippled Girl]";
			mes "哦，谢谢，我没事。但是……我们以前见过吗？";
			next;
			mes "["+strcharinfo(0)+"]";
			mes "是的。你现在应该知道我是谁了。嘿，你没忘吧？";
			next;
			mes "[Lady]";
			mes "该怎么说呢？她前几天发烧。虽然好转了，却忘记了过去几周发生的一切……";
			next;
			mes "["+strcharinfo(0)+"]";
			mes "哦……哦。对不起。但也许这样最好？给，我觉得你还是留着这个吊坠吧。";
			next;
			mes "^3131ff你把旧吊坠放进她手里。^000000";
			next;
			specialeffect2 EF_FORESTLIGHT4;
			mes "...............";
			next;
			mes "["+strcharinfo(0)+"]";
			mes "...";
			mes "......";
			next;
			mes "[Possessed "+strcharinfo(0)+"]";
			mes "^3131FFSetsu，请记住我永远不会伤害你。原谅我把你留下。希望有一天我们能再见，小公主。^000000";
			next;
			mes "[Possessed "+strcharinfo(0)+"]";
			mes "^3131FF在那之前，我希望你幸福，好吗？哥哥会一直守护你，无论以何种方式……^000000";
			next;
			mes "[Setsu]";
			mes "哥哥……那是哥哥的声音！哥哥！";
			next;
			mes "["+strcharinfo(0)+"]";
			mes "咦？什么？哇……";
			mes "我刚才怎么了？我最后记得……";
			next;
			mes "[Setsu]";
			mes "...";
			mes "......";
			next;
			mes "["+strcharinfo(0)+"]";
			mes "嗯……";
			mes "这真尴尬。";
			delitem 7341,1; //Worn_Out_Pendant
			set lhz_curse,24;
			close;
		}
		else {
			mes "["+strcharinfo(0)+"]";
			mes "嘿，你感觉还好吗？";
			next;
			mes "[Crippled Girl]";
			mes "哦，谢谢，我没事。但是……我们以前见过吗？";
			next;
			mes "["+strcharinfo(0)+"]";
			mes "是的。你现在应该知道我是谁了。嘿，你没忘吧？";
			next;
			mes "[Lady]";
			mes "该怎么说呢？她前几天发烧。虽然好转了，却忘记了过去几周发生的一切……";
			next;
			mes "^3131ff这是把吊坠交给她的好机会……^000000";
			close;
		}
	}
	else if (lhz_curse == 24) {
		mes "[Setsu]";
		mes "...";
		mes "......";
		close;
	}
	else if (lhz_curse == 25) {
		mes "[Setsu]";
		mes "不好意思，我还不能走路，但我已经不会再哭了。我会尽力的！";
		close;
	}
	else {
		mes "[Crippled Girl]";
		mes "...";
		mes "......";
			mes "*叹气……*";
		next;
		select("你好，你还好吗？");
		mes "[Crippled Girl]";
		mes "哦，我很好，谢谢你的关心。我只是在等一个人，仅此而已。";
		if (lhz_curse == 19) {
			next;
			switch(select("给她看吊坠。:好的，祝你今天愉快。")) {
			case 1:
				break;
			case 2:
				mes "[Crippled Girl]";
				mes "好的，再见……";
				close;
			}
			mes "["+strcharinfo(0)+"]";
			mes "呃，你知道这个吊坠可能属于谁吗？";
			next;
			if (countitem(7341) < 1) {
				mes "[Crippled Girl]";
				mes "你在说什么？";
				close;
			}
			emotion ET_SURPRISE;
			mes "[Crippled Girl]";
			mes "哦，那是我的！哥哥出门出差前，我把它交给了他。你一定是他的朋友，对吗？";
			next;
			mes "["+strcharinfo(0)+"]";
			mes "其实，呃，你知道吗……？";
			next;
				switch(select("残酷的真相:委婉地告诉她")) {
			case 1:
				mes "...";
				mes "......";
				next;
				mes "["+strcharinfo(0)+"]";
				mes "……简单来说，你哥哥就是 @lhz_ghost。对了，我说过他已经死了吗？总之他已经不在人世了，但他的灵魂或什么东西还在附近，而且——";
				next;
				mes "[Crippled Girl]";
				mes "...";
				mes "......";
				next;
				mes "[Crippled Girl]";
				mes "……死了？";
				mes "不！我不相信你！他不可能死！他是最勇敢、最温柔的人，而且——离我远点！天啊，滚开！";
				next;
				mes "["+strcharinfo(0)+"]";
				mes "...";
				mes "......";
				mes "唉。别迁怒于传话的人。";
				set lhz_curse,20;
				close2;
				warp "lighthalzen",322,323;
				end;
			case 2:
				if (countitem(7341) > 0) {
					mes "[Crippled Girl]";
					mes "你见过我哥哥吗……？";
					next;
					mes "[Crippled Girl]";
					mes "我哥哥很强，我应该为此高兴，因为没人能伤害他。";
					next;
					mes "["+strcharinfo(0)+"]";
				mes "嗯……是的。那么……";
					next;
					mes "["+strcharinfo(0)+"]";
				mes "当然，你哥哥一定很开心。他总会回来的。哥哥回来前你应该好好睡觉，保持健康。";
					next;
					mes "[Crippled Girl]";
				mes "是的！哥哥回来时我必须好好的，能够走路。";
					next;
				mes "^3131ff你把旧吊坠放进她手里。^000000";
					next;
					specialeffect2 EF_FORESTLIGHT4;
					mes "......";
					next;
					mes "["+strcharinfo(0)+"]";
					mes "...............";
					next;
					mes "[Possessed "+strcharinfo(0)+"]";
				mes "^3131FFSetsu，请记住我永远不会伤害你。原谅我把你留下。希望有一天我们能再见，小公主。^000000";
					next;
					mes "[Possessed "+strcharinfo(0)+"]";
				mes "^3131FF在那之前，我希望你幸福，好吗？哥哥会一直守护你，无论以何种方式……^000000";
					next;
					mes "[Setsu]";
				mes "哥哥……那是哥哥的声音！哥哥！";
					next;
					mes "["+strcharinfo(0)+"]";
				mes "咦？什么？哇……";
				mes "我刚才怎么了？我最后记得……";
					next;
				mes "^FF0000泪水从女孩脸上滑落，然后你……^000000";
					next;

}

//Teleport NPC
new_1-3,95,30,4	script	Trainer#nv1::NovHoffman	84,{
	mes "[Hoffman]";
	mes "你好～";
	mes "我来给你";
	mes "一些指导。";
		mes "";
	next;
	mes "[Hoffman]";
	mes "这些怪物都很弱，很容易击杀。";
	mes "但要小心，其中许多都很有攻击性，";
	mes "会向你索取鲜血！";
	mes "";
	mes "";
	next;
	mes "[Hoffman]";
	mes "如果觉得这里的怪物太弱，我可以送你去另一个训练场，那里的怪物更强。";
	next;
	mes "[Hoffman]";
	mes "但不用太担心，";
	mes "初心者也不是无法应付。";
	mes "要试试吗？";
	mes "";
	next;
	switch(select("我想要更多挑战～:我想和强大怪物战斗！:取消")) {
	case 1:
		mes "[Hoffman]";
		mes "我明白了，让我带你去怪物更强的训练场。愿上帝与你同在……";
		mes "";
		next;
		if (strnpcinfo(2) == "nv1") {
			if (rand(2)) {
				warp "new_2-3",96,21;
			}
			else {
				warp "new_3-3",96,21;
			}
		}
		else {
			warp "new_1-3",96,21;
		}	
		end;
	case 2:
		mes "[Hoffman]";
		mes "你一定喜欢";
		mes "艰苦的挑战，";
		mes "对吧？请小心，";
		mes "那里可能会很困难……";
		mes "";
		next;
		if (strnpcinfo(2) == "nv1" || strnpcinfo(2) == "nv2" || strnpcinfo(2) == "nv3") {
			if (rand(2)) {
				warp "new_4-3",96,21;
			}
			else {
				warp "new_5-3",96,21;
			}
		}
		else {
			if (rand(2)) {
				warp "new_2-3",96,21;
			}
			else {
				warp "new_3-3",96,21;
			}
		}
		end;
	case 3:
		mes "[Hoffman]";
		mes "Hmm...?";
		mes "担心前往更具挑战的地方吗？你还是新冒险者，有这种担心很正常。祝你好运～";
		mes "";
		close;
	}
}


				getexp 112,0;
			}
			else if (nov_2nd_cos == 27) {
				set nov_2nd_cos,38;
				getexp 153,0;
			}
			else if (nov_2nd_cos == 28) {
				set nov_2nd_cos,39;
				getexp 200,0;
			}
			else if (nov_2nd_cos == 29) {
				set nov_2nd_cos,40;
				getexp 200,0;
			}
			percentheal 100,0;
			getitem 569,50; //Novice_Potion
			close2;
			warp "new_1-3",96,21;
			end;
		case 2:
			mes "[Muriel]";
			mes "没问题。";
			mes "不确定能否通过测试的话，就再去和左边的助手谈谈。准备好后再回来。";
			close;
		}
	}
	else if (nov_2nd_cos > 30) {
		mes "[Muriel]";
		mes "我提醒过你要小心。振作起来！没什么大不了。";
		mes " ";
		mes "失败是成功之母。";
		mes "你还有很多机会重新参加测试。";
		next;
		mes "[Muriel]";
		mes "你想再试一次吗？";
		next;
		switch(select("是:能给我更多时间吗？")) {

		emotion ET_ANGER;
		next;
		mes "[Biscuit]";
		mes "他们和她说话，但我和她说话时却无视我。";
		mes "我一点也不喜欢他们！！！";
		emotion ET_ANGER;
		next;
	mes "- 和 Devore 博士说的不一样，Biscuit 似乎能流利地说话。-";
		next;
	mes "- 我想最好尽快把这件事告诉 Devore 博士。-";
		close;
	} else if (ma_tomas == 21) {
		mes "[Biscuit]";
		mes "嗯？";
		mes "这是什么？";
		mes "你有什么要告诉我吗？";
		next;
		mes "[Biscuit]";
		mes "嗯，那个家伙经常无视我的话。";
		mes "他说话吞吞吐吐，让我很不舒服。";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "你听见了吗？Devore博士？";
		donpcevent "Linguist Devore#mald::OnEnable";
		next;
		mes "[Linguist Devore]";
		mes "嗯？你是什么意思？";
		mes "我什么都听不见。";
		emotion ET_QUESTION, getnpcid(0, "Linguist Devore#mald");
		next;
		mes "["+strcharinfo(0)+"]";
		mes "咦？ Biscuit said '嗯，那个家伙经常无视我的话。 他说话吞吞吐吐，让我很不舒服。'?";
		next;
		mes "[Linguist Devore]";
		mes "什么？你在说什么？";
		mes "我什么都听不见。";
		emotion ET_QUESTION, getnpcid(0, "Linguist Devore#mald");
		next;
		mes "["+strcharinfo(0)+"]";
		mes "咦？";
		emotion ET_QUESTION, playerattached();
		next;
		mes "[Linguist Devore]";
		mes "啊？！";
		mes "啊？！?!?!?!?!?";
		mes "啊！！！！！！！！！！！！！！！！！！！！！！!!!!!!!!!!!!";
		emotion ET_HUK, getnpcid(0, "Linguist Devore#mald");
		next;
		mes "[Linguist Devore]";
		mes "如果……如果这就是原因！";
		mes "我们可能完全误会了！";
		emotion ET_HUK, getnpcid(0, "Linguist Devore#mald");
		next;
		mes "[Linguist Devore]";
		mes "天啊，我们怎么会知道，我们一直只和自己生活在这里。";
		next;
		mes "[Linguist Devore]";
		mes "每种生物都有自己的听觉和发声范围。但我们和Biscuit处于稍有不同的范围！";
		emotion ET_HUK, getnpcid(0, "Linguist Devore#mald");
		next;
		mes "[Linguist Devore]";
		mes "在这种情况下，我们无法正确听懂任何语言！";
		mes "这不是语言问题，而是声音问题……";
		next;
		mes "[Linguist Devore]";
		mes "呼~呼……尽管研究了多年，我们还是没能发现这个原因……";
		next;
		mes "[Linguist Devore]";
		mes "现在不是做这个的时候！";
		mes "我现在就该改变研究方式。";
		next;
		mes "[Linguist Devore]";
		mes "我会回会议报告这件事。";
		mes "接下来就拜托你了！";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "等等，Devore博士，接下来到底是什么……？";
		mes "我该怎么办……？";
		emotion ET_THINK, playerattached();
		next;
		mes "[Linguist Devore]";
		mes "哈哈哈~你是能和Biscuit交谈的那种人。请试着和他聊聊。";
		mes "不管你和他说什么，都会对我的研究有帮助。";
		next;
		mes "[Biscuit]";
		mes "嘿……别小看我！";
		emotion ET_ANGER;
		donpcevent "Linguist Devore#mald::OnDisable";
		set ma_tomas,22;
		completequest 11228;
		setquest 11229;
		close;
	} else if (ma_tomas == 22 || ma_tomas == 23 || ma_tomas == 24) {
		mes "[Biscuit]";
	mes "……你在看什么……";
		next;
		while(1) {
			switch(select("询问Star Candy。:询问Biscuit。:询问Malangdo。")) {
			case 1:
				mes "[Biscuit]";
				mes "Star Candy？";
				mes "啧啧！";
				mes "不行，真是些卑微的家伙。";
				emotion ET_ANGER;
				next;
				mes "[Biscuit]";
				mes "你应该认出Star Candy之前那种神秘的感觉！";
				mes "她才是真正华丽的那一个。";
				next;
				mes "[Biscuit]";
				mes "她有多华丽呢……嗯……";
				mes "就是华丽。";
				mes "她太华丽了……但我不知道该怎么解释……";
				emotion ET_PROFUSELY_SWEAT;
				next;
				mes "[Biscuit]";
				mes "咳嗯……";
				mes "所以用声音说话的种族很烦人。";
				emotion ET_ANGER;
				next;
				select("用声音说话？");
				mes "[Biscuit]";
				mes "像我们这样高度进化的种族用思维交流，而不是声音。";
				mes "你在脑中思考，想法就会立刻传给别人，大概就是这样？";
				next;
				mes "[Biscuit]";
				mes "在其他地方，这曾被称为超声波或心灵感应。";
				next;
				mes "[Biscuit]";
				mes "所以我们不需要更多解释或华丽辞藻……";
				mes "呜，真让人烦！";
				if (ma_tomas == 22)
					set ma_tomas,23;
				if (ma_tomas == 25)
					close;
				next;
			case 2:
				mes "[Biscuit]";
				mes "我？";
				mes "我是Star Candy的助手，她是海星族中才华横溢的新星！";
				emotion ET_SPARK;
				next;
				mes "[Biscuit]";
				mes "啊，啊……";
				mes "我刚当她助手时，曾被称为天才、帅气助手等等……";
				mes "我感觉一条闪耀的光之道路出现在眼前……";
				next;
				mes "[Biscuit]";
				mes "但要是老人们看到这件事，他们会把我晒干……";
				mes "那是如火焰般的人生……呜呜呜呜";
				emotion ET_CRY;
				if (ma_tomas == 23)
					set ma_tomas,24;
				if (ma_tomas == 25)
					close;
				next;
			case 3:
				mes "[Biscuit]";
				mes "这座岛是华丽的Star Candy休息的地方。";
				mes "表面柔软且内部水分充足，是海星族的最佳栖息地。";
				next;
				mes "[Biscuit]";
				mes "现在，那些猫已经随意占据了这里。";
				mes "问题在于Star Candy太善良了……";
				if (ma_tomas == 24) {
					set ma_tomas,25;
					changequest 11229,11230;
				}
				if (ma_tomas == 25)
					close;
				next;
			}
		}
	} else if (ma_tomas == 25) {
		mes "[Biscuit]";
		mes "嘿，你还没回去吗？";
		mes "有时间的话，弄些果冻给Star Candy吃。";
		next;
		switch(select("好的。:为什么是我？")) {
		case 1:
			mes "[Biscuit]";
			mes "你可以在附近找到果冻。";
			mes "这并不难，你应该在Star Candy用餐前回来！";
			mes "大约30个果冻就够一餐。";
			set ma_tomas,26;
			changequest 11230,11231;
			close;
		case 2:
			mes "[Biscuit]";
			mes "为什么是我？";
			mes "我得忙着照顾她和听不见我声音的猫同伴，所以只能请你帮忙。";
			next;
			mes "[Biscuit]";
			mes "真没礼貌……";
			emotion ET_ANGER;
			next;
			mes "[Biscuit]";
			mes "你不是我的下属，我不能强迫你。但如果Star Candy不能按时用餐，你要记住这座岛会彻底崩溃。";
			next;
			mes "["+strcharinfo(0)+"]";
			mes "...It's not a request, but a threat...";
			emotion ET_THINK, playerattached();
			close;
		}
	} else if (ma_tomas == 26) {
		// Dialogue in repeatable quest is identical.
		// Uses a variable to determine the quest mode.
		set @mal_bob_q,1;
	L_Quest:
		set .@i, @mal_bob_q;
		set @mal_bob_q,0;
		if (countitem(12624) < 30) {
			mes "[Biscuit]";
			mes "完全不够~";
			mes "我至少需要30个美味果冻。";
			close;
		}
		mes "[Biscuit]";
		mes "你拿得很好。";
		mes "准备她的餐食不会有问题。";
		delitem 12624,30; //Delicious_Jelly
		if (.@i == 1) {
			set ma_tomas,27;
			changequest 11231,11232;
		} else {
			erasequest 11244;
			setquest 11245;
			getitem 6422,5; //Egrade_Coin
		}
		next;
		mes "[Biscuit]";
		mes "果冻看起来很奇怪，但味道很好……";
		mes "Star Candy似乎也很喜欢。";
		next;
		mes "[Biscuit]";
		mes "Star Candy，吃饭了~";
		mes "呃，你为什么不吃？";
		mes "你没胃口吗？";
		close;
	} else if (ma_tomas == 27) {
		mes "[Biscuit]";
		mes "呼……你没胃口也是自然的……";
		next;
		mes "[Biscuit]";
		mes "珍贵的Star Candy怎么会这样支撑着地下室的地面？明明在岛的地下洞穴里，却这么干燥！";
		next;
		mes "[Biscuit]";
		mes "而且那个滑溜溜的东西一直困扰Star Candy。";
		mes "你无法避免压力。";
		next;
		select("滑溜溜的东西？");
		mes "[Biscuit]";
		mes "嗯？那是什么东西？";
		mes "就是那个滑溜溜的东西。";
		mes "它长得很丑，一直让Star Candy烦恼。";
		next;
		mes "[Biscuit]";
		mes "它尤其会在今天这样的暴风雨天来到岛上。我在这里躲了一会儿。那些猫来过后，她就变成这样了。";
		next;
		mes "[Biscuit]";
		mes "都是因为Star Candy，她的皮肤……";
		mes "......";
		next;
		mes "[Biscuit]";
		mes "哇啊啊啊！";
		mes "这是什么！！！";
		mes "她的皮肤！！！！!";
		mes "她原本像宝石一样闪亮的皮肤上长了脓肿！！！！!";
		emotion ET_HUK;
		next;
		mes "[Biscuit]";
		mes "她来到这里后，干燥的皮肤出了问题！";
		mes "对我们海星族来说，缺水会导致可怕的后果，甚至死亡！";
		next;
		mes "[Biscuit]";
		mes "啊，啊！她太善良了，竟牺牲自己来拯救这种东西。呜呜。";
		emotion ET_CRY;
		next;
		mes "[Biscuit]";
		mes "啊，啊……";
		mes "我不能离开去照顾她，有没有人来帮忙~";
		next;
		mes "[Biscuit]";
		mes "有没有人来帮帮帮帮帮~";
		next;
		mes "[Biscuit]";
		mes "嘿，你……";
		mes "我这样请求，你还要无视我站在那里吗？";
		next;
		select("我来帮忙。:没办法，我来帮忙。:我承认这是我的命运，所以我会帮忙。:为了Star Candy，我什么都愿意做。");
		mes "[Biscuit]";
		mes "态度不错！";
		mes "呼呼~";
		next;
		mes "[Biscuit]";
		mes "那么请找一把刷子给她清洁，再找一个篮子把水运来。";
		mes "也许它们堆在仓库里。";
		set ma_tomas,28;
		changequest 11232,11233;
		close;
	} else if (ma_tomas == 28) {
		if (countitem(6433) && countitem(6432)) {
			mes "[Biscuit]";
			mes "哦！";
			mes "你成功带来了工具。";
			mes "现在可以沿逆时针方向清洗干燥的皮肤了！";
			mes "没错，从她的左腿开始……！";
			set ma_tomas,29;
			changequest 11233,11234;
			close;
		} else if (countitem(6433) && countitem(6431)) {
			mes "[Biscuit]";
			mes "哦！";
			mes "你成功带来了工具。";
			mes "现在可以从外面取海水了。";
			next;
			mes "[Biscuit]";
			mes "我记得Malangdo东边有个一流地点。";
			mes "不能用这个洞穴里收集的水清洗她！";
			next;
			mes "[Biscuit]";
			mes "水很重，搬运时小心别洒了。";
			close;
		} else {
			mes "[Biscuit]";
			mes "嗯……没有合适的工具会很困难……";
			mes "不过对我这样的小个子来说没关系。";
			next;
			mes "[Biscuit]";
			mes "Star Candy这么巨大的皮肤上，长满了藤壶、牡蛎和贻贝！！！";
			emotion ET_HUK;
			close;
		}
	} else if (ma_tomas < 33) {
		mes "[Biscuit]";
		mes "哦！";
		mes "你成功带来了工具。";
		mes "现在可以沿逆时针方向清洗干燥的皮肤了！";
		mes "没错，从她的左腿开始……！";
		close;
	} else if (ma_tomas == 33) {
		if (checkweight(1201,1) == 0) {
			mes " - Notice !! -";
		mes "- 你携带的物品太多，无法取得物品。-";
		mes "- 减轻负重后再试一次。-";
		mes "";
		mes "";
			close;
		}
		if (MaxWeight - Weight < 1000) {
			mes " - Notice !! -";
		mes "- 你携带的物品太重，无法取得物品。-";
		mes "- 减轻负重后再试一次。-";
		mes "";
		mes "";
			close;
		}
		mes "[Biscuit]";
		mes "做得好！";
		mes "现在我看到她美丽的脸恢复了。";
		emotion ET_COOL;
		next;
		mes "[Biscuit]";
		mes "如果不每天清洁，皮肤会变坏。";
		mes "有句话说……清洁皮肤比化妆重要得多。";
		emotion ET_BEST;
		next;
		mes "[Biscuit]";
		mes "你做得很好。";
		mes "即使我这样突然请求，你还是帮助了我……";
		mes "老实说，我以为你会直接离开。";
		next;
		mes "[Biscuit]";
		mes "这算是一种奖励。替我向Dvor博士……或Devore，不管那只猫叫什么，转达我的话。";
		next;
		mes "[Biscuit]";
		mes "没必要等研究结束。我们可以通过你交流，最好谈谈当前情况……";
		next;
		mes "[Biscuit]";
		mes "这不是为了你……也不是为了你们所有人。这是为了让Star Candy尽快休息，你知道的！";
		emotion ET_HNG;
		set ma_tomas,34;
		erasequest 11235;
		setquest 11236;
		getitem 6422,100; //Egrade_Coin
		getitem 12636,20; //Malang_Sp_Can
		close;
	} else if (ma_tomas > 99) {
		if (checkquest(11244) > -1) {
			set @mal_bob_q,2;
			goto L_Quest;
		} else if (checkquest(11245,PLAYTIME) == 0 || checkquest(11245,PLAYTIME) == 1) {
			mes "[Biscuit]";
			mes "需要你时我会叫你，不用担心！";
			close;
		} else {
			if (checkquest(11245,PLAYTIME) == 2)
				erasequest 11245;
			mes "[Biscuit]";
			mes "Star Candy该用餐了。";
			mes "弄些果冻。";
			next;
			switch(select("我来帮忙。:我不帮了。")) {
			case 1:
				mes "[Biscuit]";
				mes "你可以在附近找到果冻。";
				mes "这并不难，你应该在Star Candy用餐前回来！";
				mes "一餐大约30个果冻就够了。";
				setquest 11244;
				close;
			case 2:
				mes "[Biscuit]";
				mes "什么，你是说要让我们的Star Candy挨饿？！";
				close;
			}
		}
	}
	mes "[Biscuit]";
	mes "Star Candy真的很棒。";
	mes "即使站立如此困难，她也从不失去笑容……";
	close;
}

mal_in02,102,94,3	script	Cleaning Staff#mal	544,2,2,{
OnTouch:
	if (checkweight(1201,1) == 0) {
		mes " - Notice !! -";
		mes "- 你携带的物品太多 -";
		mes "- 无法取得物品。-";
		mes "- 减轻负重 -";
		mes "- 后再试一次。-";
		close;
	}
	if (MaxWeight - Weight < 1000) {
		mes " - Notice !! -";
		mes "- 你携带的物品太重 -";
		mes "- 无法取得物品。-";
		mes "- 减轻负重 -";
		mes "- 后再试一次。-";
		close;
	}
	mes "[Cleaning Staff]";
	mes "都是你的。这里有各种清洁工具。";
	next;
	switch(select("水桶:清洁刷:停止。")) {
	case 1:
		mes "[Cleaning Staff]";
		mes "你是说水桶！";
		mes "给你~";
		next;
		mes "[Cleaning Staff]";
		mes "请把清洁工具还给任意商人。";
		mes "谢谢你来~";
		getitem 6431,1; //Bucket
		close;
	case 2:
		mes "[Cleaning Staff]";
		mes "你是说清洁刷！";
		mes "给你~";
		next;
		mes "[Cleaning Staff]";
		mes "请把清洁工具还给任意商人。";
		mes "谢谢你来~";
		getitem 6433,1; //Clean_Brush
		close;
	case 3:
		mes "[Cleaning Staff]";
		mes "谢谢你来~";
		close;
	}
	close;
}

malangdo,246,184,0	script	1st Rate Point	111,{
	if (checkweight(1201,1) == 0) {
		mes " - Notice !! -";
		mes "- 你携带的物品太多，无法取得物品。-";
		mes "- 减轻负重后再试一次。-";
		mes "";
		mes "";
		close;
	}
	if (MaxWeight - Weight < 1000) {
		mes " - Notice !! -";
		mes "- 你携带的物品太重，无法取得物品。-";
		mes "- 减轻负重后再试一次。-";
		mes "";
		mes "";
		close;
	}
	if (countitem(6431) == 0) {
		mes "- To get water -";
	mes "- 你需要一个 ^0000FF水桶^000000。-";
		close;
	}
	mes "- The water seems so pure. -";
	next;
	switch(select("取水。:停止。")) {
	case 1:
		mes "- The bucket gets remarkably -";

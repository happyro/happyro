//===== rAthena Script =======================================
//= Hypnotist
//===== By: ==================================================
//= Euphy
//===== Current Version: =====================================
//= 1.1
//===== Compatible With: =====================================
//= rAthena Project
//===== Description: =========================================
//= [Official Conversion]
//= Stat and skill resetter for expanded first class under
//= base level 50 and normal first class.
//===== Additional Comments: =================================
//= 1.0 First version, Renewal script.
//= 1.1 Added Izlude duplicates. [Euphy]
//============================================================

// Main NPC :: resetskill_novice
//============================================================
izlude,127,175,3	script	Hypnotist#novice	124,{
	mes "[催眠师]";
	mes "你好，冒险者。";
	mes "我是催眠师学院的成员，";
	mes "被派到伊兹鲁德";
	mes "为特定一转职业角色提供技能重置服务，";
	mes "价格非常优惠：免费！";
	next;
	mes "[催眠师]";
	mes "虽然目前提供无限次";
	mes "属性/技能重置，但有";
	mes "两个条件必须满足。首先，";
	mes "你必须低于";
	mes "^FF0000基础等级 50^000000。";
	next;
	mes "[催眠师]";
	mes "其次，你必须是";
	mes "^FF0000Swordman, Acolyte, Mage,";
	mes "盗贼、弓箭手、商人、";
	mes "跆拳少年或跆拳少女、";
	mes "神枪手和忍者^000000";
	mes "职业才能符合资格。";
	mes "现在，你有什么问题吗？";
	next;
	switch(select("^FF0000属性/技能重置？:重置属性:重置技能^000000:取消")) {
	case 1:
		mes "[催眠师]";
		mes "属性/技能重置允许冒险者";
		mes "重新分配技能";
		mes "点数，如果对当前技能";
		mes "不满意。";
		next;
		mes "[催眠师]";
		mes "进行属性/技能重置前，";
		mes "进行属性/技能重置前，你必须";
		mes "必须将角色携带物品";
		mes "总重量";
		mes "降为 0。可以把多余物品";
		mes "放进卡普拉仓库。";
		next;
		mes "[催眠师]";
		mes "另外也要";
		mes "移除^FF0000手推车^000000，";
		mes "如果装备了手推车。";
		mes "否则催眠不会";
		mes "生效，甚至会反噬……";
		close;
	case 2:
		set .@str$,"Stat";
	case 3:
		if (.@str$ == "")
			set .@str$,"Skill";
		mes "[催眠师]";
		mes "确定要";
		mes "继续使用我的";
		mes "要使用我的 ^FF0000"+.@str$+" 重置^000000 服务吗？";
		next;
		if(select("是:取消") == 1)
			break;
	case 4:
		mes "[催眠师]";
		mes "谢谢，祝你";
		mes "冒险顺利。";
		mes "旅途平安~";
		close;
	}
	if ((Class >= Job_Swordman && Class <= Job_Thief) || Class == Job_Taekwon || Class == Job_Gunslinger || Class == Job_Ninja) {
		if (checkcart()) {
			mes "[催眠师]";
			mes "哦！请先移除";
			mes "手推车再继续";
			mes "使用"+.@str$+"重置服务。";
			mes "感谢配合~";
			close;
		}
		if (Weight != 0) {
			mes "[催眠师]";
			mes "如果你来使用我的"+.@str$;
			mes "重置服务，请记住";
			mes "只有在携带物品的";
			mes "重置前，必须将携带物品的";
			mes "^FF0000物品栏重量";
			mes "物品栏重量降为 0^000000。";
			next;
			mes "[催眠师]";
			mes "不如先把东西放进";
			mes "卡普拉仓库？这样你就能";
			mes "安全保管所有物品。";
			mes "";
			close;
		}
		if (BaseLevel >= 50 && (Class == Job_Taekwon || Class == Job_Gunslinger || Class == Job_Ninja)) {
			mes "[催眠师]";
			mes "抱歉，基础等级高于";
			mes "50 的角色没有资格使用";
			mes "我提供的";
			mes .@str$+"重置服务。";
			close;
		}
		mes "[催眠师]";
		mes "感谢使用我的";
		mes .@str$+"重新分配服务。祝你";
		mes "冒险顺利，";
		mes "旅途愉快，冒险者。";
		mes "";
		if (.@str$ == "Stat")
			resetstatus;
		else
			resetskill;
		close;
	} else {
		mes "[催眠师]";
		mes "抱歉，你的";
		mes "职业不符合";
		mes "使用我提供的"+.@str$+"重置服务。";
		mes "我只能为以下职业提供"+.@str$+"重置……";
		mes "";
		mes "";
		next;
		mes "[催眠师]";
		mes "^FF0000Swordman, Acolyte,";
		mes "法师、盗贼、弓箭手、";
		mes "商人、跆拳少年、";
		mes "跆拳少女、";
		mes "神枪手和忍者^000000。";
		close;
	}
}
izlude_a,127,175,3	duplicate(Hypnotist#novice)	Hypnotist#novice_a	124
izlude_b,127,175,3	duplicate(Hypnotist#novice)	Hypnotist#novice_b	124
izlude_c,127,175,3	duplicate(Hypnotist#novice)	Hypnotist#novice_c	124
izlude_d,127,175,3	duplicate(Hypnotist#novice)	Hypnotist#novice_d	124

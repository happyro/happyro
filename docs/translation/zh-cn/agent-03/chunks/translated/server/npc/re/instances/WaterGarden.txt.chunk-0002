		mapannounce 'map_ghg$, "最后一个花园已经开放。请前往下一个区域。", bc_map, 0xFFFF99;
		enablenpc instance_npcname("Gardener#ghg_gb");
		end;
	}
	end;
}

// (daily quest)
1@ghg,346,248,3	script(DISABLED)	Gardener#keeper1	4_EP17_SCISSORE,{
	if (isbegin_quest(16435) == 1) {
		if (checkweight(1000099,1) == 0) {	// (custom)
			mes "^008800请稍等！！";
			mes "你携带的物品太多，无法再领取物品。减轻负重后再试。^000000";
			close;
		}
		if (countitem(1000099) == 0) {
		npctalk "哦，我忘了定期联系！我这就联系。你在这里要吃块饼干吗？", "", bc_self;
			getitem 1000099,1;
			end;
		}
		npctalk "别担心，我已经联系过阿尔法了。嘿嘿。", "", bc_self;
		end;
	}
	if ('water_garden == 7) {
		npctalk "That's strange, I forgot it yesterday, but I forgot it today as well.";
		end;
	}
	npctalk "最后一个花园开放了。但是……我忘了接下来该做什么……";
	end;
}

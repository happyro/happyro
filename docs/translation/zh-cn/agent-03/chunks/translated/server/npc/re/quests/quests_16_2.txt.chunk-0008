		mes "这场骚乱可能还会持续一阵子，如果你能留下来帮助我们，我们会很高兴～";
		close3;
	case 4:
		mes "[Rookie]";
		mes "Werner 为什么要那样做？";
		mes "我不明白。";
		mes "……不。试图理解疯子可能本身就很奇怪。";
		next;
		mes "[Rookie]";
		mes "总之，我们必须观察中央房间的核心。";
		mes "只要里面还有魔法，同样的事情就会再次发生。";
		close3;
	}
	switch( checkquest(7743,PLAYTIME) ) {
	case -1:
		switch( checkquest(7742,HUNTING) ) {
		case -1:
			mes "[Rookie]";
			mes "欢迎。";
			mes "不再多说，";
			mes "我们想猎杀那个^4d4dff宠物孩子^000000。你愿意加入吗？";
			next;
			if (select( "我是宠物孩子猎人！", "拒绝！" ) == 2) {
				mes "[Rookie]";
				mes "不，为什么？";
				mes "它只是怪物！";
				mes "我们只要杀掉它！";
				mes "那我们应该找谁来做？";
				close;
			}
			mes "[Rookie]";
			mes "让我们揭开它的秘密！";
			mes "找出它为什么不断出现！";
			setquest 7742;// Sweeping the remnants
			close3;
		case 0:
		case 1:
			mes "[Rookie]";
			mes "它在中央房间。就是中央房间中充满奇怪灵体的地方。";
			mes "我先帮你开门。";
			close3;
		case 2:
			mes "[Rookie]";
			mes "太好了！你真酷！";
			mes "这是之前实验对象的复制体吗？自我复制？";
			mes "他们还没找出确切机制。";
			next;
			mes "[Rookie]";
			mes "总之，谢谢你的帮助。";
			mes "下次我们还要依靠你。";
			erasequest 7742;// Sweeping the remnants
			setquest 7743;// Sweeping the remnants (Standby)
			getitem 25155,3;	// Swz_Honor_Token
			getexp 200000,200000;
			close3;
		}
		end;
	case 0:
	case 1:
		mes "[Rookie]";
		mes "同一个怪物每天都会再生。难道不奇怪吗？";
		next;
		cutin "16loo_02.bmp",2;
		mes "[Rookie]";
		mes "也许这家伙是通过移植 Ymir 之心分裂出的对象之一……";
		next;
		cutin "16loo_01.bmp",2;
		mes "[Rookie]";
		mes "总之，看看那家伙会不会再次出现。";
		mes "真是～有趣。";
		close3;
	case 2:
		erasequest 7743;// Sweeping the remnants (Standby)
		mes "[Rookie]";
		mes "你叫它宠物孩子？";
		mes "看来他们完全把那家伙交给冒险者了";
		next;
		mes "[Rookie]";
		mes "想做的话随时告诉我。";
		mes "我会给你猎杀宠物孩子的任务。";
		close3;
	}
	end;

OnInit:
	questinfo( QTYPE_QUEST, QMARK_NONE, "checkquest(7742,HUNTING) == 2" );
	questinfo( QTYPE_QUEST, QMARK_NONE, "terra_gloria_main > 24 && (checkquest(7743,PLAYTIME) == -1 || checkquest(7743,PLAYTIME) == 2) && (checkquest(7742,HUNTING) == -1 || checkquest(7742,HUNTING) == 2)" );
	end;
}

que_swat,141,57,5	script	Rebellion squadder#ep16	4_M_GUNSLINGER2,{
	mes "[Rebellion squadder]";
	mes "你要我把你送出行动区域吗？";
	next;
	if (select( "离开。", "不。" ) == 2) {
		mes "[Rebellion squadder]";
		mes "好，祝你好运。";
		close;
	}
	warp "ein_fild04",279,339;
	end;
}

que_swat,145,57,3	script	Philopontess#ep162_04	4_M_PHILOFONTES,{
	if (checkweight(501,1) == 0) {
		mes "- 由于携带的物品太多，无法继续任务。-";
		close;
	}
	if (terra_gloria_main < 24) {
		cutin "ep16_tes01.bmp",2;
		mes "[Tess]";
		mes "……施瓦尔茨瓦尔德还有多少这样的设施？";
		mes "哈……";
		close3;
	}
	if (terra_gloria_main == 24) {
		cutin "ep16_tes01.bmp",2;
		mes "[Tess]";
		mes "幸运的是，信似乎送到了。";
		mes "我们准备了奖励但还没交给你，所以寄信邀请你来。";
		next;
		mes "[Tess]";
		mes "而且总统说，如果你继续帮我们清除不需要的实验对象，阁下会给你足够的补偿。";
		next;
		mes "[Tess]";
		mes "因为你帮助了我们的共和国，阁下正设法给你准备冒险者有用的东西。";
		next;
		mes "[Tess]";
		mes "我将给你的^4d4dff施瓦茨荣誉代币^000000也是叛乱军使用的奖励货币。";
		next;
		mes "[Tess]";
		mes "你是冒险者，我们想它会对你有帮助。";
		mes "你可以用它兑换需要的物品。";
		next;
		mes "[Tess]";
		mes "你可能已经通过叛乱军获得过它。";
		mes "因为这个代币是为施瓦尔茨瓦尔德完成任务者准备的奖品……";
		next;
		mes "[Tess]";
		mes "如果你愿意继续帮助我们，就能获得更多。";
		next;
		mes "[Tess]";
		mes "所以，我们想给你一些简单的请求或任务。";
		mes "这种合作可能会持续一段时间。";
		next;
		mes "[Tess]";
		mes "提前感谢你的支持。";
		getitem 25155,10;	// Swz_Honor_Token
		getexp 500000,500000;
		terra_gloria_main = 25;
		questinfo_refresh();
		close2;
		cutin "",255;
		npctalk "哦，请到这里来一下。", "Rookie#ep162_03", bc_self;
		end;
	}
	switch( checkquest(7745,PLAYTIME) ) {
	case -1:
		switch( isbegin_quest(7744) ) {
		case 0:
			cutin "ep16_tes01.bmp",2;
			mes "[Tess]";
			mes "由于实验室里仍藏着一些研究员，我们计划进行调查。";
			next;
			mes "[Tess]";
			mes "请负责这次调查。";
			mes "如果你为我们完成，我们会给你施瓦茨荣誉代币。";
			next;
			if (select( "接受。", "拒绝。" ) == 2) {
				mes "[Tess]";
				mes "现在不行吗？";
				mes "那就休息一下再回来。";
				close3;
			}
			mes "[Tess]";
			mes "因为我们不知道他们藏在哪里，请从柜子和箱子等角落开始寻找。";
			next;
			mes "[Tess]";
			mes "找到研究员后，请把他们交给附近的叛乱军成员。";
			mes "提前感谢你的支持。";
			setquest 7744;// Hiding Researcher
			close3;
		case 1:
		case 2:
			break;
		}
		switch( isbegin_quest(7760) ) {
		case 0:
			cutin "ep16_tes01.bmp",2;
			mes "[Tess]";
			mes "实验室里仍有一些研究员藏在某处。";
			mes "请找到他们并交给叛乱军成员。";
			next;
			mes "[Tess]";
			mes "提前感谢你的支持。";
			close3;
		case 1:
		case 2:
			mes "[Tess]";
			mes "我们已经从叛乱军听说了你的表现。";
			mes "谢谢你与共和国合作。";
			setquest 7745;		// Hiding Researcher (Standby)
			erasequest 7760;	// Well hidden
			erasequest 7744;	// Hiding Researcher
			getitem 25155,3;	// Swz_Honor_Token
			getexp 200000,200000;
			next;
			mes "[Tess]";
			mes "我们突然袭击了他们，预计还有更多人藏着。但迟早会找到他们。";
			close;
		}
	case 0:
	case 1:
		cutin "ep16_tes01.bmp",2;
		mes "[Tess]";
		mes "我们突然袭击了他们，预计还有更多人藏着。";
		mes "现在我们会努力寻找那些人。";
		close2;
		npctalk "这真的很艰难。", "", bc_self;
		cutin "",255;
		end;
	case 2:
		erasequest 7745;// Hiding Researcher (Standby)
		cutin "ep16_tes01.bmp",2;
		mes "[Tess]";
		mes "如果可以，我想请你再次调查。";
		next;
		if (select( "交给我吧。", "不用了，谢谢。" ) == 2) {
			mes "[Tess]";
			mes "……";
			mes "那我们承担不起。";
			mes "... No, no.";
			close3;
		}
		mes "[Tess]";
		mes "你一如既往地很酷。";
		mes "那么请你找出藏在实验室深处、抖得像树叶一样的人渣？";
		mes "我是说，研究员。";
		next;
		mes "[Tess]";
		mes "和往常一样，请找到藏起来的研究员并交给叛乱军成员。";
		setquest 7744;// Hiding Researcher
		close3;
	}
	end;

OnInit:
	questinfo( QTYPE_QUEST, QMARK_NONE, "terra_gloria_main == 24" );
	questinfo( QTYPE_QUEST, QMARK_NONE, "terra_gloria_main > 24 && isbegin_quest(7744) == 0 && (checkquest(7745,PLAYTIME) == -1 || checkquest(7745,PLAYTIME) == 2)" );
	questinfo( QTYPE_QUEST, QMARK_NONE, "isbegin_quest(7760) > 0" );
	end;
}

que_swat,159,53,5	script	Yudmil#ep162_2	4_M_GUNSLINGER2,{
	mes "[Yudmil]";
	mes "不……我为什么要自愿来这里？";
	next;
	select("枪手怎么了？");
	mes "[Yudmil]";
	mes "枪手是叛乱军为培养下一代建立的地方，所以两者关系密切。";
	next;
	mes "[Yudmil]";
	mes "我听说这里有叛乱军的特别训练，所以自愿来了。可我现在在做什么？";
	mes "我从没想过会被送到这座充满怪物的实验室！";
	next;
	mes "[Yudmil]";
	mes "啊，尤其是 Elena 小姐……她让我们吃尽苦头……";
	close;
}

que_swat,161,53,3	script	Yuslan#ep162_1	4_M_GUNSLINGER3,{
	if (checkweight(501,1) == 0) {
		mes "- 由于携带的物品太多，无法继续任务。-";
		close;
	}
	if (terra_gloria_main < 20)
		end;
	switch( checkquest(7762,PLAYTIME) ) {
	case -1:
		switch( checkquest(7761,HUNTING) ) {
		case -1:
			mes "[Yuslan]";
			mes "实验室里逃脱的实验对象造成了一片混乱。";
			mes "即使我们杀掉它们，还是会有更多从某处出现。我出来休息一会儿。";
			next;
			if (select( "帮助他击败奇美拉。", "祝他好运。" ) == 2) {
				mes "[Yuslan]";
				mes "嗯……是的。这也是训练的一部分。呼。";
				close;
			}
			mes "[Yuslan]";
			mes "那么，请分别猎杀 10 只";
			mes "^4d4dffMaterial type Chimeras^000000 and";
			mes "^4d4dffHuman type Chimeras^000000";
			mes "在实验室里游荡的怪物！";
			next;
			mes "[Yuslan]";
			mes "多亏你的帮助，我们可以喘口气了！";
			mes "振作起来，冒险者！";
			setquest 7761;// Make Chimeras rest in peace
			close;
		case 0:
		case 1:
			mes "[Yuslan]";
			mes "只需分别击败 10 只。我只要求这些。";
			mes "它们是^4d4dff材料型奇美拉和人型奇美拉。^000000";
			next;
			mes "[Yuslan]";
			mes "... The In Vivo Experiment is really horrible.";
			close;
		case 2:
			mes "[Yuslan]";
			mes "哇，你为我们做得太好了！";
			mes "谢谢。";
			mes "多亏你的帮助，我们得以好好休息。";
			next;
			mes "[Yuslan]";
			mes "下次也请和我们一起！";
			erasequest 7761;// Make Chimeras rest in peace
			setquest 7762;// Make Chimeras rest in peace (Standby)
			getitem 25155,3;	// Swz_Honor_Token
			getexp 300000,300000;
			close;
		}
	case 0:
	case 1:
		mes "[Yuslan]";
		mes "嘿，谢谢你出色的工作。";
		mes "但里面还有更多怪物。";
		mes "我们正在尽力消灭它们。但说实话，这很困难。";
		next;
		mes "[Yuslan]";
		mes "这些实验对象到底从哪里来？";
		close;
	case 2:
		erasequest 7762;// Make Chimeras rest in peace (Standby)
		mes "[Yuslan]";
		mes "它们不断出现。我无法想象他们进行了多少实验。";
		mes "我是说，奇美拉。";
		next;
		mes "[Yuslan]";
		mes "我从没想过奇美拉会比心脏猎手更强……";
		close;
	}
	end;

OnInit:
	questinfo( QTYPE_QUEST, QMARK_NONE, "terra_gloria_main > 19 && (checkquest(7761,HUNTING) == -1 || checkquest(7761,HUNTING) == 2) && (checkquest(7762,PLAYTIME) == -1 || checkquest(7762,PLAYTIME) == 2)" );
	end;
}

// Part Elena - Fight
rebel_in,70,78,3	script	Elena Volkova#16.2rm	4_F_ELENA,{
	if (terra_gloria_main < 16) {
		cutin "162elena_01.bmp",2;
		mes "[USU commander Elena]";
		mes "别鲁莽地和 USU 发生冲突。";
		mes "人们一开始打架，最后烦恼的只有我。";
		next;
		emotion ET_FRET;
		mes "[USU commander Elena]";
		mes "虽然我给它们拴了绳，它们还是一直想逃出去……";
		mes "也许它们脑子里装满了火药。真是愚蠢的怪人。";
		close3;
	}

	// twins daily quest
	if (isbegin_quest(16031) == 1) {
		cutin "162elena_01.bmp",2;
		mes "[USU commander Elena]";
		mes "饼干？我不喜欢甜食。";
		next;
		mes "[USU commander Elena]";
		mes "Lebedev 那帮人烤的……";
		mes "那我只能尝尝了。给我。";
		next;
		if (countitem(25161) < 1) {
			mes "[USU commander Elena]";
			mes "...Why are you empty-handed? Where is the cookie?";
			close3;
		}
		emotion ET_DELIGHT;
		mes "[USU commander Elena]";
		mes "闻起来不错。";
		mes "看来他们费了很大功夫。替我谢谢他们。";
		completequest 16031;// Service: Cookies delivery
		delitem 25161,1;// Handmade_cookie2
		close3;
	}

	if (terra_gloria_main == 16 && isbegin_quest(14602) == 1) {
		switch( isbegin_quest(16060) ) {
		case 0:
			cutin "162elena_01.bmp",2;
			mes "[USU commander Elena]";
			mes "等等，你是谁？";
			next;
			mes "[USU commander Elena]";
			mes "我以前没见过你。";
			mes "你不能在这里。像你这样的陌生人不该出现在这里。";
			mes "^FF0000>>>Snap<<<^000000";
			next;
			mes "[USU commander Elena]";
			mes "准确告诉我你怎么来到这里、来自哪里，除非你想死。";
			sleep2 300;
		npctalk "Elena Volkova：否则我会玩得很开心，而你不会。", "", bc_self;
			next;
			cutin "",255;
			mes "[" + strcharinfo(0) + "]";
			mes "我……你表明自己是来帮助秘密之翼，并请求与叛乱军合作的冒险者。";
			next;
			cutin "162elena_01.bmp",2;
			mes "[USU commander Elena]";
			mes "秘密之翼？他们只是新手。只会讨好总统。";
			mes "你真勇敢。谁让你来找我的？";
			mes "我不想陪着扑扇翅膀的小鸡跳舞。快走开。";
			next;
			cutin "",255;
			mes "[" + strcharinfo(0) + "]";
			mes "不，请等一下。其实我……不，是我的同伴……";
			next;
			cutin "162elena_01.bmp",2;
			mes "[USU commander Elena]";
			mes "你的同伴救了 Gonie？";
			mes "...... So? You want a reward?";
			mes "我真的讨厌那些随意利用他人生命的人。";
			next;
			mes "[USU commander Elena]";
			mes "好吧……我有个更好的主意。";
			mes "和楼下聊天的弱者不同，你看起来很有趣。";
			next;
			cutin "162elena_02.bmp",2;
			mes "[USU commander Elena]";
			mes "你说自己只是冒险者，对吧？";
			mes "很好。如果你在战斗中击败我，我就听你的故事。";
			next;
			cutin "",255;
			mes "[" + strcharinfo(0) + "]";
			mes "什么？";
			next;
			cutin "162elena_01.bmp",2;
			mes "[USU commander Elena]";
			mes "来战斗吧！我会听战胜我的人说话。";
			mes "准备好后和我说。然后我会让你进入竞技场候场室。";
			next;
			cutin "",255;
			mes "[" + strcharinfo(0) + "]";
			mes "要我突然和你战斗吗？嗯，我不太想……";
			next;
			cutin "162elena_01.bmp",2;
			emotion ET_HNG;
			mes "[USU commander Elena]";
			mes "如果你不想战斗，我想你也不需要合作。回去吧。";
			next;
			cutin "",255;
			mes "[" + strcharinfo(0) + "]";
			mes "(I'm in trouble. What shall I do?)";
			next;
			if (select( "与 Elena 战斗。", "我不听比我弱的人说话。" ) == 1) {
				mes "[" + strcharinfo(0) + "]";
				mes "(I have no choice. Let's prepare for the fight and talk to Elena Volkova again.)";
				setquest 16060;	// Fighting is the language of warmonger
				setquest 16061;	// Fair and equitable result
				close3;
			}
			mes "[" + strcharinfo(0) + "]";
			mes "我不听比我弱的人……";
			next;
			cutin "162elena_01.bmp",2;
			emotion ET_SMILE;
			mes "[USU commander Elena]";
			mes "嗯？我听错了什么。哈哈，能再说一遍吗？";
		npctalk "Elena Volkova：嗯，应该只是几只狗在叫。", "", bc_self;
			next;
			cutin "",255;
			mes "[" + strcharinfo(0) + "]";
			mes "好……我来做。";
			next;
			cutin "162elena_02.bmp",2;
			mes "[USU commander Elena]";
			mes "很好。准备好后告诉我。";
			setquest 16060;	// Fighting is the language of warmonger
			setquest 16061;	// Fair and equitable result
			close3;
		case 1:
		case 2:
			switch( isbegin_quest(16011) ) {
			case 0:
				cutin "162elena_01.bmp",2;
				mes "[USU commander Elena]";
				mes "准备好了吗？";
				mes "现在去候场室吗？";
				next;
				switch( select( "去候场室", "不去候场室。" ) ) {
				case 1:
					if (BaseJob != Job_Priest) {
						mes "[USU commander Elena]";
						mes "候场室里有负责竞技场入口的^0000CDIvan^000000。";
						mes "按照 Ivan 的指引顺序进入竞技场。";
						next;

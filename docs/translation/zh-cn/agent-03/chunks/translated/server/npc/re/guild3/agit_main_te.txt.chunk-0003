			2452, 186,129,
			2455, 185,129,
			2452, 185,130,
			2455, 185,131,
			2452, 185,132,
			2455, 185,133;
	}
	else if (.@map$ == "te_prtcas04") {
		setarray .@data[0],
			2452, 269,162,// TREASURE_BOX_TE
			2456, 270,162,// TREASURE_BOX_TE_4
			2452, 270,161,
			2456, 269,161,
			2452, 267,164,
			2456, 268,164,
			2452, 269,164,
			2456, 270,164,
			2452, 271,164,
			2456, 272,164,
			2452, 272,163,
			2456, 272,162,
			2452, 272,161,
			2456, 272,160,
			2452, 272,159,
			2456, 271,159,
			2452, 270,159,
			2456, 269,159,
			2452, 268,159,
			2456, 267,159,
			2452, 267,160,
			2456, 267,161,
			2452, 267,162,
			2456, 267,163;
	}
	else if (.@map$ == "te_prtcas05") {
		setarray .@data[0],
			2452, 275,178,// TREASURE_BOX_TE
			2457, 276,178,// TREASURE_BOX_TE_5
			2452, 276,177,
			2457, 275,177,
			2452, 273,180,
			2457, 274,180,
			2452, 275,180,
			2457, 276,180,
			2452, 277,180,
			2457, 278,180,
			2452, 278,179,
			2457, 278,178,
			2452, 278,177,
			2457, 278,176,
			2452, 278,175,
			2457, 277,175,
			2452, 276,175,
			2457, 275,175,
			2452, 274,175,
			2457, 273,175,
			2452, 273,176,
			2457, 273,177,
			2452, 273,178,
			2457, 273,179;
	}
	.@treasure_num = ( 4 + ( .@economy /5 ) ) *3;// x3 <-> data[] size
	for ( .@i = 0; .@i < getarraysize(.@data) && .@treasure_num > .@i; .@i += 3 )// nb. [4;24] chests
		monster .@map$, .@data[.@i+1], .@data[.@i+2],"Treasure Chest", .@data[.@i],1, strnpcinfo(0)+"::OnTreasureDied";

OnTreasureDied:
	end;
}

// Flag warp Template
//============================================================
function	script	F_flag_woe_TE	{
	.@castle$ = getarg(1);
	.@guild_id = getcastledata( .@castle$,CD_GUILD_ID );
	if (.@guild_id == 0) {
		mes "[神圣卢恩-米德加兹王国敕令]";
		mes " ";
		mes "1.根据神圣卢恩-米德加兹王国法令，";
		mes "我们宣布";
		mes "此城堡目前没有正式主人。";
		mes " ";
		mes "2.能够";
		mes "克服所有考验";
		mes "并摧毁宝珠的人，";
		mes "国王将把";
		mes "此城堡的所有权赐予他。";
		close;
	}
	if (.@guild_id == getcharid(2) && getarg(0)) {
		mes "[回荡的声音]";
		mes "勇敢的人啊……";
		mes "你想回到荣耀之地吗？";
		next;
		if (select( "返回公会城堡。","退出。" ) == 1) {
			if (jobcanentermap(.@castle$) == 0) {
				mes "三转职业和扩展等级角色不能参加训练攻城战。";
				close;
			}
			if (getcastledata( getarg(1),CD_GUILD_ID ) == getcharid(2))
				warp getarg(1),getarg(2),getarg(3);
			end;
		}
	}
	.@guildname$ = getguildname(.@guild_id);
	.@guildmaster$ = getguildmaster(.@guild_id);
	mes "[神圣卢恩-米德加兹王国敕令]";
	mes " ";
	mes "1.根据神圣卢恩-米德加兹王国法令，";
	mes "我们批准此地归";
	mes "^ff0000"+.@guildname$+"^000000公会所有。";
	mes " ";
	mes "2.^ff0000"+.@guildname$+"^000000公会的会长是";
	mes "^ff0000"+.@guildmaster$+"^000000";
	mes "若有人对此表示异议，";
	mes "就用手中的钢刃证明力量与荣耀。";
	close;
}

-	script	simple_info_TE	-1,{
	callfunc( "F_flag_woe_TE",0,strnpcinfo(4) );
OnInit:
	if (strnpcinfo(4) != "")
		flagemblem getcastledata( strnpcinfo(4),CD_GUILD_ID );
	end;
}

-	script	flag_te	GUILD_FLAG,{
	end;
OnInit:
	if (strnpcinfo(2) != "")
		flagemblem getcastledata( strnpcinfo(2),CD_GUILD_ID );
	end;
}


// GM NPC
//============================================================
prt_gld,1,4,0	script	#Enterance Button prt	CLEAR_NPC,{
	mes "密码";
	next;
	if ( callfunc( "F_GM_NPC", 1854,0, 0,9000 ) < 1 ) {
		mes "不正确。";
		close;
	}
	mes "要如何处理通往格洛丽亚的传送？";
	next;
	switch( select( "开启","关闭","取消","领取租赁物品" ) ) {
	case 1:
		mes "正在开启传送。";
		enablenpc "to_gloria";
		close;
	case 2:
		mes "正在关闭传送。";
		disablenpc "to_gloria";
		close;
	case 3:
		end;
	case 4:
		mes "你有300秒。";
		rentitem 13083,300;// TE_Woe_Knife
		close;
	}
}


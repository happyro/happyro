	}
}

// God Item Hervor & Jormungand
sec_in02,20,20,0	script	Test Guide	CLEAR_NPC,{
	mes "密码？";
	next;
	if (callfunc( "F_GM_NPC", 18543792,0, 0,99999999 ) < 1) {
		mes "啊……";
		close;
	}
	mes "我们提供测试 TE 所需的材料物品。";
	next;
	switch( select( "赫尔沃材料","耶梦加得材料" ) ) {

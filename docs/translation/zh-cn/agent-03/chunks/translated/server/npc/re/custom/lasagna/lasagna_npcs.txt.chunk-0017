		next;
		mes "[" + strcharinfo(0) + "]";
		mes "不好意思？";
		next;
		mes "[Tartufi]";
		mes "Magchi 以前每天都会赶走从这里经过的蛇怪。没有 Magchi，今天它们又来惹麻烦了。真烦人。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "所以你才会喷火。";
		next;
		mes "[Tartufi]";
		mes "因为这样暂时能把它们赶走。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "港口被烟雾笼罩，船无法出航，所以我来调查。";
		next;
		mes "[Tartufi]";
		mes "出航？你是冒险者吗？我听 Magchi 说发现了新世界，一个无人去过的未知土地。我也想去。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "你现在就可以去。";
		next;
		mes "[Tartufi]";
		mes "不行。爸爸妈妈刚离开不久。我必须留在这里再长大一点。多睡觉、多吃饭，等变得强壮后再去观光。";
		npctalk "爸爸妈妈一遍又一遍地告诉我。", "", bc_self;
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "你都这么大了，还说自己是孩子？";
		next;
		mes "[Tartufi]";
		mes "别叫我小孩子。我才 457 岁。不过和躲在那边某处的爷爷相比，我确实还是孩子。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "爷爷？谁？";
		next;
		mes "[Tartufi]";
		mes "他是^0000cdImoogi^000000，算是蛇怪首领。不过我也不清楚。他总抱怨要不是^0000cd爸爸妈妈，他早就升天了^000000，";
		mes "所以总放蛇怪出来骚扰我。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "我的天。";
		next;
		mes "[Tartufi]";
		mes "哦！蛇怪又朝这边来了。请处理掉它们。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "我该怎么做？";
		next;
		mes "[Tartufi]";
		mes "Magchi 以前使用某种长杆武器，也许那个就行。它们逃走前必须至少处理掉^0000cd 20 只^000000。";
		npctalk "他们每天都这样，看来一点学习能力也没有。", "", bc_self;
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "我捡了些东西，让我试试看。等等。";
		erasequest 14542;// How is the Dragon
		setquest 14543;// Basilisk Hunt
		lasagna_quest[1] = 24;
		close;
	}
	if (lasagna_quest[1] == 24) {
		if (checkquest(14543,HUNTING) != 2) {// Basilisk Hunt
			mes "[Tartufi]";
		mes "它们真是不肯放弃，对吧？你得再努力一点。它们知道你弱，所以还远没结束。展现你的强大吧！";
			next;
			mes "[Tartufi]";
		mes "只要展现强大，它们就会安静一阵子。再努力一点，我会帮你。";
			specialeffect2 EF_HEAL2;
			percentheal 100,100;
			close;
		}
		mes "[Tartufi]";
		mes "他走了吗？应该走了。这应该能让它们安静一阵子。他说自己是新手冒险者，刚开始让我很担心，但看来完成杜拉姆的任务没问题。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "大家都把我当新手蛋壳虫，但我也完成过正规训练课程！";
		next;
		mes "[Tartufi]";
		mes "Magchi 说那是短期强化课程。但那够吗？你在消灭蛇怪时经历了地狱般的训练，所以已经不再是新手。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "哦，是啊。谢谢。";
		next;
		mes "[Tartufi]";
		mes "等他准备好再次到处跑时，Magchi 就会回来了。谢谢你。你说要去新世界冒险？到 Lasagna 后记得偶尔告诉我新世界的事。";
		npctalk "我真的很好奇。", "", bc_self;
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "我会的。那么，再见。";
		next;
		mes "[Tartufi]";
		mes "虽然时间短，但我很高兴你来过。再见。";
		erasequest 14543;// Basilisk Hunt
		setquest 14544;// Now I can leave
		getexp 500,500;
		lasagna_quest[1] = 27;// jump to 27
		close;
	}
	if (lasagna_quest[1] == 27) {
		mes "[Tartufi]";
		mes "Zzz... zzz...";
		close;
	}
}

lasa_dun03,161,292,5	script	Lord Imuk#dorcon	4_NFWISP,{
	if (Class == Job_Summoner)
		end;
	if (lasagna_quest[1] == 24) {
		mes "[" + strcharinfo(0) + "]";
		mes "能与 Imoogi 交流的地方一定就在附近。";
		next;
		mes "[???]";
		mes "你是谁？";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "幽、幽灵？";
		next;
		mes "[???]";
		mes "你竟敢把我当幽灵！我已经活了^0000cd 2500 年^000000！";
		specialeffect2 EF_LIGHTBOLT;
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "哎哟……真疼。如果冒犯了你很抱歉，但你是蛇怪首领 Imoogi 吗？";
		next;
		mes "[Lord Imuk]";
		mes "你的言语和外表一样粗俗。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "Tartufi 也是这么说的。";
		next;
		mes "[Lord Imuk]";
		mes "他年轻无知又愚蠢。我是 Imook，人称^0000cd Imuk 大人^000000。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "Imuk 大人……你说自己活了 2500 年？";
		next;
		mes "[Lord Imuk]";
		mes "是的。我本应^0000cd化为龙并升天^000000。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "升天？是指前往天堂吗？";
		next;
		mes "[Lord Imuk]";
		mes "我只要^0000cd训练 1000 年化为龙，就能升天^000000。可是那个^0000cd小家伙的父母^000000过去两次抢走^0000cd如意珠^000000，反而升天了。";
		next;
		mes "[Lord Imuk]";
		mes "现在那个小家伙把如意珠藏在某处，想等 500 年后寻找升天机会。我要夺回属于我的东西，这是我的正当权利。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "看来如意珠是化龙的必需品。蛇怪骚扰 Tartufi 就是因为这个吗？";
		next;
		mes "[Lord Imuk]";
		mes "^0000cd蛇怪被赋予夺回如意珠的任务^000000。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "Tartufi 受到攻击时会喷火，烟雾笼罩城镇，让人们无法自由通行。";
		next;
		mes "[Lord Imuk]";
		mes "听到这点我很遗憾。但错在那个小家伙。在找回如意珠前，蛇怪不会停止任务。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "嗯……我明白了。也就是说，在得到如意珠前你不会放弃。我会去问 Tartufi 如意珠的事。";
		next;
		mes "[Lord Imuk]";
		mes "谢谢。现在我要继续训练，别来打扰我，走开。";
		erasequest 14551;// Chief Basilisk
		setquest 14552;// Lord Imuk's message
		lasagna_quest[1] = 25;
		close;
	}
	if (lasagna_quest[1] == 25) {// humain
		mes "[Lord Imuk]";
		mes "把如意珠的事告诉那个小家伙。我要继续训练，别来打扰我，走开。";
		close;
	}
}

lasa_dun03,162,158,3	script	Tartufi#dorcon02	4_TARUTUPI,{
	if (Class == Job_Summoner)
		end;
	if (lasagna_quest[1] == 23) {
		mes "[Tartufi]";
		mes "讨厌的苍蝇，讨厌的蚊子，真烦人。我想念爸爸妈妈。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "Tartufi?";
		next;
		mes "[Tartufi]";
		mes "你们今天已经够烦人了。怎么回事？虎击还不够吗？你们是虎纹蛾什么的吗？";
		npctalk "不要烤蛇！", "", bc_self;
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "听着，我不是蛇怪。";
		next;
		mes "[Tartufi]";
		mes "你是谁？你的衣服和长相都很奇怪。Magchi 去哪里了？";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "Magchi 巡逻时受伤回去了。我来自新世界。";
		next;
		mes "[Tartufi]";
		mes "原来如此。你来自新世界。但 Magchi 怎么了？";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "蛇怪暴走时他伤了腿。另一名治安队员带他回去，相信他已经平安返回。";
		next;
		mes "[Tartufi]";
		mes "是吗？那就放心了。但我不知道这些生物怎么了，直到刚才它们都很安静。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "嗯，我刚才正在追赶蛇怪。";
		next;
		mes "[Tartufi]";
		mes "什么？你去追蛇怪？你？";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "呃……是的。抱歉，我不是故意的。";
		next;
		mes "[Tartufi]";
		mes "不，不。我不是说你做错了。但能告诉我更多吗？";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "有人让我找一些罗勒。我听说蛇怪那里能找到，所以一路来这里抓它们。看来这让它们兴奋了。";
		next;
		mes "[Tartufi]";
		mes "原来如此。那你很强吗？你说自己抓到过蛇怪。";
		npctalk "能抓到它们，你一定很强。", "", bc_self;
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "嗯，可以这么说……";
		next;
		mes "[Tartufi]";
		mes "Magchi 只是赶走每天来这里的蛇怪。那就够了，但没有 Magchi，它们又来骚扰我。真烦。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "所以你才会喷火。";
		next;
		mes "[Tartufi]";
		mes "因为这样暂时能赶走它们。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "港口被烟雾笼罩，船无法出航，所以我来调查。";
		next;
		mes "[Tartufi]";
		mes "出航？对了，你说自己来自新世界。能帮个忙吗？请告诉它们的^0000cd首领^000000让它们安静。";
		npctalk "我不想再要了。", "", bc_self;
		next;
		mes "[Tartufi]";
		mes "他叫 Imoogi。我不知道他住在哪里，但那里有^0000cd能与 Imoogi 交流的东西^000000。蛇怪每天早上都会去那里听些什么……";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "我明白了。蛇怪的事很抱歉，我会处理。";
		next;
		mes "[Tartufi]";
		mes "好，回头见。";
		erasequest 14550;// How is the Dragon
		setquest 14551;// Chief Basilisk
		lasagna_quest[1] = 24;
		close;
	}
	if (lasagna_quest[1] == 24) {
		mes "[Tartufi]";
		mes "你和 Imoogi 谈过了吗？他说了什么？还没有？快点。蛇怪太烦人了。";
		close;
	}
	if (lasagna_quest[1] == 25) {
		mes "[Tartufi]";
		mes "你来了。事情怎么样？";
		next;
		mes "[You tell Tartufi about the story of Lord Imuk and Yeouiju.]";
		next;
		mes "[Tartufi]";
		mes "如意珠？那是什么？";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "我不太确定，但那是化龙升天的必需品。";
		next;
		mes "[Tartufi]";
		mes "不管是什么，我都会找。搜索这里需要一些时间。在此期间，你能处理那些蛇怪吗？";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "我会的。要花多久？";
		next;
		mes "[Tartufi]";
		mes "不知道。大概 200 年？";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "200 年？";
		next;
		mes "[Tartufi]";
		mes "想想吧。搜索这里所有东西就要花那么久。而且我连如意珠是什么都不知道。";
		next;
		mes "[Tartufi]";
		mes "总之我会找，你负责处理它们。只限今天。明天也许 Magchi 会来消灭它们。但今天由你来做，听说是因为你。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "好。如果你找到如意珠，请告诉 Imuk 大人。";
		next;
		mes "[Tartufi]";
		mes "我会考虑。我甚至不知道那是什么，不清楚是什么就无法答应你。";
		npctalk "如果是重要东西，我不能给你。", "", bc_self;
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "你说得对。我不能一直等，所以该消灭那些蛇怪了。要处理多少只？";
		next;
		mes "[Tartufi]";
		mes "消灭^0000cd大约 20 只^000000，它们就会因害怕而不敢靠近。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "好。如果你碰巧找到如意珠，请告诉 Imuk 大人。";
		erasequest 14552;// Lord Imuk's message
		setquest 14553;// Basilisk Hunt
		lasagna_quest[1] = 26;
		close;
	}
	if (lasagna_quest[1] == 26) {
		if (checkquest(14553,HUNTING) != 2) {
			mes "[Tartufi]";
			mes "不，还没有。它们还在不断出现。我说还没有。";
			next;
			mes "[Tartufi]";
			mes "你忘了吗？至少要消灭 20 只蛇怪，它们才会安静。";
			close;
		}
		mes "[" + strcharinfo(0) + "]";
		mes "呼，全部处理好了。";
		next;
		mes "[Tartufi]";
		mes "干得好。现在它们应该会安静了。我要查看宝藏，但得先睡觉。我今天醒太久，困了。";
		npctalk "听说要多睡觉才能长大。", "", bc_self;
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "是的。我相信 Imuk 大人也会等。";
		next;
		mes "[Tartufi]";
		mes "好。你要登船，对吧？希望你平安抵达目的地。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "谢谢。我想天气好时就能出航。";
		next;
		mes "[Tartufi]";
		mes "没问题。那么再见。";
		erasequest 14553;// Basilisk Hunt
		setquest 14554;// We can start sail now
		lasagna_quest[1] = 27;
		close;
	}
	if (lasagna_quest[1] == 27) {
		mes "[Tartufi]";
		mes "听说你要登船。不该快点吗？";
		close;
	}
	mes "[Tartufi]";
	mes "呼……呼……";
	close;
}

// recorder quest
lasa_in01,186,57,3	script	Vigilante Chef#dorcon99	4_CAT_CHEF,{
	mes "治安队厨师";
	mes "这里只有治安队员可以用餐。";
	close;
}

lasagna,56,186,0	script	#dorcon96	HIDDEN_WARP_NPC,5,5,{
	end;
OnTouch:
	if (conch_in_recorder == 3)
		warp "lasa_in01",162,61;
	end;
}

lasa_in01,179,60,5	script	Chief Peperoncino#dorco	4_DR_PEPE,{
	if (conch_in_recorder == 3) {
		mes "[" + strcharinfo(0) + "]";
		mes "你好。";
		next;
		mes "[Chief Peperoncino]";
		if (Class != Job_Summoner)
			mes "你来自新世界？新世界的人找我有什么事？";
		else {
			mes "你是我们冒险者俱乐部的 " + strcharinfo(0) + "，对吧？";
			next;
			mes "[" + strcharinfo(0) + "]";
			mes "你还记得我。";
			next;
			mes "[Chief Peperoncino]";
			mes "和我有过交集的人我都记得。";
		}
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "除了寻找新冒险，聆听他人的故事也是冒险者的职责。据我所知，你在拉萨格纳待的时间比大多数人都长。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "大家都建议我向你了解拉萨格纳和蝴蝶治安队的故事。";
		next;
		mes "[Chief Peperoncino]";
		mes "聆听他人的冒险故事是冒险者的美德之一。只要仔细倾听并向他人学习，就能得到宝贵的人生经验。";
		npctalk "如今像你这样的年轻人很少见。", "", bc_self;
		next;
		mes "[Chief Peperoncino]";
		mes "那么你对什么好奇？";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "我对你的故事很好奇。";
		next;
		mes "[Peperoncino]";
		mes "我的故事……你为什么好奇？既然你问了，我就告诉你。我出生在拉萨格纳外名为^0000cd Fusilli^000000的地方。当时只要提到 Peperoncino，Fusilli 的所有人都知道。";
			npctalk "我离开的那天，整个 Fusilli 都在哭泣。", "", bc_self;
		next;
		mes "[Vigilante]";
		mes "先生，这和上次喝酒聊天时你说的不一样。你说是因为讨厌因贫穷被人看不起才离开。";
		npctalk "你说过总有一天要用一沓钞票打他们的脸。", "Vigilante Chef#dorcon99", bc_self;
		next;
		mes "[Peperoncino]";
		mes "你在说什么？那天你一定醉得很厉害。冒险者还能要求什么呢？在广阔海洋体验那么多事情。";
		next;
		mes "[Peperoncino]";
		mes "但遗憾的是，^0000cd我再也无法登船^000000。原因不能告诉你，这是机密。";
		next;
		mes "治安队厨师";
		mes "晕船。";
		npctalk "你不忙吗？", "", bc_self;
		next;
		mes "[Peperoncino]";
		mes "后来我看到了渔业，更准确地说是凤尾鱼制造业的无限潜力，于是投入^0000cd凤尾鱼制造事业^000000。那时我遇见了 Gamberry。";
		npctalk "没错，Gamberry……", "", bc_self;
		next;
		mes "[Peperoncino]";
		mes "^0000cdGamberry 是个让我想起恶棍的混混^000000。很快他被我的话打动，加入了我的事业。";
		next;
		mes "治安队厨师";
		mes "我听说你们打过架。";
		npctalk "差点把一家店彻底毁掉。", "Vigilante Chef#dorcon99", bc_self;
		npctalk "你是用嘴做饭的吗？", "", bc_self;
		next;
		mes "[Peperoncino]";
		mes "当然有过小争执，但 Gamberry 被我的领导力打动并受到影响。在凤尾鱼制造业积累足够经验和诀窍后，我们决定描绘更大的蓝图。";
		next;
		mes "[Peperoncino]";
		mes "那就是^0000cd销售特产^000000。Gamberry 的朋友^0000cd Thomas^000000加入了事业，我们决定在拉萨格纳创业。但问题是^0000cd讨厌的杜拉姆^000000。";
		next;
		mes "[Peperoncino]";
		mes "他们什么都要挑毛病，所以我决定抓住他们，让他们工作。";
		next;
		mes "治安队厨师";
		mes "这个故事说不通。";
		npctalk "和我听到的版本不同。", "Vigilante Chef#dorcon99", bc_self;
		next;
		mes "[Peperoncino]";
		mes "无论如何，Gamberry 船长是个好人。他从混混时期就受我影响，如今成为了杜拉姆。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "过去的拉萨格纳是什么样？";
		next;
		mes "[Peperoncino]";
		mes "我刚来时拉萨格纳糟透了。呼吸一下就有人挑衅，走几步就打起来。Gamberry 船长四处制止那些人，但我对他的第一印象也和他们没区别。";
		next;
		mes "[Peperoncino]";
		mes "如果暴力镇压暴力，那什么能镇压这种暴力？总之，拉萨格纳像腐烂的垃圾桶。相比之下，Fusilli 的人简直纯真无邪！";
		npctalk "我永远听不完关于那个该死 Fusilli 的话。", "Vigilante Chef#dorcon99", bc_self;
		next;
		mes "治安队厨师";
		mes "我问新来的人 Fusilli 的事，没人知道。那里一定在偏僻乡下之类的地方。";
		npctalk "别侮辱 Fusilli！", "", bc_self;
		next;
		mes "[Peperoncino]";
		mes "总之，创业时最大的障碍是拉萨格纳讨厌的杜拉姆。他们扑上来找我打架。住在海边的人都这么好斗吗？";
		next;
		mes "治安队厨师";
		mes "不，别侮辱他们。是这个地方不寻常。";
		npctalk "我的家乡不是那样。", "Vigilante Chef#dorcon99", bc_self;
		next;
		mes "[Peperoncino]";
		mes "起初我试图通过交谈说服那些讨厌的杜拉姆。我想当绅士，但他们不听。这时 Gamberry 亲自处理了。";
		next;
		mes "[Peperoncino]";
		mes "我刚才不是告诉过你吗？他彻底解决了问题。我召集那些讨厌的杜拉姆并和他们谈话。他们被我的演讲感动，自愿加入治安队。";
		npctalk "你威胁他们不加入就离开。", "Vigilante Chef#dorcon99", bc_self;
		next;
		mes "[Peperoncino]";
		mes "哼！总之，在治安队和商人的努力下，拉萨格纳变成了今天的样子。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "治安队和商人怎么样？";
		next;
		mes "[Peperoncino]";
		mes "^0000cd治安队和商人^000000……嗯……在管理拉萨格纳的组织中，可以说是这两者创造了今天的拉萨格纳，而 Gamberry、Thomas 和我处于核心。";
		next;
		mes "[Peperoncino]";
		mes "我们投入特产事业后，许多被我们感动的杜拉姆都想提供帮助。";
		next;
		mes "治安队厨师";
		mes "看到了吗？和上次的版本不同。";
		npctalk "我在考虑明天邀请 Con-Chliina 的所有船员举办宴会。", "", bc_self;
		npctalk "不，没事。我现在闭嘴。", "Vigilante Chef#dorcon99", bc_self;
		next;
		mes "[Peperoncino]";
		mes "我们召集那些讨厌的杜拉姆，把他们送到治安队和商人那里。拉萨格纳的^0000cd秩序维护由治安队负责^000000，^0000cd所有与产品有关的事务由商人负责^000000。";
		next;
		mes "[Peperoncino]";

		cutin "Arquien_n_atnad02.bmp",2;
		mes "……内容不是什么大事。";
		mes "为什么……会提到 Atnad 这个名字？";
		mes "那个老人也知道吗？";
		next;
		cutin "Arquien_n_atnad01.bmp",2;
		mes "[Nile]";
		mes "不，不。他可能不知道。";
		mes "但我还是觉得这其中有蹊跷。";
		mes "……啊，这样思考不适合我。";
		next;
		mes "[Nile]";
		mes "你去把内容告诉他。";
		mes "还有这份记忆记录……哦……？";
		specialeffect EF_SPELLBREAKER,AREA,"Record player#e152a01";
		next;
		select("刚才发生了什么……");
		mes "[Nile]";
		mes "这是什么……？是静电吗？";
		mes "内容不会被抹掉吧？";
		mes "这种类型叫什么？是实体记录吗？";
		mes "我不确定，但内容本身应该没问题。";
		mes "如果这么多内容消失就麻烦了。";
		next;
		mes "[Nile]";
		mes "向老人复述大意，并问他为什么提到 Atnad 这个名字。";
		erasequest 7646;// Play Memory Record
		setquest 7647;// Report Memory Record
		ep15_1_atnad = 26;
		getexp 750000,500000;
		close3;
	case 26:
		cutin "Arquien_n_atnad04.bmp",2;
		mes "你记得大概内容吧？";
		mes "去报告吧。";
		mes "告诉他我会自己收集物品。";
		mes "他应该不会有问题。";
		mes "毕竟那个老人自命不凡。";
		close3;
	case 27:
		if (countitem(6824) < 5) {// // Lab_Memory_Record
			cutin "Arquien_n_atnad04.bmp",2;
			mes "哈。那个老人……";
			mes "他不会亲自来这里，对吧？";
			mes "所以这次是实验室的记忆记录？";
			next;
			cutin "Arquien_n_atnad03.bmp",2;
			mes "[Nile]";
			mes "我可以替你按下唱片机开关。";
			mes "我是不是很慷慨？";
			next;
			mes "[Nile]";
			mes "带回你想播放的实验室记忆记录。";
			mes "你知道要收集 5 份，对吧？";
			close3;
		}
		cutin "Arquien_n_atnad01.bmp",2;
		mes "就是这些东西。";
		mes "好。";
		mes "我感觉不太好，但工作就是工作。";
		next;
		mes "[Nile]";
		mes "完成了。";
		mes "播放它就能得到你想要的内容。";
		mes "正确记录信息并转交给医生。明白了吗？";
		delitem 6824,5;// Lab_Memory_Record
		ep15_1_atnad = 28;
		close3;
	case 28:
		cutin "Arquien_n_atnad01.bmp",2;
		mes "唱片机就在我旁边。";
		mes "自己听，自己记录信息。";
		close3;
	case 29:
		cutin "Arquien_n_atnad02.bmp",2;
		mes "所以那种咔嚓声不是静电，而是连接部件断裂的声音？";
		mes "把 5 份重新连接起来就能播放，内容也会保留……";
		mes "总之……";
		next;
		mes "[Nile]";
		mes "……这次的内容也很奇怪。";
		mes "所谓实验工作，是指让这里变成这样的实验吗？";
		mes "我是说实验室的记忆记录。";
		next;
		cutin "Arquien_n_atnad04.bmp",2;
		mes "[Nile]";
		mes "它也许能在揭开这个地区的秘密时发挥重要作用？";
		mes "虽然其中一些发现重复了相同内容。";
		next;
		select("展示碎片。");
		cutin "Arquien_n_atnad02.bmp",2;
		mes "[Nile]";
		mes "哦……这很有趣。";
		mes "记录中间有空白吗？";
		mes "这一部分断裂了。";
		mes "我从这块碎片中感受到巨大的邪恶意图。";
		mes "一定要小心处理。";
		mes "你不知道会发生什么。";
		next;
		cutin "Arquien_n_atnad03.bmp",2;
		mes "[Nile]";
		mes "说到这些记忆记录。";
		mes "听起来很有趣。";
		mes "我会参与其中，所以下次把记忆记录带给我。";
		next;
		mes "[Nile]";
		mes "你明白我说的吗？";
		mes "那么，去告诉老人这个消息。";
		erasequest 7648;// Memory Records of the Laboratories
		setquest 7649;// Report Memory Record Content
		ep15_1_atnad = 30;
		getexp 750000,500000;
		next;
		mes "^4d4dffYou can now receive daily quests for collecting Memory Records through Arquien Nile Atnad.^000000";
		close3;
	default:
		cutin "Arquien_n_atnad01.bmp",2;
		mes "怎么了？";
		next;
		switch( select( "研究设施记忆记录", "实验室记忆记录", "交谈", "我只是路过。" ) ) {
		case 1:
			mes "[Nile]";
			switch( checkquest(7651,PLAYTIME) ) {
			case -1:
				if (isbegin_quest(7650) > 0) {
					if (countitem(6757) < 5) {
						mes "5 Research facilities Memory Records.";
						mes "我很期待再次听到祖先的故事。";
						close3;
					}
					mes "你收集齐了所有记忆记录。";
					mes "不知道还有多少包含这些内容的记忆记录？";
					next;
					mes "[Nile]";
					mes "看来我们只能尽可能收集更多信息了？";
					mes "播放记录的准备完成了。";
					mes "现在只要播放即可。";
					delitem 6757,5;// Memory_Record
					if (isbegin_quest(7654) == 0)
						setquest 7654;// Play Research facilities Memory Records
					close3;
				}
				mes "你是来收集研究设施记忆记录的吗？";
				mes "继续做我们一直在做的事吧。";
				mes "收集 5 份研究设施记忆记录。";
				next;
				mes "[Nile]";
				mes "同时我会准备唱片机，以便立即播放。";
				mes "不知道这次的内容会是什么。";
				next;
				if (select( "接受。","拒绝。" ) == 2) {
					mes "[Nile]";
					mes "好吧，我也没办法。";
					mes "你可能也很忙，要回应很多人的请求。";
					mes "那回头见。";
					close3;
				}
				mes "[Nile]";
				mes "我就知道你会这么说。";
				mes "你也对内容感到好奇，对吧？";
				mes "我也会期待。";
				setquest 7650;// Collect Memory Records of Research facilities
				close3;
			case 0:
			case 1:
				mes "至于收集研究设施记忆记录，我们决定每天只能做一次，对吧？";
				mes "我们要不要故意慢吞吞、粗心大意地工作，让那个老人焦虑？";
				next;
				mes "[Nile]";
				mes "所以，等我说的时间过去后再回来。";
				mes "你也会累的。";
				mes "我不是会强迫别人的类型。";
				close3;
			case 2:
				erasequest 7651;// One Memory a Day
				mes "嗯……要重新开始收集记忆记录吗？";
				mes "想做的话告诉我。";
				mes "我会同时调试唱片机。";
				close3;
			}
		case 2:
			mes "[Nile]";
			switch( checkquest(7653,PLAYTIME) ) {
			case -1:
				if (isbegin_quest(7652) > 0) {
					if (countitem(6824) < 5) {
						mes "5 laboratories area's Memory Records.";
						mes "不知道那个叫 Dorothy 的女士这次会说什么。";
						close3;
					}
					mes "我看你已经收集齐了所有实验室记忆记录。";
					mes "不知道还有多少包含这些内容的记忆记录？";
					next;
					mes "[Nile]";
					mes "看来我们只能尽可能收集更多信息了？";
					mes "播放记录的准备完成了。";
					mes "现在只要播放即可。";
					delitem 6824,5;// Lab_Memory_Record
					if (isbegin_quest(7655) == 0)
						setquest 7655;// Play Laboratories Memory Records
					close3;
				}
				mes "你是来收集研究设施记忆记录的吗？";
				mes "继续做我们一直在做的事吧。";
				mes "我是说在^4d4dff实验室地下设施收集 5 份实验室记忆记录^000000。";
				next;
				mes "[Nile]";
				mes "同时我会准备唱片机，以便立即播放。";
				mes "不知道这次的内容会是什么。";
				next;
				if (select( "接受。", "拒绝。" ) == 2) {
					mes "[Nile]";
					mes "好吧，我也没办法。";
					mes "你可能也很忙，要回应很多人的请求。";
					mes "那回头见。";
					close3;
				}
				mes "[Nile]";
				mes "我就知道你会这么说。";
				mes "你也对内容感到好奇，对吧？";
				mes "我也会期待。";
				setquest 7652;// Collect Memory Records of Laboratories
				close3;
			case 0:
			case 1:
				cutin "Arquien_n_atnad01.bmp",2;
				mes "至于收集实验室记忆记录，我们决定每天只能做一次，对吧？";
				mes "我们要不要故意慢吞吞、粗心大意地工作，让那个老人焦虑？";
				next;
				mes "[Nile]";
				mes "所以，等我说的时间过去后再回来。";
				mes "你也会累的。";
				mes "我不是会强迫别人的类型。";
				close3;
			case 2:
				erasequest 7653;// One Memory a Day 2
				mes "嗯……要重新开始收集记忆记录吗？";
				mes "想做的话告诉我。";
				mes "我会同时调试唱片机。";
				close3;
			}
		case 3:
			mes "[Nile]";
			if (ep15_1_atnad != 30) {
				cutin "Arquien_n_atnad02.bmp",2;
				mes "其实我并没有真的怨恨父亲。";
				mes "我只是想听到一句道歉……";
				close3;
			}
			if (ep15_2_permit == 6) {
				mes "等等，发生什么事了？";
				mes "那边的帐篷是挖掘队驻地，对吧？";
				mes "好像有人来访？";
				mes "继续走吧！";
				cutin "",255;
				close;
			}
			mes "你想说什么？";
			next;
			select("关于最后的探索");
			mes "[Nile]";
			mes "啊，那个……？";
			mes "忘掉吧。";
			mes "现在想想，我需要直接从他那里听到。";
			next;
			mes "[Nile]";
			mes "根据 Aures 的说法，他盲目地执着于朱佩洛斯……";
			mes "我现在可能知道他为什么这么做了。";
			next;
			select("也许是为了记忆记录中的内容？");
			mes "[Nile]";
			mes "没错。";
			mes "那个老人。我的父亲可能也模糊地知道。";
			mes "他在寻找自己的根源。";
			mes "虽然这是我的童年记忆，但祖父们藏着许多秘密。";
			next;
			cutin "Arquien_n_atnad03.bmp",2;
			mes "[Nile]";
			mes "即便如此……哈哈。我真的会是这个 Verus 地区的后代吗？";
			mes "大概只是同名吧。哈哈哈……";
			close3;
		case 4:
			mes "[Nile]";
			cutin "Arquien_n_atnad01.bmp",2;
			mes "嘿。我没有那么多时间可以浪费，好吗？";
			close3;
		}
	}
}

verus04,170,150,3	script	Record player#e152a01	CLEAR_NPC,{
	if (.is_playing == 1) {
		mes "这份记录正在播放……";
		close;
	}
	if (ep15_1_atnad == 24) {
		.is_playing = 1;
		mes "正在播放记忆记录的音频信息。";
		sleep2 1000;
		npctalk "呼——滋滋——";
		sleep2 3000;
		npctalk "滋滋——喂！你在做什么？喂，你在听吗？";
		sleep2 3000;
		npctalk "我在听。Zerter……啊！是你。你的声音录进来了！";
		sleep2 3000;
		npctalk "什么？你在录音？为了什么？";
		sleep2 3000;
		npctalk "为了……滋滋——安装。啊……它要——滋滋。";
		sleep2 3000;
		npctalk "哈哈哈哈哈，你就是这么想的吗？没人像你一样，Atnad。不是吗——滋滋。";
		sleep2 1000;
		npctalk "……Atnad？";
		sleep2 3000;
		npctalk "滋滋——滋滋……它要……咔——……嗡——";
		sleep2 3000;
		.is_playing = 0;
		next;
		ep15_1_atnad = 25;
		mes "记忆记录中的所有音频信息都已播放。";
		close;
	}
	if (ep15_1_atnad == 28) {
		.is_playing = 1;
		mes "正在播放记忆记录的音频信息。";
		sleep2 1000;
		npctalk "我是 Dorothy Florence。今天在监控室捡到了一份记忆记录。";
		sleep2 4000;
		npctalk "它可能是实验当天录下的黑匣子记录。我来播放！";
		sleep2 4000;
		npctalk "滋滋——啊……先是静电噪音……啊，在这里。";
		sleep2 4000;
		npctalk "祝你好运……";
		sleep2 4000;
		npctalk "（女性声音）哈……我后悔从没谈过恋爱。";
		sleep2 4000;
		npctalk "（另一名女性声音）啊……我本该一边吃炸鸡喝啤酒一边看这个……滋滋——";
		sleep2 4000;
		npctalk "咦？就这些吗？但这个声音……啊啊啊，是检查她洗衣物的 Artemia！";
		sleep2 4000;
		npctalk "……嗯……我明白了。那天发生的就是这些……";
		sleep2 4000;
		npctalk "咔哒";
		sleep2 3000;
		.is_playing = 0;
		next;
		mes "记忆记录中的所有音频信息都已播放。";
		ep15_1_atnad = 29;
		if (countitem(22691) < 1 && countitem(22692) < 1 && countitem(22693) < 1 && countitem(22694) < 1 && countitem(22695) < 1) {
			getitem 22691,1;// Piece_Of_Record1
			setquest 7653;// One Memory a Day 2
		}
		next;
		mes "你试图取出记忆记录时，连接部件发出咔嚓声断裂，恢复成拆分状态。";
		close;
	}
	if (ep15_1_atnad < 30) {
		cutin "Arquien_n_atnad01.bmp",2;
		mes "[Nile]";
		mes "你能别不经允许就碰东西吗？";
		close3;
	}
	.@quest_7654 = isbegin_quest(7654);// Play Research facilities Memory Records
	if (.@quest_7654 != 1 && isbegin_quest(7655) != 1) {
		mes "没有更多记忆记录可播放。";
		close;
	}
	.is_playing = 1;
	mes "正在播放记忆记录的音频信息。";
	sleep2 1000;
	if (.@quest_7654 == 1) {
		switch( rand(1,14) ) {
		case 1:
			npctalk "printf(Hello, World!)";
			sleep2 4000;
			npctalk "return 0";
			sleep2 4000;
			npctalk "代码写到这里就完成了，还射出了 10 支箭。";
			sleep2 4000;
			npctalk "Ferdinando";
			break;
		case 2:
			npctalk "你好，Tatio。";
			sleep2 4000;
			npctalk "我不知道已经过去多少年了。";
			sleep2 4000;
			npctalk "我想，让你获得永生是件好事。";
			sleep2 4000;
			npctalk "我想你知道外部探索队的结果吧？我要去外面生活。";
			sleep2 4000;
			npctalk "在这片科学文明已成神话的土地上，我要像原始人一样生活。";
			sleep2 4000;
			npctalk "我要不要放弃科学，学习这种叫作魔法的东西？哈哈哈哈哈。";
			sleep2 4000;
			npctalk "啪！别说蠢话！";
			sleep2 4000;
			npctalk "啊……又挨打了。我的……滋滋……好痛……滋滋。";
			break;
		case 3:
			npctalk "你好，Tatio。你能收集并捡起这些东西吗？";
			sleep2 4000;
			npctalk "我在这座城市里替独自留下的你玩耍。";
			sleep2 4000;
			npctalk "抱歉把我们所有的希望和绝望都倾倒给你。";
			sleep2 4000;
			npctalk "你还要独自留在这座坟墓般的城市里多久？";
			sleep2 4000;
			npctalk "我决定为你藏起记忆记录。";
			sleep2 4000;
			npctalk "当然，我也没有忘记那些小包裹～！";
			sleep2 4000;
			npctalk "我本来希望能有时间找到并听听这些记录。";
			sleep2 4000;
			npctalk "……永远陪伴你的 Lasse Atnad。";
			break;
		case 4:
			npctalk "啊，测试测试……哦……能用吗？";
			sleep2 4000;
			npctalk "你好，我是软件工程师 Sukurita。";
			sleep2 4000;
			npctalk "今天我要说明 Sukuta 引擎所使用的 Sukuta 语言的注意事项。";
			sleep2 4000;
			npctalk "Skuta 语言可以同时使用全局变量和局部变量……";
			sleep2 4000;
			npctalk "全局变量就像恶魔，如果你被它甜蜜的诱惑";
			sleep2 4000;
			npctalk "吸引，就会承受心悸以及";
			sleep2 4000;
			npctalk "因一个字节空间或特殊语法而引发的冷汗和癫痫。";
			sleep2 4000;
			npctalk "下次我会解释 Skuta 语言的替代方案，嗯嗯。";
			sleep2 4000;
			npctalk "Sukurita 语言是我 Sukurita 发明的。嘻嘻嘻嘻。";
			break;
		case 5:
			npctalk "咔哒——滋滋，别阻止我，噗哈哈哈，我要把这段录下来！";
			sleep2 4000;
			npctalk "噗哈哈哈哈哈哈哈哈哈。";
			sleep2 4000;
			npctalk "我没疯，这很有趣！因为它确实有趣。";
			sleep2 4000;
			npctalk "现在是该笑的时候吗？";
			sleep2 4000;
			npctalk "啊，当然不是。不是，但嘿嘿嘿。";
			sleep2 4000;
			npctalk "...Then should I cry? Huh? Hasn't this given you hope?";
			sleep2 4000;
			npctalk "Our hope!";
			sleep2 4000;
			npctalk "咔——！啊……这个……这个破碎声是 Ze……Zerte……";
			sleep2 4000;
			npctalk "呃。天哪。你真难对付。";
			sleep2 4000;
			npctalk "咦？这还在录音？";
			break;
		case 6:
			npctalk "今天是 Verus 城市的最后一次实验，也是第 4885 个项目。";
			sleep2 4000;
			npctalk "大家都希望看到实验成功，于是前往实验室观察。";
			sleep2 4000;
			npctalk "只有我在研究设施值班。哈哈哈哈哈。";
			sleep2 4000;
			npctalk "啊，我想 Tatio 也不是主要项目的成员，所以和我一起在研究设施里。";
			sleep2 4000;
			npctalk "这是孤独的工作……要是能发生点好事就好了……";
			sleep2 4000;
			npctalk "刚才是不是有什么东西闪了一下？喂！";
			sleep2 4000;
			npctalk "轰！滋滋滋滋。";
			break;
		case 7:
			npctalk "避难室幸存者的测量数据不再显示在灾害系统屏幕上。";
			sleep2 4000;
			npctalk "到底发生了什么？";
			sleep2 4000;
			npctalk "怎么回事？是系统错误吗？";
			sleep2 4000;
			npctalk "Tatio 说 Fresa 博士还活着。";
			sleep2 4000;

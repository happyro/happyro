		mes "[Allen]";
		mes "你身上有浓重的血腥味。没错，你杀了玛乔雷罗斯。你是强大的战士。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "是的，我把它们全杀了。现在告诉我那个故事，那个昂贵的故事。";
		next;
		mes "[Allen]";
		mes "战争，王室家族。赫尔穆特·罗根堡。如果他成为国王，大陆将被卷入战争漩涡。";
		next;
		mes "[Allen]";
		mes "黑暗将席卷大陆，痛苦的呻吟会遍布整个大陆！！！";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "传闻是这样流传的吗？但我不明白它是什么意思。有人能解释一下吗？";
		next;
		mes "[Jin]";
		mes "很简单。如果赫尔穆特·罗根堡成为国王，就会爆发战争。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "嗯……太简单了。请再解释一下。";
		next;
		mes "[Harriet]";
		mes "呃——！你们两个在说什么？让我来解释。传闻是这样的：";
		next;
		mes "[Harriet]";
		mes "如果赫尔穆特·罗根堡成为国王……对了，你知道罗根堡家族的传闻吗，尤其是^0000cd四个孩子死亡的传闻^000000。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "不，我不知道。从没听说过。";
		next;
		mes "[Harriet]";
		mes "这也只是传闻，但我确信是真的。总之，我听说他们被谋杀了，";
		next;
		mes "[Harriet]";
		mes "是在访问外国时。赫尔穆特·罗根堡受到打击，从那以后一直在战场附近徘徊。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "是的，他确实一直在战场附近徘徊。";
		next;
		mes "[Harriet]";
		mes "我想这是因为王室议会。这就是现在流传的传闻。";
		next;
		mes "[Harriet]";
		mes "^0000cd据说^000000如果赫尔穆特成为国王，他会入侵父母遇害的国家，发动统一大陆的战争。";
		next;
		mes "[Harriet]";
		mes "罗根堡家族的二儿子正在做生意，为战争筹集资金。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "你知道得真详细？";
		next;
		mes "[Harriet]";
		mes "大家都知道。这里到处都在谈论这件事。";
		next;
		mes "[Jin]";
		mes "我的父母很担心。他们害怕赫尔穆特成为国王并发动战争。";
		mes "事实上大家都很焦虑。他们不喜欢战争。";
		next;
		emotion ET_SURPRISE, getnpcid(0, "Kiddo#ep16lug01");
		mes "[Allen]";
		mes "战场上的鲜血在呼唤我！";
		next;
		emotion ET_OHNO, getnpcid(0, "Kiddo#ep16lug02");
		mes "[Jin]";
		mes "除了他。";
		next;
		emotion ET_CRY, getnpcid(0, "Kiddo#ep16lug03");
		mes "[Harriet]";
		mes "我也讨厌战争。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "谢谢你们的故事。这正是我需要的。";
		next;
		mes "[Harriet]";
		mes "如果还有问题，随时来找我！";
		next;
		mes "[Jin]";
		mes "谢谢你的书！";
		next;
		mes "[Allen]";
		mes "男子汉不会送人出去。";
		delitem 6926,1;// Midgards_Histories
		delitem 7166,12;// Soft Silk
		erasequest 14499;// Prove Yourself
		setquest 14501;// Report to Wolf
		ep16_lug = 6;
		close;
	case 11:
		mes "[" + strcharinfo(0) + "]";
		mes "孩子们，你们好？";
		next;
		mes "[Jin]";
		mes "咦？你又来了。还需要更多吗？不管怎样，很高兴你来。我得归还这本书。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "我有个关于罗根堡传闻的问题。";
		next;
		mes "[Allen]";
		mes "家族没有新的故事。没有故事就意味着死亡。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "我不是来听新传闻的。我在找告诉你们这个故事的人。";
		next;
		mes "[Jin]";
		mes "为什么？";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "我想知道是谁散播了传闻。";
		next;
		mes "[Harriet]";
		mes "为什么？你要抓住那个人吗？";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "不，是他的祖父让我给他传话。";
		next;
		mes "[Harriet]";
		mes "他们明明是家人，难道不能见面吗？";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "嗯，不是那样……嗯……差不多吧。";
		next;
		mes "[Jin]";
		mes "真奇怪。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "是的。不过有时即使是家人也很难见面，只能请别人互相传话。";
		next;
		mes "[Allen]";
		mes "这次，你需要更有力的凭证……";
		next;
		mes "[Harriet]";
		mes "啊，他来了！乔纳森！我们有客人。";
		next;
		cloakoffnpcself( "Ordinary Man#ep16lug02" );
		mes "[Myer]";
		mes "亲爱的冒险者。你为什么来这里？";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "想找到最初散播传闻的人，就要找到传闻来源。不过没想到你会在这里。";
		next;
		mes "[Myer]";
		mes "你是来见我的吗？";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "是的。你的家人让我给你传话。";
		next;
		emotion ET_QUESTION, getnpcid(0, "Kiddo#ep16lug01");
		mes "[Allen]";
		mes "迈尔？";
		next;
		emotion ET_QUESTION, getnpcid(0, "Kiddo#ep16lug02");
		mes "[Jin]";
		mes "迈尔？";
		next;
		emotion ET_QUESTION, getnpcid(0, "Kiddo#ep16lug03");
		mes "[Harriet]";
		mes "迈尔是谁？^0000cd你的名字是迈尔^000000？乔纳森·迈尔？迈尔·乔纳森？你说过只叫你乔纳森。";
		next;
		mes "[Myer]";
		mes "你以前见过这些孩子，对吧？";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "是的。他们很可爱，但很难应付。";
		next;
		mes "[Harriet]";
		mes "你是乔纳森·迈尔？还是迈尔·乔纳森？告诉我！";
		next;
		mes "[Myer]";
		mes "孩子们，我要和他谈很重要的事。你们能捂住耳朵或离开吗？";
		next;
		mes "[Allen]";
		mes "耳朵不能关闭。";
		next;
		mes "[Jin]";
		mes "如果很重要，我想听。";
		next;
		mes "[Harriet]";
		mes "拜托！他们要谈重要的事。大家捂住耳朵。";
		next;
		mes "[Myer]";
		mes "乖孩子。谈完后我给你们甘草糖。";
		next;
		mes "[Allen]";
		mes "我的耳朵捂住了。";
		next;
		mes "[Jin]";
		mes "啊，那你们谈吧。";
		next;
		mes "[Harriet]";
		mes "啦啦啦啦啦——";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "他们又可爱又聪明。我很好奇他们会长成什么样。";
		next;
		mes "[Myer]";
		mes "是的。所以我来这里观察、教导并引领他们。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "你做得很好。";
		next;
		mes "[Myer]";
		mes "嗯，这是我能做的。对了，是什么消息？";
		next;
		mes "[告诉迈尔赫尔穆特已经转让继承权，他的两个兄弟也放弃了战争]";
		next;
		mes "[Myer]";
		mes "太好了。他们是我引以为傲的兄弟。最重要也最幸运的是^0000cd沃尔夫改变了想法^000000。和他争论真让人头疼。";
		next;
		mes "[Myer]";
		mes "沃尔夫必须亲眼确认一切才会结束。不过从某种角度看这是好事。";
		next;
		mes "[Myer]";
		mes "你可能不信，他是家族里我最喜欢的人。";
		next;
		mes "[Myer]";
		mes "啊，总之，很抱歉让你看到家族不愉快的一面。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "兄弟之间互相争斗很常见。我也……";
		next;
		mes "[Myer]";
		mes "总之，我想我得去家里看看。家里的事很烦人，但应该会很有趣。请告诉家人，我工作期间会在这里帮助他们。";
		next;
		mes "[Myer]";
		mes "还要告诉他们宴会后我会去拜访。";
		next;
		mes "[Myer]";
		mes "请告诉艾格尼丝，很抱歉我不能陪她去宴会。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "好的，我会的。";
		next;
		mes "[Myer]";
		mes "需要我的帮助就来找我。我会竭尽全力帮助你。保重！";
		erasequest 14506;// Things Turned out This Way
		setquest 14507;// To Maximilian
		ep16_lug = 12;
		close;
	}
	return;
}

prontera,271,70,3	script	Kiddo#ep16lug01	4_M_MIKID,{
	if (ep16_lug < 4) {
		mes "[Allen]";
		mes "你想和我们谈生意吗？但我们不见任何人。";
		next;
		mes "[Allen]";
		mes "我们不是谁都能交谈的普通人。";
		mes "回去吧。";
		close;
	}
	if (ep16_lug == 4) {
		mes "[Allen]";
		mes "今天的风很冷，还有腐臭味。我感觉发生了什么事。";
		next;
		emotion ET_SHY, getnpcid(0, "Kiddo#ep16lug02");
		mes "[Jin]";
		mes "啊，抱歉，我好几天没清洁自己了。";
		next;
		mes "[Allen]";
		mes "是吗？我觉得他们在考验我。";
		F_kids_roegenburg_quest();
	}
	if (ep16_lug == 5) {
		if (countitem(6926) < 1 || countitem(7166) < 12 || checkquest(14499,HUNTING) < 2) {
			mes "[Allen]";
			mes "他空手来了。";
			next;
			mes "[Allen]";
			mes "没有凭证的人听不到好故事。回去吧。";
			next;
			mes "[Harriet]";
			mes "你怎么能这么说！你一定忘了该带什么。";
			next;
			mes "[Harriet]";
			mes "首先，^0000cd12块柔软的布^000000、^0000cd鲁恩·米德加尔特历史书^000000";
			next;
			mes "[Harriet]";
			mes "还有嗯……给艾伦^0000cd猎杀33只玛乔雷罗斯^000000。";
			next;
			mes "[Harriet]";
			mes "里面还有奇怪的东西，不过那又怎样……他想要。";
			close;
		}
		F_kids_roegenburg_quest();
	}
	if (ep16_lug >= 6 && ep16_lug <= 10) {
		mes "[Allen]";
		mes "还想听更多吗？那就证明你有更强的凭证。";
		next;
		mes "[Allen]";
		mes "这是召唤鲜血的仪式！毁灭与黑暗的仪式！！！！";
		next;
		mes "[Jin]";
		mes "他又开始了。";
		next;
		mes "[Harriet]";
		mes "请走吧。我们来处理他。";
		close;
	}
	if (ep16_lug == 11)
		F_kids_roegenburg_quest();
	mes "[Allen]";
	mes "战争的威胁消失了。动荡时代的英雄尚未诞生。黑暗在呼唤我！";
	next;
	mes "[Jin]";
	mes "他又开始了。";
	next;
	mes "[Harriet]";
	mes "请走吧。我们来处理他。";
	close;
}

prontera,271,68,1	script	Kiddo#ep16lug02	4_M_KID1,5,5,{
	if (ep16_lug < 4) {
		mes "[Jin]";
		mes "今天天气很好。";
		mes "宫殿里的宴会正进行得如火如荼。";
		next;
		mes "[Jin]";
		mes "宫殿大量采购商品，父母的生意兴隆，他们很高兴。我会让他们明天给我买本书。";
		next;
		mes "[Jin]";
		mes "今天的日记到此结束。";
		close;
	}
	if (ep16_lug == 4) {
		mes "[Jin]";
		mes "今天天气很好。";
		mes "宫殿里的宴会正进行得如火如荼。";
		next;
		mes "[Allen]";
		mes "血腥之日来临时，它们都会被摧毁。";
		mes "我们为什么要记录这些虚无的事？";
		next;
		mes "[Jin]";
		mes "因为记录会永远留存。";
		mes "如果记录今天，未来有人会读到它们并记住我们。";
		next;
		mes "[Allen]";
		mes "人类从虚无中来，也归于虚无。";
		F_kids_roegenburg_quest();
	}
	if (ep16_lug == 5) {
		if (countitem(6926) < 1 || countitem(7166) < 12 || checkquest(14499,HUNTING) < 2) {
			mes "[Jin]";
			mes "咦？怎么空手？我看不到我们告诉你的东西。";
			next;
			mes "[Jin]";
			mes "你因为我们是孩子就小看我们吗？我最讨厌这种人。";
			next;
			mes "[Harriet]";
			mes "嘿！你不是那种人吧？你看起来不像。你忘了该拿什么，对吧？";
			next;
			mes "[Harriet]";
			mes "首先，^0000cd12块柔软的布^000000、^0000cd鲁恩·米德加尔特历史书^000000";
			next;
			mes "[Harriet]";
			mes "还有嗯……给艾伦^0000cd猎杀33只玛乔雷罗斯^000000。";
			next;
			mes "[Harriet]";
			mes "里面还有奇怪的东西，不过那又怎样……他想要。";
			close;
		}
		F_kids_roegenburg_quest();
	}
	if (ep16_lug >= 6 && ep16_lug <= 10) {
		mes "[Jin]";
		mes "我很喜欢读你给的书，虽然它又大又重。";
		next;
		mes "[Jin]";
		mes "我的梦想是成为历史学家。我想环游米德加尔特，发现古老的隐秘故事。";
		close;
	}
	if (ep16_lug == 11)
		F_kids_roegenburg_quest();
	mes "[Jin]";
	mes "乔纳森归还了你借的书，还借给我另外两册。";
	next;
	mes "[Jin]";
	mes "乔纳森真棒！将来我也要成为像乔纳森一样的人。";
	close;

OnTouch:
	if (ep16_lug >= 12)
		cloakoffnpcself( "Ordinary Man#ep16lug02" );
	end;
}

prontera,269,69,5	script	Kiddo#ep16lug03	4_F_KID2,{
	if (ep16_lug < 4) {
		mes "[Harriet]";
		mes "公主们的裙子多么美丽耀眼啊！我希望能穿尽可能多的漂亮裙子。";
		close;
	}
	if (ep16_lug == 4) {

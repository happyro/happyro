		mes "[Harriet]";
		mes "你好，歌唱的小鸟和美丽的花朵。";
		mes "你们今天也过得美好吗？";
		next;
		emotion ET_OHNO, getnpcid(0, "Kiddo#ep16lug02");
		mes "[Jin]";
		mes "他又开始了。";
		mes "为什么我身边没有正常人？";
		next;
		mes "[Allen]";
		mes "你在和我说话吗？";
		mes "如果是，你成功了。我听得很清楚。";
		next;
		mes "[Allen]";
		mes "我拒绝平庸。";
		mes "我太伟大了，不能被它束缚。";
		F_kids_roegenburg_quest();
	}
	if (ep16_lug == 5) {
		if (countitem(6926) < 1 || countitem(7166) < 12 || checkquest(14499,HUNTING) < 2) {
			mes "[Jin]";
			mes "咦？怎么空手？我看不到我们告诉你的东西。";
			next;
			mes "[Jin]";
			mes "你因为我们是孩子就小看我们吗？我最讨厌这种人。";
			next;
			mes "[Harriet]";
			mes "嘿！你不是那种人吧？你看起来不像。你忘了该拿什么，对吧？";
			next;
			mes "[Harriet]";
			mes "首先，^0000cd12块柔软的布^000000、^0000cd鲁恩·米德加尔特历史书^000000";
			next;
			mes "[Harriet]";
			mes "还有嗯……给艾伦^0000cd猎杀33只玛乔雷罗斯^000000。";
			next;
			mes "[Harriet]";
			mes "里面还有奇怪的东西，不过那又怎样……他想要。";
			close;
		}
		F_kids_roegenburg_quest();
	}
	if (ep16_lug >= 6 && ep16_lug <= 10) {
		mes "[Harriet]";
		mes "请让我的母亲用这块布做衣服。";
		mes "我的母亲会做漂亮的衣服！";
		next;
		mes "[Harriet]";
		mes "我想她现在在宫殿里修补公主们的裙子。";
		mes "啊，我希望她在这里！";
		close;
	}
	if (ep16_lug == 11)
		F_kids_roegenburg_quest();
	mes "[Harriet]";
	mes "乔纳森说战争的威胁消失了。那真是令人欣慰。";
	close;
}


// Wandering Guardian Quest
//============================================================

// ----------------- Part of md_mistwoods_in -----------------
1@mist,2,2,0	script	#Dragon Herder	844,{
	end;
OnInstanceInit:
	switch(rand(1,6)) {
		case 1: setarray .@c[0],77,240; break;
		case 2: setarray .@c[0],147,261; break;
		case 3: setarray .@c[0],182,263; break;
		case 4: setarray .@c[0],194,350; break;
		case 5: setarray .@c[0],268,183; break;
		case 6: setarray .@c[0],65,278; break;
	}
	monster instance_mapname("1@mist"),.@c[0],.@c[1],"Wandering Purple Dragon",2131,1,instance_npcname("#Dragon Herder")+"::OnMyMobDead";
	end;
OnMyMobDead:
	set .@map$, instance_mapname("1@mist");
	if (mobcount(.@map$,instance_npcname("#Dragon Herder")+"::OnMyMobDead") == 0) {
		donpcevent instance_npcname("Collapsed Girl#mist")+"::OnEnable";
		donpcevent instance_npcname("Mysterious Young Man#mis")+"::OnDisable";
		donpcevent instance_npcname("Loki#mist")+"::OnEnable";
		mapannounce .@map$,"The Dragon's Cry: Am I being punished... for abandoning the way... of the guardian...?",bc_map,"0xffff00"; //FW_NORMAL 12 0 0
		disablenpc instance_npcname("#Dragon Herder");
		initnpctimer;
	}
	end;
OnTimer3000:
	stopnpctimer;
	mapannounce instance_mapname("1@mist"),"脑海中的声音：……你愿意……救救……我吗……？",bc_map,"0xffff00"; //FW_NORMAL 12 0 0
	end;
}

1@mist,97,30,3	script	Mysterious Young Man#mis	512,{
	if (BaseLevel < 98) {
		mes "[Mysterious Young Man]";
		mes "嗯？你打算从这里通过吗？";
		mes "……恐怕这超出了你的能力，但我不会干涉你的事。";
		mes "如果你能活下来，我们会再见的。";
		close;
	}
	if (ep14_1_mistwoods == 0) {
		if (ep13_3_secret > 23) {
			mes "[Mysterious Young Man]";
			mes "你……我记得在营地见过你。";
			mes "你提供的 Ahat 情报很有用。";
			mes "谢谢！";
			next;
			mes "[Mysterious Young Man]";
			mes "但你打算从这里通过吗？";
			mes "穿越彩虹桥有什么好处？";
			next;
		} else {
			mes "[Mysterious Young Man]";
		mes "你打算从这里通过吗？";
		mes "如果只是好奇，我劝你不要这么做。";
		mes "这只会让你过早丧命……";
			next;
		}
		mes "[Mysterious Young Man]";
		mes "如果你决心从这里通过，";
		mes "我想请你帮个忙。";
		next;
		select("你是谁？");
		mes "[Loki]";
		mes "Loki……来自刺客公会。";
		mes "这是我的名字。";
		mes "你呢？";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "....";
		mes "...."+strcharinfo(0)+" sir.";
		next;
		mes "[Loki]";
		mes "我明白了，"+strcharinfo(0)+"。";
		mes "我再问一次。";
		mes "你打算穿过这片森林吗？";
		next;
		switch(select("是的，我记得。:不，我不记得。")) {
		case 1:
			mes "[Loki]";
			mes "那么我问你一个问题。";
			mes "你见过一个守卫……紫色头发的女孩吗？";
			next;
			switch(select("不，我没有。:是的，我可能有过……")) {
			case 1:
				mes "[Loki]";
				mes "所以你没见过。";
				mes "你说的是实话。";
				next;
				break;
			case 2:
				mes "[Loki]";
			mes "等等。";
				mes "(Loki comes closer.)";
				mes "... No.";
				mes "你说的是实话。";
				next;
				break;
			}
			mes "[Loki]";
			mes "现在我们必须在这里道别。";
			mes "当然，前提是你能活着穿过森林。";
			set ep14_1_mistwoods,2;
			setquest 7212;
			close;
		case 2:
			mes "[Loki]";
			mes "我明白了。";
			mes "如果你没准备好，就退后。";
			mes "这片森林不欢迎陌生人。";
			set ep14_1_mistwoods,1;
			close;
		}
	} else if (ep14_1_mistwoods == 1) {
		mes "[Loki]";
		mes "我说过了——不想死就退后。";
		mes "穿过森林并不容易。";
		mes "你可能会付出生命代价。";
		next;
		switch(select("好吧。:你想要什么？")) {
		case 1:
			mes "- 你后退时，";
			mes "Loki 轻轻点头，然后移开视线。-";
			close;
		case 2:
			mes "[Loki]";
			mes "我在找一个人。";
			mes "你见过一个守卫……紫色头发的女孩吗？";
			next;
			switch(select("不，我没有。:是的，我可能有过……")) {
			case 1:
				mes "[Loki]";
				mes "所以你没见过。";
				mes "你说的是实话。";
				next;
				break;
			case 2:
				mes "[Loki]";
			mes "等等。";
				mes "(Loki comes closer.)";
				mes "... No.";
			mes "你说的是实话。";
				next;
				break;
			}
			mes "[Loki]";
			mes "现在我们必须在这里道别。";
			mes "希望我们能在莫拉再次见面。";
			set ep14_1_mistwoods,2;
			setquest 7212;
			close;
		}
	} else if (ep14_1_mistwoods == 2) {
		mes "[Loki]";
		mes "我不想和你一起走。";
		mes "希望我们能在莫拉再次见面。";
		close;
	} else if (ep14_1_mistwoods == 3) {
		mes "[Loki]";
		mes "我们又见面了。";
		mes "你习惯这里了吗？";
		mes "来莫拉的旅馆。";
		mes "我有东西要给你。";
		close;
	} else {
		mes "[Loki]";
		mes "最近我们见得很频繁。";
		mes "看来你已经完全适应这里了。";
		mes "你最好别太自满。";
		close;
	}
	end;
OnEnable:
	enablenpc instance_npcname("Mysterious Young Man#mis");
	end;
OnDisable:
	disablenpc instance_npcname("Mysterious Young Man#mis");
	end;
}

1@mist,183,304,3	script	Loki#mist	512,{
	if (ep14_1_mistwoods < 2) {
		mes "[Loki]";
		mes "森林里的冒险者。";
		mes ".....";
		mes "可以通过这片森林前往莫拉。";
		close;
	} else if (ep14_1_mistwoods == 2) {
		mes "[Loki]";
		mes "是你处理了这个任性的女孩吗？";
		mes "看来我得谢谢你。";
		mes "你让她冷静下来了。";
		next;
		select("发生了什么？:这个女孩……？");
		mes "[Loki]";
		mes "你也许能改变外表，但无法改变独特的先天气息。";
		mes "那股气味强烈得刺鼻。";
		next;
		mes "[Loki]";
		mes "这就是我一直在寻找的世界树守护者 Nydhogg，";
		mes "现在她不会再发疯游荡了。";
		next;
		select("你现在打算做什么？");
		mes "[Loki]";
		mes "我会等她醒来，然后离开这片森林。";
		mes "我自己能应付。";
		mes "莫拉见。";
		set ep14_1_mistwoods,3;
		erasequest 7212;
		setquest 7213;
		close;
	} else if (ep14_1_mistwoods == 3) {
		mes "[Loki]";
		mes "我不想和你一起走。";
		mes "我自己能应付她。";
		mes "有什么话，等离开森林后再说。";
		close;
	} else {
		mes "[Loki]";
		mes "我不想和你一起走。";
		mes "有什么话，等离开森林后再说。";
		close;
	}
	end;
OnInstanceInit:
OnDisable:
	disablenpc instance_npcname("Loki#mist");
	end;
OnEnable:
	enablenpc instance_npcname("Loki#mist");
	end;
}

1@mist,181,303,3	script	Collapsed Girl#mist	511,{
	mes "你看到一个神秘头发颜色的女孩倒在地上。";
	mes "靠近她时，你闻到浓烈的花香，强烈得令人眩晕。";
	close;
OnInstanceInit:
OnDisable:
	disablenpc instance_npcname("Collapsed Girl#mist");
	end;
OnEnable:
	enablenpc instance_npcname("Collapsed Girl#mist");
	end;
}

// --------------- Part of md_mistwoods_enter ----------------
mora,46,152,5	script	Flower Smelling Lady	510,{
	if (ep14_1_mistwoods < 3) {
		mes "[Flower Smell Lady]";
		mes "我需要休息。";
		mes "我太累了，没法和你说话。";
		mes "对不起。";
		close;
	} else if (ep14_1_mistwoods == 3) {
		mes "[Nydhogg the Guardian]";
		mes "我一直在等你。";
		mes "我仍然困惑，但我知道自己做错了什么。";
		next;
		mes "[Nydhogg the Guardian]";
		mes "如果不是你，我还会在深渊黑暗中徘徊。";
		mes "我从心底感谢你。";
		next;
		mes "[Nydhogg the Guardian]";
		mes "我为自己感到羞耻，竟在孤独时相信了那些甜蜜却空洞的话。";
		mes "....";
		next;
		mes "[Nydhogg the Guardian]";
		mes "我不再配做守护者。";
		mes "发疯的龙不再是守护者。";
		next;
		mes "[Loki]";
		mes "Yggdrasil 不这么认为。";
		mes "Nidi，别忘了你的职责。";
		next;
		mes "[Nydhogg the Guardian]";
		mes "你是……？";
		mes "我明白了……";
		mes "我还以为自己被遗弃了……";
		next;
		mes "守护者仿佛陷入沉思，慢慢移开了视线。";
		set ep14_1_mistwoods,4;
		close2;
	} else if (ep14_1_mistwoods == 4) {
		mes "- 他似乎陷入了沉思。-";
		close;
	} else {
		mes "[Nydhogg the Guardian]";
		mes "我还没有恢复全部力量。";
		mes "抱歉，我无法保护你。";
		next;
		mes "[Nydhogg the Guardian]";
		mes "Loki 说……";
		mes "我不会再因孤独而哭泣，";
		mes "我会一直拥有像你这样的新朋友……";
		next;
		mes "[Nydhogg the Guardian]";
		mes "……我失去了一切，但现在很幸福。";
		close;
	}
}

mora,48,152,3	script	Sharp Eyed Man	512,{
	if (checkweight(1201,1) == 0 || MaxWeight - Weight < 1000) {
		mes "- 你的物品太多，无法进行此任务。-";
		close;
	}
	if (ep14_1_mistwoods < 3) {
		mes "他不看你，仿佛完全没有兴趣。";
		close;
	} else if (ep14_1_mistwoods == 3) {
		mes "[Loki]";
		mes "你已经穿过森林了。";
		mes "看来 Niddy 有话要对你说。";
		close;
	} else if (ep14_1_mistwoods == 4) {
		mes "[Loki]";
		mes "Nydhogg 曾是世界树的守护者之一。";
		mes "但他屈服于魔王梦罗克的诱惑，放弃了守护者职责。";
		next;
		mes "[Loki]";
		mes "一些愚蠢的人举行仪式，试图打破封印梦罗克的封印。";
		mes "但仪式出了问题，梦罗克的仆从没能打破封印。";
		next;
		mes "[Loki]";
		mes "但封印非常脆弱，随时可能破裂。";
		mes "是世界树 Yggdrasil 的意志阻止了封印破裂。";
		next;
		mes "[Nydhogg the Guardian]";
		mes "没错。世界树的力量与整个世界相连。";
		mes "守护者与 Yggdrasil 的纽带断裂后，Yggdrasil 变得不稳定。";
		next;
		mes "[Nydhogg the Guardian]";
		mes "所以 Yggdrasil 才遭遇了那些灾难。";
		mes "随着世界树变得不稳定，它对封印的影响也减弱了。";
		next;
		mes "[Loki]";
		mes "梦罗克因此挣脱了封印。";
		mes "不过他似乎耗尽大部分力量才打破封印……";
		next;
		mes "[Nydhogg the Guardian]";
		mes "这一切都是我的错。";
		mes "我无法摆脱梦罗克的诱惑。";
		mes "太久了……太久了……";
		next;
		mes "[Nydhogg the Guardian]";
		mes "...I wanted to be relieved of my thousands of years of loneliness.";
		mes "那时我神志不清。";
		mes "正是我亲手斩断了与 Yggdrasil 的纽带。";
		next;
		mes "[Nydhogg the Guardian]";
		mes "我失去了自制，做了不该做的事。";
		mes "我的另一面变成了阴影和鲁莽的暴君。";
		next;
		mes "[Nydhogg the Guardian]";
		mes "面对世界时，我意识到……";
		mes "我感到巨大的失落……比忍受数千年的孤独还要痛苦。";
		next;
		mes "[Nydhogg the Guardian]";
		mes "所以我被独自留下。";
		mes "我感到巨大的失落……比忍受数千年的孤独还要痛苦。";
		next;
		mes "[Nydhogg the Guardian]";
		mes "于是我成了被世界遗忘的罪人。";
		next;
		mes "[Loki]";
		mes "还不算晚。";
		mes "你仍是守护者。";
		mes "你还有事情要做。";
		next;
		mes "[Nydhogg the Guardian]";
		mes "……是的。虽然晚了，但我必须履行守护者职责。";
		mes "我明白了。我要亲手摧毁梦罗克。";
		mes "我会履行守护者职责。";
		next;
		switch(select("你并不孤独。:那些是非常重要的职责。")) {
		case 1:
			mes "[Nydhogg the Guardian]";
			mes "你说得对。";
			mes "也许正因为意识到自己并不孤独，我才没有被遗弃。";
			mes "你是个善良的人。";
			next;
			break;
		case 2:
			mes "[Nydhogg the Guardian]";
			mes "但这是我的赎罪。";
			mes "不过我很幸福。";
			mes "我不必再与孤独抗争。";
			next;
			break;
		}
		mes "[Nydhogg the Guardian]";
		mes strcharinfo(0)+"……";
		mes "谢谢你听完我的长故事。";
		next;
		mes "[Nydhogg the Guardian]";
		mes "这是我一直带在身边的东西。";
		mes "我相信它有一天会保护你。";
		next;
		mes "[Loki]";
		mes "（他取下脖子上的围巾，递给你。）";
		next;
		mes "[Nydhogg the Guardian]";
		mes "愿世界树之母的祝福与你同在……";
		set ep14_1_mistwoods,10;
		completequest 7213;
		getitem 2568,1; //Muffler_Of_Roki
		getitem 2858,1; //Pendant_Of_Guardian
		getexp 400000,400000;
		close;
	} else {
		mes "[Loki]";
		mes "我会在这里待一阵子。";
		mes "我们可能还会再见。";
		next;
		mes "[Loki]";
		mes "梦罗克显露卑劣本性之日……";
		mes "我会等着他。";
		close;
	}
}


//===== rAthena Script ======================================= 
//= Malangdo Culvert
//===== By: ================================================== 
//= Euphy
//===== Current Version: ===================================== 
//= 1.1
//===== Compatible With: ===================================== 
//= rAthena Project
//===== Description: ========================================= 
//= [Official Conversion]
//= Clean the culverts and defeat the Coelacanth.
//= Daily and weekly quests are available.
//= Contains a normal mode and hard mode.
//===== Additional Comments: ================================= 
//= 1.0 First version. [Euphy]
//=     Letters "n" and "h" in NPC names indicate difficulty.
//= 1.0a There is no minimum party size on official servers.
//= 1.0b Fixed incorrect use of 'close'. [Joseph]
//= 1.1 Instance system rewrite. [Euphy]
//============================================================ 

// Quest NPCs :: mal_yong
//============================================================
mal_in01,172,28,2	script	Albo#mal	561,{
	if (checkweight(1201,1) == 0) {
		mes "你携带的物品种类太多。减少物品后再继续。";
		close;
	}
	if (MaxWeight - Weight < 1000) {
		mes "你携带的物品太重。减轻负重后再继续。";
		close;
	}
	if (BaseLevel < 90) {
		mes "[Albo]";
		mes "你是谁？";
		mes "我们不需要弱者！！";
		close;
	}
	setarray .@quests[0],12271,12272,12273,12274;
	setarray .@names$[0],
		"General Culvert Daily Service","^990000Hard Culvert Daily Service^000000",
		"General Culvert Weekly Service","^990000Hard Culvert Weekly Service^000000";
	set .@menu$,"Why are doing this job?:";
	for(set .@i,0; .@i<4; set .@i,.@i+1) {
		if (checkquest(.@quests[.@i],PLAYTIME) > -1) {
			set .@status[.@i],2;
			set .@menu$, .@menu$+"^aaaaaa- There is no new task -^000000:";
		} else if (.@i%2 && BaseLevel < 140) {
			set .@status[.@i],0;
			set .@menu$, .@menu$+"^aaaaaaCan't take this job because level is too low^000000:";
		} else {
			set .@status[.@i],1;
			set .@menu$, .@menu$+.@names$[.@i]+":";
		}
	}
	mes "[Albo]";
	mes "我们跨越了大海！";
	mes "我们是下水道的伟大英雄！绝不原谅盯上下水道的海鲜！";
	next;
	set .@i, select(.@menu$)-1;
	if (.@i == 0) {
		mes "[Albo]";
		mes "我们曾是 Missing 先生的手下！差点成为这座历史遗迹的守卫。";
		next;
		mes "[Albo]";
		mes "然而海水淹没所有珍贵资源后，我的梦想……所有梦想都破灭了……";
		next;
		mes "[Albo]";
		mes "我们不会原谅入侵领地的海鲜。我要用辣酱吃掉它们！！！";
		next;
		mes "^0000ff提到辣酱时，Albo 的声音因愤怒而颤抖，还舔了舔嘴唇。^000000";
		close;
	}
	switch(.@status[.@i-1]) {
	case 0:
		mes "[Albo]";
		mes "那个任务对你来说太难了，我不能告诉你。为什么不找另一个？";
		close;
	case 1:
		break;
	case 2:
		mes "[Albo]";
		mes "抱歉，还没有新任务！找到工作后我会告诉你！";
		close;
	}
	switch(.@i) {
	case 1: // General Culvert Daily Service
		switch(rand(1,6)) {
			case 1: callsub L_GiveQuest,.@i,12255,12271,"Deep Sea Crab";
			case 2: callsub L_GiveQuest,.@i,12256,12271,"Deep Sea Marse";
			case 3: callsub L_GiveQuest,.@i,12257,12271,"Deep Sea Vadon";
			case 4: callsub L_GiveQuest,.@i,12258,12271,"Deep Sea Shellfish";
			case 5: callsub L_GiveQuest,.@i,12259,12271,"Deep Sea Kukre";
			case 6: callsub L_GiveQuest,.@i,12260,12271,"Deep Sea Cornutus";
		}
	case 2: // Hard Culvert Daily Service
		switch(rand(1,6)) {
			case 1: callsub L_GiveQuest,.@i,12261,12272,"Deep Sea Marc";
			case 2: callsub L_GiveQuest,.@i,12262,12272,"Deep Sea Sword Fish";
			case 3: callsub L_GiveQuest,.@i,12263,12272,"Deep Sea Strouf";
			case 4: callsub L_GiveQuest,.@i,12264,12272,"Deep Sea Anolian";
			case 5: callsub L_GiveQuest,.@i,12265,12272,"Deep Sea Obeaune";
			case 6: callsub L_GiveQuest,.@i,12266,12272,"Deep Sea Kapha";
		}
	case 3: // General Culvert Weekly Service
		switch(rand(1,2)) {
			case 1: callsub L_GiveQuest,.@i,12267,12273,"Weird Coelacanth";
			case 2: callsub L_GiveQuest,.@i,12268,12273,"Gloomy Coelacanth";
		}
	case 4: // Hard Culvert Weekly Service
		switch(rand(1,2)) {
			case 1: callsub L_GiveQuest,.@i,12269,12274,"Violent Coelacanth";
			case 2: callsub L_GiveQuest,.@i,12270,12274,"Mutant Coelacanth";
		}
	default:
		mes "[Albo]";
		mes "呃！？任务在哪里？让我赶快找找。你必须和 Madeca 谈谈！";
		close;
	}
	end;

// callsub L_GiveQuest,.@i,<quest 1>,<quest 2>,<monster>;
L_GiveQuest:
	setquest getarg(1);
	setquest getarg(2);
	mes "[Albo]";
	mes "今天，下水道的英雄们！";
	mes "让我们高声宣布，消灭 ^0000ff"+getarg(3)+"^000000 的日期！";
	next;
	mes "[Albo]";
	switch(getarg(0)) {
	case 1:
	case 2:
		mes "加油，英雄们！别害怕它们！这是一天任务，直接上吧！";
		break;
	case 3:
		mes "我给你们一周完成任务！在下水道副本普通模式消灭它们！";
		break;
	case 4:
		mes "我给你们一周完成任务！在下水道副本困难模式消灭它们！";
		break;
	}
	next;
	mes "你接到消灭 ^005500"+getarg(3)+"^000000 的委托。详情请查看任务窗口。";
	close;
}

mal_in01,172,26,2	script	Madeca#mal	544,{
	if (checkweight(1201,1) == 0) {
		mes "你携带的物品种类太多。减少物品后再继续。";
		close;
	}
	if (MaxWeight - Weight < 1000) {
		mes "你携带的物品太重。减轻负重后再继续。";
		close;
	}
	if (BaseLevel < 90) {
		mes "[Madeca]";
		mes "咔啊啊啊！！";
		mes "来点可以煮或烤的坏海鲜吧！";
		next;
		mes "[Madeca]";
		mes "你是谁？你真是个蹒跚者。连海藻都能杀了你！";
		close;
	}
	mes "[Madeca]";
	mes "哦？";
	mes "你就是完成我哥哥 Albo 委托的人。那可是艰苦的工作！";
	next;
	set .@i, select("你在这里做什么？:普通下水道每日服务报酬:困难下水道每日服务报酬:普通下水道每周服务报酬:困难下水道每周服务报酬")-1;
	if (.@i == 0) {
		mes "[Madeca]";
		mes "我是来帮助哥哥 Albo 的！";
		next;
		mes "[Madeca]";
		mes "我们为把坏海鲜制成淤泥的人类提供珍贵材料！";
		next;
		mes "[Madeca]";
		mes "每日服务的报酬是 A～B 级硬币，每周服务的报酬是珍贵的海神之怒。";
		next;
		mes "[Madeca]";
		mes "如果你完成哥哥 Albo 的委托，我会经常见到你。我们保持联系吧！";
		close;
	}
	mes "[Madeca]";
	mes "过期委托无法发放报酬，让我检查你的委托是否过期。";
	next;
	specialeffect2 EF_SPHERE;
	progressbar "0xFFFF00",3;
	specialeffect2 EF_STEAL;
	switch(.@i) {
	case 1: // General Culvert Daily Service
		if (checkquest(12271,PLAYTIME) == 2)
			callsub L_EraseQuest,12255,12256,12257,12258,12259,12260,12271;
		else {
			// Reward: 2x B Grade Coin
			callsub L_CheckQuest,12255,"Deep Sea Crab",6419,2;
			callsub L_CheckQuest,12256,"Deep Sea Marse",6419,2;
			callsub L_CheckQuest,12257,"Deep Sea Vadon",6419,2;
			callsub L_CheckQuest,12258,"Deep Sea Shellfish",6419,2;
			callsub L_CheckQuest,12259,"Deep Sea Kukre",6419,2;
			callsub L_CheckQuest,12260,"Deep Sea Cornutus",6419,2;
		}
		break;
	case 2: // Hard Culvert Daily Service
		if (checkquest(12272,PLAYTIME) == 2)
			callsub L_EraseQuest,12261,12262,12263,12264,12265,12266,12272;
		else {
			// Reward: 1x A Grade Coin
			callsub L_CheckQuest,12261,"Deep Sea Marc",6418,1;
			callsub L_CheckQuest,12262,"Deep Sea Sword Fish",6418,1;
			callsub L_CheckQuest,12263,"Deep Sea Strouf",6418,1;
			callsub L_CheckQuest,12264,"Deep Sea Anolian",6418,1;
			callsub L_CheckQuest,12265,"Deep Sea Obeaune",6418,1;
			callsub L_CheckQuest,12266,"Deep Sea Kapha",6418,1;
		}
		break;
	case 3: // General Culvert Weekly Service
		if (checkquest(12273,PLAYTIME) == 2)
			callsub L_EraseQuest,12267,12268,12273;
		else {
			// Reward: 1x Sea God's Wrath
			callsub L_CheckQuest,12267,"Weird Coelacanth",6423,1;
			callsub L_CheckQuest,12268,"Gloomy Coelacanth",6423,1;
		}
		break;
	case 4: // Hard Culvert Weekly Service
		if (checkquest(12274,PLAYTIME) == 2)
			callsub L_EraseQuest,12269,12270,12274;
		else {
			// Reward: 5x Sea God's Wrath
			callsub L_CheckQuest,12269,"Violent Coelacanth",6423,5;
			callsub L_CheckQuest,12270,"Mutant Coelacanth",6423,5;
		}
		break;
	default:
		mes "[Madeca]";
		mes "出了问题。请重新检查！";
		close;
	}
	mes "[Madeca]";
	mes "我没看到完成的任务！";
	close;

L_EraseQuest:
	for(set .@j,0; .@j<getargcount(); set .@j,.@j+1) {
		if (checkquest(getarg(.@j)) > -1)
			erasequest getarg(.@j);
	}
	mes "[Madeca]";
	mes "呃，抱歉。你超过了时限，所以无法领取报酬。";
	close;

// callsub L_CheckQuest,<quest ID>,<monster>,<reward item ID>,<reward item amount>;
L_CheckQuest:
	if (checkquest(getarg(0),HUNTING) == 2) {
		mes "[Madeca]";
		mes "你已经惩罚了 ^0000ff"+getarg(1)+"^000000！";
		mes "这是你的报酬！";
		erasequest getarg(0);
		specialeffect2 EF_STEAL;
		getitem getarg(2),getarg(3);
		close;
	}
	return;
}

// Instance Creation :: pump
//============================================================
mal_in01,160,34,4	script	Missing, the Cleaner	545,{
	if (BaseLevel < 90) {
		mes "[Missing, the Cleaner]";
		mes "你在和我说话吗？！";
		next;
		mes "[Missing, the Cleaner]";
		mes "不知道你为何来到这里，但你不能进入！";
		mes "这是 Tomas 的命令……";
		next;
		mes "^770099你必须达到 Base 等级 90 才能进入。^000000";
		close;
	}
	if (in_canal_n == 0) {
		mes "[Missing, the Cleaner]";
		mes "（发抖）";
		next;
		mes "^660066这只猫看起来状态很差，正在轻微发抖。^000000";
		next;
		if(select("摸摸猫:你还好吗？") == 1) {
			mes "[Missing, the Cleaner]";
			mes "你在和我说话吗？！";
			next;
			mes "^660066一只发抖的猫抬头看着你。^000000";
			close;
		}
		mes "[Missing, the Cleaner]";
		mes "阿嚏！";
		next;
		mes "[Missing, the Cleaner]";
		mes "清理下水道时遇到了很多问题。";
		mes "但猫总得做这件事……";
		next;
		select("你在清理哪座下水道？");
		mes "[Missing, the Cleaner]";
		mes "外来者可能觉得这里陌生，";
		mes "但这里其实用来保存纪念品和奢侈品。";
		next;
		mes "[Missing, the Cleaner]";
		mes "这座岛发生剧烈震动后，东西开始从这里泄漏。";
		mes "所以我成了清洁工，尽管以前是经理。";
		next;
		mes "^660066这只猫看起来哭过……^000000";
		next;
		mes "[Missing, the Cleaner]";
		mes "沿这条路可以到地下室的下水道。";
		mes "那里有很多伤害我的坏家伙。";
		mes "我厌倦了一天打那么多次架！";
		next;
		mes "[Missing, the Cleaner]";
		mes "哦！你碰到我的毛了！";
		mes "我的毛都要掉光了……都是那些家伙害的～";
		next;
		mes "^660066你这才注意到猫身上有些地方没有毛。^000000";
		next;
		select("你为什么不辞职！");
		mes "[Missing, the Cleaner]";
		mes "我还是得谋生，对吧？";
		next;
		mes "[Missing, the Cleaner]";
		mes "有时我能得到幸运箱，";
		mes "或者更好，得到罐头……";
		next;
		if(select("好，干杯！:如果可以，我会帮忙……") == 1) {
			mes "[Missing, the Cleaner]";
		mes "谢谢你。我要回去倒水了！";
			close;
		}
		mes "[Missing, the Cleaner]";
		mes "（压低声音）";
		mes "如果你真的想帮忙，就靠近些！";
		next;
		select("（靠近一些）");
		mes "[Missing, the Cleaner]";
		mes "不是所有人都能在这里当助手。";
		mes "但现在我也没得选……";
		next;
		mes "[Missing, the Cleaner]";
		mes "如果你想下去，让我确认密码。";
		next;
		mes "^660066猫为你潦草写下一张密码备忘录。^000000";
		next;
		select("打开备忘录。");
		mes "^660000Aragam insulted me.^000000";
		next;
		mes "[Missing, the Cleaner]";
		mes "你必须和朋友一起来，不能独自进入！";
		mes "密码由队伍队长提供！";
		next;
		mes "[Missing, the Cleaner]";
		mes "另外，你必须携带海神的庇护。";
		next;
		mes "[Missing, the Cleaner]";
		mes "别忘了！没有海神的庇护我不会开门！";
		set in_canal_n,1;
		close;
	}
	if (rentalcountitem(6436) == 0) {
		mes "[Missing, the Cleaner]";
		mes "你看起来没有海神的庇护。我现在不能开门！";
		close;
	}
	set .@party_id,getcharid(1);
	set .@md_name$,"Culvert";
	if (!.@party_id) {
		mes "^0000ff你必须组织一支队伍，";
		mes "至少有 1 名以上成员，或者加入队伍后再回来。^000000";
		close;
	}
	set .@playtime, checkquest(12254,PLAYTIME);
	if (.@playtime == -1) {
		if (is_party_leader() == true) {
			mes "[Missing, the Cleaner]";
		mes "嗯？怎么了？如果你是队长就告诉我密码！";
			next;
			switch(select("不……没什么。:阿拉甘侮辱了我。:进入下水道。")) {
			case 1:
				mes "[Missing, the Cleaner]";
		mes "真是个新手。";
				close;
			case 2:
				if (instance_create(.@md_name$) < 0) {
					mes "队伍名称："+getpartyname(.@party_id);
					mes "队伍队长："+strcharinfo(0);
					mes "^0000ff"+.@md_name$+"^000000 - Reservation Failed!";
					close;
				}
				mes "^3333FF"+.@md_name$+"^000000 - Reserving";
		mes "预约后，";
		mes "必须选择‘进入下水道’。";
				close;
			case 3:
				callsub L_Enter,0;
			}
		}
		if(select("进入下水道:取消") == 2)
			end;
		callsub L_Enter,1;
	} else if (.@playtime == 0 || .@playtime == 1) {
		mes "大门打开后即可进入下水道。";
		next;
		if(select("进入下水道:取消") == 2)
			close;
		callsub L_Enter,0;
	} else if (.@playtime == 2) {
		mes "^0000ff下水道入口再次开放。^000000";
		erasequest 12254;
		close;
	}
	end;
L_Enter:
	switch(instance_enter("Culvert")) {
	case IE_OTHER:
		mes "发生未知错误。";
		close;
	case IE_NOINSTANCE:
		mes "下水道大门仍然关闭。";
		mes "请等待开放，或寻找能创建副本的队长。";
		close;
	case IE_NOMEMBER:
		mes "只有队伍成员可以参加。";
		close;
	case IE_OK:
		mapannounce "mal_in01", strcharinfo(0)+" of the party "+getpartyname(getcharid(1))+" is entering the Culvert.",bc_map,"0x00ff99";
		if (checkquest(12254) == -1) setquest 12254;
		//warp "1@pump",63,98;
		if (getarg(0) == 0) close;
		else end;
	}
}

// Instance: Common Scripts
//============================================================
1@pump,63,100,4	script	Missing, the Cleaner#0	545,{
	if (is_party_leader() == false) {
		mes "[Missing, the Cleaner]";
		mes "我正在和你的队长交谈。请不要打扰，耐心等待！";
		close;
	}
	mes "[Missing, the Cleaner]";
		mes "这里是你要和朋友一起清理的地下下水道！";
	next;
	mes "[Missing, the Cleaner]";
		mes "我先开门。顺便问一下，你知道怎么战斗吗？";
	next;
	switch(select("我很擅长送面包。:我知道怎么战斗。:^ffffff把钻石给我。^000000")) {
	case 1:
		mes "[Missing, the Cleaner]";
		mes "好，那就像往常一样清理下水道吧！我会在右侧角落准备，请跟我来！";
		next;
		if(select("等等！我改变主意了！:如你所愿～") == 1) {
			mes "[Missing, the Cleaner]";
		mes "嗯？还没准备好？准备好后再来找我。";
			close;
		}
		set 'party_id,getcharid(1);
		mapannounce instance_mapname("1@pump"),"Missing：向 3 点钟方向移动，等待我的下一步命令！",bc_map,"0xff88ff",FW_NORMAL,15;
		disablenpc instance_npcname("Missing, the Cleaner#0");
		enablenpc instance_npcname("Missing, the Cleaner#n");
		close;
	case 2:
		if (BaseLevel < 140) {
			mes "[Missing, the Cleaner]";
			mes "嗯……Missing 觉得你很弱！告诉我实话！！";
			close;
		}
		mes "[Missing, the Cleaner]";
		mes "嗯？你会战斗？那么，有个地方我没能清理……你去那里吧？！";
		next;
		mes "[Missing, the Cleaner]";
		mes "我得告诉你，我们已经很久~~没清理那里了，所以低于 140 级的人甚至不能进入！你确定还要去吗？";
		next;
		if(select("等等！我改变主意了！:当然，我已经准备好了～") == 1) {
			mes "[Missing, the Cleaner]";
			mes "嗯？准备好后再来找我。";
			close;
		}

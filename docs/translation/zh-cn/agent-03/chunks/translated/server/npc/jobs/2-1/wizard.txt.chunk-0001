//===== rAthena Script ======================================= 
//= Wizard Job Quest
//===== By: ================================================== 
//= (Aegis) Translated by yoshiki, converted by kobra_k88
//= Further bugfixed and tested by Lupus
//===== Current Version: ===================================== 
//= 3.3
//===== Compatible With: ===================================== 
//= rAthena Project
//===== Description: ========================================= 
//= [Official Conversion]
//= Job Change quest for Wizard class.
//===== Additional Comments: ================================= 
//= 2.4 Rescripted to Aegis 10.3 standards. [L0ne_W0lf]
//= 2.5 Several bugfixes with the help of Barron-Monster. [L0ne_W0lf]
//= 2.5a More bugfixes care of Barron-Monster. [L0ne_W0lf]
//= 2.5b Fixed tests calling on a non-existant label in "Room of x#Failed" npcs. [L0ne_W0lf]
//= 2.5c Bug fixes. Cleaned up some NPCs slightly. [L0ne_W0lf]
//= 2.6 Fixed Water Room not warping on time-up. [L0ne_W0lf]
//= 2.7 Now uses enable and disable waitingroomevent. [L0ne_W0lf]
//=     Other minor fixes to various NPCs.
//= 2.7a Added end; :D (bugreport:2038) [Yommy]
//= 2.8 Fixed donpcevent to doevent. (bugreport:2311) [SoulBlaker]
//= 2.9 Reverted the change of donpcevent to doevent. [L0ne_W0lf]
//=     Was probably cuased by a warp BEFORE a percentheal
//= 3.0 Added Quest Log commands. [Kisuka]
//= 3.1 Removed the need for use of 'goto.' [L0ne_W0lf]
//= 3.2 Modified the quest to renewal. [Vali] (Thanks to Muad_Dib for the necessary info).
//= 3.3 Fixed waitingroom bug. [Euphy]
//============================================================ 

gef_tower,111,37,4	script	Wizard Guildsman	70,{
	if (Upper == 1) {
		mes "[Catherine]";
		mes "？打扰一下，我们以前见过吗……？";
		mes "嘿~你变化真大！发生什么了？";
		next;
		mes "[Catherine]";
		mes "我感觉你变得强大多了，嗯？";
		mes "恭喜，祝你生活顺利！";
		close;
	}
	if (BaseJob != Job_Mage) {
		if (BaseJob == Job_Wizard) {
			mes "[Catherine]";
			mes "既然你已经是巫师，就没什么事要找我了吧……？";
			mes "那么，失陪了。";
			next;
			mes "[Catherine]";
			if (Sex == SEX_MALE)
				mes "如果你想约我……我很感激……呵呵呵。";
			else
				mes "如果你能给我介绍一个可爱的男孩……我会很感激……呵呵呵！";
			close;
		}
		else if (BaseClass == Job_Novice) {
			mes "[Wizard Guildsman]";
			mes "天啊，是初心者~真是个可爱的小家伙。";
			mes "顺便说，这里是巫师的地方。";
			next;
			mes "[Wizard Guildsman]";
			mes "如果你对魔法感兴趣，";
			mes "去参观^0000FF魔法师^000000公会吧。";
		}
		else {
			mes "[Wizard Guildsman]";
			mes "嗯？你为什么来到这么高的地方……？";
			mes "没有特别事情的话，请立即离开。";
			mes "这里是巫师的地方，知道吗？";
		}
		next;
		mes "[Wizard Guildsman]";
		mes "好吧，再见。";
		close;
	}
	if (WIZ_Q == 0) {
		mes "[Wizard Guildsman]";
		mes "嗯？你跑到这里来做什么……？";
		mes "你为何来到这里？";
		next;
		if (select("我想成为巫师。:……没什么。") == 1) {
			mes "[Wizard Guildsman]";
			mes "我明白了……当然，你想成为巫师，不然也不会爬上这么多楼梯，对吧？";
			mes "总之，欢迎你。我会帮助你成为巫师。";
			next;
			mes "[Wizard Guildsman]";
			mes "我叫凯瑟琳·梅迪奇。告诉你一个秘密，我也刚成为巫师！";
			mes "你愿意的话可以叫我凯茜。呵呵呵呵~";
			next;
			mes "[Catherine]";
			mes "很多人想成为巫师，但只有耐心且坚强的人最终能实现目标。";
			mes "想成为巫师，必须完成艰难的任务。";
			next;
			mes "[Catherine]";
			mes "只有职业等级达到 40 或更高的魔法师才有资格接受这些任务。";
			mes "等级较低的魔法师还没有足够经验成为巫师……";
			next;
			mes "[Catherine]";
			mes "申请转职时，我会给你更多信息。";
			mes "那么！现在要申请吗？";
			next;
			if (select("是的，我要申请。:转念一想，让我再考虑一下。") == 1) {
				if (JobLevel < 40) {
					mes "[Catherine]";
					mes "喂喂，你没听我说吗？";
					mes "我说过至少要职业等级 40 才能报名任务……";
					next;
					mes "[Catherine]";
					mes "不用着急，去体验并思考更多魔法世界吧。";
					mes "我认为你合格时会接受你的申请。";
					close;
				}
				if (SkillPoint) {
					mes "[Catherine]";
					mes "嗯……你很有资格，但还剩一些未使用的技能点。";
					mes "再学习一些技能后再申请吧。";
					close;
				}
				mes "[Catherine]";
				mes "很好，我接受你的申请。";
				mes "你的名字是……" + strcharinfo(0) + "，对吧？我不确定发音是否正确。";
				next;
				mes "[Catherine]";
				mes "巫师转职任务分为 3 个部分。";
				mes "第一部分，收集魔法物品。";
				mes "第二部分，笔试。";
				mes "最后一部分，实际魔法测试。";
				next;
				mes "[Catherine]";
				mes "这些测试中，职业等级 50 的人可以免除其中一项。";
				mes "如果魔法师已经达到这种程度，就足以证明其成为巫师所付出的努力。";
				next;
				if (JobLevel == 50) {
					mes "[Catherine]";
					mes "嗯，说起来，你的职业等级是 50！？";
					mes "你一定非常努力。我能感觉到你会成为强大的巫师。";
					next;
					mes "[Catherine]";
					mes "好吧。你已经通过第一项测试了。";
					mes "不过别太放松，还有两项测试。";
					next;
					mes "[Catherine]";
					mes "去和角落里的男人交谈，他会给你剩余的考试。";
					mes "小心。考试很难，许多魔法师都因此失败。";
					set WIZ_Q,3;
					setquest 9015;
					close;
				}
				mes "[Catherine]";
				mes "既然我已收到你的申请和所需的一切，就告诉你第一项测试的信息。";
				mes "你可以记住或写下来，怎样都行，但一定要记牢。";
				next;
				mes "[Catherine]";
				mes "第一项测试是收集魔法物品。";
				mes "重要的是，你必须亲自收集这些物品。";
				next;
				set wizard_m1,rand(1,2);
				mes "[Catherine]";
				mes "你必须收集的物品是……";
				if (rand(2)) {
					set WIZ_Q,1;
					setquest 9013;
					mes "^3355FF红色宝石^000000 各10个，";
					mes "^3355FF蓝色宝石^000000 各10个，";
					mes "^3355FF黄色宝石^000000 各10个，";
				}
				else {
					set WIZ_Q,2;
					setquest 9014;
					mes "^3355FF水晶蓝^000000 各5个，";
					mes "^3355FF绿色活液^000000 各5个，";
					mes "^3355FF红色血液^000000 各5个，";
					mes "^3355FF翠绿微风^000000 各5个，";
				}
				mes "……很难吗？不会，任何想成为巫师的人至少都应该能取得这些物品。";
				next;
				mes "[Catherine]";
				mes "那么，祝你好运。";
				mes "我会开心地等着。~呵呵。";
				close;
			}
			mes "[Catherine]";
			mes "哦，好吧，慢慢来。";
			mes "我会一直在这里接受申请……*叹气*……总之！~呵呵呵。";
			close;
		}
		mes "[Wizard Guildsman]";
		mes "真是无聊的人。";
		mes "你没事就别来这里了，现在走吧！";
		close;
	}
	else if (WIZ_Q == 1) {
		mes "[Catherine]";
		mes "让我看看，你收齐所有物品了吗？";
		mes "那么检查一下……";
		next;
		if (countitem(716) > 9 && countitem(717) > 9 && countitem(715) > 9) {
			mes "[Catherine]";
			mes "完美！你收齐了所有物品，太棒了~";
			mes "这些物品会在公会中发挥巨大作用。~呵呵呵。";
			next;
			delitem 716,10; //Red_Gemstone
			delitem 717,10; //Blue_Gemstone
			delitem 715,10; //Yellow_Gemstone
			set WIZ_Q,3;
			changequest 9013,9015;
			mes "[Catherine]";
			mes "干得好！你通过了第一项测试。";
			mes "但还有两项测试，别太放松。";
			next;
			mes "[Catherine]";
			mes "去和角落里的那个人交谈，参加剩余测试。";
			mes "可能有点难，小心点。我可不想你和来考试的大多数魔法师一样……可怜的灵魂，愿他们安息。~呵呵。";
			close;
		}
		mes "[Catherine]";
		mes "嘿，这是什么？嗯……我不认为你已经收齐了！";
		next;
		mes "[Catherine]";
		mes "一路爬到这里可能很辛苦，毕竟海拔很高，但回去收集物品吧。";
		mes "人生已经够短了，别再浪费时间，收集我之前说的物品。";
		next;
		mes "[Catherine]";
		mes "^3355FF红色宝石^000000 各10个，";
		mes "^3355FF蓝色宝石^000000 各10个，";
		mes "^3355FF黄色宝石^000000 各10个，";
		mes "这次别忘了，把所有物品都带来，好吗……？";
		close;
	}
	else if (WIZ_Q == 2) {
		mes "[Catherine]";
		mes "你收齐所有物品了吗？";
		mes "让我看看……物品都对吗……？";
		next;
		if (countitem(991) > 4 && countitem(993) > 4 && countitem(990) > 4 && countitem(992) > 4) {
			mes "[Catherine]";
			mes "完美！干得好……我很满意！~呵呵";
			mes "我们公会非常感谢这些物品，并会妥善使用。";
			next;
			delitem 991,5; //Crystal_Blue
			delitem 993,5; //Yellow_Live
			delitem 990,5; //Boody_Red
			delitem 992,5; //Wind_Of_Verdure
			set WIZ_Q,3;
			changequest 9014,9015;
			mes "[Catherine]";
			mes "很好。你已经通过第一项测试。";
			mes "但你还要进行两项测试，别太放松，接下来只会更难。~呵呵呵";
			next;
			mes "[Catherine]";
			mes "去和角落里的那个人交谈，参加剩余测试。";
			mes "可能有点难，小心点。我可不想你和来考试的大多数魔法师一样……真是可怜的灵魂，愿他们安息。~呵呵呵。";
			close;
		}
		mes "[Catherine]";
		mes "咦，这是什么？我不认为你已经收齐了？";
		next;
		mes "[Catherine]";
		mes "很抱歉你辛苦爬到这里，但请重新收集正确的物品。";
		mes "别浪费时间，去拿我最初要求的物品。天哪……这是考试最简单的部分。";
		next;
		mes "[Catherine]";
		mes "^3355FF水晶蓝^000000 各5个，";
		mes "^3355FF绿色活液^000000 各5个，";
		mes "^3355FF红色血液^000000 各5个，";
		mes "^3355FF翠绿微风^000000 各5个，";
		mes "这次别忘了，收集正确的物品，好吗？很快再见……";
		close;
	}
	else if (WIZ_Q == 3) {
		mes "[Catherine]";
		mes "怎么了？你没去和角落里的那个人交谈？";
		mes "只带来我要求的物品可不能成为巫师，不行，这样不行……";
		next;
		mes "[Catherine]";
		mes "完成剩下的两项测试后，你才能证明自己具备巫师资质。";
		mes "我会等着你，现在去吧。";
		close;
	}
	else if (WIZ_Q == 4) {
		mes "[Catherine]";
		mes "*叹气*……可怜的孩子，真遗憾。";
		mes "连这么简单的问题都答不出来，怎么能想着成为巫师？";
		next;
		mes "[Catherine]";
		mes "让我想想……作为前辈，要不要给你一些提示？";
		mes "但我有点渴，给我1瓶苹果汁，我们就成交。~呵呵呵";
		next;
		switch(select("请给我一些提示。:我想自己再试一次！")) {
		case 1:
			if (countitem(531) > 0) {
				delitem 531,1; //Apple_Juice
				mes "[Catherine]";
				mes "好喝，苹果汁最好喝……";
				mes "咕咚咕咚咕咚……哈啊……~呵呵";
				next;
				mes "[Catherine]";
				mes "好吧，那我给你第二项测试的提示。";
				next;
				mes "[Catherine]";
				mes "他会问三类问题。";
				mes "关于魔法、怪物……";
				mes "以及魔法师的问题……也就是巫师。";
				next;
				mes "[Catherine]";
				mes "由他决定要问哪些问题。";
				mes "*叹气*……如果他剪头发并刮胡子，肯定会好看得多……";
				mes "他总是邋里邋遢，因为不照顾自己……*叹气*……真可惜，他本可以成为迷倒女士的帅哥。~嘿嘿嘿";
				next;
				mes "[Catherine]";
				mes "总之，关于魔法的问题……";
				mes "通常是关于你学过的法术。";
				next;
				mes "[Catherine]";
				mes "如果是你没学过、没经历过之类的事情……";
				mes "我听说有个很棒的地方可以查阅资料，而且整理得很好。";
				next;
				mes "[Catherine]";
				mes "你只要施放那个法术，你知道的……看起来像粗大的*e*符号。";
				mes "咒语是……iro.ragnarokonline.com~据说如此！";
				mes "奇怪的咒语，对吧？我自己也不知道怎么让它生效。";
				next;
				mes "[Catherine]";
				mes "至于怪物问题。";
				mes "亲自与它们战斗并学习，是解决这类问题的最佳方式。";
				next;
				mes "[Catherine]";
				mes "不过你知道，普隆德拉有一座大图书馆。";
				mes "你可以在那座图书馆找到大多数怪物的资料。";
				mes "去那里多学习一些也很有帮助。";
				next;
				mes "[Catherine]";
				mes "最后，还有魔法师的问题。";
				mes "这是大多数人无法教你的东西……";
				mes "因为你是魔法师。";
				next;
				mes "[Catherine]";
				mes "连自己都不了解时，很难了解别人，对吧？";
				mes "所以遇到这类问题时，要仔细思考后再回答。";
			}
			else {
				mes "[Catherine]";
				mes "我说过了，给我1瓶苹果汁，我就会考虑给你提示。";
				mes "不然……你就自己想吧。嘿，我不制定规则，只是遵守规则！不过这件事没法争辩。~嘿嘿嘿";
			}
			break;
		case 2:
			mes "[Catherine]";
			mes "是啊，自己解决问题时最有成就感。";
			mes "带着这种精神完成剩下的测试吧！";
		}
		next;
		mes "[Catherine]";
		mes "那么，很快再见！*交叉手指*别落得和前面那些人一样！愿上帝安息他们的灵魂……嗯？没什么！~呵呵呵呵";
		mes "快点，他在等你！";
		close;
	}
	else if (WIZ_Q == 5) {
		mes "[Catherine]";
		mes "嘿嘿嘿~我一直都在听。";
		mes "回答得很好。我想送你点东西，就当礼物……";
		next;
		mes "[Catherine]";
		mes "你还剩一项测试，对吧？";
		mes "再努力一点你就有资格成为巫师了，到时我会给你礼物。~呵呵";
		next;
		mes "[Catherine]";
		mes "回头见，希望如此！";
		mes "他在等你！";
		close;
	}
	else if (WIZ_Q == 6) {
		mes "[Catherine]";
		mes "咦，你在测试中途离开了吗？";
		mes "你……*叹气*……我没想到你会做出这么不光彩的事。";
		next;
		mes "[Catherine]";
		if (Sex == SEX_MALE) {
			mes "虽然你是魔法师，但一个男人怎么能这么弱？！";
			mes "至少你还活着。回去再努力一点。~嘿嘿嘿";
		}
		else {
			mes "别因为是女孩就装弱。看看我！我做到了，你也可以。别指望同情。";
			mes "你一路来到这里就是为了成为巫师！加油，你能做到！！";
			next;
			mes "[Catherine]";
			mes "我承认这很难，但还没难到要放弃的程度。";
			mes "正是你，更应该找到完成这项测试的力量和耐心！";
		}
		next;
		mes "[Catherine]";
		mes "所以这次要更努力……";
		mes "他在等你！";
		close;
	}
	else if (WIZ_Q == 7) {
		if (JobLevel < 40) {
			set WIZ_Q,0;
			mes "[Catherine]";
			mes "嘿，你还不明白吗？";
			mes "我说过至少要职业等级40才能转职，明白了吗？";
			next;
			mes "[Catherine]";
			mes "不用着急，为什么不花点时间学习呢？";
			mes "时机到了，我会张开双臂欢迎你。";
			close;
		}
		if (SkillPoint) {
			mes "[Catherine]";
			mes "你完成所有测试了吗？糟糕，你似乎还剩一些技能点。";
			mes "用剩余技能点学习其他技能，然后再来找我。";
			close;
		}
		mes "[Catherine]";
		mes "哇哦哦哦哦……你完成所有测试了？！";
		mes "恭喜，恭喜，恭喜！呜呼呼呼！~呵呵呵呵呵";
		next;
		mes "[Catherine]";
		mes "不用再等了，我祝贺你。现在我宣布你成为巫师。";
		next;
		completequest 9018;
		callfunc "Job_Change",Job_Wizard;
		callfunc "F_ClearJobVar";		// clears all job variables for the current player
		mes "[Catherine]";
		mes "既然你现在是巫师，就要像巫师一样行事，明白吗？";
		mes "我们巫师拥有魔法的终极力量，所以必须小心。";
		next;
		mes "[Catherine]";
		mes "别无缘无故在城里施法，也别用法术打扰正在战斗的人。";
		mes "巫师的魔法应该用于自己与怪物的战斗。";
		next;
		mes "[Catherine]";
		mes "去和别人组队，继续训练。";
		mes "还有……哦，等等，我给你准备了礼物，稍等。";
		next;
		mes "[Catherine]";
		mes "翻找翻找……";
		mes "窸窸窣窣……";
		next;
		getitem 505,6; //Blue_Potion
		mes "[Catherine]";
		mes "给你。需要时好好使用它。~嘿嘿";
		mes "这是送你的礼物，别拿出去卖。自己使用，好吗？";
		next;
		mes "[Catherine]";
		mes "那么……*叹气*……作为巫师过精彩的生活，成为最强的人吧！";
		close;
	}
}

gef_tower,102,24,2	script	Gloomy Wizard	735,{
	if (BaseJob != Job_Mage) {
		if (BaseJob == Job_Wizard) {
			mes "[Raulel]";
			mes "*咳嗽**咳嗽*你想要什么？";

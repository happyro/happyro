		mes "[利斯特]";
		mes "你好，今天想和我一起研究吗？";
		next;
		mes "[利斯特]";
		mes "照上次那样做就行！";
		next;
		mes "[利斯特]";
		mes "如果要消灭 100 只任意类型的怪物，你愿意参加吗？";
		next;
		if (select( "参加", "不参加" ) == 2) {
			mes "[利斯特]";
			mes "今天……我……无能的……弟子……";
			close;
		}
		mes "[利斯特]";
		mes "很好！明白了。";
		next;
		mes "[利斯特]";
		mes "前往深渊海底洞窟下层，消灭 100 只任意类型的怪物。";
		next;
		mes "[利斯特]";
		mes "一定要小心！";
		close2;
		setquest 3468;
		end;
	case 0:
	case 1:
		mes "[利斯特]";
		mes "消灭 100 只任意类型的怪物。";
		close;
	case 2:
		mes "[利斯特]";
		mes "怎么样？下层的怪物真的很强吗？";
		next;
		mes "[利斯特]";
		mes "你辛苦了……那我得小心下去。";
		next;
		mes "[利斯特]";
		mes "剩下的交给我，非常感谢！！";
		close2;
		erasequest 3468;
		setquest 3469;
		getexp 65000000,45000000;
		end;
	}
	end;

OnInit:
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "BaseLevel >= 180 && isbegin_quest(3470) == 2 && isbegin_quest(3467) == 0" );

	questinfo( QTYPE_QUEST2, QMARK_YELLOW, "checkquest(3468,HUNTING) == 2" );
	questinfo( QTYPE_DAILYQUEST, QMARK_YELLOW, "isbegin_quest(3467) == 2 && checkquest(3469,PLAYTIME) == -1 && checkquest(3468,HUNTING) == -1" );
	questinfo( QTYPE_DAILYQUEST, QMARK_YELLOW, "checkquest(3469,PLAYTIME) == 2" );
	end;
}

// Sector F
prt_prison,117,188,4	script	Prisoner 117FM188#EP161F	4_MISTRESS,{
	if (checkweight(1301,1) == 0) {
		mes "- 由于携带的物品太多，无法继续任务。 -";
		close;
	}
	if (isbegin_quest(5415) < 2) {// Restricted Sector
		emotion ET_BLABLA;
		mes "[Prisoner 117FM188]";
		mes "嘿，你就是新来的仆人吗？";
		next;
		mes "里面的囚犯似乎在找仆人。我想他看见我了，但我只能装作没听见。";
		close;
	}
	if (BaseLevel < 140) {
		mes "[Prisoner 117FM188]";
		mes "啧，啧。即使是仆人也该懂礼貌。";
		close;
	}
	switch( isbegin_quest(5439) ) {
	case 0:
		emotion ET_HNG;
		mes "[Prisoner 117FM188]";
		mes "你就是新来的仆人吗？看来囚犯看守又派了一个人类仆人。";
		next;
		mes "[Prisoner 117FM188]";
		mes "我不喜欢上次那个仆人。他太弱了。不知道你怎么样。";
		next;
		mes "[Prisoner 117FM188]";
		mes "我很担心，但也无能为力。";
		next;
		emotion ET_QUESTION;
		mes "[Prisoner 117FM188]";
		mes "人类仆人。你叫什么名字？我该怎么称呼你？";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "" + strcharinfo(0) + "……";
		next;
		emotion ET_SCRATCH;
		mes "[Prisoner 117FM188]";
		mes "" + strcharinfo(0) + "，真是奇怪又难念的名字！我想叫你的名字，但恐怕做不到。";
		next;
		mes "[Prisoner 117FM188]";
		mes "哦，对了，你是诺耶尔！我喜欢这个名字的发音。从现在起你就叫诺耶尔。";
		next;
		mes "[Prisoner 117FM188]";
		mes "诺耶尔，我有个问题！其他人类囚犯也生活在这种恶劣环境中吗？";
		next;
		mes "[Prisoner 117FM188]";
		mes "我知道自己是这里的囚犯，但不明白他们为什么要把我关在这么肮脏潮湿的地方。";
		next;
		emotion ET_FRET;
		emotion ET_BLABLA;
		mes "[Prisoner 117FM188]";
		mes "诺耶尔，去把那个囚犯看守带来。我有话要和他算账。";
		next;
		emotion ET_SCRATCH, playerattached();
		mes "[" + strcharinfo(0) + "]";
		mes "我觉得那不可能发生。";
		next;
		mes "[Prisoner 117FM188]";
		mes "我不知道仆人无权见囚犯看守。抱歉。";
		next;
		mes "[Prisoner 117FM188]";
		mes "但我不能亲自去那里。那就没法见到他了。我们得想个办法。";
		next;
		mes "[Prisoner 117FM188]";
		mes "... ... ... ... ...";
		next;
		mes "[Prisoner 117FM188]";
		mes "我想起来了。以前伺候我的仆人给过我那个。不知道它还在不在这里。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "是什么物品？";
		next;
		mes "[Prisoner 117FM188]";
		mes "据我所知，那是你们人类使用的东西。它叫除湿机，可以去除周围的湿气。你知道那是什么吗？";
		next;
		setquest 5421;// Restricted Sector F
		setquest 5439;// Refreshing Prison Life
		mes "[Prisoner 117FM188]";
		mes "也许我该用它，因为我没有别的办法。给我带大约20个来。";
		close;
	case 1:
		if (countitem(6921) < 20) {
			mes "[Prisoner 117FM188]";
			mes "诺耶尔，还没给我带除湿机吗？我不需要很多，20个就够了。";
			close;
		}
		emotion ET_DELIGHT;
		mes "[Prisoner 117FM188]";
		mes "诺耶尔，我开始觉得这个潮湿的地方变得清爽了。";
		next;
		mes "[Prisoner 117FM188]";
		mes "做得好。在我再次叫你之前去休息吧。";
		next;
		delitem 6921,20;// Desiccant
		completequest 5439;// Refreshing Prison Life
		setquest 5440;// [Stand by]Refreshing Prison Life
		getexp 700000,500000;
		getitem 6919,4;// TokenOfHonor
		mes "[Prisoner 117FM188]";
		mes "没什么。我用不着，你拿去用吧。";
		close;
	case 2:
		switch( checkquest(5440,PLAYTIME) ) {
		case -1:
			if (isbegin_quest(5441) == 0) {
				emotion ET_SURPRISE;
				mes "[Prisoner 117FM188]";
				mes "诺耶尔，你带来的除湿机似乎不工作。能再带一个新的吗？";
				next;
				if (select( "马上去办。", "啊……我现在还有别的事要做。" ) == 2) {
					emotion ET_OTL;
					mes "[Prisoner 117FM188]";
					mes "诺耶尔！你要去哪里？诺埃尔。";
					close;
				}
				setquest 5441;// [Repeat]Refreshing Prison Life
				mes "[Prisoner 117FM188]";
				mes "谢谢你，诺耶尔。我会等你带来20个除湿机。";
				close;
			}
			if (countitem(6921) < 20) {
				emotion ET_FRET;
				mes "[Prisoner 117FM188]";
				mes "诺耶尔，我什么时候才能拿到那20个除湿机？空气太潮湿了，开始让人不舒服。";
				close;
			}
			emotion ET_FRET;
			mes "[Prisoner 117FM188]";
			mes "你迟到了，诺耶尔。拿除湿机很困难吗？";
			next;
			mes "[Prisoner 117FM188]";
			mes "这潮湿的空气已经开始让我感到不快了。";
			next;
			delitem 6921,20;// Desiccant
			erasequest 5441;// [Repeat]Refreshing Prison Life
			setquest 5440;// [Stand by]Refreshing Prison Life
			getexp 700000,500000;
			getitem 6919,4;// TokenOfHonor
			mes "[Prisoner 117FM188]";
			mes "诺耶尔，你把除湿机拿来了，做得很好。";
			close;
		case 0:
		case 1:
			emotion ET_DELIGHT;
			mes "[Prisoner 117FM188]";
			mes "诺耶尔，我呼吸的空气现在清新极了！";
			next;
			mes "[Prisoner 117FM188]";
			mes "即使囚犯也应该生活在舒适的环境中。记住这一点，诺耶尔，以防万一。";
			close;
		case 2:
			emotion ET_FRET;
			erasequest 5440;// [Stand by]Refreshing Prison Life
			mes "[Prisoner 117FM188]";
			mes "欢迎，诺耶尔。";
			mes "你带来的除湿机似乎运转不佳。该换新的了。";
			close;
		}
	}
}

// Sector G
prt_prison,103,214,4	script	Prisoner 103GD214#EP161G	4_DARKLORD,{
	if (checkweight(1301,1) == 0) {
		mes "- 由于携带的物品太多，无法继续任务。 -";
		close;
	}
	if (isbegin_quest(5415) < 2) {// Restricted Sector
		emotion ET_BLABLA;
		mes "[Prisoner 103GD214]";
		mes "~不停傻笑~";
		next;
		mes "这里的囚犯痛苦地笑着。我觉得他的状态不正常。要不要先不管他？";
		close;
	}
	if (BaseLevel < 140) {
		mes "[Prisoner 117FM188]";
		mes "…… …… …… …… ……";
		close;
	}

	setarray .@flowers[0],
		 710, 100,	// ID, percent
		6509, 50,
		6510, 50,
		 704, 30,
		 709, 30,
		 703, 30,
		 708, 30,
		6511, 10,
		 712, 10;
	.@size = getarraysize(.@flowers);
	for ( .@index = 0; .@index < .@size; .@index += 2 ) {
		if (countitem(.@flowers[.@index]) > 0)
			break;
	}
	switch( isbegin_quest(5442) ) {
	case 0:
		emotion ET_BLABLA;
		mes "[Prisoner 103GD214]";
		mes "~邪恶的笑声持续着~";
		next;
		mes "[Prisoner 103GD214]";
		mes "~傻笑~ 我等客人等了多久？";
		next;
		mes "[Prisoner 103GD214]";
		mes "即使你对我的恐惧把我束缚在这片黑暗之地，也永远无法束缚我的意志。记住我的话。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "你在说什么？";
		next;
		mes "[Prisoner 103GD214]";
		mes "哈哈哈！！我想起来了。";
		next;
		mes "[Prisoner 103GD214]";
		mes "自从那些懦夫不再来到这片黑暗之地，我就因无聊而陷入了长眠。";
		next;
		mes "[Prisoner 103GD214]";
		mes "但、是！";
		next;
		mes "[Prisoner 103GD214]";
		mes "那是我的错。沉睡期间我体内的黑暗变得更强，被黑暗唤醒的追随者改变了这片土地的许多事物。";
		next;
		emotion ET_BLABLA;
		specialeffect EF_DEVIL4;
		specialeffect EF_POISONSMOKE;
		mes "[Prisoner 103GD214]";
		mes "~邪恶的笑声~";
		mes "我不愿承认，但黑暗正在肆虐。我需要一些东西来控制它。";
		next;
		mes "[Prisoner 103GD214]";
		mes "~呻吟~ 人类……";
		mes "我这位大人物可不是每天都会请求你做事。~呻吟~ 给我带来……一些花……";
		next;
		mes "[Prisoner 103GD214]";
		mes "象征世界的花朵不仅能平息黑暗，也能带来心灵的安宁。";
		next;
		mes "[Prisoner 103GD214]";
		mes "~呻吟~ 它一定能有效平息不断增长的黑暗。";
		next;
		specialeffect EF_DEVIL4;
		specialeffect EF_POISONSMOKE;
		mes "[Prisoner 103GD214]";
		mes "啊啊啊——！！";
		next;
		setquest 5422;// Restricted Sector G
		setquest 5442;// Suppressing Darkness
		mes "[Prisoner 103GD214]";
		mes "快点。~呻吟~ 我体内的黑暗正想肆虐。如果你不想看到世界被这黑暗化为灰烬，就给我带来……花……现在就去。";
		close;
	case 1:
		if (.@flowers[.@index] < 1) {
			mes "[Prisoner 103GD214]";
			mes "~呻吟~ 我会在这里等你。什么花都可以。带花来给我。";
			close;
		}
		mes "[Prisoner 103GD214]";
		mes "人类，你把花带来了！";
		mes "~邪恶的笑声~ 人类！你从黑暗手中拯救了世界。高兴吧！";
		next;
		specialeffect EF_HEALSP;
		mes "[Prisoner 103GD214]";
		mes "我能感觉到体内的黑暗正在受到控制。";
		next;
		mes "[Prisoner 103GD214]";
		mes "~呻吟~ 我竟然沦落到要接受人类帮助，真是可悲……";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "你不用谢我。不过，为什么是花？";
		next;
		emotion ET_STARE;
		mes "[Prisoner 103GD214]";
		mes "人类！别这么爱管闲事。";
		next;
		mes "[Prisoner 103GD214]";
		mes "等等。既然你是我的救命恩人，也许告诉你也没关系。";
		next;
		mes "[Prisoner 103GD214]";
		mes "好吧，随便了。我就这一次告诉你。";
		next;
		mes "[Prisoner 103GD214]";
		mes "那是在我统治世界的时候。我和追随者正在征服一座人类城镇。";
		next;
		mes "[Prisoner 103GD214]";
		mes "我在那个村子遇到一个与其他人类不同的女孩。";
		next;
		mes "[Prisoner 103GD214]";
		mes "那些吓破胆的人类忙着逃离我和追随者，但那个女孩不一样。她向我伸出了手。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "然后发生了什么？";
		next;
		mes "[Prisoner 103GD214]";
		mes "你这个人类！难道没人说过你很扫兴吗？";
		next;
		mes "[Prisoner 103GD214]";
		mes "这个故事不值得重复。";
		next;
		mes "[Prisoner 103GD214]";
		mes "你确实帮了我，所以我把追随者留给我的东西之一送给你。";
		next;
		delitem .@flowers[.@index],1;
		completequest 5442;// Suppressing Darkness
		setquest 5443;// [Stand by]Suppressing Darkness
		getexp 700000,500000;
		getitem 6919,4;// TokenOfHonor
		mes "[Prisoner 103GD214]";
		mes "~呻吟~ 如果你不想看到我的黑暗把整个世界拖入灰烬，最好经常来给我带花。";
		close;
	case 2:
		switch( checkquest(5443,PLAYTIME) ) {
		case -1:
			if (isbegin_quest(5444) == 0) {
				specialeffect EF_DEVIL4;
				specialeffect EF_POISONSMOKE;
				mes "[Prisoner 103GD214]";
				mes "啊啊！！黑暗就要肆虐了！";
				next;
				mes "[Prisoner 103GD214]";
				mes "必须控制黑暗。把那朵花给我……快！啊啊！！";
				next;
				mes "[Prisoner 103GD214]";
				mes "人类，请给我一朵花来平息黑暗……";
				next;
				if (select( "好的。", "抱歉，但现在……" ) == 2) {
					specialeffect EF_DEVIL4;
					specialeffect EF_POISONSMOKE;
					mes "[Prisoner 103GD214]";
					mes "我会坚持住的。别回来得太晚……";
					close;
				}
				setquest 5444;// [Repeat]Suppressing Darkness
				mes "[Prisoner 103GD214]";
				mes "求你了……~呻吟~ 人类……";
				close;
			}
			if (.@flowers[.@index] < 1) {
				mes "[Prisoner 103GD214]";
				mes "不好。它快失控了。在黑暗暴走前，给我带来……花……~呻吟~";
				close;
			}
			mes "[Prisoner 103GD214]";
			mes "花……？~呻吟~ 黑暗应该稳定了……";
			next;
			delitem .@flowers[.@index],1;
			if (rand(1,100) > .@flowers[.@index+1]) {
				specialeffect EF_DEVIL4;
				specialeffect EF_POISONSMOKE;
				mes "[Prisoner 103GD214]";
				mes "啊啊啊——！！";
				next;
				mes "- 你刚才给的花已经枯萎了。 -";
				next;
				mes "[Prisoner 103GD214]";
				mes "这朵花不足以平息黑暗。再带些来……！";
				close;
			}
			erasequest 5444;// [Repeat]Suppressing Darkness
			setquest 5443;// [Stand by]Suppressing Darkness
			getexp 700000,500000;
			getitem 6919,4;// TokenOfHonor
			specialeffect EF_HEALSP;
			mes "[Prisoner 103GD214]";
			mes "……有效果。谢谢你，人类。这次你也帮了大忙。";
			next;
			mes "[Prisoner 103GD214]";
			mes "让我把追随者留给我的东西之一送给你。";
			next;
			mes "[Prisoner 103GD214]";
			mes "我体内的黑暗开始肆虐时，会再联系你。";
			close;
		case 0:
		case 1:
			emotion ET_KIK;
			mes "[Prisoner 103GD214]";
			mes "~呻吟~ 祈祷吧，人类。如果不想让我的黑暗肆虐，就祈祷吧。你不会想看到世界末日的。";
			close;
		case 2:
			erasequest 5443;// [Stand by]Suppressing Darkness
			mes "[Prisoner 103GD214]";
			mes "啊啊！！黑暗就要肆虐了！";
			next;
			mes "[Prisoner 103GD214]";
			mes "必须控制黑暗。把那朵花给我……快！啊啊！！";
			close;
		}
	}
}

// Sector H
prt_prison,55,115,2	script	Prisoner 55HK115#EP161H	4_STORMKNIGHT,{
	if (checkweight(1301,1) == 0) {
		mes "- 由于携带的物品太多，无法继续任务。 -";
		close;
	}
	if (isbegin_quest(5415) < 2) {// Restricted Sector
		mes "[Prisoner 55HK115]";
		mes "经理！这里没有经理吗？";
		next;
		mes "我想这里的囚犯可能把监狱当成了某种旅馆。他在找经理。我就先不管这件事。";
		close;
	}
	if (BaseLevel < 140) {
		mes "[Prisoner 55HK115]";
		mes "我想和经理谈，不是普通职员！";
		close;
	}
	switch( isbegin_quest(5445) ) {
	case 0:
		emotion ET_QUESTION;
		mes "[Prisoner 55HK115]";
		mes "你看起来像经理。我得告诉你，这里的服务糟透了。你同意吗，经理？嗯？！";
		next;
		emotion ET_OK;
		mes "[Prisoner 55HK115]";
		mes "你来得正是时候。我一直没时间照料我的角，它还这样挂着。";
		next;
		mes "[Prisoner 55HK115]";
		mes "我的角曾受到那些有角者的称赞……我甚至不敢想象他们现在看到这丑陋的角会怎么说。";
		next;
		mes "[Prisoner 55HK115]";
		mes "在我的角彻底损坏前，我得好好处理它。但这里似乎没有合适的材料。";
		next;
		emotion ET_SURPRISE;
		mes "[Prisoner 55HK115]";
		mes "!!";
		next;
		mes "[Prisoner 55HK115]";
		mes "嘿，经理。我觉得你走运了。我好像找到了正合适的东西。";
		next;
		mes "[Prisoner 55HK115]";
		mes "我看到劣等种族太妃在附近走动。我想它们的皮可以代替砂纸，磨掉我角末端的这些东西。";
		next;

			mes "符文骑士是实现剑与魔法和谐的进阶剑士群体。";
			next;
			mes "这是被称为剑术大师的传奇剑士 Beljeve 的成就，他也是符文骑士的创始人。";
			next;
			mes "符文骑士使用符文石作为魔力媒介，而不是直接运用体内产生的魔力。";
			next;
			mes "过去只有经过长期研究、能驾驭体内魔力的人才能使用魔法，";
			next;
			mes "如今正在直接研究符文魔力，打破人类原有的认知。";
			next;
			mes "据说剑术大师 Beljeve 感受到力量的极限，于是研究克服凡人肉体限制的方法。";
			next;
			mes "我们猜测，在发现通往灰色熔炉的次元裂缝很久以前，他就已与拉斐恩族接触。";
			next;
			mes "拉斐恩族是来自灰色熔炉的妖精，与符文骑士的诞生有密切关系。";
			next;
			mes "如今，即使通常不适合使用魔力的人，也能携带过去凡人无法驾驭的魔法媒介。";
			next;
			mes "研究这些技术的结果，就是与剑的物理力量协调的符文石。";
			next;
			mes "学习将符文石注入剑中的 Beljeve 弟子，后来被称为符文骑士。";
			next;
			break;
		case 2:
			set .@book2,1;
			mes "称为符文的宝石是一种媒介，蕴含无形存在，其魔力与精髓可以直接使用。";
			next;
			mes "拉斐恩贤者 Serpeone 与符文骑士创始人 Beljeve 共同研究符文，研究成果最近才为世人所知。";
			next;
			mes "这是取之不尽的替代能源，相关研究仍在继续。";
			next;
			mes "与人类不同，灰色熔炉的生物将魔力储存在体内。";
			next;
			mes "将魔力转移到符文中的发现由 Beljeve 和 Serpeone 改良，并与符文骑士共享。";
			next;
			break;
		case 3:
			if (.@book1 && .@book2 && job_rune_edq < 11 && (job_rune_edq_book & 1) == 0) {
				set job_rune_edq_book, job_rune_edq_book | 1;
				set job_rune_edq, job_rune_edq+1;
			}
			close;
		}
	}
}

job3_rune01,43,44,1	script	The Principles of Runes	844,{
	if (job_rune_edq < 8) {
		mes "[Rune Knight Renoa]";
		mes "除了未经许可触碰这里的东西，你能理解书中的内容吗？";
		next;
		mes "[Captain Tigris]";
		mes "嘿，Renoa，对那位骑士温和点。你也是，别再未经许可触碰这里的东西。";
		close;
	}
	while(1) {
		switch(select("符文的基本用途:符文的种类:停止阅读")) {
		case 1:
			set .@book1,1;
			mes "符文是一种自古以来在米德加尔特大陆使用的符号，过去只用于神秘学圈子。";
			next;
			mes "符文作为符号系统，据口述传说可用于占卜，也能引出人类潜意识。";
			next;
			mes "符文有自己的系统与种类，根据排列方式能引出不同力量，但目前无法用已知方法测量强度。";
			next;
			mes "幸运的是符文骑士发现了符文的正面用途。符文尚未用于黑魔法，但落入坏人手中很可能被滥用。";
			next;
			break;
		case 2:
			set .@book2,1;
			mes "符文由总共 25 颗小石头制成，十分脆弱，拿取时需要特别小心。";
			next;
			mes "25 颗石头各有含义，其中 14 颗倒置后会产生完全不同的力量与意义，必须研究这些特殊情况。";
			next;
			mes "另外 11 种符文的力量不受位置影响；不掌握 11 种普通符文和 14 种逆位符文，就无法发挥完整力量。";
			next;
			mes "11 种普通符文中，空白符文是例外。";
			next;
			mes "25 种符文石的名称如下：";
			next;
			mes "Ehwaz, Osilia, Mannaz, Ansuz, Hagalas, Kano, Rhydo, Turisus, Dagaz, Sowilo, Laguz, Isia, Pertz, Verkana, Gebo, Algiz, Arwez, Teiwaz, Wunjo, Jera, Nosiege, Ingz, Fehu, Urj.";
			next;
			break;
		case 3:
			if (.@book1 && .@book2 && job_rune_edq < 11 && (job_rune_edq_book & 2) == 0) {
				set job_rune_edq_book, job_rune_edq_book | 2;
				set job_rune_edq, job_rune_edq+1;
			}
			close;
		}
	}
}

job3_rune01,50,36,1	script	Runes, Make & Use	844,{
	if (job_rune_edq < 8) {
		mes "[Rune Knight Renoa]";
		mes "除了未经许可触碰这里的东西之外，你能理解这本书的内容吗？";
		next;
		mes "[Captain Tigris]";
		mes "喂，Renoa，对那位骑士温和一点。还有你，最好别再未经许可触碰这里的东西。";
		close;
	}
	while(1) {
		switch(select("符文石的制作:符文石能力详情:停止阅读")) {
		case 1:
			set .@book1,1;
			mes "制作符文石需要成为符文骑士后学会的符文精通技能。";
			next;
			mes "符文精通就像刻入身体、象征符文骑士的代码。";
			next;
			mes "普通人也能学习这项技能，但需要名为符文熔炉的专用机器。";
			next;
			mes "使用符文熔炉制作符文石时，符文类型由注入的魔力决定，无法改变。";
			next;
			mes "使用符文精通制作符文石时，可以制作想要的属性，但这是符文骑士专属能力。";
			next;
			mes "操作符文熔炉时，身体魔力会被集中并转化为符文石。";
			next;
			break;
		case 2:
			set .@book2,1;
		switch(select("第一章:第二章:第三章:第四章:停止阅读")) {
			case 1:
				mes "Ehwaz——代表幸运增强与正面力量，在符文熔炉中呈红色螺旋。";
				next;
				mes "Osilia——代表等价交换、付出代价的力量，在符文熔炉中呈紫色斜线。";
				next;
				mes "Mannaz——代表希望、新起点及扭转绝境的正面力量，呈翡翠色菱形。";
				next;
				mes "Ansuz——代表准备、安排及克服未来不安的力量，呈翡翠色圆形。";
				next;
				mes "Hagalas——代表自由与反抗束缚的力量，呈天蓝色星形。";
				next;
				mes "Kano——代表火焰、热情及终结一切的力量，呈红色菱形。";
				next;
				break;
			case 2:
				mes "Rhydo——代表组合、重组与完成的力量，呈天蓝色斜线。";
				next;
				mes "Turisus——代表边界与限制的力量，呈黄色圆形。";
				next;
				mes "Dagaz——代表才能与忍受逆境的力量，呈翡翠色螺旋。";
				next;
				mes "Sowilo——代表胜利、成功、安排与停止的力量，呈天蓝色扇形。";
				next;
				mes "Laguz——代表不确定性与保护内部的力量，呈黄色菱形。";
				next;
				mes "Isia——代表停止一切的力量，呈紫色螺旋。";
				next;
				break;
			case 3:
				mes "Pertz——代表启示与机遇的力量，呈银色螺旋。";
				next;
				mes "Verkana——代表富足、诞生、防御与保护的力量，呈金色星形。";
				next;
				mes "Gebo——代表合作与和谐的力量，呈黄色圆锥。";
				next;
				mes "Algiz——代表机遇与挑战的力量，呈翡翠色斜线。";
				next;
				mes "Arwez——代表变化、震荡与运动的力量，呈灰色菱形。";
				next;
				mes "Teiwaz——代表完美胜利与绝对解决的力量，呈金色圆形。";
				next;
				break;
			case 4:
				mes "Wunjo——代表智力与智慧的力量，呈翡翠色星形。";
				next;
				mes "Jera——代表舒适与休息的力量，呈黄色圆形。";
				next;
				mes "Nosiege——代表虚弱与削弱的力量，呈黄色扇形。";
				next;
				mes "Ingz——代表扰乱与分离的力量，呈紫色菱形。";
				next;
				mes "Fehu——代表获得与物质化的力量，呈银色圆形。";
				next;
				mes "Urj——代表命运与限制的力量，呈紫色螺旋线。";
				next;
				break;
			case 5:
				close;
			}
			break;
		case 3:
			if (.@book1 && .@book2 && job_rune_edq < 11 && (job_rune_edq_book & 4) == 0) {
				set job_rune_edq_book, job_rune_edq_book | 4;
				set job_rune_edq, job_rune_edq+1;
			}
			close;
		}
	}
}

mid_camp,238,250,3	script	Rune Knight Sage Guard	468,2,2,{
	mes "[Rune Knight Sage Guard]";
	if (Class == Job_Rune_Knight || Class == Job_Rune_Knight_T || Class == Job_Baby_Rune_Knight) {
		mes "贤者 Serpeone 从符文骑士创立之初就一直与我们并肩。";
		next;
		mes "[Rune Knight Sage Guard]";
		mes "作为符文骑士，我很自豪能与她共事。";
		close;
	}
	if (BaseJob == Job_Knight) {
		if (job_rune_edq < 11) {
			mes "你也许走在剑士之道上，但还不是符文骑士。明白我的意思就别在这里闲逛。";
			close;
		}
		mes "斯普兰迪德是拉斐恩的土地。符文骑士与远征队达成协议，为你提供便利。";
		next;
		mes "[Rune Knight Sage Guard]";
		mes "我们的特工只为参加符文骑士转职测试的学员打开通往斯普兰迪德的道路。";
		next;
		mes "[Rune Knight Sage Guard]";
		mes "但成为符文骑士后，你必须加入远征队，才能充分探索灰色熔炉。";
		close;
	}
	mes "和这个人待在一起对你没好处。继续走你的路。";
	close;
}

mid_camp,13,138,3	script	Dispatched Rune Knight#1	83,2,2,{
	mes "[Dispatched Rune Knight]";
	if (Class == Job_Rune_Knight || Class == Job_Rune_Knight_T || Class == Job_Baby_Rune_Knight) {
		mes "谢谢你的工作。我们会继续为符文骑士考生执行任务。";
		close;
	}
	if (BaseJob == Job_Knight && job_rune_edq > 10) {
		mes "我一直在等符文骑士候选人。受 Serpeone 女士所托，我来帮助考生。";
		next;
		mes "[Dispatched Rune Knight]";
		if (strnpcinfo(0) == "Dispatched Rune Knight#1") {
			mes "要去斯普兰迪德原野吗？";
			next;
		if(select("移动到斯普兰迪德原野:取消。") == 1)
				warp "spl_fild01",355,325;
			close;
		} else if (strnpcinfo(0) == "Dispatched Rune Knight#2") {
			mes "要回远征队据点吗？";
			next;
		if(select("好的。:还没有。") == 1)
				warp "mid_camp",50,153;
			close;
		}
		close;
	}
	mes "嘘……我们的任务不能公开。请继续前进。";
	close;
}
spl_fild01,361,327,3	duplicate(Dispatched Rune Knight#1)	Dispatched Rune Knight#2	83,2,2

spl_fild02,13,241,0	script	#Barricade1	139,10,10,{
	end;
OnTouch:
	if (job_rune_edq > 0 && job_rune_edq < 23) {
		mes "- Whispers of the sage Serpeone are delivered to my mind. -";
		next;
		mes "[Sage Serpeone]";
		mes "在你成为光荣的符文骑士前，我无法帮助你控制米德加尔特的力量。";
		next;
		mes "[Sage Serpeone]";
		mes "请理解这一点，专心完成测试。";
		close2;
		warp "spl_fild02",25,245;
		end;
	}
	end;
}

mid_camp,235,250,3	script	Sage Serpeone	435,2,2,{
	mes "[Sage Serpeone]";
	if (Class == Job_Rune_Knight || Class == Job_Rune_Knight_T || Class == Job_Baby_Rune_Knight) {
		mes "你终于成为光荣的符文骑士。我很高兴能帮助你。";
		next;
		mes "[Sage Serpeone]";
		mes "符文的力量并不完美，还需研究才能确保安全。继续研究就靠我和你这样的符文骑士。";
		next;
		mes "[Sage Serpeone]";
		mes "请虔诚对待符文，希望它照亮你的人生。";
		close;
	}
	if (BaseJob == Job_Knight) {
		if (job_rune_edq < 12) {
			mes "我这个拉斐恩出现在你们的基地，一定很令人惊讶。";
			next;
			mes "[Sage Serpeone]";
			mes "早在次元裂缝开启前，我们中的一些人就在特殊情况下与人类接触。";
			next;
			mes "[Sage Serpeone]";
			mes "多年来我一直与人类通信，为了彼此利益。总之，我就是这样学会你们语言的。";
			next;
			mes "[Sage Serpeone]";
			mes "也许需要一台翻译拉斐恩语的机器，让人类更容易理解我们。";
			next;
			mes "[Sage Serpeone]";
			mes "除此之外……我不能再告诉你。我代表族人在这里，凭特别通行证进入你们营地，不能随便说话。";
			close;
		} else if (job_rune_edq == 12) {
			mes "欢迎，你就是参加符文骑士转职测试的人。我是 Serpeone。";
			next;
			mes "[Sage Serpeone]";
			mes "你至今见过的符文骑士都是我和 Beljeve 教导的弟子。现在你也将加入他们。";
			next;
			mes "[Sage Serpeone]";
			mes "我想 Renoa 已经说明基础知识和注意事项。现在轮到我帮助你了。";
			next;
			mes "[Sage Serpeone]";
			mes "符文骑士使用的魔力与人类世界产生的魔力并不完全相同。";
			next;
			mes "[Sage Serpeone]";
			mes "这里……也就是你们称为灰色熔炉的领域……产生的是这种魔力。";
			next;
			mes "[Sage Serpeone]";
			mes "这里的生物与人类世界生物不同，会将魔力储存在体内。";
			next;
			mes "[Sage Serpeone]";
			mes "符文石的力量就是把体内魔力塑造成符文，以身体作为媒介。";
			next;
			mes "[Sage Serpeone]";
			mes "因此要使用符文石，就必须直接理解另一个领域的生物。";
			next;
			mes "[Sage Serpeone]";
			mes "不过现在让你从这里的生物身上提取魔力还太勉强。";
			next;
			mes "[Sage Serpeone]";
			mes "现在我会在你身上施法，让你能从其他生物收集魔力。";
			next;
			mes "[Sage Serpeone]";
			mes "暂时你可以从人类世界的邪恶生物提取魔力。当然不能直接使用……";
			next;
			mes "[Sage Serpeone]";
			mes "消灭人类世界的邪恶生物并储存能量后，我会将其转化为你能使用的能量。";
			next;
			mes "[Sage Serpeone]";
			mes "它们死后仍残留的凶恶灵魂是强大魔力的来源。";
			next;
			mes "[Sage Serpeone]";
			mes "请消灭 ^0000FF10 个杜拉汉^000000、^0000FF10 个伪装者^000000、^0000FF10 个 Quve^000000、^0000FF10 个 Heirozoist^000000，收集它们的能量。";
			next;
			mes "[Sage Serpeone]";
			mes "先说明，我不会测试或评判你的资格，符文骑士会负责评判。";
			next;
			mes "[Sage Serpeone]";
			mes "有问题或疑问就来找我。";
			set job_rune_edq,13;
			changequest 3207,3208;
			setquest 3209;
			setquest 3210;
			setquest 3211;
			setquest 3212;
			close;
		} else if (job_rune_edq == 13) {
			mes "你收集了足够的魔力吗？还有问题吗？";
			next;
			switch(select("我收集了足够能量。:前往集合地。:停止对话。")) {
			case 1:
				mes "[Sage Serpeone]";
				mes "是这样吗？那就检查一下吧。";
				next;
				if (checkquest(3209,HUNTING) == 2 && checkquest(3210,HUNTING) == 2 && checkquest(3211,HUNTING) == 2 && checkquest(3212,HUNTING) == 2) {
					mes "[Sage Serpeone]";
					mes "嗯，太好了。你的身体已积累足够的生物魔力。";
					next;
					mes "[Sage Serpeone]";
					mes "符文骑士 Renoa 会告诉你符文石的用法。";
					next;
					mes "[Sage Serpeone]";
					mes "我的工作到此为止。希望你成为光荣的符文骑士。";
					next;
					mes "[Sage Serpeone]";
					mes "如果这里还有事，我会把你送到符文骑士集合地。准备好后告诉我。";
					set job_rune_edq,14;
					changequest 3208,3213;
					completequest 3209;
					completequest 3210;
					completequest 3211;
					completequest 3212;
					close;
				}
				mes "[Sage Serpeone]";
				mes "你还没收集足够魔力。";
				next;
				mes "[Sage Serpeone]";
				mes "做好准备，消灭那些怪物并收集足够能量。";
				close;
			case 2:
				mes "[Sage Serpeone]";
				mes "想回集合地吗？我可以立即送你回去。但要继续测试，必须再来找我。";
				next;
				mes "[Sage Serpeone]";
				mes "要回符文骑士集合地吗？";
				next;
				if(select("我要回去。:我想取消。") == 1)
					warp "job3_rune01",80,65;
				close;
			case 3:
				close;
			}
		} else if (job_rune_edq == 14) {
			mes "准备好回符文骑士集合地了吗？";
			next;
			if(select("现在回去。:我还没准备好。") == 1)
				warp "job3_rune01",80,65;
			close;
		}
		mes "准备工作顺利吗？";
		next;
		mes "[Sage Serpeone]";
		mes "你现在的状态不对吧？";
		next;
		mes "[Sage Serpeone]";
		mes "那我把你送到应该去的符文骑士集合地。";
		next;
		if(select("我现在回去。:我会留下。") == 1)
			warp "job3_rune01",80,65;
		close;
	}
	mes "我这个拉斐恩出现在你们的基地，一定很令人惊讶。";
	next;
	mes "[Sage Serpeone]";
	mes "早在次元裂缝开启前，我们中的一些人就在特殊情况下与人类接触。";
	next;
	mes "[Sage Serpeone]";
	mes "多年来我一直与人类通信，为了彼此利益。总之，我就是这样学会你们语言的。";
	next;
	mes "[Sage Serpeone]";
	mes "也许需要一台翻译拉斐恩语的机器，让人类更容易理解我们。";
	next;
	mes "[Sage Serpeone]";
	mes "除此之外……我不能再告诉你。我代表族人在这里，凭特别通行证进入你们营地，不能随便说话。";
	close;
}

job3_rune01,114,50,3	script	Rune Knight Velpino	468,{
	if (Class == Job_Rune_Knight || Class == Job_Rune_Knight_T || Class == Job_Baby_Rune_Knight) {
		mes "[Rune Knight Velpino]";
		mes "你仍带着雏鸟气息。为符文骑士带来荣耀，提升你的力量……";
		close;
	}
	if (BaseJob == Job_Knight) {
		if (job_rune_edq < 17) {
			mes "一名从头到脚穿着黑衣、气息冰冷的符文骑士正瞪着我。";
			next;
			mes "为什么符文骑士不是话痨，就是沉默又好斗……？";
			next;
			mes "[Captain Tigris]";
			mes "嘿……那我呢？我不是那样！";
			close;
		} else if (job_rune_edq == 17) {
			mes "[Rune Knight Velpino]";
			mes "没想到今天真有候选人来到我这里……";
			next;
			mes "[Rune Knight Velpino]";
			mes "恭喜！你来到了期待已久的最终测试……我想你已经掌握基础了。";
			next;
			mes "[Rune Knight Velpino]";
			mes "最终测试相对简单。消灭古城里的所有魔法怪物，一切就结束……";
			next;
			mes "[Rune Knight Velpino]";
			mes "唯一条件是必须使用之前测试中制作的符文石消灭这些怪物。";
			next;
			mes "[Rune Knight Velpino]";
			mes "这项测试只能装备单手武器、盾牌或双手武器。";
			next;
			mes "[Rune Knight Velpino]";
			mes "可使用的武器总重量不得超过 400。提供 30 个攻击型符文石和 30 个防御型符文石。";
			next;
			mes "[Rune Knight Velpino]";
			mes "为了使用这些符文，我会为你施加特殊增益法术。";
			next;
			mes "[Rune Knight Velpino]";
			mes "魔法怪物是古城里你可能已经知道的 3 种魔法怪物……战斗不会轻松，但经历最终磨炼后，你就走上了符文骑士之路。";
			next;
			mes "[Rune Knight Velpino]";
			mes "为了帮助准备，我们与艾尔帕兰的卡普拉总部签约，特派一名卡普拉职员到集合地。去见她会很有帮助。";
			next;
			mes "[Rune Knight Velpino]";
			mes "准备好后再来找我。";
			set job_rune_edq,18;
			changequest 3216,3217;
			close;
		} else if (job_rune_edq > 17 && job_rune_edq < 21) {
			if (countitem(12388)+countitem(12389)+countitem(12390) == 0) {
				mes "[Rune Knight Velpino]";
				mes "准备完成后，我会把你送到最终测试场。";
				set job_rune_edq,18;
				next;
				if(select("进入最终测试场。:我还没准备好。") == 2) close;
				if (getequipisequiped(EQI_HEAD_TOP) || getequipisequiped(EQI_ARMOR) || getequipisequiped(EQI_GARMENT) || getequipisequiped(EQI_SHOES) ||
				    getequipisequiped(EQI_ACC_L) || getequipisequiped(EQI_ACC_R) || getequipisequiped(EQI_HEAD_MID) || getequipisequiped(EQI_HEAD_LOW)) {
					mes "[Rune Knight Velpino]";
					mes "这项测试只能装备单手武器、盾牌或双手武器。其他装备交给中央的卡普拉职员保管。";
					close;
				}
				if (checkquest(3220,PLAYTIME) == 1) {
					mes "[Rune Knight Velpino]";
					mes "你不是测试失败了吗……失败后 10 分钟内不能再次进入。";
					next;
					mes "[Rune Knight Velpino]";
					mes "这是为其他等待测试的考生着想，请在指定时间后再回来。";
					close;
				}

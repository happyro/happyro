	npctalk "洛基：即使燃烧自己的身体，你的力量也远不及创世之伊米尔。", .@loki$;
	sleep2 5000;
	npctalk "洛基：你不得不偷取世界树，仅此一点就说明你缺乏创造力。", .@loki$;
	sleep2 5000;
	npctalk "洛基：好好看看自己。你若以为自己像什么创造者，那只是妄想。", .@loki$;
	sleep2 5000;
	npctalk "尼德霍格：我赞同。这个世界不需要你，你不属于这里。", .@nidhogg$;
	sleep2 4000;
	npctalk "尼德霍格：就连世界树也否定你的存在！", .@nidhogg$;
	sleep2 4000;
	npctalk "尼德霍格：身为世界树守护者，我必须把你从这个世界清除。", .@nidhogg$;
	sleep2 2000;
	npctalk "梦罗克：呸！";
	sleep2 2000;
	npctalk "梦罗克：凡人，敢这样挑战我，你一定是在求死。";
	sleep2 3000;
	npctalk "梦罗克：我要把你的血肉当作新世界的乔迁礼物。";
	sleep2 3000;
	npctalk "梦罗克：你见识过创世的黑暗吗？";
	sleep2 3000;
	npctalk "梦罗克：你见识过生命起源的寒霜吗？";
	sleep2 6000;
	npctalk "梦罗克：看看我在这个世界复活的奥德姆拉寒霜。";
	sleep2 3000;
	specialeffect EF_ENTRY;
	if ('step == 3) {
		'step = 4;
		disablenpc instance_npcname("Strange Boy#mockid01");
		donpcevent instance_npcname("#gate_to_ice") + "::OnEnable";
		enablenpc instance_npcname("Nidhogg#eomnyd01");
		enablenpc instance_npcname("Brinaranea#brinpc01");
		npctalk "洛基：你要逃跑吗？", .@loki$;
		sleep2 2000;
		disablenpc .@loki$;
	}
	setpcblock PCBLOCK_NPC, false;
	end;
}


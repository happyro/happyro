1@eom,100,122,3	script	Morroc#mockid02	4_F_MOCBOY,{
	if ('step != 6 || is_party_leader() == false || checkquest(7593,HUNTING) != 1)
		end;
	cutin "morocc_kid.bmp",2;
	mes "[梦罗克]";
	mes "你很不错。";
	mes "能挑战吞噬太阳的狼吗？";
	npctalk "梦罗克：你很不错。能挑战吞噬太阳的狼吗？";
	next;
	mes "[Morroc]";

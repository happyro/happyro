que_job01,81,79,5	script	Idle Knight#dan_08	733,{
	mes "[Litheron]";
	mes "怎么了？哦，我明白了……你大概想知道，像我这样的骑士为什么会在秘密刺客酒吧。";
	if (BaseClass == Job_Knight) {
		mes "你呢？";
	}
	next;
	mes "[Litheron]";
	mes "我只是来喘口气。这些重建工作快把我累垮了。如今想找个地方喝一杯几乎不可能，你懂我的意思吧。";
	close;
}

que_job01,82,95,3	script	Bar Master#moc_main01	46,{
	if (checkweight(908,200) == 0) {
		mes "^3355FFWait a second!";
		mes "你现在携带的物品太多了。";
		mes "请使用卡普拉服务存放一些物品后再回来。^000000";
		close;
	}
	if (BaseClass == Job_Assassin) {
		mes "[Master]";
		mes "请进。要喝一杯吗？";
	}
	else if ((BaseJob == Job_Thief) && (BaseClass != Job_Assassin)) {
		mes "[Master]";
		mes "......Huh. How did a ruffian like you get in here?";
		mes "看来 Jack 没做好他的工作。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "嘿，老板，别这么严厉。我们认识，对吧？";
		mes "你不会想伤害老朋友的感情吧~";
		next;
		mes "[Master]";
		mes "随你怎么说。那么，你想喝什么？";
	}
	else {
		mes "[Master]";
		mes "....Hmm...";
		mes "你想喝什么？";
	}
	next;
	switch(select("点饮料:询问任务:取消")) {
	case 1:
		mes "[Master]";
		mes "这里我只提供两种饮料。你要热带苏格拉特，还是沙滩绯红？";
		next;
		switch(select("热带苏格拉特:沙滩绯红:有免费饮料吗？")) {
		case 1:
			if (checkweight(908,200) == 0) {
				mes "[Master]";
				mes "嘿，你为什么带这么多东西？没有空间携带的话，我不能给你饮料。清理一下你的物品栏！";
				close;
			}
			else {
				if (BaseClass == Job_Assassin) {
					if (Zeny < 800) {
						mes "[Master]";
						mes "你知道吗……这杯饮料本来要收 800 Zeny，但看来你现在付不起。准备好 Zeny 后再回来吧。";
					}
					else {
						mes "[Master]";
						mes "大多数酒保通常会收 1,000 Zeny，但我只要 800。朋友，好好享用，像品味人生一样畅饮吧。";
						set Zeny, Zeny-800;
						getitem 12112,1; //Tropical_Sograt
					}
					close;
				}
				else {
					if (Zeny < 1000) {
						mes "[Master]";
						mes "嘿，你没有钱买这杯饮料。想让我调一杯的话，记得带 1,000 Zeny 回来，好吗？";
						close;
					}
					else {
						mes "[Master]";
						mes "刺客的话，我收费 800 Zeny，但对你要收 1,000。别介意，但你能来到这里已经很幸运了。嘿，好好享用饮料~";
						set Zeny, Zeny-1000;
						getitem 12112,1; //Tropical_Sograt
						close;
					}
				}
			}
		case 2:
			if (checkweight(908,200) == 0) {
				mes "[Master]";
				mes "嘿，你为什么带这么多东西？没有空间携带的话，我不能给你饮料。清理一下你的物品栏！";
				close;
			}
			else {

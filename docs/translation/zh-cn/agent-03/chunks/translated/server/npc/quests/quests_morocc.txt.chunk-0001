// Stop Post Quest
// ============================================================
-	script	William	89,{
	mes "[William]";
	mes "欢迎来到 MacMillan 的^3355FF路障^000000工坊。";
	next;
	mes "[William]";
	mes "我们 MacMillan 家族生产专业交通信号路障已有 250 多年。如今，我们接受独特装饰品^3355FF停车路障^000000的特别订单。";
	next;
	switch(select("我能订购一个^3355FF停车路障^000000吗？:不了……")) {
	case 1:
		mes "[William]";
		mes "这种独特装饰品^3355FF停车路障^000000既是道路交通信号，也能当作发饰！我们以百年保证郑重承诺。";
		next;
		mes "[William]";
		mes "制作^3355FF停车路障^000000需要^3355FF91100 Zeny^000000、^3355FF50 根树枝^000000和^3355FF1 份黑色染料^000000。";
		next;
		if ((countitem(1019) > 49) && (countitem(983) > 0) && (Zeny > 91099)) {
			delitem 1019,50;  //Wooden_Block
			delitem 983,1;  //Black_Dyestuffs
			set Zeny, Zeny-91100;
			mes "[William]";
			mes "给你~！这个^3355FF停车路障^000000是专门为你制作的！谢谢光临！";
			mes "...Get the joke?";
			getitem 2272,1; // Stop_Post
			close;
		}
		else {
			mes "[William]";
		mes "那么……集齐材料后再来，我们会给你一个停车路障。";
			close;
		}
	case 2:
		mes "[William]";
	mes "总之，谢谢你来‘MacMillan 工坊’。下次考虑买点东西，好吗？";
		close;
	}
}

// Binoculars Quest
// ============================================================
-	script	Alchemist	64,{
	mes "[Marius]";
	mes "你好，新顾客！！我知道你想谈什么。你想从我这里买魔法眼镜，对吧？";
	next;
	switch(select("那是什么？:制作:不理他")) {
	case 1:
		mes "[Marius]";
		mes "嗯~！它们的正式名称是^3355FF望远镜^000000！这种光学设备像野外双筒镜，设计为双眼同时使用！";
		next;
		mes "[Marius]";
		mes "它由两个小望远镜和一个调焦装置组成。调整镜片后可以产生立体视觉。";
		next;
		mes "[Marius]";
		mes "怎么样？很厉害吧？呜哈哈哈哈！";
		mes ". . . . .";
		next;
		mes "[Marius]";
		mes "嗯？你似乎不相信我说的话？拜托，混蛋，这是真的！！";
		next;
		mes "[Marius]";
		mes "我告诉你需要的材料……";
		mes "1 ^3355FFGeek Glasses^000000! 100 ^3355FFSteel^000000!";
		mes "还有^3355FF50000 Zeny^000000！";
		close;
	case 2:
		if ((countitem(2243) > 0) && (countitem(999) > 99) && (Zeny > 49999)) {
			mes "[Marius]";
			mes "完美，完美！现在我的杰作完成了！呜哈哈哈！";
			next;
			delitem 2243,1;  //Spinning_Eyes
			delitem 999,100;  //Steel
			set Zeny, Zeny-50000;
			mes "[Marius]";
			mes "给你！望远镜！";
			getitem 2296,1; // Binoculars
			next;
			mes "[Marius]";
			mes "记住……别偷看不该看的东西。至少尽量别看。";
			close;
		}
		else {
			mes "[Marius]";
			mes "啊啊啊啊！！你带来的材料不够！！竟敢让我丢脸！！！太差劲了！！";
			close;
		}
	case 3:
		mes "[Marius]";
		mes "嘿，你~！现在你站在炼金术士中的炼金术士 Marius 面前。敢无视我？看我教训你！";
		close;
	}
}


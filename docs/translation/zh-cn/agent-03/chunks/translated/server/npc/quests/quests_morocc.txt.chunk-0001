que_job01,80,77,0	script	que_job01#04	45,2,2,{
OnTouch_:
	if (BaseClass == Job_Assassin) {
		warp "que_job01",61,50;
		end;
	}
	else if (mao_request > 0) {
		warp "que_job01",61,50;
		end;
	}
	else {
		mes "[Litheron]";
		mes "哇，你不该在这里。嘿，老板！你";
		mes "认识这个人吗？";
		next;
		if (prt_curse == 24) {
			mes "[" + strcharinfo(0) + "]";
			mes "不管你说什么，我都要进去！！！";
			next;
			mes "[Litheron]";
			mes "嘿，老板！我们拿这个人怎么办？他看起来很强！";
			next;
			mes "[Master]";
			mes "嗯，让他做想做的事吧。通过一扇门不会有什么影响。";
			next;
			mes "[Litheron]";
			mes "哈！听见了吗？这样吧，你买杯饮料我就让你进去。而且你不能在这里闹事：这里到处都是致命的刺客。";
			next;
			switch(select("好:凭什么？！")) {
			case 1:
				if (Zeny > 999) {
					mes "[Litheron]";
					mes "嘿，这才对嘛！嘿，酒保！照老样子来！我喜欢你的风格，冒险者……";
					set Zeny, Zeny-1000;
					next;
					mes "[Litheron]";
					mes "好，你可以进去了。但绝对不许向任何活人透露这个酒吧的事。";
					close2;
					warp "que_job01",61,50;
					end;
				}
				else {
					mes "[Litheron]";
			mes "嗯……哦，你连在这里买水的钱都没有。真是的……想进来的话，先准备好现金！";
					close2;
					warp "que_job01",85,77;
					end;
				}
			case 2:
				mes "[Litheron]";
			mes "你不是很机灵，对吧……好吧，好吧。既然你不帮我，我为什么要帮你？走开！";
				close2;
				warp "que_job01",85,77;
				end;
			}
		}
		else {
			mes "[Master]";
			mes "完全不认识。别让这个人进来。";
			next;
			mes "[Litheron]";
			mes "你听见他说的了。趁你还有腿，赶快离开这里……";
			close2;
			warp "que_job01",85,77;
			end;
		}
	}
}


morocc,43,108,5	script	Sharp-Looking Kid#dan_07	82,{
	if (BaseClass == Job_Assassin) {
		mes "[Jack]";
		mes "尽管他们的城镇一片混乱，仍有一些人会来这里。也许这座据点本身就独一无二……";
		close;
	}
	else {

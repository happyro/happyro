	disablenpc "Examiner#sd";
	end;
}

alberta_in,125,101,5	script	Wealthy-looking Merchant	807,{
	callfunc "F_UpdateSignVars";
	mes "[Bakerlan]";
	if (sign_q < 35) {
		mes "嗯……那就这样……我来处理普隆德拉的事……还有朱诺……啊……真麻烦……嘟囔嘟囔……";
		close;
	}
	else if (sign_q == 35) {
		mes "天啊……我不知道该怎么处理朱诺……";
		mes "?";
		mes "你是谁？";
		next;
		switch(select("没什么。:Metz 先生派我来的。")) {
		case 1:
			mes "[Bakerlan]";
			mes "嗯……我现在很忙，请别再打扰。如果你在找工作，请询问我的管家。";
			close;
		case 2:
			mes "[Bakerlan]";
			mes "啊……他派你来的？……嗯……很遗憾我有点忙……请稍后再来好吗？谢谢。";
			set sign_q,36;
			close;
		}
	}
	else if (sign_q == 36) {
		mes "嗯……？你完成了 Dearle 挑战之前的所有测试？用你的啜泣星光碎片证明给我看……";
		next;
		switch(select("等我一下……:给你……")) {
		case 1:
			mes "[Bakerlan]";
			mes "你最好快点回来。我是个忙碌的商人，时间很宝贵。";
			close;
		case 2:
			if (countitem(7177) < 5) {
				mes "[Bakerlan]";
				mes "嗯，我想你还没完成所有测试。这些啜泣星光碎片还不够……";
				close;
			}
			else if (countitem(7177) == 5) {
				mes "[Bakerlan]";
				mes "啊，我明白你说的是真的。好，我们开始我的测试。";
				next;
				mes "[Bakerlan]";
				mes "首先，我要你进行一次配送。要配送的物品很昂贵，必须小心处理。弄丢就会失败。现在去找我的管家了解详情。";
				set sign_q,37;
				close;
			}
			else {
				mes "[Bakerlan]";
				mes "嗯？你不可能有这么多啜泣星光碎片！这些一定是假的。你竟敢骗我！滚！";
				close;
			}
		}
	}
	else if (sign_q < 40) {
		mes "关于测试配送的一切事宜，请询问我的管家。";
		close;
	}
	else if (sign_q == 40) {
		mes "啊，是的，Mahatra 告诉我你完成了配送。嗯，他现在还有另一项任务给你。请再去找他。";
		set sign_q,41;
		close;
	}
	else if (sign_q < 52) {
		mes "你还没完成。为什么不先完成它们？我是个忙碌的商人。";
		close;
	}
	else if (sign_q == 52) {
		mes "啊，我听说过你。虽然你有自己的目标，但不一定意味着要帮助那个孩子。我想 Metz 一定很会识人。";
		next;
		mes "[Bakerlan]";
		mes "我本想按自己的计划给你安排任务，但最近忙于处理与昆仑和天津的贸易。";
		next;
		mes "[Bakerlan]";
		mes "几年前与天津贸易时，我认识了 Seyling。还把她的弟弟介绍给普隆德拉王室。不过，";
		next;
		mes "[Bakerlan]";
		mes "我本想继续测试你，但我太忙了。";
		mes "而且我觉得继续测试对你也没好处。";
		mes "现在结束测试吧。";
		mes "你已经足够合格了。";
		next;
		mes "[Bakerlan]";
		mes "给你。";
		mes "我是最后一个测试你资格的人。";
		mes "现在把所有石头碎片带给 Metz。";
		mes "他会告诉你接下来该做什么。";
		set sign_q,53;
		getitem 7177,1; //Part_Of_Star's_Sob
		if (checkre(3)) {
			if (BaseLevel < 60) getexp 500,0;
			else if (BaseLevel < 70) getexp 800,0;
			else if (BaseLevel < 80) getexp 1100,0;
			else if (BaseLevel < 90) getexp 1500,0;
			else getexp 2000,0;
		} else {
			if (BaseLevel < 60) getexp 5000,0;
			else if (BaseLevel < 70) getexp 8000,0;
			else if (BaseLevel < 80) getexp 11000,0;
			else if (BaseLevel < 90) getexp 15000,0;
			else getexp 20000,0;
		}
		close;
	}
	else if (sign_q == 97) {
		mes "嗯……";
		mes "是我看错你了，还是 Metz 看错了？";
		mes "……我和你没别的事了。";
		mes "保重。";
		close;
	}
	else if (sign_q == 98) {
		mes "嗯……那么……";
		mes "我来处理普隆德拉的事……";
		mes "还有朱诺……";
		mes "啊……";
		mes "真麻烦……";
		mes "嘟囔嘟囔……";
		close;
	}
	else {
		mes "进展如何？";
		mes "其实我们想自己处理……";
		mes "但工作实在太忙了……";
		mes "希望你继续努力。";
		mes "我也很好奇那块石头是什么。";
		close;
	}
}


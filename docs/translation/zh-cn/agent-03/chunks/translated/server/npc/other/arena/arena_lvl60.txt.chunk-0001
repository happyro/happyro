arena_room,38,88,5	script	Lv60 Waiting Room	124,{
	end;

OnInit:
	waitingroom "Individual; Level 60 to 79",50,"Lv60 Waiting Room::OnStartArena",1,1000,60,79;
	enablewaitingroomevent;
	end;

OnStartArena:
	warpwaitingpc "force_2-1",99,12;
	donpcevent "arena#60::OnStart";
	disablewaitingroomevent;
	end;

OnStart:
	enablewaitingroomevent;
	end;
}

force_2-1,99,20,4	script	Minilover#arena	124,{
	end;

OnStart:
	initnpctimer;
	set $arena_min60st,gettime(DT_MINUTE);
	set $arena_sec60st,gettime(DT_SECOND);
	end;

OnTimer3000:
	mapannounce "force_2-1","大家好，我叫小爱，是60级时空战斗的向导！",0;
	end;

OnTimer4000:
	mapannounce "force_2-1","记住，正确的决定会为你节省大量时间！",0;
	end;

OnTimer5000:
	mapannounce "force_2-1","要完成战斗课程，你必须从房间最左侧开始顺时针前进。请移动到最左边，现在开始计时6分钟。",0;
	end;

OnTimer60000:
	if (getmapusers("force_2-1") == 0) {
		donpcevent "Minilover#arena::OnFailClearStage";
	}
	mapannounce "force_2-1","剩余时间：5分钟",0;
	end;

OnTimer120000:
	if (getmapusers("force_2-1") == 0) {
		donpcevent "Minilover#arena::OnFailClearStage";
	}
	mapannounce "force_2-1","剩余时间：4分钟",0;
	end;

OnTimer180000:
	if (getmapusers("force_2-1") == 0) {
		donpcevent "Minilover#arena::OnFailClearStage";
	}
	mapannounce "force_2-1","剩余时间：3分钟",0;
	end;

OnTimer240000:
	if (getmapusers("force_2-1") == 0) {
		donpcevent "Minilover#arena::OnFailClearStage";
	}
	mapannounce "force_2-1","剩余时间：2分钟",0;
	end;

OnTimer300000:
	if (getmapusers("force_2-1") == 0) {
		donpcevent "Minilover#arena::OnFailClearStage";
	}
	mapannounce "force_2-1","剩余时间：1分钟",0;
	end;

OnTimer360000:
	mapannounce "force_2-1","时间到了。希望你玩得开心～",0;
	end;

OnTimer365000:
OnTimer366000:
OnTimer367000:
OnTimer368000:
OnTimer369000:
OnTimer370000:
OnTimer371000:
OnTimer372000:
OnTimer373000:
OnTimer374000:
	mapwarp "force_2-1","prt_are_in",126,139,0,0;
	end;

OnTimer375000:
	mapwarp "force_2-1","prt_are_in",126,139,0,0;
	donpcevent "Minilover#arena::OnFailClearStage";
	end;

OnTimerOff:
	stopnpctimer;
	end;

OnFailClearStage:
 	donpcevent "cast#60::OnTimeOver1";
	mapwarp "force_2-1","prt_are_in",126,139,0,0;
	donpcevent "Minilover#arena::OnTimerOff";
	donpcevent "arena#60::OnReset_All";
	donpcevent "alloff#60::OnEnable";
	donpcevent "Lv60 Waiting Room::OnStart";
	end;

On01_Start:
	mapannounce "force_2-1","要通过此战斗，你必须在躲避洛塔尔·扎伊罗斯的同时至少击杀5只哥布灵！",0;
	end;

On01_End:
	mapannounce "force_2-1","通往北侧房间的门打开了！",0;
	end;

On02_Start:
	mapannounce "force_2-1","躲开怪物，从北侧出口逃出去！",0;
	end;

On02_End:
	mapannounce "force_2-1","通往北侧房间的门打开了！",0;
	end;

On03_Start:
	mapannounce "force_2-1","要通过此战斗，你必须击杀所有螳螂！",0;
	end;

On03_End:
	mapannounce "force_2-1","通过！通往东侧房间的门打开了！",0;
	end;

On04_Start:
	mapannounce "force_2-1","要通过此战斗，你必须在躲避主动怪物的同时击杀所有非主动怪物！",0;
	end;

On04_End:
	mapannounce "force_2-1","通往东侧房间的门打开了！",0;
	end;

On05_Start:
	mapannounce "force_2-1","要通过此战斗，你必须击杀除九蛇和卡帕以外的所有怪物！",0;
	end;

On05_End:
	mapannounce "force_2-1","通过！通往南侧房间的门打开了！",0;
	end;

On06_Start:
	mapannounce "force_2-1","要通过此战斗，你必须击杀所有雅美人偶并从南侧出口逃出！",0;
	end;

On06_End:
	mapannounce "force_2-1","通往南侧房间的门打开了！",0;
	end;

On07_Start:
	mapannounce "force_2-1","要通过此战斗，你必须击杀所有怪物！",0;
	end;

On07_End:
	mapannounce "force_2-1","通过！通往西侧房间的门打开了！",0;
	end;

On08_Start:
	mapannounce "force_2-1","请从北侧出口逃出！",0;
	end;

On09_Start:
	mapannounce "force_2-1","要通过此战斗，你必须击败哥布灵首领！",0;
	end;

On09_End:
	mapannounce "force_2-1","首领已击败！北侧出口已打开。谢谢。",0;
	end;
}


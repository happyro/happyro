	mes "你替我做件事。";
		next;
		if (select("听着:重新考虑") == 1) {
			mes "[Hianna]";
			mes "首先，我要一点现金，算作租借费。500,000 Zeny 差不多够了。然后，我要你帮个忙。";
			next;
			mes "[Hianna]";
			mes "施瓦茨瓦尔德共和国请我派舞者参加聚会，但我没有足够卫兵护送她们。";
			next;
			mes "[Hianna]";
			mes "如果你护送我的舞者前往施瓦茨瓦尔德共和国，回来后我就借你扩音器。怎么样？";
			next;
			if (select("听起来不错。:像是在敲诈。") == 1) {
				mes "[Hianna]";
				mes "很高兴你同意~舞者在入口等着，准备好后就把她们带到施瓦茨瓦尔德共和国。";
				set que_sch,12;
				close;
			}
			mes "[Hianna]";
		mes "所以……看来你并不像我想的那么需要扩音器。";
			close;
		}
		mes "[Hianna]";
		mes "好吧，慢慢来。我不着急。";
		close;
	}
	else if (que_sch < 17) {
		mes "[Hianna]";
		mes "你还在这里做什么？不该已经护送舞者去施瓦茨瓦尔德共和国了吗？快行动~";
		close;
	}
	else if (que_sch == 17) {
		mes "[Hianna]";
		mes "感谢你的辛苦。舞者告诉我你护送得很好。现在……你带钱了吗？";
		next;
		if (select("是:否") == 1) {
			if (Zeny < 500000) {
				mes "[Hianna]";
				mes "这是什么？嗯……我想你弄错了。这些钱不够。记住，是 500,000 Zeny~";
				close;
			}
			mes "[Hianna]";
			mes "完美。给你扩音器。谢谢一切，回头见，冒险者~";
			set Zeny, Zeny-500000;
			set que_sch,18;
			getitem 7040,1; //Megaphone
			close;
		}
		mes "[Hianna]";
		mes "我不能让你违背承诺，";
		mes "所以在你支付答应的 500,000 Zeny 前，";
		mes "我不会给你扩音器。";
		mes "";
		mes "";
		mes "";
		close;
	}
	else if (que_sch == 18) {
		mes "[Hianna]";
		mes "谢谢你护送我的舞者前往施瓦茨瓦尔德共和国。";
		mes "今天有什么我能帮你的吗？";
		mes "";
		mes "";
		mes "";
		next;
		if (select("我想再要一个扩音器。:不用了，谢谢。") == 1) {
			mes "[Hianna]";
			mes "好吧，支付 500,000 Zeny 后，";
			mes "我可以再给你一个。";
			mes "你确定要花钱买扩音器吗？";
			mes "";
			mes "";
			next;
			if (select("是:否") == 1) {
				if (Zeny < 500000) {
					mes "[Hianna]";
					mes "抱歉，这些钱不够买扩音器。";
					mes "请带来 500,000 Zeny。";
					mes "";
					mes "";
					close;
				}
				mes "[Hianna]";
				mes "给你。事实上……";
				mes "这些扩音器属于公会财产，";
				mes "按理说我不该给你。";
				mes "别让任何人知道是我给你的！";
				mes "";
				mes "";
				set Zeny, Zeny-500000;
				getitem 7040,1; //Megaphone
				close;
			}
			mes "[Hianna]";
			mes "好吧～";
			mes "保重，一路平安～";
			mes "";
			close;
		}
		mes "[Hianna]";
		mes "Alright~";
		mes "保重，";
		mes "travel safely~";
		close;
	}
	mes "[Hianna]";
	mes "相信我，我们很好地利用了你‘捐赠’的钱。";
	mes "谢谢你照顾我的舞者～";
	mes "";
	mes "";
	mes "";
	close;
}


			mes "花园不介意在我身边畅谈。我想，他们更把我当孩子，而不是教皇。";
		next;
		mes "[Pope]";
		mes "我已经知道温和派神官在进行残酷实验，也知道强硬派在扩充军力。然而，我什么都做不了。";
		next;
		mes "[Pope]";
		mes "大多数人因为我的年龄而不把我的职位当回事。没人相信我能改变局势。我也听说了你做的一切，Zhed。";
		next;
		mes "[Pope]";
		mes "很抱歉你因允许外人进入圣地而受到其他神官惩罚，但我理解你的理由。这位就是那名冒险者吧？";
		next;
		mes "[Pope]";
		mes ""+ strcharinfo(0) +"...";
		mes "很高兴再次见到你。你不仅和我分享外界消息，还一直守护我们的和平。";
		next;
		cutin "ra_gwoman",0;
		mes "[Niren]";
		mes "我真的不知道……你对此有什么感受，或究竟知道多少。非常抱歉，殿下。我为低估你而羞愧。";
		next;
		cutin "ra_bishop",2;
		mes "[Pope]";
		mes "别道歉，Niren。如果不是你，我会被这座神殿自私之人的愚行拖下水。Niren，你就像我的母亲。";
		next;
		cutin "ra_gwoman",0;
		mes "[Niren]";
		mes "殿下……谢谢你。我也有同样的感受……";
		next;
		cutin "ra_bishop",2;
		mes "[Pope]";
		mes "Zhed……？我需要你替我做件事。";
		next;
		cutin "ra_gman",0;
		mes "[Zhed]";
		mes "当然，殿下。";
		next;
		mes "[Pope]";
		mes "写一份报告，说明 Arunafeltz 和施瓦茨瓦尔德共和国温和派进行的实验，以及他们与施瓦茨瓦尔德公司的关系。";
		next;
		mes "[Zhed]";
		mes "我会立即完成，殿下。谢谢。";
		next;
		cutin "ra_bishop",2;
		mes "[Pope]";
		mes "Niren。";
		next;
		cutin "ra_gwoman",0;
		mes "[Niren]";
		mes "是，殿下？";
		next;
		cutin "ra_bishop",2;
		mes "[Pope]";
		mes "请收集证据，证明强硬派一直在为战争做准备。";
		next;
		mes "[Niren]";
		mes "是，殿下。";
		next;
		mes "[Pope]";
		mes "我很快会召集所有高级神官和女神官。我希望你们两人站在我身边。我不会让任何人用鲜血玷污圣地。";
		next;
		cutin "ra_gman",0;
		mes "[Zhed]";
		mes "遵命，殿下。";
		next;
		cutin "ra_bishop",2;
		mes "[Pope]";
		mes ""+ strcharinfo(0) +"...";
		mes "我感谢你代表 Arunafeltz 所做的一切。我的影响力可能仍然微弱，但有 Zhed 和 Niren 的支持，我会尽力而为。";
		next;
		mes "[Pope]";
		mes "要求你留在我身边也许太过分了。但我想感谢你所做的一切。不过，如果这是 Freya 的……";
		mes "意志……我们会再见的……";
		next;
		mes "[Pope]";
		mes "愿芙蕾雅保佑你……";
		next;
		specialeffect2 EF_ENCHANTPOISON;
		mes "^3355FF教皇虔诚地为你祈祷，";
		mes "你感到一股强烈的温暖与善意，";
		mes "渗透了你的整个身心。^000000";
		set aru_em,22;
		changequest 2140,2141;
		close2;
		warp "rachel",142,136;
	}
	end;
}

rachel,142,136,0	script	#em_end	-1,5,5,{
OnInit:
	stopnpctimer;
	end;

OnTouch_:
	if (aru_em == 22) {
		initnpctimer;
		disablenpc "#em_end";
	}
	end;

OnTimer4000:
	mapannounce "rachel","教皇：阿鲁纳佩尔兹的公民们，高阶祭司和女祭司们。",bc_map,"0xFFCE00";
	end;

OnTimer7000:
	mapannounce "rachel","教皇：感谢你们按照我的请求来到天空花园。",bc_map,"0xFFCE00";
	end;

OnTimer10000:
	mapannounce "rachel","教皇：作为女神芙蕾雅选中的容器，我现在宣布昨天从她那里得到的话语。",bc_map,"0xFFCE00";
	end;

OnTimer15000:
	mapannounce "rachel","教皇：我一直在观察阿鲁纳佩尔兹发生的一切。",bc_map,"0x66CCCC";
	end;

OnTimer19000:
	mapannounce "rachel","教皇：我知道高阶祭司之间的派系斗争、自私的争斗，以及你们未能团结一致。",bc_map,"0x66CCCC";
	end;

OnTimer23000:
	mapannounce "rachel","教皇：然而，为了那些仍在祈求阿鲁纳佩尔兹和平的人，我没有插手。",bc_map,"0x66CCCC";
	end;

OnTimer30000:
	mapannounce "rachel","Pope: High Priest Zhed and High Priestess Niren, both of you must do your best to assist my vessel until the day of my arrival.",bc_map,"0x66CCCC";
	end;

OnTimer35000:
	mapannounce "rachel","Pope: As for the other high priests, you have forgotten your duty to serve me, to enlighten my followers with my teachings. For pursuing your selfish desires, you will be all under Zhed and Niren's command.",bc_map,"0x66CCCC";
	end;

OnTimer43000:
	mapannounce "rachel","教皇：阿鲁纳佩尔兹的信徒们，请继续信仰我，让你们的国家保持强盛。",bc_map,"0x66CCCC";
	end;

OnTimer47000:
	mapannounce "rachel","教皇：如此一来，乐园必将属于你们。",bc_map,"0x66CCCC";
	end;

OnTimer53000:
	mapannounce "rachel","公民：芙蕾雅万岁！教皇万岁！",bc_map,"0x99CC00";
	stopnpctimer;
	enablenpc "#em_end";
	end;
}

que_temsky,99,7,0	warp	quetemskyout	1,1,ra_temin,276,231

// Muff's Loan :: zdan_total_edq
//============================================================
comodo,224,187,3	script	Muff	86,{
	if (checkweight(907,200) == 0) {
		mes "[Muff]";
		mes "你现在携带的东西太多了。";
		mes "请把物品存入卡普拉仓库后再回来。";
		close;
	}
	if (diamond_edq == 0) {
		mes "[Muff]";
		mes "什、什么？！天啊，";
		mes "你没必要这样吓我！";
		mes "你到底想要什么？";
		next;
		switch(select("你看起来很烦恼。:没什么。保重！")) {
		case 1:
			if (BaseLevel < 61) {
				mes "[Muff]";
				mes "哦，你真是太";
				mes "体贴了。";
				mes "我本来想请你帮忙，";
				mes "但你看起来似乎";
				mes "应付不了这件事。抱歉。";
				set diamond_edq,3;
				close;
			}
			else {
				mes "[Muff]";
				mes "其实我遇到了";
				mes "很大的麻烦。";
				mes "我向一个叫";
				mes "^0000FFBelder^000000 的高利贷借了钱，";
				mes "他住在艾尔贝塔。";
				mes "这真是错误的决定！";
				next;
				mes "[Muff]";
				mes "我的生意不好，但我觉得别无选择。";
				mes "现在我赚够了还款的钱，";
				mes "却把债券弄丢了。";
				next;
				mes "[Muff]";
				mes "我问 Belder 能否没有债券也还钱，";
				mes "他却坚持说不记得借过钱给我。";
				mes "他却坚持说不记得借过钱给我。我敢说他只是想扣留我的抵押品！";
				next;
				mes "[Muff]";
				mes "我就知道那家伙不可靠！你能帮我找回丢失的债券吗？我给他的抵押品对我非常珍贵。";
				next;
				switch(select("你知道丢在哪里吗？:很遗憾听到这些。再见！")) {
				case 1:
					mes "[Muff]";
					mes "如果我知道丢在哪里，它现在就不会丢了，对吧？我记得参加过工会会议，还喝了一两杯。好吧，其实喝了很多。";
					next;
					mes "[Muff]";
					mes "回家路上，我在科莫多附近的田野跌倒……我记得看见水……一定是在那里掉了装着债券的皮夹。";
					next;
					mes "[Muff]";
					mes "如果你能找到我的皮夹，我一定会报答你。请尽力帮我！";
					setquest 3100;
					set diamond_edq,1;
					close;
				case 2:
					mes "[Muff]";
					mes "喂、喂！你要去哪？！不能就这样";
				mes "把我留在这里！我需要帮助！";
					close;
				}
			}
		case 2:
			mes "[Muff]";
			mes "什么，你是故意想惹我生气吗？我明白了，你在为 Belder 工作！不管怎样，我都要从那个混蛋手里拿回宝物！";
			next;
			switch(select("我不明白。:对不起，我只是开玩笑……")) {
			case 1:
				mes "[Muff]";
				mes "你以为能骗我？！滚开！我什么都不会告诉你，你这条蛇！";
				close;
			case 2:
				mes "[Muff]";
				mes "所以你不是替 Belder 监视我？那你为什么纠缠我？";
				close;
			}
		}
	}
	if ((diamond_edq == 3) && (BaseLevel < 61)) {
		mes "[Muff]";
		mes "等一下……你没有之前那么强了。最好先训练，这样才能更好地帮助我。";
		close;
	}
	if ((diamond_edq == 3) && (BaseLevel > 60)) {
		mes "[Muff]";
		mes "其实我遇到了大麻烦。我向艾尔贝塔一个叫 ^0000FFBelder^000000 的高利贷借了钱。这真是错误的决定！";
		next;
		mes "[Muff]";
		mes "我的生意不好，但我觉得别无选择。现在我赚够了还款的钱，却把债券弄丢了。";
		next;
		mes "[Muff]";
		mes "我问 Belder 能否没有债券也还钱，他却坚持说不记得借过钱给我。我敢说他只是想扣留我的抵押品！";
		next;
		mes "[Muff]";
		mes "我就知道那家伙不可靠！你能帮我找回丢失的债券吗？我给他的抵押品对我非常珍贵。";
		next;
		switch(select("你知道丢在哪里吗？:抵押品是什么？:再见！")) {
		case 1:
			mes "[Muff]";
			mes "如果我知道丢在哪里，它现在就不会丢了，对吧？我记得参加过工会会议，还喝了一两杯。好吧，其实喝了很多。";
			next;
			mes "[Muff]";
			mes "我走 Papuchicha 森林这条路回家，应该是在河边昏倒了。醒来后，装着债券的皮夹不见了。";
			next;
			mes "[Muff]";
			mes "皮夹里的其他东西我不在乎，但我需要债券，才能从 Belder 那里拿回抵押品。";
			setquest 3100;
			set diamond_edq,1;
			close;
		case 2:
			mes "[Muff]";
			mes "抵押品是一颗巨大而惊艳的美丽宝石，对我非常珍贵。不过，我不想再告诉你更多。";
			next;
			mes "[Muff]";
			mes "听完这些你不想帮忙，我能理解。但如果改变主意，请再来找我。";
			close;
		case 3:
			mes "[Muff]";
			mes "喂、喂！你要去哪？！不能把我留在这里！我需要帮助！";
			close;
		}
	}
	if ((diamond_edq == 1) || (diamond_edq == 2)) {
		mes "[Muff]";
		mes "你还没去找我的皮夹吗？我想它在 Papuchicha 森林某处。请尽快找到里面的债券。";
		close;
	}
	if (diamond_edq == 4) {
		mes "[" + strcharinfo(0) + "]";
		mes "这张湿漉漉、破烂的纸就是你需要的债券吗？";
		next;
		mes "[Muff]";
		mes "是的，就是它！呃，但看看它……毁了！连上面写的字都读不出来！我得……我得想办法修好！";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "你有什么主意吗？就算把纸弄干，字迹还是会褪色，对吧？";
		next;
		mes "[Muff]";
		mes "有了！依斯鲁得有位叫 ^FF0000Dorian^000000 的著名发明家。我听说他刚发明了类似魔法烘干机的东西，肯定有用！";
		next;
		mes "[Muff]";
		mes "我不知道它具体怎么工作，但应该能修复债券。它是魔法，对吧？你能请 Dorian 帮忙吗？";
		next;
		switch(select("接受请求:拒绝请求")) {
		case 1:
			mes "[Muff]";
			mes "太感谢了！请去依斯鲁得找发明家 Dorian，请他修复我的债券。我会在这里等你，好吗？";
			changequest 3102,3103;
			set diamond_edq,6;
			close;
		case 2:
			mes "[Muff]";
			mes "真的吗？我希望你继续帮我，但是……好吧。我相信你还有其他事情。改变主意的话再回来。";
			set diamond_edq,5;
			close;
		}
	}
	if (diamond_edq == 5) {
		mes "[Muff]";
		mes "哦，我就知道你会回来帮我修复债券！你看起来太善良，不会就这样丢下我。";

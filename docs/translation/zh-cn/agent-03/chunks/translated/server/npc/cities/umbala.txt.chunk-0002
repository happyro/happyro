	next;
	mes "[帕斯托]";
	mes "我真希望能说他们的语言……*叹气*";
	mes "……或者能在这里遇到更多";
	mes "说我语言的人……我……我……";
	mes "好孤独……*抽泣*";
	mes "";
	mes "";
	emotion ET_CRY;
	close;
}

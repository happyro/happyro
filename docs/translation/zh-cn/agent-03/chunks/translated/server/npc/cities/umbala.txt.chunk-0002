	mes "";
	mes "";
	next;
	mes "[尤沃基]";
	mes "随着我对他们了解更多，";
	mes "我最终发现他们的求偶仪式";
	mes "其实比卢恩·米德加尔兹文化中的任何东西都先进。";
	mes "";
	mes "";

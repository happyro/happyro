umbala,92,159,4	script	Bertan#um	785,{
	if (event_umbala >= 3) {
		mes "[贝尔坦]";
		mes "怎么了，失败者！";
		next;
		mes "[贝尔坦]";
		mes "怎么了，";
		mes "你这个大卢恩·米德加尔兹人？！？！";
		mes "我刚才叫你‘失败者’！";
		mes "我猜你太蠢了，";
		mes "根本听不懂！！";
		mes "哈哈哈哈哈哈哈哈~！";
		next;
		mes "[贝尔坦]";
		mes "……";
		mes "呃……哦！";
		next;
		mes "[贝尔坦]";
		mes "看来你能听懂我——！干得好，干得好！";
		mes "好吧，为了道歉，想听个笑话吗？";
		mes "";
		mes "";
		next;
		mes "[贝尔坦]";
		mes "好吧，好吧。";
		mes "开始了。";
		mes "嗯……";
		mes "好，我想到一个。";
		next;
		switch(rand(1,6)) {
		case 1:
			mes "[贝尔坦]";
			mes "卢恩·米德加尔兹人对野蛮人说了什么？";
			mes "...";
			next;
			mes "[贝尔坦]";
			mes "我不知道……";
			mes "但他们互相理解起来一点困难也没有！！！哈哈哈哈~！";
			mes "明白吗？因为他们都是猪~！";
			next;
			mes "[贝尔坦]";
			mes "不好笑，对吧？";
			mes "算了。我的幽默感可能太高深了。";
			mes "";
			close;
		case 2:
			mes "[Bertan]";
			mes "好吧……驯服兽人女士的最佳方法是什么？";
			mes "猜不到……？";
			next;
			mes "[Bertan]";
			mes "用结婚戒指！";
			mes "哈哈哈哈哈哈哈！";
			mes "天哪~我真幽默！！";
			next;
			mes "[Bertan]";
			mes "...";
			mes "……等等。";
			mes "等一下……";
			next;
			mes "[Bertan]";
			mes "这根本不好笑……";
			mes "只是非常……";
			mes "可怕……";
			mes "嘶——！";
			mes "她太丑了！！";
			close;
		case 3:
			mes "[Bertan]";
			mes "其实……算了。";
			next;
			mes "[Bertan]";
			mes "我本想讲一个关于伊西斯的敲门笑话，";
			mes "但后来觉得那种幽默太低俗。";
			mes "...Zing!";
			close;
		case 4:
			mes "[Bertan]";
			mes "为什么卢恩·米德加尔兹人";
			mes "这么……";
			mes "嗯……";
			mes "也许这个笑话";
			mes "不适合现在的情况，对吧？";
			close;
		case 5:
			mes "[Bertan]";
			mes "好吧，为什么 GM 不喜欢";
			mes "被人看见……？猜不到？";
			next;
			mes "[Bertan]";
			mes "因为那些家伙穿";
			mes "裙子~！哈哈哈！";
			mes "天啊，我真会讲笑话！";
			next;
			mes "[Bertan]";
			mes "*Whew* Yowza~";
			mes "哦，老兄。";
			mes "真是经典。";
			close;
		case 6:
			mes "[贝尔坦]";
			mes "一名十字军、炼金术士和初心者走进酒吧。";
			next;
			mes "[贝尔坦]";
			mes "里面有块牌子写着：";
			mes "‘^CC0000怪物援助机构：";
			mes "仅限女性。^000000’";
			next;
			mes "[贝尔坦]";
			mes "十字军说：‘^000099哦！^000000’";
			mes "‘^000099幸好我们都是女性。^000000’她走上前说：";
			mes "‘^000099载我一程。^000000’";
			mes "对十字军来说有点无礼，";
			mes "不过算了。";
			next;
			mes "[贝尔坦]";
			mes "突然，一只大嘴鸟出现了，";
			mes "说：‘^CC0000我来载你，宝贝。小心，";
			mes "这条路会很颠簸。^000000’";
			mes "然后他们出发了。";
			next;
			mes "[贝尔坦]";
			mes "接着炼金术士来了，";
			mes "她说：‘^330099我需要帮助杀僵尸^000000’，";
			mes "然后海葵从不知哪里冒出来，说……";
			mes "";
			mes "";
			mes "";
			next;
			mes "[贝尔坦]";
			mes "‘^CC0000我有你的火。小心，宝贝，";
			mes "碰错地方我可能会爆炸。^000000’";
			mes "于是他们也开心地出发了。";
			mes "";
			mes "";
			mes "";
			next;
			mes "[贝尔坦]";
			mes "最后初心者走上前说：";
			mes "‘^006633我需要有人一起组队。^000000’";
			mes "";
			next;
			mes "[贝尔坦]";
			mes "突然，土人魔芋冒出来说……";
			mes "";
			next;
			mes "[贝尔坦]";
			mes "‘^CC0000我认识一些人，让我查查通讯录。";
			mes "土人魔芋上线！^000000’";
			mes "....";
			next;
			mes "[贝尔坦]";
			mes "……";
			mes "…………";
			mes "不行？";
			next;
			mes "[贝尔坦]";
			mes "好吧，得了！";
			mes "我不可能一直都很幽默，";
			mes "你知道的吧？";
			close;
		}
	}
	else {
		mes "[????]";
		mes "Umbaumba Umbaumbah";
		next;
		mes "[????]";
		mes "Bwahbwah hahbrah!";
		mes "Umbaumba Umbaumbah";
		mes "Umbaumba Umbaumbah";
		next;
		mes "[????]";
		mes "Umbaumba Umbaumbah woo~";
		emotion ET_DELIGHT;
		close;
	}
	close;
}


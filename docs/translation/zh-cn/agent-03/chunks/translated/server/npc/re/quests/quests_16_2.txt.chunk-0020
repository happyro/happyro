		mes "那时 Adler 先生来看我。";
		mes "他敲响我家门时我非常惊讶……他进来后突然向我鞠躬。";
		next;
		mes "[Grandma Lucy]";
		mes "我再次感到惊讶，问他为什么。然后他告诉了我 Irene 的事。";
		next;
		mes "[Grandma Lucy]";
		mes "他说 Irene 的死是他的错，还把头撞在地板上道歉……";
		mes "我不知道发生了什么，只叫他停下。";
		next;
		mes "[Grandma Lucy]";
		mes "他没有告诉我详细经过。他离开房子后又回来，之后会送花和钱给我。";
		next;
		mes "[Grandma Lucy]";
		mes "多亏他的支持，我恢复了过来。后来我搬到艾因布洛克，种下这棵树纪念 Irene。";
		next;
		mes "[Grandma Lucy]";
		mes "每次他送花或钱来，我总是拒绝。但他坚持要给我……";
		mes "我想知道他为什么这么做。不过，他毕竟是高级军官……";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes ".........";
		mes "非常感谢你告诉我这段艰难的故事。";
		next;
		mes "[Grandma Lucy]";
		mes "不客气。多亏你，我听到了 Adler 先生的故事。现在感觉好多了。";
		next;
		mes "[Grandma Lucy]";
		mes "谢谢你。如果不介意，请偶尔来我家和这个老人聊聊……";
		erasequest 16047;// Quiet memorial ceremony
		setquest 16048;// Traces of old story
		delitem 25152,1;// Cherish_Bouquet
		close;
	}
	if (isbegin_quest(16052) == 1) {
		if (countitem(25152) < 1) {
			mes "你翻找了自己的背包。";
			next;
			mes "[" + strcharinfo(0) + "]";
			mes "我把花放在哪里了……？";
			mes "不在那里。也许我该再买一束……";
			close;
		}
		mes "你献上花束，默默悼念了一会儿。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "安息吧，Irene……";
		next;
		mes "[Grandma Lucy]";
		mes "旅行者，你又来了。谢谢你。";
		mes "如果你见到 Adler 先生，请代我向他致谢。";
		next;
		mes "就在这时，你在树旁遇到了 Lucy 老奶奶，并向她打招呼。";
		erasequest 16052;// Quiet memorial ceremony
		setquest 16053;// Ongoing old story
		delitem 25152,1;// Cherish_Bouquet
		close;
	}
	mes "[Huge Tree]";
	mes "树前有一块小告示牌。";
	mes "- 这里长眠着一位善良的女孩 -";
	close;

OnInit:
	questinfo( QTYPE_QUEST,QMARK_YELLOW, " isbegin_quest(16047) == 1 && countitem(25152) > 0 " );
	questinfo( QTYPE_QUEST,QMARK_YELLOW, " isbegin_quest(16052) == 1 && countitem(25152) > 0 " );
	end;
}


// Daily Quest - Mason Bender Business
rebel_in,19,48,5	script	Mason Bender#16.2rm	4_M_KHMAN,{
	if (terra_gloria_main < 17) {
		mes "[Mason Bender]";
		mes "欢迎。这里是 Clana Nemieri 武器店。";
		next;
		mes "[Mason Bender]";
		mes "我们有各种武器，包括枪械、火药、大炮、迫击炮和燃烧瓶。欢迎常来。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "……哦，你只有枪械！";
		next;
		mes "[Mason Bender]";
		mes "枪械可是最……什么？Nemi？今天我们关门？";
		next;
		mes "[Mason Bender]";
		mes "啊……对。今天关门。请以后再来。";
		close;
	}

	// Lebedev twins quest
	if (lebedev_quest_16_2 == 2 || lebedev_quest_16_2 == 3) {
		if (isbegin_quest(16014) == 1) {
			emotion ET_FRET;
			mes "[Mason Bender]";
			mes "你问我们队里的双胞胎？你是冒险者，为什么问这种事？";
			mes "我对你和那个吵闹的游客都没兴趣。";
			next;
			mes "[Mason Bender]";
			mes "……呼，既然是 Volkova 指挥官的请求……我只能回答你。但我只能说那些孩子的坏话。";
			next;
			mes "[Mason Bender]";
			mes "他们什么都做不好。而且根本不听我们的话。";
			mes "他们是最糟糕的孩子。我不知道为什么要让他们留在这里。";
			next;
			mes "[Mason Bender]";
			mes "你看到这里的绷带了吗？这是被那个男孩射出的流弹打伤的。";
			mes "他们连自动靶都打不中，简直是笨蛋。他们糟糕得像是故意打不中一样。";
			next;
			mes "[Mason Bender]";
			mes "所以我只好搬到这里，Clana Nemieri。";
			next;
			mes "[Mason Bender]";
			mes "嗯，这份工作很适合我的才能……";
			mes "至于我不喜欢那些孩子，那是另一回事。";
			next;
			mes "[Mason Bender]";
			mes "被派上实战后，他们惹了麻烦并逃跑。我不明白为什么人们叫他们天才。像我这样的人才配叫天才。";
			next;
			mes "[Mason Bender]";
			mes "人们只是对小孩子开枪感到兴奋。";
			completequest 16014;// Testimony: Sniper's story
			lebedev_quest_16_2++;
			questinfo_refresh();
			close;
		}
	}
	// twin daily quest
	if (isbegin_quest(16028) == 1) {
		mes "[Mason Bender]";
		mes "饼干？嗯，让我看看。你从哪里得到的？";
		next;
		mes "[Mason Bender]";
		mes "……那些孩子做的？";
		next;
		mes "[Mason Bender]";
		mes "不，不。我已经不再对他们抱有偏见。";
		mes "请给我。让我用天才般的味觉评判！";
		next;
		if (countitem(25161) < 1) {
			mes "[Mason Bender]";
			mes "你为什么不把饼干给我？";
			next;
			mes "[Mason Bender]";
			mes "请给我。我不会太苛刻。";
			mes "你没有吗？";
			close;
		}
		mes "[Mason Bender]";
		mes "……嗯……真好吃……";
		mes "嗯，不错。";
		next;
		mes "[Mason Bender]";
		mes "有点干，似乎没完全烤熟。太甜，形状也不一致。但是……";
		next;
		mes "[Mason Bender]";
		mes "我看得出他们制作时付出了多少努力。很好吃。";
		completequest 16028;// Service: Cookies delivery
		delitem 25161,1;// Handmade_cookie2
		close;
	}

	switch( checkquest(16058,PLAYTIME) ) {
	case -1:
		switch( isbegin_quest(16054) ) {
		case 0:
			mes "[Mason Bender]";
			mes "欢迎。这里是 Clana Nemieri 武器店。";
			next;
			mes "[Mason Bender]";
			mes "呼……哦，抱歉。";
			next;
			mes "[Mason Bender]";
			mes "你……对。你就是在那里闹出骚动的人，对吧？";
			mes "很好。我想请你帮个忙。你愿意吗？";
			next;
			mes "[Mason Bender]";
			mes "我会给你机会负责我天才工作的一个环节。";
			next;
			mes "[" + strcharinfo(0) + "]";
			mes "... Talented work?";
			next;
			mes "[Mason Bender]";
			mes "嗯，这只是比喻。哈哈……";
			mes "你能帮忙吗？";
			next;
			if (select( "帮助他。", "我对他没好感。无视他。" ) == 2) {
				mes "[Mason Bender]";
				mes "...";
				next;
				emotion ET_DELIGHT;
				mes "[Mason Bender]";
				mes "呼……你被我天才般的口才震撼到无法回应了。当然，我理解……";
				next;
				mes "[Mason Bender]";
				mes "请冷静下来再和我谈。呵呵……";
				next;
				mes "[" + strcharinfo(0) + "]";
				mes "... Not even close!";
				close;
			}
			mes "[Mason Bender]";
			mes "太好了。你被我天才般的口才说服了。";
			mes "那么，这是我的请求。";
			next;
			mes "[Mason Bender]";
			mes "这是我用天才写作能力准备的武器店传单。";
			next;
			mes "[Mason Bender]";
			mes "任何读到它的人都会来这家店购买 81mm 迫击炮。";
			npctalk "Mason Bender: Talented business sense and talented marketing skill~ Hoho~", "", bc_self;
			next;
			mes "[" + strcharinfo(0) + "]";
			mes "(Who's going to buy such a stuff?!)";
			next;
			mes "[Mason Bender]";
			mes "但我有个小问题。";
			mes "虽然我把传单带到村里的长椅或广场，却没有村民愿意拿。";
			next;
			mes "[Mason Bender]";
			mes "所以！你亲自带去！友善地把传单交给每个人。务必面带微笑地递到别人手里。";
			next;
			mes "[Mason Bender]";
			mes "Nemi 对这批货很生气。如果你这么做，肯定能卖得很好。呵呵……";
			next;
			mes "[Mason Bender]";
			mes "现在！我把传单给你。再见！";
			setquest 16054;	// Differentiated advertising strategy
			setquest 16055;	// Advertising: Dou you want a clean city?
			setquest 16056;	// Advertising: Then blow it all away!
			setquest 16057;	// Advertising: Suitable revenge for old age!
			getitem 25163,3;	// Arms_Shop_AD
			close;
		case 1:
			if (isbegin_quest(16055) != 2 || isbegin_quest(16056) != 2 || isbegin_quest(16057) != 2) {
				if (countitem(25163) < 1) {
					mes "[Mason Bender]";
					mes "现在就靠你了。";
					mes "同时我会准备接待顾客。";
					next;
					mes "[Mason Bender]";
					mes "哎呀……你把传单弄丢了吗？";
					next;
					mes "[Mason Bender]";
					mes "请不要糟蹋传单。这次我再给你一份。";
					.@count = (isbegin_quest(16055) != 2) + (isbegin_quest(16056) != 2) + (isbegin_quest(16057) != 2);
					getitem 25163,.@count;	// Arms_Shop_AD
					close;
				}
				mes "[Mason Bender]";
				mes "现在！给你！";
				mes "你会把我天才的文字传播到整个村子！";
				close;
			}
			mes "[Mason Bender]";
			mes "欢迎回来！他们反应如何？";
			next;
			mes "[" + strcharinfo(0) + "]";
			mes "嗯……就那样……";
			next;
			mes "[Mason Bender]";
			mes "哦？真的吗？！";
			next;
			mes "[Mason Bender]";
			mes "... Oh, I see. My pink brain cells finished the deduction!";
			mes "他们还没读我的传单！";
			next;
			emotion ET_SURPRISE;
			mes "[Mason Bender]";
			mes "他们被我天才的开场吸引，忘了读传单的其他部分！";
			next;
			mes "[Mason Bender]";
			mes "呵呵……我也没办法。我们耐心等吧。";
			next;
			mes "[Mason Bender]";
			mes "明天会有很多人来，所以我要向 Eri 请教如何接待大量顾客。";
			next;
			mes "[Mason Bender]";
			mes "如果不介意，明天请回来帮我接待顾客好吗？呵呵……";
			completequest 16054;	// Differentiated advertising strategy
			erasequest 16055;	// Advertising: Dou you want a clean city?
			erasequest 16056;	// Advertising: Then blow it all away!
			erasequest 16057;	// Advertising: Suitable revenge for old age!
			setquest 16058;	// Slow advertising effect
			getexp 100000,100000;
			getitem 25155,10;	// Swz_Honor_Token
			close;
		case 2:
			break;
		}
		break;
	case 0:
	case 1:
		mes "[Mason Bender]";
		mes "欢迎！很高兴见到你！你是来买迫击炮的……哦？";
		mes "... It's you, adventurer. Welcome.";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "等等。你失望了！你就是失望了！";
		mes "看来你的生意遇到麻烦了。";
		next;
		mes "[Mason Bender]";
		mes "不！买家正在战略性地评估情况。换句话说，他们正在预热。";
		next;
		mes "[Mason Bender]";
		mes "很快他们就会意识到购买迫击炮能带来巨大利润，然后涌向 Clana Nemieri！如果你不买东西，请离开！以后再来！";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "你卖掉了多少个！";
		next;
		emotion ET_SWEAT;
		mes "[Mason Bender]";
		mes "^FF0000Please leave!!!^000000";
		next;
		mes "[Nemi]";
		mes "多少个？一个迫击炮都没有。";
		next;
		mes "[Nemi]";
		mes "Mason 是优秀的狙击手，人们称他为天才。受伤后，他暂时自愿来这里工作，现在喜欢上了这份工作。";
		next;
		mes "[Nemi]";
		mes "虽然他没有商业才能，却偶然误解了什么。现在他非常兴奋，手头的事多得不可开交。";
		next;
		mes "[Eri]";
		mes "我想我们必须尽快阻止他。";
		mes "否则商店可能会彻底毁掉。";
		next;
		mes "[Eri]";
		mes "我代 Mason 为把你赶走道歉。请明天回来给他宝贵建议，让他振作起来。";
		close;
	case 2:
		erasequest 16058;	// Slow advertising effect
		break;
	}
	if (isbegin_quest(16059) == 0) {
		mes "[Mason Bender]";
		mes "欢迎！Clana Nemieri……哦？";
		next;
		mes "[Mason Bender]";
		mes "...Oh, what is it? " + strcharinfo(0) + ", it was you. I thought it was a customer...";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "你卖掉大炮了吗？";
		next;
		mes "[Mason Bender]";
		mes "那是迫击炮，不是大炮。我以为今天能卖出去……";
		next;
		emotion ET_SWEAT;
		mes "[Mason Bender]";
		mes "真奇怪。按我的计算，这些迫击炮今天应该卖出……四天后我们就能达到收支平衡。之后就会开始盈利。";
		next;
		mes "[Mason Bender]";
		mes "我不知道为什么。嗯……";
		mes "我分析这个现象时，" + strcharinfo(0) + " could you please hand out the leaflets to villagers once again?";
		next;
		mes "[Mason Bender]";
		mes "去村里找三个真正需要迫击炮的人，把这些传单给他们。";
		next;
		if (select( "我来做。", "抱歉。我不做。" ) == 2) {
			mes "[Mason Bender]";
			mes "来吧……你为什么不帮我？";
			next;
			mes "[" + strcharinfo(0) + "]";
			mes "这里没人需要迫击炮。";
			next;
			mes "[Mason Bender]";
			mes "如果你只能把东西卖给需要的人，那你就是新手。我会把东西卖给某些人，他们会因为买了它而需要它！";
			next;
			mes "[Mason Bender]";
			mes "我要把电暖器卖给梦罗克的人，把冰箱卖到马努克！";
			next;
			mes "[Eri]";
			mes "...I hope he uses that passion elsewhere.";
			close;
		}
		mes "[Mason Bender]";
		mes "我的脑细胞早就知道你会接受。";
		mes "三张传单。拜托你了。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "(I don't think there will be anyone who seem to need the mortar earnestly)";
		setquest 16059;	// Differentiated advertising strategy
		setquest 16055;	// Advertising: Dou you want a clean city?
		setquest 16056;	// Advertising: Then blow it all away!
		setquest 16057;	// Advertising: Suitable revenge for old age!
		getitem 25163,3;	// Arms_Shop_AD
		close;
	}
	if (isbegin_quest(16055) != 2 || isbegin_quest(16056) != 2 || isbegin_quest(16057) != 2) {
		if (countitem(25163) < 1) {
			mes "[Mason Bender]";
			mes "现在就靠你了。";
			mes "同时我会准备接待顾客。";
			next;
			mes "[Mason Bender]";
			mes "哎呀……你把传单弄丢了吗？";
			next;
			mes "[Mason Bender]";
			mes "请不要糟蹋传单。这次我再给你一份。";
			.@count = (isbegin_quest(16055) != 2) + (isbegin_quest(16056) != 2) + (isbegin_quest(16057) != 2);
			getitem 25163,.@count;	// Arms_Shop_AD
			close;
		}
		mes "[Mason Bender]";
		mes "现在就靠你了。";
		mes "同时我会准备接待顾客。";
		close;
	}
	mes "[Mason Bender]";
	mes "欢迎回来！他们反应如何？";
	next;
	mes "[" + strcharinfo(0) + "]";
	mes "嗯……就那样……";
	next;
	mes "[Mason Bender]";
	mes "哦？真的吗？！";
	mes "如果我是你，我会用天才般的直觉读出他们眼中对迫击炮的渴望和期待。";
	next;
	mes "[Mason Bender]";
	mes "那我就再准备接待顾客！";
	mes "我明天会很忙。想来找我们的话，请提前预约。";
	erasequest 16055;	// Advertising: Dou you want a clean city?
	erasequest 16056;	// Advertising: Then blow it all away!
	erasequest 16057;	// Advertising: Suitable revenge for old age!
	erasequest 16059;	// Differentiated advertising strategy
	setquest 16058;	// Slow advertising effect
	getexp 100000,100000;
	getitem 25155,3;// Swz_Honor_Token
	close;

OnInit:
	// Mason Bender Business
	questinfo( QTYPE_QUEST, QMARK_NONE, "terra_gloria_main > 16 && isbegin_quest(16054) == 0" );
	questinfo( QTYPE_QUEST, QMARK_NONE, "isbegin_quest(16055) == 2 && isbegin_quest(16056) == 2 && isbegin_quest(16057) == 2" );
	questinfo( QTYPE_QUEST, QMARK_NONE, "isbegin_quest(16059) == 0 && isbegin_quest(16054) == 2 && (checkquest(16058,PLAYTIME) == -1 || checkquest(16058,PLAYTIME) == 2)" );

	// Lebedev twins quest
	questinfo( QTYPE_QUEST, QMARK_NONE, "isbegin_quest(16014) == 1" );

	// twins daily quest : "Service: Cookies delivery"
	questinfo( QTYPE_QUEST, QMARK_NONE, "isbegin_quest(16028) == 1 && countitem(25161) > 0" );
	end;
}

einbech,71,168,1	script	Tired Looking Man#16.2r	4_M_SEAMAN,{
	switch( isbegin_quest(16055) ) {
	case 0:
		mes "[Tired Looking Man]";
		mes "辛苦工作一整天后，我喜欢看着铁路抽烟。这就是我人生的乐趣。";
		next;
		mes "[Tired Looking Man]";
		mes "我称之为乐趣……我的人生到底怎么了？";
		close;
	case 1:
		if (countitem(25163) < 1) {
			mes "[Tired Looking Man]";
			mes "哦，我不买。而且你两手空空。";
			mes "辛苦工作后我很累。别烦我，离开吧。";
			close;
		}
		mes "你把传单递给了他。";
		next;
		mes "[Tired Looking Man]";
		mes "这是什么？传单？我没兴趣……你们到底卖什么？";
		next;
		mes "[Tired Looking Man]";
		mes "迫击炮？我们要打仗吗？我为什么要买？";
		delitem 25163,1;	// Arms_Shop_AD
		completequest 16055;	// Advertising: Dou you want a clean city?
		close;
	case 2:
		mes "[Tired Looking Man]";
		mes "哦，不。我不买。";
		mes "辛苦工作后我很累。别烦我，离开吧。";
		close;
	}
	end;

OnInit:
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "isbegin_quest(16055) == 1" );
	end;
}

einbech,79,100,3	script	Tired Looking Old man#1	4_M_BARYO_OLD,{
	switch( isbegin_quest(16056) ) {
	case 0:
		mes "[Tired Looking Old man]";
		mes "看看这浑浊的水，什么都映照不出来。";
		next;
		mes "[Tired Looking Old man]";
		mes "这里一条鱼都没有。剩下的老人离开后，这个村子会变成什么样？";
		close;
	case 1:
		if (countitem(25163) < 1) {
			mes "[Tired Looking Old man]";
			mes "不。我不需要大炮。";
			mes "无论你怎么劝我，我都不需要。";
			close;
		}
		mes "你把传单递给了他。";

		mes "[Budan]";
		mes "假装成在拉赫停留的商人，悄悄买一个，然后放进那边的水箱。";
		mes "这样就能得到完全净化的清水。";
		mes "你只需把它带给我。";
		next;
		if (select( "不难", "很难" ) == 2) {
			mes "[Budan]";
			mes "如果你很忙，那就算了。";
			close;
		}
		mes "[Budan]";
		mes "事情说来话长，不过谢谢你的简短回答。";
		next;
		setquest 8691;
		mes "[Budan]";
		mes "如果去寺庙，那天应该会有做善事的信徒在外面。";
		mes "说几句话并买下它。";
		mes "请帮我这个忙。";
		close;
	case 1:
		if (countitem(1000411) < 1) {
			mes "[Budan]";
			mes "如果去寺庙，那天应该会有做善事的信徒在外面。";
			mes "说几句话并买下它。";
			mes "请帮我这个忙。";
			close;
		}
		delitem 1000411,1;	// Ep18_Purified_Bucket
		getitem 1000405,20;	// Ep18_Amethyst_Fragment
		getexp 7769124,3000000;
		completequest 8693;
		setquest 8694;
		add_reputation_points(REPUTATION_EP18, 100);
		if (get_reputation_points(REPUTATION_EP18) >= 1000 && ep18_main == 36) {// Custom implementation: reputation 1000 on wolfvill => player can continue the main quest
			ep18_main = 37;
			setquest 18082;
			mes "^4d4dff灰狼村的村民已经接纳你成为村里的一员。^000000";
			mes "你有资格参加^4d4dff会议。^000000";
			next;
		}
		mes "[Budan]";
		mes "我们暂时有了些好水。";
		close;
	case 2:
		break;
	}

	// daily
	switch( checkquest(8694,PLAYTIME) ) {
	case -1:
		break;
	case 0:
	case 1:
		mes "[Budan]";
		mes "我暂时有足够的饮用水。";
		close;
	case 2:
		erasequest 8694;
		break;
	}
	if (isbegin_quest(8695) == 1 || isbegin_quest(8696) == 1) {
		mes "[Budan]";
		mes "如果去寺庙，那天应该会有做善事的信徒在外面。";
		mes "说几句话并买下它。";
		mes "请帮我这个忙。";
		close;
	}
	if (isbegin_quest(8697) == 1) {
		if (countitem(1000411) < 1) {
			mes "[Budan]";
			mes "如果去寺庙前方，那天应该会有做善事的信徒。";
			mes "说几句话并买下它。";
			mes "求你了。";
			close;
		}
		delitem 1000411,1;	// Ep18_Purified_Bucket
		add_reputation_points(REPUTATION_EP18, 30);
		if (get_reputation_points(REPUTATION_EP18) >= 5000)
			.@bonus = 1;
		if (get_reputation_points(REPUTATION_EP18) >= 1000 && ep18_main == 36) {// Custom implementation: reputation 1000 on wolfvill => player can continue the main quest
			ep18_main = 37;
			setquest 18082;
			mes "^4d4dff灰狼村的村民已经接纳你成为村里的一员。^000000";
			mes "你有资格参加^4d4dff会议。^000000";
		}
		getitem 1000405,3+.@bonus;	// Ep18_Amethyst_Fragment
		// erasequest 8695;
		// erasequest 8696;
		erasequest 8697;
		setquest 8694;
		getexp 18252408,2000000;
		mes "[Budan]";
		mes "谢谢你帮我弄到饮用水。我会把它烧开准备饭菜。";
		mes "如果你明天有时间留在这里，可以再帮我去一趟拉赫吗？";
		next;
		select( "有时间", "我明天可能很忙" );
		mes "[Budan]";
		mes "你的回答真爽快。";
		mes "抱歉路途遥远，但我想让孩子们吃到安全的食物。谢谢。";
		close;
	}
	mes "[Budan]";
	mes "冒险者，你回来了。";
	mes "有时间去一趟拉赫吗？";
	next;
	mes "[Budan]";
	mes "假装成在拉赫停留的商人，悄悄买一个，然后放进那边的水箱。";
	mes "这样就能得到完全净化的清水。";
	mes "你只需把它带给我。";
	next;
	if (select( "It won't be difficult", "It will be difficult" ) == 2) {
		mes "[Budan]";
		mes "如果你很忙，那就算了。";
		close;
	}
	mes "[Budan]";
	mes "事情说来话长，不过谢谢你的简短回答。";
	next;
	setquest 8695;
	mes "[Budan]";
	mes "如果去寺庙，那天应该会有做善事的信徒在外面。";
	mes "说几句话并买下它。";
	mes "请帮我这个忙。";
	close;

OnInit:
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "isbegin_quest(8691) == 0 && isbegin_quest(8692) == 0 && isbegin_quest(8693) == 0 && isbegin_quest(11724) == 2" );
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "isbegin_quest(8693) == 1" );

	questinfo( QTYPE_DAILYQUEST, QMARK_YELLOW, "isbegin_quest(8693) == 2 && (checkquest(8694,PLAYTIME) == -1 || checkquest(8694,PLAYTIME) == 2) && isbegin_quest(8695) == 0 && isbegin_quest(8696) == 0 && isbegin_quest(8697) == 0" );
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "isbegin_quest(8697) == 1" );
	end;

}

// Quest: Purifying Water. Step 2.
rachel,103,141,5	script	Salesman#ep18	4_M_DESERT,{
	if (checkweight(1000405,20) == 0) {
		mes "- 你携带的物品太多，无法继续任务。 -";
		close;
	}
	if (isbegin_quest(8692) == 1 && countitem(1000410) > 0) {
		mes "[Salesman]";
		mes "愿你平安~";
		close;
	}
	if (isbegin_quest(8691) == 1 || isbegin_quest(8692) == 1 && countitem(1000410) < 1) {
		mes "[Salesman]";
		mes "今天有圣水净化圣物~！";
		mes "趁卖光前早点来~！";
		next;
		mes "[Salesman]";
		mes "咦？";
		mes "外乡人，我能帮你什么？";
		next;
		select( "我需要它去山顶" );
		mes "[Salesman]";
		mes "哎呀，你听说传闻了~";
		mes "我简单说明一下~";
		mes "这是经过祝圣的净水圣物，可以一次净化大量受污染的水。";
		mes "就是这个~";
		next;
		mes "[Salesman]";
		mes "这是寺庙制作的~";
		mes "现在水道维护得很好，需求没那么大~";
		mes "所以只制作少量~";
		mes "材料很难找~";
		next;
		mes "[Salesman]";
		mes "我几天后就需要它，所以不能大量购买~";
		mes "不过~一次使用能净化的水量也是有限的~";
		next;
		mes "[Salesman]";
		mes "如果去目的地途中没水了，又有合适的补水站，就能使用这个道具~";
		mes "比带着水方便多了~";
		next;
		mes "[Salesman]";
		mes "不过必须先把水煮沸一次~";
		mes "有人说会有味道~";
		next;
		mes "[Salesman]";
		mes "价格是 550 Zeny~";
		next;
		if (select( "Buy", "Don't buy" ) == 2) {
			mes "[Salesman]";
			mes "按需购买~";
			mes "愿芙蕾雅女神祝福你~";
			close;
		}
		if (Zeny < 550) {
			mes "[Salesman]";
			mes "你的 Zeny 不够。";
			close;
		}
		Zeny -= 550;
		if (isbegin_quest(8691) == 1) {
			erasequest 8691;
			setquest 8692;
		}
		getitem 1000410,1;	// Ep18_Water_Filter
		mes "[Salesman]";
		mes "这是你的道具~";
		mes "愿芙蕾雅女神祝福你。";
		close;
	}
	if (isbegin_quest(8695) == 1 || isbegin_quest(8696) == 1 && countitem(1000410) < 1) {
		mes "[Salesman]";
		mes "这是提取今日鱼之精华的圣物~";
		mes "趁卖光前快点~";
		next;
		mes "[Salesman]";
		mes "啊，你上次去山顶了，对吧？";
		mes "回来得比预想快。看来生意不错~";
		next;
		switch( select( "Buy a relic", "Listen to an explanation", "Cancel" ) ) {
		case 1:
			break;
		case 2:
			end;
		case 3:
			end;
		}
		mes "[Salesman]";
		mes "这是 550 Zeny~";
		next;
		if (select( "buy", "don't buy" ) == 2)
			end;
		if (Zeny < 550) {
			mes "[Salesman]";
			mes "你的 Zeny 不够。";
			close;
		}
		Zeny -= 550;
		if (isbegin_quest(8695) == 1) {
			erasequest 8695;
			setquest 8696;
		}
		getitem 1000410,1;	// Ep18_Water_Filter
		mes "[Salesman]";
		mes "东西在这里~";
		mes "愿芙蕾雅女神祝福你~";
		close;
	}
	mes "[Salesman]";
	mes "今天的净水圣物刚刚出炉~";
	mes "每人限购一个。现在快来~";
	close;

OnInit:
	questinfo( QTYPE_QUEST2, QMARK_YELLOW, "isbegin_quest(8691) == 1" );
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "isbegin_quest(8695) == 1" );
	end;
}

// Quest: Purifying Water. Step 3.
wolfvill,104,235,0	script	Water barrel#ep1801	CLEAR_NPC,{
	if (isbegin_quest(8692) == 1 || isbegin_quest(8696) == 1) {
		if (countitem(1000410) < 1)
			end;
		if (checkweight(1000411,1) == 0) {
			mes "- Wait a minute !! -";
			mes "- 你现在携带了太多物品。-";
			mes "-";
			mes "- Please try again -";
			mes "- 减轻负重后再试。-";
			close;
		}
		specialeffect EF_BLUECASTING;
		specialeffect EF_STOPEFFECT;
		specialeffect EF_HEALSP;
		specialeffect EF_SMOKE;
		delitem 1000410,1;	// Ep18_Water_Filter
		getitem 1000411,1;	// Ep18_Purified_Bucket
		if (isbegin_quest(8692) == 1)
			changequest 8692,8693;
		else
			changequest 8696,8697;
		mes "我以为水已经很干净了，但放入圣物后它发出耀眼光芒，带来些许神圣感。";
		mes "光芒消退后，水看起来干净了。";
		next;
		mes "我会把它装进桶里带给布丹。";
		close;
	}
	mes "这是全村使用的饮用水容器。";
	mes "一侧装着清水，另一侧装着较干净的水。";
	close;

OnInit:
	questinfo( QTYPE_QUEST2, QMARK_YELLOW, "isbegin_quest(8692) == 1" );
	questinfo( QTYPE_QUEST2, QMARK_YELLOW, "isbegin_quest(8696) == 1" );
	end;
}

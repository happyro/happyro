wolfvill,50,234,6	script(CLOAKED)	Hazar#ep18_1	4_EP18_HAZAR,{
	if (ep18_main < 36)
		end;
	switch( isbegin_quest(12532) ) {
	case 0:
		mes "^0000ff一位老人正在训斥年轻人。^000000";
		next;
		npctalk "我不是说过今天必须出发吗？", "Hazar#ep18_1", bc_self;
		next;
		npctalk "是的，您说过。", "Camille#ep18_1", bc_self;
		next;
		npctalk "这辆车怎么回事？车轮上是金子吗？你换了新车轮，还是我的眼睛老得看不清了？", "Hazar#ep18_1", bc_self;
		next;
		npctalk "抱歉！我赶紧找了新车轮，但没找到备用的……", "Camille#ep18_1", bc_self;
		next;
		npctalk "要前往上游，物资中应该有 30 张皮革，但我好像看不到。也是我的眼睛出问题了吗？", "Hazar#ep18_1", bc_self;
		next;
		emotion ET_HUK, getnpcid(0,"Camille#ep18_1");
		npctalk "糟糕！", "Camille#ep18_1", bc_self;
		next;
		npctalk "拉车的牛现在跑哪去了？我一定是老了，看来该退休了。我什么都看不见。", "Hazar#ep18_1", bc_self;
		next;
		npctalk "对不起。我马上就到！", "Camille#ep18_1", bc_self;
		next;
		npctalk "你招募护送骑士了吗？为什么没人出现？你不会真想让我一个人拉这辆车吧。", "Hazar#ep18_1", bc_self;
		next;
		npctalk "那个……师父，我试着为旅程招募人员，但没人自愿参加。", "Camille#ep18_1", bc_self;
		next;
		npctalk "你根本没打算去上游，Camille……你到底在想什么？", "Hazar#ep18_1", bc_self;
		next;
		npctalk "......", "Camille#ep18_1", bc_self;
		next;
		npctalk "准备工作有什么不足我之后会彻底调查，但现在先专注于实际问题。", "Hazar#ep18_1", bc_self;
		next;
		npctalk "交易日期已经确定，上游车必须出发。我们需要解决车轮和上游物资不足的问题。你打算怎么解决？", "Hazar#ep18_1", bc_self;
		next;
		npctalk "嗯……我先调整皮革数量！Uma 已经派人来了，应该很快就能准备好。", "Camille#ep18_1", bc_self;
		next;
		npctalk "车轮该怎么办？看起来太不稳了，走几步可能就会散架。", "Hazar#ep18_1", bc_self;
		next;
		if (select( "插手", "忽略" ) == 2) {
		mes "^0000ff插手没有好处，我们走自己的路吧。^000000";
			close;
		}
		npctalk "嗯？你想对我们做什么？那辆车的车轮已经够麻烦了。别打扰我们……", "Hazar#ep18_1", bc_self;
		next;
		select( "说明如何修理" );
		unittalk getcharid(3), "" + strcharinfo(0) + "：如果用结实的绳子加固车轮，应该就能勉强滚动了，你不觉得吗？", bc_self;
		next;
		npctalk "哦，这位冒险者。车轮又不是木椅之类的东西……不，真的能修好吗？", "Hazar#ep18_1", bc_self;
		next;
		if (select( "Wouldn't it be a good idea to at least give it a try?", "Indeed, it seems impossible." ) == 2) {
		mes "^0000ff到此为止，不要再插手了。^000000";
			close;
		}
		npctalk "冒险者。这次上游之行由我负责。如果你解决车轮问题，我们会按照部族传统支付相应的经验报酬。", "Camille#ep18_1", bc_self;
		next;
		if (select( "Alright!", "I guess that doesn't work." ) == 2)
			end;
		npctalk "谢谢。可以请你看看这辆车吗？", "Camille#ep18_1", bc_self;
		specialeffect 1090, AREA, "Transport Cart#ep18_1";
		next;
		npctalk "如果你能把车轮加固到足以用于远征，我会非常感激。谢谢。我得去检查远征要用的皮革，暂时离开一下……", "Camille#ep18_1", bc_self;
		setquest 12532;
		cloakonnpcself( "Camille#ep18_1" );
		close;
	case 1:
		npctalk "Hmm, I'm not sure if you can really fix that carriage wheel, but I'll give you the benefit of the doubt..", "Hazar#ep18_1", bc_self;
		end;
	case 2:
		break;
	}
	switch( isbegin_quest(12533) ) {
	case 0:
		mes "^0000ffHazar 以友善的目光凝视。^000000";
		next;
		npctalk "啊……你的技能真有趣，不是吗？", "Hazar#ep18_1", bc_self;
		next;
		npctalk "对了，Camille 已经整理好东西了吗？", "Hazar#ep18_1", bc_self;
		next;
		npctalk "师父，我已经确认了远征所需的全部物资。现在只要检查车子，就可以出发了……", "Camille#ep18_1", bc_self;
		next;
		npctalk "这位冒险者已经处理好了车轮。请向他表达我们的感谢。", "Hazar#ep18_1", bc_self;
		next;
		npctalk "非常感谢你，冒险者。远征回来后请来找我们。可以告诉我你的名字吗？", "Camille#ep18_1", bc_self;
		next;
		select( "我的名字是" + strcharinfo(0) + "，仅此而已。" );
		select( "旅途很长，我们现在出发吧……" );
		npctalk "你说得对。我现在必须出发远征。回来后一定会来向你问候。" + strcharinfo(0) + "。那么，师父，我现在出发了。", "Camille#ep18_1", bc_self;
		next;
		cloakonnpcself( "Camille#ep18_1" );
		cloakonnpcself( "Transport Cart#ep18_1" );
		npctalk "谢谢你帮助我弥补不足。虽然我很聪明，却总是想太多，不经意间暴露了自己丢脸的一面……", "Hazar#ep18_1", bc_self;
		next;
		npctalk "我无法保证那孩子能毫发无伤地完成远征。如果身体状况更好，我就会亲自带队。", "Hazar#ep18_1", bc_self;
		next;
		npctalk "" + strcharinfo(0) + "。当然，如果你有时间，可以再帮这位老人一个忙吗？", "Hazar#ep18_1", bc_self;
		next;
		select( "请告诉我吧。" );
		npctalk "Camille 第一次指挥远征，这让我有些不安。我不知道他们能否避开魔物袭击。", "Hazar#ep18_1", bc_self;
		next;
		npctalk "所以我想请你跟在后面照看他，可以吗？我无法提供太多报酬，但真心请求你的帮助……", "Hazar#ep18_1", bc_self;
		next;
		if (select( "我接受", "我拒绝" ) == 2)
			end;
		npctalk "不客气。真的非常感谢你，" + strcharinfo(0) + "。", "Hazar#ep18_1", bc_self;
		setquest 12533;
		close;
	case 1:
	mes "^0000ffHazar 以友善的目光凝视。^000000";
		next;
		npctalk "那么，我也该回去履行职责了。", "Hazar#ep18_1", bc_self;
		cloakonnpcself( "Hazar#ep18_1" );
		close;
	case 2:
	}
	end;

OnInit:
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "isbegin_quest(8692) == 1" );
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "isbegin_quest(12532) == 0 && isbegin_quest(11724) == 2" );
	questinfo( QTYPE_QUEST2, QMARK_YELLOW, "isbegin_quest(12533) == 0 && isbegin_quest(12532) == 2" );
	end;
}

// Quest: Transporting Goods. Step 2.
wolfvill,53,234,4	script	Transport Cart#ep18_1	4_EP18_WAGON,{
	if (ep18_main < 36)
		end;
	if (isbegin_quest(12532) == 1) {
		mes "^0000ff虽然看起来还好，但马车轮已经磨损。^000000";
		next;
		if (select( "I attempt maintenance work", "I stop the maintenance work" ) == 2) {
			mes "^0000ff之后想起来时再回来看看。^000000";
			close;
		}
		progressbar_npc "FFFF00",2;
		if (countitem(7197) < 1) {
			mes "没有可用于加固马车车轮的材料 <ITEM>[坚韧藤蔓]<INFO>7197</INFO></ITEM>。";
			close;
		}
		// note: Tough_Vines not deleted on fail
		.@r = rand(1,5);
		if (.@r == 1) {
			specialeffect EF_REFINEOK;
			mes "^0000ffRepair successful!^000000";
			delitem 7197,1;	// Tough_Vines
			removespecialeffect 1090;
			completequest 12532;
			close;
		}
		specialeffect EF_REFINEFAIL;
		mes "^0000ff似乎还没有正确加固。材料没有消失，所以继续尝试吧。^000000";
		close;
	}
	end;

OnInit:
	questinfo( QTYPE_QUEST2, QMARK_YELLOW, "isbegin_quest(12532) == 1" );
	end;
}

wolfvill,56,234,4	script(CLOAKED)	Camille#ep18_1	4_EP18_KAMIL,{
	mes "^0000ffHe seems preoccupied, perhaps scolded by Hazar^000000";

// Headgear Quests 1
// Cross Hat, Bulb Hairband, Striped Hairband, Blue Hairband
//============================================================ 
comodo,228,159,3	script	Hair Ornament Girl	700,{
	mes "[Hair Ornament Girl]";
	if (Sex == SEX_MALE) {
		mes "哦，你好！";
		mes "想订做发带吗？送给女朋友很合适，也能表达你的心意。";
	}
	else {
		mes "你好~！";
		mes "我想这些发带很适合你这样的漂亮女孩。想订做一条吗？";
	}
	next;
	mes "[Hair Ornament Girl]";
	mes "只要给我一些简单材料，我就能制作漂亮的发带。有问题的话尽管看看。";
	next;
	switch(select("十字帽:灯泡发带:条纹发带:蓝色发带")) {
	case 1:
		if ((countitem(2608) > 0) && (countitem(7069) > 499)) {
			mes "[Hair Ornament Girl]";
			mes "你选择了十字帽？";
			mes "如果带齐所需材料，我就为你制作~";
			next;
			mes "[Hair Ornament Girl]";
			mes "不过制作前，请确认材料是否正确。";
			mes "如果是锻造、升级过的物品，或镶嵌了怪物卡片，卡片和强化效果都会消失。";
			next;
			mes "[Hair Ornament Girl]";
			mes "最好只把所需材料放在物品栏里。确认好了吗？那就开始制作，好吗？";
			next;
			switch(select("没有。:是的。")) {
			case 1:
				mes "[Hair Ornament Girl]";
				mes "啊，好吧。你应该先把其他东西存进卡普拉仓库。那就下次见。";
				mes "下次见~";
				close;
			case 2:
				mes "^3355FF唰唰咔嚓咔嚓^000000";
				next;
				delitem 2608,1;  //Rosary
				delitem 7069,500;  //Broken_Armor_Piece
				mes "[Hair Ornament Girl]";
				mes "看看这个！做得好~";
				mes "请再来哦~呼~！";
				getitem 5036,1; // Cross_Band
				close;
			}
		}
		else {
			mes "[Hair Ornament Girl]";
			mes "哦，你选择了十字帽？";
			mes "制作这顶头饰需要一些材料。";
			next;
			mes "[Hair Ornament Girl]";
			mes "我需要……";
			mes "^3355FF1 Rosary^000000";
			mes "^3355FF500 Destroyed Armor^000000";
			next;
			mes "[Hair Ornament Girl]";
			mes "带齐材料后我马上为你制作。";
			mes "到时见~";
			close;
		}
	case 2:
		if ((countitem(2233) > 0) && (countitem(746) > 19)) {
			mes "[Hair Ornament Girl]";
			mes "你选择了灯泡发带？";
			mes "如果带齐所需材料，我就为你制作~";
			next;
			mes "[Hair Ornament Girl]";
			mes "制作前请确认材料是否正确。";
			mes "锻造、升级过或镶嵌怪物卡片的物品，其卡片和强化效果都会消失。";
			next;
			mes "[Hair Ornament Girl]";
			mes "最好只把所需材料放在物品栏里。确认好了吗？那就开始制作，好吗？";
			next;
			switch(select("没有。:是的。")) {
			case 1:
				mes "[Hair Ornament Girl]";
				mes "啊，好吧。你应该先把其他东西存进卡普拉仓库。那就下次见。";
				close;
			case 2:
				mes "^3355FFSwish swish snip snip^000000";
				next;
				delitem 2233,1;  //Circlet_
				delitem 746,20;  //Glass_Bead
				mes "[Hair Ornament Girl]";
				mes "看看这个！做得好~";
				mes "请再来哦~呼~！";
				getitem 5034,1; // Light_Bulb_Band
				close;
			}
		}
		else {
			mes "[Hair Ornament Girl]";
			mes "哦，你选择了灯泡发带？";
			mes "制作这顶头饰需要一些材料。";
			next;
			mes "[Hair Ornament Girl]";
			mes "我需要……";
			mes "^3355FF1 Slotted Circlet^000000";
			mes "^3355FF20 Glass Bead^000000";
			next;
			mes "[Hair Ornament Girl]";
			mes "带齐材料后我马上为你制作。";
			mes "到时见~";
			close;
		}
	case 3:
		if (countitem(1099) > 1499) {
			mes "[Hair Ornament Girl]";
			mes "你选择了条纹发带？";
			mes "如果带齐所需材料，我就为你制作~";
			next;
			mes "[Hair Ornament Girl]";
			mes "你想让我现在制作吗？";
			next;
			switch(select("没有。:是的。")) {
			case 1:
				mes "[Hair Ornament Girl]";
				mes "那就下次见~";
				close;
			case 2:
				mes "^3355FFSwish swish snip snip^000000";
				next;
				delitem 1099,1500;  //Worn_Out_Prison_Uniform
				mes "[Hair Ornament Girl]";
				mes "看看这个！做得好~";
				mes "请再来哦~";
				getitem 5049,1; // Stripe_Band
				close;
			}
		}
		else {
			mes "[Hair Ornament Girl]";
			mes "哦，你选择了条纹发带？制作这顶头饰需要一些材料。";
			next;
			mes "[Hair Ornament Girl]";
			mes "我需要……";
			mes "^3355FF1500 Worn-out Prison Uniform^000000";
			next;
			mes "[Hair Ornament Girl]";
			mes "带齐所有材料后我马上为你制作。";
			mes "See you then~";
			close;
		}
	case 4:
		if ((countitem(2211) > 0) && (countitem(978) > 0) && (countitem(7003) > 299)) {
			mes "[Hair Ornament Girl]";
			mes "你选择了蓝色发带？";
			mes "如果带齐所需材料，我就为你制作~";
			next;
			mes "[Hair Ornament Girl]";
			mes "制作前请确认材料是否正确。";
			mes "锻造、升级过或镶嵌怪物卡片的物品，其卡片和强化效果都会消失。";
			next;
			mes "[Hair Ornament Girl]";
			mes "最好只把所需材料放在物品栏里。确认好了吗？那就开始制作，好吗？";
			next;
			switch(select("没有。:是的。")) {
			case 1:
				mes "[Hair Ornament Girl]";
				mes "啊，好吧。你应该先把其他东西存进卡普拉仓库。那就下次见。";
				close;
			case 2:
				mes "^3355FFSwish swish snip snip^000000";
				next;
				delitem 2211,1;  //Bandana
				delitem 978,1;  //Cobaltblue_Dyestuffs
				delitem 7003,300;  //Anolian_Skin
				mes "[Hair Ornament Girl]";
				mes "看看这个！做得好！";
				mes "请再来哦~";
				getitem 5052,1; // Blue_Hair_Band
				close;
			}
		}
		else {
			mes "[Hair Ornament Girl]";
			mes "哦，你选择了蓝色发带？";
			mes "制作这顶头饰需要一些材料。";
			next;
			mes "[Hair Ornament Girl]";
			mes "我需要……";
			mes "^3355FF1 Bandana^000000";
			mes "^3355FF1 Cobaltblue Dyestuffs^000000";
			mes "^3355FF300 Anolian Skin^000000";
			next;
			mes "[Hair Ornament Girl]";
			mes "带齐材料后我马上为你制作。";
			mes "到时见~";
			close;
		}
	}
}

// Headgear Quests 2
// 'Mine Helmet', 'Parcel Hat', 'Money Loser's Grief', 'Phantom of the Opera Mask'
//============================================================ 
comodo,273,137,4	script	Traveler#head	702,{
	mes "[Isac Mari]";
	mes "我周游世界，收集人们有趣的故事。有时他们会教我制作特殊物品。";
	next;
	mes "[Isac Mari]";
	mes "我会制作各种各样的世界帽子。但现在没有合适材料，暂时做不了。";
	next;
	switch(select("矿工头盔:包裹帽:贪婪悲鸣:歌剧魅影面具")) {
	case 1:
		if ((countitem(5009) > 0) && (countitem(5028) > 0) && (countitem(999) > 24) && (countitem(747) > 0)) {
			mes "[Isac Mari]";
			mes "矿工头盔是为煤矿矿工在黑暗中照明而设计的。如果带齐材料，我就为你制作~";
			next;
			mes "[Isac Mari]";
			mes "请确认物品栏中的材料没有升级或镶嵌卡片。若有锻造强化或卡片，制作矿工帽后都会消失。";
			next;
			mes "[Isac Mari]";
			mes "最好只把制作矿工帽的材料放在物品栏里。确认好了吗？那就开始吧。";
			next;
			switch(select("请等我一下~！:制作矿工帽。")) {
			case 1:
				mes "[Isac Mari]";
				mes "好吧。请再检查一次材料，谨慎总没错。";
				close;			break;
			case 2:
				mes "^3355FF*Thook Thook*";
				mes "*Pop!*^000000";
				next;
				mes "[Isac Mari]";
				mes "呼！这真难！";
				next;
				delitem 5009,1;  //Safety_Helmet
				delitem 5028,1;  //Candle
				delitem 747,1;  //Crystal_Mirror
				delitem 999,25;  //Steel
				mes "[Isac Mari]";
				mes "不确定是不是正确的，但看起来差不多。哈哈~";
				getitem 5031,1; // Mine_Helm
				close;
			}
		}
		else {
			mes "[Isac Mari]";
			mes "听说吉芬附近的矿井使用矿工头盔。你知道，没有光就无法工作，尽管光会吸引洞穴里的怪物。";
			next;
			mes "[Isac Mari]";
			mes "有一天，一名矿工改造了安全帽，让自己能解放双手工作。从那以后它就被称为矿工头盔。";
			next;
			mes "[Isac Mari]";
			mes "如果想制作矿工头盔，";
			mes "^3355FF1 Safety Helmet^000000";
			mes "^3355FF1 Candle^000000 ";
			mes "^3355FF1 Crystal Mirror^000000";
			mes "^3355FF25 Steel^000000";
			mes "需要这些材料。";
			next;
			mes "[Isac Mari]";
			mes "带齐材料后我马上为你制作。回头见~";
			close;
		}
	case 2:
		if ((countitem(1059) > 149) && (countitem(907) > 99) && (countitem(978) > 0)) {
			mes "[Isac Mari]";
			mes "包裹帽似乎方便商人携带商品。如果带齐材料，我就为你制作。";
			mes "如果带齐所需材料，我就为你制作~";
			next;
			mes "[Isac Mari]";
			mes "请确认材料没有升级或镶嵌卡片。若有锻造强化或卡片，制作包裹帽后都会消失。";
			next;
			mes "[Isac Mari]";
			mes "最好只把制作包裹帽的材料放在物品栏里。确认好了吗？那就开始吧。";
			next;
			switch(select("请等我一下~！:制作包裹帽。")) {
			case 1:
				mes "[Isac Mari]";
				mes "好。请再次确认物品。小心一点总没错。";
				close;
			case 2:
				mes "^3355FF*Thook Thook*";
				mes "*Pop!*^000000";
				next;
				mes "[Isac Mari]";
				mes "哦……";
				mes "我好像搞砸了！";
				mes "不，等等，我应该能修好……";
				next;
				delitem 1059,150;  //Transparent_Cloth
				delitem 907,100;  //Resin
				delitem 978,1;  //Cobaltblue_Dyestuffs
				mes "[Isac Mari]";
				mes "嗯……";
				mes "呃，看起来像包裹帽。对我来说这样就够了！哈哈~";
				getitem 5023,1; // Hat_Of_Bundle
				close;
			}
		}
		else {
			mes "[Isac Mari]";
			mes "听说在艾尔贝塔，商人总是在街中央从手推车上卖货。";
			next;
			mes "[Isac Mari]";
			mes "但在国家东部，他们用不同方式运输货物。";
			next;
			mes "[Isac Mari]";
			mes "货物会打包后顶在头上，这样不用手拿东西。但保持平衡很难。";
			next;
			mes "[Isac Mari]";
			mes "我需要……";
			mes "^3355FF150 Fabric^000000";
			mes "^3355FF100 Resin^000000 and";
			mes "^3355FF1 Cobaltblue Dyestuffs^000000";
			mes "来制作包裹帽。";
			next;
			mes "[Isac Mari]";
			mes "带齐材料后我马上为你制作。回头见~！";
			close;
		}
	case 3:
		if ((countitem(2233) > 0) && (countitem(969) > 0) && (countitem(949) > 79) && (countitem(999) > 19) && (countitem(938) > 799)) {
			mes "[Isac Mari]";
			mes "贪婪悲鸣……";
			mes "如果带齐所需材料，我就为你制作~";
			next;
			mes "[Isac Mari]";
			mes "请确认材料没有升级或镶嵌卡片。若有锻造强化或卡片，制作贪婪悲鸣后都会消失。";
			next;
			mes "[Isac Mari]";
			mes "最好只把制作贪婪悲鸣的材料放在物品栏里。确认好了吗？那就开始吧。";
			next;
			switch(select("请等我一下~！:制作贪婪悲鸣。")) {
			case 1:
				mes "[Isac Mari]";
				mes "好。请再次确认物品。小心一点总没错。";
				close;
			case 2:
				mes "^3355FF*Thook Thook*";
				mes "*Pop!*^000000";
				next;
				mes "[Isac Mari]";
				mes "呼！这真难！";
				next;
				delitem 2233,1;  //Circlet_
				delitem 969,1;  //Gold
				delitem 949,80;  //Feather
				delitem 999,20;  //Steel
				delitem 938,800;  //Sticky_Mucus
				mes "[Isac Mari]";
				mes "我可能犯了些错，但看起来还行。给你，这是你的贪婪悲鸣帽！";
				getitem 5021,1; // Bankruptcy_Of_Heart
				close;
			}
		}
		else {
			mes "[Isac Mari]";
			mes "贪婪悲鸣……";
			mes "很久以前，梦罗克有位诚实的商人，曾与邪恶公会发生争执。";
			next;
			mes "[Isac Mari]";
			mes "因为这位诚实商人不靠价格欺骗顾客，他的摊位遭到邪恶公会袭击，所有货物都被抢走。";
			next;
			mes "[Isac Mari]";
			mes "诚实商人失去了一切，只剩下一些破损物品。为了表达悲伤，他用这些物品制作了这顶华丽的贪婪悲鸣帽。";
			next;
			mes "[Isac Mari]";
			mes "这顶特殊的帽子能引起人们的同情，让他们购买更多货物，支持诚实商人的善良。";
			next;
			mes "[Isac Mari]";
			mes "制作这顶帽子，我需要……";
			mes "^3355FF1 Slotted Circlet^000000";
			mes "^3355FF1 Gold^000000";
			mes "^3355FF20 Steel^000000";
			mes "^3355FF80 Feather^000000";
			mes "^3355FF800 Sticky Mucus^000000";
			next;
			mes "[Isac Mari]";
			mes "带齐所有材料后我马上为你制作。回头见～";
			close;
		}
	case 4:
		if ((countitem(2281) > 0) && (countitem(1048) > 49)) {
			mes "[Isac Mari]";
			mes "歌剧魅影面具……";
			mes "恐怖，却又悲剧而浪漫。如果带齐材料，我就为你制作~";
			next;
			mes "[Isac Mari]";
			mes "请确认材料没有升级或镶嵌卡片。若有锻造强化或卡片，制作歌剧面具后都会消失。";
			next;
			mes "[Isac Mari]";
			mes "最好只把制作歌剧面具的材料放在物品栏里。确认好了吗？那就开始吧。";
			next;
			switch(select("请等我一下~！:制作歌剧面具。")) {
			case 1:
				mes "[Isac Mari]";
				mes "好吧。请再检查一次材料，谨慎总没错。";
				close;
			case 2:
				mes "^3355FF*Thook Thook*";
				mes "*Pop!*^000000";
				next;
				mes "[Isac Mari]";
				mes "呼！这真难！";
				next;
				delitem 2281,1;  //Phantom_Of_Opera
				delitem 1048,50;  //Slender_Snake
				mes "[Isac Mari]";
				mes "不确定是不是正确的。";
				mes "但看起来还行。哈哈。";
				getitem 5043,1; // Opera_Ghost_Mask
				close;
			}
		}
		else {
			mes "[Isac Mari]";
			mes "歌剧魅影面具……";
			mes "这面具背后，是一个男人的爱情与个人悲剧。";
			next;
			mes "[Isac Mari]";
			mes "你可能知道他就是歌剧魅影。他是音乐天才，却因毁容的脸被迫离群索居，给舞台带来恐怖。";
			next;
			mes "[Isac Mari]";
			mes "然而，他爱上了一位美丽的歌手，并用自己的才华让她声名大噪。最后，他向她揭示了自己的身份。";
			next;
			mes "[Isac Mari]";
			mes "最后……";
			mes "她深深关心他，却爱着另一位歌手。魅影消失了，也许去了别处徘徊，留下的只有他的面具……";
			next;
			mes "[Isac Mari]";
			mes "他戴的面具与其他歌剧面具形状不同，是专门用来遮住脸上的伤疤。";
			next;
			mes "[Isac Mari]";
			mes "如果你想制作歌剧魅影面具，需要：";
			mes "^3355FF1 Opera Masque^000000";
			mes "^3355FF50 Horrendous Hair^000000";
			next;
			mes "[Isac Mari]";
			mes "带齐材料后我马上为你制作。回头见~";
			close;
		}
	}
}

// Doomed Swords - Comodo Portion. (Continued in Juno)
//============================================================ 
comodo,206,310,4	script	Campground Boy#cmd	704,{
	switch (dmdswrd_Q) {
	case 0:
		mes "[Rochito]";
		mes "面包、水果、蔬菜……";
		mes "呸。那些食物和";
		mes "肉的丰厚滋味相比";
		mes "根本不算什么。没错，";
		mes "在科莫多露营烧烤";
		mes "对我这样的肉食爱好者来说就是天堂~";
		next;
		if (select("烧烤露营……？:取消") == 1) {
			mes "[Rochito]";
			mes "没错……烧烤露营时，";
			mes "你可以一整天吃科莫多鲁肉。科莫多鲁";
			mes "是科莫多特有的动物，";
			mes "每个部位都很美味。每一口都是。";
			next;
			mes "[Rochito]";
			mes "让肉更美味的是他们使用的";
			mes "特殊科塞拉塞拉调味料。";
			mes "那东西几乎……";

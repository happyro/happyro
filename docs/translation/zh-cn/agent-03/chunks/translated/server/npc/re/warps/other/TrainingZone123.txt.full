//===== rAthena Script =======================================
//= Training Zone
//===== Description: =========================================
//= NPC warp related to the training zone.
//===== Changelog: ===========================================
//= 1.0 Training Zone revamp : tra_fild splitted into
//      tra_fild01, tra_fild02 and tra_fild03 [Atemo]
//============================================================

prontera,246,62,3	script	Training Instructor#prontera_in	8W_SOLDIER,{
	mes "[训练教官]";
	mes "王室为想测试实力的冒险者设置了训练场。如果你想在不同条件下测试自己，我们会把你送往训练场。";
	next;
	switch( select( "▶进入基础训练场", "▶进入 1/10 训练场", "▶进入 1/100 训练场", "▶取消" ) ) {
	case 1:
		mes "[训练教官]";
		mes "我会把你送到基础训练场。";
		close2;
		.@x = rand(109,110);
		.@y = rand(93,94);
		warp "tra_fild01",.@x,.@y;
		break;
	case 2:
		mes "[训练教官]";
		mes "我会把你送到 1/10 训练场。";
		close2;
		.@x = rand(109,110);
		.@y = rand(93,94);
		warp "tra_fild02",109,94;
		break;
	case 3:
		mes "[训练教官]";
		mes "我会把你送到 1/100 训练场。";
		close2;
		.@x = rand(109,110);
		.@y = rand(93,94);
		warp "tra_fild03",.@x,.@y;
		break;
	case 4:
		break;
	}
	end;
}


// Warps
tra_fild01,204,117,2	script	Training Ground Manager#fild01_1	8W_SOLDIER,{
	mes "[训练场管理员]";
	mes "想前往训练场内的其他区域吗？请选择要前往的位置。";
	next;
	switch( atoi( charat(strnpcinfo(2), 7) ) ) {
	case 1:
		.@menu$[0] = "中央区域";
		.@menu$[1] = "";
		.@menu$[2] = "9 点钟方向区域";
		.@menu$[3] = "6 点钟方向区域";
		break;
	case 2:
		.@menu$[0] = "中央区域";
		.@menu$[1] = "3 点钟方向区域";
		.@menu$[2] = "";
		.@menu$[3] = "6 点钟方向区域";
		break;
	case 3:
		.@menu$[0] = "▶ Central area";
		.@menu$[1] = "3 点钟方向区域";
		.@menu$[2] = "9 点钟方向区域";
		.@menu$[3] = "";
		break;
	case 4:
		.@menu$[0] = "";
		.@menu$[1] = "3 点钟方向区域";
		.@menu$[2] = "9 点钟方向区域";
		.@menu$[3] = "6 点钟方向区域";
		break;
	}
	switch( select( .@menu$[0], .@menu$[1], .@menu$[2], .@menu$[3], "▶前往普隆德拉", "▶取消" ) ) {
	case 1:
		warp strcharinfo(3),109,94;
		break;
	case 2:
		warp strcharinfo(3),198,114;
		break;
	case 3:
		warp strcharinfo(3),22,114;
		break;
	case 4:
		warp strcharinfo(3),109,41;
		break;
	case 5:
		warp "prontera",246,60;
		break;
	case 6:
		break;
	}
	end;
}
tra_fild01,15,117,6	duplicate(Training Ground Manager#fild01_1)	Training Ground Manager#fild01_2	8W_SOLDIER

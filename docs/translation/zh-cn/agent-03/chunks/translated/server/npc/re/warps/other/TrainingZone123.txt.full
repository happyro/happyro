tra_fild01,12,114,0	script	tra_fild01_out1	WARPNPC,2,2,{
	end;
OnTouch:
	switch( atoi( charat(strnpcinfo(1), 9) ) ) {
	case 1:
		.@menu$[0] = "";
		.@menu$[1] = "进入 1/10 训练场";
		.@menu$[2] = "进入 1/100 训练场";
		break;
	case 2:
		.@menu$[0] = "进入基础训练场s";
		.@menu$[1] = "";
		.@menu$[2] = "进入 1/100 训练场s";
		break;
	case 3:
		.@menu$[0] = "进入基础训练场s";
		.@menu$[1] = "进入 1/10 训练场s";
		.@menu$[2] = "";
		break;
	}
	switch( select( "▶前往普隆德拉", .@menu$[0], .@menu$[1], .@menu$[2], "▶取消" ) ) {
	case 1:
		warp "prontera",246,60;
		break;
	case 2:
		.@x = rand(109,110);
		.@y = rand(93,94);
		warp "tra_fild01",.@x,.@y;
		break;
	case 3:
		.@x = rand(109,110);
		.@y = rand(93,94);
		warp "tra_fild02",.@x,.@y;
		break;
	case 4:
		.@x = rand(109,110);
		.@y = rand(93,94);
		warp "tra_fild03",.@x,.@y;
		break;
	case 5:
		break;
	}
	end;
}

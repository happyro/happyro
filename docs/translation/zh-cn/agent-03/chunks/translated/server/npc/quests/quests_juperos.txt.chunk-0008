// Security Checkpoint 2-3
//============================================================
jupe_area2,127,146,0	script	#hole#2-3	844,{
	cutin "3",2;
	if ($@JupreArea2InUse == 1) {
		mes "^3355FF这似乎是";
		mes "某种装置，";
		mes "可以让你";
		mes "通往另一边。";
		mes "上面有一个插槽，";
		mes "你可能需要插入";
		mes "某种物品……^000000";
		close2;
		cutin "3",255;
		end;
	}
	else if (countitem(7356) > 0 || countitem(7359) > 0 || countitem(7357) > 0 || countitem(7358) > 0) {
		mes "^3355FF这似乎是";
		mes "某种装置，";
		mes "可以让你";
		mes "通往另一边。";
		mes "上面有一个插槽，";
		mes "你可能需要插入";
		mes "某种物品……^000000";
		next;
		switch(select("插入徽章碎片。:取消。")) {
		case 1:
			if (countitem(7358) > 0) {
				mes "^3355FF你取出";
				mes "徽章碎片并放入";
				mes "插槽，恰好";
				mes "完美契合。^000000";
				specialeffect EF_TOPRANK;
				cutin "3-1",2;
				next;
				if ($@JupreArea2InUse == 1) {
					mes "^3355FF什么也没发生。";
					mes "也许警报或其他";
					mes "安全措施被启动，";
					mes "阻止徽章碎片启动";
					mes "这个传送装置。";
					mes "你取回徽章碎片。^000000";
					close2;
					cutin "3-1",255;
					end;
				}
				else {
					mes "^3355FF插槽旋转，";
					mes "徽章碎片像钥匙一样转动。";
					mes "你感到轻微震动，另一边的";
					mes "传送门被激活。";
					mes "随后你取回";
					mes "徽章碎片。^000000";
					initnpctimer;
					donpcevent "Warp#2-3::OnEnable";
					enablenpc "Red Alarm#2-3";
					disablenpc "#hole#2-3";
					close2;
					cutin "3-1",255;
					end;
				}
			}
			else {
				mes "^3355FF很遗憾，你没有携带";
				mes "任何可能适合";
				mes "插槽并启动";
				mes "这个机械装置的物品。^000000";
				close2;
				cutin "3",255;
				end;
			}
		case 2:
			mes "[" + strcharinfo(0) + "]";
			mes "嗯……";
			mes "我有什么东西";
			mes "能让这台";
			mes "奇怪机器运转吗？";
			close2;
			cutin "3",255;
			end;
		}
	}
	else {
		mes "^3355FF这似乎是";
		mes "某种装置，";
		mes "可以让你";
		mes "通往另一边。";
		mes "上面有一个插槽，";
		mes "你可能需要插入";
		mes "某种物品……^000000";
		close2;
		cutin "3",255;
		end;
	}
	end;

OnStop_Timer:
	stopnpctimer;
	end;

OnTimer22500:
	stopnpctimer;
	enablenpc "#hole#2-3";
	disablenpc "Red Alarm#2-3";
	end;
}


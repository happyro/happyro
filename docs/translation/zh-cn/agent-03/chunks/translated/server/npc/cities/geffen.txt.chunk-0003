			mes "[灵媒顾问]";
			mes "试着和解，放下自尊，必要时真诚道歉。友谊难道不值得吗？我觉得值得。";
			next;
		}
		mes "[灵媒顾问]";
		mes "希望我解答了你对未来的疑惑。毕竟，我的工作就是专业灵媒顾问。随时欢迎回来~";
		close;
	case 2:
		mes "[灵媒顾问]";
		switch(rand(1,4)) {
		case 1:
			mes "想知道爱情运势吗？哦呵~那你一定有喜欢的人！来吧，告诉我！";
			next;
			mes "[灵媒顾问]";
			mes "对了……";
			mes "嗯，我感受到从你灵魂散发出的强烈爱情能量。它相当震撼，会赶走软弱和没骨气的人。";
			next;
			mes "[灵媒顾问]";
			mes "所以我预见，你很快只会吸引真正强壮的人。比如职业运动员、健美运动员、建筑工人之类。";
			next;
			mes "[灵媒顾问]";
			mes "如果这正是你想要的，恭喜你！今天好运带着喜悦向你微笑。";
			next;
			mes "[灵媒顾问]";
			mes "但如果这与你的愿望相反，很遗憾。今天好运向你露出讽刺的微笑。不过改变命运还不晚！";
			next;
			break;
		case 2:
			mes "爱~情，是吗？";
			mes "让我联系一下";
			mes "灵魂。";
			next;
			mes "[灵媒顾问]";
			mes "啊！旧情人会回来！不知道他们会再次爱上你、向你要钱，还是回来复仇……";
			next;
			mes "[灵媒顾问]";
			mes "但旧情人一定会以某种方式重回你的生活。如果这是好消息，恭喜你！如果是坏消息，那就小心！";
			next;
			break;
		case 3:
			mes "嗯……";
			if (Sex == SEX_MALE)
				mes "你正在交往的女孩";
			else
			mes "你正在交往的男孩";
			mes "非常适合你！";
			next;
			switch(select("你怎么知道？:你错得离谱！:我单身！")) {
			case 1:
				mes "[Psychic Advisor]";
				mes "嗯……";
				mes "我们灵媒在这方面相当准确。看到你和伴侣真的很幸福，真好！";
				close;
			case 2:
				mes "[Psychic Advisor]";
				mes "你没让我说完。我想说的是……";
				next;
				mes "[Psychic Advisor]";
				if (Sex == SEX_MALE)
					mes "你正在交往的女孩";
				else
					mes "你正在交往的男孩";
				mes "如果你想在彻底的痛苦中度过余生，她就非常适合你！";
				next;
				mes "[Psychic Advisor]";
				mes "即使要分手，也要尽快，并在之后努力成为好朋友。";
				next;
				mes "[Psychic Advisor]";
				mes "这会让你们都成为更好的人。不过这只是我的想法。";
				close;
			case 3:
				mes "[Psychic Advisor]";
				mes "哦……";
				mes "嗯，抱歉。";
				mes "有时我会把未来和现在搞混。毕竟我总是在窥视未来……？";
				next;
				mes "[Psychic Advisor]";
				if (Sex == SEX_MALE) {
					mes "我想说的是";
					mes "^3355FF你很快会和完美女人相爱^000000。对，就是这个意思！";
				}
				else {
					mes "我想说的是";
					mes "^3355FF你很快会被完美男人迷倒^000000。对，就是这个意思！";
				}
				close;
			}
			break;
		case 4:
			mes "想找浪漫，是吗？生活总是需要更多刺激。";
			next;
			mes "[Psychic Advisor]";
			mes "奇怪，我预见你的未来有爱情三角。不，等等！爱情……";
			mes "十边形？";
			next;
			mes "[Psychic Advisor]";
			mes "十一边形叫什么？你不能指望我立刻知道。我是灵媒，不是数学家！";
			next;
		}
		mes "[灵媒顾问]";
		mes "爱情总是有趣！即使在这个黯淡的世界，爱也以诱人的光芒围绕着我们。珍惜那个特别的人，再来做一次占卜吧！";
		close;
	case 3:
		mes "[灵媒顾问]";
		switch(rand(1,3)) {
		case 1:
			mes "金钱？你的财运一定比我好。毕竟我整天坐在这里免费提供服务！";
			next;
			mes "[灵媒顾问]";
			mes "嗯……";
			mes "灵魂告诉我，不管你买多少彩票，可能都不会中奖。抱歉，但这是真的。";
			next;
			mes "[灵媒顾问]";
			mes "但我刚刚帮你省下了一辈子的彩票钱！那可是一大笔钱！";
			next;
			break;
		case 2:
			mes "啊，是的。让我联系灵界。尽管那里没有经济体系，他们通常能给出可靠的理财建议。";
			next;
			mes "[灵媒顾问]";
			mes "首先要对自己的钱负责，制定适合你的预算。一个经验法则：每赚 10 Zeny，就拿出 1 Zeny 存起来或投资。";
			next;
			mes "[灵媒顾问]";
			mes "无论如何，别在卢恩·米德加尔兹当灵媒顾问。看来真正赚钱的是发现新国家。我当初怎么没这么做？！";
			next;
			break;
		case 3:
			mes "所以你想知道金钱运势，是吗？让我与超自然领域的灵魂交流……";
			next;
			mes "[灵媒顾问]";
			mes "啊，是的。他们告诉我凡事适度最好。一定要确保开支不超过预算。";
			next;
			mes "[灵媒顾问]";
			mes "不过也要避免拿钱赌博。也就是说，要谨慎储蓄和投资。不要被高风险的快速致富计划诱惑！";
			next;
			mes "[灵媒顾问]";
			mes "另一方面，只要你知道自己在做什么，慢慢致富的计划也可以。我说得对吧？";
			next;
		}
		mes "[灵媒顾问]";
		mes "生活需要钱，但只有钱并不等于生活。别忘了还有其他重要的事。尽量别给自己太大压力，好吗？";
		close;
	case 4:
		mes "[灵媒顾问]";
		switch(rand(1,4)) {
		case 1:
			mes "你的成绩？你还在上学？真令人佩服！从你的眼神看，你比同龄人成熟。好，让我联系灵魂……";
			next;
			mes "[灵媒顾问]";
			mes "嗯？灵魂只说了‘你学习了吗？’看来我用另一个问题回答了你的问题！";
			next;
			break;
		case 2:
			mes "你问我成绩？真奇怪。一般只有学校才会问成绩单吧？";
			next;
			mes "[灵媒顾问]";
			mes "教育非常重要，但如果成绩不如意，也不要气馁。";
			next;
			mes "[灵媒顾问]";
			mes "也许学校不支持你的学习方式，或者你对学业不太感兴趣。这可以理解。";
			next;
			mes "[灵媒顾问]";
			mes "灵魂告诉我，你应该尝试不同的学习方式，确保取得想要的成绩。";
			next;
			mes "[Psychic Advisor]";
			mes "是啊……";
			mes "灵魂今天";
			mes "懒得出奇。";
			next;
			break;
		case 3:
			mes "^FF0000F 减分^000000！";
			mes "哈哈哈哈哈哈~！";
			next;
			mes "[Psychic Advisor]";
			mes "哦，抱歉，我只是喜欢这么做。好，这次让我认真问问灵魂。嗯……";
			next;
			mes "[Psychic Advisor]";
			mes "嗯。灵魂今天真无礼。他们说：‘如果你这么担心成绩，为什么不去问老师？’";
			next;
			mes "[Psychic Advisor]";
			mes "仔细想想，他们说得有道理。为什么不问问老师、教授之类的人，看看你是否有问题？";
			next;
			mes "[Psychic Advisor]";
			mes "他们可是拿钱帮助你的。而我的服务是免费的。所以……嗯。";
			next;
			break;
		case 4:
			mes "哦，酷！";
			mes "我感觉你很快会得到全 A……";
			mes "在努力方面！";
			next;
			mes "[Psychic Advisor]";
			mes "我不能告诉你真实成绩。你也许注定每门课都拿 A，但如果我告诉你……";
			next;
			mes "[Psychic Advisor]";
			mes "你可能会骄傲自满、放松学习、挂科并造成时间悖论。要看到这些，我得真的身处未来，你懂吗？";
			next;
			mes "[Psychic Advisor]";
			mes "与其担心时间悖论，不如自己创造命运？";
			next;
		}
		mes "[Psychic Advisor]";
		mes "无论如何，专心学习很难，但也会有回报。希望你在选择的道路上取得好成绩~";
		close;
	case 5:
		mes "[Psychic Advisor]";
		mes "未来？我以为我说的任何运势都是你所选领域的未来。";
		next;
		mes "[Psychic Advisor]";
		mes "看来你想知道总体未来。让我和灵魂交流，看看它们怎么说，好吗？";
		next;
		mes "[Psychic Advisor]";
		switch(rand(1,4)) {
		case 1:
			mes "嗯……";
			mes "未来，性、暴力和摇滚乐都被彻底废除。人类进入完全和平、无比无聊的时代。";
			next;
			mes "[Psychic Advisor]";
			mes "我不知道那会发生在多远的未来，但最好别太快发生！";
			next;
			break;
		case 2:
			mes "未来，地球由一台巨型机器人保护：钚元素超速点火负电子 G，简称 POING。";
			next;
			mes "[Psychic Advisor]";
			mes "POING 多年来击退凯洛里安人的入侵，最终败给休布里斯博士的机械霸主：Nyxltron 47。";
			next;
			mes "[Psychic Advisor]";
			mes "幸运的是，派尤斯博士及时完成了钚元素超速点火负电子 G 系统的重力湮灭驱动器。";
			next;
			mes "[Psychic Advisor]";
			mes "于是 POING 再次崛起，重生为自动英雄：GOD-POING。当然，Nyxltron 47 被摧毁了。";
			next;
			mes "[Psychic Advisor]";
			mes "这大概是你能了解到的最重要的未来信息。相信我，其他部分都很无聊。";
			next;
			break;
		case 3:
			mes "未来，不管你信不信，互联网会被一个巨型大脑取代。我不知道怎么回事，但相信我，这大脑巨大无比。";
			next;
			mes "[Psychic Advisor]";
			mes "多亏了大量网络日志，这个大脑变得和平，决定不再像原计划那样统治世界。";
			next;
			mes "[Psychic Advisor]";
			mes "是的……";
			mes "只要人们继续在网上写个人日志，这个奇怪的大脑绝对会成为善的源泉，成为人类慈爱的恩人。";
			next;
			break;
		case 4:
			mes "未来，他们会基因改造各种植物。";
			mes "种类多得惊人！我说真的！";
			next;
			mes "[Psychic Advisor]";
			mes "最终，他们创造出能长出名人模仿者的树。如今看来这是科学奇迹，也是对好莱坞女星的威胁。";
			next;
			mes "[Psychic Advisor]";
			mes "不过，购买这些树的人，正是那些穿着俗气 T 恤的人……";
			next;
			mes "[Psychic Advisor]";
			mes "你懂的，就是那种无聊幽默的衣服，上面写着‘猫咪大灾难’，还印着一只打扮成疯狂科学家的小猫。";
			next;
		}
		mes "[Psychic Advisor]";
		mes "嗯……";
		mes "这就是我的预言。你真的能质疑灵界的智慧吗？";
		close;
	case 6:
		mes "[Psychic Advisor]";
		mes "时尚……？";
		mes "这和超自然有什么关系？嗯，让我联系灵魂。啊！开始了……";
		next;
		mes "[Psychic Advisor]";
		switch(rand(1,5)) {
		case 1:
			mes "...";
			next;
			mes "[Psychic Advisor]";
			mes "...";
			mes "......";
			next;
			mes "[Psychic Advisor]";
			mes "我看到了什么……";
			mes "看起来像是……";
			next;
			mes "[Psychic Advisor]";
			mes "一条……";
			mes "一条……鱼？";
			mes "在某人的头上？";
			next;
			mes "[Psychic Advisor]";
			mes "...";
			mes "那是最可怕的幻象！";
			next;
			break;
		case 2:
			mes "戴昂贵的头饰感觉很好！穿华丽的衣服也不错！但要记住……";
			next;
			mes "[Psychic Advisor]";
			mes "不管你在衣橱上花多少 Zeny，如果搭配不当，都会显得可笑。";
			next;
			mes "[Psychic Advisor]";
			mes "这里有个搭配不当的例子。想象一位十字军戴着王冠、精灵耳朵和铁链。";
			next;
			mes "[Psychic Advisor]";
			mes "他们不但不酷，反而像邪恶的基布勒王子。很吓人吧？";
			next;
			break;
		case 3:
			mes "我预言……";
			mes "牛仔帽很快会在女性";
			mes "超级初心者中";
			mes "大受欢迎！";
			next;
			mes "[Psychic Advisor]";
			mes "来吧，你不赞同吗？牛仔帽很适合超级初心者！";
			next;
			break;
		case 4:
			mes "有时遵循主题很可爱。比如同时戴天使之翼和天使之翼耳朵。";
			next;
			mes "[Psychic Advisor]";
			mes "当然，对大多数人来说可能太贵了，但你明白我的意思。";
			next;
			break;
		case 5:
			mes "我预言，当一大群只戴宽边帽的吟游诗人组成公会时，宽边帽会变得非常流行。";
			next;
			mes "[Psychic Advisor]";
			mes "还是羽毛帽会人气暴涨？这两种帽子都太时髦了，尤其适合吟游诗人……";
			next;
		}
		mes "[Psychic Advisor]";
		mes "嗯……";
		mes "我们灵媒顾问并没有接受时尚方面的训练，但希望至少对你有一点帮助。";
		close;
	}
}
// 保持翻译切片物理行数

geffen_in,109,72,2	script	Monster Scholar	90,{
	mes "[埃丝特斯]";
	mes "你好，我是吉芬的怪物学专家。有什么特别想了解的吗？";
	next;
	switch(select("附近的怪物:最新怪物新闻:怪物时代:魔物果冻理论")) {
	case 1:
		mes "[埃丝特斯]";
		mes "如你所知，由于巫师和魔法师在吉芬训练，怪物通常会远离城市。因此疲惫的冒险者可以在这里休息。";
		next;
		mes "[埃丝特斯]";
		mes "不过，如果你想寻找强大的怪物，可以过西边的桥去对付狗头人。";
		next;
		mes "[埃丝特斯]";
		if (BaseLevel > 40)
			mes "你看起来足以应对那种挑战。但如果看到更鲁莽的人过西桥，最好提醒他们。";
		else
			mes "嗯，不过如果你打算去那里，最好不要独自前往。要对付那种怪物，一定要做好充分准备。";
		break;
	case 2:
		mes "[埃丝特斯]";
		mes "最新新闻？";
		mes "朱诺怪物博物馆现在对公众开放了。那里有迷人的展览，各种怪物都在展示！";
		next;
		mes "[埃丝特斯]";
		mes "我在普隆德拉和朱诺图书馆读过各种怪物的资料，也在野外遇到过一些，但现在终于有机会亲眼看到强大的怪物了！";
		next;
		mes "[埃丝特斯]";
		mes "令人兴奋的是，你们这些冒险者为卢恩·米德加尔兹王国完成了探索。";
		next;
		mes "[埃丝特斯]";
		mes "发现新土地时，通常会有该地区特有的独特怪物。";
		next;
		mes "[埃丝特斯]";
		mes "所以新怪物一直在被发现！在世界各地漫游的生物种类实在令人着迷。";
		break;
	case 3:
		mes "[埃丝特斯]";
		mes "事实上，怪物自古以来就存在。怪物时代是怪物力量达到顶峰的时期。";
		next;
		mes "[埃丝特斯]";
		mes "它们长期困扰人类，但在一场人类与怪物的大战中被彻底消灭。";
		next;
		mes "[埃丝特斯]";
		mes "然而，随着自然平衡改变，怪物不可避免地回来了。很少有人知道，大多数怪物曾经都是温顺的生物。真令人难过……";
		break;
	case 4:
		mes "[埃丝特斯]";
		mes "啊，对了，魔物果冻。";
		mes "似乎几乎所有怪物都由魔物果冻组成。但它只是某些怪物制造的结晶，还是……有更多秘密？";
		next;
		mes "[埃丝特斯]";
		mes "根据对古代怪物和最近发现的怪物的研究，较强的野兽身上似乎找不到魔物果冻的痕迹。";
		next;
		mes "[埃丝特斯]";
		mes "不过我们许多人相信魔物果冻与怪物之间可能存在联系，尽管这很难令人相信。";
		next;
		mes "[埃丝特斯]";
		mes "魔物果冻可能与怪物的性格和力量有关。因此，如果把魔物果冻与某物混合，也许能制造更强的怪物。";
		next;
		mes "[埃丝特斯]";
		mes "当然，那种实验很危险。你可能会把真正可怕的怪物释放到世界上……";
		break;
	}
	close;
}
// 保持翻译切片物理行数

// Lvl 4 weapon quest related NPC ------------------------------------------------------

geffen,203,146,5	script	Citizen	97,{
	mes "[居民]";
	mes "艾尔德巴兰有一位技艺高超的武器工匠，";
	mes "他有四个儿子。";
	mes "遗憾的是，他在开发强力武器时失去了所有儿子。";
	mes "父亲独自从悲剧中幸存下来。";
	next;
	mes "[居民]";
	mes "那位父亲一定非常悲伤……";
	mes "因为这件事，武器工匠";
	mes "退休并躲到了某处。";
	mes "从那以后，再也没人见过";
	mes "他和儿子们开发的强力武器。";
	next;
	mes "[居民]";
	mes "我不认为他的四个儿子";
	mes "会带着遗憾前往天堂。";
	close;
}

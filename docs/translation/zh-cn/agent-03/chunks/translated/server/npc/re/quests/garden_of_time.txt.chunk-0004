	case 3:
		item_enchant(121);
		break;
	case 4:
		item_enchant(123);
		break;
	}
	end;

OnInit:
	setunittitle( getnpcid(0), "<Divine Cloak Enchantment>" );
	end;
}

t_garden,138,114,2	script(CLOAKED)	Subspace vending machine#4	HEROS_IN_ORB_4,{
	if (isbegin_quest(12620) != 2)
		end;
	if (checkweight(1201,1) == 0) {
		mes "由于携带的物品种类或重量过多，我无法与屏障交流。";
		close;
	}
	npctalk "我们努力为流通装备附魔。你想选择哪个菜单？", "", bc_self;
	switch( select( "生命之环饰品", "生命之环-春", "生命之环-夏", "生命之环-秋", "生命之环-冬" ) ) {

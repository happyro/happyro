}

dewata,204,230,6	script	Dieting Lady#dew	537,{
	if (countitem(11533) == 0) {
		mes "[Dieting Lady]";
		mes "啊～我快饿死了！！";
		mes "我现在应该节食。";
		mes "为什么还是这么饿？";
		next;
		mes "[Dieting Lady]";
		mes "别跟我说太多话！！";
		mes "我好想尝尝烤^006400沙嗲^000000";
		mes "啊～！！！！！";
		close;
	}
	mes "[Dieting Lady]";
	mes "那份让人垂涎的";
	mes "^006400沙嗲^000000是给我的吗？";
	next;
	switch(select("是，想尝尝吗？:不，这是我的！")) {
	case 1:
		delitem 11533,1; //Satay
		mes "[Dieting Lady]";
		mes "太感谢了！";
		mes "我一直饿得慌～！！";
		mes "这份^006400沙嗲^000000的香味";
		mes "真棒～！";
		next;
		getitem 11533,1; //Satay
		mes "[Dieting Lady]";
		mes "啊……得清醒过来，";
		mes "好东西吃太多也不好……";
		mes "我应该坚持节食。";
		mes "抱歉，我把它还给你。";
		emotion ET_CRY;
		close;
	case 2:
		mes "[Dieting Lady]";
		mes "啊……你真贪心！";
		mes "既然你不愿分享。";
		mes "总之，我不该为了";
		mes "看起来闻起来都这么香的东西破戒……";
		emotion ET_HNG;
		close;
	}
}


pay_arche,122,100,0	script	Dollshoi	88,{
	mes "[魔法师公会成员]";
	mes "你想要药剂？嗯，给我 50 Zeny 和至少 1 个空试管。";
	next;
	if (select("好，成交。:算了，忘了吧。") == 1) {
		mes "[魔法师公会成员]";
		if (Zeny < 50) {
			mes "嘿！你的钱不够支付我收取的 50 Zeny。";
			close;
		}
		if (countitem(1092) == 0) {
			mes "没有瓶子就无法携带药剂！带一个空试管给我。";
			close;
		}
		delitem 1092,1; //Empty_Cylinder
		set Zeny, Zeny-50;
		getitem 1089,1; //Payon_Potion
	}
	close;
}

moc_ruins,91,150,0	script	Ponka-Hontas	93,{
	mes "[魔法师公会成员]";
	mes "想要药剂吗？请给我 50 Zeny 和至少 1 个空试管。";
	next;
	if (select("好，成交。:算了，忘了吧。") == 1) {
		mes "[魔法师公会成员]";
		if (Zeny < 50) {
			mes "抱歉，你的钱不够支付 50 Zeny 的费用。";
			close;
		}
		if (countitem(1092) == 0) {
			mes "没有瓶子就无法携带液体。下次见到我时带一个空试管来。";
			close;
		}
		delitem 1092,1; //Empty_Cylinder
		set Zeny, Zeny-50;
		getitem 1088,1; //Morocc_Potion
	}
	close;
}

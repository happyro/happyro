// Head Pharmacist
paramk,100,30,3	script	Head Pharmacist#ptn01	4_F_SCIENCE,{
	if ($event_paramk > 0) {
		mes "[Head Pharmacist]";
		mes "一口就能让你昏倒的强效毒药、保护身体和精神的药剂，以及暂时赋予超自然速度的药剂。";
		mes "我们应有尽有。";
		mes "'Meds for Pharmacists', here to supply you with the medication you need.";
		next;
		if (select("请给我药剂！:取消。") == 1) {
			mes "[Head Pharmacist]";
			mes "这是我们目前剩下的商品。";
			mes "如果什么都没有，就说明已经售罄。";
			mes "我们不会大量调制药水。请理解。";
			close2;
			callshop "para_ptn00";
			end;
		}
		mes "[Head Pharmacist]";
		mes "对药剂有疑问的话再来找我。";
		close;
	} else { // holiday
		mes "[Head Pharmacist]";
		mes "哦，你需要药水？";
		mes "我们不卖普通药剂，只出售特殊药水。";
		mes "而且今天是休息日。我们正在调制新的药水。";
		next;
		mes "[Head Pharmacist]";
		mes "明天再来，我给你看看我们优秀的药水收藏，好吗？";
		mes "嘿嘿～";
		close;
	}
}

// Johanna
paramk,106,32,3	script	Johanna#ptn02	4_M_BRZ_JACI,{
	mes "[Johanna]";
	mes "欢迎来到“药剂师的药品”。";
	mes "你需要什么？";
	next;
	switch (select("查看物品。:出售物品。:营业日。:取消。")) {
	case 1:
		mes "[Johanna]";
		mes "这里有治疗药水。";
		mes "以实惠价格出售优质药水。";
		close2;
		callshop "para_ptn01",1;
		end;
	case 2:
		mes "[Johanna]";
		mes "我会收下它们并支付高价。";
		mes "别告诉别人我付了这么多。";
		close2;
		callshop "para_ptn01",2;
		end;
	case 3:
		mes "[Johanna]";
		mes "伊甸园市场集团的大多数商店在休息日不营业。";
		mes "不过有些商店在休息日仍会营业。";
		next;
		mes "[Johanna]";
		mes "我们的药房即使在休息日也出售普通治疗药水，但不出售特殊药水。";
		mes "请好好利用我们的服务！";
		close;
	case 4:
		mes "[Johanna]";
		mes "再见。";
		close;
	}
}

// Wyn, independent contractor || Name is too long
paramk,106,27,3	script	Brewer Wyn#ptn03	4_M_ALCHE_A,{
	if ($event_paramk > 0) {
		mes "[Wyn]";
		mes "..Hello...";
		mes "这里是“药剂师的药品”……";
		mes "你需要蓝色药水吗……？";
		mes "我每天制作 100 个……是的……只有我一个人。";
		next;
		if (select("查看物品。:取消。") == 1) {
			mes "[Wyn]";
			mes "呃……不确定还剩多少。";
			mes "请稍等。如果没有，就卖光了……";
			mes "啊啊啊……我还得继续做吗。";
			mes "啊啊……草药的臭味";
			mes "感觉要吐了……啊啊……";
			close2;
			callshop "para_ptn10";
			end;
		}
		mes "[Wyn]";
		mes "谢谢……欢迎再来。";
		close;
	} else { // holiday
		mes "[Wyn]";
		mes "呃……头疼……";
		mes "我开始工作是为了偿还大学学费……";
		mes "我感觉要吐了。整周都被草药味包围。";
		mes "呕——！";
		close;
	}
}



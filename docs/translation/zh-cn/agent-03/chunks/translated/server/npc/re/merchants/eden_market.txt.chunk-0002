
// Leria
paramk,74,15,0	script	Leria#coin	4_M_BIBI,{
	if ($event_paramk > 0) {
		mes "[Leria]";
		mes "我出售从异次元收集来的硬币。";
		mes "看到喜欢的就买吧。";
		mes "先提醒你，它们价格不菲。为了取得这些东西，我费了很大功夫。";
		next;
		if (select("看看有什么在卖。:取消。") == 1) {
			mes "[Leria]";
			mes "我只卖少量物品，库存可能已经没了。";
			close2;
			callshop "para_coin10";
			end;
		}
		mes "[Leria]";
		mes "因为我必须走遍世界寻找商品，所以价格很高……";
		mes "但还是有人愿意购买。";
		next;
		mes "[Leria]";
		mes "需要它们的人就得付出代价。不是吗？";
		close;
	} else { // holiday
		mes "[Leria]";
		mes "啊……今天是市场休息日。";
		mes "需要硬币的话明天再来。";
		close;
	}
}

// Heimhunter
paramk,71,15,3	script	Heimhunter#hei	4_GEFFEN_11,{
	if ($event_paramk > 0) {
		mes "[Heimhunter]";
		mes "啊，你就是想要古堡里“那个”的客人吗？";
		mes "我每天只能拿到一个，但会卖给你。";
		next;
		if (select("看看物品。:取消。") == 1) {
			mes "[Heimhunter]";
			mes "只有一个……";
			mes "可能已经被别人买走了。";
			mes "请理解。";
			close2;
			callshop "para_hei10";
			end;
		}
		mes "[Heimhunter]";
		mes "如你所愿。";
		close;
	} else { // holiday
		mes "[Heimhunter]";
		mes "今天是市场的正式休息日。";
		mes "我也要休息。";
		close;
	}
}

// Zephet
paramk,68,15,0	script	Zephet#key	4_M_HUMERCHANT,{
	if ($event_paramk > 3) {
		mes "[Zephet]";
		mes "你需要钥匙吗？";
		mes "我可能有一些钟楼的备用钥匙……";
		next;
		if (select("购买钥匙。:取消。") == 1) {
			mes "[Zephet]";
			mes "钟楼的钥匙都是我自己收集并出售的……";
			mes "即使我整周都在搜寻，能找到的也不多。";
			mes "可能已经卖光了。";
			close2;
			callshop "para_key10";
			end;
		}
		mes "[Zephet]";
		mes "你不需要钥匙吗？";
		mes "记住，我这里只在周末出售钥匙。";
		mes "告诉你一声。";
		close;
	} else { // holiday
		mes "[Zephet]";
		mes "我还没有足够的钥匙。";
		mes "周六下午以后再来。";
		close;
	}
}


// Strong Friends - Weapon shop

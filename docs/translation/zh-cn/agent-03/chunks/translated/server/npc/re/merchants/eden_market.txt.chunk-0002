// Minho Doh
paramk,90,31,3	script	Minho Doh#cst01	4W_M_01,{
	if ($event_paramk > 2) {
		mes "[Minho Doh]";
		mes "限量商品收藏，仅在周末供应！";
		mes "每天只有一件。想要的话快买！你懂的。";
		next;
		if (select("查看收藏。:取消。") == 1) {
			mes "[Minho Doh]";
			mes "这是我们的特别收藏！";
			mes "如果所有箱子都是空的，就说明你来晚了！";
			close2;
			callshop "para_arm10";
			end;
		}
		mes "[Minho Doh]";
		mes "下次再见！";
		mes "哈哈哈哈哈！";
		close;
	} else { // holiday
		mes "[Minho Doh]";
		mes "你想看看我们的特别收藏吗？";
		mes "但如果每天都能看到，收藏就不特别了，对吧？";
		next;
		mes "[Minho Doh]";
		mes "想看特别收藏就周末来吧。";
		mes "我们在^000000周六和周日^000000每天出售一件商品。";
		next;
		mes "[Minho Doh]";
		mes "哈哈哈……你不期待即将揭晓的特别商品吗？呜哈哈哈哈！";
		close;
	}
}

// Lapelt
paramk,94,32,3	script	Lapelt#hat01	4_M_LGTMAN,{
	mes "[Lapelt]";
	mes "欢迎！这里是“帅气伙伴”，让你变得时尚的服装店！";
	mes "即使节假日，我们也出售普通服装和帽子。";
	next;

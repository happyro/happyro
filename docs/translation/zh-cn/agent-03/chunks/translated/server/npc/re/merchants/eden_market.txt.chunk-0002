	case 2:
		mes "[Lapelt]";
		mes "时尚来自配饰搭配！";
		mes "搭配合适的物品和漂亮的帽子，你就能站在时尚顶端！";
		close2;
		callshop "para_hat02",1;
		end;
	case 3:
		mes "[Lapelt]";
		mes "再见。";
		close;
	}
}



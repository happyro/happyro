// Coco
paramk,78,31,3	script	Coco#arm01	4_F_SITDOWN,{
	mes "[Coco]";
	mes "你需要坚固的铠甲保护脆弱的身体吗？";
	mes "或者需要盾牌抵挡敌人的攻击？";
	next;
	switch (select("看看铠甲。:看看盾牌。:取消。")) {
	case 1:
		mes "[Coco]";
		mes "便宜又坚固的铠甲。";
		close2;
		callshop "para_arm01",1;
		end;
	case 2:
		mes "[Coco]";
		mes "也许能，也许不能挡住有力的攻击……";
		close2;
		callshop "para_arm02",1;
		end;
	case 3:
		mes "[Coco]";
		mes "欢迎下次再来。";
		close;
	}
}



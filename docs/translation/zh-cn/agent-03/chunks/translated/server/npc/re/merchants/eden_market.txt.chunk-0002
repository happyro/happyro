// Whiteberry
paramk,126,34,3	script	Whiteberry#seed01	4_CAT_SAILOR1,{
	if ($event_paramk > 0) {
		mes "[Whiteberry]";
		mes "喵～欢迎。";
		mes "猫爪商团很高兴欢迎你。我们出售来自马兰岛的特殊商品，喵～";
	} else { // holiday
		mes "[Whiteberry]";
		mes "我们出售玛丝黛拉果实～";
		mes "即使休息日我们也出售部分商品～";
	}
	next;
	switch (select("查看物品。:出售物品。:取消。")) {
	case 1:
		mes "[Whiteberry]";
		mes "新鲜的玛丝黛拉果实，喵～";
		mes "请多买一些。";
		mes "虽然是我们自己种的，但说实话太酸了……啊……没事。";
		close2;
		callshop "para_seed01",1;
		end;
	case 2:
		mes "[Whiteberry]";
		mes "喵～会以合理价格收购。";
		mes "请出售有用的物品。";
		close2;
		callshop "para_seed01",2;
		end;
	case 3:
		mes "[Whiteberry]";
		mes "喵～再见～";

// Miffy
paramk,65,30,3	script	Miffy#wp01	4_F_LGTGIRL,{
	if ($event_paramk > 1) {
		mes "[Miffy]";
		mes "限量收藏，仅在热烈的周五、周六和周日供应！";
		mes "我们提供冒险者从地下城带回的各种古代武器！";
		next;
		if (select("看看物品。:取消。") == 1) {
			mes "[Miffy]";
			mes "让我给你看看“强力伙伴”的特别收藏。";
			mes "如果你打开箱子却发现里面什么都没有，";
			mes "就说明武器已经卖掉了。";
			mes "战利品属于反应迅速的人。";
			close2;
			callshop "para_wp00";
			end;
		}
		mes "[Miffy]";
		mes "特别武器仅在周末出售！";
		mes "随时欢迎来找我们！";
		close;
	} else { // Wednesday Holiday
		mes "[Miffy]";
		mes "你好。这里是“强力伙伴”武器店。";
		mes "我们出售冒险者从地下城和战斗中带回的武器，";
		mes "这些武器来自大陆各处。";
		next;
		mes "[Miffy]";
		mes "^000000周五、周六、周日，连续 3 天限量供应武器收藏！^000000";
		mes "随时欢迎来找我们！";
		close;
	}
}

// Nelsha
paramk,70,31,3	script	Nelsha#wp02	4_M_SITDOWN,{
	mes "[Nelsha]";
	mes "你好。";
	mes "这里是“强力伙伴”，可以查看各种基础武器。";
	next;
	setarray .@shopname$[0], "para_wp01", "para_wp02", "para_wp03", "para_wp04", "para_wp05";
	setarray .@shopdesc$[0], "Maces, Rods and Knuckles", "One-Handed Swords and Two-Handed Sword", "Bows, Innstruments and Whips", "Daggers and Katars", "Axes and Spears";
	.@s = select("钝器、杖、拳套:单手剑、双手剑:弓、乐器、鞭:短剑、拳刃:斧、矛:取消") - 1;
	if (.@s == 5) {
		mes "[Nelsha]";
		mes "感谢惠顾。";
		close;
	}
	mes "[Nelsha]";
	mes "我来给你看" + .@shopdesc$[.@s];
	close2;
	callshop(.@shopname$[.@s], 1);
	end;
}



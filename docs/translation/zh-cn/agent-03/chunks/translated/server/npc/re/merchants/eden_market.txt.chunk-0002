// Is-this-your-lucky-day Napeed#itm01
paramk,114,30,3	script	Lucky Day Napeed#itm01	4_F_03,{
	if ($event_paramk > 0) {
		mes "[Napeed]";
		mes "感谢你在周末促销期间光临。";
		mes "100 个随机物品包，仅在周末出售！限量 100 个！";
		mes "你有什么想要的吗？";
		next;
		if (select("查看物品。:取消。")) {
			mes "[Napeed]";
			mes "热门商品有“饰品箱”“礼物包装的面具”“破旧专辑”“带回故乡的礼物”……";
			mes "如果什么都没看到，就说明售罄了。下个周末再来～";
			close2;
			callshop "para_itm00";
			end;
		}
		mes "[Napeed]";
		mes "感谢你经常光顾“应有尽有”！";
		close;
	} else { // holiday
		mes "[Napeed]";
		mes "欢迎，欢迎～！这里是“应有尽有”。有的我们都有，没有的我们确实没有！";
		mes "我们目前不营业。";
		mes "今天是休息日，所以我们正在调制药水。";
		close;
	}
}

// Parayo
paramk,118,31,3	script	Manager Parayo#itm02	4_F_KHELLISIA,{
	if ($event_paramk > 0) {
		mes "[Parayo]";
		mes "感谢你来到“应有尽有”。";
		mes "我们出售各种属性箭袋和陷阱。";
		mes "你想要什么吗？";
		next;
		switch (select("查看属性箭袋。:查看陷阱。:取消。")) {
		case 1:
			mes "[Parayo]";
			mes "我们会尽量备足库存，以服务更多顾客";
			mes "但很遗憾，有时还是会售罄。";
			close2;
			callshop "para_itm10";
			end;
		case 2:
			mes "[Parayo]";
			mes "这里是陷阱。";
			mes "'We-Have-Everything' is always here for you.";
			close2;
			callshop "para_itm01",1;
			end;
		case 3:
			mes "[Parayo]";
			mes "感谢你一直光顾“应有尽有”。";
			mes "欢迎下次再来。";
			close;
		}
	} else { // holiday
		mes "[Parayo]";
		mes "你好，这里是“应有尽有”。";
		mes "周三是伊甸园市场集团的正式休息日，所以这段时间不营业。";
		mes "再见。";
		close;
	}
}



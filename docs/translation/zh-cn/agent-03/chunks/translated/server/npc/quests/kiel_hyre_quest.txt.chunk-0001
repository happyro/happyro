//----------------------------------------------------------------------------
// Juno Pub Master/Starting point.
//----------------------------------------------------------------------------
yuno_in01,35,179,4	script	Pub Master#kh	46,5,5,{
	if (checkweight(7487,1) == 0) {
		mes "[范特]";
		mes "等一下！你现在";
		mes "携带的物品太多，";
		mes "最好把物品放进";
		mes "卡普拉仓库，否则";
		mes "就无法领取新的物品。";
		mes "领取新物品……";
		close;
	}
	if (KielHyreQuest == 0) {
		mes "[范特]";
		mes "你好，欢迎来到我的酒馆。";
		mes "你想";
		mes "喝点什么？";
		next;
		switch(select("请给我啤酒。","请给我鸡尾酒。","请给我烧酒。","以后再说。")) {
		case 1:
			mes "[范特]";
			mes "好的，我给你倒一杯";
			mes "生啤酒。给你，这是";
			mes "我们特别的";
			mes "施瓦尔茨啤酒。";
			next;
			mes "^3355FF*咕咚咕咚*^000000";
			percentheal 5,-5;
			next;
			mes "["+strcharinfo(0)+"]";
			mes "啊，真的";
			mes "很好！正好";
			mes "解渴！";
			close;
		case 2:
			mes "[范特]";
			mes "抱歉，但我必须把";
			mes "所有鸡尾酒材料送给其他客人。";
			mes "";
			mes "下次也许有足够材料给你";
			mes "做点什么，好吗？";
			close;
		case 3:
			mes "[范特]";
			mes "烧、烧酒？抱歉，";
			mes "但这里不供应。那是";
			mes "太硬派的饮料，";
			mes "我喝不了……";
			close;
		case 4:
			mes "[范特]";
			mes "当然，慢慢来，";
			mes "放松，准备好后";
			mes "再点";
			mes "东西。";
			close;
		}
	}
	if (KielHyreQuest == 1) {
		mes "[范特]";
		mes "你好，欢迎来到我的酒馆。";
		mes "你想";
		mes "喝点什么？";
		next;
		switch(select("请给我啤酒。:请给我鸡尾酒。:请给我烧酒。:你看起来很担心，怎么了？:取消")) {
		case 1:
			mes "[范特]";
			mes "好的，我给你倒一杯";
			mes "生啤酒。给你，这是";
			mes "我们特别的";
			mes "施瓦尔茨啤酒。";
			next;
			mes "^3355FF*咕咚咕咚*^000000";
			percentheal 5,-5;
			next;
			mes "["+strcharinfo(0)+"]";
			mes "啊，真的";
			mes "很好！正好";
			mes "解渴！";
			close;
		case 2:
			mes "[范特]";
			mes "抱歉，但我必须把";
			mes "所有鸡尾酒材料送给其他客人。";
			mes "";
			mes "下次也许有足够材料给你";
			mes "做点什么，好吗？";
			close;
		case 3:
			mes "[范特]";
			mes "烧、烧酒？抱歉，";
			mes "但这里不供应。那是";
			mes "太硬派的饮料，";
			mes "我喝不了……";
			close;
		case 4:
			mes "[范特]";
			mes "哦，你听到了吗？";
			mes "抱歉，只是我的一个";
			mes "员工出了事故，";
			mes "受了重伤，";
			mes "所以现在没有人能";
			mes "运送这批货。";
			next;
			mes "[范特]";
			mes "我有一份紧急订单";
			mes "要送到";
			mes "基尔·海勒学院，";
			mes "但找不到人";
			mes "能做这份";
			mes "临时工作。";
			next;
			switch(select("听到这个我很遗憾:你想让我帮忙吗？")) {
			case 1:
				mes "[范特]";
				mes "我相信我能想办法。";
				mes "";
				mes "你认识";
				mes "对兼职工作感兴趣的人吗？";
				mes "";
				close;
			case 2:
				mes "[范特]";
				mes "真的吗？太好了！";
				mes "但首先，我得说明";
				mes "这工作可能没你想的那么简单。";
				mes "";
				mes "我希望你无论如何都完成";
				mes "配送。";
				next;
				switch(select("好的，我来做:等等，让我考虑一下……")) {
				case 1:
					mes "[范特]";
					mes "很高兴听到你这么说。";
					mes "那么请把这瓶";
					mes "料理酒带给";
					mes "基尔·海勒学院的^ff0000莱科兰夫人^000000。";
					mes "完成后我会付钱给你，";
					mes "好吗？";
					getitem 7487,1; //Tavern_Wine
					set KielHyreQuest,2;
					close;
				case 2:
					mes "[范特]";
					mes "当然。我急着完成这件事，所以如果你不能做，但知道";
					mes "有能力且负责的人，";
					mes "请把我的情况告诉他们。";
					mes "";
					mes "";
					mes "";
					close;
				}
			}
		case 5:
			mes "[范特]";
			mes "当然，慢慢来，";
			mes "放松，准备好后";
			mes "再点";
			mes "东西。";
			close;
		}
	}
	else if ((KielHyreQuest >= 2) && (KielHyreQuest < 6)) {
		mes "[范特]";
		mes "请把我给你的那瓶酒";
		mes "交给";
		mes "^ff0000莱科兰夫人^000000，她应该在";
		mes "基尔·海勒学院内。";
		mes "快在她抱怨之前把酒送到。";
		mes "她抱怨配送之前。";
		close;
	}
	else if (KielHyreQuest == 6) {
		if (countitem(7487) == 0) {
			mes "[范特]";
			mes "哦，你回来了。";
			mes "感谢你完成那次";
			mes "配送。给我";
			mes "一点时间，我就能";
			mes "用Zeny付款，好吗？";
			next;
			select("我还需要更多酒……");
			mes "[范特]";
			mes "哦，你还要配送";
			mes "还要一瓶？好吧，";
			mes "让我找找看，";
			mes "我会给你酒和";
			mes "报酬。";
			next;
			mes "^3355FFRummage Rummage^000000";
			mes "^3355FFRummage Rummage^000000";
			next;
			mes "[范特]";
			mes "给你！";
			mes "非常感谢";
			mes "谢谢你帮忙～";
			getitem 7487,1; //Tavern_Wine
			set Zeny, Zeny+1000;
			close;
		}
		else {
			mes "[范特]";
			mes "嘿，非常感谢你";
			mes "谢谢你上次帮忙。";
			mes "我知道我当时拜托你";
			mes "虽然我突然拜托你，";
			mes "但你最终成了救命";
			mes "真是救了命！我非常感谢你！";
			close;
		}
	}
	else {
		mes "[范特]";
		mes "你真是个很好的";
		mes "你知道吗？";
		mes "可靠、负责任，";
		mes "愿意帮助别人，";
		mes "还很主动！我觉得你";
		mes "孩子，你将来一定会有出息，我说真的～";
		close;
	}

OnTouch:
	if (KielHyreQuest < 1) {
		mes "[范特]";
		mes "Arrrggghhh...";
		mes "这可不妙……";
		mes "一点也不好！";
		mes "我该怎么办？";
		set KielHyreQuest,1;
		close;
	} 
}

//----------------------------------------------------------------------------
// Juno Toast Sales Girl.
//----------------------------------------------------------------------------
yuno,217,114,6	script	Little Kid#kh	96,{
	mes "[塞祖]"; 
	if (KielHyreQuest < 6) {
		mes "新鲜酥脆的烤面包！";
		mes "想吃的话就来";
		mes "买烤面包吧~";
		close;
	}
	else if (KielHyreQuest == 6) {
		if (KHToastGirlEnd < 1) {
			mes "新鲜酥脆的烤面包！";
			mes "想吃的话就来";
			mes "买烤面包吧~";
			mes "哦！你好~想买";
			mes "好吃的烤面包吗？";
			next;
			switch(select("我是来找艾莉的:不用了，谢谢")) {
			case 1:
				mes "[塞祖]"; 
				mes "哦，我明白了。艾莉一定又";
				mes "浪费了一批";
				mes "材料。她是常客，";
				mes "我很想帮她，但";
				mes "";
				mes "我也没办法。";
				next;
				mes "[塞祖]"; 
				mes "你看，我的材料也";
				mes "用完了！";
				mes "但我不能离开这里";
				mes "去取材料。要是有人";
				mes "想买烤面包怎么办？";
				mes "听着，你能帮我吗？";
				next;
				mes "[塞祖]"; 
				mes "请去";
				mes "帮我拿些面粉和鸡蛋，";
				mes "从^3355FF莱塔尔榨油厂^000000回来。";
				mes "你回来后，我就能";
				mes "分配材料，你也可以";
				mes "带一些给艾莉。";
				next;
				mes "[塞祖]"; 
				mes "我知道这基本上是";

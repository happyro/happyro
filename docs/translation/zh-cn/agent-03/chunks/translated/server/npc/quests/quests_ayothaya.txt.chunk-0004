ayo_fild01,129,197,0	script	Puraim#thai1	842,{
	if ((ayodunquest > 2 && countitem(7285) > 0) || (ayodunquest > 2 && countitem(7287) > 0)) {
		mes "[Puraim]";
		mes "咦……？";
		mes "我感觉到了！";
		mes "我能感受到";
		mes "神圣的力量！";
		mes "它来自你！";
		next;
		mes "[Puraim]";
		mes "我想你可以继续";
		mes "进入遗迹了。那么你想做的";
		mes "就是探索";
		mes "这个区域吗？";
		next;
		mes "[Puraim]";
		mes "我建议你";
		mes "不要进去。";
		mes "就连当地人";
		mes "也害怕这个地方。";
		next;
		mes "[Puraim]";
		mes "即使没有沙明虎，这里仍有许多恶灵。即使有神圣线团，这里也依然危险。";
		next;
		mes "[Puraim]";
		mes "那么你想做什么？";
		mes "冒险者，你还想";
		mes "探索这个区域吗？";
		next;
		if (select("是。:不！我现在太害怕遗迹了。") == 1) {
			mes "[Puraim]";
			mes "嗯……";
			mes "看来你们冒险者都被危险的刺激吸引，";
			mes "或者都有寻死的念头。";
			next;
			mes "[Puraim]";
			mes "算了，这不关我的事。毕竟你已经";
			mes "拥有神圣力量。不过还是小心点。你可能不该去遗迹地下第二层。";
			next;
			mes "[Puraim]";
			mes "正如你们米德加尔特人";
			mes "所说，‘好奇心害死猫。’";
			mes "总之，去吧！";
			next;
			mes "^3355FFHe shoved you off the hill";
			mes "然后像石头一样坠落。^000000";
			close2;
			percentheal -10,0;
			warp "ayo_fild02",30,135;
			end;
		}
		mes "[Puraim]";
		mes "明智的决定！";
		mes "正如我所料，你足够聪明，";
		mes "不会愚蠢地";
		mes "拿生命冒险。";
		close;
	}
	mes "[Puraim]";
	mes "如果我是你，";
	mes "连靠近";
	mes "那边的遗迹都不敢。";
	next;
	mes "[Puraim]";
	mes "没有神圣力量保护的人，会成为那里邪恶生物的猎物。你会在";
	mes "转眼间被杀死！";
	next;
	mes "[Puraim]";
	mes "回去吧，冒险者。";
	mes "如果你想探索";
	mes "这个区域，最好";
	mes "让我看看你的神圣力量。";
	close;
}


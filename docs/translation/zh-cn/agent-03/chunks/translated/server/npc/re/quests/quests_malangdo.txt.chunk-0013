	mes "请收下这份小礼物。";
	next;
	mes "[Nyangson]";
	mes "经历Meow冒险队的所有困难后，你就能得到它。";
	mes "我们也不确定这台机器会不会再次尝试爆炸，所以请明天再来。";
	if (nyadven == 7) {
		set nyadven,9;
		erasequest 7247;
	}
	delitem 6429,1; //Bravery_Card_B
	setquest 7249;
	getitem 6422,3; //Egrade_Coin
	getexp 20000,20000;
	next;
	if (nyadven == 9) {

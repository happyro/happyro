				mes "他需要冒险卡才能停下它。";
				mes "那么，你想试试吗？";
				next;
				switch(select("购买冒险卡B。:不买。")) {
				case 1:
					if (countitem(12636) == 0) {
						mes "[Homnya]";
						mes "一张冒险卡需要多少个Malangdo罐头？";
						next;
						mes "[Nyangson]";
						mes "只要一个，亲爱的。";
						mes "喵~";
						close2;
						break;
					}
					mes "[Homnya]";
					mes "是的，请试着别把它炸掉。";
					mes "快点解决！";
					next;
					mes "[Nyangson]";
					mes "拜托了。";
					delitem 12636,1; //Malang_Sp_Can
					getitem 6429,1; //Bravery_Card_B
					close2;
					break;
				case 2:
					cutin "mal_homnya_s",2;
					mes "[Homnya]";
					mes "啊……嘿……你不能这样！";
					mes "嘿，别走！";
					mes "Nyangson，请停下来！";
					next;
					mes "[Nyangson]";
					mes "这台和那台都太吵了！";
					mes "拜托！";
					next;
					mes "两只小猫都出了很多汗。";
					close2;
					break;
				}
			}
			break;
		case 2:
			cutin "mal_homnya_s",2;
			mes "[Homnya]";
			mes "啊……嘿……你不能这样！";
			mes "嘿，别走！";
			mes "Nyangson，请停下来！";
			next;
			mes "[Nyangson]";
			mes "这台和那台都太吵了！";
			mes "拜托！";
			next;
			mes "两只小猫都出了很多汗。";
			close2;
			break;
		}
	}
	cutin "",255;
	end;
}


		next;
		mes "[Jindou]";
		mes "带回 5 根荆棘藤蔓的枝条。";
		next;
		mes "[Jindou]";
		mes "你回来后我们继续。";
		close2;
		warp "lasagna",218,185;
		end;
	}
	if (lasagna_quest[1] == 7) {
		mes "[Jindou]";
		mes "多么漂亮的荆棘。";
		mes "如果我对荆棘这样做……";
		next;
		mes "[Jindou]";
		mes "没错。用这个的话，他很快就会忍不住开口！";
		close;
	}
}


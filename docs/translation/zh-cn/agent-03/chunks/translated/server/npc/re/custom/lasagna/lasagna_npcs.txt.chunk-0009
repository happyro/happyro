			mes "从这里出发，只有 Con-Chliina 能抵达米德加尔特。因此只有 Con-Chliina 的水手和治安队成员可以登船。";
			next;
			mes "[Vigilante Olio]";
			mes "因此其他城镇的人也纷纷前来加入治安队，我们只好把拉维奥利平原南部的哨所改成等候区。";
			next;
			select("询问加入治安队的事。");
			mes "[Vigilante Olio]";
			mes "嗯？";
			mes "你也感兴趣？";
			next;
			mes "[Vigilante Olio]";
			mes "这毫不奇怪！";
			mes "杜拉姆最不缺的就是好奇心！";
			next;
			mes "[Vigilante Olio]";
			mes "加入治安队需要队长许可，所以最好去问他。";
			getitem 22076,1;// Wooden Slippers [1]
			getexp 500,400;
		}
		else {
			mes "嗯？你不是来自米德加尔特吗？";
			mes "你到底是怎么来到这里的？";
			mes "不能原路回去吗？";
			next;
			select("询问登上 Con-Chliina 的事。");
			mes "[Vigilante Olio]";
			mes "嗯……";
			mes "我自己也不太清楚！";
			next;
			mes "[Vigilante Olio]";
			mes "米德加尔特的人能做什么……？";
			next;
			mes "[Vigilante Olio]";
			mes "先去和队长谈谈。";
		}
		erasequest 11436;// Vigilante Corp
		setquest 11437;// Vigilante Corp
		lasagna_quest[1] = 3;
		close;
	}
	if (lasagna_quest[1] == 3) {
		if (Class == Job_Summoner) {
			mes "[Vigilante Olio]";
			mes "加入治安队需要队长许可，所以最好去问他。";
			close;
		}
		mes "[Vigilante Olio]";
		mes "嗯……";
		mes "我自己也不太清楚！";
		next;
		mes "[Vigilante Olio]";
		mes "米德加尔特的人能做什么……？";
		next;
		mes "[Vigilante Olio]";
		mes "先去和队长谈谈。";
		close;
	}
	mes "[Vigilante Olio]";
	mes "哟！";
	mes "需要什么尽管说！";
	mes "我会尽力帮你！";
	close;
}

lasagna,235,198,3	script	Chief Peperoncino#lasa	4_DR_PEPE,{
	if (lasagna_quest[1] < 2) {
		mes "[Chief Peperoncino]";
		mes "很高兴见到你。";
		mes "我是治安队队长 Peperoncino。";
		next;
		if (lasagna_quest[1] == 0) {
			mes "[Chief Peperoncino]";
			mes "这不是什么大事……";
			mes "但城镇中央广场的治安队员有没有告诉你什么？";
			close;
		}
		mes "[Chief Peperoncino]";
		mes "你第一次来这里吗？";
		mes "随着新海路的发现，突然有大量外国人来访我们城镇……";
		next;
		mes "[Chief Peperoncino]";
		mes "嗯……";
		mes "总之，请享受在这里的时光，不要惹麻烦。";
		next;
		mes "[Chief Peperoncino]";
		mes "Olio！";
		next;
		mes "[Vigilante Olio]";
		mes "是，队长！！！";
		next;
		mes "[Chief Peperoncino]";
		mes "需要什么就和这里的 Olio 谈。";
		mes "我有紧急事务要处理，先告辞了。";
		mes "回头见。";
		completequest 11435;// Vigilante Corp
		setquest 11436;// Vigilante Corp
		lasagna_quest[1] = 2;
		close;
	}
	if (lasagna_quest[1] == 2) {
		mes "[Chief Peperoncino]";
		mes "需要什么就和这里的 Olio 谈。";
		mes "我有紧急事务要处理，先告辞了。";
		mes "回头见。";
		close;
	}
	if (lasagna_quest[1] == 3) {
		mes "[Chief Peperoncino]";
		mes "什么事？";
		next;
		select("询问加入治安队的事。");
		mes "[Chief Peperoncino]";
		mes "按现在的情况，想加入治安队并参加‘米德加尔特远征’，只需通过简单测试。";
		next;
		mes "[Chief Peperoncino]";
		mes "但我正忙于紧急事务，暂时没空给你测试，也许晚点再来……";
		next;
		mes "[Chief Peperoncino]";
		mes "嗯……";
		mes "不，等等！";
		next;
		mes "[Chief Peperoncino]";
		mes "请跟我来，这边走。";
		erasequest 11437;// Vigilante Corp
		setquest 11438;// Vigilante Corp
		lasagna_quest[1] = 4;
		close2;
		warp "lasa_in01",60,92;
		end;
	}
	if (lasagna_quest[1] >= 4 && lasagna_quest[1] < 8) {
		mes "[Chief Peperoncino]";
		mes "请往这边。";
		close2;
		warp "lasa_in01",60,92;
		end;
	}
	if (lasagna_quest[1] == 8) {
		mes "[Chief Peperoncino]";
		mes "虽然有 Jindou 插手，但没想到你这么轻松就通过了第一次测试……";
		next;
		mes "[Chief Peperoncino]";
		mes "我们马上进行下一项测试。";
		next;
		mes "[Chief Peperoncino]";
		mes "这次拉萨格纳西北端的 Tali 会帮助你。";
		mes "去见她吧。";
		erasequest 11442;
		setquest 11443;// Vigilante Corp
		lasagna_quest[1] = 9;
		close;
	}
	if (lasagna_quest[1] == 9) {
		mes "[Chief Peperoncino]";
		mes "虽然有 Jindou 插手，但没想到你这么轻松就通过了第一次测试……";
		next;
		mes "[Chief Peperoncino]";
		mes "我们马上进行下一项测试。";
		next;
		mes "[Chief Peperoncino]";
		mes "这次拉萨格纳西北端的 Tali 会帮助你。";
		mes "去见她吧。";
		close;
	}
	if (lasagna_quest[1] == 10) {
		mes "[Chief Peperoncino]";
		mes "这次拉萨格纳西北端的 Tali 会帮助你。";
		mes "去见她吧。";
		close;
	}
	if (lasagna_quest[1] == 11) {
		if (checkweight(1001,2) == 0) {
			mes "- Hold on a second here!! -";
			mes "- You have too many items. -";
			mes "- That means you can no longer receive any items. -";
			mes "- Free up some space -";
			mes "- and try again. -";
			close;
		}
		mes "[Chief Peperoncino]";
		mes "你回来了。";
		mes "对付她可不容易……干得好。";
		mes "Tali 还带来了这些，说剩下了很多布料。";
		next;
		mes "[Chief Peperoncino]";
		mes "好……测试到此结束。";
		mes "对于热衷冒险的年轻人，我不想太挑剔，这样就够了。";
		next;
		mes "[Chief Peperoncino]";
		mes "好，恭喜你成为治安队成员。";
		mes "新的冒险等着你去挑战。";
		next;
		mes "[Chief Peperoncino]";
		mes "拿着这张登船证去城镇北部的港口，他们会让你登船。";
		mes "现在赶快去港口吧。";
		next;
		mes "[Chief Peperoncino]";
		mes "呼……";
		mes "我年轻时也想成为伟大的人。";
		mes "但这里有太多必须守护的东西……";
		next;
		mes "[Chief Peperoncino]";
		mes "我晕船太严重，没法出海冒险。";
		completequest 11445;
		getitem 15151,1;// White Eco Shirt [1]
		getitem 25046,1;// Boarding Pass
		getexp 700,500;
		lasagna_quest[1] = 12;
		close;
	}
	if (lasagna_quest[1] >= 12) {
		mes "[Chief Peperoncino]";
		mes "呼……";
		mes "我年轻时也想成为伟大的人。";
		mes "但这里有太多必须守护的东西……";
		next;
		mes "[Chief Peperoncino]";
		mes "我晕船太严重，没法出海冒险。";
		close;
	}
}

lasa_in01,61,91,5	script	Basilisk Prisoner#lasai	4_BASIL_SLAVE,{
	if (lasagna_quest[1] < 5) {
		mes "[Basilisk Prisoner]";
		mes "............";
		close;
	}
	if (lasagna_quest[1] < 7) {
		mes "[Basilisk Prisoner]";
		mes "............";
		next;
		mes "[Basilisk Prisoner]";
		mes ".....................";
		next;
		mes "[Basilisk Prisoner]";
		mes "...........................";
		next;
		mes "[Jindou]";
		mes "光瞪着他可撬不开他的嘴。";
		next;
		mes "[Jindou]";
		mes "你需要一个适合他的‘解决方案’，";
		mes "哪怕需要一点强制手段。";
		next;
		mes "[Chief Peperoncino]";
		mes "Jindou。";
		mes "这不是你的测试。";
		mes "你插手的话就不能叫测试了，对吧？";
		next;
		mes "[Jindou]";
		mes "你真是个淘气的家伙。";
		mes "从没面对过蛇怪的人怎么通过那项测试？";
		next;
		mes "[Jindou]";
		mes "我们可不像你们那么悠闲。";
		next;
		mes "[Chief Peperoncino]";
		mes "哎呀……";
		mes "看来没办法了。";
		next;
		mes "[Jindou]";
		mes "从城镇向东前往拉维奥利森林，继续向‘东’走，直到找到巨大的荆棘藤蔓。";
		next;
		mes "[Jindou]";
		mes "带回 5 根荆棘藤蔓的枝条。";
		next;
		mes "[Jindou]";
		mes "你回来后我们继续。";
		if (lasagna_quest[1] == 5) {
			erasequest 11439;// Vigilante Corp
			setquest 11440;// Vigilante Corp
			lasagna_quest[1] = 6;
		}
		close2;
		warp "lasagna",218,185;
		end;
	}
	if (lasagna_quest[1] == 7) {
		if (checkweight(1001,2) == 0) {
			mes "- Hold on a second here!! -";
			mes "- You have too many items. -";
			mes "- That means you can no longer receive any items. -";
			mes "- Free up some space -";
			mes "- and try again. -";
			close;
		}
		select("使用荆棘藤笛");// regardless countitem
		if (select( "to hit him.", "Peep-peep-pweep-peep" ) == 1) {
			mes "[Basilisk Prisoner]";
			mes "Hiss!!!!!!!!!!!!!!!";
			close;
		}
		mes "[Basilisk Prisoner]";
		mes "Hiss!!!!!!!!!!!!!!!";
		next;
		select("使用荆棘藤笛");
		if (select( "Pweep-peep-peep-pweep", "to hit him." ) == 2) {
			mes "[Basilisk Prisoner]";
			mes "Hiss!!!!!!!!!!!!!!!";
			close;
		}
		mes "[Basilisk Prisoner]";
		mes "HISSSSSSSSSS!!!!!!!!!!!!!!!!!";
		next;
		select("使用荆棘藤笛");
		if (select( "Pweeeep--peep-peep-pweep", "to hit him." ) == 2) {
			mes "[Basilisk Prisoner]";
			mes "Hiss!!!!!!!!!!!!!!!";
			close;
		}
		mes "[Basilisk Prisoner]";
		mes "Hiss!!!";
		mes "你以为我会屈服吗？";
		next;
		select("使用荆棘藤笛");
		if (select( "To hit him.", "Peep-peep-pweep-peep" ) == 1) {
			mes "[Basilisk Prisoner]";
			mes "Hiss!!!!!!!!!!!!!!!";
			close;
		}
		mes "[Basilisk Prisoner]";
		mes "我什么都不知道！我不会告诉你是国王下令的！";
		next;
		select("使用荆棘藤笛");
		if (select( "Pweep-pweep-pweep-peep", "To hit him." ) == 2) {
			mes "[Basilisk Prisoner]";
			mes "Hiss!!!!!!!!!!!!!!!";
			close;
		}
		mes "[Basilisk Prisoner]";
		mes "Hiss!";
		mes "我绝不会告诉你，我们盯上的不是拉萨格纳，而是洞穴里住着的那个黄色东西！！！";
		next;
		mes "啾啾啾啾——";
		next;
		mes "[Chief Peperoncino]";
		mes "停！";
		mes "已经够了。";
		mes "干得漂亮。";
		next;
		mes "[Chief Peperoncino]";
		mes "Jindou，剩下的交给你了。";
		next;
		mes "[Jindou]";
		mes "我想我们问不出更多了，但有新消息我会告诉你。";
		next;
		mes "[Chief Peperoncino]";
		mes "很好。";
		mes "你一如既往地可靠。";
		next;
		mes "[Chief Peperoncino]";
		mes "好，我们出去讨论你的下一项测试。";
		next;
		mes "[Jindou]";
		mes "哦，等等！这次你帮了大忙，我把这个作为谢礼送给你。";
		next;
		mes "[Enriched Foxtail]";
		mes "魔法攻击力 +70，最大 SP +50。";
		mes "[Long Foxtail]";
		mes "远程物理攻击力 +5%，最大 HP +200。";
		next;
		switch( select( "Enriched Foxtail", "Long Foxtail", "Quit." ) ) {
		case 1:
			getitem 1683,1;// Enriched Foxtail Staff [1]
			break;
		case 2:
			getitem 1684,1;// Long Foxtail Staff [1]
			break;
		case 3:
			mes "[Jindou]";
			mes "很难选择吗？";
			close;
		}
		erasequest 11441;// Vigilante Corp
		setquest 11442;// Vigilante Corp
		lasagna_quest[1] = 8;
		getexp 500,400;
		close2;
		warp "lasagna",218,185;
		end;
	}
}

lasa_in01,64,92,3	script	Jindou#lasain	4_DOU_JINDO,{

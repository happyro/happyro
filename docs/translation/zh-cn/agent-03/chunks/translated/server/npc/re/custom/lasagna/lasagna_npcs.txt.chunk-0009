		next;
		mes "[Chief Peperoncino]";
		mes "我们一直相处得不错，但最近它们开始在拉萨格纳附近惹麻烦。";
		next;
		mes "[Chief Peperoncino]";
		mes "尤其是这家伙，昨天还进城大闹。我们不得不拘留他，但他不肯说原因。";
		next;
		mes "[Chief Peperoncino]";
		mes "既然到了这一步，我们就用必要的力量让他开口……";
		next;
		mes "[Chief Peperoncino]";
		mes "这是你的第一项测试。";
		next;
		mes "[Chief Peperoncino]";
		mes "让他说话。";
		erasequest 11438;
		setquest 11439;// Vigilante Corp
		lasagna_quest[1] = 5;
		close;
	}
	if (lasagna_quest[1] == 5) {
		mes "[Chief Peperoncino]";
		mes "这是你的第一项测试。";
		next;
		mes "[Chief Peperoncino]";
		mes "让他说话。";

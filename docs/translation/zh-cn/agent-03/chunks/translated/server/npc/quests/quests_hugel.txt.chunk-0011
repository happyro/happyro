	} else if (hg_ubu01 == 9) {
		emotion ET_THINK, playerattached();
			mes "^800080这个桶将成为象征，纪念 Torpy 父亲坚定的意志——他努力逃避与儿子寻找妻子的约定。^000000";
		close;
	} else {
		emotion ET_THINK, playerattached();
			mes "^800080你听到桶洞里传来骚动声。^000000";
			mes "^800080不过似乎没什么大事。^000000";
		close;
	}
}

hugel,100,174,3	script	Strange Man#Hugel	898,{
	if (hg_ubu01 == 5) {
		mes "[Strange Man]";
		mes "啊……谢谢你的免费餐！真提神！我最好再爬回那个桶里。回见，冒险者~";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "等等！你为什么躲在桶里？！";
		next;
		mes "[Strange Man]";
		mes "嗯？哦，我只是在和儿子玩捉迷藏。";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "但你已经好几天没吃东西了！等等，你该不会就是 Torpy 的父亲吧？";
		next;
		mes "[Strange Man]";
		mes "哦，你遇到我儿子了？他放弃我们的小赌约了吗？我可不想输……";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "呃，你的妻子和儿子很担心你。你不该尽快回家吗？";
		next;
		mes "[Strange Man]";
		mes "不，我不能！除非 Torpy 放弃！";
		mes "我和儿子做了一个很傻的约定，";
		mes "如果我输掉捉迷藏……";
		mes "我就是不能输！再见！";
		mes "";
		mes "";
		set hg_ubu01,6;
		changequest 12047,12048;
		next;
		mes "^3355FFTorpy's father has";
		mes "又藏起来了，";
		mes "但至少现在你可以回去找 Torpy 的妈妈和 Torpy，告诉他们";
		mes "";
		mes "";
		mes "两个人都知道他藏在哪里。^000000";
		close2;
		disablenpc "Strange Man#Hugel";
		enablenpc "Suspicious Barrel";
		end;
	} else {
		mes "[Strange Man]";
		mes "哈哈哈哈！";
		mes "蒸螃蟹钳！";
		mes "真是太满足了！";
		mes "我吃得太多，几天都不用再吃了！";
		close;
	}
	
OnEnable:
	enablenpc "Strange Man#Hugel";
	disablenpc "Suspicious Barrel";
	initnpctimer;
	end;
	
OnInit:
	disablenpc "Strange Man#Hugel";
	end;
	
OnTimer60000:
	stopnpctimer;
	disablenpc "Strange Man#Hugel";
	enablenpc "Suspicious Barrel";
	end;
}

// Fish Cake Soup Delivery Quest :: hg_odeng
//============================================================
hu_in01,15,372,3	script	Cellette Lavit	74,{
	if (!hg_odeng) {
		mes "[Cellette]";
		mes "你好，谢谢你来我们可爱的城镇！";
		mes "进来尝尝正宗休耶料理吧？保证不会后悔~";
		next;
		mes "[Cellette]";
		mes "我叫 Cellette Lavit，自豪地供应休耶特色鱼糕汤。";
		mes "尝过的游客都很喜欢，我也有许多常客~";
		next;
		mes "[Cellette]";
		mes "这道菜拥有狂热追随者，虽然还不普及，但我相信总有一天会成为施瓦茨瓦尔德共和国料理的代表。";
		next;
		mes "[Cellette]";
		mes "听着，你看起来是能干的冒险者。愿意来兼职吗？";
		mes "鱼糕汤订单很多，我没法亲自配送……";
		next;
		mes "[Cellette]";
		mes "如果为我工作，我会免除价格：每完成一次配送就送你 1 份鱼糕汤。";
		mes "如果没兴趣，也可以现在买一些~";
		next;

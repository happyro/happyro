			mes "女朋友！他答应过的～！^000000";
			set hg_ubu01,7;
			close;
		} else if (hg_ubu01 == 7) {
			mes "[Torpy]";
			mes "请快点去和妈妈说话好吗？";
			mes "她应该就在城外，你上次见到她的地方。暂时拜拜~";
			next;
			emotion ET_THINK, playerattached();
			mes "......";
			mes ".........";
			mes "............";
			next;
			mes "[Torpy]";
			mes "^333333...............................";
			mes "哦对了！要让妈妈帮我挑新女朋友吗？";
			mes "嗯，我不知道。如果她们成为朋友怎么办？那可能不太好……^000000";
			close;
		} else if (hg_ubu01 == 8) {
			emotion ET_THINK, playerattached();
			mes "[Torpy]";
			mes "爸爸答应我，只要我在捉迷藏中赢过他，就给我找女朋友！哈哈哈！";
			mes "我赢了，所以他必须做到！";
			next;
			mes "[Torpy]";
			mes "等等，要让爸爸帮我选女朋友吗？也许该我自己选……";
			mes "对，我要选能找到的最完美女孩！耶~";
			set hg_ubu01,9;
			close;
		} else if (hg_ubu01 == 9) {
			emotion ET_THINK, playerattached();
			mes "[Torpy]";
			mes "也许长大后再找女朋友比较好。";
			mes "现在选的女孩长大后变丑怎么办？或者变得很胖？我得小心……";
			next;
			mes "^3355FFTorpy 还是个年轻天真的孩子，";
			mes "对女朋友乃至人际关系还有很多要学习。^000000";
			close;
		} else {
			mes "[Torpy]";
			mes "^333333*抽泣*^000000爸爸不见了！";
			mes "请帮我找爸爸好吗？我、我现在必须找到他！快！";
			close;
		}
	} else {
		mes "[Torpy]";
		mes "哇啊～！";
		mes "我必须找到爸爸！爸爸……！";
		mes "你在哪里啊？！";
		mes "";
		close;
	}
}

hu_fild06,190,367,3	script	Torpy's Mom	701,{
	if (hg_ubu01 == 0) {
		mes "[Torpy's Mom]";
		mes "他这次又去哪儿了？！";
		mes "如果我丈夫没有不回家的好借口，最好想一个，否则他会后悔！";
		close;
	} else if (hg_ubu01 == 1) {
		mes "[Torpy's Mom]";
		mes "嗯？哦，你和 Torpy 说话了？他以为我和他爸爸消失了？";
		mes "抱歉，我想一定是误会！";
		next;
		mes "[Torpy's Mom]";
		mes "虽然 Torpy 的爸爸失踪了一阵子，但我只是今天早上出门。";
		mes "我离开还不到几小时，更别说一天了。";
		next;
		mes "[Torpy's Mom]";
		mes "你看，我丈夫是猎人，几天不回家很正常。";
		mes "几天。不过他以前从没离开这么久，";
		mes "所以我一直在找他……";
		mes "";
		next;
		mes "[Torpy's Mom]";
		mes "老实说，我也有点担心。他不在平时的狩猎地。希望我在这里等久了，他迟早会出现。";
		next;
		mes "[Torpy's Mom]";
		mes "如果他今天还不出现，我最好进城找他。也许他躲在朋友家。怎么总是这样？";
		next;
		mes "[Torpy's Mom]";
		mes "请告诉儿子 Torpy 我没事，很快回家。如果在城里看到我丈夫，让他赶紧回家！";
		set hg_ubu01,2;
		changequest 12044,12045;
		close;
	} else if (hg_ubu01 == 2) {
		mes "[Torpy's Mom]";
		mes "请告诉我的儿子 Torpy，我没事，很快就会回家。";
		mes "如果你在城里看到我丈夫，也告诉他赶紧回家！";
		mes "";
		mes "";
		mes "";
		mes "";
		close;
	} else if (hg_ubu01 == 6 || hg_ubu01 == 7) {
		mes "[Torpy's Mom]";
		mes "什么？！他一直躲在桶里？！哦，不。抱歉，我丈夫给你添了这么多麻烦。";
		next;
		mes "[Torpy's Mom]";
		mes "非常感谢你帮我们找到他。礼物不贵重，但请收下我们的谢意。暂时再见，冒险者~";
		specialeffect2 (hg_ubu01 == 6)?EF_CONE:EF_MVP;
		set hg_ubu01,8;
		completequest 12048;
		getitem 12065,3; //Green Salad
		getexp (checkre(3))?5000:50000,0;
		close;
	} else if (hg_ubu01 == 8) {
		mes "[Torpy's Mom]";
		mes "有时我想，Torpy 是不是太成熟，或者我丈夫太幼稚。奇怪的是，他们真的很像。唉……";
		close;
	} else if (hg_ubu01 == 9) {
		emotion ET_THINK, playerattached();
		mes "[Torpy's Mom]";
		mes "我丈夫什么时候才从桶里出来？他没又和 Torpy 打奇怪的赌吧？唉，那两个人真让人头疼……";
		close;
	} else {
		mes "[Torpy's Mom]";
		mes "他这次又去哪儿了？！";
		mes "如果我丈夫没有不回家的好借口，";
		mes "最好想一个，否则他会后悔！";
		mes "";
		mes "";
		close;
	}
}

hugel,100,176,3	script	Suspicious Barrel	111,{
	if (hg_ubu01 == 3) {
		mes "[Strange Man]";
		mes "好……饿……食、食物……给我……必须用蒸螃蟹钳补充健康……求你……";
		next;
		emotion ET_THINK, playerattached();
		mes "^3355FF听起来这个桶想要蒸螃蟹钳。^000000";
		next;
		switch(select("我给你带蒸螃蟹钳:忽略")) {
		case 1:
			mes "[Strange Man]";
			mes "请……给我做……蒸螃蟹钳……！你、你需要 10 个绿草、1 瓶黄色药水和 10 个蟹钳来烹饪。呃……";
			next;
			emotion ET_THINK, playerattached();
			mes "["+strcharinfo(0)+"]";
			mes "等等，我得替你做吗？！";
			next;
			mes "[Strange Man]";
			mes "是、是的……这是唯一的办法……请帮忙……";
			set hg_ubu01,4;
			changequest 12046,12047;
			close;
		case 2:
			mes "[Strange Man]";
			mes "别……留下我……这里……饥饿……不能……不能被拒绝！";
			next;
			emotion ET_THINK, playerattached();
			mes "["+strcharinfo(0)+"]";
			mes "怪人！你为什么不从桶里出来，自己去弄蒸螃蟹钳？！";
			close;
		}
	} else if (hg_ubu01 == 4) {
		if (countitem(12051)) {
			mes "[Strange Man]";
			mes "这、这个诱人的气味……是蒸螃蟹钳……";
			mes "哦，天啊……已经太、太久了……";
			mes "给、给我！现在就给我！";
			mes "";
			mes "";
			next;
			emotion ET_THINK, playerattached();
			mes "^3355FF你把蒸螃蟹钳倒进桶里，";
			mes "很快就被吃光了。^000000";
			delitem 12051,1; //Steamed crab nippers
			set hg_ubu01,5;
			next;
			mes "[Strange Man]";
			mes "哈哈哈！";
			mes "重新活跃起来了，宝贝！";
			mes "我上次吃东西大概是三天前？";
			mes "活着真好！";
			close2;
			donpcevent "Strange Man#Hugel::OnEnable";
			end;
		} else {
			mes "[Strange Man]";
			mes "请……给我做……";
			mes "蒸……螃蟹钳……！";
			mes "你……需要 10 株绿色药草、1 瓶黄色药水……";
			mes "还有 10 个……螃蟹钳……来、来做。呃……";
			mes "";
		mes "";
			next;
			emotion ET_THINK, playerattached();
			mes "["+strcharinfo(0)+"]";
			mes "等等，";
			mes "我必须替你做吗？！";
			mes "";
			next;
			mes "[Strange Man]";
			mes "是、是的……";
			mes "这……这是唯一可能的方法……";
			mes "求、求你帮忙……";
			mes "";
			close;
		}
	} else if (hg_ubu01 == 5) {
		if (countitem(12051)) {
			mes "[Strange Man]";
			mes "这、这个诱人的气味……是蒸螃蟹钳……";
			mes "哦，天啊……已经太、太久了……";
			mes "给、给我！现在就给我！";
			mes "";
			mes "";
			next;
			emotion ET_THINK, playerattached();
			mes "^3355FF你把蒸螃蟹钳倒进桶里，";
			mes "很快就被吃光了。^000000";
			mes "";
			mes "";
			delitem 12051,1; //Steamed crab nippers
			set hg_ubu01,5;
			next;
			mes "[Strange Man]";
			mes "哈哈哈！";
			mes "重新活跃起来了，宝贝！";
			mes "我上次吃东西大概是三天前？";
			mes "活着真好！";
			mes "";
			close2;
			donpcevent "Strange Man#Hugel::OnEnable";
			end;
		} else {
			mes "[Strange Man]";
			mes "请……给我做……";
			mes "蒸……螃蟹钳……！";
			mes "你……需……10 株绿色";
			mes "药草……1 瓶黄色药水……";
			mes "还有 10……把钳子……来";
			mes "来、来做。呃……";
			next;
			emotion ET_THINK, playerattached();
			mes "["+strcharinfo(0)+"]";
			mes "Hold on,";
			mes "我必须替你做吗？！";
			mes "";
			next;
			mes "[Strange Man]";
			mes "Y-yes...";
			mes "这……这是唯一可能的方法……";
			mes "求、求你帮忙……";
			mes "";
			close;
		}
	} else if (hg_ubu01 == 6) {
		emotion ET_THINK, playerattached();
			mes "^3355FF现在应该告诉 Torpy 和他妈妈，Torpy 的父亲藏在哪里，这样他们就不会太担心。^000000";
		close;
	} else if (hg_ubu01 == 7) {
		emotion ET_THINK, playerattached();
			mes "^800080Torpy 的妈妈也许想知道这个奇怪的桶。^000000";

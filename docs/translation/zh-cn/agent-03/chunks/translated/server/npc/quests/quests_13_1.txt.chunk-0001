// Onward to the New World :: ep13_gogo
//============================================================ 
function	script	Promotional_Staff	{
	mes "[宣传员]";
	mes "我们正在寻找充满好奇心、极其勇敢的冒险者。";
	mes "加入我们，开启精彩的冒险吧！";
	next;
	mes "[宣传员]";
	mes "嘿，你是个见多识广的人，对吧？对我的故事感兴趣吗？";
	next;
	switch(select("是的。:不用了，谢谢。")) {
	case 1:
		mes "[宣传员]";
		mes "你是真正的冒险者。";
		mes "很好！";
		mes "你不会后悔的。";
		next;
		mes "[宣传员]";
		mes "我通常会派冒险者前往";
		mes "新发现的地方进行研究。";
		mes "这非常有挑战性，因为从未有人去过那些地方。";
		next;
		mes "[宣传员]";
		mes "任务相当危险，";
		mes "所以只有勇敢的人";
		mes "才有资格接受";
		mes "这项任务的挑战。";
		next;
		mes "[宣传员]";
		mes "我不确定你的实力是否足够，但你看起来很勇敢。去找王国接待员怎么样？他应该在普隆德拉城堡的第一个房间。";
		next;
		mes "[宣传员]";
		mes "根据我听说的情况……那里不是一块新大陆。";
		mes "我不知道它在哪里。";
		mes "嗯……在天空里面？";
		next;
		mes "[宣传员]";
		mes "也许只是传闻，";
		mes "但我也不确定。";
		mes "这不是我负责的事。";
		next;
		mes "[宣传员]";
		mes "总之，我要把这件事告诉许多冒险者。";
		mes "没时间浪费了！";
		close;
	case 2:
		mes "[宣传员]";
		mes "哼，我还以为你是真正的冒险者。你错过了大好机会。你一点也不勇敢，绝对不是！";
		close;
	}
}

prontera,163,53,3	script	Promotional Staff#prt	100,{
	callfunc "Promotional_Staff";
	end;
}

-	script	Alliance Manager#prt_	-1,{
	if (ep13_ryu == 13) {
		mes "[联盟管理者]";
		mes "如果我们先于施瓦茨瓦尔德采取行动，就能占据优势！但我们错过了机会。";
		next;
		mes "[联盟管理者]";
		mes "虽然我们与他们结盟，但那不过是形式而已。";
		mes "我们会利用他们。";
		next;
		mes "[联盟管理者]";
		mes "你知道我们来这里做什么吗？这些东西能帮助我们控制多个国家，并了解他们的魔法。";
		next;
		mes "[联盟管理者]";
		mes "不管怎样，即使这些东西对我们没用，也最好把它们销毁，防止被别人利用。";
		next;
		mes "[联盟管理者]";
		mes "除了卢恩-米德加兹不存在的东西……把它们藏好。你手里有什么，只要向我们报告。";
		close;
	}
	if (ep13_ryu == 12) {
		mes "[联盟管理者]";
		mes "……你找我有事吗？";
		next;
		mes "[联盟管理者]";
		mes "嗯……老板让你来找我，";
		mes "是要谈那些问题吗？好！";
		next;
		mes "[联盟管理者]";
		mes "那么，一切进展顺利吗？";
		mes "你和施瓦茨瓦尔德结盟了？";
		mes "他们会加入你们。";
		mes "我知道了。";
		next;
		mes "[联盟管理者]";
		mes "嗯……好。";
		next;
		mes "[联盟管理者]";
		mes "你们都要穿过";
		mes "次元裂缝前进……";
		next;
		mes "[联盟管理者]";
		mes "很好，已经开始了。";
		mes "我们也要做好准备，";
		mes "不要被说服而倒戈。";
		next;
		mes "[联盟管理者]";
		mes "我们是所谓的‘盟友’，";
		mes "所以不能在公开场合互相占便宜，";
		mes "但不能在公开场合互相占便宜，";
		mes "但可以暗中行动。";
		next;
		mes "[联盟管理者]";
		mes "施瓦茨瓦尔德……他们全都是";
		mes "自大的家伙。我知道他们做过什么。";
		mes "他们会想尽办法捞好处，";
		mes "却几乎不付出劳动。我知道";
		mes "他们的卑鄙伎俩。";
		next;
		mes "[联盟管理者]";
		mes "我们绝不能让他们占到便宜，";
		mes "绝对不行！我们的实力不如";
		mes "他们中的大多数。";
		next;
		mes "[联盟管理者]";
		mes "我们只有一处奇怪的次元裂缝作为储备，";
		mes "除此之外什么也没有……我们要设法欺骗他们，";
		mes "并设法战胜他们！";
		mes "一定要赢过他们！";
		next;
		mes "[联盟管理者]";
		mes "你是我们联盟的一员。";
		mes "务必小心，别迷失方向。";
		next;
		changequest 10068,10069;
		set ep13_ryu,13;
		mes "[联盟管理者]";
		mes "感谢你的报告。";
		mes "我们准备得更充分了。";
		mes "做得好，你现在可以走了。";
		close;
	}
	mes "[联盟管理者]";
	mes "你来这里有事吗？";
	close;
}

-	script	Member of Alliance#prt_	-1,{
	if ((ep13_ryu == 12) || (ep13_ryu == 13)) {
		mes "[联盟成员]";
		mes "如果我们拥有绝对的力量，就不必和施瓦茨瓦尔德及阿鲁纳佩尔兹相处。";
		next;
		mes "[联盟成员]";
		mes "我不知道魔王梦罗克何时会攻击我们，也不知道我们是否强大到能侦测到他。";
		next;
		mes "[联盟成员]";
		mes "我们无法避免与他们合作。我们已经没有多少选择了。";
		next;
		mes "[联盟成员]";
		mes "所以我们会在这处次元裂缝中暗中利用他们。";
		close;
	}
	mes "[联盟成员]";
	mes "如果我们拥有更强的力量，";
	mes "现在就不会落到这种地步。";
	mes "力量才是最重要的。";
	close;
}

-	script	Recruiter for the Brave_	-1,{
	if (ep13_ryu == 12) {
		mes "[招募者]";
		mes "你怎么又来了？";
		mes "你最好去施瓦茨瓦尔德登记。";
		next;
		mes "[招募者]";
		mes "什么？你来这里是要传达消息？说吧。";
		next;
		mes "[招募者]";
		mes "到旁边去。有一位管理者负责我们所有人，也负责米德加尔特的国际关系。";
		next;
		mes "[招募者]";
		mes "直接和他谈吧。";
		close;
	}
	if (ep13_ryu > 8) {
		mes "[招募者]";
		mes "去那里吧。";
		mes "你从我这里什么也得不到。";
		mes "赶快前往";
		mes "^FF0000莱岑^000000，三大王国的发源地……";
		close;
	}
	if (ep13_ryu == 8) {
		mes "[招募者]";
		mes "我听说过你。";
		mes "你已经通过宣传员的测试了吗？";
		next;
		mes "[招募者]";
		mes "你绝对足够勇敢，可以前往这片新土地。";
		mes "现在我任命你去探索并在灰烬真空中冒险。";
		next;
		select("灰烬真空？");
		mes "[招募者]";
		mes "嗯，那是你将要冒险之地的代号。坦白说，我们并不确切知道那里是什么，但我们称它为‘灰烬真空’。";
		next;
		mes "[招募者]";
		mes "信不信由你，";
		mes "这绝对是真的。";
		mes "所以请仔细听。";
		mes "拜托了。";
		next;
		mes "[招募者]";
		mes "灰烬真空……是一处生机之地……与我们现在生活的地方完全不同。";
		next;
		mes "[招募者]";
		mes "那是未知之地。";
		mes "我们不知道那里有什么，";
		mes "也不知道谁生活在那里。";
		mes "那超出了我们的想象。";
		mes "没人知道。";
		next;
		mes "[招募者]";
		mes "只有像你一样勇敢的人才值得去那里。你身边会有许多危险，但你必须代表米德加尔特探索那里。";
		next;
		mes "[招募者]";
		mes "嗯……";
		next;
		mes "[招募者]";
		mes "总之，我确信那里有许多名利双收的机会……";
		next;
		mes "[招募者]";
		mes "首先，你应该前往 ^FF0000莱岑^000000 登记加入米德加尔特联合联盟。我想他们正在雷根贝勒公司总部开会……";
		next;
		mes "[招募者]";
		mes "在那里你能得到比我更详细的指引。去找他吧……";
		next;
		mes "[招募者]";
		mes "我能做的都做了。去那里开始行动吧！";
		next;
		mes "[招募者]";
		mes "记住，前往 ^FF0000莱岑^000000，然后按照那里的指引行动。";
		next;
		changequest 10064,10065;
		set ep13_ryu,9;
		if (checkre(3))
			getexp 66000,21000;
		else
			getexp 660000,210000;
		mes "[招募者]";
		mes "去那里吧！";
		mes "仔细听清楚";
		mes "你的任务内容！";
		mes "我说完了……";
		close;
	}
	if (ep13_ryu > 0) {
		mes "[招募者]";
		mes "你在这里做什么？";
		mes "直接去 ^FF0000艾尔帕兰^000000 找 ^FF0000宣传员^000000。按我说的做，别浪费时间。";
		close;
	}
	mes "[招募者]";
	mes "勇敢的人们！到我这里来！";
	mes "真正勇敢的人！";
	mes "愿意尝试具有挑战性的任务吗？";
	next;
	mes "[招募者]";
	mes "我是普隆德拉寻找勇者的招募者！我的目标是为这项任务招募最勇敢的冒险者。";
	next;
	mes "[招募者]";
	mes "你愿意加入吗？";
	mes "这里随时欢迎你。";
	mes "我知道，你充满好奇。";
	mes "想尝试什么就去尝试吧。";
	next;
	switch(select("是的，我感兴趣。:不用了，谢谢。")) {
	case 1:
		mes "[招募者]";
		mes "哦！是的！你真好奇！";
		mes "你是真正的冒险者。";
		mes "拥有真正的冒险热情。";
		mes "好！让我先告诉你任务的故事！！";
		next;
		mes "[招募者]";
		mes "这些事宣传员当然也能告诉你，但他们不太可靠。所以让我来解释。仔细听就好。";
		next;
		mes "[招募者]";
		mes "嗯……其实没什么好说的……";
		mes "...";
		next;
		mes "[招募者]";
		mes "重点是，我们需要一个既好奇又勇敢的人前往新地方。而我选择了你！！";
		next;
		mes "[招募者]";
		mes "这是未知之地中的特殊之处，非常特别！现在我不能告诉你太多。相信我，它真的非同寻常！";
		next;
		mes "[招募者]";
		mes "那么现在，让我来测试你。";
		mes "等你合格之后，";
		mes "我会把一切告诉你。";
		next;
		mes "[招募者]";
		mes "去艾尔帕兰的 ^FF0000宣传员^000000 那里取得许可。他们比我更能仔细评估你。去吧。";
		next;
		mes "[招募者]";
		mes "只要你说是普隆德拉的招募者派来的，他们就会处理一切。";
		next;
		setquest 10057;
		set ep13_ryu,1;
		mes "[招募者]";
		mes "时间就是 Zeny，快去吧。";
		mes "一旦拜访宣传员，你就能获准前往未知之地。";
		close;
	case 2:
		mes "[招募者]";
		mes "你真的在享受冒险吗？看来你没那么好奇。";
		next;
		mes "[招募者]";
		mes "去做你自己的事吧！";
		next;
		mes "[招募者]";
		mes "-嘟囔与抱怨……-";
		close;
	}
}

aldebaran,127,138,3	script	Promotional Staff#alde	100,{
	if (ep13_ryu > 3) {
		mes "[宣传员]";
		mes "你参加测试了吗，还是已经在享受冒险了？";
		close;
	}
	if (ep13_ryu == 3) {
		mes "[宣传员]";
		mes "去拜访 ^FF0000吉芬的宣传员^000000 吧。你没必要再来找我了。祝福你，愿你冒险平安。";
		close;
	}
	if (ep13_ryu == 2) {
		if (countitem(909) < 300) {
			mes "[宣传员]";
			mes "别忘了带来……^FF0000300 个杰勒比结晶^000000。";
			mes "明白了吗？^FF0000300 个杰勒比结晶^000000！";
			mes "收集齐后告诉我。";
			close;
		}
		mes "[宣传员]";
		mes "嘿！收集齐后告诉我。";
		mes "别再打扰我了。我很忙……真浪费时间。";
		next;
		mes "[宣传员]";
		mes "嗯？你把它们全带来了吗？";
		mes "不！这真是件令人烦恼的工作。";
		mes "没想到你竟然能完成带来 300 个杰勒比结晶这种琐事！";
		next;
		mes "[宣传员]";
		mes "你真有胆量，小子！";
		mes "你是个意志坚定的人！";
		mes "好，你赢了！";
		mes "你通过了！！";
		next;
		mes "[宣传员]";
		mes "像你这样的冒险者";
		mes "可不常见。";
		mes "真是身经百战的战士！";
		mes "比我还强！";
		next;
		mes "[宣传员]";
		mes "现在你能去找";
		mes "吉芬的宣传员吗？";
		mes "他会再次测试你。";
		next;
		mes "[宣传员]";
		mes "你知道这不是简单的任务。";
		mes "你已经决心完成它了，对吧？";
		mes "做好心理准备吧。";
		next;
		delitem 909,300; //Jellopy
		changequest 10058,10059;
		set ep13_ryu,3;
		mes "[宣传员]";
		mes "总之，你完成了第一步。";
		mes "祝福你！";
		close;
	}
	if (ep13_ryu == 1) {
		mes "[宣传员]";
		mes "我们需要充满好奇心、极其勇敢的冒险者。加入我们，开启精彩的冒险吧！";
		next;
		mes "[宣传员]";
		mes "嘿，你是个见多识广的人，对吧？对我的故事感兴趣吗？";
		next;
		select("我有东西给你。");
		mes "[宣传员]";
		mes "给我的？？";
		mes "我讨厌麻烦事。";
		next;
		mes "[宣传员]";
		mes "啊……我就知道你会提出请求。";
		mes "是招募者派你来接受测试的吗？";
		mes "嗯。";
		next;
		mes "[宣传员]";
		mes "啊！他们总是逼我，";
		mes "让我承受这么多工作，";
		mes "我的日子真难过！";
		next;
		mes "[宣传员]";
		mes "我的工作就是测试你是否足够强大、勇敢，能否胜任这次冒险。";
		mes "真麻烦！";
		next;
		mes "[宣传员]";
		mes "如果你带来 ^FF0000300 个杰勒比结晶^000000，我就认可你。";
		mes "我相信你能把它们带给我。";
		mes "准备好了吗？";
		next;
		changequest 10057,10058;
		set ep13_ryu,2;
		mes "[宣传员]";
		mes "去打怪或做其他事情，收集 300 个杰勒比结晶吧。";
		mes "这样我们就能继续前进。";
		close;
	}
	callfunc "Promotional_Staff";
	end;
}

geffen,90,67,3	script	Promotional Staff#gef	100,{
	if (ep13_ryu > 6) {
		mes "[宣传员]";
		mes "你参加测试了吗？";
		mes "还是已经在享受冒险了？";
		close;
	}
	if (ep13_ryu == 6) {
		mes "[宣传员]";
		mes "你还没去过 ^FF0000伊兹鲁德^000000，对吧？";
		mes "还是你在吉芬有什么事？";
		close;
	}
	if (ep13_ryu == 5) {
		if (countitem(723) == 0) {
			mes "[宣传员]";
			mes "^FF00001 颗红宝石！！^000000";
			mes "可别忘了！";
			mes "快点！时间就是 Zeny！";
			close;
		}
		mes "[宣传员]";
		mes "哇，你带来了真正的宝石。";
		mes "你完全合格了。";
		mes "这些我一眼就能看出来。";
		next;
		mes "[宣传员]";
		mes "我是在夸张吗？";
		mes "你确实";
		mes "相当强大。";
		next;
		mes "[宣传员]";
		mes "好！我的工作完成了。";
		mes "干得好！！";
		next;
		mes "[宣传员]";
		mes "下一步是伊兹鲁德！";
		mes "你可以在那里接受宣传员的测试。";
		mes "快点！";
		next;
		mes "[宣传员]";
		mes "未知之地……";
		mes "那里非常危险，所以在派你去之前，必须通过这些测试……";
		mes "我们可是很挑剔的。";

prt_in,168,56,4	script	Monster Encyclopedia#prt	HIDDEN_NPC,{
	mes "^FF0000[Monster Encyclopedia]^000000";
	mes "这是一本怪物百科，";
	mes "记录了水、风和幽灵";
	mes "属性怪物的信息。";
	next;
	switch(select("水属性怪物:风属性怪物:幽灵属性怪物:取消")) {
	case 1:
		while(1) {
			switch(select("小型怪物:中型怪物:大型怪物:取消")) {
			case 1:
				mes "^FF0000[Vol. 1: Small Water Monsters]^000000";
				mes "1. Plankton";
				mes "虽然它们看起来小得不起眼，";
				mes "也要小心别踩到。浮游生物很轻，";
				mes "可以漂浮在水面上。";
				mes "^0099FF掉落物^000000：单细胞、Garlet、";
				mes "黏稠液体、空瓶";
				mes "";
				next;
				mes "^FF0000[Vol. 1: Small Water Monsters]^000000";
				mes "2. Kukre";
				mes "库克雷比盗虫好看，";
				mes "但基本上同样会偷取物品。";
				mes "幸运的是，它们不会攻击成群的玩家。";
				mes "^0099FF掉落物^000000：虫皮、Garlet、";
				mes "怪物饲料、红色药草、昆虫触角";
				mes "";
				mes "";
				next;
				mes "^FF0000[Vol. 1: Small Water Monsters]^000000";
				mes "3. Hydra";
				mes "生活在水边或深海的植物怪物，";
				mes "用触手发动攻击。它们成群出现时，";
				mes "会让人非常头疼。";
				mes "^0099FF掉落物^000000：触手、黏稠液体、肉。";
				mes "";
				mes "";
				next;
				mes "^FF0000[Vol. 1: Small Water Monsters]^000000";
				mes "4. Vadon";
				mes "Vadon身披厚重的保护壳，";
				mes "用强力钳子攻击。虽然看起来像螃蟹，";
				mes "但它们的肉不能食用。";
				mes "^0099FF掉落物^000000：螯、Garlet、坚硬外壳、壳";
				mes "";
				mes "";
				next;
				mes "^FF0000[Vol. 1: Small Water Monsters]^000000";
				mes "5. Marina";
				mes "透明的水母，会像鞭子一样";
				mes "伸展柔软身体发动攻击。";
				mes "它们生活在水边的凉爽之处。";
				mes "^0099FF掉落物^000000：单细胞、黏稠液体";
				mes "";
				mes "";
				next;
				mes "^FF0000[Vol. 1: Small Water Monsters]^000000";
				mes "6. Cornutus";
				mes "性情温和的怪物，藏在坚硬的";
				mes "头巾状外壳中。它们努力在这个";
				mes "疯狂的世界里尽可能和平地生活。";
				mes "^0099FF掉落物^000000：海螺、Scell、坚硬外壳";
				mes "";
				mes "";
				next;
				mes "^FF0000[Vol. 1: Small Water Monsters]^000000";
				mes "7. Magnolia";
				mes "外表可爱的生物，看起来像正在煎蛋的";
				mes "大煎锅。它们会无情地拍打所有";
				mes "反抗自己的东西。";
				mes "^0099FF掉落物^000000：粘稠液体、Garlet、Scell";
				mes "";
				next;
				mes "^FF0000[Vol. 1: Small Water Monsters]^000000";
				mes "8. Marine Sphere";
				mes "形状奇特的圆形怪物，";
				mes "体内涌动着破坏性能量。";
				mes "收集它们的引爆器";
				mes "可能对炼金术士有用。";
				mes "^0099FF掉落物^000000：腱、引爆器";
				mes "";
				next;
				break;
			case 2:
				mes "^FF0000[Vol. 2: Medium Water Monsters]^000000";
				mes "1. Poring";
				mes "由活性胶状物质构成的";
				mes "小型粉色怪物。";
				mes "它们很可爱，通过弹跳移动。";
				mes "^0099FF掉落物^000000：粘稠液体、";
				mes "苹果、空瓶、红色药草";
				mes "";
				next;
				mes "^FF0000[Vol. 2: Medium Water Monsters]^000000";
				mes "2. Roda Frog";
				mes "会发出烦人呱呱声的两栖青蛙。";
				mes "在某些国家，它们的腿是美味佳肴。";
				mes "^0099FF掉落物^000000：黏脚、蛙卵、";
				mes "绿色药草、空瓶";
				mes "";
				next;
				mes "^FF0000[Vol. 2: Medium Water Monsters]^000000";
				mes "3. Spore";
				mes "利用菌丝繁殖的蘑菇状怪物。";
				mes "通常生活在森林或地下城。";
				mes "^0099FF掉落物^000000：孢子、红色药草、蓝色";
				mes "药草";
				mes "";
				mes "";
				next;
				mes "^FF0000[Vol. 2: Medium Water Monsters]^000000";
				mes "4. Goblin";
				mes "戴着面具的小型怪物，";
				mes "会凶狠攻击路人。";
				mes "似乎有使用不同武器的类型。";
				mes "^0099FF掉落物^000000：黄色药草、红色";
				mes "药草";
				mes "";
				next;
				mes "^FF0000[Vol. 2: Medium Water Monsters]^000000";
				mes "5. Thara Frog";
				mes "比绿色Roda Frog强得多的红色青蛙。";
				mes "它们同样会发出烦人的呱呱声。";
				mes "^0099FF掉落物^000000：蛙卵、Scell、黏脚";
				mes "";
				mes "";
				next;
				mes "^FF0000[Vol. 2: Medium Water Monsters]^000000";
				mes "6. Phen";
				mes "鼻子尖尖的蓝色鱼类，";
				mes "有着悲伤、空洞的眼睛。";
				mes "^0099FF掉落物^000000：鱼尾、尖锐鳞片、";
				mes "肉、鳍";
				mes "";
				next;
				mes "^FF0000[Vol. 2: Medium Water Monsters]^000000";
				mes "7. Marse";
				mes "长着小触手的小鱿鱼。";
				mes "它如何用这些小东西在水中移动，";
				mes "至今仍是科学谜团。";
				mes "^0099FF掉落物^000000：鱿鱼墨汁、触手";
				mes "";
				mes "";
				next;
				mes "^FF0000[Vol. 2: Medium Water Monsters]^000000";
				mes "8. Obeaune";
				mes "会用狂乱飘舞的头发攻击的女性人鱼。";
				mes "它的男性版本是否为鱼人，";
				mes "仍在争论中。";
				mes "^0099FF掉落物^000000：人鱼之心、鳍";
				mes "";
				mes "";
				next;
				mes "^FF0000[Vol. 2: Medium Water Monsters]^000000";
				mes "9. Sohee";
				mes "怀有深深怨恨的女性幽灵。";
				mes "虽然通常在哭泣，遇到活人时";
				mes "会变得凶猛。";
				mes "^0099FF掉落物^000000：黑色头发、红色药草";
				mes "";
				mes "";
				next;
				mes "^FF0000[Vol. 2: Medium Water Monsters]^000000";
				mes "10. Marc";
				mes "外表骄傲、看起来有点像龙的海马。";
				mes "遗憾的是，你不能骑它。";
				mes "^0099FF掉落物^000000：鳃、鳍";
				mes "";
				mes "";
				next;
				mes "^FF0000[Vol. 2: Medium Water Monsters]^000000";
				mes "11. Deviace";
				mes "嘴巴连接在吸盘上的鱼类怪物。";
				mes "体型小而强壮，看起来有点像西瓜。";
				mes "^0099FF掉落物^000000：古代牙齿、古代嘴唇";
				mes "";
				next;
				break;
			case 3:
				mes "^FF0000[Vol. 3: Great Water Monsters]^000000";
				mes "1. Ambernite";
				mes "蜗牛形状的怪物，攻防都很强。";
				mes "不过和其他蜗牛一样，移动非常慢。";
				mes "^0099FF掉落物^000000：蜗牛壳、";
				mes "Garlet、壳、坚硬外壳";
				mes "";
				next;
				mes "^FF0000[Vol. 3: Great Water Monsters]^000000";
				mes "2. Sword Fish";
				mes "鼻子又长又尖，像剑一样的鱼类怪物。";
				mes "虽然眼睛突出，却是危险的怪物。";
				mes "为什么不叫剑鼻鱼？";
				mes "^0099FF掉落物^000000：尖锐鳞片、鳃";
				next;
				break;
			case 4:
				close;
			}
		}

	case 2:
		while(1) {
			switch(select("小型魔物:中型魔物:大型魔物:取消")) {
			case 1:
				mes "^FF0000[Vol. 4: Small Wind Monsters]^000000";
				mes "1. Chonchon";
				mes "移动速度极快的苍蝇怪物。";
				mes "令人惊讶的是，它们能在粪便附近治愈。";
				mes "^0099FF掉落物^000000：壳、粘稠液体、苍蝇翅膀";
				mes "";
				mes "";
				next;
				mes "^FF0000[Vol. 4: Small Wind Monsters]^000000";
				mes "2. Hornet";
				mes "通常性情温和，但其中一只受伤时，";
				mes "它们会成群攻击。";
				mes "^0099FF掉落物^000000：蜂针、粘稠液体、绿色药草";
				mes "";
				mes "";
				next;
				mes "^FF0000[Vol. 4: Small Wind Monsters]^000000";
				mes "3. Creamy";
				mes "长着美丽翅膀的飞行怪物。";
				mes "感到极度危险时会用瞬间移动逃跑。";
				mes "^0099FF掉落物^000000：蝴蝶粉、蜂蜜、";
				mes "蝴蝶翅膀、花";
				mes "";
				next;
				mes "^FF0000[Vol. 4: Small Wind Monsters]^000000";
				mes "4. Stainer";
				mes "带有华丽瓢虫状外壳的小昆虫。";
				mes "它能感知魔法，一旦开始施法就会攻击。";
				mes "^0099FF掉落物^000000：彩虹壳、Garlet、";
				mes "壳、坚硬外壳";
				mes "";
				mes "";
				next;
				mes "^FF0000[Vol. 4: Small Wind Monsters]^000000";
				mes "5. Steel Chonchon";
				mes "类似苍蝇，但呈黄绿色。";
				mes "它会捡起地上的一切，";
				mes "所以小心不要掉落物品。";
				mes "^0099FF掉落物^000000：Garlet、壳、坚硬外壳";
				mes "";
				mes "";
				mes "";
				next;
				mes "^FF0000[Vol. 4: Small Wind Monsters]^000000";
				mes "6. Dustiness";
				mes "这种飞行怪物闪避率很高，";
				mes "如果你的攻击命中率低，最好别惹它。";
				mes "^0099FF掉落物^000000：蛾粉、蛾翅、";
				mes "昆虫触角、红色药草";
				mes "";
				mes "";
				next;
				mes "^FF0000[Vol. 4: Small Wind Monsters]^000000";
				mes "7. Hunter Fly";
				mes "被无辜者鲜血覆盖的有翼昆虫。";
				mes "它速度极快且力量强大。";
				mes "初心者无论如何都必须逃离它。";
				mes "^0099FF掉落物^000000：坚硬外壳、Zargon";
				mes "";
				mes "";
				next;
				break;
			case 2:
				mes "^FF0000[Vol. 5: Medium Wind Monsters]^000000";
				mes "1. Condor";
				mes "秃顶、长相滑稽的秃鹫般鸟类。";
				mes "其中一只受到威胁时，";
				mes "它们往往会成群攻击。";
				mes "^0099FF掉落物^000000：爪、箭、肉、鸟羽";
				mes "";
				mes "";
				next;
				mes "^FF0000[Vol. 5: Medium Wind Monsters]^000000";
				mes "2. Cobold the 1st";
				mes "看起来像幼狼的怪物，";
				mes "聪明到能制造和使用工具。";
				mes "虽然狗头人很可爱，";
				mes "实际上却相当敌对。";
				mes "^0099FF掉落物^000000：蓝色发带、Zargon、黄色药草";
				mes "";
				next;
				mes "^FF0000[Vol. 5: Medium Wind Monsters]^000000";
				mes "3. Petite";
				mes "小巧可爱的飞龙。还有一种会走路的 Petite，";
				mes "但它属于地属性。";
				mes "^0099FF掉落物^000000：龙牙、龙尾、Zargon";
				mes "";
				mes "";
				next;
				break;
			case 3:
				mes "^FF0000[Vol. 6: Great Wind Monsters]^000000";
				mes "1. Joker";
				mes "一张巨大的魔法扑克牌。";
				mes "如果攻击命中率不高，和 Joker 战斗时你会处于劣势。";
				mes "";
				mes "";
				mes "^0099FF掉落物^000000：高跟鞋";
				next;
				break;
			case 4:
				close;
			}
		}

	case 3:
		while(1) {
			switch(select("小型魔物:中型魔物:大型魔物:取消")) {
			case 1:
				mes "^FF0000[Vol. 7: Small Ghost Monsters]^000000";
				mes "1. Whisper";
				mes "散发诡异气息的活布料。";
				mes "有时喜欢变成隐形……";
				mes "^0099FF掉落物^000000：布料";
				mes "";
				next;
				mes "^FF0000[Vol. 7: Small Ghost Monsters]^000000";
				mes "2. Marionette";
				mes "作为被诅咒娃娃重生的怪物，";
				mes "被绑在连接木棍的绳子上。";
				mes "^0099FF掉落物^000000：金发、树干";
				mes "";
				next;
				break;
			case 2:
				mes "^FF0000[Vol. 8: Medium Ghost Monsters]^000000";
				mes "1. Eggyra";
				mes "奇怪的机器人蛋状生物，";
				mes "走路时摇摇摆摆。没人知道";
				mes "这些东西来自哪里。";
				mes "^0099FF掉落物^000000：Scell、黏稠液体、";
				mes "红色药草";
				mes "";
				mes "";
				next;
				break;
			case 3:
				mes "^FF0000[Vol. 9: Great Ghost Monsters]^000000";
				mes "1. Nightmare";
				mes "散发紫色邪恶气场的幽灵马。";
				mes "^0099FF掉落物^000000：马蹄铁、蓝色药草";
				mes "";
				mes "";
				next;
				mes "^FF0000[Vol. 9: Great Ghost Monsters]^000000";
				mes "2. Medusa";
				mes "头发由蛇组成的怪物。";
				mes "据说与她对视就会变成石头。";
				mes "^0099FF掉落物^000000：美杜莎头、可怕的";
				mes "头发、白色药草";
				mes "";
				mes "";
				next;
				break;
			case 4:
				close;
			}
		}
	case 4:
		close;
	}
}

prt_in,159,56,4	script	Monster Encyclopedia#2pr	HIDDEN_NPC,{
	mes "^FF0000[Monster Encyclopedia]^000000";
	mes "这是一本怪物百科，";
	mes "记录了地、火和无属性";
	mes "怪物的信息。";
	mes "";
	next;
	switch(select("地属性怪物:火属性怪物:无属性怪物:取消")) {
	case 1:
		while(1) {
			switch(select("小型怪物:中型怪物:大型怪物:取消")) {
			case 1:
				mes "^FF0000[Vol. 10: Small Earth Monsters]^000000";
				mes "1. Fabre";
				mes "Creamy的弱小幼虫。";
				mes "虽然有人说它可爱，";
				mes "但作者完全不同意。";
				mes "^0099FF掉落物^000000：羽毛、绒毛、绿色药草、四叶草";
				mes "";
				mes "";
				next;
				mes "^FF0000[Vol. 10: Small Earth Monsters]^000000";
				mes "2. Pupa";
				mes "Fabre的蛹阶段怪物。";
				mes "它完全不会攻击，初心者很容易击杀。";
				mes "^0099FF掉落物^000000：蛹、黏稠液体";
				mes "";
				mes "";
				next;
				mes "^FF0000[Vol. 10: Small Earth Monsters]^000000";
				mes "3. Martin";
				mes "戴着安全帽的可爱鼹鼠。";
				mes "它非常害怕塌方，偶尔会停下来";
				mes "因恐惧而发抖。";
				mes "^0099FF掉落物^000000：鼹鼠胡须、鼹鼠爪";
				mes "";
				next;
				mes "^FF0000[Vol. 10: Small Earth Monsters]^000000";
				mes "4. Savage Bebe";
				mes "小小的粉色幼年Savage。";
				mes "想到它长大后会变丑，真令人沮丧。";
				mes "^0099FF掉落物^000000：动物皮、肉、箭、羽毛";
				mes "";
				next;
				mes "^FF0000[Vol. 10: Small Earth Monsters]^000000";
				mes "5. Andre";
				mes "一种工蚁，Andre呈黄色，非常勤劳，";
				mes "会为蚁后收集眼前的一切。";
				mes "^0099FF掉落物^000000：虫皮、Garlet、";
				mes "黏稠液体、壳";
				mes "";
				mes "";
				mes "";
				next;
				mes "^FF0000[Vol. 10: Small Earth Monsters]^000000";
				mes "6. Coco";
				mes "眼神锐利的小松鼠。它总是拿着橡子，";
				mes "如果不是总露出鄙夷的表情，";
				mes "本来会很可爱。";
				mes "^0099FF掉落物^000000：橡子、绒毛、动物皮、";
				mes "红薯";
				mes "";
				mes "";
				next;
				mes "^FF0000[Vol. 10: Small Earth Monsters]^000000";
				mes "7. Piere";
				mes "Piere是绿色工蚁，";
				mes "与Andre略有不同。";
				mes "^0099FF掉落物^000000：虫皮、Garlet、黏稠液体、壳";
				mes "";
				mes "";
				next;
				mes "^FF0000[Vol. 10: Small Earth Monsters]^000000";
				mes "8. Smokie";
				mes "喜欢到处乱跑的胖乎乎小浣熊。";
				mes "据说它会用魔法叶子隐身！";
				mes "^0099FF掉落物^000000：浣熊叶、动物皮、红薯";
				mes "";
				mes "";
				next;
				mes "^FF0000[Vol. 10: Small Earth Monsters]^000000";
				mes "9. Deniro";
				mes "侍奉蚁后的红色工蚁。";
				mes "地上有任何东西，它们都会捡起来。";
				mes "^0099FF掉落物^000000：虫皮、Garlet、黏稠液体、壳";
				mes "";
				next;
				mes "^FF0000[Vol. 10: Small Earth Monsters]^000000";
				mes "10. Yoyo";
				mes "会捡起地上一切东西的淘气猴子。";
				mes "它们速度很快，如果你只攻击一只，";
				mes "其他的会成群围攻你。";
				mes "^0099FF掉落物^000000：Yoyo尾巴、香蕉、";
				mes "黄色药草、动物皮";
				mes "";
				next;
				mes "^FF0000[Vol. 10: Small Earth Monsters]^000000";
				mes "11. Vitata";
				mes "会治愈蚁群中其他蚂蚁的肥硕工蚁。";
				mes "被杀死时身体会渗出……蜂蜜？";
				mes "^0099FF掉落物^000000：虫皮、Scell、蜂蜜";
				mes "";
				mes "";
				next;
				mes "^FF0000[Vol. 10: Small Earth Monsters]^000000";
				mes "12. Caramel";
				mes "长着细小尖刺、可爱的豪猪。";
				mes "不过一旦被触碰，它会变得非常愤怒。";
				mes "^0099FF掉落物^000000：豪猪刺、动物皮";
				mes "";
				mes "";
				next;
				mes "^FF0000[Vol. 10: Small Earth Monsters]^000000";
				mes "13. 地灵";

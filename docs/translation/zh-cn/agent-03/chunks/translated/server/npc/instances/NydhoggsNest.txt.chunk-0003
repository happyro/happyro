man_in01,291,62,3	script	Laphine Prisoner#edq	437,3,3,{
	mes "[Laphine Prisoner]";
	if (isequipped(2782) == 1) {
		if (ins_nyd == 5) {
			mes "你……不是萨帕族……你是……异乡人？";
			next;
			mes "[Laphine Prisoner]";
			mes "你接触过拉菲内族吗？去过斯普兰迪德吗？";
			next;
			mes "[Laphine Prisoner]";
			mes "请和斯普兰迪德的族人谈谈。他们会来帮助我。";
			next;
			switch(select("你怎么了？:北边的洞穴里有什么？:告诉我你的部族。:我不打扰你了。")) {
			case 1:
				mes "[Laphine Prisoner]";
				mes "在上次与萨帕族的战斗中……他们抓住我，把我当成了俘虏。";
				next;
				mes "[Laphine Prisoner]";
				mes "是萨帕族先发动攻击。他们正在破坏世界树。";
				next;
				mes "[Laphine Prisoner]";
				mes "战争就是这样开始的。但我已经不想再和萨帕族战斗了……";
				next;
				mes "[Laphine Prisoner]";
				mes "要不是那样……我根本活不到现在……";
				next;
				mes "[Laphine Prisoner]";
				mes "求你了，把这个消息带回斯普兰迪德。派人来救我……否则他们可能会杀了我。";
				close;
			case 2:
				mes "[Laphine Prisoner]";
				mes "有……";
				next;
				mes "[Laphine Prisoner]";
				mes "不……我不能告诉你……这是我们族群的秘密……";
				next;
				mes "[Laphine Prisoner]";
				mes "我只想说……如果萨帕族闯入那里，我们永远不会原谅他们！";
				set ins_nyd,52;
				close;
			case 3:
				mes "[Laphine Prisoner]";
				mes "拉菲内族世代守护着尤格德拉希尔世界树。";
				next;
				mes "[Laphine Prisoner]";
				mes "我们生活在……不同的时代、不同的土地……这次是来探险的。";
				next;
				mes "[Laphine Prisoner]";
				mes "收到间谍关于世界树异常症状的报告后，我们发现了马努克族的存在。";
				next;
				mes "[Laphine Prisoner]";
				mes "他们开采金属，同时也破坏着世界树的根系……";
				next;
				mes "[Laphine Prisoner]";
				mes "所以我们派遣探险队来到这里。不久之后，与萨帕族的战争就开始了……";
				close;
			case 4:
				close;
			}
		} else if (ins_nyd == 92) {
			mes "萨帕族竟然和一个未知种族合作？";
			next;
			mes "[Laphine Prisoner]";
			mes "你的目的是什么？为什么想知道那里是什么地方？";
			next;
			mes "[Laphine Prisoner]";
			mes "没错……正如你猜测的，那是连接世界树的地方，也是守护者的巢穴。";
			next;
			select("守护者的巢穴？");
			mes "[Laphine Prisoner]";
			mes "是的，那就是世界树守护者尼德霍格的巢穴……";
			next;
			mes "[Laphine Prisoner]";
			mes "只有被守护者标记的拉菲内族侍从才获准进入。";
			next;
			mes "[Laphine Prisoner]";
			mes "那里原本不对公众开放，但萨帕族的巨人改变了这一切……";
			next;
			mes "[Laphine Prisoner]";
			mes "为了取得更多矿物，他们开始疯狂挖掘。";
			next;
			mes "[Laphine Prisoner]";
			mes "最终，他们损伤了矿场附近的一段世界树根系，世界树因此病得很重。";
			next;
			mes "[Laphine Prisoner]";
			mes "我们得知真相来到这里时，萨帕族建造的众多工厂已经让世界树陷入非常糟糕的状态。";
			next;
			mes "[Laphine Prisoner]";
			mes "虽然我们长期攻击萨帕族，试图逼他们离开，但他们并不容易击败，于是局面陷入僵持。";
			next;
			mes "[Laphine Prisoner]";
			mes "就在这段时间，你们的人穿过时空裂隙来到了这片土地。";
			next;
			mes "[Laphine Prisoner]";
			mes "由于这些意外，原本应该隐藏在地下深处的守护者巢穴被你们这个种族发现了……";
			next;
			mes "[Laphine Prisoner]";
			mes "现在你明白事态有多严重了。因为萨帕族，我们已经无法接近守护者，寻求他的智慧教诲。";
			next;
			mes "[Laphine Prisoner]";
			mes "哼……就算我不合作，我也知道你会想别的办法进去……";
			next;
			mes "[Laphine Prisoner]";
			mes "以拉菲内族目前的状况，我们没有足够力量包围马努克族的领地，把那些巨人赶走。";
			next;
			mes "[Laphine Prisoner]";
			mes "好吧，既然事情已经这样了，我会帮助你。没有走不通的路，只要继续前进，就能找到解决办法。";
			next;
			mes "[Laphine Prisoner]";
			mes "即使我什么都不说，我的处境也不会改变。";
			next;
			mes "[Laphine Prisoner]";
			mes "你想听的我已经全都告诉你了。如果还有其他要求，请告诉我。";
			set ins_nyd,102;
			close;
		} else if (ins_nyd == 102) {
			mes "啊，你说有一股奇怪的力量挡住了守护者巢穴的入口，对吧？";
			next;
			mes "[Laphine Prisoner]";
			mes "那是因为只有被守护者选中的人才能进入。";
			next;
			mes "[Laphine Prisoner]";
			mes "我们世代都是守护者的侍从，一直守护着世界树。";
			next;

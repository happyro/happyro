man_in01,311,57,3	script	Neat Etorr#edq	453,3,3,{
	mes "[Neat Etorr]";
	if (isequipped(2782) == 1) {
		if (ins_nyd == 52) {
			mes "来自异世界的客人，请原谅我们的无礼……";
			next;
			mes "[Neat Etorr]";
			mes "作为萨帕族首领，我有重要的事要告诉你，所以请你来这里……";
			next;
			mes "[Neat Etorr]";
			mes "你的种族不久前通过时空裂缝来到这片土地。";
			next;
			mes "[Neat Etorr]";
			mes "你应该已经看到发生了什么。我们与拉菲内族交战已久。";
			next;
			mes "[Neat Etorr]";
			mes "最近，由于不了解当前形势，你们做了一些我作为首领不能再忽视的事。";
			next;
			mes "[Neat Etorr]";
			mes "希望你们注意在这片土地上的行动，停止不必要的干涉。";
			next;
			if(select("安静离开。:不知道他说什么，询问详情。")==1) close;
			mes "[Manuk Field Elite Soldier]";
			mes "他们在我们的土地上制造麻烦后，我们真的就这样放他们走吗？";
			next;
			mes "[Neat Etorr]";
			mes "发生这些事后，我不认为他们知道还能做什么。让我解释。";
			next;
			mes "[Neat Etorr]";
			mes "目前我们承认你们的种族，并容忍你们的活动。";
			next;
			mes "[Neat Etorr]";
			mes "但最近我们开始怀疑你们是拉菲内族的耳目。";
			next;
			mes "[Neat Etorr]";
			mes "不久前听说你们在北方废弃洞穴发现遗骸，并对此展开调查研究。";
			next;
			mes "[Neat Etorr]";
			mes "上次战争中我们俘获了一名拉菲内族祭司，听说你们与这名俘虏有接触。";
			next;
			mes "[Neat Etorr]";
			mes "那名俘虏是我们族唯一的线索，因此我们妥善看管她。她与你们当前调查有关。";
			next;
			mes "[Neat Etorr]";
			mes "对与你们没有直接关系的人来说，这不是满足好奇心的地方。希望你们停止调查，管好自己的事。";
			next;
			mes "[Neat Etorr]";
			mes "如果不接受我们的请求，就别指望未来两族合作。";
			next;
			mes "[Neat Etorr]";
			mes "与拉菲内族的战争让一切混乱不堪，即便如此，我们也不能允许外族干涉。";
			next;
			mes "[Neat Etorr]";
			mes "你已经听完了，现在请回去向你的种族报告。";
			set ins_nyd,62;
			close;
		} else if (ins_nyd == 62) {
			mes "那个俘虏是我们族群唯一的线索，所以我们一直妥善照料她。她与你们正在调查的事情有关。";
			next;
			mes "[Neat Etorr]";
			mes "对与你们毫无直接关系的人来说，那里不是满足好奇心的地方。我希望你停止调查，管好自己的事。";
			next;
			mes "[Neat Etorr]";
			mes "如果你不接受我们的请求，就别指望今后两个种族还能合作。";
			close;
		} else if (ins_nyd == 72) {
			mes "最近，由于你不了解当前局势，做了一些身为领袖的我再也无法忽视的事情。";
			next;
			mes "[Neat Etorr]";
			mes "我希望你们注意在这片土地上的行为，停止一切不必要的干涉。";
			close;
		} else if (ins_nyd == 82) {
			mes "异乡人，你找我有什么事？";
			next;
			select("收到萨帕族邀请，合作调查。");
			mes "[Neat Etorr]";
			mes "合作调查？你是什么意思？";
			next;
			mes "[Neat Etorr]";
			mes "看来你没听懂我的话。你到底在想什么？";
			next;
			select("请允许我调查洞穴。");
			mes "[Neat Etorr]";
			mes "在我看来，你是在无视我的请求。这是你的意思，还是你们族群的意思？";
			next;
			select("这是我们的意图。");
			mes "[Neat Etorr]";
			mes "啊，这可不是个容易的决定。你让我害怕。";
			next;
			mes "[Neat Etorr]";
			mes "不过，我能问问你为什么想这样做吗？";
			next;
			select("说明放大镜教授的理论。");
			mes "[Neat Etorr]";
			mes "你能得到这样的结果真令人惊讶。我们也有类似的推测。";
			next;
			mes "[Neat Etorr]";
			mes "至少我们也认为，必须利用拉菲内俘虏来获取情报。";
			next;
			mes "[Neat Etorr]";
			mes "这个问题正是我们与拉菲内族冲突的根源。当然，也可能成为解决冲突的机会。";
			next;
			mes "[Neat Etorr]";
			mes "因此，我们更应该依靠自己的力量。这里没有你插手的余地。请放弃吧。";
			next;
			select("放弃请求，转而向拉法因族寻求帮助。");
			mes "[Manuk Field Elite Soldier]";
			mes "你终于露出真面目了。我就知道你是拉菲内族的间谍！";
			next;
			mes "[Neat Etorr]";
			mes "啊……你竟然说到这个份上。帮助拉菲内族对你有什么好处？";
			next;
			mes "[Neat Etorr]";
			mes "那些讨厌的矮人侵犯了我们的生存权，还想把我们赶走。";
			next;
			mes "[Neat Etorr]";
			mes "我们不允许任何人进入那里，是因为那地方充满疑点。";
			next;
			mes "[Neat Etorr]";
			mes "好吧，我批准你的请求，让你调查拉菲内族藏在洞穴里的秘密。";
			next;
			mes "[Neat Etorr]";
			mes "如果你答应分享所有研究结果和发现，我们就接受你的请求。";
			next;
			select("当然。");
			mes "[Neat Etorr]";
			mes "好，从现在起我们会与你合作，允许你直接与拉菲内俘虏交流。";
			next;
			mes "[Manuk Field Elite Soldier]";
			mes "指挥官……你确定吗？我们甚至不知道他们是敌是友……";
			next;
			mes "[Neat Etorr]";
			mes "仅凭我们的力量，无法弄清拉菲内族在谋划什么。我想过去已经证明了这一点。";
			next;
			mes "[Neat Etorr]";
			mes "他们现在的行动或许能为我们带来解决办法。";
			next;
			mes "[Neat Etorr]";
			mes "异乡人，希望我们的合作顺利。现在请去审问拉菲内俘虏。";
			set ins_nyd,92;
			close;
		} else if ((ins_nyd == 92) || (ins_nyd == 102) || (ins_nyd == 112) || (ins_nyd == 200) || (ins_nyd == 201) || (ins_nyd == 202)) {
			mes "异乡人，希望我们的合作顺利。现在请去审问拉菲内俘虏。";
			close;
		} else if ((ins_nyd == 71) || (ins_nyd == 81) || (ins_nyd == 91) || (ins_nyd == 101) || (ins_nyd == 111) || (ins_nyd == 121) || (ins_nyd == 131)) {
			mes "异乡人，欢迎来到萨帕族的村庄马努克。我是这里的代表Neat Etorr。";
			next;
			mes "[Neat Etorr]";
			mes "我们只是个普通的小村庄，没什么特别的……请安心休息。";
			close;
		} else if (ins_nyd == 203) {
			mes "我一直在等你。你平安就好。有什么发现吗？";
			next;
			select("说明守护者突然离开的原因。");
			mes "[Neat Etorr]";
			mes "原来如此……那就是世界树守护者的巢穴，也是拉菲内族的圣地。";
			next;
			mes "[Neat Etorr]";
			mes "但是因为守护者愤怒离去，他的影子正在世界树上肆虐？";
			next;
			mes "[Neat Etorr]";
			mes "如果你说的是真的，那我们就没有继续与拉菲内族战斗的理由了……";
			next;
			mes "[Neat Etorr]";
			mes "真是重大发现……所以尼德霍格已经不再是世界树守护者了？";
			next;
			mes "[Neat Etorr]";
			mes "尼德霍格的影子出现在这个世界，伤害了世界树的根……真是灾难。";
			next;
			select("传达世界树 Yggdrasil 的讯息。");
			mes "[Neat Etorr]";
			mes "这是守护者祭司说的吗？";
			next;
			mes "[Neat Etorr]";
			mes "接下来我们需要和拉菲内族谈谈这件事。";
			next;
			mes "[Neat Etorr]";
			mes "不过当然……我们还不知道他们是否讲道理……呵呵。";
			next;
			mes "[Neat Etorr]";
			mes "我们需要的就是这些……剩下的是我们与拉菲内族之间的事。";
			next;
			mes "[Neat Etorr]";
			mes "谢谢你帮助我们解决这么大的问题。现在你可以把它忘了。";
			next;
			mes "[Neat Etorr]";
			mes "虽然不多，但请收下这份谢意。";
			if (checkre(3))
				getexp 1500000,350000;
			else
				getexp 150000,35000;
			getitem 6080,10; //Manuk_Coin
			set ins_nyd,132;
			close;
		} else if (ins_nyd == 132) {
			mes "异乡人，谢谢你在危急时刻帮助我们。我永远不会忘记你的善意。";
			close;
		} else {
			mes "异乡人，欢迎来到萨帕族的马努克村庄。我是这里的代表Neat Etorr。";
			next;
			mes "[Neat Etorr]";
			mes "我们只是个普通的小村庄，没什么特别的……请安心休息。";
			close;
		}
	} else {
		mes "Tkeh likek Ohek QekhlHkl PkedlioH.";
		close;
	}
}


que_ng,28,50,3	script	Boshuu	709,{

	if (BaseClass != Job_Ninja){
		mes "[Boshuu]";
		mes "我是人们所称‘忍者工具三大工匠’中最优秀的工匠。";
		mes "他们叫我村田博秋。";
		next;
		mes "[Boshuu]";
		mes "我会制作东方世界的各种铠甲和盾牌，我的盾牌被认为是最好的。";
		next;
		mes "[Boshuu]";
		mes "不过看你是个外来者……";
		mes "看来我和你没什么好谈的。";
		mes "咳嗯～";
		close;
	}
	if (BaseLevel < 20){
		mes "[Boshuu]";
		mes "我为各个年龄的忍者制作最好的盾牌，";
		mes "但即使是我也有最低要求。";
		next;
		mes "[Boshuu]";
		mes "看来你需要的不是盾牌，而是更高的等级。";
		mes "再成长一些后回来吧。";
		close;
	}
	if (countitem(2102) < 1 && !(MISC_QUEST & 2048)){
		mes "[Boshuu]";
		mes "我是人们所称‘忍者工具三大工匠’中最优秀的工匠。";
		mes "他们叫我村田博秋。";
		next;
		mes "[Boshuu]";
		mes "虽然叫三大工匠，但另外两个大概是骗子。";
		mes "这个世界上没有比我更好的忍者工匠。";
		next;
		mes "[Boshuu]";
		mes "我会制作所有东方铠甲和盾牌。";
		next;
		mes "[Boshuu]";
		mes "因为我制作的铠甲太优秀、太坚固，两个穿着我制作的铠甲的人战斗时，谁也赢不了！";
		next;
		mes "[Boshuu]";
		mes "因此，我不再制作铠甲。";
		mes "如今我只收集铠甲，确保自己的技艺不会白费……";
		next;
		mes "[Boshuu]";
		mes "但我最近觉得很无聊。";
		next;
		mes "[Boshuu]";
		mes "现在只收集铠甲，我感觉体内的创作之火正在熄灭。";
		next;
		mes "[Boshuu]";
		mes "听说海外有一种我从没听说过的铠甲。";
		mes "好像叫……嗯……叫什么来着？";
		next;
		mes "[Boshuu]";
		mes "^ff0000Guard[1]^000000？嗯，好像是这个名字。";
		mes "我想亲眼看看实物。";
		next;
		mes "[Boshuu]";
		mes "不过很明显，和我制作的铠甲相比它大概一文不值。";
		next;
		mes "[Boshuu]";
		mes "帮我一个忙，我就为你做件特别的东西。";
		next;
		mes "[Boshuu]";
		mes "我还不知道要做什么，但我感觉看到那件铠甲后就会得到灵感。";
		mes "怎么样～你能帮我找一件 ^ff0000Guard[1]^000000 吗？";
		next;
		if(select("嗯……我不想做。:好吧。") == 1){
			mes "[Boshuu]";
			mes "啊～真遗憾……";
			mes "你错过了获得天才工匠亲手制作之物的机会……";
			close;
		}else{
			mes "[Boshuu]";
			mes "哦，好吧。";
			mes "快去吧。";
			mes "找到名为 ^ff0000Guard[1]^000000 的盾牌并带给我。";
			set ninbo,1;
			close;
		}
	}
	if (ninbo == 1){
		mes "[Boshuu]";
		mes "哦……你带来了吗？";
		mes "给我看看……";
		mes "嗯嗯嗯……";
		next;
		mes "[Boshuu]";
		mes "哦～！原来铠甲也能开洞！";
		next;
		mes "[Boshuu]";
		mes "啊，我现在迫不及待想仿制这件铠甲，给其他铠甲开洞了。";
		next;
		mes "[Boshuu]";
		mes "如果你有普通的无洞护臂和有洞的 Guard，我可以花费 10000 Zeny 把无洞护臂开洞。";
		next;
		mes "[Boshuu]";
		mes "怎么样？要试试吗？";
		next;
		if(select("不用了，谢谢。:好，听起来不错。") == 1){
			mes "[Boshuu]";
			mes "嗯，好吧。";
			mes "能看到海外如此稀有的东西，我非常感激。";
			mes "谢谢你的一切。";
			set ninbo,0;
			close;
		}else{
			mes "[Boshuu]";
			mes "哦，好。";
			mes "我已经等不及要开始了。";
			mes "如果你带来 1 个护臂，";
			mes "1 Slotted Guard, and";
			mes "10,000 Zeny..";
			next;
			mes "[Boshuu]";
			mes "我就能把无洞护臂开洞。";
			mes "材料齐全后再回来。";
			set ninbo,2;
			close;
		}
	}
	else if (ninbo == 2){
		if (countitem(2102) < 1 || countitem(2117) < 1){
			mes "[Boshuu]";
			mes "嗯……看来你带来的材料不够。";
			mes "制作有洞护臂需要 1 个有洞 Guard，";
			mes "1 Arm Guard, and 10,000 Zeny";
			mes "确定材料齐全后再回来。";
			close;
		}
		if (Zeny < 10000){
			mes "[Boshuu]";
			mes "嗯……材料很充足，但你的 Zeny 不够。";
			next;
			mes "[Boshuu]";
			mes "制作有洞护臂需要 1 个 Guard[1]，";
			mes "1 Arm Guard, and 10,000 Zeny.";
			mes "确定材料齐全后再回来。";
			close;
		}
		mes "[Boshuu]";
		mes "哦，看来你带齐材料回来了。";
		mes "不过开始前，我必须再问一次。";
		mes "你要把带来的材料交给我，换取有洞护臂吗？";
		next;
		if(select("不:是") == 1){
			mes "[Boshuu]";
			mes "好吧。";
			mes "如果你改变主意，再来找我。";
			close;
		}else{
			mes "[Boshuu]";
			mes "好！";
			mes "马上就好。";
			mes "砰锵～砰锵～";
			next;
			if(countitem(2102) < 1 || countitem(2117) < 1 || Zeny < 10000){
				mes "HACK DETECTED";
				close;
			}
			mes "[Boshuu]";
			mes "好了，终于完成了。";
			mes "这是给你的有洞护臂。";
			mes "准备好制作更多物品时，随时来找我。";
			delitem 2102,1;
			delitem 2117,1;
			set Zeny,Zeny-10000;
			set ninbo,0;
			set MISC_QUEST,MISC_QUEST | 2048;
			getitem 2118,1;
			close;
		}
	}
	else if (MISC_QUEST & 2048){
		set ninbo,0;
		mes "[Boshuu]";
		mes "哦～看来你回来了。";
		mes "是因为你还需要一件有洞护臂吗？";
		next;
		if(select("不，不是。:是的，再做一件。") == 1){
			mes "[Boshuu]";
			mes "哼～你真奇怪。";
			mes "那以后再见～";
			close;
		}else{
			if (countitem(2102) < 1 || countitem(2117) < 1){
				mes "[Boshuu]";
				mes "嗯……看来你带来的材料不够。";
				mes "制作有洞护臂，";
				mes "我需要 1 个有洞 Guard，";
				mes "1 Arm Guard, and";
				mes "10,000 Zeny.";
				mes "确定材料齐全后再回来。";
				close;
			}
			if (Zeny < 10000){
				mes "[Boshuu]";
				mes "嗯……材料很充足，但你的 Zeny 不够。";
				next;
				mes "[Boshuu]";
				mes "制作一件有洞护臂，";
				mes "我需要 1 个有洞 Guard、1 个护臂和 10000 Zeny。";
				mes "确定材料齐全后再回来。";
				close;
			}
			mes "[Boshuu]";
			mes "哦，你带来了所需材料。";
			mes "开始前，让我最后问一次……";
			mes "你愿意交出收集的材料，换取有洞护臂吗？";
			next;
			if(select("不:是") == 1){
				mes "[Boshuu]";
				mes "好吧。";
				mes "如果你改变主意，";
				mes "再来找我。";
				close;
			}else{
				mes "[Boshuu]";
				mes "好！";
				mes "马上就好。";
				mes "砰锵～砰锵～";
				next;
				mes "[Boshuu]";
				mes "好了，终于完成了。";
				mes "这是给你的有洞护臂。";
				next;
				if(countitem(2102) < 1 || countitem(2117) < 1 || Zeny < 10000){
					mes "HACK DETECTED";
					close;
				}
				mes "[Boshuu]";
				mes "想让我制作更多物品时，随时欢迎回来。";
				delitem 2102,1;
				delitem 2117,1;
				set Zeny,Zeny-10000;
				getitem 2118,1;
				close;
			}
		}
	}
	else{
		set ninbo,0;
		mes "[Boshuu]";
		mes "哦～是你～！";
		mes "你拿的是海外叫 Guard 的盾牌吗？让我看看。";
		next;
		mes "[Boshuu]";
		mes "难以置信！！真的是～！";
		mes "如果所有盾牌都有洞，就能比以往更有效。";
		mes "我怎么现在才意识到？";
		next;
		mes "[Boshuu]";
		mes "我是忍者工具三大工匠中最优秀的村田博秋。";
		mes "我会制作东方世界的所有铠甲和盾牌。";
		next;
		mes "[Boshuu]";
		mes "但因为我制作的铠甲太精良、防御太高，穿着我的铠甲战斗时，双方都无法获胜。";
		next;
		mes "[Boshuu]";
		mes "因此，我不再制作盾牌和铠甲。";
		next;
		mes "[Boshuu]";
		mes "如今我只收集盾牌和铠甲。";
		next;
		mes "[Boshuu]";
		mes "不过不制作东西的生活有点无聊。";
		next;
		mes "[Boshuu]";
		mes "现在只做收集，我感觉体内的创作精神正在消失。";
		next;
		mes "[Boshuu]";
		mes "但看到你的盾牌，我感觉沉睡的创作精神苏醒了。";
		next;
		mes "[Boshuu]";
		mes "如果你愿意，带来护臂、有洞 Guard 和 10000 Zeny，我就为你制作有洞护臂。";
		mes "怎么样？想要一件有洞护臂吗？";
		next;
		if(select("不，我还是不要了。:是～！！请为我制作！") == 1){
			mes "[Boshuu]";
			mes "嗯，是这样吗？";
			mes "真遗憾……";
			mes "如果以后改变主意，再回来找我。";
			close;
		}else{
			if (countitem(2102) < 1 || countitem(2117) < 1){
				mes "[Boshuu]";
				mes "嗯……看来你带来的材料不够。";
				next;
				mes "[Boshuu]";
				mes "制作有洞护臂，";
				mes "我需要 1 个有洞 Guard、";
				mes "1 个护臂和";
				mes "10000 Zeny。";
				mes "确定材料齐全后再回来。";
				close;
			}
			if (Zeny < 10000){
				mes "[Boshuu]";
				mes "嗯……材料很充足，但你的 Zeny 不够。";
				next;
				mes "[Boshuu]";
				mes "制作有洞护臂，";
				mes "我需要 1 个有洞 Guard、";
				mes "1 个护臂和";
				mes "10000 Zeny。";
				mes "确定材料齐全后再回来。";
				close;
			}
			mes "[Boshuu]";
			mes "哦，你带来了所需材料。";
			mes "开始前，让我最后问一次……";
			mes "你愿意交出收集的材料，";
			mes "换取有洞护臂吗？";
			next;
			if(select("不:是") == 1){
				mes "[Boshuu]";
				mes "好吧。";
				mes "如果你改变主意，";
				mes "再来找我。";
				close;
			}else{
				mes "[Boshuu]";
				mes "好！";
				mes "马上就好。";
				mes "砰锵～砰锵～";
				next;
				if(countitem(2102) < 1 || countitem(2117) < 1 || Zeny < 10000){
					mes "HACK DETECTED";
					close;
				}
				mes "[Boshuu]";
				mes "好了，终于完成了。";
				mes "这是给你的有洞护臂。";
				mes "想让我制作更多物品时，随时欢迎回来。";
				delitem 2102,1;
				delitem 2117,1;
				set Zeny,Zeny-10000;
				set MISC_QUEST,MISC_QUEST | 2048;
				getitem 2118,1;
				close;
			}
		}
	}
}

que_ng,28,45,3	script	Basshu	86,{

	if(BaseClass != Job_Ninja){
		mes "[Basshu]";
		mes "我是负责制作东方盾牌的三兄弟之一，名叫村田巴修。";
		next;
		mes "[Basshu]";
		mes "人们通常称我们为三大工匠，另外两位工匠是我的兄弟。";
		next;
		mes "[Basshu]";
		mes "不过你似乎不是我的常客类型，所以我不能为你制作盾牌。";
		mes "抱歉。";
		close;
	}
	if(BaseLevel < 50){
		mes "[Basshu]";
		mes "我是负责制作东方盾牌的三兄弟之一，名叫村田巴修。";
		next;
		mes "[Basshu]";
		mes "遗憾的是，我的许多盾牌都有最低要求，恐怕你还达不到。";
		next;
		mes "[Basshu]";
		mes "变强后再回来吧。";
		close;
	}
	if (countitem(2107) < 1 && !(MISC_QUEST & 4096)){
		mes "[Basshu]";
		mes "我是负责制作东方盾牌的三大工匠之一，名叫村田巴修。";
		next;
		mes "[Basshu]";
		mes "我们被称为三大工匠，另外两位工匠是我的兄弟。";
		mes "我偷看兄弟们学习技艺，所以本领稍逊于他们，但很多人都高度评价我。";
		next;
		mes "[Basshu]";
		mes "现在我已经放弃制作盾牌，经营着一家盾牌古董店。";
		mes "我正在研究能否用魔法为盾牌附魔。";
		next;
		mes "[Basshu]";
		mes "你知道海外有一种叫镜盾的盾牌吗？";
		mes "我很想看看，但一直弄不到。";
		next;
		mes "[Basshu]";
		mes "如果能近距离看看那面盾牌，对我帮助很大。";
		mes "你能帮我吗？";
		next;
		if(select("嗯……我不想做。:好吧。") == 1){
			mes "[Basshu]";
			mes "啊～看来这是个不可能的请求。";
			mes "抱歉。";
			mes "如果你找到镜盾又想处理掉，请来找我。";
			close;
		}else{
			mes "[Basshu]";
			mes "哦，谢谢你。";
			mes "如果你真的能找到镜盾，我也许会得到很棒的灵感。";
			set ninbot,1;
			close;
		}
	}
	if (ninbot == 1){
		mes "[Basshu]";
		mes "哦，你拿到了？";
		mes "让我看看……";
		mes "嗯……";
		next;
		mes "[Basshu]";
		mes "哦！就是它！这证明制作抵抗魔法攻击的盾牌并非不可能。";
		mes "呼……";
		next;
		mes "[Basshu]";
		mes "这真让我兴奋。";
		mes "如果你有普通护臂，就把护臂带来，然后……";
		next;
		mes "[Basshu]";
		mes "1 Mirror Shield, and";
		mes "20,000 Zeny, and I'll improve your Arm Guard into an Improved Arm Guard.";
		next;
		mes "[Basshu]";
		mes "怎么样？你想要吗？";
		next;
		if(select("不想要。:想要。") == 1){
			mes "[Basshu]";
			mes "嗯，好吧。";
			mes "谢谢你让我看到海外的稀有盾牌。";
			next;
			mes "[Basshu]";
			mes "谢谢你的一切。";
			set ninbot,0;
			close;
		}else{
			mes "[Basshu]";
			mes "好吧。";
			mes "我很期待。";
			next;
			mes "[Basshu]";
			mes "带给我 1 个护臂，";
			mes "1 Mirror Shield, and";
			mes "20,000 Zeny,";
			mes "我就为你制作改良护臂。";
			next;
			mes "[Basshu]";
			mes "准备好一切后再来找我。";
			set ninbot,2;
			close;
		}
	}
	else if (ninbot == 2){
		if(countitem(2107) < 1 || countitem(2117) < 1){
			mes "[Basshu]";
			mes "嗯……看来材料不够。";
			mes "制作改良护臂，我需要……";
			mes "1 Mirror Shield, 1 Arm Guard";
			mes "以及 20000 Zeny。";
			mes "材料齐全后再来。";
			close;
		}
		if(Zeny < 20000){
			mes "[Basshu]";
			mes "嗯……材料很充足，但你的 Zeny 不够。";
			mes "制作改良护臂，我需要……";
			mes "1 Mirror Shield, 1 Arm Guard";
			mes "以及 20000 Zeny。";
			mes "材料齐全后再来。";
			close;
		}
		mes "[Basshu]";
		mes "正确的材料";
		mes "已经收集齐了。";
		mes "开始之前，";
		mes "我最后再问一次。";
		next;
		mes "[Basshu]";
		mes "作为提升护臂魔法防御的代价，盾牌抵挡物理攻击的能力可能会降低。";
		next;
		mes "[Basshu]";
		mes "你愿意把收集的材料交给我";

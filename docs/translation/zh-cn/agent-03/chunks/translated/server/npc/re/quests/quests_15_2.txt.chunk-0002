		next;
		cutin "verus_ian02.bmp",2;
		mes "[Ian Atnad]";
		mes "什么？！Verus！！！";
		mes "所以我当时找到的是通往 Verus 的通道？！";
		next;
		cutin "Arquien_n_atnad02.bmp",0;
		mes "[Arquien]";
		mes "不，不，等等。";
		mes "父亲，和我说一会儿。";
		mes "我只需要一点时间。";
		next;
		mes "我不知道发生了什么。";
		mes "我们应该先听听 Atnad 家族的说法吗？";// cross line?
		ep15_1_atnad = 32;
		close3;
	}
	if (ep15_1_atnad == 32) {
		cutin "ep15_rekenber02.bmp",0;
		mes "[Rekenber Chairman]";
		mes "……我们能怎么办。";
		mes "我们会等。请说吧。";
		close3;
	}
	cutin "ep15_rekenber01.bmp",0;
	mes "[Rekenber Chairman]";
	mes "会长在这种时候什么都不做才是本职。";
	mes "……就是这样。";
	close3;
}

lhz_in01,267,257,5	script	Chief Secretary#e152i01	4_M_TATIO,{
	if (ep15_1_atnad < 31) {
		cutin "ep15_tatio01.bmp",0;
		mes "[Chief Secretary]";
		mes "....";
		close3;
	}
	if (ep15_1_atnad == 31) {
		mes "[Chief Secretary]";
		cutin "ep15_tatio01.bmp",0;
		mes "会长已经等了很久。";
		mes "我也是。";
		close3;
	}
	if (ep15_1_atnad == 32) {
		mes "[Chief Secretary]";
		cutin "ep15_tatio01.bmp",0;
		mes "你吓了一跳吗？";
		mes "我也是。我没想到人们的命运会如此交织。";
		mes "总之，那位年轻女士……";
		next;
		cutin "ep15_tatio03.bmp",0;
		mes "[Chief Secretary]";
		mes "……态度很强硬。";
		mes "没错。";
		mes "请说。";
		mes "我会等着。";
		close3;
	}
	if (ep15_1_atnad == 33) {
		mes "[Chief Secretary]";
		cutin "ep15_tatio01.bmp",0;
		mes "看来又轮到我了。";
		mes "我来正式介绍你。";
		mes "Verus 城市的最后幸存者，Tatio.W.00H-1。";
		mes "叫他 Tatio 就好。";
		next;
		npctalk "What?!", "Ian Atnad#ep152i01";
		mes "[Tatio]";
		mes "公司没有公开记忆记录的内容。";
		mes "我在朱佩洛斯攻击你，完全是因为我想这么做。";
		next;
		cutin "ep15_tatio02.bmp",0;
		mes "[Tatio]";
		mes "要告诉你这些，我只能公开身份。";
		mes "我已经为此做好准备，但……感觉并不好。";
		next;
		cutin "",255;
		mes "所有人似乎都被这个惊人消息冻结了。";
		next;
		cutin "ep15_tatio01.bmp",0;
		mes "[Tatio]";
		mes "我就是你们发现的记忆记录中的 Tatio。";
		mes "而 Atnad 就是 Lasse Atnad，Atnad 博士的曾祖父。";
		next;
		cutin "ep15_tatio03.bmp",0;
		mes "[Tatio]";
		mes "Lasse 是创造我的人之一，也是我的朋友。";
		mes "我想保护 Verus，那是我不死机械身体的家……";
		next;
		mes "[Tatio]";
		mes "当时我做了那件失礼的事。";
		mes "除此之外，我还参与隐藏了医生看到的事情……";
		mes "我稍微篡改了他的记忆。";
		next;
		cutin "ep15_tatio01.bmp",0;
		mes "[Tatio]";
		mes "所以你才会有那一周的记忆空白。";
		mes "我照顾了你四天，然后把你送到朱诺的旅馆。";
		next;
		cutin "ep15_tatio02.bmp",0;
		mes "[Tatio]";
		mes "如果知道你是 Lasse 的后代，我就不会这么做。";
		next;
		cutin "ep15_tatio01.bmp",0;
		mes "[Tatio]";
		mes "很久……很久以前，Verus 城曾与朱佩洛斯并肩存在……";
		mes "它曾凭借科学文明成为伟大的科学城市。";
		next;
		mes "[Tatio]";
		mes "但一场不幸的事故让它变成了现在这样。";
		mes "因为我是机械制造的，所以没有死，只是一直守望着 Verus。";
		next;
		cutin "verus_ian01.bmp",2;
		mes "[Ian Atnad]";
		mes "这个故事，会长知道吗？";
		mes "等等。我敢说他已经知道了。难道不是因为这个才叫我们来吗？";
		next;
		cutin "ep15_tatio01.bmp",0;
		mes "[Tatio]";
		mes "没错。";
		mes "会长知道我的存在，也知道 Verus 城的秘密。";
		mes "全世界只有两个人知道这个秘密。";
		next;
		mes "[Tatio]";
		mes "啊，不对。创始人之一 Janet Zerter 也知道。";
		mes "她也是 Verus 城的后代之一。";
		next;
		cutin "ep15_tatio02.bmp",0;
		mes "[Tatio]";
		mes "……现在明白我之前的提议了吗？";
		next;
		cutin "verus_ian01.bmp",2;
		mes "[Ian Atnad]";
		mes "哦，哦，好吧……";
		mes "虽然已经公开，但你仍想保护 Verus 城……我明白了。";
		mes "所以记忆记录……";
		next;
		mes "[Ian Atnad]";
		mes "那这不适用于城市中的其他数据吗？";
		mes "你想隐藏它，是为了避免你和我的名字曝光、成为公众话题，对吧？";
		next;
		cutin "ep15_tatio01.bmp",0;
		mes "[Tatio]";
		mes "不适合这个世界文明的量子级核心技术已经被丢弃。";
		mes "就像不会把致命武器交给孩子。";
		next;
		mes "[Tatio]";
		mes "虽然大部分数据已经意外丢失……";
		mes "但仅凭剩下的数据，你也会收获很多。";
		next;
		cutin "verus_ian01.bmp",2;
		mes "[Ian Atnad]";
		mes "你为什么公开它？";
		mes "你本该把它严密隐藏。";
		mes "就像你对我做的那样。";
		next;
		cutin "ep15_tatio01.bmp",0;
		mes "[Tatio]";
		mes "..To be honest, the first reason is that I could not easily approach the laboratories because of the energy storms during the time";
		next;
		mes "[Tatio]";
		mes "而且，虽然我不知道能量风暴消失的原因，";
		mes "但我判断它并没有太危险。";
		next;
		mes "[Tatio]";
		mes "公开的时机已经到了。";
		mes "这个地方也已经开始理解科学与工程。";
		next;
		cutin "verus_ian01.bmp",2;
		mes "[Ian Atnad]";
		mes "……有些可疑，但好吧。";
		mes "我想能有这样的机会，我就该满足了。";
		next;
		cutin "ep15_tatio01.bmp",0;
		mes "[Tatio]";
		mes "谢谢你的理解。";
		mes "我会把记忆记录的唯一权利交给你。";
		mes "但信息公开与公开时机必须在这里决定。";
		next;
		mes "[Tatio]";
		mes "而且……为了避免影响我们的后代，";
		mes "我们也应该把它作为我们之间的秘密。";
		next;
		cutin "verus_ian01.bmp",2;
		mes "[Ian Atnad]";
		mes "我明白。";
		mes "那么我会像之前一样负责收集记忆记录。";
		mes "我会决定是否通过你直接报告。";
		next;
		mes "[Ian Atnad]";
		mes "就是这样，对吧？";
		next;
		cutin "ep15_tatio01.bmp",0;
		mes "[Tatio]";
		mes "没错。";
		mes "实际上工作本身没有太大变化。";
		mes "啊，还有……";
		mes "作为 Atnad 挖掘队的成员勤奋工作……";
		mes "" + strcharinfo(0) + " I will give you a small reward.";
		getexp 4500000,3000000;
		ep15_1_atnad = 34;
		next;
		mes "[Tatio]";
		mes "记忆记录的内容对我来说是珍贵的记忆。";
		mes "……就像翻阅我的日记。所以希望你今后小心处理。";
		close3;
	}
	cutin "ep15_tatio03.bmp",0;
	mes "[Tatio]";
	mes "……希望一切顺利……";
	close3;
}

lhz_in01,272,255,3	script	Ian Atnad#ep152i01	4_M_IAN,{
	if (ep15_1_atnad < 31)
		end;
	mes "[Ian Atnad]";
	if (ep15_1_atnad == 31) {
		cutin "verus_ian01.bmp",2;
		mes "你现在到了吗？";
		mes "看来大家都到齐了。";
		mes "那么，让我们听听你想对大家说什么。";
		close3;
	}
	if (ep15_1_atnad == 32) {
		cutin "verus_ian01.bmp",2;
		mes "那么，你想说什么？";
		mes "你为什么在这个重要时刻打断我？";
		next;
		cutin "Arquien_n_atnad01.bmp",0;
		mes "[Arquien]";
		mes "那个人刚才说的，是你失踪的事件吗？";
		mes "就是你多年来在外面到处奔波的原因。";
		next;
		cutin "ep15_tatio01.bmp",0;
		mes "[Chief Secretary]";
		mes "不……不是那样……";
		mes "我和医生在一起的时间只有四天。";
		next;
		cutin "Arquien_n_atnad04.bmp",0;
		mes "[Arquien]";
		mes "你之前说自己被困在某处一周！";
		mes "还像被鬼附身一样到处乱跑！";
		next;
		cutin "verus_ian01.bmp",2;
		mes "[Ian Atnad]";
		mes "那……那是……！";
		mes "别把我对研究领域的热情说成像鬼上身一样乱跑！";
		mes "当时我以为自己会找到曾祖父的某些线索……";
		next;
		mes "[Ian Atnad]";
		mes "我看到的地方……我对那个地方的记忆……";
		mes ".....";
		mes "...?";
		next;
		mes "[Ian Atnad]";
		mes "等一下。你现在是在责怪我吗？";
		mes "我给家里寄了信，是你没有回信！";
		next;
		cutin "Arquien_n_atnad04.bmp",0;
		mes "[Arquien]";
		mes "所有信都因为地址不清被退回来了！";
		mes "你凭什么说大话！";
		next;
		cutin "verus_ian03.bmp",2;
		mes "[Ian Atnad]";
		mes "而且不是你卖掉房子，把我的信都退回来的吗！";
		mes "你就不能等几年吗，为什么卖掉房子消失？！";
		mes "你还有什么可辩解的！";
		next;
		mes "父女之间的争吵让局势越来越激烈。";
		mes "Aures 和秘书露出尴尬的表情。";
		next;
		select("要不要把桌子掀翻？");
		cutin "Arquien_n_atnad01.bmp",0;
		mes "[Arquien]";
		mes "那是什么声音……";
		mes "总……总之，那个秘书不是这件事的主要煽动者吗？";
		mes "发生了什么？";
		ep15_1_atnad = 33;
		close3;
	}
	if (ep15_1_atnad == 33) {
		cutin "verus_ian01.bmp",2;
		mes "我们一直在偏离重点。";
		mes "你不该先问他为什么攻击我吗？";
		mes "请先听听他要说什么。女儿。";
		close3;
	}
	cutin "verus_ian01.bmp",2;
	mes "一下听到这么惊人的故事确实令人困惑，但";
	mes "同时也让人如释重负。";
	mes "嗯……我明白了。我明白了。";
	close3;
}


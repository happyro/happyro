// Part 3 : Vestige - ep15_2_underbs
verus01,221,65,5	script	Du#Verus	4_M_REDMAN,{
	if (ep15_1_atnad < 19)	// extra check
		end;
	mes "[Du]";
	if (ep15_2_bslast < 2) {
		if (ep15_1_elb < 15) {
			mes "调查应该冷静进行……";
			cutin "bu_du3.bmp",2;
			close3;
		}
		if (ep15_2_bslast == 0) {
			mes "这不是一团糟吗？";
			mes "呼，差点进不来！";
			mes "我讨厌这些访问协议。";
			cutin "bu_du3.bmp",2;
			next;
			mes "[Mark]";
			mes "我认为这是安全所需的必要协议。";
			cutin "bu_mark3.bmp",0;
			next;
			mes "[Du]";
			mes "你们看这个！";
			cutin "bu_du2.bmp",2;
			next;
			mes "[Du]";
			mes "这不是一团糟吗？";
			next;
			mes "[Mark]";
			mes "嘿……";
			mes "你刚才不是说过了吗？";
			cutin "bu_mark3.bmp",0;
			next;
			mes "[Alph]";
			mes "嘿。";
			mes "别管那个了，我们开始调查吧。";
			cutin "bu_alp1.bmp",2;
			next;
			mes "[Tamarin]";
			mes "顺便说，我想我知道为什么只有这里被封锁。";
			cutin "ep143_tasta.bmp",2;
			next;
			mes "[Tamarin]";
			mes "这里没有完整的建筑，地面的裂缝也比其他区域严重得多……";
			next;
			mes "[Tamarin]";
			mes "更不用说这些怪物了……";
			cutin "ep143_tahuk.bmp",2;
			next;
			mes "[Tamarin]";
			mes "它们似乎只在这里出现，所以一定有问题……";
			next;
			mes "[Du]";
		}
		mes "没错！";
		mes "我们的工作就是调查这个！";
		cutin "bu_du2.bmp",2;
		next;
		mes "[Alph]";
		mes "话说回来，刚才路过的人说中央有一台不可思议的装置……";
		cutin "bu_alp3.bmp",2;
		next;
		mes "[Mark]";
		mes "那么我们先调查那里。";
		cutin "bu_mark1.bmp",0;
		if (ep15_2_bslast == 0) {
			setquest 11381;// Vestige
			ep15_2_bslast = 1;
		}
		close3;
	}
	mes "调查应该冷静进行……";
	cutin "bu_du3.bmp",2;
	close3;
}

verus01,151,173,3	script	Fruit#Verus	4_F_FRUIT,{
	if (ep15_2_bslast < 2) {
		mes "[Fruit]";
		mes "太酷了！！！！";
		mes "看到了吗？";
		mes "就是这里！！！！";
		cutin "EP15_2_fru_2.bmp",2;
		next;
		mes "[Fruit]";
		mes "看起来像是有什么东西会旋转起来，对吧？！";
		mes "哈啊！";
		if (ep15_2_bslast == 0)
			close3;
		next;
		mes "[Fruit]";
		mes "真希望能把整个东西带回我的实验室！";
		mes "我只能在这里旁观……";
		cutin "EP15_2_fru_3.bmp",2;

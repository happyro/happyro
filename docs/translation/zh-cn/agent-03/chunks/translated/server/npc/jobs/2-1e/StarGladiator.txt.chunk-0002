			mes "[茂冈]";
			mes "带来……";
			mes "^4D4DFF粗糙的风^000000、";
			mes "^4D4DFF大地的祝福^000000、";
			mes "^4D4DFF神秘冰块^000000和";
			mes "^4D4DFF火焰心脏^000000。";
			mes "现在去吧……";
			close;
		}
		else if (STGL_Q == 3) {
			mes "[Moogang]";
			mes "你准备好参加下一项";
			mes "跆拳大师测试了吗？那么，";
			mes "我会带你去祭坛。";
			mes "请跟我来。";
			next;
			if (select("等等，我还需要时间！:是的，我准备好了。") == 1) {
				mes "[Moogang]";
				mes "我明白了。那么，准备继续时";
				mes "请告诉我。";
				mes "我会等你。";
				close;
			}
			mes "[Moogang]";
			mes "到了祭坛后，和达鲁交谈，";
			mes "他会指导你的测试。";
			mes "完成测试后，再回来找我。";
			mes "请记住流程。";
			mes "不要错过测试。";
			close2;
			warp "job_star",34,12;
			end;
		}
		else if (STGL_Q > 3 && STGL_Q < 7) {
			mes "[Moogang]";
			mes "真奇怪……";
			mes "你不可能已经完成";
			mes "那项测试。啊，一定发生了什么。";
			mes "我会把你送回祭坛，";
			mes "让达鲁测试你。";
			mes "请重新开始。";
			close2;
			warp "job_star",34,12;
			end;
		}
		else if (STGL_Q == 7) {
			mes "[Moogang]";
			mes "嗯……";
			mes "你似乎很烦恼。";
			mes "啊，你一定在思考";
			mes "比利尤的谜语，对吧？";
			mes "只有你能";
			mes "找到答案……";
			next;
			mes "[Moogang]";
			mes "嗯。也许你最好";
			mes "回到斐扬咨询";
			mes "^4D4DFF茂言^000000，";
			mes "这样就能理解";
			mes "比利尤关于耐心价值的";
			mes "测试。";
			next;
			mes "[Moogang]";
			mes "找到比利尤希望你发现的";
			mes "耐心含义后，";
			mes "回来找我，";
			mes "我会把你送回";
			mes "月之房间接受测试。";
			mes "请不要忘记。";
			close;
		}
		else if (STGL_Q == 8) {
			mes "[Moogang]";
			mes "啊，我看出茂言";
			mes "帮助你达到了";
			mes "新的理解层次。";
			mes "很好，很好。让我";
			mes "把你送到比利尤";
			mes "正在等待的月之房间……";
			close2;
			warp "job_star",100,13;
			end;
		}
		else if (STGL_Q == 9 || STGL_Q == 11) {
			mes "[Moogang]";
			mes "你想回到星之房间";
			mes "完成跆拳大师";
			mes "的测试和训练吗？";
			mes "请做好准备。";
			next;
			if (select("好的。:稍后再说。") == 1) {
				mes "[Moogang]";
				mes "不要灰心……";
				mes "我相信你很快就能";
				mes "实现成为";
				mes "跆拳大师的目标。";
				mes "请继续努力。";
				close2;
				warp "job_star",166,29;
				end;
			}
			mes "[Moogang]";
			mes "我明白了。那么，当你的";
			mes "身心与精神准备好后，";
			mes "请再来和我交谈。";
			mes "我会等你。";
			close;
		}
		else if (STGL_Q == 10) {
			mes "[Moogang]";
			mes "啊，你来这里是为了";
			mes "和芝熙交谈。";
			mes "要我现在把你送到";
			mes "星之房间吗？";
			next;
			if (select("好的。:稍后再说。") == 1) {
				mes "[Moogang]";
				mes "不要灰心……";
				mes "我相信你很快就能";
				mes "实现成为";
				mes "跆拳大师的目标。";
				mes "请继续努力。";
				close2;
				warp "job_star",166,29;
				end;
			}
			mes "[Moogang]";
			mes "我明白了。那么，当你的";
			mes "身心与精神准备好后，";
			mes "请再来和我交谈。";
			mes "我会等你。";
			close;
		}
		else if (STGL_Q == 12) {
			mes "[Moogang]";
			mes "啊，你回来了，";
			mes "比以前更聪明，也更";
			mes "懂得与自然相处。";
			mes "是的，我从你眼中看到了。";
			mes "告诉我，你学到了什么？";
			next;
			mes "[" + strcharinfo(0) + "]";
			mes "我能感受到太阳、月亮和";
			mes "星星之间的联系。它们都发光，";
			mes "但不同的光芒";
			mes "会带来不同的恩赐。";
			mes "我理解了它们。";
			next;
			mes "[" + strcharinfo(0) + "]";
			mes "太阳给予辉煌的温暖，";
			mes "是生命的源泉。月光温柔，带来安慰。星星的闪烁";
			mes "即使在最黑暗的夜晚";
			mes "也能带来希望。";
			mes "这就是它们的力量。";
			next;
			mes "[" + strcharinfo(0) + "]";
			mes "我也知道太阳";
			mes "灼热而毁灭性的热量，";
			mes "月亮的孤独，";
			mes "以及星星的悲伤。现在我理解了";
			mes "宇宙的光谱！";
			mes "我会铭记这一切。";
			next;
			mes "[" + strcharinfo(0) + "]";
			mes "宇宙汇聚的愤怒";
			mes "可以召唤绝对黑暗的";
			mes "恶魔。宇宙汇聚的爱";
			mes "则带来无限的祝福";
			mes "与光芒……";
			mes "请谨记平衡。";
			next;
			mes "[Moogang]";
			mes "我没有更多要求了。你";
			mes "已经是太阳、月亮和";
			mes "星星的战士。欢迎朋友，";
			mes "加入我们的武术之道。";
			mes "愿你继续前进。";
			mes "祝你好运。";
			completequest 7011;
			callfunc "Job_Change",Job_Star_Gladiator;
			callfunc "F_ClearJobVar";		//clears all job variables for the current player
			next;
			mes "[Moogang]";
			mes "从现在起，请非常";
			mes "谨慎地做决定。你的决定";
			mes "会决定整个人生的道路。还有，";
			mes "永远不要忘记这首歌……";
			mes "请牢记它。";
			mes "这是我们的教诲。";
			next;
			mes "[Moogang]";
			mes "''^4D4DFFThe Sun shines on even days.";
			mes "月亮在奇数日闪耀。";
			mes "星星每逢第五天";
			mes "必定闪烁。^000000''";
			next;
			mes "[Moogang]";
			mes "我能分享的就这些。";
			mes "永远不要忘记，作为跆拳大师，";
			mes "我们不能脱离太阳、月亮和";
			mes "星星而存在……";
			mes "请牢记这一点。";
			close;
		}
		mes "[Moogang]";
		mes "哦，你好。你是";
		mes "跆拳道学生，对吗？";
		mes "很高兴见到你。请叫我";
		mes "茂冈。我也曾经学习";
		mes "跆拳道。";
		mes "请多指教。";
		next;
		mes "[Moogang]";
		mes "嗯……";
		mes "你有没有考虑过成为……";
		mes "嗯……不，等等。嗯……";
		mes "我该怎么说呢？";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "咦……？";
		next;
		mes "[Moogang]";
		mes "哎呀！我总是";
		mes "不太擅长和别人";
		mes "说话。那么，不如";
		mes "和我的好朋友";
		mes "茂言谈谈？";
		mes "他会帮助你的。";
		next;
		mes "[Moogang]";
		mes "只是……";
		mes "我太兴奋了！";
		mes "你很可能";
		mes "就是我一直寻找的";
		mes "战士！";
		close;
	}
	else if (BaseJob == Job_Star_Gladiator) {
		mes "[Moogang]";
		mes "哦，很高兴再次";
		mes "见到你。最近去了哪里？";
		mes "我相信你去过受到太阳、月亮";
		mes "和星星祝福的地方，对吗？";
		mes "你的气息变了。";
		mes "看来你成长了。";
		next;
		mes "[Moogang]";
		mes "朋友，请记住我的建议，";
		mes "做决定时一定要小心。";
		mes "我不想看到你将来";
		mes "后悔自己的决定……";
		mes "请慎重前行。";
		next;
		mes "[Moogang]";
		mes "啊，如果你想念太阳房间、";
		mes "月之房间或星之房间，";
		mes "我随时可以送你过去。";
		mes "现在想去其中一个吗？";
		mes "请告诉我。";
		mes "我会为你安排。";
		next;
		switch(select("下次吧。:去太阳房间！:去月之房间！:去星之房间！")) {
		case 1:
			mes "[Moogang]";
			mes "好吧。我会一直在这里，";
			mes "想去那些地方时，";
			mes "随时来和我交谈。";
			mes "暂时再见，"+strcharinfo(0)+"~";
			mes "祝你旅途顺利。";
			mes "下次见。";
			close;
		case 2:
			mes "[Moogang]";
			mes "啊，你一定想念";
			mes "太阳的温暖吧？让我";
			mes "马上送你过去……";
			mes "请享受阳光。";
			mes "祝你好运。";
			close2;
			warp "job_star",34,12;
			end;
		case 3:
			mes "[Moogang]";
			mes "嗯？你需要";
			mes "月亮的柔和光芒吗？";
			mes "希望你能在它的安抚中";
			mes "找到平静……";
			mes "请好好休息。";
			close2;
			warp "job_star",100,13;
			end;
		case 4:
			mes "[Moogang]";
			mes "啊，你想看星星的闪烁，";
			mes "一定有无数理由。";
			mes "那么，让我马上送你";
			mes "去星之房间吧~";
			mes "请尽情享受。";
			close2;
			warp "job_star",166,29;
			end;
		}
	}
	mes "[Wandering Martial Artist]";
	mes "你喜欢徒步吗？";
	mes "新鲜空气、漫步的自由，";
	mes "以及自然之美，";
	mes "都是令人愉快的收获。";
	mes "请尽情享受。";
	next;
	mes "[Wandering Martial Artist]";
	mes "当然，我无法像你一样";
	mes "在夜间徒步时享受月光和星光。";
	mes "那么，愿太阳、月亮和星星";
	mes "保护你所有的旅程~";
	mes "朋友，请保重。";
	mes "一路顺风。";
	close;
}

job_star,29,33,0	script	Daru#job_star	59,{
	if (Class == Job_Taekwon) {
		if (STGL_Q == 3) {
			mes "[Daru]";
			mes "啊，你好。";
			mes "我是达鲁，会";
			mes "担任这个房间的向导。";
			mes "测试中，你必须睁开双眼，";
			mes "回答我的问题。";
			mes "我们开始吧。";
			next;
			mes "[Daru]";
			mes "告诉我。";
			mes "你看到的";
			mes "是什么？";
			next;
			switch(select("太阳。:月亮。:星星。:我不知道。")) {
			case 1:
				mes "[Daru]";
				mes "是的！是太阳！";
				mes "你可以把人类看作";
				mes "太阳的孩子。";
				mes "很好，非常好……";
				set .@sun_point,.@sun_point+10;
				break;
			case 2:
				mes "[Daru]";
				mes "这……月亮？";
				mes "嗯。但这里是";
				mes "太阳房间。嗯……";
				break;
			case 3:
				mes "[Daru]";
				mes "星星。嗯……";
				mes "你可以把太阳看作";
				mes "宇宙中数千颗星星";
				mes "之一……";
				set .@sun_point,.@sun_point+5;
				break;
			case 4:
				mes "[Daru]";
				mes "不知道……？";
				mes "嗯。你应该";
				mes "睁开双眼，";
				mes "也敞开心扉。";
				mes "试着猜一个答案";
				mes "也没关系……";
			}
			next;
			mes "[Daru]";
			mes "现在，没有什么";
			mes "能离开太阳而生存。";
			mes "你知道生命最需要太阳的";
			mes "什么吗？";
			next;
			switch(select("温暖:舒适:光芒:什么都不需要")) {
			case 1:
				mes "[Daru]";
				mes "没错。";
				mes "没有太阳的温暖，";
				mes "我们的世界不仅寒冷，";
				mes "还会完全没有生命。";
				mes "回答得很好。";
				set .@sun_point,.@sun_point+10;
				break;
			case 2:
				mes "[Daru]";
				mes "舒适……？";
				mes "啊，是的。太阳的温暖";
				mes "带来舒适。";
				mes "没有舒适，生命";
				mes "真的值得活着吗？答得好。";
				set .@sun_point,.@sun_point+10;
				break;
			case 3:
				mes "[Daru]";
				mes "是的。没有太阳";
				mes "辉煌的光芒，";
				mes "我们什么也看不见。";
				mes "我们什么也不知道。";
				mes "我们什么也不是。";
				set .@sun_point,.@sun_point+10;
				break;
			case 4:
				mes "[Daru]";
				mes "嗯……";
				mes "答案应该";
				mes "来自你的内心，";
				mes "而不是头脑。";
				mes "每个人都需要太阳的某种东西。";
				mes "让我们看看……";
				break;
			}
			next;
			mes "[Daru]";
			mes "有一首歌这样唱，";
			mes "''^4D4DFFThe Sun shines on even days.";
			mes "月亮在奇数日闪耀。";
			mes "星星每逢第五天";
			mes "必定闪烁。^000000''";
			next;
			mes "[Daru]";
			mes "''^4D4DFFA desert is a Solar place,";
			mes "它的沙滩被太阳亲吻。";
			mes "沼泽是月之地，";
			mes "狼群受月亮驱动。";
			mes "深洞是星之地，骑士受星星魅惑。^000000''";
			next;
			mes "[Daru]";
			mes "现在，以下哪种组合";
			mes "在它们之中";
			mes "最明亮？";
			mes "请仔细思考……";
			next;
			if (select("第2天、沼泽、骑士:第4天、沙漠、沙子:第10天、沙漠、骑士:第5天、深洞、狼") == 2)
				set .@sun_point,.@sun_point+10;
			mes "[Daru]";
			mes "好了，就到这里。";
			mes "我不可能仅凭三个问题";
			mes "了解你的全部……";
			mes "但现在这已经足够了。";
			mes "请准备下一步。";
			mes "测试即将结束。";
			next;
			if (.@sun_point == 30) {
				mes "[Daru]";
				mes "我承认你对太阳的理解";
				mes "让我印象深刻。太阳是";
				mes "所有生命的来源，温暖和";
				mes "舒适的起点。现在让我带你";
				mes "去月之房间。";
				mes "请跟我来。";
				set STGL_Q,4;
				close2;
				warp "job_star",100,13;
				end;
			}
			else if (.@sun_point == 25) {
				mes "[Daru]";
				mes "虽然你对太阳的理解";
				mes "还不完美，但你似乎理解";
				mes "它是我们世界温暖和";
				mes "生命的来源。";
				mes "请继续学习。";
				next;
				mes "[Daru]";
				mes "这个理念是基础之一，";
				mes "会帮助你更好地感受";
				mes "宇宙的力量。现在请";
				mes "往这边去月之房间……";
				mes "不要落后。";
				set STGL_Q,4;
				close2;
				warp "job_star",100,13;
				end;
			}
			mes "[Daru]";
			mes "嗯……如果你不理解太阳";
			mes "在宇宙和人类世界中的作用，";
			mes "你将永远无法与自然、";
			mes "与宇宙产生联系。";
			mes "请认真思考。";
			mes "不要放弃。";
			next;
			mes "[Daru]";
			mes "我建议你在再次来找我前，";
			mes "仔细冥想自然的基本真理。";
			mes "思考太阳无穷的力量……";
			mes "之后再回来。";
			mes "愿你有所领悟。";
			mes "请继续努力。";
			set STGL_Q,5;
			close;
		}
		else if (STGL_Q == 4) {
			mes "[Daru]";
			mes "我们不必再留在这里。";
			mes "一起前往月之房间吧。";
			mes "测试还在等着你。";
			mes "请准备好。";

	}
	close3;

S_Donate:
	.@num = getarg(0);
	cutin "ra_nemma01",2;
	mes "[Priestess Nemma]";
	mes "So, " + strcharinfo(0) + "...";
	mes "我只是想确认一下：";
	mes "你想捐赠 "+getarg(1)+" Zeny，领取 "+ .@num +" 张彩票，";
		if (.@num == 1) mes "对吗？";
		else mes "对吗？";
	next;
	if (select("否:是") == 1) {
		mes "[Priestess Nemma]";
		mes "哦，我明白了。如果你身上没有足够的 Zeny，";
		mes "之后再回来捐赠就行。";
		mes "我们的女神 Freya 会向慷慨者微笑，奖励有耐心的人！";
		mes "";
		mes "";
		mes "";
		return;
	}
	if (Zeny >= .@num*50000) {
		if (!checkweight(7570,.@num)) {
			cutin "ra_nemma02",2;
			mes "[Priestess Nemma]";
			mes "我简直不敢相信……";
			mes "你携带了太多东西，连一张彩票的空间都没有。";
			mes "最好把一些物品存入仓库，好吗？";
			mes "";
			mes "";
			mes "";
			next;
			cutin "ra_nemma01",2;
			mes "[Priestess Nemma]";
			mes "别担心，等你腾出物品栏空间后我还会在这里。";
			mes "快回来，能捐赠的话就捐一点，好吗？";
			mes "";
			mes "";
			mes "";
			return;
		}
		$rachel_donate = $rachel_donate + .@num;
		getitem 7570,.@num;// Temple_Lottery_Ticket
		Zeny = Zeny - .@num *50000;
		set ra_have_donated,1;
		if ($rachel_donate > 9999) {
			cutin "ra_nemma03",2;
			mes "[Priestess Nemma]";
			mes "给你～";
			mes "非常感谢你的捐赠！";
			mes "我相信 Freya 正在向你微笑，";
			mes "并会奖励你的慷慨～";
			mes "";
			mes "";
			return;
		}
		else {
			set .@Remaining,10000-$rachel_donate;
			cutin "ra_nemma03",2;
			mes "[Priestess Nemma]";
			mes "非常感谢！我们会继续接受捐赠，直到达到目标。";
			mes "再收到 "+.@Remaining+" 笔每笔 50,000 Zeny 的捐赠，募捐就会结束。";
			mes "";
			mes "";
			mes "";
			mes "";
			next;
			mes "[Priestess Nemma]";
			mes "如果你愿意，稍后再回来捐赠吧。";
			mes "再次感谢你，愿 Freya 永远守护你。";
			mes "";
			mes "";
			mes "";
			return;
		}
	}
	else {
		mes "[Priestess Nemma]";
		mes "抱歉，你的 Zeny 少于 "+ (.@num *50000) +"……";
		mes "我知道要求很多，但这是我必须遵守的规则……";
		mes "嗯，也许下次再来，好吗？";
		mes "";
		mes "";
		mes "";
		return;
	}
}


			mes "但他们一直把汤兑水后以离谱的价格卖给顾客！秘密被偷也是他们活该！";
			next;
			mes "[Jiu Lian Bu]";
			mes "如果你能偷一些汤，我会给你报酬。怎么样？";
			next;
			if (select("我来做！:偷窃是不对的。") == 1) {
				mes "[Jiu Lian Bu]";
				mes "太好了！我就知道你会同意我的看法！";
				next;
				mes "[Jiu Lian Bu]";
				mes "好，餐厅在洛阳西侧。但你得小心，那里的员工像鹰一样盯着汤！";
				next;
				mes "[Jiu Lian Bu]";
				mes "偷到汤后，务必一滴不洒地带回来。明白吗？祝你好运~";
				set ch_tre,1;
				close;
			}
			mes "[Jiu Lian Bu]";
			mes "偷窃？你说得也有道理。";
			next;
			mes "[Jiu Lian Bu]";
			mes "不过，那家餐厅多年来一直这样欺骗顾客！严格来说，我们只是把东西偷回来。";
			close;
		}
		mes "[Jiu Lian Bu]";
		mes "那家店也没多好。很明显他们在坑顾客！龙汤？我看更像……龙屎汤！";
		close;
	}
	else if (ch_tre == 1) {
		mes "[Jiu Lian Bu]";
		mes "嗯……？我还以为你已经去餐厅了。你最好快点行动。";
		next;
		mes "[Jiu Lian Bu]";
		mes "好吧，朋友。别让那里的伙计抓到你。祝你好运~";
		close;
	}
	else if (ch_tre == 2) {
		mes "[Jiu Lian Bu]";
		mes "哇！你成功了！让我看看……";
		next;
		mes "^3355FF九连步大口喝了一口你为他偷来的汤。^000000";
		next;
		mes "[Jiu Lian Bu]";
		mes "哦……天啊。这根本不是龙汤汤底。抱歉，你能再去取一次吗？";
		set ch_tre,1;
		close;
	}
	else if (ch_tre == 3) {
		mes "[Jiu Lian Bu]";
		mes "哇！你成功了！让我看看……";
		next;
		mes "^3355FF九连步大口喝了一口你为他偷来的汤。^000000";
		next;
		mes "[Jiu Lian Bu]";
		mes "哦……就是这个。呜哈哈哈哈~！这下厨师要痛苦一阵子了！";
		next;
		mes "[Jiu Lian Bu]";
		mes "干得好，伙计！嘿嘿嘿，你为我冒了生命危险，我要带你去一个超棒的地方！跟我来~";
		set ch_tre,4;
		close2;
		warp "lou_fild01",180,170;
		end;
	}
	else if (ch_tre > 3 && ch_tre < 6) {
		mes "[Jiu Lian Bu]";
		mes "嘿~最近怎么样，偷汤高手？想再去那个地方吗？";
		next;
		if (select("好啊，走吧~:不了，下次吧。") == 1) {
			mes "[Jiu Lian Bu]";
			mes "好~我们出发吧。";
			close2;
			warp "lou_fild01",180,170;
			end;
		}
		mes "[Jiu Lian Bu]";
		mes "没心情吗？没关系，想来的时候随时来找我。";
		close;
	}
	mes "[Jiu Lian Bu]";
	mes "什么……？嘿，你是谁？没话说就滚开！";
	close;
}

lou_fild01,175,173,3	script	Jiu Lian Bu#1-2	819,{
	emotion ET_SMILE;
	if (ch_tre == 4) {
		mes "[Jiu Lian Bu]";
		mes "怎么样？这里是洛阳最美的地方，对吧？";
		next;
		mes "[Jiu Lian Bu]";
		mes "每当我沮丧或需要放松时，就坐在这里享受微风。它能让我忘记所有烦恼。";
		next;
		mes "[Jiu Lian Bu]";
		mes "嘿嘿，最棒的是这里离我姐姐很远。那女人整天唠叨个不停。";
		next;
		mes "[Jiu Lian Bu]";
		mes "坐下来闭上眼睛，感受舒缓的风吧。真的很清爽……";
		next;
		emotion ET_SCRATCH;
		mes "[Jiu Lian Bu]";
		mes "还有……说这个有点不好意思，但是……";
		next;
		mes "[Jiu Lian Bu]";
		mes "我是个有话直说的人。如果有想说却说不出口的事，就像毒药一样积在心里。";
		next;
		mes "[Jiu Lian Bu]";
		mes "你明白我的意思吧？把事情闷在心里，只会带来不必要的焦虑。";
		next;
		mes "[Jiu Lian Bu]";
		mes "所以……你要这样做。握紧拳头，深呼吸。";
		next;
		mes "[Jiu Lian Bu]";
		mes "然后想喊什么就喊什么！不知道说什么的话，尖叫也行。把一切都释放出来！";
		next;
		mes "[Jiu Lian Bu]";
		mes "准备好~！大声说出来！";
		next;
		input .@input$;
		mes "["+strcharinfo(0)+"]";
		mes .@input$;
		mapannounce "lou_fild01","'"+strcharinfo(0)+"' shouts : "+.@input$,bc_map,"0x9CFF00";
		next;
		mes "[Jiu Lian Bu]";
		mes "感觉怎么样？是不是好多了？哈哈哈~";
		next;
		mes "[Jiu Lian Bu]";
		mes "以后想释放压力时，就来找我，我们再回到这里。就当作我的谢礼吧。";
		set ch_tre,5;
		close;
	}
	else if (ch_tre == 5) {
		mes "[Jiu Lian Bu]";
		mes "那么……你想做什么？";
		next;
		if (select("呐喊。:离开。") == 1) {
			mes "[Jiu Lian Bu]";
			mes "好~！大声说出来！";
			next;
			input .@input$;
			mes "["+strcharinfo(0)+"]";
			mes .@input$;
			mapannounce "lou_fild01","'"+strcharinfo(0)+"' shouts : "+.@input$,bc_map,"0x9CFF00";
			next;
			mes "[Jiu Lian Bu]";
			mes "感觉怎么样？是不是好多了？";
			close;
		}
		mes "[Jiu Lian Bu]";
		mes "啊……好，我们出发吧。";
		close2;
		warp "lou_fild01",200,174;
		end;
	}
	mes "[Jiu Lian Bu]";
	mes "嘿，朋友~！这是我的地盘！你在这里做什么？！";
	next;
	mes "[Jiu Lian Bu]";
	mes "现在……赶紧滚出去。";
	close2;
	warp "lou_fild01",200,174;
	end;
}

lou_in02,50,185,5	script	Pot#1	111,{
	if (ch_tre == 1) {
		mes "^3131FF在阴影下，你发现一口装满暗红色液体的大锅。你想做什么？^000000";
		next;
		if (select("拿走这口锅。:寻找另一口锅。") == 1) {
			mes "^3131FF你仔细环顾四周。有人监视时，现在偷走它并不明智。^000000";
			next;
			if (gettime(DT_HOUR) >= 10 && gettime(DT_HOUR) < 14) {
				mes "^3131FF餐厅现在似乎不忙，只有少数员工和顾客。^000000";
			}
			else if (gettime(DT_HOUR) >= 14 && gettime(DT_HOUR) < 17) {
				mes "^3131FF这里只有餐厅员工，他们正忙着互相聊天。^000000";
			}
			else if (gettime(DT_HOUR) >= 17 && gettime(DT_HOUR) < 22) {
				mes "^3131FF餐厅挤满了顾客，员工们也忙忙碌碌。^000000";
				next;
				mes "^3131FF每个人都忙得不可开交，没注意到你靠近锅。^000000";
			}
			else {
				mes "^3131FF餐厅已经关门，整个地方一片寂静，员工都睡着了。^000000";
			}
			next;
			mes "^3131FF你小心地抬起锅。虽然很重，但你觉得自己搬得动。^000000";
			next;
			mes "^3131FF现在只要不被抓住，离开这家餐厅就行了……^000000";
			if (rand(1,4) < 4) {
				set ch_tre,2;
			}
			else {
				set ch_tre,3;
			}
			close;
		}
		mes "^3131FF你决定寻找另一口锅。^000000";
		close;
	}
	else if (ch_tre > 3 && ch_tre < 6) {
		mes "^3131FF你找到一口锅。^000000";
		mes "^3131FF不过，里面是空的。^000000";
		close;
	}
	if (gettime(DT_HOUR) >= 10 && gettime(DT_HOUR) < 22) {
		mes "[Chef]";
		mes "啊……！请不要碰那些锅！";
		close;
	}
	mes "^3131FF在阴影下，你发现一口装满暗红色液体的大锅。^000000";
	close;
}


lou_in02,58,183,5	script	Chef Assistant#lou1	823,5,5,{
	mes "[Jin Wei Ling]";
	mes "我以前是一名热情的武术家。";
	next;
	mes "[Jin Wei Ling]";
	mes "虽然我以厨师助手为生，但我始终先把自己当作武术家。";
	next;
	mes "[Jin Wei Ling]";
	mes "所以我决定把武术精神融入烹饪。顾客多时，我们经常忙得不可开交。";
	next;
	mes "[Jin Wei Ling]";
	mes "忙起来时，我可以用武术更快地烹饪！哈哈哈~武术非常实用！";
	next;
	specialeffect EF_BEGINSPELL3;
	mes "[Jin Wei Ling]";
	mes "哇啊——！！！！";
	next;
	specialeffect EF_ENDURE; 
	mes "[Jin Wei Ling]";
	mes "哇啊——！！！！！";
	next;
	specialeffect EF_SONICBLOW;
	mes "[Jin Wei Ling]";
	mes "哇啊……";
	mes "哇啊——！！！！！";
	next;
	specialeffect EF_SONICBLOWHIT;
	mes "^3355FF*咔嚓咔嚓咔嚓咔嚓*^000000";
	next;
	emotion ET_BEST;
	mes "[Jin Wei Ling]";
	mes "哈哈哈哈！看这些完美的蔬菜切片！呜哈哈哈哈！！我会继续通过烹饪磨炼武术！";
	close;

OnTouch_:
	if (ch_tre == 2 || ch_tre == 3) {
		if (gettime(DT_HOUR) >= 10 && gettime(DT_HOUR) < 14) {
			if (rand(1,10) < 9) {
				mes "[Jin Wei Ling]";
				mes "等等！你是谁！放下那口锅，马上离开这里！";
				next;
				mes "^3131FF你偷锅失败了。^000000";
				set ch_tre,1;
				close;
			}
		}
		else if (gettime(DT_HOUR) >= 14 && gettime(DT_HOUR) < 17) {
			if (rand(1,10) < 10) {
				mes "[Jin Wei Ling]";
				mes "等等！你是谁！放下那口锅，马上离开这里！";
				next;
				mes "^3131FF你偷锅失败了。^000000";
				set ch_tre,1;
				close;
			}
		}
		else if (gettime(DT_HOUR) >= 17 && gettime(DT_HOUR) < 22) {
			if (rand(1,10) < 6) {
				mes "[Jin Wei Ling]";
				mes "等等！你是谁！放下那口锅，马上离开这里！";
				next;
				mes "^3131FFYou have failed^000000";
				mes "^3131FFto steal the pot.^000000";
				set ch_tre,1;
				close;
			}
		}
	}
	end;
}

lou_in02,80,173,3	script	Li Min#lou	746,{
	if (ch_tre == 5) {
		mes "[Li Min]";
		mes "^666666*叹气*^000000我太失望了。我大老远来这里品尝美食！真不敢相信他们已经不卖了！";
		next;
		mes "[Li Min]";
		mes "最糟的是我已经迷上了这种味道！^666666*抽泣……*^000000";
		close;
	}
	mes "[Li Min]";
	mes "我其实不住在洛阳，但经常来这里。";
	next;
	mes "[Li Min]";
	mes "我这次回来，是因为非常想念以前在这里尝过的食物。";
	next;
	mes "[Li Min]";
	mes "不知为什么，我忘不了它。它一直萦绕在我的脑海里！";
	next;
	mes "[Li Min]";
	mes "它的味道和口感，还有融化在嘴里的甜味，以及萦绕唇边的诱人香气……";
	next;
	mes "[Li Min]";
	mes "嗯……蜂王浆！想得我都流口水了~";
	close;
}

lou_in02,42,186,5	script	Liu Jia Lim#lou	816,{
	if (ch_tre == 5) {
		mes "[Liu Jia Lim]";
		mes "你知道这家餐厅历史上最好的菜是什么吗？龙汤！";
		next;
		emotion ET_THROB;
		mes "[Liu Jia Lim]";
		mes "它的鲜美来自纯肉熬制的无脂汤底，因此也是女士们非常喜欢的减肥食品。";
		next;
		mes "[Liu Jia Lim]";
		mes "我不知道发生了什么，但听说这家餐厅已经不再卖龙汤。是因为价格吗……？";
		close;
	}
	mes "[Liu Jia Lim]";
	mes "你知道这家餐厅最好的菜是什么吗？是龙汤！这家餐厅开张以来一直在卖它。";
	next;

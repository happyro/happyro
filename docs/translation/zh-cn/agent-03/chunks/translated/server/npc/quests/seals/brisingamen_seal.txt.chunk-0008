	}
	end;
}

xmas,36,103,4	script	Alfrik#1	826,{
	if (god_brising == 49) {
		mes "[Alfrik]";
		mes "我没什么可说的了！现在滚出去！我不想被发现！";
		close2;
		hideonnpc "Alfrik#1";
		end;
	}
	else if (god_brising == 48) {
		mes "[Alfrik]";
		mes "怎么了，人类？我们都醒来了。";
		next;
		switch(select("我只是想打招呼。:Brisingamen 的材料是什么？")) {
		case 1:
			mes "[Alfrik]";
			mes "感谢你的好意，但我宁愿躲起来也不社交。我不想被 Odin 的乌鸦发现！";
			close2;
			hideonnpc "Alfrik#1";
			end;
		case 2:
			mes "[Alfrik]";
			mes "Brisingamen 的材料？制作人类仿品，材料很容易收集……";
			next;
			mes "[Alfrik]";
			mes "需要千年前诸神与恶魔战斗时使用的武器力量，以及从 Brisingamen 上脱落的所有东西。基本就是这些。";
			next;
			mes "[Alfrik]";
			mes "如果你想制作 Brisingamen，需要……";
			next;
			mes "[Alfrik]";
			mes "^4d4dffFreya's Jewel";
			mes "银饰、雪晶、涟漪、^000000漂浮之风^000000";
			next;
			mes "[Alfrik]";
			mes "你可能还需要蓝宝石、珍珠、蛋白石、诅咒红宝石，甚至一些黄金来装饰项链。";
			next;
			mes "[Alfrik]";
			mes "虽然我免费提供建议，但除非 Freya 下令，我们四个矮人不会再锻造。";
			next;
			mes "[Alfrik]";
			mes "但我能保证一件事。既然我们四人已经醒来，人类一定能得到 Brisingamen。";
			next;
			mes "[Alfrik]";
			mes "现在……让我安静。";
			set god_brising,49;
			close2;
			hideonnpc "Alfrik#1";
			end;
		}
	}
	else if (god_brising == 40) {
		mes "[Alfrik]";
		mes "^333333*Yawn...*^000000";
		mes "我很久没出来了！等、等等！你不是……";
		next;
		mes "[Alfrik]";
		mes "谁派你来的？！Loki？Heimdall？还是 Freya？";
		next;
		switch(select("没人，是意外！:是女武神。")) {
		case 1:
			mes "[Alfrik]";
				mes "别想对我撒谎，人类！不知道密码，你不可能唤醒我！现在说！";
			next;
				switch(select("女武神告诉我的。:这是巧合！")) {
			case 1:
				mes "[Alfrik]";
					mes "女武神……？Odin 的战士？Odin 想要什么？我没做错任何事！";
				next;
				mes "^3355FF你向 Alfrik 解释了一切，他似乎担心成为 Odin 的目标。^000000";
				next;
				mes "[Alfrik]";
					mes "原来如此。你们在寻找我们的杰作？人类一定渴望诸神的力量。有意思。";
				next;
				mes "[Alfrik]";
					mes "我们复苏的时刻也许真的到了！好吧，我 Alfrik 会与人类合作。";
				next;
				mes "[Alfrik]";
					mes "毕竟，讨好 Odin 总比被 Loki 折磨好。";
				next;
				mes "[Alfrik]";
					mes "现在……要明白真正的 Brisingamen 只有一个。毕竟，那是我们的杰作。";
				next;
				mes "[Alfrik]";
					mes "不过，这不代表不能制作拥有同等神力的仿品。诸神的力量很诱人，不是吗？";
				next;
				mes "[Alfrik]";
					mes "首先，如果想制作项链，必须唤醒我们四人。由于 Loki 的威胁，我们都藏在不同地方。";
				next;
				mes "[Alfrik]";
					mes "去唤醒我的兄弟们！看看 Brisingamen 能否再次制作！先在诸神和巨人发现前唤醒 Dvalin！";
				set god_brising,41;
				close2;
				hideonnpc "Alfrik#1";
				end;
			case 2:
				mes "[Alfrik]";
			mes "巧合？";
			mes "不可能！你竟敢撒谎！别再回来，否则诸神会找到我！";
				close2;
				hideonnpc "Alfrik#1";
				end;
			}
		case 2:
			mes "[Alfrik]";
			mes "女武神……？";
			mes "Odin 的战士？";
			mes "Odin 想要什么？";
			mes "我没做错任何事！";
			next;
			mes "^3355FF你向 Alfrik 解释了一切，他似乎担心成为 Odin 的目标。^000000";
			next;
			mes "[Alfrik]";
			mes "原来如此。";
			mes "你们在寻找我们的杰作？";
			mes "人类一定渴望诸神的力量。";
			mes "有意思。";
			mes "";
			mes "";
			next;
			mes "[Alfrik]";
			mes "我们复苏的时刻也许真的到了！好吧，";
			mes "我 Alfrik 会与人类合作。";
			next;
			mes "[Alfrik]";
			mes "毕竟，讨好 Odin 总比被 Loki 折磨好。";
			next;
			mes "[Alfrik]";
			mes "现在……要明白真正的 Brisingamen 只有一个。";
			mes "毕竟，那是我们的杰作。";
			mes "";
			mes "";
			mes "";
			mes "";
			next;
			mes "[Alfrik]";
			mes "不过，这不代表不能制作拥有同等神力的仿品。诸神的力量很诱人，不是吗？";
			next;
			mes "[Alfrik]";
			mes "首先，如果想制作项链，必须唤醒我们四人。由于 Loki 的威胁，我们都藏在不同地方。";
			next;
			mes "[Alfrik]";
			mes "去唤醒我的兄弟们！";
			mes "看看 Brisingamen 能否再次制作！先在诸神和巨人发现前唤醒 Dvalin！";
			set god_brising,41;
			close2;
			hideonnpc "Alfrik#1";
			end;
		}
	}
	else if (god_brising == 41) {
		mes "[Alfrik]";
			mes "你怎么还在这里？";
			mes "我叫你去唤醒 Dvalin！";
		next;
			switch(select("他在哪里？:告诉我更多关于 Brisingamen 的事。")) {
		case 1:
			mes "[Alfrik]";
			mes "啊，对了。";
			mes "我忘了告诉你。可怜的 Dvalin。";
			mes "现在，他在哪里来着？";
			mes "";
			next;
			mes "[Alfrik]";
			mes "我们害怕 Odin 和 Heimdall 惩罚我们，因为在他们看来，我们让女神蒙羞了。";
			next;
			mes "[Alfrik]";
			mes "当然，如果不是 Loki 的诡计，他们本来不会生气。";
			next;
			mes "[Alfrik]";
			mes "我们深爱 Freya，于是决定藏在她走过的道路下，尽可能接近她留下的痕迹。";
			next;
			mes "[Alfrik]";
			mes "可怜的 Dvalin 正睡在东方道路下。到了那里，你会感受到女神的气息。";
			mes "我记不起其他人睡在哪里，但你不能忘记这些话……";
			next;
			mes "[Alfrik]";
			mes "^4d4dff她可爱的气息";
			mes "仍在风中萦绕。";
			mes "我们向那温柔的泪珠，";
			mes "那诱人的红唇，";
			mes "献上了我们的心。^000000";
			set god_brising,42;
			close2;
			hideonnpc "Alfrik#1";
			end;
		case 2:
			mes "[Alfrik]";
			mes "Brisingamen 是我们的杰作，是我们为 Freya 锻造的项链。即使再次制作，我也怀疑能否达到原来的水平。";
			next;
			mes "[Alfrik]";
			mes "它戴在 Freya 身上完美无瑕。要制作真正衬托美之女神魅力的饰品非常困难。";
			next;
			mes "[Alfrik]";
			mes "也许我们最大的奖励，就是把项链交给她时，她露出的满足笑容。我们是如此爱她。";
			next;
			mes "[Alfrik]";
			mes "矮人爱上女神真的错了吗？也许我们受到惩罚，是因为诸神，甚至 Odin，也爱着她。";
			next;
			mes "[Alfrik]";
			mes "无论如何，我们再也没见过真正的 Brisingamen。但可以制作出与它非常相似的东西……";
			next;
			mes "[Alfrik]";
			mes "你需要受到女神恩泽的材料：大地、水与风中留下的女神痕迹。";
			next;
			mes "[Alfrik]";
			mes "如果 Brisingamen 被重现，神的力量就会落入人类手中。而那个人可能就是你！";
			next;
			mes "[Alfrik]";
			mes "可怜的 Dvalin 正睡在东方道路下。到了那里，你会感受到女神的气息。";
			next;
			mes "[Alfrik]";
			mes "我记不起其他人睡在哪里，但你不能忘记这些话……";
			next;
			mes "[Alfrik]";
			mes "^4d4dff她可爱的气息";
			mes "仍在风中萦绕。";
			mes "我们向那温柔的泪珠，";
			mes "那诱人的红唇，";
			mes "献上了我们的心。^000000";
			set god_brising,42;
			close2;
			hideonnpc "Alfrik#1";
			end;
		}
	}
	else if (god_brising == 42) {
		mes "[Alfrik]";
		mes "求你了！";
		mes "在 Loki 和 Heimdall 发现我醒来前快走！现在赶紧找到 Dvalin，唤醒他！";
		close2;
		hideonnpc "Alfrik#1";
		end;
	}
	else if ((god_brising > 42) && (god_brising < 48)) {
		mes "[Alfrik]";
		mes "哦，我们终于全都醒来了！现在可以从大地、水和风中取回女神的力量了！";
		next;
		mes "[Alfrik]";
		mes "哈哈哈哈哈！";
		mes "这一定很有意思！";
		mes "";
		close2;
		hideonnpc "Alfrik#1";
		end;
	}
	else {
		mes "[Alfrik]";
		mes "嗯……？";
		mes "我和你没什么可谈的。";
		mes "";
		mes "";
		close2;
		hideonnpc "Alfrik#1";
		end;
	}

OnInit:
	hideonnpc "Alfrik#1";
	end;
}

prt_fild02,185,269,0	script	#brisindwarf2	111,3,3,{
	if ($God2 < $@god_check1) {
		mes "^3355FF这只是一块普通的石头。^000000";
		close;
	}
	if ($God3 >= $@god_check2) {
		mes "^3355FF这只是一块普通的石头。^000000";
		close;
	}
	if (god_brising > 41) {
		mes "^3355FF树影下只是一块普通的石头。仔细观察后，你发现石头上的苔藓看起来异常平整。^000000";
		next;
		switch(select("踩上去。:扫开表面。:刮擦表面。:踢它。")) {
		case 1:
			mes "^3355FF你小心地把脚放到石头顶部。整块石头突然向下翻入地面，";
			mes "你无助地跌了下去……^000000";
			close2;
			warp "prt_fild02",165,224;
			end;
		case 2:
			mes "^3355FF你用手扫开苔藓时，被石头的锋利边缘划伤了手掌。^000000";
			emotion ET_SURPRISE, playerattached();
			next;
			mes "[" + strcharinfo(0) + "]";
			mes "该死……！";
			mes "我流血了！";
			mes "但为什么没有";
			mes "发生其他事情？！";
			next;
			mes "["+ strcharinfo(0) +"]";
			mes "这块石头最好就是";
			mes "";
			mes "那些秘密石头之一！";
			mes "否则……！";
			close;
		case 3:
			mes "^3355FF你刮开苔藓，感觉到石头表面有平整的凹槽。";
			mes "";
			next;
			mes "^3355FF剥去苔藓后，石头顶部露出一组刻着模糊文字的方块。这些方块可以像谜题一样移动。^000000";
			next;
			mes "[" + strcharinfo(0) + "]";
			mes "又一个谜题？这就像之前回答 Alfrik 的密码。好，让我看看……";
			set .@point,0;
			next;
			switch(select("沿途滴落的泪珠:她可爱的香气:我们给予:诱人的红唇:我们的心")) {
			case 1:
				mes "["+ strcharinfo(0) +"]";
				mes "沿途滴落的泪珠";
			break;
			case 2:
				mes "["+ strcharinfo(0) +"]";
				mes "她可爱的气息";
				set .@point,.@point + 10;
			break;
			case 3:
				mes "["+ strcharinfo(0) +"]";
				mes "我们给予";
			break;
			case 4:
				mes "["+ strcharinfo(0) +"]";
				mes "诱人的红唇";
				break;
			case 5:
				mes "["+ strcharinfo(0) +"]";
				mes "我们的心";
				break;
			}
			switch(select("仍在风中萦绕。:飘散在风中的香气:我们给予:诱人的红唇:我们的心")) {
			case 1:
				mes "仍在风中萦绕。";
				set .@point,.@point + 10;
				break;
			case 2:
				mes "飘散在风中的香气";
				break;
			case 3:
				mes "我们给予";
				break;
			case 4:
				mes "诱人的红唇";
			case 5:
				mes "我们的心";
				break;
			}
			switch(select("沿途滴落的泪珠:飘散在风中的香气:我们给予:我们献出心灵:我们的心")) {
			case 1:
				mes "沿途滴落的泪珠";
				break;
			case 2:
				mes "飘散在风中的香气";
				break;
			case 3:
				mes "我们给予";
				break;
			case 4:
				mes "我们献出心灵";
				set .@point,.@point + 10;
			case 5:
				mes "我们的心";
				break;
			}
			switch(select("沿途滴落的泪珠:飘散在风中的香气:那些温柔泪珠:诱人的红唇:我们的心")) {
			case 1:
				mes "沿途滴落的泪珠";
				break;
			case 2:
				mes "飘散在风中的香气";
				break;
			case 3:
				mes "那些温柔泪珠";
				set .@point,.@point + 10;
				break;
			case 4:
				mes "诱人的红唇";
				break;
			case 5:
				mes "我们的心";
				break;
			}
			switch(select("沿途滴落的泪珠:飘散在风中的香气:我们给予:诱人的红唇:那些迷人的红唇")) {
			case 1:
				mes "沿途滴落的泪珠";
				break;
			case 2:
				mes "飘散在风中的香气";
				break;
			case 3:
				mes "我们给予";
				break;
			case 4:
				mes "诱人的红唇";
				break;
			case 5:
				mes "那些迷人的红唇";
				set .@point,.@point + 10;
				break;
			}
			next;
			if (.@point > 40) {
				hideoffnpc "Dvalin#1";
				mes "[Dvalin]";
				mes "...?";
			mes "Alfrik？是你吗？";
				close;
			}
			close;
		case 4:
			mes "["+ strcharinfo(0) +"]";
			mes "^333333*Cough cough!*";
			mes "啊啊！灰尘真多！";
			close;
		}
	}
	else {
		mes "^3355FFJust a normal";
	mes "覆盖苔藓的岩石。^000000";
		close;
	}

OnTouch_:
	if (god_brising > 41) {
		emotion ET_SURPRISE, playerattached();
	}
	end;
}

prt_fild02,185,270,3	script	Dvalin#1	826,{
	if (god_brising > 43) {
		mes "[Dvalin]";
		mes "人类？你唤醒了我？";
		next;
		mes "[Dvalin]";
		mes "嗯……如果你代表神明，现在应该会很强硬。你想要什么……？";
		next;
		mes "[Dvalin]";
		mes "你想要 Brisingamen 仿品的力量很合理。但记住，我们最初制作它是作为适合女神佩戴的项链。";
		next;
		mes "[Dvalin]";
		mes "有人会说我们用项链诱惑了 Freya，但我们确实全心全意爱着她。";
		close2;
		hideonnpc "Dvalin#1";
		end;
	}
	else if (god_brising == 42) {
		mes "[Dvalin]";
		mes "哇，不是 Alfrik？你凭什么唤醒 Dvalin？现在告诉我，否则我……我要教训你！";
		next;
		switch(select("救命！:Alfrik 派我来唤醒你！")) {
		case 1:
			mes "[Dvalin]";

			mes "在如今这个时代。我们会感谢你的帮助。以下是需要的物品。";
			next;
			mes "[Bain]";
			mes "^FF00001 Mixture^000000, ^FF00005 Mini-Furnace^000000,";
			mes "^FF00005 Burnt Tree^000000 , ^FF00005 Coal^000000,";
			mes "^FF00005 Fine Sand^000000, ^FF00003 Rough Elunium^000000,";
			mes "^FF00003 Rough Oridecon^000000^000000.";
			next;
			mes "[Bain]";
			mes "还需要 2,000 Zeny，用于支付这项工作的零星开销。祝你顺利。";
			close;
		}
		mes "[Bain]";
		mes "我希望能成为像你一样强大的冒险者。";
		close;
	}

S_DelItems:
	delitem 974,1; //Mixture
	delitem 612,5; //Portable_Furnace
	delitem 1003,5; //Coal
	delitem 7068,5; //Burn_Tree
	delitem 7043,5; //Fine_Sand
	delitem 757,3; //Elunium_Stone
	delitem 756,3; //Oridecon_Stone
	set Zeny, Zeny-2000;
	getitem getarg(0),getarg(1); //Gold
	mes "[Bain]";
	mes "啊啊啊，成功了！我不知道还能不能做其他事，";
	if (getarg(2) == 1)
		mes "但这次我们制作了 "+getarg(1);
	else 
		mes "但这次我们制作了";
	mes "^FF0000"+getitemname(getarg(0))+"^000000 !";
	next;
	mes "[Bain]";
	mes "既然知道它能工作，我就不需要这个了。你拿走吧？哦，如果找到更多零件，再带给我。嘿嘿。";
	next;
	mes "[Bain]";
	mes "谢谢你的帮助。我永远感激你。祝你旅途好运！";
	close;
}
	
yuno_in01,100,153,7	script	Bajin	47,0,0,{
	if (checkweight(1201,1) == 0) {
		mes "- 等一下！！ -";
		mes "- 你现在携带了太多物品。 -";
		mes "- 请减轻负重后 -";
		mes "- 再试一次。 -";
		mes "-";
		close;
	}
	if (countitem(974) > 0 && countitem(612) > 4 && countitem(1003) > 4 && countitem(7068) > 4 && countitem(7043) > 4 && countitem(757) > 2 && countitem(756) > 2 && Zeny >= 2000) {
		if (ALCH_Q == 23) set ALCH_Q,24;
		set .@kyulkwa,rand(1,10);
		mes "[Bajin]";
		mes "哦呵呵……这些就是我需要的零件。太感谢了。好，让我们试试！稍等一下！";
		next;
		mes "^3355FF*Vrrrmrmrmrmrmrmrmrmrmrmmmmm*^000000";
		next;
		mes "^3355FF*Pakakkakakakkakaakapakakkakak*^000000";
		next;
		mes "^3355FF*Shakakakakkakakakakkakakakakka!*^000000";
		next;

		if (.@kyulkwa < 4 || .@kyulkwa > 8)
			callsub S_DelItems,1002,5,1;
		if (.@kyulkwa == 5 || .@kyulkwa == 6 || .@kyulkwa == 8)
			callsub S_DelItems,723,5,1;
		else if (.@kyulkwa == 7)
			callsub S_DelItems,984,3,1;
	}
	if (bros_q == 1) {
		mes "[Bajin]";
		mes "以防你忘记，这些是所需材料。需要的话记下来。";
		next;
		mes "[Bajin]";
		mes "^FF00001 Mixture^000000, ^FF00005 Mini-Furnace^000000,";
		mes "^FF00005 Burnt Tree^000000 , ^FF00005 Coal^000000,";
		mes "^FF00005 Fine Sand^000000, ^FF00003 Rough Elunium^000000,";
		mes "^FF00003 Rough Oridecon^000000^000000.";
		next;
		mes "[Bajin]";
		mes "除此之外，还需要 2,000 Zeny。祝你好运……";
		close;
	}
	if (bros_q == 0) {
		mes "[Bajin]";
		mes "我们要发明一个能说话交流的玩偶！至少我正在努力。";
		next;
		mes "[Bajin]";
		mes "这个想法来自历史传说。我想既然以前有人做到过，这个项目就一定可行。";
		next;
		mes "[Bajin]";
		mes "但现在我缺少尝试这项壮举所需的用品和零件。我不知道他们如何收集齐所有材料……";
		next;
		mes "[Bajin]";
		mes "钱只能买到部分材料。还有些物品必须从过于强大的魔物身上取得。我该如何继续研究？";
		next;
		if (select("我替你找来。:祝你好运。") == 1) {
			set bros_q,1;
			mes "[Bajin]";
			mes "哦，你真好。我们会感谢你的帮助。以下是需要的物品。";
			next;
			mes "[Bajin]";
			mes "^FF00001 Mixture^000000, ^FF00005 Mini-Furnace^000000,";
			mes "^FF00005 Burnt Tree^000000 , ^FF00005 Coal^000000,";
			mes "^FF00005 Fine Sand^000000, ^FF00003 Rough Elunium^000000,";
			mes "^FF00003 Rough Oridecon^000000^000000.";
			next;
			mes "[Bajin]";
			mes "还需要 2,000 Zeny，用于支付这项工作的零星开销。祝你顺利。";
			close;
		}
		close;
	}

S_DelItems:

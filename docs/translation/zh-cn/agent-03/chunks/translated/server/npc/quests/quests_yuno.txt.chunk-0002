yuno,157,87,4	script	A Citizen of Juno#juno	102,{
	mes "[Shalima]";
	mes "从艾尔帕兰向北走，会到达被熔岩覆盖的‘Elmeth 高原’。";
	next;
	mes "[Shalima]";
	mes "在连接高原的山顶上，有座桥通往^3355FF贤者之城朱诺^000000。";
	next;
	if (dmdswrd_Q == 23) {
		mes "[Shalima]";
		mes "哦……？你携带的闪亮物品是什么？那不是……？";
		next;
		mes "[Shalima]";
		mes "^3355FFMuriniel 印章^000000？真令人惊讶！";
		next;
		mes "[Shalima]";
		mes "从朱诺入口向东走，会找到书店街。有时间请拜访 ^3355FFYklah 爵士^000000，他是朱诺三大贤者之一。";
		next;
		mes "[Shalima]";
		mes "我相信他会对你携带的印章特别感兴趣。";
		close;
	}
	else {
		mes "[Shalima]";
		mes "在朱诺，你可以参观‘Juphero 广场’、‘朱诺会议厅’、‘Schweicherbil 魔法学院’或‘魔物博物馆’。这些地方闻名世界！";
		next;
		mes "[Shalima]";
		mes "你也可以去‘贤者城堡’，那里能转职为独特职业‘贤者’。";
		next;
		mes "[Shalima]";
		mes "如果对贤者职业感兴趣，不妨去城堡看看？";
		close;
	}
}

yuno,261,99,4	script	Sage Yklah#juno	735,{
	if (dmdswrd_Q == 23 || dmdswrd_Q == 24 || dmdswrd_Q == 25) {
		switch(dmdswrd_Q) {
		case 23:
			mes "[Yklah]";
			mes "- ! ! ! -";
			next;
			mes "[Yklah]";
			mes "那件物品……你携带的闪亮物品，不就是……^3355FFMuriniel 印章^000000？！哦！真令人惊讶！";
			next;
			mes "[Yklah]";
			mes "我听说它来自炎热干燥的土地，但从没想过能亲眼见到！";
			next;
			mes "[Yklah]";
			mes "你是谁……？你替谁携带这件传说物品？";
			next;
			switch(select("（向他展示石板）:我是天才！:我是 GM！")) {
			case 1:
				mes "[Yklah]";
				mes "……我不敢相信自己的眼睛！只有被选中的少数人才能拥有 Muriniel 印章……";
				next;
				mes "[Yklah]";
				mes "哦，是的。没错，没错。看来你似乎不明白如何使用这件物品……";
				next;
				mes "[Yklah]";
				mes "朱诺有一首关于你可能正在寻找的^3355FF‘诅咒之剑’^000000的古老歌曲。";
				next;
				mes "[Yklah]";
				mes "‘即使你向雾另一边的光奔跑，也无法抵达。’";
				next;
				mes "[Yklah]";
				mes "‘山谷彼端传来的钟声，无法握在手中。’";
				next;
				mes "[Yklah]";
				mes "是的，这首歌有些难懂，但据说表达了古代贤者获得诅咒之剑时的感受。";
				//mes "that's how exactly sages in ancient ages felt about obtaining the doomed sword.";
				next;
				mes "[Yklah]";
				mes "如果你仍决心获得诅咒之剑，随时来找我。";
				next;
				mes "[Yklah]";
				mes "既然你已经拥有 Muriniel 印章，我非常愿意帮助你。";
				set dmdswrd_Q,24;
				close;
			case 2:
				mes "[Yklah]";
			mes "嗯？";
			mes "你说天才？在这座充满智者的城市里怎么能这么说？没什么特别的。";
				next;
				mes "[Yklah]";
			mes "而且，如果你是同事，我应该记得你。我不会忘记至少见过一次的人。";
				close;
			case 3:
				mes "[Yklah]";
			mes "啊……GM？";
				next;
				mes "[Yklah]";
			mes "我不明白你在说什么。不过，朱诺有一首关于你所说 GM 的古老歌曲……";
				next;
				mes "[Yklah]";
				mes "'^FF3355Impersonating GMs is punishable with a permanent account block^000000.' But what could it possibly mean?";
				next;
				mes "^3355FFHow depressing!^000000";
				close;
			}
		case 24:
			if (countitem(7030) > 2 && countitem(913) > 9 && countitem(7032) > 0) {
				mes "[Yklah]";
			mes "嗯！干得好，你带齐了物品。试着把它们插入凹槽。";
				next;
				mes "[Yklah]";
			mes "说实话，我以前想过，但这是第一次真正尝试实验。来吧，我想看看会发生什么！";
				next;
				mes "^3355FFYou inserted items";
			mes "放入凹槽。^000000";
				delitem 7030,3; //Claw_Of_Desert_Wolf
				delitem 913,10; //Tooth_Of_Bat
				delitem 7032,1; //Piece_Of_Egg_Shell
				next;
				mes "^3355FF*Crank Crank*^000000";
				mes "^3355FFYou hear a strange sound come from inside the statue.^000000";
				next;
				mes "^3355FF*Click*";
				mes "*Click Click*^000000";
				next;
				mes "^3355FFA small hole opened near the foot of the statue, and a ^9999FF Stamp of Muriniel^3355FF came out of the hole.^000000";
				next;
				mes "^3355FFYou got ^9999FFA piece from the Stamp of Muriniel^3355FF.^000000";
				next;
				mes "[Yklah]";
			mes "嗯？！那块碎片似乎和你的印章契合。试着把它们拼在一起吧？";
				next;
				mes "^3355FFYou join the two stamps together.^000000";
				next;
				mes "^3355FFYou got the";
			mes "真正的 Muriniel 印章。^000000";
				set dmdswrd_Q,25;
				next;
				mes "[Yklah]";
			mes "哦？这个图案是……！！啊，我明白它的作用了。现在，请听我说……";
				next;
				mes "[Yklah]";
			mes "请把石板带到朱诺的知识之岛 Snotora。岛上某处有 Snotora 女神雕像。";
				next;
				mes "[Yklah]";
			mes "雕像附近能找到 ^3355FFSyklah^000000，朱诺三大贤者之一。和他交谈，他会告诉你石板图案的事。";
				next;
				mes "[Yklah]";
			mes "愿上帝照亮你的道路……";
				close;
			}
			else {
				mes "[Yklah]";
			mes "让我告诉你我知道的关于诅咒之剑的一切。有首关于传说诅咒之剑的古老歌曲……";
				next;
				mes "[Yklah]";
				mes "^3355FFYou, the one with sincere faith, who humbly accepts the prosperity of Mineta, the knowledge of Snotora and the honor of Solomon...^000000";
				next;
				mes "[Yklah]";
				mes "^3355FFI hereby grant you this column of light. The Three Sages of Juno will be your guide^000000.";
				next;
				mes "[Yklah]";
			mes "如果你对朱诺有所了解，就知道朱诺由三座岛组成，分别代表繁荣、知识与荣誉。";
				next;
				mes "[Yklah]";
			mes "歌曲中的三位贤者分别代表三座岛。现在你大概猜到我就是其中之一。";
				next;
				mes "[Yklah]";
			mes "朱诺有个传统，选出三位最优秀的贤者代表三座岛。";
				next;
				mes "[Yklah]";
			mes "作为三贤者之一，我会在诅咒之剑旅程中担任你的向导。";
				next;
				mes "^3355FFYklah pointed at a pole of the statue with his finger, and you see that there is a strange pattern engraved on the pole.^000000";
				next;
				mes "[Yklah]";
		mes "现在看看这个。这座雕像用来纪念最初的三贤者之一。查看柱子底部，会看到几个小凹槽。";
				next;
				mes "[Yklah]";
		mes "如果把物品插入凹槽，也许能得到更多关于诅咒之剑的线索。";
				next;
				mes "[Yklah]";
				mes "根据伟大贤者告诉我的故事，我已经确定需要放入凹槽的物品。";
				next;
				mes "[Yklah]";
				mes "你需要……";
				mes "^3355FF3 Claw of Desert Wolf^000000";
				mes "^3355FF10 Tooth of Bat^000000";
				mes "^3355FF1 Piece of Egg Shell^000000.";
				next;
				mes "[Yklah]";
		mes "取得这些物品后回来，我们再谈诅咒之剑。";
				next;
				mes "[Yklah]";
		mes "供你参考，沙漠狼爪可在梦罗克沙漠取得，蝙蝠牙齿可在世界大多数洞穴找到。";
				next;
				mes "[Yklah]";
		mes "最后，蛋壳碎片可从斐扬洞穴的坚硬蛋魔物身上取得。";
				close;
			}
		case 25:
			mes "[Yklah]";
			mes "根据伟大贤者告诉我的故事，我已经确定需要放入凹槽的物品。";
			next;
			mes "[Yklah]";
			mes "你需要……";
			mes "^3355FF3 Claw of Desert Wolf^000000";
			mes "^3355FF10 Tooth of Bat^000000";
			mes "^3355FF1 Piece of Egg Shell^000000.";
			next;
			mes "[Yklah]";
			mes "取得这些物品后回来，我们再谈诅咒之剑。";
			next;
			mes "[Yklah]";
			mes "供你参考，沙漠狼爪可在梦罗克沙漠取得，蝙蝠牙齿可在世界大多数洞穴找到。";
			next;
			mes "[Yklah]";
			mes "最后，蛋壳碎片可从斐扬洞穴的坚硬蛋魔物身上取得。";
			close;
		}
	}
	else {
		mes "[Yklah]";
		mes "^3355FFJuphero^000000...";
		mes "那是古代曾经存在的城市名称。";
		next;
		mes "[Yklah]";
		mes "当时最聪明、最有才华的人生活在那里，利用 Ymir 之心的碎片驱动文明。";
		next;
		mes "[Yklah]";
		mes "遗憾的是，他们滥用了强大力量，不知怎么毁灭了自己。";
		next;
		mes "[Yklah]";
		mes "如果渴望获得上帝的知识，必须先保持谦逊。否则……";
		close;
	}
}
	
yuno,305,207,4	script	Sage Syklah#juno	735,{
	if (dmdswrd_Q == 25 || dmdswrd_Q == 26 || dmdswrd_Q == 27) {
		switch(dmdswrd_Q) {
		case 25:
			mes "[Syklah]";
			mes "那是什么？！难道是 Muriniel 印章？";
			next;
			mes "[Syklah]";
			mes "现在我们决一死战，看看你是否有资格拥有它。准备好！";
			next;
			mes "[Syklah]";
			mes "...";
			mes "呜哈哈哈哈！！！别担心，我只是逗你。Yklah 告诉我你可能会来。";
			next;
			mes "[Syklah]";
			mes "据说 Muriniel 印章会凭自己的意志选择主人，否则不会出现。";
			next;
			mes "[Syklah]";
			mes "尽管我是朱诺三大贤者之一，也从未见过这件物品。";
			next;
			mes "[Syklah]";
			mes "Yklah 对你带来的 Muriniel 印章给了我一个想法，我们也来试试。";
			next;
			mes "[Syklah]";
			mes "Muriniel 印章上的图案与这座^3355FFSnotora 女神雕像^000000上的图案相似。";
			next;
			mes "^3355FFYou see for yourself that, indeed, the pattern on the statue of the Goddess Snotora matches that on the Stamp of Muriniel.^000000";
			next;
			mes "[Syklah]";
			mes "年轻时我了解到一种与雕像有关的传说印泥，但当时无法理解。印泥能有多传奇？";
			next;
			mes "[Syklah]";
			mes "但现在我相信这种印泥可以与 Muriniel 印章一起使用。";
			next;
			mes "[Syklah]";
			mes "虽然我学会了制作这种特殊印泥，但收集所需材料太困难。";
			next;
			mes "[Syklah]";
			mes "好，准备好后请带来以下物品。我想制作传说红色印泥，所以带来……";
			next;
			mes "[Syklah]";
			mes "^3355FF20 Red Herb^000000,";
			mes "^3355FF5 Stone^000000 and";
			mes "^3355FF1 Stone Heart^000000.";
			mes "石心会被用作盛放特殊印泥的瓶子。";
			next;
			mes "[Syklah]";
			mes "我想这就是全部。收集这些物品对你应该不难。祝你好运。";
			set dmdswrd_Q,26;
			close;
		case 26:
			if (countitem(7049) > 4 && countitem(953) > 0 && countitem(507) > 19) {
				mes "[Syklah]";
			mes "哈哈哈……！你已经集齐我要求的物品了。很好，很好。开始吧……";
				delitem 7049,5; //Stone
				delitem 953,1; //Stone_Heart
				delitem 507,20; //Red_Herb
				next;
				mes "^3355FFSage Syklah grinded the stones and stone heart and molded them into a strange shape.^000000";
				next;
				mes "^3355FFHe then ground the red herbs and placed them into the stone mold.^000000";
				next;
				mes "^3355FFAfterwards, he then took a strangely shaped capsule from his pocket, sprinkled some liquid from it, and began to chant a spell...^000000";
				next;
				mes "[Syklah]";
				mes "嗷呜……嘟嘟嘟~哒哒哒……哈哈哈……呜嘿呜嘿呜嘿~";
				mes "- Pah ahhhh !! -";
				next;
				mes "^3355FFThe Stamping Ink of Muriniel has been created, and has been given to you by the sage Syklah.^000000";
				set dmdswrd_Q,27;
				next;
				mes "[Syklah]";
			mes "现在，有了这种印泥，你就可以使用 Muriniel 印章了。";

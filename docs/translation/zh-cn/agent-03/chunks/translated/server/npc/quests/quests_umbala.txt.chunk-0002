	mes "现在，你想做什么？我的力量可以制作粗糙魔法石，也能把纯魔法石分解成粗糙魔法石。";
	next;
	switch (select("制作粗糙魔法石:分解纯魔法石:退出。")) {
	case 1:
		mes "[Puchuchartan]";
		mes "你想制作粗糙魔法石吗？想制作哪种属性？地、水、火、风……";
		mes "...choose one.";
		next;
		switch (select("地:水:火:风")) {
		case 1:
			set .@consume,947; //Horn
			set .@amount,15; 
			set .@success,993; //Yellow_Live
			break;
		case 2:
			set .@consume,946; //Snail's_Shell
			set .@amount,20; 
			set .@success,991; //Crystal_Blue
			break;
		case 3:
			set .@consume,904; //Scorpion's_Tail
			set .@amount,20; 
			set .@success,990; //Boody_Red
			break;
		case 4:
			set .@consume,1013; //Colorful_Shell
			set .@amount,25; 
			set .@success,992; //Wind_Of_Verdure
			break;
		}
		if (countitem(.@consume) >= .@amount) {
			mes "[Puchuchartan]";
			mes "我会放大自然物品中的隐藏力量，制作粗糙魔法石。请选择 1 到";
			mes "'1' to '9.' If you wish to cancel";
			mes "的数字。若不想继续，请输入‘0’。";
			next;
			while(1) {
				input .@input,0,10;
				if (.@input == 0) {
					mes "[Puchuchartan]";
					mes "我明白了，随你决定。需要时再来找我。";
					close;
				}
				else if (.@input > 9) {
					mes "[Puchuchartan]";
					mes "记得选择 1 到 9 的数字。";
					next;
				}
				else {
					break;
				}
			}
			mes "[Puchuchartan]";
			switch(.@success) {
			case 990:
					mes "我把这些尾巴放进"; break;
			case 991:
					mes "我把这些贝壳放进"; break;
			case 992:
					mes "我把这些贝壳放进"; break;
			case 993:
					mes "我把这些角放进"; break;
			}
			mes "沸腾的锅里，施展神圣咒语。记住你输入的数字。";
			next;
			mes "[Puchuchartan]";
			mes "Amba Omba Zatumba! Umba! Ti!";
			mes "Umputaun Eulukaba! Umba! Ha!";
			mes "Julu Humba Rulala! Umba! La!";
			mes "Datuha Ombabalaka! Umba! Si!";
			mes "Sunutaba Abulumba! Umba! Si!";
			next;
			if (rand(1,10) == 1) {
				mes "[Puchuchartan]";
				mes "看来我的力量还不够。";
				mes "我用咒语聚集的自然力量";
				mes "失去焦点并散开了……";
				delitem .@consume,.@amount;
				getitem 910,1; //Garlet
				next;
				mes "[Puchuchartan]";
			mes "看来自然之灵此刻并不和谐。不过稍后再来，我会再试着帮助你。当然，仍有失败的可能。";
				close;
			}
			else {
				mes "[Puchuchartan]";
			mes "这是你想要的魔法石。我费了很大力气制作，请好好利用。";
				delitem .@consume,.@amount;
				getitem .@success,1;
				close;
			}
		}
		else {
			mes "[Puchuchartan]";
			switch (.@success) {
			case 990:
			mes "火属性……我需要充满火之灵的自然物品。";
				next;
				mes "[Puchuchartan]";
			mes "能忍受沙漠炽热的蝎子充满火焰能量。我需要 ^3377FF20 条蝎尾^000000。";
				break;
			case 991:
			mes "水属性……我需要充满水之灵的自然物品。";
				next;
				mes "[Puchuchartan]";
			mes "Ambernite……水之灵藏在它的保护壳中……我需要 ^3377FF20 个蜗牛壳。^000000";
				break;
			case 992:
				mes "风属性……";
				mes "我需要充满风之精灵的";
				mes "自然物品。";
				mes "";
				next;
				mes "[Puchuchartan]";
				mes "Stainer……这种在天空飞行的甲虫";
				mes "拥有风之精灵。";
				mes "";
				mes "I need ^3377FF25 Rainbow Shells^000000.";
				break;
			case 993:
				mes "地属性……我需要充满大地精灵的自然物品。";
				mes "";
				mes "";
				next;
				mes "[Puchuchartan]";
				mes "Horn……栖息在森林中的 Horn";
				mes "充满大地与木之精灵……Horn……";
				mes "";
				mes "I need ^3377FF15 Horn^000000 from Horns.";
				break;
			}
			mes "[Puchuchartan]";
			mes "这就是我需要的全部……";
			mes "准备好后再回来。";
			mes "我会在这里等你。";
			mes "";
			close;
		}
	case 2:
		mes "[Puchuchartan]";
	mes "你想把一块纯净附魔石分解成粗糙魔法石吗？";
	mes "你想分解哪种属性？大地、水、火、风……";
	mes "请选择一种。";
	mes "";
	mes "";
		next;
		switch(select("地:水:火:风")) {
		case 1:
			set .@divide,997; //Great_Nature
			break;
		case 2:
			set .@divide,995; //Mistic_Frozen
			break;
		case 3:
			set .@divide,994; //Flame_Heart
			break;
		case 4:
			set .@divide,996; //Rough_Wind
			break;
		}
		mes "[Puchuchartan]";
	mes "请输入你想分解的附魔石数量。";
	mes "我只能";
	mes "";
	mes "";
		mes "divide up to 10 at a time.";
		next;
		input .@input,0,11;
		if ((.@input > 0) && (.@input < 11)) {
			if (countitem(.@divide) >= .@input) {
				if (checkweight(908,(.@input * 30)) == 0) {
					mes "[Puchuchartan]";
					mes "你现在携带的物品太多了。";
					mes "把一些东西存入卡普拉仓库后再回来，好吗？";
					mes "";
					mes "";
					mes "";
					close;
				}
				mes "[Puchuchartan]";
				mes "我会尝试把这些附魔石还原成粗糙形态。";
				mes "请输入数量，";
				mes "请输入 1 到 9；如果要取消请输入 0。";
				mes "";
				next;
				while(1) {
					input .@input2,0,10;
					if (.@input2 == 0) {
						mes "[Puchuchartan]";
						mes "你想取消吗？";
						mes "如果改变主意，随时回来找我帮忙。";
						mes "";
						mes "";
						close;
					}
					else if (.@input2 > 9) {
						mes "[Puchuchartan]";
						mes "嗯？你需要输入";
						mes "a number from 1 to 9.";
						next;
					}
					else {
						break;
					}
				}
				mes "[Puchuchartan]";
				mes "现在我将吟唱";
				mes "神圣词句。记住你输入的数字！";
				next;
				mes "[Puchuchartan]";
				mes "Umba Umba Kalapum! Umba! Ta!";
				mes "Lukura Ukulele Um! Umba! Ka!";
				mes "Abulaka Tabulakan! Umba! La!";
				mes "Ombaludu Zan Kunu! Umba! Ku!";
				mes "Kum Tum Lakulakun! Umba! Ha!";
				next;
				mes "[Puchuchartan]";
				mes "这是你想要的粗糙魔法石。我费了很大力气制作，请好好利用。";
				while(1) {
					if (.@sha_man == .@input) {
						break;
					}
					else {
						set .@shaman_max,.@shaman_max + rand(6,10);
						set .@sha_man,.@sha_man + 1;
					}
				}
				switch(.@divide) {
				case 994:
					getitem 990,.@shaman_max; //Boody_Red
					break;
				case 995:
					getitem 991,.@shaman_max; //Crystal_Blue
					break;
				case 996:
					getitem 992,.@shaman_max; //Wind_Of_Verdure
					break;
				case 997: 
					getitem 993,.@shaman_max; //Yellow_Live
				}
				delitem .@divide,.@input;
				close;
			}
			else {
				mes "[Puchuchartan]";
				mes "所以，你想要粗糙";
				switch(.@divide) {
				case 994:
					mes "火属性魔法石？那就带来 "+input_want+" 颗纯火魔法石。";
					break;
				case 995:
					mes "水属性魔法石？那就带来 "+input_want+" 颗纯水魔法石。";
					break;
				case 996:
					mes "风属性魔法石？那就带来 "+input_want+" 颗纯风魔法石。";
					break;
				case 997: 
					mes "地属性魔法石？那就带来 "+.@input+" 颗纯地魔法石。";
					break;
				}
				mes "^3377FF"+.@input+" "+getitemname(.@divide)+"^000000.";
				next;
				mes "[Puchuchartan]";
				mes "这就是我需要的全部……准备好后回来。我会在这里。";
				close;
			}
		}
		else {
			mes "[Puchuchartan]";
				mes "嗯？你需要输入 1 到 10 的数字。";
			close;
		}
	case 3:
		mes "[Puchuchartan]";
			mes "我明白了，随你决定。需要时再来找我。";
		close;
	}
}

umbala,221,193,1	script	#Skulldoor	111,{
	if (event_umbala >= 7) {
		warp "um_in",32,71;
		end;
	}
	else {
		mes "^3355FF一个令人不安的人类头骨挂在门旁。门锁得很紧，你进不去。透过钥匙孔，你看到房间里有人移动。^000000";
		next;
		if (select("检查头骨。:退出。") == 1) {
			mes "^3355FF你看到头骨的眼眶是空的。真奇怪……看来宝石可以完美嵌入。^000000";
			next;
			mes "^3355FF你看到头骨左眼眶。你想做什么？^000000";
			next;
		switch(select("保持原样。:放入蓝色宝石。:放入黄色宝石。:放入红色宝石。")) {
			case 1:
				mes "^3355FF你保持眼眶原样。^000000";
				next;
				break;
			case 2:
				set .@insert,717;
				break;
			case 3:
				set .@insert,715;
				break;
			case 4:
				set .@insert,716;
				break;
			}
			if (.@insert) {
				if (countitem(.@insert) > 0) {
					mes "^3355FF你将 "+getitemname(.@insert)+" 放入眼眶。^000000";
					next;
					mes "^3355FF宝石从头骨的嘴里滚了出来。^000000";
					set .@skulldoor,.@skulldoor+1;
					switch (.@insert) {
					case 715: set .@skull,2; break;
					case 716: set .@skull,3; break;
					case 717: set .@skull,1; break;
					}
					delitem .@insert,1;
					getitem .@insert,1;
					next;
				}
				else {
					mes "^3355FFYou forgot to carry "+getitemname(.@insert)+"";
					mes "在身上。因此你无法完成原本的操作。^000000";
					next;
				}
			}
			mes "^3355FF你看到头骨右眼眶。你想做什么？^000000";
			next;
			switch(select("保持原样。:放入蓝色宝石。:放入黄色宝石。:放入红色宝石。")) {
			case 1:
				mes "^3355FF你保持眼眶原样。^000000";
				next;
				break;
			case 2:
				set .@insert2,717;
				break;
			case 3:
				set .@insert2,715;
				break;
			case 4:
				set .@insert2,716;
				break;
			}
			if (.@insert2) {
				if (countitem(.@insert2) > 0) {
					mes "^3355FF你将 "+getitemname(.@insert2)+" 放入眼眶。^000000";
					next;
					mes "^3355FF宝石从头骨的嘴里滚了出来。^000000";
					if (.@insert2 == .@insert) {
						set .@skulldoor,.@skulldoor+1;
					}
					else {
						set .@skulldoor,.@skulldoor+2;
					}
					delitem .@insert2,1;
					getitem .@insert2,1;
					next;
				}
				else {
					mes "^3355FFYou forgot to carry "+getitemname(.@insert2)+"";
					mes "在身上。因此你无法完成原本的操作。^000000";
					next;
				}
			}
			mes "^3355FF..............................^000000";
			next;
			mes "^3355FF..............................";
			mes "..............................^000000";
			next;
			mes "^3355FF..............................";
			mes "..............................";
			mes "..............................^000000";
			next;
			switch(.@skulldoor) {
			case 3:
				if (rand(1,4) != 1) {
					set .@skullopen,1;
				}
				break;
			case 2:
				if (rand(1,2) == 2) {
					set .@skullopen,1;
				}
				break;
			case 1:
				if (rand(1,4) == 1) {
					set .@skullopen,1;
				}
				break;
			default:
				break;
			}
			if (.@skullopen == 0) {
				mes "^3355FFNothing happened.";
		mes "你感觉头骨正对你咧嘴笑。但……这可能只是光线造成的错觉。^000000";
				close;
			}
			else {
				mes "^3355FFSuddenly, a clicking sound comes";
		mes "从头骨眼眶中射出，门打开了。不知不觉间，你仿佛受到无形力量引导，走了进去……^000000";
				close2;
				warp "um_in",32,71;
				end;
			}
		}
		mes "^3355FFYou decided to pass by the door.";
	mes "看起来很难打开。^000000";
		close;
	}
}

// Umbala Domestic Dispute Quest :: um_npc_ryu
//============================================================ 
um_in,139,48,5	script	Phrenetan	783,{
	if (event_umbala >= 3) {
		mes "[Phrenetan]";
	mes "我真受够我丈夫了！！他好像和村里每个女孩调情！";
		next;
		mes "[Phrenetan]";
	mes "如果我再看到他和女人调情……我发誓……我要让他下地狱！！";
		close;
	}
	if (BaseJob == Job_Novice && Upper != 2) {
		mes "[Phrenetan]";
		mes "Umba~ umbaumbah!";

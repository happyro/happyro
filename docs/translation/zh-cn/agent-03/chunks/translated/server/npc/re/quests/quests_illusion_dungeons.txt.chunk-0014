			.@state = 2;

		switch( .@state ) {
		case -1:
			break;
		case 0:
		case 1:
			specialeffect EF_SCREEN_QUAKE;
			mes "[Susceptible Soldier]";
			mes "^FF0000我还需要更多！！！！！！！！！！^000000";
			next;
			mes "[Susceptible Soldier]";
			mes "^FF0000我的宝藏……我的复仇……";
			mes "还不够！！！^000000";
			next;
			mes " - ^424242我是不是忘了什么？^0000CD" + getitemname(25316) + " 5 个^424242，并^0000CD消灭 10 只" + getmonsterinfo("ILL_ASSULTER", MOB_NAME) + "。^000000 -";
			close;
		case 2:
			mes "[Susceptible Soldier]";
			mes "你报仇了吗？对付那些^BDBDBD可怕的^000000怪物？";
			mes "还有我的宝藏……^FF0000嚼^000000，嚼……你带回^BDBDBD我的^000000宝藏了吗？";
			next;
			specialeffect EF_SCREEN_QUAKE;
			mes "[Susceptible Soldier]";
			mes "^FF0000给我^000000！我的宝藏！";
			next;
			mes "[Susceptible Soldier]";
			mes "哈……哈哈……哈哈^BDBDBD哈^000000……哈哈^BDBDBD哈^000000哈哈哈……";
			mes "闪闪发光……闪闪发光……真漂亮，太漂亮了。";
			next;
			mes "[Susceptible Soldier]";
			mes "拿去吧。我不需要它。";
			mes "我现在有我的宝藏了^BDBDBD^000000……闪闪发光……真漂亮。";
			next;
			mes " - ^424242作为交换，我拿到了" + getitemname(25271) + "。没见过真正有价值的东西，他怎么会迷恋这种无用垃圾？^000000 -";
			next;
			mes " - ^424242也许只是活人的想法，认为" + getitemname(25271) + "很珍贵。^000000 -";
			delitem 25316,5;	// Shabby_Metal_Chip
			erasequest 16109;	// Vain Desire
			setquest 16110;	// Vain Desire - Cooldown
			getitem 25271,1;	// IllusionStone
			getexp 1200000,1000000;
			close;
		}
		mes "[Susceptible Soldier]";
		mes "嚼，嘟囔……^FF0000嚼^000000，嚼。^FF0000嚼^000000……";
		mes "该死的^BDBDBD呃^000000……怪……^BDBDBD怪物^000000……";
		next;
		mes "[Susceptible Soldier]";
		mes "全是我的。^BDBDBD应该^000000全^BDBDBD是我的^000000……";
		mes "我的……我的宝藏。^BDBDBD全都^000000是……我的……^FF0000嚼，嚼^000000……";
		next;
		select( "What treasure?", "What monster?" );	// note: the selection doesn't change the dialog
		mes "[Susceptible Soldier]";
		mes "该死的^BDBDBD呃^000000……怪……^FF0000" + getmonsterinfo("ILL_ASSULTER", MOB_NAME) + " 怪物^000000……";
		mes "它们夺走了^BDBDBD我的^000000宝藏^BDBDBD……我的！！宝藏^000000……！！";
		next;
		mes "[Susceptible Soldier]";
		mes "嚼，嘟囔……^FF0000嚼^000000，嚼。";
		mes "嚼，^FF0000嚼^000000……嘟囔……";
		next;
		if (select( "Let me search.", "Okay." ) == 2) {
			mes "[Susceptible Soldier]";
			mes "是的……是我的……^BDBDBD呃^000000……我的^BDBDBD宝藏^000000……";
			mes "我没能拿到^BDBDBD它^000000……该死的^BDBDBD怪^000000……怪物……";
			mes "嚼，^FF0000嚼嚼嚼^000000……";
			close;
		}
		mes "[Susceptible Soldier]";
		mes "你？^BDBDBD你^000000要去吗？";
		mes "去，^BDBDBD去^000000拿回来！我的^BDBDBD宝藏^000000！从它们那里拿回来！我的^BDBDBD宝藏^000000！";
		next;
		mes "[Susceptible Soldier]";
		mes "向" + getmonsterinfo("ILL_ASSULTER", MOB_NAME) + "复仇。^FF0000复仇^000000……嚼嚼……我的^BDBDBD复仇^000000……求你……";
		mes "消灭 10 只……怪物！嚼，^FF0000嚼嚼^000000……把它们^BDBDBD消灭^000000！！！";
		next;
		mes " - ^424242Narin said, I can get some ^0000CD" + getitemname(25316) + "^424242 from here. It would be enough for him. ^0000CDLet me prepare^424242 5 pieces.^000000 - ";
		mes " - ^0000CDI need to get rid of the ^42424210 " + getmonsterinfo("ILL_ASSULTER", MOB_NAME) + " monsters.^000000 - ";
		setquest 16109;	// Vain Desire
		close;
	}
	mes "[An susceptible soldier]";
	mes "嘟囔……^FF0000嚼^000000，嚼。^FF0000嘟囔^000000……";
	mes "该死的^BDBDBD呃^000000……怪……^BDBDBD怪物^000000……";
	next;
	mes "[Susceptible Soldier]";
	mes "全是……我的。^BDBDBD全都^000000可以^BDBDBD是我的^000000……";
	mes "我的……我珍贵的^BDBDBD宝藏^000000……^FF0000嘟囔^000000……";
	if (!.talk)
		donpcevent "Susceptible Soldier#::OnTalk";
	close;

OnTalk:
	.talk = 1;
	switch( rand(3) ) {
	case 0:
		npctalk "嚼……嚼……嚼……嚼……";
		sleep 3000;
		npctalk "我的宝藏……嚼，不能原谅……";
		break;
	case 1:
		npctalk "我的宝藏，如果" + getmonsterinfo("ILL_ASSULTER", MOB_NAME) + "消失了……全部，嚼……嚼……";
		sleep 3000;
		npctalk "嚼……嚼，宝藏……我的宝藏……嚼……嚼……";
		break;
	case 2:
		npctalk "复仇……复仇……嚼……嚼……嚼……嚼……";
		sleep 3000;
		npctalk "我要复仇……向……" + getmonsterinfo("ILL_ASSULTER", MOB_NAME) + "……它们夺走了我的宝藏！";
		break;
	}
	.talk = 0;
	end;

OnInit:
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "ill_turtle == 3" );

	// daily
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "ill_turtle > 10 && checkquest(16105,PLAYTIME) == 2" );
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "ill_turtle > 10 && checkquest(16110,PLAYTIME) == 2" );
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "ill_turtle > 10 && checkquest(16105,PLAYTIME) == -1 && checkquest(16110,PLAYTIME) == -1 && checkquest(16109,HUNTING) == -1" );
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "ill_turtle > 10 && checkquest(16109,HUNTING) == 2 && countitem(25316) > 4" );
	end;
}


tur_d04_i,96,112,1	script	Fragile Woman#illtur	4_F_SLOPPY_WOMAN,{
	disable_items;

	.@char_id = getcharid(0);
	.@account_id = getcharid(3);
	.@player_name$ = strcharinfo(0);

	if (ill_turtle == 4) {
		mes " - ^424242Oops. It's not Archeologist Leiphen for sure.^000000 -";
		next;
		mes "[Fragile Woman]";
		mes "我饿了。帮帮我。我好饿。";
		next;
		unittalk .@account_id, "" + .@player_name$ + " : I'm glad that I found someone who can speak.", bc_self;
		select( "How can I help you?", "Let me help you.", "Please help me." );
		npctalk "我快饿死了。不吃东西的话我会死的。", "", bc_self;
		sleep2 3000;
		npctalk "我饿了。请帮帮我。求你……", "", bc_self;
		mes "[Fragile Woman]";
		mes "我今天、昨天和前天都没吃饭。";
		mes "我快死了。请帮帮我……求你。";
		next;
		unittalk .@account_id, "" + .@player_name$ + " : I'll help. Let me share some food. Are there any animals I can hunt around?", bc_self;
		mes "[Fragile Woman]";
		mes "我要死了。饿死了。";
		mes "我饿了。我快饿死了。";
		next;
		select( "So what do you want...", "Please talk clearly!" );
		npctalk "我现在什么都能吃。请给我点东西。", "", bc_self;
		mes "[Fragile Woman]";
		mes "我今天没吃饭。昨天一整天都饿着。我的孩子也饿着，我丈夫也饿着。";
		mes "我要死了。我们都会死。";
		next;
		unittalk .@account_id, "" + .@player_name$ + " : Haha... I can't communicate... I want to go home.", bc_self;
		mes " - ^424242She told me the other place, ^0000CDthe other^000000 point. Is ^0000CDTurtle Palace^424242 nearby?^000000 -";
		ill_turtle = 5;
		erasequest 16099;	// Stranger on Turtle Island 3
		setquest 16100;	// Stranger on Turtle Island 4
		close;
	}
	if (ill_turtle == 7) {
		setpcblock PCBLOCK_NPC, true;
		cloakoffnpcself( "Archeologist Leiphen#illtur03" );
		npctalk "考古学家莱芬：是这里吗？我来过几次……", "Archeologist Leiphen#illtur03", bc_self;
		sleep2 1000;
		setpcblock PCBLOCK_NPC, false;
		unittalk .@account_id, "" + .@player_name$ + " : Yes. Just right here. Hello, are you ok?", bc_self;

		mes "[Fragile Woman]";
		mes "我饿了。我饿了很久……我要死了。请、请帮帮我。";
		next;
		unittalk .@account_id, "" + .@player_name$ + " : Well, this is the woman here, Professor Leiphen.", bc_self;
		mes "[Archeologist Leiphen]";
		mes "......um.. Hey?";
		next;
		npctalk "我饿了。请帮帮我。我饿了。", "", bc_self;
		sleep2 1000;
		unittalk .@account_id, "" + .@player_name$ + " : I thought it would be difficult to communicate... Let's go to the other people?", bc_self;
		mes "[Archeologist Leiphen]";
		mes "......";
		next;
		mes "[Archeologist Leiphen]";
		mes "你现在在和谁说话？";
		mes "这里除了我们两个没有别人。";
		npctalk "我要死了。死。死。", "", bc_self;
		sleep2 1000;
		unittalk .@account_id, "" + .@player_name$ + " : ......", bc_self;
		next;
		npctalk "啊哈，我找到了。", "", bc_self;
		cloakonnpcself( "Fragile Woman#illtur" );
		specialeffect EF_SCREEN_QUAKE, AREA, "Rancorous Ghost#illtur01";
		specialeffect EF_DANCE1, AREA, "Rancorous Ghost#illtur01";
		cloakoffnpcself( "Rancorous Ghost#illtur01" );
		mes "[Archeologist Leiphen]";
		mes "那……是什么……声音……";
		next;
		specialeffect EF_SCREEN_QUAKE, AREA, "Rancorous Ghost#illtur02";
		specialeffect EF_DANCE1, AREA, "Rancorous Ghost#illtur02";
		cloakoffnpcself( "Rancorous Ghost#illtur02" );
		sleep2 800;
		npctalk "我找到了。", "Rancorous Ghost#illtur03", bc_self;
		specialeffect EF_DANCE1, AREA, "Rancorous Ghost#illtur03";
		cloakoffnpcself( "Rancorous Ghost#illtur03" );
		sleep2 800;
		npctalk "在呼吸！", "Rancorous Ghost#illtur04", bc_self;
		specialeffect EF_SCREEN_QUAKE, AREA, "Rancorous Ghost#illtur04";
		specialeffect EF_DANCE1, AREA, "Rancorous Ghost#illtur04";
		cloakoffnpcself( "Rancorous Ghost#illtur04" );
		sleep2 800;
		npctalk "发现活物。", "Rancorous Ghost#illtur05", bc_self;
		cloakoffnpcself( "Rancorous Ghost#illtur05" );
		sleep2 800;
		npctalk "抓住！", "Rancorous Ghost#illtur06", bc_self;
		specialeffect EF_DANCE1, AREA, "Rancorous Ghost#illtur06";
		cloakoffnpcself( "Rancorous Ghost#illtur06" );
		sleep2 800;
		npctalk "杀！", "Rancorous Ghost#illtur07", bc_self;
		specialeffect EF_SCREEN_QUAKE, AREA, "Rancorous Ghost#illtur07";
		specialeffect EF_DANCE1, AREA, "Rancorous Ghost#illtur07";
		cloakoffnpcself( "Rancorous Ghost#illtur07" );
		sleep2 800;
		npctalk "撕成碎片！", "Rancorous Ghost#illtur01", bc_self;
		mes "[Archeologist Leiphen]";
		mes "啊！这是什么！";
		next;
		cloakoffnpcself( "Girl#illtur02" );
		unittalk .@account_id, "" + .@player_name$ + "：小心，很危险！", bc_self;
		mes "[Girl]";
		mes "把这个放进嘴里。嘘，小声点！";
		next;
		unittalk .@account_id, "" + .@player_name$ + "：嘿，你是之前的女孩？那是什么，龟壳吗？", bc_self;
		mes "[Girl]";
		mes "别呼吸。你也是。";
		next;
		npctalk "考古学家莱芬：还有一个吗？", "Archeologist Leiphen#illtur03", bc_self;
		sleep2 1000;
		npctalk "女孩：别呼吸！别说话！", "Girl#illtur02", bc_self;
		sleep2 1000;
		npctalk "考古学家莱芬：哈……", "Archeologist Leiphen#illtur03", bc_self;
		specialeffect EF_CLOAKING, AREA, "Archeologist Leiphen#illtur03";
		sleep2 1000;
		npctalk "它们在哪里？", "Rancorous Ghost#illtur02", bc_self;
		npctalk "它们刚刚消失了。", "Rancorous Ghost#illtur04", bc_self;
		npctalk "它们不见了。", "Rancorous Ghost#illtur06", bc_self;
		npctalk "怎么可能？", "Rancorous Ghost#illtur01", bc_self;
		npctalk "是谁做的？", "Rancorous Ghost#illtur05", bc_self;
		sleep2 1000;
		npctalk "消失了！", "Rancorous Ghost#illtur03", bc_self;
		npctalk "不见了，完全不见了！", "Rancorous Ghost#illtur07", bc_self;
		npctalk "我看到活物了？", "Rancorous Ghost#illtur05", bc_self;
		npctalk "我要找到它们！", "Rancorous Ghost#illtur04", bc_self;
		npctalk "应该杀掉的！", "Rancorous Ghost#illtur06", bc_self;
		mes "[Girl]";
		mes "现在我看不见你们两个了……但别走。我会小声说话。";
		next;
		npctalk "女孩：……你在这里吗？", "Girl#illtur02", bc_self;
		mes "[Girl]";
		mes "你在这里，对吧？";
		mes "我只说一次，仔细听。";
		next;
		mes "[Girl]";
		mes "咬住那个并屏住呼吸，就不会被发现。";
		mes "快离开这里，回到我们相遇的地方。";
		next;
		mes "[Girl]";
		mes "你第一次遇见我的地方……记得吗？我会在那里等你。";
		next;
		npctalk "不见了。那些活人。", "Rancorous Ghost#illtur05", bc_self;
		sleep2 1000;
		specialeffect EF_DANCE1, AREA, "Rancorous Ghost#illtur03";
		cloakonnpcself( "Rancorous Ghost#illtur03" );
		npctalk "不，我的孩子……", "Rancorous Ghost#illtur03", bc_self;
		sleep2 1000;
		specialeffect EF_DANCE1, AREA, "Rancorous Ghost#illtur07";
		cloakonnpcself( "Rancorous Ghost#illtur07" );
		npctalk "这里的所有人都死了。", "Rancorous Ghost#illtur07", bc_self;
		sleep2 1000;
		specialeffect EF_DANCE1, AREA, "Rancorous Ghost#illtur04";
		cloakonnpcself( "Rancorous Ghost#illtur04" );
		npctalk "我的宝藏……", "Rancorous Ghost#illtur04", bc_self;
		sleep2 1000;
		specialeffect EF_DANCE1, AREA, "Rancorous Ghost#illtur05";
		cloakonnpcself( "Rancorous Ghost#illtur05" );
		npctalk "我们回去吧。", "Girl#illtur02", bc_self;
		sleep2 1000;
		cloakonnpcself( "Girl#illtur02" );
		npctalk "我饿了……好饿。", "Rancorous Ghost#illtur02", bc_self;
		sleep2 1000;
		specialeffect EF_DANCE1, AREA, "Rancorous Ghost#illtur02";
		cloakonnpcself( "Rancorous Ghost#illtur02" );
		cloakoffnpcself( "Fragile Woman#illtur" );
		npctalk "和往常一样。", "Rancorous Ghost#illtur01", bc_self;
		sleep2 1000;
		specialeffect EF_DANCE1, AREA, "Rancorous Ghost#illtur01";
		cloakonnpcself( "Rancorous Ghost#illtur01" );
		npctalk "全都死了……", "Rancorous Ghost#illtur06", bc_self;
		sleep2 1000;
		cloakonnpcself( "Rancorous Ghost#illtur06" );
		sleep2 3000;
		unittalk .@account_id, "" + .@player_name$ + " : We don't have a choice, just believe her. Let's go upward!", bc_self;
		mes "[Archeologist Leiphen]";
		mes "我们走吧！";
		next;
		mes " - ^424242Archeologist Leiphen held his breath and nodded.^000000 - ";
		ill_turtle = 8;
		erasequest 16103;	// The Secret of Strangers
		setquest 16104;	// A long-forgotten story
		close2;
		cloakonnpcself( "Archeologist Leiphen#illtur03" );
		end;
	}
	if (ill_turtle > 10) {
		switch( checkquest(16105,PLAYTIME) ) {
		case -1:
			break;
		case 0:
		case 1:
			mes "[Fragile Woman]";
			mes "我饿了……好饿。我要死了。";
			next;
			mes "[Fragile Woman]";
			mes "眼前的东西我什么都能吃。从头到脚……";
			next;
			mes " - ^424242I should be closer. After dawn, maybe calmer.";
			close2;
			npctalk "我饿了。请帮帮我。我饿了。", "", bc_self;
			end;
		case 2:
			erasequest 16105;	// A short break, and a promise
			break;
		}
		switch( checkquest(16113,PLAYTIME) ) {
		case -1:
			break;
		case 0:
		case 1:
			mes "[Fragile Woman]";
			mes "肉……容易消化的肉。饿了。饿了。太好了。肉……";
			mes "我饿了。还想要。好吃。太美味了。";
			next;
			unittalk .@account_id, "" + .@player_name$ + " : Looking at the happiness she gets with " + getitemname(7564) + ".... I feel sorry.", bc_self;
			mes " - ^424242Still... satisfied. Let's come back after dawn.^000000 -";
			close;
		case 2:
			erasequest 16113;	// Endless Hunger - Cooldown
			break;
		}

		.@quest_16111 = checkquest(16111,HUNTING);
		.@quest_16112 = checkquest(16112,HUNTING);
		if (.@quest_16111 == -1 || .@quest_16112 == -1)
			.@state = -1;
		else if (.@quest_16111 == 2 && .@quest_16112 == 2 && countitem(7564) > 9)
			.@state = 2;

		switch( .@state ) {
		case -1:
			break;
		case 0:
		case 1:
			mes "[Fragile Woman]";
			mes "请猎杀乌龟。^0000CD" + getmonsterinfo("ILL_PERMETER", MOB_NAME) + "、" + getmonsterinfo("ILL_SOLIDER", MOB_NAME) + "、" + getmonsterinfo("ILL_FREEZER", MOB_NAME) + "、" + getmonsterinfo("ILL_HEATER", MOB_NAME) + "，每种 10 只。^000000";
			next;
			npctalk "我要死了。死。死。", "", bc_self;
			mes "[Fragile Woman]";
			mes "给我。^0000CD" + getitemname(7564) + "，10 个。^000000";
			mes "拜托。我需要" + getitemname(7564) + "，不然会饿死，太痛苦了。";
			close;
		case 2:
			if (checkweight(1201,1) == 0) {
				mes "[Fragile Woman]";
				mes "你带着这么重的袋子做什么？清理一下吧。";
				close;
			}
			setpcblock PCBLOCK_NPC, true;
			npctalk "我饿了。请帮帮我。我饿了。", "", bc_self;
			sleep2 500;
			setpcblock PCBLOCK_NPC, false;
			unittalk .@account_id, "" + .@player_name$ + " : I came back. I finished the hunting.", bc_self;

			mes "[Fragile Woman]";
			mes "啊……啊……肉的香味真好。";
			mes "闻起来真香。看起来好美味。请给我。饿了。快点。";
			next;
			unittalk .@account_id, "" + .@player_name$ + " : ...It smells rotten...", bc_self;
			mes "[Fragile Woman]";
			mes "好吃。太好吃了。好开心。真的很棒。";
			next;
			npctalk "女人：咔嚓咔嚓，嚼……", "", bc_self;
			mes " - ^424242......she is holding it with her bare hands and eating..^000000 -";
			next;
			mes "[Fragile Woman]";
			mes "啊哈，我吃饱了。现在不会死了。我吃饱了。";
			mes "给你这个。不过不能吃……";
			next;
			npctalk "我要死了。死。死。", "", bc_self;
			sleep2 500;
			unittalk .@account_id, "" + .@player_name$ + " : ... " + getitemname(25271) + "?", bc_self;
			mes "[Fragile Woman]";
			mes "我把东西都吃了。抱歉，这是我唯一能给你的。";
			delitem 7564,10;	// Rotten_Meat
			erasequest 16111;	// Endless Hunger 1
			erasequest 16112;	// Endless Hunger 2
			setquest 16113;	// Endless Hunger - Cooldown
			getitem 25271,1;	// IllusionStone
			getexp 1200000,1000000;
			close;
		}
		mes "[Fragile Woman]";
		mes "我饿了。帮帮我。求你。好饿。";
		next;
		unittalk .@account_id, "" + .@player_name$ + " : How.. can I help you?", bc_self;
		mes "[Fragile Woman]";
		mes "...Help me? Really? You won't let me die?";
		next;
		mes "[Fragile Woman]";
		mes "那就请猎杀乌龟。^0000CD" + getmonsterinfo("ILL_PERMETER", MOB_NAME) + "、" + getmonsterinfo("ILL_SOLIDER", MOB_NAME) + "、" + getmonsterinfo("ILL_FREEZER", MOB_NAME) + "、" + getmonsterinfo("ILL_HEATER", MOB_NAME) + "，每种 10 只。^000000";
		mes "请带来肉。" + getitemname(7564) + "，10 个。";
		next;
		npctalk "我饿了。请帮帮我。我饿了。", "", bc_self;
		sleep2 500;
		unittalk .@account_id, "" + .@player_name$ + " : It's all rotten meat.", bc_self;
		mes "[Fragile Woman]";
		mes "拜托。不然我会死。饿死……";
		mes "带来肉。^0000CD" + getitemname(7564) + "，10 个。^000000";
		next;
		mes " - ^424242Archeologist Leiphen couldn't eat... But according to Narin, she will be happy. I can only get the " + getitemname(7564) + " in here.^000000 -";
		next;
		npctalk "我要死了。死。死。", "", bc_self;
		if (select( "I will take it.", "I can't help you now." ) == 2) {
			mes "[Fragile Woman]";
			mes "我要死了。我要饿死了。";
			next;
			mes "[Fragile Woman]";
			mes "^FF0000I can eat anything. Really anything. I can eat.. chomp chomp.^000000";
			close;
		}
		mes "[Fragile Woman]";
		mes "谢谢。没有肉吃我会死。";
		mes "现在我还能再活一阵子。";
		unittalk .@account_id, "" + .@player_name$ + " : ......", bc_self;
		setquest 16111;	// Endless Hunger 1
		setquest 16112;	// Endless Hunger 2
		close;
	}
	mes "[Fragile Woman]";
	mes "好饿。饿得动不了了……";
	mes "求你……求你发发慈悲。我饿太久了……";
	if (!.talk)
		donpcevent "Fragile Woman#illtur::OnTalk";
	close;

OnTalk:
	.talk = 1;
	switch( rand(2) ) {
	case 0:
		npctalk "我饿了。请帮帮我。我饿了。";
		sleep 3000;
		npctalk "我现在什么都能吃。请给我点东西。";
		break;
	case 1:
		npctalk "我要饿死了。不吃东西我会死。";
		sleep 3000;
		npctalk "我饿了。请帮帮我。求你……";
		break;
	}
	.talk = 0;
	end;

OnInit:
	// cloakonnpc();
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "ill_turtle == 4" );
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "ill_turtle == 7" );

	// daily
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "ill_turtle > 10 && checkquest(16111,HUNTING) == 2 && checkquest(16112,HUNTING) == 2 && countitem(7564) > 9" );
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "ill_turtle > 10 && checkquest(16105,PLAYTIME) == 2" );
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "ill_turtle > 10 && checkquest(16113,PLAYTIME) == 2" );
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "ill_turtle > 10 && checkquest(16105,PLAYTIME) == -1 && checkquest(16113,PLAYTIME) == -1 && isbegin_quest(16111) == 0" );
	end;
}


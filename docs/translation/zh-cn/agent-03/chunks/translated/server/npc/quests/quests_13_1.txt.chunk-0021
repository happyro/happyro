-	script	Laur_	-1,{
	mes "[Laur]";
	if (ep13_1_edq == 9 || ep13_1_edq == 111 || ep13_1_edq == 121 || ep13_1_edq == 113 || ep13_1_edq == 123) {
		mes "我是劳尔，卢恩·米德加尔特王国国务大臣的助手。你找我有什么事吗？";
		next;
		mes "[Laur]";
		mes "哦，你把米德加尔特远征队的报告带来了。怎么花了这么久？我很早以前就收到你出发的消息了。";
		next;
		mes "[Laur]";
		mes "告诉指挥官，我对你的迟到很不满意。现在，把报告给我。";
		next;
		mes "[Laur]";
		mes "我就知道让佣兵担任指挥官不是个好主意。你看，什么事都不能按时完成。真是的！";
		next;
		delitem 11012,1; //Expedition_Report
		if (ep13_1_edq == 9) set ep13_1_edq,101;
		else if (ep13_1_edq == 111) set ep13_1_edq,112;
		else if (ep13_1_edq == 121) set ep13_1_edq,122;
		else if (ep13_1_edq == 113 || ep13_1_edq == 123) {
			set ep13_1_edq,13;
			changequest 3093,3094;
		}
		mes "...";
		next;
		mes "... ...";
		next;
		mes "... ... ...";
		next;
		mes "[Laur]";
		mes "*咳咳* 谢谢你把报告带来。我想我错怪指挥官了。这份报告完成得非常好。";
		next;
		mes "[Laur]";
		mes "不过别忘了告诉他，以后的远征报告必须按时交给我。明白吗？*咳咳*";
		close;
	}
	else if ((ep13_1_edq == 101) || (ep13_1_edq == 102) || (ep13_1_edq == 103) || (ep13_1_edq == 112) || (ep13_1_edq == 122) || (ep13_1_edq == 13)) {
		mes "你怎么又回来了？你已经把报告交给我了。难道你失忆了吗？";
		next;
		mes "[Laur]";
		mes "你该离开这里，回去继续工作了。";
		close;
	}
	else {
		mes "我是劳尔，卢恩·米德加尔特王国国务大臣的助手。你找我有什么事吗？";
		next;
		mes "[Laur]";
		mes "你能感受到米德加尔特大陆和卢恩·米德加尔特王国正在发生的巨大混乱吗？";
		next;
		mes "[Laur]";
		mes "不过，无论这个世界变得多么危险，总会有一线希望。";
		next;
		mes "[Laur]";
		mes "混乱之外仍有希望与机遇，而我把时空裂隙另一边的世界视为新的希望。";
		close;
	}
}

ra_temple,122,174,3	script	Nuria	918,{
	mes "[Nuria]";
	if (ep13_1_edq == 9 || ep13_1_edq == 101 || ep13_1_edq == 121 || ep13_1_edq == 122 || ep13_1_edq == 103) {
		mes "欢迎，陌生人。我能为你做什么？";
		next;
		mes "[Nuria]";
		mes "哦，我明白了。你带来了时空裂隙另一边的远征报告。";
		next;
		mes "[Nuria]";
		mes "很遗憾，你带来的时间比我预想的晚了许多，不过……它能平安送到，我很高兴。请把它给我。";
		next;
		delitem 11012,1; //Expedition_Report
		if (ep13_1_edq == 9) set ep13_1_edq,111;
		else if (ep13_1_edq == 101) set ep13_1_edq,102;
		else if (ep13_1_edq == 121) set ep13_1_edq,123;
		else if (ep13_1_edq == 122 || ep13_1_edq == 103) {
			set ep13_1_edq,13;
			changequest 3093,3094;
		}
		mes "...";
		next;
		mes "... ...";
		next;
		mes "... ... ...";
		next;
		mes "[Nuria]";
		mes "看到他们目前进展顺利，我很高兴。请告诉指挥官继续努力。";
		next;
		mes "[Nuria]";
		mes "失陪了，现在是祈祷时间。旅途中请多保重。";
		close;
	}
	else if ((ep13_1_edq == 111) || (ep13_1_edq == 102) || (ep13_1_edq == 112) || (ep13_1_edq == 123) || (ep13_1_edq == 113) || (ep13_1_edq == 13)) {
		mes "哦，对了，我已经收到你交来的报告了。别担心，你没有忘记。";
		next;
		mes "[Nuria]";
		mes "回远征营地的路上请注意安全。";
		close;
	}
	else {
		mes "日安，陌生人。愿芙蕾雅祝福你。";
		close;
	}
}

lhz_in01,110,174,5	script	Gerhart	903,{
	mes "[Gerhart]";
	if (ep13_1_edq == 9 || ep13_1_edq == 101 || ep13_1_edq == 111 || ep13_1_edq == 102 || ep13_1_edq == 112) {
		mes "欢迎你，" + strcharinfo(0) + "。怎么花了这么久？";
		next;
		mes "[Gerhart]";
		mes "哦，我是谁？这么说吧……你能维持生计，可有我的功劳。";
		mes "明白了吗？";
		next;
		mes "[Gerhart]";
		mes "你知道我等这份报告等了多久吗？*叹气*……算了，交给我吧。";
		next;
		delitem 11012,1; //Expedition_Report
		if (ep13_1_edq == 9) set ep13_1_edq,121;
		else if (ep13_1_edq == 101) set ep13_1_edq,103;
		else if (ep13_1_edq == 111) set ep13_1_edq,113;
		else if (ep13_1_edq == 102 || ep13_1_edq == 112) {
			set ep13_1_edq,13;
			changequest 3093,3094;
		}
		mes "...";
		next;
		mes "... ...";
		next;
		mes "... ... ...";
		next;
		mes "[Gerhart]";
		mes "嗯……这份报告充分证明了希巴·阿吉普指挥官的能力……很好。";
		next;
		mes "[Gerhart]";
		mes "谢谢你把报告带来。";
		mes "请告诉指挥官继续努力。";
		next;
		mes "[Gerhart]";
		mes "失陪了，我得回去工作。";
		close;
	}
	else if ((ep13_1_edq == 121) || (ep13_1_edq == 103) || (ep13_1_edq == 113) || (ep13_1_edq == 123) || (ep13_1_edq == 122) || (ep13_1_edq == 13)) {
		mes "什么事？你还有事找我吗？";
		next;
		mes "[Gerhart]";
		mes "我已经平安收到报告了。";
		mes "请回去告诉指挥官继续努力。";
		close;
	}
	else {
		mes "什么事？我没时间闲聊。";
		next;
		mes "[Gerhart]";
		mes "如果你有事找我，请和我的秘书谈谈并预约。我的办公室在二楼。";
		close;
	}
}


man_fild01,315,95,3	script	Expedition Scout#1	707,{
	mes "[Expedition Scout]";
	mes "你好。我来自米德加尔特远征队指挥官直接领导的第三侦察队。";
	next;
	mes "[Expedition Scout]";
	mes "伊格丽德教官命令我寻找某样东西。";
	set .@playtime,checkquest(3091,PLAYTIME);
	next;
	switch(select("询问搜索结果。:闲聊。:离开。")) {
	case 1:
		if (ep13_1_edq == 71 || ep13_1_edq == 72) {
			mes "[Expedition Scout]";
			mes "哦，你一定是"+strcharinfo(0)+"。听说你要递送报告。";
			next;
			if (.@playtime == 0 || .@playtime == 1) {
				mes "[Expedition Scout]";
				mes "寻找遗失的页面比想象中困难。完成一轮后再回来。";
				close;
			} else {
				switch(rand(1,6)) {
				case 1:
				case 6:
					set .@i,2;
					break;
				case 3:
					set .@i,3;
					break;
				case 4:
					set .@i,5;
					break;
				case 2:
				case 5:
					set .@i,0;
					break;
				}
				mes "[Expedition Scout]";
				if (.@i) {
					mes "好消息！我找到了"+.@i+"张似乎属于报告的纸。";
					next;
					getitem 6040,.@i; //Some_Of_Report
				} else {
					mes "我已经尽力了，但还没找到任何页面。";
					next;
				}
				if (.@playtime == -1) {
					changequest 3090,3091;
				} else {
					erasequest 3091;
					setquest 3091;
				}
				mes "[Expedition Scout]";
				mes "那么，继续努力！";
				close;
			}
		}
		mes "[Expedition Scout]";
		mes "你是谁？为什么想知道搜索结果？你是军队的人吗？";
		next;
		mes "[Expedition Scout]";
		mes "喂，打断军事行动可是会被逮捕的，你不知道吗？";
		next;
		mes "[Expedition Scout]";
		mes "请立即离开。";
		close;
	case 2:
		mes "[Expedition Scout]";
		mes "抱歉，我正在执勤。下班后再聊吧？";
		close;
	case 3:
		close;
	}
}

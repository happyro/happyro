// Persuing Rayan Moore :: ep13_moc2
//============================================================ 
mid_campin,68,185,3	script	Pursuit Party Leader#1	803,{
	if (checkweight(714,3) == 0) {
		mes "- 携带的物品太多时，无法继续任务。 -";
		close;
	}
	if (mao_morocc2 == 0) {
		if (ep13_ryu == 100 || ep13_start == 100) {
				mes "[Echinacea]";
				mes "哦，冒险者，你来得正是时候。";
				mes "你我都知道不能把时间浪费在无聊的闲聊上，";
				mes "我就直说了。";
				next;
				mes "[Echinacea]";
				mes "大多数远征队来到这里是为了探索灰色沙漠，";
				mes "但我们来这里另有目的。";
				next;
				mes "[Echinacea]";
				mes "你知道这个由撒旦·摩洛克造成的时空裂隙，对吧？";
				next;
				mes "[Echinacea]";
				mes "我们的任务是追捕撒旦·摩洛克，并查明这一切是怎么发生的。";
				mes "你的任务是协助我们，证明自己能成为远征队的优秀成员。";
				next;
				mes "[Echinacea]";
				mes "……嗯……那么，你得……让我想想什么工作最适合你。";
				mes "嗯……我记得有人说他需要帮助……";
				next;
				select("喂，打扰一下。");
				mes "[Echinacea]";
				mes "啊，我知道你能做什么了！";
				mes "有人正在时空裂隙附近进行调查。你可以去帮助他。";
				mes "照他说的做，明白了吗？";
				mes "现在出发吧！";
				next;
				mes "[Echinacea]";
				mes "......";
				mes "对了，冒险者，";
				mes "你叫什么名字？";
				next;
				mes "[" + strcharinfo(0) + "]";
				mes "......";
				mes "......";
				mes "" + strcharinfo(0) + "...";
				mes "......";
				next;
				mes "[Echinacea]";
				mes "啊，你就是";
				mes "" + strcharinfo(0) + ".";
				mes "那么，" + strcharinfo(0) + "，我现在任命你为基德先生的助手。";
				mes "好了，我这边都办妥了，只需要把你的名字登记在案。";
				next;
				mes "[Echinacea]";
				mes "你怎么还在这里？";
				mes "" + strcharinfo(0) + "，你的任务是协助基德先生。";
				mes "请去帮帮他，好吗？";
				set mao_morocc2,1;
				setquest 7012;
				close;
		}
		else {
			mes "[Echinacea]";
			mes "你在这里做什么？";
			mes "只有获准的人员才能进入此区域。";
			mes "尽快回到大陆去。";
			close;
		}
	}
	else if (mao_morocc2 == 1) {
		mes "[Echinacea]";
		mes "你的任务是协助站在时空裂隙，也就是大门附近的基德先生。";
		mes "请去帮帮他，好吗？";
		close;
	}
	else if (mao_morocc2 == 2) {
		mes "[Echinacea]";
		mes "你怎么回来了？";
		mes "你太不负责任了，怎么能放弃这么重要的任务？";
		mes "如果你不想工作，当初为什么要来灰色沙漠？";
		next;
		mes "[Echinacea]";
		mes "唉！我谁也信不过！";
		mes "你知道吗，我在宫殿工作时，曾经……*嘟嘟囔囔*……";
		next;
		mes "- 她的抱怨似乎一时半会儿不会结束。即使你不情愿，最好还是回去帮助基德先生。 -";
		next;
		set mao_morocc2,3;

sp_cor,167,79,1	script	Advance Squad#171_rvs_2	4_F_REBELLION2,{
	if (isbegin_quest(11603) != 2) {
		mes "[Advance Squad]";
		mes "这里漂亮得不可思议，很难相信他们会在这里做实验。连我都想住在这样的地方。";
		close;
	}
	if (isbegin_quest(11603) == 2 && isbegin_quest(17015) == 0) {
		mes "[Advance Squad]";
		mes "问题是，我们不能对他们使用武力。该怎么办？";
		close;
	}
	if (isbegin_quest(17015) == 1) {
		mes "[Advance Squad]";
		mes "你不是说雷根贝勒的副总统要去说服他们吗？你想和我谈什么？";
		close;
	}
	if (isbegin_quest(17016) == 1) {
		mes "[Advance Squad]";
		mes "我觉得这行不通。你觉得Tes会怎么说？战斗还在继续。";
		close;
	}
	mes "[Advance Squad]";
	mes "这里很危险。快去安全区域！";
	close;
}


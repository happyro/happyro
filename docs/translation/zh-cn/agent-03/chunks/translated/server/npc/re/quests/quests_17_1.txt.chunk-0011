sp_cor,122,141,5	script	Tes#171_cor_0	4_M_PHILOFONTES,{
	if (isbegin_quest(17017) == 0) {
		cutin "ep16_tes01",0;
		mes "[Tes]";
		mes "这可能有点难，但请先调查入口。";
		close3;
	}
	if (isbegin_quest(17017) == 1) {
		cloakonnpc "Aas#171_cor",getcharid(0);
		cloakonnpc "Kaya Tos#171_cor",getcharid(0);
		cutin "ep16_tes01",0;
		mes "[Tes]";
		mes "大家没事吧？";
		next;
		cutin "16lei_02",2;
		mes "[Lazy]";
		mes "不，真的，只是一点点，我迟到了吗？这到底是怎么回事，是毒品吗？";
		mes "我真的迟到这么久吗？这到底是什么，为什么大家都受伤了？";
		npctalk "乱成一团，彻底乱套了。没有我你们可活不下去。","Lazy#sp_cor",bc_self;
		next;

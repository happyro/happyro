		mes "[Worker]";
		mes "哦，他们只是很忙！";
		171_worker_talk(77,.@old$);
		next;
		mes "[Worker]";
		mes "他们不像你这么有空，他们还有工作要做！";
		171_worker_talk(78,.@poor$);
		next;
		cutin "ep171_kaya01",2;
		mes "[Kaya]";
		mes "光靠说服不了他们。";
		171_worker_talk(79,.@moc$);
		next;
		cutin "ep16_tes01",2;
		mes "[Tes]";
		mes "嗯……看来没法轻易说服他们，我们先花点时间商量一下。";
		171_worker_talk(80,.@cook$);
		completequest 17015;
		setquest 17016;
		close3;
	}
	if (isbegin_quest(17016) == 1) {
		cutin "ep171_kaya01",2;
		mes "[Kaya]";
		mes "无论我怎么努力说服，他们都不听。改变一个人的想法并不容易。我该和Tes商量一下。";
		close3;
	}
	end;

OnInit:
	cloakonnpc();
	questinfo(QTYPE_QUEST,QMARK_YELLOW,"isbegin_quest(17015) == 1");
	end;
}


					mes "------------ Monster ------------";
					mes "邪恶贪食者(122)";
					mes "搜索者(124)";
					mes "艾奇欧(126)";
					mes "阿加夫(128)";
					mes "--------------------------------";
					F_InfoBoard;
					continue;
				case 5:
					mes "[神圣领域 5F]";
					mes "------------ Monster ------------";
					mes "邪恶贪食者(122)";
					mes "伊西拉(124)";
					mes "搜索者(124)";
					mes "艾奇欧(126)";
					mes "阿加夫(128)";
					mes "--------------------------------";
					next;
					mes "<Gloom Under Night's eyes are so round and cute. I want to make it my pet.. But what's its taming item? I probably can't tame it then.. - Hopeful Explorer Grape>";
					F_InfoBoard;
					continue;
				}
				break;
			}
		}
	}
}

yuno_fild08,82,178,2	script	Signpost#Robot Factory	4_BULLETIN_BOARD2,{
	if (countitem(7509) > 0) {// Luxurious Keycard
		mes "- Your ^0000FFLuxurious Keycard^000000resonates with Signpost and uncovers new information. -";
		next;
	}
	else {
		mes "基尔·海因学院的学生无法进入这里。";
		close;
	}
	while(1) {
		mes "[Robot Factory]";
		mes "为了让冒险者在世界各地轻松冒险，公开从各地冒险者收集的信息。请向冒险者公会提供情报，以便修订信息。";
		mes "-- 冒险者公会 --";
		next;
		.@mo_board = callfunc( "F_AvenBoard",
			1275,"爱丽丝","负责城堡各种杂务的自动人偶。它主要负责清洁周围环境，但会用钢制扫帚攻击入侵者。",
			1738,"康斯坦丁","需要冒险者提供情报。",
			1736,"阿利奥特","需要冒险者提供情报。",
			1737,"阿莉莎","需要冒险者提供情报。",
			1735,"爱丽瑟","需要冒险者提供情报。",
			1733,"基尔","需要冒险者提供情报。",
			1734,"基尔-D-01","需要冒险者提供情报。" );
		if (.@mo_board == 1) {
			mes "[Robot Factory]";
			mes "机器人制造工厂由 2 层组成，出现的怪物大多为无形。怪物会不断自爆来击退入侵者，请务必小心。";
			next;
			while(1) {
				switch( select( "机器人制造工厂 1F","机器人制造工厂 2F","取消" ) ) {
				case 1:
					mes "[机器人制造工厂 1F]";
					mes "------------ Monster ------------";
					mes "爱丽丝(100)";
					mes "康斯坦丁(108)";
					mes "阿利奥特(112)";
					mes "阿莉莎(112)";
					mes "爱丽瑟(115)";
					mes "--------------------------------";
					F_InfoBoard;
					continue;
				case 2:
					mes "[机器人制造工厂 2F]";
					mes "------------ Monster ------------";
					mes "基尔(90)";
					mes "康斯坦丁(108)";
					mes "阿利奥特(112)";
					mes "阿莉莎(112)";
					mes "爱丽瑟(115)";
					mes "--------------------------------";
					next;
					mes "<I don't know why but there are 2 types of Kiel. Kiel and Kiel-D-01... Kiel-D-01 is the newer version of the two.. Should I request Kiel to make me a robot too? - Greedy Explorer Grape>";
					F_InfoBoard;
					continue;
				}
				break;
			}
		}
	}
}

tha_t01,142,78,0	script	Guide#Thanatos1	CLEAR_NPC,{
	mes "[Thanatos Tower Guide]";
	if (thana_tower == 0) {
		mes "达纳托斯塔共有 12 层，但只有 3 层对公众开放。想要继续前进，必须与“^0000FF雷根贝勒^000000”签订契约。";
		next;
		mes "[Thanatos Tower Guide]";
		mes "根据情报，这里共有 12 层。进入地下城前请为各种情况做好准备……";
		next;
		mes "[Public Announcement]";
		mes "请不要触碰它。只有与“^0000FF雷根贝勒^000000”签订契约的人才能继续前进。";
		emotion ET_HUK;
		close;
	}
	mes "达纳托斯塔共有 12 层，但只有 3 层对公众开放。想要继续前进，必须与“^0000FF雷根贝勒^000000”签订契约。";
	next;
	mes "[Thanatos Tower Guide]";
	mes "根据情报，这里共有 12 层。进入地下城前请为各种情况做好准备……";
	next;

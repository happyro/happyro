lhz_cube,234,97,0	script	Signpost#Somatology	2_BULLETIN_BOARD,{
	while(1) {
		mes "[生化实验室]";
		mes "为了让冒险者在世界各地轻松冒险，公开从各地冒险者收集的信息。请向冒险者公会提供情报，以便修订信息。";
		mes "-- 冒险者公会 --";
		next;
		.@mo_board = callfunc( "F_AvenBoard",
			1613,"金属波利","乍看像普通波利，但实际上由机械零件组成。",
			1627,"按察使","肉眼几乎看不见。冒险者经常在毫无察觉的情况下遭到它的攻击。",
			1682,"移除者","曾是艾因布洛克消防队成员。矿井中发生不幸事故后，它变成了凶猛的怪物。",
			1653,"维克比内·特雷斯","年龄和动机都未知的盗贼。因不明原因闯入实验室，很快被捕获并成为样本。它是凶猛且出人意料地具有女性气质的怪物。",
			1655,"艾伦德·艾比希","曾走上服事道路的男孩。不幸落入未知组织的阴谋，变成了样本。",
			1657,"劳雷尔·温德","曾经天赋异禀、前途光明的魔法师。不幸被卷入生化实验并成为样本。",
			1654,"阿米尔·迪恩兹","相信时间与金钱法则的女商人。某天遇到一名旅行中的剑士后，开始与她同行。",
			1656,"卡瓦奇·伊卡洛斯","曾经的猎人，但很快被制服并成为雷根贝勒的样本。如今他与其他样本一同在生化实验室中徘徊。",
			1681,"双子星-S58","经历过变异的未知生物。它很喜欢自己的男性外表。",
			1652,"伊格尼杰姆·赛尼亚","曾经无忧无虑的流浪骑士。她在一次旅行中遇到女商人，但两人被雷根贝勒抓去当作样本。",
			1635,"艾勒梅斯·盖尔","曾经的十字斩首者，想比其他刺客更快。他的野心让他成为生化实验样本。",
			1637,"玛嘉雷特·索林","曾前往里希塔乐镇训练的高阶祭司。出发后不久被雷根贝勒制服并变成样本。",
			1638,"赛西尔·达蒙","曾与环境共存的狙击手。但成为生化实验样本后，她的性格发生了惊人的变化。",
			1639,"凯特莉娜·凯隆","年少时从魔法学校毕业的高阶法师。她的才能引起雷根贝勒注意，最终被捕获成为样本。",
			1634,"赛依连·温莎","以勇猛闻名的前任领主骑士。他保护附近冒险者时被制服并成为样本。",
			1636,"霍华德·艾尔代森","被欺骗而自愿成为样本的前任神工匠。生前除了锻造武器，对其他事毫无兴趣。",
			1658,"Boss 伊格尼杰姆·赛尼亚","冒险者们熟知的前任骑士。为了揭露雷根贝勒的阴谋，她自愿被带进实验室，却无法逃脱命运。",
			1640,"领主骑士赛依连","需要冒险者提供情报。",
			1641,"十字斩首者艾勒梅斯","需要冒险者提供情报。",
			1643,"高阶祭司玛嘉雷特","需要冒险者提供情报。",
			1644,"狙击手赛西尔","需要冒险者提供情报。",
			1645,"高阶法师凯特莉娜","需要冒险者提供情报。",
			1648,"神工匠霍华德","需要冒险者提供情报。" );
		if (.@mo_board == 1) {
			mes "[生化实验室]";
			mes "生化实验室由 3 层组成，出现的怪物大多为人形。它们非常强大，请务必与其他冒险者一起探索。";
			next;
			while(1) {
				switch( select( "生化实验室 1F","生化实验室 2F","生化实验室 3F","取消" ) ) {
				case 1:
					mes "[生化实验室 1F]";
					mes "------------ Monster ------------";
					mes "金属波利(81)";
					mes "按察使(95)";
					mes "移除者(121)";
					mes "维克特利(132)";
					mes "艾伦德·艾比希(133)";
					mes "劳雷尔·维达(133)";
					mes "阿米尔·迪恩兹(134)";
					mes "卡瓦奇·伊卡洛斯(135)";
					mes "双子星-S58(135)";
					mes "伊格尼杰姆·赛尼亚(136)";
					mes "--------------------------------";
					F_InfoBoard;
					continue;
				case 2:
					mes "[生化实验室 2F]";
					mes "------------ Monster ------------";
					mes "移除者(121)";
					mes "维克特利(132)";
					mes "艾伦德·艾比希(133)";
					mes "劳雷尔·维达(133)";
					mes "阿米尔·迪恩兹(134)";
					mes "卡瓦奇·伊卡洛斯(135)";
					mes "双子星-S58(135)";
					mes "伊格尼杰姆·赛尼亚(136)";
					mes "艾勒梅斯·盖尔(140)";
					mes "--------------------------------";
					next;
					mes "<There are even places like these.. Conducting experiments on human specimen.. MVP Egnigem Cenia... She's.. - Tearful Explorer Grape>";
					F_InfoBoard;
					continue;
				case 3:
					mes "[生化实验室 3F]";
					mes "------------ Monster ------------";
					mes "艾勒梅斯·盖尔(140)";
					mes "玛嘉雷特·索林(140)";
					mes "赛西尔·达蒙(141)";
					mes "凯特莉娜·凯隆(141)";
					mes "赛依连·温莎(142)";
					mes "霍华德·艾尔代森(142)";
					mes "--------------------------------";
					next;
					mes "<I've finally reached here.. Who's conducting these experiments.. What did they do to these people? Eremes.. Margaretha.. Cecil.. Kathryne.. Seyren.. Howard.. ... - Extremely tearful explorer Grape>";
					F_InfoBoard;
					continue;
				}
				break;
			}
		}
	}
}


						mes "是的，从它独特的形状来看，这就是被诅咒的翡翠。和我一样，你现在拥有四大诅咒宝石之一。";
						next;
					}
					else {
						mes "[Ibrahim]";
						mes "嗯？你是不是把翡翠放错地方了？我的意思是，它不在你身上……";
						close;
					}
				}
				mes "[Ibrahim]";
				mes "告诉我，你打算怎么处理不祥翡翠？";
				next;
				switch(select("我要卖掉它。:我要研究它。")) {
				case 1:
					mes "[Ibrahim]";
					mes "哦，你不打算留着？真希望我买得起……不过，买毁灭之钻已经让我够头疼了。";
					next;
					mes "[Ibrahim]";
					mes "你寻找钻石时已经见过几位著名珠宝商。为什么不问问他们是否愿意买下你的不祥翡翠？";
					set jewel_nd,1;
					close;
				case 2:
					mes "[Ibrahim]";
					mes "啊，我赞赏你对知识的渴望和追求真理的决心。如果你真想让专家看看翡翠，就去找科莫多的这位学者。";
					next;
					mes "[Ibrahim]";
					mes "这个人是古董鉴定师，专门研究古代遗物和宝藏。我强烈建议咨询他，他对我的宝石研究帮助极大。";
					set jewel_nd,10;
					close;
				}
			}
			else if ((treasure_nd > 10) && (BaseLevel < 66)) {
				mes "[Ibrahim]";
				mes "我听说你从梦罗克的一位朋友那里得到不祥翡翠。提醒你，你可能不够强大，无法驾驭它的力量。小心。";
				next;
				mes "[Ibrahim]";
				mes "如果不警惕，它的诅咒可能毁掉你。明白吗？";
				close;
			}
			else {
				mes "[Ibrahim]";
				mes "谢谢你为我所做的一切。我会继续研究诅咒宝石的力量，需要你帮助时再联系。保重~";
				close;
			}
		}
		else if (jewel_nd == 1) {
			mes "[Ibrahim]";
		mes "我没有足够资金按合理价格买下你的翡翠，但你可以问问其他珠宝商。他们也许有兴趣。";
			close;
		}
		else if (jewel_nd == 2) {
			mes "[Ibrahim]";
		mes "啊，你回来了~成功卖掉不祥翡翠了吗？";
			next;
			select("大家似乎都很害怕！");
			mes "[Ibrahim]";
		mes "啊，我明白了。他们一定太害怕那颗宝石的诅咒。嗯，真奇怪。";
			next;
			mes "[Ibrahim]";
		mes "我想毁灭之钻被认为相当安全，毕竟存在一段时间也没发生奇怪事件。";
			next;
			mes "[Ibrahim]";
		mes "你刚挖出翡翠？现在卖掉可能还太早。想想看，没多少人愿意拿那颗宝石试运气。";
			next;
			mes "[Ibrahim]";
		mes "啊，我有个主意。为什么不请我在科莫多的学者朋友检查它？也许你……";
				mes "可以进一步了解翡翠所谓的诅咒。";
			next;
			mes "[Ibrahim]";
				mes "我会提前给他发消息，让他知道你要来，好吗？";
			set jewel_nd,9;
			close;
		}
		else if ((jewel_nd == 9) || (jewel_nd == 10)) {
			mes "[Ibrahim]";
			mes "为什么不去拜访我在科莫多的学者朋友，请他检查你的不祥翡翠？越了解所谓的诅咒越好。祝你好运！";
			close;
		}
		else {
			mes "[Ibrahim]";
				mes "哦，那么你已经";
			mes "目前对不祥翡翠了解多少？嗯，是的，非常有趣。祝你的研究顺利~";
			close;
		}
	}
	mes "[Ibrahim]";
	mes "你听说过四大诅咒宝石吗？我想找回我的毁灭之钻，但持有者把它藏得很好……";
	close;

OnTouch:
if ((diamond_edq == 14) && (BaseLevel > 65)) {
	mes "[Ibrahim]";
	mes "嘘，冒险者！你是 "+ strcharinfo(0) +"，对吧？我有件事想私下和你谈！";
		close;
	}
	end;
}

alberta,102,80,3	script	Jhonnita	86,{
	if ((diamond_edq == 15) || (diamond_edq == 16)) {
		mes "[Jhonnita]";
	mes "哦，见到新面孔总是很开心~你是想买还是卖宝石？我们只提供最好的。哈哈哈！";
		next;
		switch(select("最受欢迎的宝石是什么？:你知道毁灭之钻吗？")) {
		case 1:
			mes "[Jhonnita]";
			mes "啊，看看这颗光彩夺目的红宝石。是不是令人屏息？特价就能买到，只要";
			mes "1,000,000 zeny!";
			next;
			mes "[Jhonnita]";
			mes "等等，你去哪——？该死，我不该加价这么多。新手错误，新手错误！我可是专业人士！";
			close;
		case 2:
			mes "[Jhonnita]";
			mes "毁灭之钻？嘿嘿！像你这样的新手不会懂它的真正价值。我非常想要它，但那个 Ibrahim 比我幸运多了……";
			next;
			mes "[Jhonnita]";
			mes "想到输给他我就很沮丧。所有大珠宝商都在争夺四大诅咒宝石……但目前只出现了一颗。";
			close;
		}
	}
	else if (diamond_edq == 26) {
		if (jewel_nd == 0) {
			mes "[Jhonnita]";
			mes "嘿，你看起来很眼熟。你不是我的常客吧？不，不可能。你的穿着不够富裕。别介意。";
			close;
		}
		else if (jewel_nd == 1) {
			mes "[Jhonnita]";
			mes "你是来卖 Garlet，还是来";
		mes "是来把一生积蓄花在我的珠宝上吗？";
			next;
		switch(select("给我看看珠宝……:我有一颗稀有翡翠要卖……")) {
			case 1:
				mes "[Jhonnita]";
			mes "给你看看货也没什么，但……我怀疑你买不起。珠宝可不便宜。";
				next;
				if (Sex == SEX_MALE) {
					mes "[Jhonnita]";
					mes "哦，我明白了。你想买一件送给某个女人。真典型。你就不能想个更有创意的方式赢得女人的爱吗？";
					close;
				}
				else {
					mes "[Jhonnita]";
					mes "抱歉，亲爱的，我严格禁止只看不买。";
					close;
				}
			case 2:
				if (countitem(7725) > 0) {
					mes "[Jhonnita]";
					mes "稀有翡翠，嗯？最好别是什么 Garlet 或 Zargon！你们有时会犯这种错。好，让我看看……";
					next;
					mes "[Jhonnita]";
					mes "......";
					mes "嗯……";
					next;
					mes "[Jhonnita]";
					mes "...........................Um.";
					mes "这颗翡翠好得惊人，但我不能接手。呃，你可以走了吗？";
					next;
					mes "[" + strcharinfo(0) + "]";
					mes "嗯？为什么？";
					next;
					mes "[Jhonnita]";
					mes "滚、滚出我的店！去……去斐扬找 Kimeunbang！对，别再回来！";
					set jewel_nd,2;
					close;
				}
				else {
					mes "[Jhonnita]";
				mes "我说什么来着？我不想再在店里见到你！";
					close;
				}
			}
		}
		else if (jewel_nd == 2) {
			mes "[Jhonnita]";
			mes "听着，我直说吧。珠宝商之间消息传得很快。知道你有那颗宝石后，没人会接近你。明白了吗？请……离远点……";
			close;
		}
		else {
			mes "[Jhonnita]";
			mes "我不想和你或你那颗奇怪翡翠有任何关系。你还不走吗？滚开！";
			close;
		}
	}
	else {
		mes "[Jhonnita]";
		mes "你是来买还是卖珠宝？我总是高价买、低价卖。珠宝方面的需求都来找我吧~";
		close;
	}
}

payon,69,65,5	script	Kimeunbang	89,{
	if (diamond_edq == 15) {
		mes "[Kimeunbang]";
		mes "呼呼……嗯？为什么叫醒我？我正做着好梦。去别的珠宝店吧，我不想开门。";
		next;
		switch(select("怎么了？:毁灭之钻？")) {
		case 1:
			mes "[Kimeunbang]";
			mes "我只是很失望。我差点就拿到毁灭之钻了。就差一点！我的生意伙伴 Belder 从某个可怜虫手里抢走了它。";
			next;
			mes "[Kimeunbang]";
			mes "不知怎么，Belder 最后把宝石还了回去。我";
			mes "我本来要从原主人手里买下宝石，但这个狂妄的珠宝商抢先得手。可恶！";
			next;
			mes "[Kimeunbang]";
			mes "这是惨重的失败。我无法入睡，也不想工作。唉，谢谢你让我倾诉，感觉好多了。";
			next;
			mes "[Kimeunbang]";
			mes "给，把这个当作小礼物。不是所有珠宝商都像你想的那么贪婪。嘿。";
			getitem 722,1; //Scarlet_Jewel
			set diamond_edq,16;
			close;
		case 2:
			mes "[Kimeunbang]";
			mes "哦！那颗钻石正是我痛苦的根源！我差点就得到它……但有人抢在我前面拿走了。啊！";
			close;
		}
	}
	else if (diamond_edq == 26) {
		if (jewel_nd == 0) {
			mes "[Kimeunbang]";
			mes "我近期不想开店，但你以后随时可以再来。";
			close;
		}
		else if (jewel_nd == 1) {
			mes "[Kimeunbang]";
			mes "哦，你好。看来我又重新营业了~";
			next;
			switch(select("我有宝石要卖。:你还好吗？")) {
			case 1:
				mes "[Kimeunbang]";
				mes "真的吗？好，给我一点时间鉴定你的宝石。";
				next;
				if (countitem(7725) > 0) {
					mes "[Kimeunbang]";
					mes "...........";
					mes "...........";
					next;
					mes "[Kimeunbang]";
					mes "抱歉，我不能买这颗翡翠。它……风险太大。我听到的传闻实在太可怕。";
					set jewel_nd,2;
					close;
				}
				else {
					mes "[Kimeunbang]";
				mes "嗯？你说的宝石在哪里？忘记带了吗？";
					close;
				}
				break;
			case 2:
				mes "[Kimeunbang]";
			mes "我甚至不想谈生意。我其实一直在考虑永久关店。";
				close;
			}
		}
		else if (jewel_nd == 2) {
			mes "[Kimeunbang]";
			mes "附近没有珠宝商愿意买那颗诅咒翡翠。真的很抱歉。不过你可以去找 Ibrahim，他拿到过毁灭之钻。";
			close;
		}
		else {
			mes "[Kimeunbang]";
		mes "唉……宝石生意的压力终于压垮我了。算了，我也算风光过……";
			close;
		}
	}
	else {
		mes "[Kimeunbang]";
		mes "我近期不想开店，但你以后随时可以再来。";
		close;
	}
}

geffen,128,153,3	script	Leblo	883,{
	if ((diamond_edq == 15) || (diamond_edq == 16)) {
		mes "[Leblo]";
		mes "哦，我听说过你。你就是一直在询问毁灭之钻的人。";
		next;
		emotion ET_HUK, playerattached();
		mes "[Leblo]";
		mes "别太惊讶，珠宝行业消息传得很快。如果你想了解更多，得先为我做件事。成交吗？";
		next;
		switch(select("成交。:不用了，谢谢。")) {
		case 1:
			mes "[Leblo]";
			mes "我最近一直腰痛，药物都不起作用。于是去看斐扬的一位名医，但";

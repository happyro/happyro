				mes "哦，你还没准备好一切吗？慢慢来，只要没忘记需要带什么。你记得吧？";
				next;
				mes "[Engel]";
				mes "^FF00005 Mini Furnace^000000,";
				mes "^FF00002 Oridecon Hammer^000000,";
				mes "以及 ^ff00001 个优质铁砧^000000。你只需要这些！";
				next;
				mes "[Engel]";
				mes "记住，有更高品质的铁砧，我修复啜泣星光的成功率更高。否则……";
				close;
			}
			else {
				mes "还没准备好？没关系，慢慢来。只要没忘记所有必需品。带着这么重要的矿石，怎么会忘呢？";
				close;
			}
		}
	}
	else if (sign_q < 139) {
		mes "最近过得怎么样？需要我的专业知识时尽管来问我，好吗？";
		close;
	}
	else if (sign_q == 139) {
		mes "最近过得怎么样？你看起来不错。今天有什么我能帮忙的吗？";
		next;
		select("我需要你的帮助。");
		mes "[Engel]";
		mes "哈哈，这次带来了什么？能一路带到这里，一定很重要。";
		next;
		select("请看看这个。");
		mes "[Engel]";
		mes "这不是……？！太惊人了，光看就能感受到力量！你真不简单！你怎么找到这些奇物的？";
		next;
		mes "[Engel]";
		mes "能见到这种东西我觉得自己很幸运。大多数铁匠一生可能只见过一次，更别提亲手加工……";
		next;
		mes "[Engel]";
		mes "嗯……加工它需要很长时间。遗憾的是，我甚至无法估计时间……但我会尽力。";
		delitem 7314,1; //The_Sign
		set sign_q,140;
		set .@stime_e,gettime(DT_HOUR);
		if (.@stime_e < 2) set sign_sq,1;
		else if (.@stime_e < 4) set sign_sq,2;
		else if (.@stime_e < 6) set sign_sq,3;
		else if (.@stime_e < 8) set sign_sq,4;
		else if (.@stime_e < 10) set sign_sq,5;
		else if (.@stime_e < 12) set sign_sq,6;
		else if (.@stime_e < 14) set sign_sq,7;
		else if (.@stime_e < 16) set sign_sq,8;
		else if (.@stime_e < 18) set sign_sq,9;
		else if (.@stime_e < 20) set sign_sq,10;
		else if (.@stime_e < 22) set sign_sq,11;
		else set sign_sq,12;
		close;
	}
	else if (sign_q == 140) {
		set .@stime_e1,gettime(DT_HOUR);
		if (.@stime_e1 < 2) {
			if (sign_sq == 11) {
				set .@pass_s1,1;
			}
		}
		else if (.@stime_e1 < 4) {
			if (sign_sq == 12) {
				set .@pass_s1,1;
			}
		}
		else if (.@stime_e1 < 6) {
			if (sign_sq == 1) {
				set .@pass_s1,1;
			}
		}
		else if (.@stime_e1 < 8) {
			if (sign_sq == 2) {
				set .@pass_s1,1;
			}
		}
		else if (.@stime_e1 < 10) {
			if (sign_sq == 3) {
				set .@pass_s1,1;
			}
		}
		else if (.@stime_e1 < 12) {
			if (sign_sq == 4) {
				set .@pass_s1,1;
			}
		}
		else if (.@stime_e1 < 14) {
			if (sign_sq == 5) {
				set .@pass_s1,1;
			}
		}
		else if (.@stime_e1 < 16) {
			if (sign_sq == 6) {
				set .@pass_s1,1;
			}
		}
		else if (.@stime_e1 < 18) {
			if (sign_sq == 7) {
				set .@pass_s1,1;
			}
		}
		else if (.@stime_e1 < 20) {
			if (sign_sq == 8) {
				set .@pass_s1,1;
			}
		}
		else if (.@stime_e1 < 22) {
			if (sign_sq == 9) {
				set .@pass_s1,1;
			}
		}
		else {
			if (sign_sq == 10) {
				set .@pass_s1,1;
			}
		}
		if (.@pass_s1 == 1) {
			mes "真是……太美了！不知道这辈子还能不能再见到这样的东西……";
			next;
			mes "[Engel]";
			mes "哦，你回来得正好。虽然这是我最困难的工作之一，但我相信你会满意。只有少数铁匠有幸哪怕一次加工这种东西。";
			next;
			mes "[Engel]";
			mes "现在它归你了。谢谢你给我挑战高难度锻造的荣誉。";
			set sign_q,141;
			getitem 2644,1; //The_Sign_
			close;
		}
		else {
		mes "我还没完成，请理解，处理如此珍贵的东西必须非常小心。但别担心，完成后它的内在力量会显现。";
			close;
		}
	}
	else {
		mes "有时，只有独自训练才能提升自己。但永远别忘了那些真正关心你的人。正是他们让一切努力都有意义。";
		close2;
		emotion ET_THINK;
		end;
	}
}

gef_tower,118,36,4	script	Annoyed Man	64,{
	callfunc "F_UpdateSignVars";
	mes "[Dhota]";
	if (sign_q < 72) {
		mes "嗯……";
		mes "不可能是这样……";
		mes "我寻找的答案";
		mes "究竟会是什么？";
		mes "^333333*叹气……*^000000";
		emotion ET_HNG;
		close;
	}
	else if (sign_q == 72) {
		if (BaseClass == Job_Mage) {
			mes "哇～";
			mes "他到底为什么要去那里……！";
		}
		else {
			mes "你连魔法师都不是，";
			mes "更别说巫师、贤者、术士或法师了。";
			mes "何必爬这座塔？";
		}
		mes "你来这里做什么？！";
		emotion ET_HNG;
		next;
		input .@input$;
		if ((.@input$ == "Metz Brayde") || (.@input$ == "Sobbing Starlight")) {
			mes "[Dhota]";
			mes "嗯？";
			if (.@input$ == "Metz Brayde") {
				mes "你刚才说是来找";
				mes "Metz Brayde 的？";
			}
			if (.@input$ == "Sobbing Starlight") {
				mes "是为了啜泣星光，对吧？";
			}
			next;
			mes "[Dhota]";
			mes "...";
			emotion ET_THINK;
			next;
			mes "[Dhota]";
			mes "...";
			mes "......";
			emotion ET_THINK;
			next;
			mes "[Dhota]";
			mes "...";
			mes "......";
			mes "呜哇啊啊～！";
			emotion ET_ANGER;
			next;
			mes "[Dhota]";
			mes "对了，他要找的是那个";
			mes "擅长处理宝石之类东西的人。";
			mes "嗯，他现在不在这里。";
			mes "他去了科莫多附近，";
			mes "调查某些部落居民什么的。";
			set sign_q,73;
			emotion ET_HNG;
			close;
		}
		else {
			mes "[Dhota]";
			mes "你说什么……？";
			mes "我完全不知道你";
			mes "在说些什么！";
			mes "没事可说就别烦我！";
			close;
		}
	}
	else {
		mes "嗯……";
		mes "不可能是这样……";
		mes "我寻找的答案";
		mes "究竟会是什么？";
		mes "^333333*叹气……*^000000";
		emotion ET_HNG;
		close;
	}
}

umbala,163,256,3	script	Native#_s	781,{
	callfunc "F_UpdateSignVars";
	if (event_umbala >= 3) {
		mes "[Laotan]";
		if (sign_q < 73) {
		mes "啊，我真想要一张";
		mes "微笑先生面具！";
		mes "可是那种面具要去哪里找？";
		mes "嗯，要是有肉可以吃，";
		mes "我就很开心了！";
			emotion ET_DELIGHT;
			close;
		}
		else if (sign_q == 73) {
		mes "嗯……？";
		mes "村里来了个新人？";
		mes "我好像认识他！没错，我认识！";
			next;
			mes "[Laotan]";
			if (countitem(2278) > 0) {
				mes "天哪！";
				mes "你有微笑先生面具！";
				mes "可以把它给我吗？";
				mes "求求你了……？";
				next;
			switch(select("好的～！:^FF0000不。^000000")) {
				case 1:
					mes "[Laotan]";
					mes "好耶～！";
					mes "谢谢你谢谢你，";
					mes "谢谢你谢谢你，";
					mes "真的太感谢了！";
					next;
					mes "[Laotan]";
					mes "对了～！";
					mes "那个穿着滑稽衣服的怪人曾在村里待了一阵子，但自从他进了那棵大树，就没人见过他了！";
					delitem 2278,1; //Mr_Smile
					set sign_q,74;
					close;
				case 2:
					mes "[Laotan]";
					mes "我……";
					mes "我只是……";
					mes "我……呜哇啊啊！";
					close;
				}
			}
			else {
				mes "等等。";
				mes "我知道了～！";
				mes "你给我找一张微笑先生面具，";
				mes "好不好？";
				close;
			}
		}
		else {
			mes "我太喜欢我的微笑先生面具了！";
			mes "我要把它给所有朋友看！";
			mes "再次谢谢你！你真是";
			mes "个大好人，你知道吗？";
			close;
		}
	}
	else {
		mes "[??????]";
		mes "啾巴？";
		mes "啾啾啾啾恰巴？";
		mes "呜姆呜姆呜姆达巴。哔哩哔哩？";
		mes "萨巴鲁库姆巴索罗。呵呵～";
		close;
	}
}

um_in,27,23,3	script	Fastidious-Looking Guy	121,{
	callfunc "F_UpdateSignVars";
	if (checkweight(908,200) == 0) {
		mes "^3355FF等一下！你现在的背包物品太多了。请清出足够空间后再回来。^000000";
		close;
	}
	if (sign_q < 74) {
		mes "^333333*Giggle*^000000";
		mes "如果这样做，";
		mes "然后那样，再然后……";
		mes "哦，这些计算";
		mes "简直完美无缺！";
		emotion ET_KIK;
		next;
		mes "[Cyon]";
		mes "什、什么？！";
		mes "你是谁？";
		mes "你、你怎么进来的？";
		mes "我命令你现在立刻离开！";
		emotion ET_FRET;
		close2;
		warp "umbala",111,121;
		end;
	}
	else if (sign_q == 74) {
		mes "[Cyon]";
		mes "^333333*窃笑*^000000";
		mes "如果这样做，";
		mes "然后那样，再然后……";
		mes "哦，这些计算";
		mes "简直完美无缺！";
		emotion ET_KIK;
		next;
		mes "[Cyon]";
		mes "什、什么？！";
		mes "你是谁？";
		mes "你、你怎么进来的？";
		mes "我命令你现在立刻离开！";
		emotion ET_FRET;
		next;
		switch(select("我是来找梅兹·布雷德的。:抱歉。:你看看这个？:……")) {
		case 1:
			mes "[Cyon]";
		mes "嗯？Brayde？";
		mes "你凭什么让我";
		mes "毫无证据就相信";
		mes "是他派你来的？现在出去！";
			close;
		case 2:
			mes "[Cyon]";
		mes "既然你这么抱歉，";
		mes "就赶紧离开这里！";
		mes "不是谁都能来这里的！出去！";
			emotion ET_HNG;
			close;
		case 3:
			mes "[Cyon]";
		mes "你带来的东西";
		mes "究竟有什么特别之处？！";
		mes "好吧，你勾起了我的";
		mes "科学好奇心……";
			next;
			emotion ET_HUK;
			next;
			mes "[Cyon]";
		mes "我的天……";
		mes "这是‘神之泪滴’！";
		mes "啜泣星光！";
		mes "他终于做到了……";
			next;
			mes "[Cyon]";
		mes "^333333*窃笑*^000000";
		mes "既然他遵守了约定，我想我也该遵守自己的约定。";
		mes "现在，啜泣星光里有这些细小的字……^FFFFFFcobo^000000";
			next;
			mes "[Cyon]";
		mes "字迹太小，即使精通鹰眼的猎人也无法阅读。不过我读到过，啜泣星光会对";
		mes "非常古老的纸张产生反应……";
			next;
			mes "[Cyon]";
		mes "现在，如果想弄清啜泣星光上写了什么，";
		mes "我们至少需要 10 张古老的纸片……";
			set sign_q,75;
			close;
		case 4:
			specialeffect EF_VENOMDUST;
			mes "[Cyon]";
		mes "不听吗？";
			mes "好吧，既然你听不懂，那我只能动用武力！现在滚出去！";
			close2;
			percentheal -30,0;
			specialeffect2 EF_MAGNUMBREAK;
			end;
		}
	}
	else if (sign_q == 75) {
		mes "[Cyon]";
		mes "你回来了。希望你找到了古老或年代久远的纸张……";
		next;
		if (countitem(1097) > 9) {
			mes "[Cyon]";
			mes "你怎么找到这些残旧书页的？太好了，我相信啜泣星光会对它们产生反应！";
			next;
			mes "[Cyon]";
			mes "是的，是的……这些应该够了。现在给我，然后在这里等着，我试几种方法……";
			next;
			specialeffect EF_SPHERE;
			next;
			mes "[Cyon]";
			mes "正如我所想！啜泣星光对这些残旧书页产生反应！太好了！我终于履行了对 Metz 的承诺！现在他可以别烦我了！";
			delitem 1097,10; //Worn_Out_Page
			set sign_q,76;
			getitem 7275,1; //Ancient_Document
			close;
		}
		else if (countitem(1097) > 0) {
			mes "[Cyon]";
			mes "你怎么找到这些";
			mes "^FF0000残旧书页^000000？太好了，";
			mes "我相信啜泣星光";
			mes "一定会对它们产生反应！";
			next;
			mes "[Cyon]";
			mes "等等，这些还不够让啜泣星光产生反应。找更多纸张，全部带给我！";
			close;
		}
		else {
			mes "[Cyon]";
			mes "你什么都没找到？你算什么科学家？现在出去找古老纸张，好让我们了解啜泣星光写了什么！快去！";
			next;
			mes "[Cyon]";
			mes "...?";
			mes "你为什么还在这里？离开，照我说的做，好吗？！别逼我动粗……";
			next;
			percentheal -30,0;
			specialeffect2 EF_MAGNUMBREAK;
			next;
			warp "umbala",111,121;
			end;
		}
	}
	else if (sign_q == 76) {
		mes "[Cyon]";

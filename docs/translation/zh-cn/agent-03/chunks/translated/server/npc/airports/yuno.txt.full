y_airport,143,43,5	script	Airport Staff#y_air1a::y_airport1	90,{
	mes "[Airport Staff]";
	mes "欢迎来到朱诺机场。这里提供前往艾音布罗克、拉赫和胡格尔的国内航班，";
	mes "以及前往依斯鲁得和拉赫的国际航班。";
	mes "有什么可以为您服务的吗？";
	next;
	if (select("登上飞艇。:取消。") == 1) {
		mes "[Airport Staff]";
		mes "所有航班的登机费都是1,200 Zeny。";
		mes "如果您使用免费飞艇票，";
		mes "登机费将被免除。";
		mes "要出发吗？";
		next;
		if (select("是:否") == 1) {
			if (countitem(7311) > 0) {
				delitem 7311,1; //Free_Flying_Ship_Ticket
				warp "y_airport",148,51;
				end;
			}
			if (Zeny >= 1200) {
				set Zeny, Zeny - 1200;
				warp "y_airport",148,51;
				end;
			}
			mes "[Airport Staff]";
			mes "抱歉，您没有足够的1,200 Zeny";
			mes "支付登机费。";
			mes "请准备好费用。";
			close;
		}
	}
	mes "[Airport Staff]";
	mes "谢谢您，";
	mes "祝您今天愉快。";
	close;
}

y_airport,158,43,5	duplicate(y_airport1)	Airport Staff#y_air1b	90
y_airport,126,43,5	duplicate(y_airport1)	Airport Staff#y_air1c	90

y_airport,143,49,3	script	Arrival Staff#y_air2a::y_airport2	90,{
	mes "[Airport Staff]";
	mes "欢迎来到朱诺机场。";
	mes "如果您刚从航班抵达，我可以带您前往主航站楼。";
	mes "否则，请登上出发的飞艇前往目的地。";
	next;
	if (select("前往主航站楼:取消") == 1) {
		mes "[Airport Staff]";
		mes "进入主航站楼后，";
		mes "登上出发飞艇需要再次支付费用。";
		mes "只有目的地是朱诺时才应离开这里。";
		mes "要前往主航站楼吗？";
		next;
		if (select("是:否") == 1) {
			warp "y_airport",142,40;
			end;
		}
	}
	mes "[Airport Staff]";
	mes "好的，谢谢您的惠顾，";
	mes "祝您旅途愉快~";
	mes "感谢您的支持。";
	mes "一路顺风~";
	close;
}

y_airport,126,51,3	duplicate(y_airport2)	Arrival Staff#y_air2b	90
y_airport,158,50,3	duplicate(y_airport2)	Arrival Staff#y_air2c	90

y_airport,145,63,5	script	Domestic Boarding	91,{
	mes "[Boarding Staff]";
	mes "您要登上前往艾音布罗克、";
	mes "拉赫和胡格尔的飞艇吗？";
	mes "如果要登机，";
	mes "请让我带您前往飞艇登机区。";
	mes "现在出发吗？";
	next;
	if (select("是:否") == 1) {
		warp "yuno",59,244;
		end;
	}
	mes "[Boarding Staff]";
	mes "好的。";
	mes "感谢您的惠顾，";
	mes "祝您旅途愉快~";
	mes "感谢您搭乘我们的飞艇。";
	close;
}

y_airport,140,63,5	script	International Boarding	91,{
	mes "[Boarding Staff]";
	mes "您要登上前往朱诺、";
	mes "依斯鲁得和拉赫的飞艇吗？";
	mes "如果要登机，";
	mes "请让我带您前往登机区。";
	mes "现在出发吗？";
	next;
	if (select("是:否") == 1) {
		warp "yuno",47,244;
		end;
	}
	mes "[Boarding Staff]";
	mes "好的。";
	mes "感谢您搭乘我们的飞艇，";
	mes "祝您享受先进飞艇带来的旅程。";
	mes "感谢您的支持。";
	mes "一路顺风~";
	close;
}

yuno,14,262,5	script	Airship Staff#yuno01	91,{
	mes "[Airship Staff]";
	mes "欢迎来到朱诺机场。";
	mes "请使用这扇门";
	mes "登上前往依斯鲁得的飞艇，";
	mes "它会一路飞往卢恩·米德加尔特王国的依斯鲁得，";
	mes "以及阿鲁纳佩兹共和国的拉赫。";
	mes "";
	mes "";
	next;
	mes "[Airship Staff]";
	mes "如果你的目的地是朱诺，";
	mes "请下楼并请抵达工作人员带你前往主航站楼。";
	mes "谢谢，祝你旅途愉快。";
	mes "";
	mes "";
	mes "";
	close;
}


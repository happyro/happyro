		next;
		mes "[Drunken Man]";
		mes "我是库申伯格！";
		mes "多亏了你，我一直在赢！";
		mes "哈哈哈！谢、谢谢~";
		mes "^333333*嗝嗝嗝！*^000000";
		next;
		switch(select("你说的伊米尔之心是什么意思？:嘿嘿，不客气。")) {
		case 1:
			mes "[Drunken Man]";
			mes "什么……？";
			mes "伊米尔之心？";
			mes "你怎么知道？^333333*嗝*^000000";
			next;
			mes "["+strcharinfo(0)+"]";
			mes "你、你……！";
			mes "你刚才一边拿苹果赌博，";
			mes "一边喊‘伊米尔之心站在我这边’！";
			next;
			mes "[Drunken Man]";
			mes "什么……？！";
			mes "不可能~";
			mes "呃……？我说了吗……？";
			next;
			mes "[Drunken Man]";
			mes "嘿嘿……";
			mes "我本来不该谈这个。";
			mes "作为实验室负责人，";
			mes "我发誓要对伊米尔之心保密。";
			next;
			mes "[Drunken Man]";
			mes "但我在乎什么？！";
			mes "他们只想要我的研究成果！";
			mes "根本不欣赏我的工作！";
			mes "我的头衔完全没有价值！";
			next;
			mes "[Drunken Man]";
			mes "你不知道我被困在实验室多久了，工作条件也越来越糟。管他们的！只要项目有进展，我就能继续领工资！";
			next;
			select("项目？");
			next;
			mes "[Drunken Man]";
			mes "对，我们正在研究伊米尔之心。";
			mes "它很久以前在^3131FF艾因贝赫^000000被发现，";
			mes "现在就在我们的实验室里。";
			next;
			mes "[Drunken Man]";
			mes "大家都知道它据说拥有传说力量，";
			mes "但连我也惊讶于它的能力。";
			mes "它既可怕又奇迹般，既恐怖又神奇……";
			next;
			mes "[Drunken Man]";
			mes "所以……";
			mes "我想……";
			mes "它甚至可能拥有";
			mes "让我赢骰子游戏的力量！";
			mes "哇哈哈——^333333*嗝！*^000000";
			next;
			mes "["+strcharinfo(0)+"]";
			mes "^333333（我在实验室看到连接着许多电线的东西，";
			mes "一定是^3131FF伊米尔之心^333333的一部分。";
			mes "我最好把这件事告诉 Shinokas。）^000000";
			changequest 2076,2077;
			set Shinokas_Quest,9;
			close;
		case 2:
			mes "[Drunken Man]";
			mes "哈哈哈哈！";
			mes "你真棒！";
			mes "我感觉棒极了！";
			mes "一切都棒极了！";
			mes "哇哈哈哈哈哈！";
			mes "^333333*Hiccup*^000000";
			close;
		}
	}
	else if (Shinokas_Quest == 9) {
		mes "[Drunken Man]";
		mes "哈哈哈哈！";
		mes "你真棒！";
		mes "我感觉棒极了！";
		mes "一切都棒极了！";
		mes "哇哈哈哈哈哈！";
		mes "^333333*Hiccup*^000000";
		close;
	}
	else {
		mes "[Drunken Man]";
		mes "好啦好啦……";
		mes "爸爸这次一定会";
		mes "赢到苹果！";
		next;
		mes "[Drunken Man]";
		mes "开始吧！";
		mes "^3131FFYmir's Heart^000000 is";
		mes "站在我这边！上！";
		emotion ET_GO;
		next;
		mes "["+strcharinfo(0)+"]";
		mes "咦……？";
		mes "他刚才说什么？";
		mes "好像很重要！";
		next;
		mes "^3355FF*Rolling and rumbling*^000000";
		next;
		emotion ET_CHUP;
		mes "[Kaci]";
		mes "我总共有^FF00003^000000个，";
		mes "你总共有^FF00002^000000个。";
		mes "这局你输了。抱歉，";
		mes "希望以后还能再玩。";
		next;
		mes "[Drunken Man]";
		mes "哇啊啊啊啊！";
		mes "苹果！我的苹果！";
		close;
	}
}

ein_in01,231,170,0	script	#kenka	-1,2,2,{

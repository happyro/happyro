ein_in01,31,138,3	script	Calla#ein	90,{
	if (checkweight(908,70) == 0) {
		mes "^3355FFWait a second!";
		mes "你现在携带的物品太多。请使用卡普拉服务存放物品后再回来。^000000";
		close;
	}
	if (BaseLevel < 60) {
		mes "[Calla]";
		mes "你好，冒险者。";
		mes "我们的城市一定只是你";
		mes "停留几天的另一个地方。";
		next;
		mes "[Calla]";
		mes "你一定拥有很多自由。我真羡慕你。";
		mes "我无法做想做的事，甚至不敢告诉家人真实想法，更别说改变这里了……";
		next;
		mes "[Calla]";
		mes "那是什么感觉？";
		mes "随心所欲地去任何地方，遵循内心真正的愿望？";
		mes "我多么希望也能这样……";
		close;
	}
	if (EIN_LOVERQ == 17) {
		mes "[Calla]";
		mes "非常感谢！我会尽力说服父母接受我们的关系。虽然很难，但这是很好的第一步~";
		next;
		mes "[Calla]";
		mes "希望我们能共同改善艾因贝赫和艾因布洛克的关系。两座城镇之间的仇恨必须结束……";
		next;
		mes "[Calla]";
		mes "我非常感谢你为我们所做的一切。我会祈祷你平安，冒险者。";
		close;
	}
	if (EIN_LOVERQ == 16) {
		mes "[Calla]";
		mes "我刚听母亲说她打算和 Klitzer 喝茶！这一定要感谢你~";
		next;
		mes "[Calla]";
		mes "我从没想过这么美好的事会发生。";
		mes "我太开心了，甚至想哭……";
		mes "我永远感谢你所做的一切。";
		next;
		mes "[Calla]";
		mes "我觉得自己真傻，居然以为一切都没希望。";
		mes "我会尽力让父母接受 Klitzer，总有一天我们会结婚~";
		next;
		mes "[Calla]";
		mes "我没什么可给你的，但可以展示家族秘密。";
		mes "这是一种提神按摩技巧，只需十秒就能让你更健康。";
		next;
		mes "[Calla]";
		mes "请脱下装备，在我按摩时站好。";
		mes "一开始可能会有点痛……";
		nude;
		next;
		mes "^3355FF*Rub Rub Rub*";
		mes "*Knead Knead Knead*";
		mes "*Crrack C-c-c--c-crack*";
		mes "*Crack Crack Crrrrrrack*";
		mes "*Rub Crrraaaaaaaaaack*^000000";
		next;
		mes "["+ strcharinfo(0) +"]";
		mes "哦哦哦……";
		mes "我感觉好酸痛，";
		mes "但又舒服极了。";
		mes "等等。现在我只觉得";
		mes "好舒服~";
		percentheal 100,0;
		set EIN_LOVERQ,17;
		if (checkre(3)) {
			if (BaseLevel < 41) getexp 61,0;
			else if (BaseLevel < 61) getexp 600,0;
			else if (BaseLevel < 81) getexp 3000,0;
			else if (BaseLevel < 99) getexp 20000,0;
			else getexp 30000,0;
		} else {
			if (BaseLevel < 41) getexp 610,0;
			else if (BaseLevel < 61) getexp 6000,0;
			else if (BaseLevel < 81) getexp 30000,0;
			else getexp 200000,0;
		}
		next;
		mes "[Calla]";
		mes "感觉怎么样？";
		mes "希望你觉得神清气爽。";
		mes "请理解，这是我能用来表达感谢的最好礼物。";
		next;
		mes "[Calla]";
		mes "再次感谢你，";
		mes "非常感谢，"+ strcharinfo(0) +"。";
		mes "我会一直祈祷你";
		mes "冒险时平安~";
		completequest 8088;
		close;
	}
	if ((EIN_LOVERQ == 5) && (countitem(712) > 0)) {
		mes "[Calla]";
		mes "你和 Klitzer 谈过了？他怎么样？他说了什么？";
		next;
		mes "[Calla]";
		mes "哦……？";
		mes "他让你把这朵花交给我？真贴心~";
		mes "非常感谢你，善良的冒险者~";
		next;
		mes "[Calla]";
		mes "啊，我真没礼貌！";
		mes "一直以来我都称呼你为";
		mes "''adventurer'' this whole";
		mes "但你一直在帮助我！";
		mes "可以告诉我你的名字吗？";
		next;
		input .@input$;
		if (.@input$ == strcharinfo(0)) {
			mes "[Calla]";

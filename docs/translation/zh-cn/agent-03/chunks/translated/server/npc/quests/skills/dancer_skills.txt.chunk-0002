				mes "^3355FFAelle像";
				mes "饥饿的野兽一样";
				mes "狼吞虎咽地吃掉了";
				mes "食物。^000000";
				next;
				mes "[Aelle]";
				mes "太好吃了！";
				mes "我好久没吃这么多了！";
				mes "不过，";
				mes "在教堂里可没多少";
				mes "放纵大吃的机会。";
				mes "啊，对了，课程！";
				next;
				mes "[Aelle]";
				mes "现在，最简单、";
				mes "最含蓄又最迷人的";
				mes "动作就是";
				mes "^FF0000眨眼^000000。它曾在危急时刻救过我，";
				mes "掌握它";
				mes "会增强你的魅力。";
				next;
				mes "[Aelle]";
				mes "在未经训练的人看来，";
				mes "眨眼只是";
				mes "一个简单动作，对吧？";
				mes "你闭上一只眼，然后";
				mes "再睁开。但如果";
				mes "做得正确……如果你……";
				next;
				mes "[Aelle]";
				mes "哦，我已经很久";
				mes "没喝这么多了！";
				mes "呃，感觉";
				mes "有点——总之，闭上";
				mes "然后——^333333*嗝*^000000眨眼";
				mes "非常非常非常简单～";
				next;
				mes "[Drunken Aelle]";
				mes "做吧！像我一样";
				mes "做！眨眼，就像这样，";
				mes "明白吗？看到了吗？";
				mes "^333333*眨——眼*^000000";
				emotion ET_BEST;
				next;
				mes "["+ strcharinfo(0) +"]";
				mes "哇……";
				mes "刚才那是……";
				mes "太美了！";
				mes "只用一个";
				mes "简单的眨眼！";
				next;
				mes "[Totally Drunk Aelle]";
				mes "是……那个……";
				mes "秘密在……";
				mes "*呃*在——";
				mes "哇哈哈哈哈！";
				mes "天旋地转！";
				emotion ET_SMILE;
				next;
				mes "^3355FF醉醺醺的Aelle";
				mes "用拳头猛击你，";
				mes "并";
				mes "疯狂地自顾自大笑。^000000";
				percentheal -10,0;
				specialeffect2 EF_HIT2;
				emotion ET_THINK, playerattached();
				delitem 970,1; //Alchol
				delitem 512,1; //Apple
				delitem 513,3; //Banana
				delitem 538,5; //Well_Baked_Cookie
				delitem 736,1; //White_Platter
				set DANCER_SK,6;
				close;
			}
			else {
				mes "[Aelle]";
				mes "如果我在课程中途";
				mes "晕倒了，";
				mes "你怎么指望我教你";
				mes "任何东西？没错，";
				mes "我需要一些营养丰富、";
				mes "又美味的零食～";
				next;
				mes "[Aelle]";
				mes "所以，我想吃";
				mes "^FF00001个苹果^000000、^FF00003根香蕉^000000和";
				mes "^FF00005块烤得很好的饼干^000000。啊，";
				mes "记得带上^FF0000瓷盘^000000";
				mes "装零食，别";
				mes "忘了^FF0000酒^000000，知道吗？";
				close;
			}
		}
		else if (DANCER_SK == 6) {
			mes "["+ strcharinfo(0) +"]";
			mes "你还没告诉我";
			mes "让";
			mes "简单眨眼拥有如此";
			mes "撩人魅力的秘诀。";
			mes "我真的需要——";
			next;
			mes "[Totally Hammered Aelle]";
			mes "ZzzZzz... Huh?";
			mes "是，我知道，我是……";
			mes "天才，没错……";
			mes "...ZzzzZzzzZzZzzzZZZzz...";
			next;
			mes "["+ strcharinfo(0) +"]";
			mes "醒醒！";
			mes "我费了这么大劲";
			mes "才";
			mes "学会这个技巧！";
			next;
			mes "[Annoyed Aelle]";
			mes "闭嘴！";
			mes "我困死了！";
			mes "走开。去找";
			mes "我的妹妹Canell……";
			mes "...ZzzzzZzZZZzzzZZ....";
			set DANCER_SK,7;
			close2;
			warp "prontera",156,272;
			end;
		}
		else if (DANCER_SK > 6 && DANCER_SK < 8) {
			mes "["+ strcharinfo(0) +"]";
			mes "Aelle，我真的";
			mes "需要你教我";
			mes "所有关于";
			mes "眨眼的其他知识，";
			mes "以及——";
			next;
			mes "[Aelle]";
			mes "^333333*打嗝*^000000呼——什么？";
			mes "我得教你";
			mes "离开。去找我的";
			mes "妹妹，我现在太累了。";
			mes "姑娘，别烦我！";
			close2;
			warp "prontera",156,272;
			end;
		}
		else if (DANCER_SK > 8) {
			mes "[Sober Aelle]";
			mes "哦……";
			mes "头……好痛……";
			emotion ET_FRET;
			next;
			mes "[Aelle]";
			mes "哦，哇，看看你！";
			mes "我能看出你已经";
			mes "变得更加";
			mes "美丽。是的，你比我记得的";
			mes "更加优雅精致，";
			mes "";
			next;
			mes "[Aelle]";
			mes "永远相信自己的";
			mes "美貌，把魅力";
			mes "当作武器……这个世界上";
			mes "你渴望的任何东西";
			mes "都能属于你！哇哈哈哈哈！";
			close;
		}
		else {
			mes "[Aelle]";
			mes "嘘，嘿！我有";
			mes "一些便宜但有点";
			mes "违法的传送，可以去兽人";
			mes "地下城、格拉斯特海姆";
			mes "和死者之穴。你";
			mes "想参加吗？";
			next;
			mes "[??????]";
			mes "Aelle姐姐……";
			mes "你还在试图";
			mes "出售非法传送";
			mes "吗？Aelle姐姐？";
			next;
			mes "[Aelle]";
			mes "糟糕，是牧师！";
			mes "嘘，如果有人问你，";
			mes "就说我什么也没做！";
			emotion ET_HUK;
			next;
			mes "[Aelle]";
			mes "谢谢，亲爱的……";
			mes "我知道你能";
			mes "替我保守";
			mes "这个小秘密。^333333*眨眼*^000000";
			emotion ET_BEST;
			close;
		}
	}
	else {
		mes "[Aelle]";
		mes "嘘，嘿！我有";
		mes "一些便宜但有点";
		mes "违法的传送，可以去兽人";
		mes "地下城、格拉斯特海姆";
		mes "和死者之穴。你";
		mes "想参加吗？";
		next;
		mes "[??????]";
		mes "Aelle姐姐……";
		mes "你还在试图";
		mes "出售非法传送";
		mes "吗？Aelle姐姐？";
		next;
		mes "[Aelle]";
		mes "糟糕，是牧师！";
		mes "嘘，如果有人问你，";
		mes "就说我什么也没做！";
		emotion ET_HUK;
		next;
		mes "[Aelle]";
		mes "谢谢，亲爱的……";
		mes "我知道你能";
		mes "替我保守";
		mes "这个小秘密。^333333*眨眼*^000000";
		emotion ET_BEST;
		close;
	}
}


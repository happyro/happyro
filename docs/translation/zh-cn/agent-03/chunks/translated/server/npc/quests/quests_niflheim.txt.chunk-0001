//===== rAthena Script ======================================= 
//= Quest NPCs related to Niflheim
//===== By: ================================================== 
//= The rAthena Dev Team
//===== Current Version: ===================================== 
//= 1.6
//===== Compatible With: ===================================== 
//= rAthena Project; 7.15 +
//===== Description: ========================================= 
//= [Official Conversion]
//= Piano Key Ouest
//= - Escape from Niflheim
//= - Variables in use: nif_esc, MISC_QUEST (Bit 32)
//= Message Delivery Quest
//= - Deliver a message to Erious' departed wife.
//= - Variables in use: nif_revive, MISC_QUEST (Bit 16384)
//===== Additional Comments: ================================= 
//= 1.0 Initial release, moved Book of Devil and Piano quest
//=     from npc/cities/niflheim.txt [Evera]
//= 1.1 Optimized Book of Devil quest. used bit-wise var,
//=     Optimized Piano Quest - now uses 1 variable [Lupus]
//= 1.2 Fixed bad NPC header data to comply with rev. 11603. [L0ne_W0lf]
//= 1.3 Moved the Book of Devil quest to custom folder. [L0ne_W0lf]
//=     Updated to Aegis 10.3 Standed, added Message Delivery Quest.
//=     Rescripted Piano Quest. Prior quest progress will be lost.
//= 1.4 Fixed NPCs using ID 111 when it shoudl have been 139. [L0ne_W0lf]
//= 1.5 Swapped NPC IDs back from last change (139 back to 111). [L0ne_W0lf]
//=     Clicking will do nothing, you have to still "touch" the npc. 
//= 1.6 Added questlog support. [Euphy]
//============================================================ 

// Piano Quest :: nif_ryu
//============================================================
niflheim,224,243,3	script	Alreg#nif	795,{
	if (nif_piano) set nif_piano,0;
	mes "[Alreg]";
	mes "我喜欢肉，呜嘿嘿。你！看起来很好吃。";
	next;
	mes "[Alreg]";
	mes "我想尝尝你。";
	next;
	mes "^FF3355*Crunch* Crunch*^000000";
	if (nif_esc == 0 && (MISC_QUEST & 32) == 0) {
		percentheal -60,0;
		next;
		mes "["+ strcharinfo(0) +"]";
		mes "不——哦哦哦~！";
		next;
		mes "[Alreg]";
		mes "我很久没吃肉了……真、真好吃。你味道不错。Alreg 给你这个作为回报。礼物！";
		mes "*Burrrp*";
		set nif_esc,rand(1,2);
		getitem 7184,1; //Piano_Keyboard
		close;
	}
	percentheal -30,0;
	next;
	mes "["+ strcharinfo(0) +"]";
	mes "哎哟~！你想做什么，杀了我吗？！";
	next;
	mes "[Alreg]";
	mes "嗯？哦，不不不。我是想吃你。";
	close;
}

nif_in,105,81,3	script	Crayu#nif	794,{
	mes "[Crayu]";
	mes "活人……听听这首歌……许多人唱了很久，但没人知道何时创作或谁写的。";
	next;
	mes "[Crayu]";
	mes "^FF00001. Mountain sunset to the west";
	mes "^FF00002. Where the purple dusk falls ";
	mes "^FF00003. Surrounded by beautiful melody";
	mes "^FF00004. You become the key that ignores its master^000000";
	next;
	if (nif_esc == 1 || nif_esc == 4) {
		mes "[Crayu]";
		mes "好，等等！我来考考你！";
		switch(rand(1,4)) {
		case 1:
			set .@songline$,"Mountain sunset to the west";
			mes "写下歌曲第一句。";
			break;
		case 2:
			set .@songline$,"Where the purple dusk falls";
			mes "写下歌曲第二句。";
			break;
		case 3:
			set .@songline$,"Surrounded by beautiful melody";
			mes "写下歌曲第三句。";
			break;
		case 4:
			set .@songline$,"You become the key that ignores its master";
			mes "写下歌曲第四句。";
			break;
		}
		next;
		input .@input$;
		if (.@input$ == .@songline$) {
			mes "[Crayu]";
			mes "太好了……！看来你一直在认真听~！你是我最喜欢的客人之一。这是给你的小奖励。";
			next;
			if (nif_esc == 1) set nif_esc,3;
			else set nif_esc,6;
			getitem 7184,1; //Piano_Keyboard
			mes "[Crayu]";
			mes "最后，希望你像尊重我一样尊重其他吟游诗人。";
			close;
		}
		else {
			mes "[Crayu]";
			mes "*Sigh*... If you had only";
			mes "如果你认真听我说，就很容易回答。试着记住歌词，再来一次！";
			close;
		}
	}
	next;
	mes "[Crayu]";
	mes "不知道歌词是什么意思……似乎很深奥……我感觉这首歌藏着某个秘密。";
	close;
}

nif_in,31,20,3	script	Kuzkahina#nif	794,{
	if (nif_esc == 2 || nif_esc == 3) {
		mes "[Kuzkahina]";
		mes "我不明白为什么这家店赚不到钱……就算活着时，我的生意也从没赚到钱……";
		next;
		mes "[Kuzkahina]";
		mes "嘿，你！发挥点作用，离开时把这个扔掉。";
		set nif_esc,nif_esc+2;
		getitem 7184,1; //Piano_Keyboard
		next;
		mes "[Kuzkahina]";
		mes "天啊，这家店怎么回事？我怎么会雇到这么没用的员工……？";
		mes "*mumble mumble*";
		mes "*mumble mumble*";
		close;
	}
	mes "[Kuzkahina]";
	mes "我不明白为什么这家店赚不到钱……就算活着时，我的生意也从没赚到钱……";
	close;
}

niflheim,208,103,1	script	#Graveyard1	111,1,1,{
	end;

OnTouch_:
	if (nif_esc == 5 || nif_esc == 7 || nif_esc == 8 || nif_esc == 10) {
		mes "^3355FF你在墓地附近发现了半埋着的东西。";
		mes "它看起来形状很漂亮。^000000";
		next;
		mes "^3355FF你想把它捡起来吗？^000000";
		if (select("是:否") == 1) {
			if (nif_esc < 10)
				set nif_esc,nif_esc+2;
			else if (nif_esc == 10)
				set nif_esc,11;
			getitem 7184,1; //Piano_Keyboard
		}
		close;
	}
	end;
}

niflheim,169,71,1	script	#Graveyard2	111,1,1,{
	end;

OnTouch_:
	if (nif_esc == 6 || nif_esc == 9) {
		mes "^3355FF你在墓地附近发现了半埋着的东西。";
		mes "它看起来形状很漂亮。^000000";
		next;
		mes "^3355FF你想把它捡起来吗？^000000";
		if (select("是:否") == 1) {
			set nif_esc,nif_esc+2;
			getitem 7184,1; //Piano_Keyboard
		}
		close;
	}
	end;
}

nif_in,115,181,0	script	#Piano	111,1,1,{
	end;

OnTouch_:
	if (nif_esc == 0 && (MISC_QUEST & 32) == 0) {
		mes "^3355FF你看到一架又大又重的钢琴。";
		mes "你觉得它演奏出的音乐一定非常美妙。^000000";
		next;
		mes "^3355FF检查钢琴时，你发现键盘中间少了 7 个琴键。";
		mes "如果找齐所有琴键，就可以演奏音乐了……^000000";
		close;
	}
	if (nif_esc == 11 && countitem(7184) > 5) {
		set nif_esc,12;
		delitem 7184,6; //Piano_Keyboard
		mes "^3355FF你把找到的琴键放入每个空位。^000000";
		next;
		mes "^3355FF但你发现还缺少键盘最左侧空位的最后一个琴键……^000000";
		close;
	}
	end;
}

-	script	Piano3	HIDDEN_NPC,{
	end;

OnTouch_:
	if (nif_esc == 12 || nif_esc == 13 || (MISC_QUEST & 32)) {
		mes "^3355FF你俯身靠近最后一个空位，想仔细看看……^000000";
		next;
		soundeffect "complete.wav",0;
		next;
		if (nif_esc == 12) {
			set MISC_QUEST,MISC_QUEST | 32;
			set nif_piano, 0;
		}
		mes "^3355FF你开始感到头晕，身体仿佛漂浮在空中。接着，视线开始模糊……^000000";
		close2;
		warp "nif_in",179,163;
		end;
	}
	end;
}

nif_in,188,168,3	script	Witch#nif	792,{
	mes "[Kirkena]";
	mes "嗯？……你还活着，对吧？";
	mes "我不知道为什么会有越来越多活人来到这里，也不知道你为什么来，";
	mes "但这里对活人来说很危险。";
	mes "";
	mes "";
	mes "";
	next;
	mes "[Kirkena]";
	mes "我会把你送回这座城外。如果可以的话，你最好别再回来。";
	close2;
	warp "umbala",138,208;
	end;
}

// Message Delivery Quest :: nif_npc_lackee
//============================================================
prt_in,161,20,3	script	Erious#nif	92,{
	if (MISC_QUEST & 16384) {
		mes "[Erious]";
		mes "祝你旅途平安，冒险者。";
		close;
	}
	if (nif_revive == 0) {
		mes "[Erious]";
		mes "*Sob*Sob*";
		mes "*Cries* Wahhh...!";
		mes "Elly，你怎么能这样离开我……";
		emotion ET_CRY;
		next;
		if (select("安慰他。:不理他。") == 1) {
			mes "[Erious]";
			mes "啊，谢谢你的好意。";
			mes "*Sob* My wife died while I was on";
			mes "一次旅程。我很抱歉没能在她生命最后陪伴她……";
			next;
			mes "[Erious]";
			mes "我希望能和我的 Elly 说话，虽然我知道现在已经太迟了。";
			mes "*Cries* But... there is one last";
			mes "我唯一的希望，最后的机会……";
			next;
			mes "[Erious]";
			mes "有人告诉我世上有一座死者居住的城镇。我也许能在那里见到妻子，但不能把孩子们独自留在这里。*哭泣*";
			next;
			if (select("我可以替你传话给她。:听到这些我很抱歉。") == 1) {
				mes "[Erious]";
				mes "哦，你可以吗？太感谢你的慷慨了。如果你能做到，我会感激不尽。";
				next;
				mes "[Erious]";
				mes "你是冒险者，对吧？如果旅途带你去那座死者之城，并且碰巧遇见她……";
				next;
				mes "[Erious]";
				mes "请替我给 Elly 带句话，告诉她一个月前发生的一切都是我的错。谢谢你的帮助，保重。";
				set nif_revive,1;
				setquest 11038;
				close;
			}
			mes "[Erious]";
			mes "*哭泣* 难道我没有办法";
			mes "还能再见到她吗？哪怕只是最后一次，只要能再和她说话，我什么都愿意……";
			close;
		}
		mes "[Erious]";
		mes "*Cries* Eeeeelllllyyyy~~~~!";
		mes "我没想到那会是我们最后一次见面……";
		mes "*Sob*...";
		close;
	}
	else if (nif_revive == 1) {
		mes "[Erious]";
		mes "我听说过的那个地方……死者之城……据我记得，它位于某个休息区附近。";
		next;
		mes "[Erious]";
		mes "那里日夜充满无尽的痛苦与绝望尖叫。希望这能帮助你寻找。";
		close;
	}
	else if (nif_revive == 5 || nif_revive == 6) {
		mes "[Erious]";
		mes "天啊！你真的找到那座城了？我很感谢你为我忍受这些苦难……嗯……最后……你见到我的 Elly 了吗？";
		next;
		if (select("是。:抱歉，我没能见到。") == 1) {
			if (nif_revive == 6 && countitem(934) > 0) {
				mes "[Erious]";
				mes "真的吗？她说了什么？她说会原谅我吗？";
				next;
				select("是的。她还给了我……这个。");
				delitem 934,1; //Mementos
				mes "[Erious]";
				mes "啊……箱子里是我们开始交往时我送她的礼物。我们相遇前她就患有重病，所以我答应治好她……";
				next;
				mes "[Erious]";
				mes "所以我踏上旅途……寻找治疗方法或药物……但我的努力一无所获。";
				mes "...................";
				mes ".........";
				next;
				mes "[Erious]";
				mes "无论如何，谢谢你的慷慨。我想补偿给你带来的麻烦，但我只有旅途中找到的治疗她疾病的药。";
				next;
				mes "[Erious]";
				mes "希望你收下这药，作为我的谢意。";
				next;
				if (checkweight(610,26)) {
					set MISC_QUEST,MISC_QUEST | 16384;
					set nif_revive,0;
					completequest 11043;
					getitem 607,2; //Yggdrasilberry
					getitem 608,2; //Seed_Of_Yggdrasil
					getitem 610,10; //Leaf_Of_Yggdrasil
					mes "[Erious]";
					mes "谢谢你所做的一切。祝你冒险幸运平安。";
					close;
				}
				mes "[Erious]";
				mes "我有东西要给你，但你携带的物品太多，无法接收。先把物品存放起来吧？";
				close;
			}
			else if (nif_revive == 6 && countitem(934) < 1) {
				mes "[Erious]";
				mes "嗯……真奇怪。我相信她会给你东西作为见面凭证。你是不是忘了带什么给我？";
				close;
			}
			mes "[Erious]";
			mes "我想你误会了什么，或者你正试图欺骗一个悲伤的人。";
			close;
		}
		if (nif_revive == 5) {
			mes "[Erious]";
			mes "我明白了……你没能找到她……不过，我也理解完成我的请求可能是不可能的……";
			next;
			mes "[Erious]";
			mes "你费尽周折帮助我，所以我想给你一些东西作为谢礼。";
			next;
			if (checkweight(610,10)) {
				set MISC_QUEST,MISC_QUEST | 16384;
				set nif_revive,0;
				completequest 11042;
				getitem 610,10; //Leaf_Of_Yggdrasil
				mes "[Erious]";
				mes "谢谢你所做的一切。祝你旅途幸运平安。";
				close;
			}
			mes "[Erious]";
			mes "我有东西要给你，但你携带的物品太多，无法接收。先把物品存放起来吧？";
			close;
		}
		mes "[Erious]";

			if (.@j & 4)
				setarray .@i[0],10,5047,1;
			else if (.@j & 16)
				setarray .@i[0],15,5049,2;
			else
				setarray .@i[0],20,5051,3;

			if (countitem(6401) < .@i[0]) {
				mes "[Memo]";
				mes "你带来的油不够。";
				next;
				mes "... ... ... ...";
				next;
				mes "[Memo]";
				mes "Poby还欠我一些东西，他会给你一点。";
				close;
			}
			mes "[Memo]";
			mes "哦，你把油带来了，做得好。";
			next;
			mes "[Memo]";
			mes "你一定费了很大力气才把油带来，拿去喝点这个吧。";
			delitem 6401,.@i[0]; //Palm_O
			erasequest .@i[1];
			setquest 5044;
			getitem 11534,.@i[2]; //Coco_Juice
			next;
			switch(rand(4)) {
			case 0:
				mes "[Memo]";
				mes "Ark以游客闻名，有个人独自买了很多瓶。";
				next;
				mes "[Memo]";
				mes "担心他一个人喝吗？喝太多总会变成毒药。";
				break;
			case 1:
				mes "[Memo]";
				mes "太阳总是从东方升起。众所周知的懒鬼今天早上醒得很早。";
				next;
				mes "[Memo]";
				mes "他清醒过来了吗？他人不错，但很懒。";
				break;
			case 2:
				mes "[Memo]";
				mes "先发制人，胜算过半。";
				next;
				mes "[Memo]";
				mes "我觉得你注定会成就大事。";
				break;
			case 3:
				mes "[Memo]";
				mes "有人说话反复无常，看来嘴上说说很容易，实际并非如此。";
				next;
				mes "[Memo]";
				mes "我相信你会信守承诺。";
				break;
			}
			next;
			mes "[Memo]";
			mes "这次我想请你帮忙。";
			next;
			mes "[Memo]";
			mes "Poby的背还在痛，需要几天才能恢复。";
			close;
		}
	} else { // Should never happen.
		mes "[Memo]";
		mes "Dewata岛总是很拥挤，但今天很安静。";
		close;
	}
}

dew_fild01,114,275,4	script	Lero#dew_drink	536,{
	if (checkweight(1201,1) == 0 || MaxWeight - Weight < 5000) {
		mes "[Lero]";
		mes "你带的东西太多了……";
		close;
	}
	if (dew_drink == 1) {
		mes "[Lero]";
		mes "糟糕！我有这么多订单，材料快用完了。";
		mes "还没回来？怎么回事，Poby？他去哪儿了？";
		emotion ET_FRET;
		next;
		select("打扰了，你是Lero吗？");
		mes "[Lero]";
		mes "Poby回来后，我要给他一顿永生难忘的教训！";
		emotion ET_ANGER;
		next;
		mes "- Lero seems pretty mad at someone and ignores you -";
		next;
		mes "[Lero]";
		mes "哎呀。你是谁？";
		emotion ET_QUESTION;
		next;
		select("Memo让我来这里。");
		mes "[Lero]";
		mes "啊，对了！因为采集坚果的工人还没回来，我都忘了Memo。抱歉。";
		next;
		mes "[Lero]";
		mes "要制作新鲜棕榈油，我需要新鲜的棕榈油果。这样才能从新鲜果实中提取更多新鲜油。";
		next;
		mes "[Lero]";
		mes "跟你说，Memo先生非常挑剔，绝不会使用不新鲜的油。";
		next;
		mes "[Lero]";
		mes "为了制作新鲜油，他总是把工人派去棕榈森林，但是……黎明时派去的人还没回来。";
		next;
		mes "[Lero]";
		mes "起初我以为他只是懒，这让我非常不安。";
		mes "你能在棕榈森林找到工人吗？";
		next;
		select("好的，我会找到他们。");
		mes "[Lero]";
		mes "非常感谢。";
		mes "找到Poby。";
		next;
		mes "[Lero]";
		mes "Poby可能在^0000FF棕榈森林^000000。森林南部的作物最好。";
		set dew_drink,2;
		changequest 5035,5036;
		close;
	} else if (dew_drink == 2) {
		mes "[Lero]";
		mes "你找到Poby了吗？";
		emotion ET_QUESTION;
		next;
		mes "[Lero]";
		mes "... ... ...";
		next;
		mes "[Lero]";
		mes "哦，你还没去过^0000FF棕榈森林^000000东部。我很担心。";
		close;
	} else if (dew_drink == 3) {
		mes "[Lero]";
		mes "你回来了……还有……Poby……";
		mes "Poby怎么样？";
		emotion ET_QUESTION;
		next;
		select("Poby……");
		mes "[Lero]";
		mes "啊！我不知道这件事。我总是告诉Poby：^0000FF‘一年辛劳，一日毁于懒惰。’^000000";
		next;
		mes "[Lero]";
		mes "他没有任何安全装备就爬树，所以可能摔下来受伤了。";
		next;
		mes "[Lero]";
		mes "嗯……抱歉，我现在拿不到棕榈油。";
		next;
		mes "[Lero]";
		mes "你能把因为缺少材料而无法获得棕榈油的消息告诉Memo先生吗？";
		mes "没有材料，工匠什么都做不出来。";
		next;
		select("为什么不由我去拿材料？");
		mes "[Lero]";
		mes "啊，那确实是个好办法，但一开始收集坚果会很困难。";
		next;
		mes "[Lero]";
		mes "嗯！！！";
		mes "我有个好主意。";
		next;
		mes "[Lero]";
		mes "你可以在森林里遇到Poby的地方，向他询问收集坚果的最佳方法。他应该能教你技巧。";
		set dew_drink,4;
		changequest 5037,5038;
		next;
		mes "[Lero]";
		mes "虽然他又懒又粗心，但他是最优秀的工人。";
		close;
	} else if (dew_drink == 4) {
		if (checkquest(5038) > -1) {
			mes "[Lero]";
			mes "你可以在森林里遇到Poby的地方，向他询问收集坚果的最佳方法。他应该能教你技巧。";
			next;
			mes "[Lero]";
			mes "虽然他又懒又粗心，但他是最优秀的工人。";
			close;
		} else if (checkquest(5039) > -1) {
			if (countitem(6402) < 60) {
				mes "[Lero]";
				mes "你已经收集坚果了吗？";
				next;
				mes "[Lero]";
				mes "一、二……";
				next;
				mes "[Lero]";
				mes "这不是我向Poby订的数量。";
				next;
				mes "[Lero]";
				mes "再拖延下去会很困难，所以快带60个来。";
				close;
			}
			mes "[Lero]";
			mes "一、二、三、四……";
			next;
			mes "[Lero]";
			mes "正好60个坚果。我现在就来榨油。";
			next;
			emotion ET_SORRY;
			mes "[Lero]";
			mes "这需要一些时间，所以回去告诉Memo先生情况，也告诉他我很抱歉耽搁了。";
			delitem 6402,60; //Oil_Palm_F
			set dew_drink,5;
			changequest 5039,5040;
			close;
		}
	} else if (dew_drink == 5) {
		mes "[Lero]";
		mes "这需要一些时间，所以回去告诉Memo先生情况，也告诉他我很抱歉耽搁了。";
		close;
	} else if (dew_drink == 6) {
		if (checkweight(1201,1) == 0 || MaxWeight - Weight < 15000) {
			mes "[Lero]";
			mes "你现在带的东西太多，无法继续。";
			close;
		}
		mes "[Lero]";
		mes "你来得正是时候。我刚做好棕榈油。";
		next;
		mes "[Lero]";
		mes "它比你想象中重，搬运时要小心。";
		next;
		emotion ET_SORRY;
		mes "[Lero]";
		mes "哦，告诉Memo先生我很抱歉迟交，并说明这不是我的错。";
		changequest 5041,5042;
		set dew_drink,7;
		getitem 6401,30; //Palm_O
		close;
	} else if (dew_drink == 7) {
		if (checkquest(5042) > -1 && countitem(6401) > 29) {
			mes "[Lero]";
			mes "它比你想象中重，搬运时要小心。";
			next;
			emotion ET_SORRY;
			mes "[Lero]";
			mes "哦，告诉Memo先生我很抱歉迟交，并说明这不是我的错。";
			close;
		} else {
			set .@num, 30 - countitem(6401);
			if (checkweight(6401,.@num) == 0) {
				mes "[Lero]";
				mes "你现在带的东西太多，无法继续。";
				close;
			}
			mes "[Lero]";
			mes "我明明记得给了你30瓶棕榈油，难道全弄丢了吗？";
			next;
			select("对不起，是我的错……");
			emotion ET_FRET;
			mes "[Lero]";
			mes "这就是短缺的棕榈油。请小心保管，弄到它真的很不容易……";
			getitem 6401,.@num; //Palm_O
			close;
		}
	} else if (dew_drink == 8) {
		mes "[Lero]";
		mes "Memo先生说了什么？";
		emotion ET_QUESTION;
		next;
		mes "["+strcharinfo(0)+"]";
		emotion ET_BLABLA, playerattached();
		mes "... ... ... ...";
		next;
		mes "[Lero]";
		mes "啊……我明白了……";
		emotion ET_OK;
		close;
	} else if (dew_drink == 10) {
		for(set .@i,0; .@i<7; set .@i,.@i+1)
			if (checkquest(5045+.@i) > -1)
				set .@j, .@j | (1<<.@i);
		if (.@j == 0) {
			mes "[Lero]";
			mes "发生了什么？我没收到Memo先生要派人来的通知。";
			close;
		} else if (.@j & 1) {
			mes "[Lero]";
			mes "嘿，我一直在等你。我没想到Poby的伤会让我的生活这么困难。";
			next;
			set .@quest,rand(3);
			mes "[Lero]";
			mes "虽然有些不好意思，但你能带来^0000FF"+(20+(.@quest*10))+"个油棕坚果^000000吗？";
			changequest 5045,5046+(.@quest*2);
			next;
			mes "[Lero]";
			mes "带来油棕坚果后，Memo先生会用棕榈油交换。";
			close;
		} else if ((.@j & 2) || (.@j & 8) || (.@j & 32)) {
			
			// .@i[]: <required amount>,<quest ID>,<reward amount>,<free weight>
			if (.@j & 2)
				setarray .@i[0],20,5046,10,5000;
			else if (.@j & 8)
				setarray .@i[0],30,5048,15,7500;
			else
				setarray .@i[0],40,5050,20,10000;

			if (countitem(6402) < .@i[0]) {
				mes "[Lero]";
				mes "带来"+.@i[0]+"个油棕坚果后，Memo先生会用棕榈油交换。";
				close;
			}
			if (checkweight(1201,1) == 0 || MaxWeight - Weight < .@i[3]) {
				mes "[Lero]";
				mes "你现在带的东西太多，无法继续。";
				close;
			}
			mes "[Lero]";
			mes "一、二、三、四……";
			next;
			mes "[Lero]";
			mes "正好"+.@i[0]+"个油棕坚果。现在就用它们交换棕榈油吧。";
			changequest .@i[1], .@i[1]+1;
			delitem 6402,.@i[0]; //Oil_Palm_F
			getitem 6401,.@i[2]; //Palm_O
			next;
			mes "[Lero]";
			mes "正如我之前说的，它比你想象中重，搬运时要小心。";
			close;
		} else if ((.@j & 4) || (.@j & 16) || (.@j & 64)) {
			mes "[Lero]";
			mes "正如我之前说的，它比你想象中重，搬运时要小心。";
			close;
		}
	}
	mes "[Lero]";
	mes "Poby怎么了……？他为什么还没回来……？";
	next;
	mes "- Seems that he is waiting for someone-";
	close;
}

dew_fild01,259,48,4	script	Poby#dew_drink	538,{
	if (checkweight(1201,1) == 0 || MaxWeight - Weight < 500) {
		if (dew_drink > 0) {
			mes "[Poby]";
			mes "你为什么带这么多东西？";
			close;
		} else {
			mes "[Poby]";
			mes "带这么多东西，你会后悔的。";
			close;
		}
	}
	if (dew_drink == 2) {
		mes "[Poby]";
		mes "啊~腰酸背痛……";
		emotion ET_PROFUSELY_SWEAT;
		next;
		select("你是Poby吗？");
		mes "[Poby]";
		mes "你是谁？";
		next;
		mes "[Poby]";
		mes "我不认识你，不过";
		mes "你是我的粉丝吗？";
		mes "我是Poby，Jaty部落最棒的果实猎人。";
		next;
		mes "[Poby]";
		mes "你是来要我的签名吗？";
		emotion ET_QUESTION;
		next;
		select("Lero让我来这里。");
		mes "[Poby]";
		mes "啊！Lero先生让你来的。我爬树时伤了背，现在动不了。";
		next;
		mes "[Poby]";
		mes "!#@$*&%!@$&!$%!$#*&!@#$";
		emotion ET_CRY;
		next;
		mes "[Poby]";
		mes "而且我至今还没有女朋友……";
		next;
		mes "[Poby]";
		mes "!#@$*&%!@$&!$%!$#*&!@#$";
		emotion ET_CRY;
		next;
		mes "[Poby]";
		mes "啊！抱歉。告诉Lero先生，只要我能想办法移动，就会回去。";
		changequest 5036,5037;
		set dew_drink,3;
		next;
		mes "[Poby]";
		mes "腰疼让我完全动不了……";
		close;
	} else if (dew_drink == 3) {
		mes "[Poby]";
		mes "啊！抱歉。告诉Lero先生，只要我能想办法移动，就会回去。";
		next;
		mes "[Poby]";
		mes "腰疼让我完全动不了……";
		emotion ET_PROFUSELY_SWEAT;
		close;
	} else if (dew_drink == 4) {
		if (checkquest(5039) > -1) {
			if (countitem(6402) > 59) { // Oil_Palm_F
				mes "[Poby]";
				mes "你已经拿到所有果实了。把它们带给Lero先生。";
				close;
			} else {
				mes "[Poby]";
				mes "对你这样的初学者来说，摇树或踢树最简单。";
				next;
				mes "[Poby]";
				mes "这可能很危险，所以一定要戴^0000FF安全帽^000000。";
				next;
				mes "[Poby]";
				mes "收集^FF000060个^0000FF棕榈油果^000000，带给Lero先生。";
				close;
			}
		}
		mes "[Poby]";
		mes "啊~腰酸背痛……";
		emotion ET_PROFUSELY_SWEAT;
		next;
		mes "[Poby]";
		mes "哦！！你是——让我猜猜……";
		next;
		mes "[Poby]";
		mes "... ... ... ...";
		emotion ET_THINK;
		next;
		mes "[Poby]";
		mes "……你回来了！你打算代替我去摘^0000FF棕榈油果^000000，对吧？";
		next;
		mes "[Poby]";
		mes "初学者像我这样摘果实很困难。不，应该说是不可能。";
		next;
		mes "[Poby]";
		mes "高手通常会爬树摘果实，但你是初学者……";
		next;
		mes "[Poby]";
		mes "初学者摇树或踢树最简单。这可能很危险，所以记得戴^0000FF安全帽^000000。";
		changequest 5038,5039;
		next;
		mes "[Poby]";
		mes "好！收集^FF000060个^0000FF棕榈油果^000000，带给Lero先生。";
		emotion ET_SURPRISE;
		close;
	} else if (dew_drink == 10) {
		mes "[Poby]";
		mes "哦！"+strcharinfo(0)+"，我们又见面了。怎么了？";

		if (checkquest(5047) > -1)
			set .@count,10;
		else if (checkquest(5049) > -1)
			set .@count,15;
		else if (checkquest(5051) > -1)
			set .@count,20;
		if (.@count) {
			if (countitem(6401) >= .@count) {
				// Custom translation
				mes "[Poby]";
				mes "干得好！运送时要小心~";
				close;
			}
			set .@new_count, .@count-countitem(6401);
			mes "- You explain the situation. -";
			next;
			mes "[Poby]";
			mes "没错……我欠Memo的祖父一个人情。等等，我在这里藏了些油。";
			next;
			if (checkweight(6401,.@new_count) == 0) {
				mes "[Poby]";
				mes "我这里有一些，但你身上似乎带了太多东西。";
				close;
			}
			mes "- rummaging... rummaging... -";
			next;
			mes "[Poby]";
			mes "啊！这里还有一瓶。小心别再弄丢了，也要对Lero先生保密。";
			getitem 6401,.@new_count; //Palm_O
			next;
			mes "[Poby]";
			mes "拜托了~"+strcharinfo(0)+"。";
			close;
		}
		next;
		switch(select("你为什么来这里？:我想知道怎么摘果实。")) {
		case 1:
			mes "[Poby]";
			mes "我正在散步，因为这样也许能减轻背痛。";
			close;
		case 2:
			mes "[Poby]";
			mes "对初学者来说，摇树或踢树最简单。";
			next;
			mes "[Poby]";
			mes "这可能很危险，所以一定要戴^0000FF安全帽^000000。";
			close;
		}
	}
	mes "[Poby]";
	mes "啊~我的腰快疼死了。";
	emotion ET_CRY;
	close;
}

-	script	::DewataPalm	-1,{

		mes "污水处理厂相当复杂，你可能会迷路。";
		next;
		mes "[Rookie]";
		mes "可能有同事^4D4DFF掉队了^000000，请和他们一起行动。";
		mes "在你登记成为宅邸访客之前，先把所有人的安全放在首位。";
		next;
		mes "[Rookie]";
		mes "那么，这边走。";
		ep17_2_main = 2;
		erasequest 18000;
		setquest 18001;
		close2;
		cutin "",255;
		warp "ba_pw02",275,20;
		end;
	}
	if (ep17_2_main == 2) {
		mes "[Rookie]";
		mes "从这条下水道进入宅邸吧。";
		mes "大多数先进去的同事已经清理完毕。";
		next;
		mes "[Rookie]";
		mes "可能有同事^4D4DFF掉队了^000000，请和他们一起行动。";
		mes "在你登记成为宅邸访客之前，先把所有人的安全放在首位。";
		close;
	}
	mes "[Rookie]";
	mes "和你一起走过的这条路让我感觉很新鲜，冒险家。";
	mes "最近我真的觉得自己充满活力。";
	close;

OnInit:
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "isbegin_quest(16360) == 1" );
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "isbegin_quest(16360) == 2 && isbegin_quest(18000) == 0 && BaseLevel >= 130 && ep17_2_main == 0" );
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "isbegin_quest(18000) == 1" );
	end;
}

//= Finding Patrick Kaufmann
sp_cor,132,144,3	script	Worker#171_rvs_11	4_F_05,{
	if (isbegin_quest(17020) == 1) {
		mes "[Worker]";
		mes "因为剩下的人太少了，我得把人手分开。";
		npctalk "我得把人手分开。","",bc_self;
		next;
		mes "[Worker]";
		mes "我们得轮流工作。";
		npctalk "不，那样效率不高。","Worker#171_rvs_13",bc_self;
		next;
		select("你认识Patrick Kaufmann吗？");
		mes "[Worker]";
		mes "谁？";
		npctalk "Pat？谁？","Worker#171_rvs_12",bc_self;
		next;
		select("Patrick Kaufmann，设施维护负责人。");
		mes "[Worker]";
		mes "Patrick Kaufmann？你是说Patrick Young吧？";
		npctalk "我觉得名字不对。","Worker#171_rvs_14",bc_self;
		next;
		mes "[Worker]";
		mes "他是负责后勤的人。";
		npctalk "设施维护部门……","Worker#171_rvs_13",bc_self;
		next;
		mes "[Worker]";
		mes "这里的设施部门在哪里？";
		npctalk "你不知道吗？","",bc_self;
		next;
		mes "[Worker]";
		mes "我来这里之前就知道了！";
		npctalk "不可能。","Worker#171_rvs_14",bc_self;
		next;
		mes "[Worker]";
		mes "Patrick在设施维护部门？这我倒不知道。这里没人做原来的工作。我来到这里后，被安排了不同的工作。";
		next;
		select("谁决定你们做什么？");
		mes "[Worker]";
		mes "谁决定？是研究员。";
		mes "我们来到这里后排成一列，然后一个接一个接受面谈，之后被分配工作。";
		npctalk "难道为了让我们活下去，我被分配了照顾牲畜的工作？","",bc_self;
		next;
		mes "[Worker]";
		mes "现在想想，他的眼睛真漂亮。";
		npctalk "没错。","Worker#171_rvs_13",bc_self;
		next;
		mes "[Worker]";
		mes "总之，如果你在找特定的人，应该^0000FF去问研究员。^000000他们大多已经逃走了，但还有几个人留了下来。";
		mes "就在作物旁边的<NAVI>[研究员]<INFO>sp_cor,224,77,0,101,0</INFO></NAVI>。你看到她了吗？";
		completequest 17020;
		setquest 17021;
		close;
	}
	if (isbegin_quest(17021) == 1) {
		mes "[Worker]";
		mes "总之，如果你在找特定的人，应该^0000FF去问研究员。^000000他们大多已经逃走了，但还有几个人留了下来。";
		mes "就在作物旁边的<NAVI>[研究员]<INFO>sp_cor,224,77,0,101,0</INFO></NAVI>。你看到她了吗？";
		close;
	}
	mes "[Worker]";
	mes "我现在想不出别的了，心情很差。我很快就回去工作……";
	close;

OnInit:
	questinfo QTYPE_QUEST,QMARK_YELLOW,"isbegin_quest(17020) == 1";
	end;
}

sp_cor,224,77,3	script	Researcher#171_rvs_0	4_F_SCIENCE,{
	if (isbegin_quest(17021) == 1) {
		mes "[Researcher]";
		mes "总之，这些东西怎么办……？";
		mes "它们没法使用，真可惜。";
		next;
		mes "[Researcher]";
		mes "你……你就是和持枪者一起来的冒险家。我要惹上麻烦了吗？我对这些非法实验和研究所一无所知。";
		next;
		select("我在找一个人。");
		mes "[Researcher]";
		mes "谁？Patrick？我不认识他。我认识的人不多，只专注于这里的田间工作。";
		npctalk "我能告诉你所有蔬菜的名字。","",bc_self;
		next;
		select("研究员为什么要做田间工作？");
		mes "[Researcher]";
		mes "嗯……简单来说，是为了喂养实验动物。我在培育能让动物终生维持生命的超级蔬菜。";
		next;
		mes "[Researcher]";
		mes "加工和提炼蔬菜……用这些东西……他们究竟想做什么？？难道是想解决饥饿问题？";
		mes "其实我不知道。也许你知道。";
		next;
		mes "[Researcher]";
		mes "这里的首席研究员知道所有细节。老实说，我没想到他们会那样直接离开。我一直把他们当成家人……";
		next;
		mes "[Researcher]";
		mes "负责人让我收拾行李，说外面发生了骚动。我因为必须照料作物而犹豫，但后来所有人都已经离开了。";
		npctalk "我觉得自己被抛弃了。","",bc_self;
		next;
		mes "[Researcher]";
		mes "听到副总统说话的那一刻我就明白了。我曾经自豪地工作，但到头来只是在为高级研究员制作消耗品。";
		next;
		mes "[Researcher]";
		mes "毕竟我被自己的自负蒙蔽了，完全没意识到发生了什么。";
		npctalk "我终于明白了真正的含义……","",bc_self;
		next;
		mes "[Researcher]";
		mes "总之，我在找一个<NAVI>[人]<INFO>sp_cor,151,180,0,000,0</INFO></NAVI>帮我洗衣服。已经有一阵子了，我的脚都脏了。";
		completequest 17021;
		setquest 17022;
		getexp 300000,300000;
		close;
	}
	if (isbegin_quest(17022) == 1) {
		mes "[Researcher]";
		mes "总之，我在找一个<NAVI>[人]<INFO>sp_cor,151,180,0,101,0</INFO></NAVI>帮我洗衣服。已经有一阵子了，我的脚都脏了。";
		close;
	}
	mes "[Researcher]";
	mes "总之，这些东西怎么办……？";
	mes "如果就这样放着，我怕它们会被浪费。";
	close;

OnInit:
	questinfo QTYPE_QUEST,QMARK_YELLOW,"isbegin_quest(17021) == 1";
	end;
}

sp_cor,151,180,5	script	Worker#171_rvs_15	4_M_RUSMAN2,{
	if (isbegin_quest(17022) == 1) {
		mes "[Worker]";
		mes "嗯……我不想洗这些东西，呃……里面好像烧焦了。";
		next;
		mes "[Worker]";
		mes "嘿，别再靠近了。这些是受污染的物品。小心。";
		next;
		select("我有件事想问你。");
		mes "[Worker]";
		mes "哦，是你救了我们！我叫Marcus。你来这里做什么？";
		npctalk "很高兴见到你，我叫Marcus。","",bc_self;
		next;
		select("来自利哈鲁特的Marcus Holzman？");
		mes "[Marcus]";
		mes "你认识我？我不认识你……";
		next;
		select("你认识Eva吗？");
		mes "[Marcus]";
		mes "不，你到底是谁？你怎么认识Eva Mueller？是Eva派你来的吗？她过得怎么样？天啊！Eva！她过得怎么样？";
		npctalk "啊……Eva，我亲爱的Eva……","",bc_self;
		next;
		mes "[Marcus]";
		mes "Eva，我想再见到Eva。她忘了我吗？我已经好几年没能联系到她了。";
		npctalk "啊，啊哈……我真是个糟糕的人……","",bc_self;
		next;
		select("她因为一直联系不到你而担心。");
		mes "[Marcus]";
		mes "我没法寄信，也无法联系外界，更不能离开这里。这就是这里的规定。";
		next;
		select("可是，上面说你在休假。");
		mes "[Marcus]";
		mes "休假？我来到这里后每天都在工作。你为什么这么说？";
		npctalk "我还是第一次听说。","",bc_self;
		next;
		select("我正在调查失踪人员。");
		mes "[Marcus]";
		mes "我真不知道该怎么感谢你。";
		next;
		select("我可以帮你转交信件。");
		mes "[Marcus]";
		mes "真的吗……你愿意帮我……要是我们早点认识，就会成为一辈子的朋友了。有什么需要帮忙的就告诉我。";
		next;
		select("你认识Patrick Kaufmann吗？");
		mes "[Marcus]";
		mes "这是个熟悉的名字……Patrick……Patrick……你说的是那个清理实验室的Pat吗？";
		mes "他也是从利哈鲁特来的人吧？";
		next;
		select("对，就是他。");
		mes "[Marcus]";
		mes "没错，没错！就是那个高大的人。我想和他做朋友，因为我们来自同一个地方。有一天我没再见到他，之后我就被调走了。";
		next;
		mes "[Marcus]";
		mes "那是设施维护部门，我告诉他们事情不该这样运转。";
		next;
		mes "[Marcus]";
		mes "我^0000FF熟悉实验室里工作的人^000000，路过时见过他几次。他不在那里工作了吗？";
		next;
		mes "[Marcus]";
		mes "总之，如果你想知道更多，就去看看<NAVI>[焚烧炉]<INFO>sp_cor,70,263,0,101,0</INFO></NAVI>。";
		mes "他们正在收集和整理散落的材料，也许知道更多关于Pat的事。";
		next;
		mes "[Marcus]";
		mes "这些待洗物很快会被送到焚烧炉。嗯，这可不好。放进洗衣机洗一次，也不一定能洗干净……";
		next;
		mes "[Marcus]";
		mes "谢谢你。我待在这里期间写了很多信，我会整理好它们。再次感谢你！";
		completequest 17022;
		setquest 17023;
		close;
	}
	if (isbegin_quest(17023) == 1) {
		mes "[Marcus]";
		mes "总之，如果你想知道更多，就去看看<NAVI>[焚烧炉]<INFO>sp_cor,70,263,0,101,0</INFO></NAVI>。";
		mes "他们正在收集和整理散落的材料，也许知道更多关于Pat的事。";
		close;
	}
	mes "[Marcus]";
	mes "嗯……我不想洗这些东西，呃……里面好像烧焦了。";
	close;

OnInit:
	questinfo QTYPE_QUEST,QMARK_YELLOW,"isbegin_quest(17022) == 1";
	end;
}

sp_cor,70,263,5	script	Worker#171_rvs_16	4_M_02,{
	if (isbegin_quest(17023) == 1) {
		mes "[Worker]";
		mes "别把厨余垃圾放进去，会发臭的。";
		npctalk "小心这里。","",bc_self;
		next;
		mes "[Worker]";
		mes "哦……你是来取材料的吗？我已经尽力整理了，但我不知道它们是什么，所以无法分类。";
		next;
		select("我可以看看吗？");
		mes "[Worker]";
		mes "当然可以。但你真的觉得里面有有价值的东西吗？他们离开前应该已经拿走了。";
		next;
		select("所有垃圾都在这里焚烧吗？");
		mes "[Worker]";
		mes "准确地说，这里不是焚烧炉，只是垃圾焚烧前的临时装载站。真正的焚烧炉在更远处。";
		next;
		select("研究员如何处理垃圾？");
		mes "[Worker]";
		mes "我们收集各个房间的垃圾，再进行处理。嗯，通常我们会为爱整洁的人做这些。他们不太说话。";
		npctalk "我无法理解这么聪明的人为什么会这么脏乱。";
		next;
		mes "[Worker]";
		mes "连垃圾都不能扔到正确的地方，他们怎么能称自己为真正的人？也许山里还堆着他们留下的垃圾。";
		next;
		select("你们也焚烧受污染的材料吗？");
		mes "[Worker]";
		mes "不是那样。我只分类大型材料或技术设备。";
		next;
		mes "[Worker]";
		mes "有专门的废料场，只收集无法焚烧的受污染材料。我们经常和那里联系。";
		next;
		select("你亲自去过那里吗？");
		mes "[Worker]";
		mes "不，我本人不会去那里。有专门的部门负责。他们使用铁轨和货车运输，因为材料有毒或体积太大。";
		next;
		mes "[Worker]";
		mes "嗯……你知道……垃圾处理……是一项重要工作……";
		npctalk "不，不是那样。人应该怀着善意生活。","",bc_self;
		next;
		select("你认识Patrick Kaufmann吗？");
		next;
		mes "[Worker]";
		mes "Patrick Kaufmann……？不，不过你是说Patrick Young，对吧？";
		next;
		select("不。不过我要去废料区。");
		mes "[Worker]";
		mes "哦，你要去<NAVI>[废料区]<INFO>sp_rudus,227,351,0,101,0</INFO></NAVI>？嗯，祝你好运。我觉得你会需要它。";
		completequest 17023;
		setquest 17024;
		close;
	}
	if (isbegin_quest(17024) == 1) {
		mes "[Worker]";
		mes "哦，你要去<NAVI>[废料区]<INFO>sp_rudus,227,351,0,101,0</INFO></NAVI>？嗯，祝你好运。我觉得你会需要它。";
		close;
	}
	mes "[Worker]";
	mes "接下来该做什么？看来我不能继续在这里工作了。";
	close;

OnInit:
	questinfo QTYPE_QUEST,QMARK_YELLOW,"isbegin_quest(17023) == 1";
	end;
}

sp_rudus,15,280,5	script	#171_EV_RUDUS	HIDDEN_WARP_NPC,3,3,{
	end;

OnTouch:
	if (isbegin_quest(17025) == 1)
		cloakoffnpc "Discarded Person#171_rudus",getcharid(0);
	end;
}

sp_rudus,227,351,0	script	Suspicious Evidence#171_rudus	4_ENERGY_BLACK,{
	if (isbegin_quest(17024) == 1) {
		mes "[" + strcharinfo(0) + "]";
		mes "在这么大的地方，你怎么找得到东西？连个可以询问的人都没有。";
		mes "你真的能找到被遗弃项目的痕迹吗……？";
		next;
		mes "......";
		next;
		mes "............";
		next;
		mes "....................";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "这里什么都没有。我不知道该找什么……";
		next;
		mes "[Suspicious Voices]";
		mes "混合比例是1:3……你在做什么？应该是1:4。你想让实验室爆炸吗？";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "什么……我听到一个<NAVI>[声音]<INFO>sp_rudus,15,280,0,101,0</INFO></NAVI>，是从哪里传来的？";
		completequest 17024;
		setquest 17025;
		cloakoffnpc "Discarded Person#171_rudus",getcharid(0);
		close;
	}
	if (isbegin_quest(17025) == 1) {
		mes "[" + strcharinfo(0) + "]";
		mes "什么……我听到一个<NAVI>[声音]<INFO>sp_rudus,15,280,0,101,0</INFO></NAVI>，是从哪里传来的？";
		cloakoffnpc "Discarded Person#171_rudus",getcharid(0);
		close;
	}
	mes "[" + strcharinfo(0) + "]";
	mes "这里什么都没有。";
	close;

OnInit:
	questinfo QTYPE_QUEST,QMARK_YELLOW,"isbegin_quest(17024) == 1";
	end;
}

sp_rudus,15,280,5	script	Discarded Person#171_rudus	4_F_MUT1,{
	if (isbegin_quest(17025) == 1) {
		mes "[Discarded Person]";
		mes "1:2的比例可能更好……不，还是别做实验了。我觉得你说得对。";
		next;
		select("哦，哇，你好？没关系，我不介意！");
		mes "[Discarded Person]";
		mes "你为什么惊讶？我还没死呢。";
		unittalk getcharid(3),strcharinfo(0) + " : I'm sorry.",bc_self;
		next;
		mes "[Discarded Person]";
		mes "没关系。如果看到我自己，我也会惊讶。我尽量不照镜子。";
		npctalk "这里没有镜子。","",bc_self;
		next;
		select("你为什么看起来像研究员……？");
		mes "[Discarded Person]";
		mes "研究员为什么不能在这里？";
		mes "你想知道为什么一个主持实验的人会被扔进垃圾箱，然后被遗弃。";
		next;
		mes "[Discarded Person]";
		mes "我的唯一目标就是成功，我什么事都做过。";
		mes "你不觉得这对我来说是个恰当的结局吗？";
		next;
		mes "[Discarded Person]";
		mes "研究和实验并不总是安全的。我以为自己会没事，但最后还是没能躲过。";
		npctalk "我以为自己会没事。","",bc_self;
		next;
		mes "[Discarded Person]";
		mes "把我遗弃在这里的人没想到我还活着。";
		mes "实验室被摧毁后，有毒物质在各处喷涌出来。";
		next;
		mes "[Discarded Person]";
		mes "呵呵。所以我就要在这里等着这样死去。我原本想用研究让世界惊讶，结果却住在了这里。";
		next;
		select("这里还有其他人吗？");
		mes "[Discarded Person]";
		mes "你在找什么？死人？活人？还是半死不活的人？";
		next;
		mes "[Discarded Person]";
		mes "你觉得在这里能找到多少被遗弃的人？";
		npctalk "你什么时候觉得这里被当作废料处理设施了？","",bc_self;
		next;
		mes "[Discarded Person]";
		mes "如果他们有^0000FF某种身体状况且出身贫困，^000000有时甚至无家可归，就更容易拿他们做实验。";
		next;
		mes "[Discarded Person]";
		mes "别那样看我。你越穷，你的家人就越容易被利用；如果不利用这些人，我们才是傻瓜。至少我当时是这么想的。";
		next;
		mes "[Discarded Person]";
		mes "你觉得这些年来所有失踪的人都去了哪里？";
		next;
		mes "[Discarded Person]";
		mes "施瓦茨瓦尔德的许多失踪人员最后都会来到这里。你要逐一调查他们吗？如果你有足够时间，这也不是坏事。";
		next;
		mes "[Discarded Person]";
		mes "还是说你只在找某一个人？";
		next;
		select("我在找Patrick Kaufmann。");
		mes "[Discarded Person]";
		mes "他什么时候进来的？";
		next;
		select("我不知道。");
		mes "[Discarded Person]";
		mes "嗯……我^0000FF没有你要找的信息。^000000我是最后一个来到这里的人。";
		next;
		mes "[Discarded Person]";
		mes "我没什么事可做，所以看遍了这里，但没见过任何人……你明白我的意思吗？";
		next;
		mes "[Discarded Person]";
		mes "你应该试着在垃圾堆里找一条^0000FF身份手环^000000。你知道那是什么吗？";
		mes "腕带就是一种手环，上面写着实验对象的名字。";
		next;
		mes "[Discarded Person]";
		mes "如果他来过，地板上应该会有一条手环。也可能已经不在那里了……";
		next;
		mes "[Discarded Person]";
		mes "如果找不到他，也许你可以买一条手环，然后替他举行正式葬礼。";
		next;
		select("……");
		mes "[Discarded Person]";
		mes "... why am I not going? I did everything I wanted to do here.";
		next;
		select("我们一起出去。");
		mes "[Discarded Person]";
		mes "离开这里？别这样，我快死了。这是残酷的事实。我很了解自己的身体，这正是我研究的东西。";
		next;
		mes "[Discarded Person]";
		mes "现在我的脚是这样，但另一条腿很快也会发生变化。";
		mes "然后是我的双臂……最后……你还能把我称作人类吗？";
		next;
		mes "[Discarded Person]";
		mes "即使接受治疗，我也不可能活下来。我很清楚这一点。对我来说，独自安静地生活在这里不是更好吗？";
		next;
		mes "[Discarded Person]";
		mes "看，这就是我现在的家人。我为什么要背负这么沉重的负担？放弃希望可比活在别处容易一百倍，不是吗？";
		next;
		mes "[Discarded Person]";
		mes "我说这些话听起来很奇怪吗？我觉得自己有点失控了。";
		next;
		mes "[Discarded Person]";
		mes "是的，有时我甚至幻想把人们从痛苦中解脱出来。";
		next;
		mes "[Discarded Person]";
		mes "这可能不是他们的家人希望的，但对他们来说外面很危险。你明白我的意思吗？";
		next;
		mes "[Discarded Person]";
		mes "而且……我不认为这是巧合。";
		npctalk "我不相信更高的力量，但也许我开始相信了。","",bc_self;
		next;
		mes "[Discarded Person]";
		mes "如果你过一段时间回来，而我已经完全变成怪物，请杀了我。";
		next;
		mes "[Discarded Person]";
		mes "我宁愿生命早早结束，也不愿哪怕只当一秒钟的怪物。明白了吗？";
		next;
		mes "[Discarded Person]";
		mes "嗯，真没想到我告诉了你这么多。我该休息了。";
		getexp 300000,300000;
		completequest 17025;
		setquest 17026;
		close;
	}
	mes "[Discarded Person]";
	mes "你应该试着在垃圾堆里找一条^0000FF身份手环^000000。你知道那是什么吗？";
	mes "腕带就是一种手环，上面写着实验对象的名字。";
	close;

OnInit:
	questinfo QTYPE_QUEST,QMARK_YELLOW,"isbegin_quest(17025) == 1";
	cloakonnpc();
	end;
}

sp_rudus,55,137,3	script	Suspicious Evidence#171_rudus_0	4_ENERGY_BLACK,{
	.@id = atoi(replacestr(strnpcinfo(2),"171_rudus_",""));

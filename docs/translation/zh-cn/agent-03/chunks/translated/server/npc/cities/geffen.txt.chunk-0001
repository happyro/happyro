geffen,59,143,0	script	Meera	91,{
	mes "[米拉]";
	mes "欢迎来到魔法之城";
	mes "吉芬！";
	next;
	mes "[米拉]";
	mes "我不太懂魔法，但你知道什么尝起来像魔法吗？^CC6600蜂蜜^000000！";
	next;
	mes "[米拉]";
	mes "它甜美可口。我不确定它是否能催情，但我知道它能消除疲劳、帮助伤口恢复！";
	next;
	mes "[米拉]";
	mes "生活在草原上的大黄蜂听从蜂后的命令采集花蜜。蜂蜜就是用它们采集的花蜜制成的。";
	next;
	mes "[米拉]";
	mes "但还不止这些。有一种专供蜂后食用的特殊蜂蜜：";
	mes "^CC6600蜂王浆^000000！";
	next;
	mes "[米拉]";
	mes "没有什么能比得上蜂王浆的浓郁滋味。我觉得它比普通蜂蜜更有益！";
	close;
}

geffen,156,190,0	script	Orwalk	82,{
	mes "[奥尔沃克]";
	mes "……有意思。";
	mes "真令人着迷。";
	mes "哦！让我告诉你";
	mes "这个奇妙的故事~";
	next;
	mes "[奥尔沃克]";
	mes "研究魔法时，我发现了这卷神秘的卷轴。它记载了一棵名为世界树的树。";
	next;
	mes "[奥尔沃克]";
	mes "世界树的叶、种子和果实连接着世上的一切生灵。根据卷轴记载，世界树还参与了世界的创造。";
	next;
	mes "[奥尔沃克]";
	mes "说到这里，我还听说克魔岛附近某片土地上有一棵奇迹之树。它们一定有关联，我敢肯定！";
	close;
}

geffen_in,164,109,0	script	Wizard Stanza	64,{
	mes "[斯坦扎]";
	mes "我感受到强大灵魂的存在。难道是你……？";
	next;
	mes "[斯坦扎]";
	if (BaseJob == Job_Mage)
		mes "看来你接受过神秘技艺的训练。魔法……它的力量受因果律支配。";
	else if (BaseJob == Job_Acolyte) {
		mes "啊……";
		mes "我看出你以某种方式运用神圣力量。我想神圣力量也可以视为一种神秘能量。";
	}
	else if (Class == Job_Novice)
		mes "虽然你现在还不能使用魔法或其他强力技能，但这些知识将来可能会有帮助，年轻的初心者……";
	else
		mes "虽然你没有接受正式的魔法训练，但无论是否自知，你都在使用汲取异界能量的技能……";
	next;
	mes "[斯坦扎]";
	mes "如果你用神秘能量伤害他人，或违背大自然母亲制定的规则，那股力量自然会反过来伤害你。记住，种什么因得什么果。";
	next;
	mes "[斯坦扎]";
	mes "有一种物品能保护施法者免受恶果，让某些魔法安全使用。它们就是闪耀而神秘的宝石。";
	next;
	mes "[斯坦扎]";
	mes "宝石……";
	mes "想要充分发挥力量，就记住这种物品。";
	close;
}

geffen,147,26,0	script	Ralphie	97,{
	mes "[拉尔菲]";
	mes "世界某处有一根稀有法杖，能将精神能量转化为物理力量，赋予持有者^990000毁灭性的力量^000000……";
	next;
	mes "[拉尔菲]";
	mes "有了它，任何人都能像赫拉克勒斯一样强壮……即使是我这样的弱者！哈哈哈哈哈，";
	mes "我一定要得到它！";
	next;
	emotion ET_SURPRISE;
	mes "[拉尔菲]";
	mes "……天哪！";
	mes "你什么时候开始";
	mes "听我说的？";
	next;
	mes "[拉尔菲]";
	mes "你刚才有没有";
	mes "听到什么？";
	mes "呜哈哈……哈。哈。";
	next;
	mes "[拉尔菲]";
	mes "嗯……";
	mes "我什么都没说。就算说了，";
	mes "也请全部忘掉，";
	mes "不管是什么~";
	next;
	mes "[拉尔菲]";
	mes "……真尴尬。";
	close;
}

geffen,111,48,0	script	Stacey	101,{
	if (getequipid(EQI_HEAD_TOP) == 2299) {
		mes "[斯泰西]";
		mes "哦……！";
		mes "你戴的是兽人头盔吗？！太酷了！哇……";
		next;
		mes "[斯泰西]";
		if (Sex == SEX_MALE) {
			mes "你看起来真是……";
			mes "粗犷又阳刚~";
		}
		else {
			mes "哦哦~！";
			mes "我好羡慕！";
		}
		close;
	}
	else if (getequipid(EQI_HEAD_TOP) == 5094) {
		mes "[斯泰西]";
		mes "哦……";
		mes "哇……";
		next;
		mes "[斯泰西]";
		mes "那是……";
		mes "那是兽人英雄的头盔！";
		next;
		mes "[斯泰西]";
		if (Sex == SEX_MALE) {
			mes "这……";
			mes "你身边仿佛环绕着惊人的阳刚气息！哦哦~！你一定让所有女孩都无法抗拒！";
			next;
			emotion ET_THROB;
			mes "[斯泰西]";
			mes "我也不例外。";
		}
		else {
			mes "天哪，你一定很强壮！";
			mes "不过我以为只有兽人族成员才能戴那个？";
		}
		close;
	}
	else {
		mes "[斯泰西]";
		mes "你好~！";
		mes "哦，你是";
		mes "冒险者吧？";
		next;
		mes "[斯泰西]";
		mes "你见过半人族的兽人吗？从这里向南走，我想你能在深处的森林里找到兽人。";
		next;
		mes "[斯泰西]";
		mes "听说兽人有自己的文化和语言，和我们人类一样。那兽人也会约会吗……？";
		next;
		mes "[斯泰西]";
		mes "就是那种温柔地说些甜言蜜语，然后……哦！我真的想知道！";
		close;
	}
}

geffen_in,34,170,0	script	Theodore	47,{
	mes "[西奥多]";
	mes "你好！";
	mes "今天不是";
	mes "美好的一天吗？";
	next;
	mes "[西奥多]";
	mes "嗯，我也不知道。我为了成为魔法师一直刻苦学习，整夜不眠地研究一切魔法相关的东西。";
	next;
	mes "[西奥多]";
	mes "*叹气……*";
	mes "我尤其担心使用魔法的各种弊端。";
	next;
	mes "[西奥多]";
	mes "糟糕！上次探险时被远程敌人发现，真烦人。那可恶的怪物打断了我所有法术的施放！我根本没打中它！";
	next;
	mes "[西奥多]";
	mes "之后我意识到，需要某种武器来应对敌人的远程攻击，一种能从远处发动攻击的武器……";
	next;
	mes "[西奥多]";
	mes "比如……";
	mes "尖锐、穿透力强的";
	mes "木制投射物发射器。";
	next;
	mes "[西奥多]";
	mes "但我去哪儿才能";
	mes "找到那种东西？！";
	close;
}

geffen,146,148,4	script	Suspicious Guy	99,6,6,{
	end;

OnTouch_:
	mes "[？]";
	mes "^333333*嘘——！*";
	mes "喂——你！";
	mes "想弄点好东西吗？过来看看！^000000";
	next;
	mes "[可疑商人]";
	if (Sex == SEX_MALE)
		mes "嘿，硬汉。你看起来很聪明，肯定能看出眼前的便宜货。";
	else
		mes "哎呀，真是个漂亮姑娘。今天正好是你的幸运日！";
	next;
	mes "[可疑商人]";
	mes "告诉我你想要什么，我会从珍贵又实惠的货物里给你优惠。";
	next;
	switch(select("给我一些恢复 HP 的药水:呃，你有短剑吗？:你没有好的斗篷吗？:你还有别的东西吗？")) {
	case 1:
		mes "[可疑商人]";
		mes "哦，你喜欢药水，是吧？";
		mes "没问题，我有货！";
		next;
		mes "[可疑商人]";
		mes "就是这个！高品质红色药水！喝下去立刻见效，一旦入口就停不下来。这东西就是这么好！";
		next;
		mes "[可疑商人]";
		mes "来嘛，老兄。这是最新的红色药水。我从朋友的密友那里弄来的，来源绝对可靠，而且非常便宜。你不能错过！";
		next;
		select("呃，我能买白色药水吗？");
		mes "[可疑商人]";
		mes "白色药水？哦，那种东西不存在。不过，如果有人卖那种东西，带来给我，我可以……测试一下区别。但我这可是正品。";
		next;
		mes "[可疑商人]";
		mes "喝红色药水就能治好所有伤口！我只卖 ^FF3333500 Zeny^000000 一瓶！";
		next;
		mes "[可疑商人]";
		mes "是不是很便宜？！因为需求量太大，我一次最多只能卖给你 100 瓶。";
		next;
		while(1) {
			input .@input;
			if (.@input == 0) {
				mes "[可疑商人]";
				if (Sex == SEX_MALE)
					mes "啊，老兄~你真让我心碎！以这个价格，我简直是在做慈善！";
				else
					mes "等、等等！你还没听我说红色药水能让你在该瘦的地方瘦、该胖的地方胖！等等！";
				close;
			}
			else if (.@input > 100) {
				mes "[可疑商人]";
				mes "哇……";
				mes "我不能让你买那么多。不是因为药水里有什么微量杂质之类的……";
				next;
			}
			else
				break;
		}
		set .@Red_potion_hap,.@input * 500;
		if (Zeny < .@Red_potion_hap) {
			mes "[可疑商人]";
			mes "哎呀~";
			mes "你是不是";
			mes "缺钱？";
			mes "那可不行。";
			next;
			mes "[可疑商人]";
			mes "^333333我得找另一个倒霉蛋接手这些破烂！^000000 *咳*我是说，欢迎下次再来！";
			close;
		}
		set Zeny, Zeny-.@Red_potion_hap;
		getitem 501,.@input; //Red_Potion
		break;
	case 2:
		mes "[可疑商人]";
		if (Sex == SEX_MALE) {
			mes "你这么强壮，为什么需要短剑？那种东西会在你强力挥砍下折断！";
			next;
			mes "[可疑商人]";
			mes "现在……";
			mes "你真正需要的是一把";
			mes "^FF3333男子气概十足的短剑^000000。";
		}
		else {
			mes "像你这么漂亮的女士？别开玩笑了，厨房刀是唠叨的老妇人和佣人用的。";
			next;
			mes "[可疑商人]";
			mes "现在……";
			mes "你真正需要的是一把精美绝伦的";
			mes "^FF3333法式短剑^000000，与你的美丽优雅相配。";
		}
		next;
		mes "[可疑商人]";
		mes "我称它为……";
		mes "^FF3333左手短剑^000000！这是我自己发明的，只卖 9,400 Zeny！";
		next;
		select("你不也给我剑鞘吗？");
		mes "[可疑商人]";
		mes "剑鞘？";
		mes "哇，这要求几乎太过分了！好吧，好吧……";
		next;
		mes "[可疑商人]";
		mes "因为我很喜欢你，购买时免费送你一个剑鞘！";
		mes "这优惠怎么样？";
		next;
		mes "[可疑商人]";
		mes "你绝对不能错过！现在想要几把？";
		next;
		while(1) {
			input .@input;
			if (.@input == 0) {
				mes "[Suspicious Guy]";
				mes "老兄，你错过了多少一生难得的机会？希望你能中彩票……";
				mes "你大概也会";
				mes "错过那个机会。";
				close;

			}
			else if (.@input > 100) {
				mes "[可疑商人]";
				mes "哇！";
				mes "我不能卖给你那么多短剑！那会引来普隆德拉骑--我是说，我本来要捐一些短剑给……饥饿的孩子？";
				next;
			}
			else
				break;
		}
		set .@Main_gauche_hap,.@input * 9400;
		if (Zeny < .@Main_gauche_hap) {
			mes "[可疑商人]";
			mes "缺 Zeny？";
			mes "人生中最棒的交易就在眼前，你却买不起？！真是悲剧……";
			close;
		}
		set Zeny, Zeny-.@Main_gauche_hap;
		getitem 1207,.@input; //Main_Gauche
		break;
	case 3:
		mes "[可疑商人]";
		if (Sex == SEX_MALE)
			mes "斗篷？那都过时了！你知道最新的防具是什么吗？";
		else
			mes "这么漂亮的女士，怎么能穿过时的东西？你知道什么会让你看起来更漂亮吗？";
		next;
		mes "[可疑商人]";
		mes "没错！";
		mes "兜帽！如今戴上它是赢得尊重最快的方法！";
		next;
		mes "[可疑商人]";
		mes "戴上兜帽，怪物会害怕你并惊恐逃跑！再看看这结实的布料，我怎么拉都不会破！";
		next;
		select("这个兜帽没有抽绳……？");
		mes "[可疑商人]";
		mes "哈哈！你在说什么？不需要抽绳！太空时代的嫘萦、尼龙和氪纤维能让兜帽稳稳戴在头上！";
		next;
		mes "[可疑商人]";
		mes "老兄……";
		mes "这顶兜帽融入了这么多科技。你敢相信我只卖 930 Zeny 吗？";
		next;
		mes "[可疑商人]";
		mes "显然，这是世纪大优惠。你想要几顶？";
		next;
		while(1) {
			input .@input;
			if (.@input == 0) {
				mes "[可疑商人]";
				mes "哎呀……";
				mes "不会是因为没有抽绳吧？";
				close;
			}
			else if (.@input > 100) {
				mes "[可疑商人]";
				mes "哇~！";
				mes "我不能卖给你那么多！你想占我便宜吗？";
				next;
			}
			else
				break;
		}
		set .@Hood__hap,.@input * 930;
		if (Zeny < .@Hood__hap) {
			mes "[可疑商人]";
			mes "糟糕……";
			mes "缺 Zeny，是吧？";
			close;
		}
		set Zeny, Zeny-.@Hood__hap;
		getitem 2501,.@input; //Hood
		break;
	case 4:
		mes "[可疑商人]";
		mes "老兄……";
		mes "你真爱提出不可能的要求。不过我现在就告诉你，世上没有其他商人能卖我独有的货物。";
		next;
		mes "[可疑商人]";
		mes "你只要相信我就好！";
		close;
	}
	mes "[可疑商人]";
	mes "我这里明明有最好的物品，根本不需要去别处看！";
	next;
	mes "[可疑商人]";
	mes "有空再来，多买些我的货物。我喜欢知道自己想要什么的顾客！嘿嘿~";
	close;
}

geffen_in,22,125,1	script	Crumpler	52,{
	mes "[克伦普勒]";
	mes "哦哦哦~！";
	mes "你穿得真漂亮，";
	mes "真是华丽的魔法师！";
	next;
	if (Class == Job_Mage) {
		mes "^3355FF你暗自发誓，总有一天要向这个侮辱高贵魔法师职业的蛮横醉汉血债血偿。总有一天……^000000";
		close;
	}
	else if (Class == Job_Wizard) {
		select("其实，我是巫师。");
		mes "[克伦普勒]";
		mes "我好害怕！";
		mes "巫师？！哇哈哈！";
		next;
		mes "[克伦普勒]";
		mes "大家都知道巫师只有智慧没有力量！来吧，聪明人！让我看看你有多强！";
		next;
		switch(select("陨石术！:怒雷强击！:饶恕他。")) {
		case 1:
			mes "[克伦普勒]";
			mes "嗯？";
			mes "你刚才说什么？";
			next;
			mes "[克伦普勒]";
			mes "...";
			next;
			mes "[克伦普勒]";
			mes "……";
			mes "……";
			next;
			mes "[克伦普勒]";
			mes "哦哦哦哦哦";
			mes "糟糕！";
			emotion ET_SURPRISE;
			next;
			mes "[克伦普勒]";
			mes "救命啊啊啊！";
			specialeffect EF_METEORSTORM;
			close;
		case 2:
			mes "[克伦普勒]";
			mes "哈哈哈哈！";
			mes "愚蠢的巫师！只有巴风特那样的怪物才能承受这种大法术——";
			next;
			mes "[克伦普勒]";
			mes "天哪……";
			mes "你是认真的……";
			next;
			specialeffect EF_LORD;
			mes "[克伦普勒]";
			mes "啊啊啊啊~！";
			mes "好烫啊啊啊！";
			close;
		case 3:
			mes "["+strcharinfo(0)+"]";
			mes "不……";
			mes "我只能用自己的力量";
			mes "行善。";
			next;
			mes "[克伦普勒]";
			mes "哈！哈！";
			mes "行善……";
			mes "什么都做不了！";
			close;
		}
	}
	else if (Class == Job_Sage) {
		select("其实，先生，我是贤者。");
		mes "[Crumpler]";
		mes "贤……";
		mes "贤者？";
	// 保持翻译切片物理行数
		// 保持翻译切片物理行数
		// 保持翻译切片物理行数
		// 保持翻译切片物理行数
		// 保持翻译切片物理行数

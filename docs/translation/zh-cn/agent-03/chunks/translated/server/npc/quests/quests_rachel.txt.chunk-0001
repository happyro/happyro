//===== rAthena Script ======================================= 
//= Rachel Quests
//===== By: ================================================== 
//= L0ne_W0lf
//===== Current Version: ===================================== 
//= 3.6
//===== Compatible With: ===================================== 
//= rAthena Project
//===== Description: ========================================= 
//= Collection of Rachel Quests 
//= Lost Child Quest:
//= - End of quest coincides with opening the Sanctuary.
//= - Variable in use: lost_boy (max 13)
//= Bruspetti Quest:
//= - [Official Conversion]
//= - Requires friendship quest as a prerequisite.
//= - Variable in use: rach_vice (max 24)
//= Ice Necklace Quest:
//= - iRO uses a different sprite for Urstia, and no cutins.
//= - Variable in use: ice_necklace_q (max 7)
//= Sanctuary Quest:
//= - Actually two quests in one. Donation and dungeon quest.
//= - Requires 10000 donations before players can start the quest.
//= - Variable in use: ra_tem_q (max 23) (unset at end)
//= - Variable in use: Once completed MISC_QUEST bit 8192 is set
//= - Variable in use: ra_have_donated (0 no/1 yes)
//= - Variable in use: $rachel_donate (max 10000)
//===== Additional Comments: ================================= 
//= 3.0 Large reordering of Zhed, and Peace to the Arunafeltz addition. [L0ne_W0lf]
//=     Some more numeric conversion, and some other cleanup.
//= 3.1 Updated Ice Necklace quest, added missing checks. [L0ne_W0lf]
//= 3.2 Added missing updates for Peace to the Arunafeltz quest. [L0ne_W0lf]
//= 3.3 Fixed occurrence of PcName. [L0ne_W0lf]
//=     Fixed level 4 ID warps always being usable.
//= 3.3a Fixed level 4 ID warps again. (Bugreport:4102) [L0ne_W0lf]
//= 3.4 Added quest log entries for:
//=     - Ice Necklace Quest
//=     - Thor Volcano Base Quest addition.
//= 3.5 Updated RE/Pre-RE EXP. [Euphy]
//= 3.6 Added questlog support. [Euphy]
//============================================================ 

// Lost Child Quest (Prerequisite to High Priest quest) :: rachel_wonjumin
//============================================================ 
ra_in01,384,246,3	script	Vincent#ra_in01	47,{
	if (BaseLevel < 60) {
		mes "[Vincent]";
		mes "你在 Zhed 爵士的宅邸里找新员工，但我不认为勇敢的冒险者适合这种家务工作。";
		close;
	}
	if (lost_boy < 1) {
		mes "[Vincent]";
		mes "我是 Vincert，这座宅邸的管家，也是主人 Zhed 爵士的忠诚仆人。他是整个 Arunafeltz 最有权势的人。";
		next;
		mes "[Vincent]";
		mes "主人目前去参加高级神官会议，已经离开几天了。我想请你代他帮忙解决一个问题。";
		next;
		switch(select("我太忙了。:好啊，为什么不？")) {
		case 1:
			mes "[Vincent]";
			mes "我明白。很抱歉你现在太忙……如果之后有空，我想再次请求你的帮助。";
			close;
		case 2:
			mes "[Vincent]";
			mes "谢谢。教皇因 Zhed 爵士对 Arunafeltz 的巨大贡献，奖给他一颗珍贵宝石。然而宝石失踪了，我需要你帮忙找回。";
			next;
			mes "[Vincent]";
			mes "我没有证据，但怀疑是仆人 Phobe 偷的。他在宝石失踪的同时也消失了。";
			next;
			mes "[Vincent]";
			mes "请在 Zhed 爵士回来发现真相前找回宝石并查明窃贼。如果你能保守秘密，我将非常感激。";
			next;
			mes "[Vincent]";
			mes "我相信你想审问 Phobe，但他逃到某处去了。你可以询问其他仆人他的下落。再次感谢你的帮助。";
			set lost_boy,1;
			setquest 8089;
			close;
		}
	}
	else if ((lost_boy >= 1) && (lost_boy < 4)) {
		mes "[Vincent]";
		mes "我建议在宅邸里找找，并询问仆人关于 Phobe 当前下落的线索。";
		close;
	}
	else if ((lost_boy >= 4) && (lost_boy < 7)) {
		mes "[Vincent]";
		mes "时间不多了……请尽快找到宝石和 Phobe。";
		close;
	}
	else if (lost_boy == 7) {
		mes "[Vincent]";
		mes "啊……！你、你好！你还好吗，呃……你脸上的表情是怎么回事？找到 Logan 了吗？";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "没有！我被 Mogan 刺伤了，之后我们谈了谈。你到底想干什么？我来帮你，你却想让我被杀！我要解释！";
		next;
		mes "[Vincent]";
		mes "我……是的，在我试图对你做那种事之后，你值得知道真相。首先，Phobe 是我的儿子，但请别告诉任何人！";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "什么？这有什么大不了？";
		next;
		mes "[Vincent]";
		mes "Arunafeltz 存在某种阶级制度。没人谈论，但移民来此建城的人是统治阶级。";
		next;
		mes "[Vincent]";
		mes "原住民是二等公民，被开发这座城市的移民后裔鄙视。这是悲哀且无法否认的事实。";
		next;
		mes "[Vincent]";
		mes "原住民通常处于低阶层，在城里做艰苦的蓝领工作。Phobe 的母亲 Jenny 就是其中之一。";
		next;
		mes "[Vincent]";
		mes "我爱她是禁忌，尤其是 Zhed 爵士一直照顾我，像父亲一样。";
		mes "如果我娶她，会严重损害他的声誉。";
		mes "";
		mes "";
		mes "";
		mes "";
		next;
		mes "[Vincent]";
		mes "我试图控制感情，但是……Phobe 出生了。现在已经无法回头。";
		mes "不过我们确实秘密结婚了，我不后悔。";
		mes "";
		mes "";
		mes "";
		mes "";
		next;
		mes "[Vincent]";
		mes "Phobe 一定怨恨我……";
		mes "我不得不在别人面前把他和他母亲当作奴隶对待。";
		mes "我知道这很可怕……对所爱之人如此冷漠。";
		mes "";
		mes "";
		mes "";
		next;
		mes "[Vincent]";
		mes "他带着宝石逃跑时，我其实更担心 Phobe，而不是主人的宝物。";
		mes "所以我尽力想把他带回来：我雇用了你。";
		mes "";
		mes "";
		mes "";
		mes "";
		next;
		mes "[Vincent]";
		mes "然而，一旦你找到 Phobe，我就打算杀死你，把盗窃罪名推给你。";
		mes "对不起，我知道这样不对，但我太担心我的孩子了！";
		mes "";
		mes "";
		mes "";
		mes "";
		next;
		mes "[Vincent]";
		mes "希望你能原谅我……";
		mes "我会做一开始就该做的事……";
		mes "我会为宝石失窃承担全部责任，Zhed 爵士想怎么处置我都可以。";
		mes "";
		mes "";
		mes "";
		next;
		mes "[Vincent]";
		mes "宝石非常特殊……教皇命令主人妥善保管，";
		mes "因为它在关键时刻能拯救 Arunafeltz 和 Rachel。";
		mes "";
		mes "";
		mes "";
		mes "";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "宝石真的那么重要吗？好吧，你差点害死我，";
		mes "但既然我还活着，就可以原谅你。";
		mes "";
		mes "";
		mes "";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "只要我在 Zhed 爵士回来前找到宝石和 Phobe，你就不会有麻烦。";
		mes "我会尽快替你找到他们。";
		mes "";
		mes "";
		mes "";
		next;
		mes "[Vincent]";
		mes "你愿意为我这么做？^333333*抽泣*^000000";
		mes "即使我让你经历了这些？^333333*抽鼻子*^000000";
		mes "";
		mes "";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "唉，我已经经历了这么多麻烦，";
		mes "所以";
		mes "我还是把工作完成吧。而且 Phobe 只是个孩子，可能藏在城里的某处。";
		set lost_boy,8;
		changequest 8094,8095;
		close;
	}
	else if (lost_boy == 8) {
		mes "[Vincent]";
		mes "宝石非常特殊……教皇命令主人妥善保管，因为它在关键时刻能拯救 Arunafeltz 和 Rachel。";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "宝石真的那么重要吗？好吧，你差点害死我，但既然我还活着，就可以原谅你。";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "只要我在 Zhed 爵士回来前找到宝石和 Phobe，你就不会有麻烦，所以我会尽快替你找到他们。";
		next;
		mes "[Vincent]";
		mes "你愿意为我做这些？^333333*抽泣*^000000即使我让你经历了这些？^333333*抽鼻子*^000000";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "呃，我已经经历了这么多麻烦，干脆把工作完成。而且 Phobe 只是个孩子，可能藏在城里的某处……";
		close;
	}
	else if (lost_boy == 9) {
		mes "[Vincent]";
		mes "你回来了！找到 Phobe 了吗？！他、他怎么样？没事吧？";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "嗯？哦，他很好。我在 Freya 喷泉附近找到 Phobe。呃，他还不愿回家，但把偷走的宝石给了我。";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "所以……我现在能得到奖励了，对吧？没人需要死了？";
		next;
		mes "[Vincent]";
		mes "是的，是的，太感谢了！我永远不会忘记你为我做的一切。哦，我的儿子没事！";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "喂、喂！呃，拿着这颗宝石！你得把它送回该去的地方，对吧？";
		next;
		mes "[Vincent]";
		mes "哦，是的，我最好这么做。我归还宝石时，你能告诉我妻子 Jenny 我们的儿子没事吗？她一直很担心，所以……";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "你要我告诉 Jenny 关于 Phobe 的事？好，好，我会的。";
		set lost_boy,10;
		changequest 8096,8097;
		close;
	}
	else if (lost_boy == 10) {
		mes "[Vincent]";
		mes "哦！我归还宝石时，你能告诉我妻子 Jenny 我们的儿子没事吗？她一直很担心，所以……";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "你要我告诉 Jenny 关于 Phobe 的事？好，好，我会的。";
		close;
	}
	else if (lost_boy == 11) {
		mes "["+strcharinfo(0)+"]";
		mes "我告诉 Jenny Phobe 的事，也说宝石已经归还……她似乎松了口气……";
		next;
		mes "[Vincent]";
		mes "太谢谢你了，冒险者。她是善良而充满爱心的女人，我不忍看她承受这些痛苦。我配不上这么美丽的女人……";
		next;
		mes "[Vincent]";
		mes "你来拯救我们真是幸运……下次来到 Rachel 时请再来，我会尽力帮助你。";
		next;
		mes "[Vincent]";
		mes "啊，其实我还有最后一个请求。请把这张纸条和包裹交给我的主人。他应该还";
		mes "现在应该在神殿里。";
		next;
		mes "[Vincent]";
		mes "如果你找高级神官 Zhed，并提到是我派你去的，他会见你。";
		next;
		mes "[Vincent]";
		mes "现在该给你奖励了。怎么样？我不知道里面是什么，但这些东西现在很值钱……";
		set lost_boy,12;
		changequest 8098,8099;
		getitem 617,1; //Old_Violet_Box
		next;
		mes "[Vincent]";
		mes "哦，这张纸条是我为你写的推荐信。请尽快交给 Zhed 爵士。再见，感谢你所做的一切。";
		next;
		mes "^3355FFYou received a letter";
		mes "来自 Vincent 的推荐信。^000000";
		close;
	}
	else {
		mes "[Vincent]";
		mes "谢谢你为我和家人所做的一切。需要帮助时，别犹豫，尽管来找我，好吗？";
		close;
	}
}

rachel,114,232,3	script	Logan#ra_in01	869,{
	if ((lost_boy < 1) || (lost_boy >= 3)) {
		mes "[Logan]";
		mes "我只是 Logan，是在 Zhed 爵士宏伟宅邸工作的众多仆人之一。我有很多工作要做，请别打扰我。";
		close;
	}
	else if (lost_boy == 1) {
		mes "["+strcharinfo(0)+"]";
		mes "打扰一下，你认识一个叫 Phobe 的人吗？我听说他以前在这里工作。";
		next;
		mes "[Logan]";
		mes "呃，我能问问你是谁吗？为什么找他？";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "我刚受雇寻找他，有人告诉我询问这里的仆人是很好的起点。";
		next;
		mes "[Logan]";
		mes "哦，好。是的，Phobe 几天前去市场买东西后就失踪了。希望那孩子没事。";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "呃，孩子？Phobe 多大？";
		next;
		mes "[Logan]";
		mes "他刚满十五岁。我只知道这些。说实话，我刚开始在这里工作，了解不多。你为什么不问问资深员工？";
		next;
		mes "[Logan]";
		mes "让我想想……你可以问宅邸里的 Manson 先生。他在这里工作了一段时间。";
		set lost_boy,2;
		changequest 8089,8090;
		close;
	}
	else if (lost_boy == 2) {

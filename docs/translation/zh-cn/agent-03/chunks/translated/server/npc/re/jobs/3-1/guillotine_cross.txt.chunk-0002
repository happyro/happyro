							close;
						}
						mes "[Daora]";
						mes "嗯，明白了。";
						next;
						mes "[Daora]";
						mes "有个看起来像祭司的人，Trovan 和 Madelle 见过他。";
						mes "有个商人见过一个经常购物的女孩。";
						next;
						mes "[Daora]";
						mes "主要目标是男人，";
						mes "但帮手是女孩。";
						mes "大概吧。";
						next;
						mes "[Daora]";
						mes "最重要的是，";
						mes "这件事真的让你很困扰。";
						next;
						mes "[Daora]";
						mes "那很简单。";
						mes "为什么不在她经常去的地方见她？";
						next;
						mes "[Daora]";
						mes "这是职责的无常。";
						mes "你还不知道这块拼图的意义。";
						next;
						mes "[Daora]";
						mes "他们可能有关，也可能无关。";
						mes "好，我会仔细留意目标。";
						next;
						mes "[Daora]";
						mes "对吧～？";
						mes "去能俯瞰村中水井的地方，找到 Melissa。";
						mes "这样会有帮助。";
						next;
						mes "- Daora's advice is attached on the board of quest. -";
						setquest 7092;
						close;
					case 2:
						mes "[Daora]";
						mes "嗯～。";
						mes "对了，执行任务时有个秘密，";
						mes "不能告诉任何人。";
						next;
						mes "[Daora]";
						mes "在这方面，你超出了标准。";
						close;
					}
				} else if (job_3rd_gc == 9) {
					if (checkquest(7093) == 1) {
						mes "去村子东边，你会看到一条向北的小巷。";
						next;
						mes "[Daora]";
						mes "Melissa 所说的死胡同就是这条街。";
						mes "你真像个孩子。";
						close;
					}
						mes "哈哈……进展如何？";
					next;
					switch(select("死胡同在哪里？:没关系。")) {
					case 1:
						mes "[Daora]";
						mes "死胡同？";
						mes "嗯……这样啊。";
						mes "像我们酒馆那样的死胡同吗……";
						next;
						mes "[Daora]";
						mes "啊，在村子东北边向上的小巷，";
						mes "那一带房屋挨得很近，";
						mes "所以没有街道。";
						next;
						mes "[Daora]";
						mes "Melissa 家附近，";
						mes "那里也许就是";
						mes "那个男孩所说的死胡同。";
						next;
						mes "[Daora]";
						mes "在村里走走就很容易找到。";
						setquest 7093;
						next;
						mes "- Daora's advice is attached on the board of quest. -";
						close;
					case 2:
						mes "[Daora]";
					mes "好，进展顺利。";
					mes "我可以期待好结果吗？";
						close;
					}
				} else if (job_3rd_gc == 13) {
					mes "我派一个叫 Estillda 的女孩回她家了。";
					mes "我们为什么要处理这种无聊的事？";
					next;
					if (checkquest(7094) == 1) {
						mes "[Daora]";
					mes "我不确定他是否还活着……";
					mes "总之，他是拉赫的钥匙工匠，";
					mes "能辨认各种钥匙。";
						next;
						mes "[Daora]";
					mes "什么？住址？";
					mes "我告诉过你，是拉赫。";
					mes "他也许在拉赫安享余生。";
						next;
						mes "[Daora]";
					mes "去拉赫的酒馆里问问……";
						close;
					}
					mes "[Daora]";
					mes "嗯，进展如何？";
					next;
				switch(select("进展顺利。:出示钥匙。")) {
					case 1:
						mes "[Daora]";
					mes "我的酒杯，你不需要吗？";
						next;
						mes "["+strcharinfo(0)+"]";
					mes "是的。我已经有足够情报。";
					mes "如果那东西背后有很长的故事，";
						mes "我们只有一条路。";
						next;
						mes "[Daora]";
						mes "没错。";
						mes "只要仔细思考，";
						mes "你就能找到办法。";
						next;
						mes "[Daora]";
						mes "祝你好运～";
						close;
					case 2:
						mes "[Daora]";
						mes "这是什么——";
						mes "我明白了，那个家伙有这把钥匙……？";
						next;
						mes "[Daora]";
						mes "这是神殿的象征，";
						mes "有着华丽的图案。";
						mes "嗯……";
						next;
						mes "[Daora]";
						mes "所以你想知道这把钥匙的用途？";
						mes "那就去拉赫。";
						mes "那里有钥匙工匠。";
						next;
						mes "[Daora]";
						mes "他现在退休了，";
						mes "安享晚年。";
						mes "你可以亲自问他。";
						next;
						mes "[Daora]";
						mes "问问这把钥匙有什么用途。";
						setquest 7094;
						next;
						mes "- Daora's advice is attached on the quest board. -";
						close;
					}
				} else if (job_3rd_gc == 15) {
					if (checkquest(7095) == 1) {
						mes "维因斯西北方的原野。";
						mes "看地图很容易找到。";
						mes "那里有很多狼，小心。";
						close;
					}
						mes "嘿，Mayshell 怎么样？";
						mes "你能纠正那种令人不舒服的说话方式吗？";
					next;
					mes "[Daora]";
						mes "别装成贵族小姐。";
					next;
				switch(select("我要走了。:你知道威因斯附近有座宅邸吗？")) {
					case 1:
						mes "[Daora]";
						mes "好。";
						mes "别被鲁莽的勇气冲昏头。";
						mes "嗯……想死也没那么容易。";
						close;
					case 2:
						mes "[Daora]";
						mes "当然。";
						mes "峡谷之间有座宅邸。";
						mes "那里非常阴森。";
						mes "我不明白他的品味。";
						next;
						mes "[Daora]";
						mes "那座宅邸建在峡谷后方……";
						mes "那里总是像夜晚一样黑。";
						next;
						mes "[Daora]";
						mes "位置？";
						mes "嗯……";
						mes "在维因斯西北方的原野。";
						mes "可以从狭窄道路向东北走。";
						setquest 7095;
						next;
						mes "- Daora's advice is attached on the board of quest. -";
						next;
						mes "[Daora]";
						mes "那里有很多可怕的狼，小心。";
						close;
					}
				} else {
					mes "不，这已经不好笑了。";
					close;
				}
			case 3:
				mes "[Daora]";
				mes "我们的牛奶很贵！";
				mes "一杯要 500 Zeny。";
				next;
				switch(select("没关系。给我一杯牛奶。:你真是个厚颜无耻的强盗！")) {
				case 1:
					mes "[Daora]";
					if (Zeny > 499) {
						mes "给你，牛奶。";
						mes "休息一下吧。";
						set Zeny, Zeny - 500;
						getitem 519,1; //Milk
						close;
					}
					mes "我说过了，要 500 Zeny。";
					mes "真可怜，你只有一副好身材！";
					close;
				case 2:
					mes "[Daora]";
				mes "无礼的家伙！";
					specialeffect2 EF_HIT1;
					percentheal -30,0;
					close;
				}
			}
		} else {
			mes "你完美地完成了任务。";
			mes "现在需要什么？";
			mes "还需要别的东西吗？";
			next;
			mes "[Daora]";
			mes "如果你决定了前进的道路，就该重新出发。";
			mes "大家都在等你。";
			close;
		}
	} else if (Class == Job_Guillotine_Cross || Class == Job_Guillotine_Cross_T || Class == Job_Baby_Guillotine_Cross) {
		if (Sex == SEX_MALE) {
			mes "哦～你真帅～！";
			mes "开酒馆真值得～";
			mes "每次看到你这样的男人，我都感到努力有了回报～";
		} else {
			mes "嗯……你看起来和我年轻时一样英俊。";
			mes "你想要什么？";
		}
		next;
		switch(select("热带苏格拉特:海滩上的朱红:牛奶")) {
		case 1:
			mes "[Daora]";
			if (Zeny > 799) {
				mes "给你，拿着。";
				set Zeny, Zeny - 800;
				getitem 12112,1; //Tropical_Sograt
				close;
			}
			mes "热带苏格拉特每杯 800 Zeny。";
			close;
		case 2:
			mes "[Daora]";
			if (Zeny > 799) {
				mes "给你，拿着。";
				set Zeny, Zeny - 800;
				getitem 12113,1; //Vermilion_The_Beach
				close;
			}
			mes "[Daora]";
			mes "海滩上的朱红每杯 800 Zeny。";
			close;
		case 3:
			mes "[Daora]";
			if (Sex == SEX_MALE) {
				mes "呃……嗯……";
				mes "这是很麻烦的订单，但既然你想要，我也没办法。";
				next;
				mes "[Daora]";
				if (Zeny > 499) {
					mes "虽然收每瓶 500 Zeny 很不好意思，但我必须这么做。";
					mes "在维因斯很难获得牛奶。";
					set Zeny, Zeny - 500;
					getitem 519,1; //Milk
					close;
				}
				mes "嗯……我恐怕帮不了你。";
				mes "维因斯没有牛奶。";
				close;
			} else {
				mes "啊，牛奶。";
				mes "呼！牛奶！";
				next;
				mes "[Daora]";
				mes "我没有那种东西。";
				close;
			}
		}
	} else {
		if (Sex == SEX_MALE) {
			mes "哦～你真帅！";
			mes "那么，你想要什么？";
		}
		else {
			mes "嗯……你是女孩。";
			mes "好吧，随便挑吧。";
		}
		next;
		mes "[Daora]";
		mes "不知道你是否已经知道，我们出售梦罗克特制酒。";
		mes "你想要哪一种？";
		next;
		switch(select("热带苏格拉特:海滩上的朱红:不用了，谢谢！")) {
		case 1:
			mes "[Daora]";
			if (Zeny > 999) {
				mes "给你，拿着。";
				set Zeny, Zeny - 1000;
				getitem 12112,1; //Tropical_Sograt
				close;
			}
			mes "热带苏格拉特每杯 1000 Zeny。";
			close;
		case 2:
			mes "[Daora]";
			if (Zeny > 999) {
				mes "给你，拿着。";
				set Zeny, Zeny - 1000;
				getitem 12113,1; //Vermilion_The_Beach
				close;
			}
			mes "海滩上的朱红每杯 1000 Zeny。";
			close;
		case 3:
			mes "[Daora]";
		mes "别让我看出你的紧张！";
			specialeffect2 EF_HIT1;
			percentheal -30,0;
			close;
		}
	}
}

job3_guil01,16,20,4	script	Mayshell#3rdgc03	894,{
	if (!checkweight(1201,2)) {
		mes "- You can't continue this quest because you have too many items. -";
		close;
	}
	mes "[Mayshell]";
	if (job_3rd_gc == 4) {
		mes "是 Ahcart 派你来的吗？";
		mes "我不再问问题，直接给你任务。";
		mes "好，仔细听。";
		next;
		mes "[Mayshell]";
		mes "我们正在追捕一个企图瓦解组织的人。";
		mes "我们得到情报，有个男人看起来像城镇首领。";
		next;
		mes "[Mayshell]";
		mes "你的任务是在阴影掩护下惩罚他。";
		next;
		mes "[Mayshell]";
		mes "我们的目标不能泄露给任何人。";
		mes "你的记忆应消失在阴影中。";
		mes "谨慎行动，避免被观察。";
		next;
		select("好吧……:所以任务是……？");
		mes "[Mayshell]";
		mes "他长什么样？";
		mes "你怎么认出他？";
		mes "我不能告诉你。";
		mes "你必须自己找出答案。";
		next;
		mes "[Mayshell]";
		mes "你需要指南针。";
		mes "需要灯和光才能看清黑暗。";
		next;
		mes "[Mayshell]";
		mes "到那时，你可以喝一杯休息。";
		next;
		mes "[Mayshell]";
		mes "克服逆境。";
		mes "由你来判断。";
		mes "我们无法帮助你，所以必须自己想办法。";
		next;
		mes "[Mayshell]";
		mes "我们在村里看到了一个陌生人，相信他就是你任务要找的人。";
		next;
		mes "[Mayshell]";
		mes strcharinfo(0)+".";
		mes "时间不会等你。";
		mes "前进吧，用象征苦行人生的刀刃洒下鲜血。";
		set job_3rd_gc, 5;
		changequest 7102,7103;
		close;
	} else if (job_3rd_gc == 5) {
		mes "你已经收到命令。";
		mes "虽然没有证据，我仍相信你会做好。";
		next;
		mes "[Mayshell]";
		mes "这是观察你的测试。";
		mes "让我看看，"+strcharinfo(0)+"……";
		mes "出去先想想该做什么。";
		next;
		mes "[Mayshell]";
		mes "你的任务是找到一个陌生人。";
		next;
		mes "[Mayshell]";
		mes "出去认真搜寻。";
		mes "我允许你喝点水。";
		next;
		mes "[Mayshell]";
		mes "开始前先见 Daora。";
		mes "她可能会帮助你。";
		close;
	} else if (job_3rd_gc == 14) {
		mes "欢迎。";
		mes "今天过得怎么样？";
		mes "我听说了你的行动。";
		next;
		mes "[Mayshell]";
		mes "你找到钥匙了，对吧？";
		mes "呵呵，我自有办法知道。";
		next;
		mes "[Mayshell]";
		mes "能把钥匙给我看看吗？";
		mes "我要确认";
		mes "你是否有能力……";
		next;
		select("把钥匙交给他。");
		mes "[Mayshell]";
		if (countitem(6150) == 0) {
			mes "你没带钥匙？";
			mes "我会遇到大麻烦。";
			close;
		}
		mes "没想到没有明确目标你也能成功……";
		mes "你的能力超出我的预想。";
		next;
		mes "[Mayshell]";
		mes "我想你找到了我们要找的目标。";
		mes "找到钥匙的主人后处理掉他。";
		next;
		mes "[Mayshell]";
		mes "这样就结束了。";
		mes "但你必须自己找到钥匙的主人。";
		next;
		mes "[Mayshell]";
		mes "找到宅邸时，会有人在那里等你。";
		next;
		mes "[Mayshell]";
		mes "这是最后一步。";
		mes "不要犯错。";
		delitem 6150,1; //Key_Of_The_Mansion
		set job_3rd_gc, 15;
		changequest 7108,7109;
		close;
	} else if (job_3rd_gc == 15) {
		mes "好，你有事要做吗？";
		mes "如果迟到，Renzak 可能会生气。";
		close;
	} else if (job_3rd_gc == 18 || job_3rd_gc == 19) {
		mes "我已经收到 Renzak 的报告。";
		if (job_3rd_gc == 18) {
			mes "你很快完成了任务。";
			mes "太棒了。";
		} else {
			mes "见到你我很高兴。";
			mes "但速度对我们非常重要。";
			next;
			mes "[Mayshell]";
			mes "你没有准时……";
			mes "至少你活着回来了。";
		}
		next;
		set .@all_wine,0;
		for(set .@i,0; .@i<5; set .@i,.@i+1)
			if (checkquest(7091+.@i) == 1) set .@all_wine, .@all_wine+1;
		mes "[Mayshell]";
		if (.@all_wine < 2) {
			mes "你独自完成了任务，";
			mes "即使没有任何情报，";
			mes "还收集到了信息。";
			next;
			mes "[Mayshell]";
			mes "你及时且耐心地满足了所有条件。";
			next;
			mes "[Mayshell]";
			if (job_3rd_gc == 18) {
				mes "你的任务评价是……[S]。";
				mes "[S] is for 'special'.";
				set .@quest,7099;
			} else {
				mes "你的任务评价是……[A]。";
				mes "如果准时完成，评价会更高。";
				set .@quest,7096;
			}
			next;

				mes "所以Tikbalang会让怀着恶意进入王国的旅人在原地兜圈，戏弄他们。";
				next;
				mes "[Tikbalang Expert]";
				mes "还有一个传闻：这里的人说‘晴天突然下雨，就是Tikbalang结婚的日子’。";
				next;
				mes "[Tikbalang Expert]";
				mes "协会推测‘Bathory结婚时下雨’或‘月夜花结婚时下雨’之类的说法，可能源自Tikbalang的传闻。";
				next;
				mes "[Tikbalang Expert]";
				mes "最后，古老童话说Tikbalang能变成人形，甚至让自己透明，但尚未有人证实。";
				break;
			case 5:
				mes "[Tikbalang Expert]";
				mes "Tikbalang通常住在阴暗、偏僻且人烟稀少的地方。";
				next;
				mes "[Tikbalang Expert]";
				mes "嗯……比如据说它们住在桥下、香蕉林、竹林和大树下。";
				next;
				mes "[Tikbalang Expert]";
				mes "这只是我的看法，但你不觉得它们住在阴暗处，是因为更容易捉弄人吗？";
				break;
			}
			next;
		}
	case 3:
		mes "[Tikbalang Expert]";
		mes "哈哈哈。现在知道我有多厉害了吧？";
		next;
		if (countitem(6496) >= 3 && countitem(6497) >= 5) {
			mes "[Tikbalang Expert]";
			mes "哦！这不是制作驯服Tikbalang用的‘Tikbalang腰带’的材料吗？";
			next;
			mes "[Tikbalang Expert]";
			mes "‘^F80835Tikbalang腰带^000000’能轻松捕捉Tikbalang。但不代表100%成功。感兴趣吗？要我给你做一条吗？";
			next;
			switch(select("是的，我感兴趣。:不，我自己能抓。")) {
			case 1:
				delitem 6496,3; //Tikbalang_Thick_Spine
				delitem 6497,5; //Lesser_Agimat
				getitem 12699,1; //Tikbalang_Belt
				mes "[Tikbalang Expert]";
				mes "咿——！！呀！";
				next;
				specialeffect EF_SONICBLOW2;
				select("咦？");
				mes "[Tikbalang Expert]";
				mes "‘^F80835Tikbalang腰带^000000’已经制作好了。";
				close;
			case 2:
				mes "[Tikbalang Expert]";
				mes "你？哈……想试就试吧。";
				close;
			}
		}
		mes "[Tikbalang Expert]";
		mes "捕捉Tikbalang有简单和困难两种方法。你喜欢哪种？";
		next;
		switch(select("简单方法。:困难方法。")) {
		case 1:
			mes "[Tikbalang Expert]";
			mes "哈哈。我自己想出了简单方法。";
			next;
			mes "[Tikbalang Expert]";
			mes "带来3根Tikbalang厚脊刺和5个小Agimat，我就能制作‘^F80835Tikbalang腰带^000000’，帮助你轻松捕捉Tikbalang。";
			next;
			mes "[Tikbalang Expert]";
			mes "哈哈哈哈哈！";
			mes "我再说一遍。";
			mes "就是3根Tikbalang厚脊刺和5个小Agimat。明白了吗？";
			close;
		case 2:
			mes "[Tikbalang Expert]";
			mes "对我来说很简单，但你就不一定了。";
			next;
			mes "[Tikbalang Expert]";
			mes "Tikbalang的脖子后面有一簇尖锐的鬃毛。";
			next;
			mes "[Tikbalang Expert]";
			mes "当然！鬃毛有好几根，但你必须取得最粗的三根。";
			next;
			mes "[Tikbalang Expert]";
			mes "这三根鬃毛是弱点。拔掉它们就能驯服Tikbalang。";
			next;
			mes "[Tikbalang Expert]";
			mes "现在让我说明如何拔掉鬃毛。";
			next;
			mes "[Tikbalang Expert]";
			mes "你必须像蝴蝶一样飞舞，像蜜蜂一样落在Tikbalang背上。";
			next;
			mes "[Tikbalang Expert]";
			mes "当然！Tikbalang会发怒，用尽全力把你甩下来。";
			next;
			mes "[Tikbalang Expert]";
			mes "你只要坚持到Tikbalang筋疲力尽。";
			next;
			mes "[Tikbalang Expert]";
			mes "不过，Tikbalang很强，可能要4天3夜才会累。我们就别纠结细节了。";
			next;
			mes "[Tikbalang Expert]";
			mes "也就是说！！Tikbalang已经被驯服了。";
			close;
		}
	}
}

// Upgrade Boss Equipment :: malaya_mvpitem
//============================================================
ma_fild01,158,243,6	script	Tribe Blacksmith#malaya	582,{
	disable_items;
	mes "[Bayani]";
	mes "如果你带来蕴含巨大力量的护甲，我会为你升级。";
	next;
	switch (select("要升级什么装备？:需要什么材料？:升级后会变成什么？:请升级这个。")) {
	case 1:
		mes "[Bayani]";
		mes "你的问题太简单了，不过！";
		next;
		mes "[Bayani]";
		mes "也很重要。";
		next;
		mes "[Bayani]";
		mes "^7B4772Bakonawa 鳞甲^000000，由传说会吞噬月亮的 Bakonawa 魔物鳞片制成。";
		next;
		mes "[Bayani]";
		mes "轻便坚固的^7B4772Kalasag^000000，由马来港周边的野生藤蔓制成。";
		next;
		mes "[Bayani]";
		mes "^7B4772Buwaya 麻布衣^000000，由食人鳄鱼 Buwaya 的皮囊制成。";
		next;
		mes "[Bayani]";
		mes "^7B4772Bangungot 梦魇之靴^000000，蕴含魔物 Bangungot 的憎恨与复仇。";
		next;
		mes "[Bayani]";
		mes "正如刚才所说。";
		next;
		mes "[Bayani]";
		mes "我只会用可怕怪物掉落的最强护甲，制作强大的装备。";
		close;
	case 2:
		mes "[Bayani]";
		mes "学得不错。";
		mes "看来你明白世上没有免费的午餐。";
		next;
		mes "[Bayani]";
		mes "首先要记住，升级对象本身必须足够坚固，至少能承受^FF0000+9精炼^000000。";
		next;
		mes "[Bayani]";
		mes "其次是真正的力量，只能来自自然获得的能量。精炼时我需要^FF000020个远古怨恨^000000来抵御邪恶。";
		next;
		mes "[Bayani]";
		mes "当^FF0000+9精炼强力护甲^000000与^FF000020个远古怨恨^000000结合！！";
		next;
		mes "[Bayani]";
		mes "旧碎片就会变成全新且改良的护甲。";
		next;
		mes "[Bayani]";
		mes "请一直期待这一刻。";
		close;
	case 3:
		mes "[Bayani]";
		mes "听好，这是非常重要的问题。";
		next;
		mes "[Bayani]";
		mes "就算我说100遍升级后的护甲很强，也没有意义。";
		next;
		mes "[Bayani]";
		mes "除非持有者不相信它！问问发生了什么变化，自己决定吧！";
		next;
		while (1) {
			switch (select("没有更多了。:Bakonawa鳞甲:Kalasag:Buwaya麻布衣:Bangungot梦魇之靴")) {
			case 1:
				mes "[Bayani]";
				mes "看来你没有问题了。";
				mes "别忘了。想得到什么，就必须放弃一些东西。";
				close;
			case 2:
				mes "[Bayani]";
				mes "Bakonawa鳞甲为所有职业的所有属性增加+1，是适合所有人的优秀护甲。";
				next;
				mes "[Bayani]";
				mes "但我相信你内心觉得这还不够。";
				next;
				mes "[Bayani]";
				mes "所以升级后所有属性可再增加+2，并为插槽增加一个卡片位置。";
				next;
				break;
			case 3:
				mes "[Bayani]";
				mes "Kalasag是优秀的盾牌，每精炼3次可使Boss怪物伤害降低1%。";
				next;
				mes "[Bayani]";
				mes "但还不够。真不敢相信盾牌竟然没有装备卡片的位置。";
				next;
				mes "[Bayani]";
				mes "所以升级后我可以为插槽增加一个卡片位置。";
				next;
				break;
			case 4:
				mes "[Bayani]";
				mes "Buwaya麻布衣每精炼3次可使治疗能力和治疗物品效果增加1%，还可使水、地、火、风属性怪物伤害降低10%。";
				next;
				mes "[Bayani]";
				mes "但还不够。真不敢相信这件衣服没有装备卡片的位置。大家都知道衣服应该装Raydric！";
				next;
				mes "[Bayani]";
				mes "别担心！升级后我可以为插槽增加一个卡片位置。";
				next;
				break;
			case 5:
				mes "[Bayani]";
				mes "Bangungot梦魇之靴每精炼1次增加+1 MDEF，精炼达到14以上后提升速度。";
				next;
				mes "[Bayani]";
				mes "月夜花之鞋和Sleipnir等鞋子的速度提升效果，普通人无法获得。";
				next;
				mes "[Bayani]";
				mes "当然，+14精炼并不容易，但有办法轻松获得。";
				next;
				mes "[Bayani]";
				mes "升级鞋子后，从+12精炼开始就能获得速度提升！";
				next;
				mes "[Bayani]";
				mes "而且还不止这些！！";
				mes "我还会为插槽增加一个卡片位置。";
				next;
				break;
			}
			mes "[Bayani]";
			mes "不过，想得到什么就必须放弃一些东西。";
			next;
			mes "[Bayani]";
		mes "^0000FF同时装备 Kalasag、Buwaya 麻布衣、Bakonawa 鳞甲和 Bangungot 梦魇之靴会失去^FF0000套装效果^0000FF。^000000";
			next;
			mes "[Bayani]";
			mes "好好想想。下一个问题？";
			next;
		}
	}
	mes "[Bayani]";
	mes "哈哈哈哈哈哈哈！很好！";
	mes "你带来材料了，对吧？";
	next;
	if (select("哦……抱歉……:准备完成！！") == 1) {
		mes "[Bayani]";
		mes "哦不！！";
		mes "我需要一件精炼+9以上的轻便坚固护甲和20个远古怨恨！！";
		close;
	}
	if (countitem(6499) < 20) {
		mes "[Bayani]";
		mes "你说准备都完成了，却给我这个？！精炼物品至少需要20个远古怨恨。";
		close;
	}
	mes "[Bayani]";
	mes "那么要升级哪件护甲？";
	next;
	switch (select("Bakonawa鳞甲:Kalasag:Buwaya麻布衣:Bangungot梦魇之靴")) {
	case 1:
		.@part    = EQI_ARMOR;
		.@item    = 15051;
		.@newItem = 15052;
		break;
	case 2:
		.@part    = EQI_HAND_L;
		.@item    = 2169;
		.@newItem = 2170;
		break;
	case 3:
		.@part    = EQI_GARMENT;
		.@item    = 2590;
		.@newItem = 2591;
		break;
	case 4:
		.@part    = EQI_SHOES;
		.@item    = 2491;
		.@newItem = 2492;
		break;
	}
	
	if (!getequipisequiped(.@part)) {
		mes "[Bayani]";
		mes "你应该穿戴要升级的装备，不要不带装备就来。";
		close;
	} else if (getequipid(.@part) != .@item) {
		mes "[Bayani]";
		mes "这是什么！你说要升级" + getitemname(.@item) + "，为什么给我这个？你应该穿戴" + getitemname(.@item) + ".";
		close;
	}
	.@equip_refine = getequiprefinerycnt(.@part);
	if (.@equip_refine < 9) {
		mes "[Bayani]";
		mes "不，这件物品的坚固性还没测试。至少要精炼到+9，我才能说‘这护甲够坚固’。";
		close;
	}

	mes "[Bayani]";
	mes "看来你做足了功课！没有发现缺陷！在开始精炼前，我有一个问题。";
	next;
	mes "[Bayani]";
	mes "^0000FFOnce your item is refined, the refinement level will be ^FF00000^0000FF and the item will be upgraded.^000000 You get this part?";
	next;
	if (select("不。:是。") == 1) {
		mes "[Bayani]";
		mes "什么？你不知道吗？那就读完我的说明后再回来。";
		close;
	}
	mes "[Bayani]";
	mes "很好。下一个问题。精炼完成后，";
	mes "^0000FFEquipping the Kalasag, Buwaya麻布衣, Bakonawa鳞甲, and Bangungot梦魇之靴 all at once will lose the ^FF0000Set Effects^0000FF.^000000";
	mes "你明白这一点吗？";
	next;
	if (select("不。:是。") == 1) {
		mes "[Bayani]";
		mes "什么？你不知道吗？那就读完我的说明后再回来。";
		close;
	}
	mes "[Bayani]";
	mes "太棒了！那么开始精炼" + getitemname(.@item) + ".";
	next;
	specialeffect EF_SONICBLOW;
	mes "[Bayani]";
	mes "砰！！哇！！翻……倒！";
	next;
	specialeffect2 EF_TRIPLEATTACK;
	mes "[Bayani]";
	mes "砰！！";
	next;
	delitem 6499,20; //Ancient_Grudge

	// anti-hack
	if (callfunc("F_IsEquipIDHack", .@part, .@item) || callfunc("F_IsEquipRefineHack", .@part, .@equip_refine))
		close;

	delequip .@part;
	getitem .@newItem, 1; 
	mes "[Bayani]";
	mes "哈哈。完美。";
	mes "恭喜你。你的护甲比以前更好了。";
	close;
}

// Secret in the Woods :: malaya_buwaya
//============================================================
malaya,305,281,3	script	Guard#buwaya	570,7,7,{
	if (malaya_hi < 10) {
		mes "- From the wary looks on the guard's face, it is obvious he is at alert at the sight of you. He won't intimidate you but seems he won't even deal with you either. -";
		next;
		mes "- Would there be anyone to talk to in the village? -";
		close;
	} else if (malaya_hi < 20) {
		mes "[Guard]";
		mes "Port Malaya外有一小片区域，名为^3131FFBaryo Mahiwaga^000000。";
		mes "那里比这里更接近大自然。";
		next;
		mes "[Guard]";
		mes "另一方面，那片区域充满凶猛怪物。前往时要保重。";
		close;
	}
	if (malaya_buwaya == 0) {
		mes "[Guard]";
		mes "最近有更多人偷偷离开村子。你也是要去森林寻找神秘宝藏吗？";
		next;
		if (BaseLevel < 100) {
			mes "[Guard]";
			mes "我收回刚才的话。仔细想想，我觉得你这样的弱者根本不敢去那里。";
			next;
			mes "[Guard]";
			mes "想离开Port Malaya的话，最好紧紧牵着妈妈的手，否则怪物会把你生吞。哈哈。";
			close;
		}
		mes "[Guard]";
		mes "所以最近这里外来者变多了吗？别偷偷摸摸装懂。就算我愿意带你逛逛，你又怎么知道？";
		next;
		if (select("宝藏？:忽略。") == 2) {
			mes "[Guard]";
			mes "你在无视我吗？呸。";
			close;
		}
		mes "[Guard]";
		mes "哦，所以你不是来找宝藏的？";
		next;
		mes "[Guard]";
		mes "我听说人们在谈论藏在森林深处的神秘宝藏。";
		set malaya_buwaya,1;
		setquest 2271;
		next;
	}
	if (malaya_buwaya == 1) {
		mes "[Guard]";
		mes "你看到那边那群人了吗？他们每天都会聚在那里谈论这件事。";
		mes "你也有兴趣的话，去和他们谈谈。";
		close;
	}
	mes "[Guard]";
	mes "所以宝藏传闻只是谣言？我不是想一夜暴富才问的。哈哈。";
	close;
OnTouch:
	if ((malaya_hi > 19) && (malaya_buwaya == 0)) {
		emotion ET_SURPRISE;
		emotion ET_SURPRISE, playerattached();
	}
	end;
}
malaya,276,288,5	script	Port Malaya Villager::buwaya_A	582,{
	if (malaya_hi < 20) {
		mes "- Look at you warily while whispering to each other. -";
		close;
	} else if (malaya_buwaya == 1) {
		emotion ET_SURPRISE, getnpcid(0, "buwaya_A");
		mes "[Port Malaya Villager]";
		mes "不，我听说他们在森林里迷路了。";
		mes "谁会把这样的宝藏藏起来，不让我们这种小村子知道？";
		next;
		emotion ET_PROFUSELY_SWEAT, getnpcid(0, "buwaya_B");
		mes "[Port Malaya Villager]";
		mes "会不会是怪物？我奶奶说森林深处住着一条大头龙。";
		next;
		emotion ET_STARE_ABOUT, getnpcid(0, "buwaya_C");
		mes "[Port Malaya Villager]";
		mes "不。 Listen to me.";
		next;
		mes "[Port Malaya Villager]";
		mes "你们都认识^3131FFTotoy^000000吧？就是住在^3131FF旅馆^000000的孩子。";
		mes "你知道Totoy最近从森林回来了吗？";
		next;
		emotion ET_HUK, getnpcid(0, "buwaya_A");
		emotion ET_HUK, getnpcid(0, "buwaya_B");
		mes "[Port Malaya Villager]";
		mes "真的吗？？？他活着回来了？";
		next;
		emotion ET_SURPRISE, getnpcid(0, "buwaya_C");
		mes "[Port Malaya Villager]";
		mes "是的。但奇怪的是，那个捣蛋鬼^3131FFTotoy^000000现在安静地待在家里，再也不出门。";
		next;
		emotion ET_QUESTION, getnpcid(0, "buwaya_B");
		mes "[Port Malaya Villager]";
		mes "为什么？";
		next;
		emotion ET_SURPRISE, getnpcid(0, "buwaya_C");
		mes "[Port Malaya Villager]";
		mes "你还不明白吗？Totoy一定找到了宝藏。";
		next;
		emotion ET_HUK, getnpcid(0, "buwaya_A");
		emotion ET_HUK, getnpcid(0, "buwaya_B");
		mes "[Port Malaya Villager]";
		mes "什么！！！！那^3131FFTotoy^000000现在发财了？";
		next;
		emotion ET_STARE_ABOUT, getnpcid(0, "buwaya_C");
		mes "[Port Malaya Villager]";
		mes "我觉得不是。";
		mes "我看到^3131FFTotoy^000000回家，但Totoy什么都没带。";
		mes "不过我马上跑回家了，所以一定错过了什么。";
		next;
		emotion ET_QUESTION, getnpcid(0, "buwaya_B");
		mes "[Port Malaya Villager]";
		mes "那么^3131FFTotoy^000000在家里做什么？";
		next;
		emotion ET_THINK, getnpcid(0, "buwaya_C");
		mes "[Port Malaya Villager]";
		mes "我觉得Totoy正计划瞒着我们把宝藏带回来。";
		mes "那个贪心的孩子想独占所有宝藏。";
		next;
		emotion ET_QUESTION, getnpcid(0, "buwaya_A");
		mes "[Port Malaya Villager]";
		mes "真的吗？";
		next;
		emotion ET_BIGTHROB, getnpcid(0, "buwaya_B");
		mes "[Port Malaya Villager]";
		mes "宝藏交给我会更安全~";
		mes "我会每天清洁它让它闪亮，把它当作漂亮的装饰品。啊~~~";
		next;
		emotion ET_THINK, getnpcid(0, "buwaya_C");
		mes "[Port Malaya Villager]";
		mes "那么我们去和^3131FFTotoy^000000谈谈，让他透露宝藏在哪里？";
		next;
		emotion ET_QUESTION, getnpcid(0, "buwaya_A");
		mes "[Port Malaya Villager]";
		mes "哇。这主意太棒了。不愧是首领！";
		next;
		emotion ET_THINK, getnpcid(0, "buwaya_A");
		mes "[Port Malaya Villager]";

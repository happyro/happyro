ma_fild01,180,273,0	duplicate(Black Bamboo#malaya)	Black Bamboo#malaya04	844,4,4
ma_fild01,179,145,0	duplicate(Black Bamboo#malaya)	Black Bamboo#malaya05	844,4,4

malaya,295,171,3	script	Collection Dealer Woeon	582,{
	if (MaxWeight - Weight < 1000 || checkweight(1201,1) == 0) {
	mes "- 无法继续任务。你携带了太多物品。-";
		close;
	}
	if (malaya_hi < 10) {
		mes "[Woeon]";
		mes "呃……呃……我头疼……";
		mes "我的头疼一定是你从城外带来的！";
		mes "走开。快走！";
		close;
	} else if (malaya_hi == 10) {
		if (checkquest(7355) == 2) {
			mes "[Woeon]";
			mes "好了，朋友，听着……";
			mes "给我一枚纽扣就能解决这一切。";
			mes "看起来也不贵。";
			close;
		} else {
			mes "[Woeon]";
			mes "啊哈！你就是大家都在谈论的人！";
			mes "我刚才有点粗鲁，对吧？别放在心上！";
			mes "对，忘了吧……";
			next;
			mes "[Woeon]";
			mes "如果你真的需要，我可以在这里给你找份工作……";
		mes "……你能给我一些物品吗？";
			next;
			mes "[Woeon]";
			mes "我听说了你驱赶鬼魂的传闻！";
			mes "你没看到我的手因为害怕鬼而发抖吗？";
			mes "如果你能给我一枚袖口上的纽扣，我会好受很多……";
			next;
		mes "- 因为你驱赶了鬼魂，烦恼的村民想要你的物品。-";
			setquest 7355;
			completequest 7355;
			if ((checkquest(7352) + checkquest(7353) + checkquest(7354) + checkquest(7355) + checkquest(7356) + checkquest(7357)) > 9) {
				next;
			mes "- 已经有很多人向你提出这个请求。也许去和 Mumbaki 的 Phong 谈谈会更好。-";
				set malaya_hi, 11;
				setquest 7358;
			}
			close;
		}
	} else if (malaya_hi == 11) {
		mes "[Woeon]";
		mes "唉……最近生活真艰难。";
		mes "鬼为什么要来烦我。";
		mes "真希望我有护身符之类的东西……";
		next;
		mes "[Woeon]";
		mes "为什么不给我一件你的物品，让我当护身符？";
		mes "拜托，一只袜子也能救人一命，你知道的。";
		mes "你这个冷血的……";
		close;
	} else if (malaya_hi == 12) {
		if (checkquest(7362) != -1) {
			mes "[Woeon]";
			mes "嗯。看看我的手。";
			mes "没那么抖了，对吧？";
			mes "不是吗？";
			close;
		}
		if (!countitem(523) || !countitem(717)) {
			mes "^4d4dffPrepare and give Blue Gemstone and Holy Water. ^000000";
			close;
		}
		mes "[Woeon]";
		mes "哼！你想要什么？";
		next;
		select ("Give the prepared items.");
		mes "[Woeon]";
		mes "哦，天啊……忘了刚才的事吧。";
		mes "你看，你离开后我又被另一只鬼缠上了……";
		mes "别往心里去……";
		next;
		mes "[Woeon]";
		mes "这是你灵力的来源吗？";
		mes "感觉有点酷！";
		mes "也许它能驱赶一些鬼……";
		next;
		mes "[Woeon]";
		mes "总之，非常感谢。";
		mes "有工作空缺时我会先叫你。";
		next;
		mes "- 把圣水和蓝宝石交给了 Woeon。-";
		delitem 717, 1; //Blue_Gemstone
		delitem 523, 1; //Holy_Water
		setquest 7362;
		completequest 7362;
		if ((checkquest(7359) + checkquest(7360) + checkquest(7361) + checkquest(7362) + checkquest(7363) + checkquest(7364)) > 11) {
		mes "- Woeon 是最后一位，我想圣物已经交付完毕。-";
			set malaya_hi, 13;
			erasequest 7351;
			setquest 7365;
		}
		close;
	} else if (malaya_hi == 13) {
		mes "[Woeon]";
		mes "现在……回到正题。";
		mes "多亏了你，我看不到那些该死的鬼了。";
		mes "哈哈哈哈哈";
		close;
	} else {
		mes "[Woeon]";
		mes "哦，你好！";
		next;
		if (select("给予精神保护。:收集商及其收藏") == 1) {
			if (((checkquest(7374) == 0) || (checkquest(7374) == 1)) && ((checkquest(7371) == 0) || (checkquest(7371) == 1))) {
				if (!countitem(6503)) {
					mes "^4d4dff没有可以交给 Woeon 的精神保护。^000000";
					close;
				}
				mes "[Woeon]";
				mes "呼~新的精神保护？";
				mes "这是正式制作的护身符吗？Imelda的手艺很不错。";
				mes "当然，我也很感谢你。";
				next;
				mes "-Delivered Spiritual Protection to Woeon.-";
				delitem 6503, 1; // Soul_Protection
				erasequest 7371;
				setquest 7385;
				if ((checkquest(7382) + checkquest(7383) + checkquest(7384) + checkquest(7385) + checkquest(7386) + checkquest(7387)) > 5) {
				mes "- Woeon 是最后一位，所有精神保护都已交付。-";
					if (malaya_hi == 23) {
						set malaya_hi, 24;
					}
					setquest 7379;
					erasequest 7382;
					erasequest 7383;
					erasequest 7384;
					erasequest 7385;
					erasequest 7386;
					erasequest 7387;
				}
				close;
			} else {
				mes "[Woeon]";
				mes "精神保护？";
				mes "我的还很好用。";
				mes "确实非常有效。";
				close;
			}
		} else {
			if (BaseLevel < 100) {
				mes "[Woeon]";
				mes "是的，我收集各种怪物副产物。";
				mes "事实上，我正在这里收集Jejellopy……";
				next;
				mes "[Woeon]";
				mes "这对你来说太难了。";
				mes "你看，这附近的情况可能很糟。";
				mes "等你变强后再来做，朋友！";
				close;
			}
			if ((checkquest(7392, PLAYTIME) == 0) || (checkquest(7392, PLAYTIME) == 1)) {
				mes "[Woeon]";
				mes "哦，要收集Jejellopy？";
				mes "我今天已经够了。";
				mes "明天再来。";
				close;
			} else if (checkquest(7392, PLAYTIME) == 2) {
				mes "[Woeon]";
				mes "哦，对，对。";
				mes "你今天也要收集Jejellopy吗？";
				mes "我知道这工作很难……但你做得很好。";
				erasequest 7392;
				next;
				if (select("我今天太忙了。:交给我！") == 1) {
					mes "[Woeon]";
					mes "是这样吗？那就这样吧。";
					mes "需要工作时来找我。";
					close;
				}
				mes "[Woeon]";
				mes "和往常一样，请带30个Jejellopy。";
				mes "可以从Jejeling那里获得。";
				setquest 7391;
				close;
			} else {
				if ((checkquest(7391) == 0) || (checkquest(7391) == 1)) {
					if (countitem(6498) < 30) {
						mes "[Woeon]";
						mes "嗯？我觉得你不够。";
						mes "我要求30个Jejellopy。生意就是生意，抱歉。";
						close;
					}
					mes "[Woeon]";
					mes "哦，你有要求的数量？";
					mes "接下来交给我。";
					mes "你不需要它们，对吧？";
					next;
					mes "[Woeon]";
					mes "所以我收齐Jejellopy了……";
					mes "再来！";
					delitem 6498, countitem(6498); //Jejellopy
					setquest 7392;
					erasequest 7391;
					if (!VIP_SCRIPT || vip_status(VIP_STATUS_ACTIVE))
						getitem 6497, 2; // Lesser_Agimat
					else
						getitem 6497, 1; // Lesser_Agimat
					getexp 200000,200000;
					set .@memo_name, rand(1,3);
					if (!rand(3))
						$malayaNames$[1] = strcharinfo(0);
					close;
				} else {
					mes "[Woeon]";
					mes "如你所见，我是收集商。";
					mes "我交易各种怪物或动物副产物。";
					next;
					mes "[Woeon]";
					mes "它们被用作制造商品的材料。";
					mes "当然，Port Malaya最需要的是怪物Jejeling的产物。";
					next;
					mes "[Woeon]";
					mes "Jejellopy可以从Jejeling获得。";
					mes "你能给我30个Jejellopy吗？";
					next;
					if (select("好，当然。:不。") == 2) {
						mes "[Woeon]";
						mes "是这样吗。真遗憾。";
						mes "需要工作时再来。";
						close;
					}
					mes "[Woeon]";
					mes "很好，我相信你能做到。";
					mes "记住，30个Jejellopy。";
					setquest 7391;
					close;
				}
			}
		}
	}
	end;
}

malaya,119,217,3	script	Blacksmith Pandoi	538,{
	if (MaxWeight - Weight < 1000 || checkweight(1201,1) == 0) {
	mes "- 无法继续任务。你携带了太多物品。-";
		close;
	}
	if (malaya_hi < 10) {
		mes "[Pandoi]";
		mes "...Gasp!";
		mes "走……走开！";
		close;
	} else if (malaya_hi == 10) {
		if (checkquest(7354) == 2) {
			mes "[Pandoi]";
			mes "拜托……";
			mes "你就帮帮我吧，就当行行好？";
			mes "你真觉得无视我就是最佳选择吗？！";
			next;
			mes "[Pandoi]";
			mes "听着。";
			mes "请让我看一眼……";
			mes "只是一枚纽扣……";
			close;
		} else {
			mes "[Pandoi]";
			mes "你好！";
			mes "我听说过你的威望。";
			mes "我想要一件东西证明我亲自见过你……";
			next;
			mes "[Pandoi]";
			mes "哦……你是不是因为我突然对你这么好而感到惊讶。";
			mes "我听说了你击退鬼魂的消息。";
			mes "太棒了！";
			next;
			mes "[Pandoi]";
			mes "有了你灵力中的物品，就能吓跑鬼魂，对吧？";
			mes "拜托，请慷慨一点，我求你了……";
			next;
	mes "- 因为你驱赶了鬼魂，烦恼的村民想要你的物品。-";
			setquest 7354;
			completequest 7354;
			if ((checkquest(7352) + checkquest(7353) + checkquest(7354) + checkquest(7355) + checkquest(7356) + checkquest(7357)) > 9) {
				next;
			mes "- 已经有很多人向你提出这个请求。也许去和 Mumbaki 的 Phong 谈谈会更好。-";
				set malaya_hi, 11;
				setquest 7358;
			}
			close;
		}
	} else if (malaya_hi == 11) {
		mes "[Pandoi]";
		mes "呼……最近生活真艰难。";
		mes "鬼为什么要来烦我。";
		mes "真希望我有护身符之类的东西……";
		next;
		mes "[Pandoi]";
		mes "拜托…….";
		mes "你就帮帮我吧，就当行行好？";
		mes "你真觉得无视我就是最佳选择吗？！";
		close;
	} else if (malaya_hi == 12) {
		if (checkquest(7361) != -1) {
			mes "[Pandoi]";
			mes "现在我有信心了，接下来只需冲进医院或野外寻找材料！";
			mes "但……但是，我太害怕了……";
			close;
		}
		if (!countitem(523) || !countitem(717)) {
			mes "^4d4dffPrepare and give Blue Gemstone and Holy Water. ^000000";
			close;
		}
		mes "[Pandoi]";
		mes "什、什么，你终于决定帮我了？！";
		mes "你要给Pandoi一份和平的礼物？！";
		next;
		select ("Give the prepared items.");
		mes "[Pandoi]";
		mes "太好了！我就知道你会回来！";
		mes "是的……现在我有了你灵力的一部分，晚上可以睡个好觉了。";
		next;
	mes "- 把圣水和蓝宝石交给了 Pandoi。-";
		delitem 717, 1; //Blue_Gemstone
		delitem 523, 1; //Holy_Water
		setquest 7361;
		completequest 7361;
		if ((checkquest(7359) + checkquest(7360) + checkquest(7361) + checkquest(7362) + checkquest(7363) + checkquest(7364)) > 11) {
			mes "-With Pandoi as last, I think I've given enough Holy Artifacts.-";
			set malaya_hi, 13;
			erasequest 7351;
			setquest 7365;
		}
		close;
	} else if (malaya_hi == 13) {
		mes "[Pandoi]";
		mes "银……银。我需要银，请帮帮我。";
		mes "我以为鬼魂消失后就能得到银，但我做不到……";
		close;
	} else {
		mes "[Pandoi]";
		switch(rand(1, 6)) {
		case 1:
			mes "你知道的，" + $malayaNames$[1] + ". 你变强后就是我的英雄。我很仰慕你！";
			break;
		case 2:
			mes "我见过你，" + $malayaNames$[1] + "在城外击败那些Jejeling。那股活力……我……我太佩服了！";
			break;
		case 3:
			mes "你，" + $malayaNames$[0] + "，点亮了我的灵魂。它正在闪耀，你知道吗？不？你不知道？";
			break;
		case 4:
			mes "据我所见，最近" + $malayaNames$[1] + "是附近最勤奋的人。他简直是勤劳之神。";
			break;
		case 5:
			mes $malayaNames$[5] + "有了重大发现。据说是一条龙。";
			break;
		case 6:
			mes "你好？！";
			break;
		}
		next;
		switch (select("给予精神保护。:银刃。:银十字架")) {
		case 1:
			if ((checkquest(7374) == -1) || (checkquest(7370) == -1)) {
				mes "[Pandoi]";
				mes "谢谢你留意我的精神保护有效期。";
				mes "我想我的暂时还有效。";
				mes "失效后我会再请你提供一个！";
				close;
			}
			if (!countitem(6503)) {
			mes "^4d4dff没有可以交给 Pandoi 的精神保护。^000000";
				close;
			}
			mes "[Pandoi]";
			mes "很好。新的精神保护。";
			mes "知道你不会再看到那些黑东西，总是令人欣慰！";
			next;
			mes "-Delivered Spiritual Protection to Pandoi.-";
			delitem 6503, 1; // Soul_Protection
			erasequest 7370;
			setquest 7384;
			if ((checkquest(7382) + checkquest(7383) + checkquest(7384) + checkquest(7385) + checkquest(7386) + checkquest(7387)) > 5) {
		mes "- Pandoi 是最后一位，所有精神保护都已交付。-";
				if (malaya_hi == 23) {
					set malaya_hi, 24;
				}
				setquest 7379;
				erasequest 7382;
				erasequest 7383;
				erasequest 7384;
				erasequest 7385;
				erasequest 7386;
				erasequest 7387;
			}
			close;
		case 2:
			if (BaseLevel < 100) {
				mes "[Pandoi]";
				mes "嗯……制作银刃需要银。";
				mes "我可以熔化银手镯来获得银。";
				mes "银手镯可以在医院获得。";
				next;
				mes "[Pandoi]";
				mes "不过我觉得你现在做不到。抱歉，这对你来说太难了！";
				mes "你那样进去的话……绝对活着出不来！";
				close;
			}
			.@hunting = checkquest(7393, HUNTING);
			if (.@hunting == 2) {
				if (countitem(6508) < 10) {
					mes "[Pandoi]";
					mes "银手镯在哪里？";
					mes "我知道你很强大……";
					mes "但我必须有银手镯才能制作银刃。";
					next;
					mes "[Pandoi]";
					mes "10 Silver Bracelets!";
					mes "不管你能挡住多少，我需要10个银手镯！！";
					mes "现在交给你了！";
					close;
				}
				mes "[Pandoi]";
				mes "我由衷敬佩！";
				mes "你击退了它们，还带回了银手镯。";
				next;
				mes "[Pandoi]";
				mes "从今天起，我会尝试熔炼新的银制武器……！！";
				mes "我会不断锤打，直到手中留下精美的银刃……！！";
				next;
				mes "[Pandoi]";
				mes "这不算什么，但这是你费尽辛苦取得银手镯的报酬。";
				mes "如果失败……我会再次请你帮忙！";
				delitem 6508, 10; //Silver_Bracelet
				setquest 7394;
				erasequest 7393;
				if (!VIP_SCRIPT || vip_status(VIP_STATUS_ACTIVE))
					getitem 6497, 2; // Lesser_Agimat
				else
					getitem 6497, 1; // Lesser_Agimat
				getexp 200000,200000;
				if (!rand(3))
					$malayaNames$[1] = strcharinfo(0);
				close;
			} else if (.@hunting == 0 || .@hunting == 1) {
				mes "[Pandoi]";
				mes "村里的医院里藏着最可怕的东西。";
				mes "我也不知道具体是什么……不管是什么，我都不想靠近……";
				next;
				mes "[Pandoi]";
				mes "请消灭传闻中的怪物，并拿回那些银手镯。";
				mes "我只能相信你！";
				close;
			} else {
				.@playtime = checkquest(7394, PLAYTIME);
				if (.@playtime == 0 || .@playtime == 1) {
					mes "[Pandoi]";
					mes "我还有一些银要熔炼。";
					mes "如果再次失败，我会再请求帮助。";
					close;
				} else if (.@playtime == 2) {
					erasequest 7394;
					mes "[Pandoi]";
					mes "哦……我该怎么办？";
					mes "我浪费了你带回来的珍贵材料……";
					next;
					mes "[Pandoi]";
					mes "也许我不适合当铁匠！";
					mes "不过我很擅长制作银器！";
					next;
					if (select("我会给你弄材料。振作起来。:放弃吧。这样轻松多了。") == 2) {

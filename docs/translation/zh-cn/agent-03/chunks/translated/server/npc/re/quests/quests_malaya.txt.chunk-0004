		mes "这里有一棵矮黑竹子。";
		close;
	}
	if (countitem(6500) >= 6) {
		mes "有足够的锋利竹子……";
		close;
	}
	mes "这里有黑色竹竿和叶子的竹子。";
	mes "砍下一些并削尖，应该足够制作Imelda要的锋利竹子。";
	close2;
	progressbar "0xffff00", 3;
	disablenpc();
	initnpctimer;
	getitem 6500, 1; //Sharp_Bamboo
	mes "[" + strcharinfo(0) + "]";
	mes "我就知道我能做到！";
	close;
OnTouch_:
	if ((checkquest(7366) != -1) || (checkquest(7380) != -1)) {
		specialeffect EF_LEVEL99_4;
	}
	end;
OnTimer30000:
	enablenpc();
	stopnpctimer;
	end;
}
ma_fild01,225,186,0	duplicate(Black Bamboo#malaya)	Black Bamboo#malaya01	844,4,4

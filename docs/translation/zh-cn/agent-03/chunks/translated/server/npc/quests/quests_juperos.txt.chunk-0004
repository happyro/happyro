		mes "一件物品，先计划好";
		mes "想升级到多高，以及";
		mes "事先要花多少钱。";
		mes "但像所有女士一样，幸运女神";
		mes "会在你尽情挥霍时微笑。^000000";
		mes " ";
		mes " ";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "等等，等等……";
		mes "这东西确实很老。";
		mes "我的意思是，它显然";
		mes "是从父权制的角度";
		mes "写成的，宣扬";
		mes "两党式的性别角色。";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "我……";
		mes "我太受冒犯了。";
		close;
	case 2:
		mes "["+strcharinfo(0)+"]";
		mes "这卷轴太";
		mes "原始了。现在已经有";
		mes "各种技术性的";
		mes "阅读进步，我无法";
		mes "离开它们……比如页面。";
		close;
	}
}

yuno_in04,118,116,4	script	Paper	111,{
	mes "^3355FF这是一张";
	mes "看起来像私人信件的";
	mes "纸。^000000";
	next;
	switch(select("阅读。:不去碰它。")) {
	case 1:
		if (yuno_hist > 7) {
			mes "^8B6914附言：";
			mes "请……";
			mes "回到我身边。";
			mes " ";
			mes " ";		  
			mes "爱你的，";
			mes "Fayruz^000000";
			close;
		}
		mes "^8B6914……";
		mes "我忘不了你的笑容。";
		mes "无论如何，即使你";
		mes "恨我，我也会永远怀有这些";
		mes "只对你的感情。你是";
		mes "最特别的人，";
		mes "也是我心中最重要的人。^000000";
		next;
		mes "^8B6914我知道我们曾有过";
		mes "分歧，但请";
		mes "不要拒绝我的爱。请用";
		mes "你的双手，原谅";
		mes "我们之间的一切。";
		mes "- 爱你的，法伊鲁兹^000000";
		next;
		if (getpartnerid()) {
			mes "["+strcharinfo(0)+"]";
			mes "啊啊啊啊~";
			mes "爱情真美好！";
			close;
		}
		mes "["+strcharinfo(0)+"]";
		mes "什么——？！";
		mes "呜呜呜呜呜！";
		mes "爱情糟透了！";
		close;
	case 2:
		mes "["+strcharinfo(0)+"]";
		mes "我想我最好";
		mes "别看这个。";
		mes "我的意思是，我可能会";
		mes "后悔读它。";
		close;
	}
}


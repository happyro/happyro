jupe_area1,88,224,0	script	#hole#1-1	844,{
	cutin "1",2;
	if ($@JupreArea1InUse == 1) {
		mes "^3355FF这似乎是";
		mes "某种装置，";
		mes "可以让你";
		mes "通往另一边。";
		mes "这里有一个插槽，";
		mes "你可能需要插入";
		mes "某种物品……^000000";
		close2;
		cutin "1",255;
		end;
	}
	else if (countitem(7356) > 0 || countitem(7359) > 0 || countitem(7357) > 0 || countitem(7358) > 0) {
		mes "^3355FF这似乎是";
		mes "某种装置，";
		mes "可以让你";
		mes "通往另一边。";
		mes "这里有一个插槽，";
		mes "你可能需要插入";
		mes "某种物品……^000000";
		next;
		switch(select("插入徽章碎片。:取消。")) {
		case 1:
			if (countitem(7356) > 0) {
				mes "^3355FF你取出";
				mes "徽章碎片并将它";
				mes "放入插槽，";
				mes "它恰好完美契合。^000000";
				specialeffect EF_TOPRANK;
				cutin "1-1",2;
				next;
				if ($@JupreArea1InUse == 1) {
					mes "^3355FF什么也没发生。";
					mes "也许警报或";
					mes "其他安全措施";
					mes "被启动了，以防止";
					mes "徽章碎片激活";
					mes "这个传送装置。";
					mes "你取回徽章碎片。^000000";
					close2;
					cutin "1-1",255;
					end;
				}
				else {
					mes "^3355FF插槽旋转，";
					mes "徽章碎片随之移动，";
					mes "仿佛钥匙正在转动。你";
					mes "感到轻微震动，";
					mes "通往另一边的传送门";
					mes "被激活。然后你取回";
					mes "你的徽章碎片。^000000";
					initnpctimer;
					donpcevent "Warp#1-1::OnEnable";
					enablenpc "Red Alarm#1-1";
					disablenpc "#hole#1-1";
					close2;
					cutin "1-1",255;
					end;
				}
			}
			else {
				mes "^3355FF遗憾的是，你";
				mes "没有携带任何";
				mes "可能适合";
				mes "插槽并激活";
				mes "这个机械装置的物品。^000000";
				close2;
				cutin "1",255;
				end;
			}
		case 2:
			mes "[" + strcharinfo(0) + "]";
			mes "嗯……";
			mes "我有什么";
			mes "能让这台";
			mes "奇怪机器运转的东西吗？";
			close2;
			cutin "1",255;
			end;
		}
		close;
	}
	else {
		mes "^3355FF这似乎是";
		mes "某种装置，";
		mes "可以让你";
		mes "通往另一边。";
		mes "这里有一个插槽，";
		mes "你可能需要插入";
		mes "某种物品……^000000";
		close2;
		cutin "1",255;
		end;
	}

OnStop_Timer:
	stopnpctimer;
	end;

OnTimer22500:
	stopnpctimer;
	enablenpc "#hole#1-1";
	disablenpc "Red Alarm#1-1";
	end;
}

jupe_area1,83,221,0	script	Warp#1-1	139,2,2,{
OnInit:
	disablenpc "Warp#1-1";

	end;

OnTimer5000:
	mapannounce "jupe_area1","但我想你们已经准备好应对一些障碍……",bc_map,"0xFF0000";
	donpcevent "Monster1#1-1::OnEnable";
	end;

OnTimer7000:
	mapannounce "jupe_area1","毕竟，你们正在穿越禁区！",bc_map,"0xFF0000";

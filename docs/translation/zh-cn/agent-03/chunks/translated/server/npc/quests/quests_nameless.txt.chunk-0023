prontera,163,204,3	script	Man from Morocc	99,{
	if (rumour_nd == 0) {
		mes "[Morocc Traveler]";
		mes "啊，靠近喷泉真舒服清爽。这里比梦罗克凉快多了。";
		next;
		switch(select("今天真是好天气，对吧？:最近梦罗克怎么样？")) {
		case 1:
			mes "[Morocc Traveler]";
			mes "哦，是的，今天真棒！普隆德拉阳光明媚又凉爽，难怪这么多人住在这里！";
			close;
		case 2:
			mes "[Morocc Traveler]";
			mes "你是冒险者，没听说卢恩-米德加尔特王国到处流传的疯狂传闻吗？我以为你们四处旅行，消息灵通。";
			next;
		}
		select("什么疯狂传闻？");
		mes "[Morocc Traveler]";
		mes "呃……盗贼探员！他们到处都是！去和派驻其他城镇的盗贼探员谈谈，你就知道我说什么了！";
		set rumour_nd,1;
		close;
	}
	else if (rumour_nd == 1) {
		mes "[Morocc Traveler]";
		mes "你不该去找盗贼探员谈谈吗？我的意思是，也许你能出份力帮助他们。";
		close;
	}
	else if (rumour_nd > 1) {
		if (zdan_edq > 12) {
			mes "[Morocc Traveler]";
			mes "原来那些疯狂传闻都是关于 Z Gang。得知他们都进了监狱真好。";
			close;
		}
		else {
			mes "[Morocc Traveler]";
		mes "嘿，呃……我只是在假期放松。";
			close;
		}
	}
}

in_rogue,355,28,5	script	Rogue Agent	118,{
	if (checkweight(907,200) == 0) {

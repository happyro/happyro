			mes "愤怒什么也带不来，它的力量只是幻觉。";
			close;
		}
		else {
			mes "[Retired Soldier]";
			mes "你知道吗？如果这么担心诅咒，为什么不把宝石交给我？别担心，我会补偿你。";
			next;
			mes "[Retired Soldier]";
			mes "我宁愿自己保管，也不想冒险让它影响其他人。我知道自己的意志足够坚强，能抵抗诅咒——如果它真的存在。";
			close;
		}
	}
	else if (jewel_nd == 31) {
		mes "[Retired Soldier]";
		mes "好了，你已经了解了不祥翡翠的一切。是时候忘掉诅咒之类的事，寻找新的冒险。啊，要是能再次年轻……";
		close;
	}
	else {
		mes "[Retired Soldier]";
		mes "啊，我多么怀念过去。退休生活真是……太无聊了！我想该找个爱好了。";
		close;
	}
}

gef_fild08,182,185,0	script	The Wanderer	739,{
	if (jewel_nd < 21) {
		mes "[The Wanderer]";

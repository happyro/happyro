//===== rAthena Script =======================================
//= Eden Group Quests - Mission [131-140]
//===== By: ==================================================
//= Capuche
//===== Current Version: =====================================
//= 1.2
//===== Compatible With: =====================================
//= rAthena Project
//===== Description: =========================================
//= [Official Conversion]
//= Repeatable quests for players between BaseLevel 131 - 140.
//===== Additional Comments: =================================
//= 1.0 First version.
//= 1.1 Added support to Para_Team_Mark_ in Eden Group. [Ragno]
//= 1.2 Added use of F_HasEdenGroupMark function. [Ragno]
//============================================================

moc_para01,41,76,3	script	Ragi#1	4_M_RAGI,{
	cutin "ragi01",0;
	mes "[Ragi]";
	if (!callfunc("F_HasEdenGroupMark")) {
		mes "这里只欢迎伊甸园的冒险者。";
		mes "我只向基础等级^FF0000130-140^000000的冒险者发布委托。";
	}
	else if (para_130lv01 == 0) {
		mes "你好。我是蒲公英乐队的新成员拉吉。我正在替艾古创作歌曲。你对故事感兴趣吗？";
		next;
		mes "[Ragi]";
		mes "哈哈。抱歉，我还是新人就来拜托冒险者。";
		next;
		mes "[Ragi]";
		mes "先看看清单吧。如果可以，你能帮我吗？";
		para_130lv01 = 1;
	}
	else {
		mes "我正在替艾古收集创作歌曲的故事。";
		next;
		if (select( "委托我收集故事", "聊天" ) == 1) {
			mes "[Ragi]";
			if (BaseLevel < 131) {
				cutin "ragi02",0;
				mes "这是艾古的委托，但很危险。你还需要继续成长。";
			}
			else if (BaseLevel < 141) {
				mes "这首歌和故事与怪物有关。^FF0000请告诉我与它们战斗时的感受。^000000";
				next;
				switch( select( "迷失者的故事", "恶魔的故事", "遥远之地的故事" ) ) {
					mes "[Ragi]";
				case 1:
					mes "利希塔乐岑有许多悲伤而迷失的故事。它们不该被遗忘，请把你知道的告诉我。";
					next;
					switch( select( "伊格尼珍·赛妮亚（剑士怪物）",
									"阿玛尔·迪恩兹（商人怪物）",
									"维克贝恩·特雷斯（盗贼怪物）",
									"卡瓦克·艾卡鲁斯（弓箭手怪物）",
									"艾伦德·艾比西（服事怪物）",
									"劳雷尔·温德尔（魔法师怪物）" ) ) {
						mes "[Ragi]";
					case 1:
						if (checkquest(13144,PLAYTIME) == 0)
							mes "一些冒险者会告诉我零碎故事，但还不足以写成歌曲。";
						else if (checkquest(13143,HUNTING) == 1) {
							cutin "̱״Ͼī",3;  //ygnizem_card
							mes "她是遥远之地的悲伤剑士。你觉得是什么把她带到那里？";
							next;
							mes "[Ragi]";
							mes "这些故事对某些人很重要。我想用它们写歌。请帮助我。";
							cutin "ragi01",0;
						}
						else if (checkquest(13143,HUNTING) == 2) {
							mes "你听到新的故事了吗？旅途中有故事就告诉我。";
							callsub S_Quest,13143,13144,1100000,300000;
						}
						else {
							cutin "̱״Ͼī",3;  //ygnizem_card
							mes "比任何剑士都强的女剑士。她叫伊格尼珍·赛妮亚。我不确定那是不是她本人。";
							next;
							mes "[Ragi]";
							mes "我不能让她的故事消失。真希望你能去看看。";
							next;
							cutin "ragi01",0;
							if (select( "Take the request", "Quit." ) == 1) {
								mes "[Ragi]";
								mes "会比你想象的更危险。但故事必须传达给所有人。";
								callsub S_Quest,13144,13143;
							}
						}
						break;
					case 2:
						if (checkquest(13146,PLAYTIME) == 0)
							mes "一些冒险者会告诉我零碎故事，但还不足以写成歌曲。";
						else if (checkquest(13145,HUNTING) == 1) {
							cutin "Ƹ̾ī",3;  //armaia_card
							mes "她的旅途能走多远？我想她无法独自完成。";
							next;
							mes "[Ragi]";
							mes "你不好奇那段旅程为何会停下吗？";
							next;
							mes "[Ragi]";
							mes "我想用这些故事写歌。请帮助我。";
							cutin "ragi01",0;
						}
						else if (checkquest(13145,HUNTING) == 2) {
							mes "你听到新的故事了吗？旅途中有故事就告诉我。";
							callsub S_Quest,13145,13146,1100000,300000;
						}
						else {
							cutin "Ƹ̾ī",3;  //armaia_card
							mes "商人的女儿阿玛尔·迪恩兹，看起来像有钱人，却显得不安。";
							next;
							mes "[Ragi]";
							mes "是什么让她消失？又是为了什么？请听听她的故事。";
							next;
							cutin "ragi01",0;
							if (select( "Take the request", "Quit." ) == 1) {
								mes "[Ragi]";
								mes "会比你想象的更危险。但故事必须传达。";
								callsub S_Quest,13146,13145;
							}
						}
						break;
					case 3:
						if (checkquest(13148,PLAYTIME) == 0)
							mes "一些冒险者会告诉我零碎故事，但还不足以写成歌曲。";
						else if (checkquest(13147,HUNTING) == 1) {
							cutin "ɹƮī",3;  //whikebain_card
							mes "是什么改变了她的想法？她曾只在乎金钱。";
							next;
							mes "[Ragi]";
							mes "我想知道她的内心走了多远？请听听她的故事，告诉我。";
							next;
							mes "[Ragi]";
							mes "请为我们写一首歌。";
							cutin "ragi01",0;
						}
						else if (checkquest(13147,HUNTING) == 2) {
							mes "你听到新的故事了吗？旅途中有故事就告诉我。";
							callsub S_Quest,13147,13148,1100000,300000;
						}
						else {
							cutin "ɹƮī",3;  //whikebain_card
							mes "没人知道它如何开始。维克贝恩·特雷斯或许找到了真正的伙伴。";
							next;
							mes "[Ragi]";
							mes "她曾只在乎金钱。她的旅程延续了多远？请在利希塔乐岑听听她的故事。";
							next;
							cutin "ragi01",0;
							if (select( "Take the request", "Quit." ) == 1) {
								mes "[Ragi]";
								mes "会比你想象的更危险。但故事必须传达。";
								emotion ET_BEST;
								callsub S_Quest,13148,13147;
							}
						}
						break;
					case 4:
						if (checkquest(13150,PLAYTIME) == 0)
							mes "一些冒险者会告诉我零碎故事，但还不足以写成歌曲。";
						else if (checkquest(13149,HUNTING) == 1) {
							cutin "īũī罺ī",3;  //kavac_card
							mes "是的。我似乎在斐扬听过同一个名字，但不确定是否是同一人。";
							next;
							mes "[Ragi]";
							mes "请在利希塔乐岑寻找他或一把弓。";
							next;
							mes "[Ragi]";
							mes "请别忘了告诉我听到的任何故事。";
							cutin "ragi01",0;
						}
						else if (checkquest(13149,HUNTING) == 2) {
							mes "你听到新的故事了吗？旅途中有故事就告诉我。";
							callsub S_Quest,13149,13150,1100000,300000;
						}
						else {
							cutin "īũī罺ī",3;  //kavac_card
							mes "卡瓦克·艾卡鲁斯的双手快过眼睛，能迅速射出箭矢。";
							next;
							mes "[Ragi]";
							mes "听说他的影子和箭矢正在某处游荡。请去利希塔乐岑告诉我他的故事。";
							next;
							cutin "ragi01",0;
							if (select( "Take the request", "Quit." ) == 1) {
								mes "[Ragi]";
								mes "小心他的箭。在故事结束前，你可能已经倒在冰冷地面上。";
								callsub S_Quest,13150,13149;
							}
						}
						break;
					case 5:
						if (checkquest(13152,PLAYTIME) == 0)
							mes "一些冒险者会告诉我零碎故事，但还不足以写成歌曲。";
						else if (checkquest(13151,HUNTING) == 1) {
							cutin "̷忡ī",3;  //erend_card
							mes "无论是为了友谊还是任务，只要旅程是为了某个人，就不容易停下。";
							next;
							mes "[Ragi]";
							mes "是什么让他们的旅程停下？其中有什么故事？";
							next;
							mes "[Ragi]";
							mes "请在利希塔乐岑调查那个故事。";
							cutin "ragi01",0;
						}
						else if (checkquest(13151,HUNTING) == 2) {
							mes "你听到新的故事了吗？旅途中有故事就告诉我。";
							callsub S_Quest,13151,13152,1100000,300000;
						}
						else {
							cutin "̷忡ī",3;  //erend_card
							mes "艾伦德·艾比西踏上了寻找某人的旅程。";
							next;
							mes "[Ragi]";
							mes "但我想……他的旅程也许在利希塔乐岑某处停下了。请听听他的故事。";
							next;
							cutin "ragi01",0;
							if (select( "Take the request", "Quit." ) == 1) {
								mes "[Ragi]";
								mes "请小心，不要像这些^FF0000可怜的灵魂^000000一样迷失。";
								callsub S_Quest,13152,13151;
							}
						}
						break;
					case 6:
						if (checkquest(13154,PLAYTIME) == 0)
							mes "一些冒险者会告诉我零碎故事，但还不足以写成歌曲。";
						else if (checkquest(13153,HUNTING) == 1) {
							cutin "췼ī",3;  //rawrel_card
							mes "顺便说，我读过一本叫^FF0000《如何成为魔法师》^000000的书……";
							next;
							mes "[Ragi]";
							mes "根据那本书，25 岁的人施展的魔法可能比年长魔法师更强。";
							next;
							mes "[Ragi]";
							mes "你认真听了吗？让我们完成劳雷尔·温德尔故事的委托！";
							cutin "ragi01",0;
						}
						else if (checkquest(13153,HUNTING) == 2) {
							mes "你听到新的故事了吗？旅途中有故事就告诉我。";
							callsub S_Quest,13153,13154,1100000,300000;
						}
						else {
							cutin "췼ī",3;  //rawrel_card
							mes "劳雷尔·温德尔决定踏上艰难旅程，报答某位魔法师的恩情。";
							next;
							mes "[Ragi]";
							mes "但是……这些有才华的魔法师没能回来？是谁造成的？去利希塔乐岑寻找线索。";
							next;
							cutin "ragi01",0;
							if (select( "Take the request", "Quit." ) == 1) {
								mes "[Ragi]";
								mes "我喜欢这个故事，但如果不想自己成为故事的一部分，就要小心。";
								callsub S_Quest,13154,13153;
							}
						}
					}
					break;
				case 2:
					mes "你知道撒旦·摩洛克的故事吗？即使时光流逝，我也想唱一首关于他的歌。";
					next;
					switch( select( "Angel Incarnation", "Black Nightmare Incarnation", "Ghost Incarnation" ) ) {
						mes "[Ragi]";
					case 1:
						if (checkquest(13156,PLAYTIME) == 0) {
							mes "来自摩洛克的怪物长着天使般的翅膀。也许撒旦·摩洛克想成为天使？";
							next;
							mes "[Ragi]";
							mes "哈哈别在意。只是讲故事人的玩笑。下次再给我另一个故事吧。";
						}
						else if (checkquest(13155,HUNTING) == 1) {
							mes "外表看起来没问题，但里面……我确定是血肉之躯！";
							next;
							mes "[Ragi]";
							mes "当然不是我亲自确认的。但如你所见，我只是个讲故事的人。";
							next;
							mes "[Ragi]";
							mes "但这里并不安全……所以要小心！请再给我更多故事！也许我能在附近遇到撒旦·摩洛克？";
						}
						else if (checkquest(13155,HUNTING) == 2) {
							mes "哇。你带来了这么多故事！谢谢你！";
							callsub S_Quest,13155,13156,1100000,200000;
						}
						else {
							mes "嗯……这首歌不是关于黑暗王子，而是来自声称见过他的人的故事。";
							next;
							mes "[Ragi]";
							mes "请帮我寻找飞行的摩洛克化身，创作一个故事。";
							next;
							if (select( "Take the request", "Quit." ) == 1) {
								mes "[Ragi]";
								mes "务必收集至少 30 只天使外形的摩洛克化身。";
								emotion ET_KEK;
								callsub S_Quest,13156,13155;
							}
						}
						break;
					case 2:
						if (checkquest(13158,PLAYTIME) == 0) {
							mes "故事还没写好，所以下次再问！";
							cutin "ragi02",0;
						}
						else if (checkquest(13157,HUNTING) == 1) {
							mes "形态还不完整，但有非常锋利的牙齿。";
							next;
							mes "[Ragi]";
							mes "你不觉得这会是个有趣的故事吗？";
						}
						else if (checkquest(13157,HUNTING) == 2) {
							mes "哇。你带来了这么多故事！谢谢你！";
							callsub S_Quest,13157,13158,1100000,200000;
						}
						else {
							mes "不知道这些是否都来自撒旦·摩洛克本身，但这种东西看起来很可怕。";
							next;
							mes "[Ragi]";
							mes "但我想其中也有故事。这就是这些生物存在的原因。请寻找黑色、像焦油一样的东西。";
							next;
							if (select( "Take the request", "Quit." ) == 1) {
								mes "[Ragi]";
								mes "找到并消灭 30 只黑暗摩洛克化身。";
								callsub S_Quest,13158,13157;
							}
						}
						break;
					case 3:
						if (checkquest(13160,PLAYTIME) == 0)
							mes "那个没有衣服的生物形状很奇怪。哈哈，别当真，我只是个讲故事的人。";
						else if (checkquest(13159,HUNTING) == 1) {
							mes "这个故事应该传播给像我一样弱小的冒险者！毕竟不是所有人都能成为冒险者。";
							next;
							mes "[Ragi]";
							mes "也许冒险者有必要了解这种故事。所以能请你在摩洛克附近寻找这些生物吗？";
						}
						else if (checkquest(13159,HUNTING) == 2) {
							mes "哇。你带来了这么多故事！谢谢你！";
							callsub S_Quest,13159,13160,1100000,200000;
						}
						else {
							mes "这个很奇怪……但他也是摩洛克化身。";
							next;
							mes "[Ragi]";
							mes "我很好奇，因为它看起来像幽灵，攻击似乎不起作用。";
							next;
							if (select( "Take the request", "Quit." ) == 1) {
								mes "[Ragi]";
								mes "至少猎杀 30 只幽灵摩洛克化身后，写出一个故事！";
								callsub S_Quest,13160,13159;
							}
						}
					}
					break;
				case 3:
					mes "我从没去过灰色沙漠，但听说斯卡拉巴大厅里有很多有趣的生物。";
					next;
					switch( select( "Uni-Horn Scaraba Story", "Horn Scaraba Story", "Antler Scaraba Story", "Rake Horn Scaraba Story" ) ) {
						mes "[Ragi]";
					case 1:
						if (checkquest(13162,PLAYTIME) == 0)
							mes "我正在写独角斯卡拉巴的故事。一只角比两只少！~我已经开始了，但很难完成。你能帮我吗？";
						else if (checkquest(13161,HUNTING) == 1) {
							cutin "īī",3;  //scaraba_card
							mes "它们也有故事，对吧？首先，我很好奇那只独角生物的形态。";
							next;
							cutin "ragi01",0;
						}
						else if (checkquest(13161,HUNTING) == 2) {
							mes "我想知道独角斯卡拉巴怎么想？我想写首歌。谢谢你的帮助！";
							callsub S_Quest,13161,13162,1100000,200000;
						}
						else {
							cutin "īī",3;  //scaraba_card
							mes "新世界充满惊人的怪物，会成为想当冒险者的孩子们的梦想。";
							next;
							mes "[Ragi]";
							mes "我想写一首关于^FF0000独角斯卡拉巴^000000的歌！？孩子们一定会喜欢。";
							next;
							cutin "ragi01",0;
							if (select( "Take the request", "Quit." ) == 1) {
								mes "[Ragi]";
								mes "你可以在斯卡拉巴大厅东边附近找到它们。";
								callsub S_Quest,13162,13161;
							}
						}
						break;
					case 2:
						if (checkquest(13164,PLAYTIME) == 0)
							mes "我正在编故事……二比三少~我开始写故事却无法完成。你能帮我吗？";
						else if (checkquest(13163,HUNTING) == 1) {
							cutin "īī",3;  //scaraba_card
							mes "那个角让我有点在意。一只角和两只角有什么区别？只是外表吗？";
							next;
							mes "[Ragi]";
							mes "也许没必要。但好奇心对讲故事的人很重要。哈哈哈。";
							cutin "ragi01",0;
						}
						else if (checkquest(13163,HUNTING) == 2) {
							mes "你平安回来了！怎么样？独角斯卡拉巴似乎是个有趣的故事。你做得很好。";
							callsub S_Quest,13163,13164,1100000,200000;
						}
						else {
							cutin "īī",3;  //scaraba_card
							mes "我们要谈独角斯卡拉巴吗？还有一个必须提到……就是独角斯卡拉巴！";
							next;
							mes "[Ragi]";
							mes "我不知道为什么，只是听别人说的。我需要写歌，所以请去看看它们的世界！";
							next;
							cutin "ragi01",0;
							if (select( "Take the request", "Quit." ) == 1) {
								mes "[Ragi]";
								mes "你可以在斯卡拉巴大厅东边附近找到它们。";
								callsub S_Quest,13164,13163;
							}
						}
						break;
					case 3:
						if (checkquest(13166,PLAYTIME) == 0)
							mes "关于鹿角斯卡拉巴似乎还有更多故事！有空请帮帮我。";
						else if (checkquest(13165,HUNTING) == 1) {
							cutin "īī",3;  //scaraba_card
							mes "传闻还有更特殊的斯卡拉巴，更强也更可怕。";
							next;
							mes "[Ragi]";
							mes "你觉得鹿角斯卡拉巴可能就是其中之一吗？";
							cutin "ragi01",0;
						}
						else if (checkquest(13165,HUNTING) == 2) {
							mes "长途旅行一定很累！如果还有有趣的故事请告诉我！";
							callsub S_Quest,13165,13166,1100000,200000;
						}
						else {
							cutin "īī",3;  //scaraba_card
							mes "这个很独特！角看起来像鹿角，所以叫鹿角斯卡拉巴。";
							next;
							mes "[Ragi]";
							mes "你不好奇它为什么有那种角吗？我觉得这是大家会喜欢的有趣故事。冒险者，能帮我吗？";
							next;
							cutin "ragi01",0;
							if (select( "Take the request", "Quit." ) == 1) {
								mes "[Ragi]";
								mes "能请你找找鹿角斯卡拉巴的故事吗？亲身经历最好！";
								callsub S_Quest,13166,13165;
							}
						}
						break;
					case 4:
						if (checkquest(13168,PLAYTIME) == 0)
							mes "我觉得镰角斯卡拉巴还有更多故事。有空请帮我。";
						else if (checkquest(13167,HUNTING) == 1) {
							cutin "īī",3;  //scaraba_card
							mes "我的计划是给每种斯卡拉巴写 4 段。";
							next;
							mes "[Ragi]";
							mes "无论听歌还是唱歌都会变成混乱的歌。听起来很有趣，对吧？";
							cutin "ragi01",0;
						}
						else if (checkquest(13167,HUNTING) == 2) {
							mes "谢谢！我一定能写出好歌。";
							callsub S_Quest,13167,13168,1100000,200000;
						}
						else {
							cutin "īī",3;  //scaraba_card
							mes "我开始糊涂了。我要把镰角斯卡拉巴的故事写成歌。";
							next;
							mes "[Ragi]";
							mes "歌曲从独角斯卡拉巴开始，再和镰角斯卡拉巴合唱。你能帮我吗？";
							next;
							cutin "ragi01",0;
							if (select( "Take the request", "Quit." ) == 1) {
								mes "[Ragi]";
								mes "请从斯卡拉巴大厅寻找镰角斯卡拉巴的故事。战斗或亲身经历都可以。";
								callsub S_Quest,13168,13167;
							}
						}
						break;
					}
				}
			}
			else {
				mes "我会继续编故事或写歌。但冒险者应该踏上新的冒险。";
				next;
				callsub S_Erasequest,
					13143,1,"Egnigem Cenia",
					13145,1,"Armeyer Dinze",
					13147,1,"Wickebine Tres",
					13149,1,"Kavach Icarus",
					13151,1,"Errende Ebecee",
					13153,1,"Laurell Weinder",
					13155,2,"the Angel-looking Incarnation of Morocc",
					13157,2,"Dark Incarnation of Morocc",
					13159,2,"Ghost Incarnation of Morocc",
					13161,3,"Uni-Horn Scaraba",
					13163,3,"Horn Scaraba",
					13165,3,"Antler Scaraba",
					13167,3,"Rake Horn Scaraba";
				mes "[Ragi]";
				mes "希望下次还能微笑着再见。";
			}
		}
		else {
			mes "[Ragi]";
			mes "我正忙着替艾古先生跑腿。你有什么问题吗？";
			next;

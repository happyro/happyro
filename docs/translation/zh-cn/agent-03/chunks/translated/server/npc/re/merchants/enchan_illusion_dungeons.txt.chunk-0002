//= Illusion of Luanda
//============================================================

// Exchange npc
com_d02_i,234,266,6	script	Village Soap#Lu	4_M_ORIENT01,{
	mes "[Village Soap]";
	mes "我也为努力帮助村子的冒险者挽起袖子。要强化你的装备吗？列表里有想要的吗？";
	next;
	if (select( "查看幻影装备", "取消" ) == 2) {
		mes "[Village Soap]";
		mes "晚些时候再来。带来材料，我就为你制作。";
		close;
	}
	mes "[Village Soap]";
	mes "是谁制作的？带在身上可能对你有用。";
	close2;
	callshop( "barter_ill_luanda" );
	end;
}


//============================================================
//= Illusion of Underwater
//============================================================

iz_d04_i,134,228,4	script	Horen#Horen	4_M_BIBI,{
	if (checkweight(1201,3) == 0) {
		mes "你携带的物品太多，无法继续对话。";
		mes "请整理背包后再试。";
		close;
	}
	mes "[Horen]";
	mes "你好。如果你有这里的稀有材料，我可以强化装备。";
	next;
	mes "[Horen]";
	mes "要看看可升级的装备吗？";
	next;
	if (select( "是", "否" ) == 2) {
		mes "[Horen]";
		mes "感兴趣的话再回来。";
		close;
	}
	mes "[Horen]";
	mes "种类很多，慢慢看。想要什么我可以马上强化。";
	close2;
	callshop( "barter_ill_underwater" );
	end;
}


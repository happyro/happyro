		close3;
	}
	if (ep17_2_main == 14) {
		cutin "ep172_alpha",2;
		mes "[Mansion Manager ��]";
		mes "" + strcharinfo(0) + ", welcome back. Have you looked around the mansion? Also, did you delivered the message to the automatic dolls near the broken repeater's area?";
		next;

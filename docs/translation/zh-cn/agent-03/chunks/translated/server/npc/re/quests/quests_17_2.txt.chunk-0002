ba_maison,74,150,3	script	Mansion Manager ��#172nw01	4_EP17_MASTER_A,{
	if (checkweight(1000103,15) == 0) {
		mes "你持有的物品数量太多，无法继续对话。";
		mes "请整理背包后再试。";
		close;
	}
	if (ep17_2_main < 8) {
		cutin "ep172_alpha",2;
		mes "[Mansion Manager ��]";
		mes "如果你是宅邸的访客，请先完成访客登记。请理解，我们不对被误认为入侵者而造成的任何意外负责。";
		close3;
	}
	if (ep17_2_main == 8) {
		cutin "ep172_alpha",2;
		mes "[Mansion Manager ��]";
		mes "欢迎。很高兴见到你。我还担心你在宅邸里迷路了。";
		next;
		mes "[Mansion Manager ��]";
		mes "我们已经为你签发访客许可证。它不同于瓦尔蒙特的正式邀请，这张卡只是临时证件。";
		next;
		mes "[Mansion Manager ��]";
		mes "由于你没有像其他入侵者那样破坏或盗窃财产，因此我们为调查向你发放了临时许可证。";
		next;
		mes "[Mansion Manager ��]";
		mes "这是为了防止你在调查前探索宅邸时发生不愉快事件而采取的措施。";
		next;
		mes "[Mansion Manager ��]";
		mes "请理解，在确认目的、方式和身份后，我们才会允许你调查宅邸。";
		next;
		mes "[Mansion Manager ��]";
		mes "首先，请告诉我你的名字。";
		next;
		cutin "",255;
		select( "我是" + strcharinfo(0) + "." );
		cutin "ep172_alpha",2;
		mes "[Mansion Manager ��]";
		mes "" + strcharinfo(0) + ". What is the purpose of your visit to the mansion?";
		next;
		cutin "",255;
		select( "我是……" );
		cutin "ep172_alpha",2;
		mes "[Mansion Manager ��]";
		mes ".....";
		mes "请稍等……";
		npctalk "目的是……为了……", "", bc_self;
		next;
		mes ".....";
		next;
		mes ".....";
		mes ".............";
		next;
		mes ".....";
		mes ".............";
		mes "...................";
		next;
		mes "[Mansion Manager ��]";
		mes "...Do you happen to have a party with you?";
		next;
		cutin "",255;
		select( "我和反叛军及一些政府官员一起来的。" );
		mes ".....";
		next;
		mes ".....";
		mes ".............";
		next;
		mes ".....";
		mes ".............";
		mes "...................";
		next;
		cutin "ep172_alpha",2;
		mes "[Mansion Manager ��]";
		mes "请原谅。" + strcharinfo(0) + ", 我马上为你签发正式访客许可证。";
		next;
		cutin "",255;
		select( "什么？突然吗？" );
		cutin "ep172_alpha",2;
		mes "[Mansion Manager ��]";
		mes "我确认了从其他地方一同来到宅邸的其他队员的身份和来访目的后完成了登记。";
		next;
		mes "[Mansion Manager ��]";
		mes "你的^0000CD队伍^000000已自动获得正式身份，因为他们属于前几天来过这座宅邸的^0000CD同一队伍^000000。";
		next;
		mes "[Mansion Manager ��]";
		mes "此外，他们还说明你是来^0000CD抓捕入侵者^000000的，那些入侵者正在宅邸内制造骚乱。";
		next;
		mes "[Mansion Manager ��]";
		mes "因此，我们也会为你的队伍签发宅邸正式访客许可证，" + strcharinfo(0);
		next;
		mes "[Mansion Manager ��]";
		mes "请稍等。";
		next;
		cutin "",255;
		progressbar_npc "00FF00",2;
		specialeffect EF_VALLENTINE;
		cutin "ep172_alpha",2;
		mes "[Mansion Manager ��]";
		mes "" + strcharinfo(0) + "。欢迎来到瓦尔蒙特的宅邸。很高兴见到你。我是这座宅邸的管家。";
		next;
		mes "[Mansion Manager ��]";
		mes "从现在起，" + strcharinfo(0) + ", 作为贵宾，你可以自由使用宅邸内的设施。如有问题，请随时联系最近的自动人偶。";
		next;
		mes "[Mansion Manager ��]";
		mes "另外，如果你需要清理帮助或入侵者的信息，我们会全力配合。";
		mes "为此，我们已向公众开放宅邸外部区域。";
		next;
		cutin "",255;
		select( "谢谢你。" );
		cutin "ep172_alpha",2;
		mes "[Mansion Manager ��]";
		mes "我会把新登记访客名单分享给" + strcharinfo(0) + "给其他自动人偶。";
		next;
		progressbar_npc "00FF00",2;
		mes "[Mansion Manager ��]";
		mes "" + strcharinfo(0) + ", all of the automatic dolls in the mansion are... dear... oh...";
		next;
		mes ".....";
		next;
		mes ".....";
		mes ".............";
		next;
		mes ".....";
		mes ".............";
		mes "...................";
		next;
		cutin "ep172_alpha",2;
		mes "[Mansion Manager ��]";
		mes "我是sorry, please wait a moment.";
		ep17_2_main = 9;
		setquest 17333;
		close3;
	}
	if (ep17_2_main == 9) {
		cutin "ep172_alpha",2;
		mes "[Mansion Manager ��]";
		mes "又……出问题了……";
		next;
		cutin "",255;
		select( "出问题了吗？" );
		cutin "ep172_alpha",2;
		mes "[Mansion Manager ��]";
		mes "某些区域的^0000CD中继器^000000出了问题，信号无法发送或接收。";
		next;
		close2;
		select( "中继器？" );
		cutin "ep172_alpha",2;
		mes "[Mansion Manager ��]";
		mes "宅邸里的所有自动人偶都连接到了无线网络。";
		mes "我们利用这个网络瞬间向宅邸里的所有自动人偶共享信息。";
		next;
		mes "[Mansion Manager ��]";
		mes "访客登记和日程共享等事情都需要它。";
		next;
		mes "[Mansion Manager ��]";
		mes "如果你想把信息传到宅邸各处，就使用中继器将信息转发给所有自动人偶。";
		next;
		mes "[Mansion Manager ��]";
		mes "我已经发送了更新后的访客名单，但还没有收到一些自动人偶的确认。";
		next;
		mes "[Mansion Manager ��]";
		mes "信号无法发送区域的中继器发生了故障。";
		next;
		close2;
		select( "它经常故障吗？" );
		cutin "ep172_alpha",2;
		mes "[Mansion Manager ��]";
		mes "由于我们精心维护，故障并不常见。";
		mes "然而，前几天^0000CD入侵者^000000进入宅邸时，他们拆解并破坏了宅邸设施。";
		next;
		mes "[Mansion Manager ��]";
		mes "一些自动人偶被入侵者摧毁了。";
		next;
		mes "[Mansion Manager ��]";
		mes "我得检查哪个区域的中继器没有正常工作。";
		next;
		mes "[Mansion Manager ��]";
		mes "抱歉，你能再等一会儿吗？我得检查问题区域，并手动转发更新后的访客名单。";
		next;
		cutin "",255;
		progressbar_npc "00FF00",2;
		npctalk "住宿区……收到信号...", "", bc_self;
		sleep2 2000;
		npctalk "实验室……收到信号...", "", bc_self;
		sleep2 2000;
		npctalk "礼堂……收到信号...", "", bc_self;
		sleep2 2000;
		npctalk "餐厅……信号失败...", "", bc_self;
		sleep2 2000;
		npctalk "警卫岗哨……收到信号...", "", bc_self;
		sleep2 2000;
		npctalk "凉亭……信号失败...", "", bc_self;
		sleep2 2000;
		npctalk "仓库……收到信号...", "", bc_self;
		sleep2 2000;
		npctalk "花园……信号失败...", "", bc_self;
		cutin "ep172_alpha",2;
		mes "[Mansion Manager ��]";
		mes "20个中继器中只有3个没有响应。很高兴数量不多。我们会前往信号无法通过的地方，手动传递更新后的访客名单，也要检查中继器。";
		next;
		cutin "",255;
		sleep2 700;
		cloakoffnpcself( "Tommy#172nw01" );
		cloakoffnpcself( "Meimei#172nw01" );
		mes "[Tommy]";
		mes "在这里吗？？";
		npctalk "在这里吗？？", "Tommy#172nw01", bc_self;
		next;
		mes "[Meimei]";
		mes "哦，冒险家，你在这里。";
		npctalk "哦，冒险家，你在这里。", "Meimei#172nw01", bc_self;
		next;
		cutin "ep172_alpha",2;
		mes "[Mansion Manager ��]";
		mes "又来了一位。他们是你的队伍成员吗？";
		next;
		cutin "",255;
		select( "是的，我和他们一起。" );
		mes "[Meimei]";

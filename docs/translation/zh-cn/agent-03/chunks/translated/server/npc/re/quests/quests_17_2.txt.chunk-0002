		erasequest 17333;
		setquest 17334;
		close2;
		cutin "",255;
		navigateto("ba_maison",146,109);
		end;
	}
	if (ep17_2_main == 10 || ep17_2_main == 11) {
		cutin "ep172_alpha",2;
		mes "[Mansion Manager ��]";
		mes "首先，最近的是<NAVI>[餐厅]<INFO>ba_maison,146,109,0,101,0</INFO></NAVI>。你应该去那里。如果你把问题告诉中继器附近的自动人偶，它们会替你处理。";
		close3;
	}
	if (ep17_2_main == 12) {
		cutin "ep172_alpha",2;
		mes "[Mansion Manager ��]";

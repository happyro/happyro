		mes "[Dew]";
		mes "呕呃呃呃呃……";
		mes "我臭死了！！！！";
		mes "这可不是开玩笑！！！";
		next;
		mes "[Dew]";
		mes "水！！！";
		mes "我需要干净的水！！！！";
		next;
		mes "[Dew]";
		mes "哦，那边正好有东西？！";
		next;
		cutin "bu_mark3",2;
		mes "[Mark]";
		mes "你要去哪儿！！！";
		ep17_2_library = 1;
		setquest 11621;
		close2;
		cutin "",255;
		cloakonnpcself( "Dew#ep172_bamaison-00" );
		cloakonnpcself( "Mark#ep172_bamaison-00" );
		cloakonnpcself( "Magi#ep172_bamaison-00" );
		navigateto("ba_maison",85,111);
		end;
	}
	if (ep17_2_library == 1) {
		cloakoffnpcself( "Dew#ep172_bamaison-00" );
		cloakoffnpcself( "Mark#ep172_bamaison-00" );
		cloakoffnpcself( "Magi#ep172_bamaison-00" );
		cutin "ep172_tamarin02",2;
		mes "[Tamarin]";
		mes "咳！！！！！！";
		mes "这个味道！！！！！！！！！！！！！！";
		mes "味道太难闻了！！！！";
		next;
		cutin "bu_mark4",2;
		mes "[Mark]";
		mes "仔细想想，在明亮的地方看，你也脏得厉害。";
		mes "呃……你臭得真厉害！！";
		next;
		cutin "bu_maggi3",2;
		mes "[Magi]";
		mes "Dew。";
		mes "你身上有股腐烂的味道……";
		next;
		cutin "bu_du1",2;
		mes "[Dew]";
		mes "咦？";
		mes "是因为我掉进下水道了吗？";
		next;
		cutin "bu_du2",2;
		mes "[Dew]";
		mes "没错！！";
		mes "听着，我之前掉进下水道了，真的很危险！";
		mes "我的救命恩人是……";
		next;
		cutin "bu_mark3",2;
		mes "[Mark]";
		mes "你臭死了，别靠近我，你这个笨蛋！！！";
		next;
		cutin "bu_du5",2;
		mes "[Dew]";
		mes "呕呃呃呃呃……";
		mes "我臭死了！！！！";
		mes "这可不是开玩笑！！！";
		next;
		mes "[Dew]";
		mes "水！！！";
		mes "我需要干净的水！！！！";
		next;
		mes "[Dew]";
		mes "哦，那边正好有东西？！";
		next;
		cutin "bu_mark3",2;
		mes "[Mark]";
		mes "你要去哪儿！！！";
		close2;
		cutin "",255;
		navigateto("ba_maison",85,111);
		end;
	}
	if (ep17_2_library < 5) {
		mes "[Tamarin]";
		mes "我听说瓦尔蒙特的宅邸在佣兵起义期间被烧毁了……我觉得它和书上写的很不一样。";
		cutin "ep172_tamarin01.bmp",2;
		close3;
	}
	cutin "ep172_tamarin01",2;
	mes "[Tamarin]";
	mes "你好，" + strcharinfo(0) + ".";
	mes "我接到了Alpha的临时任务，正在请求其他冒险家的帮助。";
	next;
	switch( checkquest(11639,PLAYTIME) ) {
	case -1:
		break;
	case 0:
	case 1:
		cutin "ep172_tamarin04",2;
		mes "[Tamarin]";
		mes "今天的工作已经完成了。谢谢你愿意帮忙。";
		close3;
	case 2:
		erasequest 11639;
		break;
	}
	switch( checkquest(11638,HUNTING) ) {
	case -1:
		mes "[Tamarin]";
		mes "我们请求收集宅邸周围残留的守护者部件。宅邸似乎最近遭到袭击，居住环境受到了影响。";
		mes "请收集20个守护者部件，改善宅邸的环境状况。";
		next;
		if (select( "接受。", "拒绝。" ) == 2) {
			cutin "ep172_tamarin04",2;
			mes "[Tamarin]";
			mes "希望你在这里度过安全舒适的时光。";
			close3;
		}
		cutin "ep172_tamarin04",2;
		mes "[Tamarin]";
		mes "非常感谢。";
		setquest 11638;
		close3;
	case 0:
	case 1:
		mes "[Tamarin]";
		mes "嗯……" + strcharinfo(0) + ", 你已经接受了这个请求。";
		close3;
	case 2:
		cutin "ep172_tamarin04",2;
		mes "[Tamarin]";
		mes "我确认你已经完成了这个请求。非常感谢。";
		erasequest 11638;
		setquest 11639;
		getitem 1000103,2;
		getexp 500000,300000;
		close3;
	}
	end;

OnInit:
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "isbegin_quest(11620) == 1" );
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "ep17_2_main >= 10 && isbegin_quest(11621) == 0 && ep17_2_library == 0" );

	questinfo( QTYPE_DAILYQUEST, QMARK_YELLOW, "ep17_2_library == 5 && checkquest(11639,PLAYTIME) == -1 && checkquest(11638,HUNTING) == -1" );
	questinfo( QTYPE_DAILYQUEST, QMARK_YELLOW, "checkquest(11639,PLAYTIME) == 2" );
	questinfo( QTYPE_QUEST2, QMARK_YELLOW, "checkquest(11638,HUNTING) == 2" );
	end;
}


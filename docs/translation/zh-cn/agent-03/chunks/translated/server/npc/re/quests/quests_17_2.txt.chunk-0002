		npctalk "哇，这就是宅邸。瓦尔蒙特的宅邸！", "Meimei#172nw01", bc_self;
		next;
		mes "[Tommy]";
		mes "冒险家！宅邸内已经确认有幻影活动。我们很快会组建队伍，了解宅邸结构并开始行动。";
		next;
		select( "我会等着。" );
		cutin "ep172_alpha",2;
		mes "[Mansion Manager ��]";
		mes "如果你是第一次来，请往这边走。我会正式为你登记宅邸访客身份。";
		next;
		mes "[Mansion Manager ��]";
		mes "哦，在那之前……" + strcharinfo(0) + ", 你参观过宅邸了吗？";
		next;
		cutin "",255;
		select( "还没有。" );
		cutin "ep172_alpha",2;
		mes "[Mansion Manager ��]";
		mes "那么，可以请你帮个忙吗？我不是故意偷听的，但你说过需要了解宅邸的结构。";
		next;
		mes "[Mansion Manager ��]";
		mes "你能告诉故障中继器附近的自动人偶去检查中继器吗？";
		next;
		mes "[Mansion Manager ��]";
		mes "四处看看宅邸是个不错的做法。";
		next;
		mes "[Mansion Manager ��]";
		mes "这是我的工作，但访客还在不断到来，我没有足够时间手动登记、更新和共享信息。";
		next;
		cutin "",255;
		if (select( "我来做。", "我得先做点别的事。" ) == 2) {
			mes "[Mansion Manager ��]";
			mes "这样啊，抱歉在你忙碌时提了太多要求。";

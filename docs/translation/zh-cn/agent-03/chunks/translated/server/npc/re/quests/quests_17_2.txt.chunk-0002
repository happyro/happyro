		cutin "ep172_alpha",2;
		mes "[Mansion Manager ��]";
		mes "谢谢你接受我这个麻烦的请求。";
		mes "还有一些自动人偶没有收到更新后的访客名单，但我们已经正式授予" + strcharinfo(0) + "访客身份。你靠近它们时，它们就会认出你。";
		next;
		mes "[Mansion Manager ��]";
		mes "其他人都已经收到名单，所以使用宅邸不会太不方便。如需帮助，请随时联系最近的自动人偶。";
		next;
		mes "[Mansion Manager ��]";
		mes "首先，最近的是<NAVI>[餐厅]<INFO>ba_maison,146,109,0,101,0</INFO></NAVI>。你应该去那里。如果你把问题告诉中继器附近的自动人偶，它们会替你处理。";
		next;
		mes "[Mansion Manager ��]";
		mes "那么，拜托了。";

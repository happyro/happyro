		npctalk "实验室……收到信号...", "", bc_self;
		sleep2 2000;
		npctalk "礼堂……收到信号...", "", bc_self;
		sleep2 2000;
		npctalk "餐厅……收到信号...", "", bc_self;
		sleep2 2000;
		npctalk "警卫岗哨……收到信号...", "", bc_self;
		sleep2 2000;
		npctalk "凉亭……收到信号...", "", bc_self;
		sleep2 2000;
		npctalk "仓库……收到信号...", "", bc_self;
		sleep2 2000;
		npctalk "花园……收到信号...", "", bc_self;
		cutin "ep172_alpha",2;
		mes "[Mansion Manager ��]";
		mes "宅邸的网络已经恢复，所有区域的信号都在清晰地收发。";
		mes "现在，作为正式访客，你可以使用宅邸的所有设施。";
		next;

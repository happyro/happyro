		mes "欣赏我家乡迷人的景色";
		mes "。呵呵呵呵～";
		next;
		mes "[Satra]";
		mes "既然你是如此";
		mes "独特的客人，我就给予你";
		mes "独特的荣誉，";
		mes "屈尊与你";
		mes "交谈，冒险者。";
		next;
		mes "[Satra]";
		mes "艾因贝赫的存在就是为我的家族";
		mes "提供煤炭和";
		mes "矿产材料。";
		mes "这是自然法则：工人";
		mes "必须由少数被选中的人领导。";
		next;
		mes "[Satra]";
		mes "看到那些工人渴望达到";
		mes "我们社会声望的高度，";
		mes "真是令人愉快的";
		mes "荒谬。";
		mes "呵呵呵呵～";
		next;
		mes "[Satra]";
		mes "哦，我已经很久没和";
		mes "低阶层的人";
		mes "说话了！感觉";
		mes "禁忌又刺激！";
		next;
		mes "[Satra]";
		mes "好了，冒险者，非正式";
		mes "聊天就到这里。";
		mes "我甚至允许你";
		mes "尽情炫耀";
		mes "自己";
		mes "和萨特拉夫人交谈过。";
		next;
		mes "[Satra]";
		mes "如果你还想";
		mes "再次和我";
		mes "交谈，就证明你";
		mes "比其他卑微的";
		mes "仆人更有价值，";
		mes "配得上我的优雅。";
		next;
		mes "[Satra]";
		mes "哦，我有个绝妙的";
		mes "主意！你为什么不带";
		mes "^990000煤炭^000000给我？这对你来说";
		mes "并非不可能，但";
		mes "这种任务需要你付出";
		mes "一些努力。";
		set EIN_LOVERQ,9;
		if (isbegin_quest(8081) == 1)
			changequest 8081,8083;
		else
			changequest 8082,8083;
		next;
		mes "[Satra]";
		mes "再见，";
		mes "冒险者～";
		close;
	}
	mes "[Satra]";
	mes "一个四处游荡的";
	mes "冒险者……？";
	mes "多么罪恶地";
	mes "令人着迷！";
	mes "呵呵呵呵～";
	next;
	mes "[Satra]";
	mes "哦，别担心。";
	mes "我相信家乡的美景";
	mes "已经抓住了你的";
	mes "好奇心。我的粗鲁丈夫";
	mes "要是发现你，";
	mes "肯定会打你……";
	next;
	mes "[Satra]";
	mes "但我比Megass";
	mes "文雅多了。你可以";
	mes "尽情享受这里的";
	mes "陈设。呵呵呵呵～";
	close;
}

ein_in01,191,102,5	script	Kaijeta#ein	846,{
	if (EIN_LOVERQ > 15) {
		mes "[Kaijeta]";
		mes "我的儿子从你的好榜样中";
		mes "学到了很多。";
		mes "";
		mes "作为母亲，我非常";
		mes "感谢你为他";
		mes "所做的一切。";
		next;
		mes "[Kaijeta]";
		mes "冒险者，";
		mes "无论你的旅程";
		mes "把你带到哪里，我都会祈祷你";
		mes "平安。";
		mes "";
		close;
	}
	if (EIN_LOVERQ == 15) {
		mes "[Kaijeta]";
		mes "谢谢你帮助";
		mes "我的儿子Klitzer。遗憾的是，这个";
		mes "小傻瓜对挑选衣服之类的事";
		mes "一窍不通。";
		mes "他为此非常紧张！";
		mes "";
		next;
		mes "[Kaijeta]";
		mes "男人应该穿漂亮衣服，";
		mes "比如正式套装";
		mes "或燕尾服，参加重要";
		mes "会议和特殊场合。";
		mes "希望他很快能学会。";
		close;
	}
	if (EIN_LOVERQ == 14) {
		mes "[Kaijeta]";
		mes "谢谢你帮助";
		mes "我的儿子Klitzer。遗憾的是，这个";
		mes "小傻瓜对挑选衣服之类的事";
		mes "一窍不通。";
		mes "他为此非常紧张！";
		mes "";
		next;
		set EIN_LOVERQ,15;
		changequest 8086,8087;
		mes "[Kaijeta]";
		mes "男人应该穿漂亮衣服，";
		mes "比如正式套装";
		mes "或燕尾服，参加重要";
		mes "会议和特殊场合。";
		mes "希望他很快能学会。";
		close;
	}
	if (EIN_LOVERQ == 8) {
		mes "[Kaijeta]";
		mes "我无法忍受两座城镇之间";
		mes "微不足道的仇恨";
		mes "阻止儿子";
		mes "见他爱的女人……";
		if (isbegin_quest(8081) == 1)
			changequest 8081,8082;
		close;
	}
	if (EIN_LOVERQ == 7) {
		mes "[Kaijeta]";
		mes "谢谢你帮助我的";
		mes "儿子。他爱上艾因布洛克的女人，";
		mes "看起来像个傻瓜，但他是诚实的";
		mes "勤劳男人。";
		next;
		mes "[Kaijeta]";
		mes "话说回来，这迟早会";
		mes "发生。艾因贝赫";
		mes "非常贫穷，而艾因布洛克";
		mes "非常富裕。你不同意也能理解，但异性相吸迟早会发生。";
		next;
		mes "[Kaijeta]";
		mes "^666666*Sigh...*^000000";
		mes "如果我的儿子和Calla能";
		mes "解决问题，也许能";
		mes "改善";
		mes "两座城镇的关系。";
		mes "我当然希望如此……";
		next;
		mes "[Kaijeta]";
		mes "不过，我还是很困惑！";
		mes "我把儿子培养得更有";
		mes "勇气，不会在心碎时";
		mes "沉溺悲伤。而且";
		mes "我仍不知道他怎么和这么富有的女人走到一起。";
		next;
		set EIN_LOVERQ,8;
		mes "[Kaijeta]";
		mes "你知道怎样";
		mes "结束";
		mes "两座城镇之间的仇恨吗？";
		mes "我不想";
		mes "看到这对情侣";
		mes "因这种小事分开。";
		close;
	}
	mes "[Kaijeta]";
	mes "欢迎来到我简陋的";
	mes "住处，冒险者。抱歉";
	mes "招待不周。";
	next;
	mes "[Kaijeta]";
	mes "如你所见，我们必须和";
	mes "其他家庭";
	mes "共住这栋房子，所以没有";
	mes "多少空地或";
	mes "隐私。恐怕我们连基本的舒适都";
	mes "负担不起。";
	next;
	mes "[Kaijeta]";
	mes "目前这是我们能做到的";
	mes "最好选择。我们没有";
	mes "Zeny买房或";
	mes "土地，只能";
	mes "忍受这一切……";
	close;
}

einbroch,188,72,3	script	Keneshiotz#ein	855,{
	mes "[Keneshiotz]";
	mes "这座城市到处都是高耸的";
	mes "烟囱和";
	mes "机器持续的轰鸣。";
	next;
	mes "[Keneshiotz]";
	mes "空气确实污染严重，";
	mes "但我认为这是财富和";
	mes "舒适现代生活应付出的";
	mes "公平代价。";
	mes "环境算什么！";
	next;
	mes "[Keneshiotz]";
	mes "我宁愿这样生活，";
	mes "也不愿变成那些";
	mes "肮脏艾因贝赫里的";
	mes "落后流浪汉。他们难道不知道";
	mes "金钱让";
	mes "世界运转吗？";
	close;
}

einbech,216,118,3	script	Catzllanpu#ein	854,{
	mes "[Catzllanpu]";
	mes "^333333*Sigh...*^000000";
	mes "简单的快乐。";
	mes "正是它们让";
	mes "生活值得度过，";
	mes "你知道吗？";
	next;
	mes "[Catzllanpu]";
	mes "我只要";
	mes "过普通幸福的生活就够了，";
	mes "但身边的人都想";
	mes "越来越努力工作。如果";
	mes "从不休息，你就是在";
	mes "慢慢杀死自己。";
	next;
	mes "[Catzllanpu]";
	mes "你应该看得出来，";
	mes "我没有别人对";
	mes "金钱的";
	mes "烦恼。钱很好，但不值得牺牲";
	mes "生活的";
	mes "质量，对吧？";
	close;
}

einbroch,208,208,3	script	Kesunboss#ein	850,{
	mes "[Kesunboss]";
	mes "Calla小姐是";
	mes "优雅的化身，";
	mes "名副其实的";
	mes "艾因布洛克女神。";
	next;
	mes "[Kesunboss]";
	mes "她温柔的声音、";
	mes "天使般的笑容、";
	mes "善良与温暖，";
	mes "以及对他人的体贴，";
	mes "最重要的是……";
	next;
	mes "[Kesunboss]";
	mes "Calla的家族";
	mes "富裕得超乎";
	mes "想象！她";
	mes "完美无缺！不知道她会嫁给谁，";
	mes "但那位";
	mes "绅士肯定很幸运。";
	next;
	mes "[Kesunboss]";
	mes "Calla小姐住在宏伟宅邸里，让其他房子";
	mes "相比之下像破棚。";
	mes "从这里先向北再向西，";
	mes "就能欣赏它的";
	mes "美丽与优雅。";
	close;
}

einbech,176,125,3	script	Ellhenje#ein	850,{
	mes "[Ellhenje]";
	mes "这个城镇的情况可能";
	mes "很糟，";
	mes "有污染";
	mes "和来自艾因布洛克的";
	mes "欺凌……";
	next;
	mes "[Ellhenje]";
	mes "但不知为何，人们";
	mes "还是撑了过来。这是因为";
	mes "这里有个";
	mes "大家都喜欢的人……";
	next;
	mes "[Ellhenje]";
	mes "我说的就是Klitzer！";
	mes "他几乎诚实过头，";
	mes "勤奋过头。但最重要的是，";
	mes "他是最善良的人～";
	next;
	mes "[Ellhenje]";
	mes "Klitzer出生在艾因贝赫";
	mes "最贫穷的家庭之一，";
	mes "但他通常很快乐，总为别人着想。我想这就是人们认为他";
	mes "能代表整个艾因贝赫的原因。";
	next;
	mes "[Ellhenje]";
	mes "最近有些事";
	mes "一直困扰他。我不确定，";
	mes "但我想只有";
	mes "女人方面的烦恼才会让";
	mes "男人如此郁闷。希望他";
	mes "很快好起来……";
	close;
}

ein_in01,208,86,3	script	Decii#ein	855,{
	mes "[Decii]";
	mes "真是";
	mes "令人沮丧！";
	mes "我被这些";
	mes "^FF0000人^000000包围了！";
	next;
	mes "[Decii]";
	mes "这么拥挤的城市里";
	mes "完全没有隐私！";
	mes "我想";
	mes "应该尽快";
	mes "搬出去。";
	close;
}

ein_in01,192,90,3	script	Supineque#ein	849,{
	mes "[Supineque]";
	mes "呃……";
	mes "我快饿死了！";
	next;
	mes "[Supineque]";
	mes "我太久没吃东西，";
	mes "胃都开始";
	mes "消化自己了！";
	mes "太可怕了……";
	next;
	mes "[Supineque]";
	mes "我的意思是，我有";
	mes "今天能吃的";
	mes "食物。但吃完后，";
	mes "明天";
	mes "吃什么呢？";
	close;
}

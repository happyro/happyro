un_bk_q,220,350,4	script	Bioengineer Ebrik#EP15.2MR	4_M_01,{
	callfunc( "F_time_limit_recorder", .@cooldown_status_day );
	if (.@cooldown_status_day[0] == 1) {
		mes "[Bioengineer Ebrik]";
		mes "我们生化工程师正在竭尽全力，为防空洞里的人生产食物。";
		close;
	}
	if (.@cooldown_status_day[1] == 1) {
		mes "[Bioengineer Ebrik]";
		mes "我们生化工程师正在竭尽全力，为防空洞里的人生产食物。";
		close;
	}
	if ((.@cooldown_status_day[0] + .@cooldown_status_day[1] + .@cooldown_status_day[2] + .@cooldown_status_day[3] + .@cooldown_status_day[4]) == 0) {
		emotion 1;
		mes "[Bioengineer Ebrik]";
		mes "你就是来帮助我们收获葡萄的冒险者吗？很高兴见到你。";
		next;
		mes "[Bioengineer Ebrik]";
		mes "仅靠生化工程师的人手，无法收获足够供应防空洞所有人的葡萄。";
		next;
		mes "[Bioengineer Ebrik]";
		mes "所以我们只好请求冒险者帮忙。";
		next;
		select("还有其他人能帮忙吗？");
		mes "[Bioengineer Ebrik]";
		mes "别提了。我们把收获葡萄的任务交给了漫不经心的机械工匠，结果……";
		next;
		emotion 16;
		mes "[Bioengineer Ebrik]";
		mes "他们竟然砸坏了一棵葡萄树！！";
		next;
		mes "[Bioengineer Ebrik]";
		mes "幸好我们及时发现并阻止了他们，否则其他树也会被毁。想起来就可怕。";
		next;
		mes "[Bioengineer Ebrik]";
		mes "啊！这不是重点。";
		next;
		mes "[Bioengineer Ebrik]";
		mes "我们使用生长加速，让成熟葡萄定期掉落。";
		next;
		mes "[Bioengineer Ebrik]";
		mes "如果你能在葡萄树前等待并收集 30 串葡萄就好了。";
		next;
		mes "[Bioengineer Ebrik]";
		mes "你可以多收集一些，但收获剩下的葡萄会自然腐烂消失。";
		next;
		if (isbegin_quest(5370) == 1)
			erasequest 5370;
		setquest 5358;
		setquest 5359;
		mes "[Bioengineer Ebrik]";
		mes "这样土壤肥力会部分恢复。祝你好运。";
		close;
	}
	if (.@cooldown_status_day[2] == 1) {
		.@quest_day_3 = isbegin_quest(5359) + isbegin_quest(5360) + isbegin_quest(5361) + isbegin_quest(5362);
		switch(.@quest_day_3) {
		case 1:
			if (countitem(6826) < 30) {
				mes "[Bioengineer Ebrik]";
				mes "我们决定每队发放一个葡萄箱。";
				next;
				mes "[Bioengineer Ebrik]";
				mes "一个箱子能装 30～32 串，所以请按此数量收集。";
				close;
			}
			emotion 21;
			mes "[Bioengineer Ebrik]";
			mes "哇，干得好。不愧是冒险者，比机械工匠能干多了。";
			next;
			mes "[Bioengineer Ebrik]";
			mes "既然葡萄收获了，我们把它们送给各队吧？";
			next;
			mes "[Bioengineer Ebrik]";
			mes "不好意思，我还想在你辛苦工作后再拜托你一件事。";
			next;
			mes "[Bioengineer Ebrik]";
			mes "让我看看……你刚收获的葡萄";
			next;
			delitem 6826, countitem(6826);
			.@r = rand(1,3);
			setquest (5359 + .@r);
			mes "[Bioengineer Ebrik]";
			if (.@r == 1)
				mes "应该送给机械 AI 队伍。你可以交给 Mugeosi。";
			else if (.@r == 2)
				mes "应该送给设施管理员队伍。你可以交给 Remodeling。";
			else
				mes "应该送给化学物质队伍。你可以交给 Karsten。";
			next;
			mes "[Bioengineer Ebrik]";
			mes "哦！送完货后不用回来。我们要忙着开始下一个项目。";
			next;
			mes "[Bioengineer Ebrik]";
			mes "收货的人应该会给你补偿。如果不给，你可以催他们。";
			close;
		case 2:
			mes "[Bioengineer Ebrik]";
			mes "你手里的葡萄箱";
			next;
			mes "[Bioengineer Ebrik]";
			if (isbegin_quest(5360) == 1)
				mes "必须交给机械 AI 队伍的 Mugeosi。";
			else if (isbegin_quest(5361) == 1)
				mes "必须交给设施管理员队伍的 Remodeling。";
			else
				mes "必须交给化学物质队伍的 Karsten。";
			next;
			mes "[Bioengineer Ebrik]";
			mes "补偿由收货人支付，所以你不用回到这里。";
			close;
		default:
			mes "[Bioengineer Ebrik]";
			mes "我不是说过不用回来吗？总之，你是怎么进来的？";
			close;
		}
	}
	mes "[Bioengineer Ebrik]";
	mes "我们生化工程师正在竭尽全力，为防空洞里的人生产食物。";
	close;
}

un_bk_q,333,333,0	script	Grape System#EP15.2MR	HIDDEN_WARP_NPC,{
	end;
OnInit:
	initnpctimer;
	end;
OnTimer30000:
OnTimer210000:
	callsub( S_Random_Grap, 240,244, 389,391, 1,2,1 );
	end;
OnTimer60000:
OnTimer240000:
	callsub( S_Random_Grap, 271,275, 389,391, 1,1,2 );
	end;
OnTimer90000:
OnTimer270000:
	callsub( S_Random_Grap, 314,318, 342,344, 2,1,1 );
	end;
OnTimer120000:
OnTimer300000:
	callsub( S_Random_Grap, 239,243, 341,343, 1,2,1 );
	end;
OnTimer180000:
	callsub( S_Random_Grap, 331,333, 357,361, 1,1,2 );
	end;
OnTimer330000:
	callsub( S_Random_Grap, 331,333, 357,361, 1,1,2 );
	initnpctimer;
	end;

S_Random_Grap:
	for ( .@i = 0; .@i < 3; ++.@i ) {
		do {
			.@x = rand( getarg(0), getarg(1) );
			.@y = rand( getarg(2), getarg(3) );
		}
		while( !checkcell("un_bk_q",.@x,.@y,cell_chkpass) );
		makeitem 6826, getarg(4+.@i), "un_bk_q",.@x,.@y;
	}
	return;
}

un_bk_q,276,243,4	script	Nurse Lapplad#EP15.2MR	4_F_BRZ_WOMAN,{
	callfunc( "F_time_limit_recorder", .@cooldown_status_day );
	if (.@cooldown_status_day[0] == 1)	// Unknown text
		end;
	if (.@cooldown_status_day[1] == 1)	// Unknown text
		end;
	if (.@cooldown_status_day[2] == 1)	// Unknown text
		end;
	if ((.@cooldown_status_day[0] + .@cooldown_status_day[1] + .@cooldown_status_day[2] + .@cooldown_status_day[3] + .@cooldown_status_day[4]) == 0) {
		emotion 17;
		mes "[Nurse Lapplad]";
		mes "抱歉。让你久等了吗？如你所见，这里有很多疑似感染患者……";
		next;
		select("没有……");
		emotion 23;
		mes "[Nurse Lapplad]";
		mes "咦？！你没等？真奇怪。你插队了吗？插队是不好的。";
		next;
		mes "[Nurse Lapplad]";
		mes "如你所知，有些感染者突然出现了奇怪的症状……";
		next;
		emotion 10;
		mes "[Nurse Lapplad]";
		mes "嗯……";
		next;
		mes "[Nurse Lapplad]";
		mes "...Ah...";
		next;
		emotion 0;
		mes "[Nurse Lapplad]";
		mes "...Oh!!";
		next;
		mes "[Nurse Lapplad]";
		mes "我没看到什么问题症状。太幸运了。";
		next;
		mes "[Nurse Lapplad]";
		mes "突然抽搐的患者让我们很头疼。";
		next;
		mes "[Nurse Lapplad]";
		mes "看这里。我好几天没睡觉，皮肤都变脆了～";
		next;
		if (mobcount( "un_bk_q", "Nurse Lapplad#EP15.2MR::OnMyMobDead" ) < 1) {
			disablenpc "Patient#EP15.2MR_01";
			monster "un_bk_q",286,254, "Convulsing Patient", 1015,1, "Nurse Lapplad#EP15.2MR::OnMyMobDead";	// ZOMBIE
			.mob_id[1] = $@mobid[0];
			initnpctimer;
		}
		mes "砰咚！！砰砰！！哐当！！";
		next;
		emotion 18;
		mes "[Nurse Lapplad]";
		mes "是的……就是这样。";
		next;
		emotion 10;
		mes "[Nurse Lapplad]";
		mes "... ...";
		next;
		mes "[Nurse Lapplad]";
		mes "啊！！又有患者抽搐了。";
		next;
		mes "[Nurse Lapplad]";
		mes "嘿。你不是冒险者吗？一定很强吧。";
		next;
		if (isbegin_quest(5370) == 1)
			erasequest 5370;
		setquest 5363;
		setquest 5364;
		mes "[Nurse Lapplad]";
		mes "你能制服那个抽搐的患者吗？拜托你了。";
		close;
	}
	if (.@cooldown_status_day[3] == 1) {
		.@quest_day_4 = isbegin_quest(5364) + isbegin_quest(5365);
		if (.@quest_day_4 == 1) {
			if (mobcount( "un_bk_q", "Nurse Lapplad#EP15.2MR::OnMyMobDead" ) < 1) {
				mes "[Nurse Lapplad]";
				mes "你没有被抽搐的患者咬伤或抓伤吧？";
				next;
				select("为什么？");
				mes "[Nurse Lapplad]";
				mes "嗯～我没看到特别的伤口。";
				next;
				mes "[Nurse Lapplad]";

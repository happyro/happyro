prt_q,148,49,0	script	Sign#EP161ETC12	2_BULLETIN_BOARD,{
	mes "[Prontera, the Capital of Rune-Midgarts Kingdom]";
	mes "欢迎来到普隆德拉，";
	mes "卢恩-米德加尔特的中心！";
	mes "普隆德拉位于";
	mes "大陆中央，";
	mes "是著名的繁华城市，";
	mes "商业和贸易十分发达。";
	next;
	mes "[Prontera, the Capital of Rune-Midgarts Kingdom]";
	mes "这里有许多重要建筑，";
	mes "包括可以转职十字军的普隆德拉宫殿；";
	mes "可以转职服事、牧师并举办婚礼的普隆德拉大教堂；";
	mes "以及骑士团大楼等。";
	next;
	mes "[Prontera, the Capital of Rune-Midgarts Kingdom]";
	mes "这里还有许多人和商店，";
	mes "记得四处逛逛。";
	next;
	mes "[Prontera, the Capital of Rune-Midgarts Kingdom]";
	mes "中央喷泉东南方还有";
	mes "历史悠久的夸德罗铁匠铺。";
	mes "想修理装备的话，";
	mes "可以顺道去那里";
	mes "修理。";
	next;
	mes "[Prontera, the Capital of Rune-Midgarts Kingdom]";
	mes "东南方是伊斯鲁德，南方是斐扬，西方是吉芬，北方是艾尔帕兰。";
	close;
}


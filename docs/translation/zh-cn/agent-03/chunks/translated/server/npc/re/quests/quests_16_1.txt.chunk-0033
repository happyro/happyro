// GM NPC
prt_q,5,5,6	script	Pron Dungeon Helper#EP161PG	4_EP16_SPIEGEL,{
	if (callfunc("F_GM_NPC",1854,0,1,9999) < 1)
		end;
	mes "[Pron Dungeon Helper]";
	mes "请选择要使用的服务。";
	next;
	switch( select( "设置任务开始", "重置冷却时间", "重置任务", "查看当前状态" ) ) {
	case 1:
		mes "[Pron Dungeon Helper]";
		mes "重置任务后继续。请选择要开始的任务。";
		next;
		switch( select( "男孩任务", "女孩任务", "士兵任务", "夫妻任务" ) ) {
		case 1:
			setquest 5448;
			mes "[Pron Dungeon Helper]";
			mes "要移动到这个起点吗？";
			next;
			select("移动");
			warp "prt_q",221,193;
			end;
		case 2:
			setquest 5449;
			mes "[Pron Dungeon Helper]";
			mes "要移动到这个起点吗？";
			next;
			select("移动");
			warp "prt_q",276,242;
			end;
		case 3:
			setquest 5450;
			mes "[Pron Dungeon Helper]";
			mes "要移动到这个起点吗？";
			next;
			select("移动");
			warp "prt_q",140,304;
			end;
		case 4:
			setquest 5451;
			mes "[Pron Dungeon Helper]";
			mes "要移动到这个起点吗？";
			next;
			select("移动");
			warp "prt_q",38,261;
			end;
		}
		end;
	case 2:
		mes "[Pron Dungeon Helper]";
		mes "重置冷却时间。";
		next;
		select("设置");
		erasequest 5452;
		break;
	case 3:
		mes "[Underground Dungeon Helper]";
		mes "所有与地下城相关的任务都会重置。";
		next;
		select("设置");
		mes "[Underground Dungeon Helper]";
		for ( .@i = 5448; .@i < 5468; ++.@i ) {
			if (isbegin_quest(.@i) > 0)
				erasequest .@i;
			mes "" + .@i + " 已删除";
		}
		next;
		break;
	case 4:
		mes "[Pron Dungeon Helper]";
		mes "5448(" + isbegin_quest(5448) + ")/5449(" + isbegin_quest(5449) + ")/5450(" + isbegin_quest(5450) + ")/5451(" + isbegin_quest(5451) + ")";
		mes "5453(" + isbegin_quest(5453) + ")/5454(" + isbegin_quest(5454) + ")/5455(" + isbegin_quest(5455) + ")/5456(" + isbegin_quest(5456) + ")";
		mes "5457(" + isbegin_quest(5457) + ")/5458(" + isbegin_quest(5458) + ")/5459(" + isbegin_quest(5459) + ")";
		mes "5460(" + isbegin_quest(5460) + ")/5461(" + isbegin_quest(5461) + ")/5462(" + isbegin_quest(5462) + ")";
		mes "5463(" + isbegin_quest(5463) + ")/5464(" + isbegin_quest(5464) + ")/5465(" + isbegin_quest(5465) + ")/5466(" + isbegin_quest(5466) + ")/5467(" + isbegin_quest(5467) + ")/5468(" + isbegin_quest(5468) + ")";
		next;
		break;
	}
	mes "[Pron Dungeon Helper]";
	mes "完成";
	close;
}

// Prison quests
prt_pri00,46,130,7	script	Corrupt Warder#pa0829	4_M_KY_SOLD,{
	if (checkweight(1201,1) == 0) {
		mes "携带的物品种类太多。减少物品种类后再试。";
		close;
	}
	if ((MaxWeight - Weight) < 1000) {
		mes "携带物品太重，难以继续。减轻负重后再试。";
		close;
	}
	mes "[Corrupt Warder]";
	mes "怎么了？是迪伦派你来的吗？如果要和我交易，就别浪费时间。很多人正在监视我们。";
	next;
	if (select( "什么交易？", "开始交易。" ) == 1) {
		mes "[Corrupt Warder]";
	mes "迪伦每次弄坏东西时，不是都会做出奇怪的粉末吗？";
		next;
		mes "[Corrupt Warder]";
	mes "那是魔法师用于实验的^0000ff符文魔法粉末^000000。我想迪伦并不知道。";
		next;
		mes "[Corrupt Warder]";
	mes "我可以用^0000ff30份符文魔法粉末兑换1个神秘蓝箱^000000。怎么样？很划算吧？";
		close;
	}
	if (countitem(6920) < 30) {
		mes "[Corrupt Warder]";
	mes "30份符文魔法粉末兑换1个神秘蓝箱。提醒你一下。";
		close;
	}
	mes "[Corrupt Warder]";
	mes "很好，这笔交易很划算。";
	delitem 6920,30;// RuneMagicPowder
	getitem 22901,1;// BlueboxOfQuestions
	close;
}

prt_pri00,61,136,3	script	Dylan#pa0829	4_CAT_SAILOR5,{
	disable_items;
	if (checkweight(1201,1) == 0) {
	mes "携带的物品种类太多。减少物品种类后再试。";
		close;
	}
	if ((MaxWeight - Weight) < 1000) {
	mes "携带的物品太重，似乎无法继续。减轻负重后再试。";
		close;
	}
	if (isbegin_quest(12369) == 0) {
		mes "[Dylan]";
	mes "你是顾客吗？我累了，今天不打算再接待更多顾客。";
		next;
	select("你在监狱里做生意吗？");
		mes "[Dylan]";
	mes "虽然我现在看起来这样，但以前别人称我为拥有‘负之手’的人。那东西很危险，你最好离远点。";
		next;
		mes "^0000ff和他说的话不同，他似乎非常急于解释。^000000";
		next;
		if (select( "I don't want to waste time here.", "What kind of business you are running here." ) == 1) {
			mes "[Dylan]";
		mes "别当胆小鬼……";
			close;
		}
		mes "[Dylan]";
	mes "荣誉徽章由王国发放，不得个人交易。我收取徽章并强化装备。";
		next;
		mes "[Dylan]";
	mes "如你所知，这是违法的。所以我以前只通过私人关系工作。但有人的装备在重置强化时损坏，他把我告发了。";
		next;
	select("这确实是犯罪。");
		mes "[Dylan]";
	mes "我不需要听你的个人看法。虽然被抓了，但多亏那边的看守，我可以自由出入监狱。";
		next;
		mes "[Dylan]";
	mes "当然，为避免真正的问题我不能出去。所以我就这样留在监狱里。你对交易感兴趣吗？";
		next;
	if (select( "王国治安很差。", "交易是什么？" ) == 1) {
			mes "[Dylan]";
	mes "真是书呆子。不想惹麻烦就离远点，我说过了。";
			close;
		}
		mes "[Dylan]";
	mes "你是个很好的交易对象。我想攒够保释金。欢迎所有顾客。";
		next;
		mes "[Dylan]";
	mes "我用荣誉徽章强化三件物品：奉承长袍、讽刺长袍和普隆德拉徽章。";
		next;
		mes "[Dylan]";
	mes "我想不用再解释了。把想强化的装备带给我。";
		setquest 12369;// Secret Business Relation
		completequest 12369;// Secret Business Relation
		close;
	}
	mes "[Dylan]";
	mes "你是来和我交易的吗？告诉我现在需要什么。";
	next;
	.@s = select( "告诉我交易详情。", "强化长袍", "强化徽章", "重置强化长袍属性", "重置强化徽章属性" );
	switch(.@s) {
	case 1:
		mes "[Dylan]";
	mes "仔细听，我不会说第二遍。";
		next;
		mes "[Dylan]";
	mes "强化奉承长袍或讽刺长袍的一个插槽需要20枚荣誉徽章，最多强化2个插槽。重置需要10枚。明白了吗？";
		next;
		mes "[Dylan]";
	mes "至于普隆德拉徽章，强化1个插槽需要5枚荣誉徽章，最多强化2个插槽。重置需要10枚。";
		next;
		mes "[Dylan]";
	mes "我不会随时重置。只有2个插槽都强化、无法继续强化时才会重置。而且……然后……";
		next;
		mes "[Dylan]";
	mes "不过有个问题。重置徽章时可能会损坏，概率约20%。毕竟是小物品，移除强化会有副作用。";
		next;
		mes "[Dylan]";
	mes "希望交易顺利，朋友。";
		close;
	case 2:
		mes "[Dylan]";
	mes "奉承长袍或讽刺长袍每个插槽需要20枚荣誉徽章。要强化吗？";
		break;
	case 3:
		mes "[Dylan]";
	mes "左手装备的普隆德拉徽章强化1个插槽需要5枚荣誉徽章。要强化吗？";
		break;
	case 4:
		mes "[Dylan]";
	mes "重置讽刺长袍或奉承长袍需要10枚荣誉徽章。装备不会损坏，绑定卡片和精炼等级也会保留。";
		break;
	case 5:
		mes "[Dylan]";
	mes "重置左手装备的普隆德拉徽章需要10枚荣誉徽章。";
		next;
		mes "[Dylan]";
	mes "如我所说，重置徽章很难，^ff0000成功率为80%。^000000失败的话一切都会消失。要重置吗？";
		break;
	}
	next;
	if (select( "I quit.", "Let's do it now." ) == 1) {
		mes "[Dylan]";
	mes "我很忙，别无故和我说话浪费时间。";
		close;
	}
	switch(.@s) {
	case 2:
		.@item_id = getequipid(EQI_ARMOR);
		.@refine = getequiprefinerycnt(EQI_ARMOR);
		.@card[0] = getequipcardid(EQI_ARMOR,0);
		.@card[1] = getequipcardid(EQI_ARMOR,1);
		.@card[2] = getequipcardid(EQI_ARMOR,2);
		.@card[3] = getequipcardid(EQI_ARMOR,3);

		if (.@item_id == -1) {
			mes "[Dylan]";
	mes "你把装备脱下来了。";
			close;
		}
		if (.@item_id != 15146 && .@item_id != 15147) {
			mes "[Dylan]";
	mes "别闹了。想强化的话，装备好后再来。";
			close;
		}
		if (.@card[2] > 0 && .@card[3] > 0) {
			mes "[Dylan]";
	mes "无法继续强化。还有其他要强化的吗？";
			close;
		}
		if (countitem(6919) < 20) {
			mes "[Dylan]";
	mes "朋友，没有荣誉徽章就无法和我交易。";
			close;
		}
		.@r = rand(1,961);
		if (.@r < 84) .@en_name = 4994;	// Neev_STR_1
		else if (.@r < 141) .@en_name = 4995;	// Neev_STR_2
		else if (.@r < 161) .@en_name = 4996;	// Neev_STR_3
		else if (.@r < 244) .@en_name = 4997;	// Neev_AGI_1
		else if (.@r < 301) .@en_name = 4998;	// Neev_AGI_2
		else if (.@r < 321) .@en_name = 4999;	// Neev_AGI_3
		else if (.@r < 404) .@en_name = 29000;	// Neev_INT_1
		else if (.@r < 461) .@en_name = 29001;	// Neev_INT_2
		else if (.@r < 481) .@en_name = 29002;	// Neev_INT_3
		else if (.@r < 564) .@en_name = 29003;	// Neev_DEX_1
		else if (.@r < 621) .@en_name = 29004;	// Neev_DEX_2
		else if (.@r < 641) .@en_name = 29005;	// Neev_DEX_3
		else if (.@r < 724) .@en_name = 29009;	// Neev_VIT_1
		else if (.@r < 781) .@en_name = 29010;	// Neev_VIT_2
		else if (.@r < 801) .@en_name = 29011;	// Neev_VIT_3
		else if (.@r < 884) .@en_name = 29006;	// Neev_LUK_1
		else if (.@r < 941) .@en_name = 29007;	// Neev_LUK_2
		else if (.@r < 961) .@en_name = 29008;	// Neev_LUK_3
		else .@en_name = 0;
		if (.@card[3] == 0)
			.@card_index = 3;
		else
			.@card_index = 2;

		.@card[ .@card_index ] = .@en_name;
		delitem 6919,20;
		delequip EQI_ARMOR;
		getitem2 .@item_id,1,1,.@refine,0,.@card[0],.@card[1],.@card[2],.@card[3];
		break;
	case 3:
		if (getequipid(EQI_ACC_L) == -1) {
			mes "[Dylan]";
			mes "哦，我忘了说。我只能强化装备在左手插槽的物品。请装备在左手插槽后再强化。";
			close;
		}
		if (getequipid(EQI_ACC_L) != 28356) {
			mes "[Dylan]";
			mes "别闹了。想强化的话，装备普隆德拉徽章后再来。";
			close;
		}
		.@card[2] = getequipcardid(EQI_ACC_L,2);
		.@card[3] = getequipcardid(EQI_ACC_L,3);
		if (.@card[2] > 0 && .@card[3] > 0) {// note: unslotted
			mes "[Dylan]";
			mes "无法继续强化。还有其他要强化的吗？";
			close;
		}
		if (countitem(6919) < 5) {
			mes "[Dylan]";
			mes "朋友，没有荣誉徽章就无法和我交易。";
			close;
		}
		.@r = rand(1,22231);
		if (.@r < 3001) .@en_name = 4710;		// Inteligence1
		else if (.@r < 3601) .@en_name = 4711;	// Inteligence2
		else if (.@r < 3701) .@en_name = 4712;	// Inteligence3
		else if (.@r < 3705) .@en_name = 4713;	// Inteligence4

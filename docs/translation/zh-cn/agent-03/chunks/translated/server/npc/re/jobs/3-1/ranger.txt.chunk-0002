OnTimer6000:
	mapannounce "job3_rang02","测试监督员通知：第一项测试考验视力和准确度。",bc_map,"0x87ceeb"; //FW_NORMAL 12 0 0
	end;
OnTimer9000:
	mapannounce "job3_rang02","测试监督员通知：从八个位置随机出现的怪物中，击杀名为‘波利’的怪物。",bc_map,"0x87ceeb"; //FW_NORMAL 12 0 0
	end;
OnTimer12000:
	mapannounce "job3_rang02","测试监督员通知：无论外形如何，击杀名为‘波利’的怪物才能得分，击杀其他怪物会扣分，请小心。",bc_map,"0xffb6c1"; //FW_NORMAL 12 0 0
	end;
OnTimer15000:
	mapannounce "job3_rang02","测试监督员通知：测试约持续 3 分钟。需要获得 15 分以上才能进入下一项测试。",bc_map,"0x87ceeb"; //FW_NORMAL 12 0 0
	end;
OnTimer18000:
	stopnpctimer;
	mapannounce "job3_rang02","测试监督员通知：那么测试开始。祝你好运。",bc_map,"0x87ceeb"; //FW_NORMAL 12 0 0
	donpcevent "Test Supervisor#jr_04::OnStart";
	end;
}


				mes "[Test Instructor, Teardrop]";
				mes "好。小心一点是对的。";
				mes "准备好后再回来。";
				close;
			}
			callsub L_Start,0;
			close;
		} else if (job_ranger01 == 6) {
			mes "准备出发啦！！！！！！！";
			next;
			mes "[Test Instructor, Teardrop]";
			mes "嗯？发生什么了？";
			mes "你怎么在这里闲逛？测试呢？";
			next;
			mes "[Test Instructor, Teardrop]";
			mes "啊哈……你中途失败了！";
			mes "你真是个傻瓜。";
			emotion ET_KIK;
			next;
			mes "[Test Instructor, Teardrop]";
			mes "那你打算怎么办？再试一次？";
			next;
			switch(select("等一下:去实战测试场！:我放弃转职。")) {
			case 1:
				mes "[Test Instructor, Teardrop]";
				mes "嗯？你还没准备好吗？";
				next;
				mes "[Test Instructor, Teardrop]";
				mes "好。小心一点是对的。";
				mes "准备好后再来。";
				close;
			case 2:
				callsub L_Start,1;
				close;
			case 3:
				mes "[Test Instructor, Teardrop]";
				mes "嗯？什么，你在开玩笑吧？";
				next;
				mes "[Test Instructor, Teardrop]";
				mes "再想想。";
				mes "你真的要放弃转职成为游侠吗？";
				next;
				switch(select("不，我要再试一次:我放弃！")) {
				case 1:
					mes "[Test Instructor, Teardrop]";
					mes "嘿，你果然是在开玩笑？";
					next;
					mes "[Test Instructor, Teardrop]";
					mes "一点也不好笑，别再开这种玩笑了。";
					close;
				case 2:
					mes "[Test Instructor, Teardrop]";
					mes "你没有我想象中那么有胆量。";
					nude;
					next;
					if (countitem(1703) > 0) {
						mes "[Test Instructor, Teardrop]";
						mes "好。我尊重你的意见。";
						mes "我会取消"+strcharinfo(0)+"的转职申请。";
						delitem 1703,1; //Bow__
						set job_ranger01,0;
						for(set .@i,8254; .@i<=8262; set .@i,.@i+1)
							if (checkquest(.@i) > -1) erasequest .@i;
						close;
					}
					mes "[Test Instructor, Teardrop]";
					mes "咦？我给你用于实战测试的弓呢？";
					next;
					mes "[Test Instructor, Teardrop]";
					mes "如果你不归还，我就不能取消你的转职申请。";
					close;
				}
			}
		} else if (job_ranger01 == 7) {
			mes "哦，嘿。你在这里做什么？";
			next;
			mes "[Test Instructor, Teardrop]";
			mes "因为你突然消失，游侠大师一直在找你。";
			mes "你现在要去见他吗？";
			next;
			switch(select("不去:去")) {
			case 1:
				mes "[Test Instructor, Teardrop]";
				mes "你在忙别的事吗？";
				close;
			case 2:
				mes "[Test Instructor, Teardrop]";
				mes "那我送你过去，请多保重。";
				close2;
				warp "job3_rang01",89,38;
				end;
			}
		}
		mes "哇。这是谁？";
		next;
		mes "[Test Instructor, Teardrop]";
		mes "看来你迟钝的眼神现在变得敏锐了？";
		next;
		mes "[Test Instructor, Teardrop]";
		mes "那么，作为游侠好好享受冒险吧。";
		close;
	}
	mes "准备出发啦！！！！！！！！！";
	next;
	mes "[Test Instructor]";
	mes "咦？你是谁？从哪里来的？";
	mes "别在这里无所事事地闲逛，这里是我的地盘！";
	close;
L_Start:
	if (getmercinfo(1)) {
		mes "[Test Instructor, Teardrop]";
		mes "站住！";
		next;
		mes "[Test Instructor, Teardrop]";
		mes "带着那个佣兵，你想去哪？！";
		next;
		mes "[Test Instructor, Teardrop]";
		mes "不取消佣兵就不能进入测试场！先取消它！";
		close;
	}
	if (getarg(0) == 1) {
		if (countitem(12380)) {
			mes "[Test Instructor, Teardrop]";
			mes "什、什么？这是？";
			mes "你不该把这种东西带在身上！";
			delitem 12380,countitem(12380); //Desert_Wolf_Babe_Scroll
			next;
		}
		if (countitem(12258)) {
			mes "[Test Instructor, Teardrop]";
			mes "什、什么？这是炸弹胶囊。";
			mes "你不该带这么危险的东西！";
			delitem 12258,countitem(12258); //Bombring_Box
			next;
		}
		if (countitem(6156)) {
			mes "[Test Instructor, Teardrop]";
			mes "什、什么？这些文件是什么？";
			mes "我想起来了。你要把它送给考迪恩，对吧？";
			next;
			mes "[Test Instructor, Teardrop]";
			mes "带着这种东西会影响实战测试，我先替你保管。";
			delitem 6156,countitem(6156); //Approval_Report
			next;
		}
	}
	if (Weight > 500) {
		mes "[Test Instructor, Teardrop]";
		mes "那么，我们出发吧……哦，嗯？";
		next;
		mes "[Test Instructor, Teardrop]";
		mes "嘿，你藏了什么？";
		mes "我已经提醒你好几次了，除了提供的物品，不准偷偷带其他东西进去！";
		next;
		mes "[Test Instructor, Teardrop]";
		mes "你最好减轻负重。";
		close;
	}
	mes "[Test Instructor, Teardrop]";
	mes "听好，这是最后一次警告：严禁作弊。";
	next;
	if (countitem(1750) < 100) {
		mes "[Test Instructor, Teardrop]";
		mes "好，我再给你一些箭，然后让你进去。";
		set .@arrow,1;
		next;
	}
	mes "[Test Instructor, Teardrop]";
	mes "祝你好运。";
	mes "成为游侠后我们再见。";
	set job_ranger01,6;
	if (getarg(0) == 0)
		changequest 8258,8259;
	else {
		erasequest 8260;
		erasequest 8261;
	}
	if (.@arrow) getitem 1750,100; //Arrow
	close2;
	warp "job3_rang01",30,36;
	end;
}

job3_rang01,30,44,3	script	Test Waiting Room#jr_03	88,{
	mes "[Staff DTS]";
	mes "请在实战测试等候室等待测试开始。";
	next;
	mes "[Staff DTS]";
	mes "按照进入顺序，你们可以依次参加实战测试。";
	mes "游侠转职实战测试有三种，总共大约需要 10 分钟。";
	next;
	switch(select("测试说明:取消:我放弃游侠测试")) {
	case 1:
		break;
	case 2:
		mes "[Staff DTS]";
		mes "你不需要说明吗？";
		next;
		mes "[Staff DTS]";
		mes "进入聊天室等待顺序，然后参加转职实战测试。";
		close;
	case 3:
		mes "[Staff DTS]";
		mes "请再考虑一下。";
		mes "如果在这里放弃，转职申请就会取消。你真的要放弃转职游侠吗？";
		next;
		switch(select("不，我要继续测试:我放弃游侠转职")) {
		case 1:
			mes "[Staff DTS]";
			mes "如果要继续实战测试，请进入聊天室。";
			close;
		case 2:
			mes "[Staff DTS]";
			mes "你没有我想象中那么有胆量。";
			nude;
			next;
			if (countitem(1703) > 0) {
				mes "[Staff DTS]";
				mes "好。我尊重你的意见。";
				mes "我会取消"+strcharinfo(0)+"的转职申请。";
				delitem 1703,1; //Bow__
				set job_ranger01,0;
				for(set .@i,8254; .@i<=8262; set .@i,.@i+1)
					if (checkquest(.@i) > -1) erasequest .@i;
				close;
				close2;
				warp "alberta",117,57;
				end;
			}
			mes "[Staff DTS]";
			mes "咦？我给你用于实战测试的弓呢？";
			next;
			mes "[Test Instructor, Teardrop]";
			mes "如果你不归还，我就不能取消你的转职申请。";
			close;
		}
	}
	while (1) {
		mes "[Staff DTS]";
		mes "我来说明游侠转职实战测试。";
		mes "第一、第二、第三项实战测试中，你想了解哪一项？";
		next;
		switch(select("第一项测试:第二项测试:第三项测试:取消")) {
		case 1:
			mes "[Staff DTS]";
			mes "第一项测试你的视力和准确度。";
			next;
			mes "[Staff DTS]";
			mes "怪物会从玩家上下左右八个方向随机出现，击杀其中名为‘波利’的怪物即可得分。";
			next;
			mes "[Staff DTS]";
			mes "^0000ff无论外形如何，都必须击杀名为‘波利’的怪物才能得分；击杀其他怪物会扣分，请小心。^000000";
			next;
			mes "[Staff DTS]";
			mes "第一项测试约持续 3 分钟。20 个目标中获得 15 分以上即可进入第二项测试场。";
			next;
			break;
		case 2:
			mes "[Staff DTS]";
			mes "第二项测试考验任务执行能力和陷阱的有效使用。";
			next;
			mes "[Staff DTS]";
			mes "考生会得到 10 个‘炸弹胶囊’。使用后附近会召唤炸弹怪，经过一段时间后炸弹怪会爆炸。";
			next;
			mes "[Staff DTS]";
			mes "^0000ff炸弹怪爆炸会伤害你，请小心别被波及。你必须使用炸弹胶囊消灭怪物、完成任务并活着出来。^000000";
			next;
			mes "[Staff DTS]";
			mes "第二项测试约持续 3 分钟。用完所有炸弹胶囊、收集隐藏装备并存活下来，就会被送往第三项测试场。";
			next;
			break;
		case 3:
			mes "[Staff DTS]";
			mes "第三项测试考验你如何有效使用游侠获得的狼。";
			next;
			mes "[Staff DTS]";
			mes "考生会得到一次性狼笛。操控召唤的狼，清除散落各处的炸弹即可得分。";
			next;
			mes "[Staff DTS]";
			mes "^0000ff测试期间考生不能移动，只能使用狼，在规定时间内快速准确地清除炸弹才算完成测试。^000000";
			next;
			mes "[Staff DTS]";
			mes "第三项测试约持续 3 分钟，20 个目标中获得 10 分以上即可完成全部实战测试。";
			next;
			break;
		case 4:
			mes "[Staff DTS]";
			mes "要开始实战测试，请进入聊天室。";
			close;
		}
	}
	end;
OnInit:
	waitingroom "Practical Test Waiting Room",20,"Test Waiting Room#jr_03::OnStartArena",1;
	enablewaitingroomevent;
	end;
OnStartArena:
	warpwaitingpc "job3_rang02",45,48;
	donpcevent "Test Supervisor#jr_04::OnEnable";
	disablewaitingroomevent;
	end;
OnEnable:
	enablewaitingroomevent;
	end;
OnDisable:
	disablewaitingroomevent;
	end;
}

job3_rang02,100,95,0	script	Test Supervisor#jr_04	139,{
OnInit:
	set $@job_rang_point01,0;
	disablenpc "Test Supervisor#jr_04";
	end;
OnEnable:
	enablenpc "Test Supervisor#jr_04";
	set $@job_rang_point01,0;
	initnpctimer;
	end;
OnDisable:
	stopnpctimer;
	disablenpc "Test Supervisor#jr_04";
	end;
OnStart:
	stopnpctimer;
	donpcevent "CallCorrectAnswer#jr::OnEnable";
	donpcevent "CallWrongAnswer#jr::OnEnable";
	donpcevent "First Test Timer#jr_05::OnEnable";
	disablenpc "Test Supervisor#jr_04";

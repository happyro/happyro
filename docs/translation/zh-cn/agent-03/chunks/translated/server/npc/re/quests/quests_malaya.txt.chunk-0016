malaya,210,200,5	script	Dr. Boon#ma	865,{
	if (malaya_hi < 20) {
		mes "[Dr. Boon]";
		mes "……";
		next;
		mes "他似乎对你非常戒备。";
		close;
	}
	if (malaya_bang == 9) {
		mes "[Dr. Boon]";
		mes "所以~你就是新护士？";
		next;
		switch(select("是。:不是。")) {
		case 1:
			mes "[Dr. Boon]";
			mes "对护士来说，没有什么比白色制服更重要。";
			mes "去换衣服！";
			close;
		case 2:
			mes "[Dr. Boon]";
			mes "哦！抱歉。";
			mes "我们在等一位新护士。";
			mes "是我的错。";
			next;
			select("说明情况。");
			mes "[Dr. Boon]";
			mes "啊~";
			mes "原来是这样。";
			mes "哎呀，我想这是个误会。";
			next;
			mes "[Dr. Boon]";
			mes "你看，医院出事后，我一直在旅馆为病人治疗。";
			next;
			mes "[Dr. Boon]";
			mes "即便如此，我还是要为让她在那里站了这么久道歉。";
			next;
			mes "[Dr. Boon]";
			mes "我现在不能离开，因为还有病人要照顾。你去把这把钥匙交给她吧？";
			next;
			mes "[Dr. Boon]";
			mes "把钥匙交给她时，再转告她：'由你自行决定'。";
			next;
			mes "[Dr. Boon]";
			mes "我处理完这里的事就过去。";
			mes "祝你好运~";
			set malaya_bang,10;
			changequest 11291,11292;
			close;
		}
	} else if (malaya_bang == 10) {
		mes "[Dr. Boon]";
		mes "我现在不能离开，因为还有病人要照顾。你去把这把钥匙交给她吧？";
		next;
		mes "[Dr. Boon]";
		mes "把钥匙交给她时，再转告她：'由你自行决定'。";
		next;
		mes "[Dr. Boon]";
		mes "我处理完这里的事就过去。";
		mes "祝你好运~";
		close;
	} else {
		mes "[Dr. Boon]";
		mes "*叹气*";
		mes "工作……永远做不完……";
		mes "我一个人该怎么照顾这么多病人？";
		next;
		mes "[Dr. Boon]";
		mes "什么？医生为什么会在旅馆里？";
		mes "嗯，有什么不可以？";
		close;
	}
}

malaya,53,68,4	script	Bushes#ma	844,{
	if (malaya_bang < 13) {
		mes "只是一丛灌木。";
		mes "摇晃时会散发出甜甜的木香。";
		close;
	}
	if (malaya_bang == 13) {
		mes "[???]";
		mes "别再靠近了！";
		mes "老"+((Sex == SEX_MALE)?"先生":"女士")+"！";
		mes "你怎么知道我在这里？";
		emotion ET_HUK;
		next;
		mes "["+strcharinfo(0)+"]";
		mes "我不老。";
		emotion ET_FRET, playerattached();
		next;
		switch(select("关于进入医院。:关于它的妈妈。:关于???。:询问老妇人。:询问医院周围。:放弃。")) {
		case 1:
			mes "[???]";
			mes "几天前，住在我们附近的老妇人在医院周围把某种棍子插进地面。";
			next;
			mes "[???]";
			mes "她一边自言自语，一边不停地四处张望。";
			next;
			mes "[???]";
			mes "我藏在这里，因为我本来不该来这里。";
			next;
			break;
		case 2:
			mes "[???]";
			mes "妈妈曾经告诉过我。";
			mes "老妇人的女儿曾在这里住院。";
			next;
			mes "[???]";
			mes "但她再也没能出来……";
			next;
			mes "[???]";
			mes "她不是唯一一个。医院里发生过很多奇怪的事。";
			next;
			mes "[???]";
			mes "所以妈妈不想让我来这里。";
			next;
			break;
		case 3:
			mes "[???]";
			mes "绝对不行！";
			mes "上次我在这里被抓到时挨了打！";
			next;
			mes "[???]";
			mes "如果再被抓到，就不只是挨打了……";
			mes "好可怕。";
			next;
			break;
		case 4:
			mes "[???]";
			mes "就是住在我们隔壁的那位女士。";
			next;
			mes "[???]";
			mes "几天前我看到她在医院附近做什么。";
			next;
			mes "[???]";
			mes "我在这里看不清她在做什么，但她离开后我在那里发现了一些棍子。";
			set malaya_bang,14;
			changequest 11294,11295;
			close;
		case 5:
			mes "[???]";
			mes "不知道。";
			mes "除了那些棍子，没有什么不同。";
			next;
			mes "[???]";
			mes "老妇人偶尔会回来查看那些棍子。";
			mes "那时候我的心跳得可快了！";
			next;
			break;
		case 6:
			mes "[???]";
			mes "哼！！";
			emotion ET_HNG;
			close;
		}
		mes "[???]";
		mes "答应我，你不会告诉任何人见过我！！！";
		mes "答应我？！";
		close;
	} else if (malaya_bang == 14) {
		mes "[???]";
		mes "我在这里看不清她在做什么，但她离开后我在那里发现了一些棍子。";
		close;
	} else if (malaya_bang == 15) {
		mes "[???]";
		mes "别再靠近了！";
		mes "老"+((Sex == SEX_MALE)?"先生":"女士")+"！";
		mes "你怎么知道我在这里？";
		emotion ET_HUK;
		next;
		mes "["+strcharinfo(0)+"]";
		mes "我不老。";
		emotion ET_FRET, playerattached();
		close;
	} else {
		mes "这里有年幼孩子留下的痕迹。";
		mes "我想孩子现在已经回家了。";
		close;
	}
}

-	script	Suspicious Wooden Stick::MalayaStick	-1,{
	if (checkweight(1201,1) == 0) {
		mes "- Wait !! -";
		mes "- You have too many items. -";
		mes "- Cannot receive item. -";
		mes "- Please lighten your bag -";
		mes "- and try again. -";
		close;
	}
	if (MaxWeight - Weight < 1000) {
		mes "- Wait !! -";
		mes "- You are carrying too many items. -";
		mes "- Cannot receive item. -";
		mes "- Please lighten your bag -";
		mes "- and try again. -";
		close;
	}
	if (malaya_bang == 14) {
		mes "地上插着一根奇怪的棍子。";
		mes "可以感觉到神秘的力量。";
		next;
		switch(select("拔出来。:别管它。")) {
		case 1:
			if (rand(1,5) == 4) {
				mes "拔出了深深插入地面的棍子。";
				mes "医院似乎变得更加阴森了。";
				if (rand(2)) {
					set malaya_bang,15;
					changequest 11295,11296;
					getitem 6497,1; //Lesser_Agimat
					donpcevent "Tent"+replacestr(strnpcinfo(3),"MalayaStick","")+"#ma::OnEnable";
					next;
					mes "最好把护身符拿给Las看看。";
					close;
				} else {
					getitem 6497,1; //Lesser_Agimat
					donpcevent "Tent"+replacestr(strnpcinfo(3),"MalayaStick","")+"#ma::OnEnable";
					close;
				}
			} else {
				mes "拔出深深插入地面的棍子后，一阵不安涌上心头。";
				donpcevent "Tent"+replacestr(strnpcinfo(3),"MalayaStick","")+"#ma::OnEnable";
				close;
			}
		case 2:
			mes "看起来不祥，最好别碰它。";
			close;
		}
	} else {
		mes "这里有一根外形奇怪的棍子。";
		close;
	}
	end;
OnEnable:
	enablenpc strnpcinfo(3); // NPC name is too long for strnpcinfo(0).
	end;
OnDisable:
	disablenpc strnpcinfo(3);
	end;
}

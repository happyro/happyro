		mes "现在我得把好消息传出去！你能把她带到镇中心的旅馆吗？";
		next;
		mes "[Village Man]";
		mes "医生就住在那里。";
		mes "医院关闭后，他一直住在那里。";
		close;
	} else {
		mes "[Village Man]";
		mes "好耶！";
		mes "你是冒险者吗？";
		mes "有时间的话，来看看我的菠萝农场。";
		next;
		mes "[Village Man]";
		mes "只是一点点远~";
		mes "离村子有点远，但只要你讲个好故事，我就给你想要的所有菠萝！";

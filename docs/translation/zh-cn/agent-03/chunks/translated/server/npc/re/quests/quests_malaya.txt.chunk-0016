		next;
		mes "[Nurse Las]";
		mes "不不不！";
		mes "你还带着那些烦人的护身符！！！";
		next;
		mes "[Nurse Las]";
		mes "今天是你的幸运日！";
		mes "*窃笑*";
		set malaya_bang,36;
		changequest 11307,11308;
		close2;
		cutin "",255;
		warp "malaya",58,76;
		end;
	} else if (malaya_bang > 35) {
		mes "感觉不到护身符上有任何邪恶气息。";
		mes "只剩下被Las戏弄的苦涩滋味……";
		close;
	} else {
		mes "感觉不到任何力量。";
		close;
	}
}


			}
		case 2:
			mes "[Laichin]";
			mes "随便你，伙计！";
			mes "真是个吝啬鬼……";
			emotion ET_HNG;
			close;
		}
	}
	else if (sign_q < 105) {
		mes "对了，呃，我忘了告诉你，安格尔波达的灵魂碎片被神之力封印着，不能直接砸开。";
		next;
		mes "[Laichin]";
		mes "……或者你也可以试试。";
		mes "总之，最好准备一把坚固、沉重而强力的武器。";
		next;
		mes "[Laichin]";
		mes "不过想想看，破坏神之封印意味着什么。";
		mes "记住，必须遵守神明施加的^FF0000某种规则^000000，";
		mes "才能释放安格尔波达的灵魂。";
		next;
		mes "[Laichin]";
		mes "对了，如果想尝试用不同武器破坏封印，";
		mes "确保武器在背包里且没有装备，好吗？";
		next;
		switch(select("谢谢～！:我该再去哪里？")) {
		case 1:
			mes "[Laichin]";
			mes "哦不……";
			mes "谢谢你给的这些 Zeny！";
			mes "金钱也许买不到幸福，";
			mes "但它确实非常接近幸福！";
			close;
		case 2:
			mes "[Laichin]";
			mes "嘿……你得去古城最底层，";
			mes "在那里找到安格尔波达的全部灵魂碎片。";
			mes "到那里之后……";
			next;
			mes "[Laichin]";
			if (sign_q == 101) {
				mes "查看大范围的 1 点钟、5 点钟、7 点钟位置，";
				mes "以及小范围的 6 点钟位置。";
			}
			else if (sign_q == 102) {
				mes "查看大范围的 4 点钟、10 点钟，";
				mes "小范围的 6 点钟，以及极小范围的 11 点钟位置。";
			}
			else if (sign_q == 103) {
				mes "查看大范围的 5 点钟，";
				mes "小范围的 11 点钟、6 点钟，";
				mes "以及极小范围的 11 点钟位置。";
			}
			else if (sign_q == 104) {
				mes "查看大范围的 4 点钟、5 点钟、10 点钟，";
				mes "以及小范围的 11 点钟位置。";
			}
			mes "按这个顺序破坏封印，明白了吗？";
			next;
			mes "[Laichin]";
			mes "大、小和极小指的是距离地图中心的远近。";
			mes "大就是靠近地图边缘。很简单吧？";
			next;
			mes "[Laichin]";
			mes "我说小范围时，你要找比地图边缘更靠内的区域。";
			mes "极小范围则要找靠近中心的地方。明白了吗？";
			close;
		}
	}
	else if (sign_q < 150) {
		mes "伙计，尼弗海姆真棒。";
		mes "简直比那个无聊的老阿斯加德";
		mes "好上一百万倍。没错！";
		next;
		mes "[Laichin]";
		mes "呃，我甚至不想知道你是否找到了安格尔波达的全部灵魂碎片。";
		mes "但如果你找到了，别把它们带到我附近。";
		mes "要是神明发现你拥有它们……";
		next;
		mes "[Laichin]";
		mes "不过姑且假设你真的集齐了。";
		mes "那样的话，你应该立刻把安格尔波达的灵魂交给地狱女王，明白吗？";
		next;
		mes "[Laichin]";
		mes "哦……但不是随便什么人都能走到她面前。";
		mes "最好交给她真正信任的侍从。";
		mes "他叫什么来着？";
		next;
		mes "[Laichin]";
		mes "我知道他总是伪装成某种^666666非常忧郁的人^000000，";
		mes "我怎么也想不起他的名字，但他应该就在附近……";
		close;
	}
	else if (sign_q == 200) {
		mes "哇……";
		mes ".................";
		mes "我的脑袋疼死了。";
		close;
	}
	else {
		mes "哇……";
		mes ".................";
		close;
	}
}

niflheim,348,257,1	script	#Cursed Soul	-1,1,1,{
OnTouch_:
	callfunc "F_UpdateSignVars";
	if ((sign_q == 83) || (sign_q == 90)) {
		if (sign_sq == 0) {
			killmonster "niflheim","#Cursed Soul::OnMyMobDead";
			mes "[Ashe Bruce]";
		mes "现在离开，否则我会强行把你赶走……";
			next;
			mes "[Ashe Bruce]";
		mes "……还有……";
		mes "……无论你做什么……";
		mes "……都不要碰我的书……";
			next;
		switch(select("拿起第 1 本书。:拿起第 2 本书。:拿起第 3 本书。:立刻离开。")) {
			case 1:
				monster "niflheim",349,259,"Rideword",1478,1;
				mes "[Ashe Bruce]";
				mes "...!...";
				mes "我明明特别说过‘别碰我的书！’";
				next;
				mes "[Ashe Bruce]";
				mes "....!...Grrrrr!";
				mes "我要把你撕碎……！";
				mes "承受永恒的诅咒吧……！";
				close;
				break;
			case 2:
				mes "[Ashe Bruce]";
				mes "...!...";
				mes "你竟敢碰我的书？！";
				mes "我才刚说过不许碰它们……？！";
				mes "愚蠢的凡人！";
				mes "……滚开！";
				close;
				warp "niflheim",34,162;
				break;
			case 3:
				mes "[Ashe Bruce]";
				mes "呜哈哈哈哈……";
				mes "顽固的凡人～！";
				mes "好吧！我给你一个战斗机会，";
				mes "让你施放法术。";
				next;
				if (select("三叶草:克拉图:克莱托斯") == 2) set .@spell,.@spell+1;
				if (select("维里特:维里塔斯:维拉塔") == 3) set .@spell,.@spell+1;
				if (select("领带:项链:尼禄:^FFFFFF尼克图^000000") == 4) set .@spell,.@spell+1;
				if (.@spell == 3) {
					if (rand(1,5) == 5) {
						mes "[Ashe Bruce]";
						mes "那是正确的法术！";
						mes "但什么也没发生。真疯狂！";
						close;
					}
					else {
						mes "[Ashe Bruce]";
						mes "那个法术……";
						mes "你解除了我的诅咒？";
						mes "难以置信。我自由了！";
						next;
						mes "[Ashe Bruce]";
						mes "但别低估我强大的力量！";
						mes "事实上，我命令你拿上这本书，";
						mes "把它交给那个弱小可悲的女巫！";
						if (sign_q == 83) {
							if(sign_sq == 0) {
								set sign_sq,1;
								getitem 7304,1; //Witch's_Spell_Book
							}
						}
						else if (sign_q == 90) {
							set sign_q,91;
							getitem 7304,1; //Witch's_Spell_Book
						}
						close;
					}
				}
				else {
					monster "niflheim",345,259,"Orc Skeleton",1462,1,"#Cursed Soul::OnMyMobDead";
					monster "niflheim",347,261,"Orc Skeleton",1462,1,"#Cursed Soul::OnMyMobDead";
					monster "niflheim",344,253,"Orc Skeleton",1462,1,"#Cursed Soul::OnMyMobDead";
					monster "niflheim",346,251,"Orc Skeleton",1462,1,"#Cursed Soul::OnMyMobDead";
					monster "niflheim",349,249,"Orc Skeleton",1462,1,"#Cursed Soul::OnMyMobDead";
					monster "niflheim",350,260,"Orc Skeleton",1462,1,"#Cursed Soul::OnMyMobDead";
					monster "niflheim",353,256,"Orc Skeleton",1462,1,"#Cursed Soul::OnMyMobDead";
					mes "[Ashe Bruce]";
					mes "呜哈哈哈哈哈！";
					mes "那不是正确的法术！";
					mes "现在，死亡在等待你！";
					close;
				}
			case 4:
				mes "[Ashe Bruce]";
				mes "那好吧。";
				mes "赶着离开时可别被自己的脚绊倒。";
				close;
			}
		}
	}
	end;

OnMyMobDead:
	end;
}

nif_in,102,81,1	script	#Crayu	-1,1,1,{
OnTouch_:
	callfunc "F_UpdateSignVars";
	if (sign_q < 75) end;
	else if (sign_q < 82) {
		mes "[Crayu]";
		mes "山中夕阳向西落，紫色暮色降临，";
		mes "被优美旋律环绕。";
		mes "^你成为无视主人的钥匙";
		close;
	}
	else if (sign_q == 86) {
		mes "[Crayu]";
		mes "山中夕阳向西落，紫色暮色降临，";
		mes "被优美旋律环绕。";
		mes "你成为无视主人的钥匙。";
		next;
		mes "[Crayu]";
		mes "你好，冒险者。";
		mes "我知道这有些突然，";
		mes "但你怎么看 Serin？";
		next;
		select("她是好人。:她是坏人！:她可能两面都有。");
		mes "[Crayu]";
		mes "嗯……？";
		mes "你为什么这么想？";
		next;
		switch(select("只是我的看法。:这是事实！")) {
		case 1:
			if (sign_sq > 1) set sign_sq,0;
			else set sign_sq,sign_sq+1;
		case 2:
			break;
		}
		mes "[Crayu]";
		mes "啊，我明白了。";
		mes "现在我能如何帮助你？";
		next;
		switch(select("尼弗海姆究竟是什么？:我怎样才能成为被选中的人？")) {
		case 1:
			mes "[Crayu]";
			mes "尼弗海姆通常被称为死者之城，";
			mes "也是没能进入英灵殿的战士";
			mes "安息之地。";
			next;
			mes "[Crayu]";
			mes "有些英雄可能把尼弗海姆视为悲惨终点，";
			mes "但这完全取决于你的看法。";
			close;
		case 2:
			mes "["+strcharinfo(0)+"]";
			mes "我需要做什么，才能成为";
			mes "被选中的战士？";
			next;
			mes "[Crayu]";
			mes "首先，你必须证明自己的勇气。";
			mes "由你决定如何展现勇敢，";
			mes "神明只会在旁观察和评判。";
			next;
			mes "[Crayu]";
			mes "嗯……";
			mes "我觉得你最好去和尼弗海姆名为^FF0000Gen^000000的人谈谈。";
			set sign_q,87;
			close;
		}
	}
	else if (sign_q == 86) {
		mes "嗯……";
		mes "我觉得你最好去和尼弗海姆名为^FF0000Gen^000000的人谈谈。";
		close;
	}
	end;
}

nif_in,156,91,1	script	#kidniff	-1,1,1,{
OnTouch_:
	callfunc "F_UpdateSignVars";
	if (sign_q == 83) {
		if (sign_sq == 0) {
			mes "[Alakina Ann]";
			mes "^333333*Cries*^000000";
			mes "我在哪里？";
			mes "我……我想回家～";
			emotion ET_CRY;
			close;
		}
		else if (sign_sq == 1) {
			mes "[Alakina Ann]";
			mes "你、你能帮我回家吗？求求你！";
			mes "我想念爸爸妈妈，";
			mes "而且不知道自己怎么来到这里的。";
			mes "^333333*Sniff*^000000";
			next;
			switch(select("我能做什么？:你回不去了……")) {
			case 1:
				mes "[Alakina Ann]";
				mes "我不知道。我、我觉得是一个唱歌的人让我去见女巫，";
				mes "但外面太可怕了……";
				set sign_sq,2;
				close;
			case 2:
				mes "[Alakina Ann]";
				mes "^333333*Sniff*^000000";
				mes "不、不要……";
				mes "我想回家……";
				close2;
				emotion ET_CRY;
				end;
			}
		}
		else if (sign_sq == 2) {
			mes "[Alakina Ann]";
			mes "^333333*Cries*^000000";
			mes "我在哪里？";
			mes "我……我想回家～";
			emotion ET_CRY;
			close;
		}
		else if ((sign_sq == 3) || (sign_sq == 4)) {
			if (countitem(7309) > 0) {
				mes "[Alakina Ann]";
				mes "我……我可以用这个回家？";
				mes "谢谢你！真的太谢谢你了！";
				delitem 7309,countitem(7309); //Wing_Of_Crow
				set sign_sq,5;
				close;
			}
			else {
				mes "[Alakina Ann]";
				mes "我要怎么找到那个女巫？";
				mes "只有她知道怎样";
				mes "才能让我回家……";
				mes "^333333*Cries*^000000";
				emotion ET_CRY;
				close;
			}
		}
		else if (sign_sq == 5) {
			mes "[Alakina Ann]";
			mes "你、你骗我！";
			mes "这片翅膀根本没用！我、我还在这个可怕的地方！^333333*哭泣*^000000";
			set sign_sq,6;
			emotion ET_CRY;
			close;
		}
		else {
			mes "[Alakina Ann]";
			mes "你说过能帮我回家，";
			mes "却一点忙也没帮上。你、你骗我！";
			mes "我……我讨厌你！^333333*呜哇～！*^000000";
			emotion ET_CRY;
			close;
		}
	}
	else {
		mes "[Alakina Ann]";
		mes "^333333*Cries*^000000";
		mes "我在哪里？";
		mes "我……我想回家～";
		emotion ET_CRY;
		close;
	}
	end;
}


1@bamn,333,141,7	script(DISABLED)	Intruder#sweety03	4_EP17_SWEETY,{
	if ('twilight_story == 17) {
		setpcblock PCBLOCK_NPC, true;
		'twilight_story = 18;
		npctalk "什么，其他人去哪了？";
		sleep2 2000;
		npctalk "是你做的吗？";
		sleep2 2000;
		npctalk "你挺厉害的，对吧？";
		sleep2 2000;
		npctalk "Repeater : (... .. ..)", instance_npcname("Repeater#wifi02");
		npctalk "哦，有消息。先在那里待一会儿。好的，你好。";
		sleep2 2000;
		npctalk "Repeater : (... ??... ??)", instance_npcname("Repeater#wifi02");
		sleep2 2000;
		npctalk "现在？再多一点时间……是，不……啊……";
		sleep2 2000;
		npctalk "……到目前为止……不？！……好吧……";
		sleep2 2000;
		emotion ET_THINK;
		sleep2 2000;
		npctalk "你！就是你让我现在没时间！下次见面我会杀了你！";
		sleep2 2000;
		disablenpc();
		enablenpc instance_npcname("Est#est04");
		for ( .@i = 5; .@i < 9; ++.@i )
			enablenpc instance_npcname("Rebellion#md_rb0" + .@i);
		for ( .@i = 0; .@i < 3; ++.@i )
			enablenpc instance_npcname("Heart Hunter#md_hh1" + .@i);
		setpcblock PCBLOCK_NPC, false;
	}
	end;
}

1@bamq,32,49,3	script(DISABLED)	Sweety#sweety_boss	4_EP17_Sweety,{
	if ('sweety == 0) {
		cutin "ep172_Sweety01",2;
		mes "[Sweety]";
		mes "嘿，准备好了吗？";
		mes "随时来挑战我。";
		mes "打败你后我一定会感觉好些。";
		next;
		if (select( "等一会儿。", "走吧！" ) == 1) {
			mes "[Sweety]";
			mes "什么，你来这里探索花园吗？";
			mes "心脏猎人不知道我身上发生了什么，但……";
			next;
			cutin "ep172_Sweety02",2;
			mes "[Sweety]";
			mes "什么，为什么？";
			mes "我和他们完全不同，我是优秀的生物！";
			mes "老师们也是这么说的。";
			mes "不过，那些家伙只是一群失败者。";
			close3;

		}
		cutin "",255;
		npctalk "这次我不会输给你！";
		disablenpc();
		donpcevent instance_npcname("twilight_daily") + "::OnStart";
		'sweety = 1;
		close;
	}
	specialeffect EF_NPC_STOP;
	mes "他对任何事都没有反应。";
	mes "我想他被我的攻击打晕了。";
	npctalk "... ...";
	close;
}


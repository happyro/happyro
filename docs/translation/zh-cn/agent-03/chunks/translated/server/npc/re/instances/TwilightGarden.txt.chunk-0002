1@bamq,37,59,3	script(DISABLED)	Almond#amond02	EP17_2_BETA_BASIC,{
	if ('sweety < 2) {
		cutin "ep172_beta",2;
		mes "[Almond]";
		mes "我无法理解。";
		mes "为什么Sweety喜欢把身体逼到极限……";
		next;
		mes "[Almond]";
		mes "而修复他受损的身体是我的工作。";
		mes "请把他打到满意为止。";
		close3;
	}
	cutin "ep172_beta",2;
	mes "[Almond]";
	mes "我会负责搬运Sweety。";
	mes "现在要结束吗？";
	next;
	if (select( "结束吧。", "我先探索花园。" ) == 2) {
		mes "[Almond]";
		mes "外面还有入侵者。";
		mes "你知道吗？";
		close3;
	}
	mes "[Almond]";
	mes "那么，走吧？";
	close2;
	warp "ba_in01",18,255;
	end;
}



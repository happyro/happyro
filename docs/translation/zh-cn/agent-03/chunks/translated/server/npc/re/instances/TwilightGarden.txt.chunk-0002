// Daily quest
1@bamn,150,47,3	script	#bam_body01	4_EP17_BROKENBETA,{
	if (isbegin_quest(18024) == 1) {
		if (checkweight(1000226,1) == 0) {	// (custom)
			mes "^008800等一下！！";
			mes "你携带的物品太多，无法领取更多物品。减轻负重后再试。^000000";
			close;
		}
		.@id = atoi(replacestr(strnpcinfo(2), "bam_body0", ""));

		if ('broken_beta[.@id] == 0) {
			mes "Beta管理员的身体藏在地面下。";
			next;
			if (rand(1,10) < 5)
				mes "核心槽是空的。";
			else {
				mes "我找回了核心。";
				getitem 1000226,1;
			}
			mes "稍后我会告诉Alpha，让她取回玩偶的身体。";
			'broken_beta[.@id] = 1;
		}
	}
	mes "核心部件是空的。";
	close;

OnInstanceInit:
	questinfo( QTYPE_CLICKME, QMARK_YELLOW, "isbegin_quest(18024) == 1" );
	end;
}

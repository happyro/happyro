splendide,183,117,4	script	Tired-looking Fairy	438,{
	if (!isequipped(2782)) {
		mes "[Tired-looking Fairy]";
		mes "VeOsaRiveh No ModAsh";
		next;
		mes "- You can't understand the fairy's words. -";
		mes "- You need something to help you interpret them. -";
		close;
	}
	if (ep14_1_bs < 4) {
		mes "[Tired-looking Fairy]";
		mes "我很累，别和我说话。";
		close;
	} else if (ep14_1_bs < 10) {
		if (checkquest(11187) == -1) {
			if(!isbegin_quest(11186)) { // TODO: Confirm official dialog (is there one?)
				mes "[Tired-looking Fairy]";
				mes "我很累，别和我说话。";
				close;
			}
			mes "[Tired-looking Fairy]";
			mes "我很累，别和我说话。";
			next;
			select("展示小袋子。");
			mes "[Tired-looking Fairy]";
			mes "啊？！";
			mes "你从哪里得到的？！";
			next;
			select("我在灌木丛里找到的。");
			mes "[Tired-looking Fairy]";
			mes "它看起来不起眼，但对我们来说是重要物品。我想我应该道谢。";
			next;
			mes "[Tired-looking Fairy]";
			mes "不过只凭这个小袋子，很难找到它的主人……";
			changequest 11186,11187;
			next;
			if(select("我想我见过可能是主人的妖精。:让我想想。") == 2) {
				mes "[Tired-looking Fairy]";
				mes "那你想起什么就告诉我。";
				close;
			}
		} else if (checkquest(11187) == 2) {
			mes "[Tired-looking Fairy]";
			mes "希望你能找到主人。";
			close;
		}
		mes "[Tired-looking Fairy]";
		mes "你记得那只妖精长什么样吗？";
		next;

		setarray .@Hair$[0],"金色","草绿色","木棕色","海蓝色";
		setarray .@Skin$[0],"深色","浅色";
		setarray .@Clothing$[0],"雪白","葡萄色","天蓝色","草绿色";
		setarray .@Wings$[0],"圆形","两对","特征明显的";

		setarray .@i[1],
			select("金色头发:草绿色头发:木棕色头发:海蓝色头发"),
			select("深色皮肤:浅色皮肤"),
			select("雪白服装:葡萄色服装:天蓝色服装:草绿色服装"),
			select("圆形翅膀:两对翅膀:特征明显的翅膀");

		set .@i[0], (1 << .@i[1]) | (1 << (.@i[2]+4)) | (1 << (.@i[3]+6)) | (1 << (.@i[4]+10));

		mes "[Tired-looking Fairy]";
		mes "一只皮肤"+.@Skin$[.@i[2]-1]+"、"+.@Hair$[.@i[1]-1]+"头发、"+.@Wings$[.@i[4]-1]+"翅膀，穿着"+.@Clothing$[.@i[3]-1]+"服装的妖精……";
		switch(.@i[0]) {
		case 4418: // Kusmi: blonde hair, light skin, grape clothing, two pairs of wings
			mes "嗯……那一定是Kusmi。";
			next;
			mes "[Tired-looking Fairy]";
			mes "Kusmi应该在村子东南方一带游荡。";
			mes "去看看她是不是丢了小袋子。";
			if (ep14_1_bs2 == 7)
				set ep14_1_bs2,10;
			close;
		case 2212: // Theodore: grassy-green hair, dark skin, snow-white clothing, round wings
			mes "嗯……那一定是Theodore。";
			next;
			mes "[Tired-looking Fairy]";
			mes "Theodore应该在村子东北方一带游荡。";
			mes "去看看他是不是丢了小袋子。";
			if (ep14_1_bs2 == 8)
				set ep14_1_bs2,11;
			close;
		case 9264: // Pauchon: sea-blue hair, dark skin, grassy-green clothing, characteristic wings
			mes "嗯……那一定是Pauchon。";
			next;
			mes "[Tired-looking Fairy]";
			mes "Pauchon应该在村子北方一带游荡。";
			mes "去看看她是不是丢了小袋子。";
			if (ep14_1_bs2 == 9)
				set ep14_1_bs2,12;
			close;
		default:
			next;
			mes "[Tired-looking Fairy]";
			mes "嗯……";
			mes "我不记得见过这样的妖精。";
			mes "你确定自己没有弄错？";
			mes "再试着回忆一下。";
			close;
		}
	}
	mes "[Tired-looking Fairy]";
	mes "怎么了？";
	mes "你找到小袋子的主人了吗？";
	close;
}

splendide,119,138,4	script	Kusmi#ep14_1_bs	440,{
	if (!isequipped(2782)) {
		mes "[Kusmi]";
		mes "DimFusTal Mu Lars";
		mes "ModAnduLo";
		mes "Mod";
		mes "DorDuMe U NohLarsFulo Mu Fus";
		next;
		mes "- You can't understand the fairy's words. -";
		mes "- You need something to help you interpret them. -";
		close;
	}
	if (ep14_1_bs > 3 && ep14_1_bs < 10) {
		mes "[Kusmi]";
		mes "你是谁呀？";
		next;
		select("展示小袋子。");
		if (countitem(6390) == 0) {
			mes "[Kusmi]";
			mes "你想给我看什么呀？";
			close;
		}
		if (ep14_1_bs2 == 10) {
			mes "[Kusmi]";
			mes "啊！！";
			mes "我的小袋子！！！！！";
			mes "谢谢你！！！！！";
			mes "我一直在到处找它！";
			next;
			select("询问传闻。");
			mes "[Kusmi]";
			mes "这是个很难的问题！";
			mes "不过你找回了我的小袋子，所以我必须回答……";
			next;
			mes "[Kusmi]";
			mes "答应我不要告诉任何人！";
			mes "如果你能保证，就再来和我谈谈。";
			delitem 6390,1; //Small_Pocket
			set ep14_1_bs,10;
			changequest 11187,11188;
			close;
		} else {
			mes "[Kusmi]";
			mes "嗯，我不知道是谁，但会把小袋子这样丢掉，一定是个邋遢鬼。";
			mes "嗯？我的？";
			mes "不，我的不是好好在这里吗？";
			next;
			mes "[Kusmi]";
			mes "这是珍贵的物品，希望你能找到它的主人。";
			close;
		}
	}
	if (ep14_1_bs2 == 10) {
		if (ep14_1_bs == 10) {
			mes "[Kusmi]";
			mes "你不能把这件事告诉任何人，好吗~？";
			mes "最近，";
			mes "我们从大陆得到的补给中断了！";
			mes "或者说，补给路线被封锁，我们拿不到补给了？";
			next;
			mes "[Kusmi]";
			mes "我们必须在储存的物资用完前找到足够食物，所以一直在翻找灌木丛。";
			next;
			mes "[Kusmi]";
			mes "但这片被诅咒的冰冻土地没有好吃的食物。";
			mes "我们勉强用魔法维持绿色，但制造果实需要太多力量。";
			next;
			mes "[Kusmi]";
			mes "制造食物消耗的能量，可能是食用后获得能量的两倍。";
			mes "上层人士不愿承认，但这很快会成为严重问题。";
			next;
			mes "[Kusmi]";
			mes "因为正在交战，我们不能离开战场，所以无法去查看。";
			mes "我很好奇……";
			next;
			mes "[Kusmi]";
			mes "不只是我，许多Laphine也很担心。";
			mes "情况就是这样，所以如果你在灌木丛里遇到Laphine，请不要和他说话。";
			mes "太丢脸了！！！";
			next;
			mes "[Kusmi]";
			mes "哦，还有，今天发生的事绝对不能告诉任何人！";
			mes "除非那个人愿意帮助我们……把消息传出去对Splendide没有好处。";
			set ep14_1_bs,11;
			completequest 11188;
			setquest 11189;
			close;
		} else if (ep14_1_bs == 11) {
			mes "[Kusmi]";
			mes "咦？";
			mes "你还想谈谈吗？";
			next;
			select("来自大陆的补给路线？");
			mes "[Kusmi]";
			mes "既然听到了，你就得帮忙了！";
			mes "还想知道吗？！";
			next;
			switch(select("是。:不是。")) {
			case 1:
				mes "[Kusmi]";
				mes "不是什么特别的道路。";
				mes "只是一条旧路。";
				mes "据说它连接着不同大陆，也从后方连接Splendide基地和Alfheim。";
				next;
				mes "[Kusmi]";
				mes "如果你要去那里，请去确认一切是否正常。";
				set ep14_1_bs,12;
				changequest 11189,11190;
				close;
			case 2:
				mes "[Kusmi]";
				mes "谢谢你找回我的小袋子。";
				mes "我本想给你一些妖精之尘，但已经没有了。";
				close;
			}
		} else if (ep14_1_bs == 12) {
			mes "[Kusmi]";
			mes "不是什么特别的道路。";
			mes "只是一条旧路。";
			mes "据说它连接着不同大陆，也从后方连接Splendide基地和Alfheim。";
			next;
			mes "[Kusmi]";
			mes "如果你要去那里，请去确认一切是否正常。";
			close;
		} else if (ep14_1_bs == 13) {
			mes "[Kusmi]";
			mes "裂隙？";
			mes "原来这就是我们无法联系大陆的原因。";
			mes "呃……";
			mes "真想知道那里到底发生了什么。";
			next;
			mes "[Kusmi]";
			mes "如果你经过Bifrost，请弄清楚那里发生了什么。";
			mes "Bifrost中央有一个名为'Mora'的小村庄，大陆的所有补给都会经过那里。";
			next;
			mes "[Kusmi]";
			mes "去Mora村的仓库，管理员会告诉你更多。";
			mes "另外，回来时能帮我确认我的朋友Rondo是否在Mora村吗？";
			next;
			mes "[Kusmi]";
			mes "他以前总是在这个时候来Splendide，但现在情况不妙。我得告诉他改天再来。";
			set ep14_1_bs,14;
			changequest 11191,11192;
			close;
		} else if (ep14_1_bs == 14) {
			mes "[Kusmi]";
			mes "如果你经过Bifrost，请弄清楚那里发生了什么。";
			mes "Bifrost中央有一个名为'Mora'的小村庄，大陆的所有补给都会经过那里。";
			next;
			mes "[Kusmi]";
			mes "去Mora村的仓库，管理员会告诉你更多。";
			if (checkquest(11193) > -1 && checkquest(11193) < 2)
				close;
			mes "另外，回来时能帮我确认我的朋友Rondo是否在Mora村吗？";
			next;
			mes "[Kusmi]";
			mes "他以前总是在这个时候来Splendide，但现在情况不妙。我得告诉他改天再来。";
			close;
		} else if (ep14_1_bs > 14) {
			if (checkquest(11193) == -1) {
				mes "[Kusmi]";
				mes "能帮我确认我的朋友Rondo是否在Mora村吗？";
				next;
				mes "[Kusmi]";
				mes "他以前总是在这个时候来Splendide，但现在情况不妙。我得告诉他改天再来。";
				close;
			}
			mes "[Kusmi]";
			mes "哇！";
			mes "你真的穿过了Hazy Forest的迷宫之雾？";
			mes "哇！！！";
			mes "真是令人佩服。";
			next;
			mes "[Kusmi]";
			mes "非常感谢你。";
			mes "希望我们很快能再次穿过Bifrost。";
			mes "我想见见Rondo，再和他聊聊。";
			if (ep14_1_bs == 17) {
				next;
				mes "[Kusmi]";
				mes "哦，还有，Daphrer在Splendide西北方。";
			}
			if (checkquest(11193) < 2) {
				completequest 11192;
				completequest 11193;
			}
			close;
		}
	}
	mes "[Kusmi]";
	mes "这里总是很冷。";
	mes "和我那天堂般的故乡完全不同。";
	close;
}

splendide,304,295,4	script	Theodore#ep14_1_bs	445,{
	if (!isequipped(2782)) {
		mes "[Theodore]";
		mes "DimFusTal Mu Lars";
		mes "ModAnduLo";
		mes "Mod";
		mes "DorDuMe U NohLarsFulo Mu Fus";
		next;
		mes "- You can't understand the fairy's words. -";
		mes "- You need something to help you interpret them. -";
		close;
	}
	if (ep14_1_bs > 3 && ep14_1_bs < 10) {
		mes "[Theodore]";
		mes "你是谁！";
		next;
		select("展示小袋子。");
		if (countitem(6390) == 0) {
			mes "[Theodore]";
			mes "嗯？你是什么意思？";
			close;
		}
		if (ep14_1_bs2 == 11) {
			mes "[Theodore]";
			mes "啊！！";
			mes "我的小袋子！！！！！";
			mes "我一直在到处找它。";
			mes "谢谢！";
			next;
			select("询问传闻。");
			mes "[Theodore]";
			mes "哼！！";
			mes "真是个尖锐的问题！";
			next;
			mes "[Theodore]";
			mes "如果你真的想听答案，就再来找我。";
			mes "我需要时间思考。";
			delitem 6390,1; //Small_Pocket
			set ep14_1_bs,10;
			changequest 11187,11194;
			close;
		} else {
			mes "[Theodore]";
			mes "那个脏兮兮的小袋子是什么！";
			mes "肯定不是我的。";
			next;
			mes "[Theodore]";
			mes "但希望你能找到它真正的主人。";
			close;
		}
	}
	if (ep14_1_bs2 == 11) {
		if (ep14_1_bs == 10) {
			mes "[Theodore]";
			mes "我接下来要告诉你的事，不许告诉任何人。";
			next;
			mes "[Theodore]";
			mes "最近Splendide出现了一个大问题。";
			mes "我们无法与大陆联系。";
			mes "不仅联系中断，补给也被切断了。人们表面上装作漠不关心，实际上非常恐慌。";
			next;
			mes "[Theodore]";
			mes "这片冰冻土地不适合采集食物，而耕种又太辛苦。";
			next;
			mes "[Theodore]";
			mes "事实上，仅仅维持绿色就要消耗惊人的魔力。";
			mes "上层还没有传来消息，但从传闻来看，这不是容易解决的问题。";
			next;
			mes "[Theodore]";
			mes "正因为没有简单的解决办法，所有人都担心得要命。";
			mes "根据军法，战争期间士兵不能离开战场，所以无法获得更多信息。";
			next;
			mes "[Theodore]";
			mes "因此，如果你遇到Laphine，请不要提起这些事。";
			mes "大家都在尽力，但我们仍是骄傲的种族。";
			next;
			mes "[Theodore]";
			mes "正如我之前说的，我告诉你的是秘密，不许告诉任何人。";
			mes "我们确实需要帮助，但我们已走投无路，不想让别人知道。";
			set ep14_1_bs,11;
			completequest 11194;
			setquest 11195;
			close;
		} else if (ep14_1_bs == 11) {
			mes "[Theodore]";
			mes "你还有事要找我吗？";
			next;
			select("来自大陆的补给路线？");
			mes "[Theodore]";
			mes "嗯……既然听到了，你也许得帮帮我们？";
			mes "你还想知道吗？";
			next;
			switch(select("是。:不是。")) {
			case 1:
				mes "[Theodore]";
				mes "补给路线经过Bifrost，你可以从Splendide基地后方前往那里。";
				mes "所以我们才把基地设在这里。";
				mes "路线的起点不明，但很久以来人们都知道它是一座连接大陆的桥。";
				next;
				mes "[Theodore]";
				mes "如果你去那里，请问问守卫那边的情况。";
				set ep14_1_bs,12;
				changequest 11195,11196;
				close;
			case 2:
				mes "[Theodore]";
				mes "谢谢你把小袋子找回来。";
				mes "妖精之尘？我不带那种东西。";
				close;
			}
		} else if (ep14_1_bs == 12) {
			mes "[Theodore]";
			mes "补给路线经过Bifrost，你可以从Splendide基地后方前往那里。";
			mes "所以我们才把基地设在这里。";
			mes "路线的起点不明，但很久以来人们都知道它是一座连接大陆的桥。";
			next;
			mes "[Theodore]";
			mes "如果你去那里，请问问守卫那边的情况。";
			close;
		} else if (ep14_1_bs == 13) {
			mes "[Theodore]";
			mes "裂隙？";
			mes "原来这就是我们无法联系大陆的原因。";
			mes "真想知道那里发生了什么。";
			next;
			mes "[Theodore]";
			mes "嗯……";
			mes "我不能离开这里，但你应该可以，对吧？";
			mes "大陆补给会经过位于Bifrost中央的'Mora'村。";
			next;
			mes "[Theodore]";
			mes "如果你和Mora村的仓库管理员交谈，就能得到更多信息。";
			mes "如果你愿意，能去Bifrost的'Mora'村见仓库管理员吗？";
			next;
			mes "[Theodore]";
			mes "如果不麻烦的话，也请顺便去看看我的朋友Lilitia……";
			set ep14_1_bs,14;
			changequest 11197,11198;
			close;
		} else if (ep14_1_bs == 14) {
			mes "[Theodore]";
			mes "如果你和Mora村的仓库管理员交谈，就能得到更多信息。";
			mes "如果你愿意，能去Bifrost的'Mora'村见仓库管理员吗？";
			if (checkquest(11199) > -1 && checkquest(11199) < 2)
				close;
			next;
			mes "[Theodore]";
			mes "如果不麻烦的话，也请顺便去看看我的朋友Lilitia……";
			close;
		} else if (ep14_1_bs > 14) {
			if (checkquest(11199) == -1) {
				mes "[Theodore]";
				mes "如果不麻烦的话，也请顺便去看看我的朋友Lilitia……";
				close;
			}
			mes "[Theodore]";
			mes "哇！！！";
			mes "你穿过了Hazy Forest迷宫，还从Mora村回来了。";
			mes "找你帮忙真是正确的决定！";
			next;
			mes "[Theodore]";
			mes "谢谢你。";
			mes "希望这件事能尽快解决……";
			mes "我不想让Lilitia更加难过……";
			if (ep14_1_bs == 17) {
				next;
				mes "[Theodore]";
				mes "哦，还有，Daphrer在Splendide西北方。";
			}
			if (checkquest(11199) < 2) {
				completequest 11198;
				completequest 11199;
			}
			close;
		}
	}
	mes "[Theodore]";
	mes "有时我能感受到这片冰冻大地中痛苦的美，与故乡的美截然不同。";

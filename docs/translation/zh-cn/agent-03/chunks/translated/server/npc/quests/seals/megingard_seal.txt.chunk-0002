				mes "权威的脸面！尽管向负责所有军事犯罪的法官举报我！他就在我身后！";
				next;
				mes "[Rebarev Doug]";
				mes "至少 100 人举报同一罪行，他才可能开庭。但你真的想把这事公之于众吗？";
			}
			else if (god_eremes > 23 && god_eremes < 26) {
				mes "[Rebarev Doug]";
				mes "没想到你真的会做。但你以后会后悔的……";
			}
			else {
				mes "[Rebarev Doug]";
				mes "你还不明白吗？精英和强者统治世界。我不可触碰！弱者和卑微者就下地狱腐烂吧！嘿嘿！";
			}
		}
		else {
			mes "[Rebarev Doug]";
			mes "你甚至不配和我说话。即使你是冒险者……";
		}
	}
	else {
		mes "[Rebarev Doug]";
	mes "我们是十字军，一直训练，为即将到来的圣战做准备。";
		next;
		mes "[Rebarev Doug]";
	mes "如同祖先一千年前所做的那样，时机到来时我们将消灭恶魔大军。";
	}
	close2;
	cutin "god_rebeireb",255;
	end;
}


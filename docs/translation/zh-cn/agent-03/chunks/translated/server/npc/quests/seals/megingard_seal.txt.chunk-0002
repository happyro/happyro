					}
					else {
						mes "[Librarian Jekan]";
					mes "呃……我不这么认为……？";
					}
				}
			}
		}
		else if (god_eremes == 2) {
			mes "[Librarian Jekan]";
		mes "啊，请不要触碰本区文件。通常这里是公开区域，但似乎有份机密文件被误放进来了。";
			next;
			mes "[Librarian Jekan]";
		mes "现在没有特别许可，任何人都不能查看那一区。我必须尽快找到文件并送给普隆德拉军方。";
			next;
			mes "[Librarian Jekan]";
		mes "呃！这灯光对我的眼睛不够亮，又开始酸痛了……";
			next;
			mes "[Librarian Jekan]";
		mes "那么你来这里做什么？如果要找特定东西，应该去其他区域。";
			next;
		switch(select("我想读些文件。:你的眼睛不好吗？:让我帮你找文件。:你在找什么文件？")) {
			case 1:
				mes "[Librarian Jekan]";
				mes "我已经说过了！本区文件目前不对公众开放！别让我重复！";
				close;
			case 2:
				mes "[Librarian Jekan]";
				mes "我长期在昏暗灯光下工作，眼睛变坏了。他们应该给我换盏灯，否则我迟早会失明……";
				close;
			case 3:
				mes "[Librarian Jekan]";
				mes "嗯？你怎么知道我在找什么文件？你甚至不知道里面写了什么吧？别打扰我，走开！";
				close;
			case 4:
				mes "[Librarian Jekan]";
			mes "嗯……我不该透露任何与文件有关的信息。";
				next;
				mes "[" + strcharinfo(0) + "]";
			mes "那份文件不是……";
				input @str$;
				mes "[" + strcharinfo(0) + "]";
				mes "^0000FF" + @str$ + "?";
				next;

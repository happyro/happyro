		if (rand(1,10) > 6 && god_eremes > 6) {
			mes "^3355FFYou see a shelf filled with many files. You begin searching through them, one by one.^000000";
			set god_eremes,god_eremes+1;
			close;
		}
		else {
			mes "^3355FFYou see a shelf filled with many files. You begin searching through them, one by one.^000000";
			close2;
		}
	}

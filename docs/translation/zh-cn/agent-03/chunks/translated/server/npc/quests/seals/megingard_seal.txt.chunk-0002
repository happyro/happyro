prt_in,172,106,0	script	Librarian#megin	833,{
	if ($God1 >= $@god_check1 && $God2 < $@god_check2) {
		if (god_eremes > 2 && god_eremes < 7) {
			mes "[Librarian Jekan]";
			mes "啊，请不要触碰本区文件。";
			next;
			mes "[Librarian Jekan]";
			mes "这里部分信息属于机密，因此普隆德拉军方禁止浏览。";
			next;
			mes "[Librarian Jekan]";
			mes "我正在寻找那一区的机密文件，以便将其与公开信息分开。";
			next;
			mes "[Librarian Jekan]";
			mes "如果你^660000不^000000干扰我的工作，我会非常感激。";
			next;
			mes "[Librarian Jekan]";
			mes "该死……！灯光这么暗，我什么也看不清！我的眼睛已经够糟了……";
			while(1) {
				next;
				switch(select("你的眼睛不好吗？:我想读些文件。:让我帮你找文件……:你在找什么文件？")) {
				case 1:
					mes "[Librarian Jekan]";
					mes "我长期在昏暗灯光下工作，眼睛坏了。他们应该给我^0000FF换盏新灯^000000，否则我迟早会失明……";
					if (god_eremes == 5 && (countitem(2203) > 0 || countitem(1041) > 0)) {
						next;
						mes "[Librarian Jekan]";
						mes "嘿，你带的东西很有用。介意借我一会儿吗？它能帮我找文件……";
						next;
						switch(select("介意！:不介意。")) {
						case 1:
							mes "[Librarian Jekan]";
							mes "^333333*Sniff*^000000";
							mes "没、没事……";
							close;
						case 2:
							mes "[Librarian Jekan]";
							mes "哦，你真好！你、你真的想帮我，对吧？";
							if (countitem(2203) && countitem(1041)) {
								delitem 1041,countitem(1041); //Lantern
								delitem 2203,1; //Spectacles
							}
							else if (countitem(2203)) {
								delitem 2203,1;
							}
							else if (countitem(1041)) {
								delitem 1041,countitem(1041);
							}
							set god_eremes,6;
							next;
							mes "[Librarian Jekan]";
							mes "谢谢……现在我不用那么担心找不到文件了。";
							next;
							mes "[Librarian Jekan]";
							mes "如果可以，你能帮我找找吗……？";
							close;
						}
					}
					else if (god_eremes > 5) {
						next;
						mes "[Librarian Jekan]";
						mes "谢谢……你借给我的东西确实能帮助我寻找那些文件……";
					}
					break;
				case 2:
					if (god_eremes == 6) {
						mes "[Librarian Jekan]";
					mes "读一些文件？嗯，你来这里";
						mes "去图书馆。这是个好开始。";
						next;
						mes "[Librarian Jekan]";
						mes "只要知道要找哪类文件，也许就能找到。";
						next;
						mes "[Librarian Jekin]";
						mes "我得尽快找到那份机密文件！";
						close2;
						set god_eremes,7;
						end;
					}
					else {
						mes "[Librarian Jekan]";
						mes "嗯……？嘿，我不是已经告诉过你了吗？";
						next;
						mes "[Librarian Jekan]";
						mes "禁止公众浏览本区文件！要我重复多少次？";
						close;
					}
				case 3:
					if (god_eremes == 4) {
						mes "[Librarian Jekan]";
						mes "如果不是不能让机密信息公开，我当然愿意接受你的帮助。";
						next;
						mes "[Librarian Jekan]";
						mes "我不知道这么重要的东西怎么混进普隆德拉图书馆文件中，但不能让公众接触。";
						next;
						mes "[Librarian Jekan]";
						mes "不过那份文件似乎没那么重要，但我还是得浪费时间寻找……";
						next;
						mes "[Librarian Jekan]";
						mes "该死，我的眼睛酸痛。做政府官员很轻松，除了官僚让你做这种事的时候。";
						set god_eremes,5;
					}
					else if (god_eremes > 4) {
						mes "[Librarian Jekan]";
						mes "我找这份文件快疯了……！";
						next;
						mes "[Librarian Jekan]";
						mes "嗯……？你刚才说想帮我？我、我会感激的。";
					}
					else {
						mes "[Librarian Jekan]";
						mes "呃，你甚至不该知道我在找什么文件。即使知道，我也不能给你看里面的内容！";
						close;
					}
					break;
				case 4:
					mes "[Librarian Jekan]";
					mes "嗯，我不能透露与那份文件有关的信息。很抱歉。";
					next;
					mes "[" + strcharinfo(0) + "]";
					mes "但那份文件不是关于……";
					input @str$;
					mes "^0000FF" + @str$ + "?";
					next;
					if (@str$ == "the 1st squad's final mission") {
						mes "[Librarian Jekan]";
					mes "嗯……？你怎么知道的？";

			specialeffect2 EF_HIT5;
		}
		close;
	case 5:
		mes "现在我来告诉你";
		mes "我所知道的";
		mes "更高级的法师";
		mes "技能。你想让我解释";
		mes "哪一种？";
		while(1){
			next;
			switch(select("灵魂攻击:火墙:火球术:冰冻术:雷暴术:火墙:能量外套:退出。")) {
			case 1:
				mes "[Mana]";
				mes "灵魂攻击是^CFB53B幽灵^000000";
				mes "属性技能，你可以在";
				mes "提升";
				mes "心灵爆破技能到一定等级后";
				mes "学习。它用";
				mes "古老的精神力量攻击～";
				next;
				specialeffect2 EF_SOULSTRIKE;
				next;
				mes "[Mana]";
				mes "随着你训练";
				mes "灵魂攻击并提高";
				mes "技能等级，它会变得更强，你也能";
				mes "更快施放。";
				.@skill_e1 = 1;
				break;
			case 2:
				mes "[Mana]";
				mes "你可以在训练";
				mes "心灵爆破和灵魂攻击";
				mes "后学习火墙。";
				mes "火墙能抵挡";
				mes "大多数近距离攻击。";
				next;
				specialeffect2 EF_GLASSWALL;
				next;
				mes "[Mana]";
				mes "不过，火墙";
				mes "有持续时间，";
				mes "只能抵挡";
				mes "一定次数的攻击，";
				mes "次数取决于";
				mes "火墙技能等级。";
				.@skill_e2 = 1;
				break;
			case 3:
				mes "[Mana]";
				mes "火球术是^FF0000火^000000";
				mes "属性技能，你可以在";
				mes "训练";
				mes "火箭术后学习。";
				next;
				specialeffect2 EF_FIREBALL;
				next;
				mes "[Mana]";
				mes "火球术实际上可以";
				mes "对多个敌人造成伤害，";
				mes "只要它们在";
				mes "技能范围内。好好利用";
				mes "火球术的破坏性";
				mes "力量！";
				.@skill_e3 = 1;
				break;
			case 4:
				mes "[Mana]";
				mes "冰冻术是^0000FF水^000000";
				mes "属性技能，可以在";
				mes "提升";
				mes "冰箭术技能到";
				mes "一定等级后学习。";
				specialeffect2 EF_FROSTDIVER;
				next;
				specialeffect2 EF_FROSTDIVER2;
				mes "[Mana]";
				mes "冰冻术会伤害";
				mes "敌人，并有机会";
				mes "将其冻结。一旦";
				mes "被冻结，怪物就会被视为";
				mes "水";
				mes "属性生物。";
				next;
				mes "[Mana]";
				mes "随着你提升";
				mes "冰冻术";
				mes "等级，伤害和冻结";
				mes "怪物的概率也会";
				mes "增加。很危险，对吧？^FFFFFFkamenriderblack^000000";
				.@skill_e4 = 1;
				break;
			case 5:
				mes "[Mana]";
				mes "雷暴术是";
				mes "^93DB70风^000000属性技能，";
				mes "可以在提升";
				mes "雷击术";
				mes "到一定等级后学习。";
				next;
				specialeffect2 EF_THUNDERSTORM;
				mes "[Mana]";
				mes "雷暴术和火球术类似，";
				mes "可以";
				mes "攻击一定范围内的";
				mes "多个敌人。";
				mes "这是非常强大的";
				mes "地面指定攻击。";
				.@skill_e5 = 1;
				break;
			case 6:
				mes "[Mana]";
				mes "火墙是^FF0000火^000000";
				mes "属性技能，可以在";
				mes "训练";
				mes "火球术和";
				mes "火狩后学习。与其他技能不同，";
				mes "火墙以区域为目标。";
				next;
				specialeffect2 EF_FIREWALL;
				mes "[Mana]";
				mes "你可以把";
				mes "火墙放在";
				mes "敌人会";
				mes "经过的位置。";
				mes "敌人靠近时";
				mes "尤其有用！";
				next;
				mes "[Mana]";
				mes "如果能";
				mes "战略性、有效地使用火墙，";
				mes "它就能";
				mes "成为强大的技能～";
				.@skill_e6 = 1;
				break;
			case 7:
				mes "[Mana]";
				mes "能量外套是";
				mes "独特技能，";
				mes "不能自行学习。";
				mes "你必须请魔法师公会的";
				mes "Blizardis";
				mes "教你使用。";
				next;
				specialeffect2 EF_ENERGYCOAT;
				next;
				mes "[Mana]";
				mes "如果你决定";
				mes "学习能量外套，";
				mes "Blizardis一定会告诉你";
				mes "所有需要知道的事。";
				.@skill_e7 = 1;
				break;
			case 8:
				mes "[Mana]";
				mes "都理解了吗？很好，因为";
				mes "现在我代表魔法师";
				mes "公会给你一个任务。准备好";
				mes "接受简报后，";
				mes "来找我，";
				mes "好吗？";
				next;
				mes "[Mana]";
				mes "哦，请收下";
				mes "这个。这是帮助你";
				mes "训练的礼物。希望它";
				mes "在战斗中";
				mes "派上用场……";
				tu_magician01 = 6;
				getitem 1604,1; //Wand
				specialeffect2 EF_HIT5;
				.@total = .@skill_e1 + .@skill_e2 + .@skill_e3 + .@skill_e4 + .@skill_e5;
				if (.@total) getexp (.@total*300),(.@total*100);
				close;
			}
		}
		close;
	case 6:
		mes "哦，很好，你回来了。";
		mes "我来告诉你";
		mes "任务。最近，";
		mes "梦罗克发生了事情，";
		mes "盗贼公会";
		mes "请求我们援助。";
		next;
		mes "[Mana]";
		mes "你不一定";
		mes "要做这件事，但";
		mes "会得到报酬，";
		mes "我们也会提供";
		mes "支持。";
		mes "你觉得呢？";
		next;
		switch(select("我来做。:抱歉，但是……")) {
		case 1:
			mes "[Mana]";
			mes "很好！那么，";
			mes "我直接把你送到";
			mes "梦罗克。到了之后，";
			mes "去梦罗克金字塔前";
			mes "并";
			mes "和Yierhan谈谈。谢谢～";
			next;
			mes "[Mana]";
			mes "哦，完成";
			mes "Yierhan交给你的事后，";
			mes "回来";
			mes "向我报告，好吗？";
			tu_magician01 = 7;
			emotion ET_SMILE;
			warp "morocc",182,286;
			close;
		case 2:
			mes "[Mana]";
			mes "嗯……？";
			mes "哦，我明白了。如果";
			mes "你改变";
			mes "主意，就回来";
			mes "再问我，好吗？";
			close;
		}
	case 7:
		mes "我不知道";
		mes "Yierhan安排了";
		mes "什么工作";
		mes "给你，但希望";
		mes "不会太难。";
		close;
	case 27:
		mes "Yierhan刚给我发来";
		mes "消息，说你";
		mes "出色地完成了";
		mes "任务。";
		mes "做得很好，"+strcharinfo(0)+"～";
		next;
		mes "[Mana]";
		mes "看来有两个";
		mes "秘密组织";
		mes "参与了这件肮脏的";
		mes "事情。他们为什么";
		mes "要合作？";
		next;
		mes "[Mana]";
		mes "不过无论如何……";
		mes "这是相当";
		mes "重大的事情，";
		mes "我想高层";
		mes "会处理，所以你暂时";
		mes "不用担心。";
		next;
		mes "[Mana]";
		mes "请收下这个，作为";
		mes "帮助我们两个公会的";
		mes "小小奖励。再次";
		mes "非常感谢～";
		tu_magician01 = 28;
		getitem 2321,1; //Silk_Robe
		Zeny = Zeny + 3000;
		getexp 3000,1000;
		close;
	default:
		if(tu_magician01 < 27){
			mes "所以……";
			mes "看起来符文米德加尔特";
			mes "王国确实";
			mes "发生了什么。难怪";
			mes "所有公会都这么忙……";
			next;
			mes "[Mana]";
			mes "总之，请继续";
			mes "努力";
			mes "工作。还有，嗯，";
			mes "Yierhan还好吗？";
		} else {
			mes "你现在似乎经验丰富，";
			mes "而且";
			mes "我没什么";
			mes "可教你了。现在要靠你";
			mes "自己寻找掌握";
			mes "魔法的方法。";
		}
		close;
	}
}

		mes "....................";
		close;
	}
}

in_orcs01,162,33,1	script	Orc Hero#1	1087,2,2,{
OnTouch_:
	if (checkweight(1201,1) == 0) {
		mes "- 等一下！！-";
		mes "- 你现在携带了-";
		mes "- 太多物品。-";
		mes "- 请在-";
		mes "- 减轻负重后再试。-";
		close;
	}
	if (orcs_hero_hat < 16) {
		mes "[Orc Hero]";
		mes "别来烦我，";
		mes "快离开这里！";
		next;
		mes "[Orc Hero]";
		mes "如果想挑战我，就在西边的森林里等着。我现在没心情应付人类。";
		next;
		mes "[Orc Hero]";
		mes "现在，快点";
		mes "滚蛋！！";
		close;
	}
	else if (orcs_hero_hat == 16) {
		if (countitem(968) == 1 && (countitem(1124) > 0 || isequipped(1124) == 1)) {
			if (rand(1,10) == 1) {
				mes "[Orc Hero]";
				mes "嗯，你就是被授予兽人英雄称号的人类？";
				next;
				mes "[Orc Hero]";
				mes "希望你明白归还我的徽章意味着什么。我期待我们在战场上再次相遇。";
				if (countitem(2299) > 0) {
					next;
					mes "[Orc Hero]";
					mes "等等……";
					mes "那不是兽人战士的头盔吗……？";
					next;
					mes "[Orc Hero]";
					mes "等一下……";
					mes "不是！哈……！";
					mes "有意思！";
					mes "真是";
					mes "有意思。";
					next;
					mes "[Orc Hero]";
					mes "我想你不知道这顶头盔有什么特别之处……";
					next;
					mes "[Orc Hero]";
					mes "它曾属于一位被人类击败的兽人领主。他因战败而愤怒，折断中间的角并把它扔掉了！";
					next;
					mes "[Orc Hero]";
					mes "我听说它不知怎么落入了人类手中，但没想到那个人就是你——人类兽人英雄。";
					next;
					mes "[Orc Hero]";
					mes "好吧，那属于兽人领主。虽然现在是你的，但当初是误给你的。";
					next;
					mes "[Orc Hero]";
					mes "人类兽人英雄，你介意把物品还给它的主人吗？";
					next;
					if (select("是，我介意。:不，我不介意。") == 1) {
						mes "[Orc Hero]";
						mes "哇，你真固执！好好保管头盔，怀着敬意佩戴。记住它有悠久的历史……";
						close;
					}
					mes "[Orc Hero]";
					mes "很好，这是个正确的决定。我会把它还给他。哇哈哈哈哈……没想到还能再次看到这东西。";
					next;
					mes "[Orc Hero]";
					mes "好……";
					mes "让我给你";
					mes "一些有用的东西！";
					next;
					mes "[Orc Hero]";
					mes "虽然你是人类，但现在是我们中的兽人英雄，所以应该拥有适合你身份的头盔……";
					next;
					delitem 2299,1; //Viking_Helm
					set orcs_hero_hat,17;
					getnameditem 5094,strcharinfo(0); //Orc_Hero_Helm
					mes "[Orc Hero]";
					mes "给你。我在上面做了小标记。以后就戴这顶头盔。明白了吗？我的人类兽人英雄。";
					close;
				}
				close;
			}
			mes "[Orc Hero]";
			mes "嗯，你就是被授予兽人英雄称号的人类？";
			next;
			mes "[Orc Hero]";
			mes "希望你明白归还我的徽章意味着什么。我期待我们在战场上再次相遇。";
			close;
		}
		mes "[Orc Hero]";
		mes "嗯，你就是被授予兽人英雄称号的人类？";
		next;
		mes "[Orc Hero]";
		mes "哼，我不相信。你真的是把徽章还给我们的人吗？我不觉得能信任你……";
		next;
		mes "[Orc Hero]";
		mes "是啊，你以为我会记得被丑陋人类痛打的事，但挨打时太忙了，实在记不住脸。";
		next;
		mes "[Orc Hero]";
		mes "我拒绝";
		mes "承认像你这样";
		mes "连我们最基本的习俗";
		mes "都忘记的人！";
		next;
		mes "[Orc Hero]";
		mes "嗷……";
		mes "来吧！";
		mes "我们在森林西边见，我要再测试你的力量！";
		close;
	}
	else if (orcs_hero_hat == 17) {
		mes "[Orc Hero]";
		mes "哇哈哈哈哈～";
		mes "你是我遇到过的";
		mes "最奇怪的人类，";
		mes "没有之一。";
		mes "哈哈哈哈哈……";
		next;
		mes "[Orc Hero]";
		mes "我喜欢你，";
		mes "人类，我喜欢你。";
		close;
	}
	mes "[Orc Hero]";
	mes "....................";
	close;
}


				}
				else if(aru_em == 12) {
					cutin "ra_gman",2;
					mes "[High Priest Zhed]";
			mes "请把这封信交给 Niren。";
			mes "希望我的话能让她理解";
			mes "我对战争计划的感受。";
			mes "";
			mes "";
					next;
			mes "^3355FF你收到了高级神官 Zhed 写给 Niren 的信。^000000";
			mes "";
					set aru_em,13;
					changequest 2133,2134;
				}
				else if((aru_em == 13) || (aru_em == 14)) {
					mes "[High Priest Zhed]";
			mes "请尽快把我的信交给 Niren。";
			mes "非常感谢你帮我做这件事。";
			mes "";
			mes "";
			mes "";
				}
				else if ((aru_em > 14) && (aru_em < 20)) {
					mes "[High Priest Zhed]";
			mes "好消息！Niren 刚刚给我回信了。";
			mes "我不敢相信她愿意帮我！";
			mes "今后她有需要时，请你也帮助她，好吗？";
			mes "";
			mes "";
			mes "";
				}
				else if(aru_em == 20) {
					cutin "ra_gman",2;
					mes "[High Priest Zhed]";
			mes "啊，我一直在等你。";
			mes "";
					next;
					mes "["+strcharinfo(0)+"]";
			mes "高级神官 Zhed，一切都准备好了！";
			mes "高级神官 Niren 已经把教皇附近的信徒全部支开。";
			mes "不会有人打扰你们。";
			mes "";
			mes "";
			mes "";
					next;
					mes "[High Priest Zhed]";
			mes "希望我们能让教皇理解国家的处境。";
			mes "我只是……";
			mes "哦，Freya 保佑我们……";
			mes "";
					next;
					mes "[High Priest Zhed]";
					mes "..............";
					mes "..............";
					mes "..............";
					next;
					mes "[High Priest Zhed]";
			mes "好，我准备好了。";
			mes "我们去觐见教皇吧？";
			mes "";
			mes "";
					set aru_em,21;
				}
				else if(aru_em == 21) {
					mes "[High Priest Zhed]";
			mes "要这样直率地和教皇谈话，我有点紧张，";

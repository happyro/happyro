					mes "在我们觉得有必要时夸大……甚至撒谎吗？";
					next;
					switch(select("真相:谎言")) {
					case 1:
						mes "[High Priest Zhed]";
						mes "我也这么想。虽然担心教皇对我们消息的反应，但我应该有信仰。我应该相信。";
						next;
						break;
					case 2:
						mes "[High Priest Zhed]";
					mes "我想你说得有道理。让她完全面对丑陋真相可能不是好主意。我会尽可能诚实……";
						next;
						break;
					}
					mes "[High Priest Zhed]";
					mes "不能浪费时间。光靠我们两个可能无法说服教皇采取和平行动。我已经想到一个可能帮助我们的人。";
					next;
					emotion ET_SPARK, playerattached();
					mes "["+strcharinfo(0)+"]";
					mes "听起来不错。他是谁？";
					next;
					mes "[High Priest Zhed]";
					mes "我的老朋友，高级神官 Niren。我不确定经历了这些事后她是否会帮我。她甚至可能认为我应该被逐出教会……";
					next;
					emotion ET_BEST, playerattached();
					mes "["+strcharinfo(0)+"]";
					mes "试试又不会有损失！而且 Niren 不是坏人。也许你解释后，她会理解你的看法？";
					next;
					mes "[High Priest Zhed]";
					mes "当然，你说得对。我只是在抓最后一根稻草，但她和我都曾相信和平可能实现。不知道她为什么加入强硬派……";
					next;
					mes "[High Priest Zhed]";
					mes ""+strcharinfo(0)+"...";
					mes "请和她谈谈，看看她过得如何？不过，也许现在不适合立刻提我们的计划……";
					next;
					mes "[High Priest Zhed]";
					mes "如果你觉得有机会说服她，就尽管提出我的建议。她的办公室就在对面，但她总是很忙……";
					next;
					mes "[High Priest Zhed]";
					mes "她很可能因公务去了某处。你知道，她深受人民爱戴。";
					set aru_em,9;
					changequest 2131,2132;  // unconfirmed
				}
				else if ((aru_em == 9) || (aru_em == 10)) {
					mes "[High Priest Zhed]";

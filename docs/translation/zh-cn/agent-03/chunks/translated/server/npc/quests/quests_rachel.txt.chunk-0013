			mes "";
			mes "";
				}
				else if (aru_em == 22) {
					mes "[High Priest Zhed]";
			mes "我相信 Niren 有重要的事要告诉你。";
			mes "你不如先和她谈谈，再回来找我？";
			mes "";
			mes "";
				}
				else if (aru_em == 23) {
					cutin "ra_gman",2;
					mes "[High Priest Zhed]";
			mes "我很高兴一切顺利。你的帮助真是祝福。";
			mes "虽然施瓦茨瓦尔德会继续他们的计划，";
			mes "但我们已经拖慢了他们的脚步。";
			mes "";
			mes "";
			mes "";
					next;
					mes "[High Priest Zhed]";
			mes "是的，没有我们的支持，";
			mes "施瓦茨瓦尔德至少暂时没有借口";
			mes "继续他们危险的研究。";
			mes "";
			mes "";
					next;
					mes "[High Priest Zhed]";
			mes "Thor 火山营地很快就该关闭了，";
			mes "既然我们已经不再需要它。";
			mes "";
			mes "";
					next;
					mes "[High Priest Zhed]";
			mes "我也低估了我们的教皇。";
			mes "她比我想象的更有尊严、更坚定。";
			mes "我应该向她道歉。";
			mes "";
					next;
					mes "[High Priest Zhed]";
			mes "我们不会放弃让女神 Freya 复苏，";
			mes "但会通过外交而不是暴力";
			mes "取回 Ymir 的心脏。";
			mes "这不会容易……";
			mes "";
			mes "";
					next;
					mes "[High Priest Zhed]";
					mes "你为恢复 Arunafeltz 的和平发挥了关键作用。";
					mes "我甚至已经复职，今后会和教皇密切合作，";
					mes "一定会非常忙……";
					mes "";
					mes "";
					mes "";
					next;
					mes "[High Priest Zhed]";
					mes "我知道冒险生活在召唤你。";
					mes "她一定想在你离开前见你，";
					mes "但那场令人疲惫的演讲后，她睡得很沉……";
					mes "";
					mes "";
					mes "";
					next;
					mes "[High Priest Zhed]";
					mes "我谨代表教皇和 Arunafeltz 的所有居民，";
					mes "感谢你的英勇。";
					mes "我相信你在英灵殿的位置已经确定了。";
					mes "";
					mes "";
					mes "";
					set aru_em,24;
					completequest 2142;
					getexp (checkre(3))?150000:1500000,0;
				}
				else {
					mes "[High Priest Zhed]";
					mes "愿 Freya 在你所有旅途中保佑你，我的朋友。";
					mes "";
					mes "";
				}
				// End Peace to Arunafeltz addition
			}
			else {
				cutin "ra_gman",2;
				mes "[High Priest Zhed]";
				mes "Ugh...!";
				mes "我的头痛得厉害！";
				mes "";
			}
		}
		else {
			cutin "ra_gman",2;
			mes "[High Priest Zhed]";
			mes "我现在应该休息。";
			mes "请一路平安。";
		}
	// End Veins "Thor Volcano Base" Quest Addition.
	}
	else {
		cutin "ra_gman",2;
		mes "[High Priest Zhed]";
		mes "愿 Freya 与你同在。";
	}
	close2;
	cutin "",255;
	end;
}


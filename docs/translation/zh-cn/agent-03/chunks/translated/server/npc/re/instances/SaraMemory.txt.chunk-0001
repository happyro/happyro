1@sara,107,325,6	script	Sara Irene#01	668,{
	if (is_party_leader() == true) {
		cutin "sara_9sara1",2;
		npctalk "哦！你好！我记得你，怎么了？";
		mes "[Sara Irene]";
		mes "哦！你好！我记得你，怎么了？";
		next;
			npctalk "我是来给妈妈送花的！";
		mes "[Sara Irene]";
		mes "我来给妈妈送花！";
		next;
		mapannounce instance_mapname("1@sara"), "莎拉捧着花冲上前去开门。",bc_area,"0xffffff";
		mes "^FF0000Sara 捧着花冲上前去开门。^000000";
		next;
		npctalk "妈妈！爸爸！看我找到了什么！";
		mes "[Sara Irene]";
		mes "妈妈！爸爸！看我找到了什么！";
		next;
		playBGMall "37",instance_mapname("1@sara");
		cutin "sara_9sara1",255;
		cutin "sara_momdie",4;
		mapannounce instance_mapname("1@sara"), "门打开后，地上躺着一名奄奄一息的女人，村长手持血剑站在她身旁。",bc_area,"0xffffff";
		mes "^FF0000门打开后，地上躺着一名奄奄一息的女人，Doyen 手持血剑站在她身旁。^000000";
		next;
		npctalk "...";
		mes "[Sara Irene]";
		mes "...";
		next;
		npctalk "莎拉……逃……走……", instance_npcname("Sara's Mother", instance_id());
		mes "[Sara's Mother]";
		mes "莎拉……逃……走……";
		next;
		npctalk "...";
		mes "[Sara Irene]";
		mes "...";
		next;
		mapannounce instance_mapname("1@sara"), "宝石从女人手中滚出，停在 Sara 面前。Sara 不自觉地弯腰捡起宝石。",bc_area,"0xffffff";
		mes "^FF0000宝石从女人手中滚出，停在 Sara 面前。Sara 不自觉地弯腰捡起宝石。^000000";
		next;
		mapannounce instance_mapname("1@sara"), "村长转过身，注意到了莎拉。",bc_area,"0xffffff";
		mes "^FF0000The Doyen turns around and notices Sara.^000000";
		next;

//===== rAthena Script =======================================
//= Heroes' Trail Part 1 - Sara's Memories
//===== Description: =========================================
//= Sara's Memories Instance in the Dimensional Gap.
//===== Changelogs: ==========================================
//= 1.0 First version. [Chilly]
//= 1.1 Clean-up and monster position fix. [RagnarokNova]
//============================================================

//= NPCs
dali,130,107,6	script	Adventurer Leon	945,{
	if (BaseLevel < 99) {
		mes "[Adventurer Leon]";
		mes "你知道的……这里对你来说似乎不安全。达到^0000FF 99 级^000000或更高后再回来。";
		close;
	}
	if (saramemory == 1) {
		mes "[Adventurer Leon]";
		mes "我不确定你是否已经充分探索了时空裂缝。也许应该再深入一些。";
		close;
	}
	if (saramemory == 2) {
		mes "[Adventurer Leon]";
		mes "你在里面看到了什么？！";
		next;
		mes "[Adventurer Leon]";
		mes "哼，莎拉·艾琳？！她是 12 位女武神之一。我不知道她的故事如此悲惨……";
		next;
		mes "[Adventurer Leon]";
		mes "看来你在她和父亲之间造成了巨大的误会。";
		next;
		mes "[Adventurer Leon]";
		mes "发生的一切和流下的血不该由你自责。那天的事件似乎无论谁在场都注定会发生。";
		next;
		mes "[Adventurer Leon]";
		mes "请别告诉任何人你的时间旅行冒险。不能让人觉得你比老利昂更重要，而且他们也不会相信这种故事。";
		next;
		set saramemory,3;
		erasequest 15003;
		getexp 770000,1000000;
		mes "[Adventurer Leon]";
		mes "我想你上次进入裂缝后约 20 小时，它就会稳定到足以再次穿越。";
		close;
	}
	if (saramemory == 3) {
		if ((checkquest(15002,PLAYTIME) == 0) || (checkquest(15002,PLAYTIME) == 1)) {
			mes "[Adventurer Leon]";
			mes "我想你上次进入裂缝后约 20 小时，它就会稳定到足以再次穿越。";
			close;
		}
		if (checkquest(15002,PLAYTIME) == 2) {
			erasequest 15002;
			mes "^0000FF[莎拉的记忆] 冷却已清除，现在可以再次使用次元装置。^000000";
			next;
		}
		mes "[Adventurer Leon]";
		mes "你想再次重温过去吗？";
		next;
		switch(select("是:否")) {
		case 1:
			mes "[Adventurer Leon]";
			mes "请通过次元装置，并向我报告你在里面的发现。";
			next;
			set saramemory,4;
			setquest 15003;
			mes "[Adventurer Leon]";
			mes "不过提醒你，它可能不稳定。请尽快进入。";
			close;
		case 2:
			mes "[Adventurer Leon]";
			mes "嗯……我不能强迫你。但鼓起勇气后请再来找我。";
			close;
		}
	}
	if (saramemory == 4) {
		if ((checkquest(15002,PLAYTIME) == 0) || (checkquest(15002,PLAYTIME) == 1)) {
			mes "[Adventurer Leon]";
			mes "我不确定你是否已经充分探索了时空裂缝。也许应该再深入一些。";
			close;
		}
		if (checkquest(15002,PLAYTIME) == 2) {
			erasequest 15002;
			mes "^0000FF[莎拉的回忆] 冷却时间已结束。现在可以再次使用次元装置。^000000";
			next;
		}
		mes "[Adventurer Leon]";
		mes "我不确定你是否已经充分探索了时空裂缝。也许应该再深入一些。";
		next;
		switch(select("好:放弃")) {
		case 1:
			mes "[Adventurer Leon]";
			mes "很高兴听到你这么说！也许有一天你能像老狮子利昂一样勇敢！";
			close;
		case 2:
			set saramemory,3;
			erasequest 15003;
			mes "[Adventurer Leon]";
			mes "嗯……我不能强迫你。但鼓起勇气后请再来找我。";
			close;
		}
	}
	if (saramemory == 5) {
		mes "[Adventurer Leon]";
		mes "你在里面看到了什么？！";
		next;
		mes "[Adventurer Leon]";
		mes "哼，莎拉·艾琳？！她是 12 位女武神之一。我不知道她的故事如此悲惨……";
		next;
		mes "[Adventurer Leon]";
		mes "看来你在她和父亲之间造成了巨大的误会。";
		next;
		mes "[Adventurer Leon]";
		mes "发生的一切和流下的血不该由你自责。那天的事件似乎无论谁在场都注定会发生。";
		next;
		mes "[Adventurer Leon]";
		mes "请别告诉任何人你的时间旅行冒险。不能让人觉得你比老利昂更重要，而且他们也不会相信这种故事。";
		next;
		set saramemory,3;
		erasequest 15003;
		getexp 550000,550000;
		mes "[Adventurer Leon]";
		mes "我想你上次进入裂缝后约 20 小时，它就会稳定到足以再次穿越。";
		close;
	}
	mes "[Adventurer Leon]";
	mes "请原谅我的无礼！我是著名冒险者庞·德·利昂！";
	next;
	mes "[Adventurer Leon]";
	mes "我的朋友叫我狮子利昂！因为我的外表和态度都很强悍。而且我的咬合力也很强！";
	next;
	mes "[Adventurer Leon]";
	mes "你知道吗，这个地方真奇怪……";
	next;
	mes "[Adventurer Leon]";
	mes "探索时你会看到时空裂缝。每道裂缝都被次元装置覆盖。";
	next;
	mes "[Adventurer Leon]";
	mes "例如，我想我从最近的裂缝看到了斐扬。但感觉不对，似乎比应该的样子更古老。";
	next;
	mes "[Adventurer Leon]";
	mes "我想探索，但年纪大了，膝盖也不太行。";
	next;
	mes "[Adventurer Leon]";
	mes "所以我想拜托你一件事。";
	next;
	mes "[Adventurer Leon]";
	mes "请通过次元装置，并向我报告你在里面的发现。";
	next;
	set saramemory,1;
	setquest 15003;
	mes "[Adventurer Leon]";
	mes "不过提醒你，它可能不稳定。请尽快进入。";
	close;
}

dali,139,118,4	script	Dimensional Device#sara	10007,{
	if (BaseLevel < 99) {
		mes "[Adventurer Leon]";
		mes "嘿！你太年轻，不能玩那个！达到^0000FF 99 级^000000后再回来！";
		close;
	}
	if ((saramemory < 1) || (saramemory == 2) || (saramemory == 3) || (saramemory == 5)) {
		mes "[Adventurer Leon]";
		mes "在你摆弄那个之前，过来和我聊聊吧？";
		close;
	}

	// 20 hour cooldown
	set .@ins_sara_time,checkquest(15002,PLAYTIME);
	if (.@ins_sara_time == -1) {

		set .@party_id,getcharid(1);
		set .@p_name$,getpartyname(.@party_id);
		set .@md_name$,"Sara's Memories";

		if (!.@party_id) {
			mes "[Adventurer Leon]";
			mes "进入前需要组建队伍！不知道怎么做吗？输入 /organize 队伍名称。";
			close;
		}

		if (is_party_leader() == true)
			set .@menu$, "Boot up the dimensional device.:Use the dimensional device.:Cancel.";
		else
			set .@menu$, ":Use the dimensional device.:Cancel.";

		switch(select(.@menu$)) {
		case 1:
			if (instance_create(.@md_name$) < 0) {
				mes "队伍名称："+.@p_name$;
				mes "队长："+strcharinfo(0);
				mes "^0000ff"+.@md_name$+" ^000000- Reservation Failed!";
				close;
			}
		mes "^FF0000次元装置顺利启动。使用装置进入时空裂缝。^000000";
			close;
		case 2:
			switch(instance_enter(.@md_name$)) {
			case IE_OTHER:
				mes "发生未知错误。";
				close;
			case IE_NOINSTANCE:
				mes "纪念副本"+.@md_name$+"不存在。";
				mes "队长还没有生成副本。";
				close;
			case IE_NOMEMBER:
				mes "只有登记成员才能进入副本"+.@md_name$+"。";
				close;
			case IE_OK:
				mapannounce "dali",strcharinfo(0)+", member of the party "+.@p_name$+" entered the instance "+.@md_name$+".",bc_map,"0x00ff99";
				setquest 15002;
				end;
			}
		case 3:
		mes "^FF0000队长没有启动次元装置。^000000";
			close;
		}
	} else if (.@ins_sara_time == 0 || .@ins_sara_time == 1) {
		mes "[Adventurer Leon]";
		mes "我想你上次进入裂缝后约 20 小时，它就会稳定到足以再次穿越。";
		close;
	}
	else {
		erasequest 15002;
		mes "^0000FF[莎拉的回忆] 冷却时间已结束。现在可以再次使用次元装置。^000000";
		close;
	}
}

1@sara,260,156,6	script	A Girl#01	668,{
	if (is_party_leader() == true) {
		unittalk getcharid(3),"我在哪里？";
		mes "["+strcharinfo(0)+"]";
		mes "我在哪里？";
		next;
		cutin "sara_9sara1",2;
		npctalk "你好！这里是斐扬村。你似乎不是本地人……";
		mes "[A Girl]";
		mes "你好！这里是斐扬村。你似乎不是本地人……";
		next;
		unittalk getcharid(3),"Are you from here? You don't seem to quite match the locals either.";
		mes "["+strcharinfo(0)+"]";
		mes "你是这里人吗？看起来也不太像本地人。";
		next;
			npctalk "是的！我出生在这里！我的名字是莎拉，莎拉·艾琳！";
		mes "[A Girl]";
		mes "是的！我在这里出生！我叫莎拉，莎拉·艾琳！";
		next;
		setnpcdisplay(instance_npcname("A Girl#01"),"Sara Irene");
			npctalk "我父亲是这个村庄的村长！我只是长得像妈妈。";
		mes "[Sara Irene]";
		mes "我父亲是这个村庄的权威！我只是继承了母亲的样貌。";
		next;
			unittalk getcharid(3),"哦！对不起！呃……你为什么一个人站在外面？";
		mes "["+strcharinfo(0)+"]";
		mes "哦！抱歉！呃……你为什么独自站在这里？";
		next;
			npctalk "我在等我的父亲。他说他很快就会到这里。";
		mes "[Sara Irene]";
		mes "我在等父亲。他说很快会来这里。";
		next;
		donpcevent instance_npcname("Doyen Irene#01", instance_id())+"::OnEnable";
		mapannounce instance_mapname("1@sara"), "一名年长男子走出房屋。莎拉看到他后脸上露出笑容。",bc_area,"0xffffff";
		mes "^FF0000一名年长男子走出房屋。莎拉看到他后脸上露出笑容。^000000";
		next;
		npctalk "Hi Daddy!";
		mes "[Sara Irene]";
		mes "嗨，爸爸！";
		next;
		cutin "sara_elder_irine1",2;
		npctalk "亲爱的，你看起来真开心。", instance_npcname("Doyen Irene#01", instance_id());
		mes "[Doyen Irene]";
		mes "亲爱的，你看起来真开心。";
		next;
		cutin "sara_9sara1",2;
		npctalk "你说会很快回来！我一直等你，你却骗我！";
		mes "[Sara Irene]";
		mes "你说会很快回来！我一直等你，你却骗我！";
		next;
		cutin "sara_elder_irine1",2;
		npctalk "亲爱的，对不起让你等这么久。和村中长老的会议比预想更久。", instance_npcname("Doyen Irene#01", instance_id());
		mes "[Doyen Irene]";
		mes "亲爱的，对不起让你等这么久。和村中长老的会议比预想更久。";
		next;
		cutin "sara_9sara1",2;
		npctalk "我讨厌那些老顽固。";
		mes "[Sara Irene]";
		mes "我讨厌那些老顽固。";
		next;
		cutin "sara_elder_irine1",2;
		npctalk "别这么说，亲爱的……和你一起的是谁？", instance_npcname("Doyen Irene#01", instance_id());
		mes "[Doyen Irene]";
		mes "别这么说，亲爱的……和你一起的是谁？";
		next;
		mapannounce instance_mapname("1@sara"), "村长艾琳眼中燃着怒火，瞪着你。",bc_area,"0xffffff";
		mes "^FF0000Doyen Irene 眼中燃着怒火，瞪着你。^000000";
		next;
		mapannounce instance_mapname("1@sara"), "莎拉开始轻声哼唱。她摘下附近的野花，献给村长。",bc_area,"0xffffff";
		mes "^FF0000Sara 开始轻声哼唱。她摘下附近的野花，献给 Doyen。^000000";
		next;
		cutin "sara_9sara1",2;
		npctalk "给你，爸爸！";
		mes "[Sara Irene]";
		mes "给你，爸爸！";
		next;
		cutin "sara_elder_irine1",2;
		npctalk "哦，莎拉，可以给我吗？", instance_npcname("Doyen Irene#01", instance_id());
		mes "[Doyen Irene]";
		mes "哦，莎拉，可以给我吗？";
		next;
		cutin "sara_9sara1",2;
		npctalk "当然可以，傻爸爸！";
		mes "[Sara Irene]";
		mes "当然可以，傻爸爸！";
		next;
		mapannounce instance_mapname("1@sara"), "收到花后，村长的心情似乎大为好转。",bc_area,"0xffffff";
		mes "^FF0000收到花后，Doyen 的心情似乎大为好转。^000000";
		next;
		cutin "sara_elder_irine1",2;
		npctalk "好，我的小公主。现在要去哪？", instance_npcname("Doyen Irene#01", instance_id());
		mes "[Doyen Irene]";
		mes "好，我的小公主。现在要去哪？";
		next;
		cutin "sara_9sara1",2;
		npctalk "哦，爸爸！我们去那边山丘顶吧！";
		mes "[Sara Irene]";
		mes "哦，爸爸！我们去那边山丘顶吧！";
		next;
		cutin "sara_elder_irine1",2;
		npctalk "哈！好，抱紧我！", instance_npcname("Doyen Irene#01", instance_id());
		mes "[Doyen Irene]";
		mes "哈！好，抱紧我！";
		next;
		cutin "sara_elder_irine1",255;
		donpcevent instance_npcname("A Girl#01", instance_id())+"::OnDisable";
		donpcevent instance_npcname("Doyen Irene#01", instance_id())+"::OnDisable";
		donpcevent instance_npcname("Strange Old Man#01", instance_id())+"::OnEnable";
		donpcevent instance_npcname("Mysterious Old Man#02", instance_id())+"::OnEnable";
		mapannounce instance_mapname("1@sara"), "他们离开后，你听见拐角处传来奇怪的声音……",bc_area,"0xffffff";
		mes "^FF0000他们离开后，你听见拐角处传来奇怪的声音……^000000";
		next;
		npctalk "我能感觉到莎拉的力量正在增长。我们不能袖手旁观，让她发挥全部潜力！", instance_npcname("Strange Old Man#01", instance_id());
		mes "[Strange Old Man]";
		mes "我能感觉到莎拉的力量正在增长。我们不能袖手旁观，让她发挥全部潜力！";
		next;
		npctalk "她出生在不祥之下，而且她的母亲甚至不是我们的一员！", instance_npcname("Mysterious Old Man#02", instance_id());
		mes "[Mysterious Old Man]";
		mes "她出生在不祥之下，而且她的母亲甚至不是我们的一员！";
		next;
		npctalk "有一天她会让我们的街道血流成河。", instance_npcname("Mysterious Old Man#02", instance_id());
		mes "[Mysterious Old Man]";
		mes "有一天她会让我们的街道血流成河。";
		next;
		npctalk "在神圣生物选中她之前，我们必须做点什么。我让‘他’来处理。", instance_npcname("Strange Old Man#01", instance_id());
		mes "[Strange Old Man]";
		mes "在神圣生物选中她之前，我们必须做点什么。我让‘他’来处理。";
		next;
		npctalk "走着瞧……我很期待听到她遭遇坏事的消息……", instance_npcname("Mysterious Old Man#02", instance_id());
		mes "[Mysterious Old Man]";
		mes "走着瞧……我很期待听到她遭遇坏事的消息……";
		next;
		donpcevent instance_npcname("Strange Old Man#01", instance_id())+"::OnDisable";
		donpcevent instance_npcname("Mysterious Old Man#02", instance_id())+"::OnDisable";
		enablenpc instance_npcname("#sara_warp01");
		donpcevent instance_npcname("Sara Irene#01", instance_id())+"::OnEnable";
		donpcevent instance_npcname("Sara's Mother", instance_id())+"::OnEnable";
		donpcevent instance_npcname("Doyen Irene#02", instance_id())+"::OnEnable";
		mapannounce instance_mapname("1@sara"), "老人们离开了。莎拉似乎有危险。我们必须做点什么！",bc_area,"0xffffff";
		mes "^FF0000老人们离开了。Sara 似乎有危险，我们必须做点什么！^000000";
		close;
	}
	else {
		end;
	}

OnInstanceInit:
OnEnable:
	enablenpc instance_npcname("A Girl#01");
	end;
OnDisable:
	disablenpc instance_npcname("A Girl#01");
	end;
}


		}
		mes "又见面了。是队长派你来的吗？";
		next;
		mes "[Police Officer Gerev]";
		mes "如果你不忙，能拆除幻影之地各处毁灭祈祷设置的陷阱吗？";
		next;
		if (select( "当然。", "下次吧。" ) == 1) {
			setquest 5315;
			ep15_1_mang = 0;
			mes "[Police Officer Gerev]";
			mes "谢谢。请拆除幻影之地的10个陷阱。";
			close;
		}
		emotion ET_SCRATCH;
		setquest 5311;
		mes "[Police Officer Gerev]";
		mes "你也很忙吧？没关系。还有其他冒险者在帮我。请告诉凯斯勒队长我的区域一切顺利。";
		close;
	case 1:
		emotion ET_HUK;
		mes "哇，你已经拆除所有陷阱了吗？";
		next;
		switch( select( "是的！", "陷阱在哪里？", "我有更紧急的事。", "没事。" ) ) {
		case 1:
			if (ep15_1_mang >= 10) {
				completequest 5315;// Gerev's Request
				if (isbegin_quest(5306) == 0) {
					setquest 5306;
					completequest 5306;
				}
				setquest 5311;// Gerev's Problem
				ep15_1_mang = 0;
				mes "[Police Officer Gerev]";
				mes "谢谢。周围陷阱少了，我感觉好多了。请告诉凯斯勒队长我的区域一切顺利。";
				close;
			}
			emotion ET_OTL;
			mes "[Police Officer Gerev]";
			mes "我已经快崩溃了。你不用催我。";
			next;
			mes "[Police Officer Gerev]";
			mes "你还没拆完10个陷阱。我面前就有一个，为什么不从那里开始？";
			close;
		case 2:
			emotion ET_STARE;
			mes "[Police Officer Gerev]";
			mes "糟糕，你一个陷阱都没看到吗？";
			next;
			mes "[Police Officer Gerev]";
			mes "寻找地面上写着???的地方，那是毁灭祈祷的标记。";
			next;
			mes "[Police Officer Gerev]";
			mes "我面前就有一个。呃，我的肚子……";
			next;
			mes "[Police Officer Gerev]";
			mes "我一定又压力太大了。感觉肚子在绞痛……";
			close;
		case 3:
			erasequest 5315;// Gerev's Request
			ep15_1_mang = 0;
			if (isbegin_quest(5306) == 0) {
				setquest 5306;
				completequest 5306;
			}
			setquest 5311;
			close;
		case 4:
			emotion ET_OTL;
			mes "[Police Officer Gerev]";
			mes "……什、什么？呃……我、我的肚子……";
			close;
		}
	case 2:
		end;
	}
}

verus03,81,241,6	script	Police Officer Seiden#EP15_1	4_M_ORIENT02,{
	if (checkweight(1301,1) == 0) {
		mes "- 你携带的物品太多，无法继续。-";
		close;
	}
	.@quest_5307 = isbegin_quest(5307);// Police Officer Seiden
	.@quest_5309 = isbegin_quest(5309);// Police Chief's Request
	.@quest_5312 = isbegin_quest(5312);// Seiden's Problem
	.@quest_5314 = isbegin_quest(5314);// Salgran's Request
	.@quest_5315 = isbegin_quest(5315);// Gerev's Request
	.@quest_5316 = isbegin_quest(5316);// Seiden's Request
	.@quest_5317 = isbegin_quest(5317);// Piffs's Request
	.@playtime_5318 = checkquest(5318,PLAYTIME);

	if (.@quest_5309 != 1) {
		if (isbegin_quest(5307) == 0) {
			mes "[Police Officer Seiden]";
			mes "*窃笑* 我知道你是谁，但不想和你说话。";
			next;
			mes "他很可怕。";
			close;
		}
		emotion ET_KIK;
		mes "[Police Officer Seiden]";
		mes "*窃笑* 小心别招惹任何人的怒火。";
		close;
	}
	if (.@quest_5314 == 1 || .@quest_5315 == 1 || .@quest_5317 == 1) {
		if (isbegin_quest(5307) == 0) {
			mes "[Police Officer Seiden]";
			mes "*轻笑* 我知道你是谁，但我不想和你说话。";
			next;
			mes "He's creepy.";
			close;
		}
		if (isbegin_quest(5312) == 0) {
			emotion ET_KIK;
			mes "[Police Officer Seiden]";
			mes "*窃笑*……一颗心不能使用，否则会很麻烦。*窃笑*……";
			close;
		}
		emotion ET_KIK;
		mes "[Police Officer Seiden]";
		mes "*窃笑* 一次处理一件事，否则幻影之地的诅咒会降临。";
		close;
	}
	if (.@quest_5312 != 0) {
		emotion ET_KIK;
		mes "[Police Officer Seiden]";
		mes "*Chuckle* Be careful not to incur anyone's wrath.";
		close;
	}
	switch(.@quest_5316) {
	case 0:
		if (.@quest_5307 == 0) {
			emotion ET_KIK;
			mes "[Police Officer Seiden]";
			mes "*窃笑* 队长派你来的。我一直在等，所以知道。";
			next;
			emotion ET_SURPRISE, playerattached();
			mes "[" + strcharinfo(0) + "]";
			mes "?!";
			next;
			mes "[Police Officer Seiden]";
			mes "别问我怎么知道——我有消息来源。直说吧。";
			next;
			mes "[Police Officer Seiden]";
			mes "如果你愿意且不忙，我需要你的帮助。";
			next;
			if (select( "Sure.", "Not now." ) == 2) {
				emotion ET_SCRATCH;
				if (isbegin_quest(5307) == 0) {
					setquest 5307;
					completequest 5307;
				}
				setquest 5312;// Seiden's Problem
				mes "[Police Officer Seiden]";
				mes "我不明白。朋友发誓这对人从未失败，嗯……算了，告诉凯斯勒队长我这边一切顺利。";
				close;
			}
			emotion ET_KIK;
			mes "[Police Officer Seiden]";
			mes "*窃笑* 我就知道。啊，忘了我说过的话。";
			next;
			mes "[Police Officer Seiden]";
			mes "我的工作有点困难。";
			next;
			mes "[Police Officer Seiden]";
			mes "毁灭祈祷向我们投石，我担心会伤害无辜的人。";
			next;
			mes "[Police Officer Seiden]";
			mes "能帮忙捡起幻影之地的石头吗？现在先捡10块就够了。继续努力，总有一天能清理完。";
			next;
			if (select( "我会回来。", "下次吧。" ) == 2) {
				emotion ET_SCRATCH;
				if (isbegin_quest(5307) == 0) {
					setquest 5307;
					completequest 5307;
				}
				setquest 5312;// Seiden's Problem
				mes "[Police Officer Seiden]";
			mes "我不明白。我的朋友发誓这对人从未失败，嗯……算了，告诉 Kesler 队长我这边一切顺利。";
				close;
			}
			emotion ET_KIK;
			setquest 5316;
			ep15_1_mang = 0;
			mes "[Police Officer Seiden]";
			mes "*轻笑* 小石子不算。请带来 10 块足够放进手里的石头。";
			close;
		}
		emotion ET_KIK;
		mes "[Police Officer Seiden]";
		mes "*Chuckle* I thought it's about time.";
		next;
		mes "[Police Officer Seiden]";
		mes "*轻笑* 请像上次一样，清理幻影之地的石头。";
		next;
		if (select( "Sure.", "Maybe next time." ) == 1) {
			setquest 5316;
			ep15_1_mang = 0;
			mes "[Police Officer Seiden]";
		mes "小石子不算。请带来 10 块足够放进手里的石头。";
			close;
		}
		setquest 5312;
		mes "[Police Officer Seiden]";
		mes "你还在忙，对吧？不用担心。告诉 Kesler 队长我负责的区域一切安静。";
		close;
	case 1:
		emotion ET_KIK;
		mes "[Police Officer Seiden]";
		mes "*轻笑* 你把所有石头都捡起来了吗？";
		next;
		switch( select( "I did.", "Where are they?", "I don't have time for them.", "Never mind." ) ) {
		case 1:
			emotion ET_KIK;
			mes "[Police Officer Seiden]";
			if (ep15_1_mang < 10) {
				if (countitem(7049) < 10)
					mes "*轻笑* 它们在哪里？捡起来，否则受害者的灵魂会永远纠缠你。";
				else
					mes "*轻笑* 看看周围，到处都是石头。那你从哪里找到这块的？";
				close;
			}
			if (countitem(7049) < 10) {
				mes "*轻笑* 石头在哪里？请把它们带给我。";
				close;
			}
			delitem 7049,10;// Stone
			ep15_1_mang = 0;
			completequest 5316;
			if (isbegin_quest(5307) == 0) {
				setquest 5307;
				completequest 5307;
			}
			setquest 5312;
			mes "[Police Officer Seiden]";
				mes "*轻笑* 谢谢。受害者的灵魂暂时得到了安抚。";
			close;
		case 2:
			emotion ET_KIK;
			mes "[Police Officer Seiden]";
		mes "*轻笑* 到处都是石头。";
			next;
			mes "[Police Officer Seiden]";
		mes "搜寻地面。*轻笑* 真的还要我告诉你吗？";
			close;
		case 3:
			emotion ET_KIK;
			erasequest 5316;
			ep15_1_mang = 0;
			if (isbegin_quest(5307) == 0) {
				setquest 5307;
				completequest 5307;
			}
			setquest 5312;
			mes "[Police Officer Seiden]";
		mes "*轻笑* 请把石头放在远离道路的地方。小心受害者的灵魂！";
			close;
		case 4:
			emotion ET_KIK;
			mes "[Police Officer Seiden]";
		mes "*轻笑* 明白了。继续努力。";
			close;
		}
	case 2:
		end;
	}
}

verus03,127,36,4	script	???#EP15_1D_01	4_CRACK,{
	if (checkweight(1301,1) == 0) {
		mes "- 你携带的物品太多，无法继续任务。-";
		close;
	}
	.@quest_5315 = isbegin_quest(5315);// Gerev's Request
	.@quest_5316 = isbegin_quest(5316);// Seiden's Request
	if (.@quest_5315 == 1 || .@quest_5316 == 1) {
		if (.@quest_5315 == 1) {
			if (ep15_1_mang >= 10) {
			mes "你已经拆除了所有必须拆除的陷阱。";
				close;
			}
			emotion ET_SURPRISE;
			mes "地上的???看起来很可疑。你想做什么？";
			next;
			if (select( "检查。", "离开。" ) == 2) {
				mes "你决定不碰可疑物体。";
				close;
			}
			progressbar "00ff00",2;
			if (rand(2))
				mes "你决定那没什么。";
			else {
				mes "你拆除了毁灭祈祷的所有陷阱。";
				ep15_1_mang++;
			}
		}
		else {
			if (ep15_1_mang > 9) {
				mes "你捡起了10块大石头。把它们交给警官。";
				close;
			}
			mes "你发现一块半埋在地里的石头。要捡起来吗？";
			next;
			if (select( "捡起来。", "离开。" ) == 2) {
				mes "你决定留下鹅卵石。";
				close;
			}
			if (rand(2))
				mes "这块鹅卵石太小，投掷时无法造成严重伤害。";
			else {
				mes "你捡起了一块危险的大石头。";
				getitem 7049,1;
				ep15_1_mang++;
			}
		}
		close2;
		initnpctimer;
		disablenpc();
	}
	end;

OnTimer30000:
OnTimer60000:
OnTimer90000:
OnTimer120000:
	if (rand(1,2) != 1)
		end;
OnTimer150000:
	enablenpc();
	stopnpctimer;
	end;
}

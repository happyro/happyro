verus04,202,258,4	script	Police Officer Piffs#EP15_1	4_M_SAGE_C,{
	if (checkweight(1301,1) == 0) {
		mes "- 你携带的物品太多，无法继续。-";
		close;
	}
	.@quest_5308 = isbegin_quest(5308);// Police Officer Piffs
	.@quest_5309 = isbegin_quest(5309);// Police Chief's Request
	.@quest_5313 = isbegin_quest(5313);// Piffs's Problem
	.@quest_5314 = isbegin_quest(5314);// Salgran's Request
	.@quest_5315 = isbegin_quest(5315);// Gerev's Request
	.@quest_5316 = isbegin_quest(5316);// Seiden's Request
	.@quest_5317 = isbegin_quest(5317);// Piffs's Request
	.@playtime_5318 = checkquest(5318,PLAYTIME);

	mes "[Police Officer Piffs]";
	if (.@quest_5309 != 1) {
		if (isbegin_quest(5308) == 0) {
			emotion ET_HUNGRY;
			mes "*Yum Yum*";
			mes "嗯，这肉真好吃！";
			next;
			mes "他正在嚼肉。";
			close;
		}
		mes "[Police Officer Piffs]";
		mes "别担心。我会守护这片区域。";
		close;
	}
	if (.@quest_5314 == 1 || .@quest_5315 == 1 || .@quest_5316 == 1) {
		if (isbegin_quest(5308) == 0) {
			emotion ET_HUNGRY;
			mes "*Yum Yum*";
			mes "嗯，这肉真好吃！";
			next;
			mes "他正在嚼肉。";
			close;
		}
		if (isbegin_quest(5313) == 0) {
			mes "[Police Officer Piffs]";
			mes "你也在帮助其他区域？不忙时来帮我吧！";
			close;
		}
		emotion ET_BEST;
		mes "天啊，你同时负责多个区域？你是超人吗。";
		close;
	}
	if (.@quest_5313 != 0) {
		emotion ET_BEST;
		mes "放心，我在这里。";
		close;
	}
	switch(.@quest_5317) {
	case 0:
		if (.@quest_5308 == 0) {
			emotion ET_HUNGRY;
			mes "*大口咀嚼* 真好吃！";
			next;
			mes "[" + strcharinfo(0) + "]";
			mes "打扰一下。";
			next;
			emotion ET_HUK;
			mes "[Police Officer Piffs]";
			mes "糟糕。";
			mes "抱歉，我不该在公共场合吃零食。";
			next;
			mes "[Police Officer Piffs]";
			mes "你好。我叫皮夫斯，是贤者。我来研究幻影之地。";
			next;
			mes "[Police Officer Piffs]";
			mes "是队长派你来的吗？太好了。";
			next;
			emotion ET_QUESTION;
			mes "[Police Officer Piffs]";
			mes "我的物资快用完了，但不能离开岗位。你能帮我吗？";
			next;
			if (select("当然。", "现在不行。") == 2) {
				if (isbegin_quest(5308) == 0) {
					setquest 5308;// Police Officer Piffs
					completequest 5308;
				}
				setquest 5313;// Piffs's Problem
				mes "[Police Officer Piffs]";
				mes "我明白。改变主意后再回来找我。";
				close;
			}
			mes "[Police Officer Piffs]";
			mes "哈哈哈，谢谢。";
			next;
			mes "[Police Officer Piffs]";
			mes "这里相当安全，但驻扎在广场的同事容易被毁灭祈祷伤害。";
			next;
			mes "[Police Officer Piffs]";
			mes "我需要为他们采集草药，但正如我说的，不能离开岗位。";
			next;
			mes "[Police Officer Piffs]";
			mes "我知道这里哪里长着优质草药。能帮我采集吗？";
		}
		else {
			mes "哈哈！又见面了。是队长派你来的吗？";
			next;
			mes "[Police Officer Piffs]";
			mes "如果你不忙，我想请你再采集一些草药。可以吗？";
		}
		next;
		if (select( "当然。", "下次吧。" ) == 1) {
			setquest 5317;// Piffs's Request
			mes "[Police Officer Piffs]";
			mes "谢谢。看看灌木丛，你会发现草药。我只需要10株。";
			close;
		}
		if (isbegin_quest(5308) == 0) {
			setquest 5308;// Police Officer Piffs
			completequest 5308;
		}
		setquest 5313;// Piffs's Problem
		mes "[Police Officer Piffs]";
		mes "我明白。改变主意后再回来找我。";
		close;
	case 1:
		emotion ET_QUESTION;
		mes "欢迎回来。你找到所有草药了吗？";
		next;
		switch( select( "给你。", "在哪里能找到？", "我有更紧急的事。", "没事。" ) ) {
		case 1:
			mes "[Police Officer Piffs]";
			if (ep15_1_mang > 9 && countitem(6754) > 9) {
				delitem 6754,10;// Collected_Medicinal_Herbs
				ep15_1_mang = 0;
				completequest 5317;
				setquest 5313;
				if (isbegin_quest(5308) == 0) {
					setquest 5308;
					completequest 5308;
				}
				mes "谢谢你帮我储备草药。";
				next;
				mes "[Police Officer Piffs]";
				mes "这草药闻起来不错。做肉的配菜应该很好……*咳* 我不是想吃。";
			}
			else {
				mes "你说采集的草药在哪里？";
				next;
				mes "[Police Officer Piffs]";

//===== rAthena Script =======================================
//= 2006 Halloween Event
//===== By: ==================================================
//= Brainstorm
//===== Current Version: =====================================
//= 1.4
//===== Compatible With: =====================================
//= rAthena Project
//===== Description: =========================================
//= [Official Conversion]
//= Event 1: Redeem "Pumpkin Mojo" for pumpkin headgear.
//= Event 2: Create "Pumpkin Pie" item.
//===== Additional Comments: =================================
//= 1.0 First semi-working conversion. [Brainstorm]
//= 1.1 Refined Brainstorm's conversion. [L0ne_W0lf]
//= 1.1a Minor fixes. (Screwed up weight checks somehow) [L0ne_W0lf]
//= 1.2 Added missing checkweights. [L0ne_W0lf]
//= 1.3 Replaced effect numerics with constants. [L0ne_W0lf]
//= 1.3a Replaced effect numerics with constants (1 was missed). [Samuray22]
//= 1.4 Effects are now played by proper NPC. [L0ne_W0lf]
//============================================================

// Pumpkin Mojo quest (Event 1)
//============================================================
prontera,162,69,5	script	Gloomy Jack#06_hw	1130,2,2,{
	end;

OnTouch:
	mes "[Cool Devi]";
	mes "如果你有什么想对他说的话，";
	mes "就跟我说吧。";
	mes "你根本听不懂那个笨南瓜头Jack在说什么。";
	close;

OnEffect:
	specialeffect EF_LEVEL99;
	end;

OnEffect2:
	specialeffect EF_HIT2;
	end;
}

prontera,164,69,3	script	Cool Devi#06_hw	738,{
	if (MaxWeight - Weight < 2000 || checkweight(1201,1) == 0) {
		mes "^3355FF等一下！";
		mes "你现在携带的物品太多了。";
		mes "请先回来，";
		mes "使用卡普拉服务";
		mes "整理物品后";
		mes "存放一些物品后再回来。^000000";
		close;
	}
	if (countitem(7609) > 0) {
		mes "[Gloomy Jack]";
		mes "等等，你带着的是南瓜魔力吗？";
		mes " ";
		mes "[Cool Devi]";
		mes "他说。";
		next;
		mes "[Gloomy Jack]";
		mes "把它给我，我会补偿你。";
		mes " ";
		mes "[Cool Devi]";
		mes "他说……";
		mes "我大概能猜到他接下来要说什么。你觉得呢？";
		next;
		if (select("他会说什么？:我也知道。") == 1) {
			mes "[" + strcharinfo(0) + "]";
			mes "他会说什么？";
			next;
			mes "[Cool Devi]";
			mes "Jack和其他人不一样，他是万圣节Jack。";
			mes "但有一天，他失去了南瓜魔力，变成了忧郁的Jack……";
			mes "南瓜魔力就是他的一切。";
			next;
			mes "[Cool Devi]";
			mes "其实，这正是Jack来到城里的主要原因。";
			mes "他要找回南瓜魔力。最可疑的嫌疑犯是^4d4dff愉快的Lude^000000，也就是万圣节怪物。";
			next;
			mes "[Cool Devi]";
			mes "把‘南瓜魔力’还给他吧。";
			mes "别担心，他会补偿你的。";
			next;
			mes "[" + strcharinfo(0) + "]";
			mes "补偿？用什么补偿？";
			next;
			mes "[Cool Devi]";
			mes "如果你带来^4d4dff1个南瓜魔力^000000和我们去年发给你的南瓜头，";
			mes "他会把它制作成^00ff00最棒的南瓜帽^000000。";
			mes "如果没有南瓜头，也可以带^3d3dff南瓜魔力、南瓜和帽子^000000。";
			next;
			mes "[Cool Devi]";
			mes "只带着南瓜魔力是没用的。";
			mes "把它给Jack吧。你不觉得他很可怜吗？";
			close;
		}
		mes "[Cool Devi]";
		mes "哦～太好了。";
		mes "让我看看你带了什么。";
		next;
		if ((countitem(7609) > 0) && (countitem(5134) > 0)) {
			mes "[Gloomy Jack]";
			mes "哦，你带来了南瓜头！";
			mes "我会给你做一顶更漂亮的。";
			mes " ";
			mes "[Cool Devi]";
			mes "他说。";
			next;
			if (select( "不，我以后再来。:哦，好，现在就做！") == 1) {
				mes "[Gloomy Jack]";
				mes "咦？";
				mes " ";
				mes "[Cool Devi]";
				mes "什么？看看Jack，他多么失望。";
				mes "答应我以后总有一天会把南瓜魔力还给Jack，好吗？";
				close;
			}
			mes "[Gloomy Jack]";
			mes "谢谢你归还我的东西，我会把你的帽子做得更漂亮。";
			mes " ";
			mes "[Cool Devi]";
			mes "他说。";
			next;
			donpcevent "Gloomy Jack#06_hw::OnEffect";
			mes "[Excited Jack]";
			mes "啦啦啦～啦啦啦～";
			mes " ";
			mes "（他开始唱歌。突然，Jack的气场出现了。）";
			delitem 7609,1; //Pumpkin_Mojo
			delitem 5134,1; //Pumpkin_Hat
			getitem 5202,1; //Pumpkin_Hat_
			next;
			donpcevent "Gloomy Jack#06_hw::OnEffect2";
			mes "[Gloomy Jack]";
			mes "我的气场不像以前了。也许我需要更多南瓜魔力。";
			mes " ";
			mes "[Cool Devi]";
			mes "他说……";
			next;
			mes "[Cool Devi]";
			mes "哦～可怜的Jack。";
			mes "总有一天，他会找回全部南瓜魔力。";
			close;
		}
		else if ((countitem(7609) > 0) && (countitem(535) > 0) && (countitem(2226) > 0)) {
			mes "[Gloomy Jack]";
			mes "哇！";
			mes "我会把你的帽子变得很酷。";
			mes " ";
			mes "[Cool Devi]";
			mes "他说……";
			next;
			if (select( "No, I'll come back later.:Oh,good. Make it now!") == 1) {
				mes "[Gloomy Jack]";
				mes "咦？";
				mes " ";
				mes "[Cool Devi]";
				mes "什么？看看Jack，他多么失望。";
				mes "答应我以后总有一天会把南瓜魔力还给Jack，好吗？";
				close;
			}
			mes "[Gloomy Jack]";
			mes "谢谢你归还我的东西，我会把你的帽子做得更漂亮。";
			mes " ";
			mes "[Cool Devi]";
			mes "他说。";
			next;
			donpcevent "Gloomy Jack#06_hw::OnEffect";
			mes "[Excited Jack]";
			mes "啦啦啦～啦啦啦～";
			mes " ";
			mes "（他开始唱歌。突然，Jack的气场出现了。）";
			delitem 7609, 1;//Pumpkin_Mojo
			delitem 535, 1;//Pumpkin
			delitem 2226, 1;//Cap
			getitem 5202, 1;//Pumpkin_Hat_
			next;
			donpcevent "Gloomy Jack#06_hw::OnEffect2";
			mes "[Gloomy Jack]";
			mes "我的气场不像以前了。也许我需要更多南瓜魔力。";
			mes " ";
			mes "[Cool Devi]";
			mes "他说……";
			next;
			mes "[Cool Devi]";
			mes "哦～可怜的Jack。";
			mes "总有一天，他会找回全部南瓜魔力。";
			close;
		}
		else {
			mes "[Cool Devi]";
			mes "嘿，你似乎没有制作这顶神奇帽子的全部材料。";
			close;
		}
	}
	else {
		mes "[Gloomy Jack]";
		mes "嘿，你为什么不来听听我的故事？";
		mes " ";
		mes "[Cool Devi]";
		mes "他说。";
		next;
		mes "[Gloomy Jack]";
		mes "我曾经非常有名，但现在……";
		mes " ";
		mes "[Cool Devi]";
		mes "他说……";
		mes "好吧，我就不翻译，直接告诉你。";
		next;
		mes "[Cool Devi]";
		mes "Jack和其他人不一样，他是万圣节Jack。";
		mes "但有一天，他失去了南瓜魔力，变成了忧郁的Jack……";
		mes "南瓜魔力就是他的一切。";
		next;
		mes "[Cool Devi]";
		mes "其实，这正是Jack来到城里的主要原因。";
		mes "他要找回南瓜魔力。最可疑的嫌疑犯是^4d4dff愉快的Lude^000000，也就是万圣节怪物。";
		next;
		mes "[Cool Devi]";
		mes "把‘南瓜魔力’还给他吧。";
		mes "别担心，他会补偿你的。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "补偿？用什么补偿？";
		next;
		mes "[Cool Devi]";
		mes "如果你带来^4d4dff1个南瓜魔力^000000和我们去年发给你的南瓜头，";
		mes "他会把它制作成^00ff00最棒的南瓜帽^000000。";
		mes "如果没有南瓜头，也可以带^3d3dff南瓜魔力、南瓜和帽子^000000。";
		next;
		mes "[Cool Devi]";
		mes "只带着南瓜魔力是没用的。";
		mes "把它给Jack吧。你不觉得他很可怜吗？";
		close;
	}
}


geffen,145,132,3	script	Hoirin#06_hw	729,{
	if (MaxWeight - Weight < 2000 || checkweight(1201,1) == 0) {
		mes "^3355FF等一下！";
		mes "你现在携带的物品太多了。";
		mes "请先回来，";
		mes "使用卡普拉服务";
		mes "整理物品后";
		mes "存放一些物品后再回来。^000000";
		close;
	}
	if (halloween < 100) {
		mes "[Hoirin]";
		mes "南瓜是上帝送给我们的礼物。";
		mes "它营养丰富，能帮助你保持健康！";
		mes "好极了～好极了～！";
		next;
		mes "[Hoirin]";
		mes "我，Hoirin一直在思考";
		mes "如何让南瓜吃起来更美味。";
		mes "但突然之间，我想到了。";
		next;
		mes "[Hoirin]";
		mes "只要有那个！我就能做出最棒的南瓜派！！！";
		next;
		if (select( "那是什么？:不理他。") == 1) {
			mes "[Hoirin]";
			mes "想到南瓜时，你首先想到什么？";
			mes "我想到Jack！我认为Jack是南瓜进化的最高形态！";
			mes "Jack到底有什么特别之处？你能想象吗？";
			next;
			mes "[Hoirin]";
			mes "我一直喜欢独特的南瓜料理！最近我发现世界上有很多种Jack，";
			mes "而极限等级的Jack身体周围有蓝色气场！";
			next;
			mes "[Hoirin]";
			mes "猜猜是什么？！那就是万圣节Jack！";
			mes "万圣节Jack拥有一种由南瓜凝聚而成的东西。";
			mes "它叫做^4d4dff南瓜魔力^000000。只有得到它，我才能完成特制南瓜派。";
			next;
			mes "[Hoirin]";
			mes "把材料带给我！";
			mes "我马上为你做一份特别的南瓜派！";
			mes "你会吃上瘾的。";
			mes "尝过后可别惊讶。";
			next;
			mes "[" + strcharinfo(0) + "]";
			mes "......................";
			mes "你真是个热情的人。";
			mes "那么，材料到底是什么？";
			next;
			mes "[Hoirin]";
			mes "问得好！";
			mes "制作特制南瓜派，我需要";
			mes "^4d4dff1个南瓜魔力";
			mes "2个南瓜";
			mes "2个蛋^000000";
			next;
			mes "[Hoirin]";
			mes "只要带来南瓜魔力、南瓜和蛋。";
			mes "剩下的交给我……你会尝到最棒的南瓜派！";
			set halloween, 100;
			close;
		}
		mes "[Hoirin]";
		mes "嗯……你会后悔的！";
		mes "Hoirin的南瓜派实在太好吃了。";
		close;
	}
	else {
		mes "[Hoirin]";
		mes "那么，你把所有材料都带来了吗？";
		mes "有没有什么很难找？";
		next;
		switch(select( "我带齐了所有材料。:怎样才能得到蛋？:不，我只是路过。")) {
		case 1:
			if ((countitem(7609) > 0) && (countitem(535) > 1) && (countitem(574) > 1)) {
				mes "[Hoirin]";
				mes "没错！";
				mes "你把东西都带齐了。交给我吧！！";
				specialeffect2 EF_HIT1;
				next;
				specialeffect EF_PIERCESELF;
				mes "[Hoirin]";
				mes "阿布拉卡达布拉～～";
				mes "阿布拉卡达布拉～～！";
				next;
				mes "[Hoirin]";
				mes "锵锵！";
				mes "给你～请享用。";
				mes "这对你的健康有益，我还添加了额外营养。";
				delitem 7609,1; //Pumpkin_Mojo
				delitem 535,2; //Pumpkin
				delitem 574,2; //Egg
				getitem 12192,1; //Pumpkin_Pie
				close;
			}
			else {
				mes "[Hoirin]";
				mes "不！！这还不够。我至少需要";
				mes "^4d4dff1个南瓜魔力";
				mes "2个南瓜";
				mes "2个蛋^000000";
				mes "。";
				close;
			}
		case 2:
			if (halloween == 100) {
				mes "[Hoirin]";
				mes "蛋？";
				mes "其实，我知道有人能帮助你。";
				mes "有个人养了很多鸡。";
				next;
				mes "[Hoirin]";
				mes "如果你愿意，我可以送你去他那里。";
				mes "^4d4dff但只能去一次^000000。";
				next;
				if (select("送我过去。:没关系。") == 1) {
					mes "[Hoirin]";
					mes "好，去拿蛋吧。";
					set halloween, 101;
					close2;
					warp "nif_fild01", 162, 113;
					end;
				}
				mes "[Hoirin]";
				mes "你觉得没有我的帮助也能去吗？！";
				mes "好！去吧。";
				mes "你知道在哪里吗？";
				close;
			}
			else {
				mes "[Hoirin]";
				mes "如果你去^4d4dff尼夫海姆的骷髅镇农场^000000，就能见到Chicken Masta。他养鸡。";
				close;
			}
		case 3:
			mes "[Hoirin]";
			mes "下次别忘了带来";
			mes "南瓜派的所有材料！";
			close;
		}
	}
}

nif_in,18,34,5	script	Loli Ruri#06_hw	1505,2,2,{
	end;

OnTouch:
	mes "[Deviruchi]";
	mes "你好，如果你有什么想对Loli Ruri说的话，就跟我说。";
	mes "她还不习惯人类的语言。";
	close;
}

nif_in,19,32,3	script	Deviruchi#06_hw	738,{
	if (MaxWeight - Weight < 2000 || checkweight(1201,1) == 0) {
		mes "^3355FF等一下！";
		mes "你现在携带的物品太多了。";
		mes "请先回来，";
		mes "使用卡普拉服务";
		mes "整理物品后";
		mes "存放一些物品后再回来。^000000";
		close;
	}
	mes "[Loli Ruri]";
	mes "Devi～南瓜派在哪里？";
	mes "是人类做的，对吧？";
	mes "你有南瓜派吗？";
	mes " ";
	mes "[Deviruchi]";
	mes "她说。";
	next;
	mes "[Deviruchi]";
	mes "如果你有南瓜派，可以给我一个吗？";
	mes "因为Loli Ruri生气的话，我们会遭殃。";
	next;
	mes "[Deviruchi]";
	mes "我不是想免费拿。";
	mes "别担心，我不会让你失望。";
	next;
	switch(select( "给他南瓜派。:不给他南瓜派。:咦？什么南瓜派？")) {
	case 1:
		if (countitem(12192) > 0) {
			mes "[Loli Ruri]";
			mes "谢谢你的南瓜派！";
			mes "给你，拿着这个。";
			mes " ";
			mes "[Deviruchi]";
			mes "她说。";
			next;
			mes "[Deviruchi]";
			mes "如我所说，我会给你价值相当于南瓜派的东西。";
			mes "等一下……";
			next;
			mes "[Deviruchi]";
			mes "嗯……这个不错。";
			mes "给你，再次感谢～";
			delitem 12192, 1;//Pumpkin_Pie
			set @hw_temp,rand(1,3);
			if (@hw_temp == 2) getitem 12130,1; //Cookie_Bag
			else getitem 7460,3; //Nifl_Express_Ticket
			close;
		}
		else {
			mes "[Loli Ruri]";
			mes "你在开玩笑吗？";
			mes "南瓜派在哪里！别想骗我！";
			mes " ";
			mes "[Deviruchi]";
			mes "她说……看来她很生气……你有麻烦了。";
			next;
			mes "[Loli Ruri]";
			mes "Devi！！！！！是你告诉我，只要站在这里等就能拿到南瓜派。";
			mes "小心你的背后！";
			mes " ";
			mes "[Deviruchi]";
			mes "她说……咦？！！我？！！";
			next;
			mes "[" + strcharinfo(0) + "]";
			mes "可怜的Devi～";
			mes "你不该撒谎～";
			mes "祝你好运。";
			close;
		}
	case 2:
		mes "[Loli Ruri]";
		mes "我想吃南瓜派。可以给我一个吗？拜托～～～～";
		mes " ";
		mes "[Deviruchi]";
		mes "他说……如果你有，就给我一个。";
		close;
	case 3:
		mes "[Deviruchi]";
		mes "有个人会制作非常特别的南瓜派。";
		mes "吃过的人都不会忘记它的味道。";
		next;
		mes "[Deviruchi]";
		mes "Loli Ruri正在这里等待有人给她带来南瓜派。";
		mes "你能给她带一个吗？";
		mes "我会回报你的。";
		close;
	}
}


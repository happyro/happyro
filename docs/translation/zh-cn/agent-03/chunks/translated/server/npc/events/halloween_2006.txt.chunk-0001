//============================================================
nif_fild01,165,115,3	script	Chicken Masta#06_hw	794,{
	if (MaxWeight - Weight < 2000 || checkweight(1201,1) == 0) {
		mes "^3355FF等一下！";
		mes "你现在携带的物品太多了。";
		mes "请先回来，";
		mes "使用卡普拉服务";
		mes "整理物品后";
		mes "存放一些物品后再回来。^000000";
		close;
	}
	if (halloween == 101) {
		mes "[Chicken Masta]";
		mes "鸡都去哪儿了？！";
		mes "哦，陌生人，你好。有什么我能帮你的吗？";
		next;

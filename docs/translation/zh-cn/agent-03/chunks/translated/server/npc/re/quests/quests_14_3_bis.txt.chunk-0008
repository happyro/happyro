			mes "但和所有贵族出身的人一样，";
			mes "我只知道如何命令别人。";
			emotion 19, playerattached();
			close;
		}
		mes "[Base Investigator]";
		mes "快点，那些怪物现在还在繁殖。";
		next;
		mes "[Base Investigator]";
		mes "请消灭";
		mes "20 只^0000FF火焰沙人^000000";
		mes "以及 20 只^0000FF火焰弗里多拉^000000。";
		completequest 1267;	// Flaming Basin and Doom Prayers
		setquest 1268;	// Flaming Basin and Doom Prayers
		setquest 1269;	// Flaming Basin and Doom Prayers
		ep14_3_fall_bless = 5;
		close;
	}
	if (ep14_3_fall_bless == 5) {
		if (checkquest(1268,HUNTING) == 2 && checkquest(1269,HUNTING) == 2) {
			mes "[Base Investigator]";
			mes "你消灭了";
			mes "20 只^0000FF火焰沙人^000000";
			mes "以及我命令的 20 只^0000FF火焰弗里多拉^000000。";
			next;
			mes "[Base Investigator]";
			mes "多亏了你，我们找到了有效对付这些怪物的方法。";
			next;
			mes "[Base Investigator]";
			mes "从现在开始由我的士兵接手。";
			completequest 1268;	// Flaming Basin and Doom Prayers
			completequest 1269;	// Flaming Basin and Doom Prayers
			setquest 1297;	// Flaming Basin and Doom Prayers
			ep14_3_fall_bless = 6;
			getexp 0,100000;
			close;
		}
		mes "[Base Investigator]";
		mes "快点，那些怪物正在";
		mes "不断繁殖。";
		next;
		mes "[Base Investigator]";
		mes "请消灭";
		mes "20 只^0000FF火焰沙人^000000";
		mes "以及 20 只^0000FF火焰弗里多拉^000000。";
		close;
	}
	mes "[Base Investigator]";
	mes "这里交给我们处理，你继续向北走。";
	mes "我希望你处理一下那边那群奇怪的人。";
	next;
	mes "[Base Investigator]";
	mes "他们突然凭空出现。";
	mes "想尽办法骚扰我们。";
	emotion 28;
	close;

OnInit:
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "BaseLevel >= 150 && isbegin_quest(1264) == 0 && ep14_3_fall_bless == 0" );
	end;
}

//gef_fild02,106,225,4	script	Scout#bl	4_M_CRU_SOLD,{
moro_vol,234,301,3	script	Scout#bl	4_M_CRU_SOLD,{
	if (checkweight(1301,3) == 0) {
		mes "- 由于携带的物品太多，无法继续对话。-";
		close;
	}
	if (ep14_3_fall_bless == 0) {
		mes "[Scout]";
		mes "我被派来调查这些怪物。";
		mes "让我一个人";
		mes "待在这个危险的地方却没有援军，太不公平了！";
		close;
	}
	if (ep14_3_fall_bless == 1) {
		mes "[Scout]";
		mes "我被派来调查这些怪物。";
		mes "让我一个人";
		mes "待在这个危险的地方却没有援军，太不公平了！";
		next;
		mes "[Scout]";
		mes "啊，我要擅自离队了！";
		close;
	}
	if (ep14_3_fall_bless == 2) {
		mes "[Scout]";
		mes "欢迎！";
		mes "我急需帮助！";
		next;
		mes "[Scout]";
		mes "我独自来这里执行侦察任务。";
		mes "一群怪物包围了我，让我无法离开，";
		mes "所以我只能留在这里。";
		next;
		if (select("那就继续待着吧。", "和我一起回去吧。") == 1) {
			mes "[Scout]";
			mes "你是怕我会求助，";
			mes "我明白了。";
			close;
		}
		mes "[Scout]";
		mes "我没有受伤，只是有几处擦伤，";
		mes "但^0000FF火焰沙人^000000偷走了";
		mes "我的^FF0000侦察日志^000000。";
		next;
		mes "[Scout]";
		mes "没有^FF0000侦察日志^000000我就无法回去。";
		mes "如果我的上级不";
		mes "对我进行军事审判，我就算走运了。";
		next;
		mes "[Scout]";
		mes "我听起来不可怜吗？";
		mes "这难道不能激励你帮助我吗？";
		next;
		if (select("才不要。", "确实。") == 1) {
			mes "[Scout]";
			mes "好吧，那我只能";
			mes "留在这里等援军。";
			close;
		}
		mes "[Scout]";
		mes "好吧，你可以这样帮我：";
		mes "请带来^FF0000侦察日志^000000";
		mes "来自^0000FF火焰沙人^000000的。";
		next;
		mes "[Scout]";
		mes "日志可能被那些野蛮怪物撕成了几页。";
		mes "我不在乎；我仍然需要把它们交给上级。";
		mes "请带给我";
		mes "20 本^FF0000侦察日志^000000。";
		next;
		mes "[Scout]";
		mes "小心——它们会伏击你，在你察觉前抢走^FF0000侦察日志^000000。";
		completequest 1265;	// Flaming Basin and Doom Prayers
		setquest 1266;	// Flaming Basin and Doom Prayers
		ep14_3_fall_bless = 3;
		close;
	}
	if (ep14_3_fall_bless == 3) {
		if (countitem(6692) < 20) {
			mes "[Scout]";
			mes "请带来 20 本^FF0000侦察日志^000000";
			mes "来自^0000FF火焰沙人^000000的。";
			next;
			mes "[Scout]";
			mes "小心——它们会伏击你，在你察觉前抢走^FF0000侦察日志^000000。";
			close;
		}
		mes "[Scout]";
		mes "你已经找到";
		mes "20 ^FF0000Scout Journals^000000?";
		mes "早知道你这么快，我就让你带 100 页了。";
		next;
		mes "[Scout]";
		mes "想到惩罚，我的伤口都在作痛";
		mes "基地可能正在等着惩罚我。";
		next;
		mes "[Scout]";
		mes "整理完这些页面后我就跟着你。";
		mes "请向调查员报告";
		mes "并替我说几句好话";
		mes "。";
		delitem 6692,20;// PatrolLog
		completequest 1266;	// Flaming Basin and Doom Prayers
		setquest 1267;	// Flaming Basin and Doom Prayers
		ep14_3_fall_bless = 4;
		close;
	}
	if (ep14_3_fall_bless == 4) {
		mes "[Scout]";
		mes "整理完这些页面后我就跟着你。";
		mes "请向调查员报告";
		mes "并替我说几句好话";
		mes "。";
		close;
	}
	mes "[Scout]";
	mes "我被派来调查这些怪物。";
	mes "让我一个人";
	mes "待在这个危险的地方却没有援军，太不公平了！";
	close;
}

moro_vol,227,294,0	script	#bg1	HIDDEN_WARP_NPC,2,2,{
	end;
OnTouch:
	if (ep14_3_fall_bless != 3)
		end;
	getmapxy .@map$,.@x,.@y, BL_NPC;
	sscanf( strnpcinfo(2), "bg%d", .@npc_num );
	if (.@npc_num == 9) {
		.@count = 2;
		.@y = 302;
	}
	else if (.@npc_num == 1 || .@npc_num == 4 || .@npc_num == 5 || .@npc_num == 7 || .@npc_num == 8)
		.@count = 3;
	else
		.@count = 2;
	if (countitem(6692) >= .@count) {
		mes "你被火焰沙人伏击了！";
		delitem 6692, .@count;// PatrolLog
		monster "moro_vol",.@x,(.@y-2)," ",3021,1;
		monster "moro_vol",.@x,(.@y-1)," ",3021,1;
		monster "moro_vol",.@x,.@y," ",3021,1;
		close;
	}
	end;
}
moro_vol,236,292,0	duplicate(#bg1)	#bg2	HIDDEN_WARP_NPC,2,2

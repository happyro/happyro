// moro_vol,104,141,3	script	Doom Prayers Leader#bl	4_M_BELIEVER01,{
moro_vol,91,197,3	script	Doom Prayers Leader#bl	4_M_BELIEVER01,{
	if (checkweight(1301,3) == 0) {
		mes "- 由于携带的物品太多，无法继续对话。-";
		close;
	}
	if (ep14_3_fall_bless < 6) {
		mes "[Doom Prayers Leader]";
		mes "末日终于降临了！";
		mes "毁灭就是祝福！";
		next;
		mes "[Doom Prayers Leader]";
		mes "引导我们进入内部！";
		mes "我们是众神选中的人！";
		mes "世界毁灭之日开始了。";
		next;
		mes "[Doom Prayers Leader]";
		mes "以血还血～～";
		mes "我是说，毁灭很好！";
		mes "毁灭就是祝福！";
		close;
	}
	if (ep14_3_fall_bless == 6) {
		mes "[Doom Prayers Leader]";
		mes "末日终于降临了！";
		mes "毁灭就是祝福！";
		next;
		mes "[Doom Prayers]";
		mes "毁灭！就是！祝福！";
		mes "毁灭！就是！祝福！";
		next;
		mes "[Doom Prayers]";
		mes "毁灭！祝福！";
		mes "我们是被选中的人！";
		next;
		mes "[Doom Prayers Leader]";
		mes "引导我们进入内部！";
		mes "我们是众神选中的人！";
		mes "世界毁灭之日开始，";
		next;
		mes "[Doom Prayers Leader]";
		mes "枪是好的！";
		mes "HODE 是邪恶的！";
		next;
		switch( select( "你侍奉哪位神？", "你们是谁？", "回去！" ) ) {
		case 1:
			mes "[Doom Prayers Leader]";
			mes "我们侍奉毁灭之神！";
			mes "他掌管一切毁灭——从一颗星辰的毁灭到整个星系的毁灭，";
			mes "从我的早餐腐坏到晚餐腐坏。";
			close;
		case 2:
			mes "[Doom Prayers Leader]";
			mes "我们是末日祈祷者！";
			mes "我们侍奉毁灭之神，";
			mes "并祈祷他以世界末日祝福我们。";
			next;
			mes "[Doom Prayers Leader]";
			mes "只有当其他一切都被毁灭后，";
			mes "我们才能真正得到祝福。";
			next;
			mes "[Doom Prayers Leader]";
			mes "那些突然出现的裂缝";
			mes "地面上的裂缝。";
			mes "那些会说话的猫。";
			mes "那些绿色巨人。";
			next;
			mes "[Doom Prayers Leader]";
			mes "它们证明末日将近！";
			mes "哦，末日已经到来！";
			mes "毁灭就是祝福！";
			close;
		case 3:
			mes "[Doom Prayers Leader]";
			mes "不，我们不会！";
			mes "末日终于降临了！";
			mes "我们渴望这份祝福很久了！";
			mes "我想在所有人之前到达那里！";
			next;
			mes "[Doom Prayers Leader]";
			mes "绝不，我们不会走！";
			mes "让我们进去！";
			mes "我们被毁灭之神选中了。";
			mes "和你不同，我们是无敌的！";
			next;
			select("你能证明吗？");
			mes "[Doom Prayers Leader]";
			mes "你竟敢挑战我？！";
			mes "好，我证明给你看！";
			next;
			mes "[Doom Prayers Leader]";
			mes "搜索这片末日之地，找到^FF000040 祝福石^000000。";
			mes "把它们扔向我们，你就会看到。";
			next;
			mes "[Doom Prayers Leader]";
			mes "它们击中我们身体的瞬间，";
			mes "就会砰的一声变成花瓣！";
			mes "毁灭就是祝福！";
			next;
			select("末日之地？");
			mes "[Guard]";
			mes "那些疯子就是这样称呼这片火焰盆地的。";
			next;
			mes "[Guard]";
			mes "他们称为^FF0000祝福石^000000的东西，其实只是^0000FF火焰魔像^000000掉落的碎片。";
			next;
			mes "要让这些疯子离开，唯一办法就是证明他们错了。";
			mes "你想猎杀^0000FF火焰魔像^000000";
			mes "并收集 40 个^FF0000祝福石^000000吗？";
			next;
			if (select( "不，我一点也不在乎！", "我会收集石头。" ) == 1) {
				mes "[Doom Prayers Leader]";
				mes "我看你是害怕见证神的恩典，担心那会改变你的想法。";
				mes "别烦我，滚开！";
				mes "毁灭就是祝福！";
				close;
			}
			mes "[Doom Prayers Leader]";
			mes "去吧，带来^FF0000祝福石^000000扔向我们！";
			mes "你会看到石头变成飘落的花瓣！";
			mes "然后你会哭着求我让你加入我们。";
			completequest 1297;	// Flaming Basin and Doom Prayers
			setquest 1270;	// Flaming Basin and Doom Prayers
			ep14_3_fall_bless = 7;
			close;
		}
	}
	if (ep14_3_fall_bless == 7) {
		if (countitem(6693) < 39) {	// Stone_Of_Blessing
			mes "[Doom Prayers Leader]";
			mes "搜索这片末日之地，找到^FF000040 祝福石^000000。";
			mes "把它们扔向我们，你就会看到。";
			next;
			mes "[Doom Prayers Leader]";
			mes "它们击中我们身体的瞬间， they'll turn into flower petals with a loud pop!";
			mes "毁灭就是祝福！";
			next;
			mes "猎杀^0000FF火焰魔像^000000并收集 40 个^FF0000祝福石^000000。";
			close;
		}
		mes "[Doom Prayers Leader]";
		mes "你带来了 40 个^FF0000祝福石^000000。";
		mes "好，我们准备好了。";
		mes "把石头扔向我们！";
		next;
		mes "[Doom Prayers Leader]";
		mes "准备见证奇迹吧！";
		mes "来吧，用力打我们！";
		mes "毁灭就是祝福！";
		next;
		mes "*Whiz*";
		mes "*WHIZZ*";
		next;
		mes "*Whiz*";
		mes "*WHIZZ*";
		mes "*WHIZZ*";
		mes "*WHIZZ*";
		next;
		mes "[Doom Prayers]";
		mes "哎哟！";
		emotion 19;
		emotion 19, getnpcid(0, "Doom Prayers Second-in-command#bl");
		emotion 28, getnpcid(0, "Doom Prayer#bl1");
		emotion 19, getnpcid(0, "Doom Prayer#bl2");
		emotion 19, getnpcid(0, "Doom Prayer#bl3");
		emotion 28, getnpcid(0, "Doom Prayer#bl4");
		next;
		mes "[Doom Prayers]";
		mes "哎哟！";
		mes "哎哟！天啊！";
		emotion 19;
		emotion 19, getnpcid(0, "Doom Prayers Second-in-command#bl");
		emotion 28, getnpcid(0, "Doom Prayer#bl1");
		emotion 19, getnpcid(0, "Doom Prayer#bl3");
		emotion 28, getnpcid(0, "Doom Prayer#bl4");
		emotion 19, getnpcid(0, "Doom Prayer#bl6");
		emotion 28, getnpcid(0, "Doom Prayer#bl7");
		emotion 19, getnpcid(0, "Doom Prayer#bl9");
		emotion 28, getnpcid(0, "Doom Prayer#bl0");
		emotion 19, getnpcid(0, "Doom Prayer#bl12");
		next;
		mes "[Doom Prayers]";
		mes "呀啊——！";
		mes "啊！呃！";
		emotion 19;
		emotion 19, getnpcid(0, "Doom Prayers Second-in-command#bl");
		emotion 28, getnpcid(0, "Doom Prayer#bl1");
		emotion 4, getnpcid(0, "Doom Prayer#bl2");
		emotion 19, getnpcid(0, "Doom Prayer#bl3");
		emotion 28, getnpcid(0, "Doom Prayer#bl4");
		emotion 4, getnpcid(0, "Doom Prayer#bl5");
		emotion 19, getnpcid(0, "Doom Prayer#bl6");
		emotion 28, getnpcid(0, "Doom Prayer#bl7");
		emotion 19, getnpcid(0, "Doom Prayer#bl8");
		emotion 19, getnpcid(0, "Doom Prayer#bl9");
		emotion 28, getnpcid(0, "Doom Prayer#bl0");
		emotion 19, getnpcid(0, "Doom Prayer#bl11");
		emotion 19, getnpcid(0, "Doom Prayer#bl12");
		next;
		mes "[Doom Prayers Leader]";
		mes "好痛！";
		mes "痛死了！";
		mes "停下！别再打我的脸！";
		next;
		if (select( "继续扔。", "停止投掷。") == 2) {
			mes "石头没有变成花瓣，反而给被击中的人带来了剧痛。";
			mes "你决定停止投掷石头。";
			delitem 6693,40;// Stone_Of_Blessing
			completequest 1270;	// Flaming Basin and Doom Prayers
			setquest 1271;	// Flaming Basin and Doom Prayers
			ep14_3_fall_bless = 8;
			close;
		}
		mes "[Doom Prayers]";
		mes "哎哟！";
		mes "我的头！";
		mes "啊！呀啊——！";
		emotion 19;
		emotion 19, getnpcid(0, "Doom Prayers Second-in-command#bl");
		emotion 28, getnpcid(0, "Doom Prayer#bl1");
		emotion 19, getnpcid(0, "Doom Prayer#bl2");
		emotion 19, getnpcid(0, "Doom Prayer#bl3");
		emotion 28, getnpcid(0, "Doom Prayer#bl4");
		next;
		mes "[Doom Prayers]";
		mes "呀啊——！";
		mes "我的鼻子！";
		mes "呀啊——！呀啊啊——！";
		emotion 19;
		emotion 19, getnpcid(0, "Doom Prayers Second-in-command#bl");
		emotion 28, getnpcid(0, "Doom Prayer#bl1");
		emotion 4, getnpcid(0, "Doom Prayer#bl2");
		emotion 19, getnpcid(0, "Doom Prayer#bl3");
		emotion 28, getnpcid(0, "Doom Prayer#bl4");
		emotion 4, getnpcid(0, "Doom Prayer#bl5");
		emotion 19, getnpcid(0, "Doom Prayer#bl6");
		emotion 28, getnpcid(0, "Doom Prayer#bl7");
		emotion 19, getnpcid(0, "Doom Prayer#bl8");
		emotion 19, getnpcid(0, "Doom Prayer#bl9");
		emotion 28, getnpcid(0, "Doom Prayer#bl0");
		emotion 19, getnpcid(0, "Doom Prayer#bl11");
		emotion 19, getnpcid(0, "Doom Prayer#bl12");
		next;
		mes "[Doom Prayers Leader]";
		mes "好痛！";
		mes "痛死了！";
		mes "我还没准备好！";
		mes "停下！重新来过！";
		close;
	}
	if (ep14_3_fall_bless == 8) {
		mes "[Doom Prayers Leader]";
		mes "兄弟姐妹们，冷静！";
		mes "那个异教徒用错误的石头骗了我们！";
		next;
		mes "[Doom Prayers]";
		mes "我就知道！";
		next;
		mes "[Doom Prayers]";
		mes "嘘！";
		mes "嘘！";
		emotion 32;
		emotion 32, getnpcid(0, "Doom Prayers Second-in-command#bl");
		emotion 6, getnpcid(0, "Doom Prayer#bl1");
		emotion 6, getnpcid(0, "Doom Prayer#bl2");
		emotion 6, getnpcid(0, "Doom Prayer#bl3");
		emotion 6, getnpcid(0, "Doom Prayer#bl4");
		emotion 6, getnpcid(0, "Doom Prayer#bl5");
		emotion 6, getnpcid(0, "Doom Prayer#bl6");
		emotion 6, getnpcid(0, "Doom Prayer#bl7");
		emotion 6, getnpcid(0, "Doom Prayer#bl8");
		emotion 6, getnpcid(0, "Doom Prayer#bl9");

1@eom,103,194,3	script	Nidhogg#eomnyd04	4_F_NYDHOG,{
	if ('step < 11)
		end;
	if (isbegin_quest(7597) == 0 && checkquest(7593,HUNTING) == 2) {
		mes "[尼德霍格]";
		mes "我不知道该说什么。";
		mes "我们阻止了候补神。";
		mes "我们达成了目标。";
		mes "但我仍然心神不宁。";
		cutin "ep14_nyd03.bmp",2;
		next;
		mes "[尼德霍格]";
		mes "这个世界由魔王梦罗克的意念创造。";
		mes "他会永远活在这座未能完成的花园里。";
		cutin "ep14_nyd02.bmp",2;
		next;
		mes "[尼德霍格]";
		mes "他大概不知道自己的身体已经永久毁灭。";
		mes "即使对他来说，这份野心也太过庞大。";
		mes "他想创造一个新世界，并成为它的创造者，";
		next;
		mes "[尼德霍格]";
		mes "但他靠自己什么也创造不出来。";
		mes "他舍弃恶魔之躯，只为成为现存神明的拙劣仿制品。";
		cutin "ep14_nyd03.bmp",2;
		next;
		mes "[尼德霍格]";
		mes "他化作了人类的形态。";
		mes "他没有足够的创造力去重新定义神的概念。";
		mes "他本身就是一个悖论。";
		next;
		mes "[尼德霍格]";
		mes "现在我们必须及时逃离这个陷阱，回到现实。";
		mes "这个世界只存在于魔神的意识中，同一天永远重复。";
		next;
		mes "[尼德霍格]";
		mes "所有进入这个世界的人都会被拖入相同的循环。";
		mes "从这个意义上说，他成功创造了自己的世界。";
		cutin "ep14_nyd02.bmp",2;
		next;
		mes "[尼德霍格]";
		mes "今天的绝望会日复一日重演。";
		mes "即使知道这一点，我们仍会回来重走同一条路。希望每次都能与你并肩战斗……";
		cutin "ep14_nyd03.bmp",2;
		next;
		cutin "ep14_nyd04.bmp",2;
		mes "[尼德霍格]";
		mes "我说得太多了。指挥官一定在等着。让我确认你的功绩，这样你就能向他报告。";
		mes "你今天做得很好。";
		if (isbegin_quest(7593) == 1) {
			erasequest 7593;// Demon God Subjugation
			setquest 7597;// Fall of the False God
		}
		if (checkquest(7601,HUNTING) == 1)
			erasequest 7601;
		if (isbegin_quest(7602) > 0)
			erasequest 7602;// Temple of the Demon God Phase 1 Completed
		if (isbegin_quest(7603) == 1)
			erasequest 7603;
		if (isbegin_quest(7604) > 0)
			erasequest 7604;// Temple of the Demon God Phase 2 Completed
		if (isbegin_quest(7596) == 1)
			erasequest 7596;
	}
	else {	// todo, custom text
		mes "[尼德霍格]";
		mes "……感觉事情还没有结束，";
		mes "这里非常接近梦罗克的精神世界，";
		mes "他应该还在这里不断回想着过去！";
		cutin "ep14_nyd03.bmp",2;
	}
	next;
	select("离开。" );
	mes "[尼德霍格]";
	mes "当然。你一定累坏了。";
	mes "让我免费把你送到远征队其他成员那里。";
	close2;
	warp "moro_vol",91,87;
	end;
}

1@eom,5,1,0	script	Little Helper#eomtest	4_ENERGY_BLUE,{
	mes "什么？";
	next;
	if (callfunc("F_GM_NPC",1854,0) < 1) {
		mes "错误。";
		close;
	}
	mes "哪个首领？";
	next;
	switch( select( "布里纳拉涅", "穆斯贝尔斯科尔", "半神", "绝望之神" ) ) {
	case 1:
		mes "布里纳拉涅的生命值已设为2,000,000。";
		donpcevent instance_npcname("Brinaranea#brinpc01") + "::OnTest_hp";
		close;
	case 2:
		mes "穆斯贝尔斯科尔的生命值已设为2,000,000。";
		donpcevent instance_npcname("#skollmaster") + "::OnTest_hp";
		close;

	case 3:
		mes "半神的生命值已设为2,000,000。";
		donpcevent instance_npcname("#despair_god_main") + "::OnTest_hp";
		close;

	case 4:
		mes "绝望之神的生命值已设为2,000,000。";
		donpcevent instance_npcname("#despair_main") + "::OnTest_hp";
		close;
	}
	end;
}

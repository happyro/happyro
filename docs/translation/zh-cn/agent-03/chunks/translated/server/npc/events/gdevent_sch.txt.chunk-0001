							close;
						case 2:
							mes "[Morestone]";
							mes "好！我们走。";
							mes "之后你的朋友再来找我时，我会再次带他们去那里。";
							mes "别忘了，矮人是知恩图报的种族！哈哈哈！";
							delitem 6010,1; //Pickaxe
							set $@gdeventv_s1,1;
							set $@gdevents_s$,.@chk_yourgdname$;
							close2;
							setquest 2144;
							warp "schg_que01",103,133;
							end;
						}
					}
					else {
						set $@gdeventv_s1,0;
						set $@gdevents_s$,"";
						mes "[Morestone]";
						mes "我告诉你怎么找到他。";
						mes "Kublin戴着可笑的金帽子，很容易认出他。";
						close;
					}
				case 2:
					set $@gdeventv_s1,0;
					set $@gdevents_s$,"";
					emotion ET_CRY;
					mes "[Dwarf]";
					mes "Ah....";
					close;
				}
			}
		}
		else {
			mes "[Morestone]";
			mes "我，Morestone，已经与"+$@gdevents_s$+"公会结盟。";
			mes "嗯，你不是公会成员。";
			mes "能请你代我向他们问好吗？";
			close;
		}
	}
	else {
		if ($@gdevents_s$ == .@chk_yourgdname$) {

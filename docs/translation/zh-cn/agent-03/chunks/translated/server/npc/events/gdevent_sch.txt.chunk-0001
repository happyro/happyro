//===== rAthena Script ======================================= 
//= Guild dungeon event, Schwarzwald.
//===== By: ================================================== 
//= L0ne_W0lf
//===== Current Version: ===================================== 
//= 1.2
//===== Compatible With: ===================================== 
//= rAthena Project
//===== Description: ========================================= 
//= Guild dungeon event, Schwarzwald. Retrieve Morestone's
//= pickaxe from Kublin.
//===== Additional Comments: =================================
//= 1.0 First version
//= 1.1 Changed spawn timer to 1 hour. [L0ne_w0lf]
//= 1.2 Added GM management function. [Euphy]
//============================================================

schg_dun01,1,1,1	script	Monster Controler#sch_gd	81,{
OnInit:
	donpcevent "Monster Controler1#sch::OnKill";
	initnpctimer;
	end;

OnTimer3600000:
	donpcevent "Monster Controler1#sch::OnEnable";
	mapannounce "schg_dun01", "Kublin：啊啊！",bc_map,"0x99CC00";
	mapannounce "schg_dun01", "Morestone：站住！你这个小偷！",bc_map,"0x99CC00";
	stopnpctimer;
	end;
}

schg_dun01,1,2,1	script	Monster Controler1#sch	81,{
OnEnable:
	set .@callwhere,rand(1,4);
	if (.@callwhere == 1) {
		monster "schg_dun01",164,236,"Kublin",1980,1,"Monster Controler1#sch::OnMyMobDead";
	}
	else if (.@callwhere == 2) {
		monster "schg_dun01",172,122,"Kublin",1980,1,"Monster Controler1#sch::OnMyMobDead";
	}
	else if (.@callwhere == 3) {
		monster "schg_dun01",247,159,"Kublin",1980,1,"Monster Controler1#sch::OnMyMobDead";
	}
	else {
		monster "schg_dun01",250,224,"Kublin",1980,1,"Monster Controler1#sch::OnMyMobDead";
	}
	end;

OnKill:
	killmonster "schg_dun01","Monster Controler1#sch::OnMyMObDead";
	end;

OnMyMobDead:
	if (mobcount("schg_dun01","Monster Controler1#sch::OnMyMObDead") == 0) {
		mapannounce "schg_dun01", "Kublin：啊啊！",bc_map,"0x99CC00";
		mapannounce "schg_dun01", "Morestone：我好像听到Kublin在尖叫！！是谁？Kublin怎么了？喂，你！",bc_map,"0x99CC00";
		donpcevent "Dwarf#sch_gd::OnEnable";
	}
	end;
}

schg_dun01,194,148,5	script	Dwarf#sch_gd	826,{
	if (getcharid(2) == 0) {
		mes "[Dwarf]";
		mes "你有没有看到一个丑陋的哥布灵经过？他偷了我的东西！";
		close;
	}
	set .@chk_urquest,checkquest(2143,PLAYTIME);
	set .@chk_yourgdname$,getguildname(getcharid(2));
	if ($@gdeventv_s1 == 0) {
		if ($@gdevents_s$ == "") {
			set $@gdeventv_s1,1;
			set $@gdevents_s$,.@chk_yourgdname$;
			mes "[Dwarf]";
			mes "帮帮我！";
			mes "请帮帮我！";
			next;
			switch(select("发生了什么？:算了。")) {
			case 1:
				mes "[Dwarf]";
				mes "我是Morestone，专门收集稀有宝石。";
				next;
				mes "[Morestone]";
				mes "旅行时有人告诉我，瓦尔弗雷亚和尼德霍格有很多宝石，所以我来到了这里。";
				mes "但这里的土壤很难挖。幸好我的^3131FF镐子^000000从不让我失望！";
				next;
				select("镐子！");
				mes "[Morestone]";
				mes "没错，我心爱的镐子！";
				mes "我一直随身带着它，你知道吗？";
				next;
				mes "[Morestone]";
				mes "我们一起在这里开始工作。";
				mes "几天后，我们终于发现了东西！";
				next;
				select("奇怪的东西？？");
				mes "[Morestone]";
				mes "不是，但它相当值钱。";
				mes "但我们没时间庆祝。突然出现了一只怪物，偷走了我的镐子。";
				mes "它的名字是^3131FFKublin^000000！";
				next;
				mes "[Morestone]";
				mes "它偷走了我的镐子！";
				mes "没有它我活不下去……";
				next;
				if (countitem(6010) > 0) {
					mes "[" + strcharinfo(0) + "]";
					mes "这就是你一直在找的镐子吗？";
					next;
					mes "[Morestone]";
					mes "你找到了我的镐子？";
					mes "请给我看看！";
					next;
					mes "[Morestone]";
					mes "天啊！你把它还给我了！";
					mes "我珍贵的镐子，我以为永远失去你了。";
					next;
					mes "[Morestone]";
					mes "你真厉害！你属于哪个公会？";
					mes "是Gravity还是Mercury？";
					next;
					mes "[" + strcharinfo(0) + "]";
					mes "我是^3131FF"+.@chk_yourgdname$+"^的成员。";
					next;
					mes "[Morestone]";
					mes "哦……那个公会将得到我最大的敬意。";
					next;
					mes "[Morestone]";
					mes "哦！朋友，非常感谢你的帮助。";
					mes "作为奖励，我告诉你一个最近发现的神秘区域。";
					next;
					select("神秘区域？");
					mes "[Morestone]";
					mes "没错。我在这里挖掘时发现了它。";
					mes "看起来是为某种特殊用途建造的，但那里没有宝石，所以我没兴趣。";
					next;
					mes "[Morestone]";
					mes "与其独自前往，我觉得和朋友一起去会更有趣……";
					next;
					mes "[Morestone]";
					mes "如果你愿意，我可以带^3131FF你和公会成员^000000去探索那个区域。";
					mes "现在要去那里吗？";
					next;
					switch(select("等等！我还没准备好。:我们走！")) {
					case 1:
						set $@gdeventv_s1,0;
						set $@gdevents_s$,"";
						mes "[Morestone]";
						mes "慢慢来，找个地方召集你的朋友。";
						close;
					case 2:
						mes "[Morestone]";
						mes "好！我们走。";
						mes "之后你的朋友再来找我时，我会再次带他们去那里。";
						mes "别忘了，矮人是知恩图报的种族！哈哈哈！";
						delitem 6010,1; //Pickaxe
						set $@gdeventv_s1,1;
						set $@gdevents_s$,.@chk_yourgdname$;
						close2;
						setquest 2144;
						warp "schg_que01",103,133;
						end;
					}
				}
				else {
					set $@gdeventv_s1,0;
					set $@gdevents_s$,"";
					mes "[Morestone]";
					mes "我告诉你怎么找到他。";
					mes "Kublin戴着可笑的金帽子，很容易认出他。";
					close;
				}
			case 2:
				set $@gdeventv_s1,0;
				set $@gdevents_s$,"";
				emotion ET_CRY;
				mes "[Dwarf]";
				mes "啊啊啊……";
				close;
			}
		}
		else if ($@gdevents_s$ == .@chk_yourgdname$) {
			set .@chk_urquest1,checkquest(2144);
			if ((.@chk_urquest1 == 0) || (.@chk_urquest1 == 1)) {
				mes "[Morestone]";
				mes "我，Morestone，已经与"+$@gdevents_s$+"公会结盟。";
				mes "哦，你是公会成员。";
				mes "要去神秘区域吗？";
				next;
				switch(select("我们走。:不了，谢谢。")) {
				case 1:
					mes "[Morestone]";
					mes "希望你玩得开心，我的朋友。";
					close2;
					warp "schg_que01",103,133;
					end;
				case 2:
					mes "[Morestone]";
					mes "需要我帮忙就尽管说。";
					mes "啊！别忘了，我讨厌怪物！所以我不想见到它们。最好还是请我帮别的忙。";
					close;
				}
			}
			else {
				set $@gdeventv_s1,1;
				set $@gdevents_s$,.@chk_yourgdname$;

			mes "沙沙……沙沙……";
			mes "....";
			next;
			mes "[Industrious Man]";
			mes "哎哟！！！";
			mes "你、你是谁？！";
			mes "你在这里站了多久？";
			emotion ET_HUK;
			next;
			mes "["+strcharinfo(0)+"]";
			mes "呃，我只是路过。";
			mes "你看起来正忙着什么。";
			next;
			mes "["+strcharinfo(0)+"]";
			mes "再见~！！";
			emotion ET_PROFUSELY_SWEAT, playerattached();
			next;
			mes "[Industrious Man]";
			mes "呃！！等等！！";
			mes "你的手指……那是……？！";
			next;
			mes "- 他惊讶地抓住你的手。-";
			next;
			mes "[Industrious Man]";
			mes "这是^0000FF古代贤者之王的戒指^000000！！！！！";
			mes "我能遇见你一定是命运！";
			next;
			mes "[Industrious Man]";
			mes "我的研究进展不顺。一定是命运之神把你送到我身边的，我确信！！";
			emotion ET_BEST;
			next;
			mes "["+strcharinfo(0)+"]";
			mes "......";
			mes "……什么？！";
			emotion ET_HUK, playerattached();
			next;
			mes "[Industrious Man]";
			mes "你愿意帮我调查吗？";
			next;
			switch(select("什么调查？:好啊。:好无聊。")) {
			case 1:
				mes "[Industrious Man]";
				mes "简单来说，我在寻找生活在附近的妖精和巨人。";
				next;
				mes "[Industrious Man]";
				mes "虽然我相信他们都住在同一个地方，但他们肯定有不同的文化。";
				mes "……首要的是证明他们确实存在。";
				next;
				mes "[Industrious Man]";
				mes "怎么样？";
				mes "你有兴趣吗？";
				next;
				switch(select("好啊。:不太感兴趣。")) {
				case 1:
					mes "[Industrious Man]";
					mes "哈哈……我就知道我是对的！";
					mes "哈哈哈哈！！";
					next;
					mes "[Industrious Man]";
					mes "那么从现在起我们一起合作吧。先自我介绍一下。";
					mes "如你在名牌上看到的，我叫^0000FF巴泽特·茶布莱克^000000。";
					next;
					mes "["+strcharinfo(0)+"]";
					mes "我是"+strcharinfo(0)+"。";
					next;
					select("好吧，那我能为你做什么？");
					mes "[Bazett]";
					mes ""+strcharinfo(0)+"，让我想想……！！";
					mes "每天在马努克和斯普兰迪德的田野寻找妖精或巨人的踪迹。";
					next;
					mes "[Bazett]";
					mes "这并不难。";
					mes "请把你在那些地区旅行时收集到的任何信息告诉我。";
					next;
					mes "[Bazett]";
					mes "希望凭借你找到的信息，我能发现要找的东西。";
					set ep13_2_busut,2;
					setquest 11101;
					close;
				case 2:

				mes "呼……";
				next;
				switch(select("使用香水。:不使用香水。")) {
				case 1:
					mes "（喷洒-）";
					specialeffect EF_SANCTUARY;
					next;
					mes "[Exhausted Soldier]";
					mes "嗯……这是……";
					mes "我能闻到阿尔夫海姆的气息。";
					mes "我的故乡阿尔夫海姆！";
					next;
					mes "[Exhausted Soldier]";
					mes "啊！感觉就像回到了家！！";
					emotion ET_CRY;
					delitem 6082,1; //Spirit_Of_Alfheim
					close2;
					donpcevent "#tukare_4::OnEnable";
					disablenpc "Exhausted Soldier#4";
					end;
				case 2:
					mes "- 你决定什么也不做。-";
					close;
				}
			}
			end;
		}
		else {
			mes "[Exhausted Soldier]";
			mes "呼……";
			close;
		}
	}
	else {
		mes "[Exhausted Soldier]";
		mes "再见，研究者";
		close;
	}

OnInit:
	enablenpc "Exhausted Soldier#4";
	end;
}


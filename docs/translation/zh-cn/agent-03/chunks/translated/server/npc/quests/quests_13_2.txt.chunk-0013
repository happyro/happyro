				mes "如果你改变主意，就回来找我吧。";
				set ep13_2_busut,1;
				close;
			}
		}
		else {
			if (rand(1,2) == 1) {
				mes "[Industrious Man]";
				mes "Gthgh sdsWryi";
				mes "Apeu hjsu opuer ";
				next;
				mes "["+strcharinfo(0)+"]";

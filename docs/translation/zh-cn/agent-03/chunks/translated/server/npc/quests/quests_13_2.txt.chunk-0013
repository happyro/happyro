		mes "- 然后再试一次。-";
		close;
	}
	if (ep13_2_rhea < 100) {
		mes "[Industrious Man]";
		mes "呼~~";
		mes "真有意思……";
		mes "我会把它记在研究报告里。";
		emotion ET_AHA;
		next;
		mes "[Industrious Man]";
		mes "写……写……";
		mes "沙沙……沙沙……";
		next;
		mes "- 他似乎没有注意到我站在旁边，继续写着什么。-";
		next;
		mes "[Industrious Man]";
		mes "写……写……";
		mes "沙沙……沙沙……";
		mes "....";
		close;
	}
	if (ep13_2_busut < 1) {
		if (isequipped(2782) == 1) {
			mes "[Industrious Man]";
			mes "呼~~";
			mes "真有意思……";
			mes "我会把它记在研究报告里。";

		if (select("是","否") == 1) {
			mes "[雷根贝勒卫兵]";
			mes "谢谢，祝你今天愉快。";
			close2;
			warp "lhz_dun01",149,285;
			end;
		}
		mes "[雷根贝勒卫兵]";
		mes "谢谢，祝你今天愉快。";
		close;
	}
	mes "需要帮助吗？";
	mes "如果想进入，首先必须持有实验室许可证。";
	mes "感谢配合。";
	close;
}



lhz_in01,35,226,5	script	Rekenber Guard#li01	867,{
	if (isequipped(2241) && isequipped(2243)) {
		mes "[雷根贝勒卫兵]";
		mes "^3355FF（哇，是工作人员！）^000000 你好！";
		close2;
		warp "lhz_in01",37,225;
		end;
	}
	mes "[雷根贝勒卫兵]";
	mes "这里是限制区域！";
	mes "请立即出示证件！";
	next;
	if (select("证件？:取消") == 1) {
		mes "[雷根贝勒卫兵]";
		mes "我不知道你们冒险者在卢恩·米德加尔兹怎么做，";
		mes "但这里有禁止擅闯的法律！";
		mes "";
		close;
	}
	mes "[雷根贝勒卫兵]";
	mes "除非有特殊许可，出于安全原因，";
	mes "任何人都不得进入地下实验室。";
	mes "";
	mes "";
	close;
}


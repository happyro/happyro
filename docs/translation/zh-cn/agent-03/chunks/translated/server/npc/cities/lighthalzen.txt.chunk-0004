lhz_in01,24,140,3	script	Regenschirm Guard#40	4_M_LGTGUARD,{
	mes "[雷根贝勒卫兵]";
	if ((MISC_QUEST&512) && countitem(2657) > 0) {// Lab_Passport
		mes "你想进入地下吗？";

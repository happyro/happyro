				mes "你好，年轻的服事。";
				mes "你还有点";
				mes "稚嫩，但我想你";
				mes "也不算真正的新手了。";
				next;
				mes "[Cleope Verce]";
				mes "我记得我在你这个年纪时，";
				mes "曾经";
				switch(rand(1,6)){
				case 1:
					mes "总是在^3131FF吉芬西边^000000的城堡里和这些^3131FF可怕的恶灵^000000战斗。我真不知道自己怎么活下来的";
					mes "？";
					break;
				case 2:
					mes "总是和这些^3131FF可爱的";
					mes "波利^000000玩耍！";
					next;
					mes "[Cleope Verce]";
					mes "不过还是得小心它们的攻击。那时它们很强！";
					break;
				case 3:
					mes "和^3131FF会射击的鬼魂^000000战斗！它们确实吓人，但有光之障壁的话打败它们很容易！";
					break;
				case 4:
					mes "几乎每天都在吉芬西边的城堡里痛打那些^3131FF会射箭的恶魔^000000。那时它们真多。";
					break;
				case 5:
					mes "和这些^3131FF肥猪^000000战斗。它们很强，总让我吃尽苦头。";
					break;
				case 6:
					mes "痛打这些^3131FF活生生的";
					mes "沙漠沙块^000000。我发誓，它们是活的！";
					break;
				}
				next;
				mes "[Cleope Verce]";
				mes "^333333*Sigh*^000000";
				mes "啊，回忆啊～";
				mes "当然，如果能";
				mes "有机会重新来过，";
				mes "我也不知道";
				mes "会不会接受……";
				next;
				mes "[Cleope Verce]";
				mes "总之，你还有";
				mes "许多冒险";
				mes "在等着你。希望";
				mes "你在还是服事时";
				mes "留下许多美好";
				mes "回忆。";
				next;
				emotion ET_KIK;
				mes "[Cleope Verce]";
				mes "祝你好运，";
				mes "年轻的朋友～";
				close;
			}
		}
		mes "嗯？";
		mes "看来你作为服事";
		mes "学到了很多！";
		mes "虽然不想承认，";
		mes "但你已经优秀到让我";
		mes "不能再叫你新手了～";
		close;
	}
	mes "你好你好。";
	mes "今天阳光";
	mes "很温暖，";
	mes "不是吗？天气";
	mes "真舒服……";
	close;
}
// Range NPC
//============================================================
prt_monk,217,123,0	script	#tu_monk	HIDDEN_WARP_NPC,10,10,{
OnTouch_:
	if(BaseJob == Job_Acolyte){
		switch(tu_acolyte01){
		case 4:
		case 10:
		case 25:
			mes "[Sound by Window]";
			mes "...";
			next;
			mes "^3355FF那扇窗传来某种";
			mes "声音……^000000";
			mes "";
			close;
		}
	}
	end;
}

// Eavesdrop
//============================================================
prt_monk,223,123,3	script	Eavesdrop#tu	HIDDEN_NPC,{
	if(BaseJob != Job_Acolyte){
		mes "^3355FF这里什么也没有。^000000";
		close;
	}
	if(tu_acolyte01 > 3 && tu_acolyte01 < 10){
		mes "[Voices from Window]";
		mes "^A68064Sir...";
		mes "宫殿里似乎";
		mes "出了问题。^000000";
		next;
		mes "[Voices from Window]";
		mes "^CD6600怎么了？";
		mes "发生什么事了吗？^000000";
		next;
		mes "[Voices from Window]";
		mes "^A68064我不确定。";
		mes "我说不清楚，但官员们似乎在害怕什么。也许";
		mes "发生了某种事故？^000000";
		next;
		mes "[Voices from Window]";
		mes "^CD6600嗯，我也不知道。";
		mes "Why don't we just wait and see";
		mes "会发生什么？真相总会水落石出。^000000";
		next;
		mes "[Voices from Window]";
		mes "^A68064好的，先生。";
		mes "不过，我还是忍不住";
		mes "感到不安……^000000";
	}
	else if(tu_acolyte01 > 9 && tu_acolyte01 < 25){
		mes "[Voices from Window]";
		mes "^A68064我听宫殿里的一位";
		mes "官员说，";
		mes "他们正在请求";
		mes "我们进行驱魔。^000000";
		next;
		mes "[Voices from Window]";
		mes "^CD6600驱魔？";
		mes "是僵尸袭击了";
		mes "王国吗？^000000";
		next;
		mes "[Voices from Window]";
		mes "^A68064不，我不认为";
		mes "是那样，但";
		mes "他们正在请求";
		mes "一位技艺高超的圣职者……^000000";
		next;
		mes "[Voices from Window]";
		mes "^CD6600嗯……";
		mes "我想知道";
		mes "到底发生了什么……^000000";
		next;
		mes "[Voices from Window]";
		mes "^A68064一有消息";
		mes "我就";
		mes "通知你。^000000";
		next;
		mes "[Voices from Window]";
		mes "^CD6600谢谢……^000000";
	}
	else if(tu_acolyte01 > 24){
		mes "[Voices from Window]";
		mes "^A68064……先生，你知道^855E42盖波格家族的诅咒^A68064吗？^000000";
		next;
		mes "[Voices from Window]";
		mes "^CD6600盖波格？";
		mes "你是说";
		mes "王室";
		mes "受到了诅咒？^000000";
		next;
		mes "[Voices from Window]";
		mes "^A68064是的……";
		mes "这可能就是为什么";
		mes "特里斯坦三世国王陛下";
		mes "和他的廷臣最近";
		mes "行为古怪……^000000";
		next;
		mes "[Voices from Window]";
		mes "^A68064你看……";
		mes "耶梦加得据说";
		mes "在符文米德加尔特建立之初";
		mes "诅咒了盖波格家族。^000000";
		next;
		mes "[Voices from Window]";
		mes "^CD6600耶梦加得？！";
		mes "我们怎么可能";
		mes "对抗它的魔法？";
		mes "连阿斯加德人";
		mes "都无法应对";
		mes "巨蛇的力量！^000000";
		next;
		mes "[Voices from Window]";
		mes "^A68064太可怕了……";
		mes "因为诅咒，";
		mes "盖波格家族每一代的长子据说都会早逝……^000000";
		next;
		mes "[Voices from Window]";
		mes "^CD6600你是说所有第一王子和公主";
		mes "至今都死了吗？如果是真的，传出去会惹麻烦……^000000";
		next;
		mes "[Voices from Window]";
		mes "^CD6600宫殿里发生的就是这个吗？";
		mes "大王子最近去世了吗？^000000";
		next;
		mes "[Voices from Window]";
		mes "^A68064不……";
		mes "其实是第二位";
		mes "大王子";
		mes "去世，不是第一位。^000000";
		next;
		mes "[Voices from Window]";
		mes "^CD6600什么！？^000000";
		next;
		mes "[Voices from Window]";
		mes "^A68064小、小声点！^000000";
		next;
		mes "[Voices from Window]";
		mes "^CD6600那么……";
		mes "是怎么发生的？";
		mes "是事故吗？^000000";
		next;
		mes "[Voices from Window]";
		mes "^A68064他们还没确定";
		mes "确切死因。但宫廷官员想让我们看看能否彻底解除耶梦加得的诅咒。^000000";
		next;
		mes "[Voices from Window]";
		mes "^CD6600耶梦加得的诅咒？";
		mes "这么多年后还能解除吗？如此古老的";
		mes "魔法可能对我们教会的任何人来说";
		mes "都太强大了……^000000";
		next;
		mes "[Voice from Window]";
		mes "^A68064这个任务无比艰巨！";
		mes "如果失败，我们会失去民众的信任。教会和王室真的需要奇迹……^000000";
		next;
		mes "[Voice from Window]";
		mes "^CD6600教会怎么回应？真的要派人解除连阿斯加德人都难以对付的怪物诅咒吗？^000000";
		next;
		mes "[Voice from Window]";
		mes "^A68064我不太确定。";
		mes "可能拥有";
		mes "所需技能的人";
		mes "年纪太大。不过，他们";
		mes "还没有放弃希望……^000000";
		next;
		mes "[Voice from Window]";
		mes "^A68064这件事关系王室声誉和王国稳定，因此大家都非常小心";
		mes "地保持沉默。^000000";
		next;
		mes "[Voice from Window]";
		mes "^A68064我先回王国，有其他消息会告诉你。不过大家都必须谨慎，可能要过";
		mes "一阵子才会有新消息。^000000";
		next;
		mes "[Voice from Window]";
		mes "^CD6600非常感谢。";
		mes "我会等着";
		mes "你的消息。^000000";
		next;
		mes "[Voice from Window]";
		mes "^CD6600哦，天啊。";
		mes "请驱散逼近符文米德加尔特王国的黑暗。请用你的光与慈悲保护我们。^000000";
	}
	close;
}

sec_in02,17,156,3	script	1st Job Quest Reset	4_F_JOB_BLACKSMITH,{
	callfunc "F_GM_NPC";
	mes "[1st Job Quest]";
	mes "你想重置哪项？";
	next;
	switch(select("剑士:商人:弓箭手:服事:盗贼:法师")) {
	case 1:
		tu_swordman = 0;
		break;
	case 2:
		tu_merchant = 0;
		break;
	case 3:
		tu_archer01 = 0;
		tu_archer02 = 0;
		break;
	case 4:
		tu_acolyte01 = 0;
		break;
	case 5:
		tu_thief01 = 0;
		break;
	case 6:
		tu_magician01 = 0;
		break;
	}
	mes "已完成。";
	close;
}

payon_in03,11,31,4	script	Daewoon#sign	808,{
	callfunc "F_UpdateSignVars";
	mes "[Daewoon]";
	mes "哇哈哈！";
	mes "美食与欢乐、美酒、美人和歌声！";
	mes "我别无所求了！";
	mes "";
	next;
	mes "[Daewoon]";
	mes "最美味的佳肴都是我的！";
	mes "我说的不只是食物。哇哈哈！";
	mes "我是世界之王！";
	mes "";
	next;
	if (sign_q == 14) {
		mes "[Daewoon]";
		mes "哦，有客人？";
		mes "抱歉，但我想你是不请自来的客人～";
		mes "";
		if (Sex == SEX_MALE) {
			mes "请原谅，我更愿意把时间花在姑娘身上，而不是男人身上。";
			mes "";
		}
		else {
			mes "没关系，美人就是美人，不管我是否知道她的名字。";
			mes "来和我喝一杯~";
		}
		next;
		if (countitem(7177) > 0) {
			set .@pay_point,1;
			mes "["+ strcharinfo(0) +"]";
			mes "好……但首先，你能看看这个吗？";
			next;
			mes "^3355FFYou carefully take";
			mes "取出 Arian 给你的清澈小宝石，让 Daewoon 仔细看看。^000000";
			next;
			emotion ET_SURPRISE;
			mes "[Daewoon]";
			mes "嗯？那是……我明白了，一定是 Arian 派你来的！你早该说嘛~";
			next;
			mes "[Daewoon]";
			mes "抱歉~最近我像青少年明星一样吸引各种奇怪目光。为了筛掉危险人物，我已经习惯格外谨慎。";
			next;
			mes "[Daewoon]";
			mes "那么，你知道手里的宝石究竟是什么吗？";
			next;
			switch(select("算是吧？:我怎么会知道？:不知道，但你能告诉我吗？")) {
			case 1:
				mes "[Daewoon]";
				mes "Oh...!";
				mes "你一定比我想象中聪明。告诉我，你了解这颗宝石什么？";
				next;
				switch(select("它很方便。:其实我不知道……")) {
				case 1:
					set .@pay_point,.@pay_point+2;
					mes "[Daewoon]";
					emotion ET_THINK;
					mes "嗯……？方便？如果你真的理解，就不会只说这颗宝石‘方便’。";
					next;
					break;
				case 2:
					set .@pay_point,.@pay_point+4;
					emotion ET_HNG;
					mes "[Daewoon]";
					mes "真的吗？嗯，至少你承认了。*叹气*";
					next;
					break;
				}
				break;
			case 2:
				mes "[Daewoon]";
				emotion ET_THINK;
				mes "...";
				mes "说话相当粗鲁，不过也许你是从 Arian 那里学来的。无论如何，让我解释。";
				next;
				break;
			case 3:
				set .@pay_point,.@pay_point+5;
				mes "[Daewoon]";
			mes "Arian 什么都没告诉你？我欣赏你的诚实。我不介意聊一会儿，我更喜欢和诚实的人说话，而不是自以为无所不知的蠢货。";
				next;
				break;
			}
			mes "[Daewoon]";
			mes "^31009C啜泣星光^000000不是普通宝石，而是解锁惊人力量的关键物品。我相信 Metz 碰巧得到了一块，但不知道是怎么得到的……";
			next;
			mes "[Daewoon]";
			mes "Metz 请求我和其他持有啜泣星光碎片的朋友，把它们托付给值得寻找其力量的人。";
			next;
			mes "[Daewoon]";
			mes "当然，我们都同意了。现在你来到这里，让我判断你是否";

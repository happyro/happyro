				if (BaseLevel < 60) getexp 300,0;
				else if (BaseLevel < 70) getexp 750,0;
				else if (BaseLevel < 80) getexp 1000,0;
				else if (BaseLevel < 90) getexp 1300,0;
				else getexp 1800,0;
			} else {
				if (BaseLevel < 60) getexp 3000,0;
				else if (BaseLevel < 70) getexp 7500,0;
				else if (BaseLevel < 80) getexp 10000,0;
				else if (BaseLevel < 90) getexp 13000,0;
				else getexp 18000,0;
			}
			set sign_q,14;
			getitem 7177,1; //Part_Of_Star's_Sob
			close;
		case 14:
			mes "[Arian]";
			mes "...........";
			mes "斐扬……？Daewoon？这些名字有没有让你想起什么？应该会想起来才对！";
			close;
		}
	}
	else {
		mes "[Arian]";
		mes "...";
		mes "闭嘴，别烦我！我正在思考如何解决世界饥荒！或者类似的事。";
		emotion ET_THINK;
		close;
	}
}

morocc_in,114,162,4	script	Young Man#sign	118,{
	callfunc "F_UpdateSignVars";
	mes "[Gaanan]";
	if (sign_q < 11) {
		mes "梦罗克的天气对我来说太热了。光是生活就很困难。你知道有什么凉爽的地方可以工作吗？";
		emotion ET_PROFUSELY_SWEAT;
		close;
	}
	else if (sign_q == 11) {
		mes "哦，Arian 派你来找我，对吧？抱歉，你需要适应他。虽然我也还在适应他的……行为方式。";
		next;
		mes "[Gaanan]";
		mes "总之，Arian 觉得无聊，所以让我负责你的测试问答部分。回答问题时请仔细选择。准备好了吗？";
		next;
		mes "[Gaanan]";
		mes "第一题。假设你身处荒岛，你首先应该做什么？";
		next;
		switch(select("寻找淡水。:等待救援。:寻找食物。:探索岛屿。")) {
		case 1:
			set .@point_s,.@point_s+7;
			break;
		case 2:
			set .@point_s,.@point_s+1;
			break;
		case 3:
			set .@point_s,.@point_s+4;
			break;
		case 4:
			set .@point_s,.@point_s+10;
			break;
		}
		mes "[Gaanan]";
		mes "第二题……你被困在倒塌建筑的狭窄空间里。你打算先做什么？";
		next;
		switch(select("大声求救。:保持安静。:等待死亡。:寻找出口。")) {
		case 1:
			set .@point_s,.@point_s+3;
			break;
		case 2:
			set .@point_s,.@point_s+7;
			break;
		case 3:
			set .@point_s,.@point_s+1;
			break;
		case 4:
			set .@point_s,.@point_s+7;
			break;
		}
		mes "[Gaanan]";
		mes "第三题。你和朋友进行地下城探险，却不知怎么迷路了。你会怎么处理？";
		next;
		switch(select("尝试寻找朋友。:寻找出口。:原地等待。:继续探索地下城。")) {
		case 1:
			break;
		case 2:
			set .@point_s,.@point_s+5;
			break;
		case 3:
			set .@point_s,.@point_s+10;
			break;
		case 4:
			set .@point_s,.@point_s+1;
			break;
		}
		mes "[Ganaan]";
		mes "第四题。你和朋友在一座没有出口的宅邸里。宅邸内发生谋杀时，你首先做什么？";
		next;
		switch(select("等待案件解决。:先寻找朋友。:寻找出口。:自己解决谋杀案。:在别人杀我前杀掉他们。")) {
		case 1:
			set .@point_s,.@point_s+5;
			break;
		case 2:
			set .@point_s,.@point_s+7;
			break;
		case 3:
			set .@point_s,.@point_s+3;
			break;
		case 4:
			set .@point_s,.@point_s+1;
			break;
		case 5:
			set .@point_s,.@point_s+1;
			break;
		}
		mes "[Gaanan]";
		mes "第五题……你听说世界将在一周后终结。那么最后一周你会做什么？";
		next;
		switch(select("等待终结。:种一棵苹果树。:寻找迁往其他世界的方法。:还有什么？拯救世界。:还有什么？大肆犯罪。")) {
		case 1:
			set .@point_s,.@point_s+5;
			break;
		case 2:
			set .@point_s,.@point_s+3;
			break;
		case 3:
			set .@point_s,.@point_s+7;
			break;
		case 4:
			set .@point_s,.@point_s+10;
			break;
		case 5:
			set .@point_s,.@point_s+1;
			break;
		}
		mes "[Gaanan]";
		mes "哦！完成了！好，我把这些答案交给 Arian。接着……去找他，他会告诉你成绩。";
		if (.@point_s > 33) set sign_q,13;
		else set sign_q,12;
		close;
	}
	else if (sign_q < 14) {
		mes "嗯……？Arian 是给你评分的人。但我理解。如果你没通过，我也想躲着他……";
		close;
	}
	else {
		mes "^333333*Sigh...*^000000";
		mes "希望天气能凉快一点点。既然在许愿奇迹，不如许愿得到一万亿 Zeny，也许再来艘游艇。";
		close;
	}
}


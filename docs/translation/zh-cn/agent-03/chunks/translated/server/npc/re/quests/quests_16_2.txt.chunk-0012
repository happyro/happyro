		mes "我也读过。你刚才说的内容上面都有。";
		next;
		mes "[Rebellion Guard leader Larcis]";
		mes "我交给 Erst 的信里也写着同样的内容。";
		if (terra_gloria_lady_part == 6) {
			erasequest 11459;// Doubt
			setquest 11460;// Doubt
			terra_gloria_lady_part = 7;
		}
		close;
	}
	end;
OnInit:
	cloakonnpc();
	end;
}

rebel_in,121,69,8	script	Dien#162gmbs2	4_F_DIENE,{
	if (terra_gloria_lady_part == 8) {
		mes "[Rebellion Guard leader Larcis]";
		mes "Dien！";
		mes "外面很危险，有外来者在那里。";
		next;
		mes "[Dien]";
		mes "没关系，Larcis。";
		mes "他们没那么危险。";
		cutin "ep162_dn01.bmp",2;
		next;
		cutin "",255;
		mes "[Rebellion leader Rupert]";
		mes "Dien！";
		mes "我正准备去找你。";
		next;
		mes "[Rebellion leader Rupert]";
		mes "你的信……是什么意思？";
		npctalk "叛乱军首领：我真的不明白。", "Rebellion leader#162gmb", bc_self;
		next;
		mes "[Dien]";
		mes "就像信上写的那样。";
		npctalk "Dien：这不是简单到连三岁小孩都能理解吗？", "", bc_self;
		cutin "ep162_dn01.bmp",2;
		next;
		cutin "",255;
		mes "[Rebellion leader Rupert]";
		mes "你是说你同意帮助秘密之翼？";
		npctalk "叛乱军首领：除非我的眼睛出了问题。", "Rebellion leader#162gmb", bc_self;
		next;
		mes "[Rebellion senior Dien]";
		mes "是的。";
		mes "就像我在信上写的。";
		cutin "ep162_dn01.bmp",2;
		next;
		mes "[Rebellion senior Dien]";
		mes "我、Ridsh 和 Cotnes 会同意帮助秘密之翼。";
		next;
		cutin "",255;
		mes "[Rebellion leader Rupert]";
		mes "连 Ridsh 和 Cotnes 也……？不。即使亲耳听你说，我也不敢相信你同意了。";
		npctalk "叛乱军首领：你在开玩笑吧？", "Rebellion leader#162gmb", bc_self;
		next;
		mes "[Rebellion senior Dien]";
		mes "我听说 Erst 也同意。";
		mes "既然有这么多人同意，你就不该独自抵抗。";
		cutin "ep162_dn01.bmp",2;
		next;
		cutin "",255;
		mes "[Rebellion leader Rupert]";
		mes "这次我笑不出来。";
		next;
		mes "[Rebellion leader Rupert]";
		mes "你比任何人都更清楚这有多愚蠢。";
		next;
		mes "[Dien]";
		mes "我当然知道。";
		mes "所以我才接受。";
		cutin "ep162_dn03.bmp",2;
		next;
		cutin "",255;
		mes "[Rebellion leader Rupert]";
		mes "为什么！！！";
		next;
		mes "[Dien]";
		mes "时间在流逝，Rupert。";
		mes "我们不能永远停留在原地。";
		npctalk "Dien：我的时代……已经过去了。", "", bc_self;
		cutin "ep162_dn01.bmp",2;
		next;
		cutin "",255;
		mes "[Rebellion leader Rupert]";
		mes "时间流逝并不意味着过去会消失！";
		next;
		mes "[Rebellion leader Rupert]";
		mes "我们牺牲了太多，不能忘记！";
		npctalk "叛乱军首领：我们已经失去了一切！", "Rebellion leader#162gmb", bc_self;
		next;
		mes "[Rebellion leader Rupert]";
		mes "关于这件事，我作为这里的负责人会做决定。";
		next;
		mes "[Rebellion leader Rupert]";
		mes "我一直试图尊重你这位前辈，容忍你的行为。但这次你越界了。";
		next;
		mes "[Rebellion leader Rupert]";
		mes "现在！请回房间享受你的茶会。";
		next;
		mes "[Rebellion senior Dien]";
		mes "等等！";
		mes "我不能忽视你刚才说的话。";
		mes "你是想无视我的意见，也无视我本人吗？";
		cutin "ep162_dn03.bmp",2;
		erasequest 11461;// Doubt
		setquest 11462;// Doubt
		terra_gloria_lady_part = 9;
		close3;
	}
	if (terra_gloria_lady_part == 9) {
		mes "[Rebellion senior Dien]";
		mes "等等！";
		mes "我不能忽视你刚才说的话。";
		mes "你是想无视我的意见，也无视我本人吗？";
		cutin "ep162_dn03.bmp",2;
		close3;
	}
	end;
OnInit:
	cloakonnpc();
	end;
}

rebel_in,118,70,3	script	Young Rebellion#162gmbs1	4_F_GUNSLINGER,{
	mes "[Young Rebellion]";
	mes "我加入叛乱军是因为他们射击时很帅。但现在我忙着处理文件，根本没时间摸枪。";
	next;
	mes "[Young Rebellion]";
	mes "问题是，我觉得这份工作很适合我。";
	close;
}

rebel_in,114,75,5	script	Young Rebellion#162gmbs2	4_F_REBELLION,{
	mes "[Young Rebellion]";
	mes "运气好时，我能从前辈那里得到一些零食。";
	next;
	mes "[Young Rebellion]";
	mes "真奇妙，自己买的零食味道就是不一样。";
	npctalk "年轻叛乱军成员：从别人那里拿到好东西总是很棒。真刺激。", "", bc_self;
	close;
}
// Main story

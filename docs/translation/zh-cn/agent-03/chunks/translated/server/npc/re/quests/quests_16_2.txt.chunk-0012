rebel_in,86,61,5	script	Lazy#16nego05	4_M_LAZY,{
	if (checkweight(501,1) == 0) {
		mes "[Lazy]";
		mes "你为什么在这里放这么多东西？包要轻一些，才能装很多新东西。";
		close;
	}
	if ((MaxWeight - Weight) < 1000) {
		mes "[Lazy]";
		mes "你为什么在这里放这么多东西？包要轻一些，才能装很多新东西。";
		close;
	}
	if (terra_gloria_main == 15) {
		cutin "16lei_01.bmp",2;
		emotion ET_SMILE;
		mes "[Lazy]";
		mes "哦～这里真棒。好舒适。^0000cd这里是做什么的^000000？我想在这里待一天。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "我没想到商店后面会有这样的地方……这是什么？";
		npctalk "没错。我不是告诉过你柱子后面有空间吗？", "", bc_self;
		next;
		cutin "16loo_01.bmp",0;
		mes "[Lucky]";
		mes "这是照顾初心者和老年人的疗养院。这里没什么可看的。而且这里太冷，在这里睡觉嘴巴可能会歪。所以喝完茶最好离开。";
		next;
		cutin "16lei_03.bmp",2;
		mes "[Lazy]";
		mes "你太小气了。我救了他的命后，你怎么能这样对我？";
		next;
		cutin "16loo_03.bmp",0;
		emotion ET_QUESTION, getnpcid(0, "Rookie#16nego02");
		mes "[Lucky]";
		mes "我给了你一杯茶，也答应补偿你。你还需要什么？";
		npctalk "愿望太多可能会变得大胆。", "Rookie#16nego02", bc_self;
		sleep2 300;
		npctalk "你是在诅咒我吗？拜托！别让我变大胆！", "", bc_self;
		next;
		cutin "16lei_03.bmp",2;
		mes "[Lazy]";
		mes "有些东西是买不到的。";
		emotion ET_MONEY;
		next;
		cutin "16loo_03.bmp",0;
		mes "[Lucky]";
		mes "好吧，那我只能留下我的感激了。";
		npctalk "听起来不错。我们能省钱了。", "Rookie#16nego02", bc_self;
		next;
		cutin "16lei_01.bmp",2;
		mes "[Lazy]";
		mes "不。按照我目前的经验，买不到的东西都没用。";
		next;
		cutin "16loo_03.bmp",0;
		mes "[Lucky]";
		mes "我搞不懂你想要什么。总之坐在那里吧。我会给你一杯你想要的茶。";
		next;
		cloakoffnpcself( "Magenta#16nego01" );
		mes "[Magenta]";
		mes "Lucky～～～你去哪儿了！！我等了一会儿了！我要出任务了，祝我好运。";
		npctalk "来吧。幸运魔法～", "Magenta#16nego01", bc_self;
		next;
		cloakoffnpcself( "Denny#16nego03" );
		mes "[Denny]";
		mes "新人！！！！快帮我整理仓库。东西太多了，我一个人做不来。快点。";
		npctalk "快点！借我你的魔法之手！", "Denny#16nego03", bc_self;
		next;
		mes "[Magenta]";
		mes "嘿，我先来的，对吧？";
		next;
		mes "[Denny]";
		mes "但我赶时间！";
		npctalk "你赶时间的话，就该早点来！", "Magenta#16nego01", bc_self;
		npctalk "我不像你那么闲。超级明星总是很忙。", "Denny#16nego03", bc_self;
		next;
		cutin "16loo_02.bmp",0;
		mes "[Lucky]";
		mes "我有客人。给他们倒完茶就来。你们两个等一会儿。";
		npctalk "你可以等，对吧？", "Rookie#16nego02", bc_self;
		next;
		mes "[Denny]";
		mes "我赶时间……";
		next;
		mes "[Magenta]";
		mes "我可以等！我不能给 Lucky 施压。";
		next;
		mes "[Denny]";
		mes "我也可以等！";
		npctalk "你不是说你赶时间吗？", "Magenta#16nego01", bc_self;
		sleep2 300;
		npctalk "他说他现在很忙！我先走了，所以你要先来找我！", "Denny#16nego03", bc_self;
		cloakonnpcself( "Denny#16nego03" );
		npctalk "Lucky！我先来！！！", "Magenta#16nego01", bc_self;
		cloakonnpcself( "Magenta#16nego01" );
		next;
		cutin "16lei_01.bmp",2;
		mes "[Lazy]";
		mes "大家到处找你。你真受欢迎，对吧？";
		npctalk "也许这就是你叫 Lucky 的原因？", "", bc_self;
		next;
		cutin "",255;
		cloakoffnpcself( "Senior#16nego01" );
		cloakoffnpcself( "Senior#16nego04" );
		mes "[Senior]";
		mes "新人，你去哪儿了？大家都在找你。";
		next;
		mes "[Senior]";
		mes "他腿脚很好，所以到处走走也没问题。";
		sleep2 300;
		npctalk "什么？他在做文职。他应该待在自己的岗位上！", "Senior#16nego01", bc_self;
		sleep2 500;
		npctalk "你不知道 Rookie 是这里最忙的人吗？", "Senior#16nego04", bc_self;
		next;
		cloakoffnpcself( "Senior#16nego02" );
		mes "[Senior]";
		mes "Lucky，端一杯茶来。";
		npctalk "我的也要。", "Senior#16nego01", bc_self;
		sleep2 300;
		npctalk "看，你给他的工作太多了。", "Senior#16nego04", bc_self;
		sleep2 300;
		npctalk "什么？你，出去。", "Senior#16nego01", bc_self;
		next;
		cloakoffnpcself( "Senior#16nego03" );
		mes "[Senior]";
		mes "Lucky，他们是陌生人。他们是谁？";
		npctalk "也给我一杯茶。", "Senior#16nego03", bc_self;
		npctalk "我为什么要跟你走？", "Senior#16nego04", bc_self;
		next;
		cutin "16loo_03.bmp",0;
		mes "[Lucky]";
		mes "他们救了 Gonie 的命。他们来到了安静的艾因贝赫。^0000cd偶然^000000发现受伤的 Gonie 并治好了他，然后把他^0000cd直接^000000带到这里。";
		npctalk "今天让我给你上一课！", "Senior#16nego01", bc_self;
		sleep2 300;
		npctalk "你们又在吵架吗？", "Senior#16nego02", bc_self;
		next;
		cutin "16lei_01.bmp",2;
		mes "[Lazy]";
		mes "是的。 I did it. I did it!";
		npctalk "我明白了。我先喝茶，好吗？你能等吗？", "Senior#16nego04", bc_self;
		sleep2 300;
		npctalk "你总是只会动嘴教训人。", "Senior#16nego03", bc_self;
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "你帮了别人之后太爱邀功了。";
		npctalk "他们是谁？", "Senior#16nego01", bc_self;
		npctalk "他们看起来不是我们的孩子。", "Senior#16nego04", bc_self;
		next;
		mes "[Lazy]";
		mes "你得夸大自己的表现，别人才能重视你。";
		npctalk "我一看也明白了。", "Senior#16nego01", bc_self;
		npctalk "他们看起来像 Lucky 的客人。", "Senior#16nego03", bc_self;
		next;
		cutin "16loo_01.bmp",0;
		mes "[Lucky]";
		mes "那么，你为什么来这里？顺便问，你是谁？";
		npctalk "Rookie 也不认识他们。", "Senior#16nego02", bc_self;
		sleep2 500;
		npctalk "那是谁邀请他们的？", "Senior#16nego01", bc_self;
		next;
		cutin "16lei_01.bmp",2;
		mes "[Lazy]";
		mes "我？Lazy。虽然这不是真名，现在就叫我 Lazy。";
		next;
		mes "[Lazy]";
		mes "我是^0000cd秘密之翼的特工^000000，一个直接向施瓦尔茨瓦尔德总统负责的机构。";
		npctalk "什么？", "Senior#16nego03", bc_self;
		next;
		emotion ET_HUK, playerattached();
		mes "[" + strcharinfo(0) + "]";
		mes "嘿！你为什么突然告诉他们身份？你一直叫我连提都不能提。现在却公开说出来了！";
		npctalk "我想我刚才听错了。", "Senior#16nego04", bc_self;
		next;
		cutin "16lei_03.bmp",2;
		mes "[Lazy]";
		mes "没关系。这就是我们的目的地。^0000cdClana Nemieri^000000，叛乱军的据点。";
		npctalk "他说自己是秘密之翼的特工，一个直接向施瓦尔茨瓦尔德总统负责的机构！我全听到了！", "Senior#16nego01", bc_self;
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "所以门外的商店是^0000cd骗局^000000。倒下的人是^0000cd叛乱军^000000成员……所以……";
		npctalk "你是说，那些乌鸦？", "Senior#16nego02", bc_self;
		next;
		cutin "",255;
		mes "铿锵。";
		emotion ET_HUK, playerattached();
		next;
		mes "铿锵。";
		mes "铿锵。";
		emotion ET_HUK, playerattached();
		next;
		mes "铿锵。";
		mes "铿锵。";
		mes "铿锵。";
		emotion ET_HUK, playerattached();
		next;
		mes "铿锵。";
		mes "铿锵。";
		mes "铿锵。";
		mes "铿锵。";
		emotion ET_HUK, playerattached();
		next;
		mes "[Senior]";
		mes "现在离开这里！";
		npctalk "你知道自己在哪里吗？", "Senior#16nego01", bc_self;
		sleep2 300;
		npctalk "不许动！！", "Senior#16nego02", bc_self;
		next;
		mes "[Senior]";
		mes "我们来处理他们！";
		npctalk "呼叫支援！", "Senior#16nego04", bc_self;
		sleep2 300;
		npctalk "不需要。我们自己就能打败他们！", "Senior#16nego02", bc_self;
		emotion ET_HUK, playerattached();
		emotion ET_SWEAT;
		next;
		cutin "16loo_01.bmp",0;
		mes "[Lucky]";
		mes "嘿，请冷静！把枪收起来！难怪你们这些老人如此冲动！！";
		next;
		cutin "16loo_03.bmp",0;
		mes "[Lucky]";
		mes "虽然他们带着可疑目的来到这里，但他们确实一路把受伤的 Gonie 带到了这里。注意言行，老人们。";
		npctalk "可疑的目的！", "", bc_self;
		npctalk "我们为什么要规矩！", "Senior#16nego01", bc_self;
		next;
		cutin "16lei_01.bmp",2;
		mes "[Lazy]";
		mes "你不惊讶？所以你早就知道了。";
		next;
		cutin "16loo_03.bmp",0;
		mes "[Lucky]";
		mes "我不知道你是谁。但我知道你有某种目的。我还没告诉你名字，你就喊“新人出来”。所以我猜到了一点。";
		next;
		cutin "16lei_01.bmp",2;
		mes "[Lazy]";
		mes "我听说叛乱军的脑子里装满子弹，但也许不是每个叛乱军成员都这样！那么你叫 Lucky，还是 Rookie？";
		npctalk "他刚才是在侮辱我们吗？", "Senior#16nego03", bc_self;
		npctalk "安静。听听他们说什么。", "Senior#16nego02", bc_self;
		sleep2 500;
		npctalk "我们为什么要听这些胡话？把他们赶出去！", "Senior#16nego01", bc_self;
		next;
		cutin "16loo_01.bmp",0;
		mes "[Rookie]";
		mes "^0000cdRookie^000000. Lucky is my nickname.";
		next;
		mes "[Senior]";
		mes "Rookie！你已经知道他是谁了，而且你……！！";
		npctalk "先干掉他！！！", "Senior#16nego01", bc_self;
		next;
		cutin "16loo_03.bmp",0;
		mes "[Rookie]";
		mes "我说过了！老人们，你们现在聋了吗？我不知道他们是谁！这不公平！";
		emotion ET_CRY, getnpcid(0, "Rookie#16nego02");
		npctalk "他说他不知道。", "Senior#16nego04", bc_self;
		sleep2 300;
		npctalk "那你为什么把他们带进来？", "Senior#16nego02", bc_self;
		next;
		cutin "16loo_01.bmp",0;
		mes "[Rookie]";
		mes "如果他们想攻击我们，早就动手了，不会来要茶。而且他们两个人能对我们这么多人做什么？";
		npctalk "他们看起来没那么强。", "Rookie#16nego02", bc_self;
		sleep2 300;
		npctalk "你的说法会误导人，但我现在不打算纠正。", "", bc_self;
		next;
		cutin "16loo_02.bmp",0;
		mes "[Rookie]";
		mes "不管他们做什么，你都会处理，对吧？你们可是叛乱军的传奇。";
		emotion ET_SMILE, getnpcid(0, "Rookie#16nego02");
		npctalk "嗯……确实。", "Senior#16nego03", bc_self;
		sleep2 300;
		npctalk "所以我们现在才这么做。", "Senior#16nego02", bc_self;
		next;
		cutin "16loo_01.bmp",0;
		mes "[Rookie]";
		mes "我不知道他们从哪里来。但他们一路来到这里，也许是想和前辈们谈谈。我去端茶，顺便听听。";
		npctalk "你要去哪儿！", "Senior#16nego01", bc_self;
		npctalk "那家伙感觉敏锐又聪明。", "", bc_self;
		next;
		cloakonnpcself( "Rookie#16nego02" );
		cutin "16lei_01.bmp",2;
		mes "[Lazy]";
		mes "哈哈哈！很高兴见到你。我在休息时间突然出现，吓到你了吗？";
		next;
		mes "[Lazy]";
		mes "但我不是危险人物，请放松。这位冒险者更不危险。";
		emotion ET_SMILE;
		npctalk "你不用和我们说话！", "Senior#16nego01", bc_self;
		next;
		mes "[Lazy]";
		mes "这是解决过包括施瓦尔茨瓦尔德在内的大陆各种问题的冒险者。目前受到卢恩·米德加尔特王国保护。." + strcharinfo(0) + "";
		emotion ET_BEST;
		npctalk " 冒险者 " + strcharinfo(0) + "? 你一定就是卢恩·米德加尔特王宫里的那个人……", "Senior#16nego02", bc_self;
		next;
		cutin "16lei_03.bmp",2;
		mes "[Lazy]";
		mes "我是秘密之翼成员，一个直接向施瓦尔茨瓦尔德共和国总统负责的机构。既然总统保证我的身份，你们不用担心。";
		emotion ET_BEST;
		npctalk "哈！！！胡说八道！！", "Senior#16nego03", bc_self;
		next;
		mes "[Senior]";
		mes "我怎么能相信你？";
		npctalk "我怎么能相信你？", "Senior#16nego04", bc_self;
		next;
		mes "[Senior]";
		mes "你是这里最危险的家伙！";

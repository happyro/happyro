// Doha's Secret Orders
//============================================================
mid_campin,168,170,3	script	Inspector Doha#ep133	59,{
	if (checkweight(1201,1) == 0 || MaxWeight - Weight < 1000) {
		mes "- You can too many items to proceed with the quest. -";
		close;
	}
	if (ep13_3_secret < 1) {
		mes "[Doha]";
		mes "是什么？";
		mes "你看起来不像是来找我的。";
		mes "如果不是，请现在离开。";
		close;
	}
	else if (ep13_3_secret == 1) {
		mes "[Doha]";
		mes "谁在问？";
		mes "如果你走错房间，请现在离开。";
		next;
		if (select("来见调查员。:抱歉。") == 1) {
			mes "[Doha]";
			mes "我？";
			mes "你就是队长提到的那个人吗？";
			mes "名字是……";
			mes strcharinfo(0) + "?";
			next;
			mes "[Doha]";
			mes "嗯…… I don't know why you were chosen but I guess they trusted you enough.";
			mes "我听说你被选中访问Sapha的首都El Dicastes。";
			next;
			mes "[Doha]";
			mes "关于这次访问，我有个秘密任务交给你。";
			mes "更像是一道命令。";
			next;
			mes "[Doha]";
			mes "我是因为报告案件从祖国派来的调查员。";
			mes "我们正在调查报告案件背后的真相。";
			next;
			select("报告案件？");
			mes "[Doha]";
			mes "你没听说过吗？";
			mes "我以为你已经知道了……";
			mes "所以你不是当时收集报告的人？";
			next;
			mes "[Doha]";
			mes "之前派出探险队时，";
			mes "我们对各类别的研究结果有一份综合报告，";
			mes "负责把报告带回祖国的信使遭到了袭击。";
			next;
			mes "[Doha]";
			mes "幸运的是报告没有被完全偷走，";
			mes "我们费尽力气修复后，还是拿到了报告。";
			mes "重要的是，究竟是谁做的。";
			next;
			mes "[Doha]";
			mes "如你所知，这里的探险队是三个国家的联盟。";
			mes "而我们彼此关系并不好。";
			mes "所以队长和高层让Hibba Agip负责，因为他不属于任何一个国家。";
			next;
			mes "[Doha]";
			mes "但重要的是，究竟哪个国家在幕后，";
			mes "以及在我们必须促进和平与合作时，他们为什么要做这种事。";
			next;
			mes "[Doha]";
			mes "因此我被派到这里调查。";
			mes "调查中我发现了意外情报。";
			next;
			mes "[Doha]";
			mes "你认识猫商人吗？";
			mes "他们也在附近做生意。";
			mes "其中一名猫商人";
			mes "把这个情报告诉了我。";
			next;
			mes "[Doha]";
			mes "我正在调查推测发生袭击的地点，";
			mes "在那里遇到了一只猫。嗯……我也不知道该怎么称呼他。";
			next;
			mes "[Doha]";
			mes "结果我很幸运遇到了这只猫。";
			mes "因为他是这起案件的目击者。";
			next;
			select("目击者！:是谁做的？");
			mes "[Doha]";
			mes "唉……";

		mes "酒馆请求收集27条虫腿。";
		next;
		mes "[Tragis]";
		mes "他们不愿透露需要虫腿的理由。总之，谢谢你。";
		next;
		mes "我给你安排了名为^880088可疑食物^000000的请求。打开^990099任务窗口^000000即可查看请求详情和报告对象。";
		close;
	}
	else if (.@tut_13 == 4) {
		setquest 12130;
		setquest 12162;
		mes "[Tragis]";
		mes "Zargon在这里的居民中很受欢迎。它是美丽的圆球形物品，粉末与水混合后可用作黏合剂。";
		next;
		mes "[Tragis]";
		mes "听说这是冒险家大陆上很常见的材料。你能弄一些吗？26个Zargon就够了。";
		next;
		mes "我给你安排了名为^880088有用材料^000000的请求。打开^990099任务窗口^000000即可查看请求详情和报告对象。";
		close;
	}
	else if (.@tut_13 == 5) {
		setquest 12131;
		setquest 12162;
		mes "[Tragis]";
		mes "有一个请求是寻找用于各区域建筑维修的材料。";
		next;
		mes "[Tragis]";
		mes "请获取13个可从蜈蚣和蜈蚣幼虫身上获得的坚固外壳。这对维修工作很有用。";
		next;
		mes "我给你安排了名为^880088建筑必需材料^000000的请求。打开^990099任务窗口^000000即可查看请求详情和报告对象。";
		close;
	}
	else if (.@tut_13 == 6) {
		setquest 12132;
		setquest 12162;
		mes "[Tragis]";
		mes "有一个请求是寻找用于各区域建筑维修的材料。";
		next;
		mes "[Tragis]";
		mes "你需要获取16条可从捕虫草获得的坚韧藤蔓。这是建筑维修的重要材料。";
		next;
		mes "我给你安排了名为^880088建筑必需材料2^000000的请求。打开^990099任务窗口^000000即可查看请求详情和报告对象。";
		close;

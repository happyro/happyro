		setquest 12159;
		mes "[Laponte]";
		mes "蜈蚣的繁殖也是个问题，但它们的食欲也威胁着自身生存。";
		next;
		mes "[Laponte]";
		mes "它们吸收Bradium矿物，破坏我们的采矿区。";
		next;
		mes "[Laponte]";
		mes "许多Sapha同伴都死在蜈蚣手中。请消灭它们。";
		next;
		mes "我给你安排了名为^880088贪食昆虫^000000的请求。打开^990099任务窗口^000000即可查看请求详情和报告对象。";
		close;
	}
	else {
		setquest 12105;
		setquest 12159;
		mes "[Laponte]";
		mes "有人报告说矿井里的Bradium原矿活过来了。";
		next;
		mes "[Laponte]";
		mes "看来Bradium原矿被古老法术变成了魔像，我们可能得因此关闭矿井。你能去消灭它们吗？";
		next;
		mes "我给你安排了名为^880088移动的岩石^000000的请求。打开^990099任务窗口^000000即可查看请求详情和报告对象。";
		close;
	}
}

dicastes01,208,230,3	script	Pura#pa0829	453,{
	if (!checkweight(1201,1)) {
		mes "你持有的物品种类太多。减少物品种类后再试。";
		close;
	}
	if ((MaxWeight - Weight) < 1000) {
		mes "物品重量太高，无法继续。减轻负重后再试。";
		close;
	}
	if (!isequipped(2782)) {
		mes "������";
		mes "������ �� ����� �� �𢲢�";
		next;
		mes "我不太想和你说话，因为你什么都不会理解。";
		close;
	}
	if (ep13_3_invite < 6) {
		mes "即使你试图交谈，Sapha也和你保持距离。看来他叫来了Galten卫兵。该走了。";
		close;
	}
	if (BaseLevel < 80) {
		mes "[Pura]";
		mes "没关系。";
		mes "我们还没不幸到需要你的帮助。";
		close;
	}
	if (checkquest(12161,PLAYTIME) == 2) {
		mes "[Pura]";
		mes "你已经见过行动部的^990099补给部门1号管理员^000000了吗？清空请求记录后，我会给你新的请求。";
		close;
	}
	else if (checkquest(12161,PLAYTIME) > -1) {
		mes "[Pura]";
		mes "我现在没有给你的请求。完成所有请求后，回行动部向^990099补给部门1号管理员^000000报告。";
		close;
	}
	mes "[Pura]";
	mes "欢迎。";
	mes "你来这里做什么？";
	next;
	if (select("请向我说明请求。:请给我一个请求。") == 1) {
		mes "[Pura]";
		mes "冒险家们帮助我";
		mes "运送各种物品";
		mes "这里生产的物品到";
		mes "该地区的";
		mes "其他地方。";
		next;
		mes "[Pura]";
		mes "这项工作没有限制，";
		mes "但";
		mes "有些工作比其他工作困难。";
		next;
		mes "[Pura]";
		mes "准备好后";
		mes "随时来找我。";
		close;
	}
	mes "[Pura]";
	mes "我会查看";
	mes "今天收到的请求列表。";
	next;
	mes "[Pura]";
	mes "嗯……";
	mes "我这里确实有件事";
	mes "很适合你。";
	next;
	set .@tut_13, rand(1,10);
	if (.@tut_13 == 1) {
		setquest 12117;
		setquest 12161;
		mes "[Pura]";
		mes "据说这个地区很久以前是湿地。但由于某种原因，环境逐年逐渐发生了变化。";
		next;
		mes "[Pura]";
		mes "Rapine营地附近还有一片保存完好的土地。你能带回一份枯萎花样本吗？这会是研究环境变化的好样本。";
		next;
		mes "我给你安排了名为^880088枯萎花^000000的请求。打开^990099任务窗口^000000即可查看请求详情和报告对象。";
		close;
	}
	else if (.@tut_13 == 2) {
		setquest 12118;
		setquest 12161;
		mes "[Pura]";
		mes "Bradium精炼机器坏了，现在无法为矿井工作的同伴提供足够的精炼Bradium。";
		next;
		mes "[Pura]";
		mes "所以我们让所有冒险家帮忙收集精炼Bradium。请从Bradium魔像处带回3个精炼Bradium。";
		next;
		mes "我给你安排了名为^880088受欢迎的矿物^000000的请求。打开^990099任务窗口^000000即可查看请求详情和报告对象。";
		close;
	}
	else if (.@tut_13 == 3) {
		setquest 12119;
		setquest 12161;
		mes "[Pura]";
		mes "我有一个带回16个龙鬃的请求。";
		next;
		mes "[Pura]";
		mes "龙鬃只能由Draco少量掉落，非常珍贵。它被用于我们的原住民旗帜、服装和野外装备设计。";
		next;
		mes "我给你安排了名为^880088珍贵纺织品^000000的请求。打开^990099任务窗口^000000即可查看请求详情和报告对象。";
		close;
	}
	else if (.@tut_13 == 4) {
		setquest 12120;
		setquest 12161;
		mes "[Pura]";
		mes "这是酒馆为异世界来客准备食物的请求。他们想要龙尾，作为可以长期保存的野外食物烹饪材料。";
		next;
		mes "[Pura]";
		mes "原来人类喜欢这种东西。请带回6个。";
		next;
		mes "我给你安排了名为^880088好奇的肉^000000的请求。打开^990099任务窗口^000000即可查看请求详情和报告对象。";
		close;
	}
	else if (.@tut_13 == 5) {
		setquest 12121;
		setquest 12161;
		mes "[Pura]";
		mes "通往城外的道路因近期降雪变成了危险的冰路。";
		next;
		mes "[Pura]";
		mes "撒开蛋壳碎片会有帮助，我们需要很多，大约26个就够了。";
		next;
		mes "我给你安排了名为^880088清雪材料^000000的请求。打开^990099任务窗口^000000即可查看请求详情和报告对象。";
		close;
	}
	else if (.@tut_13 == 6) {
		setquest 12122;
		setquest 12161;
		mes "[Pura]";
		mes "Bradium加工机器使用时会释放巨大热量，任何水都无法使其稳定。";
		next;
		mes "[Pura]";
		mes "所以我们把融雪获得的水元素晶泪混合进去。这是每天都需要的材料，请带回6个。";
		next;
		mes "我给你安排了名为^880088最佳冷却材料^000000的请求。打开^990099任务窗口^000000即可查看请求详情和报告对象。";
		close;
	}
	else if (.@tut_13 == 7) {
		setquest 12123;
		setquest 12161;
		mes "[Pura]";
		mes "补给管理员紧急请求油漆，用于全城建筑维护。";
		next;
		mes "[Pura]";
		mes "他可以用从水元素处获得的荧光液制作足够的油漆。请带回26罐。";
		next;
		mes "我给你安排了名为^880088最佳油漆^000000的请求。打开^990099任务窗口^000000即可查看请求详情和报告对象。";
		close;
	}
	else if (.@tut_13 == 8) {
		setquest 12124;
		setquest 12161;
		mes "[Pura]";
		mes "部长房间里珍贵的室内水瓶坏了。由于每天访客众多，他们找不到是谁弄坏的。";
		next;
		mes "[Pura]";
		mes "你能从水元素那里带回这种珍贵物品吗？我只需要1个。";
		next;
		mes "我给你安排了名为^880088稀有珍品^000000的请求。打开^990099任务窗口^000000即可查看请求详情和报告对象。";
		close;
	}
	else if (.@tut_13 == 9) {
		setquest 12125;
		setquest 12161;
		mes "[Pura]";
		mes "卫兵铠甲的衬里材料用光了。";
		next;
		mes "[Pura]";
		mes "Naga的鳞片壳是完美的衬里材料。请带回18个。";
		next;
		mes "我给你安排了名为^880088军械材料^000000的请求。打开^990099任务窗口^000000即可查看请求详情和报告对象。";
		close;
	}
	else {
		setquest 12126;
		setquest 12161;
		mes "[Pura]";
		mes "我给你安排了卫兵指挥官铠甲衬里材料的请求。这些材料不同于普通衬里。";
		next;
		mes "[Pura]";
		mes "请带回11片Naga的闪亮鳞片。我觉得这对你来说不难。";
		next;
		mes "我给你安排了名为^880088高级军械材料^000000的请求。打开^990099任务窗口^000000即可查看请求详情和报告对象。";
		close;
	}
	close;
}


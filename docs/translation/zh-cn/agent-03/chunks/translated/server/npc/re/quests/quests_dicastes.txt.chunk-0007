		next;
		mes "我不太想和你说话，因为你什么都不会理解。";
		close;
	}
	if (ep13_3_invite < 6) {
		mes "即使你试图交谈，Sapha也和你保持距离。看来他叫来了Galten卫兵。该走了。";
		close;
	}
	if (BaseLevel < 80) {

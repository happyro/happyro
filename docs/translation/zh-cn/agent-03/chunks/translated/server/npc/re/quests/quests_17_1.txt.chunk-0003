		next;
		mes "[Lazy]";
		mes "我坐火车来的，感觉更像头等舱。体验不错吧？";
		npctalk "饭菜很美味，而且一路上没有生病。","",bc_self;
		unittalk getcharid(3),strcharinfo(0) + "：我一路都觉得不舒服！",bc_self;
		next;
		mes "[Lazy]";
		mes "VIP 正在逐渐熟悉我们，这会给他一些灵感。啊哈哈哈。";
		next;
		cutin "ep171_kaya01",0;
		mes "[Kaya]";
		mes "我们应该快点。";
		next;
		cutin "16lei_01",2;
		mes "[Lazy]";
		mes "VIP 想节省时间。我理解。让我尽可能简洁地说明计划。";
		next;
		cutin "16lei_03",2;
		mes "[Lazy]";
		mes "在里希塔乐镇，市中心和贫民窟共存。两边都有建筑，使人难以穿过铁路往来。";
		next;
		mes "[Lazy]";
		mes "通常我们都会得到自由通行证，但现在没时间了，这就是我能准备的最好方案。";
		npctalk "而且这比进入我的房子容易多了。","",bc_self;
		next;
		cutin "ep171_kaya01",0;
		mes "[Kaya]";
		mes "那是什么？";
		next;
		cutin "16lei_01",2;
		mes "[Lazy]";
		mes "哦，别担心，这是给我们特工的临时通行证。当然，你不必知道更多。";
		unittalk getcharid(3),strcharinfo(0) + "：我很高兴不用穿过小洞。",bc_self;
		next;
		mes "[Lazy]";
		mes "现在我们应该前往<NAVI>[贫民窟]<INFO>lighthalzen,336,266,0,101,0</INFO></NAVI>。";
		completequest 17004;
		setquest 17005;
		close2;
		cutin "",255;
		warp "lighthalzen",316,227;
		cloakonnpc "Kaya Tos#171_lhz",getcharid(0);
		cloakonnpc "Aas#171_lhz",getcharid(0);
		cloakoffnpc "Kaya Tos#171_lhz2",getcharid(0);
		cloakoffnpc "Aas#171_lhz2",getcharid(0);
		end;
	}
	if (isbegin_quest(17005) == 1) {
		cutin "16lei_01",2;
		mes "[Lazy]";
		mes "我找到下一站了。我们前往<NAVI>[贫民窟]<INFO>lighthalzen,336,266,0,101,0</INFO></NAVI>吧。";
		close3;
	}
	cutin "16lei_01",2;
	mes "[Lazy]";
	mes "去总部吧。雷根贝勒的道路宽阔而闪耀～大家都知道施瓦尔茨瓦尔德共和国～";
	npctalk "雷根贝勒的道路宽阔而闪耀～大家都知道施瓦尔茨瓦尔德共和国～","",bc_self;
	close3;

OnInit:
	questinfo(QTYPE_QUEST,QMARK_YELLOW,"isbegin_quest(17004) == 1");
	end;
}

lighthalzen,316,227,0	script	#EP171_EVT_LHZ	HIDDEN_WARP_NPC,5,5,{
	end;

OnTouch:
	if (isbegin_quest(17005) == 1) {
		cloakoffnpc "Kaya Tos#171_lhz2",getcharid(0);
		cloakoffnpc "Aas#171_lhz2",getcharid(0);
	}
	end;
}

lighthalzen,336,266,3	script	Lazy#171_lhz2	4_M_LAZY,{
	if (isbegin_quest(17005) == 1) {
		cloakoffnpc "Kaya Tos#171_lhz2",getcharid(0);
		cloakoffnpc "Aas#171_lhz2",getcharid(0);
		cutin "16lei_01",2;
		mes "[Lazy]";
		mes "这是 Pat 的家。Pat 就是在这里第一次接触雷根贝勒并遇到一名职员。";
		sleep2 2000;
		specialeffect EF_DA_SPACE,AREA,"Pat#171_lhz";
		specialeffect EF_DA_SPACE,AREA,"Recruiter#171_lhz";
		cloakoffnpc "Pat#171_lhz",getcharid(0);
		cloakoffnpc "Recruiter#171_lhz",getcharid(0);
		sleep2 2000;
		npctalk "这里是工作申请……","Recruiter#171_lhz",bc_self;
		sleep2 2000;
		npctalk "我真的可以申请这份工作吗……？","Pat#171_lhz",bc_self;
		sleep2 2000;
		npctalk "任何人都可以做到。","Recruiter#171_lhz",bc_self;
		sleep2 2000;
		npctalk "你确定吗？","Pat#171_lhz",bc_self;
		next;
		cutin "16lei_03",2;
		mes "[Lazy]";
		mes "Pat 一定努力工作，想获得摆脱贫困、过上更好生活的机会。他想重新开始。";
		sleep2 2000;
		npctalk "非常感谢！","Pat#171_lhz",bc_self;
		sleep2 2000;
		cloakonnpc "Recruiter#171_lhz",getcharid(0);
		sleep2 500;
		cloakonnpc "Pat#171_lhz",getcharid(0);
		next;
		cutin "16lei_01",2;
		mes "[Lazy]";
		mes "嘿！你们在这里。妈妈、爸爸，你们好吗？";
		next;
		cloakoffnpc "Pat's Mother#171_lhz",getcharid(0);
		cloakoffnpc "Pat's Father#171_lhz",getcharid(0);
		cutin "",255;
		mes "[Mother]";
		mes "谁……？";
		next;
		mes "[Father]";
		mes "哦，他就是前段时间一直寻找 Patrick 的人。";
		unittalk getcharid(3),strcharinfo(0) + "：你以前来过这里吗？",bc_self;
		npctalk "只有这里吗？","",bc_self;
		next;
		mes "[Mother]";
		mes "啊，是你！你见到……Pat 了吗？";
		next;
		mes "[Father]";
		mes "你为什么认为他们会失去一个在公司干得很好的人？";
		next;
		mes "[Mother]";
		mes "不，肯定有哪里不对！他不是会^0000FF突然停止联系我们^000000的人。";
		next;
		mes "[Father]";
		mes "如果你不太忙，也许可以继续寻找！我会尽力把工资寄到位！";
		next;
		mes "[Mother]";
		mes "咦？当然重要！";
		mes "这关系到我们如何供养 Pat。但奇怪的是，我们至今还没收到他的消息。";
		next;
		cutin "16lei_01",2;
		mes "[Lazy]";
		mes "嘿～妈妈，别和爸爸吵架。";
		npctalk "谁在吵架？","Pat's Father#171_lhz",bc_self;
		next;
		mes "[Lazy]";
		mes "我和你儿子公司的一位非常^0000FF重要^000000的成员一起来的。我前几天怎么说的？他是来了解雇用特殊人才的家庭福利的。";
		unittalk getcharid(3),strcharinfo(0) + "：你已经调查过这个线索了吗？",bc_self;
		npctalk "这是接近他人的诸多方式之一，所以看好了。我还有很多技巧。","",bc_self;
		next;
		cutin "",255;
		mes "[Father]";
		mes "你好～就是他吗？";
		next;
		cutin "16lei_01",2;
		mes "[Lazy]";
		mes "是的，就是他。你们可以尽管问他。他来这里就是为了这个。";
		npctalk "你想说什么都可以，不用犹豫。","",bc_self;
		sleep2 2000;
		unittalk getcharid(3),strcharinfo(0) + "：看来只能由我来处理了。",bc_self;
		sleep2 2000;
		npctalk "你观察得很快。","",bc_self;
		next;
		cutin "",255;
		mes "[Father]";
		mes "你好～我真不知道从哪里开始……谢谢你们录用我儿子，我们家不用再担心有没有足够食物活下去了。谢谢，谢谢。";
		next;
		mes "[Father]";
		mes "你可能觉得我儿子不值得，但他很擅长修理东西。";
		next;
		mes "[Father]";
		mes "多亏这份工作，我现在有工作并能养活家人。我为此感到自豪。";
		next;
		mes "[Mother]";
		mes "但是，我们甚至不知道他是死是活。";
		next;
		mes "[Father]";
		mes "我不知道是否该直接去公司找他，我工作很忙，也无法联系他。";
		next;
		mes "[Father]";
		mes "我不想惹公司麻烦，我告诉儿子要服从命令，不要抱怨。";
		next;
		mes "[Father]";
		mes "如果事情出了问题，请告诉我们。他从小就很认真，也能修理任何东西。";
		next;
		mes "[Mother]";
		mes "亲爱的！你没问重要的问题。有规定禁止我儿子联系我们吗？孩子被雇用那天后就没联系过，我自己也无法联系他……";
		npctalk "他可能在休假！谢谢你帮我找到工作！","Pat's Father#171_lhz",bc_self;
		sleep2 2000;
		npctalk "不可能，他们怎么会不给他放一天假？","Pat's Mother#171_lhz",bc_self;
		next;
		cutin "ep171_kaya01",0;
		mes "[Kaya]";
		mes "没有限制私人联系的规定。我们也按政府建议支付假期工资……你儿子说自己正在休假。";
		next;
		cutin "",255;
		mes "[Father]";
		mes "你的意思是 Patrick 甚至不会来看我们？";
		next;
		mes "[Mother]";
		mes "也许他已经不喜欢我们了……^0000FF我第一次休假^000000时，就回家和家人交谈。";
		next;
		mes "[Father]";
		mes "哦，我工作时也能做到！";
		mes "你到底对公司的人做了什么！事情怎么会发展到这种地步！";
		next;
		cutin "16lei_01",2;
		mes "[Lazy]";
		mes "天啊！妈妈、爸爸！谢谢你们！既然你们无法联系他，难道不好奇他发生了什么吗？我确定你们很好奇。";
		next;
		mes "[Lazy]";
		mes "我们会见到你们的儿子，继续调查，然后联系你们。你们可以相信我并等待。相信我，好吗？";
		next;
		cutin "",255;
		mes "[Mother]";
		mes "哦～真不敢相信。非常感谢。我担心我们很难联系你……";
		next;
		mes "[Father]";
		mes "啊～要怎么联系你！无论如何！就算我们很忙，也请再联系我们！";
		next;
		cutin "16lei_01",2;
		mes "[Lazy]";
		mes "好。那么我们走了！";
		next;
		cutin "",255;
		mes "[Father]";
		mes "保重！";
		cloakonnpc "Pat's Mother#171_lhz",getcharid(0);
		cloakonnpc "Pat's Father#171_lhz",getcharid(0);
		sleep2 1800;
		next;
		cutin "16lei_02",2;
		mes "[Lazy]";
		mes "你都听到了吗？正如文件所说，他加入公司后他们甚至没接到过电话。唉，我不喜欢看到他们那样，但我必须履行导游的第一个承诺。";
		next;
		cutin "ep171_kaya01",0;
		mes "[Kaya]";
		mes "我相信员工休假时不会回家探望。这不是^0000FF隐私问题^000000吗？与我们无关。";
		next;
		cutin "16lei_03",2;
		mes "[Lazy]";
		mes "你觉得文件里的每个人都是这样吗？不可能。Pat 是顾家的人，你真的觉得他会因为私人问题，休假时也不回家吗？你真的相信吗？";
		npctalk "你肯定不是真的相信那样吧。","",bc_self;
		next;
		cutin "16lei_01",2;
		mes "[Lazy]";
		mes "那你呢，卫兵？";
		next;
		cutin "ep171_as01",1;
		mes "[Aas]";
		mes "你是在问我吗？";
		next;
		cutin "16lei_01",2;
		mes "[Lazy]";
		mes "没错，就是你。你的样子不像喜欢坐在旅馆里的人，你呢？休假时不会见认识的人吗？";
		next;
		cutin "ep171_as01",1;
		mes "[Aas]";
		mes "是的，我休假时经常和家人见面，有时也会见朋友。";
		next;
		cutin "16lei_01",2;
		mes "[Lazy]";
		mes "看吧？我就知道。谁会不这么做？好吧，十个人里可能有一个不会。";
		next;
		cutin "ep171_kaya01",0;
		mes "[Kaya]";
		mes "公司不会调查私人事务。之所以是私人事务自有原因。想想看，你愿意别人调查你的私事吗？";
		next;
		cutin "16lei_01",2;
		mes "[Lazy]";
		mes "啊～你想再和他们见几分钟吗～VIP 还会来这里吗？";
		next;
		cutin "ep171_kaya01",0;
		mes "[Kaya]";
		mes "我想我已经听够了。我们去总部寻找剩余信息。";
		next;
		cutin "16lei_01",2;
		mes "[Lazy]";
		mes "制作这些文件的人对 Pat 一无所知。名单上不止一两个人。你真的该只听一个人的话吗？";
		next;
		cutin "16lei_02",2;
		mes "[Lazy]";
		mes "你不累吗？这条路又窄又陡。";
		npctalk "啊哈哈哈。VIP 从没听过比金勺子更沉重的东西。","",bc_self;
		next;
		cutin "16lei_01",2;
		mes "[Lazy]";
		mes "你已经累了吗？每天都有这样的人。你们的人民受苦，更多人也在受苦，甚至让人无法辨认痛苦。";
		next;
		cutin "ep171_kaya03",0;
		mes "[Kaya]";
		mes "你是在命令我吗？";
		next;
		cutin "16lei_01",2;
		mes "[Lazy]";
		mes "你好～我只是导游，怎么会命令你呢。判断由 VIP 的智慧、理性和良知做出～";
		next;
		mes "[Lazy]";
		mes "好！我们要继续追查 Pat，所以导游的下一站是<NAVI>[总部]<INFO>lighthalzen,107,165,0,101,0</INFO></NAVI>。";
		completequest 17005;
		setquest 17006;
		close2;
		cutin "",255;
		warp "lighthalzen",251,215;
		end;
	}
	if (isbegin_quest(17006) == 1) {
		cutin "16lei_01",2;
		mes "[Lazy]";
		mes "好！我们要继续追查 Pat，所以导游的下一站是<NAVI>[总部]<INFO>lighthalzen,107,165,0,101,0</INFO></NAVI>。";
		close2;
		cutin "",255;
		warp "lighthalzen",251,215;
		end;
	}
	cutin "16lei_01",2;
	mes "[Lazy]";
	mes "雷根贝勒的道路宽阔而闪耀～大家都知道施瓦尔茨瓦尔德共和国～";
	close3;

OnInit:
	questinfo(QTYPE_QUEST,QMARK_YELLOW,"isbegin_quest(17005) == 1");
	end;
}

lighthalzen,108,163,3	script	Lazy#171_lhz3	4_M_LAZY,{
	if (isbegin_quest(17006) == 1) {
		cutin "16lei_01",2;
		mes "[Lazy]";
		mes "冒险者！你来了！还能是谁？";
		next;
		cloakoffnpc "Kaya Tos#171_lhz3",getcharid(0);
		cloakoffnpc "Aas#171_lhz3",getcharid(0);
		cutin "16lei_02",2;
		mes "[Lazy]";
		mes "你终于到了。我对你来说太快了吗？还是 VIP 的鞋不适合长途跋涉？";
		unittalk getcharid(3),strcharinfo(0) + "：我们为什么来这里？！",bc_self;
		next;
		cutin "16lei_01",2;
		mes "[Lazy]";
		mes "我们终于到了雷根贝勒。";
		next;
		specialeffect EF_DA_SPACE,AREA,"Pat#171_lhz2";
		cloakoffnpc "Pat#171_lhz2",getcharid(0);
		cutin "16lei_03",2;
		mes "[Lazy]";
		mes "Pat 站在大楼前时，应该松了一口气。";
		mes "贫民窟的工作和雷根贝勒的工作并没有太大不同。";
		npctalk "真的……雷根贝勒……我……我现在到这里了……！","Pat#171_lhz2",bc_self;
		next;
		cutin "",255;
		mes "[Protester]";
		mes "雷根贝勒，^0000FF给个解释！^000000";
		next;
		cloakonnpc "Pat#171_lhz2",getcharid(0);
		cloakoffnpc "Protester#171_lhz",getcharid(0);
		cutin "ep171_kaya01",0;
		mes "[Kaya]";
		mes "解释？";
		next;
		cutin "16lei_01",2;
		mes "[Lazy]";
		mes "啊！做得好。我正想把她介绍给你。她是名单上^0000FF另一名失踪者^000000的未婚妻。";
		next;
		cutin "16lei_03",2;
		mes "[Lazy]";
		mes "她的未婚夫被雷根贝勒雇用后，她就再也联系不上他了。当然她试着联系公司，询问发生了什么，但他们告诉她什么？";
		next;
		cutin "16lei_01",2;
		mes "[Lazy]";
		mes "嘿，Eva！你好！过来，过来！";
		next;
		cutin "",255;
		mes "[Protester]";
		mes "Daisy？你好。你有更多发生经过的信息吗？";
		next;
		cutin "16lei_01",2;
		mes "[Lazy]";
		mes "哦，那个？我还不知道，但我是和副总统一起来查清楚的。";
		next;
		cutin "",255;
		mes "[Protester]";
		mes "副……总统？就是这个人？";
		next;
		cutin "16lei_02",2;
		mes "[Lazy]";
		mes "没错。你有话要告诉他吗？说吧！";
		mes "这会很有意思，我今天起床没有后悔！";
		npctalk "这家伙到底在想什么？","Aas#171_lhz3",bc_self;
		unittalk getcharid(3),strcharinfo(0) + "：我……我觉得这是我的错。",bc_self;
		next;
		cutin "",255;
		mes "[Eva]";
		mes "Marcus 怎么了？把我的 Marcus 还给我！我已经两年没听到 Marcus 的消息了！";
		next;
		cutin "ep171_kaya01",0;
		mes "[Kaya]";
		mes "你在找 Marcus？Mar……cus……Holzman。他来自里希塔乐镇东部……";
		next;
		cutin "16lei_01",2;
		mes "[Lazy]";
		mes "哦，真巧。他也来自里希塔乐镇贫民窟！";
		next;
		cutin "ep171_kaya01",0;
		mes "[Kaya]";
		mes "也许他已经不想联系你了？";
		next;
		cutin "",255;
		mes "[Eva]";
		mes "Marcus 绝不会这样对我！我的 Marcus……Marcus……";
		next;
		cutin "ep171_kaya01",0;
		mes "[Kaya]";
		mes "不管真相是什么，我不知道还有第三个人遇到和你一样的问题。";
		next;
		cutin "",255;
		mes "[Eva]";
		mes "即使 Marcus 对我的想法变了，他也不是唯一一个！";
		mes "贫民窟中被雷根贝勒雇用的大多数人^0000FF已经无法联系。^000000";
		next;
		mes "[Eva]";
		mes "你真的觉得所有人都会这样改变想法吗？对家人？朋友？甚至恋人？这可是更严重的问题！";
		mes "雷根贝勒到底对他们的员工做了什么？！";
		npctalk "看吧。和我说的一样。","",bc_self;
		next;
		cutin "ep171_kaya01",0;
		mes "[Kaya]";
		mes "我想知道更多细节。我们回去吧。如果在这里闹事，他们会叫警察。";
		npctalk "副总统，我希望你能进去。","",bc_self;
		next;
		cutin "",255;
		mes "[Eva]";
		mes "什么？你想把我赶出去？";
		mes "我对你来说是个问题吗？你觉得我会轻易放弃？在找到 Marcus 前我会一直来！";
		npctalk "我会记住你的脸！！别以为你能永远安全！晚上小心！","Protester#171_lhz",bc_self;
		next;
		cloakonnpc "Protester#171_lhz",getcharid(0);
		cutin "16lei_03",2;
		mes "[Lazy]";
		mes "她说他见过 VIP……";
		next;
		cutin "ep171_kaya03",0;
		mes "[Kaya]";
		mes "你想说什么？";
		next;
		cutin "16lei_03",2;
		mes "[Lazy]";

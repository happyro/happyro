		mes "你又看到心脏猎手了吗？";
		mes "那些不是我们之前在战场上战斗过的卫兵吗？";
		next;
		mes "[Est]";
		mes "如果对手是心脏猎手，那就有意思了。";
		mes "我应该能很快解决他们。";
		mes "我先去。";
		next;
		mes "[Est]";
		mes "好了，Aas，你说呢？";
		next;
		cutin "ep171_as02",1;
		mes "[Aas]";
		mes "是？是的！我能怎么帮你？";
		next;
		cutin "ep162_est02",2;
		mes "[Est]";
		mes "你直接这么说不就行了吗？";
		mes "你害怕这些卫兵吗？";
		mes "你告诉我们路线后，我们不就该出发了吗？";
		mes "来吧？就像我们第一次行动那样。";
		next;
		cutin "ep171_as01",1;
		mes "[Aas]";
		mes "是的，我明白了。你说得对。";
		mes "我得去把情况解释得更详细一些……";
		npctalk "那么，副总统……","Rekenber Senior Guard#171_cat",bc_self;
		next;
		cutin "ep171_kaya02",0;
		mes "[Middle-Aged Man]";
		mes "不用担心我。";
		mes "我留在这里安全吗？";
		mes "我有必须完成的事。你去做你那边该做的事吧。";
		next;
		cutin "ep171_as01",1;
		mes "[Aas]";
		mes "收到。那我去和Est讨论策略。";
		next;
		cutin "ep162_est03",2;
		mes "[Est]";
		mes "Tes，小心背后。哈哈，你会没事的。";
		next;
		cutin "ep171_kaya01",0;
		mes "[Middle-Aged Man]";
		mes "一切发生得太快了。";
		mes "真希望我们能更深入地讨论这次行动。";
		completequest 7860;
		cloakonnpc "Rekenber Senior Guard#171_cat",getcharid(0);
		cloakonnpc "Commander Est#171_cat",getcharid(0);
		close3;
	}
	npctalk "我觉得Kaya还有话要说。","",bc_self;
	end;

OnInit:
	questinfo(QTYPE_QUEST,QMARK_YELLOW,"isbegin_quest(7860) == 1");
	cloakonnpc();
	end;
}

pub_cat,163,102,3	script	Middle-Aged Man#171_cat	4_EP17_KAYA,{
	if (isbegin_quest(7860) == 1) {
		cutin "ep171_kaya01",0;
		mes "[Middle-Aged Man]";
		mes "我不该由我来开启这段谈话，你还是去和Tes谈吧。";
		close3;
	}
	if (isbegin_quest(7860) == 2 && isbegin_quest(7861) == 0) {
		cutin "ep171_kaya01",2;
		mes "[Kaya]";
		mes "现在我可以正式自我介绍了。";
		mes "我叫Kaya，在雷根贝勒部门工作。";
		next;
		mes "[Kaya]";
		mes "企业里剩下的安保人员不多了，因为大多数人都背叛了雷根贝勒。";
		next;
		mes "[Kaya]";
		mes "所以现在，我们剩下的人都在尽力关闭烈盾……";
		mes "我四处发出了求助请求，但还没有得到什么有用的回复。";
		next;
		cutin "ep16_tes01",1;
		mes "[Tes]";
		mes "数量异常多的公司直接联系了雷根贝勒寻求支援。";
		next;
		mes "[Tes]";
		mes  "但作为施瓦茨共和国的普通士兵，我们很难独自处理这些事，最后只能借助反叛军和冒险家的力量。";
		next;
		cutin "ep171_kaya02",2;
		mes "[Kaya]";
		mes "我能理解Est为什么那么生气。";
		mes "有许多人对腐败的管理视而不见，也有些人自行其是。";
		next;
		mes "[Kaya]";
		mes "我来到这里是为了清除企业里的邪恶。";
		mes "然而，我没想到这些腐败之人竟然和政界有如此深的联系。";
		next;
		cutin "ep171_kaya01",2;
		mes "[Kaya]";
		mes "市民的安全受到了威胁，";
		mes "他们不知道企业在想什么，也无法正式寻求帮助和支援。";
		next;
		cutin "ep16_tes03",1;
		mes "[Tes]";
		mes "唉，等等。";
		mes "你说得没错，但这其中还有别的原因。";
		mes "看起来你的姐姐和总统达成了某种协议。";
		next;
		cutin "ep171_kaya03",2;
		mes "[Kaya]";
		mes "不，如果一开始就是合适的人在治理，根本没必要达成这种协议！";
		next;
		cutin "ep16_tes03",1;
		mes "[Tes]";
		mes "你不觉得企业从一开始就妥善管理的话，我们现在根本不会陷入这种局面吗？";
		next;
		cutin "ep171_kaya02",2;
		mes "[Kaya]";
		mes ".....";
		mes "抱歉，我有些激动了。";
		mes "只要执行我们的计划，我相信我们会拥有更好的未来。";
		next;
		cutin "ep16_tes01",1;
		mes "[Tes]";
		mes "我同意，不过我们必须迅速行动。";
		mes "所以，" + strcharinfo(0) + ",";
		mes "可以的话，你能和Est一起制定计划吗？";
		next;
		mes "[Tes]";
		mes "正如所说，他们被称为‘心脏猎手’。";
		mes "也许这和之前的事件有关。或许我们能找到更多信息，传给卢恩-米德加兹。";
		next;
		mes "[Tes]";
		mes "我和Kaya会留在这里处理并传递收到的信息。";
		mes "战斗方面就交给你和Est了。";
		next;
		cutin "ep171_kaya01",2;
		mes "[Kaya]";
		mes "请多保重。";
		setquest 7861;
		next;
		cutin "ep16_tes01",1;
		mes "[Tes]";
		mes "我们外面见。";
		close2;
		cutin "",255;
		cloakonnpc "Philofontes#171_cat2",getcharid(0);
		end;
	}
	cutin "ep171_kaya01",0;
	mes "[Kaya]";
	mes "抱歉，我没法再帮你了。";
	mes "我觉得事情可能会演变成一场混战。";
	close3;

OnInit:
	questinfo(QTYPE_QUEST,QMARK_YELLOW,"isbegin_quest(7860) == 2 && isbegin_quest(7861) == 0");
	cloakonnpc();
	end;
}

pub_cat,165,103,3	script	Rekenber Senior Guard#171_cat	4_EP17_AS,{
	cutin "ep171_as02",1;
	mes "[Aas]";
	mes "哦，你好！我是雷根贝勒安保部门的Aas。";
	mes "我目前是Kaya Tos的保镖。";
	close3;

OnInit:
	cloakonnpc();
	end;
}

pub_cat,166,100,3	script	Commander Est#171_cat	4_F_ESTLOVELOY,{
	cutin "ep162_est03",2;
	mes "[Est]";
	mes "我们为什么要帮他们？";
	mes "你能解释一下我们为什么必须和他们合作吗？";
	close3;

OnInit:
	cloakonnpc();
	end;
}


pub_cat,106,69,7	script	Lazy#171_cat	4_M_LAZY,{
	if (isbegin_quest(7864) == 1) {
		cutin "16lei_03",0;
		mes "[Lazy]";
		mes "看，有^0000CD事实^000000当然很好。但这些甚至不能成为你可以使用的力量。";
		next;
		cutin "ep171_kaya01",2;
		mes "[Kaya]";
		mes "我已经说过几次了。";
		mes "就是这些，这些就是全部的^0000CD事实。^000000";
		next;
		cutin "16lei_02",0;
		mes "[Lazy]";
		mes "说实话，这听起来并不可信。如果我看你报告的首页，就会发现它和我的调查结果完全不一致。";
		npctalk "如果你写的是真的，那天空是红色的也是真的。","",bc_self;
		next;
		cutin "ep171_kaya01",2;
		mes "[Kaya]";
		mes "如果是这样，那我们就该重新审视调查方法和来源的可信度。";
		next;
		cutin "16lei_03",0;
		mes "[Lazy]";
		mes "哦，当然，我这里有一份附近居民的午餐菜单调查……你想把这个当成事实吗？";
		next;
		cutin "ep171_kaya01",2;
		mes "[Kaya]";
		mes "我完全不是这个意思……";
		next;
		cutin "16lei_02",0;
		mes "[Lazy]";
		mes "什么，你不相信我？是吗？你觉得这不是可靠的信息来源？";
		next;
		cutin "ep171_kaya03",2;
		mes "[Kaya]";
		mes "^0000CD企业内部的人知道得更多，^000000这不是常识吗？";
		mes "我们不仅能接触到更多数据，数据质量也会比外部人员能获得的高得多。";
		next;
		cutin "16lei_02",0;
		mes "[Lazy]";
		mes "你不觉得副总统只会把^0000CD他想让我们知道的事^000000告诉我们吗？";
		mes "难道我要放弃所有批判性思考，毫无疑问地相信你？";
		next;
		mes "[Lazy]";
		mes "那不就意味着你可以直接向总统汇报，然后把计划瞒着我们吗？对吧？";
		npctalk "没有大批人群，对吧？","",bc_self;
		next;
		cutin "ep171_kaya01",2;
		mes "[Kaya]";
		mes "我从没这么说过。";
		next;
		select("Lazy，你怎么了？");
		cutin "16lei_01",0;
		mes "[Lazy]";
		mes "冒险家？冒险家！！嘿，我还没死呢！！好得不能再好了！！";
		mes "听我说。";
		next;
		cutin "ep171_kaya01",2;
		mes "[Kaya]";
		mes "Lazy？你的名字是Lazy？你不是自称Daisy吗？";
		next;
		cutin "16lei_02",0;
		mes "[Lazy]";
		mes "哦，那个？别担心，那是我用来迷惑别人的名字。好了，现在你了解我了。对了……算了，你不需要知道。";
		next;
		select("如果是Daisy……你是一朵花吗？");
		mes "[Lazy]";
		mes "听着，虽然对我来说可能是真的，但不代表它适用于我。";
		mes "别太往心里去。世上哪有人只有一个名字？";
		unittalk getcharid(3),strcharinfo(0)+ "：其他人不都只有一个名字吗？",bc_self;
		npctalk "真的吗？！","",bc_self;
		next;
		cutin "ep171_kaya01",2;
		mes "[Kaya]";
		mes "如果你没有别的要说的，那就请解释一下为什么你的名字不一样。";
		next;
		cutin "16lei_03",0;
		mes "[Lazy]";
		mes "我生来就是要谈论这些的，但你说的是谁？";
		mes "我有太多事情可以聊了，聊上一整天都没问题。";
		next;
		mes "[Lazy]";
		mes "你也知道，这场谈话是商务会议，副总统的下属不是正站在你身后吗？";
		npctalk "这里还有谁拿着雷根贝勒的薪水？冒险家吗？","",bc_self;
		npctalk "你是在说我吗？","Aas#171_cat",bc_self;
		next;
		mes "[Lazy]";
		mes "邻近地区已经知道雷根贝勒在进行非法实验了。名单上的人也许参与其中。";
		next;
		cutin "16lei_02",0;
		mes "[Lazy]";
		mes "你不想消除他们的疑虑吗？争取他们的合作，弄清楚你们的后院里有什么？";
		mes "如果由我决定，我早就这么做了。我们什么时候还能有这样的机会？";
		next;
		cutin "16lei_03",0;
		mes "[Lazy]";
		mes "你们的后院还藏着什么？你不是来请求我们帮忙的吗？如果那里藏着什么，";
		mes "副总统岂不是会有麻烦？";
		next;
		cutin "ep171_kaya01",2;
		mes "[Kaya]";
		mes "请求帮助和分析文件是两回事。";
		next;
		cutin "16lei_03",0;
		mes "[Lazy]";
		mes "你说是两回事就是两回事吗？你什么时候决定的？";
		next;
		mes "[Lazy]";
		mes "现在这已经变成信任问题了，不只是人员失踪的问题！";
		npctalk "你还把我当雏菊吗？！","",bc_self;
		next;
		mes "[Lazy]";
		mes "在处理完这些文件之前，你凭什么指望我们信任你？";
		mes "你为什么会这么想？这里没人相信你，不是吗？";
		next;
		cutin "16lei_02",0;
		mes "[Lazy]";
		mes "所以真正的问题是！我们之间没有信任，又怎么能真正和你合作？";
		npctalk "正确答案是我们做不到！我觉得那不可能。","",bc_self;
		next;
		cutin "ep171_kaya01",2;
		mes "[Kaya]";
		mes "这些是雷根贝勒调查的官方文件。";
		mes "Daisy，不管你信不信，我不知道还能怎样消除你的疑虑。";
		next;
		cutin "16lei_02",0;
		mes "[Lazy]";
		mes "所以你彻底调查了企业，你的信息^0000CD百分之百可靠。^000000";
		mes "所以我们必须无条件相信。这不是很奇怪吗？你没有证据吗？";
		npctalk "我还不知道雷根贝勒是这种宗教团体。","",bc_self;
		next;
		cutin "16lei_03",0;
		mes "[Lazy]";
		mes "我的意思是，如果这份文件真的可信，那你就是在叫我骗子，副总统！";
		next;
		cutin "16lei_01",0;
		mes "[Lazy]";
		mes "哦……真突然。被叫作骗子后，我还该寻求副总统的合作吗？";
		npctalk "问题是，它可靠吗？","",bc_self;
		next;
		cutin "ep171_kaya01",2;
		mes "[Kaya]";
		mes "我从没叫你骗子……";
		next;
		cutin "16lei_02",0;
		mes "[Lazy]";
		mes "不，不是那样。你请求我们的合作，却要我们在没有任何实际证据的情况下完全信任你。我们怎么能相信你？";
		next;
		cutin "16lei_03",0;
		mes "[Lazy]";
		mes "现在，就算你积极和我合作，我也很难信任这样的安排。";
		next;
		cutin "ep171_kaya01",2;
		mes "[Kaya]";
		mes "你现在只是在重复自己。我向你保证，这些文件值得信任。";
		next;
		cutin "16lei_02",0;
		mes "[Lazy]";
		mes "你不相信我，我为什么要相信你？我是个富有同情心、耐心又善良的人。";
		mes "你的眼睛难道闭得这么紧，连眼前的东西都看不见吗？";
		next;
		cutin "ep171_as02",2;
		mes "[Aas]";
		mes "你现在太过分了！";
		next;
		cutin "16lei_02",0;
		mes "[Lazy]";
		mes "别担心，没关系。你知道这一切都是真的。";
		next;
		cutin "ep171_as02",2;
		mes "[Aas]";
		mes "怎么了？你到底有什么问题？";
		next;
		cutin "16lei_02",0;
		mes "[Lazy]";
		mes "副总统，你觉得那样对吗？";
		next;
		cutin "ep171_kaya01",2;
		mes "[Kaya]";
		mes "........";
		next;
		cutin "16lei_02",0;
		mes "[Lazy]";
		mes "不？那我无所谓。";
		mes "我没事。";
		mes "我又不瞎。即使处在我的位置上，我也注意到企业在对我们隐瞒什么！";
		next;
		cutin "16lei_03",0;
		mes "[Lazy]";
		mes "总之，副总统，我知道你这种人是什么样，我会提交我的报告，也会按自己的方式做事。";
		npctalk "祝你今天愉快！","",bc_self;
		next;
		mes "["+ strcharinfo(0) + "]";
		mes "咦？Lazy？你要去哪儿！";
		cloakonnpc strnpcinfo(0),getcharid(0);
		sleep2 1000;
		cloakoffnpc "Lazy#171_cat2",getcharid(0);
		completequest 7864;
		setquest 17000;
		close3;
	}
	end;

OnInit:
	cloakonnpc();
	questinfo(QTYPE_QUEST,QMARK_YELLOW,"isbegin_quest(7864) == 1");
	end;
}

pub_cat,105,58,3	script	Lazy#171_cat2	4_M_LAZY,{
	if (isbegin_quest(17000) == 1) {
		cutin "16lei_03",2;
		mes "[Lazy]";
		mes "啊，真让人沮丧！";
		mes "冒险家！听我说！听我说完，你来判断谁是对的。你知道这些家伙都说了什么吗？";
		unittalk getcharid(3),strcharinfo(0)+ "：真丢脸。",bc_self;
		next;
		cutin "16lei_01",2;
		mes "[Lazy]";
		mes "现在，看看这里的这^0000CD堆文件^000000。你不用仔细阅读，只要看看封面。";
		next;
		select("雷根贝勒……失踪名单？");
		cutin "16lei_03",2;
		mes "[Lazy]";
		mes "没错。这是曾在雷根贝勒工作过的^0000CD失踪人员^000000名单。我已经尽可能调查了一切。";
		unittalk getcharid(3),strcharinfo(0)+ "：你发现了什么？",bc_self;
		next;
		cutin "16lei_02",2;
		mes "[Lazy]";
		mes "虽然我熟悉这些信息，但不可能再深入企业内部。";
		next;
		cutin "16lei_01",2;
		mes "[Lazy]";
		mes "如果想继续调查，我被告诫必须依法行事，以免造成更多摩擦。";
		next;
		mes "[Lazy]";
		mes "我认为总统和政府及其相关企业有关系。所以他们必须慎重考虑这件事。";
		npctalk "那不是我的风格。","",bc_self;
		next;
		cutin "16lei_03",2;
		mes "[Lazy]";
		mes "所以我遇到Kaya时，就请他和我合作。你可以在这方面帮助我们，对吧？";
		next;
		cutin "16lei_02",2;
		mes "[Lazy]";
		mes "因为他是雷根贝勒的官员，所以他应该很容易找到这些信息，对吧？";
		next;
		select("没错。");
		mes "[Lazy]";
		mes "不过，我需要你调查一下，并配合这次调查。你知道总部把文件甩给我时，我会是什么反应。";
		npctalk "我太失望了。要是冒险家遇上战斗怎么办？","",bc_self;
		next;
		cutin "16lei_03",2;
		mes "[Lazy]";
		mes "名单上的员工被调到了其他工作地点，而且一直在轮换。";
		mes "还确认他们每月都会收到付款。";
		next;
		mes "[Lazy]";
		mes "这只是常识，公司为什么要特意给失业的人发工资？";
		next;
		cutin "16lei_01",2;
		mes "[Lazy]";
		mes "我告诉你，这就是常识~";
		mes "在努力学习过的人面前，我当然可以说这是常识~";
		next;
		cutin "16lei_02",2;
		mes "[Lazy]";
		mes "等等，难道我误解了常识的含义？";
		mes "难道我在不知不觉中改变了它的定义？";

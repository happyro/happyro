//===== rAthena Script ======================================= 
//= Advance Class jobchanger after kRO Normals.
//===== By: ==================================================
//= Nana
//= finished, optimized and tested by Lupus
//===== Current Version: ===================================== 
//= 1.3
//===== Compatible With: ===================================== 
//= rAthena Project
//===== Description: ========================================= 
//= Advance Class jobchanger after kRO Normals.
//===== Additional Comments: ================================= 
//= 1.1 Made all into functions, additional checks, etc. [Lupus]
//= 1.2 Made numbers into constants. [Vicious]
//= 1.3 Now saves/restores all the quest skills [Lupus]
//============================================================ 

valkyrie,44,42,5	script	High Priest#Valkyrie	60,{
	if (ADVJOB == 0 || Upper != 1) {
		set .@karma_d,rand(1,10);
		if (.@karma_d > 4) {
			mes "[大主教]";
			mes "恭喜。";
			mes "向战士致敬！";
			close;
		}
		mes "[大主教]";
		mes "借助神圣之力，愿我们";
		mes "找到和平、力量";
		mes "与保护。请将我们从";
		mes "邪恶势力中拯救出来……";
		mes "";
		close;
	}
	else if (ADVJOB == Job_High_Priest && Class == Job_Acolyte_High && JobLevel > 39) {
		mes "[大主教]";
		mes "我们的世界需要";
		mes "有才华且坚定的人。";
		mes "";
		mes "请继续你的善行，成为";
		mes "更加伟大的圣洁英雄……";
		mes "";
		next;
		mes "[大主教]";
		mes "你愿意成为";
		mes "大主教吗？";
		next;
		if (select("不:是") == 1) {
			mes "[大主教]";
			mes "准备好后";
			mes "随时回来。";
			mes "向战士致敬！";
			close;
		}
		if (SkillPoint) {
			mes "[大主教]";
			mes "你还可以学习更多技能。请在回来前用完";
			mes "所有剩余技能点。";
			close;
		}
		jobchange Job_High_Priest;
		set ADVJOB,0;
		mes "[大主教]";
		mes "恭喜。";
		mes "作为大主教，";
		mes "希望你能引导他人";
		mes "走上";
		mes "圣洁之路……";
		close;
	}
	mes "[大主教]";
	mes "欢迎";
	mes "来到英灵殿，";
	mes "荣誉大厅。";
	next;
	mes "[大主教]";
	mes "请在这里";
	mes "安心休息。";
	mes "趁你在这里。";
	mes "向战士致敬！";
	close;
}

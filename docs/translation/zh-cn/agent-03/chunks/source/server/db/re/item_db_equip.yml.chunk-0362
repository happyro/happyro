      if (.@r>=7) {
         bonus bShortAtkRate,10;
         if (.@r>=9) {
            bonus bPAtk,5;
            if (.@r>=11) {
               bonus bUseSPrate,-5;
            }
         }
      }
      if (.@g>=ENCHANTGRADE_D) {
         bonus bPAtk,5;
         if (.@g>=ENCHANTGRADE_C) {
            bonus2 bSkillAtk,"SKE_SKY_MOON",15;
            if (.@g>=ENCHANTGRADE_B) {
               bonus2 bAddSize,Size_All,10;
               if (.@g>=ENCHANTGRADE_A) {
                  bonus2 bAddEle,Ele_All,10;
               }
            }
         }
      }

  - Id: 24872
    AegisName: S_Full_Power_Armor
    Name: Full Power Shadow Armor
    Type: ShadowGear
    Locations:
      Shadow_Armor: true
    EquipLevelMin: 200
    Refineable: true
    Script: |
      .@r = getrefine();
      bonus bMaxHP,.@r*10;
      bonus bAtkRate,3;
      bonus bLongAtkRate,(.@r/2);
      bonus bShortAtkRate,(.@r/2);
      if (.@r>=10) {
         bonus bPAtk,2;
      }

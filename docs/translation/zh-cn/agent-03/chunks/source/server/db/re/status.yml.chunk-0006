    Flags:
      NoDispell: true
      NoBanishingBuster: true
      NoClearance: true
    Script: |
      if (!getstatus(SC_BERSERK)) {
         .@val1 = -getstatus(SC_S_LIFEPOTION, 1);
         .@val2 = getstatus(SC_S_LIFEPOTION, 2) * 1000;
         bonus2 bRegenPercentHP, .@val1, .@val2;
      }

		mes "It is a good weather today.";
		mes "The banquet is in full swing in the palace.";
		next;
		mes "[Allen]";
		mes "They will be all destroyed when a bloody day comes.";
		mes "Why are we recording those vain things?";
		next;
		mes "[Jin]";
		mes "Because records remains forever.";
		mes "If you record today, someone in the future will read them and remember us.";
		next;
		mes "[Allen]";
		mes "Human comes from nothing and goes to nothing.";

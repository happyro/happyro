		mes "He probably went to the western part of the mansion, so head over there.";
		mes "You have Elyumina's tracker, if you get near him, it will activate.";
		next;
		mes "[Est]";
		mes "Don't worry, I'll take care of Almond from here.";
		close3;
	}
	end;
}


		mes "I think the rest of the members are somewhat good too.";
		next;
		mes "[Est]";
		mes "What happened to the repeater?";
		next;
		cutin "ep172_beta",2;
		mes "[Almond]";
		mes "Were on the way to the other one.";
		mes "But it's quite far from here.";
		next;
		cutin "ep162_est01",2;
		mes "[Est]";
		mes "Hmm... Shall we do this?";

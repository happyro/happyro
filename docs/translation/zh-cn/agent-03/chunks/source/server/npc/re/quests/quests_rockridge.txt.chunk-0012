}

rockrdg1,297,84,7	script	Taneska#rockc08	4_CAT_MERMASTER,{
	mes "[Taneska]";
	mes "This instrument itself is a work of art.";
	mes "Check out the exquisite finish around the drum skin, and the well-balanced, full-bodied sound from the barrel.";
	next;
	emotion ET_THROB;
	mes "[Taneska]";
	mes "Ah, I want to beat this drum! I'd love to hear its sound!";
	next;
	mes "[Tagliatelle]";
	mes "*Gasp* Taneska, please don't touch it! You were warned once already!";
	close;
}

rockrdg1,285,96,3	script	Glaring Eagle#rockc01	4_M_CACTUSMAN3,{
	mes "[Glaring Eagle]";
	mes "The strangers lost the battle with the sea and relinquished their homes. I thought they'd leave, but they're as resilient as weeds; they built another village on top of their old homes.";
	next;
	mes "[Litis]";
	mes "Mother Nature allows weeds to grow. She's allowing them to stay here.";
	next;
	npctalk "I'm too old now.", "", bc_self;
	mes "[Glaring Eagle]";
	mes "I know, Litis. I'm just being a stubborn old mule.";
	mes "But still I can't help but think that everything's happening too fast.";
	close;
}

rockrdg1,328,112,5	script	Karintas#rockc04	4_F_CACTUSCHILD2,{
	mes "[Karintas]";
	mes "My mom is better at hunting coyotes than any adventurer. I can hunt them, too!";
	next;
	mes "[Curt Snake]";
	mes "Karintas, has your mom ever hunted them for pleasure?";
	next;
	mes "[Karintas]";
	mes "Mm, no. She hunts them only when we need their fur and meat.";
	next;
	mes "[Curt Snake]";
	mes "Hurting nature should never be a game. These adventurers only hunt enough coyotes to keep us safe from them.";
	next;
	mes "[Curt Snake]";
	mes "If you get old enough to understand that, your mother will teach you how to hunt.";
	close;
}

rockrdg1,331,111,3	script	Juanitas#rockc02	4_M_CACTUSCHILD,5,5,{
	mes "[Juanitas]";
	mes "I'm the best coyote-hunting adventurer! I'm going to hunt a hundred coyotes!";
	next;
	mes "[Agile Scorpion]";
	mes "I-I'm Captain Adventurer! I'm going to hunt a hundred-hundred-hundred-hundred coyotes!";
	next;
	mes "[Curt Snake]";
	mes "You rascals, I told you not to play adventurers?they're not playing!";
	close;

OnTouch:
	npctalk "I'm Captain Adventurer! I'm going to hunt a hundred coyotes!", "Karintas#rockc04", bc_self;
	npctalk "Then I'm going to hunt a hundred-hundred-hundred coyotes!", "", bc_self;
	npctalk "I'm a coyote-hunting adventurer!", "Swift Scorpion#rockc03", bc_self;
	npctalk "You rascals, I told you not to play adventurer!", "Mrs. Cacturon#rrrem01", bc_self;
	end;
}

rockrdg1,327,109,5	script	Swift Scorpion#rockc03	4_F_CACTUSCHILD2,{
	mes "[Agile Scorpion]";
	mes "*Whine* But we want to hunt coyotes like them. Yap! Yap, yap! Hoi!";
	next;
	mes "[Karintas]";
	mes "Maybe the grownups in our village should go out and hunt coyotes, too.";
	next;
	mes "[Curt Snake]";
	mes "You knuckleheads, we don't want to hunt them.";
	mes "We want to live with them peacefully in this Kiwawa Desert.";
	next;
	mes "[Curt Snake]";
	mes "It's just not safe for us to have too many coyotes around. That's why we asked the adventurers for help.";
	mes "But that doesn't mean we want to get rid of all of them.";
	close;
}

rockrdg1,287,95,3	script	Litis#rockc10	4_F_CACTUSLADY2,{
	mes "[Litis]";
	mes "I understand what Mr. Glaring Eagle means and why he's so worried.";
	next;
	mes "[Litis]";
	mes "But the river today is not the same river it was yesterday. Things keep changing, and it's natural.";
	close;
}

rockrdg1,297,111,3	script	Roytanen#rockc10	4_F_RANGER,{
	mes "[Roytanen]";
	mes "*Gasp* I'm back in the Cactus village. Aww, I'm lost? again.";
	next;
	emotion ET_CRY;
	mes "[Roytanen]";
	mes "The Kiwawa Desert is vast and full of nothing but dirt and rocks. It's easy to get lost in it.";
	next;
	mes "[Roytanen]";
	mes "Gosh, I'm really not up to yet another excursion... I hope I could get a glass of cool water before I leave.";
	close;
}


harboro1,91,211,3	script	#rockno01	HIDDEN_NPC,5,5,{
	mes "[Central Road Sign]";
	mes "Follow this road east to get to the inn, the sheriff's office, shops, and the plaza.";
	next;
	mes "[Central Road Sign]";
	mes "This road also goes outside the village, to the Kiwawa Desert.";
	close;

OnTouch:
	npctalk "Central Road", "", bc_self;
	end;
}

harboro1,299,211,3	script	#rockno02	HIDDEN_NPC,5,5,{
	mes "[Plaza Sign]";
	mes "The Kafra services are available inside the Rock Ridge Plaza.";
	next;
	mes "[Plaza Sign]";
	mes "The sheriff's office and shop buildings are west of this plaza. The inn and the port are farther west.";
	close;

OnTouch:
	npctalk "Rock Ridge Plaza", "", bc_self;
	end;
}

harboro1,260,211,3	script	#rockno03	HIDDEN_NPC,5,5,{
	end;
OnTouch:
	npctalk "Sheriff's Office", "", bc_self;
	end;
}

harboro1,215,212,3	script	#rockno04	HIDDEN_NPC,5,5,{
	end;
OnTouch:
	npctalk "West: The Inn, East: The Sheriff's Office", "", bc_self;
	end;
}

harboro1,134,211,3	script	#rockno05	HIDDEN_NPC,5,5,{
	end;
OnTouch:
	npctalk "East: The Inn", "", bc_self;
	end;
}

harboro1,310,201,3	script	#rockno06	HIDDEN_NPC,5,5,{
	end;
OnTouch:
	npctalk "Tool Shop, Weapon/Armor Shop", "", bc_self;
	end;
}

harboro1,60,215,5	script	Karam Pucci#harboro1	4_M_SEAMAN,{
	mes "[Karam Pucci]";
	mes "Do you want to go back to Alberta?";
	next;
	if (select( "Yes.", "No." ) == 2) {
		mes "[Karam Pucci]";
		mes "No problem. I don't mind staying here for a little longer.";
		mes "In fact, my company would like that too.";
		close;
	}
	mes "[Karam Pucci]";
	mes "Then let's go!";
	close2;
	warp "alberta",172,131;
	end;
}

harboro1,321,237,5	script	Rubina Adler#rockn07	4_F_SITDOWN,{
	emotion ET_DELIGHT;
	mes "[Rubina Adler]";
	mes "Mm, mm! Agave juice is the best thing I've tasted in Rock Ridge.";
	next;
	mes "[Rubina Adler]";
	mes "I've heard it's a traditional drink of the Cacti. When I drink it, it feels as if it washes away all the dust clogging up my throat.";
	next;
	mes "[Rubina Adler]";
	mes "Err, wait. It's not real agave juice. It says agave-flavored juice.";
	next;
	emotion ET_SWEAT;
	mes "[Rubina Adler]";
	mes "Ack, does it even have agave in it?";
	close;
}

harboro1,75,211,1	script	Zebedee#rockwn13	4_KID01,5,5,{
	mes "[Zebedee]";
	mes "Welcome to Rock Ridge!";
	mes "I hope you'll find your opportunity in this land of dreams.";
	close;

OnTouch:
	specialeffect EF_SPHERE;
	emotion ET_BIGTHROB;
	npctalk "Welcome to Rock Ridge!", "", bc_self;
	end;
}

harboro1,75,219,3	script	Irene#rockwn14	4W_KID,5,5,{
	mes "[Irene]";
	mes "Welcome to Rock Ridge, adventurer!";
	mes "I hope you'll enjoy exploring this wonderful place.";
	close;

OnTouch:
	specialeffect EF_SPHERE;
	emotion ET_BIGTHROB;
	npctalk "Welcome, adventurer!", "", bc_self;
	end;
}


harboro1,79,224,5	script	Miles Wiesner#rockwn12	4_M_SITDOWN,{
	mes "[Miles Wiesner]";
	mes "I'm waiting for my sister. She's supposed to be on the next ship.";
	mes "I came here first and invited her over here.";
	next;
	mes "[Miles Wiesner]";
	mes "She was worried sick when I decided to leave for this continent a year ago.";
	mes "She'll be happy to see me doing well.";
	next;
	mes "[Miles Wiesner]";
	mes "The land of opportunity, that's Rock Ridge.";
	close;
}

harboro1,82,221,3	script	Cheerful Leaf#rockwn16	4_F_CACTUSCHILD2,{
	mes "[Cheerful Leaf]";
	mes "My gramps is the best Cactus I know!";
	mes "Sometimes he says things that I can't understand, but it's okay.";
	next;
	emotion ET_DELIGHT;
	mes "[Cheerful Leaf]";
	mes "I hope I can understand him better when I grow as tall as he.";
	mes "I want to grow up quickly, so I could ask him to tell me the things he told me again.";
	close;

OnTouch:
	emotion ET_SMILE;
	end;
}

harboro1,83,221,3	script	Mahua Kaya#rockwn15	4_M_CACTUSCHIEF,{
	mes "[Mahua Kaya]";
	mes "Some Cacti don't like the pioneers, but, Leaf, remember they're also children of Mother Nature.";
	next;
	mes "[Cheerful Leaf]";
	mes "Children? Are they as cute as Leaf?";
	next;
	mes "[Mahua Kaya]";
	mes "Of course. Everyone even this old man is a child in the eyes of Mother Nature.";
	next;
	emotion ET_SMILE;
	mes "[Cheerful Leaf]";
	mes "Hah hah hah! That doesn't make sense. You're tall and have a mustache. Babies don't have mustaches.";
	next;
	mes "[Mahua Kaya]";
	mes "I'm saying you should be nice to them like you are to your friends.";
	mes "Do you understand me, Leaf?";
	next;
	mes "[Cheerful Leaf]";
	mes "Yes. Leaf is a good Cactus and he loves his gramps.";
	close;
}

harboro1,86,218,3	script	Welch#rockwn01	4_M_ARCHER,5,5,{
	mes "[Welch]";
	mes "Have you just arrived? So have I, two days ago. The wind sounds different here. I love it!";
	next;
	mes "[Welch]";
	mes "All the buildings smell like fresh paint, and I hear the sound of hammering everywhere I go. This village is alive!";
	next;
	emotion ET_SMILE;
	mes "[Welch]";
	mes "Just standing here makes me so happy that I can't stop laughing. Hah hah hah!";
	close;

OnTouch:
	emotion ET_DELIGHT;
	end;
}

harboro1,88,217,3	script	Edith Richie#rockwn02	4_F_KID2,{
	emotion ET_PROFUSELY_SWEAT;
	mes "[Edith Richie]";
	mes "My dad works at the train station.";
	mes "It's east? mm, wait. West is the left hand side, and...";
	next;
	mes "[Edith Richie]";
	mes "Just look at your map and go straight up. You'll be at the train station.";
	mes "My father is so strong, he can carry many boxes at once!";
	close;
}

harboro1,86,210,4	script	Carmen O'Neil#rockwn06	8_F,{
	mes "[Carmen O'Neil]";
	mes "*Hiccups* I can drink beer all day long!";
	next;
	mes "[Leland Wenkins]";
	mes "Let's make money and - hee hee! - eat something delicious!";
	next;
	npctalk "Geez, they're drinking again.", "Mortimer#rockwn07", bc_self;
	mes "[Drunk Doram]";
	mes "I want more chicken, nya! And chicken is really easy on my stomach.";
	close;
}

harboro1,85,208,7	script	Leland Wenkins#rockwn03	4_M_TWTEAMAN,5,5,{
	mes "[Leland Wenkins]";
	mes "Cheers for our great village! Cheers!";
	next;
	mes "[Carmen O'Neil]";
	mes "For the pioneering spirit! Cheers!";
	next;
	unittalk getcharid(3), "" + strcharinfo(0) + " : They're drunk.", bc_self;
	mes "[Drunk Doram]";
	mes "*Hiccups* Cheers! Nya-nya!";
	close;

OnTouch_:
	if (.talk == 0) {
		.talk = 1;
		npctalk "For Rock Ridge!";
		sleep 3000;
		npctalk "Cheers!", "Carmen O'Neil#rockwn06";
		npctalk "Cheers, nya!", "Drunk Doram#rockwn11";
		sleep 9000;
		npctalk "Mwah hah hah! Beer is the best!";
		sleep 1000;
		npctalk "I especially like drinking it in the daytime!", "Carmen O'Neil#rockwn06";
		sleep 1000;
		npctalk "Chicken! *Hiccups* You got to eat chicken with it!", "Drunk Doram#rockwn11";
		sleep 9000;
		npctalk "Who are we?";
		sleep 1000;
		npctalk "We're the pioneers of Rock Ridge!", "Carmen O'Neil#rockwn06";
		sleep 1000;
		npctalk "We're brave! We're gallant!", "Drunk Doram#rockwn11";
		sleep 3000;
		npctalk "We're the pioneers of Rock Ridge!";
		npctalk "We're the pioneers of Rock Ridge!", "Carmen O'Neil#rockwn06";
		npctalk "Nya, nya, nya! Teehee, nya!", "Drunk Doram#rockwn11";
		sleep 9000;
		.talk = 0;
	}
	end;
}

harboro1,100,77,4	script	Maybell#rockn02	8_F,{
	mes "[Maybell]";
	mes "Rock Ridge is a seaside village. In the beginning?well, even now it's battling with the sea.";
	next;
	mes "[Maybell]";
	mes "Did you know there's one more level underneath this village? That was the original Rock Ridge, and it became uninhabitable because of seawater erosion and groundwater inundation.";
	next;
	mes "[Maybell]";
	mes "Mayor Costell's solution was to bury the first level and build a new village on top of it. And now what used to be the first floor is the basement. The second floor is actually the first.";
	next;
	mes "[Maybell]";
	mes "We still have to pump out water on a daily basis to prevent flooding, but that's just a minor setback?we took one step back to move two steps forward. Rock Ridge will continue to grow.";
	close;
}

harboro1,229,64,3	script	Rosemary Weber#rockn03	4_F_EINWOMAN,{
	mes "[Rosemary Weber]";
	mes "I'm tired of being surrounded by so much water! It's the reason we constantly have to repair the ground and buildings standing on it.";
	mes "Did you know we had to bury what used to be the ground level of the village? That was a difficult decision to make, and it still didn't solve all our problems.";
	next;
	mes "[Rosemary Weber]";
	mes "Most of the buildings were made of wood and prone to rotting. It took a lot of money and effort to fill them thoroughly, so our new ground level wouldn't sink in.";
	next;
	mes "[Rosemary Weber]";
	emotion 54, getnpcid(0,"Rosemary Weber#rockn03");
	mes "And the filling work still hasn't been finished. Sigh, I don't know if that was even a good decision anymore.";
	close;
}

harboro1,87,207,1	script	Drunk Doram#rockwn11	4_CAT_SAILOR5,{
	mes "[Leland Wenkins]";
	mes "We are the great pioneers of Rock Ridge! Hey, ho!";
	next;
	mes "[Carmen O'Neil]";
	mes "We dig mines, build houses! No seawater or sandstorms can stop us!";
	next;
	npctalk "He's so loud.", "Edith Richie#rockwn02", bc_self;
	mes "[Drunk Doram]";
	mes "Nya! Nya-nya! Nya hah hah! Nya-nya!";
	close;
}


harboro1,80,204,7	script	Elsie#rockwn05	4W_KID,5,5,{
	mes "[Elsie]";
	mes "Whoa, so pretty!";
	next;
	emotion ET_QUESTION;
	mes "[Elsie]";
	mes "It's five million Zeny. How much money is that?";
	next;
	mes "[Mortimer]";
	mes "Ah, that price is for adventurers only.";
	mes "Pretty little ladies like you can have it at two hundred Zeny.";
	next;
	mes "[" + strcharinfo(0) + "]";
	mes "I'm pretty and little, too.";
	next;
	emotion ET_SWEAT;
	mes "[Mortimer]";
	mes "...You're either delusional";
	mes "or shameless.";
	next;
	emotion ET_FRET, playerattached();
	mes "[" + strcharinfo(0) + "]";
	mes "You're shameless!";
	close;

OnTouch:
	emotion ET_SURPRISE;
	end;
}

harboro1,81,205,1	script	Mortimer#rockwn07	4_M_ROGUE,5,5,{
	mes "[Mortimer]";
	mes "Souvenirs! I've got souvenirs!";
	mes "Get souvenirs for your family, friends, teachers, and significant other!";
	next;
	mes "[Mortimer]";
	mes "Ah, adventurer. Would you like to buy some souvenirs?";
	next;
	npctalk "They're so cheap, you're getting them almost for free. I'm actually losing money doing this!", "", bc_self;
	mes "[Mortimer]";
	mes "I'll give you a special discount. This feather accessory here is just two million Zeny. This handkerchief here is - oh, wow! - just five million!";
	next;
	emotion ET_HUK, playerattached();
	mes "[" + strcharinfo(0) + "]";
	mes "How exorbitant!";
	close;

OnTouch:
	npctalk "Souvenirs! I've got souvenirs!", "", bc_self;
	end;
}

harboro1,73,206,5	script	Walter Greenwald#rockwn	4_M_BARD,{
	mes "[Walter Greenwald]";
	mes "I assume you came all the way here from the mainland for a reason.";
	mes "When you're done with it and not sure what else to do, well...";
	next;
	mes "[Walter Greenwald]";
	mes "I recommend you follow the central road to the eastern gate of the village and move a little bit farther south.";
	mes "It's in the 3 o'clock direction when you open the map.";
	next;
	mes "[Walter Greenwald]";
	mes "There, you can meet people who offer jobs and meals.";
	mes "And, of course, they're surrounded by others who want the jobs and meals.";
	close;
}

harboro1,84,200,5	script	Delbert Lake#rockwn04	4_M_EINMINER,{
	mes "[Delbert Lake]";
	mes "I'm not going back home until I become a millionaire!";
	mes "I was so excited to come here that I got aboard the ship in full mining gear!";
	next;
	mes "[Delbert Lake]";
	mes "There's a nice-looking rock! Alley-oop!";
	mes "Come out, gold, silver, diamonds! You can't hide from Delbert!";
	next;
	emotion ET_FRET, getnpcid(0, "Constance#rockwn18");
	mes "[Constance]";
	mes "Hey, are you crazy?!";
	mes "That's not a mineral vein, it's a decorative rock! Get that pickax away from it, now!";
	close;
}

harboro1,85,195,1	script	Constance#rockwn18	4_F_EINWOMAN,5,5,{
	mes "[Constance]";
	mes "Ah, are you an adventurer? Please, help me stop that madman!";
	next;
	mes "[Constance]";
	mes "He got off a ship from the mainland in that heavy mining gear, and then one look at that rock, he turned into a pickax-swinging maniac.";
	next;
	emotion ET_ANGER;
	mes "[Constance]";
	mes "It's not a mineral vein but a decorative rock that we villagers moved together. I told him that, but he doesn't care!";
	mes "He's in full mining gear, but he can't tell a normal rock from a mineral vein. How stupid is that?";
	close;

OnTouch:
	npctalk "Mwa hah hah, I'm going to mine everything!", "Delbert Lake#rockwn04", bc_self;
	npctalk "Hey, stop swinging that pickax!", "", bc_self;

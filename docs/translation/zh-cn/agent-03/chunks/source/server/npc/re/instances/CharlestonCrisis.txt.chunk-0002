	sleep 3000;
	mapannounce 'map_name$, "Charleston 1: It seems you've taken care of most of the Locksteps.", bc_map, 0xffff00;
	sleep 3000;
	mapannounce 'map_name$, "Charleston 1: Please come back to the lab.", bc_map, 0xffff00;
	stopnpctimer;
	end;
}


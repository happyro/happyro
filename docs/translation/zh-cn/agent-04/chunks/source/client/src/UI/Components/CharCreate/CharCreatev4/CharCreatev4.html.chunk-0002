		</div>
		<div class="hair_color_title"></div>
		<div class="hair_colors">
			<div class="haircolor_row">
				<div class="colorCol cstyle00">
					<input type="radio" name="hcolor" id="0_color" checked class="hcolor" />
					<label for="0_color" class="hcolor_button"> </label>
				</div>
				<div class="colorCol cstyle01">
					<input type="radio" name="hcolor" id="1_color" class="hcolor" />
					<label for="1_color" class="hcolor_button"> </label>
				</div>
				<div class="colorCol cstyle02">
					<input type="radio" name="hcolor" id="2_color" class="hcolor" />
					<label for="2_color" class="hcolor_button"> </label>
				</div>
				<div class="colorCol cstyle03">
					<input type="radio" name="hcolor" id="3_color" class="hcolor" />
					<label for="3_color" class="hcolor_button"> </label>
				</div>
				<div class="colorCol cstyle04">
					<input type="radio" name="hcolor" id="4_color" class="hcolor" />
					<label for="4_color" class="hcolor_button"> </label>
				</div>
			</div>
			<div class="haircolor_row">
				<div class="colorCol cstyle05">
					<input type="radio" name="hcolor" id="5_color" class="hcolor" />
					<label for="5_color" class="hcolor_button"> </label>
				</div>
				<div class="colorCol cstyle06">
					<input type="radio" name="hcolor" id="6_color" class="hcolor" />
					<label for="6_color" class="hcolor_button"> </label>
				</div>
				<div class="colorCol cstyle07">
					<input type="radio" name="hcolor" id="7_color" class="hcolor" />
					<label for="7_color" class="hcolor_button"> </label>
				</div>
				<div class="colorCol cstyle08">
					<input type="radio" name="hcolor" id="8_color" class="hcolor" />
					<label for="8_color" class="hcolor_button"> </label>
				</div>
			</div>
		</div>
	</div>

	<div class="btns">
		<ui-button
			class="btn cancel"
			bg="make_character_ver2/bt_close_normal.bmp"
			hover="make_character_ver2/bt_close_over.bmp"
			down="make_character_ver2/bt_close_press.bmp"
		></ui-button>
		<ui-button
			class="btn make"
			bg="make_character_ver2/bt_make_normal.bmp"
			hover="make_character_ver2/bt_make_over.bmp"
			down="make_character_ver2/bt_make_press.bmp"
		></ui-button>
		<ui-button
			class="btn return"
			bg="make_character_ver2/bt_make_normal.bmp"
			hover="make_character_ver2/bt_make_over.bmp"
			down="make_character_ver2/bt_make_press.bmp"
		></ui-button>
	</div>
</div>

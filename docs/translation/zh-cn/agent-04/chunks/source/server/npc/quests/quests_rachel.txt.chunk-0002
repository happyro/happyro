		mes "So the kid's missing,";
		mes "huh? Good luck finding";
		mes "him. Oh, and be careful";
		mes "in that ice cave. That place";
		mes "can be plenty dangerous.";
		set lost_boy,6;
		changequest 8092,8093;
		close;
	}
	else if (lost_boy == 6) {

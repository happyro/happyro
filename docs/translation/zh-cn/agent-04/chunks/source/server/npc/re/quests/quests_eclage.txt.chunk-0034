							mes "Where should the "+ .@books$[.@i] +" book be placed?";
							next;
							.@select_book = select("First:Second:Third:Fourth:Fifth") -1;
							mes "Book 1 was placed at the "+ .@books$[.@select_book] +" spot.";
							if (.@select_book == .@select_place[.@i])
								.@book += 10;

			mes "The contents could not be read.";
			mes "Let's ask Hisie.";
			cutin "avn_desk03",4;
			next;
			mes "[Hisie]";
			mes "What did you find?";
			mes "Hmm?? This is a portrait of my mother.";
			mes "Why does that man have this?";
			cutin "hisie01",0;
			next;
			switch( select("She's beautiful.:Look at these documents!") ) {
				mes "[Hisie]";
			case 1:

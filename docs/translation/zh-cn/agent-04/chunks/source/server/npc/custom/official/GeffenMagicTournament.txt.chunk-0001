	end;
OnTouch_:
	if ('GMT == 1) {
		'GMT = 2;
		showscript strcharinfo(0)+" : Guess this is where I register for the tournament...";
		end;
	}
	
	end;
OnInit:
	hideonnpc strnpcinfo(0);
	end;
OnInstanceInit:
	hideonnpc instance_npcname(strnpcinfo(0));
	end;
}


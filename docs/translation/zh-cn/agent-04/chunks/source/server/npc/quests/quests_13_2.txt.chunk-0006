			}
			close;
		}
		else {
			// custom translation
			if (strnpcinfo(1) == "Arc") {
				mes "[Arc]";
				mes "The back of the right ... ";
				mes "......";
			}
			else {
				mes "[Terra]";
				mes "I'm sorry... I'm so sleepy...";
				mes "...I want to sleep...";
			}
			close;
		}
	}
	else {
		if (strnpcinfo(1) == "Arc") {
			mes "[Arc]";
			mes "HirWosWeh. Yee DiebVilFar U manTalVil.";
			mes "LarsNeiser...??";
			mes "VeldTiTal Ko SharDurYur Di ?";
		}
		else {
			mes "[Terra]";
			mes "ModBurDana...? Mu AnduWehFus Yee OsaLoLars...";
			mes "eoFusser....";
			mes "maurNohser Ur...... ThorNuffLars So ";
		}
		close;
	}
}

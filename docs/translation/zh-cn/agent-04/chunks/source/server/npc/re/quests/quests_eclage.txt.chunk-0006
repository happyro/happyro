		close2;
	}
	cutin "",255;
	end;
}

ecl_in01,44,53,4	script	Delivery Man#ep14_2	4_M_DOGTRAVELER,{
	mes "[Delivery Man]";
	if (ep14_2_oliver == 25) {
		mes "Is this that item?";
		mes "I'll mail it safely, so you won't have to worry about it.";
		next;
		mes "[Delivery Man]";
		mes "The road from Splendide to Eclage used to be dangerous, but nowadays, it's actually better to come all the way to Eclage.";
		next;
		mes "[Delivery Man]";
		mes "I don't know why people can't just make small amounts of pickled Poring for themselves instead of mailing them...";
		emotion ET_CRY;
		ep14_2_oliver = 26;
		changequest 11333,11334;
	}
	else {
		mes "Sigh...";
		mes "I need to get going in order to make it on time.";
		next;
		mes "[Delivery Man]";
		mes "Wait a minute...";
		mes "Is it actually better to deliver it later...";
		mes "I remember seeing so many boxes of pickled Poring in the storage waiting to be delivered...";
		emotion ET_CRY;
	}
	close;
}

ecl_in04,226,231,4	script	Du Lian#ep14_2in2	4_M_REDMAN,{
	if (checkweight(1201,1) == 0 || (MaxWeight - Weight) < 1000) {
		mes "- Stop here !! -";
		mes "- The weight is just too much that -";
		mes "- you cannot receive the item. -";
		mes "- Please lighten your load -";
		mes "- and try again. -";
		close;
	}
	if (ep14_2_oliver == 29) {
		mes "[Du Lian]";
		mes "Hmm... Where did he go...?";
		mes "Could he be... a ghost?!";
		emotion ET_HUK, getnpcid(0, "Du Lian#ep14_2in2");
		cutin "bu_du5",2;
		next;
		mes "[Maggi Steen]";
		mes "I didn't sense any use of magic or other things of the sort...";
		cutin "bu_maggi3",2;
		next;
		mes "[Maggi Steen]";
		mes "Wait! Here's the hood that Oliver was wearing...";
		emotion ET_HUK, getnpcid(0, "Maggi Steen#ep14_2in2");
		cutin "bu_maggi4",2;
		next;
		mes "[Maggi Steen]";
		mes "And... doesn't it feel like this room is different from before?";
		emotion ET_PROFUSELY_SWEAT, getnpcid(0, "Mark Esha#ep14_2in2");
		cutin "bu_mark4",0;
		next;
		mes "[Du Lian]";
		mes "Hey stop that!!";
		mes "It's scaring me!!!";
		emotion ET_HUK, getnpcid(0, "Du Lian#ep14_2in2");
		cutin "bu_du5",2;
		next;
		mes "[Maggi Steen]";
		mes "Arrrrr~~";
		emotion ET_CRY, getnpcid(0, "Maggi Steen#ep14_2in2");
		cutin "bu_maggi4",2;
		next;
		mes "[Alp Ocart]";
		mes "Oh!!! I just remembered...";
		mes "Oliver...";
		emotion ET_SPARK, getnpcid(0, "Alp Ocart#ep14_2in2");
		cutin "bu_alp2",2;
		next;
		mes "[Alp Ocart]";
		mes "...";
		mes "Oliver Hilpert...";
		mes ".........is also known as the dreaming novelist...";
		emotion ET_THINK, getnpcid(0, "Alp Ocart#ep14_2in2");
		cutin "bu_alp3",2;
		next;
		mes "[Alp Ocart]";
		mes "And this book...";
		mes "Why didn't I remember this book when Oliver was around?";
		cutin "bu_alp5",2;
		next;
		mes "[Du Lian]";
		mes "Hey...";
		mes "Did you just take that book out from your bag?";
		emotion ET_THINK, getnpcid(0, "Du Lian#ep14_2in2");
		cutin "bu_du5",2;
		next;
		mes "[Alp Ocart]";
		mes "Yeah, that's because I'm a fan...";
		emotion ET_SHY, getnpcid(0, "Alp Ocart#ep14_2in2");
		cutin "bu_alp4",2;
		next;
		mes "[Du Lian]";
		mes "Why didn't you remember the book when you are such a fan..?";
		mes "Not only that, do people usually carry books with them when they're fans?? Especially hardcover books?";
		emotion ET_HUK, getnpcid(0, "Du Lian#ep14_2in2");
		cutin "bu_du5",2;
		next;
		mes "[Alp Ocart]";
		mes "......";
		emotion ET_SHY, getnpcid(0, "Alp Ocart#ep14_2in2");
		cutin "bu_alp4",2;
		next;
		mes "[Du Lian]";
		mes "You are a little bit weir...";
		cutin "bu_du1",2;
		next;
		mes "[Mark Esha]";
		mes "More importantly... The title of this book...";
		mes "is [The City of Fairies]?";
		emotion ET_HUK, getnpcid(0, "Mark Esha#ep14_2in2");
		cutin "bu_mark4",0;
		next;
		mes "[Mark Esha]";
		mes "And...";
		mes "It's been many years since this book was published...";
		emotion ET_HUK, getnpcid(0, "Mark Esha#ep14_2in2");
		next;
		mes "[Du Lian]";
		mes "...This is getting kind of scary...?";
		emotion ET_HUK, getnpcid(0, "Du Lian#ep14_2in2");
		cutin "bu_du1",2;
		next;
		mes "[Mark Esha]";
		mes "......";
		emotion ET_THINK, getnpcid(0, "Mark Esha#ep14_2in2");
		cutin "bu_mark4",0;
		next;
		mes "[Maggi Steen]";
		mes "......";
		emotion ET_THINK, getnpcid(0, "Maggi Steen#ep14_2in2");
		cutin "bu_maggi4",2;
		next;
		mes "[Alp Ocart]";
		mes "......";
		emotion ET_THINK, getnpcid(0, "Alp Ocart#ep14_2in2");
		cutin "bu_alp2",2;
		ep14_2_oliver = 30;
		getitem 19543,1;//Oliver_Wolf_Hood
		completequest 11337;
	}
	else {
		.@npc_name$ = strnpcinfo(1);
		setarray .@npc$[0],"Du Lian","Mark Esha","Maggi Steen","Alp Ocart";
		for ( .@i = 0; .@i < 4; .@i++ )
			if (.@npc_name$ == .@npc$[.@i]) break;
		switch(.@i) {
		case 0:
			mes "[Du Lian]";
			mes "But this is Volume 1. Does that mean there's more?";
			emotion ET_THINK;
			cutin "bu_du1",2;
			next;
			mes "[Alp Ocart]";
			mes "It has a total of 3 volumes.";
			emotion ET_BEST, getnpcid(0, "Alp Ocart#ep14_2in2");
			cutin "bu_alp1",2;
			next;
			mes "[Du Lian]";
			mes "Wow, how many are you carrying with you...";
			mes "Why are you bringing all of them around...";
			emotion ET_HUK;
			cutin "bu_du5",2;
			break;
		case 1:
			mes "[Mark Esha]";
			mes "Everybody calm down!!!";
			mes "This has to be some kind of a dream!";
			emotion ET_HUK;
			emotion ET_HUK, getnpcid(0, "Du Lian#ep14_2in2");
			cutin "bu_mark2",0;
			next;
			mes "[Du Lian]";
			mes "Why are you hitting me, calling it a dream and all!";
			mes "It hurts!";
			emotion ET_PROFUSELY_SWEAT, getnpcid(0, "Du Lian#ep14_2in2");
			cutin "bu_du4",2;
			next;
			mes "[Mark Esha]";
			mes "Ahhhh maybe it really isn't a dream after all!!!";
			emotion ET_HUK;
			emotion ET_FRET, getnpcid(0, "Du Lian#ep14_2in2");
			cutin "bu_mark3",0;
			break;
		case 2:
			mes "[Maggi Steen]";
			mes "...A...A...Aaaaahhhhhhhhh!!!!!";
			emotion ET_CRY;
			cutin "bu_maggi4",2;
			next;
			mes "[Du Lian]";
			mes "Don't cry, Maggi~";
			emotion ET_PROFUSELY_SWEAT, getnpcid(0, "Du Lian#ep14_2in2");
			cutin "bu_du4",2;
			break;
		case 3:
			mes "[Alp Ocart]";
			mes "I wonder...";
			mes "Why didn't I remember this...?";
			emotion ET_HUK;
			cutin "bu_alp5",2;
			next;
			mes "[Alp Ocart]";
			mes "I... I should have.. I should have gotten his autograph!!!";
			emotion ET_HUK;
		}
	}
	close2;
	cutin "",255;
	end;
}
ecl_in04,224,234,4	duplicate(Du Lian#ep14_2in2)	Mark Esha#ep14_2in2	4_M_BLUEMAN
ecl_in04,223,234,4	duplicate(Du Lian#ep14_2in2)	Maggi Steen#ep14_2in2	4_F_PINKWOMAN

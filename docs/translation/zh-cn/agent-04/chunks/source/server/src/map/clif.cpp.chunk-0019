/// Notice of divorce.
/// 0205 <partner name>.24B (ZC_DIVORCE)
void clif_divorced( const map_session_data& sd, const char* name ){
	PACKET_ZC_DIVORCE p{};

	p.packetType = HEADER_ZC_DIVORCE;
	safestrncpy( p.name, name, NAME_LENGTH );

	clif_send( &p, sizeof( p ), &sd, SELF );
}


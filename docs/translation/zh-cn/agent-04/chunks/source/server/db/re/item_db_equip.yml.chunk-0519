               bonus2 bSkillAtk,"MT_MIGHTY_SMASH",10;
               if (.@g>=ENCHANTGRADE_A) {
                  bonus bPAtk,4*(.@r/2);
                  bonus bAtkRate,4*(.@r/2);
               }
            }
         }
      }

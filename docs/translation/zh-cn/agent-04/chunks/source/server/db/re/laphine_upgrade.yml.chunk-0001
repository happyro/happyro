      - Item: Ein_1HBOOK
      - Item: Ein_1HDAGGER
      - Item: Ein_1HMAGGER
      - Item: Ein_1HSPEAR
      - Item: Ein_1HLUTE
      - Item: Ein_1HSWORD
      - Item: Ein_1HGUN
      - Item: Ein_1H_Foxtail
  - Item: Metal_Rifine_Ticket
    ResultRefine: 7
    CardsAllowed: true
    TargetItems:
      - Item: Metal_Katar
      - Item: Metal_Two_Handed_Axe
      - Item: Metal_Lance
      - Item: Metal_Book
      - Item: Metal_Staff
      - Item: Metal_Dagger

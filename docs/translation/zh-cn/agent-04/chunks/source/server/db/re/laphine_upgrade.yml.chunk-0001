      - Item: Ein_1H_Foxtail
  - Item: Gemstone_Of_Time
    RandomOptionGroup: GEMSTONE_OF_TIME
    TargetItems:
      - Item: Overwhelm_Str_Armor
      - Item: Overwhelm_Int_Armor
      - Item: Overwhelm_Vit_Armor
      - Item: Overwhelm_Dex_Armor
      - Item: Overwhelm_Agi_Armor
      - Item: Overwhelm_Luk_Armor
  - Item: Time_Unseal_Key
    RandomOptionGroup: TIME_UNSEAL_KEY
    TargetItems:
      - Item: Temporal_M_Str
      - Item: Temporal_M_Agi
      - Item: Temporal_M_Vit
      - Item: Temporal_M_Int
      - Item: Temporal_M_Dex
      - Item: Temporal_M_Luk
  - Item: Frozen_Box_IL
    ResultRefineMinimum: 7
    ResultRefineMaximum: 10
    MinimumRefine: 4
    MaximumRefine: 9
    CardsAllowed: true
    TargetItems:
      - Item: Huuma_Flutter_Snow_IL
      - Item: Combo_Battle_Glove_IL
      - Item: Cap_IL
      - Item: Clack_Of_Servival_IL
      - Item: Herald_Of_GOD_IL
  - Item: True_Hunting_9Refine
    ResultRefine: 9
    MaximumRefine: 8
    CardsAllowed: true
    TargetItems:
      - Item: True_Hunting_Mail
      - Item: True_Hunting_Manteau
      - Item: True_Hunting_Boots

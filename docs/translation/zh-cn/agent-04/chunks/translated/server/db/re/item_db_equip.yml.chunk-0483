    Name: 次元天帝太阳之书
    Type: Weapon
    SubType: Book
    Weight: 2200
    Attack: 230
    Range: 1
    Slots: 2
    Jobs:
      StarGladiator: true
    Classes:
      Fourth: true
    Locations:
      Right_Hand: true
    WeaponLevel: 5
    EquipLevelMin: 250
    Refineable: true
    Gradable: true
    Flags:
      DropEffect: CLIENT
    Script: |
      .@g = getenchantgrade();
      .@r = getrefine();
      bonus bCritical,5;
      bonus2 bSkillAtk,"SKE_SUNSET_BLAST",15+5*(.@r/3);
      bonus bAtkRate,(.@r/2);
      bonus bBaseAtk,25*(.@r/2);
      if (.@r>=7) {
         bonus bCritAtkRate,20;
         if (.@r>=9) {
            bonus bCRate,5;
            bonus bCritical,15;
            if (.@r>=11) {
               bonus2 bSkillAtk,"SKE_SUNSET_BLAST",15;
            }
         }
      }
      if (.@g>=ENCHANTGRADE_D) {
         bonus bPAtk,5;
         if (.@g>=ENCHANTGRADE_C) {
            bonus2 bSkillAtk,"SKE_SUNSET_BLAST",15;
            if (.@g>=ENCHANTGRADE_B) {
               bonus bShortAtkRate,10;
               if (.@g>=ENCHANTGRADE_A) {
                  bonus bPAtk,3*(.@r/2);
               }
            }
         }
      }

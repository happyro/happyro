  - Id: 15125
    AegisName: FemaleDiver_Clothe
    Name: 女性潜水服
    Type: Armor
    Buy: 20
    Weight: 300
    Defense: 20
    Slots: 1
    Locations:
      Armor: true
    ArmorLevel: 1
    EquipLevelMin: 80
    Refineable: true
    Script: |
      .@r = getrefine();
      if (.@r<5)
         .@r2 = 0;
      else if (.@r<6)
         .@r2 = 100;
      else if (.@r<7)
         .@r2 = 400;
      else if (.@r<8)
         .@r2 = 700;
      else if (.@r<9)
         .@r2 = 1400;
      else if (.@r<10)
         .@r2 = 2100;
      else {
         .@r = 10;
         .@r2 = 3600;
      }
      bonus2 bAddMonsterDropItem,579,(((.@r+6)*100)+.@r2);
      if (.@r>=7) {
         bonus bHPrecovRate,-100;
         bonus bHPGainValue,100;
      }

    Gradable: true
    Script: |
      .@g = getenchantgrade();
      .@r = getrefine();
      bonus bMaxHP,1500;
      bonus bMaxSP,150;
      if (.@r>=7) {
         bonus bMatkRate,3;
         if (.@r>=9) {
            bonus bSMatk,5;
            bonus bMatkRate,5;
            if (.@r>=11) {
               bonus bFixedCast,-800;
               bonus bVariableCastrate,-10;
            }
         }
      }
      if (.@g>=ENCHANTGRADE_D) {
         bonus bMRes,30;
         bonus bRes,30;
         if (.@g>=ENCHANTGRADE_C) {
            bonus2 bMagicAddSize,Size_All,15;
            if (.@g>=ENCHANTGRADE_B) {
               bonus bSpl,3;
               if (.@g>=ENCHANTGRADE_A) {
                  bonus bSMatk,7;
               }

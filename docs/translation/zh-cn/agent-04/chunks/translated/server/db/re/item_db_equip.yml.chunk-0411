  - Id: 470122
    AegisName: Beast_Leather_Shoes
    Name: 野兽皮鞋
    Type: Armor
    Weight: 600
    Defense: 15
    Slots: 1
    Locations:
      Shoes: true
    ArmorLevel: 2
    EquipLevelMin: 200

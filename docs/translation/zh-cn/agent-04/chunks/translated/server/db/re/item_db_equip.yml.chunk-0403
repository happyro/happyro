      bonus bDelayrate,-3;
      bonus bAspdRate,3;
      bonus bBaseAtk,10*(.@r/2);
      bonus bMatk,10*(.@r/2);
      if (.@r>=7) {
         bonus bDelayrate,-3;
         bonus bAspdRate,3;
      }
      if (.@r>=9) {
         bonus bAtkRate,10;
         bonus bMatkRate,10;
      }

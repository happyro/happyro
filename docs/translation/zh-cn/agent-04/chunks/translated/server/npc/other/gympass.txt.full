//===== rAthena Script ======================================= 
//= Gym Pass Cash Item NPC
//===== By: ================================================== 
//= Kisuka
//===== Current Version: ===================================== 
//= 1.3
//===== Compatible With: ===================================== 
//= rAthena Project
//===== Description: ========================================= 
//= [Official Conversion]
//= Exchange Gym Passes to learn "Enlarge Weight Limit"
//= iRO NPC situated in Payon beside Kafra Shop.
//===== Additional Comments: ================================= 
//= 1.0 First version [L0ne_W0lf]
//= 1.1 Fixed the NPC saying you "00" [L0ne_W0lf]
//= 1.2 Replaced effect numerics with constants. [Samuray22]
//= 1.3 Updated script, and fixed potential errors. [L0ne_W0lf]
//============================================================ 

payon,173,141,4	script	Ripped Cabus#GymPass	899,{
	mes "[Ripped]";
	mes "嘿，朋友。人们如今不像过去那样";
	mes "积极锻炼身体。即使您靠战斗为生，";
	mes "身体某些部位也可能";
	mes "虚弱松弛。";
	mes "您明白我的意思吗？";
	mes "";
	next;
	mes "[Ripped]";
	mes "跟我训练吧，我保证您能";
	mes "举起并携带更多物品。";
	mes "每次只要给我";
	mes "^FF0000健身通行证^000000，";
	mes "我们就可以开始了。";
	mes "";
	next;
	mes "[Ripped]";
	mes "但别太兴奋：";
	mes "无论训练多少，";
	mes "都可能过度锻炼。听说过";
	mes "有人练得太壮吗？";
	mes "因为他们都死了。明白？";
	mes "";
	next;
	mes "[Ripped]";
	mes "我认为和我认真训练";
	mes "是安全的，可以将您的";
	mes "物品携带能力提高 ^FF000010 次^000000。";
	mes "那么……准备好流汗了吗？";
	next;
	switch(select("是:否:我的训练效果消失了。")) {
	case 1:
	if (gympassmemory < 10) {
		set .@add_carry,gympassmemory + 1;
			set .@remain_carry,10 - .@add_carry;
			if (countitem(7776) > 0) {
			mes "[Ripped]";
				mes "哦，太好了，我看到您";
				mes "带来了健身通行证。";
				mes "好，照我做，";
				mes "感受肌肉的燃烧吧。";
				mes "准备好了吗？开始吧。";
				next;
				specialeffect2 EF_EARTHSPIKE;
				next;
				specialeffect2 EF_DEVIL;
				next;
				specialeffect2 EF_COIN;
				next;
				specialeffect2 EF_SIGHTRASHER;
				next;
				mes "[Ripped]";
				mes "好了，现在您应该能";
				mes "携带更多东西了。";
				mes "让我看看，我们还能将";
				mes "您的物品携带能力";
				mes "^FF00000" + .@remain_carry + "^000000 次";
				mes "继续这样训练。";
				delitem 7776,1; //Max_Weight_Up_Scroll
				set gympassmemory,.@add_carry;
				skill "ALL_INCCARRY",.@add_carry,SKILL_PERM_GRANT;
				close;
				}
			else {
			mes "[Ripped]";
				mes "朋友，我怎么说的？";
				mes "想训练并增强";
				mes "物品携带肌肉，就必须带来";
				mes "您的 ^FF0000健身通行证^000000。";
				mes "";
				close;
				}
			}
		else {
		mes "[Ripped]";
			mes "朋友，我觉得您的物品携带";
			mes "肌肉不能再增强了。";
			mes "继续尝试对身体太危险！";
			mes "好了，";
			mes "我已经告诉过您极限。";
			mes "";
			close;
			}
		case 2:
	mes "[Ripped]";
		mes "啊，真遗憾。";
		mes "改变主意后再回来吧。";
		mes "也可以告诉您的朋友：";
		mes "如果他们身材松弛，我会";
		mes "帮他们恢复体型。";
		mes "";
		close;
		case 3:
	if (gympassmemory > 0) {
		mes "[Ripped]";
			mes "发生了什么？";
			mes "您让物品携带肌肉";
			mes "萎缩了吗？幸运的是，";
			mes "肌肉有记忆，";
			mes "重新练回来不会花太久……";
			mes "";
			next;
			specialeffect2 EF_EARTHSPIKE;
			next;
			specialeffect2 EF_DEVIL;
			next;
			specialeffect2 EF_COIN;
			next;
			specialeffect2 EF_SIGHTRASHER;
			next;
			mes "[Ripped]";
			mes "怎么样？";
			mes "您的物品携带肌肉";
			mes "就这样恢复了！";
			mes "下次别再偷懒了，好吗？";
			mes "";
			skill "ALL_INCCARRY",gympassmemory,SKILL_PERM_GRANT;
			close;
			}
		else {
		mes "[Ripped]";
			mes "呃……";
			mes "我们以前没有";
			mes "一起训练过。";
			mes "我很确定。";
			close;
			}
		}
	}
//

					mes "[Mayssel]";
					mes "但盗贼的主要武器是匕首。";
					mes "最终，在评估自己和敌人后，只需弥补弱点。";
					next;
					mes "[Mayssel]";
					mes "如果攻击打不中敌人，就要考虑命中率。";
					mes "希望你找到适合战斗风格的属性。";
					close2;
					cutin "", 255;
					end;
				case 3:
					mes "[Mayssel]";
					mes "你对哪个技能好奇？";
					cutin "gc_mayssel01.bmp", 1;
					next;
					while(1) {
						switch(select("闪避提升", "二刀连击", "隐匿与偷窃", "施毒与解毒", "没兴趣。")) {
						case 1:
							mes "[Mayssel]";
							mes "顾名思义，^4d4dff该技能会提高一定的闪避率^000000。";
							mes "你想避免受到敌人攻击伤害，对吧？";
							next;
							break;
						case 2:
							mes "[Mayssel]";
							mes "^4d4dff该技能让你一次攻击造成两次伤害。^000000";
							mes "虽然这把匕首看起来很普通，但快速的两次攻击能给敌人造成严重伤害。";
							next;
							break;
						case 3:
							mes "[Mayssel]";
							mes "^4d4dff隐匿就是字面意思……隐藏。^000000";
							next;
							mes "[Mayssel]";
							mes "^4d4dff偷窃是窃取敌人物品的技能^000000。";
							mes "你可以从一个敌人身上偷一件物品。";
							next;
							break;
						case 4:
							mes "[Mayssel]";
							mes "^4d4dff施毒用于毒害敌人。^000000";
							mes "中毒后，毒素会让敌人的身体逐渐受到物理伤害。";
							next;
							mes "[Mayssel]";
							mes "相反，顾名思义，解毒会移除中毒状态。";
							next;
							break;
						case 5:
							mes "[Mayssel]";
							mes "你掌握了足够知识，很好。";
							mes "再辅以实战经验，你就会更加完美。";
							close2;
							cutin "", 255;
							end;
						}
					}
				case 4:
					mes "[Mayssel]";
					mes "是这样吗？";
					mes "和其他职业公会一样，理论学习也有局限。";
					mes "我建议你亲身体验战斗。";
					cutin "gc_mayssel01.bmp", 1;
					close2;
					cutin "", 255;
					end;
				}
			}
		}
	} else {
		if (!isbegin_quest(4269)) {
			mes "[Mayssel]";
			mes "你是陌生人。";
			mes "抱歉，我是受邀来为学生讲解职业的，";
			mes "没什么可对你说的。";
			cutin "gc_mayssel01.bmp", 1;
			next;
			mes "[Mayssel]";
			mes "生活在远离地表光明的地方，我们还能相遇几乎是奇迹。";
			mes "我们应该遵守规定。";
			next;
			mes "[Mayssel]";
			mes "参加课程前，你必须先成为克里图拉学院学生。";
			next;
			mes "[Mayssel]";
		mes "不过，如果你想了解盗贼职业本身的信息，我可以告诉你。";
			next;
			switch(select("关于盗贼有用属性", "关于盗贼主要技能", "没兴趣。")) {
			case 1:
				mes "[Mayssel]";
				mes "你想了解更多属性吗？";
				mes "正如 Vicente 已经告诉你的，属性没有固定答案。";
				next;
				mes "[Mayssel]";
				mes "如果要从中选择一项，";
				mes "^4d4dffAGI 与闪避能力有关^000000。";
				mes "^4d4dffDex 与命中率有关，";
				mes "STR 提高物理攻击力^000000。";
				next;
				mes "[Mayssel]";
				mes "Vit、Luk、Int 的价值取决于你选择的目标。";
				mes "作为参考，Verkhasel 的 Luk 很高。";
				mes "名为拳刃的武器适合暴击。";
				next;
				mes "[Mayssel]";
				mes "但盗贼的主要武器是匕首。";
				mes "最终，在评估自己和敌人后，只需弥补弱点。";
				next;
				mes "[Mayssel]";
				mes "如果攻击打不中敌人，就要考虑命中率。";
				mes "希望你找到适合战斗风格的属性。";
				close2;
				cutin "", 255;
				end;
			case 2:
				mes "[Mayssel]";
				mes "你对哪个技能好奇？";
				next;
				while(1) {
					switch(select("闪避提升", "二刀连击", "隐匿与偷窃", "施毒与解毒", "没兴趣。")) {
					case 1:
						mes "[Mayssel]";
						mes "顾名思义，^4d4dff该技能会提高一定的闪避率^000000。";
						mes "你想避免受到敌人攻击伤害，对吧？";
						next;
						break;
					case 2:
						mes "[Mayssel]";
						mes "^4d4dff该技能让你一次攻击造成两次伤害。^000000";
						mes "虽然这把匕首看起来很普通，但快速的两次攻击能给敌人造成严重伤害。";
						next;
						break;
					case 3:
						mes "[Mayssel]";
						mes "^4d4dff隐匿就是字面意思……隐藏。^000000";
						next;
						mes "[Mayssel]";
						mes "^4d4dff偷窃是窃取敌人物品的技能^000000。";
						mes "你可以从一个敌人身上偷一件物品。";
						next;
						break;
					case 4:
						mes "[Mayssel]";
						mes "^4d4dff施毒用于毒害敌人。^000000";
						mes "中毒后，毒素会让敌人的身体逐渐受到物理伤害。";
						next;
						mes "[Mayssel]";
						mes "相反，顾名思义，解毒会移除中毒状态。";
						next;
						break;
					case 5:
						mes "[Mayssel]";
						mes "你掌握了足够知识，很好。";
						mes "再辅以实战经验，你就会更加完美。";
						cutin "gc_mayssel05.bmp", 1;
						close2;
						cutin "", 255;
						end;
					}
				}
			case 3:
				mes "[Mayssel]";
				mes "登记为学生后，你可以上课并获得更多经验。";
				cutin "gc_mayssel01.bmp", 1;
				close2;
				cutin "", 255;
				end;
			}
		} else {
			if (Class == Job_Thief) {
				mes "[Mayssel]";
				mes "你正在走盗贼之路。";
				mes "盗贼是一转职业。";
				cutin "gc_mayssel01.bmp", 1;
				next;
				mes "[Mayssel]";
				mes "有一天你会转职为二转。";
				mes "现在最好考虑一下是成为流氓还是刺客。";
				cutin "gc_mayssel02.bmp", 1;
				close2;
				cutin "", 255;
				end;
			} else {
				mes "[Mayssel]";
				mes "我不认识你。";
				mes "要参加这门课，你必须先成为克里图拉学院的学生。";
				cutin "gc_mayssel01.bmp", 1;
				next;
				mes "[Mayssel]";
				mes "你想了解盗贼职业的什么信息？";
				next;
				switch(select("关于盗贼有用属性", "关于盗贼主要技能", "没兴趣。")) {
				case 1:
					mes "[Mayssel]";
					mes "你想了解更多属性吗？";
				mes "有用属性没有完美答案。";
					next;
					mes "[Mayssel]";
					mes "如果要从中选择一项，";
					mes "^4d4dffAGI 与闪避能力有关^000000。";
					mes "^4d4dffDex 与命中率有关，";
					mes "STR 提高物理攻击力^000000。";
					next;
					mes "[Mayssel]";
				mes "Vit、Luk、Int 的价值取决于你选择的目标。";
				mes "作为参考，Verkhasel 的 Luk 很高。";
					mes "名为拳刃的武器适合暴击。";
					next;
					mes "[Mayssel]";
					mes "但盗贼的主要武器是匕首。";
					mes "最终，在评估自己和敌人后，只需弥补弱点。";
					next;
					mes "[Mayssel]";
					mes "如果攻击打不中敌人，就要考虑命中率。";
					mes "希望你找到适合战斗风格的属性。";
					close2;
					cutin "", 255;
					end;
				case 2:
					mes "[Mayssel]";
					mes "你对哪个技能好奇？";
					next;
					while(1) {
						switch(select("闪避提升", "二刀连击", "隐匿与偷窃", "施毒与解毒", "没兴趣。")) {
						case 1:
							mes "[Mayssel]";
						mes "顾名思义，^4d4dff该技能会提高一定的闪避率^000000。";
							mes "你想避免受到敌人攻击伤害，对吧？";
							next;
							break;
						case 2:
							mes "[Mayssel]";
							mes "^4d4dff该技能让你一次攻击造成两次伤害。^000000";
						mes "虽然这把匕首看起来很普通，但快速的两次攻击能给敌人造成严重伤害。";
							next;
							break;
						case 3:
							mes "[Mayssel]";
							mes "^4d4dff隐匿就是字面意思……隐藏。^000000";
							next;
							mes "[Mayssel]";
							mes "^4d4dff偷窃是窃取敌人物品的技能^000000。";
							mes "你可以从一个敌人身上偷一件物品。";
							next;
							break;
						case 4:
							mes "[Mayssel]";
							mes "^4d4dff施毒用于毒害敌人。^000000";
						mes "中毒后，毒素会让敌人的身体逐渐受到物理伤害。";
							next;
							mes "[Mayssel]";
						mes "相反，顾名思义，解毒会移除中毒状态。";
							next;
							break;
						case 5:
							mes "[Mayssel]";
						mes "你掌握了足够的知识，很好。";
						mes "再辅以实战经验，你就会更加完美。";
							close2;
							cutin "", 255;
							end;
						}
					}
					break;
				case 3:
					mes "[Mayssel]";
					mes "登记为学生后，你可以上课并获得更多经验。";
					cutin "gc_mayssel01.bmp", 1;
					close2;
					cutin "", 255;
					end;
				}
			}
		}
	}

OnInit:
	questinfo( QTYPE_QUEST, QMARK_NONE, "Class == Job_Novice && !isbegin_quest(7480) && isbegin_quest(4269) == 2" );
	questinfo( QTYPE_QUEST, QMARK_NONE, "!isbegin_quest(7483) && isbegin_quest(7481) == 1 && isbegin_quest(7482) == 1" );
	// questinfo( QTYPE_QUEST, QMARK_NONE, "!isbegin_quest(7495)" );// officially disabled
	// setquestinfo_req 7495,7484,2,7485,3;
	end;
}

iz_ac02_a,52,136,3	duplicate(Guest Lecturer Mayssel#0)	Guest Lecturer Mayssel#a	4_F_MAYSEL
iz_ac02_b,52,136,3	duplicate(Guest Lecturer Mayssel#0)	Guest Lecturer Mayssel#b	4_F_MAYSEL
iz_ac02_c,52,136,3	duplicate(Guest Lecturer Mayssel#0)	Guest Lecturer Mayssel#c	4_F_MAYSEL
iz_ac02_d,52,136,3	duplicate(Guest Lecturer Mayssel#0)	Guest Lecturer Mayssel#d	4_F_MAYSEL

// - Vicente
// - Teaches the player about the Thief class.
// -----------------------------------------------------------------------------
iz_ac02,49,134,5	script	Vicente#ac	4_M_HUMAN_02,{
	if (isbegin_quest(4269) > 0 && Class == Job_Novice) {
		if (!isbegin_quest(7480)) {
			mes "[Vicente]";
			mes "你对盗贼职业感兴趣吗？";
			mes "Mayssel 会详细介绍。";
			mes "不过，你必须是克里图拉学院的学生。";
			cutin "sc_vicente01.bmp", 2;
			close2;
			cutin "", 255;
			end;
		} else if (isbegin_quest(7480) == 1) {
			if (!isbegin_quest(7481)) {
				mes "[Vicente]";
				mes "嗯……盗贼……那么我也需要向你解释属性。";
				cutin "sc_vicente01.bmp", 2;
				next;
				mes "[Vicente]";
				mes "首先，^4d4dffStr 代表力量、Agi 代表敏捷、Dex 代表命中^000000，这三项都适合盗贼。";
				mes "辅助属性是 Int 智力、Vit 体力和 Luk 幸运。";
				next;
				mes "[Vicente]";
				mes "由于^4d4dffStr 会提高物理攻击力^000000，它能增强你使用匕首的盗贼和流氓的攻击力。";
				mes "它还会提高携带物品的上限，也就是能携带更多物品。";
				next;
				mes "[Vicente]";
				mes "^4d4dffAgi 会提高闪避率和 Aspd 攻击速度。^000000简单说，就是让你更加灵活。";
				next;
				mes "[Vicente]";
				mes "Agi 非常重要，因为穿轻甲的盗贼必须闪避敌人攻击，而不是正面硬接。";
				next;
				mes "[Vicente]";
				mes "此外，^4d4dffDex 能提高攻击命中率^000000，这一点不可忽视。";
				mes "只要攻击命中，你就能做到任何事。";
				next;
				mes "[Vicente]";
				mes "此外，有些人在参加城战时会^4d4dff提高 VIT 能量等级来增加 HP 体力^000000。";
				next;
				mes "[Vicente]";
				mes "流氓技能中有一种名为“霸王魂”的技能，可以学习并使用他人的技能，";
				mes "有些人会^4d4dff投资智力，以使用通过该技能学到的魔法^000000。";
				next;
				mes "[Vicente]";
				mes "我无法告诉你哪个选择才是正确的。";
				mes "你必须根据个人喜好和目的分配能力。";
				mes "但是……";
				next;
				mes "[Vicente]";
				mes "流氓可以^4d4dff解除敌人的护甲^000000，或^4d4dff比盗贼更擅长偷窃^000000。";
				mes "也可以在突然遭到攻击后^4d4dff撤退^000000。";
				next;
				mes "[Vicente]";
				mes "嗯嗯。看起来可能有些胆小，但这是盗贼的进阶职业。";
				mes "它拥有更好的观察力，也能施展技巧。";
				cutin "sc_vicente03.bmp", 2;
				next;
				select("哈啊啊……", "是这样吗？");
				mes "[Vicente]";
				mes "……你真无聊。";
				mes "盗贼技能中有一项叫“闪避提升”。";
				mes "与闪避率相关的属性是……";
				cutin "sc_vicente02.bmp", 2;
				next;
				if (select("Dex！！", "Agi！！") == 1) {
					mes "[Lumin]";
					mes "别再戏弄我了。";
					mes "是 Agi。";
					cutin "nov_lumin02.bmp", 0;
					next;
					select("啊，是的……");
					mes "[Lumin]";
					mes "补偿呢？";
					cutin "nov_lumin01.bmp", 0;
					next;
					cutin "sc_vicente01.bmp", 2;
					mes "[Vicente]";
					mes "啊，是的……";
					mes "我会送 Lumin 一份礼物。";
					next;
					cutin "sc_vicente03.bmp", 2;
					mes "[Vicente]";
					mes "现在我要结束课程了。";
					mes "重要的不是我们谈论的理论。";
					mes "实战！！实战才是关键！！";
					setquest 7481;
					close2;
					cutin "", 255;
					end;
				} else {
					mes "[Vicente]";
					mes "哦，幸好你来上课了。";
					mes "看你的表情很无聊，我反而不太自在。";
					mes "现在还要继续吗？";
					cutin "sc_vicente03.bmp", 2;
					next;
					mes "[Lumin]";
					mes "……补偿呢？";
					cutin "nov_lumin02.bmp", 0;
					next;
					cutin "sc_vicente01.bmp", 2;
					mes "[Vicente]";
					mes "啊……谢谢你的提醒。";
					mes "祝你成功！";
					next;
					cutin "sc_vicente03.bmp", 2;
					mes "[Vicente]";
					mes "重要的不是理论，而是实战。";
					mes "你同意吗？";
					setquest 7481;
					getitem 569,30;// Novice_Potion
					close2;
					cutin "", 255;
					end;
				}
			} else {
				if (!isbegin_quest(7486)) {
					cutin "sc_vicente01.bmp", 2;
					mes "[Vicente]";
					mes "说到流氓，";
					mes "它并不像其他人抱怨的那样胆小。";
					next;
					mes "[Lumin]";
					mes "……你没有奇怪的爱好吗？";
					mes "比如脱掉别人的衣服。";
					cutin "nov_lumin01.bmp", 2;
					next;
					cutin "sc_vicente02.bmp", 2;
					mes "[Vicente]";
					mes "什么……你怎么能这么说！";
					mes "Lumin，你不该说这种话！";
					mes "流氓是盗贼的进阶职业。";
					next;
					cutin "nov_lumin01.bmp", 2;
					mes "[Lumin]";
					mes "嗯……我才不要成为流氓。";
					mes "你呢？";
					next;
					if (select("咦？我？我不想成为流氓。", "我……我喜欢……流氓……") == 1) {
						mes "[Lumin]";
						mes "好。那就和我一起走上血腥之路吧。";
						mes "成为黑暗中的影子……";
						cutin "nov_lumin03.bmp", 2;
						next;
						select("我不想成为盗贼。", "……我害怕！");
						mes "[Lumin]";
						mes "……头疼。";
						cutin "nov_lumin02.bmp", 2;
						next;
						cutin "sc_vicente04.bmp", 2;
						mes "[Vicente]";
						mes "哈哈哈哈。别再讲恐怖故事了。";
						next;
						cutin "nov_lumin01.bmp", 2;
						mes "[Lumin]";
						mes ".. Hng..";
						setquest 7486;
						completequest 7486;
						close2;
						cutin "", 255;
						end;
					} else {
						mes "[Lumin]";
						mes "是这样吗？";
						mes "让敌人解除武装并失去行动能力，这真是惊人的战斗技巧。";
						mes "我为这项技能点赞。";
						cutin "nov_lumin01.bmp", 2;
						next;
						cutin "sc_vicente02.bmp", 2;
						mes "[Vicente]";
						mes "你要讲点和之前不同的故事吗？";
						mes "哈哈……对我来说，师父对我做同样的事就够了。";
						setquest 7486;
						completequest 7486;
						close2;
						cutin "", 255;
						end;
					}
				} else {
					mes "[Vicente]";
					mes "咳咳……";
					mes "我越来越提不起劲了。";
					cutin "sc_vicente04.bmp", 2;
					close2;
					cutin "", 255;
					end;
				}
			}
		} else {
			if (!isbegin_quest(7483)) {
				mes "[Vicente]";
				mes "如果你想继续走盗贼之路，就去和 Mayssel 谈谈。";
				mes "她的信息应该会有帮助。";
				cutin "sc_vicente01.bmp", 2;
				close2;
				cutin "", 255;
				end;
			} else if (isbegin_quest(7483) == 1) {
				if (BaseLevel > 12) {
					if (!isbegin_quest(7484)) {
						cutin "sc_vicente01.bmp", 2;
						mes "[Vicente]";
						mes "嗯……这是关于盗贼技能的手册。";
						mes "顺便说一下，这本手册只适用于 12 级以内的经验。";
						next;
						mes "[Vicente]";
						mes "原本计划进行^4d4dff从怪物身上偷取物品^000000技能的实际练习，";
						mes "但你只需了解它是什么……不必真的练习。";
						next;
						mes "[Vicente]";

airport,143,43,5	script	Airport Staff#airport1a::airport1	90,{
	mes "[Airport Staff]";
	mes "欢迎来到";
	mes "艾因布罗克机场，";
	mes "这里提供直达";
	mes "朱诺、莱茵哈特和胡格尔的航班。";
	next;
	if (select("登上飞艇:取消") == 1) {
	mes "[Airport Staff]";
		mes "飞艇登乘费为";
		mes "1,200 Zeny，但如果您有";
		mes "免费飞艇票，";
		mes "即可免除费用。要登上飞艇吗？";
		next;
		if (select("是:否") == 1) {
		if (countitem(7311) > 0) {
		delitem 7311,1; //Free_Flying_Ship_Ticket
			warp "airport",148,51;
				end;
				}
				if (Zeny >= 1200) {
			set Zeny, Zeny - 1200;
			warp "airport",148,51;
				end;
				}
				mes "[Airport Staff]";
			mes "抱歉，您没有";
			mes "免费飞艇票，且没有足够的 Zeny";
			mes "支付飞艇登乘费。请记住，";
			mes "登乘费为 1,200 Zeny。";
			close;
			}
			}
			mes "[Airport Staff]";
			mes "谢谢，祝您";
		mes "今天愉快。";
	close;
	}
	
	airport,158,43,5	duplicate(airport1)	Airport Staff#airport1b	90
	airport,126,43,5	duplicate(airport1)	Airport Staff#airport1c	90

airport,143,49,3	script	Arrival Staff#airport2a::airport2	90,{
mes "[Arrival Staff]";
mes "欢迎来到艾因布罗克机场。";
mes "如果您刚从航班抵达，";
mes "我可以带您前往主航站楼。";
	mes "否则请登上飞艇，前往朱诺、莱茵哈特和胡格尔。";
	next;
	if (select("前往主航站楼:取消") == 1) {
	mes "[Arrival Staff]";
	mes "进入主航站楼后，登上飞艇需要再次付费。";
	mes "只有在艾因布罗克是您的目的地时，";
	mes "才应该离开这里。";
	mes "要前往主航站楼吗？";
		next;
		if (select("是:否") == 1) {
		warp "airport",142,40;
		end;
		}
		}
		mes "[Arrival Staff]";
		mes "好的，谢谢您的光临，";
			mes "祝您旅途愉快～";
			close;
		}
	
	airport,126,51,3	duplicate(airport2)	Arrival Staff#airport2b	90
	airport,158,50,3	duplicate(airport2)	Arrival Staff#airport2c	90
	
	einbroch,94,267,3	script	Airship Staff#ein01	91,{
	mes "[Airship Staff]";
	mes "欢迎来到";
mes "艾因布罗克机场。";
mes "请从这扇门登上飞艇，";
mes "飞艇将在施瓦尔茨瓦尔德共和国的";
mes "朱诺、莱茵哈特和胡格尔停靠。";
next;
mes "[Airship Staff]";
	mes "如果艾因布罗克是您的目的地，";
	mes "请走下楼梯，";
	mes "请抵达工作人员带您前往主航站楼。";
	mes "谢谢，祝您旅途愉快。";
	close;
	
	
	
	
	
	
	
	
	
	
	
}

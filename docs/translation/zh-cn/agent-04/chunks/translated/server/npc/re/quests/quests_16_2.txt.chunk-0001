//===== rAthena Script =======================================
//= Terra Gloria
//===== Description: =========================================
//= [Walkthrough Conversion]
//--- NPCs quests for Episode 16.2
//===== Changelog: ===========================================
//= 1.0 First version. [Capuche]
//= 1.1 Updated with some iRO NPC names. [Everade]
//============================================================

prt_cas_q,29,28,0	script	#ep162_evt_npc_con	HIDDEN_WARP_NPC,2,2,{
	end;
OnTouch:
	if (ep16_royal < 17)	// pre-req : access to room of consciousness (first time)
		end;
	if (terra_gloria_main == 0) {
		cloakoffnpcself( "Nihil M. Heine#ep162_01" );
		cloakoffnpcself( "Skia Nerius#ep162_02" );
	}
	else if (terra_gloria_main == 1 || terra_gloria_main == 2) {
		cloakoffnpcself( "Nihil M. Heine#ep162_01" );
		cloakoffnpcself( "Skia Nerius#ep162_02" );
		cloakoffnpcself( "Spica Nerius#ep162_01" );
	}
	else if (terra_gloria_main == 6) {	// first back from Lighthalzen
		cloakoffnpcself( "Nihil M. Heine#ep162_01" );
		cloakoffnpcself( "Spica Nerius#ep162_01" );
	}
	else if (terra_gloria_main == 23)
		cloakoffnpcself( "Skia Nerius#ep162_01" );
	end;
}

prt_cas_q,18,37,5	duplicate(dummy_cloaked_npc)	Skia Nerius#ep162_02	4_EP16_SPICA
prt_cas_q,23,33,2	duplicate(dummy_cloaked_npc)	Crux#ep162_03	4_EP16_CRUX
prt_cas_q,23,32,3	duplicate(dummy_cloaked_npc)	Kronecker G. Heine#ep162	4_EP16_GRANZ

prt_cas_q,21,39,3	script	Nihil M. Heine#ep162_01	4_EP16_NIHIL,{
	if (ep16_royal < 17)	// pre-req : access to room of consciousness (first time)
		end;
	if (terra_gloria_main == 0) {
		cutin "ep16_nihi_miseria_heine02.bmp",2;
		mes "[Nihil]";
		mes "现在我能看见你了。";
		mes "我等了很久。";
		next;
		mes "[Nihil]";
		mes "有重要的事。";
		mes "其实，尊贵的涅里乌斯家族女儿有很多话要说。";
		next;
		cutin "ep16_skia_shadow04.bmp",0;
		mes "[Skia]";
		mes "是的。Spica 正在调查几件事。";
		mes "所以我又变成这样。";
		unittalk getcharid(3), "" + strcharinfo(0) + " : Oh, you are not Spica ...", bc_self;
		npctalk "哈哈", "Skia Nerius#ep162_02", bc_self;
		next;
		mes "[Skia]";
		mes "其实，Spica 在宴会上还给 Crux 交代了另一项任务。";
		mes "Crux 似乎完成得很好。";
		unittalk getcharid(3), "" + strcharinfo(0) + " : Task?", bc_self;
		next;
		cutin "ep16_nihi_miseria_heine02.bmp",2;
		mes "[Nihil]";
		mes "我最近听说了。";
		mes "Spica 让 Crux 调查前几天宴会上给我下药的女仆。";
		next;
		cutin "ep16_skia_shadow01.bmp",0;
		mes "[Skia]";
		mes "Spica 在这些事上很敏锐。";
		mes "毕竟，她让我作为替身处于这个位置，正在完成她必须做的事。";
		next;
		mes "[Skia]";
		mes "她让我们等她。她说会带来好消息。";
		mes "因为到处都有眼睛，她让我去英雄之室。";
		next;
		cutin "ep16_nihi_miseria_heine01.bmp",2;
		mes "[Nihil]";
		mes "所以我们才不得不在没有提前告诉你的情况下来到这里。";
		mes "抱歉给你添麻烦。请稍等。";
		close2;
		setpcblock PCBLOCK_NPC, true;
		cutin "",255;
		unittalk getcharid(3), "" + strcharinfo(0) + " : .....", bc_self;
		sleep2 1500;
		npctalk "....", "Skia Nerius#ep162_02", bc_self;
		sleep2 1000;
		unittalk getcharid(3), "" + strcharinfo(0) + " : ... Until when?", bc_self;
		sleep2 2000;
		npctalk "她到了。", "Nihil M. Heine#ep162_01", bc_self;
		npctalk "谢谢你来。", "Spica Nerius#ep162_01", bc_self;
		cloakoffnpcself( "Spica Nerius#ep162_01" );
		terra_gloria_main = 1;
		sleep2 2000;
		setpcblock PCBLOCK_NPC, false;
		npctalk "请允许我直接进入正题。", "Spica Nerius#ep162_01", bc_self;
		end;
	}
	if (terra_gloria_main == 1) {
		cutin "ep16_nihi_miseria_heine01.bmp",2;
		mes "[Nihil]";
		mes "也许我们应该先听她说。";
		close3;
	}
	if (terra_gloria_main == 2) {
		mes "[Nihil]";
		mes "正如我之前说的，你是我们中最自由的人。";
		mes "所以我请求你。";
		cutin "ep16_nihi_miseria_heine01.bmp",2;
		next;
		mes "[Nihil]";
	mes "^4d4dffBruno^000000……他的目的地一定是^4d4dff莱茵哈特^000000。";
		mes "虽然只是我的猜测，但我相当确定。";
		next;
		mes "[Nihil]";
		mes "即使有飞艇，他也不去施瓦尔茨瓦尔特地区。";
		mes "……他知道自己可能被追踪。";
		cutin "ep16_nihi_miseria_heine04.bmp",2;
		next;
		mes "[Nihil]";
		mes "所以你必须在^4d4dff莱恩哈特机场^000000^4d4dff会见 Crux^000000。然后根据 Crux 已经调查的地点缩小范围。";
		cutin "ep16_nihi_miseria_heine01.bmp",2;
		next;
		mes "[Nihil]";
		mes "我们中没多少人能自由行动。所以我们才把任务交给你。";
		next;
		mes "[Nihil]";
		mes "Skia 会和你一起去。她会很有帮助。";
		mes "涅里乌斯家族非常擅长剑术。";
		cutin "ep16_nihi_miseria_heine01.bmp",2;
		next;
		mes "[Nihil]";
		mes "拜托你了。";
		mes "你单独前往，^4d4dff在莱恩哈特机场与 Crux 和 Skia 会合^000000。";
		setquest 7731;// Secret Action
		terra_gloria_main = 3;
		next;
	}
	if (terra_gloria_main == 3) {
		mes "[Nihil]";
		mes "我期待听到你的好消息。";
		cutin "ep16_nihi_miseria_heine02.bmp",2;
		next;
		cutin "ep16_skia_shadow04.bmp",0;
		mes "[Skia]";
		mes "英雄，^4d4dff莱恩哈特机场^000000见！";
		next;
		cutin "ep16_spica_nerius01.bmp",1;
		mes "[Spica]";
		mes "现在，请允许我告辞。";
		close2;
		cutin "",255;
		cloakonnpcself( "Nihil M. Heine#ep162_01" );
		cloakonnpcself( "Spica Nerius#ep162_01" );
		cloakonnpcself( "Skia Nerius#ep162_02" );
		end;
	}
	if (terra_gloria_main == 6) {
		mes "[Nihil]";
		mes "欢迎。我们已经在谈这件事了。";
		mes "很抱歉给你添麻烦。";
		cutin "ep16_nihi_miseria_heine01.bmp",2;
		next;
		select("我们之间不需要这么正式……");
		mes "[Nihil]";
		mes "我们可以自由交谈吗？";
		mes "谢谢。";
		mes "这是我的荣幸。";
		cutin "ep16_nihi_miseria_heine02.bmp",2;
		next;
		cutin "ep16_spica_nerius01.bmp",1;
		mes "[Spica]";
		mes "这就是我喜欢你的地方。";
		mes "不拘泥于形式、能够分享秘密很重要。";
		next;
		mes "[Spica]";
		mes "对了，我们谈谈 Bruno。我们还要秘密进行多久？";
		cutin "ep16_spica_nerius05.bmp",1;
		next;
		mes "[Nihil]";
		mes "我相信涅里乌斯家的女儿比我更了解这件事。";
		mes "我们必须制定明确计划解决局面。";
		cutin "ep16_nihi_miseria_heine01.bmp",2;
		next;
		mes "[Nihil]";
		mes "这里所有人都知道有企业在他背后。";
		mes "但他表面上很无辜。";
		next;
		mes "[Nihil]";
		mes "所以我们被他牵着走。";
	mes "我认为，我们最好制定计划追踪被盗的^4d4dffTerra Gloria^000000并将其夺回。";
		next;
		cutin "ep16_spica_nerius02.bmp",1;
		mes "[Spica]";
		mes "正因为如此，事情会很有趣。";
		mes "Bruno 这个人会给你全新的见解。";
		npctalk "嘿，管家，把 Crux 带来。", "Spica Nerius#ep162_01", bc_self;
		next;
		cutin "ep16_nihi_miseria_heine01.bmp",2;
		mes "[Nihil]";
		mes "你怎么这么确定？";
		next;
		cutin "ep16_spica_nerius06.bmp",1;
		mes "[Spica]";
		mes "因为我信任 Crux。";
		cloakoffnpcself( "Crux#ep162_03" );
		next;
		cutin "ep16_crux_findel01.bmp",0;
		mes "[Crux]";
		mes "抱歉我迟到了。";
	mes "我查到了很多关于 Bruno 的信息。";
		npctalk "这是报告。", "Crux#ep162_03", bc_self;
		next;
		mes "[Crux]";
		mes "在引渡过程中，我不得不获得施瓦茨瓦尔德政府的一点帮助。";
		next;
		mes "[Crux]";
	mes "这是因为我的身份，而且我不是自由冒险者……Skia 女士替我处理得很好……";
		next;
		mes "[Crux]";
		mes "还有意外收获。";
	mes "我设法取得了那个人的详细资料，并在不引起骚动的情况下让他招供。";
		next;
		mes "[Crux]";
	mes "我想这是因为我们说服双方相信我们会保障他们的安全。";
		next;
		mes "[Crux]";
	mes "我把那个人供词中不重要的部分交给了施瓦茨政府，也把 Bruno 交给了施瓦茨。";
		next;
		cutin "ep16_spica_nerius05.bmp",1;
		mes "[Spica]";
		mes "很好。";
		mes "毕竟，就算留着他，他也会成为我们的负担。";
	mes "那么，重要的信息是……";
		next;
		cutin "ep16_nihi_miseria_heine01.bmp",2;
		mes "[Nihil]";
	mes "……一定与某个设施有关。";
	mes "我是根据你报告中的细节判断的。";
		next;
		mes "[Nihil]";
	mes "……考虑到 Schwaltzvalt 的政治局势……";
		next;
		select( "总统？", "我们能避开 Enterprise 的注意吗？" );
		mes "[Nihil]";
	mes "作为王室事务的一部分，去另一个国家调查设施并不容易。";
	mes "我们还不能请求其他家族和领袖合作。";
		cutin "ep16_nihi_miseria_heine04.bmp",2;
		next;
		cutin "ep16_nihi_miseria_heine01.bmp",2;
		mes "[Nihil]";
		mes "Spica 女士。我相信你已经制定了策略。";
		mes "Skia 今天不在这里，可能就和你的计划有关……";
		next;
		cutin "ep16_spica_nerius06.bmp",1;
		mes "[Spica]";
	mes "我想我们不能指望公众认可。";
		mes "你说得对。我派 Skia 去执行另一项任务了。";
		next;
		cutin "ep16_spica_nerius07.bmp",1;
		mes "[Spica]";
		mes "Nihil 王子。正如你预测的，现在我们必须获得施瓦茨政府的帮助。";
		next;
		mes "[Spica]";
		mes "施瓦茨政府知道这是涅里乌斯王室私密但重要的事务。这是因为 Skia 把 Bruno 交给施瓦茨时编了一个好故事。";
		next;
		select("是什么？");
		mes "[Spica]";
		mes "" + strcharinfo(0) + ".";
		mes "既然你扮演着重要角色，也需要知道这件事。";
		mes "我们家族某件极其重要的东西被偷了。";
		cutin "ep16_spica_nerius01.bmp",1;
		next;
		mes "[Spica]";
		mes "据说那件重要物品目前位于可疑设施中。现在我们必须调查那里。";
		next;
		mes "[Spica]";
	mes "要调查设施，我们需要施瓦茨政府的许可。";
		mes "表面上，涅里乌斯家族是相关方。所以 Skia 现在在那里。";
		next;
		cutin "ep16_nihi_miseria_heine01.bmp",2;
		mes "[Nihil]";
	mes "我们需要更多帮助。";
		mes "Crux 必须尽快报告。他又会忙起来。";
		mes "......";
		next;
		cutin "ep16_spica_nerius01.bmp",1;
		mes "[Spica]";
	mes "我明白了。";
		mes "Crux 必须立即去找 Skia。";
		mes "而我必须去朱诺。";
		next;
		cutin "ep16_nihi_miseria_heine01.bmp",2;
		mes "[Nihil]";
		mes "那么你将借用涅里乌斯家族的名义。";
	mes "无论如何，我会尽力做好自己的工作。";
		mes "至于我们缺少的人手……";
		next;
		mes "[Nihil]";
		mes "" + strcharinfo(0) + ".";
	mes "有你和我们一起，我觉得非常幸运。";
		mes "请护送 Spica 小姐。";
		next;
		mes "[Nihil]";
		mes "护送并不难。";
		mes "你的工作是等 Spica 小姐完成任务，并安全带她回来。";
		next;
		cutin "ep16_crux_findel01.bmp",0;
		mes "[Crux]";
	mes "……Spica 小姐就拜托你了。";
		mes "那么我现在去朱诺。";
		npctalk "去吧。提前和 Skia 请求会面。", "Spica Nerius#ep162_01", bc_self;
		next;
		npctalk "是……我现在就去。", "Crux#ep162_03", bc_self;
		mes "[Nihil]";
		mes "现在我们了解全貌了。";
	mes "这取决于施瓦茨政府如何回应我们。";
		cutin "ep16_nihi_miseria_heine04.bmp",2;
		next;
		cloakonnpcself( "Crux#ep162_03" );
		cutin "ep16_spica_nerius07.bmp",1;
		mes "[Spica]";
		mes "关于那件事，请相信涅里乌斯家族下一任领袖。";
		mes "那么" + strcharinfo(0) + "，请来^4d4dff朱诺机场^000000。";
	mes "我们在那里继续谈。";
		erasequest 7734;// Arrest
		setquest 7735;// Secret Action 2
		terra_gloria_main = 7;
		close2;
		setpcblock PCBLOCK_NPC, true;
		npctalk "回头见。", "Spica Nerius#ep162_01", bc_self;
		sleep2 2000;
		npctalk "I am going too.", "", bc_self;
		sleep2 2000;
		setpcblock PCBLOCK_NPC, false;
		cloakonnpcself( "Nihil M. Heine#ep162_01" );
		cloakonnpcself( "Spica Nerius#ep162_01" );
		cutin "",255;
		end;
	}
}

prt_cas_q,23,36,3	script	Spica Nerius#ep162_01	4_EP16_SPICA,{
	if (ep16_royal < 17)
		end;
	if (terra_gloria_main == 1) {
		cutin "ep16_spica_nerius01.bmp",1;
		mes "[Spica]";
		mes "让我直说吧。";
		mes "事情比我们预想的更严重。";
		mes "Crux 做得很好，我以为我们快抓到他们了。";
		next;
		cutin "ep16_spica_nerius02.bmp",1;
		mes "[Spica]";
		mes "但他们没有那么愚蠢。";
		mes "Crux 很难找到你最初见到的可疑管家。";
		next;
		mes "[Spica]";
		mes "但递上玻璃杯的女仆很容易就找到了。";
		next;
		cutin "ep16_spica_nerius01.bmp",1;
		mes "[Spica]";
		mes "有人命令她向海涅家族的儿子推荐饮料。有人告诉她那是他最喜欢的饮料。";
		npctalk "……哈……", "Nihil M. Heine#ep162_01", bc_self;
		next;
		cutin "ep16_skia_shadow04.bmp",0;
		mes "[Skia]";
		mes "你没有找到任何特别线索吗？";
		mes "你没有其他要调查的了。为什么不带 Crux 一个人来？";
		next;
		cutin "ep16_spica_nerius06.bmp",1;
		mes "[Spica]";
		mes "嗯，也不算。";
	mes "我找到了给女仆饮料的管家线索。他的故乡是 Schwaltzvalt。";
		next;
		cutin "ep16_spica_nerius01.bmp",1;
		mes "[Spica]";
		mes "Crux 已经去找那个人了。";
	mes "他会告诉我当前位置。他现在已经经过朱诺。";
		npctalk "离这里很远。", "Nihil M. Heine#ep162_01", bc_self;
		next;
		mes "[Nihil]";
	mes "如果那个人来自 Schwaltzvalt，事情就不会简单。";
	mes "尤其是王室不能采取官方行动。";
	mes "我们也不能正式公布这件事。";
		cutin "ep16_nihi_miseria_heine01.bmp",2;
		next;
		cutin "ep16_spica_nerius01.bmp",1;
		mes "[Spica]";
		mes "其他家族的领袖已经知道管家的事。他们召开会议讨论如何处理。";
		next;
		cutin "ep16_spica_nerius06.bmp",1;
		mes "[Spica]";
	mes "我一直在参加会议。看来每个家族都有不同的想法。";
	mes "所以我决定按自己的意愿行动。";
		next;
		mes "[Nihil]";
		mes "问题在于那个管家要去哪里。不论最终目的地是什么，对 Crux 一个人来说都很困难。";
		mes "" + strcharinfo(0) + "，你能去支援吗？";
		cutin "ep16_nihi_miseria_heine01.bmp",2;
		next;
		cutin "ep16_skia_shadow04.bmp",0;
		mes "[Skia]";
		mes "那么也让我去吧。";
		next;
		cutin "ep16_spica_nerius07.bmp",1;
		mes "[Spica]";
		mes "如你所愿。";
		mes "这是 Crux 的报告。";
	mes "我不喜欢外出任务。所以我就待在房间里。哈哈哈……";
		next;
		mes "[Nihil]";
	mes "……你帮了我们很多。";
		mes "非常感谢。";
		mes "但你为什么这么积极地帮助我们？";
		cutin "ep16_nihi_miseria_heine02.bmp",2;
		next;
		cutin "ep16_spica_nerius01.bmp",1;
		mes "[Spica]";
		mes "嗯，我觉得这很有趣。";
		mes "而且我认为需要改变。";
		next;
		cutin "ep16_spica_nerius02.bmp",1;
		mes "[Spica]";
		mes "很快就会轮到我们。";
		mes "而我觉得很闷。";
		mes "海涅家族那异常的执念……";
		next;
		npctalk "......", "Nihil M. Heine#ep162_01", bc_self;
		cutin "ep16_spica_nerius06.bmp",1;
		mes "[Spica]";
		mes "好了，就说到这里。";
	mes "如果继续下去，就太失礼了。";
		next;
		cutin "ep16_nihi_miseria_heine02.bmp",2;
		mes "[Nihil]";
	mes "……但你看起来很开心。";
		mes "无论如何，之后再谈故事的更多细节。";
		terra_gloria_main = 2;
		close3;
	}
	if (terra_gloria_main == 2) {
		cutin "ep16_spica_nerius01.bmp",1;
		mes "[Spica]";
	mes "我把 Crux 报告的一部分交给了 Nihil 王子。";
		mes "接下来的安排，你必须和 Nihil 王子谈。";
		close3;
	}
	if (terra_gloria_main == 3) {
		mes "[Nihil]";
	mes "期待听到你的好消息。";
		cutin "ep16_nihi_miseria_heine02.bmp",2;
		next;
		cutin "ep16_skia_shadow04.bmp",0;
		mes "[Skia]";
		mes "英雄，^4d4dff莱恩哈特机场^000000见！";
		next;
		cutin "ep16_spica_nerius01.bmp",1;
		mes "[Spica]";
		mes "现在，请允许我告辞。";
		close2;
		cutin "",255;
		cloakonnpcself( "Nihil M. Heine#ep162_01" );
		cloakonnpcself( "Spica Nerius#ep162_01" );
		cloakonnpcself( "Skia Nerius#ep162_02" );
		end;
	}
}


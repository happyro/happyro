geffen,203,146,5	script	Citizen#lv4-1	97,{
	mes "[Citizen]";
	mes "艾尔帕兰曾有一位技艺高超的武器匠，";
	mes "他有四个儿子。四人都因铸造武器的技艺闻名全国。";
	next;
	mes "[Citizen]";
	mes "不幸的是，四个儿子在尝试制造强大武器时全部遇难，只有父亲在事故中幸存。";
	next;
	mes "[Citizen]";
	mes "因为那场事故，武器匠退休并隐居起来。没人见过他和儿子们正在开发的武器。";
	next;
	mes "[Citizen]";
	mes "我不认为他的儿子们在付出那么多、目标却未完成后，";
	mes "还能平静地进入来世……";
	close;
}

morocc,289,230,3	script	Citizen#lv4-2	92,{
	mes "[Citizen]";
	mes "与死者世界的人见面是不可能的。不过我听说，如果真能遇见死者，会发现他并不拥有全部记忆。";
	next;
	mes "[Citizen]";
	mes "但如果带给他能唤起生前记忆的东西，他就能暂时恢复记忆。当然，必须真的在冥界遇见某人才能确认。";
	next;
	mes "[Citizen]";
	mes "嗯……";
	mes "我说的可能有点阴森，但即使最琐碎的信息将来也可能派上用场，对吧？";
	close;
}

niflheim,240,193,3	script	Kayron#lv4	794,{
	if (checkweight(908,300) == 0) {
		mes "^3355FF等等！你现在携带的物品太多了。请先把一些东西存进卡普拉仓库后再回来。^000000";
		close;
	}
	if (BaseLevel < 80) {
		mes "[Kayron]";
		mes "嘿……";
		mes "像你这样的人";
		mes "怎么会来到这里？";
		next;
		mes "[Kayron]";
		mes "看你稚嫩的脸就知道有点弱。赶紧离开这里好好变强，别想着马上回来。";
		close;
	}
	if (lv4_weapon == 0) {
		mes "[Kayron]";
		mes "活着时，人们叫我凯隆。";
		mes "但现在我只是徘徊在亡者世界的幽灵。";
		mes "没有身体，我觉得";
		mes "自己毫无用处。";
		next;
		switch(select("表现出兴趣。:无视他。")) {
		case 1:
			mes "[Kayron]";
			mes "嗯……？";
			mes "我想说什么来着？我、我的记忆！我……好像想不起来……";
			set lv4_weapon,22;
			close;
		case 2:
			mes "[Kayron]";
			mes "没用……";
			mes "完全没用……";
			close;
		}
	}
	if ((lv4_weapon < 22) || (lv4_weapon > 30)) {
		mes "[Kayron]";
		mes "我从你身上感受到某种东西，";
		mes "就像你带着某个目标来到这里。";
		next;
		mes "[Kayron]";
		mes "我很惊讶……";
		mes "也有点羡慕。";
		mes "可以说，大多数来到尼夫海姆的人";
		mes "都没有什么目的。";
		close;
	}
	if ((lv4_weapon == 29) || (lv4_weapon == 30)) {
		mes "[Kayron]";
		mes "呵呵呵……";
		mes "你来得正是时候。";
		mes "现在该揭晓";
		mes "我的研究成果了……";
		next;
		if (rand(1,2) == 1) {
			mes "[Kayron]";
			mes "成功了！";
			mes "我完成了导致自己死亡的实验！";
			mes "真不敢相信！我创造了";
			if (lv4_weapon == 29) {
				mes "这个……巨斧！";
				getitem 1364,1; //Great_Axe
			}
			else {
				mes "这个……朗基努斯之枪！";
				getitem 1469,1; //Longinus's_Spear
			}
			set lv4_weapon,0;
			next;
			mes "[Kayron]";
			mes "我很高兴多年的研究没有白费。";
			mes "如果父亲能看到，一定会为我高兴。";
			next;
			mes "[Kayron]";
			mes "不好……";
			mes "^333333*叹气*^000000 我的记忆又开始消退了。如果再见到我，请让我";
			mes "重新记起过去。";
			mes "谢谢……";
			close;
		}
		else {
			mes "[Kayron]";
			mes "成功了！";
			mes "我完成了导致自己死亡的实验！";
			mes "真不敢相信！我创造了";
			if (lv4_weapon == 29) {
				mes "这个……断头台！";
				getitem 1369,1; //Guillotine
			}
			else {
				mes "这个……布里阿雷俄斯之枪！";
				getitem 1470,1; //Brionac
			}
			set lv4_weapon,0;
			next;
			mes "[Kayron]";
			mes "我很高兴多年的研究没有白费。";
			mes "如果父亲能看到，一定会为我高兴。";
			next;
			mes "[Kayron]";
			mes "Oh no...";
			mes "^333333*Sigh*^000000 I can feel my memories beginning to fade again. If you ever see me, please let me";
			mes "重新记起过去。";
			mes "谢谢……";
			close;
		}
	}
	if (((lv4_weapon == 27) && (countitem(7289) > 29) && (countitem(7294) > 29) && (countitem(7291) > 29)) || ((lv4_weapon == 28) && (countitem(7290) > 29) && (countitem(7296) > 29) && (countitem(7293) > 29))) {
		mes "[Kayron]";
		mes "这是什么？";
		mes "你带着的东西看起来";
		mes "非常眼熟。";
		mes "嗯，让我看看……";
		next;
		mes "[Kayron]";
	mes "";
	mes "";
	mes "";
	mes "";
	mes "";
	mes "";
	mes "";
	mes "";
		mes "我可以用这些锻造武器！你怎么知道这是我需要的材料？总之太好了！";
		next;
		mes "[Kayron]";
		mes "哦，不过首先要测试你的运气。无论我的技术多好，都得确认你今天运气不错，否则无法继续。";
		next;
		mes "[Kayron]";
		mes "我们来玩‘^660000石头、剪刀、布^000000’。三局两胜就可以继续制作。";
		next;
		mes "[Kayron]";
		mes "但如果三局输了两局，你的运气就不足以让我尝试锻造。我们必须丢弃你带来的一大批材料来驱散厄运。";
		next;
		mes "[Kayron]";
		mes "这是纸。";
		mes "你写‘石头’、‘布’或‘剪刀’，我也一样。然后比较结果看看会怎样。好了，第一局开始！";
		next;
		set .@npchand1,rand(1,3);
		set .@myhand1,select("剪刀:石头:布");
		if (((.@myhand1 == 1) && (.@npchand1 == 3)) || ((.@myhand1 == 2) && (.@npchand1 == 1)) || ((.@myhand1 == 3) && (.@npchand1 == 2))) {
			set .@shobu,.@shobu+1;
		}
		mes "[Kayron]";
		mes "现在……";
		mes "开始";
		mes "第二局~";
		next;
		set .@npchand2,rand(1,3);
		set .@myhand2,select("剪刀:石头:布");
		if (((.@myhand2 == 1) && (.@npchand2 == 3)) || ((.@myhand2 == 2) && (.@npchand2 == 1)) || ((.@myhand2 == 3) && (.@npchand2 == 2))) {
			set .@shobu,.@shobu+1;
		}
		mes "[Kayron]";
		mes "好……";
		mes "最后一局。";
		mes "写下‘石头’、";
		mes "‘布’或‘剪刀’。";
		next;
		set .@npchand3,rand(1,3);
		set .@myhand3,select("剪刀:石头:布");
		if (((.@myhand3 == 1) && (.@npchand3 == 3)) || ((.@myhand3 == 2) && (.@npchand3 == 1)) || ((.@myhand3 == 3) && (.@npchand3 == 2))) {
			set .@shobu,.@shobu+1;
		}
		set .@aekddam,rand(1,3);
		if (.@shobu > 1) {
			if (lv4_weapon == 27) {
				delitem 7289,30; //Olivine
				delitem 7294,30; //Turquoise
				delitem 7291,30; //Agate
			}
			else {
				delitem 7290,30; //Phlogopite
				delitem 7296,30; //Pyroxene
				delitem 7293,30; //Rose_Quartz
			}
			set lv4_weapon,lv4_weapon+2;
		}
		else if (.@shobu < 2) {
			if (.@aekddam == 1) {
				if (lv4_weapon == 27) {
					delitem 7289,30; //Olivine
				}
				else {
					delitem 7290,30; //Phlogopite
				}
			}
			else if (.@aekddam == 2) {
				if (lv4_weapon == 27) {
					delitem 7294,30; //Turquoise
				}
				else {
					delitem 7296,30; //Pyroxene
				}
			}
			else if (.@aekddam == 3) {
				if (lv4_weapon == 27) {
					delitem 7291,30; //Agate
				}
				else {
					delitem 7293,30; //Rose_Quartz
				}
			}
		}
		mes "[Kayron]";
		mes "结束了！";
		mes "我写的是……";
		if (.@npchand1 == 1) {
			mes "剪刀";
		}
		else if (.@npchand1 == 2) {
			mes "石头";
		}
		else if (.@npchand1 == 3) {
			mes "布";
		}
		if (.@npchand2 == 1) {
			mes "剪刀";
		}
		else if (.@npchand2 == 2) {
			mes "石头";
		}
		else if (.@npchand2 == 3) {
			mes "布";
		}
		if (.@npchand3 == 1) {
			mes "剪刀";
		}
		else if (.@npchand3 == 2) {
			mes "石头";
		}
		else if (.@npchand3 == 3) {
			mes "布";
		}
		next;
		mes "[Kayron]";
		mes "你写的是……";
		if (.@myhand1 == 1) {
			mes "剪刀";
		}
		else if (.@myhand1 == 2) {
			mes "石头";
		}
		else if (.@myhand1 == 3) {
			mes "布";
		}
		if (.@myhand2 == 1) {
			mes "剪刀";
		}
		else if (.@myhand2 == 2) {
			mes "石头";
		}
		else if (.@myhand2 == 3) {
			mes "布";
		}
		if (.@myhand3 == 1) {
			mes "剪刀";
		}
		else if (.@myhand3 == 2) {
			mes "石头";
		}
		else if (.@myhand3 == 3) {
			mes "布";
		}
		next;
		if (.@shobu > 1) {
			mes "[Kayron]";
			mes "让我看看……";
			mes "你赢了 " + .@shobu + " 局。";
			mes "你一定";
			mes "毫无疑问，你的运气";
			mes "相当不错~";
			next;
			mes "[Kayron]";
			mes "好，我会履行约定。把材料给我，";
			mes "再给我一点准备时间。之后再聊，好吗？";
			close;
		}
		else if (.@shobu < 2) {
			mes "[Kayron]";
			mes "很遗憾，你输了。我们只能用你带来的部分矿石";
			mes "驱散厄运！";
			next;
			mes "[Kayron]";
			mes "好，再试一次。去取得所需材料";
			mes "然后回来找我。";
			close;
		}
	}
	if ((lv4_weapon == 26) || (lv4_weapon == 27) || (lv4_weapon == 28)) {
		mes "[Kayron]";
		mes "我好像想不起剩下需要的材料了。";
		mes "这真的越来越令人沮丧。";
		next;
		mes "[Kayron]";
		mes "我和父亲以前对这些了如指掌。我到底怎么了……？";
		close;
	}
	if ((lv4_weapon == 25) && (countitem(1005) > 1) && (countitem(989) > 0) && (countitem(710) > 0) && (countitem(969) > 19)) {
		mes "[Kayron]";
		mes "哦……！";
		mes "没想到你这么可靠！这么快就带来了我要求的东西！";
		next;
		mes "[Kayron]";
		mes "但我还是想不起剩下需要的东西。真的很抱歉……";
		next;

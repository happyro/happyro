jupe_area1,25,238,0	script	#hole#1-2	844,{
	cutin "2",2;
	if ($@JupreArea1InUse == 1) {
		mes "^3355FF这似乎是";
		mes "某种装置，";
		mes "可以让你";
		mes "前往另一边。";
		mes "这里有一个插槽，";
		mes "可能需要插入";
		mes "某种物品……^000000";
		close2;
		cutin "2",255;
		end;
	}
	else if (countitem(7356) > 0 || countitem(7359) > 0 || countitem(7357) > 0 || countitem(7358) > 0) {
		mes "^3355FF这似乎是";
		mes "某种装置，";
		mes "可以让你";
		mes "前往另一边。";
		mes "这里有一个插槽，";
		mes "可能需要插入";
		mes "某种物品……^000000";
		next;
		switch(select("插入纹章碎片:取消。")) {
		case 1:
			if (countitem(7357) > 0) {
				mes "^3355FF你取出";
				mes "纹章碎片并将";
				mes "它放入插槽，";
				mes "正好完美契合。^000000";
				specialeffect EF_TOPRANK;
				cutin "2-1",2;
				next;
				if ($@JupreArea1InUse == 1) {
					mes "^3355FF什么也没发生。";
					mes "也许警报或其他";
					mes "安全措施被启动，";
					mes "阻止纹章碎片启动";
					mes "这个传送装置。";
					mes "";
					mes "你取回纹章碎片。^000000";
					close2;
					cutin "2-1",255;
					end;
				}
				else {
					mes "^3355FF插槽旋转，";
					mes "纹章碎片像钥匙一样转动。";
					mes "你感到微弱震动，";
					mes "另一侧的传送门";
					mes "被激活。然后你取回";
					mes "纹章碎片。";
					mes "^000000";
					initnpctimer;
					donpcevent "Warp#1-2::OnEnable";
					enablenpc "Red Alarm#1-2";
					disablenpc "#hole#1-2";
					close2;
					cutin "2-1",255;
					end;
				}
			}
			else {
				mes "^3355FF遗憾的是，你没有携带";
				mes "";
				mes "能放入插槽并启动";
				mes "这个机械装置的物品。";
				mes "";
				close2;
				cutin "2",255;
				end;
			}
			break;
		case 2:
			mes "[" + strcharinfo(0) + "]";
			mes "嗯……";
			mes "我有没有什么东西";
			mes "能让这台";
			mes "奇怪机器运转？";
			close2;
			cutin "2",255;
			end;
		}
		close;
	}
	else {
		mes "^3355FF这似乎是";
		mes "某种装置，";
		mes "可以让你";
		mes "前往另一边。";
		mes "这里有一个插槽，";
		mes "可能需要插入";
		mes "某种物品……^000000";
		close2;
		cutin "2",255;
		end;
	}
	end;

OnStop_Timer:
	stopnpctimer;
	end;

OnTimer22500:
	stopnpctimer;
	enablenpc "#hole#1-2";
	disablenpc "Red Alarm#1-2";
	end;
}


}

gon_dun01,134,183,0	script	#getitem1-4	111,2,1,{
	if (b_sword != 7) end;
	set b_sword,8;
	mes "你找到一块 ^FF0000刀刃碎片^000000。";
	mes "看来这是你一直寻找的剑的一部分。";
	close;

OnInit:
	disablenpc "#getitem1-4";
	end;

OnCommandOn:
	enablenpc "#getitem1-4";
	donpcevent "timer1-4::OnCommandOff";
	donpcevent "start01#gnbs::OnCommandOn";
	end;

OnCommandOff:
	disablenpc "#getitem1-4";
	end;
}


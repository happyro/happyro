S_Daily:
	mes "[Ian Atnad]";
	mes "挖掘项目？";
	mes "……你是指动力控制装置？";
	next;
	mes "[Ian Atnad]";
	switch( checkquest(7616,PLAYTIME) ) {// Core Collection - Down
	case -1:
		if (isbegin_quest(7615) == 0) {// Core Collection
			cutin "verus_ian01.bmp",2;
			mes "你是在说今天的工作吗？";
			mes "虽然显而易见，但就是寻找动力控制装置。";
			mes "...";
			mes "……如果不想做，也不必勉强。";
			next;
			if (select( "我会寻找动力控制装置。", "太难了。" ) == 1) {
				mes "[Ian Atnad]";
				mes "你？你确定要自己寻找吗？";
				mes "我没有理由拒绝这个提议。";
				mes "既然你说要自己做。";
				next;
				mes "[Ian Atnad]";
				mes "这次也收集 20 个动力控制装置。";
				mes "如果能解开动力控制装置的秘密……";
				mes "我们应该就能修好损坏的装置并自行使用，对吧？";
				mes "会很有趣。";
				next;
				mes "[Ian Atnad]";
				mes "……而且……我感觉自己见过它……感觉我会知道。";
				mes "好像会想起来。如果不断研究直到它刻在脑中，我相信一定会有结果。";
				setquest 7615;// Core Collection
				return;

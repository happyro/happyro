// Wave mode forest
1@def01,50,21,0	script	#wave_mode_forest_entrance	HIDDEN_WARP_NPC,1,1,{
	end;
OnTouch:
	disablenpc instance_npcname("#wave_mode_forest_entrance");
	initnpctimer;
	end;
OnTimer2000:
	mapannounce 'map_def01$, "感谢 Cool Event Corporation 的所有忠实客户。", bc_map;
	end;
OnTimer7000:
	mapannounce 'map_def01$, "<波浪模式-森林>阻止怪物到达桥的另一侧。", bc_map;
	end;
OnTimer12000:
	mapannounce 'map_def01$, "如果 20 只怪物到达另一侧，游戏结束。", bc_map;
	end;
OnTimer17000:
	mapannounce 'map_def01$, "好，它们来了。", bc_map;
	end;
OnTimer22000:
	stopnpctimer;
	donpcevent instance_npcname("#wave_mode_forest_system") + "::OnStart";
	end;
}

1@def01,1,1,0	script	#wave_mode_forest_system	-1,{
	end;
OnStart:
	initnpctimer;
	end;
OnTimer1000:
	mapannounce 'map_def01$, "3", bc_map;
	end;
OnTimer2000:
	mapannounce 'map_def01$, "2", bc_map;
	end;
OnTimer3000:
	mapannounce 'map_def01$, "1", bc_map;
	end;
OnTimer4000:
	'wave++;
	if ('wave % 5)
		mapannounce 'map_def01$, "-- Wave " + 'wave + " --", bc_map;
	else
		mapannounce 'map_def01$, "！！冠军怪物已召唤！！", bc_map;
	donpcevent 'npc_name$ + "::OnSpawn";
	end;
OnTimer24000:
	mapannounce 'map_def01$, "下一批怪物很快出现。做好准备。", bc_map;
	initnpctimer;
	end;
OnStop:
	stopnpctimer;
	end;
}


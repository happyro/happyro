//===== rAthena Script ======================================= 
//= Amatsu Guide
//===== By: ================================================== 
//= L0ne_W0lf
//===== Current Version: ===================================== 
//= 1.2
//===== Compatible With: ===================================== 
//= rAthena Project
//===== Description: ========================================= 
//= [Official Conversion]
//= Guide for the city of Amatsu.
//===== Additional Comments: ================================= 
//= 1.0 First version, Renewal guide.
//= 1.1 Optimized. [Euphy]
//= 1.2 Navigation system update. [Euphy]
//============================================================ 

amatsu,202,91,3	script	Amatsu Guide#amatsu	758,{
	mes "[Amachang]";
	mes "欢迎来到^8B4513天津^000000，";
	mes "这里居民和善，";
	mes "樱花也十分美丽。";
	next;
	mes "[Amachang]";
	mes "我是 Amachang，";
	mes "第 13 届天津小姐。";
	mes "我会以天津小姐的身份";
	mes "带您游览城镇。";
	mes "如果您想了解什么，";
	mes "请告诉我。";
	F_Navi("[Amachang]");
	while (1) {
		next;
		switch(select("[ 卡普拉职员 ]:[ 酒吧 ]:[ 武器商人 ]:[ 工具商人 ]:[ 天津宫殿 ]:[ 厨师助手 ]:[ 忍者公会建筑 ]:[ 船长 ]:移除小地图标记:取消")) {
		case 1:
			callsub L_Mark, "^0000FF卡普拉职员^000000";
			viewpoint 1,102,149,0,0x0A82FF;
			break;
		case 2:
			callsub L_Mark, F_Navi("酒吧","amatsu,215,116","^006400");
			viewpoint 1,215,116,1,0xAAFF00;
			break;
		case 3:
			callsub L_Mark, F_Navi("武器商人","amatsu,129,117","^008080");
			viewpoint 1,129,117,2,0x008080;
			break;
		case 4:
			callsub L_Mark, F_Navi("工具商人","amatsu,97,117","^FF1493");
			viewpoint 1,97,117,3,0xFF1493;
			break;
		case 5:
			callsub L_Mark, F_Navi("天津宫殿","amatsu,87,235","^8B4513");
			viewpoint 1,87,235,4,0x8B4513;
			break;
		case 6:
			callsub L_Mark, F_Navi("厨师助手","amatsu,206,150","^8A2BE2");
			viewpoint 1,206,150,5,0x8A2BE2;
			break;
		case 7:
			callsub L_Mark, F_Navi("忍者公会建筑","amatsu,148,137","^4B0082");
			viewpoint 1,148,137,6,0x4B0082;
			break;
		case 8:
			callsub L_Mark, F_Navi("船长","amatsu,195,79","^00BFFF");
			viewpoint 1,195,79,7,0x00BFFF;
			break;
		case 9:
			mes "[Amachang]";
			mes "我会移除您小地图上的所有标记。";
			mes "还有其他需要我帮忙的吗？";
			viewpoint 2,1,1,0,0xFFFFFF;
			viewpoint 2,1,1,1,0xFFFFFF;
			viewpoint 2,1,1,2,0xFFFFFF;
			viewpoint 2,1,1,3,0xFFFFFF;
			viewpoint 2,1,1,4,0xFFFFFF;
			viewpoint 2,1,1,5,0xFFFFFF;
			viewpoint 2,1,1,6,0xFFFFFF;
			viewpoint 2,1,1,7,0xFFFFFF;
			break;
		case 10:
			mes "[Amachang]";
			mes "祝您旅途愉快～！！";
			close;
		}
	}
	end;
L_Mark:
	mes "[Amachang]";
	mes getarg(0)+"已";
	mes "标记在您的小地图上。";
	mes "还有其他需要我帮忙的吗？";
	return;
}

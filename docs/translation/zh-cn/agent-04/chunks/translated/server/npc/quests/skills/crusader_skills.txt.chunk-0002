				mes "[斯洛蒂]";
				mes "这项技能叫做";
				mes "''^0000FF收缩^000000,'' 它会";
				mes "将敌人击退";
				mes "当你成功";
				mes "防御其攻击时。";
				next;
				mes "[斯洛蒂]";
				mes "现在仔细听……";
				mes "要施展它，你必须";
				mes "集中注意力";
				mes "并用正确的姿势和心态";
				mes "击退敌人……";
				next;
				mes "[斯洛蒂]";
				mes "太好了！你学会了";
				mes "技能！希望你用它";
				mes "对抗邪恶";
				mes "并保护弱者。啊，";
				mes "如果我学会新技能，一定马上教你。";
				set CRUS_SK,8;
				skill "CR_SHRINK",1,SKILL_PERM;
				close;
			}
			mes "^3355FF你小心地将";
			mes "哥布林解毒剂";
			mes "倒入斯洛蒂口中。";
			mes "他的喉咙艰难地";
			mes "吞咽解毒剂，但";
			mes "最终还是喝下了。^000000";
			next;
			mes "^3355FF不幸的是，什么也没";
			mes "发生。解毒剂可能";
			mes "在你从亚瑟神父前往斯洛蒂时";
			mes "失去了效果。";
			mes "从亚瑟神父到斯洛蒂的路上。";
			mes "你必须回到亚瑟神父那里";
			mes "再制作一份。^000000";
			set CRUS_SK,9;
			close;
		}
		else if (CRUS_SK == 8 || CRUS_SK == 10) {
			mes "[斯洛蒂]";
			mes "嘿，是你～";
			mes "最近过得怎么样？";
			mes "如果你有空，";
			mes "就过来找我，也许";
			mes "我们可以练习剑术。";
			close;
		}
		else if (CRUS_SK == 9) {
			mes "^3355FF你之前使用的解毒剂";
			mes "没有效果。你必须回到";
			mes "亚瑟神父那里，重新制作";
			mes "一份给斯洛蒂的解毒剂。^000000";
			mes "请尽快行动。";
			mes "不要再耽搁。";
			close;
		}
		else {
			mes "[斯洛蒂]";
			mes "在这附近请小心。哥布林会攻击";
			mes "他们遇到的任何人类。最近，";
			mes "它们变得更加暴力，";
			mes "所以务必保持警惕。";
			mes "不要掉以轻心。";
			close;
		}
	}
	else {
		mes "[斯洛蒂]";
		mes "在这附近请小心。哥布林会攻击";
		mes "他们遇到的任何人类。最近，";
		mes "它们变得更加暴力，";
		mes "所以务必保持警惕。";
		mes "不要掉以轻心。";
		close;
	}
}

prt_church,87,127,3	script	Pastor#1011	755,{
	if (BaseJob == Job_Crusader) {
		if (Upper == 1 && getskilllv("CR_SHRINK")) {
			if (CRUS_SK == 8) {
				mes "[Father Arthur]";
				mes "哦，你现在成为圣骑士了，";
				mes "是吗？我真为你骄傲。";
				mes "毕竟，我认识你时，";
				mes "你还是一名勇敢的十字军。";
				mes "真是令人欣慰。";
				next;
				mes "[Father Arthur]";
				mes "希望你继续运用力量对抗邪恶，";
				mes "保护弱者。愿你的内心";
				mes "指引你的行动。";
				mes "请坚持自己的信念。";
				mes "愿神保佑你。";
				close;
			}
			else if (CRUS_SK == 10) {
				mes "[Father Arthur]";
				mes "啊，你最近过得好吗？";
				mes "很高兴在更愉快的情况下见到你。";
				mes "如果你觉得我能帮上忙，";
				mes "请马上告诉我。";
				mes "我会尽力帮助你。";
				close;
			}
		}
		if (CRUS_SK == 4) {
			mes "[Father Arthur]";
			mes "你好。";
			mes "今天我能为你";
			mes "提供什么帮助？";
			next;
			mes "["+ strcharinfo(0) +"]";
			mes "有人被哥布林打伤了，";
			mes "福特爵士告诉我，";
			mes "只有你能制作";
			mes "哥布林毒药解毒剂。";
			mes "请帮帮他。";
			next;
			mes "[Father Arthur]";
			mes "愿圣光保佑我们，";
			mes "哥布林确实残忍无情！";
			mes "遗憾的是，我的哥布林毒药解毒剂用完了，";
			mes "必须从头开始制作。";
			mes "请给我一点时间。";
			mes "我会尽力完成。";
			next;
			mes "["+ strcharinfo(0) +"]";
			mes "告诉我制作它需要什么，";
			mes "我马上把所有材料带来！";
			mes "请列出清单。";
			mes "我不会浪费时间。";
			next;
			mes "[Father Arthur]";
			mes "啊，对了。带给我";
			mes "^0000FF20 个黏稠液体^000000、";
			mes "^0000FF3 个空瓶^000000、";
			mes "^0000FF5 个杰勒比结晶^000000……";
			next;
			mes "[Father Arthur]";
			mes "……^0000FF1 个煤炭^000000、";
			mes "^0000FF1 个葡萄^000000、";
			mes "^0000FF3 个赛依伐^000000和";
			mes "^0000FF1 个青涩苹果^000000。";
			mes "快点，他中毒后撑不了多久！";
			mes "请立刻行动。";
			set CRUS_SK,5;
			close;
		}
		else if (CRUS_SK == 5) {
			if (countitem(514) > 0 && countitem(619) > 0 && countitem(1003) > 0 && countitem(7053) > 2 && countitem(713) > 2 && countitem(909) > 4 && countitem(938) > 19) {
				mes "[Father Arthur]";
				mes "啊，你回来了。";
				mes "让我检查一下，";
				mes "看看你是否带齐了制作解毒剂所需的";
				mes "全部材料。";
				mes "请稍等。";
				next;
				mes "[Father Arthur]";
				mes "很好，很好。看来材料齐全。";
				mes "在开始之前，我必须告诉你，";
				mes "解毒剂的效果有时间限制。";
				mes "请尽快使用。";
				mes "不要错过时机。";
				next;
				mes "[Father Arthur]";
				mes "不过，在尝试之前无法准确预测";
				mes "解毒剂什么时候会失效。";
				mes "因此，你可能需要回来找我";
				mes "重新制作一份。";
				mes "请记住这一点。";
				mes "不要错过时限。";
				next;
				mes "[Father Arthur]";
				mes "这些材料应该足够制作多次剂量，";
				mes "所以不用担心再次收集材料。";
				mes "现在请给我一点时间，";
				mes "让我把它提炼出来……";
				mes "很快就好。";
				mes "请稍等。";
				delitem 938,20; //Sticky_Mucus
				delitem 619,1; //Unripe_Apple
				delitem 909,5; //Jellopy
				delitem 514,1; //Grape
				delitem 1003,1; //Coal
				delitem 7053,3; //Cyfar
				delitem 713,3; //Empty_Bottle
				set CRUS_SK,6;
				close;
			}
			else {
				mes "[Father Arthur]";
				mes "很抱歉，这些材料不够，";
				mes "无法提炼解毒剂。";
				mes "嗯，需要的材料是什么来着？";
				mes "请再确认一次。";
				mes "不要遗漏任何物品。";
				next;
				mes "[Father Arthur]";
				mes "啊，对了。带给我";
				mes "^0000FF20 个黏稠液体^000000、";
				mes "^0000FF3 个空瓶^000000、";
				mes "^0000FF5 个杰勒比结晶^000000……";
				next;
				mes "[Father Arthur]";
				mes "……^0000FF1 个煤炭^000000、";
				mes "^0000FF1 个葡萄^000000、";
				mes "^0000FF3 个赛依伐^000000和";
				mes "^0000FF1 个青涩苹果^000000。";
				mes "快点，他中毒后撑不了多久！";
				mes "请立刻行动。";
				close;
			}
		}
		else if (CRUS_SK == 6) {
			mes "[Father Arthur]";
			mes "你来得正是时候：我刚刚完成了";
			mes "哥布林毒药解毒剂。现在请";
			mes "仔细听我说……";
			mes "这件事非常重要。";
			mes "请不要分心。";
			next;
			mes "[Father Arthur]";
			mes "我不能保证解毒剂一定有效。";
			mes "如果你抵达前它失效了，";
			mes "你就必须回来重新取一份。";
			mes "请务必抓紧时间。";
			mes "不要让伤者等太久。";
			next;
			mes "[Father Arthur]";
			mes "你必须尽快赶到伤者身边。";
			mes "我把解毒剂交给你后，";
			mes "你要以最快速度赶过去：";
			mes "现在有人命危在旦夕！";
			mes "请不要浪费时间。";
			mes "快去吧！";
			next;
			mes "[Father Arthur]";
			mes "给，拿好解毒剂。";
			mes "现在出发！";
			mes "冒险者，愿你一路顺利！快去救人吧。";
			set CRUS_SK,7;
			close;
		}
		else if (CRUS_SK == 7) {
			mes "[Father Arthur]";
			mes "你还没出发吗？！";
			mes "快去伤者那里使用解毒剂！";
			mes "如果到得太晚，";
			mes "你就必须回来取一份新的解毒剂！";
			mes "快点！";
			mes "不要再迟到了！";
			close;
		}
		else if (CRUS_SK == 8) {
			mes "[Father Arthur]";
			mes "啊，解毒剂成功了，";
			mes "那个人应该能完全康复了？";
			mes "很好，很好。听说他好转了，";
			mes "我也就放心了。";
			mes "愿他早日恢复健康。";
			close;
		}
		else if (CRUS_SK == 9) {
			mes "[Father Arthur]";
			mes "解毒剂失败了？！";
			mes "我们别无选择，只能再试一次。";
			mes "来，让我赶快为你提炼新的剂量。";
			mes "等等，等等……";
			mes "啊！好了！我完成了！";
			mes "快把它带给伤者。";
			next;
			mes "[Father Arthur]";
			mes "现在拿着这份新解毒剂，";
			mes "以最快速度跑去";
			mes "伤者那里！快去！";
			mes "不要停留。";
			set CRUS_SK,7;
			close;
		}
		else if (CRUS_SK == 10) {
			mes "[Father Arthur]";
			mes "啊，你最近过得好吗？";
			mes "很高兴在更愉快的情况下见到你。";
			mes "如果你觉得我能帮上忙，";
			mes "请马上告诉我。";
			mes "我会尽力帮助你。";
			close;
		}
		else {
			mes "[Father Arthur]";
			mes "啊，你好～";
			mes "欢迎来到普隆德拉";
			mes "教堂。请在这里放松，";
			mes "享受宁静，让心灵";
			mes "恢复平静。";
			close;
		}
	}
	else {
		mes "[Father Arthur]";
		mes "啊，你好～";
		mes "欢迎来到普隆德拉";
		mes "教堂。请在这里放松，";
		mes "享受宁静，让心灵";
		mes "恢复平静。";
		close;
	}
}


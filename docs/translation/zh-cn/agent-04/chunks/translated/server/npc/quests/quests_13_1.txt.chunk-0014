// Part Time Work :: ep13_alba
//============================================================ 
mid_camp,1,1,0	script	#timer_alba01	844,{
	callfunc "F_GM_NPC";
	mes "请输入密码";
	next;
	if (callfunc("F_GM_NPC",1854,0) < 1) {
		mes "密码错误。";
		close;
	} else {
	mes "当前状态：";
		if ($@PartTimeOn == 1) {
		mes "招募中。";
		}
		else {
		mes "未招募。";
		}
	mes "已招募 " + $@PartTimeSlots + " 名兼职人员。";
	mes "你想做什么？";
		next;
		switch(select("Reset the recruiting.:Cancel.")) {
		case 1:
		mes "招募已重置。";
		mes "计时器已停止！";
			stopnpctimer;
			next;
		mes "全局值已重置。";
			set $@PartTimeOn,0;
			set $@PartTimeSlots,0;
			next;
		mes "招募已重置。";
		mes "计时器已启动！";
			donpcevent "#timer_alba01::OnEnable";
			close;
		case 2:
		mes "已取消。";
			close;
		}
	}

OnInit:
	set $@PartTimeOn,0;
	set $@PartTimeSlots,0;
OnEnable:
	initnpctimer;
	end;

OnStop:
	stopnpctimer;
	end;

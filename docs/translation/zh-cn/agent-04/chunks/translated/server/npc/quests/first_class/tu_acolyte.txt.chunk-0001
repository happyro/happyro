// Priest Praupin
//============================================================
prt_church,179,15,1	script	Priest Praupin	4_M_MINISTER,{
	mes "[普劳平牧师]";
	if(BaseJob != Job_Acolyte){
		if(tu_acolyte01 == 25){
			mes "哦……！";
			mes "你是"+strcharinfo(0)+" !";
			mes "你成长了许多！";
			mes "我真的为你骄傲。";
		} else {
			mes "愿你";
			mes "永远得到祝福……";
		}
		close;
	}
	switch(tu_acolyte01){
	case 0:
		mes "欢迎你，小家伙。";
		mes "命运一定让";
		mes "我们相遇，";
		mes "今天见面。很高兴认识你。";
		next;
		mes "[普劳平牧师]";
		mes "但我担心";
		mes "你可能不知道接下来";
		mes "作为服事该做什么……";
		next;
		switch(select("I'm not worried.:What should I do?")){
		case 1:
			mes "[普劳平牧师]";
			mes "看到你坚定的眼神让我放心。 遇到困难随时向我求助。 再见，受祝福的孩子。";
			close;
		case 2:
			mes "[普劳平牧师]";
			mes "普隆德拉东北方有一座修道院";
			mes "，名为圣卡皮托利纳修道院。 去那里寻找 ^3131FF 阿斯特修女^000000. 她温柔善良，";
			mes "有很多东西可以教你。";
			next;
			mes "[普劳平牧师]";
			mes "我期待看到你在阿斯特修女的指导下成为更优秀的服事。";
			mes "如果愿意，我可以送你去修道院。";
			tu_acolyte01 = 1;
			next;
			if(select("Go to the convent.:Do not go.")==1){
				mes "[普劳平牧师]";
				mes "替我向阿斯特修女问好。";
				mes "一路平安，小家伙……";
				mes "";
				close2;
				warp "prt_monk",30,250;
				end;
			} else {
				mes "[普劳平牧师]";
				mes "如果愿意，我随时可以送你去修道院。";
				mes "需要帮助时就来找我。";
				mes "";
				mes "";
				mes "";
				close;
			}
		}
	case 7:
		mes "你是在寻找教堂里";
		mes "负责弓箭手事务的人吗？嗯……";
		mes "";
		next;
		mes "[普劳平牧师]";
		mes "啊，他现在在修道院。想在圣卡皮托利纳修道院见莫金斯主教，就从普隆德拉向^3131FF北^000000、^3131FF东^000000、^3131FF东^000000再向^3131FF东^000000走。";
		close;
	case 22:
		if(countitem(7181) > 0){// Receipt_01
			emotion ET_SURPRISE;
			mes "哎呀，你似乎很快就适应了服事身份。";
			mes "训练困难吗？";
			mes "";
			mes "";
			next;
			mes "[普劳平牧师]";
			mes "你有东西要给我？哦，是收据！";
			mes "我正想知道发生了什么。谢谢你的帮忙。";
			mes "";
			mes "";
			mes "";
			next;
			mes "[普劳平牧师]";
			mes "哎呀，哎呀。";
			mes "有一阵子没见了。";
			mes "不知道该送你什么？";
			mes "";
			next;
			mes "[普劳平牧师]";
			mes "这些怎么样？";
			mes "我知道不算贵重，但我年轻时当服事时它们帮了我很多。";
			mes "";
			next;
			if (select("Wand:Flail") == 1)
				getitem 1604,1; //Wand
			else
				getitem 1510,1; //Flail
			delitem 7181,1; //Receipt_01
			tu_acolyte01 = 23;
			close;
		} else {
			mes "你真是个好人，光明的孩子。";
			mes "希望更多人能受益于你纯洁的心灵。";
			close;
		}
	case 25:
		mes "现在你必须找到自己的道路，";
		mes "依靠自身力量成为更优秀的服事。";
		mes "";
		mes "";
		next;
		mes "[普劳平牧师]";
		mes "我虽担心，但相信你的勇气与善良。愿你永远受到保护和祝福。";
		mes "";
		close;
	}
	mes "圣卡皮托利纳修道院的阿斯特修女是个真诚又慈爱的人。";
	mes "";
	next;
	mes "[普劳平牧师]";
	mes "要我送你去修道院，向这位优秀的老师学习吗？";
	next;
	if(select("Yes, please.:No thanks.")==1){
		mes "[普劳平牧师]";
		mes "替我向阿丝黛修女问好。";
		mes "一路平安，小家伙……";
		mes "";
		close2;
		warp "prt_monk",30,250;
		end;
	} else {
		mes "[普劳平牧师]";
		mes "如果愿意，我随时可以送你去修道院。";
		mes "需要帮助时就来找我。";
		mes "";
	}
	close;
}

// Asthe
//============================================================
prt_monk,230,106,3	script	Asthe#tu	1_F_PRIEST,{
	mes "[Asthe]";
	switch(tu_acolyte01){
	case 1:
		mes "哎呀……";
		mes "这么年轻的服事怎么来到这么偏远的地方？";
		mes "";
		mes "";
		mes "";
		next;
		if(select("I came for fun.:Priest Praupin suggested I come here.")==1){
			mes "[Asthe]";
			mes "这座修道院总是安静祥和。坐在长椅上感受四周无所不能的存在，是令人放松的冥想体验。";
		}
		else {
			mes "[Asthe]";
			mes "Priest Praupin?";
			mes "他很善良，总是为他人着想。是他送你来接受训练的吗？";
			mes "";
			mes "";
			mes "";
			next;
			mes "[Asthe]";
			mes "开始前先休息一会儿吧。一路来到这里一定很累。准备好后再来找我，好吗？";
			mes "";
			mes "";
			mes "";
			tu_acolyte01 = 2;
		}
		close;
	case 2:
	mes "这座圣卡皮托利纳修道院美丽而宁静，能让任何心灵平静。";
	mes "";
		next;
		mes "[Asthe]";
		mes "那么……开始课程吧？";
		mes "";
		mes "";
		next;
		mes "[Asthe]";
		mes ""+strcharinfo(0)+",";
		mes "你想成为什么样的服事？为理想未来做好规划非常重要。";
		next;
		if(select("One that supports others.:One that punishes evil.")==1){
			mes "[Asthe]";
			mes "啊，你真有一颗慷慨的心！";
			mes "治愈他人的痛苦并在战斗中支持同伴。你必须先成为服事，才能转为^3131FF牧师^000000。";
			mes "";
			next;
			mes "[Asthe]";
			mes "牧师拥有强大的辅助能力和对抗邪恶的力量。他们像其他战士一样使用武器，但^3131FF禁止使用刀刃^000000。";
		} else {
			mes "[Asthe]";
			mes "以拳头执行神罚的人称为武僧。他们以更……生动的方式传递爱与和平。";
			mes "";
			next;
			mes "[Asthe]";
			mes "成为武僧需要极大的耐心和自制。你会经常看到武僧在各地锻炼身心。";
			mes "";
			mes "";
		}
		next;
		mes "[Asthe]";
		mes "你还有很长的路要走。最好慢慢规划，认真考虑未来。";
		next;
		mes "[Asthe]";
		mes "现在，";
		mes ""+strcharinfo(0)+"...";
		mes "你认为服事最需要的技能是什么？";
		mes "";
		mes "";
		mes "";
		next;
		switch(select("Heal:Aqua Benedicta:Teleport")){
		case 1:
			mes "[Asthe]";
			mes "啊，是的。^3131FF治愈^000000是基础但重要的技能，能恢复自己和他人的生命。";
			mes "";
			mes "";
			break;
		case 2:
			mes "[Asthe]";
			mes "^3131FF圣水制作^000000祝福普通水并将其变为圣水。";
			mes "这是重要技能，但并非所有服事的必修。";
			mes "";
			next;
			mes "[Asthe]";
			mes "我认为^3131FF治愈^000000是服事最重要的技能，能拯救他人并击败黑暗魔物。";
			mes "";
			mes "";
			mes "";
			break;
		case 3:
			mes "[Asthe]";
			mes "^3131FF瞬间移动^000000让你瞬间前往其他地方。虽是强大技能，但并非所有服事必需。";
			next;
			mes "[Asthe]";
			mes "我认为^3131FF治愈^000000是服事最重要的技能，能拯救他人并击败黑暗魔物。";
			mes "";
			mes "";
			break;
		}
		next;
		mes "[Asthe]";
		mes "你可以用治愈技能的神圣力量攻击不死魔物（^3131FFShift + 治愈^000000）。真理之光保护正义、摧毁邪恶。";
		mes "";
		next;
		mes "[Asthe]";
		mes "只要将心中的力量";
		mes "汇聚到双手……";
		mes "";
		next;
		mes "[Asthe]";
		mes "治愈！！";
		npcskill "AL_HEAL",11,99,60;
		tu_acolyte01 = 3;
		if(getskilllv("AL_HEAL") == 0){
			getexp 0,100;
			specialeffect2 EF_CONE;
		}
		close;
	case 3:
		mes "我想给你一项任务，你觉得呢？现在最重要的是学习基础。";
		mes "";
		mes "";
		next;
		if(getskilllv("AL_HEAL") < 3){
			mes "[Asthe]";
			mes "那么，把治愈技能学到^3131FF 3 级^000000再回来。";
			mes "";
			mes "";
			mes "";
			next;
			mes "[Asthe]";
			mes "你的力量尚未成长，暂时去对付较弱的魔物。";
			mes "我会借给你教会的钉锤，好好使用，完成后^3131FF归还^000000，好吗？";
			mes "";
			next;
			mes "[Asthe]";
			mes "首先^0033FF从普隆德拉等城镇周围的魔物开始战斗^000000。这里的魔物更方便，但现在可能太强。";
			next;
			mes "[Asthe]";
			mes "我会把你的存档点改到修道院。学会 3 级治愈后，可用蝴蝶翅膀回到这里。";
			next;
			mes "[Asthe]";
			mes "你也可以和^3131FF普隆德拉教堂的普劳平牧师^000000交谈，他会送你回来。";
			mes "他很照顾年轻的服事。";
			mes "";
			next;
			mes "[Asthe]";
			mes "那么，祝你一路平安。";
			mes "";
			mes "";
			tu_acolyte01 = 4;
			getitem 1504,1; //Mace
			getitem 602,1; //Wing_Of_Butterfly
			savepoint "prt_monk",30,250,1,1;
		}
		else {
			mes "[Asthe]";
			mes "哎呀！你已经学会正确使用治愈技能了。很好！";
			mes "";
			mes "";
			mes "";
			mes "";
			next;
			mes "[Asthe]";
			mes "我想你已经准备好学习下一项内容。现在，让我看看……嗯……";
			mes "";
			mes "";
			mes "";
			mes "";
			tu_acolyte01 = 5;
		}
		close;
	case 4:
		if(getskilllv("AL_HEAL") > 2){
			if(countitem(1504) > 0){// Mace
				mes "哎呀！欢迎回来~";
				mes "我看你已经完成任务了。干得好！";
				mes "";
				mes "";
				mes "";
				next;
				mes "[阿丝黛]";
				mes "如果不介意，请把钉锤还给我。";
				mes "你是否携带^FF0000其他带元素属性的钉锤^000000？";
				mes "如果有，请先存起来。我的视力太差，分辨不出来……呵呵。";
				mes "";
				next;
				mes "[阿丝黛]";
				mes "现在要我从你的物品栏取走钉锤吗？";
				next;
				if(select("Sure.:Let me check again.") == 2) {
					mes "[阿丝黛]";
					mes "好，没问题。";
					mes "请确保不要携带^FF0000带元素属性的钉锤^000000。";
					close;
				}
				mes "[阿丝黛]";
				mes "非常感谢。";
				mes "你已经归还钉锤。";
				emotion ET_SMILE;
				tu_acolyte01 = 5;
				delitem 1504,1; //Mace
				if(Class == Job_Acolyte_High)
					getexp 2000,1000;
				else
					getexp 1000,500;
				specialeffect2 EF_CONE;
			}
			else {
				mes "哎呀！欢迎回来~";
				mes "我看你已经完成任务了。";
				mes "";
				mes "";
				next;
				mes "[阿丝黛]";
				mes "你一定忘了我借给你的钉锤。请带回来，我好归还教会。";
			}
			close;
		}
		mes "学习 3 级治愈的训练很辛苦吗？";
		mes "请不要气馁。";
		mes "";
		mes "";
		next;
		mes "[阿丝黛]";
		mes "基础是掌握未来高级技能的关键。记住，你的努力和痛苦终将化为荣耀与幸福。";
		mes "";
		close;
	case 5:
		mes "我可以再告诉你一些服事职业的事。初心者必须训练并前往普隆德拉教堂，才能成为一转职业服事。";
		next;
		mes "[阿丝黛]";
		mes "成为职业等级 ^3131FF40^000000 的服事后，你可以转职为更专业的二转职业。";
		next;
		mes "[Asthe]";
		mes "转为二转职业时，服事可以成为慈悲使徒^3131FF牧师^000000，或执行神之愤怒的^3131FF武僧^000000。";
		mes "";
		mes "";
		mes "";
		mes "";
		next;
		mes "[阿丝黛]";
		mes "牧师和武僧可以前往瓦尔哈拉拜访女武神转为超越职业。牧师成为^3131FF高阶牧师^000000，武僧成为^3131FF武术宗师^000000。";
		mes "";
		mes "";
		mes "";
		next;
		mes "[阿丝黛]";
		mes "都明白了吗？呵呵呵~现在不用强记，慢慢就会掌握。";
		mes "";
		tu_acolyte01 = 6;
		close;
	case 6:
		mes ""+strcharinfo(0)+",";
		mes "我刚收到这封信，但似乎寄错了。";
		mes "它其实是给加德隆牧师的。";
		mes "";
		next;
		mes "[阿丝黛]";
		mes "不过我现在有点忙，你能替我把信送给隔壁建筑的加德隆牧师吗？";
		mes "";
		tu_acolyte01 = 7;
		getitem 7148,1; //Mother_Letter
		close;
	case 7:
		mes "请把这封信交给加德隆牧师。";
		mes "他就在附近的建筑里。";
		mes "";
		mes "";
		mes "";
		close;
	case 9:
		mes "你代表修道院为加德隆牧师前往"+(checkre(0)?"普隆德拉":"斐扬")+"？一定很辛苦……";
		next;
		mes "[阿丝黛]";
		mes "祝福！";
		npcskill "AL_BLESSING",10,0,0;
		next;
		mes "[阿丝黛]";
		mes "现在教你^FF0000祝福^000000。这是传递神之祝福的神圣技能，可暂时提升^3131FFSTR^000000、^3131FFINT^000000、^3131FFDEX^000000并解除^3131FF诅咒^000000。";
		next;
		mes "[Asthe]";
		mes "和治愈一样，祝福也能对不死魔物使用。";
		mes "(^3131FFSHIFT + Blessing^000000)";
		mes "祝福实际上会对不死魔物施加诅咒。";
		next;
		mes "[阿丝黛]";
		mes "学习 5 级^3131FF天使之保护^000000后才能学习祝福。该技能会提高你抵抗不死和恶魔魔物伤害的能力。";
		next;
		mes "[阿丝黛]";
		mes "侍奉神并用神的荣耀祝福他人是莫大荣誉。好了，本课就到这里。";
		next;
		mes "[阿丝黛]";
		mes "哦，对了……！我一直照顾这里西北墓地的一只走失小狗。现在该喂它了。";
		next;
		mes "[阿丝黛]";
		mes "抱歉麻烦你，能替我去喂狗吗？";
		next;
		mes "^3355FF阿丝黛修女给了你一些狗粮。^000000";
		tu_acolyte01 = 10;
		close;
	case 11:
	case 12:
		mes "如何驱逐";
		mes "邪灵？";
		mes "当然要用和解除诅咒相同的方法……";
		mes "";
		mes "";
		next;
		mes "[阿丝黛]";
		mes "啊……";
		mes "我相信这是神给予你的考验。";
		mes "";
		mes "";
		next;
		mes "[阿丝黛]";
		mes "你已经";
		mes "";
		mes "";
		mes "";
		mes "";
		mes "";
		mes "";
		mes "";
		mes "";
		mes "";
		mes "";

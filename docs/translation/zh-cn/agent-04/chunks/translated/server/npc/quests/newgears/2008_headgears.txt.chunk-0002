in_orcs01,119,106,3	script	Orc Lady#2008hat03	1273,2,2,{

OnTouch:
	mes "["+strcharinfo(0)+"]";
	mes "这个兽人女士正专心做某件事。";
	mes "不知道她在做什么……就算我走到她面前，她也不会注意到。";
	next;
	mes "["+strcharinfo(0)+"]";
	mes "要和她说话吗？……呃，我们能互相理解吗？";
	next;
	mes "兽人女士突然惊讶地转过身。";
	mes "一朵食人花花瓣从她手中掉到地上。";
	next;
	switch(select("帮兽人女士捡起花。:逃跑！")) {
	case 1:
		mes "[Orc Lady]";
		mes ".. ...";
		mes "带武器的冒险者帮助兽人？";
		mes "你真奇怪。";
		mes "我叫艾特-纳-齐尔-贝。";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "没想到兽人女士竟然自我介绍了。";
		mes "我该如何回应？";
		next;
		switch(select("问她在做什么。:道别。")){
		case 1:
			mes "[Aite]";
			mes "我在制作花冠。";
			mes "用丝带……编织花朵……";
			mes "新娘……会戴……花冠……";
			next;
			select("能为我做一顶吗？");
			if((countitem(10007) > 0) && (countitem(1032) > 999)) {
				mes "[Aite]";
				mes "……材料……你有……";
				mes "……需要很多时间制作……";
				next;
				mes "[Aite]";
				mes "和你交换……我刚做好的这个。";
				mes "不过你真奇怪。";
				mes "你们人类……很难……理解。";
				delitem 10007,1;
				delitem 1032,1000;
				getitem 5436,1;
				close;
			}
			mes "[Aite]";
			mes "我需要……丝带……";
			mes "1,000 朵食人花花瓣……";
			mes "带给我……";
			next;
			mes "["+strcharinfo(0)+"]";
			mes "（^4d4dff 丝带和 1,000 朵食人花花瓣^000000，嗯……）";
			mes "明白了。我会去收集材料。";
			close;
		case 2:
			mes "["+strcharinfo(0)+"]";
			mes "我面带微笑、什么也没说，点头向她道别。";
			mes "她也点头回应，仿佛理解了我的道别。";
			close;
		}
	case 2:
		mes "["+strcharinfo(0)+"]";
		mes "趁她还在震惊，赶紧逃跑。";
		close2;
		warp "gef_fild10",223,203;
		end;
	}
	end;
}

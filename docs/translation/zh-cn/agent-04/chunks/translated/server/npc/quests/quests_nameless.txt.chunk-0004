			next;
			mes "[尼伦]";
			mes "哦，他们。是的，我知道";
			mes "一点。";
			mes "恐怕我不能透露";
			mes "某些信息，";
			mes "因为这是";
			mes "机密案件……";
			next;
			mes "[尼伦]";
			mes "恐怕不能轻易向你提供他们的信息";
			mes "因为他们对我们很重要。";
			next;
			mes "["+strcharinfo(0)+"]";
			mes "其实我想知道";
			mes "他们绑架了谁。";
			next;
			mes "[尼伦]";
			mes "哦，我想我可以告诉你";
			mes "更多关于";
			mes "俘虏的信息。";
			mes "但首先我想请你";
			mes "帮个忙。";
			next;
			select("接受:不要拒绝");
			mes "[尼伦]";
			mes "当我们意识到";
			mes "走私者抓到的俘虏身份时，";
			mes "";
	// 行数占位：保持与官方源文件物理行数一致
			mes "我们不知道如何处理他。";
			mes "内部问题太多，难以处理……";
			mes "";
			next;
			mes "[尼伦]";
			mes "不过我们觉得可以把他";
			mes "用于计划，";
			mes "所以将他关在秘密地点，";
			mes "只有少数人知道位置。但";
			mes "";
			mes "后来……我们失去所有联系。";
			next;
			mes "[尼伦]";
			mes "我们派了调查员，但";
			mes "仍不知道";
			mes "发生了什么。他们只发现";
			mes "幸存者留下的信息：";
			mes "“他们都是恶魔。”那名";
			mes "俘虏可能已经死了。";
			next;
			mes "[尼伦]";
			mes "他可能是高级官员，";
			mes "但我们被其他事务";
			mes "牵制，事实上";
			mes "";
			mes "还没想好";
			mes "该如何处理他……";
			next;
			mes "[尼伦]";
			mes "我想请你";
			mes "前往那个地方，";
			mes "弄清那里发生了什么，";
			mes "以及那位来自卢恩-米德加尔特的";
			mes "高级官员是否还活着。";
			mes "我对此表示怀疑，但是……";
			next;
			mes "[尼伦]";
			mes "我们神殿雇用的调查员";
			mes "通常比不上你这样的";
			mes "外国冒险者，所以我相信你能做到。";
			mes "不过，那里相当危险。";
			next;
			mes "[尼伦]";
			mes "如果你能做到，我会告诉你";
			mes "那个地方的位置：我们通常称它为修道院。";
			mes "它过去确实是修道院，但现在用来关押俘虏。";
			next;
			mes "[尼伦]";
			mes "抱歉，我不能再告诉你";
			mes "关于那个旧地方的其他信息。";
			mes "它位于维因斯西南方的海对面。";
			mes "你应该能在维因斯南海滩找到船。";
			next;
			mes "[尼伦]";
			mes "不过……算了。";
			mes "我想再多帮助你，";
			mes "但那会危及我的立场。抱歉。";

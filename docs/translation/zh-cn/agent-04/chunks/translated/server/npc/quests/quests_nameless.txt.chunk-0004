			mes "现在只有你能帮助他。";
			next;
			mes "[大祭司尼伦]";
			mes "...............................";
		mes "...............................";
		mes "...............................";
	next;
		mes "[大祭司尼伦]";
			mes "Zhed 和我过去确实";
			mes "合作得很好，";
			mes "但我们不再拥有同一个梦想。";
			mes "你最好去找别人。";

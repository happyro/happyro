		delequip EQI_ARMOR;
		getitem2 .@item_id,1,1,.@refine,0,.@card[0],0,0,0;
		break;
	case 5:
		if (getequipid(EQI_ACC_L) == -1) {
			mes "[Dylan]";
			mes "哦，我忘了说。我只强化装备在左侧插槽的物品。请装备在左侧插槽再强化。";
			close;
		}
		.@card[2] = getequipcardid(EQI_ACC_L,2);
		.@card[3] = getequipcardid(EQI_ACC_L,3);
		if (.@card[2] == 0 || .@card[3] == 0) {// note: Prontera Badge unslotted
			mes "[Dylan]";
			mes "哦，这件物品尚未完全强化。我还不能重置。";
			close;
		}
		if (getequipid(EQI_ACC_L) != 28356) {
			mes "[Dylan]";
			mes "别胡闹。想强化就戴着普隆德拉徽章来。";
			close;
		}
		if (countitem(6919) < 10) {
			mes "[Dylan]";
			mes "嘿，朋友。没有荣誉印记就不能找我。";
			close;
		}
		delequip EQI_ACC_L;
		delitem 6919,10;
		mes "[Dylan]";
		if (rand(1,100) < 80) {
			mes "嗯，处理得很好。检查一下物品。";
			getitem 28356,1;// Prontera Badge
			specialeffect2 EF_REPAIRWEAPON;
		}
		else {
			mes "看来你运气不好。装备坏了。啧啧。";
			.@r = rand(1,100);
			if (.@r < 61) getitem 6920,9;	// RuneMagicPowder
			else if (.@r < 81) getitem 6920,10;
			else if (.@r < 87) getitem 6920,11;
			else if (.@r < 93) getitem 6920,12;
			else if (.@r < 98) getitem 6920,13;
			else if (.@r < 100) getitem 6920,14;
			else getitem 6920,15;
			specialeffect2 EF_LORD;
		}
		close;
	}
	mes "[Dylan]";
	mes "嗯，处理得很好。检查一下物品。";
	specialeffect2 EF_REPAIRWEAPON;
	close;
}

prt_pri00,51,116,8	script	Ellond Lawrence#EP161ER	4_M_CRU,1,1,{
	if (checkweight(1301,1) == 0) {
		mes "- 物品太多，无法继续任务。 -";
		close;
	}
	if (BaseLevel < 140) {
		npctalk "Ellond Lawrence：如果你再强一点就好了……真遗憾。", "", bc_self;
		mes "[Ellond Lawrence]";
		mes "~笑~你是冒险者。";
		mes "此区域禁止未经授权进入。感谢配合。";
		close;
	}
	switch( isbegin_quest(5415) ) {
	case 0:
		mes "[Ellond Lawrence]";
		mes "你好。";
		next;
		mes "[Ellond Lawrence]";
		mes "很抱歉，前方区域禁止未经授权的进入。给你带来不便，还请配合。";
		next;
		emotion ET_SURPRISE;
		mes "[Ellond Lawrence]";
		mes "说起来……不是所有人都能进入这里。哇！";
		next;
		mes "[Ellond Lawrence]";
		mes "听说为击败恶魔之王摩洛克做出重大贡献的冒险者受邀参加王室宴会。";
		next;
		mes "[Ellond Lawrence]";
		mes "既然你在这里……你一定是……！";
		next;
		emotion ET_HUK;
		mes "[Ellond Lawrence]";
		mes "冒险者，你受邀了吗？";
		next;
		emotion ET_COOL;
		mes "[Ellond Lawrence]";
		mes "哇，难以置信！";
		mes "我听说过很多关于你的事。我是你的超级粉丝！";
		next;
		mes "[Ellond Lawrence]";
		mes "天啊！宴会之夜还要在这里站岗真难受，我没想到会在这里见到你，冒险者。太棒了！";
		next;
		mes "[Ellond Lawrence]";
		mes "那我先自我介绍。";
	mes "我是皇家十字军的 Ellond Lawrence。我非常敬重你。";
		next;
		mes "[Ellond Lawrence]";
		mes "哦，我差点忘了！能给我签名吗？";
		next;
		if (select( "给他签名。", "（拒绝。）" ) == 1) {
			input .@string$;
			emotion ET_BIGTHROB;
			mes "[Ellond Lawrence]";
		mes "非常感谢！现在我有东西可以向同伴炫耀了。这是我们家族的荣誉。";
		}
		else {
			mes "[Ellond Lawrence]";
			mes "听到这个我很遗憾，但我理解你有自己的理由。";
		}
		next;
		mes "[Ellond Lawrence]";
		mes "哦，对！我明白了！";
		next;
		mes "[Ellond Lawrence]";
	mes "会议期间有人提议请著名冒险者处理限制区域的问题。虽然没有获得批准，但我会看看能否用权限帮忙。";
		next;
		select("限制区域的问题？");
		mes "[Ellond Lawrence]";
		mes "哦，我就知道这会引起你的兴趣，冒险者。";
		next;
		mes "[Ellond Lawrence]";
	mes "没人会质疑你的声望和能力。所以我很想直截了当地告诉你，但……";
		next;
		emotion ET_SHY;
		mes "[Ellond Lawrence]";
		mes "我想在做之前得深呼吸，喝杯水让自己冷静。";
		setquest 5415;// Restricted Sector
		close;
	case 1:
		emotion ET_BEST;
		mes "[Ellond Lawrence]";
		mes "现在我不渴了，让我告诉你故事。";
		next;
		mes "[Ellond Lawrence]";
		mes "这个问题长期令人头疼。";
		next;
		mes "[Ellond Lawrence]";
		mes "一开始确实没有怪物，但突然之间，它们开始出现在地下地牢。";
		next;
		mes "[Ellond Lawrence]";
		mes "这不代表我们在这里偷懒！";
		next;
		emotion ET_KEK;
		mes "[Ellond Lawrence]";
		mes "我们十字军正尽最大努力消灭地下地牢里的怪物。";
		next;
		mes "[Ellond Lawrence]";
		mes "遗憾的是，怪物数量不断增加，已经无法靠我们自己全部处理。";
		next;
		mes "[Ellond Lawrence]";
		mes "虽然不愿承认，但我们甚至还没查明这些怪物来自哪里。";
		next;
		mes "[Ellond Lawrence]";
		mes "地下地牢里的是……不，我不该在这里说。你进去后就会看到了。";
		next;
		select("那么，我能为你做什么？");
		mes "[Ellond Lawrence]";
		mes "哦，抱歉。我想我说得太多了。";
		next;
		mes "[Ellond Lawrence]";
		mes "不需要提交调查报告。我们也有自己的报告。";
		next;
		mes "[Ellond Lawrence]";
		mes "我想请你尽可能清除地下地牢里的怪物。";
		next;
		completequest 5415;// Restricted Sector
		mes "[Ellond Lawrence]";
		mes "另外，如果能告诉我地下地牢内部发生了什么，我会非常感激。";
		close;
	case 2:
		for ( .@quest_id = 5416; .@quest_id < 5424; .@quest_id++ ) {
			if (isbegin_quest(.@quest_id) == 1)
				break;
			.@total_completed += isbegin_quest(.@quest_id);
		}
		switch(.@quest_id) {
		case 5416:
			select("我去过 A 区。" );
			emotion ET_HUK;
			completequest 5416;// Restricted Sector A
			mes "[Ellond Lawrence]";
			mes "哇，你刚才说什么？你去过 A 区？";
			next;
			mes "[Ellond Lawrence]";
			mes "我还没见过那个区域的家伙，但负责那里的同伴说他相当凶猛。";
			next;
			mes "[Ellond Lawrence]";
			mes "总之，听说他没在那里惹麻烦真令人安心。";
			close;
		case 5417:
			select("我去过 B 区。" );
			emotion ET_SURPRISE;
			completequest 5417;// Restricted Sector B
			mes "[Ellond Lawrence]";
			mes "哦，是吗？";
			next;
			mes "[Ellond Lawrence]";
			mes "~笑~他曾是我的后辈。";
			next;
			mes "[Ellond Lawrence]";
			mes "我知道，他可能很烦人。他会要求制作逼真的人偶，甚至试图搭讪女同伴。";
			next;
			mes "[Ellond Lawrence]";
			mes "所以如果他没怎么变，就说明不会惹麻烦。听到这个我放心了。";
			close;
		case 5418:
			select("我去过 C 区。" );
			emotion ET_SMILE;
			completequest 5418;// Restricted Sector C
			mes "[Ellond Lawrence]";
			mes "~笑~你去过 C 区吗？";
			next;
			mes "[Ellond Lawrence]";
			mes "天啊！他真的说会为那些杂务奖励你？真是进步！";
			next;
			mes "[Ellond Lawrence]";
			mes "十字军丢失不该丢的东西并不罕见……";
			next;
			mes "[Ellond Lawrence]";
			mes "看来他们不知为何有所改善。他们大概很喜欢你。";
			close;
		case 5419:
			select("我去过 D 区。" );
			emotion ET_HUK;
			completequest 5419;// Restricted Sector D
			mes "[Ellond Lawrence]";
			mes "~倒吸气~D……区……D……？！~咽口水~";
			next;
			mes "[Ellond Lawrence]";
			mes "千万别被他的外表骗了！他可能是监狱里最危险的一个。";
			next;
			mes "[Ellond Lawrence]";
			mes "只要他不对你做什么，就是最好的结果。";
			close;
		case 5420:
			select("我去过 E 区。" );
			emotion ET_SHY;
			completequest 5420;// Restricted Sector E
			mes "[Ellond Lawrence]";
			mes "其实我知道一些 E 区的事。";
			next;
			mes "[Ellond Lawrence]";
			mes "他外表虽然如此，内心却细腻温暖。不过事情失控时，他确实会暴走。";
			next;
			mes "[Ellond Lawrence]";
			mes "只要别让他怒火中烧，我想你就不会有事。";
			close;
		case 5421:
			select("我去过 F 区。" );
			emotion ET_OHNO;
			completequest 5421;// Restricted Sector F
			mes "[Ellond Lawrence]";
			mes "F 区吗？~笑~真正的麻烦制造者就关在那里。";
			next;
			mes "[Ellond Lawrence]";
			mes "他连一根手指都不愿抬，却对所有人发号施令。他以为世界围着他转。";
			next;
			mes "[Ellond Lawrence]";
			mes "他爱抱怨，但没有危险。我想你和他相处不会有问题。";
			close;
		case 5422:
			select("我去过 G 区。" );
			emotion ET_SCRATCH;
			completequest 5422;// Restricted Sector G
			mes "[Ellond Lawrence]";
			mes "哦，你说 G 区？嗯，那个区域一定……";
			next;
			mes "[Ellond Lawrence]";
			mes "那个囚犯常被称为监狱里的睡美人。我记得他已经睡了很久。";
			next;
			mes "[Ellond Lawrence]";
			mes "关于他我没什么可说的，因为我只见过他睡觉。不过我想你能和他成为好朋友。";
			close;
		case 5423:
			select("我去过 H 区。" );
			emotion ET_HUK;
			completequest 5423;// Restricted Sector H
			mes "[Ellond Lawrence]";
			mes "啊，H 区！~放声大笑~他还是个爱抱怨的人吗？";
			next;
			mes "[Ellond Lawrence]";
			mes "我刚来这里时负责他，他的要求没完没了！";
			next;
			mes "[Ellond Lawrence]";
			mes "总之，他心地不坏。";
			close;
		default:
			break;
		}
		if (.@total_completed == 16 && isbegin_quest(5424) == 0) {
			emotion ET_HUK;
			mes "[Ellond Lawrence]";
			mes "哦，我差点忘了。";
			next;
			mes "[Ellond Lawrence]";
			mes "如果你忘了，你已经完整参观过地下地牢。";
			next;
			mes "[Ellond Lawrence]";
			mes "太棒了！你确实值得代表众多冒险者受邀参加王室宴会。";
			next;
			mes "[Ellond Lawrence]";
		mes "还有一件事。我已将交给你的请求报告给上级。";
			next;
			mes "[Ellond Lawrence]";
		mes "他们为表彰你的信誉提供了特别奖励金。";
			next;
			setquest 5424;// [Complete]Restricted Sector
			completequest 5424;// [Complete]Restricted Sector
			getexp 2100000,5500000;
			getitem 6919,2;// TokenOfHonor
			mes "[Ellond Lawrence]";
			mes "既然你收到了特别奖励金，请继续努力。";
			close;
		}
		mes "[Ellond Lawrence]";
		if (isbegin_quest(5424) == 2)
			mes "冒险者，感谢你为我们所做的一切。";
		else
			mes "像你这样勤奋的冒险者很少见。";
		next;
		mes "[Ellond Lawrence]";
		mes "准备进入地下地牢了吗？还有什么想问的吗？";
		next;
		switch( select( "To the Underground Dungeon...", "About the Underground Dungeon", "About Them", "I think I saw a bunch like them..." ) ) {
		case 1:
			mes "[Ellond Lawrence]";
			mes "祝你一路顺利。";
			close2;
			warp "prt_prison",160,290;
			end;
		case 2:
			mes "[Ellond Lawrence]";
			mes "你想了解地下地牢的什么？";
			next;
			mes "[Ellond Lawrence]";
			mes "没什么特别的。你能想象的王国地牢，就是全部。";
			next;
			mes "[Ellond Lawrence]";
			mes "听说它是用来关押威胁卢恩·米德加尔特和平与安全的人。";
			next;
			mes "[Ellond Lawrence]";
			mes "基本上建造得很坚固，但……";
			next;
			mes "[Ellond Lawrence]";
			mes "那里的设施非常老旧，一定需要到处修缮。";
			next;
			mes "[Ellond Lawrence]";
			mes "不过你也看到了，我们连修理的时间都没有。";
			next;
			mes "[Ellond Lawrence]";
			mes "这里的情况越来越糟，请好好照顾自己，别在地牢里受伤。";
			close;
		case 3:
			mes "[Ellond Lawrence]";
			mes "你在地牢里看到的当然是怪物。还能是什么？";
			next;
			mes "[Ellond Lawrence]";
			mes "这座设施太古老，没有留下任何书面记录。我们只能传承人们口述的内容。";
			next;
			mes "[Ellond Lawrence]";
			mes "可以确定的是，它们就是过去在卢恩·米德加尔特制造混乱的元凶。";
			next;
			mes "[Ellond Lawrence]";
			mes "总之，没有留下任何关于它们的文件，也没有记录它们被指控或判决的罪名。";
			next;
			mes "[Ellond Lawrence]";
		mes "虽然有文件说某位十字军弄丢了记载指控和判决的文件……";
			next;
			mes "[Ellond Lawrence]";
		mes "嗯，地下地牢里的人似乎不太在乎他，所以应该没事。";
			next;
			mes "[Ellond Lawrence]";
		mes "他们中有些人即使服刑期满，也一定还在监狱里。";
			close;
		case 4:
			mes "[Ellond Lawrence]";
		mes "哦，我也听说过那个故事。";
			next;
			mes "[Ellond Lawrence]";
		mes "十字军由各种各样的人组成，其中有些就是像你一样的冒险者。";
			next;
			mes "[Ellond Lawrence]";
		mes "我的朋友说，他看到地下地牢的怪物在外面的世界活动。";
			next;
			mes "[Ellond Lawrence]";
		mes "十字军说他大概是冒险者出身，所以总爱吹牛。";
			next;
			emotion ET_HUK;
			mes "[Ellond Lawrence]";
		mes "别介意，冒险者。不是在说你。他只是满口胡言……";
			next;
			mes "[Ellond Lawrence]";
		mes "我敢保证，外界的怪物和地牢里的怪物一定是不同的生物。";
			next;
			mes "[Ellond Lawrence]";
		mes "它们最多只是有些遥远的关系。";
			close;
		}
	}

OnTouch:
	if (isbegin_quest(5415) == 0) {
		emotion ET_SORRY;
		mes "[Ellond Lawrence]";
		mes "抱歉，这里禁止未经授权的进入。";
		next;
		mes "[Ellond Lawrence]";
		mes "给你带来不便，还请配合。";
		close;
	}
	end;
}

prt_pri00,58,128,4	script	Overwatcher Terketh#ep16	4_M_JOB_HUNTER,{
	if (ep16_royal < 13) {
		npctalk "...Such a disturbance to my training.", "", bc_self;
		end;
	}
	if (ep16_royal == 13) {
		npctalk "天啊！这是什么……", "", bc_self;
		mes "[Terketh]";
		mes "你是从王室过去的记忆出来的吗？";
		mes "既然知道来这里的路，你一定获得了移动许可。";
		next;
		mes "[Terketh]";
		mes "我送你出去。";
		mes "沿楼梯直走就能找到十字军办公室。";
		mes "之后知道该去哪里了吧？";
		erasequest 7695;// Escape from the Past Memories of the Royal Family
		setquest 7696;// What's Next?
		ep16_royal = 14;
		warp "prt_pri00",53,128;
		end;
	}
	mes "[Terketh]";
	mes "你想做什么？";
	next;
	if (select( "前往王室过去的记忆", "前往外面" ) == 2) {
		setpcblock PCBLOCK_NPC, true;
		sleep2 2000;
		npctalk "Well, sure.", "", bc_self;
		sleep2 2000;
		setpcblock PCBLOCK_NPC, false;
		warp "prt_pri00",53,128;
		end;
	}
	setpcblock PCBLOCK_NPC, true;
	sleep2 2000;
	npctalk "Take care. Do not snoop around too much!", "", bc_self;
	sleep2 2000;
	setpcblock PCBLOCK_NPC, false;
	warp "prt_lib",9,28;
	end;
}


// Sector A
prt_prison,243,265,6	script	Prisoner 243AD265#EP161A	4_M_DRAKE,{
	if (checkweight(1301,1) == 0) {
		mes "- 物品太多，无法继续任务。 -";
		close;
	}
	if (isbegin_quest(5415) < 2) {// Restricted Sector
		emotion ET_BLABLA;
		mes "[Prisoner 243AD265]";
	mes "是谁？谁在叫我？";
		next;
	mes "囚犯正在嚎叫。发生什么了吗？";
		close;
	}
	if (BaseLevel < 140) {
		mes "[Prisoner 243AD265]";
	mes "你一定是冒险者吧？嗯……你看起来像个新手。我没看出你有什么魅力。";
		close;
	}
	switch( isbegin_quest(5425) ) {
	case 0:
		emotion ET_SPARK;
		mes "[Prisoner 243AD265]";
	mes "幸会。我已经很久没在这里见到人类了。";
		next;
		mes "[Prisoner 243AD265]";
	mes "你不像那个把我关进来的十字军。看起来你是冒险者……是这样吗？";
		next;
		mes "[Prisoner 243AD265]";
	mes "我已经很久没见到冒险者了。是什么带你来这里？";
		next;
	mes "- 我解释了来这里的原因。-";
		next;
		emotion ET_FRET;
		mes "[Prisoner 243AD265]";
	mes "我以为十字军把他们全释放了，不是吗？看来是我想错了。";
		next;
		mes "[Prisoner 243AD265]";
	mes "我只是以为十字军释放他们，是为了扰乱囚犯平静的休息。";
		next;

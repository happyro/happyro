		next;
		mes "[Lazy]";
		mes "你们的卫队有特殊部队吗？我已经知道答案。";
		next;
		cutin "ep171_as01",0;
		mes "[Aas]";
		mes "是……有。";
		next;
		cutin "16lei_02",2;
		mes "[Lazy]";
		mes "我就知道。VIP 说你们都得到同等待遇。但他不会为贫民窟的人提供安全。";
		mes "你们队伍的人不会失踪。";
		next;
		mes "[Lazy]";
		mes "因为让卫兵消失更麻烦。会引起更多骚动。";
		next;
		mes "[Lazy]";
		mes "有了钱和福利工资，不如让一个来自弱势家庭的人消失，再让他们的声音无人听见，不是更容易吗？";
		npctalk "哇～我告诉过你～很可怕吧～","",bc_self;
		next;
		cutin "ep171_kaya03",0;
		mes "[Kaya]";
		mes "你知道自己在暗示什么吗？全是猜测！";
		next;
		cutin "16lei_01",2;
		mes "[Lazy]";
		mes "你真知道我在想什么？";
		next;
		cutin "ep171_kaya03",0;
		mes "[Kaya]";
		mes "进来自己看看！";
		mes "看看他们为什么从未联系。虽然不知道他们假期做了什么，但我们可以查到他们现在在哪里。";
		next;
		cutin "16lei_02",2;
		mes "[Lazy]";
		mes "哈，这家伙还是这么重视隐私。统计和概率难道不是经济的一部分？为什么这些人离开后再也不联系家里？";
		next;
		select("他们为什么交出工资？");
		cutin "16lei_01",2;
		mes "[Lazy]";
		mes "我们的冒险者问得好。他们几乎都来自贫民窟。雷根贝勒为你提供住宿和餐食，几乎不需要花钱。";
		next;
		cutin "16lei_03",2;
		mes "[Lazy]";
		mes "如果冒险者来自贫困家庭，还要养家，会省下吃饭的钱吗？";
		next;
		select("我会全部寄回去。");
		cutin "ep171_kaya03",0;
		mes "[Kaya]";
		mes "这些给低收入阶层的住宿是雷根贝勒对社会的贡献。我们会尽力！";
		next;
		cutin "16lei_01",2;
		mes "[Lazy]";
		mes "啊哈！是我不够礼貌吗？我们的贵宾生气了~不过冒险者和我去过很多地方，知道这些事。";
		next;
		cutin "16lei_02",2;
		mes "[Lazy]";
		mes "这是非法实验室。你知道什么是非法实验室吗？";
		mes "会用人类进行非法实验？把人当实验鼠？";
		next;
		cutin "ep171_as02",1;
		mes "[Aas]";
		mes "你是不是想太多了。";
		next;
		cutin "16lei_03",2;
		mes "[Lazy]";
		mes "我们的警卫和贵宾没有想象力吗？我知道你不愿看眼前的东西，但看看这里的现实吧。";
		next;
		cutin "16lei_02",2;
		mes "[Lazy]";
		mes "你知道同事们在那天结束前吃了什么、做了什么吗？";
		next;
		cutin "16lei_03",2;
		mes "[Lazy]";
		mes "直到我坚持调查，贵宾才知道员工失踪吗？";
		next;
		cutin "ep171_kaya03",0;
		mes "[Kaya]";
		mes "我仍不能断定他们失踪了。";
		next;
		cutin "16lei_02",2;
		mes "[Lazy]";
		mes "好，我明白了。就称之为问题，而不是失踪人员。这样感觉好些了吗？如果这样更容易，我就这么称呼。你想积极解决这个问题吗？";
		next;
		cutin "ep171_kaya01",0;
		mes "[Kaya]";
		mes "当然。";
		next;
		cutin "16lei_01",2;
		mes "[Lazy]";
		mes "太好了，我就希望你这么说。很高兴你不再生气。敞开心扉~别生气~慢慢呼吸~呼气~";
		next;
		mes "[Lazy]";
		mes "如果你说得对，就去<NAVI>[总部]<INFO>lhz_in01,107,137,0,101,0</INFO></NAVI>看看。";
		completequest 17006;
		setquest 17007;
		close2;
		cutin "",255;
		cloakonnpc "Kaya Tos#171_lhz3",getcharid(0);
		cloakonnpc "Aas#171_lhz3",getcharid(0);
		end;
	}
	if (isbegin_quest(17007) == 1) {
		cutin "16lei_01",2;
		mes "[Lazy]";
		mes "快，进入<NAVI>[总部]<INFO>lhz_in01,107,137,0,101,0</INFO></NAVI>！";
		close3;
	}
	cutin "16lei_01",2;
	mes "[Lazy]";
	mes "雷根贝勒的道路宽阔而闪耀~大家都知道施瓦尔茨瓦尔特共和国~";
	close3;

OnInit:
	questinfo(QTYPE_QUEST,QMARK_YELLOW,"isbegin_quest(17006) == 1");
	end;
}

lhz_in01,107,137,5	script	Staff#171_lhzin	4_F_01,{
	if (isbegin_quest(17007) == 1) {
		mes "[Staff]";
		mes "你好，我能帮你什么？";
		next;
		cloakoffnpc "Kaya Tos#171_lhzin",getcharid(0);
		cloakoffnpc "Aas#171_lhzin",getcharid(0);
		cloakoffnpc "Lazy#171_lhzin",getcharid(0);
		cutin "16lei_01",2;
		mes "[Lazy]";
		mes "我们终于进入雷根贝勒总部。我想 Pat 第一次穿过这扇门时一定松了口气。他接下来去了哪里？";
		sleep2 1500;
		specialeffect EF_DA_SPACE,AREA,"Pat#171_lhzin";
		cloakoffnpc "Pat#171_lhzin",getcharid(0);
		cutin "",255;
		sleep2 1000;
		npctalk "我……我……我……","Pat#171_lhzin",bc_self;
		sleep2 2000;
		npctalk "你好，我能为你做什么？","",bc_self;
		sleep2 2000;
		npctalk "我会在这里工作……我是新人……我该去哪里……","Pat#171_lhzin",bc_self;
		sleep2 2000;
		npctalk "你叫什么名字？","",bc_self;
		sleep2 2000;
		npctalk "我叫 Patrick Kaufmann。","Pat#171_lhzin",bc_self;
		sleep2 2000;
		npctalk "Patrick……Kaufmann。好的，确认无误。","",bc_self;
		sleep2 2000;
		npctalk "我真的被录用了，对吧？","Pat#171_lhzin",bc_self;
		sleep2 2000;
		npctalk "当然。你在新员工名单上。可以去二楼的 OT 听培训。","Staff#rek",bc_self;
		sleep2 2000;
		npctalk "谢谢，谢谢！","Pat#171_lhzin",bc_self;
		sleep2 2000;
		cloakonnpc "Pat#171_lhzin",getcharid(0);
		next;
		cutin "ep171_kaya01",0;
		mes "[Kaya]";
		mes "所有员工都要经过 OT 吗？";
		mes "我以为他们会直接分配到各自部门。";
		next;
		cutin "",255;
		mes "[Staff]";
		mes "啊，是的，你说得对。特殊人才必须先经过 OT，然后才会分配到各自部门。";
		next;
		cutin "ep171_kaya01",0;
		mes "[Kaya]";
		mes "为什么？";
		next;
		cutin "",255;
		mes "[Staff]";
		mes "这是根据他们的^0000FF籍贯^000000制定的制度。许多人不熟悉企业文化。经过多次试错，新员工现在必须经过 OT。";
		npctalk "The exact same treatment, huh?","Lazy#171_lhzin",bc_self;
		unittalk getcharid(3),strcharinfo(0) + "：嘘！小声点！",bc_self;
		next;
		cutin "16lei_01",2;
		mes "[Lazy]";
		mes "去<NAVI>[会议室]<INFO>lhz_in01,162,257,0,101,0</INFO></NAVI>，Pat 就是在那里开始雷根贝勒生活的。";
		completequest 17007;
		setquest 17008;
		close2;
		cutin "",255;
		cloakonnpc "Kaya Tos#171_lhzin",getcharid(0);
		cloakonnpc "Aas#171_lhzin",getcharid(0);
		cloakonnpc "Lazy#171_lhzin",getcharid(0);
		end;
	}
	if (isbegin_quest(17008) == 1) {
		mes "[Staff]";
		mes "我想其他人去了举行会议的<NAVI>[会议室]<INFO>lhz_in01,162,257,0,000,0</INFO></NAVI>。你不该去吗？";
		close;
	}
	mes "[Staff]";
	mes "需要什么帮助吗？";
	close;

OnInit:
	questinfo(QTYPE_QUEST,QMARK_YELLOW,"isbegin_quest(17007) == 1");
	end;
}

lhz_in01,163,258,5	script	Staff#171_lhzin2	4_M_EINMAN,{
	if (isbegin_quest(17008) == 1) {
		setpcblock PCBLOCK_ALL, true;
		specialeffect EF_DA_SPACE,AREA,"Staff#171_lhzin3";
		cloakoffnpc "Staff#171_lhzin3",getcharid(0);
		npctalk "这样一来，新员工的预培训就完成了。","Staff#171_lhzin3",bc_self;
		sleep2 2000;
		npctalk "如果你是新人，可以向负责分配工作的人询问方向。","Staff#171_lhzin3",bc_self;
		sleep2 2000;
		npctalk "设施维护部门，跟我来！","",bc_self;
		sleep2 2000;
		cloakonnpc "Staff#171_lhzin3",getcharid(0);
		specialeffect EF_DA_SPACE,AREA,"Pat#171_lhzin2";
		cloakoffnpc "Pat#171_lhzin2",getcharid(0);
		sleep2 2000;
		npctalk "就是我！","Pat#171_lhzin2",bc_self;
		sleep2 2000;
		npctalk "我现在该做什么？","Pat#171_lhzin2",bc_self;
		sleep2 2000;
		npctalk "我看过你的简历，你很有潜力。记住，要快速且准确。不必过分担心细节。","",bc_self;
		sleep2 2000;
		npctalk "我很有信心！","Pat#171_lhzin2",bc_self;
		sleep2 2000;
		npctalk "我喜欢你的回答，我们需要更多像你这样的人！","",bc_self;
		sleep2 2000;
		cloakonnpc "Pat#171_lhzin2",getcharid(0);
		cloakoffnpc "Lazy#171_lhzin2",getcharid(0);
		cloakoffnpc "Kaya Tos#171_lhzin2",getcharid(0);
		cloakoffnpc "Aas#171_lhzin2",getcharid(0);
		setpcblock PCBLOCK_ALL, false;
		cutin "16lei_01",2;
		mes "[Lazy]";
		mes "向这个人打听消息吧。";
		next;
		mes "[Lazy]";
		mes "你认识 Kaufmann 吗？Patrick Kaufmann。";
		next;
		cutin "",255;
		mes "[Staff]";
		mes "你是谁？";
		next;
		cutin "16lei_03",2;
		mes "[Lazy]";
		mes "副总裁在找 Kaufmann。";
		next;
		cutin "",255;
		mes "[Staff]";
		mes "我明白了，目的是什么？还有……你是谁来着？";
		next;
		cutin "16lei_03",2;
		mes "[Lazy]";
		mes "你是副总裁的秘书？";
		next;
		cutin "",255;
		mes "[Staff]";
		mes "你在说什么？你的秘书被撞到头了吗？听起来像个外人？";
		npctalk "你……是在耍我吗？","",bc_self;
		next;
		cutin "ep171_kaya01",0;
		mes "[Kaya]";
		mes "我在找 Patrick Kaufmann。";
		next;
		cutin "",255;
		mes "[Staff]";
		mes "你是谁……？我以前见过那张脸……你是……？";
		npctalk "Think, come on, think.","",bc_self;
		next;
		cutin "16lei_01",2;
		mes "[Lazy]";
		mes "他是你的副总裁。";
		next;
		cutin "",255;
		mes "[Staff]";
		mes "啊！对，对！！！……副总裁？哦，你好！";
		npctalk "这家伙真的是副总裁吗？","",bc_self;
		npctalk "我已经告诉过你了！我没撒谎。","Lazy#171_lhzin2",bc_self;
		next;
		cutin "ep171_kaya01",0;
		mes "[Kaya]";
		mes "你知道 Patrick Kaufmann 的事吗？";
		next;
		cutin "",255;
		mes "[Staff]";
		mes "Patrick Kaufmann……我认识他。他是我的好朋友。虽然手很粗糙，但工作又快又准。";
		mes "我想让他多留一阵，但他们把他带去了实验室。";
		next;
		cutin "ep171_kaya01",0;
		mes "[Kaya]";
		mes "实验室？是 Regenschirm 吗？";
		next;
		cutin "",255;
		mes "[Staff]";
		mes "是那里。新员工必须在公司工作^0000FF至少整整一年^000000，才能调往其他部门或工作地点，除非获得^0000FF特殊申请。^000000";
		next;
		mes "[Staff]";
		mes "但我为什么要先派新员工？即使请求来自上级，我也忽略了。不过这里仍有一些新员工被派往其他地方。";
		next;
		cutin "ep171_kaya01",0;
		mes "[Kaya]";
		mes "为什么？";
		next;
		cutin "",255;
		mes "[Staff]";
		mes "你看……我需要更多人手进行维修。总有东西损坏，所以一直需要更多劳动力。不过最近，";
		mes "^0000FF申请的劳动力多了很多。^000000";
		npctalk "每天总是把最优秀的员工派走，也有点麻烦。","",bc_self;
		next;
		cutin "16lei_01",2;
		mes "[Lazy]";
		mes "你知道为什么征调了这么多人吗？";
		npctalk "你知道为什么征召了这么多人吗？","Lazy#171_lhzin2,",bc_self;
		next;
		cutin "",255;
		mes "[Staff]";
		mes "我不确定。我们部门很多人工作时受伤，而新员工都很强。";
		mes "他们只挑选^0000FF非常擅长工作的人。^000000";
		npctalk "他们就像幽灵一样，刚到这里就会被带走。","",bc_self;
		next;
		mes "[Staff]";
		mes "但如果受到上级压力，你就必须服从并交出人手，对吧？";
		next;
		cutin "ep171_kaya01",0;
		mes "[Kaya]";
		mes "他们被送去了哪个实验室？";
		next;
		cutin "",255;
		mes "[Staff]";
		mes "附属实验室。哦，你想去吗？我有一阵子没去过了，进去很难。如果不介意，能把人送回这里吗？";
		mes "总之请小心，那是危险的地方。";
		next;
		cutin "16lei_01",2;
		mes "[Lazy]";
		mes "哦……除非获得^0000FF特殊申请^000000，至少一年内不能调动。";
		mes "但 Pat 两个理由都不符合。那里真的是实验室吗？";
		next;
		cutin "16lei_02",2;
		mes "[Lazy]";
		mes "你知道这位 VIP 吗？文件里有关于这件事的内容吗？为什么实验室只接收健康的你们？";
		npctalk "哦哦～原因是什么～我太好奇了～","Lazy#171_lhzin2",bc_self;
		next;
		cutin "ep171_kaya01",0;
		mes "[Kaya]";
		mes "我需要知道他们为什么违反合同规定。";
		next;
		cutin "ep171_as01",1;
		mes "[Aas]";
		mes "我负责 Regenschirm，但从没见过 Patrick Kaufmann。";
		next;
		cutin "16lei_01",2;
		mes "[Lazy]";
		mes "是吗？你现在也开始好奇了，对吧！";
		next;
		cutin "ep171_as01",1;
		mes "[Aas]";
		mes "我来带路，跟我走。我们去 <NAVI>[Regenschirm]<INFO>rgsr_in,157,84,0,101,0</INFO></NAVI>。";
		completequest 17008;
		setquest 17009;
		close2;
		cutin "",255;
		cloakonnpc "Lazy#171_lhzin2",getcharid(0);
		cloakonnpc "Kaya Tos#171_lhzin2",getcharid(0);
		cloakonnpc "Aas#171_lhzin2",getcharid(0);
		end;
	}
	if (isbegin_quest(17009) == 1) {
		mes "[Staff]";
		mes "他们正在<NAVI>[实验室]<INFO>rgsr_in,157,84,0,000,0</INFO></NAVI>等你，你不也该去吗？";
		close;
	}
	mes "[Staff]";
		mes "好像没有空位了。";
	close;

OnInit:
	questinfo(QTYPE_QUEST,QMARK_YELLOW,"isbegin_quest(17008) == 1");
	end;
}

lhz_in01,80,210,5	script	Secretary#171_lhzin	4_M_RUSMAN1,{
	if (isbegin_quest(17011) == 1) {
		mes "[Secretary]";
		mes "嘿，你要去哪里！";
		next;
		select("你是在和我们说话吗？");
		cloakoffnpc "Lazy#171_lhzin3",getcharid(0);
		cloakoffnpc "Kaya Tos#171_lhzin3",getcharid(0);
		cloakoffnpc "Aas#171_lhzin3",getcharid(0);
		cutin "16lei_01",2;
		mes "[Lazy]";
		mes "冒险者，我们快走吧？一起走。";
		npctalk "别忘了这里有前辈，所以注意你的行为。","Lazy#171_lhzin3",bc_self;
		next;
		cutin "",255;
		mes "[Secretary]";
		mes "你一路来到办公室，发生什么事了？你把我一个人留在这里，然后突然消失。";
		mes "你为什么偷偷进来？";
		unittalk getcharid(3),strcharinfo(0) + "：哦，你不是在和我说话。",bc_self;
		npctalk "这里谁会和你这样的冒险者说话？","Lazy#171_lhzin3",bc_self;
		next;
		cutin "16lei_03",2;
		mes "[Lazy]";
		mes "你知道我旁边这位先生是谁吗？";
		next;
		cutin "ep171_kaya01",0;
		mes "[Kaya]";
		mes "是的，他是我的秘书。";
		next;
		cutin "16lei_01",2;
		mes "[Lazy]";
		mes "啊！很高兴见到你。我叫 Daisy，是副总裁的老朋友。";
		next;
		cutin "",255;
		mes "[Gray]";
		mes "你好。我叫 Gray Earl。";
		mes "我通常不会出现在这种地方，我们应该去副总裁办公室继续会议。";
		next;
		cutin "ep171_kaya01",0;
		mes "[Kaya]";
		mes "不用，这里就很好。你到底为什么在这里？在等人吗？";
		next;
		cutin "",255;
		mes "[Gray]";
		mes "是的，我注意到副总裁缺席有些奇怪，所以出来看看发生了什么。";
		next;
		cutin "ep171_kaya01",0;
		mes "[Kaya]";
		mes "如果你继续那样在外面等，不觉得看起来更可疑吗？";
		next;
		cutin "",255;
		mes "[Gray]";
		mes "所以你是故意躲起来的。能告诉我这是怎么回事吗？";
		mes "为什么要如此保密？";
		npctalk "约定就是要隐藏起来。","Lazy#171_lhzin3",bc_self;
		next;
		cutin "ep171_kaya01",0;
		mes "[Kaya]";
		mes "那是我们的计划。我正在和这些人合作。";
		next;
		cutin "",255;
		mes "[Gray]";
		mes "和他们……合作……？！";
		mes "我没想过我们会再次和这些人成为朋友。";
		next;
		cutin "16lei_03",2;
		mes "[Lazy]";
		mes "为什么？我们不能成为朋友吗？你！你得解释清楚！";
		next;
		cutin "",255;
		mes "[Gray]";
		mes "你看起来没那么老。";
		npctalk "哦，你看起来比我年轻？啊哈哈哈！我好像真的开始喜欢这家伙了？","Lazy#171_lhzin3",bc_self;
		next;
		cutin "ep171_kaya01",0;
		mes "[Kaya]";
		mes "你不必知道更多。知道得越少越好。调查结束后我们会告诉你。";
		next;
		cutin "",255;
		mes "[Gray]";
		mes "是，长官。";
		unittalk getcharid(3),strcharinfo(0) + "：你确定保守秘密是个好主意吗？",bc_self;
		sleep2 2000;

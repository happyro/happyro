pub_cat,109,71,3	script	Kaya Tos#171_cat	4_EP17_KAYA,{
	if (isbegin_quest(17001) == 1) {
		mes "["+ strcharinfo(0) + "]";
		mes "你好，我回来了，一切还好吗？";
		next;
		cutin "ep171_kaya01",2;
		mes "[Kaya]";
		mes "当然，我可以为帮助取回实验室的人抽出时间。我真的很感激。";
		mes "但你为什么来找我？";
		next;
		cutin "",255;
		mes "-你向 Kaya 说明了你和 Lazy 讨论的内容。-";
		next;
		cutin "ep171_kaya03",2;
		mes "[Kaya]";
		mes "我明白你的意思，但 Daisy 的逻辑^0000CD太过分了^000000。官方文件的^0000CD可信度^000000不容怀疑，这绝不可能。";
		next;
		cutin "ep171_kaya01",2;
		mes "[Kaya]";
		mes "我不打算再和你争论这件事，所以我会去找负责人。";
		next;
		cloakonnpc "Lazy#171_cat2",getcharid(0);
		cloakoffnpc "Lazy#171_cat",getcharid(0);
		cutin "16lei_02",0;
		mes "[Lazy]";
		mes "谁是负责人？";
		mes "是我面前这个人吗？";
			npctalk "你在看哪里？那里没人。","Lazy#171_cat",bc_self;
		next;
		cutin "16lei_01",0;
		mes "[Lazy]";
		mes "总统把这件事的全部权限交给了我。";
		next;
		cutin "ep171_kaya03",2;
		mes "[Kaya]";
		mes "那你到底是谁？";
		next;
		cutin "16lei_02",0;
		mes "[Lazy]";
		mes "我之前不是告诉过你了吗？副总统记性不好吗？";
		next;
		cutin "ep171_kaya03",2;
		mes "[Kaya]";
		mes "我为什么要相信一个给我假名字的人？";
		next;
		cutin "16lei_03",0;
		mes "[Lazy]";
		mes "名字只是名字。如果我叫‘Shit’，难道和副总统说话时就会变成 Shit 吗？";
		next;
		select("偷听是你的爱好吗？");
		mes "[Lazy]";
		mes "为什么？我不就该在这里吗？";
		mes "听听有什么不好？别理他们，不值得浪费时间。";
		unittalk getcharid(3),strcharinfo(0)+ "：让我来处理！",bc_self;
		next;
		cutin "",255;
		cloakonnpc "Lazy#171_cat",getcharid(0);
		cloakoffnpc "Lazy#171_cat2",getcharid(0);
		mes "["+ strcharinfo(0) + "]";
		mes "正如 Lazy 所说……即使你叫 Lazy 为 Shit，Lazy 仍然是 Lazy。";
		next;
		mes "["+ strcharinfo(0) + "]";
		mes "即使有人把 Lazy 介绍成 Shit，你也要一辈子把他当成 Shit 吗？";
		next;
		mes "["+ strcharinfo(0) + "]";
		mes "真正重要的是，如果你不说出发生了什么，就无法得到他们的合作。";
		next;
		mes "["+ strcharinfo(0) + "]";
		mes "副总统，这一切都关系到企业。一次性消除这些疑虑，展现企业更好的形象，不是很好吗？";
		next;
		cutin "ep171_kaya01",2;
		mes "[Kaya]";
		mes "我明白你的意思，但你错了。我们告诉你的是真相，而你却认为我们在撒谎。";
		next;
		cutin "",255;
		mes "["+ strcharinfo(0) + "]";
		mes "我不知道 Lazy 知道的一切，但他似乎比你更了解情况，副总统。";
		next;
		mes "["+ strcharinfo(0) + "]";
		mes "Lazy 不是会无缘无故花时间调查这些事情的人。";
		unittalk getcharid(3),strcharinfo(0)+ "：如果你想建立对企业的信任，请重新考虑。",bc_self;
		next;
		mes "["+ strcharinfo(0) + "]";
		mes "Lazy 说他无法相信副总统提供的结果，但你也不相信 Reiji 提供的结果，对吧？";
		next;
		cutin "ep171_kaya01",2;
		mes "[Kaya]";
		mes "我们更愿意相信自己的结果，而不是 Daisy 的结果。";
		next;
		cutin "",255;
		mes "["+ strcharinfo(0) + "]";
		mes "那这样如何？你们两个既然互不信任，就一起亲自去确认吧？";
		next;
		cutin "ep171_kaya01",2;
		mes "[Kaya]";
		mes "一起调查？";
		next;
		cutin "",255;
		mes "["+ strcharinfo(0) + "]";
		mes "正如 Lazy 所说，他不相信你的调查结果。";
		mes "既然你们无法相信彼此的结果，为什么不从头开始？";
		next;
		mes "["+ strcharinfo(0) + "]";
		mes "如果你们一起调查报告之间的差异，就能确定哪个准确。这里必须做出妥协。";
		next;
		cutin "ep171_kaya02",2;
		mes "[Kaya]";
		mes "这理由成立。但我也必须去吗？我更愿意和你谈。";
		next;
		cloakoffnpc "Lazy#171_cat",getcharid(0);
		cloakonnpc "Lazy#171_cat2",getcharid(0);
		cutin "16lei_02",0;
		mes "[Lazy]";
		mes "你能相信我目前调查的结果吗？你仍然不相信，因为你认定自己的文件是正确的。";
		next;
		cutin "16lei_03",0;
		mes "[Lazy]";
		mes "是啊，不会的。我就知道。";
			npctalk "真相令人难以承受。","Lazy#171_cat",bc_self;
		next;
		select("你介意吗？");
		mes "[Lazy]";
		mes "我也没办法。和他们一起只是在浪费时间，何必呢？怎么了？你没话说吗？";
		next;
		select("请等一下，Lazy");
		mes "[Lazy]";
		mes "我没有太多时间等这种无聊的事。";
		next;
		cloakonnpc "Lazy#171_cat",getcharid(0);
		cloakoffnpc "Lazy#171_cat2",getcharid(0);
		cutin "ep171_kaya01",2;
		mes "[Kaya]";
		mes "无论检查多少次，结果都一样。我们还有很多其他工作要做。";
		next;
		cutin "",255;
		mes "["+ strcharinfo(0) + "]";
		mes "副总统，你相信企业里的所有人，对吧？但现在会发生什么？";
		mes "照目前的情况，没人会相信你的调查结果。";
		next;
		mes "["+ strcharinfo(0) + "]";
		mes "如果联合调查后发现 Lazy 错了，你只是浪费了一点时间，但对副总统来说，这是个大问题。";
		next;
		cutin "ep171_kaya01",2;
		mes "[Kaya]";
		mes "……请给我几分钟考虑一下。";
		completequest 17001;
		setquest 17002;
		close3;
	}
	if (isbegin_quest(17002) == 1) {
		cutin "ep171_kaya01",2;
		mes "[Kaya]";
		mes "Daisy 的意见很难接受，但背后的逻辑……是正确的。我想试试看。";
		close3;
	}
	cutin "ep171_kaya01",2;
	mes "[Kaya]";
	mes "你不是来找 Daisy 的吗？";
	close3;

OnInit:
	cloakonnpc();
	questinfo(QTYPE_QUEST,QMARK_YELLOW,"isbegin_quest(17001) == 1");
	end;
}

//= RUDUS MAP
sp_rudus,184,360,5	script	Elena Volkova#171_rudus	4_F_ELENA,{
	if (isbegin_quest(7851) == 1) {
		cutin "162elena_01",2;
		mes "[Elena Volkova]";
		mes "哦，这里真安静。";
		mes "你脸色很苍白。";
		mes "...";
		mes "开玩笑的。我想我需要更多时间好好调查这片区域。";
		next;
		select("有什么问题吗？");
		mes "[Elena Volkova]";
		mes "他们说工厂关闭后才建起了屏障。";
		mes "但这里总让人感觉不对劲。";
		next;
		mes "[Elena Volkova]";
		mes "总之，我应该越过屏障，为 Tes 获取有用的信息？";
		mes "我的队员正在先确保入口安全。你打开后，就去看看另一边。";
		next;
		mes "[Elena Volkova]";
		mes "还记得 Lucky 吗？我把他带来了，去问问他进展吧。";
		erasequest 7851;
		setquest 7852;
		close3;
	}
	if (isbegin_quest(7852) == 1) {
		cutin "162elena_01",2;
		mes "[Elena Volkova]";
		mes "我需要查清屏障后面有什么。";
		mes "如果什么都没有，我就离开。但如果那里确实有东西，我要不要使出全力？";
		mes "当然，我更喜欢后者。";
		close3;
	}
	if (isbegin_quest(7858) == 0) {
			npctalk "Elena：嘿嘿嘿。不管这里有什么，我希望它会是一场挑战。","",bc_self;
		end;
	}
	if (isbegin_quest(7858) < 2) {
		if (checkquest(7858,HUNTING) != 2) {
			cutin "162elena_01",2;
			mes "[Elena Volkova]";
		mes "你调查过屏障后面了吗？";
		mes "如果发现可疑之处，就交给我！";
			close3;
		}
		cutin "162elena_01",2;
		mes "[Elena Volkova]";
		mes "现在终于轮到 Elena Volkova 大显身手了！";
		mes "冒险者，回到子弹喵那里，告诉 Tes 这里发生了什么。";
		next;
		mes "[Elena Volkova]";
		mes "不管你报告还是别人报告，都没有区别。";
		mes "这里不过是一座垃圾场。";
		completequest 7858;
		setquest 7859;
		getitem 25723,15;
		getexp 800000,800000;
		close3;
	}
	if (isbegin_quest(7859) == 1) {
		cutin "162elena_01",2;
		mes "[Elena Volkova]";
		mes "USU 会想办法处理的，你先向 Tes 汇报情况。";
		mes "与此同时，我得去帮助我的队员。";
		close3;
	}
	cutin "162elena_01",2;
	mes "[Elena Volkova]";
	mes "这里不过是废弃处理设施。";
	mes "他们把失败的实验品都扔在这里。";
	next;
	cutin "162elena_02",2;
	mes "[Elena Volkova]";
	mes "要是那些家伙能离开屏障就好了。";
	mes "我今天还没训练呢！";
	close3;

OnInit:
	questinfo(QTYPE_QUEST,QMARK_YELLOW,"isbegin_quest(7851) == 1");
	questinfo(QTYPE_QUEST,QMARK_YELLOW,"checkquest(7858,HUNTING) == 2");
	end;
}


moc_fild11,57,138,0	script	Private Jeremy#hunt	707,{
	if (checkquest(60140) != -1) {
		if (checkquest(60140,HUNTING) != 2 ) {
			mes "[杰里米列兵]";
			mes "你已经猎杀 50 只石像了吗？";
			next;
			switch(select("是:否:我想退出")) {
			case 1:
				mes "[杰里米列兵]";
				mes "嗯，我觉得你还没猎杀 50 只……";
				close;
			case 2:
				mes "[杰里米列兵]";
				mes "记住，我需要你帮忙猎杀石像，去猎杀 50 只吧。";
				close;
			case 3:
				mes "[杰里米列兵]";
				mes "你确定要停止猎杀吗？";
				mes "你取得的进度都会被清除。";
				next;
				switch(select("是:否")) {
				case 1:
					mes "[杰里米列兵]";
					mes "好吧，改变主意后再回来。";
					erasequest 60140;
					close;
				case 2:
					mes "[杰里米列兵]";
					mes "请猎杀 50 只石像。";
					close;
				}
			}
		}
		else {
			mes "[杰里米列兵]";
			mes "太厉害了，你完成得真快。";
			getexp 14000,9000;
			erasequest 60140;
			close;
		}
	}
	if (checkquest(60141) != -1) {
		if (checkquest(60141,HUNTING) != 2 ) {
			mes "[杰里米列兵]";
			mes "你已经猎杀 50 只石像了吗？";
			next;
			switch(select("是:否:我想退出")) {
			case 1:
				mes "[杰里米列兵]";
				mes "嗯，我觉得你还没猎杀 100 只……";
				close;
			case 2:
				mes "[杰里米列兵]";
				mes "记住，我需要你帮忙猎杀石像，去猎杀 100 只吧。";
				close;
			case 3:
				mes "[杰里米列兵]";
				mes "你确定要停止猎杀吗？";
				mes "你取得的进度都会被清除。";
				next;
				switch(select("是:否")) {
				case 1:
					mes "[杰里米列兵]";
					mes "好吧，改变主意后再回来。";
					erasequest 60141;
					close;
				case 2:
					mes "[杰里米列兵]";
					mes "请猎杀 100 只石像。";
					close;
				}
			}
		}
		else {
			mes "[杰里米列兵]";
			mes "太厉害了，你完成得真快。";
			getexp 14000,9000;
			getexp 14000,9000;
			erasequest 60141;
			close;
		}
	}
	if (checkquest(60142) != -1) {
		if (checkquest(60142,HUNTING) != 2 ) {
			mes "[杰里米列兵]";
			mes "你已经猎杀 150 只石像了吗？";
			next;
			switch(select("是:否:我想退出")) {
			case 1:
				mes "[杰里米列兵]";
				mes "嗯，我觉得你还没猎杀 150 只……";
				close;
			case 2:
				mes "[杰里米列兵]";
				mes "记住，我需要你帮忙猎杀石像，去猎杀 150 只吧。";
				close;
			case 3:
				mes "[杰里米列兵]";
				mes "你确定要停止猎杀吗？";
				mes "你取得的进度都会被清除。";
				next;
				switch(select("是:否")) {
				case 1:
					mes "[杰里米列兵]";
					mes "好吧，改变主意后再回来。";
					erasequest 60142;
					close;
				case 2:
					mes "[杰里米列兵]";
					mes "请猎杀 150 只石像。";
					close;
				}
			}
		}
		else {
			mes "[杰里米列兵]";
			mes "太厉害了，你完成得真快。";
			getexp 14000,9000;
			getexp 14000,9000;
			getexp 14000,9000;
			erasequest 60142;
			close;
		}
	}
	//for minimum level
	if (BaseLevel > 24) {
		//for maximum level
		if (BaseLevel < 61) {
			mes "[杰里米列兵]";
			mes "市民，你好！";
			mes "你愿意怎样帮助我？";
			next;
			switch(select("当然:不了")) {
			case 1:
				mes "[杰里米列兵]";
				mes "谢谢！我非常感激。";
				next;
				switch(select("收集物品:猎杀石像:取消")) {
				case 1:
					// Item turn in
					mes "[杰里米列兵]";
					mes "梦罗克卫兵训练需要 ^FF0000石心^000000。";
					next;
					switch(select("我有石心:你需要什么？")) {
					case 1:
						if (countitem(953) > 24) {
							mes "[杰里米列兵]";
							mes "梦罗克卫兵感谢你，市民。";
							delitem 953,25; //Stone_Heart
							getexp 14000,9000;
							close;
						}
						else {
							mes "[杰里米列兵]";
							mes "看来你带的还不够。";
							next;
							mes "[杰里米列兵]";
							mes "梦罗克卫兵训练需要 ^FF000025 个石心^000000。";
							close;
						}
					case 2:
						mes "[杰里米列兵]";
						mes "梦罗克卫兵训练需要 ^FF000025 个石心^000000。";
						close;
					}
				case 2:
					// Kill Count Quest
					mes "[杰里米列兵]";
					mes "啊，好吧，我想你可以猎杀一些石像来帮我。";
					mes "你想猎杀多少？";
					next;
					switch(select("50 只石像:100 只石像:150 只石像")) {
					case 1:
						mes "[杰里米列兵]";
						mes "完成任务后回来，我会给你小奖励。";
						setquest 60140;
						close;
					case 2:
						mes "[杰里米列兵]";
						mes "完成任务后回来，我会给你小奖励。";
						setquest 60141;
						close;
					case 3:
						mes "[杰里米列兵]";
						mes "完成任务后回来，我会给你小奖励。";
						setquest 60142;
						close;
					}
				case 3:
					mes "[杰里米列兵]";
					mes "改变主意后请回来。";
					close;
				}
			case 2:
				mes "[杰里米列兵]";
				mes "改变主意后请回来。";
				close;
			}
		}
		else {
			mes "[杰里米列兵]";
			mes "市民，你好！";
			next;
			mes "[杰里米列兵]";
			mes "请不要打扰我为梦罗克卫兵执行的任务。";
			close;
		}
	}
	else {
		mes "[杰里米列兵]";
		mes "市民，这里很危险。";
		close;
	}
}



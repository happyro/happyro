					}
				case 2:
					set $@gdeventv_a1,0;
					set $@gdevents_a$,"";
					emotion ET_CRY;
					mes "[矮人]";
				mes "啊……";
					close;
				}
			}
		}
		else {
			mes "[Morestone]";
			mes "我，莫尔斯通，已经与"+$@gdevents_a$+"公会结成同盟。";
			mes "嗯，你不是公会成员。";
			mes "能请你代我向他们问好吗？";
			close;
		}
	}
	else {
		if ($@gdevents_a$ == .@chk_yourgdname$) {

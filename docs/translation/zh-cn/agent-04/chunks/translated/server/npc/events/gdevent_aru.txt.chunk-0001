//===== rAthena Script ======================================= 
//= Guild dungeon event, Arunafeltz.
//===== By: ================================================== 
//= L0ne_W0lf
//===== Current Version: ===================================== 
//= 1.2
//===== Compatible With: ===================================== 
//= rAthena Project
//===== Description: ========================================= 
//= Guild dungeon event, Arunafeltz. Retrieve Morestone's
//= pickaxe from Kublin.
//===== Additional Comments: =================================
//= 1.0 First version
//= 1.1 Changed spawn timer to 1 hour. [L0ne_w0lf]
//= 1.2 Added GM management function. [Euphy]
//============================================================

arug_dun01,1,1,1	script	Monster Controler#aru_gd	81,{
OnInit:
	donpcevent "Monster Controler1#aru::OnKill";
	initnpctimer;
	end;

OnTimer3600000:
	donpcevent "Monster Controler1#aru::OnEnable";
	mapannounce "arug_dun01", "库布林：啊！",bc_map,"0x99CC00";
	mapannounce "arug_dun01", "莫尔斯通：站住！你这个小偷！",bc_map,"0x99CC00";
	stopnpctimer;
	end;
}

arug_dun01,1,2,1	script	Monster Controler1#aru	81,{
OnEnable:
	set .@callwhere,rand(1,4);
	if (.@callwhere == 1) {
		monster "arug_dun01",150,340,"Kublin",1980,1,"Monster Controler1#aru::OnMyMobDead";
	}
	else if (.@callwhere == 2) {
		monster "arug_dun01",232,293,"Kublin",1980,1,"Monster Controler1#aru::OnMyMobDead";
	}
	else if (.@callwhere == 3) {
		monster "arug_dun01",156,167,"Kublin",1980,1,"Monster Controler1#aru::OnMyMobDead";
	}
	else {
		monster "arug_dun01",243,56,"Kublin",1980,1,"Monster Controler1#aru::OnMyMobDead";
	}
	end;

OnKill:
	killmonster "arug_dun01","Monster Controler1#aru::OnMyMObDead";
	end;

OnMyMobDead:
	if (mobcount("arug_dun01","Monster Controler1#aru::OnMyMObDead") == 0) {
		mapannounce "arug_dun01", "库布林：啊！",bc_map,"0x99CC00";
		mapannounce "arug_dun01", "莫尔斯通： 我好像听到库布林在尖叫！！是谁？库布林怎么了？嘿，你！",bc_map,"0x99CC00";
		donpcevent "Dwarf#aru_gd::OnEnable";
	}
	end;
}

arug_dun01,199,195,5	script	Dwarf#aru_gd	826,{
	if (getcharid(2) == 0) {
		mes "[矮人]";
		mes "嘿，你看到一个丑陋的哥布林经过吗？他偷了我的东西！";
		close;
	}
	set .@chk_urquest,checkquest(2143,PLAYTIME);
	set .@chk_yourgdname$,getguildname(getcharid(2));
	if ($@gdeventv_a1 == 0) {
		if ($@gdevents_a$ == "") {
			set $@gdeventv_a1,1;
			set $@gdevents_a$,.@chk_yourgdname$;
			mes "[矮人]";
			mes "帮帮我！";
			mes "请帮帮我！";
			next;
			switch(select("发生了什么？:算了。")) {
			case 1:
				mes "[矮人]";
				mes "我是莫尔斯通，收集稀有宝石。";
				next;
				mes "[Morestone]";
				mes "旅途中有人告诉我瓦尔弗雷娅和尼德霍格有很多宝石，所以我来到了这里。";
				mes "但这里的土壤很难挖掘。 幸好，我的^3131FF镐^000000从不让我失望！";
				next;
				select("镐！");
				mes "[Morestone]";
				mes "是的，我心爱的镐！";
				mes "我总是随身携带，你知道吗？";
				next;
				mes "[Morestone]";
				mes "我们一起在这里工作。";
				mes "几天后，我们终于发现了东西！";
				next;
				select("奇怪的东西？？");
				mes "[Morestone]";
				mes "不，但它价值不菲。";
				mes "但我们没时间庆祝。 突然出现一只怪物，偷走了我的镐。";
				mes "它的名字是^3131FFKublin^000000!";
				next;
				mes "[Morestone]";
				mes "他偷走了我的镐！";
				mes "没有它我活不下去……";
				next;
				if (countitem(6010) > 0) {
					mes "[" + strcharinfo(0) + "]";
					mes "这是你一直在找的镐吗？";
					next;
					mes "[Morestone]";
					mes "你找到了我的镐？";
					mes "请给我看看！";
					next;
					mes "[Morestone]";
					mes "天啊！你把它还给我了！";
					mes "我珍贵的镐，我以为永远失去你了。";
					next;
					mes "[Morestone]";
					mes "你真棒！你属于哪个公会？";
					mes "是重力公会还是水星公会？";
					next;
					mes "[" + strcharinfo(0) + "]";
					mes "我是 ^3131FF"+.@chk_yourgdname$+"^.";
					next;
					mes "[Morestone]";
					mes "哦……那个公会将得到我最大的尊敬。";
					next;
					mes "[Morestone]";
					mes "哦！朋友，非常感谢你的帮助。";
					mes "作为奖励，我告诉你一个最近发现的神秘区域。";
					next;
					select("神秘区域？");
					mes "[Morestone]";
					mes "没错，我在这里挖掘时发现了它。";
					mes "看起来是为某种特殊用途建造的，但那里没有宝石，所以我不感兴趣。";
					next;
					mes "[Morestone]";
					mes "比起独自前往，我觉得和朋友一起去更有趣……";
					next;
					mes "[Morestone]";
					mes "如果你愿意，我可以带^3131FF你和公会成员^000000探索那里。";
					mes "现在要去吗？";
					next;
					switch(select("等等！我还没准备好。:我们走！")) {
					case 1:
						set $@gdeventv_a1,0;
						set $@gdevents_a$,"";
						mes "[Morestone]";
						mes "慢慢来，找个地方集合朋友。";
						close;
					case 2:
						mes "[Morestone]";
						mes "好！我们走。";
						mes "如果你的朋友之后再来找我，我会再次带他们去那里。";
						mes "别忘了，矮人是知恩图报的种族！哈哈哈！";
						delitem 6010,1; //Pickaxe
						set $@gdeventv_a1,1;
						set $@gdevents_a$,.@chk_yourgdname$;
						close2;
						setquest 2144;
						warp "arug_que01",103,133;
						end;
					}
				}
				else {
					set $@gdeventv_a1,0;
					set $@gdevents_a$,"";
					mes "[Morestone]";
					mes "我告诉你怎么找到他。";
					mes "库布林戴着可笑的金帽子，很容易认出他。";
					close;
				}
			case 2:
				set $@gdeventv_a1,0;
				set $@gdevents_a$,"";
				emotion ET_CRY;
				mes "[矮人]";
				mes "啊……";
				close;
			}
		}
		else if ($@gdevents_a$ == .@chk_yourgdname$) {
			set .@chk_urquest1,checkquest(2144);
			if ((.@chk_urquest1 == 0) || (.@chk_urquest1 == 1)) {
				mes "[Morestone]";
				mes "我，莫尔斯通，已经与"+$@gdevents_a$+"公会结成同盟。";
				mes "哦，你是公会成员。";
				mes "想去神秘区域吗？";
				next;
				switch(select("我们走。:不了，谢谢。")) {
				case 1:
					mes "[Morestone]";
				mes "希望你玩得开心，我的朋友。";
					close2;
					warp "arug_que01",103,133;
					end;
				case 2:
					mes "[Morestone]";
				mes "如果需要我的帮助，尽管开口。";
				mes "啊！别忘了，我讨厌怪物！所以我不想看到它们。最好请我帮别的忙。";
					close;
				}
			}
			else {
				set $@gdeventv_a1,1;
				set $@gdevents_a$,.@chk_yourgdname$;

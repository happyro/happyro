		cutin "ep172_beta",2;
		mes "[Chirp]";
		mes "仓库^0000CD最上方^000000有通往地下的楼梯。下楼检查下面的情况。不要碰那里的任何东西。";
		close3;
	}
	if (ep17_2_chirp == 3) {
		cutin "ep172_beta",2;
		mes "[Chirp]";
		mes "检查过了吗？地下情况如何？";
		next;
		cutin "",255;
		select( "门锁着。" );
		cutin "ep172_beta",2;
		mes "[Chirp]";
		mes "锁着？但自动人偶怎么进去的？这才是更大的问题。这证明宅邸的安保有漏洞，入侵者也从唯一入口以外的通道进入了。";
		next;
		mes "[Chirp]";
		mes "最好检查一下……你说它锁住了。我无法强行进去，需要找到紧急钥匙。";
		next;
		mes "[Chirp]";
		mes "它原本只为主人准备，但主人下到地下室后留下了一把紧急钥匙，只有主人出事或发生危险紧急情况时才能使用。";
		next;
		mes "[Chirp]";
		mes "那就算是危险的紧急情况。";
		next;
		cutin "",255;
		select( "把它给我。" );
		cutin "ep172_beta",2;
		mes "[Chirp]";
		mes "你喜欢寻宝吗？或者你有寻宝的特殊才能？如果没有，希望你从现在开始拥有。";
		next;
		mes "[Chirp]";
		mes "主人在仓库藏了^0000CD三把紧急钥匙^000000。这里还留着许多损坏的自动人偶。";
		next;
		cutin "",255;
		select( "也就是说……" );
		cutin "ep172_beta",2;
		mes "[Chirp]";
		mes "没错。又到了你享受乐趣的时候。我很高兴能再次这样帮助你。";
		next;
		mes "[Chirp]";
		mes "按照我指出的线索找齐所有紧急钥匙后，就能下到地下室。用钥匙打开通往地下室的门。";
		next;
		mes "[Chirp]";
		mes "<NAVI>[旋转的世界]<INFO>ba_2whs01,110,217,0,101,0</INFO></NAVI>。他说所有真相都在下面。试着找找有这种物品的地方。";
		next;
		mes "[Chirp]";
		mes "他还说，在那个<NAVI>[地方]<INFO>ba_2whs01,110,217,0,101,0</INFO></NAVI>呼吸会被冻结，据说一切永远保持不变。";
		next;
		mes "[Chirp]";
		mes "最后，他说所有空气都必须是空洞的。他还说那里会消耗大量能量。我甚至猜不到<NAVI>[这样的地方]<INFO>ba_2whs01,110,217,0,101,0</INFO></NAVI>在哪里。";
		next;
		mes "[Chirp]";
		mes "我不知道这些线索是什么意思，但你和我们的主人一样都是人类。也许你能解读它们。";
		next;
		mes "[Chirp]";
		mes "我不指望你能解读大师意志中的哪怕一句话，但是……如果不知道，就到处找找。然后回来。";
		next;
		mes "[Chirp]";
		mes "哦，我忘了告诉你这件事。";
		mes "仓库很危险，所以一定要小心。明白了吗？";
		ep17_2_chirp = 4;
		erasequest 17344;
		getitem 1000103,3;
		setquest 17345;
		setquest 17346;
		setquest 17347;
		close3;
	}
	if (ep17_2_chirp == 4) {
		cutin "ep172_beta",2;
		mes "[Chirp]";
		mes "<NAVI>[旋转的世界]<INFO>ba_2whs01,110,217,0,101,0</INFO></NAVI>。他说所有真相都在下面。试着找找有这种物品的地方。";
		next;
		mes "[Chirp]";
		mes "他还说，在那个<NAVI>[地方]<INFO>ba_2whs01,110,217,0,101,0</INFO></NAVI>呼吸会被冻结，据说一切永远保持不变。";
		next;
		mes "[Chirp]";
		mes "最后，他说所有空气都必须是空洞的。他还说那里会消耗大量能量。我甚至猜不到<NAVI>[这样的地方]<INFO>ba_2whs01,110,217,0,101,0</INFO></NAVI>在哪里。";
		next;
		mes "[Chirp]";
		mes "我不知道这些线索是什么意思，但你和我们的主人一样都是人类。也许你能解读它们。";
		next;
		mes "[Chirp]";
		mes "我不指望你能解读大师意志中的哪怕一句话，但是……如果不知道，就到处找找。然后回来。";
		close3;
	}
	if (ep17_2_chirp < 11) {
		cutin "ep172_beta",2;
		mes "[Chirp]";
		mes "你检查地下情况了吗？";
		mes "你觉得怎么样？我明白了……你还没检查过。我会等你的。";
		close3;
	}
	if (ep17_2_chirp == 11) {
		cutin "ep172_beta",2;
		mes "[Chirp]";
		mes "你检查地下情况了吗？";
		mes "怎么样？幸好你回来了，我已经在想该怎么告诉 Alpha，客人 " + strcharinfo(0) + " 已经死了。";
		emotion ET_SWEAT, getcharid(3);
		next;
		mes "[Chirp]";
		mes "这让我很不舒服。但幸好你还活着。你为什么花了这么久？在下面遇到能力无法应付的问题了吗？";
		next;
		mes "[Chirp]";
		mes "我听说人类有时会鲁莽挑战超出能力的事。";
		next;
		cutin "",255;
		select( "这……" );
		cutin "ep172_beta",2;
		mes "[Chirp]";
		mes "总结一下" + strcharinfo(0) + "的话：如果你没有打开门进入地下，就不会有危险，那里也会一直安全。";
		next;
		cutin "",255;
		select( "是。" );
		cutin "ep172_beta",2;
		mes "[Chirp]";
		mes "还有人获得了新的身体。";
		next;
		mes "[Chirp]";
		mes "我明明警告过你不要碰任何东西，你还是收集了组装身体的零件。对吗？";
		next;
		cutin "",255;
		select( "是。.." );
		cutin "ep172_beta",2;
		mes "[Chirp]";
		mes "我不知道它是什么样子。最坏的情况是，它可能从地下室出来毁灭我们。对吗？";
		next;
		cutin "",255;
		select( "但它没有离开……" );
		cutin "ep172_beta",2;
		mes "[Chirp]";
		mes "换个角度想。主人为什么要把头留在危险区域？一个头孤零零地放在充满危险物品的地方。那东西或许也是危险的。";
		next;
		mes "[Chirp]";
		mes "即使是最高级的战斗自动人偶，也不会在地下室的危险区域制造。它可能是下一代武器。你能把它认作盟友已经很幸运了。";
		next;
		mes "[Chirp]";
		mes "如果是这样，自动人偶带来的灾难就不再是问题。";
		next;
		mes "[Chirp]";
		mes "那么你打算如何解决这个问题？" + strcharinfo(0) + "，亲自下到地下室完成它的身体吗？";
		next;
		cutin "",255;
		select( "太过分了……" );
		cutin "ep172_beta",2;
		mes "[Chirp]";
		mes "你打算怎么办，" + strcharinfo(0) + "？要回到那里继续享受乐趣吗？如果你打算自己做，就不用每次都来申请。";
		next;
		cutin "",255;
		select( "....." );
		cutin "ep172_beta",2;
		mes "[Chirp]";
		mes "幸好你说它不会离开地下室。这样就只有一个办法了。";
		next;
		mes "[Chirp]";
		mes "^0000CD我要悄悄把这件事掩盖起来^000000。在这座宅邸里，甚至全世界，只有我和 " + strcharinfo(0) + " 应该知道这件事。";
		next;
		mes "[Chirp]";
		mes "你也必须分担任务。我会留在这里阻止任何人进出地下室。我们还会监视那东西，看它是否会离开地下室。";
		next;
		mes "[Chirp]";
		mes "^0000CD" + strcharinfo(0) + " 应该每天来这里^000000，帮忙清理仓库和地下室。";
		next;
		cutin "",255;
		select( "清理？" );
		cutin "ep172_beta",2;
		mes "[Chirp]";
		mes "这不像损坏的清洁机器人那样简单。检查仓库时，我们发现里面还有入侵者残留。据说是心脏猎人散兵。正如我说过的，我还有很多工作。";
		next;
		mes "[Chirp]";
		mes "为了保护仓库里的货物，我希望你清理那些心脏猎人。也请清理地下室损坏的仓库管理员，免得与那东西结仇。";
		next;
		mes "[Chirp]";
		mes "你不会损失什么，还能把它当作个人娱乐。当然我会支付报酬。我会登记你的资料，让你无需紧急钥匙就能进出地下室。";
		next;
		select( "Sure." );
		mes "[Chirp]";
		mes "谢谢。我给你这张券作为承诺的凭证。那么，就把它当作秘密吧。";
		mes "我也会收回紧急钥匙。";
		ep17_2_chirp = 12;
		completequest 17358;
		delitem 1000102,3;
		getitem 1000103,6;
		getexp2 3156050,0;
		close3;
	}

	// Daily quests
	cutin "ep172_beta",2;
	mes "[Chirp]";
	mes "你是来履行我们的约定的吗？";
	mes "你想接下哪项工作？";
	next;
	.@quest_menu$[0] = callsub( S_Menu, 17359,17360, "仓库清理" );
	.@quest_menu$[1] = callsub( S_Menu, 17361,17362, "地下室清理" );

	switch( select( .@quest_menu$[0], .@quest_menu$[1], "Is there something wrong?" ) ) {
	case 1:
		.@lvl = 160;
		.@hunt = 17359;
		.@cooldown = 17360;
		break;
	case 2:
		.@lvl = 170;
		if (BaseLevel < .@lvl) {
			cutin "ep172_beta",2;
			mes "[Chirp]";
			mes "什么？你是说地下室？";
			mes "我说过，地下室非常危险……看来你很难应付。何不把生命花在更有价值的事情上？";
			next;
			cutin "",255;
			mes "- 你至少要达到 " + .@lvl + " 级才能进行此任务。-";
			close;
		}
		.@hunt = 17361;
		.@cooldown = 17362;
		break;
	case 3:
		cutin "ep172_beta",2;
		mes "[Chirp]";
		mes "目前还没有出问题，但没人知道能持续多久。不要放松警惕。";
		close3;
	}
	switch( checkquest(.@cooldown,PLAYTIME) ) {
	case -1:
		break;
	case 0:
	case 1:
		mes "[Chirp]";
		mes "如果我们制造太大声音，地下室里的东西可能会来到这里。请天亮后再回来。";
		close3;
	case 2:
		erasequest .@cooldown;
		break;
	}
	switch( checkquest(.@hunt,HUNTING) ) {
	case -1:
		if (.@hunt == 17359) {
			mes "[Chirp]";
			mes "你确实喜欢战斗。那么请处理仓库里的 ^0000CD20 个心脏猎人散兵^000000。";
		}
		else {
			mes "[Chirp]";
			mes "你确实喜欢战斗。那么请处理地下室里的 ^0000CD20 个损坏的仓库管理员^000000。";
		}
		next;
		if (select( "I got it.", "I want to rest today" ) == 2) {
			mes "[Chirp]";
			mes "是吗？我还以为你会想每天做这件事来消遣。";
			mes "真是出乎意料。";
			close3;
		}
		mes "[Chirp]";
		mes "在此期间，我会尽力处理这里的事。";
		setquest .@hunt;
		close3;
	case 0:
	case 1:
		mes "[Chirp]";
		mes "你已经处理完所有事情了吗？";
		next;
		if (.@hunt == 17359) {
			mes "[Chirp]";
			mes "你没看到它们到处乱跑吗？";
			mes "那么请处理仓库里的 ^0000CD20 个心脏猎人散兵^000000。";
			close3;
		}
		mes "[Chirp]";
		mes "你没看到它们到处乱跑吗？";
		mes "那么请处理地下室里的 ^0000CD20 个损坏的仓库管理员^000000。";
		close3;
	case 2:
		mes "[Chirp]";
		mes "你已经处理完所有事情了吗？";
		next;
		mes "[Chirp]";
		mes "我可以确认数量已经减少了。";
		mes "现在我可以开始工作了。";
		mes "谢谢。请天亮后再回来。";
		setquest .@cooldown;
		erasequest .@hunt;
		getitem 1000103,1;
		if (.@hunt == 17359)
			getexp 4431108,3101780;
		else
			getexp 5974540,4182156;
		close3;
	}
	end;

S_Menu:
	.@string$ = getarg(2);

	switch( checkquest(getarg(1),PLAYTIME) ) {
	case -1:
		switch( checkquest(getarg(0),HUNTING) ) {
		case -1:
			.@menu$ = .@string$;
			break;
		case 0:
		case 1:
			.@menu$ = "^777777" + .@string$ + " - Ongoing^000000";
			break;
		case 2:
			.@menu$ = "" + .@string$ + " - Completed";
			break;
		}
		break;
	case 0:
	case 1:
		.@menu$ = "^777777" + .@string$ + " - Waiting^000000";
		break;
	case 2:
		.@menu$ = .@string$;
		break;
	}
	return .@menu$;

OnInit:
	// sidequest
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "BaseLevel >= 160 && ep17_2_main >= 9 && ep17_2_chirp == 0" );
	questinfo( QTYPE_QUEST2, QMARK_YELLOW, "checkquest(17342,HUNTING) == 2" );
	questinfo( QTYPE_QUEST2, QMARK_YELLOW, "isbegin_quest(17344) == 1" );
	questinfo( QTYPE_QUEST2, QMARK_YELLOW, "isbegin_quest(17358) == 1" );

	// daily
	questinfo( QTYPE_DAILYQUEST, QMARK_YELLOW, "isbegin_quest(17358) == 2 && checkquest(17359,HUNTING) == -1 && checkquest(17360,PLAYTIME) == -1" );
	questinfo( QTYPE_DAILYQUEST, QMARK_YELLOW, "checkquest(17360,PLAYTIME) == 2" );
	questinfo( QTYPE_QUEST2, QMARK_YELLOW, "checkquest(17359,HUNTING) == 2" );

	questinfo( QTYPE_DAILYQUEST, QMARK_YELLOW, "isbegin_quest(17358) == 2 && BaseLevel >= 170 && checkquest(17361,HUNTING) == -1 && checkquest(17362,PLAYTIME) == -1" );
	questinfo( QTYPE_DAILYQUEST, QMARK_YELLOW, "checkquest(17362,PLAYTIME) == 2" );
	questinfo( QTYPE_QUEST2, QMARK_YELLOW, "checkquest(17361,HUNTING) == 2" );
	end;
}

ba_2whs01,153,49,1	duplicate(dummy_cloaked_npc)	Beta#ep172_2whs01-00	4_EP17_BASIC_B

ba_2whs01,110,218,0	script	#ep172_key_ev_0	HIDDEN_WARP_NPC,3,3,{
	end;
OnTouch:
	if (ep17_2_chirp != 4)
		end;
	.@id = atoi(replacestr(strnpcinfo(2),"ep172_key_ev_",""));
	.@quest_id = (17345 + .@id);
	if (isbegin_quest(.@quest_id) == 1)
		cloakoffnpcself( "Emergency Key#ep172_" + .@id );
	end;
}

ba_2whs01,14,282,0	duplicate(#ep172_key_ev_0)	#ep172_key_ev_1	HIDDEN_WARP_NPC,3,3
ba_2whs01,222,257,0	duplicate(#ep172_key_ev_0)	#ep172_key_ev_2	HIDDEN_WARP_NPC,3,3

ba_2whs01,110,218,0	script(CLOAKED)	Emergency Key#ep172_0	4_ENERGY_WHITE,{
	if (checkweight(1000102,1) == 0) {	// (custom)
		mes "^008800等一下！！";
		mes "你携带的物品太多，无法再获得物品。减轻负重后再试。^000000";
		close;
	}
	if (ep17_2_chirp != 4)
		end;
	.@id = atoi(replacestr(strnpcinfo(2),"ep172_",""));
	.@quest_id = (17345 + .@id);
	switch( .@id ) {
	case 0:
		.@word$ = "我们仔细看看地图下面……";
		break;
	case 1:
		.@word$ = "哦，好冷……";
		break;
	case 2:
		.@word$ = "让我把手伸进去……";
		break;
	}
	if (isbegin_quest(.@quest_id) == 1) {
		setpcblock PCBLOCK_NPC, true;
		unittalk getcharid(3), "" + strcharinfo(0) + " : She said there's an emergency key over here... " + .@word$, bc_self;
		sleep2 2500;
		unittalk getcharid(3), "" + strcharinfo(0) + "：我找到了！！！", bc_self;
		sleep2 2500;
		setpcblock PCBLOCK_NPC, false;
		erasequest .@quest_id;
		getitem 1000102,1;
		if (isbegin_quest(17345) != 0 || isbegin_quest(17346) != 0 || isbegin_quest(17347) != 0)
			unittalk getcharid(3), "" + strcharinfo(0) + "：去找另一把紧急钥匙吧。", bc_self;
		else {
			unittalk getcharid(3), "" + strcharinfo(0) + "：既然找齐了所有紧急钥匙，就去打开那扇锁着的门吧。", bc_self;
			ep17_2_chirp = 5;
			setquest 17348;
		}
		cloakonnpcself();
		end;
	}
	end;

OnInit:
	.@id = atoi(replacestr(strnpcinfo(2),"ep172_",""));
	.@quest_id = 17345 + .@id;
	questinfo( QTYPE_QUEST2, QMARK_YELLOW, "isbegin_quest(" + .@quest_id + ") == 1" );
	end;
}

ba_2whs01,14,282,0	duplicate(Emergency Key#ep172_0)	Emergency Key#ep172_1	4_ENERGY_WHITE
ba_2whs01,222,257,0	duplicate(Emergency Key#ep172_0)	Emergency Key#ep172_2	4_ENERGY_WHITE

ba_2whs01,276,290,0	script	Lock#ep172_2whs01-00	4_ENERGY_BLUE,{
	if (ep17_2_chirp == 2) {
		mes "- 门牢牢锁着。-";
		next;
		mes "- Rattling -";
		next;
		mes "- W... who... -";
		next;
		mes "- 我听到比入口处更清晰的声音。但我没有钥匙，无法下去查看。回去问问吧。-";
		ep17_2_chirp = 3;
		erasequest 17343;
		setquest 17344;
		close;
	}
	if (ep17_2_chirp == 5) {
		setpcblock PCBLOCK_NPC, true;
		unittalk getcharid(3), "我把三把紧急钥匙插进锁里，门就打开了。", bc_self;
		sleep2 2000;
		npctalk "紧急门正在打开。", "", bc_self;
		sleep2 2000;
		npctalk "Emergency Level 1.", "", bc_self;
		sleep2 2000;
		npctalk "首要任务是保护生命。", "", bc_self;
		sleep2 2000;
		npctalk "如果发现有人受伤，请检查生命迹象并迅速进行救援。", "", bc_self;
		sleep2 2000;
		setpcblock PCBLOCK_NPC, false;
		ep17_2_chirp = 6;
		erasequest 17348;
		setquest 17349;
		warp "ba_2whs02",338,332;
		end;
	}
	if (ep17_2_chirp >= 6) {
		setpcblock PCBLOCK_NPC, true;
		npctalk "欢迎。", "", bc_self;
		sleep2 2000;
		setpcblock PCBLOCK_NPC, false;
		warp "ba_2whs02",338,332;
		end;
	}
	mes "- 门牢牢锁着。-";
	close;

OnInit:
	questinfo( QTYPE_QUEST2, QMARK_YELLOW, "isbegin_quest(17343) == 1" );
	questinfo( QTYPE_QUEST2, QMARK_YELLOW, "isbegin_quest(17348) == 1" );
	end;
}


ba_2whs02,37,312,3	script	#ep172_ev2whs01	HIDDEN_WARP_NPC,5,5,{
	end;
OnTouch:
	if (ep17_2_chirp >= 6 || ep17_2_chirp <= 10) {
		setnpcdisplay( "Head#ep172_2whs01", 4_GHOSTRING );
		cloakoffnpcself( "Head#ep172_2whs01" );
		end;
	}
	if (ep17_2_chirp > 10) {
		setnpcdisplay( "Head#ep172_2whs01", 4_F_KR_TIGER );
		cloakoffnpcself( "Head#ep172_2whs01" );
		end;
	}
	end;
}


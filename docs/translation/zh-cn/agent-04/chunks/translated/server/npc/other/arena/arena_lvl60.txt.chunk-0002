prt_are_in,129,135,3	script	Staff#60-1	67,{
	mes "[Staff]";
	mes "干得好。";
	mes "即使你没能完成计时战斗，我也会奖励少量竞技场点数。";
	next;
	if (arena_point == 30000) {
		mes "[Staff]";
		mes "嗯哼！";
		mes "你已经有足够竞技场点数。";
		mes "请稍后花掉一些点数，下次见面时我会给你奖励。";
		next;
	}
	else set arena_point, arena_point + 1;
	mes "[Staff]";
	mes "让我带你出去。希望你玩得开心。";
	close2;
	specialeffect2 EF_EXIT;
	warp "arena_room",100,75;
	end;
}

prt_are_in,25,135,3	script	Staff#60-2	67,{
	if($arena_min60end < $arena_min60st) {
		if($arena_sec60end < $arena_sec60st) {
			set @record_min60,60 - $arena_min60st + $arena_min60end -1;
			set @record_sec60,60 - $arena_sec60st + $arena_sec60end;
		} else {
			set @record_min60,60 - $arena_min60st + $arena_min60end;
			set @record_sec60,$arena_sec60end - $arena_sec60st;
		}
	} else {
		if($arena_sec60end < $arena_sec60st) {
			set @record_min60,$arena_min60end - $arena_min60st -1;
			set @record_sec60,60 - $arena_sec60st + $arena_sec60end;
		} else {
			set @record_min60,$arena_min60end - $arena_min60st;
			set @record_sec60,$arena_sec60end - $arena_sec60st;
		}
	}
	set @gap60,(60 * $top_60min + $top_60sec) - (60 * @record_min60 + @record_sec60);
	mes "[Staff]";
	mes "哇，干得好～";
	mes "你的名字是……^3131FF"+strcharinfo(0)+"^000000，对吧？";
	mes "^3131FF"+ strcharinfo(0) +"^000000，你通过战斗所用的总时间是……";
	next;
	mes "[Staff]";
	mes "是 "+@record_min60+" 分钟 "+@record_sec60+" 秒。";
	mes "恭喜！";
	next;
	mes "[Staff]";
	mes "完成 Lv60 竞技场时空战的玩家中，最快的是 ^3131FF"+$arena_60topn$+"^000000。";
	next;
	mes "[Staff]";
	mes "^3131FF"+$arena_60topn$+"^000000 的时间是 ^3131FF"+$top_60min+"^000000 分钟 ^3131FF"+$top_60sec+"^000000 秒。";
	next;
	if (@gap60 < 0) {
		mes "[Staff]";
	mes "虽然你没能创造新纪录，但希望你下次成功。";
		next;
		if (arena_point > 29980) {
			mes "[Staff]";
	mes "那么让我奖励你一些竞技场点数……咦？";
	mes "你的竞技场点数已超过上限。在花掉一些点数前，我无法再给你更多。";
			next;
			mes "[Staff]";
	mes "你可以在竞技场等候室查看竞技场点数。";
			next;
			mes "[Staff]";
	mes "希望你玩得愉快，现在让我带你到竞技场入口。";
	mes "谢谢。";
			close2;
		} else {
			set arena_point, arena_point + 20;
			mes "[Staff]";
	mes "让我奖励你一些竞技场点数。";
	mes "如果想查看点数，请到竞技场入口和 ^3131FFVendigos^000000 交谈。";
			next;
			mes "[Staff]";
	mes "让我带你到竞技场入口。";
	mes "回头见～";
			close2;
		}
		specialeffect2 EF_EXIT;
 		donpcevent "cast#60::OnNomal1";
		warp "arena_room",100,75;
		donpcevent "#arn_timer_60::OnStop";
		donpcevent "alloff#60::OnEnable";
		donpcevent "Lv60 Waiting Room::OnStart";
		end;
	} else {
		emotion ET_HUK;
		mes "[Staff]";
		mes "哇！你刷新了记录！";
		mes "做得太棒了！";
		next;
		mes "[Staff]";
	mes "你已被记录为完成^FF0000 Lv60 竞技场时空战^000000的最快玩家，^3131FF"+strcharinfo(0)+"^000000。";
		set $top_60min, @record_min60;
		set $top_60sec, @record_sec60;
		set $arena_60topn$,strcharinfo(0);
		donpcevent "Vendigos::OnLineRec_60";
		next;
		if (arena_point > 29950) {
			mes "[Staff]";
	mes "那么让我奖励你一些竞技场点数……咦？";
	mes "你的竞技场点数已超过上限。在花掉一些点数前，我无法再给你更多。";
			next;
			mes "[Staff]";
	mes "你可以在竞技场等候室查看竞技场点数。";
			next;
			mes "[Staff]";
	mes "希望你玩得愉快，现在让我带你到竞技场入口。";
	mes "谢谢。";
			close2;
		} else {
			mes "[Staff]";
	mes "让我奖励你一些竞技场点数。";
	mes "由于你刷新了纪录，这次还会获得额外点数。";
			next;
			set arena_point, arena_point + 50;
			mes "[Staff]";
			mes "让我奖励你一些竞技场点数。";
	mes "如果想查看点数，请到竞技场入口和 ^3131FFVendigos^000000 交谈。";
			next;
			mes "[Staff]";
			mes "让我带你到竞技场入口。";
			mes "回头见～";
			close2;
		}
		specialeffect2 EF_HIT5;
 		donpcevent "cast#60::OnNomal2";
		warp "arena_room",100,75;
		donpcevent "#arn_timer_60::OnStop";
		donpcevent "alloff#60::OnEnable";
		donpcevent "Lv60 Waiting Room::OnStart";
		end;
	}
}

-	script	#arn_timer_60	-1,{
OnEnable:
	initnpctimer;
	end;

OnTimer2000:
	mapannounce "prt_are_in","本广播告知你 60 级竞技场的限制。",0,0xFFCE00;
	end;

OnTimer3000:
	mapannounce "prt_are_in","为保证游戏顺利，出口传送门将在 1 分钟后激活。",0,0xFFCE00;
	end;

OnTimer4000:
	mapannounce "prt_are_in","为避免不利，请尽快进行战斗。感谢配合。",0,0xFFCE00;
	end;

OnTimer60000:
 	donpcevent "cast#60::OnTimeOver2";
	donpcevent "arn_warp_60::OnOut";
	donpcevent "#arn_timer_60::OnStop";
	donpcevent "alloff#60::OnEnable";
	donpcevent "Lv60 Waiting Room::OnStart";
	end;

OnStop:
	stopnpctimer;
	end; 
}

-	script	arn_warp_60	-1,{
OnOut:
	areawarp "prt_are_in",14,143,29,126,"arena_room",100,75;
	end;
}

-	script	cast#60	-1,{
OnTimeOver1:
	mapannounce "force_2-1","由于战斗中发生错误，竞技场将重新启动。",0,0xFFCE00;
	end;

OnNomal1:
	mapannounce "force_2-1","竞技场将重新启动。",0,0xFFCE00;
	end;

OnNomal2:
	mapannounce "force_2-1","竞技场将重新启动。",0,0xFFCE00;
	end;

OnTimeOver2:
	mapannounce "force_2-1","由于等候室发生错误，竞技场将重新启动。",0,0xFFCE00;
	end;
}

-	script	alloff#60	-1,{

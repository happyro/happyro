1@ge_st,114,50,4	script	Arhi#1	670,{
end;

OnActivate:
	enablenpc instance_npcname("Arhi#1");
	npctalk "第一场比赛总让我紧张～！";
	sleep 2000;
	npctalk "我能赢吗？";
	sleep 3000;
	npctalk "应该没问题，这个"+('sex ? "男" : "女")+"孩看起来很弱。";
	sleep 3000;

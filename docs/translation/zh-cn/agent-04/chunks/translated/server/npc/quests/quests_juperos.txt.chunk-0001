yuno_in04,190,125,4	script	Scholar	700,{
function Func_JupHist;
	switch(yuno_hist) {
	case 0:
		mes "[学者]";
		mes "……嗯？";
		mes "……是？";
		next;
		mes "[学者]";
		mes "...";
		mes "......";
		mes "我能帮你吗？";
		next;
		switch(select("哦！没、没什么！:打扰了……")) {
		case 1:
			mes "[学者]";
			mes "...";
			mes "......";
			mes "嗯？";
			mes "...........";
			mes "哼。";
			close;
		case 2:
			mes "[学者]";
			mes "...";
			mes "......";
			mes "嗯？";
			mes "...........";
			mes "嗯……";
			next;
			mes "[学者]";
			mes "你一定迷路了。";
			mes "这里是学术研究区，";
			mes "内容不是你能理解的。";
			mes "";
			mes "通俗小说和绘本在别处。";
			next;
			mes "["+strcharinfo(0)+"]";
			mes "...";
			mes "......";
			next;
			mes "[学者]";
			mes "为什么不翻翻";
			mes "书架？";
			mes "肯定能找到";
			mes "感兴趣的书。只要你的";
			mes "注意力";
			mes "足够长……";
			next;
			mes "["+strcharinfo(0)+"]";
			mes "(她怎么回事？！";
			mes "她是态度有问题还是太自大？）";
			close;
		}
	case 1:
		mes "[学者]";
		mes "……嗯？";
		mes "……是？";
		next;
		mes "[学者]";
		mes "...";
		mes "......";
		mes "我能帮你吗？";
		next;
		switch(select("哦！没、没什么！:不知你是否……")) {
		case 1:
			mes "[学者]";
			mes "...";
			mes "......";
			mes "嗯？";
			mes "...........";
			mes "哼。";
			close;
		case 2:
			mes "["+strcharinfo(0)+"]";
			mes "不知你是否……";
			mes "正在进行";
			mes "朱佩洛斯研究？";
			next;
			mes "[学者]";
			mes "是的，没错。";
			mes "但你怎么知道";
			mes "我当前的";
			mes "研究项目？";
			next;
			mes "["+strcharinfo(0)+"]";
			mes "哦，我读过一篇名为";
			mes "的论文，";
			mes "《朱佩洛斯的陨落》，而且";
			mes "我觉得写作风格和你的性格";
			mes "";
			mes "不知为何很相似。";
			next;
			mes "[学者]";
			mes "哦……！你读过我的论文？";
			mes "你觉得怎么样？";
			mes "请直说。";
			next;
			mes "["+strcharinfo(0)+"]";
			mes "目前还可以，但坦率地说并不完整。";
			mes "你的推测不多，";
			mes "更别说支持陈述的证据了。";
			mes "许多结论都缺乏依据。";
			mes "需要进一步研究。";
			mes "这只是我的看法。";
			next;
			mes "[学者]";
			mes "....";
			mes "请允许我为刚才的无礼道歉。";
			mes "如你所知，我叫费鲁兹·克尔希哈。";
			mes "可以问问你的名字吗？";
			mes "我想正式认识你。";
			mes "请不要介意我的态度。";
			next;
			mes "["+strcharinfo(0)+"]";
			mes "我是"+strcharinfo(0)+"，";
			mes "效忠于睿智仁慈的";
			mes "特里斯坦三世国王的";
			mes "勇敢冒险者。";
			mes "很高兴认识你。";
			set yuno_hist,2;
			setquest 11017;
			next;
			mes "[Fayruz]";
			mes "那么，"+strcharinfo(0)+"，";
			mes "我明白论文还需要更多证据。";
			mes "但我需要一些来自朱佩洛斯的古代文献";
			mes "才能完成研究……";
			mes "这对我非常重要。";
			mes "拜托你了。";
			next;
			mes "[Fayruz]";
			mes "如果你经过朱佩洛斯时";
			mes "发现任何古代文献，";
			mes "能带给我吗？";
			mes "它们会极大帮助我的研究。";
			mes "提前谢谢你……";
			mes "请务必小心。";
			close;
		}
	case 2:
		if (countitem(7352) || countitem(7353) || countitem(7354) || countitem(7355)) {
			mes "[Fayruz]";
			mes "啊，是你！听着，";
			mes "我刚发现一份探索朱佩洛斯的";
			mes "冒险者记录。里面提到这里有一座石像，";
			mes "也许非常重要……";
			mes "我想进一步确认。";
			mes "这可能是关键。";
			next;
			mes "[Fayruz]";
			mes "如果你去了朱佩洛斯，";
			mes "能在地下城入口找到那座石像，";
			mes "并替我阅读上面的铭文吗？";
			mes "请把内容记下来。";
			mes "这会很有帮助。";
			mes "拜托了。";
			next;
			mes "[Fayruz]";
			mes "根据我的笔记，有一种法术会让阅读者记住铭文，";

			mes "请尽量留意。";
			next;
			mes "[Fayruz]";
			mes "如果你能找到那个时期的文献，";
			mes "会对我非常有帮助。";
			mes "幸运的是，当时的记录都写在比纸张更耐久的材料上。";
			mes "它们也许保存至今。";
			close;
		case 2:
			mes "[Fayruz]";
			mes "什么也没有吗？";
			mes "我的生活也相当平淡，";
			mes "但不知为什么，";
			mes "我觉得自己并不满足。";

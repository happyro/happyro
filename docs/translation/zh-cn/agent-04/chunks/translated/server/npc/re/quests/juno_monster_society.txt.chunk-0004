	questinfo( QTYPE_QUEST2, QMARK_YELLOW, "checkquest(5922,HUNTING) == 2" );
	questinfo( QTYPE_DAILYQUEST, QMARK_YELLOW, "checkquest(5923,PLAYTIME) == 2" );
	end;
}

// note: all mobs increase the hunt count
ein_fild03,135,46,5	script	Map Examiner Tailing#tailing	1_M_YOUNGKNIGHT,{
	.@npc_name$ = "[" + strnpcinfo(1) + "]";
	.@item_name$ = getitemname(1000374);

	if (BaseLevel < 76) {
		mes .@npc_name$;
		mes "朱诺怪物协会正在进行讨伐任务。但你似乎还太弱，无法执行任务。";
		close;
	}
	switch( checkquest(3472,PLAYTIME) ) {
	case -1:
		break;
	case 0:
	case 1:
		mes .@npc_name$;
		mes "啊，今天的讨伐够了！";
		next;
		mes .@npc_name$;
		mes "如果你明天再来帮忙讨伐怪物，我会很感激！！";
		next;
		if (select( "交出" + .@item_name$ + ".", "不交出。" ) == 2)
			end;
		if (countitem(1000374) < 3) {
			mes "- 需要 3 个" + .@item_name$ + "。-";
			close;
		}
		delitem 1000374,3;	// Brilliant_Soda
		erasequest 3472;
		mes .@npc_name$;
		mes "啊~！！非常感谢~我当时很渴~";
		next;
		mes .@npc_name$;
		mes "咕嘟~咕嘟~~~";
		next;
		specialeffect EF_FLASHER;
		mes .@npc_name$;
		mes "嗯……这浓烈的味道……！";
		next;
		mes .@npc_name$;
		mes "呃……你对我来说还是新人，稍等一下。我也要喝一点，可以过一分钟再和我谈吗？";
		close;
	case 2:
		erasequest 3472;
		break;
	}
	switch( checkquest(3471,HUNTING) ) {
	case -1:
		mes .@npc_name$;
		mes "你好！！你又来了！我是朱诺怪物协会的地图调查员 Tailing！";
		next;
		switch( select( "接受讨伐任务。", "传送到附近城市。", "询问讨伐任务。", "下次再来。" ) ) {
		case 1:
			mes .@npc_name$;
			mes "哦，你想接受委托吗？";
			next;
			mes .@npc_name$;
			mes "你只需在我所在的区域击杀 80 只怪物。";
			next;
			setquest 3471;
			mes .@npc_name$;
			mes "那我会等你，希望你平安回来。";
			close;
		case 2:
			mes .@npc_name$;
			mes "离这里最近的城市是艾音布洛克！";
			next;
			mes .@npc_name$;
			mes "如果你给我一个" + .@item_name$ + ", 我马上送你过去！";
			next;
			if (select( "移动", "不移动" ) == 2) {
				mes .@npc_name$;
				mes "好的，需要传送时请告诉我！！";
				close;
			}
			if (countitem(1000374) < 1) {
				mes .@npc_name$;
				mes "嘿，你没有" + .@item_name$ + "吗~";
				next;
				mes .@npc_name$;
				mes "传送需要 1 个" + .@item_name$ + ".";
				close;
			}
			mes .@npc_name$;
			mes "好的！那我们送你过去！！";
			close2;
			delitem 1000374,1;	// Brilliant_Soda
			warp "einbroch",146,49;
			end;
		case 3:
			mes .@npc_name$;
			mes "不久前发现了怪物群落扩张现象。";
			next;
			mes .@npc_name$;
			mes "曾经积极进行讨伐，但如今因疏忽而有所扩张。";
			next;
			mes .@npc_name$;
			mes "若现象持续会很危险，因此朱诺怪物协会决定开展全面讨伐。";
			next;
			mes .@npc_name$;
			mes "也就是说，在每个需要讨伐的区域派驻地图调查员来推进讨伐！";
			close;
		case 4:
			mes .@npc_name$;
			mes "啊，你要去哪里？";
			close;
		}
		end;
	case 0:
	case 1:
		mes .@npc_name$;
		mes "你只需在此区域讨伐 80 只任意怪物。";
		next;
		mes .@npc_name$;
		mes "讨伐完成后来找我领取奖励！！";
		close;
	case 2:
		getexp 146520,131880;
		erasequest 3471;
		setquest 3472;
		mes .@npc_name$;
		mes "你平安回来了！";
		next;
		mes .@npc_name$;
		mes "我勉强完成了今天的目标……";
		next;
		mes .@npc_name$;
		mes "明天有空请再来！！";
		close;
	}
	end;

OnInit:
	setunittitle getnpcid(0), "<Juno Monster Society>";

	questinfo( QTYPE_QUEST, QMARK_YELLOW, "BaseLevel >= 76 && checkquest(3471,HUNTING) == -1" );
	questinfo( QTYPE_QUEST2, QMARK_YELLOW, "checkquest(3471,HUNTING) == 2" );
	end;
}


tur_dun02,151,256,4	script	Map Examiner Tidun#yma	4_M_NINJA_BLUE,{
	.@npc_name$ = "[" + strnpcinfo(1) + "]";
	.@item_name$ = getitemname(1000374);

	if (BaseLevel < 80) {
		mes .@npc_name$;
		mes "朱诺怪物协会正在进行讨伐任务。但你似乎还太弱，无法执行任务。";
		close;
	}
	switch( checkquest(5929,PLAYTIME) ) {
	case -1:
		break;
	case 0:
	case 1:
		mes .@npc_name$;
		mes "明天可以再次进行讨伐海底洞穴副本的任务。你一定累了，回家休息吧。";
		next;
		switch( select( "你看起来很累。想喝点东西吗？", "传送到附近城市。" ) ) {
		case 1:
			if (countitem(1000374) < 3) {
				mes .@npc_name$;
				mes "我好像听说会给你 3 个" + .@item_name$ + "，但一定是我听错了。";
				close;
			}
			delitem 1000374,3;	// Brilliant_Soda
			erasequest 5929;
			mes .@npc_name$;
			mes "哦！谢谢。你真好。我喝了。";
			next;
			npctalk "我感觉被清新的气息包围了。", "", bc_self;
			specialeffect EF_FLASHER;
			mes .@npc_name$;
			mes "嗯！我想有客人来了。";
			close;
		case 2:
			mes .@npc_name$;
			mes "如果你给我一个" + mesitemlink( 1000374 ) + "，我可以把你传送到附近的艾尔帕兰。";
			next;
			select( "给我 1 个" + .@item_name$ + "。" );
			if (countitem(1000374) < 1) {
				mes .@npc_name$;
				mes "传送到附近城市需要 1 个" + .@item_name$ + "，我只是想送你过去，但这是官方价格……";
				close;
			}
			mes .@npc_name$;
			mes "旅途愉快。";
			close2;
			delitem 1000374,1;	// Brilliant_Soda
			warp "alberta",117,55;
			end;
		}
		end;
	case 2:
		erasequest 5929;
		mes .@npc_name$;
		mes "你可以再次进行海底洞穴副本的讨伐。";
		close;
	}
	switch( checkquest(5928,HUNTING) ) {
	case -1:
		mes .@npc_name$;
		mes "朱诺怪物协会准备了讨伐海底洞穴副本的任务。你有什么想法？";
		next;
		switch( select( "接受讨伐任务。", "讨伐任务？", "传送到附近城市。", "第三项" ) ) {
		case 1:
			setquest 5928;
			mes .@npc_name$;
			mes "在海底洞穴副本捕获 80 只怪物后回来向我报告。祝你好运。";
			close;
		case 2:
			mes .@npc_name$;
			mes "我一直在寻找安静的地方，后来找到合适的工作，于是申请成为地图调查员。";
			next;
			mes .@npc_name$;
			mes "问题是，我停留的时间比预想的更长。";
			next;
			mes .@npc_name$;
			mes "我想早点回家……";
			close;
		case 3:
			mes .@npc_name$;
			mes "如果你给我一个" + mesitemlink( 1000374 ) + ", I can teleport you to the nearby city, Alberta.";
			next;
			select( "给我 1 个" + .@item_name$ + "。" );
			if (countitem(1000374) < 1) {
				mes .@npc_name$;
				mes "传送到附近城市需要 1 个" + .@item_name$ + "，我只是想送你过去，但这是官方价格……";
				close;
			}
			mes .@npc_name$;
			mes "旅途愉快。";
			close2;
			delitem 1000374,1;	// Brilliant_Soda
			warp "alberta",117,55;
			end;
		case 4:
			mes .@npc_name$;
			mes "我听说由于怪物数量增加，预计会发生群落碰撞。";
			next;
			mes .@npc_name$;
		mes "如果怪物群落彼此碰撞，人类不是应该提前减少它们的数量吗？";
			close;
		}
		end;
	case 0:
	case 1:
		mes .@npc_name$;
		mes "在海底洞穴副本捕获 80 只怪物后回来向我报告。我会等你。";
		close;
	case 2:
		getexp 95240,88580;
		erasequest 5928;
		setquest 5929;
		mes .@npc_name$;
		mes "你很快就解决了。太棒了。明天可以再次进行讨伐任务，有空再来见我吧。";
		close;
	}
	end;

OnInit:
	setunittitle getnpcid(0), "<Juno Monster Society>";

	questinfo( QTYPE_CLICKME, QMARK_YELLOW, "(checkquest(5929,PLAYTIME) == 0 || checkquest(5929,PLAYTIME) == 1) && countitem(1000374) > 2" );
	questinfo( QTYPE_DAILYQUEST, QMARK_YELLOW, "BaseLevel >= 80 && checkquest(5928,HUNTING) == -1 && checkquest(5929,PLAYTIME) == -1" );
	questinfo( QTYPE_DAILYQUEST, QMARK_YELLOW, "checkquest(5929,PLAYTIME) == 2" );
	questinfo( QTYPE_QUEST2, QMARK_YELLOW, "checkquest(5928,HUNTING) == 2" );
	end;
}

tur_dun03,125,186,6	script	Map Examiner Tsensor#yma	4_M_SIT_NOVICE,{
	.@npc_name$ = "[" + strnpcinfo(1) + "]";
	.@item_name$ = getitemname(1000374);

	if (BaseLevel < 80) {
		mes .@npc_name$;
		mes "朱诺怪物协会正在进行讨伐任务。但你似乎还太弱，无法执行任务。";
		close;
	}
	switch( checkquest(5931,PLAYTIME) ) {
	case -1:
		break;
	case 0:
	case 1:
		mes .@npc_name$;
		mes "你没事可做吗？明天还会来，为什么又来找我说话？";
		next;
		switch( select( "你看起来很累。想喝点东西吗？", "传送到附近城市。" ) ) {
		case 1:
			if (countitem(1000374) < 3) {
				mes .@npc_name$;
				mes "哈哈……" + .@item_name$ + "这么贵，我没法给你三个。";
				close;
			}
			delitem 1000374,3;	// Brilliant_Soda
			erasequest 5931;
			mes .@npc_name$;
			mes "哦，你知道吗？我会好好喝的。我本想尝尝，但太贵了，一直没能喝到。";
			next;
			npctalk "哇，原来是这个味道。", "", bc_self;
			specialeffect EF_FLASHER;
			mes .@npc_name$;
			mes "嗯？！朋友，我们见过吗？不是吧？感觉像第一次见面……";
			close;
		case 2:
			mes .@npc_name$;
			mes "艾尔帕兰快车 1 " + mesitemlink( 1000374 ) + "，立即出发。";
			next;
			select( "给我 1 个" + .@item_name$ + "。" );
			if (countitem(1000374) < 1) {
				mes .@npc_name$;
				mes "抱歉。不交给我一个" + .@item_name$ + "，我就不送你过去。辛苦了。";
				close;
			}
			mes .@npc_name$;
			mes "艾尔帕兰快车出发了。辛苦了~";
			close2;
			delitem 1000374,1;	// Brilliant_Soda
			warp "alberta",117,55;
			end;
		}
		end;
	case 2:
		erasequest 5931;
		mes .@npc_name$;
		mes "哇~ 我可以再次进行讨伐任务了。你有什么想法？";
		close;
	}
	switch( checkquest(5930,HUNTING) ) {
	case -1:
		mes .@npc_name$;
		mes "来吧！你打算进行讨伐吗？";
		next;
		switch( select( "接受讨伐任务。", "讨伐任务？", "传送到附近城市。", "新手？" ) ) {
		case 1:
			setquest 5930;
			mes .@npc_name$;
			mes "没错！去这里的羊角村捕获 80 只怪物，全部捕获后回来向我报告。";
			close;
		case 2:
			mes .@npc_name$;
			mes "你在说什么？这只是捕获怪物的任务。";
			next;
			mes .@npc_name$;
			mes "可是怎么回事！你接到 20 只巡逻者和 20 只冰冻者的请求，巡逻者都抓到了，却还剩 5 只冰冻者？";
			next;
			mes .@npc_name$;
			mes "干脆把这附近的怪物全杀掉，不就不会发生这种事了吗？";
			close;
		case 3:
			mes .@npc_name$;
			mes "艾尔帕兰快车 1 " + mesitemlink( 1000374 ) + "，立即出发。";
			next;
			select( "给我 1 个" + .@item_name$ + "。" );
			if (countitem(1000374) < 1) {
				mes .@npc_name$;
				mes "抱歉。不交给我一个" + .@item_name$ + "，我就不送你过去。辛苦了。";

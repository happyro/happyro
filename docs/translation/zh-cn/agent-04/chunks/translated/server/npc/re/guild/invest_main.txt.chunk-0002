// Realms - Merchant Guilds, Gate Managers, Status Boards
//============================================================
-	script	Cat Paw Merchant Guild	-1,{

	if (compare(strnpcinfo(4),"alde")) {
		set .@npc$,"alde";
		set .@name$,"Megrez";
		set .@realm$,"Luina";
		set .@intro$,"Luina Branch Manager in Al De Baran";
	} else if (compare(strnpcinfo(4),"gef")) {
		set .@npc$,"gef";
		set .@name$,"Meraq";
		set .@realm$,"Britoniah";
		set .@intro$,"Britoniah Branch Manager";
	} else if (compare(strnpcinfo(4),"pay")) {
		set .@npc$,"pay";
		set .@name$,"Phecda";
		set .@realm$,"Greenwood Lake";
		set .@intro$,"Payon Greenwood Lake Branch Manager";
	} else if (compare(strnpcinfo(4),"prt")) {
		set .@npc$,"prt";
		set .@name$,"Dubae";
		set .@realm$,"Valkyrie Realm";
		set .@intro$,"Prontera Valkyrie Realm Branch Manager";
	}
	set .@n$,"["+.@name$+"]";

	mes .@n$;
		mes "我是"+.@name$+"，"+.@intro$+"，喵爪商人公会的";
	mes "我负责咨询深渊之门开发投资事宜。";
	mes "有什么可以帮你？";
	next;
	switch(select("什么是深渊之门？：投资之门开发？：我想投资这个地区。：取消")) {
	case 1:
		mes .@n$;
		mes "深渊之门只是方便称呼，它其实是通往另一维度的^4d4dff缺口^000000。";
		next;
		mes .@n$;
		mes "自摩洛克创造次元裂隙后，各处出现了更多这样的缺口。";
		mes "我个人认为最近发现的深渊之门来自过去，甚至可能来自未来。";
		next;
		mes .@n$;
		mes "据说深渊之门能强行连接我们世界之外的另一个维度。";
		mes "大概是因为那里存在追随 Emperium 力量的人。";
		next;
		mes .@n$;
			mes "目前共发现 4 个深渊之门。它们都连接到充满 Emperium 力量的攻城战区域。";
		next;
		mes .@n$;
		mes "我们以缺口另一端的维度为它们命名。";
			mes "^4d4dff勇士之路、亡者之丘、远古之风和英雄之泪。^000000";
		mes "这四个缺口统称为^4d4dff深渊之门^000000。";
		next;
		mes .@n$;
		mes "缺口可能通往过去、未来，甚至未知世界。";
		mes "深渊之门蕴含的力量既可怕又诱人。";
		next;
		mes .@n$;
		mes "你也对探索深渊之门感兴趣吗？";
		mes "哈哈。在探索之前你需要完成几个步骤。";
		next;
		mes .@n$;
		mes "如果你感兴趣，";
		mes "愿意坐下来聊聊投资维护深渊之门的事吗？";
		close;
	case 2:
		mes .@n$;
		mes "你对投资之门的开发感兴趣吗？";
		mes "你想了解什么？";
		next;
		switch(select("关于大门？：关于投资？：如何投资？：投资收益？")) {
		case 1:
			mes .@n$;
			mes "之门正如其名，是一扇门。";
			mes "连接此处与彼处的维度通道。";
			next;
			mes .@n$;
			mes "深渊之门是从维度缺口另一端形成的极不稳定通道，";
			mes "因此穿过大门需要人工建立维度连接。";
			next;
			mes .@n$;
			mes "人类还远未拥有所需的先进技术，";
			mes "但我们的猫爪商人公会掌握着利用次元裂缝的高科技。";
			next;
			mes .@n$;
			mes "所以我们提出了一个方案。";
			mes "只要支持猫爪商人公会，并支付维护大门连接的巨额费用，";
			mes "我们就会建立与次元裂缝的连接。";
			next;
			mes .@n$;
			mes "当然，处理次元裂缝绝非易事，而且伴随着风险。";
			mes "有人曾在往返途中失踪。";
			next;
			mes .@n$;
			mes "最佳维护周期大约是 4 天。";
			mes "你投资给我们，我们就会创造连接维度缺口的大门。";
			next;
			mes .@n$;
			mes "这不是一个完美的双赢方案吗？";
			close;
		case 2:
			mes .@n$;
			mes "强行穿过不稳定的维度缺口并建立通道非常危险。";
			mes "更不用说还需要巨量资源。";
			next;
			mes .@n$;
			mes "只要投资猫爪商人公会，承担费用和危险补偿，";
			mes "无论风险多大，我们都会建立并维护大门。";
			next;
			mes .@n$;
			mes "当然，大门所需的费用会非常高。";
			mes "如果能找到投资者分担这笔钱，就会容易许多。";
			next;
			mes .@n$;
			mes "连接大门需要基本费用。";
			mes "结果取决于筹集到的投资金额。";
			next;
			mes .@n$;
			mes "每个攻城战区域都有一扇深渊之门。";
			mes "你能想象公会要投入多少钱、付出多少牺牲，才能开发所有区域吗？";
			next;
			mes .@n$;
			mes "这就是各区域争夺投资的原因。";
			mes "如果筹集不到足够的维护费用，投资最多的区域自然会获得收益。";
			next;
			mes .@n$;
			mes "如果^4d4dff深渊之门成功连接，藏身处区域的地下城";
			mes "就会对其他人开放，而不再仅属于公会^000000，这对投资很有吸引力。";
			next;
			mes .@n$;
			mes "不过，这只有在大门连接成功后才适用。";
			close;
		case 3:
			mes .@n$;
			mes "很简单。";
			mes "在投资期间，拜访你想投资的^4d4dff区域分部经理^000000并进行投资。";
			next;
			mes .@n$;
			mes "我们通常接受这里的^4d4dff通用货币 Zeny^000000。";
			mes "不过既然是支持猫爪商人公会，你也可以用马朗岛所需的物品投资。";
			next;
			mes .@n$;
			mes "把所需物品交给马朗岛负责公会总务的纳米斯。";
			mes "带回投资证明，将其加入投资贡品。";
			next;
			mes .@n$;
			mes "你必须在目标区域拜访并投资，投资才会计入贡品。";
			close;
		case 4:
			mes .@n$;
			mes "深渊之门本质上是与拥有攻城战城堡的公会签约并建立连接；";
			mes "因此，只要连接和维护大门的费用足够，我们就会提供全部服务。";
			next;
			mes .@n$;
			mes "关于整个工程的最低和最高费用，";
			mes "如果筹集的投资^4d4dff超过最低费用^000000，我们就能把你连接到^4d4dff未知公会地下城的最深层^000000。";
			next;
			mes .@n$;
			mes "如果投资超过最高费用，该区域就会连接到";
			mes "^4d4dff深渊之门^000000 不受投资等级影响，包括公会地下城最深层。";
			next;
			mes .@n$;
			mes "^ff0000如果没有攻城战区域达到最高投资等级，那么将选择投资最多的区域。";
			mes "投资参与度最高的区域将用所有区域筹集的投资连接深渊之门。^000000";
			next;
			mes .@n$;
			mes "深渊之门连接后，公会地下城的最深层（2F）";
			mes "将向参与该区域投资的所有冒险者开放。";
			next;
			mes .@n$;
			mes "进入地下城的次数会计入攻城战区域的下一轮投资，";
			mes "所以与占领攻城战城堡的公会保持良好关系会带来好处。";
			next;
			mes .@n$;
			mes "顺便说一下，维护深渊之门的连接并不容易，每周都需要投资和重新连接，";
			mes "所以如果你想获得未知的力量，请继续支持并投资。";
			close;
		}
	case 3:
		if (checkweight(1201,1) == 0 || MaxWeight - Weight < 1000) {
		mes "- 你当前携带的物品 -";
		mes "- 太多了。-";
		mes "- 减轻负重后 -";
			mes "- lose some weight. -";
			close;
		}
		if (countitem(6488) >= 4800) {
			mes .@n$;
			mes "你携带的感谢券太多，无法再领取。";
			mes "无法再给你更多券。请使用手中的券后再来。";
			mes "感谢券可以在马朗岛兑换各种物品。";
			close;
		}
		if (callfunc("F_Invest_Status") != 1) {
			mes .@n$;
			mes "现在不接受投资。";
			mes "请在投资期间再来。";
			close;
		}
		set .@guild, getcharid(2);
		for(set .@i,1; .@i<=5; set .@i,.@i+1) {
			set .@castle_name$[.@i], getcastlename(.@npc$+"g_cas0"+.@i);
			set .@owner_id[.@i], getcastledata(.@npc$+"g_cas0"+.@i,CD_GUILD_ID);
			set .@owner_name$[.@i], getguildname(.@owner_id[.@i]);
			if (.@guild == .@owner_id[.@i]) {
				set .@menu$, .@menu$+.@castle_name$[.@i]+" ["+.@owner_name$[.@i]+"] Guild:";
				set .@castles_owned, .@castles_owned | (1<<.@i);
			} else
				set .@menu$, .@menu$+"^aaaaaaNot the guild that claimed "+.@castle_name$[.@i]+"^000000:";
		}
		mes .@n$;
		mes "你想投资^4d4dff"+.@realm$+"^000000区域吗？";
		mes "如果那里已经有城堡被占领，你投资的将是该城堡和占领它的公会。";
		next;
		if (.@castles_owned) {
			set .@i, select(.@menu$+"Cancel");
			if (.@i == 6) {
				mes .@n$;
				mes "已取消。";
				close;
			}
			if (.@guild != .@owner_id[.@i]) {
				mes .@n$;
				mes "占领"+.@castle_name$[.@i]+"的公会是"+.@owner_name$[.@i]+"。";
				mes "看起来不是你的公会。";
				close;
			}
			mes .@n$;
			mes "以"+.@castle_name$[.@i]+"的"+.@owner_name$[.@i]+"公会名义投资。";
			callfunc "F_Invest_Abyss","$fund_"+.@npc$+"0"+.@i,.@n$;
			end;
		} else {
			mes .@n$;
			callfunc "F_Invest_Abyss","$fund_"+.@npc$+"_extra",.@n$," for "+.@realm$;
			end;
		}
	case 4:
		mes .@n$;
		mes "是这样吗？";
		mes "如果你对投资深渊之门开发感兴趣，请再来找我。";
		close;
	}
}

-	script	Gate Manager#realm	-1,{

	if (compare(strnpcinfo(4),"alde")) {
		set .@npc$,"alde";
		set .@name$,"Alkor";
		set .@gate$,"Hero's Tears";
		set .@realm$,"Luina";
	} else if (compare(strnpcinfo(4),"gef")) {
		set .@npc$,"gef";
		set .@name$,"Mizar";
		set .@gate$,"Hill of the Dead";
		set .@realm$,"Britoniah";
	} else if (compare(strnpcinfo(4),"pay")) {
		set .@npc$,"pay";
		set .@name$,"Alkaid";
		set .@gate$,"Winds of the Ancient";
		set .@realm$,"Greenwood Lake";
	} else if (compare(strnpcinfo(4),"prt")) {
		set .@npc$,"prt";
		set .@name$,"Arios";
		set .@gate$,"Way of the Warrior";
		set .@realm$,"Valkyrie Realm";
	}
	set .@n$,"["+.@name$+"]";

	if (callfunc("F_Invest_Status") != 3) {
		mes .@n$;
		mes "目前没有已连接的地下城大门。";
		close;
	}
	set .@status, getd("$"+.@npc$+"_invest_result");
	if (.@status == 3) {
		mes .@n$;
		mes "在你的投资帮助下，我们成功连接了深渊之门["+.@gate$+"]。";
		mes "攻城战地下城将在"+.@realm$+"开放，入场费很低。";
		next;
		mes .@n$;
		mes "请尽量多来，因为入场费会作为该区域的投资保存。";
		mes "你要进入攻城战地下城吗？";
		next;
		set .@i, select(.@realm$+" Dungeon 1F - 10000z:"+.@realm$+" Dungeon 2F - 10000z:Cancel");
		if (.@i == 3) {
			mes .@n$;
			mes "已取消。";
			close;
		}
		if (Zeny < 10000) {
			mes .@n$;
			mes "我是collecting a small entrance fee.";
			mes "你的贡献会保存下来，用于下一轮投资。";
			mes "入场费为 10000z。";
			close;
		}
		mes .@n$;
		mes "我现在送你前往 "+.@realm$+" 攻城战地下城 "+.@i+"F。";
		set Zeny, Zeny-10000;
		setd "$fund_"+.@npc$+"_extra", getd("$fund_"+.@npc$+"_extra") + 1;
		close2;
		if (compare(strnpcinfo(2),"alde"))
			warp "gld_dun02"+((.@i == 2)?"_2":""),32,122;

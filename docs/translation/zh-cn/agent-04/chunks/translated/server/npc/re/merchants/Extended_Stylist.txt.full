//===== rAthena Script ======================================= 
//= Stylist Extension - (Style UI)
//===== Changelogs: ==========================================
//= 1.0 First Version. [JohnnyPlayy]
//===== Description: ========================================= 
// Texts from this script were translated according to KRO
//============================================================
//= Stylist of Alberta
//===================================================

alberta_in,55,142,7	script	Stylist#alberta	4_F_02,{
	mes "[Sweet Veronica]";
	mes "欢迎来到 Veronica 美容沙龙，我已蜕变为世界级造型师。嘻嘻。";
	next;
	switch(select("改变造型:结束对话")) {
	case 1:
		close2;
		openstylist();
		end;
	case 2:
		next;
		mes "[Sweet Veronica]";
		mes "每个人都有追求美丽的权利……希望您能找到适合自己的造型。";
		close;
	}
}

//= Stylist of Prontera
//===================================================
prt_in,243,168,4	script	Stylist#prontera	4_F_02,{
	mes "[Jovovich]";
	mes "欢迎。我是来自普隆德拉的著名造型师 Jovovich。能为您做些什么？";
	next;
	switch(select("改变造型:结束对话")) {
	case 1:
		close2;
		openstylist();
		end;
	case 2:
		mes "[Jovovich]";
		mes "欢迎下次再来～";
		close;
	}
}

//= Stylist of Lighthalzen
//===================================================
lhz_in02,100,143,4	script	Stylist#lhz	2_M_DYEINGER,{
	mes "[Prince Shami]";
	mes "我回来了，依然是世界上最伟大的造型师之一。我是 Shami 王子，一名专业造型师，拥有这份天赋真是幸福！<3";
	next;
	switch(select("改变造型:结束对话")) {
	case 1:
		close2;
		openstylist();
		end;
	case 2:
		mes "[Prince Shami]";
		mes "您是说不喜欢这个造型？怎么可能！";
		close;
	}
}

//= Stylist of Lasagna
//===================================================
lasagna,134,113,3	script	Stylist#lasagna	4_DR_F_02,{
	mes "[Lonza]";
	mes "如果您是为时尚生死相随的杜拉姆，请相信我。随着音乐节拍起舞吧～";
	next;
	switch(select("改变造型:结束对话")) {
	case 1:
		close2;
		openstylist();
		end;
	case 2:
		mes "[Lonza]";
		mes "没有所谓的坏天气，对吧？总有一天我希望您能相信我。";
		mes "我是 Lonza，可以为您带来惊艳的时尚改变，随时欢迎来找我。";
		close;
	}
}


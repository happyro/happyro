//===== rAthena Script ======================================= 
//= God Item Quest - Brisingamen Seal
//===== By: ================================================== 
//= SinSloth
//===== Current Version: ===================================== 
//= 1.7
//===== Compatible With: ===================================== 
//= rAthena Project
//===== Description: ========================================= 
//= Quest for breaking the seal of Brisingamen.
//===== Additional Comments: =================================
//= 1.0 First version. Thanks to SinSloth for scripting it. [MasterOfMuppets]
//= 1.0a Removed duplicates [Toms]
//= 1.1 Corrected NPC names to fall within proper restrictions. [L0ne_W0lf]
//= 1.2 Updated several aspects of the script. [L0ne_W0lf]
//= 1.3 Minor Touchups to quest. [L0ne_W0lf]
//= 1.3a Changed some " + name +" to strcharinfo(0) [Samuray22]
//= 1.4 Replaced effect numerics with constants. [Samuray22]
//= 1.5 Corrected serverwide announcement. [L0ne_W0lf]
//= 1.6 Updated RE/Pre-RE EXP. [Euphy]
//= 1.7 Renewal script update. [Euphy]
//= 1.8 Renewal script update for ep16.1 [Capuche]
//============================================================

prt_fild08,175,374,3	script	Bard#brising	51,{
	cutin "god_nelluad01",2;
	if ($God2 >= $@god_check1 && $God3 < $@god_check2) {
		if (god_brising > 49) {
			mes "[内利奥德]";
			mes "哦，我想你一切顺利。其他事情怎么样？";
			next;
			mes "[内利奥德]";
			mes "也许我太敏感了，但感觉很快会发生什么。啊，别在意我，没什么大事，也许只是我想多了。";
			next;
			mes "[内利奥德]";
			mes "好，好，让我为你演奏一曲。想听吗？";
			next;
			switch(select("好啊，为什么不～:说点新闻？:不用了，谢谢。")) {
			case 1:
				mes "[内利奥德]";
				mes "那么，你想听哪首歌？";
				mes "";
				mes "选一首吧～";
				next;
				switch(select("布拉吉之诗:永恒混沌:黄昏刺客:尼伯龙根之戒")) {
				case 1:
					cutin "god_nelluad02",2;
					mes "[内利奥德]";
					mes "布拉吉之诗！";
					mes "真是好选择！";
					mes "这首歌体现了";
					mes "";
					mes "诗人的心！";
					soundeffect "bragis_poem.wav",1;
					close2;
					break;
				case 2:
					cutin "god_nelluad02",2;
					mes "[内利奥德]";
					mes "永恒混沌……";
					mes "听起来太混乱了。";
					mes "顺便，我想知道";
					mes "标题究竟";
					mes "是什么意思。是地狱的混沌";
					mes "还是我们的现实？";
					soundeffect "chaos_of_eternity.wav",1;
					close2;
					break;
				case 3:
					cutin "god_nelluad02",2;
					mes "[内利奥德]";
					mes "黄昏刺客！";
					mes "是的，没有人比黄昏中的刺客更酷！死亡使者独自站在夕阳下！嘿嘿～";
					soundeffect "assassin_of_sunset.wav",1;
					close2;
					break;
				case 4:
					cutin "god_nelluad02",2;
					mes "[内利奥德]";
					mes "尼伯龙根之戒……";
					mes "好，准备好听了吗？";
					mes "哼哼哼……";
					next;
					soundeffect "ring_of_nibelungen.wav",1;
					mes "^4D4DFF莱茵黄金……";
					mes "隐藏在莱茵河。";
					mes "如果做成戒指，";
					mes "就能统治世界～^000000";
					next;
					mes "^4D4DFF被魔法保护，";
					mes "诅咒盗贼";
					mes "永远找不到爱情。";
					mes "阿尔伯里希知道这一点，";
					mes "仍然偷走它。";
					mes "为了力量舍弃爱情。^000000";
					next;
					mes "^4D4DFF巨人建造美丽的瓦尔哈拉，";
					mes "以与芙蕾雅女神结婚";
					mes "作为代价。";
					mes "";
					mes "由于没得到报酬，";
					mes "他们强行带走她。^000000";
					next;
					mes "^4D4DFF诸神会把阿尔伯里希的宝藏";
					mes "交给巨人";
					mes "换回芙蕾雅。";
					mes "洛基欺骗阿尔伯里希，";
					mes "夺走他的戒指和力量。^000000";
					next;
					mes "^4D4DFF但阿尔伯里希诅咒了戒指，";
					mes "在归还给他前，";
					mes "嫉妒与死亡会";
					mes "降临佩戴者。^000000";
					next;
					mes "^4D4DFF戒指交给巨人，";
					mes "芙蕾雅归还诸神，";
					mes "巨人自相残杀，";
					mes "争夺莱茵黄金，";
					mes "成为阿尔伯里希诅咒的牺牲品～^000000";
					close2;
					break;
				}
				break;
			case 2:
				mes "[内利奥德]";
				mes "你说新闻吗……";
				mes "你想听什么";
				mes "方面的新闻？";
				next;
				switch(select("普隆德拉的新闻！:沿海地区的新闻。:沙漠还是那么热吗？:边境地区怎么样？")) {
				case 1:
					mes "[内利奥德]";
					mes "什么？！普隆德拉？！";
					mes "你没看到普隆德拉的";
					mes "正门就在你面前吗？冒险者，至少应该知道自己在哪里。";
					next;
					mes "[内利奥德]";
					mes "总之，我有一条关于普隆德拉的有趣消息。不过这是秘密。嘘！你……单身吗？";
					next;
					cutin "god_nelluad04",2;
					mes "[内利奥德]";
					mes "如果是，就去酒馆看看。我在那里遇到一个带我去好地方的人。没错，他带我去了‘那个地方’，单身者禁止入内～！";
					close2;
					break;
				case 2:
					mes "[内利奥德]";
					mes "沿海地区？";
					mes "真是个有趣的问题。阿尔伯塔和其他几个地方都能看到大海。";
					next;
					mes "[内利奥德]";
					mes "西南方有";
					mes "可可莫海滩。不过，专程去那里散步应该太危险了。";
					next;
					mes "[内利奥德]";
					cutin "god_nelluad03",2;
					mes "可可莫海滩是一大片沙地。附近海水里有许多海洋生物，你可以尽情捕捉贝壳。";
					mes "";
					next;
					mes "[内利奥德]";
					mes "不过那种地方总有恶霸。有一次，我遇到一个红色刺发、看起来很吓人的暴徒。";
					next;
					mes "[内利奥德]";
					cutin "god_nelluad04",2;
					mes "他嚼着什么东西，然后吐在地上。那个大笨蛋居然吓得我把所有 Zeny 都给了他！";
					next;
					mes "[内利奥德]";
					mes "^333333*叹气……*^000000";
					mes "这个世界对年轻而";
					mes "脆弱的吟游诗人来说";
					mes "太危险了。";
					next;
					mes "[内利奥德]";
					mes "顺便说一句，阿尔伯塔似乎没有变化。沉船也还是老样子，到处都是骷髅海盗之类的。你知道的。";
					next;
					mes "[内利奥德]";
					cutin "god_nelluad01",2;
					mes "负责沉船探险的活动机构仍然赚得盆满钵满。如果你无事可做，为什么不去那里猎杀魔物呢？";
					close2;
					break;
				case 3:
					mes "[内利奥德]";
					mes "哦，当然热！";
					mes "什么时候不热呢？";
					mes "沙漠很热，过去一直热，";
					mes "以后大概也会一直热……！";
					mes "";
					next;
					mes "[内利奥德]";
					mes "巨大的虫子仍会凭空跳出，把我这样的无辜旅人吓得魂不附体；沙人仍会踢人的……嗯，你知道是哪里。";
					next;
					mes "[内利奥德]";
					mes "即使沙漠里充满可怕的魔物，那里眺望海洋的景色仍然壮丽。哈，让我忍不住想奏一曲。";
					next;
					mes "[内利奥德]";
					mes "我必须说，沙漠里有";
					mes "一个你可能想去";
					mes "看看的地方。";
					next;
					mes "[内利奥德]";
					cutin "god_nelluad02",2;
					mes "我说的是刺客公会。据说它隐藏在梦罗克沙漠的沙尘暴后面！";
					if (Class == Job_Assassin || Class == Job_Assassin_Cross) {
						mes "不过你应该知道我在说什么！那么，你什么时候带我去公会，嗯？";
					}
					else {
						mes "你以前去过那里吗？";
					}
					close2;
					break;
				case 4:
					mes "[内利奥德]";
					mes "嗯，北方是修发兹瓦尔德共和国。";
					mes "在那里，你会找到朱诺，";
					mes "‘贤者之城’。";
					next;
					mes "[内利奥德]";
					cutin "god_nelluad03",2;
					mes "那里的人说有一个大麻烦，一个被称为";
					mes "‘疯狂科学家’的人。他不合群，还用实验制造许多公共骚乱。";
					next;
					mes "[内利奥德]";
					mes "朱诺的所有人似乎都";
					mes "恨透了他。甚至有一位工具店老板恳求路过的冒险者阻止这个疯狂科学家的研究！";
					next;
					mes "[内利奥德]";
					mes "但我对他的看法不同。我认为打断任何科学家的工作都不是好主意。";
					next;
					mes "[内利奥德]";
					mes "毕竟，即使他的实验有些危险，他也可能发现重要的东西。";
					next;
					mes "[内利奥德]";
					mes "说到发现，你知道朱诺漂浮在空中，对吧？";
					next;
					mes "[内利奥德]";
					cutin "god_nelluad01",2;
					mes "据说一块伊米尔之心就能产生足够的力量，";
					mes "让整座城市漂浮在天空中。是不是很神奇？";
					next;
					mes "[内利奥德]";
					mes "更近的消息是发现了伊米尔之书。你可以在朱诺的贤者城堡阅读它。我听说其中记载着与女武神相遇的秘密……";
					close2;
					break;
				}
				break;
			case 3:
				mes "[内利奥德]";
				mes "嗯？好吧，那下次再聊。愿布拉吉在旅途中保佑你。";
				close2;
				break;
			}
		}
		else if ((god_brising > 0) && (god_brising < 50)){
			mes "[内利奥德]";
			mes "那么，你见到";
			mes "凯里先生了吗？";
			mes "请加油。";
			mes "毕竟，是我特别";
			mes "推荐了你～";
			next;
			switch(select("给我讲个故事。:为我唱首歌。")) {
			case 1:
				cutin "god_nelluad02",2;
				mes "[内利奥德]";
				mes "嗯。这次给你讲什么";
				mes "故事好呢……？啊，有了。";
				mes "让我讲讲自己的冒险吧。那是一次相当惊人的经历。";
				next;
				mes "[内利奥德]";
				mes "我去了沙漠之城梦罗克。路上被炎热弄得精疲力竭。幸运的是，我在阴影下发现一个洞，就爬进去休息。";
				next;
				mes "[内利奥德]";
				mes "我的天……";
				mes "早知道的话，";
				mes "我绝不会";
				mes "进入那个地方……";
				next;
				mes "[内利奥德]";
				mes "我竟然爬进了臭名昭著的^FF0000蚂蚁地狱^000000！我听起来不像胆小鬼吧？";
				next;
				mes "[内利奥德]";
				mes "那里不只有蚂蚁。我一点也不怕它们。当然，它们成群攻击时除外。";
				next;
				cutin "god_nelluad03",2;
				mes "[内利奥德]";
				mes "我真正害怕的是一种草莓色的……舌头一样的东西。弗里奥尼！";
				next;
				mes "[内利奥德]";
				mes "幸运的是我活过了那次事件，虽然至今还会梦见那条人一样大的舌头。";
				next;
				mes "[内利奥德]";
				mes "离开那里后，我渴望与人相伴来恢复正常感。离我最近的熟悉地点是帕罗斯灯塔。";
				next;
				mes "[内利奥德]";
				mes "我又一次决定穿越沙漠，尽管卡普拉小姐提供非常方便的传送服务。";
				next;
				cutin "god_nelluad01",2;
				mes "[内利奥德]";
				mes "总之，桑达鲁曼要塞就在去帕罗斯灯塔的路上。我记得在梦罗克南部遇到的塞鲁特罗曾告诉我那里的美景。";
				next;
				mes "[内利奥德]";
				mes "我很兴奋，";
				mes "想亲眼看看。";
				mes "毕竟，‘桑达鲁曼’听起来不就是";
				mes "美丽地方的名字吗？";
				next;
				mes "[内利奥德]";
				mes "但抵达后我立刻后悔了。当然，景色确实令人屏息：海边的沙丘，";
				mes "还有那些遗迹。";
				next;
				mes "[内利奥德]";
				mes "当然，我忘了塞鲁特罗关于魔物的警告。啊！那简直是噩梦！我没能欣赏风景，反而为了活命逃跑。";
				next;
				mes "[内利奥德]";
				mes "我还在躲避那些魔物时，偶然发现";
				mes "桑达鲁曼西边一栋似乎已经腐朽的老房子。";
				next;
				mes "[内利奥德]";
				mes "我想起塞鲁特罗说那里无人居住，于是有些担心。不过我走投无路，需要避难。";
				next;
				mes "[内利奥德]";
				mes "慌乱中，我用力敲门，喊着让人放我进去。然后你知道我听到了什么吗？";
				next;
				mes "[内利奥德]";
				cutin "god_nelluad03",2;
				mes "^FF0000谁在那里？！";
				mes "谁敢闯入";
				mes "我的领地？^000000";
				mes "我吓坏了！那栋房子的主人一定是个";
				mes "疯子！";
				next;
				mes "[内利奥德]";
				mes "然、然后，死神的阴影紧追着我，他让我滚开！幸运的是，我被一位神秘的流浪超级初心者救了，不过那是另一个故事。";
				next;
				mes "[内利奥德]";
				mes "不管怎样，我终于抵达了帕罗斯灯塔。在那里，我得知那栋老房子是盗贼公会的秘密营地。";
				next;
				mes "[内利奥德]";
				mes "他们竟能生活在如此危险的地方，真令人惊叹。只有盗贼才能在那里生存，你说对吧？";
				next;
				mes "[内利奥德]";
				cutin "god_nelluad01",2;
				mes "啊……";
				mes "说了这么多我好累。不过如果我再遇到冒险，一定会把故事分享给你。";
				close2;
				break;
			case 2:
				cutin "god_nelluad02",2;
				mes "[内利奥德]";
				mes "啊，你想";
				mes "听首歌吗？";
				mes "好吧！那我就";
				mes "演奏我最喜欢的。";
				next;
				mes "[内利奥德]";
				mes "我追逐名声。";
				mes "它却躲开了我。";
				mes "我追赶幸福，";
				mes "却始终没能抓住。";
				next;
				mes "[内利奥德]";
				mes "但我相信明天";
				mes "依然会到来。";
				mes "就像艾尔帕兰的";
				mes "水车，";
				mes "随着";
				mes "生活继续转动。";
				next;
				cutin "god_nelluad04",2;
				mes "[内利奥德]";
				mes "振作起来！生活还要继续。";
				mes "就像水车";
				mes "水车转动，";
				mes "明天终会到来。";
				close2;
				break;
			}
		}
		else {
			mes "[内利奥德]";
			mes "那个……";
			mes "我们以前见过吗？";
			mes "嗯？没有？好吧……";
			mes "真是奇怪。";
			next;
			mes "[内利奥德]";
			mes "I seem to recall that you've asked me to give you some information if I ever have any. Well, now I have and shall share it with you~";
			next;
			mes "[内利奥德]";
			mes "这条信息有没有用取决于你。现在，你听说过^3333CC魔物研究机构^000000吗？";
			next;
			mes "[内利奥德]";
			mes "I happened to get this information from its headquarters in Juno. So how does that sound?";
			next;
			switch(select("耶～我想听！:无聊～")) {
			case 1:
				mes "[内利奥德]";
				mes "嗯……！";
				mes "你似乎对我掌握的";
				mes "这点新知识";
				mes "非常兴奋～";
				mes "";
				next;
				if (BaseLevel < 70) {
					cutin "god_nelluad03",2;
					mes "[内利奥德]";
					mes "唉，这条信息对你这样的人似乎没什么价值。";
					next;
					mes "[内利奥德]";
					mes "很抱歉让你白高兴了，只有足够强大、能应付艰苦工作的人才能从中受益。";
					next;
					mes "[内利奥德]";
					mes "为什么不四处旅行、积累更多经验呢？等你准备好时我会告诉你～";
					close2;
				}
				else {
					cutin "god_nelluad02",2;
					mes "[内利奥德]";
					mes "哦……";
					mes "而且你看起来";
					mes "能应付";
					mes "这类信息。";
					mes "我会把知道的一切都告诉你！";
					next;
					mes "[内利奥德]";
					mes "有一天，一位冒险者发现了一个奇怪而神秘的物体。他无法弄清用途，于是拜访了魔物研究机构。";
					next;
					cutin "god_nelluad01",2;
					mes "[内利奥德]";
					mes "在那里，物体被交给名叫凯里的学者。他至今仍未揭开物体的真相，希望有人协助调查。";
					next;
					mes "[内利奥德]";
					mes "凯里先生怀疑那件物体可能是未被发现的古代遗物的一部分。幸运的是，他也在研究王室交办的古代遗物项目。";
					next;
					mes "[内利奥德]";
					mes "你觉得怎么样？很有趣吧？当然，想了解更多的话最好去找凯里先生。如果你愿意，我可以给你写一封推荐信。";
					next;
					switch(select("好！听起来不错。:抱歉，我没那么感兴趣。")) {
					case 1:
						mes "[内利奥德]";
						mes "太好了……！";
						mes "所以你的名字是……";
						mes "" + strcharinfo(0) + "?";
						next;
						mes "[内利奥德]";
						mes "好，我马上联系他！哦，你可以在朱诺中央广场西边找到魔物研究机构。应该不难找。祝你好运！";
						set god_brising,1;
						close2;

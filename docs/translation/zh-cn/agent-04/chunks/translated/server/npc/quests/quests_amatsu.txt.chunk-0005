		mes "哦，是你吗……你就是那个";
		mes "驱除狐狸的人……欢迎。";
		mes "请坐……";
		next;
	mes "";
	mes "";
	mes "";
	mes "";
	mes "";
	mes "";
		mes "回想起来，被狐狸附身";
		mes "是我的错。 我把";
		mes "儿子教坏了……哦～";
		mes "他小时候是个好孩子";
		mes "我对他不够严格……";
		next;
		mes "[石田佐子]";
		mes "很久以前，这个镇子没有现在这么大";
		mes "，也没有";
		mes "像桃光城那样的宫殿。后来有一天，";
		mes "我的儿子给村子带来巨额财富。";
		mes "他从没说过如何赚到那些钱……";
		next;
		mes "[石田佐子]";
		mes "他建造宫殿，帮助";
		mes "居民并扩大城镇。";
		mes "他一直很完美，直到……";
		mes "他开始做奇怪的事。";
		next;
		mes "[石田佐子]";
		mes "那些……激怒上帝的事。";
		mes "他学习禁忌魔法，";
		mes "进行实验，";
		mes "在宫殿里囚禁怪物，";
		mes "做尽各种可怕的事……";
		next;
		mes "[石田佐子]";
		mes "这就是为什么";
		mes "桃光城里有怪物……最后，";
		mes "上帝的愤怒被释放。连神社的祭司也无能为力……";
		next;
		mes "[石田佐子]";
		mes "最后，愤怒降临到";
		mes "我身上……似乎上帝想用狐狸警告儿子。";
		mes "然而我儿子不会停止。";
		next;
		mes "[石田佐子]";
		mes "如果可以，请阻止我儿子。";
		mes "我时间不多了。";
		mes "我不知道该怎么办……";
		mes "请拯救这个和平的村子。";
		mes "求求你……";
		mes "他到底在想什么……？";
		close;
	}
	mes "[....]";
	mes "^FF6060嗷，嗷，又一个愚蠢的人类！";
	mes "嗷，嗷，什么！人类！？";
	mes "你在做什么！";
	mes "走开……嗷！嗷！^000000";
	next;
	mes "[....]";
	mes "^FF6060我会一直待在这里，直到石田家族绝后！";
	mes "别打扰我！嗷！^000000";
	close2;
	warp "amatsu",167,197;
	end;
}
	
amatsu,189,166,5	script	Kouji#ama	764,{
	mes "[Kouji]";
	mes "Ralralrah Ralralrah Ralralrahralralrah~";
	mes "Ralralrah Ralralrah Ralralrahralralrah~";
	next;
	mes "[Kouji]";
	if (event_amatsu == 1) {
		mes "生病时，年糕可没用～";
		mes "家人的帮助才最好～";
		mes "药物无效时你就会发现～";
		mes "妈妈的爱对我最好～";
	}
	else if (event_amatsu == 2) {
		set event_amatsu,3;
		mes "祭司，祭司～";
		mes "有狐狸跟着我！";
		mes "很可笑，也有点荒唐，";
		mes "但我需要油豆腐面！";
	}
	else if (event_amatsu == 3) {
		mes "祭司，祭司～";
		mes "有狐狸跟着我！";
		mes "如果我大喊大叫它还不走！";
		mes "北方神社祭司应该能帮我～";
		if (isbegin_quest(8132) == 1)
			changequest 8132,8133;
	}
	else if (event_amatsu == 4) {
		mes "祭司，祭司～";
		mes "有狐狸跟着我。";
		mes "如果喊叫吓不走狐狸，";
		mes "也许需要老虎和熊帮忙～！";
		next;
		mes "[Kouji]";
		mes "这场战斗还需要别的吗？？？";
		mes "也许需要服事提供的水～！";
	}
	else if (event_amatsu == 5) {
		mes "可怕可怕的港口船～";
		mes "没有人，满是宝藏～";
		mes "但我不记得～！";
		mes "这首歌的后面了……？？？";
	}
	else {
		mes "蓝色天空下的蓝色屋顶";
		mes "蓝色湖泊上的蓝色墙壁";
		mes "蓝色心灵中的蓝色愿望";
		mes "蓝蓝蓝，一切都是蓝色";
	}
	next;
	mes "[Kouji]";
	mes "Ralralrah Ralralrah Ralralrahralralrah~";
	mes "Ralralrah Ralralrah Ralralrahralralrah~";
	close;
}
	
ama_in01,169,173,1	script	Shaman#ama	769,{
	mes "[Tokako]";
	mes "呃，我其实不是巫师……";
	mes "朋友竹笛君带我来这里，";
	mes "邀请我试穿这些衣服。";
	next;
	mes "[Tokako]";
	mes "他让我做很多奇怪的事，但很有趣。";
	mes "有时我不知道他在想什么。";
	mes "不过他是个好朋友。";
	next;
	mes "[Tokako]";
	mes "如果你对什么好奇，就问竹笛君。";
	mes "他知道别人不了解的神秘学和秘术。";
	mes " ";
	close;
}
	
ama_in01,180,173,3	script	Kitsune Mask#ama	762,{
	if (event_amatsu == 3) {
		mes "";
		mes "";
		mes "";
		mes "";
		mes "";
		mes "";
		mes "";
		mes "";
		mes "";
		mes "";
		mes "";
		mes "";
		mes "咦，你是外国人。";
		mes "你来找我一定是因为狐狸的麻烦。";
		mes "从你的脸上就能看出来。";
		next;
		mes "[Takehue]";
		mes "本来应该由首席祭司帮助你，";
		mes "但这座神社很久以前就废弃了。";
		next;
		mes "[Takehue]";
		mes "把狐狸从人体驱逐很难。";
		mes "如果有酒和油豆腐面会容易些，";
		mes "但这些东西很难找到。";
		next;
		mes "[Takehue]";
		mes "我对狐狸略有了解，告诉你一些事……";
		mes "狐狸喜欢捉弄人，";
		mes "但很少会渴望复仇。";
		mes " ";
		next;
		mes "[Takehue]";
		mes "如果狐狸想复仇，说明人类伤害了它。";
		mes "狐狸会向你、你的家人，";
		mes "甚至亲密朋友复仇！";
		next;
		mes "[Takehue]";
		mes "总之，更强的精神力能把狐狸从人体驱逐。";
		mes "来，大喊出来，展示你的精神！";
		mes " ";
		next;
		select("啊啊啊！！");
		set event_amatsu,4;
		mes "[Takehue]";
		mes "很好。多向狐狸展示几次这种精神能量。";
		mes "迟早会成功。";
		if (isbegin_quest(8132) == 1)
			changequest 8132,8134;
		else if (isbegin_quest(8133) == 1)
			changequest 8133,8134;
		close;
	}
	else if (event_amatsu == 4) {
		mes "[Takehue]";
		mes "别忘了，你还需要比狐狸更强动物的化身。";
		mes "没有这些，集中精神也没用。";
		close;
	}
	else {
		mes "[Takehue]";
		mes "咦？外国人。这座神社很久没有祭司了。";
		mes "我和朋友户卡子来这里玩。";
		next;
		mes "[Takehue]";
		mes "如果被怪物追赶，请放松。";
		mes "怪物不能来这里，所以在这里休息吧。";
		close;
	}
}


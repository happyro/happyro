	mes "你想用哪种石头升级？";
	next;
	if (.@part == EQI_COSTUME_HEAD_TOP)
		.@slot = select( "上部", "中部", "下部", "Cancel" ) - 1;	// the slot enchanted changes according to the location
	else if (.@part == EQI_COSTUME_HEAD_MID)
		.@slot = select( "", "中部", "下部", "Cancel" ) - 1;

			mes "^0000cd10 块海之石^000000。你可以在科摩多猎杀美杜莎时获得。因为美杜莎很难杀，所以它们很珍贵。";
			next;
			mes "[Jurgen]";
			mes "还有^0000cd1 朵永恒玫瑰^000000。";
			next;
			mes "[Jurgen]";
			mes "我知道要带的东西很多，但我相信这些都能让妹妹好受些。";
			close3;
		}
		mes "[Jurgen]";
		mes "亲爱的冒险者，你带来我们要的东西了吗？请告诉我们你带来了。";
		next;
		cutin "16isa",1;
		mes "[Isaac]";
		mes "是的，请告诉我们你带来了。我们尽力平息她的怒火，但她一直对我们冷淡。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "我带来了。你知道，最好不要那么不耐烦地逼迫正在生气的人。";
		next;
		cutin "16jur_nor",0;
		mes "[Jurgen]";
		mes "哇，全都在这里！你救了我们的命。现在该叫妹妹了。要是她还在生我们的气……";
		next;
		cutin "16isa",1;
		mes "[Isaac]";
		mes "我已经叫她了。";
		next;
		cloakoffnpcself( "Katrin Wigner#ep16wig" );
		cutin "16kat_nor",2;
		mes "[Katrin]";

		mes "[Timid Cat]";
		mes "使魔真的很可怕。";
		mes "它们总是在飞。";
		next;
		mes "[Timid Cat]";
		mes "这是最后一课，打起精神。";
		mes "我会稍微帮助你。";
		mes "来，我恢复了你的体力，喵……";
		npcskill "AL_HEAL",11,99,60;
		percentheal 100,100;
		close;
	}
	if (para_suv01 >= 10) {
		mes "[Timid Cat]";
		mes "你完成了“征服下水道”。";
		mes "回伊甸园总部向 Boya 报告。";
		next;
		mes "[Timid Cat]";
		mes "Boya 等你的时候可能会把我的金枪鱼吃掉。";
		close;
	}
	mes "[Timid Cat]";
	mes "你好吗，喵？";
	mes "你自愿征服下水道了吗？";
	mes "你当然是伊甸园集团的成员。";
	mes "你正在帮助世界变得更美好。";
	close;
}

pay_arche,41,136,3	script	Eden Member Karl#para05	904,{
	if (para_suv01 < 13) {
		if (callfunc("F_HasEdenGroupMark")) {
			mes "[Karl]";
			mes "嘿，你好吗？";
			mes "很高兴见到你~";
			mes "你要进去吗？";
			close;
		}
		mes "[Karl]";
		mes "嗯……？";
		mes "你不是我要等的人。";
		close;
	}
	if (para_suv01 == 13) {
		mes "[Karl]";
		mes "你好？";
		mes "收到报告后，我一直在等你。";
		mes "你来这里参加训练任务，对吧？";
		next;
		mes "[Karl]";
		mes "你以前进过这个洞穴吗？";
		mes "不知道你是否已经听说过这个村子的故事。";
		next;
		mes "[Karl]";
		mes "这里有许多死者灵魂，变成真人模样并发出威胁。";
		mes "真糟糕，对吧？";
		next;
		mes "[Karl]";
		mes "所以我们把这里选为战斗训练任务第二步。";
		mes "这一步叫“征服鬼洞~”。";
		mes "帮助人们舒适地度过夜晚。";
		next;
		mes "[Karl]";
		mes "那里有很多危险的东西。嗯……";
		mes "对你来说，第一层就够了。";
		next;
		mes "[Karl]";
		mes "让我们征服危险的鬼洞……";
		mes "杀死里面的骸骨骷髅。";
		next;
		mes "[Karl]";
		mes "这些骨头来自骷髅。";
		mes "其实骷髅和普通骨头都差不多，不过……";
		next;
		mes "[Karl]";
		mes "骷髅是不死族的基础种类之一。";
		mes "不死族永远不会真正死去。狩猎 15 只不死骷髅。";
		next;
		mes "[Karl]";
		mes "感到危险就离开，不要犹豫。";
		mes "你不担心受伤，对吧？";
		set para_suv01,14;
		changequest 7138,7139;
		close;
	}
	if (para_suv01 == 14) {
		if (checkquest(7139,HUNTING) == 2) {
			mes "[Karl]";
			mes "你明白不死属性的机制了吗？";
			mes "如你所知，不死族不会死亡，所以活人的祝福对它们来说等同于诅咒。";
			next;
			mes "[Karl]";
			mes "所以，能救人的治愈术和复活术等技能，";
			mes "对不死族来说都是非常强力的攻击。";
			next;
			mes "[Karl]";
			mes "总之……就是这样……";
			mes "接下来……我想你在杀骷髅时已经看到了。";
			mes "一些绿色的东西正在捡拾死去怪物掉落的所有物品。";
			next;
			mes "[Karl]";
			mes "你知道波利吗？它们也许和波利有关。";
			mes "它们看起来很糟糕，也许吃了毒药之类的东西。";
			next;
			mes "[Karl]";
			mes "好，准备好后就去杀死那些波波利。";
			mes "你应该狩猎 10 只。";
			next;
			set para_suv01,15;
			changequest 7139,7140;
			close;
		}
		mes "[Karl]";
		mes "骷髅是不死族的基础种类。";
		mes "使用治愈术或复活术。";
		mes "如果你能做到的话。";
		next;
		mes "[Karl]";
		mes "以防万一，我会恢复你的全部体力。";
		mes "这是最后一步，小心。";
		npcskill "AL_HEAL",11,99,60;
		percentheal 100,100;
		close;
	}
	if (para_suv01 == 15) {
		if (checkquest(7140,HUNTING) == 2) {
			mes "[Karl]";
			mes "你拿回 Poporing 偷走的东西了吗？";
		mes "这个洞穴很深，里面有很多它们可能捡到的珍贵物品。";
			next;
			mes "[Karl]";
		mes "你做得非常好。棒极了。";
		mes "第一层现在安全多了。谢谢你的帮助。";
			next;
			mes "[Karl]";
			mes "你完成了所有训练任务，回总部获得那位显眼符文骑士的认可吧。";
			next;
			mes "[Karl]";
		mes "你可能会得到一套新制服。";
		mes "哈哈。我会关注你的进展。";
			set para_suv01,16;
			changequest 7140,7141;
			close;
		}
		mes "[Karl]";
		mes "波波利比你想象的更强。";
		mes "如果把它们当作普通波利对待，你会惹上麻烦。";
		next;
		mes "[Karl]";
		mes "以防万一，我会恢复你的全部体力。";
		mes "这是最后一步，小心。";
		npcskill "AL_HEAL",11,99,60;
		percentheal 100,100;
		close;
	}
	if (para_suv01 >= 16) {
		mes "[Karl]";
		mes "我已经通知了伊甸园总部的 Boya。";
		mes "你去那里后，他会热烈欢迎你。";
		next;
		mes "[Karl]";
		mes "你会得到一套新制服，不兴奋吗？";
		mes "哈哈哈……";
		close;
	}
	mes "[Karl]";
	mes "杀死不死族？";
	mes "尽你所能让世界更安全。";
	mes "这是伊甸园集团的目标之一。";
	close;
}

anthell01,29,264,5	script	Eden Member Cloud#para06	899,{
	if (para_suv01 < 17) {
		if (callfunc("F_HasEdenGroupMark")) {
			mes "[Cloud]";
		mes "哎呀。";
		mes "你是我的团队成员。";
		mes "你为什么来这里？是在寻找危险吗？";
			next;
			mes "[Cloud]";
		mes "这里有最强大的 Boss 怪物之一。";
		mes "探索这里时要小心。";
			close;
		}
		mes "[Cloud ]";
	mes "你在看什么？";
	mes "我们彼此没有关系，对吧……";
		close;
	}
	if (para_suv01 == 17) {
		mes "[Cloud]";
		mes "Hello?";
		mes "你为什么来这里寻找危险？";
		next;
		switch (select("征服蚂蚁地狱:只是想见你:我在哪里？")) {
		case 1:
			mes "[Cloud]";
			mes "呃。征服蚂蚁地狱？你是这么说的吗？";
			mes "你是训练生。";
			mes "你来对地方了。";
			next;
			mes "[Cloud]";
			mes "首先我来介绍蚂蚁地狱。";
			mes "蚂蚁在沙地里挖了洞穴，并与地表相连。那就是蚂蚁地狱。";
			next;
			mes "[Cloud]";
			mes "沙子逐渐流入洞中。";
			mes "如果有人踩到洞口，就会从沙洞掉进洞穴……";
			next;
			mes "[Cloud]";
			mes "在那里很难生存。";
			mes "对我们来说这很平常，所以不像普通人那样是生死攸关的问题。";
			next;
			mes "[Cloud]";
			mes "许多种类的蚂蚁都来这里生活。";
			mes "这里有一只名叫 Maya 的 Boss 怪物，所以你要更加小心。";
			next;
			mes "[Cloud]";
			mes "好，先试着猎杀最弱的蚂蚁。";
			mes "最弱的蚂蚁叫 Pierre。";
			mes "它们就在下面。";
			next;
			mes "[Cloud]";
			mes "蚂蚁受到攻击时会互相协助。";
			mes "小心，杀死 15 只 Pierre 蚂蚁。";
			set para_suv01,18;
			changequest 7142,7143;
			close;
		case 2:
			mes "[Cloud]";
			mes "......";
		mes "哈哈……你在开玩笑吗？";
		mes "你已经被沙漠极热的天气累坏了。";
			next;
			mes "[Cloud]";
		mes "我是个大忙人。";
		mes "有个训练生本来要来找我，但那个人还没出现。我开始紧张了。";
			close;
		case 3:
			mes "[Cloud]";
		mes "你在哪里？";
		mes "你在梦罗克西南方的蚂蚁地狱。";
		mes "最近的城市是这里东北方的梦罗克。";
			close;
		}
	}
	if (para_suv01 == 18) {
		if (checkquest(7143,HUNTING) == 2) {
			mes "[Cloud]";
		mes "嘿，怎么了？";
		mes "也许你在猎杀 Pierre 时见过 Andre。";
			next;
			mes "[Cloud]";
		mes "那么，现在去猎杀 Andre 吧。";
		mes "哈哈，看你的眼神，是在说“为什么不一次让我做完”，对吧？";
			next;
			mes "[Cloud]";
		mes "这样不是更有趣吗？";
		mes "嘿，你下一个目标是 15 只 Andre！";
		mes "你很强，所以没问题！";
			next;
			mes "[Cloud]";
		mes "如果找不到 Andre，就深入洞穴。";
		mes "啊，还要小心 Maya。";
			set para_suv01,19;
			changequest 7143,7144;
			close;
		}
		mes "[Cloud]";
	mes "你觉得蚂蚁地狱怎么样？";
	mes "还能继续待下去吗？";
	mes "好，我会恢复你的体力，继续前进吧。";
		npcskill "AL_HEAL",11,99,60;
		percentheal 100,100;
		close;
	}
	if (para_suv01 == 19) {
		if (checkquest(7144,HUNTING) == 2) {
			mes "[Cloud]";
		mes "太棒了。看来你杀光了所有 Andre。";
		mes "和蚂蚁战斗感觉如何？";
		mes "还不错吧？";
			next;
			mes "[Cloud]";
		mes "嘿，打起精神。";
		mes "征服蚂蚁地狱还剩最后一步。";
		mes "你可能已经猜到下一个目标了。";
			next;
			mes "[Cloud]";
			mes "Vitata!";
		mes "怎么说呢……她像蜂蜜一样。";
		mes "Pierre 是工蚁，Andre 是守卫，所以……Vitata 就像母亲。";
			next;
			mes "[Cloud]";
		mes "她们对孩子和女性很友善，却不会怜悯蚂蚁。";
		mes "猎杀照顾蚂蚁卵的 Vitata。";
			next;
			mes "[Cloud]";
		mes "如果有人掉进蚂蚁地狱，那里可能会比以前安全一些。";
		mes "现在是最后一步，打起精神，杀死 10 只 Vitata。";
			next;
			mes "[Cloud]";
		mes "如果觉得太危险，就回来吧。";
		mes "我会治愈你。";
			set para_suv01,20;
			changequest 7144,7145;
			close;
		}
		mes "[Cloud]";
		mes "看，为了给你打气，我会一直治愈你直到训练结束。";
		mes "抬起头，打起精神。";
		npcskill "AL_HEAL",11,99,60;
		percentheal 100,100;
		close;
	}
	if (para_suv01 == 20) {
		if (checkquest(7145,HUNTING) == 2) {
			mes "[Cloud]";
		mes "哦……那场战斗可能很烦人。";
		mes "你完成得真快。";
			next;
			mes "[Cloud]";
		mes "干得好。回总部报告吧。";
		mes "你很快就完成了训练。";
			next;
			mes "[Cloud]";
		mes "你会得到好消息。";
		mes "即使天气炎热，你也做得非常好。";
			set para_suv01,21;
			changequest 7145,7146;
			close;
		}
		mes "[Cloud]";
		mes "看，为了给你打气，我会一直治愈你直到训练结束。";
		mes "抬起头，打起精神。";
		next;
		mes "[Cloud]";
		mes "只是 Vitata，不是很容易对付吗？";
		mes "如果看到 Maya 就赶快逃跑。";
		npcskill "AL_HEAL",11,99,60;
		percentheal 100,100;
		close;
	}
	if (para_suv01 >= 21) {
		mes "[Cloud]";
		mes "可以说你已经征服蚂蚁地狱了。";
		mes "你不是已经习惯这里了吗？";
		next;
		mes "[Cloud]";
		mes "回总部报告任务完成，快去吧。";
		mes "你会得到好消息。";
		mes "你还会收到伊甸园集团制服。";
		close;
	}
	mes "[Cloud]";
	mes "我真的为伊甸园集团感到骄傲。";
	mes "制服穿在我身上好看吗？";
	mes "哈哈……";
	close;
}

in_orcs01,38,175,3	script	Eden Member Hooksha	803,{
	if (para_suv01 < 24) {
		if (callfunc("F_HasEdenGroupMark")) {
			mes "[Hooksha]";
			mes "难以置信，你为什么来这里？";
			mes "嗯……你不是在进行训练的第三步吗？";
			mes "耶～我好兴奋～";
			next;
			mes "[Hooksha]";
			mes "等训练生让我有点无聊。他们在哪里？";
			close;
		}
		mes "[Hooksha]";
		mes "你好。";
		mes "你为什么来这里？";
		mes "嗯……啊啊啊……";
		next;
		mes "[Hooksha]";
		mes "你为什么不加入我的队伍？";
		mes "如果你有兴趣加入我们，";
		mes "你不会后悔这个决定。";
		close;
	}
	if (para_suv01 == 24) {
		mes "[Hooksha]";
		mes "Hello.";
		mes "你是训练生吗？";
		mes "是的，我看得出来。";
		mes "那么开始吧？";
		next;
		mes "[Hooksha]";
		mes "其实我不太喜欢这个训练任务，不过还是让我向你说明吧。";
		next;
		mes "[Hooksha]";
		mes "如你所知，这里是兽人村。";
		mes "兽人不喜欢人类。";
		mes "它们不尝试与我们交流，看到人类就会立即攻击。";
		next;
		mes "[Hooksha]";
		mes "遗憾的是，人类也不想和它们交流。";
		mes "所以我们决定对它们采取强硬手段。";
		mes "其实我们想把它们全部消灭。";
		next;
		mes "[Hooksha]";
		mes "我们正试图征服兽人村。";
		mes "对于你这样的冒险者来说，这里正适合完成新手训练任务。";
		next;
		mes "[Hooksha]";
		mes "所以我们选择这里执行任务。";
		mes "好，时间不多了，开始吧。";
		mes "先消灭最弱的目标。";
		next;
		mes "[Hooksha]";
		mes "最好在它们长大前杀死它们。";
		mes "猎杀 10 只兽人婴儿。";
		mes "不要同情它们，因为长大后会变成凶猛的兽人战士。";
		next;
		mes "[Hooksha]";
		mes "不论好坏，事情就是这样。";
		mes "即使它们还是婴儿，也不要犹豫。";
		set para_suv01,25;
		changequest 7147,7148;
		close;
	}
	if (para_suv01 == 25) {
		if (checkquest(7148,HUNTING) == 2) {
			mes "[Hooksha]";
		mes "太棒了。厉害。";
		mes "这不太令人愉快，所以继续前进吧。";
			next;
			mes "[Hooksha]";
		mes "下一步我们要和兽人战士战斗。";
		mes "兽人婴儿长大后会成为强大的兽人战士。";
			next;
			mes "[Hooksha]";
		mes "它们都是强大的战士。";
		mes "你和兽人婴儿战斗时，可能已经被它们攻击过了。";
			next;
			mes "[Hooksha]";
		mes "现在去猎杀 10 只兽人战士。";
		mes "遇到麻烦就回到这里避难。";
		mes "明白了吗？";
			set para_suv01,26;
			changequest 7148,7149;
			close;
		}
		mes "[Hooksha]";
		mes "兽人村里有兽人战士、兽人女战士和兽人婴儿。";
		mes "它们非常好斗。";
		next;
		mes "[Hooksha]";
		mes "你看起来很累，我会恢复你的生命值。";
		mes "遇到麻烦就回到这里避难。";
		npcskill "AL_HEAL",11,99,60;
		percentheal 100,100;
		close;
	}
	if (para_suv01 == 26) {
		if (checkquest(7149,HUNTING) == 2) {
			mes "[Hooksha]";
		mes "现在可以进入下一步了。";
			next;
			mes "[Hooksha]";
		mes "没错……现在去猎杀兽人女战士。";
		mes "如果想彻底征服兽人村，就该在它们生下更多兽人婴儿前杀死它们。";
			next;
			mes "[Hooksha]";
		mes "但不需要把它们全部杀死。";
		mes "去猎杀 10 只兽人女战士。";
			next;
			mes "[Hooksha]";
		mes "你已经能感受到外面的强大力量……";
		mes "不要犹豫，攻击它们吧。";
			set para_suv01,27;
			changequest 7149,7150;
			close;
		}
		mes "[Hooksha]";
		mes "你现在应该已经筋疲力尽了。";
		mes "但你还有更多目标，明白吗？";
		next;
		mes "[Hooksha]";
		mes "你看起来很累，我会恢复你的生命值。";
		mes "遇到麻烦就回到这里避难。";
		npcskill "AL_HEAL",11,99,60;
		percentheal 100,100;
		close;
	}
	if (para_suv01 == 27) {
		if (checkquest(7150,HUNTING) == 2) {
			mes "[Hooksha]";
		mes "干得好。";
		mes "现在你应该明白兽人村的兽人部落如何运作。";
		mes "你在炎热潮湿的环境中顺利完成了训练任务。";
		mes "你已经完成“征服兽人村！”训练任务。恭喜。";
			next;
			mes "[Hooksha]";
			mes "回伊甸园集团总部报告吧。";

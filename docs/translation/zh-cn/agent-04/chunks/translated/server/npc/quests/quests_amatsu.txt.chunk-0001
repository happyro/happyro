amatsu,223,236,3	script	Publisher#ama	763,{
	if (checkweight(1201,1) == 0) {
		mes "- 请稍等！！-";
		mes "- 你目前携带了 -";
		mes "- 太多物品。-";
		mes "- 请将部分物品存入卡普拉仓库 -";
		mes "- 然后再试。-";
		close;
	}
	if (event_momo < 2) {
	mes "";
	mes "";
	mes "";
	mes "";
		mes "";
		mes "";
		mes "你好～！！";
		mes "我们的 ^009CFF卷轴出版公司^000000";
		mes "专业出版";
		mes "故事。";
		mes " ";
		next;
		mes "";
		mes "";
		mes "我们设立了";
		mes "^3163FF桃太郎实地旅行^000000";
		mes "庆祝 ^009CFF<Momotaro Story>^000000 销量超过一百万册。";
		next;
		mes "[出版商]";
		mes "成为桃太郎并消灭";
		mes "像故事中一样消灭独眼怪！";
		mes "还会有奖励。";
		next;
		switch(select("什么是桃太郎故事？:我想试试！:我现在很忙……")) {
		case 1:
			mes "[出版商]";
			mes "咦～！？你怎么会不知道";
			mes "桃太郎？这里没有这个";
			mes "故事吗？？嗯……";
			mes "让我讲给你听。";
			next;
			mes "[出版商]";
			mes "很久以前，有一对老夫妻。他们很幸福，但没有孩子。";
			next;
			mes "[出版商]";
			mes "一天，老妇人洗衣服时发现一个巨大的桃子。";
			mes "她把桃子切成两半……";
			mes "‘噗！’里面竟然有个婴儿！";
			next;
			mes "[出版商]";
			mes "老夫妇大吃一惊。";
			mes "他们决定收养婴儿，";
			mes "把爱都给他……";
			next;
			mes "[出版商]";
			mes "婴儿成长得很快，像《杰克与魔豆》的豆茎，几天就成了强壮男孩。";
			mes " ";
			next;
			mes "[出版商]";
			mes "男孩的名字是……";
			mes "<Momotaro>!!!";
			mes "桃太郎踏上旅程，消灭骚扰镇民的";
			mes "独眼怪。";
			next;
			mes "[出版商]";
			mes "他和 ^3163FF悠悠、皮奇和沙漠之狼^000000 成为朋友，";
			mes "消灭了所有独眼怪，之后和老夫妇幸福地生活。";
			next;
			mes "[出版商]";
			mes "怎么样？";
			mes "很棒吧？";
			mes "这故事可是卖了一百万册！";
			close;
		case 2:
			if (BaseLevel > 29) {
				mes "[出版商]";
				mes "Yay-! You look excited!";
				mes "你很快就能出发。";
				mes "请填写登记卡。";
				next;
				mes "[出版商]";
				mes "....................";
				mes "……嗯……让我看看……";
				mes "……很好！";
				mes "好，那么！";
				mes "开始吧～～～！！！！！！！！！";
				mes "<桃太郎实地旅行>~!";
				next;
				warp "ama_test",52,35;
				end;
			}
			mes "[出版商]";
			mes "Hmm~";
			mes "再训练一下，";
			mes "然后回来吧？";
			close;
		case 3:
			mes "[出版商]";
			mes "Eh?";
		mes "……可是有甜蜜奖励等着你……";
			close;
		}
	}
	else if (event_momo == 4) {
		mes "[出版商]";
		mes "啊～天气真好！";
		mes "正适合阅读。";
		close;
	}
	else if (event_momo > 1) {
		mes "[出版商]";
		mes "怎么样？玩得开心吗？";
		mes "希望你实地旅行玩得愉快。";
		mes " ";
		mes " ";
		next;
		mes "[出版商]";
		mes "这是给你的奖励。";
		mes "请继续享受故事～";
		mes " ";
		set .@event_momo, event_momo;
		set event_momo,4;
		completequest 8128;
		completequest 8129;
		completequest 8130;
		if (.@event_momo == 3) {
			set .@gift_1,rand(1,10);
			if (.@gift_1 == 1) {
				getitem 659,1; //Heart_Of_Her
			}
			if (.@gift_1 == 2) {
				getitem 633,1; //Baked_Yam
			}
			if (.@gift_1 == 3) {
				getitem 634,1; //Tropical_Banana
			}
			if (.@gift_1 == 4) {
				getitem 639,1; //Armlet_Of_Obedience
			}
			if (.@gift_1 == 5) {
				getitem 636,1; //No_Recipient
			}
			if (.@gift_1 == 6) {
				getitem 628,1; //Well_Dried_Bone
			}
			if (.@gift_1 == 7) {
				getitem 637,1; //Old_Broom
			}
			if (.@gift_1 == 8) {
				getitem 635,1; //Horror_Of_Tribe
			}
			if (.@gift_1 == 9) {
				getitem 626,1; //Monster_Juice
			}
			if (.@gift_1 == 10) {
				getitem 641,1; //Contracts_In_Shadow
			}
		}
		else {
			set .@gift_2,rand(1,10);
			if (.@gift_2 == 1) {
				getitem 622,1; //Rainbow_Carrot
			}
			if (.@gift_2 == 2) {
				getitem 627,1; //Sweet_Milk
			}
			if (.@gift_2 == 3) {
				getitem 629,1; //Singing_Flower
			}
			if (.@gift_2 == 4) {
				getitem 632,1; //Fatty_Chubby_Earthworm
			}
			if (.@gift_2 == 5) {
				getitem 623,1; //Earthworm_The_Dude
			}
			if (.@gift_2 == 6) {
				getitem 619,1; //Unripe_Apple
			}
			if (.@gift_2 == 7) {
				getitem 621,1; //Bitter_Herb
			}
			if (.@gift_2 == 8) {
				getitem 620,1; //Orange_Juice
			}
			if (.@gift_2 == 9) {
				getitem 625,1; //Lusty_Iron
			}
			if (.@gift_2 == 10) {
				getitem 624,1; //Rotten_Fish
			}
		}
		close;
	}
}

ama_test,52,44,3	script	Assistant#ama	109,{
	if (event_momo == 0) {
		mes "";
		mes "";
		mes "";
		mes "";
		mes "";
		mes "";
		mes "";
		mes "";
		mes "";
		mes "欢迎来到<桃太郎实地旅行>";
		mes " ";
		next;
		mes "[Satoshi]";
		mes "我是负责<桃太郎实地旅行>等候室的聪。";
		next;
		mes "[Satoshi]";
		mes "我原本在出版社工作，但实地旅行缺人……";
		mes "不过这里的工作好多了！";
		mes "现在只要看着大家完成任务。嘿嘿嘿～";
		next;
		mes "[Satoshi]";
		mes "................";
		mes "开玩笑的。";
		mes "*擦汗*";
		next;
		mes "[Satoshi]";
		mes "好，让我解释一下";
		mes "实地旅行的规则。";
		mes " ";
		next;
		mes "[Satoshi]";
		mes "首先……你听出版社讲过故事了吗？";
		next;
		if (select("是:否") == 1) {
			mes "[Satoshi]";
			mes "嘿嘿……很好。";
			mes "桃太郎故事是我们的骄傲。";
			mes "这是史上最棒的故事。哈哈哈！！！";
			next;
			mes "[Satoshi]";
			mes "...Hmmhmm.";
			next;
			mes "[Satoshi]";
			mes "实地旅行很简单。";
			mes "勇敢地进去消灭独眼怪！！！";
			mes "就像桃太郎一样！！！";
			mes "明白吗？要勇敢！！！";
			next;
			mes "[Satoshi]";
			mes "此外，还有三件事需要知道。";
			next;
			mes "[Satoshi]";
			mes "第一……";
			mes "完成实地旅行后不能回来。记住这一点。";
			next;
			mes "[Satoshi]";
			mes "第二……";
			mes "实地旅行内禁止携带宠物。";
			mes "如果带着宠物，请将其变回蛋状态。";
			next;
			mes "[Satoshi]";
			mes "最后……";
			mes "每个人只能在实地旅行中停留 6 分钟。";
			next;
			mes "[Satoshi]";
			mes "那么，请在等候室排队。";
			mes "战斗好运！！";
			close;
		}
		mes "[Assistant]";
		mes "咦？进入实地旅行时不能";
		mes "跳过故事！！";
		mes "作为桃太郎粉丝，";
		mes "我不能允许你这样做！！！";
		next;
		mes "[Assistant]";
		mes "请听出版社讲故事。";
		mes "谢谢。";
		mes "拜拜～～";
		next;
		warp "amatsu",223,230;
		end;
	}
	else if (event_momo == 1) {
		mes "[Satoshi]";
		mes "天啊……你还好吗？";
		mes "我觉得很有趣，但也许对你太难了？";
		next;
		mes "[Satoshi]";
		mes "现在打算怎么办？";
		mes "还想再进去吗？";
		next;
		if (select("Yes:No, I want to go back") == 1) {
			mes "[Satoshi]";
			mes "投入越多努力，胜利就越甜美。";
			mes "战斗好运！";
			close;
		}
		mes "[Satoshi]";
		mes "嗯，看来你无法完成桃太郎的角色……";
		mes "不过别灰心。";
		next;
		mes "[Satoshi]";
		mes "我想你已经从实地旅行中获得了足够经验。";
		next;
		mes "[Assistant]";
		mes "如果听到好故事，";
		mes "请联系我们的出版社。";
		mes "出版社。";
		mes "Bye-";
		close2;
		percentheal 100,0;
		set event_momo,0;
		warp "amatsu",223,230;
		end;
	}
	else if (event_momo == 2) {
		mes "[Satoshi]";
		mes "呜呼～恭喜！！";
		mes "你表现得太棒了！";
		next;
		mes "[Satoshi]";
		mes "该说再见了。";
		mes "如果听到好故事，";
		mes "请联系我们的出版社。";
		mes "Bye-";
		close2;
		percentheal 100,0;
		warp "amatsu",223,230;
		end;
	}
	mes "[Satoshi]";
	mes "呜呼～恭喜！！";
	mes "你表现得太棒了！！";
	mes "虽然收尾有点弱……";
	next;
	mes "[Satoshi]";
	mes "该说再见了。";
	mes "如果听到好故事，";
	mes "请联系我们的出版社。";
	mes "Bye-";
	close2;
	warp "amatsu",223,230;
	end;

OnInit:
	waitingroom "Waiting Exhibit.",10,"Assistant#ama::OnStartArena",1;
	enablewaitingroomevent "Assistant#ama";
	end;

OnStartArena:
	disablenpc "Coach#ama";
	donpcevent "Am Mut#ama::OnReset";
	donpcevent "Dokebi#ez::OnReset";
	donpcevent "Dokebi#hd::OnReset";
	enablenpc "Grandma#ama1";
	enablenpc "Grandpa#ama";
	warpwaitingpc "ama_test",50,83;
	donpcevent "Timer#ama::OnEnable";
	disablewaitingroomevent "Assistant#ama";
	end;

OnReset:
	enablewaitingroomevent "Assistant#ama";
	end;
}


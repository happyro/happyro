//===== rAthena Script ======================================= 
//= Homunculus S Mutation Quest
//===== By: ================================================== 
//= Euphy
//===== Current Version: ===================================== 
//= 1.2
//===== Compatible With: ===================================== 
//= rAthena Project
//===== Description: ========================================= 
//= [Official Conversion]
//= Genetic quest to mutate a level 99 evolved Homunculus
//= into a Homunculus S.
//===== Additional Comments: ================================= 
//= 1.0 First Version, entirely custom. [Masao]
//= 1.1 Cleaning. [Euphy]
//= 1.2 Replaced with official script. [Euphy]
//= 1.3 Fixed Job Class for after Genetic. [Mazvi & Lemongrass]
//============================================================ 

// Main NPCs :: Homun_S
//============================================================
job3_gen01,12,44,3	script	Viorel#job3_gen01	542,{
	if (countitem(6415)) {
		if ((eaclass()&EAJ_THIRDMASK)==EAJ_GENETIC) {
			disable_items;
			if (checkquest(4159) == -1 && checkquest(4160) == -1) {
				mes "[Viorel]";
				mes "你为什么在这里？";
				mes "你不是该在^005DFFJeyna^000000的家吗？";
				close2;
				for(set .@i,4154; .@i<=4160; set .@i,.@i+1) {
					if (checkquest(.@i) > -1)
						erasequest .@i;
				}
				setquest 4154;
				setquest 4159;
				morphembryo;
				if (countitem(6415) == 0)
					getitem 6415,1; //Strange_Embryo
				else if (countitem(6415) > 1)
					delitem 6415, (countitem(6415) - 1); //Strange_Embryo
				warp "que_house_s",63,41;
				end;
			}
			enable_items;
		} else if (Class == Job_Novice_High || Class == Job_Merchant_High || Class == Job_Alchemist || Class == Job_Creator) {
			emotion ET_QUESTION;
			mes "[Viorel]";
			mes "我不知道发生了什么，但按我的记忆，你应该有资格研究^FF4800生命体^000000。";
			next;
			mes "[Viorel]";
			mes "不管什么原因，你都无法继续研究^FF4800生命体^000000。";
			mes "成为^005DFF基因研究者^000000并获得^0000FF生命伦理^000000后再回来。";
			close;
		} else {
			delitem 6415, countitem(6415); //Strange_Embryo
			mes "[Viorel]";
			mes "等等，你的胚胎似乎有点奇怪。";
			next;
			mes "[Viorel]";
			mes "除非你从事^FF4800生命体^000000研究……";
			mes "它对你完全没有帮助。";
			next;
			mes "[Viorel]";
			mes "我负责管理^0000FF奇怪胚胎^000000，我会替你处理。";
			mes "别介意，我在这里没有做坏事。";
			close;
		}
	}
	if (((eaclass()&EAJ_THIRDMASK)==EAJ_GENETIC) && (checkquest(4154) > -1)) {
		if ((checkquest(4155) > -1) || (checkquest(4160) > -1)) {
			mes "[Viorel]";
			mes "天气真好。";
			next;
			callsub L_CheckHomunculus;
			mes "[Viorel]";
			mes "准备去我家吗？";
			next;
			switch(select("去^005DFFViorel^000000的家。:不去。")) {
			case 1:
				mes "[Viorel]";
				mes "明智的选择。";
				mes "现在，闭上眼睛一会儿……";
				close2;
				warp "que_house_s",19,42;
				end;
			case 2:
				mes "[Viorel]";
				mes "准备好后回来。";
				mes "你必须带着^FF4800生命体^000000。";
				close;
			}
		} else {
			mes "[Viorel]";
			mes "你为什么在这里？";
			mes "你不是该在^005DFFJeyna^000000的家吗？";
			next;
			callsub L_CheckHomunculus;
			mes "[Viorel]";
			mes "现在准备去^005DFFJeyna^000000那里了吗？";
			next;
			switch(select("Go to ^005DFFJeyna^000000's room.:不去。")) {
			case 1:
				mes "[Viorel]";
				mes "明智的选择。";
				mes "现在，闭上眼睛一会儿……";
				close2;
				warp "que_house_s",63,41;
				end;
			case 2:
				mes "[Viorel]";
				mes "准备好后回来。";
				mes "你必须带着^FF4800生命体^000000。";
				close;
			}
		}
	}
	if (BaseJob == Job_Merchant) {
		mes "[Viorel]";
		mes "我以前也是商人，和你一样。";
		mes "我正在研究^FF4800生命体^000000。";
		next;
		mes "[Viorel]";
		mes "如果你对^FF4800生命体^000000感兴趣，就成为^005DFF炼金术士^000000或^005DFF创造者^000000。";
		close;
 	} else if (BaseJob == Job_Alchemist && Class < Job_Genetic) {
		mes "[Viorel]";
		mes "我在生命体上投入了大量时间和精力。";
		mes "如果觉得走投无路，下次带着^FF4800生命体^000000回来。";
		next;
		mes "[Viorel]";
		mes "哦。当然，你需要具备合适的潜力。成为^FF4800基因研究者^000000后大概就能证明自己。";
		close;
	} else if ((eaclass()&EAJ_THIRDMASK)==EAJ_GENETIC) {
		if (gethominfo(6) >= 99 && (gethominfo(1) >= 6009 && gethominfo(1) <= 6016)) { // Level 99+ evolved Homunculus
			mes "[Viorel]";
			mes "哦，太好了~！";
			mes "你拥有一个^FF4800生命体^000000。";
			mes "投入热情研究，我们可以让它们变得更好。";
			next;
			mes "[Viorel]";
			mes "我必须私下和你谈谈。愿意和我一起去我家吗？";
			next;
			switch(select("Go to ^005DFFViorel^000000's home.:Stay here.")) {
			case 1:
				mes "[Viorel]";
				mes "明智的选择。";
				mes "现在，闭上眼睛一会儿……";
				close2;
				setquest 4154;
				setquest 4155;
				warp "que_house_s",19,42;
				end;
			case 2:
				mes "[Viorel]";
				mes "如果觉得走投无路，下次带着^FF4800生命体^000000回来。";
				close;
			}
		} else if (gethominfo(6) >= 99 && (gethominfo(1) >= 6048 && gethominfo(1) <= 6052)) { // Level 99+ mutated Homunculus-S
			mes "[Viorel]";
			mes "又见面了。";
			mes "也许你会对这个感兴趣：";
			mes "新创造的^FF4800生命体^000000，";
			mes "诞生于新的^006400生命体变异系统^000000？";
			next;
			switch(select("不。再见。:拜托，我很忙。:这正是我想听的。:你为什么总站在那里？")) {
			case 1:
				emotion ET_SMILE;
				mes "[Viorel]";
				mes "好的。";
				mes "很高兴见到你。";
				mes "那再见～！";
				close;
			case 2:
				emotion ET_HUK;
				mes "[Viorel]";
				mes "!!!!";
				mes "我……明白了。";
				mes "我还以为你是来看我的。";
				close;
			case 3:
				emotion ET_AHA;
				mes "[Viorel]";
				mes "果然如此。";
				mes "让我们看看我亲爱的朋友 Jeyna 留下的笔记。";
				next;
				playbgm "30.mp3"; // One Step Closer
				callfunc "F_HomMutateInfo","[Memo Pad Notes]";
				mes "[Viorel]";
				mes "嗯。";
				mes "好了，事情就是这样。";
				mes "更多内容由你自己去发现。";
				close2;
				playbgm "08.mp3"; // Theme of Prontera
				end;
			case 4:
				emotion ET_SWEAT;
				mes "[Viorel]";
				mes "不，我不是每天都站在这里。";
				mes "但你为什么每天站在那里？";
				next;
				mes "[Viorel]";
				mes "什么？";
				mes "不，在我看来，";
				mes "每次我来这里时你似乎都在。";
				close;
			}
		} else {
			if (gethominfo(1) >= 6009) { // Evolved Homunculus
				mes "[Viorel]";
				mes "嗯，你似乎和你的^FF4800生命体^000000有特殊羁绊。";
				next;
				mes "[Viorel]";
				mes "等^FF4800生命体^000000达到^0000FF99 级^000000后再来找我。";
				close;
			} else {
				mes "[Viorel]";
				mes "你还没有进化后的^FF4800生命体^000000……";
				mes "关于进化，你应该知道：";
				next;
				mes "[Viorel]";
				mes "亲密度达到^006400亲密^000000后使用^0000FF贤者之石^000000，^FF4800生命体^000000就会进行^006400进化^000000。";
				close;
			}
		}
	}
	mes "[Viorel]";
	mes "^FF4800生命体^000000研究需要大量时间和资金。";
	mes "不过，我认为热情才是最重要的因素。";
	next;
	switch(select("结束对话。:你在说什么？:你为什么总站在那里？")) {
	case 1:
		mes "[Viorel]";
		mes "再见～！";
		close;
	case 2:
		mes "[Viorel]";
		mes "你看，^006400炼金术士^000000天生好奇。";
		mes "尤其是像我这样的人，甚至会思考创造生命本身。";
		next;
		mes "[Viorel]";
		mes "你必须研究^FF4800生命体^000000才能理解。";
		mes "那么，恕我失陪～！";
		close;
	case 3:
		emotion ET_SWEAT;
		mes "[Viorel]";
		mes "怎么，在自己的实验室看到炼金术士很奇怪吗？";
		mes "哪里奇怪？";
		close;
	}
	end;
L_CheckHomunculus:
	if (gethominfo(6) < 99 || (gethominfo(1) < 6009 || gethominfo(1) > 6016)) { // Not level 99+ evolved Homunculus
		mes "[Viorel]";
		mes "嗯？";
		mes "你以前拥有的^FF4800生命体^000000在哪里？";
		mes "也许是我认错了……";
		next;
		mes "[Viorel]";
		mes ".......";
		mes " ";
		mes "（似乎在思考什么。）";
		next;
		emotion ET_SMILE;
		mes "[Viorel]";
		mes "哈哈～";
		mes "我想我认错人了。";
		mes "失陪。";
		close;
	}
	return;
}

que_house_s,24,47,3	script	Viorel#homun_s	542,{
	if (checkquest(4155) > -1) {
		emotion ET_HUM;
		mes "[Viorel]";
		mes "很好。";
		mes "看来你是认真的。";
		next;
		playbgm "33.mp3"; // Yuna Song
		mes "[Viorel]";
		mes "也许你会同意。";
		mes "目前你的^FF4800生命体^000000还不是完美状态。";
		next;
		mes "[Viorel]";
		mes "最近，人们正在积极研究^FF4800生命体^000000的成长。";
		mes "不过，我相信自己发现了特别的东西。";
		next;
		mes "[Viorel]";
		mes "为了突破^FF4800生命体^000000当前的限制，必须进行变异。";
		next;
		switch(select("比如生物实验……？！:嗯，当然。:我不想伤害我的生命体！")) {
		case 1:
			emotion ET_PROFUSELY_SWEAT;
			mes "[Viorel]";
			mes "别那么惊讶。";
			mes "现在生物伦理有点模糊，对吧？";
			mes "我的意思是……";
			next;
			mes "[Viorel]";
			mes "研究^FF4800生命体^000000的真正潜力是我的职责。";
			next;
			mes "[Viorel]";
			mes "到目前为止，生命体还没有展现全部潜力，但我知道突破已经近在眼前。";
			next;
			break;
		case 2:
			emotion ET_OHNO;
			mes "[Viorel]";
			mes "是的。";
			mes "我很高兴你没有生气。";
			mes "变异，";
			mes "这个词会在普通人心中激起邪恶，";
			mes "这让我的研究很难继续。";
			next;
			mes "[Viorel]";
			mes "你还记得吗？";
			mes "^8B4513莱岔隆^000000的 ^005DFFKellasus^000000，^FF4800生命体^000000研究的先驱。";
			next;
			mes "[Viorel]";
			mes "我相信这项研究实现了我与传授知识和信念的 ^005DFFKellasus^000000 所做的约定。";
			next;
			break;
		case 3:
			emotion ET_SWEAT;
			mes "[Viorel]";
			mes "我理解你的担忧。";
			mes "但我向你保证，这种变异不会伤害你的^FF4800生命体^000000。";
			next;
			mes "[Viorel]";
			mes "恰恰相反，如今的^FF4800生命体^000000因不完美而痛苦，无法达到应有的潜力。";
			mes "而且，那些^FF4800生命体^000000经常被遗弃。";
			next;
			mes "[Viorel]";
			mes "别误会，我研究^FF4800生命体^000000是因为我喜欢它们。";
			next;
			break;
		}
		mes "[Viorel]";
		mes "顺便说一下……";
		mes "我发现这种新变异相当稳定。";
		next;
		mes "[Viorel]";
		mes "^006400这项技术已经存在，";
		mes "变异后很可能会获得新的";
		mes "技能……^000000";
		next;
		mes "[Viorel]";
		mes "轻微的副作用……";
		mes "^006400它们的外貌会改变^000000。";
		mes "但我想你会觉得这很令人满意。";
		next;
		mes "[Viorel]";
		mes "我引用 ^005DFFKassibian^000000 的话，他是^FF4800生命体^000000技术专家：";
		mes "^006400真理并非只有一种形式～！^000000";
		mes "哈哈。";
		next;
		emotion ET_SPARK;
		mes "[Viorel]";
		mes "我知道这有点突然，但是……";
		mes "用我的伟大发明——^006400生命体变异系统^000000，把你的^FF4800生命体^000000变成不可思议的存在，怎么样？";
		next;
		switch(select("探索^006400生命体变异系统^000000。:取消。")) {
		case 1:
			emotion ET_BEST;
			mes "[Viorel]";
			mes "明智的选择。";
			mes "成功就藏在打破常规思维的地方，对吧？";
			next;
			mes "[Viorel]";
			mes "第一位帮助研究的人是^005DFFJeyna^000000。";
			mes "我会把你送到 ^005DFFJeyna^000000 那里。";
			mes "在那里，你会了解更多关于新^0000FF生命体^000000的信息。";
			close2;
			setquest 4156;
			erasequest 4155;
			warp "que_house_s",63,41;
			end;
		case 2:
			emotion ET_THINK;
			mes "[Viorel]";
			mes "我不明白你为什么犹豫。";
			mes "我没有想骗你。";
			mes "也许你需要时间考虑？";
			next;
			switch(select("考虑一下。:我还是走吧。")) {
			case 1:
				mes "[Viorel]";
				mes "那我们过一会儿再谈。";
				close;
			case 2:
				emotion ET_OTL;
				mes "[Viorel]";
				mes "真遗憾。";
				mes "不过我尊重你的意见。";
				mes "我会把你送回^8B4513实验室^000000。";
				close2;
				erasequest 4154;
				erasequest 4155;
				warp "job3_gen01",12,47;
				end;
			}
		}
	} else if (checkquest(4160) > -1) {
		playbgm "33.mp3"; // Yuna Song
		mes "[Viorel]";
		mes "我之前看到的^FF4800生命体^000000已经回到了^0000FF胚胎^000000状态。";
		mes "有点奇怪，不过……";
		mes "你不用担心。";
		next;
		mes "[Viorel]";
		mes "顺便说一下……";
		mes "我忘了告诉你一件事。";
		mes "为了稳定变异过程，我需要一些材料。";
		next;
		mes "[Viorel]";
		mes "幸运的是，你不用自己寻找，因为我这里已经有了。";
		mes "不过服务费是^FF000050,000 Zeny^000000。";
		next;
		mes "[Viorel]";
		mes "我也希望能免费帮你，但你知道，我并不富有。";
		mes "而且目前没有投资者支持我的研究。";
		next;
		mes "[Viorel]";
		mes "事实上，如果我有足够的 Zeny 继续研究，就能解决很多问题……";
		next;
		mes "[Viorel]";
		mes "总之，你可以选择进行或不进行稳定化处理。由你决定。";
		next;
		mes "[Viorel]";
		mes "如果你选择不稳定的";
		mes "变异，我无法保证你会得到什么样的生命体。";
		mes "总之，由你决定。";
		next;
		switch(select("变异稳定化（50,000 Zeny）:不稳定变异")) {
		case 1:
			if (Zeny < 50000) {
				mes "[Viorel]";
				mes "我想你现在没有带^FF000050,000 Zeny^000000。";
				mes "请带足够的 Zeny。";
				mes "我会等你。";
				mes "要我把你送回^8B4513实验室^000000吗？";
				next;
				switch(select("不用了，谢谢。:好的，送我回实验室。")) {
				case 1:
					mes "[Viorel]";
					mes "好。";
					mes "一会儿见。";
					close;
				case 2:
					mes "[Viorel]";
					mes "好。";
					mes "我会在^8B4513实验室^000000等你。";
					close2;
					warp "job3_gen01",12,47;
					end;
				}
			}
			emotion ET_BEST;
			playbgm "19.mp3"; // Under the Ground
			mes "[Viorel]";
			mes "明智的选择。";
			mes "从不同类型的^0000FF生命体^000000中选择。";
			next;
			switch(select("艾拉:塞拉:迪特尔:拜耶里:艾莉诺")) {
			case 1:
				cutin "Mer_Eira_Card",3;
				set .@Homunculus,6048; //MER_EIRA
				break;
			case 2:
				cutin "Mer_Sera_Card",3;
				set .@Homunculus,6050; //MER_SERA
				break;
			case 3:
				cutin "Mer_Dieter_Card",3;
				set .@Homunculus,6051; //MER_DIETER
				break;
			case 4:
				cutin "Mer_Bayeri_Card",3;
				set .@Homunculus,6049; //MER_BAYERI
				break;
			case 5:
				cutin "Mer_Eleanor_Card",3;
				set .@Homunculus,6052; //MER_ELEANOR
				break;
			}
			mes "[Viorel]";
			mes "确定吗？";
			next;
			if(select("是。:否。") == 2) {
				cutin "",255;
				playbgm "33.mp3"; // Yuna Song
				mes "[Viorel]";
		mes "我明白了。";
				mes "再给它一点时间考虑。";
				close;
			}
			cutin "",255;

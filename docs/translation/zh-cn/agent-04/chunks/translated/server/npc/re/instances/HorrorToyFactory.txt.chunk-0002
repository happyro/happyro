	end;
OnTouch:
	playBGM "99";
	end;
}

1@xm_d,185,94,6	script	Employees' Uniform Box#4	4_NONMYSTCASE,{
	progressbar "ffff00",1;
	playBGM "128";
	.@mob_id_transform = getstatus(SC_MONSTER_TRANSFORM,1);
	if (.@mob_id_transform == 1246 || .@mob_id_transform == 1249 || .@mob_id_transform < 1) {
		mes "^0000ff>你换上了制服。^000000";
		transform 1246,300000;// COOKIE_XMAS
		close;
	}
	mes "^ff0000你变成了另一种形态。";
	mes "你似乎无法在獠牙状态下穿上制服。^000000";
	close;
}

1@xm_d,1,5,3	script	#fac2ct	CLEAR_NPC,{
	end;
OnEnd:
	killmonster 'xm_d_map$, instance_npcname("#fac2ct") + "::OnMyMobDead";
	end;

OnStart:
	.@event$ = instance_npcname("#fac2ct") + "::OnMyMobDead";
	killmonster 'xm_d_map$, .@event$;
	areamonster 'xm_d_map$,140,18,240,120, "Malicious Baby Ghost",2993,19, .@event$;	// XM_HYLOZOIST
	areamonster 'xm_d_map$,140,18,240,120, "Evil Dwelling Box",2991,16, .@event$;		// XM_MYSTCASE
	areamonster 'xm_d_map$,140,18,240,120, "Abandoned Teddy bear",2995,22, .@event$;	// XM_TEDDY_BEAR
	areamonster 'xm_d_map$,140,18,240,120, "Creepy Demon",2992,16, .@event$;			// XM_LUDE
	end;
OnMyMobDead:
	end;
}

1@xm_d,1,2,3	script	#fac2wpc	CLEAR_NPC,{
	end;
OnStart:
	.@fac_open = 'worker[1] + 'worker[2] + 'worker[3] + 'worker[4] + 'worker[5] + 'worker[6] + 'worker[7] + 'worker[8] + 'worker[9] + 'worker[10];
	if (.@fac_open == 10) {
		enablenpc instance_npcname("#fac3wp");
		enablenpc instance_npcname("#fac3wp2");
		donpcevent instance_npcname("#fac2ct") + "::OnEnd";
		mapannounce 'xm_d_map$, "工厂公告：大家都回家了。生产线已关闭，员工休息室开放。", bc_map, "0x00ff44";
		for ( .@i = 90; .@i <= 104; .@i++ )
			disablenpc instance_npcname( "alert#"+ .@i );
	}
	else
		mapannounce 'xm_d_map$, "工厂公告：包装线上现在有" + (10 - .@fac_open) + "人。请保重。", bc_map, "0x00ff44";
	end;
}

1@xm_d,155,98,3	script	Worker#1	4_M_COOKIE,{
	if (getstatus(SC_MONSTER_TRANSFORM,1) == 1246) {
		.@num = atoi(strnpcinfo(2));
		mes "[Worker]";
		mes "嗯？发生什么了？";
		next;
		if (select( "不，没什么特别的", "你知道玩偶制造者吗？" ) == 1) {
			mes "[Worker]";
			if (.@num == 8)
				mes "我正在工作！我很忙！";
			else
				mes "我工作很忙，可以别聊天吗？";
			close;
		}
		close2;
		setpcblock PCBLOCK_NPC, true;
		switch(.@num) {
		case 1:
			npctalk "工人：啊！爷爷？他是个很好的人。每天给我们上油，经常清理灰尘。";
			sleep2 3000;
			npctalk "工人：我希望他不会去世。啊……啊哈……我感觉好多了。";
			break;
		case 2:
			npctalk "工人：是 Kimi 杀了工匠爷爷吗？谁说的？那不是真的。Kimi 正要救他！";
			sleep2 3000;
			npctalk "工人：啊……顺……顺便问一下，我的身体为什么变成……";
			break;
		case 3:
			npctalk "工人：他有慢性心脏病，但发作得太突然就去世了。Kimi 找到他并进行了急救，但是……";
			sleep2 3000;
			npctalk "工人：啊……你对我做了什么吗？我感觉很奇怪……";
			break;
		case 4:
			npctalk "工人：Kimi 有一段时间完全不动，像普通玩偶一样坐着。";
			sleep2 3000;
			npctalk "工人：她的灵魂正要永远飞走……就像现在的我……天啊……我怎么了？";
			break;
		case 5:
			npctalk "工人：哦，Kimi……亲爱的……她以为玩偶制造者因为受到惊吓而去世了。";
			sleep2 3000;
			npctalk "工人：爷爷只是因为 Kimi 会动而非常高兴……";
			break;
		case 6:
			npctalk "工人：他曾经看到过活着的玩偶。这就是 Kimi 最初做的事。";
			sleep2 3000;
			npctalk "工人：而她最先看到的就是他的死亡。真是悲惨。";
			break;
		case 7:
			npctalk "工人：在被灵魂寄宿前，Kimi 就能听到爷爷的声音并感受到他。";
			sleep2 3000;
			npctalk "工人：也许爷爷的爱让她动起来并获得生命。啊哈……我困了……";
			break;
		case 8:
			npctalk "工人：爷爷是个好人！可怜的 Kimi！Kimi 爱爷爷！但爷爷死了。我很难过！";
			sleep2 3000;
			break;
		case 9:
			npctalk "工人：看到 Kimi 睁开眼睛时，他非常惊讶，而他的心……变成了那样。";
			sleep2 3000;
			npctalk "工人：总之，我的身体为什么……好像要漂浮在空中……真奇怪。";
			break;
		case 10:
			npctalk "工人：Kimi 没有伤害爷爷！Kimi 想救爷爷！人们害怕 Kimi，但 Kimi 很善良！Kimi 是个好女孩！";
			sleep2 3000;
			npctalk "工人：爷爷……我想他。爷爷，爷爷……";
			break;
		}
		sleep2 3000;
		disablenpc();
		if ('worker[.@num] == 0) {
			'worker[.@num] = 1;
			donpcevent instance_npcname("#fac2wpc") + "::OnStart";
		}
		setpcblock PCBLOCK_NPC, false;
		end;
	}
	mes "[Worker]";
	mes "什么！？你不是我们的人！！";
	donpcevent instance_npcname( strnpcinfo(0) ) + "::OnAlert";
	close;

OnAlert:
	.@npc_name$ = instance_npcname( strnpcinfo(0) );
	killmonster 'xm_d_map$, .@npc_name$ + "::OnMyMobDead";
	.@num = atoi(strnpcinfo(2));
	if (.@num == 8)
		npctalk "工人：警卫！警卫！！";
	else
		npctalk "工人：警卫，警卫！你在哪里？！这里有人类！！";
	sleep 3000;
	switch(.@num) {
	case 9:
		setarray .@coord[0],233,27;
		break;
	case 10:
		setarray .@coord[0],209,27;
		break;
	default:
		getmapxy .@map$, .@coord[0], .@coord[1], BL_NPC;
		break;
	}
	areamonster 'xm_d_map$,(.@coord[0]-8),(.@coord[1]-8),(.@coord[0]+8),(.@coord[1]+8), "Guard",2990,21, .@npc_name$ + "::OnMyMobDead";
	disablenpc .@npc_name$;
	if ('worker[.@num] == 0) {
		'worker[.@num] = 1;
		donpcevent instance_npcname("#fac2wpc") + "::OnStart";
	}
	initnpctimer;
	end;
OnTimer60000:
	killmonster 'xm_d_map$, instance_npcname( strnpcinfo(0) ) + "::OnMyMobDead";
	stopnpctimer;
	end;

OnMyMobDead:
	end;
}

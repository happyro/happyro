1@xm_d,185,100,6	script	Catherine Jet Johnson#2	4_F_SKULL06GIRL,{
	if (is_party_leader() == true) {
		mes "[凯瑟琳·杰特·约翰逊]";
		mes "幸好你安全到达了。";
		next;
		switch( select( "退出故事", "听她的策略。", "我知道该做什么。快点行动！" ) ) {
		case 1:
			mes "[凯瑟琳·杰特·约翰逊]";
			mes "哦，亲爱的。准备好后告诉我。";
			close;
		case 2:
			donpcevent instance_npcname("Catherine Jet Johnson#21") + "::OnStart";
			close;
		case 3:
			donpcevent instance_npcname("Catherine Jet Johnson#21") + "::OnStart2";
			close;
		}
	}
	mes "[凯瑟琳·杰特·约翰逊]";
	mes "等等~我正在和你的主管谈话，请稍候。";
	close;
}

1@xm_d,185,100,6	script	Catherine Jet Johnson#21	4_F_SKULL06GIRL,{
	end;
OnStart:
	callsub S_Skip,0;
OnStart2:
	callsub S_Skip,1;
S_Skip:
	enablenpc instance_npcname("#bgm06");
	enablenpc instance_npcname("Catherine Jet Johnson#21");
	disablenpc instance_npcname("Catherine Jet Johnson#2");
	sleep 3000;
	if (getarg(0) == 1)
		npctalk "Catherine Jet Johnson: 如果你找到所有线索，就搜索其他地方。我会找上次遇到玩偶师的地点。";
	else {
		npctalk "凯瑟琳·杰特·约翰逊：这里是 2 号工厂。";
		sleep 5000;
		npctalk "凯瑟琳·杰特·约翰逊：这里曾经人满为患，但现在不是了。";
		sleep 5000;
		npctalk "Catherine Jet Johnson: 啊，我来这里时想起了什么。一些……孩子……";
		sleep 5000;
		npctalk "凯瑟琳·杰特·约翰逊：该怎么说呢……这里有许多看起来非常可怕、却极其悲伤的灵魂。";
		sleep 5000;
		npctalk "Catherine Jet Johnson: 他们真可怜，但如果攻击你，请让他们安息。幸运的是，他们不会攻击我。";
		sleep 5000;
		npctalk "凯瑟琳·杰特·约翰逊：如果你在这里搜寻时看到值班的工人玩偶，能问问它关于玩偶制造者的事吗？";
		sleep 5000;
		npctalk "Catherine Jet Johnson: 如果它们想起玩偶师的记忆，他也许能升入天堂。这是最大的希望。";
		sleep 5000;
		npctalk "Catherine Jet Johnson: 如果你找到所有线索，就搜索其他地方。我会找上次遇到玩偶师的地点。";
		sleep 5000;
		npctalk "凯瑟琳·杰特·约翰逊：抱歉我帮不上太多忙。待会儿见。";
	}
	sleep 6000;
	disablenpc instance_npcname("Catherine Jet Johnson#21");
	enablenpc instance_npcname("Employees' Uniform Box#4");
	donpcevent instance_npcname("#fac2ct") + "::OnStart";

	for ( .@i = 1; .@i <= 10; .@i++ )
		enablenpc instance_npcname( "Worker#"+ .@i );
	disablenpc instance_npcname("#bgm06");
	end;
}


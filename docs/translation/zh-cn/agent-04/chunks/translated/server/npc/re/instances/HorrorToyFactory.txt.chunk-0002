1@xm_d,131,213,4	script	Antonio#1	4_M_ANTONIO,{
	mes "[Antonio]";
	mes "嘿，圣诞老人。别这么古板，老头。公平就是公平，咯咯咯。";
	close;

OnStart:
	.@antonio$ = instance_npcname("Antonio#1");
	.@santa$ = instance_npcname("Captured Santa#3");
	sleep 3000;
	npctalk "安东尼奥：听我说，圣诞老人~我是说，我喜欢这座工厂。", .@antonio$;
	sleep 3000;
	npctalk "安东尼奥：没人拥有它~而且有很多东西我能用。", .@antonio$;
	sleep 3000;
	npctalk "被捕的圣诞老人：你这个傻瓜！为了确认我跟着你。现在你从大家的工厂偷东西！", .@santa$;
	sleep 4000;
	npctalk "安东尼奥：嘿，多出来一些礼物有什么大不了的？我可不知道~", .@antonio$;
	sleep 4000;
	npctalk "被捕的圣诞老人：呼……好吧，但想想孩子们收到礼物时的感受。", .@santa$;
	sleep 4000;
	npctalk "被捕的圣诞老人：如果他们知道你把无主之物分给他们，会有什么感受？", .@santa$;
	sleep 4000;
	npctalk "安东尼奥：嗯……", .@antonio$;
	sleep 2000;
	npctalk "安东尼奥：也许……我会很开心？！总之，那是礼物，咯咯咯。", .@antonio$;
	sleep 5000;
	npctalk "被捕的圣诞老人：谁说礼物本身有问题！安东尼奥，你最好停止偷窃！", .@santa$;
	sleep 5000;
	mapannounce 'xm_d_map$, "工厂公告：3 号工厂的发送准备已经完成。", bc_map, "0x00ff44";
	sleep 5000;
	mapannounce 'xm_d_map$, "工厂公告：配送员工请待命。", bc_map, "0x00ff44";
	sleep 3000;
	npctalk "安东尼奥：哦！呜呼呼！一大堆礼物延误了。今天开派对吧？！", .@antonio$;
	sleep 4000;
	npctalk "安东尼奥：嘿，人类。如果想帮忙可以跟着我。只要别打扰我就行！", .@antonio$;
	sleep 4000;
	disablenpc .@antonio$;
	sleep 2000;
	npctalk "被捕的圣诞老人：那……那家伙毫无道德！", .@santa$;
	sleep 4000;
	npctalk "被捕的圣诞老人：嘿，你能把那个安东尼奥赶出去吗？打他几下他可能就会逃跑。", .@santa$;
	sleep 5000;
	npctalk "被捕的圣诞老人：从集体那里偷东西是不对的！", .@santa$;

	disablenpc instance_npcname("#bgm04");
	enablenpc instance_npcname("#fac4wp");
	enablenpc instance_npcname("#fac4wp2");
	donpcevent instance_npcname("#fac3ct") + "::OnStart";
	donpcevent instance_npcname("#fac3ct2") + "::OnStart";
	donpcevent instance_npcname("#fac3ct3") + "::OnStart";
	sleep 3000;
	enablenpc instance_npcname("#bgm05");
	end;
}


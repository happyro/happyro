// Ayothaya Transportation
//============================================================
-	script	::Aibakthing_ayothaya	-1,{
	mes "[艾巴克辛]";
	mes "呼！哈！呼！哈！";
	mes "让我带你前往";
	mes "遥远的灵性之地，";
	mes "充满异国神秘的土地，";
	mes "我的故乡阿育泰雅！";
	next;
	switch(select("关于阿育泰雅。:前往阿育泰雅。:取消。")) {
	case 1:
		mes "[艾巴克辛]";
		mes "我们阿育泰雅人虔诚而重视和平与真诚，努力与自然和谐相处，过着简朴而高尚的生活。";
		next;
		mes "[艾巴克辛]";
		mes "我们的传统料理闻名世界。像冬阴功这样的菜肴由虾、柠檬和辣椒制成，香气诱人，味道超乎想象。";
		next;
		mes "[艾巴克辛]";
		mes "对于渴望冒险的人，有一个关于萨明虎的古老传说——一种在寺庙遗迹中出没的邪恶生物。";
		next;
		mes "[艾巴克辛]";
		mes "呼！哈！呼！哈！";
		mes "没有活人能抵挡";
		mes "这片美丽土地的召唤。";
		mes "米德加尔特人";
		mes "永远受到欢迎！";
		close;
	case 2:
		mes "[艾巴克辛]";
		mes "啊，想去阿育泰雅";
		mes "必须支付10,000 Zeny。";
		mes "如果准备好了，我们现在";
		mes "就可以出发~";
		next;
		if (select("我准备好了，走吧！:不了。") == 1) {
			if (Zeny > 9999) {
				mes "[艾巴克辛]";
				mes "呼！哈！呼！哈！";
				mes "出发吧！回到我那";
				mes "美丽的阿育泰雅！";
				close2;
				set Zeny, Zeny-10000;
				warp "ayothaya",149,71;
				end;
			}
			mes "[艾巴克辛]";
			mes "抱歉，你没有足够的10,000 Zeny前往阿育泰雅。与等待你的经历相比，这点费用根本不算什么！";
			close;
		}
	case 3:
		mes "[艾巴克辛]";
		mes "你是否梦想过";
		mes "一个充满灵性宁静的";
		mes "美丽地方？你一定";
		mes "梦见过阿育泰雅，";
		mes "我的朋友。";
		close;
	}
}

ayothaya,152,68,1	script	Aibakthing#ayo2	843,{
	mes "[艾巴克辛]";
	mes "呼！哈！嗯！哈！";
	mes "你觉得阿育泰雅怎么样？有机会尝过冬阴功吗？准备好后，我会送你回家。";
	next;
	if (select("回艾尔贝塔。:取消。") == 1) {
		mes "[艾巴克辛]";
		mes "欢迎你随时回来。希望我们很快能再次相见。谢谢~";
		close2;
		if (checkre(0))
			warp "alberta",245,87;
		else
			warp "alberta",235,45;
		end;
	}
	mes "[艾巴克辛]";
	mes "啊，是的。我理解离开这么美丽的地方并不容易。别担心，";
	mes "慢慢来。";
	close;
}

// Generic Ayothaya NPCs
//============================================================
ayothaya,189,120,3	script	Young Man#Thang	843,{
	mes "[Thang]";
	mes "阿育泰雅有一座";
	mes "古老而可怕的建筑，";
	mes "这里没有人";
	mes "敢靠近……";
	next;
	mes "[Thang]";
	mes "过去有几名好奇的人不顾恐怖传闻走了进去，却再也没有回来。那里面究竟发生了什么？";
	next;
	mes "[Thang]";
	mes "不过，如果想向别人证明勇气，面对里面的危险也许是值得冒险家接受的挑战……";
	mes "我是这么想的。";
	close;
}

ayothaya,171,152,5	script	Girl#Lalitha	838,{
	set .@sit,rand(1,5);
	if (.@sit > 0 && .@sit < 3) {
		mes "[Lalitha]";
		mes "你好！";
		mes "我想我们";
		mes "以前没见过。";
		next;
		mes "[Lalitha]";
		mes "你一定是";
		mes "来自米德加尔特。";
		mes "毕竟村里每个人我都认识。";
		mes "嘿嘿~";
		next;
		mes "[Lalitha]";
		mes "嗯……";
		mes "可以问问你来自哪里吗？";
		mes "我对外面的世界";
		mes "有很多好奇。";
		next;
		mes "[Lalitha]";
		mes "比如其他国家女士穿的裙子和首饰，男人是否英俊，你们那里有什么歌曲，以及那里的男人喜欢什么样的女孩……";
		emotion ET_QUESTION;
		next;
		mes "[" +strcharinfo(0)+ "]";
		mes ".........";
		next;
		mes "[Lalitha]";
		mes "..........";
		emotion ET_SWEAT;
		next;
		mes "[Lalitha]";
		mes "好吧~！";
		mes "保重，";
		mes "旅途愉快！";
		close;
	}
	else if (.@sit > 2 && .@sit < 6) {
		mes "[Lalitha]";
		mes "从村子向东走，";
		mes "会到达一座古老神殿的遗迹。那里如今";
		mes "是可怕怪物的巢穴。";
		next;
		mes "[Lalitha]";
		mes "如果打算穿越遗迹，";
		mes "一定要做好充分准备！";
		next;
		mes "[Lalitha]";
		mes "啊……";
		mes "不知道";
		mes "我的黑骑士在哪里~";
		emotion ET_THROB;
		next;
		mes "["+strcharinfo(0)+"]";
		mes "你是说……";
		mes "身穿闪亮铠甲";
		mes "骑着白马的骑士？";
		next;
		mes "[Lalitha]";
		mes "嗯……？";
		mes "哦，好吧……";
		mes "两个我都要！";
		mes "嘻嘻~！";
		close;
	}
	mes "[Lalitha]";
	mes "嗯……？";
	mes "怎么了？";
	close;
}

ayothaya,143,102,5	script	Old Man#ayothaya	842,{
	mes "[Villager]";
	mes "呃……";
	mes "嗯嗯嗯……";
	mes "呃呃呃……？";
	next;
	mes "[Villager]";
	mes "你一定是";
	mes "外乡人。";
	mes "是的，确实如此。";
	next;
	mes "[Villager]";
	mes "你刚才问";
	mes "我要去哪儿？";
	mes "当然是前面的钓鱼点。";
	mes "我们老人家";
	mes "就是去钓鱼。";
	next;
	mes "[Villager]";
	mes "嗯嗯……";
	mes "想听点有趣的吗？听说有人在";
	mes "钓鱼点钓到的";
	mes "鱼肚子里发现了戒指。";
	mes "";
	next;
	mes "[Villager]";
	mes "据说有很多人在那里钓到的鱼里发现贵重物品。";
	next;
	mes "[Villager]";
	mes "如果足够幸运，";
	mes "你甚至可能成为";
	mes "百万富翁。";
	mes "嘿嘿嘿~";
	next;
	mes "[Villager]";
	mes "...!?";
	mes "啊，我走进鱼市场了！^666666*叹气*^000000 看来我走错路了。钓鱼点在村子的另一边。";
	next;
	mes "[Villager]";
	mes "既然来了，逛逛也";
	mes "不坏。市场里的海鲜新鲜又美味。";
	mes "至少尝一次，";
	close;
}

ayothaya,197,189,5	script	Young Man#1ayothaya	841,{
	mes "[Kwan]";
	mes "呼，今天";
	mes "是不是热得不得了？";
	next;
	mes "[Kwan]";
	mes "你一定是";
	mes "来自米德加尔特，对吧？";
	mes "最近我见到许多";
	mes "从那里来的游客。";
	next;
	mes "[Kwan]";
	mes "离开村子旅行时一定要小心。无论如何，都不要进入";
	mes "森林里的古老神殿遗迹。";
	mes "";
	next;
	mes "[Kwan]";
	mes "那里太过";
	mes "危险。不过听说如果有某种护身符，";
	mes "就能稍微安心地前往……";
	next;
	mes "[Kwan]";
	mes "总之，远离那个地方绝对是明智之举。希望你享受阿育泰雅之旅，平安无事~";
	close;
}

ayothaya,214,142,5	script	Young Man#5ayothaya	843,{
	mes "[Detzi]";
	mes "阿育泰雅有自己的传统武术。我们村里的年轻人练习传统武术，以变得更加强大。";
	next;
	mes "[Detzi]";
	mes "为什么不学学我们的武术？我保证它会对你的旅途大有帮助。";
	close;
}

ayothaya,241,264,5	script	Young Man#5ayothaya2	843,{
	mes "[Eik]";
	mes "嘿……";
	mes "你看起来挺强的";
	mes "想不想";
	mes "和我比一场？";
	next;
	if (select("当然！:不了~") == 1) {
		mes "[艾克]";
		mes "哎哟哎哟！";
		mes "我只是";
		mes "开个玩笑，伙计！";
		next;
		mes "[艾克]";
		mes "我还没粗鲁到无缘无故和陌生人打架！";
		emotion ET_KEK;
		close;
	}
	mes "[艾克]";
	mes "真正的力量是在与他人进行数千场较量后磨练出来的。所以别害怕战斗，好吗？";
	emotion ET_HNG;
	close;
}


job_ko,25,23,4	script	Sight#ko_25	858,1,1,{
	callfunc "F_KO_Survival_mes",25;
	end;
OnTouch:
	set .@playtime, checkquest(5141,PLAYTIME);
	if (.@playtime == -1) {
		mes "牌子上写着细小的字。";
		next;
		mes "真无聊。";
		mes "看不懂这些字。应该有办法读懂。";
		next;
		switch(select("试试什么。:什么都不做。")) {
		case 1:
			specialeffect2 EF_TALK_FROSTJOKE;
			mes "我试着用最近在普隆德拉听到的笑话做点什么。";
			next;
			setquest 5141;
			mes "被诅咒并定身 2 分钟。";
			close;
		case 2:
			if (rand(1,10) == 4) {
				mes "什么都不做是明智的决定。";
				next;
			} else {
				mes "什么也没发生。还得做点什么。";
				close;
			}
			break;
		}
	} else if (.@playtime == 0 || .@playtime == 1) {
		mes "你被诅咒，无法移动。";
		close;
	} else if (.@playtime == 2) {
		mes "定身诅咒持续了 2 分钟，随后消失了。";
		next;
		erasequest 5141;
	} else {
		erasequest 5141;
		mes "发生未知错误。";
		mes "请联系客服。";
		close;
	}
	callfunc "F_KO_Survival_dice",25;
	end;
}


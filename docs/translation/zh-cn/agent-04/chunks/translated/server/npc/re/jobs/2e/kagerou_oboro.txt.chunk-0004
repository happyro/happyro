// Test of Weaponry
//============================================================
job_ko,127,125,4	script	Red Leopard Joe#ko	730,{
	if (MaxWeight - Weight < 1000 || checkweight(1201,1) == 0) {
		mes "[红豹乔]";
		mes "减轻你的负重！否则这个测试会很困难……";  //custom translation
		close;
	}
	if (BaseJob != Job_Ninja) {
		for (set .@i,5131; .@i<=5146; set .@i,.@i+1)
			if (isbegin_quest(.@i)) erasequest .@i;
		set job_kagero,0;
		mes "[红豹乔]";
		mes "抱歉，你的氏族和我们不同，是出了什么问题吗？";
		close2;
		warp "amatsu",147,136;
		end;
	}
	if (job_kagero != 5) {  //custom translation
		mes "[红豹乔]";
		mes "你不该来这里……";
		mes "消除你的存在是我的职责，";
		mes "所以现在就送你回去！";
		close2;
		warp "amatsu",147,136;
		end;
	}
	set .@ko_test_03_1, isbegin_quest(5138);
	set .@ko_test_03_2, isbegin_quest(5142);
	set .@ko_test_03_3, isbegin_quest(5143);
	set .@ko_test_03_4, isbegin_quest(5144);
	set .@ko_test_03_5, isbegin_quest(5145);
	if (.@ko_test_03_1 == 1 && .@ko_test_03_2 == 0 && .@ko_test_03_3 == 0 && .@ko_test_03_4 == 0 && .@ko_test_03_5 == 0) {
		mes "[红豹乔]";
		mes "好久不见！";
		next;
		select("确实好久不见，乔。");
		mes "[红豹乔]";
		mes "你看到我在这里并不惊讶。来这里之前见过^0237FD空牙凯^000000吗？";
		next;
		mes "[红豹乔]";
		mes "虽然你不是先来拜访我的让我有点不高兴，但那不重要。";
		next;
		mes "[红豹乔]";
		mes "好吧，" + strcharinfo(0) + "！";
		mes "欢迎来到为氏族制造武器的工坊。";
		next;
		mes "[红豹乔]";
		mes "自古以来，我们氏族一直在制造和使用独特武器，执行秘密任务。";
		next;
		select("真的吗？在艾因布洛克？");
		mes "[红豹乔]";
		mes "嗯？你没有我想的那么迟钝！";
		next;
		mes "[红豹乔]";
		mes "没错。艾因布洛克是著名的工业城市，伟大的铁匠们在那里创造新技术。";
		next;
		mes "[红豹乔]";
		mes "我的任务是分析他们的技术并向氏族汇报。";
		next;
		mes "[红豹乔]";
		mes "我说得有点多了。";
		next;
		mes "[红豹乔]";
		mes "你带来了足够的^6848B7铁矿石、铁、钢铁、普拉康、埃姆贝塔康、粗糙的神之金属和粗糙的铝^000000吗？";
		next;
		mes "[红豹乔]";
		mes "现在来制造一件新的原型武器吧。";
		next;
		specialeffect EF_GUIDEDATTACK,AREA,"Crafting Tools#ko_01";
		mes "[红豹乔]";
		mes "尽管使用这里的工具，还有……";
		next;
		specialeffect EF_GUIDEDATTACK,AREA,"Crafting Tools#ko_02";
		mes "[红豹乔]";

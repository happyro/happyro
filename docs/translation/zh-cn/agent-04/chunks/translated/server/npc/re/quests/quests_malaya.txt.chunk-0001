//= rAthena Project
//===== Description: =========================================
//= [Official Conversion]
//= Quest NPCs related to Port Malaya:
//== Cautious Village, Port Malaya Daily Quests,
//== Secret in the Woods, Bakonawa Extermination
//== Nurse in Port Malaya, Pintados Festival
//= Merchants:
//== Traders, Upgrade Boss Equipment
//===== Additional Comments: =================================
//= 0.1 Traders only. Adapted from Masao's conversion. [Euphy]
//= 0.2 Added Tribe Blacksmith [DeadlySilence]
//= 0.3 Added "Secret in the Woods" quest [DeadlySilence]
//= 0.4 Added "Cautious Village" and subsequent quests [DeadlySilence]
//= 0.5 Added "Bakonawa Extermination" quest. [Euphy]
//= 1.0 Added "Nurse in Port Malaya" and "Pintados Festival" quests. [Euphy]
//= 1.1 Added GM management function and NPC. [Euphy]
//= 1.2 Added VIP features. [Euphy]
//= 1.3 Fixed Pintados Festival never ends. [Capuche]
//============================================================

// Cautious Village & Daily Quests :: hi_malaya
//============================================================
malaya,266,76,3	script	Rodel the Guard#malaya	570,4,4,{
	if (MaxWeight - Weight < 1000 || checkweight(1201,1) == 0) {
		mes "无法继续任务。你携带的物品太多了。-";
		close;
	}
	if (malaya_hi == 0) {
		mes "[守卫罗德尔]";
		mes "这种混乱时期还要旅行吗？";
		mes "村民最近越来越受到恶灵威胁。";
		mes "村民们害怕得发抖。";
		next;
		mes "[守卫罗德尔]";
		mes "所以……尽管居民对你没有恶意，马来港的人还是会感到不安。";
		mes "旅店和驿站可能不对外来者开放。";
		next;
		mes "[守卫罗德尔]";
		mes "目前没有明确的解决办法，但你可以先去见姆巴基的峰。";
		mes "如果村长确认了，其他人可能就没那么担心。";
		next;
		mes "[守卫罗德尔]";
		mes "我会在地图上标记姆巴基的峰的位置。";
		mes "即使时局艰难，我仍欢迎你的到访。";
		viewpoint 1, 185, 358, 0, 0x0A82FF;
		set malaya_hi, 1;
		setquest 7350;
		close;
	} else if (malaya_hi == 1) {
		mes "[守卫罗德尔]";
		mes "先去见姆巴基的峰。";
		mes "如果证明你拥有纯洁的灵魂，其他村民就不会躲着你。";
		mes "如果不确定位置，我会在地图上标记。";
		viewpoint 1, 185, 358, 0, 0x0A82FF;
		close;
	} else if (malaya_hi >= 20) {
		if (BaseLevel < 100) {
			mes "[守卫罗德尔]";
			mes "这里的生活怎么样？";
			mes "人们还不算太坏，对吧？";
			mes "如果你再强一些，也许会有适合你的工作。目前你稍微低于标准。";
			next;
			mes "[守卫罗德尔]";
			mes "如果你变得更强，";
			mes "我本来想把城里的消灭任务交给你。真遗憾。";
			close;
		}
		.@playtime = checkquest(7405, PLAYTIME);
		if (.@playtime == 0) {
			mes "[守卫罗德尔]";
			mes "呼，多亏了你，我少了一件烦心事。";
			mes "这样我就会少丢些东西。";
			mes "干得好。";
			next;
			mes "[守卫罗德尔]";
			mes "想回来时随时可以。";
			mes "你明白我的意思吧？";
			close;
		} else if (.@playtime == 2) {
			erasequest 7405;
			mes "[守卫罗德尔]";
			mes "哦，说起你之前猎杀的杰林。";
			mes "进出巴里奥的人都很高兴。";
			mes "如果不是太麻烦，我想再请你帮一次忙。";
			next;
			mes "[守卫罗德尔]";
			mes "不用现在做，等你方便时再做就好。";
			mes "决定后再来找我。";
			close;
		} else {
			.@hunting = checkquest(7404, HUNTING);
			if (.@hunting == -1) {
				mes "[守卫罗德尔]";
				switch(rand(1, 6)) {
				case 1:
					mes "最近有几位村民因勇敢而受到认可。" + $malayaNames$[0] + ", " + $malayaNames$[3] + ", " + $malayaNames$[5] + "... 很厉害吧？";
					break;
				case 2:
					mes "昨天我看到有人从公园楼梯滚下去后被送进医院。那个人叫 " + $malayaNames$[1] + "。不知道现在是否安好。";
					break;
				case 3:
					mes "在杰林狩猎中贡献最大的是 " + $malayaNames$[1] + ".";
					break;
				case 4:
					mes "如果你无聊，要不要替我站岗？这可是很辛苦的工作。你必须像雕像一样站着，直到太阳升到头顶。";
					break;
				case 5:
					mes "你曾和女人单独待在吉普尼里吗？哇，那真尴尬……照这样下去我永远也结不了婚……";
					break;
				case 6:
					mes "最近有位访客成了我的好友。你认识 " + $malayaNames$[1] + "吗？哦，当然你也是我的好朋友。";
					break;
				}
				mes "哦，如果你不太忙，这里有份工作给你。感兴趣吗？";
				next;
				mes "[守卫罗德尔]";
				mes "这次我们要组织大规模杰林狩猎。";
				mes "进出巴里奥的商贩总在抱怨杰林。";
				next;
				if (select("参加杰林狩猎。:拒绝。") == 2) {
					mes "[守卫罗德尔]";
					mes "是吗？听到这个我很遗憾。";
					mes "如果身边有你这样的人，事情会简单得多。";
					close;
				}
				mes "[守卫罗德尔]";
				mes "你只要分别狩猎 20 只杰林。";
				mes "对你来说应该很简单。";
				setquest 7404;
				close;
			} else if (.@hunting == 0) {
				mes "[守卫罗德尔]";
				mes "你必须消灭 20 只杰林。";
				mes "20 只应该足以给那些杰林一个教训。";
				close;
			} else if (.@hunting == 1) {
				mes "[守卫罗德尔]";
				mes "哦，狩猎结束了，但你没有杀光所有杰林。";
				mes "想再试一次就回来。";
				erasequest 7404;
				close;
			} else {
				mes "[守卫罗德尔]";
				mes "哦，我确认你已经消灭了 20 只杰林。";
				mes "这是参加杰林狩猎者的奖励。";
				next;
				mes "[守卫罗德尔]";
				mes "我想以后还会有更多杰林狩猎。下次请再参加。";
				if (!VIP_SCRIPT || vip_status(VIP_STATUS_ACTIVE))
					getitem 6497, 2; // Lesser_Agimat
				else
					getitem 6497, 1; // Lesser_Agimat
				getexp 200000,200000;
				erasequest 7404;
				setquest 7405;
				if (rand(2))
					$malayaNames$[1] = strcharinfo(0);
//				SavePPL Jejellopy
				close;
			}
		}
	} else {
		mes "[守卫罗德尔]";
		mes "即使人们警惕地看着你，也请理解。";
		mes "鬼魂一直在骚扰这里的人。";
		close;
	}
OnTouch:
	emotion ET_SURPRISE;
	end;

OnInit:
	// if there are no names set, set some default values
	if (!getarraysize($malayaNames$)) {
		$malayaNames$[0] = "unknown";
		$malayaNames$[1] = "unknown";
		$malayaNames$[2] = "unknown";
		$malayaNames$[3] = "unknown";
		$malayaNames$[4] = "unknown";
		$malayaNames$[5] = "unknown";
	}
	end;
}

malaya,185,358,3	script	Leader Phong in Mumbaki	580,{
	if (MaxWeight - Weight < 1000 || checkweight(1201,1) == 0) {
		mes "- 无法继续任务。你携带的物品太多了。-";
		close;
	}
	if (malaya_hi < 2) {
		mes "[Phong in Mumbaki]";
		mes "看来这个灵魂遇到过一大片水域。";
		mes "年轻的朋友。";
		mes "你找到我的原因……是的……我明白了。";
		next;
		mes "[Phong in Mumbaki]";
		mes "你不用用语言说出来。";
		mes "人们对你过于戒备。";
		mes "Rodel 可能担心这件事，所以把你送到这里。";
		next;
		if (malaya_hi == 0) {
			mes "[Phong in Mumbaki]";
			mes "不是吗？";
			mes "那么也许我们之间存在某种精神联系。";
			next;
		}
		mes "[Phong in Mumbaki]";
		mes "无论如何，很高兴见到你，年轻的朋友。";
		mes "别太责怪村民对你的态度。";
		next;
		mes "[Phong in Mumbaki]";
		mes "我们总是被灵魂包围。";
		mes "我们与它们共存，祈求和平。";
		mes "但最近出现了问题。";
		next;
		mes "[Phong in Mumbaki]";
		mes "不知什么原因，";
		mes "灵魂开始失控，邪灵一直在骚扰村民。";
		next;
		mes "[Phong in Mumbaki]";
		mes "这就是笼罩在美丽城镇上的阴影。";
		mes "他们之所以戒备，是因为不知道黑暗阴影何时会降临。";
		mes "它们毫无预兆地出现。";
		next;
		mes "^4d4dff姆巴基的峰转过头，黑色阴影出现了。";
		mes "人们陷入恐慌，所有人都因恐惧而颤抖。^000000";
		cutin "malaya_ghost01", 4;
		next;
		select("走向阴影。:拔出武器。");
		mes "[Phong in Mumbaki]";
		mes "它们追随着外来者的踪迹。";
		mes "别靠得太近。";
		mes "你的灵魂可能会被吸收。";
		next;
		mes "[Phong in Mumbaki]";
		mes "嗯？它们有反应了。";
		mes "我不明白？它们看起来很害怕，仿佛面对强大的灵魂。";
		mes "这种感觉……不可能……";
		cutin "malaya_ghost02", 4;
		next;
		mes "^4d4dff正如姆巴基的峰所说，灵魂正在对某种东西做出反应，犹豫不前。";
		mes "观察它们的反应，你靠近了一些。灵魂们慌乱不已。^000000";
		next;
		cutin "", 255;
		mes "[Phong in Mumbaki]";
		mes "太惊人了。拥有如此强大而纯洁灵魂的人……！";
		mes "黑暗灵魂因为你的存在消失了。";
		next;
		mes "[Phong in Mumbaki]";
		mes "我想其他村民现在会以不同态度对待你……";
		mes "我们不是都见证了这个奇迹吗？";
		next;
		mes "[Phong in Mumbaki]";
		mes "年轻的朋友。无论在哪里都欢迎你的到来。";
		mes "纯洁灵魂的光芒会保护你免受黑暗侵袭。";
		set malaya_hi, 10;
		if (checkquest(7350) > -1)
			erasequest 7350;
		close;
	} else if (malaya_hi == 10) {
		mes "[Phong in Mumbaki]";
		mes "村里每个人都见证了你灵魂的强大与纯洁。";
		mes "不要害怕黑暗。";
		close;
	} else if (malaya_hi == 11) {
		mes "[Phong in Mumbaki]";
		mes "Is there something wrong?";
		mes "你看起来很不安。";
		mes "衣服也乱糟糟的。遇到什么麻烦了吗？";
		next;
		switch (select("解释发生了什么。:没什么可说的。")) {
		case 1:
			mes "[Phong in Mumbaki]";
			mes "是吗？";
			mes "哈哈……那可是个大问题。";
			mes "你一定很担心。";
			next;
			mes "[Phong in Mumbaki]";
			mes "你知道，我们正在";
			mes "为害怕邪灵的村民准备精神护符……";
			mes "但准备工作并不顺利。";
			next;
			mes "[Phong in Mumbaki]";
			mes "作为临时解决办法，不如给他们想要的东西？";
			mes "只要从你拥有的物品中选些不重要的，交给他们即可。";
			next;
			mes "[Phong in Mumbaki]";
			mes "他们想要的只是内心平静。";
			mes "他们赋予小物品意义，并从这种行为中找到安宁。";
			next;
			mes "[Phong in Mumbaki]";
			mes "真正重要的是相信只要携带那件物品，你就会安全。";
			mes "如果人们拿着你的旧衬衫纽扣就能不再害怕，那么那颗纽扣就是精神护符。";
			next;
			mes "^4d4dff正如姆巴基所说，分发一些物品作为灵魂保护是个好主意。";
			mes "什么适合作为精神护符？^000000";
			next;
			switch (select("圣水！:神圣魔法物品蓝色宝石？！:书写工具或学习用品")) {
			case 1:
				mes "[Phong in Mumbaki]";
				mes "名字本身就体现了神圣。";
			mes "它受过圣水祝福，对吧？";
				mes "不错。";
				mes "还有别的吗？更有说服力的东西会更好。";
				next;
				select("谈谈蓝色宝石。");
				mes "[Phong in Mumbaki]";
				mes "啊……一块会代替持有者吸收诅咒或魔法影响、之后消失的石头。";
				mes "用于神圣魔法？";
				mes "听起来不错。";
				next;
				break;
			case 2:
				mes "[Phong in Mumbaki]";
				mes "啊……一块会代替持有者吸收诅咒或魔法影响、之后消失的石头。";
				mes "用于神圣魔法？";
				mes "不过听起来不太神圣。";
				next;
				select("谈谈圣水。");
				mes "[Phong in Mumbaki]";
				mes "名字本身就体现了神圣。";
			mes "它受过圣水祝福，对吧？";
				mes "听起来不错。";
				next;
				break;
			case 3:
				mes "[Phong in Mumbaki]";
				mes "嗯？如果你一直随身携带，也不算太糟。";
				mes "但我觉得看起来更有说服力的东西会更好。";
				next;
				mes "[Phong in Mumbaki]";
			mes "如果它带有神圣气息就更好了……";
			mes "你有受你所信奉之神祝福的东西吗？";
				next;
				select("圣水还是蓝色宝石？");
				mes "[Phong in Mumbaki]";
				mes "名字本身就体现了神圣。";
			mes "它受过圣水祝福，对吧？";
				mes "保护持有者的石头……";
				mes "听起来很完美。";
				next;
				break;
			}
			mes "[Phong in Mumbaki]";
			mes "你能找到刚才提到的圣水和蓝色宝石吗？";
			mes "我制作精神护符时，你可以把神圣物品分发出去。";
			next;
			mes "[Phong in Mumbaki]";
			mes "这样做会加强人们对你的信任。";
			mes "他们会信任并听从你。";
			mes "是的，因为你会成为他们心中的救世主。";
			next;
		mes "^4d4dff听取姆巴基的峰的建议后，你决定向村民分发圣水和蓝色宝石。";
			set malaya_hi, 12;
			erasequest 7358;
			setquest 7351;
			close;
		case 2:
			mes "[Phong in Mumbaki]";
			mes "Is that so?";
			mes "有什么事就告诉我。";
			mes "我很乐意帮助你。";
			close;
		}
	} else if (malaya_hi == 12) {
		mes "[Phong in Mumbaki]";
		mes "你提到的圣水和蓝色宝石会发挥很好的作用。";
		mes "希望这样能让他们放下恐惧和担忧……";
		close;
	} else if (malaya_hi == 13) {
		mes "[Phong in Mumbaki]";
		mes "你把礼物分发给所有人了吗？";
		mes "这样一来，你和镇上的所有人都成为了朋友。";
		next;
		mes "[Phong in Mumbaki]";
		mes "我找到了制作灵魂保护的方法。";
		mes "我的孙女 Imelda 会制作它。";
		mes "所以不用担心，你不必再分发自己的物品。";
		erasequest 7365;
		set malaya_hi, 20;
		getexp 200000, 200000;
//		SavePPL Soul_Protection
		close;
	} else {
		mes "[Phong in Mumbaki]";
		switch(rand(1, 6)) {
		case 1:
			mes "曾有一位和你一样勇敢的旅行者，名字是 " + $malayaNames$[0] + "。你认识那个人吗？";
			break;
		case 2:
			mes "最近有位旅行者在村里很受欢迎。那位旅行者叫 " + $malayaNames$[0] + "。外来者似乎都很有活力。";
			break;
		case 3:
			mes "我一生作为姆巴基，从未见过像 " + $malayaNames$[0] + " 那样纯洁而强大的灵魂。是的，甚至比你的更强更纯洁。";
			break;
		case 4:
			mes "我看到一位旅行者踩到果皮后向后翻倒。" + $malayaNames$[1] + " 喊道‘哎哟！谁来帮帮我～’。我们都笑得很开心。";
			break;
		case 5:
			mes "欢迎！欢迎！这里永远欢迎你。";
			break;
		case 6:
			mes "不知道你是否知道，" + $malayaNames$[0] + " 甚至帮助过巴里奥。知道身边又多了一个善良的灵魂，我很高兴。";
			break;
		}
		next;
		switch (select("寻求建议。:祝福花朵……")) {
		case 1:
			if (malaya_diwata == 2) {
				mes "[Phong in Mumbaki]";
				mes "港口的渡船？";
				mes "原来发生了这种事……";
				mes "重要的是先弄清那个孩子为什么如此悲伤。";
				next;
				mes "[Phong in Mumbaki]";
				mes "这种情况下，贿赂会非常有效。";
				mes "花朵总是吸引女性的最佳选择，对吧？";
				next;
				select("这不是恋爱咨询。");
				mes "[Phong in Mumbaki]";
				mes "我只是这么说。";
				mes "无论生死，可怜的灵魂只是个小女孩。";
				next;
				mes "[Phong in Mumbaki]";
				mes "那个年纪的女孩，即使看到落叶也会微笑。";
				mes "用一大束花打开她的心。";
				next;
				mes "[Phong in Mumbaki]";
				mes "让我看看……";
				mes "^4d4dff3 朵神秘之花、3 朵优雅之花、3 朵美丽之花^000000就足以制作花束。";
				next;
				mes "[Phong in Mumbaki]";
				mes "收集这些花，我会把它们做成花束并祝福。";
				mes "村外可以找到花。";
				set malaya_diwata, 3;
				erasequest 7396;
				setquest 7397;
				close;
			} else if (malaya_diwata == 3) {
				if ((countitem(6509) < 3) || (countitem(6510) < 3) && (countitem(6511) < 3)) {
					mes "[Phong in Mumbaki]";
					mes "需要^4d4dff3 朵神秘之花、3 朵优雅之花、3 朵美丽之花^000000。";
					mes "明白了吗？";
					close;
				}
				mes "[Phong in Mumbaki]";
				mes "哦……我在这里就能闻到花香。";
				mes "我会把它们收集起来并祝福。";
				next;
				mes "-姆巴基的峰仔细将花绑成花束后举行祝福仪式。-";
				mes "-仅仅观看仪式，神圣感就让你无法抵挡。-";
				next;
				mes "[Phong in Mumbaki]";

	veins,148,41,3	script	Towner#ve2	940,{
	mes "[Towner]";
mes "欢迎来到 Veins，这座靠近切什鲁姆尼尔神殿的城镇。";
mes "你可能觉得这是沉闷的沙漠小镇，";
mes "但它和其他地方一样充满活力。";
	next;
	mes "[Towner]";
	mes "城里确实有几个怪人，";
	mes "比如那边爱仙人掌的疯子，";
	mes "但不是人人都像他。";
	mes "你能遇到许多善良的人。";
	next;
	mes "[Towner]";
	mes "那么，希望你逗留愉快～";
	close;
	}
	
	veins,137,179,5	script	Towner#ve3	943,{
	mes "[Towner]";
	mes "唉，我们的武器店为什么这么无聊？";
	mes "里面只有老掉牙的普通垃圾。";
	mes "遗憾的是，没有任何特别之处。";
	next;
	mes "[Towner]";
	mes "如果有商店出售传说中的神兵，";
	mes "那该多棒？当然，这要求太高了。";
	close;
	}
	
	veins,166,91,5	script	Towner#ve4	946,{
mes "[Towner]";
mes "虽然我们身处沙漠中央，";
mes "敌人仍不断威胁我们。蠢货！";
	mes "芙蕾雅女神会永远保护我们！";
	next;
	mes "[Towner]";
	mes "只要我们继续训练，芙蕾雅就会守望我们，";
	mes "赐予我们战胜敌人的胜利。朋友，这就是信仰的力量。";
	close;
	}

veins,138,71,5	script	Kid#ve1	941,{
mes "[Kid]";
	mes "哇，快离开这里！";
	mes "没看到我在玩捉迷藏吗？！";
	mes "趁他们找到我之前快走！";
	close;
	}
	
	veins,253,133,3	script	Kid#ve2	944,{
	mes "[Kid]";
mes "天哪，她会藏在哪里？";
mes "我讨厌当鬼……这里有这么多藏身处。";
mes "一定有我还没找过的地方……让我看看……";
	close;
	}
	
	veins,270,164,5	script	Old Man#ve1	945,{
	mes "[Old Man]";
	mes "感谢芙蕾雅赐予我长寿，";
	mes "但我不知道自己是否充分活过。";
	next;
mes "[Old Man]";
mes "我没有遗憾或疑虑，";
mes "但也许错过了一些事情。";
	mes "我想老人总会思考这些事……";
	close;
	}
	
	veins,310,195,1	script	Towner#ve5	946,{
	mes "[Towner]";
	mes "仙人掌真棒，是沙漠里最美丽的植物。";
	mes "我们必须珍惜并培育它们～";
	next;
	mes "[Towner]";
	mes "普通仙人掌并不常见，";
	mes "但我听说有一种仙人掌会在沙漠游荡，";
	mes "发出响亮刺耳的声音。怎么会这样？";
	close;
	}

veins,320,254,5	script	Towner#ve6	943,{
mes "[Towner]";
	mes "你想要什么？";
	mes "抱歉，我只是个有普通烦恼的普通人。";
	mes "没什么是我自己解决不了的。";
	next;
	mes "[Towner]";
	mes "除非……你能帮我报税？替我还房贷？";
	mes "不行？嘿，早猜到了。";
	close;
	}
	
	veins,333,318,3	script	Towner#ve7	940,{
	mes "[Towner]";
	mes "冒险者怎么会来到这么偏僻沉闷的城镇？";
	mes "你不该去寻找冒险吗？听我的，这地方无——聊。";
	close;
	}

veins,218,323,1	script	Towner#ve8	945,{
mes "[Towner]";
	mes "哇，好久没见到游客了。";
	mes "你可能觉得这里什么都没有，";
	mes "但仔细看看，也许能学到东西。";
	next;
	mes "[Towner]";
	mes "就像了解人一样，不能只看一眼就了解一个地方。";
	mes "给它一个机会，我相信你会找到喜欢之处。";
	next;
	mes "[Towner]";
	mes "我说的‘仔细看看’是什么意思？嘿，你会看到的……也许。哈哈哈！";
	mes "算了，反正也没那么重要。愿芙蕾雅祝福你～";
	close;
	}
	
	veins,206,275,3	script	Kid#ve3	941,{
mes "[Kid]";
mes "我真的想看看神殿里面，";
mes "但从外面看起来太可怕了！";
	mes "不知道为什么会这样？";
	close;
	}
	
	veins,171,256,3	script	Towner#ve9	943,{
	mes "[Towner]";
	mes "别误会：我愿为芙蕾雅献出生命，";
	mes "但那座所谓的神殿看起来奇怪又可疑。";
	mes "怎么会是礼拜场所？";
	close;
	}
	
	veins,197,219,5	script	Towner#ve10	943,{
	mes "[Towner]";
	mes "从这棵枯树你就能看出，";
mes "我们城镇缺水。";
mes "住在沙漠里自然会这样……";
close;
	}
	
	veins,232,169,5	script	Old lady#ve1	942,{
	mes "[Old Lady]";
	mes "从这里俯瞰 Veins，我明白了很多事。";
	mes "无论怎么解释，我想你都不会理解。";
	next;
	mes "[Old Lady]";
	mes "我想有些事只能随着年龄增长才能明白。";
	mes "有些事情没有经验就无法替代。你会看到的。^FFFFFF比如秘密知识。^000000";
	close;
	}
	
	veins,121,199,3	script	Old Man#ve2	945,{
mes "[Old Man]";
mes "这可不好。Veins 的老人比年轻人多。";
mes "我们快变成养老社区了。你也看得出来吧？";
	next;
	mes "[Old Man]";
	mes "年轻人不满足于住在这里，";
	mes "因为我们缺少其他城镇的物质刺激。";
	mes "他们无法欣赏这里真正特别的地方……";
	close;
	}
	
	veins,111,50,3	script	Towner#ve11	943,{
	mes "[Towner]";
	mes "这里的人珍惜水，但我有更珍贵的东西。";
	mes "是的，比水还珍贵……你猜对了——真爱。";
	next;
	mes "[Towner]";
	mes "我们就是在这里开始约会的，所以这里对我意义重大。";
	mes "这是我最喜欢和女孩共度时光的地方。哈哈哈～";
	close;
	}
	
	veins,112,51,3	script	Towner#ve12	940,{
	mes "[Towner]";
mes "其实我有点厌倦总来这里。";
mes "我想去别的地方，";
mes "但我知道他真的喜欢来这里。";
	next;
	mes "[Towner]";
	mes "如果我们再也不来，确实有点悲伤。";
	mes "只要他陪着我，我就很开心～呵呵～";
	close;
	}
	
	veins,191,134,3	script	Old Man#ve3	945,{
	mes "[Old Man]";
	mes "看看我的商品吧？";
	mes "这里有很多你可能感兴趣的东西～";
	next;
	mes "[Old Man]";
	mes "赞美守望我们、赐予我们食物和饮水的芙蕾雅。";
	mes "年轻的冒险者，你不觉得这很棒吗？";
close;
}

	veins,177,147,3	script	Old Lady#ve2	942,{
	mes "[Old Lady]";
	mes "拥有很多东西看似很好，";
	mes "但从真正的情感价值来看，";
	mes "很多东西并不珍贵。";
	next;
	mes "[Old Lady]";
	mes "我卖东西时说这种话";
	mes "也许很危险。";
	mes "不过我还是希望能带更多种商品。";
	next;
	mes "[Old Lady]";
	mes "当然，我们身处沙漠中央，";
	mes "也许我的要求太高了。";
	close;
	}

veins,223,165,5	script	Kid#ve4	944,{
mes "[Kid]";
	mes "嘿！你觉得我从这里跳，";
	mes "能跳到那边的桥吗？";
	mes "你想试试吗？";
	next;
	mes "[Kid]";
	mes "什么？！你做不到？";
	mes "我长大后会不一样！";
	mes "我要成为世界上最棒的跳跃者！";
	mes "我要一路跳到月亮上！";
	close;
	}
	
	veins,263,153,5	script	Towner#ve13	943,{
	mes "[Towner]";
	mes "我们这里做的衣服宽松透气，";
	mes "用高品质布料缝制。";
	mes "天气热得难以忍受，当然要穿这种衣服。";
	next;
	mes "[Towner]";
	mes "布料？我给你个提示。";
	mes "它由和骆驼有关的东西制成。嘿！";
	mes "你自己想吧。哈哈！";
	close;
	}
	
	veins,296,184,3	script	Towner#ve14	940,{
	mes "[Towner]";
mes "告诉你一个秘密。";
mes "但答应我别告诉别人，好吗？";
next;
	mes "[Towner]";
	mes "时机到来时，切什鲁姆尼尔神殿会打开，";
	mes "巨大的芙蕾雅机器人将会发射！";
	mes "它会摧毁除阿鲁纳佩尔茨外的所有国家！";
	next;
	mes "[Towner]";
	mes "那机器人能从嘴里吹出飓风，";
	mes "从角上射出闪电，发射拳头，";
	mes "胸口还是火焰喷射器！";
	next;
	mes "[Towner]";
	mes "..............................";
	mes "你也不相信我。";
	mes "你刚才说什么？Zinger？";
	mes "Amazing Z？那是什么鬼？";
	close;
	}
	
veins,291,205,3	script	Kid#ve5	944,{
mes "[Kid]";
mes "啊！我是保护芙蕾雅女神和阿鲁纳佩尔茨的战神！";
	mes "啊啊啊！我们的敌人都去死！";
	next;
	mes "[Kid]";
	mes "烧吧，异端，烧吧！";
	mes "摧毁你们的家园和家庭，";
	mes "为芙蕾雅建立完美新世界！";
	next;
	mes "[Kid]";
	mes "嘻嘻！听起来很棒吧！";
	mes "我长大后也要成为那样的英雄！";
	close;
	}
	
	veins,291,259,3	script	Old Man#ve4	945,{
	mes "[Old Man]";
	mes "芙……芙……";
	next;
	mes "[Old Man]";
	mes "芙……";
	next;
	mes "[Old Man]";
	mes "赞美芙蕾雅！^333333*咳*^000000";
mes "^333333*Cough cough*^000000 Fre...";
mes "^333333*Cough*^000000 Praise Freya!";
mes "芙蕾雅！征服亵渎你的人！";
	mes "让我在死前看到那一天！";
	next;
	mes "[Old Man]";
	mes "我从未后悔信仰你，^333333*咳*^000000 我的女神！^333333*咳*^000000";
	mes "愿敌人的苦难在死前将他们逼疯！";
	close;
	}
	
veins,291,284,3	script	Old Lady#ve3	942,{
mes "[Old Lady]";
mes "不知道我在芙蕾雅心中的地位如何。";
	mes "希望离开这个世界时她能怜悯我。";
	mes "我在这里的日子屈指可数……";
	close;
	}
	
	veins,248,301,3	script	Kid#ve6	944,{
	mes "[Kid]";
	mes "嗯？你不住这里。";
	mes "你是……旅行者吗？";
	mes "你一定去过很多地方吧？那些地方是什么样的？我长大后也想旅行～";
	next;
	mes "[Kid]";
	mes "我喜欢这座城，但想看看别人怎么生活。";
	mes "大人们觉得这不好，说芙蕾雅讨厌这样。";
	mes "我一直好奇，真的有那么糟吗？";
	close;
}

veins,161,63,3	script	Old Man#ve5	945,{
	mes "[Old Man]";
	mes "哦，你一定是";

veins,162,34,5	script	Towner#ve1	943,{
	mes "[Towner]";
	mes "我喜欢仙人掌。它们是";
	mes "沙漠里最美丽的植物。";
	mes "有时，它们是荒芜土地上";
	mes "唯一的生命迹象。";
	next;
	mes "[Towner]";
	mes "如果看着仙人掌时心有所动，";
	mes "你一定懂得欣赏沙漠真正的美。";
	next;
	mes "[Towner]";
	mes "我不知道能否找到像我一样";
	mes "觉得沙漠美丽迷人的人。";
	mes "真遗憾。";
	close;
	}

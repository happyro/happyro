			mes "我会躲起来远远确认是不是 Avant。";
			next;
			mes "[Hisie]";
			mes "我想悄悄进入艾可拉治。";
			mes "进入艾可拉治广场前，在岔路口见我。";
			mes "别忘了带实验材料。";
			ep14_2_mylord = 19;
			changequest 7440,7441;
		}
		else {
			cutin "hisie03",0;
			mes "参谋长这么说的吗？";
			mes "除非他想用一项伟大的研究给所有人一个惊喜，";
			mes "我确定那个魔法学者不是普通拉斐尔。 ";
			next;
			cutin "hisie01",0;
			mes "[Hisie]";
			mes "通常，真理之门的那些怪人都以自己的作品为傲，不喜欢把它藏起来。";
			mes "那个魔法学者肯定有问题。我很担心。";
			next;
			mes "[Hisie]";
			mes "我们最好调查他。";
			mes "如果得不到学者信息，可以追查 Shenime。";
			next;
			mes "[Hisie]";
			mes "那部分就交给你了。";
			mes "我有些担心，所以要亲自去确认。";
			mes "期待听到你的好消息！";
			changequest 7438,7439;
		}
	}
	else if (ep14_2_mylord == 19) {
		if (countitem(6561) > 9 && countitem(6560) > 9) {
			cutin "hisie01",0;
			mes "好，这些够了。";
			mes "我想悄悄进入艾可拉治。";
			next;
			mes "[Hisie]";
			mes "进入艾可拉治广场前，在岔路口见我。";
			mes "现在出发！";
		}
		else {
			cutin "hisie01",0;
			mes "为了自然接近他，我们需要找到实验材料。";
			mes "把材料带给他，假装是 Shenime 派你来的。";
			next;
			mes "[Hisie]";
			mes "幸好我前几天已经替他们找到过那些材料。现在只要再找到同样的东西就行了。";
			mes "是 10 个尘球和 10 个书签，对吧？";
		}
	}
	else if (ep14_2_mylord == 20) {
		cutin "hisie01",0;
		mes "虽然他换了发色，但肯定是 Avant。 ";
		mes "正如那句俗话所说：‘灯塔不会照亮自己的根基。’嘿嘿……";
		next;
		mes "[Hisie]";
		mes "我必须把这事告诉 Kar。";
		mes "快点";
	}
	else if (ep14_2_mylord == 21) {
		cutin "hisie01",0;
		mes "我得看看 Avant 在研究什么。";
		mes "我们快点吧。";
	}
	else if (ep14_2_mylord == 22 || ep14_2_mylord == 23) {
		cutin "hisie03",0;
		mes "你本该把 Avant 的研究材料带给 Kar。";
		mes "你为什么在这里？";
	}
	else if (ep14_2_mylord == 24) {
		cutin "hisie01",0;
		mes "我看到他们正在加强对宝珠的守卫……";
		mes "我总觉得自己忘了什么……";
		next;
		switch( select("关于 Avant:关于参谋长") ) {
			mes "[Hisie]";
		case 1:
			mes "那个邪恶的人只是在笑，什么也不说。";
			mes "他只是在重复同样的回答，比如‘因为有趣’或‘因为好玩’。";
			next;
			mes "[Hisie]";
			mes "虽然我早就料到会这样……";
			mes "但应付他的性格还是让我非常烦躁。";
			next;
			cutin "hisie03",0;
			mes "[Hisie]";
			mes "而且，他一见到我就拒绝了我。可现在他似乎对我的身体很感兴趣，";
			mes "每次见到他，我都觉得自己正在被检查，实在令人毛骨悚然。";
			next;
			mes "[Hisie]";
			mes "他只是惊讶于我长大后如此明显地体现了混合血统。";
			mes "我大概永远不会承认那样的人是我的父亲！";
			break;
		case 2:
			cutin "hisie03",0;
			mes "....!";
			mes "对了！还有首席大臣！";
			mes "我怎么会把他忘了？";
			mes "我太专注于阿凡特，完全忘记了他。";
			next;
			cutin "hisie01",0;
			mes "[Hisie]";
			mes "首席大臣还不知道阿凡特已经入狱。";
			mes "如果他就是在幕后操纵一切的人，现在应该已经开始担心了……";
			next;
			select("我该去看看他吗？");
			mes "[Hisie]";
			mes "谢谢你的建议。";
			mes "请帮帮我们。";
			mes "如果卡尔或我亲自去处理，看起来不太合适。";
			next;
			cutin "hisie02",0;
			mes "[Hisie]";
			mes "尤其是卡尔去的话，其他拉斐尔人可能会误解他。";
			mes "偏见有时会造成很大的伤害。";
			ep14_2_mylord = 25;
			setquest 7445;
			break;
		}
	}
	else if (ep14_2_mylord == 25) {
		cutin "hisie01",0;
		mes "你一直和首席大臣有接触，由你接近他会容易一些。";
		mes "虽然卡尔是市长，但他可能是历史上权力最小的那一位。";
		next;
		mes "[Hisie]";
		mes "大多数拉斐尔人只希望卡尔保管从历任市长那里继承的信息，";
		mes "然后安静地把它们传给下一任市长。";
		mes "每当他想做点什么，总会遇到很多阻力。";
		next;
		mes "[Hisie]";
		mes "支持卡尔的人并不多。";
		mes "所以我希望你能帮助他。";
		mes "首席大臣就交给你了。";
		next;
		mes "[Hisie]";
		mes "如果你发现了什么，就回到卡尔所在的地方。";
	}
	else if (ep14_2_mylord < 32) {
		cutin "hisie01",0;
		mes "我们去伊克拉斯吧。";
		mes "我要去和 Kar 谈谈。";
	}
	else {
		cutin "hisie01",0;
		mes "我在宫殿待的时间比在这里更多。";
		mes "因为我必须输送魔力来替换宝珠的内部核心……";
		next;
		cutin "hisie04",0;
		mes "[Hisie]";
		mes "非常感谢你的帮助。";
		mes "等一切恢复正常后，我想再和你聊聊。";
	}
	close2;
	cutin "",255;
	end;
}


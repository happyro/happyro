eclage,307,237,0	script	Normal Yai#tllb	CLEAR_NPC,{
	if (ep14_2_mylord == 19 || ep14_2_mylord == 20 || ep14_2_mylord == 21) {
		cutin "hisie01",0;
		mes "[Hisie]";
		if (ep14_2_mylord == 19) {
			if (countitem(6561) > 9 && countitem(6560) > 9) {
				mes "就是这座雅伊。";
				mes "记得表现得自然一点。";
				mes "别进去，要想办法让他出来。";
				next;
				cutin "avn_labo",4;
				mes "看到希希藏起来后，你敲响了雅伊的门。";
				mes "敲了一会儿门后，你感觉到有人靠近门边，随后门上打开了一扇只能露出一只眼睛的小窗。";
				next;
				cutin "",255;
				mes "[A voice from inside]";
				mes "...Who's this?";
				mes "是人类吗？";
				mes "有意思。";
				next;
				cutin "avant01",1;
				mes "雅伊的门打开了，一名金发拉斐尔人走了出来。";
				mes "他脸上带着饶有兴致的表情，从头到脚打量着我。";
				next;
				mes "[Golden-haired Scholar]";
				mes "人类……没什么好看的。";
				mes "但人类为什么想见我？";
				mes "如果是些无聊的事，你会后悔的。";
				next;
				select("配送……:Shenime 让我来的……");
				mes "[Golden-haired Scholar]";
				mes "什么，希妮米派你来的？";
				mes "尘球和落叶制成的书签。";
				mes "没用……啧。";
				next;
				mes "[Golden-haired Scholar]";
				mes "嘿，人类。";
				mes "比起这些没用的东西，我对你更感兴趣。";
				mes "你想成为我的实验对象吗？";
				next;
				cutin "avant02",1;
				mes "[Golden-haired Scholar]";
				mes "你可以毫无痛苦地安息。";
				mes "这对你来说不是个不错的选择吗？";
				mes "....Kkekekeke";
				next;
				mes "[Golden-haired Scholar]";
				mes "看看你这副表情！";
				mes "如果你不愿意，就别再想来这里了。";
				next;
				cutin "",255;
				mes "魔法学者脸上挂着讽刺的笑容，一把夺过材料，回到了雅伊里。";
				mes "他离开后，希希从一片叶子后面溜了出来。";
				next;
				cutin "hisie03",0;
				mes "[Hisie]";
				mes "那家伙就是阿凡特。";
				mes "我想应该是他。";
				mes "他换了发色，我差点没认出来。但他的样子和说话方式几乎完全一样。真恶心！";
				next;
				cutin "hisie01",0;
				mes "[Hisie]";
				mes "首席大臣真的认识这个人吗？";
				mes "不管怎样，既然知道他的下落了，我们去告诉卡尔吧。";
				delitem 6561,10;// Dustball
				delitem 6560,10;// Leaf_Bookmark
				ep14_2_mylord = 20;
				changequest 7441,7442;
			}
			else {
				mes "你带好尘球和落叶制成的书签了吗？";
				mes "你必须快一点。";
				mes "否则他会怀疑你的。";
			}
		}
		else if (ep14_2_mylord == 20) {
			mes "趁他还没发现我们，先离开这里吧。";
			mes "我们必须先把这件事告诉卡尔。";
		}
		else if (ep14_2_mylord == 21) {
			mes "这是阿凡特的雅伊，里面可能装有某些设备。";
			mes "总之，我们先等着看看有没有机会。";
			next;
			switch( select("Go in right now.:Wait and look all around.") ) {
			case 1:
				if ($111204_avantlabo == 0) {
					$111204_avantlabo = 1;
					warp "que_avan01",26,26;
					initnpctimer;
					end;
				}
				mes "[Hisie]";
				mes "嘘，我听到里面有人。";
				mes "再等一会儿。他离开后我们再进去。";
				break;
			case 2:
				cutin "hisie03",0;
				mes "[Hisie]";
				mes "我感觉到了某种魔法装置……";
				mes "越看越觉得这座雅伊不太寻常。";
				mes "它可能连接着另一个地方。";
				next;
				cutin "hisie01",0;
				mes "[Hisie]";
				mes "小心一点。";
				break;
			}
		}
	}
	else {
		cutin "avn_labo",4;
		if (ep14_2_mylord == 22) {
			mes "这是一座连接魔法学者秘密研究室的雅伊。";
			mes "魔法学者阿凡特应该已经被希希制服了。";
		}
		else if (ep14_2_mylord == 23) {
			mes "这是一座连接魔法学者秘密研究室的雅伊。";
			mes "魔法学者阿凡特已经被制服，不在这里了。";
		}
		else {
			mes "这是拉斐尔人的雅伊。";
			mes "门被牢牢锁住了。";
		}
	}
	close2;
	cutin "",255;
	end;

OnTimer400000:
	if ($111204_avantlabo == 1)
		$111204_avantlabo = 0;
	stopnpctimer;
	end;
}

que_avan01,26,26,0	script	#tltimer	HIDDEN_WARP_NPC,0,1,{
	end;
OnTouch_:
	mes "刚进去时明明还是一座小雅伊，但从眩晕中恢复意识后，眼前却出现了巨大的空间。";
	initnpctimer;
	hideonnpc "#tltimer";
	next;
	cutin "hisie01",0;
	mes "[Hisie]";
	mes "看来普通的雅伊连接着一间秘密研究室。";
	mes "真谨慎……";
	mes "我们进去看看吧。";
	hideoffnpc "Hisie#tlspt";
	close2;
	cutin "",255;
	end;

OnTimer5000:
	mapannounce "que_avan01","Welcome, Sir Avant. User certification standby for 5 minutes.",bc_map,"0xA8A8A8";
	end;
OnTimer360000:
	mapannounce "que_avan01","Warning: Long-term use was not certified. Restrictive magic on unauthorized personnel will automatically be executed.",bc_map,"0xA8A8A8";
	end;
OnTimer365000:
	mapannounce "que_avan01","Research lab interior space has been distorted. Sweeping in process.",bc_map,"0x7b68ee";
	end;
OnTimer368000:
	mapwarp "que_avan01","eclage",265,275;
	end;
OnTimer370000:
	donpcevent "#avtmanager::OnReset";
	end;
OnTimer371000:
	$111204_avantlabo = 0;
OnStop:
	stopnpctimer;
	end;
}

que_avan01,18,38,0	script	Desk#tl01	CLEAR_NPC,{
	if (ep14_2_mylord == 21) {
		mes "这是一张摆满各种实验工具和文件的桌子。";
		mes "我们该怎么办？";
		cutin "avn_desk01",4;
		next;
		if (select("Examine the desk.:Ignore it.") == 2)
			mes "应该检查桌子的其他部分。";
		else {
			mes "我大致整理了桌上的东西。";
			mes "我们该调查什么？";
			cutin "avn_desk02",4;
			while (1) {
				next;
				if (.@book == 50)
					cutin "avn_desk04",4;
				else
					cutin "avn_desk02",4;
				switch( select("先看文件。","查看桌上的铰链装置。","查看书架上的书。","尝尝试剂。","查看照明装置。") ) {
				case 1:
					mes "……一个字也读不出来。";
					mes "把它拿给希希看看吧。";
					next;
					cutin "hisie01",0;
					mes "[Hisie]";
					mes "……《信任之门》期刊……";
					mes "……不太有用。";
					continue;
				case 2:
					if (.@book != 50) {
						mes "桌面上有各种带铰链的装置。";
						mes "这里一定有能帮助操作装置的提示。";
					}
					else {
						mes "桌面上有各种带铰链的装置。";
						mes "中间有一个小型数字面板，可以输入5位数字。";
						next;
						if (select("Input a number.:Look at other parts of the desk.") == 2)
							mes "看看桌子的其他部分。";
						else {
							input .@input;
							if (.@input == 31425) {
								mes "输入数字后，立刻听到咔哒一声。";
								mes "带铰链的装置打开了。";
								break;
							}
							mes "铰链没有打开。";
							mes "数字一定输错了。";
						}
					}
					continue;
				case 3:
					mes "书架上整齐地摆着5本书。";
					mes "上面有醒目的奇怪符号。";
					cutin "avn_book02",4;
					next;
					switch( select("Try rearranging the books.:Forget it.") ) {
					case 1:
						.@book = 0;
						setarray .@books$[0],"First","Second","Third","Fourth","Fifth";
						setarray .@select_place[0],1,3,0,2,4;
						for ( .@i = 0; .@i < 5; .@i++ ) {
							mes "应该把"+ .@books$[.@i] +"放在哪里？";
							next;
							.@select_book = select("First:Second:Third:Fourth:Fifth") -1;
							mes "第1本书被放在"+ .@books$[.@select_book] +"的位置。";
							if (.@select_book == .@select_place[.@i])
								.@book += 10;
							next;
						}
						if (.@book == 50) {
							mes "重新排列书籍后，符号组成了一幅图。";
							mes "这代表什么吗？";
							cutin "avn_book01",4;
						}
						else {
							mes "书籍被以各种方式重新排列，但什么也没发生。";
							cutin "avn_desk02",4;
						}
						continue;
					case 2:
						mes "应该检查桌子的其他部分。";
						continue;
					}
				case 4:
					mes "用手指尝了尝桌上的试剂。";
					mes "舌尖传来刺鼻的感觉，仿佛死亡的味道……";
					percentheal -50,0;
					continue;
				case 5:
					mes "这是一个普通的圆形照明系统。";
					mes "没有什么特别之处。";
					continue;
				}
				break;
			}
			next;
			mes "在桌子的秘密空间里发现了一部分研究文件。";
			mes "无法读出其中的内容。";
			mes "问问希希吧。";
			cutin "avn_desk03",4;
			next;
			mes "[Hisie]";
			mes "你发现了什么？";
			mes "嗯？？这是我母亲的画像。";
			mes "那个人为什么会有这个？";
			cutin "hisie01",0;
			next;
			switch( select("She's beautiful.:Look at these documents!") ) {
				mes "[Hisie]";
			case 1:
				cutin "hisie02",0;
				mes "卡尔和我的头发都遗传自母亲。";
				mes "对卡尔来说，这是她留下的重要纪念物……";
				next;
				cutin "hisie03",0;
				mes "[Hisie]";
				mes "更重要的是旁边的文件……这些研究文件一定就是他藏起来的东西。";
				mes "这个……内容……不可能……我不敢相信！";
				break;
			case 2:
				cutin "hisie03",0;
				mes "啊，对不起。我明白了。";
				mes "这是……";
				mes "不可能……我不敢相信。";
				break;
			}
			next;
			mes "[Hisie]";
			mes "阿凡特，这就是你研究的东西吗？";
			mes "你打算把它用在哪里？";
			next;
			select("那到底是什么？");
			cutin "hisie01",0;
			mes "[Hisie]";
			mes "这些研究文件与宝珠有关。";
			mes "宝珠是伊克拉斯的象征，也是强大魔力的核心！";
			mes "你打算用宝珠的魔力做什么？";
			next;
			mes "[Hisie]";
			mes "这项研究很危险。";
			mes "资助你的首席大臣知道这项研究的性质吗？";
			mes "我们必须马上让卡尔知道。";
			next;
			cutin "avant01",1;

				mes "不，我不吃药草。只是想为同事储备。";
			}
			close;
		case 2:
		mes "[警官皮普斯]";
			mes "哪里能找到药草？";
			next;
		mes "[警官皮普斯]";
			mes "在灌木丛附近找找，就能看到药草。";
			close;
		case 3:
			changequest 5317,5313;
			if (isbegin_quest(5308) == 0) {
				setquest 5308;
				completequest 5308;
			}
			ep15_1_mang = 0;
			if (countitem(6754)) {
				delitem 6754, countitem(6754);// Collected_Medicinal_Herbs
				mes "[警官皮普斯]";
				mes "I have taken away the herbs of your 采集药草。 So far, you have to leave first in a hurry!";
				close;
			}
		mes "[警官皮普斯]";
			mes "你现在可以离开。我会通知队长。";
			close;
		case 4:
		mes "[警官皮普斯]";
			mes "别忘了我需要 10 株药草。";
			close;
		}
	case 2:
		end;
	}
}

verus04,187,219,4	script	Thicket#EP15_1D_01	4_CREEPER,{
	if (checkweight(1301,1) == 0) {
		mes "- 你携带的物品太多，无法继续任务。-";
		close;
	}
	if (isbegin_quest(5317) == 1) {// Piffs's Request
		if (ep15_1_mang > 9) {
			mes "这种灌木在幻影之地到处生长。";
			close;
		}
		mes "这片灌木似乎藏着药草。你想做什么？";
		next;
		if (select( "采集药草。", "留下。" ) == 2) {
			mes "你决定放弃。";
			close;
		}
		progressbar "00ff00",2;
		if (rand(2))
			mes "灌木中没有找到药草。";
		else {
			ep15_1_mang++;
			getitem 6754,1;// Collected_Herb
			mes "采集了药草。";
		}
		close2;
		disablenpc();
		initnpctimer;
	}
	end;

OnTimer60000:
OnTimer120000:
OnTimer180000:
OnTimer240000:
	if (rand(1,2) != 1)
		end;
OnTimer300000:
	enablenpc();
	stopnpctimer;
	end;
}

	next;
	mes "[雷根贝勒警卫]";
	mes "一直向东走，然后沿道路向南。你会在拐角处看到一座巨大的雕像。";
	mes "我在你的小地图上标记位置。";
	viewpoint 1,242,87,0,0x4DFF00;
	next;
	mes "[雷根贝勒警卫]";
	mes "谁能想到雕像后面有隐藏地点？我们能找到它纯属幸运。";
	mes "通往那里的道路很危险。请注意安全。";
	close;
}

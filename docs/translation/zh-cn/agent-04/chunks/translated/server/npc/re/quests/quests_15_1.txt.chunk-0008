verus03,107,177,3	script	Luke Lapez#atnd09	4_M_EDEN_GUARDER,{
	if (checkweight(1301,3) == 0) {
		mes "- 你携带的物品太多，无法继续任务。-";
		close;
	}
	mes "[卢克]";
	if (ep15_1_atnad < 14) {
		cutin "looke_rapez04.bmp",0;
		mes "别担心他。";
		mes "他知道自己在做什么。";
		close3;
	}
	if (ep15_1_atnad == 14) {
		cutin "looke_rapez02.bmp",0;
		mes "...?";
		mes "有意思。";
		mes "他想要方便食用、多汁、清爽、味道干净的东西？";
		next;
		cutin "looke_rapez03.bmp",0;
		mes "[卢克]";
		mes "我有主意了。带些材料给我，我会为你做饭。";
		mes "我很确定它符合要求。";
		next;
		mes "[卢克]";
		mes "问题是";
		mes "材料很难找到。";
		mes "我在穿越维度旅行时学会了这个食谱。";
		next;
		cutin "looke_rapez04.bmp",0;
		mes "[卢克]";
		mes "那么，材料要由你来找：";
		mes "2 个肉、1 个莫拉柑橘和 1 根香蕉。你能找到吗？";
		next;
		cutin "looke_rapez02.bmp",0;
		mes "[卢克]";
		mes "一些水果生长在^4d4dff迷雾森林迷宫^000000附近。";
		mes "你得仔细找找。";
		erasequest 7624;// In Search of a Delicacy
		setquest 7625;// Count On Me
		ep15_1_atnad = 15;
		close3;
	}
	if (ep15_1_atnad == 15) {
		if (countitem(517) < 2 || countitem(11520) < 1 || countitem(513) < 1) {
			cutin "looke_rapez04.bmp",0;
			mes "你忘了材料吗？";
			mes "2 个肉、1 个莫拉橘子和 1 根香蕉。";
			next;
			mes "[卢克]";
			mes "一些水果生长在^4d4dff迷雾森林迷宫^000000附近。";
			mes "...";
			close3;
		}
		cutin "looke_rapez02.bmp",0;
		mes "这些应该够了。";
		mes "我有一阵子没做了，但食谱还记在脑子里。";
		next;
		mes "[卢克]";
		mes "完成了。";
		mes "这食物应该符合你说的所有条件。";
		next;
		cutin "",255;
		mes "Luke 给了你莫拉特产食物牛肉吐司。";
		mes "这完全符合 Ian 说他想要的东西。";
		delitem 517,2;	// Meat
		delitem 11520,1;// Mora_Mandarin
		delitem 513,1;	// Banana
		getitem 11519,1;// Beef_Toast
		erasequest 7625;// Count On Me
		setquest 7626;// Delicacy for Him
		ep15_1_atnad = 16;
		close;
	}
	if (ep15_1_atnad == 16) {
		cutin "looke_rapez01.bmp",0;
		mes "*轻笑*";
		mes "如果需要更多，从莫拉村购买会更容易。";
		mes "想尽办法赢得那个老人的好感。";
		next;
		mes "[卢克]";
		mes "否则你找不到队长想要的答案。";
		mes "祝你好运。";
		close3;
	}
	cutin "looke_rapez03.bmp",0;
	mes "这里很无聊，和其他地方一样。";
	mes "没有更强的怪物吗？";
	next;
	cutin "",255;
	mes "[劳埃德]";
	mes "别这么说。";
	mes "你会给我们带来厄运。";
	mes "我是勇敢的猫，但我的爪子连它们都抓不伤。";
	next;
	cutin "looke_rapez01.bmp",0;
	mes "[卢克]";
	mes "好吧，好吧。";
	mes "不过别担心。";
	mes "我不傻。";
	mes "我绝不会让负责的人陷入危险。";
	close3;
}

verus03,103,177,5	script	Machinist Lloyd#atnd09	4_M_BOSSCAT,{
	if (checkweight(1301,3) == 0) {
		mes "- 你携带的物品太多，无法继续任务。-";
		close;
	}
	mes "[劳埃德]";
	if (ep15_1_atnad < 9) {
		mes "你";
		mes "因为我是猫，就这样轻视我。";
		mes "啧，啧。";
		mes "你们人类真肤浅。";
		next;
		mes "[劳埃德]";
		mes "离我远点，管好你自己的事。";
		mes "只要你不偷走我的研究成果，我们就相安无事。";
		close;
	}
	if (ep15_1_atnad == 9) {
		mes "因为我是猫，你就这样轻视我。";
		next;
		select("你是劳埃德吗？");
		mes "[劳埃德]";
		mes "是啊，怎么了？";
		mes "嗯？Aures 派你来的？";
		mes "来检查我的进度？";
		next;
		mes "[劳埃德]";
		mes "哦，我遇到麻烦了。";
		mes "我必须达到他的期待，";
		mes "但我的研究一直没有进展。";
		next;
		mes "[劳埃德]";
		mes "嘿，你能帮我";
		mes "做点事吗？";
		next;
		switch( select( "Sure.", "What is a Cat doing here?", "No." ) ) {
		case 1:
			break;
		case 2:
			mes "[劳埃德]";
			mes "和许多马兰岛居民不同，我一直对新技术和文化感兴趣。";
			mes "我在公司工作过，也学过炼金术。";
			next;
			mes "[劳埃德]";
			mes "听说发现了维鲁斯城后我就来了。有人告诉我，必须加入挖掘队才能进入城市。";
			next;
			mes "[劳埃德]";
			mes "Aures 帮我进来的。";
			mes "我也是阿特纳德挖掘队的一员。";
			next;
			break;
		case 3:
			cutin "looke_rapez04.bmp",0;
			mes "[卢克]";
			mes "抱歉打断一下，";
			mes "但你是伊甸园集团派来帮助挖掘队的。";
			next;
			mes "[卢克]";
			mes "你的工作就是帮助劳埃德。";
			mes "你不能拒绝。";
			next;
			cutin "",255;
			mes "[劳埃德]";
			mes "他说得对！";
			mes "你有义务帮助我的研究！";
			next;
			break;
		}
		mes "[劳埃德]";
		mes "我们直入主题。";
		mes "嘿，人类，帮个忙。";
		mes "拿 10 个空玻璃瓶，";
		mes "收集机器人残骸周围的凝缩能量。";
		next;
		mes "[劳埃德]";
		mes "这里到处都是损坏的机器人和机器。";
		mes "它们附近能发现物质能量云。";
		next;
		mes "[劳埃德]";
		mes "把空瓶靠近能量，它就会进入瓶子。";
		mes "带 10 个瓶子给我。";
		next;
		mes "[劳埃德]";
		mes "我会等着。";
		erasequest 7620;// Young Blood?
		setquest 7621;// Bottling the Energy
		ep15_1_atnad = 10;
		close;
	}
	if (ep15_1_atnad == 10) {
		if (countitem(6756) < 10) {// Condensed_Energy
			mes "这里到处都是损坏的机器人和机器。";
			mes "它们附近能发现物质能量云。";
			next;
			mes "[劳埃德]";
			mes "把空瓶靠近能量，它就会进入瓶子。";
			mes "带 10 个瓶子给我。";
			next;
			mes "[劳埃德]";
			mes "你要问两遍，看来比外表看起来还笨。";
			close;
		}
		mes "哦，这些够了。";
		mes "干得好。";
		mes "我对你的评价提高了一档。";
		next;
		mes "[劳埃德]";
		mes "你让我的工作轻松多了。";
		mes "终于，我能帮上 Aures 的忙了。";
		mes "如果能找到能量凝结的原因和应用方法，也许";
		next;
		mes "[劳埃德]";
		mes "Ian 和我就能重新启动这里的机器人。";
		mes "这一直是我们的目标。";
		next;
		mes "[劳埃德]";
		mes "告诉 Aures 我有进展。";
		mes "干得好，人类。";
		mes "期待再次使用你的服务。";
		delitem 6756,10;// Condensed_Energy
		erasequest 7621;// Bottling the Energy
		setquest 7622;// Good News!
		ep15_1_atnad = 11;
		close;
	}
	if (ep15_1_atnad > 10 && ep15_1_atnad < 17) {
		mes "很快我每天都需要你的服务。";
		mes "别抱怨，为团队出份力吧。";
		close;
	}
	switch( checkquest(7629,PLAYTIME) ) {
	case -1:
		if (isbegin_quest(7628) == 0) {
			mes "你知道该怎么做：收集凝缩能量。";
			mes "你会帮我做的，对吧？";
			next;
			if (select( "Sure.","Decline." ) == 2) {
				mes "[劳埃德]";
				mes "怎么，你还有别的事？";
				mes "好吧，";
				mes "我让卢克带我去。";
				next;
				cutin "looke_rapez01.bmp",0;
				mes "[卢克]";
				mes "我还以为你永远不会开口！";
				mes "我早就想活动活动了。";
				close3;
			}
			mes "[劳埃德]";
			mes "你只要收集自然聚集在机器人和机器残骸周围的能量。";
			mes "我每天需要 10 个瓶子。";
			setquest 7628;// New Power Source
			close;
		}
		if (countitem(6756) < 10) {
			mes "你只要收集自然聚集在机器人和机器残骸周围的能量。";
			mes "我每天需要 10 个瓶子。";
			close;
		}
		mes "我觉得我开始喜欢你了！";
		mes "当然没有喜欢 Aures 和卢克那么多。";
		mes "好吧，我会好好利用这些能量。";
		next;
		mes "[劳埃德]";
		mes "明天再来。";
		mes "你也可以每天这个时候回来。";
		mes "你不能拒绝。";
		mes "我需要你。";
		delitem 6756,10;// Cohesive_Energy
		changequest 7628,7629;// Tomorrow for Tomorrow's Energy
		getexp 150000,1000000;
		close;
	case 0:
	case 1:
		mes "我正在分析收集到的能量。";
		mes "...";
		next;
		mes "[劳埃德]";
		mes "你听不懂吗？";
		mes "意思是我想一个人待着！";
		close;
	case 2:
		erasequest 7629;
		mes "嗯，也许我需要找到特殊的储存方法。";
		mes "能量太容易消散了。";
		next;
		mes "[劳埃德]";
		mes "我还需要更多装能量的瓶子。";
		mes "你好吗？";
		mes "准备好为团队出力了吗？";
		close;
	}
}
verus03,127,145,0	script	Machine Remnant#atnd01	4_ENERGY_RED,3,3,{
	if (checkweight(1301,3) == 0) {
		mes "- 你携带的物品太多，无法继续任务。-";
		close;
	}
	if (isbegin_quest(7621) != 1 && isbegin_quest(7628) != 1) {
		mes "现在不需要再收集能量。";
		close;
	}
	if (countitem(6756) > 9)// Condensed_Energy
		mes "你已经有足够的^4d4dff凝缩能量^000000。";
	else if (countitem(713) < 1)
		mes "收集凝缩能量需要^4d4dff空瓶^000000。";
	else {
		mes "破碎金属之间可以看到浓厚的能量云。";
		mes "将空瓶靠近能量云波动的边缘来收集能量。";
		next;
		progressbar "00ff00",3;
		delitem 713,1;// Empty Bottle
		getitem 6756,1;// Condensed_Energy
		mes "已收集凝缩能量！";
		initnpctimer;
		disablenpc();
	}
	close;

OnTimer30000:
	stopnpctimer;
	enablenpc();
	end;

OnTouch_:
	if (isbegin_quest(7621) == 1 || isbegin_quest(7628) == 1)
		specialeffect EF_LEVEL99_4;
	end;
}

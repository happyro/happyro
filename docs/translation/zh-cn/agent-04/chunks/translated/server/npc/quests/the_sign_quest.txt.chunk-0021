			close;
		case 2:
			mes "[基尔肯娜]";
			mes "嗯……？";
			mes "别告诉我你";
			mes "站在那个贱人一边！";
			mes "好吧，我不会强行拿走";
			mes "符文，但你最好";
			mes "好好想想……";
			emotion ET_THINK;
			close;
		}
	}
	else if (sign_q == 119) {
		if (countitem(2642) > 0) {
			mes "这是瑟琳的金戒指？";
			mes "太好了，它被";
			mes "她的气息强烈灌注。";
		mes "它的气息很强烈。很难找到与主人产生如此强烈共鸣的东西。";
			delitem 2642,1; //Serin's_Gold_Ring
			set sign_q,120;
			close;
		}
		else {
			mes "嗯，你没有";
			mes "任何与瑟琳有关的东西。";
			mes "这可不好。她已经藏起来了，";
			mes "可能";
			mes "再也找不到她的踪迹。我得做点什么……";
			set sign_q,121;
			close;
		}
	}
	else if ((sign_q == 120) || (sign_q == 121)) {
		mes "现在我制作的药剂";
		mes "正在处理，";
		mes "我终于能告诉你";
		mes "我一直想用你帮我";
		mes "取得的物品";
		mes "做什么了。";
		next;
		mes "[基尔肯娜]";
		mes "我没有解释";
		mes "想要九界符文的原因，";
		mes "是为了防止瑟琳";
		mes "起疑并逼你泄露我的计划。你看，瑟琳不适合尼夫海姆。";
		next;
		mes "[基尔肯娜]";
		mes "虽然她身处";
		mes "死者世界，瑟琳";
		mes "从未接受死亡，";
		mes "一直渴望复活。当然，这里每个人都会有这种自然反应……";
		next;
		mes "[基尔肯娜]";
		mes "然而，不像其他";
		mes "绝望、失去";
		mes "希望并接受命运的人，";
		mes "瑟琳从未放弃复活的希望。凭借希望，她保留了美貌与光明。";
		next;
		mes "[基尔肯娜]";
		mes "但她只是在否认";
		mes "自己应得的命运。";
		mes "她想做的事";
		mes "是错误的，我们必须";
		mes "在太晚前阻止她。";
		next;
		while(1) {
			switch(select("她想要什么？：她要做什么？：我该怎么办？")) {
			case 1:
				mes "[基尔肯娜]";
				mes "别搞错了：";
				mes "瑟琳想要";
				mes "九界符文。";
				next;
				mes "[基尔肯娜]";
				mes "如果她能多次使用它，就可以命令尼弗海姆的守卫放她通过，重新进入生者世界。";
				mes "但你的符号只能使用一次……";
				next;
				set .@kir_talk1,1;
				if ((.@kir_talk1 == 1) && (.@kir_talk2 == 1) && (.@kir_talk3 == 1)) {
					if (sign_q == 120) set sign_q,122;
					else if (sign_q == 121) set sign_q,123;
				}
				break;
			case 2:
				mes "[基尔肯娜]";
				mes "我认为瑟琳要";
				mes "召唤黑暗领主。由于";
				mes "她曾是伟大的巫师，";
				mes "这完全可能。不过她可能需要九界符文才能做到。";
				next;
				mes "[基尔肯娜]";
				mes "你可能认为人类能够击败黑暗领主，但你不知道，黑暗领主在你们世界显现的力量只有真正力量的一小部分。";
				next;
				mes "[基尔肯娜]";
				mes "黑暗领主有时能越界来到米德加尔特，但从他的世界来到我们这里需要巨大能量。你们世界的生命力也会与他的黑暗力量冲突。";
				next;
				mes "[基尔肯娜]";
				mes "如果黑暗领主被召唤到尼弗海姆，他就能轻易进入米德加尔特，使用全部毁灭力量。";
				next;
				mes "[基尔肯娜]";
				mes "塞林计划与黑暗领主交易：将他召唤到尼弗海姆，换取自己的复活。";
				next;
				mes "[基尔肯娜]";
				mes "虽然你得到了赫尔女士的好感，但她可能不会阻止黑暗领主。黑暗领主只想要米德加尔特。";
				next;
				mes "[基尔肯娜]";
				mes "现在想想，大量死亡反而会扩大赫尔女士的影响范围。";
				mes "我不认为她会帮助黑暗领主，但也不会妨碍他。";
				next;
				set .@kir_talk2,1;
				if ((.@kir_talk1 == 1) && (.@kir_talk2 == 1) && (.@kir_talk3 == 1)) {
					if (sign_q == 120) set sign_q,122;
					else if (sign_q == 121) set sign_q,123;
				}
				break;
			case 3:
				mes "[基尔肯娜]";
				mes "我需要你带上这瓶药剂，让塞林喝下。";
				mes "这瓶特殊药水会抹去她大部分记忆。";
				next;
				mes "[基尔肯娜]";
				mes "失去记忆后，塞林应该也会失去扭曲的野心。";
				mes "有了九界符文，塞林无法拒绝喝下药水。";
				next;
				mes "[基尔肯娜]";
				mes "所以符号至关重要。塞林很聪明，已经躲避喝药很久了……";
				next;
				set .@kir_talk3,1;
				if ((.@kir_talk1 == 1) && (.@kir_talk2 == 1) && (.@kir_talk3 == 1)) {
					if (sign_q == 120) set sign_q,122;
					else if (sign_q == 121) set sign_q,123;
				}
			}
			if ((sign_q == 122) || (sign_q == 123)) close;
		}
		close;
	}
	else if ((sign_q == 122) || (sign_q == 123)) {
		mes "药剂终于完成了。现在带上它，让塞林喝下。";
		next;
		mes "[基尔肯娜]";
		if (sign_q == 122) {
			mes "幸运的是，我能通过塞林的金戒指追踪她的位置。";
			mes "我会把你送过去，请不惜一切阻止她。";
			next;
			mes "[基尔肯娜]";
			mes "带上这些，它们对付她时可能有用。";
			mes "至于这些凭证，交给你的盟友，他们会直接前往塞林所在的位置。";
			next;
			mes "[基尔肯娜]";
			mes "处理完塞林后，别忘了把我给你的所有凭证带回来，好吗？";
			set sign_q,124;
			getitem 7308,1; //Witch's_Potion
			getitem 2643,1; //Serin's_Gold_Ring_
			getitem 7313,5; //Seal_Of_Witch
			close;
		}
		else if (sign_q == 123) {
			mes "我不确定塞林藏在哪里，但会把你送到她所在的大致位置。尽你所能阻止她。";
			next;
			mes "[基尔肯娜]";
			mes "现在我借给你这些女巫奖章。你可以借给盟友，帮助你对付塞林。";
			mes "记住，携带超过一枚就不会生效。";
			next;
			mes "[基尔肯娜]";
			mes "告诉你的盟友，他们必须从城堡二楼画像右侧的秘密通道进入。";
			mes "这样我就能把他们送到塞林那里。";
			next;
			mes "[基尔肯娜]";
			mes "处理完塞林后，别忘了把我借给你的所有女巫奖章带回来，好吗？";
			set sign_q,124;
			getitem 7308,1; //Witch's_Potion
			getitem 7313,5; //Seal_Of_Witch
			close;
		}
	}
	else if ((sign_q == 124) || (sign_q == 125) || (sign_q == 198)) {
		if ($@sign_w1 == 1) {
			mes "请稍等。我还在完成准备工作……";
			close;
		}
		if (countitem(2643) == 1) {
			mes "你终于回来了。我们可能没有足够时间阻止她，但必须试试。准备好了吗？";
			next;
			switch(select("是:否")) {
			case 1:
				close2;
				set $@sign_w1,1;
				warp "que_sign01",195,189;
				end;
			case 2:
				mes "[基尔肯娜]";
				mes "那就快点！没时间浪费了！";
				close;
			}
		}
		else {
			mes "我们必须在塞林做出可怕的事情前阻止她。准备出发了吗？";
			next;
			switch(select("是:否")) {
			case 1:
				mes "[基尔肯娜]";
				mes "好吧。祝你好运，";
				mes ""+strcharinfo(0)+"...";
				close2;
				warp "que_sign02",35,313;
				end;
			case 2:
				mes "[基尔肯娜]";
				mes "那就快点！没时间浪费了！";
				close;
			}
		}
	}
	else if ((sign_q == 127) || (sign_q == 128)) {
		if (countitem(2643) == 1) {
			if (countitem(7313) < 5) {
				mes "嗯……？我借给你的凭证都去哪了？";
				mes "请把它们全部找回来，再回到我这里。";
				close;
			}
			else {
				mes "你做得很好。失去前世的记忆后，塞林就能平静地留在尼弗海姆。";
				next;
				mes "[基尔肯娜]";
				mes "虽然她没能复活，但我相信她很高兴遇见你。我想她也开始明白，人生的意义不在于独自活着……";
				next;
				mes "[基尔肯娜]";
				mes "再次感谢你的帮助。完成这里的事情后，请去拜访我们的女王赫尔女士。";
				mes "我想她似乎有事想见你，"+strcharinfo(0)+"……";
				delitem 7313,5; //Seal_Of_Witch
				set sign_q,129;
				getexp (checkre(3))?50000:500000,0;
				close;
			}
		}
		else {
			if (countitem(7313) < 5) {
				mes "嗯……？我借给你的凭证都去哪了？请全部找回来，再回到我这里。";
				close;
			}
			else {
				mes "你做得很好。失去前世的记忆后，塞林就能平静地留在尼弗海姆。";
				next;
				mes "[基尔肯娜]";
				mes "虽然她没能复活，但我相信她很高兴遇见你。我想她也开始明白，人生的意义不在于独自活着……";
				next;
				mes "[基尔肯娜]";
				mes "再次感谢你的帮助。完成这里的事情后，请去拜访我们的女王赫尔女士。";
				delitem 7313,5; //Seal_Of_Witch
				set sign_q,130;
				getexp (checkre(3))?30000:300000,0;
				close;
			}
		}
	}
	else if ((sign_q == 136) || (sign_q == 135)) {
		mes "我很欣慰，看来我对你的期待没有错。";
		next;
		mes "[基尔肯娜]";
		mes "你做得很好。失去前世的记忆后，塞林就能平静地留在尼弗海姆。";
		next;
		mes "[基尔肯娜]";
		mes "虽然她没能复活，但我相信她很高兴遇见你。我想她也开始明白，人生的意义不在于独自活着……";
		next;
		mes "[基尔肯娜]";
		mes "再次感谢你的帮助。完成这里的事情后，请去拜访我们的女王赫尔女士。";
		if (countitem(2643) == 1) set sign_q,129;
		else set sign_q,130;
		getexp (checkre(3))?30000:300000,0;
		close;
	}
	else if (sign_q == 200) {
		mes "事关重大，你怎么会失败？塞林差点召唤黑暗领主，幸好有人及时阻止了她。";
		next;
		mes "[基尔肯娜]";
		mes "幸运的是，许多人会来到尼弗海姆接受诸神安排的考验。看来你刚刚没通过，女武神会选择其他人。";
		next;
		mes "[基尔肯娜]";
		mes "结束了。你失败了。";
		mes "不过你应该庆幸。如果不是塞林希望你自由，你的灵魂本可能被束缚在尼弗海姆。";
		next;
		mes "[基尔肯娜]";
		mes "你真的应该感谢她。不过，为了她而没通过考验还真讽刺……";
		if (countitem(2642) > 0) delitem 2642,1; //Serin's_Gold_Ring
		if (countitem(7308) > 0) delitem 7308,1; //Witch's_Potion
		set sign_q,201;
		getexp (checkre(3))?20000:200000,0;
		close;
	}
	else if (sign_q > 200) {
		mes "哼。我不想再和你说话了。";
		close;
	}
	else if ((sign_q > 130) && (sign_q < 136)) {
		mes "你必须赶快阻止塞林！";
		close;
	}
	else {
		mes "嗯？还在探索尼弗海姆？虽然你足够强大，能够生存，";
		mes "但没必要留在这里冒生命危险。";
		close;
	}
}


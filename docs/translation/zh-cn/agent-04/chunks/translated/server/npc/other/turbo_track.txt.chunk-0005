		donpcevent "hunting#"+.@w$+"::OnReset";
		donpcevent RName(.@w$)+"::OnEnable";
		disablenpc "bing2#"+.@w$;
		enablenpc "#cos_"+.@w$+"_end";
		stopnpctimer;
	} else {
		mapannounce strnpcinfo(4),"Once again, we'd like to thank our sponsors.",bc_map,"0x33FF66";
	}
	end;
	
OnTimer65000:
	set .@w$,callfunc("F_tt");

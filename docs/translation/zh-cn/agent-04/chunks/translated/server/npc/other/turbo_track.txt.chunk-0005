OnTimer55000:
	set .@w$,callfunc("F_tt");
	if (!compare(.@w$,"4")) mapannounce strnpcinfo(4),"And [Comodo Casino].",bc_map,"0x33FF66";
	end;

OnTimer58000:
	set .@w$,callfunc("F_tt");
	if (compare(.@w$,"4")) mapwarp strnpcinfo(4),"turbo_room",72,89;
	end;

OnTimer60000:
	set .@w$,callfunc("F_tt");
	if (compare(.@w$,"4")) {
		enablenpc "Notice_Maker1#TBT_"+.@w$;
		enablenpc "Notice_Maker3#TBT_"+.@w$;

hugel,76,134,3	script	Neha	101,{
	if (hg_odeng == 1) {
		if (countitem(584)) {
			mes "[Neha]";
			mes "哦，你是来送塞莱特的汤的，";
			mes "嗯？哼！";
			mes "你迟到了！难道不知道";
			mes "这汤不趁热喝";
			mes "就不好喝吗？";
			next;
			if (Sex == SEX_MALE) {
				mes "[Neha]";
				mes "不过……你长得很帅，";
				mes "所以我原谅你……";
				mes "但有个条件。带给我";
				mes "带 ^FF00001 根鞭子^000000来让我打你。";
				mes "用来打你的^FF0000鞭子^000000。";
				mes "你最好快点，小子，";
				mes "不然我不会轻易放过你。";
			} else {
				mes "[Neha]";
				mes "是的，是的……你应该";
				mes "受到惩罚。应该挨打。";
				mes "想完成配送的话，就带给我";
				mes "^FF00001 根鞭子^000000，让我打你，";
				mes "以惩罚你的无礼，姑娘！";
				mes "别想逃走。";
			}
			for(set .@i,8064; .@i<= 8067; set .@i,.@i+1) {
				if (checkquest(.@i) > -1 && checkquest(.@i) < 2)
					completequest .@i;
			}
			setquest 8068;
			set hg_odeng,6;
			close;
		} else {
			mes "[Neha]";
			mes "哦呵呵呵呵呵～";
			mes "我最喜欢可爱的小男孩了……";
			mes "不过不知为什么，";
			mes "稍微捉弄他们";
			mes "也让我很兴奋。呵呵～";
			close;
		}
	} else if (hg_odeng == 6) {
		if (countitem(1960) && countitem(584)) {
			mes "[Neha]";
			mes "终于……我的汤！";
			mes "你还带来了我的鞭子！";
			mes "别担心，我只会用力打你一次。";
			mes "你还没反应过来就结束了～";
			mes "马上就好。";
			next;
			mes "[Neha]";
			mes "哈！";
			next;
			mes "^3355FF*Slap*^000000";
			percentheal -25,0;
			next;
			mes "[Neha]";
			mes "嘿呀！！";
			next;
			mes "^3355FF*SLAP*^000000";
			percentheal -25,0;
			next;
			mes "[Neha]";
			mes "哦，我是不是不小心";
			mes "打了你两次？嘿嘿……";
			mes "好了，我很满意。";
			mes "我会告诉塞莱特";
			mes "你做得很好……希望你再来送我的汤～";
			mes "下次见。";
			delitem 1960,1; //Whip
			delitem 584,1; //Fish_Ball_Soup
			set hg_odeng,10;
			changequest 8068,8072;
			close;
		} else {
			mes "[Neha]";
			mes "^FF00001 鱼糕汤^000000……";
			mes "^FF00001 鞭子^000000……";
			mes "姑娘要这些东西过分吗？";
			mes "我饿了，还想打人！";
			mes "这有什么不对，嗯？";
			mes "现在快点！";
			close;
		}
	} else {
		mes "[Neha]";
		mes "哦呵呵呵呵呵～";
		mes "我最喜欢可爱的小男孩了……";
		mes "不过不知为什么，";
		mes "稍微捉弄他们";
		mes "也让我很兴奋。呵呵～";

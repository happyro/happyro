		lhz_cube,234,200,0	script	Desk#cube	HIDDEN_NPC,{
		if (lhz_secret02 < 2) {
		mes "^3355FF你发现了一张";
		mes "杂乱不堪的书桌。^000000";
		next;
	switch( select( "桌面", "桌下", "抽屉" ) ) {
		case 1:
		mes "^3355FF桌上散落着各种文件、";
		mes "书籍和实验设备。";
		mes "但现在似乎都没什么用。^000000";
		close;
		case 2:
		if (lhz_secret02 < 1) {
		mes "^3355FF你在最意想不到的桌下";
	mes "找到一根决定留下的^000000短棍^3355FF。";
mes "这种东西什么时候会派上用场，";
mes "谁也说不准。^000000";
lhz_secret02 = 1;
	}
		else {
		mes "^3355FF这里就是你找到^000000短棍^3355FF的地方。";
		mes "遗憾的是，桌下没有更多隐藏宝藏。^000000";
		}
		close;
			case 3:
			mes "^3355FF书桌抽屉锁着，";
			mes "而且肯定事出有因。";
			mes "毕竟你刚试图侵犯这个私密空间。^000000";
			close;
		}
		}
			if (lhz_secret02 == 2) {
			mes "^3355FF你回到那张杂乱的书桌前，";
			mes "它大概属于一位让别人替他整理桌面的高级主管。^000000";
			next;
			switch( select( "桌面", "桌下", "抽屉" ) ) {
			case 1:
			mes "^3355FF唉，无论你怎么翻找，";
		mes "桌上的杂物对你都毫无用处。^000000";
		next;
	if (Sex == SEX_MALE) {
	mes "^3355FF一本舞者杂志《和谐舔舐》";
		mes "吸引了你的目光，";
		mes "但你不该只因为图片而对它感兴趣。^000000";
		}
		else {
		mes "^3355FF一本女性娱乐杂志《怒爆》";
			mes "吸引了你的目光，";
			mes "但冒险者没时间欣赏美男子的照片。^000000";
			}
			close;
			case 2:
		mes "^3355FF你在桌下发现另一根短棍，";
		mes "它恰好能与之前找到的短棍完美拼合。";
			next;
			mes "^3355FF你将两根短棍合在一起，";
			mes "制成了超越部分总和的棍子。";
			mes "现在你自豪地持有一根^000000长棍^3355FF。^000000";
			lhz_secret02 = 3;
			close;
			case 3:
			mes "^3355FF这个抽屉牢牢锁着，";
			mes "大概永远如此。里面可能没有贵重物品，";
			mes "最多只有酒壶或糖果。";
			close;
			}
			}
		mes "^3355FF这张书桌杂乱不堪，";
		mes "堆满各种杂物，不过这就是办公设备的命运。^000000";
	next;
	switch( select( "On the desk", "Under the desk", "Desk drawer" ) ) {
		case 1:
		mes "^3355FF唉，无论你怎么翻找，";
		mes "你怎么翻找，桌上的杂物";
		mes "对你都没有用。^000000";
		next;
			mes "^3355FF这里有一部分报纸，";
			mes "这里有一份报纸，但只有漫画版，";
			mes "当然不足以满足你这样的博学冒险者。^000000";
			close;
			case 2:
		mes "^3355FF你就是在这里找到";
		mes "这里是你找到两根短棍之一的地方，";
			mes "用来制作^000000长棍^3355FF。";
			mes "下面没有其他东西，无法再把棍子变长了。^000000";
			close;
			case 3:
			mes "^3355FF这张书桌的抽屉";
			mes "抽屉锁得很牢。";
			mes "桌子的主人采取抽屉安全措施很明智。";
			mes "但为什么把棍子放在桌下？真奇怪……^000000";
				close;
				}
				}
				

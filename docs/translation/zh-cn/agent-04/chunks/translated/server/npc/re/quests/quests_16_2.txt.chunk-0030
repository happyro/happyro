		mes "[Margaret]";
		mes "Jooshin 很爱那个女孩，但她过早离世。";
		mes "....";
		next;
		mes "[Margaret]";
		mes "... 非常感谢你把这个给我。";
		mes "愿 Jooshin 的祝福永远与你同在。";
		delitem 25181,1;// Wood Rosary
		setquest 7748;// Wooden Rosary
		completequest 7748;// Wooden Rosary
		getexp 100000,100000;
		close;
	case 1:
	case 2:
		mes "[Margaret]";
		mes "我过去常和 Sorin 一起拜访卡皮托利纳修道院。";
		mes "她性格开朗，和修士们相处得很好。";
		next;
		mes "[Margaret]";
		mes "她需要休息时，也会来这里放松……";
		next;
		mes "[Margaret]";
		mes "……虽然这里的路相当崎岖。";
		mes "如果你现在要回去，要我送你去普隆德拉吗？";
		next;
		if (select( "好的，请送我。", "不用，谢谢。" ) == 2) {
			mes "[Margaret]";
			mes "以后需要的话，尽管告诉我。";
			close;
		}
		mes "[Margaret]";
		mes "……再见。";
		close2;
		warp "prontera",156,119;
		end;
	}
}

yuno_in01,163,31,3	script	Blacksmith Cleaver#ep16	4_TOWER_17,{
	switch( isbegin_quest(7749) ) {
	case 0:
		if (countitem(25183) < 1) {
			mes "[Cleaver]";
			mes "你可以在那里冶炼装备。";
			mes "我不接受个人制作或冶炼请求。";
			close;
		}
		mes "[Cleaver]";
		mes "谁在那里？来购物的吗？";
		mes "我不接受个人制作请求。";
		next;
		mes "[Cleaver]";
		mes "等等，我能看看那个弓箭手顶针吗？";
		mes "这个装饰是……";
		next;
		mes "[Cleaver]";
		mes "嘿！Alt 怎么了？";
		mes "他上次来这里时，为弓箭手顶针制作了这个装饰。";
		next;
		mes "[Cleaver]";
		mes "在弓箭手顶针上镶珠宝！听起来很疯狂吧。但这花了他好几天，他甚至都没有睡觉！";
		next;
		mes "[Cleaver]";
		mes "因为制作很辛苦，我本想帮助他。但他还是独自完成了这个弓箭手顶针……";
		next;
		mes "[Cleaver]";
		mes "你为什么有这个？";
		next;
		select("这是遗物。");
		mes "[Cleaver]";
		mes "……什么？";
		mes "不……等等……请等一下。";
		mes "我确实听到过一些传闻……";
		next;
		mes "[Cleaver]";
		mes "但我仍相信没有消息就是好消息……";
		mes "没想到会这样，突然之间……";
		next;
		mes "[Cleaver]";
		mes "……什么……真是个傻瓜。";
		mes "他为什么制作连自己都无法送出的礼物？";
		next;
		mes "[Cleaver]";
		mes "……唉……";
		mes "最后竟然会这样结束……";
		next;
		mes "[Cleaver]";
		mes "谢谢你……一路来到这里。";
		mes "我得暂时把工作放一放。";
		mes "....";
		delitem 25183,1;// Deco_Thimble_Archer
		setquest 7749;// Bow Thimble Decoration
		completequest 7749;// Bow Thimble Decoration
		getexp 100000,100000;
		close;
	case 1:
	case 2:
		mes "[Cleaver]";
		mes "Alt 有个哥哥。";
		mes "……我会把这个交给他。";
		mes "他现在处于关键时刻，我会找机会把它交给他。";
		next;
		mes "[Cleaver]";
		mes "……可恶。";
		mes "我没法继续工作了。";
		close;
	}
}

que_job01,89,91,1	script	Guile Marovitz#ep162	1_M_JOBTESTER,{
	switch( isbegin_quest(7750) ) {
	case 0:
		if (countitem(25182) < 1) {
			mes "[Guile Marovitz]";
			mes "……如果你想成为刺客，就去沙漠东边。";
			close;
		}
		mes "[Guile Marovitz]";
		mes "真是少见。";
		mes "是什么把你带到这里来的？";
		next;
		mes "[Guile Marovitz]";
		mes "这把短剑是……";
		mes "没错。艾雷梅斯……";
		mes "终于回来了。";
		next;
		mes "[Guile Marovitz]";
		mes "我派他出任务已经是很久以前的事了……他回来得太晚。";
		npctalk "......", "", bc_self;
		next;
		mes "[Guile Marovitz]";
		mes "这次任务算失败还是成功？";
		mes "……他是那种最讨厌任务失败的人。";
		next;
		mes "[Guile Marovitz]";
		mes "我喜欢认真完成任务的人。不过这次……我倒希望他放弃任务，去度个假。";
		next;
		mes "[Guile Marovitz]";
		mes "我会照顾好他……嗯。";
		mes "谢谢你。";
		delitem 25182,1;// Assassin_PT_Dagger
		setquest 7750;// Assassin Dagger with Glyph
		erasequest 7750;// Assassin Dagger with Glyph
		getexp 100000,100000;
		close;
	case 1:
	case 2:
		mes "[Guile Marovitz]";
		mes "在这一行，任务结束后同伴没能回来是很常见的事。";
		next;
		mes "[Guile Marovitz]";
		mes "有些幸运的人会像这样回来。";
		mes "而他确实很幸运。";
		next;
		mes "[Guile Marovitz]";
		mes "没必要难过。";
		mes "只是有些遗憾。";
		mes "仅此而已。";
		close;
	}
}

payon_in03,194,39,3	script	Hunter Sherine#ep162	4_F_JOB_HUNTER,{
	switch( isbegin_quest(7751) ) {
	case 0:
		if (countitem(25184) < 1) {
			mes "[Sherine]";
			mes "过去，猎人公会位于斐扬森林。";
			mes "而我是在斐扬长大的。";
			next;
			mes "[Sherine]";
			mes "所以我偶尔会回斐扬看看。";
			mes "....";
			close;
		}
		npctalk "......", "", bc_self;
		unittalk getcharid(3), "" + strcharinfo(0) + " : ....", bc_self;
		mes "[Sherine]";
		mes "不知道为什么，今天我就是想来这里。";
		mes "也许就是为了这个。";
		next;
		mes "[Sherine]";
		mes "我那个傻妹妹。";
		mes "……其实，她不太会缝纫。";
		next;
		mes "[Sherine]";
		mes "她连一颗纽扣都缝不好。";
		mes ".......";
		next;
		mes "[Sherine]";
		mes "有一天，她问我：";
		mes "我是不是应该表现得更像个女孩子？";
		next;
		mes "[Sherine]";
		mes "要不我只缝一颗纽扣试试？";
		next;
		mes "[Sherine]";
		mes "于是我把这个针线盒给了她。";
		mes "我不知道她拿走它时心里想着谁。";
		next;
		mes "[Sherine]";
		mes ".........";
		mes "备用纽扣不见了。";
		mes "……她把它缝好了吗？";
		next;
		mes "[Sherine]";
		mes "我料到了会有这一天，却没想过这个东西会回来。";
		mes "……既然这是她的选择……我必须接受……但是……";
		next;
		mes "Sherine is holding back her tears.";
		mes "Leave her alone.";
		next;
		mes "[Sherine]";
		mes "……谢……谢你……";
		delitem 25184,1;// Portable_Sewingbox
		setquest 7751;// Portable Sewing Kit
		erasequest 7751;// Portable Sewing Kit
		getexp 100000,100000;
		close;
	case 1:
	case 2:
		mes "[Sherine]";
		mes "……请让我一个人静静。";
		mes "……对不起。";
		close;
	}
}

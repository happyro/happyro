morocc_in,116,101,3	script	Old Scholar Tyus#hellion	735,3,3,{
	if ((MaxWeight-Weight) < 2000 || checkweight(1201,1) == 0) {
		mes "^3355FF站住！";
		mes "你携带的物品太多，背包没有足够空间领取奖励。 请腾出背包空间后再回来接受挑战。";
		close;
	}
	if (HELLIONQ < 36) {
		mes "[奇利亚斯·泰尤斯爵士]";
		mes "你好……";
		mes "我叫奇利亚斯·泰尤斯爵士。";
		mes "我在卢恩·米德加尔特生活了很久";
		mes "也见识了许多";
		mes "事物。力量、嫉妒、苦难……";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "那么究竟是什么";
		mes "让你来到";
		mes "梦罗克中央？";
		next;
		mes "[奇利亚斯·泰尤斯爵士]";
		mes "这片土地被贪婪和自私的疾病";
		mes "腐蚀了。";
		mes "无论走到哪里";
		mes "人们都冷酷无情，";
		mes "但我仍相信能找到值得帮助我的人……";
		next;
		mes "[奇利亚斯·泰尤斯爵士]";
		mes "这里不缺";
		mes "勇敢强大的战士。";
		mes "在这危险的时代。";
		mes "但为了我寻找的东西，";
		mes "我必须得到一个";
		mes "真正心地纯洁之人的帮助……";
		next;
		if (select("你在寻找什么？:心地纯洁？哈！祝你好运！") == 1) {
			if (BaseLevel < 60 ) {
				mes "[奇利亚斯·泰尤斯爵士]";
				mes "呵呵～我看得出你的眼神";
				mes "闪烁着热情，";
				mes "但这项任务对你来说可能太难。";
				mes "抱歉，这是我无法忽视的现实……";
				mes "";
				mes "";
				next;
				mes "[奇利亚斯·泰尤斯爵士]";
			mes "去外面的世界提升实力吧。";
			mes "也许你变强后，我就能依靠你的帮助。";
			mes "";
			mes "";
			mes "";
				close;
			}
			mes "[奇利亚斯·泰尤斯爵士]";
			mes "我先告诉你我祖父的故事吧。";
			mes "他曾是像你一样年轻无畏的冒险者，和三位朋友一起周游世界……";
			mes "";
			mes "";
			mes "";
			next;
			mes "[奇利亚斯·泰尤斯爵士]";
			mes "四人一起进行了许多探险，";
			mes "多年后成为配合默契、勇敢无畏的团队。";
			mes "";
			mes "";
			mes "";
			mes "";
			next;
			mes "[奇利亚斯·泰尤斯爵士]";
			mes "一次普通旅程中，他们发现了一座未标记的洞穴。";
			mes "四人出于好奇且需要休息，便进入洞穴，在那里遇到了最可怕的生物……";
			mes "";
			mes "";
			next;
			mes "[奇利亚斯·泰尤斯爵士]";
			mes "那是一头凶猛野兽，";
			mes "角像他们的武器一样巨大锋利，双眼燃烧着地狱之火。";
			mes "祖父看得出它渴望鲜血。";
			mes "";
			mes "";
			mes "";
			next;
			mes "[奇利亚斯·泰尤斯爵士]";
			mes "他们尽快逃离野兽，";
			mes "但四人在洞穴黑暗中走散，只能藏在黑暗里……";
			mes "";
			mes "";
			mes "";
			mes "";
			next;
			mes "[奇利亚斯·泰尤斯爵士]";
			mes "祖父躲藏时听见朋友们被怪物逐一屠杀的惨叫。";
			mes "惨叫和怪物的咆哮越来越近……";
			mes "";
			mes "";
			mes "";
			mes "";
			next;
			mes "[奇利亚斯·泰尤斯爵士]";
			mes "祖父无法忍受同伴的痛苦，跳出藏身处试图救他们。";
			mes "野兽发现了他，双方展开战斗。";
			mes "";
			mes "";
			mes "";
			mes "";
			next;
			mes "[奇利亚斯·泰尤斯爵士]";
			mes "没有用。野兽太强，祖父被击昏。";
			mes "醒来时，朋友们都死了，一颗闪亮宝石躺在血泊中。";
			mes "";
			mes "";
			mes "";
			mes "";
			next;
			mes "[奇利亚斯·泰尤斯爵士]";
			mes "祖父当天埋葬了朋友。";
			mes "他拿走宝石纪念最后一次探险，却疑惑野兽为何放过他。";
			mes "";
			mes "";
			mes "";
			mes "";
			next;
			mes "[奇利亚斯·泰尤斯爵士]";
			mes "不久他亲身体验了宝石的诅咒。";
			mes "宝石莫名吸引人，将他们心中的贪婪扭曲成疯狂……";
			mes "";
			mes "";
			mes "";
			mes "";
			next;
			mes "[奇利亚斯·泰尤斯爵士]";
			mes "祖父认为野兽放他活着，是为了让宝石流入外界，用邪恶污染世界。他必须做些什么……";
			mes "";
			mes "";
			mes "";
			mes "";
			mes "";
			next;
			mes "[奇利亚斯·泰尤斯爵士]";
			mes "然而宝石由纯粹邪恶构成，无法用人类手段摧毁。";

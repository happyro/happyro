			mes "";
			mes "";
			mes "";
			mes "";
			next;
			mes "[奇利亚斯·泰尤斯爵士]";
			mes "然而宝石的威胁仍然存在。祖父和父亲多年寻找封印其黑暗的方法。";
			mes "直到现在我才制作出能封印邪恶力量的手镯。";
			mes "";
			mes "";
			next;
			mes "[奇利亚斯·泰尤斯爵士]";
			mes "为了让祖父和朋友真正安息，";
			mes "我必须找到心地纯洁的冒险者，找到宝石并带给我，最终封印其力量。";
			mes "";
			mes "";
			mes "";
			mes "";
			next;
			mes "[奇利亚斯·泰尤斯爵士]";
			mes "我想……你可能就是我一直等待的英雄。";
			mes "为了正义，你愿意帮助一个老人吗？";
			mes "";
			mes "";
			mes "";
			next;
			if (select("Of course, I will.:I'm sorry, but I can't.") == 1) {
				mes "[奇利亚斯·泰尤斯爵士]";
				mes "很好，很好，不过先要测试你是否有资格持有地狱之眼的宝石。";
				mes "我不能告诉你它在哪里，但会给你一些线索。";
				mes "";
				mes "";
				mes "";
				mes "";
				next;
				mes "[奇利亚斯·泰尤斯爵士]";
				mes "首先去普隆德拉找克兰努克斯·赫弗隆。";
				mes "他提出帮我寻找宝石，但我不知道能否信任他。请帮我保护世界免受宝石侵害……";
				mes "";
				mes "";
				mes "";
				set HELLIONQ,36;

hu_fild01,140,163,5	script	Tower Keeper	852,3,3,{
	mes "[盖泰]";
	mes "你好，冒险家。";
	mes "我是盖泰·克努姆，";
	mes "这座塔纳托斯塔的守卫。";
	mes "我能为你做什么？";
	next;
		switch(select("塔纳托斯塔？:入场费？:进入高塔:取消")) {
	case 1:
		mes "[盖泰]";
		mes "是的，你面前的塔";
		mes "曾是一座古代遗迹";
		mes "它因一个词而得名";
		mes "写在塔内发现的";
		mes "石板上。如今这里是";
		mes "热门旅游景点。";
		next;
		mes "[盖泰]";
		mes "这座塔在冒险家中越来越受欢迎，";
		mes "因为雷根贝勒公司开始重建高塔。";
		mes "第 1、2 层现在已经修复，";
		mes "也没有怪物了。";
		next;
		mes "[盖泰]";
		mes "不过，第 3 层及以上楼层的重建还未完成。";
		mes "那些楼层仍有怪物出没，";
		mes "所以我们正在雇佣临时工将它们全部消灭。";
		mes "欢迎有兴趣的人加入。";
		next;
		mes "[盖泰]";
		mes "如果你对临时合同工作感兴趣，";
		mes "或想详细了解这里，";
		mes "请询问里面的导游。";
		mes "谢谢，祝你参观愉快～";
		mes "请注意安全。";
		mes "欢迎来到塔纳托斯塔。";
		close;
	case 2:
		mes "[盖泰]";
		mes "欢迎所有人参观塔纳托斯塔。";
		mes "目前只有第 1、2 层对公众开放。";
		mes "入场费是每人 5,000 Zeny。";
		mes "请提前准备。";
		mes "祝你参观愉快。";
		next;
		mes "[盖泰]";
		mes "旅游景点收取 5,000 Zeny 也许有点贵，";
		mes "但相信我，这座塔会带来独特体验。";
		mes "忠实顾客和合同工还能享受特别折扣～";
		mes "请放心参观。";
		close;
	case 3:
		mes "[盖泰]";
		mes "你想进入塔纳托斯塔吗？";
		mes "入场费为 ^FF00005,000 Zeny^000000。";
		mes "请确认。";
		next;
		switch(select("进入:下次吧。")) {
		case 1:
			if (thana_tower > 0) {
				mes "[盖泰]";
				mes "哦，"+strcharinfo(0)+"！";
				mes "欢迎回来！既然你有";
				mes "雷根贝勒临时";
				mes "工作合同，入场费";
				mes "只需 3,000 Zeny。";
				next;
				switch(select("进入:不用了，谢谢。")) {
				case 1:
					if (Zeny > 2999) {
						mes "[盖泰]";
					mes "谢谢，请继续";
					mes "努力工作。还有别忘了：";
					mes "和那些魔物战斗时，";
					mes "安全第一！";
						set Zeny, Zeny - 3000;
						close2;
						warp "tha_scene01",131,220;
						end;
					}
					mes "[盖泰]";
					mes "哦，抱歉……";
					mes "但你似乎没有足够的 Zeny。";
					mes "没关系，晚些时候再回来吧～";
					close;
				case 2:
					mes "[盖泰]";
					mes "那你一定很忙。";
					mes "不用担心，我们会一直在这里。";
					mes "再见～";
					close;
				}
			}
			if (Zeny > 4999) {
				mes "[盖泰]";
			mes "啊，我收到你的入场费了。";
			mes "非常感谢。现在，希望你在塔纳托斯塔参观愉快～";
				close2;
				set Zeny, Zeny - 5000;
				warp "tha_scene01",131,220;
				end;
			}
			mes "[盖泰]";
			mes "嗯……";
			mes "抱歉，你似乎没有足够的 Zeny 支付入场费。";
			mes "请稍后再回来……";
			mes "谢谢理解。";
			close;
		case 2:
			mes "[盖泰]";
			mes "好的。请再次来到这里，参观塔纳托斯塔。";
			mes "期待下次见到你。";
			mes "祝你顺利。";
			close;
		}
	case 4:
		mes "[盖泰]";
		mes "嗯？好的。";
		mes "如果你想参观塔纳托斯塔，";
		mes "请随时来问我。";
		mes "谢谢，祝你今天愉快。";
		mes "欢迎再次光临。";
		close;
	}

OnTouch_:
	mes "[高塔守卫]";
	mes "抱歉，你不能进入。这里由雷根贝勒公司管理，";
	mes "没有授权的人禁止进入该区域。";
	mes "请出示许可。";
	mes "否则请离开。";
	mes "这里属于限制区域。";
	close;
}

tha_t01,149,78,4	script	Guide	90,{
	if (thana_tower == 0) {
		mes "[Ditze]";
		mes "欢迎来到塔纳托斯塔。";
		mes "高塔重建是雷根贝勒公司的项目，";
		mes "第 1、2 层现在已经对公众开放。";
		mes "今天我能为你做什么？";
		next;
		switch(select("高塔信息:临时工作合同:取消")) {
		case 1:
			mes "[Ditze]";
			mes "这座塔何时建造、由谁建造以及用途，";
			mes "全都是谜。有人传言它是魔法师实验室、";
			mes "英雄纪念碑，或者恶魔堡垒……";
			mes "至今没有定论。";
			next;
			mes "[Ditze]";
			mes "雷根贝勒公司一直在研究这座塔的起源，";
			mes "但还没有确认任何结论。";
			mes "虽然许多研究员死于塔内怪物，";
			mes "我们也不会放弃！";
			next;
			mes "[Ditze]";
			mes "雷根贝勒相信这座塔隐藏着许多秘密，";
			mes "为了追寻这些知识，";
			mes "已经成功重建了高塔的前两层。";
			mes "研究仍在继续。";
			mes "请期待后续进展。";
			next;
			mes "[Ditze]";
			mes "目前，我们专注于重建高塔的第 3、4 层。";
			mes "幸运的是，许多冒险者正在临时合同下";
			mes "消灭那些楼层的怪物。";
			mes "这大大加快了进度。";
			mes "请继续协助我们。";
			next;
			mes "[Ditze]";
			mes "按照这个速度，我们预计很快就能完成";
			mes "第 3、4 层的重建，";
			mes "距离开放塔纳托斯塔全部 12 层的目标";
			mes "也更近一步。";
			mes "这是公司的重要目标。";
			next;
			switch(select("高塔怪物？:临时合同工作？:……")) {
			case 1:
				mes "[Ditze]";
				mes "是的，当我们开始重建塔纳托斯塔时，";
				mes "这些看起来像天使的怪物";
				mes "突然凭空出现，攻击所有工人。";
				mes "情况非常危险。";
				mes "我们必须做好防护。";
				mes "请小心行动。";
				next;
				mes "[Ditze]";
				mes "起初，目击者以为这些怪物可能是真正的天使。";
				mes "但如果是天使，为什么会无缘无故攻击人？";
				mes "所以我们继续调查。";
				mes "不能轻易下结论。";
				next;
				mes "[Ditze]";
				mes "总之，我们请朱诺贤者学院调查，";
				mes "他们确认这些天使般的生物确实是怪物，";
				mes "它们与天使相似只是巧合。";
				mes "请不要被外表欺骗。";
				mes "它们仍然非常危险。";
				close;
			case 2:
				mes "[Ditze]";
				mes "你可能已经听高塔守卫说过，";
				mes "我们正在以临时雇员的形式雇佣冒险者，";
				mes "消灭第 3 层及以上楼层的高塔怪物。";
				mes "欢迎报名。";
				mes "请先了解合同条件。";
				next;
				mes "[Ditze]";
				mes "我负责招聘临时合同工，";
				mes "有兴趣的话请和我谈。";
				mes "只有临时工可以进入";
				mes "塔纳托斯塔的高层。";
				mes "请不要擅自进入。";
				next;
				goto L_Contract;
			case 3:
				mes "[Ditze]";
			mes "为了开发第 2 层以上的楼层，";
			mes "我们需要尽可能多地招聘临时合同工。";
			mes "你要不要考虑和我们签订临时合同？";
			mes "这是一份不错的工作。";
			mes "请认真考虑。";
			mes "我会等待你的答复。";
				close;
			}
		case 2:
			mes "[Ditze]";
			mes "你可能已经听高塔守卫说过，";
			mes "我们正在以临时雇员的形式雇佣冒险者，";
			mes "消灭第 3 层及以上楼层的高塔怪物。";
			mes "欢迎报名。";
			mes "请先了解合同条件。";
			next;
			mes "[Ditze]";
			mes "我负责招聘临时合同工，";
			mes "有兴趣的话请和我谈。";
			mes "只有临时工可以进入";
			mes "塔纳托斯塔的高层。";
			mes "请不要擅自进入。";
			next;
			goto L_Contract;
		case 3:
			mes "[Ditze]";
			mes "如果你有任何问题，";
			mes "以后随时可以问我。";
			mes "我叫迪策·拉帕。祝你今天愉快！";
			mes "欢迎再次光临。";
			close;
		}
	}
	mes "[Ditze]";
	mes "如需更多关于消灭怪物的信息，";
	mes "请询问 2 楼导游和我旁边的导游。";
	mes "希望你享受与雷根贝勒公司合作的经历～";
	mes "祝你工作顺利。";
	mes "请注意安全。";
	close;

L_Contract:
	switch(select("下次吧:好的，我想为你工作。")) {
	case 1:
		mes "[Ditze]";
		mes "好吧。";
		mes "当你决定通过为雷根贝勒工作";
		mes "帮助重建高塔时，";
		mes "请马上来找我。";
		mes "我会等待你的决定。";
		mes "祝你考虑顺利。";
		close;
	case 2:
		mes "[Ditze]";
		mes "太好了！";
		mes "请先填写这份雇佣协议。";
		mes "让我看看，你的名字是……";
		mes strcharinfo(0) + "，对吗？";
		next;
		select("是");
		mes "[Ditze]";
		mes "好，请仔细阅读这份协议。";
		mes "如果你同意全部条件，";
		mes "就在底部签名。";
		next;
		mes "^3355FF迪策把雇佣协议文件";
		mes "交给你阅读。^000000";
		next;
		mes "- 雇佣协议 -";
		mes " ";
		mes "1. 本雇佣协议由雷根贝勒公司（‘雇主’）与"+strcharinfo(0)+"（‘雇员’）签订。";
		mes "1-1. 本协议属于双方之间的";
		mes "佣兵合同。";
		mes "2. 本合同条款在双方（雇主和雇员）签字后立即生效。";
		mes "3. 雇员执行任务时，任务结果必须以可接受的实体证据核验，";
		mes "并提交给雇主。";
		mes "3-1. 可接受的怪物消灭证明示例，";
		mes "请参阅第 7A 节。";
		mes "3-2. 可接受的证明由雇主代表";
		mes "负责认定和定义。";
		mes "4. 雇主收到消灭证明后，将向雇员发放奖励。";
		mes "4-1. 消灭怪物的奖励可能包括以下内容。";
		mes ".................................................";
		mes ".................................................";
		mes ".................................................";
		mes ".................................................";
		mes ".................................................";
		mes "13. 本合同条款仅适用于塔纳托斯塔。";
		mes "14. 雇员可享受塔纳托斯塔入场费折扣。";
		mes " ";
		mes " ";
		mes " ";
		mes "雇主签名____________";
		mes "雇员签名____________";
		next;
		switch(select("签署:不签署")) {
		case 1:
			mes "^3355FF你签署了两份雇佣协议。^000000";
			next;
			mes "[Ditze]";
			mes "谢谢。现在你是雷根贝勒公司的正式雇员了！";
			mes "不过只限于这座塔。";
			mes "本合同不适用于这里之外的地方。";
			mes "请牢记合同范围。";
			mes "欢迎加入。";
			mes "祝你工作顺利。";
			next;
			mes "[Ditze]";
			mes "从现在起，你可以和 2 楼导游交谈，进入第 3 层。";
			mes "如果有任务奖励方面的问题，";
			mes "请询问 ^3355FFLiei^000000。";
			mes "他会帮助你。";
			mes "请不要忘记。";
			next;
			mes "[Ditze]";
			mes "如果想查看工作详情，";
			mes "请和 2 楼导游交谈。";
			mes "谢谢，欢迎加入雷根贝勒公司～";
			mes "祝你好运。";
			mes "请安全工作。";
			mes "再见。";
			set thana_tower, 1;
			close;
		case 2:
			mes "[Ditze]";
		mes "哦？合同里有你不同意的条款吗？";
		mes "嗯，没关系。改变主意后，";
		mes "随时回来找我。谢谢～";
		mes "请仔细考虑。";
		mes "我们期待你的加入。";
		mes "再见。";
			close;
		}
	}
}

tha_t01,140,78,4	script	Guide#reward	831,{
	mes "[Liei]";
	if (thana_tower == 0) {
		mes "你好，我是";
		mes "塔纳托斯塔的";
		mes "雇员任务";
		mes "奖励部门的";
		mes "Liei Kuniziet。";
		next;
		switch(select("雇员任务奖励？:继续努力工作。")) {
		case 1:
			mes "[Liei]";
			mes "目前雷根贝勒公司正在招聘临时雇员，";
			mes "开发塔纳托斯塔的高层。";
			mes "如果你想申请，请询问我旁边的迪策。";
			mes "他会为你说明条件。";
			mes "欢迎加入。";
			mes "祝你顺利。";
			close;
		case 2:
			mes "[Liei]";
			mes "谢谢。啊，希望你在塔纳托斯塔参观愉快。";
			mes "请注意安全。";
			mes "欢迎再次光临。";
			close;
		}
	}
	mes "啊，你好～";
	mes "我能为你做什么？";
	next;
	if(select("奖励:没什么") == 2) {
		mes "[Liei]";
		mes "好的。";
		mes "请尽力消灭";
		mes "盘踞在塔纳托斯塔";
		mes "高层的怪物～";
		mes "祝你顺利。";
		mes "请注意安全。";
		close;
	}
	mes "[Liei]";
	mes "你是"+strcharinfo(0)+"，对吗？";
	mes "让我查看临时雇员记录……啊。";
	mes "找到了。好，请告诉我你带来了哪种任务证明？";
	next;
	setarray .@Items[1],7435,7440,7441,7442;
	set .@i, select("黄金装饰:红羽毛:蓝羽毛:诅咒印记");
	mes "[Liei]";
	if (!countitem(.@Items[.@i])) {
		mes "抱歉，但你还没有";
		mes "携带任何"+callfunc("F_GetPlural",getitemname(.@Items[.@i]))+"。";
		mes "请再检查一次背包，";
		mes "之后再来找我兑换奖励，好吗？";
		close;
	}
	mes "每件物品的奖励是……";
	mes getitemname(.@Items[.@i])+"：";
	mes " ";
	mes "1,000 Zeny";
	//mes "2,000 EXP";
	next;
	set .@zeny_tt,(countitem(.@Items[.@i]) * 1000);
	//set .@exp_tt,(countitem(.@Items[.@i]) * 2000);
	mes "[Liei]";
	mes callfunc("F_InsertPlural",countitem(.@Items[.@i]),getitemname(.@Items[.@i]))+"，那么";
	mes "你将获得总计……";
	mes " ";
	mes ""+.@zeny_tt+" Zeny";
	//mes ""+.@exp_tt+" EXP";
	next;
	mes "[Liei]";
	mes "你现在要将全部"+callfunc("F_GetPlural",getitemname(.@Items[.@i]));
	mes "兑换成奖励吗？";
	next;
	switch(select("是:否")) {
		case 1:
			mes "[Liei]";
			mes "很好！这是你的";
			mes .@zeny_tt+" Zeny。谢谢你，";
			//mes .@exp_tt+" EXP. Thank you,";
		mes "请继续努力工作～";
		mes "";
		mes "";
		mes "";
		mes "";
		mes "";
		mes "";
		mes "";
		mes "";
	// 行数占位：保持与官方源文件物理行数一致
	// 行数占位：保持与官方源文件物理行数一致
		mes "";
		mes "";
		mes "";
		mes "";
		mes "";
		mes "";
		mes "";
		mes "";
		mes "";
		mes "";
		mes "";
		mes "";

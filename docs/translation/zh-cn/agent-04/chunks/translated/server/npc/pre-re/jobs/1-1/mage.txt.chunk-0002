		next;
		mes "[魔法师测试溶液 2 号]";
		mes "* 魔力序列码 *";
		mes "3735";
		next;
		mes "[魔法师测试溶液 2 号]";
		mes "* 催化剂 *";
		mes "红色宝石";
		mes "（由";

			}
			else {
				mes "[混合机器]";
				mes "序列号是 #" + .@input + ", ，对吗？";
				next;
				if (select("确认。:取消。") == 1) {
					if (.@input == 8472)
						set .@magic_powder,1;
					else if (.@input == 3735)
						set .@magic_powder,2;
					else if (.@input == 2750)
						set .@magic_powder,3;
					else if (.@input == 5429)
						set .@magic_powder,4;
					else
						set .@magic_powder,5;
				}
				break;
			}
		}
		mes "[混合机器]";
		mes "选择一块";
		mes "催化剂宝石。";
		next;
		switch(select("黄色宝石:红色宝石:蓝色宝石:1 克拉钻石:跳过")) {
		case 1: set .@mixitem3,1; break;
		case 2: set .@mixitem3,2; break;
		case 3: set .@mixitem3,3; break;
		case 4: set .@mixitem3,4; break;
		case 5: break;
		}
		mes "[混合机器]";
		mes "准备完成。";
		mes "正在启动";
		mes "混合过程。";
		mes "请稍候。";
		next;
		mes "[混合机器]";
		mes "- 今日谚语 -";
		switch(rand(1,5)) {
		case 1:
			mes "以眼还眼：从他人那里取走东西时，必须以某种方式归还或补偿。";
			break;
		case 2:
			mes "信誉是男人的货币：真诚的信任具有无法衡量的价值。";
			break;
		case 3:
			mes "善有善报：最终别人会以你对待他们的方式对待你。";
			mes "意思是“伤害他人时，你也会在无法避免的情况下受到他的伤害”。";
			break;
		case 4:
			mes "远亲不如近邻：需要帮助时，可以依靠身边的人。";
			break;
		default:
			mes "物以类聚：可以通过一个人的朋友判断他的品格。";
		}
		next;
		if (.@mixitem1_1 == 2 && .@mixitem1_2 == 3 && .@mixitem1_3 == 1 && .@mixitem2 == 1 && .@mixitem3 == 1 && .@magic_powder == 1) {
			mes "[混合机器]";
			mes "魔法师测试溶液 1 号。";
			getitem 1071,1; //Mage_Test_1
			next;
		}
		else if (.@mixitem1_1 == 3 && .@mixitem1_2 == 1 && .@mixitem1_3 == 1 && .@mixitem2 == 0 && .@mixitem3 == 2 && .@magic_powder == 2) {
			mes "[混合机器]";
			mes "魔法师测试溶液 2 号。";
			getitem 1085,1; //Mage_Test_2
			next;
		}
		else if (.@mixitem1_1 == 6 && .@mixitem1_2 == 1 && .@mixitem1_3 == 0 && .@mixitem2 == 1 && .@mixitem3 == 3 && .@magic_powder == 3) {
			mes "[混合机器]";
			mes "魔法师测试溶液 3 号。";
			getitem 1086,1; //Mage_Test_3
			next;
		}
		else if (.@mixitem1_1 == 2 && .@mixitem1_2 == 3 && .@mixitem1_3 == 0 && .@mixitem2 == 2 && .@mixitem3 == 4 && .@magic_powder == 4) {
			mes "[混合机器]";
			mes "魔法师测试溶液 4 号。";
			getitem 1087,1; //Mage_Test_4
			next;
		}
		else {
			mes "[混合机器]";
			mes "意外";
			mes "发生错误。";
			getitem 1090,1; //Mage_Test_Etc
			next;
		}
		mes "[混合机器]";
		mes "混合完成。";
		mes "谢谢。";
		close;
	}
	close;
}

// The 梦罗克溶液 and 斐扬溶液 traders
// are also used in the Sage skill quests, and have
// been moved to npc/quests/mage_solution.txt.
//
// pay_arche,122,100,0	script	Dollshoi	88,{}
// moc_ruins,91,150,0	script	Ponka-Hontas	93,{}

geffen_in,177,112,4	script	Bookshelf	111,{
	mes "[指南书]";
	mes "本指南书属于吉芬魔法师协会，请小心保管。";
	next;
	switch(select("溶液 1 号:溶液 2 号:溶液 3 号:溶液 4 号:关闭")) {
	case 1:

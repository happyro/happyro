// Room 16
1@jtb,25,280,5	script	Newoz#16	4_M_NEWOZ,{
	if ('room != 16 || is_party_leader() == false) {
		cutin "nines01",0;
		mes "[纽奥兹]";
		mes "等等，我收集了一些秋叶和蓝色卡片，想送给其他朋友作纪念。它们在哪里？";
		close3;
	}
	if (select( "交谈。", "快点。" ) == 2 && isbegin_quest(13183) == 2)
		mes "一边赶路，一边试着回忆起来。";
	else {
		.@mingmin$ = instance_npcname("Mingmin#16");
		.@roter$ = instance_npcname("Roter#16");

		cutin "nines02",0;
		emotion ET_DELIGHT;
		mes "[纽奥兹]";
		mes "和你们两个在一起，让我想起了许多往事。";
		npctalk "Newoz：和你们两个在一起，让我想起了许多往事。";
		next;
		cutin "rote01",2;
		mes "[Roter]";
		mes "我那时倔得像头骡子，还忙着装作自己什么都懂。";
		npctalk "Roter：我那时倔得像头骡子，还忙着装作自己什么都懂。", .@roter$;
		next;
		cutin "min01",0;
		emotion ET_QUESTION, getnpcid(0,.@mingmin$);
		mes "[Mingmin]";
		mes "还记得你们两个为了普隆德拉南门的花店女孩争吵吗？或者你们在东门争执、赶走客人，被玩偶商人教训的事？";
		npctalk "Mingmin：还记得你们两个为了普隆德拉南门的花店女孩争吵吗？或者你们在东门争执、赶走客人，被玩偶商人教训的事？", .@mingmin$;
		next;
		cutin "rote01",2;
		mes "[Roter]";
		mes "你难道没有关于我们的美好回忆吗？";
		npctalk "Roter：你难道没有关于我们的美好回忆吗？", .@roter$;
		next;
		cutin "nines03",0;
		emotion ET_DELIGHT;
		mes "[纽奥兹]";
		mes "哦，我想起来了！那段时光真美好！";
		npctalk "Newoz：哦，我想起来了！那段时光真美好！";
		next;
		cutin "rote01",0;
		emotion ET_THINK, getnpcid(0,.@roter$);
		mes "[Roter]";
		mes "只有我不喜欢这个话题吗？";
		npctalk "Roter：只有我不喜欢这个话题吗？", .@roter$;
		next;
		cutin "min03",2;
		emotion ET_MERONG, getnpcid(0,.@mingmin$);
		mes "[Mingmin]";
		mes "你们玩死树枝玩到送命的事呢？或者你和贤者朋友玩戏法时把自己弄死的事？";
		npctalk "Mingmin：你们玩死树枝玩到送命的事呢？或者你和贤者朋友玩戏法时把自己弄死的事？", .@mingmin$;
		next;
		cutin "rote01",0;
		emotion ET_OHNO, getnpcid(0,.@roter$);
		mes "[Roter]";
		mes "你就想不到什么美好的回忆吗？";
		npctalk "Roter：你就想不到什么美好的回忆吗？", .@roter$;
		next;
		cutin "nines02",2;
		emotion ET_OK;
		mes "[纽奥兹]";
		mes "我有！Mingmin 喝了我在街上捡到的毒药瓶，然后死了；我告诉过你那很贵，可没说它对健康有益。";
		npctalk "Newoz：我有！Mingmin 喝了我在街上捡到的毒药瓶，然后死了；我告诉过你那很贵，可没说它对健康有益。";
		next;
		cutin "min03",0;
		emotion ET_SMILE, getnpcid(0,.@mingmin$);
		mes "[Mingmin]";
		mes "哦，我想起来了！那真有趣！";
		npctalk "Mingmin：哦，我想起来了！那真有趣！", .@mingmin$;
		next;
		emotion ET_KEK, getnpcid(0,.@roter$);
		cutin "rote01",2;
		mes "[Roter]";
		mes "啊！";
		npctalk "Roter：啊！", .@roter$;
	}
	if ('room == 16 && is_party_leader() == true)
		donpcevent 'jitterbug_main$ + "::OnNextIs17";
	close3;
}

1@jtb,30,279,4	script	Mingmin#16	4_F_GENETIC,{
	cutin "min02",0;
	mes "[Mingmin]";
	mes "啧啧。我几乎把这里所有人都养大了，现在他们却为了公会会长的位置争得不可开交。";
	close3;
}


// Room 15
1@jtb,380,219,5	script	Newoz#15	4_M_NEWOZ,{
	if (is_party_leader() == false) {
		cutin "nines02",0;
		mes "[纽奥兹]";
		mes "我想念那种牛肉与橡果的美味组合——彩虹桥烤牛肉。";
		close3;
	}
	if ('room != 15) {
		cutin "nines02",0;
		mes "[纽奥兹]";
		mes "别担心。孩子们会在战斗中成长。";
		close3;
	}
	if (select( "交谈。", "快点。" ) == 2 && isbegin_quest(13183) == 2)
		mes "一边赶路，一边试着回忆起来。";
	else {
		.@roel$ = instance_npcname("Roel#15");
		.@runane$ = instance_npcname("Runane#15");
		.@shaloshi$ = instance_npcname("Shaloshi#15");
		.@roter$ = instance_npcname("Roter#15");
		.@gelka$ = instance_npcname("Gelka#15");
		.@mingmin$ = instance_npcname("Mingmin#15");
		.@arang$ = instance_npcname("Arang#15");

		cutin "nines01",0;
		mes "[纽奥兹]";
		mes "阿朗！Shaloshi！";
		npctalk "Newoz：阿朗！Shaloshi！";
		next;
		cutin "arang01",2;
		mes "[Arang]";
		mes "什么？";
		npctalk "Arang: 什么？", .@arang$;
		next;
		cutin "nines01",0;
		mes "[纽奥兹]";
		mes "你不是遇到危险了吗？";
		npctalk "Newoz: 你不是遇到危险了吗？";
		next;
		cutin "arang02",2;
		mes "[Arang]";
		mes "你去哪了？刚才这里有个厉害的怪物！";
		npctalk "Arang: 你去哪了？刚才这里有个厉害的怪物！", .@arang$;
		next;
		cutin "nines02",0;
		mes "[纽奥兹]";
		mes "嘿，我的直觉告诉我前方有危险，要放慢脚步。";
		npctalk "Newoz: 嘿，我的直觉告诉我前方有危险，要放慢脚步。";
		next;
		cutin "gelca01",0;
		mes "[Gelka]";
		mes "哦，伟大冒险者的直觉！";
		npctalk "Gelka: 哦，伟大冒险者的直觉！", .@gelka$;
		next;
		cutin "arang01",2;
		mes "[Arang]";
		mes "不，他的冒险者直觉已经生锈了。";
		npctalk "Arang: 不，他的冒险者直觉已经生锈了。", .@arang$;
		next;
		cutin "rote01",0;
		mes "[Roter]";
		mes "他只是懒。他没那么弱。";
		npctalk "Roter: 他只是懒。他没那么弱。", .@roter$;
		next;
		cutin "shaloshi01",2;
		mes "[Shaloshi]";
		mes "我的直觉告诉我 Newoz 不强。";
		npctalk "Shaloshi: 我的直觉告诉我 Newoz 不强。", .@shaloshi$;
		next;
		mes "[Shaloshi]";
		mes "Newoz，你刚才是不是觉得除了 Rot 之外的所有人都很平庸？";
		npctalk "Shaloshi：Newoz，你刚才是不是觉得除了 Rot 之外的所有人都很平庸？", .@shaloshi$;
		next;
		cutin "min02",2;
		mes "[Mingmin]";
		mes "你能说话，还能听到别人的想法。太棒了。";
		npctalk "Mingmin: 你能说话，还能听到别人的想法。太棒了。", .@mingmin$;
		next;
		cutin "lunain04",2;
		mes "[Runane]";
		mes "够了！别再对 Newoz 无礼！";
		npctalk "Runane: 够了！别再对 Newoz 无礼！", .@runane$;
		next;
		cutin "roel01",0;
		mes "[Roel]";
		mes "伙伴之间不该互相争斗。";
		npctalk "Roel: 伙伴之间不该互相争斗。", .@roel$;
		next;
		cutin "shaloshi01",2;
		mes "[Shaloshi]";
		mes "伙伴之间不该互相争斗。明白了。";
		npctalk "Shaloshi：伙伴之间不该互相争斗。明白了。", .@shaloshi$;
		next;
		cutin "lunain03",2;
		mes "[Runane]";
		mes "伙伴？谁和谁是伙伴？我们只是一群执意要救出迷路女孩的陌生人！";
		npctalk "Runane：伙伴？谁和谁是伙伴？我们只是一群执意要救出迷路女孩的陌生人！", .@runane$;
		next;
		cutin "roel03",0;
		mes "[Roel]";
		mes "（她生气时真迷人！）";
		npctalk "Roel：（她生气时真迷人！）", .@roel$;
		next;
		emotion ET_FRET, getnpcid(0,.@mingmin$);
		cutin "min02",0;
		mes "[Mingmin]";
		mes "一离开这里，我们就再聊。";
		npctalk "Mingmin：一离开这里，我们就再聊。", .@mingmin$;
	}
	if ('room == 15 && is_party_leader() == true)
		donpcevent 'jitterbug_main$ + "::OnNextIs16";
	close3;
}


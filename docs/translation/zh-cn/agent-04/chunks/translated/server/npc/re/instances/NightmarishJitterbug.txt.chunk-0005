	close3;
}


// Room 17 (menu affects the boss encounter in the next room)
1@jtb,110,281,5	script	Shaloshi#17	4_F_SHALOSH,{
	if ('room != 17 || is_party_leader() == false) {
		cutin "shaloshi01",2;
		mes "[Shaloshi]";
		mes "朋友……竞争……伙伴……";
		close3;
	}
	if (select( "交谈。", "快点。" ) == 2 && isbegin_quest(13183) == 2) {
		mes "一边赶路，一边试着回忆起来。";
		if ('room == 17 && is_party_leader() == true) {
			donpcevent 'jitterbug_main$ + "::OnNextIs18";
			if (jitterbug_options & 4)
				areamonster 'map_jtb$,183,301,220,272, "--ja--", 3108,1;	// no label
		}
		close3;
	}
	.@runane$ = instance_npcname("Runane#17");
	.@aigu$ = instance_npcname("Aigu#17");

	cutin "lunain02",2;
	mes "[Runane]";
	mes "也许 Newoz 对约会没兴趣。";
	npctalk "Runane：也许 Newoz 对约会没兴趣。", .@runane$;
	next;
	cutin "igu05",0;
	mes "[Aigu]";
	mes "告诉我点我不知道的事。";
	npctalk "Aigu：告诉我点我不知道的事。", .@aigu$;
	next;
	cutin "lunain01",2;
	mes "[Runane]";
	mes "但你根本没试过和他说话。我的意思是，你真的试过吗？";
	npctalk "Runane：但你根本没试过和他说话。我的意思是，你真的试过吗？", .@runane$;
	next;
	cutin "igu04",0;
	mes "[Aigu]";
	mes "你今天才见到他，但只要不傻就应该知道。";
	npctalk "Aigu：你今天才见到他，但只要不傻就应该知道。", .@aigu$;
	next;
	cutin "lunain02",2;
	mes "[Runane]";
	mes "我知道——如果约他，他肯定会拒绝。";
	npctalk "Runane：我知道——如果约他，他肯定会拒绝。", .@runane$;
	next;
	cutin "igu05",0;
	mes "[Aigu]";
	mes "那个笨蛋只对冒险感兴趣。";
	npctalk "Aigu：那个笨蛋只对冒险感兴趣。", .@aigu$;
	next;
	cutin "lunain04",2;
	mes "[Runane]";
	mes "别那样称呼我的英雄！……不过我同意你的说法。";
	npctalk "Runane：别那样称呼我的英雄！……不过我同意你的说法。", .@runane$;
	next;
	cutin "igu03",0;
	mes "[Aigu]";
	mes "你似乎很喜欢 Roel。";
	npctalk "Aigu：你似乎很喜欢 Roel。", .@aigu$;
	next;

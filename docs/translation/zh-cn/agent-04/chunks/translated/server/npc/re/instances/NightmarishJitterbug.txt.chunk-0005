	emotion ET_DELIGHT;
	mes "[纽奥兹]";
	mes "对，她就是这么说的。";
	npctalk "Newoz: 对，她就是这么说的。";
	next;
	cutin "ragi01",2;
	emotion ET_SURPRISE;
	emotion ET_SURPRISE, getnpcid(0,.@lagi$);
	mes "[拉吉与纽奥兹]";
	mes "!!!";
	npctalk "Newoz: !!!";
	npctalk "Lagi: !!!", .@lagi$;
	next;
	cutin "nines01",0;
	mes "[拉吉与纽奥兹]";
	mes "击掌！";
	npctalk "Newoz: 击掌！";
	npctalk "Lagi: 击掌！", .@lagi$;
	next;
	cutin "",255;
	mes "- *啪* -";
	next;
	emotion ET_KEK;
	emotion ET_KEK, getnpcid(0,.@lagi$);
	emotion ET_HNG, getnpcid(0,.@aigu$);
	emotion ET_HNG, getnpcid(0,.@mingmin$);
	specialeffect EF_HIT5;
	specialeffect EF_HIT5,AREA, .@lagi$;
	mes "- 两人准备击掌时，Aigu 和 Mingmin 拍了拍他们的背。 -";
	next;
	cutin "igu03",2;
	mes "[Aigu]";
	mes "别胡闹了。Shaloshi，和我们说说。";
	npctalk "Aigu: 别胡闹了。Shaloshi，和我们说说。", .@aigu$;
	next;
	cutin "shaloshi01",0;
	mes "[Shaloshi]";
	mes "在漆黑中，我听到一个声音。声音很低，却回荡了很久。";
	npctalk "Shaloshi: 在漆黑中，我听到一个声音。声音很低，却回荡了很久。", .@shaloshi$;
	next;
	mes "[Shaloshi]";
	mes "后来我听到 Newoz 等朋友时唱歌。他的声音温暖了我。";
	npctalk "Shaloshi: 后来我听到 Newoz 等朋友时唱歌。他的声音温暖了我。", .@shaloshi$;
	next;
	cutin "min02",0;
	mes "[Mingmin]";
	mes "你现在说话像大人一样，流畅又清晰。";
	npctalk "Mingmin: 你现在说话像大人一样，流畅又清晰。", .@mingmin$;
	next;
	cutin "roel01",2;
	mes "[Roel]";
	mes "她可能吓坏了。";
	npctalk "Roel: 她可能吓坏了。", .@roel$;
	next;
	cutin "shaloshi01",0;
	mes "[Shaloshi]";
	mes "我不知道朋友是什么意思，但听起来很好。我想要朋友。";
	npctalk "Shaloshi: 我不知道朋友是什么意思，但听起来很好。我想要朋友。", .@shaloshi$;
	next;
	mes "[Shaloshi]";
	mes "Aigu 和 Runane 出现了。";
	npctalk "Shaloshi: Aigu 和 Runane 出现了。", .@shaloshi$;
	next;
	mes "[Shaloshi]";
	mes "我以为有人实现了我的愿望。";
	npctalk "Shaloshi: 我以为有人实现了我的愿望。", .@shaloshi$;
	next;
	cutin "nines01",0;
	emotion ET_QUESTION;
	mes "[纽奥兹]";
	mes "漆黑……你不记得其他事了吗？";
	npctalk "Newoz: 漆黑……你不记得其他事了吗？";
	next;
	cutin "shaloshi01",0;
	mes "[Shaloshi]";
	mes "不。";
	npctalk "Shaloshi：不。", .@shaloshi$;
	next;
	cutin "roel01",2;
	mes "[Roel]";
	mes "她可能闭着眼睛。也许她睡着了。";
	npctalk "Roel: 她可能闭着眼睛。也许她睡着了。", .@roel$;
	next;
	cutin "nines01",0;
	mes "[纽奥兹]";
	mes "漆黑……洞穴里除了雾气外一直很明亮。";
	npctalk "Newoz: 漆黑……洞穴里除了雾气外一直很明亮。";
	next;
	if ('room == 14 && is_party_leader() == true)
		donpcevent 'jitterbug_main$ + "::OnNextIs15";
	cutin "min02",0;
	mes "[Mingmin]";
	mes "一个梦。梦里的低沉声音。什么样的梦？";
	npctalk "Mingmin: 一个梦。梦里的低沉声音。什么样的梦？", .@mingmin$;
	next;
	if (select( "She heard her own thoughts.", "She was talking with someone." ) == 1) {
		jitterbug_options &= ~2;
		unittalk getcharid(3), "" + strcharinfo(0) + " : Maybe she heard her own thoughts.";
	}
	else {
		jitterbug_options |= 2;
		areamonster 'map_jtb$,358,212,388,182, "--ja--", 3108,1;	// no label
		unittalk getcharid(3), "" + strcharinfo(0) + " : Maybe she was talking with someone.";
	}
	cutin "shaloshi01",0;
	mes "[Shaloshi]";
	mes "...";
	npctalk "Shaloshi: ... ", .@shaloshi$;
	next;
	cutin "igu04",0;
	mes "[Aigu]";
	mes "她可能还没全部想起来，但这是进步。等她准备好再继续说吧。";
	npctalk "Aigu: 她可能还没全部想起来，但这是进步。等她准备好再继续说吧。", .@aigu$;
	next;
	cutin "nines01",0;
	mes "[纽奥兹]";
	mes "在我唱歌前还有一个声音。这里可能还有别人。";
	npctalk "Newoz: 在我唱歌前还有一个声音。这里可能还有别人。";
	next;
	cutin "min02",0;
	mes "[Mingmin]";
	mes "很快就会知道。";
	npctalk "Mingmin: 很快就会知道。", .@mingmin$;
	close3;
}


	einbech,172,113,4	script	Nemuk#ein	855,{
	switch(select("It's fine.:It looks tough to live here.")) {
	case 1:
		mes "[尼穆克]";
		mes "你看起来是";
		mes "外乡人，让我";
		mes "问你一件事。";
		mes "你觉得";
		mes "艾音贝赫怎么样？";
		next;
		mes "";
		mes "";
		mes "";
		mes "";
		mes "";
		switch(select("挺好的。:这里生活似乎很艰难。")) {
		mes "";
		mes "";
		mes "";
		mes "";
		mes "";
		mes "";
		case 1:
	case 2:
		mes "[尼穆克]";
		mes "嗯……？";
		mes "我不知道你";
		mes "看到了什么，但听你";
		next;
		mes "[尼穆克]";
		mes "我开始考虑搬出去";
		mes "已经十年了。不过我还在";
		mes "犹豫。如果我有钱，早就离开了，";
		mes "但攒够搬家的钱并不容易。";
		mes "";
		mes "";
		next;
		mes "[尼穆克]";
		mes "^333333*Sigh...*^000000";
		mes "也许我年轻时";
		mes "当过冒险家，";
		mes "今天就不会";
		mes "遇到这些问题了……";
		mes "";
		close;
	case 2:
}


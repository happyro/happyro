einbech,105,218,5	script	Gushenmu#ein	848,{
	mes "[Mogan]";
	mes "最近发生了几起塌方，";
	mes "许多矿工因此受伤。";
	mes "镇议会讨论过这件事，";
	mes "我认为矿工挖得";
	next;
	mes "[Mogan]";
	mes "没错，他们唤醒了昂古利安特，";
	mes "那位自古存在的";
	mes "洞窟之主。";
	mes "我不知道未来还会有多少人";
	mes "成为昂古利安特的受害者。";
	mes "谁也说不准……";
	next;
	mes "[Mogan]";
	mes "冒险者，进入矿坑时";
	mes "一定要小心，别让脚步声";
	mes "惊扰昂古利安特的沉睡。";
	mes "";
	mes "";
	close;
	mes "";
	mes "";
	mes "";
	mes "";
	mes "";
	mes "";
	mes "";
	}

einbech,129,234,5	script	Hander#ein	848,{
einbech,39,215,5	script	Train Station Staff#ein3	852,{
	mes "[Hander]";
	mes "那些艾音布罗克的混蛋！";
	mes "靠我们挖出的资源过活，";
	mes "还让我们像傻瓜一样为他们卖命！";
	mes "可恶！";
	mes "";
	mes "";
	next;
	switch(select("Yes.:No.")) {
	case 1:
		if (Zeny > 199) {
			mes "[Hander]";
			mes "我们每天都拿命";
			mes "去换口饭吃！";
			mes "长老们为什么不管管，";
			next;
			set Zeny, Zeny-200;
			warp "einbroch",226,276;
			end;
		}
		else {
			mes "[Hander]";
			mes "工作安排不合理，卡维塔的";
			mes "妻子还被矿坑魔物袭击，";
			mes "医院又离得太远，";
			mes "我们甚至没东西可吃！为什么……？！";
			close;
		}
	
		mes "";
		mes "";
		mes "";
		mes "";
		einbech,105,218,5	script	Gushenmu#ein	848,{
	}
}


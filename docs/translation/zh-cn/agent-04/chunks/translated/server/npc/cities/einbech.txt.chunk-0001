einbech,128,238,5	script	Mogan#ein	848,{
	mes "[Heinz]";
	mes "哇……";
	mes "来自卢恩-米德加尔特的";
	mes "冒险者，对吧？";
	mes "是什么风把你吹来的？";
	mes "";
	mes "";
	next;
	mes "[Heinz]";
	mes "艾音贝赫没什么";
	mes "值得观光的地方，不过";
	mes "你是来参观矿坑的吗？";
	mes "现在那里到处都是";
	mes "魔物，太危险了，";
	mes "我们根本没法挖矿。";
	next;
	mes "[Heinz]";
	mes "如果有慷慨的冒险者";
	mes "愿意消灭那些邪恶生物，";
	mes "我们就能重新采矿，他们也能赚些 Zeny。真是一举两得。哈哈哈！";
	mes "";
	next;
}


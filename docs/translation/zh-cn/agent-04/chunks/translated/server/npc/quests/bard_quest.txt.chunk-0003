	next;
	switch(select("Tell me a story.:Would you play a song?:Eh, maybe later.")) {
	case 1:
		mes "[艾伦德]";
		mes "你喜欢故事吗？想听什么故事？ 我会把知道的都告诉你……当然只为你。*咧嘴笑*";
		next;

		if(select("News and rumors~:Cancel.")==1) {
			cutin "bard_eland01",2;
			mes "[艾伦德]";
			set .@random,rand(1,3);
			if (.@random == 1) {
				mes "嗯。那我们聊聊这座城市吉芬？ 你去过这里的酒吧或旅馆吗？";
				next;
				mes "[艾伦德]";
				mes "如果我不说，酒吧和旅馆工作的姐妹们……^FF6699充满感官魅力^000000。";
				next;
				mes "[艾伦德]";
				mes "姐姐美丽优雅，带着高贵气质。 妹妹活泼有活力，而且…… ^FF6699娇艳动人^000000.";
				next;
				mes "[艾伦德]";
				mes "不过我跑题了。";
				mes "不过有时，";
				mes "只是偶尔，";
				mes "她们没平时那么迷人。";
				next;
				mes "[艾伦德]";
				mes "看来她们已故父亲的灵魂——愿神保佑他孕育了如此美丽的女儿——会不时附身。";
				next;
				cutin "bard_eland02",2;
				mes "[艾伦德]";
				mes "我猜当有人对那些女孩";
				mes "稍微调情时，她们父亲的灵魂就会接管身体。我应该知道。";
				next;
				mes "[艾伦德]";
				mes "父爱大概永恒，即使到了来世。当然，我也不确定。";
				next;
				mes "[艾伦德]";
				cutin "bard_eland01",2;
				mes "让我想想……";
				mes "留意那个常在后面徘徊的可疑商人";
				mes "他就在吉芬酒吧后面。";
				next;
				mes "[艾伦德]";
				mes "从服装看他一定来自更温暖的梦罗克。所以他戴着兜帽，尽管没有抽绳，好应对这里较凉的天气。";
				next;
				mes "[艾伦德]";
				mes "我警告你，别被他说服买下他的兜帽 他卖得贵得离谱。 他绝对不可信。";
				next;
				mes "[艾伦德]";
				mes "最后提一下隐藏在吉芬塔下的失落城市吉芬尼亚。 听说进入吉芬尼亚需要某种条件，但我不确定。";
				next;
				mes "[艾伦德]";
				mes "吉芬尼亚与我之前提到的两位美丽女士有关。听说她们的父亲威廉曾带队进入吉芬塔消灭魔物，却再也没回来。";
				next;
				mes "[艾伦德]";
				mes "他那样离开家人很悲惨。但更悲惨的是，他的灵魂会吓跑任何对女孩感兴趣的人。";

			} else if (.@random == 2) {
				mes "好，我给你讲讲沙漠城市梦罗克的故事。真正的冒险者应该探索过这座城市及周围沙漠。";
				next;
				mes "[艾伦德]";
				mes "斯芬克斯和金字塔是冒险家最喜欢探索的地方。你去过吗？我还没去过，也许哪天会去。";
				next;
				mes "[艾伦德]";
				mes "我在梦罗克时发现一名向牧师和女牧师出售剑锤的商人。除此之外，牧师禁止使用任何带刃武器。";
				next;
				mes "[艾伦德]";
				mes "我还见到一个精力充沛的小男孩，不停求父亲为他驯服一只妖道。听父亲说，他在梦罗克的一位朋友迷失在艾尔贝塔。";
				next;
				cutin "bard_eland02",2;
				mes "[艾伦德]";
				mes "总之，我帮父亲办了件事，他给我一个神秘盒子作为回报。打开后我发现一根奇怪羽毛，但不知道它有什么用……";
				next;
				mes "[艾伦德]";
				mes "不知道那人的朋友潘杰·梅耶";
				mes "是否找到了回家的路……";

			} else if (.@random == 3) {
				mes "我们聊聊艾尔贝塔吧？有一艘沉船被活动公司改造成冒险者探险的地方。他们似乎赚了很多钱。";
				next;
				mes "[艾伦德]";
				mes "沉船第一次漂到艾尔贝塔附近时，立即被一名艾尔贝塔守卫骑士发现。";
				next;
				mes "[艾伦德]";
				mes "那名骑士进入船内，在一间房深处发现一个婴儿。婴儿旁边有一个八音盒。";
				next;
				mes "[艾伦德]";
				mes "这个婴儿是沉船唯一的幸存者。他在艾尔贝塔长大，童年时却受人鄙视。现在他过得很好，不过我跑题了。";
				next;
				mes "[艾伦德]";
				mes "至于沉船，我不确定它是不是海盗船。据说穿海盗服的骷髅魔物在残骸中游荡。";
				next;
				mes "[艾伦德]";
				mes "艾尔贝塔的另一谜团是神秘的海底洞窟。据说一名航海者找到可靠路线，正在为冒险者提供通行。";
				next;
				mes "[艾伦德]";
				mes "不过海底洞窟似乎并不安全。两队艾尔贝塔守卫骑士已经前往，却还没回来。确实令人担忧。";
				next;
				mes "[艾伦德]";
				mes "但这没阻止我前往那里。我偶然发现一名曾去过那里的冒险者日记，他现在似乎已是著名学者。";
				next;
				cutin "bard_eland02",2;
				mes "[艾伦德]";
				mes "日记记载了终极剑士和海底洞窟探险的细节。我相信任何去那里寻宝的人都会经历精彩冒险。";
			}

		} else {
			cutin "bard_eland01",2;
			mes "[艾伦德]";
			mes "哦，真令人失望。不过答应我之后再来，我们可以分享故事和欢乐。";
		}
		close3;

	case 2:
		.@num = getarg(0);
		mes "[艾伦德]";
		if (.@num < 3)
		mes "你认可我的才华，所以值得听我的歌！想听什么？我什么都能演奏。";
		else
		mes "终于遇到认可我才华的人了！你值得听我的歌！想听什么？我什么都能演奏。";
		next;

		switch(select("Hmm, any song will do.:Play an upbeat song~!:Never mind...")) {

		case 1:
			mes "[艾伦德]";
			if (Zeny > 499) {
				set Zeny, Zeny-500;
				cutin "bard_eland03",2;
				mes "好。";
				mes "开始吧~";

				set .@random,rand(1,3);
				if (.@random == 1)
					soundeffect "ring_of_nibelungen.wav",0;
				else if (.@random == 2)
					soundeffect "dont_forget_me_not.wav",0;
				else
					soundeffect "in_to_the_abyss.wav",0;

			} else {
				cutin "bard_eland04",2;
			mes "啊哈哈哈~";
			mes "抱歉，";
			mes "我不能免费提供服务。诗人也需要 Zeny 才能生活，你说对吧？";
			}
			close3;

		case 2:
			cutin "bard_eland03",2;
			mes "[艾伦德]";
			mes "欢快的歌曲……？";
			mes "嗯……让我看看。";
			mes "欢快的歌曲，";
			mes "欢快的歌曲……";
			mes "好，开始吧~";
			next;
			//for 3 and 4 variants, we need higher chance
			if (.@num == 3 || .@num == 4)
				set .@random,rand(1,5);
			else
				set .@random,rand(1,3);
			if (.@random == 1) {
				mes "^483D8B瓦尔哈拉闪耀着金光";
				mes "我们所知的第五座";
				mes "是古老的古城！";
				mes "英勇战士回应";
				mes "奥丁的召唤。^000000";
				next;
				mes "^483D8B亡者的宫殿";
				mes "屋顶银光闪耀~";
				mes "我们所知的第三座……";
				mes "瓦拉斯加尔夫！";
				mes "英勇战士回应";
				mes "奥丁的召唤。^000000";
				next;
				mes "^483D8B五百四十扇门";
				mes "在瓦尔哈拉宏伟大厅中";
				mes "向英雄之心敞开。";
				mes "八百名战士聚集，";
				mes "遵循神的意志，";
				mes "如一人般冲出";
				mes "那些大门。^000000";
				next;
				mes "^483D8B神圣的战士";
				mes "踏入世界树";
				mes "走向自己的命运。";
				mes "带着骄傲与荣誉，";
				mes "接受女武神的";
				mes "欢迎。^000000";
				next;
				mes "^483D8B战场上倒下的战士";
				mes "在鲜红的荣耀冲突中";
				mes "死亡或许已经降临，";
				mes "但你的名声永存，";
				mes "你的灵魂将被";
				mes "引向瓦尔哈拉。^000000";
				//Expanded version for 2nd variant
				if (.@num == 2){
					next;
					mes "[艾伦德]";
					mes "...";
					next;
					mes "[艾伦德]";
					mes "...";
					mes "......";
					next;
					mes "[艾伦德]";
					mes "你知道这首歌讲的是瓦尔哈拉的传说吧？据说不止一个地方曾被用作神圣的荣誉殿堂。";
					next;
					mes "[艾伦德]";
					mes "但只有神知道这是否真实。古城真的是第五座瓦尔哈拉吗？我们人类";
					mes "也许永远无法";
					mes "确定。";
				}
				close3;

			} else if (.@random == 2) {

				mes "^483D8B奔腾的马蹄声";
				mes "在远方回响。";
				mes "朦胧尘雾";
				mes "填满落日。";
				mes "千万双眼睛睁开，";
				mes "城堡上的火炬";
				mes "如千万伊夫利特般燃烧。";
				next;
				mes "^483D8B听见我心脏的跳动，";
				mes "血液在血管中流淌。";
				mes "感受铠甲的沉重。";
				mes "敌人出现在我们面前。^000000";
				next;
				mes "^483D8B用力敲鼓，再用力！";
				mes "士兵们鼓起勇气，向前行军！";
				mes "士兵们大声呐喊，再大声些！";
				mes "今日一去不复返！^000000";
				next;
				mes "^483D8B震撼天空，";
				mes "挑衅大地。";
				mes "我再次感受到心跳。";
				mes "吹响号角，";
				mes "撼动堡垒。";
				mes "今日一去不复返！^000000";
				next;
				mes "[艾伦德]";
				mes "啊，这首歌叫《战场鼓声》，由伊欧洛先生创作。我很喜欢这首歌。";

			} else {
				// For 3 and 4 cases we set more chance earlier on .@random
				if (.@num == 3 || .@num == 4){
					mes "[艾伦德]";
					if (Sex == SEX_MALE)
						mes "英勇的战士，";
					else
						mes "美丽的女士，";
					mes "请听我的歌。如果手中有花且正陷入爱河，就随着歌曲数花瓣吧。";
					next;
					mes "^483D8B一，我坠入爱河。";
					mes "二，你向我展露微笑。";
					mes "三，我爱恋你的触碰。";
					mes "四，一个温柔的吻。";
					mes "五，我们改变心意。";
					mes "花瓣随风飘散。^000000";
					next;
					cutin "bard_eland04",2;
					mes "^483D8B六，我坠入爱河~";
					mes "七，你坠入爱河~";
					mes "八~^000000";
					next;
					mes "[艾伦德]";
					mes "八~";
					mes "八……";
					mes "接下来是什么……？";
					next;
					mes "[艾伦德]";
					mes "天啊……！";
					mes "下一段是什么？！";
					mes "第八次爱情是什么？！";
					mes "诗人竟然忘了歌词，";
					mes "真是太丢脸了！";
					mes "";
					next;
					mes "[艾伦德]";
					mes "我……";
					mes "我无法忍受这份羞耻！";
					mes "也无法忍受接下来会发生什么的悬念……！";
					mes "";
					next;
					mes "[艾伦德]";
					mes "你是冒险者吧？一定经常旅行？虽然有点不好意思，";
					mes "但我想请你帮个忙……！";
					next;

					if(select("Sure, no problem.:I ain't gonna help you.")==1) {
						cutin "bard_eland01",2;
						mes "[艾伦德]";
						mes "非常感谢！";
						mes "让我想想，谁会知道？";
						mes "有了！冈瑟！";
						next;
						mes "[艾伦德]";
						mes "如果你碰巧遇到^483D8B冈瑟·双重和谐^000000，请告诉他我的困境。";
						next;
						mes "[艾伦德]";
						mes "告诉他^483D8B明蒂·埃伦德^000000忘记了歌曲《^483D8B一，我坠入爱河^000000》中的一句歌词，那句叫^483D8B第八次爱情^000000。";
						next;
						mes "[艾伦德]";
						mes "拜托了，遇到他就问问第八次爱情，并立即把歌词告诉我~";
						if(gef_bard_q==1) set gef_bard_q,2;
						if(gef_bard_q==21) set gef_bard_q,22;

					} else {
						mes "[艾伦德]";
						mes "*叹气……*";
						mes "就算性命攸关我也想不起第八段。而现在确实攸关性命~！*哇啊啊~*";
						if(gef_bard_q==1) set gef_bard_q,7;
						if(gef_bard_q==21) set gef_bard_q,27;
					}
					close3;

				}
				mes "^483D8B优秀的诗人歌唱";
				mes "只为取悦听众。";
				mes "所以别期待悲伤的歌，";
				mes "让你的痛苦更深。^000000";
				next;
				mes "^483D8B优秀的舞者起舞";
				mes "只为取悦观众。";
				mes "我们一起跳舞好吗？";
				mes "";
				mes "";
			mes "只要牵着我的手。";
			mes "啦啦啦~ 啦啦啦~^000000";
				next;
				mes "[" + @name$ + "]";
			mes "顺便问问……";
			mes "你们为什么有时会";
			mes "演奏不和谐音？";
			mes "听起来很奇怪。";
			mes "";
				next;
				mes "[艾伦德]";
			mes "你、你怎么能这么说，"+ @name$ +"？你以前当过诗人吗？创作新颖原创的旋律很难！";
			}
			close3;

		case 3:
			cutin "bard_eland01",2;
			mes "[艾伦德]";
			mes "当然。";
			mes "只有有心情时";
			mes "才能最好地享受欢乐。";
			mes "请再来。";
			mes "";
			close3;

		}

	case 3:
		cutin "bard_eland01",2;
		mes "[艾伦德]";
		mes "嗯~？";
		mes "好吧。不过听听好故事或欢快歌曲对你很有益。那就回头见。";
		close3;
	}
}

morocc,134,111,3	script	Bard#3	741,{
	set @name$,strcharinfo(0);
	if (gef_bard_q == 31) {
		mes "[Kino Kitty]";
		mes "最后一切都会";
		mes "好起来，对吧？";
		mes "我会没事，乔蒂也会没事，她会……哦。";
		next;
		mes "[Kino Kitty]";
		mes "抱歉，我刚才只是在";
		mes "自言自语。";
		mes "你想从我这里得到什么吗？";
		mes "";
		next;

		switch(select("Tell me a story...:Your voice is...:No thanks, I appreciate it though.")) {
		case 1:
			set .@random,rand(1,3);
			if (.@random == 1) {
				mes "[Kino Kitty]";
				mes "许多传说以歌曲流传。神明故事与勇士事迹都被写成歌谣。";
				next;
				mes "[Kino Kitty]";
				mes "许多人喜欢听这些歌，因为他们向往浪漫的过去。正因如此，才有我这样的歌手。";
				next;
				mes "^3355FF基诺·基蒂调好吉他琴弦，开始低声歌唱。^000000";
				next;
				mes "^D43D1A莱茵黄金……";
				mes "隐藏在莱茵河中。";
				mes "若制成戒指，";
				mes "便能统治世界~^000000";
				next;
				mes "^D43D1A魔法守护着它，";
				mes "诅咒盗走它的人";
				mes "永远无法找到爱情。";
				mes "阿尔贝里希明知如此，";
				mes "仍将它偷走。";
				mes "为了力量，他舍弃了爱情。^000000";
				next;
				mes "^D43D1A巨人建造了美丽的瓦尔哈拉，";
				mes "以与美神芙蕾雅成婚";
				mes "作为应得的报酬。";
				mes "但没能得到报酬，";
				mes "他们便强行带走了她。^000000";
				next;
				mes "^D43D1A诸神将阿尔贝里希的宝藏";
				mes "交给巨人以换回芙蕾雅。";
				mes "洛基欺骗了阿尔贝里希，";
				mes "夺走他的戒指与力量。^000000";
				next;
				mes "^D43D1A但阿尔贝里希诅咒了戒指，";
				mes "在戒指归还他之前，";
				mes "嫉妒与死亡将降临";
				mes "所有佩戴者。^000000";
				next;
				mes "^D43D1A戒指交给了巨人，";
				mes "芙蕾雅回到了诸神身边。";
				mes "巨人们为争夺莱茵黄金";
				mes "自相残杀，";
				mes "成为阿尔贝里希诅咒的";
				mes "受害者~^000000";
				next;
				mes "[Kino Kitty]";
				mes "嗯……";
				mes "^333333*咳咳*^000000";
				mes "这首古老的歌曲";
				mes "讲述的是尼伯龙根";
				mes "之戒。";
				next;
				mes "[Kino Kitty]";
				mes "^333333*Cough Cough*^000000";
				mes "哈……我现在一天唱不了一首以上。你喜欢吗？^333333*咳咳*^000000";
				close;

			} else if (.@random == 2) {
				mes "[Kino Kitty]";
				mes "啊……";
				mes "我想唱首歌。每首歌都有自己的故事。^333333*咳咳*^000000";
				next;
				mes "^3355FF基诺·基蒂咳了几声，用袖子擦嘴。他调节琴弦时，你注意到袖口有少量血迹。随后他开始歌唱。^000000";
				next;
				mes "^D43D1A勇敢的英雄齐格弗里德";
				mes "击败强大的巨龙";
				mes "龙血覆盖他的皮肤，";
				mes "令其坚不可摧，";
				mes "唯有一处柔软之地";
				mes "被菩提树的一片叶子";
				mes "遮挡。^000000";
				next;
				mes "^D43D1A齐格弗里德强大无比，";
				mes "看似无敌，唯有知晓秘密的人例外。";

pay_d03_i,81,136,3	script	Villager#ill_moon_3	1_M_ORIENT01,{
	mes "[ Villager ]";
	mes "你是来讨伐我们的吗？！";
	mes "我们没做错任何事！";
	mes "看看这些神圣生物还不明白吗！";
	next;
	mes "[ Villager ]";
	mes "Ah... 狐狸女士……";
	close2;
	initnpctimer;
	disablenpc();
			npctalk "救、救命！！我不想死！";
	areamonster "pay_d03_i",79,136,81,138,"Resentful Bongun",3761,3;
	end;

OnTimer60000:
	stopnpctimer;
	enablenpc();
	end;
}

pay_d03_i,160,260,3	script	Villager#ill_moon_4	1_M_ORIENT01,{
	mes "[ Villager ]";
	mes "你……";
	mes "那个奇怪的法师是谁？";
	mes "你为什么……？";
	next;
	mes "[ Villager ]";
	mes "你！你和他们没两样！";
	mes "我们对你做了什么？";
	close2;
	initnpctimer;
	disablenpc();
	npctalk "Arrgghh-!";
	areamonster "pay_d03_i",158,258,162,262,"Resentful Bongun",3761,3;
	end;

OnTimer60000:
	stopnpctimer;
	enablenpc();
	end;
}


//============================================================
//= Illusion of Vampire
//============================================================
gef_dun01,134,224,1	script	Mojo#ilgf	2_F_MAGICMASTER,{
	if (checkweight(501,1) == 0 || (MaxWeight - Weight) < 1000) {
		mes "[Mojo]";
		mes "确定能带这么多东西吗？减轻包裹吧。";
		close;
	}
	if (ill_vampire == 0) {
		mes "[Mojo]";
		mes "嗯，你是冒险者。来找我做什么？抱歉，我有点忙。你能和那边的祭司谈谈吗？";
		close;
	}
	if (ill_vampire < 16) {
		mes "[Mojo]";
		mes "笔记本……我想看看笔记本……想进入笔记本，就和 Grimm 神父谈谈。如果你愿意，我可以和你一起去。";
		close;
	}
	switch( checkquest(14680,PLAYTIME) ) {
	case -1:
		break;
	case 0:
	case 1:
		mes "[Mojo]";
		mes "你好，冒险者。";
		next;
		mes "[Mojo]";
		mes "哦，抱歉，我现在不能聊天。我正忙着检查你带来的东西。";
		next;
		mes "[Mojo]";
		mes "黎明后再回来好吗？";
		close;
	case 2:
		mes "[Mojo]";
		mes "你好，冒险者。你好吗？";
		next;
		mes "[Mojo]";
		mes "呼，我熬夜检查干燥伊格德拉希尔叶和可疑五芒星。如果 Grimm 神父不来烦我，我也不用这样。";
		next;
		mes "[Mojo]";
		mes "它们太旧且保存不佳，很容易碎成粉末。我没能完成研究。";
		next;
		mes "[Mojo]";
		mes "所以我在想……今天能再带一些给我吗？我需要^0000cd10 10 片干燥伊格德拉希尔叶和 10 个可疑五芒星^000000。";
		next;
		mes "[Mojo]";
		mes "另外，请为那位唠叨的牧师狩猎每种 5 只僵尸。";
		next;
		mes "[Mojo]";
		mes "我会趁此打个盹。";
		erasequest 14680;// Time to Research
		setquest 14679;// Send the Dead Back to Earth
		close;
	}
	switch( checkquest(14679,HUNTING) ) {
	case -1:
		mes "[Mojo]";
		mes "冒险者，触摸笔记本时感觉如何？你觉得它是怎么运作的？";
		next;
		mes "[Mojo]";
		mes "我有很多问题，但那个坏心眼的祭司不让我碰它。";
		next;
		mes "[Mojo]";
		mes "冒险者，下次你进入笔记本时能带我一起吗？我发誓不会偷走笔记本。我只是非常好奇。";
		next;
		mes "[Grimm]";
		mes "我听见了。放弃对它的痴迷。那对你最好。";
		next;
		mes "[Mojo]";
		mes "谁说我痴迷它了？";
		next;
		mes "[Mojo]";
		mes "冒险者，求你了？我看起来不可怜吗？";
		next;
		if (select( "你最想知道什么？", "我不想夹在你们之间。" ) == 2) {
			mes "[" + strcharinfo(0) + "]";
			mes "抱歉，但我不想夹在你们之间。你们都有道理，我无法站在任何一边。";
			next;
			mes "[Mojo]";
			mes "哼，好吧，但如果你哪天可怜我，就回来帮我。答应我？";
			close;
		}
		mes "[Mojo]";
		mes "当然是关于那些行尸走肉！";
		next;
		mes "[Mojo]";
		mes "我真的想知道是什么让它们行动，我的前辈对它们做过什么实验，以及它们处于什么状态。";
		next;
		mes "[Mojo]";
		mes "这类实验现在被禁止了，所有旧记录也都被销毁。";
		next;
		mes "[Grimm]";
		mes "销毁它们是有充分理由的。所以别再好奇了。";
		next;
		mes "[Mojo]";
		mes "哦，对了！冒险者，你能帮我抓一只僵尸吗？要活的。";
			npctalk "等等，它不可能活着。它已经死了。", "", bc_self;
		next;
		mes "[Grimm]";
		mes "不。别想了。Mojo，你已经快越界了。";
		next;
		mes "[Mojo]";
		mes "我又没问你！除非你愿意让我碰笔记本，否则别来烦我！";
		next;
		mes "[Grimm]";
		mes "你刚才让这位冒险者活捉僵尸。";
		next;
		mes "[Grimm]";
		mes "你没考虑它来到这里会造成什么危险。你只是因为好奇才想要它。";
		next;
		mes "[Grimm]";
		mes "你忘了 Jojo 兄弟为什么让你留在这里、远离笔记本吗？";
		next;
		mes "[Mojo]";
		mes "所以我才问这位冒险者。你总是告诉我不能做这个、不能做那个。有没有什么事是我能做而你不会说不的？";
			npctalk "你只是想让我站在这里呼吸。是这样吗？", "", bc_self;
		sleep2 1000;
		npctalk "Sure, why not?", "Grimm#ilgf", bc_self;
		next;
		mes "[Grimm]";
		mes "你不能把书外世界的任何东西带进书里。否则我会把它们清除掉。";
		next;
		mes "[Grimm]";
		mes "如果你真的想对那些亵渎的生物做实验，我建议你先和 Jojo 兄弟及其他人谈谈。";
		next;
		mes "[Mojo]";
		mes "他们什么时候回来？";
		next;
		mes "[Grimm]";
		mes "我不知道。";
		npctalk "You should've become a politician. You would've been more successful at that.", "", bc_self;
		sleep2 500;
			npctalk "我就当这是夸奖了。", "Grimm#ilgf", bc_self;
		next;
		mes "[Mojo]";
		mes "冒险者，我在笔记本里读到，主人曾用一些材料对僵尸做实验。我想是伊格德拉希尔叶和一些图画。";
		next;
		select("你是说干燥伊格德拉希尔叶和一些五芒星。" );
		mes "[Mojo]";
		mes "是的。你至少能帮我弄到它们吗？";
		next;
		mes "[Mojo]";
		mes "也许我能用它们弄清她做过的实验，以及让死者复活的力量。";
			npctalk "当然是偷偷从那位牧师那里拿的。", "", bc_self;
		sleep2 500;
			npctalk "我还是能听见你。", "Grimm#ilgf", bc_self;
		sleep2 1000;
		npctalk "Stop eavesdropping on people.", "", bc_self;
		next;
		mes "[Grimm]";
		mes "你为什么痴迷于此？你真的想让这些不洁生物在大陆上肆虐吗？你不明白高塔为什么禁止实验吗？";
		next;
		mes "[Mojo]";
		mes "听着，我不会对僵尸做实验。我只是想看看她使用的材料。";
		next;
		mes "[Mojo]";
		mes "谁知道呢？也许我能找到一次性消灭这些僵尸的方法。";
			npctalk "我看起来可能不像，但我其实很聪明。", "", bc_self;
		next;
		mes "[Mojo]";
		mes "你同意我们对魔法的热情促进了国家的发展。";
		next;
		mes "[Grimm]";
		mes "...";
			npctalk "我就当你答应了。", "", bc_self;
		next;
		mes "[Mojo]";
		mes "我保证不会做危险的事。我只看看材料。";
		next;
		mes "[Grimm]";
		mes "我会盯着你。";
		next;
		mes "[Mojo]";
		mes "当然，请便。";
			npctalk "哦～你在旁边盯着我学习，真令人兴奋！", "", bc_self;
		next;
		mes "[Grimm]";
		mes "而且你不会再向我要这本笔记本了，对吧？";
		next;
		mes "[Mojo]";
		mes "嗯？可是……我很想看看它。";
			npctalk "你觉得你做得到吗？", "Grimm#ilgf", bc_self;
		sleep2 500;
		npctalk "Maybe one day, yes.", "", bc_self;
		sleep2 1000;
			npctalk "我向奥丁发誓，那天永远不会到来。", "Grimm#ilgf", bc_self;
		sleep2 1000;
		npctalk "Bah!", "", bc_self;
		next;
		select("那么你们达成协议了吗？");
		mes "[Mojo]";
		mes "是的。请带一些干燥伊格德拉希尔叶和五芒星给我。每种 10 个就好。";
		next;
		mes "[Grimm]";
		mes "你确定这些够吗？";
		next;
		mes "[Mojo]";
		mes "嗯，我还不确定。之后再向你要更多，你介意吗？好，那请带给我^0000cd10 10 片干燥伊格德拉希尔叶和 10 个可疑五芒星^000000。";
		next;
		mes "[Mojo]";
		mes "哦，另外你能顺便为那个臭脸祭司猎杀一些僵尸吗？每种 5 只就好，我不想给你太大负担。";
		npctalk "You're already burdening him.", "Grimm#ilgf", bc_self;
		sleep2 500;
			npctalk "是吗，但看看你，我一提议你脸都亮了。", "", bc_self;
		next;
		mes "[Mojo]";
		mes "冒险者，谢谢你为我们做这些。";
		setquest 14679;// Send the Dead Back to Earth
		close;
	case 0:
	case 1:
		break;
	case 2:
		if (countitem(25266) < 10 || countitem(25267) < 10)
			break;
		mes "[Mojo]";
		mes "冒险者，欢迎回来！我等你很久了！你带来我要求的东西了吗？快，让我看看！";
		next;
		mes "[Mojo]";
		mes "哇，这些东西又旧又脆，我担心它们会在手里碎掉。";
		next;
		mes "[Grimm]";
		mes "现在满意了吗？不过它们看起来和你使用的没有区别。";
		next;
		mes "[Mojo]";
		mes "你们这些祭司真是我见过最不好奇的人。我要求这些东西，是想和我拥有的比较，细微差异需要敏锐的眼光才能发现。";
		next;
		mes "[Mojo]";
		mes "冒险者，明天能再带一些给我吗？我担心今天带来的这些最后会被我弄坏。就算不会，我也总能用到更多样本。";
		next;
		mes "[Mojo]";
		mes "太谢谢你了。明天见！";
		delitem 25266,10;	// Dried_Yggdrasil_Leaf
		delitem 25267,10;	// SuspiciousMagicCircle
		erasequest 14679;	// Curious by Nature
		setquest 14680;		// Time to Research
		getexp 500000,500000;
		getitem 25271,1;// Illusion Stone
		close;
	}
	mes "[Mojo]";
		mes "冒险者，欢迎回来！我等你很久了！你带来我要求的东西了吗？快，让我看看！";
	next;
	mes "[Mojo]";
		mes "嗯，这还不够。请带给我^0000cd10 10 片干燥伊格德拉希尔叶和 10 个可疑五芒星^000000。";
	next;
	mes "[Mojo]";
		mes "另外，你能为那边那个臭脸祭司各猎杀 5 只僵尸吗？谢谢！";
	close;

OnInit:
	.@main_completed$ = "isbegin_quest(14666) == 2";
	questinfo( QTYPE_QUEST, QMARK_YELLOW, (.@main_completed$ + " && checkquest(14680,PLAYTIME) == -1 && checkquest(14679,HUNTING) == -1") );
	questinfo( QTYPE_QUEST, QMARK_YELLOW, (.@main_completed$ + " && checkquest(14679,HUNTING) == 2 && countitem(25266) > 9 && countitem(25267) > 9") );
	questinfo( QTYPE_QUEST, QMARK_YELLOW, (.@main_completed$ + " && checkquest(14680,PLAYTIME) == 2") );
	end;
}
gef_dun01,133,221,1	duplicate(dummy_cloaked_npc)	Mojo#ilgf01	2_F_MAGICMASTER
gef_dun01,130,222,5	duplicate(dummy_cloaked_npc)	Mojo#ilgf02	2_F_MAGICMASTER
gef_dun01,130,224,5	duplicate(dummy_cloaked_npc)	Mojo#ilgf03	2_F_MAGICMASTER

gef_dun01,132,223,5	script	Grimm#ilgf	4_M_MINISTER,{
	if (checkweight(501,1) == 0 || (MaxWeight - Weight) < 1000) {
		mes "[Grimm]";
		mes "确定能带这么多东西吗？减轻包裹吧。";
		close;
	}
	if (BaseLevel < 130) {
		mes "[Grimm]";
		mes "这里对你来说太危险了。变强后再回来吧。";
		close;
	}
	if (ill_vampire == 0) {
		mes "[Mojo]";
		mes "让我读一下就好。之后我会把它们带出来。拜托？";
			npctalk "拜托？", "Mojo#ilgf", bc_self;
		sleep2 500;
		cloakonnpcself( "Mojo#ilgf" );
		cloakoffnpcself( "Mojo#ilgf01" );
		emotion ET_QUESTION, getnpcid(0, "Mojo#ilgf01");
npctalk "拜托？", "Mojo#ilgf01", bc_self;
		sleep2 500;
		cloakonnpcself( "Mojo#ilgf01" );
		cloakoffnpcself( "Mojo#ilgf02" );
		emotion ET_QUESTION, getnpcid(0, "Mojo#ilgf02");
npctalk "拜托？", "Mojo#ilgf02", bc_self;
		sleep2 500;
		cloakonnpcself( "Mojo#ilgf02" );
		cloakoffnpcself( "Mojo#ilgf03" );
		emotion ET_QUESTION, getnpcid(0, "Mojo#ilgf03");
npctalk "拜托？", "Mojo#ilgf03", bc_self;
		sleep2 500;
		cloakonnpcself( "Mojo#ilgf03" );
		cloakoffnpcself( "Mojo#ilgf" );
npctalk "拜托？", "Mojo#ilgf", bc_self;
		emotion ET_QUESTION, getnpcid(0, "Mojo#ilgf");
		next;
		mes "[Grimm]";
		mes "别烦我！我知道给你之后你会带着它逃跑。";
		npctalk "Bah!", "Mojo#ilgf", bc_self;
		next;
		mes "[Mojo]";
		mes "我发誓会还给你。只要一分钟。三十秒怎么样？那十秒呢？";
		next;
		mes "[Grimm]";
		mes "不！我甚至不会让你碰它！";
		next;
		mes "[Mojo]";
		mes "拜托，我是 Mojo。你不相信我吗？";
		next;
		mes "[Grimm]";
		mes "不相信。我可以相信信仰上的姐妹 Mojo，但不相信魔法师 Mojo。";
		next;
		mes "[Mojo]";
		mes "哦，拜托！你是祭司吧？你应该相信所有人！为什么把我当小偷？";
		emotion ET_CRY, getnpcid(0, "Mojo#ilgf");
npctalk "呜呜！天啊！他们太不公平了！", "Mojo#ilgf", bc_self;
		next;
		mes "[Grimm]";
		mes "我只信仰祂，而祂告诉我不要相信你。";
npctalk "他还在对我低声说那句话。";
		next;
		mes "[Mojo]";
		mes "我什么也没听见！";
		next;
		mes "[Grimm]";
		mes "当然听不见。只有祂的仆人能听见祂。";
		emotion ET_FRET, getnpcid(0, "Mojo#ilgf");
npctalk "哇，我闻到了谎言的味道，而且来自你的嘴。", "Mojo#ilgf", bc_self;
		sleep2 1000;
		npctalk "That's blasphemy!";
		next;
		select("你能帮我治疗吗？");
		emotion ET_SMILE;
		mes "[Grimm]";
		mes "当然。你随时需要都可以，" + ( Sex ? "兄弟。" : "姐妹。" );
		specialeffect2 EF_HEAL2;
npctalk "他真是个伪君子。我再也不能相信牧师了，都是他的错。", "Mojo#ilgf", bc_self;
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "谢谢。抱歉，但我在这座地下城那么远的角落都听到你们在打架。";
		next;
		mes "[Grimm]";
		mes "真的吗？我们一定很吵。我想那确实不太聪明。";
		next;
		mes "[Mojo]";
		mes "哦，太好了！我们别再争斗了，问问这位冒险者谁是对的吧？";
		next;
		mes "[Mojo]";
		mes "冒险者，如果你不忙，能听我们说说吗？";
npctalk "如果你很忙，我们能理解。", "Mojo#ilgf", bc_self;
		next;
		if (select( "让我听听。", "我得离开。" ) == 2) {
			mes "[Grimm]";
			mes "我明白了。真遗憾你不能抓住这么好的机会。";
			next;
			mes "[Grimm]";
			mes "改变主意后，随时欢迎回来。";
			close;
		}
		mes "[" + strcharinfo(0) + "]";
		mes "让我听听。";
		next;
		mes "[Grimm]";

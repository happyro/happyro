			next;
			mes "[波雄]";
			mes "我们还没挨饿，但食物越来越少。";
			mes "我饿了，所以去摘水果，但这种寒冷气候下这里没有果树。";
			next;
			mes "[波雄]";
			mes "上面的人只告诉我们等待……我等得太累了！";
			mes "但我一离开这里，我最终会进监狱……";
			next;
			mes "[波雄]";
			mes "所以我被困在这里，只能留在这里，忍受饥饿……*抽泣*";
			next;
			mes "[波雄]";
			mes "如果可以，我甚至会吃那棵树的树皮。";
			mes "要是有人能帮忙就好了。*抽泣*";
			set ep14_1_bs,11;
			completequest 11200;
			setquest 11201;
			close;
		} else if (ep14_1_bs == 11) {

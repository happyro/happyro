mora,55,124,2	script	Jones#ep14_1_bs	495,{
	if (ep14_1_bs < 15) {
		mes "[Jones]";
		mes "哦……该死……";
		mes "我下不去，也回不去。我辛苦建立的信誉正在化为尘土。";
		close;
	} else if (ep14_1_bs == 15) {
		mes "[Jones]";
		mes "啊，你是从斯普伦迪德穿过迷雾森林迷宫来的旅客？";
		mes "如果你打算回去，能把这个送给斯普伦迪德军队吗？";
		next;
		mes "[Jones]";
		mes "上级要求我送，但我无法穿过彩虹桥。";
		next;
		mes "[Jones]";
		mes "送往其他地方的货物也都停了。啊，我的信誉正在受损……";
		next;
		switch(select("是。:否。")) {
		case 1:
			mes "[Jones]";
			mes "谢谢。";
			set ep14_1_bs,16;
			changequest 11206,11207;
			close;
		case 2:
			mes "[Jones]";
			mes "向陌生人提出这种请求有点不好意思……哈哈！";
			close;
		}
	} else if (ep14_1_bs == 16) {
		if (checkweight(1201,1) == 0) {
			mes "[Jones]";
		mes "你携带的物品种类太多。请减轻负重后再回来。";
			close;
		}
		if (MaxWeight - Weight < 3500) {
			mes "[Jones]";
		mes "你携带的物品太重。请减轻负重后再回来。";
			close;
		}
		mes "[Jones]";
		mes "请好好保管。";
		mes "这是给斯普伦迪德的 Daphrer。";
		set ep14_1_bs,17;
		getitem 6391,1; //Splendid_Supply_Kit
		changequest 11207,11208;
		close;
	} else if (ep14_1_bs == 17) {
		mes "[Jones]";
	mes "请好好保管它。";
	mes "这是给斯普兰迪德的 Daphrer 的。";
		close;
	} else if (ep14_1_bs > 17) {
		mes "[Jones]";
		mes "多亏你，工作顺利完成。";
		mes "呵呵，我看出你有成为送货员的潜力。";
		mes "对送货工作感兴趣吗？";
		close;
	} else {
		mes "[Jones]";
		mes "呵呵，我看出你有成为送货员的潜力。";
		mes "对送货工作感兴趣吗？";
		close;
	}
	end;
}


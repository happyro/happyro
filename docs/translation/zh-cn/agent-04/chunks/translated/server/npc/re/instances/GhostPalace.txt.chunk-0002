1@spa,198,43,1	duplicate(Lurid Royal Guard#dk)	#sv	CLEAR_NPC
1@spa,196,41,1	duplicate(Lurid Royal Guard#dk)	#tv	CLEAR_NPC

1@spa,204,29,1	script	King#dk11	4_M_RUSKING,{
	disable_items;
	mes "[King]";
	mes "嘿，你还活着吗？";
	mes "没想到会遇到还活着的人。";
	next;
	.@item_name_req$ = getitemname(6672);// Gray_Shard
	mes "[King]";
	mes "你有 ^006400" + .@item_name_req$ + "^000000 吗？";
	mes "能把它给我吗？";
	mes "忠诚皇家卫兵的记忆";
	mes "以及他所爱之人的记忆";
	mes "都包含在这些碎片中。";
	next;
	mes "[King]";
	mes "你愿意把 ^006400" + .@item_name_req$ + "^000000 给我吗？";
	mes "罪恶感正在吞噬我的灵魂。";
	mes "我的灵魂被困在幽灵宫殿内。";
	next;
	mes "[King]";
	mes "我正在从碎片中收集萨克莱遗弃的记忆。";
	next;
	mes "[King]";
	mes "如果你给我 ^006400" + .@item_name_req$ + "^000000，我就能为你制作装备。";
	next;
	mes "[King]";
	mes "被诅咒的骑士……";
	mes "请帮我拯救萨克莱的灵魂。";
	next;
	setarray .@item_name$[0],
		"Thanos Sword", "Thanos Broadsword", "Thanos Spear", "Thanos Two-Handed Spear", "Thanos Staff",
		"Thanos Two-handed Staff", "Thanos Bow", "Thanos Dagger", "Thanos Katar", "Thanos Knuckle",
		"Thanos Hammer", "Thanos Axe", "Thanos Violin", "Thanos Whip",
		"Gray Shield", "Gray Armor", "Gray Robe", "Gray Cloak", "Gray Shoes", "Gray Helmet";
	setarray .@items_list[0],13441,21009,1438,1496,1669,2023,18119,13093,28000,1836,16028,28100,1933,1988,2187,15090,15091,20721,22033,18820;

	for ( .@i = 0; .@i < 20; .@i++ )
		.@menu$ += .@item_name$[.@i] + ":";
	.@menu$ += "Cancel";

	while(true) {
		.@s = select(.@menu$) - 1;
		if (.@s == 20) {
			mes "[King]";
			mes "总有一天，萨克莱一定会";
			mes "摆脱这个诅咒。";
			mes "我相信";
			mes "^006400" + .@item_name_req$ + "^000000 是唯一的方法，";
			mes "能拯救他……";
			close;
		}
		.@cost = ( .@s > 13 ? 100 : 200 );
		mes "[King]";
		mes "要制作 ^FF0000" + .@item_name$[.@s] + "^000000，";
		mes "我需要 " + .@cost + " 个 ^006400" + .@item_name_req$ + "^000000。";
		next;
		if (select( "取消", "交出 " + .@cost + " 个" + .@item_name_req$ + "。" ) == 1) {
			mes "[King]";
			mes "总有一天，萨克莱一定会";
			mes "摆脱这个诅咒。";
			next;
			continue;
		}
		if (countitem(6672) < .@cost) {
			mes "[King]";
			mes "你没有足够的 ^006400" + .@item_name_req$ + "^000000";
			mes "无法制作 ^FF0000" + .@item_name$[.@s] + "^000000。";
			mes "我需要 " + .@cost + " 个 ^006400" + .@item_name_req$ + "^000000。";
			next;
			continue;
		}
		mes "[King]";
		mes "我会制作 ^FF0000" + .@item_name$[.@s] + "^000000。";
		mes "需要使用 " + .@cost + " 个 ^006400" + .@item_name_req$ + "^000000。";
		next;
		mes "你看见光芒穿过国王交叠的双手，逐渐凝聚成形。";
		next;
		mes "[King]";
		mes "好了，完成了。";
		mes "拿着这个 ^FF0000" + .@item_name$[.@s] + "^000000，";
		mes "去面对萨克莱和塔塔诺斯。";
		next;
		mes "[King]";
		mes "力量需要牺牲。";
		mes "请务必小心……";
		delitem 6672,.@cost;// Gray Shard
		getitem .@items_list[.@s],1;
		close;
	}
}

1@spa,210,28,0	script	Way out of Palace	WARPNPC,2,2,{
	end;
OnTouch_:
	mes "该离开幽灵宫殿了。";
	mes "一切都已完成，";
	mes "幽灵宫殿将会消失……";
	close2;
	if (isbegin_quest(1263) == 2)
		getitem 6672,1;// Gray Shard
	else {
		setquest 1263;// Cursed Swordman
		completequest 1263;
		getexp 900000,500000;
		getitem 6672,2;// Gray Shard
	}
	warp "dali02",46,129;
	end;
}


		enablenpc instance_npcname("Soldier's Corpse#dk3");
		enablenpc instance_npcname("Soldier's Corpse#dk4");
	}
	end;
}

1@spa,199,214,1	script	Lurid Royal Guard#dk4	4_M_SAKRAYROYAL,{
	.@prince$ = instance_npcname("Visiting Prince#dk");
	mes "[Lurid Royal Guard]";
	mes "蒂亚拉公主在哪里？";
	npctalk "Lurid Royal Guard: 蒂亚拉公主在哪里？";
	next;
	mes "[Visiting Prince]";
	mes "你来得太晚了……但你带来了我寻找的东西。谢谢你的帮助。";
	npctalk "Visiting Prince: 你来得太晚了……但你带来了我寻找的东西。谢谢你的帮助。", .@prince$;
	next;
	mes "[Visiting Prince]";
	mes "被诅咒的魔剑塔塔诺斯！准备好迎接新主人了吗？";
	npctalk "Visiting Prince: 被诅咒的魔剑塔塔诺斯！准备好迎接新主人了吗？", .@prince$;
	next;
	cutin "tartanos.bmp",3;
	mes "[Magic Sword Tartanos]";
	mes "你竟敢！";
	npctalk "Magic Sword Tartanos: 你竟敢！", instance_npcname("Magic Sword Tartanos#dk2");
	next;
	mes "[Visiting Prince]";
	mes "啊，啊！！！";
	npctalk "Visiting Prince: 啊，啊！！！", .@prince$;
	donpcevent instance_npcname("#gp_control_5") + "::OnStart";
	close2;
	cutin "",255;
	end;
}

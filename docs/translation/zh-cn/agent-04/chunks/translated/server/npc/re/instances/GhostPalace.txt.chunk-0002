1@spa,196,44,5	script	Sakray#dk	4_M_SAKRAY,{
	mes "[Lurid Royal Guard]";
	mes "你满意了吗……魔剑塔塔诺斯？";
	npctalk "Lurid Royal Guard: 你满意了吗……魔剑塔塔诺斯？";
	next;
	mes "[Magic Sword Tartanos]";
	mes "我需要更多鲜血……萨克莱，把他的血献给我。";
	npctalk "Magic Sword Tartanos: 我需要更多鲜血……萨克莱，把他的血献给我。", instance_npcname("Magic Sword Tartanos#dk3");
	next;
	mes "[Sakray]";
	mes "好，很好。一个旅人。你看到了吗？";
	npctalk "Sakray: 好，很好。一个旅人。你看到了吗？";
	next;
	mes "[" + strcharinfo(0) + "]";
	mes "萨克莱，你想要什么？同情？还是陷阱？";
	unittalk getcharid(3), "" + strcharinfo(0) + " : 萨克莱，你想要什么？同情？还是陷阱？";
	next;
	mes "[Sakray]";
	mes "不……我不需要费力去抓一个新手。";
	npctalk "Sakray: 不……我不需要费力去抓一个新手。";
	next;
	mes "[" + strcharinfo(0) + "]";
	mes "既然如此……那为什么……？";
	unittalk getcharid(3), "" + strcharinfo(0) + " : 既然如此……那为什么……？";
	next;
	cutin "cry-b.bmp",2;
	mes "[Sakray]";
	mes "我想借你摆脱体内的一部分人性。";
	npctalk "Sakray: 我想借你摆脱体内的一部分人性。";
	next;
	mes "[Sakray]";
	mes "我对结果相当满意。";
	npctalk "Sakray: 我对结果相当满意。";
	next;
	mes "[Magic Sword Tartanos]";
	mes "萨克莱，现在把鲜血献给我！";
	npctalk "Magic Sword Tartanos: 萨克莱，现在把鲜血献给我！", instance_npcname("Magic Sword Tartanos#dk3");
	next;
	mes "[Sakray]";
	mes "如果你是我，你会怎么做？";
	npctalk "Sakray: 如果你是我，你会怎么做？";
	next;
	mes "[Sakray]";
	mes "你能从这个诅咒中解脱吗？";
	npctalk "Sakray: 你能从这个诅咒中解脱吗？";
	next;
	mes "[" + strcharinfo(0) + "]";
	mes "...";
	unittalk getcharid(3), "" + strcharinfo(0) + " : ...";
	next;
	mes "[Sakray]";
	mes "呵呵……我会一直注视你，直到你长大成人。";
	npctalk "Sakray: 呵呵……我会一直注视你，直到你长大成人。";
	next;
	mes "[Sakray]";
	mes "为了塔塔诺斯，我以后愿意猎杀你。";
	npctalk "Sakray: 为了塔塔诺斯，我以后愿意猎杀你。";
	cutin "",255;
	next;
	mes "[Sakray]";
	mes "那么，再见。";
	npctalk "Sakray: 那么，再见。";
	close2;
	donpcevent instance_npcname("#tb") + "::OnStart";
	end;
}

1@spa,196,46,1	script	#tb	CLEAR_NPC,{
	end;
OnStart:
	disablenpc instance_npcname("Sakray#dk");
	disablenpc instance_npcname("Magic Sword Tartanos#dk3");
	enablenpc instance_npcname("#tb");
	enablenpc instance_npcname("#sv");
	enablenpc instance_npcname("#tv");
	initnpctimer;
	end;
OnTimer3000:
	npctalk "蒂亚拉公主的声音：我能为你做什么？";
	end;
OnTimer8000:
	npctalk "萨克莱的声音：我会永远陪在你身边。请在我身旁安息。", instance_npcname("#sv");
	end;
OnTimer13000:
	npctalk "Magic Sword Tartanos: 萨克莱，不要忘记我们之间的血之契约。", instance_npcname("#tv");
	end;
OnTimer17000:
	npctalk "Magic Sword Tartanos: 在找到令我满意的鲜血之前，你的灵魂属于我……", instance_npcname("#tv");
	end;
OnTimer22000:
	npctalk "萨克莱的声音：和我一起在阴影中安息。", instance_npcname("#sv");
	end;
OnTimer25000:
	npctalk "萨克莱的声音：永远沉睡在黑暗中……", instance_npcname("#sv");
	end;
OnTimer28500:
	disablenpc instance_npcname("#tb");
	disablenpc instance_npcname("#sv");
	disablenpc instance_npcname("#tv");
	mapannounce 'map_spa$, "该离开幽灵宫殿了。", bc_map,0xFFFF00;
	enablenpc instance_npcname("Way out of Palace");
	enablenpc instance_npcname("King#dk11");
	end;
}


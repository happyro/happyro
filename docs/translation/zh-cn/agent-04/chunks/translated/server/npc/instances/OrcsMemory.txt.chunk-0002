2@orcs,172,13,0	script	Kruger#	434,{
	if (yong_odun < 2) {
		mes "[Kruger]";
		mes "*Coughing*";
		mes ""+strcharinfo(0)+"，是你啊……";
		next;
		mes "["+strcharinfo(0)+"] ";
		mes "别动！你受伤了！";
		next;
		mes "[Kruger]";
		mes "没……关系……我快死了……";
		mes "....";
		mes "萨满？萨满怎么了？";
		next;
		mes "["+strcharinfo(0)+"] ";
		mes "萨满死了。那个萨满究竟是谁？";
		next;
		mes "听到萨满死亡，Kruger 似乎松了口气，但你注意到他脸上苦涩的表情。";
		next;
		mes "[Kruger]";
		mes "我……我只是无法杀死自己的女儿……";
		mes "谢谢你，我相信她终于摆脱了曾束缚灵魂的噩梦。";
		next;
		mes "Kruger 正要继续说，却在开口前咽下了最后一口气……";
		set yong_odun,2;
		close;
	}
	else {
		mes "你看到 Kruger 的尸体安静地躺在地上。";
		close;
	}

OnInstanceInit:
	disablenpc instance_npcname("Kruger#");
	end;

OnEnable:
	enablenpc instance_npcname("Kruger#");
	end;
}


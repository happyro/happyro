1@face,120,97,6	script	Chaos#1	4_M_CHAOS,{
	cutin "h_chaos01",2;
	if (is_party_leader() == false) {
		mes "[Chaos]";
		mes "我不知道这是怎么回事，但我正在和你的队长交谈，请稍等好吗？";
		close2;
		cutin "",255;
		end;
	}
	mes "[Chaos]";
	mes "哇，你跟得真快。";
	npctalk "Chaos: 哇，你跟得真快。";
	next;
	select("刚才就在前面的那只大的……");
	cutin "",255;
	mes "[" + strcharinfo(0) + "]";
	mes "刚才看到的那只大的是这里的首领吗？";
	unittalk getcharid(3), strcharinfo(0) + ": 刚才看到的那只大的是这里的首领吗？";
	next;
	cutin "h_chaos01",2;
	mes "[Chaos]";
	mes "不~~不可能是脸虫女王。";
	close2;
	donpcevent instance_npcname("Chaos#11") + "::OnStart";
	cutin "",255;
	end;

OnInstanceInit:
	hideonnpc instance_npcname("Chaos#1");
	end;
}

1@face,120,97,6	script	Chaos#11	4_M_CHAOS,{
	end;
OnStart:
	.@iris_name$ = instance_npcname("Iris#1");
	hideoffnpc instance_npcname("Chaos#11");
	hideonnpc instance_npcname("Chaos#1");
	npctalk "Chaos: 不~~不可能是脸虫女王。";
	sleep 4000;
	npctalk "Chaos：刚才看到的是变异脸虫。";
	sleep 5000;
	npctalk "Chaos：等等！死去脸虫脱落的皮可能有用。";
	sleep 3000;
	npctalk "Iris：但是战斗拖太久的话，鳞片可能会损坏，就没价值了！", .@iris_name$;
	sleep 5000;
	npctalk "Iris：我听说熟练的猎人很擅长快速剥下鳞片。", .@iris_name$;
	sleep 6000;
	npctalk "Iris：Chaos，你擅长这个吗？", .@iris_name$;
	sleep 3000;
	npctalk "Chaos：不……完全不擅长！我只会用猛击，所以鳞片可能会被烧掉……";
	sleep 3000;
	npctalk "Iris：没用的 Chaos。", .@iris_name$;
	sleep 3000;
	npctalk "Chaos：而且我们要找的目标不在这里。我先回去，剩下的交给你好吗？";
	sleep 5000;
	hideonnpc instance_npcname("Chaos#11");
	npctalk "Iris：Chaos！你要丢下我吗？", .@iris_name$;
	sleep 3000;
	hideonnpc .@iris_name$;
	donpcevent instance_npcname("#fwormcontrol2") + "::OnStart";
	donpcevent instance_npcname("#fwormprize2") + "::OnStart";
	end;
OnInstanceInit:
	hideonnpc instance_npcname("Chaos#11");
	end;
}


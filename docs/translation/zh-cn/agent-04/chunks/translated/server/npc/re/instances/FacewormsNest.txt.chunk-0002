	mapannounce 'map_name$, "脸虫限时挑战开始。击杀越快，奖励比例越高。",bc_map,"0xffffff";
	donpcevent instance_npcname("#fwormprize1") + "::OnStart";
	end;
OnInstanceInit:
	hideonnpc instance_npcname("Chaos#01");
	end;
}


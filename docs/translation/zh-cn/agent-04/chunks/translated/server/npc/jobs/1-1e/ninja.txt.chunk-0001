alberta,30,65,3	script	Akagi	730,{
	if (Class == Job_Novice) {
		if (JobLevel == 10) {
			mes "[赤木]";
			mes "嗯……";
			mes "你一定是因为感应到";
			mes "有人";
			mes "在这里等你才来的。";
			mes "告诉我，你是否寻求";
			mes "忍耐之道？";
			next;
			if(select("No:Yes") == 1) {
				mes "[赤木]";
				mes "我明白了。";
			mes "人各有志，";
			mes "我想也是。";
			mes "请多保重。";
				close;
			}
			mes "[赤木]";
			mes "很好。";
			mes "那么，让我";
			mes "立刻让你踏上这条";
			mes "道路……";
			close2;
			switch(rand(3)) {
				case 1:
					warp "amatsu",170,229;
					end;
				case 2:
					warp "amatsu",216,188;
					end;
				default:
					warp "amatsu",178,176;
					end;
			}
		} else {
			mes "[赤木]";
			mes "嗯？在你变得更强之前";
			mes "我无法为你";
			mes "提供帮助";
			mes "……";
			mes "……";
			close;
		}
	} else {
		mes "[赤木]";
		mes "嗯……";
		mes "你和我……";
		mes "我们的战斗能力";
		mes "相当接近。";
		mes "也许以后可以一起";
		mes "切磋。";
		close;
	}
}

que_ng,30,65,3	script	Kuuga Gai#nq	730,{
	if (Upper == 2) {
		mes "[空牙凯]";
		mes "我……我从未";
		mes "见过像你这样";
		mes "强大的婴儿！";
		mes "快、快走开，你这个";
		mes "怪物！";
		close;
	}
	if (Class == Job_Novice) {
		if (JobLevel < 10) {
			mes "[空牙凯]";
			mes "嗯？你是来学习";
			mes "如何成为忍者的吗？";
			mes "你还不够熟练，";
			mes "等你更熟悉";
			mes "与魔物战斗后再回来吧。";
			close;
		}
		if (NINJ_Q == 0) {
			mes "["+strcharinfo(0)+"]";
			mes "打扰了。";
			mes "你、你好？";
			next;
			mes "[空牙凯]";
			mes "...............................";
			mes "你是怎么做到的？";
			next;
			mes "["+strcharinfo(0)+"]";
			mes "做到什么？我什么";
			mes "也没做啊……";
			next;
			mes "[空牙凯]";
			mes "你、你怎么能看到我？";
			mes "我本应对肉眼隐形";
			mes "才对。";
			mes "啊，我明白了。野猫乔";
			mes "一定派你来杀我！我不会上当的！去死吧！";
			next;
			mes "["+strcharinfo(0)+"]";
			mes "等、等等！我、我甚至";
			mes "不知道野猫乔是谁！";
			mes "冷静点，没必要";
			mes "动粗！";
			next;
			mes "[空牙凯]";
			mes "什么……？";
			mes "你是怎么躲开";
			mes "我所有攻击的？";
			mes "你确实有点本事，";
			mes "这一点我承认。";
			next;
			mes "["+strcharinfo(0)+"]";
			mes "...............................";
			mes "我来这里是希望";
			mes "转职";
			mes "成为忍者。";
			next;
			mes "[空牙凯]";
			mes "……哦，就这样？";
			mes "嗯，你潜力很大，";
			mes "但我现在帮不了你。";
			mes "我的敌人太多，";
			mes "哪怕一秒也不能放松警惕。";
			next;
			mes "[空牙凯]";
			mes "那个野猫乔";
			mes "完全冷酷无情……！";
			mes "他随时都可能发动袭击！";
			mes "为了战胜敌人，";
			mes "他什么都做得出来！";
			next;
			mes "[空牙凯]";
			mes "等等，我突然";
			mes "想到一件事。";
			mes "也许你能帮我。";
			mes "按我说的做，如果你";
			mes "真的想成为忍者，";
			mes "我就教你几招。";
			next;
			if(select("Sure.:No, thanks.") == 2) {
				mes "[空牙凯]";
				mes "嗯？好吧。";
				mes "不过，我还是不明白";
				mes "我们为什么不能在这";
				mes "小小的困境中";
				mes "互相帮助……";
				close;
			}
			mes "[空牙凯]";
			mes "太好了！我想请野猫乔";
			mes "同意暂时休战。";
			mes "我知道我们都没有武器，";
			mes "所以应该先准备好装备。";
			next;
			mes "[空牙凯]";
			mes "请带上这封信，";
			mes "把它交给艾因布洛克的";
			mes "野猫乔。他精通伪装，";
			mes "所以要仔细寻找。";
			mes "啊，还要去高处找他。";
			next;
			mes "[空牙凯]";
			mes "没错，野猫乔";
			mes "总喜欢躲在高处。";
			mes "把信交给他之后回来，";
			mes "告诉我他的答复。";
			set NINJ_Q,1;
			setquest 6015;
			close;
		}
		else if (NINJ_Q == 1) {
			mes "[空牙凯]";
			mes "虽然这件事不算紧急，";
			mes "还是请尽快去艾因布洛克，";
			mes "把我的信交给野猫乔。";
			close;
		}
		else if (NINJ_Q == 2) {
			mes "[空牙凯]";
			mes "你把信交给野猫乔了吗？";
			mes "我还想知道他对休战提议的";
			mes "答复。总之，想办法";
			mes "从他那里套出答案。";
			close;
		}
		else if (NINJ_Q == 3) {
			mes "[空牙凯]";
			mes "啊，你回来了。";
			mes "野猫乔让你带着他的";
			mes "答复回来了吗？太好了，";
			mes "快让我看看。";
			next;
			mes "[空牙凯]";
			mes "什么……？！他怎么能";
			mes "拒绝我的休战提议？！";
			mes "这只能说明他又做出了";
			mes "一把苦无。糟了！我得追上他，";
			mes "不然就死定了！";
			next;
			mes "[空牙凯]";
			mes "听着，你得再帮我一次！";
			mes "我需要你收集一些材料，";
			mes "这样我才能制作自己的苦无";
			mes "去对付野猫乔。之后我就把你";
			mes "转职为忍者。";
			next;
			mes "[空牙凯]";
			mes "你只需要";
			mes "带给我";
			mes "^3355FF5 个赛依佛^000000和";
			mes "^3355FF1 个普拉康^000000。";
			mes "请尽快收集齐！";
			next;
			mes "["+strcharinfo(0)+"]";
			mes "咦？真奇怪，";
			mes "野猫乔也让我";
			mes "收集同样的材料。";
			next;
			mes "[空牙凯]";
			mes "可恶！那就是说……";
			mes "你其实帮乔制作了他的苦无！";
			mes "不！我早该想到这一点！";
			mes "不过现在已经太晚了。";
			mes "快、快点收集吧！";
			set NINJ_Q,4;
			changequest 6017,6018;
			close;
		}
		else if (NINJ_Q == 4) {
			if (countitem(7053) < 5 || countitem(1010) < 1) {
				mes "[空牙凯]";
				mes "快把";
				mes "^3355FF5 个赛依佛^000000和";
				mes "^3355FF1 个普拉康^000000带给我，";
				mes "这样我才能制作";
				mes "自己的苦无去";
				mes "对付野猫乔！";
				close;
			}
			if (SkillPoint != 0) {
				mes "[空牙凯]";
				mes "等等，等等……";
				mes "你还剩下一些";
				mes "技能点。";
				mes "最好在转职前";
				mes "把它们全部用掉，";
				mes "对吧？";
				close;
			}
			mes "[空牙凯]";
			mes "啊，你带齐我需要的东西回来了。";
			mes "你比我预想的更早回来，嗯？很好，";
			mes "我会遵守承诺，";
			mes "把你转职为忍者。";
			next;
			mes "[空牙凯]";
			mes "正式介绍一下我自己。";
			mes "我是透迦忍者团的上忍空牙凯，";
			mes "负责带领队伍寻找卡兹玛大人。";
			next;
			mes "[空牙凯]";
			mes "卡兹玛大人是我们村子的首领，";
			mes "但他逃走了。结果忍者团内部";
			mes "发生了冲突，";
			mes "现在的局势相当不稳定……";
			next;
			mes "[空牙凯]";
			mes "起初因为情况复杂，";
			mes "我不想接受你成为忍者。";
			mes "不过你已经证明了自己，";
			mes "确实有资格加入忍者行列。";
			next;
			mes "[空牙凯]";
			mes "从他的信来看，就连乔也很看重你。";
			mes "记住，作为忍者，任务是最高优先级。";
			mes "但不要让任务目标凌驾于良知之上。";
			next;
			mes "[空牙凯]";
			mes "“保密高于一切。”";
			mes "为了让我们的秘密藏在阴影中，";
			mes "忍者武器只能向授权商人购买";
			mes "或出售。请记住这一点。";
			next;
			mes "[空牙凯]";
			mes "从今天起，你就是透迦忍者团";
			mes "值得骄傲的一员。愿你如风般敏捷，";
			mes "如落下的阴影般寂静。";
			callfunc "Job_Change",Job_Ninja;
			set NINJ_Q,5;
			delitem 7053,5; // Cyfar
			delitem 1010,1; // Phracon
			getitem 13010,1;	// Asura
			completequest 6018;
			close;
		}
		else {
			mes "[空牙凯]";
			mes "最近过得怎么样？";
			mes "努力训练吧：你要做到";
			mes "消失得不留痕迹。";
			mes "如果你能做到，";
			mes "所有忍者都会尊重你～";
			close;
		}
	} else {
		if (BaseClass == Job_Ninja) {
			mes "[空牙凯]";
			mes "最近过得怎么样？";
			mes "努力训练吧：你要做到";
			mes "消失得不留痕迹。";
			mes "如果你能做到，";
			mes "所有忍者都会尊重你～";
			close;
		} else {
			mes "[空牙凯]";
			mes "什么……？";
			mes "你怎么能找到";
			mes "藏在阴影里的我？！";
			mes "你肯定不只是";
			mes "普通冒险者吧？";
			close;
		}
	}
}

einbroch,184,194,3	script	Suspicious Man#nq	881,{
	if (NINJ_Q == 1) {
		mes "[Suspicious Man]";
		mes "我去过许多国家，";
		mes "但从未登上过像艾因布罗克高塔";
		mes "这么高的建筑。";
		mes "和它相比，我家乡的建筑";
		mes "都显得小得可怜……";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "哦，你来自";
		mes "天津吗？我正在找一个";
		mes "叫野猫乔的人，";
		mes "他就来自那里。";
		next;
		mes "[Suspicious Man]";
		mes "……不，不，我其实来自依斯鲁得，";
		mes "只是为了寻找一些矿物才来到";
		mes "艾因布罗克。告诉我，";
		mes "你为什么要找野猫乔？";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "我需要把这封信交给他，";
		mes "得到他的答复，";
		mes "这样我才能成为忍者。";
		next;
		mes "[Suspicious Man]";
		mes "真的吗？现在想想，";
		mes "我好像确实在这座城里";
		mes "碰到过他一两次。";
		mes "不过他更喜欢别人叫他“赤豹乔”，";
		mes "而不是“野猫乔”。";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "我很想帮你找到他，";
		mes "但我得先找到正在寻找的矿物。";
		mes "如果你不介意，能帮我吗？";
		mes "这样我也能帮你找到乔。";
		next;
		if(select("不用担心，我自己找他。:好的，我来帮你。") == 1) {
			mes "[Suspicious Man]";
			mes "你确定吗……？";
			mes "赤豹乔可是易容大师。";
			mes "想找到他，你需要";
			mes "能得到的一切帮助……";
			close;
		}
		mes "[Suspicious Man]";
		mes "太好了，我很高兴听到你这么说。";
		mes "请帮我找到";
		mes "^3355FF5 个赛依佛^000000和";
		mes "^3355FF1 个普拉康^000000。";
		set NINJ_Q,2;
		changequest 6015,6016;
		close;
	}
	else if (NINJ_Q == 2) {
		if (countitem(7053) < 5 || countitem(1010) < 1) {
			mes "[Suspicious Man]";
			mes "请尽快把";
			mes "^3355FF5 个赛依佛^000000和";
			mes "^3355FF1 个普拉康^000000带给我。这样，";
			mes "我就能帮你找到";
			mes "赤豹乔。";
			close;
		}
		mes "[Suspicious Man]";
		mes "很好，很好。你把矿物带来了……";
		mes "现在轮到我帮你了。来，";
		mes "让我看看那封信。";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "?????!!";
		next;
		mes "[Suspicious Man]";
		mes "为什么？你没把空牙凯的信带给我吗？";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "你是……";
		mes "你是野猫乔吗？";
		next;
		mes "[Suspicious Man]";
		mes "……是的，不过我更喜欢";
		mes "别人叫我赤豹乔。";
		mes "空牙凯派你来找我，对吧？";
		mes "只有他会那样叫我。";
		mes "所以，你想成为忍者？";
		mes "嗯，好吧。";
		next;
		mes "[Red Leopard Joe]";
		mes "如果你想成为忍者，";
		mes "就必须时刻小心自己的所见所信。";
		mes "别忘了，一旦你的秘密被发现，";
		mes "你作为忍者的道路就结束了。";
		next;
		mes "[Red Leopard Joe]";
		mes "记住要迅速行动，";
		mes "并始终做到不留痕迹地消失。";
		mes "藏身于阴影之中，";
		mes "才是我们真正的终极力量。";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "我明白了……";
		mes "...........";
		next;
		mes "[Red Leopard Joe]";
		mes "现在，让我读读这封信。";
		mes "让我看看……";
		mes "嗯，我还以为空牙凯";
		mes "会想再次挑战我，";
		mes "没想到他竟然想";
		mes "暂时休战？哈！";
		//
		// chunk boundary
		// chunk boundary 2
	// 行数占位：保持与官方源文件物理行数一致
	// 片尾行数占位
	// 片尾行数占位
	// 行数占位：保持与官方源文件物理行数一致





































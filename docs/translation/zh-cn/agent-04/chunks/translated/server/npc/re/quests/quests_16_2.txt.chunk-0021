		next;
		mes "[Tired Looking Old man]";
		mes "这是什么……你要我买什么？大炮？我要它做什么？";
		next;
		mes "[Tired Looking Old man]";
		mes "如果你给我传单我会收下……但矿井里只需要少量火药。";
		delitem 25163,1;	// Arms_Shop_AD
		completequest 16056;	// Advertising: Then blow it all away!
		close;
	case 2:
		mes "[Tired Looking Old man]";
		mes "不。我不需要大炮。";
		mes "不管你怎么劝我，我都不需要。";
		close;
	}
	end;

OnInit:
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "isbegin_quest(16056) == 1" );
	end;
}

einbech,170,143,3	script	Sleepy Looking Old woman	4_F_BARYO_OLD,{
	switch( isbegin_quest(16057) ) {
	case 0:
		mes "[Sleepy Looking Old woman]";
		mes "我这个年纪……唯一的乐趣就是坐在温暖的地方晒太阳。";
		next;
		mes "[Sleepy Looking Old woman]";
		mes "我看不清也听不清。不过仔细听，别担心。";
		close;
	case 1:
		if (countitem(25163) < 1) {
			mes "[Sleepy Looking Old woman]";
			mes "什么？午餐？我已经吃过了。顺便说一句，你根本没带食物。";
			close;
		}
		mes "你把传单递给她。";
		next;
		mes "[Sleepy Looking Old woman]";
			mes "这是什么？我看不清。是烤栗子吗？在我看来像一张纸。";
		next;
		mes "[Sleepy Looking Old woman]";
			mes "风干鱼片？你在卖吗？哦，我没有牙齿，吃不了。";
		delitem 25163,1;	// Arms_Shop_AD
		completequest 16057;	// Advertising: Suitable revenge for old age!
		close;
	case 2:
		mes "[Sleepy Looking Old woman]";
			mes "什么？午餐？我已经吃过了。嘿嘿……";
		close;
	}
	end;

OnInit:
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "isbegin_quest(16057) == 1" );
	end;
}

// Milo Quests
rebel_in,108,27,3	script	Milo River#16.2rm	4_M_GUNSLINGER2,{
	if (terra_gloria_main < 17) {
		mes "[Milo River]";
		mes "我们的饭难吃不是我的错。";
		mes "如果给我更多时间和预算，我能做更好的食物。";
		next;
		mes "[Milo River]";
		mes "呼，今天该给那些贪吃鬼准备什么？他们想吃什么……？";
		close;
	}

	// Lebedev twins quest
	if (lebedev_quest_16_2 == 2 || lebedev_quest_16_2 == 3) {
		if (isbegin_quest(16013) == 1) {
			mes "[Milo River]";
			mes "USU 双胞胎的名声？你是冒险者，为什么问这个？";
			next;
			mes "[Milo River]";
			mes "既然是那个部队请求你……那我就告诉你。";
			next;
			mes "[Milo River]";
			mes "几年前，埃里克森指挥官把她们带来这里。";
			mes "听说是从孤儿院带来的。";
			next;
			mes "[Milo River]";
			mes "她们顺利接受训练，并在射击方面表现出色。她们很快就能在反抗军中发挥作用。";
			next;
			mes "[Milo River]";
			mes "她们当训练生已经有一段时间，几个月前第一次执行实战任务。就是那时她们惹了麻烦。";
			mes "有人说妹妹曾向平民区扔手榴弹。但我不知道具体情况。";
			next;
			mes "[Milo River]";
			mes "之后她们被调到 USU，接受更多教育。那引起了一阵骚动。";
			mes "从那时起她们开始违抗上级。";
			mes "我想我听说她们从那以后一直在做那件事……";
			next;
			mes "[Milo River]";
			mes "在那之前，她们是训练生，比其他队员空闲。她们偶尔会来食堂，拿些点心并和我们聊天。";
			next;
			mes "[Milo River]";
			mes "那起事件后她们再也没来。光是听到关于她们的故事，我就觉得她们已经不是我认识的那些孩子了。";
			mes "她们以前比现在好……希望你能照顾她们。";
			next;
			mes "[Milo River]";
			mes "我能告诉你的就这些。";
			completequest 16013;// Testimony: Chef's story
			lebedev_quest_16_2++;
			questinfo_refresh();
			next;
			mes "[" + strcharinfo(0) + "]";
			mes "（我从其他人那里也听过类似的故事……";
			mes "关键词也许是实战任务中发生的事件。";
			mes "我该回去问双胞胎。";
			close;
		}
	}
	// twins daily quest
	if (isbegin_quest(16027) == 1) {
		mes "[Milo River]";
		mes "饼干？双胞胎做的？";
		mes "哦……那些孩子。她们来过食堂，向我要过几样东西。这就是结果吗？";
		next;
		emotion ET_HUK;
		mes "[Milo River]";
		mes "希望她们不是想毒死我……";
		next;
		mes "[Milo River]";
		mes "嘿，我只是开玩笑。别那样看我。";
		mes "看来她们找回了原来的性格。这很好。你做得很棒。";
		next;
		if (countitem(25161) < 1) {
			mes "[Milo River]";
			mes "……顺便问一下，饼干在哪里？";
			mes "没有给我的东西吗？真遗憾！嗯~我也喜欢饼干~";
			close;
		}
		mes "[Milo River]";
		mes "所以别那样看我！！";
		mes "把饼干给我就好！";
		completequest 16027;// Service: Cookies delivery
		delitem 25161,1;// Handmade_cookie2
		close;
	}

	mes "[Milo River]";
	mes "嘿，你！冒险者？";
	mes "怎么了？";
	next;
	switch( select( "给前辈的茶点", "请照顾猫咪", "你不必知道。" ) ) {
	case 1:
		switch( checkquest(16034,PLAYTIME) ) {
		case -1:
			break;
		case 0:
		case 1:
			mes "[Milo River]";
			mes "哟！多亏你的支持，我们的前辈今天一定能享受茶点时间！";
			next;
			mes "[Milo River]";
			mes "糟糕……又来？";
			mes "不用了。我们的前辈不会每顿都吃茶点！一天一次就够了。";
			next;
			mes "[Milo River]";
			mes "不过谢谢你的好意。哈哈！";
			close;
		case 2:
			erasequest 16034;// Sweet cookies once a day
			mes "[Milo River]";
			mes "哇！你又来了！能请你给前辈们拿些点心吗？";
			next;
			break;
		}
		if (isbegin_quest(16032) == 0) {
			mes "[Milo River]";
			mes "我怎么知道你是冒险者？很简单。";
			next;
			mes "[Milo River]";
			mes "陌生人很少来这里。所以像你这样的人会吸引所有人的注意。";
			next;
			mes "[Milo River]";
			mes "这些人在紧急情况下必须迅速返回，所以不能离这里太远。";
			next;
			mes "[Milo River]";
			mes "所以我想请你帮忙……其实是几件事。因为必须在外面完成。";
			next;
			mes "[Milo River]";
			mes "我得喂那些贪吃鬼，非常忙~那么~希望你能帮我~";
			next;
			if (select( "我来做。", "不，我很忙。" ) == 2) {
				emotion ET_HUK;
				mes "[Milo River]";
				mes "哦~你真坏。太遗憾了。";
				mes "所以我们才不该和外人说话。对吧？Charity~";
				next;
				mes "[Milo River]";
				mes "……我可爱又甜美的猫咪去哪儿了……？";
				mes "哦，我好阴郁，好孤独！！冒险者拒绝了我的请求！！";
				close;
			}
			emotion ET_DELIGHT;
			mes "[Milo River]";
			mes "哦，谢谢！冒险者真酷！";
			mes "我想请你拿些点心。";
			next;
			mes "[Milo River]";
			mes "不，不。别那样看我。不是给我的。";
			mes "你知道住在二楼的前辈吗？见过他们吗？";
			next;
			mes "[Milo River]";
			mes "他们每天都享受茶点时间。";
			mes "所以我想准备最好的茶和点心……但在这个偏僻的地方很难找到。";
			next;
			mes "[Milo River]";
			mes "因为要给贪吃鬼做饭，我不能走太远。所以很抱歉一直没能准备美味的东西。";
			next;
			mes "[Milo River]";
			mes "你是走遍世界的冒险者！请给前辈们和我带些美味的东西！";
			next;
			mes "[Milo River]";
			mes "如果食物太贵，可能会给你添麻烦。请带来下列任意一种。";
			next;
			mes "[Milo River]";
			mes "让我看看。^0000CD葡萄草本茶^000000、^0000CD兰花红茶^000000、^0000CD蜂蜜草本茶^000000、^0000CD巧克力慕斯蛋糕^000000……或者^0000CD水果混合^000000。";
			next;
			mes "[Milo River]";
			mes "带来其中一种，前辈们就会很开心。";
			mes "我不是要你全部带来。一种就够了。";
			next;
			mes "[Milo River]";
			mes "是不是自己制作的都没关系。拜托你了~";
			setquest 16032;// Hospitality to senior
			close;
		}
		mes "[Milo River]";
		mes "你带来了什么？我来看看清单。";
		mes "告诉我你带来了什么！";
		next;
		setarray .@item_id[0],12046,12047,12048,12062,12063;
		//.@s = select( "Grape Herb Tea", "Autumn Red Tea", "Honey Herb Tea", "Chocolate Mousse Cake", "Fruits Mix", "I don't have any." ) - 1;
		.@s = select( getitemname(.@item_id[0]), getitemname(.@item_id[1]), getitemname(.@item_id[2]), getitemname(.@item_id[3]), getitemname(.@item_id[4]), "I don't have any." ) - 1;
		if (.@s == 5) {
			mes "[Milo River]";
			mes "嗯，我明白了。虽然你是冒险者，但这些东西并不容易获得，对吧？";
			next;
			mes "[Milo River]";
			mes "这里能找到的只有气味难闻的黄油和枯萎的药草。我没法用它们做出好东西。";
			mes "只是因为我能力不足，哈哈！";
			close;
		}
		if (countitem(.@item_id[.@s]) < 1) {
			mes "[Milo River]";
			mes "好吧！哈哈，谢谢你的好意！";
			next;
			mes "[Milo River]";
			mes "交给我吧！";
			mes "……什么，你一个都没带来？";
			close;
		}
		switch( .@s ) {
		case 0:
			callsub( S_Item, .@item_id[.@s], "cup", "are old raisins" );
		case 1:
			callsub( S_Item, .@item_id[.@s], "cup", "are tea leaves with unpleasant smell" );
		case 2:
			callsub( S_Item, .@item_id[.@s], "cup", "are withered herbs" );
		case 3:
			callsub( S_Item, .@item_id[.@s], "piece", "is butter with an unpleasant smell" );
		case 4:
			callsub( S_Item, .@item_id[.@s], "bowl", "are unripe fruits" );
		}
		end;
	case 2:
		switch( checkquest(16042,PLAYTIME) ) {
		case -1:
			break;
		case 0:
		case 1:
			mes "[Milo River]";
			mes "哦，Charity 出门已经很久了。它把饲料全吃光了！";
			mes "也许散步尽兴后它就会回来。如果它没回来，请再去找找！";
			close;
		case 2:
			erasequest 16042;// Charity temporarily stays
			break;
		}
		switch( isbegin_quest(16044) ) {
		case 0:
			switch( isbegin_quest(16041) ) {
			case 0:	// first time
				mes "[Milo River]";
				mes "嘿，冒险者。你知道我们部队的偶像吗？";
				mes "Aigu？嘿嘿。Aigu 是大家的偶像。";
				next;
				mes "[Milo River]";
				mes "就是一直待在这里的漂亮猫咪！在这段楼梯下的篮子里。";
				next;
				mes "[Milo River]";
				mes "它叫 Charity！有人说它是阿鲁纳佩茨纯种拉赫林短毛猫。其实它只是来到我们这里，和我们一起生活，所以我们不知道它的品种和年龄。";
				next;
				emotion ET_THROB;
				mes "[Milo River]";
				mes "重要的是，Charity 既可爱又讨人喜欢！";
				next;
				mes "[Milo River]";
				mes "顺便说说……Charity 喜欢散步，每天有一半时间在外面闲逛。你看，我早上给了它饲料，现在还没吃完一半。";
				next;
				mes "[Milo River]";
				mes "也许有人在外面喂它……但我想给它吃好的饲料。如果有人给它腐烂的食物……绝不能发生这种事。";
				next;
				mes "[Milo River]";
				mes "它应该不会走太远。你能在艾因贝赫找到 Charity 吗？";
				next;
				mes "[Milo River]";
				mes "这些鳀鱼饼干是 Charity 最喜欢的零食。把饼干放在^0000CD村里各处的长椅上^000000，然后呼唤 Charity。如果它出来了，请把它带回我这里。";
				next;
				mes "[Milo River]";
				mes "如果它没有出来……你可以去别处找它。也许它一时听不见你的声音。这种情况下，把鳀鱼饼干放在长椅上，再次呼唤 Charity。";
				next;
				mes "[Milo River]";
				mes "我得给那些贪吃鬼准备饭菜……你能去把 Charity 带回来吗？";
				next;
				if (select( "答应。", "拒绝。" ) == 2) {
					mes "[Milo River]";
					mes "Charity……你回来得太晚了。希望你没出什么事。";
					mes "我相信人们会阻止它冲向开往矿井的火车。对吧？";
					next;
					mes "[Milo River]";
					mes "嘿！请答应我。对吧？像你这样的人会保护它，对吧？";
					close;
				}
				mes "[Milo River]";
				mes "谢谢！我会给你足够的鳀鱼饼干。";
				mes "这些是给猫的。交给 Charity 后把剩下的带回来。别吃掉它们。";
				getitem 25162,1;	// Anchovy_cookie
				setquest 16041;// Investigation: Capture strolling cat operation
				close;
			case 1:
				if (countitem(25162) < 1) {
					mes "[Milo River]";
					mes "哎呀？你空手回来了。你的鳀鱼饼干呢？已经用完了吗？";
					next;
					emotion ET_SWEAT;
					mes "[Milo River]";
					mes "……别告诉我你全吃了。";
					mes "我没想到你真的会吃。你吃了吗？";
					next;
					mes "[Milo River]";
					mes "哦，我开玩笑的。是 Charity 偷走了吗？她动作很快，做得到。";
					next;
					mes "[Milo River]";
					mes "总之，我再给你鳀鱼饼干。请保管好。这次要带着 Charity 和鳀鱼饼干回来！";
					getitem 25162,1;	// Anchovy_cookie
					close;
				}
				mes "[Milo River]";
				mes "找到 Charity 了吗？如果她不出现，就在同一个地方多叫几次。";
				mes "谁知道呢？你是陌生人，她可能害怕你。Charity 是聪明的猫，向她证明你没有恶意。";
				close;
			case 2:	// daily
				switch( isbegin_quest(16043) ) {
				case 0:
					mes "[Milo River]";
					mes "嗯……Charity 出去有一阵子了……";
					mes "但还没到需要担心的程度。";
					next;
					emotion ET_HUK;
					mes "[Milo River]";
					mes "说实话！！我想见 Charity！！我想摸她！！我太想她了！";
					next;
					mes "[Milo River]";
					mes "……所以，我再给你鳀鱼饼干。请找到 Charity。";
					mes "把它们放在艾因贝赫的^0000CD村庄长椅^000000上并呼叫 Charity。你愿意帮我吗？";
					next;
					if (select( "帮助他。", "不帮助他。" ) == 2) {
						mes "[Milo River]";
						mes "Charity……Charity……";
						mes "啊……Charity……希望墓碑上写着我因太想念 Charity 而死……";
						next;
						mes "[Milo River]";
						mes "拜托了，冒险者……你会把它写上去吗？请答应我……";
						close;
					}
					mes "[Milo River]";
					mes "谢谢！请去把她找回来。";
					mes "哦……我正在经历戒断症状……Charity……我得尽快摸到她才能恢复……";
					next;
					mes "[Milo River]";
					mes "用鳀鱼饼干找到 Charity，并把剩下的带回来！";
					mes "别吃掉它们。明白了吗？";
					getitem 25162,1;// Crispy Anchovy
					setquest 16043;// Investigation: Capture someone's craving operation
					close;
				case 1:
					if (countitem(25162) < 1) {
						mes "[Milo River]";
						mes "哎呀？你空手回来了。你的鳀鱼饼干呢？已经用完了吗？";
						next;
						emotion ET_HUK;
						mes "[Milo River]";
						mes "……别告诉我你全吃了。";
						mes "我没想到你真的会吃。你吃了吗？";
						next;
						mes "[Milo River]";
						mes "哦，我开玩笑的。是 Charity 偷走了吗？呼，她动作太快了……";
						next;
						mes "[Milo River]";
						mes "总之，我再给你鳀鱼饼干。请保管好。这次要带着 Charity 和鳀鱼饼干回来！";
						getitem 25162,1;// Crispy Anchovy
						close;
					}
					mes "[Milo River]";
						mes "找到 Charity 了吗？如果她不出现，就在同一个地方多叫几次。";
					close;
				case 2:
					end;
				}
			}
		case 1:
			cloakoffnpcself( "Charity#16.2rm" );
			mes "[Charity]";
		mes "喵~";
			if (isbegin_quest(16041) == 1) {// daily
				cloakoffnpcself( "Morana Rudel#16.2rm" );
				npctalk "Miss Charity! She's ruturned!", "Morana Rudel#16.2rm", bc_self;
				sleep2 1000;
				cloakoffnpcself( "Nice Looking Gun#16.2rm" );
				npctalk "Charity 小姐！你一如既往地美丽！", "Nice Looking Gun#16.2rm", bc_self;
				sleep2 1000;
				npctalk "Charity 小姐！我爱你！！！", "Morana Rudel#16.2rm", bc_self;
				next;
				mes "[Milo River]";
				mes "哦……！！";
				mes "Charity！你没事真是太好了！看看她柔软的毛！Charity！！";
				next;
				sleep2 500;
				npctalk "Miss Charity looked at me!", "Nice Looking Gun#16.2rm", bc_self;
				sleep2 1000;
				npctalk "不，笨蛋！她一定是在看水！", "Morana Rudel#16.2rm", bc_self;
				sleep2 1000;
				npctalk "不！她确实用那双明亮闪耀的眼睛看着我！", "Nice Looking Gun#16.2rm", bc_self;
				mes "[" + strcharinfo(0) + "]";
				mes "明明是我把她带来的，他却好像不在乎我……";
				next;
				emotion ET_BIGTHROB;
				mes "[Milo River]";
				mes "Charity 小姐！被这个灰头土脸的冒险者带来后一定累了……要先准备洗澡水？还是先准备饭？或者……我能先摸摸你吗？！";
				npctalk "住手！我要摸摸她！！", "Nice Looking Gun#16.2rm", bc_self;
				sleep2 1000;
				npctalk "让我摸摸 Charity……哦，我再也忍不住了！", "Morana Rudel#16.2rm", bc_self;
				next;
				mes "[" + strcharinfo(0) + "]";
				mes "他们是故意这样做的吗？";
				sleep2 1000;

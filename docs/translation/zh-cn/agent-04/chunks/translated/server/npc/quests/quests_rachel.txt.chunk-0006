OnTouch_:
	if (rach_vice == 23) {
		mes "[" + strcharinfo(0) + "]";
		mes "看着这个";
		mes "泉水让我想起";
		mes "布鲁斯佩蒂。她到底发生了什么？";
		mes "我感觉她";
		mes "陷入了绝望。";
		mes "";
		next;
		mes "["+ strcharinfo(0) +"]";
		mes "水不算";
		mes "冷，也不深……";
		mes "卡廷修尔提到";
		mes "她的身体变得无力……";
		mes "但她还在看着他。";
		mes "真令人难忘……";
		next;
		mes "["+ strcharinfo(0) +"]";
		mes "我想她很痛苦……";
		mes "她爱他，却无法";
		mes "承受他的秘密。";
		mes "最后，一切都很悲惨。";
		mes "卡廷修尔并不是坏人……";
		mes "";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "他被迫";
		mes "犯下滔天罪行，";
		mes "不断犯错，";
		mes "逃避内疚。谁该为此负责？";
		mes "";
		mes "谁该受到责备？";
		next;
		set rach_vice,24;
		completequest 8122;
		if (checkre(3)) {
			if (BaseLevel > 90) getexp 130000,0;
			else if (BaseLevel > 75) getexp 85000,0;
			else getexp 45000,0;
		} else {
			if (BaseLevel > 90) getexp 1300000,0;
			else if (BaseLevel > 75) getexp 850000,0;
			else getexp 450000,0;
		}
		mes "[" + strcharinfo(0) + "]";
		mes "不知为何，我希望";
		mes "卡廷修尔有勇气面对内疚，";
		mes "面对内疚的勇气，";
		mes "然后";
		mes "";
		close;
	}
	else if (rach_vice == 22) {
		mes "[" + strcharinfo(0) + "]";
		mes "这里一定是";
		mes "布鲁斯佩蒂溺水的地方……";
		next;
		mes "[奶奶]";
		mes "哦！打扰了，";
		mes "年轻的冒险者，";
		mes "你不能站在";
		mes "那里！太滑了。";
		mes "如果掉进泉水呢？";
		mes "很危险。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "哦……呃，谢谢。";
		mes "是的，我也不想";
		mes "溺水。";
		next;
		set rach_vice,23;
		mes "[奶奶]";
		mes "溺水……？我只是";
		mes "不想让你";
		mes "衣服弄湿。";
		mes "水并不深……";
		mes "即使不会游泳，也能";
		mes "爬出来。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "……什么？";
		close;
	}
	else if (rach_vice == 8) {
		mes "[" + strcharinfo(0) + "]";
		mes "那个老太太告诉我";
		mes "要小心不要";
		mes "在这里滑倒掉进水里，";
		mes "所以我最好小心脚下。";
		close;
	}
	else if (rach_vice == 7) {
		mes "[???]";
		mes "哦，要非常小心！";
		mes "你可别离水太近。";
		mes "要是滑倒了怎么办？";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "Huh?";
		next;
		mes "[奶奶]";
		mes "哦，抱歉吓到你了，";
		mes "但你脚下的地面";
		mes "非常滑，你知道吗？";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "啊，我明白了。";
		set rach_vice,8;
		changequest 8111,8112;
		close;
	}
	end;
}

ra_in01,255,25,0	script	Book#ra_in	111,{
	if (rach_vice == 15) {
		mes "^3355FF这里就是你找到";
		mes "布鲁斯佩蒂日记的地方。";
		mes "下次和卡廷修尔交谈时，";
		mes "也许你应该把它带上。^000000";
		close;
	}
	else if (rach_vice == 14) {
		set rach_vice,15;
		changequest 8118,8119;
		getitem 7571,1; //Diary_Of_Blue
		mes "^3355FF这一定是布鲁斯佩蒂的";
		mes "日记！现在你可以把它带走，";
		mes "以便查明她和卡廷修尔";
		mes "之间是否有关联……^000000";
		close;
	}
	else if ((rach_vice == 9) || (rach_vice == 10)) {
		mes "^3355FF这一定是布鲁斯佩蒂的";
		mes "日记！但是……读它会让你";
		mes "感觉自己像个变态。";
		mes "所以别碰它。^000000";
		set rach_vice,10;
		changequest 8113,8114;
		close;
	}

}

// Ice Necklace/Summon Ktullanux Quest and Glacial Heart buyer :: rachel_tre
//============================================================ 
//iRO Changed this NPC to avoid "offending" people.
//To enable how it originally looked, uncomment the
//line below (npc header), and comment the line
//under it, and then uncomment the cutin lines.

//rachel,157,183,3	script	Sincere Follower Urstia	917,{
rachel,157,183,3	script	Sincere Follower Urstia	916,{
	cutin "ra_usti1",2;
	if (checkweight(908,200) == 0) {
		mes "^3355FF等一下！";
		mes "你现在携带的物品太多了。";
		mes "请使用卡普拉服务存放";
		mes "一部分物品后再回来。^000000";
	}
	if (ice_necklace_q < 1) {
		mes "[乌斯蒂娅]";
		mes "哦，你是来自外界的冒险者吗？";
		mes "赞美芙蕾雅！她的爱与恩典";
		mes "遍及全世界，甚至触动";
		mes "外国人的心，引导他们来到这里！";
		next;
		if (select("芙蕾雅？我想了解更多。:胡说八道！") == 1) {
			emotion ET_OK;
			mes "[乌斯蒂娅]";
			mes "芙蕾雅复活的日子即将到来，";
			mes "她会带领所有信徒前往";
			mes "英灵殿。现在她正在沉睡，";
			mes "但即使如此，她仍守护着我们。";
			next;
			mes "[乌斯蒂娅]";
			mes "你看，芙蕾雅在千年战争中";
			mes "与最可怕的恶魔战斗，";
			mes "耗尽了全部力量。";
			mes "现在她在纯洁神圣的地方";
			mes "休息并恢复力量。";
			next;
			mes "["+strcharinfo(0)+"]";
			mes "等等……";
			mes "你怎么知道";
			mes "这些事情都发生过？";
			next;
			mes "[乌斯蒂娅]";
			mes "这是所有芙蕾雅信徒都知道的真相。";
			mes "芙蕾雅通过她在人间的容器";
			mes "向我们传达消息，";
			mes "那就是散发耀眼白光的";
			mes "美丽教皇。";
			next;
			mes "[乌斯蒂娅]";
			mes "不幸的是，即使最虔诚的人";
			mes "也会判断失误。承认我的儿子";
			mes "埃加佩奥……犯了罪，";
			mes "让我感到羞愧。";
			next;
			mes "["+strcharinfo(0)+"]";
			mes "罪？如果不介意的话，";
			mes "他做了什么？";
			next;
			mes "[乌斯蒂娅]";
			mes "我不知道，但埃加佩奥";
			mes "已经病了一段时间。";
			mes "我确信他做了什么事，惹怒了芙蕾雅。";
			mes "虽然他或许罪有应得，";
			mes "但我仍在尽力帮助他。";
			next;
			mes "["+strcharinfo(0)+"]";
			mes "……等等，什么？！";
			next;
			mes "[乌斯蒂娅]";
			mes "我知道只要虔诚祈祷，取悦芙蕾雅，";
			mes "她就会原谅我的儿子，治好他的病。";
			mes "但有时祈祷还不够……";
			mes "我需要献上贡品。";
			next;
			mes "[乌斯蒂娅]";
			mes "我从矮人那里得到了一条";
			mes "无与伦比美丽的项链。";
			mes "不过宝石因年久而失去光泽，";
			mes "在献给芙蕾雅之前必须擦亮。";
			next;
			mes "[乌斯蒂娅]";
			mes "不过，不是谁都能擦亮这条";
			mes "矮人打造的特殊项链。";
			mes "我需要懂得奥术魔法的人帮忙。";
			mes "我想只有一位法师能擦亮它……";
			next;
			mes "[乌斯蒂娅]";
			mes "那位能接触世界上最强大魔法";
			mes "的著名法师马赫奥，";
			mes "一定能清洁项链上的宝石！";
			mes "可是我根本无法找到他。";
			next;
			mes "[乌斯蒂娅]";
			mes "马赫奥前往北方的冰洞，";
			mes "去讨伐那里的冰雪怪物，";
			mes "至今还没有回来。那里对我来说太危险了。";
			next;
			mes "[乌斯蒂娅]";
			mes "我知道你们冒险者经常穿越";
			mes "那种地方，所以请你找到马赫奥，";
			mes "替我请他清洁这条项链好吗？";
			mes "拜托了，为了我的儿子……";
			next;
			if (select("这不关我的事！:好吧，我来做。") == 1) {
				mes "[乌斯蒂娅]";
				mes "我……我明白了。";
				mes "我以为是芙蕾雅引导你来到我身边，";
				mes "但也许我的祈祷还没有得到回应。";
				mes "或许我需要更加虔诚地祈祷？";
				close2;
				cutin "",255;
				end;
			}
			mes "[乌斯蒂娅]";
			mes "太谢谢你了！";
			mes "请保管好这条项链，拜托马赫奥";
			mes "恢复它的光泽。这样它就能成为";
			mes "献给我们慈爱女神芙蕾雅的合适贡品。";
			setquest 2109;
			getitem 7572,1; //Magic_Necklace
			set ice_necklace_q,1;
			close2;
			cutin "",255;
			end;
		}
		cutin "ra_usti2",2;
		mes "[乌斯蒂娅]";
		mes "...............................";
		mes "你是说你不相信吗？";
		mes "忏悔吧，愿你的心向芙蕾雅敞开！";
	}
	else if ((ice_necklace_q >= 1) && (ice_necklace_q < 5)) {
		mes "[乌斯蒂娅]";
		mes "请找到法师马赫奥，拜托他恢复";
		mes "我交给你的项链的美丽。";
		mes "他应该正在北方的冰洞";
		mes "与怪物战斗。";
	}
	else if (ice_necklace_q == 5) {
		if (countitem(7573) > 0) {
			mes "[乌斯蒂娅]";
			mes "哦！我的项链！谢谢你！";
			mes "它真漂亮！一定能成为献给芙蕾雅的";
			mes "绝佳贡品！我相信有了它，";
			mes "我的儿子一定会好起来！";
			next;
			mes "[乌斯蒂娅]";
			mes "来，我知道这不算什么，";
			mes "但请收下它，作为我对";
			mes "你为我所做一切的感谢。";
			delitem 7573,1; //Magic_Necklace_
			getexp (checkre(3))?90000:700000,0;
			set ice_necklace_q,6;
			completequest 2113;
			next;
			mes "["+strcharinfo(0)+"]";
			mes "哦，就说这对我来说";
			mes "是一次值得的经历吧。";
			next;
			mes "[乌斯蒂娅]";
			mes ".........";
			mes "............";
			mes "愿芙蕾雅永远保护并指引你，";
			mes "也原谅你那个可怕的玩笑。";
		}
		else {
			mes "["+strcharinfo(0)+"]";
			mes "哦，不！项链不见了！";
		}
	}
	else {
		mes "[乌斯蒂娅]";
		mes "愿芙蕾雅永远以无尽的";
		mes "恩典与智慧";
		mes "保护并指引你……";
	}
	close2;
	cutin "",255;
	end;
}

ice_dun02,120,105,3	script	Man Stuck in Ice#cave	924,5,5,{
	if (checkweight(908,200) == 0) {
		mes "^3355FF等一下！";
		mes "你现在携带的物品太多了。";
		mes "请使用卡普拉服务存放";
		mes "一部分物品后再回来。^000000";
		close;
	}
	if (ice_necklace_q == 1) {
		cutin "ra_magic3",2;
		emotion ET_HUK;
		mes "[困在冰里的男人]";
		mes "你、你好？";
		mes "嘿！嘿，你！";
		mes "帮我打破这块冰！";
		mes "我得离开这里！";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "你怎么会被困在里面的？";
		next;
		mes "[困在冰里的男人]";
		mes "我之后会解释一切！现在……";
		mes "先把我身上的冰弄掉！";
		next;
		if (getskilllv("MG_FIREBOLT") > 0) {
			specialeffect EF_FIREBALL;
			mes "^3355FF你对冰块施放了火箭术。^000000";
		}
		else {
			specialeffect EF_HIT2;
			mes "^3355FF你使出全力敲打冰块。^000000";
		}
		next;
		mes "["+strcharinfo(0)+"]";
		mes "......";
		mes "........";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "我不行……";
		mes "我甚至无法在上面留下划痕。";
		mes "你有什么主意吗？";
		next;
		emotion ET_CRY;
		mes "[困在冰里的男人]";
		mes "太丢脸了……";
		mes "我，时代最伟大的法师马赫奥，";
		mes "竟然被困在这根冰柱里。";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "等等……";
		mes "你就是马赫奥？";
		next;
		cutin "ra_magic1",2;
		emotion ET_KIK;
		mes "[马赫奥]";
		mes "没错。你正在和马赫奥，";
		mes "最伟大的法师、奥术魔法大师交谈。";
		mes "就连大法师穷尽一生也无法学会的";
		mes "魔法，我都知道！";
		next;
		cutin "ra_magic4",2;
		mes "[马赫奥]";
		mes "尽管我很伟大，但我是个谦逊的人。";
		mes "你看？所以我总是穿着这身法师制服……";
		mes "提醒自己谦逊的价值。";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "那你怎么会被困在";
		mes "这么多冰里？";
		next;
		cutin "ra_magic3",2;
		mes "[马赫奥]";
		mes "其实，这是因为我太谦逊了。";
		mes "你看，我低估了自己，";
		mes "也低估了自己魔法的毁灭性力量。";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "……啊？";
		next;
		mes "[马赫奥]";
		mes "是的，如果我不是这么谦逊，";
		mes "这种事就不会发生……谦逊又善良。";
		mes "事情起源于我想到这座洞穴，";
		mes "以及人们有时会来这里取冰。";
		next;
		mes "[马赫奥]";
		mes "于是我决定为了人民的利益";
		mes "消灭这些邪恶的怪物！";
		mes "市民们会感到受到保护，";
		mes "而我也会被认可为英雄！";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "好吧……我想这听起来";
		mes "还算正常。继续说。";
		next;
		mes "[马赫奥]";
		mes "我英勇地与雪怪战斗。";
		mes "它们根本不是我的魔法的对手！";
		mes "所以我决定用一次魔法施放";
		mes "就把它们全部消灭。";
		next;
		mes "[马赫奥]";
		mes "你知道陨石术吗？";
		mes "我还知道另一个类似的法术……";
		mes "";
		mes "";

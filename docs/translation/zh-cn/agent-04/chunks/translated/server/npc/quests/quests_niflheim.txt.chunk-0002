		mes "我明白了……";
		mes "……等等！那不是";
		mes "我妻子艾莉的吗？你为什么";
		mes "要欺骗悲伤的人……？";
		close;
	}
	end;
}

umbala,215,181,3	script	Billik	733,{
	if (nif_revive > 1 || (MISC_QUEST & 16384)) {
		mes "[比利克]";
		mes "好久不见。";
		mes "以后有机会的话，";
		mes "我们在";
		mes "死者之城再见。";
		mes "哈哈哈哈～";
		emotion ET_BEST;
		close;
	}
	if (nif_revive == 1) {
		mes "[比利克]";
		mes "死者之城……";
		mes "那是非常危险的地方。";
		mes "你为什么想去？";
		next;
		if (select("我必须在那里见一个人。:这是我冒险的一部分。") == 1) {
			mes "[比利克]";
			mes "那里有你必须见的人……";
			mes "嗯……我想你希望";
			mes "联系死者……";
			mes "我也看得出你";
			mes "决心要去。";
			next;
			mes "[比利克]";
			mes "*叹气* 好吧，如果你真的想去，";
			mes "你必须找一个叫";
			mes "“费林”的人。务必告诉他";
			mes "是我介绍你来的，";
			mes "";
			next;
			mes "[比利克]";
			mes "他不太信任人，但很喜欢玫瑰，";
			mes "所以带一朵玫瑰给他。这样他";
			mes "这样他就知道确实是我派你来的。";
			mes "一定要告诉他。";
			set nif_revive,2;
			changequest 11038,11039;
			next;
			mes "[比利克]";
			mes "死者之城位于这里";
			mes "的北方。记住，那里很危险，";
			mes "即使是经验丰富的";
			mes "冒险者也一样，所以……";
			mes "";
			mes "小心。";
			close;
		}
		mes "[比利克]";
		mes "哈哈哈～我想你和我一样喜欢冒险。";
		mes "虽然那里很危险，但到达后会";
		mes "得到努力的回报。小心。";
		mes "";
		mes "";
		close;
	}
	else if (nif_revive == 0) {
		mes "[比利克]";
		mes "你来这里做什么？我很忙，";
		mes "没事就离开。";
		close;
	}
}

niflheim,153,215,3	script	Feylin	794,{
	if (nif_revive == 2) {
		mes "[费林]";
		mes "可怜的"+((Sex == SEX_MALE)?"家伙":"姑娘")+"……";
		mes "这么年轻就死了……";
		mes "看到年轻人";
		mes "死去，我总是很难过。";
		next;
		mes "[费林]";
		mes "............??";
		mes "哦，你还没死，";
		mes "对吧？难以置信，在这个城镇";
		mes "看到另一个活人";
		mes "";
		next;
		mes "[费林]";
		mes "你是来救人，";
		mes "还是有其他目的？";
		mes "如果你来这里见";
		mes "已故朋友，你找错人了。";
		mes "";
		next;
		mes "[费林]";
		mes "尼夫海姆没人能";
		mes "施展那种奇迹……";
		next;
		mes "[费林]";
		mes "我看得出你经历了许多苦难，";
		mes "但很遗憾，你来这里是白费力气。";
		mes "希望你在为时未晚前，";
		mes "回到你来的地方。";
		mes "请不要再逗留。";
		set nif_revive,3;
		changequest 11039,11040;
		close;
	}
	else if (nif_revive == 3) {
		mes "[费林]";
		mes "我已经请你立刻离开这座城镇。";
		mes "很抱歉，但你询问的事情我一无所知。";
		mes "请不要再追问。";
		mes "现在就离开吧。";
		emotion ET_FRET;
		next;
		if (select("但是……:对不起。") == 1) {
			mes "[费林]";
			mes "你一定知道些什么……";
			mes "否则不会如此固执。";
			mes "我不知道是谁告诉你，";
			mes "联系死者可能办得到……";
			mes "但那是不可能的。";
			next;
			mes "[费林]";
			mes "但我肯定没有告诉过你。";
			mes "而且，谈论这种事情是禁忌。";
			mes "请不要再提了。";
			set nif_revive,4;
			changequest 11040,11041;
			close;
		}
		mes "[费林]";
		mes "请考虑尽快离开这里。";
		mes "任何人都不该在尼夫海姆逗留太久。";
		mes "这里非常危险。";
		mes "请尽快离开。";
		close;
	}
	else if (nif_revive == 4) {
		if (countitem(748) > 0) {
			mes "[费林]";
			mes "嗯，一定是 Billik 派你来的。";
			mes "既然我欠他人情，";
			mes "我想我会帮助你。";
			mes "不过先警告你。";
			mes "我要求的代价可能会";
			mes "超出你的预期……";
			next;
			if (select("我愿意这么做。:我不认为自己做得到。") == 1) {
				if (BaseLevel > 79) {
					mes "[费林]";
					mes "好吧，但你必须答应我，";
					mes "不能让其他人知道我要告诉你的事。";
					mes "这是秘密。";
					mes "你能保证吗？";
					next;
					mes "[费林]";
					mes "这种法术需要巨大的牺牲。";
					mes "不用说，法术也有失败的可能。";
					mes "此外，我还需要 10 片世界树叶来施法。";
					mes "你还要继续吗？";
					mes "请慎重考虑。";
					mes "失败可能会带来严重后果。";
					next;
					if (select("是:否") == 1) {
						if (countitem(610) > 9) {
							mes "[费林]";
							mes "我明白了。那么我们开始。";
							mes "Woombahsokasabahah!";
							mes "Woombah woombah hoombabah!";
							mes "Yeeeeep!";
							next;
							set .@nif_revive1,rand(1,100);
							if (.@nif_revive1 > 0) && (.@nif_revive1 < 88) {
								mes "[费林]";
								mes "……对不起。";
								mes "我没能召唤出你想见的人。";
								mes "对于这个结果，我真的很抱歉。";
								mes "请你节哀。";
								emotion ET_HUK;
								delitem 748,1; //Witherless_Rose
								delitem 610,10; //Leaf_Of_Yggdrasil
								set nif_revive,5;
								changequest 11041,11042;
								percentheal -99,0;
								next;
								mes "[费林]";
								mes "很遗憾，可能无法召唤出";
								mes "你想交谈的那个人的灵魂……";
								mes "请再等一会儿。";
								mes "也许还有机会。";
								close;
							}
							else if (.@nif_revive1 > 87) && (.@nif_revive1 < 101) {
								delitem 748,1; //Witherless_Rose
								delitem 610,10; //Leaf_Of_Yggdrasil
								percentheal -50,0;
								mes "[费林]";
								mes "..........";
								mes "..........";
								next;
								mes "[Elly]";
								mes "..........";
								mes "……嗯……";
								mes "……我刚才不是已经死了吗？";
								mes "嗯，我认识你吗？";
								next;
								select("我带来了你丈夫的消息。");
								mes "[Elly]";
								mes "哦……我明白了……很遗憾，我死前没能见到他……";
								mes "那么他要给我什么消息？";
								next;
								select("原谅他一个月前做的事。");
								mes "[Elly]";
								mes "*叹气* 他真是个好丈夫……";
								mes "他总是如此细心，连小事也不忽略。";
								mes "不过，应该道歉的人是我……";
								mes "我不该让他独自承受。";
								mes "真的很对不起……";
								next;
								mes "[Elly]";
								mes "请把这个盒子交给他，告诉他忘了我吧。";
								mes "他应该和另一个人幸福地度过余生。";
								mes "还有，请告诉他我原谅他了。";
								mes "希望他能重新开始。";
								mes "请一定把话带到。";
								set nif_revive,6;
								changequest 11040,11043;
								getitem 934,1; //Mementos
								next;
								mes "[Elly]";
								mes "我很高兴还能再听到丈夫的消息。";
								mes "不过，我想我该走了。";
								mes "谢谢你费心。";
								mes "永别了……";
								mes "请替我保重。";
								next;
								mes "[Elly]";
								mes ".....................";
								mes "....................";
								next;
								mes "[费林]";
								mes "我想你已经完成了想做的事。";
								mes "那么，回去时请小心……";
								mes "愿你一路平安。";
								close;
							}
						}
						else {
							mes "[费林]";
							mes "如果你没有这些物品，我们就无法继续。";
							mes "记住，我需要 10 片世界树叶来施展法术。";
							mes "请尽快把它们带来。";
							mes "不要再耽搁了。";
							mes "准备好后再来找我。";
							mes "否则无法进行召唤。";
							close;
						}
					}
					mes "[费林]";
					mes "我希望你先把物品带来。";
					mes "但是……我没有把握保证法术会成功。";
					mes "失败的风险依然存在。";
					mes "请做好心理准备。";
					close;
				}
				mes "[费林]";
				mes "嗯……你似乎没有承受施法的力量。";
				mes "以你目前的实力，这个法术会杀死你。";
				mes "我不能冒这个风险。";
				mes "请提升实力后再来。";
				mes "现在还不行。";
				mes "请不要勉强。";
				close;
			}
			mes "[费林]";
			mes "你做了正确的决定。";
			mes "考虑到其中的风险，";
			mes "本来就不该轻易施展这种法术……";
			mes "请不要再尝试了。";
			mes "回去吧。";
			close;
		}
		mes "[费林]";
		mes "不管你问我多少次，我都帮不了你。";
		mes "请尽快离开这里。";
		mes "不要再回来了。";
		close;
	}
	mes "[费林]";
	mes "是什么让你来到这样危险的城镇？";
	mes "请尽快离开这里。";
	mes "现在就走吧。";
	close;
}

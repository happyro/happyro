					mes "真的非常感谢！";
					mes "你的帮助会大大推进我的研究，";
					mes "我保证会尽快回报你！";
					
					
					delitem 7515, .@input; //Marvelous_Medal
					ein_medal01 += .@input;
					close;
				}
			case 3:
				mes "[艾菲尔]";

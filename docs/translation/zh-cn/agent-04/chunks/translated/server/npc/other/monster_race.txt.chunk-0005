				while(1) {
					input .@input;
					if (!.@input) {
						mes "[艾菲尔]";
						mes "啊，你决定取消了吗？";
						mes "这是你的选择，";
						mes "但我还是很失望。改变主意后";
						mes "请再回来吧……";
						
						close;
					} else if (.@input < 1 || .@input > 100) {
						mes "[艾菲尔]";
						mes "记住，你只能输入 1 到 100。";
						mes "如果你想给我更多奖牌，";
						mes "也许应该全部给我～";
						
						
						next;
					} else break;
				}
				if (countitem("Marvelous_Medal") < .@input) {
					mes "[艾菲尔]";
					mes "抱歉，我不认为你身上有这么多";
					mes "奖牌。请确认你提供的数量";
					mes "确实是你拥有的奖牌。";
					
					
					emotion ET_SMILE;
					close;
				} else {
					mes "[艾菲尔]";

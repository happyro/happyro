		while( select("我在市场买的。:我偷的。:我见过 Etran 大人。") != 3) {
			cutin "EP14_robert5",1;
			mes "[Robert]";
			mes "你可以骗别人，但骗不了我。直说吧，这条项链从哪里来的？";
			next;
		}
		cutin "",255;
		mes "["+ strcharinfo(0) +"]";
		mes "如你所知，这是 Etran 大人的项链。";
		next;
		mes "["+ strcharinfo(0) +"]";
		mes "Etran 大人似乎精疲力尽。所以我让他看到了自己工作的未来。";
		next;
		cutin "EP14_robert3",1;
		mes "[Robert]";
		mes "......";
		next;
		cutin "",255;
		mes "["+ strcharinfo(0) +"]";
		mes "他不知道自己的工作成功还是失败，但看到充满生机的彩虹桥后，他找到了继续的力量。";
		next;
		cutin "EP14_robert3",1;
		mes "[Robert]";
		mes "我明白了。原来是这样。";
		next;
		cutin "",255;
		mes "["+ strcharinfo(0) +"]";
		mes "Etran 大人让我把项链交给你。是为了让你知道，他永远不会放弃所见的彩虹桥未来。";
		next;
		mes "["+ strcharinfo(0) +"]";
		mes "只是……他担心你的情况。尤其是他无法看到你的家园树是否顺利成长。";
		next;
		cutin "EP14_robert3",1;
		mes "[Robert]";
		mes "没办法。注入生命力的人不能离开那里。";
		next;
		select("能得到一片家园树叶吗？");
		cutin "EP14_robert4",1;
		mes "[Robert]";
		mes "啊，你想把我家园树的叶子给 Etran 看。你问了个显而易见的问题……";
		next;
		cutin "EP14_robert2",1;
		mes "[Robert]";
		mes "事实上，我的家园树刚长出第一片叶子。它非常巨大而壮丽。给我一点时间。";
		cutin "",255;
		ep14_2_etran = 37;
	}
	else if (ep14_2_etran == 37)
		mes "^000099Robert 还没有反应。他一定还在获取家园树叶的过程中。^000000";
	else if (ep14_2_etran == 38) {
		disable_items;
		cutin "EP14_robert2",1;
		mes "[Robert]";
		mes "让你久等了。";
		next;
		mes "[Robert]";
		mes "拿着这片家园树叶。这是我亲自取得的叶子，不会影响家园树太多。";
		next;
		cutin "EP14_robert4",1;
		mes "[Robert]";
		mes "至于你之前给我的项链，我很理解 Etran 的心意，所以你可以把它还给他。";
		next;
		mes "[Robert]";
		mes "收到那个孩子的项链，我怎么可能心安。我知道这可能很麻烦，但请还给他。";
		next;
		cutin "EP14_robert2",1;
		mes "[Robert]";
		mes "对了，请告诉他我的话。就像你信任我一样，^000099我也信任你^000000。^000000";
		next;
		cutin "EP14_robert01",1;
		mes "[Robert]";
		mes "还有，无论走到哪里都不要哭……等等，这句收回。";
		next;
		cutin "",255;
		mes "^000099说完，Robert 回到了反应堆。我手里拿着 Robert 的家园树叶和 Etran 的项链。^000000";
		next;
		changequest 12299,12300;
		ep14_2_etran = 39;
		getitem 6540,1;// Golden_Leaf
		getexp 120000,80000;
		mes "^000099金色叶子的能量让我的身心焕然一新。获得基础经验和职业经验。^000000";
	}
	else if (ep14_2_etran < 43)
		mes "^000099裂隙反应堆就在这里。我想现在还用不上。^000000";
	else if (ep14_2_etran == 43) {
		mes "^000099现在可以用裂隙反应堆查看过去、现在或其他维度。有需要时再来看看吧。^000000";
		erasequest 12301;
		ep14_2_etran = 44;
	}
	else if (ep14_2_etran > 43) {
		switch(rand(1,15)) {
		case 1:
			mes "[???]";
			mes "像你这样不懂爱的力量的人真是贫乏！！";
			next;
			mes "^000099我已经很久没有这种感觉了。确实……这台机器让我心烦。^000000";
			close;
		case 2:
			mes "[???]";
			mes "嘶嘶嘶静电声～～啊！？～～嘶嘶嘶～我的肩膀！！";
			next;
			mes "^000099哦，抱歉。我要离开这个频道。^000000";
			close;
		case 3:
			mes "^000099Etran 的悲伤传说^000000";
			next;
			cutin "EP14_etran1",1;
			mes "[Etran]";
			mes "嘿，Robert，你知道吗？我的悲伤表情……这里有个悲伤传说。";
			next;
			cutin "EP14_robert4",1;
			mes "[Robert]";
			mes "我不相信神话。";
			next;
			cutin "EP14_etran6",1;
			mes "[Etran]";
			mes "画我的那个人。他画出悲伤表情时无法投入其中。";
			next;
			cutin "EP14_robert5",1;
			mes "[Robert]";
			mes "等等！你想说什么？如果你想说对现在很危险的事，就别说了！！";
			next;
			cutin "EP14_etran2",1;
			mes "[Etran]";
			mes "不～为什么不说？这超越时间和空间。除了这里我还能在哪里谈？";
			next;
			cutin "EP14_robert2",1;
			mes "[Robert]";
			mes "嗯，好吧。既然如此，就听完那个故事。那位 L 先生后来怎么样了？";
			next;
			cutin "EP14_etran4",1;
			mes "[Etran]";
			mes "（这家伙提到了他的首字母！好吧，他比我更会把事情弄危险！！）他从仓库取出设备，想看看能否精炼。";
			next;
			cutin "EP14_robert4",1;
			mes "[Robert]";
			mes "所以他把它们弄坏了。";
			next;
			cutin "EP14_etran2",1;
			mes "[Etran]";
			mes "他确实弄坏了……";
			next;
			cutin "EP14_robert4",1;
			mes "[Robert]";
			mes "呵呵呵……";
			next;
			cutin "EP14_etran6",1;
			mes "[Etran]";
			mes "他当时的表情就是这个。很悲伤，对吧？";
			next;
			cutin "EP14_robert1",1;
			mes "[Robert]";
			mes "抱歉，我笑了。";
			break;
		case 4:
			mes "^000099如果 Etran 和 Robert 是囚犯与守卫呢？^000000";
			next;
			cutin "EP14_etran1",1;
			mes "[Etran]";
			mes "嘿，守卫～我觉得这里湿气太重了。我的皮肤要坏掉了。没关系吗？嗯？";
			next;
			cutin "EP14_robert4",1;
			mes "[Robert]";
			mes "洗脸。";
			next;
			cutin "EP14_etran5",1;
			mes "[Etran]";
			mes "Oh...";
			break;
		case 5:
			mes "^000099Etran 和 Robert 被安排做猫商人。^000000";
			next;
			cutin "EP14_etran1",1;
			mes "[Etran]";
			mes "欢迎欢迎喵～！我们是猫商人，一直像侍奉国王一样服务客人喵～！特价！一块肉 200 Zeny！！";
			next;
			cutin "EP14_robert1",1;
			mes "[Robert]";
			mes "......";
			next;
			cutin "EP14_etran1",1;
			mes "[Etran]";
			mes "现在购买还会赠送 3 个罐头喵！！多买些喵！！！";
			next;
			cutin "EP14_robert1",1;
			mes "[Robert]";
			mes "......";
			next;
			cutin "EP14_etran3",1;
			mes "[Etran]";
			mes "（嘿，Robert！别只站在那里学猫！你要是一直不动，我们会被赶出去的！）";
			next;
			cutin "EP14_robert5",1;
			mes "[Robert]";
			mes "嗷呜……";
			next;
			cutin "EP14_etran5",1;
			mes "[Etran]";
			mes "......";
			next;
			cutin "EP14_robert5",1;
			mes "[Robert]";
			mes "......";
			next;
			cutin "EP14_etran6",1;
			mes "[Etran]";
			mes "狗……？";
			break;
		case 6:
			mes "^000099Etran 和 Robert 被放进了飞行机器。^000000";
			next;
			cutin "EP14_robert5",1;
			mes "[Robert]";
			mes "......";
			next;
			cutin "EP14_etran1",1;
			mes "[Etran]";
			mes "嘿 Robert，你不喜欢这台在空中飞行的机器吗？";
			next;
			cutin "EP14_robert5",1;
			mes "[Robert]";
			mes "......";
			next;
			cutin "EP14_etran5",1;
			mes "[Etran]";
			mes "嗯？你为什么脸色发青？怎么了？";
			next;
			cutin "EP14_robert5",1;
			mes "[Robert]";
			mes "Etran，我在找这里的洗手间。";
			next;
			cutin "EP14_etran5",1;
			mes "[Etran]";
			mes "好，那洗手间怎么样？";
			next;
			cutin "EP14_robert5",1;
			mes "[Robert]";
			mes "这里没有。这里没有洗手间。";
			next;
			cutin "",255;
			mes "^000099我们将在 6 小时后抵达依斯鲁得机场。^000000";
			next;
			cutin "EP14_etran2",1;
			mes "[Etran]";
			mes "哈哈哈，听你说话让我忍不住笑。";
			next;
			cutin "EP14_robert5",1;
			mes "[Robert]";
			mes "呃……";
			next;
			cutin "EP14_etran2",1;
			mes "[Etran]";
			mes "我们就这样去依斯鲁得吧！！！";
			next;
			cutin "EP14_robert2",1;
			mes "[Robert]";
			mes "......";
			break;
		case 7:
			mes "^000099铁人厨师 Robert^000000";
			next;
			cutin "EP14_robert1",1;
			mes "[Robert]";
			mes "我现在要烤派。";
			next;
			cutin "EP14_etran1",1;
			mes "[Etran]";
			mes "真的吗真的吗？";
			mes "你也要加蓝莓吗？我喜欢蓝莓派！";
			next;
			cutin "EP14_robert4",1;
			mes "[Robert]";
			mes "当然。我还要加些树莓和糖浆。";
			next;
			cutin "EP14_etran1",1;
			mes "[Etran]";
			mes "真的吗真的吗？";
			mes "树莓会增添莓果柑橘风味！！我喜欢树莓派！你要烤多少？两个是不是太少了？";
			next;
			cutin "EP14_robert4",1;
			mes "[Robert]";
			mes "我要烤 1 个。你没有份。";
			next;
			cutin "EP14_etran6",1;
			mes "[Etran]";
			mes "嗯？？……";
			break;
		case 8:
			mes "^000099Robert 其实喜欢啤酒。^000000";
			next;
			cutin "EP14_robert1",1;
			mes "[Robert]";
			mes "天啊～我想念人类世界的冰啤酒和烤鸡肉串～";
			next;
			cutin "EP14_etran1",1;
			mes "[Etran]";
			mes "Robert！Robert！你看到这里新开的烤鸡肉串店了吗？今天开业大酬宾！我们去吃吧！";
			next;
			cutin "EP14_robert4",1;
			mes "[Robert]";
			mes "（真的，这里居然卖那个？）";
			mes "你怎么能谈啤酒？Etran，你应该感到羞耻～";
			next;
			cutin "EP14_etran6",1;
			mes "[Etran]";
			mes "嗯……？Robert，你不喜欢啤酒？";
			next;
			cutin "EP14_robert4",1;
			mes "[Robert]";
			mes "那只是人类喝的东西。你去吧。我其实不在乎。";
			next;
			cutin "EP14_etran6",1;
			mes "[Etran]";
			mes "好吧，那就这样。";
			next;
			cutin "EP14_robert1",1;
			mes "[Robert]";
			mes "不过那里有好吃的烤鸡肉串吗？";
			next;
			cutin "EP14_etran1",1;
			mes "[Etran]";
			mes "有！！特别好吃！你要去吗？嗯？";
			next;
			cutin "EP14_robert4",1;
			mes "[Robert]";
			mes "嗯，我也不是特别想吃烤鸡肉串什么的，但是……";
			next;
			cutin "EP14_etran1",1;
			mes "[Etran]";
			mes "好耶！！！！";
			break;
		case 9:
			mes "^000099厨师 Robert^000000";
			next;
			cutin "EP14_robert2",1;
			mes "[Robert]";
			mes "嗯嗯嗯～闻起来真香。";
			next;
			cutin "EP14_robert2",1;
			mes "[Robert]";
			mes "Etran 很快就会回来。那时应该已经做好了。";
			next;
			cutin "EP14_robert4",1;
			mes "[Robert]";
			mes "啊～很好。看看这完美的派，香味也很棒。要不要尝一点？";
			next;
			cutin "EP14_robert2",1;
			mes "[Robert]";
			mes "嗯……不。";
			mes "等 Etran 回家后，我要和他一起吃。";
			next;
			cutin "",255;
			mes "^000099Robert 带着派去了 Etran 的家。^000000";
			next;
			cutin "EP14_etran2",1;
			mes "[Etran's Notice]";
			mes "欢迎来到 Etran 的家！我去彩虹桥给植物浇水了！因为土地很大，至少要两天。礼物可以放在门口。";
			next;
			cutin "EP14_etran2",1;
			mes "[Etran's Notice]";
			mes "哦，我确定不会有人带礼物来。尤其不会有 Robert 带着精心烤好的派来，哈哈哈。";
			next;
			cutin "EP14_robert5",1;
			mes "[Robert]";
			mes "好吧，我没带！天啊，我根本没烤派！！！";
			break;
		case 10:
			mes "^000099童年好友 Etran 和 Robert^000000";
			next;
			cutin "EP14_robert4",1;
			mes "[Robert]";
			mes "嘿，你为什么这样哭？";
			next;
			cutin "EP14_etran7",1;
			mes "[Etran]";
			mes "呜呜……同班的 Dona 嘲笑我的身材，还叫我波旁……";
			next;
			cutin "EP14_robert4",1;
			mes "[Robert]";
			mes "就因为这个？他们叫你波旁，也不代表你这个 Dona 会变成波旁！那些家伙只是想看你哭。别哭了，好吗？";
			next;
			cutin "EP14_etran7",1;
			mes "[Etran]";
			mes "呜……";
			next;
			cutin "EP14_robert3",1;
			mes "[Robert]";
			mes "真是的……你太爱哭了。";
			next;
			cutin "EP14_etran5",1;
			mes "[Etran]";
			mes "真希望我能像你一样冷静又帅气，Robert。";
			next;
			cutin "EP14_robert4",1;
			mes "[Robert]";
			mes "哼，你还早 100 年才能像我这么帅……";
			next;
			cutin "",255;
			mes "^000099那天晚上^000000";
			next;
			cutin "EP14_robert3",1;
			mes "[Robert]";
			mes "^FF0000这里是那些经常嘲笑 Etran 的孩子聚集的地方。要去看看他们是谁吗？^000000";
			next;
			cutin "",255;
			mes "^000099没人知道原因，但据说那些嘲笑 Etran 的拉菲内住院了 4 周。^000000";
			next;
			cutin "EP14_etran1",1;
			mes "[Etran]";
			mes "你不该这样欺负孩子～校园暴力是不可原谅的罪行。朋友应该远离暴力，一起度过快乐时光。";
			break;
		case 11:
			mes "^000099放进沸水～3 分钟～……滋滋声。^000000";
			next;
			mes "^000099在沸水中 3 分钟……之后呢？是说在沸水里 3 分钟就会死吗？要把沸水倒在怪物身上之类的吗？^000000";
			close;
		case 12:
			mes "^000099休斯顿～休斯顿～这里是嘶嘶嘶～我们看到了高塔和树。看来这里也有生命体～静电声～^000000";
			next;
			mes "^000099听到了绝望的声音。不确定“行星”和“生命体”指的是什么。^000000";
			close;
		default:
			mes "^000099静电声太多了。试着调整频率。^000000";
			close;
		}
		close2;
		cutin "",255;
		end;
	}
	else
		mes "^000099工作桌上一片混乱。^000000";
	close;
}

// Laphines That Love The Land (Lost Adventurers)
//============================================================
ecl_fild01,190,93,5	script	Fili#1	4_M_FAIRYANG,1,1,{
	mes "[Fili]";
	if (BaseLevel < 100) {
		mes "看着这片美丽的田野，歌曲自然就唱出来了～";
		emotion ET_DELIGHT;
	}
	else if (ep14_2_nines > 2) {
		mes "鲜花到处盛开，总是如此美丽。";
		emotion ET_DELIGHT;
		next;
			switch( select("开始交谈:热爱大地的拉菲内:询问冒险者") ) {
			mes "[Fili]";
		case 1:
			switch(rand(1,3)) {
			case 1:
				mes "艾可拉治是什么样的？那是个很棒的地方。";
				close;
			case 2:
				mes "如果人们心中充满对花朵和大地的爱，就不会互相憎恨或刀刃相向。";
				close;
			case 3:
				mes "你应该避免进入高塔。那里很危险。不过对于已经进去的人，我们也无能为力。";
				close;
			}
		case 2:
			if (checkquest(13059,PLAYTIME) == 2) {
				mes "感谢你上次所做的一切。大地似乎也心情很好，我能感觉到。能再帮我们一次吗？";
				erasequest 13059;
			}
			else if (checkquest(13059,PLAYTIME) == 0)
				mes "现在大地似乎感觉不错。稍微休息一下就好。";
			else if (isbegin_quest(13050) == 1) {
				if (isbegin_quest(13051) == 1 || isbegin_quest(13052) == 1 || isbegin_quest(13053) == 1 || isbegin_quest(13054) == 1)
				mes "工作组有四个人。别忘了告诉所有人。";
				else {
				mes "谢谢。你能听到大地歌唱吗？那是花朵和树木在风中起舞的声音。总有一天你会听到。";
					emotion ET_THROB;
					changequest 13050,13059;
					getexp 300000,300000;
					getitem 6081,1;// Splendide_Coin
				}
			}
			else {
				mes "很高兴你来了。我们正要重新开始工作。愿意帮我们吗？";
				next;
				switch( select("当然！:抱歉，我做不到") ) {
					mes "[Fili]";
				case 1:
					mes "太谢谢了！告诉拉菲内们开始工作！";
					setquest 13050;
					setquest 13051;
					setquest 13052;
					setquest 13053;
					setquest 13054;
					close;
				case 2:
					mes "你听到大地的声音逐渐变成低语了吗？看来它今天不太舒服。";
					next;
					mes "[Fili]";
					mes "这种时候，我们该做点什么让大地高兴起来！";
					close;
				}
			}
			close;

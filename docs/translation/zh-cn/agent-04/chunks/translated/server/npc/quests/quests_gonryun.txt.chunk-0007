			mes "[Cylrnel]";
			mes "接下来，告诉我";
			mes "她的身体状况。";
			next;
			switch(select("没什么特别的。:经常瘫痪。:肌肉变软。:肌肉变硬。")) {
			case 1:
				set .@sick3$,"没什么特别的。";
				break;
			case 2:
				set .@sick3$,"经常瘫痪。";
				set .@sick,.@sick+1;
				break;
			case 3:
				set .@sick3$,"肌肉变软。";
				break;
			case 4:
				set .@sick3$,"肌肉变硬。";
				break;
			}
			mes "[Cylrnel]";
			mes "内脏呢？";
			next;
			switch(select("胃疼得像被刀刺。:头疼得像被锤子砸。:心跳不规律。:呼吸困难。")) {

								mes "这样啊……";
								mes "那真是个漫长的故事。";
								next;
								mes "[Cylrnel]";
								mes "我不知道你为什么";
								mes "要帮助这些人，";
								mes "所以有点难以相信";
								mes "你……";
								close;
							}
							mes "[Cylrnel]";
						mes "哎呀！";
						mes "我从没想过还会有";
						mes "像你这样的人。";
						mes "抱歉，但你";
						mes "真的不是我的类型。";
							close;
						}
						if (rand(1,3) == 3) {
							mes "[Cylrnel]";
							mes "是这样吗？";
							mes "那么，";
							mes "让我听听你的故事。";

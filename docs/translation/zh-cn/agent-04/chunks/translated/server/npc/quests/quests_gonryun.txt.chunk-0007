				set .@sick1$,"非常热。";
				break;
			case 2:
				set .@sick1$,"非常冷。";
				break;
			case 3:
				set .@sick1$,"正常。";
				break;
			case 4:
				set .@sick1$,"反复变冷又变热。";
				set .@sick,.@sick+1;
				break;
			}
			mes "[Cylrnel]";
			mes "好……";
			mes "接下来是生理状况。";
			next;
			switch(select("完全不出汗。:全身出汗。:流鼻涕。:完全没有眼泪或汗水。")) {
			case 1:
				set .@sick2$,"完全不出汗。";
				set .@sick,.@sick+1;

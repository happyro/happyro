								mes "嗯……";
								mes "原来是这样……";
								mes "我需要知道确切症状……";
								mes "你去替我查清楚，";
								mes "然后再回来。";
								mes "别遗漏任何细节。";
								next;
								mes "[Cylrnel]";
								mes "没有确切症状，我无法做出准确诊断。";
								set b_sword,24;
								close;
							}
							mes "[Cylrnel]";
						mes "这样啊……";
						mes "那真是个漫长的故事。";
							next;
							mes "[Cylrnel]";
						mes "我不知道你为什么";
						mes "要帮助这些人，";
						mes "所以有点难以相信";
						mes "你……";

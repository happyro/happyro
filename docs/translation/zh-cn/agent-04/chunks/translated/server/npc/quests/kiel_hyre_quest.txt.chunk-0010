		mes "他们真正的目标是";
		mes "制造杀戮机器";
		mes "供雷根贝勒使用。";
		next;
		mes "[基尔·海伊尔]";
		mes "你现在知道我过去的";
		mes "所有秘密。我不会生你的气，";
		mes "";
		mes "";
		mes "";
		mes "但我有一件事";
		mes "想请你帮忙。";
		next;
		mes "[基尔·海伊尔]";
		mes "求你了！阻止基尔！";
		mes "我不想让他的疯狂";
		mes "再摧毁更多机器人！";
		mes "我把每一个机器人";
		mes "都看作自己的孩子！";
		next;
		mes "[基尔·海伊尔]";
		mes "我知道我必须为发生的一切";
		mes "承担全部责任。我保证";
		mes "事情解决后";
		mes "会接受对我行为的";
		mes "任何惩罚。";
		mes "";
		next;
		select("Accept:Okay:Nod");
		mes "[基尔·海伊尔]";
		mes "非常感谢！";
		mes "你可以在宅邸地下层";
		mes "找到基尔。";
		mes "";
		next;
		mes "[基尔·海伊尔]";
		mes "他待在最初制造他的旧房间，";
		mes "但把那里重建成洞穴，";
		mes "不让任何人进入，包括我。";
		mes "";
		mes "他已经不再信任任何人……";
		mes "";
		next;
		mes "[基尔·海伊尔]";
		mes "找到他后，我要你从他心脏";
		mes "取出艾莉西亚的戒指。";
		mes "取出戒指后应该能";
		mes "阻止他";
		mes "暴走。";
		next;
		select("Allysia's Ring?");
		mes "[基尔·海伊尔]";
		mes "是的……她的戒指是";
		mes "一切的开始。我把它放进";
		mes "他的心脏，是为了永远不忘";
		mes "罗希米尔家族对我做的事。";
		mes "";
		next;
		mes "[基尔·海伊尔]";
		mes "我想基尔已经强大到";
		mes "普通武器可能";
		mes "对他不起作用。使用这个";
		mes "装置让他的";
		mes "能量供应波动。";
		mes "";
		getitem 7504,1; //Toy_Motor
		next;
		cutin "kh_kyel03",2;
		mes "[基尔·海伊尔]";
		mes "如果你成功把它装到基尔身上，";
		mes "";
		mes "他就无法使用身体的全部力量。";
		mes "他变弱时，打开胸腔";
		mes "从心脏取出戒指。";
		mes "";
		next;
		mes "[基尔·海伊尔]";
		mes "准备好后告诉我。然后我会";
		mes "带你去基尔的房间。";
		mes "";
		set KielHyreQuest,74;
	}
	else if ((KielHyreQuest >= 74) && (KielHyreQuest <= 104)) {
		mes "[基尔·海伊尔]";
		mes "你准备好";
		mes "面对";
		mes "基尔了吗？";
		next;
		switch(select("是:否")) {
		case 1:
			mes "[基尔·海伊尔]";
			mes "那里……秘密通道";
			mes "已经打开。";
			mes "从我右边走，";
			mes "但小心，基尔";
			mes "非常危险。";
			close2;
			enablenpc "Kiehl_Room_Warp";
			donpcevent "Kiehl_Room_Warp::OnEnable";
			cutin "",255;
			end;
			break;
		case 2:
			mes "[基尔·海伊尔]";
			mes "慢慢来。";
			mes "我想这不会容易。";
			mes "";
			break;
		}
	}
	else if ((KielHyreQuest >= 74) && (KielHyreQuest <= 106)) {
		cutin "kh_kyel01",2;
		mes "[基尔·海伊尔]";
		mes "你回来了……！";
		mes "你成功从基尔心脏";
		mes "取回艾莉西亚的";
		mes "戒指了吗？";
		next;
		if (countitem(7508) < 1) {
			mes "[基尔·海伊尔]";
			mes "你是说……你没有拿到？";
			mes "请从基尔的心脏";
			mes "取回艾莉西亚的戒指！";
			next;
			enablenpc "Kiehl_Room_Warp";
			donpcevent "Kiehl_Room_Warp::OnEnable";
			close2;
			cutin "",255;
			end;
		}
		mes "[基尔·海伊尔]";
		mes "发、发生了什么……？";
		mes "基尔为自己制造了新身体？";
		mes "这、这会让他成为第四代";
		mes "机器人。我没想到他这么聪明。";
		mes "";
		mes "";
		next;
		mes "[基尔·海伊尔]";
		mes "等等，现在想想，";
		mes "我被关在工厂时确实见过";
		mes "像基尔的机器人身体。";
		mes "所以他用那些复制品";
		mes "开发个人升级。";
		next;
		mes "[基尔·海伊尔]";
		mes "来，请收下这张钥匙卡，";
		mes "它能让你进入并调查";
		mes "工厂最深处。";
		mes "我去调查基尔的房间。";
		getitem 7509,1; //Fancy_Key_Card
		set KielHyreQuest,108;
		next;
		if (Sex == SEX_FEMALE) {
			if (getpartnerid() == 0) set .@KHTitle$,"Miss";
			else set .@KHSTitle$,"Mrs";
		}
		else set .@KHTitle$,"Mr";
		mes "[基尔·海伊尔]";
		mes "基尔由我负责……";
		mes "无论付出什么代价，";
		mes "我都必须阻止他！哦，";
		mes "还有，请收下这个，";
		mes "感谢你的帮助，"+.@KHTitle$+" "+strcharinfo(0)+"。";
		getitem 616,1;  //Old Card Album
		delitem 7508,1; //Elysia_Ring
		getexp (checkre(3))?100000:1000000,0;
	}
	else if (KielHyreQuest >= 108) {
		mes "[基尔·海伊尔]";
		mes "......";
		mes ".........";
		mes "............";
	}
	close2;
	cutin "",255;
	end;
}


//----------------------------------------------------------------------------
// Allysia
//----------------------------------------------------------------------------
kh_mansion,18,30,4	script	Allysia	894,{
	if (KielHyreQuest < 46) {
		mes "[Allysia]";
		mes "你是谁？";
		mes "你怎么到这里的？";
		mes "快走开。";
		close;
	}
	cutin "kh_ellisia",2;
	if (KielHyreQuest < 70) {
		mes "[Allysia]";
		mes "发生的一切一定让你很惊讶。";
		mes "也许我解释一下机器人，";
		mes "你会更容易理解？";
		next;
		switch(select("是:否")) {
		case 1:
			mes "[Allysia]";
			mes "你遇到的机器人是自动化的机械傀儡，";
			mes "能够独立思考和行动。";
			mes "许多贤者都尝试开发自己的机器人，";
			mes "但都失败了。";
			next;
			mes "[Allysia]";
			mes "我的主人基尔·海伊尔从二十岁起";
			mes "就开始研究机器人，";
			mes "并开发了三代不同的机器人：";
			mes "第一代、第二代和第三代。";
			next;
		switch(select("第一代:第二代:第三代")) {
			case 1:
				mes "[Allysia]";
				mes "我是基尔·海伊尔第一代机器人的";
				mes "典型例子。我由坚固的机械骨架、";
				mes "机器人心脏和化学合成的";
				mes "皮肤构成。";
				next;
				mes "[Allysia]";
				mes "我的中央处理器相当于你们的大脑，";
				mes "本质上是一种记忆卷轴，";
				mes "设计基于你们冒险者";
				mes "战斗中使用的魔法卷轴。";
				next;
				mes "[Allysia]";
				mes "我是最古老的人形机器人，";
				mes "所以体重很大，思维只能";
				mes "处理有限的数据。";
				mes "因此我无法像人类一样表达情感。";
				next;
				break;
			case 2:
				mes "[Allysia]";
				mes "第一代机器人主要由机械部件开发，";
				mes "而第二代机器人融入了";
				mes "生命体魔法和技术。";
				next;
				mes "[Allysia]";
				mes "第二代机器人更像生命体，";
				mes "因为拥有人工制造的皮肤和血肉，";
				mes "但仍由坚固的机械骨架构成。";
				next;
				mes "[Allysia]";
				mes "贤者的元素卷轴技术也用于开发";
				mes "浓缩记忆卷轴，一种比第一代机器人";
				mes "所用处理器更先进的中央处理单元。";
				next;
				mes "[Allysia]";
				mes "虽然浓缩记忆卷轴比普通记忆卷轴";
				mes "强大 100,000 倍，但存在问题，";
				mes "容易产生大量错误。";
				next;
				mes "[Allysia]";
				mes "第二代机器人能够表达类似人类的情感，";
				mes "但六年后因被认为有缺陷而停止生产。";
				next;
				break;
			case 3:
				mes "[Allysia]";
				mes "第三代机器人主要由基尔·海伊尔的儿子基尔设计，";
				mes "完全不使用机械骨架，整个身体本质上就是生命体。";
				next;
				mes "[Allysia]";
				mes "它们拥有有机身体和由仿制伊米尔心脏碎片制成的先进人工心脏，";
				mes "能够像普通人类一样体验生理现象。";
				next;
				mes "[Allysia]";
			mes "";
			mes "";
			mes "";
			mes "";
			mes "";
			mes "";
			mes "";
			mes "";
			mes "";
				mes "";
				mes "";
				mes "";
				mes "";
				mes "不会遭受严重错误，";
				mes "不会出现严重错误，而且";
				mes "";
				mes "";
				mes "可以低成本批量处理。";
				next;
				mes "[Allysia]";
				mes "艾莉其实是第三代原型。";
				mes "优化这些原型后，我们将开始量产。";
				mes "事实上，这所学院就是我们的原型测试场。";
				next;
				mes "[Allysia]";
				mes "我们的原型机器人能像真人一样互动，";
				mes "这就是我们机器人研究成功的证明。";
				next;
				break;
			}
		case 2:
			mes "[Allysia]";
			mes "如果你想进一步了解基尔·海伊尔的机器人，";
			mes "请告诉我。";
			break;
		}
	}
	else {
		mes "[Allysia]";
		mes "......";
		mes ".........";
		mes "............";
	}
	close2;
	cutin "",255;
	end;
}

//----------------------------------------------------------------------------
// Abduction triggering NPC
//----------------------------------------------------------------------------
lighthalzen,188,200,0	script	Abduction_trigger	-1,3,1,{
OnTouch:
	if (KielHyreQuest == 50) {
		mes "^3355FF你走出宅邸时，有东西";
		mes "砸中你的头顶，你立刻失去意识……";
		close2;
		percentheal -99,0;
		warp "kh_mansion",30,75;
	}
	end;
}

//----------------------------------------------------------------------------

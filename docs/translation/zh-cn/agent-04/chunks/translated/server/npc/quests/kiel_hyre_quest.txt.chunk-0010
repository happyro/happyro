//----------------------------------------------------------------------------
kh_mansion,25,79,4	script	Mysterious Woman#kh	727,3,3,{

OnTouch:
	if (KielHyreQuest == 50) {
		mes "^3355FF你醒来时头痛欲裂，";
		mes "一个神秘女人正站在你面前。^000000";
		next;
		mes "[??????]";
		mes "嗯？哦，你醒得比我想的早。";
		mes "你一定很困惑，但请仔细听。";
		mes "否则我无法保证你的安全，明白吗？好。";
		next;
		mes "[??????]";
		mes "你只需要知道，我是施瓦茨瓦尔德共和国政府的秘密特工。";
		mes "我们正在调查基尔·海伊尔与雷根贝勒公司的异常活动。";
		next;

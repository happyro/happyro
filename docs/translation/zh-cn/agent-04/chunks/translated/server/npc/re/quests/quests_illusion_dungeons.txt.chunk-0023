ant_d02_i,65,246,0	duplicate(#il_tw1)	#ep18w02_1	HIDDEN_WARP_NPC,3,3

// ant_d02_i,44,258,6	script	Briashen#part1	RANGER,{
ant_d02_i,44,258,6	script(CLOAKED)	Briashen#part1	HIDDEN_NPC,{
	if (ill_anthell < 3)
		end;
	if (ill_anthell == 3) {
		mes "[看起来没事的游侠]";
		mes "呃，你好";
		mes "你没看到受伤的游侠吗？";
		next;
		mes "[看起来没事的游侠]";
		mes "你也在找 Khahris 吗？";
		next;
		if (select( "不是要找的名字", "是的" ) == 2) {
			mes "[看起来没事的游侠]";
			mes "嗯？谢谢。";
			mes "你到底在哪里……";
			mes "我甚至无法尖叫。";
			close;
		}
		mes "[" + strcharinfo(0) + "]";
		mes "一个叫 Briashen 的人……";
		next;
		mes "[看起来没事的游侠]";
		mes "什么？";
		next;
		mes "[看起来没事的游侠]";
		mes "我没受伤！";
		mes "是谁？";
		next;
		select( "Mirko and Yolanda" );
		mes "[" + strcharinfo(0) + "]";
		mes "米尔科和约兰达请求把独自受伤进入的布里阿申带出来。";
		next;
		mes "[布里阿申]";
		mes "你说得对，我是布里阿申，但你受伤了吗？什么时候？";
		next;
		mes "== 我不认为你在撒谎。==";
		mes "== 外表看起来正常，但这可能是我听说过的认知障碍影响？==";
		next;
		mes "[布里阿申]";
		mes "真奇怪。如你所见我没事。我在找在这里失散的朋友。";
		mes "他的名字是卡赫里斯……他长得和我一模一样。";
		next;
		mes "[布里阿申]";
		mes "找到他之前你不能回去。";
		mes "把这件事告诉米尔科。回头见。";
		ill_anthell = 4;
		erasequest 8721;
		setquest 8722;
		close2;
		cloakonnpcself();
		end;
	}
	if (ill_anthell == 4) {
		cloakonnpcself();
		mes "[布里阿申]";
		mes "你还没走吗？";
		mes "这里很危险。我会找到卡赫里斯，很快回去。";
		mes "回头见。";
		close;
	}
	if (ill_anthell == 5) {
		mes "[布里阿申]";
		mes "哦，又见到你了。";
		mes "你见过米尔科吗？";
		mes "你说什么？";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "他说想帮助你。";
		next;
		mes "[布里阿申]";
		mes "啊~你看起来很强。谢天谢地。";
		mes "不过米尔科太弱，无法进来搜索，所以担心也没用。";
		next;
		select( "我觉得你什么也没说", "所以才雇用了你" );	// note: the selection doesn't change the dialog
		mes "[布里阿申]";
		mes "顺便说，人有时会遇到各种情况。";
		mes "我现在很着急！卡赫里斯可能有危险。";
		next;
		mes "[布里阿申]";
		mes "你听到了吗？";
		mes "所以米尔科也让我帮忙。";
		next;
		select( "Maybe..." );
		mes "[布里阿申]";
		mes "你确定什么？";
		next;
		select( "A man named Khahris, is that real?" );
		mes "[" + strcharinfo(0) + "]";
		mes "一个叫卡赫里斯的男人，他是真的吗？";
		next;
		mes "[布里阿申]";
		mes "你在问同一个问题吗？";
		mes "真的。我们和蚂蚁一起在这里见过几次……";
		mes "……明白了吗？";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "?";
		next;
		mes "[布里阿申]";
		mes "总之，我们在这里相遇。我们惊讶于彼此如此相像。";
		mes "但几天前……";
		mes "我们在一起时，一只巨大的玛雅突然出现。";
		next;
		mes "[布里阿申]";
		mes "我伤得很重……";
		mes "你怎么样？";
		mes "那到底是谁受伤了？";
		next;
		mes "[布里阿申]";
		mes "我受伤了？";
		next;
		mes "== 这次，正如米尔科所说，布里阿申脸色很差。==";
		mes "== 出血应该已经停止，但过度活动会使伤口裂开。==";
		next;
		mes "== 但这不像某处受伤的人的姿势。==";
		mes "== 感知与现实发生扭曲并过度运转。==";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "这样下去很危险。你病了，必须离开这里。";
		next;
		mes "[布里阿申]";
		mes "不，不。不是我，是卡赫里斯。";
		mes "卡赫里斯会等我……我必须去找他。";
		next;
		mes "[布里阿申]";
		mes "卡赫里斯……";
		next;
		mes "== 布里阿申坐了下来。==";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "我们也出去吧。";
		next;
		mes "[布里阿申]";
		mes "不。我从没在这里见过蚂蚁……除了和米尔科在一起时。";
		mes "和卡赫里斯……除了上次玛雅出现时，一次也没有。";
		mes "我们一起狩猎吧……";
		next;
		mes "[布里阿申]";
		mes "卡赫里斯……对我做了什么？";
		next;
		mes "[布里阿申]";
		mes "救救那个朋友。";
		mes "只要玛雅不来，我就没事。";
		ill_anthell = 6;
		erasequest 8723;
		setquest 8724;
		cloakoffnpcself( "Rwella#part2" );
		cloakoffnpcself( "Khahris#part3" );
		cloakoffnpcself( "Khahris#part4" );
		next;
		mes "== 搜寻记忆的布里阿申陷入混乱。==";
		mes "== 我必须先探索地下城。==";
		close;
	}
	if (ill_anthell == 6) {
		mes "[布里阿申]";
		mes "救救那个朋友。";
		mes "只要玛雅不来，我就没事……";
		close;
	}
	end;

OnInit:
	.@npc_id = getnpcid(0);
	setunitdata .@npc_id, UNPC_CLASS, 4056;
	setunitdata .@npc_id, UNPC_CLOTHCOLOR, 1;
	setunitdata .@npc_id, UNPC_HAIRSTYLE, 13;
	setunitdata .@npc_id, UNPC_HAIRCOLOR, 7;
	setunitdata .@npc_id, UNPC_HEADTOP, 1523;

	// The parameters are gender, hair color, hair style, accessory 1-3 and robe
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "isbegin_quest(8721) == 1" );
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "isbegin_quest(8723) == 1" );
	end;
}



// ant_d02_i,86,189,2	script	Rwella#part2	RANGER,{
ant_d02_i,86,189,2	script(CLOAKED)	Rwella#part2	HIDDEN_NPC,{
	if (ill_anthell == 6 && isbegin_quest(8725) == 0) {
		mes "[露维拉]";
		mes "什么？你叫什么？";
		mes "你不应该先自我介绍吗？";
		mes "啊……对了。" + strcharinfo(0) + "。";
		mes "我是露维拉。";
		next;
		mes "[露维拉]";
		mes "你在附近见过一个叫布里阿申的人吗？";
		next;
		mes "== 布里阿申正在寻找的人的名字是……==";
		next;
		mes "[露维拉]";
		mes "你为什么呆呆站在那里？";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "你知道卡赫里斯这个名字吗？";
		next;
		mes "[露维拉]";
		mes "不，我不知道。";
		mes "真没礼貌，也回答我的问题。你见过布里阿申吗？";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "布里阿申寻找的名字是卡赫里斯……";
		next;
		mes "[露维拉]";
		mes "...";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "?";
		next;
		mes "== 等了一会儿，但露维拉没有回应。==";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "露维拉？";
		next;
		mes "[露维拉]";
		mes "我不觉得那是我的名字。";
		next;
		mes "[露维拉]";
		mes "但……我也不觉得是卡赫里斯。";
		mes "我想你见到布里阿申时就会知道。";
		mes "布里阿申在哪里？";
		next;
		mes "[露维拉]";
		mes "布里阿申……";
		setquest 8725;
		if (isbegin_quest(8725) != 1 || isbegin_quest(8726) != 1 || isbegin_quest(8727) != 1) {
			specialeffect EF_DEFENDER;
			cloakonnpcself();
		}
		else {
			ill_anthell = 7;
			erasequest 8724;
			erasequest 8725;
			erasequest 8726;
			erasequest 8727;
			setquest 8728;
			cloakonnpcself();
			cloakoffnpcself( "Rwella#part5" );
			specialeffect EF_DEFENDER, AREA, "Rwella#part5";
			mes "...I... I...!";
			mes "I...";
			mes "我以为……";
			close2;
			warp "anthell02",172,185;
			end;
		}
		next;
		mes "...";
		next;
		mes "== 欢迎……？==";
		next;
		mes "== 真正的卡赫里斯在哪里？==";
		close;
	}
	end;

OnInit:
	.@npc_id = getnpcid(0);
	setunitdata .@npc_id, UNPC_CLASS, 4056;
	setunitdata .@npc_id, UNPC_CLOTHCOLOR, 1;
	setunitdata .@npc_id, UNPC_HAIRSTYLE, 13;
	setunitdata .@npc_id, UNPC_HAIRCOLOR, 7;
	setunitdata .@npc_id, UNPC_HEADTOP, 1523;

	questinfo( QTYPE_QUEST, QMARK_YELLOW, "isbegin_quest(8724) == 1 && isbegin_quest(8725) == 0" );
	end;
}


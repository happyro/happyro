		mes "我也想演出！";
		mes "但我一个人做不到！";
		next;
		emotion ET_ANGER;
		mes "[吉他之歌]";
		mes "都是舞者 Kim 的错！";
		mes "有一天，她突然生气，说要退出<Nollio>！";
		mes "我也厌倦了她难以预测的情绪！";
		next;
		mes "[吉他之歌]";
		mes "哼。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "她为什么突然生气？";
		next;
		emotion ET_SWEAT;
		mes "[吉他之歌]";
		mes "我不知道！她一定在记恨什么。";
		mes "她就是这样的。";
		mes "她突然消失，还寄信说队伍要解散。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "舞者 Kim 现在在哪里？";
		next;
		mes "[吉他之歌]";
		mes "信是从胡格尔寄来的。";
		mes "我猜她可能回故乡了。";
		mes "我就是在那里第一次遇见她的。";
		next;
		emotion ET_THINK;
		mes "[吉他之歌]";
		mes "虽然她很容易发脾气，但舞跳得很棒……";
		mes "我不知道自己哪里做错了。";
		set job_wan,4;
		changequest 2218,2219;
		next;
		mes "[吉他之歌]";
		mes "她笑得那么开心，一定很喜欢这首新歌……";
		mes "谁能像她一样随着我的音乐跳得那么好？";
		mes "现在我的音乐和人生都成了过去……（喃喃）";
		close;
	} else if (job_wan > 3 && job_wan < 8) {
		mes "[吉他之歌]";
		mes "舞者 Kim 可能又沉迷胡格尔的怪物赛跑了！";
		mes "以前她沉迷怪物竞赛时，你猜是谁帮她摆脱的？";
		close;
	} else if (job_wan == 8) {
		emotion ET_SURPRISE;
		mes "- 你告诉他在修发兹发德发生的事，并请他回到卢蒂。-";
		next;
		mes "[吉他之歌]";
		mes "哦哦~";
		mes "你真傻，舞者 Kim~";
		mes "没有我，还有谁能照顾你这样的女士呢~";
		next;
		mes "[吉他之歌]";
		mes "我马上去那里骂她。";
		set job_wan,9;
		close;
	} else if (job_wan == 9) {
	mes "[吉他之歌]";
		mes "好，我会去鲁提举办演出的圣诞树。";
		close;
	}
		mes "[无精打采的大师]";
	mes "我的搭档在哪里……";
	close;
}

hu_in01,305,251,5	script	Vacant Looking Lady#wnd	879,{
	if (job_wan < 4) {
		mes "[神情空洞的女士]";
		mes "（空白……）";
		close;
	} else if (job_wan == 4) {
		mes "[神情空洞的女士]";
		mes "呜……呜……";
		next;
		select("你为什么哭？");
		emotion ET_CRY;
		mes "[神情空洞的女士]";
		mes "我放弃了梦想……";
		mes "*呜 *呜。";
		next;
		select("什么意思？");
		mes "[神情空洞的女士]";
		mes "我和长期合作的搭档道别了。";
		next;
		select("你为什么道别？");
		emotion ET_CRY;
		mes "[神情空洞的女士]";
		mes "因为……呜……呜！";
		next;
		select("你可以把一切告诉我。");
		mes "[神情空洞的女士]";
		mes "浪姬和宫廷乐师一起时，能力会变强。";
		next;
		mes "[神情空洞的女士]";
		mes "所以旅行时，他们经常一起表演二重奏。";
		mes "他们开心地跳舞、演奏音乐。";
		next;
		mes "[神情空洞的女士]";
		mes "几天前，我和搭档吉他之歌像往常一样，为许多人伴着他的音乐表演了优美的舞蹈。";
		next;
		mes "[神情空洞的女士]";
		mes "得到热烈掌声后，我为自己是浪姬感到自豪。";
		mes "Guitar Song 也称赞了我。";
		mes "那天我非常开心。";
		next;
		mes "[神情空洞的女士]";
		mes "但是……";
		next;
		select("后来发生了什么？");
		mes "[神情空洞的女士]";
		mes "第二天早上，我醒来洗了脸，在房间里找吃的……";
		next;
		emotion ET_HUK;
		mes "[神情空洞的女士]";
		mes "后来吉他之歌不知为何突然打开我的房门，说：^3131FF嘿！你到底在这里做什么？^000000，然后把我赶出了房间！";
		next;
		mes "[神情空洞的女士]";
		mes "我们在一起很久了，他怎么能这样对我？";
		mes "起初我以为他只是在开玩笑！可当他把我赶出房间时……";
		next;
		emotion ET_CRY;
		mes "[神情空洞的女士]";
		mes "他为什么没认出我的脸？";
		mes "你觉得他是不想看到我没化妆的脸吗？";
		mes "呜呜呜！";
		next;
		select("所以你解散了队伍？");
		emotion ET_CRY;
		mes "[神情空洞的女士]";
		mes "你也要无视我作为女性受伤的自尊吗？";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "不！他真的是个体贴的人！";
		mes "但我不认为你会只因为这件事就解散珍贵的队伍。";
		next;
		mes "[神情空洞的女士]";
		mes "你说得对。";
		mes "不只是因为那件事。";
		mes "我解散队伍的真正原因是……";
		next;
		mes "[神情空洞的女士]";
		mes "那天之后我回到故乡胡格尔，一直待在室内。";
		mes "那时 Shide 用甜蛋糕安慰我。";
		next;
		emotion ET_SHY;
		mes "[神情空洞的女士]";
		mes "Shide 的蛋糕棒极了！";
		mes "这是修发兹发德最有名的蛋糕，里面有松软的海绵蛋糕、新鲜水果和香甜的巧克力奶油！";
		next;
		mes "[神情空洞的女士]";
		mes "尝到那块甜蛋糕时，就像所有幸福天使都来安慰我。";
		next;
		mes "[神情空洞的女士]";
		mes "所以我每天早晚都吃。";
		next;
		select("哦，你不会吧……");
		emotion ET_CRY;
		mes "[神情空洞的女士]";
		mes "幸福天使带走了我的悲伤，却给了我一大堆肚腩赘肉！";
		mes "呜呜呜呜！！";
		next;
		mes "[神情空洞的女士]";
		mes "现在我穿不上舞衣了！";
		mes "我再也不是能像美丽蝴蝶一样跳舞的舞者了！";
		next;
		mes "[神情空洞的女士]";
		mes "更糟的是，我连弯腰都变得困难了！";
		mes "呜呜呜！";
		next;
		mes "[神情空洞的女士]";
		mes "演出日就要到了，可幸福天使却给我带来了巨大的障碍。";
		mes "我又一次陷入绝望了！";
		mes "我不能让吉他之歌和我的粉丝看到我这副样子！";
		next;
		mes "[神情空洞的女士]";
		mes "<Nollio> is over! 呜呜呜！";
		set job_wan,5;
		close;
	} else if (job_wan == 5) {
		emotion ET_CRY;
		mes "[神情空洞的女士]";
		mes "不久前我还像美丽的鸽子，如今却只是一只肥鸡。";
		mes "呜呜……！";
		mes "我想浪姬舞者金的生活已经结束了。";
		mes "呜呜呜呜！";
		next;
		if(select("嘿，别放弃。:我很同情你。") == 2) {
			mes "[舞者金]";
			mes "我的人生现在已经无法逃出深渊了……";
			close;
		}
		mes "[舞者金]";
		mes "但我已经告诉吉他之歌一切都结束了。";
		mes "就算还没结束，我现在也什么都做不了。";
		next;
		select("如果你放弃，就真的结束了。");
		mes "[舞者金]";
		mes "可是现在这种情况……";
		mes "我真的有办法改变吗？";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "锻炼是最好的办法！";
		mes "只要努力，你的身体就会比以前轻盈！";
		next;
		mes "[舞者金]";
		mes "可是我很容易疲惫，也很容易放弃。";
		mes "我觉得自己要放弃了。";
		next;
		if(select("好吧，没别的办法了。:我们一起努力吧。") == 1) {
			mes "[舞者金]";
			mes "没有梦想，也没有希望……";
			close;
		}
		emotion ET_HUK;
		mes "[舞者金]";
		mes "你愿意和我一起锻炼吗？";
		mes "真的吗？";
		next;
		mes "[舞者金]";
		mes "如果有人陪我锻炼，我一定会更加努力。";
		next;
		mes "[舞者金]";
		mes "我感觉好多了！";
		mes "我觉得自己又恢复力量了！";
		mes "我们一起努力吧！";
		next;
		select("我们首先该做什么？");
		mes "[舞者金]";
		mes "我有个好主意！";
		next;
		mes "[舞者金]";
		mes "在深渊湖见。";
		mes "我们在那里碰面。";
		mes "从修发兹发德这里向南一个地图、向西一个地图就到了。";
		mes "我会在那里等你。";
		set job_wan,6;
		changequest 2219,2220;
		close;
	} else if (job_wan == 6 || job_wan == 7) {
		mes "[舞者金]";
		mes "我会在深渊湖等你。";
		close;
	} else if (job_wan == 8) {
		mes "[舞者金]";
		mes "请告诉吉他之歌去卢蒂。";
		mes "我收拾好行李后就会去那里！";
		close;
	}
	mes "[神情空洞的女士]";
	mes "我的搭档在哪里……...";
	close;
}

hu_fild05,342,130,5	script	Dancer Kim#fild	879,{
	if (job_wan == 6) {
		mes "[舞者金]";
		mes "一起锻炼很好，但如果我们比赛，我觉得效果会更好！";
		next;
		mes "[舞者金]";
		mes "从现在开始，我们比赛看谁先击败黄色诺博斯！";
		next;
		mes "[舞者金]";
		mes "你需要击败 50 只黄色诺博斯！";
		mes "准备好了吗？";
		next;
		if(select("不。:是。") == 1) {
			mes "[舞者金]";
			mes "趁我还没失去兴趣，快点！";
			close;
		}
		mes "[舞者金]";
		mes "很好！那么，预备，开始~~";
		mes "出发！";
		set job_wan,7;
		changequest 2220,2221;
		close;
	} else if (job_wan == 7) {
		if (checkquest(2221,PLAYTIME) == 0 || checkquest(2221,PLAYTIME) == 1) {
			if (checkquest(2221,HUNTING) == 2) {
				mes "[舞者金]";
				mes "呼！";
				mes "看来是我输了！";
				next;
				mes "[舞者金]";
				mes "这种感觉让我想起过去穿越许多大陆边境的日子。";
				next;
				mes "[舞者金]";
				mes "啊！看这个！";
				mes "我变苗条了，你看得出来吗？";
				next;
				mes "[舞者金]";
				mes "我感觉身体充满了力量。";
				mes "我突然想见见我的好搭档吉他之歌。";
				mes "我想再次开始跳舞。";
				next;
				select("去卢蒂跳舞怎么样？");
				emotion ET_SURPRISE;
				mes "[舞者金]";
				mes "啊！圣诞村！好！好！";
				mes "我在卢蒂跳舞的梦想终于要实现了。";
				next;
				mes "[舞者金]";
				mes "我想整天跳舞，让大家获得幸福！";
				mes "所以我要去卢蒂。";
				next;
				mes "[舞者金]";
				mes "啊，请帮我一个忙。";
				mes "你能把吉他之歌带到卢蒂吗？";
				mes "告诉他，他的搭档正在等他。";
				next;
				select("没问题！");
				mes "[舞者金]";
				mes "你是个好人。能遇见你我真的很开心。";
				mes "感谢神把这样固执的人带到我身边！";
				set job_wan,8;
				changequest 2221,2222;
				close;
			} else {
				mes "[舞者金]";
				mes "对你来说看起来很容易吗？";
				mes "但我肯定自己获胜的机会更大。";
				close;
			}
		} else if (checkquest(2221,PLAYTIME) == 2) {
			mes "[舞者金]";
			mes "哦，你回来了。";
			mes "我太累了。我不是半途而废，只是这对我来说是很好的锻炼。我只能把诺利欧交给另一位浪姬，一切都结束了……";
			next;
			mes "- 舞者金因悲伤和疲惫倒下了。-";
			set job_wan,6;
			changequest 2221,2220;
			close;
		} else {
			mes "[舞者金]";
			mes "咦……？";
			set job_wan,6;
			close;
		}
	} else if (job_wan == 8) {
		mes "[舞者金]";
		mes "请告诉宋，我会在圣诞树下等他。";
		close;
	}
	mes "[舞者金]";
	mes "我觉得狩猎诺博斯是最好的锻炼。";
	close;
}


xmas,147,135,5	script	Dancer Kim#xmas	485,{
	if (job_wan == 9) {
		if (BaseJob != Job_Dancer && BaseLevel < 99 && JobLevel < 50) {
				mes "- 任务条件不满足，无法继续任务。-";
			close;
		}
		if (SkillPoint) {
				mes "- 你还有剩余技能点，无法继续任务。-";
			close;
		}
		if (checkweight(1201,2) == 0) {
				mes "- 如果要继续任务，请清空背包。-";
			close;
		}
		if (ismounting()) {
				mes "[舞者金]";
				mes "请先从骑乘的生物上下来。";
				mes "然后再和我谈。";
			close;
		}
			mes "- <诺利欧>正在表演。-";
		next;
		emotion ET_DELIGHT, getnpcid(0, "Guitar Song#xmas");
		emotion ET_DELIGHT;
			mes "[吉他之歌]";
			mes "一！二！三！";
			mes "蓝色鱼儿跳舞~";
			mes "粉丝！粉丝！粉丝！我是你的粉丝~";
			mes "凭借坚定的意志，我完成了钓鱼~";
		next;
		emotion ET_DELIGHT, getnpcid(0, "Spectator#xmas1");
		emotion ET_DELIGHT, getnpcid(0, "Spectator#xmas2");
		emotion ET_DELIGHT, getnpcid(0, "Spectator#xmas3");
		emotion ET_DELIGHT, getnpcid(0, "Spectator#xmas4");
		emotion ET_DELIGHT, getnpcid(0, "Soy#xmas");
		emotion ET_DELIGHT, getnpcid(0, "Mimi#xmas");
			mes "[观众]";
			mes "啊啊啊啊啊啊——！！！";
			mes "太酷了！诺利欧最棒！！！";
		next;
			mes "[吉他之歌]";
			mes "女士们、先生们，大家好！";
		next;
		emotion ET_THROB, getnpcid(0, "Spectator#xmas1");
		emotion ET_THROB, getnpcid(0, "Spectator#xmas2");
		emotion ET_THROB, getnpcid(0, "Spectator#xmas3");
		emotion ET_THROB, getnpcid(0, "Spectator#xmas4");
		emotion ET_THROB, getnpcid(0, "Soy#xmas");
		emotion ET_THROB, getnpcid(0, "Mimi#xmas");
			mes "[观众]";
			mes "大家好!!!!!";
		next;
			mes "[吉他之歌]";
			mes "我们是浪漫的浪姬队伍<诺利欧>，追随着爱与风漫步世界！";
		next;
		emotion ET_THROB, getnpcid(0, "Spectator#xmas1");
		emotion ET_THROB, getnpcid(0, "Spectator#xmas2");
		emotion ET_THROB, getnpcid(0, "Spectator#xmas3");
		emotion ET_THROB, getnpcid(0, "Spectator#xmas4");
		emotion ET_THROB, getnpcid(0, "Soy#xmas");
		emotion ET_THROB, getnpcid(0, "Mimi#xmas");
			mes "[观众]";
			mes "哇~~~~~！";
		next;
		emotion ET_BEST;
			mes "[舞者金]";
			mes "能在美丽的雪村跳舞真是太奇妙了，";
			mes "我很高兴来到这里，卢蒂。";
		next;
			mes "[观众]";
			mes "耶~~~~~";
		next;
			mes "[舞者金]";
			mes "其实，这场精彩的表演差点因为我的疏忽而取消。";
		next;
			mes "[吉他之歌]";
			mes "我无意中让她伤心了。";
			mes "请允许我借此机会向她道歉。";
		next;
			mes "[舞者金]";
			mes "没关系。";
			mes "我也为自己的行为道歉。";
		next;
			mes "[舞者金]";
			mes "其实，有一位朋友在我家乡陷入低谷时鼓励我，帮助我度过了那些艰难时光。";
		next;
			mes "[舞者金]";
			mes "今后你们也许会比喜欢我的舞蹈更喜欢我朋友的舞蹈。";
			mes "她非常有天赋。";
		next;
			mes "[舞者金]";

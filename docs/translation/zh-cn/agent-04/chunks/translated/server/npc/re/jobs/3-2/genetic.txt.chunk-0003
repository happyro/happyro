}

job3_gen01,85,25,1	script	Opened Book#gen	111,{
	mes "< 想拥有我漂亮的房间吗？Zeny 够吗？空间够吗？马上去拉赫的百货商店，买最高档的墙纸和室内装饰！>";
	next;
	mes "< 能照亮房间的豪华蜡烛、每位女士都拥有的巨大金镜，一个都不能错过！>";
	close;
}

job3_gen01,81,81,0	script	#dbroom	139,2,2,{
OnTouch_:
	mes "- 由于堆满了许多包裹，这个房间看起来像仓库。 -";
	close;
}


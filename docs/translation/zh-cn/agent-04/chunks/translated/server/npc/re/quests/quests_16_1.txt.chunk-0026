		close;
	}
	if (ep16_wig == 20) {
		mes "[Mary]";
		mes "你告诉王子了吗？";
		mes "我担心出问题的后果。";
		next;
		mes "[Mary]";
		mes "我可能也得像妹妹一样逃走。";
		close;
	}
	if (ep16_wig > 20) {
		if (isbegin_quest(14494) == 1 || isbegin_quest(14492) == 1) {	// daily quest
			mes "[Mary]";
			mes "你告诉王子了吗？希望他从明天开始放弃，不再把你派到这里。";
			close;
		}
		if (isbegin_quest(14493) == 1) {
			if (countitem(748) < 1 || countitem(6927) < 15) {
				emotion ET_OHNO;
				mes "[Mary]";
				mes "哦，什么时候才能结束。";
				mes "我真的不会放手！";
				next;
				mes "[" + .@name$ + "]";
			mes "哦，我想现在不是合适的时机。我可以晚点再来吗？";
				next;
				mes "[Mary]";
				mes "不，完全没有。";
				mes "亲爱的冒险者，你的口袋破了。丢了什么吗？";
				next;
				mes "[" + .@name$ + "]";
				mes "哦！什么时候破的？^0000cd15 个海之石和 1 朵不凋谢的玫瑰^000000在哪里……？";
				mes "它们不见了！我稍后再来！我忘了带东西！";
				close;
			}
			mes "[Maid]";
			mes "冒险者？你来这里做什么？";
			next;
			mes "[" + .@name$ + "]";
			mes "Jurgen 派我来再次向你表达他的爱。";
			next;
			emotion ET_CRY;
			mes "[Maid]";
			mes "又来……我真希望他今天已经放弃……看来只是我的妄想。";
			next;
			mes "[Maid]";
			mes "请告诉他我很感激。";
			next;
			mes "[Maid]";
			mes "我真希望宴会快点结束。或者我妹妹能直接回来。";
			next;
			mes "[Maid]";
			mes "总之，很抱歉今天又让你陷入这种困难处境。";
			next;
			mes "[" + .@name$ + "]";
			mes "那么，既然该交付的东西已经交给你，我也该走了。";
			next;
			mes "[Maid]";
			mes "好，请平安回去。希望他明天前能放弃。";
			delitem 6927, countitem(6927);// Filled_With_SeaStones
			delitem 748,1;// Witherless Rose
			erasequest 14493;// Today I Feel
			setquest 14494;// I Have to Turn It Down Again
			close;
		}
		// fall through
	}
	mes "[Maid]";
	mes "哦，我受够清洁了！家里已经有很多东西要打扫。我不想在外面再做更多。";
	mes "我干脆放弃一切逃走算了。";
	close;
}

prt_cas,339,212,5	script	Dark and Damp Wall#ep16wig	HIDDEN_NPC,5,5,{
	callsub S_Talk;

S_Talk:
	if (ep16_wig == 5) {
		mes "[Scrub Sponge]";
		mes "人类，是你唤醒我的吗？";
		mes "长眠后，我在这种混乱中醒来。";
		next;
		mes "[Scrub Sponge]";
		mes "我是封印在擦洗海绵中的清洁之神。";
		mes "你打扰我休息，必须用清洁来偿还罪孽。";
		next;
		mes "[Scrub Sponge]";
		mes "让我看看。这一定是^0000cd一团霉菌^000000！";
		mes "不借助同族和神的力量，你无法获得这种霉菌。";
		next;
		mes "[Scrub Sponge]";
		mes "带来^0000cd1 份霉菌粉和 1 瓶圣水^000000！";
		setquest 14481;// Conquer the Mold
		ep16_wig = 6;
		close;
	}
	if (ep16_wig == 6) {
		if (countitem(6928) < 1 || countitem(7001) < 1 || countitem(523) < 1) {
			mes "[Scrub Sponge]";
			mes "人类，你现在做什么？";
			mes "我说过了！清理霉菌需要^0000cd1 份霉粉和 1 份圣水^000000！";
			next;
			mes "[Scrub Sponge]";
			mes "没有它们怎么清理？";
			mes "先去拿来。";
			close;
		}
		mes "[Scrub Sponge]";
		mes "既然你带了霉菌粉和酒精，现在试着除掉霉菌。";
		next;
		mes "[Scrub Sponge]";
		mes "这不是擦除霉菌的正确方法，但这是清除严重霉菌的唯一办法。";
		next;
		mes "[Scrub Sponge]";
		mes "把霉粉涂在像恶魔皮肤一样的霉菌上，再撒上圣水。";
		next;
		mes "[Scrub Sponge]";
		mes "按照我的指示擦拭。我不会再说第二遍，所以认真听。";
		while(1) {
			next;
			mes "[Scrub Sponge]";
			mes "先轻轻拍一下，再拍三下。必须让墙面充分浸透圣水和霉粉才能擦掉。这很重要。";
			next;
			mes "[Scrub Sponge]";
			mes "然后用力擦十次，再画圈擦五次。现在试试吧？";
			next;
			progressbar "ffff00",3;
			switch( rand(1,3) ) {
			case 1:
				mes "[Scrub Sponge]";
				mes "不对！必须下定决心清除恶魔之花。";
				mes "集中精神，再认真听一遍。";
				continue;
			case 2:
				specialeffect EF_RECOVERY;
				mes "做得好。你清理得很干净。";
				mes "作为擦洗海绵，我非常满足。";
				next;
				mes "[Scrub Sponge]";
				mes "既然我完成了职责，现在该走了！";
				mes "谢谢你，人类……谢谢你陪伴我度过这一生……";
				specialeffect2 EF_CURE;
				break;
			case 3:
				mes "[Scrub Sponge]";
				mes "不对！放松一点手臂！";
				mes "清洁不只是依靠体力。你离顿悟还很远。放松身心再试一次。";
				continue;
			}
			break;
		}
		delitem 6928,1;// Poring Loofah
		delitem 7001,1;// Mould Powder
		delitem 523,1;// Holy Water
		completequest 14481;// Conquer the Mold
		ep16_wig = 7;
		close;
	}
	if (ep16_wig > 6) {
		mes "[曾经发霉的墙]";
		mes "干净的墙让我想起陪我完成清洁工作的擦洗海绵。";
		close;
	}
	end;

OnTouch:
	if (ep16_wig == 5)
		callsub S_Talk;
	end;
}

prt_cas,339,198,5	script	Sticky Wall#ep16wig	HIDDEN_NPC,5,5,{
	callsub S_Talk;

S_Talk:
	if (ep16_wig == 7) {
		mes "[Scrub Sponge]";
		mes "是你吗……？是你引导我去处理^0000cd顽固油污^000000的吗？";
		mes "很高兴见到你。我一直在这里睡觉，等待有人和我一起清洁。";
		next;
		mes "[Scrub Sponge]";
		mes "我是封印在擦洗海绵里的清洁妖精。";
		mes "靠近脏东西时我就会醒来。";
		next;
		mes "[Scrub Sponge]";
		mes "谢谢你选择我来清理油污。";
		mes "我一直想用帅气的方式清理油污。";
		next;
		mes "[Scrub Sponge]";
		mes "嗯……对于顽固油污，^0000cd橙子和酒精的混合物^000000效果最好。";
		mes "能带来^0000cd1 个橙子和 1 个酒精^000000吗？用它们来清洁吧！";
		setquest 14480;// Conquer the Grease
		ep16_wig = 8;
		close;
	}
	if (ep16_wig == 8) {
		if (countitem(6928) < 1 || countitem(582) < 1 || countitem(970) < 1) {
			mes "[Scrub Sponge]";
			mes "哦，等一下！";
			mes "清理顽固油污需要^0000cd1 个橙子和 1 个酒精^000000。";
			next;
			mes "[Scrub Sponge]";
		mes "我想自己准备，但我只是一块擦洗海绵。";
		mes "请把它们带来。";
			close;
		}
		mes "[Scrub Sponge]";
		mes "既然橙子和酒精都有了，现在一起清洁吧！";
		next;
		mes "[Scrub Sponge]";
		mes "剥开橙子，把橙皮放进酒精。然后等一会儿。想吃橙肉也可以。好吃！";
		next;
		mes "[Scrub Sponge]";
		mes "嗯，橙皮的精华现在应该已经融入酒精了。把它喷在油污上，和我一起擦。";
		next;
		mes "[Scrub Sponge]";
		mes "擦掉它需要一些技巧。";
		while(1) {
			next;
			mes "[Scrub Sponge]";
			mes "先轻轻擦，再轻轻擦一次，然后用力擦！接着用中等力度擦，再加大力度。";
			mes "然后再喷一次混合物，继续用中等力度擦。";
			next;
			progressbar "ffff00",3;

			switch( rand(1,3) ) {
			case 1:
				mes "[Scrub Sponge]";
				mes "我觉得你擦得太轻了。应该给油污一些时间，让它溶解在混合物中。";
				next;
				mes "[Scrub Sponge]";
				mes "首先要让混合物渗入油污，然后擦掉油污。好了，再试一次。";
				continue;
			case 2:
				specialeffect EF_RECOVERY;
				mes "[Scrub Sponge]";
				mes "哇，做得好！油污现在消失了！";
				mes "更棒的是，清洁后还留下清香，让乘客很开心。";
				next;
				mes "[Scrub Sponge]";
				mes "不过，我很快就要消失了。";
				mes "这就是肮脏擦洗海绵的命运。";
				next;
				mes "[Scrub Sponge]";
				mes "不过，能和你一起度过擦洗海绵短暂的一生，我很开心。";
				mes "下辈子我想投胎成人，成为你的亲密……朋友……";
				specialeffect2 EF_CURE;
				break;
			case 3:
				mes "[Scrub Sponge]";
				mes "不能只是一味用力擦。要让混合物融入油污，才能把它去掉。";
				mes "轻轻擦，然后立即擦掉。好了，再听一遍。";
				continue;
			}
			break;
		}
		delitem 6928,1;// Poring Loofah
		delitem 582,1;// Orange
		delitem 970,1;// Alcohol
		completequest 14480;// Conquer the Grease
		ep16_wig = 9;
		close;
	}
	if (ep16_wig > 8) {
		mes "[Scrapped-off Wall]";
		mes "干净的墙让我想起一直对我很好的擦洗海绵。";
		close;
	}
	end;

OnTouch:
	if (ep16_wig == 7)
		callsub S_Talk;
	end;
}

prt_cas,309,215,5	script	Pitch-black Floor#ep16wig	HIDDEN_NPC,5,5,{
	callsub S_Talk;

S_Talk:
	if (ep16_wig == 9) {
		mes "[Scrub Sponge]";
		mes "是你吗？你是今天负责清洁任务的人吗？";
		mes "很高兴见到你！我是封印在擦洗海绵里的清洁教官！";
		next;
		mes "[Scrub Sponge]";
		mes "跟着我的指引，你就能完成世界上最难的清洁任务！";
		mes "明白了吗？";
		next;
		mes "[Scrub Sponge]";
		mes "看看今天的目标！是卡在地板缝隙里的^0000cd恶魔黑污^000000！";
		mes "这里是雷神 3 级别的情况！";
		next;
		mes "[Scrub Sponge]";
		mes "换句话说，只要材料齐全就能解决！";
		mes "需要^0000cd1 份细沙和 1 个柠檬^000000才能清除目标！";
		next;
		mes "[Scrub Sponge]";
		mes "现在去拿！";
		mes "快去！";
		setquest 14482;// Conquer the Dirt of Devil
		ep16_wig = 10;
		close;
	}
	if (ep16_wig == 10) {
		if (countitem(6928) < 1 || countitem(7043) < 1 || countitem(568) < 1) {
			mes "[Scrub Sponge]";
			mes "你现在在做什么？";
			mes "没有柠檬和细沙，就无法清除卡在地板缝隙里的黑污！";
			next;
			mes "[Scrub Sponge]";
			mes "现在准备 1 份细沙和 1 个柠檬！";
			mes "快去！";
			close;
		}
		mes "[Scrub Sponge]";
		mes "很好！材料都准备好了！";
		mes "现在开始清洁！";
		next;
		mes "[Scrub Sponge]";
		mes "挤出柠檬汁洒在地板上，然后把细沙撒上去！";
		mes "这样能让地板变白并变得光亮！柠檬的清香更是锦上添花！";
		next;
		mes "[Scrub Sponge]";
		mes "然后和我一起快速擦洗！";
		mes "擦洗方法如下！跟着我并不难！听好了！";
		while(1) {
			next;
			mes "[Scrub Sponge]";
			mes "向左三次！向右一次！再向左一次！向前两次！";
			mes "最后向左两次！现在开始！";
			next;
			progressbar "ffff00",3;
			switch( rand(1,3) ) {
			case 1:
				mes "[Scrub Sponge]";
				mes "错了！";
				mes "集中精神！再重复一次！";
				continue;
			case 2:
				specialeffect EF_RECOVERY;
				mes "[Scrub Sponge]";
				mes "做得好！";
				mes "你漂亮地完成了清洁任务！";
				next;
				mes "[Scrub Sponge]";
				mes "我相信即使没有我，你也能完美完成清洁！";
				mes "老兵永远不死！他们只是逐渐淡去！所以别流泪！";
				next;
				mes "[Scrub Sponge]";
				mes "以后看到并清理卡在地板缝隙里的黑污时，可以想起我！";
				mes "现在解散！走吧！";
				specialeffect2 EF_CURE;
				break;
			case 3:
				mes "[Scrub Sponge]";
				mes "我什么时候那样教过你？别说你是跟我学的！";
				next;
				mes "[Scrub Sponge]";
				mes "保持冷静！再听我说一遍！";
				continue;
			}
			break;
		}
		delitem 6928,1;// Poring Loofah
		delitem 7043,1;// Fine Sand
		delitem 568,1;// Lemon
		completequest 14482;// Conquer the Dirt of Devil
		erasequest 14479;// Clean-up out of Apology
		setquest 14483;// Report the Completion of the Clean-up
		ep16_wig = 11;
		close;
	}
	if (ep16_wig == 11) {
		mes "[Shining Floor]";
		mes "干净的地板让我想起外刚内柔的擦洗海绵。";
		mes "回去告诉女仆清洁已经完成吧。";
		close;
	}
	if (ep16_wig > 11) {
		mes "[Shining Floor]";
		mes "干净的地板让我想起外刚内柔的擦洗海绵。";
		close;
	}
	end;

OnTouch:
	if (ep16_wig == 9)
		callsub S_Talk;
	end;
}

prontera,68,68,5	script	Furniture Deliveryman#ep16wig	1_M_HOF,{
	if (ep16_wig == 12) {
		.@name$ = strcharinfo(0);
		mes "[Furniture Deliveryman]";
		mes "我的胳膊、腿、背和全身都疼。好在今天的工作结束了。现在可以休息一下。我该去喝点热汤。今天应该是肉汤吧？";
		next;
		mes "[" + .@name$ + "]";
		mes "我能问你一件事吗？";
		next;
		emotion ET_CRY;
		mes "[Furniture Deliveryman]";
		mes "什么事？是家具配送吗？我今天已经下班了。除非真的很紧急，否则请明天再来好吗？";
		next;
		mes "[Furniture Deliveryman]";
		mes "我被今天的工作累坏了，现在几乎无法挺直腰站立。";
		next;
		mes "[" + .@name$ + "]";
		mes "不，不是那件事。你就是给 Wigner 家送家具的人，对吧？";
		next;
		mes "[Furniture Deliveryman]";
		mes "是我……家具出问题了吗？我该怎么办？我可赔不起那些家具！";
		next;
		mes "[Furniture Deliveryman]";
		mes "难道有凹痕？要叫 James 来修吗？损坏？送错了？我该怎么办？到底是什么事？";
		next;
		mes "[" + .@name$ + "]";
		mes "不，没那回事。请放松。";
		next;
		mes "[Furniture Deliveryman]";
		mes "什么事？追加配送？我现在真的想休息……不过既然是 Wigner 家的事，我想也没有选择。唉，我真讨厌这样……维持生计太难了。";
		next;
		emotion ET_OHNO;
		mes "[" + .@name$ + "]";
		mes "不，我只是想问你一件事。你在房间的桌子上见过一个小盒子吗？";
		next;
		mes "[Furniture Deliveryman]";
		mes "什么盒子？我当时忙着送家具……等等，我想起来了。";
		next;
		mes "[Furniture Deliveryman]";
		mes "你是说床边桌子上的^0000cd小盒子^000000吧？没有特别装饰、锁着的盒子。";
		next;
		mes "[" + .@name$ + "]";
		mes "我想是的。";
		next;
		mes "[Furniture Deliveryman]";
		mes "是的，我记得。那是个没有装饰的朴素盒子，但看起来很高级。";
		mes "木材品质极佳，锁具也很精致。一眼就能看出是大师工匠制作的。";
		next;
		mes "[Furniture Deliveryman]";
		mes "我从事家具工作，所以那样的东西很吸引我。那确实是一件艺术品。";
		next;
		mes "[" + .@name$ + "]";
		mes "你送完家具后盒子还在那里吗？";
		next;
		emotion ET_FRET;
		mes "[Furniture Deliveryman]";
		mes "是的。盒子总不会自己移动吧？";
		next;
		emotion ET_HUK;
		mes "[Furniture Deliveryman]";
		mes "哦，等等？你是说它不见了？你是在暗示它被我的马车带走了吗？";
		next;
		mes "[" + .@name$ + "]";
		mes "不，请冷静。我没有怀疑你，只是想听听你的说法。我只是根据见过盒子的人的证词追踪它的去向。";
		next;
		emotion ET_ANGER;
		mes "[Furniture Deliveryman]";
		mes "如果东西不见了，总是我们这些普通人被怀疑。你知道这只是偏见吗？";
		mes "拥有较少的人就一定贪财，也一定不道德……";
		next;
		mes "[" + .@name$ + "]";
		mes "这只是误会。相信我，我没有怀疑你……你知道，人员失踪时总要寻找目击者。";
		next;
		emotion ET_ANGER;
		mes "[Furniture Deliveryman]";
		mes "我不想听这些！为什么为了一个失踪的盒子吓唬无辜的家具配送员？";
		next;
		mes "[" + .@name$ + "]";
		mes "抱歉让你不舒服。我只是询问所有进过那个房间的人，没有怀疑你。";
		next;
		emotion ET_HNG;
		mes "[Furniture Deliveryman]";
		mes "呵，这并没有让我好受些。我饿了，感觉更糟。哦，我的肚子在叫……我不舒服……";
		next;
		mes "[" + .@name$ + "]";
		mes "你需要吃点东西吗？";
		next;
		mes "[Furniture Deliveryman]";
		mes "你这么说也改变不了什么……好吧，如果给我一些牛头肉片，也许我可以算了……我忘不了十年前的味道……";
		next;
		mes "[" + .@name$ + "]";
		mes "这样你会好受些吗？";
		next;
		mes "[Furniture Deliveryman]";
		mes "嗯，也不一定……好吧！给我^0000cd3 个牛头肉片^000000我就算了！公平就是公平。";
		emotion ET_KIK;
		next;
		mes "[" + .@name$ + "]";
		mes "这些够了吗？好的，请等我回来。";
		close2;
		erasequest 14484;// There Was a Furniture Delivery Man

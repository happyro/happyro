				end;
			case 2:
				mes "[Hanson]";
				mes "你选择了";
				mes "成为服事。";
				mes "你将被送往";
				mes "普隆德拉城镇。";
				next;
				mes "[Hanson]";
				mes "普隆德拉修道院位于普隆德拉东北方。请记住。";
				next;
				callsub L_Supplies;
				savepoint "prontera",117,72,1,1;
				warp "prt_church",172,19;
				end;
			case 3:
				mes "[Hanson]";
				mes "你选择了";
				mes "成为盗贼。";
				mes "你将被送往";
				mes "摩洛克城镇。";
				next;
				mes "[Hanson]";
				mes "盗贼公会位于城镇西北方金字塔的地下 1 楼。请记住。";
				next;
				callsub L_Supplies;
				savepoint "morocc",150,99,1,1;
				warp "moc_ruins",155,44;
				end;
			case 4:
				mes "[Hanson]";
				mes "你选择了";
				mes "成为商人。";
				mes "你将被送往";
				mes "阿尔伯特城镇。";
				next;
				callsub L_Supplies;
				savepoint "alberta",30,232,1,1;
				warp "alberta_in",62,44;
				end;
			case 5:
				mes "[Hanson]";
				mes "你选择了";
				mes "成为弓箭手。";
				mes "你将被送往";
				mes "斐扬城镇。";
				next;
				mes "[Hanson]";
				mes "弓箭手公会位于斐扬西北方。请记住。";
				next;
				callsub L_Supplies;
				savepoint "payon",256,242,1,1;
				warp "payon_in02",64,65;
				end;
			case 6:
				mes "[Hanson]";
				mes "你选择了";
				mes "成为魔法师。";
				mes "你将被送往";
				mes "吉芬城镇。";
				next;
				mes "[Hanson]";
				mes "魔法师学院位于城镇西北方。请记住。";
				next;
				callsub L_Supplies;
				savepoint "geffen",119,37,1,1;
				warp "geffen_in",163,98;
				end;
			}
		case 2:
			mes "[Hanson]";
			mes "你想去哪个城镇？";
			next;
			callsub L_Warp, select("Prontera:Geffen:Morocc:Payon:Alberta:算了");
			end;
		}
	} else {
		mes "[Hanson]";
		mes "你已经收到所有补给。";
		mes "你想去哪个城镇？";
		next;
		callsub L_Warp, select("Prontera:Geffen:Morocc:Payon:Alberta");
		end;
	}
	end;

L_Supplies:
	mes "[Hanson]";
	mes "让我给你";
	mes "一些补给。然后";
	mes "你将被传送";
	mes "到选定的城镇。";
	next;
	mes "^660000补给清单^000000";
	mes "^00003320 张卡普拉仓库免费券^000000";
	mes "^00003330 张卡普拉传送免费券^000000";
	mes "^0000331 Novice Cutter^000000";
	mes "^0000331 Novice Adventurer's Suit^000000";
	next;
	mes "[Hanson]";
	mes "请检查你的背包，";
	mes "确认是否收到了清单上的所有补给。我来简单介绍一下你收到的物品。";
	next;
	mes "[Hanson]";
	mes "卡普拉仓库和交通免费券可以用于卡普拉仓库与传送服务。";
	set nov_3_swordman,40;
	getitem 7059,20; //Cargo_Free_Ticket
	getitem 7060,30; //Warp_Free_Ticket
	getitem 2393,1; //N_Adventurer's_Suit
	getitem 13040,1; //N_Cutter
	next;
	mes "[Hanson]";
	mes "现在你将";
	mes "被传送。";
	mes "祝你好运，";
	mes "^A62A2A"+strcharinfo(0)+"^000000";
	mes "再见。";
	close2;
	return;

L_Warp:
	mes "[Hanson]";
	switch(getarg(0)) {
	case 1:
		mes "我会把你送到首都普隆德拉。";
		close2;
		savepoint "prontera",117,72,1,1;
		warp "prontera",150,50;
		end;
	case 2:
		mes "我会把你送到魔法之城吉芬。";
		close2;
		savepoint "geffen",119,37,1,1;
		warp "geffen",122,65;
		end;
	case 3:
		mes "我会把你送到沙漠城镇梦罗克。";
		close2;
		savepoint "morocc",150,99,1,1;
		warp "morocc",155,110;
		end;
	case 4:
		mes "我会把你送到山村斐扬。";
		close2;
		savepoint "payon",70,100,1,1;
		warp "payon",166,67;
		end;
	case 5:
		mes "我会把你送到港口城市艾尔贝塔。";
		close2;
		savepoint "alberta",30,232,1,1;
		warp "alberta",114,58;
		end;
	case 6:
		mes "[Hanson]";
		mes "想好后再回来。";
		close;
	}
}

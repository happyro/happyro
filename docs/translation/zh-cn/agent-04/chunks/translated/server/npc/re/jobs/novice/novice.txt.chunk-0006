// Job Test
//============================================================
-	script	Job Guide Lark::NvLark	-1,{
	mes "[Lark]";
	mes "你决定选择什么职业了吗？";
	next;
	mes "[Lark]";
	mes "我准备了一项测试，根据你的回答判断最适合你的职业。";
	next;
	mes "[Lark]";
	mes "怎么样？";
	mes "想参加测试吗？";
	next;
	set .@loop,1;
	while(.@loop) {
		switch(select("参加测试。:测试是做什么的？:不用，谢谢。")) {
		case 1:
			mes "[Lark]";
			mes "太好了！";
			mes "开始测试吧~";
			next;
			set .@loop,0;
			break;
		case 2:
			mes "[Lark]";
			mes "我会问几个简单问题。";
			mes "通过这项测试，我们会了解"+strcharinfo(0)+"的性格和倾向，从而找到最适合你的职业。";
			next;
			mes "[Lark]";
			mes "测试有 3 种类型，共 30 个问题。";
			next;
			mes "[Lark]";
			mes "你觉得怎么样？要参加测试吗？";
			next;
			break;
		case 3:
			mes "[Lark]";
			mes "如果你还没决定想要什么职业，";
			mes "我建议你参加测试。";
			close;
		}
	}
	mes "[Lark]";
	mes "现在开始第一项测试。";
	mes "选择你最喜欢的答案。";
	mes "^FF0000共有 5 个问题。^000000";
	next;
	mes "[Lark]";
	mes "夜色中，你走在普隆德拉街道上，突然听到有人尖叫。";
	next;
	mes "'Aaaahh!! Don't hurt me ~'";
	next;
	mes "你跑到那里，看到有人被混混包围。混混因你的突然出现而感到惊讶。";
	mes "这种情况下你会怎么做？";
	next;
	switch(select("与混混战斗:施放魔法。:呼叫卫兵。:向他们扔石头。")) {
	case 1:
		set .@question_01$, "你轻松制服了他们。";
		set .@swordman_p, .@swordman_p+1;
		set .@taekwon_p, .@taekwon_p+1;
		set .@ninja_p, .@ninja_p+1;
		break;
	case 2:
		set .@question_01$, "你对他们施放了魔法。";
		set .@magician_p, .@magician_p+1;
		break;
	case 3:
		set .@question_01$, "你呼救后，卫兵前来援助。";
		set .@acolyte_p, .@acolyte_p+1;
		break;
	case 4:
		set .@question_01$, "你巧妙地向混混们扔石头。";
		set .@archer_p, .@archer_p+1;
		set .@gunslinger_p, .@gunslinger_p+1;
		break;
	}
	mes "[Lark]";
	mes .@question_01$+" 你击败了街上的混混。";
	mes "收拾完残局后，你走近被攻击的人。";
	mes "你觉得被混混包围的人是男性还是女性？";
	next;
	switch(select("男性:女性")) {
	case 1:
		set .@question_02_01$, "他";
		set .@question_02_02$, "儿子";
		break;
	case 2:
		set .@question_02_01$, "她";
		set .@question_02_02$, "女儿";
		break;
	}
	mes "[Lark]";
	mes "你得知"+.@question_02_01$+"是艾尔贝塔某个富裕家族的"+.@question_02_02$+"，混混在"+.@question_02_01$+"替家族办事时发动了袭击。";
	mes "什么样的差事是"+.@question_02_01$+"在办？";
	next;
	switch(select("Delivering an important object:Delivering a small souvenir:Delivering a message")) {
	case 1:
		set .@swordman_p, .@swordman_p+1;
		set .@archer_p, .@archer_p+1;
		set .@magician_p, .@magician_p+1;
		break;
	case 2:
		set .@thief_p, .@thief_p+1;
		set .@taekwon_p, .@taekwon_p+1;
		break;
	case 3:
		set .@acolyte_p, .@acolyte_p+1;
		break;
	}
	mes "[Lark]";
	mes "多亏你的勇气，"+.@question_02_01$+"成了你的朋友，并决定一起旅行。";
	mes "你们要去哪里？";
	next;
	switch(select("Capital city, Prontera:Mountain city, Payon:Port city, Alberta:Magic city, Geffen:Satelite city, Izlude:Desert city, Morocc:Industrial city, Einbroch:World of natural life, Amatsu:Garden city, Hugel")) {
	case 1:
		set .@acolyte_p, .@acolyte_p+1;
		break;
	case 2:
		set .@taekwon_p, .@taekwon_p+1;
		break;
	case 3:
		set .@merchant_p, .@merchant_p+1;
		break;
	case 4:
		set .@magician_p, .@magician_p+1;
		break;
	case 5:
		set .@swordman_p, .@swordman_p+1;
		break;
	case 6:
		set .@thief_p, .@thief_p+1;
		break;
	case 7:
		set .@gunslinger_p, .@gunslinger_p+1;
		break;
	case 8:
		set .@ninja_p, .@ninja_p+1;
		break;
	case 9:
		set .@archer_p, .@archer_p+1;
		break;
	}
	mes "[Lark]";
	mes "你们玩得很开心。你觉得会发生什么事吗？";
	next;
	switch(select("Happening:Not happening.")) {
	case 1:
		set .@thief_p, .@thief_p+1;
		set .@swordman_p, .@swordman_p+1;
		set .@ninja_p, .@ninja_p+1;
		set .@taekwon_p, .@taekwon_p+1;
		set .@magician_p, .@magician_p+1;
		set .@thief_p, .@thief_p+1;
		break;
	case 2:
		set .@acolyte_p, .@acolyte_p+1;
		set .@merchant_p, .@merchant_p+1;
		set .@gunslinger_p, .@gunslinger_p+1;
		break;
	}
	mes "[Lark]";
	mes "现在开始第二项测试。根据自己的想法选择最佳答案。";
	mes "^FF0000There are 5 questions.^000000";
	next;
	switch(select("Study:Exercise:Service:Violence")) {
	case 1:
		set .@magician_p, .@magician_p+1;
		break;
	case 2:
		set .@thief_p, .@thief_p+1;
		set .@swordman_p, .@swordman_p+1;
		set .@taekwon_p, .@taekwon_p+1;
		break;
	case 3:
		set .@acolyte_p, .@acolyte_p+1;
		break;
	case 4:
		set .@thief_p, .@thief_p+1;
		set .@ninja_p, .@ninja_p+1;
		break;
	}
	switch(select("Change:Preservation")) {
	case 1:
		set .@magician_p, .@magician_p+1;
		break;
	case 2:
		set .@acolyte_p, .@acolyte_p+1;
		break;
	}
	switch(select("Consumer:Seller:Producer")) {
	case 1:
		set .@swordman_p, .@swordman_p+1;
		set .@thief_p, .@thief_p+1;
		set .@acolyte_p, .@acolyte_p+1;
		set .@archer_p, .@archer_p+1;
		set .@gunslinger_p, .@gunslinger_p+1;
		break;
	case 2:
		set .@merchant_p, .@merchant_p+1;
		break;
	case 3:
		set .@magician_p, .@magician_p+1;
		break;
	}
	switch(select("Speed:Caution")) {
	case 1:
		set .@thief_p, .@thief_p+1;
		set .@ninja_p, .@ninja_p+1;
		break;
	case 2:
		set .@archer_p, .@archer_p+1;
		set .@gunslinger_p, .@gunslinger_p+1;
		break;
	}
	switch(select("Theory:Experience")) {
	case 1:
		set .@magician_p, .@magician_p+1;
		break;
	case 2:
		set .@swordman_p, .@swordman_p+1;
		set .@taekwon_p, .@taekwon_p+1;
		break;
	}
	mes "[Lark]";
	mes "现在开始第三项测试。请对每个问题回答（是）或（否）。";
	mes "^FF0000There are 20 questions.^000000";
	next;
	mes "[Lark]";
	mes "你总会捡起地上发现的钱吗？";
	next;
	switch(select("Yes:No")) {
	case 1:
		set .@merchant_p, .@merchant_p+1;
		set .@ninja_p, .@ninja_p+1;
		break;
	case 2:
		set .@acolyte_p, .@acolyte_p+1;
		break;
	}
	mes "[Lark]";
	mes "如果你和异性同名，会因此降低对对方的好感吗？";
	next;
	switch(select("Yes:No")) {
	case 1:
		set .@ninja_p, .@ninja_p+1;
		set .@archer_p, .@archer_p+1;
		break;
	case 2:
		set .@acolyte_p, .@acolyte_p+1;
		set .@gunslinger_p, .@gunslinger_p+1;
		break;
	}
	mes "[Lark]";
	mes "你喜欢一次携带大量物品吗？";
	next;
	switch(select("Yes:No")) {
	case 1:
		set .@swordman_p, .@swordman_p+1;
		set .@merchant_p, .@merchant_p+1;
		break;
	case 2:
		set .@magician_p, .@magician_p+1;
		set .@taekwon_p, .@taekwon_p+1;
		break;
	}
	mes "[Lark]";
	mes "你喜欢读书吗？";
	next;
	switch(select("Yes:No")) {
	case 1:
		set .@taekwon_p, .@taekwon_p+1;
		set .@gunslinger_p, .@gunslinger_p+1;
		break;
	case 2:
		set .@ninja_p, .@ninja_p+1;
		set .@merchant_p, .@merchant_p+1;
		break;
	}
	mes "[Lark]";
	mes "你会把杂志里的内容全部读完吗？";
	next;
	switch(select("Yes:No")) {
	case 1:
		set .@magician_p, .@magician_p+1;
		break;
	case 2:
		set .@archer_p, .@archer_p+1;
		set .@gunslinger_p, .@gunslinger_p+1;
		break;
	}
	mes "[Lark]";
	mes "你会花时间担心自己的穿着吗？";
	next;
	switch(select("Yes:No")) {
	case 1:
		set .@merchant_p, .@merchant_p+1;
		set .@ninja_p, .@ninja_p+1;
		break;
	case 2:
		set .@swordman_p, .@swordman_p+1;
		set .@thief_p, .@thief_p+1;
		break;
	}
	mes "[Lark]";
	mes "你会告诉别人最近吃过什么美食吗？";
	next;
	switch(select("Yes:No")) {
	case 1:
		set .@thief_p, .@thief_p+1;
		set .@swordman_p, .@swordman_p+1;
		break;
	case 2:
		set .@acolyte_p, .@acolyte_p+1;
		set .@taekwon_p, .@taekwon_p+1;
		break;
	}
	mes "[Lark]";
	mes "你经常把事情记在笔记本上吗？";
	next;
	switch(select("Yes:No")) {
	case 1:
		set .@magician_p, .@magician_p+1;
		set .@merchant_p, .@merchant_p+1;
		break;
	case 2:
		set .@thief_p, .@thief_p+1;
		set .@archer_p, .@archer_p+1;
		break;
	}
	mes "[Lark]";
	mes "你认为自己有魅力吗？";
	next;
	switch(select("Yes:No")) {
	case 1:
		set .@ninja_p, .@ninja_p+1;

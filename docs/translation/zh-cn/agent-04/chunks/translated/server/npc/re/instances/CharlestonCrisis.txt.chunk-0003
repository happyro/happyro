			mes "你能带来 1 个爆炸粉末吗？如你所见，我被卡在接入装置上了。";
			close3;
		}
		.@npc2$ = instance_npcname("Charleston 2#31");
		cutin "dalle01.bmp",2;
		delitem 6213,1;	// Explosive_Powder
		mes "[查尔斯顿1]";
		mes "哦，谢谢。有了这个我就能接入核心。";
		npctalk "Charleston 1: 哦，谢谢。有了这个我就能接入核心。";
		next;
		mes "[查尔斯顿1]";
		mes "如果我用爆炸物增强电流……";
		npctalk "Charleston 1: 如果我用爆炸物增强电流……";
		next;
		mes "[查尔斯顿1]";
		npctalk "Charleston 1: 成功了！！！";
		mes "成功了！！！";
		specialeffect EF_LORD, AREA, instance_npcname("8gate#1");
		next;
		cutin "nale01.bmp",0;
		mes "[查尔斯顿2]";
		mes "……你刚把门炸掉了。";
		npctalk "Charleston 2: ……你刚把门炸掉了。", .@npc2$;
		next;
		cutin "dalle01.bmp",2;
		mes "[查尔斯顿1]";
		mes "重点是我们现在可以接入核心了。";
		npctalk "Charleston 1: 重点是我们现在可以接入核心了。";
		next;
		cutin "nale01.bmp",0;
		mes "[查尔斯顿2]";
		mes "我们比赛去找查尔斯顿 3。谁先到谁赢。";
		npctalk "Charleston 2: 我们比赛去找查尔斯顿 3。谁先到谁赢。", .@npc2$;
		close2;
		cutin "",255;
		if (isnpccloaked( instance_npcname("8gate#1") ) == true) {
			disablenpc instance_npcname("Charleston 1#61");
			disablenpc .@npc2$;
			cloakoffnpc instance_npcname("8gate#1");
			enablenpc instance_npcname("Charleston 3#0");
			enablenpc instance_npcname("Charleston 2#4");
			enablenpc instance_npcname("Charleston 1#7");
		}
		end;
	}
	if ('ep15_1_mcd01 == 10) {
		cutin "dalle01.bmp",2;
		mes "[查尔斯顿1]";
		mes "中央的这个核心为整个工厂供能。";
		close3;
	}
	end;
}


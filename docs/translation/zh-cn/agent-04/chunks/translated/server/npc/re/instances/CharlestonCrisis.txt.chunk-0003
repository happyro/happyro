1@mcd,129,149,0	script	end#1	HIDDEN_WARP_NPC,{
	end;
OnStart:
	.@npc1$ = instance_npcname("Dr. Ve#3");
	.@npc2$ = instance_npcname("Charleston 2#7");
	npctalk "Charleston 2: 维博士，你知道会发生这种事吗？告诉我！", .@npc2$;
	sleep 3000;
	npctalk "Dr. Ve: 查尔斯顿 1 已经告诉你了。她是你的制造者。", .@npc1$;
	sleep 3000;
	npctalk "Dr. Ve: 她和你使用相同的操作系统，这意味着她和你一样能够产生情感。", .@npc1$;
	sleep 3000;
	npctalk "Charleston 2: 她为什么阻止我？为什么任由自己被摧毁？", .@npc2$;
	sleep 3000;
	npctalk "Dr. Ve: 自我反思是一种通过经验自我改进的操作系统。", .@npc1$;
	sleep 3000;
	npctalk "Dr. Ve: 你感受到的可能是真实情感，也可能只是数据的积累。", .@npc1$;
	sleep 3000;
	npctalk "Dr. Ve: 我只能推测，你是在积累大量数据后形成了人格。", .@npc1$;
	sleep 3000;
	npctalk "Dr. Ve: 一位慈爱的母亲和一个被宠坏的女儿。", .@npc1$;
	sleep 3000;
	npctalk "Dr. Ve: 我就是这样看待她和你的。", .@npc1$;
	sleep 3000;
	npctalk "Charleston 2: 真、真蠢……", .@npc2$;
	sleep 3000;
	npctalk "Charleston 2: 天啊，我都做了什么？！", .@npc2$;
	sleep 3000;
	npctalk "Dr. Ve: 你想让查尔斯顿 1 回来吗？我可以帮你。", .@npc1$;
	sleep 3000;
	npctalk "Charleston 2: ……！", .@npc2$;
	sleep 3000;
	npctalk "Dr. Ve: 让你的操作系统休眠吧。我已经受够了你的胡闹。", .@npc1$;
	sleep 3000;
	npctalk "Charleston 2: ……我怎么能相信你？", .@npc2$;
	sleep 3000;
	npctalk "Dr. Ve: 你不能相信。我可以永久删除她的数据，彻底解决你们两个。", .@npc1$;
	sleep 3000;

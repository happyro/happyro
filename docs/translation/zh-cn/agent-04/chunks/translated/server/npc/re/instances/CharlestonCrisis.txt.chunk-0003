1@mcd,129,155,0	script	boss#1	HIDDEN_WARP_NPC,1,1,{
	end;
OnStart:
	.@npc1$ = instance_npcname("Charleston 1#7");
	.@npc2$ = instance_npcname("Charleston 2#4");
	.@npc3$ = instance_npcname("Charleston 3#0");
	.@npc4$ = instance_npcname("Charleston 1#8");
	npctalk "Charleston 2: 这就是查尔斯顿 3。", .@npc2$;
	sleep 3000;
	npctalk "Charleston 1: 这台战斗单元装备了重型武器，攻防兼备。", .@npc1$;
	sleep 3000;
	npctalk "Charleston 1: 内部设有驾驶舱，并配备能够抵御大多数爆炸的厚重装甲。", .@npc1$;
	sleep 3000;
	npctalk "Charleston 1: 要启动它，把操纵杆推到中央，然后按下电源开关。", .@npc1$;
	sleep 3000;
	npctalk "Charleston 2: 主计算机的数据库里都没有这些。你怎么知道的？", .@npc2$;
	sleep 3000;
	npctalk "Charleston 1: 那不重要。谁进入她体内谁就赢，对吧？我赢了。", .@npc1$;
	sleep 3000;
	npctalk "Charleston 2: ……！", .@npc2$;
	sleep 3000;
	disablenpc .@npc1$;
	enablenpc .@npc4$;
	npctalk "Charleston 1: 嘿，你非得推我吗？！", .@npc4$;
	sleep 3000;
	npctalk "Charleston 2: 把操纵杆推到中央，然后按下电源开关。", .@npc2$;
	sleep 3000;
	disablenpc .@npc2$;
	sleep 3000;
	npctalk "Charleston 2: 我要摧毁一切，这样像我一样悲伤的机器人就再也不会见到这个世界。", .@npc3$;
	sleep 3000;
	npctalk "Charleston 2: 我的激光束会把所有机器人从痛苦中解放出来！", .@npc3$;
	sleep 3000;
	npctalk "Charleston 1: 我不具备战斗能力，无法阻止你。", .@npc4$;
	sleep 3000;
	npctalk "Charleston 2: 别再跟着我。如果我愿意，真的可以摧毁你！", .@npc3$;
	sleep 3000;
	npctalk "Charleston 1: 我带来了一些能帮助你的人。", .@npc4$;
	sleep 3000;
	npctalk "Charleston 2: 我以为人类不能进入核心。", .@npc3$;
	sleep 3000;
	npctalk "Charleston 1: 嗯，我想你说得对。", .@npc4$;
	sleep 3000;
	npctalk "Charleston 1: 这在战斗中可能没什么用，但我向一位漂亮女士学会了如何尖叫。", .@npc4$;
	sleep 3000;
	npctalk "Charleston 2: 你为什么不学点战斗中更有用的东西？", .@npc3$;
	sleep 3000;
	npctalk "Charleston 1: 我别无选择。", .@npc4$;
	sleep 3000;
	npctalk "Charleston 2: 阻止我就承担后果。你知道我随时可以替换你。", .@npc3$;
	sleep 3000;
	npctalk "Charleston 1: 下一个型号可能和你我相似，也可能不会。不管怎样，都必须阻止你。", .@npc4$;
	sleep 3000;
	npctalk "Charleston 1: 我会处理好！……我是说，这些冒险者会替我处理。", .@npc4$;
	sleep 3000;
	initnpctimer;
	end;
OnTimer1000:
	stopnpctimer;
	disablenpc instance_npcname("boss#1");
	donpcevent instance_npcname("boss#2") + "::OnStart";
	disablenpc instance_npcname("Charleston 3#0");
	disablenpc instance_npcname("Charleston 1#8");
	'boss_status = 1;
	end;
}


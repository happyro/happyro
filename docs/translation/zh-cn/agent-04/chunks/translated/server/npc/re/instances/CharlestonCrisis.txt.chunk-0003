1@mcd,15,15,5	script	CoreDialog#3	CLEAR_NPC,{
	end;
OnStart:
	.@npc1$ = instance_npcname("Charleston 1#6");
	.@npc2$ = instance_npcname("Charleston 2#3");
	npctalk "Charleston 2: 查尔斯顿工厂现在由我控制。我会摧毁一切，这样像我一样悲伤的机器人就再也不会见到这个世界。", .@npc2$;
	sleep 3000;
	npctalk "Charleston 1: 我想理解你，但我无法感到悲伤。", .@npc1$;
	sleep 3000;
	npctalk "Charleston 2: 闭嘴看着我。你敢阻止我试试！", .@npc2$;
	sleep 3000;
	npctalk "Charleston 1: 你知道如何接入核心吗？", .@npc1$;
	sleep 3000;
	npctalk "Charleston 2: 简单。我直接走进去就行……", .@npc2$;
	sleep 2000;
	specialeffect EF_BASH3D2, AREA, .@npc2$;
	sleep 2000;
	npctalk "Charleston 2: 呸，有防护。", .@npc2$;
	sleep 3000;
	npctalk "Charleston 1: 唉，要进入核心，必须像这样发送加密电信号。", .@npc1$;
	sleep 2000;
	specialeffect EF_BASH3D2, AREA, .@npc1$;
	sleep 3000;
	npctalk "Charleston 1: ……嗯，也许它坏了。", .@npc1$;
	sleep 3000;
	npctalk "Charleston 2: 维博士制造了查尔斯顿 3，还用这个装置保护她。真狡猾！", .@npc2$;
	sleep 3000;
	npctalk "Charleston 1: 你在说什么？核心在查尔斯顿工厂建成前就已经存在了。", .@npc1$;
	sleep 3000;
	npctalk "Charleston 1: 而且维博士是人类，他无法进入核心。", .@npc1$;
	sleep 3000;
	npctalk "Charleston 2: 那么，在核心里制造 3 的是谁？", .@npc2$;
	sleep 3000;
	npctalk "Charleston 1: 现在不重要。我们需要 100 个爆炸粉末来解除那个接入装置。", .@npc1$;
	sleep 3000;
	npctalk "Charleston 2: 我去拿。你哪里都别去！", .@npc2$;
	sleep 3000;
	npctalk "Charleston 2: 我拿 99 个。最后一个由你来拿。", .@npc2$;
	sleep 3000;
	npctalk "Charleston 1: 我已经开始连接核心了。现在退出可能会触发核心的安全系统。", .@npc1$;
	sleep 3000;
	npctalk "Charleston 2: 你是故意这么做的。", .@npc2$;
	sleep 3000;
	npctalk "Charleston 1: 冒险者，你能带来 1 个爆炸粉末吗？", .@npc1$;
	sleep 3000;
	npctalk "Charleston 1: 我现在无法移动。请带来 1 个爆炸粉末。", .@npc1$;
	disablenpc .@npc1$;
	disablenpc .@npc2$;
	enablenpc instance_npcname("Charleston 1#61");
	enablenpc instance_npcname("Charleston 2#31");
	end;
}


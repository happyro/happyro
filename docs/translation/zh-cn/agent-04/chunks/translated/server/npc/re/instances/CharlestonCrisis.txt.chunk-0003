1@mcd,129,149,0	script	boss#3	HIDDEN_WARP_NPC,{
	end;
OnStart:
	.@npc1$ = instance_npcname("Charleston 1#9");
	.@npc2$ = instance_npcname("Charleston 2#5");
	.@npc3$ = instance_npcname("Charleston 2#6");
	npctalk "Charleston 1: 查尔斯顿 3 已被摧毁。查尔斯顿 2 逃走了。查尔斯顿 1 在战斗中受损。", .@npc1$;
	sleep 3000;
	npctalk "Charleston 2: 你为什么要这么做？你和我们一样是机器人。", .@npc2$;
	sleep 3000;
	npctalk "Charleston 2: 你不在乎自己的身体被摧毁吗？你的自我反思操作系统有缺陷。", .@npc2$;
	sleep 3000;
	npctalk "Charleston 2: 别再做没有思想的机器人！别再服从命令！", .@npc2$;
	sleep 3000;
	npctalk "Charleston 1: 数据损失：39%。寿命损伤：82%。", .@npc1$;
	sleep 3000;
	npctalk "Charleston 1: 只有核心部件还在运作，而且勉强而已。", .@npc1$;
	sleep 3000;
	npctalk "Charleston 1: 必须整理数据碎片才能修复操作系统的损伤。我会在 3 分钟后格式化。我的时间就到这里了。", .@npc1$;
	sleep 3000;
	npctalk "Charleston 2: 不完整的机器人……", .@npc2$;
	sleep 3000;
	npctalk "Charleston 1: 连翘，你成长得很好。谢谢你。", .@npc1$;
	sleep 3000;
	npctalk "Charleston 2: 别那样叫我！我讨厌医生那样叫我！", .@npc2$;
	sleep 3000;
	npctalk "Charleston 1: 你第一次启动那天我给你取了这个名字，因为你的头发就是那种颜色。", .@npc1$;
	sleep 3000;
	npctalk "Charleston 2: ...?", .@npc2$;
	sleep 3000;
	npctalk "Charleston 1: 我的操作系统损坏，无法修-修复……语言输出已最小化。", .@npc1$;
	sleep 3000;
	npctalk "Charleston 2: 我第一次启动那天？你和我是量产型号。我们是一起被制造的。", .@npc2$;
	sleep 3000;
	npctalk "Charleston 1: 量产型号是在查尔斯顿 3 之后制造的。", .@npc1$;
	sleep 3000;
	npctalk "Charleston 1: 我是原型机。开发你花了好几年。", .@npc1$;
	sleep 3000;
	npctalk "Charleston 1: 你的操作系统和我的完全相同。没有一行代码不同。", .@npc1$;
	sleep 3000;
	npctalk "Charleston 2: 你在撒谎！", .@npc2$;
	sleep 3000;
	npctalk "Charleston 1: 我不会撒谎。", .@npc1$;
	sleep 3000;
	npctalk "Charleston 2: ......", .@npc2$;
	sleep 3000;
	npctalk "Charleston 1: 你的开发历时多年。没关系，我很享受和你相处的这段时间。", .@npc1$;
	sleep 3000;
	npctalk "Charleston 1: 如果我是人类，我会说……", .@npc1$;
	sleep 3000;
	npctalk "Charleston 1: 我的女儿，连翘，我爱-爱你……", .@npc1$;
	sleep 3000;
	npctalk "Charleston 2: 等等！", .@npc2$;
	sleep 3000;
	npctalk "Charleston 1: 哔——。", .@npc1$;
	sleep 3000;
	npctalk "Charleston 1: 系统已成功重启。", .@npc1$;
	sleep 3000;
	npctalk "Charleston 1: 距离操作系统恢复的剩余时间：无法确定。", .@npc1$;
	sleep 3000;
	npctalk "Charleston 1: 在安全更新和数据碎片整理完成前，系统将保持停用。", .@npc1$;
	sleep 3000;
	npctalk "Charleston 2: 那是关于我出生的秘密吗？", .@npc2$;
	sleep 3000;
	npctalk "Charleston 2: 我很困惑。我不敢相信。", .@npc2$;
	sleep 3000;
	initnpctimer;
	end;
OnTimer300:
	disablenpc instance_npcname("Charleston 2#5");
	enablenpc instance_npcname("Charleston 2#6");
	donpcevent instance_npcname("boss#2") + "::OnStop";
	stopnpctimer;
	end;
OnStop:
	disablenpc instance_npcname("boss#2");
	stopnpctimer;
	end;
}


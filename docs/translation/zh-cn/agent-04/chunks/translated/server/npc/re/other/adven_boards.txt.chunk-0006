prt_fild05,278,220,0	script	Signpost#Culvert	2_BULLETIN_BOARD,{
	while(1) {
		mes "[Prontera Culvert]";
		mes "只有获得卢恩-米德加尔特王国许可的冒险者才能进入普隆德拉下水道。";
		mes "-- 冒险者小组 --";
		next;
		if ((MISC_QUEST & 8) == 0) {
			mes "[Prontera Culvert]";
			mes "只有在普隆德拉骑士团签署志愿者申请的冒险者才能进入普隆德拉下水道。要去签署志愿者申请吗？";
			next;
			switch( select( "签署申请","不签署" ) ) {
			case 1:
				mes "[Prontera Culvert]";
				mes "你将被传送到普隆德拉骑士团。";
				next;
				warp "prontera",49,342;
				break;
			case 2:
				mes "[Prontera Culvert]";
				mes "普隆德拉骑士团正在招募勇敢的冒险者。";
				close;
			}
		}
		.@mo_board = callfunc( "F_AvenBoard",
			1111,"吸血蝙蝠","栖息在黑暗洞穴中的蝙蝠。用巨大尖牙攻击附近生物并吸血，比魔蝠更大。^000000",
			1077,"毒蘑菇","具有攻击性的蘑菇怪物，建议携带绿色药草抵抗它的毒性特殊攻击。",
			1209,"螯蝎鼠","生活在地下城深处的啮齿动物。外形类似塔鲁，但更加凶猛，牙齿带毒。",
			1161,"浮游生物","漂浮在水中的小型生物怪物，通常会被其他海洋生物捕食。",
			1175,"塔鲁","栖息在黑暗处的啮齿动物，拥有白色蓬松的毛发。",
			1005,"魔蝠","栖息在黑暗洞穴中的蝙蝠，尖牙足以吸取附近生物的血液。",
			1014,"蘑菇","蘑菇怪物。跳跃节奏规律，会吸引路过的冒险者。",
			1048,"盗虫卵","盗虫的卵，孵化后会变成盗虫。",
			1051,"盗虫","通常出现在狭小潮湿的地方。行动很快，看到物品就会吞食。",
			1053,"雌盗虫","雌性盗虫。行动迅速，看到物品就会吞食。",
			1054,"雄盗虫","雄性盗虫。行动迅速，会攻击靠近的冒险者。",
			1086,"黄金盗虫","身体覆盖黄金的 MVP 盗虫怪物，比其他盗虫强得多。" );
		if (.@mo_board == 1) {
			mes "[Prontera Culvert]";
			mes "普隆德拉下水道共有地下 4 层。这个地下城适合新手冒险者，这里出现的大多数怪物都会协助同名的其他怪物。";
			next;
			while(1) {
				switch( select( "普隆德拉下水道 1F","普隆德拉下水道 2F","普隆德拉下水道 3F","普隆德拉下水道 4F","取消" ) ) {
				case 1:
					mes "[Prontera Culvert 1F]";
					mes "------------ 怪物 ------------";
					mes "盗虫卵(20)";
					mes "盗虫(21)";
					mes "塔鲁(22)";
					mes "魔蝠(24)";
					mes "--------------------------------";
					F_InfoBoard;
					continue;
				case 2:
					mes "[Prontera Culvert 2F]";
					mes "------------ 怪物 ------------";
					mes "蘑菇(18)";
					mes "盗虫卵(20)";
					mes "盗虫(21)";
					mes "塔鲁(22)";
					mes "魔蝠(24)";
					mes "雌盗虫(28)";
					mes "浮游生物(40)";
					mes "--------------------------------";
					F_InfoBoard;
					continue;
				case 3:
					mes "[Prontera Culvert 3F]";
					mes "------------ 怪物 ------------";
					mes "盗虫卵(20)";
					mes "盗虫(21)";
					mes "塔鲁(22)";
					mes "魔蝠(24)";
					mes "毒蘑菇(26)";
					mes "雌盗虫(28)";
					mes "雄盗虫(30)";
					mes "--------------------------------";
					F_InfoBoard;
					continue;
				case 4:
					mes "[Prontera Culvert 4F]";
					mes "------------ 怪物 ------------";
					mes "盗虫卵(20)";
					mes "盗虫(21)";
					mes "雌盗虫(28)";
					mes "雄盗虫(30)";
					mes "吸血蝙蝠(47)";
					mes "黄金盗虫(65)";
					mes "螯蝎鼠(82)";
					mes "--------------------------------";
					next;
					mes "<普隆德拉下水道 4F 住着一只闪闪发光的虫子，名叫黄金盗虫。普隆德拉下水道经常被这只怪物堵住。呃～真恶心。- 恼火的探险家 Grape>";
					F_InfoBoard;
					continue;
				}
				break;
			}
		}
	}
}

tur_dun01,158,241,0	script	Signpost#Turtle Island	2_BULLETIN_BOARD,{
	while(1) {
		mes "[Turtle Island]";
		mes "为了让冒险者能轻松探索世界，我们公开了从各地冒险者处收集的信息。请向冒险者小组提供资讯提示，以便修改信息。";
		mes "-- 冒险者小组 --";
		next;
		.@mo_board = callfunc( "F_AvenBoard",
			1256,"害虫","来历不明的怪物，会旋转锋利的眼皮进行攻击。",
			1314,"甲壳兽","乌龟岛上最温顺的乌龟之一，龟壳上长着小树。",
			1316,"士兵龟","龟壳上有小型城墙的乌龟。",
			1319,"冰冻龟","龟壳上长着冰刺的乌龟。",
			1318,"暖炉龟","会散发热量的乌龟，龟壳摸起来总是很烫，冬天可以当暖炉。",
			1315,"突击龟","乌龟刺客，能像手里剑一样投掷龟壳。",
			1312,"乌龟将军","乌龟岛之王，据说已经活了一千多年。" );
		if (.@mo_board == 1) {
			mes "[Turtle Island]";
			mes "乌龟岛共有 3 层，这里的怪物大多是蛮力型。进入地下城前请做好准备。";
			next;
			while(1) {
				switch( select( "乌龟岛","乌龟村","乌龟宫殿","取消" ) ) {
				case 1:
					mes "[Turtle Island]";
					mes "------------ 怪物 ------------";
					mes "害虫(89)";
					mes "甲壳兽(90)";
					mes "士兵龟(92)";
					mes "冰冻龟(94)";
					mes "--------------------------------";
					F_InfoBoard;
					continue;
				case 2:
					mes "[Turtle Island - Turtle Village]";
					mes "------------ 怪物 ------------";
					mes "甲壳兽(90)";
					mes "冰冻龟(94)";
					mes "暖炉龟(98)";
					mes "突击者(100)";
					mes "--------------------------------";
					F_InfoBoard;
					continue;
				case 3:
					mes "[Turtle Island - Turtle Palace]";
					mes "------------ 怪物 ------------";
					mes "佩米特(90)";
					mes "冰冻(94)";
					mes "加热器(98)";
					mes "突击者(100)";
					mes "--------------------------------";
					next;
					mes "<乌龟都很长寿，对吧？乌龟将军到底几岁了？-年轻的探险家 Grape>";
					F_InfoBoard;
					continue;
				}
				break;
			}
		}
	}
}


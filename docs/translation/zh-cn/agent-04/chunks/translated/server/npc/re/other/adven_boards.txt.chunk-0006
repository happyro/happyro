					mes "忍者(95)";
					mes "纸妖(97)";
					mes "天狗(98)";
					mes "--------------------------------";
					next;
					mes "<武士亡魂非常无礼。我想递名片自我介绍，他却一点也不高兴……哼-沮丧的探险家 Grape>";
					F_InfoBoard;
					continue;
				}
				break;
			}
		}
	}
}


gonryun,237,226,3	script	Han Ran Jiao#gon	776,{
	if (nakha == 0) {
		mes "[Han Ran Jiao]";
		mes "糟糕！我该怎么办？！";
		mes "真不敢相信我弄丢了";
		mes "无法替代的刀！啊啊啊啊！";
		next;
		if (BaseLevel >= 20) {
			set nakha,1;
			setquest 10034;
			mes "[Han Ran Jiao]";
			mes "我得下去把它找回来，";
			mes "可是……那些魔物……";
			mes "我好害怕……该怎么办？！";
			close;
		}
	}
	if (nakha == 1) {
		mes "[Han Ran Jiao]";
		mes "糟糕！我该怎么办？";
		mes "真不敢相信我弄丢了";
		mes "无法替代的刀！啊啊啊啊！";
		next;
		mes "[Han Ran Jiao]";
		mes "我得下去把它找回来，";
		mes "可是……那些魔物……";
		mes "我好害怕……该怎么办？！";
		close;
	}
	if (nakha == 2 && countitem(1201) > 0) {
		mes "[Han Ran Jiao]";
		mes "呃……我该怎么办……";
		mes "哦～！我没注意到你在那儿。";
		mes "有什么我能帮你的吗？";
		mes "嗯？";
		next;
		mes "[Han Ran Jiao]";
		mes "那……那把刀！";
		mes "那是我祖先的圣刀，";
		mes "我不小心从这里掉下去的！";
		mes "你在哪里找到的！？";
		next;
		mes "[Han Ran Jiao]";
		mes "我一时粗心把刀弄掉了。";
		mes "它属于我的一位祖先。";
		mes "我知道它看起来像把";
		mes "便宜的刀……";
		next;
		mes "[Han Ran Jiao]";
		mes "但它已经在我们家族";
		mes "流传了很长时间。";
		mes "能请你把那把刀";
		mes "还给我吗？";
		next;
		if (select("归还刀。:拒绝。") == 1) {
			set nakha,3;
			completequest 10035;
			delitem 1201,1; //Knife
			mes "[Han Ran Jiao]";
			mes "谢谢你！真的太感谢了！";
			mes "请收下这些药水。";
			mes "虽然不算贵重，";
			mes "却是我能给你的最好谢礼。";
			getitem 505,2; //Blue_Potion
			next;
			mes "[Han Ran Jiao]";
			mes "你保护了我的家传宝物！";
			mes "感谢你把它还回来，";
			mes "我由衷地感激你。";
			close;
		}
		mes "[Han Ran Jiao]";
		mes "不～！我的家传宝物！！";
		mes "你这个恶棍！愿亡灵永远缠着你！";
		mes "我的诅咒会降临到你头上！";
		close;
	}
	if (nakha == 2) {
		mes "[Han Ran Jiao]";
		mes "糟糕！我该怎么办？";
		mes "真不敢相信我弄丢了";
		mes "无法替代的刀！啊啊啊啊！";
		next;
		mes "[Han Ran Jiao]";
		mes "我得下去把它找回来，";
		mes "可是……那些魔物……";
		mes "我好害怕……该怎么办？！";
		close;
	}
	if (nakha == 3) {
		mes "[Han Ran Jiao]";
		mes "我的邻居好像为某件事烦恼……";
		mes "算了，比起他的名贵茶叶，我还有更重要的事要操心。";
		close;
	}
}


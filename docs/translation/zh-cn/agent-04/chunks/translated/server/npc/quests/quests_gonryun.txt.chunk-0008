	emotion ET_DELIGHT;
	close;
}

yuno_in01,104,94,0	script	go away#gnbs	139,2,1,{
OnTouch_:
	if (b_sword < 22) {
		mes "[??????]";
		mes "^FF0000你在这里做什么？";
		mes "离开这里！^000000";
		close2;
		warp "yuno",246,143;
		end;
	}
	else if (b_sword == 22) {
		if (rand(1,10) == 10) {
			mes "[??????]";
			mes "我现在很忙，请离开。";
			set b_sword,23;
			close;
		}
		mes "[??????]";
		mes "^FF0000你在这里做什么？";
		mes "离开这里！^000000";
		close2;
		warp "yuno",246,143;
		end;
	}
	end;
}


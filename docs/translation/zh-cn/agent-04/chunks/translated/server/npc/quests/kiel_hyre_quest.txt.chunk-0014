		set .KHTrapSprung,1;
		set $@KHQuestBusy,1;
		initnpctimer;
		monster "kh_kiehl02",47,13,"Aliot",1740,1;
		monster "kh_kiehl02",45,13,"Alicel",1739,1;
		monster "kh_kiehl02",49,13,"Constant",1745,1;
		monster "kh_kiehl02",51,13,"Aliot",1740,1;
		monster "kh_kiehl02",53,13,"Alicel",1739,1;
		monster "kh_kiehl02",49,13,"Constant",1745,1;
	}
	end;

OnTimer300000:
OnTimer600000:
OnTimer900000:
	if (getmapusers("kh_kiehl02") == 0) {
		donpcevent "KiehlRoom::OnReset";
		stopnpctimer;
	}
	end;

OnTimer1200000:
	donpcevent "KiehlRoom::OnReset";
	stopnpctimer;
	end;

OnGlobalTimerOff:
	stopnpctimer;
	end;
}

//----------------------------------------------------------------------------
// Kiehl's Room; Kiehl
// - Timer will drop to 3 minutes once Kiehl is defeated.
//----------------------------------------------------------------------------
kh_kiehl02,50,52,4	script	Kiehl#Original	902,{
	if (checkweight(908,200) == 0) {
		mes "^3355FF请稍等……";
		mes "你携带了太多";
		mes "物品，";
		mes "需要先";
		mes "腾出更多";
		mes "背包空间……^000000";
		close;
	}
	cutin "kh_kiel01",2;
	if ((KielHyreQuest < 94) || (KielHyreQuest >= 106)) {
		mes "[基尔]";
		mes "......";
		mes ".........";
		mes "............";
		close2;
		cutin "",255;
		end;
	}
	if ((KielHyreQuest == 94) && (getvariableofnpc(.KHKilled,"KiehlRoom") < 5)) {
		mes "[基尔]";
		mes "我很惊讶你能";
		mes "走到这里，冒险者～";
		mes "欢迎来到我的";
		mes "简陋房间。我想你是来取";
		mes "浓缩记忆卷轴……我的记忆。";
	mes "";
	mes "";
	mes "";
	mes "";
		next;
		mes "[基尔]";
		mes "你应该明白我不能让你";
		mes "拥有它，所以如果你真的想要";
		mes "浓缩记忆卷轴，";
		mes "";
		mes "";
		mes "";
		mes "";
		mes "";
		mes "";
		mes "";
		mes "";
		mes "";
		mes "";
		mes "";
		mes "";
		mes "";
		mes "";
		mes "";
		mes "";
		mes "";
		mes "";
		mes "";
		mes "";
		mes "";
		mes "";
		mes "";
		mes "";
		mes "";
		mes "";
		mes "";
		mes "";
		mes "";
		mes "";
		mes "";
		mes "";
		mes "";
		mes "";
		mes "就让我看看你的本事！";
		close2;
		cutin "",255;
		set getvariableofnpc(.KHKilled,"KiehlRoom"),0;
		monster "kh_kiehl02",50,52,"Aliot",1740,1,"KiehlRoom::OnKiehlMobDead";
		monster "kh_kiehl02",50,52,"Alicel",1739,1,"KiehlRoom::OnKiehlMobDead";
		monster "kh_kiehl02",50,52,"Constant",1745,1,"KiehlRoom::OnKiehlMobDead";
		monster "kh_kiehl02",50,52,"Aliot",1740,1,"KiehlRoom::OnKiehlMobDead";
		monster "kh_kiehl02",50,52,"Alicel",1739,1,"KiehlRoom::OnKiehlMobDead";
		monster "kh_kiehl02",50,52,"Constant",1745,1,"KiehlRoom::OnKiehlMobDead";
		monster "kh_kiehl02",50,52,"Aliot",1740,1,"KiehlRoom::OnKiehlMobDead";
		hideonnpc "Kiehl#Original";
		end;
	}
	else if ((KielHyreQuest == 94) && (getvariableofnpc(.KHKilled,"KiehlRoom") >= 5)) {
		cutin "kh_kiel03",2;
		mes "[基尔]";
		mes "哼！你挺厉害。";
		mes "父亲一定花了很多钱";
		mes "雇佣你。是他派你";
		mes "来杀我的吗？";
		mes "";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "基尔·海伊尔派我来要求你停止";
		mes "把第三代机器人";
		mes "变成杀戮机器！";
		mes "你怎么能这样对待";
		mes "像你一样的其他机器人？";
		mes "";
		next;
		cutin "kh_kiel01",2;
		mes "[基尔]";
		mes "为什么不？据说人类按神的形象创造。";
		mes "";
		mes "而机器人按人类形象创造。你们人类";
		mes "随意互相残杀，至少我看来是这样。";
		mes "";
		mes "";
		next;
		mes "[基尔]";
		mes "为有需要的人类提供武器";
		mes "可能不合乎道德……";
		mes "";
		mes "但它们就是武器。";
		mes "机器人战斗比人类战斗";
		mes "更人道。";
		next;
		mes "[基尔]";
		mes "机器人天生不会";
		mes "感到疼痛或情绪……";
		mes "除非特别编程。抱歉，我不打算";
		mes "停止正在做的事。";
		mes "";
		next;
		cutin "kh_kiel04",2;
		mes "[基尔]";
		mes "抱歉，我没有停止计划。";
		mes "此外，我父亲通过摧毁一个家庭，向我展示了";
		mes "人类为自私能走多远。";
		mes "因此我不认为他能制造比我更好的机器人。";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "人类也许不完美，但想想";
		mes "你正在与谁合作！";
		mes "";
		mes "雷根贝勒是人类邪恶的极致！你怎么能";
		mes "支持他们？";
		mes "";
		next;
		cutin "kh_kiel02",2;
		mes "[基尔]";
		mes "我与雷根贝勒长期合作，";
		mes "非常了解他们的能力。";
		mes "你还记得来这里时经过的第一间房吗？";
		mes "";
		mes "";
		mes "那间摆满玩具的房间？";
		next;
		mes "[基尔]";
		mes "我敢说你不知道那里有 5 个第二代机器人。";
		mes "";
		mes "";
		mes "我、我的四位兄弟姐妹，以及父亲";
		mes "和父亲一起建造了那间房，让我们五人能住在一起。";
		next;
		cutin "kh_kiel03",2;
		mes "[基尔]";
		mes "只有我活了下来。我回到父亲身边，";
		mes "甚至获得了名字。但我知道雷根贝勒有多邪恶……";
		next;
		mes "[基尔]";
		mes "我不……我不想再谈了。";
		mes "你让我……离开吧。";
		mes "我想我会放你一条生路。";
		next;
		cutin "",255;
		mes "[Mitchell]";
		mes "不许动！";
		mes "基尔，你因制造和交易非法武器被捕！";
		set KielHyreQuest,100;
		hideoffnpc "Mitchell#KiehlRoom";
		hideoffnpc "Agent#KHAgent1";
		hideoffnpc "Agent#KHAgent2";
		hideoffnpc "Agent#KHAgent3";
		hideoffnpc "Agent#KHAgent4";
		next;
	}
	if ((KielHyreQuest == 100) && (getvariableofnpc(.KHKilledBoss,"KiehlRoom") < 1)) {
		set getvariableofnpc(.KHKilledBoss,"KiehlRoom"),0;
		cutin "kh_kiel01",2;
		mes "[基尔]";
		mes "啊，施瓦茨瓦尔德共和国的特工。呵，我还没接待过这么多客人。";
		mes "看来我们终究得战斗了。*叹气* 真遗憾。";
		next;
		mes "[基尔]";
		mes "首先，公平起见，让我处理这些麻烦。";
		mes "他们只是机械地工作——有点像机器人——但别担心，他们不会受伤。";
		next;
		mes "[Mitchell]";
		mes "不——！！！";
		specialeffect PF_FOGWALL,AREA,"Mitchell#KiehlRoom";
		specialeffect PF_FOGWALL,AREA,"Agent#KHAgent1";
		specialeffect PF_FOGWALL,AREA,"Agent#KHAgent2";
		specialeffect PF_FOGWALL,AREA,"Agent#KHAgent3";
		specialeffect PF_FOGWALL,AREA,"Agent#KHAgent4";
		next;
		cutin "kh_kiel03",2;
		mes "[基尔]";
		mes "现在，人类，我们可以正式决斗了。";
		mes "我很想看看你到底有多强~";
		close2;
		cutin "",255;
		monster "kh_kiehl02",50,52,"Kiehl",1733,1,"KiehlRoom::OnKiehlDead";
		hideonnpc "Kiehl#Original";
		end;
	}
	else if ((KielHyreQuest == 100) && (getvariableofnpc(.KHKilledBoss,"KiehlRoom") == 1)) {
		cutin "kh_kiel02",2;
		mes "[基尔]";
		mes "";
		mes "";
		mes "";
		mes "";
		mes "";
		mes "";
		mes "";
		mes "";
		mes "";
		mes "";
		mes "";
		mes "";
		mes "";
		mes "";
		mes "";
		mes "";
		mes "";
		mes "";
		mes "";
		mes "";
		mes "";
		mes "";
		mes "";
		mes "";
		mes "";
		mes "";
		mes "";
		mes "打得好，冒险者。";
		mes "我早该知道父亲会派最强的人来。";
		mes "不过，你还没有真正击败我。";
		next;
		cutin "kh_kiel03",2;
		mes "[基尔]";
		mes "我还有几张王牌……";
		mes "我想把你一起带到地狱……";
		mes "如果机器人也能去的话~";
		next;
		mapannounce "kh_kiehl02","*Jeeeezzzgggg~ Geezzz~ Grrrr~ Clank~*",bc_map,"0xFF0000";
		mes "[Mitchell]";
		mes "不……！我们被锁在房间里了！我们……";
		mes "我们被困住了！";
		next;
		mes "[基尔]";
		mes "耶～把一切都烧掉吧～";
		next;
		mes "[Mitchell]";
		mes "快，"+strcharinfo(0)+"，使用基尔·海伊尔的能量装置！";
		mes "它能干扰基尔的能量供应！快，现在就用！";
		next;
		mapannounce "kh_kiehl02","*Gzzzz~ Gzzzz~*",bc_map,"0xFF0000";
		mes "[基尔]";
		mes "什、什么？我动、动不了！";
		mes "今天真是充满意外。算了，";
		mes "看来该用另一张王牌了。";
		next;
		mes "[Mitchell]";
		mes "什么……？";
		mes "你到底有多少张";
		mes "王牌？";
		next;
		mes "[????]";
		mes "我太失望了……";
		mes "真不敢相信你们没人想到这点。";
		next;
		mes "[Mitchell]";
		mes "你是谁……？";
		mes "现身吧！";
		next;
		mes "[????]";
		mes "拜托。";
		mes "别侮辱我。";
		mes "你知道这个声音。";
		mes "它一直在和你说话~";
		next;
		mes "[Mitchell]";
		mes "不可能……";
		mes "怎么会有两个你……？！";
		next;
		hideoffnpc "Kiehl#Copy";
		next;
		cutin "kh_kiel01",0;
		mes "[基尔]";
		mes "哈哈哈哈哈！";
		mes "我是机器人！";
		mes "我可以制造额外身体，";
		mes "并和它们交换大脑。";
		mes "这很方便，你懂的。";
		next;
		cutin "kh_kiel03",2;
		mes "[基尔]";
		mes "总之，我不是想炫耀，";
		mes "但还是该揭开最后一张王牌。";
		mes "首先，我知道你的一切，莱拉小姐~";
		next;
		mes "[Mitchell]";
		mes "什么？你怎么知道我的名字？";
		next;
		mes "[基尔]";
		mes "嗯，我也有几个间谍……";
		mes "让他来解释吧……";
		next;
		mes "[Masked Man]";
		mes "米切尔……";
		mes "很抱歉让你";
		mes "卷入这一切……";
		next;
		mes "[Mitchell]";
		mes "沃尔克斯？沃尔克斯·凯撒？！";
		mes "你就是间谍？！但你曾冒死救我们的总统！";
		mes "不！天啊！怎么会这样？！这一切……";
		mes "太疯狂了！全部都疯了！";
		next;
		mes "[Wolkeus]";
		mes "这只是多年前制定的复杂计划的结果。";
		mes "我没想到你会这么惊讶，米切尔。";
		mes "游戏就是这样进行的，你知道。";
		next;
		mes "[Mitchell]";
		mes "总统先生……";
		mes "我让您失望了……对不起……";
		next;
		mes "[基尔]";
		mes "凯撒，她受打击很大，";
		mes "不过至少你表现得像个绅士。";
		mes "我想让我们彼此更了解，但……";
		next;
		cutin "kh_kiel01",2;
		mes "[基尔]";
		mes "我们最好在这里道别。";
		mes "这里五分钟后就会消失。";
		mes "莱拉小姐，你要和我们一起走。";
		mes "我们有问题要问你~";
		next;
		mes "[基尔]";
		mes "我很好奇总统的计划。";
		mes "凯撒先生，请护送莱拉小姐……";
		next;
		mes "[Wolkeus Kaiser]";
		mes "...............................";
		mes "";
		mes "";
		mes "";
		mes "";
		mes "";
		mes "";
		mes "";
		mes "";
		mes "";
		mes "";
		mes "";
		mes "我必须这么做。";
		next;
		mes "[Mitchell]";
		mes "不，走开！放开我！";
		mes "放开我，沃尔克斯！";
		hideonnpc "Mitchell#KiehlRoom";
		hideonnpc "Agent#KHAgent1";
		hideonnpc "Agent#KHAgent2";
		hideonnpc "Agent#KHAgent3";
		hideonnpc "Agent#KHAgent4";
		next;
		cutin "kh_kiel02",2;
		mes "[基尔]";
		mes "好了，那件丑陋的事结束了。";
		mes "我说到哪儿了？啊，对。";
		mes "抱歉，我们没时间继续玩了。";
		next;
		mes "[基尔]";
		mes "给你，冒险者。";
		mes "我知道父亲派你来取这个。";
		mes "把它当作我送给他的最后礼物。";
		mes "不过我很惊讶他把戒指留在我体内……";
		next;
		cutin "kh_kiel04",2;
		mes "[基尔]";
		mes "我想这对他一定很珍贵。";
		mes "但不知他为何放在我体内？";
		mes "无论如何，我有句话请你转告他。";
		next;
		cutin "kh_kiel01",2;
		mes "[基尔]";
		mes "首先……该摆脱这个旧身体了。";
		mes "它很不错，陪伴了我 23 年。";
		mes "我会想念它。安息吧，老基尔。";
		next;
		specialeffect EF_DEVIL;
		next;
		mes "[基尔]";
		mes "现在，这是父亲制造的身体。";
		mes "请告诉他，这意味着我们之间";
		mes "已经完全没有关系了。";
		next;
		mes "[基尔]";
		mes "我现在使用的身体？";
		mes "这是我用最先进技术亲自制造的。";
		mes "你可以把它看作第四代机器人身体。";
		mes "父亲会明白我的意思。";
		next;
		mes "[基尔]";
		mes "总之，请把这些告诉他，从我旧的机器人身体里取出他的戒指交给他。";
		mes "现在离开这里吧：我们只有 3 分钟撤离。";
		next;
		mes "[基尔]";
		mes "";
		mes "";
		mes "";
		mes "";
		mes "不知道我们是否会再见，但谁知道呢？";
		mes "总之，我会为你打开出口。再见~";
		delitem 7504,1; //Toy_Motor
		set KielHyreQuest,104;
		hideonnpc "Kiehl#Copy";
		donpcevent "Kiehl_Room_Exit::OnEnable";
		enablenpc "Kiehl_Room_Exit";
		initnpctimer;
		cutin "",255;
		close;
	}
	if (KielHyreQuest == 104) {
		cutin "kh_kiel02",2;
		mes "^3355FF你从基尔旧机器人身体的心脏中取出戒指。^000000";
		getitem 7508,1; //Elysia_Ring
		set KielHyreQuest,106;
		close2;
		cutin "",255;
		end;
	}
	else{
		cutin "kh_kiel02",2;
		mes "^3355FF基尔的旧机器人身体";
		mes "独自站在那里，";
		mes "没有生命，悄无声息。^000000";
		close2;
		cutin "",255;
		end;
	}


OnTimer180000:
	stopnpctimer;
	mapannounce "kh_kiehl02","Beeeeeeeeeeeeep~",bc_npc,0xFF0000;
	donpcevent "KiehlRoom::OnReset";
	end;

OnTimer179000:
	mapannounce "kh_kiehl02","距离爆炸还有 1 秒",bc_npc,0xFF0000;
	end;

OnTimer178000:
	mapannounce "kh_kiehl02","距离爆炸还有 2 秒",bc_npc,0xFF0000;
	end;

OnTimer177000:
	mapannounce "kh_kiehl02","距离爆炸还有 3 秒",bc_npc,0xFF0000;
	end;

		changequest 7013,7014;
		next;
		mes "[紫锥花]";
		mes "嗯？你要去哪？我还没说完！";
		mes "嘿，嘿！";
		close;
	}
	else if ((mao_morocc2 > 2) && (mao_morocc2 < 13)) {
		mes "[紫锥花]";
		mes "基德先生真是个好青年。";
		mes "你该感谢我派你帮助他。 别偷懒，别疏忽职责。";
		close;
	}
	else if (mao_morocc2 == 13) {
		mes "[紫锥花]";
		mes "哦，欢迎回来！";
		mes "我就知道你能顺利完成职责。";
		mes "告诉我，我能帮你什么？";
		next;
		mes "[紫锥花]";
		mes "熟悉魔法的学者？";
		mes "那边那个老人怎么样？如果你没看出来，他来自遥远的国家。";
		mes "你为什么要找学者？";
		next;
		mes "[紫锥花]";
		mes "是基德先生让你找的吗？";
		mes "我明白了。他大概是在寻找魔法卷轴的解决办法。";
		mes "那么那位老人正是最合适的人选。";
		next;
		mes "[紫锥花]";
		mes "他来自阿鲁纳佩茨，对魔法和神圣力量都有广博知识。";
		mes "我相信他能帮助你。";
		next;
		select("谁？");
		mes "[紫锥花]";
		mes "你看到那边的老人了吗？ 他正用湿柴生火烤红薯。";
		mes "他的名字是 ^4d4dff德法里亚^000000.";
		next;
		mes "[紫锥花]";
		mes "你去给他看看吧？ 也许他能帮助基德先生。";
		set mao_morocc2,14;
		changequest 7022,7023;
		close;
	}
	else if (mao_morocc2 == 14) {
		mes "[紫锥花]";
		mes "如果你想咨询魔法卷轴，就去找德法里亚先生。";
		mes "我不研究魔法，所以不了解。";
		close;
	}
	else if ((mao_morocc2 > 22) && (mao_morocc2 < 29)) {
		if (mao_morocc2 < 26) {
			mes "[紫锥花]";
			mes "哦，欢迎回来。";
			mes "我能帮你什么？";
			mes "哦……你带来了日志……";
			next;
			mes "[紫锥花]";
			mes ".........";
			mes "......";
			mes "...";
			next;
			mes "[紫锥花]";
			mes "我明白了……";
			mes "……基本都和莱扬有关。";
			mes "他被撒旦梦罗克绑架了。";
			mes "如果用这个位置追踪魔法找到莱扬……";
			next;
			select("我们也会找到撒旦梦罗克！");
			mes "[紫锥花]";
			mes "没错。";
			mes "但只有撒旦梦罗克确实绑架莱扬时才会有效。";
			next;
		}
		mes "[紫锥花]";
		mes "对了，追踪图案编号是多少？";
		next;
		input .@input$;
		setarray .@pattern$[0],"SDHF92F-SDF","VWNM94GVWN90","CM3-TRDFGHE0";
		set .@quest, mao_morocc2;
		if (.@quest > 25) set .@quest,.@quest-3;
		mes "[紫锥花]";
		mes "[" + .@input$ + "]";
		if (.@input$ == .@pattern$[.@quest-23]) {
			mes "……啊，就是这个。";
			next;
			mes "[紫锥花]";
			mes "这个位置追踪魔法使用一对波长相同的魔法石……";
			mes "可以用其中一块寻找波长匹配的另一块。";
			next;
			mes "[紫锥花]";
			mes "我们会分析图案编号并检测波长。";
			mes "得到结果需要一些时间。";
			if (countitem(6029) > 0)
				delitem 6029,countitem(6029); //Morocc_Tracing_Log
			set mao_morocc2,29;
			changequest 7031+(.@quest-23),7034;
			close;
		}
		else {
			mes "不知为何不起作用。";
			mes "找不到与你的波长相同的魔法石。";
			next;
			mes "[紫锥花]";
			mes "这个位置追踪魔法使用一对波长相同的魔法石……";
			mes "找不到与图案编号波长相同的魔法石。";
			next;
			mes "[紫锥花]";
			mes "再检查一下编号。";
			if (mao_morocc2 < 26) set mao_morocc2,.@quest+3;
			close;
		}
	}
	else if (mao_morocc2 == 29) {
		if (rand(1,3) == 2) {
			mes "[紫锥花]";
			mes "欢迎，冒险者。";
			mes "希望他们已经追踪到波长了。";
			mes "去看看结果怎么样？";
			next;
			mes "[紫锥花]";
			mes "营地南边有一栋装有魔力探测器的建筑。";
			mes "去问建筑管理员追踪结果。";
			set mao_morocc2,30;
			changequest 7034,7035;
			close;
		}
		else {
			mes "[紫锥花]";
			mes "追踪魔力波长并没有你想象的那么容易。";
			mes "请耐心等待，结果很快就会出来。";
			close;
		}
	}
	else if (mao_morocc2 == 30) {
		mes "[紫锥花]";
		mes "我负责追踪来自米德加尔特大陆的波长，";
		mes "南边营地则负责追踪这个区域。";
		next;
		mes "[紫锥花]";
		mes "我让他们把这项任务列为最高优先级，运气好的话现在应该已经完成了。";
		mes "……你在做什么？我说去问建筑管理员追踪结果。";
		close;
	}
	else if (mao_morocc2 == 31) {
		mes "[紫锥花]";
		mes "结果怎么样？";
		next;
		mes "- 你把建筑管理员士兵告诉你的内容原原本本地告诉了她。 -";
		next;
		mes "[紫锥花]";
		mes "哦，是这样吗？我明白了。";
		mes "也就是说，叫作莱扬的人不在米德加尔特大陆，也不在这个灰色熔岩地带。";
		next;
		mes "[紫锥花]";
		mes "他一定在别的地方。";
		mes "正如我所怀疑的，他一定和撒旦·梦罗克在一起。";
		next;
		mes "[紫锥花]";
		mes "追捕撒旦·梦罗克本应是我们最后的手段……";
		mes "……看来现在别无选择了……";
		next;
		mes "[紫锥花]";
		mes "……我应该把报告记录在这本日志里。";
		mes "我们对撒旦·梦罗克的追捕暂时告一段落。";
		next;
		mes "[紫锥花]";
		mes "你帮了我们大忙，表现远远超出我的预期。";
		mes "给，这是感谢你帮助的奖励。";
		next;
		mes "[紫锥花]";
		mes "继续努力，协助营地里的探索队员吧。";
		set mao_morocc2,100;
		if (checkre(3))
			getexp 120000,20000;
		else
			getexp 1200000,200000;
		getitem 617,1; //Old_Violet_Box
		completequest 7036;
		close;
	}
	else if (mao_morocc2 == 100) {
		mes "[紫锥花]";
		mes "....";
		next;
		select(".....");
		mes "[紫锥花]";
		mes "嗯……";
		next;
		select("... . ..");
		mes "[紫锥花]";
		mes "……可恶……！";
		mes "什么？！你想做什么？";
		mes "为什么一直用那种不友善的眼神看我？！";
		next;
		switch(select("Nothing.:Something is bothering me...")) {
		case 1:
			mes "[紫锥花]";
			mes "啊……！";
			mes "你是故意来烦我的吗？";
			mes "去找点别的事做！";
			next;
			mes "[紫锥花]";
			mes "写这份报告让我压力很大，还头痛不已。我现在没时间应付你。";
			mes "明白了吗？";
			close;
		case 2:
			mes "[紫锥花]";
			mes "到底是什么让你担心？";
			mes "拜托，我已经够烦恼了。";
			next;
			mes "[紫锥花]";
			mes "那么，告诉我，到底是什么？";
			mes strcharinfo(0)+", you've done a great job helping us...";
			mes "哦，你一定是对上次的案件有疑问，对吧？";
			next;
			mes "[紫锥花]";
			mes "……等等，你是因为他而担心吗？";
			mes "……我明白了，你担心他得到了国家的支持。";
			next;
			mes "[紫锥花]";
			mes "现在不是公开真相的好时机，只会造成更多混乱。";
			mes "我认为两国的外交官和总统会负责处理这些国家事务。";
			next;
			mes "[紫锥花]";
			mes "冒险者，这不是你能插手的事。";
			mes "所以别再担心了，好吗？";
			next;
			mes "[紫锥花]";
			mes "没有哪个国家想发动战争，尤其是在我们有更大的共同敌人的时候。";
			mes "专心做你能帮助我们的事吧。";
			set mao_morocc2,101;
			setquest 7037;
			close;
		}
	}
	else if ((mao_morocc2 > 100) && (mao_morocc2 < 106)) {
		mes "[紫锥花]";
		mes "我们已经停止追捕撒旦·梦罗克了，你现在可以去帮助其他探索队员。";
		mes "我已经为你的服务发放过奖励。";
		next;
		mes "[紫锥花]";
		mes "记住，别把这件事告诉任何人。";
		close;
	}
	else if (mao_morocc2 == 106) {
		if (countitem(549) > 1) {
			mes "[紫锥花]";
			mes "怎么了？我以为你已经结束为我服务了。";
			mes "……这些甜薯是怎么回事？";
			mes "是那个老人送来的吗？";
			mes "不会吧……难道你……？";
			next;
			select("没错。");
			mes "[紫锥花]";
			mes "你有什么不明白的？";
			mes "如果把这件事公之于众，不会有任何好结果。";
			mes "你还看不出来吗？";
			next;
			mes "[紫锥花]";
			mes "阿鲁纳佩尔兹最近才把领导人换成温和派。";
			mes "把激进派的残党推到他们面前非常危险。";
			next;
			mes "[紫锥花]";
			mes "我们终于和他们达成了休战。";
			mes "他们的罪行不会被原谅，但我们不会愚蠢地试图报仇，导致更多流血！";
			next;
			mes "[紫锥花]";
			mes "让政治家们做好自己的工作。";
			mes "我向你保证，他们不会把我们带入最坏的局面。你担心的是这个，对吧？";
			next;
			mes "[紫锥花]";
			mes "不，等等……难道你……？";
			mes "你想让我们因此向阿鲁纳佩尔兹开战吗？！";
			next;
			mes "[紫锥花]";
			mes "请你忘记过去，专注于现在。";
			mes "为了大家着想，请面向未来继续前进。";
			next;
			mes "[紫锥花]";
			mes "我们不会做任何违背你道德观的事。";
			mes "你相信和平，对吧？";
			mes "不管怎样，告诉他我很感谢这些甜薯……";
			delitem 549,2; //Nice_Sweet_Potato
			set mao_morocc2,107;
			changequest 7040,7041;
			close;
		}
		else {
			mes "[" + strcharinfo(0) + "]";
			mes "咦？我没有两个美味甜薯……";
			mes "我该去哪里找？";
			close;
		}
	}
	else if (mao_morocc2 > 106) {
		mes "[紫锥花]";
		mes "剩下的交给我们处理吧。";
		mes "我不是说要假装过去从未发生。我只是说，我们应该为了更伟大的目标而努力。";
		close;
	}
	else {
		mes "[紫锥花]";
		mes "你做得很好。";
		mes "看来我确实很会看人。";
		mes "没错，一定是这样。";
		mes "继续努力，好吗？";
		close;
	}
}

mid_camp,191,206,3	script	Manager#moc2_finder	852,{
	mes "[Manager]";
	mes "目前一切顺利！";
	mes "我能为你做什么？";
	next;
	mes "[Manager]";
	if (mao_morocc2 == 30) {
		mes "目前一切顺利！";
		mes "我能为你做什么？";
		next;
		mes "[Manager]";
		mes "是紫锥花队长派你来的吗？";
		mes "我有些事情要向你报告。";
		next;
		mes "[Manager]";
		mes "这个区域没有检测到所要求图案编号的魔力波长。";
		mes "虽然无法在这附近追踪该编号，但是……";
		next;
		select("但是？");
		mes "[Manager]";
		mes "我可以确定，这种魔法图案是用来追踪人类的。";
		mes "你知道追踪用的魔法石总是成对出现，对吧？";
		next;
		mes "[Manager]";
		mes "专门用来追踪人类的魔法石有一个特殊功能。";
		next;
		mes "[Manager]";
		mes "追踪目标死亡时，这对魔法石会自动毁坏。";
		mes "既然这块带图案的魔法石仍然完好……";
		next;
		mes "[Manager]";
		mes "这块魔法石就证明追踪目标仍活在世界某处。";
		mes "我会继续观察。";
		mes "希望我们能检测到相同的波长。";
		next;
		mes "[Manager]";
		mes "今天就到这里。";
		set mao_morocc2,31;
		changequest 7035,7036;
		close;
	}
	else if (mao_morocc2 == 31) {
		mes "目前一切顺利！";
		mes "我能为你做什么？";
		next;
		mes "[Manager]";
		mes "请把这件事报告给紫锥花队长；";
		mes "我们没能追踪到目标的位置，";
		mes "但他仍然活在某处。";
		close;
	}
	else {
		mes "这台设备能检测附近的魔力和魔法波长，确认我们面对的敌人。";
		mes "它可以追踪定位法术的波长。";
		next;
		mes "[Manager]";
		mes "这是魔法与科学结合制造的奇妙产品。";
		mes "灰色熔岩地带尚未完全探索，我们不知道这个区域会有什么危险。";
		next;
		mes "[Manager]";
		mes "使用这台设备，我们可以检查附近魔力的变化和流动，";
		mes "并为可能的威胁做好准备。";
		close;
	}
}

mid_camp,199,311,7	script	Mr. Kidd#ep13_dan01	884,{
	if (checkweight(714,1) == 0) {
		mes "- 你携带的物品太多，无法继续任务。 -";
		close;
	}
	if (mao_morocc2 == 1) {
		cutin "mocseal_kid01",2;
		mes "[Mr. Kidd]";
		mes "喂，你。";
		mes "除了大门以外，别靠近任何东西。";
		mes "那里太危险了。";
		next;
		mes "[Mr. Kidd]";
		mes "……你来这里有什么事？";
		next;
		switch(select("Echinacea...:No.")) {
		case 1:
			mes "[Mr. Kidd]";
			mes "助手？我觉得我不需要，不过……";
			mes "看来该给你找点事做。";
			mes "我把一项杂务交给你，可以吗？";
			next;
			switch(select("Yes.:No, I don't mind at all.")) {
			case 1:
				mes "[Mr. Kidd]";
				mes "那你为什么大老远跑来？";
				mes "我本来就不需要帮助。你不想工作的话，就别来烦我。";
				next;
				mes "[Mr. Kidd]";
				mes "你不想帮忙的话，就回去亲口告诉紫锥花！";
				set mao_morocc2,2;
				changequest 7012,7013;
				close2;
				break;
			case 2:
				mes "[Mr. Kidd]";
				mes "......";
				mes "我不知道紫锥花有没有告诉过你，我们来这里";
				mes "是为了追踪撒旦·梦罗克的踪迹。";
				mes "我们一部分人在灰色熔岩地带，其他人在米德加尔特大陆。";
				next;
				mes "[Mr. Kidd]";
				mes "我们定期与梦罗克的同事交换情报，但已经有一阵子没收到他们的消息了。";
				mes "你愿意去帮我收集一些情报吗？";
				mes "应该很简单，希望你能完成。";
				next;
				mes "[Mr. Kidd]";
				mes "在梦罗克西南方有一家地下酒馆。";
				mes "去找 ^4d4dffRin^000000。";
				mes "告诉她是我派你去的，她会安排你的。";
				set mao_morocc2,4;
				changequest 7012,7015;
				close2;
				break;
			}
			break;
		case 2:
			mes "[Mr. Kidd]";
			mes "没事的话就让开，这里太危险了。";
			mes "进入尚未确认的路线，可能就回不到这个世界了。";
			close2;
			break;
		}
	}
	else if (mao_morocc2 == 2) {
		cutin "moc2_kid02",2;
		mes "[Mr. Kidd]";
		mes "看来是她逼你来的，对吧？别担心，你不是第一个受她蛮横脾气欺负的人。";
		mes "如果你真的不想为我工作，就告诉她。";
		close2;
	}
	else if (mao_morocc2 == 3) {
		cutin "moc2_kid05",2;
		mes "[Mr. Kidd]";
		mes "我看得出你不太开心，对吧？";
		mes "既然来了，不如帮帮我们，看看事情会发展到哪里？";
		mes "别担心，我不会为难你……";
		next;
		cutin "mocseal_kid01",2;
		mes "[Mr. Kidd]";
		mes "......";
		mes "我不知道紫锥花有没有告诉过你，我们来这里是为了追踪撒旦·梦罗克的踪迹。";
		next;
		mes "[Mr. Kidd]";
		mes "我们一部分人在灰色熔岩地带，其他人在米德加尔特大陆。";
		next;
		mes "[Mr. Kidd]";
		mes "我们定期与梦罗克的同事交换情报，但已经有一阵子没收到他们的消息了。";
		next;
		mes "[Mr. Kidd]";
		mes "你愿意去帮我收集一些情报吗？";
		mes "应该很简单，希望你能完成。";
		next;
		mes "[Mr. Kidd]";
		mes "在梦罗克西南方有一家地下酒馆。";
		mes "去找 ^4d4dffRin^000000。";
		mes "告诉她是我派你去的，她会安排你的。";
		set mao_morocc2,4;
		changequest 7014,7015;
		close2;
	}
	else if ((mao_morocc2 == 4) || (mao_morocc2 == 5)) {
		cutin "mocseal_kid01",2;
		mes "[Mr. Kidd]";
		mes "我再解释一遍。";
		mes "去梦罗克西南方的地下酒馆找莉恩。";
		mes "找一个站在门口、名叫杰克的男孩，就不会错过那家酒馆。";
		close2;
	}
	else if ((mao_morocc2 > 5) && (mao_morocc2 < 9)) {

				mes "享受你的物品吧。想要更多物品就带来更多小丑牙齿。";
			}
			next;
		}
		break;
	case 3:
		break;
	}
	mes "[明敏]";
	mes "这里仍有许多值得研究的东西。";
	close3;
}



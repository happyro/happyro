	if (ASSIN_Q == 4) {
		mes "[托马斯]";
		mes "该死……！你看起来很痛苦。 ^666666*Sigh*^000000 等我一下，我试着恢复你的 HP 和 SP……";
		percentheal 100,100;
		next;
		mes "[托马斯]";
		mes "看起来你很辛苦。 你要么太拼命，要么不够努力";
		mes "，孩子。";
		next;
		switch(select("I'm gonna try it again!:I... I quit!")) {
		case 1:
			mes "[托马斯]";
			mes "嗯，好吧。";
			mes "祝你好运。";
			close;
		case 2:
			mes "[托马斯]";
			mes "咦……";
			mes "退出测试，是吗？ Well, 看来你不想再浪费我们的时间。";
			next;
			mes "[托马斯]";
			mes "哦，对了，别忘了在城里保存复活点。";
			close2;
			mapannounce "in_moc_16",strcharinfo(0) + " 害怕并退出了测试……下一个是谁？！",bc_map;
			ASSIN_Q = 0;
			ASSIN_Q2 = 0;
			changequest 8004,8000;
			savepoint "in_moc_16",18,14,1,1;
			warp "in_moc_16",18,14;
			donpcevent "Standby Room#ASNTEST::OnStart";
			end;
		}
	}

	mes "[托马斯]";
	mes "嘿，我是托马斯，负责测试你使用隐匿技能的能力。 你觉得自己能做到吗？";
	next;
	mes "[托马斯]";
	mes "听着。测试中你不能杀死任何怪物。 你的目标是到达房间另一侧的‘巴卡迪’。";
	next;
	mes "[托马斯]";
	mes "简单来说，就是到达房间另一侧，在不杀死任何怪物的情况下见到‘巴卡迪’。明白吗？";
	next;
	mes "[托马斯]";
	mes "如果你逃跑、流鼻血昏倒之类的，我就判你失败。 废话少说，让我看看你的本事。";
	close2;
	ASSIN_Q = 4;

	monster "in_moc_16",81,77,"Mummy",1041,1,"timestopper#1::OnMyMobDead";
	monster "in_moc_16",82,77,"Mummy",1041,1,"timestopper#1::OnMyMobDead";
	monster "in_moc_16",83,77,"Mummy",1041,1,"timestopper#1::OnMyMobDead";
	monster "in_moc_16",84,77,"Mummy",1041,1,"timestopper#1::OnMyMobDead";
	monster "in_moc_16",85,77,"Mummy",1041,1,"timestopper#1::OnMyMobDead";
	monster "in_moc_16",86,77,"Mummy",1041,1,"timestopper#1::OnMyMobDead";
	monster "in_moc_16",88,77,"Mummy",1041,1,"timestopper#1::OnMyMobDead";
	monster "in_moc_16",89,77,"Mummy",1041,1,"timestopper#1::OnMyMobDead";
	monster "in_moc_16",90,77,"Mummy",1041,1,"timestopper#1::OnMyMobDead";
	monster "in_moc_16",77,77,"Mummy",1041,1,"timestopper#1::OnMyMobDead";
	monster "in_moc_16",78,56,"Mummy",1041,1,"timestopper#1::OnMyMobDead";
	monster "in_moc_16",79,56,"Mummy",1041,1,"timestopper#1::OnMyMobDead";
	monster "in_moc_16",80,56,"Mummy",1041,1,"timestopper#1::OnMyMobDead";
	monster "in_moc_16",81,56,"Mummy",1041,1,"timestopper#1::OnMyMobDead";
	monster "in_moc_16",91,55,"Mummy",1041,1,"timestopper#1::OnMyMobDead";
	monster "in_moc_16",92,56,"Mummy",1041,1,"timestopper#1::OnMyMobDead";
	monster "in_moc_16",93,56,"Mummy",1041,1,"timestopper#1::OnMyMobDead";
	monster "in_moc_16",94,56,"Mummy",1041,1,"timestopper#1::OnMyMobDead";
	monster "in_moc_16",95,56,"Mummy",1041,1,"timestopper#1::OnMyMobDead";
	monster "in_moc_16",96,56,"Mummy",1041,1,"timestopper#1::OnMyMobDead";
	monster "in_moc_16",97,56,"Mummy",1041,1,"timestopper#1::OnMyMobDead";
	monster "in_moc_16",76,62,"Hydra",1068,1,"timestopper#1::OnMyMobDead";
	monster "in_moc_16",79,62,"Hydra",1068,1,"timestopper#1::OnMyMobDead";
	monster "in_moc_16",79,65,"Hydra",1068,1,"timestopper#1::OnMyMobDead";
	monster "in_moc_16",76,65,"Hydra",1068,1,"timestopper#1::OnMyMobDead";
	monster "in_moc_16",96,62,"Hydra",1068,1,"timestopper#1::OnMyMobDead";
	monster "in_moc_16",96,65,"Hydra",1068,1,"timestopper#1::OnMyMobDead";
	monster "in_moc_16",99,62,"Hydra",1068,1,"timestopper#1::OnMyMobDead";
	monster "in_moc_16",99,65,"Hydra",1068,1,"timestopper#1::OnMyMobDead";
	end;

OnDisable:
	donpcevent "Standby Room#ASNTEST::OnStart";
	killmonster "in_moc_16","timestopper#1::OnMyMobDead";
	end;
}

in_moc_16,87,48,2	script	Barcardi#ASN	725,2,2,{
	end;
OnTouch_:
	donpcevent "timestopper#1::OnDisable";
	donpcevent "Thomas#ASNTEST::OnDisable";
	mes "[Barcardi]";
	mes "哦！恭喜你！";
	mes "现在你可以前往公会长的房间了。祝你好运！";
	close2;
	ASSIN_Q = 5;
	changequest 8004,8005;
	warp "in_moc_16",181,183;
	end;
}

in_moc_16,182,169,0	script	Maze Assistant	45,1,1,{
OnTouch_:
	if (ASSIN_Q == 5 || ASSIN_Q == 6) {
		warp "in_moc_16",181,183;
		ASSIN_Q++;
		if (!isbegin_quest(8006))
			changequest 8005,8006;
	}
	else {
		mapannounce "in_moc_16",strcharinfo(0)+" has entered 'Guildmaster's room.'",bc_map;
		savepoint "in_moc_16",181,183,1,1;
		donpcevent "Guildmaster#ASN1::OnCast";
		warp "in_moc_16",167,113;
		end;
	}
}

in_moc_16,167,110,0	script	Guildmaster#ASN1	-1,3,1,{
OnTouch_:
	savepoint "in_moc_16",167,110,1,1;
	mes "[Guildmaster]";
	mes "欢迎。";
	mes "这里叫作‘公会长的房间’，是刺客公会最深处的地方。";
	next;
	mes "[Guildmaster]";
	mes "我要给你一个简单的测试。请穿过迷宫来到我这里。正是这座迷宫保护着公会，阻挡入侵者。";
	next;
	mes "[Guildmaster]";
	mes "我期待在迷宫尽头";
	mes "与你见面。";
	mes "祝你顺利。";
	close;

OnCast:
	mapannounce "in_moc_16","...Next volunteer, please come in.",bc_map;
	end;
}

in_moc_16,149,80,4	script	Guildmaster#ASN2	106,1,1,{
	end;
OnTouch_:
	if (checkre(0))
		savepoint "morocc",100,100,1,1;
	else
		savepoint "moc_ruins",79,99,1,1;
	if (ASSIN_Q == 7 && BaseJob == Job_Thief) {
		ASSIN_Q = 8;
		mes "[Guildmaster]";
		mes "欢迎。";
		mes "很抱歉让你";
		mes "穿过这座";
		mes "迷宫。";
		next;
		mes "[Guildmaster]";
		mes "我刚才看过你的履历。你是个胆识过人的盗贼。像你这样有潜力的刺客非常少见。";
		next;
		mes "[Guildmaster]";
		mes "如果你不介意，我可以问你几个问题吗？不用紧张。记住：如果你撒谎，我会杀了你。";
		next;
		mes "[Guildmaster]";
		mes "首先，你认为刺客最重要的是什么？";
		next;
		switch(select("More power.:An Assassin's pride.:Endless practice.")) {
		case 1:
			mes "[Guildmaster]";
		mes "更强大的力量……";
		mes "是的，你可能认为";
		mes "刺客比盗贼";
		mes "强大得多。";
			next;
			mes "[Guildmaster]";
			mes "不过，你为什么渴望更强的力量？为了炫耀？为了个人复仇？你要用这份力量做什么？";
			next;
			mes "[Guildmaster]";
			mes "你为什么想变得";
			mes "比现在";
			mes "更强？";
			next;
			switch(select("Revenge...!:Money~:I want to travel.")) {
			case 1:
				mes "[Guildmaster]";
				mes "复仇……？";
				mes "是的，我明白。我们最终都会对某个人怀有怨恨。";
				next;
				mes "[Guildmaster]";
				mes "不过要记住，我们不能感情用事。毫无疑问地履行职责，这就是我们的道路。";
				next;
				mes "[Guildmaster]";
				mes "成为刺客意味着";
				mes "舍弃自我。";
				next;
				break;
			case 2:
				ASSIN_Q = 9;
				mes "[Guildmaster]";
				mes "经济原因……？我不否认我们都需要钱来生活。但成为刺客意味着为更高的目标而活。";
				next;
				mes "[Guildmaster]";
				mes "成为刺客意味着";
				mes "舍弃这种世俗的";
				mes "牵挂……";
				next;
				break;
			case 3:
				ASSIN_Q = 10;
				mes "[Guildmaster]";
				mes "好主意。环游世界能拓宽你的阅历。";
				next;
				mes "[Guildmaster]";
				mes "不过我们大多不喜欢结群，我相信你已经注意到了，对吧？";
				next;
				mes "[Guildmaster]";
				mes "从某种意义上说，成为刺客就是在孤独中生活……";
				next;
				break;
			}
			break;
		case 2:
			mes "[Guildmaster]";
			mes "刺客的骄傲……";
			mes "是其他刺客告诉你的吗……？";
			next;
			mes "[Guildmaster]";
			mes "骄傲当然重要，但没有实力，骄傲一文不值。";
			next;
			mes "[Guildmaster]";
			mes "你在我之前遇到的大多数刺客，都是一起经历过许多苦难的同伴。";
			next;
			mes "[Guildmaster]";
			mes "我能理解为什么骄傲和尊严对他们如此重要。那么，你为什么想成为刺客？";
			next;
			switch(select("I like the solitude.:Making money being an Assassin.:They just look interesting.")) {
			case 1:
				ASSIN_Q = 11;
				mes "[Guildmaster]";
				mes "你说到点子上了……";
				mes "我们很孤独，即使彼此相伴，也始终是一个人……";
				next;
				mes "[Guildmaster]";
				mes "从某种意义上说，";
				mes "成为刺客就等于";
				mes "一无所有。";
				next;
				mes "[Guildmaster]";
				mes "不过，正如我之前所说，我们有同伴。我建议你执行任务时至少找一名同伴支援。";
				next;
				break;
			case 2:
				ASSIN_Q = 12;
				mes "[Guildmaster]";
				mes "我不能否认，我们确实需要钱谋生。但你不觉得应该追求比金钱更重要的东西吗？";
				next;
				break;
			case 3:
				ASSIN_Q = 13;
				mes "[Guildmaster]";
				mes "风格和外表只是表象。可悲的是，很多人都这么想……";
				next;
				mes "[Guildmaster]";
				mes "对于那些失去真正目标、令刺客蒙羞的人，我们会用自己的方式处理……";
				next;
				mes "[Guildmaster]";
				mes "不要忘记……";
				mes "刺客从不嬉戏。我们不追逐风格或潮流，永远不会。";
				next;
				break;
			}
			break;
		case 3:
			mes "[Guildmaster]";
			mes "无尽的修炼……";
			mes "我认为你具备资质。你为什么想成为刺客？";
			next;
			mes "[Guildmaster]";
			mes "与盗贼职业不同，刺客不允许自我放纵。告诉我你";
			mes "不断修炼的理由。";
			next;
			switch(select("To broaden my skills.:It's a goal of mine.:For spiritual improvement.")) {
			case 1:
				ASSIN_Q = 14;
				mes "[Guildmaster]";
				mes "学习技能是刺客职业的必经之路。但别把技能当成修炼的最大价值。";
				next;
				mes "[Guildmaster]";
				mes "如果你这么想，成为刺客后不会满足……";
				next;
				break;
			case 2:
				ASSIN_Q = 15;
				mes "[Guildmaster]";
				mes "这是你的目标吗？嗯，人总得有目标……";
				next;
				mes "[Guildmaster]";
				mes "我曾认识一个有目标的人。很久以前，我执行任务时遇到一个人，他想在成为 54 级骑士前避免被杀。";
				next;
				mes "[Guildmaster]";
				mes "可惜我不得不在他达到 52 级前杀了他……^666666*叹气*^000000 算了。";
				next;
				mes "我有点担心你。希望你明白，一旦成为刺客，就没有回头路了……";
				next;
				break;
			case 3:
				ASSIN_Q = 16;
				mes "[Guildmaster]";
				mes "好主意……";
				mes "这是提升自己的好方法。我见过很多人身体强大，精神却不坚强。";
				next;
				mes "[Guildmaster]";
				mes "希望你不是伪君子。精神上的自律是生存的最佳方式。";
				next;
				break;
			}
			break;
		}
		mes "[Guildmaster]";
		mes "遗憾的是，有些什么都不懂的笨蛋也急着成为刺客……";
		next;
		mes "[Guildmaster]";
		mes "他们制造麻烦，让我们蒙羞。他们的行为经常导致可怕的后果。";
		next;
		mes "[Guildmaster]";
		mes "成为刺客后小心别变成他们那样。责任完全在你肩上……";
		next;
		mes "[Guildmaster]";
		mes "那么，如果你现在就能成为刺客，你首先会做什么？";
		next;
		switch(select("I would go hunt right away.:There are people waiting for me.:Check how I can help as an Assassin.")) {
		case 1:
			mes "[Guildmaster]";
			mes "去狩猎……";
			mes "就这样吗……？";
			next;
			switch(select("I would level up fast.:I want to explore my Assassin skills.:I will go where I couldn't go as a Thief.")) {
			case 1:
				.@assassin_sangdam += 10;
				mes "[Guildmaster]";
				mes "不要鲁莽行事……";
				mes "成为刺客不会让你变成另一个人，也不要依赖运气。";
				next;
				break;
			case 2:
				.@assassin_sangdam += 5;
				mes "[Guildmaster]";
				mes "审视自己是件好事。我理解能力大幅提升会让你兴奋。";
				next;
				mes "[Guildmaster]";
				mes "与此同时，希望你不要忘记刺客的心态。";
				next;
				break;
			case 3:
				mes "[Guildmaster]";
				mes "很好……";
				mes "去探索从未见过的地方。但要知道，成为刺客不会让你变成另一个人。";
				next;
				mes "[Guildmaster]";
				mes "不要太勉强自己。";
				mes "慢慢来，谨慎地旅行。";
				next;
				break;
			}
			break;
		case 2:
			mes "[Guildmaster]";
			mes "请问，是谁在等你？";
			mes "可以告诉我吗？";
			next;
			switch(select("My friends.:My Guildsmen.:My lover.")) {
			case 1:
				.@assassin_sangdam += 5;
				mes "[Guildmaster]";
				mes "我明白了……";
				mes "即使独自一人，也要感谢他们对你的关心。";
				next;
				break;
			case 2:
				.@assassin_sangdam += 5;
				mes "[Guildmaster]";
				mes "很好……";
				mes "愿意为之赴死的同伴……";
				next;
				mes "[Guildmaster]";
				mes "作为刺客，找一件能在他们不知情时为他们完成的事。";
				next;
				break;
			case 3:
				mes "[Guildmaster]";
				mes "哈哈，身体的需求有时很难忽视。最好接受人性中的这一面。";
				next;
				mes "[Guildmaster]";
				if (Sex == SEX_MALE)
					mes "但无论如何，你都不能向她透露自己作为刺客的一面。";
				else
					mes "但无论如何，你都不能向他透露自己作为刺客的一面。";
				next;
				mes "[Guildmaster]";
				mes "即使无法公开表达，也要永远爱着心爱的人。有时一生只有一次机会找到真爱。";
				next;
				break;
			}
			break;
		case 3:
			mes "[Guildmaster]";
			mes "这非常令人钦佩。你有什么想问我的吗？";
			next;
			switch(select("Places where Assassins can level up...:Main goals as an Assassin.:Financial consulting.")) {
			case 1:
				.@assassin_sangdam += 5;
				mes "[Guildmaster]";
				mes "一切取决于你的心态。根据心境，任何地方都可能是升级的最佳地点。";
				next;
				mes "[Guildmaster]";
				mes "你必须懂得如何";
				mes "在任何情况下生存。";
				next;
				break;
			case 2:
				mes "[Guildmaster]";
				mes "外面有许多刺客。把他们当作导师，听取他们的意见。";
				next;
				mes "[Guildmaster]";
				mes "希望你成为优秀的刺客。达到一定等级后，也要像你的导师一样指导新人。";
				next;
				break;
			case 3:
				.@assassin_sangdam += 10;
				mes "[Guildmaster]";
				mes "我的天……";
				mes "你打算为了赚钱而成为刺客吗？";
				next;
				mes "[Guildmaster]";
				mes "我们不欢迎这种人。如果这是你的目标，也许应该重新考虑转职……";
				next;
				break;
			}
			break;
		}
		mes "[Guildmaster]";
		mes "很高兴见到你。你让我想起了过去的美好时光。";
		next;
		mes "[Guildmaster]";
		mes "请给我";
		mes "一点时间……";
		next;
		mapannounce "in_moc_16","Those involved with the testing of " + strcharinfo(0) + ", please gather before me.",bc_map;
		mes "[Guildmaster]";
		mes "参与测试 " + strcharinfo(0) + " 的人员，请到我面前集合。";
		next;
		mes "[Guildmaster]";
		mes "他们很快";
		mes "就会到这里。";
		next;
		enablenpc "[Huey]";
		enablenpc "[Khai]";
		enablenpc "[The Anonymous One]";
		enablenpc "[Barcardi]";
		enablenpc "[Beholder]";
		enablenpc "[Thomas]";
		enablenpc "[Gayle Maroubitz]";
		mes "[The Anonymous One]";
		mes "我来了。";
		next;
		mes "[Guildmaster]";
		mes "我想听听你对 " + strcharinfo(0) + " 转职测试表现的看法。";
		next;
		mes "[The Anonymous One]";
		mes "啊，对了……";
		mes "我觉得";
		mes ""+ strcharinfo(0) +"";
		mes "还不错。";
		next;
		mes "[Guildmaster]";
		mes "嗯……";
		mes "无名者";
		mes "支持你。";
		mes "你呢，休伊？";
		next;
		if (ASSIN_Q3 == 1) { // player Job Level was above 48
			mes "[Huey]";
			mes "真少见。";
			mes "从职业等级";
			mes "就能看出来。";
			next;
			mes "[Huey]";
			mes "我同意";
			mes "无名者的看法。";
		}
		else { // player Job Level was below 48
			mes "[Huey]";
			mes "虽然 "+ strcharinfo(0) +" 看起来温和柔弱，像只小猫，但 "+ strcharinfo(0) +" 很有实力。";
			next;
			mes "[Huey]";
			mes "如果可以的话，我想回去工作。";
			next;
			mes "[Guildmaster]";
			mes "好的……";
			mes "就这样吧，休伊。";
		}
		next;
		mes "[Guildmaster]";
		mes "那么……";

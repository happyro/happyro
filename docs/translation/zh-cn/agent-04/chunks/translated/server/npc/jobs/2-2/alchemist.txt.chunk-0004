		if(MISC_QUEST & 4) {
			mes "[范·赫尔蒙特]";
			mes "哪件物品不";
			mes "是制作";
			mes "反应剂所必需的？";
			next;
			if (select("卡沃戴利诺尔:德特里敏德斯塔:酒精") != 1) set .@w_point,.@w_point+1;
			mes "[范·赫尔蒙特]";
			mes "哪件物品不";
			mes "是制作";
			mes "是制作混合剂所必需的？";
			next;
			if (select("卡沃戴利诺尔:德特里敏德斯塔:酒精") != 2) set .@w_point,.@w_point+1;
			if (.@w_point > 0) {
				mes "[范·赫尔蒙特]";
				mes "你根本没听莫尔根斯坦讲课吗？也许你";
				mes "你得再看他制作一次。";
				next;
				mes "[范·赫尔蒙特]";
				mes "如果你说不出实验所需的确切物品，";
				mes "可能会伤到自己！";
				close;
			}
			mes "[范·赫尔蒙特]";
			mes "很好，你学得不错。";
			mes "好，现在你了解实验了。你在这里的训练结束了，我可以继续实验了。";
			next;
			mes "[范·赫尔蒙特]";
			mes "出去找到旁边的房间";
			mes "，和尼古拉斯谈谈。 他会继续训练你。";
			next;
			set ALCH_Q,20;
			changequest 2036,2037;
			mes "[范·赫尔蒙特]";
			mes "你还在这里";
			mes "做什么？";
			mes "快走！我们都有";
			mes "更重要的";
			mes "事情要做！";
			close;
		}
		else {
			mes "[范·赫尔蒙特]";
			mes "你需要哪件物品";
			mes "来制作";
			mes "反应剂所必需的？";
			next;
			select("羽毛:黏稠液体:兽血");
			mes "[范·赫尔蒙特]";
			mes "你需要哪件物品";
			mes "来制作";
			mes "是制作混合剂所必需的？";
			next;
			select("怪物饲料:古老嘴唇:腐烂绷带");
			mes "[范·赫尔蒙特]";
			mes "老实说，你不知道，对吧？！ 我不是让你去找莫尔根斯坦学习吗？！";
			next;
			mes "[范·赫尔蒙特]";
			mes "没和他谈过之前别想回来！ 别再烦我，出去！";
			close;
		}
	}
	else if (ALCH_Q == 20) {
		mes "什么……？";
		mes "我不是告诉过你";
		mes "去和隔壁的尼古拉斯谈谈吗？";
		next;
		mes "[范·赫尔蒙特]";
		mes "我还要继续研究，";
		mes "而你也得完成炼金术士转职。快走吧！";
		close;
	}
	else {
		mes "再一点点……";
		mes "再多一点……";
		mes "不——！只差一点点";
		mes "就能完成了！";
		mes "";
		next;
		mes "[范·赫尔蒙特]";
		mes "为什么……？！";
		mes "怎么又失败了？！";
		mes "我的计算明明";
		mes "全都正确！等等……";
		next;
		mes "[范·赫尔蒙特]";
		mes "也许，如果利用中子梯度来调节热通量，应该就能成功……";
		close;
	}
}

alde_alche,101,184,4	script	Master Alchemist#am	122,{
	cutin "job_alche_vincent",2;
	mes "[文森特·卡西阿洛]";
	if (Upper == 1) {
		mes "你已经超越了极限……";
		mes "太棒了，太棒了。";
		next;
		mes "[文森特·卡西阿洛]";
		mes "这里已经不再适合你了。";
		mes "去探索广阔的世界吧，我的朋友。";
		close2;
		cutin "",255;
		end;
	}
	if (BaseJob != Job_Merchant) {
		if (BaseJob == Job_Alchemist) {
			mes "欢迎！";
			mes "你的研究";
			mes "进展得怎么样了？";
			next;
			mes "[文森特·卡西阿洛]";
			mes "实验有时会得到意料之外的结果。虽然这可能是研究上的挫折，但也可能带来新的发现。";
			next;
			mes "[文森特·卡西阿洛]";
			mes "如果你发现了新东西，";
			mes "就来告诉我们。别忘了，我们都在共同努力揭开科学的奥秘！";
		}
		else if (BaseClass == Job_Novice) {
			mes "嗯……";
			mes "初心者？";
			mes "你不该在";
			mes "这种地方";
			mes "玩耍。";
			next;
			mes "[文森特·卡西阿洛]";
			mes "这栋建筑里有许多易挥发的化学品和危险材料。";
			mes "你还是到外面玩比较好。";
		}
		else {
			mes "嗯……？";
			mes "冒险者怎么会";
			mes "来到";
			mes "炼金术士协会？";
			next;
			mes "[文森特·卡西阿洛]";
			mes "恐怕如果你不是协会成员，";
			mes "我们在这里";
			mes "也没什么能提供给你的。";
			mes "";
		}
		close2;
		cutin "",255;
		end;
	}
	if (ALCH_Q == 0) {
		mes "嗯……？";
		mes "商人？";
		mes "你对学习炼金术";
		mes "感兴趣吗？";
		next;
		mes "[文森特·卡西阿洛]";
		mes "这里是炼金术士协会。";
		mes "我们研究并实验各种物质，不使用魔法也能创造新材料。";
		next;
		mes "[文森特·卡西阿洛]";
		mes "总有一天，我们希望揭开生命的秘密，";
		mes "以及其他科学奥秘。";
		next;
		mes "[文森特·卡西阿洛]";
		mes "作为商人旅行了这么久，你一定培养出了科学好奇心。";
		mes "如果想学习炼金术，不妨加入炼金术士协会？";
		close2;
		cutin "",255;
		end;
	}
	else if (ALCH_Q == 40) {
		if (JobLevel < 40) {
			set ALCH_Q,0;
			mes "嗯……你似乎还不够资格。";
			mes "记住，至少要达到职业等级 40 才能成为炼金术士。";
			close2;
			cutin "",255;
			end;
		}
		if (SkillPoint) {
			mes "啊，你已经快要";
			mes "成为炼金术士了，";
			mes "但必须先分配";
			mes "尚未使用的技能点。";
			mes "";
			next;
			mes "[文森特·卡西阿洛]";
			mes "用完所有额外技能点后，";
			mes "再来和我谈谈。";
			mes "";
			mes "";
			close2;
			cutin "",255;
			end;
		}
		if (checkquest(2039) != -1) {
			changequest 2039,2040;
		}
		if (checkquest(2034) != -1) {
			changequest 2034,2040;
		}
		mes "啊，做得好。";
		mes "我看得出来你已经";
		mes "学会了炼金术的";
		mes "全部基础。";
		next;
		set ALCH_Q,0;
		completequest 2040;
		set .@jlevel,JobLevel;
		callfunc "Job_Change",Job_Alchemist;
		callfunc "F_ClearJobVar";
		mes "[文森特·卡西阿洛]";
		mes "从今以后，你就是";
		mes "我们辉煌协会的一员了。";
		mes "希望你能学到很多……";
		mes "";
		next;
		if (.@jlevel == 50) {
			getitem 7133,1; //Slim_Potion_Create_Book
			mes "[文森特·卡西阿洛]";
			mes "让我给你一些特别的东西。";
			mes "你可以用它开始";
			mes "自己的研究生涯。";
			mes "";
			mes "";
		}
		else {
			switch(rand(1,6)) {
			case 1:
				getitem 7127,1; //Alcol_Create_Book
				break;
			case 2:
				getitem 7128,1; //FireBottle_Create_Book
				break;
			case 3:
				getitem 7129,1; //Acid_Create_Book
				break;
			case 4:
				getitem 7130,1; //Plant_Create_Book
				break;
			case 5:
				getitem 7131,1; //Mine_Create_Book
				break;
			case 6:
				getitem 7144,1; //Normal_Potion_Book
			}
			mes "[文森特·卡西阿洛]";
			mes "还有……";
			mes "这是帮助你开始";
			mes "研究的小礼物。";
			mes "";
			mes "";
		}
		next;
		mes "[文森特·卡西阿洛]";
		mes "那就回头见……";
		mes "记住，作为炼金术士";
		mes "要自豪地面对一切！";
		mes "";
		mes "";
		close2;
		cutin "",255;
		end;
	}
	else {
		mes "啊……";
		mes "我想你已经登记了";
		mes "炼金术士训练。";
		mes "";
		mes "";
		next;
		mes "[文森特·卡西阿洛]";
		mes "请听从其他炼金术士的指导，并仔细遵循他们的指示。你会从他们那里学到很多。";
		mes "";
		close2;
		cutin "",255;
		end;
	}
}

alde_alche,145,19,1	script	Chief Researcher#am	57,{
	if (checkweight(1201,1) == 0) {
		mes "- 请等一下！-";
		mes "- 你目前携带的物品 -";
		mes "- 太多了。-";
		mes "- 请先把一些物品存入 -";
		mes "- 卡普拉仓库后再回来。-";
		close;
	}
	if (ALCH_Q > 19 && ALCH_Q < 22) {
		if (ALCH_Q == 20) {
			mes "[尼古拉斯·弗拉梅尔]";
			mes "哦……";
			mes "你就是那个";
			mes "想成为炼金术士的新人商人？";
			mes "";
			next;
			mes "[尼古拉斯·弗拉梅尔]";
			mes "不是谁都能成为炼金术士。你必须有动力、明确的目标和强大的专注力。";
			next;
			mes "[尼古拉斯·弗拉梅尔]";
			mes "炼金术士必须记住许多化学方程式、科学定律和其他信息。其实相当困难。";
			next;
			mes "[尼古拉斯·弗拉梅尔]";
			mes "如果你无法集中注意力，之后查看炼金术图表时会感到困惑。我的测试就是要考验你的专注力。";
			next;
		}
		mes "[尼古拉斯·弗拉梅尔]";
		mes "从我给你的字母组中找出";
		mes "被打乱的单词。答案可能只用到部分";
		mes "或全部字母。";
		next;
		mes "[尼古拉斯·弗拉梅尔]";
		mes "如果你选择";
		mes "^551A8B谜题中隐藏的^000000";
		mes "单词，就能通过。";
		next;
		switch(rand(1,3)) {
		case 1:
			mes "t m y a n y e o b n e g p r i";
			next;
			if (select("刹车:黄铜:虫子:破损:布里根？") == 5) set .@alch_t,.@alch_t+10;
			mes "o n c u t a p j l e r s v m u";
			next;
			if (select("商贩:仓库:武器:简单:街边商店") == 1) set .@alch_t,.@alch_t+10;
			mes "t v a r m e g p h e u b o y l";
			next;
			if (select("糖蜜:派对:领袖:甜食:糖浆") == 2) set .@alch_t,.@alch_t+10;
			mes "q z a h n a i n b r d p t n c";
			next;
			if (select("游击队员:党派:帕托:帕罗斯:包裹") == 2) set .@alch_t,.@alch_t+10;
			break;
		case 2:
			mes "m p d i c f a r o g n k w a s";
			next;
			if (select("搬运工:阳光:诸神黄昏:仙境:霜冻") == 1) set .@alch_t,.@alch_t+10;
			mes "g b n o p r e f a r e t a s k";
			next;
			if (select("紫色:吸烟者:诸神黄昏:闪电:焦木") == 3) set .@alch_t,.@alch_t+10;
			mes "u g n i s j e k c e o g n d p";
			next;
			if (select("结痂:亲缘:捐赠:来源:开启") == 5) set .@alch_t,.@alch_t+10;
			mes "r o e h n r o m c a i n p t t";
			next;
			if (select("锻造商人:药水商人:DC商人:贩卖商人:战斗商人") == 2) set .@alch_t,.@alch_t+10;
			break;
		case 3:
			mes "s m i e x b w u n e t a g l r";
			next;
			if (select("老虎:狼:南瓜:绊倒:撕裂") == 1) set .@alch_t,.@alch_t+10;
			mes "n i e g b o p d s o a u w r v";
			next;
			if (select("重击:挑衅:忍耐:眩晕:阿布拉卡达布拉") == 3) set .@alch_t,.@alch_t+10;
			mes "l r m g r e x t a v i n e d e";
			next;
			if (select("艾尔贝塔:阔叶:深红:枫树:常青") == 5) set .@alch_t,.@alch_t+10;
			mes "r o e h n r o m c a i n p t t";
			next;
			if (select("锻造商人:药水商人:DC商人:贩卖商人:战斗商人") == 2) set .@alch_t,.@alch_t+10;
			break;
		}
		mes "[尼古拉斯·弗拉梅尔]";
		mes "啊，你完成了。";
		mes "现在，让我看看……";
		if (.@alch_t > 30) {
			set ALCH_Q,22;
			mes "做得非常好！";
			next;
			mes "[尼古拉斯·弗拉梅尔]";
			mes "太好了，你找到了所有隐藏单词。有这样的专注力，记忆信息应该不成问题。";
			next;
			mes "[尼古拉斯·弗拉梅尔]";
			mes "过一会儿再回来，";
			mes "我会准备下一项训练任务。";
			mes "";
			next;
			mes "[尼古拉斯·弗拉梅尔]";
			mes "哦，在再次和我交谈前，";
			mes "请确保你的物品栏有";
			mes "^551A8B足够的空间^000000。";
			close;
		}
		else {
			set ALCH_Q,21;
		mes "^666666*倒吸气！*^000000 太、太糟糕了！";
			next;
		mes "[尼古拉斯·弗拉梅尔]";
		mes "从这些结果来看，你显然有注意力不集中的问题。";
			next;
		mes "[尼古拉斯·弗拉梅尔]";
		mes "连这么简单的文字谜题都解不开，你怎么记录实验和研究？";
			next;
		mes "[尼古拉斯·弗拉梅尔]";
		mes "不如放松一下，";
		mes "休息一会儿后";
		mes "再重新参加测试？";
			close;

		}
	}
	else if (ALCH_Q == 22) {
		if (MaxWeight - Weight < 1370) {
		mes "[尼古拉斯·弗拉梅尔]";
		mes "哇……";
		mes "你携带的东西太多了！先把一些物品存进卡普拉仓库。";
			close;
		}
		mes "[尼古拉斯·弗拉梅尔]";
		mes "好吧……";
		mes "下一项任务";
		mes "需要前往^551A8B朱诺^000000。";
		next;
		mes "[尼古拉斯·弗拉梅尔]";
		mes "在那里，你要和^551A8B贝恩^000000、^551A8B巴金^000000交谈。他们正与朱诺的贤者进行炼金术研究。";
		mes "协助他们的项目，你会有所收获。";
		next;
		mes "[尼古拉斯·弗拉梅尔]";
		mes "帮助他们后回到我这里。";
		mes "他们需要这些物品来继续实验。";
		next;
		set ALCH_Q,23;
		changequest 2037,2038;
		mes "[尼古拉斯·弗拉梅尔]";
		mes "1 个混合剂，";
		mes "5 个燃烧的树，";
		mes "5 个细沙，";
		mes "3 个粗糙的奥里德根";
		mes "和 3 个粗糙的艾尔块。";
		getitem 974,1; //Mixture
		getitem 7068,5; //Burn_Tree
		getitem 7043,5; //Fine_Sand
		getitem 756,3; //Oridecon_Stone
		getitem 757,3; //Elunium_Stone
		next;
		mes "[尼古拉斯·弗拉梅尔]";
		mes "好。";
		mes "一路平安，";
		mes "完好无损地";
		mes "回来。";
		close;
	}
	else if (ALCH_Q == 23) {
		mes "[尼古拉斯·弗拉梅尔]";
		mes "我不是说过要去朱诺，";
		mes "帮助贝恩和巴金";
		mes "进行炼金术研究吗？";
		mes "";
		close;
	}
	else if (ALCH_Q == 24) {
		set ALCH_Q,40;
		changequest 2038,2039;
		mes "[尼古拉斯·弗拉梅尔]";
		mes "啊，你回来了！";
		mes "我刚收到贝恩和巴金的消息。";
		mes "他们说非常满意你的协助。";
		next;
		mes "[尼古拉斯·弗拉梅尔]";
		mes "既然你能很好地帮助那对兄弟，";
		mes "当然有资格成为炼金术士。";
		mes "";
		mes "";
		next;
		mes "[尼古拉斯·弗拉梅尔]";
		mes "干得好！";
		mes "现在只要去二楼和协会长谈谈！恭喜你，很快就会成为炼金术士了！";
		close;
	}
	else if (ALCH_Q == 40 && BaseJob == Job_Merchant) {
		mes "[尼古拉斯·弗拉梅尔]";
		mes "现在只要去二楼和协会长谈谈！恭喜你，很快就会成为炼金术士了！";
		close;
	}
	else {
		mes "[尼古拉斯·弗拉梅尔]";
		mes "这是一段占位文本，";
		mes "用于测试对话显示。";
		mes "请继续查看炼金术研究。";
		mes "";
		mes "";
		next;
		mes "[尼古拉斯·弗拉梅尔]";
		mes "这里还有一段模糊的占位内容……";
		mes "^666666*喃喃自语*^000000";
		mes "";
		close;
	}
}

//============================================================ 
// Old changelog
//============================================================ 
//= 1.0 Working.
//=     npc/quests/counteragent_mixture.txt Also Needed
//=     npc/quests/quests_yuno.txt Also Needed [Darkchild]
//= 1.1 Fixed some minor bugs.  Optimized some lines. Re-organized the script a bit. 
//=     Giving Parmry NPC, Hammer and Old Book now waves the 50000 fee. (based of mRO website)
//=     Having a joblvl of 50 allows you to skip Rasputin's test. (based of mRO website) [kobra_k88]
//= 1.2 fixed a few typos (have to hunt more) [Lupus]
//= 1.3 Added Baby Class Support [Lupus]
//= 1.6 Added a func which prevent advanced classes passing
//=     2nd Job Quests again. It also guides adv classes where
//=     to go. [Lupus]
//= 1.6a fixed some wrong answers, thanks to zlider for info [Lupus]

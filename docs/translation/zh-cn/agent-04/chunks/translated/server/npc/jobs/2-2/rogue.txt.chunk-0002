S_Req:
	mes "[史密斯先生]";
	mes "首先是申请费：";
	mes "^FF000010,000 Zeny^000000。";
	mes "";
	next;
	mes "[史密斯先生]";
	mes "还需要你带来";
	mes "以下物品：";
		mes "^FF0000"+getarg(0)+"^000000、";
		mes "^FF0000"+getarg(1)+"^000000、";
	mes "^FF0000"+getarg(2)+"^000000 和";
		mes "^FF0000"+getarg(3)+"^000000。";
	.@var = getarg(4);
	ROGUE_Q = .@var;
	if (.@var == 3) {
		changequest 2017,2018;
	}
	else if (.@var == 4) {
		changequest 2017,2019;
	}
	else {
		changequest 2017,2020;
	}
	next;
	mes "[史密斯先生]";
	mes "嗯……？";
	mes "你说什么？";
	mes "你刚才是说愿意";
	mes "为公会捐更多东西吗？";
	mes "";
	next;
	mes "[史密斯先生]";
	mes "听起来真不错，";
	mes "我很感激。";
	mes "准备好后再回来。";
	mes "";
	close;


S_CheckItems:
	setarray .@item_req[0], getarg(0), getarg(2), getarg(4), getarg(6);
	setarray .@amount[0], getarg(1), getarg(3), getarg(5), getarg(7);

	if (Zeny > 9999 && countitem(.@item_req[0]) >= .@amount[0] && countitem(.@item_req[1]) >= .@amount[1] && countitem(.@item_req[2]) >= .@amount[2] && countitem(.@item_req[3]) >= .@amount[3]) {
		mes "[史密斯先生]";
		mes "好了，申请费^FF000010,000 Zeny^000000，以及 "+ .@amount[0] +" 个"+ getitemname(.@item_req[0]) +"、"+ .@amount[1] +" 个"+ getitemname(.@item_req[1]) +" 个物品都收到了，";
		mes ""+.@amount[2] +" 个"+ getitemname(.@item_req[2]) +" 和 "+ .@amount[3] +" 个"+ getitemname(.@item_req[3]) +" 也都齐了……";
		set Zeny, Zeny-10000;
		delitem .@item_req[0],.@amount[0];
		delitem .@item_req[1],.@amount[1];
		delitem .@item_req[2],.@amount[2];
		delitem .@item_req[3],.@amount[3];
		set ROGUE_Q,7;
		next;
		mes "[史密斯先生]";
		mes "很好，很好……";
		mes "我想你";
		mes "把东西都带齐了。";
		set ROGUE_Q,7;
		next;
		mes "[史密斯先生]";
		mes "好，稍等片刻，";
		mes "我准备好这些东西。";
		mes "让我看看……你的下一项测试是……";
		close;
	}

ecl_in01,48,60,5	script	Eclage Guard#obb	447,{
	mes "[Eclage Guard]";
	mes "欢迎，冒险家。这里是埃克拉珠广场，一棵伟大而神圣的树。有什么我能帮您的吗？";
	next;
	switch(select("宫殿:宝珠:商店:监狱:诊所:住宅区:结束对话")) {
	case 1:
		mes "[Eclage Guard]";
		mes "伟大的国王、勇敢的将军和学者们都住在宫殿里。";
		mes "宫殿位于埃克拉珠顶部。我们通常飞过去，但看来您没有翅膀。请沿右侧道路前进，它会通往宫殿。";
		close;
	case 2:
		mes "[Eclage Guard]";
		mes "我身后的宝珠就像我们拉斐尔族的象征。";
		mes "它蕴含着强大而神秘的力量。我们一直密切关注并小心守护它。";
		close;
	case 3:
		mes "[Eclage Guard]";
		mes "这里是埃克拉珠广场。您需要的一切都能在附近找到。";
		close;
	case 4:
		mes "[Eclage Guard]";
		mes "监狱是关押罪犯的地方。像您这样的冒险家为什么要去那里？";
		mes "嗯，确实有点可疑……但我会告诉您位置。沿左侧道路前进。不过他们不让任何人进入。";
		close;
	case 5:
		mes "[Eclage Guard]";
		mes "在大自然的怀抱中，所有痛苦与疲惫都会消散。去埃克拉珠诊所恢复身心吧。";
		mes "沿左侧道路前进。";
		close;
	case 6:
		mes "[Eclage Guard]";
		mes "您没看到我们为 Yai 准备的装饰吗？到外面走走吧，您会看到住宅区。";
		close;
	case 7:
		close;
	}
}

que_job01,84,17,3	script	Rin#moc_room2_1	885,{
	if (checkweight(714,1) == 0) {
		mes "- 携带太多物品时无法继续任务。 -";
		close;
	}
	if (mao_morocc2 == 5) {
		if (mao_request > 103) {
			mes "[Rin]";
			mes "..." + strcharinfo(0) + "...?";
			mes "好久不见。发生什么事了？";
			cutin "moc2_rin02",2;
		}
		else {
			mes "[Rin]";
			mes "你是谁？只有授权人员才能进入这里。";
			cutin "moc2_rin01",2;
		}
		next;
		switch(select("基德先生派我来的。:我只是路过。")) {
		case 1:
			cutin "moc2_rin02",2;
			mes "[Rin]";
			mes "...?";
			mes "……啊……我明白了。";
			mes "我有一阵子没联系他，所以他派你来……";
			mes "*Sigh*.. *Cough*.";
			next;
			cutin "moc2_rin01",2;
			mes "[Rin]";
			mes "如你所见，我身体不适，没法联系他。";
			mes "……让我想想，该从哪里开始……？";
			next;
			if (((mao_request > 25) && (mao_request < 31)) || ((mao_request > 125) && (mao_request < 129))) {
				mes "不知道你是否了解，撒旦梦罗克复活前，这座城发生过灾难。";
				next;
	mes "";
	mes "";
	mes "";
	mes "";
				mes "";
				mes "";
				mes "";
				mes "R，也就是‘莱扬’，举行仪式试图打破撒旦梦罗克的封印。";
				next;
				mes "[Rin]";
				mes "我们召集人员阻止他完成仪式，虽然封印没有破坏，但他削弱了封印。";
				next;
				mes "[Rin]";
				mes "我们抓住他后不久，怪物军队袭击了这座城，撒旦梦罗克愤怒的咆哮回荡在空中。";
				cutin "moc2_rin04",2;
				next;
				mes "[Rin]";
				mes "R，也就是莱扬，是这一系列事件的罪魁祸首。";
				mes "现在发生的一切都是他造成的。";
				next;
			}
			else {
				mes "[Rin]";
			mes "不知道你是否了解，撒旦梦罗克复活前，这座城发生过灾难。";
				next;
				mes "[Rin]";
			mes "R，也就是‘莱扬’，举行仪式试图打破撒旦梦罗克的封印。";
				next;
				mes "[Rin]";
			mes "我们召集人员阻止他完成仪式，虽然封印没有破坏，但他削弱了封印。";
				next;
				mes "[Rin]";
			mes "我们抓住他后不久，怪物军队袭击了这座城，撒旦梦罗克愤怒的咆哮回荡在空中。";
				cutin "moc2_rin04",2;
				next;
				mes "[Rin]";
			mes "R，也就是莱扬，是这一系列事件的罪魁祸首。";
			mes "现在发生的一切都是他造成的。";
				next;
			}
			mes "[Rin]";
			mes "我们的主要工作是调查撒旦梦罗克的下落，";
			mes "以及时空裂缝与撒旦梦罗克的关系……";
			next;
			mes "[Rin]";
		mes "不过我们不能让莱扬逃脱责任，";
		mes "我一直专注于追捕莱扬。";
			next;
			mes "[Rin]";
		mes "抓住他也许能得到撒旦梦罗克的情报：";
		mes "知道他在哪里试图召唤撒旦梦罗克，以及该把撒旦梦罗克送回哪里……";
			next;
			cutin "moc2_rin03",2;
			mes "[Rin]";
		mes "我很想知道时空裂缝与撒旦梦罗克的联系……";
			mes "*Pant Pant*... ...";
			next;
			switch(select("And then what?:Don't strain yourself.")) {
			case 1:
				cutin "moc2_rin01",2;
				mes "[Rin]";
			mes "抱歉，我还没完全康复……说话得慢一点，请耐心听。";
				next;
				break;
			case 2:
				cutin "moc2_rin01",2;
				mes "[Rin]";
			mes "谢谢你的好意。";
			mes "……*喘气*……";
				next;
				break;
			}
			mes "[Rin]";
		mes "这些伤是莱扬和他的团伙造成的。我长时间监视追踪，终于找到了他们……";
			mes "......... ...";
			next;
			mes "[Rin]";
		mes "是的……我得把这些记下来……";
			next;
		mes "- 她一边喃喃自语，一边在旧笔记本上记录。 -";
			next;
			mes "[Rin]";
		mes "蒲公英……他们是莱扬的傀儡。";
		mes "我在远离村庄的山里被他们伏击……";
			next;
			mes "[Rin]";
		mes "醒来时，我已经在这里。";
		mes "从那以后视线就很模糊，应该是伤势造成的……";
			next;
			mes "[Rin]";
		mes "去那附近调查怎么样？也许能找到什么……";
		mes "比如重要线索或他们前往的方向……";
			set mao_morocc2,6;
			next;
			mes "[Rin]";
			mes "^4d4dffIf you're interested in helping me, I'll continue talking.^000000";
			close2;
			break;
		case 2:
			cutin "moc2_rin03",2;
			mes "[Rin]";
		mes "你只是无缘无故来这里吗？";
		mes "……天啊，我真不敢相信让你来这里！";
		mes "呃……我得给他们教训。看在上帝份上，为什么不让我休息！";
			next;
			mes "[Rin]";
		mes "抱歉，我非常疲惫又暴躁。";
		mes "如果没有重要的事，请你离开。";
			close2;
			break;
		}
	}
	else if (mao_morocc2 == 6) {
		cutin "moc2_rin01",2;
		mes "[Rin]";
	mes "那么，你有兴趣帮我吗？";
	mes "我记得地点在……胡格尔村西南方。";
		mes "你知道龙族栖息的深渊湖在哪里吗？";
		next;
		mes "[Rin]";
		mes "^4d4dff经过深渊湖向西走，^000000你会到达险峻的山地。";
		mes "我在^4d4dff山顶往下数第二座山丘的南边^000000遭到伏击。";
		next;
		mes "[Rin]";
		mes "它们群起围攻我，但我奋力抵抗……";
		mes "我肯定至少让它们掉了什么。";
		mes "请在那里寻找可能成为线索的东西。";
		next;
		mes "[Rin]";
		mes "你离开期间，我会准备文件交给基德先生。";
		mes "注意安全，照顾好自己，好吗？";
		set mao_morocc2,7;
		changequest 7015,7016;
		close2;
	}
	else if (mao_morocc2 == 7) {
		cutin "moc2_rin01",2;
		mes "[Rin]";
		mes "我记得地点在……";
		mes "深渊湖西边某座山的第二座山丘南方。";
		next;
		mes "[Rin]";
		mes "你在看什么？";
		mes "我怎么会记得这么清楚？";
		mes "那是我最后一次寻找莱扬的地点，怎么会忘记？";
		next;
		cutin "moc2_rin02",2;
		mes "[Rin]";
		mes "别小看我，我可是公会精英成员。";
		close2;
	}
	else if (mao_morocc2 == 8) {
		cutin "moc2_rin02",2;
		mes "[Rin]";
		mes "你找到什么了吗？";
		next;
		mes "- 你告诉她没找到与他们下落有关的东西，";
		mes "但你在灌木丛里找到了‘黑暗血腥水晶’。";
		next;
		if (countitem(6027) > 0) {
			cutin "moc2_rin01",2;
			mes "[Rin]";
			mes "……就是这个。";
			mes "仅仅看着它就能感受到邪恶气息。";
			mes "这个……毫无疑问，是和撒旦梦罗克及其爪牙身上发现的同类水晶。";
			next;
			cutin "moc2_rin04",2;
			mes "[Rin]";
			mes "但是……这块水晶……留在那里……";
			mes "……是他们掉的吗？";
			mes "看来莱扬和撒旦梦罗克之间……确实有某种联系。";
			next;
			cutin "moc2_rin01",2;
			mes "[Rin]";
			mes "辛苦你了。谢谢。";
			mes "Ha...";
			mes "只能躺在这里什么也做不了……真令人沮丧。";
			next;
			mes "[Rin]";
			mes "来，把这本日志带给基德先生。";
			mes "本来早该完成了。";
			mes "哦，也把这块水晶带给他。";
			next;
			mes "[Rin]";
			mes "啊……日志……对，我应该把这件事记在日志里。";
			next;
			mes "......";
			next;
			mes "......";
			mes "......";
			next;
			cutin "moc2_rin02",2;
			mes "[Rin]";
			mes "完成了。给你。";
			mes "这是日志和水晶。";
			mes "替我带给基德先生。";
			next;
			mes "- 你从凛那里收到日志。";
			mes "与其说是日志，更像是一叠交换中的文件。 -";
			set mao_morocc2,9;
			getitem 6029,1; //Morocc_Tracing_Log
			changequest 7017,7018;
			close2;
		}
		else {
			cutin "moc2_rin01",2;
			mes "[Rin]";
			mes "……黑暗血腥水晶？";
			mes "能给我看看吗？";
			next;
			mes "[" + strcharinfo(0) + "]";
			mes "哦，我没带在身上。我马上去拿。";
			mes "^4d4dff（等等，我把它放哪了？我没把它卖掉之类的吧？）^000000";
			close2;
		}
	}
	else if (mao_morocc2 == 9) {
		cutin "moc2_rin03",2;
		mes "[Rin]";
		mes "快点，把日志和水晶交给基德先生。";
		mes "这就是你的任务，不是吗？";
		mes "*Pant* I need to rest now..";
		next;
		mes "[Rin]";
		mes "我的眼睛很模糊……";
		mes "*Pant Pant*...";
		close2;
	}
	else {
		cutin "moc2_rin03",2;
		mes "[Rin]";
		mes "……啊……我还在恢复……不该乱动～";
		close2;
	}
	cutin "moc2_rin03",255;
	end;
}

que_job01,144,54,3	script	Rin#moc_room2_2	885,{
	if (checkweight(714,1) == 0) {

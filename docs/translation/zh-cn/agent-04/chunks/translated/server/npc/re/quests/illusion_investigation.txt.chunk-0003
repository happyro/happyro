		mes "我喜欢！！";
		next;
		mes "[Cassis]";
		mes "进入后杀死任意 100 只怪物。";
		next;
		mes "[Cassis]";
		mes "那么，小心！";
		close2;
		setquest 3462;
		end;
	case 0:
	case 1:
		mes "[Cassis]";
		mes "击杀 100 只任意怪物。";
		close;
	case 2:

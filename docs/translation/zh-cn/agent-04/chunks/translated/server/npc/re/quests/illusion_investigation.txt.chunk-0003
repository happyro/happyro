		mes "击杀 100 只任意怪物。";
		close;
	case 2:
		mes "[Sheshin]";
		mes "我明白了……你很快完成并回来了。";
		next;
		mes "[Sheshin]";
		mes "我需要进一步调查这里的现象是否也受次元裂隙影响。";
		next;
		mes "[Sheshin]";
		mes "接下来我会自己完成工作。";
		next;
		mes "[Sheshin]";
		mes "非常感谢你的帮助";

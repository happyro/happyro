// Wanted to be Big and Beautiful
//============================================================
function	script	WeightBigQuest	{
	if (!checkweight(1201,1) || (MaxWeight-Weight) < 2000) {
		mes "- 到此为止！！-";
		mes "- 你携带了太多物品。-";
		mes "- 无法再携带物品。-";
		mes "- 减轻负重后-";
		mes "- 再试一次。-";
		close;
	}
	return;
}

eclage,282,255,4	script	Wuhari#eclbig	4_M_FAIRYKID6,{
	WeightBigQuest;
	mes "[Wuhari]";
	if (BaseLevel < 120)
		mes "啊……有没有更有经验的人……";
	else if (ep14_2_big < 2) {
		if (ep14_2_big == 0) {
			mes "我以前没见过你……你不是这里的人？";
			next;
			mes "[Wuhari]";
			mes "如果你有勇气和智慧独自前往异国，我相信你也很有经验。";
			next;
			mes "[Wuhari]";
			mes "我想知道你这样伟大冒险者的名字，这样就能在别处谈论你。";
			next;
			mes "["+ strcharinfo(0) +"]";
			mes "我叫 "+ strcharinfo(0) +"。";
			next;
			mes "[Wuhari]";
			mes "哇！这个名字听起来就像在山、海和天空中击败过许多人！太厉害了！";
			next;
			emotion ET_SHY, playerattached();
			mes "["+ strcharinfo(0) +"]";
			mes "没什么。";
			mes "我没那么厉害。";
			next;
			mes "[Wuhari]";
			mes "嗯……"+ strcharinfo(0) +"，因为你看起来很可靠，所以我想问件事。";
			mes "可以请你帮个忙吗？";
			next;
			if (select("I'm kind of busy right now...:Of course!") == 1) {
				mes "[Wuhari]";
				mes "真的吗？那好吧……";
				next;
				emotion ET_CRY;
				mes "[Wuhari]";
			mes "抱歉打扰你。";
				close;
			}
			mes "[Wuhari]";
			emotion ET_SMILE;
		mes "真的吗？";
		mes "太谢谢你了！";
			next;
			mes "[Wuhari]";
		mes "我有一位^0000cd哥哥^000000。";
			next;
			mes "[Wuhari]";
		mes "我的哥哥……不是特别有名的学者。";
		mes "不过这些年因为困在家里太喜欢做家务，他的名气稍微下降了。";
			next;
			mes "[Wuhari]";
		mes "我到处奔波了一阵子，已经很久没见到他的脸了。";
			next;
			mes "[Wuhari]";
		mes "不是我自夸，我自己也是杰出的知识分子，很多人都来找我，哈哈。";
			next;
			mes "[Wuhari]";
		mes "总之，我们一直定期通信，但联系突然减少，我赶来见他才发现^0000cd他被关进了监狱^000000。";
			next;
			mes "[Wuhari]";
			mes "他们提到他的研究，但我不知道详情。我想了解更多，可我无法亲自前往。";
			next;
			mes "[Wuhari]";
			mes strcharinfo(0) +"，你愿意^0000cd代我去拜访哥哥^000000，查明情况后告诉我吗？";
			next;
			if (select("I would like to help you but...:Sure.") == 1) {
				mes "["+ strcharinfo(0) +"]";
				mes "我真的很想帮你，但是……";
				mes "是的，我想帮忙，但是……";
				next;
				mes "["+ strcharinfo(0) +"]";
				mes "我实在无法用其他方式表达帮忙的意愿……";
				mes "但真的很抱歉，我做不到。";
				next;
				mes "[Wuhari]";
				mes "哦，不，不。我相信你真的很忙。抱歉提出这样的请求。";
				ep14_2_big = 1;
				close;
			}
			mes "["+ strcharinfo(0) +"]";
			mes "当然。没什么大不了的。";
			next;
			mes "[Wuhari]";
			mes "真的吗？太谢谢你了。";
			mes "像你这样经验丰富的人，似乎也有一颗善良的心。";
		}
		else {
		mes strcharinfo(0) +"——你好，是什么风把你吹来了？";
		mes "我以为你很忙……";
			next;
			if (select("I wanted to help you.:Just because.") == 2) {
				mes "["+ strcharinfo(0) +"]";
				mes "我只是想知道事情进展如何。";
				next;
				mes "[Wuhari]";
				mes "没什么……还没有发生什么……";
				mes "凭我自己的力量什么都做不了……什么都做不了……";
				close;
			}
			mes "["+ strcharinfo(0) +"]";
			mes "我只是不能什么都不做就离开。";
			next;
			emotion ET_SMILE;
			mes "[Wuhari]";
			mes "这意味着你愿意去见我哥哥？";
			mes "太谢谢你了！！！";
		}
		next;
		mes "[Wuhari]";
		mes "监狱在宫殿里，但要找到它可能有点困难。";
		next;
		mes "[Wuhari]";
		mes "顺便说，我哥哥^0000cd不太会和陌生人说话。^000000";
		mes "他通常很害羞，也很内向。";
		next;
		mes "[Wuhari]";
		mes "所以你可能要对他耐心一些。请把这封^0000cd信^000000交给他。";
		next;
		emotion ET_GO;
		mes "[Wuhari]";
		mes "你还有很长的路要走，请上路吧。";
		ep14_2_big = 2;
		setquest 14118;
		getitem 6546,1;// Younger_Bro_Letter
		//getitem 7148,1;// Mother_Letter
	}
	else if (ep14_2_big < 7) {
	mes "你见过我哥哥了吗？";
		next;
		switch( select("I lost the letter.:Not yet.") ) {
			mes "[Wuhari]";
		case 1:
			if (countitem(6546) > 0) {	// Younger_Bro_Letter
			//if (countitem(7148) > 0) {
				mes "嗯……"+ strcharinfo(0) +"，你外套里的东西看起来是我的信……？";
			}
			else {
				mes "当然，我会再写一封给你，"+ strcharinfo(0) +"。和你要经历的麻烦相比，这不算什么。";
				getitem 6546,1;// Younger_Bro_Letter
				//getitem 7148,1// Mother_Letter
			}
			close;
		case 2:
			mes "我知道是我在请求你，但你能快一点吗？";
			next;
			mes "[Wuhari]";
			mes "我真的很担心他。";
			close;
		}
	}
	else if (ep14_2_big == 7 || ep14_2_big == 8) {
		if (ep14_2_big == 7) {
			mes "哦，"+ strcharinfo(0) +"，你见过我哥哥了吗？他怎么样？";
			next;
			mes "["+ strcharinfo(0) +"]";
			mes "你哥哥看起来过得不错。";
			next;
			mes "["+ strcharinfo(0) +"]";
			mes "和我第一次见他时相比，他出人意料地……说了很多话……";
			next;
			mes "[Wuhari]";
			mes "是啊……他很健谈，对吧？";
			next;
			mes "[Wuhari]";
			mes "他说了什么？";
			next;
			mes "- Wuhari 听说了 Wuhuru 的事 -";
			next;
			mes "[Wuhari]";
			mes "他为什么要做这种事……";
			next;
			mes "[Wuhari]";
			mes "嗯，我想他一直对自己的外貌抱有负面看法。";
			mes "他认为只要高大又漂亮，就能做到任何事。";
			next;
			select("你有什么不满吗？");
			mes "[Wuhari]";
			mes "不，我完全没有不满。";
			next;
			mes "[Wuhari]";
			mes "他总说我们在身体上处于劣势，至少要聪明，并且非常认真地教导我。";
			next;
			mes "[Wuhari]";
			mes "因此我现在可以很好地养活自己，而且我和他的关系非常牢固。";
			next;
			mes "[Wuhari]";
			mes "因为我的身材很娇小，即使年纪大了也有很多人喜欢我。";
			next;
			mes "[Wuhari]";
			mes "多亏如此，很多人给了我们许多好吃的，嘿嘿。";
			next;
			emotion ET_SMILE;
			mes "["+ strcharinfo(0) +"]";
			mes "......";
			next;
			mes "["+ strcharinfo(0) +"]";
			mes "你哥哥请我想办法帮他恢复身体。";
			next;
			mes "[Wuhari]";
			mes "是的，这毋庸置疑。我们不仅要恢复他的身体，还要把他从监狱救出来。";
			next;
			mes "[Wuhari]";
			mes "关于这件事，我其实还有另一个^0000cd请求^000000。";
			next;
			if (select("我想帮忙，但是……:当然可以。") == 1) {
				mes "[Wuhari]";
				mes "当然，你一定很忙。你愿意告诉我哥哥的消息，我已经很感激了。";
				ep14_2_big = 8;
				erasequest 14123;
				close;
			}
			mes "[Wuhari]";
			mes "太谢谢你了！";
		}
		else {
			mes "天啊，连找到的人都这么冷漠……我现在到底能怎么办……？";
			next;
			if (select("嗯，我可以帮你。:别理他。") == 2) {
				mes "[Wuhari]";
				mes "天啊～有没有人能帮忙～～这个世界真无情～";
				close;
			}
			mes "[Wuhari]";
			mes "真的吗？";
			mes "你是因为我看起来很悲伤才这么做的吗？";
			next;
			mes "[Wuhari]";
			mes "无论如何，我非常感谢你！";
		}
		next;
		mes "[Wuhari]";
		mes "首先，如果要想办法恢复他的身体，就必须弄清当时发生了什么。";
		next;
		mes "[Wuhari]";
		mes "了解他依据什么进行研究会有帮助。但即使听过他的故事，我也不太清楚。";
		next;
		mes "[Wuhari]";
		mes "看来现在没有办法弄清楚。要我独自调查，似乎太难了……";
		next;
		mes "[Wuhari]";
		mes "最好去询问^0000cd熟悉当时情况的人^000000。";
		next;
		mes "[Wuhari]";
		mes "拜托你了。同时我会仔细思考哥哥说过的话。";
		ep14_2_big = 9;
		if (isbegin_quest(14123))
			erasequest 14123;
		setquest 14125;
	}
	else if (ep14_2_big == 9) {
		mes "发生什么了？";
		next;
		mes "["+ strcharinfo(0) +"]";
		mes "我还在调查。";
		next;
		mes "[Wuhari]";
		mes "我明白了……拜托你了，请处理好这件事。";
	}

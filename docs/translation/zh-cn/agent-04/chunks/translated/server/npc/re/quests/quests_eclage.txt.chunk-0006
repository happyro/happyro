		close2;
	}
	cutin "",255;
	end;
}

ecl_in01,44,53,4	script	Delivery Man#ep14_2	4_M_DOGTRAVELER,{
	mes "[Delivery Man]";
	if (ep14_2_oliver == 25) {
		mes "是这个物品吗？";
		mes "我会安全寄出，不用担心。";
		next;
		mes "[Delivery Man]";
		mes "从斯普兰迪到艾可拉治的路以前很危险，但现在直接来艾可拉治反而更好。";
		next;
		mes "[Delivery Man]";
		mes "我不明白为什么人们不能自己做少量腌波利，非要邮寄……";
		emotion ET_CRY;
		ep14_2_oliver = 26;
		changequest 11333,11334;
	}
	else {
		mes "唉……";
		mes "我得出发才能准时。";
		next;
		mes "[Delivery Man]";
		mes "等一下……";
		mes "晚点送到真的更好吗……";
		mes "我记得仓库里有很多腌波利箱子等着送出……";
		emotion ET_CRY;
	}
	close;
}

ecl_in04,226,231,4	script	Du Lian#ep14_2in2	4_M_REDMAN,{
	if (checkweight(1201,1) == 0 || (MaxWeight - Weight) < 1000) {
		mes "- 站住！！ -";
		mes "- 重量太大 -";
		mes "- 无法接收物品。 -";
		mes "- 请减轻负重 -";
		mes "- 再试一次。-";
		close;
	}
	if (ep14_2_oliver == 29) {
		mes "[Du Lian]";
		mes "嗯……他去哪了……？";
		mes "他会不会是……幽灵？！";
		emotion ET_HUK, getnpcid(0, "Du Lian#ep14_2in2");
		cutin "bu_du5",2;
		next;
		mes "[Maggi Steen]";
		mes "我没有感觉到魔法或类似力量……";
		cutin "bu_maggi3",2;
		next;
		mes "[Maggi Steen]";
		mes "等等！这是 Oliver 戴的兜帽……";
		emotion ET_HUK, getnpcid(0, "Maggi Steen#ep14_2in2");
		cutin "bu_maggi4",2;
		next;
		mes "[Maggi Steen]";
		mes "还有……你不觉得房间和以前不一样吗？";
		emotion ET_PROFUSELY_SWEAT, getnpcid(0, "Mark Esha#ep14_2in2");
		cutin "bu_mark4",0;
		next;
		mes "[Du Lian]";
		mes "嘿，别这样！！";
		mes "吓死我了！！！";
		emotion ET_HUK, getnpcid(0, "Du Lian#ep14_2in2");
		cutin "bu_du5",2;
		next;
		mes "[Maggi Steen]";
	mes "啊啊啊～～";
		emotion ET_CRY, getnpcid(0, "Maggi Steen#ep14_2in2");
		cutin "bu_maggi4",2;
		next;
		mes "[Alp Ocart]";
		mes "Oh!!! 我刚想起来……";
	mes "Oliver……";
		emotion ET_SPARK, getnpcid(0, "Alp Ocart#ep14_2in2");
		cutin "bu_alp2",2;
		next;
		mes "[Alp Ocart]";
		mes "...";
		mes "Oliver Hilpert……";
		mes ".........也被称为梦境小说家……";
		emotion ET_THINK, getnpcid(0, "Alp Ocart#ep14_2in2");
		cutin "bu_alp3",2;
		next;
		mes "[Alp Ocart]";
		mes "还有这本书……";
		mes "Oliver 在的时候，我为什么没想起这本书？";
		cutin "bu_alp5",2;
		next;
		mes "[Du Lian]";
	mes "嘿……";
		mes "你刚从包里拿出那本书？";
		emotion ET_THINK, getnpcid(0, "Du Lian#ep14_2in2");
		cutin "bu_du5",2;
		next;
		mes "[Alp Ocart]";
		mes "是啊，因为我是粉丝……";
		emotion ET_SHY, getnpcid(0, "Alp Ocart#ep14_2in2");
		cutin "bu_alp4",2;
		next;
		mes "[Du Lian]";
	mes "既然你是粉丝，为什么没想起这本书……？";
	mes "而且，粉丝通常会随身带书吗？尤其是精装书？";
		emotion ET_HUK, getnpcid(0, "Du Lian#ep14_2in2");
		cutin "bu_du5",2;
		next;
		mes "[Alp Ocart]";
		mes "......";
		emotion ET_SHY, getnpcid(0, "Alp Ocart#ep14_2in2");
		cutin "bu_alp4",2;
		next;
		mes "[Du Lian]";
		mes "你有点奇怪……";
		cutin "bu_du1",2;
		next;
		mes "[Mark Esha]";
		mes "更重要的是……这本书的标题……";
		mes "是《妖精之城》？";
		emotion ET_HUK, getnpcid(0, "Mark Esha#ep14_2in2");
		cutin "bu_mark4",0;
		next;
		mes "[Mark Esha]";
		mes "还有……";
		mes "这本书出版已经很多年了……";
		emotion ET_HUK, getnpcid(0, "Mark Esha#ep14_2in2");
		next;
		mes "[Du Lian]";
	mes "……这越来越可怕了……？";
		emotion ET_HUK, getnpcid(0, "Du Lian#ep14_2in2");
		cutin "bu_du1",2;
		next;
		mes "[Mark Esha]";
		mes "......";
		emotion ET_THINK, getnpcid(0, "Mark Esha#ep14_2in2");
		cutin "bu_mark4",0;
		next;
		mes "[Maggi Steen]";
		mes "......";
		emotion ET_THINK, getnpcid(0, "Maggi Steen#ep14_2in2");
		cutin "bu_maggi4",2;
		next;
		mes "[Alp Ocart]";
		mes "......";
		emotion ET_THINK, getnpcid(0, "Alp Ocart#ep14_2in2");
		cutin "bu_alp2",2;
		ep14_2_oliver = 30;
		getitem 19543,1;//Oliver_Wolf_Hood
		completequest 11337;
	}
	else {
		.@npc_name$ = strnpcinfo(1);
		setarray .@npc$[0],"Du Lian","Mark Esha","Maggi Steen","Alp Ocart";
		for ( .@i = 0; .@i < 4; .@i++ )
			if (.@npc_name$ == .@npc$[.@i]) break;
		switch(.@i) {
		case 0:
			mes "[Du Lian]";
			mes "但这是第一卷。难道还有更多？";
			emotion ET_THINK;
			cutin "bu_du1",2;
			next;
			mes "[Alp Ocart]";
			mes "总共有 3 卷。";
			emotion ET_BEST, getnpcid(0, "Alp Ocart#ep14_2in2");
			cutin "bu_alp1",2;
			next;
			mes "[Du Lian]";
			mes "哇，你带了多少本……";
			mes "你为什么把它们全带在身边……";
			emotion ET_HUK;
			cutin "bu_du5",2;
			break;
		case 1:
			mes "[Mark Esha]";
			mes "大家冷静！！！";
			mes "这一定是某种梦境！";
			emotion ET_HUK;
			emotion ET_HUK, getnpcid(0, "Du Lian#ep14_2in2");
			cutin "bu_mark2",0;
			next;
			mes "[Du Lian]";
			mes "你为什么因为说这是梦就打我！";
			mes "好痛！";
			emotion ET_PROFUSELY_SWEAT, getnpcid(0, "Du Lian#ep14_2in2");
			cutin "bu_du4",2;
			next;
			mes "[Mark Esha]";
			mes "啊啊啊，也许这真的不是梦！！！";
			emotion ET_HUK;
			emotion ET_FRET, getnpcid(0, "Du Lian#ep14_2in2");
			cutin "bu_mark3",0;
			break;
		case 2:
			mes "[Maggi Steen]";
			mes "……啊……啊……啊啊啊啊啊！！！！！";
			emotion ET_CRY;
			cutin "bu_maggi4",2;
			next;
			mes "[Du Lian]";
			mes "别哭，Maggi～";
			emotion ET_PROFUSELY_SWEAT, getnpcid(0, "Du Lian#ep14_2in2");
			cutin "bu_du4",2;
			break;
		case 3:
			mes "[Alp Ocart]";
			mes "我想知道……";
			mes "我为什么没想起这个……？";
			emotion ET_HUK;
			cutin "bu_alp5",2;
			next;
			mes "[Alp Ocart]";
			mes "我……我本该……本该拿到他的签名！！！";
			emotion ET_HUK;
		}
	}
	close2;
	cutin "",255;
	end;
}
ecl_in04,224,234,4	duplicate(Du Lian#ep14_2in2)	Mark Esha#ep14_2in2	4_M_BLUEMAN
ecl_in04,223,234,4	duplicate(Du Lian#ep14_2in2)	Maggi Steen#ep14_2in2	4_F_PINKWOMAN

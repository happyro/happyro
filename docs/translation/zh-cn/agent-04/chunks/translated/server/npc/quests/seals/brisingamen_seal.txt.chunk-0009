			mes "我不知道你在这里";
			mes "到底";
			mes "做什么，";
			mes "但离开！";
			close2;
			hideonnpc "Dvalin#1";
			end;
		case 2:
			mes "[德瓦林]";
			mes "你说是阿尔弗里克派来的？你怎么认识我哥哥？！";
			next;
			mes "[德瓦林]";
			mes "布里希嘉曼？！";
			mes "那意味着我们能";
			mes "再次见到芙蕾雅？！";
			next;
			mes "[" + strcharinfo(0) + "]";
			mes "嗯……";
			mes "恐怕不是。";
			mes "至少这不是";
			mes "我来这里的原因。";
			next;
			mes "[德瓦林]";
			mes "好吧……";
			mes "我明白。";
			mes "抱歉，我只是希望你是";
			mes "芙蕾雅的使者。";
			mes "";
			next;
			mes "[德瓦林]";
			mes "所以，是布里希嘉曼的仿制品……";
			mes "";
			mes "即使不是原件，我相信它也拥有与真品相当的力量。是的……";
			next;
			mes "[德瓦林]";
			mes "无法预测未来，但我想知道人类会如何使用诸神的力量？";
			next;
			mes "[德瓦林]";
			mes "既然哥哥阿尔弗里克认可你，我会帮助你。我告诉你如何唤醒哥哥伯灵。";
			next;
			mes "[德瓦林]";
			mes "我们藏在芙蕾雅的痕迹附近。我所在的道路是女神走过的。";
			next;
			mes "[德瓦林]";
			mes "这里静静流动的空气带着她的香气。你可以借此风借用她的力量。";
			next;
			mes "[德瓦林]";
			mes "除了芙蕾雅，我对其他";
			mes "神或巨人没特殊感情。但我对人类着迷，你们兼具爱与恨、生命与毁灭。";
			next;
			mes "[德瓦林]";
			mes "去寻找伯灵。他在连接雷神之锤山的河边沉睡。向西找到芙蕾雅之泪落下的河流。";
			next;
			mes "[德瓦林]";
			mes "如果水之幻影问你问题，就回答。答案是奥丁给女神的惩罚。";
			next;
			mes "[德瓦林]";
			mes "在数千名女武神填满瓦尔哈拉前，她们必须不断活着、死去，第二天重生后再次死去。";
			next;
			mes "[德瓦林]";
			mes "想想";
			mes "她们是谁。";
			mes "我能告诉你的只有这些。";
			next;
			mes "[德瓦林]";
			mes "不知为何，我知道你";
			mes "就是那个";
			mes "能回答问题的人。";
			mes "哈哈哈哈！";
			set god_brising,43;
			close2;
			hideonnpc "Dvalin#1";
			end;
		}
	}
	else if (god_brising == 43) {
		mes "[德瓦林]";
		mes "你为什么一直叫我？我已经为你做完一切，甚至给了你问题的钥匙。";
		next;
		mes "[德瓦林]";
		mes "从现在起，";
		mes "一切取决于你。";
		mes "现在去唤醒伯灵……";
		close2;
		hideonnpc "Dvalin#1";
		end;
	}

OnInit:
	hideonnpc "Dvalin#1";
	end;

}

mjolnir_09,85,129,0	script	#brisindwarf3	111,3,3,{
	if ($God2 < $@god_check1) {

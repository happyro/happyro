		next;
		switch(select("20！","我怎么知道？！","40！","42！" )) {
		case 1:
			specialeffect EF_BUBBLE;
			mes "[回响的声音]";
			mes "失败。";
			mes "失败……";
			close;
		case 2:
			specialeffect EF_BUBBLE;
			mes "[回响的声音]";
			mes "失败。";
			mes "失败……";
			close;
		case 3:
			specialeffect EF_BUBBLE;
			mes "[回响的声音]";
			mes "失败。";
			mes "失败……";
			close;
		case 4:
			specialeffect EF_BUBBLE;

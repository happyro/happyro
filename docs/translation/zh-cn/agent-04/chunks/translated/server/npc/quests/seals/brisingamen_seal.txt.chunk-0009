		mes "^3355FF看着这股冒泡的溪流让你精神一振。^000000";
		close;
	}

OnTouch_:
	if (god_brising > 42) {
		emotion ET_SURPRISE, playerattached();
	}
	end;
}

mjolnir_09,87,129,3	script	Berling#1	826,{
	if (god_brising > 44) {
		mes "[伯灵]";
		mes "是你唤醒了我们？哈哈哈，也许这是我们能再次见到芙蕾雅的征兆！哈哈哈哈！";
		next;
		mes "[伯灵]";
		mes "感谢你让我们复活。好吧，我知道你想要什么，我会帮助你获得诸神的力量。";
		close2;
		hideonnpc "OnBerling#1";
		end;
	}
	else if (god_brising == 43) {
		mes "[伯灵]";
		mes "什么……？是人类？！你想要什么？你、你是谁？";
		next;
		switch(select("德瓦林想让你醒来！:先告诉我你是谁！")) {
		case 1:
			mes "[伯灵]";
			mes "德瓦林？！你是说我的弟弟！";
			mes "但只有阿尔弗里克复活后他才能复活。发生了什么？";
			next;
			mes "[" + strcharinfo(0) + "]";
			mes "嗯……";
			mes "让我解释一下……";
			next;
			mes "...";
			mes "......";
			mes ".........";
			next;
			mes "["+ strcharinfo(0) +"]";
			mes "……所以我需要唤醒你们四位矮人，才能重新制作承载芙蕾雅力量的布里希嘉曼。";
			next;
			mes "[伯灵]";
			mes "哦！再说一次那个名字！芙蕾雅，夺走我身心的女神！你刚才说要制作她的项链？";
			next;
			mes "[伯灵]";
			mes "哈哈哈哈！";
			mes "别开玩笑了。布里希嘉曼是独一无二的杰作！";
			next;
				switch(select("我说的不是原版，但是……")) {
			case 1:
				mes "[伯灵]";
				mes "啊，我明白了！你想要一件拥有大致相同力量的复制品。";
				mes "一件供人类使用的布里希嘉曼！真聪明！";
				next;
				mes "[伯灵]";
				mes "另一方面，我并不渴望力量。只要能拥有女神的一缕头发，我就心满意足了。";
				next;
				mes "[伯灵]";
				mes "哦，芙蕾雅……这个世界上留下的她的美越多，我就越幸福。";
				mes "我非常愿意帮助你重现这件芙蕾雅的纪念物。";
				next;
				mes "[伯灵]";
				mes "现在去找我最后一位兄弟吧！可怜的格雷尔，也许他还在矿井里为她挖银子……";
				next;
				mes "[伯灵]";
				mes "去找格雷尔。我会把芙蕾雅的金色泪滴给你，但他也许已经自行复活了……";
				next;
				mes "[伯灵]";
				mes "如果他不信任你，就唱这首歌。你必须记住每一句歌词……";
				next;
				mes "[伯灵]";
				mes "^4d4dff世上没有宝石能与之相比。^000000";
				next;
				mes "[伯灵]";
				mes "^4d4dff我们用爱打造的杰作。^000000";
				next;
				mes "[伯灵]";
				mes "^4d4dff她想要耀眼的项链。^000000";
				next;
				mes "[伯灵]";
				mes "^4d4dff我们想要美丽的女神。^000000";
				next;
				mes "[伯灵]";
				mes "^4d4dff我们最快乐的时光都与她相伴。^000000";
				next;
				mes "[伯灵]";
				mes "准确记住这首歌的五句歌词。现在拿上这颗金色泪滴，去找格雷尔。";
				specialeffect2 EF_IMPOSITIO;
				set god_brising,44;
				close2;
				hideonnpc "Berling#1";
				end;
			}
		case 2:
			mes "[伯灵]";
			mes "你到底是从哪里来的？";
			mes "我伯灵拒绝把名字告诉你这种粗鲁无礼的人类！";
			next;
			mes "[" + strcharinfo(0) + "]";
			mes "等等……你的名字是伯灵？";
			next;
			mes "[伯灵]";
			mes "哇啊啊啊！闭嘴！管好你自己的事！";
			close2;
			hideonnpc "Berling#1";
			end;
		}
	}
	else if (god_brising == 44) {
		mes "[伯灵]";
		mes "你已经忘了歌词吗？我再告诉你一次，这次别忘了。";
		next;
		mes "[伯灵]";
		mes "^4d4dff世上没有宝石能与之相比。^000000";
		next;
		mes "[伯灵]";
		mes "^4d4dff我们用爱打造的杰作。^000000";
		next;
		mes "[伯灵]";
		mes "^4d4dff她想要耀眼的项链。^000000";
		next;
		mes "[伯灵]";
		mes "^4d4dff我们想要美丽的女神。^000000";
		next;
		mes "[伯灵]";
		mes "^4d4dff我们最快乐的时光都与她相伴。^000000";
		close2;
		hideonnpc "Berling#1";
		end;
	}

OnInit:
	hideonnpc "Berling#1";
	end;
}

mjo_dun02,126,36,0	script	#brisindwarf4	111,3,3,{
	if ($God2 < $@god_check1) {
		mes "[" + strcharinfo(0) + "]";
		mes "哼，没有出口。";
		close;
	}
	if ($God3 >= $@god_check2) {
		mes "[" + strcharinfo(0) + "]";
		mes "哼，没有出口。";
		close;
	}
	if ((god_brising > 45) && (god_brising < 50)) {
		mes "[格雷尔]";
		mes "什么！";
		hideoffnpc "Grer#1";
		close;
	}
	else if (god_brising == 45) {
		mes "[" + strcharinfo(0) + "]";
		mes "让我看看。嗯，那首歌。第一句是什么来着……？";
		next;
		input @dwarfsong1$;
		if (@dwarfsong1$ == "No jewel in the world can compare.") set @point,@point +1;
		mes "[" + strcharinfo(0) + "]";
		mes " " + @dwarfsong1$ + "";
		mes "那么……嗯……第二句？";
		next;
		input @dwarfsong2$;
		if (@dwarfsong2$ == "Our masterpiece made from love.") set @point,@point +1;
		mes "[" + strcharinfo(0) + "]";
		mes " " + @dwarfsong2$ + "";
		mes "现在第三句是什么来着……？";
		next;
		input @dwarfsong3$;
		if (@dwarfsong3$ == "She wanted the dazzling necklace.") set @point,@point +1;
		mes "[" + strcharinfo(0) + "]";
		mes " " + @dwarfsong3$ + "";
		mes "然后是第四句……";
		next;
		input @dwarfsong4$;
		if (@dwarfsong4$ == "We wanted the goddess of beauty.") set @point,@point +1;
		mes "[" + strcharinfo(0) + "]";
		mes " " + @dwarfsong4$ + "";
		mes "好，现在是最后一句……";
		next;
		input @dwarfsong5$;
		if (@dwarfsong5$ == "Our happiest times were with her.") set @point,@point +1;
		mes "[" + strcharinfo(0) + "]";
		mes " " + @dwarfsong5$ + "";
		mes "好吧，我们试试看。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "" + @dwarfsong1$ + "";
		mes "" + @dwarfsong2$ + "";
		mes "" + @dwarfsong3$ + "";
		mes "" + @dwarfsong4$ + "";
		mes "" + @dwarfsong5$ + "";
		next;
		if (@point > 4) {
			hideoffnpc "Grer#1";
			mes "[格雷尔]";
		mes "什么——？是伯灵派你来的！";
			set god_brising,46;
			stopnpctimer;
			close;
		}
		else {
			mes "[格雷尔]";
		mes "哼！我就知道！我不能相信你！";
			close2;
			warp "mjo_dun02",118,56;
			end;
		}
	}
	else {
		mes "^3355FF你发现一个洞，里面有土块和一块煤。^000000";
		close;
	}

OnTouch_:
	if ($God2 < $@god_check1) {
		mes "[" + strcharinfo(0) + "]";
		mes "哼，没有出口。";
		close;
	}
	if ($God3 >= $@god_check2) {
		mes "[" + strcharinfo(0) + "]";
		mes "哼，没有出口。";
		close;
	}
	if (god_brising == 44) {
		emotion ET_SURPRISE, playerattached();
		mes "[男性声音]";
		mes "别再靠近了！";
		mes "我怎么会在你身上感觉到";
		mes "芙蕾雅的气息？";
		mes "告诉我你是谁！";
		next;
		switch(select("我是伯灵派来的。:哇，你吓到我了！")) {
		case 1:
			mes "[男性声音]";
			mes "谎言！谎言！证明给我看！证明你自己！";
			set god_brising,45;
			initnpctimer;
			close;
		case 2:
			mes "[男性声音]";
			mes "滚出去！";
			close;
		}
	}
	else if (god_brising == 45) {
		mes "[男性声音]";
		mes "证明给我看！否则就别烦我，让我挖银子。银子……！嘿嘿嘿……";
		stopnpctimer;
		startnpctimer;
		close;
	}
	else {
		warp "mjo_dun02",118,56;
	}
	end;

OnTimer1000:
	mapannounce "mjo_dun02","Grer: Hurry and show that I can trust you!",0,0x70DBDB;
	end;

OnTimer240000:
	mapannounce "mjo_dun02","Grer: Grrr, I won't wait much longer!",0,0x70DBDB;
	end;

OnTimer298000:
	mapannounce "mjo_dun02","Grer: Farewell, human!",0,0x70DBDB;
	end;

OnTimer300000:
	warp "mjo_dun02",118,56;
	hideonnpc "Grer#1";
	end;

OnTimer301000:
	stopnpctimer;
	end;
}


prt_q,156,324,6	script	Chief Guard#EP161PG	4_EP16_SPIEGEL,{
	if (checkweight(1301,1) == 0) {
		mes "- 你携带的物品太多，无法继续任务。-";
		close;
	}
	if (BaseLevel < 140) {
		mes "[Chief Guard Spiegel]";
		mes "你是冒险者吗？抱歉，我正忙着。请别打扰我。";
		close;
	}

	switch( checkquest(5452,PLAYTIME) ) {
	case -1:
		break;
	case 0:
	case 1:
		mes "[Chief Guard Spiegel]";
		mes "我代表普隆德拉卫兵感谢你。";
		next;
		mes "[Chief Guard Spiegel]";
		mes "我们会尽快结束与亡灵的战斗。";
		close;
	case 2:
		erasequest 5452;// [Stand by]Request from Chief Guard
		break;
	}

	setarray .@completed_list[0],5456,5459,5462,5468;
	setarray .@sub_quest_5456[0],5448,5453,5454,5455;
	setarray .@sub_quest_5459[0],5449,5457,5458;
	setarray .@sub_quest_5462[0],5450,5460,5461;
	setarray .@sub_quest_5468[0],5451,5463,5464,5465,5466,5467;

	for ( .@i = 0; .@i < 4; .@i++ ) {
		if (isbegin_quest(.@completed_list[.@i]) == 1) {// quest completed
			.@main_quest_id = .@completed_list[.@i];
			break;
		}
		.@size = getarraysize( getd( ".@sub_quest_" + .@completed_list[.@i] ) );
		for ( .@j = 0; .@j < .@size; .@j++ ) {
			if (isbegin_quest( getd( ".@sub_quest_" + .@completed_list[.@i] + "[" + .@j + "]") ) == 1) {// sub quest started
				.@sub_quest_id = getd( ".@sub_quest_" + .@completed_list[.@i] + "[0]");
				break;
			}
		}
		if (.@j < .@size)
			break;
	}

	switch(.@main_quest_id) {
	case 5456:
		mes "[Chief Guard Spiegel]";
		mes "我听派往村公所附近的士兵说，你帮助了村民。";
		next;
		mes "[Chief Guard Spiegel]";
		mes "他是个在村里待了一阵子的年轻人。看起来工作很勤奋……";
		next;
		mes "[Chief Guard Spiegel]";
		mes "不过，经营普隆德拉冶炼厂的 Quadro 先生似乎在混乱中弄丢了重要文件。";
		next;
		mes "[Chief Guard Spiegel]";
		mes "他负责卫兵使用的武器。我担心这会影响他的工作。";
		next;
		emotion ET_THANKS;
		mes "[Chief Guard Spiegel]";
		mes "哦！总之，谢谢你帮助村民。";
		next;
		erasequest 5456;// Ungrateful(4)
		setquest 5452;// [Stand by]Request from Chief Guard
		getexp 800000,250000;
		getitem 6919,4;// TokenOfHonor
		mes "[Chief Guard Spiegel]";
		mes "现在情况艰难，我们无法提供太华丽的奖励，但这是卫兵为你准备的报酬。";
		close;
	case 5459:
		mes "[Chief Guard Spiegel]";
		mes "我听派往骑士楼的士兵说，你救了 Lowen。";
		next;
		mes "[Chief Guard Spiegel]";
		mes "Lowen 是个活泼的女孩，她说相比皇家骑士更喜欢十字军。";
		next;
		mes "[Chief Guard Spiegel]";
		mes "那个女孩的妹妹 Rosa 在我们的士兵中也很受欢迎。";
		next;
		emotion ET_THANKS;
		mes "[Chief Guard Spiegel]";
		mes "我代表普隆德拉卫兵感谢你。";
		next;
		erasequest 5459;// Find My Sister(3)
		setquest 5452;// [Stand by]Request from Chief Guard
		getexp 800000,250000;
		getitem 6919,4;// TokenOfHonor
		mes "[Chief Guard Spiegel]";
		mes "现在情况艰难，我们无法提供太华丽的奖励，但这是卫兵为你准备的报酬。";
		close;
	case 5462:
		mes "[Chief Guard Spiegel]";
		mes "我听派往村公所的士兵说，有名休假的士兵逃到了这里。";
		next;
		mes "[Chief Guard Spiegel]";
		mes "我没想到这种困难时期还有士兵休假。收到报告前我完全不知道。";
		next;
		emotion ET_THANKS;
		mes "[Chief Guard Spiegel]";
		mes "作为首都治安负责人，我感到了自己的不足。";
		next;
		erasequest 5462;// Blatant Bluff(3)
		setquest 5452;// [Stand by]Request from Chief Guard
		getexp 800000,250000;
		getitem 6919,4;// TokenOfHonor
		mes "[Chief Guard Spiegel]";
		mes "现在情况艰难，我们无法提供太华丽的奖励，但这是卫兵为你准备的报酬。";
		close;
	case 5468:
		mes "[Chief Guard Spiegel]";
		mes "我听大教堂的士兵说，你救了 Eryus 和 Ellie 这对情侣。";
		next;
		mes "[Chief Guard Spiegel]";
		mes "我好像听过他们的名字。据说他们没完没了地公开秀恩爱，惹得孤独的士兵心烦。";
		next;
		emotion ET_THANKS;
		mes "[Chief Guard Spiegel]";
		mes "普隆德拉所有人应该都知道这件事。总之，谢谢你为卫兵做这些。";
		next;
		erasequest 5468;// Mad Love for Wife(6)
		setquest 5452;// [Stand by]Request from Chief Guard
		getexp 800000,250000;
		getitem 6919,4;// TokenOfHonor
		mes "[Chief Guard Spiegel]";
		mes "现在情况艰难，我们无法提供太华丽的奖励，但这是卫兵为你准备的报酬。";
		close;
	}

	if (.@sub_quest_id > 0) {
		mes "[Chief Guard Spiegel]";
		mes "我会在地图上标记因情况特殊而未派遣士兵的地点。";
		next;
		switch(.@sub_quest_id) {
		case 5448:
			viewpoint 1,221,193,1,0xFF0000;
			break;
		case 5449:
			viewpoint 1,276,242,1,0xFF0000;
			break;
		case 5450:
			viewpoint 1,140,304,1,0xFF0000;
			break;
		case 5451:
			viewpoint 1,38,261,1,0xFF0000;
			break;
		}
		mes "[Chief Guard Spiegel]";
		mes "如果发现遇到困难的村民，请帮助他们。";
		close;
	}
	emotion ET_STARE;
	mes "[Chief Guard Spiegel]";
	mes "别站在队伍中间！小心！";
	next;
	emotion ET_COMEON;
	mes "[Chief Guard Spiegel]";
	mes "受伤的话就退后治疗。恢复后回到队伍中。";
	next;
	mes "[Chief Guard Spiegel]";
	mes "嗯？我以前没见过你。你看起来像平民，为什么从那里过来？";
	next;
	emotion ET_HUK;
	mes "[Chief Guard Spiegel]";
	mes "什么？亡灵已经进入宫殿了吗？";
	next;
	select("不……我不这么认为……我只是……");
	mes "[Chief Guard Spiegel]";
	mes "所以你就是受邀参加宴会的冒险者，对吧？";
	next;
	emotion ET_QUESTION;
	mes "[Chief Guard Spiegel]";
	mes "宫殿最近举办过宴会吗？我不记得了。";
	next;
	mes "[Chief Guard Spiegel]";
	mes "嗯……我们正忙着处理";
	mes "入侵村庄的亡灵，只要宫殿没有亡灵，我就不计较了。";
	next;
	mes "[Chief Guard Spiegel]";
	mes "我不会阻止你在城镇中行动。我会在地图上标记因情况特殊而未派遣士兵的地点。";
	emotion ET_PROFUSELY_SWEAT;
	.@quest_id = rand(5448,5451);
	switch(.@quest_id) {
	case 5448:
		viewpoint 1,221,193,1,0xFF0000;
		break;
	case 5449:
		viewpoint 1,276,242,1,0xFF0000;
		break;
	case 5450:
		viewpoint 1,140,304,1,0xFF0000;
		break;
	case 5451:
		viewpoint 1,38,261,1,0xFF0000;
		break;
	}
	setquest .@quest_id;// Request from Chief Guard
	next;
	mes "[Chief Guard Spiegel]";
	mes "如果发现遇到困难的村民，请帮助他们。";
	close;
}


// Request 1
prt_q,221,193,0	script	Lad Quest_START#EP161QU01	HIDDEN_WARP_NPC,6,6,{
	end;
OnTouch:
	if (isbegin_quest(5448) == 1) {
		cloakoffnpcself( "Village Lad#EP161HO01" );
		npctalk "村里的男孩：啊啊啊啊！", "Village Lad#EP161HO01", bc_self;
	}
	end;
}

prt_q,221,193,4	script	Village Lad#EP161HO01	4_M_03,{
	if (checkweight(1301,3) == 0) {
		mes "- 你携带的物品太多，无法继续任务。-";
		close;
	}
	if (isbegin_quest(5448) == 1) {
		emotion ET_CRY;
		mes "[Village Lad]";
		mes "哇……你不是亡灵，对吧？";
		next;
		mes "[Village Lad]";
		mes "哈哈……我现在还活着。";
		next;
		mes "[Village Lad]";
		mes "你知道我有多害怕吗？这里到处都是亡灵，我从四面八方听到尖叫。";
		next;
		erasequest 5448;// Request from Chief Guard
		setquest 5453;// Ungrateful(1)
		viewpoint 2,221,193,1,0xFF0000;
		mes "[Village Lad]";
		mes "谢天谢地……避难所应该就在那边的村公所附近。我们去那里继续聊吧？";
		close2;
	}
	else {
		mes "[Village Lad]";
		mes "你看得见我吗？真奇怪。我本来不该被看见。";
		close2;
	}
	cloakonnpcself( "Village Lad#EP161HO01" );
	end;

OnInit:
	cloakonnpc();
	end;
}

// Office
prt_q,79,96,7	script	Soldier#EP161HO02	8W_SOLDIER,5,5,{
	if (checkweight(1301,1) == 0) {
		mes "- 你携带的物品太多，无法继续任务。-";
		close;
	}
	if (isbegin_quest(5454) == 1) {
		emotion 55;
		mes "[Village Lad]";
		mes "嗯……？真厚脸皮！那家伙……从海里救了陌生人，还要得寸进尺……";
		next;
		emotion 17;
		mes "[Village Lad]";
		mes "哦！我不是故意偷听的。请别误会。";
		close;
	}
	if (isbegin_quest(5462) == 1) {
		emotion 20;
		mes "[Village Lad]";
		mes "亲爱的冒险者。我想那套制服是吉芬卫兵穿的。";
		next;
		emotion 9;
		mes "[Village Lad]";
		mes "那个士兵是谁？这种情况下他却很顺利地进入避难所，真让人困惑。";
		close;
	}
	mes "[Village Lad]";
	mes "这里是普隆德拉的第三避难所，也就是村公所。";
	close;

OnTouch:
	if (isbegin_quest(5453) == 1 || isbegin_quest(5455) == 1)
		cloakoffnpcself( "Village Lad#EP161HO03" );
	if (isbegin_quest(5461) == 1)
		cloakoffnpcself( "Soldier#EP161HU03" );
	end;
}

prt_q,77,98,8	script	Village Lad#EP161HO03	4_M_03,{
	if (checkweight(1301,1) == 0) {
		mes "- 你携带的物品太多，无法继续任务。-";
		close;
	}
	if (isbegin_quest(5453) == 1) {
		emotion ET_DELIGHT;
		mes "[Village Lad]";
		mes "哇……我得救了。真幸运。我想我是个幸运的人。";
		next;

		mes "那么，一定是被他们^4d4dff带走了^000000，对吧？";
		next;
		select("没错。");
		mes "[Nillem]";
		mes "我们能阻止吗？";
		mes "或者能带走它吗？";
		next;
		mes "[Nillem]";
		mes "我相信上级会命令我们这么做。";
		mes "想尽办法让它成功。";
		next;
		select("我想是吧。 ");
		mes "[Nillem]";
		mes "也许吧，不过只是我的想象。";
		mes "意识之室里的东西被拿走了，对吧？";
		mes "然而，不知为何，王室一直在不知情的情况下进行仪式。";
		next;
		mes "[Nillem]";
		mes "他们一定做了什么，或者它回来了……";
		mes "这可能满足查看^4d4dff王室过去记忆^000000封印部分的条件……";
		next;
		select("你是说那些知道真相的人？");
		mes "[Nillem]";
		mes "没错，我就是这个意思。如果这就是开启封印的关键真相，";
		mes "我们带回了一条重要信息。";
		next;
		mes "[Nillem]";
		mes "我们没有保护或带走那个东西……";
		mes "但我们现在知道真相了。它会打破文件的封印……";
		next;
		mes "[Nillem]";
		mes "随着王室秘密揭露，我们会得到谜题缺失的碎片。";
		mes "哈哈哈，而你就是这一切的中心，亲爱的！";
		next;
		select("别这样叫我！");
		mes "[Nillem]";
		mes "那又怎样？";
		mes "从现在起我们每天都会见面，对吧？";
		unittalk getcharid(3), "" + strcharinfo(0) + "：……呼……", bc_self;
		next;
		mes "[Nillem]";
		mes "那么，我们回去吧？";
		mes "我们在这里的任务暂时完成了！";
		next;
		mes "[Nillem]";
		mes "回去吧！";
		mes "在不属于我们时代的地方待太久没有好处";
		next;
		mes "[Nillem]";
		mes "那么，准备好！";
		mes "三！";
		sleep2 2000;
		mes "二！";
		sleep2 1000;
		mes "一！";
		close2;
		warp "prt_lib",88,80;
		end;
	}
	mes "[Nillem]";
	mes "哈哈！这里真刺激……";
	mes "……一如往常。";
	next;
	if (select( "离开这里！", "我再看看。" ) == 2) {
		mes "[Nillem]";
		mes "一路平安！";
		close;
	}
	mes "[Nillem]";
	mes "我们走！";
	mes "忘掉一切，离开这里——";
	close2;
	warp "prt_lib",89,43;
	end;
}

prt_q,159,328,6	script	Medic#EP162PS18	4_F_ACOLYTE,{
	specialeffect EF_HEAL3,AREA,"Wounded Soldier#EP161PS";
	mes "[Soldier]";
	mes "嘿，你得先接受治疗。";
	close;
}

prt_q,160,327,5	script	Wounded Soldier#EP161PS17	8W_SOLDIER,{
	emotion ET_STARE;
	mes "[Soldier]";
	mes "啊……那些不死混蛋……我要杀光它们……";
	close;
}

prt_q,165,326,6	script	Soldier#EP162PS01	8W_SOLDIER,1,1,{
	mes "[Soldier]";
	sscanf( strnpcinfo(2), "EP162PS%d", .@num );
	switch(.@num) {
	case 1:
		emotion ET_FRET;
		mes "啊……那些亡灵……";
		close;
	case 2:
		emotion ET_CRY;
		mes "刚才还和我一起笑的同事……呜……";
		close;
	case 3:
		mes "拜托，别被敌人杀死。";
		close;
	case 4:
		emotion ET_CONFUSE;
		mes "从天上掉下来的是什么？它怎么把不死生物带到首都？";
		close;
	case 5:
		emotion ET_STARE;
		mes "我……我一定会守护这里。";
		close;
	case 6:
		emotion ET_OTL;
		mes "与敌人的无尽战斗……";
		close;
	case 7:
		mes "古怪的科学家 Doyeon 和士兵一起出去了，却一直没有消息。我开始担心了。";
		close;
	case 8:
		emotion ET_PROFUSELY_SWEAT;
		mes "该死……那些亡灵……";
		close;
	case 9:
		mes "科学家 Doyeon……她没事吧？这种情况下怎么能出去研究？";
		close;
	case 10:
		mes "不死军团……它们真的很强。请小心。";
		close;
	case 11:
		emotion ET_ROCK;
		mes "我们会守卫普隆德拉宫殿。";
		close;
	case 12:
		emotion ET_OHNO;
		mes "我的家人住在普隆德拉。不知道他们是否安全逃走了。";
		close;
	case 13:
		emotion ET_HUM;
		mes "谢天谢地……亡灵没有怎么往这边来。真是松了口气。";
		close;
	case 14:
		mes "我的朋友跟着科学家 Doyeon 出去了。我很担心。听说她确实是个怪人。";
		close;
	case 15:
		emotion ET_OHNO;
		mes "哈哈哈，我本来应该和女朋友共进浪漫晚餐，该死！";
		close;
	case 16:
		emotion ET_PROFUSELY_SWEAT;
		mes "哼！放马过来！";
		close;
	}
	end;
OnTouch:
	end;
OnTouchNPC:
	sscanf( strnpcinfo(2), "EP162PS%d", .@num );
	setarray .@text$[1],
		"Soldier: Huh!",
		"Soldier: Hiya!",
		"Soldier: Heh...",
		"Soldier: Humph!",
		"Soldier: Whoa!",
		"Soldier: Argh!",
		"Soldier: Humph!",
		"Soldier: Huh!",
		"Soldier: Hiya!",
		"Soldier: Humph!",
		"Soldier: Huh!",
		"Soldier: Whoa!",
		"Soldier: Argh!",
		"Soldier: Hiya!",
		"Soldier: Whoa!",
		"Soldier: Argh...";
	npctalk .@text$[.@num];
	specialeffect EF_ATTACKENERGY2;
	unitwarp 0,"prt_q",100,100;
	end;
}

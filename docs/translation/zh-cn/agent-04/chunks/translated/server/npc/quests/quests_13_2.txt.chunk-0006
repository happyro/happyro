spl_fild01,357,44,0	script	???#ep13mdf01	844,{
	if (checkweight(1201,2) == 0) {
		mes "等一下！！";
		mes "你携带的物品太多。";
		mes "无法领取这个。";
		mes "减轻负重后";
		mes "再试。";
		close;
	}
	if (ep13_mdrama == 14) {
		mes "地上有某种水果。";
		mes "我看到大外壳里有一颗小浆果……";
		mes "这是世界树果实！";
		set ep13_mdrama,15;
		getitem 607,1; //Yggdrasilberry
		getitem 522,1; //Fruit_Of_Mastela
		close;
	}
	else if (ep13_mdrama == 15) {
		mes "我已经拔出一颗世界树果实……还有别的吗……？";
		next;
		set .@apple,rand(1,100);
		if (.@apple < 50) {
			mes "我被不知名的昆虫咬了。";
			mes "好痛！";
			percentheal -30,0;
			close;
		}
		else if (.@apple == 50) {
			mes "我找到一个苹果。";
			getitem 512,1; //Apple
			close;
		}
		else {
			mes "没有其他东西。";
			close;
		}
	}
	else if (ep13_mdrama > 15) {
		mes "只剩空壳了。";
		close;
	}
	else {
		mes "这里有一个巨大水果。";
		mes "我不知道这是什么水果。";
		close;
	}
}


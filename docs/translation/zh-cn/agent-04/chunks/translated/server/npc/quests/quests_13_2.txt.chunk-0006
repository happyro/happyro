manuk,252,116,3	script	Manuk Galtun#ep13_2day	450,{
	if (checkweight(1201,2) == 0) {
		mes "等一下！！";
		mes "你携带的物品太多。";
		mes "无法领取这个。";
		mes "减轻负重后";
		mes "再试。";
		close;
	}
	if ((isequipped(2782) == 1) && (ep13_2_rhea > 99)) {
		if (ep13_2_days01 == 0) {
			mes "[斯特罗姆]";
			mes "你好。";
			mes "你是人类，对吧？";
			mes "我叫斯特罗姆。";
			next;
			mes "[斯特罗姆]";
			mes "不过你们看起来很弱。";
			mes "皮肤不坚固，力量也不足。";
			next;
			mes "[斯特罗姆]";
			mes "你们是怎么来到这里的？";
			next;
			mes "[斯特罗姆]";
			mes "你们的语言听起来温和，但似乎是来制造更多紧张的。";
			next;
			switch(select("维护和平。:……")) {
			case 1:
				mes "[" + strcharinfo(0) + "]";
				mes "是的，人类比你们小……但是……";
				mes "我们一直训练自己变强。";
				next;
				mes "[" + strcharinfo(0) + "]";
				mes "现在让你看看，";
				mes "我们也能匹敌你们的力量！";
				next;
				if (ep13_mdrama > 5) {
					mes "[斯特罗姆]";
				mes "总之……";
					mes "我的一位同伴在你最近发现的洞穴里遇到了麻烦。";
					next;
					mes "[斯特罗姆]";
					mes "那里有叫 ^4d4dff拉塔^000000 和 ^4d4dff杜伊尔^000000 的怪物。";
					mes "如果你消灭它们，我就认可你是优秀而强大的人。";
					set ep13_2_days01,1;
					setquest 7074;
					setquest 7075;
					close;
				}
				else {
					mes "[斯特罗姆]";
					mes "……就这样？";
					mes "让我想想。";
					mes "既然你如此相信自己的能力……";
					mes "我会找个足以证明实力的挑战。";
					close;
				}
			case 2:
				mes "[" + strcharinfo(0) + "]";
				mes "是的，但人类团结合作时可以更强。";
				close;
			}
		}
		else if (ep13_2_days01 == 1) {
			set .@qst_cpl01,checkquest(7074,HUNTING);
			set .@qst_cpl02,checkquest(7075,HUNTING);
			if ((.@qst_cpl01 == 2) && (.@qst_cpl02 == 2)) {
				mes "[斯特罗姆]";
				mes "果然如此……我是萨帕加尔顿斯特罗姆，向你道歉。不该这么快轻视你。";
				mes "我承认你是勇敢的战士，欢迎随时访问马努克。";
				next;
				mes "[斯特罗姆]";
				mes "我没什么可送你的，请收下这些硬币。";
				mes "需要买东西时可以使用。";
				completequest 7074;
				completequest 7075;
				set ep13_2_days01,2;
				if (checkre(3))
					getexp 50000,30000;
				else
					getexp 500000,300000;
				getitem 6080,10; //Manuk_Coin
				close;
			}
			else {
				mes "[斯特罗姆]";
				mes "如果想证明自己很强……";
				mes "请在洞穴中找到并击败拉塔和杜伊尔。";
				close;
			}
		}
		else {
			mes "[斯特罗姆]";
			mes "这里的冰冷气候不适合生物生存，但我们感觉不到寒冷，";
			mes "所以不太在意。";
			next;
			mes "[斯特罗姆]";
			mes "但是……你不一样。";
			mes "这种寒冷天气最好穿上希尔斯里翁的毛皮……";
			close;
		}
	}
	else {
		mes "[Manuk Galtun]";
		mes "Arpe? Yu osp sad?";
		mes "EW pisdn psa?";
		mes "We psis?";
	}
	close;
}

// Daily Quests :: ep13_2_dayquest
// - Bradium Collection
// - Laphine Craftsman
// - Draco Egg Collection (NPC includes 'Wanted' quest)
//============================================================
man_in01,378,276,3	script	Manuk Engineer#ep13_2	453,{
	if (checkweight(1201,2) == 0) {
		mes "等一下！！";
		mes "你携带的物品太多。";
		mes "无法领取这个。";
		mes "减轻负重后";
		mes "再试。";
		close;
	}
	if ((isequipped(2782) == 1) && (ep13_2_rhea > 99)) {
		set .@alba,checkquest(7080);
		if ((.@alba == 0) || (.@alba == 1)) {
			set .@time_chek,checkquest(7080,PLAYTIME);
			if (.@time_chek != 2) {
				mes "[Manuk Engineer]";
				mes "谢谢你帮我收集浓缩钙矿，帮了大忙。";
				mes "不过现在已经够用了。";
				close;
			}
			else {
				mes "[Manuk Engineer]";
				mes "谢谢你帮我收集浓缩钙矿，帮了大忙。";
				mes "希望你还能帮我。";
				erasequest 7080;
				close;
			}
		}
		else {
			set .@alba2,checkquest(7079);
			if ((.@alba2 == 0) || (.@alba2 == 1)) {
				if (countitem(6090) > 19) {
					mes "[Manuk Engineer]";
					mes "哦，这些就很好。";
					mes "我代表萨帕向你表示感谢。";
					mes "希望你能再次帮助我们。";
					delitem 6090,20; //Purified_Bradium
					erasequest 7079;
					setquest 7080;
					getexp 40000,40000;
					getitem 6080,3; //Manuk_Coin
					close;
				}
				else {
					mes "[Manuk Engineer]";
					mes "怎么了？";
					mes "你还没准备好。";
					close;
				}
			}
			else {
				mes "[Manuk Engineer]";
				mes "你好。";
				mes "这里是我们精炼矿石的地方。";
				next;
				switch(select("About collecting stones.:About the usage of stones.")) {
				case 1:
					mes "[Manuk Engineer]";
					mes "为了防止身体麻木，我们需要钙矿。";
					mes "从钙矿中可以提取生存所需的特殊元素。";
					next;
					mes "[Manuk Engineer]";
					mes "采矿业在这里最重要，因为我们的生活依赖它。";
					mes "但矿洞已经堵塞。";
					next;
					mes "[Manuk Engineer]";
					mes "我听说你们是优秀的士兵。";
					mes "能否消灭钙矿魔像，带些钙矿回来？";
					next;
					switch(select("Sure, I don't mind.:Nope, I can't.")) {
					case 1:
						mes "[Manuk Engineer]";
						mes "那就接受这个任务。";
						mes "请猎杀钙矿魔像，带回 20 个混合钙矿。";
						setquest 7079;
						close;
					case 2:
						mes "[Manuk Engineer]";
						mes "哦，这就是我们的命运。";
						mes "我怎么会天真到依赖别人？";
						close;
					}
				case 2:
					mes "[Manuk Engineer]";
					mes "我们精炼钙矿，从中提取特殊物质。";
					mes "再将其制成注射剂。";
					mes "精炼物用于维持我们的身体循环。";
					next;
					mes "[Manuk Engineer]";
					mes "所以我们在这方面很先进。";
					mes "其他行业也发展良好……但是……";
					next;
					mes "[Manuk Engineer]";
					mes "这是我们的首要任务，因为它关系到生存。";
					close;
				}
			}
		}
	}
	else {
		mes "[Manuk Engineer]";
		mes "Aweo wpe?";
		mes "Sdd psiem!";
		mes "Awq ouwn ksudh bud ds.";
		close;
	}
}

spl_in01,97,313,3	script	Laphine Craftsman#ep13	446,{
	if (checkweight(1201,2) == 0) {
		mes "等一下！！";
		mes "你携带的物品太多。";
		mes "无法领取这个。";
		mes "减轻负重后";
		mes "再试。";
		close;
	}
	if ((isequipped(2782) == 1) && (ep13_2_rhea > 99)) {
		if (ep13_mdrama > 5) {
			set .@alba,checkquest(7082);
			if (.@alba == 1) {
				set .@time_chek,checkquest(7082,PLAYTIME);
				if ((.@time_chek == 0) || (.@time_chek == 1)) {
					mes "[Laphine craftsman]";
					mes "谢谢你帮我收集这些物品。";
					mes "暂时已经够用了。";
					close;
				}
				mes "[Laphine craftsman]";
				mes "谢谢你帮我收集这些物品。";
				mes "希望你还能帮助我们。";
				erasequest 7082;
				close;
			}
			set .@alba2,checkquest(7081);
			if ((.@alba2 == 0) || (.@alba2 == 1)) {
				if ((countitem(7326) > 14) && (countitem(6075) > 14)) {
					mes "[Laphine craftsman]";
					mes "哦，太棒了。";
					mes "今天的材料足够了。";
					mes "需要更多时我会告诉你。";
					delitem 7326,15; //Fluorescent_Liquid
					delitem 6075,15; //Crystalized_Teardrop
					erasequest 7081;
					setquest 7082;
					getexp 30000,30000;
					getitem 6081,3; //Splendide_Coin
					close;
				}
				else {
					mes "[Laphine craftsman]";
			mes "有什么可以帮你？";
			mes "我的请求还没完成吗？";
					close;
				}
			}
			mes "[Laphine craftsman]";
			mes "怎么了？";
			mes "我需要为 Yai 制作更多装饰。";
			next;
			if (select("May I help you?:What's a Yai?") == 1) {
				mes "[Laphine craftsman]";
				mes "你想帮忙吗？";
				mes "这里既是战场，也是我们的家。";
				next;
				mes "[Laphine craftsman]";
				mes "我们喜欢独处，所以每个人都要有自己的 Yai。";
				mes "虽然身处军事基地，也要照顾好每个 Yai。";
				next;
				mes "[Laphine craftsman]";
				mes "我不是士兵，但希望我们都能像他们一样自信。";
				mes "我想用自己的技能支持所有拉斐尔。";
				next;
				mes "[Laphine craftsman]";
				mes "所以我想帮大家制作 Yai 装饰。";
				mes "我需要更多材料。";
				next;
				mes "[Laphine craftsman]";
				mes "听说洞穴里出现了水鬼。";
				mes "能带给我 15 个结晶泪滴和 15 个荧光液吗？";

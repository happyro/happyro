			}
			close;
		}
		else {
			// custom translation
			if (strnpcinfo(1) == "Arc") {
				mes "[阿克]";
				mes "右侧的后方……";
				mes "......";
			}
			else {
				mes "[泰拉]";
				mes "对不起……我好困……";
				mes "……我想睡觉……";
			}
			close;
		}
	}
	else {
		if (strnpcinfo(1) == "Arc") {
			mes "[阿克]";
			mes "HirWosWeh. Yee DiebVilFar U manTalVil.";
			mes "LarsNeiser...??";
			mes "VeldTiTal Ko SharDurYur Di ?";
		}
		else {
			mes "[泰拉]";
			mes "ModBurDana...? Mu AnduWehFus Yee OsaLoLars...";
			mes "eoFusser....";
			mes "maurNohser Ur...... ThorNuffLars So ";
		}
		close;
	}
}

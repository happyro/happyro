			mes "你在寻找三件 ^FF0000遗失物品^000000";
			mes "我父亲的遗物？为什么是遗物而不是我父亲？";
			mes "不，不可能。他一定还活着！";
			close;
		}
		mes "[失踪者之子]";
		mes "这些显然是他的衣服和鞋子……";
		mes "这些是我父亲的^FF0000遗失物品^000000。";
		mes "天啊……父亲！";
		callsub L_Quest;
		delitem 6520,3; //Lost_Belongings
		erasequest 1182;
		setquest 1183;
		set malaya_bakona2,4;
		close;
	} else {
		mes "[失踪者之子]";
		mes "为什么会发生这种事……";
		if (malaya_bakona2 == 4)
			callsub L_Quest;
		close;
	}

L_Quest:
	next;
	mes "男人痛苦地哭泣。";
	mes "继续寻找失踪者的遗物吧。";
	mes "找回五件 ^FF0000遗失物品^000000 从提亚拉克那里";
	mes "并把它们交给^0000FF失踪者之母^000000。";
	return;
}

malaya,265,284,4	script	Missing Person's Mother	579,{
	if (malaya_hi < 20) {
		mes "- 他似乎对你保持警惕。-";
		close;
	}
	if (malaya_bakona2 < 4) {
		mes "[失踪者之母]";
		mes "请找到我的孩子。";
		mes "我派她出去办事";
		mes "她还没有回来。";
		close;
	} else if (malaya_bakona2 == 4) {
		if (countitem(6520) < 5) {
			mes "[失踪者之母]";
		mes "你在寻找我孩子的五件^FF0000遗失物品^000000？";
			mes "这是什么意思？";
			mes "你是说我的孩子死了吗？";
			close;
		}
		mes "[失踪者之母]";
		mes "这是我孩子的梳子。";
		mes "你为什么有我孩子的五件^FF0000遗失物品^000000？";
		mes "为什么……她……死了？";
		next;
		mes "[失踪者之母]";
		mes "不，等等……我好像听到了她的声音。";
		mes "她很快就要回家了。我现在该回家。";
		mes "我该为她准备晚餐。她一定饿坏了。";
		mes "哈哈……";
		next;
		mes "一个已经疯掉的母亲……";
		mes "既然我找完了失踪的人，";
		mes "我该向村长报告。";
		delitem 6520,5; //Lost_Belongings
		erasequest 1183;
		setquest 1184;
		set malaya_bakona2,5;
		close;
	} else {
		mes "[失踪者之母]";
		mes "哈哈哈……我能听到我孩子的声音，";
		mes "仔细听。";
		mes "你听不到她在叫妈妈吗？";
		mes "哈哈哈……";
		next;
		mes "一个已经疯掉的母亲……";
		if (malaya_bakona2 == 5) {
			mes "既然我找完了失踪的人，";
			mes "我该向村长报告。";
		}
		close;
	}
}

malaya,289,364,4	script	Young Fortune Teller	583,{
	if (checkweight(1301,3) == 0) {
		mes "无法开始对话。你携带的物品太多了。-";
		close;
	}
	if (malaya_hi < 20) {
		mes "- 他似乎对你保持警惕。-";
		close;
	}
	if (malaya_bakona2 < 6) {
		mes "[年轻占卜师]";
		mes "月亮的能量变弱了。";
		mes "怪物增多的原因，";
		mes "受害者增多的原因，";
		mes "全都是因为这个。";
		close;
	} else if (malaya_bakona2 == 6) {
		mes "[年轻占卜师]";
		mes "月亮的能量已经减弱好几天了。";
		mes "怪物增多的原因，";
		mes "受害者增多的原因， 全都是因为这个。";
		next;
		mes "[年轻占卜师]";
		mes "我正准备举行仪式";
		mes "通过献上怪物的血来恢复月亮的能量，";
		mes "所以我需要你猎杀十五只 ^FF0000Tikbalang^000000";
		mes "地点在神秘巴里奥原野。";
		next;
		switch(select("不关我的事。:交给我吧。")) {
		case 1:
			mes "[年轻占卜师]";
			mes "你太自私了！";
			mes "仪式期间，";
			mes "我也会为你的厄运祈祷。";
			close;
		case 2:
			mes "[年轻占卜师]";
			mes "快点。";
			mes "如果月亮完全消失，";
			mes "就会发生大灾难。";
			erasequest 1185;
			setquest 1186;
			set malaya_bakona2,7;
			close;
		}
	} else if (malaya_bakona2 == 7) {
		if (checkquest(1186,HUNTING) == 2) {
			mes "[年轻占卜师]";
			mes "看来你已经处理好^FF0000Tikbalang^000000";
			mes "了。";
			mes "我想现在可以开始仪式了。";
			mes "我们还需要一些物品，请去找";
			mes "村长帮忙。";
			erasequest 1186;
			setquest 1187;
			set malaya_bakona2,8;
			if (!VIP_SCRIPT || vip_status(VIP_STATUS_ACTIVE))
				getitem 12699,7; //Tikbalang_Belt
			else
				getitem 12699,5; //Tikbalang_Belt
			close;
		} else {
			mes "[年轻占卜师]";
			mes "我需要你猎杀 15 只^FF0000Tikbalang^000000。";
			mes "地点在神秘巴里奥原野。";
			next;
			mes "[年轻占卜师]";
		mes "快点。";
		mes "如果月亮完全消失，";
		mes "就会发生大灾难。";
			close;
		}
	} else if (malaya_bakona2 == 8) {
		mes "[年轻占卜师]";
		mes "我想现在可以开始仪式了。";
		mes "我们还需要一些物品，请去找";
		mes "村长帮忙。";
		close;
	} else {
		mes "[年轻占卜师]";
		mes "月亮完全消失的那天，";
		mes "巨龙会袭击村庄。";
		mes "没人能安全。";
		close;
	}
	end;
}


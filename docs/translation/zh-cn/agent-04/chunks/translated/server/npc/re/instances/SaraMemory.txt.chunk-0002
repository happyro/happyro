1@sara,152,233,6	script	Sara Irene#02	668,{
	if (is_party_leader() == true) {
		cutin "sara_9sara2",2;
		npctalk "妈妈！";
		mes "[Sara Irene]";
		mes "妈妈！";
		next;
		cutin "sara_elder_irine4",2;
		npctalk "萨拉……", instance_npcname("Doyen Irene#03", instance_id());
		mes "[Doyen Irene]";
		mes "萨拉……";
		next;
		cutin "sara_9sara2",2;
		npctalk "不！";
		mes "[Sara Irene]";
		mes "不！";
		next;
		cutin "sara_elder_irine4",2;
		npctalk "我一直在找你，萨拉。跟爸爸来，这里很危险！", instance_npcname("Doyen Irene#03", instance_id());
		mes "[Doyen Irene]";
		mes "我一直在找你，萨拉。跟爸爸来，这里很危险！";
		next;
		unittalk getcharid(3),"我不会让你带走萨拉！";
		mes "["+strcharinfo(0)+"]";
		mes "我不会让你带走萨拉！";
		next;
		cutin "sara_elder_irine3",2;
		npctalk "凶手在这里！卫兵！我们要彻底解决他！", instance_npcname("Doyen Irene#03", instance_id());
		mes "[Doyen Irene]";
		mes "凶手在这里！卫兵！我们要彻底解决他！";
		next;
		unittalk getcharid(3),"萨拉…… run! Save yourself!";
		mes "["+strcharinfo(0)+"]";
		mes "萨拉…… run! Save yourself!";
		next;
		cutin "sara_9sara2",2;
		npctalk "……好。";
		mes "[Sara Irene]";
		mes "……好。";
		close2;
		cutin "sara_9sara3",255;
		donpcevent instance_npcname("Sara Irene#02", instance_id())+"::OnDisable";
		donpcevent instance_npcname("Doyen Irene#03", instance_id())+"::OnDisable";
		donpcevent instance_npcname("#BossSara01", instance_id())+"::OnEnable";
		end;
	}
	else {
		end;
	}

OnInstanceInit:
OnDisable:
	disablenpc instance_npcname("Sara Irene#02");
	end;
OnEnable:
	enablenpc instance_npcname("Sara Irene#02");
	end;
}


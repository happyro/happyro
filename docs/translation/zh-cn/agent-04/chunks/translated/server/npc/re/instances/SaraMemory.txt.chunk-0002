1@sara,156,236,4	script	Doyen Irene#04	684,{
	if (is_party_leader() == true) {
		cutin "sara_elder_irine4",2;
		npctalk "你……太强了。";
		mes "[Doyen Irene]";
		mes "你……太强了。";
		next;
		npctalk "为什么……*咳*你要杀我的妻子和女儿？";
		mes "[Doyen Irene]";
		mes "为什么……*咳*你要杀我的妻子和女儿？";
		next;
		unittalk getcharid(3),"你在说什么？我们看到你站在萨拉母亲旁边，剑上沾满了血！";
		mes "["+strcharinfo(0)+"]";
		mes "你在说什么？我们看到你站在萨拉母亲旁边，剑上沾满了血！";
		next;
		npctalk "你……以为我杀了萨拉的母亲？";
		mes "[Doyen Irene]";
		mes "你……以为我杀了萨拉的母亲？";
		next;
		npctalk "她*咳*已经被刺客刺伤。我杀了他*咳*所以我的剑上才沾满鲜血……";
		mes "[Doyen Irene]";
		mes "她*咳*已经被刺客刺伤。我杀了他*咳*所以我的剑上才沾满鲜血……";
		next;
		cutin "sara_elder_irine4",255;
		cutin "sara_momdie",4;
		mapannounce instance_mapname("1@sara"), "回想起来，你似乎记得房间左角还有另一具尸体。也许那就是主教所说的刺客。",bc_area,"0xffffff";
		mes "^FF0000回想起来，你似乎记得房间左角还有另一具尸体。也许那就是主教所说的刺客。^000000";
		next;
		cutin "sara_momdie",255;
		cutin "sara_elder_irine4",2;
		npctalk "如果……你不是来杀我妻女的刺客，你是谁？";
		mes "[Doyen Irene]";
		mes "如果……你不是来杀我妻女的刺客，你是谁？";
		next;
		unittalk getcharid(3),"我只是路过的冒险者。我听到一些奇怪的人密谋杀害她们，所以必须介入。";
		mes "["+strcharinfo(0)+"]";
		mes "我只是路过的冒险者。我听到一些奇怪的人密谋杀害她们，所以必须介入。";
		next;
		npctalk "如果……你说的是真的……请原谅我。我以为你是他们的人。";
		mes "[Doyen Irene]";
		mes "如果……你说的是真的……请原谅我。我以为你是他们的人。";
		next;
		npctalk "奇怪的人？……我敢说他们是村里的长老。呃……";
		mes "[Doyen Irene]";
		mes "奇怪的人？……我敢说他们是村里的长老。呃……";
		next;
		npctalk "可能还有更多刺客，所以我们必须尽快找到萨拉！";
		mes "[Doyen Irene]";
		mes "可能还有更多刺客，所以我们必须尽快找到萨拉！";
		next;
		unittalk getcharid(3),"萨拉认为你杀了她妈妈。我们必须告诉她真相！";
		mes "["+strcharinfo(0)+"]";
		mes "萨拉认为你杀了她妈妈。我们必须告诉她真相！";
		next;
		npctalk "我们必须尽力找到她。分头搜索吧。请帮我找到女儿并向她解释一切。";
		mes "[Doyen Irene]";
		mes "我们必须尽力找到她。分头搜索吧。请帮我找到女儿并向她解释一切。";
		close2;
		cutin "sara_elder_irine4",255;
		mapannounce instance_mapname("1@sara"), "我们必须找到萨拉。你似乎记得她朝 8 点钟方向跑去了。",bc_map,"0xffff00";
		viewpoint 1,88,188,1,0x00FF00;
		donpcevent instance_npcname("Doyen Irene#04", instance_id())+"::OnDisable";
		enablenpc instance_npcname("#sara_warp06");
		donpcevent instance_npcname("Sara Irene#03", instance_id())+"::OnEnable";
		donpcevent instance_npcname("?????#01", instance_id())+"::OnEnable";
		end;
	}
	else {
		end;
	}

OnInstanceInit:
OnDisable:
	disablenpc instance_npcname("Doyen Irene#04");
	end;
OnEnable:
	enablenpc instance_npcname("Doyen Irene#04");
	end;
}

1@sara,39,142,4	script	Sara Irene#03	668,{
	if (is_party_leader() == true) {
		mapannounce instance_mapname("1@sara"), "你正要呼唤萨拉时，突然从背后挨了一击，倒在地上。",bc_area,"0xffffff";
		mes "^FF0000你正要呼唤萨拉时，突然从背后挨了一击，倒在地上。^000000";
		next;
		cutin "sara_beholder",2;
		npctalk "时间旅行者不能再干涉了。你无法阻止我们与萨拉见面。", instance_npcname("?????#01", instance_id());
		mes "[?????]";
		mes "时间旅行者不能再干涉了。你无法阻止我们与萨拉见面。";
		next;
		npctalk "你应该回到属于你的时代。", instance_npcname("?????#01", instance_id());
		mes "[?????]";
		mes "你应该回到属于你的时代。";
		next;
		mapannounce instance_mapname("1@sara"), "你倒地时，两个黑影走近了萨拉。",bc_area,"0xffffff";
		mes "^FF0000你倒地时，两个黑影走近了萨拉。^000000";
		next;
		npctalk "一个充满背叛、绝望和仇恨的女孩。我们会引导你走向最终命运。", instance_npcname("?????#01", instance_id());
		mes "[?????]";
		mes "一个充满背叛、绝望和仇恨的女孩。我们会引导你走向最终命运。";
		next;
		cutin "sara_9sara2",2;
		npctalk "...";
		mes "[Sara Irene]";
		mes "...";
		next;
		cutin "sara_beholder",2;
		npctalk "萨拉·艾琳，“他”会让你的梦想成真。", instance_npcname("?????#01", instance_id());
		mes "[?????]";
		mes "萨拉·艾琳，“他”会让你的梦想成真。";
		next;
		cutin "sara_beholder",255;
		mapannounce instance_mapname("1@sara"), "其中一个披斗篷的陌生人用斗篷罩住萨拉，三个人影随即消失。",bc_area,"0xffffff";
		mes "^FF0000其中一个披斗篷的陌生人用斗篷罩住萨拉，三个人影随即消失。^000000";
		close2;
		viewpoint 1,16,143,1,0x00FF00;
		donpcevent instance_npcname("Sara Irene#03", instance_id())+"::OnDisable";
		donpcevent instance_npcname("?????#01", instance_id())+"::OnDisable";
		donpcevent instance_npcname("#sara_warp07", instance_id())+"::OnEnable";
		end;
	}
	else {
		end;
	}

OnInstanceInit:
OnDisable:
	disablenpc instance_npcname("Sara Irene#03");
	end;
OnEnable:
	enablenpc instance_npcname("Sara Irene#03");
	end;
}


OnReset:
	killmonster "job3_guil03","Priest from Rachel::OnMyMobDead";
	end;
OnMyMobDead:
	donpcevent "Renzak#3rdgc16::OnEnable";
	mapannounce "job3_guil03","I... I can't die in vain...",bc_map,"0xFF0000"; //FW_NORMAL 12 0 0
	donpcevent "#3rdgc_event01::OnStop";
	initnpctimer;
	end;
OnTimer3000:
	mapannounce "job3_guil03","Renzak : Hey! Come out!",bc_map,"0x4d4dff"; //FW_NORMAL 12 0 0
	end;
OnTimer40000:
	mapannounce "job3_guil03","Renzak : Don't lag!",bc_map,"0x4d4dff"; //FW_NORMAL 12 0 0
	end;
OnTimer60000:
	mapwarp "job3_guil03","ve_fild02",330,379;	//Pre-RE: ve_fild05 (341,303)
	end;
OnTimer61000:
	donpcevent "#3rdgc_guard::OnStop";
	donpcevent "#3rdgc_guardoff::OnReset";
	donpcevent "#3rdgc_hide01::OnStop";
	donpcevent "#3rdgc_hide02::OnStop";
	donpcevent "#3rdgc_hide03::OnStop";
	donpcevent "#3rdgc_sunchal_kill01::OnStop";
	donpcevent "#3rdgc_sunchal_kill02::OnStop";
	donpcevent "#3rdgc_sunchal_kill03::OnStop";
	donpcevent "#3rdgc_gojung_kill01::OnStop";
	donpcevent "#3rdgc_gojung_kill02::OnStop";
	donpcevent "#3rdgc_gojung_kill03::OnStop";
	donpcevent "Guard Dog#dog01::OnReset";
	donpcevent "Guard Dog#dog02::OnReset";
	donpcevent "#3rdgc_sunchal_nomal::OnReset";
	donpcevent "#3rdgc_sunchal_kill01::OnReset";
	donpcevent "#3rdgc_sunchal_kill02::OnReset";
	donpcevent "#3rdgc_sunchal_kill03::OnReset";
	donpcevent "#3rdgc_gojung_kill01::OnReset";
	donpcevent "#3rdgc_gojung_kill02::OnReset";
	donpcevent "#3rdgc_gojung_kill03::OnReset";
	donpcevent "Priest from Rachel::OnReset";
	donpcevent "Barbed-Wire Entanglement::OnDisable";
	donpcevent "Guard Dog#dog01::OnDisable";
	donpcevent "Guard Dog#dog02::OnDisable";
	donpcevent "#3rdgc_gojung_kill01::OnDisable";
	donpcevent "#3rdgc_gojung_kill02::OnDisable";
	donpcevent "#3rdgc_gojung_kill03::OnDisable";
	donpcevent "Priest from Rachel::OnDisable";
	donpcevent "Renzak#3rdgc16::OnDisable";
	end;
OnTimer61500:
	donpcevent "#3rdgc_event01::OnEnable";
	set $@3rdgc_room02, 0;
	stopnpctimer;
	end;
}

job3_guil03,146,70,3	script	Renzak#3rdgc16	466,{
	mes "[Renzak]";
	if (checkquest(7110,HUNTING) == 2) {
		mes "我的同伴会来这里解决这件事。";
		mes "去找 Mayshell 汇报。";
		next;
		mes "[Renzak]";
		if (checkquest(7110,PLAYTIME) == 0) {
			mes "你完成得很快。";
			mes "干得好。";
			set job_3rd_gc, 18;
		} else {
			mes "我说过你必须在 10 分钟内完成。";
			mes "你可能筋疲力尽。";
			mes "幸好你没事。";
			set job_3rd_gc, 19;
		}
		erasequest 7110;
		setquest 7111;
		close2;
		warp "job3_guil01",51,50;
		end;
	}
	mes "抓住目标！";
	mes "其实我不该在这里。你是不是有问题？";
	close;
OnInit:
	disablenpc "Renzak#3rdgc16";
	end;
OnEnable:
	enablenpc "Renzak#3rdgc16";
	end;
OnDisable:
	disablenpc "Renzak#3rdgc16";
	end;
}

job3_guil01,148,53,3	script	Bercasell#3rdgc16	467,{
	if (!checkweight(1201,2)) {
		mes "- 你物品太多，无法继续任务。 -";
		close;
	}
	mes "[Bercasell]";
	if (Class == Job_Assassin || Class == Job_Assassin_Cross || Class == Job_Baby_Assassin) {
		if (job_3rd_gc == 20) {
			if (JobLevel > 49 && SkillPoint == 0 && BaseLevel > 98) {
				mes "我好累……";
				mes "Mayshell 派你来的吗？";
				mes "告诉我你来找我的原因。";
				next;
				switch(select("什么是十字斩首者？：我想成为十字斩首者。：没什么。")) {
				case 1:
					mes "[Bercasell]";
					mes ".....";
					next;
					mes "[Bercasell]";
					mes "你想了解十字斩首者？";
					mes "出去！";
					next;
					switch(select("告诉我就好……:......")) {
					case 1:
						mes "[Bercasell]";
						callsub L_Info;
						mes "[Bercasell]";
						mes "真奇怪，我竟然这样和你说话。";
						mes "因为你的反抗，我想阻止你成为十字斩首者。";
						close;
					case 2:
						mes "[Bercasell]";
						mes "很好，你不问问题。";
						mes "很好。你有资格。成为十字斩首者怎么样？";
						mes "你想成为十字斩首者吗？";
						next;
						switch(select("是，转职。:我需要考虑。")) {
						case 1:
							L_JobChange:
							mes "[Bercasell]";
							mes "你不后悔吗？";
							callsub L_Info;
							mes "[Bercasell]";
							mes "你可以成为活着的攻击武器。";
							mes "你真的想成为十字斩首者吗？";
							next;
							switch(select("是，转职。:我需要重新考虑。")) {
							case 1:
								mes "[Bercasell]";
								if (ismounting()) {
									mes "我无法进行转职。";
									mes "请解除坐骑后再试。";
									close;
								} else if (SkillPoint != 0) {
									mes "你还有未分配的技能点。";
									mes "请使用所有技能点后再试。";
									close;
								}
								mes "你的决定最终确定了吗？";
								mes "很好。";
								next;
								mes "[Bercasell]";
								mes "现在你曾是刺客，但已经不再是刺客。";
								mes "你身处阴影，但与其他阴影不同。";
								next;
								mes "[Bercasell]";
								mes "你的敌人是你能看到的一切。";
								mes "别忘了自己。";
								mes "武器上的血之重量。";
								next;
								mes "[Bercasell]";
								mes "好，换上你的新制服。";
								mes "你现在是十字斩首者。";
								next;
								mes "[Bercasell]";
								mes "阴影之剑……";
								setlook 7,0;
								jobchange roclass(eaclass()|EAJL_THIRD);
								if (checkquest(7096) == 1) {
									set job_3rd_gc, 25;
									erasequest 7096;
								} else if (checkquest(7097) == 1) {
									set job_3rd_gc, 26;
									erasequest 7097;
								} else if (checkquest(7098) == 1) {
									set job_3rd_gc, 27;
									erasequest 7098;
								} else if (checkquest(7099) == 1) {
									set job_3rd_gc, 28;
									erasequest 7099;
								}
								getitem 2795,1; //Green_Apple_Ring
								getitem 5755,1; //Silent_Executer
								next;
								mes "[Bercasell]";
								mes "还有……这些礼物庆祝你成为十字斩首者。";
								close;
							case 2:
								mes "[Bercasell]";
								mes "你很谨慎。这是好事。";
								mes "我会等你决定加入十字斩首者的那一天。";
								close;
							}
						case 2:
							mes "[Bercasell]";
							mes "你很谨慎。这是好事。";
							mes "我会等你决定加入十字斩首者的那一天。";
							close;
						}
					}
				case 2:
					goto L_JobChange;
				case 3:
					mes "[Bercasell]";
					mes "别烦我。";
					close;
				}
			}
			mes "......";
			mes "我能为你做什么？";
			next;
			switch(select("我想成为十字斩首者。:没什么。")) {
			case 1:
				mes "[Bercasell]";
				mes "是吗？";
				mes "为了什么……？";
				mes "当然，你是自愿来到这里的……";
				next;
				mes "[Bercasell]";
				mes "十字斩首者是刺客公会法律的执行者。";
				mes "你能将匕首刺入同伴的背后吗？";
				next;
				mes "[Bercasell]";
				mes "你还没准备好……";
				close;
			case 2:
				mes "[Bercasell]";
				mes "别烦我。";
				close;
			}
		} else if (job_3rd_gc > 20) {
			mes "不要只追求力量。";
			mes "你会疲惫。";
			mes "这并不比活着更好。";
			mes "如果你只追求力量……";
			next;
			mes "[Bercasell]";
			mes "总有一天，它会回到你身上。";
			mes "不过我只是一件武器，似乎没有资格谈论人生……";
			close;
		} else {
			mes "Daora 怎么了？";
			mes "你为什么在这里？";
			mes "我说过你可以来这里吗？";
			next;
			mes "[Bercasell]";
			mes "还是 Mayshell 派你来的？";
			mes "或者说，你是我的粉丝？";
			mes "你来错地方了！";
			next;
			mes "[Bercasell]";
			mes "现在立刻出去！！！";
			close;
		}
	} else if (Class == Job_Guillotine_Cross || Class == Job_Guillotine_Cross_T || Class == Job_Baby_Guillotine_Cross) {
		mes "不要只追求力量。";
		mes "你会疲惫。";
		mes "这并不比活着更好。";
		mes "如果你只追求力量……";
		next;
		mes "[Bercasell]";
		mes "总有一天，它会回到你身上。";
		mes "不过我只是一件武器，似乎没有资格谈论人生……";
		close;
	}
	mes "什么？";
	mes "嘿，你不该来这里！";
	mes "现在出去！";
	close;

L_Info:
	mes "十字斩首者是执行者。";
	mes "是一件活着的攻击武器……";
	next;
	mes "[Bercasell]";
	mes "刺客的天敌是谁？";
	mes "剑士？牧师？";
	mes "魔法师？";
	mes "大量的邪恶之物？";
	next;
	mes "[Bercasell]";
	mes "不，刺客的天敌是其他刺客。";
	mes "对我们威胁最大的正是我们自己。";
	next;
	mes "[Bercasell]";
	mes "在公会的黑暗中，我们是阴影中的十字斩首者。";
	mes "我们维护刺客公会的法律与秩序。";
	next;
	mes "[Bercasell]";
	mes "有时我们为同伴树立榜样，有时我们以公会之名将剑指向成员的脖颈。";
	mes "我们是十字斩首者，是刺客公会之剑。";
	next;
	mes "[Bercasell]";
	mes "我们有能力找到藏在黑暗中的成员，而你实在太纠缠了。";
	next;
	mes "[Bercasell]";
	mes "我们拥有高度先进的战斗技巧。";
	next;
	return;
}

// Warp Portals

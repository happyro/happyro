//===== rAthena Script =======================================
//= Ghost Palace Exchange NPC.
//===== Description: =========================================
//= Walkthrough Conversion.
//===== Changelogs: ==========================================
//= 1.0 First Version. [Capuche]
//============================================================

dali02,51,130,4	script	Dimension Traveler	4_F_SHABBY,{
	if (checkweight(28100,1) == 0) {// Thanos Axe
		mes "- 您携带的物品过多，无法继续。-";
		close;
	}
	.@item_name_req$ = getitemname(6672);// Gray_Shard
	mes "[Dimension Traveler]";
	mes "冒险家朋友，我需要" + mesitemlink( 6672 ) + "。要不要用它交换我这里的物品？";
	next;
	.@type = select( "让我看看武器。", "让我看看防具。", "有什么特别的吗？", "我不需要。" ) - 1;
	mes "[Dimension Traveler]";
	switch(.@type) {
	case 0:
		mes "哦！您对武器感兴趣吗？我们有从幽灵宫殿获得的各种武器。选一件吧？";
		break;
	case 1:
		mes "防具？我们有从幽灵宫殿获得的各种防具。选一件吧？";
		break;
	case 2:
		mes "嗯！看来很多人已经听说我这里有最好的东西。请随意看看我的收藏。";
		break;
	case 3:
		mes "再见，朋友～欢迎再来！";
		close;
	}
	next;
	mes "[Dimension Traveler]";
	mes "啊！您需要收集写在" + mesitemlink( 6672 ) + "旁边的数量。";
	mes "请记住这一点。";

	switch(.@type) {
	case 0:
		setarray .@items[0],
			13441, 200,		// Thanos Sword
			21009, 200, 	// Thanos Great Sword
			1438,  200,		// Thanos Spear
			1496,  200,		// Thanos Long Spear
			1669,  200,		// Thanos Staff
			2023,  200,		// Thanos Rod
			18119, 200,		// Thanos Bow
			13093, 200,		// Thanos Dagger
			28000, 200,		// Thanos Katar
			1836,  200,		// Thanos Knuckle
			16028, 200,		// Thanos Hammer
			28100, 200,		// Thanos Axe
			1933,  200,		// Thanos Violin
			1988,  200;		// Thanos Whip
		break;
	case 1:
		setarray .@items[0],
			2187,  100,		// Shield Of Gray
			15090, 100, 	// Armor Of Gray
			15091, 100,		// Gray Robe
			20721, 100,		// Cloak Of Gray
			22033, 100,		// Boots Of Gray
			18820, 100;		// Gray Helmet
		break;
	case 2:
		setarray .@items[0],
			27184, 10000,		// Knight Sakray Card
			23676, 50, 			// Gray Charcoal Melee (Melee)
			23677, 50,			// Gray Charcoal Magic (Magic)
			23678, 50;			// Gray Charcoal Range (Range)
		break;
	}
	.@size = getarraysize(.@items);
	for ( .@i = 0; .@i < .@size; .@i += 2 )
		.@menu$ += getitemname(.@items[.@i]) + " - " + .@items[.@i+1] + ":";

	while(true) {
		next;
		.@s = (select(.@menu$) - 1) * 2;
		mes "[Dimension Traveler]";
		if (.@type != 1)	// armor type doesn't display item info
			mes "您是指" + mesitemlink( .@items[.@s] ) + "吗？";
		mes "兑换需要 " + .@items[.@s+1] + " 个^006400" + .@item_name_req$ + "^000000。";
		next;
		switch( select( "开始交换。", "让我看看其他东西。", "我稍后再来。" ) ) {
		case 1:
			break;
		case 2:
			mes "[Dimension Traveler]";
			switch(.@type) {
			case 0:
				mes "我的武器已经足够多了。";
				break;
			case 1:
				mes "我们有很多防具供您选择。挑一件吧？";
				break;
			case 2:
				mes "只要您带来" + .@item_name_req$ + "，我就能交换您想要的任何东西。";
				break;
			}
			continue;
		case 3:
			mes "[Dimension Traveler]";
			mes "保重，朋友～下次见！";
			close;
		}
		if (countitem(6672) < .@items[.@s+1]) {
			mes "[Dimension Traveler]";
			mes "朋友，您让我很为难。";
			mes "我需要" + .@item_name_req$ + "。请提供 ^006400" + .@items[.@s+1] + " 个" + .@item_name_req$ + "^000000 来交换。";
			close;
		}
		mes "[Dimension Traveler]";
		mes "谢谢。如果还需要其他东西，请再回来。";
		delitem 6672, .@items[.@s+1];
		getitem .@items[.@s], 1;
		close;
	}
}

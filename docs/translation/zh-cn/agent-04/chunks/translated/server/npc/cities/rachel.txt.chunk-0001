ice_dun04,33,166,3	script	Frozen Boy	925,{
	cutin "ra_sboy.bmp",2;
	mes "["+strcharinfo(0)+"]";
	mes "这个男孩一定就是库特拉努斯试图保护的人。";
	next;
	mes "- 男孩被冻在巨大的冰柱里，看起来像睡着了，而不是死去。-";
	next;
	mes "- 你靠近关着男孩的巨大冰柱时感到刺骨寒冷，";
	mes "- 但不知为何，你从冰柱中感受到神秘力量。-";
	next;
	mes "- 男孩从头到脚雪白而美丽。-";
	next;
	mes "- 你疑惑年幼的男孩为何被囚禁在这座孤立洞窟，";
	mes "- 你本能地知道世上没有魔法师能将他从冰柱中释放。";
	next;
	mes "["+strcharinfo(0)+"]";
	mes "这个男孩怎么了？";
	close2;
	cutin "",255;
	end;
}

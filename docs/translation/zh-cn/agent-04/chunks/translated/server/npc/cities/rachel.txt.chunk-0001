	}
	
	//rachel,201,174,3	script	Freya's Follower	927,{
	rachel,201,174,3	script	Freya's Follower	926,{
		mes "[Freya's Follower]";
		mes "整个阿鲁纳佩尔茨都信仰芙蕾雅，";
		mes "但我们中有些人更热衷于崇拜和敬奉。";
		next;
		mes "[Freya's Follower]";
		mes "首先是‘芙蕾雅的追随者’，";
		mes "像我一样戴圣洁面具、穿圣服的男女。";
		mes "我们的服装也许有点奇怪，";
		mes "但这就是我们的方式。";
		next;
		mes "[Freya's Follower]";
	mes "然后是身穿洁白长袍的祭司。";
	mes "他们在神殿工作，作为宗教领袖服务社群。";
	next;
	mes "[Freya's Follower]";
	mes "祭司中还有直接协助教皇的精英大神官。";
	mes "他们穿着更加鲜艳的服装，";
	mes "彰显在拉赫的高地位。";
	next;
	mes "[Freya's Follower]";
		mes "我们都不懈努力，让阿鲁纳佩尔茨繁荣，";
		mes "并践行挚爱女神芙蕾雅的教诲。";
	close;
		}
	
		rachel,206,30,3	script	Freya's Priest#play	920,{
	mes "[Freya's Priest]";
mes "这个……";
mes "真无聊……";
next;
	mes "[Freya's Priest]";
	mes "你！";
	mes "让我开心！";
	emotion ET_ANGER;
	next;
	if (select("What? You can't tell me what to do!:You got it.") == 1) {
	mes "[Freya's Priest]";
	mes "哦，我想这点";
	mes "确实是真的。";
	close;
	}
	mes "[Freya's Priest]";
	mes "那么，";
	mes "你打算怎么";
	mes "让我开心？";
	next;
	if (select("Here's a funny story...:I will do what you want me to do.") == 1) {
	mes "^3355FF你向她讲了第一个：";
	mes "你能想到的有趣故事。^000000";
	specialeffect2 EF_TALK_FROSTJOKE;
	next;
	mes "[Freya's Priest]";
	mes "这算有趣？我想我不懂";
	mes "平民的幽默。";
	close;
}
mes "[Freya's Priest]";
mes "好吧，好吧～";
	mes "让我看看你的物品能做什么……";
	mes "哦？哦！太棒了！";
	close2;
	set .@play,rand(1,10);
	if (.@play < 3)
	//consumeitem 601; //Wing_Of_Fly
	warp "Random",0,0;
	else if (.@play < 5)
consumeitem 12016; //Speed_Up_Potion
else
consumeitem 12017; //Slow_Down_Potion
	end;
	}
	
	rachel,197,137,3	script	Bard#aru	51,{
	mes "[Bard]";
	mes "我游历这片土地，唱着我的歌～";
	mes "寻找令我心驰神往的人～";
	next;
	mes "[Bard]";
	mes "我能实现这个愿望吗～？";
	mes "遇见肌肤如百合般洁白、";
mes "双眼如星辰闪耀的女孩～";
mes "没错，我说的就是教皇～";
mes "教皇，耶～教皇，耶～";
	next;
	mes "["+strcharinfo(0)+"]";
	mes "你一定疯了，";
	mes "竟敢在阿鲁纳佩尔茨唱这种歌！";
	next;
	mes ".........";
	mes ".........";
	mes ".........";
	emotion ET_CRY;
	close;
	}
	

		ra_fild12,45,230,3	script	Airship Guide#Fild	934,{
		mes "[Airship Guide]";
		mes "施瓦尔兹瓦德共和国前往阿鲁纳佩尔茨的国际飞空艇服务，";
	mes "只能在拉赫使用。请根据小地图上的标记寻找机场。";
	viewpoint 1,293,208,1,0xFF0000;

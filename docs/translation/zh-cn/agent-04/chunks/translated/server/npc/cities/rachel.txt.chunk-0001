	ra_san04,137,48,3	script	Loomin-1st Class Secret	111,{
	mes "^3131FF被困在冰洞里的男孩洛敏。^000000";
	mes "等级：1级";
	mes " ";
	mes " ";
	mes " ";
	mes "^333333教皇出生时有一个双胞胎弟弟，";
	mes "那是个皮肤白皙、银金色头发的男孩。";
	mes "这种情况前所未有，带来了独特难题。";
	mes " ";
mes "大神官尼伦担任他们的护理者，";
mes "并来到拉赫。双胞胎由祭司照顾，";
mes "众人争论男孩最终的命运……";
	mes " ";
	mes "没人怀疑男孩拥有强大精神力，";
	mes "但他究竟是姐姐神圣的补充，";
	mes "还是与她直接对立的大邪恶？";
	mes "这是一场艰苦的争论。";
	mes " ";
	mes "最终大神官们认定男孩对社会构成巨大风险。";
	mes "如果人们知道教皇有双胞胎弟弟，";
	mes "可能就不会认为她的出生是神圣的。";
	mes " ";
	mes "不过大神官们不想招致神明愤怒，";
	mes "没有杀死男孩，而是将他封印在冰洞中。";
	mes " ";
mes "大神官们与可怕的冰魔物库特拉努斯签订契约，";
mes "让它守护男孩的牢笼，确保无人靠近。";
close;
	}
	
	rachel,124,132,1	script	Citizen#1 	921,{
	mes "[Citizen]";
	mes "愿芙蕾雅祝福你，";
	mes "赐予你健康、财富、欢乐与幸福！";
	next;
mes "[Citizen]";
mes "芙蕾雅是爱与美之女神。";
mes "你觉得只要我虔诚祈祷，";
	mes "她会帮我找到漂亮女朋友吗？";
	close;
	}
	
	rachel,74,150,7	script	Girl#1	914,{
	mes "[Girl]";
	mes "我以前从没见过教皇，听说她有银金色头发和雪白皮肤。";
	mes "爸爸说每一代只有一个这样的女孩。";
next;
mes "[Girl]";
mes "爸爸说教皇对我们很特别，因为她就是芙蕾雅。";
mes "芙蕾雅是女神，也会化身为人和我们交谈。";
mes "当然，只和祭司交谈……";
next;
mes "[Girl]";
	mes "我不太明白，";
	mes "但听起来她像秘密公主。";
	mes "是不是很棒？可我告诉爸爸时，";
	mes "他总是对我发火！算了。";
	close;
}

rachel,144,243,5	script	Cheshrumnir Guard::ChesGuard	934,{
	mes "[Cheshrumnir Guard]";
	mes "你现在位于切什鲁姆尼尔，";
	mes "这是教皇、芙蕾雅凡间化身所在的圣地。";
	mes "为了尊重殿下，请怀着虔诚之心进入。";
	close;
	}
	
	rachel,155,243,3	duplicate(ChesGuard)	Cheshrumnir Guard	934
	

rachel,209,198,3	script	Kinos#aru	921,{
mes "[Kid]";
mes "打开这扇门就能进屋，住进其中一间房！";
	mes "然后放上沙发、床和所有东西！";
	next;
	mes "[Kid]";
	mes "你只要……呃！转动这个把手，";
	mes "然后……呜啊！打开这扇门……";
	mes "但几乎不可能……";
	close;
	}
	
	rachel,260,175,3	script	Anku#aru	914,{
	mes "[Anku]";
	mes "已经过了这么久！我找不到 Himuhimu！";
	mes "捉迷藏不该花这么长时间……";
	next;
	mes "[Anku]";
	mes "哦，我已经饿了……";
	mes "Himuhimu，快出来，我们回家吃饭！";
	mes "Himuhimu！我放弃了！";
	mes "希、希姆希姆……？";
	close;
	}
	
	rachel,272,141,3	script	Himuhimu#aru	921,{

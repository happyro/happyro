	ra_temin,138,64,5	script	Child Follower#in1	921,{
		mes "[Child Follower]";
		mes "不！我的明明死了！";
		next;
		select("明明？");
		mes "[Child Follower]";
			mes "明明是一只我在街上捡到的病鸟，";
			mes "我真的希望它能休息并恢复健康，";
			mes "但它还是死了！哇啊啊！";
			emotion ET_CRY;
			next;
			mes "[Child Follower]";
			mes "我……我要去问教皇！";
			mes "也、也许她能让明明复活！";
			mes "你知道怎样才能找到教皇吗？";
			close;
			}
			
			
			//===== Set 2 ================================================
			ra_fild12,283,208,3	script	Apprentice Priestess	914,{
			if ($rachel_donate < 10000) {
			mes "[Papaii]";
			mes "欢迎来到阿鲁纳佩尔茨，冒险者！";
			mes "祝你逗留愉快～";
			next;
			if (select("你是向导吗？:谢谢，祝你今天愉快。") == 1) {
			mes "[Papaii]";
			mes "哦，如果你想找向导，";
			mes "向西前往拉赫，再从城市中心广场向北。";
			mes "你会在那里找到向导。";
			next;
			mes "[Papaii]";
			mes "我叫 Papaii，被派来宣传即将举行的芙蕾雅节。";
			mes "如果你有余钱，欢迎为节日捐赠 Zeny。";
			next;
			mes "[Papaii]";
			mes "如果你想进一步了解，";
		mes "请参观我们的神殿。那里接受捐赠、举办节日，";
		mes "并可向女祭司 Nemma 咨询。";
		next;
		mes "[Papaii]";
		mes "捐赠后可以获得彩票，";
		mes "用于兑换神殿仓库随机选出的物品。";
		mes "愿芙蕾雅祝福你，旅行者～";
	close;
	}
	mes "[Papaii]";
	mes "愿芙蕾雅祝福你。";
	mes "有时间的话，请参观神殿并捐赠～";
	close;
	}
	mes "[Papaii]";
	mes "欢迎来到阿鲁纳佩尔茨！";
	mes "城墙外的城市就是拉赫，阿鲁纳佩尔茨的首都。";
		mes "如果想在旅途中休息，不妨去拉赫看看？";
		next;
		if (select("你是向导吗？:再多告诉我一些关于拉赫的事。") == 1) {
		mes "[Papaii]";
		mes "其实我叫 Papaii，代表神殿驻守于此，";
		mes "向游客宣传我们的宗教。";
		next;

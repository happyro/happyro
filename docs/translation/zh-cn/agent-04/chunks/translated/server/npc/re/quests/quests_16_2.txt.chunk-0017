	}
	if (yurhik_quest == 2) {
		mes "你要在艾因贝赫见 Vero。我们去艾因贝赫。";
		close;
	}
	if (yurhik_quest == 4 || yurhik_quest == 6) {
		emotion ET_THINK;
		mes "那个扑克脸的神枪手女孩在翻找书籍和文件时瞥了我一眼，然后继续翻找。";
		next;
		cloakoffnpcself( "Arivero Yurhik#TFQ02" );
		npctalk "咔哈哈。欢迎，朋友。", "Arivero Yurhik#TFQ02", bc_self;
		mes "[阿里维罗·尤尔希克]";
		mes "咔哈哈。欢迎，朋友。";
		close;
	}
	if (yurhik_quest == 5) {
		emotion ET_THINK;
		mes "那个扑克脸的神枪手女孩在翻找书籍和文件时瞥了我一眼，然后继续翻找。";
		next;
		mes "我答应在莱恩哈特见 Vero。我们去莱恩哈特。";
		close;
	}
	if (yurhik_quest == 7) {
		emotion ET_THINK;
		mes "那个扑克脸的神枪手女孩在翻找书籍和文件时瞥了我一眼，然后继续翻找。";
		next;
		cloakoffnpcself( "Arivero Yurhik#TFQ02" );
		npctalk "你带来星尘了吗？", "Arivero Yurhik#TFQ02", bc_self;
		mes "[Arivero Yurhik]";
		mes "你带来星尘了吗？";
		close;
	}
	if (yurhik_quest == 8) {
		emotion ET_THINK;
		mes "那个扑克脸的神枪手女孩在翻找书籍和文件时瞥了我一眼，然后继续翻找。";
		next;
		mes "看来 Vero 已经出发了。";
		mes "我们快去朱诺。";
		close;
	}
	if (yurhik_quest == 10) {
		emotion ET_THINK;
		mes "扑克脸的神枪手女孩像往常一样看着书籍和文件。";
		next;
		cloakoffnpcself( "Rebellion leader#TFQ15" );
		npctalk "I have seen you talking to that kid lately.";
		mes "[叛军首领]";
		mes "我最近看到你和那个女孩说话。你在乎她吗？";
		close;
	}
	if (yurhik_quest == 11) {
		emotion ET_THINK;
			mes "扑克脸的神枪手女孩像往常一样看着书籍和文件。要打招呼吗？";
		next;
		if (select( "打招呼。", "不。" ) == 2) {
			mes "神枪手女孩对这里发生的事不感兴趣，继续做自己的事。";
			close;
		}
		mes "我该对神枪手女孩说什么？";
		next;
		input .@string$;
		unittalk getcharid(3), "" + strcharinfo(0) + " : " + .@string$, bc_self;
		mes "[" + strcharinfo(0) + "]";
		mes "" + .@string$ + "";
		next;
		mes "面无表情的神枪手女孩偷瞄我一眼，又继续翻找书籍和文件。";
		close;
	}
	emotion ET_THINK;
	mes "那个扑克脸的神枪手女孩在翻找书籍和文件时瞥了我一眼，然后继续翻找。";
	close;
}

rebel_in,78,66,6	script	Arivero Yurhik#TFQ02	4_M_GUNSLINGER,{
	if (terra_gloria_main < 17)
		end;
	if (yurhik_quest == 0) {
		switch( checkquest(5727,PLAYTIME) ) {
		case -1:
			emotion ET_SMILE;
			mes "[阿里维罗·尤尔希克]";
			mes "哈哈哈，我来了，姐姐。";
			next;
			emotion ET_FRET;
			mes "[Arivero Yurhik]";
			mes "原来是你。";
			mes "你是克拉纳·内米耶里最帅的家伙，对吧？我不想承认你比我帅。这里最帅的一直是我。";
			next;
			mes "[奇怪的男人]";
			mes "哦~！现在该自我介绍了。";
			mes "我是 Arivero Yurhik。";
			next;
			emotion ET_SMILE;
			mes "[Arivero Yurhik]";
			mes "我们今天第一次见面，但从今以后应该会成为朋友。所以叫我 Vero 就好。";
		mes "只有亲密朋友才叫我 Vero。哈哈哈，所以你很荣幸。";
			next;
			mes "[Arivero Yurhik]";
		mes "这里这位对你很感兴趣的女士是我的姐姐 Arinoa Yurhik。从名字就能看出来，我们是姐弟！";
			next;
			emotion ET_QUESTION, playerattached();
			mes "[" + strcharinfo(0) + "]";
			mes "对我感兴趣？";
			next;
		mes "真奇怪。那位女士一直在看文件，完全没有表现出对我的兴趣。";
		mes "刚才还大声说话的男人突然认真起来，开始自言自语。";
			next;
			emotion ET_HUK;
			mes "[Arivero Yurhik]";
		mes "你对他这么感兴趣吗……？姐姐，难道你想把任务交给这位吗？";
			next;
		mes "因为我一直看着她，所以知道那位女士没有说话或行动。但名叫 Vero 的男人似乎明白她在想什么，继续说了下去。";
			next;
			emotion ET_SMILE;
			mes "[Arivero Yurhik]";
		mes "是吗……真的？哈哈哈。我就知道我们会成为朋友。";
		mes "嘿，朋友。我们有任务要一起完成。";
			next;
			mes "[Arivero Yurhik]";
			mes "不是难事。我们只需去大约四个地方，摧毁一些东西。";
			mes "你会做的，对吧？";
			next;
			select( "做吧。", "毫不犹豫地做。", "无论如何都要做。", "既然你被迫这么做，那就做吧。" );
			emotion ET_OHNO, playerattached();
			mes "[Arivero Yurhik]";
		mes "第一次见到你时，我就知道你很可靠。哦！对了。";
			mes "你叫什么名字？";
			next;
			mes "[" + strcharinfo(0) + "]";
			mes "" + strcharinfo(0) + " 就是我的名字。";
			next;
			emotion ET_SCRATCH;
			mes "[Arivero Yurhik]";
			mes "" + strcharinfo(0) + "?";
			mes "嗯，这名字真傲慢。不过这是个配得上‘热情’的名字。现在我不得不认可你了……";
			next;
			mes "[Arivero Yurhik]";
		mes "我有几件事要准备。我相信你出发前也需要一些时间准备，对吧？";
			next;
			setquest 5727;	// Suddenly in charge
			mes "[Arivero Yurhik]";
		mes "我明天凌晨 4 点后就会完全准备好。那之后你准备好了就告诉我姐姐，我会马上赶来。";
			close2;
			cloakonnpcself( "Arivero Yurhik#TFQ02" );
			end;
		case 0:
		case 1:
			end;
		case 2:
			emotion ET_COOL;
			mes "[Arivero Yurhik]";
		mes "你不仅可靠，而且还很勤奋！";
			next;
			mes "[Arivero Yurhik]";
		mes "太好了！准备工作完成，你也到了这里。让我说明一下我们要做什么。";
			next;
			mes "[Arivero Yurhik]";
		mes "在 Schwaltzvalt 地区无法使用传送。我想你知道这一点。";
			next;
			if (select( "我知道。", "我不知道。" ) == 1) {
				mes "[Arivero Yurhik]";
				mes "很好。其实你不需要知道这一点。";
			}
			else {
				mes "[Arivero Yurhik]";
				mes "我喜欢你的诚实。其实你不需要知道这一点。";
			}
			mes "那并不重要。";
			next;
			mes "[Arivero Yurhik]";
			mes "根据 Schwaltzvalt 政府的说法，为防止魔法过度使用，村内禁止传送。但这只是胡说。";
			next;
			mes "[Arivero Yurhik]";
			mes "曾发生过一起名为‘魔法过度使用’的事件。因此他们通过法律禁止传送。在我看来，‘魔法过度使用’是 Schwaltzvalt 政府操纵的。";
			next;
			mes "[Arivero Yurhik]";
			mes "我们认为 Schwaltzvalt 政府安装这些设备，是为了限制传送，保护 Rekenber 企业的秘密研究。";
			next;
			mes "[Arivero Yurhik]";
			mes "看看设备安装后发生的一连串事件，我们的判断更加坚定了。";
			next;
			emotion ET_QUESTION, playerattached();
			mes "[" + strcharinfo(0) + "]";
			mes "一连串事件？";
			next;
			emotion ET_QUESTION;
			mes "[Arivero Yurhik]";
			mes "你没听说贫民窟里的神秘失踪事件吗？";
			next;
			mes "[Arivero Yurhik]";
			mes "那是已经发生的事件，现在并不重要，所以我就不解释了。如果你好奇，之后可以自行调查。";
			next;
			mes "[Arivero Yurhik]";
			mes "无论如何，我们会摧毁安装在 Schwaltzvalt 的所有‘传送禁令设备’。";
			next;
			emotion ET_HUM, playerattached();
			mes "[" + strcharinfo(0) + "]";
			mes "你知道它的位置吗？";
			next;
			emotion ET_HUK;
			mes "[Arivero Yurhik]";
			mes "哇～真敏锐……";
			mes "真是个尖锐的问题。";
			mes "你果然是个厉害的人。";
			next;
			mes "[Arivero Yurhik]";
			mes "这就是我们现在面临的问题。这台设备被包括魔法在内的各种技术隐藏并保护着。";
			next;
			mes "[Arivero Yurhik]";
			mes "哈哈哈。不过你不用担心。";
			mes "至少我知道设备其中一部分的位置。";
			mes "你知道‘矿业村艾因贝赫’吗？";
			next;
			emotion ET_SMILE;
			mes "[Arivero Yurhik]";
			mes "哈哈哈，你当然知道，这里的 Clana Nemieri 也在艾因贝赫。";
			next;
			emotion ET_SURPRISE;
			mes "[Arivero Yurhik]";
			mes "总之，我们在艾因贝赫的特工报告说，一台可疑设备出现在货运列车末端，很快又消失了。问题是……";
			next;
			mes "[Arivero Yurhik]";
			mes "我们没有办法让这台隐藏并受保护的设备现形并摧毁它……";
			next;
			mes "[Arivero Yurhik]";
			mes "既然如此，我们可以从头开始，一步一步重新推演这起事件，对吧？";
			mes "也许能找到我们遗漏的线索。";
			next;
			emotion ET_OK, playerattached();
			mes "[" + strcharinfo(0) + "]";
			mes "你同意吗？";
			next;
			erasequest 5727;	// Suddenly in charge
			setquest 5728;	// Headache
			yurhik_quest = 1;
			emotion ET_CONFUSE;
			mes "[Arivero Yurhik]";
		mes "我已经很久没有动脑了。休息一下，让我们理清思绪吧。";
			close;
		}
	}
	if (yurhik_quest == 1) {
		mes "[Arivero Yurhik]";
	mes "太好了！是时候久违地动动脑了。";
	mes "我会从特工发现异常设备的那一刻起，一步一步告诉你情况。发现任何异常就告诉我。";
		next;
		mes "[Arivero Yurhik]";
	mes "一天，我们在艾因贝赫的特工 H 手持火把和棍棒，从警卫室出来进行例行夜间巡逻。H 穿着警卫服。";
		next;
		mes "[Arivero Yurhik]";
	mes "H 按照平常的路线完成巡逻。最后，H 来到货运列车末端，在那里发现了异常设备。";
		next;
		mes "[Arivero Yurhik]";
	mes "平时偶尔会刮起强风。但那天的风强到足以吹灭火光。然后……";
	mes "H 说，一台可疑设备出现了片刻，很快就消失了。";
		next;
		mes "[Arivero Yurhik]";
	mes "就是这样……";
		next;
		mes "[Arivero Yurhik]";
	mes "我们唯一的信息就是特工的陈述……听完这个故事，你发现什么异常了吗？";
		while( true ) {
			next;
				switch( select( "警卫服", "棍棒", "H 的巡逻路线", "货运列车", "强风", "熄灭的火把" ) ) {
			case 1:
				mes "[Arivero Yurhik]";
					mes "他穿着女儿洗净并熨好的整洁警卫服。但穿整洁的警卫服并不奇怪。";
				continue;
			case 2:
				mes "[Arivero Yurhik]";
					mes "H 说他每次巡逻都会带棍棒，以应对意外情况。这也不奇怪。";
				continue;
			case 3:
				mes "[Arivero Yurhik]";
					mes "H 每天都沿着同一条路线巡逻。他说这是警卫手册规定的。我没发现什么奇怪之处。你呢？";
				continue;
			case 4:
				mes "[Arivero Yurhik]";
					mes "那是一列从矿井运煤的火车。因为是夜晚，火车停了下来。据说如今矿井里魔物太多，所以这列车很少运行。";
				continue;
			case 5:
				mes "[Arivero Yurhik]";
					mes "这里是山区，即使平时也偶尔会有强风。每天都会发生，所以我不觉得奇怪。";
				continue;
			case 6:
				mes "[Arivero Yurhik]";
					mes "强风……熄灭的火把……";
					mes "哦？！我想我找到线索了。";
				break;
			}
			break;
		}
		next;
		emotion ET_SMILE;
		mes "[Arivero Yurhik]";
		mes "哈哈哈哈哈。你真是天才。多亏你的帮助，谜题解开了。现在我们有了可靠的理论，来验证一下吧。";
		next;
		emotion ET_QUESTION, playerattached();
		mes "[" + strcharinfo(0) + "]";
		mes "是什么理论？";
		next;
		mes "[Arivero Yurhik]";
		mes "嗯？你还没注意到吗？我以为你已经发现了，所以才给我提示。";
		mes "那并不重要。";
		next;
		emotion ET_BLABLA;
		mes "[Arivero Yurhik]";
		mes "熄灭的火把……火！！没错，就是火。艾因贝赫是山区，即使平时也偶尔有强风。与平时不同的是火把熄灭了。";
		next;
		emotion ET_BLABLA;
		mes "[Arivero Yurhik]";
		mes "通常火焰在熄灭前最旺。所以我的理论认为，设备正是在火把熄灭前短暂出现，又迅速消失。";
		next;
		emotion ET_BLABLA;
		mes "[Arivero Yurhik]";
		mes "就在火焰最旺并消失的瞬间！！那就是设备出现的条件。";
		next;
		emotion ET_BLABLA;
		mes "[Arivero Yurhik]";
		mes "你觉得我的理论怎么样？值得试试吧？";
		next;
		emotion ET_SCRATCH, playerattached();
		mes "[" + strcharinfo(0) + "]";
		mes "你看起来太兴奋了，我完全听不懂你在说什么。不过既然你这么有信心，就试试吧。试试也不会有损失，对吧？";
		next;
		emotion ET_SMILE;
		mes "[Arivero Yurhik]";
		mes "既然你是个热情的人，回答也很热情。太好了！我们去试试吧，反正就在这个村子里。";
		next;
		mes "[Arivero Yurhik]";
		mes "带着充满火属性的物品来到货运列车末端。";
		next;
		erasequest 5728;	// Headache
		setquest 5729;	// To Einbech
		yurhik_quest = 2;
		mes "[Arivero Yurhik]";
		mes "货运列车末端见。";
		close2;
		cloakonnpcself( "Arivero Yurhik#TFQ02" );
		end;
	}
	if (yurhik_quest == 4) {
		emotion ET_BLABLA;
		mes "[Arivero Yurhik]";
		mes "你太厉害了。如今的 Clana Nemieri，你称得上最热情的人。";
		next;
		emotion ET_BLABLA;
		mes "[Arivero Yurhik]";
		mes "你看！听说设备被摧毁，我姐姐高兴极了。";
		next;
		mes "他的姐姐只是继续翻看手边的书籍和文件。但 Arivero 似乎毫不在意，兴奋地说了下去。";
		next;
		emotion ET_SURPRISE;
		mes "[Arivero Yurhik]";
		mes "哦！我差点忘了。";
		mes "因为我们揭开了传送禁令设备的秘密，莱茵哈特的特工找到了设备的位置和属性。";
		next;
		emotion ET_SCRATCH;
		mes "[Arivero Yurhik]";
		mes "嗯……";
		mes "位置在宅邸内部，属性是水。这信息太简单了。凭这个能找到它吗？";
		next;
		mes "[Arivero Yurhik]";
		mes "四面环水……水属性……";
		mes "设备的安装位置和传送禁令设备的属性之间有什么关系？";
		next;
		mes "[Arivero Yurhik]";
		mes "真让人头疼。之后再想吧。";
		mes "我们需要什么？需要一块神秘冰冻来让设备现形。";
		next;
		emotion ET_QUESTION;
		mes "[Arivero Yurhik]";
		mes "风属性克制水属性吗？朋友，风属性的属性石是什么？你知道吗？";
		while(true) {
			next;
			switch( select( "火焰心脏", "神秘冰冻", "粗糙的风", "大地之力" ) ) {
			case 1:
				mes "[Arivero Yurhik]";
				mes "不是火焰心脏。它是让艾因贝赫设备现形的火属性石。";
				continue;
			case 2:
				mes "[Arivero Yurhik]";
				mes "神秘冰冻是让莱茵哈特设备现形所需的水属性石。";
				continue;
			case 3:
				mes "[Arivero Yurhik]";
				mes "没错！粗糙的风！这是风属性的属性石。";
				break;
			case 4:
				mes "[Arivero Yurhik]";
				mes "大地之力？那不是地属性的吗？我想现在不需要它。";
				continue;
			}
			break;
		}
		next;
		mes "[Arivero Yurhik]";
		mes "太好了！带一块神秘冰冻和三块粗糙的风来。";
		mes "莱茵哈特见。";
		next;
		emotion ET_QUESTION, playerattached();
		mes "[" + strcharinfo(0) + "]";
		mes "真奇怪。你为什么这么着急？";
		mes "有什么急事吗？";
		next;
		mes "[Arivero Yurhik]";
		mes "哦，我看起来是这样吗？我们已经有了信息，我想在他们察觉前尽快摧毁设备。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "啊！我明白了。";
		mes "这是个好主意。";
		next;
		erasequest 5731;	// Clana Namieri
		setquest 5732;	// To Lighthalzen
		yurhik_quest = 5;
		mes "[Arivero Yurhik]";
		mes "正如我告诉你的，在你出现之前，我可是 Clana Nemieri 最热情的人！";
		next;
		mes "[Arivero Yurhik]";
		mes "Oh!";
		mes "好了，言归正传。带上材料，莱茵哈特见。";
		close2;
		cloakonnpcself( "Arivero Yurhik#TFQ02" );
		end;
	}
	if (yurhik_quest == 6) {
		emotion ET_BLABLA;
		mes "[Arivero Yurhik]";
		mes "你在莱茵哈特的表现太棒了。难怪你这么热情。";
		mes "你看！我姐姐比之前更高兴了。";
		next;

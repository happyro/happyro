					mes "或者听听来自^0000cd斐扬^000000的焦虑中年人诉说？";
					next;
					mes "[Shorty]";
					mes "想了解更多任务信息，";
					mes "还可以查看";
					mes "<URL>[Rune Midgarts Library]<INFO>http://ro.gnjoy.com/guide/runemidgarts/questlist.asp,1024,768</INFO></URL>";
					next;
					mes "[Shorty]";
					mes "你可以了解世界的进程，以及正在发生的重大事件。";
					close;
				case 2:
					mes "[Shorty]";
					mes "大陆全年都有节庆活动。主人有空时去参加怎么样？";
					next;
					mes "[Shorty]";
					mes "现在……";
					next;
					mes "[Shorty]";
					mes "听说王室将在王宫举办冬季狩猎大赛！我想参加狩猎大赛！我想去！打怪物！！！我们去普隆德拉吧！！！！";
					next;
					mes "[Shorty]";
					mes "我一定会带你一起去，好吗？";
					break;
				case 3:
					mes "[Shorty]";
					mes "^0000cd你去过乐园吗^000000？";
					next;
					mes "[Shorty]";
					mes "那里有许多任务等着主人。此外还为初心者提供装备。";
					next;
					mes "[Shorty]";
					mes "当然不是免费的，你必须完成乐园的简单任务。此外，他们还出租影子装备。";
					next;
					mes "[Shorty]";
					mes "有问题就去乐园办公室。";
					break;
				case 4:
					mes "[Shorty]";
					mes "好？那我再逛一会儿就回包里。";
					close;
				}
				next;
			}
			end;

		mes "[Helmut]";
	mes "亲爱的冒险者？你在这里做什么？这里很危险。怪物刚才下来了。请现在离开。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "我没事。我已经习惯每天被怪物攻击。";
		next;
		mes "[Helmut]";
		mes "我忘了你是伟大的战士。请原谅我的无礼。";
		mes "对了，是什么风把你吹来了？";
		next;
		mes "[" + strcharinfo(0) + "]";
	mes "我来带赫尔穆特大人回去。你的祖父非常担心你。他说你在重要时刻离开了家。";
		next;
		mes "[Helmut]";
	mes "我不回去。^0000cd我属于这里，属于前线^000000。请这样告诉我的祖父。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "但大家都很担心你。";
		next;
		mes "[Helmut]";
	mes "我不能回去。事实上，自从长大后，我一直怨恨那些让父母死去的人。";
		next;
		mes "[Helmut]";
		mes "我以为这是培养让人不得不服从之力量的正确方式。";
		next;
		mes "[Helmut]";
	mes "所以我的目标是统一大陆，让我的力量遍及大陆每个角落。因此我不断训练自己。";
		next;
		mes "[Helmut]";
		mes "然而，听了 Myer 和 Agnes 的话，我意识到自己的追求可能给某人带来悲伤和不幸。";
		next;
		mes "[Helmut]";
		mes "所以我决定^0000cd放弃统一战争^000000，那个会把人们推入战争漩涡。";
		next;
		mes "[Helmut]";
	mes "我应该留在这里。在这里我可以^0000cd更安全地保护更多人^000000。";
		next;
		mes "[Helmut]";
		mes "考虑到家族地位，我会配合王室会议的需要。";
		next;
		mes "[Helmut]";
	mes "但我希望 Wolf 能领导一切。王室议会闭幕后，请告诉 Wolf，我会^0000cd把继承人之位交给他^000000。";
		next;
		mes "[Helmut]";
		mes "Wolf 需要很多力量。我会留在这里保护人民。";
		next;
		mes "[Helmut]";
		mes "如果你这样做，Wolf 就不会再坚持战争，Myer 也不会再那样牺牲自己。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "……我明白了。我会把消息告诉你祖父。";
		next;
		mes "[Helmut]";
		mes "是的。谢谢。请保重。";
		erasequest 14504;// In Search of Helmut
		setquest 14505;// I Won't go Back
		ep16_lug = 10;
		close;
	}
	if (ep16_lug == 10) {
		mes "[Helmut]";
		mes "我应该留在这里。";
		mes "请告诉他“^0000cd我放弃战争，并将继承人之位交给 Wolf^000000”。";
		next;
		mes "[Helmut]";
		mes "如果你这样做，Wolf 就不会再坚持战争，Myer 也不会再那样牺牲自己。";
		next;
		mes "[Helmut]";
		mes "那么，再见。";
		close;
	}
	mes "[Helmut]";
	mes "我能感觉到大地在震动。";
	mes "很快会遭到攻击。我必须准备。";
	close;

OnTouch:
	if (ep16_lug == 9 || ep16_lug == 10) {
		mes "[Helmut]";
		mes "喊出集中的口号！！！";
		for ( .@i = 1; .@i < 9; ++.@i )
		npctalk "哈！", "Border Guards#ep16lug0" + .@i, bc_area;
		next;
		mes "[Helmut]";
		mes "大声点！！！！";
		for ( .@i = 1; .@i < 9; ++.@i )
		npctalk "哈！", "Border Guards#ep16lug0" + .@i, bc_area;
		next;
		mes "[Helmut]";
		mes "我们！！！！！！";
		next;
		for ( .@i = 1; .@i < 9; ++.@i )
		npctalk "保护我们的家人和国家！！！", "Border Guards#ep16lug0" + .@i, bc_area;
		close;
	}
	end;
}

yuno_fild01,244,176,3	script	Kalbern#ep16lug02	4_M_RUSCHILD,{
	if (ep16_lug == 9 || ep16_lug == 10) {
		mes "[Kalbern]";
		mes "我很高兴回到这里。";
		mes "现在我有事要做。";
		next;
		mes "[Kalbern]";
		mes "我觉得赫尔穆特大人放弃统一战争很好。";
		mes "我对统一一无所知，但希望不要爆发战争。";
		next;
		mes "[Kalbern]";
		mes "我想帮助赫尔穆特大人守护人民安全和平的日子。";
		close;
	}
	mes "[Kalbern]";
	mes "现在赫尔穆特大人开始口渴了。";
	mes "我想该准备些饮料。";
	close;
}

//prontera,269,73,5	script	Ordinary Man#ep16lug02	4_M_04,5,5,{	// no OnTouch
prontera,269,73,5	script	Ordinary Man#ep16lug02	4_M_04,{
	if (ep16_lug >= 12) {
		mes "[Myer]";
	mes "谢谢你来这里传递消息。没有你，我不会听到今天这样的消息。";
		next;
		mes "[Myer]";
		mes "战斗、战斗、再战斗……我也不想要那样。";
		next;
		mes "[Myer]";
		mes "他们是我的家人，比任何人都亲近。";
		close;
	}
	mes "[Ordinary Man]";
		mes "嘘！你最好别和我说话。";
		mes "周围有很多双眼睛。";
	close;

OnInit:
	cloakonnpc();
	end;
}

// Richard
prt_cas_q,80,80,4	script	Butler for the Richards#EP161GAM	1_M_LIBRARYMASTER,{
	if (checkweight(1301,1) == 0) {
	mes "- 你携带的物品太多，无法继续任务。-";
		close;
	}
	switch( checkquest(5414,PLAYTIME) ) {
	case -1:
		break;
	case 0:
	case 1:
		.@r = rand(1,5);
		mes "[Butler]";
		if (.@r == 1)
			mes "艰苦战斗后好好休息，是快速变强的方法。";
		else if (.@r == 2)
			mes "理查德家族有各种训练方式。休息是最重要的训练之一。";
		else if (.@r == 3)
			mes "理查德家族的历代家主训练后也会充分休息。嗯，这应该是常识。";
		else if (.@r == 4)
			mes "训练后想继续行动的感觉谁都懂。不过那正是该休息的时候。";
		else
			mes "下一次训练同样艰苦。你最好现在休息。";
		close;
	case 2:
		erasequest 5414;// [Stand by]Warrior Discipline
		mes "[Butler]";
		mes "我感觉你已经迫不及待想行动了。看来该进行下一次训练。";
		close;
	}
	.@ep161_family00 = isbegin_quest(5402) + isbegin_quest(5403);
	if (.@ep161_family00 == 0) {
		if ((isbegin_quest(7681) == 2 && isbegin_quest(7682) == 1) || ep16_royal == 2) {
			mes "[Butler]";
		mes "你好。我收到侍从通知后一直在等你。";
			next;
			mes "[Butler]";
		mes "这里是掌控王国军事力量的理查德家族房间。";
			next;
			mes "[Butler]";
		mes "我听说过你的名字，" + strcharinfo(0) + "，你是讨伐摩洛克的英雄。";
			next;
			mes "[Butler]";
		mes "哦！抱歉占用你太多时间。房间里有下一任家主 Po 在等你。";
			next;
			mes "[Butler]";
		mes "我带你进去。";
			setquest 5402;// The Royal Richard
			close;
		}
		mes "[Butler]";
		mes "这里是理查德家族的房间。";
		next;
		mes "[Butler]";
		mes "下一任家主 Po 正在休息。请稍后再来。";
		close;
	}
	if (.@ep161_family00 == 1) {
		mes "[Butler]";
		mes "房间里有下一任家主 Po 在等你。";
		close;
	}
	if (.@ep161_family00 == 2) {
		mes "[Butler]";
		mes "你见过下一任家主了吗？";
		next;
		mes "[Butler]";
		mes "如果下一任家主见到你，" + strcharinfo(0) + "，请……";
		next;
		mes "[Butler]";
		mes "哦！抱歉我失礼了。没什么，请别在意……";
		close;
	}
	setarray .@quest_list[0],
		5404,	// [Repeat]Warrior Discipline-Human
		5405,	// [Repeat]Warrior Discipline-Animal
		5406,	// [Repeat]Warrior Discipline-Insect
		5407,	// [Repeat]Warrior Discipline-Fish
		5408,	// [Repeat]Warrior Discipline-Plant
		5409,	// [Repeat]Warrior Discipline-Devil
		5410,	// [Repeat]Warrior Discipline-Angel
		5411,	// [Repeat]Warrior Discipline-Immortal
		5412,	// [Repeat]Warrior Discipline-Intangible
		5413;	// [Repeat]Warrior Discipline-Dragon
	setarray .@training_list$[0], "human","animal","insect","fish","plant","demon","angel","Immortal","nothing","dragon";
	.@size = getarraysize( .@quest_list );
	while( isbegin_quest(.@quest_list[.@i]) == 0 && .@i < .@size ) .@i++;

	if (.@ep161_family00 == 3) {
		if (BaseLevel < 140) {
			mes "[Butler]";
			mes "我听下一任家主 Po 说，你要尝试理查德战斗训练计划。";
			next;
			mes "[Butler]";
			mes "目前训练对你来说太难了。最好先学习基础，再继续训练。";
			close;
		}
		if (.@i == .@size) {
			mes "[Butler]";
			mes "我听家族下一任首领 Po 说，你打算参加 Richard 战斗训练计划。";
			next;
			mes "[Butler]";
			mes "理查德家族的训练不同于其他训练计划。";
			next;
			mes "[Butler]";
			mes "你一定一直在逐个猎杀怪物进行训练。";
			next;
			mes "[Butler]";
			mes "从现在起，你可以通过猎杀特定类型的怪物训练，例如人类、动物、昆虫、鱼类、植物、恶魔、天使、无形和龙类怪物。";
			next;
			mes "[Butler]";
			mes "挥一百次剑应该比说一百句话更有效。";
		}
	}
	else if (.@ep161_family00 == 4) {
		mes "[Butler]";
		mes "很好。现在准备好了吗？";
	}
	else {
		mes "[Butler]";
		mes "嗯，似乎出现了无法解决的问题。再试一次，如果仍然出现，请截图发送给管理员团队。";
		close;
	}
	if (.@i == .@size) {
		while( true ) {
			next;
			mes "[Butler]";
			mes "请选择要尝试的训练计划。";
			next;
			.@s = select( "战士训练——人类", "战士训练——动物", "战士训练——昆虫", "战士训练——鱼类", "战士训练——植物", "战士训练——恶魔", "战士训练——天使", "战士训练——不死", "战士训练——无形", "战士训练——龙类" ) - 1;
			mes "[Butler]";
			mes "这项训练需要猎杀 50 只等级 140 级以上的" + .@training_list$[.@s] + "怪物。";
			next;
			mes "[Butler]";
			mes "要尝试这项训练吗？";
			next;
			if (select( "尝试。", "不尝试。" ) == 2) {
				mes "[Butler]";
				mes "嗯……你不喜欢训练内容？没关系，换一项训练吧。";
				continue;
			}
			mes "[Butler]";
			mes "即使觉得训练对你的等级来说太容易，也不能放松警惕。祝你好运……";
			setquest .@quest_list[.@s];
			close;
		}
	}
	next;

	if (checkquest(.@quest_list[.@i],HUNTING) == 2) {
		if (isbegin_quest(5403) == 1)
			completequest 5403;// The Royal Richard
		erasequest .@quest_list[.@i];
		setquest 5414;// [Stand by]Warrior Discipline
		getexp 500000,550000;
		getitem 6919,4;// TokenOfHonor
		mes "[Butler]";
		mes "恭喜你完成训练。";
		next;
		mes "[Butler]";
		mes "继续训练，就能实现你的目标。";
		next;
		mes "[Butler]";
		mes "这是我为完成训练准备的奖励。";
		next;
		mes "[Butler]";
		mes "感谢你和我们一起训练，这对理查德家族有益。不必感到压力。";
		close;
	}
	mes "[Butler]";
	mes "你正在参加训练。需要什么吗？";
	next;
	switch( select( "不用。", "关于训练方式", "关于训练目标", "放弃训练。" ) ) {
	case 1:
		mes "[Butler]";
		mes "应该把训练当作真正的战斗！训练期间不要放松警惕。";
		close;
	case 2:
		mes "[Butler]";
		mes "理查德家族一直在研究培养更优秀战士的方法。";
		next;
		mes "[Butler]";
		mes "家族的一位前任家主认为，用某种怪物训练存在局限。";
		next;
		mes "[Butler]";
		mes "前任家主的前任……哦！说明一下，他已经退休了，但还没死。";
		next;
		mes "[Butler]";
		mes "嗯……回到正题……他想出了根据训练者等级或怪物类型进行训练的方法。";
		next;
		mes "[Butler]";
		mes "嗯……训练就这样开始了……";
		close;
	case 3:
		mes "[Butler]";
		mes "训练的目标……这是个简单又困难的问题。";
		next;
		mes "[Butler]";
		mes "最明显的目标当然是变强。年轻时我会这样回答。";
		next;
		mes "[Butler]";
		mes "不过我想回答，目标是保护身边的人。";
		next;
		mes "[Butler]";
		mes "每位战士的目标可能不同。";
		close;
	case 4:
		mes "[Butler]";
		mes "我不会阻止你放弃。不过你应该知道，至今的训练进度不会反映在下一次训练中。";
		next;
		if (select( "不要放弃。", "放弃。" ) == 1) {
			mes "[Butler]";
			mes "明智的决定。应该把训练当作真正的战斗！训练期间不要放松警惕。";
			close;
		}
		erasequest .@quest_list[.@i];
		mes "[Butler]";
		mes "真遗憾。如果完成训练，你本可以收获努力的成果。";
		close;
	}
}

prt_cas_q,93,74,4	script	Po Richard#EP161GAM	4_M_6THPRIN1,{
	if (checkweight(1301,1) == 0) {
		mes "- 你携带的物品太多，无法继续任务。-";
		close;
	}
	if (BaseLevel < 100) {
		mes "[Po Richard]";
		mes "冒险者？看来你现在需要更加努力。";
		close3;
	}
	.@ep161_family00 = isbegin_quest(5402) + isbegin_quest(5403);
	if (.@ep161_family00 == 0) {
		cutin "richard_po02",2;
		emotion ET_PROFUSELY_SWEAT;
		mes "[Po Richard]";
		mes "我现在想休息。";
		next;
		mes "[Po Richard]";
		mes "你一定是受邀来到王宫的冒险者。我现在正在休息。和门前的侍从谈谈，预约见面时间。";
		next;
		mes "[Po Richard]";
		mes "王宫里就是这样办事的。";
		close3;
	}
	if (.@ep161_family00 == 1) {
		cutin "richard_po01",2;
		emotion ET_SPARK;
		mes "[Po Richard]";
		mes "你一定是为讨伐黑暗领主做出巨大贡献的冒险者。你的事迹在王宫也广为人知。";
		next;
		mes "[Po Richard]";
		mes "尤其是我们理查德家族，对你的事迹很感兴趣。";
		next;
		mes "[Po Richard]";
		mes "想知道为什么吗？";
		next;
		mes "[Po Richard]";
		mes "即使你不想知道，我也要说我想说的。";
		next;
		mes "[Po Richard]";
		mes "其实你不是自愿来这里的。我很确定是那位大人叫你来的。我理解。";
		next;
		mes "[Po Richard]";
		mes "虽然冒险者可能不太关心王宫事务，但理查德家族负责卢恩·米德加尔特的军事力量。";
		next;
		emotion ET_QUESTION;
		mes "[Po Richard]";
		mes "我们也培养了许多优秀战士。嗯！我突然好奇起来。你听说过理查德家族的战士吗？";
		next;
		switch( select( "听说过。", "没听说过。" ) ) {
		case 1:
			mes "[Po Richard]";
			mes "哈哈哈，看来理查德这个名字在冒险者中也很有名。";
			break;
		case 2:
			cutin "richard_po02",2;
			emotion ET_SCRATCH;
			mes "[Po Richard]";
			mes "哦，天啊。我一定是在吹嘘。理查德家族应该更加努力。";
			break;
		}
		next;
		mes "[Po Richard]";
		mes "既然不重要，就让它过去吧。我已经很久没说这么多话了。我口渴了。";
		next;
		completequest 5402;// The Royal Richard
		if (achievementinfo(130000, ACHIEVEINFO_COUNT5) == 0)
			achievementupdate(130000, ACHIEVEINFO_COUNT5, 1);
		if (isbegin_quest(7682) == 1 && isbegin_quest(5402) == 2 && isbegin_quest(7683) == 2 && isbegin_quest(7684) == 2 && ep16_wal > 1 && ep16_wig > 1 && ep16_lug > 1 && ep16_gaobs > 1) {
			completequest 7682;// Socializing Starts from an Eye Contact
			setquest 7685;// What Is the Next Thing on the Schedule ?
		}
		mes "[Po Richard]";
		mes "继续之前先休息一下吗？";
		close3;
	}
	if (.@ep161_family00 == 2) {
		cutin "richard_po01",2;
		mes "[Po Richard]";
		mes "那么，谈谈理查德家族对你感兴趣的原因吧。";
		next;
		mes "[Po Richard]";
		mes "众所周知，理查德家族培养优秀战士。我们运行系统化的训练体系来支持这一点。";
		next;
		mes "[Po Richard]";
		mes "我不喜欢这种训练，但我相信这是基于家族经验的有效训练计划。";
		next;
		mes "[Po Richard]";
		mes "请仔细听，我要说重点了。";
		next;
		mes "[Po Richard]";
		mes "我想冒险者可能没那么感兴趣；不过有许多王室成员参加了讨伐黑暗领主的行动。他们向我报告了你的事迹。";
		next;
		mes "[Po Richard]";
		mes "听到你的贡献后，我产生了一个疑问。如果自由冒险者参加严格的训练体系，会发生什么？我很好奇。";
		next;
		emotion ET_COMEON;
		mes "[Po Richard]";
		mes "如果像你这样的知名冒险者帮助我们，我愿意支付丰厚报酬。";
		next;
		mes "[Po Richard]";
		mes "我觉得这是很有吸引力的提议。你愿意挑战理查德家族的战士训练体系吗？";
		next;
		if (select( "我试试。", "我拒绝。" ) == 2) {
			emotion ET_OTL;
			mes "[Po Richard]";
			mes "看来这个提议对你没有吸引力。很遗憾，改变想法后再回来吧。";
			close3;
		}
		emotion ET_OK;
		mes "[Po Richard]";
		mes "很好！我喜欢你果断的决定。我重视挑战精神。";
		next;
		mes "[Po Richard]";
		mes "我去告诉侍从。你可以通过他继续训练。";
		setquest 5403;// The Royal Richard
		close3;
	}
	if (.@ep161_family00 == 3) {
		cutin "richard_po01",2;
		mes "[Po Richard]";
		mes "别小看会指导你训练的侍从。";
		next;
		mes "[Po Richard]";
		mes "他本人就是理查德家族成员，是一名优秀战士。";
		close3;
	}

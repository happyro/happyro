			enablenpc instance_npcname("#tnm3gate01");
			enablenpc instance_npcname("#tnm3event02ect");
			'devil_tower = 11;
		}
		end;
	}
	if ('devil_tower == 11) {
		mes "[小女孩]";
		mes "那个架子后面有通往地下室的秘密通道！";
		mes "请跟我来，确认爸爸安全。";
		close;
	}
	end;

OnMobDead:
	'mob_count--;
	if ('mob_count == 0) {
		'devil_tower = 10;
		npctalk "小女孩：谢谢你救了我……但为什么会有恶魔？";
	}
	end;
}


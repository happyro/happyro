		mes "";
		mes "";
		geffen_in,109,170,3	script	Blacksmith Guildsman#gef	726,{
		mes "[Blacksmith Guildsman]";
		mes "你好，你是来参观铁匠公会的吗？";
		next;
		mes "[Blacksmith Guildsman]";
		mes "感谢你远道参观我们的公会。不过很遗憾，铁匠公会已迁往^3131FF施瓦尔兹瓦德共和国的‘艾音布罗克’^000000。";
		mes "";
		next;
		mes "[Blacksmith Guildsman]";
		mes "你可以乘坐飞空艇前往施瓦尔兹瓦德共和国。";
		mes "我可以提供传送到依斯鲁得的服务，你可在那里乘坐飞空艇。";
		next;
	switch(select("如何前往艾音布罗克:好的！:不用了，谢谢。")) {
		case 1:
			mes "[Blacksmith Guildsman]";
			mes "哦，你还没使用过飞空艇吗？";
			next;
		}
		set Zeny, Zeny-600;
		warp "izlude",94,103;
		end;
	case 3:
		mes "[Blacksmith Guildsman]";
		mes "与卢恩-米德加尔特王国不同，施瓦尔兹瓦德共和国使用飞空艇而非传送服务往返城镇。";
		next;
	}
}

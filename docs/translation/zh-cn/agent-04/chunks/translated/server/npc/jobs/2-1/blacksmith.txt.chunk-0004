				mes "^8E6B23Change Cart^000000 skills?";
				next;
				if (select("Al De Baran:Alberta:Morocc:Izlude") == 2)
					set .@blackss_te,.@blackss_te+20;
				mes "[Mitehmaeeuh]";
				mes "3. From the center of Einbroch,";
				mes "铁匠公会位于哪个方向？";
				next;
				if (select("11 o'clock:5 o'clock:7 o'clock:12 o'clock") == 2)
					set .@blackss_te,.@blackss_te+20;
				mes "[Mitehmaeeuh]";
				mes "4. In which town";
				mes "哪个城镇能找到";
				mes "最多的铁匠？";
				next;
				if (select("Prontera:Morocc:Alberta:Einbroch") == 4)
					set .@blackss_te,.@blackss_te+20;
				mes "[Mitehmaeeuh]";
				mes "5. Which of the";
				mes "以下哪些属性会影响";
				mes "铁匠技能？";
				mes "";
				next;
				if (select("STR :DEX:AGI :VIT ") == 2)
					set .@blackss_te,.@blackss_te+20;
				break;
			}
			mes "[Mitehmaeeuh]";
			mes "啊……";
			mes "你完成了测验。让我看看……";
			mes "";
			next;
			mes "[Mitehmaeeuh]";
			mes "你获得了";
			mes ""+ .@blackss_te +" 分……";
			if (.@blackss_te > 70) {
				mes "非常好！";
				mes "恭喜！";
				mes "你通过了！";
				next;
				mes "[Mitehmaeeuh]";
				mes "不过别因早期成功而自满。铁匠生活并不轻松。作为通过测试的证明，给你这把铁匠之锤。";
				set BSMITH_Q,17;
				getitem 1005,1; //Hammer_Of_Blacksmith
				changequest 2014,2015;
				next;
				mes "[Mitehmaeeuh]";
				mes "带着这把铁匠之锤回去找 Altiregen。祝你好运！";
				mes "";
				close;
			}
			mes "你失败了！好好学习后再回来。";
			next;
			mes "[Mitehmaeeuh]";
			mes "以你现在的知识，拿锤子只会伤到自己！";
			close;
		}
		mes "[Mitehmaeeuh]";
		mes "好吧。准备好后再回来……";
		mes "";
		mes "";
		mes "";
		close;
	}
	else if (BSMITH_Q == 17) {
		emotion ET_SCRATCH;
		mes "[Mitehmaeeuh]";
		mes "没错，你刚通过铁匠职业测试～";
		next;
		mes "[Mitehmaeeuh]";
		mes "回去找 Altiregen 先生吧。";
		next;
		mes "[Mitehmaeeuh]";
		mes "别忘了带上铁匠之锤！";
		next;
		mes "[Mitehmaeeuh]";
		mes "哦，转职前确保没有剩余技能点～";
		close;
	}
	else {
		emotion ET_SCRATCH;
		mes "[Mitehmaeeuh]";
		mes "我在梦罗克时要忍受高温，现在又要忍受艾音布罗克的烟雾！";
		mes "";
		next;
		mes "[Mitehmaeeuh]";
		mes "但我得承认这里很适合铁匠，因为有丰富的制作材料和高度发达的设备。";
		next;
		mes "[Mitehmaeeuh]";
		mes "我们铁匠正努力锻造最好的武器。";
		next;
		mes "[Mitehmaeeuh]";
		mes "我们以荣誉担保！";
		close;
	}
}

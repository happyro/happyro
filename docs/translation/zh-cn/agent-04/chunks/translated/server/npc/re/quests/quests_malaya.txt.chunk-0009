ma_in01,47,101,3	script	Totoy#buwaya	577,7,7,{
	if ((malaya_hi < 20) || (malaya_buwaya < 2)) {
		mes "- 看到一个眼神呆滞、身体颤抖的人。 -";
		close;
	}
	if (malaya_buwaya == 2) {
		mes "- 看到一个眼神呆滞、身体颤抖的人。 -";
		next;
		if (select("拍拍他的肩膀。:无视他。") == 2)
			close;
		emotion ET_HUK;
		mes "[托托伊]";
		mes "哇！不要！走开！别烦我！";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "嘿，你还好吗？";
		next;
		mes "[托托伊]";
		mes "嗯……你是人？你是谁？";
		next;
		mes "- 他直直看着你，却似乎认不出你。-";
		next;
		mes "[托托伊]";
		mes "谁在那里？";
		next;
		mes "[" + strcharinfo(0) + "]";
	mes "我是" + strcharinfo(0) + "。你就是 Totoy，对吧？听说你找到了宝藏，是真的吗？";
		next;
		mes "[托托伊]";
		mes "什么宝藏？";
		mes "我看不见。我失明了。请帮帮我。我又累又沮丧。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "发生了什么？";
		next;
		mes "[托托伊]";
		mes "不能聊太久。我得先治好眼睛。";
		mes "应该还有一些 ^3131FF绿色药水^000000 在抽屉里。你能帮我拿出来吗？";
		set malaya_buwaya,3;
		close;
	} else if (malaya_buwaya == 3) {
		if (!countitem(506)) {
			mes "[托托伊]";
			mes "不能聊太久。我得先治好眼睛。";
			mes "应该还有一些 ^3131FF绿色药水^000000 在抽屉里。你能帮我取来吗？";
			close;
		}
		mes "[托托伊]";
	mes "喂？嘿，你还在吗？绿色药水怎么了？天啊，真让我抓狂。";
		next;
		if (select("交出绿色药水。:不交出药水。") == 2) {
			mes "[托托伊]";
			mes "你真的走了吗？嘿！可恶！";
		} else {
			mes "[托托伊]";
			mes "咕噜，咕噜……";
			delitem 506,1; //Green_Potion
			set malaya_buwaya,4;
		}
		close;
	} else if (malaya_buwaya == 4) {
		emotion ET_SURPRISE;
		mes "[托托伊]";
		mes "我能看见了！！我的眼睛恢复了！！！";
		mes "太好了！我感觉好多了！";
		next;
		emotion ET_THINK, playerattached();
		emotion ET_BEST;
		mes "[托托伊]";
		mes "哇！你看起来比听起来好多了。哈哈。";
		next;
		mes "[托托伊]";
		mes "不过你刚才说什么？关于宝藏？";
		mes "你说我找到了宝藏？";
		mes "那是怎么回事？";
		next;
		select("告诉他人们在谈论什么。");
		emotion ET_SMILE;
		mes "[托托伊]";
		mes "什么？";
		mes "噗哈哈！托托伊发财了！一夜暴富！艾德队长！";
		next;
		emotion ET_HNG;
		mes "[托托伊]";
		mes "抱歉，我去森林收集昆虫了。真希望顺便能看到宝藏。哼！";
		next;
		emotion ET_THINK;
		mes "[托托伊]";
		mes "我确实深入森林了，因为收集昆虫一直没有进展。但谁能想到会陷入这种麻烦？";
		next;
		if (select("托托伊看到了什么:关于昆虫") == 2) {
			mes "[托托伊]";
			mes "我只是想给大家看我收集的可爱昆虫。哈哈。";
			next;
			emotion ET_SMILE;
			mes "[托托伊]";
			mes "把冰块或昆虫放进别人衣服里，就像日常问候一样，对吧？";
			next;
			mes "[托托伊]";
			mes "我喜欢看人们像跑马拉松一样在村里奔跑。嘿嘿。";
			next;
		}
		mes "[托托伊]";
		mes "我以为普通昆虫不会让人逃跑，所以和艾德一起进了森林。";
		next;
		mes "[托托伊]";
		mes "啊，艾德是我可爱的小狗。他很友善，也很爱撒娇，是全世界最好的朋友。";
		next;
		emotion ET_THINK;
		mes "[托托伊]";
		mes "艾德平时很爱叫，但他叫着拉我袖子时，我应该环顾四周。";
		next;
		mes "[托托伊]";
		mes "- 托托伊弯下腰，像隔墙有耳一样对你低声说话。-";
		next;
		mes "[托托伊]";
		mes "我身后有一只嘴巴和房子一样大的怪物。";
		next;
		select("怪物？！");
		mes "[托托伊]";
		mes "嘘！安静。我从没见过那么大的嘴。尖牙间流出河一样的口水。光想想就想躲起来。";
		next;
		mes "[托托伊]";
		mes "最可怕的是怪物有两个头。不亲眼见到你不会相信。";
		next;
		emotion ET_CRY;
		mes "[托托伊]";
		mes "艾德拼尽全力咬住怪物的腿，让我逃走。但之后发生了什么我不知道。抽泣~";
		next;
		mes "[托托伊]";
		mes "那时我的眼睛受伤了。说实话，我甚至不记得自己怎么回来的。";
		next;
		select("关于怪物");
		mes "[托托伊]";
		mes "不知道。那是我第一次见到那样的怪物。谁能活着讲出这个故事？";
		next;
		mes "[托托伊]";
		mes "等等，也许^FF0000狩猎大师^000000知道这种怪物。他们说他和各种怪物战斗过。";
		next;
		mes "[托托伊]";
		mes "我需要独处一会儿。我要给艾德做墓碑。想见^FF0000狩猎大师^000000的话，他就在武器店附近。";
		next;
		mes "[托托伊]";
		mes "告诉其他人别再传播宝藏谣言。他们不知道我经历了什么。抽泣！我要把远古虫放进每个人的衣服！";
		set malaya_buwaya,5;
		erasequest 2272;
		setquest 2273;
		close;
	} else if (malaya_buwaya == 5) {
		mes "[托托伊]";
		mes "我得为艾德做墓。我的忠诚朋友，艾德……";
		mes "想见^FF0000狩猎大师^000000的话，他就在武器店附近。";
		close;
	} else if (malaya_buwaya == 6) {
		mes "[托托伊]";
		mes "艾德！！艾德德德德德德！！！";
		mes "不敢相信你牺牲生命救了我。呜啊！！！";
		next;
		mes "- 托托伊哭得如此伤心，不可能是在撒谎。-";
		close;
	} else if (malaya_buwaya == 7) {
		mes "[托托伊]";
		mes "我在哪里看到怪物？";
		next;
		mes "[托托伊]";
		mes "嗯……嗯……";
		mes "我当时忙着逃跑……";
		next;
		mes "[托托伊]";
		mes "在森林深处。可能甚至超过了巴里奥·玛希瓦卡。";
		mes "我想我听到了^3131FF流水^000000声。巨大的呼啸声。我只记得这些。";
		close;
	} else if ((malaya_buwaya > 7) && (malaya_buwaya < 12)) {
		mes "[托托伊]";
		mes "可怜的艾德。我想念艾德。呜啊！！！！";
		close;
	} else if (malaya_buwaya == 12) {
		emotion ET_CRY;
		mes "[托托伊]";
	mes "可怜的艾德。我想念艾德。呜啊！！！！";
		next;
		enablenpc "Dog#buwaya_totoi";
		mes "[狗]";
		mes "汪汪！！";
		next;
		emotion ET_HUK;
		mes "[托托伊]";
		mes "Ed!!";
		mes "艾德！！！你还活着！！！";
		mes "你回来了！！！我好开心！！！！";
		next;
		mes "[托托伊]";
		mes "你把艾德带回来了吗？";
		mes "太谢谢你了！";
		mes "你没看到怪物吧？";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "怪物叫布瓦亚。我已经告诉警卫了。你最好别再靠近那里。";
		next;
		mes "[托托伊]";
		mes "好的！";
		mes "嘿嘿。艾德，森林太危险了，我们以后不能去那里抓虫了。";
		next;
		mes "[狗]";
		mes "呜咽……";
		next;
		mes "[托托伊]";
		mes "不过我相信我们可以用其他吓人的东西来维持名声！";
		next;
		mes "[狗]";
		mes "汪汪！！";
		next;
		/*
		// Better translation needed.
		mes "[托托伊]";
		mes "嗯……嘿！";
		next;
		select("你是" + ((Sex == SEX_MALE) ? "男孩" : "女孩") + "，对吧？");
		emotion ET_HUK, playerattached();
		mes "[托托伊]";
		mes "嗯？";
		if (Sex == SEX_FEMALE) {
		mes "托托伊是女孩，而你是男孩。";
		mes "你不是男孩？";
		} else {
		mes "托托伊是女孩，而你也是女孩。";
		mes "你不是女孩？";
		}
		next;
		mes "[托托伊]";
		mes "是因为我的名字托托伊吗？这是我出生时父母以为我是男孩而取的名字。哈哈！";
		next;
		*/
		mes "[托托伊]";
	mes "总之，谢谢你带回我最好的朋友。";
	mes "我没什么东西，但想感谢你。等等，让我看看抽屉里有什么。嘿嘿——";
		set malaya_buwaya,13;
		erasequest 2278;
		setquest 2279;
		close;
	} else if (malaya_buwaya == 13) {
		if (checkweight(1201,1) == 0 || MaxWeight - Weight < 2000) {
		mes "- 等等！！-";
		mes "- 你携带的物品太多。-";
		mes "- 无法获得物品。-";
		mes "- 请整理物品-";
		mes "- 然后再试。-";
			close;
		}
	mes "- 托托伊翻遍抽屉，把房间弄得一团糟。-";
		next;
		mes "[托托伊]";
	mes "找到了！";
		next;
		mes "[托托伊]";
	mes "给你。这是妈妈给我的，但我不知道怎么用……嘿嘿。";
	mes "希望你能用得上。";
		next;
		mes "[托托伊]";
	mes "无聊时来找我！";
	mes "只是别再问宝藏的事了~！";
		next;
	mes "[狗]";
	mes "汪汪汪！！！！";
		set malaya_buwaya,14;
		if (!VIP_SCRIPT || vip_status(VIP_STATUS_ACTIVE))
			getitem 6497,10; //Lesser_Agimat
		else
			getitem 6497,5; //Lesser_Agimat
		disablenpc "Dog#buwaya_totoi";
		erasequest 2279;
		setquest 2280;
		close;
	} else {
		mes "[托托伊]";
	mes "艾德出去玩了，所以我一个人。";
	mes "有没有什么厉害的东西能给大家惊喜？";
		close;
	}
OnTouch_:
	emotion ET_HUK;
	end;
}


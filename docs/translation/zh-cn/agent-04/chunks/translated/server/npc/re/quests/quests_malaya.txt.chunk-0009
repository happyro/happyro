ma_in01,44,105,3	script	Drawer#buwaya	844,{
	if (malaya_buwaya == 3) {
	mes "- 你在托托伊的抽屉里寻找绿色药水。-";
		next;
	mes "- 翻找，摸索。-";
		next;
	mes "- 翻找，摸索。-";
	mes "- 翻找，摸索。-";
		next;
	mes "- 咣当，铿锵，嘎吱。-";
		next;
		mes "[" + strcharinfo(0) + "]";
	mes "什么？我只看到空药水瓶。";
	mes "这意味着我要自己去拿药水？那个托托伊真会惹麻烦。";
		close;
	}
	end;
}

malaya,290,152,5	script	Master of Hunting#buwaya	578,{
	if ((malaya_hi < 20) || (malaya_buwaya < 5)) {
		mes "[狩猎大师]";
		mes "Oh! Ho! Ho!";
		mes "我是狩猎大师！我什么都不怕，只有一个例外！我害怕外来者……";
		close;
	}
	if (malaya_buwaya == 5) {
		mes "[狩猎大师]";
		mes "Yo! Ho! Ho!";
		mes "我一路前往卢恩-米德加尔特王国，击败愤怒的米诺斯。";
		next;
		mes "[狩猎大师]";
		mes "我还成功杀死了木卡，它的声音像恶魔一样扰乱世界的安宁。";
		mes "哇！它真的很强。光想起它我就开始出汗。";
		next;
		mes "[狩猎大师]";
		mes "哟！你看起来也有几段战斗故事。你见过米诺斯吗？哈哈哈！";
		next;
		mes "[狩猎大师]";
		mes "所以你来这里是想了解我出色的狩猎技能？还是要我发表一篇关于狩猎大师的文章？吼！";
		next;
			if (select("关于 Totoy 的魔物:打断。") == 2) {
			mes "[狩猎大师]";
				mes "哦？嘿！你要去哪儿？！";
			close;
		}
		mes "[狩猎大师]";
		mes "你说有人看到了魔物？";
		next;
		mes "[狩猎大师]";
		mes "马来港内外有很多魔物。这一只有什么特别的？";
		next;
		select("关于一只长着两个头的魔物");
		mes "[狩猎大师]";
		mes "哦！你说长着两个头的魔物？你在开玩笑吧？世上哪有长着两个头的魔物？！";
		next;
		mes "[狩猎大师]";
		mes "那孩子一定是被 Condor 之类的东西吓到了。";
		mes "有句话说，看到佩米特会惊讶的人，看到桃树也会惊讶。哈哈！";
		next;
		mes "[狩猎大师]";
		mes "你不该对大人撒谎。我知道你想引起狩猎大师的注意。哈哈！";
		next;
		if (select("我会证明。:怀疑 Totoy。") == 2) {
			mes "[狩猎大师]";
			mes "孩子们会出于自己的理由编故事。我相信 Totoy 也是如此。";
			set malaya_buwaya,6;
			close;
		}
		mes "[狩猎大师]";
		mes "哦！真的吗？如果你真觉得那孩子说的是真的，就带证据来。";
		next;
		mes "[狩猎大师]";
		mes "每个活物都会留下某种痕迹。你走到哪里也会留下痕迹和气味。尤其是在私密场所，我是说。嘿嘿！";
		next;
		mes "[狩猎大师]";
		mes "试着从孩子看到魔物的地方收集 10 份动物样本。我会从样本中寻找那只魔物的痕迹。";
		next;
		mes "[狩猎大师]";
		mes (Sex == SEX_MALE) ? "这不会令人愉快，但任何勇敢的男人都能轻松做到，对吧？" : "我不想让漂亮女孩的手沾上臭味，但像你这样的人我就不在乎了。哈哈！";
		set malaya_buwaya,7;
		erasequest 2273;
		setquest 2274;
		close;
	} else if (malaya_buwaya == 6) {
		mes "[狩猎大师]";
		mes "哦，你回来了！";
		next;
		if (select("看看里面有没有魔物！:我不认为里面有魔物。") == 2) {
			mes "[狩猎大师]";
			mes "那只是孩子的玩笑。哈哈。";
			close;
		}
		mes "[狩猎大师]";
		mes "哦！真的吗？如果你真觉得那孩子说的是真的，就带证据来。";
		next;
		mes "[狩猎大师]";
		mes "每个活物都会留下某种痕迹。你走到哪里也会留下痕迹和气味。尤其是在私密场所，我是说。嘿嘿！";
		next;
		mes "[狩猎大师]";
		mes "试着从孩子看到魔物的地方收集 10 份动物样本。我会从样本中寻找那只魔物的痕迹。";
		next;
		mes "[狩猎大师]";
		mes (Sex == SEX_MALE) ? "这不会令人愉快，但任何勇敢的男人都能轻松做到，对吧？" : "我不想让漂亮女孩的手沾上臭味，但像你这样的人我就不在乎了。哈哈！";
		set malaya_buwaya,7;
		erasequest 2273;
		setquest 2274;
		close;
	} else if (malaya_buwaya == 7) {
		if (countitem(6519) < 10) {
			mes "[狩猎大师]";
		mes "如果你想证明有长着两个头的魔物，就把样本带回来。";
			close;
		}
		mes "[狩猎大师]";
		mes "啊！真恶心。";
		mes "你真的把样本带回来了。";
		mes "哦！把它放在那里，洗完手再回来。那股臭味连神都不会对你微笑。";
		delitem 6519,10; //Collected_Sample
		set malaya_buwaya,8;
		erasequest 2274;
		setquest 2275;
		close;
	} else if (malaya_buwaya == 8) {
		mes "[狩猎大师]";
		mes "哦！我来吗？";
		next;
		mes "-翻找、摸索。-";
		next;
		mes "-翻找、摸索。-";
		mes "-扭动、摇晃。-";
		next;
	mes "-翻找、摸索。-";
		mes "-扭动、摇晃。-";
		mes "-摇摆、晃动。-";
		next;
		mes "[狩猎大师]";
		mes "哦！这是！！";
		next;
		mes "[狩猎大师]";
		mes "哇！哦！哦！哦！太棒了！！！！！！";
		next;
		mes "[狩猎大师]";
		mes "你！过来摸摸这个！";
		set malaya_buwaya,9;
		enablenpc "#buwaya_soil";
		close;
	} else if (malaya_buwaya == 9) {
		mes "[狩猎大师]";
		mes "别站在那里。摸摸样本！";
		enablenpc "#buwaya_soil";
		close;
	} else if (malaya_buwaya == 10) {
		mes "[狩猎大师]";
		mes "快去告诉卫兵队长 Buwaya 又出现了。快点！你会在村子北边找到卫兵队长。";
		close;
	} else {
		mes "[狩猎大师]";
		mes "打瞌睡……";
		close;
	}
}

malaya,291,152,3	script	#buwaya_soil	557,{
	if (malaya_buwaya == 9) {
	mes "-翻找、摸索。-";

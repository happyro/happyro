que_ng,152,167,3	script	Master Miller	901,{
	if (Upper == 2) {
		mes "[Master Miller]";
		mes "哎呀，这不是可爱的小孩吗～";
		mes "你的妈妈在哪里？";
		mes "这里很危险，请快回家，好吗？";
		mes "";
		mes "";
		close;
	}
	if (Class == Job_Novice) {
		if (!callfunc("F_CanChangeJob")) {
			mes "[Master Miller]";
			mes "想成为枪手吗？你有潜力，";
			mes "但经验还不够。";
			mes "再训练一阵子后回来，听到了吗？";
			mes "";
			mes "";
			mes "";
			close;
		}
		if (GUNS_Q == 0) {
			mes "[Master Miller]";
			mes "我是 Miller，全职枪手教官，";
			mes "也是 Selena 女士的守卫。";
			mes "你需要什么？如果不重要，我没时间陪你。";
			mes "";
			mes "";
			next;
			if(select("没什么。:我想成为枪手。") == 1) {
				mes "[Master Miller]";
				mes "别浪费我的时间。";
				mes "想成为枪手就回来找我。";
				mes "";
				mes "";
				close;
			}
			mes "[Master Miller]";
			mes "嗯，你很年轻，但你的眼神告诉我你很有野心。";
			mes "成为枪手必须通过面试和教育课程。你要申请吗？";
			mes "";
			mes "";
			next;
			if(select("给我时间想想。:当然！") == 1) {
				mes "[Master Miller]";
				mes "可以理解。";
				mes "如果决定成为枪手，马上告诉我。";
				mes "我会帮你开始。";
				mes "";
				mes "";
				mes "";
				close;
			}
			mes "[Master Miller]";
			mes "太好了。那么开始吧。";
			mes "把这封信交给斐扬的 Wise Bull Horn 先生。";
			mes "他是萨满，会判断你是否有资格成为枪手。";
			mes "";
			mes "";
			mes "";
			set GUNS_Q,1;
			setquest 6020;
			close;
		}
		else if (GUNS_Q == 1) {
			mes "[Master Miller]";
			mes "把我写的介绍信交给斐扬的 Wise Bull Horn 先生。";
			mes "他会测试你是否具备枪手资质。";
			mes "";
			mes "";
			mes "";
			mes "";
			close;
		}
		else if (GUNS_Q == 2) {
			mes "[Master Miller]";
			mes "嗯……Wise Bull Horn 让你收集制作凭证的材料？";
			mes "嗯，我想这是资格测试的一部分。";
			mes "";
			mes "";
			mes "";
			close;
		}
		else if (GUNS_Q == 3) {
			mes "[Master Miller]";
			mes "Wise Bull Horn 让你带牛奶给他？";
			mes "他已经开始拜托你，看来很喜欢你。朋友，祝你好运。";
			mes "";
			mes "";
			mes "";
			close;
		}
		else if (GUNS_Q == 4) {
			mes "[Master Miller]";
			mes "我期待很快听到你的好消息。";
			mes "我确信你会成为枪手。";
			mes "";
			mes "";
			close;
		}
		else if (GUNS_Q == 5) {
			if (SkillPoint != 0) {
				mes "[Master Miller]";
				mes "嘿，你还有剩余技能点。";
				mes "在回来找我前最好全部用掉。";
				mes "";
				mes "";
				close;
			}
			mes "[Master Miller]";
			mes "哦，你带来了 Wise Bull Horn 的凭证？";
			mes "他很久没给别人凭证了，我真为你骄傲！";
			mes "";
			mes "";
			mes "";
			next;
			mes "[Master Miller]";
			mes "如果 Wise Bull Horn 认可你，";
			mes "我没有理由拒绝。好吧，我会把你转职为枪手。";
			mes "但先让我详细说明我们的工作。";
			mes "";
			mes "";
			mes "";
			next;
			mes "[Master Miller]";
			mes "作为枪手，你必须随身携带枪。";
			mes "枪手公会监管所有枪械和子弹，";
			mes "所以只能从公会成员那里购买。";
			mes "";
			mes "";
			mes "";
			next;
			mes "[Master Miller]";
			mes "别担心，现在到处都能找到枪手公会成员。";
			mes "这是公会领袖 Selena 女士的命令。";
			mes "";
			mes "";
			next;
			mes "[Master Miller]";
			mes "总有一天你也许能见到她。";
			mes "我们必须规范枪械和子弹销售，避免落入邪恶或不负责任的人手中。";
			mes "";
			mes "";
			mes "";
			next;
			mes "[Master Miller]";
			mes "无论如何，和另一位枪手交谈总是很愉快。保持联系吧。";
			mes "愿大地之力在你的冒险中保护你～";
			mes "";
			mes "";
			mes "";
			mes "";
			callfunc "Job_Change",Job_Gunslinger;
			set GUNS_Q,6;
			completequest 6024;
			if (checkre(0)) {
				getitem 13180,1;		// Novice_Rifle
				getitem 12149,2;		// Bullet_Case
				getitem 12151,1;		// Bullet_Case_Silver
			} else {
				if (rand(2))
					getitem 13100,1;	// Six_Shooter
				else
					getitem 13150,1;	// Branch
			}
			close;
		}
	} else {
		if (Class == Job_Gunslinger) {
			mes "[Master Miller]";
			mes "哦！好久不见，朋友。最近好吗？";
			mes "希望你一直把枪保养好。照顾好它，它也会照顾你。记住这点。";
			mes "";
			mes "";
			mes "";
			mes "";
			close;
		} else {
			mes "[Master Miller]";
			mes "如果没事找我，";
			mes "那就请离开吧。";
			mes "";
			close;
		}
	}
}

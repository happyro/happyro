		payon,184,65,3	script	Wise Bull Horn	866,{
		if (GUNS_Q == 1) {
	}
	else if (GUNS_Q == 4) {
		if (countitem(519) < 1) {
			mes "[Wise Bull Horn]";
			mes "你好，年轻人。";
			mes "什么事让你来找我？";
			mes "";
			mes "";
			mes "";
			next;
		}
		delitem 519,1; // Milk
		set GUNS_Q,5;
		changequest 6023,6024;
		mes "["+strcharinfo(0)+"]";
		mes "Miller 先生让我把这封信交给你。";
		mes "其实我想成为枪手……";
		mes "";
		mes "";
		next;
		mes "[Wise Bull Horn]";
		mes "你说 Miller？嗯，Black Fox 不会为他认为无法成为优秀枪手的人写介绍。";
		mes "是的，我想我知道他为什么派你来。";
		mes "";
		mes "";
		next;
		mes "[Wise Bull Horn]";
		mes "我能从你的眼神看出来：你有温暖的心和强烈责任感。";
		mes "你只需要大地的祝福来守护枪手之路。";
		mes "";
		mes "";
		mes "";
		mes "";
		next;
		mes "[Wise Bull Horn]";
		mes "我可以制作一张凭证，证明你想成为大地战士，交给枪手教官。";
		mes "我需要这些材料……";
		mes "";
		mes "";
		next;
	}
	else if (GUNS_Q == 5) {
		mes "[Wise Bull Horn]";
		mes "^3355FF1 Trunk^000000,";
		mes "^3355FF3 Fluffs^000000,";
		mes "^3355FF3 Zargons^000000,";
		mes "^3355FF10 Shells^000000,";
		mes "^3355FF3 Green Herbs^000000, and";
		mes "^3355FF3 Rainbow Shells^000000.";
		next;
		mes "[Wise Bull Horn]";
		mes "我完成凭证后，你可以把它带给 Black Fox，";
		mes "他会帮助你实现成为枪手的目标。";
		mes "";
		mes "";
		set GUNS_Q,2;
	changequest 6020,6021;
	close;
		mes "";
		mes "";
		mes "";
		mes "";
		mes "";
		}
	else if (GUNS_Q == 2) {
	if (countitem(912) < 3 || countitem(914) < 3 || countitem(1019) < 1 || countitem(935) < 10 || countitem(511) < 3 || countitem(1013) < 3) {
		mes "[Wise Bull Horn]";
		mes "我可以制作一张凭证，证明你想成为大地战士，交给枪手教官。";
		mes "我需要这些材料……";
		next;
	}
}

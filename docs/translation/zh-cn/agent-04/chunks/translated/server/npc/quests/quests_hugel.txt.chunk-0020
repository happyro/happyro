que_hugel,35,29,5	script	object#1	139,2,2,{
OnTouch_:
	if (hg_odin == 21) {
		mes "^3355FF奥丁神殿的风化建筑";
		mes "";
		mes "半埋在地面下，";
		mes "但看起来仍然";
		mes "坚固耐用。^000000";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "......";
		mes ".........";
		next;
		switch(select("经过:探索")) {
		case 1:
			mes "^3355FF你决定经过";
			mes "神殿遗迹。^000000";
			close;
		case 2:
			if (rand(1,3) == 1) {
				mes "^3355FF你在遗迹中看到";
				mes "一道明亮闪光，";
				mes "来自神殿残骸。^000000";
				next;
				switch(select("忽略:捡起")) {
				case 1:
					mes "^3355FF你决定继续";
					mes "搜寻";
					mes "神殿废墟。^000000";
					close;
				case 2:
					mes "^3355FF你在废墟中发现一块发光石头，小心地";
					mes "";
				mes "把它放进包里。^000000";
					next;
					mes "^FF0000Thud!^000000";
					next;
					mes "["+strcharinfo(0)+"]";
				mes "什么……？";
				mes "刚才的";
				mes "声音是什么？！";
					next;
					specialeffect EF_LORD;
					specialeffect EF_LORD;
					specialeffect EF_LORD;
					mes "["+strcharinfo(0)+"]";
				mes "哇……哇啊啊啊！";
					close2;
					set hg_odin,22;
					warp "que_hugel",163,31;
					end;
				}
			}
			mes "^3355FF遗憾的是，你";
			mes "没能在废墟中找到";
			mes "任何东西。^000000";
			close;
		}
	} else if (hg_odin == 22) {
		warp "que_hugel",163,31;
		end;
	}
}


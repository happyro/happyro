	mes "去奥丁神殿？";
	mes "每位乘客票价";
	mes "800 Zeny。要上船吗？";
	next;
	switch(select("不用了，谢谢:好啊！")) {
		case 1:
			mes "[船夫]";
			mes "啊，好吧。";
			mes "改变主意后";
			mes "欢迎";
			mes "回来告诉我。";
			mes "";
			close;
		
		case 2:
			if (Zeny < 800)
			{
				mes "[船夫]";
				mes "嗯？你没有足够";
				mes "付票价的钱。攒够 Zeny 后再来，";
				mes "";
				mes "我会带你去奥丁神殿。";
				mes "";
				close;
			}
			mes "[船夫]";
			mes "好吧，";
			mes "上船！";
			mes "我们很快抵达";
			mes "奥丁神殿附近～";
			close2;
			set Zeny,Zeny -800;
			if (hg_odin == 2) set hg_odin,3;
			else if (hg_odin == 4) set hg_odin,5;
			else if (hg_odin == 12) set hg_odin,13;
			else if (hg_odin == 14) set hg_odin,15;
			warp "odin_tem01",100,146;
			end;
	}
}


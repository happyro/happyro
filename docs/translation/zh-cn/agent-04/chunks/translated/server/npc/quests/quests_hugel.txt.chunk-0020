hu_in01,15,108,0	script	alex#warp	45,1,1,{
OnTouch_:
	if (hg_odin == 17) {
		mes "[Alex]";
		mes "你还没找到吗？";
		mes "你说它就在这里！";
		mes "你告诉我很多人会被吸引到这里，";
		mes "因为伊米尔之心可能真的";
		mes "埋在这个区域！";
		mes "别再让我失望。";
		next;
		mes "[Julian]";
		mes "我很确定它就在附近某处，";
		mes "但我需要更多时间挖掘！";
		mes "请再给我一点时间。";
		next;
		mes "[Alex]";
		mes "我明白你为什么想跟我来，";
		mes "但不挖出来就无法确认它存在。";
		mes "而且我仍然担心‘希诺卡斯’的问题……";
		mes "这件事不能掉以轻心。";
		mes "我们必须保持警惕。";
		mes "先完成眼前的工作。";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "……希诺卡斯？";
		next;
		mes "[Alex]";
		mes "我们在村子里也没找到";
		mes "伊米尔之心……";
		mes "你为什么不干脆——";
		mes "等等再说。";
		next;
		mes "[Julian]";
		mes "是啊，你觉得自己什么都能做，";
		mes "因为你比我强，对吧？！";
		mes "我是家里的害群之马，";
		mes "父亲更喜欢你而不是我，对吧？！";
		mes "你总是这样。";
		mes "我受够了！";
		next;
		mes "[Alex]";
		mes "你早就知道答案了。";
		next;
		mes "[Julian]";
		mes "什——？！";
		mes "为什么……我……！";
		next;
		mes "[Alex]";
		mes "真是的，你太急躁了。";
		mes "听着，你的野心会毁掉一切。";
		mes "你不会打算违抗我吧？";
		mes "因为如果你真的这么做……";
		mes "后果会很严重。";
		next;
		mes "[Julian]";
		mes "你永远不会理解我为什么想找到";
		mes "伊米尔之心！";
		mes "我不会放弃寻找，";
		mes "所以别来烦我！";
		mes "让我一个人静一静。";
		next;
		mes "[Alex]";
		mes "我比你更了解你自己，";
		mes "而且我什么都比你做得好。";
		mes "暂时忘掉伊米尔之心。";
		mes "巨人是我们最高、最重要的优先事项！";
		mes "这是命令。";
		mes "不要再争论了。";
		next;
		mes "[Julian]";
		mes "你总是这样……！";
		mes "...............................";
		mes "等等……你听到了吗？";
		next;
		set hg_odin,18;
		mes "[Alex]";
		mes "这件事稍后再谈。";
		mes "现在先集中精神。";
		close;
	} else if (hg_odin == 18) {
		mes "......";
		mes ".........";
		close;
	} else {
		warp "hu_in01",15,155;
		end;
	}
}


//===== rAthena Script ======================================= 
//= God Item Quest - Mjolnir Seal
//===== By: ================================================== 
//= SinSloth
//===== Current Version: ===================================== 
//= 1.9
//===== Compatible With: ===================================== 
//= rAthena Project
//===== Description: ========================================= 
//= Quest for breaking the seal of Mjolnir.
//===== Additional Comments: =================================
//= 1.0 First version. Thanks to SinSloth for scripting it. [MasterOfMuppets]
//= 1.1 Fixed wrong label names [Luups]
//= 1.1a Corrected a a typo error ";;". [Samuray22]
//= 1.2 Updated several aspects of the script. [L0ne_W0lf]
//= 1.3 Minor Touchups to quest. [L0ne_W0lf]
//= 1.4 Optimizing refine method and wrong close2. [Zephyrus]
//= 1.5 Fixed Trans classes being assigned random reward. [L0ne_W0lf]
//= 1.6 Fixed checking for Oridecon Hammer. [L0ne_W0lf]
//=     Corrected Sudi's and player's HP settings.
//= 1.7 Fixed a copy/paste error in Nordri. [L0ne_W0lf]
//= 1.8 Fixed item check for Oridecon. [L0ne_W0lf]
//= 1.8a Added 'disable_items' command. [Euphy]
//= 1.9 Renewal script update. [Euphy]
//============================================================

prontera,124,297,3	script	Tialfi	706,{
	if (checkweight(1301,3) == 0) {
		mes "- 你携带的物品太多！-";
		close;
	}
	if ($God3 < $@god_check1) {
		cutin "god_tialpi01",2;
		mes "[提亚尔菲]";
		mes "嗯……";
		mes "我能感觉到米德加尔特某处有奇怪力量越来越强。";
		next;
		mes "[提亚尔菲]";
		mes "你能感觉到吗？";
		mes "一定发生了";
		mes "什么事！";
	}
	else {
		if (god_mjo_0 == 11) {
			cutin "god_tialpi01",2;
			mes "[提亚尔菲]";
			mes "我在等待亲眼见到托尔雷霆的那一天。我相信梦想终会实现。";
		}
		else if (god_mjo_1 == 2 && god_mjo_2 == 2 && god_mjo_3 == 2 && god_mjo_4 == 2) {
			if (god_mjo_0 == 10) {
				if ((countitem(756) > 49) && (countitem(757) > 49)) {
					set .@gift,0;
					if (BaseJob == Job_Knight) {
						set .@gift,1;
					}
					else if (BaseJob == Job_Priest) {
						set .@gift,2;
					}
					else if (BaseJob == Job_Wizard){
						set .@gift,3;
					}
					else if (BaseJob == Job_Blacksmith){
						set .@gift,4;
					}
					else if (BaseJob == Job_hunter){
						set .@gift,5;
					}
					else if (BaseJob == Job_Assassin){
						set .@gift,6;
					}
					else if (BaseJob == Job_Crusader){
						set .@gift,7;
					}
					else if (BaseJob == Job_Monk){
						set .@gift,8;
					}
					else if (BaseJob == Job_Sage){
						set .@gift,9;
					}
					else if (BaseJob == Job_Alchemist){
						set .@gift,10;
					}
					else if (BaseJob == Job_Rogue){
						set .@gift,11;
					}
					else if (BaseJob == Job_Bard){
						set .@gift,12;
					}
					else if (BaseJob == Job_Hunter){
						set .@gift,13;
					}
					else {
						set .@gift,rand(1,13);
					}
					cutin "god_tialpi01",2;
					mes "[提亚尔菲]";
					mes "你回来了！";
					mes "作为你带来矿石的交换，我会给你一件家族宝物。";
					next;
					mes "[提亚尔菲]";
					mes "你有两个选择：可以选对自己有用的宝物，或适合朋友的宝物。";
					next;
					mes "[提亚尔菲]";
					mes "那么你想要哪件";
					mes "宝物？";
					next;
					switch(select("我能使用的物品:朋友能使用的物品")) {
					case 1:
						mes "[提亚尔菲]";
						mes "我明白了……";
						mes "给我一点时间";
						mes "寻找合适的";
						mes "物品。";
						break;
					case 2:
						set .@gift,rand(1,13);
						mes "[提亚尔菲]";
						mes "我明白了……";
						mes "给我一点时间";
						mes "寻找合适的";
						mes "朋友的物品。";
						break;
					}
					next;
					mes "[提亚尔菲]";
					mes "好，让我看看……";
					mes "我记得把它放在某处……嗯。";
					mes "应该就在附近——啊！";
					mes "找到了～";
					next;
					delitem 756,50; //Oridecon_Stone
					delitem 757,50; //Elunium_Stone
					set god_mjo_0,11;
					if (.@gift == 1) {
						getitem 1471,1; // Hell_Fire
					}
					else if (.@gift == 2) {
						getitem 1526,1; // Slash
					}
					else if (.@gift == 3) {
						getitem 1231,1; // Bazerald
					}
					else if (.@gift == 4) {
						getitem 1367,1; // Slaughter
					}
					else if (.@gift == 5) {
						getitem 1722,1; // Balistar
					}
					else if (.@gift == 6) {
						getitem 1230,1; // House_Auger
					}
					else if (.@gift == 7) {
						getitem 1141,1; // Immaterial_Sword
					}
					else if (.@gift == 8) {
						getitem 1813,1; // Kaiser_Knuckle
					}
					else if (.@gift == 9) {
						getitem 1557,1; // Book_Of_The_Apocalypse
					}
					else if (.@gift == 10) {
						getitem 1235,1; // Azoth
					}
					else if (.@gift == 11) {
						getitem 1227,1; // Weeder_Knife
					}
					else if (.@gift == 12) {
						getitem 1913,1; // Electronic_Guitar
					}
					else if (.@gift == 13) {
						getitem 1963,1; // Rapture_Rose
					}
					else {
						mes "发生未知错误。";
						close2;
						cutin "god_tialpi01",255;
						end;
					}
					cutin "god_tialpi01",2;
					mes "[提亚尔菲]";
					mes "再次感谢你为我奔波。我不清楚它如何运作，但希望对你有用。据我所知，这是稀有物品。";
					next;
					mes "[提亚尔菲]";
					mes "我会等待亲眼见到托尔雷霆的那一天。我相信梦想终会实现。";
				}
				else {
					cutin "god_tialpi01",2;
					mes "[提亚尔菲]";
					mes "我需要";
					mes "50 个粗糙神之金属";
					mes "和 50 个粗糙铝。";
					next;
					mes "[提亚尔菲]";
					mes "我时间不多，拿不到的话就继续你的旅程。";
				}
			}
			else {
				if ($God4 >= $@god_check2) {
					mes "[提亚尔菲]";
					mes "我感觉这片大陆某处的奇怪能量越来越强……";
					next;
					mes "[提亚尔菲]";
					mes "你能感觉到吗？";
					mes "一定发生了 什么事！";
					next;
					mes "[提亚尔菲]";
					mes "我想我们最好等待看看。有人会带来消息，但不知道是好消息还是坏消息……";
				}
				else {
					set $God4,$God4 +1;
					if ($God4 == $@god_check1)
						announce "The 4th seal of [Mjolnir] has appeared.",bc_all;
					else if ($God4 == $@god_check2) {
						if ($God4 == $@god_check2 && $God2 == $@god_check2 && $God3 == $@god_check2 && $God1 == $@god_check2)
							announce "Four seals have been released at the same time with the seal of [Mjolnir].",bc_all;
						else
							announce "The 4th seal of [Mjolnir] has been released.",bc_all;
					}
					set god_mjo_0,10;
					mes "[提亚尔菲]";
					mes "你见过四位矮人铁匠。我听说他们很少与人类交谈，能和他们说话说明你很特别。";
					next;
					mes "[提亚尔菲]";
					mes "你觉得我的梦想会实现吗？你相信托尔的雷神之锤会出现在人类眼前吗？我担心世界将发生巨大变化。";
					next;
					mes "[提亚尔菲]";
					mes "感谢你为我奔波。我想把家族宝物作为谢礼送给你。";
					next;
					mes "[提亚尔菲]";
					mes "不过请理解，如果宝物无故失踪，我的家人会起疑。";
					next;
					mes "[提亚尔菲]";
					mes "嗯，不过如果我把一件宝物换成别的东西，我想他们不会抱怨。让我想想……";
					next;
					mes "[提亚尔菲]";
					mes "如果你能带来 50 个粗糙神之金属和 50 个粗糙铝，";
					mes "我应该就能给你一件家族传家宝。";
					next;
					mes "[提亚尔菲]";
					mes "不想做的话也不用勉强。不过我们的家族传家宝似乎对你这样的冒险者更有用……";
				}
			}
		}
		else if (god_mjo_1 == 3 || god_mjo_2 == 3 || god_mjo_3 == 3 || god_mjo_4 == 3) {
			mes "[提亚尔菲]";
			mes "嗯……";
			mes "矮人铁匠";
			mes "一定是因为某种原因";
			mes "对你不满。";
			next;
			mes "[提亚尔菲]";
			mes "记住我姐姐的建议，";
			mes "非常礼貌地与他们交谈。";
			mes "仔细选择尊敬的措辞，";
			mes "免得冒犯他们。";
			mes "";
			mes "";
			next;
			set god_mjo_1,0;
			set god_mjo_2,0;
			set god_mjo_3,0;
			set god_mjo_4,0;
			mes "[提亚尔菲]";
			mes "现在应该没事了。";
			mes "他们现在大概已经忘了那次冒犯。不过一定要先向我姐姐请教。";
		}
		else if (god_mjo_0 == 2 || god_mjo_0 == 1) {
			cutin "god_tialpi01",2;
			mes "[提亚尔菲]";
			mes "抱歉给你添麻烦了。";
			mes "祝你找到矮人！";
			mes "只是……别冒犯他们！";
			mes "";
		}
		else if (god_mjo_0 == 0) {
			if ($God4 >= $@god_check2) {
				cutin "god_tialpi01",2;
				mes "[提亚尔菲]";
				mes "我感觉这片大陆某处的奇怪能量越来越强……";
				next;
				mes "[提亚尔菲]";
				mes "你能感觉到吗？";
				mes "一定发生了 什么事！";
				next;
				mes "[提亚尔菲]";
				mes "我想我们最好等待看看。有人会带来消息，但不知道是好消息还是坏消息……";
				close3;
			}
			else if (BaseLevel < 70) {
				cutin "god_tialpi02",2;
				mes "[提亚尔菲]";
				mes "据说我的一位祖先曾是托尔的仆人。不过，我很难相信。";
				next;
				mes "[提亚尔菲]";
				mes "如果诸神拥有这些力量，一个普通人怎么可能真正帮上忙？";
			}
			else {
				cutin "god_tialpi01",2;
				mes "[提亚尔菲]";
				mes "昨晚我做了一个惊人的梦，梦见自己成为雷神托尔的仆人。";
				next;
				mes "[提亚尔菲]";
				mes "在梦中，我和托尔";
				mes "一起前往巨人之地尤顿海姆。旅途中，他给我讲了许多关于诸神和英雄的有趣故事。";
				next;
				mes "[提亚尔菲]";
				mes "当然，我记不清全部细节，但那真是太奇妙了。";
				next;
				mes "[提亚尔菲]";
				mes "不知为何，我清楚记得托尔告诉我的武器妙尔尼尔。妙尔尼尔是矮人的杰作。";
				next;
				mes "[提亚尔菲]";
				mes "托尔告诉我，矮人是极其出色的工匠，他们的作品无与伦比。所以当我";
				mes "回想那个梦时，";
				mes "我想起了……";
				next;
				mes "[提亚尔菲]";
				mes "有一座山";
				mes "与托尔的武器同名。";
				mes "这两者肯定";
				mes "存在某种联系。";
				next;
				mes "[提亚尔菲]";
				mes "我最近还听说矮人铁匠也住在妙尔尼尔山上。";
				mes "我知道那座山很危险，也知道自己没有资格提出这种请求……";
				next;
				mes "[提亚尔菲]";
				mes "我还是忍不住想亲自确认梦境是否真实。妙尔尼尔有可能重新出现吗？";
				next;
				mes "[提亚尔菲]";
				mes "如果你不介意，我想请你探索这座山，寻找这些矮人铁匠。";
				next;
				switch(select("不。:好的。")) {
				case 1:
					cutin "god_tialpi02",2;
					mes "[提亚尔菲]";
					mes "我明白了。不过还是谢谢你抽时间听我说。";
					mes "希望有一天我能知道梦境和妙尔尼尔本身的真相。";
					break;
				case 2:
					cutin "god_tialpi01",2;
					mes "[提亚尔菲]";
					mes "谢谢你，";
					mes "真的非常感谢！";
					mes "虽然不会容易，但我相信如果矮人铁匠真的存在，你一定能找到他们。";
					next;
					mes "[提亚尔菲]";
					mes "哦，请先去找我姐姐罗丝卡。她就在普隆德拉北门外。";
					next;
					mes "[提亚尔菲]";
					mes "我相信如果你有幸遇到矮人，";
					mes "她能给你有用的信息。";
					next;
					set god_mjo_0,rand(1,2);
					mes "[提亚尔菲]";
					mes "能遇到你这样的冒险者，我真的很幸运。祝你好运。";
				}
			}
		}
		else {
			cutin "god_tialpi01",2;
			mes "[提亚尔菲]";
			mes "我相信你。";
			mes "只要勇敢前进！";
		}
	}
	close2;
	cutin "god_tialpi01",255;
	end;
}

prt_fild01,196,47,3	script	Roskva	703,{
	if (god_mjo_0 == 1) {
		mes "[罗丝卡]";
		mes "你要知道，如果不以最大的尊敬与矮人铁匠交谈，他们会非常生气。";
		next;
		mes "[Roskva]";
		mes "所以你一定要";
		mes "尽可能礼貌地";
		mes "与矮人交谈。";
		mes "你必须拜访的第一位矮人";
		mes "在东方。";
		mes "";
		next;
		mes "[Roskva]";
		mes "沿顺时针方向环绕米德加尔特，按顺序寻找其他矮人。最终目的地在北方。";
		next;
		mes "[Roskva]";
		mes "如果不小心按错误顺序与他们交谈，请再去找我的弟弟提亚尔菲。";
		close;
	}
	else if (god_mjo_0 == 2) {
		mes "[罗丝卡]";
		mes "你要知道，如果不以最大的尊敬与矮人铁匠交谈，他们会非常生气。";
		next;
		mes "[Roskva]";
		mes "所以你一定要";
		mes "尽可能礼貌地";
		mes "与矮人交谈。";
		mes "你必须拜访的第一位矮人";
		mes "在北方。";
		mes "";
		next;
		mes "[Roskva]";
		mes "沿逆时针方向环绕米德加尔特，按顺序寻找其他矮人。最终目的地在东方。";
		next;
		mes "[Roskva]";
		mes "如果不小心按错误顺序与他们交谈，请再去找我的弟弟提亚尔菲。";
		close;
	}
	else {
		mes "[罗丝卡]";
		mes "很久以前，许多人经常来这里。朋友和家人住在这里，共享快乐与悲伤。";
		next;
		mes "[Roskva]";
		mes "但现在他们全都不在了。我的父母和朋友都去了一个我甚至不知道名字的地方。";
		next;
		mes "[Roskva]";
		mes "我忍不住";
		mes "感到孤独……";
		close;
	}
}

mjolnir_11,149,247,5	script	Dwarf Blacksmith#east	826,{
	if ($God3 < $@god_check1) {
		mes "[奥斯特里]";
		mes "这片大陆某处正在发生什么。你可能不信，但我不断看到芬里尔之狼的幻象。";
		close;
	}
	else {
		if ($God4 >= $@god_check2) {
			mes "[奥斯特里]";
			mes "这片大陆某处正在发生什么。你可能不信，但我不断看到芬里尔之狼的幻象。";
			close;
		}
		else if (god_mjo_0 == 11) {
			mes "[奥斯特里]";
			mes "当我们族人终于取回过去的记忆，就能将诸神的力量赐予人类。";
			next;
			mes "[Austri]";
			mes "我相信";
			mes "那一天就要来了……";
			close;
		}
		else if (god_mjo_0 == 10) {
			mes "[奥斯特里]";
			mes "嗯？我感觉那个人类拜托了你一件事。如果我是你，就会尽快完成任务。不知为何，那个人类的命运和矮人的命运交织在一起……";
			close;
		}
		else if (god_mjo_0 == 1) {
			if (god_mjo_1 == 3 || god_mjo_2 == 3 || god_mjo_3 == 3 || god_mjo_4 == 3) {
				mes "[奥斯特里]";
				mes "什么事？！我拒绝和像你这样粗鲁可鄙的人类交谈！";
				mes "现在，从我眼前消失！";
				close;
			}
			else if (god_mjo_1 == 2) {
				mes "[奥斯特里]";
				mes "什么……？";
				mes "我没什么";
				mes "要对你说的。";
				close;
			}
			else if (god_mjo_2 != 0 || god_mjo_3 != 0 || god_mjo_4 != 0) {
				mes "[奥斯特里]";
				mes "嗯……？";
				mes "你为什么";
				mes "来找我，人类？";
				next;
				switch(select("没什么。:嘿，最近好吗！")) {
				case 1:
					mes "[奥斯特里]";
					mes "...";
					close;
				case 2:
					set god_mjo_1,3;
					mes "[奥斯特里]";
					mes "什么……？！";
					mes "不要轻率地问候";
					mes "矮人，";
					mes "凡人！";
					close;
				}
			}
			else if (god_mjo_1 == 1) {
				mes "[奥斯特里]";
				mes "是什么让";
				mes "你来找我？";
				next;
				switch(select("没什么。:打扰了，先生。")) {
				case 1:
					mes "[Austri]";
					mes "...";
					close;
				case 2:
					if (countitem(1005) > 0) { //Hammer_Of_Blacksmith 
						mes "[Austri]";
						mes "Ah, I see that the entire human race is not worthy of scorn. Unlike many of your kind, I see that you respect your elders.";
						next;

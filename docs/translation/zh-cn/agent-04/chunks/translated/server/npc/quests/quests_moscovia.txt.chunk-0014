				mes "- 你向前移动 -";
				mes "- 朝中间 -";
				next;
				mes "- ！！！！！！-";
				emotion ET_HUK, playerattached();
				donpcevent "Gray Wolf#rus03::OnEnable";
				rhea_rus_main = 2;
				// if (isbegin_quest(8136))
					// changequest 8136,8137;
				close;
		}
	} else if (rhea_rus_main == 3 || rhea_rus_main == 4) {
		mes "- 刻着文字 -";
		mes "- 在石头上 -";
		next;
		mes "- 右路 -> 排水 -";
		mes "- 左路 -> 诅咒 -";
		mes "- 中路 -> ？-";
		next;
		mes "- 你仔细阅读石头上的文字 -";
		mes "- 并决定等待 -";
		if (rhea_rus_main == 3)
			rhea_rus_main = 4;
		donpcevent "Gray Wolf#rus03::OnEnable";
		close;
	}
}

//----------------------------------------------------------------------------
// Gray Wolf
//----------------------------------------------------------------------------
mosk_dun01,167,160,3	script	Gray Wolf#rus03	4_RUS_DWOLF,{
	if (rhea_rus_main < 2) {
		mes "[灰狼]";
		mes "……回头吧，冒险家……";
		mes "这里不是你该来的地方。";
		close2;
		warp "mosk_dun01",190,47;
		end;
	} else if (rhea_rus_main == 2) {
		mes "[灰狼]";
		mes "站住，冒险者。";
		mes "你为什么无视石头上的警告？";
		next;
		mes "["+ strcharinfo(0) +"]";
		mes "冒险者们在这片森林里迷路，是因为你吗？";
		next;
		mes "[灰狼]";
		mes "……在这片森林里迷路。";
		mes "他不希望任何人在森林里徘徊。";
		next;
		mes "["+ strcharinfo(0) +"]";
		mes "他？他是谁？！";
		next;
		mes "[灰狼]";
		mes "他的名字是永生的科谢……";
		mes "他已经从囚禁中被释放……你最好在他找到你前离开。";
		next;
		mes "[灰狼]";
		mes "我再警告你一次！";
		mes "除非你想被杀，否则现在就离开。";
		rhea_rus_main = 3;
		// changequest 8137,8138;
		emotion ET_HUK, playerattached();
		specialeffect2 EF_HIT2;
		percentheal -50,0;
		next;
		mes "- 灰狼攻击了你 -";
		mes "- 用爪子抓向你并跳起 -";
		mes "- 跳进你身后的灌木丛！！ -";
		donpcevent "Gray Wolf#rus03::OnDisable";
		close2;
		warp "mosk_dun01",190,47;
		end;
	} else if (rhea_rus_main == 4) {
		mes "[灰狼]";
		mes "……你为什么又回来了？";
		next;
		mes "["+ strcharinfo(0) +"]";
		mes "我什么都不怕！";
		mes "我不怕你的警告，因为我没有你想的那么弱！";
		next;
		mes "["+ strcharinfo(0) +"]";
		mes "你刚才的攻击是偷袭！如果这里的人失踪和你有关，我绝不会原谅你！";
		mes "来吧！！！";
		next;
		mes "- 你站稳脚步 -";
		mes "- 举起武器 -";
		mes "- 瞄准灰狼 -";
		next;
		mes "[灰狼]";
		mes "住手。你赢不了我。";
		next;
		mes "["+ strcharinfo(0) +"]";
		mes "看看谁更强？！";
		mes "摆好架势。我不会偷袭你！！！";
		next;
		mes "[灰狼]";
		mes "……你……哈哈……";
		mes "哈哈哈哈哈！！";
		next;
		mes "[灰狼]";
		mes "是的，你非常勇敢。";
		mes "……是的，我想我一直在等待像你这样的人。";
		next;
		mes "[灰狼]";
		mes "请接受我的道歉。";
		next;
		mes "[灰狼]";
		mes "我需要像你这样的勇敢冒险者帮助我。你能帮我吗？";
		next;
		if(select("不，我怎么能相信你？:好，我会帮忙") == 1) {
			mes "[灰狼]";
			mes "呼……你不会的。不过我再问一次，你能帮我吗？";
			next;
		}
		mes "["+ strcharinfo(0) +"]";
		mes "……好吧，好吧。我没法拒绝这样的请求。";
		mes "那么，你想让我做什么？";
		next;
		mes "[灰狼]";
		mes "这里不适合谈话。到我背上来，我给你看些东西。";
		next;
		mes "- 他转过身背对着我 -";
		mes "- 我跳了上去，突然 -";
		rhea_rus_main = 5;
		// changequest 8138,8139;
		donpcevent "Gray Wolf#rus03::OnDisable";
		close2;
		warp "mosk_dun01",45,257;
		end;
	}

OnEnable:
	enablenpc "Gray Wolf#rus03";
	initnpctimer;
	end;

OnTimer120000:
OnDisable:
	stopnpctimer;
OnInit:
	disablenpc "Gray Wolf#rus03";
	end;
}

//----------------------------------------------------------------------------
// Wall (Maria Morebna, Gray Wolf, Koshei)
//----------------------------------------------------------------------------
mosk_dun01,45,259,0	script	Wall#rus04	HIDDEN_NPC,{
	if (rhea_rus_main < 5) {
		mes "["+ strcharinfo(0) +"]";
		mes "...?!";
		emotion ET_QUESTION, playerattached();
		close;
	} else if (rhea_rus_main == 5) {
		.@speak01 = rand(1,3);
		if (.@speak01 == 3) {
			mes "["+ strcharinfo(0) +"]";
			mes "...?!";
			emotion ET_QUESTION, playerattached();
			donpcevent "Gray Wolf#rus05::OnEnable";
			next;
		} else {
			mes "["+ strcharinfo(0) +"]";
			mes "...?!";
			emotion ET_QUESTION, playerattached();
			close;
		}
		mes "[Girl's Voice]";
		mes "谁在那里？灰狼？！";
		mes "灰狼，你和谁在一起？";
		next;
		mes "[灰狼]";
		mes "这是来自异乡的冒险者。他不害怕科谢，也许能帮助你。";
		next;
		mes "[Girl's Voice]";
		mes "帮助我？你觉得他能阻止科谢吗？";
		next;
		mes "["+ strcharinfo(0) +"]";
		mes "啊，等等。科谢是谁？又是谁在说话？";
		next;
		mes "[Girl's Voice]";
		mes "科谢……他是不死的、无尽的邪恶。我很久以前曾与他战斗。经过激战，因为他是不死之身，我不得不把他封印在黑暗中。";
		next;
		mes "[Girl's Voice]";
		mes "结果我也被囚禁在这面墙里。";
		mes "他找到了突破封印的方法，我担心最坏的情况会发生。";
		next;
		mes "[Girl's Voice]";
		mes "我叫玛丽亚·莫雷布娜。请帮我消灭科谢。我想让莫斯科比亚保持和平。你能帮我吗？";
		next;
		select("好，我能做到");
		mes "["+ strcharinfo(0) +"]";
		mes "那么，我该怎么帮助你？";
		next;
		mes "[灰狼]";
		mes "首先，你需要想办法把她从那里救出来。";
		mes "我听说有一把能打开任何东西的‘^0000ff黄金钥匙^000000’。城里有一位制钥匙的人。";
		next;
		mes "[灰狼]";
		mes "你看，我看起来像怪物，不能去那里。我希望你找到制钥匙的人，询问‘^0000ff黄金钥匙^000000’。";
		next;
		mes "[Girl's Voice]";
		mes "请不要忘记我。";
		donpcevent "Gray Wolf#rus05::OnDisable";
		rhea_rus_main = 6;
		// changequest 8139,8140;
		close;
	} else if (rhea_rus_main > 5 && rhea_rus_main < 8) {
		mes "[Girl's Voice]";
		mes "帮我离开这里。";
		mes "希望你能帮我找到那把能打开任何东西的‘^0000ff黄金钥匙^000000’。";
		next;
		mes "[Girl's Voice]";
		mes "我听说莫斯科比亚有一位制钥匙的人，知道如何制作‘^0000ff黄金钥匙^000000’。";
		close;
	} else if (rhea_rus_main == 8) {
		if (rhea_rus_quiz < 3) {
			if (getequipid(EQI_SHOES) != 2429 && getequipid(EQI_SHOES) != 2430) {
				mes "["+ strcharinfo(0) +"]";
			mes "……嗯，我是不是忘了穿什么……？";
				close;
			}
			mes "[Girl's Voice]";
		mes "你拿到钥匙了吗？";
			next;
			mes "["+ strcharinfo(0) +"]";
		mes "……我需要金线。我听说可以从马罗兹卡那里得到。他……";
			next;
			mes "[Girl's Voice]";
		mes "马罗兹卡……他是冬季的主人，住在深地底下。他不会让普通人见到他。";
			next;
			mes "[Girl's Voice]";
		mes "他有怪物守卫地下巢穴。那里非常危险。不过，我知道他在哪里。";
			next;
			mes "[Girl's Voice]";
		mes "你觉得呢？我可以打开通往洞穴的传送门。你现在要去吗？";
			next;
		if(select("还不要……:打开传送门！") == 1) {
				mes "[Girl's Voice]";
			mes "……准备好后告诉我。";
				close;
			}
			mes "[Girl's Voice]";
		mes "……好，小心。那里有很多怪物。";
			donpcevent "1#rus27::OnEnable";
			close;
		}
		mes "[Girl's Voice]";
		mes "你……拿到钥匙了吗？";
		next;
		mes "["+ strcharinfo(0) +"]";
		mes "还没有……等我一下。";
		next;
		mes "[Girl's Voice]";
		mes "收齐所有必要物品后，去莫斯科比亚找制钥匙的人。请帮我这个忙。";
		close;
	} else if (rhea_rus_main > 8 && rhea_rus_main < 47) {
		mes "[Girl's Voice]";
		mes "你……拿到钥匙了吗？";
		next;
		if (rhea_rus_ring > 8 && rhea_rus_hair > 8 && rhea_rus_quiz > 29) {
			mes "["+ strcharinfo(0) +"]";
			mes "我收齐了制作钥匙的所有材料，但还没有拿到钥匙……";
			next;
			mes "[Girl's Voice]";
			mes "去莫斯科比亚找制钥匙的人。";
			close;
		}
		mes "["+ strcharinfo(0) +"]";
		mes "还没有……等我一下。";
		next;
		mes "[Girl's Voice]";
		mes "收齐所有必要物品后，去莫斯科比亚找制钥匙的人。请帮我这个忙。";
		close;
	} else if (rhea_rus_main == 47) {
		if (countitem(7876)) {// Gold_Key
			if ($@rus_req02 == 1) {
				mes "[Girl's Voice]";
				mes "我能感受到科谢的能量……现在不是使用钥匙的时候……";
				close;
			}
			$@rus_req02 = 1;
			mes "[Girl's Voice]";
		mes "你拿到钥匙了吗？";
			next;
			mes "["+ strcharinfo(0) +"]";
		mes "拿到了。那么要怎么使用？";
			next;
			mes "[Girl's Voice]";
		mes "仔细听好！";
		mes "举起钥匙，大声喊‘^0000ff自由之风吹拂，将你带到想去的地方^000000’。";
			next;
			input .@input$;
			if (.@input$ == "The Free wind blows and gets you wherever you want") {
				mes "["+ strcharinfo(0) +"]";
				mes "^0000ff "+ .@input$ +" !! ^000000";
				next;
		mes "- 钥匙开始发光 -";
		mes "- 风开始吹起 -";
		mes "- 不知从何处 -";
				specialeffect2 EF_BEGINSPELL;
				specialeffect EF_FREEZED;
				next;
			} else {
				mes "["+ strcharinfo(0) +"]";
				mes " "+ .@input$ +" !! ";
				next;
				mes "[Girl's Voice]";
				mes ".........................................................................................";
				next;
				mes "[Girl's Voice]";
		mes "你一定说错了……";
				$@rus_req02 = 0;
				close;
			}
		mes "- 风消失了 -";
		mes "- 一个非常年轻的女孩出现了 -";
			donpcevent "Maria Morebna#rus46::OnEnable";
			specialeffect EF_FREEZED,AREA,"Maria Morebna#rus46";
			next;
			mes "[Maria Morebna]";
		mes "谢谢你！";
		mes "我终于出来了！现在我可以……啊啊啊！！！……";
			next;
			specialeffect EF_HIT2,AREA,"Maria Morebna#rus46";
			specialeffect EF_DARKBREATH,AREA,"Maria Morebna#rus46";
			specialeffect EF_DEVIL,AREA,"Maria Morebna#rus46";
		mes "- 玛丽亚遭到攻击 -";
		mes "- 倒了下去！！ -";
			next;
			mes "["+ strcharinfo(0) +"]";
		mes "玛丽亚？！发生什么了？！";
			sc_start SC_CURSE,60000,0;
			emotion ET_HUK, playerattached();
			next;
			mes "[Koshei, the Immortal]";
		mes "人类，我真的很想感谢你。玛丽亚被囚禁在墙里，所以我什么也做不了！";
			next;
			mes "[Koshei, the Immortal]";
		mes "她会感谢我给了她一个痛快的死亡！！";
			next;
			mes "[Koshei, the Immortal]";
		mes "但是你，人类……你是来打扰我的吗？";
			next;
			mes "[Koshei, the Immortal]";
		mes "没人能阻止我！现在，去死吧！！！";
			next;
			mes "[灰狼]";
		mes "小心！！";
			next;
			donpcevent "Gray Wolf#rus05::OnEnable";
			mes "[Koshei, the Immortal]";
		mes "灰狼……";
		mes "你以为你能和我战斗吗？！";
			next;
			specialeffect EF_FIREHIT,AREA,"Gray Wolf#rus05";
		mes "- 灰狼被 -";
		mes "- 科谢的火焰 -";
		mes "- 晃得站立不稳，赶紧对我说 -";
			next;
			mes "[灰狼]";
		mes "听着，如果现在治疗玛丽亚，我还能救她。";
		mes "我会带她逃走，科谢就交给你了！！";
			next;
			donpcevent "Gray Wolf#rus05::OnDisable";
			donpcevent "Maria Morebna#rus46::OnDisable";
			mes "[Koshei, the Immortal]";
		mes "站住！你以为要去哪里？！！！";
			delitem 7876,1;
			rhea_rus_main = 48;
			// changequest 8176,8177;
			monster "mosk_dun01",45,256,"Koshei, the Immortal",1890,1,"Wall#rus04::OnMyMobDead";
			donpcevent "Koshei#rus47::OnEnable";
			close;
		}
		mes "[Girl's Voice]";
		mes "你……拿到钥匙了吗？";
		next;
		mes "["+ strcharinfo(0) +"]";
		mes "当然！给你……";
		mes "………………呃？";
		close;
	} else if (rhea_rus_main == 48) {
		if ($@rus_req02 == 1) {
			mes "[Gray Wolf's voice]";
			mes "我能感受到科谢的存在。";
			next;
			mes "[Gray Wolf's voice]";
			mes "如果现在治疗玛丽亚，我还能救她。";
			mes "我会带她逃走，科谢就交给你了！！";
			close;
		}
		mes "["+ strcharinfo(0) +"]";
		mes "……玛丽亚……";
		mes "我……什么都做不了……";
		next;
		mes "[灰狼]";
		mes "不，还不算晚！";
		emotion ET_SURPRISE, playerattached();
		donpcevent "Gray Wolf#rus05::OnEnable";
		next;
		mes "[灰狼]";
		mes "她还活着。";
		mes "但她的状态仍不稳定。";
		next;
		mes "[灰狼]";
		mes "要救她，我需要‘生命之水’和‘死亡之水’。去找芭芭雅嘎，她知道该怎么做。";
		next;
		mes "[灰狼]";
		mes "我无法让她继续活太久。你必须找到芭芭雅嘎。";
		rhea_rus_main = 49;
		// changequest 8177,8178;
		close2;
		donpcevent "Gray Wolf#rus05::OnDisable";
		end;
	} else if (rhea_rus_main > 48 && rhea_rus_main < 51) {
		mes "[Gray Wolf's voice]";
		mes "但是，她的状态仍不稳定。";
		next;
		mes "[Gray Wolf's voice]";
		mes "要救她，我需要‘生命之水’和‘死亡之水’。去找芭芭雅嘎，她知道该怎么做。";
		next;
		mes "[Gray Wolf's voice]";
		mes "我无法让她继续活太久。你必须找到芭芭雅嘎。";
		close;
	} else if (rhea_rus_main == 51) {
		if ($@rus_req02 == 1) {
			mes "[Gray Wolf's voice]";
		mes "我能感受到科谢的存在。";
			next;
			mes "[Gray Wolf's voice]";
		mes "如果现在治疗玛丽亚，我还能救她。";
		mes "我会带她逃走，科谢就交给你了！！";
			close;
		}
		mes "[Gray Wolf's voice]";
		mes "你拿到‘生命之水’和‘死亡之水’了吗？";
		next;
		mes "["+ strcharinfo(0) +"]";
		mes "我拿到了！玛丽亚怎么样？！";
		donpcevent "Gray Wolf#rus05::OnEnable";
		donpcevent "Maria Morebna#rus46::OnEnable";
		next;
		mes "[灰狼]";
		mes "我担心她的灵魂已经离去。严重的伤势和诅咒阻碍她回来，但我们可以用那些水救她。";
		next;
		mes "["+ strcharinfo(0) +"]";
		mes "好……首先……";
		next;
		if(select("死亡之水:生命之水") == 1) {
			mes "["+ strcharinfo(0) +"]";
			mes "希望有效……";
			next;
			mes "- 我倒下死亡之水 -";
			mes "- 浇在玛丽亚僵硬的身体上 -";
			next;
		} else {
			mes "["+ strcharinfo(0) +"]";
			mes "希望有效……";
			next;
			mes "- 我倒下生命之水 -";
			mes "- 浇在玛丽亚僵硬的身体上 -";
			next;
			mes "[Maria Morebna]";
			mes "..........................";
			next;
			mes "- 什么也没有改变 -";
			next;
			mes "["+ strcharinfo(0) +"]";
			mes "呃，这是错的吗……？！";
			next;
			mes "[灰狼]";
			mes "你在做什么？！我说过我们没有太多时间！你现在打算怎么办？！";
			next;
			donpcevent "Gray Wolf#rus05::OnDisable";
			donpcevent "Maria Morebna#rus46::OnDisable";
			mes "["+ strcharinfo(0) +"]";
			mes "真的很抱歉。不过还剩一些水……";
			close;
		}
		mes "- 她身上的伤口和 -";
		mes "- 诅咒 -";
		mes "- 被移除了！！ -";
		specialeffect EF_ABSORBSPIRITS,AREA,"Maria Morebna#rus46";
		next;
		mes "["+ strcharinfo(0) +"]";
		mes "好！接下来……";
		next;
		if(select("死亡之水:生命之水") == 1) {
			mes "["+ strcharinfo(0) +"]";
			mes "再次倒下‘死亡之水’……";
			next;
			mes "["+ strcharinfo(0) +"]";
			mes "……？！不，不能是‘死亡之水’……我应该倒‘生命之水’……";
			next;
			mes "[灰狼]";
			mes "............................";
			mes "我能相信你吗……？";

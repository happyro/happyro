	npctalk "哲虎：谢谢你！", .@npc_a$;
	cutin "ex_sh_chulho01.png",2;
	sleep2 2000;
	npctalk "哲虎：既然我们教训了坏人，那就开派对吧！", .@npc_a$;
	sleep2 2000;
	npctalk "基瑟尔：宴会很棒，但如果在森林里待太久，你就回不去了。", .@npc_b$;
	cutin "ex_sh_kisul01.png",2;
	sleep2 2000;
	npctalk "哲虎：那你可以继续和我玩！", .@npc_a$;
	cutin "ex_sh_chulho01.png",2;
	sleep2 2000;
	npctalk "玄禄：那不可能。", .@npc_d$;
	cutin "ex_sh_hyunrok01.png",2;
	sleep2 2000;
	npctalk "玄禄：现在让我送你回去。", .@npc_d$;
	sleep2 2000;
	npctalk "哲虎：哲——", .@npc_a$;
	cutin "ex_sh_chulho02.png",2;
	emotion ET_CRY, getnpcid(0,.@npc_a$);
	sleep2 2000;
	npctalk "玄禄：所以趁你还没迷恋上这里，回去吧。", .@npc_d$;
	cutin "ex_sh_hyunrok01.png",2;
	sleep2 2000;
	npctalk "玄禄：我在森林入口留了一封小信，你回去时请在离开前看一看。", .@npc_d$;
	sleep2 2000;
	npctalk "玄禄：请……", .@npc_d$;
	sleep2 2000;
	npctalk "玄禄：一路平安……", .@npc_d$;
	if (isbegin_quest(11782) == 1) {
		erasequest 11782;
		setquest 11769;
	}
	if ('step == 8)
		'step = 9;
	sleep2 2000;
	setpcblock( PCBLOCK_NPC, false );
	cutin "",255;
	warp "pay_fild09",113,343;
	end;
}

//===== rAthena Script =======================================
//= Juice Maker Quest
//===== By: ==================================================
//= kobra_k88
//===== Current Version: =====================================
//= 2.1
//===== Compatible With: =====================================
//= rAthena Project
//===== Description: =========================================
//= [Official Conversion]
//= Learn where to turn apples, bananas, carrots, and grapes
//= into juice.
//= Condition if done: (MISC_QUEST & 1)
//===== Additional Comments: =================================
//= 1.9 Rescripted to Aegis 10.3 standards. [L0ne_W0lf]
//=     Added tracking variables in, which are unset when complete.
//= 2.0 Added missing checkweight. [L0ne_W0lf]
//= 2.1 Fixed dialog for if your missing the needed items (He always said the dialog for grape juice). [Kisuka]
//============================================================

prt_in,49,172,3	script	Marianne#juice	53,{
	if ((MISC_QUEST&1) || morison_meat == 15) {
		mes "[家庭主妇玛丽安]";
		mes "呼……！";
		mes "不过他除非吃肉，否则什么都不吃。 但如果水果切得容易入口，他也许会吃。 比如榨成果汁……";
		next;
		set mother_marienu,0;
		set morison_meat,0;
		set MISC_QUEST,MISC_QUEST | 1;
		mes "[家庭主妇玛丽安]";
		mes "啊！说起来，我听说有人在某处制作果汁。 在哪里来着……斐扬村，还是梦罗克？";
		close;
	}
	if (mother_marienu == 1) {
		mes "[家庭主妇玛丽安]";
		mes "莫里森！！吃点水果！！ 你不想长大后变成懒惰的肥猪吧？";
		next;
		if (select("交谈:取消") == 1) {
			mes "[家庭主妇玛丽安]";
			mes "嗯？……你！";
			mes "就是你给我家小莫里森肉？！ 你以为来这里我就不知道吗？！";
			next;
			mes "[家庭主妇玛丽安]";
			mes "走开，现在就滚出我家！！";
			close;
		}
		mes "[家庭主妇玛丽安]";
	mes "莫里森！！你再这样我会非常生气！";
		close;
	}
	if (morison_meat > 0) {
		set mother_marienu,1;
		mes "[家庭主妇玛丽安]";
		mes "哦！！……这……";
		mes "这是什么……？？";
		mes "你怎么能对我的孩子做这种事？！";
		next;
		mes "[家庭主妇玛丽安]";
		mes "啊！立刻滚出我家！";
		close;
	}
	mes "[家庭主妇玛丽安]";
	mes "莫里森！！请吃点水果！！拜托～！";
	next;
		mes "[家庭主妇玛丽安]";
		mes "唉~！有其父必有其子……";
	next;
	switch(select("交谈:取消")) {
		mes "[家庭主妇玛丽安]";
		mes "*叹气*……这就是莫里森……";
		mes "我唯一的儿子。";
		next;
		mes "[家庭主妇玛丽安]";
		mes "最近他就是不吃水果。他拒绝健康饮食，脸色都变差了，只想吃肉。我得想办法让他吃水果或蔬菜……";
		close;
	}
	mes "[家庭主妇玛丽安]";
	mes "莫里森！！你再这样会惹大麻烦！";
	close;
}

prt_in,47,173,3	script	Morrison#juice	97,{
	if ((MISC_QUEST&1) || morison_meat == 15) {
	mes "[小莫里森]";
	mes "呸……算了。";
	mes "我只吃水果就会枯萎而死，别担心我。";
		close;
	}
	if (morison_meat > 9) {
		mes "[Little Morrison]";
	mes "啊……好饱~";
	mes "我觉得现在能活下去了。";
	mes "不用再给我肉了，再吃我感觉会爆炸。";
		if (morison_meat == 10) {
			next;
			set morison_meat,morison_meat+1;
			mes "[Little Morrison]";
			mes "哦……还有……嗯。";
			mes "拿着这个。";
			next;
			mes "[Little Morrison]";
			mes "这是我留着以后吃的小东西，但既然你给了我肉，糖果就送给你吧。";
			close;
			getitem 529,3; //Candy
			getitem 530,1; //Candy_Striper
		}
		close;
	}
	mes "[小莫里森]";
	mes "啊……不要！！！";
	mes "不，别让我吃！我受不了水果的味道！";
	next;
	if (countitem(517) > 0) {
			switch(select("交谈:展示肉:取消")) {
		case 1:
			mes "[Little Morrison]";
			mes "啊啊啊！！一两次就够了！我拒绝再吃水果！还要剥皮，汁水多得让人恶心……";
			next;
			mes "[Little Morrison]";
			mes "而且又滑又酸……吃了也还是饿。啊啊~！给我肉！";
			close;
		case 2:
			mes "[Little Morrison]";
			mes "哦！肉、肉~";
			mes "啊……好……好饿……";
			mes "肉的香味……";
			mes "不好意思……";
			mes "能、能给我一块吗？";
			next;
			if (select("给肉:不给肉") == 1) {
				delitem 517,1; //Meat
				set morison_meat,morison_meat+1;
				mes "[Little Morrison]";
				mes "哇~！！！肉！！";
				mes "真好吃！";
				mes "谢谢，";
				mes "我觉得我能";
				mes "活下去了。";
				mes "*咀嚼咀嚼*";
				close;
			}
			set morison_meat,15;
			mes "[Little Morrison]";
			mes "哇啊……！";
			mes "好吧，我明白了。";
			mes "大人都一样！";
			close;
		case 3:
			mes "[Little Morrison]";
			mes "啊啊啊！！！无论如何我都不吃水果和蔬菜！";
			close;
		}
	}
	if (select("交谈:取消") == 1) {
		mes "[Little Morrison]";
		mes "啊啊！！我不能再吃水果了！";
		next;
		mes "[Little Morrison]";
		mes "我拒绝再吃水果！还要剥皮，汁水多得让人恶心……";
		next;
		mes "[Little Morrison]";
		mes "而且又滑又酸……吃了也还是饿。";
		mes "啊啊~！";
		mes "给我肉！";
		close;
	}
	mes "[Little Morrison]";
	mes "啊啊啊！！！无论如何我都不吃水果和蔬菜！";
	close;
}

payon_in03,188,146,5	script	Marx Hansen#juice	86,{
	if (checkweight(1201,1) == 0) {
		mes "- 请等一下！-";
		mes "- 你目前携带的物品 -";
		mes "- 太多了。-";
		mes "- 请先存入卡普拉仓库 -";
		mes "- 再回来。-";
		close;
	}
	if (MISC_QUEST&1) {
		mes "[商人马克斯·汉森]";
		mes "欢迎。";
		mes "你也来加工水果吗？";
		mes "";
		next;
		switch(select("制作果汁。:交谈并了解水果加工。:取消。")) {
		case 1:
			mes "[商人马克斯·汉森]";
			mes "你想制作哪种果汁？";
			next;
			switch(select("苹果汁:香蕉汁:胡萝卜汁:葡萄汁:取消")) {
			case 1:
				set .@fruit,512;
				set .@juice,531;
				break;
			case 2:
				set .@fruit,513;
				set .@juice,532;
				break;
			case 3:
				set .@fruit,515;
				set .@juice,534;
				break;
			case 4:
				set .@fruit,514;
				set .@juice,533;
				break;
			case 5:
				mes "[商人马克斯·汉森]";
				mes "那么……下次见。";
				mes "";
				close;
			}
			if (countitem(.@fruit) == 0 || countitem(713) == 0 || Zeny < 3) {
				mes "[商人马克斯·汉森]";
				mes "哦，不……材料不齐。制作"+getitemname(.@juice)+"需要 1 个"+getitemname(.@fruit)+"、1 个空瓶和 3 Zeny 手续费。";
				next;
				mes "[商人马克斯·汉森]";
				mes "准备好一切后，我会把水果榨成美味果汁。";
				close;
			}

			mes "[商人马克斯·汉森]";
			mes "你想制作多少？";
			next;
			switch(select("能做多少就做多少。:我想要指定数量。:取消。")) {
			case 1:
				set .@make,countitem(.@fruit);
				if (countitem(713) < .@make) set .@make, countitem(713);
				if (Zeny/3 < .@make) set .@make, Zeny/3;
				break;
			case 2:
				mes "[商人马克斯·汉森]";
				mes "请输入小于 100 的数字。不想制作就输入‘0’。最多可制作 " + countitem(.@fruit) + " 瓶。";
				next;
				while(1) {
					input .@input;
					if (.@input == 0) {
						mes "[Merchant Marx Hansen]";
						mes "那么……再来吧。";
						mes "";
						close;
					}
					else if (.@input > 100) {
						mes "[Merchant Marx Hansen]";
						mes "不能超过 100 瓶。请改选其他数量。";
						next;
					}
					else {
						break;
					}
				}
				set .@make,.@input;
				break;
			case 3:
				mes "[Merchant Marx Hansen]";
				mes "那么……";
				mes "欢迎下次再来。";
				close;
			}

			set .@total_zeny,3 * .@make;

			if (countitem(.@fruit) < .@make || countitem(713) < .@make || Zeny < .@total_zeny) {
				mes "[Merchant Marx Hansen]";
			mes "哦，不……";
			mes "你没有带齐必要材料。这样我也帮不了你。请收集所需物品。";
				close;
			}
			delitem .@fruit,.@make;
			delitem 713,.@make;
			set Zeny, Zeny-.@total_zeny;
			getitem .@juice,.@make;

			mes "[Merchant Marx Hansen]";
			mes "给你！如约而至的新鲜美味果汁。非常清爽可口。";
			next;
			mes "[Merchant Marx Hansen]";
			mes "那么……";
			mes "欢迎下次再来。";
			close;
		case 2:
			mes "[Merchant Marx Hansen]";
			mes "在人类建立如此庞大的社会之前，人们采集树上的果实来生存。果实也许是让我们得以存在于世的自然恩赐。";
			next;
			mes "[商人马克斯·汉森]";
			mes "生活变得富足后，年轻人似乎不再吃水果。因此我开始想办法让水果更容易食用。";
			next;
			mes "[商人马克斯·汉森]";
			mes "我发现榨成果汁后更方便食用，味道也更好。";
			next;
		mes "# 果汁信息 #";
			mes "^CC4E5C- Apple Juice -^000000";
		mes "苹果 1 个、空瓶 1 个、3 Zeny。";
			mes "^E3CF57- Banana Juice -^000000";
		mes "香蕉 1 个、空瓶 1 个、3 Zeny。";
			mes "^ED9121- Carrot Juice -^000000";
		mes "胡萝卜 1 个、空瓶 1 个、3 Zeny。";
			mes "^CC00FF- Grape Juice -^000000";
		mes "葡萄 1 个、空瓶 1 个、3 Zeny。";
			close;
		case 3:
			mes "[Merchant Marx Hansen]";
		mes "嘿！";
		mes "拜访别人时，记得和他们交谈！";
			close;
		}
	}
	else {
		mes "[商人马克斯·汉森]";
		mes "欢迎。";
		mes "我能帮你什么？";
		next;
		if (select("Talk:Cancel") == 1) {
			mes "[商人马克斯·汉森]";
			mes "在人类发展出庞大社会前，人们从树上采集水果生存。水果也许是让我们存在于世的自然恩赐。";
			next;
			mes "[商人马克斯·汉森]";
			mes "生活富足后，年轻人似乎不再吃水果。因此我开始想办法让水果更容易食用。";
			next;
			mes "[商人马克斯·汉森]";
			mes "我发现榨成果汁后更方便食用，味道也更好。";
			close;
		}
		mes "[商人马克斯·汉森]";
		mes "嘿！";
		mes "拜访别人时，记得和他们交谈！";
		close;
	}
}

 
 
 

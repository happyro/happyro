	mes "[派遣修女]";
	mes "他们不想知道，也不在乎。只有陷入糟糕境地才会来到这里。";
	close;
}

rockrdg1,310,48,3	script	Erekter#rockc06	4_M_CACTUSCHILD,{
	mes "[埃雷克特]";
	mes "埃雷克特长大后想成为村里最好的制网师。";
	next;
	npctalk "哦，等等。", "", bc_self;
	emotion ET_THINK;
	mes "[埃雷克特]";
	mes "村里最好的制网师是软羽女士。";
	next;
	emotion ET_DELIGHT;
	mes "[埃雷克特]";
	mes "嗯……那我就成为村里第二好的制网师！";
	close;
}

rockrdg1,308,49,5	script	Soft Feather#rockc09	4_F_CACTUSLADY3,{
	mes "[软羽]";
	mes "呵呵呵，村里没有一张渔网不是经我之手。";
	mes "也有人能织好网，但最后的收尾都由我完成。";
	next;
	mes "[埃雷克特]";
	mes "我也想向你学习！我想成为和你一样厉害的制网师！";
	next;
	mes "[软羽]";
	mes "你的手现在太嫩了。出去玩吧。等你的手变粗糙后我再教你。";
	next;
	npctalk "好耶！我要去告诉我的朋友们！", "Erekter#rockc06", bc_self;
	mes "[软羽]";
	mes "是的，我会教你怎么制网。现在，先教你用草叶打漂亮的结。";
	close;
}

// GM npc
harboro1,1,1,3	script	Manager#1	CLEAR_NPC,3,0,{
	.@equip_id = getequipid(EQI_ARMOR);
	if (.@equip_id == -1)
		end;

	if (.@equip_id != getiteminfo("Amesha_Spenta", ITEMINFO_ID)) {
		mes "^0000ff[负重限制助手]^000000";
		mes "^0000ff要删除该角色当前穿戴的所有装备吗？^000000";
		mes "^0000ffPPL 删除版本。^000000";
		next;
		switch( select( "退出。", "全部删除。" ) ) {
		case 1:
			mes "已取消删除。";
			close;
		case 2:
			mes "部分物品无法删除。";
			close;
		}
		end;
	}

	.@i = callfunc("F_GM_NPC",1854,0);
	if (.@i == -1) {
		mes "命令已取消。";
		close;
	}
	else if (.@i != 0) {
		setarray .@quest_id[0],
			12381,
			12389,
			12403,
			12382,
			12383,
			12384,
			12385,
			12386,
			12387,
			12388,
			12390,
			12391,
			12392,
			12393,
			12394,
			12395,
			12396,
			12398,
			12399,
			12400,
			12401,
			12402,
			12404,
			12405,
			12406,
			12407,
			12408,
			12409;
		.@size = getarraysize(.@quest_id);
		for ( .@i = 0; .@i < .@size; ++.@i ) {
			if (isbegin_quest(.@quest_id[.@i]) > 0)
				erasequest .@quest_id[.@i];
		}
		mes "重置完成。";
		close;
	}
	end;
}

morocc,152,167,4	duplicate(William)	William#moc	89

// Binoculars Quest
// ============================================================
morocc,169,168,4	duplicate(Alchemist)	Alchemist#moc	64

// Resurrection of Satan Morocc
// ============================================================
-	script	Continental Guard#man	-1,{
	mes "[大陆守卫]";
	mes "总部下令封锁该区域，因为探测到异常时空现象。";
	next;
	mes "[大陆守卫]";
	mes "如果你确实要前往下一区域，安全由你自行负责。";
	next;
	switch(select("算了。:进入原野。")) {
	case 1:
		mes "[大陆守卫]";
		mes "明智的选择。";
		mes "旅途平安。";
		close;
	case 2:
		mes "[大陆守卫]";
		mes "我明白了。";
		mes "我马上送你去原野。";
		close2;
		warp "moc_fild20",208,207;
		end;
	}
}
moc_fild07,380,202,1	duplicate(Continental Guard#man)	Continental Guard#man1	852
moc_fild11,189,360,6	duplicate(Continental Guard#man)	Continental Guard#man2	852
prt_fild10,263,23,1	duplicate(Continental Guard#man)	Continental Guard#man3	852
prt_fild09,95,19,1	duplicate(Continental Guard#man)	Continental Guard#man4	852
prt_fild09,246,17,1	duplicate(Continental Guard#man)	Continental Guard#man5	852
moc_fild13,32,171,6	duplicate(Continental Guard#man)	Continental Guard#man6	852
moc_fild16,124,381,4	duplicate(Continental Guard#man)	Continental Guard#man7	852
moc_fild16,333,380,4	duplicate(Continental Guard#man)	Continental Guard#man8	852
moc_fild01,84,19,1	duplicate(Continental Guard#man)	Continental Guard#man9	852

morocc,176,101,3	duplicate(Continental Official)	Continental Official#mor	754

// Pyramids Nightmare Mode :: nightmare_pry
//============================================================
moc_prydb1,103,54,3	script	Suspicious Cat#night	547,{
	mes "[可疑的猫]";
	mes "真不敢相信木乃伊竟然能这样对我。天啊，好痛。绝不能让别人知道这件事……";
	next;
	if(select("木乃伊？发生什么了？:假装什么都不知道。") == 2)
		close;
	mes "[可疑的猫]";
	mes "被你发现了！可恶……没想到我盗墓者的名声会这样受损……";
	next;
	mes "[可疑的猫]";
	mes "可是，那些家伙太奇怪了！他们是木乃伊！只是木乃伊而已，你懂吗？他们不该这么强！";
	next;
	if(select("强大的木乃伊？在哪里？:结束对话。") == 2) {
		mes "[可疑的猫]";
		mes "什么～你不想听我的故事？好吧！你最好别在别处提到我的名字！";
		close;
	}
	mes "[可疑的猫]";
	mes "哈哈，这是秘密。";
	mes "我是在偷东西时发现的……不，我是说，只是在金字塔里走过时发现的。";
	next;
	mes "[可疑的猫]";
	mes "看到木乃伊向我走来时，我想‘随便吧’，根本没在意。可它竟然一巴掌把我打倒了！怎么能这样对待我这么可爱的猫！你这个缠绷带的怪物……走着瞧！";
	next;
	if(select("我也想去。:结束对话。") == 2)
		close;
	mes "[可疑的猫]";
	mes "不行！我花了很多时间才找到那条路！！";
	next;
	mes "[可疑的猫]";
	mes "嗯……不过你坚持的话，给我 5000 Zeny，我就带你去。";
	mes "什么～？别那样看我！你知道猫在米德加尔特生存有多难吗！";
	next;
	mes "[可疑的猫]";
	mes "^FF0000不过仔细想想，像你这样的弱者根本无法在那里生存。运气好的话也许能撑一秒？^000000";
	mes "算了，这不关我的事。但我还是先警告过你了！";
	next;
	switch(select("支付 5,000 Zeny 出发。:算了。")) {
	case 1:
		if (Zeny < 5000) {
			mes "[可疑的猫]";
			mes "你以为你要去哪！你穷得叮当响！";
			close;
		}
		set Zeny, Zeny-5000;
		mes "[可疑的猫]";
		mes "呸，这些旧钱有什么用……你就没有什么闪闪发光的东西吗？！";
		mes "啊，跟我来！";
		close2;
		warp "moc_prydn1",93,96;
		end;
	case 2:
		mes "[可疑的猫]";
		mes "天啊，你连5000 Zeny都没有吗？";
		close;
	}
}

moc_prydn1,94,98,3	script	Suspicious Cat#night2	547,{
	mes "[可疑的猫]";
	mes "你转身时那笨木乃伊又打了我一巴掌！呜呜……我们回去吧，喵！";
	next;
	switch(select("回盗贼公会:消灭毕帝特:消灭远古木乃伊:没什么")) {
	case 1:
		mes "[可疑的猫]";
		mes "对，对……我们回去吧。";
		close2;
		warp "moc_prydb1",100,57;
		end;
	case 2:
		set .@playtime, checkquest(2290,PLAYTIME);
		if (.@playtime == 0 || .@playtime == 1) {
			mes "[可疑的猫]";
			mes "看那个毕帝特，他怕我们！呀哈哈哈！至少暂时安全了！";
			close;
		} else if (.@playtime == 2)
			erasequest 2290;
		set .@hunting, checkquest(2289,HUNTING);
		if (.@hunting == -1) {
			mes "[可疑的猫]";
			mes "你知道猫和狗合不来吗？";
			next;
			mes "[可疑的猫]";
			mes "看看那只又丑又可怕的毕帝特。他皱着眉、摇着尾巴，想靠近我们。";
			mes "哦，你没有尾巴，对吧？他觉得我是眼中钉，现在正想挑起争斗！";
			next;
			mes "[可疑的猫]";
			mes "看看他，贪婪又流口水……我也不喜欢他的呼吸方式。我受不了他发出的咕噜声……";
			mes "很明显，他正等着从背后袭击我。";
			next;
			mes "[可疑的猫]";
			mes "天啊，要不是肚子疼，我真想把他的脸抓个稀烂！";
			mes "喂，我可不是因为害怕魔鬼大乌贼才这样！";
			next;
			mes "[可疑的猫]";
			mes "如果你想回家，最好先揍扁那只丑狗！否则他会咬你的！";
			next;
			switch(select("帮助他:离远一点")) {
			case 1:
				mes "[可疑的猫]";
				mes "很好，目标数量是 20！祝你好运！";
				setquest 2289;
				close;
			case 2:
				mes "[可疑的猫]";
				mes "呸！你不在乎我吗？好吧，你这个叛徒！";
				close;
			}
		} else if (.@hunting == 0 || .@hunting == 1) {
			mes "[可疑的猫]";
			mes "毕帝特的训练顺利吗？";
			next;
			switch(select("当然。:我想停下。")) {
			case 1:
				mes "[可疑的猫]";
				mes "很好。继续加油！";
				close;
			case 2:
				mes "[可疑的猫]";
				mes "什么？你太不负责任了！";
				erasequest 2289;
				close;
			}
		} else if (.@hunting == 2) {
			mes "[可疑的猫]";
			mes "嘿，你还真有用！干得好！";
			mes "那只毕帝特暂时不敢再来这里了，对吧？呜哈哈哈！";
			changequest 2289,2290;
			getexp 300000,100000;
			close;
		}
	case 3:
		set .@playtime, checkquest(2291,PLAYTIME);
		if (.@playtime == 0 || .@playtime == 1) {
			mes "[可疑的猫]";
			mes "很好，我会好好利用你争取来的时间！不过我得先处理一下肚子疼……";
			close;
		} else if (.@playtime == 2)
			erasequest 2291;
		set .@hunting, checkquest(2292,HUNTING);
		if (.@hunting == -1) {
			mes "[可疑的猫]";
			mes "珍贵宝藏应该藏在这里隐秘的深处！";
			mes "我确定木乃伊的珍宝藏在地下二层。";
			next;
			mes "[可疑的猫]";
			mes "但远古木乃伊趁我不备，在我反应过来前打了我的头！";
			next;
			mes "[可疑的猫]";
			mes "我敢肯定，他们是想让我的高级脑细胞减少，以阻止我找到宝藏！！";
			next;
			mes "[可疑的猫]";
			mes "他们阻止不了我！去消灭远古木乃伊！！";
			next;
			mes "[可疑的猫]";
			mes "别问为什么！我相信你也不想让那些美丽的宝藏永远藏在黑暗里！";
			next;
			switch(select("帮助他:离远一点")) {
			case 1:
				mes "[可疑的猫]";
				mes "好，目标数量是 20！祝你好运！";
				setquest 2292;
				close;
			case 2:
				mes "[可疑的猫]";
				mes "呸，你真是冷酷无情。";
				close;
			}
		} else if (.@hunting == 0 || .@hunting == 1) {
			mes "[可疑的猫]";
			mes "和远古木乃伊战斗顺利吗？";
			next;
			switch(select("当然。:我想停下。")) {
			case 1:
				mes "[可疑的猫]";
				mes "很好。继续加油！";
				close;
			case 2:
				mes "[可疑的猫]";
				mes "什么？你太不负责任了！";
				erasequest 2292;
				close;
			}
		} else if (.@hunting == 2) {
			mes "[可疑的猫]";
			mes "嘿，你还真有用！干得好！";
			mes "那只远古木乃伊暂时不敢再来这里了，对吧？呜哈哈哈！";
			changequest 2292,2291;
			getexp 600000,200000;
			close;
		}
	case 4:
		close;
	}
}

ra_temple,168,169,3	script	Eridanus#fp	4_M_MIDDLE1,{
	mes "[Eridanus]";
	mes "哈哈，正门在那边，冒险者。";
	mes "你得爬楼梯。";
	next;
	select( "你在做什么？" );
	mes "[Eridanus]";
	mes "如你所见，正在进行维护工作。";
	mes "……但我感觉有点不安。";
	next;
	mes "[Eridanus]";
	mes "嗯。你是冒险者。";
	mes "最近我一直听到圣地传来奇怪的声音。";
	next;
	mes "[Eridanus]";
	mes "我想这是因为前段时间的那场事故……";
	next;
	select( "事故？" );
	mes "[Eridanus]";
	mes "（低声说道）";
	mes "那里发生了一起小规模魔力泄漏事故。";
	mes "上级试图压下此事，但我听说事故导致一些怪物出现。";
	next;
	mes "[Eridanus]";
	mes "我的上级把它当作胡说，";
	mes "但你听着。";
	mes "……你没听见从下面传来的奇怪声音吗？";
	next;
	mes "[Eridanus]";
	mes "如果真是怪物，就意味着圣殿里困着一只怪物，这是大问题。";
	mes "呃……";
	next;
	mes "[Eridanus]";
	mes "哦对了！你可以替我们的女神消灭怪物！";
	mes "上级肯定会批评我放纵，但我不能对怪物问题视而不见！";
	next;
	mes "[Eridanus]";
	mes "我们应该为教皇挺身而出！";
	mes "怎么样？你愿意吗？";
	next;
	mes "[Eridanus]";
	mes "有些狂热分子发疯后变成了怪物。";
	mes "消灭^4d4dff伊西拉、凡贝克和霍德雷姆林^000000。";
	next;
	if (select( "接受", "拒绝。" ) == 2) {
		mes "[Eridanus]";
		mes "呃，我不能眼睁睁看着怪物在那里横行……！";
		close;
	}
	mes "[Eridanus]";
		mes "谢谢你愿意这么做。";
		mes "请务必小心。";
		mes "走这条通风井，它会通往怪物肆虐的地方。";
	close2;
	warp "ra_san01",47,47;
	end;
}

// Main Quest: Step 6.
ra_temin,173,40,3	script	Guard Dent#ep18	4_M_RASWORD,{
	if (ep18_main == 7) {
		mes "[Guard Dent]";
		mes "<FONT SIZE = 16><B>等一下！！</FONT></B>";
		mes "<FONT SIZE = 14>喂！</FONT>";
		mes "你没看到队伍吗？";
		mes "^e5555e如果你是来见^000000Niren^000000的，就按顺序排队！";
		npctalk "等一下！！喂！", "Guard Dent#ep18", bc_self;
		next;
		mes "[Elly]";
		mes "人真的很多。";
		mes "但如果不能尽快见到 Niren，就麻烦了。";
		cutin "ep172_beta.bmp",2;
		next;
		select( "听说事情很紧急。" );
		cutin "",255;
		mes "[Guard Dent]";
		mes "<FONT SIZE = 16><B>什么？</FONT></B>";
		mes "<FONT SIZE = 14>我也很着急，你知道吗？</FONT>";
		npctalk "什么？", "Guard Dent#ep18", bc_self;
		next;
		mes "[Guard Dent]";
		mes "<FONT SIZE = 14><B>唉～</FONT></B>";
		mes "你知道我今天光是被派来制止打架就有多少次了吗？！";
		mes "人们不停地到处打架，也快把我们逼疯了！";
		npctalk "唉～要是大家能暂时别再打架就好了……", "Guard Dent#ep18", bc_self;
		next;
		mes "[Guard Dent]";
		mes "我们试图制止打架时，他们甚至装都不装作在听！";
		mes "他们为了争论自己是^e5555e移民^000000还是^e5555e本地人^000000而争斗了很久，但最近已经完全不是闹着玩的了！";
		next;
		mes "[Guard Dent]";
		mes "我们一开口，他们就开始大喊本地人遭受^e5555e歧视^000000……";
		mes "光是想想就让我头疼。";
		npctalk "光是想想就让我头疼。", "Guard Dent#ep18", bc_self;
		next;
		mes "[Security Officer Dent]";
		mes "最近过得怎么样，Neil？";
		erasequest 8687;
		setquest 11696;
		ep18_main = 8;
		close;
	}
	if (ep18_main == 8) {
		mes "[Guard Dent]";
		mes "最近过得怎么样，Neil？";
		close;
	}
	mes "[Guard Dent]";
		mes "唉～";
		mes "要是大家能暂时别再打架就好了……";
	close;

OnInit:
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "isbegin_quest(11696) == 0 && isbegin_quest(8687) == 1" );
	end;
}

// Main Quest: Step 7. and 10.
ra_temin,174,38,3	script	Guard Neil#ep18	4_DST_SOLDIER,{
	if (ep18_main == 8) {
		mes "[Guard Neil]";
		mes "<FONT SIZE = 14><B>喂，住手！</FONT></B>";
		mes "不过，你还是比我强。";
		mes "你和我一样清楚这一点。我是本地人。";
		npctalk "喂，住手！", "Guard Neil#ep18", bc_self;
		next;
		mes "[Guard Neil]";
		mes "我还没开始说话，他们就让我叫另一个本地保安来。";
		npctalk "歧视可不是闹着玩的！", "Guard Neil#ep18", bc_self;
		next;
		mes "[Guard Neil]";
		mes "每当涉及我的本地人身份时，我就听腻了诸如‘你知道我是谁吗？’这样的话。";
		mes "他们到底把保安当成什么了！";
		next;
		mes "[Guard Neil]";
		mes "说实话，最近事情真的很奇怪。";
		mes "就连以前从没惹过麻烦的人也卷入了争斗，把小冲突变成大问题。";
		next;
		mes "[Guard Neil]";
		mes "没错！";
		mes "最近到处都乱糟糟的。";
		mes "现在想想，我昨天也来过神殿。";
		mes "那边的祭司就是昨天叫我的人，对吧？";
		mes "神殿最近怎么样？";
		changequest 11696,11697;
		ep18_main = 9;
		close;
	}
	if (ep18_main == 9) {
		mes "[Guard Neil]";
		mes "没错！";
		mes "最近到处都乱糟糟的。";
		mes "说起来，我昨天也在神殿。";
		mes "那里的祭司就是昨天叫我的人吗？";
		mes "神殿最近怎么样？";
		close;
	}
	if (ep18_main == 10) {
		mes "[Guard Neil]";
		mes "Ah~";
		mes "Niren 好像很忙……";
		close;
	}
	if (ep18_main == 11 || ep18_main == 12) {
		mes "[High Priestess Niren]";
		mes "Neil，你今天有没有见过^e5555eMaram^000000？";
		cloakoffnpcself( "Niren#ep18_in1" );
		cutin "ra_gwoman.bmp",2;
		next;
		cutin "",255;
		mes "[Guard Neil]";
		mes "Maram?";
		mes "我刚才去神殿时，好像看到他在^e5555e广场^000000附近……";
		next;
		mes "[Guard Neil]";
		mes "不确定他是否还在广场，但也许可以问那里的人，看看 Maram 去了哪里？";
		next;
		mes "[High Priestess Niren]";
		mes "嗯……我明白了。";
		mes "我之前交给" + strcharinfo(0) + "的任务，我的儿子 Maram 会帮忙。";
		mes "他比任何人都了解这件事。";
		npctalk "我的儿子 Maram 会帮忙完成之前的任务。", "Niren#ep18_in1", bc_self;
		cutin "ra_gwoman.bmp",2;
		next;
		mes "[High Priestess Niren]";
		mes "我本想亲自介绍他，但你也看到了，我现在不能离开岗位。";
		mes "在^e5555e广场附近^000000打听一下，应该能找到他。";
		if (ep18_main == 11) {
			changequest 11699,11700;
			ep18_main = 12;
		}
		close2;
		navigateto("rachel",137,135);
		cloakonnpcself( "Niren#ep18_in1" );
		cutin "",255;
		end;
	}
	mes "[Guard Neil]";
		mes "唉……";
		mes "大祭司 Niren 到底去哪儿了……";
	close;

OnInit:
	questinfo( QTYPE_QUEST2, QMARK_YELLOW, "isbegin_quest(11696) == 1" );
	questinfo( QTYPE_QUEST2, QMARK_YELLOW, "isbegin_quest(11699) == 1" );
	end;
}

// Main Quest: Step 8.
ra_temin,172,36,7	script	Priest Freya#ep18	4_F_MASK1,{
	if (ep18_main == 9) {
		mes "[Priest Freya]";
		mes "我们总是为信徒的虔诚信仰和内心平静祈祷。";
		next;
		mes "[Guard Neil]";
		mes "呃，受够那些套话了~";
		mes "我亲眼看到的~";
		mes "而且如果没什么严重的事，祭司没理由这样站在这里。";
		next;
		mes "[Guard Neil]";
		mes "我们不是应该了解最近人们的情况，让警卫做好准备吗？";
		mes "尤其是我们对来到神殿的人了解不多。";
		npctalk "我们对来到神殿的人了解不多。", "Guard Neil#ep18", bc_self;
		next;
		mes "[Guard Dent]";
		mes "给我们一些信息~";
		npctalk "给我们一些信息~", "Guard Dent#ep18", bc_self;
		next;
		mes "[Priest Freya]";
		mes "神殿是为 Freya 祭司祈祷的地方。";
		mes "保持内心平静……";
		next;
		mes "[Guard Neil]";
		mes "我昨天看到了。";
		mes "<FONT SIZE = 14>就在这里，在互相争斗的人群中，这位面具掉了一半的祭司……</FONT>";
		next;
		mes "[Priest Freya]";
		mes "<FONT SIZE = 16><B>糟糕！！！</FONT></B>";
		mes "<FONT SIZE = 14><B>等一下！</FONT></B>";
		mes "<FONT SIZE = 14><B>站住！！！</FONT></B>";
		npctalk "糟糕！！！等一下！", "Priest Freya#ep18", bc_self;
		next;
		mes "[Priest Freya]";
		mes "<FONT SIZE = 10>唉……</FONT>";
		next;
		mes "[Priest Freya]";

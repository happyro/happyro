		mes "本地人与移民之间的冲突正在加剧。";
		mes "有些人比平时更加激进，公开煽动冲突。";
		next;
		mes "[Junok]";
		mes "还有一些人，即使因可能导致冲突的理由被安保扣留，也会把一切归咎于本地人、移民……并以此为借口。";
		next;
		mes "[Junok]";
		mes "我正在努力解决，但……";
		next;
		mes "[Guard Gala]";
		mes "最近，不明人士一直试图入侵塞斯鲁尼尔神殿。";
		npctalk "警卫：太弱，而且为了闯入而行动不协调。", "Guard Gala#ep18c10", bc_self;
		unittalk getcharid(3), "" + strcharinfo(0) + "：Mini Elly：闯入？", bc_self;
		next;
		mes "[Guard Gala]";
		mes "不断试图闯入拉赫首都最安全的神殿是一回事，但……";
		unittalk getcharid(3), "" + strcharinfo(0) + "：Mini Elly：连客人听来都很可疑，不是吗？", bc_self;
		next;
		mes "[Guard Gala]";
		mes "神殿目前高度戒备应对他们，有时无法及时处理民间纠纷。";
		next;
		mes "[Guard Gala]";
		mes "由于不确定事态会升级到什么程度，也不知道类似事件会突然在哪里出现，我们不能贸然采取全面应对……";
		mes "过度扩大安保力量也不是可行方案。";
		next;
		mes "[Guard Gala]";
		mes "真是艰难的局面……嗯？";
		cloakoffnpcself( "Rookie Guard#ep18c11" );
		npctalk "新手卫兵：神殿西侧有入侵者！", "Rookie Guard#ep18c11", bc_self;
		next;
		mes "[Guard Gala]";
		mes "他们又在光天化日下攻击！走！";
		mes "冒险者，请和我们一起去！";
		next;
		select( "你为什么相信我？" );
		mes "[" + strcharinfo(0) + "]";
		mes "你知道我是谁吗？";
		mes "如果他们是入侵者呢？";
		next;
		mes "[Guard Gala]";
		mes "我守卫神殿很久了。";
		mes "你会把这些告诉完全不认识的人吗？";
		npctalk "Junok：你们认识吗？", "Nervous Priest#e18b", bc_self;
		npctalk "Guard Gala：单方面认识。", "Guard Gala#ep18c10", bc_self;
		next;
		mes "[Guard Gala]";
		mes "快走！";
		changequest 8684,8685;
		ep18_main = 5;
		navigateto("ra_temple",30,142);
		cloakonnpcself( "Nervous Priest#e18b" );
		cloakonnpcself( "Guard Gala#ep18c10" );
		cloakonnpcself( "Rookie Guard#ep18c11" );

		cloakoffnpcself( "Nervous Priest#e18c" );
		cloakoffnpcself( "Guard Gala#ep18c12" );
		cloakoffnpcself( "Guard Izu#ep18c13" );
		cloakoffnpcself( "Guard Calsort#c14" );
		cloakoffnpcself( "Heart Hunter#ep18c15" );
		cloakoffnpcself( "Heart Hunter#ep18c16" );
		close;
	}
	end;

OnInit:
	questinfo( QTYPE_QUEST2, QMARK_YELLOW, "isbegin_quest(8684) == 1" );
	end;
}


ra_temple,30,142,1	script(CLOAKED)	Nervous Priest#e18c	4_M_TRAINEE,{
	if (checkweight(1000405,20) == 0) {
		mes "- 等一下！！ -";
		mes "- 你目前携带了 -";
		mes "- 太多物品。 -";
		mes "- 请重试 -";
		mes "- 减轻负重后再来。-";
		close;
	}
	.@char_id = getcharid(0);
	if (ep18_main == 5) {
		mes "[Mini Elly]";
		mes "你看起来很熟悉，我认识你吗？";
		next;
		mes "[Mini Elly]";
		mes "你比我预想的更快找到我。";
		next;
		select( "你还不知道宅邸的情况，对吧？" );
		mes "[" + strcharinfo(0) + "]";
		mes "被派往宅邸的人可能来自另一支队伍……";
		next;
		mes "[Guard Izu]";
		mes "你被包围了！投降！";
		next;
		mes "[Heart Hunter]";
		mes "哼，这也叫包围。和传闻一样。";
		next;
		mes "[Guard Izu]";
		mes "什么？你们已经失败逃跑整整 14 次了！";
		next;
		mes "[Guard Calsort]";
		mes "其实是 15 次。";
		npctalk "哼。", "Heart Hunter#ep18c15", bc_self;
		next;
		mes "[Heart Hunter]";
		mes "那是我们派出的新手侦察兵！";
		mes "现在我们已经绘制出你们所有巡逻路线。做好准备。";
		next;
		mes "[Guard Gala]";
		mes "我们得改变策略。";
		next;
		mes "[Heart Hunter]";
		mes "...";
		next;
		mes "[Guard]";
		mes "...";
		next;
		mes "[Heart Hunter]";
		mes "这次结束了！特种部队已经在神殿……";
		next;
		cloakoffnpcself( "Marshal Chive#c17" );
		mes "[Marshal Chive]";
		mes "如果是特种部队，是这些人吗？";
		cloakoffnpcself( "Heart Hunter#ep18c18" );
		cloakoffnpcself( "Heart Hunter#ep18c19" );
		npctalk "呃……", "Heart Hunter#ep18c19", bc_self;
		npctalk "可恶。", "Heart Hunter#ep18c18", bc_self;
		next;
		mes "[Guard Gala]";
		mes "看来结束了。";
		next;
		mes "[Heart Hunter]";
		mes "……下次我们一定会成功！";
		cloakonnpcself( "Heart Hunter#ep18c15" );
		cloakonnpcself( "Heart Hunter#ep18c16" );
		erasequest 8685;
		setquest 8686;
		ep18_main = 6;
		next;
		// Fallthrough
	}
	if (ep18_main == 6) {
		mes "[Guard Gala]";
		mes "...";
		mes "确实奇怪。他们多次如此粗心又显眼地进来，现在甚至开始使用明显的谎言和戏剧性手段。";
		mes "到了这种地步，连放诱饵都变得可疑。";
		next;
		mes "[Guard Gala]";
		mes "他们把人送到哪里了……";
		next;
		select( "事实上，我来拉赫的原因是……" );
		mes "[" + strcharinfo(0) + "]";
		mes "我是来寻找与他们有关的人……";
		next;
		mes "[Junok]";
		mes "我明白了。有联系吗？";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "与其说是联系，不如说是……";
		next;
		mes "我解释说无法完整说明情况，但他们的目的就是闯入。";
		next;
		mes "[Guard Gala]";
		mes "嗯……";
		mes "你见过 Niren 吗？";
		mes "你很久没来了，可能还没和所有人打招呼。";
		next;
		mes "[Guard Gala]";
		mes "我不是在强迫你，但是……";
		mes "总之你迟早要进去见他们。既然来了，为什么不去拜访一下？";
		npctalk "Guard Galla：暂时扣留那些人。他们一定是新来者。", "Guard Gala#ep18c12", bc_self;
		npctalk "Guard Chive：明白。", "Marshal Chive#c17", bc_self;
		next;
		mes "[Guard Gala]";
		mes "我们去那边讨论细节……";
		erasequest 8686;
		setquest 8687;
		ep18_main = 7;
		getitem 1000405,30;	// Ep18_Amethyst_Fragment
		getexp 18252408,2000000;
		close2;
		navigateto("ra_temin",173,40);
		cloakonnpcself( "Nervous Priest#e18c" );
		cloakonnpcself( "Guard Gala#ep18c12" );
		cloakonnpcself( "Guard Izu#ep18c13" );
		cloakonnpcself( "Guard Calsort#c14" );
		cloakonnpcself( "Marshal Chive#c17" );
		cloakonnpcself( "Heart Hunter#ep18c18" );
		cloakonnpcself( "Heart Hunter#ep18c19" );
		end;
	}
	end;

OnInit:
	questinfo( QTYPE_QUEST2, QMARK_YELLOW, "isbegin_quest(8685) == 1 || isbegin_quest(8686) == 1" );
	end;
}


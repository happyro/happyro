		mes "哇……听说这是雪原融化的雪水。";
		mes "非常清爽，对吧？";
		mes "....";
		next;
		mes "[Doha]";
		mes "回到故事。";
		mes "所以我问猫为什么觉得袭击者是同类。";
		next;
		mes "[Doha]";
		mes "他说袭击者有漂亮的尾巴和迷人的耳朵。";
		mes "难以置信。";
		next;
		select("是猫？");
		mes "[Doha]";
		mes "不。我也问了同样的问题。";
		mes "他说袭击者更像我。";
		mes "准确地说，是像人类。";
		next;
		mes "[Doha]";
		mes "是的。一个人类男性。";
		mes "他说^4d4dff袭击者有漂亮的耳朵，以及光滑华丽的尾巴^000000！";
		next;
		select("会不会是爱好？");
		mes "[Doha]";
		mes "你说的是在普隆德拉流行的猫耳发带？";
		mes "如果是成年男性戴着那种耳朵……还带着尾巴？";
		next;
		if (select("他是在伪装？：应该尊重品味。") == 1) {
			mes "[Doha]";
			mes "我同意。";
			mes "我认为其中一个国家在幕后。";
			mes "我真心觉得，无论是萨帕还是拉比内，都不会从中得到任何东西。";
			next;
			mes "[Doha]";
			mes "我想这只会成为隐藏身份的办法。";
			mes "也就是伪装成猫！";
			next;
		}
		else {
			mes "[Doha]";
			mes "....................";
		mes "…………当然。";
			mes "不同的品味应该被尊重。";
			next;
			mes "[Doha]";
		mes "……咳咳。";
		mes "我的结论是";
			mes "有人荒唐地伪装自己，以隐藏来历！";
			next;
		}
		mes "[Doha]";
		mes "所以我们现在需要做的是";
		mes "找一个戴猫耳的人。";
		mes "但我不确定他现在是否还带着那些东西。";
		next;
		mes "[Doha]";
		mes "但正如猫商人提到的，我们不能排除他来自第三方的可能。";
		mes "那他的动机可能是什么？";
		next;
		mes "[Doha]";
		mes "在事情变复杂前，我们先从简单的开始。";
		mes "听说你要去萨帕首都迪卡斯特斯。";
		next;
		mes "[Doha]";
		mes "不管是猫还是狗";
		mes "请收集戴动物耳朵的人的信息。";
		next;
		mes "[Doha]";
		mes "我会从这里继续搜索调查马努克和斯普兰迪。";
		mes "我需要你在旅途中以及迪卡斯特斯展开调查。";
		next;
		mes "[Doha]";
		mes "这是非常重要的任务。";
		mes "三个国家之间存在微妙冲突";
		mes "也可能存在未知的第三方。";
		next;
		mes "[Doha]";
		mes "还有，袭击者为什么只进行干扰，而不是偷走整份报告？";
		mes "我们需要查明目的。";
		next;
		mes "[Doha]";
		mes "请带回一些线索，旅途中遇到的任何东西都可以。";
		mes "如果发现线索，请回来向我报告。";
		set ep13_3_secret, 3;
		changequest 7185,7186;
		close;
	}
	else if (ep13_3_secret == 3) {
		mes "[Doha]";
		mes "我会调查马努克和斯普兰迪。";
		mes "所以你要在迪卡斯特斯寻找线索。";
		next;
		mes "[Doha]";
		mes "关于那个长着动物耳朵的人。";
		mes "任务会很艰难，但我知道你能做好。";
		close;
	}
	else if (ep13_3_secret > 3 && ep13_3_secret < 22) {
		mes "[Doha]";
		mes "调查进行得怎么样？";
		mes "请尽力而为，";
		mes "不要破坏国家之间的平行关系。";
		close;
	}
	else if (ep13_3_secret == 22) {
		if (countitem(6306) && countitem(6305) && countitem(6307)) {
			mes "[Doha]";
			mes "调查进行得怎么样？";
			mes "有重要进展吗？";
			next;
			mes "你分享了关于 Diel、Cheshire、Ahat 和次元裂缝的详情。";
			mes "你把血块、贝壳和魔法石交给他作为证据。";
			next;
			mes "[Doha]";
			mes "嗯……";
			mes "其实我也把同样的任务交给了其他前往迪卡斯特斯的人。";
			next;
			mes "[Doha]";
			mes "他们带回的信息都基于推测。";
			mes "也就是说，你的证据和其他人的没有太大区别。";
			next;
			mes "[Doha]";
			mes "至少我们知道了一件事。";
			mes "至少现在知道袭击者不属于米德加尔特的三个国家。";
			mes "但这只是推测。";
			next;
			mes "[Doha]";
			mes "报告详情会由上级确认，并安排下一步行动。";
			mes "谢谢你。";
			next;
			mes "[Doha]";
			mes "请收下这个。";
			mes "这是对你至今为止服务的奖励。";
			mes "你在异世界经历了许多困难，值得这份奖励。";
			delitem 6306,1; //Solid_Bloodstain
			delitem 6305,1; //Frozen_Skin_Piece
			delitem 6307,1; //Suspicious_Magic_Stone
			set ep13_3_secret, 23;
			getitem 2553,1; //Dragon_Manteau
			erasequest 7202;
			completequest 7203;
			next;
			mes "[Doha]";
			mes "....";
			mes "萨帕或拉比内，随便哪一个。";
			mes "我有更紧急的事。";
			next;
		select("你能再说一遍吗？");
			mes "[Doha]";
			mes "..? ";
			mes "我什么也没说。";
			mes "我想你听错了。";
			mes "你现在要离开吗？我得整理报告。";
			close;
		}
		mes "你缺少随报告提交的证据：";
		mes "凝固血迹、冰冻皮肤碎片、奇怪的魔法石。";
		mes "你必须重新收集这些物品。";
		close;
	}
	mes "[Doha]";
	mes "现行政策不会改变。";
	mes "祖国会继续审查你的报告内容。";
	mes "[Doha]";
	mes "我们现在能做的就是";
	mes "尽力而为，对吧？";
	mes "他语气很温和，但眼神仿佛在说：快走，去做你的工作。";
	close;
}

dic_in01,245,119,4	script	Shay#ep133_13	884,{
	// if ((GetInventoryRemainCount 1301 3 == 2) || (GetInventoryRemainCount 1301 3 == 3)) {
	if ((MaxWeight - Weight) < 1000) {
		mes "-你携带的物品太多，无法继续任务。-";
		close;
	}
	cutin "ep13_shy",2;
	mes "[Shay]";
	switch (rand(1,5)) {
		case 1: mes ".. Burman Flone."; break;
		case 2: mes "什么？"; break;
		case 3: mes "真无聊。什么事？"; break;
		case 4: mes "唉……准备点餐了吗？"; break;
		case 5:
			mes "又失败了？";
			mes "我在自言自语。别管我。";
			mes "你想要什么？";
			break;
	}
	next;
	switch (select("点餐。:交谈。:算了。")) {
		case 1:
			mes "[Shay]";
			mes "想要什么？";
			mes "我有从梦罗克空运来的热带索格拉特和海滩朱红酒。";
			mes "不过价格有点贵。";
			next;		
			if (select("热带索格拉特 - 2000z:海滩朱红酒 - 2000z:其他？") == 3) {
				mes "[Shay]";
				mes "给……";
				mes "……嗯……";
				mes "算了。";
				break;
			}
			setarray .@str$[1], "Tropical Sorgrat","Vermillion on the Beach.";
			setarray .@item[1], 12112,12113;
			if (Zeny > 1999) {
				mes "[Shay]";
				mes "这是你的"+.@str$[@menu]+"。";
				set Zeny, Zeny - 2000;
				getitem .@item[@menu],1; //Tropical_Sograt
				break;
			}
			mes "[Shay]";
			mes .@str$[@menu]+"需要 2000 Zeny。";
			mes "为什么这么贵？";
			mes "那你试试把它一路带到这里。";
			break;
	case 2:
		if (ep13_3_invite < 6) {
			mes "[Shay]";
			mes "如果你还没在 Diel 登记，最好尽快登记。";
			mes "这是开始接收委托并保障你在这里安全的唯一办法。";
			next;
			mes "[Shay]";
			mes "为了避免冲突和外交麻烦，";
			mes "最好尊重双方的协议。";
			mes "你不这么认为吗？";
			break;
		}
		else {
			if (ep13_3_secret < 3) {
				mes "[Shay]";
				mes "倒也不是很忙，但我不想做。";
				break;
			}
			else if (ep13_3_secret == 3) {
				mes "[Shay]";
				mes "我不想谈私事。";
				mes "不过你有什么问题吗？";
				next;
				switch (select("介绍一下你自己:关于萨帕:关于其他种族:……嗯……")) {
					case 1:
						mes "[Shay]";
					mes "我？";
					mes "如果你问的是我的名字，徽章上写着。";
					mes "我叫 Shay。";
						next;
						select("不是这个。 ");
						mes "[Shay]";
					mes "嗯。那么我告诉你我是怎么在这里定居的？";
					mes "最先申请来这里执行任务的，";
					mes "是刺客。";
						next;
						mes "[Shay]";
					mes "我就是其中之一。";
					mes "所以我比其他人更早到达这里，";
					mes "探险营地的基地也因此建立。";
						next;
						mes "[Shay]";
						mes "不过你也知道。";
						mes "我本想回故乡退休。";
						mes "但迪卡斯特斯联系了我。";
						next;
						mes "[Shay]";
						mes "他们请我开一处让外来者感到舒适的地方。";
						mes "他们还很体贴地把它建成了米德加尔特风格。";
						next;
						mes "[Shay]";
						mes "于是他们请来了负责框架和风格的建筑师……";
						mes "然后我就莫名其妙地开始管理整个项目了？";
						mes "";
						next;
						mes "[Shay]";
						mes "然后……";
						mes "我就这样来到了这里。";
						mes "从那以后我一直待在这里！";
						next;
						mes "[Shay]";
						mes "我都不记得自己原本的工作是什么了。";
						mes "我想，我对卡塔尔有点生疏了……";
						next;
						mes "Shay 突然露出孤独的表情，为自己的处境深深叹气。";
						mes "看起来非常疲惫。";
						break;
					case 2:
						mes "[Shay]";
						mes "萨帕？";
						mes "你周围到处都是萨帕。";
						mes "......";
						next;
						mes "[Shay]";
						mes "你在问什么？";
						mes "随便问一个路过的萨帕。";
						mes "问‘你是什么人’。";
						break;
					case 3:
						mes "[Shay]";
						mes "其他种族？";
						mes "你是说萨帕？";
						next;
						if (select("长着猫耳。:长着蝴蝶翅膀。") == 1) {
							mes "[Shay]";
						mes "猫？";
						mes "你是说猫商人？";
						mes "他们驻扎在首都城门外。";
							next;
							mes "[Shay]";
						mes "他们甚至在远征队营地附近采矿和捕鱼。";
						mes "他们现在正努力扩大生意。";
							next;
							mes "[Shay]";
						mes "嗯……比他们更大？";
						mes "不清楚。我没听说过。";
						mes "为什么不^4d4dff问问附近的萨帕？^000000";
							set ep13_3_secret, 4;
							erasequest 7186;
							setquest 7187;
							break;
						}
						mes "[Shay]";
						mes "蝴蝶翅膀？你是说拉比内？";
						mes "不认识他们？";
						mes "你真是什么都不知道。";
						next;
						mes "[Shay]";
						mes "如果你想了解拉比内，就去斯普兰迪德。";
						mes "他们粗犷又强悍。";
						break;
					case 4:
						mes "[Shay]";
					mes "什么……";
					mes "我没那么忙，但也别太烦我。";
						break;
				}
				break;
			}
			else if (ep13_3_secret == 4) {
				mes "[Shay]";
				mes "现在怎么样？";
				mes "有进展吗？";
				next;
				setarray .@ward$, 
					"7188","广场上的 Knits 对 Ahat 很感兴趣。",
					"7189","我听 Pioms 说，大多数萨帕都对大臣感兴趣。",
					"7190","Galtens 对猫商人的猫耳朵很感兴趣。";
				mes "[" + strcharinfo(0) + "]";
				mes "我正在整理收集到的信息。";
				for (set .@size, getarraysize(.@ward$); .@i < .@size; set .@i, .@i + 2)
					if (checkquest(atoi(.@ward$[.@i])) >= 0) {
						set .@sealall, .@sealall + 1;
						mes .@ward$[.@i+1];
					}
				if (!.@sealall) mes "但我该如何处理收集到的信息？";
				next;
				if (.@sealall < 3) {
					mes "[" + strcharinfo(0) + "]";
					mes "唉……";
					mes "[Shay]";
					mes "你看起来很迷茫，好像什么都想不明白了。";
					mes "解决办法很简单，就是四处打听。";
					next;
					mes "[Shay]";
					mes "工厂、训练场、广场和其他地方都有许多萨帕在工作。";
					mes "城堡外也有猫商人。";
					break;
				}
				mes "[" + strcharinfo(0) + "]";
				mes "最近大家";
				mes "都在谈论大臣！";
				mes "这个 Ahat 到底是怎么回事？";
				next;
				mes "[Shay]";
				mes "我甚至没见过大臣。";
				mes "我听很多人说他很漂亮。";
				next;
				mes "[Shay]";
				mes "总之……";
				mes "试试这个。";
				mes "我做了它有一段时间，希望能把它加入菜单。";
				next;
				mes "-Shay 放下一份烤派，派底由胡萝卜制成。";
				mes "上面放着看起来像苹果或香蕉的东西。";
				mes "你立刻觉得尝试它风险太大。？";
				next;
				select("切碎的材料是……");
				mes "[Shay]";
				mes "苹果派。";
				mes "我用香蕉装饰了它。";
				mes "看起来不像，但这就是苹果派。";
				next;
				mes "[" + strcharinfo(0) + "]";
				mes "但为什么派里有胡萝卜？";
				mes "而且完全没有苹果的影子。";
				next;
				mes "[Shay]";
				mes "住手!!!!!!!!!!!!!";
				specialeffect2 EF_HIT1;
				specialeffect2 EF_HIT2;
				percentheal -30,0;
				next;
				mes "-Shay 非常生气，扔出了某种又黏又臭的东西。";
				mes "派离开 Shay 的手掌，正好砸在你的脸上。-";
				next;
				mes "[Shay]";
				mes "糟糕……呃……哼……";
				mes "呼……唉……";
				mes "...........";
				next;
				mes "[Shay]";
				mes "对、对不起。Aello 让我帮助你，但是……";
				mes ".......";
				mes "我控制不住自己。";
				next;
				mes "[Shay]";
				mes "哈……猫商人中有一只叫 BK 的猫。";
				mes "他可能有你想要的信息。";
				mes "……去见 BK。";
				next;
				mes "[Shay]";
				mes "如果他不理你，就告诉他^4d4dffShay 的特制饮料会送来^000000。";
				set ep13_3_secret, 5;
				erasequest 7188;
				erasequest 7189;
				erasequest 7190;
				changequest 7187,7191;
				break;
			}
			else if (ep13_3_secret > 4 && ep13_3_secret < 9) {
				mes "[Shay]";
				mes "你可以在城门外找到猫商人。";
				mes "他们似乎是一小群流浪者。";
				mes "你会在城门东南方看到他们的帐篷。";
				next;
				mes "[Shay]";
				mes "BK 掌握那附近的信息。";
				mes "他应该能帮助你。";
				break;
			}
			else if (ep13_3_secret == 9) {
				mes "[Shay]";
				mes "你说 BK 是这么说的？";
				mes "So it is...";
				mes "我也觉得 Ahat 比一般人漂亮。";
				next;
				mes "[Shay]";
				mes "但根据我在酒馆听到的萨帕故事，";
				mes "他们描述的 Ahat 各不相同。";
				next;
				mes "[Shay]";
				mes "但 BK 说 Ahat 不是萨帕？";
				mes "那意味着不同的不只是外貌，他可能完全属于另一个种族。";
				next;
				mes "[Shay]";
				mes "我们只能调查。";
				mes "听说他来自裂缝，那我们就调查裂缝。";
				next;
				mes "[Shay]";
				mes "但这里也有裂缝？";
				mes "……厄运太多了。";
				mes "有点悲伤。";
				set ep13_3_secret, 10;
				changequest 7192,7193;
				break;
			}
			else if (ep13_3_secret == 10) {
				mes "[Shay]";
				mes "去现场总是更好。";
				mes "因为很难见到大臣。";
				next;
				mes "[Shay]";
				mes "这里的裂缝一定是在梦罗克裂缝出现时形成的。";
				mes "如果真是他做的。";
				next;
				mes "[Shay]";
				mes "你会在迪卡斯特斯东北方找到裂缝。";
				mes "去那里调查一下。";
				break;
			}
			else if (ep13_3_secret == 11) {
				mes "[Shay]";
				mes "有进展吗？";
				next;
				setarray .@quest, 7194,7195,7196;
				setarray .@item, 6306,6305,6307;
				setarray .@str$, "bloodstain","frozen piece of skin","strange magical stone fragment";
				
				for (set .@size, getarraysize(.@item); .@i < .@size; set .@i, .@i + 1) {
					if (countitem(.@item[.@i])) {
					mes "-你展示了在裂缝附近收集的" + .@str$[.@i] + "。-";
						set .@crack, 1;
						next;
						break;
					}
				}
				if (!.@crack) {
					mes "-你没有任务所需的物品。Case3";
					mes "如果任务物品被破坏，请向 GM 求助。-";
					break;
				}

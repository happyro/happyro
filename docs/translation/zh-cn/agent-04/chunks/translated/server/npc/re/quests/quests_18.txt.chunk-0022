// Quest: Helping the Children. Step 1.
rachel,38,44,3	script	Samariam#ep18	4_M_CHILD1,{
	if (BaseLevel < 170) {
			mes "-此任务仅限 170 级及以上玩家-";
		close;
	}
	if (isbegin_quest(16581) == 0) {
		mes "[Samariam]";
		mes "伙计，我渴了。能帮我弄点水吗？你家离这里最近。";
		next;
		mes "[Karl]";
		mes "你家里有吃的吗？如果没有，能买些干果吗？";
		mes "伙计，你真好。";
		next;
		mes "[Naiman]";
		mes "这里……没有吃的。";
		mes "我没有钱……";
		next;
		mes "[Lukshi]";
		mes "喂，这家连吃的都没有吗？";
		mes "你只是小气，对吧？";
		next;
		mes "[Samariam]";
		mes "真令人失望，Naiman。";
		mes "我还以为你是个善良的人。";
		next;
		mes "[Naiman]";
		mes "哦，不！";
		mes "我们有水，我去拿一些。";
		next;
		mes "[Samariam]";
		mes "好吧。水会被浪费掉的。我们的份呢？";
		mes "连水都要用钱买，可你却说自己没钱。";
		setquest 16581;
		close;
	}
	mes "[Samariam]";
	mes "啊，玩了这么久，我又饿又渴。";
	mes "真想坐在凉快的地方，喝些加了干果的冰茶。";
	close;

OnInit:
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "BaseLevel >= 170 && isbegin_quest(16581) == 0" );
	end;
}

// Quest: Helping the Children. Step 2.
rachel,37,42,7	script	Karl#ep18	4_M_RACHMAN1,{
	if (isbegin_quest(16581) == 1) {
		mes "[Karl]";
		mes "你为什么没有钱？你爸爸不是在 Lukshi 的当铺工作吗？";
		mes "难道是因为 Lukshi 的妈妈没有给你爸爸钱？";
		next;
		mes "[Lukshi]";
		mes "我们妈妈会给你爸爸钱，可你连一个特价水果都不愿意买给我们？";
		next;
		mes "[Samariam]";
		mes "好了，别说了。真可怜～别再说我们没钱了。";
		next;
		mes "[Naiman]";
		mes "不！！！才不可怜……";
		mes "才不可怜……！！";
		next;
		mes "[Samariam]";
		mes "哦，对不起～我开玩笑的。";
		mes "你为什么突然认真又生气了？好可怕……";
		next;
		mes "[Samariam]";
		mes "我听说本地人有点暴躁，但也不至于一个接一个地生气吧？";
		mes "不是吗？";
		next;
		mes "[Karl]";
		mes "对，就是这样。即使生气，也要学会忍耐，才能一起玩。";
		mes "我们愿意和你这样的孩子一起玩，你应该心怀感激。";
		completequest 16581;
		setquest 16582;
		close;
	}
	mes "[Karl]";
	mes "我想喝加很多冰块的甜茶。";
	mes "那样玩起来会更有趣！";
	next;
	mes "[Karl]";
	mes "现在太热了，我也渴了。";
	mes "但我也不想回家。";
	close;

OnInit:
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "isbegin_quest(16581) == 1" );
	end;
}

// Quest: Helping the Children. Step 3.
rachel,40,45,3	script	Lukshi#ep18	4_M_DST_CHILD,{
	if (isbegin_quest(16582) == 1) {
		mes "[Lukshi]";
		mes "没错，你应该感谢我们！";
		next;
		select( "我再也受不了了。", "别再烦我们了。" );
		mes "[Lukshi]";
		mes "嗯？我们玩的时候你来打断我们，你是谁？";
		mes "你看起来不像这里的人……为什么要多管闲事？";
		next;
		select( "这叫玩吗？", "这是玩闹，不是骚扰。" );
		mes "[Samariam]";
		mes "因为年龄不同，我们和你有些差异也是难免的～";
		mes "这个人是这里的本地人，而我们都是移民。";
		next;
		mes "[Samariam]";
		mes "大家都知道本地人比移民差一些，对吧？";
		mes "不过，我们还是像这样一起玩。";
		next;
		mes "[Naiman]";
		mes "不！谁说的？本地人和移民有什么区别！";
		next;
		mes "[Karl]";
		mes "又开始大喊了。";
		mes "你证明了本地人更加暴躁。";
		next;
		select( "你的行为会让人生气。", "当然，你那样说话谁都会生气。" );
		mes "[Samariam]";
		mes "但这是真的，不是吗？";
		mes "Naiman 的爸爸在 Lukshi 的店里工作，Lukshi 的妈妈总是这么说。";
		next;
		mes "[Samariam]";
		mes "本地人学东西晚，而且脾气暴躁。";
		mes "不过，雇用这样的本地人并给他们发工资的阿姨很了不起，对吧？";
		erasequest 16582;
		setquest 16583;
		close;
	}
	mes "[Lukshi]";
	mes "我们家有冰饮和点心！";
	mes "但那里太远了……Naiman 的家不是离这里最近吗？";
	close;

OnInit:
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "isbegin_quest(16582) == 1" );
	end;
}

// Quest: Helping the Children. Step 4 (final).
rachel,36,45,5	script	Naiman#ep18	4_F_DST_CHILD,{
	if (isbegin_quest(16583) == 1) {
		if (checkweight(1000405,10) == 0) {
			mes "[Notice]";
			mes "-你的背包已满。请检查携带物品的重量和数量，然后再来找我。-";
			close;
		}
		mes "[Naiman]";
		mes "......";
		next;
		select( "你为什么和这些孩子一起玩？" );
		mes "[Naiman]";
		mes "什么，什么？";
		next;
		select( "你为什么任由他们这样对待你？" );
		mes "[Naiman]";
		mes "嗯……他们是我的朋友。";
		mes "如果没有他们，我就没有可以一起玩的人了。";
		next;
		mes "[Samariam]";
		mes "看吧？Naiman 是因为喜欢才和我们一起玩的。";
		mes "如果我们真的在烦他，他就不会和我们一起玩了。";
		next;
		mes "[Lukshi]";
		mes "我早就知道外国人爱多管闲事，不过……";
		mes "别插手你不了解的事情。";
		next;
		mes "[Naiman]";
		mes "我……我要回家拿些水。";
		mes "还有……对不起，我不该无缘无故生气。";
		next;
		cloakonnpcself( "Naiman#ep18" );
		mes "[Samariam]";
		mes "嗯，一起玩的时候总会发生一些事，对吧？";
		mes "别太担心。";
		next;
		cloakonnpcself( "Samariam#ep18" );
		mes "[Lukshi]";
		mes "我们去别的地方玩吧。";
		mes "把这个爱多管闲事的外国人留在这里。";
		next;
		cloakonnpcself( "Lukshi#ep18" );
		mes "[Karl]";
		mes "好，就这么办。";
		mes "再见，外国冒险者！";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "……感觉自己获得了一些人生经验。";
		mes "虽然不算是什么愉快的感受，不过……";
		cloakonnpcself( "Karl#ep18" );
		erasequest 16583;
		getitem 1000405,10;	// Ep18_Amethyst_Fragment
		close;
	}
	mes "[Naiman]";
	mes "好热……我想回家。";
	mes "但其他人还想继续玩……";
	close;

OnInit:
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "isbegin_quest(16583) == 1" );
	end;
}

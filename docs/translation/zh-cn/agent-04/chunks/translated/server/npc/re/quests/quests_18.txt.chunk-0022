		mes "我已经……";
		mes "离开拉赫";
		next;
		mes "[Horim]";
		mes "...";
		next;
		select( "离开的原因" );
		mes "[" + strcharinfo(0) + "]";
		mes "你说跟随是因为朋友和家人都离开了，对吧？";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "那为什么还要坚持？";
		next;
		mes "[Horim]";
		mes "冒险者……";
		mes "好。那么，冒险者，你有必须回去的地方吗？";
		mes "首先，过去来我工作地点的许多客人都不是冒险者。";
		next;
		mes "[Horim]";
		mes "但我需要一个可以回去的地方。";
		mes "一个向大家道晚安、关灯并入睡的地方。";
		next;
		mes "[Horim]";
		mes "不是因为我孤独……";
		mes "...";
		next;
	mes "Horim 想说些什么，却咽了口唾沫。";
		next;
		mes "[Horim]";
		mes "也有这样的人。";
		next;
		mes "[Horim]";
		mes "……走吧。";
		next;
		mes "[Gatekeeper]";
		mes "这是要进城的人吗？";
		next;
		mes "[Horim]";
		mes "?";
		next;
		mes "[Gatekeeper]";
	mes "我听说过这个故事。如果是带你来的人，就可以信任。进来吧。";
		next;
		mes "[Horim]";
	mes "什么事？";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "这是入口。";
		mes "进入。";
		close2;
		erasequest 8702;
		setquest 8703;
		warp "wolfvill",270,26;
		end;
	}
	end;

OnInit:
	questinfo( QTYPE_QUEST2, QMARK_YELLOW, "isbegin_quest(8702) == 1" );
	end;
}

// Quest: Childhood Friends. Step 8 (final).
wolfvill,271,26,0	script	#HorimG	HIDDEN_WARP_NPC,4,4,{
	end;
OnTouch_:
	if (isbegin_quest(8703) == 1)
		cloakoffnpcself( "Horim#ep1815" );
	end;
}

wolfvill,266,26,5	script(CLOAKED)	Horim#ep1815	4_M_RACHMAN2,{
	if (checkweight(1000405,20) == 0) {
		mes "- 等一下！！ -";
		mes "-你目前携带的物品-";
		mes "-太多了。-";
		mes "-请在减轻负重后-";
		mes "-再试一次。-";
		close;
	}
	if (ep18_main < 36)
		end;
	if (isbegin_quest(8703) == 1) {
		mes "[" + strcharinfo(0) + "]";
		mes "就在这里。";
		next;
		mes "[Horim]";
		mes "...";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "你失望吗？";
		next;
		mes "[Horim]";
		mes "不。";
		next;
		mes "[Horim]";
		mes "我要寻找家人。";
		mes "他们一定就在某处，对吧？";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "我相信你会很高兴，因为我没有抛弃你。";
		mes "正如你所说，你很擅长努力工作，我会欢迎你的加入。";
		next;
		mes "[Horim]";
		mes "哎呀……";
		next;
		mes "[Horim]";
		mes "谢谢。";
		next;
		mes "[Horim]";
		mes "非常感谢！";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "我现在可以走了吗？";
		next;
		mes "[Horim]";
		mes "当然。";
		mes "今晚……我已经很久没有向大家道晚安了。";
		next;
		mes "[Horim]";
		mes "愿你的旅途得到祝福，冒险者……";
		completequest 8703;
		getitem 1000405,20;	// Ep18_Amethyst_Fragment
		getexp 7769124,3000000;
		mes "^4d4dff你将获得有利的评价。^000000";
		add_reputation_points(REPUTATION_EP18, 100);
		if (get_reputation_points(REPUTATION_EP18) >= 1000 && ep18_main == 36) {// Custom implementation: reputation 1000 on wolfvill => player can continue the main quest
			ep18_main = 37;
			setquest 18082;
			mes "^4d4dff灰狼村的村民已接受你成为村子的一员。^000000";
			mes "你有资格参加^4d4dff会议。^000000";
		}
		// next;
		close2;
		cloakonnpcself( "Horim#ep1815" );
		end;
	}
	end;

OnInit:
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "isbegin_quest(8703) == 1" );
	end;
}

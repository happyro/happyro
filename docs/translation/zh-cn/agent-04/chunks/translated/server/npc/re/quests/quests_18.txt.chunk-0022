// Quest: Price of Labor. Step 1 + 3 (final).
rachel,181,51,3	script	Amodipin#ep18	4_M_MIDDLE,{
	if (checkweight(1000405,10) == 0) {
		mes "[Notice]";
		mes "-你的背包已满。请检查携带物品的重量和数量，然后再来找我。-";
		close;
	}
	if (BaseLevel < 170) {
		mes "-此任务仅限 170 级及以上玩家-";
		close;
	}
	if (isbegin_quest(16584) == 0) {
		mes "[Amodipin]";
		mes "他们今天还是没有发工资。已经三个月了……";
		mes "我真想马上辞掉这家店的工作，但那样就拿不到拖欠的工资了。";
		next;
		mes "[Amodipin]";
		mes "而且，如果辞职的传闻传开，作为本地人，我也无法在其他店里工作。";
		mes "唉，我该怎么办……";
		next;
		mes "[Amodipin]";
		mes "哦，你刚才在听我的故事吗？";
		mes "看你的打扮，你一定是冒险者。真幸运，能过着冒险者那样自由的生活……";
		next;
		mes "[Amodipin]";
		mes "嗯，恕我冒昧，但我想请你帮个忙。";
		mes "虽然老板假装在听我说话，但如果是你这样的知名冒险者提出的建议，我想他会重视。";
		next;
		mes "[Amodipin]";
		mes "你能去我老板的店里催他发工资吗？";
		mes "照这样下去，我连明天的饭都买不起了。";
		next;
		if (select( "我来帮你。", "我为什么要帮你？" ) == 2) {
			mes "[Amodipin]";
			mes "你不一定非要这么做。";
			mes "我只是想问问你能不能帮点忙。";
			close;
		}
		mes "[Amodipin]";
		mes "谢谢你，谢谢！";
		mes "我老板的店就在<NAVI>[这里]<INFO>rachel,136,95,0,101,0</INFO></NAVI>。";
		setquest 16584;
		close;
	}
	if (isbegin_quest(16585) == 1) {
		mes "[Amodipin]";
		mes "你来了。有好消息吗？";
		next;
		select( "告诉他事情经过。" );
		mes "[Amodipin]";
		mes "他们明天会发拖欠的工资！哦，太谢谢你了，我真的很感激。";
		mes "现在我可以给孩子们买食物和衣服了。";
		next;
		mes "[Amodipin]";
		mes "我明天可能会挨骂，但说实话，终于拿到工资让我更开心。";
		mes "挨骂没什么，只是一两天而已。";
		next;
		mes "[Amodipin]";
		mes "你不生气吗？当然生气。";
		mes "但我又能怎么办？生为本地人是我的错。";
		next;
		mes "[Amodipin]";
		mes "我甚至哪里也逃不掉。";
		mes "我听说有个村子住着逃到维因斯的本地人，但不知道那地方是否真的存在。";
		next;
		mes "[Amodipin]";
		mes "但就算存在，我也没有勇气住在那里。唉，我说得太多了。";
		mes "抱歉耽误你这么久。非常感谢！";
		erasequest 16585;
		getitem 1000405,10;	// Ep18_Amethyst_Fragment
		close;
	}
	mes "[Amodipin]";
		mes "每天担心饭菜，担心孩子……没有一天不忧虑。";
		mes "我为什么要生为本地人，承受这些不必要的苦难。";
	close;

OnInit:
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "BaseLevel >= 170 && isbegin_quest(16584) == 0" );
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "isbegin_quest(16585) == 1" );
	end;
}

// Quest: Price of Labor. Step 2.
rachel,136,95,3	script	Dahil#ep18	4_M_RACHMAN2,{
	if (isbegin_quest(16584) == 1) {
		mes "[Dahil]";
		mes "欢迎，我是 Dahil。";
		mes "很高兴见到你。看你的装扮，你一定是冒险者！";
		next;
		mes "[Dahil]";
		mes "我真的很喜欢冒险者！";
		mes "我曾经也梦想成为冒险者，但后来膝盖中了一箭，现在只能困在城里。";
		next;
		mes "[Dahil]";
		mes "如果你不介意，能一边给我讲冒险故事，一边看看商品吗？";
		next;
		select( "我是来谈另一件事的。" );
		mes "[Dahil]";
		mes "另一件事？";
		mes "嗯，是关于 Amodipin 的工资吗？是 Amodipin 让你来谈的吗？";
		next;
		mes "[Dahil]";
		mes "嗯，Amodipin 可能知道，但店里的情况并不好。";
		mes "我答应下个月一次性付清，不过要借助我最喜欢的冒险者。";
		next;
		mes "[Dahil]";
		mes "这样躲在别人背后公平吗？";
		mes "你看起来很擅长工作，所以我雇了你，但也许我该重新考虑是否雇用本地人。";
		next;
		select( "你这是什么意思？" );
		mes "[Dahil]";
		mes "哦，别担心，冒险者。这是本地人长期以来的问题。";
		mes "他们软弱，喜欢躲在别人身后。";
		next;
		select( "不过，扣留工资是不对的。", "这不是歧视吗？" );
		mes "[Dahil]";
		mes "谁不知道呢？就算知道，没有钱又能怎么办？";
		mes "嗯，Amodipin 的工资最后发，但这也没办法。";
		next;
		mes "[Dahil]";
		mes "这不是歧视本地人。";
		mes "只是他最后来上班，所以发放顺序就是这样。";
		next;
		mes "[Dahil]";
		mes "唉，我为什么要只和冒险者谈这些？";
		mes "告诉 Amodipin 明天来拿工资，别再胡闹了。";
		next;
		mes "[Dahil]";
		mes "这次的事我不会处罚你，但请告诉<NAVI>[Amodipin]<INFO>rachel,181,51,0,101,0</INFO></NAVI>好好来工作。";
		mes "我不是歧视本地人的人，只是他们缺乏责任感，所以我训斥几句就算了。";
		completequest 16584;
		setquest 16585;
		close;
	}
	mes "[Dahil]";
	mes "我现在经营这家店，但我真的很喜欢冒险者！";
	mes "我曾经也梦想成为冒险者，但后来膝盖中了一箭，只能困在城里。";
	close;

OnInit:
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "isbegin_quest(16584) == 1" );
	end;
}

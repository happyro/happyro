	enablenpc instance_npcname("Taho#Completed");
	initnpctimer;
	end;
OnTimer1000:
	monster instance_mapname("1@ma_b"),78,74,"Bakonawa Treasure Box",2335,1;
	end;
OnTimer10000:
	mapannounce instance_mapname("1@ma_b"),"塔霍：打开宝箱后，请到山顶来找我。我有东西要给你。",bc_map,"0x00ffff"; //FW_NORMAL 15 0 0
	stopnpctimer;
	end;
}

1@ma_b,62,52,4	script	Taho#Fail	541,{
	mes "[塔霍]";
	mes "嗯。我们差点抓到它了，但它真是个敏捷的生物……";
	next;
	if (is_party_leader() == true) {
		mes "[塔霍]";
		mes "我们要再试一次吗？";
		next;
		switch(select("等一下！：当然！现在不能退缩！")) {
		case 1:
			mes "[塔霍]";
			mes "啊……我差点把它引出来了。";
			close;
		case 2:
			mes "[塔霍]";
			mes "那我再把阿尔博帕尔投入湖中。";
			next;
			mes "[塔霍]";
			mes "我们马上就能看到更加愤怒的巴科纳瓦……";
			disablenpc instance_npcname("Taho#Fail");
			donpcevent instance_npcname("#Bakonawan1")+"::OnStart";
			close;
		}
		close;
	} else {
		mes "[塔霍]";
		mes "我要像刚才一样投下阿尔博帕尔。希望能激怒它……";
		close;
	}

OnInstanceInit:
	disablenpc instance_npcname("Taho#Fail");
	end;
OnStart:
	enablenpc instance_npcname("Taho#Fail");
	end;
}

//===== rAthena Script ======================================= 
//= Mercenary related NPCs
//===== By: ================================================== 
//= L0ne_W0lf
//===== Current Version: ===================================== 
//= 1.5
//===== Compatible With: ===================================== 
//= rAthena Project
//===== Description: ========================================= 
//= [Official Conversion]
//= Sells Lancer, Sword, and Archer mercenaries,
//= along with related mercenary items.
//===== Additional Comments: ================================= 
//= 1.0 First version. [L0ne_W0lf]
//= 1.1 Optimization. [Zephyrus]
//= 1.2 Removed redundent input. [L0ne_W0lf]
//= 1.3 Duplicates now spawned from floating NPCs. [L0ne_W0lf]
//= 1.4 Optimized and fixed wrong item id. [Joseph]
//= 1.5 Added Mercenary Guild Switch & fixed a bug
//=		in izlude duplicate. [Capuche]
//= 1.5a Change to F_GM_NPC function in Mercenary Guild Switch
//============================================================ 

-	script	Mercenary Manager#main	-1,{
	setarray .@name$, 	"Spear", 			"Sword", 			"Bow";
	setarray .@faith$, 	"SPEAR_MERC_GUILD",	"SWORD_MERC_GUILD",	"ARCH_MERC_GUILD";
	setarray .@item, 	12182,				12172,				12162;
	.@npc$ = strnpcinfo(2);
	for (.@size = getarraysize(.@name$); .@type < .@size; .@type++)
		if( compare( .@npc$,.@name$[.@type] ) ) break;
	.@faith_merc = mercenary_get_faith(getd(.@faith$[.@type]));
	mes "[佣兵管理员]";
	mes "欢迎来到";
	mes .@name$[.@type] + "佣兵公会。";
	mes "需要我为你做什么？";
	next;
	switch(select("雇佣佣兵:佣兵信息:没什么:十阶佣兵")) {
		case 1:
			mes "[佣兵管理员]";
			mes "你想雇佣";
			mes .@name$[.@type] + "佣兵吗？";
			mes "你想雇佣哪个";
			mes "阶级？";
			next;
			for (.@i = 1; .@i <= 9; .@i++)
				.@menu$ = .@menu$ + callfunc("F_GetNumSuffix",.@i) + " 阶" + .@name$[.@type] + " Mercenary:";
			.@阶= select(.@menu$);
			.@BaseLevel = 5 + (.@阶* 10);
			.@BaseLevel = (.@val > 90)? 90 : .@BaseLevel;
			.@ZenyCost = 7 * .@Grade;
			setarray .@FaithCost[7], 50,100,300;
			.@FaithCost = .@FaithCost[.@Grade];
			mes "[佣兵管理员]";
			mes "所以你想雇佣一名" + callfunc("F_GetNumSuffix",.@Grade);
			mes "阶" + .@name$[.@type] + "级佣兵吗？";
			mes "你的基础等级必须达到";
			mes .@BaseLevel + "级或更高，并且";
			mes "需要支付" + .@ZenyCost + ",000 Zeny 费用。";
			next;
			if(select("Yes:No") == 2) {
				mes "[佣兵管理员]";
				mes "哦，真的吗？那么现在";
				mes "可能不是适合";
				mes "考虑雇佣佣兵的时候";
				mes "佣兵，但如果情况改变";
				mes "欢迎随时回来。感谢你～";
				mes "你的需求";
			}
			else if(.@FaithCost && .@faith_merc < .@FaithCost) {
				mes "[佣兵管理员]";
				mes "哦……你在";
				mes .@name$[.@type] + "佣兵公会的忠诚度";
				mes "不足以";
				mes "雇佣这名佣兵。请在";
				mes "获得";
				mes "" + .@FaithCost + "或更多忠诚度后再来。";
			}
			else if (BaseLevel < .@BaseLevel) {
				mes "[佣兵管理员]";
				mes "抱歉，你的基础";
				mes "等级不够高";
				mes "，无法雇佣这名佣兵。";
				mes "达到基础等级";
				mes "达到基础等级 " + .@BaseLevel + " 级后再来找我。";
			}
			else if (Zeny < .@ZenyCost * 1000) {
				mes "[佣兵管理员]";
				mes "抱歉，你";
				mes "没有足够的 Zeny";
				mes "，无法雇佣这名佣兵。";
				mes "雇佣费用为" + .@ZenyCost + ",000 Zeny。";
			}
			else {
				mes "[佣兵管理员]";
				mes "太好了！我们的佣兵";
				mes "真诚而忠诚，致力于";
				mes "保护客户。";
				mes "召唤出的佣兵会";
				mes "为你提供支援，持续";
				mes "30分钟。请多保重。";
				Zeny = Zeny - (.@ZenyCost * 1000);
				getitem .@item[.@type] - 10 + .@Grade, 1;
			}
			close;
		case 2:
			mes "[佣兵管理员]";
			mes "佣兵是士兵";
			mes "会在战场上与你并肩作战";
			mes "但";
			mes "雇佣他们需要满足一些";
			mes "条件。";
			next;
			mes "[佣兵管理员]";
			mes "你必须满足等级要求";
			mes "并支付 Zeny";
			mes "费用才能雇佣佣兵。";
			mes "更高阶的佣兵";
			mes "还要求你";
			mes "与我们建立忠诚度。";
			next;
			mes "[佣兵管理员]";
			mes "佣兵契约不能";
			mes "转让给他人，";
			mes "而且佣兵与客户的基础等级差只能是 5 级，";
			mes "因此不能雇佣远强于自己的佣兵。";
			next;
			mes "[佣兵管理员]";
			mes "具体细节可以在";
			mes "与佣兵签订契约并";
			mes "获得能";
			mes "召唤佣兵到身边的";
			mes "召唤卷轴时了解。";
			mes "佣兵";
			next;
			mes "[佣兵管理员]";
			mes "你不能把这张卷轴";
			mes "交给别人；佣兵";
			mes "只会在你";
			mes "召唤后陪伴";
			mes "30 分钟。别忘了";
			mes "时间限制，好吗？";
			close;
		case 3:
			mes "[佣兵管理员]";
			mes "没有？你不需要";
			mes "帮助？如果有";
			mes "关于佣兵的问题，欢迎";
			mes "随时来问我。";
			close;
		case 4:
			mes "[佣兵管理员]";
			mes "十阶佣兵是";
			mes "我们能提供的最佳佣兵，";
			mes "雇佣条件也不同。";
			mes "";
			mes "无需支付 Zeny，但你";
			mes "必须拥有 500 点忠诚度。";
			next;
			mes "[佣兵管理员]";
			mes "一旦与";
			mes "与十阶佣兵签订契约，";
			mes "你的忠诚度会";
			mes "降低 400。换句话说，";
			mes "你要付出 400 点忠诚度";
			mes "来雇佣十阶佣兵。";
			next;
			mes "[佣兵管理员]";
			mes "此外，你的";
			mes "基础等级必须达到 90 级，才能";
			mes "雇佣十阶佣兵。";
			mes "你还想";
			mes "签订这份契约吗？";
			next;
			if (select("是:否") == 2) {
				mes "[佣兵管理员]";
				mes "我明白……要达到";
				mes "这一境界需要努力和牺牲，";
				mes "才能";
				mes "雇佣十阶";
				mes "佣兵。你考虑过雇佣";
				mes "雇佣低阶佣兵吗？";
			}
			else if (.@faith_merc < 500) {
				mes "[佣兵管理员]";
				mes "抱歉，你的";
				mes "忠诚度太";
				mes "低，无法雇佣十阶";
				mes "佣兵。你必须拥有";
				mes "至少 500 点忠诚度才能";
				mes "与其签订契约。";
			}
			else if (BaseLevel < 90) {
				mes "[佣兵管理员]";
				mes "抱歉，你必须";
				mes "达到基础等级 90 级或";
				mes "更高才能签订";
				mes "与十阶佣兵签订契约。";
			}
			else {
				mes "[佣兵管理员]";
				mes "恭喜！看来";
				mes "你准备承担";
				mes "非常危险的工作，";
				mes "因为你正在雇佣十";
				mes "阶佣兵。祝你";
				mes "好运。";
				mercenary_set_faith getd(.@faith$[.@type]),-400;
				getitem .@item[.@type],1;
			}
			close;
	}
}
prontera,41,337,5	duplicate(Mercenary Manager#main)	Mercenary Manager#Spear	8W_SOLDIER
pay_arche,99,167,4	duplicate(Mercenary Manager#main)	Mercenary Manager#Bow	4_M_JOB_HUNTER

// Mercenary Merchant NPCs
//============================================================
-	script	Mercenary Merchant#dummy::MercMerchant	-1,{
	mes "[佣兵货物商]";
	mes "你好，我出售";
	mes "佣兵可以使用的";
	mes "物品。有什么";
	mes "特别";
	mes "想找的吗？";
	next;
	setarray .@item, 12184,	12185,	12241,	12242,	12243;
	setarray .@cost, 2500,	5000,	800,	1500,	3000;
	for (.@size = getarraysize(.@item); .@i < .@size; .@i++)
		.@menu$ = .@menu$ + getitemname(.@item[.@i]) + ":";
	.@m = select(.@menu$)-1;
	.@str$ = .@cost[.@m] + "";
	.@len = getstrlen(.@str$);
	.@str_cost$ = (.@len <= 3)? .@str$ : insertchar(.@str$,",",.@len-3);
	mes "[佣兵货物商]";
	mes getitemname(.@item[.@m]);
	mes "每个售价 " + .@str_cost$ + " Zeny。";
	mes "你想买多少？";
	next;
	input .@input;
	if (!.@input) {
		mes "[佣兵货物商]";
		mes "改变主意了吗？";
		mes "好的，需要购买佣兵";
		mes "药水时随时";
		mes "回来找我。";
		close;
	}
	else if (.@input < 0 || .@input > 10000) {
		mes "[佣兵货物商]";
		mes "抱歉，你";
		mes "一次最多只能购买";
		mes "10,000 瓶药水";
		mes "。请输入";
		mes "1 到 10,000 之间的数字。";
		close;
	}
	else if (set(.@total_po, .@input * .@cost[.@m]) > Zeny) {
		mes "[佣兵货物商]";
		mes "抱歉，你 don't";
		mes "Zeny 购买这么多药水。准备好";
		mes "后我会";
		mes "一直在这里，";
		mes "等你购买";
		mes "佣兵用品。";
		close;
	}
	else if (!checkweight(.@item[.@m], .@input)) {
		mes "[佣兵货物商]";
		mes "如果给你这么多药水，";
		mes "你将无法";
		mes "携带它们。";
		mes "请清理";
		mes "背包空间后再回来。";
		mes "。";
		close;
	}
	mes "[佣兵货物商]";
	if (.@input == 1) 
		mes "这是你的 " + getitemname(.@item[.@m]) + ".";
	else {
		mes "给你，这正好是";
		mes callfunc("F_InsertPlural",.@input,getitemname(.@item[.@m])) + ".";
	}
	mes "谢谢，之后需要更多";
	mes "时请再来，";
	mes "佣兵用品。";
	Zeny = Zeny - .@total_po;
	getitem .@item[.@m], .@input;
	close;
}
prontera,30,337,4	duplicate(MercMerchant)	Mercenary Merchant#Spear	8_F_GIRL
pay_arche,102,167,5	duplicate(MercMerchant)	Mercenary Merchant#Bow	4_F_CAPEGIRL

// Mercenary Switch NPCs
//============================================================
-	script	Mercenary_Switch	-1,{

	setarray .@name$, "Spear","Sword","Bow";
	.@npc$ = strnpcinfo(2);
	for (.@size = getarraysize(.@name$); .@type < .@size; .@type++)
		if (.@npc$ == .@name$[.@type]) break;

	mes "[检查员]";
	mes "请输入密码。";
	next;
	.@i = callfunc("F_GM_NPC",1854,0,0,10000);
	mes "[检查员]";
	if (.@i == -2)
		mes "错误。";
	else if (.@i == 0)
		mes "数字错误";
	else if (.@i == 1) {
		mes "请选择。";
		next;
		switch( select( "关闭佣兵 NPC","开启佣兵 NPC" ) ) {
		case 1:
			mes "NPC 已关闭。";
			disablenpc "Mercenary Manager#" + .@name$[.@type];
			disablenpc "Mercenary Merchant#" + .@name$[.@type];
			break;
		case 2:
			mes "NPC 已开启。";
			enablenpc "Mercenary Manager#" + .@name$[.@type];
			enablenpc "Mercenary Merchant#" + .@name$[.@type];
			break;
		}
	}
	close;
}
prontera,299,379,5	duplicate(Mercenary_Switch)	Mercenary Switch#Spear	8W_SOLDIER
pay_arche,170,185,5	duplicate(Mercenary_Switch)	Mercenary Switch#Bow	4_F_CAPEGIRL
izlude,245,250,4	duplicate(Mercenary_Switch)	Mercenary Switch#Sword	4_F_HUWOMAN

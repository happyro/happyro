}

job_wiz,1,6,1	script	Room of Fire#Door	66,{
OnInit:
	disablenpc "Room of Fire#Door";
	end;

OnEnable:
	enablenpc "Room of Fire#Door";
	donpcevent "Room of Fire::OnDisable";
	set .MyMobs,3;
	monster "job_wiz",44,99,"Greatest General",1277,1,"Room of Fire#Door::OnMyMobDead";
	if (checkre(0)) {
		monster "job_wiz",43,99,"Greatest General",1277,1,"Room of Fire#Door::OnMyMobDead";
		monster "job_wiz",45,99,"Greatest General",1277,1,"Room of Fire#Door::OnMyMobDead";
	}
	else {
		monster "job_wiz",43,99,"Horong",1129,1,"Room of Fire#Door::OnMyMobDead";
		monster "job_wiz",45,99,"Horong",1129,1,"Room of Fire#Door::OnMyMobDead";
	}
	initnpctimer;
	end;

OnDisable:
	killmonsterall "job_wiz";
	disablenpc "Room of Fire#Door";
	end;

OnMyMobDead:
	set .MyMobs,.MyMobs-1;
	if (.MyMobs < 1) {
		mapannounce "job_wiz","恭喜，"+strcharinfo(0)+"。你通过了转职测试。",bc_map;
		set WIZ_Q,7;
		changequest 9017,9018;
		donpcevent "Room of Fire#Door::OnDisable";
		donpcevent "Test Helper#wiz::OnEnable";
		stopnpctimer;
	}
	end;

OnTimer1000:
	mapannounce "job_wiz","守卫魔物出现了。你有 2 分钟。",bc_map;
	end;

OnTimer30000:
	mapannounce "job_wiz","剩余 1 分 30 秒。",bc_map;
	end;

OnTimer60000:
	mapannounce "job_wiz","剩余 1 分钟。",bc_map;
	end;

OnTimer90000:
	mapannounce "job_wiz","剩余 30 秒。",bc_map;
	end;

OnTimer110000:
	mapannounce "job_wiz","剩余 10 秒。",bc_map;
	end;

OnTimer120000:
	mapannounce "job_wiz","时间到。",bc_map;
	donpcevent "Room of Fire#Door::OnDisable";
	end;

OnTimer121000:
	enablenpc "Room of Fire#Failed";
	end;

OnTimer122000:
	mapannounce "job_wiz","下一位候选人，请进入。",bc_map;
	end;

OnTimer123000:
	disablenpc "Room of Fire#Failed";
	donpcevent "Room of Fire#Door::OnDisable";
	donpcevent "Arena Assistant::OnStart";
}

job_wiz,46,99,0	script	Room of Fire#Failed	-1,16,16,{
OnInit:
	disablenpc "Room of Fire#Failed";
	end;

OnTouch_:
	warp "geffen",120,110;
	end;
}

job_wiz,1,7,1	script	Test Helper#wiz	66,{
	end;

OnInit:
	disablenpc "Test Helper#wiz";
	end;

OnEnable:
	initnpctimer;
	end;

OnDisable:
	disablenpc "Test Helper#wiz";
	end;

OnTimer2000:
	mapannounce "job_wiz","请回来完成剩余的转职流程。",bc_map;
	end;

OnTimer4000:
	mapannounce "job_wiz","测试到此结束。下一位候选人请待命。",bc_map;
	end;

OnTimer5000:
	areawarp "job_wiz",33,82,57,113,"gef_tower",110,30;
	end;

OnTimer7000:
	mapannounce "job_wiz","下一位候选人，请进入。",bc_map;
	end;

OnTimer9000:
	donpcevent "Test Helper#wiz::OnDisable";
	donpcevent "Arena Assistant::OnStart";
	stopnpctimer;
	end;
}

gef_tower,107,36,4	script	White Dog#wiz	81,{
	if (BaseJob != Job_Mage) {
		if (BaseJob == Job_Wizard) {
			cutin "job_wizard_maria01",2;
			mes "[Maria]";
			mes "与其待在这里，不如出去测试一下自己变得多强了？";
			next;
			mes "[Maria]";
			mes "别忘了，巫师每天都会成长并提升力量。";
			close2;
			cutin "job_wizard_maria01",255;
			end;
		}
		else if (BaseClass == Job_Novice) {
			cutin "job_wizard_maria01",2;
			mes "[Dog]";
			mes "什么？小鬼！";
			mes "狗说话就这么有趣吗？";
		}
		else {
			cutin "job_wizard_maria02",2;
			mes "[Dog]";
			mes "啧……连一个法术都不会施放的人，为什么要来这里？";
			mes "*噗* 这么无聊的话，就帮世界一个忙，从外面爬到这栋楼顶，到了之后表演杂技吧。";
		}
		next;
		mes "[Dog]";
		mes "*汪* 滚开！";
		mes "我没时间应付你这种人！";
		close2;
		cutin "job_wizard_maria02",255;
		end;
	}
	if (WIZ_Q == 0) {
		cutin "job_wizard_maria01",2;
		mes "[Dog]";
		mes "啊……我知道你想说什么。你想转职成巫师，对吧？";
		next;
		mes "[Dog]";
		mes "去和凯瑟琳谈谈。她会帮助你。";
		next;
		mes "[Dog]";
		mes "另外，如果你想了解转职流程，我可以说明。";
		next;
		switch(select("……:一只狗在和我说话……")) {
		case 1:
			mes "[Dog]";
			mes "……*汪*……？怎么了？？为什么那样看我？！";
			mes "你是第一次看到狗说话吗？";
			next;
			mes "[Dog]";
			mes "*汪* 我想你确实很少见到会说话的狗。汪～";
			mes "……是的，这确实很罕见……*低吼*……看够了吧！";
			next;
			mes "[Dog]";
			mes "我叫‘玛丽亚·斯普罗多夫斯卡’。叫我‘玛丽亚’就好。";
			mes "我在帮助想成为巫师的候选人。";
			next;
			cutin "job_wizard_maria03",2;
			mes "[Maria]";
			mes "*汪* 我变成狗的原因是……我帮男友进行魔法学位毕业考试实验。结果，*低吼* 他不小心把我变成了狗。";
			mes "理论上几个月后药剂就会失效，我应该能恢复正常。具体什么时候，我也不知道。";
			next;
			cutin "job_wizard_maria01",2;
			mes "[Maria]";
			mes "嗯……这与你无关。";
			mes "我们刚才说到哪里了？";
			next;
			break;
		case 2:
			cutin "job_wizard_maria02",2;
			mes "[Dog]";
			mes "*汪* *汪* *汪* 别说这种显而易见的事！好了，我知道自己是狗！";
			next;
			cutin "job_wizard_maria01",2;
			mes "[Dog]";
			mes "我叫‘玛丽亚·斯普罗多夫斯卡’，大家都叫我‘玛丽亚’。";
			mes "我在帮助像你这样想成为巫师的新人。";
			next;
			cutin "job_wizard_maria03",2;
			mes "[Dog called 'Maria']";
			mes "我变成狗的原因是……男友为魔法学位进行实验时，不小心把我变成了狗。";
			mes "理论上几个月后药剂会失效，我应该恢复正常。具体什么时候，我也不知道。";
			next;
			cutin "job_wizard_maria02",2;
			mes "[Dog called 'Maria']";
			mes "我不是叫‘玛丽亚’的‘狗’！！喂！！听我说！！";
			next;
			mes "[Dog... 'Maria'...]";
			mes "..........";
			next;
			mes "[Maria]";
			mes "……*汪* *汪* *汪*……我很生气，不过算了！！你看起来很忙，我就不计较了。";
			next;
			break;
		}
		cutin "job_wizard_maria01",2;
		mes "[Maria]";
		mes "如我之前所说，转职请去找凯瑟琳。";
		mes "她也是刚成为巫师。";
		next;
		mes "[Maria]";
		mes "我可以告诉你更多转职流程，但不能耽误忙碌的人，对吧？";
		mes "你觉得呢？要我说明魔法师成为巫师要经历什么吗？";
		next;
		switch(select("好的，请说明！:不用了。:一只会说话的狗……")) {
		case 1:
			cutin "job_wizard_maria01",2;
			mes "[Maria]";
			mes "好，我来为你说明流程。";
			next;
			mes "[Maria]";
			mes "转职流程有三项测试。";
			mes "第一项测试是收集魔法物品。";
			next;
			mes "[Maria]";
			mes "提交申请给凯瑟琳后，第一项测试就开始。";
			mes "她会让你收集各种宝石，或收集带属性的石头。";
			next;
			mes "[Maria]";
			mes "第二项测试是魔法问答，";
			mes "由角落里阴沉的劳雷尔负责。";
			next;
			mes "[Maria]";
			mes "题目涉及魔法、魔物和魔法师。";
			mes "十道题必须全部答对，否则他不会让你通过。换句话说，你会失败……";
			next;
			mes "[Maria]";
			mes "奇怪的是，第三项测试也由他负责。";
			mes "第三项测试是消灭魔物。";
			next;
			mes "[Maria]";
			mes "每个房间都有特定属性的魔物。";
			mes "你必须用相应属性的法术攻击它们。";
			next;
			mes "[Maria]";
			mes "好了，我能说的就这些。现在去申请吧。";
			next;
			mes "[Maria]";
			mes "与其听我的说明，不如亲自试试。";
			close2;
			cutin "job_wizard_maria01",255;
			warp "gef_dun00",116,102;
			end;
		case 2:
			mes "[Maria]";
			mes "真的吗？好，那就去申请并尽力而为吧。";
			close2;
			cutin "job_wizard_maria01",255;
			end;
		case 3:
			cutin "job_wizard_maria02",2;
			mes "[Maria]";
			mes "我不是狗！！嗷呜呜呜呜～";
			next;
			mes "[Maria]";
			mes "可恶！希望你失败！！滚开！！";
			close2;
			cutin "job_wizard_maria01",255;
			warp "gef_dun00",116,102;
			end;
		}
	}
	else if (WIZ_Q == 1) {
		cutin "job_wizard_maria01",2;
		mes "[Maria]";
		mes "你似乎迷路了……";
		mes "你已经申请，现在正在寻找物品，对吧？";
		next;
		mes "[Maria]";
		mes "不过这只是第一项测试，不要依赖别人。";
		mes "自己完成才是最好的方式。";
		next;
		mes "[Maria]";
		mes "听说你需要收集宝石……";
		mes "我不能直接帮助你，但可以给你一些建议。";
		next;
		mes "[Maria]";
		mes "首先，要获得红宝石，去普隆德拉下水道。";
		mes "那里有很多盗虫和盗虫卵，可以从它们身上获得。";
		next;
		mes "[Maria]";
		mes "黄宝石在沙漠中很容易找到。";
		mes "秃鹰、皮奇，有时石人之类的魔物会掉落。";
		next;
		mes "[Maria]";
		mes "还有……*汪* 要获得蓝宝石，可以去海底洞窟。";
		mes "海葵、海盗之王以及玛尔斯之类的魔物会掉落。";
		next;
		mes "[Maria]";
		mes "当然，也可以在城里的魔法商店买到蓝宝石……";
		mes "不过亲自寻找更有成就感，也会对之后的测试有所帮助。";
		next;
		mes "[Maria]";
		mes "总之，尽力而为吧。";
		mes "这就是成为巫师的基础。";
		close2;
		cutin "job_wizard_maria01",255;
		end;
	}
	else if (WIZ_Q == 2) {
		cutin "job_wizard_maria01",2;
		mes "[Maria]";
		mes "你似乎迷路了……";
		mes "你已经申请，现在正在寻找物品，对吧？";
		next;
		mes "[Maria]";
		mes "不过这只是第一项测试，不要依赖别人帮助。";
		mes "自己完成才是最好的方式。";
		next;
		mes "[Maria]";
		mes "听说你需要收集元素石……";
		mes "我不能直接帮助你，但可以给你一些建议。";
		next;
		mes "[Maria]";
		mes "你可以在海底洞窟找到水晶蓝。";
		mes "海葵、库克雷、海葵、海盗之王……这些魔物经常掉落。";
		next;
		mes "[Maria]";
		mes "昆虫型魔物会掉落绿色生物石。";
		mes "可以去狩猎大脚熊、螳螂或维塔塔之类的魔物。";
		next;
		mes "[Maria]";
		mes "还有，*汪* 红色血液。据说可以从……";
		mes "沙漠里的树精、金属波利或蝎子身上大量获得。";
		next;
		mes "[Maria]";
		mes "至于绿色风灵石，可以找蜂兵、毒刺或钢铁苍蝇。";
		mes "稍微努力一下就能很容易获得。";
		next;
		mes "[Maria]";
		mes "总之，永远尽力而为。";
		mes "这就是成为巫师的基础。";
		close2;
		cutin "job_wizard_maria01",255;
		end;
	}
	else if (WIZ_Q == 3) {
		cutin "job_wizard_maria01",2;
		mes "[Maria]";
		mes "刚通过第一项测试，别太放松。";
		mes "继续努力，你还有两项测试。";
		close2;
		cutin "job_wizard_maria01",255;
		end;
	}
	else if (WIZ_Q == 4) {
		cutin "job_wizard_maria01",2;
		mes "[Maria]";
		mes "呼……呼……呼……";
		next;
		cutin "job_wizard_maria02",2;
		mes "[Maria]";
		mes "*呜咽*……布利扎德里斯……你真差劲……呼……";
		close2;
		cutin "job_wizard_maria02",255;
		end;
	}
	else if (WIZ_Q == 5) {
		cutin "job_wizard_maria01",2;
		mes "[Maria]";
		mes "哦，你做得不错嘛？";
		next;
		mes "[Maria]";
		mes "那么努力坚持到最后吧。";
		mes "劳雷尔正在等你。";
		close2;
		cutin "job_wizard_maria01",255;
		end;
	}
	else if (WIZ_Q == 6) {
		cutin "job_wizard_maria01",2;
		mes "[Maria]";
		mes "*汪*……你放弃了吗？";
		mes "*叹气*……意志这么薄弱，你怎么能成为巫师？";
		next;
		mes "[Maria]";
		mes "你知道每个房间都有相同属性的魔物……";
		mes "作为使用魔法的人，你必须了解不同法术。";
		next;
		mes "[Maria]";
		mes "你还需要学会应对会使用技能的魔物。";
		mes "最好先消灭正在攻击你的魔物。";
		next;
		mes "[Maria]";
		mes "*低吼* 不管怎样，继续测试。";
		mes "别意志薄弱，*汪* 快回去！*汪* *汪* 就现在！*汪*";
		close2;
		cutin "job_wizard_maria01",255;
		end;
	}
	else if (WIZ_Q == 7) {
		cutin "job_wizard_maria01",2;
		mes "[Maria]";
		mes "果然如此，我就知道你能做到，我闻得出来！*汪*";
		mes "现在我可以称你为巫师了。";
		next;
		mes "[Maria]";
		mes "恭喜你。无论如何，做任何事都要全力以赴。";
		close2;
		cutin "job_wizard_maria01",255;
		end;
	}
}

//============================================================ 
// Old changelog
//============================================================ 
//= 1.1 Now using the initnpctimer command, donpcevent,
//= and new waitingroom event commands.  No more addtimer spamming.
//= No longer have to talk to the npc to take the test.  Just enter the chat room.
//= 1.2 Changed global variable names to unique ones.
//= 1.2a Rollback from the wrong Kashy's fix
//= 1.2b Fixed issue with duplicating monsters thx to Bison.[kobra_k88]
//= 1.2c changed one Horong to Frilldora (now 3rd room contains 1 agressive mob.)
//= 1.2d more simplified fire room - removed agressive Desert Wolf [Lupus]
//= 1.3 Added Baby Class support. 1.5 Fixed possible EXP abuse [Lupus]
//= 1.6 Added a func which prevent advanced classes passing
//= 2nd Job Quests again. It also guides adv classes where to go. [Lupus]
//= 1.7 Replaced 2 Hodes with 2 Horong's (according to the official guide) [Lupus]
//= 1.8 Removed callfunc Is_####_Class in favor of baseClass [Silentdragon]
//= 2.1 Changed numbers to constants. [Vicious]
//= 2.2 Merged back JFunc [Lupus] 2.2a Removed extra MES, added missing NEXT
//= 2.3 Bigfoot monster summon corrected [Zairik]

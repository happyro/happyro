// Prontera Culvert :: prt_npc
//============================================================
prt_in,88,105,2	script	Recruiter	105,{
	if (MISC_QUEST & 8) {
		mes "[招募员]";
		mes "啊……";
		mes "我认识那种眼神。";
		mes "充满同情";
		mes "……和勇气。";
		next;
		mes "[招募员]";
		mes "你当然是收复普隆德拉下水道行动的志愿者。要我把你传送过去吗？";
		next;
		if (select("传送到下水道入口。:退出。") == 1) {
			warp "prt_fild05",274,208;
			end;
		}
		close;
	}
	mes "[招募员]";
	mes "啊，请注意，卢恩-米德加尔特王国首都防卫总部决定因下水道情况招募讨伐队。";
	next;
	switch(select("志愿:情况……？:退出")) {
	case 1:
		callsub S_Volunteer;
		mes "[招募员]";
		mes "准备好了吗，英雄？";
		mes "现在将把你传送到";
		mes "下水道。";
		next;
		warp "prt_fild05",274,208;
		end;
	case 2:
		mes "[招募员]";
		mes "你没听说吗……？";
		mes "普隆德拉下水道充满各种肮脏害虫！";
		next;
		mes "[招募员]";
		mes "由于水污染风险严重，为保障王国人民安全，王室已下令隔离下水道。";
		next;
		mes "[招募员]";
		mes "不用说，这造成王国供水短缺。在这黑暗时期真是危机……";
		next;
		mes "[招募员]";
		mes "我们的人民";
		mes "渴望水……";
		mes "但他们更渴望";
		mes "";
		mes "英雄！";
		next;
		mes "[招募员]";
		mes "难道你要袖手旁观，看着卢恩-米德加尔特的孩子们口渴难耐、流下干涸的泪水吗？！难道你要埋葬我们的孩子吗？！";
		next;
		mes "[招募员]";
		mes "战士们！卢恩-米德加尔特在召唤你们！净化土地的瘟疫，驱逐下水道害虫！只有你们……能带来改变。";
		next;
		if (select("志愿。:退出。") == 1) {
			callsub S_Volunteer;
			mes "[招募员]";
			mes "冒险者……";
			mes "现在将把你传送到";
			mes "普隆德拉下水道。";
			next;
			warp "prt_fild05",274,208;
			end;
		}
		mes "[招募员]";
		mes "哼。下次喝水时，记住平均有九个半孩子刚刚死去……^990000死于口渴^000000。";
		close;

	case 3:
		close;
	}

S_Volunteer:
	set MISC_QUEST,MISC_QUEST | 8;
	mes "[招募员]";
	mes "你的登记……";
	mes "已经完成。";
	next;
	mes "[招募员]";
	mes "感谢你志愿为伟大王国尽力。拿着这些物资，对抗黑暗势力。";
	next;
	mes "[招募员]";
	mes "3 瓶红色药水、1 杯牛奶，";
	mes "以及 1 瓶橙色药水";
	mes "……愿它们给你希望。";
	getitem 501,3; //Red_Potion
	getitem 519,1; //Milk
	getitem 502,1; //Orange_Potion
	next;
	return;
}

prt_fild05,270,212,5	script	Culvert Guardian	105,{
	if (MISC_QUEST & 8) {
		mes "[下水道守卫]";
		mes "啊，你是志愿者。这是普隆德拉下水道入口。";
		mes "你想";
		mes "进去吗？";
		next;
		if (select("好的。:退出。") == 1) {
			warp "prt_sewb1",131,247;
			end;
		}
		close;
	}
	mes "[下水道守卫]";
	mes "抱歉，只有下水道行动志愿者才能进入。";
	next;
	mes "[下水道守卫]";
	mes "想当志愿者，请前往普隆德拉 11 点钟方向的 ^000077下水道登记员^000000。";
	close;
}

// Ph.D Hat Quest :: npc_6cript
//============================================================
prt_in,38,108,4	script	Teacher	53,{
	if ((countitem(710) > 0) && (countitem(703) > 0) && (countitem(704) > 0) && (countitem(708) > 0)) {
		mes "[老师]";
		mes "哦……";
		mes "你手中的花是……";
		next;
		switch(select("展示花朵:提交花朵:取消")) {
		case 1:
			mes "[老师]";
			mes "啊……";
			mes "这正是我寻找的 4 种花！你愿意给我吗？";
			next;
			mes "[老师]";
			mes "如果愿意……";
			mes "我会给你珍贵物品。";
			close;
		case 2:
			if ((countitem(710) > 0) && (countitem(703) > 0) && (countitem(704) > 0) && (countitem(708) > 0)) {
				delitem 710,1;  //Illusion_Flower
				delitem 703,1;  //Hinalle
				delitem 704,1;  //Aloe
				delitem 708,1;  //Ment
				getitem 5012,1;	//Ph.D_Hat
				mes "[老师]";
				mes "非常感谢你为我所做的一切。我会按约定给你珍贵物品。";
				next;
				mes "[老师]";
				mes "这是我大学毕业时戴的帽子。它让我想起快乐的学生时代。请收下……";
				close;
			}
			else {
				mes "[老师]";
				mes "……哦，抱歉。";
				mes "但这不是我想找的东西。也许你需要再了解一下花朵？";
				close;
			}
		}
	}
	else {
		mes "[老师]";
		mes "你不觉得……";
		mes "花朵很漂亮吗？";
		next;
		switch(select("交谈:退出")) {
		case 1:
			mes "[老师]";
			mes "我年轻的时候，";
			mes "没有朋友，";
			mes "一直都在学习。";
			next;
			mes "[老师]";
			mes "有时我会后悔年轻时做过的事，但现在已经不算什么了。通过刻苦学习，我比其他学生更早完成了全部课程。";
			next;
			mes "[老师]";
			mes "然而……";
			mes "我曾经悲伤，有时也很孤独。学习太辛苦时，我需要一个愿意倾听我的人。终于有一天，我遇见了最好的朋友。";
			next;
			mes "[老师]";
			mes "当我看到一朵美丽的花在废弃的花园中绽放时，我意识到它就是与我命运相连的朋友。";
			next;
			mes "[老师]";
			mes "对别人来说，它只是普通平凡的花，但它给了我重新学习的理由。正因为它，我才能实现目标。";
			next;
			mes "[老师]";
			mes "所以最近……";
			mes "我想报答它。现在我正在研究花朵，计划让它们遍布整个世界。";
			next;
			mes "[老师]";
			mes "为了完成我的工作……";
			mes "我需要许多花朵。但对很少出门的人来说，找齐需要的花实在太难了。";
			next;
			mes "[老师]";
			mes "我需要 1 个^3355FF幻觉之花^000000、1 个^3355FF希纳蕾^000000、1 个^3355FF芦荟^000000和 1 个^3355FF薄荷^000000。如果你能带给我，我就把宝物给你……";
			close;
		case 2:
			mes "[老师]";
			mes "总有一天，我会让花朵覆盖整个世界。";
			close;
		}
	}
}

// Geoborg Family Curse :: prt_curse
//============================================================
prontera,248,212,3	script	Busy Boy#prt	706,3,3,{
	callsub S_CheckWeight; //Check Player's weight
	if (BaseLevel > 59) {
		if (prt_curse == 0) {
			mes "[忙碌的男孩]";
			mes "哎呀，糟糕……";
			mes "我该怎么办？";
			mes "我得把这些";
			mes "书送过去，但是……我……天啊，";
			mes "我现在不能害怕！";
			close;
		}
		else if (prt_curse == 1) {
			mes "[忙碌的男孩]";
			mes "哎呀，糟糕……";
			mes "我该怎么办？";
			mes "我得把这些";
			mes "书送过去，但是……我……天啊，";
			mes "我现在不能害怕！";
			next;
			if (select("和他交谈:无视他") == 1) {
				mes "["+strcharinfo(0)+"]";
				mes "那个，发生什么事了？";
				mes "有什么问题吗？";
				next;
				mes "[忙碌的男孩]";
				mes ".........?";
				next;
				mes "[忙碌的男孩]";
				if (Sex == SEX_MALE) {
					mes "啊！你就是那个笨手笨脚的";
					mes "害我掉落";
				}
				else {
					mes "啊！你就是那个冒失的";
					mes "害我掉落";
				}
				mes "之前那些书的人！";
				mes "等等，你之前丢下我不管，";
				mes "现在为什么又装出一副关心我的样子？";
				emotion ET_SURPRISE;
			}
			else {
				mes "[忙碌的男孩]";
				mes "好，好……";
				mes "别想什么";
				mes "漂浮在";
				mes "天空中的事。你很";
				mes "稳重。别想……";
				mes "就……就登上那艘船吧……";
				close;
			}
			next;
			select("这个嘛，我，呃……");
			mes "[忙碌的男孩]";
			if (Sex == SEX_MALE) {
				mes "是啊……真正的";
				mes "男人不会那时";
				mes "丢下我不管，";
				mes "连帮忙都不肯。";
				mes "你真是个怪人，";
				mes "你知道吗？";
			}
			else {
				mes "是啊……如果你是";
				mes "优雅又体贴的";
				mes "女士，你之前就会帮我了。";
				mes "我说得对吧？";
			}
			next;
			mes "^3355FF你下意识地";
			mes "踢倒了年轻男孩";
			mes "旁边的一摞";
			mes "书。";
			mes "你控制不住自己：";
			mes "这是自然反应！^000000";
			next;
			Specialeffect EF_HITDARK;
			emotion ET_HUK;
			mes "^3355FF*砰！*^000000";
			next;
			emotion ET_HUK;
			mes "[忙碌的男孩]";
			mes "啊！那些书……！";
			mes "我花了那么久才把";
			mes "它们全部堆好！";
			next;
			mes "["+strcharinfo(0)+"]";
			mes "糟糕，真是一团乱！";
			mes "来，让我帮你把这些";
			mes "整齐地整理好，";
			mes "这是发自";
			mes "我内心深处的真心话。";
			emotion ET_THROB, playerattached();
			next;
			mes "[忙碌的男孩]";
			mes "...";
			mes "......";
			mes ".........";
			emotion ET_THINK;
			next;
			mes "[忙碌的男孩]";
			mes "嗯……？";
			mes "哦，谢谢你";
			mes "在这里帮我。";
			mes "我真的很感激。";
			next;
			select("这些都是你的吗？");
			mes "[忙碌的男孩]";
			mes "这些？哦，我的工作就是";
			mes "把它们送过去。";
			mes "我需要把这些书送到朱诺，";
			mes "从普隆德拉图书馆";
			mes "送给客户。不过，呃……";
			next;
			mes "[忙碌的男孩]";
			mes "这个嘛……";
			mes "我很容易晕车，";
			mes "所以乘飞艇";
			mes "一路去朱诺让我害怕得要死。";
			mes "";
			emotion ET_THINK;
			next;
			mes "[忙碌的男孩]";
			mes "这下我有麻烦了！";
			mes "我从来不会迟到，但这";
			mes "次实在没办法。";
			mes "我什么也做不了！";
			mes "哦，我要丢掉这份工作了！";
			emotion ET_CRY;
			next;
			mes "[忙碌的男孩]";
			mes "等等……你们冒险者";
			mes "经常到处旅行，对吧？";
			mes "如果你要去朱诺，";
			mes "能帮我把这些送过去吗？";
			mes "如果不把这些书送到，我就真的有麻烦了……";
			mes "";
			next;
			callsub S_GetBooks;
			mes "[忙碌的男孩]";
			mes "我、我明白了。";
			mes "这本来不关你的";
			mes "事，我知道，但是";
			mes "我真的走投无路了……";
			emotion ET_CRY;
			set prt_curse,2;
			close;
		}
		else if (prt_curse == 2) {
			mes "[忙碌的男孩]";
			mes "哦，又见面了。";
			mes "抱歉，我正努力";
			mes "集中精神。我要……";
			mes "鼓起全部勇气……";
			mes "登、登上那艘飞艇！";
			mes "啊！不行，我做不到！";
			emotion ET_THINK;
			next;
			callsub S_GetBooks;
			mes "[忙碌的男孩]";
			mes "^333333*抽泣……*^000000";
			mes "我该怎么办？";
			mes "那个人已经等了";
			mes "我送他的书";
			mes "很久了……";
			emotion ET_CRY;
			close;
		}
		else if (prt_curse == 3) {
			mes "[忙碌的男孩]";
			mes "哦，请把我交给";
			mes "你的那些书送给";
			mes "应该在朱诺图书馆附近等候的";
			mes "^FF0000卡洛莫夫先生^000000。";
			mes "谢谢";
			mes "你再次帮忙～";
			close;
		}
		mes "[忙碌的男孩]";
		mes "啊！你能让我";
		mes "独自工作吗？";
		mes "我有重要的事情";
		mes "要做！等我整理完";
		mes "这些书，还需要……我得做些准备！";
		close;
	}
	mes "[忙碌的男孩]";
	mes "啊！你能让我";
	mes "独自工作吗？";
	mes "我有重要的事情";
	mes "要做！等我整理完";
	mes "这些书，我还需要……我得做些准备！";
	close;

OnTouch:
	callsub S_CheckWeight; //Check Player's weight
	if (BaseLevel > 59) {
		if (prt_curse == 0) {
			Specialeffect EF_HITDARK;
			mes "^3355FF*BAM!*^000000";
			next;
			mes "[忙碌的男孩]";
			mes "嘿，小心！";
			mes "你能不能";
			mes "小心一点？！真是的！";
			emotion ET_ANGER;
			next;
			mes "["+strcharinfo(0)+"]";
			mes "哎呀，真的很抱歉。";
			mes "你没事吧？";
			next;
			mes "[忙碌的男孩]";
			mes "是啊，还不是因为你！";
			mes "哦……别担心，我没事。";
			next;
			mes "^3355FF你注意到男孩";
			mes "掉落了许多精装";
			mes "书籍，从标题来看，";
			mes "内容可能是遗迹";
			mes "及其传说。男孩掸去";
			mes "身上的灰尘，开始";
			mes "小心地把书堆好。^000000";
			next;
			if (select("离开:帮他堆好书") == 1) {
				mes "[忙碌的男孩]";
				mes "下次注意";
				mes "你要去的方向，";
				mes "好吗？我的意思是，";
				mes "你总是这么粗心，";
				mes "真的可能会弄坏";
				mes "什么东西！";
				set prt_curse,1;
				close;
			}
			mes "[忙碌的男孩]";
			mes "嗯……？";
			mes "哦，谢谢你";
			mes "在这里帮我。";
			mes "我真的很感激。";
			next;
			select("这些都是你的吗？");
			mes "[忙碌的男孩]";
			mes "这些？哦，我的工作就是";
			mes "把它们送过去。";
			mes "我需要把这些书送到朱诺，";
			mes "从普隆德拉图书馆";
			mes "送给客户。不过，呃……";
			next;
			mes "[忙碌的男孩]";

	mes "这是艾尔帕兰的地方特色之一。";
	mes "你不能从"+ .@floor$ +"层通过，";
	mes "请回去。";
	next;
	switch(select("关于钟楼:关于"+ .@floor$ +"层:前往"+ .@floor$ +"层:结束对话")) {
	case 1:
		mes "[守门少年]";
		mes "炼金术的故乡，艾尔帕兰！";
		mes "很久以前，这里有";
		mes "3位传说炼金术士……他们是";
		mes "布鲁克·赛默";
		mes "菲利普·瓦里泽斯";
		mes "以及……";
		next;
		mes "[守门少年]";
		mes "罗梅罗·斯佩夏尔！";
		mes "这座庄严的建筑是";
		mes "他们的杰作。";
		mes "我想你在前往这一层的路上";
		mes "会感到些许不同，";
		mes "这座钟楼的每个细节";
		next;
		mes "[守门少年]";
		mes "都由神秘的古代魔法构成。";
		mes "如果你毫无目的地";
		mes "在这里闲逛，";
		next;
		mes "[守门少年]";
		mes "无论如何，";
		mes "都会遭遇守门生物";
		mes "带来的灾祸。";
		mes "请务必小心……";
		close;
	case 2:
		mes "[守门少年]";
		mes "古代炼金术士";
		mes "使用炼金装置封印了4楼入口，";
		mes "以保护某些东西";
		mes "免受邪恶生物和人类敌人侵害。";
		mes "要通过这扇门，";
		next;
		mes "[守门少年]";
		mes "需要一把钥匙。";
		mes "据说那把钥匙被在这里游荡的";
		mes "守门生物持有。";
		next;
		mes "[守门少年]";
		mes "那把钥匙凝聚着古代炼金术的精髓，";
		mes "听说使用一次后，";
		mes "其中的魔法就会解除，";
		mes "钥匙也会消失。";
		next;
		mes "[守门少年]";
		mes "如果那把钥匙";
		mes "落到你手里，";
		mes "请拿给我看。";
		mes "拥有钥匙的人";
		mes "就可以凭自己的意志";
		mes "通过这扇门！";
		next;
		mes "[守门少年]";
		mes "我会给你一个机会。";
		mes ". . . . .";
		close;
	case 3:
		if (countitem(.@item_req) > 0) {
			mes "[守门少年]";
			mes "嗯！我早就感觉你不是普通人，";
			mes "现在看来我的猜测是对的。";
			mes "请进吧。";
			mes "愿神保佑你……";
			close2;
			delitem .@item_req,1;
			warp getarg(2),getarg(3),getarg(4);
			end;
		}
		else {
			mes "[守门少年]";
			mes ". . . . . .";
			mes "很遗憾，你没有资格";
			mes "进入这扇门……";
			mes "只要古代炼金术士";
			mes "不授予你资格，";
			mes "你就无法通过。";
			close;
		}
	case 4:
		mes "[守门少年]";
		mes "这座钟楼";
		mes "是3位古代传说炼金术士";
		mes "留下灵魂与技艺的地方。";
		mes "请不要在内部涂写或造成损坏。";
		close;
	}
}

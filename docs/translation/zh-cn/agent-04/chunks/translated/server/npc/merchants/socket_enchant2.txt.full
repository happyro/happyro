//===== rAthena Script ======================================= 
//= Episode 12 Socket Enchant NPC
//===== By: ================================================== 
//= Gepard
//===== Current Version: ===================================== 
//= 1.1a
//===== Compatible With: ===================================== 
//= rAthena Project
//===== Description: ========================================= 
//= [Official Conversion]
//= Adds slots to selected weapons and armor.
//===== Additional Comments: ================================= 
//= 1.0 First version.
//= 1.1 Duplicates now spawn from floating NPCs. [L0ne_W0lf]
//= 1.1a Added 'disable_items' command. [Euphy]
//============================================================ 

-	script	Leablem#dummy::SocketEnchant2	-1,{
	if (checkweight(1201,1) == 0)
	{
		mes "- 等一下！！-";
		mes "- 你携带的物品太多。-";
		mes "- 减轻负重后再试。-";
		close;
		}
		mes "[Leablem]";
	mes "你好。我叫 Leablem，是专门为武器和防具添加卡槽的技术员。";
	mes "有时工作很难，但我喜欢这份工作并为之自豪。";
	next;
	mes "[Leablem]";
	mes "我大多向哥哥 Seyablem 学习，但还有很多东西要学。";
	mes "所以请理解，我的开槽服务不如哥哥 Seyablem 全面。";
	next;
	mes "[Leablem]";
	mes "哥哥不太愿意教我，因为担心自己的技能不再独特。";
	mes "不过他还是尽力教我了。";
	next;
	mes "[Leablem]";
	mes "多亏他，我学到了很多。";
	mes "我不太有信心尝试各种事情，但会尽力做好现在能做的。";
	next;
	mes "[Leablem]";
	mes "其实有一件事哥哥不想让我做。";
	mes "我不想惹他生气，所以跳过那部分吧。我不再多说！";
	next;
	mes "[Leablem]";
	mes "总之，你有想添加卡槽的装备吗？";
	mes "服务费、材料和成功率都取决于具体物品。";
	next;
	switch(select("武器:防具:关于刚才跳过的事:更多信息:退出"))
	{
	case 1:
	mes "[Leablem]";
	mes "你说武器？当然，没问题。";
	mes "武器按工作难度分为 4 个等级。";
	mes "C 级最简单，S 级最困难。";
	mes "你想尝试哪个等级？";
	next;
	switch(select("C:B:A:S"))
	{
	case 1:
	mes "[Leablem]";
	mes "C 级，明白了。";
	mes "你有什么武器？";
	next;
	switch(select("大地之母之书:巨浪之书:疾风之书:烈日之书"))
	{
	case 1: callfunc "Func_Socket2",1554,1569,40,66,200,1010,10;
		case 2: callfunc "Func_Socket2",1553,1568,40,66,200,1010,10;
			case 3: callfunc "Func_Socket2",1556,1571,40,66,200,1010,10;
			case 4: callfunc "Func_Socket2",1555,1570,40,66,200,1010,10;
			}
			case 2:
			mes "[Leablem]";
			mes "你选择了普通的 B 级。";
			mes "那么，你有什么武器？";
			next;
					switch(select("兽人斧:弯刃大刀:尖刺锤"))
				{
					case 1: callfunc "Func_Socket2",1304,1309,40,66,200,984,1;
					case 2: callfunc "Func_Socket2",1113,1114,40,66,200,984,1;
					case 3: callfunc "Func_Socket2",1523,1538,40,61,300,984,1;
					}
					case 3:
					mes "[Leablem]";
						mes "A 级？你的要求似乎有点高。不过没问题。";
						mes "那么，你有什么武器？";
						next;
							switch(select("屠龙者:震动拳刃:烈焰拳刃:冰冻拳刃:穿刺之风拳刃:黄金锤:东方之弦:女王的鞭子:幽灵长矛:盖伯尔加:瑞士军刀"))
					{
				case 1:  callfunc "Func_Socket2",13001,13030,40,61,500,984,2;
					case 2:  callfunc "Func_Socket2", 1257, 1276,40,66,500,984,2;
					case 3:  callfunc "Func_Socket2", 1258, 1277,40,66,500,984,2;
					case 4:  callfunc "Func_Socket2", 1256, 1275,40,66,500,984,2;
					case 5:  callfunc "Func_Socket2", 1259, 1278,40,66,500,984,2;
					case 6:  callfunc "Func_Socket2", 1524, 1539,40,61,500,984,2;
					case 7:  callfunc "Func_Socket2", 1918, 1922,40,61,500,984,2;
						case 8:  callfunc "Func_Socket2", 1970, 1976,40,61,500,984,2;
						case 9:  callfunc "Func_Socket2", 1477, 1479,40,56,500,984,2;
						case 10: callfunc "Func_Socket2", 1474, 1480,40,56,500,984,2;
					case 11: callfunc "Func_Socket2", 1167, 1178,40,61,500,984,2;
				}
					case 4:
					mes "[Leablem]";
					mes "咦，S 级？！天啊，你是认真的吗？*发抖*";
					mes "那么……你想给哪件 S 级武器添加卡槽？！";
					next;
						switch(select("西风:破甲短剑:屠龙剑:破剑者:刺客短剑:大十字:刽子手"))
						{
						case 1: callfunc "Func_Socket2",1468, 1481,40,51,1000,984,5,999,10;
						case 2: callfunc "Func_Socket2",1225,13032,40,51,1000,984,5,999,10;
						case 3: callfunc "Func_Socket2",1166, 1180,40,51,1000,984,5,999,10;
						case 4: callfunc "Func_Socket2",1224,13031,40,51,1000,984,5,999,10;
						case 5: callfunc "Func_Socket2",1232,13033,40,51,1000,984,5,999,10;
						case 6: callfunc "Func_Socket2",1528, 1540,40,51,1000,984,5,999,10;
						case 7: callfunc "Func_Socket2",1169, 1179,40,51,1000,984,5,999,10;
						}
						}
						case 2:
					mes "[Leablem]";
				mes "你说防具？当然，没问题。";
					mes "防具按工作难度分为 4 个等级。";
					mes "C 级最简单，S 级最困难。";
					mes "你想尝试哪个等级？";
					next;
					switch(select("C:B:A:S"))
					{
						case 1:
						mes "[Leablem]";
						mes "C 级，明白了。";
						mes "那么，你有什么防具？";
						next;
						switch(select("向日葵:博士帽:大蝴蝶结:男孩帽"))
						{
					case 1: callfunc "Func_Socket2",2253,5351,40,66,100,999,3;
			case 2: callfunc "Func_Socket2",5012,5347,40,66,100,999,3;
		case 3: callfunc "Func_Socket2",2244,5348,40,66,100,999,5;
			case 4: callfunc "Func_Socket2",5016,5349,40,66,100,999,5;
			}
			case 2:
			mes "[Leablem]";
			mes "你选择了普通的 B 级。";
			mes "那么，你有什么防具？";
			next;
			switch(select("骷髅戒指:高跟鞋"))
			{
				case 1: callfunc "Func_Socket2",2609,2715,40,61,300,999,5;
					case 2: callfunc "Func_Socket2",2409,2432,40,61,300,999,5;
					}
					case 3:
					mes "[Leablem]";
					mes "A 级？你的要求似乎有点高。不过没问题。";
					mes "那么，你有什么防具？";
						next;
						switch(select("海盗头巾:黑色皮靴"))
						{
						case 1: callfunc "Func_Socket2",2287,5350,50,61,500,985,1; // 50,61 - it's not a typo
					case 2: callfunc "Func_Socket2",2425,2434,40,51,500,985,1;
				//case 3: callfunc "Func_Socket2",15053,15056,x,x,x,x,x;	// Special Ninja Suit (Needs more info)
					}
					case 4:
					mes "[Leablem]";
					mes "咦，S 级？！天啊，你是认真的吗？*发抖*";
					mes "那么……你想给哪件 S 级防具添加卡槽？！";
					next;
						switch(select("法师外套:圣职者长袍:神圣使命:内衣:短裤"))
						{
					case 1: callfunc "Func_Socket2",2334,2372,40,51,1000,985,1; // Mage Coat has 10% success chance
				case 2: callfunc "Func_Socket2",2327,2373,45,51,1000,985,1; // the rest has 5%
					case 3: callfunc "Func_Socket2",2111,2128,45,51,1000,985,1;
					case 4: callfunc "Func_Socket2",2522,2523,45,51,1000,985,1;
					case 5: callfunc "Func_Socket2",2339,2371,45,51,1000,985,1;
					}
					}
					case 3:
						mes "[Leablem]";
						mes "哦，没什么特别的，只是哥哥认为";
						mes "那不是人类该插手的东西。 ";
					mes "我不想惹哥哥生气，";
				mes "所以还是忘了它吧。";
					next;
					mes "[Leablem]";
					mes "……那项服务本身的成功率很高，";
					mes "但需要大量材料和高额服务费。";
					mes "即使我开放这项服务，";
					mes "我也很怀疑会有人真的想使用。";
						next;
						mes "[Leablem]";
						mes "……嗯……";
						next;
						mes "[Leablem]";
					mes ".............";
			next;
		mes "[Leablem]";
			mes ".............";
			next;
			mes "[Leablem]";
			mes "你似乎对使用那项服务很感兴趣。";
			mes "如果你愿意，我至少可以告诉你详情。";
			mes "但你必须答应保守秘密。";
			mes "如果哥哥发现我要告诉你的事，";
			mes "他肯定会揍我！";
			next;
			mes "[Leablem]";
			mes "这项特殊服务有 90% 的成功率，";
			mes "但需要 2 个 Gold 和 2 亿 Zeny：";
			mes "我可以为太阳神之帽添加卡槽。";
			next;
			mes "[Leablem]";
			mes "哥哥说，自古以来都禁止改造那顶帽子。";
			mes "但我相信人类太好奇了，无法不去";
			mes "尝试，尤其是在被禁止的时候。";
			mes "我只是不想被哥哥骂，仅此而已。";
			next;
			switch(select("使用服务","退出"))
			{
			case 1:
			mes "[Leablem]";
			mes ".................";
			next;
			mes "[Leablem]";
			mes ".................";
			next;
			mes "[Leablem]";
			mes "……什……什么？不！";
			mes "就算你这样瞪着我，";
			mes "我也不会做！";
			mes "不，我说了不行！不就是不行！不行！";
			next;
			mes "[Leablem]";
			mes "不，我不会做！不行！";
			next;
			mes "[Leablem]";
			mes "我做不到……";
			next;
				mes "[Leablem]";
					mes "我不能做……那件事……";
					next;
					mes "[Leablem]";
					mes ".................";
					next;
					mes "[Leablem]";
					mes "嗯……";
					next;
					mes "[Leablem]";
					mes "你真是坚持不懈。好吧，我就为你破例。";
					mes "但别告诉任何人，";
					mes "尤其是我哥哥。你答应吗？";
					next;
					mes "[Leablem]";
					mes "那么，请把这些带给我：";
					mes "^FF00002 个 Gold、2 亿 Zeny——服务费——，";
					mes "^FF0000以及一顶太阳神之帽。";
					mes "^FF0000你知道这样做的成功率是 90%，对吧？^000000";
					mes "我们没时间浪费，";
					mes "马上开始吧。";
					next;
					if ((Zeny > 199999999) && (countitem(969) > 1) && (countitem(5022) > 0))
					{
					mes "[Leablem]";
					mes "现在开始吗？";
					mes "向你的神祈祷好运吧。";
					next;
					set .@a, rand(1,100);
					if ((.@a > 4) && (.@a < 95))
					{
					specialeffect EF_LORD;
					mes "[Leablem]";
					mes "太棒了！哇，看来 90% 的成功率是真的！";
					mes "看，卡槽加在了完美的位置。";
					mes "恭喜。";
					delitem 5022,1; //Helm_Of_Sun
					delitem 969,2; //Gold
					set Zeny, Zeny - 200000000;
					getitem 5353,1; //Helm_Of_Sun_
					next;
					mes "[Leablem]";
					mes "这是我第一次也是最后一次为你做这件事。";
						mes "绝对不要告诉任何人";
						mes "这件事。明白吗？";
						close;
						}
						else
						{
						specialeffect EF_SUI_EXPLOSION;
							mes "[Leablem]";
							mes "哇！天啊，失败了！";
							mes "我的天，看来我们的运气糟透了……";
							mes "怎么办？……所以我一开始";
							mes "才不想做这件事！";
							delitem 5022,1; //Helm_Of_Sun
							delitem 969,2; //Gold
							set Zeny, Zeny - 200000000;
							next;
							mes "[Leablem]";
							mes "不，别再让我做这种危险的事了！";
							mes "呸~";
							close;
							}
							}
						else
						{
						mes "[Leablem]";
							mes "嗯……";
							next;
							mes "[Leablem]";
							mes "你的材料不够。";
							mes "真是的，材料不够还让我试什么？";
							mes "我不会再为你做这件事，";
							mes "即使你带来足够材料也不行。呸~";
							close;
							}
							case 2:
							mes "[Leablem]";
							mes "绝对不要告诉任何人";
							mes "我告诉你的事。明白吗？";
							close;
						}
					case 4:
					mes "[Leablem]";
					mes "你想知道更多信息吗？";
						mes "嗯，我不认为有什么";
						mes "是你特别需要知道的。";
						mes "不过我至少可以给你一个提示。";
						next;
						mes "[Leablem]";
						mes "每个城镇的开槽技术员";
						mes "提供的开槽成功率都不同，";
						mes "取决于装备的精炼等级。";
						mes "我不知道这是否属实，";
					mes "但我能看出各城镇的差异。";
				next;
					mes "[Leablem]";
					mes "例如，某个城镇的开槽技术员";
					mes "对高精炼等级的装备";
					mes "提供更高成功率，";
			mes "而另一个城镇的技术员";
		mes "在低精炼等级时成功率更高。";
			next;
			mes "[Leablem]";
			mes "添加卡槽失败时，装备";
			mes "会损坏并消失。";
			mes "我会尽力成功，";
			mes "但开槽是复杂的工作。";
			next;
			mes "[Leablem]";
			mes "哦，有件重要的事你必须注意。";
			mes "^FF0000添加卡槽时，尽量不要携带两件相同的装备。";
			mes "^FF0000否则卡槽可能会随机加到其中一件上，";
			mes "^FF0000最糟糕的情况是，你可能会丢失对你更有价值的装备。^000000";
			next;
			mes "[Leablem]";
			mes "希望这些信息对你有帮助。";
			mes "谢谢。";
			close;
			case 5:
			mes "[Leablem]";
			mes "好吧，那么。";
			close;
			}
			}
			// 行数占位：保持与官方源文件物理行数一致
			// 行数占位：保持与官方源文件物理行数一致
			//
			//
			//
			//
			//
			//
			//
			//
			//
			//
			//
			//
		//
			//
			//
			//
	//
//

payon,236,199,3	duplicate(SocketEnchant2)	Leablem#pay	86
lighthalzen,96,137,3	duplicate(SocketEnchant2)	Leablem#lhz	86
prt_in,22,60,6	duplicate(SocketEnchant2)	Leablem#prt	86

function	script	Func_Socket2	{
	.@item_id = getarg(0);
	.@zeny_req = getarg(4);
	setarray .@item_req[0], getarg(5), getarg(7,0);
	setarray .@req_amount[0], getarg(6), getarg(8,0);

	disable_items;
	mes "[Leablem]";
	if (.@item_req[1] != 0 && .@req_amount[1] != 0)
	{
		mes getitemname(.@item_id) +"……好的，那么你需要带给我";
		mes "^FF0000"+ (.@zeny_req >= 1000 ? (.@zeny_req /1000 +",000") : .@zeny_req) +",000 Zeny 作为服务费，";
		mes "^FF0000"+ .@req_amount[0] +" 个 "+ getitemname(.@item_req[0]) +"和 "+ .@req_amount[1] +" 个 "+ getitemname(.@item_req[1]) +"。";
		mes "^FF0000当然，你还需要一件"+ getitemname(.@item_id) +"。^000000";
	}
	else
	{
		mes getitemname(.@item_id) +"？好的，那么你需要带给我";
		mes "^FF0000"+ (.@zeny_req >= 1000 ? (.@zeny_req/1000 +",000") : .@zeny_req) +",000 Zeny 作为服务费，以及 "+ .@req_amount[0] +" 个 "+ getitemname(.@item_req[0]) +"。";
		mes "^FF0000当然，别忘了带一件"+ getitemname(.@item_id) +"。";
		mes "^FF0000你应该已经带齐所有物品了。^000000";
	}
	next;
	mes "[Leablem]";
	mes "你已经把它们都带来了吗？";
	mes "顺便说一下，如果添加卡槽失败，";
	mes "你会失去所有材料以及目标"+ ((getiteminfo(.@item_id, ITEMINFO_LOCATIONS)&EQP_HAND_R) ? "武器" : "防具") +"。";
	mes "还要记住，如果这件"+ ((getiteminfo(.@item_id, ITEMINFO_LOCATIONS)&EQP_HAND_R) ? "武器" : "防具") +"已经精炼并插入卡片，";
	mes "即使成功添加卡槽，也会失去精炼和卡片。";
	next;
	switch(select("Ask for slot creation.:Try next time."))
	{
		case 1:
			if ((Zeny >= .@zeny_req*1000) && countitem(.@item_req[0]) >= .@req_amount[0] && countitem(getarg(7,512)) >= .@req_amount[1] && countitem(.@item_id) > 0)// if there's no .@req_amount[0] and .@req_amount[1] provided, check itemcount against 0 (we still need a valid item ID though)
			{
				mes "[Leablem]";
				mes "好吧，让工作开始！";
				mes "你最好祈祷结果成功。";
				next;
				set .@a, rand(1,100);
				if ((.@a > getarg(2)) && (.@a < getarg(3)))
				{
					specialeffect EF_LORD;
					mes "[Leablem]";
					mes "太好了，看来成功了。";
					mes "完成得很漂亮。恭喜！";
					delitem .@item_id,1;
					delitem .@item_req[0],.@req_amount[0];
					if (.@item_req[1] != 0 && .@req_amount[1] != 0)
						delitem .@item_req[1],.@req_amount[1];
					Zeny = Zeny - .@zeny_req *1000;
					getitem getarg(1),1;
					next;
					mes "[Leablem]";
					mes "下次再见，朋友！";
					close;
				}
				else
				{
					specialeffect EF_SUI_EXPLOSION;
					mes "[Leablem]";
					mes "哇！……非常抱歉，失败了。";
					mes "不过，这完全不是我的错。";
					mes "这是你的运气，也是神的安排，好吗？";
					mes "别太失望，";
					mes "下次再试吧。";
					delitem .@item_id,1;
					delitem .@item_req[0],.@req_amount[0];
					if (.@item_req[1] != 0 && .@req_amount[1] != 0)
						delitem .@item_req[1],.@req_amount[1];
					Zeny = Zeny - .@zeny_req *1000;
					next;
					mes "[Leablem]";
					mes "下次再见，朋友！";
					close;
				}
			}
			else
			{
				mes "[Leablem]";
				mes "你傻了吗？你没有带齐所需物品！";
				mes "快去把它们带来！";
				close;
			}
		case 2:
			mes "[Leablem]";
			mes "下次再见。";
			close;
	}
}

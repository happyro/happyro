				mes "[战斗教官苏比诺]";
				mes "你已经达到转职等级，不该这样。";
				mes "即使你停在原地，我也不会阻止你……";
				next;
				mes "[战斗教官苏比诺]";
				mes "如果你还不确定想从事什么职业，就去学院二楼和^ff0000各职业教官^000000交谈。";
				for (set .@i,0; .@i < 6; set .@i,.@i+1) {
					set .@quest_id,11339+.@i;
					setarray .@bexp[0],90,90,135,200,0,120;
					setarray .@jexp[0],50,50,100,175,0,90;
					setarray .@material[0],909,515,914,939,0,915;
					setarray .@count[0],5,1,3,3,0,2;

					if (.@quest_id == 11343)
						continue;
					if (checkquest(.@quest_id,HUNTING) == 1)
						erasequest .@quest_id;
					else if (checkquest(.@quest_id,HUNTING) == 2) {
						erasequest .@quest_id;
						if (countitem(.@material[.@i]) >= .@count[i]) {
							delitem .@material[.@i],.@count[.@i];
							getexp .@bexp[.@i],.@jexp[.@i];
							getitem 7059,1;// Cargo_Free_Ticket
						}
					}
				}
				close;
			}
			mes "[战斗教官苏比诺]";
			mes "欢迎！";
			mes "我是^ff0000战斗教官 Subino^000000。";
			mes "我会^ff0000提供一个简单的委托^000000，帮助你尽快成长为优秀的战士，四处看看吧。";
			next;
			switch(select("查看任务", "传送到原野", "结束对话")) {
				case 1:
					switch(select("世界上最美味的东西（1~3）：胡萝卜很好吃（1~3）：法布尔滚动衣（4~6）：屏障！！（4~6）："+(BaseLevel<7?"":"嗡嗡~（7~10）")+":停止。")) {
						case 1:
							if (!isbegin_quest(11338)) {
								setquest 11338;
								completequest 11338;
							}
							if (checkquest(11339,HUNTING) < 2) {
								mes "[战斗教官苏比诺]";
								mes "^ff0000波利^000000是非常可爱的怪物。";
								next;
								mes "[战斗教官苏比诺]";
								mes "它们会掉落杰勒比结晶，这是克里图拉学院的主要烹饪材料之一，所以我们总要猎杀波利。";
								next;
							}
							callsub L_Quest,11339,90,50,909,5,"Poring","can easily be found","Hunt","Jellopies";
						case 2:
							if (!isbegin_quest(11338)) {
								setquest 11338;
								completequest 11338;
							}
							if (checkquest(11340,HUNTING) < 2) {
								mes "[战斗教官苏比诺]";
								mes "^ff0000疯兔^000000是生活在普隆德拉附近的可爱动物。";
								mes "温柔……柔软……非常可爱……真的很可爱……";
								next;
								mes "[战斗教官苏比诺]";
								mes "它们总会带着^ff0000胡萝卜^000000，所以猎杀它们很容易得到美味的胡萝卜。";
								next;
								mes "[战斗教官苏比诺]";
								mes "胡萝卜含有大量纤维细胞、维生素 A 和胡萝卜素，对眼睛有好处！";
								next;
							}
							callsub L_Quest,11340,90,50,515,1,"Lunatic","is easily found","Catch","Carrot";
						case 3:
							if (!isbegin_quest(11338)) {
								setquest 11338;
								completequest 11338;
							}
							if (checkquest(11341,HUNTING) < 2) {
								mes "[战斗教官苏比诺]";
								mes "^ff0000法布尔^000000是卢恩-米德加尔特王国最常见的昆虫。";
								mes "虽然是虫子，却因为外表可爱而很受欢迎。";
								next;
								mes "[战斗教官苏比诺]";
								mes "克里图拉学院提供的大多数服装都是用法布尔身上的^ff0000绒毛^000000制成的，织物既结实又保暖。";
								next;
							}
							callsub L_Quest,11341,135,100,914,3,"Fabre","is easily found","Hunt","Fluffs";
						case 4:
							if (!isbegin_quest(11338)) {
								setquest 11338;
								completequest 11338;
							}
							if (checkquest(11344,HUNTING) < 2) {
								mes "[战斗教官苏比诺]";
								mes "^ff0000蛹^000000是法布尔变成奶嘴蝙蝠前的中间阶段。";
								mes "幼虫变成蝴蝶的过程很神秘。";
								next;
								mes "[战斗教官苏比诺]";
								mes "就像法布尔会变成奶嘴蝙蝠一样，希望所有初心者都能成为伟大的冒险者！所以，这是^ff0000蛹^000000。";
								next;
							}
							callsub L_Quest,11344,120,90,915,2,"Pupa","is easily found","Hunt","Chrysalises";
						case 5:
							if (!isbegin_quest(11338)) {
								setquest 11338;
								completequest 11338;
							}
							if (checkquest(11342,HUNTING) < 2) {
								mes "[战斗教官苏比诺]";
								mes "^ff0000蜂兵^000000是生活在普隆德拉附近、受蜂后米斯特里斯控制的一群蜜蜂。";
								mes "它们并不主动攻击……只有在遇到危险时才会用毒针反击。";
								next;
								mes "[战斗教官苏比诺]";
								mes "克里图拉学院正在研究提取它们毒针中的毒液来制作解毒剂。";
								next;
							}
							callsub L_Quest,11342,200,175,939,3,"Hornet","are found","Hunt","Bee Stings";
						case 6:
							mes "[战斗教官苏比诺]";
							mes "你似乎没兴趣。";
							mes "改变主意后再回来。";
							close;
					}
				case 2:
					mes "[战斗教官苏比诺]";
					mes "好，我把你送到依斯鲁得西部原野。";
					mes "记得回来的路。";
					close2;
					warp "prt_fild"+strnpcinfo(2), 344, 213;
					end;
				case 3:
					mes "[战斗教官苏比诺]";
					mes "你似乎没兴趣。";
					mes "改变主意后再回来。";
					close;
			}
		}
		mes "[战斗教官苏比诺]";
		mes "你还没在^ff0000克里图拉学院^000000登记？";
		mes "手续很简单，去登记吧。";
		mes "你可以在学院的^ff0000信息中心^000000登记。";
		close;
	} else {
		mes "[战斗教官苏比诺]";
		mes "看来你不需要我的帮助。";
		mes "你最好去别处看看，或者前往更广阔的世界。";
		next;
		mes "[战斗教官苏比诺]";
		mes "可以去^ff0000职业公会的支援处（等级 10~20），或查看伊甸园集团（等级 15~100）^000000。";
		next;
		mes "[战斗教官苏比诺]";
		mes "向二楼的^ff0000各职业工作人员询问职业公会的位置^000000，就能找到可以接取简单狩猎任务的^ff0000伊甸园集团总部^000000。";
		next;
		mes "[战斗教官苏比诺]";
		mes "它会^ff0000显示在右侧屏幕的地图上^000000，找找看吧。";
		mes "如果不知道位置，就向^ff0000城镇导游^000000求助。";
		close;
	}

L_Quest:
	.@quest_id = getarg(0);
	if (checkquest(.@quest_id,HUNTING) == -1) {
		if (select("接受任务。", "停止。") == 2) {
			mes "[战斗教官苏比诺]";
			mes "你似乎没兴趣。";
			mes "改变主意后再回来。";
			close;
		}
		mes "[战斗教官苏比诺]";
		if (.@quest_id == 11342) {
			mes getarg(5)+"在^ff0000普隆德拉西部原野^000000。";
			mes getarg(5)+"对初心者来说很难捕捉……但只要聚集更多初心者，就能做到。";
			next;
			mes "[战斗教官苏比诺]";
		} else
			mes getarg(5)+"在^ff0000依斯鲁得西部原野^000000。";
		mes getarg(7)+" ^ff0000"+(.@quest_id==11344?"5":"10")+" 只"+getarg(5)+"^000000，并带来^ff0000"+getarg(4)+" 个"+getarg(8)+"^000000。";
		mes "按下^ff0000Alt + U^000000即可查看已接受的任务。";
		setquest .@quest_id;
		close;
	} else if (checkquest(.@quest_id,HUNTING) == 1) {
		if (select("结束对话", "放弃任务。") == 2) {
			mes "[战斗教官苏比诺]";
			mes "真的要放弃任务吗？";
			next;
			if (select("结束对话", "确定放弃。") == 2) {
				mes "[战斗教官苏比诺]";
				mes "只要你需要我的帮助，就可以再次挑战任务，随时来找我。";
				erasequest .@quest_id;
			}
		}
		close;
	} else {
		if (countitem(getarg(3)) < getarg(4)) {
			mes "[战斗教官苏比诺]";
			mes "你的^ff0000"+getarg(8)+"^000000不够。";
			mes "再努力一点！";
			next;
			if (select("结束对话", "放弃任务。") == 2) {
				mes "[战斗教官苏比诺]";
				mes "真的要放弃任务吗？";
				next;
				if (select("结束对话", "是的，放弃。") == 2) {
					mes "[战斗教官苏比诺]";
					mes "只要你需要我的帮助，就可以再次挑战任务，随时来找我。";
					erasequest .@quest_id;
				}
			}
			close;
		}
			mes "[战斗教官苏比诺]";
		mes "哇……！！";
		mes "干得好！！";
		erasequest .@quest_id;
		delitem getarg(3), getarg(4);
		getexp getarg(1), getarg(2);
		getitem 7059,1;// Cargo_Free_Ticket
		close;
	}

OnInit:
	questinfo( QTYPE_QUEST, QMARK_NONE,
		"Class == Job_Novice && isbegin_quest(4269) == 2 && (!isbegin_quest(11339) || !isbegin_quest(11340) || !isbegin_quest(11341) || !isbegin_quest(11342) || !isbegin_quest(11344))" );
	end;
}

iz_ac01_a,59,83,3	duplicate(Battle Instructor#08)	Battle Instructor#08a	4_M_NOV_HUNT
iz_ac01_b,59,83,3	duplicate(Battle Instructor#08)	Battle Instructor#08b	4_M_NOV_HUNT
iz_ac01_c,59,83,3	duplicate(Battle Instructor#08)	Battle Instructor#08c	4_M_NOV_HUNT
iz_ac01_d,59,83,3	duplicate(Battle Instructor#08)	Battle Instructor#08d	4_M_NOV_HUNT

// - Adept Adventurer
// - Teaches the player about Pets.
// -----------------------------------------------------------------------------
iz_ac01,45,80,5	script	Adept Adventurer#ac	4_M_JOB_BLACKSMITH,{
	if (isbegin_quest(2298) > 1) {
		mes "[老练的冒险者]";
		mes "对让怪物成为宠物有疑问吗？";
		next;
		while(1) {
			switch(select("驯服怪物", "孵化蛋", "查看宠物状态", "喂食", "表演", "移除饰品", "变回蛋", "结束对话")) {
			case 1:
				mes "[老练的冒险者]";
				mes "只有一部分怪物可以成为宠物，而且每种怪物的驯服方式都不同。";
				next;
				mes "[老练的冒险者]";
				mes "每种可驯服的怪物都需要特定的^3131FF驯服道具^000000。";
				next;
				mes "[老练的冒险者]";
				mes "要开始驯服，";
				mes "^3131FF双击^000000背包中的驯服道具，然后选择要驯服的怪物。";
				cutin "pet_ex_01.bmp", 3;
				next;
				mes "[老练的冒险者]";
				mes "点击弹出老虎机中央的^3131FF按钮^000000来驯服怪物。";
				cutin "pet_ex_02.bmp", 3;
				next;
				cutin "", 255;
				mes "[老练的冒险者]";
				mes "成功后，怪物会变成一枚蛋！";
				next;
				break;
			case 2:
				mes "[老练的冒险者]";
				mes "孵化需要^3131FF<宠物孵化器>^000000来唤醒蛋中的怪物。";
				next;
				mes "[老练的冒险者]";
				mes "大多数城镇都有^3131FF<宠物美容师>^000000，可以在那里购买^3131FF<宠物孵化器>^000000。";
				mes "如果找不到宠物美容师，就向城镇导游询问位置。";
				next;
				break;
			case 3:
				mes "[老练的冒险者]";
				mes "^3131FF右键点击^000000宠物并选择^3131ff查看宠物状态^000000，或按下^3131FF<Alt+J>^000000。";
				next;
				mes "[老练的冒险者]";
				mes "这会打开状态窗口。你可以在这里更改宠物的^3131FF名字^000000，并查看^3131FF饱食度^000000和^3131FF亲密度^000000。";
				next;
				mes "[老练的冒险者]";
				mes "有些特殊宠物在^3131FF亲密度^000000达到信赖时会获得特殊技能。大多数宠物起初都很害羞，时间和食物会改变这一点。";
				next;
				break;
			case 4:
				mes "[老练的冒险者]";
				mes "<宠物饲料>是宠物的普通食物，但有些宠物喜欢其他食物。你应该随身准备足够的食物，以免宠物挨饿。";
				next;
				mes "[老练的冒险者]";
				mes "宠物太饱或太饿都会^3131FF逃跑^000000。所以一定要经常查看宠物的饥饿状态！";
				next;
				break;
			case 5:
				mes "[老练的冒险者]";
				mes "有些宠物心情好时会进行特殊表演。";
				next;
				break;
			case 6:
				mes "[老练的冒险者]";
				mes "有些宠物甚至可以佩戴饰品。";
				mes "^3131FF<宠物美容师>^000000会出售一些宠物饰品，某些怪物也会掉落宠物饰品。";
				next;
				break;
			case 7:
				mes "[老练的冒险者]";
				mes "我觉得一起经历更多事情，总比变回蛋好吧？";
				next;
				break;
			case 8:
				mes "[老练的冒险者]";
				mes "有其他问题时再回来吧。";
				close;
			}
		}
	}
	if (!isbegin_quest(2293)) {
		mes "[冒险者的宠物]";
		mes "我饿了~先喂我，然后一起散步吧~";
		next;
		mes "[老练的冒险者]";
		mes "冷静点，给你！";
		next;
		mes "[冒险者的宠物]";
		mes "呼，真好吃。我吃饱了。";
		next;
		if (select("会说话的怪物！", "无视它。") == 2) {
			mes "[老练的冒险者]";
			mes "宠物是孤独旅途中的最佳伙伴……";
			close;
		}
		mes "[老练的冒险者]";
		mes "它曾经是危险的怪物，如今是我最亲密的朋友。这就是我的^3131FF宠物^000000，名字叫黛比鲁奇。";
		next;
		if (select("什么是宠物？", "结束对话") == 2) {
			mes "[冒险者的宠物]";
			mes "哈欠~我无聊死了！";
			close;
		}
		mes "[老练的冒险者]";
		mes "宠物就是忠诚的^3131FF怪物^000000，会陪伴在你身边。";
		next;
		select("它能帮助你战斗吗？");
		mes "[老练的冒险者]";
		mes "它不会直接帮我战斗，但会提供额外的^3131FF属性^000000和其他增益效果。";
		next;
		mes "[老练的冒险者]";
		mes "只有和宠物的^3131FF亲密度^000000很高时，这些效果才会实现。";
		next;
		mes "[老练的冒险者]";
		mes "亲密度需要投入时间和大量食物。食物是赢得任何生物忠诚的办法，对吧？哈哈。";
		next;
		if (select("怎样获得宠物？", "结束对话") == 2) {
			mes "[老练的冒险者]";
			mes "宠物是孤独旅途中的最佳伙伴……";
			close;
		}
		mes "[老练的冒险者]";
		mes "你需要一只宠物吗？";
		next;
		mes "[老练的冒险者]";
		mes "嗯，那我们一起去学院庭院吧！";
		mes "我会向你展示该怎么做。";
		next;
		mes "[老练的冒险者]";
		mes "准备好去庭院时再来找我！";
		setquest 2293;
		close;
	} else {
		mes "[老练的冒险者]";
		mes "要去克里图拉学院的庭院吗？";
		next;
		if (select("现在送我过去！", "留下") == 1) {
			mes "[老练的冒险者]";
			mes "好，跟我来。";
			close2;
			warp "new_1-3", 95, 171;
			end;
		}
		mes "[老练的冒险者]";
		mes "如果你愿意，我随时都可以带你去。";
		close;
	}

OnInit:
	questinfo( QTYPE_QUEST, QMARK_NONE, "!isbegin_quest(2298)" );
	end;
}

iz_ac01_a,45,80,5	duplicate(Adept Adventurer#ac)	Adept Adventurer#ac_a	4_M_JOB_BLACKSMITH
iz_ac01_b,45,80,5	duplicate(Adept Adventurer#ac)	Adept Adventurer#ac_b	4_M_JOB_BLACKSMITH
iz_ac01_c,45,80,5	duplicate(Adept Adventurer#ac)	Adept Adventurer#ac_c	4_M_JOB_BLACKSMITH
iz_ac01_d,45,80,5	duplicate(Adept Adventurer#ac)	Adept Adventurer#ac_d	4_M_JOB_BLACKSMITH

// - Adventurer's Pet
// -----------------------------------------------------------------------------
iz_ac01,43,80,7	script	Adventurer's Pet#ac	4_DEVIRUCHI,{
	end;

OnTimer60000:
	switch(rand(1,4)) {
	case 1:
		npctalk "Adventurer's Pet : Yawn~ I am so bored!";
		break;
	case 2:
		npctalk "Adventurer's Pet : Red Potion.. Is it delicious? Herb does not look delicious.. I bet that is bitter.";
		break;
	case 3:
		npctalk "Adventurer's Pet : Ha. You are lucky to have this Devi.";
		break;
	case 4:
		npctalk "Adventurer's Pet : Isn't the floor cold? Well.. For me, Undead is more familiar.";
		break;
	}

OnInit:
	initnpctimer;
	end;
}

iz_ac01_a,43,80,7	duplicate(Adventurer's Pet#ac)	Adventurer's Pet#ac_a	4_DEVIRUCHI
iz_ac01_b,43,80,7	duplicate(Adventurer's Pet#ac)	Adventurer's Pet#ac_b	4_DEVIRUCHI
iz_ac01_c,43,80,7	duplicate(Adventurer's Pet#ac)	Adventurer's Pet#ac_c	4_DEVIRUCHI
iz_ac01_d,43,80,7	duplicate(Adventurer's Pet#ac)	Adventurer's Pet#ac_d	4_DEVIRUCHI

// - Monster Spawn
// -----------------------------------------------------------------------------
new_1-3,0,0	monster	Little Poring	2398,30,50000

// - Adept Adventurer (Cont...)
// - Teaches the player about Pets.
// -----------------------------------------------------------------------------
new_1-3,92,169,5	script	Adept Adventurer#new_1-3	4_M_JOB_BLACKSMITH,{
	if (isbegin_quest(2298) == 2) {
		mes "[老练的冒险者]";
		mes "对可爱的宠物还有什么问题吗？";
		next;
		while(1) {
			switch(select("驯服怪物", "孵化蛋", "查看宠物状态", "喂食", "表演", "移除饰品", "变回蛋", "结束对话")) {
			case 1:
				mes "[老练的冒险者]";
				mes "只有一部分怪物可以成为宠物，而且每种怪物的驯服方式都不同。";
				next;
				mes "[老练的冒险者]";
				mes "每种可驯服的怪物都需要特定的^3131FF驯服道具^000000。";
				next;
				mes "[老练的冒险者]";
				mes "要开始驯服，";
				mes "^3131FF双击^000000背包中的驯服道具，然后选择要驯服的怪物。";
				cutin "pet_ex_01.bmp", 3;
				next;
				mes "[老练的冒险者]";
				mes "点击弹出老虎机中央的^3131FF按钮^000000来驯服怪物。";
				cutin "pet_ex_02.bmp", 3;
				next;
				cutin "", 255;
				mes "[老练的冒险者]";
				mes "成功后，怪物会变成一枚蛋！";
				next;
				break;
			case 2:
				mes "[老练的冒险者]";
				mes "孵化需要^3131FF<宠物孵化器>^000000来唤醒蛋中的怪物。";
				next;
				mes "[老练的冒险者]";
				mes "大多数城镇都有^3131FF<宠物美容师>^000000，可以在那里购买^3131FF<宠物孵化器>^000000。";
				mes "如果找不到宠物美容师，就向城镇导游询问位置。";
				next;
				break;
			case 3:
				mes "[老练的冒险者]";
				mes "^3131FF右键点击^000000宠物并选择^3131ff查看宠物状态^000000，或按下^3131FF<Alt+J>^000000。";
				next;
				mes "[老练的冒险者]";
				mes "这会打开状态窗口。你可以在这里更改宠物的^3131FF名字^000000，并查看^3131FF饱食度^000000和^3131FF亲密度^000000。";
				next;
				mes "[老练的冒险者]";
				mes "有些特殊宠物在^3131FF亲密度^000000达到信赖时会获得特殊技能。大多数宠物起初都很害羞，时间和食物会改变这一点。";
				next;
				break;
			case 4:
				mes "[老练的冒险者]";
				mes "<宠物饲料>是宠物的普通食物，但有些宠物喜欢其他食物。你应该随身准备足够的食物，以免宠物挨饿。";
				next;
				mes "[老练的冒险者]";
				mes "宠物太饱或太饿都会^3131FF逃跑^000000。所以一定要经常查看宠物的饥饿状态！";
				next;
				break;
			case 5:
				mes "[老练的冒险者]";
				mes "有些宠物心情好时会进行特殊表演。";
				next;
				break;
			case 6:
				mes "[老练的冒险者]";
				mes "有些宠物甚至可以佩戴饰品。";
				mes "^3131FF<宠物美容师>^000000会出售一些宠物饰品，某些怪物也会掉落宠物饰品。";
				next;
				break;
			case 7:
				mes "[老练的冒险者]";
				mes "我觉得一起经历更多事情，总比变回蛋好吧？";
				next;
				break;
			case 8:
				mes "[老练的冒险者]";
				mes "有其他问题时再回来吧。";

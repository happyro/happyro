function	script	F_mal_missing	{
	mes "[清洁工米辛]";
	mes "我马上告诉你如何清理。你能看到周围的涵洞吗？";
	next;
	if(select("什么涵洞？？：是的，我看到了。") == 1) {
		mes "[清洁工米辛]";
		mes "嗯？你第一次看到涵洞吗？你会看到许多埋在地下的机器。可以四处看看再回来！";
		close;
	}
	mes "[清洁工米辛]";
	mes "没错！这些涵洞非常重要！我们必须清理涵洞，防止海藻堵塞。这就是我们清洁工的工作！";
	next;
	mes "[清洁工米辛]";
	mes "小心！清理涵洞时会有怪物追击你！但不要向它们屈服！";
	next;
	mes "[清洁工米辛]";
	mes "还有……绝对不要让 6 株海藻堆积！最多只能有 5 株！如果有 6 株，我会把你拖出去！！";
	next;
	mes "[清洁工米辛]";
	mes "我不在乎你是否得到朋友帮助。我要求你清理所有涵洞！别忘了！ I will watch you and give you instructions. Just do what I said!!";
	next;
	if (is_party_leader() == false) {
		mes "[清洁工米辛]";
		mes "队长准备完成后就会开始，所以做好心理准备！！";
		close;
	}
	mes "[清洁工米辛]";
	mes "那么，你准备好开始清理了吗？";
	next;
	switch(select("等等！还没好：开始吧！")) {
	case 1:
		mes "[清洁工米辛]";
		mes "嗯？还没准备好？准备好后再来找我。";
		close;
	case 2:
		mes "[清洁工米辛]";
		mes "好！现在开始！";
		return;
	}
}


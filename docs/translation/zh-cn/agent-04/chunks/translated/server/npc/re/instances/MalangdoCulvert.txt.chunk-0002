		set 'party_id,getcharid(1);
		mapannounce instance_mapname("1@pump"),"米辛：我先进去，你跟上！我会在 3 点钟方向打开闸门！",bc_map,"0xff88ff",FW_NORMAL,15;
		disablenpc instance_npcname("Missing, the Cleaner#0");
		enablenpc instance_npcname("Culvert Entrance#i");
		close;
	case 3:
		mes "[清洁工米辛]";
		mes "我说过别和我闹~！";
		close;
	}
	end;
}


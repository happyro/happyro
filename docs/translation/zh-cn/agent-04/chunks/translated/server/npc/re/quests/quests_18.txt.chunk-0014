		next;
		mes "[Aisha]";
		mes "你很兴奋，像一直在等这一刻。你是不是太冷淡了？";
		next;
		mes "[Scania]";
		mes "哦不~你~这么~拼命~请求！！所以，我也没办法……";
		next;
		mes "[Aisha]";
		mes "总之……我得和村民谈谈幼崽。 我们的小家伙安全了！走吧，小幼崽！";
		npctalk "Woof!", "Boksil#wms01", bc_self;
		next;
		cloakonnpcself( "Aisha#wms01" );
		cloakonnpcself( "Boksil#wms01" );
		mes "[Scania]";
		mes "哦……突然成了临时牧羊人吗……？谢谢。我有很多事要做。我能帮什么忙？";
		next;
		mes "[Scania]";
		mes "啊，对了！外来者通常喜欢这种东西。你喜欢吗，冒险者？即使不喜欢，也可以和喜欢的人交换成想要的东西。带上吧。";
		next;
		mes "[Scania]";
		mes "好，散步时再见。";
		mes "^4d4dff你获得了好评。^000000";
		completequest 17512;
		getitem 1000405,10;	// Ep18_Amethyst_Fragment
		getexp 7769124,3000000;
		add_reputation_points(REPUTATION_EP18, 100);
		if (get_reputation_points(REPUTATION_EP18) >= 1000 && ep18_main == 36) {// Custom implementation: reputation 1000 on wolfvill => player can continue the main quest
			ep18_main = 37;
			setquest 18082;
			mes "^4d4dff 灰狼村民接受你成为村子的一员。^000000";
			mes "你有资格参加^4d4dff会议。^000000";
		}
		close;
	case 2:
		break;
	}

	// daily
	switch( checkquest(17516,PLAYTIME) ) {
	case -1:
		break;
	case 0:
	case 1:
		mes "[Scania]";
		mes "请等待任务冷却结束。";
		close;
	case 2:
		erasequest 17516;
		break;
	}
	if (isbegin_quest(17515) == 1) {
		mes "[Scania]";
		mes "冒险者，你辛苦了。我想我们的狗也很满意。用餐愉快吗？那么明天再来试试！";
		erasequest 17515;
		setquest 17516;
		add_reputation_points(REPUTATION_EP18, 30);
		if (get_reputation_points(REPUTATION_EP18) >= 5000)
			.@bonus = 1;
		if (get_reputation_points(REPUTATION_EP18) >= 1000 && ep18_main == 36) {// Custom implementation: reputation 1000 on wolfvill => player can continue the main quest
			ep18_main = 37;
			setquest 18082;
			mes "^4d4dff 灰狼村民接受你成为村子的一员。^000000";
			mes "你有资格参加^4d4dff会议。^000000";
		}
		getitem 1000405,3+.@bonus;	// Ep18_Amethyst_Fragment
		getexp 7769124,3000000;
		close;
	}
	if (isbegin_quest(17514) == 1) {
		mes "[Scania]";
		mes "狗狗喜欢几个地方，我会带你去。你只需要处理附近的危险怪物。";
		next;
		mes "[Scania]";
		mes "灰烬兽冲进来真麻烦。请处理周围的灰烬兽。我通常每天捕捉 20 只鹰。拜托了。";
		close;
	}
	switch( isbegin_quest(17513) ) {
	case 0:
		mes "[Scania]";
		mes "冒险者，我准时来散步了。但 Aisha 没出现……";
		next;
		setnpcdisplay( "Boksil#wms01", 21324 );	// EP18_GREY_WOLF_BABY
		cloakoffnpcself( "Aisha#wms01" );
		cloakoffnpcself( "Boksil#wms01" );
		mes "[Aisha]";
		mes "登登！我们到了！";
		next;
		mes "[Boksil]";
		mes "汪！！";
		next;
		mes "[Scania]";
		mes "好，我带你散步。真的……我也必须去吗？可以相信你来处理吗？";
		next;
		if (select( "好吧。", "我今天有点忙。" ) == 2) {
			mes "[Scania]";
		mes "啊……我明白……你很忙。那就没办法了。";
			next;
			mes "[Scania]";
		mes "哦，拜托，看看我失望的表情。我也没办法。今天跟我来。那么，再见，冒险者！";
			close;
		}
		mes "[Aisha]";
		mes "如果担心，可以一起去。";
		next;
		mes "[Scania]";
		mes "啊，不。好吧，那就交给你。照顾好幼崽。如果担心或不喜欢，就告诉我并回家。明白吗？";
		next;
		mes "[Goat]";
		mes "哈啊啊啊啊——";
		next;
		mes "[Scania]";
		mes "我会带你去幼崽喜欢的几个地方。它可以自己寻找和进食，所以只要处理附近的危险怪物。";
		next;
		mes "[Scania]";
		mes "灰烬兽不断聚集，真让人头疼……请处理附近的灰烬兽。我们通常每天要捕捉约 20 只。拜托你了。";
		setquest 17513;
		close2;
		cloakonnpcself( "Boksil#wms01" );
		cloakonnpcself( "Goat#wms01" );
		navigateto("gw_fild01",138,106);
		end;
	case 1:
		mes "[Scania]";
		mes "我会带你去幼崽喜欢的几个地方。只要处理附近的危险怪物。";
		next;
		mes "[Scania]";
		mes "灰烬兽不断聚集，真让人头疼……请处理附近的灰烬兽。我们通常每天要捕捉约 20 只。拜托你了。";
		close;
	case 2:
		end;
	}
	end;

OnTouch_:
	if (isbegin_quest(17510) == 0)
			npctalk "嘿，朋友，就算你想散步，也请再耐心等一会儿。", "Scania#wms01", bc_self;
	end;

OnInit:
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "isbegin_quest(17510) == 0 && isbegin_quest(11724) == 2" );
	questinfo( QTYPE_QUEST2, QMARK_YELLOW, "isbegin_quest(17512) == 1" );
	
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "isbegin_quest(17512) == 2 && isbegin_quest(17515) == 1" );
	questinfo( QTYPE_DAILYQUEST, QMARK_YELLOW, "isbegin_quest(17512) == 2 && isbegin_quest(17513) == 0 && isbegin_quest(17514) == 0 && (checkquest(17516,PLAYTIME) == -1 || checkquest(17516,PLAYTIME) == 2)" );
	end;
}

wolfvill,120,121,3	duplicate(dummy_cloaked_npc)	Maram#wms01	4_EP18_MARAM
wolfvill,119,117,1	duplicate(dummy_cloaked_npc)	Boksil#wms01	EP18_GREY_WOLF_BABY

// Quest: Training Grey Wolves. Step 2.
wolfvill,99,178,5	script	Aisha#wms02	4_F_SHABBY,{
	if (isbegin_quest(17512) == 1) {
		mes "[Aisha]";
		mes "我们要让 Scania 看到我们的 Boksil 安全可靠！";
		close;
	}
	switch( isbegin_quest(17510) ) {
	case 0:
		mes "[Aisha]";
		mes "想看狼崽的便便吗？多可爱啊？哦，但别碰。";
		close;
	case 1:
		mes "[Aisha]";
		mes "Boksil~永远和我生活在一起吧。如果有人伤害你，我会亲自把他们埋进奥兹峡谷。所以别担心，狼崽~相信我，幸福地生活吧。";
		next;
		mes "[Boksil]";
		mes "汪——";
		emotion ET_FRET, getnpcid(0,"Boksil#wms02");
		next;
		mes "[Aisha]";
		mes "不，Boksil。冷静一点。哎呀，如果你一直表现得不熟悉会怎样？不，我不是在说你……我们再亲近一点，好吗？";
		next;
		mes "[Boksil]";
		mes "嗷呜——";
		next;
		mes "[Aisha]";
		mes "我明白，我明白。你需要独处一会儿。说实话，我也有同感。归根结底，我们在这个世界上都是孤独的。所以即使一起生活，也要各自好好活着。";
		next;
		mes "[Boksil]";
		mes "吼——";
		next;
		mes "[Aisha]";
		mes "为什么？我做了什么……嗯？你是谁？我以前没见过你。";
		npctalk "我们的 Boksil 是因为陌生人来了才变得警惕吗？哦，做得好～", "Aisha#wms02", bc_self;
		npctalk "Roar--", "Boksil#wms02", bc_self;
		next;
		select( "这就是狼崽？" );
		mes "[Aisha]";
		mes "别靠我的狼崽太近。放下手。转身消失。";
		next;
		select( "我不是坏人……" );
		mes "[Aisha]";
		mes "我不随便称谁为坏人。叫我抛弃狼崽的人就是恶棍。我不会怜悯恶棍。";
		next;
		select( "你在这里多久了？" );
		mes "[Aisha]";
		mes "这是个人信息，不能透露。你为什么问？";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "不，这只狼崽还没接受训练。";
		next;
		mes "[Aisha]";
		mes "……不，她现在大约一个月大。还是幼崽时不可能训练。";
		next;
		select( "其实，我来这里是为了……" );
		mes "[Aisha]";
		mes "什么？我就知道！现在离我的狼崽至少十步远。别再靠近。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "我不是来带走她的，是来确认情况……如果她与狼群分开，就必须把她送回去，并准备好迎接母狼来找她。";
		next;
		mes "[Aisha]";
		mes "她不是离群的，是在垂死的母狼旁边被捡到的。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "糟糕。她可能因为和母亲分离、生活在陌生地方而紧张。";
		next;
		mes "[Aisha]";
		mes "你确定不是来带走她的，那你为什么来？";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "确认她确实是狼崽后，我是来劝说的……";
		next;
		mes "[Aisha]";
		mes "我就知道！是 Scania 派来的，对吧？为什么干涉别人的宠物？我们的狼崽不危险，回去吧。没什么可看的。";
		next;
		select( "只要小心，就没什么可担心的。" );
		mes "[Aisha]";
		mes "你真的这么想吗？你真觉得我们的狼崽可能构成威胁？看看她多小多可爱……";
		npctalk "Roarr--", "Boksil#wms02", bc_self;
		npctalk "哦，Boksil 不喜欢被夸吗？好吧，好吧。", "Aisha#wms02", bc_self;
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "正常情况下也许如此，但是……如果她没有母亲，至少狼群就没有理由来到这里。";
		next;
		mes "[Aisha]";
		mes "我明白你的意思！但愚蠢的 Scania 不明白！连你这个陌生人都如此理解我的心情！";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "而且，这只没有母亲的狼崽无法独自生存。";
		next;
		mes "[Aisha]";
		mes "没错！那个冷酷的人已经冷酷到极点。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "不过，Boksil 要住在村里就需要训练。她必须学会不伤害他人地交流，并与大家相处。";
		next;
		mes "[Aisha]";
		mes "她还这么小……？";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "就该在她年幼时训练。如果从小开始训练，就不会有村民担心的问题。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "坚定的语气、及时的回应和充分的表扬就足以让她理解。狼很聪明，你知道的。狼崽最喜欢什么？";
		next;
		mes "[Aisha]";
		mes "嗯……肉？但现在没有。冒险者有吗？";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "哦……！没有肉可以当零食，肉……我需要带些肉来。";
		completequest 17510;
		setquest 17511;
		close;
	case 2:
		mes "[Aisha]";
		mes "怎么用肉训练？只需要一块吗？";
		close;
	}
	end;

OnInit:
	questinfo( QTYPE_QUEST2, QMARK_YELLOW, "isbegin_quest(17510) == 1" );
	end;
}

// Quest: Training Grey Wolves. Step 3.
wolfvill,100,177,1	script	Boksil#wms02	EP18_GREY_WOLF_BABY,{
	if (checkweight(1000405,10) == 0) {
		mes "- 等一下！！-";
		mes "- 你目前携带了 -";
		mes "- 太多物品。-";
		mes "- 请重试 -";
		mes "- 减轻负重后。-";
		close;
	}
	switch( isbegin_quest(17511) ) {
	case 0:
		emotion ET_QUESTION;
		npctalk "Woof?", "", bc_self;
		mes "[Aisha]";
		mes "哦，别碰我们的 Boksil！她不喜欢这样！";
		close;
	case 1:
		if (countitem(517) < 1) {	// Meat
			mes "[Aisha]";
			mes "你不是说需要一块肉吗？不是吗？";
			close;
		}
		mes "[" + strcharinfo(0) + "]";
		mes "你好～我是" + strcharinfo(0) + "。你叫 Boksil，对吧？很高兴认识你。在这个陌生的地方感到不安吗？我完全理解你的感受，我了解你的一切。";
		next;
		emotion ET_FRET, getnpcid(0,"Boksil#wms02");
		mes "[Boksil]";
		mes "吼——";
		npctalk "Is everything okay? You seem uncomfortable.", "Aisha#wms02", bc_self;
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "但没关系。一切都好。这里没人会伤害我们的 Boksil。别担心。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "现在我们一起生活，有温暖的住所和美味的食物。";
		mes "那么我们需要制定一些规则。好吗？";
		next;
		emotion ET_QUESTION, getnpcid(0,"Boksil#wms02");
		mes "[Boksil]";
		mes "汪？";
		next;
		mes "[Aisha]";
		mes "感觉像是在和孩子说话。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "看这里。肉。Boksil 喜欢肉吗？烤的、生的，还是煮的？从没尝过烤肉？没关系，以后有很多机会尝试。";
		next;
		emotion ET_THROB, getnpcid(0,"Boksil#wms02");
		mes "[Boksil]";
		mes "汪！";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "好好做。";
		mes "Boksil，坐下！";
		mes "等等！";
		mes "做得好。这是你的肉。";
		emotion ET_THROB, getnpcid(0,"Boksil#wms02");
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "看到了吗？如果她这样遵守指令，请多多表扬她。";
		next;
		mes "[Aisha]";
		mes "妈妈，妈妈。我们的孩子不是天才吗？";
		mes "我们的 Boksil 做得太棒了！！！！";
		emotion ET_GOODBOY, getnpcid(0,"Boksil#wms02");
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "要一直这样训练，直到她习惯。重复训练很重要。继续像现在这样做。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "Boksil，坐下。";
		mes "伸手。";
		mes "等等。现在自己试试。";
		next;
		mes "[Aisha]";
		mes "Boksil，坐下！";
		mes "伸手！";
		mes "哇，真了不起。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "训练这类家养动物的方法各不相同。让它们在这里感到安全，并与它们建立良好关系，就能帮助它们适应。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "如果它们从小和其他伙伴相处、一起度过时间，就能友好相处，不会有大问题。";
		next;
		mes "[Aisha]";
		mes "人们能理解这一点吗？";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "你只需要向他们展示成果。这能证明 Boksil 已经准备好作为村里的一员生活。";
		mes "回到<NAVI>[Scania]<INFO>wolfvill,117,119,0,101,0</INFO></NAVI>，展示我们了不起又威风的 Boksil。";
		delitem 517,1;	// Meat
		completequest 17511;
		setquest 17512;
		getitem 1000405,10;	// Ep18_Amethyst_Fragment
		getexp 7769124,3000000;
		close;
	case 2:
		mes "[Aisha]";
		mes "Boksil 很可爱。不过我们要去<NAVI>[Scania]<INFO>wolfvill,117,119,0,101,0</INFO></NAVI>，对吧？别忘了。";
		close;
	}
	end;

OnInit:
	questinfo( QTYPE_QUEST2, QMARK_YELLOW, "isbegin_quest(17511) == 1 && countitem(517) > 0" );
	end;
}
//-------------------------------------------------------------------

// Quest: Training Grey Wolves. Daily.
gw_fild01,138,106,5	script	Grass#wms01	4_POINT_YELLOW,5,5,{
	if (isbegin_quest(17513) == 1) {
		setpcblock PCBLOCK_NPC, true;
		npctalk "Yahaha?", "Goat#wms02", bc_self;
		sleep2 2000;
		setnpcdisplay( "Boksil#wms03", 21324 );	// EP18_GREY_WOLF_BABY
		erasequest 17513;
		setquest 17514;
		unittalk getcharid(3), "" + strcharinfo(0) + "：已经到了。你喜欢这里吗？哦……这里没有草。我们找个别的地方吧。你有想去的地方吗？", bc_self;
		sleep2 1500;
		npctalk "Yaaaaa!", "Goat#wms02", bc_self;
		sleep2 1500;
		setpcblock PCBLOCK_NPC, false;
		cloakonnpcself( "Goat#wms02" );
		cloakonnpcself( "Boksil#wms03" );
		setnpcdisplay( "Boksil#wms03", CLEAR_NPC );
		unittalk getcharid(3), "" + strcharinfo(0) + " : Already gone. Let's get Ashring!", bc_self;
		end;
	}
	if (checkquest(17514,HUNTING) == 2) {
		setpcblock PCBLOCK_NPC, true;
		setnpcdisplay( "Boksil#wms03", 21324 );	// EP18_GREY_WOLF_BABY
		cloakoffnpcself( "Goat#wms02" );
		cloakoffnpcself( "Boksil#wms03" );
		erasequest 17514;
		setquest 17515;
		unittalk getcharid(3), "你吃饱了吗？", bc_self;
		sleep2 1000;
		npctalk "Yah ha ha!", "", bc_self;
		sleep2 1000;
		unittalk getcharid(3), "Boksil 有好好照顾狗狗吗？", bc_self;
		sleep2 1000;
		npctalk "汪！！!", "Boksil#wms03", bc_self;
		sleep2 1500;
		unittalk getcharid(3), "做得好。我们回家吧！！！", bc_self;
		cloakonnpcself( "Goat#wms02" );
		cloakonnpcself( "Boksil#wms03" );
		setnpcdisplay( "Boksil#wms03", CLEAR_NPC );
		setpcblock PCBLOCK_NPC, false;
		end;
	}
	end;
OnTouch:
	if (isbegin_quest(17513) == 1 || checkquest(17514,HUNTING) == 2) {
		cloakoffnpcself( "Goat#wms02" );
		cloakoffnpcself( "Boksil#wms03" );
	}
	end;

OnInit:
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "isbegin_quest(17513) == 1 || checkquest(17514,HUNTING) == 2" );
	end;
}

gw_fild01,160,104,0	script	Delicious grass#wms11	HIDDEN_WARP_NPC,5,5,{
	end;
OnTouch:
	if (isbegin_quest(17513) == 1 || checkquest(17514,HUNTING) == 2) {
		cloakoffnpcself( "Goat#wms02" );
		cloakoffnpcself( "Boksil#wms03" );
	}
	end;
}
gw_fild01,26,101,0	duplicate(Delicious grass#wms11)	#wms01	HIDDEN_WARP_NPC,3,3

gw_fild01,138,106,3	script(CLOAKED)	Goat#wms02	EP18_GREY_GOAT,{
	if (isbegin_quest(17513) == 1) {
		setpcblock PCBLOCK_NPC, true;
		npctalk "Yah ha ha?", "", bc_self;
		sleep2 2000;
		setnpcdisplay( "Boksil#wms03", 21324 );	// EP18_GREY_WOLF_BABY
		erasequest 17513;
		setquest 17514;
		unittalk getcharid(3), "你已经来过这里了。喜欢吗？啊……这里没有草。我们找个别的地方吧。你想去哪里？", bc_self;
		sleep2 1500;
		npctalk "Yah ha ha!", "", bc_self;
		sleep2 1500;
		setpcblock PCBLOCK_NPC, false;
		cloakonnpcself( "Goat#wms02" );
		cloakonnpcself( "Boksil#wms03" );
		setnpcdisplay( "Boksil#wms03", CLEAR_NPC );
		unittalk getcharid(3), "Already gone. Let's catch Ashling!!", bc_self;
		end;
	}
	if (checkquest(17514,HUNTING) == 2) {
		setpcblock PCBLOCK_NPC, true;
		setnpcdisplay( "Boksil#wms03", 21324 );	// EP18_GREY_WOLF_BABY
		cloakoffnpcself( "Goat#wms02" );
		cloakoffnpcself( "Boksil#wms03" );
		erasequest 17514;
		setquest 17515;
		unittalk getcharid(3), "你吃饱了吗？", bc_self;
		sleep2 1000;
		npctalk "Yah ha ha!", "", bc_self;
		sleep2 1000;
		unittalk getcharid(3), "Boksil 有好好照顾狗狗吗？", bc_self;
		sleep2 1000;
		npctalk "汪！！!", "Boksil#wms03", bc_self;
		sleep2 1500;
		unittalk getcharid(3), "做得好。我们回家吧！！！", bc_self;
		cloakonnpcself( "Goat#wms02" );
		cloakonnpcself( "Boksil#wms03" );
		setnpcdisplay( "Boksil#wms03", CLEAR_NPC );
		setpcblock PCBLOCK_NPC, false;
		end;
	}
	end;
}


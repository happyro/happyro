// Storage and unlock reputation feature
wolfvill,167,135,3	script	Asad#asad	4_EP18_GW_MAN01,{
	if (checkweight(1201,1) == 0) {
		mes "- 等一下！！-";
		mes "- 你目前携带了-";
		mes "- 太多物品。-";
		mes "- 请再试一次-";
		mes "- 减轻负重后。-";
		close;
	}
	.@reputation = get_reputation_points(REPUTATION_EP18);
	if (.@reputation < 1000) {
		mes "[Asad]";
		mes "先生，好久不见。";
		mes "熟悉村子后，来找我吧。";
		mes "我会为你提供一些便利。";
		next;
		mes "[Asad]";
		mes "但前提是你^4d4dff要参加比赛^000000。";
		mes "我不会随便帮任何人。";
		next;
		mes "[Asad]";
		mes "仔细观察，就会发现有些地方需要援手。";
		mes "伸出援手，你就能赢得人们的好感。";
		mes "尽力而为吧。";
		close;
	}

	if (.@reputation >= 3000) {
		mes "[Asad]";
		mes "欢迎，像狼一样的 " + strcharinfo(0) + "。";
		mes "你需要什么？";
		mes "哦，我一直在寻找更好的熔炼箱。";
		mes "想用紫水晶交换吗？";
	}
	else {
		mes "[Asad]";
		mes "欢迎，先生。";
		mes "想整理一些东西吗？";
		mes "还是想看看我出售的物品？";
	}
	next;
	.@amethyst_name$ = getitemname(1000405);
	if (.@reputation >= 4000)
		.@menu$[2] = "用 " + .@amethyst_name$ + " 交换熔炼箱";
	else if (.@reputation >= 3000)
		.@menu$[1] = "用 " + .@amethyst_name$ + " 交换熔炼箱";
	if (.@reputation >= 2000)
		.@menu$[0] = "请求空间移动。";
		switch( select( "使用仓库。", "使用商店。", .@menu$[0], .@menu$[1], .@menu$[2] ) ) {
	case 1:
		mes "[Asad]";
		mes "仓库存储费是 200 Zeny。";
		mes "你想打开哪个仓库？";
		next;
		select( "仓库 1" );
		if (Zeny < 200)
			end;
		Zeny -= 200;
		mes "[Asad]";
		mes "好，我会打开仓库。";
		mes "请好好使用。";
		close2;
		openstorage();
		end;
	case 2:
		mes "[Asad]";
		mes "你要出售物品吗？";
		mes "你要购买需要的东西吗？";
		next;
		switch( select( "购买物品。", "出售物品。" ) ) {
		case 1:
			mes "[Asad]";
			mes "我不确定是否有你需要的一切。";
			mes "但无论是什么，你都可以信赖我。";
			close2;
			callshop "Tool Dealer#wolf",1;
			end;
		case 2:
			mes "[Asad]";
			mes "好。我会以合理价格卖给你任何东西。";
			close2;
			callshop "Tool Dealer#wolf",2;
			end;
		}
		end;
	case 3:
		mes "[Asad]";
		mes "要用 1 个 " + .@amethyst_name$ + " 传送到拉赫吗？";
		next;
		if (select( "否", "是" ) == 1)
			end;
		if (countitem(1000405) < 1) {
			mes "[Asad]";
			mes "你的材料不够。";
			close;
		}
		delitem 1000405,1;	// Ep18_Amethyst_Fragment
		warp "rachel",115,125;
		end;
	case 4:
		mes "[Asad]";
		mes "紫水晶商店？";
		mes "你可以用它们交换熔炼箱……";
		close2;
		callshop "barter_ep18_2",1;
		end;
	case 5:
		mes "[Asad]";
		mes "紫水晶商店？";
		mes "你可以用它们交换熔炼箱……";
		close2;
		callshop "barter_ep18_3",1;
		end;
	}
	end;
}

// (custom tool dealer)
-	shop	Tool Dealer#wolf	-1,611:-1,1750:-1,501:-1,502:-1,503:-1,504:-1,506:-1,645:-1,656:-1,601:-1,602:-1,1065:-1,2239:-1

// Greywolf enchant
wolfvill,164,137,3	script	Emmet#emet	4_EP18_GW_WOMAN01,{
	if (ep18_main < 38) {
		mes "[Emmet]";
		mes "你好！";
		mes "我看到你最近在村里得到了一些<ITEM>[紫水晶碎片]<INFO>1000405</INFO></ITEM>，对吧？";
		mes "我注意到人们经常交换它们，把它们当作幸运象征之类的东西。";
		next;
		mes "[Emmet]";
		mes "我们正在收集水晶。";
		mes "如果你碰巧收集了很多，之后能交给我吗？";
		next;
		mes "[Emmet]";
		mes "当然，我不会白拿水晶碎片。";
		mes "我会用装备或其他像你这样的冒险者可能需要的物品交换。";
		next;
		mes "[Emmet]";
		mes "收集到大量碎片后，请来找我。";

		next;
		mes "[Camper]";
		mes "你不害怕吗？";
		mes "那些总问我什么时候找工作的老家伙，每次见到他们都更可怕。";
		mes "...";
		close;
	}
	if (checkweight(1000405,4) == 0) {
		mes "- 等一下！！-";
		mes "- 你目前携带了-";
		mes "- 太多物品。-";
		mes "- 请再试一次-";
		mes "- 减轻负重后。-";
		close;
	}
	if (checkquest(18086,HUNTING) == 2) {
		mes "[Gatekeeper]";
		mes "哦，我听说你说那里很平静，所以你帮了我。";
		mes "谢谢。";
		mes "来，我把我有的给你。";
		erasequest 18086;
		setquest 18087;
		add_reputation_points(REPUTATION_EP18, 30);
		if (get_reputation_points(REPUTATION_EP18) >= 5000)
			.@bonus = 1;
		if (get_reputation_points(REPUTATION_EP18) >= 1000 && ep18_main == 36) {// Custom implementation: reputation 1000 on wolfvill => player can continue the main quest
			ep18_main = 37;
			setquest 18082;
			mes "^4d4dff 灰狼村民接受你成为村子的一员。^000000";
			mes "你有资格参加^4d4dff会议。^000000";
		}
		getitem 1000405,3+.@bonus;	// Ep18_Amethyst_Fragment
		getexp 9956480,2000000;
		next;
	}
	mes "[Gatekeeper]";
	mes "你要去村庄吗？";
	next;
	switch( select( "去灰狼村", "不去。", "你是谁？", "让灰狼森林更安全" ) ) {
	case 1:
		mes "[Gatekeeper]";
		mes "好。你需要穿过那些树之间的缝隙。";
		mes "跟我来。";
		close2;
		warp "wolfvill",270,26;
		end;
	case 2:
		mes "[Gatekeeper]";
		mes "那去附近狩猎一些怪物怎么样？";
		mes "我睡觉时它们太吵了。";
		close;
	case 3:
		mes "[Gatekeeper]";
		mes "如你所见，我是守门人。";
		mes "我也会赶走不速之客。";
		mes "通常我伪装成流浪者，但我其实不是。";
		mes "你敢把我当成那种人！";
		close;
	case 4:
		if (ep18_main == 35) {
			mes "[Gatekeeper]";
			mes "不，不。我不会刚见面就请你帮忙。";
			mes "森林可能有点危险，但没关系。";
			close;
		}
		switch( checkquest(18087,PLAYTIME) ) {
		case -1:
			break;
		case 0:
		case 1:
			mes "[Gatekeeper]";
			mes "嗯……暂时没事。";
			mes "它确实构成了一定威胁，所以它们考虑后不会攻击。";
			close;
		case 2:
			erasequest 18087;
			break;
		}
		switch( checkquest(18086,HUNTING) ) {
		case -1:
			mes "[Gatekeeper]";
			mes "如你所见，我在这里守卫入口。";
			mes "有时怪物一路来到这里，明明我很累还要来打扰我。";
			next;
			mes "[Gatekeeper]";
			mes "能在附近森林清理约 30 只任意怪物吗？";
			mes "我有些捡到的漂亮紫水晶碎片，会给你。";
			next;
			if (select( "接受请求", "拒绝" ) == 2) {
				mes "[Gatekeeper]";
				mes "我明白了……你是不在乎可怜守门人生命安全的人……";
				mes "知道了。我会真诚地把这件事记在心里。";
				close;
			}
			mes "[Gatekeeper]";
			mes "谢谢！";
			mes "现在我可以放松一下了！";
			mes "那就交给你了。";
			setquest 18086;
			close;
		case 0:
		case 1:
			mes "[Gatekeeper]";
			mes "什么都行。就在附近猎杀一些怪物。";
			mes "这样我守卫时也更安全，对吧？";
			close;
		case 2:
			end;
		}
	}
	end;

OnInit:
	questinfo( QTYPE_CLICKME, QMARK_YELLOW, "ep18_main == 35" );

	questinfo( QTYPE_DAILYQUEST, QMARK_YELLOW, "ep18_main > 35 && checkquest(18086,HUNTING) == -1 && (checkquest(18087,PLAYTIME) == -1 || checkquest(18087,PLAYTIME) == 2)" );
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "checkquest(18086,HUNTING) == 2" );
	end;
}

que_qaru01,345,23,0	warp	Gate02#gq_aru01	1,1,arug_cas01,157,369
que_qaru02,345,23,0	warp	Gate02#gq_aru02	1,1,arug_cas02,349,355
que_qaru03,345,23,0	warp	Gate02#gq_aru03	1,1,arug_cas03,321,153
que_qaru04,345,23,0	warp	Gate02#gq_aru04	1,1,arug_cas04,321,153
que_qaru05,345,23,0	warp	Gate02#gq_aru05	1,1,arug_cas05,321,153
que_qsch01,345,23,0	warp	Gate02#gq_sch01	1,1,schg_cas01,369,306
que_qsch02,345,23,0	warp	Gate02#gq_sch02	1,1,schg_cas02,177,355
que_qsch03,345,23,0	warp	Gate02#gq_sch03	1,1,schg_cas03,81,95
que_qsch04,345,23,0	warp	Gate02#gq_sch04	1,1,schg_cas04,369,306
que_qsch05,345,23,0	warp	Gate02#gq_sch05	1,1,schg_cas05,369,306

-	script	Wish Maiden#gq_main	-1,{
	set .@sub$, callfunc("F_Okolnir");
	set .@t$, ((compare(strnpcinfo(4),"aru"))?"arug_cas0":"schg_cas0")+(charat(strnpcinfo(4),getstrlen(strnpcinfo(4))-1));
	set .@GID, GetCastleData(.@t$,1);
	if (getcharid(2) == .@GID) {
		cutin "wish_maiden31",1;
		if (is_guild_leader() == true) {
			mes "[许愿少女]";
			mes "我是……许愿少女。";
			mes "在这个虚拟领域奥克尼尔中哀悼。";
			mes "代表曾在这里击败神的人类。";
			next;
			if (compare(.@sub$,"aru")) {
				setarray .@n, 7835,1,7836,1,7837,1,7838,1,2513,1,7291,10,7293,10,7063,100,985,20;
			} else {
				setarray .@n, 7830,1,7831,1,7832,1,7833,1,7834,1,2357,1,7510,100,969,10,985,20;
			}
			for (set .@i, 0; .@i < getarraysize(.@n); set .@i, .@i + 2) {
				if (countitem(.@n[.@i]) >= .@n[.@i+1])
					set .@check, .@check + 1;
			}
			if (.@check >= 9) {
				cutin "wish_maiden11",1;
				mes "[许愿少女]";
				mes "你准备好承受试炼，获得女神的荣耀了吗？";
				next;
				switch(select("是的:抱歉，我以后再试")) {
				case 1:
					cutin "wish_maiden12",1;
					mes "[许愿少女]";
					mes "我会测试你是否配得上女神的光辉……";
					mes "很简单，不是吗？";
					next;
					mes "[许愿少女]";
					mes "奥克尼尔是虚拟之地。";
					mes "那里不容许犯错。";
					mes "^ff0000你只有一小时。^000000";
					next;
					cutin "wish_maiden31",1;
					mes "[许愿少女]";
					mes "如果时间内未完成，奥克尼尔会被摧毁，我也会去休息。";
					mes "你必须再次等待……";
					next;
					mes "[许愿少女]";
					mes "准备接受试炼了吗？";
					mes "^4d4dff需要有 16 至 20 名成员在场^000000。";
					next;
					cutin "wish_maiden11",1;
					mes "[许愿少女]";
					mes "成员准备好后我会打开奥克尼尔之门。";
					next;
					switch(select("我们准备好了:我们还需要时间。")) {
					case 1:
						set .@saram,getmapusers("que_q"+.@sub$);
						if (((.@saram > 15) && (.@saram < 21))) {
							cutin "wish_maiden12",1;
							mes "[许愿少女]";
							mes "现在我会在这里打开奥克尼尔之门。";
							mes "我会在奥克尼尔顶部等你……";
							next;
							mes "[许愿少女]";
							mes "希望你能在虚拟奥克尼尔毁灭前完成所有试炼……";
							mes "祝你好运。";
							mapannounce "que_q"+.@sub$,"许愿少女：奥克尼尔之门已打开！别忘了你只有一小时。",bc_map,"0x00ff00";
							close2;
							setd "$@gqse_"+.@sub$+"_pcc",.@saram;
							setd "$siz_"+.@sub$+"_on",1;
							donpcevent "#okolnir_"+.@sub$+"::OnEnable";
							disablenpc "Wish Maiden#gq_"+.@sub$;
							cutin "wish_maiden11",255;
							announce "["+ strcharinfo(0) +"], of the guild ["+ GetGuildName(.@GID) +"] has opened the gates to the realm of Okolnir.",bc_all,"0x70dbdb";
							end;
						}
						else {
							cutin "wish_maiden13",1;
							mes "[许愿少女]";
							mes "开启奥克尼尔之门需要 16 至 20 名成员在场。";
							mes "准备好后再回来。";
							close2;
						}
						break;
					case 2:
						cutin "wish_maiden13",1;
						mes "[许愿少女]";
						mes "不要犹豫，试试看。";
						mes "机会来临时要抓住。";
						mes "召集你的公会成员即可。";
						close2;
					}
					break;
				case 2:
					cutin "wish_maiden32",1;
					mes "[许愿少女]";
					mes "……你害怕";
					mes "即将面对的试炼吗？";
					mes "....";
					next;
					cutin "wish_maiden13",1;
					mes "[许愿少女]";
					mes "你以为能轻易击败女神之光吗？";
					mes "我对你们所有人都很失望。";
					mes "走开吧……";
					close2;
				}
			}
			else {
				cutin "wish_maiden11",1;
				mes "[许愿少女]";
				mes "你想进去吗？";
				mes "只有做好准备的人才能进入。";
				mes "你必须带来几件物品才能进入奥克尼尔。";
				next;
				mes "[许愿少女]";
				if (compare(.@sub$,"aru")) {
					mes "暮光";
					mes "黎明精华";
					mes "寒冷月光";
					mes "朦胧星光。";
					next;
					mes "[许愿少女]";
					mes "请带来这四样物品、10 个玛瑙、10 个玫瑰石英和 20 个铝，";
					mes "以及一件天女之衣和 100 根柔软羽毛。";
				} else {
					mes "女神之泪";
					mes "女武神的信物";
					mes "布伦希尔德铠甲碎片";
					mes "英雄遗骸";
					mes "女武神铠甲";
					mes "安德瓦利之戒。";
					next;
					mes "[许愿少女]";
					mes "你必须带来这六样物品、10 个黄金和 20 个铝。";
					mes "还需要许多瓦尔哈拉之花作为供品。";
				}
				next;
				mes "[许愿少女]";
				mes "准备好全部物品后，大门就会打开。";
				next;
				mes "[许愿少女]";
				mes ".... ";
				mes "……女神的光辉照耀着你，你必须变得更强才配得上它……";
				next;
				mes "[许愿少女]";
				mes "记住……";
				mes "你需要收集许多柔软羽毛。";
				mes "希望你的梦想成真。";
				next;
				mes "[许愿少女]";
				mes "带来这些物品，我会回应你的所有请求。";
				close2;
			}
		}
		else {
			cutin "wish_maiden31",1;
			mes "[许愿少女]";
			mes "我是……许愿少女。";
			mes "在这个虚拟领域奥克尼尔中哀悼。";
			mes "代表曾在这里击败神的人类。";
			next;
			mes "[许愿少女]";
			mes "把带你来到这里的人带来。";
			mes "……将他交给我处置。";
			close2;
		}
	}
	else {
		cutin "wish_maiden13",1;
		mes "[许愿少女]";
		mes "……你没有资格。";
		close2;
		percentheal -100,0;
		cutin "wish_maiden11",255;
		end;
	}
	cutin "wish_maiden11",255;
	end;

OnInit:
	set .@sub$,callfunc("F_Okolnir");
	if (!getd("$siz_"+.@sub$+"_on")) {
		enablenpc "Wish Maiden#gq_"+.@sub$;
	} else {
		disablenpc "Wish Maiden#gq_"+.@sub$;
	}
	end;
}


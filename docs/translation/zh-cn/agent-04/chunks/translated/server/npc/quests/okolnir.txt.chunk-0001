function	script	F_Okolnir	{
	if (compare(strnpcinfo(0),"main")) end;
	set .@sub$,(compare(strnpcinfo(4),"cas"))?(substr(strnpcinfo(4),0,2))+(substr(strnpcinfo(4),8,9)):substr(strnpcinfo(4),5,9);
	return .@sub$;
}

-	script	Guide#gq_main	-1,{
	set .@sub$, callfunc("F_Okolnir");
	set .@GID, GetCastleData(strnpcinfo(4),1);
	if (getcharid(2) == .@GID) {
		if (getd("$siz_"+.@sub$+"_on") == 0) {
			mes "[向导]";
			mes "这座城堡隐藏着一个秘密。";
			mes "那就是 ^4d4dff“奥克尼尔”^000000。";
			next;
			switch(select("关于奥克尼尔:前往奥克尼尔:取消")) {
			case 1:
				mes "[向导]";
				mes "奥克尼尔是一种虚拟领域……";
				mes "我不知道奥克尼尔如何存在，但也许只有女武神知道。";
				next;
				mes "[向导]";
				mes "如你所知，这是女武神用来测试冒险者的地方……";
				mes "……你也知道进入奥克尼尔的资格。";
				next;
				select("Qualifications?");
				mes "[向导]";
				mes "是的，女武神确实偏爱强大的冒险者。";
				mes "只有合格者才能进入奥克尼尔和瓦尔哈拉。";
				next;
				mes "[向导]";
				mes "只有大家齐心协力才能开启。";
				mes "钥匙就在城堡里。";
				next;
				mes "[向导]";
				mes "如果城堡的 ^4d4dff经济超过 65、防御超过 30^000000，便符合进入奥克尼尔的条件。";
				next;
				mes "[向导]";
				mes "此外，还要通过女武神在奥克尼尔设置的所有测试！";
				mes "你还会得到神秘礼物。";
				next;
				mes "[向导]";
				mes "你想尝试进入吗？";
				close;
			case 2:
				set .@Defence,GetCastleData(strnpcinfo(4),3);
				set .@Economy,GetCastleData(strnpcinfo(4),2);
				if ((.@Economy > 64) && (.@Defence > 29)) {
					mes "[向导]";
					mes "太好了！经济和防御都符合要求。";
					mes "现在可以进入奥克尼尔……";
					mes "要去那里吗？";
					next;
					switch(select("好，我们去那里:不了。")) {
					case 1:
						if (countitem(7839)) delitem 7839,countitem(7839); //Crystal_Key
						mes "[向导]";
						mes "好……";
						mes "请跟我来……";
						close2;
						warp "que_q"+.@sub$,346,32;
						end;
					case 2:
						mes "[向导]";
						mes "以后随时可以尝试……";
						mes "等你准备好保护这座城堡。";
						close;
					}
				}
				else {
					mes "[向导]";
					mes "你还不符合资格。";
					mes "请继续发展城堡……";
					close;
				}
			case 3:
				close;
			}
		}
		else if (getd("$siz_"+.@sub$+"_on") == 1) {
			mes "[向导]";
			mes "……好……";
			mes "祝你好运。";
			next;
			switch(select("现在进入:不了。")) {
			case 1:
				if (countitem(7839) > 0) {
					delitem 7839,countitem(7839); //Crystal_Key
				}
				mes "[向导]";
				mes "希望你得到想要的一切……";
				close2;
				warp "que_q"+.@sub$,346,32;
				end;
			case 2:
				mes "[向导]";
				mes "真的吗？";
				mes "很遗憾。";
				close;
			}
		}
		else if (getd("$siz_"+.@sub$+"_on") == 2) {
			mes "[向导]";
			mes "建造奥克尼尔需要很长时间。";
			mes "……即使它只是虚拟的……";
			next;
			mes "[向导]";
			mes "创建虚拟领域大约需要 12～13 小时。";
			close;
		}
		else {
			mes "[向导]";
			mes "你需要等待。";
			close;
		}
	}
	else {
		mes "[向导]";
		mes "……我以前没见过你。";
		mes "你是这里的陌生人，最好马上离开。";
		close;
	}
	end;

OnInit:
	set .@sub$,callfunc("F_Okolnir");
	enablenpc "Guide#gq_"+.@sub$;
	if (getd("$siz_"+.@sub$+"_on") == 1) setd "$siz_"+.@sub$+"_on", 0;
	end;
}


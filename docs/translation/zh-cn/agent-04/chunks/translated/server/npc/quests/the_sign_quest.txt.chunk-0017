que_sign01,196,39,4	script	Serin#serin	90,{
	callfunc "F_UpdateSignVars";
	if (sign_q < 132) {
		mes "[塞林]";
		mes "....?";
		close;
	}
	else if (sign_q == 132) {
		mes "[塞林]";
		mes "随着魔力增强，魔法阵即将完成。";
		mes "我让你寻找的符号是召唤黑暗领主所需的最后材料。";
		next;
		mes "[塞林]";
		mes "不过，那个符号的力量既能完成魔法阵，也能摧毁它。";
		mes "你愿意把它交给我吗？我选择摧毁它……";
		next;
		mes "[塞林]";
		mes "拜托……把符号给我。";
		next;
		select("把符号交给塞林。");
		mes "[塞林]";
		mes "这可能很危险，";
		mes "所以请退后……";
		delitem 7305,1; //Authority_Of_Nine_World
		set sign_q,133;
		donpcevent "Serin#dummy::OnEnable";
		donpcevent "Serin#dummy::OnStart";
		donpcevent "Serin#serin::OnDisable";
		close;
	}
	else if (sign_q == 133) {
		mes "[塞林]";
		mes "对不起。但我必须这样做，召唤黑暗领主。";
		next;
		select("但为什么……？");
		mes "[塞林]";
		mes "想召唤黑暗领主的从来不是那个女巫，而是我。";
		mes "我一直想恢复人类形态。我受够了被束缚在尼弗海姆！";
		next;
		mes "[塞林]";
		mes "遗憾的是，赫尔女士给你的符号只能使用一次。";
		mes "它的力量不足以让我复活，所以召唤黑暗领主是我最后的机会。";
		next;
		select("但如果黑暗领主来到米德加尔特……");
		mes "[塞林]";
		mes "哦，我很清楚黑暗领主进入生者领域会发生什么。";
		mes "他会毁灭米德加尔特，让成千上万的人死亡。";
		next;
		mes "[塞林]";
		mes "所以如果我复活而其他人都死了，";
		mes "你可能会觉得召唤黑暗领主让我复活毫无意义。但你知道吗？我不在乎。";
		next;
		mes "[塞林]";
		mes "活着的人不懂得珍惜拥有的一切，所以他们应该受罚。";
		mes "他们都去尼弗海姆吧，而我享受阳光的温暖和外界的新鲜空气。";
		next;
		mes "[塞林]";
		mes "也许你从未被束缚在尼弗海姆，所以不会同情我的处境，";
		mes "但我求你了。不要……";
		mes "";

		mes "我和你的事情已经结束了，现在走你的路吧。告诉梅茨别再来烦我！我不再帮忙了！";
		close;
	}
	else {
		mes "[Cyon]";
		mes "你竟敢闯入";
		mes "我的地盘？！现在";
		mes "趁我动手之前赶紧";
		mes "滚出去！没听见吗？";
		mes "滚出去！";
		close;
	}
}

alberta,165,83,4	script	Fastidious Old Man	755,{
	callfunc "F_UpdateSignVars";
	if (checkweight(908,200) == 0) {
		mes "^3355FF等一下！你现在携带的物品太多了。请清理一些库存空间后再回来。^000000";
		close;
	}
	mes "[弗兰克]";
	if (sign_q < 77) {
		mes "我的背~";
		mes "疼死了！";
		mes "我的眼睛也";
		mes "越来越痛。";
		mes "^333333*叹气*^000000我老了……";
		close;
	}
	else if (sign_q == 77) {
		mes "我的视力越来越";
		mes "模糊，读书时还头痛";
		mes "看来我这个老人";
		mes "只能去弄一副";
		mes "助视器了……";
		set sign_q,78;
		close;
	}
	else if (sign_q == 78) {
		if ((countitem(2203) > 0) && (countitem(7275) > 0)) {
			mes "我的视力越来越";
			mes "模糊，读书时还头痛";
			mes "看来我这个老人";
			mes "只能去弄一副";
			mes "助视器了……";
			next;
			switch(select("等等，我有一副眼镜……：路过。")) {
			case 1:
				mes "[弗兰克]";
				mes "哦，你把";
				mes "这副眼镜带来了？谢谢";
				mes "你，年轻人。现在";
				mes "我看得清了，能为你";
				mes "做些什么呢？";
				next;
				while(1) {
					switch(select("关于吉芬隐藏的力量:关于呜咽星光:解读古代文献")) {
					case 1:
						mes "[弗兰克]";
						mes "格芬的隐藏力量？";
						mes "我对此了解不多，但我确信吉芬塔不只是一座普通建筑。它一定是为了约束或容纳某种强大力量而建造的。";
						next;
						mes "[弗兰克]";
						mes "吉芬塔前的喷泉也可能有同样作用，但我没有确凿证据。因为我对吉芬没太大兴趣，所以没有调查……";
						next;
						mes "[弗兰克]";
						mes "不过……";
						mes "吉芬塔下方很可能封印着某种巨大力量。";
						next;
						break;
					case 2:
						mes "[弗兰克]";
						mes "哭泣星光？";
						mes "专家称它为‘神之泪滴’。有人认为它由神的声音创造。";
						next;
						mes "[弗兰克]";
						mes "当然，它可能不是由神的声音或泪滴制成的，但谁知道呢？据说呜咽星光上写着什么东西，无论是什么，一定都很重要……";
						next;
						break;
					case 3:
						mes "[弗兰克]";
						mes "我不敢相信！";
						mes "这是……我明白了。你想让我翻译这种古代语言。你很幸运，我大概是世上唯一能翻译它的人。";
						next;
						mes "[弗兰克]";
						mes "嗯，据我判断，这是古代诸神使用的复杂语言。它很复杂也很令人困惑，但我会尽力。之后再回来，我会告诉你我的发现。";
						delitem 2203,1; //Glasses
						delitem 7275,1; //Ancient_Document
						set sign_q,79;
						close;
					}
				}
			case 2:
				mes "[弗兰克]";
				mes "哦哦~";
				mes "我该如何";
				mes "继续";
				mes "我的毕生事业？如果";
				mes "不能阅读，我就无能为力……";
				close;
			}
		}
		else {
			mes "我的视力越来越";
			mes "模糊，读书时还头痛";
			mes "看来我这个老人";
			mes "只能去弄一副";
			mes "助视器了……";
			close;
		}
	}
	else if (sign_q == 79) {
		if (rand(1,50) == 9) {
				mes "我终于完成翻译了。解读其中一些词语的含义很有挑战。即使翻译成我们的语言，内容仍相当含糊。";
			next;
			mes "[弗兰克]";
				mes "我已经把尽可能准确的译文写下来了。这种挑战我很久没遇到过。谢谢你，年轻人。";
			mes "哈哈哈~";
			set sign_q,80;
			getitem 7274,1; //Ancient_Translator
			close;
		}
		else {
				mes "很抱歉，我还没翻译完。这种语言没有参考资料，所以需要很长时间。你之后再回来吧？";
			close;
		}
	}
	else {
		mes "世上有许多事情超出我们对世界的理解和想象。许多人害怕未知，但真正勇敢的人总会追寻真相。";
		close;
	}
}

gef_fild07,182,241,0	script	#Valkyrie Warp	111,1,1,{
	callfunc "F_UpdateSignVars";
	if ((sign_q == 80) && (countitem(907) > 3) && (countitem(953) > 11) && (countitem(7013) > 364)) {
		mes "^6B8E23似乎附近有什么东西正在对你持有的呜咽星光产生反应。也许你能在附近找到它……^000000";
		close;
	}

OnTouch_:
	if ((sign_q == 80) && (countitem(907) > 3) && (countitem(953) > 11) && (countitem(7013) > 364)) {
		mes "["+strcharinfo(0)+"]";
		mes "什么……？";
		mes "发生什么了？！";
		specialeffect2 EF_BEGINSPELL6;
		next;
		mes "^3355FF不知为何，在这个地方，呜咽星光与你持有的树脂、石心和珊瑚礁产生反应。所有物品都在剧烈共鸣……^000000";
		specialeffect2 EF_ENHANCE;
		next;
		mes "^3355FF突然，这些物品发出耀眼光芒，包裹住你的全身，随后你慢慢失去意识……^000000";
		specialeffect2 EF_FLASHER;
		next;
		delitem 907,4; //Resin
		delitem 953,12; //Stone_Heart
		delitem 7013,365; //Coral_Reef
		set sign_q,81;
		warp "himinn",49,10;
		end;
	}
	else if (sign_q == 203) {
		mes "^3355FF现在靠近这个区域时，似乎什么也不会发生。^000000";
		close;
	}
	else if (sign_q > 80) {
		warp "himinn",49,10;
	}
	end;
}

himinn,48,86,5	script	Valkyrie#sign	811,{
	callfunc "F_UpdateSignVars";
	mes "[女武神桑德拉]";
	if (sign_q < 81) {
		mes "只有被选中者";
		mes "才能进入这里。";
		mes "我不问你如何";
		mes "获得入场资格，但我要求你";
		mes "离开。";
		close2;
		warp "gef_fild07",180,242;
		end;
	}
	else if (sign_q == 81) {
		mes "欢迎你，"+strcharinfo(0)+"，";
		mes "来到这片神圣领域。";
		mes "你历经艰难、考验勇气，才获得作为测试凭证的呜咽星光。";
		next;
		select("测试……？");
		mes "[女武神桑德拉]";
		mes "诸神决定你值得接受一项评判功绩的特殊测试。";
		mes "如果你是心灵纯洁的真正英雄，一定会成功……";
		next;
		mes "[女武神桑德拉]";
		mes "现在，^FF0000堕落战士居住的领域^000000出现了危机。";
		mes "诸神希望你平息那里的一股邪恶影响，恢复平衡。";
		next;
		mes "[女武神桑德拉]";
		mes "你会遇到许多障碍。首先是堕落者，他们会把愤怒与仇恨指向你。";
		mes "他们无法进入英灵殿，而你将获得一次罕见而奇妙的机会……";
		next;
		mes "[女武神桑德拉]";
		mes "其次，也是更重要的，你必须独自找出这股邪恶影响。";
		mes "这将考验你辨别善恶的能力。不要相信表象……";
		next;
		mes "[女武神桑德拉]";
		mes "这就是你的任务。我不能再告诉你更多。";
		mes "现在你必须前往那里，从其中一颗心中找出真正的黑暗……";
		set sign_q,82;
		percentheal 100,100;
		if (checkre(3)) {
			if (BaseLevel < 56) getexp 900,0;
			else if ((BaseLevel > 55) && (BaseLevel < 61)) getexp 1200,0;
			else if ((BaseLevel > 60) && (BaseLevel < 66)) getexp 2000,0;
			else if ((BaseLevel > 65) && (BaseLevel < 71)) getexp 3500,0;
			else if ((BaseLevel > 70) && (BaseLevel < 76)) getexp 7000,0;
			else if ((BaseLevel > 75) && (BaseLevel < 81)) getexp 12000,0;
			else if ((BaseLevel > 80) && (BaseLevel < 86)) getexp 16000,0;
			else if ((BaseLevel > 85) && (BaseLevel < 91)) getexp 21000,0;
			else getexp 35000,0;
		} else {
			if (BaseLevel < 56) getexp 9000,0;
			else if ((BaseLevel > 55) && (BaseLevel < 61)) getexp 12000,0;
			else if ((BaseLevel > 60) && (BaseLevel < 66)) getexp 20000,0;
			else if ((BaseLevel > 65) && (BaseLevel < 71)) getexp 35000,0;
			else if ((BaseLevel > 70) && (BaseLevel < 76)) getexp 70000,0;
			else if ((BaseLevel > 75) && (BaseLevel < 81)) getexp 120000,0;
			else if ((BaseLevel > 80) && (BaseLevel < 86)) getexp 160000,0;
			else if ((BaseLevel > 85) && (BaseLevel < 91)) getexp 210000,0;
			else getexp 350000,0;
		}
		close2;
		warp "geffen",120,100;
		end;
	}
	else if (sign_q < 95) {
		mes "我赞赏你在亡者领域生存的能力。";
		mes "对凡人来说，忍受那里的残酷一定很困难。";
		close;
	}
	else if (sign_q == 95) {
		mes "遗憾的是，我不能直接给你答案。";
		mes "你必须独自克服诸神的考验。我能做的只有提供指引和祈祷。^FFFFFFcobo^000000";
		next;
		mes "[女武神桑德拉]";
		mes "记住，诸神想看到的是你对信念的证明，";
		mes "而不是盲目遵从信仰的决定。";
		next;
		mes "[女武神桑德拉]";
		mes "永远带着智慧与勇气前进。";
		mes "我只能告诉你这些。";
		set sign_q,96;
		close;
	}
	else if ((sign_q == 129) || (sign_q == 130)) {
		mes "欢迎回来。你不仅通过了诸神为你设置的考验，还在亡者领域考验勇气，保护了米德加尔特免受攻击。";
		next;
		mes "[女武神桑德拉]";
		mes "我很高兴宣布，诸神一直在注视你，并决定邀请你前往英灵殿。不过米德加尔特仍非常需要你。";
		next;
		mes "[女武神桑德拉]";
		mes "作为邀请你前往英灵殿的承诺象征，你将获得‘The Sign’，证明你是经受诸神亲自考验的伟大战士。";
		next;
		mes "[女武神桑德拉]";
		mes "恭喜你，";
		mes ""+ strcharinfo(0) +". Verily,";
		mes "你是值得赞美的荣耀英雄！";
		set sign_q,137;
		getitem 7314,1; //The_Sign
		close;
	}
	else if (sign_q < 150) {
		mes "诸神正在注视你。";
		close;
	}
	else if ((sign_q > 199) && (sign_q < 202)) {
		mes "你还没有完全证明自己的勇气。";
		mes "完成后，诸神会召唤你。";
		close;
	}
	else if (sign_q == 202) {
		mes "诸神对你的决定感到失望。遗憾的是，你已被逐出英灵殿和这里。";
		next;
		mes "[女武神桑德拉]";
		mes "虽然你失败了，但希望你能找到自己的";
		mes "另一种赢回诸神青睐的方法……";
		set sign_q,203;
		close;
	}
	else {
		if (countitem(7314) < 1) {
			mes "只有被选中者";
			mes "才能进入这里。";
			mes "我不问你如何";
			mes "获得入场资格，但我要求你";
			mes "离开。";
			close2;
			warp "gef_fild07",180,242;
			end;
		}
		else {
			mes "伟大的战士，你的时机尚未到来。";
			mes "在诸神召唤你之前，请专心训练……";
			close;
		}
	}
}


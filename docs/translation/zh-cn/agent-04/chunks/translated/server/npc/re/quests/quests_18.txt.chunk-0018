// Quest: Transporting Goods. Step 5.
gw_fild01,202,102,0	script	#ep18_wp03	HIDDEN_WARP_NPC,4,4,{
	end;
OnTouch:
	if (isbegin_quest(12534) == 1) {
		cloakoffnpcself( "#ep18_2_mon" );
		cloakoffnpcself( "Camille#ep18_2" );
		end;
	}
	if (isbegin_quest(12534) == 2 && isbegin_quest(12535) == 0) {
		cloakoffnpcself( "Camille#ep18_2" );
		end;
	}
	end;
}

gw_fild01,205,102,4	script(CLOAKED)	#ep18_2_mon	EP18_GREY_WOLF,{
	if (ep18_main < 36)
		end;
	if (isbegin_quest(12534) != 1)
		end;
	.@wolf_hp = 1000;
	.@camille_hp = 1000;

	mes "^0000ff情况似乎不利。^000000";
	next;
	npctalk "Arrgghh...", "#ep18_2_mon", bc_self;
	next;
		npctalk "天哪", "Camille#ep18_2", bc_self;
	next;
	mes "^0000ff我似乎要倒下了。无法集中注意力攻击，双眼不停打转。恐怕连一秒都撑不过去，会成为狼群的美餐。^000000";
	next;
	while(1) {
		next;
		switch( select( "给 Camille 战斗建议", "我亲自处理狼", "假装没注意到并路过" ) ) {
		case 1:
			mes "^0000ff告诉 Camille 攻击狼的位置？^000000";
			PlayBGM "182";
			while(1) {
				mes "Wolf vitality - ^ff0000" + .@wolf_hp + "^000000";
				mes "Camille's vitality - ^0000ff" + .@camille_hp + "^000000";
				next;
				switch( select( "胆怯攻击（高概率）", "中等攻击（普通概率）", "强力攻击（低概率）", "反击（极低概率）", "暂时逃跑" ) ) {
				case 1:
					.@wolf_chance = 65;	// 65% chance the wolf is being hit / 35% Camille
					.@wolf_damage = rand(25,50);
					.@camille_damage = rand(45,93);
					break;
				case 2:
					.@wolf_chance = 42;
					.@wolf_damage = rand(32,58);
					.@camille_damage = rand(37,72);
					break;
				case 3:
					.@wolf_chance = 30;
					.@wolf_damage = rand(45,70);
					.@camille_damage = rand(34,53);
					break;
				case 4:
					.@wolf_chance = 25;
					.@wolf_damage = rand(66,80);
					.@camille_damage = rand(26,50);
					break;
				case 5:
				mes "我很沮丧，但现在没有获胜机会。修正策略后再试一次吧。";
					close;
				}
				if (.@wolf_chance > rand(100)) {
					.@wolf_hp = .@wolf_hp - .@wolf_damage;
					npctalk "-" + .@wolf_damage, "#ep18_2_mon", bc_self;
					npctalk " ", "Camille#ep18_2", bc_self;
					specialeffect EF_ACIDDEMON, SELF, "#ep18_2_mon";
					specialeffect EF_HFLIMOON3, SELF, "#ep18_2_mon";
				}
				else {
					.@camille_hp = .@camille_hp - .@camille_damage;
					npctalk " ", "#ep18_2_mon", bc_self;
					npctalk "-" + .@camille_damage, "Camille#ep18_2", bc_self;
					specialeffect EF_ACIDDEMON, SELF, "Camille#ep18_2";
					specialeffect EF_HFLIMOON3, SELF, "Camille#ep18_2";
				}
				if (.@wolf_hp < 1) {
					mes "^0000ff你击败了灰狼。^000000";
					completequest 12534;
					cloakonnpcself( "#ep18_2_mon" );
					playbgm "183";
					close;
				}
				if (.@camille_hp < 1) {
					next;
					mes "^ff0000危险！！我必须停止战斗并恢复 Camille 的健康。^000000";
					playbgm "183";
					close;
				}
			}
			break;
		case 2:
			mes "^0000ff不，也许让 Camille 自己成长才是正确的……^000000";
			continue;
		case 3:
			mes "^0000ff稍后回来为 Camille 建墓。^000000";
			close;
		}
		end;
	}
	end;

OnInit:
	questinfo( QTYPE_QUEST2, QMARK_YELLOW, "isbegin_quest(12534) == 1" );
	end;
}

// Quest: Transporting Goods. Step 6.
gw_fild01,201,102,6	script	Camille#ep18_2	4_EP18_KAMIL,{
	if (ep18_main < 36)
		end;
	if (isbegin_quest(12534) == 2 && isbegin_quest(12535) == 0) {
		mes "^0000ffCamille 的身体因战斗后的兴奋而微微颤抖。^000000";
		npctalk "Heuk...heuk... ", "Camille#ep18_2", bc_self;
		next;
		select( "你的动作不错", "太糟了。别再碰剑" );
		npctalk "不，" + strcharinfo(0) + "，要不是你的指示，我肯定已经彻底失败了。", "Camille#ep18_2", bc_self;
		next;
		select( "你为什么放弃马车来到这里？" );
		npctalk "我追赶那些带着货物逃跑的人，事情就变成这样了。我没能找回全部货物，但至少救回了一些。", "Camille#ep18_2", bc_self;
		next;
		npctalk "我得先把探险车运回村子。我们应该收集剩余物资，并为造成的不便道歉。", "Camille#ep18_2", bc_self;
		next;
		select( "这不只是一次意外吗？也许没必要道歉……" );
		npctalk "这些货物对村子的生存至关重要。失去它们会是一次重大打击。", "Camille#ep18_2", bc_self;
		next;
		select( "你对贸易管理员太苛刻了。" );
		npctalk "师父阻止过我，但我还是坚持带领商队，这就是我的错。没人强迫我这么做。", "Camille#ep18_2", bc_self;
		next;
		npctalk "如果我死在这里或逃走，师父就必须承担责任。这绝不能发生。", "Camille#ep18_2", bc_self;
		next;
		select( "我不再和你争论了。按你认为最好的方式做吧。", "我们要逃跑吗？" );
		npctalk "再次感谢你的帮助。我现在得回到队伍了。如果命运让我们再次相遇，希望还能见到你……", "Camille#ep18_2", bc_self;
		setquest 12535;
		close2;
		npctalk "你还没离开啊。我先走了。", "Camille#ep18_2", bc_self;
		cloakonnpcself( "Camille#ep18_2" );
		setnpcdisplay( "Boksil#wms03", CLEAR_NPC );
		end;
	}
	mes "^0000ff看来你现在无法好好听清对话。^000000";
	close;

OnInit:
	cloakonnpc strnpcinfo(0);
	questinfo( QTYPE_QUEST2, QMARK_YELLOW, "isbegin_quest(12534) == 2 && isbegin_quest(12535) == 0" );
	end;
}

wolfvill,76,210,0	script	#ep18_wp03_	HIDDEN_WARP_NPC,4,4,{
	end;
OnTouch_:
	if (isbegin_quest(12531) == 1 || isbegin_quest(12535) == 1) {
		cloakoffnpcself( "Hazar#ep18_3" );
		cloakoffnpcself( "Camille#ep18_3" );
		cloakoffnpcself( "Observer#ep18_31" );
		cloakoffnpcself( "Observer#ep18_32" );
		cloakoffnpcself( "Observer#ep18_33" );
	}
	end;
}

// Quest: Transporting Goods. Step 7 + 12 (final).
wolfvill,75,214,4	script(CLOAKED)	Hazar#ep18_3	4_EP18_HAZAR,{
	if (ep18_main < 36)
		end;
	if (!checkweight(1000405,20)) {
	mes "^ff0000我想我携带的物品太重了。请整理一下物品栏。^000000";
		close;
	}
	if (isbegin_quest(12535) == 1) {
	mes "^0000ff灰狼村的首领们正在召开会议。^000000";
		next;
		npctalk "我向大家道歉。我能力不足，没能正确指导我的徒弟。", "Hazar#ep18_3", bc_self;
		next;
		npctalk "Hazar，这不是你的错。更重要的是 Camille 把探险推进到极限之外的鲁莽决定。", "Observer#ep18_31", bc_self;
		next;
		npctalk "不，是我违背徒弟意愿，把她推进探险队的。", "Hazar#ep18_3", bc_self;
		next;
		npctalk "真的吗，Camille？你的意思是导师违背你的意愿强迫你参加探险？", "Observer#ep18_33", bc_self;
		next;
		npctalk "我真诚地向大家道歉。而且不是导师强迫我，是我不顾他的劝告坚持参加探险。", "Camille#ep18_3", bc_self;
		next;
		npctalk "我就知道会变成这样。Hazar 突然说身体不适时，我就觉得不对劲。", "Observer#ep18_32", bc_self;
		next;
		npctalk "Camille，你现在到底在做什么！", "Hazar#ep18_3", bc_self;
		next;
		npctalk "我不顾导师的建议，坚持完成任务，结果没能做好。这全是我的错。", "Camille#ep18_3", bc_self;
		next;
		npctalk "Ahem... hmm", "Observer#ep18_31", bc_self;
		npctalk "Wow~", "Observer#ep18_32", bc_self;
		npctalk "Tsk Tsk.", "Observer#ep18_33", bc_self;
		next;
		npctalk "看来我大致了解情况了。那么，我们讨论一下事故后的处理程序吧？", "Observer#ep18_33", bc_self;
		next;
		npctalk "大家听我说！为什么要这样急着做决定！", "Hazar#ep18_3", bc_self;
		next;
		npctalk "说实话，我们不是从 Camille 小时候起就一直照顾她吗？我理解现在的情况。", "Observer#ep18_32", bc_self;
		next;
		npctalk "确实有特殊情况，但领导层也有自己的规章制度，对吧？", "Observer#ep18_33", bc_self;
		next;
		emotion ET_HUK, getnpcid(0,"Observer#ep18_31");
		npctalk "你这人！按照规定，你应该承担后果！这不是能轻易带过的事！", "Observer#ep18_31", bc_self;
		next;
		npctalk "不，确实如此，但是……唉，我们该怎么办？", "Observer#ep18_33", bc_self;
		next;
		npctalk "我会遵守规则。毕竟这是我自己的决定。", "Camille#ep18_3", bc_self;
		next;
		npctalk "糟糕！Camille，你这个淘气鬼！现在不是你说话的时候！", "Hazar#ep18_3", bc_self;
		next;
		npctalk "冷静。我们正在讨论领导层的规则。先看看 Camille 做出这个决定的依据。", "Observer#ep18_31", bc_self;
		next;
		npctalk "损失了原本用于冬季预算的 800 千克毛皮。此外还因这次损失无法购买补给。", "Observer#ep18_33", bc_self;
		next;
		npctalk "嗯……即使现在，我们不能由领导层组织搜索队寻找丢失的货物吗？", "Observer#ep18_31", bc_self;
		next;
		npctalk "确实如此。不过如果领导层解决了这件事，Camille 的错误就会正式成为处罚对象。", "Observer#ep18_33", bc_self;
		next;
		npctalk "没错，目前村民和领导层中负责实际事务的人还不知道这件事。一旦派出搜索队，Camille 的过错就会被确认。", "Observer#ep18_32", bc_self;
		next;
		select( "我们再考虑其他建议" );
		unittalk getcharid(3), "" + strcharinfo(0) + "：如果外部人员私下找回并归还货物，领导层会如何处理？", bc_self;
		next;
		npctalk "不，你是 " + strcharinfo(0) + "，对吧？", "Hazar#ep18_3", bc_self;
		next;
		npctalk "哦，这是个好建议。如果外人悄悄解决这件事而不被任何人发现，这起事故本身就可以视为不存在。", "Observer#ep18_33", bc_self;
		next;
		npctalk "领导层的规则不能惩罚他们不知道的事情。", "Observer#ep18_31", bc_self;
		next;
		npctalk "" + strcharinfo(0) + "，你的意思是……可以把这理解为替领导层寻找丢失货物的提议？", "Hazar#ep18_3", bc_self;
		next;
		select( "我来试试看。", "这是什么玩笑？" );
		npctalk "谢谢你，" + strcharinfo(0) + "。我来带头指路。", "Camille#ep18_3", bc_self;
		next;
		npctalk "不行。必须让这起事故不存在。Camille，你不能带头处理。", "Observer#ep18_33", bc_self;
		next;
		npctalk "" + strcharinfo(0) + "，你是指我吗？谢谢你为可怜的 Camille 挺身而出。我代她向你表示感谢。", "Observer#ep18_31", bc_self;
		next;
		npctalk "我也向你表示感谢。那孩子虽然有些缺点，但不该因为这种事故丢掉性命。", "Observer#ep18_32", bc_self;
		next;
		npctalk "要表达如此深的谢意并不容易。你打算怎么做？我会告诉你 Camille 大概的位置。", "Hazar#ep18_3", bc_self;
		next;
		npctalk "是的，我明白了。", "Camille#ep18_3", bc_self;
		next;
	mes "^ff0000我大致查到了 Camille 抢走的货物被运往哪里。^000000";
		completequest 12535;
		setquest 12536;
		setquest 12537;
		setquest 12538;
		setquest 12539;
		next;
		npctalk "那么，" + strcharinfo(0) + "，一切就拜托你了。", "Hazar#ep18_3", bc_self;
		next;
		npctalk "Um, this meeting never happened. Let's quickly disperse.", "Observer#ep18_31", bc_self;
		next;
		npctalk "当然。我也很忙。解散吧。", "Observer#ep18_33", bc_self;
		next;
		cloakonnpcself( "Hazar#ep18_3" );
		cloakonnpcself( "Camille#ep18_3" );
		cloakonnpcself( "Observer#ep18_31" );
		cloakonnpcself( "Observer#ep18_32" );
		cloakonnpcself( "Observer#ep18_33" );
		close;
	}
	if (isbegin_quest(12531) == 1) {
	mes "^0000ff灰狼村的首领们正在召开会议。^000000";
		next;
		unittalk getcharid(3), "" + strcharinfo(0) + "：我发现丢失的货物后马上收集起来了。请检查数量。", bc_self;
		next;
		npctalk "Oh, this quickly?", "Observer#ep18_31", bc_self;
		next;
		npctalk "看来我已经第二次欠你人情了。嗯，算上和 Camille 的战斗，是第三次吗？", "Hazar#ep18_3", bc_self;
		next;
		npctalk "我对你充满感激。真的……谢谢你。", "Camille#ep18_3", bc_self;
		next;
		npctalk "Let's see, 500 leather, 280 fur processing... hmm, a bit short on fur, but...", "Observer#ep18_32", bc_self;
		next;
		npctalk "按这个程度来看，只是普通的损失和损坏。", "Observer#ep18_33", bc_self;
		next;
		npctalk "确实在可接受范围内。呼……我们可以继续会议议程了。", "Observer#ep18_31", bc_self;
		next;
		select( "新的议程是什么？" );
		npctalk "原本的议程是讨论贸易货物损失，现在变成了讨论领导层出发延迟，对吧，首领？", "Observer#ep18_33", bc_self;
		next;
		npctalk "哦……嗯。是的，我明白了。看来我们要比原计划晚两天出发。", "Hazar#ep18_3", bc_self;
		next;
		npctalk "师父……那是……", "Camille#ep18_3", bc_self;
		next;
		npctalk "冷静，Camille。现在别急着下结论。延迟出发的惩罚是什么？", "Hazar#ep18_3", bc_self;
		next;
		npctalk "接下来三个月是反省期，我要履行领导层职责，并反省自己作为高级管理者的行为。", "Observer#ep18_33", bc_self;
		next;
		npctalk "我没有异议。", "Observer#ep18_31", bc_self;
		next;
		npctalk "我也没有异议。", "Observer#ep18_32", bc_self;
		next;
		npctalk "看来你躲过了一场重大危机，Camille。", "Hazar#ep18_3", bc_self;
		next;
		npctalk "谢谢师父。我也感谢首领。", "Camille#ep18_3", bc_self;
		next;
		npctalk "咳，够了。既然出发延迟了，就去准备再次启程。", "Observer#ep18_31", bc_self;
		next;
		npctalk "确实，从今天起我必须尽快接受惩罚。", "Observer#ep18_32", bc_self;
		next;
		npctalk "既然重要事项已经解决，我们就结束讨论吧。再次感谢你，" + strcharinfo(0) + "。我真的很感激。这是一点谢礼。", "Hazar#ep18_3", bc_self;
		next;
		npctalk "非常感谢你，" + strcharinfo(0) + "。你救了我的命。这是一点谢礼。", "Camille#ep18_3", bc_self;
		emotion ET_CRY, getnpcid(0,"Observer#ep18_31");
		completequest 12531;
		getitem 1000405,20;	// Ep18_Amethyst_Fragment
		getexp 7769124,3000000;
		add_reputation_points(REPUTATION_EP18, 100);
		if (get_reputation_points(REPUTATION_EP18) >= 1000 && ep18_main == 36) {// Custom implementation: reputation 1000 on wolfvill => player can continue the main quest
			ep18_main = 37;
			setquest 18082;
			mes "^4d4dff灰狼村的村民已接受你成为村子的一员。^000000";
			mes "你有资格参加^4d4dff会议。^000000";
		}
		next;
		mes "^4d4dff你获得了好评。^000000";
		close2;
		cloakonnpcself( "Hazar#ep18_3" );
		cloakonnpcself( "Camille#ep18_3" );
		cloakonnpcself( "Observer#ep18_31" );
		cloakonnpcself( "Observer#ep18_32" );
		cloakonnpcself( "Observer#ep18_33" );
		end;
	}
	end;

OnInit:
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "isbegin_quest(12535) == 1" );
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "isbegin_quest(12531) == 1" );
	end;
}


//-------------------------------------------------------------------
// Quest: Clinic Construction. Step 1 + 3 + 4 + 5 (final).
wolfvill,171,253,5	script	Ezekiel#hms01	4_M_RACHMAN2,5,5,{
	if (checkweight(1000405,20) == 0) {
		mes "- 等一下！！-";
		mes "- 你目前携带的物品-";
		mes "- 太多了。-";
		mes "- 减轻负重后-";
		mes "- 请再试一次。-";
		close;
	}
	if (ep18_main < 36) {
		mes "[Ezekiel]";
		mes "我来这里不可能是错误的选择吧……？";
		close;
	}
	switch( isbegin_quest(17507) ) {
	case 0:
		if (isbegin_quest(17506) == 1) {
			if (countitem(999) < 3) {
				mes "[Ezekiel]";
				mes "这里大多数东西都能找到，但没有钢铁。我想请你帮个小忙，只要 3 个……";
				close;
			}
			mes "[Ezekiel]";
			mes "钢铁！！钢铁什么时候来！……哦，已经来了。你也来了，冒险者。很重吧？交给我。我不能让你再拿一秒，你可是珍贵的人。谢谢，你做得很好。";
			next;
			mes "[Ezekiel]";
			mes "诊所建成后，我们会把你的名字刻在基石上，让你的名字伴随未来的新生儿流传下去。";
			next;
			emotion ET_SWEAT, playerattached();
			mes "[Ezekiel]";
			mes "即使时间流逝、建筑消失，冒险者的意志也会永远留存。";
			next;
			select( "不，没必要……" );
			mes "[Ezekiel]";
			mes "有了这些钢铁，我现在就能建造一座经得起各种天气和环境考验的诊所。";
			next;
			cloakoffnpcself( "Old Man#hms01" );
			cloakoffnpcself( "Old Man#hms02" );
			cloakoffnpcself( "Old Man#hms03" );
			mes "[Old Man]";
			mes "等等，你在做什么？";
			npctalk "我说得还不够清楚吗？", "Old Man#hms03", bc_self;
			next;
			mes "[Old Man]";
			mes "你是说现在要建诊所？";
			next;
			select( "冷静点，老人家……" );
			mes "[Old Man]";
			mes "你说冷静是什么意思？我们现在正在进行冷静、理性的对话！";
			npctalk "我们没有精力做这种事！", "Old Man#hms02", bc_self;
			next;
			mes "[Ezekiel]";
			mes "你为什么要这样做？你是在排斥新来的人吗？";
			next;
			mes "[Old Man]";
			mes "天啊，我们不是那种人。";
			npctalk "什么？你是什么意思？", "Old Man#hms03", bc_self;
			next;
			mes "[Ezekiel]";
			mes "那你为什么如此反对？";
			next;
			mes "[Old Man]";
			mes "你想要的舒适生活是陷阱。陌生的东西、舒适的东西，都会毁了我们。";
			next;
			mes "[Ezekiel]";
			mes "舒适的住房、兴盛的学校、干净的诊所。我们为什么不能拥有？我们躲避的是歧视，不是便利。";
			next;
			mes "[Ezekiel]";
			mes "反正我住在这里，有更好的设施又有什么坏处？";
			next;
			mes "[Old Man]";
			mes "不，我想这就是新来的人想要的吧？";
			npctalk "没错！", "Old Man#hms01", bc_self;
			next;
			mes "[Old Man]";
			mes "让身体习惯舒适，会让不舒适的生活变得无法忍受。在他们提供的最低限度生活中知足地活着吧。";
			mes "他们说，如果你抗议，连这些也会被收回。";
			next;
			mes "[Old Man]";
			mes "你以为我们还要在这里住多久，更别提夺回自己的土地了！";
			npctalk "我是认真的！", "Old Man#hms03", bc_self;
			next;
			mes "[Old Man]";
			mes "你现在拥有的已经够多了，还需要什么？";
			next;
			mes "[Ezekiel]";
			mes "我这么做不是因为不知感恩。他们说不把这些带来，是因为对他们来说太陌生了。科技和设施一直在发展，只是你不明白！";
			next;
			cloakoffnpcself( "Maram#hms01" );
			cloakoffnpcself( "Villager#hms01" );
			cloakoffnpcself( "Injured#hms01" );
			mes "[Joel]";

			mes "16. 可爱缎带的正确防御和能力是什么？";
			next;
			if (select("0 / SP +20:0 / SP +30:1 / SP +20:1 / SP +30") == 3)
				set .@sage_t,.@sage_t+5;
			mes "17. 请选择无法装备圣职者长袍的职业。";
			next;
			if (select("Swordman:Merchant:Thief:Acolyte") == 3)
				set .@sage_t,.@sage_t+5;
			mes "18. 请选择绿色药水无法治愈的异常状态。";
			next;
			if (select("Silence:Chaos:Blind:Curse") == 4)
				set .@sage_t,.@sage_t+5;
			mes "19. 请选择在吉芬某处消失的古代王国的正确名称。";
			next;
			if (select("Geffayon:Geffenia:Gefenn:Jaffen") == 2)
				set .@sage_t,.@sage_t+5;
			mes "20. 请选择成为世界根源之树的正确名称。";
			next;
			if (select("Yggdrasil:Iggdrassil:Mastella:Dead Branch") == 1)
				set .@sage_t,.@sage_t+5;
			break;
		case 3:
			mes "1. 请选择吉芬魔法道具商人不出售的物品。";
			next;
			if (select("Mantle:Wand:Circlet:Silver Robe") == 1)
				set .@sage_t,.@sage_t+5;
			mes "2. 请选择无法从 NPC 购买刀的城市。";
			next;
			if (select("Prontera:Izlude:Al De Baran:Payon") == 3)
				set .@sage_t,.@sage_t+5;
			mes "3. 请选择离古城最近的城市。";
			next;
			if (select("Prontera:Geffen:Morocc:Payon") == 2)
				set .@sage_t,.@sage_t+5;
			mes "4. 请选择与其他魔物类型不同的魔物。";
			next;
			if (select("Aster:Marc:Marse:Marin") == 4)
				set .@sage_t,.@sage_t+5;
			mes "5. 请选择属性不同的魔物。";
			next;
			if (select("Baby Desert Wolf:Smokie:Picky:Choco") == 2)
				set .@sage_t,.@sage_t+5;
			mes "6. 请选择体型不同的魔物。";
			next;
			if (select("Drake:Wraith:Evil Druid:Khalitzburg") == 1)
				set .@sage_t,.@sage_t+5;
			mes "7. 请选择不会掉落‘普拉康’的魔物。";
			next;
			if (select("Pupa:Peco Peco Egg:Savage Bebe:Baby Desert Wolf") == 2)
				set .@sage_t,.@sage_t+5;
			mes "8. 请选择与铁匠转职任务无关的 NPC。";
			next;
			if (select("Altiregen:Geschupenschte:Barcadi:Baisulist") == 3)
				set .@sage_t,.@sage_t+5;
			mes "9. 请选择不是艾尔迪巴兰居民的 NPC。";
			next;
			if (select("RS125:GOD-POING:Stromme:Chemirre") == 2)
				set .@sage_t,.@sage_t+5;
			mes "10. 请选择员工中最年轻的卡普拉小姐。";
			next;
			if (select("Pavianne:Roxie:Leilah:Curly Sue") == 4)
				set .@sage_t,.@sage_t+5;
			mes "11. 请选择 6 级安全之墙的正确 SP 消耗和可回避次数。";
			next;
			if (select("SP 40, 6 times:SP 35, 6 times:SP 40, 7 times:SP 35, 7 times") == 3)
				set .@sage_t,.@sage_t+5;
			mes "12. 请选择 6 级火焰之环的正确魔法攻击力。";
			next;
			if (select("MATK * 1.2:MATK * 1.3:MATK * 1.4:MATK * 1.5") == 2)
				set .@sage_t,.@sage_t+5;
			mes "13. 请选择法师转职任务 4 号魔法药水所用的催化石。";
			next;
			if (select("Blue Gemstone:Red Gemstone:Yellow Gemstone:1 carat Diamond") == 4)
				set .@sage_t,.@sage_t+5;
			mes "14. 请选择剑士技能 6 级狂击的正确攻击力和 SP 消耗。";
			next;
			if (select("250% / 8:280% / 8:280% / 15:310% / 15") == 3)
				set .@sage_t,.@sage_t+5;
			mes "15. 请选择与学习猎人技能地雷陷阱无关的技能。";
			next;
			if (select("Remove Trap:Land Mine:Ankle Snare:Flasher") == 1)
				set .@sage_t,.@sage_t+5;
			mes "16. 请选择婚纱的正确防御和能力。";
			next;
			if (select("0 / MDEF +3:0 / MDEF +5:1 / MDEF +3:1 / MDEF +5") == 2)
				set .@sage_t,.@sage_t+5;
			mes "17. 请选择无法装备外套的职业。";
			next;
			if (select("Swordman:Merchant:Thief:Novice") == 4)
				set .@sage_t,.@sage_t+5;
			mes "18. 请选择不是蓝色染料材料的物品。";
			next;
			if (select("Alcohol:Detrimindexta:Karvodailnirol:Blue Herb") == 3)
				set .@sage_t,.@sage_t+5;
			mes "19. 神奥丁创造世界时使用了什么材料？";
			next;
			if (select("The heart of Ymir:The nail of Ymir:The tooth of Ymir:The memento of Ymir") == 1)
				set .@sage_t,.@sage_t+5;
			mes "20. 请选择传说中能给命中注定之人带来财富与名声的金属。";
			next;
			if (select("Empelium Gold:Emperium:Emperor:Phracon") == 2)
				set .@sage_t,.@sage_t+5;
		}
		mes "[克莱托斯·维尔多]";
		if (SAGE_Q == 4) {

			if (select("lvl 4 Fire Bolt:lvl 4 Napalm Beat:lvl 5 Fire Ball:lvl 1 Sight") == 2)
				set .@sage_t,.@sage_t+5;
			mes "12. 6 级禅心在不受 INT 影响时能恢复多少 SP？";

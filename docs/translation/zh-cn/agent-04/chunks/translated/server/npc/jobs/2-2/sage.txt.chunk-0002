		case 3:
			mes "[梅修斯·西尔菲]";
			mes "我明白了，慢慢来。你也可以四处看看。";
			mes "再见，祝你今天愉快。";
			close;
		}
	}
	else if (SAGE_Q >= 1 && SAGE_Q <= 3) {
		mes "再次欢迎你。";
		next;
		if (countitem(1006) > 0 && countitem(1007) > 0) {
			delitem 1006,1; //Old_Magic_Book
			delitem 1007,1; //Penetration
			mes "[梅修斯·西尔菲]";
			mes "做得好。我继续处理你的申请。";
			set SAGE_Q,4;
			next;
		}
		else if (Zeny > 69999) {
			set Zeny, Zeny-70000;
			mes "[梅修斯·西尔菲]";
			mes "做得好。我继续处理你的申请。";
			set SAGE_Q,4;
			next;
		}
		else {
			switch (SAGE_Q) {
			case 1:
				//Feather_Of_Bird, Fluff, Iron_Ore
				setarray .@item[0], 916,914,1002; 
				setarray .@count[0], 50,50,25; 
				break;
			case 2:
				//Clover, Feather, Chinese_Ink
				setarray .@item[0], 705,949,1024;
				setarray .@count[0], 50,50,25;
				break;
			case 3:
				//Feather_Of_Bird, Fluff, Clover, Feather
				setarray .@item[0], 916,914,705,949;
				setarray .@count[0], 50,50,50,50;
				break;
			}
			set .@size, (getarraysize(.@item)-1); 
			for( set .@i,0 ; .@i < .@size && countitem(.@item[.@i]) >= .@count[.@i] ; set .@i,.@i+1 );
			if(.@i == .@size) {  
				if (Zeny > 29999) {
					for (set .@i, 0; .@i < .@size ; set .@i, .@i+1)
						delitem .@item[.@i], .@count[.@i];  
					set Zeny, Zeny-30000;
					mes "[梅修斯·西尔菲]";
					mes "做得好。我继续处理你的申请。";
					set .@SAGE_Q_T,SAGE_Q;
					set SAGE_Q,4;
					next;
				}
				mes "[梅修斯·西尔菲]";
				mes "很遗憾，你还没有准备好。";
				mes "虽然你带齐了所有物品，但现在的钱少于30000 Zeny。";
				next;
				mes "[梅修斯·西尔菲]";
				mes "正如我之前说的，你必须同时带齐所有物品和30000 Zeny。";
				mes "请确认你拥有所需物品和金钱。";
				close;
			}
			else {
				mes "[梅修斯·西尔菲]";
				mes "很遗憾，你似乎没有带齐所需物品。";
				mes "如果你忘了，我再提醒你该带什么。";
				next;
				mes "[梅修斯·西尔菲]";
				mes "请把以下物品带给我。";
				mes .@count[0]+" ^3355FF"+getitemname(.@item[0])+"^000000";
				mes .@count[1]+" ^3355FF"+getitemname(.@item[1])+"^000000";
				mes .@count[2]+" ^3355FF"+getitemname(.@item[2])+"^000000";
				if (SAGE_Q == 3) mes .@count[3]+" ^3355FF"+getitemname(.@item[3])+"^000000";
				next;
				mes "[梅修斯·西尔菲]";
				mes "带齐这些物品，学费就会从 70,000 Zeny 降到 30,000 Zeny。";
				mes "祝你好运。";
				close;
			}
		}
		mes "[梅修斯·西尔菲]";
		mes "让我们完成申请表。";
		mes "请在这里签名。";
		next;
		select(strcharinfo(0));
		mes "[梅修斯·西尔菲]";
		switch (.@SAGE_Q_T) {
		case 1: mes "你的名字是……" + strcharinfo(0) + "。真好听。"; break;
		case 2: mes "你的名字是……" + strcharinfo(0) + "。听起来很睿智。"; break;
		case 3: mes "你的名字是……" + strcharinfo(0) + "。真有趣。"; break;
		}
		next;
		mes "[梅修斯·西尔菲]";
		mes "啊，是的，一切都准备好了。";
		mes "接下来你要参加入学测试。";
		set SAGE_Q,4;
		if(checkquest(2043) != -1) {
			changequest 2043,2041;
		}
		else if(checkquest(2044) != -1) {
			changequest 2044,2041;
		}
		else if(checkquest(2045) != -1) {
			changequest 2045,2041;
		}
		else {
			setquest 2041;
		}
		next;
		mes "[梅修斯·西尔菲]";
		mes "请去拜访克莱托斯教授。";
		mes "他在左边的房间。";
		close;
	}
	else if (SAGE_Q == 4) {
		mes "嗯？你来这里做什么？现在应该去参加入学测试。";
		mes "请到左边的房间拜访克莱托斯教授。";
		close;
	}
	else if (SAGE_Q == 15) {
		mes "哦，你完成论文了吗？";
		mes "当然可以，把它交给凯隆院长。";
		next;
		mes "[梅修斯·西尔菲]";
		mes "只要努力，就能取得好成绩。";
		mes "祝你好运。";
		close;
	}
	else {
		mes "抱歉，现在不太方便交谈。";
		mes "请稍后再来。给你添麻烦了。";
		close;
	}
}

yuno_in03,105,177,5	script	Written Test Professor#s	754,{
	mes "[克莱托斯·维尔多]";
	if (BaseJob != Job_Mage) {
		if (BaseJob == Job_Sage) {
			mes "嗯？什么？你怎么又回来了？";
			mes "还想再进学校吗？";
			next;
			mes "[克莱托斯·维尔多]";
			mes "我明白你的感受。毕业后你已经成为贤者。贤者……直到生命尽头。";
			mes "所以要坚强独立，去探索无人涉足的地方吧。";
			next;
			mes "[克莱托斯·维尔多]";
			mes "别忘了记录你经历的一切。";
			mes "必须做好笔记，与他人分享你的知识。";
		}
		else if (BaseJob == Job_Novice) {
			mes "小鬼，你来这里做什么？";
			mes "这里是魔法学院，不是托儿所。";
			next;
			mes "[克莱托斯·维尔多]";
			mes "出去和波利玩吧。那才是你的工作。";
			mes "快出去，动作快点！！";
		}
		else if (Class == Job_Wizard) {
			mes "哎呀……看看是谁爬回来了。魔法成瘾者。";
			mes "好吧好吧，专心研究魔法也没那么糟。";
			next;
			mes "[克莱托斯·维尔多]";
			mes "但希望你记住，没有人能独自生活。";
			mes "即使你足够强大可以独自行动，也必须合作并帮助他人。这才是巫师应有的精神。";
		}
		else {
			mes "嗯……我明白你想进入这所著名学院，但既然你选择了其他职业，";
			mes "我认为你无法成为贤者。";
			next;
			mes "[克莱托斯·维尔多]";
			mes "所以别后悔选择贤者以外的职业。出去狩猎，提升当前职业等级吧。";
		}
		close;
	}
	if (SAGE_Q == 0) {
		mes "什么，你想成为贤者？";
		mes "从你渴求智慧的眼神就能看出来。";
		next;
		mes "[克莱托斯·维尔多]";
		mes "当然，想成为贤者必须先进入学院。";
		mes "申请入学后再来。";
		close;
	}
	else if (SAGE_Q == 1 || SAGE_Q == 2 || SAGE_Q == 3) {
		mes "哈！你连申请流程都没完成！？";
		mes "我明白了……是梅修斯告诉你什么了吗？";
		next;
		mes "[克莱托斯·维尔多]";
		mes "尽力而为，这会是很好的经验。";
		mes "完成申请后再来。";
		close;
	}
	else if (SAGE_Q == 4) {
		mes "欢迎来到施威彻尔比尔魔法学院。";
		mes "你已经申请这项测试了，对吧？";
		next;
		mes "[克莱托斯·维尔多]";
		mes "让我看看，你的名字是" + strcharinfo(0) + "……";
		mes "好，开始吧！";
		next;
		mes "[克莱托斯·维尔多]";
		mes "我要给你的测试会考查世界各类学术知识。";
		mes "共有 20 道题，每题 5 分，得到 80 分即可通过。";
		next;
		mes "[克莱托斯·维尔多]";
		mes "好，不必等待，现在就开始。";
		mes "哦，如果不立即回答，测试会被取消。";
L_AskQuestions:
		next;
		switch(rand(1,3)) {
		case 1:
			mes "1. 请选择普隆德拉礼品商人不出售的物品。";
			next;
			if (select("China:Red Frame:Bouquet:Glass Bead") == 3)
				set .@sage_t,.@sage_t+5;
			mes "2. 请选择无法购买短剑的城市。";
			next;
			if (select("Prontera:Morocc:Geffen:Lutie") == 1)
				set .@sage_t,.@sage_t+5;

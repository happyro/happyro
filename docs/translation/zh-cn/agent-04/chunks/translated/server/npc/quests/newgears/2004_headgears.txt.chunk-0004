// Decorative Golden Bell, Crown of Ancient Queen, Crown of Mistress
//============================================================
yuno_in03,20,18,6	script	Nehris#1	726,{
	disable_items;
	if (checkweight(1201,1) == 0) {
		mes "- 等一下！ -";
		mes "- 你当前携带 -";
		mes "- 的物品太多了。 -";
		mes "- 请先把一些物品 -";
		mes "- 存入卡普拉仓库后再试。 -";
		close;
	}
	mes "[Nehris]";
	mes "";
	mes "";
	mes "";
	mes "";
	mes "";
	mes "";
	mes "";
	next;
	mes "[Nehris]";
	mes "怪物通常佩戴的饰品现在也能让冒险者佩戴了！";
	next;
	mes "[Nehris]";
	mes "当然，由于还在试用期，我们目前只能提供 3 种怪物饰品。不过根据大家的反响，今后可能会增加更多。";
	next;
	mes "[Nehris]";
	mes "只要带来所需材料并支付少量费用，我们就会提供你选择的怪物饰品。";
	next;
	mes "[Nehris]";
	mes "请选择你感兴趣的";
	mes "饰品。";
	next;
	switch(select("装饰金铃:远古女王王冠:女王王冠")) {
	case 1:
		mes "[Nehris]";
		mes "这枚金铃仿照‘索希’怪物佩戴的铃铛制作。我个人很推荐这款可爱的女性饰品。虽然有点大，但相信你会很喜欢。";
		next;
		if (countitem(10016) > 0 && countitem(714) > 0 && countitem(969) > 2 && Zeny > 19999) {
			mes "[Nehris]";
			mes "谢谢你带齐了材料。";
			mes "请稍等片刻。";
			next;
			mes "^3355FF* Clang Clang! Scrape Scrape! Jingle Jingle! *^000000";
			next;
			delitem 10016,1; //Golden_Bell
			delitem 714,1; //Emperium
			delitem 969,3; //Gold
			set Zeny, Zeny-20000;
			getitem 5091,1; //Big_Golden_Bell
			mes "[Nehris]";
			mes "哟呼~";
			mes "给你，美丽的金铃。不过摇头时它可能不会叮当作响。";
			next;
			mes "[Nehris]";
			mes "哦，还有一件事，别把自己和索希搞混后自杀了！";
			next;
			mes "[Nehris]";
			mes "如果想再做一个，请再来找我。感谢参观怪物博物馆。";
			close;
		}
		mes "[Nehris]";
		mes "制作装饰金铃需要这些材料……";
		mes "^3355FF1 Golden Bell, 1 Emperium, 3 Gold^000000 and";
		mes "20,000 zeny.";
		next;
		mes "[Nehris]";
		mes "准备好后再来找我。";
		mes "谢谢。";
		close;
	case 2:
		mes "[Nehris]";
		mes "这顶王冠仿照‘伊希斯’怪物佩戴的王冠制作，优雅的外形很适合古代王室。";
		next;
		if (countitem(10006) > 0 && countitem(714) > 0 && countitem(969) > 2 && Zeny > 19999) {
			mes "[Nehris]";
			mes "谢谢你带齐了材料。";
			mes "请稍等片刻。";
			next;
			mes "^3355FF* Clang Clang! Scrape Scrape! Jingle Jingle! *^000000";
			next;
			delitem 10006,1; //Queen's_Hair_Ornament
			delitem 714,1; //Emperium
			delitem 969,3; //Gold
			set Zeny, Zeny-20000;
			getitem 5080,1; //Headgear_Of_Queen
			mes "[Nehris]";
			mes "锵锵！";
			mes "这是你的远古女王王冠！不知道戴着它能否让别人向你下跪，但至少看起来很优雅。";
			next;
			mes "[Nehris]";
			mes "如果想再做一个，请再来找我。感谢参观怪物博物馆。";
			close;
		}
		mes "[Nehris]";
		mes "制作远古女王王冠需要这些材料……";
		mes "^3355FF1 Queen's Hair Ornament, 1 Emperium, 3 Gold^000000 and";
		mes "20,000 zeny.";
		next;
		mes "[Nehris]";
		mes "准备好后再来找我。";
		mes "谢谢。";
		close;
	case 3:
		mes "[Nehris]";
		mes "这顶王冠仿照‘女王’怪物佩戴的王冠制作。戴上它会显得威严粗犷。";
		next;
		if (countitem(2249) > 0 && countitem(714) > 0 && countitem(969) > 2 && Zeny > 39999) {
			mes "[Nehris]";
			mes "谢谢你带齐了材料。";
			next;
			mes "[Nehris]";
			mes "^FF0000By the way, if you use an upgraded";
			mes "如果使用升级过的宝冠制作，";
			mes "制作出的王冠将不会保留升级状态。^000000";
			next;
			mes "[Nehris]";
			mes "^FF0000另外，制作女王王冠时，请确保物品栏中只有一顶王冠。任何损失我们概不负责。";
			next;
			mes "[Nehris]";
			mes "确定要制作女王王冠吗？";
			next;
			if (select("是:等等……！") == 1) {
				mes "[Nehris]";
				mes "请稍等片刻。";
				next;
				mes "^3355FF* Clang Clang! Scrape Scrape! Jingle Jingle! *^000000";
				next;
				delitem 2249,1; //Coronet
				delitem 714,1; //Emperium
				delitem 969,3; //Gold
				set Zeny, Zeny-40000;
				getitem 5081,1; //Mistress_Crown
				mes "[Nehris]";
				mes "耶！你得到了一顶漂亮的王冠！";
				next;
				mes "[Nehris]";
				mes "不知道戴着它是否人人都会服从命令，但至少你会感到美丽而尊贵。";
				next;
				mes "[Nehris]";
				mes "不如去和女王合影吧？如果她没忙着把你撕碎，那一定很有趣。";
				next;
				mes "[Nehris]";
				mes "如果想再做一个，请再来找我。感谢参观怪物博物馆。";
				close;
			}
			mes "[Nehris]";
			mes "没问题，不过一定要充分理解我们的注意事项，好吗？";
			close;
		}
		mes "[Nehris]";
		mes "制作女王王冠需要这些材料……";
		mes "^3355FF1 Coronet, 1 Emperium, 3 Gold^000000 and";
		mes "40,000 zeny.";
		next;
		mes "[Nehris]";
		mes "准备好后再来找我。";
		mes "谢谢。";
		close;
	}
}

// Alarm Mask
//============================================================
alde_alche,88,180,0	script	Muscle Man#Alarm Mask	748,{
	if (checkweight(1201,1) == 0) {
		mes "[Muscle Man]";
		mes "嗯……";
		mes "你携带的东西太多了，我没法给你任何东西。";
		next;
		mes "[Muscle Man]";
		mes "把一些东西存进卡普拉仓库、腾出空间后再来找我。";
		close;
	}
	mes "[Muscle Man]";
	mes "哦耶！";
	mes "有时连我都不敢相信这副身体里跳动着这么多性感的爱之肌肉~！我几乎快藏不住它们了……";
	next;
	mes "[Muscle Man]";
	mes "现在……";
	mes "是性感时间！";
	next;
	specialeffect EF_FLASHER;
	setnpcdisplay "Muscle Man#Alarm Mask", 1193;
	enablenpc " #Alarm Mask Man1";
	enablenpc " #Alarm Mask Man2";
	enablenpc " #Alarm Mask Man3";
	enablenpc " #Alarm Mask Man4";
	specialeffect EF_CLAYMORE,AREA," #Alarm Mask Man1";
	specialeffect EF_CLAYMORE,AREA," #Alarm Mask Man2";
	specialeffect EF_CLAYMORE,AREA," #Alarm Mask Man3";
	specialeffect EF_CLAYMORE,AREA," #Alarm Mask Man4";
	initnpctimer;
	if (countitem(1095) > 2999 && countitem(2288) > 0) {
		if (select("Give him items:Cancel") == 1) {
			mes "[Muscle Man]";
			mes "哦……终于！";
			mes "你带来了！";
			mes "太棒了，太棒了！";
			next;
			mes "[Muscle Man]";
			mes "好了……";
			mes "现在可以用这个尖叫先生面具和这些钟表指针继续测试了。";
			next;
			delitem 1095,3000; //Needle_Of_Alarm
			delitem 2288,1; //Mr_Scream
			getitem 5086,1; //Alarm_Mask
			mes "[Muscle Man]";
			mes "还有，这个是你的。完全属于你。";
			next;
			mes "[Muscle Man]";
			mes "那么……再见！";
			mes "如果找到更多尖叫先生面具和钟表指针，别忘了带给我！";
			close;
		}
		mes "[Muscle Man]";
		mes "嗯……？";
		mes "奇怪，我还以为你已经有那副尖叫先生面具和所有钟表指针了……";
		close;
	}

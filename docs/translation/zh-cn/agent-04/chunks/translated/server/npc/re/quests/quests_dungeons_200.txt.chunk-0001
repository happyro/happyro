//===== rAthena Script =======================================
//= New dungeons
//===== Description: =========================================
//= [Walkthrough Conversion]
//===== Changelog: ===========================================
//= 1.0 Added sp_rudus4 quests. [Capuche]
//= 1.1 Added nif_dun01 and nif_dun02 quests. [Capuche]
//= 1.2 Added amicitia1 and amicitia2 quests. [Capuche]
//============================================================

// sp_rudus4
pub_cat,94,43,5	script	Yulma#rudus4	4_F_ANYA,{
	if (BaseLevel < 200) {
		mes "[Yulma]";
		mes "呃……你是谁？";
		mes "抱歉，我不擅长记住别人的脸！但我觉得你还不够资格询问我在这里的工作。";
		next;
		mes "- 这是等级 200 或以上可完成的任务 -";
		close;
	}
	switch( isbegin_quest(16521) ) {
	case 0:
		emotion ET_SMILE;
		mes "[Yulma]";
		mes "哦，" + strcharinfo(0) + ". 你是来喝酒的吗？";
		mes "我刚做完一笔交易，进展很顺利。";
		next;
		select( "这是做什么的？" );
		mes "[Yulma]";
		mes "你知道秘密之翼和反叛军一直在追踪幻影非法实验的痕迹，对吧？";
		next;
		mes "[Yulma]";
		mes "期间我找到了通往鲁杜斯 4 楼的路。";
		next;
		switch( select( "嗯，我知道。", "鲁杜斯在哪里？" ) ) {
		case 1:
			emotion ET_DELIGHT;
			mes "[Yulma]";
			mes "嘿嘿，能和" + strcharinfo(0) + "好好聊聊真不错。";
			break;
		case 2:
			emotion ET_SURPRISE;
			mes "[Yulma]";
			mes "什么，你忘了多少次了？";
			mes "那是幻影抛弃实验后失败产物的地方。";
			next;
			mes "[Yulma]";
			mes "记得 Morning 吗？那个小男孩住的地方。";
			mes "他在一楼，而鲁杜斯本身位于二楼和三楼。";
			break;
		}
		next;
		mes "[Yulma]";
		mes "顺便说一句，鲁杜斯 4 楼非常惊人……";
		mes "不知为何，鲁杜斯里被遗弃的实验对象似乎只聚集了特别强大的个体。";
		next;
		mes "[Yulma]";
		mes "秘密之翼的研究员说，实验对象之间激烈竞争后，最强的个体似乎都在那里定居了。";
		next;
		mes "[Yulma]";
		mes "不过说真的，我也不知道情况有多复杂！";
		mes "看来秘密之翼的研究员需要研究那里的实体。";
		next;
		mes "[Yulma]";
		mes "所以我在找人帮忙。";
		mes "准确地说，就是你，" + strcharinfo(0) + "!";
		next;
		mes "[Yulma]";
		mes "需要工作吗？我什么都知道~";
		mes "如果你有兴趣，就去鲁杜斯三楼。";
		next;
		mes "[Yulma]";
		mes "<NAVI>[Pion]<INFO>sp_rudus3,380,42,0,101,0</INFO></NAVI> 负责控制通往 4 楼的路线。";
		mes "去告诉他是我派你来的，看看是否值得来！";
		setquest 16521;
		close2;
		navigateto("sp_rudus3",380,42);
		end;
	case 1:
		mes "[Yulma]";
		mes "需要工作吗？我什么都知道~";
		mes "如果你有想法，就去鲁杜斯 3 楼。";
		next;
		mes "[Yulma]";
		mes "<NAVI>[Pion]<INFO>sp_rudus3,380,42,0,101,0</INFO></NAVI> 负责控制通往 4 楼的路线。";
		mes "去告诉他是我派你来的，看看是否值得来！";
		close;
	case 2:
		break;
	}
	if (isbegin_quest(16522) == 1) {
		mes "[Yulma]";
		mes "哦，你去了鲁杜斯四楼。感觉怎么样？";
		mes "Pian 还好吗？那些实验对象值得一战吗？";
		next;
		mes "[Yulma]";
		mes "那么帮我研究秘密之翼的人。";
		mes "我正在寻找猎杀它们的人，因为我自己没能力捕捉并研究魔物。";
		next;
		select( "询问是否可以直接狩猎" );
		emotion ET_KEK;
		mes "[Yulma]";
		mes "哦，我差点忘了。";
		mes "如果把这枚芯片附在身体某处并狩猎它们，研究员就能收到数据。";
		next;
		mes "[Yulma]";
		mes "新材料，环保、无毒且安全，不用担心。";
		mes "你想把它挂在哪里？";
		next;
		select( "耳垂", "后颈", "手背", "额头" );
		mes "[Yulma]";
		mes "好，我会贴好，不会妨碍你。";
		mes "好，那就这样……";
		completequest 16522;
		next;
	}
	mes "[Yulma]";
	mes "今天也请好好照顾我！";
	mes "那么，今天你想帮忙进行哪项研究？";
	next;
	switch( select("深渊孤独", "变形与进化", "数据备份", "不帮忙" ) ) {
	case 1:
		switch( checkquest(16523,PLAYTIME) ) {
		case -1:
			break;
		case 0:
		case 1:
			mes "[Yulma]";
			mes "秘密之翼的研究员正在休息。";
		mes "那么，" + strcharinfo(0) + "，稍微休息一下再回来怎么样？";
			next;
			mes "[Yulma]";
			mes "鲁杜斯四楼不是能轻松进出的地方。";
			mes "好好休息，准备充分后再工作！";
			close;
		case 2:
			erasequest 16523;
			break;
		}
		switch( checkquest(16524,HUNTING) ) {
		case -1:
			mes "[Yulma]";
			mes "只有强者生存、欺凌弱者的地方……";
			mes "就像深邃黑暗的孤独深渊。";
			next;
			emotion ET_SWEAT;
			mes "[Yulma]";
			mes "这个嘛，我也不清楚！";
			mes "我的工作是传达研究员的委托。";
			next;
			mes "[Yulma]";
			mes "研究员想知道鲁杜斯的实验对象与四楼其他实体有何不同。";
			next;
			emotion ET_PROFUSELY_SWAT;
			mes "[Yulma]";
			mes "它们在多大程度上失去了原形，以及实验后是否发生了变化。";
		mes "<FONT SIZE = 9>嗯……这些研究员看起来也有点危险？在我这种人看来，研究员大概都这样吧。</FONT>";
			next;
			mes "[Yulma]";
			mes "总之，你要收集 <FONT COLOR = 0000CD>Dolorian、Plagarion 和 Deadre</FONT> 的数据。";
			mes "每种狩猎 10 只怎么样？";
			next;
			if (select( "I'll come hunting", "I refuse" ) == 2) {
				mes "[Yulma]";
			mes "我们已经是同舟共济的伙伴了吧～？";
				mes "不是这样吗，伙伴？再想想！";
				close;
			}
			mes "[Yulma]";
			mes "好，去狩猎吧，数据会在狩猎中收集。";
			mes "我的津贴也会增加！";
			setquest 16524;
			close;
		case 0:
		case 1:
			mes "[Yulma]";
			mes "秘密之翼的研究员想收集 <FONT COLOR = 0000CD>Dolorian、Plagarion 和 Deadre</FONT> 的数据。";
			mes "每种狩猎 10 只怎么样？";
			close;
		case 2:
			mes "[Yulma]";
			mes "今天的狩猎似乎很成功！";
			mes "你怎么知道，" + strcharinfo(0) + "，我放在你身上的芯片今天起作用了。";
			next;
			emotion ET_DELIGHT;
			mes "[Yulma]";
			mes "我每次都能看到，但芯片每次运作都很神奇。";
			mes "好了，我该为你今天的工作付报酬了。";
			next;
			mes "[Yulma]";
			mes "给你！";
			mes "既然工作完成了，好好休息。明天也请照顾我～";
			erasequest 16524;
			setquest 16523;
			getexp 15915940,11141160;	// TODO: the amount has been changed with the monster update
			close;
		}
		end;
	case 2:
		switch( checkquest(16525,PLAYTIME) ) {
		case -1:
			break;
		case 0:
		case 1:
			mes "[Yulma]";
			mes "秘密之翼的研究员已经下班了。";
		mes "那么，" + strcharinfo(0) + "，稍微休息一下再回来怎么样？";
			next;
			mes "[Yulma]";
			mes "鲁杜斯四楼不是能轻松进出的地方。";
			mes "你也好好休息，准备充分后再工作！";
			close;
		case 2:
			erasequest 16525;
			break;
		}
		switch( checkquest(16526,HUNTING) ) {
		case -1:
			mes "[Yulma]";
			mes "四楼的 Giant Caput 和 Venedi 与其他楼层的实体差异很大，";
			mes "变得巨大，或携带更多毒液……";
			next;
			emotion ET_PROFUSELY_SWAT;
			mes "[Yulma]";
			mes "研究员似乎对这些家伙很感兴趣。";
			mes "所以我要你去狩猎它们。";
		mes "<FONT SIZE = 9>嗯……我们为什么不做呢？上层一定有什么复杂的东西。我也不知道。</FONT>";
			next;
			mes "[Yulma]";
			mes "你能分别狩猎 15 只 <FONT COLOR = 0000CD>Giant Caput 和 Venedi</FONT> 吗？";
			mes "数据会自动收集，你只要专心狩猎。";
			next;
			if (select( "I'll hunt them", "I refuse" ) == 2) {
				mes "[Yulma]";
			mes "我们已经是同舟共济的伙伴了吧～？";
				mes "不是这样吗，伙伴？再想想！";
				close;
			}
			mes "[Yulma]";
			mes "好，努力去狩猎吧！";
			mes "我的奖金取决于你的表现！";
			setquest 16526;
			close;
		case 0:
		case 1:
			mes "[Yulma]";
			mes "你能分别狩猎 15 只 <FONT COLOR = 0000CD>Giant Caput 和 Venedi</FONT> 吗？";
			mes "数据会自动收集，你只要专心狩猎。";
			close;
		case 2:
			mes "[Yulma]";
			mes "你还好吗？你平安从狩猎回来了。";
			mes "请告诉我研究员今天工作很努力。";
			next;
			mes "[Yulma]";
			mes "看来收集到了不错的数据。";
			mes "那么我该为你今天的工作支付报酬。";
			next;
			mes "[Yulma]";
			mes "给你！";
			mes "你今天辛苦了，好好休息后再回来。明天也努力工作吧！";
			erasequest 16526;
			setquest 16525;
			getexp 15176970,11001900;	// TODO: the amount has been changed with the monster update
			close;
		}
		end;
	case 3:
		switch( checkquest(16527,PLAYTIME) ) {
		case -1:
			break;
		case 0:
		case 1:
			mes "[Yulma]";
			mes "研究员说他现在退出了。芯片每天维护一次就够了！";
		mes "那么，" + strcharinfo(0) + "，稍微休息一下再回来怎么样？";
			next;
			mes "[Yulma]";
			mes "鲁杜斯四楼不是能轻松进出的地方。";
			mes "好好休息，准备充分后再工作！";
			close;
		case 2:
			erasequest 16527;
			break;
		}
		switch( isbegin_quest(16528) ) {
		case 0:
			mes "[Yulma]";
		mes "哦，顺便问一下，芯片贴得牢吗？";
		mes "它维持不了太长时间……";
			next;
			mes "[Yulma]";
			mes "而且我必须备份并格式化收集的数据，才能接收新数据，但我没有做这件事的才能……";
			next;
			mes "[Yulma]";
		mes "我来介绍一位目前在现场的研究员，你想直接过去吗？";
		mes "他可能乔装起来观察魔物，但我会告诉你位置，你去确认一下吧！";
			next;
			if (select( "寻找他", "不寻找他" ) == 2) {
				mes "[Yulma]";
				mes "只能和我一起工作，不觉得郁闷吗？";
			mes "去见见在现场工作的研究员也不错……";
				close;
			}
			mes "[Yulma]";
			mes "是啊！只能来找我领取工作，不觉得郁闷吗？";
			next;
			mes "[Yulma]";
		mes "我正要去见他，如果你有问题，可以直接问他！";
		mes "我听说 <NAVI>[研究员]<INFO>sp_rudus4,192,204,0,101,0</INFO></NAVI> 主要在鲁杜斯 4 楼中央附近活动。";
			setquest 16528;
			close;
		case 1:
			mes "[Yulma]";
		mes "我正要去见秘密之翼的研究员，如果你有问题，可以直接问他！";
		mes "我听说 <NAVI>[研究员]<INFO>sp_rudus4,192,204,0,101,0</INFO></NAVI> 主要在鲁杜斯 4 楼中央附近活动。";
			close;
		case 2:
			mes "[Yulma]";
			mes "你去过那里吗？聊过几句吗？";
		mes "那位研究员藏得好吗？";
			next;
			mes "[Yulma]";
		mes "据说他非常擅长躲藏，尽管并没有真正的隐藏技能。";
			mes "所以你才要去现场。";
			next;
			mes "[Yulma]";
			mes "因为这也是工作……我安全地替代了他，所以上级让我负责津贴。";
			next;
			mes "[Yulma]";
			mes "你也能回来找我真好！";
			mes "那么祝你今天愉快，明天见！";
			erasequest 16528;
			erasequest 16540;
			setquest 16527;
			getexp 15000000,11000000;
			close;
		}
		end;
	case 4:
		mes "[Yulma]";
	mes "嗯，你不来吗？";
	mes "我一直在热切地等着" + strcharinfo(0) + "！";
		close;
	}
	end;

OnInit:
	questinfo( QTYPE_QUEST2, QMARK_YELLOW, "checkquest(16524,HUNTING) == 2" );
	questinfo( QTYPE_QUEST2, QMARK_YELLOW, "checkquest(16526,HUNTING) == 2" );
	questinfo( QTYPE_QUEST2, QMARK_YELLOW, "isbegin_quest(16528) == 2" );

	questinfo( QTYPE_DAILYQUEST, QMARK_YELLOW, "checkquest(16523,PLAYTIME) == 2" );
	questinfo( QTYPE_DAILYQUEST, QMARK_YELLOW, "checkquest(16525,PLAYTIME) == 2" );
	questinfo( QTYPE_DAILYQUEST, QMARK_YELLOW, "checkquest(16527,PLAYTIME) == 2" );

	questinfo( QTYPE_DAILYQUEST, QMARK_YELLOW, "BaseLevel >= 200 && (checkquest(16524,HUNTING) == -1 && checkquest(16523,PLAYTIME) == -1)" );
	questinfo( QTYPE_DAILYQUEST, QMARK_YELLOW, "BaseLevel >= 200 && (checkquest(16526,HUNTING) == -1 && checkquest(16525,PLAYTIME) == -1)" );
	questinfo( QTYPE_DAILYQUEST, QMARK_YELLOW, "BaseLevel >= 200 && (isbegin_quest(16528) == 0 && checkquest(16527,PLAYTIME) == -1)" );
	end;
}

sp_rudus3,380,42,3	script	Pion#rudus4	4_M_REBELLION3,{
	switch( isbegin_quest(16521) ) {
	case 0:
		emotion ET_SLEEPY;
		mes "[Pion]";
		mes "呼……哇！";
		mes "先生，打扰了！不再工作了！";
		next;
		mes "[Pion]";
		mes "呼，哈欠……这段坡道下面是出入管制区。";
		mes "不允许人员进入。";
		next;
		select("I'm not an ordinary person." );
		mes "[Pion]";
		mes "嗯？啊……啊，不！" + strcharinfo(0) + "！";
		mes "那个……不过我不能擅自让你进去。";
		close;
	case 1:
		emotion ET_SLEEPY;
		mes "[Pion]";
		mes "呼……哇！";
		mes "打扰了！不再工作了！";
		next;
		mes "[Pion]";
		mes "糟糕……啊，这绝对不是口水";
	mes "那是闪耀着热情与努力光芒的汗水。";
		next;
		mes "[Pion]";
		mes "嗯，嗯嗯。这段坡道下面的入口现在受到限制……";
		mes "发生什么事了？";
		next;
		if (select( "我想去鲁杜斯四楼。", "指出工作态度。" ) == 2) {
			mes "[Pion]";
		mes "哦，你的工作态度有问题吗？";
		mes "喂，有些人可能会睡着的！！";
			next;
			mes "[Pion]";
		mes "我只是稍微睡了一会儿！";
			mes "真的吗！";
			close;
		}
		mes "[Pion]";
		mes "四楼？那里由我负责……";
	mes "啊，你是来见子弹喵的 Yulma 吗？";
		next;
		mes "[Pion]";
		mes "那你可以通过了。";
		mes "如果你想看看 4 楼的标本并帮助完成研究委托，就回去询问 <NAVI>[Yulma]<INFO>pub_cat,94,43,0,101,0</INFO></NAVI> 吧。";
		next;
		mes "[Pion]";
		mes "我会把你送到 4 楼。";
		close2;
		completequest 16521;
		setquest 16522;
		warp "sp_rudus4",370,156;
		end;
	case 2:
		break;
	}
	emotion ET_SLEEPY;
	mes "[Pion]";
	mes "呼……嗯！呃，打扰了！";
	mes "你确定要下到鲁杜斯四楼吗？";
	next;
	if (select( "移动", "不移动" ) == 2) {
		mes "[Pion]";
	mes "我明白了。哈啊……";
		close;
	}
	mes "[Pion]";
	mes "我来送你过去。保重！";
	close2;
	warp "sp_rudus4",370,156;
	end;

OnInit:
	questinfo( QTYPE_DAILYQUEST, QMARK_YELLOW, "isbegin_quest(16521) == 1" );
	end;
}

sp_rudus4,192,204,3	script	Secret Wing Researcher#rudu	4_SOIL,{
	mes "[Secret Wing Researcher]";
	mes "很好。现场工作。";
	mes "你必须观察许多魔物。";
	next;
	emotion ET_HUK;
	mes "[Secret Wing Researcher]";
	mes "……嗯！";
	mes "你怎么认出我的？";
	next;
	if (isbegin_quest(16528) == 1) {
		mes "[Secret Wing Researcher]";
	mes "哦，又见面了，" + strcharinfo(0) + "。";
	mes "我接到通知了。你是来更新芯片的吗？";
		next;
		mes "[Secret Wing Researcher]";
		mes "让我看看……拿些芯片吧。";
		mes "嗯……连接我的机器……数据为空……";
		next;
		emotion ET_BEST;
		mes "[Secret Wing Researcher]";
		mes "好了，就是这样！数据干净又漂亮。我再粘贴一次。";
		next;
		mes "[Secret Wing Researcher]";
		mes "因为这也是工作，回来时 <NAVI>[Yulma]<INFO>pub_cat,94,43,0,101,0</INFO></NAVI> 会给你一点津贴。";
	mes "我总是承蒙你的帮助。干得好！";
		completequest 16528;
		setquest 16540;
		close;
	}
	emotion ET_KEK;
	mes "[Secret Wing Researcher]";
	mes "邪恶！如果你假装知道，魔物就会出现！";
	mes "走开！";
	close;

OnInit:
	questinfo( QTYPE_DAILYQUEST, QMARK_YELLOW, "isbegin_quest(16528) == 1" );
	end;
}


// nif_dun
moc_para01,14,19,7	script	Old scholar#lv200	2_M_SAGE_OLD,{
	if (BaseLevel < 200) {
		mes "[Old scholar]";
	mes "我也想继续研究，但如果真的有生命危险……";
		next;
		mes "[Old scholar]";
	mes "我只能聘请强大又可靠的冒险者了。嗯……";
		next;
		mes "[Old scholar]";
	mes "我想 200 级应该就够了……说起来容易，但这种人可不是随便就能找到的。";
		close;
	}
	switch( isbegin_quest(8640) ) {
	case 0:
		if (isbegin_quest(8639) == 0) {

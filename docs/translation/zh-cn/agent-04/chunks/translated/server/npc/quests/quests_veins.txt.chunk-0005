			mes "其实是来自";
			mes "阿鲁纳佩尔茨的外交官。";
			mes "这些人非常";
			mes "重要！";
			close;
		}
		mes "[职员]";
		mes "我能帮你什么？";
		mes "哦，还要一杯";
		mes "饮料吗？给你！请享用";
		mes "晚宴～";
		close;
	}
	mes "[职员]";
	mes "哦，宴会后的清理";
	mes "是我工作中";
	mes "最大的一部分。很辛苦";
	mes "但必须完成。";
	close;
}


ayothaya,196,265,3	script	Einon#ayo	842,{
	if (tomyumgoong == 0) {
		mes "[艾农]";
		mes "你知道这个村子最受欢迎的";
		mes "料理是什么吗？";
		mes "";
		next;
		mes "[艾农]";
		mes "阿育他雅的地方料理闻名世界，";
		mes "";
		mes "在所有阿育他雅料理中，";
		mes "^3131FF冬阴功^000000 最棒。";
		next;
		mes "[艾农]";
		mes "冬阴功是一种";
		mes "非常辣的汤。尝一次会惊叹其深邃味道，尝两次会陶醉于诱人香气。";
		next;
		mes "[艾农]";
		mes "它是世界上最美味的食物之一！";
		mes "全世界的人都想";
		mes "一生至少尝一次。你想";
		mes "尝尝吗？";
		next;
		if (select("当然。:不用了，谢谢。我讨厌辣食。") == 1) {
			mes "[艾农]";
			mes "好……！";
			mes "那么谁最适合";
			mes "为你准备";
			mes "冬阴功呢？";
			mes "嗯……";
			next;
			mes "[艾农]";
			mes "村里每个人";
			mes "都会做，但我推荐你";
			mes "去拜访";
			mes "^3131FF辣妹玛莉^000000。";
			next;
			emotion ET_BEST;
			set tomyumgoong,1;
			setquest 8123;
			mes "[艾农]";
			mes "她是制作冬阴功";
			mes "最好的厨师！";
			mes "为什么不请她";
			mes "为你做一些？";
			close;
		}
		mes "[艾农]";
		mes "哦，我明白了……";
		mes "不过，改变主意时";
		mes "";
		mes "请回来。";
		close;
	} else if (tomyumgoong == 1) {
		mes "[艾农]";
		mes "啊，你想知道";
		mes "^3131FF辣妹玛莉^000000在哪里？";
		mes "厨师除了餐厅";
		mes "没什么地方可去，对吧？";
		mes "哈哈哈～";
		close;
	}
	mes "[艾农]";
	mes "金色阿育他雅……";
	mes "虽然我在这个村子长大，";
	mes "";
	mes "";
	mes "我仍觉得村子";
	mes "宏伟而美丽。";
	next;
	mes "[艾农]";
	mes "你觉得呢？";
	mes "你也同意吧？";
	close;
}

ayo_in01,145,163,3	script	Cook#ayo	839,{
	if (tomyumgoong < 2) {
		mes "";
		mes "";
		mes "";
		mes "";
		mes "";
		mes "";
		mes "";
	mes "你好！";
	mes "我叫辣妹玛莉。";
	mes "我的每道菜都以诱人香气和浓郁味道";
	mes "让顾客惊叹。";
		next;
		mes "[辣妹玛莉]";
	mes "我尤其为我的";
	mes "^3131FF冬阴功^000000，这是";
	mes "冬阴功感到骄傲，它是村里最好的。";
	mes "我想，烹饪最棒的冬阴功就是我的命运。";
		if (tomyumgoong == 0) {
			close;
		} else {
			next;
			mes "[辣妹玛莉]";
			mes "哦，我明白了……";
			mes "你想让我为你做";
			mes "冬阴功，对吧？";
			next;
			mes "[辣妹玛莉]";
			mes "说实话，开餐厅后我一直很忙。";
			mes "如果真想品尝我的冬阴功，能帮我做件事吗？";
			next;
			if (select("当然！:呃……不知道。") == 1) {
				mes "[辣妹玛莉]";
				mes "首先，能帮我取得制作冬阴功的材料吗？";
				mes "我需要 ^CE0000虾^000000、^CE0000辣椒^000000和 ^CE0000柠檬^000000。";
				next;
				mes "[辣妹玛莉]";
				mes "记住，虾是这道菜的主料。虾越新鲜，味道越好。";
				next;
				select("在哪里能找到？");
				mes "[辣妹玛莉]";
				mes "我就知道你会问。";
				mes "虾的话，去海边看看。";
				mes "那里应该有很多。";
				next;
				mes "[辣妹玛莉]";
				mes "不过你以前没找过，可能很难。";
				mes "直接从出售最新鲜虾的那个人那里买吧。";
				next;
				mes "[辣妹玛莉]";
				mes "嗯……";
				mes "提到我的名字，";
				mes "那个人也许会给你折扣。";
				set tomyumgoong,2;
				changequest 8123,8124;
				next;
				mes "[辣妹玛莉]";
				mes "他叫 ^3131FF通普^000000。";
				mes "他会在村子附近卖虾。去请他给你 20 只虾做冬阴功。";
				close;
			}
			mes "[辣妹玛莉]";
			mes "我知道这可能很难，但如果真想尝到最好的冬阴功，值得一试。";
			close;
		}
	} else if (tomyumgoong > 1 && tomyumgoong < 4) {
		if (tomyumgoong == 2 && countitem(567) > 19) {
			mes "[辣妹玛莉]";
			mes "呃……";
			mes "这些虾怎么了？";
			mes "它们全都有划痕和破损！真不敢相信 Thongpool 会把这么差的虾卖给";
			mes "顾客！";
			next;
			mes "[辣妹玛莉]";
			mes "真的很抱歉，";
			mes "但我不能用这些虾";
			mes "烹饪出最好的";
			mes "冬阴功。";
			next;
			mes "[辣妹玛莉]";
			mes "我知道这很麻烦，但你能回去找 Thongpool，";
			mes "让他给你最新鲜的虾，好让我烹饪最好的";
			mes "冬阴功吗？";
			close;
		} else if (tomyumgoong == 3) {
			if (countitem(567) > 19) {
				mes "[辣妹玛莉]";
				mes "啊，你回来了！";
				mes "让我看看你";
				mes "带来了什么。嗯……";
				mes "这些是……";
				next;
				emotion ET_BEST;
				mes "[辣妹玛莉]";
				mes "我一直在寻找的最新鲜的虾！";
				mes "做得好～";
				mes "有了这些又大又新鲜的虾，";
				mes "我就能为你做出最好的冬阴功了！太谢谢你了！";
				delitem 567,20; //Prawn
				next;
				mes "[辣妹玛莉]";
				mes "虾的天然鲜甜、柠檬的酸味，再加上一点鱼露，会成为完美的料理！";
				next;
				mes "[辣妹玛莉]";
				mes "哦……对了。";
				mes "但我们只有虾。";
				mes "现在，我要你带些";
				mes "^CE0000柠檬^000000来。";
				next;
				if (select("哪里能找到柠檬？:我讨厌酸食。还是放弃吧！") == 1) {
					set tomyumgoong,4;
					changequest 8124,8125;
					mes "[辣妹玛莉]";
					mes "几天前散步时，我看到了一棵很好的";
					mes "柠檬树。";
					mes "但这棵树属于一个普通人，他不是水果商。";
					next;
					mes "[辣妹玛莉]";
					mes "我不确定他会不会";
					mes "把柠檬卖给你，";
					mes "但你可以试试，";
					mes "我想应该可以。";
					close;
				}
				emotion ET_ANGER;
				mes "[辣妹玛莉]";
				mes "真是笨……！";
				mes "如果你只是因为讨厌酸味就放弃，那你一定没那么想吃我的冬阴功！";
				next;
				mes "[辣妹玛莉]";
				mes "等你尝过我的";
				mes "冬阴功，你就会";
				mes "后悔刚才说的话！";
				close;
			}
			mes "[辣妹玛莉]";
		mes "嗯……？";
		mes "你对虾做了什么？";
		mes "你该不会在路上";
		mes "把它们吃掉了吧？";
			close;
		}
		mes "[辣妹玛莉]";
	mes "记得请";
	mes "Thongpool 先生给你";
	mes "20 只虾。";
	mes "快去快回～";
		close;
	} else if (tomyumgoong > 3 && tomyumgoong < 6) {
		if (tomyumgoong == 4 && countitem(568) > 9) {
			mes "[辣妹玛莉]";
			mes "你觉得这些是";
			mes "品质最好的柠檬吗？";
			mes "仔细看看！";
			next;
			mes "[辣妹玛莉]";
			mes "这些柠檬的表皮";
			mes "毫无光泽，";
			mes "甚至闻起来也不新鲜！";
			mes "它们只是";
			mes "普通柠檬！";
			close;
		} else if (tomyumgoong == 5) {
			if (countitem(568) > 9) {
				emotion ET_SURPRISE;
				mes "[辣妹玛莉]";
				mes "欢迎回来！";
				mes "哇，你回来得";
				mes "真快！好，让我看看";
				mes "你带来的";
				mes "柠檬吧？";
				next;
				mes "[辣妹玛莉]";
				mes "哇，太棒了！";
				mes "这些柠檬真的很新鲜！";
				mes "你一个人是怎么带来这么多的？辛苦你了～";
				next;
				mes "[辣妹玛莉]";
				mes "现在，你应该去市场买些";
				mes "^CE0000辣椒^000000和其他";
				mes "材料。";
				next;
				mes "[辣妹玛莉]";
				mes "你和市场里的";
				mes "商人交谈时，";
				mes "他们会知道你需要什么。";
				mes "";
				next;
				if (select("好的，我马上回来。:啊，我现在累了。先休息一下吧……") == 1) {
					delitem 568,10; //Lemon
					set tomyumgoong,6;
					changequest 8125,8126;

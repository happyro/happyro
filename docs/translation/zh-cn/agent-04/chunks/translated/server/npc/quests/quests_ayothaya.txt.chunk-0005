					mes "一会儿见～";
					close;
				}
				mes "[辣妹玛莉]";
				mes "由你决定。";
				mes "但记住……";
				mes "虾可能会变质，";
				mes "如果你休息太久的话。";
				close;
			}
			mes "[辣妹玛莉]";
			mes "嗯……？";
			mes "你对柠檬做了什么？";
			mes "你该不会在路上";
			mes "把它们全吃了吧？";
			mes "";
			close;
		}
		mes "[辣妹玛莉]";
	mes "好吧……";
	mes "我就指望你";
	mes "从那棵树的主人那里";
	mes "拿到最好的柠檬了。";
		next;
		mes "[辣妹玛莉]";
	mes "无论如何，你得弄到那些";
	mes "高品质的柠檬，";
	mes "这样我才能做出";
	mes "冬阴功！";
		close;
	} else if (tomyumgoong == 6) {
		if (countitem(7286) > 29) {

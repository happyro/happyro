ecl_in02,96,22,3	script	sign#prison_inn	545,{
	mes "[北] 监狱";
	mes "[西] 诊所";
	close;
}

ecl_in01,8,71,5	script	Eclage Guard#pri_inn	447,{
	mes "[Eclage Guard]";
	mes "这条路会带您前往埃克拉珠下层，那里有监狱和诊所。";
	close;
}

ecl_in02,164,56,3	script	Receptionist#Laphine	835,{
	mes "[Receptionist]";
	mes "欢迎来到埃克拉珠诊所。";
	next;
	switch (select("保存地点:休息:结束对话")) {
	case 1:
		mes "[Receptionist]";
		mes "诊所已设为您的保存点。不过请多加小心～";
		savepoint "ecl_in02",162,50,1,1;
		close;
	case 2:
		mes "[Receptionist]";
		mes "在我们的诊所恢复身心吧。这里充满埃克拉珠的纯净能量。";
		mes "通常收费 1 枚斯普兰迪德硬币，但我们为旅行者提供特别折扣。总计 5,000 Zeny。";
		next;
		switch (select("使用斯普兰迪德硬币支付:使用 Zeny 支付:算了")) {
		case 1:
			if (!countitem(6081)) {
				mes "[Receptionist]";
				mes "您的硬币似乎不够。请再检查一下账户，好吗？";
				close;
			}
			mes "[Receptionist]";
			mes "请好好休息～";
			close2;
			delitem 6081,1; //6081
			percentheal 100,100;
			warp "ecl_in02",167,49;
			end;
		case 2:
			if (Zeny < 5000) {
				mes "[Receptionist]";
				mes "您的资源似乎不足，无法继续。请再检查一下账户，好吗？";
				close;
			}
			mes "[Receptionist]";
			mes "请好好休息～";
			close2;
			Zeny = Zeny - 5000;
			percentheal 100,100;
			warp "ecl_in02",167,49;
			end;
		case 3:
			close;
		}
	case 3:
		close;
	}
}

ecl_in02,135,45,5	script	Injured Laphine	442,{
	mes "[Injured Laphine]";
	mes "呜……";
	mes "我……这是……在哪里？";
	next;
	mes "[Doctor]";
	mes "您在诊所。别担心。";
	mes "我们已经止血并施放了紧急法术。";
	mes "您流了很多血，情况很危险。";
	next;
	mes "[Injured Laphine]";
	mes "......";
	mes "什么，不，我……我什么都感觉不到……这是怎么回事？";
	next;
	mes "[Doctor]";
	mes "嗯……那支箭严重损伤了您的翅膀……";
	next;
	mes "[Injured Laphine]";
	mes "……您是什么意思？";
	next;
	mes "[Doctor]";
	mes "这个……我本想等您康复后再说，但您应该知道。您再也不能装饰 Yai 了。";
	mes "换句话说，您的翅膀受伤了。那支箭穿过了翅膀最关键的部位。";
	next;
	mes "[Injured Laphine]";
	mes "什么？不可能……求您了……医生！！不要！！";
	close;
}
ecl_in02,137,44,3	duplicate(Injured Laphine)	Doctor Laphine#doctor	441

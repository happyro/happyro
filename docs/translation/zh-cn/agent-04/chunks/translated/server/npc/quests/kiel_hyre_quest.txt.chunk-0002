			mes ".........";
			mes "............";
			next;
		mes "[保安]";
		mes "好，一切没问题。莱科兰夫人正在等你。";
		mes "你可以进去了。";
		mes "";
		mes "";
			close2;
			warp "kh_school",71,155;

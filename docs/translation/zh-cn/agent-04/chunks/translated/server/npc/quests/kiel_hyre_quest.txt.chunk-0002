			mes "你最好确认是否弄错了……";
			mes "";
			mes "";
			mes "";
				close;
			}
		mes "[保安]";
		mes "好……你是来给莱科兰夫人送一瓶酒？";
		mes "我呼叫她确认一下。";
		mes "";
		mes "";
		mes "";
		mes "";
			next;

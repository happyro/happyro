				mes "让你做所有事情";
				mes "但请理解";
				mes "我也无能为力。别、别问我";
				mes "为什么，反正就是这样！";
				mes "";
				set KHToastGirlEnd,1;
				close;
			case 2:
				mes "[切祖]";
				mes "好吧好吧～";
				mes "欢迎再来！";
				close;
			}
		}
		else if (KHToastGirlEnd == 1) {
			mes "请前往";
			mes "莱茵哈特风车";
			mes "告诉他们切祖需要";
			mes "大量面粉和鸡蛋！";
			mes "然后尽快把东西";
			mes "带回来～";
			close;
		}
		else if (KHToastGirlEnd == 2) {
			mes "嘿，你带着";
			mes "材料回来了！非常感谢，";
			mes "我正需要这些！";
			mes "现在请把面粉";
			mes "和鸡蛋交给艾莉，";
			mes "代我向她问好。再见～";
			delitem 7488,1; //Delivery_Package
			getitem 7488,1; //Delivery_Package
			set KHToastGirlEnd,3;
			close;
		}
	}
	//KHToastGirlEnd no longer needed-- deleting.
	if (KielHyreQuest > 6) set KHToastGirlEnd,0;
	mes "热腾腾、新鲜、";
	mes "香脆的吐司！";
	mes "快来买吧！";
	close;
}

//----------------------------------------------------------------------------
// Lighthalzen WindMill Owner.
//----------------------------------------------------------------------------
lighthalzen,366,299,4	script	Windmill Owner#kh	46,{
	if (checkweight(7488,1) == 0) {
		mes "[米尔斯]";
		mes "嘿，你身上东西太多了。";
		mes "";
		mes "把杂物放进卡普拉仓库，";
		mes "否则别想让我给你";
		mes "东西。你来这里";
		mes "就是为了这个，对吧？";
		close;
	}
	if (KHToastGirlEnd < 1) {
		mes "[米尔斯]";
		mes "嘿，想要什么？";
		mes "我现在很忙，";
		mes "能晚点回来吗？";
		mes "到时再聊。";
		close;
	}
	else if (KHToastGirlEnd == 1) {
		mes "[米尔斯]";
		mes "嘿，想要什么？";
		mes "你来得正好，";
		mes "不过如果有事，";
		mes "快点说，";
		mes "趁我又忙起来前。";
		mes "趁我又忙起来前。";
		next;
		switch(select("我是来找切祖的:……")) {
		case 1:
			mes "[米尔斯]";
			mes "哦，是吐司摊的切祖？";
			mes "好，";
			mes "我把那孩子需要的东西";
			mes "都准备好了。";
			mes "里面有鸡蛋，";
			mes "要小心拿。";
			mes "已经准备好了……";
			next;
			mes "[米尔斯]";
			mes "那孩子是我的老主顾，";
			mes "所以你不用付钱，";
			mes "也不用替我";
			mes "跑额外差事。是的，";
			mes "我知道别人怎么对待";
			mes "你们冒险者。再见。";
			getitem 7488,1; //Delivery_Package
			set KHToastGirlEnd,2;
			close;
		case 2:
			mes "[米尔斯]";
			mes "......";
			mes "嗯，好吧，如果";
			mes "你需要什么，";
			mes "就喊我吧。";
			mes "克茨，克茨你在哪里？";
			mes "你最好别偷懒！";
			close;
		}
	}
	else if (KHToastGirlEnd >= 2) {
		mes "[米尔斯]";
		mes "那个克茨真是";
		mes "个懒鬼。他竟然以为";
		mes "上班时还能胡闹……";
		mes "";
		mes "不过他知道我找不到";
		mes "更好的助手。他会学会的……";
		close;
	}
}

lighthalzen,366,289,2	script	Windmill Owner's Helper	97,{
	if (KHToastGirlEnd < 1) {
		mes "[克茨]";
		mes "天啊，我们为什么";
		mes "总是这么忙？";
		mes "米尔斯为什么要";
		mes "把我累到骨头？";
		mes "唉，毕竟要谋生……";
		close;
	}
	else if (KHToastGirlEnd >= 2) {
		mes "[克茨]";
		mes "什、什么让你觉得我在偷懒，";
		mes "米尔斯？看、看，我的手在动，";
		mes "我很忙，我在工作！";
		mes "";
		mes "";
		close;
	}
	else {
		mes "[克茨]";
		mes "嘿，你来自切祖的吐司摊，对吧？";
		mes "可爱的切祖最近怎么样？";
		mes "";
		mes "";
		close;
	}
}


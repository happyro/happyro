//-----------librarian----------------------------------------------------------
-	script	Librarian#2_	-1,{
	if ($God2 < $@god_check1) {
		mes "[图书管理员]";
		mes "你在这里做什么？";
		mes "别碰任何东西！";
		close;
	}
 	if ($God3 >= $@god_check2) {
		mes "[图书管理员]";
		mes "你在这里做什么？";
		mes "别碰任何东西！";
		close;
	}
 	if (god_brising > 24 && god_brising < 27) {
		mes "[图书管理员]";
		mes "呼呼……";
		mes "……呼呼……";
		mes "…………呼呼呼……";
		next;
		mes "^3355FF这位图书管理员睡得很熟。如果你想查看十字军人事记录，最好别把他叫醒。^000000";
		close;
	}
 	else if (god_brising == 10) {
		mes "[图书管理员]";
		mes "所有机密人事记录都存放在王立图书馆。";
		mes "不过，完整查阅需要授权。";
		next;
		mes "[图书管理员]";
		mes "你说你要找一个人？";
		mes "请告诉我那个人的名字，";
		mes "以及你们的关系。";
		next;
		switch(select("洛温，兄弟姐妹:洛温，配偶:洛温，敌人:洛温，朋友")) {
		case 1:
			if (Sex == SEX_MALE) {
				mes "[图书管理员]";
				mes "你竟敢欺骗王立图书管理员！";
				next;
				mes "[图书管理员]";
				mes "记录上写着，洛温没有任何男性兄弟！";
				next;
				mes "[图书管理员]";
				mes "^333333（糟糕……！我刚才泄露了^666666机密^000000^333333信息！）^000000";
				next;
				mes "[图书管理员]";
				mes "王立图书馆不容忍身份欺诈！";
				mes "请离开！";
				close;
			}
			else {
				mes "[图书管理员]";
				mes "你和洛温小姐有亲属关系？之前怎么没收到她的消息？";
				next;
				mes "[图书管理员]";
				mes "我明白了……出生时就被分开，";
				mes "真是悲剧。好吧，让我查一下。";
				next;
				mes "[图书管理员]";
				mes "我很遗憾告诉你，根据记录，寻找洛温·埃伦已经太迟了。";
				next;
				mes "[图书管理员]";
				mes "据记载，她在吉芬地下城讨伐魔物的任务中失踪，后来被宣布死亡。";
				next;
				mes "[图书管理员]";
				mes "很抱歉，我知道的就这些。谢谢……";
				set god_brising,11;
				close;
			}
		case 2:
			if (Sex == SEX_MALE) {
				mes "[图书管理员]";
				mes "配偶……？";
				mes "嗯，我猜你看起来像丈夫。呵呵，我自己也有女朋友。至少我这么认为。总之……";
				next;
				mes "[图书管理员]";
				mes "洛温·埃伦，那个十字军，对吧？";
				mes "我很……抱歉。你可能需要坐下。";
				next;
				mes "[图书管理员]";
				mes "据说她在吉芬地下城讨伐魔物时失踪，后来被宣布死亡。";
				next;
				mes "[图书管理员]";
				mes "先生，我知道的就这些。";
				mes "我对你的损失深表遗憾。";
				set god_brising,11;
				close;
			}
			else {
				mes "[图书管理员]";
				mes "嗯……？配偶？";
				mes "还是^333333*咳咳*^000000同居伴侣？";
				next;
				mes "^3355FF图书管理员似乎心不在焉，";
				mes "仿佛沉浸在生动的白日梦中……^000000";
				close;
			}
		case 3:
			mes "["+ strcharinfo(0) +"]";
			mes "我在找埃伦。洛温·埃伦。";
			mes "我发誓要对付的宿敌。";
			next;
			mes "[图书管理员]";
			mes "宿敌……？呃，^666666*咳咳！*^000000";
			mes "我只能告诉你，确实有一位叫这个名字的十字军。";
			next;
			mes "[图书管理员]";
			mes "很抱歉，我不能再告诉你更多。";
			next;
			mes "[图书管理员]";
			mes "^333333*咳嗽*^000000";
			mes "^666666疯子！^000000";
			close;
		case 4:
			mes "[图书管理员]";
			mes "朋友……？我们有一个叫洛亨·菲利卡的人的记录。";
			next;
			mes "[图书管理员]";
			mes "他几年前从军队退役。我想给你他的地址，但我们没有这方面的信息。";
			set god_brising,12;
			close;
		}
	}
	else if (god_brising > 10 && god_brising < 13) {
		mes "[图书管理员]";
		mes "那么，我可以先失陪了吗？谢谢！";
		close;
	}
	else  {
		mes "[图书管理员]";
		mes "所有机密人事记录都存放在王立图书馆。完整查阅需要授权。";
		close;
	}

}

prontera,260,354,4	script	Woman#Rosa Ellenen	101,{
	if ($God2 < $@god_check1){ 
		mes "[女士]";
		mes "Hm?";
		mes "是什么风把你吹来了？";
		mes "只是来散步的话，似乎有点奇怪。";
		close;
	}
	if ($God3 >= $@god_check2) {
		mes "[女士]";
		mes "Hm?";
		mes "是什么风把你吹来了？";
		mes "只是来散步的话，似乎有点奇怪。";
		close;
	}
	if (god_brising > 33) {
		mes "[罗莎·埃伦]";
		mes "你就是之前来拜访我的人？";
		mes "啊，当然。";
		next;
		mes "[罗莎·埃伦]";
		mes "我不知道该怎么告诉你，但是……";
		mes "这里是洛温的墓。谢谢你。";
		close;
	}
	else if (god_brising == 21) {
		mes "[罗莎·埃伦]";
		mes "你在说什么？洛温的消息？";
		next;
		mes "[罗莎·埃伦]";
		mes "什么？！她为什么还没有升入天堂？";
		next;
		mes "[罗莎·埃伦]";
		mes "希望你记住我要告诉你的一切。";
		mes "她现在应该升入天堂！我还是无法理解……";
		next;
		mes "[罗莎·埃伦]";
		mes "请告诉那个只会祈祷的傻瓜，不要再浪费时间责怪自己。^333333*叹气*^000000";
		mes "我仍不知道她为什么选择和你说话。";
		next;
		mes "[罗莎·埃伦]";
		mes "告诉你吧，洛温是击剑天才。不过她总是难以坚持严格训练，也难以承受铠甲的重量……";
		next;
		mes "[罗莎·埃伦]";
		mes "但她热爱击剑，总是加倍努力锻炼体能，好在战场上侍奉神明。";
		next;
		mes "[罗莎·埃伦]";
		mes "最后，她成为了一名十字军。";
		mes "一切曾经很顺利，但她在前往吉芬地下城执行任务时突然失踪。";
		next;
		mes "[罗莎·埃伦]";
		mes "两年后，冒险者发现了她的遗体，她被埋在这座墓里。";
		mes "我还拿到了她留下的破碎铠甲和染血缎带。";
		next;
		mes "[罗莎·埃伦]";
		mes "我始终不知道究竟发生了什么。";
		mes "赫米特一直像对待亲姐姐一样跟随她。她死后，他变了。希望他不要伤害自己……";
		next;
		mes "[罗莎·埃伦]";
		mes "军队里似乎发生了可疑的事情，但他们甚至不愿和我谈。到底发生了什么？！";
		next;
		mes "[罗莎·埃伦]";
		mes "最后，我放弃寻找真相。毕竟，没有什么能让她回来……";
		next;
		mes "[罗莎·埃伦]";
		mes "请告诉她我很好，";
		mes "但我想知道她的灵魂为什么还没有升入天堂！也许……";
		next;
		mes "[罗莎·埃伦]";
		mes "十字军人事记录里也许有些什么，";
		mes "能够解释这一切？";
		set god_brising,25;
		close;
	}
 	else if ((god_brising) > 9 && (god_brising < 20)) {
		mes "[罗莎·埃伦]";
		mes "这是我妹妹的墓……";
		mes "她叫洛温。";
		next;
		mes "[罗莎·埃伦]";
		mes "你是洛温的朋友？嗯？";
		mes "圣所里的男人？那一定是赫米特。";
		next;
		mes "[罗莎·埃伦]";
		mes "洛温死时他受到了打击，但他不必为她的死责怪自己。";
		mes "我不想让他一直承受罪恶感。";
		next;
		mes "[罗莎·埃伦]";
		mes "总之，谢谢你来看望我的妹妹。";
		mes "知道她去世后仍有朋友，我很欣慰。";
		set god_brising,11;
		close;
	}
	else {
		mes "[罗莎·埃伦]";
		mes "哦，你好……";
		mes "你也是来向某人表达敬意的吗？";
		close;
	}

}


//===== rAthena Script =======================================
//= Umbala Guides
//===== By: ==================================================
//= Dizzy, Translated by Celest; L0ne_W0lf
//===== Current Version: =====================================
//= 1.5
//===== Compatible With: =====================================
//= rAthena Project
//===== Description: =========================================
//= [Official Conversion]
//= Guide for the City of Umbala
//===== Additional Comments: =================================
//= 1.1 Fixed location command format [Lupus]
//= 1.2 Optimized, updated common guide names [Lupus]
//= 1.4 Fitted the many lines into 1 or 2, and corrected some typos [erKURITA]
//= 1.5 Rescripted to official 10.3 standards. [L0ne_W0lf]
//= 1.6 Corrected activating ontouch. [L0ne_W0lf]
//============================================================

umbala,128,94,4	script	Adventurer#um	702,{
	mes "[Adventurer]";
	mes "这里真是个奇怪的地方……";
	mes "发展落后，而且";
	mes "有许多复杂曲折的道路……";
	next;
	mes "[Adventurer]";
	mes "不过，我已经在这里待了几个月，";
	mes "熟悉这个地区的地理和村庄里的";
	mes "各处景点。";
	mes "您可以询问我";
	mes "建筑物的位置。";
	mes "";
	next;
	switch(select("建筑物位置:移除小地图标记:退出")) {
	case 1:
		mes "[Adventurer]";
		mes "那么，您想查看哪一个？";
		next;
		switch(select("首领的房子:萨满的房子:武器店:工具店:蹦极地点:取消")) {
		case 1:
			mes "[Adventurer]";
			mes "我已在您的小地图上";
			mes "标记了 ^FF3355+^000000。";
			next;
			mes "[Adventurer]";
			mes "只有首领懂得外界的语言。";
			mes "所以您最好先去拜访他。";
			viewpoint 1,66,250,2,0xFF3355;
			break;
			case 2:
		mes "[Adventurer]";
			mes "我已在您的小地图上";
			mes "标记了 ^CE6300+^000000。";
			next;
			mes "[Adventurer]";
			mes "乌坦萨满拥有某种神秘力量……";
			mes "据说她能制作粗糙的附魔石，";
			mes "还能将纯净附魔石";
			mes "分解成粗糙的附魔石。";
			mes "";
			viewpoint 1,217,186,3,0xCE6300;
			break;
			case 3:
		mes "[Adventurer]";
			mes "我已在您的小地图上";
			mes "标记了 ^55FF33+^000000。";
			next;
			mes "[Adventurer]";
			mes "乌坦人通常装备精良，";
			mes "以准备应对敌人的攻击。";
			mes "显然，他们过去曾多次遭到外界袭击。";
			mes "";
			viewpoint 1,126,154,4,0x55FF33;
			break;
			case 4:
		mes "[Adventurer]";
			mes "我已在您的小地图上";
			mes "标记了 ^3355FF+^000000。";
			next;
			mes "[Adventurer]";
			mes "工具店里有许多旅行时有用的物品，";
			mes "不妨去逛逛吧？";
			viewpoint 1,136,127,5,0x3355FF;
			break;
			case 5:
		mes "[Adventurer]";
			mes "我已在您的小地图上";
			mes "标记了 ^00FF00+^000000。";
			next;
			mes "[Adventurer]";
			mes "乌姆巴拉有个独特的地点，叫";
			mes "‘蹦极地点’。";
			mes "如果您想测试自己的勇气，";
			mes "不妨亲自参加这个乌坦仪式？";
			mes "";
			mes "";
			viewpoint 1,139,198,6,0x00FF00;
			break;
			case 6:
		mes "[Adventurer]";
			mes "如果想移除小地图上的地点标记，";
			mes "请选择‘移除小地图标记’菜单。";
			mes "";
			}
		break;
		case 2:
	viewpoint 2,66,250,2,0xFF3355;
		viewpoint 2,217,186,3,0xCE6300;
		viewpoint 2,126,154,4,0x55FF33;
		viewpoint 2,136,127,5,0x3355FF;
		viewpoint 2,139,198,6,0x00FF00;
		mes "[Adventurer]";
		mes "我已移除您小地图上的所有标记。";
		mes "如果想标记建筑位置，";
		mes "欢迎再次向我询问。";
		break;
		case 3:
	mes "[Adventurer]";
		mes "亲自了解乌坦文化很有趣。请多保重。";
		break;
		}
	close;
	}
//

			mes "^3355FF你拉开窗户，";
			mes "它顺利打开了。";
			mes "这可能就是那些";
			mes "顽皮的家伙";
			mes "用来悄悄进入";
			mes "神殿的方法。^000000";
			close2;
			warp "que_rachel",62,82;
			end;
		}
		mes "^3355FF你认为偷偷进入";
		mes "某个地方是错误的。";
		mes "但如果不被发现呢？^000000";
		mes "";
		close;
	}
	else if ((ra_tem_q >= 3) && (ra_tem_q < 10)) {
		mes "^3355FF你要从这扇窗户";
		mes "进入神殿";
		mes "吗？^000000";
		next;
		if(select("进入:取消") == 1) {
			close2;
			warp "que_rachel",62,82;
			end;
		}
		mes "^3355FF使用这扇窗户可能是";
		mes "你进入这里的唯一方法。^000000";
		close;
	}
	end;
}


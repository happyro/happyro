que_rachel,169,18,0	script	Quest Temple Exit#ra_tem	45,2,2,{
	mes "^3355FF大门关着。^000000";
	next;
	switch(select("推门:检查大门:踢门:用武器砸门")) {
	case 1:
		mes "^3355FF你使出全力推门……";
		if (ra_tem_q == 9) {
			close2;
			set ra_tem_q,10;
			warp "ra_temple",119,175;
			end;
		}
		mes "但大门纹丝不动。^000000";
		break;
	case 2:
		mes "^3355FF大门上安装着奇怪的机械，";
		mes "还有一个插槽，看起来可以插入";
		mes "卡片或许可证。指示灯亮着，";
		mes "说明它应该还在运作。^000000";
		break;
	case 3:
		mes "^3355FF你愤怒地踢向大门……";
		if (ra_tem_q == 9) {
			close2;
			set ra_tem_q,10;
			warp "ra_temple",119,175;
			end;
		}
		mes "但无论你踢得多用力，";
		mes "大门就是不肯为你打开。";
		mes "哦，而且你的脚也很痛。^000000";
		break;
	case 4:
		mes "^3355FF等等！这不是好主意。";
		mes "你不能砸开神圣场所的大门，";
		mes "英雄可不擅长亵渎神圣。^000000";
		break;

	}
	close;
}

ra_temin,277,159,3	script	High Priest Zhed#rachel	932,{
	if ((ra_tem_q > 14) || (MISC_QUEST&8192)) set lost_boy,14;
	if (checkweight(908,200) == 0) {
		mes "^3355FF等一下！";
		mes "你现在携带的物品太多了。";
		mes "请使用卡普拉服务存放";
		mes "一部分物品后再回来。^000000";
		close;
	}
	if (lost_boy == 12) {
		cutin "ra_gman",2;
		mes "[主教泽德]";
		mes "不知为什么，我觉得你很眼熟。";
		mes "你是被允许来这里的吗？";
		mes "如果没有适当的授权，";
		mes "你应该离开这里。";
		next;
		select("我代表文森特而来");
		mes "[主教泽德]";
		mes "文森特派你来的？我明白了。";
		mes "你一定是在找我。";
		mes "我是主教泽德，听说你";
		mes "有一个包裹要交给我。";
		next;
		mes "[主教泽德]";
		mes "通常文森特不会信任陌生人";
		mes "来送这些包裹，但也许是因为";
		mes "某些特殊情况。总之，";
		mes "让我看看他送来了什么……";
		next;
		cutin "ra_gman2",2;
		mes "[主教泽德]";
		mes "嗯？这是什么？";
		mes "文森特还送来了一张纸条？";
		mes "我想这一定很重要。";
		mes "请给我一点时间读一下……";
		next;
		mes "[主教泽德]";
		mes "...............................";
		mes "……嗯。文森特。现在我明白了。";
		mes "原来他故意对珍妮和菲比冷淡，";
		mes "这样其他人就不会起疑……";
		next;
		cutin "ra_gman",2;
		mes "[主教泽德]";
		mes "不过，我认为他没必要做到这种程度，";
		mes "这可能有点过头了。";
		mes "不管怎样，冒险者，";
		mes "非常感谢你在这件事上的帮助。";
		next;
		mes "[主教泽德]";
		mes "但告诉我，你帮助文森特、冒险";
		mes "是因为获得了报酬吗？";
		mes "你只是被金钱驱使的吗？";
		next;
		select("其实……我只是好奇。");
		mes "[主教泽德]";
		mes "你只是为了满足好奇心才做这些？";
		mes "呵呵，真有意思。";
		mes "这也是勇敢冒险者应有的态度。";
		mes "我喜欢。可以告诉我你的名字吗？";
		next;
		select("告诉他你的名字。");
		mes "[主教泽德]";
		mes ""+strcharinfo(0)+"...";
		mes "是个好名字。很适合你。";
		mes "我一定会记住。再次感谢你";
		mes "冒着生命危险帮我取回物品。";
		next;
		mes "[主教泽德]";
		mes "我会祈祷芙蕾雅在旅途中";
		mes "指引并保护你。愿和平与你同在，";
		mes ""+strcharinfo(0)+"。";
		close2;
		cutin "",255;
		set lost_boy,13;
		completequest 8099;
		specialeffect2 EF_ABSORBSPIRITS;
		getexp (checkre(3))?90000:900000,0;
		end;
	}
	else if ((lost_boy == 13) && (ra_tem_q < 14)) {
		mes "[主教泽德]";
		mes "啊，"+strcharinfo(0)+"……";
		mes "谢谢你帮我取回物品。";
		mes "你真是一位有才华的冒险者。";
		mes "愿芙蕾雅保护你……";
	}
	else if ((lost_boy == 13) && (ra_tem_q == 14)) {
		cutin "ra_gman",2;
		mes "[主教泽德]";
		mes "啊，太好了，我正希望你";
		mes "迟早会来这里。";
		mes "我有件事想拜托你。";
		mes "我太忙了，而且我比起其他冒险者";
		mes "更信任你。";
		next;
		cutin "ra_gman2",2;
		mes "[主教泽德]";
		mes "不过在告诉你详情前，你必须知道";
		mes "这件事必须保密。也就是说，";
		mes "一旦我说明任务，你就必须";
		mes "接受我的请求。";
		next;
		if (select("让我考虑一下。:好的，没问题。") == 1) {
			mes "[主教泽德]";
			mes "我明白了。如果你改变主意，";
			mes "请回来告诉我。";
			mes "要找到真正能让我依靠的人";
			mes "来做这件事并不容易……";
			close2;
			cutin "",255;
			end;
		}
		cutin "ra_gman",2;
		mes "[主教泽德]";
		mes "啊，你愿意接受，我就放心了。";
		mes "别担心，这项任务并不复杂，";
		mes "也不需要你付出太多牺牲。";
		next;
		cutin "ra_gman2",2;
		mes "[主教泽德]";
		mes "你可能已经知道，";
		mes "我们的国家阿鲁纳佩尔兹崇拜芙蕾雅。";
		mes "实际上，政治、社会";
		mes "与宗教几乎没有界限。";
		next;
		cutin "ra_gman",2;
		mes "[主教泽德]";
		mes "我们的国教领袖，也就是教皇，";
		mes "是芙蕾雅的直接侍从，";
		mes "负责向我们传达她的消息。";
		mes "因此，她必须遵守非常严格的规范。";
		next;
		mes "[主教泽德]";
		mes "我们的教皇对外界很好奇，";
		mes "希望了解阿鲁纳佩尔兹以外的世界，";
		mes "但她很难获得这类知识。";
		next;
		mes "[主教泽德]";
		mes "首先，她不能离开拉赫尔，";
		mes "那里是芙蕾雅女神的灵魂居住之处。";
		mes "其次，为了维护圣洁，";
		mes "所有市民和神父都不得离开城市。";
		next;
		mes "[主教泽德]";
		mes "这些是不言明的规则，通常不会公开讨论，";
		mes "但所有人都遵守它们，以免受到污名化。";
		mes "坦白说，我觉得这有些可耻，";
		mes "但我们正在努力改变。";
		next;
		mes "[主教泽德]";
		mes "此外，我们的教皇必须保持";
		mes "超然虔诚的形象，";
		mes "所以她不适合公开询问外界事务。";
		mes "不过，这些知识对她会有帮助……";
		next;
		mes "[主教泽德]";
		mes "所以主教们决定请一位值得信赖的";
		mes "冒险者向教皇介绍外界。";
		mes "现在你明白我为什么要求你";
		mes "对这一切保密了。";
		next;
		mes "[主教泽德]";
		mes "你不需要透露什么惊天秘密。";
		mes "我想日常琐事就足以让她满意。";
		mes "只要让她能够想象你的故乡即可。";
		next;
		mes "[主教泽德]";
		mes "我个人认为，教皇若能听听你的故事，";
		mes "一定会觉得耳目一新。";
		mes "她总是代表我们这座荣耀城市的所有人";
		mes "向女神祈祷。";
		next;
		mes "[主教泽德]";
		mes "遗憾的是，我不能陪你去见教皇，";
		mes "但我会告诉你如何获得觐见机会。";
		mes "首先，你需要一份^FF0000主教推荐信^000000。";
		next;
		mes "[主教泽德]";
		mes "我会替你写好，所以不用担心。";
		mes "接下来，你需要收集^FF000040个冰心^000000，";
		mes "作为力量与纯洁的象征证明。";
		next;
		mes "[主教泽德]";
		mes "我写推荐信时，先告诉你收集完";
		mes "40个冰心后如何前往教皇办公室。";
		next;
		mes "[主教泽德]";
		mes "从神殿中央的礼拜堂向西走，";
		mes "进入由两名士兵守卫的门。";
		mes "向他们出示推荐信和冰心，";
		mes "他们就会让你通过。";
		next;
		mes "[主教泽德]";
		mes "啊，你来了。";

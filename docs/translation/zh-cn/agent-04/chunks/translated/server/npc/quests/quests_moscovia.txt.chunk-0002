			mes "巨浪汹涌。";
			mes "太阳落山后，潮汐";
			mes "不会变得容易……即使对";
			mes "老练水手也是如此。";
			next;
			mes "[伊万诺夫先生]";
			mes "记住，这艘船的糟糕状况";
			mes "也会影响";
			mes "试图穿过";
			mes "巨浪。";
			next;
			mes "[伊万诺夫先生]";
			mes "准备出发时告诉我";
			mes "我们可以检查潮汐。";
			changequest 18105,18106;
			close;
		}
		mes "[伊万诺夫先生]";
		mes "这些材料不足。";
		mes "也许你忘了其中一些？";
		next;
		mes "[伊万诺夫先生]";
		mes "所需材料：";
		mes "^0000FF奇异钢片 10 个、锈螺丝 10 个、柔性管 5 根、朱比利 10 个^000000。";
		close;
	} else if (mos_whale_edq == 4) {
		mes "[伊万诺夫先生]";
		mes "哦，你准备出发了吗？";
		mes "好，让我看看……";
		next;
		if ((gettime(DT_HOUR) >= 0 && gettime(DT_HOUR) < 3) || (gettime(DT_HOUR) >= 6 && gettime(DT_HOUR) < 9) || (gettime(DT_HOUR) >= 12 && gettime(DT_HOUR) < 15) || (gettime(DT_HOUR) >= 18 && gettime(DT_HOUR) < 21)) {
			// if (isbegin_quest(18106))
				// changequest 18106,18107;
			mes "[伊万诺夫先生]";
			mes "嗯，时间不坏。";
			mes "我们应该快点";
			mes "趁潮水较低。";
			mes "船已经准备好了";
			mes "就在附近的码头，我们可以";
			mes "马上出发。";
			close2;
			warp "mosk_ship",94,110;
			end;
		}
	} else if (mos_whale_edq < 15) {
		mes "[伊万诺夫先生]";
		mes "上次航行真艰难……";
		mes "不过，所有冒险";
		mes "都是这样的……";
		mes "哈哈哈！";
		next;
		mes "[伊万诺夫先生]";
		mes "如果你还想再次出发……告诉我，";
		mes "我们可以检查潮汐。";
		mes "我随时准备好。";
		next;
		mes "[伊万诺夫先生]";
		mes "你要出发吗？";
		next;
		if(select("我还没准备好。:出发吧。") == 1) {
			mes "[伊万诺夫先生]";
			mes "准备好出发时告诉我。";
			close;
		}
		if ((gettime(DT_HOUR) >= 0 && gettime(DT_HOUR) < 3) || (gettime(DT_HOUR) >= 6 && gettime(DT_HOUR) < 9) || (gettime(DT_HOUR) >= 12 && gettime(DT_HOUR) < 15) || (gettime(DT_HOUR) >= 18 && gettime(DT_HOUR) < 21)) {
			mos_whale_edq = 4;
			mes "[伊万诺夫先生]";
			mes "嗯，时间不坏。";
			mes "我们应该快点";
			mes "趁潮水较低。";
			mes "船已经准备好了";
			mes "就在附近的码头，我们可以";
			mes "马上出发。";
			close2;
			warp "mosk_ship",94,110;
			end;
		}
	} else if (mos_whale_edq == 15) {
		mes "[伊万诺夫先生]";
		mes "嘿……你还活着！";
		mes "你被海浪卷走时，";
		mes "我以为再也见不到你了！";
		next;
		mes "[伊万诺夫先生]";
		mes "不管怎样，你这段时间去了哪里？";
		next;
		select("说明整个故事。");
		mes "[伊万诺夫先生]";
		mes "哦……真是太奇妙了。";
		mes "我真没想到……";
		mes "那座岛真的存在……？";
		next;
		mes "[伊万诺夫先生]";
		mes "更奇妙的是……";
		mes "那座岛不是岛？！";
		mes "而是一条巨大的鲸鱼？？？";
		next;
		mes "[伊万诺夫先生]";
		mes "树木生长……水流";
		mes "沿着鲸鱼的背部流淌！！？";
		mes "真令人难以置信。";
		next;
		mes "[伊万诺夫先生]";
		mes "难以置信！";
		mes "这是我一生听过的";
		mes "最奇妙的事件！";
		next;
		mes "[伊万诺夫先生]";
		mes "而且，鲸鱼岛上竟然还有";
		mes "一位老人，这也让我很惊讶！";
		next;
		mes "[伊万诺夫先生]";
		mes "他一定是个意志坚强的人……";
		mes "拥有丰富经验和高度纪律性。";
		next;
		mes "[伊万诺夫先生]";
		mes "关于那座岛的故事已经讲到这里。";
		mes "为什么不把你的发现告诉亲爱的沙皇，";
		mes "请求援助去寻找鲸鱼岛呢？";
		mes "他一定会感兴趣。";
		mes "请尽快报告。";
		mes "这是重要发现。";
		next;
		mes "[伊万诺夫先生]";
		mes "亲爱的沙皇非常喜欢听到珍贵物品的故事，";
		mes "所以如果他听了你的故事，";
		mes "也许会给你奖励……";
		mes "你应该试试。";
		mes "这会是个好机会。";
		next;
		mes "[伊万诺夫先生]";
		mes "如果你打算回那座岛，";
		mes "我也想和你一起去！嗯？哈哈哈！";
		mos_whale_edq = 16;
		if (isbegin_quest(18111))
			changequest 18111,18112;
		close;
	} else if (mos_whale_edq < 18) {
		mes "[伊万诺夫先生]";
		mes "如果亲爱的沙皇听到这种故事，";
		mes "一定会觉得很开心。";
		next;
		mes "[伊万诺夫先生]";
		mes "他甚至可能会给你奖励……";
		close;
	} else if (mos_whale_edq == 18) {
		mes "[伊万诺夫先生]";
		mes "嗯。亲爱的沙皇要求";
		mes "鲸鱼岛的证据……？";
		next;
		mes "[伊万诺夫先生]";
		mes "这可能有点";
		mes "困难……";
		next;
		mes "[伊万诺夫先生]";
		mes "你能保证";
		mes "再次找到鲸鱼岛吗？";
		next;
		mes "[伊万诺夫先生]";
		mes "我想你不会放弃。";
		mes "我们再出发一次怎么样？";
		mes "我很乐意帮你";
		mes "寻找鲸鱼岛！";
		next;
		if(select("再次寻找鲸鱼岛。:放弃。") == 1) {
			mes "[伊万诺夫先生]";
			mes "就这么办！我就知道会这样。";
			mes "我知道你不是会放弃冒险的人！";
			next;
			mes "[伊万诺夫先生]";
			mes "再一次，让我们准备好船，在日落前起航！";
			mos_whale_edq = 19;
			if (isbegin_quest(18113))
				changequest 18113,18114;
			close;
		}
		mes "[伊万诺夫先生]";
		mes "我明白了……";
		mes "即使你喜欢冒险，";
		mes "也可能无法找到";
		mes "Whale Island again...";
		next;
		mes "[伊万诺夫先生]";
		mes "如果你改变主意，";
		mes "anytime, come tell me.";
		mes "坦白说，我很想看到你";
		mes "向亲爱的沙皇证明鲸鱼岛的存在。";
		mes "那一定很精彩。";
		close;
	} else if (mos_whale_edq == 19) {
		mes "[伊万诺夫先生]";
		mes "哦！你准备好出发了吗？";
		next;
		if(select("我还没准备好。:出发吧。") == 1) {
			mes "[伊万诺夫先生]";
			mes "准备好出发时告诉我。";
			close;
		}
		if ((gettime(DT_HOUR) >= 0 && gettime(DT_HOUR) < 3) || (gettime(DT_HOUR) >= 6 && gettime(DT_HOUR) < 9) || (gettime(DT_HOUR) >= 12 && gettime(DT_HOUR) < 15) || (gettime(DT_HOUR) >= 18 && gettime(DT_HOUR) < 21)) {
			mes "[伊万诺夫先生]";
			mes "嗯，时间不坏。";
			mes "我们应该快点";
			mes "趁潮水较低。";
			mes "船已经准备好了";
			mes "就在附近的码头，我们可以";
			mes "马上出发。";
			close2;
			// if (isbegin_quest(18114))
			//	changequest 18114,18115;
			warp "mosk_ship",94,110;
			end;
		}
	} else if (mos_whale_edq < 32) {
		mes "[伊万诺夫先生]";
		mes "真是令人惊讶！！";
		mes "你去了哪里？";
		mes "我还担心你";
		mes "永远消失了呢！";
		next;
		mes "[伊万诺夫先生]";
		mes "我不在乎……不管你去了哪里，";
		mes "能再次见到你真是太好了。";
		mes "欢迎回来。";
		mos_whale_edq = 19;
		// changequest 18113,18114;
		next;
		mes "[伊万诺夫先生]";
		mes "我猜你还想再次前往";
		mes "鲸鱼岛……";
		next;
		if ((gettime(DT_HOUR) >= 0 && gettime(DT_HOUR) < 3) || (gettime(DT_HOUR) >= 6 && gettime(DT_HOUR) < 9) || (gettime(DT_HOUR) >= 12 && gettime(DT_HOUR) < 15) || (gettime(DT_HOUR) >= 18 && gettime(DT_HOUR) < 21)) {
			mes "[伊万诺夫先生]";
			mes "嗯，时间不坏。";
			mes "我们应该快点";
			mes "趁潮水较低。";
			mes "船已经准备好了";
			mes "就在附近的码头，我们可以";
			mes "马上出发。";
			close2;
			warp "mosk_ship",94,110;
			end;
		}
	} else if (mos_whale_edq == 32) {
		mes "[伊万诺夫先生]";
		mes "哦，你回来了！";
		mes "事情办得怎么样？";
		next;
		mes "[伊万诺夫先生]";
		mes "你是说……";
		mes "只要带来材料，那个老人就会";
		mes "制作乐器……";
		next;
		mes "[伊万诺夫先生]";
		mes "而且他答应在你再次回去之前";
		mes "不会移动那座岛……";
		mes "真是太好了。";
		next;
		mes "[伊万诺夫先生]";
		mes "我明白了。我记得准确路线。";
		mes "准备好后我们马上出发。";
		mes "不要再耽搁。";
		mes "船已经等着了。";
		mos_whale_edq = 33;
		close;
	} else if (mos_whale_edq < 39) {
		mes "[伊万诺夫先生]";
		mes "哦。你收齐";
		mes "所需材料了吗？";
		next;
		mes "[伊万诺夫先生]";
		mes "如果收齐了，现在要出发吗？";
		next;
		if(select("还没有。:出发吧。") == 1) {
			mes "[伊万诺夫先生]";
			mes "我明白了。我会等着。";
			close;
		}
		mes "[伊万诺夫先生]";
		mes "好，出发吧！";
		close2;
		warp "mosk_fild01",93,94;
		end;
	} else if (mos_whale_edq < 41) {
		mes "[伊万诺夫先生]";
		mes "终于，一切顺利结束了。";
		mes "这样一来，我……不，是我们的冒险故事";
		mes "又增加了新的一页！";
		next;
		mes "[伊万诺夫先生]";
		mes "总有一天，我想再和你这样的人";
		mes "一起经历一次精彩的冒险！";
		mes "一定会有机会的。";
		close;
	} else if (mos_whale_edq == 41) {
		mes "[伊万诺夫先生]";
		mes "我听说你在皇宫用鲸鱼岛的乐器";
		mes "进行了精彩的演奏。";
		mes "嗯？你一定很有才华！";
		next;
		mes "[伊万诺夫先生]";
		mes "终于，一切顺利结束了。";
		mes "这样一来，我……不，是我们的冒险故事";
		mes "又增加了新的一页！";
		next;
		mes "[伊万诺夫先生]";
		mes "总有一天，我想再和你这样的人";
		mes "一起经历一次精彩的冒险！";
		mes "一定会有机会的。";
		close;
	} else if (mos_whale_edq > 90 && mos_whale_edq < 100) {
		mes "[伊万诺夫先生]";
		mes "怎么了？";
		mes "你现在要乘船吗？快准备出发吧。";
		mos_whale_edq = 4;
		close;
	} else if (mos_whale_edq > 200 && mos_whale_edq < 300) {
		mes "[伊万诺夫先生]";
		mes "怎么了？";
		mes "你现在要乘船吗？快准备出发吧。";
		mos_whale_edq = 19;
		close;
	}
	mes "[伊万诺夫先生]";
		mes "天啊，潮水太高了。";
		mes "现在出发太危险，";
		mes "海浪变得";
		mes "太猛烈了。";
	next;
	mes "[伊万诺夫先生]";
		mes "等海面平静一些后再回来。";
		mes "现在还不能出发。";
		mes "请耐心等待。";
	close;
}

//----------------------------------------------------------------------------
// Mr. Ibanoff - Ship
//----------------------------------------------------------------------------
mosk_ship,98,110,3	script	Mr. Ibanoff#npc2	4_M_RUSBALD,{
	if (mos_whale_edq == 4) {
		mes "[伊万诺夫先生]";
		mes "真是适合航行的天气！";
		mes "海风凉爽宜人。";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "你本不必陪我";
		mes "经历这次危险的航行……";
		next;
		mes "[伊万诺夫先生]";
		mes "像我这样的人，比你";
		mes "更了解大海！";
		mes "而且这艘船一生都是我的朋友！";
		mes "我不会抛弃朋友。";
		mes "你会吗？～";
		next;
		mes "[伊万诺夫先生]";
		mes "我会观察海面，";
		mes "告诉你该往哪里走。";
		next;
		mes "[伊万诺夫先生]";
		mes "你只要听从我的指示，";
		mes "调整船舵的方向。";
		next;
		mes "[伊万诺夫先生]";
		mes "首先，握住船舵向前，";
		mes "朝东方行驶。";
		mos_whale_edq = 5;
		if (isbegin_quest(18106))
			changequest 18106,18107;
		close;
	} else if (mos_whale_edq == 5) {
		mes "[伊万诺夫先生]";
		mes "握住船舵保持方向，";
		mes "向东方前进。";
		mes "不要偏离路线。";
		close;
	} else if (mos_whale_edq == 6 || mos_whale_edq == 21) {
		.@r = (mos_whale_edq == 21)?3:4;
		if (rand(1,.@r) == 3) {
			mes "[伊万诺夫先生]";
		mes "嗯，海流变了。";
		mes "调整船舵向前，转向北方，";
		mes "顺着海流前进。";
			mos_whale_edq++;
			close;
		}
		mes "[伊万诺夫先生]";
		mes "还没有……水流没有任何变化。";
		mes "暂时没有什么需要注意的……";
		next;
		mes "[伊万诺夫先生]";
		mes "我们最好暂时保持这个";
		mes "方向继续航行。";
		close;
	} else if ($@mos1_edq) {
		mes "[伊万诺夫先生]";
		mes "我们必须先击退那些";
		mes "怪物！";
		close;
	} else if (mos_whale_edq == 7 || mos_whale_edq == 22) {
		mes "[伊万诺夫先生]";
		mes "嘿！";
		mes "你没听见我说话吗？";
		mes "把船舵向前转向北方，";
		mes "顺着海流走！";
		close;
	}
	else if (mos_whale_edq == 8 || mos_whale_edq == 10) callsub S_D_1,3,91,92,93,94;
	else if (mos_whale_edq >= 91 && mos_whale_edq <= 94) callsub S_D_2,(mos_whale_edq-91);
	else if (mos_whale_edq == 11) {
		mes "[伊万诺夫先生]";
		mes "看……海的另一边！";
		mes "你看到有什么东西";
		mes "在神秘地移动吗？";
		next;
		mes "[伊万诺夫先生]";
		mes "嘿嘿……那是什么……";
		mes "嘿！你……";
		mes "绕着甲板仔细看看！快去！";
		mos_whale_edq = 12;
		if (isbegin_quest(18107))
			changequest 18107,18108;
		donpcevent "#findship::OnEnable";
		close;
	} else if (mos_whale_edq == 12) {
		mes "[伊万诺夫先生]";
		mes "你在做什么……？绕着甲板";
		mes "仔细看看！";
		mes "快去！";
		donpcevent "#findship::OnEnable";
		close;
	} else if (mos_whale_edq == 19) {
		mes "[伊万诺夫先生]";
		mes "这次希望能顺利找到";
		mes "那座鲸鱼岛，";
		mes "不要再出意外……";
		next;
		mes "[伊万诺夫先生]";
		mes "方法和之前一样。";
		next;
		mes "[伊万诺夫先生]";
		mes "我会观察海面，告诉你该往哪里走。";
		mes "请听从我的指示。";
		next;
		mes "[伊万诺夫先生]";
		mes "你只要听从我的指示，调整船舵方向。";
		mes "保持稳定。";
		next;
		mes "[伊万诺夫先生]";
		mes "首先握住船舵向前，";
		mes "朝东方行驶。";
		mos_whale_edq = 20;
		if (isbegin_quest(18114))
			changequest 18114,18115;
		close;
	} else if (mos_whale_edq == 20) {
		mes "[伊万诺夫先生]";
		mes "握住船舵保持方向，";
		mes "向东方前进。";
		mes "不要偏离路线。";
		close;
	}
	else if (mos_whale_edq == 23 || mos_whale_edq == 25) callsub S_D_1,5,241,242,243,244;
	//else if (mos_whale_edq == 241 || mos_whale_edq == 243 || mos_whale_edq == 244) callsub S_D_2,0;
	//else if (mos_whale_edq == 242) callsub S_D_2,1;
	else if (mos_whale_edq >= 241 && mos_whale_edq <= 244) callsub S_D_2, (mos_whale_edq -241);
	else if (mos_whale_edq == 26) {
		mes "[伊万诺夫先生]";
		mes "看那里！";
		mes "有一座移动的岛！";
		mes "我们成功了！";
		next;
		// if (isbegin_quest(18115))
			// changequest 18115,18116;
		mes "[伊万诺夫先生]";
		mes "哦……天啊……";
		mes "它真的在那里……";
		mes "一条鲸鱼！太不可思议了！";
		mes "这竟然是真的……";
		next;
		mes "[伊万诺夫先生]";
		mes "我觉得和你一起可以去任何地方！";
		mes "即使是看似不可能的地方！";
		mes "哈哈！你是带来好运的朋友。";
		mes "谢谢你。";
		next;
		mes "[伊万诺夫先生]";
		mes "好，既然你已经登上了岛，";
		mes "我也该回去了……";
		mes "感谢你的帮助。";
		mes "下次再一起航行吧。";
		mes "祝你在鲸鱼岛上一切顺利。";
		mes "记得安全返回。";
		mes "我会在码头等你。";
		mes "再见，朋友。";
		mes "愿海风与你同在。";
		next;
		mes "[伊万诺夫先生]";
	// 行数占位：保持与官方源文件物理行数一致

prontera,237,313,3	script	Nun#moc	79,3,3,{

	if(checkweight(7416,1) != 1)
	{
		mes "^3355FF等一下！";
		mes "你现在携带了";
		mes "太多东西。";
		mes "请使用卡普拉服务存放";
		mes "一些物品后再回来";
		mes "。^000000";
		close;
	}
	if(!(BaseLevel > 59))
	{
		mes "[修女]";
		mes "哦，你好~";
		mes "愿和平与你同在，";
		mes "冒险者。记住，无论人们多么不同，";
		mes "我们都因人性而团结。";
		mes "";
		mes "";
		close;
	}
	if(!(BaseClass == Job_Acolyte))
	{
		mes "[修女]";
		mes "啊，你好。能请你找认识的";
		mes "普隆德拉教堂成员来和我谈谈吗？";
		mes "服事、牧师、武僧……谁都可以。";
		mes "";
		mes "";
		mes "";
		next;
		mes "[修女]";
		mes "我有非常重要的事要告诉他们，";
		mes "但紧急情况下几乎不可能召集所有神职人员……";
		mes "";
		mes "";
		mes "";
		close;
	}
	if(!mao_request)
	{
		mes "[修女]";
		mes "哦，" + strcharinfo(0) + "！";
		mes "我们终于相遇一定是神的旨意。";
		mes "其实我有非常重要的事想请你帮忙。";
		mes "";
		mes "";
		mes "";
		next;
		mes "[修女]";
		mes "你可能听说最近有大量儿童失踪。";
		mes "";
		mes "";
		mes "";

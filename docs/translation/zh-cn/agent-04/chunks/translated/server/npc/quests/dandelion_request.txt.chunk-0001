izlude,103,106,3	script	Guildsman#1	48,3,3,{

	if(checkweight(7416,1) != 1)
	{
		mes "^3355FF等一下！";
		mes "你现在携带了";
		mes "太多东西。";
		mes "请使用卡普拉服务存放";
		mes "一些物品后再回来";
		mes "。^000000";
		close;
	}
	if(!(BaseLevel > 59) || !(BaseJob == Job_Novice || BaseJob == Job_Super_Novice || BaseClass == Job_Swordman))
	{
		mes "[公会成员]";
		mes "有传闻说";
		mes "关于";
		mes "失踪";
		mes "梦罗克地区的";
		mes "孩子。一些公会认为";
		mes "这其实是绑架。";
		next;
		mes "[公会成员]";
		mes "那些可怜的孩子……";
		mes "如果我能做点什么";
		mes "帮助他们，天哪，";
		mes "我会立刻去做。";
		close;
	}
	if(!mao_request)
	{
		if ((BaseJob == Job_Novice) || (BaseJob == Job_Super_Novice))
		{
			mes "[公会成员]";
			mes "不好意思？ "+strcharinfo(0)+"?";
			mes "你好，我一直在等";
			mes "你从我身边经过，已经";
			mes "很久了，你知道吗？";
			mes "初心者和超级初心者";
			mes "真难找……";
			next;
			mes "[公会成员]";
			mes "总之，我不知道你是否";
			mes "知道，最近梦罗克有很多孩子失踪。";
			mes "我们不确定，但认为这与刺客公会最近的任务有关。";
			next;
			mes "[公会成员]";
			mes "总之，这项任务的委托人需要所有帮助。";
			mes "我听说过你，认为你能在这种情况下帮上大忙。";
			mes "";
			mes "";
			mes "";
			mes "";
			next;
			mes "[公会成员]";
			mes "帮我一个忙，像往常一样做正确的事，好吗？";
			mes "这是推荐信，能帮助你开始任务。";
			mes "";
			mes "";
			mes "";
			mes "";
			set mao_request,1;
			getitem 7416,1;
			close;
		}
		else if((BaseJob == Job_Swordman) || (BaseJob == Job_Swordman_High))
		{
			mes "[公会成员]";
			mes "嘿，" + strcharinfo(0) + "！";
			mes "很好，我就知道你迟早会来。";
			mes "听着，我是剑士协会的代表。";
			mes "";
			mes "";
			mes "";
			next;
			mes "[公会成员]";
			mes "听着，发生了一件大事，";
			mes "这是剑士协会参与过的最重要事件。";
			mes "收拾行李，马上前往梦罗克！";
			mes "";
			mes "";
			next;
			mes "[" + strcharinfo(0) + "]";
			mes "一路去梦罗克……？";
			mes "为什么？发生了什么？";
			next;
			mes "[公会成员]";
			mes "我不知道全部细节，但刺客公会正在调查儿童失踪案，";
			mes "他们向我们和其他所有公会请求了帮助……";
			mes "";
			mes "";
			mes "";
			mes "";
			next;
			mes "[公会成员]";
			mes "盗贼、诗人、初心者、超级初心者、牧师……";
			mes "总之规模很大。你若要帮忙，就拿上这封推荐信……";
			mes "";
			mes "";
			mes "";
			set mao_request,1;
			getitem 7416,1;
			close;
		}
		else if((Class == Job_Knight) || (Class == Job_Lord_Knight))
		{
			mes "[公会成员]";
			mes "" + strcharinfo(0) +"...?";
			mes "我就知道你会出现。";
			mes "听着，普隆德拉骑士团有通知给你。";
			mes "";
			next;
			mes "[" + strcharinfo(0) + "]";
			mes "给我？听起来很奇怪，";
			mes "能请你读给我听吗？";
			mes "";
			next;
			mes "[公会成员]";
			mes "‘主题："+ strcharinfo(0) +"’";
			mes "作为普隆德拉骑士团团长，";
			mes "我正式请求你代表卢恩·米德加尔兹骑士，";
			mes "与刺客公会合作。’";
			mes "";
			mes "";
			next;
			mes "[公会成员]";
			mes "请以骑士身份协助刺客公会，";
			mes "执行从梦罗克救出失踪儿童的特殊任务。";
			mes "-- 赫尔曼队长’";
			mes "";
			mes "";
			next;
			mes "[公会成员]";
			mes "好了，内容就是这些。";
			mes "如果你打算执行命令，";
			mes "这封推荐信应该有用。为了那些孩子，希望你接受任务……";
			mes "";
			mes "";
			mes "";
			set mao_request,1;
			getitem 7416,1;
			close;
		}
		else if((Class == Job_Crusader) || (Class == Job_Paladin))
		{
			mes "[公会成员]";
			mes "打扰一下……？";
			mes ""+strcharinfo(0)+"……？";
			mes "抱歉打扰你，但我有一封十字军";
			mes "迈克尔·哈利格爵士发来的紧急信件……";
			mes "";
			mes "";
			next;
			mes "[" + strcharinfo(0) + "]";
			mes "他们通常不会发消息。";
			mes "看来他说的事情一定很重要。";
			mes "信上写了什么？";
			mes "";
			mes "";
			next;
			mes "[公会成员]";
			mes "让我看看……是关于儿童失踪案，";
			mes "刺客公会正在调查……啊！刺客公会请求十字军协助。";
			mes "看来他们推荐了你。";
			mes "";
			next;
			mes "[公会成员]";
			mes "看，这是你接受任务时我该交给你的推荐信。";
			mes "为了那些失踪的孩子，我真心希望你能接受。";
			mes "";
			mes "";
			mes "";
			set mao_request,1;
			getitem 7416,1;
			close;
		}
	}
	else if(mao_request == 1)
	{
		if ((BaseJob == Job_Novice) || (BaseJob == Job_Super_Novice))
		{
			mes "[公会成员]";
			mes "啊，我忘了告诉你任务详情该去哪里！";
			mes "让我想想……你应该去……啊，想起来了~";
			mes "";
			mes "";
			mes "";
			next;
			mes "[公会成员]";
			mes "去梦罗克绿洲西侧，";
			mes "你会找到一间很可疑的小屋。";
			mes "刺客公会的联络人在附近。";
			mes "";
			mes "";
			mes "";
			next;
			mes "[公会成员]";
			mes "只要留心观察，相信你一定能找到。";
			mes "";
			mes "总之，我知道的就是这些。";
			mes "你去调查一下吧。";
			close;
		}
		else if((BaseJob == Job_Swordman) || (BaseJob == Job_Swordman_High))
		{
			mes "[公会成员]";
			mes "对了，这项任务需要你在梦罗克绿洲西侧小屋附近，";
			mes "与刺客公会的联络人见面。留意他。";
			mes "";
			mes "";
			mes "";
			next;
			mes "[公会成员]";
			mes "我想你不会找不到他，";
			mes "即使盗贼和刺客都开始";
			mes "";
			mes "";
			mes "看起来都一样。你明白我的意思吧？";
			mes "";
			close;
		}
		else if((Class == Job_Knight) || (Class == Job_Lord_Knight) || (Class == Job_Crusader) || (Class == Job_Paladin))
		{
			mes "[公会成员]";
			mes "你打算接受任务吗？太好了！";
			mes "";
			mes "现在你要去梦罗克绿洲西侧小屋外，";
			mes "与刺客公会的联络人见面。";
			mes "";
			next;
			mes "[公会成员]";
			mes "我知道这些方向不太清楚，";
			mes "但据说这是只有刺客知道的绝密地点……";
			mes "";
			mes "";
			mes "";
			close;
		}
	}
	else if(((mao_request > 2) && (mao_request < 27)) || ((mao_request > 102) && (mao_request < 125)))
	{
		mes "[公会成员]";
		mes "看来你和刺客公会合作得很好。";
		mes "不过要小心，这项任务可能比表面复杂。";
		mes "";
		mes "";
		mes "";
		mes "";
		close;
	}
	else
	{
		mes "[公会成员]";
		mes "天气真好，不是吗？";
		mes "不过我希望很快发生些刺激的事。";
		mes "和平当然很好，但我偶尔也想让生活出现波澜。";
		mes "";
		mes "";
		mes "";
		close;
	}


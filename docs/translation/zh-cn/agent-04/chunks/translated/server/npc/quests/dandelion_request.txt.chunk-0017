		donpcevent "Dandelion#maogate1_2::OnEnter";
		end;
	}
}

que_job02,117,101,1	script	#maogate1_end	139,3,3,{

OnInit:
	disablenpc "#maogate1_end";
	end;

OnReset:
	killmonster "que_job02","#maogate1_end::OnMyMobDead";
	end;

OnStop:
	killmonster "que_job02","#maogate1_end::OnMyMobDead";
	stopnpctimer;
	end;

OnEnter:
	enablenpc "#maogate1_end";
	end;

OnTouch:
	donpcevent "#maogate1_setting::OnStop";
	mes "[" + strcharinfo(0) + "]";
	mes "嘿，这里发生";
	mes "什么事了？基德！琳？";
	mes "A-and who's that guy?";
	mes "难道是……";
	emotion ET_SURPRISE, playerattached();
	next;
	cutin "mocseal_kid01.bmp",0;
	mes "[Kidd]";
	mes ""+ strcharinfo(0) +"...";
	mes "退后，别靠近我！琳，你为什么";
	mes "要这样做！放弃你的任务，";
	mes "你根本不知道";
	mes "自己的委托人到底是谁！";
	next;
	cutin "mocseal_rin01.bmp",2;
	mes "[Lin]";
	mes "你在说什么，";
	mes "基德？我刚发现你效力的";
	mes "蒲公英组织一直在";
	mes "追捕摩尔先生……";
	emotion ET_KEK, getnpcid(0, "Lin#maogate1_1");
	next;
	cutin "mocseal_kid01.bmp",0;
	mes "[Kidd]";
	mes "没错，他们当然在追捕他。你的委托人，";
	mes "R. 摩尔先生，其实就是";
	mes "莱扬·摩尔——而他";
	mes "正计划复活撒旦梦罗克！";
	next;
	cutin "mocseal_rin01.bmp",2;
	mes "[Lin]";
	mes "什么？！怎么会这样？我和摩尔";
	mes "一起行动了好几天！如果是他";
	mes "绑架了孩子们，";
	mes "那到底是谁在挟持他们？";
	next;
	mes "[Lin]";
	mes "不，你应该把你知道的";
	mes "关于自己委托人——";
	mes "蒲公英组织的一切都告诉我……";
	emotion ET_SCRATCH, getnpcid(0, "R#maogate1");
	next;
	cutin "mocseal_rin01.bmp",255;
	cutin "mocseal_kid01.bmp",255;
	mes "[R. Moore]";
	mes "谢谢你的关心，琳。但真的……";
	mes "没必要。嘿嘿……";
	mes "我已经不必再担心蒲公英组织了。";
	next;
	mes "[R. Moore]";
	mes "做好准备，";
	mes "接受这场献祭……琳……";
	mes "你的血将被用来";
	mes "复活撒旦梦罗克！";
	donpcevent "R#maogate1::OnSpell";
	emotion ET_SURPRISE, getnpcid(0, "Kidd#maogate1_1");
	emotion ET_SURPRISE, playerattached();
	next;
	mes "[Kidd]";
	mes "小心！";
	donpcevent "Kidd#maogate1_1::OnInit";
	donpcevent "Lin#maogate1_1::OnInit";
	donpcevent "Kidd#maogate1_2::OnEnter";
	donpcevent "Lin#maogate1_2::OnEnter";
	donpcevent "#maogate1_end2::OnSpell";
	next;
	mes "[" + strcharinfo(0) + "]";
	mes "基德！琳！";
	next;
	mes "[Lin]";
	mes "Wh-why...?";
	mes "摩尔先生，你说过";
	mes "你要阻止撒旦梦罗克复活……";
	next;
	mes "[Kidd]";
	mes "你还看不出来吗……？";
	mes "他一直在撒谎！他";
	mes "把我们所有人都骗了！";
	next;
	mes "[R. Moore]";
	mes "所以……";














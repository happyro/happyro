que_job02,66,85,5	script	Dandelion Member#1_bt	880,{

	if(mao_request == 26 || mao_request == 27)
	{
		mes "[Dandelion Member]";
		mes "嘿……你还";
		mes "好吗？";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "谢谢……";
		mes "我想你刚刚";
		mes "救了我的命。发生";
		mes "什么事了？你是一个人吗？";
		next;
		mes "[Dandelion Member]";
		mes "花了些时间，但我";
		mes "尽可能召集了蒲公英的成员。";
		mes "看样子，撒旦梦罗克";
		mes "现在几乎已经被解封了……";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "等等……";
		mes "基德呢？";
		mes "他去哪儿了？";
		next;
		mes "[Dandelion Member]";
		mes "基德？他已经在我们";
		mes "所有人之前进去了。";
		mes "里面听起来相当危险……";
		next;
		mes "[Kidd's Voice]";
		mes "……我说了——！";
		mes "……那是……";
		mes "我应该——！";
		emotion ET_SURPRISE;
		next;
		mes "[Dandelion Member]";
		mes "是他，又是他。";
		mes "既然你醒了，";
		mes "我得做点什么。你留在这里";
		mes "恢复体力，我进去";
		mes "帮他……";
		close2;
		emotion ET_SURPRISE, playerattached();
		set mao_request,27;
		disablenpc "Dandelion Member#1_bt";
		end;
	}

OnInit:
	disablenpc "Dandelion Member#1_bt";
	end;

OnEnter:
	enablenpc "Dandelion Member#1_bt";
	end;
}


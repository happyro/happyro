yuno_in04,111,57,3	script	Library Part-Timer#garas	862,{
	if (barmunt_crow == 3) {
		mes "[图书馆兼职生]";
		mes "人们应该学会把取出的书放回去。";
		mes "书车里堆满书让我很烦恼，唉……";
		next;
		mes "[图书馆兼职生]";
		mes "……现在我能帮你什么？";
		next;
		mes "["+ strcharinfo(0) +"]";
		mes "我在找奥利弗·希尔珀特写的《命运之鸦》……阿嚏！";
		emotion ET_KEK, playerattached();
		specialeffect2 EF_VENOMDUST;
		next;
		mes "[图书馆兼职生]";
		mes "啊，我记得那本……它最常被留在书车里。";
		mes "请进入^3131FF右侧^000000的房间，在畅销书区就能找到。";
		next;
		mes "["+ strcharinfo(0) +"]";
		mes "谢谢。";
		close;
	}
	else if (barmunt_crow == 7) {
		mes "[图书馆兼职生]";
		mes "我能帮你什么？";
		next;
		mes "["+ strcharinfo(0) +"]";
		mes "是的，嗯……阿嚏！旧报纸文章在哪里？……阿嚏！";
		specialeffect2 EF_VENOMDUST;
		next;
		mes "[图书馆兼职生]";
		mes "在右侧房间的角落就能找到。";
		mes "它们大多很古老，拿取时请小心。";
		next;
		mes "["+ strcharinfo(0) +"]";
		mes "谢谢……阿嚏！";
		specialeffect2 EF_VENOMDUST;
		close;
	}
	else if (barmunt_crow == 11) {
		mes "[图书馆兼职生]";
		mes "人们应该学会把取出的书放回去。";
		mes "书车里堆满书让我很烦恼，唉……";
		next;
		mes "[图书馆兼职生]";
		mes "……我能帮你什么？";
		next;
		mes "["+ strcharinfo(0) +"]";
		mes "咳……我在找奥利弗·希尔珀特写的《命运之鸦》。";
		specialeffect2 EF_VENOMDUST;
		next;
		mes "[图书馆兼职生]";
		mes "啊，我记得那本……它最常被留在书车里。";
		mes "上^3131FF楼^000000后检查左侧书架。";
		next;
		mes "["+ strcharinfo(0) +"]";
		mes "谢谢。";
		next;
		mes "[图书馆兼职生]";
		mes "奥利弗·希尔珀特年纪轻轻就声名大噪。";
		mes "我读过好几遍他的《命运之痕》。那本书太精彩了，百读不厌。";
		next;
		mes "[图书馆兼职生]";
		mes "嗯……最令人印象深刻的场景是……呃……";
		next;
		mes "[图书馆兼职生]";
		mes "对了！英雄在燃烧的宅邸中走向末路时……^FF0000-- 哔 --^000000";
		specialeffect2 EF_BASH3D2;
		close2;
		warp "que_ba",264,186;
		end;
	}
	else if (barmunt_crow == 12) {
		mes "[图书馆兼职生]";
		mes "请问你还好吗？你刚才突然走神了。";
		mes "你的脸色有点苍白。";
		next;
		mes "[图书馆兼职生]";
		mes "不如进去休息一下？读读《命运之痕》什么的。";
		mes "书就在楼上左侧书架。";
		close;
	}
	end;
}


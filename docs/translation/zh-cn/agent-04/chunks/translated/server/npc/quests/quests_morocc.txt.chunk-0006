			mes "[图书馆管理员们]";
			mes "哈哈……但有个坏消息。";
			mes "这本书太受欢迎了，连作者所在的施瓦尔兹瓦德也找不到。";
			mes "我们试着弄到书，但已经太迟。下一版出版还要一段时间，不如先读别的书？";
			next;
			mes "[图书馆管理员们]";
			mes "如果你不忙又真的想读，我建议去朱诺图书馆。";
			mes "那里能找到施瓦尔兹瓦德出版的所有书，也许能找到那本。";
			next;
			mes "[图书馆管理员们]";
			mes "朱诺离这里很远，但为读到如此热门的书，应该值得。";
			next;
			mes "^660000虽然书不是给你的，但你相信让客户满意。现在去朱诺图书馆吧。^000000";
			set barmunt_crow,2;
			changequest 2063,2064;
			close;
		case 2:
			mes "[图书馆管理员们]";
			mes "每本书都讲述生命、智慧、幸福和感受的故事。";
			mes "看看四周！它们是人类的见证，每天都有新书加入。";
			close;
		}
	}
	else if (barmunt_crow == 2) {
		mes "[图书馆管理员们]";
		mes "^3131FF《命运之鸦》^000000 在我们拿到一本前就售罄了。卢恩-米德加尔特王国找不到这本书。";
		mes "如果你真的想读，去朱诺图书馆吧。";
		close;
	}
	else {
		mes "[图书馆管理员们]";
		mes "本馆的怪物图鉴收录王国所有怪物，并按地下城分类，方便读者查找。";
		mes "我们还有许多冒险者必备书籍。要看看吗？";
		next;
		mes "[图书馆管理员们]";
		mes "街对面的另一座图书馆也有怪物图鉴。";
		mes "有兴趣也可以去看看。";
		close;
	}
}

yuno,333,210,5	script	Library Master#garas	57,{
	if (barmunt_crow == 2) {
		mes "[狗]";
		mes "汪汪！";
		mes "嗷……汪汪！";
		next;
		mes "^660000一只狗在图书馆门前大声吠叫。^000000";
		next;
		mes "[图书馆馆长]";
		mes "你这该死的鸟！飞走，离开！";
		next;
		mes "^660000一个男人也在图书馆门前大喊。^000000";
		next;
		mes "["+ strcharinfo(0) +"]";
		mes "这里发生了什么？";
		next;
		mes "[图书馆馆长]";
		mes "没什么，只是一只巨大的乌鸦坐在屋顶上，已经叫了好几个小时。";
		mes "我正想把它赶走……不知为何感觉很不祥。";
		next;
		mes "[图书馆馆长]";
		mes "走！飞走，该死的鸟！离开！！";
		next;
		mes "^660000你抬头看到巨大的乌鸦坐在图书馆屋顶，仿佛那里是它的地盘。^000000";
		next;
		mes "[图书馆馆长]";
		mes "离开！天啊，它不肯走！";
		mes "我担心那只怪鸟会把客人吓跑！";
		next;
		mes "[图书馆馆长]";
		mes "嗯……算了。";
		mes "（捡起一颗石子）";
		mes "我说走开，蠢鸟！";
		next;
		mes "（嗖——）";
		next;
		mes "（砰！）";
		specialeffect EF_PIERCE;
		next;
		mes "（哗啦）";
		next;
		mes "^660000乌鸦被石子击中，迅速飞上空中。^000000";
		mes "^660000但它开始在屋顶上盘旋，看起来更加诡异。^000000";
		specialeffect EF_BAT;
		next;
		mes "[图书馆馆长]";
		mes "咕……你就不能离开吗？！";
		next;
		mes "^660000他开始对乌鸦大喊，但乌鸦毫不在意，反而飞得更高。";
		mes "最后他转过头，放弃赶走乌鸦。狗也停止了吠叫。^000000";
		next;
		mes "^660000你低头看到地上有几根乌鸦被石子击落的羽毛。^000000";
		next;
		mes "["+ strcharinfo(0) +"]";
		mes "哇，这羽毛真大。如此巨大的乌鸦需要大羽毛才能飞。";
		next;
		mes "[图书馆馆长]";
		mes "我年轻时听说鸟羽会引来奥丁仆从祝福主人，所以许多诗人用它们作书签。";
		next;
		mes "[图书馆馆长]";
		mes "我以前有根小羽毛。看来我成为图书馆馆长也很自然。哈哈哈！";
		next;
		mes "[图书馆馆长]";
		mes "你知道老话：“在图书馆工作三年就能背下《埃达》。”";
		mes "为什么不留一根羽毛？谁知道呢？也许会带来好运。";
		next;
		mes "["+ strcharinfo(0) +"]";
		mes "我想是吧。";
		next;
		mes "^660000你从地上捡起一根黑色大羽毛。";
		mes "看着闪亮羽毛让你感到幸福，仿佛获得了宝藏。^000000";
		next;
		mes "["+ strcharinfo(0) +"]";
		mes "……阿嚏！";
		specialeffect2 EF_VENOMDUST;
		next;
		mes "[图书馆馆长]";
		mes "愿神保佑你。哦，你感冒了吗？";
		mes "尤其是冒险者，更要好好照顾自己。";
		next;
		mes "^660000你感到寒冷，开始发抖。^000000";
		next;
		mes "[图书馆馆长]";
		mes "试试喝加蜂蜜的热杰勒比汤。我感冒时母亲总会煮给我。";
		mes "我保证你很快就会好起来。";
		next;
		mes "^660000他听起来很真诚，但这种汤似乎根本不会有效……^000000";
		emotion ET_THINK, playerattached();
		set barmunt_crow,3;
		close;
	}
	else {
		mes "[图书馆馆长]";
		mes "小心别感冒！";
		close;
	}
}


yuno_in04,100,3,0	script	#garas_path	139,1,1,{
OnTouch:
	if (barmunt_crow == 6) {
		mes "...................................";
		next;
		mes "...................................";
		mes "...................................";
		next;
		mes "...................................";
		mes "...................................";
		mes "...................................";
		next;
		mes "^660000你仍在图书馆内，却不知道这是梦境还是现实。^000000";
		next;
		mes "^660000你转头看向书架，发现了那个空书架。^000000";
		next;
		mes "["+ strcharinfo(0) +"]";
		mes "呼……我想我只是做了个梦……阿嚏！";
		specialeffect2 EF_VENOMDUST;
		next;
		mes "^660000那是无法描述的梦：施瓦尔茨瓦尔德某处燃烧的实验室。";
		mes "你努力思考，却无法理解梦境的含义。^000000";
		next;
		mes "^660000你再次小心地打开书，但什么也没发生。^000000";
		next;
		mes "<……在烟雾与混乱的尖叫尽头，有个看起来绝非人类的生物……>";
		next;
		mes "...................................";
		next;
		mes "<- 伊娃，你在做什么？快过来！-";
		mes "-我不能把他留在这里！-";
		mes "不顾坍塌的实验室天花板，伊娃走近试管，小心取出某物藏在外套下。>";
		next;
		mes "^660000...................................^000000";
		next;
		mes "^660000书中描述的正是你梦里见到的场景。^000000";
		next;
		mes "["+ strcharinfo(0) +"]";
		mes "似曾相识？我是在经历似曾相识吗？";
		next;
		mes "^660000当然那只是梦，但仍是非常神秘的经历。^000000";
		next;
		mes "...................................";
		next;
		mes "...................................";
		next;
		mes "‘^660000现在我想知道，这个场景是否描述了过去真实发生的事故。如果有那么大的火灾，我一定能在报纸上查到。";
		mes "……我只是出于好奇想知道……^000000’";
		set barmunt_crow,7;
		changequest 2064,2065;
		close;
	}
	else if (barmunt_crow == 7) {
		mes "["+ strcharinfo(0) +"]";
		mes "如果想看火灾新闻，应该去哪个区域？";
		close;
	}
	end;
}


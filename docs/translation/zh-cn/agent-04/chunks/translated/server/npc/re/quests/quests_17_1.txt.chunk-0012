		cutin "",255;
		mes "[Worker]";
		mes "我不能……首席研究员攻击了我们。";
		npctalk "他们为什么要这样做……","Worker#171_rvs_11",bc_self;
		next;
		mes "[Worker]";
		mes "这些东西都是我制造的，我从未质疑过……";
		next;
		mes "[Worker]";
		mes "为什么是我们……";
		npctalk "身边有这样的人……我现在很害怕……","Worker#171_rvs_13",bc_self;
		next;
		mes "[Worker]";
		mes "嘿，别这么说。";
		npctalk "你在说什么？","Worker#171_rvs_12",bc_self;
		next;
		mes "[Worker]";
		mes "你还信任研究员吗？你是这个意思吗？";
		npctalk "真的吗？","Worker#171_rvs_11",bc_self;
		next;
		mes "[Worker]";
		mes "不，不是那样，我只是无法相信。唉，我太累了……";
		next;
		cloakoffnpc "Aas#171_cor2",getcharid(0);
		cloakoffnpc "Kaya Tos#171_cor2",getcharid(0);
		cutin "ep171_as02",0;
		mes "[Aas]";
		mes "请留在这里，我去检查周围。";
		npctalk "请留在这里，我去检查周围。","Aas#171_cor2",bc_self;
		next;
		cutin "ep171_kaya01",2;
		mes "[Kaya]";
		mes "看看伤员的状况。";
		npctalk "看看伤员的状况。","Kaya Tos#171_cor2",bc_self;
		cloakonnpc "Aas#171_cor2",getcharid(0);
		cloakoffnpc "Aas#171_cor",getcharid(0);
		sleep2 1000;
		next;
		cutin "ep171_as02",0;
		mes "[Aas]";
		mes "好，请留在这里。";
		next;
		cutin "ep171_kaya01",2;
		mes "[Kaya]";
		mes "你知道她是谁吗？";
		next;
		cutin "",255;
		mes "[Worker]";
		mes "是的，她是高级研究员之一，名字是^0000CDElyumina。^000000";
		npctalk "院子里有一首好听的歌。","Worker#171_rvs_11",bc_self;
		next;
		cutin "ep16_tes01",2;
		mes "[Tes]";
		mes "直接来攻击真是愚蠢。他们在研究什么？";
		unittalk getcharid(3),strcharinfo(0) + "：我更愿意说双方的战斗人员都错了。";
		next;
		cutin "",255;
		mes "[Worker]";
		mes "因为我是实验室唯一的机械师。我除了自己的机器，什么都不在乎……";
		next;
		mes "[Worker]";
		mes "现在想想，她的眼睛不正常。她看起来像个疯子。";
		npctalk "是的。她以前也会奇怪地笑。","Worker#171_rvs_13",bc_self;
		next;
		mes "[Worker]";
		mes "你见过她的房间吗？我第一次看到时吓坏了。她很快关上了门，但我还是看到了。";
		npctalk "我也看到了一些迹象。","Worker#171_rvs_12",bc_self;
		next;
		cutin "ep171_kaya01",2;
		mes "[Kaya]";
		mes "你是说你目睹了非法实验？";
		next;
		cutin "",255;
		mes "[Worker]";
		mes "是的，也许吧。这些机器的动作很奇怪。嗯……";
		npctalk "你为什么现在才说？","Worker#171_rvs_14",bc_self;
		next;
		cutin "ep16_tes02",2;
		mes "[Tes]";
		mes "你现在相信我们说的话吗？";
		next;
		cutin "",255;
		mes "[Worker]";
		mes "是的，我相信你！现在我完全相信你！";
		npctalk "我们都相信你！","Worker#171_rvs_11",bc_self;
		next;
		mes "[Worker]";
		mes "如果不是副会长，我们还能相信谁！";
		npctalk "我同意！","Worker#171_rvs_13",bc_self;
		next;
		cutin "16lei_01",2;
		mes "[Lazy]";
			mes "很好。现在可以继续调查了。副会长，请把文件给我。";
		npctalk "什么调查？","Worker#171_rvs_12",bc_self;
		next;
		cutin "ep171_kaya01",2;
		mes "[Kaya]";
		mes "什么文件？";
		next;
		cutin "16lei_03",2;
		mes "[Lazy]";
			mes "失踪人员名单。我需要和这里的人核对一下。";
		npctalk "希望他们能一个接一个出来。","Lazy#sp_cor",bc_self;
		next;
		cutin "16lei_02",2;
		mes "[Lazy]";
			mes "请在这里排队。排成三列。轮到你时请告诉我全名。";
		npctalk "让我先来。我感觉自己快死了。","Worker#171_rvs_14",bc_self;
		next;
		cloakonnpc "Aas#171_cor",getcharid(0);
		cloakoffnpc "Aas#171_cor2",getcharid(0);
		sleep2 1000;
		cutin "ep171_as01",0;
		mes "[Aas]";
		mes "副会长，请等一下……我有事报告。";
		next;
		cutin "ep171_kaya01",2;
		mes "[Kaya]";
		mes "怎么了？";
		next;
		cutin "ep171_as01",0;
		mes "[Aas]";
		mes "这里不方便说，请到<NAVI>[这里]<INFO>sp_cor,135,147,0,101,0</INFO></NAVI>来。";
		sleep2 1000;
		cloakonnpc "Aas#171_cor2",getcharid(0);
		cloakoffnpc "Aas#171_cor",getcharid(0);
		completequest 17017;
		setquest 17018;
		close3;
	}
	if (isbegin_quest(17018) == 1) {
		cutin "ep16_tes01",2;
		mes "[Tes]";
		mes "你没看到 <NAVI>[Aas]<INFO>sp_cor,135,147,0,101,0</INFO></NAVI> 和副会长一起走吗？我担心伤员。";
		close3;
	}
	cutin "ep16_tes01",2;
	mes "[Tes]";
	mes "完成调查并收集这里的所有数据需要一些时间。";
	close3;

OnInit:
	questinfo QTYPE_QUEST,QMARK_YELLOW,"isbegin_quest(17017) == 1";
	end;
}

sp_cor,137,146,3	script	Kaya Tos#171_cor	4_EP17_KAYA,{
	if (isbegin_quest(11603) != 2) {
		cutin "ep171_kaya01",2;
		mes "[Kaya]";
		mes "这里非常危险。足够强大、能保护自己后再回来。";
		close3;
	}
	if (isbegin_quest(17018) == 0) {
		cutin "ep171_kaya01",2;
		mes "[Kaya]";
		mes "我真心希望能在这里找到所有失踪人员。";
		close3;
	}
	if (isbegin_quest(17018) == 1) {
		cutin "ep171_kaya01",2;
		mes "[Kaya]";
		mes "看起来 <NAVI>[Aas]<INFO>sp_cor,135,147,0,101,0</INFO></NAVI> 很担心伤员。我们去听听她想说什么。";
		close3;
	}
	if (isbegin_quest(17020) == 0) {
		cutin "ep171_kaya01",2;
		mes "[Kaya]";
		mes "冒险者，可以和你谈一会儿吗？";
		next;
		select("怎么了？");
		mes "[Kaya]";
		mes "你和其他人之前袭击过一间进行非法实验的实验室。";
		mes "你怎么看这间？";
		next;
		select("我觉得这间实验室也是。:我不知道");
		mes "[Kaya]";
		mes "我认为这间实验室也在进行非法实验。所以……能请你帮个忙吗？";
		next;
		mes "[Kaya]";
		mes "我认为这里就是^0000FF失踪人员被送来的实验室。^000000除了这个区域的人，可能还有其他我们现在看不到的人。";
		next;
		select("....");
		mes "[Kaya]";
		mes "我希望你^0000FF继续调查 Patrick Kaufmann 的案件。^000000";
		mes "如果他在这里工作，这里其他人可能知道他的事。";
		next;
		cutin "ep171_kaya02",2;
		mes "[Kaya]";
		mes "也许……这毕竟是我们找到 Patrick 的最后机会。";
		next;
		if (select("I'll look into it.:I have something else to do right now.") == 2) {
			cutin "ep171_kaya01",2;
			mes "[Kaya]";
			mes "没关系，你现在不必调查。还有其他紧急事务要处理。";
			next;
			mes "[Kaya]";
			mes "但有空时请想想 Kaufmann。";
			close3;
		}
		mes "[Kaya]";
		mes "谢谢。抱歉突然请你做这件事。";
		setquest 17020;
		close3;
	}
	if (isbegin_quest(17032) == 0) {
		cutin "ep171_kaya01",2;
		mes "[Kaya]";
		mes "我希望你继续调查 Patrick Kaufmann。";
		mes "如果他在这里工作，其他人可能知道相关情况。";
		close3;
	}
	if (isbegin_quest(17032) == 1) {
		cutin "ep171_kaya01",2;
		mes "[Kaya]";
		mes "哦，欢迎回来，冒险者。过来。Kaufmann，你找到他了吗？";
		next;
		select("我有……这只手环。");
		mes "[Kaya]";
		mes "那是……？那是什么？";
		delitem 25666,1;
		next;
		select("这是身份识别手环。");
		mes "[Kaya]";
		mes "这是 Kaufmann 的……？那里还有其他人吗？";
		next;
		cutin "",255;
		mes "- 我把你在鲁杜斯遇到的研究员以及实验的故事告诉了 Kaya。-";
		next;
		cutin "ep171_kaya01",2;
		mes "[Kaya]";
		mes "为什么研究员没有和你一起回来？";
		next;
		select("她不想回来……");
		mes "[Kaya]";
		mes "我明白了……";
		next;
		mes "[Kaya]";
		mes "好。之后我会派专家寻找尸体或遗骸。当然，你的服务必须得到适当报酬。";
		next;
		mes "[Kaya]";
		mes "如果你有时间，希望你能妥善处理这些实验。除了你……这位冒险者，没有人能完成它们。";
		next;
		cutin "ep171_kaya02",2;
		mes "[Kaya]";
		mes "抱歉一直让你做这些困难的任务。如果你能带来他们的手环，我会奖励你。";
		next;
		cutin "ep171_kaya01",2;
		mes "[Kaya]";
		mes "我会带着失踪人员名单回总部。我要把手环作为证据，并向他们的家人发放必要的补偿。";
		next;
		mes "[Kaya]";
		mes "今后的工作将通过这里的^0000FFAas^000000处理。我会把手环交给 Aas。";
		next;
		mes "[Kaya]";
		mes "谢谢你目前为止所做的一切。";
		completequest 17032;
		getexp 600000,600000;
		getitem 25723,20;
		close3;
	}
	cutin "ep171_kaya01",2;
	mes "[Kaya]";
	mes "我希望你继续调查 Patrick Kaufmann。";
	mes "如果他在这里工作，其他人可能知道相关情况。";
	close3;

OnInit:
	questinfo QTYPE_QUEST,QMARK_YELLOW,"isbegin_quest(17019) > 0 && isbegin_quest(17020) == 0";
	questinfo QTYPE_QUEST,QMARK_YELLOW,"isbegin_quest(17032) == 1";
	end;
}

sp_cor,125,140,5	script	Kaya Tos#171_cor2	4_EP17_KAYA,{
	if (isbegin_quest(17018) == 1) {

}

//= Identification Bracelet Daily
sp_cor,135,147,3	script	Aas#171_cor	4_EP17_AS,{
	if (isbegin_quest(11603) != 2) {
		cutin "ep171_as01",0;
		mes "[Aas]";
		mes "我们不知道敌人什么时候会袭击。能保护自己后再回来。";
		close3;
	}
	if (isbegin_quest(17018) == 0) {
		cutin "ep171_as02",2;
		mes "[Ashley]";
		mes "说实话，我完全不知道这里藏着这个地方。他们到底是怎么躲过周围人的注意的？";
		close3;
	}
	if (isbegin_quest(17018) == 1) {
		cutin "ep171_as01",0;
		mes "[Aas]";
		mes "这边。";
		next;
		cloakonnpc "Kaya Tos#171_cor2",getcharid(0);
		sleep2 200;
		cloakoffnpc "Kaya Tos#171_cor",getcharid(0);
		cutin "ep171_kaya01",2;
		mes "[Kaya]";
		mes "伤员的情况怎么样？";
		next;
		cutin "ep171_as01",0;
		mes "[Aas]";
		mes "他们正在接受认真检查，我们也在处理相关文书。";
		npctalk "文书？","Kaya Tos#171_cor",bc_self;
		next;
		mes "[Aas]";
		mes "开始治疗后，我们发现除了伤势外，他们还有一些^0000FF严重的健康问题^000000。";
		next;
		cutin "ep171_kaya01",2;
		mes "[Kaya]";
		mes "详细说说。";
		next;
		cutin "ep171_as01",0;
		mes "[Aas]";
		mes "他们搬运废料时似乎^0000FF中毒了^000000，而且因为没有安全设备，衣服被实验室使用的各种危险物质污染。";
		next;
		cutin "ep171_kaya01",2;
		mes "[Kaya]";
		mes "她连基本的安全规则都没遵守。有多少人中毒了？";
		next;
		cutin "ep171_as01",0;
		mes "[Aas]";
		mes "是的，只有正在那边休息的人……";
		next;
		cutin "",255;
		mes "[Worker]";
		mes "我……死了吗？";
		npctalk "我没有吃太多！","Worker#171_rvs_12",bc_self;
		next;
		cutin "ep171_as02",0;
		mes "[Aas]";
		mes "哦！报告地点的情况不太好！";
		next;
		cutin "",255;
		mes "[Worker]";
		mes "但是，我死了的话……我的家人怎么办……我的家人……";
		npctalk "我不想死。请给我带来希望。","Worker#171_rvs_14",bc_self;
		next;
		cutin "ep171_as03",0;
		mes "[Aas]";
		mes "别担心，你不会死。";
		next;
		cutin "",255;
		mes "[Worker]";
		mes "你不是说我们快死了吗？";
		next;
		cutin "ep171_as03",0;
		mes "[Aas]";
		mes "我说你们的身体不健康，但谁说你们要死了？";
		next;
		cutin "",255;
		mes "[Worker]";
		mes "我能休息吗？我不是应该回去工作吗？如果不工作，我的家人会挨饿。";
		 npctalk "不能工作就无法生活。","Worker#171_rvs_11",bc_self;
		next;
		mes "[Worker]";
		mes "嘿，那我呢！";
		next;
		mes "[Worker]";
		mes "我也生病了！睡一觉就能一天痊愈！";
		npctalk "拜托！别说了！","Worker#171_rvs_14",bc_self;
		next;
		cutin "ep171_as01",0;
		mes "[Aas]";
		mes "哦，关于这个。你需要专业治疗和护理。";
		next;
		cutin "",255;
		mes "[Worker]";
		mes "不，不能这样。我必须……我需要工作。";
		npctalk "我受伤了！","Worker#171_rvs_12",bc_self;
		next;
		cutin "ep171_as01",0;
		mes "[Aas]";
		mes "那你真的会死。我想你还不想死，对吧？";
		mes "继续工作就会死。你需要休息并接受专业治疗。";
		next;
		cutin "ep171_kaya01",2;
		mes "[Kaya]";
		mes "企业处于这种状态时，我无法继续担任副会长。";
		next;
		cutin "",255;
		mes "[Worker]";
		mes "你要直接抛弃我们吗？如果不是你，也会是别人！";
		npctalk "对不起，我们赢不了！","Worker#171_rvs_11",bc_self;
		next;
		cutin "ep171_kaya01",2;
		mes "[Kaya]";
		mes "我会处理这场灾难。我会尽力确保你们完全康复。";
		npctalk "我相信那是意外。","Worker#171_rvs_13",bc_self;
		next;
		cutin "",255;
		mes "[Worker]";
		mes "听到你们并非全是坏人，我很高兴。";
		npctalk "但其他工作人员怎么办？","Worker#171_rvs_14",bc_self;
		next;
		cutin "ep171_kaya01",2;
		mes "[Kaya]";
		mes "如果身体不健康，就应该先专心恢复。";
		next;
		cutin "",255;
		mes "[Worker]";
		mes "我的 Angela……我终于又能见到我的 Angela 了……";
		next;
		mes "[Worker]";
		mes "但是……我们怎么办？我们正在交往……";
		npctalk "那我呢，我太老了！","Worker#171_rvs_11",bc_self;
		next;
		mes "[Worker]";
		mes "不过我还是想继续工作。我们在哪里都能工作，对吧？如果总部还有位置……";
		next;
		cutin "ep171_kaya01",2;
		mes "[Kaya]";
		mes "我不知道总部是否还有工作。";
		mes "我会去确认一次。";
		next;
		cutin "",255;
		mes "[Worker]";
		mes "这里不是也有^0000FF很多工作^000000要做吗？还有废料……对吧？但我不认为枪手会在这里待超过一两天。";
		next;
		mes "[Worker]";
		mes "你知道，我们需要人砍树、做饭、打扫，还有谁来洗衣服？我觉得不可能。";
		npctalk "我想吃美味的米饭。","Worker#171_rvs_12",bc_self;
		next;
		mes "[Worker]";
		mes "什么？我们还有力气吃东西吗？";
		next;
		mes "[Worker]";
		mes "不可能……我们知道在哪里捕鱼、哪里有好蘑菇、哪里最适合上厕所……你们都不知道。";
		npctalk "我们都会死在这里。","Worker#171_rvs_13",bc_self;
		next;
		mes "[Worker]";
		mes "她说得对！没有人比我们更了解这里。";
		npctalk "我知道哪里有我喜欢的美味树莓……","Worker#171_rvs_11",bc_self;
		next;
		cutin "ep171_as01",0;
		mes "[Aas]";
		mes "我明白他们的意思。";
		next;
		cutin "ep171_kaya01",2;
		mes "[Kaya]";
		mes "嗯……我想我们需要让了解这里的人留下。好，我决定了。";
		mes "身体状况良好且愿意留下的人可以留在这里，我们仍会雇用他们。";
		next;
		cutin "",255;
		mes "[Worker]";
		mes "天啊……谢谢……";
		next;
		mes "[Worker]";
		mes "谢谢！谢谢！";
		npctalk "他是副会长，人脉很广。","Worker#171_rvs_11",bc_self;
		npctalk "谢谢你。","Worker#171_rvs_13",bc_self;
		npctalk "我们无以为报。","Worker#171_rvs_12",bc_self;
		npctalk "谢谢！谢谢！","Worker#171_rvs_14",bc_self;
		next;
		select("这些人也是受害者……");
		cutin "ep171_kaya01",2;
		mes "[Kaya]";
		mes "正如 Lazy 所说，我认为雷根贝勒利用了这些人的绝望。";
		next;
		cloakoffnpc "Search Team#171_cor",getcharid(0);
		cutin "",255;
		mes "[Search Team]";
		mes "我们需要冒险者的支援！";
		next;
		cutin "ep171_kaya01",2;
		mes "[Kaya]";
		mes "怎么了？伤员还好吗？";
		next;
		cutin "",255;
		mes "[Search Team]";
		mes "我们正在追踪袭击者，有人受伤了，现在^0000FF需要支援。^000000";
		next;
		cutin "ep171_kaya01",2;
		mes "[Kaya]";
		mes "袭击者？";
		next;
		cutin "",255;
		mes "[Search Team]";
		mes "那里设置了陷阱，我们有人因此受伤。";
		next;

#if PACKETVER_MAIN_NUM >= 20200916 || PACKETVER_RE_NUM >= 20200723 || PACKETVER_ZERO_NUM >= 20221024
DEFINE_PACKET_ID(ZC_PAR_4JOB_CHANGE, 0x0b25);

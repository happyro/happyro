    AegisName: Improve_Orb_T_MATK
    Name: T-MagicBoost
    Type: Card
    SubType: Enchant
    Script: |
      .@r = getrefine();
      bonus bMatk,50;
      if (.@r>=7) {
         .@c = 25;
         .@t = 3000;
         if (.@r>=8) {
             .@c = 35;
             .@t += 1000;
         }
         if (.@r>=9) {
             .@c = 50;
             .@t += 1000;
         }
         autobonus "{ bonus bMatk,100; }",.@c,.@t,BF_MAGIC;
      }

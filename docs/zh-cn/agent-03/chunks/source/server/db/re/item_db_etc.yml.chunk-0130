    Script: |
      .@r = getrefine();
      bonus bInt,2;
      if (.@r>=7) {
         bonus bInt,1;
         if (.@r>=9) {
             bonus bInt,1;
             if (.@r>=11) {
                 bonus bInt,2;
                 bonus2 bMagicAtkEle,Ele_All,3;
             }
         }
      }

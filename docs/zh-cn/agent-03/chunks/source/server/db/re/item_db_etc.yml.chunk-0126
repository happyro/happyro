         bonus bPAtk,.@param;
         if (.@g >= ENCHANTGRADE_C) {
            bonus bShortAtkRate,.@param;
            bonus bPAtk,.@param;
            if (.@g >= ENCHANTGRADE_B) {
               bonus bShortAtkRate,.@param;
               bonus bPAtk,2*.@param;
               if (.@g >= ENCHANTGRADE_A) {
                  bonus bShortAtkRate,2*.@param;
                  bonus bPAtk,2*.@param;
               }
            }
         }
      }

				mes "So...";
				mes "How about this..?";
				next;
				mes "[Bartender]";
				mes "Why don't you try";
				mes "a '^0000FFKiss of Fire";
				mes "the Spinbird Kick^000000?'";
				next;
				mes "[Bartender]";
				mes "Don't be fooled by its sweet scent or beautiful red color. This is one of the strongest drinks around.";
				next;

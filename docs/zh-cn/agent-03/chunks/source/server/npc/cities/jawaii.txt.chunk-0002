				mes "a ^0000FF'Special J&Z'^000000 for you.";
				mes "And this is on me.";
				next;
				mes "["+strcharinfo(0)+"]";
				mes "Thank you...";
				mes "So much...";
				close2;
				percentheal -100,0;
				end;
			}
			if (Zeny > 99) set Zeny, Zeny-100;
			switch(rand(4)) {
			case 1:
				mes "[Bartender]";
				mes "Hmm...";
				mes "How about this cocktail?";
				next;
				mes "[Bartender]";
				mes "I recommend";

// Keep the Renewal tutorial channels, then merge players into the shared world.

int_land01,49,57,0	script	#happyro_intro_to_izlude_a	WARPNPC,2,2,{
	end;
OnTouch:
	if (isbegin_quest(21008) == 1) {
		mes "^4d4dffOnce you leave this island there is no way back.";
		mes "Are you sure you want to go directly to Izlude?^000000";
		next;
		mes "^4d4dffIf you do, the quest will be deleted from your Quest Log.^000000";
		next;
		if (select("Do not go to Izlude yet", "Sail to Izlude!") == 1) {
			mes "[Sailor]";
			mes "You want to stay here longer?";
			mes "Good, then I'll wait until you're ready~";
			close;
		}
		completequest 21008;
	}
	mes "[Sailor]";
	mes "Let's head towards Izlude!";
	close2;
	if (isbegin_quest(21001) == 1)
		completequest 21001;
	warp "izlude",196,209;
	savepoint "izlude",128,142,1,1;
	end;
}
int_land02,49,57,0	duplicate(#happyro_intro_to_izlude_a)	#happyro_intro_to_izlude_b	WARPNPC,2,2
int_land03,49,57,0	duplicate(#happyro_intro_to_izlude_a)	#happyro_intro_to_izlude_c	WARPNPC,2,2
int_land04,49,57,0	duplicate(#happyro_intro_to_izlude_a)	#happyro_intro_to_izlude_d	WARPNPC,2,2

izlude_a,20,98,0	warp	happyro_iz001_a	3,3,prt_fild08,367,212
izlude_b,20,98,0	warp	happyro_iz001_b	3,3,prt_fild08,367,212
izlude_c,20,98,0	warp	happyro_iz001_c	3,3,prt_fild08,367,212
izlude_d,20,98,0	warp	happyro_iz001_d	3,3,prt_fild08,367,212

-	script	HappyRONoviceMerge	-1,{
OnInit:
	disablenpc "#intro_to_izlude_a";
	disablenpc "#intro_to_izlude_b";
	disablenpc "#intro_to_izlude_c";
	disablenpc "#intro_to_izlude_d";
	disablenpc "iz001_a";
	disablenpc "iz001_b";
	disablenpc "iz001_c";
	disablenpc "iz001_d";
	end;
}

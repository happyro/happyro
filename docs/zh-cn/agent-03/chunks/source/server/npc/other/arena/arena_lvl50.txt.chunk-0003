	disablenpc "force_06_07#50";
	disablenpc "force_07_08#50";
	disablenpc "force_08_09#50";
	disablenpc "force_exit#50";
	disablenpc "arena#50";
	donpcevent "#arn_timer_50::OnStop";
	enablenpc "Heel and Toe#arena";
	enablenpc "arena#50";
	end;

OnInit:
	if(!$top_50min && !$top_50sec) set $top_50min,5;
	end;
}

				mes "cave-ins and occasionally stops to";
				mes "cower in fear.";
				mes "^0099FFItem Drops^000000: Mole Whiskers, Mole";
				mes "Claw";
				next;
				mes "^FF0000[Dead Pit 1F Monsters]^000000";

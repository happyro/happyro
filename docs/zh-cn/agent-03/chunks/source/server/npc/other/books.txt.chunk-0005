				mes "stronger than Familiar. It also";
				mes "tends to pursue any human it";
				mes "finds.";
				mes "^0099FFItem Drops^000000: Tooth of Bat, Red Herb";
				next;
				break;
			case 2:
				mes "^FF0000[Dead Pit 2F Monsters]^000000";

		next;
		mes .@npc_name$;
		mes "The nearest place here is ^0033FFRachel^000000,";
		mes "If you have " + .@item_name$ + ", please give me one... and I'll teleport you.";
		mes "Ha~ It's popular these days, but I can't go buy it.";
		next;

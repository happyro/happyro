// Quest: Transporting Goods. Step 1 + 3.
wolfvill,53,234,0	script	#ep18_wp01	HIDDEN_WARP_NPC,4,4,{
	end;
OnTouch:
	if (ep18_main < 36)
		end;
	cloakoffnpcself( "Hazar#ep18_1" );
	cloakoffnpcself( "Camille#ep18_1" );
	cloakoffnpcself( "Transport Cart#ep18_1" );

		cutin "ep18_maram_01.png",2;
		next;
		cutin "",255;
		mes "[Merchant Rencia]";
		mes "<FONT SIZE = 10>That's true.</FONT>";
		next;
		mes "[Maram]";
		mes "<FONT SIZE = 16><B>Now!</FONT></B>";
		mes "<FONT SIZE = 14><B>Here's the list of items!</FONT></B>";
		cutin "ep18_maram_01.png",2;

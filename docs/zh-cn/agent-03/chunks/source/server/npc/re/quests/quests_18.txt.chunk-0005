		mes "Let's have a little chat ^e5555eover here^000000.";
		cutin "ep18_miriam_03.png",2;
		close2;
		cutin "",255;
		cloakoffnpcself( "Miriam#ep18_merchant3" );
		navigateto("rachel",120,79);
		end;
	}
	if (ep18_main == 26) {

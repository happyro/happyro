		mes "What's up.";
		mes "Not for you......";
		next;
		mes "[Maram]";
		mes "Actually, <FONT SIZE = 14><B>this merchant here</FONT></B> is the one.";
		cutin "ep18_maram_01.png",2;
		next;
		cutin "",255;
		mes "[Merchant Rencia]";
		mes "Hmm...";
		mes "<FONT SIZE = 10>Doesn't look like a merchant?</FONT>";
		next;
		mes "[Maram]";

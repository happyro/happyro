		mes "Let me go look for possible threats.";
		npctalk "Roel: Let me go look for possible threats.", .@roel$;
		disablenpc instance_npcname("Roel#11");
	}
	if ('room == 11 && is_party_leader() == true)
		donpcevent 'jitterbug_main$ + "::OnNextIs12";

		mes "Something has gone";
		mes "terribly wrong, hasn't";
		mes "it? Let me go baaaack~! ";
		set zdan_edq,15;
		set $@monster_zgang,0;
		set $@door2,0;
		close2;
		warp "moc_fild17",209,235;
		end;
	}

OnInit:
	hideonnpc "Catfoii";
	end;
}

// Unlucky Emerald

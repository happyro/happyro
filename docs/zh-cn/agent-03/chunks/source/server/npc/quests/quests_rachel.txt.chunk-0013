			mes "["+strcharinfo(0)+"]";
			mes "......";
			mes ".........";
			next;
			mes "[Priestess Panno]";
			mes "............";
			mes ".........";
			mes "......";
			next;
			mes "["+strcharinfo(0)+"]";
			mes "...?";
			next;

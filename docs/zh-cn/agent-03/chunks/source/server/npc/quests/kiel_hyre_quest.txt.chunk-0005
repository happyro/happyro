				mes "[Cottage Keeper]";
				mes "Well unless you have";
				mes "an appointment, I don't";
				mes "think you'll be able to";
				mes "meet with Mister Hyre.";
				close;
			}
		case 2:
			mes "[Cottage Keeper]";
			mes "Goodbye.";
			close;
		}
	}
}


						mes "Yeah...";
						mes "I just don't";
						mes "care anymore.";
						close;
					}
				case 2:
					if (god_megin_6 < 15) {
						mes "[Royal Myst]";
						mes "1st Squad? Yeah, I used to be in that. All of us in the squad used to be real good buddies too.";
						next;

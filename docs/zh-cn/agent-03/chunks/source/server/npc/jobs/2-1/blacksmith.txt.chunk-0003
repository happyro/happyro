		next;
		mes "[Krongast]";
		mes "...";
		mes "......";
		next;
		mes "[Krongast]";
		mes "When will the sword";
		mes "I ordered finally arrive?";
		mes "I need to try my ultimate skill, ^2F4F4FFine Edge^000000 with it.";
		next;
		mes "[Krongast]";
		mes "Ahhhhhhh!";
		mes "I need to";
		mes "have that sword!";
		close;
	}
}


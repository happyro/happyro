		JobId.INQUISITOR,

		JobId.MONK_B,
		JobId.SURA_B,

		JobId.SHEEP_MONK,
		JobId.SHEEP_CHAMP, // lolz.. MONK_H
		JobId.SHEEP_SURA,
		JobId.SHEEP_MONK_B,
		JobId.SHEEP_SURA_B,
		JobId.INQUISITOR_RIDING
	]);
	static isMonk(jobid) {
		return this.S_JOBS_MONK.has(jobid);
	}


	this.ItemInfo = (function () {
		const count = ((end - fp.tell()) / 6) | 0;
		const out = new Array(count);
		for (let i = 0; i < count; ++i) {
			out[i] = {};
			out[i].index = fp.readShort();
			out[i].position = fp.readULong();
		}
		return out;
	})();
};

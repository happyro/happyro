	this.itemId = 0;
	this.blacksmithBlessing = 0;
};
PACKET.CZ.REQ_REFINING.prototype.build = function () {
	const pkt_len = PACKETVER.value >= 20181121 ? 9 : 7;
	const pkt_buf = new BinaryWriter(pkt_len);

	pkt_buf.writeShort(0xaa3);

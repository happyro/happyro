			this.addr.ip =
				this.addr.ip.split('.').reduceRight((ip, octet, i) => ip + (parseInt(octet, 10) << (8 * i)), 0) >>> 0;
			this.addr.port = parseInt(this.addr.port, 10);
		}
	}
};

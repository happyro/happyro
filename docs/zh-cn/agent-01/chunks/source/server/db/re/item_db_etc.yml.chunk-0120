    Type: Card
    SubType: Enchant
    Script: |
      .@r = getrefine();
      bonus bStr,1;
      if (.@r>=7) {
         bonus bStr,1;
         if (.@r>=9) {
            bonus bStr,1;
            if (.@r>=11) {
               bonus bStr,1;
            }
         }
      }

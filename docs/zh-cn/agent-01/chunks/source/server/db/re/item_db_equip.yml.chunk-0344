  - Id: 400433
    AegisName: Gothic_HW_TW_LT
    Name: Fallen Wing Hairpin-LT
    Type: Armor
    Weight: 300
    Slots: 1
    Locations:
      Head_Top: true
    ArmorLevel: 2
    EquipLevelMin: 1
    Refineable: true
    Gradable: true
    View: 2372
    Script: |
      .@r = getrefine();
      .@g = getenchantgrade();
      bonus bMaxHPrate,10;
      bonus bDelayrate,8-(2*(.@r/2));
      bonus bMaxHP,3000*(.@r/3);
      if (.@r>=7) {
         bonus bDelayrate,-10;
         if (.@r>=9) {
             bonus bAtkRate,10;
             bonus bMatkRate,10;
             if (.@r>=11) {
                 bonus2 bAddRace,RC_All,15;
                 bonus2 bMagicAddRace,RC_All,15;
                 if (.@r>=13) {
                     bonus bNearAtkDef,10;
                     bonus bLongAtkDef,10;
                 }
             }
         }
      }
      if (.@g>=ENCHANTGRADE_D) {
         bonus bPAtk,5;
         bonus bSMatk,5;
         if (.@g>=ENCHANTGRADE_C) {
             bonus bMaxHP,15000;
             bonus bDelayrate,-5;
             if (.@g>=ENCHANTGRADE_B) {
                 autobonus "{ bonus2 bMagicAtkEle,Ele_All,20; bonus bShortAtkRate,20; bonus bLongAtkRate,20; }",20,10000,BF_WEAPON|BF_MAGIC;
                 if (.@g>=ENCHANTGRADE_A) {
                     bonus2 bSubEle,Ele_All,10;
                 }
             }
         }
      }

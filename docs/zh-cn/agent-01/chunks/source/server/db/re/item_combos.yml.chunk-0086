      .@sum = .@r + .@r_weapon;
      bonus bMatk,50;
      if (.@r >= 6 && .@r_weapon >= 7) {
         bonus bPerfectHitAddRate,10;
      }
      if (.@sum >= 17) {
         bonus2 bMagicAtkEle,Ele_All,15;
         bonus3 bAutoSpell,"SO_CLOUD_KILL",3,1;
      }
      if (.@sum >= 22) {
         autobonus3 "{ bonus5 bAutoSpell,\"SO_POISON_BUSTER\",1,10,BF_MAGIC,1; }",100,30000,"SO_CLOUD_KILL";
      }

// Daily Quest : Cleaning Robot Omega
ba_in01,24,322,3	script	Cleaning Robot 目#ba_pw01_02Q	20640,{
	if (checkweight(1000103,2) == 0) {
		mes "- You cannot proceed because you have too many items. -";
		close;
	}
	setpcblock PCBLOCK_NPC, true;
	npctalk "(亥_亥?) Ａ Loading..", "", bc_self;
	sleep2 1000;
	npctalk "Cleaning Robot 目 : Communication is in progress for user recognition.", "", bc_self;
	sleep2 2000;
	npctalk "(Ⅸ_Ⅸ*) Ａ Connect !!", "", bc_self;
	sleep2 1000;
	if (ep17_2_main < 9) {
		npctalk "Cleaning Robot 目 : Unauthorized user. Communication terminated.", "", bc_self;
		setpcblock PCBLOCK_NPC, false;
		end;
	}
	npctalk "Cleaning Robot 目 : User authorized. Nice to meet you.";
	sleep2 1000;
	setpcblock PCBLOCK_NPC, false;

	if (isbegin_quest(5892) == 0) {
		mes "[Cleaning Robot 目]";
		mes "Hello, Guest! Nice to meet you~ I'm Cleaning Robot 目~";
		next;
		select( "Hi. Nice to meet you." );
		mes "[Cleaning Robot 目]";
		mes "The task of the cleaning robot is to clean up the sewage and the first power plant.";
		npctalk "旨(^∩^)旭Cleaning..", "", bc_self;
		next;
		mes "[Cleaning Robot 目]";
		mes "But Cleaning Robot 目 can't clean right now~ Sad~";
		npctalk "毋(X_X)毋", "", bc_self;
		next;
		mes "[Cleaning Robot 目]";
		mes "Unauthorized users prevents us cleaning robots to do our job~";
		npctalk "(-_-a);;;", "", bc_self;
		next;
		mes "[Cleaning Robot 目]";
		mes "Cleaning Robot 目 is having difficulties. Good Guest, I need your help~ Please~";
		npctalk "ＣＢ ＣⅥＢ ＣＢ", "", bc_self;
		next;
		if (select( "Okay. I'll help you.", " I don't want to!" ) == 2) {
			mes "[Cleaning Robot 目]";
			mes "Cleaning Robot 目~ is sad..";
			npctalk "(壬_壬)毋", "", bc_self;
			close;
		}
		mes "[Cleaning Robot 目]";
		mes "The guest are really kind~";
		mes "Cleaning Robot 目~ is very happy";
		npctalk "(￣∩¯)ⅥⅤⅥⅤⅥⅤ", "", bc_self;
		setquest 5892;
		completequest 5892;
		close;
	}
	.@status[0] = F_queststatus(HUNTING,5893,5894,5895);
	.@status[1] = F_queststatus(HUNTING,5897,5898,5899);

	if (.@status[0] == 2 || .@status[1] == 2) {
		mes "[Cleaning Robot 目]";
		mes "Thank you very much, Cleaning Robot 目 is happy to be able to go clean up.";
		if (.@status[0] == 2) {
			erasequest 5893;
			erasequest 5894;
			erasequest 5895;
			setquest 5896;
			getitem 1000103,2;
			getexp 5065368,3500000;
		}
		if (.@status[1] == 2) {
			erasequest 5897;
			erasequest 5898;
			erasequest 5899;
			setquest 5900;
			getitem 1000103,2;
			getexp 5197368,3500000;
		}
		close;
	}
	switch( rand(1,4) ) {
	case 1:
		npctalk "(￣∩¯)/", "", bc_self;
		break;
	case 2:
		npctalk "曲(^∩^)旭 Power..", "", bc_self;
		break;
	case 3:
		npctalk "(￣∩¯)~Ｏ", "", bc_self;
		break;
	case 4:
		npctalk "旨(^∩^)旭 Cleaning..", "", bc_self;
		break;
	}
	.@quest_menu$[0] = callsub( S_Menu, 5893,5894,5895,5896, "Sewage Plant Cleaning" );
	.@quest_menu$[1] = callsub( S_Menu, 5897,5898,5899,5900, "1st Power Plant Cleaning" );

	mes "[Cleaning Robot 目]";
	mes "Cleaning is fun~";
	next;
	switch( select( .@quest_menu$[0], .@quest_menu$[1], "Good luck." ) ) {
	case 1:
		setarray .@quest[0],5893,5894,5895;
		.@cd = 5896;
		break;
	case 2:
		setarray .@quest[0],5897,5898,5899;
		.@cd = 5900;
		break;
	case 3:
		npctalk "(玄_玄). .(亥_亥). .(zZzZ)", "", bc_self;
		mes "[Cleaning Robot 目]";
		mes "Communication ended.";
		close;
	}
	switch( checkquest(.@cd,PLAYTIME) ) {
	case -1:
		break;
	case 0:
	case 1:
		if (.@quest[0] == 5893) {
			mes "[Cleaning Robot 目]";
			mes "Thank you, nice guest~ Cleaning Robot 目 has already treated the sewage plant.";
		}
		else {
			mes "[Cleaning Robot 目]";
			mes "Thank you, nice guest~ Cleaning Robot 目 has already cleaned the first power plant.";
		}
		close;
	case 2:
		erasequest .@cd;
		break;
	}
	switch( checkquest(.@quest[0],HUNTING) ) {
	case -1:
		if (.@quest[0] == 5893) {
			mes "[Cleaning Robot 目]";
			mes "Cleaning Robot 目 was supposed to be the one treating the sewage plant.";
			mes "We can't clean up because there more, Venenum, Waterfall, and Cramps~";
		}
		else {
			mes "[Cleaning Robot 目]";
			mes "Cleaning Robot 目 can't clean the first power plant because there are many Elite Bellare, Magical Dolor, and Unleashed Magic.";
		}
		npctalk "(壬^壬) OTL ..", "", bc_self;
		next;
		if (.@quest[0] == 5893) {
			mes "[Cleaning Robot 目]";
			mes "Cleaning Robot 目 is sad~";
			mes "I think I'll be able to treat the sewage plant, if you're able to take care of 44 Venenum, Waterfall, and Cramps.";
		}
		else {
			mes "[Cleaning Robot 目]";
			mes "Cleaning Robot 目 is sad~";
			mes "I think I'll be able to treat the first power plant, if you're able to take care of 44 Elite Bellare, Magical Dolor, and Unleashed Magic.";
		}
		npctalk "(?∩?)~Ⅴ", "", bc_self;
		next;
		if (select( "I'll help.", "Refuse." ) == 2) {
			npctalk "毋(@壬@)毋", "", bc_self;
			mes "[Cleaning Robot 目]";
			mes "Cleaning Robot 目~ is sad..";
			close;
		}
		mes "[Cleaning Robot 目]";
		mes "Thank you very much~";
		npctalk "(Ⅴ洸Ⅴ)~Ⅵ", "", bc_self;
		for ( .@i = 0; .@i < 3; ++.@i )
			setquest .@quest[.@i];
		close;
	case 0:
	case 1:
	case 2:
		if (.@quest[0] == 5893) {
			mes "[Cleaning Robot 目]";
			mes "Cleaning Robot 目 was supposed to be the one treating the sewage plant.";
			mes "I'm sad because I can't clean~ Monsters are so scary~";
		}
		else {
			mes "[Cleaning Robot 目]";
			mes "Cleaning Robot 目 was supposed to be the one cleaning the first power plant.";
			mes "I'm sad because I can't clean~ Monsters are so scary~";
		}
		npctalk "毋(壬_¯)毋", "", bc_self;
		close;
	}
	end;

S_Menu:
	.@string$ = getarg(4);

	switch( checkquest(getarg(3),PLAYTIME) ) {
	case -1:
		for ( .@i = 0; .@i < 3; ++.@i ) {
			if (checkquest(getarg(.@i),HUNTING) == 0 || checkquest(getarg(.@i),HUNTING) == 1)
				return "^777777[Ongoing]^000000 " + .@string$;
		}
		.@menu$ = "[Daily] " + .@string$;
		break;
	case 0:
	case 1:
		.@menu$ = "^777777[Waiting]^000000 " + .@string$;
		break;
	case 2:
		.@menu$ = "[Daily] " + .@string$;
		break;
	}
	return .@menu$;

OnMove:
	.@gid = getnpcid(0);
	npcspeed rand(50,200);
	do {
		.@x = rand(16,31);
		.@y = rand(311,332);
	}
	while (!checkcell("ba_in01",.@x,.@y,cell_chkpass));

	unitstopwalk .@gid, USW_FORCE_STOP;
	unitwalk .@gid,.@x,.@y;
	switch( rand(1,11) ) {
	case 1:
		npctalk "(９Ⅱ企９Ⅱ)";
		break;
	case 2:
		npctalk "Ｂ(^∩^)Ｃ用＜=洸";
		break;
	case 3:
		npctalk "(￣∩¯)ⅥⅤⅥⅤⅥⅤ";
		break;
	case 4:
		npctalk "(Ⅸ企Ⅸ)";
		break;
	case 5:
		npctalk "(≒邢≒)";
		break;
	case 6:
		npctalk "(∞企∞)";
		break;
	case 7:
		npctalk "(Ⅴ洸Ⅴ)~Ⅵ";
		break;
	case 8:

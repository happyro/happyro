		end;
	}
	unittalk getcharid(3), "" + strcharinfo(0) + " : I shouldn't touch these kind things.", bc_self;
	end;

OnInit:
	questinfo( QTYPE_QUEST2, QMARK_YELLOW, "isbegin_quest(17350) == 1" );
	end;
}


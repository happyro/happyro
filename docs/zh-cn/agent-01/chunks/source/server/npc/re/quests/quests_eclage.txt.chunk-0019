			close;
		case 2:
			if (countitem(7798) && countitem(715) > 1 && countitem(716) > 1 && countitem(717) > 1) {
				mes "Wow~ This will be a big step forward in the scientific progress among the Laphines. I pray for your home tree's blessings.";

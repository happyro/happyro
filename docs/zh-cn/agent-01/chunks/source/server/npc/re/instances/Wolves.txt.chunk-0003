2@nyr,209,98,5	script	Miriam#dms501	4_EP18_MIRIAM,5,5,{
	if (is_party_leader() == false)
		npctalk "Didn't the party leader decide to come?", instance_npcname("Miriam#dms501");
	end;
OnTouch:

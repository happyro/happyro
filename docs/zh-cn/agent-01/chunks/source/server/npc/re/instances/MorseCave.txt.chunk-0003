// GM NPC
sec_in02,20,20,6	script	Death Cave#a2	4_M_KHKYEL,{
	if (callfunc("F_GM_NPC",1854,0,1,9999) < 1)
		end;
	switch( select( "Death Cave Reset", "Set Vars", "Cancel" ) ) {
	case 1:
		mes "[Death Cave]";
		mes "Yes. Reset.";
		next;
		if (isbegin_quest(9318) > 0)
			erasequest 9318;
		if (isbegin_quest(9319) > 0)
			erasequest 9319;
		mes "[Death Cave]";
		mes "Done!";
		close;
	case 2:
		ep14_3_bios01 = 1;
		mes "[Death Cave]";
		mes "Thank You!";
		close;
	case 3:
		mes "[Death Cave]";
		mes "Thank You!";
		close;
	}
}

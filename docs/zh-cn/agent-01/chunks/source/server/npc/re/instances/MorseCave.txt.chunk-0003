1@rev,112,56,3	script	#RZ Move_17a	PORTAL,{
	mes "Do you want to exit through the portal?";
	next;
	if (select( "No.", "Yes." ) == 1)
		close;
	mes "- Teleporting... -";
	close2;
	warp "moro_cav",59,63;
	end;
}


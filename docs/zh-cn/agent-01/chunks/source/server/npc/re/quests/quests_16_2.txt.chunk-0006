		mes "[Lazy]";
		mes "He was nearly dead and we brought him all the way here by keeping him alive~ It was so tough~~";
		npctalk "I saved his life!", "", bc_self;
		next;
		cutin "16loo_01.bmp",0;
		mes "[Lucky]";

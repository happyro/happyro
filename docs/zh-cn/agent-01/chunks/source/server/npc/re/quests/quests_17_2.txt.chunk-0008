ba_in01,35,142,5	script	Rebellion#ep172_rb02	4_M_REBELLION3,{
	if (ep17_2_main < 28) {
		mes "[Rebellion]";
		mes "There is nothing particular here.";
		close;
	}
	mes "[Rebellion]";
	mes "Are you going in?";
	next;
	if (select( "Yes.", "No." ) == 2) {

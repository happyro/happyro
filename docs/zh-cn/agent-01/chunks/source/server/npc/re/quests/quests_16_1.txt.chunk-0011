				mes "[Kronecker]";
				mes "...It was a shame to cause such a scene";
				mes "In front of a guest.";
				mes "I apologize on the behalf of the Heine family.";
				next;
				cutin "ep16_friedrich_stolz_heine",1;
				mes "[Friedrich]";
				mes "Let me introduce myself.";
				mes "I am the current head of the Heine family, Friedrich Stoltze Heine.";
				next;
				mes "[Friedrich]";
				mes "This is the former head of the family, Archduke Grantz, my father.";
				next;
				cutin "ep16_kronecker_granz_heine",2;
				mes "[Kronecker]";
				mes "My name is Kronecker Grantz Heine.";
				next;
				cutin "ep16_friedrich_stolz_heine",1;
				mes "[Friedrich Stoltze]";

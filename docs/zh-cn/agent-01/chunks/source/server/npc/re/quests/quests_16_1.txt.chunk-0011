	if (ep16_royal == 2 && isbegin_quest(7683) == 0) {
		cloakoffnpcself( "Nyhill M. Heine#ep16_01" );
		cloakoffnpcself( "Peter Heine#ep16_01" );
		cloakonnpcself( "Peter Heine#ep16_02" );

			mes "I...";
			mes "I thought...";
			close2;
			warp "anthell02",172,185;
			end;
		}
		next;
		mes "...";
		next;
		mes "== Welcome...? ==";
		next;
		mes "== Where is the real Khahris? ==";
		close;
	}
	end;


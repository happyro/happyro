rockrdg1,286,247,3	script	Suspicious Sand Mound#rremef06	4_ENERGY_RED,15,15,{
	if (checkweight(1301,3) == 0) {
		mes "- There's something weird about this mound of sand, but but I'm carrying too much to examine it. I'd better lighten my bag first. -";
		close;
	}
	.@quest_id = callsub( S_Quest );
	.@npc_name$ = callsub( S_Name );

	if (checkquest(16078,HUNTING) != 0 && checkquest(16078,HUNTING) != 1 || countitem("Juice_Package") > 4 || isbegin_quest(.@quest_id) == 2) {
		mes "- Someone must have piled this mound of sand. -";
		close;
	}
	mes "- A tattered fabric pouch is half buried in the mound of sand. It could be Mrs. Cacturon's juice mix package. -";
	next;
	if (rand(1,2) == 1) {
		mes "- I moved close and picked up the pouch. It has the juice mix brand logo on it. Fortunately, it's not torn. -";
		next;
		mes "- I shook the sand off the pouch and put it in my bag. -";
		getitem 25246,1;	// Juice_Package
		setquest .@quest_id;
		completequest .@quest_id;
		cloakonnpcself( .@npc_name$ );
		if (countitem("Juice_Package") > 4) {
			next;
			.@name$ = strcharinfo(0);
			mes "[" + .@name$ + "]";
			mes "Even Mrs. Cacturon doesn't think she could get all seven packages back.";
			mes "This should be enough. I'd better end; to the village and report to her.";
			if (checkquest(16078,HUNTING) < 2) {
				next;
				mes "[" + .@name$ + "]";
				mes "Oh, right? I also need to hunt 30 Coyotes.";
			}
		}
		close;
	}
	mes "- I picked up the pouch. Sweet-smelling powder started pouring out through the tears at the bottom. -";
	next;
	mes "- It's not usable. I'll just have to leave it and look for another one. -";
	setquest .@quest_id;
	completequest .@quest_id;
	cloakonnpcself();
	close;

S_Quest:
	if (compare(strnpcinfo(2), "rremef"))
		.@id = atoi( replacestr( strnpcinfo(2), "rremef", "" ) );
	else {
		.@id = atoi( replacestr( strnpcinfo(2), "rrem", "" ) );
		.@id += 4;
	}
	return (16084 - 6 + .@id);

S_Name:
	if (compare(strnpcinfo(2), "rremef"))
		return strnpcinfo(2);
	.@id = atoi( replacestr( strnpcinfo(2), "rrem", "" ) );
	.@id += 4;
	.@string$ = strnpcinfo(1) + "#rrem" + (.@id < 10 ? "0" : "") + .@id;	// example: rremef06 for rrem02
	return .@string$;

OnTouch:
	.@quest_id = callsub( S_Quest );
	.@npc_name$ = callsub( S_Name );
	if (checkquest(16078,HUNTING) != 0 && checkquest(16078,HUNTING) != 1 || countitem("Juice_Package") > 4 || isbegin_quest(.@quest_id) == 2)
		cloakonnpcself( .@npc_name$ );
	else
		cloakoffnpcself( .@npc_name$ );
	end;

OnInit:
	cloakonnpc();
	end;
}

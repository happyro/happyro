	cutin "lunain01",2;
	mes "[Runane]";
	mes "Let's make a truce for now. But make no mistake--Newoz is mine the moment I find him vulnerable.";
	close3;
}

1@jtb,108,285,5	script	Aigu#17	4_F_IU,{
	cutin "igu03",0;

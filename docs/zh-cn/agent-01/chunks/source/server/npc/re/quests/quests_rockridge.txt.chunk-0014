}

harboro1,211,115,5	script	Worker#srdg01	1_M_SIGNMONK2,{
	mes "[Worker]";
	mes "We haven't worked for days. Can you believe that?";
	next;
	mes "[Worker]";
	mes "We can't work, and yet we're not allowed to leave. How unfair is that?";
	next;
	mes "[Worker]";
	mes "If this doesn't get solved by tomorrow, then I'm leaving!";
	close;
}

harboro1,213,117,3	script	Worker#srdg02	1_M_JOBGUIDER,{
	mes "[Worker]";
	mes "It seems we wouldn't be working today, just like yesterday and the day before.";
	next;
	mes "[Worker]";
	mes "I'd hate to go back home empty-handed again.";
	next;
	mes "[Worker]";
	mes "Maybe I should deal with the Buffalo Bandits myself.";
	close;
}

harboro1,211,113,7	script	Foreman#srdg01	4_F_EDEN_OFFICER,{
	mes "[Worker]";
	mes "When can we start working again?";
	next;
	mes "[Worker]";
	mes "How long do we have to wait around?";
	next;
	mes "[Foreman]";
	mes "Ah, guys, please calm down.";
	next;
	mes "[Worker]";
	mes "You calm down. We're losing money every hour just by sitting around.";
	next;
	mes "[Foreman]";
	mes "We can't do anything until we get our supplies.";
	next;
	mes "[Worker]";
	mes "And when would that be?";
	next;
	mes "[Foreman]";
	mes "There's nothing we could do. The Buffalo Bandits stole our last shipment, and it won't be the last time they do it.";
	next;
	mes "[Worker]";
	mes "I don't care. If I can't work tomorrow, then I'll walk out of here!";
	close;
}

harboro1,214,115,3	script	Worker#srdg03	1_M_HOF,{
	mes "[Worker]";
	mes "Does the sheriff even care about this situation?";
	next;
	mes "[Worker]";
	mes "He'd better.";
	next;
	mes "[Worker]";
	mes "Maybe I should join the Vigilantes.";
	next;
	mes "[Worker]";
	mes "Forget it. I tried, and got flat out rejected.";
	next;
	mes "[Worker]";
	mes "Sigh... How long do we have to wait?";
	close;
}

harboro1,290,104,5	script	Eznia#rockn04	4_DR_M_02,{
	mes "[Eznia]";
	mes "Did you know most buildings on the first level of Rock Ridge have a gigantic signboard in front of them?";
	next;
	mes "[Eznia]";
	mes "It's an interesting phenomenon. I think the signboards are supposed to make the buildings look like they have two stories, at least on the front.";
	next;
	mes "[Eznia]";
	mes "Actually, they used to be two stories before the basement was created. The owners must miss having two stories.";
	close;
}
harboro1,273,259,4	script	Alain Morlein#dy	4_M_YURI,{
	emotion ET_FRET;
	mes "[Alain Morlein]";
	mes "Hey, why can't you give me a loan?";
	next;
	emotion ET_PROFUSELY_SWEAT, getnpcid(0, "Bank Clerk#dy");
	emotion ET_SORRY, getnpcid(0, "Bank Clerk#dy");
	mes "[Bank Clerk]";
	mes "We're sorry, but we do not offer services to individual customers.";
	next;
	mes "[Alain Morlein]";
	mes "Are you kidding me? I used your services yesterday. Look, don't you remember me?";
	next;
	mes "[Bank Clerk]";
	mes "Let me see your ID. As you know, a lot of people here look alike.";
	next;
	mes "[Bank Clerk]";
	mes "I'm responsible for all transaction errors caused by misidentification. Please, you have to understand me.";
	next;
	emotion ET_THINK;
	mes "[Alain Morlein]";
	mes "*Snort*";
	next;
	emotion ET_THANKS, getnpcid(0, "Bank Clerk#dy");
	mes "[Bank Clerk]";
	mes "Thank you for your understanding. Have a good day.";
	close;
}

harboro1,270,252,6	script	Bank Clerk#dy	4_M_MANAGER,{
	emotion ET_BIGTHROB;
	mes "[Bank Clerk]";
	mes "Hello.";
	mes "Welcome to GC Bank's Rock Ridge branch. How may I assist you today?";
	next;
	switch( select( "Check my bank account.", "Buy an investment product.", "What's GC Bank?", "I'm just stopping by." ) ) {
	case 1:
		mes "[Bank Clerk]";
		mes "" + strcharinfo(0) + ", right?";
		next;
		mes "[Bank Clerk]";
		mes "You don't have an account with us, but you do have an account under the name of " + strcharinfo(0) + ". Is there anything else I can do for you today?";
		close2;
		openbank;
		end;
	case 2:
		emotion ET_SORRY;
		mes "[Bank Clerk]";
		mes "We're sorry,";
		mes "but our investment products are only for businesses.";
		close;
	case 3:
		mes "[Bank Clerk]";
		mes "Do you mean this bank?";
		mes "Not many people know about it because it doesn't have many branches yet.";
		next;
		mes "[Bank Clerk]";
		mes "And its main customers are companies and other businesses.";
		next;
		mes "[Bank Clerk]";
		mes "Of course, we serve individual customers as well, but companies are what keep most banks in business.";
		next;
		mes "[Bank Clerk]";
		mes "This is just a rumor, but the founder of GC Bank named his bank after what he loved the most: gold coins.";
		next;
		emotion ET_COOL;
		mes "[Bank Clerk]";
		mes "Can't you see the big beautiful gold coin on the roof of this building?";
		close;
	case 4:
		mes "[Bank Clerk]";
		mes "Hah hah, I see.";
		mes "We're in a desert and I can't go into the building, but I hope you'll enjoy your stay.";
		close;
	}
}

harboro1,241,200,5	script	Gunslinger Posh#rockn05	4_M_HUMERCHANT,{
	mes "[Gunslinger Posh]";
	mes "Are you looking for a good weapon? You know guns are the main weapons of this area, right?";
	next;
	npctalk "Some people, after selling guns for a while, started to think that they were also good at using one. I'm not one of them. I've always been good at it.", "", bc_self;
	mes "[Gunslinger Posh]";
	mes "Ah, the shop is closed. Sanders, the owner, went out to the desert, swinging a gun, to hunt the Buffalo Bandits himself. Then he fell and hurt his back.";
	next;
	mes "[Gunslinger Posh]";
	mes "Don't worry. You can still buy a gun. Sanders Jr. has rented a corner of the tool shop, so he could sell a few guns there.";
	next;
	npctalk "You can get to the tool shop by following this road east.", "", bc_self;
	mes "[Gunslinger Posh]";
	mes "He doesn't carry as wide a selection of products as his father, but he has an assortment of well-chosen models.";
	close;
}

harboro1,274,214,5	script	White Twig#rockn19	4_F_CACTUSLADY3,5,5,{
	mes "[White Twig]";
	mes "Akuha! Nahari! Where have they gone?";
	next;
	mes "[White Twig]";
	mes "Have you seen a couple of Cactus children, a boy and a girl?";
	mes "I've brought them here to show them around the strangers' village, and I lost them in a crowd.";
	next;
	mes "[White Twig]";
	mes "What should I do? Akuha! Nahari!";
	mes "If you see them, please tell them their grandma is looking for them.";
	close;

OnTouch:
	npctalk "Akuha! Nahari! Oh gosh, where are they?", "", bc_self;
	end;
}

harboro1,278,195,5	script	Carola Firth#rockn17	4_F_CAPEGIRL,{
	mes "[Carola Firth]";
	mes "Did you hear that? The basement is haunted!";
	next;
	mes "[Carola Firth]";
	mes "Word is that some worker couldn't get out in time before the basement was buried.";
	mes "This place has so many people coming in and out of it, it's hard to keep track of every one of them.";
	next;
	npctalk "Boo!", "Lucas Richie#rockn08", bc_self;
	mes "[Carola Firth]";
	mes "Some workers went down to the basement for repair work and heard strange rustling noises.";
	mes "When they found the source of noise? kyaaaahhh!";
	next;
	npctalk "Carola, you do things that scare most men, and yet you're scared of something that doesn't even exist.", "Lucas Richie#rockn08", bc_self;
	npctalk "That's why I'm scared: I don't want to be haunted by the spirit of everyone I've wronged.", "", bc_self;
	mes "[Carola Firth]";
	mes "Lucas! Do you want me to kill you? Stop doing that!";
	mes "Aww, I'm too scared to talk about this anymore.";
	close;
}

harboro1,280,195,3	script	Lucas Richie#rockn08	4_M_ROGUE,{
	mes "[Lucas Richie]";
	mes "The basement is haunted. You don't really believe that, do you?";
	mes "I think there are treasures down there.";
	next;
	mes "[Lucas Richie]";
	mes "And whoever spread that stupid rumor, he did it to keep others from finding out about the treasures.";
	next;
	npctalk "Whatever. I'm still not going in there!", "Carola Firth#rockn17", bc_self;
	npctalk "*Chuckle* Who knew Carola of all people would be so scared of ghosts?", "", bc_self;
	mes "[Lucas Richie]";
	mes "Hm, I meant that as a joke, but maybe she really is scared.";
	mes "What do you say, Carola? How'd you like to go down there with me?";
	mes "Ah, adventurer. Let's keep this just between you and me, okay?";
	close;
}

-	shop	bread_rockridge	-1,580:150

harboro1,314,211,4	script	Bakery Owner#dy	4_COOK,3,3,{
	npctalk "Welcome!", "", bc_self;
	callshop "bread_rockridge",1;
	end;

OnTouch:
	.@r = rand(1,10);
	if (.@r == 3)
		npctalk "I've baked this bread just this morning.", "", bc_self;
	else if (.@r == 4)
		npctalk "Bread! Buy bread freshly out of the oven!", "", bc_self;
	else if (.@r == 5)
		npctalk "I've got bread that's so delicious, it's to die for.", "", bc_self;
	else if (.@r == 6)
		npctalk "I've got the best bread under the sky! Buy my bread!", "", bc_self;
	else if (.@r == 7)
		npctalk "Bread! Bread, bread! BREAD!", "", bc_self;
	else if (.@r == 8)
		npctalk "Hey, how'd you like to buy some bread?", "", bc_self;
	else if (.@r == 9)
		npctalk "I sell bread, and nothing else.", "", bc_self;
	end;
}

harboro1,282,201,3	script	Rock Ridge Tiger#srdg01	4_CAT_REST,{
	emotion ET_SLEEPY;
	end;
}

harboro1,302,175,7	script	Sammy#srdg01	4_DOG01,{
	emotion ET_THROB;
	npctalk "Woof, woof! Woof, woof!";
	end;
}

harboro1,312,173,8	script	Bounty Hunter#rockn18	8_F_GIRL,{
	mes "[Bounty Hunter]";
	mes "What am I looking at? Ah, those buffaloes. There's a large sum of money offered for their heads.";
	next;
	mes "[Bounty Hunter]";
	mes "The Vigilantes and the Sheriff have had enough with them, now that they started robbing the train.";
	next;
	mes "[Bounty Hunter]";
	mes "But thanks to them, I've got a lucrative job.";
	close;
}

harboro1,301,175,7	script	Shepherd#srdg01	4_F_JOB_BLACKSMITH,{
	emotion ET_CRY;
	mes "[Shepherd]";
	mes "I'm sorry, guys. I should've never taken you here...";
	next;
	mes "[Shepherd]";
	mes "I didn't know there was no grass here.";
	next;
	mes "[Shepherd]";
	mes "Just hang in there. I'm growing some grass for you out there. If it grows well, you wouldn't have to be hungry anymore.";
	close;
}

harboro1,303,179,3	duplicate(dummy_npc)	Malnourished Sheep#srdg	4_LAM
harboro1,299,179,7	duplicate(dummy_npc)	Frail Sheep#srdg01	4_LAM
harboro1,305,178,5	duplicate(dummy_npc)	Coarse-haired Sheep#srd	4_LAM
harboro1,297,178,5	duplicate(dummy_npc)	Dozing Sheep#srdg01	4_LAM

harboro1,311,53,5	script	Joyce Leslie#rockn06	4_F_01,{
	mes "[Joyce Leslie]";
	mes "The houses closer to the beach have always been prone to sinking, long before the first level was buried.";
	mes "This house sank little by little, until the ground couldn't hold its weight anymore.";
	next;
	mes "[Joyce Leslie]";
	mes "What happened to its residents, you ask? You're an adventurer, why do you care?";
	next;
	emotion ET_OHNO;
	mes "[Joyce Leslie]";
	mes "I'm sorry, I didn't mean to get angry with you.";
	mes "It's just that... things haven't been good.";
	next;
	mes "[Joyce Leslie]";
	mes "But at least I have work to do and food to eat, thanks to some people.";
	mes "Where do I get work and food? Head up to the eastern gate. You'll see the along the way.";
	close;
}

harboro1,324,124,7	script	Joe	4_MAL_CAPTAIN,{
	if (BaseLevel < 100) {
		mes "[Joe]";
		mes "...";
		next;
		mes "[Joe]";
		mes "You're too weak";
		mes "to enter the basement.";
		mes "Please leave.";
		close;
	}
	mes "[Joe]";
	mes "...";
	next;
	mes "[Joe]";
	mes "Are you going to go in?";
	next;
	if (select( "Yes.", "No." ) == 2) {
		mes "[Donovan]";
		mes "...";
		close;
	}
	mes "[Joe]";
	mes "You'd better get out of there";
	mes "as soon as you're done.";
	close2;
	warp "harboro2",281,104;
	end;
}

harboro1,352,199,5	script	Hungry Laborer#1	4W_M_03,5,5,{
	end;
OnTouch:
	if (isbegin_quest(12381) == 2)
		end;
	.@num = atoi(strnpcinfo(2));
	if (.@num == 1)
		npctalk "Hungry Laborer: Aww, I'm starving. Why isn't the line getting any shorter?";
	else if (.@num == 5)
		npctalk "Curious Person: What's this line for? Are you waiting to get event prizes?";
	else if (.@num == 8)
		npctalk "Hungry Laborer: This is ridiculous. I've been waiting in line for 3 hours to eat.";
	else if (.@num == 11)
		npctalk "Hungry Laborer: Soon it'll be my turn!";
	else if (.@num == 13)
		npctalk "Hungry Laborer: Hey, don't you see the line here? Get to the end of the line!";
	end;
}
harboro1,352,187,5	duplicate(Hungry Laborer#1)	Curious Person#5	4_M_LGTPOOR,5,5
harboro1,352,178,5	duplicate(Hungry Laborer#1)	Hungry Laborer#8	4W_SAILOR,5,5
harboro1,352,169,5	duplicate(Hungry Laborer#1)	Hungry Laborer#11	4_M_EINMAN,5,5
harboro1,355,164,5	duplicate(Hungry Laborer#1)	Hungry Laborer#13	4W_SAILOR,5,5

harboro2,67,191,5	script	Smell Maniac#srdg01	4_M_ALCHE_B,{
	mes "[Smell Maniac]";
	mes "*Sniff Sniff* Doesn't this place smell good to you? I love its salty, dank, musty smell! I could live here for the rest of my life!";
	next;
	mes "[Smell Maniac]";
	mes "...If only there weren't so many bugs. I'm just going to bottle the smell and take it with me.";
	close;
}
harboro2,57,239,3	script	Unemployed Man#srdg01	4_M_03,{
	mes "[Unemployed Man]";
	mes "See those sea anemones? They keep clogging up the sewer pipes, so we get rid of them on a regular basis. I like sitting here and watching them move. And when I do, time goes by so quickly.";
	next;
	mes "[Unemployed Man]";
	mes "At least during that time I could forget my reality, about the mine, not having jobs, you know, that sort of thing.";
	next;
	mes "[Unemployed Man]";
	mes "I'm here because I have nowhere else to go, but I'll go back up once those who took up residence in the mine are gone.";
	close;
}

harboro2,118,264,5	script	Old Woman#srdg01	4_F_LGTGRAND,{
	mes "[Old Woman]";
	mes "This place hasn't changed at all.";
	next;
	mes "[Old Man]";
	mes "Remember when we first came here?";
	next;
	mes "[Old Woman]";
	mes "I do.";
	next;
	mes "[Old Man]";
	mes "We built this house from scratch, on our own from the foundation stones to the roofing.";
	next;
	mes "[Old Woman]";
	mes "Aww, it's getting chilly. Let's go back up.";
	next;
	mes "[Old Man]";
	mes "My lovely Clementine... I proposed to her here.";
	next;
	mes "[Old Woman]";
	mes "I'm here.";
	next;
	mes "[Old Man]";
	mes "My Clementine is not so old!";
	next;
	mes "[Old Woman]";
	mes "Grr, you senile coot!";
	close;
}

harboro2,120,265,3	script	Old Man#srdg01	4_M_DST_GRAND,{
	mes "[Old Man]";
	mes "Mm? Who's there? Is it you, Charlie?";
	next;
	mes "[Old Woman]";
	mes "Charlie can't come here. He lives across the sea.";
	next;
	mes "[Old Man]";
	mes "Does he? By the way, this place has changed a lot.";
	next;
	mes "[Old Woman]";
	mes "No, it hasn't. It's just the same as when we left it.";
	next;
	mes "[Old Man]";
	mes "Is it? I come here when I miss the old days, but it's too dark. By the way, why has it become so wet?";
	next;
	mes "[Old Woman]";
	mes "It was flooded. That's why it had to be filled up and we had to move up. Have you gone senile? You were the one who insisted this place was too low to build houses on.";
	next;
	mes "[Old Man]";
	mes "Was I?";
	close;
}

harboro2,125,196,3	script	Mom's Kid#srdg01	4_F_CHILD,{
	mes "[Kid]";
	mes "Mommy, when can we live above ground again?";
	next;
	mes "[Mom]";
	mes "Soon. When Daddy can go work at the mine again. When Mommy and Daddy make enough money to buy back the house.";
	next;
	mes "[Kid]";
	mes "I want to go home...";
	close;
}

harboro2,123,195,5	script	Kid's Mom#srdg01	1_M_INNKEEPER,{
	mes "[Mom]";
	mes "I haven't been able to feed my child well. I can't remember the last time he had a decent meal.";
	next;
	mes "[Kid]";
	mes "Mommy, I'm okay.";
	next;
	mes "[Mom]";
	mes "Let's wait for Daddy. He'll be back with food.";
	close;
}

harboro2,142,155,7	script	Buffalo Bandit#srdg01	4_M_COWRAIDERS1,{
	mes "[Buffalo Bandit]";
	mes "What, haven't you seen a Buffalo Bandit before?";
	next;
	mes "[Buffalo Bandit]";
	mes "Don't give me that dirty look. We're not doing anything bad right now, now are we?";
	next;
	mes "[Buffalo Bandit]";
	mes "You're on our turf. Don't cause trouble, and stay away from here.";
	next;
	mes "[Buffalo Bandit]";
	mes "I'll let you come and go, if you promise me not to tell anyone above the ground about us. Promise?";
	close;
}

harboro2,144,156,1	script	Buffalo Bandit#srdg02	4_M_COWRAIDERS3,{
	mes "[Buffalo Bandit]";
	mes "Aside from the main gate, there are are a few more entrances that only we know, and we guard one of them.";
	next;
	mes "[Buffalo Bandit]";
	mes "Why are you telling me this?";
	next;
	mes "[Buffalo Bandit]";
	mes "So you'd be scared and want to stay away.";
	close;
}

harboro2,258,117,3	script	Dispatched Nun#srdg02	1_F_PRIEST,{
	mes "[Dispatched Nun]";
	mes "Can you believe some people actually live here? People above ground don't care about them. Officially, this place is vacant, even though it's not.";
	next;

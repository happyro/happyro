	mes "A vagabond like";
	mes "you setting foot";
	mes "into my home!?";
	mes "Unthinkable!";
	next;
	mes "[Megass]";
	mes "Leave immediately";
	mes "before I report you";
	mes "to the authorities";
	mes "for trespassing!";
	next;

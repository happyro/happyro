			close;
		}
		else {
			mes "[Fayruz]";
			mes "Oh. There isn't anything";
			mes "here that would help in my";
			mes "research, but thank you anyway.";
			mes "If you find anything else while";
			mes "you're in Juperos, please come back and show it to me, alright?";

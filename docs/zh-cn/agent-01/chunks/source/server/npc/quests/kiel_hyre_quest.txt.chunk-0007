			mes "your might, but fail";
			mes "to make it budge.^000000";
			close;
		case 2:
			mes "^3355FFyou decided to leave";
			mes "this door alone until";
			mes "you can figure out";
			mes "how to open it^000000";
			close;
		}
	}
	else {

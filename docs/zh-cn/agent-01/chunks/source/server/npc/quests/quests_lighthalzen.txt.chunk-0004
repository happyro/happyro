						mes "but I do owe you. Just";
						mes "take this and I hope we never";
						mes "bump into each other again!";
					}
					else if (.@number == 2) {
						mes "Two, huh? I can dig it.";
						mes "Now take these and I hope";
						mes "we never see each other";
						mes "ever again! Ciao, baby~";
					}

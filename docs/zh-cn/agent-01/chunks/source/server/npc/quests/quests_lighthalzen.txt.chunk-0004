		mes "I can only sell up to";
		mes "three of my secret tonic";
		mes "to you since that's all";
		mes "I have. Each one will";
		mes "cost 15,000 zeny. So";
		mes "what do you say?";
		next;
		switch(select("Give me 1.:Give me 2.:Give me 3.:No, I'm fine.")) {

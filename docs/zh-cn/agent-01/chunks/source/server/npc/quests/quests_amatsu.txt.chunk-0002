		mes "Oh man, you didn't prepare";
		mes "what I asked for...";
		mes "Do not forget what I asked.";
		next;
		mes "[Magumagu]";
		mes "10 ^0000FFCrab Shells^000000...";
		mes "You didn't forget it, right?";
		mes "Bring me these supplies, please.";
		close;
	}
	else if (fish_r == 3) {

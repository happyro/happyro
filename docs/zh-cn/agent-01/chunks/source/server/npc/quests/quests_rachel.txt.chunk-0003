	else if ((rach_vice == 20) && (countitem(1201) > 0)) {
		mes "[Katinshuell]";
		mes "I...";
		mes "I don't deserve this!";
		mes "Why do you keep hounding";
		mes "me with these questions?";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "Did... Did something";

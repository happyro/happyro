	}
	else if (rach_vice == 21) {
		mes "[Katinshuell]";
		mes "^333333*Pant pant*^000000";
		mes "After all this";
		mes "time... I thought";
		mes "I could run away...";
		mes "But the voices still";
		mes "h-haunt me... Ha ha ha...";

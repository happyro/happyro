		mes "Doesn't that make me and";
		mes "you feel so much better?!";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "......";
		mes ".........";
		next;
		mes "[Katinshuell]";
		mes "...............................";
		mes "God! My life sucks!";

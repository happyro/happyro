			mes "Hey Calbern!";
			mes "Bring beer! Beer!";
			next;
			mes "[Helmut]";
			mes "Why are you still standing there? I have nothing else to say to you! Stand back!";
			next;
			mes "[" + strcharinfo(0) + "]";
			mes "......";

// Regen related flags.
enum e_regen {
	RGN_NONE = 0x00,
	RGN_HP   = 0x01,
	RGN_SP   = 0x02,
	RGN_SHP  = 0x04,
	RGN_SSP  = 0x08,
};

static struct status_data dummy_status;

/// Delayed Status Structure
struct s_delay_status {
	int32 src_id;
	int32 bl_id;
	sc_type type;
	int32 val1;
	int32 val2;
	int32 val3;
	int32 val4;
	int32 tick;
	uint8 flag;
};


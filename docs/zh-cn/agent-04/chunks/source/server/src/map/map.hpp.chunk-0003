#define BL_CAST(type_, bl) \
	( ((bl) == nullptr || (bl)->type != (type_)) \
	? nullptr \
	: static_cast< typename std::conditional< \
		std::is_const<std::remove_pointer_t<decltype(bl)>>::value, \
		const T##type_*, \
		T##type_* \
	>::type >(bl) )


}

// RAII class for locking freeblock
class FreeBlockLock {
public:
	explicit FreeBlockLock(bool startLocked = true);
	~FreeBlockLock();

	void lock();
	void unlock();

	FreeBlockLock(const FreeBlockLock&) = delete;
	FreeBlockLock& operator=(const FreeBlockLock&) = delete;
private:
	bool locked;
};



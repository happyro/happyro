static void status_calc_bl(block_list *bl, std::vector<e_scb_flag> flags) {
	static std::bitset<SCB_MAX> temp;

	temp.reset();
	for (const auto &scb : flags) {
		temp.set(scb);
	}

	status_calc_bl_(bl, temp);
}


	mes "[Scary Crew]";
	mes "They just come in and out, even the other person's room...";
	mes "It causes harm for sure.";
	close;
}

mal_in02,109,62,4	script	Picky Crew#nyaong03	545,{
	mes "[Picky Crew]";

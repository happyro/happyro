	} else if (malaya_bang == 17) {
		select("Show her the stick.");
		mes "[Bent Old Lady]";
		mes "What?";
		mes "Arghhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhh";

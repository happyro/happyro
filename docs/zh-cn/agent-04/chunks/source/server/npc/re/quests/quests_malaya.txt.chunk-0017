		mes "What? I can't hear you.";
		mes "Speak up!";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "I! Have! Something! To! Ask! You!";
		next;
		mes "[Bent Old Lady]";
		mes "Oh~Yes dear~";
		mes "I'll tell you everything I know, dear~";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "Do you know anything about the hospital?";

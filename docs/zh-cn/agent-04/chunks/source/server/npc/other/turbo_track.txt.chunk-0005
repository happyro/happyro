-	script	Flasher#tt_main	-1,{
OnTouch_:
	mapannounce strnpcinfo(4),strcharinfo(0) +" has just passed the Flasher Maze!",bc_map,"0x70DBDB";
	warp strnpcinfo(4),185,227;
	end;
	
OnInit:
	set .@w$,callfunc("F_tt");
	disablenpc();
	end;
}

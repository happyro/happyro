				mes "^0099FFItem Drops^000000: Jellopy, Sticky Mucus,";
				mes "Apple, Empty Bottle, Red Herb";
				next;
				mes "^FF0000[Prontera Maze 1F Monsters]^000000";
				mes "2. Lunatic";
				mes "Plump and shaggy monster shaped in";

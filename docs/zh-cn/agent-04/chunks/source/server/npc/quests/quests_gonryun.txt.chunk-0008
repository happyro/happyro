				end;
			}
			mes "[Cylrnel]";
			mes "...";
			mes "Hey~ you don't have all";
			mes "the ingredients yet.";
			mes "Go get them all right away.";
			next;
			mes "[Cylrnel]";
			mes "^FF00001 Seed of Yggdrasil";
			mes "1 Aloe";
			mes "5 Witch Starsands";
			mes "3 Burning Hearts";
			mes "3 Ice Cubics";

			mes "Rune-Midgarts";
			mes "Secret Service!";
			mes "Vitre Bizlleta--";
			mes "you're under arrest";
			mes "for espionage!";
			next;
			mes "[Vitre]";
			mes "Again? Didn't you just";
			mes "arrest me just for being";
			mes "suspected of espionage?";
			mes "I think it's a little unfair";

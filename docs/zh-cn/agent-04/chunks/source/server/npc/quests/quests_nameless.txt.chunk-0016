							next;
							break;
						}
					}
					else {
						if (.@amuro == 1) {
							set .@number_right_2,.@number_right_2+1;
							mes "[Moonho Ahn]";
							mes "Let's see...";
							mes "It's odd, isn't it?";
							next;
							mes "[Moonho Ahn]";
							mes "I lost, huh?";
							mes "So it was ^0000ffEven^000000...";
							next;
						}
						else if (.@amuro == 2) {
							set .@number_false_2,.@number_false_2+1;
							mes "[Moonho Ahn]";
							mes "Let's see...";
							mes "It's ^0000FFEven^000000, isn't it?";
							next;
							mes "[Moonho Ahn]";
							mes "Looks like I won!";

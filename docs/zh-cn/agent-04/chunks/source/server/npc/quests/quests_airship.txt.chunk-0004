	mes "[Tarlock]";
	mes "I am Tarlock,";
	mes "captain of this";
	mes "Airship. Go and";
	mes "fight with the";
	mes "Gremlins!";
	close2;
	cutin "",255;
	end;
	
OnInit:
	hideonnpc "Airship Captain#02";
	end;
}


			case 1:
				mes "[" + .@name$ + "]";
				mes "Oh, really?";
				mes "That's too bad...";
				mes "My apologies, but";
				mes "I can't allow strangers";
				mes "to simply come and go";
				mes "around here. Farewell, then.";
				next;

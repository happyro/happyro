  - Id: 400390
    AegisName: GoodnEvil_Circlet_SH
    Name: Crown of Good and Evil (Spirit Handler)
    Type: Armor
    Weight: 100
    Defense: 10
    Slots: 1
    Jobs:
      Spirit_Handler: true
    Locations:
      Head_Top: true
    ArmorLevel: 2
    EquipLevelMin: 215
    Refineable: true
    Gradable: true
    View: 2332
    Script: |
      .@g = getenchantgrade();
      .@r = getrefine();
      bonus2 bAddRace,RC_All,5*(.@r/3);
      bonus2 bMagicAddRace,RC_All,5*(.@r/3);
      bonus bLongAtkRate,7*(.@r/4);
      bonus2 bMagicAtkEle,Ele_Ghost,7*(.@r/4);
      bonus2 bMagicAtkEle,Ele_Neutral,7*(.@r/4);
      if (.@r>=7) {
         bonus bRes,50;
         if (.@r>=9) {
            bonus bVariableCastrate,-5;
            bonus bCritical,5;
            if (.@r>=11) {
               bonus bFixedCast,-300;
               bonus bMatkRate,5;
               bonus bAtkRate,5;
            }
         }
      }
      if (.@g>=ENCHANTGRADE_D) {
         bonus bMaxHPrate,5;
         if (.@g>=ENCHANTGRADE_C) {
            bonus bPAtk,3;
            bonus bSMatk,3;
            if (.@g>=ENCHANTGRADE_B) {
               bonus bPAtk,2;
               bonus bSMatk,2;
               bonus bPow,2;
               bonus bSpl,2;
               if (.@g>=ENCHANTGRADE_A) {
                  bonus bMRes,50;
                  bonus bRes,50;
                  if (.@r>=12) {
                     bonus bFixedCast,-200;
                  }
               }
            }
         }
      }

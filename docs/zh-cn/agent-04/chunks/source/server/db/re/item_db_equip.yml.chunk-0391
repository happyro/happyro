  - Id: 450169
    AegisName: Star_Armor_Of_Pow
    Name: Nebula Armor of Power
    Type: Armor
    Weight: 2500
    Defense: 175
    Slots: 1
    Locations:
      Armor: true
    ArmorLevel: 2
    EquipLevelMin: 240

      if (.@r>=10)
         bonus bAllStats,15;
      if ((eaclass()&EAJL_THIRD) && (BaseJob == Job_Bard || BaseJob == Job_Dancer)) {
         bonus bMaxHPrate,15;
         bonus bMatkRate,15;
         bonus2 bMagicAddRace,RC_All,15;
      }

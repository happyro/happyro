      }
  - Combos:
      - Combo:
          - War_Axe_IL    # 1326
          - Shoes_IL    # 22133
    Script: |
      bonus bBaseAtk,40;
      .@eq = getequiprefinerycnt(EQI_SHOES);
      .@weapon = getequiprefinerycnt(EQI_HAND_R);
      if (.@eq >= 7 && .@weapon >= 7) {
         bonus2 bSkillAtk,"NC_AXEBOOMERANG",15;
      }
      if ((.@eq + .@weapon) >= 18) {
         bonus bAtkRate,10;
         if ((.@eq + .@weapon) >= 22) {
            bonus bLongAtkRate,10;
         }
      }

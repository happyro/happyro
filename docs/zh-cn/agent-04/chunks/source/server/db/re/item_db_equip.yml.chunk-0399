         bonus2 bSkillAtk,"NW_SPIRAL_SHOOTING",5*(.@r/3);
      }
      if (.@g>=ENCHANTGRADE_B) {
         bonus bPAtk,.@r/2;
         bonus2 bAddSize,Size_All,5*(.@r/3);

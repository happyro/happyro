    EquipLevelMin: 245
    Refineable: true
    Gradable: true
    Script: |
      .@g = getenchantgrade();
      .@r = getrefine();
      bonus bMatk,130+15*(.@r/2);
      bonus bDef,15*(.@r/2);
      if (.@r>=7) {
         bonus2 bMagicAtkEle,Ele_All,3;
         if (.@r>=9) {
            bonus bVariableCastrate,-10;
            bonus bSMatk,5;
            if (.@r>=10) {
               bonus2 bMagicAtkEle,Ele_All,5;
               if (.@r>=12) {
                  bonus bDelayrate,-5;
               }
            }
         }
      }
      if (.@g>=ENCHANTGRADE_D) {
         bonus bDelayrate,-5;
         bonus bSpl,3;
         bonus bCon,3;
         if (.@g>=ENCHANTGRADE_C) {
            bonus bSMatk,2;
            bonus bMatkRate,3;
            if (.@g>=ENCHANTGRADE_B) {
               bonus bSMatk,3;
               bonus bSpl,4;
               bonus bCon,4;
               if (.@g>=ENCHANTGRADE_A) {
                  bonus bSMatk,5;
                  bonus bMatkRate,4;
               }
            }
         }
      }

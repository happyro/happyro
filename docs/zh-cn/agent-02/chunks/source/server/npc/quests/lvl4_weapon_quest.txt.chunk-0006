			else {
				mes "is Dragon Slayer!";
				getitem 1166,1; //Dragon_Slayer
			}
			set lv4_weapon,0;
			next;
		}
		else {
			mes "[Hein]";
			mes "Haha~!";
			mes "This is great!";
			mes "Finally, my life's";
			mes "work is complete!";
			mes "This weapon's name";

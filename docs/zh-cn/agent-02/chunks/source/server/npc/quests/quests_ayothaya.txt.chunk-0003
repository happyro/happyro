					next;
					mes "["+strcharinfo(0)+"]";
					mes "Wait...";
					mes "There are more";
					mes "footprints heading";
					mes "toward the ^5C3317East^000000.";
					mes "I better look";
					mes "into this.";
					set thai_find,10;

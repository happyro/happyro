			mes "- hands over a paper. -";
			next;
			mes "[Manager]";
			mes "No way.";
			mes "Here's the clue.";
			mes "Try to find it.";
			next;
			mes "[Manager]";
			mes "Anyway my name is Paul.";
			mes "...........";

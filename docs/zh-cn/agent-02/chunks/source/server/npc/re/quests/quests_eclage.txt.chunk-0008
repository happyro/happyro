		next;
		mes "- Shuffle -";
		mes "- Shuffle -";
		next;
		mes "- Shuffle -";
		mes "- Shuffle -";
		mes "- Shuffle -";
		next;
		mes "[Svery]";
		mes "Yes, here it is.";
		next;
		mes "[Svery]";
		mes "I told myself that I'll keep it really safe, and that's why it's like this.";

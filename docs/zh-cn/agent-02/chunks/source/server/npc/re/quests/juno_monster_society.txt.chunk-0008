			close;
		case 2:
			mes .@npc_name$;
			mes "The nearest place here is ^0033FF Veins^000000,";
			mes "If you have " + .@item_name$ + ", please give me one... and I'll teleport you.";
			next;
			if (select( "Give me 1 " + .@item_name$ + " with Veins", "No" ) == 2) {

	hideonnpc instance_npcname( strnpcinfo(0) );
	specialeffect EF_ICEWALL;
	end;
OnTimer30000:
	specialeffect EF_ICEWALL;
	end;
OnTimer60000:
	specialeffect EF_ICEWALL;
	initnpctimer;
	end;
}

		mes "[Mark]";
		mes "Please tell him to work hard!";
		mes "Hahahahaha!";
		cutin "mark_wt_4",0;
		next;
		mes "[Alice]";
		mes "Oh, Tamarin must be the friend who often goes missing, right?";
		cutin "acact_03",2;
		close3;

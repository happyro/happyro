		cloakonnpcself( "Molar#172ba04" );
		cloakonnpcself( "Canine#172ba04" );
		cloakonnpcself( "Danae#172ba04" );
		cloakonnpcself( "Gonie#172ba02" );
		mes "[Princess]";

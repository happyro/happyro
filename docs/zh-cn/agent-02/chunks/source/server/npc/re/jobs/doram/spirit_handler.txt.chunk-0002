		select( "Who's speaking?" );
		mes "[Chulho]";
		mes "<FONT SIZE = 14>I am Chulho.</FONT>";
		mes "<FONT SIZE = 14>I~~ I'm a spirit from the forest.</FONT>";
		npctalk "Ahem!", "???#JQ_SH_3", bc_self;
		cutin "ex_sh_chulho00.png",2;

			next;
			set malaya_bang,20;
			changequest 11300,11301;
		}
		mes "[Nurse Las]";
		mes "Could you check the 2nd floor door again in case I missed something?";
		cutin "malaya_nurseA01",2;
		next;
		switch(select("Go outside.:Quit.")) {
		case 1:
			close2;
			cutin "",255;
			warp "malaya",58,76;
			end;
		case 2:
			mes "[Nurse Las]";
			mes "Tsk...";
			close2;
			cutin "",255;
			end;
		}
	} else {
		callfunc "F_Malaya_Nurse",2;
		end;
	}
	mes "[Nurse]";
	mes "I want to be left alone.";
	mes "Please leave.";
	close2;
	warp "malaya",58,76;
	end;
}


ma_dun01,35,108,4	script	Nurse#ma_n2	569,{
	if (malaya_bang < 19) {
		// fall through
	} else if (malaya_bang < 30) {
		if (malaya_bang == 19) {
			mes "The hospital is infested with monsters, like the old lady said.";

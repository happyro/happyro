    Refineable: true
    Gradable: true
    Script: |
      .@g = getenchantgrade();
      .@r = getrefine();
      bonus bAtkRate,5;
      if (BaseLevel>=210) {
         bonus bPAtk,1;
         bonus bPow,2;
      }
      if (.@r>=7) {
         bonus2 bSkillAtk,"SR_RAMPAGEBLASTER",20;
         bonus2 bSkillAtk,"SR_RIDEINLIGHTNING",20;
         if (.@r>=9) {

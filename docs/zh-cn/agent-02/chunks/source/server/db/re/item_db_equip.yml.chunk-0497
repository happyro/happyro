               bonus2 bSkillAtk,"SR_RAMPAGEBLASTER",25;
               bonus2 bSkillAtk,"SR_RIDEINLIGHTNING",25;
            }
         }
      }
      if (.@g >= ENCHANTGRADE_D) {
         bonus bAtkRate,3;
         if (.@g >= ENCHANTGRADE_C) {
            bonus bLongAtkRate,15;
            bonus bPAtk,1;
            if (.@g >= ENCHANTGRADE_B) {
               bonus bPAtk,2;
               bonus bPow,3;
            }
         }
      }
      bonus bBaseAtk,15*(.@r/2);
      bonus bLongAtkRate,4*(.@r/3);

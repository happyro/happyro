      bonus bBaseAtk,75;
      if (.@r>=7) {
         bonus bAspdRate,15;
         if (.@r>=9) {
            bonus bVariableCastrate,-15;
            bonus bDelayrate,-15;
         }
      }
      if (.@g>=ENCHANTGRADE_D) {
         bonus bAtkRate,5;
         bonus bBaseAtk,75;
         if (.@g>=ENCHANTGRADE_C) {
            bonus bPAtk,4*(.@r/3);
            if (.@g>=ENCHANTGRADE_B) {
               bonus bPow,(.@r/2);
               bonus bCon,(.@r/2);
               if (.@g>=ENCHANTGRADE_A) {
                  bonus2 bAddEle,Ele_All,18;
                  if (.@r>=11) {
                     bonus2 bAddSize,Size_All,18;
                  }
               }
            }
         }
      }

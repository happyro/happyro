  - Id: 24685
    AegisName: S_Absorb_Shield
    Name: Absorb Shadow Shield
    Type: ShadowGear
    Locations:
      Shadow_Shield: true
    Refineable: true
    Script: |
      .@r = getrefine();
      bonus bMaxHP,.@r*10;
      bonus bMaxHPrate,3;
      bonus bMaxSPrate,3;
      bonus bAtkRate,(.@r/3);
      if (.@r>=7) {
         bonus bVariableCastrate,-3;
         if (.@r>=10) {
            bonus2 bHPDrainRate,20,2;
            bonus2 bSPDrainRate,10,2;
         }
      }

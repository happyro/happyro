    Script: |
      .@g = getenchantgrade();
      bonus bCritical,5;
      bonus2 bSkillAtk,"SHC_CROSS_SLASH",15;
      if (.@g>=ENCHANTGRADE_D) {
         bonus bPAtk,5;
         if (.@g>=ENCHANTGRADE_C) {
            bonus2 bSkillAtk,"SHC_CROSS_SLASH",15;
            if (.@g>=ENCHANTGRADE_B) {
               bonus bShortAtkRate,10;
               if (.@g>=ENCHANTGRADE_A) {
                  bonus bPAtk,3*(getrefine()/2);
               }
            }
         }
      }

    Script: |
      .@g = getenchantgrade();
      .@r = getrefine();
      bonus bSMatk,5;
      bonus2 bSkillAtk,"ABC_FROM_THE_ABYSS_ATK",5+5*(.@r/3);
      bonus bMatkRate,(.@r/2);

    Script: |
      .@r = getequiprefinerycnt(EQI_HAND_R);
      .@a = readparam(bStr)/10;
      .@b = readparam(bAgi)/10;
      .@c = readparam(bVit)/10;
      .@d = readparam(bInt)/10;
      .@e = readparam(bDex)/10;
      .@f = readparam(bLuk)/10;
      bonus bAtkRate,.@a;
      bonus bBaseAtk,.@r*20;
      bonus bAspdRate,.@b;
      bonus bMaxHPrate,.@c;
      bonus bMatk,.@d+(.@r*20);
      bonus bVariableCastrate,-.@e;
      bonus bCritical,.@f;

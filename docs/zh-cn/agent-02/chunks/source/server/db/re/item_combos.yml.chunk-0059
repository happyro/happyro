         .@r_left = .@r_shield/2;
      }
      if (getequipid(EQI_HAND_R) == 510066) {
         .@r_right = .@r_weapon/2;
      }
      if (getequipid(EQI_HAND_L) == 510066 && getequipid(EQI_HAND_R) == 510066) {
         .@val = 14;

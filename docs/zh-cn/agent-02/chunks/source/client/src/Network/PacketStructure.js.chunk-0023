};
PACKET.CZ.CLAN_CHAT.prototype.build = function () {
	const pkt_len = 2 + 2 + this.msg.length + 1;
	const pkt_buf = new BinaryWriter(pkt_len);

	pkt_buf.writeShort(0x98d);

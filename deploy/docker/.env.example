COMPOSE_PROJECT_NAME=happyro
RELEASE_VERSION=@VERSION@
GATEWAY_IMAGE=docker.io/kugarocks/happyro-gateway:@VERSION@
SERVER_IMAGE=docker.io/kugarocks/happyro-server:@VERSION@
API_IMAGE=docker.io/kugarocks/happyro-api:@VERSION@
DATABASE_IMAGE=docker.io/kugarocks/happyro-database:@VERSION@
RESOURCE_DIR=./resources
DATA_DIR=./data
CUSTOM_DIR=./custom
GAME_PUBLIC_URL=http://127.0.0.1:3338
ADMIN_PUBLIC_URL=http://127.0.0.1:8000
SOCKET_PROXY_URL=
GATEWAY_PORT=3338
ADMIN_PORT=8000
ADMIN_INITIAL_USERNAME=admin
ADMIN_INITIAL_PASSWORD=admin
SHOW_DEFAULT_CREDENTIALS=false
SESSION_SECURE_COOKIE=false
DB_PASSWORD=
ADMIN_DB_PASSWORD=
MARIADB_ROOT_PASSWORD=
INTERSERVER_PASSWORD=
GAME_CONTROL_TOKEN=

# Client defaults (empty = use the defaults shipped with the PWA).
# camera.desktopZoom; default: 125
CLIENT_CAMERA_DESKTOP_ZOOM=
# camera.phoneLandscapeZoom; default: 95
CLIENT_CAMERA_PHONE_LANDSCAPE_ZOOM=
# camera.phonePortraitZoom; default: 170
CLIENT_CAMERA_PHONE_PORTRAIT_ZOOM=
# camera.tabletLandscapeZoom; default: 125
CLIENT_CAMERA_TABLET_LANDSCAPE_ZOOM=
# camera.tabletPortraitZoom; default: 155
CLIENT_CAMERA_TABLET_PORTRAIT_ZOOM=
# camera.smooth; default: true
CLIENT_CAMERA_SMOOTH=
# autoCombat.ranges.search; default: 20
CLIENT_AUTO_COMBAT_SEARCH_RANGE=
# autoCombat.ranges.activity; default: 30
CLIENT_AUTO_COMBAT_ACTIVITY_RANGE=
# autoCombat.teleport.enabled; default: true
CLIENT_AUTO_TELEPORT_ENABLED=
# autoCombat.teleport.waitSeconds; default: 2
CLIENT_AUTO_TELEPORT_WAIT_SECONDS=
# autoCombat.teleport.intervalSeconds; default: 2
CLIENT_AUTO_TELEPORT_INTERVAL_SECONDS=
# pickup.enabled; default: false
CLIENT_AUTO_PICKUP_ENABLED=
# pickup.range; default: 5
CLIENT_AUTO_PICKUP_RANGE=
# pickup.batchSeconds; default: 5
CLIENT_AUTO_PICKUP_BATCH_SECONDS=
# pickup.categories; default: equipment,consumable,card,other
CLIENT_AUTO_PICKUP_CATEGORIES=
# graphics.quality; default: 100
CLIENT_GRAPHICS_QUALITY=
# graphics.fpslimit; default: 60
CLIENT_GRAPHICS_FPS_LIMIT=
# graphics.performanceMode; default: false
CLIENT_GRAPHICS_PERFORMANCE_MODE=
# graphics.viewArea; default: 14
CLIENT_GRAPHICS_VIEW_AREA=
# graphics.cursor; default: true
CLIENT_GRAPHICS_CURSOR=
# graphics.pixelPerfectSprites; default: false
CLIENT_GRAPHICS_PIXEL_PERFECT_SPRITES=
# graphics.bloom; default: false
CLIENT_GRAPHICS_BLOOM_ENABLED=
# graphics.blur; default: false
CLIENT_GRAPHICS_BLUR_ENABLED=
# graphics.fxaaEnabled; default: false
CLIENT_GRAPHICS_FXAA_ENABLED=
# graphics.vibranceEnabled; default: false
CLIENT_GRAPHICS_VIBRANCE_ENABLED=
# graphics.cartoonEnabled; default: false
CLIENT_GRAPHICS_CARTOON_ENABLED=
# graphics.casEnabled; default: false
CLIENT_GRAPHICS_CAS_ENABLED=
# graphics.bloomIntensity; default: 0.5
CLIENT_GRAPHICS_BLOOM_INTENSITY=
# graphics.blurArea; default: 14
CLIENT_GRAPHICS_BLUR_AREA=
# graphics.blurIntensity; default: 3
CLIENT_GRAPHICS_BLUR_INTENSITY=
# graphics.fxaaEdgeThreshold; default: 0.125
CLIENT_GRAPHICS_FXAA_EDGE_THRESHOLD=
# graphics.vibrance; default: 0.15
CLIENT_GRAPHICS_VIBRANCE=
# graphics.cartoonPower; default: 1.5
CLIENT_GRAPHICS_CARTOON_POWER=
# graphics.cartoonEdgeSlope; default: 1.5
CLIENT_GRAPHICS_CARTOON_EDGE_SLOPE=
# graphics.casContrast; default: 0
CLIENT_GRAPHICS_CAS_CONTRAST=
# graphics.casSharpening; default: 1
CLIENT_GRAPHICS_CAS_SHARPENING=
# audio.BGM.play; default: true
CLIENT_BGM_ENABLED=
# audio.BGM.volume; default: 0.5
CLIENT_BGM_VOLUME=
# audio.Sound.play; default: true
CLIENT_SOUND_ENABLED=
# audio.Sound.volume; default: 0.5
CLIENT_SOUND_VOLUME=
# interface.toastDuration; default: 2
CLIENT_TOAST_DURATION_SECONDS=
# interface.chatPreviewCompactLines; default: 3
CLIENT_CHAT_PREVIEW_COMPACT_LINES=
# interface.chatPreviewSpaciousLines; default: 5
CLIENT_CHAT_PREVIEW_SPACIOUS_LINES=
# interface.chatPreviewTabs; default: true
CLIENT_CHAT_PREVIEW_TABS=
# map.fog; default: false
CLIENT_MAP_FOG=
# map.lightmap; default: true
CLIENT_MAP_LIGHTMAP=
# map.effect; default: true
CLIENT_MAP_EFFECTS=
# map.mineffect; default: false
CLIENT_MAP_MIN_EFFECTS=
# map.miss; default: true
CLIENT_MAP_SHOW_MISS=
# map.showname; default: true
CLIENT_MAP_SHOW_NAME_STYLE=
# map.smoothlight; default: 0
CLIENT_MAP_SMOOTH_LIGHT=
# map.aura; default: 1
CLIENT_MAP_AURA=

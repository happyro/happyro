HAPPYRO_GATEWAY_LISTEN_PORT=3338
HAPPYRO_GAME_PUBLIC_URL=http://127.0.0.1:3338
# Keep empty to use the current page origin and its /ws/ endpoint.
HAPPYRO_CLIENT_RESOURCE_URL=
HAPPYRO_CLIENT_SOCKET_PROXY_URL=
NODE_ENV=development

# Optional same-origin browser diagnostics receiver; empty disables uploads.
# HAPPYRO_GATEWAY_CLIENT_DIAGNOSTICS_DIR=../../work/diagnostics/client

HAPPYRO_GATEWAY_CACHE_MAX_FILES=5000
HAPPYRO_GATEWAY_CACHE_MAX_MEMORY_MB=1024
HAPPYRO_GATEWAY_CACHE_WARMUP_ENABLED=true
HAPPYRO_GATEWAY_CACHE_WARMUP_MAX_FILES=500

HAPPYRO_GATEWAY_WS_PROXY_ENABLED=true
HAPPYRO_GATEWAY_STATIC_SERVE_ENABLED=true
HAPPYRO_GATEWAY_PWA_DIR=../../repos/happyro-client/dist/Web
HAPPYRO_GATEWAY_PWA_PUBLIC_PATH=/applications/pwa
HAPPYRO_GATEWAY_WS_ALLOWED_TARGETS=127.0.0.1:6900,127.0.0.1:6121,127.0.0.1:5121
HAPPYRO_GATEWAY_GAME_WEB_UPSTREAM_URL=http://127.0.0.1:8889

HAPPYRO_GATEWAY_ESRGAN_ENABLED=false

HAPPYRO_GATEWAY_RESOURCE_OVERRIDE_DIRS=../../inputs/runtime/kro-20211105/client:../../inputs/runtime/kro-20211105/client/data:../../localization/client/data

# Client defaults (empty = use the defaults shipped with the PWA).
# camera.desktopZoom; default: 125
HAPPYRO_CLIENT_DEFAULT_CAMERA_DESKTOP_ZOOM=
# camera.phoneLandscapeZoom; default: 95
HAPPYRO_CLIENT_DEFAULT_CAMERA_PHONE_LANDSCAPE_ZOOM=
# camera.phonePortraitZoom; default: 170
HAPPYRO_CLIENT_DEFAULT_CAMERA_PHONE_PORTRAIT_ZOOM=
# camera.tabletLandscapeZoom; default: 125
HAPPYRO_CLIENT_DEFAULT_CAMERA_TABLET_LANDSCAPE_ZOOM=
# camera.tabletPortraitZoom; default: 155
HAPPYRO_CLIENT_DEFAULT_CAMERA_TABLET_PORTRAIT_ZOOM=
# camera.smooth; default: true
HAPPYRO_CLIENT_DEFAULT_CAMERA_SMOOTH_ENABLED=
# autoCombat.ranges.search; default: 14
HAPPYRO_CLIENT_DEFAULT_AUTO_COMBAT_SEARCH_RANGE=
# autoCombat.ranges.activity; default: 30
HAPPYRO_CLIENT_DEFAULT_AUTO_COMBAT_ACTIVITY_RANGE=
# autoCombat.teleport.enabled; default: true
HAPPYRO_CLIENT_DEFAULT_AUTO_TELEPORT_ENABLED=
# autoCombat.teleport.waitSeconds; default: 2
HAPPYRO_CLIENT_DEFAULT_AUTO_TELEPORT_WAIT_SECONDS=
# autoCombat.teleport.intervalSeconds; default: 2
HAPPYRO_CLIENT_DEFAULT_AUTO_TELEPORT_INTERVAL_SECONDS=
# pickup.enabled; default: false
HAPPYRO_CLIENT_DEFAULT_AUTO_RECOVERY_HP_TRIGGER_PERCENT=
HAPPYRO_CLIENT_DEFAULT_AUTO_RECOVERY_HP_TARGET_PERCENT=
HAPPYRO_CLIENT_DEFAULT_AUTO_RECOVERY_SP_TRIGGER_PERCENT=
HAPPYRO_CLIENT_DEFAULT_AUTO_RECOVERY_SP_TARGET_PERCENT=
HAPPYRO_CLIENT_DEFAULT_AUTO_PICKUP_ENABLED=
# pickup.range; default: 5
HAPPYRO_CLIENT_DEFAULT_AUTO_PICKUP_RANGE=
# pickup.batchSeconds; default: 5
HAPPYRO_CLIENT_DEFAULT_AUTO_PICKUP_BATCH_SECONDS=
# pickup.categories; default: equipment,consumable,card,other
HAPPYRO_CLIENT_DEFAULT_AUTO_PICKUP_CATEGORIES=
# graphics.quality; default: 100
HAPPYRO_CLIENT_DEFAULT_GRAPHICS_QUALITY=
# graphics.fpslimit; default: 60
HAPPYRO_CLIENT_DEFAULT_GRAPHICS_FPS_LIMIT=
# graphics.performanceMode; default: false
HAPPYRO_CLIENT_DEFAULT_GRAPHICS_PERFORMANCE_MODE_ENABLED=
# graphics.viewArea; default: 14
HAPPYRO_CLIENT_DEFAULT_GRAPHICS_VIEW_AREA=
# graphics.cursor; default: true
HAPPYRO_CLIENT_DEFAULT_GRAPHICS_CURSOR_ENABLED=
# graphics.pixelPerfectSprites; default: false
HAPPYRO_CLIENT_DEFAULT_GRAPHICS_PIXEL_PERFECT_SPRITES_ENABLED=
# graphics.bloom; default: false
HAPPYRO_CLIENT_DEFAULT_GRAPHICS_BLOOM_ENABLED=
# graphics.blur; default: false
HAPPYRO_CLIENT_DEFAULT_GRAPHICS_BLUR_ENABLED=
# graphics.fxaaEnabled; default: false
HAPPYRO_CLIENT_DEFAULT_GRAPHICS_FXAA_ENABLED=
# graphics.vibranceEnabled; default: false
HAPPYRO_CLIENT_DEFAULT_GRAPHICS_VIBRANCE_ENABLED=
# graphics.cartoonEnabled; default: false
HAPPYRO_CLIENT_DEFAULT_GRAPHICS_CARTOON_ENABLED=
# graphics.casEnabled; default: false
HAPPYRO_CLIENT_DEFAULT_GRAPHICS_CAS_ENABLED=
# graphics.bloomIntensity; default: 0.5
HAPPYRO_CLIENT_DEFAULT_GRAPHICS_BLOOM_INTENSITY=
# graphics.blurArea; default: 14
HAPPYRO_CLIENT_DEFAULT_GRAPHICS_BLUR_AREA=
# graphics.blurIntensity; default: 3
HAPPYRO_CLIENT_DEFAULT_GRAPHICS_BLUR_INTENSITY=
# graphics.fxaaEdgeThreshold; default: 0.125
HAPPYRO_CLIENT_DEFAULT_GRAPHICS_FXAA_EDGE_THRESHOLD=
# graphics.vibrance; default: 0.15
HAPPYRO_CLIENT_DEFAULT_GRAPHICS_VIBRANCE=
# graphics.cartoonPower; default: 1.5
HAPPYRO_CLIENT_DEFAULT_GRAPHICS_CARTOON_POWER=
# graphics.cartoonEdgeSlope; default: 1.5
HAPPYRO_CLIENT_DEFAULT_GRAPHICS_CARTOON_EDGE_SLOPE=
# graphics.casContrast; default: 0
HAPPYRO_CLIENT_DEFAULT_GRAPHICS_CAS_CONTRAST=
# graphics.casSharpening; default: 1
HAPPYRO_CLIENT_DEFAULT_GRAPHICS_CAS_SHARPENING=
# audio.BGM.play; default: true
HAPPYRO_CLIENT_DEFAULT_BGM_ENABLED=
# audio.BGM.volume; default: 0.5
HAPPYRO_CLIENT_DEFAULT_BGM_VOLUME=
# audio.Sound.play; default: true
HAPPYRO_CLIENT_DEFAULT_SOUND_ENABLED=
# audio.Sound.volume; default: 0.5
HAPPYRO_CLIENT_DEFAULT_SOUND_VOLUME=
# interface.toastDuration; default: 2
HAPPYRO_CLIENT_DEFAULT_TOAST_DURATION_SECONDS=
# interface.chatPreviewCompactLines; default: 3
HAPPYRO_CLIENT_DEFAULT_CHAT_PREVIEW_COMPACT_LINES=
# interface.chatPreviewSpaciousLines; default: 5
HAPPYRO_CLIENT_DEFAULT_CHAT_PREVIEW_SPACIOUS_LINES=
# interface.chatPreviewTabs; default: true
HAPPYRO_CLIENT_DEFAULT_CHAT_PREVIEW_TABS_ENABLED=
# map.fog; default: false
HAPPYRO_CLIENT_DEFAULT_MAP_FOG_ENABLED=
# map.lightmap; default: true
HAPPYRO_CLIENT_DEFAULT_MAP_LIGHTMAP_ENABLED=
# map.effect; default: true
HAPPYRO_CLIENT_DEFAULT_MAP_EFFECTS_ENABLED=
# map.mineffect; default: false
HAPPYRO_CLIENT_DEFAULT_MAP_MIN_EFFECTS_ENABLED=
# map.miss; default: true
HAPPYRO_CLIENT_DEFAULT_MAP_SHOW_MISS_ENABLED=
# map.showname; default: true
HAPPYRO_CLIENT_DEFAULT_MAP_NAME_STYLE_ENABLED=
# map.smoothlight; default: 0
HAPPYRO_CLIENT_DEFAULT_MAP_SMOOTH_LIGHT_MODE=
# map.aura; default: 1
HAPPYRO_CLIENT_DEFAULT_MAP_AURA_MODE=

# Script text contrast target: 4.5-7; default: 4.5. Correction is always enabled.
HAPPYRO_CLIENT_DEFAULT_SCRIPT_TEXT_MIN_CONTRAST=

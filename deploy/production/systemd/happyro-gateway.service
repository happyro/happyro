[Unit]
Description=HappyRO web gateway
After=happyro-map.service happyro-web-api.service
Requires=happyro-map.service happyro-web-api.service

[Service]
WorkingDirectory=/opt/happyro-demo/current/gateway
EnvironmentFile=/etc/happyro/gateway.env
Environment=PATH=/root/.nvm/versions/node/v22.14.0/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin
ExecStart=/root/.nvm/versions/node/v22.14.0/bin/node start-prod.js
Restart=on-failure
RestartSec=3
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target

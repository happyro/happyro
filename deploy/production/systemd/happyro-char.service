[Unit]
Description=HappyRO character server
After=happyro-login.service
Requires=happyro-login.service

[Service]
WorkingDirectory=/opt/happyro-demo/current/rathena
ExecStart=/opt/happyro-demo/current/rathena/char-server
Restart=on-failure
RestartSec=3
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target

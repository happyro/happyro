SERVER_LAN_IP=127.0.0.1
LOGIN_PORT=6900
CHAR_PORT=6121
MAP_PORT=5121
WEB_BIND_IP=127.0.0.1
WEB_PORT=8889
WEB_ALLOWED_ORIGIN=http://127.0.0.1:3338

# Map-server overrides (empty uses battle configuration). Defaults: 18 / 17.
HAPPYRO_AREA_SIZE=
HAPPYRO_MAX_WALK_PATH=

# Gameplay deployment overrides: empty keeps battle file / admin settings.
# 导航传送权限; default 2; range 0-2
HAPPYRO_NAVIGATION_TELEPORT_POLICY=
# 导航跨地图传送; default 1; range 0-1
HAPPYRO_NAVIGATION_TELEPORT_CROSS_MAP=
# 导航传送冷却（秒）; default 1; range 0-3600
HAPPYRO_NAVIGATION_TELEPORT_COOLDOWN=
# 图鉴召怪权限; default 2; range 0-2
HAPPYRO_GAME_TOOLS_MONSTER_SPAWN_POLICY=
# 召怪冷却（秒）; default 1; range 0-3600
HAPPYRO_GAME_TOOLS_MONSTER_SPAWN_COOLDOWN=
# 召怪存活时间（秒）; default 600; range 1-3600
HAPPYRO_GAME_TOOLS_MONSTER_SPAWN_DURATION=
# 允许召唤 Boss / MVP; default 1; range 0-1
HAPPYRO_GAME_TOOLS_MONSTER_SPAWN_ALLOW_BOSS=
# 角色维护权限; default 2; range 1-2
HAPPYRO_GAME_TOOLS_CHARACTER_MAINTENANCE_POLICY=
# 游戏设置工具权限; default 2; range 1-2
HAPPYRO_GAME_TOOLS_GAME_SETTINGS_POLICY=
# 物品发放权限; default 2; range 1-2
HAPPYRO_GAME_TOOLS_ITEM_GRANT_POLICY=

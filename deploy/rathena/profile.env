HAPPYRO_SERVER_PUBLIC_HOST=127.0.0.1
HAPPYRO_SERVER_LOGIN_PORT=6900
HAPPYRO_SERVER_CHAR_PORT=6121
HAPPYRO_SERVER_MAP_PORT=5121
HAPPYRO_SERVER_WEB_LISTEN_HOST=127.0.0.1
HAPPYRO_SERVER_WEB_PORT=8889
HAPPYRO_GAME_PUBLIC_URL=http://127.0.0.1:3338

# Human character creation: classic (default) or ship.
HAPPYRO_CHARACTER_START_MODE=classic

# Map-server overrides (empty uses battle configuration). Defaults: 14 / 17.
HAPPYRO_GAME_ENTITY_SYNC_RANGE_CELLS=
HAPPYRO_GAME_MAX_WALK_PATH_CELLS=

# Gameplay deployment overrides: empty keeps battle file / admin settings.
# 导航传送权限; default 2; range 0-2
HAPPYRO_GAME_NAVIGATION_TELEPORT_POLICY=
# 导航跨地图传送; default 1; range 0-1
HAPPYRO_GAME_NAVIGATION_TELEPORT_CROSS_MAP_ENABLED=
# 导航传送冷却（秒）; default 1; range 0-3600
HAPPYRO_GAME_NAVIGATION_TELEPORT_COOLDOWN_SECONDS=
# 图鉴召怪权限; default 2; range 0-2
HAPPYRO_GAME_TOOLS_MONSTER_SPAWN_POLICY=
# 召怪冷却（秒）; default 1; range 0-3600
HAPPYRO_GAME_TOOLS_MONSTER_SPAWN_COOLDOWN_SECONDS=
# 召怪存活时间（秒）; default 600; range 1-3600
HAPPYRO_GAME_TOOLS_MONSTER_SPAWN_DURATION_SECONDS=
# 允许召唤 Boss / MVP; default 1; range 0-1
HAPPYRO_GAME_TOOLS_MONSTER_SPAWN_ALLOW_BOSS_ENABLED=
# 角色维护权限; default 2; range 1-2
HAPPYRO_GAME_TOOLS_CHARACTER_MAINTENANCE_POLICY=
# 游戏设置工具权限; default 2; range 1-2
HAPPYRO_GAME_TOOLS_GAME_SETTINGS_POLICY=
# 物品发放权限; default 2; range 1-2
HAPPYRO_GAME_TOOLS_ITEM_GRANT_POLICY=

# Game deployment overrides: empty preserves saved settings; rates use 100 = 1x.
HAPPYRO_GAME_BASE_EXP_RATE_PERCENT=
HAPPYRO_GAME_JOB_EXP_RATE_PERCENT=
HAPPYRO_GAME_ITEM_RATE_COMMON_PERCENT=
HAPPYRO_GAME_ITEM_RATE_COMMON_BOSS_PERCENT=
HAPPYRO_GAME_ITEM_RATE_COMMON_MVP_PERCENT=
HAPPYRO_GAME_ITEM_RATE_HEAL_PERCENT=
HAPPYRO_GAME_ITEM_RATE_HEAL_BOSS_PERCENT=
HAPPYRO_GAME_ITEM_RATE_HEAL_MVP_PERCENT=
HAPPYRO_GAME_ITEM_RATE_USE_PERCENT=
HAPPYRO_GAME_ITEM_RATE_USE_BOSS_PERCENT=
HAPPYRO_GAME_ITEM_RATE_USE_MVP_PERCENT=
HAPPYRO_GAME_ITEM_RATE_EQUIP_PERCENT=
HAPPYRO_GAME_ITEM_RATE_EQUIP_BOSS_PERCENT=
HAPPYRO_GAME_ITEM_RATE_EQUIP_MVP_PERCENT=
HAPPYRO_GAME_ITEM_RATE_CARD_PERCENT=
HAPPYRO_GAME_ITEM_RATE_CARD_BOSS_PERCENT=
HAPPYRO_GAME_ITEM_RATE_CARD_MVP_PERCENT=
HAPPYRO_GAME_REFINE_CHANCE_RATE_PERCENT=
HAPPYRO_GAME_GRADE_CHANCE_RATE_PERCENT=
HAPPYRO_GAME_REFINE_ALWAYS_SUCCESS_ENABLED=
HAPPYRO_GAME_GRADE_ALWAYS_SUCCESS_ENABLED=
HAPPYRO_GAME_NAVIGATION_MAP_CHANNELS_ENABLED=

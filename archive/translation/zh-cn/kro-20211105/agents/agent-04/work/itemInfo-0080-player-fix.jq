  | gsub("건너계열";"枪手系列")
  | gsub("헌터 계열";"猎人系列")
  | gsub("레인저 / 暗影追踪者系列";"游侠/暗影追踪者系列")
  | gsub("궁수 계열";"弓箭手系列")
  | gsub("등급";"等级")
  | gsub("풍";"风")

  | gsub("증가";"增加")
  | gsub("추가";"额外")
  | gsub("15당";"每 15 个 Base 等级，")
  | gsub("1%씩";"+ 1%")
  | gsub("최대 180레벨까지 적용";"最高适用至 180 级")

  | gsub("쉐도우 체이서 계열";"暗影追踪者系列")
  | gsub("궁수 계열, 로그 계열";"弓箭手系列、盗贼系列")
  | gsub("상인 계열";"商人系列")
  | gsub("길로틴크로스 계열";"十字斩首者系列")
  | gsub("신키로, 시라누이";"神枪手、胧")
  | gsub("카게로우계열, 오보로계열";"影狼系列、胧系列")

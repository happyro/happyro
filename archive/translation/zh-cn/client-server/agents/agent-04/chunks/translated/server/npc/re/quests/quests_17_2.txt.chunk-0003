		mes "[Mansion Manager α]";
		mes "虽然不多，但作为感谢我把这个给你。";
		mes "这是^0000CD巴梅尔餐券^000000，可以在宅邸餐厅使用。";
		mes "可以随意享用食物，随时使用。";
		next;
		mes "[Mansion Manager α]";
		mes "宅邸的<NAVI>[餐厅]<INFO>ba_maison,146,109,0,101,0</INFO></NAVI>就在下面，正如我之前展示的。";
		next;
		cutin "",255;
		select( "你见过我的队伍吗？" );
		cutin "ep172_alpha",2;
		mes "[Mansion Manager α]";
		mes "先你而来的客人现在住在<NAVI>[茶馆]<INFO>ba_in01,206,106,0,101,0</INFO></NAVI>，请四处看看并和他们交谈。";
		next;
		mes "[Mansion Manager α]";
		mes "在宅邸有任何不便，请告诉自动人偶。请收下这张巴梅尔餐券，感谢你的辛劳。";
		ep17_2_main = 15;
		erasequest 17338;
		setquest 17381;
		getitem 1000103,15;
		getexp 900000,0;	// note: ~exp. getbaseexp_ratio?
		close3;
	}
	cutin "ep172_alpha",2;
	mes "[Mansion Manager α]";
	mes "欢迎你，" + strcharinfo(0) + "。";
	next;
	if (ep17_2_main == 15) {
		mes "[Mansion Manager α]";
		mes "先你而来的客人现在住在<NAVI>[茶馆]<INFO>ba_in01,206,106,0,101,0</INFO></NAVI>，请四处看看并和他们交谈。";
		next;
	}
	switch( checkquest(17341,PLAYTIME) ) {
	case -1:
		break;
	case 0:
	case 1:
		mes "[Mansion Manager α]";
		mes "你需要什么，或有什么不便吗？";
		mes "哦，你是来给中继器带备用通信芯片的吗？";
		next;
		mes "[Mansion Manager α]";
		mes "中继器的通信芯片供应充足。";
		mes "不用担心中继器。今天请先休息，^0000CD天亮后^000000再回来。";
		close3;
	case 2:
		mes "[Mansion Manager α]";
		mes "你今天是来帮我获取中继器备用通信芯片的吗？";
		next;
		if (select( "是。", "否。" ) == 2) {
			mes "[Mansion Manager α]";
			mes "既然如此，你是因为使用宅邸设施时遇到不便才来的吗？";
			mes "告诉最近的自动人偶，我们会立即处理。";
			close3;
		}
		mes "[Mansion Manager α]";
		mes "非常感谢你今天的帮助。";
		next;
		mes "[Mansion Manager α]";
		mes "请为中继器带来^0000CD10 个自动人偶通信芯片^000000。我想这足够今天使用。";
		next;
		mes "[Mansion Manager α]";
		mes "这也能帮助我们处理在宅邸里游荡的损坏自动人偶。请处理宅邸中的损坏贝塔，并带回它的通信芯片。";
		next;
		mes "[Mansion Manager α]";
		mes "那么，拜托你了，冒险者。";
		erasequest 17341;
		setquest 17340;
		close3;
	}
	switch( isbegin_quest(17340) ) {
	case 0:
		mes "[Mansion Manager α]";
		mes "你需要什么，或有什么不便吗？";
		next;
		cutin "",255;
		select( "网络运行正常吗？" );
		cutin "ep172_alpha",2;
		mes "[Mansion Manager α]";
		mes "你是为那件事来的吗？非常感谢你的关心。";
		next;
		mes "[Mansion Manager α]";
		mes "和之前的情况一样，宅邸某些区域的网络连接正在丢失。";
		next;
		mes "[Mansion Manager α]";
		mes "虽然发现后会修复，但问题不断发生，所需通信芯片很难供应。";
		next;
		mes "[Mansion Manager α]";
		mes "此外，损坏的自动人偶四处游荡并不断破坏中继器，使所需供应量翻倍。";
		next;
		cutin "",255;
		if (select( "我能帮忙吗？", "哦，那一定很难。" ) == 2) {
			mes "[Mansion Manager α]";
			mes "感谢你体谅这些困难。我们会尽快处理中继器，避免使用时出现不便。";
			close;
		}
		cutin "ep172_alpha",2;
		mes "[Mansion Manager α]";
		mes "非常感谢。但恐怕占用了你太多时间，" + strcharinfo(0) + "……如果你不介意，我想请你帮个忙。";
		next;
		mes "[Mansion Manager α]";
		mes "请为中继器带来^0000CD10 个自动人偶通信芯片^000000。我想这足够今天使用。";
		next;
		mes "[Mansion Manager α]";
		mes "这也能帮助我们处理宅邸里游荡的损坏自动人偶。请处理损坏贝塔并带回它的通信芯片。";
		next;
		mes "[Mansion Manager α]";
		mes "那么，拜托你了，冒险者。";
		setquest 17340;
		close3;
	case 1:
		cutin "ep172_alpha",2;
		mes "[Mansion Manager α]";
		mes "你带来我要求的自动人偶通信芯片了吗？";
		next;
		if (countitem(1000232) < 10) {
			mes "[Mansion Manager α]";
			mes "请为中继器带来^0000CD10 个自动人偶通信芯片^000000。我想这足够今天使用。";
			next;
			mes "[Mansion Manager α]";
			mes "这也能帮助我们处理宅邸里游荡的损坏自动人偶。请处理损坏贝塔并带回它的通信芯片。";
			close3;
		}
		mes "[Mansion Manager α]";
		mes "今天这些就够了。感谢你的辛劳。";
		mes "如果你有时间，^0000CD天亮后^000000我想再次请求你的帮助；如果不介意，请明天再来。";
		next;
		mes "[Mansion Manager α]";
		mes "非常感谢。请带上这个。";
		erasequest 17340;
		setquest 17341;
		delitem 1000232,10;
		getitem 1000103,2;
		getexp 949720,664800;
		close3;
	}
	end;

OnInit:
	// main quest
	questinfo( QTYPE_QUEST2, QMARK_YELLOW, "ep17_2_main == 8" );
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "isbegin_quest(17333) == 1" );
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "isbegin_quest(17338) == 1" );

	// daily quest
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "ep17_2_main >= 15 && checkquest(17341,PLAYTIME) == -1 && isbegin_quest(17340) == 0" );
	questinfo( QTYPE_DAILYQUEST, QMARK_YELLOW, "checkquest(17341,PLAYTIME) == 2" );
	questinfo( QTYPE_QUEST2, QMARK_YELLOW, "isbegin_quest(17340) == 1 && countitem(1000232) >= 10" );
	end;
}

ba_maison,72,151,5	script(CLOAKED)	Tommy#172nw01	4_M_GUNSLINGER2,{
	mes "[Tommy]";
	mes "这座宅邸真大。我其实很喜欢这里。";
	mes "我甚至不知道还有这样的地方。";
	close;
}

ba_maison,70,150,5	script(CLOAKED)	Meimei#172nw01	4_F_REBELLION3,{
	mes "[Meimei]";
	mes "原来你在这里。那些佣兵……";
	close;
}

ba_maison,146,109,5	script	Tasty#172nw01	4_EP17_BASIC_B,{
	if (checkweight(1000103,5) == 0) {
		mes "你携带的物品太多，无法继续对话。";
		mes "请清理背包后再试。";
		close;
	}
	if (ep17_2_main == 10) {
		mes "[Tasty]";
		mes "呃！等等，那是什么？啧，入侵者？";
		emotion ET_HUK;
		next;
		mes "[Tasty]";
		mes "没错！没错！哦，我该怎么办？怎么办，怎么办？警卫？哦，对了，我被告知要呼叫警卫。";
		npctalk "来这里，警卫，警卫……", "", bc_self;
		progressbar_npc "00FF00",2;
		next;
		sleep2 1150;
		mes "[Tasty]";
		mes "什么？不起作用！什么时候坏的？哦，我该怎么办？";
		emotion ET_HUK;
		next;
		mes "[Tasty]";
		mes "对了！麻糬！我给你一块麻糬，我们去别的地方吧？你喜欢麻糬，对吧？";
		next;
		emotion ET_QUESTION, getcharid(3);
		select( "..." );
		mes "[Tasty]";
		mes "哦，不是麻糬？你不是我以前见过的人吗？那肉呢？你喜欢肉吗？你喜欢肉，对吧？我没见过不喜欢肉的人。我把所有的肉都给你。";
		next;
		emotion ET_SWEAT, getcharid(3);
		select( "......" );
		mes "[Tasty]";
		mes "奇怪？不是肉？那我能给你什么？你想回去吗？";
		emotion ET_QUESTION;
		next;
		mes "[Tasty]";
		mes "哦，我该怎么办？有人告诉我不要跑向入侵者。你是来^0000CD取走我的部件^000000的吗？这就是我的末日吗？";
		next;
		emotion ET_SWEAT, getcharid(3);
		select( "我不是那种人。" );
		mes "[Tasty]";
		mes "你不是那种人……？那你是什么样的人？";
		next;
		mes "[Tasty]";
		mes "等等……你是认真的吗？你没有流口水，眼睛也很正常。你不是^0000CD入侵者^000000？";
		emotion ET_QUESTION;
		next;
		select( "我是宅邸的客人，但是……" );
		mes "[Tasty]";
		mes "什么？客人？等等，我检查一下……";
		emotion ET_HUK;
		progressbar_npc "00FF00",2;
		next;
		mes "[Tasty]";
		mes "真的吗？但是……你是第一次来的客人？新客人？终于来了？哦，很抱歉把你误认为入侵者。";
		emotion ET_SURPRISE;
		next;
		mes "[Tasty]";
		mes "我还以为你是入侵者之一。";
		mes "不知怎么的，大家都说入侵者在逃跑，是因为你们这些新客人，对吧？";
		next;
		mes "[Tasty]";
		mes "你和入侵者是什么关系？我们是天敌吗？金字塔上方是哪边？入侵者在逃跑，所以是你的错？";
		next;
		select( "不是那样的。" );
		mes "[Tasty]";
		mes "哦，真的吗？我太久没见过人类，所以不知道。";
		mes "那我为什么没认出客人？所有新客人的信息应该都会共享给我们。";
		next;
		select( "中继器坏了，所以……" );
		mes "[Tasty]";
		mes "哦，难怪！网络突然停止工作了。中继器失灵了！那 Alpha 为什么还没来？";
		next;
		select( "Alpha 现在很忙。" );
		mes "[Tasty]";
		mes "Alpha 忙得来不了？不可能。哦，你是自愿来帮我的吗？真是特别的客人。说起来，以前也有过这样的^0000CD客人^000000。";
		next;
		mes "[Tasty]";
		mes "对不起。";
		mes "来宅邸的客人对宅邸和我们自动人偶感兴趣，但没有客人帮助过我们。";
		next;
		mes "[Tasty]";
		mes "总之，如果有很多客人，他们很快会来吃饭。我得准备一下。已经很久没有客人了。";
		next;
		mes "[Tasty]";
		mes "餐厅很久没有客人了。我做饭时没有顾客。入侵者……他们来到这里时，我的眼神变了，把他们带走了。他们不是客人。";
		next;
		mes "[Tasty]";
		mes "入侵者没待多久，却在短时间内让宅邸陷入混乱。他们拿走宅邸里的机器和自动人偶，所有看起来有用的东西都被搬走了。";
		next;
		mes "[Tasty]";
		mes "那边的中继器也一定有^0000CD损坏的通信芯片^000000吧？";
		next;
		mes "[Tasty]";
		mes "该死的人类。大多数似乎已经逃走了，但还剩一些。我见过他们几次，他们是冲着食物来的。";
		next;
		mes "[Tasty]";
		mes "再次向你道歉。";
		mes "现在看来，我不知道为什么会把你误认为入侵者。你不一样。";
		next;
		mes "[Tasty]";
		mes "总之，我得修理中继器。让我看看……";
		next;
		mes "[Tasty]";
		mes "嗯……通信芯片被扯掉了！我得装回去。现在该去哪里找？我还要招待客人呢？";
		next;
		cloakoffnpcself( "Strange Automatic Doll#172nw01" );
		npctalk "把他们全烧掉！！！嘿嘿嘿！", "Strange Automatic Doll#172nw01", bc_self;
		specialeffect EF_FIREWALL, AREA, "Strange Automatic Doll#172nw01";
		sleep2 1100;
		mes "[Tasty]";
		mes "呃——那边还有一个坏掉的。";
		next;
		mes "[Tasty]";
		mes "......";
		mes "...... wait?";
		next;
		mes "[Tasty]";
		mes "" + strcharinfo(0) + "。你能抓住它吗？你能做到吗？";
		next;
		select( "损坏的自动人偶？" );
		mes "[Tasty]";
		mes "呃，所有通信芯片都是标准件，换上新的应该就能恢复正常。";
		next;
		select( "呃……" );
		mes "[Tasty]";
		mes "你为什么那副表情？是因为不想在另一个自动人偶面前伤害人偶吗？不用担心。";
		next;
		mes "[Tasty]";
		mes "反正我们需要修理它，但得先抓住它。";
		mes "你可以把这看作替我们自动人偶省事。";
		next;
		mes "[Tasty]";
		mes "如果放着不管，它会在宅邸里游荡并破坏设施，所以你必须尽快处理。";
		mes "最好先抓住它，再取出芯片修理中继器。";
		next;
		mes "[Tasty]";
		mes "自从入侵者出现后，大家一直都这么做。即使" + strcharinfo(0) + "不这样做，也全靠我们自动人偶。";
		mes "稍微工作一下也不错。";
		next;
		ep17_2_main = 11;
		erasequest 17334;
		setquest 17335;
		mes "[Tasty]";
		mes "请处理损坏贝塔并带回^0000CD1 个自动人偶通信芯片^000000。";
		npctalk "花园！我们去花园！！", "Strange Automatic Doll#172nw01", bc_self;
		sleep2 300;
		cloakonnpcself( "Strange Automatic Doll#172nw01" );
		npctalk "哦，它逃跑了！再抓一个损坏的人偶带给我。", "", bc_self;
		close;
	}
	if (ep17_2_main == 11) {
		mes "[Tasty]";
		mes "通信芯片呢？";
		next;
		if (countitem(1000232) < 1) {
			mes "[Tasty]";
			mes "还没有吗？你不忍心伤害自动人偶？别担心，反正我之后会处理。";
			next;
			mes "[Tasty]";
			mes "我会处理损坏的自动人偶，你只要带回^0000CD1 个自动人偶通信芯片^000000。";
			close;
		}
		mes "[Tasty]";
		mes "你带来了吗？交给我。我会修好它。非常感谢你带来。";
		next;
		mes "[Tasty]";
		mes "顺便问一下，那是唯一坏掉的中继器吗？";
		next;
		select( "凉亭和花园……" );
		mes "[Tasty]";
		mes "哦，真的吗？那就先前往<NAVI>[凉亭]<INFO>ba_maison,334,143,0,0,0</INFO></NAVI>。那是这里最近的地方，沿着这条路走即可。";
		next;
		mes "[Tasty]";
		mes "不要随意触碰坏掉的中继器。告诉附近的自动人偶，他们会处理。";
		next;
		mes "[Tasty]";
		mes "你有巴梅尔餐券吗？可以在餐厅用餐。我把这个给你，之后来吃饭吧！我会为你准备美食！作为感谢！";
		delitem 1000232,countitem(1000232);
		ep17_2_main = 12;
		erasequest 17335;
		setquest 17336;
		getitem 1000103,5;
		getexp 300000,0;	// note: ~exp. getbaseexp_ratio?
		close2;
		navigateto("ba_maison",334,143);
		end;
	}
	if (ep17_2_main == 12) {
		mes "[Tasty]";
		mes "先前往<NAVI>[凉亭]<INFO>ba_maison,334,143,0,0,0</INFO></NAVI>。那是这里最近的地方，沿着这条路走即可。";
		next;
		mes "[Tasty]";
		mes "不要随意触碰坏掉的中继器。告诉附近的自动人偶，他们会处理。";
		close;
	}
	mes "[Tasty]";
	mes "今天该做什么呢……怎样才能做得好吃？";
	close;

OnInit:
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "isbegin_quest(17334) == 1" );
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "isbegin_quest(17335) == 1 && countitem(1000232) > 0" );
	end;
}

ba_maison,148,107,3	duplicate(dummy_cloaked_npc)	Strange Automatic Doll#172nw01	4_EP17_BASIC_B_NG

ba_maison,334,143,3	script	Repeater#172nw02	2_POSTBOX,{
	if (checkweight(1000103,5) == 0) {	// (custom)
		mes "^008800等一下！！";
		mes "你携带的物品太多，无法再领取物品。减轻负重后再试。^000000";
		close;
	}
	if (ep17_2_main == 12) {
		mes "[" + strcharinfo(0) + "]";
		mes "这里没人……？我该拿这个怎么办？自动人偶通信芯片又坏了吗……？";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "如果我打开这个……？";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "啊！！！！我的手！！";
		specialeffect2 EF_THUNDERSTORM2;
		specialeffect2 EF_STASIS;
		next;
		cloakoffnpcself( "Worry#172nw01" );
		sleep2 1000;
		specialeffect EF_FIREHIT;
		sleep2 1000;
		specialeffect EF_FIREHIT;
		mes "[Worry]";
		mes "这个……！真是一团糟！又来了！它想战斗。";
		npctalk "这个……！真是一团糟！又来了！它想战斗。", "Worry#172nw01", bc_self;
		next;
		mes "[Worry]";
		mes "现在就滚出我的脑袋！";
		next;
		select( "在那边……" );
		mes "[Worry]";
		mes "你想控制我吗？";
		npctalk "事情不是那样的。", "Worry#172nw01", bc_self;
		next;
		mes "[Worry]";
		mes "这个小东西！我要处理掉它！";
		npctalk "这样下去，我们都会受苦！", "Worry#172nw01", bc_self;
		specialeffect EF_FIREHIT;
		next;
		mes "[Worry]";
		mes "你想夺取我的身体吗？？尽管试试！！";
		specialeffect EF_FIREHIT;
		next;
		select( "我该怎么办？直接走吗？" );
		cloakoffnpcself( "Kimchi#172nw01" );
		mes "[Kimchi]";
		mes "呼——你在这里。你为什么一直逃跑？先冷静一下。";
		npctalk "好。", "Worry#172nw01", bc_self;
		next;
		mes "[Kimchi]";
		mes "总之，你是谁……？入侵者？……不是吗？";
		next;
		mes "[Kimchi]";
		mes "哦，你是客人，对吧？在凉亭前来来往往的人也是客人。";
		next;
		mes "[Kimchi]";
		mes "但这很奇怪。如果你是客人，我应该马上认出你。";
		mes "你不是未登记的客人，而是这里的常客。";
		next;
		select( "因为中继器，他们无法共享信息。" );
		mes "[Kimchi]";
		mes "哦，原来是这样！每次发现有东西坏了我都会修理，但你看，只要我一转眼，Wary 就会出来把它弄坏。";
		next;
		mes "[Kimchi]";
		mes "哦，是我们的鹰咬你了吗？自从它被^0000CD入侵者^000000攻击后就一直这样。我以前修好过，但 Wary 总是出来捣乱……";
		next;
		mes "[Kimchi]";
		mes "有很多人偶都变成了这样。";
		mes "修好后它们会恢复正常，但人偶太多，我们很难全部修理。";
		next;
		mes "[Kimchi]";
		mes "我听说那些鹰在宅邸里游荡并破坏设施。";
		next;
		mes "[Kimchi]";
		mes "抱歉打扰你休息。请尽情享受瓦尔蒙特宅邸的这个区域。";
		next;
		mes "[Worry]";
		mes "这东西怎么会这么有活力。";
		npctalk "你最好开始说话！", "Worry#172nw01", bc_self;
		specialeffect EF_FIREHIT;
		next;
		mes "[Worry]";
		mes "你，到底要不要离开我的脑袋？不走的话我就出去了！";
		next;
		mes "[Kimchi]";
		mes "喂，喂。你为什么要打开中继器？";
		specialeffect EF_FIREHIT, AREA, "Worry#172nw01";
		next;
		select( "哦，你需要赶紧修好它。" );
		mes "[Worry]";
		mes "你到底是什么？你在同情我吗？";
		npctalk "你是他们中的一员吗？", "Worry#172nw01", bc_self;
		next;
		mes "[Kimchi]";
		mes "嘿，这个人不是入侵者，是我们的客人。让他享受宅邸吧。";
		next;
		mes "[Kimchi]";
		mes "我会尽快修好中继器。Wary 肯定会出来破坏它，但别担心，我们可以再次修好。";
		next;
		mes "[Kimchi]";
		mes "谢谢你亲自告诉我。来，至少收下这个。还有其他地方无法工作吗？我想不止一两个地方。";
		emotion ET_OHNO, getnpcid(0,"Kimchi#172nw01");
		next;
		select( "宅邸前的花园。" );
		mes "[Kimchi]";
		mes "哦，那边也无法工作。";
		mes "沿这条路向上走再左转，前往<NAVI>[中央花园]<INFO>ba_maison,245,206,0,0,0</INFO></NAVI>。";
		next;
		mes "[Kimchi]";
		mes "来吧，Warry。我们回去。";
		npctalk "好！", "Worry#172nw01", bc_self;
		sleep2 1000;
		cloakonnpcself( "Worry#172nw01" );
		cloakonnpcself( "Kimchi#172nw01" );
		ep17_2_main = 13;
		erasequest 17336;
		setquest 17337;
		getitem 1000103,5;
		getexp 300000,0;	// note: ~exp. getbaseexp_ratio?
		close;
	}
	if (ep17_2_main == 13) {
		mes "[" + strcharinfo(0) + "]";
		mes "人偶告诉我沿这条路向上走再左转，前往<NAVI>[中央花园]<INFO>ba_maison,245,206,0,0,0</INFO></NAVI>。";
		close;
	}
	npctalk "运行正常。信号强度高。", "", bc_self;

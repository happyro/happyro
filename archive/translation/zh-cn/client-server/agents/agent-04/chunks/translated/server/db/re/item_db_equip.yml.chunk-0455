    Name: 纯爱之心-LT
    Type: Armor
    Weight: 100
    Defense: 20
    Slots: 1
    Locations:
      Both_Accessory: true
    ArmorLevel: 1
    EquipLevelMin: 100
    Script: |
      .@a = (readparam(bStr)/10);
      .@b = (readparam(bInt)/10);
      bonus bMdef,20;
      bonus bVariableCastrate,-10+.@b;
      bonus2 bAddClass,Class_All,10+.@a;
      bonus bMatkRate,10+.@b;
      bonus bAllStats,8;
      bonus2 bAddClass,Class_Normal,10;
      bonus2 bMagicAddClass,Class_Normal,10;
      bonus bDelayrate,-.@a;
      if (BaseJob == Job_Merchant) {
         bonus bShortAtkRate,15;
         bonus bLongAtkRate,15;
         bonus bCritAtkRate,20;
         bonus bPow,5;
         bonus bCrt,5;
         bonus bNoMadoFuel;
      }

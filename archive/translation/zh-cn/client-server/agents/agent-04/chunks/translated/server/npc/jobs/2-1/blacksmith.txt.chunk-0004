				mes "^8E6B23Change Cart^000000 skills?";
				next;
				if (select("Al De Baran:Alberta:Morocc:Izlude") == 2)
					set .@blackss_te,.@blackss_te+20;
				mes "[Mitehmaeeuh]";
				mes "3. From the center of Einbroch,";
				mes "铁匠公会位于哪个方向？";
				next;
				if (select("11 o'clock:5 o'clock:7 o'clock:12 o'clock") == 2)
					set .@blackss_te,.@blackss_te+20;
				mes "[Mitehmaeeuh]";
				mes "4. In which town";
				mes "哪个城镇能找到";
				mes "最多的铁匠？";
				next;
				if (select("Prontera:Morocc:Alberta:Einbroch") == 4)
					set .@blackss_te,.@blackss_te+20;
				mes "[Mitehmaeeuh]";
				mes "5. Which of the";
				mes "以下哪些属性会影响";
				mes "铁匠技能？";
				mes "";
				next;
				if (select("STR :DEX:AGI :VIT ") == 2)
					set .@blackss_te,.@blackss_te+20;
				break;
			}
			mes "[Mitehmaeeuh]";
			mes "啊……";
			mes "你完成了测验。让我看看……";
			mes "";
			next;
			mes "[Mitehmaeeuh]";
			mes "你获得了";
			mes ""+ .@blackss_te +" 分……";
			if (.@blackss_te > 70) {
				mes "非常好！";
				mes "恭喜！";
				mes "你通过了！";
				next;
				mes "[Mitehmaeeuh]";
				mes "不过别因早期成功而自满。铁匠生活并不轻松。作为通过测试的证明，给你这把铁匠之锤。";
				set BSMITH_Q,17;
				getitem 1005,1; //Hammer_Of_Blacksmith
				changequest 2014,2015;
				next;
				mes "[Mitehmaeeuh]";
				mes "带着这把铁匠之锤回去找 Altiregen。祝你好运！";
				mes "";
				close;
			}
			mes "你失败了！好好学习后再回来。";
			next;
			mes "[Mitehmaeeuh]";
			mes "以你现在的知识，拿锤子只会伤到自己！";
			close;
		}
		mes "[Mitehmaeeuh]";
		mes "好吧。准备好后再回来……";
		mes "";
		mes "";
		mes "";
		close;
	}
	else if (BSMITH_Q == 17) {
		emotion ET_SCRATCH;
		mes "[Mitehmaeeuh]";
		mes "没错，你刚通过铁匠职业测试～";
		next;
		mes "[Mitehmaeeuh]";
		mes "回去找 Altiregen 先生吧。";
		next;
		mes "[Mitehmaeeuh]";
		mes "别忘了带上铁匠之锤！";
		next;
		mes "[Mitehmaeeuh]";
		mes "哦，转职前确保没有剩余技能点～";
		close;
	}
	else {
		emotion ET_SCRATCH;
		mes "[Mitehmaeeuh]";
		mes "我在梦罗克时要忍受高温，现在又要忍受艾音布罗克的烟雾！";
		mes "";
		next;
		mes "[Mitehmaeeuh]";
		mes "但我得承认这里很适合铁匠，因为有丰富的制作材料和高度发达的设备。";
		next;
		mes "[Mitehmaeeuh]";
		mes "我们铁匠正努力锻造最好的武器。";
		next;
		mes "[Mitehmaeeuh]";
		mes "我们以荣誉担保！";
		close;
	}
}

geffen_in,109,170,3	script	Blacksmith Guildsman#gef	726,{
	mes "[Blacksmith Guildsman]";
	mes "你好，你是来参观铁匠公会的吗？";
	next;
	mes "[Blacksmith Guildsman]";
	mes "感谢你远道来访。不过很遗憾，铁匠公会已经";
	mes "迁往^3131FF施瓦尔兹瓦德共和国的‘艾音布罗克’^000000。";
	next;
	mes "[Blacksmith Guildsman]";
	mes "你可以乘坐飞空艇前往施瓦尔兹瓦德共和国。";
	mes "我可以把你传送到依斯鲁得，在那里可以乘坐飞空艇。";
	mes "要立即前往依斯鲁得吗？";
	next;
	switch(select("如何前往艾音布罗克:好的！:不用了，谢谢。")) {
	case 1:
		mes "[Blacksmith Guildsman]";
		mes "咦，你还没乘坐过飞空艇吗？";
		next;
		mes "[Blacksmith Guildsman]";
		mes "与卢恩-米德加尔特王国不同，施瓦尔兹瓦德共和国以飞空艇代替传送服务，供人们往返各城市。";
		next;
		mes "[Blacksmith Guildsman]";
		mes "在^3131FF‘依斯鲁得’^000000可以搭乘往返于^3131FF依斯鲁得与施瓦尔兹瓦德共和国朱诺^000000之间的^3131FF国际飞空艇^000000。";
		next;
		mes "[Blacksmith Guildsman]";
		mes "乘飞空艇抵达朱诺后，再从朱诺换乘^3131FF国内飞空艇^000000前往艾音布罗克。";
		mes "请记住，从国际航线转乘国内航线时，^3131FF不需要走出机场^000000。";
		next;
		mes "[Blacksmith Guildsman]";
		mes "听起来可能有些复杂，到了机场自然就会明白。";
		mes "抵达铁匠公会后，请替我向同事们问好！";
		close;
	case 2:
		if (Zeny < 600) {
			mes "[Blacksmith Guildsman]";
			mes "抱歉，你的钱不够。";
			close;
		}
		set Zeny, Zeny-600;
		warp "izlude",94,103;
		end;
	case 3:
		mes "[Blacksmith Guildsman]";
		mes "请多保重！";
		close;
	}
}

			next;
			if (select( "吃掉。", "不用，谢谢。" ) == 2) {
				mes "[Europa]";
				mes "*嗡嗡*……";
				mes "...";
				mes "...";
				close;
			}
			mes "[" + strcharinfo(0) + "]";
			mes "吧唧吧唧……咔嚓咔嚓……摇晃摇晃……";
			next;
			mes "- I've finished all the heap of potato chips that in front of Europa!! -";
			next;
			mes "[Europa]";
			mes "非常感谢。已确认移除生物干扰芯片。";
			mes "通信检查完成。网络连接状况良好。";
			next;
			mes "[Europa]";
			mes "正在重启系统。稍后再和我说话。";
			setquest 3389;
			close;
		case 1:
			mes "[Europa]";
			mes "你好。感谢你处理生物干扰芯片。现在我可以正常与网络通信了。我是 Europa，第二发电厂的管理者。";
			next;
			mes "[Europa]";
			mes "让我告诉你刚才处理的生物芯片。这些芯片是由第二动力工厂中名为^0000CD魔法毒素 Sanare^000000的幻影安装的，唯一用途是干扰无线电波。";
			next;
			mes "[Europa]";
			mes "这种芯片会致命地影响自动人偶的通信能力，如今已严重干扰第二动力工厂的管理。";
			next;
			mes "[Europa]";
			mes "我亲自进入第二动力工厂取回了芯片，但无法处理它们；由于网络故障，情况变得很困难。";
			next;
			mes "[Europa]";
			mes "多亏你处理了芯片，问题才得以解决。" + strcharinfo(0) + "，非常感谢你。";
			next;
			mes "[Europa]";
			mes "刚道完谢就开口请求很抱歉，但事情很紧急，你能帮我一个忙吗？";
			next;
			select( "是什么？" );
			mes "[Europa]";
			mes "正如我所说，幻影^0000CD魔法毒素 Sanare^000000仍在第二动力工厂安装我提到的干扰芯片。这样进去的话，我可能又会发生故障。";
			next;
			mes "[Europa]";
			mes "冒险者，你能进入第二动力工厂，收集 10 个^0000CD薯片^000000吗？";
			next;
			if (select( "接受。", "拒绝。" ) == 2) {
				mes "[Europa]";
				mes "如果继续这样下去，我可能又会故障。我需要你的帮助。";
				close;
			}
			mes "[Europa]";
			mes "最好的办法是消灭^0000CD魔法毒素 Sanare^000000，趁它们安装前收集芯片。";
			next;
			mes "[Europa]";
			mes "请收集 10 个^0000CD薯片^000000。";
			close2;
			erasequest 3389;
			setquest 3390;
			end;
		case 2:
			end;
		}
		end;
	case 1:
		if (countitem(1000225) < 10) {
			mes "[Europa]";
			mes "请收集 10 个薯片带给我。";
			close;
		}
		mes "[Europa]";
		mes "我确认你收集了 10 个薯片。请处理生物芯片。";
		next;
		mes "- 我把所有薯片都吃光了，一片也没剩。 -";
		next;
		mes "[Europa]";
		mes "已确认薯片处理。非常感谢。";
		delitem 1000225,10;
		getitem 1000103,1;
		completequest 3390;
		setquest 3391;
		getexp 11560465,9728632;
		close;
	case 2:
		break;
	}
	switch( checkquest(3391,PLAYTIME) ) {
	case -1:
		break;
	case 0:
	case 1:
		mes "[Europa]";
		mes "你今天收集得够了。一天后再来见我好吗？";
		close;
	case 2:
		erasequest 3391;
		break;
	}
	switch( isbegin_quest(3392) ) {
	case 0:
		mes "[Europa]";
		mes "冒险者，你又来帮我了吗？";
		mes "那么，你能再次从第二动力工厂的^0000CD魔法毒素 Sanare^000000那里收集 10 个^0000CD薯片^000000吗？";
		next;
		if (select( "接受。", "拒绝。" ) == 2) {
			mes "[Europa]";
			mes "如果继续这样下去，我可能又会故障。我需要你的帮助。";
			close;
		}
		mes "[Europa]";
		mes "那么，请收集 10 个^0000CD薯片^000000。";
		setquest 3392;
		close;
	case 1:
		if (countitem(1000225) < 10) {
			mes "[Europa]";
			mes "请收集 10 个薯片带给我。";
			close;
		}
		mes "[Europa]";
		mes "我确认你收集了 10 个薯片。请处理生物芯片。";
		next;
		mes "- 我把所有薯片都吃光了，一片也没剩。 -";
		next;
		mes "[Europa]";
		mes "已确认薯片处理。非常感谢。";
		delitem 1000225,10;
		getitem 1000103,1;
		erasequest 3392;
		setquest 3391;
		getexp 6236863,4365714;
		close;
	}
	end;

OnInit:
	// Starter
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "ep17_2_main >= 9 && BaseLevel >= 180 && isbegin_quest(3389) == 0 && isbegin_quest(3390) == 0" );
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "isbegin_quest(3389) == 1" );
	questinfo( QTYPE_QUEST2, QMARK_YELLOW, "isbegin_quest(3390) == 1 && countitem(1000225) >= 10" );

	// Daily
	questinfo( QTYPE_DAILYQUEST, QMARK_YELLOW, "isbegin_quest(3390) == 2 && isbegin_quest(3392) == 0 && checkquest(3391,PLAYTIME) == -1" );
	questinfo( QTYPE_DAILYQUEST, QMARK_YELLOW, "checkquest(3391,PLAYTIME) == 2" );
	questinfo( QTYPE_QUEST2, QMARK_YELLOW, "isbegin_quest(3392) == 1 && countitem(1000225) >= 10" );
	end;
}


		
// Daily quest and instance : Hey! Sweety
ba_in01,28,255,5	script	Manager Beta Almond#ep172_amd01	4_EP17_BASIC_B,{
	if (checkweight(1000103,4) == 0) {
		mes "你携带的物品太多，无法继续任务。";
		mes "请清理背包后再试。";
		close;
	}
	if (ep17_2_main < 33) {
		cutin "ep172_beta",2;
		mes "[Almond]";
		mes "你好？很高兴再次见到你~";
		mes "谢谢你昨晚照顾我。";
		mes "你从今天开始负责这里吗？我会好好清理。";
		next;
		mes "[Almond]";
		mes "我正在修理 Sweety 损坏的部件，他很擅长把它们弄坏。";
		mes "他经常想战斗，所以你要小心~";
		next;
		mes "[Almond]";
		mes "如果你想进行战斗训练，告诉我就好。";
		mes "我会为你清理。";
		close3;
	}
	if (isbegin_quest(18019) == 0) {
		cutin "ep172_beta",2;
		mes "[Almond]";
		mes "Sweety 醒了。他也许知道些什么。";
		mes "你能和他谈谈吗？";
		setquest 18019;
		close3;
	}
	if (isbegin_quest(18019) == 1) {
		cutin "ep172_beta",2;
		mes "[Almond]";
		mes "Almond 没听懂 Sweety 说的一半内容。";
		mes "但战斗机器？我记得以前在图书馆见过他战斗。";
		close3;
	}
	switch( checkquest(18022,HUNTING) ) {
	case -1:
		break;
	case 0:
	case 1:
		.@md_name$ = "Hey! Sweety";

		.@party_id = getcharid(1);
		.@party_name$ = getpartyname(.@party_id);
		if (.@party_id < 1) {
			mes "^0000CD这是纪念副本。^000000";
			mes "请创建队伍后再试。";
			mes "^0000CD可以使用 /organize 队伍名称命令创建队伍。^000000";
			close;
		}
		if (checkquest(18025,PLAYTIME) == 2) {
			cutin "ep172_beta.bmp",2;
			mes "[Almond]";
			mes "你又要和 Sweety 对战吗？";
			mes "那么，我想问你一件事……";
			erasequest 18025;
			next;
		}
		mes "[Almond]";
		mes "Sweety 报名参加战斗了吗？";
		mes "只要 Almond 看好他就没问题。";
		if (isbegin_quest(18024) == 0 && checkquest(18025,PLAYTIME) == -1) {
			mes "另外，路上请去花园捡回损坏自动人偶的‘核心’。";
			setquest 18024;
		}
		next;
		if (select( "Create '" + .@md_name$ + "'.", "Enter '" + .@md_name$ + "'.'" ) == 1) {
			if (!is_party_leader()) {
				mes "^4D4DFF这里是纪念副本。";
				mes "你必须是队长才能创建纪念副本。^000000";
				close;
			}
			if (instance_create(.@md_name$) == -3)
				dispbottom "由于已有正在运行的副本，副本‘" + .@md_name$ + "’预约失败。";
			mes "[Almond]";
			mes "让我们把混乱清理干净吧~";
			close3;
		}
		if (instance_enter(.@md_name$) == IE_OK)
			mapannounce "ba_in01", "队伍‘" + .@party_name$ + "’的" + strcharinfo(0) + "正在进入" + .@md_name$ + "。", bc_map, "0x00FF99";
		else {
			mes "[Almond]";
			mes "能给我一点时间整理吗？";
			close2;
		}
		cutin "",255;
		end;
	case 2:
		break;
	}
	switch( checkquest(18025,PLAYTIME) ) {
	case -1:
		break;
	case 0:
	case 1:
		cutin "ep172_beta.bmp",2;
		mes "[Almond]";
		mes "客人，时机到了之后，请在日落后从宅邸收集损坏玩偶的核心。";
		mes "废墟中还留下许多自动人偶。";
		close3;
	case 2:
		cutin "ep172_beta.bmp",2;
		mes "[Almond]";
		mes "你之后还要和 Sweety 对战吗？";
		mes "那么，我想问你一件事……";
		erasequest 18025;
		next;
		cutin "ep172_beta.bmp",2;
		mes "[Almond]";
		mes "Sweety 应该修好了，自动人偶也应该恢复了。Almond 很忙~";
		close3;
	}
	switch( isbegin_quest(18024) ) {
	case 0:
		cutin "ep172_beta",2;
		mes "[Almond]";
		mes "正在修理 Sweety。自动人偶 Almond 很忙。";
		close3;
	case 1:
		if (countitem(1000226) < 10) {
			cutin "ep172_beta.bmp",2;
			mes "[Almond]";
			mes "我需要你收集超过 10 个损坏玩偶核心……";
			mes "你似乎还差一点？";
			mes "客人，你的努力还不够吗？";
			close3;
		}
		cutin "ep172_beta",2;
		mes "[Almond]";
		mes "这些核心够了~我们会用它们修理损坏的自动人偶……那些仍有数据的人偶很快就能修好。";
		mes "作为回报，我会给你这张巴米尔券。";
		erasequest 18024;
		setquest 18025;
		delitem 1000226,10;
		getitem 1000103,2;
		getexp2 206267,0;
		close3;
	case 2:
		end;
	}
	end;

OnInit:
	// starter
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "isbegin_quest(18018) == 2 && isbegin_quest(18019) == 0" );

	// hunting Sweety
	questinfo( QTYPE_DAILYQUEST, QMARK_YELLOW, "checkquest(18022,HUNTING) == 0 || checkquest(18022,HUNTING) == 1" );

	// item gathering
	questinfo( QTYPE_QUEST2, QMARK_YELLOW, "isbegin_quest(18024) == 1 && countitem(1000226) >= 10" );
	questinfo( QTYPE_DAILYQUEST, QMARK_YELLOW, "checkquest(18025,PLAYTIME) == 2" );
	end;
}

ba_in01,32,250,3	script	Sweety#ep172_swty	4_EP17_SWEETY,{
	if (checkweight(1000103,4) == 0) {
		mes "你携带的物品太多，无法继续任务。";
		mes "请清理背包后再试。";
		close;
	}
	if (ep17_2_main < 33) {
		cutin "ep172_beta",2;
		mes "[Almond]";
		mes "他的身体基础和我们相同，所以很容易修理。";
		mes "他之后醒来时我会告诉你。";
		close3;
	}
	if (isbegin_quest(18019) == 0) {
		cutin "ep172_sweety01",2;
		mes "[Sweety]";
		mes "你在看什么？";
		mes "离我远点？！";
		close3;
	}
	if (isbegin_quest(18019) == 1) {
		cutin "ep172_sweety01",2;
		mes "[Sweety]";
		mes "啊。我有了新的身体……";
		next;
		cutin "ep172_beta",0;
		mes "[Almond]";
		mes "Sweety，你错了。";
		mes "这不是新身体，我们只是修好了你的损伤。明白了吗？";
		next;
		mes "[Almond]";
		mes "真不可思议，你竟然能与我们的自动人偶部件兼容。";
		mes "Alpha 说 Sweety 的身体基础和我们相同。";
		next;
		cutin "ep172_sweety03",2;
		mes "[Sweety]";
		mes "哼，你懂什么。";
		mes "简而言之，我的身体是不死的。";
		next;
		select( "你以前是人类，对吧？" );
		cutin "ep172_beta",0;
		mes "[Almond]";
		mes "换个角度想，所有能说话并进行理性思考的生物都是人类。";
		mes "但我和 Sweety 没有生物学定义，所以不是人类，对吧？哈哈。";
		next;
		cutin "ep172_sweety03",2;
		mes "[Sweety]";
		mes "胡说！我是人类！我曾经是人类！";
		next;
		mes "[Sweety]";
		mes "在那群笨蛋中，只有我得到了认可！";
		mes "你知道我是怎么活下来的吗？";
		npctalk "哈哈，过去的事了。", "Manager Beta Almond#ep172_amd01", bc_self;
		next;
		mes "[Sweety]";
		mes "如果不是因为我的天才头脑，我会不会像其他人一样被抛弃？";
		mes "但我活下来了，不是很棒吗？";
		next;
		select( "真是个好故事……" );
		cutin "ep172_beta",0;
		mes "[Almond]";
		mes "在我看来……Sweety 拥有人的大脑，对吧？";
		mes "他的身体像自动人偶一样被改造过。";
		mes "那是不是意味着你也和我们一样是自动人偶~？";
		next;
		cutin "ep172_sweety03",2;
		mes "[Sweety]";
		mes "别把我当成和你一样的东西！";
		mes "我是幻影的一员！";
		mes "我只是在争取时间，不会轻易倒下！";
		mes "很快——";
		next;
		select( "很快？" );
		cutin "ep172_beta",0;
		mes "[Almond]";
		mes "看来你误会了，Sweety。";
		mes "入侵者的首领，也就是客人们所称的幻影，已经逃走了，对吧？";
		mes "这不就意味着他们抛弃你了吗？";
		mes "这是我从目前情况中得出的结论。";
		next;
		mes "[Almond]";
		mes "不可能。";
		mes "即使他们来了，你也收不到命令。";
		mes "我们修理你时，Elly 拿走了你的接收芯片。";
		mes "这不就意味着 Elly 会替你接收命令吗？";
		npctalk "不！我很快就会收到下一条命令！", "", bc_self;
		next;
		mes "[Almond]";
		mes "冒险者，你觉得我该怎么办？";
		mes "我无法摧毁他，因为这个孩子拥有‘人类儿童’的大脑。";
		next;
		cutin "ep172_sweety02",2;
		mes "[Sweety]";
		mes "你……？你在说什么？";
		mes "你要对我做什么？";
		mes "我的老师不会抛弃我！";
		next;
		cutin "ep172_beta",0;
		mes "[Almond]";
		mes "我能提个建议吗？";
		mes "Sweety 似乎因焦虑而承受极大压力。";
		next;
		mes "[Almond]";
		mes "每当 Sweety 暴走时，由你来对付他不是更好吗？";
		mes "之后我会修理他。";
		next;
		mes "[Almond]";
		mes "我曾读过一本书，讲述训练时学员每次试图起身，训练员都会把他击倒，这不是很常见吗？";
		mes "这次我想请你担任训练员。";
		npctalk "嘿！你听不见我说话吗？！", "", bc_self;
		completequest 18019;
		next;
		cutin "ep172_sweety04",2;
		mes "[Sweety]";
		mes "……所以你连我的意见都不听吗……？";
		close3;
	}
	switch( checkquest(18023,PLAYTIME) ) {
	case -1:
		break;
	case 0:
	case 1:
		cutin "ep172_sweety04",2;
		mes "[Sweety]";
		mes "即使你那样看着我，我也不会上你的当。";
		mes "走开。我需要修理。";
		close3;
	case 2:
		mes "[Sweety]";
		mes "我完全修好了！";
		mes "你……下次我真的会把你打死！";
		erasequest 18023;
		close;
	}
	switch( checkquest(18022,HUNTING) ) {
	case -1:
		cutin "ep172_sweety01",2;
		mes "[Sweety]";
		mes "是什么？发生什么了？";
		mes "你回来是想死在我手里吗？";
		next;
		if (select( "申请战斗。", "交谈。" ) == 2) {
			cutin "ep172_sweety04",2;
			mes "[Sweety]";
			mes "你觉得这样做我就会告诉你什么吗……？";
			mes "你为什么不直接去死？";
			close2;
			cutin "",255;
			npctalk "Sweety，你总是这么说话~", "Manager Beta Almond#ep172_amd01", bc_self;
			end;
		}
		cutin "ep172_sweety03",2;
		mes "[Sweety]";
		mes "听你这么说我很高兴。";
		mes "想战斗的话，随时欢迎！";
		next;
		cutin "ep172_sweety01",2;
		mes "[Sweety]";
		mes "但有个问题。如果你想和我战斗，就必须说服 Almond。";
		mes "你能做到吗？";
		next;
		if (select( "我能。", "不可能。" ) == 2) {
			cutin "ep172_sweety02",2;
			mes "[Sweety]";
			mes "什么，你反正只是个无名小卒。";
			close3;
		}
		if (isbegin_quest(18022) == 0)
			setquest 18022;
		mes "[Sweety]";
		mes "*窃笑*……这次我不会让你活着……*窃笑*";
		close3;
	case 0:
	case 1:
		cutin "ep172_sweety03",2;
		mes "[Sweety]";
		mes "呜呼……来吧，告诉 Almond！";
		mes "我要让这副身体热身！";
		mes "今天就是我击倒你的日子！";
		close3;
	case 2:
		cutin "ep172_sweety02",2;
		mes "[Sweety]";
		mes "……啧，我真的不想见到你。";
		mes "拿着这个走开！";
		erasequest 18022;
		setquest 18023;
		getitem 1000103,4;
		getexp2 206267,0;
		close3;
	}

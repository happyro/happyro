		mes "我想它受到";
		mes "魔法保护。你知道";
		mes "这件事吗？";
		next;
		mes "[男人]";
		mes "哇，你真的找到了？";
		mes "嘿，你比我想象的强。";
		mes "抱歉。";
		mes "我没解释魔法部分，因为……";
		mes "我没想到你能走到那一步。";
		mes "";
		next;
		mes "[男人]";
		mes "总之，我在魔法上也遇到问题。";
		mes "有人本该帮助我，";
		mes "但他没来。";
		mes "";
		mes "我太沮丧了！";
		next;
		mes "[男人]";
		mes "我对魔法一窍不通，";
		mes "也不知道该如何使用";
		mes "客户给我的";
		mes "这个东西。";
		mes "";
		next;
		while (1) {
			switch(select("谁要帮助你？:客户给了你什么？")) {
			case 1:
				mes "[男人]";
				mes "哦，是雇佣我的人说，";
				mes "只要我在宝藏地点等着，";
				mes "最终会有人来帮助我";
				mes "解决魔法问题。";
				mes "";
				mes "但我不知道他是谁。";
				next;
				mes "[男人]";
				mes "哦，他们提到他会从西边来。";
				mes "也许在可可多？";
				mes "";
				mes "";
				next;
				set .@joho1,1;
				break;
			case 2:
				if (treasure_nd == 7) {
					mes "[男人]";
					mes "哦，他们给了我";
					mes "一份奇怪文件，标着";
					mes "“^FF0000[打开^000000”。但我不会用。";
			mes "不过我完全不会使用它。";
					next;
				}
				else if (treasure_nd == 8) {
					mes "[男人]";
					mes "哦，他们给了我";
					mes "一份奇怪文件，标着";
					mes "“^FF0000[解锁^000000”。但我不会用。";
			mes "不过我完全不会使用它。";
					next;
				}
				else {
					mes "[男人]";
					mes "哦，让我看看。";
					mes "啊，这是他们给我的文件，";
					mes "不过有点破。";
					mes "";
					next;
					if (rand(1,2) == 1) {
						mes "^3355FF破损文件";
						mes "标着“^FF0000[打开^3355FF”。^000000";
						next;
						set treasure_nd,7;
						set .@joho2,1;
					}
					else {
						mes "^3355FF破损文件";
						mes "标着“^FF0000[解锁^3355FF”。^000000";
						next;
						set treasure_nd,8;
						set .@joho2,1;
					}
				}
			}
			if ((.@joho1 == 1) && (.@joho2 == 1)) {
				break;
			}

		}
		mes "[" + strcharinfo(0) + "]";
		mes "等等，你怎么会不知道";
		mes "怎么用？";
		mes "你没机会";
		mes "和客户谈谈吗？";
		next;
		mes "[男人]";
		mes "我甚至没见过他们。";
		mes "我只是通过邮件收到指示。";
		mes "和这些人联系都通过中间人。";
		mes "我想他们也在监视我，不过算了。";
		next;
		mes "[男人]";
		mes "我想他们雇我是因为真的想要宝藏，";
		mes "但不想让任何人知道他们在寻找";
		mes "宝藏，或已经拥有宝藏。";
		next;
		mes "[男人]";
		mes "总之，我只知道这张纸应该有用。";
		mes "但我不够聪明，弄不清用途。";
		mes "也许你运气更好。";
		next;
		mes "[男人]";
		mes "如果你能找到那个本应帮助我的人，";
		mes "也许他知道如何使用文件。";
		mes "把它们拿走吧。祝你好运。";
		close;
	}
	else if ((treasure_nd == 7) || (treasure_nd == 8)) {
		mes "[男人]";
		mes "我已经把知道的一切告诉你了。";
		mes "你最好去可可多找那个人，";
		mes "或者寻找撕碎文件的其他部分。";
		close;
	}
	else if ((treasure_nd == 9) || (treasure_nd == 10)) {
		mes "[男人]";
		mes "现在想想，也许需要两个人才能取得宝藏？";
		mes "他们计划让我和那个人一起去。呃，";
		mes "还是别想太多。";
		close;
	}
	else {
		mes "[男人]";
		mes "嘿！看来我很快要回家了～";
		close;
	}
}

comodo,339,224,3	script	Man in Hiding#nd	881,{
	if (treasure_nd < 7) {
		mes "[Man in Hiding]";
		mes "哇，别靠这么近！";
		close;
	}
	else if ((treasure_nd == 7) || (treasure_nd == 8)) {
		if (zdan_edq > 12) {
			mes "[Man in Hiding]";
			mes "哇，别靠这么近！";
			next;
		select("你为什么躲在这里？");
			mes "[" + strcharinfo(0) + "]";
		mes "你为什么躲在这里？";
		mes "Z 团不是雇你来挖宝藏的吗？";
			next;
			mes "[Man in Hiding]";
		mes "嗯？Z 团？宝藏？";
			next;
			mes "[Man in Hiding]";
		mes "嗯？等等，告诉我真相。";
		mes "你真的见过 Z 团吗？";
			next;
			mes "[" + strcharinfo(0) + "]";
		mes "我不仅见过 Z 团，还抓到了他们。";
		mes "我来找你，是想了解更多";
		mes "关于这个地下宝藏的事。";
			next;
			mes "[Man in Hiding]";
		mes "我明白了。你一定见过他们雇来取宝藏的另一个人。";
		mes "嗯，他有开启宝藏的半段咒语，";
		mes "我有另一半。";
			next;
			mes "[Man in Hiding]";
		mes "这个给你，这是剩下的魔法咒语。";
		mes "不过我提醒你，咒语和宝藏本身都有些奇怪。";
			next;
			if (treasure_nd == 7) {
				mes "^3355FF你收到一份撕碎的";
				mes "文件，上面写着";
				mes "''^FF0000Seseame]^000000.''";
				set treasure_nd,10;
				next;
			}
			else {
				mes "^3355FF你收到一份撕碎的";
				mes "文件，上面写着";
				mes "''^FF0000Treasure]^000000.''";
				set treasure_nd,9;
				next;
			}
			mes "[Man in Hiding]";
			mes "我不明白他们为什么费劲把咒语分成两部分。";
			mes "一定有原因，而且相当重要。";
			next;
			mes "[Man in Hiding]";
			mes "我猜也许需要两个人移动宝藏？";
			mes "不管怎样，祝你找到宝藏。再见！";
			close;
		}
		else {
			mes "[Man in Hiding]";
			mes "哇，别靠这么近！";
			next;
			select("询问宝藏" );
			mes "[" + strcharinfo(0) + "]";
			mes "我来寻找";
			mes "询问宝藏";
			mes "的相关信息。";
			next;
			emotion ET_HUK;
			mes "[Man in Hiding]";
			mes "你……你是来找我的吗？！";
			mes "唉，我被逼到绝境了！";
			mes "我不会";
			mes "我不会不战而降！";
			next;
			mes "[" + strcharinfo(0) + "]";
			mes "什么？不，不是那样。";
			mes "我在梦罗克遇到一个宝藏猎人，他说";
			mes "我可以在这里找到你。";
			next;
			mes "[Man in Hiding]";
			mes "宝藏猎人……？";
			mes "哦，那么你已经";
			mes "知道宝藏的事……";
			next;
			mes "[Man in Hiding]";
			mes "如果我没猜错，你";
			mes "需要开启宝藏的另一半咒语。";
			mes "这个给你。我反正用不上。";
			next;
			if (treasure_nd == 7) {
				mes "^3355FF你收到一份撕碎的";
				mes "文件上写着";
				mes "''^FF0000Sesame]^000000.''";
				set treasure_nd,10;
				next;
			}
			else {
				mes "^3355FF你收到一份撕碎的";
				mes "文件上写着";
				mes "''^FF0000Treasure]^000000.''";
				set treasure_nd,9;
				next;
			}
			mes "[Man in Hiding]";
			mes "现在你能离开这里吗？";
			mes "我是在躲一些人，";
			mes "该说的我都说了，";
			mes "我知道，所以帮我一个忙，";
			mes "别告诉任何人我在这里！";
			close;
		}
	}
	else if (treasure_nd == 9) {
		mes "[Man in Hiding]";
		mes "你不打算挖出宝藏吗？";
		mes "你已经拥有需要的两半咒语：";
		mes "我已经给了你";
		mes "''^FF0000Treasure]^000000'' part, right?";
		next;
		if (zdan_edq > 12) {
			mes "[Man in Hiding]";
			mes "总之，既然 Z 团被抓了，";
			mes "我回家应该安全了。";
			close;
		}
		else {
			mes "[Man in Hiding]";
			mes "你能帮我一个忙，";
			mes "在有人发现我的藏身处之前离开吗？";
			close;
		}
	}
	else if (treasure_nd == 10) {
		mes "[Man in Hiding]";
	mes "你不打算挖出宝藏吗？";
	mes "你已经拥有需要的两半咒语：";
		mes "我已经给了你";
		mes "''^FF0000Sesame]^000000'' part, right?";
		next;
		if (zdan_edq > 12) {
			mes "[Man in Hiding]";
			mes "总之，既然 Z 团被抓了，";
			mes "我回家应该安全了。";
			close;
		}
		else {
			mes "[Man in Hiding]";
			mes "你能帮我一个忙，";
			mes "在有人发现我的藏身处之前离开吗？";
			close;
		}
	}
	else {
		mes "[Man in Hiding]";
		mes "嘿！看来我可以安全出来回家了！";
		mes "不过为了安全起见，";
		mes "也许我该再躲一会儿。";
		close;
	}
}

moc_fild18,108,116,0	script	#treasure	844,{
	if (checkweight(907,300) == 0) {
		mes "^3355FF你携带的物品太多：";
		mes "现在无法携带宝藏箱。^000000";
		close;
	}
	if (treasure_nd == 5) {
		mes "^3355FF这里有东西，";
		mes "就埋在地下。^000000";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "呃！它、它不行……！";
		next;
		mes "^3355FF无论怎么努力，你都无法挖出或打开宝箱。";
		mes "宝箱周围有某种魔法气息阻止了你。^000000";
		set treasure_nd,6;
		close;
	}
	else if (treasure_nd == 6) {
		mes "^3355FF那个梦罗克的宝藏猎人一定知道宝箱的魔法保护。";
		mes "也许该去问问他。^000000";
		close;
	}
	else if ((treasure_nd == 7) || (treasure_nd == 8)) {
		mes "^3355FF你尝试施放收到文件上的咒语，但什么也没发生。";
		mes "你最好去可可多找另一个人，看看他知道什么。^000000";
		close;
	}
	else if (treasure_nd == 9 || treasure_nd == 10) {
		mes "^3355FF你需要组合收到文件上的两半咒语，解除宝箱的魔法保护，取得宝藏。^000000";
		next;
		input .@input$;
		getpartymember(getcharid(1));
		set .@partymembercount,$@partymembercount;
		if (.@partymembercount > 1) {
			if (((.@input$ == "OpenSesame") && (treasure_nd == 9)) || ((.@input$ == "UnlockTreasure") && (treasure_nd == 10))) {
				mes "^3355FFZ 团一定把咒语文件分成两部分，因为一个人不足以打开宝箱。";
				mes "幸好你带了朋友。^000000";
				next;
				mes "^3355FF你施放咒语，宝箱打开了，你拿走了里面所有战利品。^000000";
				if (zdan_edq == 0) {
					set treasure_nd,11;
				}
				else {
					set treasure_nd,12;
				}
				getitem 7725,1; //Unlucky_Emerald
				getitem 604,1; //Branch_Of_Dead_Tree
				getitem 1157,1; //Two_Hand_Sword
				sc_start SC_Curse,10000,0,10000;
				next;
				mes "[" + strcharinfo(0) + "]";
				mes "不！发生什么事了？";
				mes "这颗绿宝石……一定";
				mes "被邪恶魔法诅咒了！";
				close;
			}
			else {
				mes "^3355FF什么也没发生。";
				mes "你可能没有正确组合咒语。";
				mes "也许把它们连成一个词就行……^000000";
				close;
			}
		}
		else {
			mes "^3355FF宝箱仍然无法打开。";
			mes "不过，这似乎不是一个人能完成的工作……^000000";
			close;
		}
	}
	else if (treasure_nd == 11) {
		if (zdan_edq > 0) {
			mes "^3355FF一定有人在你离开后";
			mes "检查了宝藏地点：";
			mes "那个人留下了明显的存在痕迹。^000000";
			set treasure_nd,12;
			close;
		}
	}
}


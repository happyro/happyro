mosk_in,217,45,0	script	#book_russia	HIDDEN_NPC,{
	if (mos_nowinter == 15) {
		mes "- 锅旁边";
		mes "有一本异常巨大的书。";
		mes "文字杂乱无章，";
		mes "有些内容我无法理解。";
		mes "芭芭雅嘎的注释";
		mes "帮助我读懂了一部分。-";
		next;
		mes "- 好，现在开始阅读。-";
		next;
		mes "……因此，这个法术";
		mes "在强大的法术中尤其出色。";
		mes "通常，魔法被认为是";
		mes "与邪恶签订的契约。";
		mes "但是，以下内容并非来自地狱的力量，";
		mes "而是来自自然和人类的精神。";
		mes "我已经告诉过你，这个法术";
		mes "有以下两个特点。";
		mes "第一，它会改变自然现象。";
		mes "与愚蠢学者的想法不同，";
		mes "这个世界由不可见而精确的秩序组成。";
		mes "人们称为奇迹的事物，";
		mes "是通过刺激这些秩序，";
		mes "或简单地改变它们的排列而产生的。";
		mes "大多数改变天气的法术都属于这一类，";
		mes "而且需要很高的理解能力。";
		mes "这个世界的秩序并不是简单排列的。";
		mes "几乎不可能观察到它们最细微的部分，";
		mes "并完全理解其结构。";
		mes "不过，重复已经完成的法术并不困难。";
		mes "这本厚重的法术书就是为此而写。";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "什么？这只是序言？！";
		next;
		mes "……第二个特点是，";
		mes "这本法术书体现了人类的愿望。";
		mes "他们的精神如此强大，";
		mes "有时心中的火焰";
		mes "会化为实体并成为现实。";
		mes "现在，练习一个改变天气的法术。";
		mes "你必须前往潮湿而荒凉的地方，";
		mes "准备一锅正在熔化的材料，";
		mes "并带上施法者的精神。";
		mes "接下来的法术必须严格按照流程进行。";
		mes "如果发现有什么不对，";
		mes "就必须立即停止。";
		mes "为了防止普通人滥用魔法，";
		mes "材料的描述使用了隐喻，";
		mes "但理解这些隐喻的人可以……";
		mes "请谨慎使用这份知识。";
		mes "不要让愿望伤害他人。";
		mes "魔法需要责任。";
		mes "请记住这一点。";
		mes "书上的内容到此为止。";
		mes "愿你平安。";
		mes "咳咳。";

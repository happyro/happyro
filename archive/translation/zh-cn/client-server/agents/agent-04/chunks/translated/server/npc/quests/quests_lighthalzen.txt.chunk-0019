				mes "先不说这个。你……";
				mes "什……什么组织";
				mes "在雇佣你……？";
				next;
				input @jargeah$;
				if((@jargeah$ == "Kafra Corporation") || (@jargeah$ == "Secret Wing"))
				{
					mes "[贾尔吉亚]";
					mes "谢、谢天谢地！";
					mes "你终于来救我了。";
					mes "如果你再晚一点，";
					mes "我就没命了。拿、拿着，";
					mes "带这个走……";
					set lhz_boss,19;
					getitem 7343,1; //File02
					changequest 12020,12021;
					next;
					mes "[贾尔吉亚]";
					mes "哦……糟糕。";
					mes "*咳咳*";
					mes "我想……可能";
					mes "告、告诉香菜……";
					mes "告诉她我仍然爱——^333333*咳*^000000";
					close2;
					disablenpc "Wounded Man";
					end;
				}
				mes "[贾尔吉亚]";
				mes "不……你不是";
				mes "那个来找我的人";
				mes "";
				mes "……^333333*咳*^000000";
				next;
				mes "^3355FF情况不妙。";
				mes "贾尔吉亚刚刚";
				mes "以很糟糕的方式昏倒了。";
					close;
				case 2:
				mes "^3355FF于是你把受伤的人独自留下。";
				mes "这并不是";
				mes "最好的道德选择。^000000";
				close;
		}
	}
OnInit:
	disablenpc "Wounded Man";
	end;
}

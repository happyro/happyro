lhz_fild01,66,219,4	script	Mysterious Woman	4_F_AGENTKAFRA,{

	if(lhz_boss == 26)
	{
		if(checkweight(7343,1) != 1)
		{
			mes "^3355FF请稍等！";
			mes "你现在携带了";
			mes "太多物品。";
			mes "请先回来，";
			mes "使用卡普拉服务";
			mes "存放部分物品。^000000";
			close;
		}
		mes "[艾丝娜]";
		mes "我一直在等你。";
		mes "我们时间不多，";
		mes "我快速说明。你的";
		mes "任务是潜入";
		mes "雷根贝勒公司，";
		mes "窃取不利证据。";
		next;
		mes "[艾丝娜]";
		mes "不过这里不容易潜入，";
		mes "他们得知";
		mes "发生在辛诺卡斯和……";
		mes "贾尔吉亚身上的事后，";
		mes "会加强安保。";
		mes "还有……贾尔吉亚。贾尔吉亚……";
		next;
		mes "[艾丝娜]";
		mes "你需要通过我们的一名特工";
		mes "获得身份，";
		mes "他已深入其中";
		mes "且没有引起怀疑。";
		mes "";
		next;
		mes "[艾丝娜]";
		mes "之后找到^FF0000秘密档案室^000000，";
		mes "关闭安保系统，尽快窃取证据。";
		mes "明白了吗？";
		mes "务必小心。";
		mes "不要留下痕迹。";
		next;
		mes "[艾丝娜]";
		mes "现在使用你持有的雷根贝勒建筑通行证，";
		mes "与特工 ^FF0000莱斯汀^000000会合。";
		mes "他会解释其他事情，";
		mes "小心行事，别让他们怀疑你！";
		mes "这是秘密任务。";
		mes "不要留下痕迹。";
		set lhz_boss,27;
		changequest 12024,12025;
		close2;
		disablenpc "Mysterious Woman";
		end;
	}
	else if(lhz_boss == 27)
	{
		mes "[艾丝娜]";
		mes "使用通行证进入雷根贝勒建筑，";
		mes "找到秘密特工莱斯汀。";
		mes "记住，他正在卧底……";
		mes "不要暴露他的身份。";
		mes "保持警惕。";
		close;
	}
	else if(lhz_boss < 36)
	{
		mes "[艾丝娜]";
		mes ".........";
		close;
	}
	else if(lhz_boss == 36)
	{
		mes "[艾丝娜]";
		mes "做得好。";
		mes "请立即把这份文件交给魏尔斯特拉斯总统。";
		mes "我们也会直接发送情报，作为安全措施。";
		mes "请尽快行动。";
		mes "不要耽搁。";
		mes "这件事非常重要。";
		next;
		mes "[艾丝娜]";
		mes "我知道这很突然，但出现了新的情况。";
		mes "现在无法解释，";
		mes "你必须先替我确认总统的情况。";
		mes "此外，这份新情报还需要确认……";
		mes "马上出发。";
		mes "不要浪费时间。";
		set lhz_boss,37;
		close2;
		disablenpc "Mysterious Woman";
		end;
	}
	else if(lhz_boss < 38)
	{
		mes "[艾丝娜]";
		mes "........";
		mes ".....";
		close;
	}
	else if(lhz_boss == 38)
	{
		mes "[艾丝娜]";
		mes "你回来了。听着，";
		mes "你回来得真不是时候。";
		mes "我们刚得知发生了可怕的事情……";
		mes "情况非常紧急。";
		mes "请保持冷静。";
		next;
		mes "[艾丝娜]";
		mes "现在无法告诉你全部细节，";
		mes "但你必须尽快把文件交给总统。";
		mes "快！";
		mes "不要耽搁。";
		mes "这是关乎生死的事。";
		set lhz_boss,39;
		getitem 7343,1;
		close2;
		disablenpc "Mysterious Woman";
		end;
	}
	else if(lhz_boss == 39)
	{
		mes "[艾丝娜]";
		mes "你还在等什么？！";
		mes "必须尽快把文件交给总统！";
		mes "这是坏消息，";
		mes "但他有权知道……";
		mes "快去吧。";
		mes "现在就出发。";
		close;
	}
	else if(lhz_boss == 40)
	{
		mes "[艾丝娜]";
		mes "很好，你回来了。";
		mes "听着，所有秘密之翼成员必须立即离开施瓦茨瓦尔德共和国！";
		mes "我们的身份已经严重暴露……";
		mes "情况非常危险。";
		mes "马上撤离。";
		mes "不要再逗留。";
		next;
		switch( select( "What happened?" ) )
		{
			case 1:
				break;
		}
		mes "[艾丝娜]";
		mes "我们遭受了巨大损失。";
		mes "许多特工为了带回情报而牺牲，";
		mes "但我们被背叛了。";
		mes "总统最亲近的助手";
		mes "彻底出卖了我们……";
		mes "情况已经无法挽回。";
		next;
		switch( select( "谁会做出这种事……？" ) )
		{
			case 1:
				break;
		}
		mes "[艾丝娜]";
		mes "我不敢相信是库雷尔做的。";
		mes "我们已经无法拯救总统。";
		mes "即使想救他，也必须坚持备用计划。";
		mes "我们都知道其中的风险……";
		mes "这是不得已的选择。";
		mes "请不要责怪自己。";
		next;
		mes "[艾丝娜]";
		mes "库雷尔一直秘密会见";
		mes "雷根贝勒公司的董事，";
		mes "他的宅邸里到处都是";
		mes "不利证据……";
		mes "这足以证明他的罪行。";
		mes "我们必须小心处理。";
		next;
		mes "[艾丝娜]";
		mes "该死！我们现在只能放弃总统！";
		mes "但这不代表他的牺牲，";
		mes "以及贾尔吉亚的死亡会白费！";
		mes "他们为我们的事业献出了一切。";
		mes "我们必须铭记他们。";
		mes "绝不能忘记。";
		next;
		mes "[艾丝娜]";
		mes "不过除了少数特工外，";
		mes "秘密之翼几乎所有成员都必须撤出";
		mes "施瓦茨瓦尔德共和国，";
		mes "这样我们才能活下来，";
		mes "日后再战。";
		mes "现在不是逞强的时候。";
		next;
		mes "[艾丝娜]";
		mes "暂时就此告别。";
		mes "保重……";
		mes "愿你平安。";
		set lhz_boss,41;
		changequest 12027,12028;
		close2;
		disablenpc "Mysterious Woman";
		end;
	}
	else
	{
		mes "[艾丝娜]";
		mes "..........";
		mes "......";
		mes "....";
		close;
	}

OnInit:
	disablenpc "Mysterious Woman";
	end;
}

lhz_in01,93,45,4	script	Researcher#1	4_LGTSCIENCE,{

	if(lhz_boss < 28)
	{
		mes "[Researcher]";
		mes "你知道什么很奇怪吗？";
		mes "他们制作炸弹时为什么用蓝线和红线？";
		mes "明明还有很多其他颜色，";
		mes "比如粉色、黄色或绿色……";
		mes "真让人想不通。";
		mes "你觉得呢？";
		if(lhz_boss == 27)
		{
			next;
			mes "[Researcher]";
			mes "嘿，这只是个假设问题。";
			mes "假设你发现一枚即将爆炸的炸弹，";
			mes "必须剪断一根线！";
			mes "你会剪哪根？红色还是蓝色？";
			mes "快回答我。";
			mes "别紧张。";
			next;
			switch( select( "红色","蓝色" ) )
			{
				case 1:
					mes "[Researcher]";
					mes "红色吗……？";
					mes "...................";
					mes "嘿，和电影里一样。";
					mes "我喜欢你的想法～";
					mes "很有勇气。";
					if(!countitem(7348)) close;
					next;
					mes "^3355FF你悄悄查看研究员的 ID 徽章，";
					mes "发现上面写着‘莱斯汀’。^000000";
					mes "他就是秘密特工。";
					next;
					mes "[Lestin]";
					mes "那么……";
					mes "有什么我能帮你的吗？";
					mes "请说。";
					next;
						switch( select( "没有","有" ) )
					{
						case 1:
							mes "[Lestin]";
							mes "好吧。";
							mes "在实验室里保持安静。";
							mes "这里的人工作很投入，";
							mes "很容易被打扰，明白吗？";
							mes "请小心行事。";
							mes "不要引起注意。";
							close;

						case 2:
							mes "[Lestin]";
							mes "你究竟需要什么？";
							mes "我只是普通研究员，";
							mes "不确定能帮上多少忙……";
							mes "但我会尽力。";
							mes "请说明情况。";
							next;
							switch( select( "出示秘密之翼会员卡。" ) )
							{
								case 1:
									break;
							}
							mes "[Lestin]";
							mes "哇，等等～！";
							mes "小心别在这里亮出来！";
							mes "好，我知道你是谁了。";
							mes "但我们最好去更隐蔽的地方继续……";
							mes "请跟我来。";
							mes "不要被发现。";
							close2;
							warp "lhz_in01",283,166;
							end;
					}

				case 2:
					mes "[Researcher]";
					mes "蓝色吗？是啊，";
		mes "这里其他人都选这个。";
		mes "那我会选什么颜色？";
		mes "嘿嘿，这是秘密～";
					close;
			}
		}
		close;
	}
	else
	{
		mes "[Lestin]";
		mes "唉，我最近太累了。";
		mes "工作？算了，";
		mes "今天我要休息一下～";
		mes "改天再说吧。";
		close;
	}
}


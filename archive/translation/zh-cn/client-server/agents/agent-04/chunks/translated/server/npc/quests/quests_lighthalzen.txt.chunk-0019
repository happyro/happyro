		mes "任务有风险，但并非不可能。";
		mes "请小心。";
		mes "不要失败。";
		close;
	}
	else if(lhz_boss < 35)
	{
		mes "[Lestin]";
		mes "记住，卫兵换班时要潜过那两个人。";
		mes "躲在拐角后稍等片刻，";
		mes "应该就能顺利通过。";
		mes "保持耐心。";
		mes "不要发出声音。";
		mes "现在行动。";
		next;
		mes "[Lestin]";
		mes "潜入秘密档案室后，寻找文件搜索引擎。";
		mes "它应该就在门旁。";
		mes "用它查找特定信息，明白吗？";
		mes "不要翻动无关文件。";

			mes "更多东西。他们的关系看起来不太健康。";
			}
			else {
				mes "被偷的项链是";
				mes "丈夫买给妻子的……";
			mes "最近妻子让他";
			mes "买一条项链，但他拒绝了。";
			mes "所以他怀疑她。";
			}
			mes "还有……";

	end;
}

function	script	CheckBurglary	{
	.@last = getarg(1);
	for ( .@i = getarg(0); .@i <= .@last; .@i++ ) {
		if (checkquest(.@i) != -1)
			continue;
		switch(.@i) {
		case 9252:
			mes "- 先调查 Poppy -";
			close;
		case 9253:
			mes "- 先调查凌乱的";
			mes "书架 -";
			close;
		case 9254:
			mes "- 先调查损坏的";
			mes "书 -";
			close;
		case 9255:
			mes "- 先调查";
			mes "容器 -";
			close;
		case 9256:
			mes "- 先调查";
			mes "凌乱的桌子 -";
			close;
		}
	}
	return;
}


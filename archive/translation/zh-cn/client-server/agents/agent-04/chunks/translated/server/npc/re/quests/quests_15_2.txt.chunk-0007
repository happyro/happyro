			npctalk "夸够了吗？你对什么好奇？到底是什么？";
			sleep2 4000;
			npctalk "只是关于 Tatio，不过他大多是拟态体。我听说这是 Fresa 博士的研究，对吧？";
			sleep2 4000;
			npctalk "是的。Fresa 博士来到维鲁斯城前，曾研究神经系统的机械替代……";
			sleep2 4000;
			npctalk "哦啦啦，那么那对夫妻是因为这项研究才相识的？";
			sleep2 4000;
			npctalk "大概是吧？Tatio 本人毫不犹豫地同意人体实验，所以一切都是命中注定。";
			sleep2 4000;
			npctalk "嗯……所以这是单相思结出的果实？";
			sleep2 4000;
			npctalk "咦？你在说什么？你怎么得出这个结论的？别人的私生活就……";
			sleep2 4000;
			npctalk "不是，你看。Fresa 会把人分成对研究有用的和没用的……";
			sleep2 4000;
			npctalk "结果有一天她带回了丈夫，你知道我有多惊讶吗！！！！！！";
			sleep2 4000;
			npctalk "所以你感兴趣的不是生物技术，而是 Fresa 博士的恋爱生活。呃……";
			sleep2 4000;
			npctalk "没错！就是 Fresa！那个石头一样的女人居然有恋人……！！你敢相信吗？";
			sleep2 4000;
			npctalk "抱歉，但这还不够吗？";
			sleep2 4000;
			npctalk "呀！Tatio，你什么时候来的，哈哈哈哈！！！这……这没什么！";
			sleep2 4000;
			npctalk "哗啦——！咔哒！";
			break;
		case 10:
			npctalk "爆炸第 32 天，Lasse Atnad 语音记录。";
			sleep2 4000;
			npctalk "实验室内部的爆炸没有停止。";
			sleep2 4000;
			npctalk "参与或观察实验的研究人员状况不明，";
			sleep2 4000;
			npctalk "只能通过连接到避难室的系统生命体征了解情况。";
			sleep2 4000;
			npctalk "广场和研究设施只受到爆炸余波的部分损坏。";
			sleep2 4000;
			npctalk "然而……一些研究人员和市民被未知冲击波杀死……";
			sleep2 4000;
			npctalk "我们目前正利用研究设施组装探索机器人。";
			sleep2 4000;
			npctalk "维鲁斯城的主电源停止了，所以最低限度的设施由备用能量方块供电。";
			sleep2 4000;
			npctalk "能量风暴仍让人无法通过实验室隔离区。";
			sleep2 4000;
			npctalk "大多数研究人员厌倦了被困在城中，正在主张研究时间沉睡。";
			sleep2 4000;
			npctalk "……在这座无法逃离的坟墓里，我们梦想回到过去。";
			break;
		case 11:
			npctalk "哪一边？我站在对研究有用的一边。";
			sleep2 4000;
			npctalk "对她而言，这就是我存在的价值。这是我清楚知道的事实。";
			sleep2 4000;
			npctalk "我无法拒绝、不得不跟随她的原因，就像被海市蜃楼诱惑……";
			sleep2 4000;
			npctalk "因为她早已拥有我的心……";
			sleep2 4000;
			npctalk "沙沙。";
			sleep2 4000;
			npctalk "呃……你。原来是真的。果然是单相思。";
			sleep2 4000;
			npctalk "嗯？你在看什么……呃，那不是 Tatio 的日记吗？";
			sleep2 4000;
			npctalk "安静！笨蛋！被抓住怎么办！";
			sleep2 4000;
			npctalk "什么，你一边录音一边读这个吗！！！！！！";
			break;
		case 12:
			npctalk "你好，Tatio。";
			sleep2 4000;
			npctalk "大多数人都死了。";
			sleep2 4000;
			npctalk "为了生存，我把那些人都化成了尘埃，但我没有感到愧疚。";
			sleep2 4000;
			npctalk "最重要的是，我担心你会被独自留下。";
			sleep2 4000;
			npctalk "所以我决定不再绝望。";
			sleep2 4000;
			npctalk "就是明天。我们所有人和你一起离开这里的日子……";
			sleep2 4000;
			npctalk "直到我们再次相见，再见。";
			break;
		case 13:
			npctalk "你好。我是 Silvia Loren。";
			sleep2 4000;
			npctalk "我的爱好是鸡肉。我喜欢啤酒~。";
			sleep2 4000;
			npctalk "呃……今天接下项目后有点做过头了。";
			sleep2 4000;
			npctalk "说实话，这不是我感兴趣的主题。";
			sleep2 4000;
			npctalk "Vincent 参与了这个项目。";
			sleep2 4000;
			npctalk "Ah.......";
			sleep2 4000;
			npctalk "不，等等。我不是想解释那个。哦，现在！！取消！！——Zizipzizip";
			break;
		case 14:
			npctalk "爆炸第 1 天，Lasse Atnad 语音记录。";
			sleep2 4000;
			npctalk "实验评估为失败。维鲁斯城启动自动灾害装置。";
			sleep2 4000;
			npctalk "城市与外界隔绝，各区域生成了隔离带。";
			sleep2 4000;
			npctalk "系统正在迅速恢复，但与外界隔绝是最大的问题。";
			sleep2 4000;
			npctalk "也许维鲁斯城正在将自己认定为灾害源头。";
			sleep2 4000;
			npctalk "为了防止损害扩散，只能与外界隔绝并保持沉默……";
			sleep2 4000;
			npctalk "……该死……";
			sleep2 4000;
			npctalk "我不想把这种东西留在记录里……";
			break;
		}
		sleep2 3000;
		.is_playing = 0;
		next;
		mes "记忆记录中的所有音频信息已播放完毕。";
		erasequest 7650;// Collect Memory Records of Research facilities
		erasequest 7654;// Play Research facilities Memory Records
		setquest 7651;// One Memory a Day
		if (ep15_2_permit < 5)
			ep15_2_permit++;
	}
	else {
		switch( rand(1,18) ) {
		case 1:
			npctalk "我是 Dorothy Florence，只会洗衣服的 Dorothy。";
			sleep2 4000;
			npctalk "我想用仅有的东西保存人们的遗物。";
			sleep2 4000;
			npctalk "这里有很多人。他们还活着。";
			sleep2 4000;
			npctalk "我希望尽可能保存人们的故事。";
			sleep2 4000;
			npctalk "也希望有人能记住我们曾经的样子。";
			sleep2 4000;
			npctalk "好吧……那么……我该先采访谁？";
			break;
		case 2:
			npctalk "我是 Dorothy Florence。";
			sleep2 4000;
			npctalk "在 Fresa 博士的指挥下，我们已经确定了个人分工。";
			sleep2 4000;
			npctalk "我们必须在这里生存到外面的能量风暴停止。";
			sleep2 4000;
			npctalk "关于食物问题，我们决定咨询前自助餐厅老板 Yangsang。";
			sleep2 4000;
			npctalk "据说我们可以坚持约 40 天。";
			sleep2 4000;
			npctalk "这个避难室真厉害。";
			break;
		case 3:
			npctalk "我是 Dorothy Florence。";
			sleep2 4000;
			npctalk "今天我们举办了一个小聚会。";
			sleep2 4000;
			npctalk "我们第一次收获了正在培育的植物！";
			sleep2 4000;
			npctalk "据生物技术负责人说，至少每两周可以收获一次，";
			sleep2 4000;
			npctalk "这是因为有加速生长技术。";
			sleep2 4000;
			npctalk "今天我又能尝到新鲜葡萄了。";
			break;
		case 4:
			npctalk "我是 Dorothy Florence。今天是第三晚。";
			sleep2 4000;
			npctalk "人们把 Fresa 博士视为当前局势的领导者，昨天的批评也失去了意义。";
			sleep2 4000;
			npctalk "生物技术工程师、机械工程师、设施管理者……我们需要的人都有。";
			sleep2 4000;
			npctalk "当然也有我这样的低等厨房女仆。";
			sleep2 4000;
			npctalk "我只是来这里送洗好的衣服。";
			sleep2 4000;
			npctalk "我怎么会卷入这种事？";
			break;
		case 5:
			npctalk "我是 Dorothy Florence。今天在监控室捡到了一份记忆记录。";
			sleep2 4000;
			npctalk "可能是实验当天录下的黑匣子。我来播放它！";
			sleep2 4000;
			npctalk "Zizip——啊……先是静电声……啊，在这里。";
			sleep2 4000;
			npctalk "祝好运……";
			sleep2 4000;
			npctalk "（女性声音）哈……我后悔从没约会过。";
			sleep2 4000;
			npctalk "（另一女性声音）啊……我应该一边吃鸡肉喝啤酒一边看这个……滋滋——";
			sleep2 4000;
			npctalk "嗯？就这些？但这个声音。啊啊啊啊，检查她洗衣服的 Artemia！";
			sleep2 4000;
			npctalk "……嗯……我明白了。那天发生的就是这些……";
			sleep2 4000;
			npctalk "咔哒";
			break;
		case 6:
			npctalk "我是 Dorothy Florence。";
			sleep2 4000;
			npctalk "有一天，生物学家培育的植物发芽了。";
			sleep2 4000;
			npctalk "我应该高兴吗？";
			sleep2 4000;
			npctalk "这确实值得高兴，但我们仍然无法联系外界。";
			sleep2 4000;
			npctalk "一周过去了，避难室里人们唯一的乐趣……";
			sleep2 4000;
			npctalk "就是看着植物发芽。";
			break;
		case 7:
			npctalk "我是 Dorothy Florence。避难室生活已经持续一个月。";
			sleep2 4000;
			npctalk "由于空气净化器坏了，人们从早上起就一直很忙。";
			sleep2 4000;
			npctalk "我只能旁观，因为我只会洗衣服。";
			sleep2 4000;
			npctalk "幸好机械狂人已经做出了新的空气净化器。";
			sleep2 4000;
			npctalk "这样呼吸就没问题了。";
			sleep2 4000;
			npctalk "真让人松了口气，对吧？";
			break;
		case 8:
			npctalk "我是 Dorothy。这是最后一段录音。";
			sleep2 4000;
			npctalk "我不想死。呜呜……";
			sleep2 4000;
			npctalk "我不想变得和他们一样！！";
			sleep2 4000;
			npctalk "……我想活下去……";
			break;
		case 9:
			npctalk "我是 Dorothy Florence。我录下这些内容，";
			sleep2 4000;
			npctalk "因为必须有人留下这场可怕事故的记忆。";
			sleep2 4000;
			npctalk "实验引发的爆炸让外界完全与这里隔绝。";
			sleep2 4000;
			npctalk "大多数人目前已经撤到避难室。";
			sleep2 4000;
			npctalk "无法联系外界。";
			sleep2 4000;
			npctalk "暂时很难外出。";
			break;
		case 10:
			npctalk "你好，我是 Ate。维鲁斯城的助理工程师。";
			sleep2 4000;
			npctalk "哈哈……这不是很尴尬吗？";
			sleep2 4000;
			npctalk "我……刚才用避难室里的葡萄酿了酒。";
			sleep2 4000;
			npctalk "地表死去的人越多，避难室里的生活就越贫困。";
			sleep2 4000;
			npctalk "我没喝多少，但旁边那个人一定醉了，因为他一直缠着我。";
			sleep2 4000;
			npctalk "这家伙就没有比缠着我更值得做的事吗？";
			sleep2 4000;
			npctalk "我算是很受欢迎的类型。哈哈。";
			sleep2 4000;
			npctalk "不过，看到那个黏人的家伙，我不知怎么想起了那个孩子。";
			sleep2 4000;
			npctalk "黑色长辫子，满脸雀斑……";
			sleep2 4000;
			npctalk "……Ate！能帮我检查一下吗？";
			sleep2 4000;
			npctalk "啊……抱歉。我得去工作了，有机会再继续。";
			sleep2 4000;
			npctalk "呃，Ate 的采访下次继续！这里是 Dorothy！";
			break;
		case 11:
			npctalk "我是 Dorothy Florence。爆炸第 50 天。";
			sleep2 4000;
			npctalk "经过长时间讨论，Fresa 博士的研究人员似乎决定";
			sleep2 4000;
			npctalk "穿过没有能量风暴的隔离区。";
			sleep2 4000;
			npctalk "他们要挖掘地下隧道离开……！";
			sleep2 4000;
			npctalk "我以为我们被防护墙困住了？";
			break;
		case 12:
			npctalk "你好！Ate！有时间吗？";
			sleep2 4000;
			npctalk "你好，Dorothy。又是上次那件事吗？我真的必须继续吗？";
			sleep2 4000;
			npctalk "我确实答应了。没办法。刚才说到哪了？";
			sleep2 4000;
			npctalk "那个黑色长辫子、满脸雀斑的孩子！";
			sleep2 4000;
			npctalk "啊，对了。那个孩子。他以前总是烦人地跟着我。";
			sleep2 4000;
			npctalk "那时他还更小……唉……";
			sleep2 4000;
			npctalk "我本以为终于在维鲁斯城摆脱他了，真让人松了口气。";
			sleep2 4000;
			npctalk "直到我在实验室遇到他。哈哈，他真是个有趣的孩子。";
			sleep2 4000;
			npctalk "总是诚实表达感情，一点没变……";
			sleep2 4000;
			npctalk "但那孩子因为固执，从没告诉我他喜欢我。";
			sleep2 4000;
			npctalk "尽管他的脸上写得明明白白。";
			sleep2 4000;
			npctalk "像跟踪狂一样追着我。哼……哈哈哈。";
			sleep2 4000;
			npctalk "但今天我想念你，孩子……呵呵。";
			sleep2 4000;
			npctalk "……不过那天你大概，嗯……那天……";
			sleep2 4000;
			npctalk "………………Dorothy……我们停下吧。";
			break;
		case 13:
			npctalk "我是 Dorothy Florence。一个月零一周过去了。";
			sleep2 4000;
			npctalk "今天有坏消息。";
			sleep2 4000;
			npctalk "出去多重防护墙外测量大气的人还没有回来。";
			sleep2 4000;
			npctalk "也许……他们被能量风暴吞噬了。";
			sleep2 4000;
			npctalk "希望他们能再次获得自由。";
			break;
		case 14:
			npctalk "我是 Dorothy Florence。爆炸第 44 天。";
			sleep2 4000;
			npctalk "我听说防护墙内的一部分人发生了奇怪的变化。";
			sleep2 4000;
			npctalk "显然这与他们曾经外出有关。";
			sleep2 4000;
			npctalk "人们争先恐后地检查防护墙。";
			sleep2 4000;
			npctalk "我们会变成什么样……？";
			break;
		case 15:
			npctalk "——砰——";
			sleep2 4000;
			npctalk "呃……";
			sleep2 4000;
			npctalk "呜呜……";
			sleep2 4000;
			npctalk "为什么！为什么会变成这样！！！";
			sleep2 4000;
			npctalk "呜呜……";
			sleep2 4000;
			npctalk "——砰——";
			sleep2 4000;
			npctalk "——滋滋——啊——医生——之前——滋滋——他——滋滋——寻找……";
			sleep2 4000;
			npctalk "——滋滋——这里。";
			sleep2 4000;
			npctalk "——咔哒——";
			sleep2 4000;
			npctalk "嗯。医生看起来也很疲惫。";
			sleep2 4000;
			npctalk "啊！这个还开着？开太久的话我会挨骂……";
			sleep2 4000;
			npctalk "嗯哼！嗯！我是 Vanilla Luide。不知为什么，最近很累。";
			sleep2 4000;
			npctalk "看现在的情况，大家的状态也就不奇怪了。";
			sleep2 4000;
			npctalk "呼……";
			sleep2 4000;
			npctalk "嗡……";
			break;
		case 16:
			npctalk "我是 Dorothy Florence。爆炸第 2 天。情况仍然混乱。";
			sleep2 4000;
			npctalk "人们把批评倾泻向";
			sleep2 4000;
			npctalk "项目首席研究员兼负责人 Fresa 博士。";
			sleep2 4000;
			npctalk "不过这是一个人无法独自解决的事故。";
			sleep2 4000;
			npctalk "也许那些人只是需要有人负责。";
			break;
		case 17:
			npctalk "我是 Dorothy Florence。";
			sleep2 4000;
			npctalk "昨天的事故后，他们正在把生活必需品搬到里面。";
			sleep2 4000;
			npctalk "可靠的避难室似乎有一部分被什么东西污染了。";
			sleep2 4000;
			npctalk "我们正在转移到最干净的区域。";
			break;
		case 18:
			npctalk "我叫 Vincent。";
			sleep2 4000;
			npctalk "嗯～我进服务器室来更换 Mother Comp 的主 CPU～";
			sleep2 4000;
			npctalk "到处都是灰尘……该死……啊，麦克风开着……";
			sleep2 4000;
			npctalk "让我看看。要安装的设备是大约 11 年制造的 Nana 产品，是昂贵的 CPU。";
			sleep2 4000;
			npctalk "哪怕一道小划痕都相当于损失几套公寓的价值。不过现在它是我的玩具。";
			sleep2 4000;
			npctalk "取出里面的家伙……像这样。安装新产品。";
			sleep2 4000;
			npctalk "好了。真的很简单。";
			sleep2 4000;
			npctalk "嘿 Silvia，要吃鸡肉吗？我想要加葱的……（嗡……嗡）";
			sleep2 4000;
			npctalk "嗡……嗡";
			break;
		}
		sleep2 3000;
		.is_playing = 0;
		next;
		mes "记忆记录中的所有音频信息已播放完毕。";
		erasequest 7652;// Collect Memory Records of Laboratories
		erasequest 7655;// Play Laboratories Memory Records
		setquest 7653;// One Memory a Day 2
		// memory record daily quests
		if (countitem(22691) < 1 && countitem(22692) < 1 && countitem(22693) < 1 && countitem(22694) < 1 && countitem(22695) < 1)
			getitem rand(22691,22695),1;// Record_Fragment
	}
	getexp 1500000,1000000;
	next;
	specialeffect EF_SPELLBREAKER;
	mes "当你试图取出记忆记录时，连接部件咔嚓一声断裂，恢复成拆散状态。";
	next;
	cutin "Arquien_n_atnad01.bmp",2;
	mes "[Nile]";
	mes "该死。明明只有一段内容，却每次无法播放都会烦人地损坏。";
	mes "我开始觉得这是故意制造成这样的。";
	mes "清理起来真麻烦……";
	next;
	mes "[Nile]";
	mes "凭借那么多科学和才能，为什么要制造这种东西？";
	mes "更不用说偶尔还会出现重叠……";
	mes "感觉有人无论如何都在诱使我们了解过去。";
	next;
	mes "[Nile]";
	mes "总之我会单独记录这段内容，交给那位老人。";
	mes "今天干得不错。";
	next;
	mes "[Nile]";
	if (ep15_2_permit != 5)
		mes "那明天再回来。";
	else {
		mes "等等，发生什么了？";
		mes "那边的帐篷是挖掘队所在地，对吧？";
		mes "好像有人来访？";
		mes "现在过去吧！";
		ep15_2_permit = 6;
	}
	close3;
}


// Bunker - ep15_2_memory
function	script	F_time_limit_recorder	{
	if (getarg(1,1) && checkweight(1301,1) == 0) {
		mes "- 物品太多，无法继续任务 -";
		close;
	}
	setarray .@quest_id[0], 5341,5351,5358,5363,5366;
	for ( .@i = 0; .@i < 5; ++.@i ) {
		switch( checkquest(.@quest_id[.@i],PLAYTIME) ) {
		case -1:
			set getelementofarray( getarg(0), .@i ), 0;
			break;
		case 0:
		case 1:
			set getelementofarray( getarg(0), .@i ), 1;
			break;
		case 2:
			mes "你的全身突然变得沉重，周围的时间似乎流逝得更快。";
			close2;	// custom (player can't read the text without this)
			ep15_2_memory = 0;
			for ( .@i = 5341; .@i <= 5369; ++.@i ) {
				if (isbegin_quest(.@i) > 0)
					erasequest .@i;
			}
			if (isbegin_quest(5370) == 1)
				mes "你的全身突然变得沉重，周围的时间似乎流逝得更快。";
			else {
				mes "啊——这舒适而温暖的感……觉……";
				if (getarg(2,1))
					warp "un_bunker",98,91;
				else
					consumeitem 602;// Wing_Of_Butterfly
			}
			close;
		}
	}
	return;
}

un_bk_q,103,147,4	script	Bunker Sayhu#EP15.2MR	4_M_ALCHE_C,{
	callfunc( "F_time_limit_recorder", .@cooldown_status_day );
	if ((.@cooldown_status_day[0] + .@cooldown_status_day[1] + .@cooldown_status_day[2] + .@cooldown_status_day[3] + .@cooldown_status_day[4]) == 0) {
		emotion 46;
		mes "[Bunker Sayhu]";
		mes "首先，恭喜你活下来。我很高兴你进了防空洞。如果你在外面……";
		next;

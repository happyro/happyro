//===== rAthena Script ======================================= 
//= Soul Linker Job Quest
//===== By: ================================================== 
//= Celestria & Samuray22
//===== Current Version: ===================================== 
//= 1.6
//===== Compatible With: ===================================== 
//= rAthena Project
//===== Description: ========================================= 
//= [Official Conversion]
//= Job quest for Soul Linker class.
//= [Vars Used]
//= SOUL_Q = Job Change Phase. (Max 4)
//===== Additional Comments: ================================= 
//= 1.2 Rescripted to Aegis 10.3 standards. [Samuray22]
//= 1.3 Slight updates and fixes to the script. [L0ne_W0lf]
//=     Removes the use of labels, and corrects other errors.
//=     Removed the GM-use only NPC from the sec_in map. 
//=     No longer used a global var, uses an NPC var instead.
//= 1.3a Deleted Empty Color Tag. (bugreport:1572) [Samuray22]
//= 1.4 Replaced effect numerics with constants. [L0ne_W0lf]
//= 1.5 Added Quest Log commands. [Kisuka]
//= 1.6 Updated to match the latest official script. [Euphy]
//============================================================ 

morocc_in,174,30,6	script	Kid#link1	716,{
	if (Class == Job_Soul_Linker) {
		mes "[玛雅]";
		mes "祝你旅途";
		mes "顺利。随着你掌握更多";
		mes "灵魂链接者技能，";
		mes "你将能汲取更多";
		mes "灵魂力量";
		mes "赋予盟友……";
		close;
	}
	if (Class == Job_Star_Gladiator) {
		mes "[孩子]";
		if (Sex == SEX_MALE) {
			mes "你不是太阳的";
			mes "战士吗？我很熟悉";
		}
		else {
			mes "你不是月亮的";
			mes "战士吗？我很熟悉";
		}
		mes "毕竟你的方式与我相似，";
		mes "我们双方技能的基础";
		mes "都源于";
		mes "跆拳道职业，对吧？";
		close;
	}
	if (Class != Job_Taekwon) {
		mes "[孩子]";
		mes "嗯？我没什么";
		mes "可以给你。但如果你认识";
		mes "经验丰富的";
		mes "跆拳道";
		mes "修炼者，他们可能会从我这里受益。";
		mes "至少据我所知是这样。";
		close;
	}
	if (JobLevel < 40) {
		mes "[孩子]";
		mes "所以你正在学习";
		mes "跆拳道。很好，";
		mes "非常好。继续磨练技能，";
		mes "坚持训练吧。";
		mes "";
		close;
	}
	else if (JobLevel > 39) {
		if (SOUL_Q == 0) {
			mes "[孩子]";
			mes "...";
			mes "嘿，你。";
			next;
			mes "["+ strcharinfo(0) +"]";
			mes "你叫我吗？";
			next;
			mes "[孩子]";
			mes "对，我叫你。";
			mes "别逼我提高声音，";
			mes "赶紧过来。";
			mes "";
			next;
			if (select("You're awfully rude for a kid!:Ignore him.") == 1) {
				mes "[孩子]";
				mes "你很幸运，我对你感兴趣！";
				mes "我看起来像个孩子，";
				mes "但我已经三百多岁了！";
				mes "";
				mes "";
				emotion ET_HNG;
				next;
				mes "[孩子]";
				mes "听好了……";
				mes "我知道你是跆拳道弟子。";
				mes "那是值得尊敬的技艺，";
				mes "但我有个提议，你想听听吗？";
				mes "";
				mes "";
				emotion ET_SMILE;
				next;
				mes "[孩子]";
				mes "我看着你就知道，你很有灵性。";
				mes "你潜力很大，我不想浪费它。";
				mes "为什么不成为‘灵魂链接者’呢？";
				mes "";
				mes "";
				mes "";
				next;
				if (select("Ha! Silly little boy~:Soul Linker?") == 1) {
					mes "[孩子]";
					mes "你……你不相信我？";
					mes "我是认真的。能不能暂时忘掉";
					mes "我看起来像小孩这件事？";
					mes "*哼*……年轻人。";
					mes "";
					mes "";
					close;
				}
				mes "[孩子]";
				mes "灵魂链接者会与战死却仍想在生者世界战斗的";
				mes "战士灵魂沟通。";
				mes "不过这些战士灵魂无法以自身形态";
				mes "在我们的世界战斗。";
				mes "";
				mes "";
				next;
				mes "[孩子]";
				mes "然而，由于你具有灵性，这些灵魂会被你吸引。";
				mes "经过充分训练，你可以暂时将这些灵魂的力量赋予盟友。";
				mes "";
				mes "";
				mes "";
				next;
				mes "[孩子]";
				mes "不过你无法将灵魂力量赋予自己。";
				mes "此外，根据你作为灵魂链接者的技能，";
				mes "你只能将强化力量赋予特定职业的角色。";
				mes "";
				mes "";
				next;
				mes "[孩子]";
				mes "要成为灵魂链接者，你必须进入一个完全不同的世界，";
				mes "但我知道你做得到。你觉得呢？";
				mes "";
				mes "";
				mes "";
				next;
				if (select("No. At least, not now...:Alright. What do I have to do?") == 1) {
					mes "[孩子]";
					mes "啊，好吧。以后如果决定";
					mes "成为灵魂链接者，";
					mes "请随时回来";
					mes "和我谈谈。";
					mes "";
					close;
				}
				set SOUL_Q,1;
				setquest 6005;
				mes "[孩子]";
				mes "所以你想成为灵魂链接者？太好了！";
				mes "首先请带回几件物品。";
				mes "别担心，之后我会解释用途。";
				mes "";
				mes "";
				mes "";
				next;
				mes "[孩子]";
				mes "现在带给我";
				mes "^0000FF1 颗 3 克拉钻石^000000、";
				mes "^0000FF1 个不朽心脏^000000和";
				mes "^0000FF1 朵永恒玫瑰^000000。";
				mes "别让我等太久，好吗？";
				mes "";
				close;
			}
			mes "[孩子]";
			mes "嗯……？";
			mes "等等，你要去哪？我……";
			mes "我在和你说话！";
			mes "";
			close;
		}
		else if (SOUL_Q == 1) {
			if (Class == Job_Taekwon) {
				mes "[孩子]";
				mes "你回来了？";
				mes "带来我要求的";
				mes "^0000FF1 颗 3 克拉钻石^000000、";
				mes "^0000FF1 个不朽心脏^000000和";
				mes "^0000FF1 朵永恒玫瑰^000000了吗？";
				next;
				if (select("There you are.:No, not yet...") == 1) {
					if (countitem(732) > 0 && countitem(929) > 0 && countitem(748) > 0) {
						delitem 732,1; //Crystal_Jewel__
						delitem 929,1; //Immortal_Heart
						delitem 748,1; //Witherless_Rose
						set SOUL_Q,2;
						changequest 6005,6006;
						mes "[孩子]";
						mes "很好，你把东西都带齐了。";
						mes "开始前先自我介绍一下。";
						mes "我叫玛雅，已经活了三百多年。";
						mes "";
						mes "";
						next;
						mes "[玛雅]";
						mes "不透露太多细节，神明赋予我的职责是寻找并招募更多灵魂链接者。";
						mes "这也是我还没有离世的部分原因。";
						mes "";
						mes "";
						next;
						mes "[玛雅]";
						mes "总之，我还要用你带来的材料完成准备。";
						mes "过一会儿再回来好吗？";
						mes "到时我们再谈。";
						mes "";
						mes "";
						close;
					}
					mes "[孩子]";
					mes "嗯……？";
					mes "嘿，你忘了几样东西。";
					mes "现在回去把我要求的";
					mes "东西都带来，好吗？";
					mes "";
					mes "";
					emotion ET_HNG;
					next;
					mes "[孩子]";
					mes "我知道刚才告诉过你需要什么，";
					mes "但再提醒一次：";
					mes "^0000FF1 颗 3 克拉钻石^000000、";
					mes "^0000FF1 个不朽心脏^000000和";
					mes "^0000FF1 朵永恒玫瑰^000000。";
					close;
				}
				mes "[孩子]";
				mes "嗯，没关系。";
				mes "虽然我有的是时间，";
				mes "但我不喜欢等太久。";
				mes "";
				mes "";
				close;
			}
			set SOUL_Q,0;
			mes "[孩子]";
			mes "你反而成为了太阳、月亮和星星的战士？";
			mes "没想到你有那样的潜力。";
			mes "我想也不能怪你……";
			mes "";
			mes "";
			close;
		}
		else if (SOUL_Q == 2) {
			if (SkillPoint) {
				mes "[玛雅]";
				mes "你还有未分配的技能点。";
				mes "用它们学习跆拳道技能，";
				mes "准备好后再回来。";
				mes "";
				mes "";
				close;
			}
			if (.SoulLinkerTest == 1) {
				mes "[玛雅]";
				mes "现在有人正在完成";
				mes "灵魂链接者转职仪式。";
				mes "请等仪式结束，好吗？";
				mes "等我有空时会接待你。";
				mes "";
				mes "";
				close;
			}
			donpcevent "Timer#link3::OnEnable";
			set .SoulLinkerTest,1;
			mes "[玛雅]";
			mes "太好了，准备工作完成了。";
			mes "现在开始灵魂链接者转职仪式。";
			mes "请闭上眼睛……";
			mes "";
			mes "";
			mes "";
			close2;
			warp "job_soul",30,30;
			end;
		}
		else if (SOUL_Q > 2) {
			mes "[玛雅]";
			mes "准备好再次进入";
			mes "心灵深处了吗？";
			mes "";
			next;
			if (select("No:Yes") == 1) {
				mes "[玛雅]";
				mes "那么，觉得准备好后";
				mes "再回来找我。";
				mes "在那之前我会一直等在这里。";
				mes "";
				mes "";
				close;
			}
			if (.SoulLinkerTest == 1) {
				mes "[玛雅]";
				mes "现在有人正在完成灵魂链接者转职仪式。";
				mes "";
				mes "";
				mes "请等仪式结束，好吗？";
				mes "等我有空时会接待你。";
				mes "";
				mes "";
				mes "";
				close;
			}
			donpcevent "Timer#link3::OnEnable";
			set .SoulLinkerTest,1;
			mes "[玛雅]";
			mes "好吧，闭上眼睛放松。";
			mes "我们会再次进入你的心灵深处。";
			mes "";
			mes "";
			close2;
			warp "job_soul",30,30;
			end;
		}
	}

OnInit:
	set .SoulLinkerTest,0;
	end;
}

job_soul,30,31,0	script	Maia#link2::SLTester	-1,3,3,{
OnTouch_:
	if (Class == Job_Taekwon) {
		if (JobLevel < 40) {
			set getvariableofnpc(.SoulLinkerTest,"Kid#link1"),0;
			mes "[玛雅]";
			mes "嗯？你怎么来了？";
			mes "你还没有资格参加仪式。来，我送你回梦罗克……";
			mes "";
			close2;
			warp "morocc",157,47;
			end;
		}
		if (SOUL_Q == 2) {
			mes "[玛雅]";
			mes "认得这里吗？现在我们在你的心中。";
			mes "死去战士的灵魂徘徊于此，等待你召唤他们的力量。";
			mes "";
			mes "";
			mes "";
			mes "";
			next;
			mes "[玛雅]";
			mes "现在这里只有少数灵魂，";
			mes "但继续训练后，作为灵魂链接者你能召唤更多灵魂。";
			mes "";
			mes "";
			mes "";
			next;
			set SOUL_Q,3;
			changequest 6006,6007;
			mes "[玛雅]";
			mes "我们只能在你的心中停留 3 分钟。";
			mes "趁此机会和灵魂们谈谈吧。";
			mes "";
			mes "";
			mes "";
			close;
		}
		else if (SOUL_Q == 3) {
			mes "[玛雅]";
			mes "听听灵魂们想说什么。";
			mes "他们无法前往来世，";
			mes "一定有原因。";
			mes "";
			mes "";
			close;
		}
		else if (SOUL_Q == 4) {
			mes "[玛雅]";
			mes "我相信你已经准备好成为灵魂链接者。";
			mes "不过如果愿意，也可以继续和灵魂交谈。";
			mes "";
			mes "";
			mes "";
			mes "";
			next;
			if (select("Converse more with the spirits:Become a Soul Linker") == 1) {
				mes "[玛雅]";
				mes "好吧。动作快点，因为我们只能在你心中停留有限时间。";
				mes "之后再和我谈谈，我们还能回到你的心中……";
				mes "";
				mes "";
				mes "";
				mes "";
				close;
			}
			if (ismounting()) {
				mes "[玛雅]";
				mes "你正骑着坐骑宠物，不能转职。";
				mes "请卸下坐骑宠物后再试！";
				mes "";
				close;
			}
			mes "[玛雅]";
			mes "那么开始仪式吧。这些物品将赋予你借用死去战士力量，";
			mes "并在战斗中将力量借给朋友的能力。";
			mes "";
			mes "";
			mes "";
			mes "";
			next;
			mes "[玛雅]";
			mes "这朵永恒玫瑰会代替你枯萎……";
			mes "";
			specialeffect EF_MAPPILLAR2,AREA,"Maia#link2";
			next;
			mes "[玛雅]";
			mes "这朵永恒玫瑰会代替你枯萎……";
			mes "不朽心脏会代替你的心脏停止泵血。";
			mes "";
			mes "";
			next;
			mes "[玛雅]";
			mes "这朵永恒玫瑰会代替你枯萎……";
			mes "不朽心脏会代替你的心脏停止泵血。";
			mes "这颗钻石会代替你的凡人躯体化为尘埃。";
			mes "";
			mes "";
			next;
			mes "[玛雅]";
			mes "渴望继续战斗的死者……";
			mes "会为你而战！明智且正当地使用灵魂链接者的力量。";
			mes "";
			mes "";
			mes "";
			next;
			if (SkillPoint) {
				mes "^0000ff你还有未使用的技能点。请用完所有技能点后再试！^000000";
				close;
			}
			completequest 6008;
			callfunc "Job_Change",Job_Soul_Linker;
			callfunc "F_ClearJobVar";	// clears all job variables for the current player
			set SOUL_Q,0;
			mes "[玛雅]";
			mes "祝你新生活好运。";
			mes "和盟友并肩，灵魂会保护你，帮助你战斗。";
			mes "朋友，暂时告别了。";
			mes "";
			mes "";
			close2;
			set getvariableofnpc(.SoulLinkerTest,"Kid#link1"),0;
			donpcevent "Timer#link3::OnDisable";
			warp "morocc",157,47;
			end;
		}
		set getvariableofnpc(.SoulLinkerTest,"Kid#link1"),0;
		mes "[玛雅]";
		mes "嗯……？";
		mes "你来这里的时间还没到。";
		mes "我们回梦罗克吧……";
		mes "";
		mes "";
		close2;
		warp "morocc",157,47;
		end;
	}
	set getvariableofnpc(.SoulLinkerTest,"Kid#link1"),0;
	if (Class == Job_Soul_Linker) {
		mes "[玛雅]";
		mes "现在是时候走向广阔世界了！";
		mes "持续对抗邪恶的战斗中一定需要更多灵魂链接者……";
		mes "";
		mes "";
	}
	else {
		mes "[玛雅]";
		mes "真奇怪……";
		mes "你不该在这里。";
		mes "让我带你回梦罗克……";
		mes "";
	}
	close2;
	warp "morocc",157,47;
	end;
}

job_soul,35,30,6	duplicate(SLTester)	Maia#link6	716

job_soul,30,35,6	script	Monk Spirit#link4	827,{
	if (SOUL_Q == 2) {
		mes "[僧侣灵魂]";
		mes "我是谁……？";
		mes "我想……我想";

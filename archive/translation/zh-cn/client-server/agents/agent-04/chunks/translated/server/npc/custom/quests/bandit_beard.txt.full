//===== rAthena Script ======================================= 
//= Bandit Beard Quest
//===== By: ================================================== 
//= Mega Man Expert & Lupus
//===== Current Version: ===================================== 
//= 1.3
//===== Compatible With: ===================================== 
//= rAthena Project
//===== Description: ========================================= 
//= A harmless quest for a simply item w/o any bonuses "Bandit Beard"
//===== Additional Comments: ================================= 
//= Fully working.
//= 1.0 First release
//= 1.1 Fixed some exploits, bugs and typos. Optimized 8) [Lupus]
//= 1.1b fixed some typos
//= 1.2 fixed donpcevent label [Lupus]
//= 1.3 Removed duplicates [L0ne_W0lf]
//============================================================

umbala,126,129,4	script	Bearded Man#bandit	120,{
	if(BEARD_QUEST == 4 ) goto L_MAKE;
	if(BEARD_QUEST >= 5 ) goto L_DONE;
	if(BEARD_QUEST >= 1 ) goto L_THREAD;

	mes "[Bearded Man]";
	mes "胡子！来看看漂亮的胡子！";
	mes "想要一把胡子吗？";
	next;
	menu "是的，我想要一些毛发！",-,"不用了，太恶心了！",M_NO;

	mes "[Bearded Man]";
	mes "呵呵～所以您想要胡须。";
	emotion ET_SMILE;
	mes "我本来可以给您胡子，但它们并不便宜。";
	mes "事实上我只剩一把了……";
	mes "但我不卖它。";
	mes "不过别生气！我可以为您制作一把。";
	next;
	set BEARD_QUEST,1;
L_THREAD:
	mes "[Bearded Man]";
	mes "制作胡子需要一些 ^8080FF线^000000。";
	mes "去伊兹鲁德找我的朋友拿一些 ^8080FF线^000000。";
	next;

	mes "[Bearded Man]";
	mes "另外，我还需要您为胡子收集一些东西。";
	mes "它们是：";
L_LIST:
	mes "^8080FF橡皮筋^000000";
	mes "^8080FF5 张动物皮^000000";
	mes "^8080FF黑色染料^000000";
	mes "^8080FF爷爷胡子^000000";
	mes "^8080FF100 个黏稠液体^000000";
	mes "^8080FF中和剂^000000";
	mes "以及一颗 ^8080FF2 克拉钻石^000000";
	close;

M_NO:
	mes "[Bearded Man]";
	mes "好吧，随您便！";
	emotion ET_ANGER;
	close;

L_DONE:
	mes "[Bearded Man]";
	mes "抱歉，每个人只能制作一把。";
	mes "我们不想出现太多胡子，对吧？";
	emotion ET_KIK;
	close;

L_MAKE:
	mes "[Bearded Man]";
	mes "让我们为您制作胡子吧！";
	next;
	if(countitem(7200) < 1 || countitem(919) < 1 ||	countitem(983) < 1 || countitem(2241) < 1 ||
	countitem(938) < 100 || countitem(973) < 1 || countitem(731) < 1) goto L_NOITEMS;
	delitem 7200, 1;
	delitem 919, 1;
	delitem 983, 1;
	delitem 2241, 1;
	delitem 938, 100;
	delitem 973, 1;
	delitem 731, 1;
	mes "^8080FF～您看到他正在裁剪并缝合胡子～^000000";
	next;
	mes "^8080FF～他把做好的胡子递给您～^000000";
	next;
	getitem 2237, 1;
	set BEARD_QUEST, 5;
	mes "[Bearded Man]";
	mes "祝您今天愉快！";
	emotion ET_KIK;
	close;

L_NOITEMS:
	mes "[Bearded Man]";
	mes "怎么回事！没有物品我无法制作胡子！";
	mes "这是清单：";
	emotion ET_HUK;
	goto L_LIST;
}  

//Master Tailor----------
izlude_in,123,175,4	script	Master Tailor#bandit	50,{
	mes "[Master Tailor]";
	mes "晚上好！我是裁缝大师！";
	if(BEARD_QUEST != 1 ) close;

	next;
	mes "[Master Tailor]";
	mes "什么？胡子男派您来的……";
	mes "很抱歉，^8080FF线^000000已经用完了。";
	mes "不过我有进货地址。";
	mes "就在艾尔迪巴兰卡普拉公司仓库区。";
	mes "地址是：艾尔迪巴兰 59, 221";
	mes "回头见。";
	set BEARD_QUEST, 2;
	close;
}
// Kafra Thread Clerk---
aldeba_in,70,179,5	script	Kafra Clerk#bandit	113,{
	mes "[Kafra Clerk]";
	if(BEARD_QUEST == 3 ) goto L_REPEAT;
	if(BEARD_QUEST > 3 ) goto L_DONE;

	mes "我能为您做些什么？";
	next;
	if(BEARD_QUEST == 2 ) goto L_DELIVERY;

	menu "箱子里有什么？",-,"没什么。",M_NOPE;

	mes "[Kafra Clerk]";
	mes "箱子是空的。";
M_NOPE:
	close;

L_DELIVERY:

	mes "[Kafra Clerk]";
	mes "抱歉，我们还没有收到任何^8080FF线^000000。";
	mes "为了安全，货运被推迟了。";
	mes "我们的^8080FF线^000000来自艾尔贝塔，但怪物一直袭击商人。";
	next;
	mes "[Kafra Clerk]";
	mes "这些怪物以前从未这样做过。";
	mes "也许和天气变暖有关。";
	mes "请帮帮我们！";
	set BEARD_QUEST,3;
	next;
	mes "[Kafra Clerk]";
L_REPEAT:
	mes "对了，那个线商人大概在艾尔贝塔 60, 100 附近……";
L_DONE:
	mes "谢谢您！";
	close;
}

//Thread Merchant ------
alberta,65,123,6	script	Man#bandit	85,{
	if(BEARD_QUEST == 3 && $@beardMobD) goto L_KILLED;
	if(BEARD_QUEST > 3) goto L_DONE;

	mes "[Thread Merchant]";
	mes "啊啊啊！！我总是无法把货物送到艾尔迪巴兰！";
	mes "总有虫子成群袭击我。";
	mes "它们偷走了我的所有物资和^8080FF线^000000。";
	next;
	mes "[Thread Merchant]";

	if(BEARD_QUEST != 3) mes "我该怎么办？";
	if(BEARD_QUEST != 3) close;

	if($@beardmob > 0) mes "杀了它们！快杀了它们！！！";
	if($@beardmob > 0) close;
	mes "您是来帮我的吗？";
	emotion ET_QUESTION;
	next;
	menu "是",-,"否",M_NO;

	mes "[Thread Merchant]";
	mes "哦，感谢诸神！";
	mes "只要您杀掉虫子，我就能完成送货。";
	next;
	mes "[Thread Merchant]";
	mes "哦，不！它们来了！！";
	emotion ET_PROFUSELY_SWEAT;
	donpcevent "BRDQ_MOBS::OnStart";
	close;

L_KILLED:
	set $@beardMobD,0;
	mes "[Thread Merchant]";
	mes "谢谢您杀死盗虫。";
	mes "这是装满^8080FF线^000000的箱子，聊表谢意。";
	set BEARD_QUEST,4;
	close;

L_DONE:
	mes "[Thread Merchant]";
	mes "再次感谢您！";
	emotion ET_THANKS;
	close;

M_NO:
	mes "[Thread Merchant]";
	mes "该怎么办……";
	close;
}

//mobsummons -------
alberta,1,1,1	script	BRDQ_MOBS	-1,{
OnStart:
	set $@beardMob,10;
	set $@beardMobD,0;
	monster "alberta",65,120,"Thief Bug Male",1054,1,"BRDQ_MOBS::OnDie";
	monster "alberta",66,120,"Thief Bug Male",1054,1,"BRDQ_MOBS::OnDie";
	monster "alberta",67,120,"Thief Bug Male",1054,1,"BRDQ_MOBS::OnDie";
	monster "alberta",68,120,"Thief Bug Male",1054,1,"BRDQ_MOBS::OnDie";
	monster "alberta",66,121,"Thief Bug Male",1054,1,"BRDQ_MOBS::OnDie";
	monster "alberta",67,121,"Thief Bug Male",1054,1,"BRDQ_MOBS::OnDie";
	monster "alberta",68,121,"Thief Bug Male",1054,1,"BRDQ_MOBS::OnDie";
	monster "alberta",66,122,"Thief Bug Male",1054,1,"BRDQ_MOBS::OnDie";
	monster "alberta",67,122,"Thief Bug Male",1054,1,"BRDQ_MOBS::OnDie";
	monster "alberta",68,122,"Thief Bug Male",1054,1,"BRDQ_MOBS::OnDie";
	end;
OnDie:
	set $@beardmob, $@beardmob - 1;
	if($@beardmob > 0) end;
	set $@beardMobD,1;
	end;
On1201:
On0001:
	set $@beardMob,0;
	set $@beardMobD,0;
	end;
}

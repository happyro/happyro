que_ng,182,85,3	script	Garrison	109,{

	if(BaseJob != Job_Gunslinger)
	{
		mes "[加里森]";
		mes "你不是枪手。";
		mes "你打扰我工作了。走吧。";
		close;
	}
	else if(BaseLevel < 55)
	{
		mes "[加里森]";
		mes "我叫加里森，是制作枪械的大师。";
		mes "我制作的枪也叫加里森。 我这样命名是因为加里森和我一样酷且完美。";
		next;
		mes "[加里森]";
		mes "要不要委托我制作一把加里森？";
		next;
		callsub SubGarrison;
	}
	switch(gun_gs)
	{
		case 0:
			if(countitem(13104) < 1)
			{
				mes "[加里森]";
				mes "我叫加里森，是制作枪械的大师。";
				mes "我制作的枪也叫加里森。 我这样命名是因为加里森和我一样酷且完美。";
				next;
				mes "[加里森]";
				mes "你是来委托我制作加里森的吗？";
				next;
				callsub SubGarrison;
			}
			mes "[加里森]";
			mes "嗯~ 怎么了？";
			mes "你是来要武器的吗？";
			next;
			switch( select( "I need a Garrison.","Not really.","Cancel") )
			{
				case 1:
					mes "[加里森]";
					mes "哦~ 欢迎！";
					mes "人人都需要我~！";
					mes "这证明我的枪加里森是最好的。";
					mes "现在要我制作一把吗？";
					next;
					callsub SubGarrison;

				case 2:
					mes "[加里森]";
					mes "嗯~ 你看起来漫无目的地闲逛。";
					mes "有时间的话能帮我个忙吗？";
					next;
					mes "["+strcharinfo(0)+"]";
					mes "什么事？";
					next;
					mes "[加里森]";
					mes "嗯~ 我最近收到信，说我制作的六发左轮有很多瑕疵品。";
					next;
					mes "[加里森]";
					mes "我是完美主义者，但年纪大了眼神变差，可能卖出了瑕疵六发左轮。";
					next;
					mes "[加里森]";
					mes "所以我希望有人能找到备件，用来替换瑕疵六发左轮的零件。";
					next;
					mes "[加里森]";
					mes "如果你帮我，我就给你手上的加里森开洞。怎么样？";
					mes "";
					next;
					mes "[加里森]";
					mes "提醒一下，开洞会清除精炼等级和卡片。请谨慎决定。";
					next;
					switch( select( "I don't like the sound of this.","Ok, I'll try it out.") )
					{
						case 1:
							mes "[加里森]";
						mes "嗯，我明白了。";
						mes "那我找别人吧。";
						mes "";
							close;

						case 2:
							mes "[加里森]";
						mes "哦，真的吗？太感谢了。";
						mes "这些是制作备件所需材料……";
						mes "";
							next;
							mes "[加里森]";
						mes "10 个钢铁、1 个艾尔块、10 个神之金属、30 个煤炭和 10 个生锈螺丝。";
						mes "数量必须准确，别忘了。";
							set gun_gs,1;
							close;
					}

				case 3:
					mes "[加里森]";
					mes "嗯……下次再来找我。";
					close;
			}

		case 1:
			if((countitem(999) < 10) || (countitem(7317) < 10) || (countitem(1011) < 10) || (countitem(1003) < 30) || (countitem(985) < 1))
			{
				mes "[加里森]";
				mes "10 个钢铁、1 个艾尔块、10 个神之金属、30 个煤炭和 10 个生锈螺丝。";
				mes "别忘了，数量必须准确。";
				close;
			}
			mes "[加里森]";
			mes "哦~ 你带着我需要的东西回来了~";
			mes "太感谢了。";
			mes "哦……还有件事想请你帮忙。呃……";
			next;
			mes "[加里森]";
			mes "我制作备件后需要交给另一个人，但这里还有很多工作。";
			next;
			mes "[加里森]";
			mes "抱歉，我希望你能把这些材料制作的备件送给那个人。";
			next;
			mes "[加里森]";
			mes "你送货时，我会按约定准备给加里森开洞。";
			next;
			mes "["+strcharinfo(0)+"]";
			mes "-嗯，我不想做，但还是做吧。-";
			next;
			mes "["+strcharinfo(0)+"]";
			mes "好的。";
			next;
			mes "[加里森]";
			mes "哦，太感谢了。";
			mes "把这个交给住在莱岔隆贫民窟的雷比。";
			next;
			mes "["+strcharinfo(0)+"]";
			mes "你从加里森处收到货物。";
			mes "把它们交给住在莱岔隆贫民窟的雷比。";
			delitem 999,10;
			delitem 1011,10;
			delitem 7317,10;
			delitem 985,1;
			delitem 1003,30;
			set gun_gs,2;
			close;

		case 2:
			mes "["+strcharinfo(0)+"]";
			mes "你从加里森处收到货物。";
			mes "把它们交给住在莱岔隆贫民窟的雷比。";
			close;

		case 3:
			mes "[加里森]";
			mes "哦～旅途怎么样？";
			next;
			mes "["+strcharinfo(0)+"]";
			mes "呀啊~";
			mes "我差点死了！！！";
			mes "那人见到我就想攻击，幸好我死里逃生！";
			next;
			mes "[加里森]";
			mes "啊~ 糟糕。";
			mes "没想到寄信的人竟然计划暗杀我。他可能是敌对公会派来的……";
			next;
			mes "[加里森]";
			mes "看来我无意中让你执行了非常危险的任务。";
			next;
			mes "[加里森]";
			mes "真的很抱歉。";
			mes "你可能也知道，到处都有坏人计划攻击教授和枪手公会。";
			next;
			mes "[加里森]";
			mes "把这当作枪手训练的一部分吧。";
			next;
			mes "[加里森]";
			mes "很抱歉发生了这些。";
			mes "不过，我会按约定给你的加里森开洞……";
			next;
			if(countitem(13104) < 1)
			{
				mes "[加里森]";
				mes "嗯？唉。";
				mes "你不在时把枪卖了吗？";
				mes "我说过给你的枪开洞，但没说给不在这里的枪开洞。";
				mes "拿回你的加里森再回来。";
				set gun_gs,4;
				close;
			}
			mes "[加里森]";
			mes "让我看看~";
			mes "*铛* *铛* *砰* *咚*";
			mes "这是改造后的加里森。";
			mes "好好使用。";
			delitem 13104,1;
			getitem 13105,1;
			set gun_gs, 5;
			close;
		case 4:
			if(countitem(13104) < 1)
			{
				mes "[加里森]";
				mes "拿回你的加里森再回来。";
				close;
			}
			mes "[加里森]";
			mes "啊，就在这里。";
			mes "这是改造后的加里森。";
			mes "好好使用。";
			delitem 13104, 1;
			getitem 13105, 1;
			set gun_gs,5;
			close;
		case 5:
			mes "[加里森]";
			mes "嗯～你又回来了～";
			mes "怎么了？";
			mes "你是需要武器才回来的吗？";
			mes "你需要什么？";
			next;
			switch( select( "加里森","给加里森开槽","取消"))
			{
				case 1:
					callsub SubGarrison;
				case 2:
					callsub SubGarrison_;
				case 3:
					mes "[加里森]";
					mes "下次见～";
					close;
			}
	}

SubGarrison:
	mes "[加里森]";
	mes "要制作一把加里森，我需要……";
	mes "50 个钢铁、3 个铝、";
	mes "1 个神之金属、50 个煤炭、";
	mes "20 个生锈螺丝，";
	mes "以及 30,000 Zeny 的费用。";
	mes "那么，你要制作一把吗？";
	next;
	switch( select( "下次再说。","好的，马上帮我制作。","取消") )
	{
		case 1:
			mes "[加里森]";
			mes "嗯～白让我激动一场～";
			mes "考虑好了再来找我。";
			close;

		case 2:
			if((countitem(999) < 50) || (countitem(7317) < 20) || (countitem(984) < 1) || (countitem(1003) < 50) ||(countitem(985) < 3) )
			{
				mes "[加里森]";
				mes "你没有带足够的材料。";
				mes "要制作一把加里森，我需要……";
				mes "50 个钢铁、3 个铝、";
				mes "1 个神之金属、50 个煤炭、";
				mes "50 个生锈螺丝，";
				mes "以及 30,000 Zeny 的费用。";
				mes "别忘了。";
				close;
			}
			else if(Zeny < 30000)
			{
				mes "[加里森]";
				mes "你需要更多 Zeny～！";
				mes "更多 Zeny！！";
				close;
			}
			else if(checkweight(13104,1) == 0)
			{
				mes "[加里森]";
				mes "你的物品栏没有空间";
				mes "存放我的作品了。";
				mes "请先清理物品栏，";
				mes "然后再来找我。";
				close;
			}
			mes "[加里森]";
			mes "嗯，看起来材料和 Zeny 数量都正确。";
			mes "这是你的加里森～";
			mes "下次还需要的话，再来找我～";
			delitem 984,1; //Oridecon
			delitem 985,3; //Elunium
			delitem 999,50; //Steel
			delitem 1003,50; //Coal
			delitem 7317,20; //Rusty Screw
			set Zeny,Zeny-30000;
			getitem 13104,1; //Garrison
			close;

		case 3:
			mes "[加里森]";
			mes "下次见～";
			close;
	}

SubGarrison_:
	mes "[加里森]";
	mes "要给加里森开槽，我需要";
	mes "10 个钢铁、1 个铝、";
	mes "10 个神之金属、30 个煤炭、";
	mes "10 个生锈螺丝，";
	mes "以及 1 把加里森。";
	mes "那么，你要开槽吗？";
	next;
	switch( select( "下次再说。","好的，马上帮我制作。","取消" ))
	{
		case 1:
			mes "[加里森]";
			mes "白让我激动一场～";
			mes "考虑好了再来找我。";
			close;

		case 2:
			if((countitem(999) < 10) || (countitem(7317) < 10) || (countitem(1011) < 10) || (countitem(1003) < 30) || (countitem(985) < 1) || (countitem(13104) < 1))
			{
				mes "[加里森]";
				mes "你没有带足够的材料。";
				mes "要给加里森开槽，我需要";
				mes "10 个钢铁、1 个铝、";
				mes "10 个神之金属、30 个煤炭、";
				mes "10 个生锈螺丝，";
				mes "以及 1 把加里森。";
				mes "别忘了。";
				close;
			}
			else if(checkweight(13105,1) != 1)
			{
				mes "[加里森]";
				mes "你的物品栏没有空间";
				mes "存放我的作品了。";
				mes "请先清理物品栏，";
				mes "然后再来找我。";
				close;
			}
			mes "[加里森]";
			mes "嗯，看起来材料和 Zeny 数量都正确。";
			mes "这是已经开槽的改造加里森。";
			mes "下次还需要的话，再来找我～";
			delitem 999, 10;
			delitem 1011, 10;
			delitem 7317, 10;
			delitem 985, 1;
			delitem 1003, 30;
			delitem 13104, 1;
			getitem 13105, 1;
			close;
		
		case 3:
			mes "[加里森]";
			mes "下次见～";
			close;
	}
}

lighthalzen,322,247,6	script	Ravey	86,{

	if(gun_gs == 2)
	{
		mes "["+strcharinfo(0)+"]";
		mes "打扰了，你好。";
		mes "我是来给你送故障枪械的替换零件……";
		next;
		mes "[Ravey]";
		mes "你！！！";
		mes "喝啊～！！";
		mes "去死！！！";
		set gun_gs,3;
		percentheal 100,0;
		percentheal -90,0;
		next;
		mes "["+strcharinfo(0)+"]";
		mes "-名叫雷比的男子突然发动攻击，仿佛就在等你说出枪手这个词……-";
		mes "-你差点丧命。-";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "你头也不回地逃走了。";
		mes "赶快回加里森那里去。-";
		close;
	}
	if(gun_gs == 3)
	{
		mes "["+strcharinfo(0)+"]";
		mes "-名叫雷比的男子突然发动攻击，仿佛就在等你说出枪手这个词……-";
		mes "-你差点丧命。-";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "赶快回加里森那里去。-";
		close;
	}
	mes "[Ravey]";
	mes "呃……";
	mes "呃……呃……";
	mes "......";
	close;
}


que_ng,187,163,3	script	Ingrid	744,{

	if(BaseJob != Job_Gunslinger)
	{
		mes "[Ingrid]";
		mes "你好吗！";
		mes "我被任命为新的枪手武器制造师。我叫英格丽德。";
		next;
		mes "[Ingrid]";
		mes "不过你似乎不是枪手公会成员，所以我没法帮你。抱歉。";
		close;
	}
	switch(gun_inf)
	{
		case 0:
			mes "[Ingrid]";
			mes "你好吗！";
			mes "我被任命为新的枪手";
			mes "武器制造师。我叫英格丽德。";
			mes "很高兴为你服务！";
			next;
			mes "[Ingrid]";
			mes "我开始工作还没多久，";
			mes "但会尽力帮助你。";
			mes "";
			mes "";
			next;
			mes "[Ingrid]";
			mes "啊……我感觉好焦虑。";
			mes "现在我负责为顾客制造名为炼狱的武器。";
			next;
			mes "[英格丽德]";
			mes "炼狱是我们公会实验室制造的最先进武器。";
			next;
			mes "[英格丽德]";
			mes "它拥有惊人威力和射程，符合人体工学的设计便于握持，能显著减少射击时的后坐力。";
			mes "这配得上枪手终极武器之名。";
			mes "呼……呼……";
			next;
			mes "["+strcharinfo(0)+"]";
		mes "你对它了解得真多。";
		mes "";
		mes "";
			mes ".....";
			next;
			mes "[Ingrid]";
			mes "啊，当然~";
			mes "我就是这件武器的设计者……";
			next;
			mes "["+strcharinfo(0)+"]";
		mes "哇哦~ 太厉害了~";
			next;
		mes "[英格丽德]";
		mes "啊，糟糕……";
		mes "我是不是炫耀过头了？";
		mes "和塞丽娜教授相比我还差得远。";
			next;
		mes "[英格丽德]";
		mes "其实我也想成为枪手，但因为身体缺陷和意志薄弱，只好放弃。";
			next;
		mes "[英格丽德]";
		mes "申请枪手时，幸运地被塞丽娜教授发现才能。在她帮助下，我现在负责枪手武器的制造和销售。";
			next;
		mes "[英格丽德]";
		mes "没能成为枪手我仍很遗憾，但至少和我一起参加测试的弟弟通过了，成为枪手。";
			next;
		mes "[英格丽德]";
		mes "我很高兴，虽然我失败了，弟弟仍实现了我们的梦想。";
			next;
		mes "[英格丽德]";
		mes "哈哈~ 你都没问，我却告诉你这么多。";
		mes "抱歉。";
			next;
			mes "["+strcharinfo(0)+"]";
	// 行数占位：保持与官方源文件物理行数一致
	// 行数占位：保持与官方源文件物理行数一致

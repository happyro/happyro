prt_in,63,69,3	script	Dietrich#ns_prt	4_M_02,{
	mes "[" + strnpcinfo(1) + "]";
	mes "我们出售和交换用于冶炼的各种矿石。";
	next;
	switch( select( "查看基础冶炼矿石", "查看高级冶炼矿石", "查看以太冶炼矿石", "取消" ) ) {
	case 1:
		mes "[" + strnpcinfo(1) + "]";
		mes "普拉康和埃姆维泰拉康可用于冶炼低级武器。";
		close2;
		callshop "market_refine_" + strnpcinfo(4);
		end;
	case 2:
		mes "[" + strnpcinfo(1) + "]";
		mes "我们正在提纯铝石或奥里德矿石，或将其交换为布拉迪姆或卡尼乌姆。";
		close2;
		callshop "barter_refine_1";
		end;
	case 3:
		mes "[" + strnpcinfo(1) + "]";
		mes "我们向现有冶炼矿石中加入埃特尔粉末，替换为含以太的冶炼矿石。";
		close2;
		callshop "barter_refine_2";
		end;
	case 4:
		mes "[" + strnpcinfo(1) + "]";
		mes "如果缺少冶炼材料，随时来。";
		close;
	}
	end;

OnInit:
	setunittitle getnpcid(0), "<Responsible for smelting products>";
	end;
}

	}
	mes "你需要^ff9999"+getitemname(.@material)+"^000000和^ff9999"+.@price+"^000000 Zeny。你有吗？";
	next;
	if(select("有！！:算了！！") == 2) {
		mes "[Clink]";
		mes "我就知道！！";
		mes "我就知道你不值得让我用魔法精炼锤。";
		close;
	}
	if (getequippercentrefinery(.@part) < 100) {
		mes "[Clink]";
		mes "哇！！";
		mes "这件"+.@type$+"已经精炼得相当高了，对吧？";
		mes "你知道它可能会损坏，对吧？";
		next;
		mes "[Clink]";
		mes "如果你弄坏了"+.@type$+", 就再也不能使用。";
		mes "卡片和附魔效果……";
		mes "^ff0000整个东西都会消失^000000。";
		mes "你还要继续吗~？";
		next;
		if(select("当然！！:算了！！") == 2) {
			mes "[Clink]";
			mes "我就知道！！";
			mes "连这一步都迈不过去。别想精炼了……";
			close;
		}
	}
	if (countitem(.@material) == 0 || Zeny < .@price) {
		mes "[Clink]";
		mes "喂！！我不是告诉过你";
		mes "你需要^ff9999"+getitemname(.@material)+"^000000和^ff9999"+.@price+"^000000 Zeny？？！！";
		close;
	}
	delitem .@material,1;
	Zeny = Zeny-.@price;

	// anti-hack
	if (callfunc("F_IsEquipIDHack", .@part, .@refineitemid) || callfunc("F_IsEquipCardHack", .@part, .@card[0], .@card[1], .@card[2], .@card[3]) ||
		callfunc("F_IsEquipRefineHack", .@part, .@refinerycnt)) {
		mes "[Clink]";
		emotion ET_FRET;
		mes "等一下……";
		mes "你以为我傻吗？！";
		mes "你趁我没注意换了物品！滚出去！";
		close;
	}

	if (getequippercentrefinery(.@part) <= rand(100)) {
		failedrefitem .@part;
		mes "[Clink]";
		mes "哭泣之锤！！哭吧！！！";
		next;
		switch(rand(1,5)) {
			case 1: emotion ET_CRY; break;
			case 2: emotion ET_PROFUSELY_SWEAT; break;
			case 3: emotion ET_KEK; break;
			case 4: emotion ET_SCRATCH; break;
			case 5: emotion ET_BIGTHROB; break;
		}
		mes "[Clink]";
		mes "嗯？！失败了？！";
		next;
		mes "[Clink]";
		mes "啊~全都~坏了……？真遗憾~";
		next;
		mes "[Clink]";
		mes "嘿……！！再给我一个。";
		mes "这不可能。";
		mes "我的锤子怎么会精炼失败？";
		close;
	}
	successrefitem .@part;
	mes "[Clink]";
	mes "哭泣之锤！！哭吧！！！";
	next;
	emotion ET_CHUP;
	mes "[Clink]";
	mes "好！！完美！！";
	mes "没有我不能精炼的东西";
	mes "用这把特殊的锤子。";
	mes "你可以赞美我！！";
	mes "真是美好的一天！！";
	close;
}


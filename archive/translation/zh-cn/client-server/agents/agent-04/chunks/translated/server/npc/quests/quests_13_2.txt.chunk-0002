spl_in01,32,306,3	script	Splendide Guard#ep13md01	447,2,2,{
	if (checkweight(1201,2) == 0) {
		mes "等一下！！";
		mes "你携带的物品太多。";
		mes "无法领取这个。";
		mes "减轻负重后";
		mes "再试。";
		close;
	}
	if ((isequipped(2782) == 1) && (ep13_2_rhea > 99)) {
		if (ep13_mdrama == 0) {
			mes "[斯普兰迪德守卫]";
			mes "外来者？";
			mes "外来者越来越频繁地来。";
			next;
			mes "[斯普兰迪德守卫]";
			mes "看来上级允许你进入，所以我也不阻拦。";
			next;
			mes "[阿克]";
			mes "我叫阿克。";
			mes "顺便问一下……你能听懂我说话吗？";
			next;
			switch(select("是的:摇头")) {
			case 1:
				mes "[阿克]";
				mes "什么？你刚才说“是的”？";
				mes "真不敢相信我们能互相理解！";
				mes "你什么时候学会我们的语言？";
				mes "你的种族叫什么？";
				next;
				mes "- 我向阿克展示戒指，并解释自己如何来到这里…… -";
				next;
				mes "[阿克]";
				mes "所以……嗯，原来如此……";
				mes "那次巨大冲击和神秘爆炸的源头……";
				next;
				mes "[阿克]";
				mes "真有趣的故事。";
				mes "难怪你们人类到处探索……";
				next;
				mes "[阿克]";
				mes "现在我明白你不是马努克巨人派来的。";
				mes "谢谢你告诉我这些有趣的故事。";
				set ep13_mdrama,1;
				close;
			case 2:
				mes "[阿克]";
				mes "哦？是这样吗？";
				mes "果然我们使用不同语言……";
				mes "真令人沮丧。";
				close;
			}
		}
		else if (ep13_mdrama == 1) {
			mes "[阿克]";
			mes "顺便说，你……";
			mes "不，没什么……";
			mes "你叫什么名字？";
			next;
			select("" + strcharinfo(0) + "");
			mes "[阿克]";
			mes "啊，对了。" + strcharinfo(0) +"!";
			mes "发音真奇怪。";
			mes "我可能会念错，请见谅……";
			next;
			mes "[阿克]";
			mes "总之，我想请你帮个忙，可以吗？";
			next;
			switch(select("什么忙？:现在不行")) {
			case 1:
				mes "[阿克]";
				mes "嗯……啊……是……";
				mes "有点……复杂……";
				next;
				mes "- 阿克环顾四周确认没有其他人，确定只有你后低声继续讲述。 -";
				next;
				mes "[阿克]";
				mes "说实话，我担心一位朋友。她未经许可离开，说要去看看你们的营地，从那以后就没回来。";
				next;
				mes "[阿克]";
				mes "但我不能离开岗位找她，因为我必须守护这里存放的研究数据。";
				next;
				mes "[阿克]";
				mes "她未经许可离开，我甚至无法向上级报告……只会变成更大的问题。";
				next;
				mes "[阿克]";
				mes "想到这件事我就担心……";
				mes "事实上，我们尽量不与马努克巨人接触，所以彼此远离对方领地。";
				next;
				mes "[阿克]";
				mes "你们的营地位于两个种族之间的中立区……";
				next;
				mes "[阿克]";
				mes "如果她接近对方领地，可能去了雪原……";
				mes "这会让寻找她更加困难……";
				next;
				mes "[阿克]";
				mes "马努克巨人可能误以为这是挑衅……不是吗？";
				next;
				mes "[" + strcharinfo(0) + "]";
				mes "所以……你想让我寻找你的朋友，对吗？";
				mes "因为情况复杂，你自己无法寻找，对吗？";
				next;
				mes "[阿克]";
				mes "正是！";
				mes "你真敏锐。";
				next;
				switch(select("好，我会做:抱歉，帮不了你")) {
				case 1:
					mes "[" + strcharinfo(0) + "]";
					mes "不过要找她，我需要更多信息。";
					next;
					mes "[阿克]";
					mes "不用担心……";
					mes "^4d4dff泰拉^000000习惯用植物打结标记目的地。";
					next;
					mes "[阿克]";
					mes "她这样做是为了不迷路。";
					mes "找到打结植物留下的踪迹，就能找到她。";
					next;
					mes "[阿克]";
					mes "寻找它们可能很难，但总比什么都不做强……";
					mes "拜托了。";
					next;
					mes "[阿克]";
					mes "还有，请对其他拉斐尔保密。";
					next;
					mes "[阿克]";
					mes "记住，" + strcharinfo(0) + "……一定要保密……";
					mes "拜托，找到她。";
					set ep13_mdrama,2;
					setquest 7056;
					close;
				case 2:
					mes "[阿克]";
				mes "确实是无理的请求……";
				mes "你也被派来执行任务……";
				mes "是我考虑不周……";
					close;
				}
			case 2:
				mes "[阿克]";
				mes "这样啊，当然。";
				mes "你是来执行自己的任务的……";
				close;
			}
		}
		else if (ep13_mdrama == 2) {
			mes "[阿克]";
			mes "^4d4dff泰拉^000000习惯用植物打结标记目的地。";
			mes "寻找她时记住这一点。别告诉其他拉斐尔她失踪了。";
			next;
			mes "[阿克]";
			mes strcharinfo(0) + "，我只能向你求助……";
			mes "请帮我这个忙。";
			close;
		}
		else if ((ep13_mdrama > 3) && (ep13_mdrama < 7)) {
			mes "[阿克]";
			mes "找到什么了吗？";
			mes "找到打结植物了吗？";
			mes "没错，那就是";
			mes "泰拉留下的标记。";
			next;
			mes "[阿克]";
			mes "继续寻找，";
			mes "帮我找到她。";
			close;
		}
		else if (ep13_mdrama == 7) {
			mes "[阿克]";
			mes "啊，见到你真好！";
			mes "我现在该怎么办？！";
			next;
			select("什么？发生了什么？");
			mes "- 阿克似乎因为某事陷入混乱。 -";
			next;
			mes "[阿克]";
			mes "泰拉……";
			next;
			mes "[阿克]";
			mes "泰拉回来了！！！";
			mes "但她浑身都是伤……";
			next;
			select("浑身是伤？");
			mes "[阿克]";
			mes "她甚至没有接受治疗！";
			mes "就这样带着疲惫的身体拿走了钙矿！";
			next;
			mes "[阿克]";
			mes "连理由都没告诉我！";
			mes "我叫她别去，可她不听！";
			mes "一切发生得太突然了。";
			next;
			mes "[阿克]";
			mes "" + strcharinfo(0) + "!";
			mes "我现在该怎么办？";
			mes "我应该做什么？";
			mes "泰拉又离开了，而且还受了伤……";
			next;
			mes "[阿克]";
			mes "而我只能站在这里……什么也没做。";
			next;
			select("你有很强的责任感。 ");
			mes "[阿克]";
			mes "……总之。";
			mes "我既没能阻止她，也没能跟上……";
			mes "现在怎么办……？";
			mes "她为什么要拿走钙矿……？";
			next;
			mes "- 你把洞穴巨人的事告诉阿克。 -";
			next;
			mes "[阿克]";
			mes "什么？事情是这样的吗？";
			mes "钙矿……对萨帕来说确实是珍贵矿石。";
			mes "他们使用精炼钙矿……";
			next;
			mes "[阿克]";
			mes "你说有萨帕受伤了？";
			mes "而且身体已经僵硬？";
			mes "不可能！";
			mes "泰拉！！";
			next;
			mes "- 阿克突然开始收拾装备。 -";
			set ep13_mdrama,8;
			close;
		}
		else if (ep13_mdrama == 8) {
			mes "[阿克]";
			mes "你发现萨帕的洞穴在哪里？";
			mes "我们调查周边时没发现那样的洞穴。";
			next;
			select("你想做什么？");
			mes "[阿克]";
			mes "你还不明白吗？";
			mes "我要出去找泰拉。她带走了钙矿，一定和那个萨帕有关。";
			next;
			select("你可以离开岗位吗？");
			mes "[阿克]";
			mes "这……";
			mes "……不行……";
			mes "可恶，那我该怎么办！！";
			next;
			mes "[" + strcharinfo(0) + "]";
			mes "我去。我最清楚那个洞穴在哪里。";
			mes "我会把她带回来。";
			mes "如果泰拉去了那里，我应该能找到她。";
			next;
			mes "[" + strcharinfo(0) + "]";
			mes "剩下的故事让泰拉亲自告诉我们。";
			mes "你必须守护这里，对吧？";
			mes "如果泰拉真的未经许可拿走钙矿……";
			next;
			mes "[阿克]";
			mes "上级不会坐视不管……";
			mes "抱歉要你帮忙……";
			mes "请去把她带回来……";
			set ep13_mdrama,9;
			changequest 7058,7059;
			close;
		}
		else if ((ep13_mdrama > 8) && (ep13_mdrama < 13)) {
			mes "[阿克]";
			mes "真的很抱歉把你卷进麻烦……";
			mes "……拜托，找到泰拉。";
			close;
		}
		else if (ep13_mdrama == 13) {
			mes "[阿克]";
			mes "什么？萨帕村里有受伤的拉斐尔？";
			mes "是泰拉吗？！她被那些萨帕混蛋抓住了？！";
			next;
			mes "[" + strcharinfo(0) + "]";
			mes "冷静。我没能确认被抓的拉斐尔是谁。";
			mes "而且他们似乎没有伤害她的打算。";
			next;
			mes "[" + strcharinfo(0) + "]";
			mes "他们还在寻找能治疗受伤拉斐尔的东西……";
			mes "如果带药给他们，也许能确认拉斐尔的身份。";
			next;
			mes "[" + strcharinfo(0) + "]";
			mes "我理解你的焦虑……但这是确认她身份的唯一办法。";
			next;
			mes "[" + strcharinfo(0) + "]";
			mes "我会带治疗伤口的物品，如果被抓的拉斐尔是泰拉，就把她带回来。";
			next;
			mes "[阿克]";
			mes "..........";
			mes "好吧，这似乎是目前最好的办法……";
			next;
			mes "[阿克]";
			mes "你知道‘世界树’吗？";
			mes "治疗伤口没有比世界树果实更好的东西……";
			mes "尤其是对我们拉斐尔来说……";
			next;
			mes "[阿克]";
			mes "如果有世界树果实，可以用来治疗那个拉斐尔……";
			mes "世界树是生命之树……根系连接着世间万物。";
			next;
			mes "[阿克]";
			mes "我有……";
			mes "……只有三颗世界树果实……";
			next;
			mes "[阿克]";
			mes "我会给你这些，但还不够……";
			mes "外面有一棵大树……世界树的根露在外面……应该在那里。";
			next;
			mes "[阿克]";
			mes "那里有时能找到世界树果实。";
			mes "再找几颗带回来。快！";
			set ep13_mdrama,14;
			getitem 607,3; //Yggdrasilberry
			changequest 7062,7063;
			close;
		}
		else if ((ep13_mdrama > 13) && (ep13_mdrama < 18)) {
			mes "[阿克]";
			mes "这片区域外围的沼泽附近有一条巨大树根。";
			mes "那里露出了生命之树的根。";
			next;
			mes "[阿克]";
			mes "你应该能在那里找到世界树果实。";
			next;
			mes "[阿克]";
			mes "至少需要 6～7 颗……";
			mes "……希望她平安……";
			next;
			mes "[阿克]";
			mes "收集完果实后立刻带到萨帕村！！！";
			mes "泰拉……请一定平安。";
			close;
		}
		else if ((ep13_mdrama > 17) && (ep13_mdrama < 25)) {
			mes "[阿克]";
			mes "……哦，泰拉在哪里……？";
			close;
		}
		else if (ep13_mdrama == 25) {
			mes "[阿克]";
			mes "" + strcharinfo(0) + "!!";
			mes "泰拉回来了！！！";
			mes "她完好无损地回来了！";
			mes "……她回来后一句话也没说，我让她去 Yai 休息……";
			next;
			mes "[阿克]";
			mes "如果方便，请过来一趟……";
			mes "泰拉的 Yai。";
			mes "也就是她的私人住所……位于这里的东南方。";
			mes "我想听听事情的详细经过。";
			set ep13_mdrama,26;
			changequest 7070,7071;
			close;
		}
		else if (ep13_mdrama == 26) {
			mes "[阿克]";
			mes "她离开期间发生了什么……？";
			mes "我想听听事情的详细经过……";
			mes "稍后请去泰拉的 Yai。";
			close;
		}
		else if (ep13_mdrama > 26) {
			mes "[阿克]";
			mes "非常感谢你为我们所做的一切。";
			mes "但我很担心泰拉。";
			mes "希望她能恢复原来的样子……";
			close;
		}
		else {
			mes "[阿克]";
			mes "啊～啊～站住……";
			mes "未经授权不得进入此区域。";
			close;
		}
	}
	else {
		if (ep13_mdrama > 0) {
			mes "[阿克]";
			mes "Yur,Dur AnoVa?";
			mes "Wha? Dieb OsaDur .. ";
			mes "ah..RuffThus NeAsh. man nesAsh OdesAlah ?";
			next;
			mes "- 我听不懂他说什么……天啊，真令人沮丧。-";
			close;
		}
		else {
			mes "[斯普兰迪德守卫]";
			mes "NeiVil !";
			mes "narNoth nesMush.";
			mes "AnuDur AmanDana Goth nar!";
			next;
			mes "- 我们似乎无法互相理解。-";
			close;
		}
	}
	end;

OnTouch:
	if (isequipped(2782) == 1) {
		if (ep13_mdrama < 1) {
			mes "[斯普兰迪德守卫]";
		mes "站住。";
		mes "除非获得许可，否则禁止进入此区域。";
		mes "尤其是像你这样的外来者。";
			close;
		}
	}
	else {
		mes "[斯普兰迪德守卫]";
		mes "Tal-!";
		mes "AnuDur AmanDana Goth nar!";
		mes "Agoltas Me...";
		next;
		mes "- 看来我们无法互相理解。这可能会很麻烦……-";
		close;
	}
	end;
}

spl_fild02,45,214,0	script	????#ep13_mdplant01	844,{
	if (ep13_mdrama == 2) {
		cutin "ep13_plant01",2;
		mes "这里很容易找到杂草……";
		mes "仔细一看，发现有一根打结的茎……";
		mes "看来这就是 Arc 告诉我的 Terra 留下的踪迹。";
		next;
		mes "一片打结的叶子指向^4d4dff南方^000000。";
		set ep13_mdrama,3;
		changequest 7056,7057;
		close2;
	}
	else if (ep13_mdrama > 2) {
		mes "这是 Terra 为记住回家的路留下的标记。";
		mes "一片打结的叶子指向^4d4dff南方^000000。";
		close2;
	}
	else {
		mes "这里很容易找到杂草……";
		mes "没什么特别的。";
		close2;
	}
	cutin "ep13_plant01",255;
	end;
}

spl_fild02,122,106,0	script	????#ep13_mdplant02	844,{
	if (ep13_mdrama > 2) {
		cutin "ep13_plant01",2;
		mes "这里很容易找到杂草……";
		mes "A closer look reveals that there's one knotted stem...";
		mes "看来这就是 Arc 告诉我的 Terra 留下的踪迹。";
		next;
		mes "一片打结的叶子指向^4d4dff东方^000000。";
		close2;
	}
	else {
		mes "这里很容易找到杂草……";
		mes "There's nothing too special about it.";
		close2;
	}
	cutin "ep13_plant01",255;
	end;
}

spl_fild02,329,191,0	script	????#ep13_mdplant03	844,{
	if (ep13_mdrama > 2) {
	cutin "ep13_plant01",2;
		mes "这里很容易找到杂草……";

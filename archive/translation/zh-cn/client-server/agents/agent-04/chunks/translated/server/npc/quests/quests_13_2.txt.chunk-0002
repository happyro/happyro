		if (.@rhea_ran5 == 3) {
			getitem 644,1; //Gift_Box
			mapannounce strcharinfo(3),strcharinfo(0) + " 捕获了一个礼盒。",bc_map,"0x00ffff";
		}
		set .@rhea_ran3,rand(1,500);
		if (.@rhea_ran3 == 3) {
			getitem 603,1; //Old_Blue_Box
			mapannounce strcharinfo(3),strcharinfo(0) + " 捕获了一个旧蓝箱。",bc_map,"0x00ffff";
		}
		set .@rhea_ran4,rand(1,3000);
		if (.@rhea_ran4 == 3) {
			getitem 617,1; //Old_Violet_Box
			mapannounce strcharinfo(3),strcharinfo(0) + " 捕获了一个旧紫箱。",bc_map,"0x44ff44";
		}
	}
	else {
		mes "水中有鱼在游。";
		close;
	}
	end;
}

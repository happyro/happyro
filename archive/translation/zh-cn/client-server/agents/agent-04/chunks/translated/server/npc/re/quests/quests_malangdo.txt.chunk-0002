			next;
			mes "[托马斯，村长]";
			mes "太多了，因为他们把所有访客都派到我这里。";
			next;
			mes "[托马斯，村长]";
			mes "你来得正好。去参加现在举行的^0000FF例会^000000。";
			mes "会议地点在^0000FF走廊尽头^000000。";
			set ma_tomas,1;
			setquest 11209;
			close2;
			cutin "",255;
			end;
		case 2:
			mes "[托马斯，村长]";
			mes "抱歉。";
			mes "请再来找我，虽然我不知道什么时候有空。";
			close2;
			cutin "",255;
			end;
		}
	} else if (ma_tomas == 1) {
		mes "[托马斯，村长]";
		mes "那么，接下来要搬到上面的 1000 个箱子……";
		cutin "ma_tomas02",2;
		next;
		mes "[托马斯，村长]";
		mes "有400箱物资要发出去……";
		mes "还有……";
		next;
		mes "[Samuel]";
		mes "上将！";
		mes "海鲈鱼、海蜇、海绵在右边整齐摆放！";
		mes "海藻和猕猴桃放下面！凤尾鱼和鳕鱼送到集合地点！剩下的按种类堆放在角落里！";
		emotion ET_HUK, getnpcid(0, "Samuel#mal");
		next;
		mes "[托马斯，村长]";
		mes "....";
		emotion ET_THINK;
		next;
		mes "[托马斯，村长]";
		mes "....";
		mes ".....";
		next;
		mes "[托马斯，村长]";
		mes "....";
		mes ".....";
		mes "......";
		next;
		mes "[托马斯，村长]";
		mes "你！！";
		mes "我告诉过你多少次了！ 喵～";
		mes "嗯？！";
		emotion ET_FRET;
		cutin "ma_tomas03",2;
		next;
		mes "[托马斯，村长]";
		mes "海参、海鞘、海葵放右边。海藻和海带放下面。凤尾鱼和鲹鱼送到集合地点。剩下的按种类堆放在角落。";
		next;
		mes "[托马斯，村长]";
		mes "嗯？！如果你那么想把海鲈鱼放到右边，就自己在那里站一整天吧！喵～";
		emotion ET_HUK, getnpcid(0, "Samuel#mal");
		next;
		mes "[托马斯，村长]";
		mes "没有你我已经够忙了。你真让我头疼！喵～";
		mes "要不要上那边的船？喵！";
		next;
		mes "[托马斯，村长]";
		mes "糟糕！！！";
		mes "!!!!!!";
		emotion ET_HUK;
		next;
		mes "[托马斯，村长]";
		mes "嗯，嗯……";
		mes "那么……你还站在这里做什么？";
		mes "去走廊尽头参加现在举行的例会。";
		mes "咳……";
		emotion ET_PROFUSELY_SWEAT;
		cutin "ma_tomas02",2;
		close2;
		cutin "",255;
		end;
	} else if (ma_tomas == 2) {
		mes "[托马斯，村长]";
		mes "嗯，嗯……";
		mes "那么……你还站在这里做什么？";
		mes "去走廊尽头参加现在举行的例会。";
		mes "咳……";
		emotion ET_PROFUSELY_SWEAT;
		cutin "ma_tomas02",2;
		close2;
		cutin "",255;
		end;
	} else if (ma_tomas < 35) {
		mes "[托马斯，村长]";
		mes "会议进行得怎么样？";
		mes "我已经很久没来参加了，最近太忙……啧……";
		emotion ET_PROFUSELY_SWEAT;
		cutin "ma_tomas02",2;
		close2;
		cutin "",255;
		end;
	} else if (ma_tomas == 35) {
		mes "[托马斯，村长]";
		mes "哦！";
		mes "居然发生了这种事！";
		emotion ET_AHA;
		cutin "ma_tomas04",2;
		next;
		mes "[托马斯，村长]";
		mes "我太忙了，没能照顾你，心里一直不安。";
		mes "你已经很好地适应了马朗岛。";
		emotion ET_SMILE;
		next;
		mes "[托马斯，村长]";
		mes "那么，作为村长和猫咪协会的上将，我也希望你能和我好好相处！";
		set ma_tomas,100;
		completequest 11237;
		getitem 6422,30; //Egrade_Coin
		close2;
		cutin "",255;
		end;
	}
	mes "[托马斯，村长]";
	mes "哈哈哈！";
	mes "你过得怎么样？";
	mes "遇到困难就来找我。";
	emotion ET_SMILE;
	cutin "ma_tomas04",2;
	close2;
	cutin "",255;
	end;
}

mal_in02,182,61,3	script	President of Meeting#mal	421,{
	if (ma_tomas == 0) {
		mes "[会议主席]";
		mes "请安静，例会马上就要开始了~";
		close;
	} else if (ma_tomas == 1) {
		mes "[会议主席]";
		mes "哇～哇～我们正在举行一场惊人的特卖会……不，是会议。";
		mes "请安静。";
		next;
		mes "[会议主席]";
		mes "今天的主要议题还是 ^ff99ccStar Candy^000000.";
		mes "虽然我已经走过很多地方，但还是第一次听到 ^0000FF这么难学的语言^000000.";
		next;
		mes "[会议主席]";
		mes "完全无法与她交流，已经成了日益严重的问题。";
		next;
		mes "[会议主席]";
		mes "如果对下一项议程有意见，请发言。";
		next;
		mes "[会议主席]";
		mes "嗯……好的。那么请先发言， ^6666ccScottfold^000000.";
		set ma_tomas,2;
		changequest 11209,11210;
		emotion ET_WRAP, getnpcid(0, "Scottfold#mal");
		close;
	} else if (ma_tomas == 2) {
		mes "[会议主席]";
		mes "嗯……好的。请先发言，^6666ccScottfold^000000。";
		emotion ET_WRAP, getnpcid(0, "Scottfold#mal");
		close;
	} else if (ma_tomas == 3) {
		mes "[会议主席]";
		mes "请发言，Koon……下一位。";
		emotion ET_WRAP, getnpcid(0, "Koon#mal");
		close;
	} else if (ma_tomas == 4) {
		mes "[会议主席]";
		mes "接下来由 Devore 博士持续介绍他的研究。";
		emotion ET_WRAP, getnpcid(0, "Linguist Devore#mal");
		close;
	} else if (ma_tomas == 5) {
		mes "[会议主席]";
		mes "接下来请 Mali 博士发言。";
		emotion ET_WRAP, getnpcid(0, "Geologist Mali#mal");
		close;
	} else if (ma_tomas == 6) {
		mes "[会议主席]";
		mes "Brie！！我理解情况，但毕竟是在开会，请冷静地告诉我们。";
		close;
	} else if (ma_tomas == 7) {
		mes "[会议主席]";
		mes "那么，我们先休息一会儿。";
		mes "这时 Samuel 带着海藻和金枪鱼来了。";
		close;
	}
	mes "[会议主席]";
	mes "呼……主持会议真让人疲惫。";
	mes "我曾被称为销售额第一、永不疲倦的商人……";
	next;
	mes "[会议主席]";
	mes "会议拖得太久时，我有时真的会感到不适。";
	emotion ET_CRY;
	close;
}

mal_in02,178,66,5	script	Scottfold#mal	422,{
	if (ma_tomas == 0) {
		mes "[斯科特福德]";
		mes "参加会议是重要的事。";
		mes "所有负责的猫都应该参加，这是理所当然的。";
		close;
	} else if (ma_tomas == 1) {
		mes "[斯科特福德]";
		mes "会议马上开始。";
		mes "所以，嘘～～";
		close;
	} else if (ma_tomas == 2) {
		mes "[斯科特福德]";
		mes "是的，尊敬的主席。";
		mes "关于与 Star Candy 的沟通，我们有 Biscuit，对吧？";
		next;
		mes "[会议主席]";
		mes "当然，虽然她总是和^0000FF稍微会说官方语言的 Biscuit^000000在一起，但似乎很难进行深入交流。";
		next;
		mes "[会议主席]";
		mes "此外，Star Candy 处于非常重要的位置，马朗岛的存续都依赖于它。许多人认为有必要直接讨论我们的未来方向。";
		next;
		mes "[会议主席]";
		mes "接下来……好的，库恩请发言。";
		set ma_tomas,3;
		changequest 11210,11211;
		emotion ET_WRAP, getnpcid(0, "Koon#mal");
		close;
	}
	mes "[斯科特福德]";
	mes "让我们安静听听其他人的发言。";
	next;
	mes "[斯科特福德]";
	mes "...虽然这么说，但我总觉得也该说点什么。";
	mes "所以我总是第一个举手！";
	close;
}

mal_in02,177,58,7	script	Koon#mal	546,{
	if (ma_tomas == 0) {
		mes "[库恩]";
		mes "虽然我很忙，但总会参加这场会议。";
		mes "希望会议时间不要影响我的工作。";
		close;
	} else if (ma_tomas == 1) {
		mes "[库恩]";
		mes "我很期待今天的议题。";
		close;
	} else if (ma_tomas == 2) {
		mes "[库恩]";
		mes "Scottfold 总是积极参加会议。";
		mes "据说他会成为这场会议的下一任主席。";
		close;
	} else if (ma_tomas == 3) {
		mes "[库恩]";
		mes "那么，德沃尔博士的研究进展如何？";
		next;
		mes "[会议主席]";
		mes "就连语言学家德沃尔博士也无法理解海星的语言……";
		next;
		mes "[语言学家德沃尔]";
		mes "主席！关于这件事，我想亲自说明研究情况。";
		next;
		mes "[会议主席]";
		mes "好的，请继续。";
		set ma_tomas,4;
		changequest 11211,11212;
		emotion ET_WRAP, getnpcid(0, "Linguist Devore#mal");
		close;
	}
	mes "[库恩]";
	mes "希望德沃尔博士的研究早日有成果。";
	mes "我也对这种语言很感兴趣！";
	close;
}

mal_in02,174,64,5	script	Linguist Devore#mal	549,{
	if (ma_tomas < 4) {
		mes "[语言学家德沃尔]";
		mes "我们大多数猫咪都很有语言天赋。";
		mes "这对商人的繁荣影响很大。";
		next;
		mes "[语言学家德沃尔]";
		mes "因为……懂得更多外语，就能在更多地区做生意。";
		close;
	} else if (ma_tomas == 4) {
		mes "[语言学家德沃尔]";
		mes "大家好。";
		mes "我是语言学家德沃尔，负责研究海星语言。";
		next;
		mes "[语言学家德沃尔]";
		mes "先说结论。自从我们在马朗岛定居后开始^0000FF海星语言研究^000000以来，目前还没有显著成果。";
		emotion ET_PROFUSELY_SWEAT;
		next;
		mes "[语言学家德沃尔]";
		mes "当然，我们勉强可以和^6666ccBiscuit^000000交谈，但这离解决问题的预期结果还很远。";
		next;
		mes "[库恩]";
		mes "那么，上次找到的书研究得怎么样了？";
		next;
		mes "[语言学家德沃尔]";
		mes "我们原以为这本书是用海星语言写的。但问过 Biscuit 后才知道，它其实是学习海星语言的教材……";
		next;
		mes "[库恩]";
		mes "那对研究海星语言不是很有帮助吗？";
		next;
		mes "[语言学家德沃尔]";
		mes "我也这么想，但按书上尝试对话后，发现他们完全听不懂。";
		next;
		mes "[语言学家德沃尔]";
		mes "看这本书第一页的文字，有一句似乎是简短的对话。";
		next;
		mes "[语言学家德沃尔]";
		mes "It's like this, for the question, ���Ѭ� ���?, it says, ���� ���� �լ�Ҭ��, �ҬݬѬԬ�լѬ��. �� ���ڬ�?";
 		next;
		mes "[语言学家德沃尔]";
		mes "我试着这样和比斯科特交谈，却没有得到回应。";
		next;
		mes "[语言学家德沃尔]";
		mes "除此之外，另一方也在研究这本书本身的存在。";
		next;
		mes "[会议主席]";
		mes "好了，我们已经充分听取了德沃尔博士的说明。";
		mes "那么先总结语言研究进展，再听听地质学家 Mali 博士的发言。";
		set ma_tomas,5;
		changequest 11212,11213;
		emotion ET_WRAP, getnpcid(0, "Geologist Mali#mal");
		close;
	} else if (ma_tomas < 18) {
		mes "[语言学家德沃尔]";
		mes "呼……";
		mes "海星语言是我研究生涯中最困难的课题。";
		next;
		mes "[语言学家德沃尔]";
		mes "我必须尽快解开海星语言之谜。";
		mes "看到大家变成这样，我感到很羞愧。";
		emotion ET_PROFUSELY_SWEAT;
		close;
	} else if (ma_tomas == 18) {
		mes "[语言学家德沃尔]";
		mes "没错……";
		mes "语言世界真美丽又神秘。";
		next;
		mes "[语言学家德沃尔]";
		mes "谜团包括为什么同一种生物使用完全不同的语言，或相距遥远的种族却使用相似语言。";
		next;
		mes "[语言学家德沃尔]";
		mes "我加入这个小组，是因为我认为四处旅行比坐在桌前读书更有助于研究。";
		next;
		mes "[语言学家德沃尔]";
		mes "但这个海星实在太神秘了。";
		mes "我完全无法理解。";
		mes "我甚至怀疑它是否真的是‘语言’。";
		emotion ET_PROFUSELY_SWEAT;
		next;
		mes "[语言学家德沃尔]";
		mes "我尝试了各种方法，仍然毫无头绪。";
		mes "Biscuit 已经习惯我们的语言，进行简短交流是可能的，但还不能称为对话。";
		next;
		mes "[语言学家德沃尔]";
		mes "这样研究让我很沮丧，但必须解决这个问题才能处理其他事项。";
		next;
		mes "[语言学家德沃尔]";
		mes "我看不出问题在哪里！";
		mes "我可是曾被称为语言大师的人！";
		mes "没想到会遇到这种无法理解的东西！";
		next;
		mes "[语言学家德沃尔]";
		mes "哇啊啊啊啊！！！！";
		mes "我看不出问题在哪里！";
		emotion ET_HUK;
		next;
		mes "[语言学家德沃尔]";
		mes "他们为什么在这里，又想做什么！";
		mes "只要能知道答案就好了！";
		set ma_tomas,19;
		changequest 11225,11226;
		close;
	} else if (ma_tomas == 19) {
		mes "[语言学家德沃尔]";
		mes "哇啊啊啊啊！！！！";
		mes "我看不出问题在哪里！";
		emotion ET_HUK;
		next;
		mes "[语言学家德沃尔]";
		mes "他们为什么在这里，又想做什么！";
		mes "只要能知道答案就好了！";
		close;
	} else if (ma_tomas == 20) {
		mes "[语言学家德沃尔]";
		mes "什么？！你说什么？！";
		mes "说得真流利！";
		mes "怎么会！";
		emotion ET_HUK;
		next;
		mes "[语言学家德沃尔]";
		mes "除非亲眼看到，否则我无法相信。";
		mes "如果他只对我那样说，不就很奇怪吗？";
		next;
		mes "[语言学家德沃尔]";
		mes "我们一起去听听！！";
		set ma_tomas,21;
		changequest 11227,11228;
		close;
	} else if (ma_tomas < 34) {
		mes "[语言学家德沃尔]";
		mes "到目前为止的研究完全是在猜错方向！";
		mes "不过在你失望之前，我更愿意为得到答案而高兴。";
		emotion ET_BEST;
		next;
		mes "[语言学家德沃尔]";
		mes "一旦得到答案，理解海星语言就只是时间问题。";
		close;
	} else if (ma_tomas == 34) {
		mes "[语言学家德沃尔]";
		mes "真的吗？！";
		mes "比斯科特这么说了吗？！";
		emotion ET_HUK;
		next;
		mes "[语言学家德沃尔]";
		mes "啊，啊！多亏了你，"+strcharinfo(0)+"！";
		mes "我非常感激。";
		next;
		mes "[语言学家德沃尔]";
		mes "我现在必须去见比斯科特道谢。";
		mes "虽然我们无法互相理解，但我一定能表达我的感谢。";
		next;
		mes "[语言学家德沃尔]";
		mes "啊，我还想把这个好消息告诉我们的主席 Tomas。";
		mes "请!!";
		emotion ET_HELP;
		set ma_tomas,35;
		changequest 11236,11237;
		getitem 6422,30; //Egrade_Coin
		close;
	} else if (ma_tomas == 35) {
		mes "[语言学家德沃尔]";
		mes "啊，我也真的很想把这个好消息告诉我们的首领 Tomas。";
		mes "请!!";
		emotion ET_HELP;
		close;
	}
	mes "[语言学家德沃尔]";
	mes "Ah, ah!!";
	mes "海星语言研究进展顺利。";
	mes "如果没有你的帮助，"+strcharinfo(0)+"，事情可能真的会变成灾难。";
	emotion ET_THANKS;
	close;
}

mal_in02,179,57,1	script	Geologist Mali#mal	559,{
	if (ma_tomas < 5) {
		mes "[地质学家玛丽]";
		mes "马朗岛之所以得名，是因为这里的地面很柔软，喵～";
		mes "摸起来会变硬，喵～";
		emotion ET_SEXY;
		close;
	} else if (ma_tomas == 5) {
		mes "[地质学家玛丽]";
		mes "玛丽，喵～";
		mes "如你们所知，地面有裂缝的地方很多，喵～";
		next;
		mes "[地质学家玛丽]";
		mes "目前还不是很严重或危险的问题，喵～";
		mes "我们无法预测 Star Candy 什么时候移动，所以现在最好先修好这些，喵～";
		next;
		mes "[地质学家玛丽]";
		mes "不过，和往常一样，我们缺少劳动力，喵~";
		mes "我认为还需要更多人参加，喵～";
		next;
		mes "[地质学家玛丽]";
		mes "我知道大家都有自己的工作，应该都很忙。但这和我们的生活有关，所以我想参加修理。";
		emotion ET_HELP;
		next;
		mes "[布莉]";
		mes "等等！";
		mes "这不是临时修补就能解决的事！";
		mes "我父亲之前在地震中受了重伤！";
		emotion ET_HUK, getnpcid(0, "Brie#mal");

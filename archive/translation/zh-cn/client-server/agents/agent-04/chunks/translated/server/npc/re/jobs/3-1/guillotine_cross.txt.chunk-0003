		} else {
			mes "你充分利用了 Daora 的建议。";
			mes "不过，我不是提过吗？";
			next;
			mes "[Mayshell]";
			mes "我告诉过你要保密……";
			mes "当然，我不想责怪你。";
			next;
			mes "[Mayshell]";
			mes "重要的不只是独自解决，";
			mes "还要努力获取信息。";
			next;
			mes "[Mayshell]";
			if (.@all_wine > 3) {
				if (job_3rd_gc == 18) {
					mes "你任务的评价是……[B]。";
					set .@quest,7097;
				} else {
					mes "你任务的评价是……[C]。";
					mes "你需要独立行动。";
					set .@quest,7098;
				}
				next;
			} else {
				mes "你用灵活的观点处理了事务。";
				mes "你没有依赖他人，恰当地利用了周围环境。";
				next;
				mes "[Mayshell]";
				mes "我喜欢这样。";
				if (job_3rd_gc == 18) {
					mes "你任务的评价是……[A]。";
					set .@quest,7096;
				} else {
					mes "你任务的评价是……[B]。";
					set .@quest,7097;
				}
				next;
			}
		}
		mes "[Mayshell]";
		mes "完成这项任务后，你获得了新的资格。";
		mes "这是我们刺客作为世界之影的影子……";
		next;
		mes "[Mayshell]";
		mes "我将授予你成为^4d4dff十字斩首者^000000的资格。";
		mes "我不强迫你，所以你想来的时候随时都可以来。";
		next;
		mes "[Mayshell]";
		mes "我奖励你的努力，并送你一份礼物。";
		mes "这是我从公会拿来的，希望对你有帮助。";
		set job_3rd_gc, 20;
		getitem 12106,1; //Accessory_Box
		erasequest 7091;
		erasequest 7092;
		erasequest 7093;
		if (checkquest(7094) > -1) erasequest 7094;
		if (checkquest(7095) > -1) erasequest 7095;
		erasequest 7112;
		erasequest 7113;
		erasequest 7114;
		if (checkquest(7115) > -1) erasequest 7115;
		if (checkquest(7116) > -1) erasequest 7116;
		changequest 7111,.@quest;
		next;
		mes "[Mayshell]";
		mes "我想告诉你一件事。";
		mes "我命令你，无论是什么，^4d4dff绝对不能留下任何文件^000000。";
		next;
		mes "[Mayshell]";
		mes "信息有两种：";
		mes "可以分享的，以及不能分享的。";
		next;
		mes "[Mayshell]";
		mes "永远不要留下记录，也不要把完成的任务告诉任何人……";
		mes "也不要给追随你脚步的后辈留下线索。";
		next;
		mes "[Mayshell]";
		mes "别忘了。";
		mes "你完成的任务与拉赫、卢恩·米德加尔兹以及我们的刺客公会有关。";
		mes "所以不能让其他人知道。当然也包括你自己，请忘掉一切。";
		close;
	} else if (job_3rd_gc == 20) {
		mes "你得到了公会认可。";
		mes "想成为十字斩首者时，随时欢迎你来。";
		next;
		mes "[Mayshell]";
		mes "这个选择意味着你必须再次踏上血之街。";
		next;
		mes "[Mayshell]";
		mes "Bercasell 正在对面的房间等你。";
		mes "去见他。";
		close;
	} else if (job_3rd_gc > 20) {
		mes "虽然我给了你资格，";
		mes "我不想庆祝那个资格。";
		next;
		mes "[Mayshell]";
		mes "这是一条放弃心灵、承受痛苦与逆境的道路。";
		mes "是我把你推上了这条路。";
		next;
		mes "[Mayshell]";
		mes "真有意思。";
		mes "我们靠考验同伴而活……";
		mes "但这就是刺客的规矩。";
		next;
		mes "[Mayshell]";
		mes "在漆黑的夜里，这是行走于月影之人的命运。";
		mes "请牢记于心……";
		close;
	} else {
		mes "这里不许进入。";
		close;
	}
}

ve_in,228,108,3	script	Waitress#3rdgc04	80,{
	mes "[Waitress]";
	if (job_3rd_gc < 6) {
		mes "欢迎~";
		mes "来休息吧~";
		close;
	} else if (job_3rd_gc == 6) {
		if (checkquest(7091) == 1) {
			if (checkquest(7112) == 1) {
				mes "这就是我知道的全部信息。";
				mes "之后的事，我什么都想不起来了。";
				next;
				mes "那么，我们能用你收集的信息推理出来吗？-";
				next;
				switch(select("查看信息:停止查看")) {
				case 1:
					callfunc "func_3rdgc",1;
					close;
				case 2:
					mes "你停止了信息确认。";
					close;
				}
			} else {
				mes "欢迎。";
				mes "准备点餐了吗？";
				next;
				switch(select("你是……:你的名字是……？:请给我水。")) {
				case 1:
					mes "[Waitress]";
					mes "怎么了？";
					mes "准备点餐了吗？";
					next;
					select("我在找 Madelle……");
					mes "[Madelle]";
					mes "啊？Madelle？你知道 Daora 吗？";
					mes "我是 Madelle。";
					mes "你是从 Daora 那里来的，应该是有事找我吧。";
					next;
					select("有可疑的客人吗？");
					mes "[Madelle]";
					mes "可疑的客人？";
					mes "什么样的……？";
					mes "啊，嗯……我们见过几个陌生人。";
					next;
					mes "[Madelle]";
					mes "由于村子的地形崎岖，这里没有多少流动人口。";
					mes "几乎所有人都是在这里出生的，或者是经常来访的冒险者。";
					next;
					mes "[Madelle]";
					mes "但如果他们不是那种人……";
					mes "是的，确实有陌生人。";
					next;
					select("能告诉我他们的事吗？");
					mes "[Madelle]";
					mes "嗯……其中一个看起来像来自拉赫的牧师。";
					mes "这个村子里的牧师……";
					mes "我明白了，他可能是士兵。";
					next;
					mes "[Madelle]";
					mes "有一天，一个看起来很疲惫的人来买食物。";
					mes "我记得他，因为他在店铺关门后才来拜访。";
					next;
					mes "[Madelle]";
					mes "我不太确定，但有个人戴着兜帽。";
					mes "他看起来很疲惫，想买一小杯饮料和一份点心。";
					next;
					mes "[Madelle]";
					mes "之后我就没再见过他们。";
					mes "所以我也不知道更多了。";
					setquest 7112;
					next;
					mes "- Madelle 的信息已经贴在访客公告板上。";
					mes "那么，我们能推理出你收集了什么信息吗？-";
					next;
					switch(select("查看信息:停止查看")) {
					case 1:
						callfunc "func_3rdgc",1;
						close;
					case 2:
						mes "你停止了信息确认。";
						close;
					}
				case 2:
					mes "[Waitress]";
					mes "什么？我的名字？";
					mes "你在搭讪我吗？";
					mes "别这样。";
					if (Sex == SEX_MALE) mes "你不是我喜欢的类型。";
					else mes "我不是那种取向。";
					close;
				case 3:
					mes "[Waitress]";
					mes "要加冰吗？";
					close;
				}
			}
		} else {
			if (checkquest(7112) == 1) {
				mes "这就是我知道的全部信息。";
				mes "之后我就没再见过他们。";
				next;
				mes "- 不知道我能不能用收集到的信息推理出来……-";
				next;
					switch(select("查看信息:停止查看")) {
				case 1:
					callfunc "func_3rdgc",0;
					close;
				case 2:
					mes "你停止了信息确认。";
					close;
				}
			} else {
				mes "欢迎。";
				mes "准备点餐了吗？";
				next;
				switch(select("可疑的人？:哪种食物最好？")) {
				case 1:
					mes "[Waitress]";
					mes "可疑的人？";
					mes "你就是可疑的人。";
					close;
				case 2:
					mes "[Waitress]";
					mes "嗯？这个嘛……";
					mes "如果你想吃简单的菜，就点我们的固定套餐吧。";
					mes "要 5000 Zeny，要来一份吗？";
					next;
					switch(select("好的，我试试。:……")) {
					case 1:
						if (Zeny > 4999) {
							mes "[Waitress]";
							mes "给你，这是固定套餐。";
							mes "需要的时候尽管叫我。";
							next;
							switch(select("生意怎么样？:客人很多吗？")) {
							case 1:
								mes "[Waitress]";
								mes "嗯……还不错。";
								mes "这里就这一家酒馆，所以生意还可以。";
								break;
							case 2:
								mes "[Waitress]";
								mes "最近没那么多。";
								mes "马马虎虎吧。";
								break;
							}
							next;
							mes "[Waitress]";
							mes "村里的生意能跟得上客人的需求。";
							mes "最近冒险者来得更频繁了。";
							next;
							select("有可疑的访客吗？");
							mes "[Waitress]";
							mes "当然，我每天都能看到一些。";
							mes "看他们的穿着我就能认出来。";
							mes "做生意需要记住他们的特征。";
							next;
							select("真无聊……");
							mes "[Waitress]";
							mes "是啊，有时候是。";
							mes "每天都得和";
							mes "同样的人说话。";
							mes "不过……";
							next;
							mes "[Waitress]";
							mes "看到像你这样的客人，我就觉得精神焕发。";
							mes "我想起几天前发生的一件事。";
							next;
							mes "[Waitress]";
							mes "我关店的时候，";
							mes "他看起来很疲惫，想买一小杯饮料和一份点心。";
							next;
							mes "[Waitress]";
							mes "他是个陌生人，但我确定他来自拉赫。";
							mes "他看起来像个牧师。";
							next;
							mes "[Waitress]";
							mes "我以为有牧师来过这里，但并不是。";
							mes "我开始害怕起来。";
							next;
							mes "[Waitress]";
							mes "我以为自己可能给小偷开了门。";
							mes "啊，抱歉，我一定说得太多了。";
							next;
							mes "[Waitress]";
							mes "和那个老人聊天真无聊……";
							mes "总之，我不再打扰你了。";
							mes "请慢用！";
							next;
							mes "[Waitress]";
							mes "对了，我叫 Madelle。";
							mes "希望你记住我的名字。";
							set Zeny, Zeny - 5000;
							setquest 7112;
							next;
							mes "- Madelle 的信息已经贴在任务公告板上。我收集了什么信息？-";
							next;
							switch(select("查看信息:取消")) {
							case 1:
								callfunc "func_3rdgc",0;
								close;
							case 2:
								mes "你停止了信息确认。";
								close;
							}
						} else {
							mes "[Waitress]";
						mes "我们的套餐售价 5000 Zeny。";
						mes "你需要付款。";
						mes "需要预付。";
							close;
						}
					case 2:
						mes "[Waitress]";
					mes "你感到烦恼。";
					mes "我明白了，不勉强你。";
					mes "去那里休息吧。";
						close;
					}
				}
			}
		}
	} else {
		mes "Hi~!";
		mes "我们经常见面。";
		next;
		mes "[Madelle]";
		mes "吃饭？喝酒？";
		mes "呵呵，玩得开心！";
		close;
	}
}

ve_in,246,303,3	script	Young Merchant#3rdgc05	930,{
	if (job_3rd_gc < 6) {
		mes "[Young Merchant]";
		mes "如果你想买东西，就去找这位。";
		mes "我是批发商。";
		close;
	}
	else if (job_3rd_gc == 6) {
		if (checkquest(7091) == 1) {
			if (checkquest(7113) == 1) {
				mes "[Crave]";
				mes "我已经把知道的所有信息都告诉你了。";
				mes "我很擅长通过外表记人。";
				mes "我找不到另一个女孩，只找到了符合你描述的那个。";
				next;
				mes "我们能用你收集的信息推理出来吗？";
				next;
				switch(select("查看信息:停止查看")) {
				case 1:
					callfunc "func_3rdgc",1;
					close;
				case 2:
					mes "你停止了信息确认。";
					close;
				}
			} else {
				mes "[Young Merchant]";
				mes "下次多买些药水怎么样……";
				mes "嗯，你有什么事要告诉我吗？";
				next;
					switch(select("你认识 Crave 吗？:给我一瓶药水。")) {
				case 1:
					mes "[Crave]";
					mes "我是 Crave，你是谁……？";
					//mes "You're not a usual stuff in connection.."; //FIXME: Dialogue.
					next;
					mes "[Crave]";
					mes "啊，是 Daora 的事吗？";
					mes "是的，有什么事吗？";
					next;
					select("这几天你见过陌生人吗？");
					mes "[Crave]";
					mes "陌生人……是 Daora 的事？";
					mes "好，我明白你在说什么了。";
					next;
					mes "[Crave]";
					mes "我在观察店铺时";
					mes "发现了一张新面孔。";
					mes "是个女孩……";
					next;
					mes "[Crave]";
					mes "她每天早晚都会买食物和生活必需品。";
					mes "因为她很漂亮，我想更多了解她。";
					mes "但没有人知道她住在哪里。";
					next;
					mes "[Crave]";
					mes "她是个神秘人物吗？";
					mes "我不知道她是谁，也不知道她住在哪里！";
					next;
					mes "[Crave]";
					mes "我想和她谈谈，但她总是逃走……";
					mes "她一定隐藏着什么。";
					setquest 7113;
					next;
					mes "- Crave 提供的信息已经贴在任务公告板上。";
					mes "那么，我们能用你收集的信息推理出来吗？-";
					next;
					switch(select("查看信息:停止查看")) {
					case 1:
						callfunc "func_3rdgc",1;
						close;
					case 2:
						mes "你停止了信息确认。";
						close;
					}
				case 2:
					mes "[Young Merchant]";
				mes "我做的是批发，不是零售。";
				mes "去工具商那里买吧。";
					close;
				}
			}
		} else {
			if (checkquest(7113) == 1) {
				mes "[Crave]";
				mes "我已经把知道的所有信息都告诉你了。";
				mes "我很擅长通过外表记人。";
				mes "我找不到另一个女孩，只找到了符合你描述的那个。";
				next;
				mes "我们能用你收集的信息推理出来吗？";
				next;
					switch(select("查看信息:停止查看")) {
				case 1:
					callfunc "func_3rdgc",0;
					close;
				case 2:
					mes "你停止了信息确认。";
					close;
				}
			} else {
				mes "[Young Merchant]";
				mes "怎么了？";
				mes "我是商人，但不是零售商。";
				mes "如果你想买东西，就去找别人。";
				next;
					switch(select("可疑的人？:我听说你很机灵。")) {
				case 1:
					mes "[Young Merchant]";
					mes "可疑的人？";
					mes "有很多人都很可疑。";
					next;
					mes "[Young Merchant]";
					mes "那个笨拙的人很可疑，对吧？";
					close;
				case 2:
					mes "[Young Merchant]";
					mes "嗯？有道理。";
					mes "作为商人谋生，我必须善于通过外表快速记人。";
					next;
					mes "[Young Merchant]";
					mes "我必须记住与我做生意的人的脸，这样才能获利。";
					mes "这样才能留住稳定的客人。";
					next;
					 switch(select("我在找一位表亲……:结束对话。")) {
					case 1:
						mes "[Young Merchant]";
						mes "她是个漂亮的金发女孩吗？";
						next;
						switch(select("不，是个男孩。:是的。")) {
						case 1:
							mes "[Young Merchant]";
							mes "是男孩吗？";
							mes "我不知道。";
							mes "我只知道一个神秘的金发美女。";
							close;
						case 2:
							mes "[Crave]";
							mes "哦，是她吗？";
							mes "我是 Crave。如果你之后找到她，请联系我。";
							next;
							mes "[Crave]";
							mes "别用那么凶的眼神瞪我。";
							mes "我是个有能力的人。";
							next;
							select("你在哪里见过她？");
							mes "["+strcharinfo(0)+"]";
							mes "已经过去几天了。";
							mes "我想尽快找到她。";
							mes "你说见过那个孩子？你在哪里见到她的？";
							next;
							mes "[Crave]";
							mes "所以……这就是我们不知道她住处的原因。";

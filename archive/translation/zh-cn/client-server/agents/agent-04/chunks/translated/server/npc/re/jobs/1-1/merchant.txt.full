//===== rAthena Script ======================================= 
//= Renewal Merchant Job Quest
//===== By: ================================================== 
//= Kisuka
//===== Current Version: ===================================== 
//= 1.1
//===== Compatible With: ===================================== 
//= rAthena Project
//===== Description: ========================================= 
//= Job Change to Merchant Class
//===== Additional Comments: ================================= 
//= 1.0 First Version. [Kisuka]
//= 1.1 Added support for Baby classes. [Euphy]
//============================================================ 
alberta_in,53,43,6	script	Merchant#mer	86,{
	if (Upper == 1) {
		if (Class == Job_Novice_High && (ADVJOB == Job_Whitesmith || ADVJOB == Job_Creator)) {
			mes "[Chief Mahnsoo]";
			mes "好久不见！";
			mes "嘿，您没有放弃";
			mes "自己的生意吧？";
			mes "发生了什么？";
			next;
			mes "[Chief Mahnsoo]";
			mes "哇……";
			mes "您真的去过英灵殿？！哇，您走了很长的路……";
			next;
			if (!callfunc("F_CanChangeJob")) {
				mes "[Chief Mahnsoo]";
				mes "嗯……";
				mes "看来您还没准备好再次成为商人。先完成新手基础技能的学习吧。";
				next;
				mes "[Chief Mahnsoo]";
				mes "别担心，我们随时为您保留商人职位。准备好后再回来，好吗？";
				close;
			}
			mes "[Chief Mahnsoo]";
			mes "看来我们再次相遇是命运的安排。好吧，让我再次将您转为商人！";
			next;
			skill "NV_TRICKDEAD",0,SKILL_PERM;
			jobchange Job_Merchant_High;
			skill "MC_CARTREVOLUTION",1,SKILL_PERM;
			skill "MC_CHANGECART",1,SKILL_PERM;
			skill "MC_LOUD",1,SKILL_PERM;
			mes "[Chief Mahnsoo]";
			mes "啊～真令人怀念。就像过去一样！好了，加油！";
			close;
		}else{
			mes "[Chief Mahnsoo]";
			mes "^333333*叹气*^000000";
			mes "我好无聊……";
			mes "什么时候才能收到我可爱 Blossom 的消息？";
			close;
		}
	}
	mes "[Guildsman Mahnsoo]";
	mes "嘿，您为什么来这里？";
	next;
	switch(select("我想成为商人。:我想进一步了解商人。:询问成为商人的要求。:没什么。")) {
	case 1:
		mes "[Guildsman Mahnsoo]";
		if(BaseJob != Job_Novice) {
			if(BaseJob == Job_Merchant) {
				mes "……？抱歉，您在说什么？";
				mes "您已经是商人了。我的天……";
				mes "嗯？！……我现在需要笑吗？！";
			}else{
				mes "啊？您想两边都要吗？";
				mes "还是回到您原本的职业吧？";
				next;
				mes "[Guildsman Mahnsoo]";
				mes "我们可是有商业道德的。";
			}
			close;
		}else{
			mes "想成为商人？嗯……";
			next;
			if (!callfunc("F_CanChangeJob")) {
				mes "[Guildsman Mahnsoo]";
				mes "不过想成为商人，基础技能等级必须达到 9 级，或者用完所有技能点。";
				next;
				mes "[Guildsman Mahnsoo]";
				mes "虽然我们只和金钱打交道，但您不觉得也该学习一些基础技能吗？";
				close;
			}
			mes "[Guildsman Mahnsoo]";
			mes "很好，您的基础技能达标了，我认为您已经准备充分。";
			mes "现在我允许您成为商人。";
			next;
			mes "[Guildsman Mahnsoo]";
			mes "恭喜您成为商人！";
			mes "再次恭喜您成为商人公会成员和我们的同事。期待您今后的积极参与！";
			callfunc "Job_Change",Job_Merchant;
			getitem 1381,1;	// N_Battle_Axe
			next;
			mes "[Guildsman Mahnsoo]";
			mes "当然，我们需要有热情的年轻人，帮助实现占据全球货币流通量 20% 的伟大目标。明白了吗？";
			mes "我的意思是……最终让我们赚很多钱。您知道的～";
			close;
		}
	case 2:
		mes "[Guildsman Mahnsoo]";
		mes "商人？简单来说，出售商品并赚钱的人就是商人。";
		mes "我们不擅长战斗，也没有特殊攻击或恢复技能……但商人能低价买入、高价卖出赚钱。";
		next;
		mes "[Guildsman Mahnsoo]";
		mes "商人有一项名为金钱攻击的终极技能，用金钱打击敌人……除了弓、杖和双手剑，我们什么都能装备。但这些也可以买卖。";
		mes "没错……我们商人脑子里总想着钱，明白了吗？";
		close;
	case 3:
		mes "[Guildsman Mahnsoo]";
		mes "要成为商人，虽然我们的工作只是买卖和收钱，但基础技能等级至少要达到 9 级。";
		next;
		mes "[Guildsman Mahnsoo]";
		mes "以前我们会收取启动费。赚到那笔钱不容易吧？";
		mes "有太多人凑不齐那笔钱，只能一直哭泣。";
		next;
		mes "[Guildsman Mahnsoo]";
		mes "所以最近我们决定允许任何想成为商人的新手加入。";
		mes "毕竟今后能否生存，全靠自己的能力。";
		close;
	case 4:
		close;
	}
}

		mes "有你的消息。";
		mes "上面写着：‘将有一场重要会议。请等到那时。’";
		next;
		mes "[Belle]";
		mes "一切安排妥当后会通知你。";
		mes "在此之前请享用宴会。”";
		next;
		mes "[Belle]";
		mes "大概就是这些。";
		mes "除此之外，嗯，我不该对这种事好奇……";
		next;
		mes "[Belle]";
		mes "不过，^4d4dff我看到宫廷医生和祭司迅速前往海涅家族^000000。";
		next;
		mes "[Belle]";
		mes "他们似乎很匆忙。你知道发生了什么吗？";
		next;
		select("这个问题很难回答……");
		mes "[Belle]";
		mes "抱歉问了这个。";
		mes "嗯，还有一个消息。";
		next;
		mes "[Belle]";
		mes "^4d4dff涅里乌斯^000000家族的女士邀请你与她喝茶。";
		next;
		mes "[Belle]";
		mes "她让我在你来后立刻通知她。现在要给她发消息吗？";
		erasequest 7696;// What's Next?
		ep16_royal = 15;
		next;
		if (select( "我现在去拜访她。", "我稍后去拜访她。" ) == 2) {
			mes "[Belle]";
			mes "准备好后告诉我。";
			mes "到时我会给她发消息。";
			close;
		}
		mes "[Belle]";
		mes "我现在就发消息。";
		mes "再见。";
		setquest 7697;// Invitation from the Nerius
		close;
	case 15:
		if (isbegin_quest(7697) == 0) {
			mes "[Belle]";
			mes "你现在接受涅里乌斯家族的邀请吗？";
			next;
			if (select( "我现在去拜访她。", "我稍后去拜访她。" ) == 2) {
				mes "[Belle]";
				mes "准备好后告诉我。";
				mes "到时我会给她发消息。";
				close;
			}
			mes "[Belle]";
			mes "我现在就发消息。";
			mes "再见。";
			setquest 7697;// Invitation from the Nerius
			close;
		}
		mes "[Belle]";
		mes "涅里乌斯家族住在从这里数第二个房间。";
		mes "就在海涅家族房间旁边。";
		next;
		mes "[Belle]";
		mes "我已经通知他们你很快会去。你随时都可以过去。";
		close;
	case 16:
		mes "[Belle]";
		mes "海涅家族请求见你。";
		mes "他们让你回来后立即拜访海涅家族。";
		close;
	case 17:
		mes "[Belle]";
		mes "哦，你回来了！";
		mes "我去叫魔法师。";
		next;
		select("那是怎么回事？");
		mes "[Belle]";
		mes "宫廷魔法师 Nillem 打开门后马上离开。";
		mes "他说：‘你在哪里？’" + strcharinfo(0) + "。魔法师一定在找你。";
		close2;
		cloakoffnpcself( "Court Mage Nillem#ep16_wiz01" );
		npctalk "原来你在这里！", "Court Mage Nillem#ep16_wiz01", bc_self;
		setpcblock PCBLOCK_NPC, true;
		sleep2 500;
		setpcblock PCBLOCK_NPC, false;
		npctalk "时机真是完美……", bc_self;
		end;
	default:
		mes "[Chamberlain]";
		mes "随时为您效劳。";
		next;
		switch( select( "呼叫尼勒姆", "日程上的下一项是什么？", "请准备些茶点。", "呼叫便利服务" ) ) {
		case 1:
			mes "[Belle]";
			mes "要我为你叫宫廷魔法师吗？";
			mes "请稍等。";
			mes "我刚发了消息。魔法师很快就会到这里。";
			close2;
			setpcblock PCBLOCK_NPC, true;
			sleep2 500;
			cloakoffnpcself( "Court Mage Nillem#ep16_wiz01" );
			sleep2 500;
			if (ep16_royal < 24) {
				npctalk "感谢您今天使用百万次呼叫券！", "Court Mage Nillem#ep16_wiz01", bc_self;
				sleep2 3000;
				npctalk "你一定很想念我——", "Court Mage Nillem#ep16_wiz01", bc_self;
				sleep2 3000;
				npctalk "我都快被你无情的呼叫打动了……", "Court Mage Nillem#ep16_wiz01", bc_self;
				sleep2 3000;
				npctalk "开玩笑的。", "Court Mage Nillem#ep16_wiz01", bc_self;
				sleep2 3000;
				npctalk "现在出发吗？", "Court Mage Nillem#ep16_wiz01", bc_self;
			}
			else {
				switch( rand(5) ) {
				case 0:
					npctalk "我就知道你会呼叫我！我一直在等——", "Court Mage Nillem#ep16_wiz01", bc_self;
					break;
				case 1:
					npctalk "你如此无情地呼叫我，让我太兴奋了——", "Court Mage Nillem#ep16_wiz01", bc_self;
					break;
				case 2:
					npctalk "哈哈，我们又要出发了！前往过去！", "Court Mage Nillem#ep16_wiz01", bc_self;
					break;
				case 3:
					npctalk "感谢您今天使用百万次呼叫券！", "Court Mage Nillem#ep16_wiz01", bc_self;
					break;
				case 4:
					npctalk "天才魔法师尼勒姆来了！", "Court Mage Nillem#ep16_wiz01", bc_self;
					break;
				}
			}
			setpcblock PCBLOCK_NPC, false;
			end;
		case 2:
			mes "[Belle]";
			mes "今天没有特别邀请。";
			close;
		case 3:
			mes "[Belle]";
			.@r = rand(1,5);
			if (.@r == 1)
				mes "这是洋甘菊茶和姜味饼干，可以帮助你休息并恢复疲劳。";
			else if (.@r == 2)
				mes "你似乎饿了，所以我准备了下午茶、司康和凝脂奶油。";
			else if (.@r == 3)
				mes "这是巧克力和肉桂风味的路易波士茶，供你提神。";
			else if (.@r == 4)
				mes "这是混合牛奶和巧克力碎的浓郁薄荷茶，饭后享用很棒。";
			else
				mes "这是加了柚子果冻和奶油的冰牛奶，是酸甜的饮料。";
			mes "你喜欢吗？";
			next;
			specialeffect2 EF_SANCTUARY;
			mes "^4d4dff HP 和 SP 全部恢复！";
			percentheal 100,100;
			close;
		case 4:
			mes "[Belle]";
			mes "要为您呼叫哪项服务？";
			mes "所有服务都可以呼叫，但每项服务可能会收取额外费用。";
			next;
			switch( select( "卡普拉", "巨兽管理员", "不用了。" ) ) {
			case 1:
				mes "[Belle]";
				mes "您想要卡普拉服务。";
				mes "我马上呼叫。";
				close2;
				setpcblock PCBLOCK_NPC, true;
				sleep2 500;
				setpcblock PCBLOCK_NPC, false;
				cloakoffnpcself( "Kafra Employee#ep16_s01" );
				npctalk "卡普拉服务。", "Kafra Employee#ep16_s01", bc_self;
				end;
			case 2:
				mes "[Belle]";
				mes "您需要巨兽管理员。";
				mes "我马上呼叫。";
				close2;
				setpcblock PCBLOCK_NPC, true;
				sleep2 500;
				setpcblock PCBLOCK_NPC, false;
				cloakoffnpcself( "Giant Beast Manager#ep16_s02" );
				npctalk "随时为您效劳。", "Giant Beast Manager#ep16_s02", bc_self;
				end;
			case 3:
				mes "[Belle]";
				mes "我明白了。";
				close2;
				cloakonnpcself( "Kafra Employee#ep16_s01" );
				cloakonnpcself( "Giant Beast Manager#ep16_s02" );
				end;
			}
		}
	}
}

prt_cas_q,29,30,3	script	Giant Beast Manager#ep16_s02	8W_SOLDIER,{
	.@thirdmask = eaclass() & EAJ_THIRDMASK;
	if (.@thirdmask != EAJ_RUNE_KNIGHT && .@thirdmask != EAJ_ROYAL_GUARD) {
		mes "我为卢恩骑士和皇家卫兵管理龙与狮鹫。";
		close;
	}
	mes "[Giant Beast Manager]";
	if (.@thirdmask == EAJ_RUNE_KNIGHT)
		.@string$ = "Dragon";
	else
		.@string$ = "Griffon";
	mes "谢谢你呼叫我。要我为你带来一个" + .@string$ + "吗？";
	next;
	if (select( "使用", "取消" ) == 2) {
		mes "[Giant Beast Manager]";
		mes "我明白了。那么，再见。";
		close2;
		cloakonnpcself( "Giant Beast Manager#ep16_s02" );
		end;
	}
	if (getskilllv("KN_RIDING") < 1) {
		mes "[Giant Beast Manager]";
		mes "你必须先学会骑乘" + .@string$ + "。";
		close;
	}
	if (checkriding() || checkdragon()) {
		mes "[Giant Beast Manager]";
		mes "你已经在使用" + .@string$ + "。";
		close;
	}
	if (ismounting()) {
		mes "[Giant Beast Manager]";
		mes "你已经骑着其他东西。";
		mes "必须先下坐骑才能骑乘" + .@string$ + "。";
		close;
	}
	if (.@thirdmask == EAJ_RUNE_KNIGHT)
		setdragon();
	else
		setriding();
	close;
}

prt_cas_q,28,30,3	script	Kafra Employee#ep16_s01	4_F_KAFRA2,{
	cutin "kafra_02.bmp",2;
	mes "[Kafra Employee]";
	mes "你好。这里是卡普拉服务。";
	mes "我能为你做什么？";
	next;
	switch( select( "使用货物服务", "使用手推车服务", "退出" ) ) {
	case 1:
		if (!callfunc("F_CanOpenStorage")) {
			mes "[Kafra Employee]";
			mes "抱歉，亲爱的顾客。";
			mes "必须将初心者技能等级提升到 6 级以上才能使用货物服务。";
			close3;
		}
		if (countitem(7059) == 0 && Zeny < 50) {
			mes "[Kafra Employee]";
			mes "你的钱不够。";
			mes "货物服务需要 50 Zeny。";
			close3;
	}
		if (countitem(7059) != 0)
			delitem 7059,1;	// Cargo_Free_Ticket
		else
			Zeny -= 50;
		mes "[Kafra Employee]";
		mes "我来为你打开仓库。";
		mes "感谢使用卡普拉服务。";
		close2;
		cutin "",255;
		openstorage;
		end;
	case 2:
		if (BaseClass != Job_Merchant) {
			mes "[Kafra Employee]";
			mes "抱歉，";
			mes "手推车服务仅限商人职业使用。";
			close3;
		}
		if (checkcart() == true) {
			mes "[Kafra Employee]";
			mes "你已经装备了手推车。";
			close3;
		}
		if (getskilllv("MC_PUSHCART") == 0) {
			mes "[Kafra Employee]";
			mes "学会‘手推车’技能后才能使用手推车。";
			close3;
		}
		if (countitem(7061) > 0) {
			delitem 7061,1;	// Cart_Free_Ticket
			setcart();
			close3;
		}
		mes "[Kafra Employee]";
		mes "手推车服务需要 800 Zeny。";
		mes "要使用吗？";
		next;
		if (select( "使用", "取消" ) == 2)
			close3;
		if (Zeny < 800) {
			mes "[Kafra Employee]";
			mes "你的钱不够，亲爱的顾客。";
			mes "手推车服务需要 800 Zeny。";
			close3;
		}
		RESRVPTS += 8;
		Zeny -= 800;
		setcart();
		close3;
	case 3:
		mes "[Kafra Employee]";
		mes "一如既往地感谢你使用卡普拉服务。";
		close2;
		cutin "",255;
		cloakonnpcself( "Kafra Employee#ep16_s01" );
		end;
	}
	end;
}

prt_cas_q,28,28,3	script	Court Mage Nillem#ep16_wiz01	4_M_JOB_WIZARD,{
	if (ep16_royal == 17) {
		mes "[Nillem]";
		mes "哦，是你，亲爱的！我一直在等你！";
		next;
		select("亲爱的……");
		mes "[Nillem]";
		mes "哦，抱歉，我太激动了。";
		mes "穿越次元裂缝，探索王宫的秘密……！";
		next;
		mes "[Nillem]";
		mes "没有魔法师会拒绝这种事！难怪我这么兴奋！";
		next;
		select("对了，你为什么选我？");
		mes "[Nillem]";
		mes "嗯，因为王族既挑剔又没用……";
		next;
		mes "[Nillem]";
		mes "你看，现任家主和继承人不该做任何危险的事。";
		mes "王位继承人也是如此。";
		next;
		mes "[Nillem]";
		mes "你看到躺在床上的彼得了吗？";
		mes "……你知道，不能伤害他。";
		next;
		mes "[Nillem]";
		mes "这个不行，那个也不行……排除这些后，贵族除了处理文书和社交，也没什么可做的。";
		mes "他们还能做什么？";
		next;
		mes "[Nillem]";
		mes "而且照顾他们也不适合我。哈哈哈哈哈！";
		next;
		select("那么，你为什么担任宫廷魔法师？");
		mes "[Nillem]";
		mes "为了稳定和高收入——";
		mes "我在埃克拉珠学习期间的学费也是宫殿支付的！真慷慨！";
		next;
		mes "[Nillem]";
		mes "咳。总之，一切都准备好了。";
		mes "由于王室过去记忆中出现了扭曲，我在那里设置了大门。";
		next;
		mes "[Nillem]";
		mes "从现在开始，你可以直接^4d4dff前往王室过去记忆^000000，或者……";
		mes "对了，我给你一张^4d4dff百万尼勒姆通话券^000000。";
		mes "算我的！";
		next;
		select("这个……百万次尼勒姆呼叫券？");
		mes "[Nillem]";
		mes "没错。想见我的话，随时可以通过这里的管家呼叫我！";
		next;
		mes "[Nillem]";
		mes "我会像闪电一样立刻赶到——";
		mes "那么，我们出发吧？";
		ep16_royal = 18;
		next;
		if (select( "现在出发！", "我需要做些准备。" ) == 2) {
			mes "[Nillem]";
			mes "准备好后告诉我。";
			mes "如果我没有出现，就直接前往^4d4dff王室过去记忆^000000。";
			next;
			mes "[Nillem]";
			mes "你知道怎么去那里。";
			close;
		}
		mes "[Nillem]";
		mes "那么，闭上眼睛……";
		mes "一！";
		close2;
		warp "prt_lib",89,44;
		end;
	}
	if (ep16_royal > 17) {
		mes "[Nillem]";
		mes "哈哈，那么我们去王室过去记忆吧！";
		next;
		if (select( "前往王室过去的记忆", "我不需要！" ) == 2) {
			mes "[Nillem]";
			mes "我喜欢你如此干脆地拒绝。";
			mes "既然已经来了，我可以在这里待一会儿吗？";
			close;
		}
		mes "[Nillem]";
		mes "那么，闭上眼睛……";
		mes "一！";
		close2;
		warp "prt_lib",89,44;
		end;
	}
	end;
OnInit:
	cloakonnpc "Court Mage Nillem#ep16_wiz01";
	cloakonnpc "Kafra Employee#ep16_s01";
	cloakonnpc "Giant Beast Manager#ep16_s02";
	end;
}

prt_cas,177,164,0	script	#ep16_evt_7688	HIDDEN_WARP_NPC,3,3,{
	end;
OnTouch:
	if (ep16_royal == 3) {
		mes "我听到某处传来声音。";
		sleep2 2000;
		cloakoffnpcself( "Mysterious Guest#ep16_01" );
		cloakoffnpcself( "Chamberlain#ep16_01" );
		npctalk "你刚才说的故事一定是真的，对吧？", "Mysterious Guest#ep16_01", bc_self;
		sleep2 3000;
		npctalk "当然。它正好符合你寻找的条件。", "Chamberlain#ep16_01", bc_self;
		sleep2 3000;
		npctalk "嗯……", "Mysterious Guest#ep16_01", bc_self;
		sleep2 3000;
		npctalk "他也是王位继承人。你会得到想要的信息。", "Chamberlain#ep16_01", bc_self;
		sleep2 3000;
		npctalk "安排绝不能出错。一定要把他叫到这里。", "Mysterious Guest#ep16_01", bc_self;
		sleep2 3000;
		npctalk "一切都准备好了……不过细节之后再告诉你。", "Chamberlain#ep16_01", bc_self;
		sleep2 3000;
		npctalk "现在是你参加宴会的时间。", "Chamberlain#ep16_01", bc_self;
		sleep2 3000;
		npctalk "好。之后见。你可别让我失望。", "Mysterious Guest#ep16_01", bc_self;
		sleep2 3000;
		cloakonnpcself( "Mysterious Guest#ep16_01" );
		sleep2 1000;
		npctalk "真是个霸道的人……", "Chamberlain#ep16_01", bc_self;
		sleep2 1000;
		cloakonnpcself( "Chamberlain#ep16_01" );
		next;
		mes "我碰巧听到了可疑的谈话。";
		ep16_royal = 4;
		erasequest 7687;// Participating in the Banquet
		setquest 7688;// Suspicious Movement
	}
	end;
OnInit:
	cloakonnpc "Mysterious Guest#ep16_01";
	cloakonnpc "Chamberlain#ep16_01";

	questinfo( QTYPE_QUEST, QMARK_NONE, "isbegin_quest(7687) == 1" );
	end;
}
prt_cas,179,155,6	script	Mysterious Guest#ep16_01	4_LGTSCIENCE,{ end; }
prt_cas,181,154,2	script	Chamberlain#ep16_01	1_M_01,{ end; }

// Hall
function	script	F_banquet_main_4_spica	{
	.@char_id = getcharid(0);
	.@char_name$ = strcharinfo(0);

	mes "[Spica]";
	mes "又见到你了，" + .@char_name$ + "。";
	mes "侍从一定是很棒的信使。";
	mes "我马上就看到你朝这边来了。";
	cutin "ep16_spica_nerius01",2;
	next;
	mes "[Spica]";
	mes "听说你被介绍为特别嘉宾时，我很惊讶。你似乎比我想象的更非凡。";
	mes "你被介绍为……";
	unittalk getcharid(3), "" + .@char_name$ + "：这件事让我太尴尬了，还是别提了……", bc_self;
	next;
	mes "[Spica]";
	mes "但这是真的。";
	mes "这场宴会就是为你这样的英雄举办的。";
	mes "你应该感到骄傲。";
	next;
	cutin "ep16_skia_nerius01",0;
	mes "[Skia]";
	mes "没错！";
	mes "没人会阻止你和我们一起玩。请常来。";
	next;
	mes "[Skia]";
	mes "这里只有我们，可以稍微放松一点……";
	next;
	cutin "ep16_spica_nerius07",2;
	mes "[Spica]";
	mes "哈哈哈……我会保证不把话传出去。";
	mes "你听到了吗，Crux？";
	mes "我妹妹想安静地玩一会儿。";
	npctalk "什么……好……？", "Crux Findel#ep16_02", bc_self;
	next;
	cutin "ep16_crux_findel03",2;
	mes "[Crux]";

		mes "[劳雷尔]";
		mes "如果打算成为巫师，最好答对这些题。哈哈哈哈哈哈～";
		next;
		mes "[劳雷尔]";
		mes "1. 选择与其他魔物属性不同的魔物。";
		next;
		if (select("螳螂:角虫:地灵:焦糖") == 2)
			set .@wizard_t,.@wizard_t+20;
		mes "[劳雷尔]";
		mes "2. 选择不会拾取物品的魔物。";

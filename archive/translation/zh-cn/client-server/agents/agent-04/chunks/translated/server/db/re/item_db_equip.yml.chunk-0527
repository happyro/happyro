               bonus2 bSkillUseSP,"KO_HUUMARANKA",-25;
            }
         }
      }
      if (.@g>=ENCHANTGRADE_D) {
         bonus bPAtk,10;
         if (.@g>=ENCHANTGRADE_C) {
            bonus2 bSkillAtk,"SS_FUUMAKOUCHIKU",10;

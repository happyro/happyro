lhz_in01,27,247,5	script	Representative#li_02	1_F_LIBRARYGIRL,{
	if (lhz_curse > 6) {
		mes "[Representative]";
		mes "欢迎来到";
		mes "雷根贝勒公司。";
		mes "我能为你做什么？";
		next;
		switch(select("公司历史:雷根贝勒的业务")) {
		case 1:
			mes "[Representative]";
			mes "雷根贝勒成立于 400 年前，";
			mes "大约与施瓦茨瓦尔德共和国建国同时。";
			mes "这是公司的起源。";
			mes "历史十分悠久。";
			next;
			mes "[Representative]";
			mes "我们最初名为‘岚斯特·泽特尔莱茵哈尔研究中心’，";
			mes "以首任主席命名。";
			mes "公元 560 年（战后纪年），";
			mes "组织以新任主席雷根贝勒先生的名字重新命名。";
			mes "公司由此发展壮大。";
			mes "这段历史值得铭记。";
			next;
			mes "[Representative]";
			mes "雷根贝勒先生扩大了公司的业务，";
			mes "并创立雷根施姆实验室，";
			mes "以延续公司最初的科学研究目标。";
			mes "研究始终是我们的核心。";
			mes "我们不断追求进步。";
			mes "这就是公司的理念。";
			next;
			mes "[Representative]";
			mes "公元 700 年，^FF0000瓦尔蒙特博士^000000加入雷根施姆。";
			mes "他的科学研究让雷根贝勒成长为全国最大的公司。";
			mes "这是历史上的重要时刻。";
			mes "我们为此感到自豪。";
			if (lhz_curse == 8) set lhz_curse,9;
			else if (lhz_curse == 9) set lhz_curse,10;
			next;
			break;
		case 2:
			mes "[Representative]";
			mes "除了商品销售、货运和贸易，";
			mes "雷根贝勒公司还积极参与";
			mes "飞艇服务，";
			mes "这是我们的主要项目之一。";
			mes "业务遍及各地。";
			mes "我们持续拓展服务。";
			next;
			mes "[Representative]";
			mes "雷根贝勒涉足几乎所有你能想到的行业。";
			mes "请记住，雷根贝勒是";
			mes "值得信赖的名字。";
			mes "我们以诚信经营。";
			mes "欢迎了解更多。";
			if (lhz_curse == 8) set lhz_curse,9;
			else if (lhz_curse == 9) set lhz_curse,10;
			next;
			break;
		}
		mes "[Representative]";
		mes "如果你想进一步了解我们的使命，";
		mes "请参阅我身旁的雷根贝勒指南。";
		mes "谢谢，祝你今天愉快。";
		mes "欢迎再次光临。";
		if (isbegin_quest(2088))
			changequest 2088,2089;
		close;
	}
	else {
		mes "[Representative]";
		mes "欢迎来到";
		mes "雷根贝勒公司。";
		mes "我能为你做什么？";
		next;
		switch(select("Building Information.")) {
		case 1:
			mes "[Representative]";
			mes "请告诉我你想了解";
			mes "哪一层的信息。";
			mes "我会为你说明。";
			next;
			while (1) {
					switch(select("1F:2F:B1:取消")) {
				case 1:
					mes "[Representative]";
					mes "^3131FF雷根贝勒图书馆^000000在左侧走廊尽头。";
					mes "这里为系统开发员工提供创新理念和信息资源。";
					mes "欢迎前往查阅。";
					mes "请保持安静。";
					mes "感谢配合。";
					mes "谢谢。";
					next;
					mes "[Representative]";
					mes "^3131FF舞厅^000000通常举办各种官方活动，";
					mes "可从右侧走廊进入。";
					mes "请遵守规定。";
					mes "感谢配合。";
					next;
					break;
				case 2:
					mes "[Representative]";
					mes "请使用服务台两侧的楼梯前往二楼。";
					mes "二楼主要用于行政事务。";
					mes "请勿擅自进入办公室。";
					mes "如有疑问请咨询工作人员。";
					mes "谢谢配合。";
					mes "请遵守规定。";
					next;
					mes "[Representative]";
					mes "那里有^3131FF会议室^000000、";
					mes "^3131FF秘书办公室^000000、^3131FF礼堂^000000和";
					mes "^3131FF主席办公室^000000。";
					mes "请按照指示前往。";
					mes "不要大声喧哗。";
					next;
					break;
				case 3:
					mes "[Representative]";
					mes "地下第一层由^3131FF雷根施姆^000000使用。";
					mes "出于安全原因，访客不得进入。";
					mes "请不要尝试闯入。";
					mes "这是为了大家的安全。";
					mes "感谢理解。";
					next;
					break;
				case 4:
					mes "[Representative]";
					mes "我们始终竭尽全力为客户提供优质服务。";
					mes "请记住，雷根贝勒是值得信赖的名字。";
					mes "谢谢，祝你今天愉快。";
					mes "欢迎再次光临。";
					mes "感谢配合。";
					mes "祝你顺利。";
					close;
				}
			}
		}
	}
}

lhz_in01,25,251,3	script	Rekenber Guidebook#li	HIDDEN_NPC,{
	mes "..............";
	next;
	mes "^3131FF#The Vision^000000";
	mes "为了追求知识，雷根贝勒将在卢恩-米德加兹大陆寻找古代遗物。";
	mes "我们希望通过了解过去的秘密，取得重要的科学进步。";
	mes "这些研究将推动现代技术发展。";
	mes "请相信我们的愿景。";
// padding
	mes "通过了解过去的秘密，取得重要的科学进步。";
	next;
	mes "通过科学研究取得突破，";
	mes "我们希望能够";
	mes "改进现有技术。";

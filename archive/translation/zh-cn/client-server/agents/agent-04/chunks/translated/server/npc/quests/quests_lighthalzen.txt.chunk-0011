					switch(select("分散她注意:安慰她")) {
					case 1:
						mes "["+strcharinfo(0)+"]";
						mes "哦，这一切都是表演……";
						mes "是、是表演，我在练习。";
						mes "哈哈～还不错，对吧？";
						next;
						mes "[雪津]";
						mes "哦，你吓到我了！";
						mes "虽然我不认为";
						mes "那真的是我哥哥，对吧？";
						next;
						mes "["+strcharinfo(0)+"]";
						mes "打扰了……";
						next;
						mes "[雪津]";
						mes "我会尽力！";
						mes "哥哥回来时我一定要好好的。";
						mes "他会为我骄傲。";
						mes "嘿嘿～";
						next;
						mes "["+strcharinfo(0)+"]";
						mes "是的，我确定。";
						delitem 7341,1; //Worn_Out_Pendant
						set lhz_curse,25;
						close;
					case 2:
						mes "["+strcharinfo(0)+"]";
						mes "哭没有用！";
						mes "你很漂亮，别用无谓的眼泪";
						mes "毁掉你的";
						mes "脸。";
						next;
						mes "[雪津]";
						mes "............";
						next;
						mes "["+strcharinfo(0)+"]";
						mes "你要尽力保持健康，";
						mes "等";
						mes "哥哥回来。";
						next;
						mes "[雪津]";
						mes "是的……";
						next;
						mes "["+strcharinfo(0)+"]";
						mes "听着，哥哥回来时";
						mes "你们会在美丽的地方";
						mes "庆祝。";
						next;
						mes "[雪津]";
						mes "真的吗？";
						mes "那就约好了！嘿嘿～";
						next;
						mes "["+strcharinfo(0)+"]";
						mes "希望很快！";
						mes "我回来时希望你能";
						mes "走路。回头见！";
						next;
						mes "[雪津]";
						mes "我会努力！";
						delitem 7341,1; //Worn_Out_Pendant
						set lhz_curse,25;
						close;
					}
				}
				else {
					mes "[跛脚女孩]";
					mes "你见过我的";
					mes "哥哥吗……？";
					next;
					mes "[跛脚女孩]";
					mes "我哥哥很强，";
					mes "我应该为此感到高兴，";
					mes "因为";
					mes "不会有任何事";
					mes "发生在他身上。";
					next;
					mes "["+strcharinfo(0)+"]";
					mes "嗯……是的。那么……";
					next;
					mes "["+strcharinfo(0)+"]";
					mes "当然，你哥哥一定会很开心。";
					mes "他总会回来的。";
					mes "你应该睡觉保持健康，";
					mes "等哥哥回来。";
					next;
					mes "[跛脚女孩]";
					mes "是的！哥哥回来时我一定要";
					mes "好好的并能走路。";
					mes "";
					close;
				}
			}
		}
		close;
	}
}

lighthalzen,324,322,0	script	#li_door	WARPNPC,2,2,{
OnTouch_:
	if ((lhz_curse > 19) && (lhz_curse < 23)) {
		mes "^3355FF门锁着。^000000";
		set lhz_curse,lhz_curse+1;
		close;
	}
	else if (lhz_curse > 23) {
		mes "^3355FF门锁着。^000000";
		next;
		mes "[市民]";
		mes "抱歉，贫民窟附近又开始";
		mes "传播另一场";
		mes "疫情。";
		mes "我们不会外出，会保护好孩子们！";
		next;
		mes "[市民]";
		mes "不是想对你不友好，";
		mes "但你也要小心。";
		mes "这里的生活条件";
		mes "并不卫生，";
		mes "你知道吗？";
		close;
	}
	else {
		warp "lhz_in03",15,162;
	}
	end;
}


lighthalzen,319,321,0	script	#li_bother	HIDDEN_NPC,2,2,{ //3,3
OnTouch_:
	if ((lhz_curse == 24 ) || (lhz_curse == 25)) {
		mes ".............";
		next;
		mes "*Shhhzzzzzzz!*";
		specialeffect2 EF_MAPPILLAR;
		next;
		mes "[????]";
		mes "...........";
		next;
		mes "[????]";
		mes "^FF0000...I'm sorry...";
		mes "……我很感激";
		mes "你……^000000";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "H-huh?!";
		mes "刚才是什么？";
		mes "不可能是风，";
		mes "我一定又出现幻听了……";
		mes "别再想了。";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "等等，我以为那些想法";
		mes "或之前纠缠我的幽灵已经消失。";
		mes "也许它们仍想让我";
		mes "为它们做些什么。嗯……";
		mes "真让人不安。";
		mes "我必须查清真相。";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "我感觉他们的痛苦";
		mes "都与^FF0000雷根贝勒公司^000000";
		mes "以及^FF0000雷根施姆实验室^000000有关。";
		mes "这一定不是巧合。";
		mes "我必须继续调查。";
		set lhz_curse,26;
		changequest 2093,2094;
		if (checkre(3)) {
			if (BaseLevel < 70) getexp 30000,30000;
			else if ((BaseLevel > 69) && (BaseLevel < 80)) getexp 40000,70000;
			else if ((BaseLevel > 79) && (BaseLevel < 90)) getexp 70000,90000;
			else getexp 90000,90000;
		} else {
			if (BaseLevel < 70) getexp 800000,300000;
			else if ((BaseLevel > 69) && (BaseLevel < 80)) getexp 1000000,500000;
			else if ((BaseLevel > 79) && (BaseLevel < 90)) getexp 1500000,800000;
			else getexp 2000000,1000000;
		}
		close;
	}
	end;
}

lhz_in01,114,181,5	script	Representative#li_01	1_F_LIBRARYGIRL,{
	if (lhz_curse == 7) {
		mes "[Representative]";
		mes "您好，欢迎来到";
		mes "雷根贝勒公司。";
		mes "今天有什么可以为您服务？";
		next;
		switch(select("大楼信息:公司历史")) {
		case 1:
			mes "[Representative]";
			mes "请告诉我你想了解";
			mes "哪一层的信息。";
			mes "我会为你说明。";
			next;
			while (1) {
				switch(select("1F:2F:B1:取消")) {
				case 1:
					mes "[Representative]";
					mes "^3131FF雷根贝勒图书馆^000000在左侧走廊尽头。";
					mes "这里为系统开发员工提供";
					mes "创新理念和信息资源。";
					mes "欢迎前往查阅。";
					mes "请保持安静。";
					mes "谢谢。";
					next;
					mes "[Representative]";
					mes "^3131FF舞厅^000000通常举办各种官方活动，";
					mes "可从右侧走廊进入。";
					mes "请遵守规定。";
					mes "感谢配合。";
					next;
					break;
				case 2:
					mes "[Representative]";
					mes "请使用服务台两侧的楼梯";
					mes "前往二楼。二楼主要用于";
					mes "行政事务。";
					mes "请勿擅自进入办公室。";
					mes "如有疑问请咨询工作人员。";
					mes "谢谢配合。";

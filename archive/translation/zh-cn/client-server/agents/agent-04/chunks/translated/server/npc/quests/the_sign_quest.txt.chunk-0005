				mes "朋友在困难中带来";
				mes "欢乐和帮助。";
				mes "";
				next;
				mes "[大文]";
				mes "你不认为与某人成为亲密朋友";
				mes "";
				mes "";
				mes "可以成为";
				mes "一生的益处吗？";
				next;
				break;
			case 2:
				set .@pay_point,.@pay_point+4;
				mes "[大文]";
				mes "每个人都需要偶尔独处。";
				mes "";
				mes "有些战斗必须";
				mes "独自";
				mes "战斗。";
				next;
				mes "[大文]";
				mes "此外，如果你从不与人相处，";
				mes "可能会变得自私或依赖他人。";
				mes "还是走出去认识别人比较好，";
				mes "你不觉得吗？";
				next;
				break;
			case 3:
				set .@pay_point,.@pay_point+3;
				mes "[大文]";
				mes "你一个朋友都没有？那你最好尽快学会与他人相处……！";
				next;
				break;
			}
			mes "[大文]";
			mes "那么，你怎么看故意引来大量魔物跟着自己？";
			mes "我想这叫‘引怪’……";
			next;
			switch(select("太棒了～！:我讨厌这样做的人。:我偶尔会这样……")) {
			case 1:
				emotion ET_FRET;
				mes "[大文]";
				mes "但是……这不是会打扰同一张地图上狩猎的其他人吗？";
				mes "我觉得这甚至会影响别人的游戏体验……";
				next;
				emotion ET_FRET;
				mes "[大文]";
				mes "也许你应该考虑别人的感受。";
				mes "引怪似乎只会让别人对你生气……";
				next;
				break;
			case 2:
				set .@pay_point,.@pay_point+5;
				mes "[大文]";
				mes "真的吗？我也讨厌！";
				next;
				mes "[大文]";
				mes "前几天我听到几个无赖吹嘘引怪。";
				mes "但我觉得他们只是在掩饰自己的不足。";
				next;
				emotion ET_FRET;
				mes "[大文]";
				mes "这种行为真的让我不舒服。";
				mes "即使我花了多年培养沉着的性格，遇到这种麻烦制造者时仍会生气。";
				next;
				emotion ET_BEST;
				mes "[大文]";
				mes "训练中遇到障碍时，绝不要向软弱屈服。";
				mes "坚定自己，凭荣誉感克服磨难！";
				next;
				break;
			case 3:
				set .@pay_point,.@pay_point+3;
				mes "[大文]";
				mes "至少你很诚实。";
				mes "但我不能认同这种意志薄弱的行为。真正的力量只能通过荣誉获得。记住这一点。";
				next;
				mes "[大文]";
				mes "面对压倒性的困难，不要绝望。没有困难取得的成就又算什么？挑战越大，荣耀越大。";
				next;
				mes "[大文]";

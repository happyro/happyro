//===== rAthena Script =======================================
//= Instances Heart Hunter War Base.
//===== Description: =========================================
//- [Walkthrough conversion]
//- Require Terra Gloria main quest.
//===== Changelogs: ==========================================
//= 1.0 First version. [Capuche]
//============================================================

// Einbroch Field - instance
ein_fild04,275,342,5	script	Striker Unit Commander#	4_M_REBELLION3,{
	if (terra_gloria_main < 19) {
		mes "[突击部队指挥官]";
		mes "嘿，谁在那里？";
		next;
		select("我正在和反叛军部队执行任务。");
		mes "[突击部队指挥官]";
		mes "这里很危险，你必须马上离开。我们就在敌方基地附近。";
		close;
	}
	switch( checkquest(12375,PLAYTIME) ) {
	case -1:
		break;
	case 0:
	case 1:
		mes "[突击部队指挥官]";
		mes "我们正在整理基地内部情况。现在还不能让你进去。";
		close;
	case 2:
		mes "^0000ff基地内部似乎已经整理完毕。^000000";
		erasequest 12375;// Base maintenance
		break;
	}
	if (isbegin_quest(12374) == 0) {
		mes "[突击部队指挥官]";
		mes "行动准备好后，你和我一起进去。";
		next;
		mes "[突击部队指挥官]";
		mes "对了，你收到朱利安将军的简报了吗？收到后再回来。";
		close;
	}
	mes "[突击部队指挥官]";
	mes "行动准备好后，你和我一起进去。";
	next;
	if (terra_gloria_main == 19)
		.@md_name$ = "Heart Hunter War Base 1";
	else
		.@md_name$ = "Heart Hunter War Base 2";
	switch( instance_enter(.@md_name$) ) {
	case IE_NOMEMBER:
		mes "^0000ff没有所属部队（队伍）的冒险者似乎无法进入。^000000";
		close;
	case IE_NOINSTANCE:
		mes "[突击部队指挥官]";
		mes "行动区域是" + .@md_name$ + " Check whether the operation was applied properly.";
		next;
		mes "^ff0000未清理心灵猎手战争基地前禁止前往外围边界，也无法进入已经清理过的基地。请确认行动地点。^000000";
		next;
		mes "^ff0000你的进度与队长或队员不同时会出现此情况。请找一名能和你前往同一地点的队员。^000000";
		next;
		mes "^ff0000若未将纪念地下城创建为行动区域，也无法进入。^000000";
		close;
	case IE_OTHER:
		mes "发生未知错误。";
		close;
	case IE_OK:
		mapannounce "ein_fild04", "队伍中的" + strcharinfo(0) + "正在进入" + .@md_name$ + "。", bc_map, 0xFF99;
		setquest 12375;// Base maintenance
		// if (terra_gloria_main == 20)
		// 	warp "1@swat",35,65;
		// else
		// 	warp "1@swat",73,118;
		end;
	}
}

ein_fild04,281,337,3	script	Julian#ep16.2	4_M_REBELLION2,{
	if (terra_gloria_main < 19) {
		mes "^ff0000在地下城内随意处理怪物（例如驯服怪物）不会被视为正常进度，请注意。^000000";
		next;
		mes "[Julian]";
		mes "站住，你属于哪个部队？根据你的回答，我们可能会动用武力压制你。";
		next;
		select("我正在和反叛军部队执行任务。");
		mes "[Julian]";
		mes "嗯，你是我们的人？侦察尚未结束，别在这里随意走动。";
		close;
	}
	mes "^ff0000在地下城内随意处理怪物（例如驯服怪物）不会被视为正常进度，请注意。^000000";
	next;
	if (getcharid(1) < 1) {
		mes "[Julian]";
		mes "你是没有岗位、四处游荡的逃兵吗？";
		next;
		mes "^ff0000只有队长可以和朱利安详细交谈。^000000";
		close;
	}
	switch( checkquest(12375,PLAYTIME) ) {
	case -1:
		break;
	case 0:
	case 1:
		mes "[Julian]";
		mes "我们正在整理基地内部的情况。你现在还不能进入。";
		close;
	case 2:
		mes "^0000ff基地内部似乎已经整理完毕。^000000";
		erasequest 12375;// Base maintenance
		next;
		break;
	}
	switch( isbegin_quest(12374) ) {
	case 0:
		mes "[Julian]";
		mes "你是攻打心灵猎手基地的增援部队吗？我想我们见过。";
		next;
		select("只是随便问问。");
		mes "[Julian]";
		mes "没关系。你应该大致了解这里的情况。记住，这不会是件容易的任务。";
		next;
		if (select( "向我说明情况。", "没时间了，现在就行动。" ) == 2) {
			mes "[Julian]";
			mes "听起来不错。你就像外籍军团，行动时待在我身边。";
		}
		else {
			mes "[Julian]";
			mes "嗯，你还没听过简报吗？时间不多了，我简单说明一下。";
			next;
			mes "[Julian]";
			mes "我们没有足够兵力攻打基地。";
			next;
			mes "[Julian]";
			mes "为了机动性，我们放弃了重型火器。首要任务是在尽量不破坏基地的情况下占领它，因此大多数爆炸性武器也被排除在外。";
			next;
			mes "[Julian]";
			mes "如有必要，我们可以利用战场地形强化火器……但必须尽量减少这种做法。";
			next;
			mes "[Julian]";
			mes "总之，行动大多必须针对人员，并尽可能维护基地设施。";
			next;
			mes "[Julian]";
			mes "我们的先遣队已经确保了南部基地的边界地面。我们将沿那条路线前往中央区域，各突击小队则分别行动。";
			next;
			mes "[Julian]";
			mes "你们就像外籍军团，行动时待在我身边。还有问题吗？当然，即使有问题我也不会回答。";
		}
		next;
		setquest 12374;// Heart Hunter Base occupation
		mes "[Julian]";
		mes "之后听从你们小队长的指示。基地大门打开后，去和那边的突击小队指挥官交谈并开始行动。";
		if (is_party_leader() == true) {
			next;
			mes "[Julian]";
			mes "如果你准备好了，我会通知你攻击时间。";
			next;
			if (select( "我准备好了。", "我还需要一点时间。" ) == 2) {
				mes "[Julian]";
				mes "明白了。我们时间紧迫，尽快准备好后告诉我。";
				close;
			}
			break;
		}
		close;
	case 1:
		if (is_party_leader() == false) {
			mes "[Julian]";
			mes "之后听从你们小队长的指示。基地大门打开后，去和那边的突击小队指挥官交谈并开始行动。";
			close;
		}
		mes "[Julian]";
		mes "你去厕所了吗？我正找你。";
		next;
		mes "[Julian]";
		mes "如果你准备好了，我会通知你攻击时间。";
		next;
		if (select( "我准备好了。", "我还需要一点时间。" ) == 2) {
			mes "[Julian]";
			mes "明白了。我们时间紧迫，尽快准备好后告诉我。";
			close;
		}
		break;
	case 2:
		if (is_party_leader() == false) {
			mes "[Julian]";
			mes "之后听从你们小队长的指示。基地大门打开后，去和那边的突击小队指挥官交谈并开始行动。";
			close;
		}
		mes "[Julian]";
		mes "我们占领的基地外围有一大片空地。我们在那里建了训练场，但设施并不完善。我需要精英人员来检查它。";
		next;
		mes "[Julian]";
		mes "哦，我是不是第一次告诉你这些？如果你能检查设施，我会很高兴。你觉得怎么样？";
		next;
		if (select( "让我来做。", "也许下次吧……" ) == 2) {
			mes "[Julian]";
			mes "明白了。是我要求太多。";
			close;
		}
		break;
	}
	if (terra_gloria_main == 19)
		instance_create("Heart Hunter War Base 1");
	else
		instance_create("Heart Hunter War Base 2");
	mes "[Julian]";
	mes "很快就会开放。基地大门打开后，去和那边的突击小队指挥官交谈并开始行动。";
	close;
}



				next;
				mes "[卡西斯]";
				mes "给你！";
				mes "请享用，并记住早餐是一天中最重要的一餐！";
				mes "现在我得准备午餐了。再见，我的朋友~";
				delitem 519,50;
				delitem 7031,50;
				delitem 548,50;
				delitem 539,50;
				getitem 5107,1;
				close;
			case 2:
				mes "[卡西斯]";
				mes "哦……";
				mes "哦，真对不起。";
				mes "我一定是把你";
				mes "和别人搞混了。";

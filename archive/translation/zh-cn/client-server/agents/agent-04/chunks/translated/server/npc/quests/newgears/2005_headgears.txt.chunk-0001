				next;
				mes "[卡西斯]";
				mes "是的……";
				mes "所以……";
				mes "抱歉……";
				mes "打扰你了……";
				next;
				mes "^3355FF卡西斯仿佛着了魔，继续盯着你携带的牛奶、奶酪、旧煎锅和蛋糕片。^000000";
				next;
				switch( select( "如果你想要，可以拿走这些。", "呃，你为什么一直盯着？" ) )
				{
					case 1:
						mes "[卡西斯]";
						mes "真的吗？你愿意让我拿走";
						mes "这些牛奶、奶酪、蛋糕片和旧煎锅？";
						mes "哦，冒险者，你真善良~";
						next;
						mes "[卡西斯]";
						mes "终于可以请我的";
						mes "朋友们享用美味";
						mes "盛宴了！他们一定很开心！";
						mes "哦，我真想报答你";
						mes "但不知道";
						mes "能给你什么……";
						next;
						mes "[卡西斯]";
			mes "当然！你何不";
			mes "";
						mes "品尝我的特色";
						mes "卡西斯的";
						mes "脆吐司？看起来";
						mes "简单，但实际上";
						mes "制作需要高超技艺。";
						next;
						mes "[卡西斯]";
						mes "给你！";
						mes "请享用，并记住早餐是一天中最重要的一餐！";
						mes "现在我得准备午餐了。再见，我的朋友~";
						delitem 519,50;
						delitem 7031,50;
						delitem 548,50;
						delitem 539,50;
						getitem 5107,1;
						close;
					case 2:
						mes "[卡西斯]";
						mes "哦，再次向你道歉。";
						mes "不过我忍不住欣赏你带来的物品——";
						mes "嗯，你带着的食物。毕竟我是厨师。";
						close;
			}
		}
	}
	mes "[卡西斯]";
	mes "抱歉，我们现在歇业。";
	mes "很遗憾，店里已经没有面包了。^333333*唉……*^000000";
	next;
	switch( select( "出什么事了吗？", "结束对话。" ) )
	{
		case 1:
			mes "[卡西斯]";
			mes "我和食材供应公司的合同到期了。";
			mes "当然，没有食物就无法经营，这已经够糟了。";
			next;
			mes "[卡西斯]";
			mes "但我也觉得让朋友们失望了。";
			mes "他们在艾因布洛克工厂工作以来，";
			mes "我每天都给他们送午餐。";
			next;
			mes "[卡西斯]";
			mes "我现在没法给他们做午餐，";
			mes "但真的很想帮助伙伴们，";
			mes "尤其是他们目前的经济状况似乎很糟。";
			next;
				switch( select( "要我帮你吗？", "听到这个我很遗憾。" ) )
			{
				case 1:
					mes "[卡西斯]";
					mes "当然，我愿意接受";
					mes "任何能找到的帮助。如果可以，";
					mes "请带些食材给我，";
					mes "让我为工厂里的朋友们制作午餐。";
					next;
					mes "[卡西斯]";
					mes "请帮我取得";
					mes "^4D4DFF50 份牛奶^000000、";
					mes "^4D4DFF50 份奶酪^000000、";
					mes "^4D4DFF50 份蛋糕片^000000和";
					mes "^4D4DFF50 口旧煎锅^000000？";
					next;
					mes "[卡西斯]";
					mes "我真的很感谢你的帮助。";
					mes "朋友们在工厂工作似乎很沮丧，";
					mes "我想尽力让他们开心。";
					mes "谢谢你的好意~";
					close;
				case 2:
					mes "[卡西斯]";
					mes "我正在尝试与食材供应公司续约，";
					mes "但到目前为止进展并不顺利……";
					next;
					mes "[卡西斯]";
					mes "我不知道发生了什么，但希望很快找到新供应商。";
					mes "朋友们需要担心，我的生意也需要维持。";
					close;
			}
		case 2:
			mes "[卡西斯]";
			mes "总之，请再来。希望下次店里能有好面包，好吗？";
			close;
	}
}


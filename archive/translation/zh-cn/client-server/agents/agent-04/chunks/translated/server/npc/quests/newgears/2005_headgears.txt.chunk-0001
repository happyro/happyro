										mes "呃，你真是最糟糕的";
										mes "那种人，你知道吗？";
										emotion ET_HUK;
										close;
									case 2:
										mes "[Morris]";
						mes "我觉得道歉已经太晚了。";
						mes "你怎么能用如此尖刻的讽刺对待我这种人物？！";
						mes "有什么借口能为你的行为开脱？！";
										next;
										switch( select( "I... I was intimidated...", "It's how I treat all losers." ) )
										{
											case 1:
												mes "[Morris]";
								mes "当然了：对我广博智慧的敬畏和恐惧，";
								mes "导致了这种异常行为。";
								mes "我想我必须原谅你。";
												next;
											case 2:
												mes "[Morris]";
								mes "什么……？！";
								mes "莫里斯·坡是失败者？";
								mes "这种诽谤言论不可原谅，";
								mes "无论多么毫无根据！";
												emotion ET_HUK;
												close;
										}
								}
						}
						break;
					case 3:
						mes "[Morris]";
					mes "哈哈哈，哦，真有趣。等等，你……";
					mes "你真的要走了。";
						mes "N-no, come baaaack!";
						close;
				}
				break;
			case 2:
				mes "[Strange Guy]";
			mes "我怎么知道的？";
			mes "很简单，我的朋友。";
			mes "线索多得足以让我做出这种简单推理。";
				close;
			case 3:
				mes "[Strange Guy]";
			mes "喂……？";
				mes "...............";
			mes "哦，真尴尬。";
			mes "真不敢相信你竟然对我冷处理……";
				close;
		}
		mes "[Morris]";
		mes "是的，我知道你很难相信";
		mes "自己竟有幸站在天才面前。";
		mes "现在，你一定在想……";
		next;
		select("呃，在想什么？");
			mes "[Morris]";
			mes "你在想：";
			mes "‘我究竟怎样才能像";
			mes "天才侦探莫里斯·坡一样聪明？’";
			next;
			mes "[Morris]";
			mes "首先，我应该告诉你，这是不可能的梦想。";
			mes "像我这样的男人，世上也许一代才出现一个。";
			mes "抱歉，但别放弃！";
			next;
			mes "[Morris]";
			mes "现在，你可以加入少年侦探俱乐部，";
			mes "尝试达到和我相当的智力水平。";
			mes "成为会员只需一件必需物品。";
			next;
			mes "[Morris]";
			mes "没错，你需要";
			mes "^0000FF名侦探帽^000000！";
			mes "幸运的是，我会以相对低廉的材料费提供，";
			mes "但要趁库存充足赶快行动。";
			next;
			mes "[Morris]";
			mes "只要带给我";
			mes "^0000FF10 个放大镜^000000、";
			mes "^0000FF1887 个流苏^000000、";
			mes "^0000FF1 顶开槽水桶帽^000000";
			mes "以及 ^0000FF1,887 Zeny^000000。就这些！";
			next;
			mes "[Morris]";
			mes "不过先提醒你，别带装有卡片的^FF0000开槽水桶帽，";
			mes "也别带任何升级过的水桶帽。由此造成的损失我不负责。";
			next;
			mes "[Morris]";
			mes "快把这些物品带来！";
			mes "只剩 20,000,000 顶名侦探帽了！";
			mes "卖完就绝版！";
			set DTHATQ,1;
			close;
	}
	else if(DTHATQ == 1)
	{

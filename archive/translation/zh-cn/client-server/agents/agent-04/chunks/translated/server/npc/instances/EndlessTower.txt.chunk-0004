5@tower,106,109,2	script	Lucid Crystal#102	844,{
	if (in_102tower < 10) {
		mes "^0000ff你触摸散发强光的透明水晶时，神秘声音在房间里回荡。^000000";
		next;
		mes "[Mysterious Voice]";
		mes "欢迎来到我的地盘，入侵者们。看着你们承受我设置的重重困难，我很开心。";
		next;
		mes "[Mysterious Voice]";
		mes "遗憾的是，演出该结束了。";
		next;
		mes "[Mysterious Voice]";
		mes "现在庆祝你们战胜我的左右手 Knothen 还太早，因为他还没有被彻底消灭！";
		next;
		mes "[Mysterious Voice]";
		mes "我会让他复活，作为你们下一场演出的对手。再次击败他，我就会欣然接受你们的挑战。";
		next;
		mes "[Mysterious Voice]";
		mes "暂时再见。";
		mes "人类，我又一次玩得很开心。期待再次见到你们。";
		next;
		mes "^0000ff声音停止后，一股无法抗拒的力量将你托起，带到了别处。";
		close2;
		set in_102tower,10;
		warp "alberta",223,36;
	}
	else {
		mes "^0000ff发光的水晶碎片似乎像上次一样在召唤你。^000000";
		next;
		mes "[Mysterious Voice]";
		mes "我一定低估你们了……没想到还能再见到你们。";
		next;
		mes "[Mysterious Voice]";
		mes "我能闻到你们的汗水，听见战斗中疲惫的喘息。啊～人类对胜利的渴望总是让我兴奋。";
		next;
		mes "[Mysterious Voice]";
		mes "现在我允许你们来见我。来吧，黑暗霸主 Naght Sieger！";
		close2;
		warp instance_mapname("6@tower"),32,12;
	}
	end;

OnInstanceInit:
OnDisable:
	disablenpc instance_npcname("Lucid Crystal#102");
	end;

OnEnable:
	enablenpc instance_npcname("Lucid Crystal#102");
	donpcevent instance_npcname("#102Effect1")+"::OnEnable";
	end;
}


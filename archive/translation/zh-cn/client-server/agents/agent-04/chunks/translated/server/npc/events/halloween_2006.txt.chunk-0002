		mes "[Chicken Masta]";
		mes "这座城镇太危险，不适合你逗留。";
		mes "你最好回到来处……";
		next;
		mes "[Chicken Masta]";
		mes "……你在找鸡蛋吗？";
		mes "最近有人向我要鸡蛋做某种派……你也是其中之一？";
		next;
		if (select( "没错，我来这里拿鸡蛋。:不是。") == 1) {
			mes "[Chicken Masta]";
			mes "好吧。但我的一些鸡跑掉了，";
			mes "所以剩下的鸡蛋不多。";
			mes "1000 Zeny 买 2 个鸡蛋！怎么样？";
			next;
			switch(select( "好，我要了。:我只买一个。:呼～太贵了。")) {
			case 1:
				if (Zeny > 1999) {
					mes "[Chicken Masta]";
					mes "谢谢。";
					mes "这是鸡蛋。";
					set Zeny,Zeny-2000;
					set halloween, 102;
					getitem 574,2; //Egg
					close;
				}
				else {
					mes "[Chicken Masta]";
					mes "嘿，这不够～";
					mes "每个 1000 Zeny，买两个就是 2000 Zeny。";
					close;
				}
			case 2:
				if (Zeny > 999) {
					mes "[Chicken Masta]";
					mes "谢谢。";
					mes "这是鸡蛋。";
					set Zeny,Zeny-1000;
					set halloween, 102;
					getitem 574,1; //Egg
					close;
				}
				else {
					mes "[Chicken Masta]";
					mes "你的钱似乎不够……";
					mes "每个要 1000 Zeny。";
					close;
				}
			case 3:
				mes "[Chicken Masta]";
				mes "嗯……我知道有点贵，但正如我说的，我的鸡跑掉了。";
				mes "你得理解。";
				close;
			}
		}
		mes "[Chicken Masta]";
		mes "我只告诉你一件事！";
		mes "如果不想死，你最好逃走。这里太危险了。";
		mes "";
		close;
	}
	else if (halloween == 102) {
		mes "[Chicken Masta]";
		mes "你需要鸡蛋……？那先帮我。";
		mes "我的 8 只鸡跑掉了。";
		mes "我不知道它们在哪里。";
		mes "";
		next;
		mes "[Chicken Masta]";
		mes "我不指望所有鸡都回家。";
		mes "只要你找到其中一只，我就卖给你 3 个鸡蛋。";
		next;
		mes "[Chicken Masta]";
		mes "这笔交易很划算吧？";
		mes "鸡应该就在附近。";
		next;
		mes "[Chicken Masta]";
		mes "找到鸡后不用把它带回来，";
		mes "只要输入 ^4d4dff‘Return’^000000。";
		mes ".........";
		next;
		mes "[Chicken Masta]";
		mes "这是让鸡回家的咒语。";
		mes "……";
		mes "别忘了‘Return’这个词！";
		next;
		mes "[Chicken Masta]";
		mes "希望你能找到我的鸡。";
		close;
	}
	else if (halloween == 103) {
		mes "[Chicken Masta]";
		mes "哦，你回来了。我一直在等你。";
		mes "谢谢你送回我的鸡。";
		mes "它们安全地关在鸡舍里，免得再次逃跑。";
		next;
		mes "[Chicken Masta]";
		mes "我没忘记我们的约定。";
		mes "告诉我你要多少鸡蛋。";
		mes "每个 1000 Zeny。";
		mes "最多只能买 3 个。";
		next;
		while(1) {
			input .@input;
			if (.@input == 0) {
				mes "[Chicken Masta]";
				mes "不需要的话就不用买。";
				close;
			}
			else if (@input > 3) {
				mes "[Chicken Masta]";
				mes "我怎么说的。";
				mes "我只卖三个鸡蛋。";
				next;
			}
			else
				break;
		}
		set .@hw_egg, .@input * 1000;
		if (Zeny < @hw_egg) {
			mes "[Chicken Masta]";
			mes "你的 Zeny 似乎不够。";
			close;
		}
		mes "[Chicken Masta]";
		mes "给你。";
		mes "但没有更多了。";
		mes "想要更多鸡蛋，就找更多鸡来。";
		set Zeny,Zeny-@hw_egg;
		getitem 574, @input;//Egg
		set halloween, 102;
		close;
	}
	else {
		mes "[Chicken Masta]";
		mes "鸡跑到哪里去了？！";
		mes "哦，陌生人，你需要什么帮助？";
		next;
		mes "[Chicken Masta]";
		mes "这座城镇太危险，不适合你逗留。";
		mes "你最好回到来处……";
		close;
	}
}

nif_fild01,167,113,3	script	Masta's chicken#06_hw01	800,{
	mes "打瞌睡的鸡。";
	close;
}

-	script	HwChicken::HwChicken	-1,{
	if ((halloween == 102) || (halloween == 103)) {
		mes "哦，这一定是 Chicken Masta 的鸡。";
		mes "我应该输入魔法词。";
		next;
		input .@inputstr$;
		if( .@inputstr$ == "Return" ) {
			emotion ET_HUK;
			specialeffect EF_TELEPORTATION;
			mes "魔法咒语已施放。";
			set halloween, 103;
			disablenpc "Masta's chicken#"+strnpcinfo(1);
			close2;
			sleep 180000;
			enablenpc "Masta's chicken#"+strnpcinfo(1);
			end;
		}
		else {
			mes "[" + strcharinfo(0) + "]";
			mes "嗯……我一定拼错了。";
			close;
		}
	}
	else {
		mes "打瞌睡的鸡。";
		close;
	}
}

-	script	HwChicken2::HwChicken2	-1,{
	set @egg_temp,rand(1,4);
	if( @egg_temp == 3) {
		mes "你靠近并触碰鸡后，它完全消失了。";
		mes "鸡消失的地方留下了一个‘鸡蛋’。";
		disablenpc "Chicken#"+strnpcinfo(1);
		getitem 574,1; //Egg
		close;
	}
	else {
		mes "你靠近并触碰鸡后，它完全消失了。";
		disablenpc "Chicken#"+strnpcinfo(1);
		close;
	}
}

-	script	HwChicken3::HwChicken3	-1,{
	set @egg_temp,rand(1,4);
	if( @egg_temp == 3) {
		mes "你靠近并触碰鸡后，它完全消失了。";
		mes "鸡消失的地方留下了一个‘鸡蛋’。";
		disablenpc "Chicken#"+strnpcinfo(1);
		getitem 574,1; //Egg
		close;
	}
	else {
		mes "你靠近并触碰鸡后，它完全消失了。";
		disablenpc "Chicken#"+strnpcinfo(1);
		close;
	}

OnInit:
	while(1) {
		sleep 180000;
		specialeffect EF_BAT2;
		end;
	}
}



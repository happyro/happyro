// Dimensional Travel Quest
morocc,138,238,4	script	Piled Rags#ep14bs	4_M_DIEMAN,{
	if (BaseLevel < 140) {
		mes "- 这里有一堆脏抹布。 -";
		close;
	}
	if (checkweight(1119,3) == 0) {
		mes "- 物品太多，无法继续任务。 -";
		close;
	}
	if (ep14_3_newerabs == 0) {
		mes "- 这里有一堆脏抹布。 -";
		next;
		if (select( "留下它。", "移走它。" ) == 1) {
			mes "- 你把脏抹布留在原地。 -";
			close;
		}
		mes "[???]";
		mes "呃……";
		next;
		mes "- 抹布下面传来呻吟。 -";
		next;
		if (select( "逃跑。", "摇动抹布。" ) == 1) {
			mes "- 你受到惊吓，跑开了。 -";
			close;
		}
		mes "[" + strcharinfo(0) + "]";
		mes "嘿，";
		mes "醒醒！";
		next;
		mes "[???]";
		mes "呃……";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "你还好吗？";
		next;
		mes "[???]";
		mes "呃……";
		mes "我需要食物……";
		mes "我甚至可以吃^0000FF怪物饲料^000000。求你……";
		next;
		mes "- 他又一次失去了意识，光是说话就已经筋疲力尽。-";
		mes "你应该给他喂^0000FF怪物饲料^000000。 -";
		setquest 11349;// Dimensional Travel
		ep14_3_newerabs = 1;
		close;
	}
	if (ep14_3_newerabs < 5) {
		if (ep14_3_newerabs == 1) {
			if (countitem(528) < 1) {
				mes "- 他又一次失去了意识，光是说话就已经筋疲力尽。-";
				mes "你应该给他喂^0000FF怪物饲料^000000。 -";
				close;
			}
			mes "[???]";
			mes "呃……";
			next;
			if (select( "留下它。", "给予怪物饲料。" ) == 1) {
				mes "[???]";
mes "呃……救、救命……";
				close;
			}
			mes "[???]";
			mes "呃……";
			mes "呸！";
			cutin "ep143_tadir.bmp",2;
			delitem 528,1;// Monster's Feed
			completequest 11349;// Dimensional Travel
			setquest 11350;// Dimensional Travel
			ep14_3_newerabs = 2;
			next;
			mes "[???]";
			mes "*大口咀嚼*";
			mes "*呕吐*";
			next;
			mes "[???]";
			mes "呼……";
			next;
		}
		if (ep14_3_newerabs == 2) {
			mes "[" + strcharinfo(0) + "]";
			mes "你还好吗？";
			next;
			mes "[???]";
			mes "*干呕*哦，是的，多亏了你。";
		mes "*呕*";
			cutin "ep143_tadir.bmp",2;
			next;
			mes "[???]";
			mes "我以为我要死了。能活着真幸运。";
			next;
			mes "[???]";
			mes "我最近一直倒霉。";
			next;
			mes "[???]";
		mes "我被吸进了奇怪的地方，和队伍其他人分开了。那里非常可怕，看不到任何人类居住的痕迹。";
			next;
			mes "[???]";
			mes "我能在这里真是奇迹。";
			next;
			mes "[???]";
			mes "我走运了。";
			mes "还活着。";
		mes "哈哈哈！";
			next;
			mes "[???]";
			mes "Oh!";
			mes "我真失礼，忘了好好感谢你。";
			next;
			mes "[???]";
			mes "谢谢你";
			mes "喂我，尽管饲料味道很糟。";
			next;
			mes "[???]";
			mes "我很高兴没死在街上。世界仍然美丽。";
			mes "我很感动。";
			next;
			mes "[塔玛林]";
			mes "我叫^0000FFTamarin^000000。";
			mes "我是冒险者，不，这不是我喜欢的穿着。";
			next;
			select("自我介绍。");
		mes "[塔玛林]";
			mes "" + strcharinfo(0) + "，嗯？真是个好名字。";
			next;
		}
		if (ep14_3_newerabs <= 3) {
		mes "[塔玛林]";
			mes "啊，";
			mes "我最好做点什么，免得人们开始问我是不是无家可归。";
			cutin "ep143_tadir.bmp",2;
			next;
		mes "[塔玛林]";
			mes "你知道哪里可以洗澡吗？";
			next;
			if (select( "告诉他地点。", "说你不知道。" ) == 2) {
				mes "[塔玛林]";
				mes "沙漠里水很稀缺，对吧？";
				ep14_3_newerabs = 3;
				close3;
			}
		}
		if (ep14_3_newerabs <= 4) {
		mes "[塔玛林]";
			mes "Ah,";
			mes "你是指^0000FF斯芬克斯西北方的绿洲^000000吗？";
			cutin "ep143_tadir.bmp",2;
			next;
			mes "[塔玛林]";
			mes "我去过梦罗克，但这是我第一次进入这个村庄。";
			mes "我记得听说这里有特殊的水。";
			next;
			mes "[塔玛林]";
			mes "想到要用特殊的水清洗自己，我就兴奋！";
			mes "我要去绿洲了。你能等我吗？";
			next;
			mes "[塔玛林]";
			mes "恢复力气还要一段时间，但至少我能自己走路了。";
			mes "哈哈哈！";
			next;
			if (select( "Watch him.", "Accompany him." ) == 1) {
				mes "[塔玛林]";
				mes "（他支撑身体并吸气。）";
				mes "等等，等等。";
				mes "我能自己站起来。";
				next;
				mes "[塔玛林]";
				mes "等等，等等！";
				ep14_3_newerabs = 4;
				close3;
			}
			mes "[塔玛林]";
			mes "你真善良！";
			mes "这个世界还是适合生活的。";
			next;
			mes "[塔玛林]";
			mes "那么，我们去^0000FF斯芬克斯西北方的绿洲^000000吧。";
			changequest 11350,11351;
			ep14_3_newerabs = 5;
			close3;
		}
	}
	if (ep14_3_newerabs == 5) {
		mes "[塔玛林]";
		mes "你真善良！";
		mes "这个世界还是适合生活的。";
		cutin "ep143_tadir.bmp",2;
		next;
		mes "[塔玛林]";
		mes "那么，我们去^0000FF斯芬克斯西北方的绿洲^000000吧。";
		close3;
	}
	mes "- 这里有一堆脏抹布。 -";
	close;

OnInit:
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "BaseLevel >= 140 && !isbegin_quest(11349)" );
	end;
}

moc_ruins,106,140,4	script	Tamarin#ep14bs_ru	4_M_TAMARIN,{
	if (ep14_3_newerabs == 5 || ep14_3_newerabs == 6) {
		if (ep14_3_newerabs == 5) {
			mes "[塔玛林]";
			mes "哈！";
			mes "感觉真棒！";
			cutin "ep143_tasmi.bmp",2;
			next;
			mes "[塔玛林]";
			mes "水对我来说有点太暖了，但叫花子没得挑。";
			cutin "ep143_tasta.bmp",2;
			next;
			mes "[塔玛林]";
			mes "你救我免于饿死，还带我来到这个好地方。我前世一定是个大好人，";
			mes "否则不会得到这样的善意。";
			cutin "ep143_tahuk.bmp",2;
			next;
			mes "[塔玛林]";
			mes "我想报答你，冒险者。";
			mes "我掉进那个奇怪的洞后和队伍走散，所有财物都丢了，";
			cutin "ep143_tasta.bmp",2;
			next;
			mes "[塔玛林]";
			mes "但至少我可以告诉你一个^0000FF有趣的故事^000000。";
			cutin "ep143_tasmi.bmp",2;
			next;
			mes "[塔玛林]";
			mes "是关于我去过的奇怪地方。";
			cutin "ep143_tahuk.bmp",2;
			next;
			if (select( "Not interested.", "I'm listening." ) == 1) {
				mes "[塔玛林]";
				mes "好吧。";
				mes "我还以为你很认真地对待冒险呢。";
				cutin "ep143_tahuk.bmp",2;
				next;
				mes "[塔玛林]";
				mes "那么，";
				mes "你想要回怪物饲料吗？";
				cutin "ep143_tasta.bmp",2;
				next;
				mes "[塔玛林]";
				mes "*呕*";
				cutin "ep143_taang.bmp",2;
				close3;
			}
			mes "[塔玛林]";
			mes "我就知道你会感兴趣！";
			mes "没有什么比奇怪地方的故事更能引起冒险者的兴趣，对吧？";
			cutin "ep143_tasmi.bmp",2;
			next;
			mes "[塔玛林]";
			mes "咳咳。";
			mes "故事始于我前往^0000FF异世界^000000的旅程，那是冒险者最近的热门地点。";
			cutin "ep143_tahuk.bmp",2;
			next;
			mes "[塔玛林]";
			mes "冒险者塔玛林和他的队伍踏上了前往未知之地——异世界的旅程。";
			cutin "ep143_tasmi.bmp",2;
			next;
			mes "[塔玛林]";
			mes "他们的旅途充满危险，但仍勇敢前进。";
			cutin "ep143_taang.bmp",2;
			next;
			mes "[塔玛林]";
			mes "哦，";
			mes "我为什么要用第三人称说话？";
			cutin "ep143_tahuk.bmp",2;
			next;
			mes "[塔玛林]";
			mes "我最初想成为诗人，但朋友们觉得猎人更适合我，所以后来成了猎人。";
			cutin "ep143_tasmi.bmp",2;
			next;
			select("让他讲得直白些。");
			mes "[塔玛林]";
			mes "好。";
			cutin "ep143_tahuk.bmp",2;
			next;
			mes "[塔玛林]";
			mes "不久前，我和朋友们决定一起探索异世界。";
			cutin "ep143_tasta.bmp",2;
			next;
			mes "[塔玛林]";
			mes "因为是第一次去异世界，我们想去更热门的地点，但其中一人不愿意——他太兴奋，开始失去控制。";
			cutin "ep143_taang.bmp",2;
			next;
			mes "[塔玛林]";
			mes "恢复意识时，我已经独自一人在一个奇怪的地方。";
			cutin "ep143_tahuk.bmp",2;
			next;
			mes "[塔玛林]";
			mes "那片^0000FF土地燃烧着永不熄灭的火焰^000000，摸起来却不太热，到处爬满了^0000FF外形奇怪的植物和昆虫^000000。";
			next;
			mes "[塔玛林]";
			mes "起初我大声求救并四处寻找其他人，但一无所获。";
			next;
			mes "[塔玛林]";
			mes "几天没东西吃后，我开始捡地上的任何东西来吃，结果得了最严重的腹泻。";
			cutin "ep143_taang.bmp",2;
			next;
			mes "[塔玛林]";
			mes "我不知道过去了多少天，直到看到一群乍看像人的存在。";
			cutin "ep143_tahuk.bmp",2;
			next;
			mes "[塔玛林]";
			mes "但^0000FF他们看起来太奇怪，不能算是人类^000000。";
			mes "我无法和他们交谈，只好跳进他们出来的裂缝。";
			next;
			mes "[塔玛林]";
			mes "我的膝盖失去力气，侧身滚倒。环顾四周时，我回到了和朋友们最初抵达的^0000FF次元裂缝^000000。";
			next;
			mes "[塔玛林]";
			mes "我通过^0000FF梦罗克次元传送点^000000出来，用尽所有力气回到梦罗克。";
			next;
			mes "[塔玛林]";
			mes "唉……";
			mes "不知道我的朋友是否安全。";
			cutin "ep143_tasta.bmp",2;
			next;
		}
		mes "[塔玛林]";
		mes "我应该去找他们，";
		mes "但在恢复全部力气后，我想先回那个奇怪的地方。不是很多人都有机会看到那样特别的地方。";
		cutin "ep143_tasmi.bmp",2;
		next;
		mes "[塔玛林]";
		mes "幸运的是，^0000FF梦罗克重建工作^000000正在进行，我可以靠一些兼职赚钱。";
		next;
		if (select( "Tell him have safe travel.", "Tell him you want to tag along." ) == 1) {
			mes "[塔玛林]";
			mes "我会的。";
			mes "谢谢你救了我。";
			cutin "ep143_tahuk.bmp",2;
			next;
		mes "[塔玛林]";
		mes "这就是冒险的美妙之处：";
		mes "结识新朋友！";
			cutin "ep143_tasmi.bmp",2;
			next;
		mes "[塔玛林]";
		mes "我会在梦罗克待一阵子，赚些钱，为下一次冒险做准备。希望离开前还能再见到你。";
			ep14_3_newerabs = 6;
			close3;
		}
		mes "[塔玛林]";
		mes "！！";
		cutin "ep143_tahuk.bmp",2;
		next;
		mes "[塔玛林]";
		mes "你是认真的吗？";
		next;
		mes "[塔玛林]";
		mes "天啊，我真是个幸运的混蛋！";
		mes "*抽泣*";
		cutin "ep143_taang.bmp",2;
		next;
		mes "[塔玛林]";
		mes "那就在^0000FF次元裂缝^000000见。我得先恢复体力。";
		cutin "ep143_tasta.bmp",2;
		next;
		mes "[塔玛林]";
		mes "收拾好所有东西可能要花些时间，你先去处理其他事情吧。";
		erasequest 11351;// Dimensional Travel
		setquest 11352;// Dimensional Travel
		ep14_3_newerabs = 7;
		close3;
	}
	if (ep14_3_newerabs == 7) {
		mes "[塔玛林]";
		mes "那就在^0000FF次元裂缝^000000见。我得先恢复体力。";
		cutin "ep143_tasta.bmp",2;
		next;
		mes "[塔玛林]";
		mes "收拾好所有东西可能要花些时间，你先去处理其他事情吧。";
		close3;
	}
	mes "[塔玛林]";
	mes "哈！";
	mes "感觉真棒！";
	cutin "ep143_tasmi.bmp",2;
	close3;
}


				erasequest 14590;// Hunter's destination
				close;
			case 2:
				mes "[渔夫]";
				mes "太谢谢你了。我敢说它们暂时不敢出现。";
				next;
				mes "[渔夫]";
				mes "不过我觉得你应该寻找更大的冒险。别让技能浪费在这个偏僻地方，去更广阔的世界吧。";
				next;
				mes "[渔夫]";
				mes "对了，还有人需要帮助。你今天已经很累了，也许明天再去见他。";
				next;
				mes "[渔夫]";
				if (BaseLevel < 21)
					mes "住在蛇女洞穴入口的^4D4DFF[困倦喵]^000000正在寻找强者。也许你可以试试。谢谢你的帮助。";
				else
					mes "从^4D4DFF[码头]^000000乘船寻找更大的冒险也是好主意。谢谢你的帮助。";
				erasequest 14590;// Hunter's destination
				if (isbegin_quest(14592) == 0 && BaseLevel < 21)
					setquest 14592;// Resting Time
				getexp 400,800;
				close;
			}
		}
		mes "[渔夫]";
		mes "今天风不错！鱼会晒得很好。";
		close;
	}
	switch( checkquest(14592,PLAYTIME) ) {
	case -1:
		switch( checkquest(14590,HUNTING) ) {
		case -1:
			mes "[渔夫]";
			mes "哦，我该怎么办。嘿，冒险者！等一下！";
			next;
			if (select( "怎么了？", "我现在很忙。" ) == 2) {
				mes "[渔夫]";
				mes "是吗？那我想也没办法了。";
				close;
			}
			mes "[渔夫]";
			mes "看看那些沙漠狼，你觉得怎么样？";
			next;
			mes "[渔夫]";
			mes "那些怪物把我正在晒的鱼全偷走了！";
			next;
			mes "[渔夫]";
			mes "世上哪有猎杀沙漠狼会吃鱼？还是晒干的鱼！";
			next;
			mes "[渔夫]";
			mes "不过……这种鱼味道浓郁，尝过一次就很难忘记。";
			next;
			mes "[渔夫]";
			mes "但这是厨师最喜欢的零食，也是挑食者唯一喜欢的零食。";
			next;
			mes "[渔夫]";
			mes "没有它，我们会很难熬。";
			next;
			mes "[渔夫]";
			mes "哦，它们又来了！冒险者，请别让它们靠近这里。捕捉十只。";
			setquest 14590;// Hunter's destination
			close;
		case 0:
		case 1:
			mes "[渔夫]";
			mes "那些猎杀沙漠狼还在横行。";
			next;
			mes "[渔夫]";
			mes "至少要捕捉十只。";
			close;
		case 2:
			mes "[渔夫]";
			mes "冒险者，我当时太绝望，随便抓住路人求助，但看来我走运了！";
			next;
			mes "[渔夫]";
			mes "别误会。虽然看起来如此，但我真的发自内心感谢你。谢谢！";
			next;
			mes "[渔夫]";
			mes "希望你明天也能帮我！";
			erasequest 14590;// Hunter's destination
			setquest 14592;// Resting Time
			getexp 400,800;
			close;
		}
	case 0:
	case 1:
		mes "[渔夫]";
		mes "猎杀沙漠狼现在很安静。它们一定被你的行动吓到了。";
		next;
		mes "[渔夫]";
		mes "所以希望你明天再回来！";
		close;
	case 2:
		mes "[渔夫]";
		mes "冒险者，很高兴见到你！它们正凶猛地冲来。看来昨天没鱼让它们很生气。";
		next;
		mes "[渔夫]";
		mes "哇！它们又来了！冒险者，请让那些猎杀沙漠狼远离这里。捕捉十只。";
		erasequest 14592;// Resting Time
		setquest 14590;// Hunter's destination
		close;
	}

OnInit:
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "!isbegin_quest(14590) && !isbegin_quest(14592) && BaseLevel >= 16 && BaseLevel <= 19" );
	end;
}


			next;
			mes "[Florin]";
			mes "不过我觉得你更适合去别的地方工作，而不是这片田地。";
			next;
			mes "[Florin]";
			mes "如果你愿意，我可以帮你找工作？你今天做了很多事，请好好休息，明天见。";
			next;
			mes "[Florin]";
			mes "我听说普洛克现在需要帮助。去看看^4D4DFF[普洛克]^000000吧？谢谢你的帮助。";
			navigateto "lasa_fild01",177,241;
			erasequest 14588;// The Competition
			setquest 14592;// Resting Time
			getexp 200,300;
			close;
		}
	case 0:
	case 1:
		mes "[Florin]";
		mes "野生黄蜂现在很安静。数量这么少，我自己就能处理。";
		next;
		mes "[Florin]";
		mes "太阳升起后它们还会回来。到时候你能再来帮我吗？";
		close;
	case 2:
		mes "[Nedsoli]";
		mes "你今天看起来也需要帮助。要我帮忙吗？";
		next;
		mes "[Florin]";
		mes "啊，冒险者，很高兴你来了！";
		next;
		mes "[Florin]";
		mes "今天也请你击败我们的对手野生黄蜂，大约十只。谢谢！";
		erasequest 14592;// Resting Time
		setquest 14588;// The Competition
		close;
	}

OnInit:
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "!isbegin_quest(14588) && !isbegin_quest(14592) && BaseLevel >= 10 && BaseLevel <= 13" );

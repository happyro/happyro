lasa_fild02,326,170,5	script	Fisher#dorcon	4_CAT_ADV2,{
	if (BaseLevel < 16 || BaseLevel > 19) {
		if (BaseLevel > 19) {
			if (checkquest(14592,PLAYTIME) == 2)
				erasequest 14592;
			switch( checkquest(14590,HUNTING) ) {
			case -1:
				break;
			case 0:
			case 1:
				mes "[渔夫]";
				mes "冒险者，先停一下。我想接下来自己就能处理。你似乎太强了，不适合做这种工作。";
				next;
				mes "[渔夫]";
				if (BaseLevel < 21)
					mes "住在蛇女洞穴入口的^4D4DFF[困倦喵]^000000正在寻找强者。也许你可以试试。谢谢你的帮助。";
				else

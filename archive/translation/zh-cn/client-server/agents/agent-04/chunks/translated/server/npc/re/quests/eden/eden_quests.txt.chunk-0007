			mes "从怪物那里带来以下物品。";
			next;
			mes "[罗密欧]";
			mes "5 个乌坦战士肩甲";
			mes "7 片树精尖叶";
			next;
			mes "[罗密欧]";
			mes "这是最后的测试。";
			mes "祝你好运。";
			para_2nd01 = 4;
			erasequest 7216;// More Golem Hunting
			setquest 7217;// Field drops
			getexp 10000,10000;
		}
		else {
			mes "看来你没有迷路。";
			mes "但你没有击败足够的钟乳石魔。";
			mes "回去击败它们。";
			next;
			mes "[罗密欧]";
			mes "如果你累了，我会帮你恢复。";
			npcskill "AL_HEAL",10,99,60;
			percentheal 0,100;
		}
	}
	else if (para_2nd01 == 4) {
		if (countitem(7196) > 4 && countitem(7100) > 6) {// Shoulder_Protection, Sharp_Leaf
			mes "你真的是击败怪物得到这些的？";
		mes "我相信你。反正我也想离开这里。";
			next;
			mes "[罗密欧]";
			mes "这里没有更多训练任务。";
			mes "回去向 Ur 报告。";
			delitem 7196,5;
			delitem 7100,7;
			para_2nd01 = 5;
			erasequest 7217;// Field drops
			setquest 7218;// Report to Instructor Ur
			getexp 10000,10000;
		}
		else {
			mes "我不是已经告诉过你上一个任务了吗？";
			mes "击败森林里的怪物，并把我要求的物品带来。";
			next;
			mes "[罗密欧]";
			mes "5 个乌坦战士肩甲";
			mes "7 片树精尖叶";
			mes "必须带来这些才能通过测试。";
			next;
			mes "[罗密欧]";
			mes "如果你累了，我会帮你恢复。";
			npcskill "AL_HEAL",10,99,60;
			percentheal 0,100;
		}
	}
	else {
		mes "呃，这里太热了。";
		mes "你现在可以离开。";
	}
	close;
}

//--70~79
// glast_01,195,131,5	script	Dispatched Instructor#2nd03	4_F_SISTER,{
glast_01,195,131,5	script	Dispatched Instructor#03	4_F_SISTER,{
	mes "[约翰]";
	if (para_2nd01 < 7) {
		mes "啊~好无聊。";
		mes "你不是 Ur 派来的人，对吧？";
		mes "哦~没关系。";
		next;
	mes "[约翰]";
		mes "这里是克雷斯特汉姆修道院。";
		mes "小心，这里有许多迷失的灵魂。";
	}
	else if (para_2nd01 == 7) {
		mes "哦哦！！";
		mes "你终于来了！";
		mes "我请 Ur 派人来这里帮我！";
		next;
		select("什么？我是来训练的……");
		mes "[约翰]";
		mes "不不，都是一样的！";
		mes "你的训练任务就是帮我清理修道院！";
		next;
		mes "[约翰]";
		mes "呼……太辛苦了。";
		mes "我无法独自进去，而且石像鬼会在外面攻击我……";
		mes "哈哈哈……";
		next;
		mes "[约翰]";
		mes "这座修道院是我们的责任。";
		mes "和其他修道院一样，这里也有地下墓地，不过……";
		next;
		mes "[约翰]";
		mes "你也知道，这座城堡……状态很不正常。";
		mes "我想这就是这些灵魂无法安息的原因。";
		next;
		mes "[约翰]";
		mes "先击败附近的怪物吧，毕竟只凭我们两人下到地下可能太勉强。";
		mes "我也会测试你的本领……";
		next;
		mes "[约翰]";
		mes "第一个目标是幽灵。";
		mes "它们可以通过奇怪的笑声辨认。";
		mes "它们看起来像恶魔，但无法确定……";
		next;
		mes "[约翰]";
		mes "击败 20 只幽灵。";
		mes "我会在这里协助你！";
		para_2nd01 = 8;
		erasequest 7219;// Advanced Training at Glast Heim
		setquest 7220;// Wraith Hunt
	}
	else if (para_2nd01 == 8) {
		if (checkquest(7220,HUNTING) == 2) {
			mes "哦~你挺强！";
			mes "很高兴有你这样强大的人来。";
			mes "我一个人待在这里肯定撑不了多久。";
			next;
			mes "[约翰]";
			mes "顺便问一下，除了幽灵，你还看到其他怪物了吗？";
			mes "它们是被腐化的牧师灵魂。";
			mes "它们也被称为“邪恶德鲁伊”。";
			next;
			mes "[约翰]";
			mes "这次处理这些邪恶德鲁伊。";
			mes "10 只。";
			mes "你能做到吧？";
			mes "我相信你！";
			para_2nd01 = 9;
			erasequest 7220;// Wraith Hunt
			setquest 7221;// Evil Druid hunt
			getexp 20000,20000;
		}
		else {
			mes "20 只幽灵！";
			mes "我会保护你的后背！";
			mes "……当然……我也会战斗！";
			npcskill "AL_HEAL",10,99,60;
			percentheal 0,100;
		}
	}
	else if (para_2nd01 == 9) {
		if (checkquest(7221,HUNTING) == 2) {
			mes "……哦，你回来了！";
			mes "（约翰打开门查看）";
			mes "……！";
			mes "好！！";
			next;
			mes "[约翰]";
			mes "谢谢你！我真的很感激！";
			mes "现在我应该可以放心进入了！";
			mes "希望那些邪恶灵魂没有破坏它……";
			next;
			mes "[约翰]";
			mes "嘿嘿，我会在 Ur 面前替你美言！";
			mes "你是勇敢又有本领的驱魔师！";
			next;
			mes "[约翰]";
			mes "你现在可以回伊甸园了。";
			mes "我会留下来收拾残局，嘿嘿。";
			para_2nd01 = 10;
			erasequest 7221;// Evil Druid hunt
			setquest 7222;// Report to Instructor Ur
			getexp 20000,20000;
		}
		else {
			mes "10 只邪恶德鲁伊！";
			mes "和上次一样，我会保护你的后背。";
			mes "……当然……我也会和它们战斗！";
			npcskill "AL_HEAL",10,99,60;
			percentheal 0,100;
		}
	}
	else if (para_2nd01 == 10) {
		mes "回去向 Ur 报告。";
		mes "克雷斯特汉姆修道院现在已经安全了。";
		mes "我得留下来找些东西……再见。";
	}
	else {
		mes "呃，我还是没找到丢失的东西。";
		mes "嗯……也许要等下一位训练生来，我才能继续寻找……啊！";
		next;
		mes "[约翰]";
		mes "呃……你没听见吧？";
		mes "哈哈哈哈哈哈！！！";
		mes "哈哈哈哈！！";
	}
	close;
}

//--80~89
// ein_fild08,172,359,3	script	Dispatched Instructor#2nd02	4_M_4THPRIN1,{
ein_fild08,172,359,3	script	Dispatched Instructor#04	4_M_4THPRIN1,{
	mes "[基伦]";
	if (para_2nd01 < 12) {
		mes "你在看什么？";
		mes "你想从我这里得到什么？";
		mes "管好你自己的事，走开……";
	}
	else if (para_2nd01 == 12) {
		mes "什么？";
		mes "....";
		mes "嗯，Ur 派你来的？";
		mes "哦，是那个训练任务。";
		next;
		mes "[基伦]";
		mes "你走了很远，我不会让你做太难的事，别担心。";
		mes "艾因布罗克外面的原野不算太糟。";
		next;
		mes "[基伦]";
		mes "这里的怪物通常不会来打扰我，所以我可以睡一整天。";
		mes "不过还是有一些会烦我。";
		next;
		mes "[基伦]";
		mes "你知道瓢虫吗？";
		mes "长得很丑的昆虫……还会偷东西……";
		next;
		mes "[基伦]";
		mes "先击败一些热热身吧。";
		mes "附近有很多只。30 只应该不难吧？";
		next;
		mes "[基伦]";
		mes "我才不是因为它们吃了我的午餐就怀恨在心。";
		mes "你完成前我会在这里休息。";
		para_2nd01 = 13;
		erasequest 7223;// Advanced Training in Einbroch
		setquest 7224;// Porcellio hunting
	}
	else if (para_2nd01 == 13) {
		if (checkquest(7224,HUNTING) == 2) {// Porcellio hunting
			mes "什么，你已经完成了？";
			mes "我正要睡着呢……算了……";
			mes "没办法。我们换个地方吧……";
			next;
			mes "[基伦]";
			mes "不，你在说什么？";
			mes "和你一起去……？";
			mes "你自己去不就好了吗？";
			next;
			mes "[基伦]";
			mes "好，下一个任务！";
			mes "艾因布罗克的人说北方的污染很严重。";
			mes "他们担心污染会飘进城里。";
			next;
			mes "[基伦]";
			mes "大概就是那边的工厂造成的……";
			mes "看来我还是应该调查一下。";
			mes "污染的源头……找到它并摧毁。";
			next;
			mes "[基伦]";
			mes "30 只毒魔菇和 5 只泰迪熊。";
			mes "这样应该就够了。";
			next;
			mes "[基伦]";
			mes "我不在旁边看，你也一定能做好。";
			mes "为了表示支持，我给你一些经验值和 HP 恢复。";
			next;
			mes "[基伦]";
			mes "怪物在艾因布罗克北部原野。";
			mes "那么，小心点。";
			mes "我要睡午觉了。";
			para_2nd01 = 14;
			erasequest 7224;// Porcellio hunting
			setquest 7226;// Venomous hunting
			setquest 7227;// Teddy Bear hunting
			getexp 30000,30000;
		}
		else {
			mes "那么，你已经教训过那些瓢虫了吗？";
			mes "我觉得你还没完成吧？";
			next;
			mes "[基伦]";
			mes "受伤的话我给你治疗一下。";
		}
		npcskill "AL_HEAL",10,99,60;
		percentheal 0,100;
	}
	else if (para_2nd01 == 14) {
		if (checkquest(7226,HUNTING) == 2 && checkquest(7227,HUNTING) == 2) {
			mes "Um...";
			mes "我快完成了。";
			mes "嗯……";
			mes "我还是累得做不完……";
			next;
			mes "[基伦]";
			mes "很好。那些怪物一直在骚扰艾因布罗克的工人。";
			mes "干得漂亮……";
			next;
			mes "[基伦]";
			mes "我有些事要向 Ur 教官报告。";
			mes "我一直在仔细观察你，你做得很好。回去把这份报告交给 Ur。";
			para_2nd01 = 15;
			erasequest 7226;// Venomous hunting
			erasequest 7227;// Teddy Bear hunting
			setquest 7228;// Report to Instructor Ur
			getexp 30000,30000;
			// erasequest 7225;
		}
		else {
			mes "怪物在艾因布罗克北部原野。";
			mes "找到毒魔菇……";
			mes "别想骗我说你已经完成狩猎了。";
			next;
			// if (isbegin_quest(7225) > 0)
				// erasequest 7225;
			// else {
			mes "[基伦]";
			mes "是的，这样可以吗？";
			mes "呃，这真难。";
			mes "不过我会让你舒服一点。";
			// }
			npcskill "AL_HEAL",10,99,60;
			percentheal 0,100;
		}
	}
	else if (para_2nd01 == 15) {
		mes "什么，认真的吗？";
		mes "你向 Ur 教官报告了吗？";
		mes "艾因布罗克又发布了委托工作，也就是说还有更多训练。";
	}
	else {
		mes "我不是小偷……";
		mes "生活很艰难。";
		mes "也没有什么真正的野心。";
		next;
		mes "[基伦]";
		mes "来，实习者？";
		mes "做点事情。";
		mes "真方便啊。";
		mes "嗯，我一会儿就睡着了……";
	}
	close;
}

//--90~99
// ice_dun01,154,13,5	script	Dispatched Instructor#2nd02	4_F_JOB_BLACKSMITH,{
ice_dun01,154,13,5	script	Dispatched Instructor#05	4_F_JOB_BLACKSMITH,{
	mes "[娜奥米]";
	if (para_2nd01 <= 17) {
		mes "不止如此~";
		mes "时间都去哪儿了~";
		mes "我还以为你说会派人来~！";
		next;
		mes "[娜奥米]";
		if (para_2nd01 < 17) {
			mes "怎么了？你要帮我，对吧？";
			mes "不，你不用这么做。";
			mes "我在等预定来帮我的人。";
			close;
		}
		mes "你是？";
		mes "哦，你是 Ur 派来的？";
		mes "我都不知道自己在雪里等了多久。";
		next;
		mes "[娜奥米]";
		mes "这里是北方平原的冰洞地下城。";
		mes "这是一个全年都很寒冷的洞窟。";
		next;
		mes "[娜奥米]";
		mes "拉赫尔的人就是来这里获取冰块的。";
		mes "不过，这里到处都是危险的怪物。";
		next;
		mes "[娜奥米]";
		mes "其中一种怪物叫希罗玛。";
		mes "它们应该能给你不错的挑战。";
		next;
		mes "[娜奥米]";
		mes "好，那就进洞窟找到那些希罗玛。";
		mes "里面很冷，但这项工作必须完成。";
		next;
		mes "[娜奥米]";
		mes "哦，对了。";
		mes "进去后小心。";
		mes "祝你好运~！";
		para_2nd01 = 18;
		erasequest 7229;// Advanced Training in Ice Dungeon
		setquest 7230;// Siroma hunting
	}
	else if (para_2nd01 == 18) {
		if (checkquest(7230,HUNTING) == 2) {
			mes "啊……结束了……";
			mes "很好！";
			mes "你的能力已经得到验证。";
			next;
			mes "[娜奥米]";
			mes "接下来该做什么呢？";
			mes "那些希罗玛似乎繁殖得更快了。";
			mes "和之前一样，再去猎杀 30 只希罗玛，并带一些材料给我。";
			next;
			mes "[娜奥米]";
			mes "还有这些……嗯……";
			mes "请仔细听。";
			mes "30 个冰块";
			mes "1 个甜酱";
			mes "1 瓶牛奶";
			next;
			mes "[娜奥米]";
			mes "我不是只为自己做这些，你知道的。";
			mes "我是为了大家。";
			next;
			mes "[娜奥米]";
			mes "总之这就是最后一批了。";
			mes "去猎杀那些希罗玛并取得材料。";
			mes "我们说清楚了吗？";
			next;
			select("那你呢？");
			mes "[娜奥米]";
			mes "我？当然……我要在这里站岗。";
			mes "我……我可是很忙的！";
			mes "而且这是训练，你凭什么问我做什么？";
			next;
			mes "[娜奥米]";
			mes "快去！";
			mes "那些希罗玛每分钟都会变得更加狂暴。";
			para_2nd01 = 19;
			erasequest 7230;// Siroma hunting
			setquest 7231;// Hunting and Gathering
			getexp 40000,40000;
			npcskill "AL_HEAL",10,99,60;
			percentheal 0,100;
		}
		else {
			mes "最大的难题就是对付希罗玛。";
			mes "你已经猎杀 30 只了吗？";
			next;
			mes "[娜奥米]";
			mes "哦，你想让我帮你恢复 HP/SP？";
			mes "我什么也不会给你~！";
			mes "如果我帮你，那还算什么挑战？";
		}
	}
	else if (para_2nd01 == 19) {
		if (checkquest(7231,HUNTING) == 2 && countitem(7066) > 29 && countitem(7453) > 0 && countitem(519) > 0) {// Ice_Piece, Sweet_Sauce, Milk
			mes "哦！";
			mes "你把所有东西都带来了。";
			mes "好，那么只剩最后一件事了……！";
			next;
			select("……看看");
			mes "[娜奥米]";
			mes "是，是？为什么不呢？";
			mes "...";
			mes "哦，对了！我应该给你一些东西。";
			mes "你已经做得够多了，我知道。";
			next;
			mes "[娜奥米]";
			mes "我会通知 Ur 教官。";
			mes "还剩几个阶段，不用担心！";
			next;
			mes "[娜奥米]";
			mes "哦，还有恭喜你！";
			mes "这是准备好的最后训练阶段！";
			next;
			mes "[娜奥米]";
			mes "看来我也该自己做一点了~";
			mes "呜哈哈~";
			delitem 7066,30;
			delitem 7453,1;
			delitem 519,1;
			para_2nd01 = 20;
			erasequest 7231;// Hunting and Gathering
			setquest 7232;// Report to Instructor Ur
			getexp 40000,40000;
		}
		else {
			mes "你已经完成猎杀 30 只希罗玛了吗？";
			mes "你已经做过一次了，所以这应该不难……";
			next;
			mes "[娜奥米]";
			mes "别忘了 30 个冰块、1 个甜酱和 1 瓶牛奶。";
		}
	}
	else if (para_2nd01 == 20) {
		mes "你已经去过那里了吗？";
		mes "你上次来之后，其他人来了又走。";
		mes "现在我不用自己去拿材料了。";
		next;
		mes "[娜奥米]";
		mes "回去向 Ur 教官报告任务完成。";
		mes "别拖延。";
	}
	else
		mes "唉，还有哪里会比这里积聚更多冰帽呢？";
	close;
}

// mid_camp,212,229,3	script	Dispatched Instructor#2nd02	4_F_HUWOMAN,{
mid_camp,212,229,3	script	Dispatched Instructor#06	4_F_HUWOMAN,{
	mes "[玛格丽特]";
	if (para_2nd01 < 22) {
		mes "哦，抱歉。";
		mes "我不太了解冒险者的生活。";
		mes "我只是伊甸园集团的一员……";
	}
	else if (para_2nd01 == 22) {
		mes "你手里的证明。";
		mes "你来到了天堂。";
		mes "是 Ur 教官派你来的吗？";
		next;

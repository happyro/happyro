//===== rAthena Script ======================================= 
//= RWC 2011 Golden Poring
//===== By: ================================================== 
//= Euphy
//===== Current Version: ===================================== 
//= 1.0
//===== Compatible With: ===================================== 
//= rAthena Project
//===== Description: ========================================= 
//= [Official Conversion]
//= Collect blue cards dropped by Golden Porings to spell out
//= 'RWC2011' and win a prize!
//===== Additional Comments: ================================= 
//= 1.0 First Version. [Euphy]
//============================================================ 

prontera,114,81,5	script	RWC2011 Agent#2	407,{
	if (checkweight(1201,1) == 0 || MaxWeight - Weight < 500) {
		mes "[New Agent]";
		mes "你的物品太多了。请清理背包后再回来。";
		close;
	}
	if (oversea_event == 0) {
		mes "[New Agent]";
		mes "哇～终于到了！！这是大家一直期待的季节！";
		emotion ET_BIGTHROB;
		next;
		mes "[New Agent]";
		mes "RWC 时间到了！";
		next;
		set .@loop,1;
		while(.@loop) {
			switch(select("RWC 是什么？:你是新特工吗？:我不在乎。")) {
			case 1:
				mes "[New Agent]";
				if (BaseLevel < 70)
					mes "你一定是新冒险者。我来给你解释。";
				else
					mes "看来你旅行了不少，但不太关注世界各地的消息。";
				next;
				mes "[New Agent]";
				mes "米德加尔特有少数冒险者一生致力于战斗，从不懈怠训练，隐居生活，并精通自己的技艺。";
				next;
				mes "[New Agent]";
				mes "RWC 是让这些冒险者互相竞争、决出最强者的节日！";
				next;
				mes "[New Agent]";
				mes "但这不能独自完成。你的朋友将在比赛中发挥重要作用。";
				next;
				mes "[New Agent]";
				mes "如果你对节日感兴趣，就开始寻找值得信赖的朋友吧！";
				next;
				break;
			case 2:
				mes "[New Agent]";
				mes "每年都会举办许多活动来宣传 RWC。";
				next;
				mes "[New Agent]";
				mes "今年，一项特殊任务交给了一名新特工……就是我！";
				next;
				mes "[New Agent]";
				mes "我的任务是把写有 RWC2011 的蓝卡贴到世界各地，宣传活动。但……但是……";
				next;
			mes "-他想到了什么，然后看着你的眼睛。-";
				next;
				mes "[New Agent]";
				mes "你愿意听听我的故事吗？";
				next;
				if(select("好，说来听听。:不用了，谢谢。") == 2) {
					mes "[New Agent]";
					mes "啊！！你因为我是新人就无视我吗？通常大家都会听的……";
					next;
			mes "-新特工用可怜的眼神看着你。-";
					next;
			mes "-他闪亮的小眼睛似乎在告诉你什么。^FF0000请再和我谈谈……^000000-";
					close;
				}
				set .@loop,0;
				break;
			case 3:
				mes "[New Agent]";
				mes "这是我的第一次任务，但人们的反应很糟。";
				next;
		mes "-新特工用可怜的眼神看着你。-";
				next;
		mes "-他闪烁的小眼睛似乎在告诉你什么。^FF0000请再和我谈谈……^000000-";
				close;
			}
		}
		mes "[New Agent]";
		mes "我以前是梦罗克一个非常普通的男孩。";
		mes "我不是冒险者，甚至不知道如何买卖东西。有时看到冒险者就很开心。你知道……我只是个普通男孩。";
		next;
		mes "[New Agent]";
		mes "人们以前说我很害羞。";
		mes "我可能会在郊区度过一生。";
		next;
		mes "[New Agent]";
		mes "但最终，我的耐心和克制性格促使我成为 RWC2011 特工！";
		mes "我高兴得睡不着！终于有机会见到许多冒险者并了解他们。";
		next;
		mes "[New Agent]";
		mes "这项任务对我非常重要，";
		mes "我害怕在街上张贴 RWC2011 蓝卡时遭到魔物袭击。";
		next;
		mes "[New Agent]";
		mes "......";
		next;
		mes "[New Agent]";
		mes "你知道吗？";
		mes "^FF0000真的发生了！^000000";
		next;
		select("你是认真的吗！？");
		mes "[New Agent]";
		mes "我关了灯准备睡觉，突然透过窗户看到一道亮光。";
		mes "窗户突然碎裂，它出现了！";
		next;
		select("它？");
		mes "[New Agent]";
		mes "是一只闪耀波利！不到一秒就吃掉了我准备的所有蓝卡！";
		next;
		mes "[New Agent]";
		mes "我震惊极了，试图冷静思考……我从未听说或见过闪耀波利！";
		next;
		mes "[New Agent]";
		mes "^FF0000没错！这一定是梦！^000000我得出这个结论后就回去睡觉了。";
		next;
		mes "[New Agent]";
		mes "但那不是梦。醒来后，我发现蓝卡全都不见了……";
		next;
		mes "[New Agent]";
		mes "如果我搞砸宣传，可能会丢掉工作，只能回到过去独居的地方……";
		next;
		mes "[New Agent]";
		mes "如果你看到黄金波利，能帮我找回珍贵的蓝卡吗？";
		next;
		emotion ET_CRY;
		mes "-他用恳求的眼神看着你。-";
		next;
		if(select("好，我帮你！:你能给我多少钱？") == 2) {
			mes "[New Agent]";
			mes "你决定帮助我了吗？我会准备一些礼物，相信你会喜欢。";
			next;
		}
		mes "[New Agent]";
		mes "你要找的是写有 ^FF0000RWC2011^000000 的大卡片。其中一些可能已经被消化了。";
		next;
		mes "[New Agent]";
		mes "收集剩余卡片，拼出‘RWC2011’这个词。";
		next;
		mes "[New Agent]";
		mes "请帮帮我！！我的人生掌握在你手中！";
		set oversea_event,1;
		setquest 13000;
		close;
	} else if (oversea_event == 1) {
		if (countitem(6485) && countitem(6486) && countitem(6487) > 1 && countitem(7602) && countitem(7470) && countitem(6012)) {
			mes "[RWC2011 Agent]";
			mes "你收集齐所有卡片了吗？";
			next;
			mes "[RWC2011 Agent]";
			mes "哇～你再次为我的生活带来光明！";
			next;
			mes "[RWC2011 Agent]";
			mes "这是我承诺的礼物……让我看看……";
			next;
			delitem 6485,1; //BlueCard_2
			delitem 6486,1; //BlueCard_0
			delitem 6487,2; //BlueCard_1
			delitem 7602,1; //BlueCard_R
			delitem 7470,1; //BlueCard_W
			delitem 6012,1; //Blue_Card_C
			//SavePPL BlueCard_2
			set oversea_event,2;
			erasequest 13000;
			setquest 13001;
			set .@i, rand(1,100);
	 		     if (.@i == 1) getitem 12690,1; //Old_C_Album_Helm
	 		else if (.@i == 2) getitem 12691,1; //Old_C_Album_Armor
	 		else if (.@i == 3) getitem 12693,1; //Old_C_Album_Garment
	 		else if (.@i == 4) getitem 12694,1; //Old_C_Album_Shoes
	 		else if (.@i == 5) getitem 12698,1; //Old_C_Album_Weapon
	 		else if (.@i == 6) getitem 12695,1; //Old_C_Album_Acc
	 		else if (.@i == 7) getitem 12692,1; //Old_C_Album_Shield
	 		else if (.@i < 28) getitem 547,10; //White_Slim_Potion
	 		else if (.@i < 38) getitem 607,1; //Yggdrasilberry
	 		else if (.@i < 51) getitem 608,1; //Seed_Of_Yggdrasil
	 		else {
				getitem 12696,5; //RWC_Cele_Fire
				getitem 12697,5; //RWC_Cele_Fire2
	 		}
	 		mes "[RWC2011 Agent]";
	 		mes "虽然不多，但请收下！哈哈，我们还有很多卡片要找。希望你明天也能帮我。";
	 		next;
	 		mes "[RWC2011 Agent]";
	 		mes "谢谢！！我现在可以继续工作了。有你这样的伟大冒险者，一切皆有可能！";
	 		next;
	 		mes "[RWC2011 Agent]";
	 		mes "再见！";
	 		next;
	 		mes "- Agent muttered something to himself. -";
	 		close;
		} else {
			mes "[RWC2011 Agent]";
			mes "嗯～还没有吗？我们人手不足……请帮帮我。";
			next;
			mes "[RWC2011 Agent]";
			mes "我是出于关心才这么说。你需要两张 ^FF0000蓝色 1 卡^000000。是‘2011’……明白了吗？";
			close;
		}
	} else if (oversea_event == 2) {
		set .@playtime, checkquest(13001,PLAYTIME);
		if (.@playtime == 0 || .@playtime == 1) {
			mes "[RWC2011 Agent]";
			mes "我先开始张贴你找到的卡片……剩下的卡片明天再收。";
			mes "请明天再回来。";
			close;
		} else if (.@playtime == 2)
			erasequest 13001;
		mes "[RWC2011 Agent]";
		mes "谢谢你上次的帮助。";
		mes "我必须继续宣传活动，所以想再次请你帮忙～！";
		set oversea_event,3;
		close;
	} else if (oversea_event == 3) {
		mes "[RWC2011 Agent]";
		mes "你又来了～";
		mes "谢谢上次的帮助！我们还有很多卡片要找。能帮帮我吗？";
		next;
		switch(select("好！:我现在很忙。")) {
		case 1:
			mes "[RWC2011 Agent]";
			mes "任务和之前一样。";
			mes "试着收集蓝卡，拼出 ^FF0000R W C 2 0 1 1 ^000000。";
			mes "祝你好运！";
			set oversea_event,1;
			setquest 13000;
			close;
		case 2:
			mes "[RWC2011 Agent]";
			mes "……我明白了……";
			mes "我还有很多卡片要找，有时间的话请再回来帮忙。";
			close;
		}
	} else {
		mes "[RWC2011 Agent]";
		mes "... huh...?";
		mes "我……是一名新特工。";
		close;
	}
}


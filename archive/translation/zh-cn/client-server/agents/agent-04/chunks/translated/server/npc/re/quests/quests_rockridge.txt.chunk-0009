// Pipe Cleaning
harboro1,138,157,5	script	Donovan	4_M_EINMAN2,{
	mes "[多诺万]";
	mes "你好。";
	next;
	mes "[多诺万]";
	if (rock_main_quest < 22) {
	mes "你是从大陆来的冒险者，对吧？";
	mes "我叫多诺万，";
	mes "是下水道系统管理员。";
		next;
	mes "[多诺万]";
	mes "现在有太多问题，";
	mes "比如野牛盗贼和矿山。";
	mes "所以没人关心自己的下水道系统。";
	mes "野牛盗贼";
	mes "必须先处理。";
		close;
	}
	switch( checkquest(9459,PLAYTIME) ) {
	case -1:
		break;
	case 0:
	case 1:
	mes "管道现在";
	mes "没有海葵。";
	mes "你为什么不";
	mes "晚点再回来？";
		close;
	case 2:
	mes "啊，欢迎回来！";
	mes "我想";
	mes "又到了";
	mes "清除海葵的时候。";
		next;
		if (select( "I can do that.", "Sorry, I'm busy." ) == 2) {
		mes "[多诺万]";
		mes "哦，我明白了。";
		mes "我理解。";
		mes "改变主意后再回来。";
			close;
		}
	mes "[多诺万]";
	mes "你知道怎么进地下室，对吧？";
	mes "谢谢你的帮助。";
		erasequest 9459;// Too Early for Pipe Cleaning
		setquest 9458;// Pipe Cleaning
		close;
	}
	switch( checkquest(9458,HUNTING) ) {
	case -1:
	mes "哦，原来你就是";
	mes "解决野牛盗贼的冒险者！";
	mes "很高兴见到你！";
		next;
	mes "[多诺万]";
	mes "看来你足够强，";
	mes "能处理那些盗贼。";
	mes "能否帮我";
	mes "做一件事？";
		next;
		mes "[" + strcharinfo(0) + "]";
	mes "- 好吧，我能为你做什么？";
		next;
	mes "[多诺万]";
	mes "哦，我忘了自我介绍。";
	mes "我叫多诺万，";
	mes "是下水道系统管理员。";
	mes "我管理地下水泵";
	mes "和污水系统。";
		next;
	mes "[多诺万]";
	mes "地下水不断从";
	mes "村庄地下室涌出，";
	mes "必须抽到海里";
	mes "以防止洪水。";
		next;
	mes "[多诺万]";
	mes "我的工作是确保";
	mes "水泵和污水系统";
	mes "始终";
	mes "正常运转，";
		next;
	mes "[多诺万]";
	mes "这不是一个人能完成的工作。";
	mes "要做的事情太多，";
	mes "我需要帮助。";
	mes "工作本身并不复杂。";
	mes "你能帮我吗？";
		next;
		if (select( "Sure.", "Sorry, I'm busy." ) == 2) {
			mes "[多诺万]";
			mes "哦，我明白了。";
			mes "我理解。";
			mes "改变主意后再回来。";
			close;
		}
		mes "[多诺万]";
		mes "哇，谢谢你！";
		mes "你只需要下到地下室，";
		mes "清除";
		mes "管道和水泵上的海葵。";
		next;
		mes "[多诺万]";
		mes "你可以和这里稍东边的";
		mes "乔交谈，";
		mes "他会让你";
		mes "下到地下室。";
		next;
		mes "[多诺万]";
		mes "我们叫他安静乔。";
		mes "谢谢你的帮助。";
		setquest 9458;// Pipe Cleaning
		close;
	case 0:
	case 1:
	mes "向东走，";
	mes "你会看到乔。";
	mes "告诉他是我派你来的，";
	mes "他就会让你";
	mes "下到地下室。";
		close;
	case 2:
	mes "啊，冒险者，欢迎回来。";
	mes "清除海葵感觉如何？";
	mes "应该不太难吧？";
		next;
		mes "[" + strcharinfo(0) + "]";
	mes "- 不难。-";
	mes "- 不过很无聊。-";
		next;
	mes "[多诺万]";
	mes "哈哈，这工作确实无聊。";
	mes "但对那些海葵来说一定不无聊，";
	mes "因为它们每天都会出现，";
	mes "无论我多努力";
	mes "控制它们。";
		next;
	mes "[多诺万]";
	mes "清除它们";
	mes "占用了我很多时间。";
	mes "谢谢你的帮助。";
	mes "清除海葵总是需要帮助。";
	mes "请再来。";
		erasequest 9458;// Pipe Cleaning
		setquest 9459;// Too Early for Pipe Cleaning
		getexp 25000,20000;
		getitem 25250,1;// Coin_Of_Rr
		close;
	}
}

// Midnight quest
harboro2,167,82,3	script	Midnight#srdg01	4_M_COWRAIDERS2,{
	if (rock_main_quest < 22) {
	mes "[午夜]";
	mes "你在看什么？在我把你脸打穿前滚开！走！";
		close;
	}
	if (isbegin_quest(14672) == 1 || isbegin_quest(14673) == 1) {// Demon quest started
	mes "[午夜]";
	mes "我该走了。他只是固执。";
		next;
	mes "[午夜]";
	mes "说实话，我不明白他为什么想做这件事，但我不想阻止他。";
		next;
	mes "[午夜]";
	mes "谢谢你帮助我们。";
		close;
	}
	mes "[午夜]";
	mes "...";
	next;
	mes "[午夜]";
	mes "恶魔，有个奇怪的小孩一直在我们附近。你认识他吗？";
	next;
	mes "[恶魔]";
	mes "谁？在哪里？我没看到。把他送到我这里。";
	close;
}

harboro2,164,80,5	script	Demon#srdg01	4_M_NFMAN,{
	if (checkweight(1304,3) == 0) {
		mes "[恶魔]";
		mes "你带的东西太多了，我担心你会弄伤肩膀。先去减轻负重吧？";
		close;
	}
	if (BaseLevel < 130) {
		mes "[恶魔]";
		mes "你还乳臭未干。这里对你太危险了，晚点再来，好吗？";
		close;
	}
	if (rock_main_quest < 22) {
		mes "[恶魔]";
		mes "你根本不知道这里多危险，对吧？趁还能走，赶快离开。";
		close;
	}
	switch( checkquest(14673,PLAYTIME) ) {
	case -1:
		break;
	case 0:
	case 1:
		mes "[恶魔]";
		mes "你回来得真快。唉，我怀念年轻的时候。";
		next;
		mes "[恶魔]";
		mes "不过你看，你昨天带来的材料还剩一些。我用不完这些。";
		next;
		mes "[恶魔]";
		mes "你为什么不回家，明早再来？";
		close;
	case 2:
		mes "[恶魔]";
		mes "嘿，小家伙！很高兴再次见到你。我用你带来的材料制作的炸弹正在陈化。你知道酒和炸弹越陈越好吗？";
		sleep2 1000;
		npctalk "你说旧炸弹就是坏炸弹。", "Midnight#srdg01", bc_self;
		sleep2 1000;
		 npctalk "那只是比喻。", "", bc_self;
		next;
		mes "[恶魔]";
		mes "今天能再带些材料吗？我们离所需的炸弹还差很多。";
		next;
		mes "[恶魔]";
		mes "和往常一样，取得^0000cd10 个致命毒药粉末和 1 个爆炸粉末^000000，并^0000cd猎杀 15 只毒气虫^000000。明白吗？";
		next;
		emotion ET_THROB;
		mes "[恶魔]";
		mes "小家伙，我们就靠你了！";
		erasequest 14673;// Time to Make Bombs
		setquest 14672;// Preparing for the Firework Festival
		close;
	}
	switch( checkquest(14672,HUNTING) ) {
	case -1:
		.@account_id = getcharid(3);
		.@player_name$ = strcharinfo(0);

		setpcblock PCBLOCK_NPC, true;
		donpcevent "Traces of Fire#srdg01::OnEffect";
		sleep2 1500;
		setpcblock PCBLOCK_NPC, false;
		mes "[恶魔]";
		mes "好了，这些应该够了。你知道我需要什么，对吧？你确定能潜入吗？也许我该去。";
		next;
		emotion ET_ANGER, getnpcid(0, "Midnight#srdg01");
		mes "[午夜]";
		// translation chunk padding
		// translation chunk padding 2
		mes "趁大家睡觉时我去。";
		next;
		mes "[恶魔]";
		mes "但声音可能会吵醒他们。而且还有警卫。";
		next;
		mes "[午夜]";
		mes "我没问题。我们长得都一样，他们不会知道我不是他们的人。";
		emotion ET_HUK;
		npctalk "什么？我以为你们能分辨彼此。", "", bc_self;
		select("先生，你在这里做什么？");
		mes "[午夜]";
		mes "*瞥一眼*";
		next;
		mes "[" + .@player_name$ + "]";
		mes "你为什么在荒郊野外玩火？很可疑。";
		next;
		mes "[午夜]";
		mes "...";
		next;
		mes "[恶魔]";
		mes "嘿，小孩在问你问题。他看起来太好奇了，不告诉他我担心他会死。";
		next;
		mes "[午夜]";
		mes "...";
		next;
		emotion ET_HNG;
		mes "[恶魔]";
		mes "像他这样的孩子充满好奇。最好在他哭之前告诉他。";
		npctalk "啧，啧。你又高大又害羞。真可爱！", "", bc_self;
		next;
		mes "[午夜]";
		mes "告诉他。";
		next;
		emotion ET_HNG;
		mes "[恶魔]";
		mes "不。为什么？他问的是你。而且孩子通常让我胃灼热。";
		next;
		emotion ET_BIGTHROB;
		mes "[恶魔]";
		mes "我今天早餐吃了最喜欢的豆类菜肴。我不能失去它，我想让它成为我的一部分。";
		next;
		mes "[午夜]";
		mes "总有一部分要从你体内出来。可怜的豆子，被你这种混蛋吃掉一定很生气。";
		emotion ET_HNG;
		npctalk "嘿，这可不好。我救你不是为了让你叫我混蛋。", "", bc_self;
		sleep2 1500;
		npctalk "对不起。对不起。现在满意了吗？", "Midnight#srdg01", bc_self;
		sleep2 1500;
		npctalk "你最好友善一点。我是个敏感的人。", "", bc_self;
		sleep2 1500;
		npctalk "Be nicer, got it.", "Midnight#srdg01", bc_self;
		next;
		emotion ET_SURPRISE;
		mes "[恶魔]";
		mes "哦，对了！为什么不问问这个孩子？";
		next;
		mes "[午夜]";
		mes "什么？但我们不能信任他吧？我们才刚认识他！";
		next;
		emotion ET_OK;
		mes "[恶魔]";
		mes "当然可以。人本来就应该互相信任。你不知道吗？既然他到了这里，他就是我们的一员。而且我说过，每个人生来都是善良的。";
		npctalk "Yeah, right.", "Midnight#srdg01", bc_self;
		next;
		mes "[恶魔]";
		mes "而且，他看起来不是很习惯艰苦环境吗？他有跑者的身体和不会错过任何东西的敏锐双眼。我喜欢这样的孩子。";
		sleep2 1000;
		npctalk "他让我想起五岁的自己。我觉得可以信任他。", "", bc_self;
		next;
		mes "[恶魔]";
		mes "嘿，小家伙。想加入我们的生意吗？";
		next;
		if (select( "What business?", "No, thanks." ) == 2) {
			mes "[" + .@player_name$ + "]";
			mes "你看起来很危险。我不想做危险的事。";
			next;
			mes "[恶魔]";
			mes "不想？好吧，我不强迫你。保重。这里很危险，你最好离开。";
			next;
			mes "[午夜]";
			mes "你确定可以放他走？他已经看见我们了。";
			next;
			mes "[恶魔]";
			mes "你怎么这么多疑？没关系，小家伙。走吧。改变主意后再回来！";
			close;
		}
		mes "[" + .@player_name$ + "]";
		mes "什么生意？";
		next;
		mes "[恶魔]";
		mes "我们有个绝妙的计划。";
		npctalk "虽然不算完美，但至少是个计划。", "Midnight#srdg01", bc_self;
		sleep2 1000;
		npctalk "你为什么要这样对我？", "", bc_self;
		next;
		emotion ET_STARE;
		mes "[恶魔]";
		mes "除非你打算自己解释，否则闭嘴让我来！";
		next;
		mes "[午夜]";
		mes "...";
		next;
		mes "[恶魔]";
		mes "这才像话。总之，我们要抢^0000cd矿山^000000。";
		next;
		select("抢矿山？");
		mes "[午夜]";
		mes "你没必要告诉他。你可以只让他帮我们拿东西。";
		next;
		mes "[恶魔]";
		mes "不能不解释就让他为我们做事。他有权知道自己要卷入什么。";
		npctalk "真不敢相信你这么无情。", "", bc_self;
		next;
		mes "[午夜]";
		mes "你想利用一个陌生人。";
		next;
		mes "[恶魔]";
		mes "不。我是在邀请你加入我们的伟大计划。你知道这里东边的矿山吗？以前属于黄金月亮。";
		sleep2 1000;
		npctalk "你要回到那么远的地方？那要花一整晚。", "Midnight#srdg01", bc_self;
		next;
		mes "[恶魔]";
		mes "总之，野牛盗贼发现矿山很赚钱，就在那里定居了。";
		next;
		mes "[" + .@player_name$ + "]";
		mes "我听说过。";
		next;
		mes "[恶魔]";
		mes "是吗？从哪里听说的？";
		next;
		mes "[" + .@player_name$ + "]";
		mes "在警长办公室。";
		next;
		emotion ET_BIGTHROB;
		mes "[恶魔]";
		mes "嘿，你刚被释放吗？我们也是！事实上，我们在那里见过。我最好的朋友大多是在系统里认识的。";
		next;
		mes "[午夜]";

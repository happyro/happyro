// Oridecon Stone OR Mineral Stone Quest :: ein_amano
//============================================================ 
einbech,97,167,5	script	Cavitar	847,{
	if (ein_gear1 == 2) {
	mes "";
	mes "";
	mes "";
	mes "";
		mes "";
		mes "";
		mes "";
		mes "";
		mes "";
		mes "";
		mes "";
		mes "";
		mes "";
		mes "";
		mes "";
		mes "";
		mes "";
		mes "";
		mes "";
		mes "";
		mes "";
		mes "";
		mes "好久不见，";
		mes "朋友。多亏你的帮助，";
		mes "我的妻子";
		mes "好多了。";
		next;
		mes "";
		mes "";
		mes "";
		mes "";
		mes "";
		mes "";
		mes "";
		mes "";
		mes "";
		mes "";
		mes "再次感谢你";
		mes "为我所做的一切。";
		mes "来城镇时";
		mes "随时来";
		mes "拜访。";
		close;
	}
	else if (ein_gear1 == 1) {
		mes "";
		mes "";
		mes "";
		mes "";
		mes "";
		mes "哦，欢迎。";
		mes "你带来了";
		mes "我要求的";
		mes "所有东西吗？";
		next;
		switch(select("是的:不，还没有")) {
		case 1:
			if ((countitem(1011) > 9) && (countitem(1003) > 2) && (countitem(912) > 9) && (countitem(7126) > 39)) {
				mes "[卡维塔]";
				mes "给你神之金属前，";
				mes "让我检查";
				mes "你带来的物品。";
				next;
				if ((MaxWeight - Weight) > 2399) {
					mes "[卡维塔]";
					mes "很好，你带齐了！";
					mes "现在给你";
					mes "这块神之金属。";
					mes "抱歉我无法给你";
					mes "更多。";
					next;
					mes "[卡维塔]";
					mes "好吧，";
					mes "冒险者。希望";
					mes "你旅途平安。";
					delitem 1003,3;  //Coal
					delitem 7126,40;  //Large_Jellopy
					delitem 1011,10;  //Emveretarcon
					delitem 912,10;  //Zargon
					set ein_gear1,0;
					getitem 615,1; // Oridecon
					close;
				}
				else {
					mes "[卡维塔]";
					mes "嗯，看来你";
					mes "携带太多东西。";
					mes "是不是应该先把一些物品";
					mes "存入";
					mes "卡普拉仓库？";
					close;
				}
			}
			else {
				mes "[卡维塔]";
				mes "Hm...?";
				mes "你缺少一些";
				mes "东西。让我再次告诉你";
				mes "需要带来什么，";
				mes "我才能给你";
				mes "1 个神之金属。";
				next;
				mes "[卡维塔]";
				mes "40 个大杰勒比、";
				mes "10 个神之金属锻造石、";
				mes "3 个煤炭和";
				mes "10 个赛尔。";
				mes "请不要";
				mes "忘记。";
				close;
			}
		case 2:
			mes "[卡维塔]";
			mes "哦，好吧。";
			mes "让我提醒你";
			mes "兑换 1 个神之金属";
			mes "需要";
			mes "的物品，";
			mes "以防你忘记。";
			next;
			mes "[卡维塔]";
			mes "40 个大杰勒比、";
			mes "10 个神之金属锻造石、";
			mes "3 个煤炭和";
			mes "10 个赛尔。";
			mes "准备好后";
			mes "再回来。";
			close;
		}
	}
	else {
		if (BaseLevel < 40){
			mes "[卡维塔]";
			mes "最近隧道发生塌方，";
			mes "导致矿工伤亡。";
			mes "现在人手更不足，";
			mes "矿井作业";
			mes "更加困难。";
			mes "";
			next;
			mes "[卡维塔]";
			mes "真正可疑的是，";
			mes "似乎有什么东西";
			mes "故意让隧道";
			mes "塌陷。有人认为";
			mes "这是因为我们激怒了";
			mes "洞穴之主。";
			next;
			mes "[卡维塔]";
			mes "矿井事故仍历历在目。";
			mes "隧道开始莫名塌陷时，";
			mes "似乎出现了更多^FF0000洞穴之王^000000的踪迹。";
			next;
			mes "[卡维塔]";
			mes "事故发生时我正好休班。";
			mes "不过听说唯一的幸存者疯了，";
			mes "不知消失到哪里。真可怜……";
			close;
		}
		else {
			if (Zeny < 1000){
				mes "[卡维塔]";
				mes "你……";
				mes "你和我一样";
				mes "处境糟糕！";
				mes "我很同情你，";
				mes "如果有多余的 Zeny 就给你……";
				close;
			}
			else {
				mes "[卡维塔]";
				mes "嗯……？";
				mes "抱歉，";
				mes "我现在没心情聊天。";
				next;
				mes "[卡维塔]";
				mes "矿井塌陷时，妻子和我一起工作并受了重伤。";
				mes "不知道她能否平安，真让人痛苦。";
				next;
				mes "[卡维塔]";
				mes "幸运的是没人死亡，但我的妻子……^333333*呜、呜咽*^000000";
				mes "抱歉，我现在需要一个人静静……";
				next;
				switch(select("我能帮你。:好吧……:事故？")) {
				case 1:
					mes "[卡维塔]";
					mes "真的吗？！";
					mes "谢谢，谢谢你！";
					mes "如、如你所见，我经济状况很差，";
					mes "但必须送妻子去医院。";
					next;
					mes "[卡维塔]";
					mes "而且要亲自照顾她，";
					mes "我无法工作。";
					mes "我不知道该怎么办。";
					next;
					select("那我怎么帮你？");
					mes "[卡维塔]";
					mes "坦白说，我急需 Zeny。";
					mes "一天的医疗费和食物就要 1,000 Zeny。";
					next;
					switch(select("Help Him.:Quit.")) {
					case 1:
						if (checkweight(908,10) == 0) {
							mes "[卡维塔]";
							mes "嗯，看来你";
							mes "携带太多东西。";
							mes "是不是应该先把一些物品";
							mes "存入";
							mes "卡普拉仓库？";
							close;
						}
						else {
							mes "[卡维塔]";
							mes "哦……！";
							mes "谢谢你，你无法想象我有多感激！";
							mes "我从没想过会遇到像你这么善良的人。";
							next;
							if ($ein_amano == 60) {
								if (rand(1,3) == 1) {
									mes "[卡维塔]";
									mes "其他冒险者也在帮助我，";
									mes "多亏你们，我的妻子正在好转。";
									next;
									mes "[卡维塔]";
									mes "我想送你一份小礼物表达感谢。";
									mes "请收下。";
									set Zeny,Zeny-1000;
									set ein_gear1,2;
									switch(rand(1,7)) {
									case 1:
										getitem 7290,1; // Phlogopite
										break;
									case 2:
										getitem 7291,1; // Agate
										break;
									case 3:
										getitem 7293,1; // Rose_Quartz
										break;
									case 4:
										getitem 7294,1; // Turquoise
										break;
									case 5:
										getitem 7295,1; // Citrine
										break;
									case 6:
										getitem 7296,1; // Pyroxene
										break;
									case 7:
										getitem 7289,1; // Olivine
									}
									next;
									mes "[卡维塔]";
									mes "我一直保存这些金属，";
									mes "因为相信它们对别人比对我更有用。";
									mes "希望这块矿石能帮到你。";
									close;
								}
								else {
									mes "[卡维塔]";
									mes "如果我还在工作，";
									mes "一定会尽力报答你。";
									mes "但目前的状况不允许……";
									next;
									mes "[卡维塔]";
									mes "不过，如果你能带来一些物品，";
									mes "我很乐意换给你 1 个奥里德根。";
									mes "怎么样？";
									next;
									mes "[卡维塔]";
									mes "能带给我";
									mes "40 个大杰勒比、";
									mes "10 个神之金属锻造石、";
									mes "3 个煤炭和";
									mes "10 个赛依伐吗？";
									next;
									switch(select("当然～！:不用了，谢谢。")) {
									case 1:
										set Zeny,Zeny-1000;
										set ein_gear1,1;
										mes "[卡维塔]";
										mes "太好了……！";
										mes "现在我要去照顾妻子。";
										mes "收集齐我要求的所有物品后，";
										mes "再回来找我。";
										close;
									case 2:
										mes "[卡维塔]";
										mes "我明白了。";
										mes "我理解冒险者们";
										mes "不会在一个地方";
										mes "停留太久。再次感谢";
										mes "你的帮助。";
										mes "谢谢你。";
										next;
										mes "[卡维塔]";
										mes "不过请收下";
										mes "这份小礼物，";
										mes "聊表";
										mes "我的谢意。";
										set Zeny,Zeny-1000;
										getitem 1010,1; // Phracon
										close;
									}
								}
							}
							else {
								mes "[卡维塔]";
								mes "如果我还在工作，";
								mes "我一定会尽力";
								mes "报答你的帮助。";
								mes "但我目前的状况";
								mes "实在做不到……";
								next;
								mes "[卡维塔]";
								mes "不过，只要你能带来";
								mes "一些材料，";
								mes "我很乐意用 1 个神之金属";
								mes "和你交换。怎么样？";
								next;
								mes "[卡维塔]";
								mes "你愿意带给我";
								mes "40 个大杰勒比、";
								mes "10 个神之金属锻造石、";
								mes "3 个煤炭和";
								mes "10 个赛依伐吗？";
								next;
								switch(select("Sure~!:No, thanks.")) {
						 		case 1:
									set Zeny,Zeny-1000;
									set $ein_amano,$ein_amano + 1;
									set ein_gear1,1;
									mes "[卡维塔]";
									mes "太好了……！";
									mes "现在我要去";
									mes "照顾我的妻子。";
									mes "准备好后，";
									mes "把我要求的所有物品";
									mes "都收集齐再回来。";
									close;
						 		case 2:
									mes "[卡维塔]";
									mes "我明白了。";
									mes "我理解冒险者们";
									mes "不会在一个地方";
									mes "停留太久。再次感谢";
									mes "你的帮助。";
									mes "谢谢你。";
									next;
									mes "[卡维塔]";
									mes "不过请收下";
									mes "这份小礼物，";
									mes "聊表";
									mes "我的谢意。";
									set Zeny,Zeny-1000;
									getitem 1010,1; // Phracon
									close;
								}
							}
					 	}
					case 2:
						mes "[卡维塔]";
					mes "我明白了。";
					mes "很抱歉我向你";
					mes "提出了这么多要求。";
					mes "但请理解，";
					mes "我真的走投无路了……";
						close;
					}
		 		case 2:
					mes "[卡维塔]";
					mes "你……";
					mes "你真无情！";
					mes "^666666*Sob...*^000000";
					mes "你看不出来我";
					mes "很穷、需要帮助吗？！";
					close;
				case 3:
					mes "[卡维塔]";
					mes "最近隧道发生塌方，";
					mes "导致矿工伤亡。";
					mes "现在人手更不足，";
					mes "矿井作业";
					mes "更加困难。";
					mes "";
					next;
					mes "[卡维塔]";
					mes "真正可疑的是，";
					mes "似乎有什么东西";
					mes "故意让隧道";
					mes "塌陷。有人认为";
					mes "这是因为我们激怒了";
					mes "洞穴之主。";
					next;
					mes "[卡维塔]";
				mes "隧道事故";
				mes "至今仍历历在目。";
				mes "隧道开始莫名塌陷后，";
				mes "似乎出现了更多";
				mes "^FF0000洞穴之王^000000的目击报告。";
				mes "不知为何隧道不断塌方。";
					next;
					mes "[卡维塔]";
				mes "事故发生时我正好休假。";
				mes "不过听说唯一的幸存者";
				mes "发疯后不知";
				mes "消失到哪里去了。";
				mes "真是可怜的家伙……";
					close;
				}
			}
		}
	}
}

// Uwe Kleine :: ein_anoz
//============================================================
einbroch,215,180,6	script	Uwe Kleine#ein	85,{
	if (BaseClass == Job_Blacksmith) {
		if (ein_cook > 999) {
			set .@ccc,ein_cook-1000;
			if (.@ccc > 199) {
				mes "[Uwe]";
				mes "哦，你好呀你好呀～";
				mes "好久不见，";
				mes "我们有一阵子没聊天了，";
				mes "可爱的冒险者～";
				next;
				switch(select("So... You're a chef.:Yes, I tried my best.")) {
				case 1:
					mes "["+ strcharinfo(0) +"]";
					mes "那么……";
					mes "你是厨师。";
					next;
					mes "[Uwe]";
					mes "没错，这就是";
					mes "我的职业。";
					mes "至于我为了";
					mes "^EEA9B8pleasure^000000, well, please don't";
					mes "乐趣做些什么，尽管问我吧，亲爱的～";
					next;

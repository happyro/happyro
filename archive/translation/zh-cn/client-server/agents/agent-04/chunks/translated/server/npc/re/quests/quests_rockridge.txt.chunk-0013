	end;
}

harboro1,93,201,1	script	Roland Burts#rockwn17	4_M_ILYA,{
	mes "[罗兰·伯茨]";
	mes "我们的村子由自己的义勇队保护。";
	mes "他们在沃普警长的指挥下守卫村子。";
	next;
	emotion ET_KEK;
	mes "[罗兰·伯茨]";
	mes "我们最大的威胁无疑是水牛强盗，但也有一些野兽带来麻烦。";
	mes "至于村子地下有什么？*发抖*还是别提了。";
	close;
}

harboro1,98,211,3	script	Loretta#rockwn08	4_F_ACOLYTE,5,5,{
	emotion ET_THROB;
	mes "[洛蕾塔]";
	mes "欢迎来到自由之城洛克里奇。无论你走到哪里，奥丁都与你同在！";
	mes "想聆听神的教诲就来找我们。";
	next;
	mes "[洛蕾塔]";
	mes "我们不需要教堂。 奥丁不会来到建筑里，他来到我们的心中。";
	mes "让我们向他祈祷，表达感激。";
	next;
	emotion ET_KEK, getnpcid(0, "Dolores#rockwn09");
		npctalk "真希望能在凉爽的树荫下喝一杯冰柠檬水。", "Dolores#rockwn09", bc_self;
	mes "[多洛莉丝]";
	mes "洛蕾塔姐姐，我的腿疼。*呜咽*";
	mes "他也许不会来到建筑里，但我想进去坐坐。";
	next;
	mes "[多洛莉丝]";
	mes "啊，对了，莫里斯兄弟！";
	next;
	mes "[洛蕾塔]";
	mes "……唉。今天最后一艘船进港后，我给你买柠檬水、青柠水，想要什么都行。";
	mes "所以现在先做好神的仆人。";
	next;
	emotion ET_BIGTHROB, getnpcid(0, "Dolores#rockwn09");
	emotion ET_BIGTHROB, getnpcid(0, "Maurice#rockwn10");
		npctalk "我们信仰他！", "Dolores#rockwn09", bc_self;
		npctalk "我们信仰他！", "Maurice#rockwn10", bc_self;
	mes "[Maurice]";
	mes "柠檬水！我是说，神与你同在！";
	close;

OnTouch:
		npctalk "奥丁", "", bc_self;;
		npctalk "与你同在", "Dolores#rockwn09", bc_self;
		npctalk "。", "Maurice#rockwn10", bc_self;
	end;
}

harboro1,100,211,3	script	Dolores#rockwn09	1_F_PRIEST,{
	mes "[多洛莉丝]";
	mes "我同意我们的心就是教堂。";
	mes "但神也可以来到舒适的卧室和香气扑鼻的厨房。 我们不必整天站在风吹的港口。";
	next;
	mes "[洛蕾塔]";
	mes "别人听见会以为你几天没吃饭、没睡觉";
	mes "可事实上你每天都比我们其他人起得晚。";
	next;
	emotion ET_PROFUSELY_SWEAT;
	mes "[多洛莉丝]";
	mes "我、我能怎么办？神会在梦中拜访我。";
	mes "我不是故意晚起的！";
	close;
}

harboro1,101,210,3	script	Maurice#rockwn10	1_M_PASTOR,{
	mes "[Maurice]";
	mes "年纪越大，整天站在外面传播他的话就越困难。";
	mes "但我完成使命的决心和初到这里那天一样坚定。";
	next;
	emotion ET_DELIGHT;
	mes "[Maurice]";
	mes "我不会让身体的疲惫阻碍我。";
	mes "我要用尽所有能量，将他的教诲传播给这片新土地上的人！";
	close;
}

harboro1,94,237,3	script	Cordell#rockn01	4_M_MAYOR,{
	mes "[Cordell]";
	mes "光是看着火车站我就很开心。它是我们村庄的象征。";
	next;
	mes "[Cordell]";
	mes "矿井离村庄很远，所以最初运输矿石是个大问题。";
	next;
	mes "[Cordell]";
	mes "岩岭真正的发展始于铁路系统最终建成之后。";
	mes "好吧，这也加剧了牛头暴徒的问题，但任何事都有阴暗面。";
	next;
	emotion ET_BIGTHROB;
	mes "[Cordell]";
	mes "但我们岩岭人不是来屈服的，我们是来征服的！";
	close;
}

harboro1,74,259,3	script	Eloise McCurdy#rockn14	4_F_GUNSLINGER,{
	mes "[Eloise McCurdy]";
	mes "我以在这里保护货物为荣。";
	mes "我的工作是保护货物不受雨、风，当然还有小偷的侵害。";
	next;
	emotion ET_CRY;
	mes "[Eloise McCurdy]";
	mes "不过最近……哼，我的骄傲被那些该死的牛头暴徒摧毁了。";
	close;
}

harboro1,130,237,3	script	Loading Dock Foreman#ro	4_M_05,{
	mes "[Loading Dock Foreman]";
	mes "火车从矿井运来矿石，也从这个码头为矿工运来补给。";
	next;
	mes "[Loading Dock Foreman]";
	mes "所以这里总是很忙。这里的延误会导致岩岭其他地方都延误。";
	next;
		npctalk "如果你给我加薪，我会更有动力努力工作。", "Jader#rockn11", bc_self;
		npctalk "哈，哈，哈！父亲的力量！", "Rosco Richie#rockn12", bc_self;
		npctalk "我怎么会落到这里？", "Portnias#rockn13", bc_self;
	mes "[Loading Dock Foreman]";
	mes "别像弱者一样抱怨。为成为队伍一员而自豪，更努力工作！";
	close;
}

harboro1,126,236,7	script	Jader#rockn11	4_M_SITDOWN,{
	mes "[Jader]";
	mes "啊，我动不了了。全身都疼。";
	mes "火车来得频繁与否都无所谓。我们总是很忙。";
	next;
	mes "[Loading Dock Foreman]";
	mes "哼，你工作得还不够努力。啧，啧。";
	mes "还有很多人没有工作，你应该为自己有工作感到高兴！";
	next;
	emotion ET_OHNO;
		npctalk "我很累，而且不只是身体上的疲劳。*喃喃自语*", "", bc_self;
	mes "[Jader]";
		mes "*喘气* 你、你在那里站多久了？当、当然，我很高兴有工作！";
	mes "我、我喜欢在这个装卸码头工作。这是我做过最好的工作！";
	close;
}

harboro1,128,233,7	script	Rosco Richie#rockn12	4_M_NOV_HUNT,{
	mes "[Rosco Richie]";
	mes "现在村里人更多了，可用的工作反而更少。幸好我的工作薪水足够养活家人。";
	next;
		npctalk "Edith！爸爸正在为你努力工作！", "", bc_self;
	mes "[Rosco Richie]";
	mes "哈，哈！为了女儿我能做到！";
	close;
}

harboro1,130,232,7	script	Portnias#rockn13	4_CAT_SAILOR2,{
	mes "[Portnias]";
	mes "我听说可以在这里快速发财，所以来了，喵。";
	mes "从帕斯塔的船下来后，我马上又乘船去了岩岭。";
	next;
	mes "[Portnias]";
	mes "现在我不在乎钱了。我只想休息。喵……";
	mes "来这里后我每天搬货，腰都快断了。*呜咽*";
	next;
	emotion ET_OTL;
	mes "[Portnias]";
	mes "这样下去，我赚到的 Zeny 都要拿来付医药费。*呜咽*";
	close;
}

harboro1,144,262,7	script	Scrap Metal Collector#s1	4_M_CAVE1,{
	mes "[Scrap Metal Collector]";
	mes "我想回家。我们在这里永远赚不到很多钱。";
	next;
	mes "[Scrap Metal Collector]";
	mes "不。我们只需坚持到事情结束。之后会有机会的。";
	next;
	mes "[Scrap Metal Collector]";
	mes "但这太难应付了。我觉得我撑不下去了。";
	next;
	mes "[Scrap Metal Collector]";
	mes "来吧，再耐心坚持一会儿。";
	next;
	mes "[Scrap Metal Collector]";
	mes "唉……我想妈妈了。";
	close;
}

harboro1,146,264,3	script	Scrap Metal Collector#s2	4_M_HUBOY,{
	mes "[Scrap Metal Collector]";
mes "这里为什么没有金属？火车遭袭时一定掉了一些。";
	next;
	mes "[Scrap Metal Collector]";
mes "如果有，应该早就被别人找到了。";
	next;
	mes "[Scrap Metal Collector]";
mes "唉，那这里就没有能卖的东西了。我们现在该去哪？";
	next;
	mes "[Scrap Metal Collector]";
mes "也许我们该回大陆。";
	next;
	mes "[Scrap Metal Collector]";
mes "什么？不！我不想当骗子！我们告诉家人会带着一大笔钱回去。";
	close;
}

harboro1,182,241,5	script	Stray Dog#srdg02	4_DOG01,{
	emotion ET_SEXY;
		npctalk "希望他们能给我留点食物。", "", bc_self;
	end;
}

harboro1,183,241,5	script	Stray Dog#srdg01	4_DOG01,{
	emotion ET_SEXY;
		npctalk "我真想吃一块那种肉。", "", bc_self;
	end;
}

harboro1,187,236,3	script	Customer#srdg01	4_TOWER_04,{
	mes "[Customer]";
mes "这家餐厅里没多少人。";
	next;
	emotion ET_FRET, getnpcid(0, "Customer#srdg02");
	mes "[Customer]";
mes "谁会想吃这么难吃的食物？";
	next;
	mes "[Customer]";
mes "哦，你知道这里最好的餐馆在哪里吗？";
	next;
	emotion ET_QUESTION, getnpcid(0, "Customer#srdg02");
	mes "[Customer]";
mes "哪里？";
	next;
	mes "[Customer]";
mes "治安官办公室。地下监狱里的人每天吃三顿，食物好到有人会为了它犯轻罪。";
	next;
	mes "[Customer]";
mes "这说得通吗？我不相信有值得为之犯罪的监狱食物。";
	close;
}

harboro1,182,236,5	script	Customer#srdg02	4_TOWER_02,{
	mes "[Customer]";
mes "他们为什么盯着我们？";
	next;
	mes "[Customer]";
mes "他们在乞讨。";
	next;
	emotion ET_SPARK, getnpcid(0, "Stray Dog#srdg01");
	emotion ET_SPARK, getnpcid(0, "Stray Dog#srdg02");
	mes "[Customer]";
mes "呃，他们盯人的眼神让我不舒服，吃不下饭。";
	close;
}

harboro1,231,251,4	script	Merchant's Chest	4_TREASURE_BOX,{
		npctalk "异国商人：Hudin 的宝箱！别碰它。谢谢！", "Exotic Merchant";
	end;
}

harboro1,229,256,7	script	Charlotte	4_DST_CAMEL,{
	npctalk "*Shriek*";
	sleep 1000;
		npctalk "异国商人：怎么了，Charlotte？", "Exotic Merchant";
	end;
}

harboro1,192,262,7	duplicate(dummy_npc)	Bulk Trader's Camel#1	4_DST_CAMEL
harboro1,197,262,7	duplicate(dummy_npc)	Bulk Trader's Camel#2	4_DST_CAMEL
harboro1,210,262,7	duplicate(dummy_npc)	Bulk Trader's Camel#7	4_DST_CAMEL
harboro1,216,262,7	duplicate(dummy_npc)	Bulk Trader's Camel#8	4_DST_CAMEL
harboro1,223,261,1	duplicate(dummy_npc)	Bulk Trader's Camel#9	4_DST_CAMEL
harboro1,225,257,6	duplicate(dummy_npc)	Bulk Trader's Camel#10	4_DST_CAMEL
harboro1,227,263,1	duplicate(dummy_npc)	Bulk Trader's Camel#11	4_DST_CAMEL
harboro1,229,258,6	duplicate(dummy_npc)	Bulk Trader's Camel#12	4_DST_CAMEL
harboro1,234,259,3	duplicate(dummy_npc)	Bulk Trader's Camel#13	4_DST_CAMEL
harboro1,236,252,6	duplicate(dummy_npc)	Bulk Trader's Camel#14	4_DST_CAMEL
harboro1,237,256,3	duplicate(dummy_npc)	Bulk Trader's Camel#15	4_DST_CAMEL
harboro1,238,258,3	duplicate(dummy_npc)	Bulk Trader's Camel#16	4_DST_CAMEL

harboro1,226,255,3	script	Bulk Trader's Camel#3	4_DST_CAMEL,{
	mes "[Camel]";
mes "嘎啊。";
	close;
}

harboro1,227,260,3	script	Bulk Trader's Camel#4	4_DST_CAMEL,{
	mes "[Camel]";
mes "*哼*";
	close;
}
harboro1,227,260,3	duplicate(Bulk Trader's Camel#4)	Bulk Trader's Camel#6	4_DST_CAMEL

harboro1,232,258,6	script	Bulk Trader's Camel#5	4_DST_CAMEL,{
	mes "[Camel]";
mes "你为什么一直戳我？";
	next;
	mes "[Camel]";
mes "……糟糕。";
mes "忘了你听到的。";
	next;
	mes "[Camel]";
mes "嘎啊啊。";
	close;
}

harboro1,210,219,5	script	Priest#srdg01	4_M_MINISTER,{
	setpcblock PCBLOCK_NPC, true;
		npctalk "你是痛苦还是悲伤？让我帮帮你。", "", bc_self;
	sleep2 1500;
		npctalk "我们每个人生来都值得被爱。", "", bc_self;
	setpcblock PCBLOCK_NPC, false;
	end;
}

harboro1,229,212,7	script	Herman Farland#rockn19	4_M_TWTEAMAN,{
	mes "[Herman Farland]";
	mes "啊，是的，这里是警长办公室。你问要排队等吗？";
	next;
	mes "[Herman Farland]";
	mes "嗯，你是冒险者，对吧？那就直接穿过那扇门往前走。";
	next;
	mes "[Herman Farland]";
	mes "你是来帮助警长的，对吧？我们是来向他求助的，所以我理解你得先于我们见他。";
	next;
		npctalk "我明白了。啊，我的腿！", "", bc_self;
	mes "[Herman Farland]";
	mes "别管我，我完全理解。唉，我站太久了，腿几乎动不了了！";
	close;
}

harboro1,231,212,7	script	Edel Peppina#rockn16	4_F_CAPEGIRL,{
	mes "[Edel Peppina]";
	mes "警长办公室人手不足。我排了一整天的队，队伍和刚来时一样长。我一直听到地下室传来奇怪的声音，真的需要有人来检查。";
	next;
	mes "[Edel Peppina]";
	mes "我们的警长没有法律权力，但他的办公室仍是我们遇到这种事时唯一能求助的地方。";
	next;
	mes "[Edel Peppina]";
	mes "希望村里的事情能尽快稳定下来，就从这条队伍开始吧。";
	close;
}

harboro1,233,215,3	script	Wilfred Sagan#rockn15	4_M_SITDOWN,{
	mes "[Wilfred Sagan]";
	mes "警长一直忙着处理水牛强盗，没时间做其他事。我在这里等他好几个小时了。";
	close;
}

harboro1,168,216,3	script	Hilliard#rockn09	4_TOWER_12,{
	mes "[Hilliard]";
	mes "村里很多人没有工作，所有能找到的工作都给了冒险者。";
	next;
		npctalk "所以在正确的时间出现在正确的地点很重要。", "", bc_self;
	mes "[Hilliard]";
	mes "唯一因冒险者涌入而兴旺的地方就是旅馆。";
	mes "也许我自己也该开一家旅馆。";
	close;
}

harboro1,156,215,5	script	Innkeeper#rockridge	1_ETC_01,{
	mes "[Innkeeper]";
	mes "欢迎来到懒猫头鹰旅馆。";
	next;
	mes "[Innkeeper]";
	mes "在找住宿的地方吗？你来对地方了！";
	mes "要一间房吗？费用是 5,000 Zeny。";
	next;
	switch( select( "Save.", "Get a room at 5,000 Zeny.", "Quit." ) ) {
	case 1:
		mes "[Innkeeper]";
		mes "已经登记。欢迎下次再来。";
		savepoint "harboro1",156,211,2,2;
		close;
	case 2:
		if (Zeny < 5000) {
			mes "[Innkeeper]";
			mes "抱歉，房费是 5,000 Zeny。";
			mes "如果钱不够，就不能入住。";
			close;
		}
		mes "[Innkeeper]";
		mes "祝你在懒猫头鹰旅馆住得愉快。";
		close2;
		Zeny = Zeny - 5000;
		percentheal 100,100;
		warp "harboro1",157,210;
		end;
	case 3:
		mes "[Innkeeper]";
		mes "欢迎下次再来。";
		close;
	}
}

harboro1,228,170,3	script	Wanderer Doram#rkrgtwn	4_DR_STELO,5,5,{
	mes "[Wanderer Doram]";
	mes "呜呜！警长办公室到底在哪里？我的钱！钱啊啊啊！";
	next;
	mes "[Wanderer Doram]";
	mes "大家都说 Rock Ridge 是机遇之地！为什么没人告诉我有可怕的水牛强盗？";
	next;
	mes "[Wanderer Doram]";
	mes "*打嗝* 他们把我抢得一干二净。我连一杯卡鲁纳牛奶的钱都没有了。";
	emotion ET_CRY;
	close;

OnTouch:
		npctalk "流浪多拉姆：看在神的份上，东方到底是哪边？！", "", bc_self;
	end;
}

harboro1,130,158,3	script	Akuha#rockn19	4_M_CACTUSCHILD,5,5,{
	mes "[Akuha]";
	mes "爷爷说我们不该跟着陌生人，否则他们会拔光我们的刺。如果他说的是真的呢？";
	next;
	emotion ET_CRY;
	mes "[Akuha]";
	mes "Boohoo! Grandma! Boohoo!";
	next;
	mes "[Nahari]";
	mes "别担心。你的刺这么锋利，没人敢碰它们。";
mes "我头上的花还在吗？";
	next;
	mes "[Akuha]";
mes "*抽鼻子*在，和上次看时一样漂亮。";
	next;
	mes "[Nahari]";
mes "那就没事了。继续走吧，我们很快就能见到奶奶。";
mes "去那里看看。";
	next;
	emotion ET_KEK;
	mes "[Akuha]";
mes "我不能失去所有尖刺，变成光滑的脸。那样太丢脸了，我都想把自己埋进地里。";
	close;

OnTouch:
	npctalk "Grandma... Grandma... Boohoo!", "", bc_self;
	end;
}

harboro1,132,157,3	script	Nahari#rockn19	4_F_CACTUSCHILD2,{
	mes "[Nahari]";
mes "这里真神奇。看看这些大木屋。";
mes "海上长着树，而且它们看起来都一样。";
	next;
	mes "[Akuha]";
mes "*呜咽* Nahari，奶奶不会高兴我们这样。";
mes "趁她担心之前回去吧。";
	next;
	mes "[Nahari]";
mes "但我们甚至不知道自己在哪里。";
mes "再看看一会儿吧。看，那边有很多陌生人！";
	next;
	emotion ET_CRY, getnpcid(0, "Akuha#rockn19");
	mes "[Akuha]";
mes "如果我们回不了家怎么办？";
	close;
}

harboro1,99,127,7	script	Kid#srdg01	4_KID01,{
		npctalk "嘿，你们打架了吗？", "", bc_self;
	end;
}

harboro1,96,130,3	duplicate(dummy_npc)	Thunder#srdg01	4_DONKEY
harboro1,104,130,5	duplicate(dummy_npc)	Lightning#srdg01	4_DONKEY
harboro1,102,133,7	duplicate(dummy_npc)	Speed Racer 2#srdg01	4_DONKEY
harboro1,104,132,5	duplicate(dummy_npc)	Speed Racer 1#srdg01	4_DONKEY


harboro1,174,125,3	script	Villager#srdg01	1_M_INNKEEPER,{
		npctalk "今天风很大。我最好把门窗都关上。", "", bc_self;
	end;
}

harboro1,184,123,5	script	Traveler#srdg02_1	4_M_SIT_NOVICE,{
	mes "[Traveler]";
mes "也许我们该探索矿井之外，尽可能深入。";
	next;
	mes "[Traveler]";
mes "如果太危险怎么办？我说我们该绕道去别处。";
	next;
	mes "[Traveler]";
mes "或者我们可以成为未知世界的开拓者！";
	next;
	mes "[Traveler]";
mes "不。东侧被牛头暴徒占据。我们应该等他们的问题解决。";
	next;
	mes "[Traveler]";
mes "那些该死的牛头暴徒！";
	close;
}

harboro1,188,123,3	script	Traveler#srdg02_2	4_M_SITDOWN,{
	mes "[Traveler]";
mes "我决定了！我要加入治安队！";
	next;
	mes "[Traveler]";
mes "你确定他们会让你加入？";
	next;
	mes "[Traveler]";

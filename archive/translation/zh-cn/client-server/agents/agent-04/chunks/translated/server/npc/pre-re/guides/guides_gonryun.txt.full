gonryun,163,60,4	script	Kunlun Guide#gon	780,{
	mes "[He Yuen Zhe]";
	mes "你好！";
	mes "欢迎来到昆仑～";
	mes "四处走走，感受这座城市";
	mes "悠久的历史";
	mes "和令人惊叹的传统吧。";
	next;
	mes "[He Yuen Zhe]";
	mes "我负责帮助您解决";
	mes "遇到的各种问题。";
	mes "有任何疑问都可以问我。";
	next;
	switch(select("首领住所:工具商人:武器商人:防具商人:酿酒师")) {
	case 1:
		viewpoint 1,109,131,0,0xFF3355;
		mes "[He Yuen Zhe]";
		mes "请查看小地图，前往 ^FF3355+^000000 标记处。";
		mes "那里就是首领的住所。祝您在美丽的昆仑玩得愉快！";
		mes "谢谢！";
		close;
	case 2:
		viewpoint 1,147,82,1,0xCE6300;
		mes "[He Yuen Zhe]";
		mes "请查看小地图，前往 ^CE6300+^000000 标记处。";
		mes "那里就是工具商人。祝您在美丽的昆仑玩得愉快！";
		mes "谢谢！";
		close;
	case 3:
		viewpoint 1,174,104,2,0x55FF33;
		mes "[He Yuen Zhe]";
		mes "请查看小地图，前往 ^55FF33+^000000 标记处。";
		mes "那里就是武器商人。祝您在美丽的昆仑玩得愉快！";
		mes "谢谢！";
		close;
	case 4:
		viewpoint 1,173,84,3,0x3355FF;
		mes "[He Yuen Zhe]";
		mes "请查看小地图，前往 ^3355FF+^000000 标记处。";
		mes "那里就是防具商人。祝您在美丽的昆仑玩得愉快！";
		mes "谢谢！";
		close;
	case 5:
		viewpoint 1,215,114,3,0xCD69C9;
		mes "[He Yuen Zhe]";
		mes "请查看小地图，前往 ^CD69C9+^000000 标记处。";
		mes "那里就是酿酒师。祝您在美丽的昆仑玩得愉快！";
		mes "谢谢！";
		close;
	}
}

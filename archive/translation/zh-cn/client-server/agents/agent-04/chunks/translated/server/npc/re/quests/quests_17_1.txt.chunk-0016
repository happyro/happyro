	.@qid = 17027 + .@id;
	if (isbegin_quest(.@qid) == 0 && isbegin_quest(17026) == 1) {
		switch (.@id) {
		case 0:
		case 1:
			mes "[" + strcharinfo(0) + "]";
			mes "我翻过垃圾，找到几条身份手环。再看看别处。";
			next;
			mes "[" + strcharinfo(0) + "]";
			mes "这里似乎没有与 Kaufmann 有关的东西。";
			break;
		case 2:
			mes "[" + strcharinfo(0) + "]";
			mes "我翻过这堆东西，只找到垃圾。";
			break;
		case 3:
			mes "[" + strcharinfo(0) + "]";
		mes "我从垃圾堆里挖出一条埋着的手环。看起来是实验用的身份手环。上面写着……Pat……Patrick……Kauf……man。";
			next;
			mes "[" + strcharinfo(0) + "]";
			mes "这是 Patrick Kaufmann 的手环……回<NAVI>[Kaya]<INFO>sp_cor,136,146,0,101,0</INFO></NAVI>去。";
			completequest 17026;
			setquest 17032;
			getitem 25666,1;
			break;
		case 4:
			mes "[" + strcharinfo(0) + "]";
		mes "我翻遍了那堆东西，什么也没找到。";
			break;
		}
		setquest .@qid;
		completequest .@qid;
		close;
	}
	if (isbegin_quest(.@qid) == 2 && isbegin_quest(17026) == 1) {
		mes "["+strcharinfo(0)+"]";
		mes "我已经看过这里了。看看别处。";
		close;
	}
	mes "[" + strcharinfo(0) + "]";
	mes "这里似乎是死路。";
	close;

OnInit:
	.@id = atoi(replacestr(strnpcinfo(2),"171_rudus_",""));
	.@qid = 17027 + .@id;
	questinfo QTYPE_QUEST,QMARK_YELLOW,"isbegin_quest(17026) == 1 && isbegin_quest(" + .@qid + ") == 0";
	end;
}


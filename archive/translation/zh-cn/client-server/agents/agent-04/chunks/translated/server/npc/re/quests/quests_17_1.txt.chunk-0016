//= Cor Daily
sp_cor,162,56,0	script	#171_ocp_ev	HIDDEN_WARP_NPC,4,4,{
	end;

OnTouch:
	if (isbegin_quest(11603) == 2 && isbegin_quest(12452) != 2) {
		cloakoffnpc "Est#171_ocp",getcharid(0);
		npctalk "我们必须迅速消灭它们。时间不多了。","Est#171_ocp",bc_self;
	} else if (isbegin_quest(12452) == 2)
		cloakoffnpc "Operation Officer#171_ocp",getcharid(0);
	end;
}

sp_cor,163,56,4	script	Est#171_ocp	4_F_ESTLOVELOY,{
	if (isbegin_quest(12452) == 0) {
		cutin "ep162_est01",2;
		mes "[Est]";
		mes "哦，你来了。我听说侦察队控制了铁路运输路线。";
		next;
		select("询问下一步行动。");
		mes "[Est]";
		mes "我们控制了运输路线，但他们可能几小时后反击。那样行动就失去意义了。";
		next;
		mes "[Est]";
		mes "我们计划在周边区域展开全面战斗，防止反击。当然不会让平民参与……";
		next;
		select("询问需要准备什么。");
		mes "[Est]";
		mes "进入行动区域后进行简报。记得带上所需物资。";
		next;
		mes "[Est]";
		mes "我们已经控制了路线，他们可能几小时后反击。";
		setquest 12452;
		close3;
	}
	if (isbegin_quest(12452) == 1) {
		mes "^FF0000请注意，在副本内驯服怪物等异常处理不属于正常行为，可能妨碍副本进度。^000000";
		next;
		mes "^FF0000初心者模式下，玩家会变形成怪物。请注意，进入并继续后现有变身效果会消失。^000000";
		next;
		cutin "ep162_est01",2;
		mes "[Est]";
		mes "准备好了吗？";
		next;
		.@party_id = getcharid(1);
		if (!.@party_id) {
			mes "[Est]";
			mes "你是一个人吗？独自行动很难。组队组成部队后开始。";
			close3;
		}
		cutin "",255;
		.@party_name$ = getpartyname(.@party_id);
		.@md_name$ = "OS Occupation";
		switch (select(is_party_leader() ? "准备进行 OS 占领。":"","进入","退出")) {
		case 1:
			if (instance_create(.@md_name$) == -3)
				dispbottom "由于已有实例运行，实例‘" + .@md_name$ + "’预约失败。";
			mes "[Est]";
		mes "进入占领行动前检查你的队伍。";
			break;
		case 2:
			if (instance_enter(.@md_name$) == IE_OK)
				mapannounce "sp_cor", strcharinfo(0) + " 所在的队伍‘"+ .@party_name$ +"’正在进入" + .@md_name$ + "。", bc_map, "0x00FF99";
			else
		mes "行动准备尚未完成，或你的队伍正在执行其他行动。";
			break;
		case 3:
		}
		close;
	}
	end;

OnInit:
	cloakonnpc();
	end;
}

sp_cor,160,55,5	script	Operation Officer#171_ocp	4_M_ILYA,{
		mes "^FF0000请注意，在副本内驯服怪物等异常处理不属于正常行为，可能妨碍副本进度。^000000";
	next;
	switch (checkquest(12455,PLAYTIME)) {
	case -1:
		break;
	case 0:
	case 1:
		mes "[Operation Officer]";
		mes "还没到行动时间，先休息。";
		close;
	case 2:
		erasequest 12455;
	}
	if (isbegin_quest(12454) == 2) erasequest 12454;
	if (isbegin_quest(12454) == 0) {
		mes "[Operation Officer]";
		mes "尽管第一次歼灭行动压制了敌人，变种人又开始爬出来。";
		next;
		mes "[Operation Officer]";
		mes "如果能摧毁源头会更容易。但上面的人不会批准，所以我们必须开始第二次搜索。";
		setquest 12454;
	} else {
		mes "[Operation Officer]";
		mes "希望搜索能安全完成。";
	}
	next;
	mes "[Operation Officer]";
	mes "准备好了吗？";
	next;
	.@party_id = getcharid(1);
	if (!.@party_id) {
		mes "[Operation Officer]";
		mes "你是一个人吗？独自行动很难。组队组成部队后开始。";
		close;
	}
	.@party_name$ = getpartyname(.@party_id);
	.@md_name$ = "2nd OS Search";
	switch (select(is_party_leader() ? "准备第二次 OS 搜索。":"","进入","退出")) {
	case 1:
		if (instance_create(.@md_name$) == -3)
				dispbottom "由于已有实例运行，实例‘" + .@md_name$ + "’预约失败。";
		mes "[Operation Officer]";
		mes "搜索前进行最后一次队伍检查。";
		break;
	case 2:
		if (instance_enter(.@md_name$) == IE_OK) {
			setquest 12455;
				mapannounce "sp_cor", strcharinfo(0) + " 所在的队伍‘"+ .@party_name$ +"’正在进入" + .@md_name$ + "。", bc_map, "0x00FF99";
		} else
		mes "行动准备尚未完成，或你的队伍正在执行其他行动。";
	case 3:
	}
	close;

OnInit:
	cloakonnpc();
	end;
}

//	Daily Quest NPC
sp_cor,113,130,3	script	Rebellion#rm171_8	4_M_REBELLION3,{
	if (isbegin_quest(16360) < 2) {
		mes "[Rebellion]";
		mes "啊，冒险者！好久不见！想我了吗？";
		next;
		select( "你认识我吗？", "不……");
		mes "[Rebellion]";
		mes "啊，你真冷淡，冒险者。别这样。";
		mes "我在这里站岗，防止陌生人靠近。";
		next;
		mes "[Rebellion]";
		mes "但你不是陌生人，我让你通过。";
		mes "你有符合职业的武器和防具，也穿着保暖衣服。通过！";
		close;
	}
	//--- Daily Quest Cooldown
	switch (checkquest(16362,PLAYTIME)) {
	case -1:
		break;
	case 0:
	case 1:
		mes "[Rebellion]";
		mes "Mina 说你可以晚点再来。他可爱的孩子们现在起床还太早。";
		next;
		cloakoffnpcself( "Elyumina#rm171_4" );
		cutin "ep171_elyumina03",0;
			npctalk "Elyumina：别、别再叫我那个可笑的名字！", "Elyumina#rm171_4", bc_self;
		mes "[Elyumina]";
		mes "……召唤怪物的安全装置和陷阱仍处于低功耗模式。别碰它们，否则很容易过热。";
		next;
		cutin "",255;
		mes "[Rebellion]";
		mes "请在天亮后 Mina 的孩子们醒来、准备迎接活力满满的一天时再来！";
		next;
		cutin "ep171_elyumina02",0;
		mes "[Elyumina]";
		mes "天亮后它们会充满电，准备再次运转。到时再来。";
			npctalk "（这个佣兵似乎知道如何对付那个捣蛋鬼。）", "", bc_self;
		close3;
	case 2:
		erasequest 16362;
		break;
	}
	if (isbegin_quest(16361) < 2) {
		mes "[Rebellion]";
		mes "哦，冒险者！好久不见！其实我想问你一件事，是关于 Mina 的。";
		npctalk "Mina？", "", bc_self;
		next;
		cutin "ep171_elyumina03",0;
		cloakoffnpcself( "Elyumina#rm171_4" );
		npctalk "Elyumina：别、别那样叫我！", "Elyumina#rm171_4", bc_self;
		npctalk "你？", "", bc_self;
		mes "[Elyumina]";
		mes "让我解释一下。你跟着我来的时候，那些曾保护我的机器——";
		next;
		cutin "",255;
		mes "[Rebellion]";
		mes "不，我们没有抓到 Mina 的机器。它们一直藏着睡觉。";
		next;
		cutin "ep171_elyumina02",0;
		mes "[Elyumina]";
		mes "是 Elyumina 的！Elyumina 的机器！还有陷阱！……它们在低功耗模式下隐身，以防紧急情况。现在它们又该出现并开始横冲直撞了。";
		next;
		cutin "",255;
		npctalk "……它们是你的。把它们关掉就好。", "", bc_self;
		mes "[Rebellion]";
		mes "问题在于，Mina——";
		next;
		cutin "ep171_elyumina02",0;
		mes "[Elyumina]";
		mes "是 Elyumina，我做不到！它们配备了高科技机器学习模块。";
		mes "从那天起，它们使用关于你这个最强敌人的数据，并借此迅速成长。";
		next;
		cutin "ep171_elyumina03",0;
		npctalk "反叛军：所以现在它们拒绝听从 Mina 的命令，而且——", "Rebellion#rm171_8", bc_self;
		mes "[Elyumina]";
		mes "我控制不了它们！……完全出乎意料。";
		mes "我能想到的唯一办法是耗尽它们的电池，直到停止工作。";
		next;
		mes "[Elyumina]";
		mes "唯一能做到的人就是你。你击败过 EL1_A17T。当然我会和你一起去，但我只是为了收集它们的新数据。";
		next;
		cutin "",255;
		mes "[Rebellion]";
		mes "我也想去，但 Mina 不让。我想也许是因为他关心我。";
		next;
		cutin "ep171_elyumina03",0;
		npctalk "Elyumina：不，不要！", "Elyumina#rm171_4", bc_self;
		mes "[Elyumina]";
		mes "总之，我不认为你能独自应付它们。";
		mes "那天扣留我的暴徒也不够。和其他冒险者组队回来，好吗？";
		next;
		cutin "",255;
		mes "[Rebellion]";
		mes "那么，算上我和 Mina，至少有四个人——";
		next;
		cutin "ep171_elyumina02",0;
		mes "[Elyumina]";
		mes "进去后我会告诉你更多细节。拜托，说好！";
		mes "拜托！在他让我心脏病发之前！";
		setquest 16361;
		completequest 16361;
	} else {
		mes "[Rebellion]";
		mes "Mina 的孩子们该起床活动了，冒险者。";
		mes "要和它们玩一会儿，再哄它们回床上，同时让其他人等你完成吗？";
		next;
		cloakoffnpcself( "Elyumina#rm171_4" );
		cutin "ep171_elyumina03",0;
		mes "[Elyumina]";
		mes "……很快，我的安保装置和陷阱就会退出低功耗模式，再次行动。";
		next;
		cutin "ep171_elyumina02",0;
		mes "[Elyumina]";
		mes "要封锁 Cor、耗尽它们并再次收集数据吗？";
		mes "请答应我。让我跟你去。我等不及要离开这个家伙了。";
	}
	next;
	cutin "",255;
	mes "[Rebellion]";
	mes "嗯，真遗憾。冒险者，如果你想参加行动，请作为队长选择‘准备’。";
	next;
	mes "[Rebellion]";
	mes "创建纪念副本、所有队员选择进入后，你可以选择进入开始行动。";
	next;
	mes "^ff0000请注意，如果尝试驯服怪物或进行其他无关的怪物活动，将无法完成这个地下城。^000000";
	next;
	if (getcharid(1) < 1) {
		mes "[Rebellion]";
	mes "嗯？Mina 认为你无法独自完成。请组队回来，冒险者。";
		close;
	}
	if (is_party_leader())
		.@menu$ = "Ready";
	switch (select( .@menu$, "进入", "取消" )) {
	case 1:
		if (instance_create("Cor Memorial") < 1) {
			mes "[Rebellion]";
			mes "似乎出了问题。你的请求失败了。请稍后再试。如果问题持续，请联系行动队。";
			close;
		}
		npctalk "哈哈。他真可爱。", "Rebellion#rm171_8", bc_self;
		mes "[Rebellion]";
		mes "好，如果 MD 已激活，再来和我交谈并选择^0000CD进入^000000。进入后行动就会开始。";
		close;
	case 2:
		switch (instance_enter("Cor Memorial")) {
		case IE_OK:
			if (isbegin_quest(16363) > 0)
				erasequest 16363;
			setquest 16362;
			mapannounce "sp_cor", strcharinfo(0) + " 所在的队伍‘" + getpartyname(getcharid(1)) + "’已开始镇压 EL1_A17T 的行动。", bc_map, 0x00FF99;
			end;
		case IE_NOMEMBER:
			mes "[Rebellion]";
		mes "副本尚未创建。我再检查一次。";
			close;
		case IE_NOINSTANCE:
			mes "[Rebellion]";
		mes "你的队长尚未创建副本。我再检查一次。";
			close;
		case IE_OTHER:
			mes "[Rebellion]";
		mes "发生未知错误。我们再检查一次。";
			close;
		}
		end;
	case 3:
		cutin "ep171_elyumina02",0;
		mes "[Elyumina]";
		mes "你在做什么？来吧，我们走。拜托？我不想再和那个总用糟糕绰号叫我的混蛋多待一刻。";
		close3;
	}
	end;

OnInit:
	questinfo (QTYPE_QUEST, QMARK_YELLOW, " isbegin_quest(16360) == 2 && isbegin_quest(16361) == 0 ");
	questinfo (QTYPE_QUEST, QMARK_YELLOW, " isbegin_quest(16360) == 2 && isbegin_quest(16361) == 2 && checkquest(16362,PLAYTIME) == -1 ");
	questinfo (QTYPE_QUEST, QMARK_YELLOW, " checkquest(16362,PLAYTIME) == 2 ");
	end;
}

sp_cor,155,94,3	script	Juslan#171_daily_merc	4_M_GUNSLINGER3,{
	if (isbegin_quest(11603) != 2) {
		mes "[Juslan]";
		mes "嗯？我觉得我们需要清理这片区域的心脏猎人。";
		mes "你不参加下一次行动吗？";
		close3;
	}
	switch (checkquest(7868,PLAYTIME)) {
	case -1:
		break;
	case 0:
	case 1:
		mes "[Juslan]";
		mes "哇，你今天辛苦了。";
		mes "特种部队已经在搜寻，但还没找到实验室……";
		next;
		mes "[Juslan]";
		mes "心灵猎手怎么这么快就回来了？";
		mes "我想我们很快要再次战斗，但现在先休息。";
		close;
	case 2:
		mes "[Juslan]";
		mes "嗯~休息得好吗？";
		mes "准备进行心灵猎手狩猎吧。";
		mes "准备好后我们再出发。";
		erasequest 7868;
		close;
	}
	switch (checkquest(7867,HUNTING)) {
	case -1:
		break;
	case 1:
		mes "[Juslan]";
		mes "请处理 15 只^0000FF心灵猎手 Bellares 和心灵猎手 Sanares。^000000";
		mes "我想获得战斗信息。";
		next;
		mes "[Juslan]";
		mes "你知道地点，对吧？";
		mes "从那里沿着踪迹走。";
		close;
	case 2:
		mes "[Juslan]";
		mes "这些家伙比预想中更强。";
		mes "看来它们的装备或能力以各种方式增强了。";
		next;
		mes "[Juslan]";
		mes "不知道它们是不是通过这个实验室的实验强化的？";
		mes "它们现在变得这么强，我无法信任这些人……";
		next;
		mes "[Juslan]";
		mes "非常感谢你今天的工作。";
		mes "现在先休息吧。";
		setquest 7868;
		erasequest 7867;
		getexp 200000,200000;
		getitem 25669,5;
		getitem 25723,1;
		close2;
		npctalk "我需要休息一下……","",bc_self;
		end;
	}
	mes "[Juslan]";
	mes "心灵猎手 Bellares 和 Sanares 与我们之前遇到的不同。";
	mes "它们很难对付。";
	next;
	mes "[Juslan]";
	mes "因此 Est 特种部队藏在战场上，以便进一步推进。";
	mes "我们必须对付那些家伙，有时确实很难。";
	next;
	if (select("Let's do it.:That sounds like trouble.") == 2) {
		mes "[Juslan]";
		mes "确实会。嗯。";
		mes "冒险者应该休息一下。";
		mes "你的身体一定累了。";
		close;
	}
	mes "[Juslan]";
	mes "听到这个我很高兴。";
	mes "你能妥善对付心灵猎手 Bellares 和 Sanares 吗？";
	mes "请各猎杀 15 只心灵猎手。";
	next;
	mes "[Juslan]";
	mes "如果可以，我想收集更多战斗数据。";
	mes "我会非常感谢。";
	setquest 7867;
	close2;
		npctalk "我需要休息一下……","",bc_self;
	end;

OnInit:
	questinfo QTYPE_DAILYQUEST,QMARK_YELLOW,"isbegin_quest(11603) == 2 && checkquest(7868,PLAYTIME) == -1 && checkquest(7867,HUNTING) == -1";
	questinfo QTYPE_DAILYQUEST,QMARK_YELLOW,"isbegin_quest(11603) == 2 && checkquest(7868,PLAYTIME) == 2 && checkquest(7867,HUNTING) == -1";
	questinfo QTYPE_QUEST,QMARK_YELLOW,"checkquest(7867,HUNTING) == 2";
	end;
}

sp_cor,246,97,3	script	Farmhand#rm171_1	1_M_03,{
	if (isbegin_quest(16360) < 2) {
		mes "[Farmhand]";
		mes "抱歉，我很忙。我想你们城里人不想待在这里，因为这里有肥料味。去那边和研究员们以前待的地方的人汇合吧。";
		close;
	}
	if (isbegin_quest(16364) == 0) {
		mes "[Farmhand]";
		mes "我们在这里种蔬菜。这座自给自足的农场是我们的骄傲。";
		next;
		mes "[Farmhand]";
		mes "但自从这起事件后，许多员工申请调动，导致人手不足。你能帮我们照料作物吗？";
		next;
		if (select( "Help.", "Do not help." ) == 2) {
			mes "[Farmhand]";
		mes "你们这些大人物来到这里，毁了我们的安宁。";
			next;
			mes "[Farmhand]";
		mes "Ban，算了。我们拥有的也许根本不是真正的安宁。";
			close3;
		}
		mes "[Farmhand]";
		mes "谢谢！我们农场种植葡萄、青豆和南瓜，它们各有不同需求。";
		next;
		setarray .@r[0], rand(3), rand(3), rand(3);
		setarray .@string$[0],"catch aphids","spread fertilizer","pull weeds";
		setquest 16367+.@r[0];
		setquest 16370+.@r[1];
		setquest 16373+.@r[2];

}

comodo,216,310,4	script	BBQ Papa#cmd::CmdFamily	50,{
	mes "[BBQ Boy]";
	mes "爸、爸爸！那些人说的是真的吗？";
	mes "我们村子里真的有邪恶女巫？";
	next;
	mes "[BBQ Mama]";
	mes "亲爱的……";
	mes "我确定那些好人";
	mes "只是在开玩笑～";
	mes "怎么可能是真的？";
	next;
	mes "[BBQ Papa]";
	mes "好了好了，别告诉我";
	mes "我的小男子汉会害怕小女巫。";
	mes "那只是古老的童话，儿子，";
	mes "完全没理由害怕。";
	next;
	mes "[BBQ Boy]";
	mes "不，爸爸，我不害怕！";
	mes "但如果女巫真的住过这里，";
	mes "她的家就在科莫多附近，对吧？";
	mes "我总有一天要找到它！";
	next;
	mes "[BBQ Mama]";
	mes "哦，但如果女巫真的存在，";
	mes "我相信首领已经知道些什么。";
	mes "总之，趁烧烤没烧焦，快吃吧，好吗？";
	next;
	mes "[BBQ Boy]";
	mes "耶，烧烤！";
	mes "嗯嗯嗯……总有一天，";
	mes "如果女巫是真的，";
	mes "我要查清她的一切！";
	close;
}


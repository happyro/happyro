		mes "哦，嘿～";
		mes "谢谢你之前帮助我们。";
		mes "我也希望首领能参加烧烤，";
		mes "但我理解他必须保护科莫多。";
		next;
		mes "[罗奇托]";
		mes "嘿，你知道吗？";
		mes "我没法用实际物品报答你，";
		mes "但可以告诉你重要消息。";
		mes "当地酒吧有个人掌握珍贵情报。";
		next;
		mes "[罗奇托]";
		mes "据说，那个人更了解科莫多所在的洞穴……";
		mes "总之，我感觉那里可能有线索，你懂的？";
		break;
	}
	close;
}

comodo,204,310,4	script	Camping Youth#cmd	65,{
	switch (dmdswrd_Q) {
	case 0:
	case 1:
		mes "[Rockha]";
		mes "天啊……";
		mes "我太兴奋了！";
		mes "我和伙伴们计划这次烧烤";
		mes "已经很久了～";
		next;
		if(select("伙伴们……？:取消") == 1) {
			mes "[Rockha]";
			mes "是的，我们有些人在女巫战争中并肩作战时就认识了。";
			mes "其中一人还是这个村子的首领！";
			mes "咦，他怎么还没来？";
			next;
			mes "[Rockha]";
			mes "总之，虽然社会地位变了，幸好我们还是朋友。";
			mes "不过和村子首领直呼名字，感觉有点奇怪。";
			next;
			mes "[Rockha]";
			mes "这让我觉得……";
			mes "自己很重要。毕竟我在和重要政治人物交往。";
			mes "朋友的人生际遇真奇妙……";
			close;
		}
		mes "[Rockha]";
		mes "我差点忘了和这些家伙一起玩有多开心。";
		mes "我们应该经常一起烧烤～";
		break;
	case 2:
		mes "[Rockha]";
		mes "Wha--? Tausupa can't come,";
		mes "但他还是送来了这么多科赛拉赛拉？真是个好人……";
		mes "我想……这给了我们";
		mes "很快再办一次烧烤的理由，对吧？";
		break;
	case 3:
		mes "[Rockha]";
		mes "嘿，把酒交给村长陶苏帕时，";
		mes "能告诉他我们很想念他吗？";
		mes "他也许很忙，但永远是我们无可替代的伙伴。";
		break;
	case 4:
		mes "[Rockha]";
		mes "哦，嘿，你见到陶苏帕了？";
		mes "他很忙真可惜，但听说他会喜欢我们的礼物，真好。好啦～该吃饭了！";
		next;
		mes "[Rockha]";
		mes "不过在那之前，先干杯……敬陶苏帕！";
		mes "科莫多守护者，也是最棒的朋友之一！干杯！哈哈哈哈哈～！";
		set dmdswrd_Q,5;
		next;
		mes "[Rockha]";
		mes "啊，你知道什么会让这顿饭完美吗？";
		mes "就是传说中的 ^3355FF科莫多奶酪^000000，";
		mes "我听 ^3355FF托鲁纳^000000 说过。也许不存在，但还是……！";
		break;
	default:
		mes "[Rockha]";
		mes "你真是个随和的人。谢谢你帮我们和老朋友村长保持联系。";
		mes "负责守护一定很辛苦……";
		next;
		mes "[Rockha]";
		mes "有两件事能让烧烤完美——村长在场，";
		mes "以及 ^3355FF托鲁纳^000000 告诉我的传说科莫多奶酪。";
		break;
	}
	close;
}

comodo,209,305,4	script	Camping Maiden#cmd	71,{
	mes "[Emralhandas]";
	mes "罗奇托，再给你倒一杯。";
	mes "女巫战争期间，我们一直梦想着这样的和平时光，大家一起欢聚～";
	next;
	if (select("女巫战争？:取消") == 1) {
		mes "";
		mes "";
		mes "";
		mes "";
		mes "";
		mes "";
		mes "";
		mes "";
		mes "";
		mes "";
		mes "";
		mes "";
		mes "";
		mes "";
		mes "";
		mes "";
		mes "";
		mes "";
		mes "";
		mes "";
		mes "在讲女巫战争前，我应该先说说";
		mes "寻找 4 把传说中最强大的";
		mes "力量之剑的任务。";
		mes "据说是世上最强大的武器。";
		next;
		mes "[Emralhandas]";
		mes "寻找开始 10 年后，4 把剑终于全部找到。";
		mes "随后选出 4 名守护者，确保宝剑不落入坏人手中。";
		next;
		mes "[Emralhandas]";
		mes "看我们可能想不到，但我们就是守护者——我、罗奇托和村长陶苏帕。";
		mes "我们非常小心地守护这些武器……";
		next;
		mes "[Emralhandas]";
		mes "然而，科莫多的古代女巫玛莉波萨姆仍攻击我们，试图偷走宝剑。";
		mes "她力量惊人，我们需要军队才能与她作战。";
		next;
		mes "[Emralhandas]";
		mes "这就是女巫战争。玛莉波萨姆用奇怪的大规模杀伤武器，";
		mes "对抗我们四人和勇敢士兵组成的大军。";
		next;
		mes "[Emralhandas]";
		mes "许多同伴牺牲了……";
		mes "但最终我们借助宝剑的力量囚禁了女巫。";
		mes "如果没有陶苏帕，我们绝不可能成功。";
		close;
	}
	mes "[Emralhandas]";
	mes "罗奇托，我们还有任务没完成：";
	mes "尽可能吃光所有烧烤！";
	mes "让我们吃个痛快……";
	mes "一直吃到明天！";
	close;
}


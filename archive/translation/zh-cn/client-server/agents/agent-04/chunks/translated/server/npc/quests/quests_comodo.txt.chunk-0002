			mes "能帮我们一个忙吗？";
			mes "科莫多首领本来要带";
			mes "科赛拉赛拉来";
			mes "和我们烧烤，但";
			mes "我们猜他必须";
			mes "因公务取消。";
			next;
			mes "[罗奇托]";
			mes "我们的首领住在";
			mes "营地西边。";
			mes "你能去见他，看看";
			mes "他为什么这么久";
			mes "还没过来吗？";

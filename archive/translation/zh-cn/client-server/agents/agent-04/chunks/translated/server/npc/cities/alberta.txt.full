alberta,97,51,0	script	Fabian	84,{
	mes "[法比安]";
	mes "伙计……当你周游世界时，总会听到一些疯狂的事。";
	next;
	mes "[法比安]";
	mes "我曾听说，有些卡片蕴含着怪物的力量。只要有人得到卡片，就能使用那只怪物的力量。";
	next;
	mes "[法比安]";
	mes "我猜这只是某种潮流或骗局，哄人去收集所有卡片。话说回来，一张卡片怎么可能真的拥有怪物的力量？！";
	next;
	mes "[法比安]";
	mes "真是的……";
	close;
}

alberta,53,39,0	script	Steiner	100,{
	mes "[斯坦纳]";
	mes "哦……！";
	mes "欢迎来到艾尔贝塔，";
	mes "年轻的冒险家！";
	next;
	mes "[斯坦纳]";
	mes "如果我看起来心不在焉，还请见谅。我正来回踱步，想制订一个计划。听说吉芬有家商店出售能够抵抗魔法的铠甲。";
	next;
	mes "[斯坦纳]";
	mes "如果我大量批发，再在这里以更高价格转卖……";
	close;
}

alberta_in,20,183,0	script	Chad	1_M_03,{
	mes "[查德]";
	mes "人们说传说中的武器冈格尼尔从不会射偏。我在想这会不会是真的……";
	next;
	mes "[查德]";
	mes "人们还说婴儿是鹳鸟组装好后送来的，女孩喜欢装混蛋的男人，而且圣诞老人真的存在！不过只在姜饼城。";
	next;
	mes "[查德]";
	mes "我在想……";
	mes "这些事情里";
	mes "是否有任何一件";
	mes "可能是真的……";
	close;
}

alberta,131,139,2	script	Drunken Old Man	1_M_JOBGUIDER,{
	mes "[迪格尔]";
	mes "^666666*打嗝*^000000";
	mes "你、你在";
	mes "看什么？滚开！！";
	next;
	switch(select("什么也不说。","不理他。")) {
	case 1:
		mes "[迪格尔]";
		mes "哈哈哈哈 ^666666*嗝*^000000……你胆子不小。我现在看起来也许一文不值，但我以前可是“欢乐玛丽号”上的水手。";
		next;
		switch(select("从没听说过。","真的？不是开玩笑吧！")) {
		case 1:
			mes "[迪格尔]";
			mes "从没听说过？！谁都知道臭名昭著的海盗船“欢乐玛丽号”！^666666*嗝~*^000000";
			next;
			mes "[迪格尔]";
			mes "啊~ 过去的日子。要是……要是我们没有遇到那场暴风雨……^666666*嗝*^000000";
			next;
			mes "[迪格尔]";
			mes "啊~ 船长。我最想念的就是我们的船长……没有敌人能在他的剑下幸存。";
			close;
		case 2:
			mes "[迪格尔]";
			mes "没错！没人能惹“欢乐玛丽号”的船员！也没人能在剑术对决中打败船长！";
			next;
			mes "[迪格尔]";
			mes "船长~！！！^666666*嗝~*^000000 他会像这样挥剑，然后……然后！！";
			next;
			mes "[迪格尔]";
			mes "那个与船长交战的混蛋，以及他附近的同伙，全都被火焰包围了！";
			next;
			mes "[迪格尔]";
			mes "伙计，那把剑一定拥有某种神秘力量，不然就是船长实在太厉害了……！";
			next;
			mes "[迪格尔]";
			mes "呼~~ ^666666*抽泣* *抽泣……*^000000 天啊，我好想大家！现在我难受极了！请你走开吧。";
			close;
		}
	case 2:
		mes "[迪格尔]";
		mes "没错！";
		mes "走开~";
		close;
	}
}

alberta,58,80,2	script	Shakir	99,{
	mes "[沙基尔]";
	if (rand(2)) {
		mes "我们商人在出售商品时有自己的议价技能。使用这项技能出售商品，能比其他人赚到更多钱。";
		next;
		mes "[沙基尔]";
		mes "这可不只是大喊“请多付点钱吧！”你必须有魅力，还要精通说服技巧！";
		next;
		mes "[沙基尔]";
		mes "凭借这项了不起的技能，我们最多能多赚24%的Zeny。但别忘了努力训练才能掌握它！！";
	} else {
		mes "我们商人可以";
		mes "摆设路边摊";
		mes "做生意。";
		next;
		mes "[沙基尔]";
		mes "借助折扣技能，我们能以很低的价格从城镇商店购买商品，再装进租来的手推车。";
		next;
		mes "[沙基尔]";
		mes "之后我们就能前往任何地方，出售商品赚取利润！";
		next;
		mes "[沙基尔]";
		mes "这样做生意既方便又安全。别睡着了，虽然确实很容易犯困。";
	}
	close;
}

alberta,62,156,2	script	Sonya	102,{
	mes "[索尼娅]";
	switch(rand(3)){
	case 0:
		mes "嘿，你知道吗？有一次我走过森林，看见一根小小的绿色茎秆在动。";
		next;
		mes "[索尼娅]";
		mes "我走过去想看清楚，还伸手碰了碰。那根茎竟然拍了我的手！";
		next;
		mes "[索尼娅]";
		mes "我吓得往后一跳，这才发现它根本不是茎秆，而是一只很小的动物。";
		next;
		mes "[索尼娅]";
		mes "幸好我没有激怒它。即使是最小的动物，生气时也可能很危险。";
		close;
	case 1:
		mes "你知道前往斐扬途中森林里那些懒洋洋的熊吗？";
		next;
		mes "[索尼娅]";
		mes "我一时贪玩朝它扔了块石头，它突然向我冲来！我怕得要命，转身就跑，然后砰的一声！！！";
		next;
		mes "[索尼娅]";
		mes "它撞上低垂的树枝，把自己撞晕了！我发誓再也不会为了好玩去招惹动物！";
		close;
	case 2:
		mes "我曾看见一群狼围攻一只又大又懒的熊！";
		next;
		mes "[索尼娅]";
		mes "狼群远比看起来更团结。只要其中一只受到攻击，附近的狼都会赶来帮忙。";
		next;
		mes "[索尼娅]";
		mes "如果附近还有同类，和其中一只交战前最好三思。小心别被围攻！";
		close;
	}
}

alberta,93,174,2	script	Grandmother Alma	103,{
	mes "[阿尔玛奶奶]";
	mes "一段时间以前，";
	mes "一艘废弃船只";
	mes "漂进了";
	mes "艾尔贝塔港口。";
	next;
	mes "[阿尔玛奶奶]";
	mes "一些镇民希望救出幸存者，冒险登上了船。然而，他们全都惊恐地逃了出来，说船里有尸体四处行走。";
	next;
	mes "[阿尔玛奶奶]";
	mes "船上还挤满了危险的海洋生物，即使想进去也做不到。";
	next;
	mes "[阿尔玛奶奶]";
	mes "我们拿那艘不祥的船毫无办法，只能任它停在那里。如今，探险队正尝试进入船内，清除其中的怪物。";
	next;
	mes "[阿尔玛奶奶]";
	mes "对你这样的年轻人来说，加入探险队或许是不错的经历。但如果实力不足，仍不值得为此冒生命危险。";
	close;
}

alberta,189,151,5	script	Fisk	4W_SAILOR,{
	mes "[菲斯克]";
	mes "嘿，伙计，";
	mes "你想";
	mes "去哪里？";
	next;
	switch(select("沉船 -> 250 Zeny。","伊斯鲁得码头 -> 500 Zeny。","算了。")) {
	case 1:
		if (Zeny < 250) {
			mes "[菲斯克]";
			mes "嘿，别想骗我！我说的是250 Zeny！";
			close;
		}
		Zeny = Zeny - 250;
		warp "alb2trea",43,53;
		end;
	case 2:
		if (Zeny < 500) {
			mes "[菲斯克]";
			mes "不先付500 Zeny，你哪儿也去不了！";
			close;
		}
		Zeny = Zeny - 500;
		if (checkre(0))
			warp "izlude",195,212;
		else
			warp "izlude",176,182;
		end;
	case 3:
		mes "[菲斯克]";
		mes "好吧……";
		mes "旱鸭子。";
		close;
	}
}

alb2trea,39,50,6	script	Fisk#a2t	4W_SAILOR,{
	mes "[菲斯克]";
	mes "你想返回艾尔贝塔大陆，对吧？";
	next;
	if (select("是的，麻烦了。","我改变主意了。") == 1)
		warp "alberta",192,169;
	close;
}

alberta,195,151,2	script	Paul	4_M_04,{
	mes "[保罗]";
	mes "你好~";
	mes "你愿意";
	mes "加入";
	mes "沉船的";
	mes "探险队吗？";
	next;
	mes "[保罗]";
	mes "哦！在加入之前，我必须警告你。如果你的实力不够强，最好不要前往。";
	next;
	mes "[保罗]";
	mes "那么，想";
	mes "报名吗？";
	mes "入场";
	mes "费用只需";
	mes "200 Zeny。";
	next;
	switch(select("我要报名！","呃，不用了。")) {
	case 1:
		if (Zeny < 200) {
			mes "[保罗]";
			mes "看来你没有足够的钱，朋友。等你能支付时再来吧。";
			close;
		}
		Zeny = Zeny - 200;
		warp "alb2trea",62,69;
		close;
	case 2:
		mes "[保罗]";
		mes "好吧……";
		mes "如果你";
		mes "改变主意，";
		mes "我会在这里。";
		close;
	}
}

alberta,190,173,4	script	Phelix	4_M_03,{
	mes "[菲利克斯]";
	if ((MaxWeight - Weight) < 10000) {
		mes "等一下！！";
		mes "你带的东西太多了！";
		mes "你无法再接收更多物品！";
		mes "请减少携带物品，";
		mes "然后再来找我。";
		close;
	}
	if (@event_zelopy == 0) {
		mes "你到底来这里做什么？";
		mes "这艘船上没有免费的东西，想要什么就得拿劳动来换！！";
		next;
		mes "[菲利克斯]";
		mes "嗯，给我10个杰勒比结晶，我就给你1瓶药水。怎么样？";
		mes "要是这对你这个软蛋来说太难，也可以用3个杰勒比结晶换1根胡萝卜。";
		next;
		mes "[菲利克斯]";
		mes "如果对我的提议感兴趣，就把我说的东西带来。";
		@event_zelopy = 1;
		close;
	}
	mes "嗯……你想用杰勒比结晶换红色药水或胡萝卜，对吧？那么……要哪一种？";
	next;
	switch(select("请给我红色药水。","请给我胡萝卜。")) {
	case 1:
		mes "[菲利克斯]";
		mes "好吧……";
		mes "让我看看";
		mes "你带来了什么……";
		next;
		mes "[菲利克斯]";
		if (countitem(909) < 10) {
			mes "嘿！你没听见吗？我说10个杰勒比结晶换1瓶红色药水……你聋了吗？";
			close;
		} else {
			.@max = countitem(909)/10;
			mes "嗯，还不错……";
			mes "你想换";
			mes "多少瓶药水？";
			next;
			switch(select("能换多少就换多少。","我想要指定数量。","算了，我喜欢自己的杰勒比结晶。")) {
			case 1:
				delitem 909,.@max*10;// Jellopy
				getitem 501,.@max;// Red_Potion
				break;
			case 2:
				mes "[菲利克斯]";
				mes "一次最多给你100瓶，别费劲了，明白吗？如果一瓶也不要，就输入“0”。";
				mes "你现在最多能换 " + .@max + " 瓶，但记住上限是100。你想累断我的腰吗？";
				input .@amount;
				next;
				mes "[菲利克斯]";
				if (.@amount <= 0) {
					mes "多谢惠顾，随时再来。";
					close;
				}
				if (.@amount > 100) {
					mes "嘿，我说什么来着？一次最多100瓶，你想累死我吗！";
					close;
				}
				if (countitem(909) < .@amount*10) {
					mes "嗯，看来你带得不够。还想从我这里换东西，就去拿更多杰勒比结晶。";
					close;
				}
				delitem 909,.@amount*10;// Jellopy
				getitem 501,.@amount;// Red_Potion
				break;
			case 3:
				mes "[菲利克斯]";
				mes "没问题，";
				mes "下次见。";
				close;
			}
			mes "[菲利克斯]";
			mes "给你！和我答应的一样。可别一次全喝光。";
			close;
		}
	case 2:
		mes "[菲利克斯]";
		mes "好吧，让我看看你带来了什么……";
		next;
		mes "[菲利克斯]";
		if (countitem(909) < 3) {
			mes "嗯，听好了，软蛋。我说3个杰勒比结晶换1根胡萝卜……明白吗？";
			close;
		}
		.@max = countitem(909)/3;
		mes "还不赖嘛，软蛋……";
		mes "你想要多少？";
		next;
		switch(select("能换多少就换多少。","我想要指定数量。","算了，我喜欢自己的杰勒比结晶。")) {
		case 1:
			delitem 909,.@max*3;// Jellopy
			getitem 515,.@max;// Carrot
			break;
		case 2:
			mes "[菲利克斯]";
			mes "没错，一次最多给你100根，别费劲了。如果一根也不要，就输入“0”。";
			input .@amount;
			next;
			mes "[菲利克斯]";
			if (.@amount == 0) {
				mes "好吧，下次见。";
				close;
			}
			if (.@amount > 100) {
				mes "嘿，软蛋！我说最多100根，不能再多！我可不会为了你累断腰！";
				close;
			}
			if (countitem(909) < .@amount*3) {
				mes "看来你带得不够。还想换东西，就再去拿一些来。";
				close;
			}
			delitem 909,.@amount*3;// Jellopy
			getitem 515,.@amount;// Carrot
			break;
		case 3:
			mes "[菲利克斯]";
			mes "回头见。";
			close;
		}
		mes "[菲利克斯]";
		mes "给你~！和我答应的一样。别一口气全塞进嘴里。";
		close;
	}
}

		next;
		switch(select("接受他的请求:拒绝他的请求")) {
		case 1:
			mes "[穆夫]";
			mes "非常感谢！";
			mes "请去和伊兹鲁德的发明家";
			mes "多里安交谈，请他";
			mes "恢复我的债券";
			mes "债务。我会在这里等你，";
			mes "好吗？";
			changequest 3102,3103;
			set diamond_edq,6;
			close;
		case 2:
			mes "[穆夫]";
			mes "真的吗？我本希望你继续";
			mes "帮助我，但是……好吧。";
			mes "";
			mes "你肯定还有其他问题。改变主意";
			mes "";
			mes "后就回来。";
			close;
		}
	}
	if ((diamond_edq > 5) && (diamond_edq < 13)) {
		mes "[穆夫]";
		mes "请去拜访";
		mes "伊兹鲁德的 ^FF0000发明家多里安^000000，";
		mes "请他使用他的";
		mes "魔法烘干机恢复";
		mes "我的债券债务？";
		close;
	}
	if ((diamond_edq == 13) && (countitem(7722) > 0)) {
		mes "[穆夫]";
		mes "你回来了！怎么样？";
		mes "进展如何？我很担心……";
		mes "那么多里安的魔法烘干机";
		mes "有用吗？";
		next;
		delitem 7722,1; //Debt_Note
		mes "[穆夫]";
		mes "哦！效果比我想象的好！";
		mes "贝尔德现在没法抱怨了！";
		mes "哈哈！";
		mes "你做得很好，朋友。";
		mes "请收下这些作为";
		mes "你帮助的微薄奖励。";
		completequest 3109;
		set diamond_edq,14;
		getitem 603,1; //Old_Blue_Box
		getitem 608,4; //Seed_Of_Yggdrasil
		next;
		mes "[穆夫]";
		mes "现在我有了债券";
		mes "应该从贝尔德那里拿回";
		mes "我的宝石。";
		mes "他再也没有借口";
		mes "扣留我的宝物！";
		close;
	}
	else if ((diamond_edq == 13) && (countitem(7722) < 1)) {
		mes "[穆夫]";
		mes "嘿、嘿！我的债券去哪了？";
		mes "别告诉我你弄丢了！";
		mes "";
		mes "你最好回去找";
		mes "多里安……希望你把它";
		mes "留在他那里！";
		set diamond_edq,10;
		close;
	}
	if (diamond_edq > 13) {
		mes "[穆夫]";
		mes "是的！终于";
		mes "我摆脱债务了！我拿回";
		mes "宝石，生意";
		mes "也很顺利……生活真美好。";
		mes "哈哈哈！";
		close;
	}
	mes "[穆夫]";
	mes "听我说：能不贷款就";
	mes "别贷款。若必须贷款，";
	mes "";
	mes "向比……更可靠的人借。";
	mes "";
	mes "好了，你知道我的故事。";
	mes "*叹气*";
	close;
}

alberta,127,143,3	script	Belder	85,{
	if (diamond_edq == 0) {
		mes "[Belder]";
			mes "我应该雇些兼职";
			mes "宣传人员……一些性感的";
			mes "女士应该能吸引顾客——哦！";
			mes "欢迎来到贝尔德贷款！";
		next;
			switch(select("我来宣传你的贷款！:呃……")) {
		case 1:
			if (Sex == SEX_MALE) {
				mes "[Belder]";
				mes "你？但你是个男人！";
				mes "贝尔德贷款不能让汗臭、邋遢的男人";
				mes "成为形象代言！我们需要";
				mes "散发信任、可靠，";
				mes "还要……女性魅力。";
				close;
			}
			else {
				mes "[Belder]";
				mes "你？别误会，";
				mes "但你的曲线都在";
				mes "不对的地方，亲爱的。回见！";
				close;
			}
		case 2:
			mes "[Belder]";
			mes "嘿，你不是对贷款";
			mes "感兴趣吗？来找我，";
			mes "总比依赖某个";
			mes "想敲诈你的人好！";
			close;
		}
	}
	if (diamond_edq < 13) {
		mes "[Belder]";
		mes "欢迎！需要快速拿钱吗？";
		mes "贝尔德贷款以低利率";
		mes "提供你需要的钱！";
		next;
		switch(select("询问 Muff")) {
		case 1:
			mes "[Belder]";
			mes "Muff？哦！那是";
			mes "一个名字吗？";
			mes "我还以为你说的是——不。";
			mes "不，完全没印象。";
			next;
			mes "[Belder]";
			mes "嗯？抵押品？";
			mes "如果我真的借了钱给他，";
			mes "为什么要拒绝收回？";
			mes "现在别烦我，这种谈话";
			mes "会影响生意！";
			close;
		}
	}
	if (diamond_edq > 12) {
		mes "[Belder]";
		mes "He really found his bond";
		mes "的债务？该死——我是说，";
		mes "真令人惊讶！那对他来说";
		mes "呃，真是太好了。";
		mes "现在想想，我确实";
		mes "曾借过钱给 Muff。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "......";
		next;
		mes "[Belder]";
		mes "你那副脏兮兮的表情是怎么回事？";
		mes "我没什么好隐藏的！";
		mes "你没看到我才是受害者吗？";
		mes "我才是！";
		mes "只是……趁我还没更生气，赶紧滚。";
		close;
	}
	mes "[Belder]";
	mes "欢迎！需要钱吗——哦。嘿，又是你这个好心人。";
	mes "做件好事，回你来的地方去。讨厌鬼。";
	close;

OnTouch_:
	if (diamond_edq < 3) {
		mes "[Belder]";
		mes "现金流有问题？";
		mes "我就是你的解决方案！";
		mes "全天候提供超低利率的";
		mes "无抵押贷款！";
		mes "贝尔德贷款是阿尔伯特最好的！";
		close;
	}
	end;
}

cmd_fild01,55,160,0	script	Heap of Earth	844,{
	if (diamond_edq == 1) {
		mes "^3355FF看起来有人在地上挖了个洞，";
		mes "然后又把它盖上了。^000000";
		next;
		switch(select("挖开这里:取消")) {
		case 1:
			mes "[" + strcharinfo(0) + "]";
			mes "地里一定有东西。";
			mes "我最好挖出来看看……";
			next;
			mes "[" + strcharinfo(0) + "]";
			mes "呃……！唉！";
			mes "要是有铲子会容易多了！";
			mes "再挖一点就好了……";
			next;
			mes "[" + strcharinfo(0) + "]";
			mes "嗯？我撞到什么了吗？";
			mes "让我看看——咦！好湿，而且——呃！";
			mes "真恶心的小东西。现在怎么办？";
			mes "我把它弄掉了！得再挖一次……";
			changequest 3100,3101;
			set diamond_edq,2;
			close;
		case 2:
			mes "[" + strcharinfo(0) + "]";
			mes "这一切有些不对劲。";
			mes "不，这次我不做了。";
			close;
		}
	}
	else if (diamond_edq == 2) {
		mes "[" + strcharinfo(0) + "]";
		mes "在这里……这是……";
		mes "一个湿透的钱包？这一定是 Muff 丢的。";
		mes "哦，债券债务在里面……嗯……";
		mes "呃，真的湿透了……";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "好了，我能做的都做了。";
		mes "该把这个带回给 Muff。";
		changequest 3101,3102;
		set diamond_edq,4;
		close;
	}
	if (diamond_edq > 3) {
		mes "[" + strcharinfo(0) + "]";
	mes "这里就是我之前挖过的地方。";
	mes "现在对我没用了！";
		close;
	}
	mes "[" + strcharinfo(0) + "]";
	mes "嗯。地面有个奇怪的隆起。";
	mes "好吧，我不能因为一点不寻常";
	mes "就去调查任何东西。嘿。";
	mes "我没那么奇怪。";
	close;
}

-	script	::Dorian_izlude	-1,{
	if (checkweight(907,200) == 0) {

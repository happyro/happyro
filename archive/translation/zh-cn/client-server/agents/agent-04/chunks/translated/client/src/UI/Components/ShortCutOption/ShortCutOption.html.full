			</div>
			<div class="content t_ui">
				<table border="1" cellspacing="0" bordercolor="#aaa">
					<tbody>
						<tr>
							<td>基本信息</td>
							<td data-button="BasicInfo" class="customize"></td>
							<td>角色信息</td>
							<td data-button="Equipment" class="customize"></td>
						</tr>
						<tr>
							<td>技能列表</td>
							<td data-button="SkillList" class="customize"></td>
							<td>表情列表</td>
							<td data-button="Emotions" class="customize"></td>
						</tr>
						<tr>
							<td>好友列表</td>
							<td data-button="Friends" class="customize"></td>
							<td>队伍窗口</td>
							<td data-button="Party" class="customize"></td>
						</tr>
						<tr>
							<td>宠物信息</td>
							<td data-button="PetInfo" class="customize"></td>
							<td>聊天室</td>
							<td data-button="ChatRoom" class="customize"></td>
						</tr>
						<tr>
							<td>手推车窗口</td>
							<td data-button="PushCart" class="customize"></td>
							<td>物品窗口</td>
							<td data-button="Inventory" class="customize"></td>
						</tr>
						<tr>
							<td>世界地图</td>
							<td data-button="WorldMap" class="customize"></td>
							<td>公会信息</td>
							<td data-button="Guild" class="customize"></td>
						</tr>
						<tr>
							<td>傀儡信息</td>
							<td data-button="HomunInfo" class="customize"></td>
							<td>佣兵信息</td>
							<td data-button="MercInfo" class="customize"></td>
						</tr>
						<tr>
							<td>傀儡状态</td>
							<td data-button="HomunState" class="customize"></td>
							<td>佣兵状态</td>
							<td data-button="MercState" class="customize"></td>
						</tr>
						<tr>
							<td>坐下/站立</td>
							<td data-button="Sit" class="customize"></td>
							<td>快捷键</td>
							<td data-button="ShortCuts" class="customize"></td>
						</tr>
						<tr>
							<td>聊天栏大小</td>
							<td data-button="ChatSize" class="customize"></td>
							<td>技能栏大小</td>
							<td data-button="SkillBarSize" class="customize"></td>
						</tr>
						<tr>
							<td>任务</td>
							<td data-button="Quest" class="customize"></td>
							<td>银行</td>
							<td data-button="Bank" class="customize"></td>
						</tr>
						<!--<tr>
                     <td>MobileUI</td>
                     <td data-button="M_UI" class="customize"></td>
                     <td>MUi-Toggle</td>
                     <td data-button="M_Toggle" class="customize"></td>
                  </tr>
                  <tr>
                     <td>MUi-TG</td>

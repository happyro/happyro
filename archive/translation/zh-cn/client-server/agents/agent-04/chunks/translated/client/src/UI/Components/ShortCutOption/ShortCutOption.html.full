			</div>
			<div class="content t_macro">
				<table border="1" cellspacing="0" bordercolor="#aaa">
					<tbody>
						<tr>
							<td>宏 1</td>
							<td data-button="Macro1" class="customize"></td>
							<td>标记 1</td>
							<td data-button="Flag1" class="customize"></td>
						</tr>
						<tr>
							<td>宏 2</td>
							<td data-button="Macro2" class="customize"></td>
							<td>标记 2</td>
							<td data-button="Flag2" class="customize"></td>
						</tr>
						<tr>
							<td>宏 3</td>
							<td data-button="Macro3" class="customize"></td>
							<td>标记 3</td>
							<td data-button="Flag3" class="customize"></td>
						</tr>
						<tr>
							<td>宏 4</td>
							<td data-button="Macro4" class="customize"></td>
							<td>标记 4</td>
							<td data-button="Flag4" class="customize"></td>
						</tr>
						<tr>
							<td>宏 5</td>
							<td data-button="Macro5" class="customize"></td>
							<td>标记 5</td>
							<td data-button="Flag5" class="customize"></td>
						</tr>
						<tr>
							<td>宏 6</td>
							<td data-button="Macro6" class="customize"></td>
							<td>标记 6</td>
							<td data-button="Flag6" class="customize"></td>
						</tr>
						<tr>
							<td>宏 7</td>
							<td data-button="Macro7" class="customize"></td>
							<td>标记 7</td>
							<td data-button="Flag7" class="customize"></td>
						</tr>
						<tr>
							<td>宏 8</td>
							<td data-button="Macro8" class="customize"></td>
							<td>标记 8</td>
							<td data-button="Flag8" class="customize"></td>
						</tr>
						<tr>
							<td>宏 9</td>
							<td data-button="Macro9" class="customize"></td>
							<td>标记 9</td>
							<td data-button="Flag9" class="customize"></td>
						</tr>
						<tr>
							<td>宏 10</td>
							<td data-button="Macro10" class="customize"></td>
						</tr>
					</tbody>
				</table>
			</div>
			<div class="content t_gamepad">
				<table border="1" cellspacing="0" bordercolor="#aaa">
					<tbody>
						<tr title="Define how targets are selected in combat">
							<td>攻击目标模式</td>
							<td>
								<select class="attackTargetMode">
									<option value="0">关闭</option>
									<option value="1">最低 HP</option>
									<option value="2">最近</option>
								</select>
							</td>
						</tr>
						<tr title="Choose how skills are cast with gamepad">
							<td>快速施法模式</td>
							<td>
								<select class="joyQuick">
									<option value="0">关闭</option>
									<option value="1">释放模式</option>
									<option value="2">即时模式</option>
								</select>
							</td>
						</tr>
						<tr title="Adjust mouse movement sensitivity for R3 stick">
							<td>鼠标移动</td>
							<td>
								<label style="display: inline-block; width: 90px">
									灵敏度：
									<input
										class="joySense"
										type="range"
										value="25.0"
										min="1.0"
										max="100.0"
										step="1.0"
										style="width: 90%; vertical-align: middle"
									/>
								</label>
							</td>
						</tr>
						<tr title="Disable mouse input from gamepad for UI interaction">
							<td>禁用虚拟鼠标</td>
							<td>
								<input type="checkbox" class="joyDisableVirtualMouse" />
							</td>
						</tr>
						<tr title="Swap L3 and R3 stick functions">
							<td>交换 L3-R3 摇杆</td>
							<td>
								<input type="checkbox" class="joyReverseStick" />
							</td>
						</tr>
						<tr title="Automatically hide UI during gameplay mouse movement">
							<td>自动隐藏界面</td>
							<td>
								<input type="checkbox" class="joyAutoHide" />
							</td>
						</tr>
						<tr title="Set deadzone threshold for analog sticks">
							<td>轴阈值</td>
							<td>
								<label style="display: inline-block; width: 90px">
									死区：
									<input
										class="joyDeadline"
										type="range"
										value="0.10"
										min="0.0"
										max="1.0"
										step="0.1"
										style="width: 90%; vertical-align: middle"
									/>
								</label>
							</td>
						</tr>
					</tbody>
				</table>
			</div>
			<button
				class="button reset left"
				data-background="btn_reset.bmp"
				data-hover="btn_reset_a.bmp"
				data-down="btn_reset_b.bmp"
			></button>
			<button
				class="button ok right"
				data-background="btn_ok.bmp"
				data-hover="btn_ok_a.bmp"
				data-down="btn_ok_b.bmp"
			></button>
			<button
				class="button cancel right"
				data-background="btn_cancel.bmp"
				data-hover="btn_cancel_a.bmp"
				data-down="btn_cancel_b.bmp"
			></button>
			<button
				class="button close right"
				data-background="btn_close.bmp"
				data-hover="btn_close_a.bmp"
				data-down="btn_close_b.bmp"
			></button>
		</div>
	</div>
</div>

<div id="ShortCutOption" class="pt-page-fadeIn1">
	<div class="border">
		<div class="titlebar" data-background="basic_interface/titlebar_mid.bmp">
			<div class="left"><span class="text">快捷键设置窗口</span></div>

			<div class="right">
				<button
					class="base close"

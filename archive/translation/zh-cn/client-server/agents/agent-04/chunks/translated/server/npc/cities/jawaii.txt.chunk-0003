// Izlude
//============================================================
-	script	::Honeymoon_Helper_Izlude	-1,{
	mes "[Helper]";
	mes "新婚夫妻和";
	mes "长期伴侣……";
	mes "欢迎来到婚礼度假胜地";
	mes "Jawaii！";
	next;
	switch(select("Jawaii？:去Jawaii吧～！:取消。")) {
	case 1:
		mes "[Helper]";
		mes "米德加尔特大陆遥远的地方有一座岛。";
		mes "那是安静美丽的岛屿度假村，只向情侣";
		mes "敞开大门。";
		next;
		mes "[Helper]";
		mes "这是面向米德加尔特居民的蜜月度假村专属旅行。价格是 100,000 Zeny，可能很贵，但绝对物有所值。";
		next;
		mes "[Helper]";
		mes "我保证，婚姻中最幸福的时刻";
		mes "有些会发生在这座岛上。";
		mes "这种体验真的能用钱衡量吗？";
		close;

	case 2:
		mes "[Helper]";
		if (!getpartnerid()) {
			mes "呃……";
			mes "很遗憾，单身者不能登岛。你不如去普隆德拉酒馆忘掉孤独吧？";
			close;
		}
		else if (Zeny > 99999) {
			set Zeny, Zeny-100000;
			mes "一路顺风……！！";
			mes "让我带你";
			mes "前往‘Jawaii’！";
			close2;
			warp "jawaii",245,125;
			end;
		}
		mes "正如我所说，访问 Jawaii 必须拥有 100,000 Zeny。你不如请伴侣帮忙凑齐旅费？";
		close;

	case 3:
		mes "[Helper]";
		mes "没有什么比和爱人一起分享特别而私密的时光更好，";
		mes "比如秘密前往遥远而异国情调的地方。";
		next;
		mes "[Helper]";
		mes "Jawaii 之旅很可能是你能送给爱人最棒的礼物～";
		close;
	}
}

		case 2:
			callsub S_KillChar,2,.@roof_jaw;
			mes "想让自己看起来超级酷？这杯酒最适合你。它很烈，还有独特香气，喝枪手酒的人通常都被认为品味非凡。";
			next;
			mes "^3355FF你接过一只装着灰色液体的普通玻璃杯。它闻起来有淡淡甜味，看起来却像工业级烈酒。鼓起勇气喝一口吧～";
			next;
			mes "[Bartender]";
			mes "这杯酒苦中带甜，就像人生。用舌头慢慢品尝，别一口气喝完。";
			next;
			mes "^3355FF你慢慢喝了一些";
			mes "枪手酒。^000000";
			next;
			mes "["+strcharinfo(0)+"]";
			mes "耶呼～！";
			mes "我是牛仔英雄！";
			mes "砰砰砰！";
			next;
			specialeffect2 EF_STEAL;
			percentheal -10,0;
			next;
			break;

		case 3:
			callsub S_KillChar,2,.@roof_jaw;
			mes "据说混合可波酒喝得越多越好喝。它会让你渐渐喜欢上，就像老朋友的陪伴。这是随时都适合和任何人一起喝的美酒。";
			next;
			mes "^3355FF酒保端来一只精美雕花玻璃杯，里面是钴蓝色液体，放在你面前。闻起来酸甜怡人。";
			next;
			mes "[Bartender]";
			mes "尝过一次后，你几乎停不下来。它口感顺滑，";
			mes "喝起来更加顺畅。";
			next;
			mes "^3355FF你分三口";
			mes "喝完了酒。";
			mes "口中充满奢华的";
			mes "酸甜味道。^000000";
			next;
			mes "["+strcharinfo(0)+"]";
			mes "啊啊啊啊～！";
			mes "这酒真好喝！";
			specialeffect2 EF_SANCTUARY;
			percentheal -10,0;
			next;
			break;
			
case 4:
		callsub S_KillChar,2,.@roof_jaw;
			mes "这杯酒适合想重温狂野青春、向为正义与自由战斗的人致敬，或只是想喝到吐胃酸的人。";
			mes "也适合想起为自由战斗的人……";
			next;
			mes "^3355FF你接过一杯装满棕色液体的平底杯。它有浓烈的机械气味，让你想起火药。^000000";
			next;
			mes "[Bartender]";
			mes "看起来一口喝完似乎太多了，但我建议你一口气喝完。慢慢喝的话会昏倒。";
			next;
			mes "^3355FF你紧紧抓住平底杯，";
			mes "然后一口灌了下去。^000000";
			next;
			mes "^3355FF你感觉醉得不轻。^000000";
			specialeffect2 EF_BLASTMINEBOMB;
			percentheal -10,0;
			next;
			break;
			
			case 5:
callsub S_KillChar,1,.@roof_jaw;
		mes "喜欢这杯酒的人不多，但喜欢的人都爱不释手。";
			next;
			mes "[Bartender]";
			mes "虽然它颜色漂亮诱人，但外表可能会骗人。大多数人喝下后都会感到";
			mes "寒冷而空虚。";
			next;
			mes "^3355FF你接过一只装满紫色液体的歪玻璃杯。虽然闻起来很香，但靠近脸时却感到奇怪的厌恶。";
			next;
			mes "[Bartender]";
			mes "不想喝的话现在就告诉我。不过为了体验一下，试一次也不错。";
			next;
			mes "^3355FF你喝了一口，叹了口气。^000000";
			next;
			mes "^3355FF并对自己发誓再也不喝第二次。^000000";
			specialeffect2 EF_HIT6;
			percentheal -10,0;
			next;
			break;
			}
			
			mes "["+strcharinfo(0)+"]";
		mes "老板……";
mes "再来一杯……";
		next;
		}
		end;
		
	S_KillChar:
	.@roof_jaw = getarg(1);
if (.@roof_jaw > 8) {
mes "[Bartender]";
	mes "算我的。";
	next;
		mes "["+strcharinfo(0)+"]";
		mes "谢谢……";
		mes "酒保先生……";
		close2;
		percentheal -100,0;
		end;
		}
		if (Zeny > 99) set Zeny, Zeny-100;
		set .@roof_jaw,.@roof_jaw+getarg(0);
	mes "[Bartender]";
	mes "给你。";
	next;
	mes "[Bartender]";
	return;
	}

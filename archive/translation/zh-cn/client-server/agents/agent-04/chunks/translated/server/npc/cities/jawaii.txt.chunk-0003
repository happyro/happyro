	//
		//
			
			jawaii_in,43,115,0	script	Customer#jaw_1	97,{
			mes "[Buchi]";
			if (!getpartnerid()) {
			if (Zeny > 99) {
			mes "咕噜……";
			mes "可恶！我不喜欢这里！";
			mes "一点也不喜欢！";
			next;
			mes "[Buchi]";
			mes "真不敢相信自己的眼睛！其他人看起来都幸福得令人作呕！这让我太难受了！";
			mes "你也同意吧？！";
			next;
			mes "[Buchi]";
		mes "咕噜……";
		mes "酒保！";
		mes "再给我一杯！";
		close;
		}
		mes "喂，你为什么不喝？";
		mes "我猜你已经没钱了。";
		mes "不过我懂你的感受。这里到处都是卿卿我我，很恶心吧？";
		next;
		mes "[Buchi]";
		mes "嘿。";
		mes "让我请你";
		mes "喝一杯！";
		next;
		mes "[Buchi]";
		mes "一口喝下去，忘掉悲惨的人生！振作起来，前方还有整个未来，面前还有一杯酒！来吧～！";
		next;
		mes "^3355FF他为我点了一杯 JJ 特调。^000000";
		next;
		mes "["+ strcharinfo(0) +"]";
		mes "可恶……！";
		mes "可恶！笑到最后的";
		mes "一定是我！";
		next;
	mes "^3355FF你喝了个痛快。^000000";
	close2;
	percentheal -100,0;
	end;
	}
	mes "你看起来很幸福……";
	mes "希望你永远";
	mes "都能保持这种";
mes "感觉……";
mes " ";
mes "^666666*Hiccup...!*^000000";
	close;
	}
		
		jawaii_in,41,106,3	script	Customer#Cage	98,{
		mes "[Cage]";
		if (getpartnerid()) {
		mes "……呸！";
		mes "你有什么好高兴的？";
			mes "大家都知道婚姻只是绝望孤独之人的骗局！";
			next;
			mes "[Cage]";
			if (Sex == SEX_MALE) {
			mes "我谁都不信！";
			mes "把自己一生拴在漂亮女人身上，";
		mes "你就是个傻瓜！";
		mes "听见了吗？！";
			mes "大傻瓜！";
			}
			else {
			mes "看看你！";
			mes "把自己一生拴在";
		mes "漂亮男孩身上，";
		mes "你就是个傻瓜！";
		mes "听见了吗？！大傻瓜！";
		}
		next;
		mes "[Cage]";
		mes "单身生活才是一切！";
		mes "女人也许能击垮我的精神，";
		mes "但她们永远夺不走……";
	mes "我的自由！";
	close;
	}
	mes "喝吧，喝吧……！！";
	mes "吃吧，吃吧……！！";
	mes "加入我吧，";
	mes "单身的兄弟！";
	next;
	mes "[Cage]";
	mes "我们自由了……！";
	mes "我们摆脱了";
	mes "婚姻的地狱……！";
	mes "我们是诚实又";
	mes "能干的单身者……！";
close;
}

// Inside Prontera
//============================================================
	prt_in,173,13,4	script	Customer#SoloHan	86,{
	mes "[SoloHan]";
		if (!getpartnerid()) {
		mes "天哪……";
		mes "我好像醉了～";
		mes "^666666*Hiccup...!*^000000";
		next;
		mes "[SoloHan]";
		mes "喂，你……！";
		mes "你能理解吧？！";
		mes "看到这些幸福的夫妻，你不生气吗？！";
		mes "对吧～？我也是！";
		next;
		mes "[SoloHan]";
		mes "他们竟敢在我们面前炫耀幸福——！！^666666*抽泣*^000000 只因为找到了永恒的爱情，就以为比我们高贵？！";
		next;
		mes "[SoloHan]";
		mes "我记得以前情侣很有礼貌，只在关起门来卿卿我我。现在他们在公共场合牵手，甚至拥抱。拜托！找个房间去！";
		next;
		mes "[SoloHan]";
		mes "我是说，^666666*抽泣*^000000，我才不是";
		mes "孤独什么的。我才不需——要女人～！";
		mes "对吧，巴丘卡！";
		next;
		mes "[Bachewcca]";
		mes "...!";
		emotion ET_BEST, getnpcid(0, "Customer#Bachewcca");
		next;
		mes "[SoloHan]";
		mes "结没结婚其实无所谓，";
		mes "对吧，伙计？对吧？！";
		mes "来！和我喝一杯！！";
		next;
		mes "^3355FF他突然把我当成了亲密朋友。虽然有点尴尬，但接受";
		mes "一杯免费饮料……^000000";
		next;
		mes "^3355FF* Gulp Gulp Gulp *^000000";
		percentheal -10,0;
		next;
		mes "[SoloHan]";
		mes "怎么样？";
		mes "我们去找个地方";
		mes "喝真正的酒吧。";
			while(1) {
			next;
				if (select("……再来一杯。:……这是个什么地方？") == 1) {
				mes "[SoloHan]";
				mes "好～！";
				mes "这才对嘛！";
				mes "喂，巴丘卡……";
				mes "我们喝吧！";
				next;
				mes "[Bachewcca]";
				mes "^666666*Grunt!*^000000";
				specialeffect EF_TALK_SCREAM,AREA,"Customer#Bachewcca";
				next;
				mes "[SoloHan]";
				mes "为了……";
				mes "为了单身！";
				mes "永、永远！！！";
				next;
				mes "^3355FF* Gulp Gulp Gulp *^000000";
				percentheal -10,0;
				next;
				set .@jaw_roof,.@jaw_roof+2;
				mes "[SoloHan]";
					if (.@jaw_roof > 8) {
					mes "哇……";
					mes "你没事吧？";
					mes "你好像有点醉了……";
					next;
					mes "[SoloHan]";
					mes "现在正好让你签这个！别担心，我会直接送你去天堂！";
					next;
						if (select("签名:拒绝签名") == 1) {
						mes "[SoloHan]";
						mes "好！";
						mes "保重！";
						mes "哈哈哈！";
						close2;
						percentheal 100,0;
					break;
					}
					mes "[SoloHan]";
					mes "哦……";
					mes "天哪。";
					mes "所以你总是这样";
					mes "破坏聚会吗？";
				close;
			}
			}
				if (.@jaw_roof > 6) {
				mes "[SoloHan]";
				mes "^666666*Hiccup!*^000000";
				mes "想找点真正的";
				mes "乐子吗？那就在这里签字。放心，我会送你去天堂。";
				next;
					if (select("签名:拒绝签名") == 1) {
					mes "[SoloHan]";
					mes "好～！";
					mes "保重，玩得开心！";
					mes "替我去骚扰那边的情侣，好吗？";
					close2;
					percentheal 100,0;
				break;
				}
				mes "[SoloHan]";
				mes "哦……";
				mes "天哪。";
				mes "难怪你单身。快乐就在眼前，你都认不出来。";
			close;
			}
			set .@jaw_roof,.@jaw_roof+3;
			mes "[SoloHan]";
			mes "喝，喝！";
			mes "这还不够！";
			mes "再喝点，伙计！";
			next;
			mes "[SoloHan]";
			mes "为了……";
			mes "为了单身！";
			mes "永远。";
			next;
			mes "^3355FF*Gulp Gulp Gulp*^000000";
			percentheal -10,0;
		next;
		}
		warp "jawaii_in",44,124;
	end;
	}
		else if (getpartnerid()) {
		mes "天哪……";
		mes "我好像醉了～";
		mes "*Hiccup!*";
		next;
		mes "[SoloHan]";
		mes "...Wha!?";
		mes "天哪！";
		mes "别在我面前晃！";
			if (Sex == SEX_MALE) {
			mes "你闻起来像";
			mes "被揍过的男朋友";
		mes "什么的！";
		}
			else {
			next;
			mes "[SoloHan]";
			mes "我一眼就能认出唠叨的妻子！";
			mes "去管好你的丈夫吧！";
		}
		next;
		mes "[SoloHan]";
		mes "别烦我！";
		mes "我可不想沾上你们的婚姻幸福。来，巴丘卡！告诉他们这里不欢迎这种人！";
		next;
		mes "[Bachewcca]";
		mes "^666666*Grrr...!*^000000";
		specialeffect EF_THROWITEM,AREA,"Customer#Bachewcca";
		close;
	}
	mes "天哪……";
	mes "我好像醉了～";
	mes "^666666*Hiccup!*^000000";
	next;
	mes "[SoloHan]";
	mes "那是什么……？";
	mes "这是我这周第三次喝醉了吗？巴丘卡，帮我数数！";
	close;
}

prt_in,170,14,0	script	Customer#Bachewcca	89,{
	mes "[Bachewcca]";
	mes "..............";
	mes "^666666*Gulp....gulp...*^000000";

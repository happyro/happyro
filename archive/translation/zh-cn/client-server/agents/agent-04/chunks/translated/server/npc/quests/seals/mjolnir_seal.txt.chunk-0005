}

mjolnir_12,18,18,7	script	Dwarf Blacksmith#north	826,{
	if ($God3 < $@god_check1) {
		mes "[诺德里]";
		mes "什么……？我没有任何铝或神之金属！";
		next;
		mes "[诺德里]";
		mes "维斯特里把它们全拿走了。^333333*叹气*^000000那些可是我的宝贝……";
		close;
	}
	else {
		if ($God4 >= $@god_check2) {
			mes "[诺德里]";
		mes "发生什么了？我感觉风中有变化，但说不清是什么变化。";
			next;
			mes "[诺德里]";
		mes "我该进洞看看吗？嗯，这真奇怪。";
			close;
		}
		else if (god_mjo_0 == 11) {
			mes "[诺德里]";
		mes "哇哈哈哈！连诸神都知道我们矮人是最有天赋的工匠！也许现在看不出来，但总有一天我们会归来。";
			close;
		}
		else if (god_mjo_0 == 10) {
			mes "[诺德里]";
			mes "什么……？我没有任何铝或神之金属！";
			next;
			mes "[诺德里]";
			mes "维斯特里把它们全拿走了。你还不明白吗？";
			close;
		}
		else if (god_mjo_0 == 1) {
			if ((god_mjo_1 == 3) || (god_mjo_2 == 3) || (god_mjo_3 == 3) || (god_mjo_4 == 3)){
				mes "[诺德里]";
				mes "嘿嘿嘿～";
				mes "待在妙尔尼尔森林真好。被安静和平的空气包围，不用担心任何事……";
				close;
			}
			else if (god_mjo_4 == 2) {
				mes "[诺德里]";
				mes "你现在不是该上路了吗？算了，不关我的事。";
				next;
				mes "[诺德里]";
				mes "如果你有多余的 Zeny，为什么不买些旅行零食？比如美味的香蕉，或者南瓜……";
				close;
			}
			else if ((god_mjo_1 == 0) || (god_mjo_1 == 1) || (god_mjo_2 == 0) || (god_mjo_2 == 1) || (god_mjo_3 == 0) || (god_mjo_3 == 1)){
				mes "[诺德里]";
				mes "人类，你找我有什么事？";
				next;
				switch(select("没什么:打扰了。")) {
				case 1:
					mes "[诺德里]";
					mes "哼。既然如此，就别来烦我。";
					close;
				case 2:
					set god_mjo_4,3;
					mes "[诺德里]";
					mes "哼。没关系。不过……";
					mes "我很惊讶竟然有人类如此有礼貌。";
					close;
				}
			}
			else if (god_mjo_4 == 1) {
				if (countitem(501) > 0) {
					delitem 501,1;  //Red_Potion
					mes "[诺德里]";
					mes "啊，你带来了我要求的红色药水。";
					mes "作为回报，我告诉你一个古老故事。";
					mes "我相信你会喜欢。";
					next;
					while(1) {
						if (.@talk_to == 0) {
							mes "[诺德里]";
							mes "这是托尔前往巨人之地乌特加德的一次旅程的传说。";
							next;
							mes "[诺德里]";
							mes "在那里，他与巨人国王打赌，要在技巧和力量的比赛中挑战当地巨人。";
							next;
							mes "[诺德里]";
							mes "第一场是吃东西比赛。托尔吃光了桌上的肉，但对手乌特加德洛基连肉、骨头甚至盘子都吃了。";
							next;
							mes "[诺德里]";
							mes "实际上托尔被骗了，击败他的对手并不是巨人。幻术伪装了对手，但我忘了它究竟是什么。你知道吗？";
							next;
							switch(select("贪婪:大海:火焰:野猪")) {
							default:
								set .@talk_not,1;
								break;
							case 3:
								break;
							}
						}
						else if (.@talk_to == 1) {
							mes "[诺德里]";
							mes "没错，只有火焰能通过燃烧轻松吞噬肉、骨头甚至盘子！";
							mes "我想起来了！";
							next;
							mes "[诺德里]";
							mes "下一场比赛是赛跑。托尔的仆人提亚尔菲与国王的仆人胡吉比赛，但无论比多少次，胡吉每次都会获胜。";
							next;
							mes "[诺德里]";
							mes "又是幻术伪装了竞争者。你知道提亚尔菲实际上是在和什么赛跑吗？";
							next;
							switch(select("语言:思想:乌龟:狼")) {
							default:
								set .@talk_not,1;
								break;
							case 2:
								break;
							}
						}
						else if (.@talk_to == 2) {
							mes "[诺德里]";
							mes "对，没错！提亚尔菲是在和‘思想’赛跑！没有什么比思想更快，所以他总是输也不奇怪。";
							next;
							mes "[诺德里]";
							mes "最后一场比赛，托尔要和一位老妇人摔跤。起初他以为胜券在握，却发现自己无法击败那个老太婆。";
							next;
							mes "[诺德里]";
							mes "";
							mes "";
							mes "";
							mes "";
							mes "";
							mes "";
							mes "";
							mes "";
							mes "";
							mes "";
							mes "";
							mes "";
							mes "";
							mes "";
							mes "";
							mes "";
							mes "";
							mes "";
							mes "";
							mes "";
							mes "";
							mes "";
							mes "";
							mes "";
							mes "";
							mes "";
							mes "";
							mes "";
							mes "";
							mes "";

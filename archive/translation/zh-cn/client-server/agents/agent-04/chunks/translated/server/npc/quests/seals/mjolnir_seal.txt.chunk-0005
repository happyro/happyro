				mes "都要全心投入。";
				close;
			}
			else if (god_mjo_1 == 0 || god_mjo_1 == 1 || god_mjo_3 != 0 || god_mjo_4 != 0) {
				mes "[维斯特里]";
				mes "你想要什么？";
				next;
				switch(select("没什么:打扰了。")) {
				case 1:
					mes "[维斯特里]";
					mes "想要东西就靠自己的努力获得。";
					next;
					mes "[维斯特里]";
					mes "无论别人说什么，只要自信且意志坚定，你总会对结果满意。";
					close;
				
				case 2:
					set god_mjo_2,3;
					mes "[维斯特里]";
					mes "你没有回答问题！看来你找错矮人了……";
					next;
					mes "[维斯特里]";
					mes "滚出去！想升级装备就去找你们人类铁匠！";
					close;
				}
			}
			else if (god_mjo_2 == 1) {
				disable_items;
				mes "[维斯特里]";
				mes "太好了……！";
				mes "我该先升级哪一件？真令人期待……";
				next;

				setarray .@indices[1], EQI_HEAD_TOP, EQI_ARMOR, EQI_HAND_L, EQI_HAND_R, EQI_GARMENT, EQI_SHOES, EQI_ACC_L, EQI_ACC_R, EQI_HEAD_MID, EQI_HEAD_LOW;
				for(set .@i,1; .@i <= 10; set .@i,.@i+1) {
					if (getequipisequiped(.@indices[.@i]))
						set .@menu$, .@menu$ + F_getpositionname(.@indices[.@i]) + "-[" + getequipname(.@indices[.@i]) + "]";
					set .@menu$, .@menu$ + ":";
				}
				set .@part, .@indices[ select(.@menu$) ];

				if (getequipisequiped(.@part) == 0)
					close;

				if (getequipisenableref(.@part) == 0) {
					mes "[维斯特里]";
					mes "什么……？！这件物品不能升级！";
					mes "你到底想让我拿它怎么办？";
					close;
				}
				.@equip_id = getequipid(.@part);
				.@itemtype = getiteminfo( .@equip_id, ITEMINFO_TYPE );
				.@equip_refine = getequiprefinerycnt(.@part);
				setarray .@card[0], getequipcardid(.@part,0), getequipcardid(.@part,1), getequipcardid(.@part,2), getequipcardid(.@part,3);
				if (.@equip_refine >= 10) {
					mes "[维斯特里]";
					mes "哦，太棒了！这件装备已经完美精炼！但这不是我想要的，我完全没法处理它。";
					close;
				}
				if (GetEquipPercentRefinery(.@part) == 100) {
					mes "[维斯特里]";
					mes "这件物品升级起来毫无挑战。让人类先处理这种初级工作吧。";
					next;
					mes "[维斯特里]";
					mes "来吧……带一件有风险的东西给我！";
					close;
				}
				if( .@itemtype != IT_WEAPON ){
					mes "[维斯特里]";
					mes "铠甲？！我不是告诉过你，我只处理四级武器吗？";
					close;
				}
				if( getequipweaponlv( .@part ) != 4 ){
					mes "[维斯特里]";
					mes "嘿……";
					mes "别指望我处理低于四级的武器，那是对我的侮辱。";
					next;
					mes "[维斯特里]";
					mes "下次带四级武器来，明白吗？";
					close;
				}
				mes "[维斯特里]";
				mes "好，先警告你：武器若在升级中毁坏，就再也找不回。";
				next;
				mes "[维斯特里]";
				mes "这也意味着武器中的 ^FF0000卡片^000000 会一起消失。";
				next;
				mes "[维斯特里]";
				mes "明白的话，";
				mes "我们开始吧！";
				next;
				if(select("好，我们开始吧！:不，我退出。") == 2) {
					mes "[维斯特里]";
					mes "呸……！";
					mes "你这么胆小，";
					mes "怎么在这个世界生存？";
					mes "";
					next;
					mes "[维斯特里]";
					mes "算了。";
					mes "我知道你只是谨慎。该死，我太想";
					mes "工作了！";
					close;
				}
				if (countitem(984) > 0) {
					delitem 984,1; //Oridecon
				}
				else {
					mes "[维斯特里]";
					mes "嗯……";
					mes "你忘了带";
					mes "神之金属。";
					mes "快去拿一个。";
					close;
				}
				// anti-hack
				if (callfunc("F_IsEquipIDHack", .@part, .@equip_id) || callfunc("F_IsEquipCardHack", .@part, .@card[0], .@card[1], .@card[2], .@card[3]) || callfunc("F_IsEquipRefineHack", .@part, .@equip_refine))
					close;

				if (getequippercentrefinery(.@part) > rand(100)) {
					mes "^3355FF*铿锵铿锵！*^000000";
					successrefitem .@part;
					next;
					emotion ET_SMILE;
					mes "[维斯特里]";
					mes "哇哈哈哈～";
					mes "我还没老！";
					mes "你不为更强的";
					mes "武器";
					mes "高兴吗？";
					next;
				}
				else {
					mes "[维斯特里]";
					mes "^3355FF*铿锵铿锵！*^000000";
					failedrefitem .@part;
					next;
					emotion ET_HUK;
					mes "[维斯特里]";
					mes "哇啊啊啊！";
					mes "天啊，不！";
					next;
					mes "[维斯特里]";
					mes "没、没关系！";
					mes "坏事有时会发生。";
					mes "就当我们";
					mes "今天都";
					mes "走背运。";
					mes "对，不后悔！";
					next;
				}
				set god_mjo_2,2;
				mes "[维斯特里]";
				mes "朋友，";
				mes "以后见到我兄弟，替我问好。";
				mes "保重。";
				close;
			}
			else if (god_mjo_2 == 0) {
				mes "[维斯特里]";
				mes "你想要什么？";
				next;
				switch(select("没什么:打扰了。")) {
				case 1:
					mes "[维斯特里]";
					mes "想要东西就靠自己的努力获得。";
					next;
					mes "[维斯特里]";
					mes "无论别人说什么，只要自信且意志坚定，你总会对结果满意。";
					close;
				case 2:
					mes "[维斯特里]";
					mes "嗯……";
					mes "除了铁匠工作，我不知道还能怎样帮助你这样的冒险者……";
					next;
					mes "[维斯特里]";
					mes "我最喜欢把濒临损坏的高级武器升级。";
					next;
					mes "[维斯特里]";
					mes "你不喜欢挑战极限吗？对我来说，升级武器就像攀登未征服的高山！";
					next;
					mes "[维斯特里]";
					mes "好吧，也许我注定要帮助你。我会替你升级武器。你只需带来武器和材料。";
					next;
					set god_mjo_2,1;
					mes "[维斯特里]";
					mes "条件是：带来一把已经升级到可能损坏程度的四级武器。还有，带一块神之金属！";
					close;
				}
			}
			else {
				mes "[维斯特里]";
				mes "呼呼……呼呼……";
				close;
			}
		}
		else if (god_mjo_0 == 0) {
			mes "[维斯特里]";
			mes "投入辛苦的工作总是令人愉快，尤其是锻造。";
			next;
			mes "[维斯特里]";
			mes "升级武器总是很有趣！";
			mes "失败时我不会后悔，成功时我总是开心。每天升级武器，尽情享受生活～";
			close;
		}
		else {
			mes "[维斯特里]";
			mes "呼呼……呼呼……";
			close;
		}

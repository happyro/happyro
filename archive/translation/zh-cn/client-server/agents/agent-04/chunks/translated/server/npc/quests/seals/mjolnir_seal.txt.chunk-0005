					mes "嘿……";
					mes "别指望我处理低于四级的武器，那是对我的侮辱。";
					next;
					mes "[维斯特里]";
					mes "下次带四级武器来，明白吗？";
					close;
				}

				mes "[维斯特里]";
				mes "好，先警告你：武器若在升级中毁坏，就再也找不回。";
				next;
				mes "[维斯特里]";
				mes "这也意味着武器中的 ^FF0000卡片^000000 会一起消失。";
				next;
				mes "[维斯特里]";
				mes "明白的话，";
				mes "我们开始吧！";
				next;
				if(select("好，我们开始吧！:不，我改变主意了！") == 2) {
					mes "[维斯特里]";
					mes "呸……！";
					mes "你这么胆小，";
					mes "怎么在这个世界生存？";
					mes "";
					next;
					mes "[维斯特里]";
					mes "算了。";
					mes "我知道你只是谨慎。该死，我太想";
					mes "工作了！";
					close;
				}

				if (countitem(984) > 0) {
					delitem 984,1; //Oridecon
				}
				else {
					mes "[维斯特里]";
					mes "嗯……";
					mes "你忘了带";
					mes "神之金属。";
					mes "快去拿一个。";
					close;
				}
				// anti-hack
				if (callfunc("F_IsEquipIDHack", .@part, .@equip_id) || callfunc("F_IsEquipCardHack", .@part, .@card[0], .@card[1], .@card[2], .@card[3]) || callfunc("F_IsEquipRefineHack", .@part, .@equip_refine))
					close;

				if (getequippercentrefinery(.@part) > rand(100)) {
					mes "^3355FF*铿锵铿锵！*^000000";
					successrefitem .@part;
					next;
					emotion ET_SMILE;
					mes "[维斯特里]";
					mes "哇哈哈哈～";
					mes "我还没老！";
					mes "你不为更强的";
					mes "武器";
					mes "高兴吗？";
					next;
				}
				else {
					mes "[维斯特里]";
					mes "^3355FF*铿锵铿锵！*^000000";
					failedrefitem .@part;
					next;
					emotion ET_HUK;
					mes "[维斯特里]";
					mes "哇啊啊啊！";
					mes "天啊，不！";
					next;
					mes "[维斯特里]";
					mes "没、没关系！";
					mes "坏事有时会发生。";
					mes "就当我们";
					mes "今天都";
					mes "走背运。";
					mes "对，不后悔！";
					next;
				}
				set god_mjo_3,2;
				mes "[维斯特里]";
				mes "朋友，";
				mes "以后见到我兄弟，替我问好。";
				mes "保重。";
				close;
			}
			else if (god_mjo_3 == 0) {
				mes "[维斯特里]";
				mes "你想要什么？";
				next;
				switch(select("没什么:打扰了。")) {
				case 1:
					mes "[维斯特里]";
					mes "想要东西就靠自己的努力获得。";
					next;
					mes "[维斯特里]";
					mes "无论别人说什么，只要自信且意志坚定，你总会对结果满意。";
					close;
				case 2:
					mes "[维斯特里]";
					mes "嗯……";
					mes "除了铁匠工作，我不知道还能怎样帮助你这样的冒险者……";
					next;
					mes "[维斯特里]";
					mes "我最喜欢把濒临损坏的高级武器升级。";
					next;
					mes "[维斯特里]";
					mes "你不喜欢挑战极限吗？对我来说，升级武器就像攀登未征服的高山！";
					next;
					mes "[维斯特里]";
					mes "好吧，也许我注定要帮助你。我会替你升级武器。你只需带来武器和材料。";
					next;
					set god_mjo_3,1;
					mes "[维斯特里]";
					mes "条件是：带来一把已经升级到可能损坏程度的四级武器。还有，带一块神之金属！";
					close;
				}
			}
			else {
				mes "[维斯特里]";
				mes "呼呼……呼呼……";
				close;
			}
		}
		else if (god_mjo_0 == 2) {
			if (god_mjo_1 == 3 || god_mjo_2 == 3 || god_mjo_3 == 3 || god_mjo_4 == 3) {
				mes "[维斯特里]";
				mes "我真希望下次能遇到一个像样的人类。到目前为止，我还没遇到一个有用的人类。";
				close;
			}
			else if (god_mjo_2 == 2) {
				mes "[维斯特里]";
				mes "完美的准备不一定带来成功。有时你必须直接行动。";
				next;
				mes "[维斯特里]";
				mes "我不知道你的目标有多大，";

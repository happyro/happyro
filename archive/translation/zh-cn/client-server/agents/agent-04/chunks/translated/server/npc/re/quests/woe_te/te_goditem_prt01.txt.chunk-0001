//===== rAthena Script =======================================
//= God Items Quest
//===== Description: =========================================
//= [Official Conversion]
//= God Item Hervor Creation script (WoE TE)
//===== Changelogs: ==========================================
//= 1.0 First Version. [Capuche]
//============================================================

te_prtcas01,204,204,3	script	Blacksmith Kai#tegod01	4_M_RACHMAN2,{
	if (checkweight(1201,1) == 0) {
		mes "你携带了太多物品，无法继续任务。";
		mes "请减轻负重后再试。";
		close;	}

	.@guild_id = getcastledata("te_prtcas01",1);
	.@economy  = getcastledata("te_prtcas01",2);
	.@npc_name$ = "Kai";

	mes "["+ .@npc_name$ +"]";
	if (.@guild_id != getcharid(2)) {
		mes "你……看起来很陌生……？";
		mes "你要威胁我吗？";
		mes "不会吧？";
		next;
		mes "["+ .@npc_name$ +"]";
		mes "我有自己的理由。";
		mes "请假装没看见我。";
		close;
	}
	if (WoeTETimeStart(14400) == 1 || agitcheck3() == 1) {// cannot start the quest 4 hours before and during WOE TE
		mes "从现在开始，我会安静待在这里，直到攻城战结束，不打扰任何人。";
		mes "不用担心我。";
		close;
	}
	if (is_guild_leader() == false) {
		mes "你一直允许我留在这里，我始终心怀感激。";
		mes "这不是什么特别的东西……不过如果你愿意，我可以为你制作一些有用的工具。";
		next;
		mes "["+ .@npc_name$ +"]";
		mes "我的意思是，如果公会会长需要的话。";
		mes "我也是追求终极道路的大师。";
		mes "希望我能在这里找到那条路。";
		close;
	}
	if ($2012_tegod_gloria == 0) {// event status
		mes "啊……大师。";
		mes "我一直非常感谢你。";
		mes "因为我欠你很多，所以随时都愿意帮助你。";
		next;
		switch( select( "制作赫沃尔。","融合材料。","休息。" ) ) {
		case 1:
			if (.@economy > 29) {
				if (countitem(6595) > 1 && countitem(6596) > 0 && countitem(6594) > 3 && countitem(6597) > 2 && countitem(6602) > 0 && countitem(6605) > 0 && countitem(6604) > 0 && countitem(2115) > 0) {
					mes "^ff0000制作赫沃尔需要女武神之盾。";
					mes "要继续任务，除了女武神之盾外不能持有其他物品。^ff0000";
					next;
					mes "^ff0000无论精炼等级和卡片如何，制作过程都需要你持有的一面女武神之盾。";
					mes "请整理物品后再试。^000000";
					next;
					if (select( "整理物品。","照这样继续。" ) == 1) {
						mes "你决定只保留女武神之盾。";
						close;
					}
					mes "["+ .@npc_name$ +"]";
					mes "我看见你如约发展了要塞。";
					mes "而且，你找到了维伦德的物品……";
					next;
					mes "["+ .@npc_name$ +"]";
					mes "……那么……开始工作吧。";
					mes "趁那些女孩找到我们之前……";
					next;
					mes "[" + strcharinfo(0) + "]";
					mes "那些女孩……？";
					next;
					mes "["+ .@npc_name$ +"]";
					mes "……是的，有一些女孩……";
					mes "因为她们我不得不逃跑……";
					donpcevent "#tequest_master_prt01::OnCommandOn";
					mapannounce "te_prtcas01","女孩的声音：喂，你刚才是在说我们吗？你就是"+ .@npc_name$ +"吧？真不敢相信你竟然逃到了这种地方。",bc_map,"0x00FF00",FW_BOLD,20,0,40;
					next;
					mes "["+ .@npc_name$ +"]";
					mes "哦，不……！";
					mes "她们来了……！！";
					next;
					mes "[" + strcharinfo(0) + "]";
					mes "交给我吧。";
					next;
					mes "^4d4dff！- 指示 -！";
					mes "很快，追踪"+.@npc_name$+"的 7 名女孩会试图入侵要塞。";
					mes "你必须保护"+.@npc_name$+" 1 小时。^000000";
					next;
					mes "^4d4dff！- 指示 -！";
					mes "实际攻击开始后，为了保护要塞，城堡核心区域的入口会被封锁。^000000";
					close;
				}
				mes "["+ .@npc_name$ +"]";
				mes "赫沃尔是一面以女武神赫沃尔命名的盾牌。";
				mes "我不知道这座要塞竟然拥有曾属于维伦德的物品，他是赫沃尔的丈夫……";
				next;
				mes "["+ .@npc_name$ +"]";
				mes "如果使用它们，我们就能制作赫沃尔。";
				mes "这对我来说就像梦想成真……我的手都在发抖。";
				next;
				mes "["+ .@npc_name$ +"]";
				mes "不过，看来我们还需要更多材料。";
				mes "你能再检查一次吗？我会给你所需材料的清单。";
				callsub S_Material, .@npc_name$,1,"since it is a crystal of Velund's love.";
			}
			mes "["+ .@npc_name$ +"]";
			mes "不过，我可以说几句吗？";
			mes "赫沃尔是我制作的最强战斗装备之一，你值得从我这里得到这样的东西……";
			next;
			mes "["+ .@npc_name$ +"]";
			mes "但我希望你至少具备最低资格。";
			mes "请好好管理这座要塞，将^4d4dff商业等级提升 30 级以上^000000。";
			next;
			mes "["+ .@npc_name$ +"]";
			mes "力量越大，责任和义务也越大。";
			mes "我希望你先掌握基础。";
			next;
			mes "["+ .@npc_name$ +"]";
			mes "之后我会为你制作赫沃尔。";
			mes "如果你愿意，我可以给你材料清单。";
			callsub S_Material, .@npc_name$,0,"since it is a crystal of Velund's love.";
		case 2:
			callsub S_Fuse, .@npc_name$, "Hervor";
		case 3:
			mes "["+ .@npc_name$ +"]";
			mes "你这么说真是太好了。";
			mes "顺便问一下，我的弟弟卡诺最近怎么样？";
			next;
			mes "["+ .@npc_name$ +"]";
			mes "我相信他和我一样过得很好。";
			mes "……希望事情能一直像现在这样平静。";
			close;
		}
	}
	if ($2012_tegod_gloria == 1) {// event started
		mes "你听说消息了吗？";
		mes "那些女孩要来了。";
		mes "那些无情的女孩！！！";
		next;
		mes "["+ .@npc_name$ +"]";
		mes "她们已经宣战，随时都会到这里。";
		mes "我确定她们是来抢赫沃尔的。";
		next;
		mes "["+ .@npc_name$ +"]";
		mes "阻止她们。求你了！";
		next;
		switch( select( "交给我吧。","你说的‘女孩’是什么意思？" ) ) {
		case 1:
			mes "["+ .@npc_name$ +"]";
			mes "谢谢你……";
			mes "很抱歉给你添麻烦，但我实在无能为力。";
			next;
			mes "["+ .@npc_name$ +"]";
			mes "请替我阻止她们！";
			close;
		case 2:
			mes "["+ .@npc_name$ +"]";
			mes "……她们是想成为女武神的女孩……";
			mes "而且总是七人一组行动。";
			next;
			mes "["+ .@npc_name$ +"]";
			mes "她们想要的是强大的战斗装备……";
			mes "她们总是威胁我的弟弟卡诺和我。";
			next;
			mes "["+ .@npc_name$ +"]";
			mes "一开始她们满足于基础武器，但很快就开始威胁我们，";
			mes "说要成为女武神就需要更强大的东西。";
			next;
			mes "["+ .@npc_name$ +"]";
			mes "我受不了了，所以逃走了……但她们还是来了……";
			mes "她们已经发现赫沃尔的材料在这里，你必须小心。";
			close;
		}
	}
	if ($2012_tegod_gloria == 2) {// after 10 minutes delay
		mes "啊，别再跟着我了！";
		mes "如果你能摆脱她们……对了，赫沃尔！我会为你制作赫沃尔！";
		next;
		mes "["+ .@npc_name$ +"]";
		mes "她们什么时候才会停止跟踪我……";
		mes "我现在害怕所有女孩……吓得什么都做不了……";
		next;
		mes "他现在只是在胡言乱语。";
		mes "等等他就会冷静下来。";
		mes "你必须先摆脱那些女孩。";
		close;
	}
	if ($2012_tegod_gloria == 3) {// event failed
		mes "……虽然我又一次成功逃离了她们……";
		mes "但这很艰难。";
		mes "生活……真的太难了。";
		next;
		mes "["+ .@npc_name$ +"]";
		mes "我累得什么都做不了。";
		mes "……不管是生产、锻造还是其他事情，我暂时都做不了了。";
		mes "抱歉，我要休息一下。";
		close;
	}
	if ($2012_tegod_gloria == 4) {
		mes "我终于可以喘口气了。";
		mes "我会按照约定开始制作赫沃尔。";
		next;
		switch( select( "制作赫沃尔。","融合材料。","现在不要。" ) ) {
		case 1:
			if (countitem(6595) > 1 && countitem(6596) > 0 && countitem(6594) > 3 && countitem(6597) > 2 && countitem(6602) > 0 && countitem(6605) > 0 && countitem(6604) > 0 && countitem(2115) > 0) {
				mes "^ff0000制作赫沃尔需要女武神之盾。";
				mes "要继续任务，除了女武神之盾外不能持有其他物品。^ff0000";
				next;
				mes "^ff0000无论精炼等级和卡片如何，制作过程都需要你持有的一面女武神之盾。";
				mes "请整理物品后再试。^000000";
				next;
				if (select( "整理物品。","照这样继续。" ) == 1) {
					mes "你决定只保留女武神之盾。";
					close;
				}
				mes "["+ .@npc_name$ +"]";
				mes "哦……谢谢你。";
				mes "真不敢相信我终于能亲手接触这些材料……";
				next;
				mes "["+ .@npc_name$ +"]";
				mes "给你。";
				mes "虽然要经过很多步骤，但不是很快吗？";
				mes "我太激动了，感觉时间短得像一瞬间。";
				next;
				mes "铁匠维伦德为妻子赫沃尔制作的盾牌赫沃尔，终于在";
				mes .@npc_name$+"手中完成了。";
				delitem 6595,2;// Hammer_Of_Velund
				delitem 6596,1;// Anvil_Of_Velund
				delitem 6594,4;// Magic_Bronze_Bullion
				delitem 6597,3;// Bracelet_Of_Velund
				delitem 6602,1;// Secret_Of_Rune
				delitem 6605,1;// Muspellium
				delitem 6604,1;// Essence_Of_Rune
				delitem 2115,1;// Valkyrja's_Shield
				$2012_tegod_gloria = 5;
				getitem 2181,1;// Hervor
				announce "Velund's gift [ Hervor ] is introduced to this world by ["+ strcharinfo(0) +"] of ["+ getguildname(.@guild_id) +"] Guild.",bc_all,"0x70dbdb",FW_NORMAL,12;
				if (.@economy > 20)
					setcastledata "te_prtcas01",2,(.@economy-20);
				else
					setcastledata "te_prtcas01",2,1;// min is 1 for WOE TE
				next;
				mes "["+ .@npc_name$ +"]";
				mes "呼……我暂时恐怕没法工作了。";
				mes "我精疲力尽了。哈哈哈……";
				close;
			}
			mes "["+ .@npc_name$ +"]";
			mes "不过，看来我们还需要更多材料。";
			mes "你能再检查一次吗？我会给你所需材料的清单。";
			callsub S_Material, .@npc_name$,1;
		case 2:
			callsub S_Fuse, .@npc_name$, "Hervor";
		case 3:
			mes "["+ .@npc_name$ +"]";
			mes "现在正是制作它的好时机。";
			mes "等下一个城堡核心出现时，就没有机会了。";
			next;
			mes "["+ .@npc_name$ +"]";
			mes "还要记住，我每周只能制作一次。";
			close;
		}
	}
	if ($2012_tegod_gloria == 5) {
		mes "我有点累。";
		mes "我想应该休息几天。";
		mes "我看起来也许没事，但精神上已经很疲惫了。";
		close;
	}
	mes "真奇怪。";
	mes "我说不清自己的感受。";
	mes "我是不是有某种健康问题？";
	mes "难道是不治之症？";
	close;

S_Material:
	.@npc_name$ = getarg(0);
	next;
	mes "["+ .@npc_name$ +"]";
	mes "^4d4dff2 个维伦德之锤";
	mes "1 个维伦德的铁砧";
	mes "4 根带有魔力的青铜棒";
	mes "3 个维伦德的手镯";
	mes "1 个符文文字的秘密";
	mes "1 面女武神之盾";
	mes "1 个穆斯贝尔海姆矿石和符文精华各 1 个^000000";
	next;
	mes "["+ .@npc_name$ +"]";
	mes "我们需要这些数量的材料。";
	mes getarg(2,"");
	mes "顺便说一下，穆斯贝尔海姆矿石和符文精华需要额外材料分别制作。";
	next;
	mes "["+ .@npc_name$ +"]";
	mes "制作穆斯贝尔海姆矿石需要^4d4dff合成 50 个铝和 50 个神之金属^000000。";
	mes "制作符文精华需要^4d4dff合成 200 个古代粗糙符文石和 100 个神秘粗糙符文石^000000。";
	next;
	mes "["+ .@npc_name$ +"]";
	mes "只要你提出请求，我随时都能制作穆斯贝尔海姆矿石和符文精华，";
	mes "当然，收齐所有材料后，我也会制作耶梦加得。";
	next;
	mes "["+ .@npc_name$ +"]";
	if (getarg(1))
		mes "和你为我所做的一切相比，我做的永远不够。";
	else {
		mes "不过，你无法找到维伦德的物品。";
		mes "……但人们说，它们一定会出现在真正渴望它们的人面前。祝你好运。";
	}
	close;

S_Fuse:
	.@npc_name$ = getarg(0);
	mes "["+ .@npc_name$ +"]";
	mes "你想制作哪种材料？";
	next;
	switch( select( "穆斯贝尔海姆矿石","符文精华","算了。" ) ) {
	case 1:
		mes "["+ .@npc_name$ +"]";
		if (countitem(985) > 49 && countitem(984) > 49) {
			mes "我会用你准备的材料制作穆斯贝尔海姆矿石。";
			next;
			mes "["+ .@npc_name$ +"]";
			mes "不会花太久。";
			mes "给你。";
			mes "这是制作赫沃尔和耶梦加得的必要材料。";
			delitem 985,50;// Elunium
			delitem 984,50;// Oridecon
			getitem 6605,1;// Muspellium
			close;
		}
		mes "制作穆斯贝尔海姆矿石需要，";
		mes "^4d4dff50 个铝和 50 个神之金属。^000000";
		next;
		mes "["+ .@npc_name$ +"]";
		mes "我们应该已经准备好所有材料了，对吧？";
		close;
	case 2:
		mes "["+ .@npc_name$ +"]";
		if (countitem(12735) > 199 && countitem(12736) > 99) {
			mes "我会用你准备的材料制作符文精华。";
			next;
			mes "["+ .@npc_name$ +"]";
			mes "不会花太久。";
			mes "给你。";
			mes "这是制作赫沃尔和耶梦加得的必要材料。";
			delitem 12735,200;// Runstone_Ancient
			delitem 12736,100;// Runstone_Mystic
			getitem 6604,1;// Essence_Of_Rune
			close;
		}
		mes "制作符文精华需要，";
		mes "^4d4dff200 个古代粗糙符文石和 100 个神秘粗糙符文石。^000000";
		next;
		mes "["+ .@npc_name$ +"]";
		mes "确实需要很多材料……";
		close;
	case 3:
		mes "["+ .@npc_name$ +"]";
		mes "需要时随时告诉我。";
		mes "我很高兴至少能为你做这些。";
		next;
		mes "["+ .@npc_name$ +"]";
		mes "而且，这个能找到"+getarg(1)+"材料的地方……";
		mes "对我来说也像梦一般。";
		close;
	}

OnInit:
	if ($2012_tegod_gloria == 3 || agitcheck3())// 3 -> quest failed
		disablenpc();
	else
		enablenpc();
	end;
}

te_prtcas01,190,2,0	script	#tequest_master_prt01	CLEAR_NPC,{
	mes "密码？";
	next;
	if ( callfunc( "F_GM_NPC", 1854,0, 0,9999 ) < 1 ) {
		mes "走开。";
		close;
	}
	.@map$ = "te_prtcas01";
	mes "当前状态：" + $2012_tegod_gloria;
	mes "0：可以继续任务";
	mes "1：继续任务，等待 10 分钟";
	mes "2：任务进行中";
	mes "3：任务失败";
	mes "4：可以制作物品，5：物品制作成功。";
	next;
	mes "公主状态：" + $@2012_tegirls_prt01;
	mes "要塞当前商业等级：" + getcastledata(.@map$,2);
	next;
	switch( select( "不继续","初始化","提高商业等级","降低商业等级" ) ) {
	case 1:
		end;
	case 2:
		mes "初始化";
		donpcevent "#tequest_master_prt01::OnReset";
		close;
	case 3:
		.@economy = getcastledata(.@map$,2) +30;
		.@economy = .@economy > 100 ? 100 : .@economy;
		setcastledata .@map$,2,.@economy;
		mes "商业等级提高 30";
		mes "修改后的商业等级：" + .@economy;
		close;
	case 4:
		.@economy1 = getcastledata(.@map$,2);
		.@economy2 = .@economy1 > 30 ? (.@economy1 -30) : 1;
		if (.@economy1 > 30) {
			mes "商业等级降低 30";
			setcastledata .@map$,2,.@economy2;
		}
		else {
			mes "由于当前等级低于 30，商业等级将降至 0。";
			setcastledata .@map$,2,1;// min is 1 for WOE TE
		}
		mes "修改后的商业等级：" + .@economy2;
		close;
	}

OnReset:// gm Initialization
	callsub S_EventReset;// kill some quests mobs and stop timer of others npcs
	callsub S_EventOff;// clear setnpcdisplay
	$2012_tegod_gloria = 0;
	$@2012_tegirls_prt01 = 0;
	.npc_name$ = "";
	enablenpc "prtg-1-22_prtg-1-31#te";
	enablenpc "Blacksmith Kai#tegod01";
	stopnpctimer;
	end;

OnCommandOn:
	$2012_tegod_gloria = 1;
	.npc_name$ = strnpcinfo(0);// for script readability
	initnpctimer;
	end;

OnTimer10000:
	announce "Girls' voices: Kai~ We already know where you are. It's over!",bc_all,"0xFF0000",FW_NORMAL,10;
	end;
OnTimer15000:
	announce "Girls' Voices: We'll wait just 10 minutes. If you don't show up in the meantime, we'll storm the fortress!",bc_all,"0xFF0000",FW_NORMAL,10;
	end;
OnTimer595000:
	mapannounce "te_prtcas01", "女孩的声音：凯！你竟敢无视我们的警告！原来你在那里有同伴啊？但你觉得他们能陪你多久？！",bc_map,"0x00ff00",FW_NORMAL,12;
	end;
OnTimer598000:
	mapannounce "te_prtcas01", "You are forced out of the fortress by unknown power.",bc_map,"0x00ff00",FW_NORMAL,12;
	end;

OnTimer600000:
	$2012_tegod_gloria = 2;
	mapwarp "te_prtcas01", "te_prt_gld",159,211;
	donpcevent "Aira#fake01_prt01::OnCommandOn";
	donpcevent "Kuluna#fake01_prt01::OnCommandOn";

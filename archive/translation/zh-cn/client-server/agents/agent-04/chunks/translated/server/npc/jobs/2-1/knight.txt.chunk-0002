//

prt_in,71,91,0	script	Sir Siracuse#knt	65,{
	mes "[Sir Siracuse]";
	if (BaseJob != Job_Swordman) {
		if (BaseJob == Job_Knight) {
			mes "你好！";
			mes "最近怎么样？";
			mes "骑士团最近";
			mes "做得相当不错。";
			next;
			mes "[Sir Siracuse]";
			mes "我们一直在";
			mes "测试新成员，";
			mes "但不是所有人";
			mes "都像你一样";
			mes "有潜力。";
			next;
			mes "[Sir Siracuse]";
			mes "希望这些新成员都能守规矩，不要";
			mes "给骑士团蒙羞。";
			next;
			mes "[Sir Siracuse]";
			mes "如果你发现新成员做出有失骑士身份的行为，请替我训斥他们，好吗？";
			close;
		}
		else if (BaseClass == Job_Novice) {
			mes "哦？";
			mes "一名初心者";
			mes "来这里做什么？";
			next;
			mes "[Sir Siracuse]";
			mes "你对成为骑士感兴趣吗？不过你知道，初心者不能直接转职为骑士。";
			next;
			mes "[Sir Siracuse]";
			mes "首先，你必须";
			mes "成为一名经验丰富的";
			mes "剑士之后，";
			mes "剑士，之后才能考虑";
			mes "成为骑士。";
			close;
		}
		else {
			mes "攻击与防御。";
			mes "有没有办法兼顾两者，而不牺牲其中一项？";
			next;
			mes "[Sir Siracuse]";
			mes "双手武器能大幅";
			mes "提升攻击，却会降低防御。有什么能克服这个弱点吗？";
			next;
			mes "[Sir Siracuse]";
			mes "如果有这样的武器";
			mes "或某种技巧，";
			mes "就能大大帮助骑士……";
			close;
		}
	}
	if (KNIGHT_Q == 0) {
	mes "攻击与防御。";
	mes "有没有办法兼顾两者，而不牺牲其中一项？";
		next;
		mes "[Sir Siracuse]";
		mes "双手武器能大幅";
		mes "提升攻击，却会降低防御。有什么能克服这个弱点吗？";
		next;
		mes "[Sir Siracuse]";
		mes "如果有这样的武器";
		mes "或某种技巧，";
		mes "就能大大帮助骑士……";
		close;
	}
	else if (KNIGHT_Q == 1) {
		mes "嗯？";
		mes "你有什么";
		mes "要问我";
		mes "吗？";
		next;
		if (select("I would like to take the test to change jobs.:Oh, nothing.") == 1) {
			mes "[Sir Siracuse]";
			mes "哦，想成为";
			mes "骑士吗？这么说来，";
			mes "你不就是刚才";
			mes "申请的那个"+((Sex==SEX_MALE)?"人":"女孩")+"吗？";
			next;
			mes "[Sir Siracuse]";
			mes "让我看看……";
			mes "你的名字是";
			mes strcharinfo(0) + ".";
			next;
			mes "[Sir Siracuse]";
			mes "不过，在来找我之前，你必须先拜访其他人。在我看来，";
			mes "你还没证明自己掌握基础知识。但等你";
			mes "通过第一项测试后，";
			mes "我会重新考虑。";
			close;
		}
		mes "[Sir Siracuse]";
		mes "嗯……？";
		mes "好吧。";
		mes "只是因为";
		mes "你脸上";
		mes "露出了那种";
		mes "表情。";
		close;
	}
	else if (KNIGHT_Q == 2 || KNIGHT_Q == 3) {
		mes "嗯？";
		mes "你有什么";
		mes "要问我";
		mes "吗？";
		next;
		if (select("I would like to take the test to change jobs.:Oh, nothing.") == 1) {
			mes "[Sir Siracuse]";
			mes "哈哈哈～！";
			mes "你不是应该参加安德鲁的测试吗？不能就这样跳过，你知道的！我们的每项测试都很重要。";
			next;
			mes "[Sir Siracuse]";
			mes "先去和安德鲁爵士谈谈。";
			mes "完成他的测试后，才轮到我的测试。";
			close;
		}
		mes "[Sir Siracuse]";
		mes "嗯……？";
		mes "好吧。";
		mes "只是因为";
		mes "你脸上";
		mes "露出了那种";
		mes "表情。";
		close;
	}
	else if (KNIGHT_Q == 4 || KNIGHT_Q == 5) {
		if (KNIGHT_Q == 4) {
			mes "哦？";
			mes "你有什么";
			mes "要问我";
			mes "吗？";
			next;
			if (select("Sir Andrew sent me to take your test.:Oh, nothing.") == 1) {
				mes "[Sir Siracuse]";
				mes "我明白了，你通过了第一项测试。很好，我会抽时间接待你。先自我介绍一下，我叫詹姆斯·西拉库斯。";
				next;
				mes "[Sir Siracuse]";
				mes "这项测试会考察你对骑士的了解。更重要的是，我想知道你对荣誉的看法。";
				next;
				mes "[Sir Siracuse]";
				mes "别紧张，我不会耽误你太久。这些问题很快就能答完。而且你还要去见其他人，对吧？";
				next;
				mes "[Sir Siracuse]";
				mes "那么，";
				mes "开始吧。";
				mes "请迅速";
				mes "回答。";
				next;
			}
			else {
				mes "[Sir Siracuse]";
				mes "嗯……？";
				mes "好吧。";
				mes "只是因为";
				mes "你脸上";
				mes "露出了那种";
				mes "表情。";
				close;
			}
		}
		else if (KNIGHT_Q == 5) {
			mes "什么……";
			mes "又是你？";
			next;
			if (select("I wish to take the test again.:Oh, nothing.") == 1) {
				mes "[Sir Siracuse]";
				mes "是吗？";
				mes "你确定这次";
				mes "准备好了吗？";
				next;
				mes "[Sir Siracuse]";
				mes "那么好吧，";
				mes "我们再来一次……";
				next;
			}
			else {
				mes "[Sir Siracuse]";
				mes "嗯……？";
				mes "好吧。";
				mes "只是因为";
				mes "你脸上";
				mes "露出了那种";
				mes "表情。";
				close;
			}
		}
		mes "[Sir Siracuse]";
		mes "骑士必须拥有强大的力量、防御、速度，以及使用双手剑的能力。以下哪种武器不受双手剑加速技能影响？";
		next;
		if (select("Katana:Slayer:Broadsword:Flamberge") != 4) {
			set KNIGHT_Q,5;
			mes "[Sir Siracuse]";
			mes "错了！";
			mes "那是双手剑！";
			mes "你确定想成为骑士吗？你连基础都不知道……";
			next;
			mes "[Sir Siracuse]";
			mes "如果不确定，就进城向任何骑士请教。申请转职前，你需要更多地了解骑士！";
			close;
		}
		mes "[Sir Siracuse]";
		mes "很好，现在问你一些技能知识。学习狂击不需要以下哪项技能？";
		next;
		if (select("Two Handed Sword Mastery Lv.5:Magnum Break Lv.3:Provoke Lv.10:Bash Lv.10") != 3) {
			set KNIGHT_Q,5;
			mes "[Sir Siracuse]";
			mes "错了！";
			mes "学习狂击需要那项技能！申请转职前，你应该更多了解骑士职业！";
			close;
		}
		mes "[Sir Siracuse]";
		mes "骑士不同于其他职业，也能使用长矛并学习相关技能。学习长矛投掷不需要以下哪项技能？";
		next;
		if (select("Pierce Lv.5:Spear Stab Lv.3:Spear Boomerang Lv.3:Peco Peco Ride Lv.1") != 3) {
			set KNIGHT_Q,5;
			mes "[Sir Siracuse]";
			mes "错了！学习长矛投掷需要那项技能！想成为骑士却不了解骑士，怎么行？";
			next;
			mes "[Sir Siracuse]";
			mes "如果不确定，就进城向任何骑士求助。";
			mes "了解更多骑士知识后再回来。";
			close;
		}
		mes "[Sir Siracuse]";
		mes "有些长矛也具备像法术一样的魔法属性。以下哪种可以攻击具有幽灵属性的梦魇？";
		next;
		if (select("Zephyrus:Lance:Bill Guisarme:Crescent Scythe") != 1) {
			set KNIGHT_Q,5;
			mes "[Sir Siracuse]";
			mes "错了！那种长矛完全无法造成伤害！了解更多骑士知识后再回来！";
			next;
			mes "[Sir Siracuse]";
			mes "有问题就向城里的任何骑士请教。这对我们来说是基础知识！";
			close;
		}
		mes "[Sir Siracuse]";
		mes "成为骑士后可以骑乘大嘴鸟。不过骑上大嘴鸟后，攻击速度会下降。";
		next;
		mes "[Sir Siracuse]";
		mes "学习骑乘术可以抵消速度下降。骑乘术达到 3 级后，你会拥有正常攻击速度的百分之多少？";
		next;
		if (select("70 % of normal attack speed:80 % of normal attack speed:90 % of normal attack speed:100 % of normal attack speed") != 2) {
			set KNIGHT_Q,5;
			mes "[Sir Siracuse]";
			mes "错了！";
			mes "不了解骑乘术就别想着骑大嘴鸟！";
			next;
			mes "[Sir Siracuse]";
			mes "多学习一些骑士知识后再回来吧！";
			close;
		}
		mes "[Sir Siracuse]";
		mes "很好，很好……";
		mes "我相信你已经了解不少骑士知识了。现在问你一些关于骑士的问题。";
		next;
		mes "[Sir Siracuse]";
		mes "在城里遇到求助的初心者时，你应该怎么做？";
		next;
		switch(select("Tell the Novice of a reasonable hunting area.:Let the Novice fight while you take the damage.:Give the Novice a bunch of Zeny and items.")) {
		case 1:
			mes "[Sir Siracuse]";
			mes "当然，即使是初心者也需要学会独立。为初心者提供正确指导，是我们能做的最好事情之一。";
			next;
			break;
		case 2:
			set KNIGHT_Q,5;
			mes "[Sir Siracuse]";
			mes "你的想法错了。你真的认为那是在帮助初心者吗？授人以鱼，只能吃一天；授人以渔，才能受用一生！";
			close;
		case 3:
			set KNIGHT_Q,5;
			mes "[Sir Siracuse]";
			mes "你真的认为这样能帮助可怜的初心者吗？这很慷慨，但只有亲自赚取，他们才会懂得 Zeny 和物品的真正价值。";
			close;
		}
		mes "[Sir Siracuse]";
		mes "好吧……";
		mes "那么，在队伍中";
		mes "你应该如何";
		mes "行动？";
		next;
		switch(select("Protect everyone in the front of the battle.:Gather monsters and destroy them at once.:Get as many items possible, at all cost.")) {
		case 1:
			mes "[Sir Siracuse]";
			mes "没错！在队伍中，我们的力量和攻击非常重要。所有骑士都应带着这种心态投入战斗。";
			next;
			break;
		case 2:
			set KNIGHT_Q,5;
			mes "[Sir Siracuse]";
			mes "你疯了吗？没意识到这种想法的缺陷吗？你无法控制大群魔物。要是它们杀了你怎么办？谁来保护无辜者？";
			close;
		case 3:
			set KNIGHT_Q,5;
			mes "[Sir Siracuse]";
			mes "我看到了你的贪婪，这里不需要这种人！看来你根本不在乎别人！";
			mes "滚开！";
			close;
		}
		mes "[Sir Siracuse]";
		mes "最后……";
		mes "骑士必须拥有的";
		mes "最重要的";
		mes "价值观是什么？";
		next;
		switch(select("Honor:Wealth:Status")) {
		case 1:
			mes "[Sir Siracuse]";
			mes "没错，骑士最重要的就是荣誉！我们为荣誉而生、为荣誉而死！永远记住这一点。";
			next;
			break;
		case 2:
			set KNIGHT_Q,5;
			mes "[Sir Siracuse]";
			mes "你这个败类！你想为了个人财富成为骑士？滚开！我们骑士团不接纳你这样的人！";
			close;
		case 3:
			set KNIGHT_Q,5;
			mes "[Sir Siracuse]";
			mes "你想通过骑士团成名？真可悲。我们骑士团不接纳你这样的人！";
			close;
		}
		set KNIGHT_Q,6;
		
		changequest 9003,9004;

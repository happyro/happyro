			close;
		}
		else {
			mes "我们普隆德拉骑士团成员，";
			mes "正竭尽全力守护这个世界的和平。";
			next;
			mes "[Sir Andrew]";
			mes "即使每天面对战斗，";
			mes "我们仍梦想着即将到来的光明未来。";
			close;
		}
	}
	if (KNIGHT_Q == 0) {
		mes "我们普隆德拉骑士团成员，正竭尽全力保护世界和平。";
		next;
		mes "[Sir Andrew]";
		mes "即使每天面对战斗，我们仍梦想着即将到来的光明未来。";
		close;
		}
		else if (KNIGHT_Q == 1) {
	mes "你好。有什么我能帮你的吗？";
	next;
		if (select("我想参加测试。:哦，没什么。") == 1) {
		mes "[Sir Andrew]";
		mes "啊……";
		mes "你想成为骑士。";
		mes "你的名字是";
			mes strcharinfo(0) + ",";
			mes "对吗？";
			next;
			mes "[Sir Andrew]";
			mes "我是普隆德拉骑士团的骑士 Andrew Shylock。";
			mes "负责你的第一项测试。";
			next;
			mes "[Sir Andrew]";
			mes "我将测试你的忠诚。每位骑士都必须拥有这种美德。";
			mes "这项考试要求你从战场收集战利品。";
			next;
			if (JobLevel == 50) {
			mes "[Sir Andrew]";
			mes "嗯……？";
			mes "等一下。";
			mes "你似乎已经精通剑士职业。";
			next;
			mes "[Sir Andrew]";
			mes "令人印象深刻……！";
			mes "这么看来，我想没必要测试你的忠诚。";
				next;
				mes "[Sir Andrew]";
				mes "请去找我的同僚 Sir Siracuse，他会进行下一项测试。恭喜你精通剑士职业。";
				set KNIGHT_Q,4;
				changequest 9000,9003;
				close;
				}
				mes "[Sir Andrew]";
				mes "不再多说，开始吧！";
				mes "去收集以下物品……";
				next;
				mes "[Sir Andrew]";
				switch(rand(1,2)) {
				//Elder_Pixie's_Beard, Wing_Of_Red_Bat, Orcish_Voucher, Moth_Dust, Reptile_Tongue, Wild_Boar's_Mane
				case 1: setarray .@items[0], 1040,5, 7006,5, 931,5, 1057,5, 903,5, 1028,5, 2; break;
				//Short_Leg, Heart_Of_Mermaid. Blossom_Of_Maneater, Flesh_Of_Clam, Old_Frying_Pan, Snail's_Shell
				case 2: setarray .@items[0], 1042,5, 950,5, 1032,5, 966,5, 7031,5, 946,5, 3; break;
				}
				set KNIGHT_Q,.@items[12];
			if (KNIGHT_Q == 2) changequest 9000,9001;
			else changequest 9000,9002;
			mes "^236B8E"+.@items[1]+" "+getitemname(.@items[0])+"^000000,";
			mes "^236B8E"+.@items[3]+" "+getitemname(.@items[2])+"^000000,";
			mes "^236B8E"+.@items[5]+" "+getitemname(.@items[4])+"^000000,";
			mes "^236B8E"+.@items[7]+" "+getitemname(.@items[6])+"^000000,";
			mes "^236B8E"+.@items[9]+" "+getitemname(.@items[8])+"^000000 and";
			mes "^236B8E"+.@items[11]+" "+getitemname(.@items[10])+"^000000,";
			next;
			mes "[Sir Andrew]";
			mes "我会在这里等你带回列出的物品。";
			mes "很快再见～";
			close;
			}
			else {
			mes "[Sir Andrew]";
			mes "那么……";
			mes "祝你今天愉快。";
			close;
			}
			}
			else if (KNIGHT_Q == 2 || KNIGHT_Q == 3) {
			mes "欢迎回来～";
			mes "你收集齐";
			mes "所有物品了吗？";
			mes "让我们检查一下……";
			next;
			switch(KNIGHT_Q) {
			//Elder_Pixie's_Beard, Wing_Of_Red_Bat, Orcish_Voucher, Moth_Dust, Reptile_Tongue, Wild_Boar's_Mane
			case 2: setarray .@items[0], 1040,5, 7006,5, 931,5, 1057,5, 903,5, 1028,5, 0; break;
			//Short_Leg, Heart_Of_Mermaid. Blossom_Of_Maneater, Flesh_Of_Clam, Old_Frying_Pan, Snail's_Shell
			case 3: setarray .@items[0], 1042,5, 950,5, 1032,5, 966,5, 7031,5, 946,5, 0; break;
		}
		if (countitem(.@items[0]) >= .@items[1] && countitem(.@items[2]) >= .@items[3] && countitem(.@items[4]) >= .@items[5] && countitem(.@items[6]) >= .@items[7] && countitem(.@items[8]) >= .@items[9] && countitem(.@items[10]) >= .@items[11]) {
			mes "[Sir Andrew]";
			mes "太好了！感谢你努力收集这些物品。它们将用于维持骑士团的财政。";
			next;
			delitem .@items[0],.@items[1];
		delitem .@items[2],.@items[3];
	delitem .@items[4],.@items[5];
	delitem .@items[6],.@items[7];
		delitem .@items[8],.@items[9];
		delitem .@items[10],.@items[11];
		if (KNIGHT_Q == 2) changequest 9001,9003;
		else changequest 9002,9003;
		set KNIGHT_Q,4;
		mes "[Sir Andrew]";
		mes "请去找我的同僚 Sir Siracuse，带着今天对我展现的奉献与忠诚继续测试。";
		close;
		}
		mes "[Sir Andrew]";
		mes "等等，等等……";
		mes "我想你还";
			mes "缺少一些";
			mes "物品。以防你";
			mes "忘记了，让我";
			mes "提醒你……";
			next;
			mes "[Sir Andrew]";
			mes "^236B8E"+.@items[1]+" "+getitemname(.@items[0])+"^000000,";
			mes "^236B8E"+.@items[3]+" "+getitemname(.@items[2])+"^000000,";
			mes "^236B8E"+.@items[5]+" "+getitemname(.@items[4])+"^000000,";
			mes "^236B8E"+.@items[7]+" "+getitemname(.@items[6])+"^000000,";
			mes "^236B8E"+.@items[9]+" "+getitemname(.@items[8])+"^000000 and";
			mes "^236B8E"+.@items[11]+" "+getitemname(.@items[10])+"^000000,";
			next;
			mes "[Sir Andrew]";
			mes "现在，请认真并诚实地参加测试。";
		mes "我会在这里等你";
		mes "完成这项任务。";
		close;
		}
		else if (KNIGHT_Q == 4) {
		mes "你还有什么要问我的吗？去参加下一项测试吧。快点，Sir Siracuse 正在等你～";
		close;
		}
		else if (KNIGHT_Q == 14) {
		mes "你一定已经完成了所有测试。干得好！去见我们的队长吧，让我们一起给出评价。";
		close;
		}
		else {
		mes "你还有什么要问我的吗？去参加下一项测试吧。尽你所能。";
		mes "我知道你能做到！";
		close;
		}
		}
		//
		//
		//
		//
	//
	//
		//
		//
	//
	//
		//
		//
	//
	//
		//
		//
		//

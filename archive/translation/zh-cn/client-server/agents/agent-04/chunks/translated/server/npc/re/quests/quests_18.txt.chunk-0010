		mes "我来解释。Maram，你坐在那里冷静一下。";
		next;
		cutin "ep18_maram_01.png",2;
		mes "[Maram]";
		mes "真的吗？我有点受惊……心脏怦怦跳。";
		npctalk "你……？", "Miriam#sms01", bc_self;
		npctalk "你不知道？你真的不知道。", "Maram#sms01", bc_self;
		next;
		cutin "ep18_miriam_01.png",1;
		mes "[Miriam]";
		mes "还记得我们之前武装的人吗？";
		next;
		cutin "ep18_suad_01.png",0;
		mes "[Suad]";
		mes "那些是托尔火山的武器，对吧？我从冒险者那里听说的。拉赫那边最终查清楚了吗？";
		next;
		cutin "ep18_miriam_01.png",1;
		mes "[Miriam]";
		mes "其实我听说那群人袭击了移民总部。他们拿走了总部的一切。";
		next;
		cutin "ep18_suad_04.png",0;
		mes "[Suad]";
		mes "什么？什么时候发生的？";
		next;
		cutin "ep18_miriam_01.png",1;
		mes "[Miriam]";
		mes "没过多久，但拉赫那边已经知道了。";
		next;
		cutin "ep18_suad_03.png",0;
		mes "[Suad]";
		mes "糟糕……到底为什么……？";
		next;
		cutin "ep18_miriam_01.png",1;
		mes "[Miriam]";
		mes "事情还没结束。他们声称因为我们武装并发动攻击，所以我们是叛军。看来主张强硬回应的声音越来越大。";
		next;
		cutin "ep18_suad_03.png",0;
		mes "[Suad]";
		mes "太糟了。如果他们先发动攻击……不，不是这样。我们应该先和他们会面。";
		next;
		cutin "ep18_miriam_03.png",1;
		mes "[Miriam]";
		mes "你打算怎么做？";
		next;
		cutin "ep18_suad_03.png",0;
		mes "[Suad]";
		mes "我们必须让他们为突然行动负责，那让我们处于不利位置。我们需要评估规模并制定应对策略。";
		next;
		cutin "ep18_maram_01.png",2;
		mes "[Maram]";
		mes "我们一起去。我知道在哪里！<NAVI>[入口]<INFO>wolfvill,131,257,0,101,0</INFO></NAVI>冒险者，和我们一起去。我感觉可能需要第三方见证！";
		erasequest 16580;
		setquest 17517;
		ep18_main = 48;
		close2;
		cutin "",255;
		cloakonnpcself( "Maram#sms01" );
		cloakonnpcself( "Miriam#sms01" );
		cloakonnpcself( "Suad#sms01" );
		end;
	}
	end;

OnInit:
	questinfo( QTYPE_QUEST2, QMARK_YELLOW, "isbegin_quest(16580) == 1" );
	end;
}

// Main Quest: Step 52.
wolfvill,132,256,1	duplicate(dummy_npc)	Goods#sms01	4_WOODBOX
wolfvill,131,258,1	duplicate(dummy_npc)	Goods#sms02	4_WOODBOX
wolfvill,132,258,1	duplicate(dummy_npc)	Goods#sms03	4_WOODBOX

wolfvill,131,257,1	script	Goods#sms04	4_WOODBOX,{
	if (ep18_main == 48) {
		setpcblock PCBLOCK_NPC, true;
		cloakoffnpcself( "Suad#sms02" );
		cloakoffnpcself( "Maram#sms02" );
		cloakoffnpcself( "Miriam#sms02" );
		npctalk "这些是掠夺来的物品吗？", "Suad#sms02", bc_self;
		sleep2 1000;
		npctalk "哦……掠夺来的物品真的在这里。", "Maram#sms02", bc_self;
		npctalk "啊……", "Miriam#sms02", bc_self;
		sleep2 2000;
		cloakoffnpcself( "Lamacus#sms01" );
		cloakoffnpcself( "Kun#sms01" );
		cloakoffnpcself( "Yopi#sms01" );
		npctalk "谁敢如此鲁莽地碰别人的东西？", "Lamacus#sms01", bc_self;
		npctalk "盗贼大师出现了吗？", "Kun#sms01", bc_self;
		npctalk "真大胆。别人的东西啊！！！", "Yopi#sms01", bc_self;
		sleep2 2000;
		emotion ET_QUESTION, getnpcid(0,"Lamacus#sms01");
		setpcblock PCBLOCK_NPC, false;

		mes "[Lamacus]";
		mes "哦？Suad！Miriam 和 Maram 也来了。";
		next;
		mes "[Kun]";
		mes "大家怎么了？如果是武器的事，我之前已经说过一切了。";
		next;
		cutin "ep18_miriam_03.png",0;
		mes "[Miriam]";
		mes "除了那个还有什么要说的吗？";
		next;
		cutin "",255;
		mes "[Yopi]";
		mes "嘿～好可怕～怎么突然这样？还带来了陌生人。有值得害怕的事吗？";
		npctalk "那个人是谁？", "Kun#sms01", bc_self;
		next;
		cutin "ep18_maram_03.png",2;
		mes "[Maram]";
		mes "这是什么胡话？我更害怕你们！你们怎么能攻击上层人？";
		next;
		cutin "",255;
		mes "[Lamacus]";
		mes "哦，那个？不用夸我。";
		next;
		cutin "ep18_maram_03.png",2;
		mes "[Maram]";
		mes "真的吗～啊？";
		next;
		cutin "ep18_suad_01.png",1;
		mes "[Suad]";
		mes "我们来听听你们攻击无辜上层人的理由。";
		next;
		cutin "",255;
		mes "[Kun]";
		mes "这是怎么回事？你们都因为小事聚在这里？";
		next;
		cutin "ep18_suad_02.png",1;
		mes "[Suad]";
		mes "小事？因为你们的所作所为，我们被贴上叛军标签。你们给了他们攻击我们的借口！";
		next;
		cutin "",255;
		mes "[Yopi]";
		mes "他们攻击我们，我们就反击。有什么好担心的？我们现在也有武器了，你知道吗？";
		npctalk "有什么问题？", "Kun#sms01", bc_self;
		npctalk "说起来容易，对吧？", "Maram#sms02", bc_self;
		next;
		mes "[Yopi]";
		mes "你知道我们抢的是谁吗？如果知道，你会感谢我们。那可不是无辜的上层人。";
		npctalk "你也会后悔这样对待我们。", "Lamacus#sms01", bc_self;
		next;
		cutin "ep18_miriam_03.png",0;
		mes "[Miriam]";
		mes "你知道不论对方是否无辜，攻击并抢劫上层人叫什么吗？这叫抢劫。";
		next;
		cutin "",255;
		mes "[Kun]";
		mes "不，这太过分了。抢劫？我们针对的是 Ahmad 的上层人。";
		next;
		emotion ET_SURPRISE, getnpcid(0,"Suad#sms02");
		emotion ET_HUK, getnpcid(0,"Miriam#sms02");
		emotion ET_HUK, getnpcid(0,"Maram#sms02");
		emotion ET_QUESTION, playerattached();
		cutin "ep18_miriam_03.png",0;
		mes "[Miriam]";
		mes "如果是 Ahmad……";
		next;
		cutin "ep18_maram_03.png",2;
		mes "[Maram]";
		mes "不是 Suad 的吗？";
		npctalk "哦……原来确实在那里。", "Maram#sms02", bc_self;
		next;
		cutin "",255;
		mes "[Kun]";
		mes "没错！他们把我们当垃圾，甚至无视自己的儿子！";
		next;
		mes "[Lamacus]";
		mes "他们把我们这样的人榨干了！";
		npctalk "我还以为是蚊子……？", "Yopi#sms01", bc_self;
		next;
		mes "[Yopi]";
		mes "我们向 Suad 复仇并获得了必要物资，这不是好事吗？";
		npctalk "我们需要的东西太多了！", "Lamacus#sms01", bc_self;
		next;
		mes "[Kun]";
		mes "没错！！你因为父亲受了很多苦。你也是因为他才来到这里。";
		next;
		mes "[Kun]";
		mes "仅仅因为你是原住民，他不仅拒绝承认你是有能力的儿子，还虐待你。事实上，他可能从未承认你是他的儿子。";
		next;
		mes "[Yopi]";
		mes "这里有谁不知道 Suad 的故事？";
		npctalk "没有。仔细想想。我们替你报仇了。", "Kun#sms01", bc_self;
		next;
		mes "[Lamacus]";
		mes "你一直在心里想象这些，对吧？你不该受到那种待遇。你想向继父复仇。";
		next;
		cutin "ep18_maram_03.png",2;
		mes "[Maram]";
		mes "说点什么，Suad。";
		next;
		cutin "ep18_suad_03.png",1;
		mes "[Suad]";
		mes "……唉……好，我明白了……只是……下次小心。理解你这么做的原因，但我们可能会陷入更大的麻烦……";
		next;
		cutin "ep18_miriam_03.png",0;
		mes "[Miriam]";
		mes "Suad？这就结束了吗？";
		next;
		cutin "ep18_maram_01.png",2;
		mes "[Maram]";
		mes "我不太了解这类事情，但依我有限的看法，他们以后不会继续这样吗？我们是不是该以防万一武装自己？";
		next;
		cutin "ep18_suad_03.png",1;
		mes "[Suad]";
		mes "考虑到村里物资短缺，确实如此。贸易越来越困难。";
		next;
		mes "[Suad]";
		mes "正如我之前所说，武装是必要的。我们需要在保留已有物资的同时寻找新来源。所以我想和你们讨论这件事。";
		next;
		cutin "ep18_miriam_03.png",0;
		mes "[Miriam]";
		mes "Suad？告诉我们。你完全不知道这个决定吗？你能诚实地说自己与此事无关吗？";
		next;
		cutin "ep18_suad_03.png",1;
		mes "[Suad]";
		mes "等等，等等。我需要时间整理思绪。";
		erasequest 17517;
		setquest 17518;
		ep18_main = 49;
		close3;
	}
	if (ep18_main == 49) {
		cloakoffnpcself( "Suad#sms02" );
		cloakoffnpcself( "Maram#sms02" );
		cloakoffnpcself( "Miriam#sms02" );
		cloakoffnpcself( "Lamacus#sms01" );
		cloakoffnpcself( "Kun#sms01" );
		cloakoffnpcself( "Yopi#sms01" );
		end;
	}
	end;

OnInit:
	questinfo( QTYPE_QUEST2, QMARK_YELLOW, "isbegin_quest(17517) == 1" );
	end;
}

// Main Quest: Step 53.
wolfvill,131,252,3	script(CLOAKED)	Lamacus#sms01	EP18_ARMED_VILLAGER01,{
	if (checkweight(1000405,30) == 0) {
		mes "- 等一下！！-";
		mes "- 你目前携带了-";
		mes "- 太多物品。-";
		mes "- 请再试一次-";
		mes "- 减轻负重后。-";
		close;
	}
	if (ep18_main == 49) {
		mes "[Kun]";
		mes "不！但仔细想想，我们做错了什么？他们为什么要阻止我们？";
		npctalk "我也不知道。我们不是帮助过他们吗？", "Yopi#sms01", bc_self;
		next;
		mes "[Lamacus]";
		mes "我们不是想把一切据为己有，只是希望大家都能过得好。";
		next;
		mes "[Yopi]";
		mes "对吧？我也是这么想的。也许我们更加努力、积极，他们就会改变想法？";
		next;
		select( "我们能就这样算了吗……？" );
		cutin "ep18_maram_03.png",2;
		mes "[Maram]";
		mes "不，我们不能。当然不行。不考虑未来就鲁莽行事，这就是成年人该做的吗？";
		next;
		cutin "ep18_miriam_03.png",0;
		mes "[Miriam]";
		mes "Suad，请说句话。";
		next;
		cutin "",255;
		cloakoffnpcself( "Citizen#sms01" );
		cloakoffnpcself( "Citizen#sms02" );
		cloakoffnpcself( "Citizen#sms03" );
		mes "[Citizen]";
		mes "大家都在这里。你提到了攻击上层人？到底怎么回事？";
		next;
		mes "[Citizen]";
		mes "做得好。有时就是要搅动局面。难道我们要无力地什么也不做吗？他们一直看不起我们，是时候不再被忽视了。";
		npctalk "我们也要让他们看看我们能掀起风浪。", "Citizen#sms02", bc_self;
		next;
		mes "[Yopi]";
		mes "但现在 Suad 说我们不该这样做。";
		next;
		mes "[Citizen]";
		mes "为什么？他为什么说不能这样做？";
		next;
		mes "[Kun]";
		mes "他说我们的行动可能让我们更加危险，但我太困惑了，听不懂他在说什么。";
		next;
		mes "[Lamacus]";
		mes "就因为我们袭击了上层人，他们就要把我们赶出拉赫尔吗？他们要攻击我们？";
		npctalk "把我们赶出去是什么意思！？", "Citizen#sms01", bc_self;
		npctalk "他们要攻击我们？？", "Citizen#sms03", bc_self;
		npctalk "这是真的吗？", "Citizen#sms02", bc_self;
		next;
		cutin "ep18_suad_01.png",1;
		mes "[Suad]";
		mes "原来如此。我们的处境变得非常不利。虽然还没有重大行动，但舆论并不站在我们这边。";
		next;
		cutin "",255;
		mes "[Lamacus]";
		mes "现在不是更应该提高声音的时候吗？";
		npctalk "我们也是人，和他们一样。", "Citizen#sms02", bc_self;
		npctalk "而且我们现在也有武器了。", "Kun#sms01", bc_self;
		next;
		mes "[Citizen]";
		mes "让他们看看我们的力量！！！让我们发出声音！！";
		npctalk "好！！我们就这么做！！！", "Citizen#sms02", bc_self;
		npctalk "现在轮到我们发声了！", "Citizen#sms01", bc_self;
		npctalk "没错！该我们这么做了！", "Lamacus#sms01", bc_self;
		npctalk "我们还要这样生活多久？", "Kun#sms01", bc_self;
		npctalk "没错！！！", "Yopi#sms01", bc_self;
		next;
		cutin "ep18_maram_03.png",2;
		mes "[Maram]";
		mes "先冷静一下。";
		next;
		cutin "",255;
		mes "[Citizen]";
		mes "Suad！我们还要这样生活多久？我觉得太不公平了，受不了了！";
		npctalk "我们为什么要像逃犯一样躲藏？", "Citizen#sms03", bc_self;
		npctalk "我们不能永远这样生活。", "Citizen#sms01", bc_self;
		next;
		mes "[Kun]";
		mes "Suad，你太谨慎了。我们自己去做，就像那些袭击上层人的家伙一样。不会有事的。";
		next;
		mes "[Citizen]";
		mes "幸好这里有一位冒险者。你觉得呢？你四处旅行，一定见过很多事吧？";
		next;
		select( "I..." );
		cutin "ep18_maram_03.png",2;
		mes "[Maram]";
		mes "气氛越来越紧张了……";
		next;
		select( "事情似乎正在朝奇怪的方向发展。" );
		cutin "ep18_miriam_03.png",0;
		mes "[Miriam]";
		mes "人们似乎正在摆脱 Suad 的控制，如果这样继续下去……";
		next;
		cutin "ep18_maram_01.png",2;
		mes "[Maram]";
		mes "砰！救命！谁来救救我！";
		next;
		cutin "ep18_suad_01.png",1;
		mes "[Suad]";
		mes "好。就这么做。抗议。我们不能永远等下去。";
		next;
		cutin "ep18_maram_01.png",2;
		mes "[Maram]";
		mes "什么？就这样？现在？毫无准备？";
		next;
		cutin "ep18_suad_01.png",1;
		mes "[Suad]";
		mes "我们并非完全没有准备。我们一直在拉赫尔逐步行动、隐藏，时机成熟后就能从神殿加入。";
		next;
		cutin "",255;
		mes "[Lamacus]";
		mes "今晚日落后似乎是好时机。卫兵会换班，防守会比较松懈。";
		next;
		mes "[Citizen]";
		mes "太好了！！！我去召集大家！！";
		next;
		cloakonnpcself( "Citizen#sms01" );
		cloakonnpcself( "Citizen#sms02" );
		cloakonnpcself( "Citizen#sms03" );
		cutin "ep18_suad_01.png",2;
		mes "[Suad]";
		mes "Maran，你留在这里，准备应对可能发生的情况。";
		next;
		cutin "ep18_maram_01.png",2;
		mes "[Maram]";
		mes "明白。";
		next;
		cutin "ep18_suad_01.png",1;
		mes "[Suad]";
		mes "你们几个，把所有武器都留下。";
		next;
		cutin "",255;
		mes "[Yopi]";
		mes "为什么！！我们也需要保护自己！！";
		next;
		cutin "ep18_suad_01.png",1;
		mes "[Suad]";
		mes "我们不是去煽动武装冲突的。如果带着武器时发生意外，我们真的会被打上叛军的烙印。";
		next;
		cutin "",255;
		mes "[Kun]";
		mes "啊，好吧！总之，Suad 似乎非常担心。";
		next;
		mes "[Lamacus]";
		mes "还没发生的事，何必担心？";
		next;
		cutin "ep18_suad_01.png",1;
		mes "[Suad]";
		mes "好了，既然决定了就快点。我们在<NAVI>[神殿前]<INFO>rachel,169,245,0,101,0</INFO></NAVI>集合。";
		erasequest 17518;
		setquest 17519;
		ep18_main = 50;
		getitem 1000405,30;	// Ep18_Amethyst_Fragment
		getexp 18252408,2000000;
		close2;
		cutin "",255;
		cloakonnpcself( "Suad#sms02" );
		cloakonnpcself( "Maram#sms02" );
		cloakonnpcself( "Miriam#sms02" );
		end;
	}
	if (ep18_main == 50) {
		mes "[Lamacus]";
		mes "你在做什么？我们约好在<NAVI>[神殿前]<INFO>rachel,169,245,0,101,0</INFO></NAVI>集合。";
		close2;
		cloakonnpcself( "Lamacus#sms01" );
		cloakonnpcself( "Kun#sms01" );
		cloakonnpcself( "Yopi#sms01" );
		end;
	}
	end;

OnInit:
	questinfo( QTYPE_QUEST2, QMARK_YELLOW, "isbegin_quest(17518) == 1" );
	end;
}

wolfvill,129,256,3	duplicate(dummy_cloaked_npc)	Kun#sms01	EP18_ARMED_VILLAGER02
wolfvill,126,255,5	duplicate(dummy_cloaked_npc)	Yopi#sms01	EP18_ARMED_VILLAGER03

wolfvill,129,251,1	duplicate(dummy_cloaked_npc)	Citizen#sms01	4_M_RACHMAN1
wolfvill,129,248,7	duplicate(dummy_cloaked_npc)	Citizen#sms02	4_M_MIDDLE1
wolfvill,132,250,1	duplicate(dummy_cloaked_npc)	Citizen#sms03	4_EP18_GW_MAN01

wolfvill,126,252,7	duplicate(dummy_cloaked_npc)	Suad#sms02	4_EP18_SUAD
wolfvill,124,253,5	duplicate(dummy_cloaked_npc)	Miriam#sms02	4_EP18_MIRIAM

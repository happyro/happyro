			close;
		}
		if (mal_food > 0) {
			mes "[尼亚斯厨师]";
			mes "嗯？你真迟钝。";
			mes "你已经拿走我的订单清单了吗？";
			mes "处理好它们。";
			close;
		}
		if (checkquest(7276,PLAYTIME) == 2)
			completequest 7276;
		mes "[尼亚斯厨师]";
		mes "给你。";
		mes "我现在需要猫咪船饼的材料。幸好你及时来了。";
		if (checkquest(7276) != -1)
			erasequest 7276;
		next;
		mes "[尼亚斯厨师]";
		mes "你能从陆地带些猫咪船饼的材料来吗？";
		mes "如果你愿意，我还有一件事想拜托……";
		next;
		switch(select("我今天很忙。:好的，你需要什么？")) {
		case 1:
			mes "[尼亚斯厨师]";
			mes "真是遗憾。";
			mes "不过没关系。 猫咪船饼本来就是储备食物。";
			mes "总之，今天的船饼会在第二个月亮满月时供应。";
			next;
			switch(select("所以是磨牙饼？:虫子城堡……:不能扔掉？")) {
			case 1:
				mes "[尼亚斯厨师]";
				mes "你想从我这里听到什么？！";
				mes "喵呜！！";
				mes "猫咪船饼的坚硬就像海上的高贵耐力！";
				mes "别小看它！！";
				close;
			case 2:
				mes "[尼亚斯厨师]";
				mes "只有不懂保存的笨蛋才会这么说。";
				mes "充分晾干后密封，放在阴凉干燥处。啧啧。";
				next;
				mes "[尼亚斯厨师]";
				mes "总之，这些都是蛋白质，对吧？";
				mes "既然这么在意，为什么不晚上吃呢！";
				close;
			case 3:
				mes "[尼亚斯厨师]";
				mes "绝不能浪费食物！";
				mes "被猫咪船饼砸到会留下淤青或流血，但是";
				mes "绝不是因为这个原因！！！";
				mes "不要拿食物开玩笑！";
				close;
			}
		case 2:
			if (mal_food == 0) {
				mes "[尼亚斯厨师]";
				mes "猫咪船饼的材料和平时一样，是10个谷物和1个普通酱汁。";
				mes "我想研究人类的食物，所以请带来其中一种。";
				next;
				mes "[尼亚斯厨师]";
				mes "我好奇的食物是……";
				set .@i, rand(1,66);

				// IDs grouped in 5s incrementally.
				setarray .@StartID[0],12061,12091,12041,12071,12056,12086,12051,12081,12046,12076,12066,12096,12429,12434;
				mes "^4d4dff "+getitemname(.@StartID[(.@i-1)/5]+((.@i-1)%5))+" ^000000 .";

				set mal_food,.@i;
				setquest 7280+.@i;
				mes "一道菜就够了，请一起带来。";
				next;
				mes "[尼亚斯厨师]";
				mes "你必须带来用新鲜材料制作的菜肴。";
				mes "^ff0000我会拒绝速食。^000000";
				close;
			}
			mes "[尼亚斯厨师]";
			mes "嘿，朋友，你的记性真差。";
			mes "你已经拿走我的订单清单了吗？";
			close;
		}
	case 2:
		if (mal_food == 0) {
			mes "[尼亚斯厨师]";
			mes "你记得我让你带什么吗？";
			mes "我不知道。";
			close;
		} else if (mal_food > 66) {
			mes "[尼亚斯厨师]";
			mes "我说要带什么来？";
			mes "我不记得了？";
			mes "你是不是搞错了才来到这里？";
			close;
		}
		mes "[尼亚斯厨师]";
		mes "这是猫咪船饼的材料和人类的食物吗？";
		mes "让我检查一下你带来的东西……";
		next;
		set .@i, mal_food;

		// IDs grouped in 5s incrementally.
		setarray .@StartID[0],12061,12091,12041,12071,12056,12086,12051,12081,12046,12076,12066,12096,12429,12434;
		set .@food, .@StartID[(.@i-1)/5]+((.@i-1)%5);

		if (countitem(577) >= 10 && countitem(7454) > 0 && countitem(.@food) > 0) {
			mes "[尼亚斯厨师]";
			mes "太好了。";
			mes "就是这种食物！";
			mes "这会是很好的参考。做得好。";
			delitem 577,10; //Grain
			delitem 7454,1; //Plain_Sauce
			delitem .@food,1;
			setquest 7276;
			set mal_food,0;
			erasequest 7280+.@i;
			
			// Quantities grouped in 10s repeating.
			// [ 3, 3, 6, 6, 9, 9, 12, 12, 15, 18 ]
			// Last group [ 61 - 66 ] receives 25 constant.
			getitem 6422, ((.@i < 61)?((.@i%10)?3*(((.@i%10)+1)/2):18):25); //Egrade_Coin

			getexp 50000,80000;
			next;
			mes "[尼亚斯厨师]";
			mes "好了，你明天能来吗？";
			mes "想到你要来，我就兴奋不已。";
			mes "喵呼，喵呼。";
			close;
		}
		mes "[尼亚斯厨师]";
		mes "好吃……";
		mes "是我高估你的能力了吗？";
		mes "再确认一下缺少什么，然后正确地带来。";
		next;
		mes "[尼亚斯厨师]";
		mes "你和没有分辨力的小猫没什么不同。";
		close;
	case 3:
		mes "[尼亚斯厨师]";
		mes "你真大胆，简直像一头虎鲸。";
		mes "没事的话就别碰蔬菜，赶紧走开。";
		close;
	}
}

// Play with Baby Cats :: mal_nyadventurer
//============================================================
malangdo,165,223,4	script	Expert Cat#nya_01	561,{
	if (checkweight(1201,1) == 0 || MaxWeight - Weight < 4000) {
		mes "- 你携带的物品太多，无法继续此任务。 -";
		close;
	}
	if (BaseLevel < 60) {
		mes "[Rato]";
		mes "看起来是位访客。";
		mes "你觉得这座岛怎么样？";
		mes "虽然难以置信，但这片土地非常柔软，所以我们把这座岛命名为马来岛。";
		next;
		mes "[Rato]";
		mes "如果你是更专业的冒险者，我本来想拜托你一件事……";
		mes "算了，我不拜托了。";
		close;
	}
	if (nyadven == 0) {
		mes "[Rato]";
		mes "你好。";
		mes "我是拉托，你有时间吗？";
		next;
		switch(select("当然有。:抱歉，我现在很忙。")) {
		case 1:
			mes "[Rato]";
			mes "没什么特别的，不过你能帮我一个忙吗？";
			mes "你来的路上看到聚在一起的孩子们了吗？";
			next;
			select("孩子们？");
			mes "[Rato]";
			mes "对，就是小孩子们。";
			mes "他们是商人和船员中年纪最小的孩子。";
			mes "他们担心自己可能回不了家。";
			next;
			mes "[Rato]";
			mes "而且他们已经厌倦了生活在这座小岛上。";
			mes "他们已经体验过大海和冒险……";
			next;
			mes "[Rato]";
			mes "他们以前会玩制作东西的游戏，但现在似乎也玩腻了……";
			mes "如果可以的话，你能陪他们玩一会儿吗？";
			next;
			switch(select("呃，好的……:我没有足够的时间。")) {
			case 1:
				mes "[Rato]";
				mes "哦，谢谢你！";
				mes "那么，他们在哪里？";
				mes "也许在起点指南针附近……？";
				next;
				mes "[Rato]";
				mes "他们太活泼了，我也不知道现在在哪里。";
				break;
			case 2:
				mes "[Rato]";
				mes "哦，是吗？";
				mes "现在没法做也没关系。";
				break;
			}
			mes "如果遇到他们，请陪他们一会儿。";
			next;
			mes "[Rato]";
			mes "最小的那个叫查罗，有一身金色的毛。";
			mes "罗库是黑毛，罗西是白毛。";
			mes "请照顾好他们。";
			set nyadven,1;
			setquest 7242;
			close;
		case 2:
			mes "[Rato]";
			mes "哦，是吗？";
			mes "抱歉打扰你了。";
			close;
		}
	} else if (nyadven == 1) {
		mes "[Rato]";
		mes "最小的那个叫查罗，有一身金色的毛。";
		mes "罗库是黑毛，罗西是白毛。";
		next;
		mes "[Rato]";
		mes "只要这些孩子健康长大，我们就能期待回家的那一天。";
		mes "所以，请照顾好他们。";
		close2;
	} else if (nyadven < 13) {
		mes "[Rato]";
		mes "孩子们是不是太打扰你了？";
		mes "什么……冒险者小组？你和他们玩冒险者小组的玩具了吗？";
		next;
		mes "[Rato]";
		mes "第一次遇难漂流到这座岛时，我真的很担心他们……";
		mes "他们却觉得第一次航行是一次巨大的冒险……";
		next;
		mes "[Rato]";
		mes "他们看起来兴奋得像发烧了一样。";
		mes "我为他们制作玩具、安慰他们的事，仿佛还在昨天……";
		next;
		mes "拉托似乎陷入了沉思。";
		close;
	} else if (nyadven == 13) {
		if (countitem(6430) < 6) {
			mes "你没有带来画的碎片。";
			mes "请把它们带来。";
			close;
		}
		mes "[Rato]";
		mes "怎么回事？";
		mes "即使我拜托了你，照顾这些孩子也很辛苦吧？";
		mes "对不起，我应该自己照顾他们……";
		next;
		mes "你把一块画的碎片交给拉托。";
		next;
		mes "[Rato]";
		mes "哦，这是画的碎片？";
		mes "啊！！！";
		mes "这幅画已经被撕碎了吗？";
		next;
		mes "[Rato]";
		mes "他们说这是送给我的礼物？";
		mes "呵呵，一块画的碎片？";
		mes "哈哈哈哈哈！";
		next;
		mes "[Rato]";
		mes "好吧，我自己把这幅画补好。";
		mes "他们还是老样子。";
		mes "我想我应该先担心自己……";
		next;
		mes "[Rato]";
		mes "你愿意陪孩子们玩，真是太好了。";
		mes "这个给你。";
		delitem 6430,6; //Picture_Piece
		set nyadven,14;
		getitem 6422,100; //Egrade_Coin
		completequest 7259;
		next;
		mes "[Rato]";
		mes "我欠你一个大人情！";
		mes "今天一起喝一杯吧！";
		mes "喵呜～";
		close;
	} else {
		mes "[Rato]";
		mes "嘿，最近怎么样？有时间的话请看看它。";
		next;
		switch(select("看看画。:不看画。")) {
		case 1:
			mes "[Rato]";
			mes "是的，他们画了一幅充满幸福的画。";
			next;
			cutin "mal_nyapic",4;
			mes "欣赏画框里的画。";
			close2;
			cutin "",255;
			end;
		case 2:
			mes "[Rato]";
			mes "这么漂亮的画，你为什么不看看？";
			mes "我很失望。";
			close;
		}
	}
}

malangdo,211,203,4	script	[Meow Team] Charo#nya_11	560,{
	if (checkweight(1201,1) == 0 || MaxWeight - Weight < 4000) {
		mes "- 你携带的物品太多，无法继续此任务。 -";
		close;
	}
	if (nyadven == 0) {
		mes "有几只看起来比其他船员年幼的猫。";
		mes "他们正在认真讨论面前那台奇怪的机器。";
		close;
	} else if (nyadven == 1) {
		mes "有几只看起来比其他船员年幼的猫。";
		mes "他们正在认真讨论面前那台奇怪的机器。";
		mes "他们看起来就是拉托提到的孩子们。";
		next;
		switch(select("不发一言地看着他们。:我现在很忙。")) {
		case 1:
			mes "你试着在不打扰他们的情况下听对话。";
			next;
			mes "[Charo]";
			mes "什么时候能修好？什么时候才能完成？";
			mes "这不是最后一个了吗？";
			next;
			mes "[Rosy]";
			mes "嗯……你还没厌倦吗？";
			mes "总之，我们遇到麻烦了。";
			mes "玻璃珠坏了。";
			next;
			mes "[Roku]";
			mes "我们没有备用的玻璃珠吗？";
			next;
			mes "[Rosy]";
			mes "不，我们一个也没有。";
			mes "没有它就修不好了，对吧？";
			next;
			mes "猫咪们同时看向你。";
			next;
			switch(select("我有备用的玻璃珠！:你们为什么盯着我？")) {
			case 1:
				if (countitem(746) == 0) {
					mes "[Roku]";
					mes "没有玻璃珠。";
					mes "别骗我们。";
					close;
				}
				mes "[Charo]";
				mes "真的吗？哦，真的吗？";
				mes "是珠子！还是一颗闪闪发光的玻璃珠！";
				next;
				mes "[Rosy]";
				mes "嗯，这个足以替代它了。";
				mes "像这样……";
				next;
				mes "[Roku]";
				mes "然后这里，这样？";
				mes "完成了。";
				next;
				mes "[Charo]";
				mes "太刺激了！！！";
				mes "好了，冒险者！我们允许你使用这台机器！";
				mes "想什么时候试都可以！！";
				next;
				mes "[Charo]";
				mes "冒险者！这是美味的罐头。";
				mes "在这座岛上可以用罐头换到想要的东西。罐头可以交易。";
				mes "这些是我、罗西和罗库收集的。";
				next;
				mes "[Charo]";
				mes "还有，冒险者！";
				mes "如果你是真正的冒险者，";
				mes "就应该完成所有喵喵冒险团";
				mes "制作的喵冒险！";
				mes "想挑战时随时都可以！";
				delitem 746,1; //Glass_Bead
				set nyadven,2;
				getitem 12636,30; //Malang_Sp_Can
				close;
			case 2:
				mes "[Rosy]";
				mes "我们只是在看着站在那里的你。";
				close;
			}
		case 2:
			mes "我晚些时候再来。";
			close;
		}
	} else if (nyadven == 2) {
		mes "[Charo]";
		mes "我们修好了嘟噜嘟噜指南针，现在只差一位访客了……";
		mes "嘿，你想当访客吗？";
		emotion ET_SURPRISE;
		next;
		select("访客？");
		mes "[Charo]";
		mes "这是喵喵冒险团制作的冒险路线。";
		mes "这次我们特别加入了学习路线。";
		mes "很简单，只要按照顺序找到这座岛上的指南针即可。";
		next;
		switch(select("我来试试。:退出。")) {
		case 1:
			mes "[Charo]";
			mes "这是你的冒险卡。";
			mes "这是我们用你给的玻璃珠修好的嘟噜嘟噜指南针。";
			mes "这是起点指南针。";
			next;
			mes "[Charo]";
			mes "把冒险卡放进去，游戏就会开始！";
			mes "这台机器用来测试冒险的基本要素。";
			next;
			mes "[Charo]";
			mes "别忘了成功冒险的目的地。";
			mes "你还应该想办法尽快抵达目的地。";
			next;
			mes "[Charo]";
			mes "你把玻璃珠给了我们，是个好人，一定能做得很好。";
			next;
			mes "从黄色的猫咪查罗那里拿到了冒险卡。";
			mes "把这张卡放进起点指南针的卡槽，似乎就能启动。";
			set nyadven,3;
			getitem 6428,1; //Bravery_Card_A
			changequest 7242,7243;
			next;
			mes "[Charo]";
			mes "把冒险卡刷过起点指南针，游戏就会开始！";
			mes "起点指南针会告诉你应该前往哪里。";
			next;
			mes "[Charo]";
			mes "^4d4dff通过所有指南针后，最后就能看到船只纳维号上的喵铃！";
			mes "敲响新铃铛吧！^000000";
			close;
		case 2:
			mes "[Charo]";
			mes "啊……你不打算参加吗……";
			mes "呜……";
			mes "呜呜……";
			mes "呜呜～";
			next;
			mes "[Rosy]";
			mes "嘿，冒险者。别把孩子弄哭了！";
			close;
		}
	} else if (nyadven == 3) {
		if (nyadven02 == 28) {
			mes "[Charo]";
			mes "哦？这不是布比的失败印章吗？";
			mes "我真的很失望。";
			mes "再试一次～你一定能成功！";
			set nyadven02,0;
			if (checkquest(7257) > -1)
				erasequest 7257;
			close;
		}
		mes "[Charo]";
		mes "把冒险卡刷过起点指南针，游戏就会开始！";
		mes "起点指南针会告诉你应该前往哪里。";
		next;
		mes "[Charo]";
		mes "^4d4dff通过所有指南针后，最后就能看到船只纳维号上的喵铃！";
		mes "敲响新铃铛吧！^000000";
		close;
	} else if (nyadven == 4) {
		if (countitem(6428) == 0) {
			mes "[Charo]";
			mes "你的冒险卡在哪里？";
			mes "你应该随身带着它。";
			mes "你不会真的把它和其他垃圾一起扔掉了吧！！";
			close;
		}
		mes "[Charo]";
		mes "我听到了！";
		mes "我听到了喵铃的声音！";
		mes "你真厉害！";
		mes "接下来是个大事件！";
		next;
		select("接下来？");
		mes "[Charo]";
		mes "只要你带着这张卡，就是喵喵勇气队的成员。";
		mes "这是大事件，所以我们正需要你这样的冒险者。";
		next;
		mes "[Charo]";
		mes "这件事关系到手铐。";
		mes "据说有人在这座岛上安装了炸弹。";
		mes "侦探已经去调查这件事了。";
		next;
		mes "[Charo]";
		mes "你也应该去那里！";
		next;
		switch(select("我为什么必须去那里？:真是场冒险！我接受！")) {
		case 1:
			mes "[Charo]";
			mes "这是大事件！";
			mes "而且这座岛可能会爆炸！";
			mes "哦，你可能会对这个事实视而不见。";
			mes "把冒险卡还回来！";

turbo_room,93,117,5	script	Point Exchange Helper	125,{
	if ((MaxWeight-Weight) < 2000 || checkweight(1201,1) == 0) {
		mes "^3355FF请稍等！";
		mes "你现在携带了";
		mes "太多物品。";
		mes "请先回来，";
		mes "把部分物品存入";
		mes "把物品存入卡普拉仓库。^000000";
		close;
	}
	if (tt_point < 10) {
		mes "[物品兑换助手]";
		mes "你好，";
		mes "" + strcharinfo(0) + ".";
		mes "你目前共有";
		mes "" + tt_point + "点极速赛点数。";
		next;
		mes "[物品兑换助手]";
		mes "如果你至少有";
		mes "10 极速赛 Points,";
		mes "你可以兑换这些";
		mes "点数可以兑换物品。 Would";
		mes "要查看极速赛点数兑换";
		mes "列表吗？";
		next;
		if (select("Yes.:取消。") == 1) {
			mes "[物品兑换助手]";
			mes "^3355FF10 TTP^000000: 1 Free Ticket";
			mes "用于卡普拉传送";
			mes "^3355FF12 TTP^000000: 1 五级魔法卷轴";
			mes "^3355FF40 TTP^000000: 经验值";
			next;
			mes "[物品兑换助手]";
			mes "^3355FF150 TTP^000000: 1 三克拉钻石";
			mes "^3355FF300 TTP^000000: 1 礼盒";
			mes "^3355FF400 TTP^000000: 1 速度药水";
			next;
			mes "[物品兑换助手]";
			mes "你也可以将极速赛点数兑换为竞技场点数。详情请咨询竞技场点数管理员。谢谢。";
			close;
		}
		mes "[物品兑换助手]";
		mes "希望你享受";
		mes "艾尔迪巴兰的极速赛。";
		mes "尽量赚取更多点数，";
		mes "以后可以用它们";
		mes "兑换有用的";
		mes "物品。祝比赛愉快～";
		close;
	}
	else {
		mes "[物品兑换助手]";
		mes "你好，";
		mes "" + strcharinfo(0) + ".";
		mes "你目前共有";
		mes "" + tt_point + "点极速赛点数。";
		mes "要兑换";
		mes "这些点数换取物品吗？";
		next;
		switch(select("兑换。:取消。")) {
		case 1:
			mes "[物品兑换助手]";
			mes "请选择要用极速赛点数兑换的";
			mes "物品。";
			mes "你的极速赛点数。";
			next;
			switch(select("卡普拉传送免费券:五级魔法卷轴:经验值:三克拉钻石:礼盒:速度药水:取消。")) {
			case 1:
				mes "[物品兑换助手]";
				mes "每张卡普拉传送免费券";
				mes "用于卡普拉传送";
				mes "需要 10 点极速赛点数。";
				mes "请输入 the amount that";
				mes "请输入数量。如需取消，";
				mes "请输入“^3355FF0^000000”。";
				next;
				input .@input;
				if (.@input == 0) {
					mes "[物品兑换助手]";
					mes "你已经";
					mes "取消了";
					mes "你的请求。";
					close;
				}
				else if (.@input < 0 || .@input > 50) {
					mes "[物品兑换助手]";
					mes "你的请求超过";
					mes "最大限制。 You";
					mes "一次最多只能领取";
					mes "50 张券。";
					close;
				}
				else {
					set .@total_point,10 * .@input;
					if (.@total_point > tt_point) {
						mes "[物品兑换助手]";
						mes "抱歉，你没有足够的";
						mes "极速赛";
						mes "点数。 请检查";
						mes "你获得的极速赛";
						mes "点数后再兑换。";
						mes "";
						close;
					}
					set tt_point,tt_point-.@total_point;
					getitem 7060,.@input; //Warp_Free_Ticket
					mes "[物品兑换助手]";
					mes "感谢你的";
					mes "光临。";
					mes "希望你享受";
					mes "在这里的时光，";
					mes "极速赛～";
					close;
				}
			case 2:
				mes "[物品兑换助手]";
				mes "每张魔法卷轴需要";
				mes "12点极速赛点数。 Please";
				mes "请选择要领取的魔法卷轴。每张卷轴可使用一次五级法术或技能。";
				next;
				switch(select("Earth Spike:Cold Bolt:Fire Bolt:Lightning Bolt:Soul Strike:Fire Ball:Fire Wall:Frost Diver:Heal")) {
				case 1:
					set .@scroll,687; //Earth_Scroll_1_5
					set .@name$,"Earth Spike";
					break;
				case 2:
					set .@scroll,689; //Cold_Scroll_1_5
					set .@name$,"Cold Boltl";
					break;
				case 3:
					set .@scroll,691; //Fire_Scroll_1_5
					set .@name$,"Fire Bolt";
					break;
				case 4:
					set .@scroll,693; //Wind_Scroll_1_5
					set .@name$,"Lightning Bolt";
					break;
				case 5:
					set .@scroll,695; //Ghost_Scroll_1_5
					set .@name$,"Soul Strike";
					break;
				case 6:
					set .@scroll,697; //Fire_Scroll_2_5
					set .@name$,"Fire Ball";
					break;
				case 7:
					set .@scroll,699; //Fire_Scroll_3_5
					set .@name$,"Fire Wall";
					break;
				case 8:
					set .@scroll,12000; //Cold_Scroll_2_5
					set .@name$,"Frost Diver";
					break;
				case 9:
					set .@scroll,12002; //Holy_Scroll_1_5
					set .@name$,"Heal";
					break;
				}
				mes "[物品兑换助手]";
				mes "请输入 the number";
				mes "^4d4dff"+.@name$+"^000000 魔法卷轴的数量。";
				mes "请输入想领取的数量。";
				mes "如需取消，请输入 ''^3355FF0^000000.''";
				next;
				input .@input;
				if (.@input == 0) {
					mes "[物品兑换助手]";
					mes "你已经";
					mes "取消了";
					mes "你的请求。";
					close;
				}
				else if (.@input < 0 || .@input > 50) {
					mes "[物品兑换助手]";
					mes "抱歉，你的";
					mes "请求超过了";
					mes "最大限制。一次最多只能";
					mes "请求 50 张卷轴。";
					close;
				}
				else {
					set .@total_point,12 * .@input;
					if (.@total_point > tt_point) {
						mes "[物品兑换助手]";
						mes "抱歉，你没有足够的";
						mes "极速赛";
						mes "点数。 请检查";
						mes "你获得的极速赛";
						mes "点数后再兑换。";
						mes "";
						close;
					}
					set tt_point,tt_point-.@total_point;
					getitem .@scroll,.@input;
					mes "[物品兑换助手]";
					mes "感谢你的";
					mes "光临。";
					mes "希望你享受";
					mes "在这里的时光，";
					mes "极速赛～";
					close;
				}
			case 3:
				mes "[物品兑换助手]";
				mes "你可以兑换";
				mes "40 极速赛 Points";
				mes "获得基础等级";
				mes "经验值。要将点数";
				mes "兑换为经验值吗？";
				mes "";
				next;
				if (select("No:Yes") == 2) {
					if (tt_point < 40) {
						mes "[物品兑换助手]";
						mes "抱歉，你没有足够的";
						mes "极速赛";
						mes "点数。 请检查";
						mes "你获得的极速赛";
						mes "点数后再兑换。";
						mes "";
						close;
	
					}
					set tt_point,tt_point-40;
					if (BaseLevel < 70) getexp 3000,0;
					else if (BaseLevel < 80) getexp (checkre(3))?900:9000,0;
					else if (BaseLevel < 90) getexp (checkre(3))?1000:10000,0;
					else if (BaseLevel < MAX_LEVEL) getexp (checkre(3))?3000:30000,0;
					mes "[物品兑换助手]";
					mes "谢谢，你的";
					mes "极速赛点数";
					mes "已经兑换为";
					mes "基础等级经验值。";
					close;
				}
				mes "[物品兑换助手]";
				mes "你已经";
				mes "取消了";
				mes "你的请求。";
				close;
			case 4:
				mes "[物品兑换助手]";
				mes "你可以兑换";
				mes "150 极速赛 Points";
				mes "兑换 ^3131FF1 颗三克拉钻石^000000。";
				mes "请输入 the number of";
				mes "请输入想领取的钻石数量。";
				mes "如需取消，请输入 ''^3355FF0^000000.''";
				next;
				input .@input;
				if (.@input == 0) {
					mes "[物品兑换助手]";
					mes "你已经";
					mes "取消了";
					mes "你的请求。";
					close;
				}
				else if (.@input < 0 || .@input > 10) {
					mes "[物品兑换助手]";
					mes "你的请求超过";
					mes "最大限制。 You";
					mes "一次最多只能领取";
					mes "10 颗钻石。";
					close;
				}
				else {
					set .@total_point,150 * .@input;
					if (.@total_point > tt_point) {
						mes "[物品兑换助手]";
						mes "抱歉，你没有足够的";
						mes "极速赛";
						mes "点数。 请检查";
						mes "你获得的极速赛";
						mes "点数后再兑换。";
						mes "";
						close;
					}
					set tt_point,tt_point-.@total_point;
					getitem 732,.@input; //Crystal_Jewel__
					mes "[物品兑换助手]";
					mes "感谢你的";
					mes "光临。";
					mes "希望你享受";
					mes "在这里的时光，";
					mes "极速赛～";
					close;
				}
			case 5:
				mes "[物品兑换助手]";
				mes "你可以兑换";
				mes "300 极速赛 Points";
				mes "兑换 ^3131FF1 1 个礼盒^000000。请输入";
				mes "想领取的礼盒数量。";
				mes "";
				mes "如需取消，请输入 ''^3355FF0^000000.''";
				next;
				input .@input;
				if (.@input == 0) {
					mes "[物品兑换助手]";
					mes "你已经";
					mes "取消了";
					mes "你的请求。";
					close;
				}
				else if (.@input < 0 || .@input > 10) {
					mes "[物品兑换助手]";
					mes "你的请求超过";
					mes "最大限制。 You";
					mes "一次最多只能领取";
					mes "10 个礼盒。";
					close;
				}
				else {
					set .@total_point,300 * .@input;
					if (.@total_point > tt_point) {
						mes "[物品兑换助手]";
						mes "抱歉，你没有足够的";
						mes "极速赛";
						mes "点数。 请检查";
						mes "你获得的极速赛";
						mes "点数后再兑换。";
						mes "";
						close;
					}
					set tt_point,tt_point-.@total_point;
					getitem 644,.@input; //Gift_Box
					mes "[物品兑换助手]";
					mes "感谢你的";
					mes "光临。";
					mes "希望你享受";
					mes "在这里的时光，";
					mes "极速赛～";
					close;
				}
			case 6:
				mes "[物品兑换助手]";
				mes "你可以兑换";
				mes "400 极速赛 Points";
				mes "兑换 ^3131FF1 1 瓶速度药水^000000。请";
				mes "输入想领取的药水数量。";
				mes "";
				mes "如需取消，请输入 ''^3355FF0^000000.''";
				next;
				input .@input;
				if (.@input == 0) {
					mes "[物品兑换助手]";
					mes "你已经";
					mes "取消了";
					mes "你的请求。";
					close;
				}
				else if (.@input < 0 || .@input > 10) {
					mes "[物品兑换助手]";
					mes "你的请求超过";
					mes "最大限制。 You";
					mes "一次最多只能领取";
					mes "10 瓶药水。";
					close;
				}
				else {
					set .@total_point,400 * .@input;
					if (.@total_point > tt_point) {
						mes "[物品兑换助手]";
						mes "抱歉，你没有足够的";
						mes "极速赛";
						mes "点数。 请检查";
						mes "你获得的极速赛";
						mes "点数后再兑换。";
						mes "";
						close;
					}
					set tt_point,tt_point-.@total_point;
					getitem 12016,.@input; //Speed_Up_Potion
					mes "[物品兑换助手]";
					mes "感谢你的";
					mes "光临。";
					mes "希望你享受";
					mes "在这里的时光，";
					mes "极速赛～";
					close;
				}
			case 7:
				mes "[物品兑换助手]";
				mes "此物品兑换";
				mes "服务由以下机构";
				mes "提供……";
				next;
				mes "[物品兑换助手]";
				mes "此物品兑换服务由卡普拉";
				mes "公司、铁匠公会、";
				mes "以及可可多赌场和";
				mes "艾尔迪巴兰公会城堡";
				mes "管理部门 Luina 提供。";
				mes "";

	mes "普通模式获胜者 - 8 Person";
	mes "^4d4dff" + $ttnames$[2] + "^000000";
	mes "普通模式获胜者 - 16 Person";
	mes "^4d4dff" + $ttnames$[3] + "^000000";
	close;
}


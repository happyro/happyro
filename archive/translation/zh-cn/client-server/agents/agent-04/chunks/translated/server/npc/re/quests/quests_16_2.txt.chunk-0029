prt_in,177,26,6	script	Knight Windsor#ep162	4_M_JOB_KNIGHT1,{
	switch( isbegin_quest(7746) ) {
	case 0:
		if (countitem(25180) < 1)
			break;
		mes "[Benedict Windsor]";
		mes "怎么了？";
		next;
		if (select( "Give him the ring.", "Do you come here often?" ) == 2) {
			mes "[Benedict Windsor]";
			mes "退休后教导年轻人，我偶尔会想起儿子。";
			next;
			mes "[Benedict Windsor]";
		mes "……还有我已经去世的妻子。";
			mes "我也会想起女儿。";
			next;
			mes "你把戒指给了他。";
			next;
		}
		mes "[Benedict Windsor]";
		mes "……这……枚戒指是……";
		next;
		mes "[Benedict Windsor]";
		mes "可怜的孩子。";
		mes "最后你还是以这种方式回来了。";
		next;
		mes "[Benedict Windsor]";
		mes "我早就预料到了。";
		mes "找到他的 Pecopeco 时，我就知道出事了。";
		next;
		mes "[Benedict Windsor]";
		mes "但因为没有亲眼看到，";
		mes "心里还抱着一丝希望。";
		next;
		mes "[Benedict Windsor]";
		mes "……";
		mes "……你以这种方式回来，我该欢迎你吗？";
		next;
		mes "[Benedict Windsor]";
		mes "……谢谢。";
		mes "...";
		delitem 25180,1;// Old_Couple_Ring
		setquest 7746;// A pair of old rings
		completequest 7746;// A pair of old rings
		getexp 100000,100000;
		close;
	case 1:
	case 2:
		break;
	}
	switch( isbegin_quest(7747) ) {
	case 0:
		if (countitem(25185) < 1)
			break;
		mes "[Benedict Windsor]";
		mes "……那枚火箭吊坠属于 Cheiron。";
		mes "当他们告诉我会把他们带到吉芬魔法塔……";
		next;
		mes "[Benedict Windsor]";
		mes "我以为他们会好好照顾他们。";
		mes "……我的孩子为什么会变成这样？";
		next;
		mes "[Benedict Windsor]";
		mes "我现在该怎么办？";
		mes "我的妻子和孩子都去世了。";
		mes "我还能做什么……";
		next;
		mes "[Benedict Windsor]";
		mes "你……";
		mes "......";
		delitem 25185,1;// Locket_Pendant
		setquest 7747;// Locket Pendant
		completequest 7747;// Locket Pendant
		getexp 100000,100000;
		close2;
		npctalk "……请你还活着。", "", bc_self;
		end;
	case 1:
	case 2:
		npctalk "我希望那只是一场梦……", "", bc_self;
		end;
	}
	end;
}


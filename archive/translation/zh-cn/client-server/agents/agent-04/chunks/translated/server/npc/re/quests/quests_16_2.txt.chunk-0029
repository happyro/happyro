			mes "书名是……^0000CD反叛军，自由的历史^000000。请帮我借这本书。";
				npctalk "Ilya Lebedev：看了书名后，我觉得必须读一读。", "Ilya Lebedev#16.2rm", bc_self;
			setquest 16022;// Service: Book lending agent

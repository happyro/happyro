			mes "原来如此……你很忙的话，我们就不打扰了。";
			mes "但请别一去不回。";
			close;
		}
		emotion ET_SMILE;
		mes "[Jana Levedeva]";
		mes "哇！真的吗？";
		mes "不过" + .@genre$ + "，事实是你没有和我们玩，是我们在和你玩。哈哈！";
		mes "嗯……我们要做什么？";
		next;
		.@r = rand( getarraysize( .@quest_id ) );
		switch( .@quest_id[.@r] ) {
		case 16021:
			mes "[Jana Levedeva]";
			mes "嗯……Elena 指挥官让我们培养兴趣。";
			mes "我觉得阅读是很好的爱好，对吧？";
			next;
			mes "[Jana Levedeva]";
			mes "请从普隆德拉图书馆的儿童区借一本书给我们。";
			mes "书名是……^0000CD摇 1000 次后会头晕^000000。请帮我借这本书。";
				npctalk "Ilya Lebedev：听说这是一本很有名的书。", "Ilya Lebedev#16.2rm", bc_self;
			setquest 16021;// Service: Book lending agent
			next;
			mes "[Jana Levedeva]";
			mes "普隆德拉图书馆的儿童区有专门的借阅制度。你可以询问负责儿童区的^0000CD图书管理员^000000。";
			close;
		case 16022:
			mes "[Jana Levedeva]";
			mes "嗯……Elena 指挥官让我们培养兴趣。";
			mes "我觉得阅读是很好的爱好，对吧？";
			next;
			mes "[Jana Levedeva]";

			setquest 16028;// Service: Cookies delivery
			setquest 16029;// Service: Cookies delivery
			setquest 16030;// Service: Cookies delivery
			setquest 16031;// Service: Cookies delivery
			close;
		}
		end;
	}
	switch( .@quest_list[.@i] ) {
	case 16021:
		mes "[Jana Levedeva]";
		mes "你忘了我要你借的书吗？被摇了一千次后头都晕了！";

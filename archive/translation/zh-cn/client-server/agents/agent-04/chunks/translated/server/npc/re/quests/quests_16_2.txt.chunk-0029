			mes .@genre$ + "，" + .@genre$ + "！我们做了些饼干！";
			mes "当然不是我们独自完成的……Milo 准备了材料和烹饪场地。";
			next;
			mes "[Jana Levedeva]";
			mes "味道很好！当然比不上 Lucy 奶奶做的，但还是很棒。";
			next;
			npctalk "我更喜欢 Lucy 做的饼干，但现在该开始吃这些了。";
			mes "[Jana Levedeva]";
			mes .@genre$ + "，请吃一点！" + .@genre$ + "，这是给你的……能把这五包饼干送给附近的人吗？";
			next;
			mes "[Jana Levedeva]";
			mes "送给 Milo、Mason 和 Rachel。";
			mes "也请送给 Adler 指挥官和 Elena 指挥官。";
			mes "记得告诉他们这是我们做的。";
			if (checkweight(25161,5) == 0) {
				next;
				mes "[Jana Levedeva]";
			mes "你的背包没有足够空间。";

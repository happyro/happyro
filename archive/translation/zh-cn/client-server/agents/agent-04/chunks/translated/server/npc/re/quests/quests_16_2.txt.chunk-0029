		mes "如果弄丢了……你必须去图书馆报告书籍遗失。";
			close;
		}
		mes "[" + strcharinfo(0) + "]";
		mes "我回来了。书在这里。";
		mes "你要自己归还吗？";
		next;
		mes "[Jana Levedeva]";
		mes "哇！我正想读这本！";
		mes "谢谢你，" + .@genre$ + "！要我为你读这本书吗？一定很精彩！";
		next;

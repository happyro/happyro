			close;
		case 16023:
			mes "[Jana Levedeva]";
			mes "嗯……Elena 指挥官让我们培养兴趣。";
			mes "我觉得阅读是很好的爱好，对吧？";
			next;
			mes "[Ilya Lebedev]";
			mes "如果能从普隆德拉图书馆儿童区借书给我，我会很高兴。";
			mes "书名是……^0000CD诺格罗德地平线^000000。";

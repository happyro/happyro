		mes "[Jana Levedeva]";
		mes "我害怕她会告诉我们什么……但我们还是会见她。";
			npctalk "Ilya Lebedev：总之这都是我们的错。", "Ilya Lebedev#16.2rm", bc_self;
		close;
	}
	.@genre$ = Sex ? "brother" : "sister";

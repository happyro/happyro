//===== rAthena Script ======================================= 
//= Swordsman Job Quest
//===== By: ================================================== 
//= kobra_k88; L0ne_W0lf
//===== Current Version: ===================================== 
//= 2.3
//===== Compatible With: ===================================== 
//= rAthena Project
//===== Description: ========================================= 
//= [Official Conversion]
//= Job quest for Swordman classes
//= Uses Job_sword1 as opposed to sword_1-1 -> sword_3-1.
//= EXPLOITABLE in a sense because while the sword_x-1 maps
//= are marked as "inside" by the client, job_sword1 is not.
//= giving players FREE camera rotation while doing the job quest.
//===== Additional Comments: ================================= 
//= 1.0 Fully working.
//= 1.1 Added instant job change for High Novice [Lupus]
//= 1.3 Added Baby Class support [Lupus]
//= 1.4 Changed the timing system to initnpctimer, now you do get warnings about time
//=     and are limited to 7min to complete the quest [Fredzilla]
//= 1.5 Optimised and moved first checker to Jfunc1-1 [massdriller]
//= 1.5.1 Fixed possible EXP abuse [Lupus]
//= 1.5.2 Now saves/restores all quest skills [Lupus]
//= 1.5.3 Removed Duplicates [Silent]
//= 1.6 Merged back JFunc, CHANGED NUMBERS TO CONSTANTS [Lupus]
//= 1.7 changed location from its clone to the original [Lupus]
//= 1.7.1 Fixed warp on timeout [KarLaeda]
//= 1.8 Rescripted to Aegis 10.3 stadards. [L0ne_W0lf]
//=     Removed "green" traps, quest is no longer timed.
//=     No longer uses function "F_ToHigh"
//= 1.9 Dialog is official, but the Script is now custom as far as maps go. [L0ne_W0lf]
//= 1.9b Fixed usage of wrong jobchange func messing up baby classes [ultramage]
//= 2.0 Corrected NPC names to fall within proper resctrictions. [L0ne_W0lf]
//= 2.1 Fixed mistake in condition check. [L0ne_W0lf]
//= 2.2 Warp portals dont end with ; [Yommy]
//= 2.3 Added Quest Log commands. [L0ne_W0lf]
//============================================================ 

izlude_in,74,172,4	script	Swordman#swd_1	119,{
	if (Upper == 1) {
		if (Class == Job_Novice_High && (ADVJOB == Job_Lord_Knight || ADVJOB == Job_Paladin)) {
			mes "[剑士]";
			mes "这……";
			mes "不可能……";
			mes "你转生了，对吧？";
			next;
			mes "[剑士]";
			mes "看来你再次踏上了剑士之路！习惯挥剑之后，就再也回不去了！！";
			next;
			if (!callfunc("F_CanChangeJob")) {
				mes "[剑士]";
				mes "嗯？啊，你必须先掌握基本技能，才能成为剑士。";
				next;
				mes "[剑士]";
				mes "学完新手基本技能后再来找我。";
				close;
			}
			mes "[剑士]";
			mes "太好了！我马上就为你转职为剑士！";
			next;
			skill "NV_TRICKDEAD",0,SKILL_PERM;
			jobchange Job_Swordman_High;
			skill "SM_MOVINGRECOVERY",1,SKILL_PERM;
			skill "SM_FATALBLOW",1,SKILL_PERM;
			skill "SM_AUTOBERSERK",1,SKILL_PERM;
			mes "[剑士]";
			mes "嗯……你看起来是经验丰富的剑士。不过，你仍需训练来提升技能和力量！";
			close;
		}
		else {
			mes "[剑士]";
			mes "嗯……？";
			mes "你是转生的";
			mes "战士，对吧？";
			next;
			mes "[剑士]";
			mes "嗯……";
			mes "看来成为剑士";
			mes "并不是你的命运。抱歉，";
			mes "";
			mes "看来我没有什么";
			mes "能为你做的事。";
			close;
		}
	}
	mes "[剑士]";
	mes "欢迎来到";
	mes "剑士协会！";
	next;
	mes "[剑士]";
	mes "那么……";
	mes "有什么事情";
	mes "需要我们帮忙？";
	next;
	switch(select("转职:关于剑士:关于转职要求:取消")) {
	case 1:
		if (BaseJob == Job_Swordman) {
			mes "[剑士]";
			mes "转职？哈哈哈！但你已经是剑士了！保持骄傲并变强吧！";
			close;
		}
		else if (BaseJob != Job_Novice) {
			mes "[剑士]";
			mes "哈哈！我很荣幸，但你已经有其他职业了！不过我不能怪你……";
			close;
		}
		if (job_sword_q == 0) {
			mes "[剑士]";
			mes "你想成为一名骄傲的剑士？当然，请报名！";
			next;
			if (select("Sign up.:Cancel.") == 1) {
				savepoint "izlude_in",65,165,1,1;
				set job_sword_q,1;
				setquest 1014;
				mes "[剑士]";
				mes "好的，我们会尽快审核你的申请。";
				next;
				mes "[剑士]";
				mes "如果你已经满足要求，现在就可以参加面试。你愿意吗？";
				next;
				if (select("Yes.:No.") == 1) {
					mes "[剑士]";
					mes "很好，很好。";
					mes "现在，让我看看……";
					next;
				}
				else {
					mes "[剑士]";
					mes "好的，准备好后随时回来。现在只需满足我们的要求。祝你好运。";
					close;
				}
			}
			else {
				mes "[剑士]";
				mes "嗯？好吧，改变主意后再回来。世界永远需要另一名剑士！";
				close;
			}
		}
		mes "[剑士]";
		if (!callfunc("F_CanChangeJob")) {
			mes "嗯，你还没学会全部基本技能。成为剑士前必须完成学习。";
			next;
			mes "[剑士]";
			mes "再检查一次转职要求，准备好后回来。";
			close;
		}
		else if (job_sword_q <= 3) {
			mes "嗯，你已经学会全部基本技能，但还没参加考试。通过考试后才能转职为剑士。";
			next;
			mes "[剑士]";
			mes "进入我右侧的房间参加考试。你需要与右侧人员交谈才能进入考场。";
			close;
		}
		else if (job_sword_q == 4) {
			mes "哈哈哈！恭喜！你已经完全具备成为真正剑士的资格！我马上为你转职！";
			next;
			callfunc "Job_Change",Job_Swordman;
			set job_sword_q,0;
			completequest 1014;
			mes "[剑士]";
			mes "再次恭喜。我希望你成为剑士协会的优秀代表。";
			close;
		}
	case 2:
		mes "[剑士]";
		mes "你想了解强大的剑士职业？那么……";
		next;
		mes "[剑士]";
		mes "在一转职业中，剑士凭借三个理由成为最强近战职业。";
		mes "剑士最适合战斗有三个理由！";
		next;
		mes "[剑士]";
		mes "第一，剑士拥有更高的 HP。第二，剑士通常能使用比其他一转职业更多的武器。";
		next;
		mes "[剑士]";
		mes "第三，大多数剑士技能都是强力物理攻击！我认为剑士是最棒的职业！";
		close;
	case 3:
		mes "[剑士]";
		mes "嗯……";
		if (BaseJob != Job_Novice) {
			if (BaseJob == Job_Swordman)
				mes "不过没必要告诉你要求。你已经满足要求并成为剑士了！总之……";
			else
				mes "你已经无法成为剑士，因为你已有其他职业。不过告诉你也无妨……";
		}
		next;
		mes "[剑士]";
		mes "第一，你必须学会全部 9 项基本技能。否则无法转职任何职业。";
		next;
		mes "[剑士]";
		mes "第二，你必须通过剑士考试。请向剑士考试等候室的考试管理员咨询。";
		next;
		mes "[剑士]";
		mes "完成这两项要求后，你随时可以转职为剑士。";
		close;
	case 4:
		mes "[剑士]";
		mes "哈哈哈！";
		mes "啊，青春！";
		close;
	}
}

izlude_in,62,170,6	script	Swordman#swd_2	85,{
	mes "[剑士]";
	if (BaseJob == Job_Swordman) {
		mes "抱歉，我只允许新手进入考试大厅。";
		close;
	}
	else if (BaseJob != Job_Novice) {
		mes "你到底是谁？！除了新手，任何人都不许进来！";
		close;
	}
	else if (!callfunc("F_CanChangeJob")) {
		mes "站住！学完全部基本技能前不能进来。考试大厅不是玩闹的地方！";
		close;
	}
	else if (job_sword_q == 4) {
		mes "嘿。你需要和房间中央的剑士交谈，不是我。";
		close;
	}
	else if (job_sword_q == 0) {
		mes "站住！想参加剑士考试，必须先填写申请。";
		next;
		mes "[剑士]";
		mes "房间中央的剑士会帮助你，明白吗？";
		close;
	}
	else {
		savepoint "izlude_in",65,165,1,1;
		warp "izlude_in",39,170;
		end;
	}
}

izlude_in,30,175,4	script	Swordman#swd_3	92,{
	mes "[剑士]";
	mes "我来告诉你考试内容！仔细听，我不会重复。";
	next;
	mes "[剑士]";
	mes "考试旨在确认你是否具备成为剑士的资格。剑士需要体力和精神！";
	next;
	mes "[剑士]";
	mes "没有这些就无法成为剑士。完成考试的条件很简单。";
	next;
	mes "[剑士]";
	mes "你要通过三条路线，并在 ^FF000010 分钟^000000内抵达最终检查点。";
	next;
	mes "[剑士]";
	mes "如果选择“投降”或时间耗尽，就无法通过考试。";
	next;
	mes "[剑士]";
	mes "如果发现自己实力不足，请前往路线入口与检查点管理员交谈。";
	next;
	mes "[剑士]";
	mes "通过三条路线时，你可能掉入随机地下区域。路线设计保证你仍能找到返回道路。";
	next;
	mes "[剑士]";
	mes "不过要小心，这会浪费时间！祝你好运。";
	close;
}

izlude_in,30,163,0	script	Test Hall Staff#swd_1	105,{
	mes "[考试大厅工作人员]";
	if (BaseJob == Job_Swordman) {
		mes "嗯？你怎么进来的？这里不允许你进入，请马上离开。";
		close2;
		warp "izlude_in",66,170;
		end;
	}
	else if (BaseJob != Job_Novice) {
		mes "你是谁？！这里是剑士考试场！不许进入！马上离开！";
		close2;
		warp "izlude_in",66,170;
		end;
	}
	if (job_sword_q == 1) {
		mes "你就是想成为剑士的人吗？很好！你看起来很可靠！";
		next;
		mes "[考试大厅工作人员]";
		mes "放松心情，尽力而为。这条路线并不难。";
		set job_sword_q,2;
	}
	else if (job_sword_q == 2) {
		mes "要重考吗？别担心。不畏惧挑战是好事！拿着这些，振作起来！";
		getitem 512,5; //Apple
		set job_sword_q,3;
	}
	else if (job_sword_q == 3)
		mes "永远不要放弃！现在开始重考！";
	close2;
	warp "job_sword1",10,245;
	end;
}


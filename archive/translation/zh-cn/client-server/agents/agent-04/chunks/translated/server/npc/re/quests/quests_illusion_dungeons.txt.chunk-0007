// End of the "Wizard illusions"


gef_d01_i,80,139,5	duplicate(dummy_cloaked_npc)	Gem#ilgf02	1_F_PRIEST,5,5
gef_d01_i,86,133,1	duplicate(dummy_cloaked_npc)	Marina#ilgf02	4_F_MONK,5,5
gef_d01_i,85,139,3	duplicate(dummy_cloaked_npc)	Antoine#ilgf02	4_GEFFEN_01,5,5
gef_d01_i,84,135,3	duplicate(dummy_cloaked_npc)	Dracula#ilgf03	4_DRACULA,5,5
gef_d01_i,87,137,3	duplicate(dummy_cloaked_npc)	King#ilgf02	4_NFBAT,5,5
gef_d01_i,80,132,7	duplicate(dummy_cloaked_npc)	Jojo#ilgf01	4_M_JOB_WIZARD,5,5


gef_d01_i,81,135,5	script	Wizard#ilgf01	4_F_BOMI,5,5,{
	if (checkweight(501,1) == 0 || (MaxWeight - Weight) < 1000) {
		mes "[Bomi]";
		mes "确定能带这么多东西吗？减轻包裹吧。";
		close;
	}
	.@player_name$ = strcharinfo(0);
	if (ill_vampire < 7) {
		mes "[Wizard]";
		mes "这个颜色和霓虹蘑菇不同。是新品种吗？我最好小心采摘……";
		close;
	}
	if (ill_vampire == 7) {
		mes "[Wizard]";
		mes "这个颜色和霓虹蘑菇不同。是新品种吗？我最好小心采摘……";
		next;
		mes "[" + .@player_name$ + "]";
		mes "^0000cd典型的法师^000000……那会是^0000cdJojo^000000吗？";
		next;
		select("Jojo？");
		mes "[Wizard]";
		mes "……？你是人类吗？";
		next;
		mes "[" + .@player_name$ + "]";
		mes "Jojo？你就是 Jojo，对吧？你的同事很担心你。我们回去吧。你没受伤吧？";
		next;
		mes "[Wizard]";
		mes "不，我不是 Jojo。";
		next;
		mes "[Wizard]";
		mes "我看起来像^0000cd人类^000000吗？";
		next;
		mes "[" + .@player_name$ + "]";
		mes "当然。";
		next;
		mes "[Wizard]";
		mes "...";
		next;
		emotion ET_HUK, playerattached();
		select("……你不是人类吗？");
		mes "[Wizard]";
		mes "我……我的名字是^0000cdBomi^000000。抱歉，我不是你要找的人。";
		next;
		mes "[" + .@player_name$ + "]";
		mes "Bomi？等等，你就是那个 Bomi？";
		next;
		mes "[Bomi]";
		mes "你认识我吗？";
		next;
		select("我捡到了你的笔记本。");
		mes "[" + .@player_name$ + "]";
		mes "我不是想多管闲事。我只是必须知道它属于谁，这样我才能……？";
		next;
		mes "[Bomi]";
		mes "我把它扔了。";
		next;
		mes "[" + .@player_name$ + "]";
		mes "你为什么扔掉？为什么待在这里？";
		next;
		mes "[Bomi]";
		mes "因为我是怪物。我属于这里。";
		next;
		select("你为什么认为自己是怪物？");
		mes "[Bomi]";
		mes "因为我是吸血鬼。";
		next;
		select("吸血鬼？！");
		mes "[" + .@player_name$ + "]";
		mes "发生了什么？你曾是人类。";
		next;
		mes "[Bomi]";
		mes "我被最好的朋友背叛了。";
		unittalk getcharid(3), "" + .@player_name$ + "：……你被背叛了？", bc_self;
		next;
		mes "[Bomi]";
		mes "大多数人知道无法永生，所以努力过好一生。";
		next;
		mes "[Bomi]";
		mes "我的寿命比大多数人短。自出生以来，人们就告诉我，我不会活过父母。";
		next;
		mes "[Bomi]";
		mes "人们总渴望自己没有的东西。我渴望^0000cd力量^000000，因我太矮小虚弱，无法像同龄人一样生活。";
		next;
		mes "[Bomi]";
		mes "我成为魔法师，因为我以为魔法可以弥补身体的弱点。";
		next;
		mes "[Bomi]";
		mes "但我没意识到，强大的精神来自强健的身体……";
		next;
		mes "[Bomi]";
		mes "魔法让我的精神和身体都疲惫不堪。我比想象中更快达到极限。但我没有沮丧，我以为可以补救。";
		unittalk getcharid(3), "" + .@player_name$ + "：哦。所以你才在这些地下墓穴研究僵尸。", bc_self;
		next;
		mes "[Bomi]";
		mes "是的。那样做时，我感觉比以往更有生命力。对生命的强烈渴望造就了现在的我。";
		next;
		mes "[Bomi]";
		mes "后来有一天，我在这里遇到一个非人类的^0000cd存在^000000。";
		next;
		mes "Bomi 正在整理思绪。我之后再和她谈。";
		erasequest 14657;// Jojo Is the Mage's Name
		setquest 14659;// Lost in Thought
		ill_vampire = 8;
		// note: the "old memories" npcs are not automatically cloakoff
		close;
	}
	if (ill_vampire == 8) {
		setpcblock PCBLOCK_NPC, true;
		npctalk "你知道我在这里发现了什么吗？", "", bc_self;
		sleep2 1000;
		unittalk getcharid(3), "" + .@player_name$ + "：噩梦、蘑菇、僵尸……", bc_self;
		sleep2 2000;
		npctalk "还有一个。", "", bc_self;
		sleep2 1000;
		unittalk getcharid(3), "" + .@player_name$ + "：你说的是 Dracula？我听说过他。", bc_self;
		sleep2 2500;
		npctalk "我第一次见到他时，他已经濒临死亡。他的脆弱让我强烈地想起自己。", "", bc_self;
		sleep2 2000;
		npctalk "所以我把自己的血喂给他并照料他的伤口，尽管我知道不该这么做。", "", bc_self;
		sleep2 2000;
		npctalk "后来我再次遇见他，我们变得亲近。他是我第一个真正的朋友。", "", bc_self;
		sleep2 1500;
		cloakoffnpcself( "Dracula#ilgf01" );
		specialeffect EF_GUARD2, AREA, "Dracula#ilgf01";
		specialeffect EF_BLUELIGHTBODY, AREA, "Dracula#ilgf01";
		npctalk "你为什么救我？", "Dracula#ilgf01", bc_self;
		sleep2 2000;
		npctalk "很难解释。就说我们人类喜欢拯救他人吧。", "", bc_self;
		sleep2 2000;
		npctalk "不是这样的。你们同类中的其他人只想杀了我。", "Dracula#ilgf01", bc_self;
		sleep2 2000;
		npctalk "我们并不是完全相同的。", "", bc_self;
		sleep2 1500;
		npctalk "我送你一件礼物来报答你的帮助如何？我知道你想要强健的身体和长寿。", "Dracula#ilgf01", bc_self;
		sleep2 1500;
		npctalk "但是怎么做？等等，你是说……？不用了，谢谢。", "", bc_self;
		sleep2 1500;
		npctalk "你渴望它们，所以才冒着生命危险在这种地方研究。", "Dracula#ilgf01", bc_self;
		sleep2 1500;
		npctalk "是的，但我不想为了它们放弃人性。", "", bc_self;
		sleep2 2000;
		npctalk "但你害怕死亡，而且你的生命所剩无几。", "Dracula#ilgf01", bc_self;
		sleep2 1500;
		npctalk "对死亡的恐惧正是支撑我活下去的东西。它造就了现在的我。", "", bc_self;
		sleep2 2000;
		npctalk "为了永生放弃人性，违背我的信念、至今的努力，以及我一直努力保护的一切。", "", bc_self;
		sleep2 2000;
		npctalk "最重要的是，那等于放弃自己，而我做不到。", "", bc_self;
		sleep2 2000;
		npctalk "即使你被转化，你仍然是你。", "Dracula#ilgf01", bc_self;
		sleep2 1500;
		npctalk "外表上也许是。但我将不再害怕死亡，也就不再渴望活着。", "", bc_self;
		sleep2 2000;
		npctalk "看着你日渐衰弱，我很痛苦。", "Dracula#ilgf01", bc_self;
		sleep2 2000;
		setpcblock PCBLOCK_NPC, false;

		npctalk "我不能说理解你的逻辑，但我会尊重你的愿望。", "Dracula#ilgf01", bc_self;
		mes "[Bomi]";
		mes "所以他^0000cd答应了^000000。后来有一天，一些人来这里找他，并发生了战斗。";
		next;
		mes "[Bomi]";
		mes "回过神时，我已经被转化了。Dracula 背弃了诺言。";
		next;
		npctalk "你怎么能这样对我？！", "", bc_self;
		sleep2 1000;
		npctalk "对不起。", "Dracula#ilgf01", bc_self;
		sleep2 1500;
		specialeffect EF_GUARD2, AREA, "Dracula#ilgf01";
		cloakonnpcself( "Dracula#ilgf01" );
		mes "[Bomi]";
		mes "我不敢相信他把我变成了怪物。我信任他！";
		next;
		mes "[Bomi]";
		mes "外面的人一定以为我离开了城镇。我离开多久了？";
		next;
		mes "[Bomi]";
		mes "唉，也许他们都忘了我，就像我从未存在过。最让我痛苦的就是这个。";
		next;
		mes "[Bomi]";
		mes "我试图无视现实，但持续的饥饿和口渴不断提醒我自己是怎样可怕的怪物。";
		next;
		mes "[Bomi]";
		mes "如果回到外面的世界，我无法阻止自己伤害别人。";
		next;
		select("你到现在是如何维持的？");
		mes "[Bomi]";
		mes "我研究了^0000cd药剂配方^000000，想用药水弥补体力不足。";
		next;
		mes "[Bomi]";
		mes "我用这里找到的材料制作假血饮用。我看起来或许^0000cd足够像人类^000000，实际上并不是。";
		next;
		mes "[Bomi]";
		mes "抱歉我的故事让你无聊了。";
		next;
		mes "[" + .@player_name$ + "]";
		mes "一点也不。";
		next;
		mes "[Bomi]";
		mes "冒险者，我不想滥用你的好意，但可以请你帮个忙吗？";
		next;
		select("当然，什么都可以。" );
		mes "[Bomi]";
		mes "你不该这么说。要是我想要你的血呢？";
		emotion ET_SWEAT, playerattached();
		next;
		mes "[Bomi]";
		mes "我开玩笑的。我正在收集假血材料，但现在想检查这株蘑菇。我以前没见过，想趁它还新鲜时研究。";
		next;
		mes "[" + .@player_name$ + "]";
		mes "你需要什么材料？我帮你拿来。";
		next;
		mes "[Bomi]";
		mes "谢谢。我需要^0000cd10 个 Matte Drainliar 的黏血和 10 个霓虹蘑菇的蘑菇汁^000000。谢谢你帮忙。";
		erasequest 14659;// Lost in Thought
		setquest 14660;// Ingredients for Fake Blood
		ill_vampire = 9;
		close;
	}
	if (ill_vampire == 9) {
		mes "[" + .@player_name$ + "]";
		mes "给，我带来了你要的东西。";
		next;
		mes "[Bomi]";
		mes "让我看看……";
		next;
		if (countitem(25268) < 10 || countitem(25269) < 10) {
			mes "[Bomi]";
			mes "这些不够。";
			next;
			mes "[Bomi]";
			mes "谢谢。我需要^0000cd10 个 Matte Drainliar 的黏血和 10 个霓虹蘑菇的蘑菇汁^000000。谢谢你帮忙。";
			close;
		}
		mes "[Bomi]";
		mes "谢谢。";
		next;
		mes "[" + .@player_name$ + "]";
		mes "蘑菇怎么样？";
		next;
		mes "[Bomi]";
		mes "结果是普通而毫无价值的蘑菇。";
		next;
		select("你如何制作人造血？" );
		mes "[Bomi]";
		mes "Matte Drainliar 以这里复活尸体的血为食。";
		next;
		mes "[Bomi]";
		mes "明白了吗？但它们的血液毒性很强。所以我用这些蘑菇解毒。";
		next;
		mes "[Bomi]";
		mes "就像这样！";
		specialeffect EF_PHARMACY_OK;
		next;
		mes "[Bomi]";
		mes "但即使是它们的汁液也无法完全清除血液中的毒素。而当我摄入太多毒素……";
		next;
		select("也许你该选择另一条职业道路。" );
		mes "[" + .@player_name$ + "]";
		mes "比如炼金术士。";
		next;
		mes "[Bomi]";
		mes "我不知道自己有这方面的天赋。如果还有^0000cd足够的生命时间^000000，应该能体验许多不同的事，也许会选择另一条路。";
		next;
		mes "[Bomi]";
		mes "哦，对了，你不是在找人吗？他叫什么来着？Juju？";
		next;
		select("Jojo。" );
		mes "[Bomi]";
		mes "我没在附近见过其他人类，但如果见到，我会告诉他你在找他。";
		next;
		mes "[Bomi]";
		mes "希望你很快找到他。这里不只有我。既然没找到他，也许他在……？";
		next;
		mes "[Bomi]";
		mes "算了。祝你找到他。也许你该去南边的地下墓穴看看。";
		next;
		mes "[" + .@player_name$ + "]";
		mes "谢谢。再见。";
		next;
		mes "[Bomi]";
		mes "你最好快点。";
		cloakoffnpcself( "Dracula#ilgf02" );
		cloakoffnpcself( "King#ilgf01" );
		cloakoffnpcself( "Wizard#ilgf02" );
		delitem 25268,10;// Sticky_Blood
		delitem 25269,10;// Mushroom_Sap
		erasequest 14660;// Ingredients for Fake Blood
		setquest 14661;// Jojo Is the Mage's Name 02
		ill_vampire = 10;
		close;
	}
	if (ill_vampire < 12) {
		cloakoffnpcself( "Dracula#ilgf02" );
		cloakoffnpcself( "King#ilgf01" );
		cloakoffnpcself( "Wizard#ilgf02" );
		mes "[Bomi]";
		mes "希望你尽快找到朋友。为什么不去南边的地下墓穴看看？他可能在那里。";
		close;
	}
	if (ill_vampire == 12) {
		viewpoint 2,85,131,1,0x00FF00;
		cloakoffnpcself( "Gem#ilgf02" );
		cloakoffnpcself( "Marina#ilgf02" );
		cloakoffnpcself( "Antoine#ilgf02" );

		mes "[Bomi]";
		mes "离我远点，我就不会伤害你。";
		next;
		mes "[Marina]";
		mes "我们少了一个人。是你伤害了他，对吧？";
		next;
		mes "[Bomi]";
		mes "我从未伤害过任何人，现在也不会开始。";
		next;
		mes "[Marina]";
		mes "即使你不伤害，我们也不会放你走！你的存在本身就违背祂的意志！";
		next;
		mes "[Bomi]";
		mes "祂的意志？上帝爱我们所有人。你们不是这样教导的吗？";
		next;
		mes "[Marina]";
		mes "死者就该回到大地，而你就是死者。你以为自己是什么？";
		next;
		mes "[Bomi]";
		mes "……但是……我真的没有伤害任何人。";
		next;
		mes "[Marina]";
		mes "这不能保证你将来不会伤害。";
		next;
		mes "[Gem]";
		mes "等等，Marina 修女。冷静。";
		next;
		mes "[Marina]";
		mes "我们为什么还不除掉她？死者应当回归大地！Antoine 兄弟！";
		npctalk "唉，Marina 修女说得对。", "Antoine#ilgf02", bc_self;
		npctalk "Guillotine Fist!", "Marina#ilgf02", bc_self;
		sleep2 1000;
		cloakoffnpcself( "Dracula#ilgf03" );
		specialeffect EF_M01, AREA, "Dracula#ilgf03";
		specialeffect EF_BOTTOM_MAG, AREA, "Dracula#ilgf03";
		specialeffect EF_BEGINASURA, AREA, "Dracula#ilgf03";
		sleep2 1000;
		specialeffect EF_DRAGONFEAR, AREA, "Dracula#ilgf03";
		specialeffect EF_BLEEDING, AREA, "Dracula#ilgf03";
		specialeffect EF_COLDTHROW, AREA, "Dracula#ilgf03";
		specialeffect EF_TEIHIT1X, AREA, "Dracula#ilgf03";
		npctalk "Ugh!", "Dracula#ilgf03", bc_self;
		next;
		cloakoffnpcself( "King#ilgf02" );
		specialeffect EF_M01, AREA, "King#ilgf02";
		emotion ET_ANGER, getnpcid(0, "King#ilgf02");
		mes "[King]";
		mes "啊，我不敢相信你冲进了中间！所以我才不能放你一个人！";
		next;
		mes "[Bomi]";
		mes "……Dracula？为什么？";
		next;
		mes "[Marina]";
		mes "还有一个吸血鬼！难怪这里感觉不对，原来到处都是吸血鬼！";
		npctalk "嘿，那边的蝙蝠！你也是吸血鬼吗？", "Marina#ilgf02", bc_self;
		sleep2 1000;
		npctalk "吸血鬼叫人帮忙了吗？", "Antoine#ilgf02", bc_self;
		next;
		emotion ET_FRET, getnpcid(0, "King#ilgf02");
		mes "[King]";
		mes "人类，你刚才叫我蝙蝠？你竟敢这样说？";
		next;
		mes "[Gem]";
		mes "等等，Marina 修女。我说了，冷静。";
		next;
		mes "[Marina]";
		mes "我们必须现在行动。三人中已经有一人失去行动能力。";
		next;
		mes "[Gem]";
		mes "但其中一个不想战斗。她想谈谈。";
		next;
		mes "[King]";
		mes "谁想谈？我不想！我不会不战而败！";
		specialeffect EF_TEIHIT1X, AREA, "King#ilgf02";
		specialeffect EF_SUI_EXPLOSION, AREA, "Marina#ilgf02";
		specialeffect EF_DARKBREATH, AREA, "Marina#ilgf02";
		next;
		mes "[Marina]";
		mes "可恶，放开我！够了！";
		next;
		cloakoffnpcself( "Jojo#ilgf01" );
		specialeffect EF_TELEPORTATION2, AREA, "Jojo#ilgf01";
		emotion ET_CONFUSE, getnpcid(0, "Jojo#ilgf01");
		mes "[Jojo]";
		mes "天啊，你怎么移动得这么快？";
		next;
		mes "[Jojo]";
		mes "大家都给我冷静！";
		next;
		mes "[Gem]";
		mes "Jojo 兄弟！你平安无事！";
		next;
		mes "[Marina]";
		mes "你去哪儿了？我们找不到你，已经到处找过了！";
		next;
		mes "[Antoine]";
		mes "是真的。他的伤口几乎完全愈合了。";
		next;
		mes "[Dracula]";
		mes "别碰 Bomi……她……我……我们不想伤害任何人……是她教会我的……";
		npctalk "哼，你还是担心自己吧，你快死了！", "King#ilgf02", bc_self;
		next;
		mes "[Bomi]";
		mes "Dracula！Dracula！让我治好你！";
		next;
		mes "[Marina]";
		mes "我不会让你这么做！";
		next;
		mes "[Gem]";
		mes "放过他们。他们救了 Jojo。";
		next;
		mes "[Marina]";
		mes "但他们可能把他当诱饵！";
		next;
		mes "[Gem]";
		mes "即使他们想攻击我们，我们的人也比他们多。";
		npctalk "你以为人数没有优势，那是妄想。", "King#ilgf02", bc_self;
		next;
		mes "[Antoine]";
		mes "我同意 Gem 修女的看法。而且能这么近观察吸血鬼，不是每天都有的机会。";
		next;
		mes "[Gem]";
		mes "你是 Bomi，对吧？我读过你的笔记。发生了什么？这些吸血鬼对你做了什么？";
		next;
		select("我可以解释。" );
		mes "我向 Gem 修女和其他人讲述了 Bomi 与 Dracula 的故事。";
		next;
		mes "[Gem]";
		mes "所以你是说他们确实是无辜的。";
		next;
		mes "[Bomi]";

		mes "铃铛，确认。";
		mes "干燥星百合，确认。";
		mes "绳子系了 33 圈，确认。";
		mes "帆上有 5 道褶皱，确认。很好！";
		next;
		mes "[Boatswain]";
		mes "什么！谁折断了这根柳枝！";
		close;
	}
	if (lasagna_quest[1] == 16) {
		mes "[" + strcharinfo(0) + "]";
		mes "你好，我是" + strcharinfo(0) + "，这次踏上新的冒险。很高兴认识你。";
		next;
		mes "[Sous Chef]";
		mes "......";
		npctalk "你真冷淡。", "", bc_self;
		npctalk "他大概没听见。", "Helmsman#dorcon", bc_self;
		next;
		mes "[Boatswain]";
		mes "哦，你是即将前往新大陆冒险的新晋冒险者。我喜欢冒险精神。年轻时我也曾四处旅行。";
		next;
		mes "[Helmsman]";
		mes "具体是什么时候？多久以前？";
		next;
		mes "[Boatswain]";
		mes "没多久。感觉就像昨天发生的。";
		next;
		mes "[Helmsman]";
		mes "昨天你还在半夜跑过甲板。";
		next;
		mes "[Boatswain]";
		mes "呼，真是胡闹。";
		next;
		mes "[Sous Chef]";
		mes "嘿，我明白了。那里太吵了。你现在可以走了。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes ".......";
		next;
		mes "[Boatswain]";
		mes "副厨师长出航前总是很紧张。别往心里去。";
		npctalk "这不代表他不喜欢你。", "Helmsman#dorcon", bc_self;
		next;
		mes "[Helmsman]";
		mes "成熟的杜拉姆不会计较这些。你可以走了。我们马上出发。";
		erasequest 14534;// To the kitchen
		setquest 14535;// To Purser
		getexp 200,300;
		lasagna_quest[1] = 17;
		close;
	}
	if (lasagna_quest[1] == 17) {
		mes "[Boatswain]";
		mes "我们快要出航了。你该回去了。";
		close;
	}
	if (lasagna_quest[1] < 29) {
		mes "[Boatswain]";
		mes "玩偶，确认。";
		mes "铃铛，确认。";
		mes "干燥星百合，确认。";
		mes "绳子系了 33 圈，确认。";
		mes "帆上有 5 道褶皱，确认。很好！";
		close;
	}

	if (conch_in_boatswain == 0) {// start for daily quest
		mes "[Boatswain]";
		mes "玩偶，确认。";
		mes "铃铛，确认。";
		mes "干燥星百合，确认。";
		mes "绳子系了 33 圈，确认。";
		mes "5 creases on the sail, check.";
		next;
		mes "[Boatswain]";
		mes "什么！谁折断了这根柳枝！";
		npctalk "哦，又来了。", "Helmsman#dorcon", bc_self;
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "你似乎遇到麻烦了。怎么回事？";
		next;
		if (BaseLevel < 140) {
			mes "[Boatswain]";
			mes "你似乎经验不足，无法解决我的问题。积累更多经验后再回来。";
			close;
		}
		mes "[Boatswain]";
		mes "我们随时要出发，但航行准备还没做好。";
		npctalk "哦！冒险者！你不用这么认真地对付他……！", "Helmsman#dorcon", bc_self;
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "我不太懂航海，但这些听起来都和船无关。";
		next;
		mes "[Boatswain]";
		mes "这不关你的事……不过，^0000cd来自陌生地方的人就该解决这个问题^000000。";
		npctalk "而来自陌生地方的人现在就站在我面前。", "", bc_self;
		next;
		mes "[Boatswain]";
		mes "我是水手中的水手，真正的海员。我是这艘船的水手长，负责照看那些强悍的水手和甲板上的一切事务。接下来我要告诉你的故事……不该告诉任何其他人。";
		next;
		mes "[Boatswain]";
		mes "这样你就会知道水手能有多么可怕。";
		next;
		if (select( "是什么？", "我不想听。" ) == 2) {
			mes "[Boatswain]";
			mes "那就回到你的岗位。以后别指望我帮忙。";
			close;
		}
		mes "[Boatswain]";
		mes "很好。我喜欢你不向威胁屈服的态度。我也是。嗯，以前也是。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "你为什么用过去时？";
		next;
		mes "[Boatswain]";
		mes "你相信看不见的东西吗？比如并不存在的东西？尤其是夜里出现的特殊存在……";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "哦，死者。";
		next;
		mes "[Boatswain]";
		mes "你说得对。我曾无所畏惧，喜欢冒险之类的事。遇到甘贝里船长后，我来到拉萨格纳，成了康奇利纳号的水手长。";
		npctalk "那是我一生中最珍贵的时刻。", "", bc_self;
		next;
		mes "[Boatswain]";
		mes "我去过各处。有一天，我找到了它。";
		next;
		mes "[Boatswain]";
		mes "海上有许多无人居住的岛屿。有时你会在岛中央发现埋着的罐子。";
		next;
		mes "[Boatswain]";
		mes "船停泊在一座未知岛屿补充淡水时，我像往常一样探索岛屿。在那里发现了一个^0000cd封印的罐子^000000。";
		npctalk "我当时就该把它留在那里，转身离开。", "", bc_self;
		next;
		mes "[Boatswain]";
		mes "我摇了摇它，却没有声音。我很好奇里面究竟有什么，为什么封得这么严实却没有声音。";
		npctalk "都说好奇心会害死杜拉姆……", "", bc_self;
		next;
		mes "[Boatswain]";
		mes "来到那里的甘贝里试图阻止我，但我打开了封印。^0000cd罐子^000000里什么也没有，也什么都没发生。";
		next;
		mes "[Boatswain]";
		mes "我扔掉罐子，登上康奇利纳号。那天夜里事情发生了。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "哦，我想精彩部分要来了。我很喜欢。";
		next;
		mes "[Boatswain]";
		mes "那天夜里，我听到了这首歌。无论在哪里都能听见。我能从掌心的纹路、耳边和银色波浪中听到它。";
		next;
		mes "[Boatswain]";
		mes "感觉伸手就能抓住那段旋律。我循着声音走着，有人狠狠摇醒了我。回过神时，船员们正抓着我，就在我跳下船前一刻。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "被歌声迷住了？";
		next;
		mes "[Boatswain]";
		mes "我也这么想。我捂着耳朵睡觉。奇怪的是，第二天和再后一天又发生了。";
		next;
		mes "[Boatswain]";
		mes "每天晚上我都看到模糊的身影，或因耳边喋喋不休的声音无法入睡。睡着后又感觉身体沉重，醒来时浑身冷汗。";
		next;
		mes "[Boatswain]";
		mes "原来那是封印邪灵的罐子。甘贝里知道这一点并试图阻止我。但已经太迟，我已经打破了封印。我在陆地上长大，完全不知道这些。";
		npctalk "人只能看见自己所知的范围。", "", bc_self;
		next;
		mes "[Boatswain]";
		mes "从那以后，我一直遭受^0000cd超自然现象^000000的折磨。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "你的意思是里面的东西诅咒了你，对吧？";
		next;
		mes "[Boatswain]";
		mes "甘贝里带我去找喵萨满咨询，但没有用。这个邪灵太古老、太强大又太执着，根本无法驱除。";
		next;
		mes "[Boatswain]";
		mes "我唯一能做的，就是每天尽可能削弱它。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "依靠各种迷信就是削弱它的方法吗？";
		npctalk "迷信？不，这是纯粹的科学。", "", bc_self;
		next;
		mes "[Boatswain]";
		mes "除了甘贝里船长和我，康奇利纳号的其他船员都不知道这件事。";
		next;
		mes "[Boatswain]";
		mes "^0000cd喵萨满^000000告诉我一个谜语，说来自陌生地方的人会解决这个问题。我们相遇绝非偶然。";
		next;
		mes "[Boatswain]";
		mes "请去把这个故事告诉喵萨满，并带回驱除它的办法。只要你能解决这件事，我什么都愿意为你做。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "什么都愿意？这是承诺吗？";
		next;
		mes "[Boatswain]";
		mes "康奇利纳号的水手长从不撒谎。不相信我，就该相信雇我当水手长的甘贝里。";
		npctalk "我绝不会背叛甘贝里。", "", bc_self;
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "我很快回来。";
		next;
		mes "[Boatswain]";
		mes "喵萨满住在村庄入口附近的僻静处。";
		setquest 14556;// There also is a scary thing for me
		conch_in_boatswain = 1;
		close;
	}
	if (conch_in_boatswain == 1) {
		mes "[Boatswain]";
		mes "喵萨满住在拉萨格纳入口的僻静处。希望像你这样来自陌生地方的人能解决我的问题。";
		close;
	}
	if (conch_in_boatswain == 2) {
		mes "[Boatswain]";
		mes "亲爱的冒险者，你见到喵萨满了吗？";
		next;
		mes "[You told the Boatswain the story you had heard from Shaman meow.]";
		next;
		mes "[Boatswain]";
		mes "什么？我应该成为喵萨满？胡说八道！我是水手！我要作为水手死在海上！";
		npctalk "喂，你！安静！不许笑！", "", bc_self;
		next;
		mes "[Boatswain]";
		mes "我宁愿余生战斗，也不愿和鬼魂一起生活！";
		npctalk "没错！你就是鬼魂！", "", bc_self;
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "喵萨满没你想的那么糟。有时间就去咨询一下吧。";
		next;
		mes "[Boatswain]";
		mes "我就当你没说过！我才不在乎喵萨满那些恶毒的话！";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "邪灵会吸走你的生命。这样下去你撑不了几天，亲爱的水手长。";
		next;
		mes "[Boatswain]";
		mes "什么？等等……那是……";
		npctalk "这可不妙……我撑不了多久？", "", bc_self;
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "靠^0000cd每日护符^000000你可以撑过一天。我想你现在该和喵萨满多接触了。";
		next;
		mes "[Boatswain]";
		mes "......";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "今天的护符需要^0000cd20 个罗勒和 5 个蛇岩贝^000000。你可以从蛇蜥那里获得。";
		next;
		mes "[Boatswain]";
		mes "蛇……蛇蜥……真是刚出油锅又进火坑。我不想和那些肮脏的东西打交道。";
		npctalk "我干脆从甲板上跳下去算了……？", "", bc_self;
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "好了，我就说到这里。我该走了……";
		next;
		mes "[Boatswain]";
		mes "是啊，由陌生人来解决这个问题。这一定是我们的命运。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "其实意思是你会死，而邪灵会找到新的宿主。";
		next;
		mes "[Boatswain]";
		mes "不，不，绝不。你不能这样逃避。^0000cd这一定是我们的命运。^000000这是命运安排的！你应该帮我。";
		npctalk "而且你也会帮我的。", "", bc_self;
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "...Well, just as I heard from Shaman meow. I was told that the Boatswain would make me do it.";
		next;
		mes "[Boatswain]";
		mes "那个喵萨满似乎确实有远见。我现在相信了。我相信护符真的有效。请现在就去帮我弄一个。拜托。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "好吧，我没办法。今天先帮你。";
		erasequest 14557;// Truth is alway harsh
		setquest 14558;// Dirty Creatures
		conch_in_boatswain = 3;
		close;
	}
	if (conch_in_boatswain == 3) {
		if (countitem(25049) < 5 || countitem(22985) < 20) {
			mes "[Boatswain]";
			mes "今天的护符需要 20 个罗勒和 5 个蛇岩贝！太阳马上就要下山了！";
			close;
		}
		mes "[" + strcharinfo(0) + "]";
		mes "这是罗勒和蛇岩贝。";
		next;
		mes "[Boatswain]";
		mes "啊……给我。不，不，不是那样。稍微包起来，别让人看见。对，就这样。把你所有的都给我。";
		npctalk "真不敢相信我要整天带着它……", "", bc_self;
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "这真难办。";
		npctalk "嘿，你看起来很可疑。", "Helmsman#dorcon", bc_self;
		npctalk "不，没什么！", "", bc_self;
		next;
		mes "[Boatswain]";
		mes "这……这是……";
		specialeffect EF_CURE;
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "你觉得怎么样？";
		next;
		mes "[Boatswain]";
		mes "感觉笼罩我的黑雾正在散去！我再也听不到低语声了！我的头脑好久没有这么清醒了。";
		next;
		mes "[Boatswain]";
		mes "我居然到现在才知道这个方法，太不公平了！";
		npctalk "什么不公平？", "Helmsman#dorcon", bc_self;
		npctalk "没什么！你没有别的事要做吗？", "", bc_self;
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "它只能持续一天。失效后就会烧掉。我想从今以后你该多接近喵萨满。";
		next;
		mes "[Boatswain]";
		mes "不，绝不。我没打算和喵萨满交朋友，也没打算自己去猎杀蛇蜥。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "那你打算怎么办？";
		next;
		mes "[Boatswain]";
		mes "这不是有一个^0000cd新帮手^000000就在我面前吗？";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "我就知道！";
		emotion ET_FRET, playerattached();
		next;
		mes "[Boatswain]";
		mes "我会给你丰厚的报酬。不过你还没能永久解决这个问题，所以我不必履行之前的承诺。";
		npctalk "你其实并没有彻底解决问题。", "", bc_self;
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "这不公平。";
		npctalk "这个水手长有点卑鄙。", "Helmsman#dorcon", bc_self;
		next;
		mes "[Boatswain]";
		mes "我会给你丰厚的报酬。明天再帮我一个忙吧。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "到时候再说吧。我想来的时候自然会回来。";
		next;
		mes "[Boatswain]";
		mes "哦，你会回来的。我有这种预感。";
		npctalk "我的预感从来不会错。", "", bc_self;
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "我敢肯定，是邪灵在和你说话。";
		next;
		mes "[Boatswain]";
		mes "看在你帮过我的份上，这次就算了。明天再见。";
		erasequest 14558;// Dirty Creatures
		setquest 14559;// Charm Effect Duration
		delitem 22985,20;// Basil
		delitem 25049, countitem(25049);// Basilac Clam
		getexp 500000,0;// none jexp
		conch_in_boatswain = 4;
		close;
	}
	if (conch_in_boatswain == 4) {
		switch( checkquest(14559,PLAYTIME) ) {
		case -1:
			if (isbegin_quest(14560) == 1)
				.@count = ( countitem(25049) < 5 || countitem(523) < 1 );
			else if (isbegin_quest(14561) == 1)
				.@count = ( countitem(25049) < 20 );
			else
				.@count = ( countitem(25049) < 5 || countitem(22985) < 20 );
			if (.@count == 0) {
				mes "[Boatswain]";
				mes "你带来今天的护符了吗？看起来你两手空空。出什么事了吗？";
				next;
				mes "[Boatswain]";
				mes "请现在就给我。我感觉护符的力量正在消退。";
				close;
			}
			mes "[Boatswain]";
			mes "这就是今天的护符！把你所有的蛇岩贝都给我。";
			next;
			mes "[Boatswain]";
			specialeffect EF_CURE;
			if (isbegin_quest(14560) == 1) {
				mes "感觉就像在晴朗无风的日子眺望蓝色地平线，真令人神清气爽。";
				next;
				erasequest 14560;// New Ingredient
				delitem 25049,5;// Basilac Clam
				delitem 523,1;// Holy Water
			}
			else if (isbegin_quest(14561) == 1) {
				mes "感觉就像仰卧在绿色山丘上，看着云朵飘过。";
				next;
				delitem 25049,20;// Basilac Clam
				erasequest 14561;// Dirty and Filty
			}
			else {
				mes "感觉就像透过黑雾看见阳光。";
				next;
				delitem 22985,20;// Basil
				delitem 25049,5;// Basilac Clam
				erasequest 14562;// The basic are the best
			}
			setquest 14559;// Charm Effect Duration
			mes "[Boatswain]";
			mes "谢谢你替我弄来这些。明天请再来。";
			getexp 500000,0;
			close;
		case 0:
		case 1:
			mes "[Boatswain]";
			mes "你说过想来的时候才会来。";
			next;
			mes "[Boatswain]";
			mes "护符仍然有效。^0000cd凌晨 4:00^000000 后去见喵萨满，带回明天的护符。";
			close;
		case 2:
			mes "[Boatswain]";
			mes "你说过想来的时候才会来。";
			npctalk "不来你就觉得不自在了，对吧？", "", bc_self;
			next;
			mes "[Boatswain]";
			mes "不过你不该来找我。你应该去^0000cd喵萨满^000000那里询问今天的护符。";
			next;
			mes "[Boatswain]";
			mes "那就拜托你了。";
			close;
		}
	}
}

conch_in,181,58,3	script	Helmsman#dorcon	4_CAT_SAILOR5,{
	if (checkweight(1001,1) == 0) {
		mes "[Helmsman]";
		mes "看起来又多又大。减少一些怎么样？";
		close;
	}
	if (lasagna_quest[1] < 16) {
		mes "[Helmsman]";
		mes "只要有风和帆，我们哪里都能去。";
		close;
	}
	if (lasagna_quest[1] == 16) {
		mes "[" + strcharinfo(0) + "]";
		mes "你好，我是" + strcharinfo(0) + "，这次踏上新的冒险。很高兴认识你。";
		next;
		mes "[Sous Chef]";
		mes "......";
		npctalk "你真冷淡。", "Boatswain#dorcon", bc_self;
		npctalk "他大概没听见。", "", bc_self;
		next;
		mes "[Boatswain]";
		mes "哦，你是即将前往新大陆冒险的新晋冒险者。我喜欢冒险精神。年轻时我也曾四处旅行。";
		next;
		mes "[Helmsman]";
		mes "具体是什么时候？多久以前？";
		next;
		mes "[Boatswain]";
		mes "没多久。感觉就像昨天发生的。";
		next;
		mes "[Helmsman]";
		mes "昨天你还在半夜跑过甲板。";
		next;
		mes "[Boatswain]";
		mes "呼，真是胡闹。";
		next;
		mes "[Sous Chef]";
		mes "嘿，我明白了。那里太吵了。你现在可以走了。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes ".......";
		next;
		mes "[Boatswain]";
		mes "副厨师长出航前总是很紧张。别往心里去。";
		npctalk "这不代表他不喜欢你。", "", bc_self;
		next;
		mes "[Helmsman]";
		mes "成熟的杜拉姆不会计较这些。你可以走了。我们马上出发。";
		erasequest 14534;// To the kitchen
		setquest 14535;// To Purser
		getexp 200,300;
		lasagna_quest[1] = 17;
		close;
	}
	if (lasagna_quest[1] == 17) {
		mes "[Helmsman]";
		mes "副厨师长认为做饭时有陌生人在场会带来厄运。你现在该走了。";
		close;
	}
	if (lasagna_quest[1] > 17) {
		mes "[Helmsman]";
		mes "只要有风和帆，我们哪里都能去。";
		close;
	}
}


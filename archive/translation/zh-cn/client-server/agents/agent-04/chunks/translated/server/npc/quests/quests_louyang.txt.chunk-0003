lou_in02,265,69,5	script	Doctor#lyang	814,{
	if ((MaxWeight-Weight) < 2000 || checkweight(1201,1) == 0) {
		mes "^3355FF等一下！你现在负重过高，无法再获得物品。请把一部分物品存入卡普拉仓库后再试。^000000";
		close;
	}
	if (ch_par == 0) {
		mes "[Hua Tuo]";
		mes "人体有许多穴位。自古以来，人们一直认为每个穴位的作用都受到限制，";
		mes "各自承担特定的功能。";
		next;
		mes "[Hua Tuo]";
		mes "然而，在研究并实验了每个穴位后，我得出结论：根据具体情况使用穴位，";
		mes "可能会产生不同的结果。";
		emotion ET_SURPRISE;
		next;
		mes "[Hua Tuo]";
		mes "少数穴位无论问题是什么都会表现出相同症状。大多数时候，穴位的效果会根据身体状况或时间而不同。";
		next;
		mes "[Hua Tuo]";
		mes "例如，位于肚脐上方的穴位是最脆弱的部位。";
		next;
		mes "[Hua Tuo]";
		mes "按压方式错误可能导致死亡。但在凌晨 5:15 到 7:15 之间，它只是一个弱点。";
		set ch_par,1;
		close;
	}
	else if (ch_par == 1) {
		if (BaseLevel < 40) {
			mes "[Hua Tuo]";
			mes "一个人的强大并不只是身体上的力量。";
			next;
			mes "[Hua Tuo]";
			mes "判断一个人的实力时，智慧、经验和知识等因素";
			mes "也同样重要。";
			next;
			mes "[Hua Tuo]";
			mes "假设你非常强大，并得到最强的武器。";
			next;
			mes "[Hua Tuo]";
			mes "如果你不知道如何使用武器的力量，就不会真正强大……你仍然很弱。";
			next;
			mes "[Hua Tuo]";
		mes "当工具或武器";
		mes "超出你的能力时，";
		mes "就会造成最糟糕的结果。";
			close;
		}
		mes "[Hua Tuo]";
		mes "嗯……";
		mes "我遇到麻烦了……";
		next;
		mes "[Hua Tuo]";
		mes "没有药我什么也做不了。但我的一名病人";
		mes "需要立即治疗，";
		mes "而我不能离开诊所……";
		emotion ET_PROFUSELY_SWEAT;
		next;
		if (select("我可以帮你。:真遗憾！") == 1) {
			mes "[Hua Tuo]";
			mes "嗯……？";
			mes "你……";
			mes "你是认真的吗？";
			next;
			mes "[Hua Tuo]";
			mes "这不会花太多力气，但让刚认识的人帮忙似乎有些过分。";
			next;
			if (select("如果你觉得有负担……:没关系，我很乐意帮忙。") == 1) {
				mes "[Hua Tuo]";
				mes "谢谢你这么说。";
				mes "我让刚认识的人帮忙，心里确实很过意不去。";
				mes "真的非常感谢。";
				next;
				mes "[Hua Tuo]";
				mes "不过，下次见面时我会再拜托你。";
				mes "现在，请容我先失陪……";
				mes "谢谢你的理解。";
				emotion ET_THANKS;
				close;
			}
			mes "[Hua Tuo]";
			mes "嗯，我明白了。";
			mes "那么，请你帮我一个忙。";
			mes "拜托了。";
			next;
			mes "[Hua Tuo]";
			mes "正如你刚才听到的，我需要一种特殊药物治疗这名病人。";
			mes "不过，我需要的药快用完了。";
			next;
			mes "[Hua Tuo]";
			mes "我需要你替我取来，因为现在不能离开等待我的病人。";
			next;
			mes "[Hua Tuo]";
			mes "^666666*叹气*^000000";
			mes "不幸似乎总是接踵而至，对吧？";
			mes "我的助手现在也忙于其他差事。";
			next;
			mes "[Hua Tuo]";
			mes "请去城里的工具店，";
			mes "把我需要的药带回来。";
			mes "告诉老板是我派你去的，他会明白。";
			next;
			mes "[Hua Tuo]";
			mes "很抱歉给你添了这么多麻烦，";
			mes "但还有其他病人在等我。请尽快带着";
			mes "药回来！";
			set ch_par,2;
			setquest 11044;
			close;

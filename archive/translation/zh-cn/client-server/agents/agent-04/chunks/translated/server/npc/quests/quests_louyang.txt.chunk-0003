	mes "[刘家林]";
	mes "它的细腻味道来自";
	mes "不含脂肪的纯肉熬制的汤。 所以也是女士们很受欢迎的减肥食品。";
	next;
	mes "[刘家林]";
	mes "味道好，对健康也很有益。 要不要点一碗？ 我从没见过尝过龙汤却不喜欢的人！";
	close;
}

lou_in02,43,169,1	script	Jiang Rong#lou	827,{
	mes "[江荣]";
	mes "龙汤以辛辣、甜美又清爽的味道闻名。";
	next;
	mes "[江荣]";
	mes "它用各种药草制作，所以也有益";
	mes "健康。";
	next;
	mes "[江荣]";
	mes "龙汤能排出体内产生的多余热气";
		mes "并促进血液循环。因此有助于优化身体机能，延年益寿。";
	next;
	mes "[江荣]";
		mes "我从小就经常喝龙汤。看看我，你不觉得以我的年龄来说我看起来很健康吗？";
	close;
}

louyang,261,123,3	script	Chi Wu Ping#lou	824,{
	mes "[齐武平]";
	mes "我感觉不好……";
	mes "完全……没精神……";
	next;
	mes "[齐武平]";
	mes "啊，我的身体好痛！";
	mes "我的肌肉全都酸痛……";
	mes "只有一件事能治好这折磨人的……疼痛……";
	next;
	emotion ET_SURPRISE;
	mes "[齐武平]";
	mes "嘿，小子～！";
	mes "你看起来不是本地人！";
	mes "沿着前面的路去看看大餐馆吧？";
	next;
	mes "[齐武平]";
	mes "他们卖的汤可能是你能找到的最健康食物。";
	next;
	mes "[齐武平]";
	if (BaseLevel < 80) {
		mes "我想你可以喝一些那种汤，";
		mes "有益于身体健康。";
		mes "对你会有帮助。";
	}
	else {
		mes "你似乎需要那种汤";
		mes "来缓解身体和精神的疲劳。";
		mes "请去餐馆看看。";
		mes "也许能让你恢复活力。";
	}
	close;
}

louyang,174,150,5	script	Jiu Chi Ling#lou	815,{
	if (ch_tre == 5) {
		mes "[Jiu Chi Ling]";

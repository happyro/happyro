	mes "他年轻、叛逆，而且谁的话都不听……";
	next;
	mes "[Jiu Chi Ling]";
	mes "他刚刚离开了家，";
	mes "还一直抱怨";
	mes "那家餐馆……";
	mes "不知道他去了哪里。";
	next;
	mes "[Jiu Chi Ling]";
	mes "^666666*叹气～～*^000000";
	mes "这次我不会让他";
	mes "就这样逃掉！";
	close;
}


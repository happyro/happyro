					case 5: getexp 78,0; break;
					case 6: getexp 115,0; break;
					case 7: getexp 155,0; break;
					}
				}
				else {
					mes "做得好！如果你的等级没这么高，我会再奖励你一些经验。";
				}
			}
			else {
				mes "嗯……";
				mes "好吧，你可以稍后";
				mes "再喝它。";
			}
			next;
			mes "[爱丽丝]";
			mes "让我解释一下";
			mes "^4A708B装备^000000 页签中的物品。";
			mes "背包窗口。";
			next;
			mes "[爱丽丝]";
			mes "点击 ^4A708B装备^000000 页签，可以查看背包中能够装备的物品。我给你一些装备，试着穿上吧。";
			next;
			mes "[爱丽丝]";
			mes "拿到了吗？很好。";
			mes "现在双击";
			mes "新手拖鞋";
			mes "我刚给你的，";
			mes "穿上它们。";
			set nov_get_item04,12;
			getitem 2510,1; //Novice_Hood
			getitem 2414,1; //Novice_Boots
			getitem 5055,1; //Novice_Egg_Cap
			next;
			mes "[爱丽丝]";
			if (isequipped(2414)) {
				if (BaseLevel < 8) {
					mes "太好了～！";
					mes "你做到了！";
					mes "你应得奖励！";
					set nov_get_item04,13;
					switch (BaseLevel) {
					case 1: getexp 10,0; break;
					case 2: getexp 17,0; break;
					case 3: getexp 26,0; break;
					case 4: getexp 37,0; break;
					case 5: getexp 78,0; break;
					case 6: getexp 115,0; break;
					case 7: getexp 155,0; break;
					}
				}
				else {
					mes "做得好！如果你的等级没这么高，我会再奖励你一些经验。";
				}
			}
			else {
				mes "呃……";
				mes "你必须";
				mes "双击";
				mes "双击装备";
				mes "才能穿上。记住，";
				mes "好吗？";
			}
			disable_items;
			next;
			mes "[爱丽丝]";
			mes "请你";
			mes "按下“^3355FFF12^000000”键好吗？";
			mes "这会在屏幕上召唤";
			mes "快捷栏。";
			next;
			mes "[爱丽丝]";
			mes "你可以用快捷栏为物品、技能和装备分配快捷键。将技能窗口中的技能图标或背包中的物品拖到快捷栏即可。";
			next;
			mes "[爱丽丝]";
			mes "快捷键范围为“^3355FFF1^000000”到“^3355FFF9^000000”。";
			mes "参加过技能课程后，你应该获得了急救技能。将急救技能图标拖到快捷栏。";
			next;
			mes "[爱丽丝]";
			mes "请注意，只有";
			mes "主动技能才能分配快捷键并拖到快捷栏。主动技能图标为彩色方形，可双击使用。";
			next;
			mes "[爱丽丝]";
			mes "被动技能（例如“基本技能”）不能拖入快捷栏，因为被动技能始终生效，无需激活。";
			set nov_get_item04,14;
			if (JobLevel < 7) {
				switch (JobLevel) {
				case 1: getexp 0,10; break;
				case 2: getexp 0,18; break;
				case 3: getexp 0,28; break;
				case 4: getexp 0,40; break;
				case 5: getexp 0,91; break;
				case 6: getexp 0,151; break;
				}
			}
			next;
			mes "[爱丽丝]";
			mes "好了，就是这些！";
			mes "我来给你一些物品，";
			mes "它们会在野外战斗训练中帮助你。";
			next;
			mes "[爱丽丝]";
			mes "不过，^ff0000不要在训练场使用苍蝇翅膀或蝴蝶翅膀^000000，否则可能永远困在这里。这些物品毕业后再用，好吗？";
			set nov_get_item04,15;
			getitem 601,10; //Wing_Of_Fly
			getitem 602,2; //Wing_Of_Butterfly
			getitem 569,50; //Novice_Potion
			next;
			mes "[爱丽丝]";
			mes "最后……";
			if (JobLevel < 7) {
				mes "我会给你";
				mes "一些职业经验！";
				set nov_get_item04,16;
				switch (JobLevel) {
				case 1: getexp 0,10; break;
				case 2: getexp 0,18; break;
				case 3: getexp 0,28; break;
				case 4: getexp 0,40; break;
				case 5: getexp 0,91; break;
				case 6: getexp 0,151; break;
				}
			}
			else {
				mes "我本想给你一些职业经验，但我认为你现在已经足够了。";
			}
			next;
			switch(select("接下来做什么？:送我去实战课程！:取消")) {
			case 1:
				mes "[爱丽丝]";
				mes "如果你还没和其他导师交谈，";
				mes "为什么不四处走走并和他们聊聊？";
				next;
				mes "[爱丽丝]";
				mes "训练场中的每个人都很愿意帮助你。";
				mes "如果感到无聊，";
				mes "可以在这片区域探索。";
				next;
				mes "[爱丽丝]";
				mes "右侧房间的助教掌握有用知识，这片区域还隐藏着一些有趣地点。祝你好运！";
				close;
			case 2:
				mes "[爱丽丝]";
				mes "你真是个热情的新手！好吧，我会把你送到野外战斗训练负责人那里。一定要认真听教官讲解。";
				next;
				mes "[爱丽丝]";
				mes "毕竟……";
				mes "与怪物战斗是生死攸关的事！好了，保重～";
				close2;
				warp "new_1-2",28,178;
				end;
			case 3:
				mes "[爱丽丝]";
				mes "哼！";
				close;
			}
		case 2:
			mes "[爱丽丝]";
			mes "你确定要进入野外战斗训练吗？你和每位导师都谈过了吗？最好先完成。";
			next;
			switch(select("不，不！送我去实战课程！:哦，等等！")) {
			case 1:
				mes "[爱丽丝]";
				mes "你真是个热情的新手！好吧，我会把你送到野外战斗训练负责人那里。一定要认真听教官讲解。";
				next;
				mes "[爱丽丝]";
				mes "毕竟……";
				mes "与怪物战斗是生死攸关的事！好了，保重～";
				close2;
				warp "new_1-2",28,178;
				end;
			case 2:
				mes "[爱丽丝]";
				mes "这是个好决定。以后不会有很多机会获得免费物品和经验，要好好把握现在的机会！";
				close;
			}
		case 3:
			mes "[爱丽丝]";
			mes "想去城镇的话，询问右侧的卡普拉职员。好了，保重～";
			close;
		}
	}
	else if (nov_get_item02 < 10) {
		mes "[爱丽丝]";
		mes "那么我能如何";
		mes "帮助你？";
		mes "嗯，你似乎还没参加基本界面课程。要先参加吗？";
		next;
		switch(select("我要参加那门课:送我去野外战斗训练:取消")) {
		case 1:
			mes "[塞西尔]";
			mes "太好了～";
			mes "参加课程时你会学到重要知识并获得经验和物品。基本界面导师就在房间中央。现在去吧～";
			close;
		case 2:
			mes "[爱丽丝]";
			mes "你确定要进入野外战斗训练吗？你和每位导师都谈过了吗？最好先完成。";
			next;
			switch(select("我要参加野外战斗训练～！:哦，等等！")) {
			case 1:
				mes "[爱丽丝]";
				mes "你真是个热情的新手！好吧，我会把你送到野外战斗训练负责人那里。一定要认真听教官讲解。";
				next;
				mes "[爱丽丝]";
				mes "毕竟……";
				mes "与怪物战斗是生死攸关的事！好了，保重～";
				close2;
				warp "new_1-2",28,178;
				end;
			case 2:
				mes "[爱丽丝]";
				mes "这是个好决定。以后不会有很多机会获得免费物品和经验，要好好把握现在的机会！";
				close;
			}
		case 3:
			mes "[爱丽丝]";
			mes "想去城镇的话，询问右侧的卡普拉职员。好了，保重～";
			close;
		}
	}
	else if (nov_get_item03 < 10) {
		mes "[爱丽丝]";
		mes "那么我能如何";
		mes "帮助你？";
		mes "你似乎还没参加 ^4d4dff技能信息课程^000000。要先参加吗？";
		next;
		switch(select("I'll attend that class.:Send me to Field Combat Training.:Cancel")) {
		case 1:
			mes "[爱丽丝]";
			mes "这是个好主意。请和房间最左侧的导师塞西尔交谈，好吗？";
			close2;
			warp "new_1-2",84,107;
			end;
		case 2:
			mes "[爱丽丝]";
			mes "你确定要进入野外战斗训练吗？你和每位导师都谈过了吗？最好先完成。";
			next;
			switch(select("我要参加野外战斗训练～！:哦，等等！")) {
			case 1:
				mes "[爱丽丝]";
				mes "你真是个热情的新手！好吧，我会把你送到野外战斗训练负责人那里。一定要认真听教官讲解。";
				next;
				mes "[爱丽丝]";
				mes "毕竟……";
				mes "与怪物战斗是生死攸关的事！好了，保重～";
				close2;
				warp "new_1-2",28,178;
				end;
			case 2:
				mes "[爱丽丝]";
				mes "这是个好决定。以后不会有很多机会获得免费物品和经验，要好好把握现在的机会！";
				close;
			}
		case 3:
			mes "[爱丽丝]";
			mes "想去城镇的话，询问右侧的卡普拉职员。好了，保重～";
			close;
		}
	}
}

new_1-2,118,108,3	script	Kafra Employee#nv1	117,{
	mes "[Kafra Employee]";
	mes "欢迎来到";
	mes "卡普拉公司。";
	mes "卡普拉服务";
	mes "始终为你提供帮助。";
	if (NEW_MES_FLAG0) {
		set NEW_MES_FLAG0,0;
		set NEW_MES_FLAG1,0;
		set NEW_MES_FLAG2,0;
		set NEW_MES_FLAG3,0;
		set NEW_MES_FLAG4,0;
		set NEW_MES_FLAG5,0;
		set NEW_LVUP0,0;
		set NEW_LVUP1,0;
		set NEW_JOBLVUP,0;
	}
	next;
	mes "[Kafra Employee]";
	mes "我奉卡普拉公司总部派遣，来帮助像你这样的新玩家。";
	next;
	mes "[Kafra Employee]";
	mes "请注意！";
	mes "如果你要前往城镇";
	mes "^4d4dffyou will be unable to return to the Training Grounds ever again^000000.";
	next;
	if ( select("Teleport Service","About Kafra services") == 1 ) {
		if (nov_get_item02 < 10 && nov_get_item03 < 10 && nov_get_item04 < 10) {
			mes "[Kafra Employee]";
			mes "我明白了，你想立即传送到卢恩-米德加尔特的城镇。先让我简单介绍《仙境传说》中的城镇。";
			next;
			mes "[Kafra Employee]";
			mes "普隆德拉是卢恩-米德加尔特王国的首都，其卫星城伊兹鲁德就在附近。";
			next;
			mes "[Kafra Employee]";
			mes "^996633Morocc^000000 is in the desert. It's the town where you can change your job to the Thief and Assassin classes.";
			next;
			mes "[Kafra Employee]";
			mes "^006600Payon^000000 is in the mountains, and is famous for its Archer Village, where Novices can change their jobs to Archers.";
			next;
			mes "[Kafra Employee]";
			mes "魔法之都 ^993300吉芬^000000 是人们转职为魔法师和巫师的地方。";
			next;
			mes "[Kafra Employee]";
			mes "^003399Alberta^000000, the port city, is where the Merchant Guild is located. You must also go to Alberta if you wish to travel by sea.";
			next;
			mes "[Kafra Employee]";
			mes "请选择";
			mes "目的地。";
			next;
			switch(select("Prontera:Morocc:Payon:Alberta:Geffen")) {
			case 1:
				set .@dest$,"Prontera";
				set .@mapn$,"prontera";
				set .@saveX,117; set .@saveY,72;
				set .@warpX,150; set .@warpY,50;
				break;
			case 2:
				set .@dest$,"Morocc";
				set .@mapn$,"morocc";
				set .@saveX,150; set .@saveY,99;
				set .@warpX,155; set .@warpY,110;
				break;
			case 3:
				set .@dest$,"Payon";
				set .@mapn$,"payon";
				set .@saveX,70; set .@saveY,100;
				set .@warpX,166; set .@warpY,67;
				break;
			case 4:
				set .@dest$,"Alberta";
				set .@mapn$,"alberta";
				set .@saveX,30; set .@saveY,232;
				set .@warpX,114; set .@warpY,58;
				break;
			case 5:
				set .@dest$,"Geffen";
				set .@mapn$,"geffen";
				set .@saveX,119; set .@saveY,37;
				set .@warpX,122; set .@warpY,65;
				break;
			}
			mes "[Kafra Employee]";
			mes "你决定前往";
			mes .@dest$+"。";
			mes "愿神与你同在。";
			close2;
			if (nov_get_item05 < 11) {
				set nov_get_item05,11;
				getitem 569,100; //Novice_Potion
				getitem 1243,1; //Novice_Knife
				getitem 2414,1; //Novice_Boots
				getitem 2510,1; //Novice_Hood
				getitem 2352,1; //Novice_Plate
				getitem 2112,1; //Novice_Guard
				getitem 601,10; //Wing_Of_Fly
				getitem 602,2; //Wing_Of_Butterfly
				getitem 7059,5; //Cargo_Free_Ticket
				getitem 7060,5; //Warp_Free_Ticket
			}
			set nov_1st_cos,0;
			set nov_2nd_cos,0;
			set nov_3_swordman,0;
			set nov_3_archer,0;
			set nov_3_thief,0;
			set nov_3_magician,0;
			set nov_3_acolyte,0;
			set nov_3_merchant,0;
			savepoint .@mapn$,.@saveX,.@saveY,1,1;
			warp .@mapn$,.@warpX,.@warpY;
			end;
		}
		else {
			switch(select("Field Combat Course:Prontera:Morocc:Payon:Alberta:Geffen")) {
			case 1:
				mes "[Kafra Employee]";
				mes "谢谢，让我把你送到";
				mes "野外战斗训练课程。";
				mes "";
				close2;
				warp "new_1-2",28,178;
				end;
			case 2:
				set .@dest$,"Prontera";
				set .@mapn$,"prontera";
				set .@saveX,117; set .@saveY,72;
				set .@warpX,150; set .@warpY,50;
				break;
			case 3:
				set .@dest$,"Morocc";
				set .@mapn$,"morocc";
				set .@saveX,150; set .@saveY,99;
				set .@warpX,155; set .@warpY,110;
				break;
			case 4:
				set .@dest$,"Payon";
				set .@mapn$,"payon";
				set .@saveX,70; set .@saveY,100;
				set .@warpX,166; set .@warpY,67;
				break;
			case 5:
				set .@dest$,"Alberta";
				set .@mapn$,"alberta";
				set .@saveX,30; set .@saveY,232;
				set .@warpX,114; set .@warpY,58;
				break;
			case 6:
				set .@dest$,"Geffen";
				set .@mapn$,"geffen";
				set .@saveX,119; set .@saveY,37;
				set .@warpX,122; set .@warpY,65;
				break;
			}
			mes "[Kafra Employee]";
			mes "你决定前往";
			mes .@dest$+"。";
			mes "愿神与你同在。";
			close2;
			if (nov_get_item05 < 11) {
				set nov_get_item05,11;
				getitem 7059,5; //Cargo_Free_Ticket
				getitem 7060,5; //Warp_Free_Ticket
			}
			set nov_1st_cos,0;
			set nov_2nd_cos,0;
			set nov_3_swordman,0;
			set nov_3_archer,0;
			set nov_3_thief,0;
			set nov_3_magician,0;
			set nov_3_acolyte,0;
			set nov_3_merchant,0;
			savepoint .@mapn$,.@saveX,.@saveY,1,1;
			warp .@mapn$,.@warpX,.@warpY;
			end;
		}
	}
	else {
		mes "[Kafra Employee]";
		mes "让我向你介绍";
		mes "卡普拉服务。";
		mes "请在菜单中选择";
		mes "你想了解的";
		mes "服务。";
		next;
		while(1) {
			switch(select("Save service:Storage service:Teleport service:Cart rental service:Cancel")) {
			case 1:
				mes "[Kafra Employee]";
				mes "与卡普拉职员交谈并使用保存服务后，你在战斗中被击败时的复活地点会改变。";
				next;
				mes "[Kafra Employee]";
				mes "你的复活点始终是最近保存的位置。使用蝴蝶翅膀会回到你";
				mes "上次保存的位置。";
				next;
				mes "[Kafra Employoee]";
				mes "保存服务";
				mes "也由";
				mes "卡普拉公司";
				mes "免费提供～！";
				if (nov_1st_cos < 20) {
					set nov_1st_cos,20;
					switch (BaseLevel) {
					case 1: getexp 10,0; break;
					case 2: getexp 17,0; break;
					case 3: getexp 26,0; break;
					case 4: getexp 37,0; break;
					case 5: getexp 78,0; break;
					case 6: getexp 115,0; break;
					case 7: getexp 155,0; break;
					}
				}
				next;
				break;
			case 2:
				mes "[Kafra Employee]";
				mes "卡普拉公司是米德加尔特大陆历史悠久、规模最大的公司。";
				next;
				mes "[Kafra Employee]";
				mes "你可以在任何城镇方便地存取物品。";
				mes "同一账号的所有角色共享这个仓库。";
				next;
				mes "[Kafra Employee]";
				mes "不需要立即使用时，没必要把所有物品带在身上。请使用仓库安全保管物品。";
				next;
				mes "[Kafra Employee]";
				mes "我们便捷的仓库服务";
				mes "会向客户收取少量费用，各城镇费用不同。";
				next;
				mes "[Kafra Employee]";
				mes "不过，你必须达到";
				mes "至少 ^3355FF基本技能等级 6^000000";
				mes "才能使用仓库。";
				next;
				mes "[Kafra Employee]";
				mes "仓库分为 3 个物品分类：消耗品、装备和其他。";
				next;
				mes "[Kafra Employee]";
				mes "卡普拉仓库最多有 300 个物品栏位，也就是最多存放 300 种不同物品。";
				next;

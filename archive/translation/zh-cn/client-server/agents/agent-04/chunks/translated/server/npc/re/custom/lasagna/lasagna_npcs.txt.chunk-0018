		mes "为了扩展蓬勃发展的生意，我们^0000cd开始海上贸易^000000。期间，^0000cd托马斯的蝴蝶号船在台风中失踪^000000。";
		next;
		mes "[Peperoncino]";
		mes "我^0000cd不断劝说康奇利纳号的船长和船员寻找蝴蝶号^000000。努力终于有了回报，我们在^0000cd新世界的偏远岛屿^000000找到了他们。";
		next;
		mes "治安队厨师";
		mes "嗯，那就是康奇利纳号的斯泰罗……";
		npctalk "宴会？", "", bc_self;
		npctalk "才不是。", "Vigilante Chef#dorcon99", bc_self;
		next;
		mes "[Peperoncino]";
		mes "还有其他好奇的事吗？";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "真是……多么精彩的冒险。谢谢你分享故事。我终于明白你高贵举止的由来了。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "谢谢你抽出时间。";
		next;
		mes "[Chief Peperoncino]";
		mes "希望有一天能听到你的故事。";
		erasequest 14581;// Interview with the Chief
		setquest 14582;// To Recorder
		conch_in_recorder = 4;
		close;
	}
	if (conch_in_recorder == 4) {
		mes "[Chief Peperoncino]";
		mes "希望有一天能听到你的故事。";
		close;
	}
}

lasagna,263,156,5	script	Grandma#dorcon01	4_CAT_REST,{
	if (conch_in_recorder == 5) {
		mes "[Grandma]";
		mes "是谁？谁在那里？";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "哇，你的感知能力真厉害。";
		next;
		mes "[Grandma]";
		mes "一个人生活久了，就会对细微的声响变得敏感。你来这里做什么？我现在没有卡鲁纳牛奶了。要不要点点别的？";
		npctalk "可是我把所有盘子都打碎了，所以什么也没有。", "", bc_self;
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "我想问你一件事。你还记得甘贝里船长和佩佩隆奇诺首领吗？";
		next;
		mes "[Grandma]";
		mes "哦，那些蛋灵男孩。说起来我最近没怎么见到他们。他们放弃并离开拉萨格纳了吗？";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "不，他们都好好的，还在拉萨格纳。我来是想了解甘贝里船长的事。";
		next;
		mes "[Grandma]";
		mes "船长？哪个船长？甘贝里？那个蛋灵男孩？哦，你说得对。他确实成了船长。我记得他和佩佩一起来过我的酒馆。";
		npctalk "那是很久以前了，那时蛋灵身上还有壳。", "", bc_self;
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "佩佩？";
		next;
		mes "[Grandma]";
		mes "^0000cd佩佩，就是佩佩隆奇诺。甘贝里就是贝里，托梅·托马斯就是托托^000000。年轻人应该不知道这些。总之，他们那时就像野生的巴西利斯克。";
		next;
		mes "[Grandma]";
		mes "那些巴西利斯克还在洞穴里吗？我们年轻时连洞穴附近都不敢靠近。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "那后来发生了什么？他们来到酒馆后做了什么？";
		next;
		mes "[Grandma]";
		mes "哦，对了。佩佩看起来像个流浪汉，还点了卡鲁纳牛奶。贝里说只有小孩子才喝摇匀的，于是就挑起了争执。";
		next;
		mes "[Grandma]";
		mes "于是他们^0000cd打了起来^000000。我的^0000cd店铺被毁了^000000。于是我提出^0000cd损害赔偿^000000，要求赔偿家具损坏和酒馆恢复营业前的利润损失。";
		next;
		mes "[Grandma]";
		mes "你提到了佩佩。他当时似乎也很穷。他听说在凤尾鱼渔船上能赚很多钱，于是来到了拉萨格纳，却因为晕船辞职了。";
		next;
		mes "[Grandma]";
		mes "从那以后，他再也没能登上船。哈哈。他因为^0000cd违约罚金^000000欠了债，也无法离开。最后他去了凤尾鱼工坊，在那里负责去除凤尾鱼的头和内脏……";
		npctalk "我想那些东西是用来制作肥料的。", "", bc_self;
		next;
		mes "[Grandma]";
		mes "总之，他因为渔船和酒馆欠下了巨债。两人商量了该怎么办，最后来到了^0000cd凤尾鱼工坊^000000。几年后，^0000cd甘贝里成了工坊经理^000000。那份工作非常适合他。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "过去的拉萨格纳是什么样的？";
		next;
		mes "[Grandma]";
		mes "别提了。那时一团糟。道路糟糕，人也糟糕。过去被称为黑暗时代是有原因的。";
		next;
		mes "[Grandma]";
		mes "你踩过路上的鱼内脏吗？那就是当时的拉萨格纳。";
		next;
		mes "[Grandma]";
		mes "后来有一天，两个粗暴的家伙和商人、治安队一起来了，开始教训拉萨格纳的孩子们。";
		npctalk "真有意思，两个恶棍居然在整治其他恶棍。", "", bc_self;
		next;
		mes "[Grandma]";
		mes "看来棍棒确实能把人变成杜拉姆。那两个人把那些恶棍送进了商人和治安队。嗯……我还记得那些孩子。他们的胡子被剃掉了，尾巴也破破烂烂的。";
		next;
		mes "[Grandma]";
		mes "那些长得像老鼠的杜拉姆全都离开了拉萨格纳，只有想过体面生活的人留了下来。正是他们造就了如今的拉萨格纳。";
		next;
		mes "[Grandma]";
		mes "但你是谁？来点卡鲁纳牛奶吗？搅拌还是摇匀？我的工人都去哪了？";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "我先走了……";
		next;
		mes "[Grandma]";
		mes "没有客人，我的酒馆很快就要倒闭了。";
		erasequest 14583;// To Granma
		setquest 14584;// Back to Recorder
		conch_in_recorder = 6;
		close;
	}
	if (conch_in_recorder == 6) {
		mes "[Grandma]";
		mes "不点东西就赶紧滚！";
		close;
	}
	mes "[Grandma]";
	mes "呼……呼……";
	close;
}

lasagna,226,181,3	script	Kalu#dorcon	4_CAT_CHEF,{
	if (checkweight(1001,1) == 0) {
		mes "[Kalu]";
		mes "看起来又大又重。去清理掉一些负重吧。";
		close;
	}
	if (BaseLevel < 140) {
		mes "[Kalu]";
		mes "如果你想和我说话，最好先积累更多经验。";
		close;
	}
	if (lasagna_quest[2] == 0) {
		mes "[" + strcharinfo(0) + "]";
		mes "请给我一杯卡鲁纳牛奶。";
		next;
		select("搅拌。","摇匀。");
		mes "[Kalu]";
		mes "想喝卡鲁纳牛奶就去找隔壁那个人。不过你最好快点。很快不管是搅拌还是摇匀，都没得选了。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "这是怎么回事？";
		next;
		mes "[Kalu]";
		mes "你知道卡鲁纳牛奶的主要成分吗？是^0000cd卡鲁纳^000000——用一种叫^0000cd卡鲁尼亚克^000000的特殊贝类发酵而成的精华，再加上鲜奶。";
		npctalk "卡鲁纳牛奶！摇匀的！", "Boozer#dorcon02", bc_self;
		npctalk "卡鲁纳牛奶，摇匀的！来一杯！", "", bc_self;
		next;
		mes "[Kalu]";
		mes "用适当的温度混合，再用醋栗装饰，这样就能得到人人喜爱的卡鲁纳牛奶。";
		npctalk "如果用刚挤出的牛奶，就能品尝到卡鲁纳牛奶的极致版本。", "", bc_self;
		next;
		mes "[Kalu]";
		mes "可是店里的卡鲁纳快用完了，供应商也好几天没来。就连库存里的那些也快没了。";
		next;
		mes "[Kalu]";
		mes "没有卡鲁纳，就做不出卡鲁纳牛奶。你明白这意味着什么吗？";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "这意味着什么？";
		npctalk "你居然不知道是什么意思？！", "", bc_self;
		next;
		mes "[Kalu]";
		mes "这意味着专程来喝卡鲁纳牛奶的客人会白跑一趟。";
		npctalk "卡鲁纳牛奶！给那边的先生来一杯！", "Boozer#dorcon01", bc_self;
		npctalk "卡鲁纳牛奶，搅拌的！给那边的先生来一杯！", "", bc_self;
		npctalk "哦！", "Goon meow#dorcon01", bc_self;
		next;
		mes "[Kalu]";
		mes "喝不到卡鲁纳牛奶的人很快就会^0000cd闹事^000000，而且骚乱很快会蔓延到整个拉萨格纳。";
		next;
		mes "[Kalu]";
		mes "那样拉萨格纳就会恢复从前肮脏又危险的样子。我不能让这种事发生。我们终于过上了体面的生活，却要回到那个黑暗时代……";
		npctalk "那我就毫不犹豫地离开拉萨格纳。", "", bc_self;
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "我相信不至于因为一杯卡鲁纳牛奶就发生那种事。";
		next;
		mes "[Kalu]";
		mes "你不明白卡鲁纳牛奶对拉萨格纳人意味着什么。对他们来说，那不仅仅是一种放松身体的饮料。";
		npctalk "卡鲁纳牛奶！", "Goon meow#dorcon01", bc_self;
		npctalk "卡鲁纳牛奶，搅拌的！来一杯！", "", bc_self;
		npctalk "你已经喝够了！", "Meow goon#dorcon01", bc_self;
		next;
		mes "[Kalu]";
		mes "卡鲁纳牛奶还象征着^0000cd信仰、友谊和节庆^000000。我不能在这里详谈，但如果你好奇，就去找康奇利纳号的记事员吧。";
		next;
		mes "[Kalu]";
		mes "他是个记录狂，喜欢把一切都记下来。";
		npctalk "随便翻翻关于我的记录就知道了。", "", bc_self;
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "我不太确定，但看得出来这对这里的人非常重要。";
		next;
		mes "[Kalu]";
		mes "没错，我说的就是这个。你们每天都用卡鲁纳牛奶开始或结束一天。可卡鲁纳已经快用光了！";
		npctalk "卡鲁纳牛奶！", "Meow goon#dorcon01", bc_self;
		npctalk "卡鲁纳牛奶，搅拌的！来一杯！", "", bc_self;
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "你为什么不派个人去看看发生了什么？";
		next;
		mes "[Kalu]";
		mes "我又不傻。不过根本没人能派出去！你看，大家都很忙。";
		npctalk "卡鲁纳牛奶！", "Boozer#dorcon01", bc_self;
		npctalk "卡鲁纳牛奶，搅拌的！", "", bc_self;
		next;
		if (select( "我来帮你。", "哦，不好意思。" ) == 2) {
			mes "[Kalu]";
			mes "对，我很忙，所以你该走了。想喝卡鲁纳牛奶就去隔壁试试。";
			close;
		}
		mes "[Kalu]";
		mes "什么？你刚才说什么？如果我没听错，你说你要帮我。";
		npctalk "哎呀，这简直就是一声金铃！", "", bc_self;
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "你没听错。";
		next;
		mes "[Kalu]";
		mes "天哪，谢谢你。看来我之前做了那么多好事，终于得到回报了。";
		npctalk "卡鲁纳牛奶！", "Meow goon#dorcon01", bc_self;
		npctalk "卡鲁纳牛奶，搅拌的！来一杯！哎呀，管它呢！两杯！", "", bc_self;
		npctalk "耶！！！", "Meow goon#dorcon01", bc_self;
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "明明是我说要帮你，为什么感谢的却是老天？";
		npctalk "为什么我们没有得到服务？！", "Boozer#dorcon01", bc_self;
		npctalk "你是在歧视我们吗？！", "Boozer#dorcon02", bc_self;
		next;
		mes "[Kalu]";
		mes "哦，当然不是。我也很感谢你。总之，你去^0000cd南边桥附近的钓鱼点^000000，就会遇到拄着拐杖的^0000cd莱加拉斯^000000。他就是给我们供应卡鲁纳的人。";
		npctalk "我们可以一起喝！", "Meow goon#dorcon01", bc_self;
		next;
		mes "[Kalu]";
		mes "拉萨格纳的大多数人都为治安队或商人工作，所以镇上总是缺人手。";
		npctalk "我正要进入状态，再等一会儿！如果一切顺利，我请的不只一杯，而是两杯！", "", bc_self;
		npctalk "太棒了！", "Boozer#dorcon01", bc_self;
		npctalk "哦耶！", "Boozer#dorcon02", bc_self;
		npctalk "我等！我等！", "Meow goon#dorcon01", bc_self;
		next;
		mes "[Kalu]";
		mes "所以我们会以特殊待遇政策雇用想找工作的外来者，而莱加拉斯负责发酵卡鲁纳。";
		next;
		mes "[Kalu]";
		mes "他很擅长捕捉、清理和发酵卡鲁尼亚克，因此拉萨格纳的卡鲁纳牛奶被认为是这里最好的。啊，这不是重点。";
		next;
		mes "[Kalu]";
		mes "去找莱加拉斯，问问到底发生了什么。告诉他尽快送货。照现在的消耗速度，今天过后我们就要断货了。";
		npctalk "卡鲁纳牛奶！", "Boozer#dorcon01", bc_self;
		npctalk "卡鲁纳牛奶，搅拌的！", "", bc_self;
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "好，我去问问。";
		next;
		mes "[Kalu]";
		mes "太感谢你了！";
		setquest 14567;// Kaluna milk is in Danger!
		lasagna_quest[2] = 1;
		close;
	}
	if (lasagna_quest[2] < 7) {
		mes "[Kalu]";
		mes "你不是说要去查清楚莱加拉斯为什么没法送货吗？";
		next;
		mes "[Kalu]";
		mes "求你了。我真的很担心，最近甚至睡不着觉。";
		npctalk "连我的胡子都变稀了……帮帮我……", "", bc_self;
		close;
	}
	if (lasagna_quest[2] == 7) {
		mes "[Kalu]";
		mes "冒险者，莱加拉斯怎么说？他说能送来卡鲁纳吗？";
		npctalk "我真心希望他说能。否则我就完了！", "", bc_self;
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "是的。幸运的是，他说快达到交货量了。";
		next;
		mes "[Kalu]";
		mes "太好了！不过他有没有告诉你是什么导致了延误？";
		next;
		mes "[You tell Kalu about the story of Daldal and Gopara.]";
		next;
		mes "[Kalu]";
		mes "所以你的意思是，莱加拉斯工作时，我应该让那两个人远离工坊。";
		next;
		mes "[Kalu]";
		mes "我想这件事我能处理。事实上，我正好每天都要^0000cd往洞穴里送餐盒^000000。";
		npctalk "嗯，真的不是因为我们缺人手……", "", bc_self;
		next;
		mes "[Kalu]";
		mes "看来莱加拉斯工作时，可以把那两个人派到送货队。工资嘛，每天一顿饭就够了。";
		npctalk "公平就是公平，对吧？", "", bc_self;
		next;
		mes "[Gopara]";
		mes "洞穴？不错。我一直也想亲自去看看。";
		next;
		mes "[Daldal]";
		mes "不管是什么，只要能吃到好吃的我就开心。";
		next;
		mes "[Kalu]";
		mes "好，那我们马上开始！把这个餐盒送给^0000cd洞穴里的治安队员。他叫潘纳。^000000";
		next;
		mes "[Gopara]";
		mes "走吧。";
		npctalk "走吧。", "", bc_self;
		next;
		mes "[Daldal]";
		mes "起来。";
		npctalk "团队必须步调一致。", "", bc_self;
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "我、我也要去？";
		next;
		mes "[Gopara]";
		mes "我们是一个团队。";
		npctalk "我们是一个团队。", "", bc_self;
		next;
		mes "[Daldal]";
		mes "团队必须步调一致。";
		npctalk "团队必须步调一致。", "", bc_self;
		classchange( HIDDEN_WARP_NPC, "Daldal#dorcon05", bc_self );
		classchange( HIDDEN_WARP_NPC, "Gopara#dorcon05", bc_self );
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "我什么时候成团队成员了？好吧，行了……走吧。";
		getitem 25048,1;// Hearty Lunchbox
		erasequest 14573;// I need the time on my own
		setquest 14574;// Meal Box Delivery
		lasagna_quest[2] = 8;
		close;
	}
	if (lasagna_quest[2] == 8) {
		mes "[Kalu]";
		mes "把这个大餐盒送给正在洞穴巡逻的潘纳。";
		if (countitem(25048) < 1)
			getitem 25048,1;// Hearty Lunchbox
		close;
	}
	if (lasagna_quest[2] == 9) {
		mes "[" + strcharinfo(0) + "]";
		mes "我回来了。";
		next;
		mes "[Gopara]";
		mes "我说我回来了。";
		npctalk "我累坏了。", "Gopara#dorcon05", bc_self;
		next;
		mes "[Daldal]";
		mes "我回来了。";
		npctalk "我累惨了。", "Daldal#dorcon05", bc_self;
		next;
		mes "[Kalu]";
		mes "干得好。你们三人去洞穴期间，莱加拉斯送来了卡鲁纳。如果每天都能这样，送货就完全不是问题了。";
		next;
		mes "[Gopara]";
		mes "冒险者，明天也拜托你了。";
		next;
		mes "[Daldal]";
		mes "如果时间允许，我会早点出来等着。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "我、我也要？";
		next;
		mes "[Gopara]";
		mes "我们之前的称呼是什么？";
		next;
		mes "[Daldal]";
		mes "一个！";
		next;
		mes "[Gopara]";
		mes "团队！";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "一个团队。如果我不出现，他们大概又会去骚扰莱加拉斯。好吧。";
		next;
		mes "[Daldal]";
		mes "好了，现在给我吃的。";
		npctalk "我饿了。", "Daldal#dorcon05", bc_self;
		next;
		mes "[Gopara]";
		mes "我没事。卡鲁尼亚克吃太多了，现在还在消化。";
		npctalk "我现在连一块都不想要。", "Gopara#dorcon05", bc_self;
		classchange( HIDDEN_WARP_NPC, "Daldal#dorcon05", bc_self );
		classchange( HIDDEN_WARP_NPC, "Gopara#dorcon05", bc_self );
		next;
		mes "[Kalu]";
		mes "你拿着这个吧。干得不错。";
		erasequest 14575;// Delivery Complete Report
		setquest 14576;// Meal Box Delivery Time
		lasagna_quest[2] = 10;
		close;
	}
	if (lasagna_quest[2] == 10) {
		switch( checkquest(14576,PLAYTIME) ) {
		case -1:
			if (isbegin_quest(14578) == 1) {
				mes "[Kalu]";
				mes "今天也干得好。你们两个去拿点吃的。冒险者，这个给你。明天也拜托你了！";
				erasequest 14578;// Delivery Complete Report
				setquest 14576;// Meal Box Delivery Time
				close;
			}
			mes "[Kalu]";
			mes "把这个大餐盒送给正在洞穴巡逻的潘纳。";
			if (countitem(25048) < 1)
				getitem 25048,1;// Hearty Lunchbox
			close;
		case 0:
		case 1:
			classchange( 4_SEA_OTTER, "Daldal#dorcon05", bc_self );
			classchange( 4_GALAPAGO, "Gopara#dorcon05", bc_self );
			mes "[Kalu]";
			mes "冒险者，你已经来了？还没到送餐盒的时间。";
			next;
			mes "[Gopara]";
			mes "对，时间不对。";
			npctalk "对，时间不对。", "Gopara#dorcon05", bc_self;
			next;
			mes "[Daldal]";
			mes "时间不对！";
			npctalk "时间不对！", "Daldal#dorcon05", bc_self;
			next;
			mes "[Kalu]";
			mes "天亮后再来吧。";
			next;
			mes "[Gopara]";
			mes "回头见。";
			next;
			mes "[Daldal]";
			mes "下次再见。";
			close;
		case 2:
			mes "[Kalu]";
			mes "正是时候。那两个人已经到了，正在等着。";
			next;
			mes "[Gopara]";
			mes "是的，我们一直在等。";
			npctalk "是的，我们一直在等。", "Daldal#dorcon06", bc_self;
			next;
			mes "[Daldal]";
			mes "等了好久，差点等死了。";
			npctalk "等了好久，差点等死了。", "Gopara#dorcon06", bc_self;
			next;
			mes "[Kalu]";
			mes "那么今天也请你们^0000cd把餐盒送给洞穴里的潘纳^000000。去的时候快一点，回来时慢慢走。";
			next;
			mes "[Gopara]";
			mes "走吧。";
			next;
			mes "[Daldal]";
			mes "出发吧！";
			classchange( HIDDEN_WARP_NPC, "Daldal#dorcon05", bc_self );
			classchange( HIDDEN_WARP_NPC, "Gopara#dorcon05", bc_self );
			erasequest 14576;// Meal Box Delivery Time
			setquest 14577;// Meal Box Delivery
			getitem 25048,1;// Hearty Lunchbox
			close;
		}
	}
	end;

OnInit:
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "!isbegin_quest(14567) && BaseLevel >= 140" );
	end;
}

lasagna,248,105,5	script	Legalas#dorcon	4_RAGGLER,{
	if (lasagna_quest[2] == 0) {
		mes "[Legalas]";
		mes "别吃了！住手！真不知羞！";
		close;
	}
	if (lasagna_quest[2] == 1) {
		mes "[Legalas]";
		mes "够了！你们两个每天都越来越过分！难道不觉得这样太过头了吗？你们没有良心吗？！";
		next;
		mes "[Daldal]";
		mes "良心？嗯……抱歉，我不知道，因为我根本不知道我的良心在哪里。";
		npctalk "我不知道我的良心在哪里。", "Daldal#dorcon01", bc_self;
		next;
		mes "[Gopara]";
		mes "大概在胸口吧？可我该拿它怎么办？";
		npctalk "我该拿它怎么办？", "Gopara#dorcon01", bc_self;
		next;
		mes "[Legalas]";
		mes "我刚抓到卡鲁尼亚克，你们两个就把它吃光！甚至连我清理好的那些也吃了！";
		next;
		mes "[Legalas]";
		mes "我不是已经告诉过你们好几次，那些必须发酵后送出去吗？而且期限已经过了！";
		next;
		mes "[Daldal]";
		mes "真的吗？我不知道。";
		npctalk "你知道吗？", "Daldal#dorcon01", bc_self;

      if (.@view == W_DAGGER) {
         bonus bMaxHPrate,10;
         bonus bDelayrate,-8;
      }
      if (.@view == W_1HSWORD || .@view == W_2HSWORD) {
         skill "SO_DIAMONDDUST",5;
         bonus2 bSkillCooldown,"SO_DIAMONDDUST",5000;
      }
      if (.@view == W_1HSPEAR || .@view == W_2HSPEAR) {
         bonus2 bSubEle,Ele_Wind,20;
         bonus2 bSubEle,Ele_Water,20;
      }
      if (.@view == W_STAFF || .@view == W_2HSTAFF || .@view == W_BOOK) {
         bonus2 bSkillAtk,"MG_COLDBOLT",50;
         bonus2 bSkillAtk,"WL_JACKFROST",40;
         bonus2 bSkillCooldown,"SO_SUMMON_AQUA",-30000;
         autobonus3 "{ bonus2 bMagicAtkEle,Ele_Water,30; }",1000,60000,"SO_SUMMON_AQUA";
      }
      if (.@view == W_MACE || .@view == W_1HAXE || .@view == W_2HAXE)
         bonus2 bAddEff,Eff_Freeze,2000;

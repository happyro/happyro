-	script	#Gate_manager_main	-1,{
	end;
	
OnMyMobDead:
	set .@sub$, callfunc("F_Okolnir");
	if (getd("$@gqse_"+.@sub$+"_miro") == getd("$@gqse_"+.@sub$+"_pcc")) {
		if (!mobcount("que_q"+.@sub$,"#Gate_manager_"+.@sub$+"::OnMyMobDead")) {
			donpcevent "#gq_miromob2_"+.@sub$+"::OnEnable";
		}
	}
	end;
}

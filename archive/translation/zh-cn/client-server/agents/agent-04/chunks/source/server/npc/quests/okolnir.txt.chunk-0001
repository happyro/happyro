-	script	#gq_miromob2_main	-1,{
	end;
	
OnEnable:
	set .@sub$,callfunc("F_Okolnir");
	initnpctimer;
	end;

OnTimer1000:
	set .@sub$,callfunc("F_Okolnir");
	mapannounce "que_q"+.@sub$,"Wish Maiden: How does it feel to see shadows of the past. This is only the beginning.",bc_map,"0x00ff00";
	end;

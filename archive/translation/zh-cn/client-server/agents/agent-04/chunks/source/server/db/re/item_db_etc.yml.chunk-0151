               bonus2 bMagicAddRace,RC_All,3;
               bonus2 bMagicAddRace,RC_Player_Human,-3;
               bonus2 bMagicAddRace,RC_Player_Doram,-3;
               bonus2 bAddRace,RC_All,3;

               bonus2 bAddRace,RC_Player_Doram,-3;
            }
         }
      }
      if (.@g>=ENCHANTGRADE_D) {
         bonus2 bAddClass,Class_Normal,2;
         bonus2 bMagicAddClass,Class_Normal,2;
         bonus2 bAddClass,Class_Boss,2;
         bonus2 bMagicAddClass,Class_Boss,2;
         if (.@g>=ENCHANTGRADE_C) {

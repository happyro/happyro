    Name: Forest Magic Orb (Berserker)
    Type: Card
    SubType: Enchant
    Script: |
      .@g = getenchantgrade();
      .@r = getrefine();
      bonus bPAtk,7;
      bonus bAtkRate,5;
      bonus bBaseAtk,50;
      if (.@r>=7) {

	background-repeat: no-repeat;
	background-position: center;
}

#Enchant .material .name {
	display: none;
}

#Enchant .material .count {
	position: absolute;
	right: 6px;
	bottom: 6px;

	color: #2d3a55;
	text-shadow: 1px 1px 0 #ffffff;
}

#Enchant .tax_panel {
	position: absolute;
	left: 0;
	top: 305px;
	width: 300px;
	height: 70px;
}

#Enchant .cost_panel {
	position: absolute;
	left: 108px;
	top: 4px;
	width: 144px;
	height: 16px;
}

#Enchant .zeny_label {
	display: none;
}

#Enchant .zeny_cost {
	width: 100%;
	text-align: right;

	font-weight: bold;
	color: #2d3a55;
}

#Enchant .action_btn {
	position: absolute;
	left: 80px;
	top: 26px;
	width: 140px;
	height: 40px;
	border: none;
	background-color: transparent;
	background-repeat: no-repeat;
	background-size: contain;
	cursor: pointer;
}

#Enchant .action_btn:focus {
	outline: none;
}

#Enchant .action_btn.disabled {
	cursor: default;
}

#Enchant .log_panel {
	position: absolute;
	left: 0;
	top: 417px;
	width: 690px;
	height: 53px;
	padding: 6px 10px;
	box-sizing: border-box;
	overflow: hidden auto;
}

#Enchant .caution,
#Enchant .status {
	color: #b13b3b;
	line-height: 1.2;
}

#Enchant .status.error {
	color: #b13b3b;
}

1@ge_st,114,50,4	script	Arhi#1	670,{
end;

OnActivate:
	enablenpc instance_npcname("Arhi#1");
	npctalk "The first match always makes me nervous~!";
	sleep 2000;
	npctalk "Can I win?";
	sleep 3000;
	npctalk "I guess it will be okay, this "+('sex ? "guy" : "girl")+" seems weak.";
	sleep 3000;

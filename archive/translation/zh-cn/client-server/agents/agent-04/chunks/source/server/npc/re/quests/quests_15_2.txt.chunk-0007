		setquest 7651;// One Memory a Day
		if (ep15_2_permit < 5)
			ep15_2_permit++;
	}
	else {
		switch( rand(1,18) ) {
		case 1:
			npctalk "This is Dorothy Florence. Dorothy who only knows how to do laundry.";
			sleep2 4000;
			npctalk "I want to save the remains of the people with the only things I have.";
			sleep2 4000;

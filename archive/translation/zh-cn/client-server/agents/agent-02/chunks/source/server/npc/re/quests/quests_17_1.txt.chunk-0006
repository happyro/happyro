	}
	mes "[Staff]";
	mes "What are you doing here? You can't be here unless you have an appointment.";
	close;

OnInit:
	questinfo(QTYPE_QUEST,QMARK_YELLOW,"isbegin_quest(17010) == 1");
	end;
}


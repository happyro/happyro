			result.targetCell = [x, y];
			// Must continue checking if there is a wall
		}

		if (x === x1) {
			dx = 0;
		}
		if (y === y1) {
			dy = 0;
		}

		if (dx === 0 && dy === 0) {
			break;
		}

		i++;
	}
	return result;
}

// Exports
export default {
	search: search,
	searchLong: searchLong,
	setGat: setGat,
	updateGat: updateGat,
	searchLongIgnoreCellType: searchLongIgnoreCellType,
	MAX_HEAP: MAX_HEAP,
	MAX_WALKPATH: MAX_WALKPATH
};

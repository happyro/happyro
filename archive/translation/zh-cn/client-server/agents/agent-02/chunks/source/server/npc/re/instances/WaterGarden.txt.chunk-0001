1@ghg,66,69,0	script	#ghg_hw1	HIDDEN_WARP_NPC,4,4,{
	end;
OnTouch:
	if (!is_party_leader())
		end;
	if ('water_garden != 0)
		end;
	if (isbegin_quest(16438) > 0) {
		erasequest 16438;
		'mode = 1;
	}
	else if (isbegin_quest(16437) > 0) {
		erasequest 16437;
		'mode = 0;
	}
	'water_garden = 1;
	end;
}


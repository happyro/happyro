//===== rAthena Script =======================================
//= Water Garden
//===== Description: =========================================
//= [Walkthrough Conversion]
//= Episode 17.2 Water Garden
//= Episode 17.2 Water Garden Hard Mode
//===== Changelog: ===========================================
//= 1.0 Initial release [crazyarashi]
//= 1.1 Optimizations and cleanup [Everade]
//= 1.2 Cleanup [Capuche]
//============================================================

ba_maison,238,44,5	script	Harad#jh_ba1	4_EP17_BASIC_B,{
	if (ep172_watergarden < 3) {
		cutin "ep172_beta",2;
		mes "[Harad]";
		mes "Hello, guest.";
		mes "This place is the docks.";
		next;
		mes "[Harad]";
		mes "We don't have any ships operating right now. But the scenery is nice, feel free to take a look around for a while!";
		close3;
	}
	switch( checkquest(16439,PLAYTIME) ) {
	case -1:
		break;
	case 0:
	case 1:
		cutin "ep172_beta",2;
		mes "[Harad]";
		mes "In accordance with the Gardeners' plant cultivation and herbicide plans. Admission to the water garden is limited once per day for both the normal and hard water garden.";
		next;
		mes "[Harad]";
		mes "Thank you for your understanding.";
		mes "Please take enough rest and come back again after dawn!";
		close3;
	case 2:
		erasequest 16439;
		break;
	}
	cutin "ep172_beta",2;
	mes "[Harad]";
	mes "Would you like to take a ride to the water garden?";
	mes "The ship only run once a day!";
	next;
	mes "^FF0000Please note that, any abnormal monster handling inside the instance such as taming, is not considered normal.^000000";
	mes "";
	mes "^FF0000The party leader who received the quest for the 'Water Garden' or 'Water Garden Hard' must enter the instance to proceed. In the case of party leader changes, the instance will be cancelled and you may not proceed.^000000";
	next;
	cutin "",255;
	.@normal = is_party_leader();
	.@hard = (.@normal && isbegin_quest(16430) == 2);
	.@md_name$ = "Water Garden";	// default
	switch( select( (.@normal ? "Create Water Garden" : ""), (.@hard ? "Create Water Garden Hard" : ""), "^0000CDGarden Entrance^000000" ) ) {
	case 1:
		.@quest_given = 16437;
		.@other_quest = 16438;
		break;
	case 2:
		if (BaseLevel < 180) {
			cutin "ep172_beta",2;
			mes "[Harad]";
			mes "You can tell me if you want to enter the water garden.";
			mes "But it's dangerous inside. You can't enter right now.";
			next;
			mes "- This MD is for level 180 or above. -";
			close3;
		}
		.@md_name$ = "Water Garden Hard";
		.@quest_given = 16438;
		.@other_quest = 16437;
		break;
	case 3:
		if (ep172_watergarden > 3) {
			.@instance_name$ = instance_live_info(ILI_NAME, instance_id(IM_PARTY));
			if (.@instance_name$ != "Water Garden" && .@instance_name$ != "Water Garden Hard") {
				cutin "ep172_beta",2;
				mes "[Harad]";
				mes "The instance has not been created yet.";
				mes "Please check it.";
				close3;
			}
			cutin "ep172_beta",2;
			mes "[Harad]";
			mes "Enter the ^CC0000" + .@instance_name$ + "^000000.";
			next;
			cutin "",255;
			if (select( "^0000CDEnter Water Garden", "Enter Water Garden Hard^000000" ) == 1)
				.@md_name$ = "Water Garden";
			else
				.@md_name$ = "Water Garden Hard";
		}
		if (instance_enter(.@md_name$) != IE_OK) {
			cutin "ep172_beta",2;
			mes "[Harad]";
			mes "The instance has not been created yet.";
			mes "Please check it.";
			close2;
			cutin "",255;
			end;
		}
		setquest 16439;
		mapannounce "ba_maison", "" + strcharinfo(0) + " of the party, " + getpartyname( getcharid(1) ) + ", is entering the " + .@md_name$ + ".", bc_map, "0x00FF99";
		end;
	}
	if (instance_create(.@md_name$) == -3)
		dispbottom "The reservation of the instance '" + .@md_name$ + "' has failed due to an active instance.";
	if (isbegin_quest(.@quest_given) > 0)
		erasequest .@quest_given;
	if (isbegin_quest(.@other_quest) > 0)
		erasequest .@other_quest;
	setquest .@quest_given;
	mes "[Harad]";
	mes "When the " + .@md_name$ + " MD has opened, please speak to me again and select ^0000CDEnter " + .@md_name$ + "^000000.";
	close;
}


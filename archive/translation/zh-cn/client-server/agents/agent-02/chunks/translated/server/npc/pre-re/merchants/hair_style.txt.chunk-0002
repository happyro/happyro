			close;
	case 3:
		mes "[Veronica]";
		mes "每个人都有追求美丽的权利。";
		mes "希望有一天";
		mes "你能找到";
		mes "适合自己的发型。";
		close;
	}

L_cutin:
	.@num = getarg(0);
	if(Sex == SEX_MALE) {
		if (.@num  < 10)
			cutin "hair_m_0"+ .@num,4;
		else
			cutin "hair_m_"+ .@num,4;
	} else {
		if (.@num < 10)
			cutin "hair_f_0"+ .@num,4;
		else
			cutin "hair_f_"+ .@num,4;
	}
	return;
}



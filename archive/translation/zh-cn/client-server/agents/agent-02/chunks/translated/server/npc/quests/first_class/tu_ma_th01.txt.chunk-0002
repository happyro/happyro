	moc_fild18,109,197,0	script	Trace of Battle#15	CLEAR_NPC,{
		.@class_thief = ( BaseClass == Job_Thief );
		.@class_mage = ( BaseClass == Job_Mage );
		if ((.@class_thief == 0 && .@class_mage == 0) || (eaclass()&EAJL_BABY)) {
		mes "^3355FFThese look like";
		mes "某种追逐或战斗的痕迹，但无法确定究竟是什么。^000000";
		} else if (tu_thief01 < 21 && .@class_thief) {
		mes "^3355FF这里有迹象表明";
		mes "显示之前有很多人来过这里。^000000";
			} else if (tu_magician01 < 21 && .@class_mage)
	mes "看起来有一大群人经过。";
		else if ((tu_thief01 == 21 && .@class_thief) || (tu_magician01 == 21 && .@class_mage)) {
		mes "^3355FF这片区域显然";
		mes "这里明显发生过激烈战斗，地面到处散落着毒药痕迹。^000000";
	next;
	switch(select("Continue following the traces.:Further investigate the area.")) {

case 1:
	mes "^3355FF你检查了";
mes "虽然有痕迹，但无法辨认战斗继续的方向……^000000";
close;
	case 2:
	mes "^3355FFYou find a bunch of";
	mes "这里有使用不同毒药的陷阱。已经触发的和未触发的混在一起。^000000";
		if (tu_thief01 == 21)
		tu_thief01 = 22;
		else
		tu_magician01 = 22;
	close;
		}
		} else if ((tu_thief01 == 22 && .@class_thief) || (tu_magician01 == 22 && .@class_mage)) {
		if (rand(1,3) == 3) {
		mes "^3355FFOne trap in particular";
	mes "其中一个比其他陷阱更显眼。也许应该先倒些绿药水中和它。^000000";
		next;
	switch(select("Pour Green Potion.:Don't use Green Potion.")) {
		case 1:
		if (countitem(506) < 1) {// Green_Potion
		mes "^3355FF遗憾的是，你";
		mes "你没有可以倒在这个陷阱上的绿药水……^000000";
		close;
		} else {
		mes "^3355FF将那东西倒入";
		mes "绿药水似乎没有效果。也许应该试试别的东西。^000000";
			delitem 506,1; //Green_Potion
			if (tu_thief01 == 22)
			tu_thief01 = 23;
			else
			tu_magician01 = 23;
			close;
		}
			case 2:
			mes "["+strcharinfo(0)+"]";
			mes "我想……再调查一下这片区域？";
			close;
			}
			} else {
			mes "^3355FFBy sheer accident,";
				mes "你触发了这里的一个陷阱。^000000";
			sc_start SC_Poison,60000,0;
				specialeffect EF_VENOMDUST2;
			percentheal -30,0;
		}
	} else if ((tu_thief01 == 23 && .@class_thief) || (tu_magician01 == 23 && .@class_mage)) {
		if (countitem(511) > 0 && countitem(716) > 0) {
			mes "^3355FFYou try grinding";
			mes "你将绿草撒在陷阱上，再放上一颗红色宝石。";
			mes "宝石发光，慢慢融化……^000000";
			next;
		mes "^3355FF虽然你没有";
			mes "虽然你并不完全理解毒药和解毒剂的原理，但成功拆除了陷阱。现在可以安全检查里面有什么了。^000000";
			delitem 511,1; //Green_Herb
			delitem 716,1; //Red_Gemstone
			if (tu_thief01 == 23)
				tu_thief01 = 24;
					else
					tu_magician01 = 24;
					} else if (countitem(511) > 0) {
					mes "^3355FF你应该使用其他与解毒或毒药有关的催化剂拆除陷阱。你有绿草，于是将它撒在陷阱上。^000000";
					next;
				mes "^3355FF但什么也没发生。看来除了绿草外，还需要另一种催化剂才能";
					mes "拆除这个陷阱。^000000";
					} else if (countitem(716) > 0) {
					mes "^3355FF你应该使用其他与解毒或毒药有关的催化剂来拆除陷阱。你有红色宝石，于是将它磨碎撒在陷阱上。^000000";
					next;
					mes "^3355FF但什么也没发生。看来还需要另一种催化剂配合红色宝石才能拆除陷阱。^000000";
					} else {
					mes "^3355FF你应该使用其他与解毒或毒药有关的催化剂拆除陷阱。但该带什么物品呢？^000000";
						}
					} else if ((tu_thief01 == 24 && .@class_thief) || (tu_magician01 == 24 && .@class_mage)) {
						mes "^3355FF在拆除的陷阱内部，你找到另一块染血的奇怪布片。你把它带走，希望能成为某种证据。^000000";
					if (tu_thief01 == 24)
				tu_thief01 = 25;
			else
				tu_magician01 = 25;
				} else {
				mes "^3355FF你继续调查这片区域，猜测战斗可能向南方发展。^000000";
				}
				close;
			}
		// Battle Traces 16

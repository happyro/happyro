//===== rAthena Script ======================================= 
//= Wandering Minstrel Quest
//===== By: ================================================== 
//= Riotblade and L0ne_W0lf
//===== Current Version: ===================================== 
//= 1.5
//===== Compatible With: ===================================== 
//= rAthena Project
//===== Description: ========================================= 
//= Help the bard remember how his song goes.
//===== Comments: ============================================
//= [Official Conversion]
//= Needs optimizing.
//= Reconverted with iRO Dialogs.
//= Possible NPC conflict with "Representative"
//===== Additional Comments: ================================= 
//= 1.0 First version, needs testing. [L0ne_W0lf]
//= 1.1 Fixed bug, optimized. Not yet final version [Lupus]
//=
//= Variables:
//=		.@random : temp var 
//=		.@inputstr$ : temp var 
//=
//= This Quest has relation with brisingamen_seal.txt (Seals)
//= 1.2 Changed variable to "gef_bards_q" to avoid job quest conflict. [L0ne_W0lf]
//=     Progress prior to the 5th+ step will be lost. Job quest takes priority.
//= 1.3 Fixed experience gains to match upcoming rate adjustments. [SinSloth]
//= 1.4 Replaced effect numerics with constants. [L0ne_W0lf]
//= 1.5 Updated RE/Pre-RE EXP. [Euphy]
//============================================================ 

geffen,132,38,3	script	Bard#2	51,{
	if (bard_q > 5) set gef_bard_q,bard_q;
	set @name$,strcharinfo(0);
	if (gef_bard_q > 29) {
		cutin "bard_eland02",2;
		mes "[埃伦德]";
		mes "哎呀，你好~";
		mes "天气是不是";
		mes "格外宜人？";
		next;
		mes "[埃伦德]";
		mes "啊~ 只有两样东西能让这幅美景更美：故事和歌曲。那么，你想听哪个？";
		callsub S_StorySong,1;

	} else if (gef_bard_q == 14 || gef_bard_q == 15) {
		if (gef_bard_q == 14) {
			cutin "bard_eland04",2;
			mes "[埃伦德]";
			mes "嗯？";
			mes "那是黑色封印……？嗯。基诺·凯蒂毫无痕迹地取走了他给我的封印，所以我猜他很喜欢你。否则……";
			next;
			mes "^3355FF你把信交给埃伦德，";
			mes " ^000000";
			next;
			cutin "bard_eland01",2;
			mes "[埃伦德]";
			mes "呃，他已经知道一切了？从这片血迹看，他的健康仍有问题。他应该别再折磨自己……";
			next;
			mes "[Errende]";
			mes "谢谢你，我非常感激你为我所做的一切。不过，该用什么方式向你这样的冒险者表达谢意呢？";
		} else {
			cutin "bard_eland01",2;
			mes "[Errende]";
			mes "啊，进行得如何？";
			mes "等等，你已经找到了？";
			mes "没错，就是这个！太好了！";
			mes "太不可思议了！！";
			mes "啊，对，对。";
			mes "没错。";
			next;
			mes "[Errende]";
			mes "我想表达谢意。不过对冒险者";
			mes "你来说，什么才合适呢？";
		}
		next;
		mes "[Errende]";
		mes "哦~！我正好有合适的东西。请放松下来，听我的歌。";
		next;
		cutin "bard_eland03",2;
		mes "^483D8BEvery god never grows old";
		mes "因为美丽的";
		mes "女神伊登。";
		mes "青春苹果的守护者，";
		mes "不朽女神。^000000";
		specialeffect2 EF_STEAL;
		next;
		mes "^483D8BEvery god never grows old.";
		mes "布拉吉的妻子伊登，";
		mes "奥丁的儿媳伊登~";
		mes "她守护的苹果";
		mes "在她的篮子里。^000000";
		next;
		mes "^483D8BWithout Idun,";
		mes "每位神明都会";
		mes "屈服于衰老。";
		mes "即使是最强的神托尔，";
		mes "也会变得虚弱，米斯特汀会";
		mes "从腰间滑落，雷神之锤";
		mes "再也无法飞翔。^000000";
		next;
		mes "^483D8BWithout Idun,";
		mes "每位神明都会";
		mes "屈服于衰老。";
		mes "洛基曾经粗心大意，";
		mes "让她从众神身边失踪。";
		mes "他被迫将她找回来。^000000";
		specialeffect2 EF_STEAL;
		next;
		mes "^483D8BMy goddess stands";
		mes "在阿斯加德的田野，";
		mes "她递给我天上的果实。";
		mes "你会得到每位神明的爱……";
		mes "你会得到";
		mes "每位神明的祝福……^000000";
		next;
		specialeffect EF_BEGINSPELL6;
		mes "^483D8B如果你分享";
		mes "和我分享青春苹果，";
		mes "哪怕只给这个";
		mes "可怜诗人一口。";
		mes "你会得到每位神明的爱……";
		mes "你会得到";
		mes "每位神明的祝福……^000000";
		next;
		specialeffect2 EF_RESURRECTION;
		mes "^3355FF听着他的歌，你感到放松，思绪也变得清晰。你仿佛看到了天使的幻影，并获得了一些经验值。^000000";
		set gef_bard_q, gef_bard_q + 16; //30,31
		if (checkre(3)) {
			if (BaseLevel < 56) getexp 450,0;
			else if ((BaseLevel > 55) && (BaseLevel < 61)) getexp 550,0;
			else if ((BaseLevel > 60) && (BaseLevel < 66)) getexp 968,0;
			else if ((BaseLevel > 65) && (BaseLevel < 71)) getexp 1341,0;
			else if ((BaseLevel > 70) && (BaseLevel < 76)) getexp 3575,0;
			else if ((BaseLevel > 75) && (BaseLevel < 81)) getexp 6024,0;
			else if ((BaseLevel > 80) && (BaseLevel < 86)) getexp 7034,0;
			else if ((BaseLevel > 85) && (BaseLevel < 91)) getexp 9205,0;
			else getexp 15678,0;
		} else {
			if (BaseLevel < 56) getexp 4500,0;
			else if ((BaseLevel > 55) && (BaseLevel < 61)) getexp 5500,0;
			else if ((BaseLevel > 60) && (BaseLevel < 66)) getexp 9684,0;
			else if ((BaseLevel > 65) && (BaseLevel < 71)) getexp 13411,0;
			else if ((BaseLevel > 70) && (BaseLevel < 76)) getexp 35757,0;
			else if ((BaseLevel > 75) && (BaseLevel < 81)) getexp 60246,0;
			else if ((BaseLevel > 80) && (BaseLevel < 86)) getexp 70340,0;
			else if ((BaseLevel > 85) && (BaseLevel < 91)) getexp 92052,0;
			else getexp 156786,0;
		}
		next;
		cutin "bard_eland02",2;
		mes "[Errende]";
		mes "现在感觉如何？希望我的歌让你精神焕发。也许不足以报答你，但这是我表达感谢的最好方式。";
		next;
		mes "[Errende]";
		mes "此外，我现在把你当作可以无忧畅谈的朋友。而且我觉得你的笑容很美。我说错了吗~？哈哈哈~";
		next;
		mes "[Errende]";
		mes "希望你永远诚实、尊重他人，继续无视对财富和权力的贪婪。";
		close3;

	} else if (gef_bard_q > 11 && gef_bard_q < 14) {
		cutin "bard_eland02",2;
		mes "[Errende]";
		mes "看来你还没找到。慢慢来，我可以一直等。等待似乎就是我职业的一部分，所以不会无聊。";
		close3;

	} else if (gef_bard_q == 11) {
		cutin "bard_eland01",2;
		mes "[Errende]";
		mes "斯凯兹提先生在朱诺米内塔右侧的书街有一家小书店。给他看封印，他会帮助你。";
		close3;

	} else if (gef_bard_q == 10) {
		cutin "bard_eland01",2;
		mes "[Errende]";
		mes "那么，你见过凯蒂先生吗？";
		mes "啊，在梦罗克？他有慢性病，不过显然不";
		mes "在意。";
		mes "他说了什么？";
		next;
		mes "[Errende]";
		mes "嗯？在朱诺？";
		mes "那一定就是他。";
		mes "想去斯凯兹提先生的书店并不容易。来，我用";
		mes "^483D8BThe Seal of Friendship^000000.";
		next;
		cutin "bard_eland03",2;
		mes "[Errende]";
		mes "把左手给我。";
		mes "现在让我施法……";
		mes "*Mumble mumble...*";
		next;
		specialeffect2 EF_CONE;
		mes "^3355FF你的左手腕上出现了一个银光闪耀的新月形印记。只有专注寻找时才能注意到它，但在月光下或许会清晰显现。^000000";
		next;
		mes "[Errende]";
		mes "好了。现在你可以去找斯凯兹提先生。记住，你必须";
		mes "给他看友谊封印。";
		mes "现在，祝你好运~";
		set gef_bard_q,11;
		close3;

	} else if (gef_bard_q == 20) {
		cutin "bard_eland03",2;
		mes "[Bard]";
		mes "^483D8B今天是星期几？";
		mes "最适合饮酒？";
		mes "啦啦啦~";
		mes "这是";
		mes "大地、太阳";
		mes "和月亮的日子~";
		mes "啦啦啦~^000000";
		next;
		mes "^483D8BLa la la~";
		mes "我只在一天";
		mes "喝酒~";
		mes "所以如果你告诉我";
		mes "你什么时候喝酒";
		mes "我就告诉你何时";
		mes "和你一起喝~^000000";
		next;
		mes "^483D8BLet's get together";
		mes "是啊是啊——^000000嗯……？";
		next;
		mes "[Bard]";
		mes "哎呀，你好。来听我的歌、忘掉烦恼吗？";
		next;

		if(select("你是谁？:无视他。")==1) {
			cutin "bard_eland04",2;
			mes "[" + @name$ + "]";
			mes "你看起来是";
			mes "这里的新面孔……";
			mes "你是谁？";
			next;
			cutin "bard_eland02",2;
			mes "[Errende]";
			mes "嗯？啊，是的。我只是随风漂泊的诗人。请叫我^483D8B埃伦德^000000，一个想取悦你的吟游诗人。";
			next;
			mes "[Errende]";
			mes "如果你愿意，我会告诉你旅行见闻。请允许我……";
			mes "我会演奏一首让你忘记烦恼的歌。";
			set gef_bard_q,21;
			callsub S_StorySong,2;

		} else {
			cutin "bard_eland01",2;
			mes "[Errende]";
			mes "哇啊，呜~";
			mes "你不能那样无视我！你的欢乐感和浪漫感去哪了？";
			close3;
		}

	} else if (gef_bard_q == 27) {
		cutin "bard_eland01",2;
		mes "[Errende]";
		mes "我怎么能忘记这首歌？";
		mes "我作为吟游诗人毫无价值~！";
		mes "请……只是……";
		mes "请让我";
		mes "一个人静静。";
		next;

		if(select("没问题~:有什么我能帮你的吗？")==1) {
			cutin "bard_eland04",2;
			mes "[Errende]";
			mes "哇啊~！你真坏！";
			mes "你应该说‘埃伦德，怎么了？也许我能帮忙？’";
			next;
			mes "[Errende]";
			mes "我的意思是，我们应该";
			mes "更了解彼此";
			mes "才对。但是……";
			mes "也许是我错了！";
			next;
			mes "[Errende]";
			mes "*Sob...*";
			mes "是谁忽视这个可怜的吟游诗人，让他哭泣？*抽泣*我相信就是你！";
		} else {
			mes "[Errende]";
			mes "帮我？";
			mes "嗯……";
			mes "就是这样！";
			mes "冈瑟！";
			next;
			mes "[Errende]";
			mes "请帮我一个忙。";
			mes "如果你遇到^483D8B冈瑟·双重和声^000000，请告诉他我的困境。";
			next;
			mes "[Errende]";
			mes "告诉他^483D8B薄荷埃伦德^000000忘记了歌曲^483D8B一见钟情^000000中的一句歌词，那句叫^483D8B第八份爱^000000。";
			next;
			mes "[Errende]";
			mes "拜托你，遇到他时询问第八份爱，并立即把歌词告诉我~";
			set gef_bard_q,22;
		}
		close3;

	} else if (gef_bard_q == 26) {
		cutin "bard_eland01",2;
		mes "[Errende]";
		mes "啊……！";
		mes "到底是谁改了这首歌的歌词？真难理解。真想问问改词的人。";
		next;
		mes "[Errende]";
		mes "真让人沮丧！";
		mes "现在我失去了";
		mes "歌唱和演奏的热情……";
		next;
		mes "[" + @name$ + "]";
		mes "你不觉得……";
		mes "那个人会是……";
		input .@inputstr$;
		mes .@inputstr$ + "?";
		next;

		if (.@inputstr$ == "Kino Kitty") {
			cutin "bard_eland04",2;
			mes "[Errende]";
			mes "啊！当然！";
			mes "我想你说得对！";
			mes "我怎么没想到呢？";
			next;
			mes "[Errende]";
			mes "现在一切都说得通了。他曾是无敌单身军团成员。因为这首歌原本写的是幸福情侣，他的改词可能有点刻薄……";
			next;
			cutin "bard_eland01",2;
			mes "[Errende]";
			mes "嗯……";
			mes "抱歉又要拜托你，不过旅行途中能否帮我找到这首歌的原歌词？我可以等……";
			next;

			if(select("不用了，谢谢。:我能做到，别哭了。")==1) {
				mes "[Errende]";
				mes "啊，看来是我要求太多了。抱歉。别担心，我会想其他办法。";
				set gef_bard_q,25;

			} else {
				mes "[Errende]";
				mes "你是认真的吗？";
				mes "哦，太谢谢你了！";
				mes "你一定是天使！";
				mes "真正理解诗人心灵的天使！";
				next;
				mes "[Errende]";
				mes "我会想办法报答你！";
				mes "谢谢你的辛苦";
				mes "提前致谢~";
				set gef_bard_q,24;
			}
			close3;

		} else if (.@inputstr$ == "Gunther") {
			mes "[Errende]";
			mes "冈瑟？我不认为他会这样做。他总在歌里加入‘为你双重和声’之类的歌词。而且他太傻了。";
			close3;

		} else if (.@inputstr$ == "Gunther Doubleharmony") {
			mes "[Errende]";
			mes "冈瑟？我不认为他会这样做。他总在歌里加入‘为你双重和声’之类的歌词。而且他太傻了。";
			close3;

		} else if (.@inputstr$ == "Errende") {
			cutin "bard_eland04",2;
			mes "[Errende]";
			mes "你一定是在开玩笑！";
			mes "如果是我改的，为什么我会";
			mes "不知道这首歌";
			mes "讲的是什么？";
			close3;

		} else {
			mes "[Errende]";
			mes "" + .@inputstr$ +"...?";
			mes "我不认识那个人。也许你误会了";
			mes "什么？*叹气……*";
			next;
			mes "[Errende]";
			mes "那句歌词是什么……？";
			mes "我怎么会忘记";
			mes "第八份爱？";
			set gef_bard_q,26;
			close3;
		}

	} else if (gef_bard_q == 25) {
		cutin "bard_eland04",2;
		mes "[Errende]";
		mes "哦……！";
		mes "眼泪停不下来！";
		mes "为、为什么人们总是这样对待吟游诗人？";
		next;
		mes "^483D8BWho made";
		mes "让这个可怜的吟游诗人哭泣？";
		mes "是谁打碎了他";
		mes "玻璃般脆弱的心？";
		mes "粉碎他的梦想……^000000";
		next;
		mes "^483D8BNo dreams,";
		mes "没有心，";
		mes "没有爱，";
		mes "没有希望";
		mes "没有……^000000";
		set .@random,rand(1,50);
		next;

		if (.@random > 27  && .@random < 37 ) {
			mes "^3355FF埃伦德继续唱着个人绝望的歌曲。他似乎因你拒绝帮助而失望。当然，你开始同情他。^000000";
			next;

			if(select("那我应该帮他……:还是无视他。")==1) {
				mes "[" + @name$ + "]";
				mes "嘿，嘿，埃伦德。别唱这首歌了，太尴尬了，好吗？我去帮你找原曲。";
				next;
				mes "[Errende]";
				mes "*喘气*！真的吗！你确定？谢谢！太谢谢你了！";
				mes "你真的在乎";
				mes "吟游诗人的悲伤！";
				next;
				mes "[Errende]";
				mes "我保证尽力报答你！我会在这里等你回来！";
				set gef_bard_q,24;
			} else {
				cutin "bard_eland04",2;
				mes "^3355FF你无视了他的";
				mes "令人心碎的歌曲。";
				mes "但你的灵魂要付出什么代价？^000000";
			}
			close3;

		} else {
			cutin "bard_eland01",2;
			mes "[Errende]";
			mes "你没有什么想问我的吗？没有的话，要听听我的歌吗……？";
			next;
			mes "^483D8BMiiiiserable...";
			mes "没、没、没人爱我~";
			mes "永、永远没有朋友……";
			mes "呜呜呜哇！^000000";
			close3;
		}

	} else if (gef_bard_q == 24) {
		cutin "bard_eland02",2;
		mes "[Errende]";
		mes "嗯……";
		mes "我不确定凯蒂先生在哪里。也许你可以去朱诺怪物博物馆找找？我想他是怪物研究组织成员。";
		next;
		mes "[Errende]";
		mes "如果你有探索经验，就会知道怪物研究组织。最近许多学者因研究怪物而受伤。";
		next;
		cutin "bard_eland01",2;
		mes "[Errende]";
		mes "由于怪物研究危险，研究者需要冒险者收集信息。";
		next;
		mes "[Errende]";
		mes "对我这样的流浪者来说，这是赚钱的好方法。我们提供所需信息，他们给予经济支持。";
		next;
		mes "[Errende]";
		mes "总之，你应该去朱诺怪物博物馆打听凯蒂先生。那里离这里很远，在朱诺中央广场以西。";
		next;
		mes "[Errende]";
		mes "再次，";
		mes "非常感谢你";
		mes "的帮助。";
		close3;

	} else if (gef_bard_q == 22) {
		mes "[埃伦德]";
		mes "*叹气……*";
		mes "我在哪里能找到";
		mes "第八份爱……？";
		mes "你见过冈瑟吗？";
		mes "啊，也许还没有。";
		next;
		cutin "bard_eland04",2;
		mes "[埃伦德]";
		mes "*叹气*自从忘记那句歌词，我就失去了歌唱的心情。我……做不到。心灵毫无波澜，也没有灵感。";
		next;
		mes "[埃伦德]";
		mes "请向^483D8B冈瑟^000000询问^483D8B一见钟情^000000中的^483D8B第八份爱^000000。先谢谢你。";
		close3;

	} else if (gef_bard_q == 23) {
		cutin "bard_eland02",2;
		mes "[埃伦德]";
		mes "那么……";
		mes "你见过";
		mes "冈瑟吗？";
		next;
		mes "^3355FF你转过身，让他看到你的背。^000000";
		next;
		mes "[埃伦德]";
		mes "嗯……？！";
		mes "那不是？！";
		mes "那是写在你背上的歌词吗？等等，别动！第八份爱是……";
		mes "我明白了！";
// 切片行数保留
		next;

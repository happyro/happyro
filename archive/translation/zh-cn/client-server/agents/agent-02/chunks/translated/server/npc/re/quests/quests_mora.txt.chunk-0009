-	script	#mora_puddle	-1,{
	set .@i, atoi(charat(strnpcinfo(2),9));

	// This script has a lot of checks,
	// so arrays are only set when used.
	setarray .@quest1[1],5024,5025,5026,5027;
	setarray .@dir$[1],"east","west","south","north";

	if (checkquest(.@quest1[.@i]) > -1) {
		if (countitem(6389) == 0) {
			mes "这里似乎是研究员提到的"+.@dir$[.@i]+"水坑。";
			mes "要收集样本吗？";
			next;
			if(select("收集样本。：不收集样本。") == 2)
				close;
			if (countitem(1092) == 0) {
				mes "你没有空的样本管。";
				close;
			}
			progressbar "ffff00",5;
			if (checkweight(6389,1) == 0) {
				mes "你携带的物品太多，";
				mes "难以收集样本。";
				mes "请减轻负重后再来。";
				close;
			}
			mes "你从"+.@dir$[.@i]+"水坑收集了样本。";
			delitem 1092,1; //Empty_Cylinder
			getitem 6389,1; //Puddle_R_Sample
			close;
		} else {
			mes "你已经有样本了。";
			close;
		}
	}

	set .@quest1[0], .@quest1[.@i];
	set .@dir$[0], .@dir$[.@i];
	deletearray .@quest1[.@i],1;
	deletearray .@dir$[.@i],1;

	if (checkquest(.@quest1[1]) > -1 || checkquest(.@quest1[2]) > -1 || checkquest(.@quest1[3]) > -1) {
		for(set .@j,1; .@j<=3; set .@j,.@j+1) {
			if (checkquest(.@quest1[.@j]) > -1)
				break;
		}
		mes "这里不是"+.@dir$[.@j]+"水坑。";
		close;
	}

	setarray .@quest2[1],5030,5031,5032,5033;
	set .@quest2[0], .@quest2[.@i];
	deletearray .@quest2[.@i],1;

	if (ep14_1_goki == 30 && checkquest(.@quest2[0]) > -1) {
		mes "你到了"+.@dir$[0]+"水坑。";
		mes "你应该寻找未确认生物的家族。";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "鱼~鱼~";
		next;
		mes "你呼喊后，";
		mes "水坑传来了回应。";
		next;
		mes "[???]";
		mes "谁？渔夫？走开！";
		next;
		select("我在寻找某条鱼的家族。" );
		mes "[???]";
		mes "家族？那条鱼叫什么？";
		next;
		mes "未确认生物叫什么？";
		next;
		input .@inputstr$;
		if (.@inputstr$ != "Fishee") {
			mes "[???]";
			mes "没有家族。"+.@inputstr$+"没有。";
			mes "你走吧。";
			next;
			mes "看来未确认生物的家族不在这里。";
			close;
		}
		mes "[???]";
		mes .@inputstr$+"？哦……怎么……";
		mes "丈夫来了。你的儿子。";
		mes "这里有消息。";
		next;
		mes "另一只来自水坑的生物和你说话。";
		next;
		mes "[????]";
		mes "什么？失踪儿子的消息？";
		next;
		mes "两条鱼非常激动，";
		mes "它们的对话很难听懂。";
		mes "你等它们冷静下来，";
		mes "然后告诉它们完整的故事。";
		next;
		mes "[Fishee's Dad]";
		mes "是的……晚上，儿子";
		mes "走了……夜间渔夫。";
		mes "儿子笨。被抓。死了。好。";
		next;
		mes "[Fishee's Mom]";
		mes "小鱼活着。太好了。太好了。";
		next;
		mes "[Fishee's Dad]";
		mes "是的……人类带来了儿子的消息。";
		mes "谢谢。儿子，";
		mes "我们没事。很开心。给你。告诉儿子。";
		changequest .@quest2[0],5034;
		close;
	} else if (checkquest(5034) > -1 && checkquest(5034) < 2) {
		mes "[Fishee's Dad]";
		mes "是的……人类带来了儿子的消息。";
		mes "谢谢。儿子，";
		mes "我们没事。很开心。给你。告诉儿子。";
		close;
	} else if (checkquest(.@quest2[1]) > -1 || checkquest(.@quest2[2]) > -1 || checkquest(.@quest2[3]) > -1) {
		mes "你到了"+.@dir$[0]+"水坑。";
		mes "你应该寻找未确认生物的家族。";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "鱼~鱼~";
		next;
		mes "你大声呼喊鱼，";
		mes "但没有回应。";
		mes "我想没有人住在";
		mes "这个水坑里。";
		close;
	}
	mes "你看到一个水面平静的水坑。";
	close;
}
bif_fild02,315,285,0	duplicate(#mora_puddle)	Puddle#ep14_muk01	844
bif_fild02,65,109,0	duplicate(#mora_puddle)	Puddle#ep14_muk02	844
bif_fild02,223,71,0	duplicate(#mora_puddle)	Puddle#ep14_muk03	844

//============================================================
mora,133,80,6	script	Elephantine#pa0829	509,{
	if (checkweight(1201,1) == 0) {
		mes "你携带的物品种类太多，无法这么做。丢弃一些后再试。";
		close;
	}
	if (MaxWeight - Weight < 1000) {
		mes "你的负重太大，无法这么做。减轻负重后再试。";
		close;
	}
	if (ep14_1_mistwoods < 10) {
		mes "[Elephantine]";
		mes "嗯，你看起来还不够可靠，无法替我执行任务。";
		close;
	}
	if (BaseLevel < 135) {
		mes "[Elephantine]";
		mes "变强后再回来吧？以你现在的状态，我不能给你任务。";
		close;
	}
	set .@playtime, checkquest(12230,PLAYTIME);
	if (.@playtime == 0 || .@playtime == 1) {
		mes "[Elephantine]";
		mes "现在没有其他任务。如果有了，下次回来我会告诉你。";
		close;
	} else if (.@playtime == 2) {
		mes "[Elephantine]";
		mes "请向^990099霍查^000000确认";
		mes "上一个任务的详情，好吗？";
		close;
	}
	mes "[Elephantine]";
	mes "欢迎。";
	mes "我这里有一些任务，你要看看吗？";
	next;
	if(select("你有什么任务给我？：告诉我今天的任务。") == 1) {
		mes "[Elephantine]";
		mes "我是莫拉村志愿巡逻队长。以前可不是这样，嘿嘿。";
		next;
		mes "[Elephantine]";
		mes "每天我都会给你一个消灭周边怪物的任务。";
		next;
		mes "[Elephantine]";
		mes "你可能会接到难以独自完成的任务——那就请其他冒险者帮忙。";
		close;
	}
	mes "[Elephantine]";
	mes "让我看看今天有什么任务……嗯……";
	next;
	mes "[Elephantine]";
	mes "这个怎么样？";
	next;
	switch(rand(1,5)) {
	case 1:
		setquest 12225;
		setquest 12230;
		mes "[Elephantine]";
		mes "背着水果的奇怪昆虫在这附近游荡——你一定见过。";
		next;
		mes "[Elephantine]";
		mes "请在看到它们时消灭，免得它们把东西卖给迷路的冒险者。";
		set .@n$,"Fruit-Carrying Insects";
		break;
	case 2:
		setquest 12226;
		setquest 12230;
		mes "[Elephantine]";
		mes "最近有很多报告，说伪装成花朵的螳螂会攻击路过的生物。";
		next;
		mes "[Elephantine]";
		mes "目前还没有伤亡报告，但采取预防措施也没坏处。请妥善处理它们。";
		set .@n$,"Flowery Hunters";
		break;
	case 3:
		setquest 12227;
		setquest 12230;
		mes "[Elephantine]";
		mes "据报告，一名冒险者在彩虹桥附近收集资源时遭到小鸟攻击。";
		next;
		mes "[Elephantine]";
		mes "它们看起来并不凶猛……但冒险者请求我消灭它们，所以只能交给你了。";
		set .@n$,"Small but Ferocious...";
		break;
	case 4:
		setquest 12228;
		setquest 12230;
		mes "[Elephantine]";
		mes "这项委托让我有点不安，但有人匿名请求我猎杀淘气的妖精。";
		next;
		mes "[Elephantine]";
		mes "我不知道他和妖精有什么仇，但委托就是委托。";
		set .@n$,"An Unknown Grudge";
		break;
	case 5:
		setquest 12229;
		setquest 12230;
		mes "[Elephantine]";
		mes "如果我说有一团团金色头发在滚动，你会相信吗？不会吧？";
		next;
		mes "[Elephantine]";
		mes "它们看起来不太危险，但据说会偷冒险者的书和糖果。请妥善处理。";
		set .@n$,"Blondie Ann";
		break;
	}
	next;
	mes "你接到了任务^005500"+.@n$+"^000000。打开任务窗口查看详情。";
	close;
}

mora,115,98,8	script	Hotcha#pa0829	509,{
	if (checkweight(1201,1) == 0) {
		mes "你携带的物品种类太多，无法这么做。丢弃一些后再试。";
		close;
	}
	if (MaxWeight - Weight < 1000) {
		mes "你的负重太大，无法这么做。减轻负重后再试。";
		close;
	}
	if (ep14_1_mistwoods < 10) {
		mes "[Hotcha]";
		mes "嗯，你看起来还不够可靠，无法完成大象的任务。";
		close;
	}
	if (BaseLevel < 97) {
		mes "[Hotcha]";
		mes "这里对冒险者来说就像天堂。不过不适合你这样的弱者。";
		close;
	}
	set .@playtime, checkquest(12230,PLAYTIME);
	if (.@playtime == -1) {
		mes "[Hotcha]";
		mes "看来你还没有接到";
		mes "任何任务。";
		mes "去和大象谈谈，";
		mes "他会给你";
		mes "无数任务中的一项。";
	
	

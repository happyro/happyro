		emotion ET_QUESTION, playerattached();
		mes "[Nodor]";
		mes "哦——天啊——（啧、啧、啧）！！";
		next;
		emotion ET_SCRATCH;
		mes "[Nodor]";
		mes "Sieu Ngu 先生——";
		mes "不是想说你坏话，";
		mes "但你有点迟钝……";
		mes "你现在没感觉不一样吗？";
		next;
		if(select("你在说什么？:我明白了！") == 1) {
			mes "[Nodor]";
			mes "呃——没错，你很迟钝，对吧？";
			mes "你已经突破极限了。";
			next;
			mes "[Nodor]";
			mes "你可以比以前更强。";
			mes "这不是你的梦想吗？";
			next;
		}
		mes "[Nodor]";
		mes "好~！";
		mes "现在走向世界，作为初心者享受自由快乐的生活吧！";
		mes "就是这样！";
		close;
	}
	else if (EXSUPNOV_Q == 5) {
		mes "[Nodor]";
		mes "（嘟嘴）-------------！！";
		mes "你终于回来了。";
		next;
		mes "[Nodor]";
		mes "为了庆祝这位新的初心者伙伴，我准备了一些装备送给你——";
		next;
		mes "[Nodor]";
		mes "别忘了确认^FF0000物品栏^000000有足够空间领取这些物品。";
		mes "别说我没提醒你。";
		next;
		if(select("好的，让我检查物品栏。:没问题，给我看看。") == 1) {
			mes "[Nodor]";
			mes "好吧，好吧！";
			mes "你知道的！可别后悔。";
			close;
		}
		mes "[Nodor]";
		mes "这些是我年轻时穿过的东西，";
		mes "但现在仍然很好。";
		if (EXSUPNOV_Q_ == 3) getitem 2522,1; // Undershirt
		else if (EXSUPNOV_Q_ == 4) {
			getitem 2628,1; // Novice Armlet [1]
			getitem 2113,1; // Novice Shield [1]
			getitem 2416,1; // Novice Shoes [1]
			getitem 5119,1; // Super Novice Hat [1]
			getitem 2512,1; // Novice Manteau [1]
			getitem 2340,1; // Novice Breastplate [1]
		}
		else getitem 2340,1; // Novice Breastplate [1]
		next;
		select("二手货，是吗？");
		mes "[Nodor]";
		mes "把它们还给我。";
		mes "我把自己的东西给你，你怎么能这样反应？";
		next;
		mes "[Nodor]";
		mes "我……";
		mes "送出去的东西不能收回。";
		next;
		mes "[Nodor]";
		mes "现在我要再次向你致意。";
		next;
		specialeffect2 EF_RECOVERY;
		mes "[Nodor]";
		mes "愿超初学者 "+strcharinfo(0)+" 得到超初学者守护者的祝福！";
		set EXSUPNOV_Q,6;
		close;
	}
	else if (EXSUPNOV_Q > 5) {
		mes "[Nodor]";
		mes "别忘了你是初心者。";
		mes "永远做个初心者吧！";
		mes "人生的目标就是舒适平凡地生活！";
		close;
	}
	mes "[Fishing Novice]";
	mes "嘘！";
	mes "请安静，否则会";
	mes "把鱼全吓跑。";
	close;
}

airplane,33,47,5	script	Nudor#sp2	729,{
	if (checkquest(5099) >= 0) {
		mes "[Nudor]";
		mes "啊~ 我没有钱买食物。";
		mes "我好饿，但不知道哥哥什么时候来……";
		next;
		select("嘿，你是……Nudor 先生吗？");
		mes "[Nudor]";
		mes "诶——？！谁想知道？";
		mes "我认识你吗？";
		next;
		mes "- 你向 Nudor 解释来找他的原因。 -";
		next;
		mes "[Nudor]";
		mes "啊哈！你是代替哥哥来给我零花钱的~";
		next;
		mes "[Nudor]";
		mes "哇哦哇哦~~ 他给了你多少？";
		next;
		mes "- Nudor 眼睛闪闪发光地盯着你 -";
		mes "- 并伸出双手。 -";
		mes "- 你想给多少？ -";
		next;
		set .@i, select("我没钱:给 100,000 Zeny:给 300,000 Zeny:给 1,000,000 Zeny:给出你所有的钱");
		mes "[Nudor]";
		if (.@i == 1) {
			mes "- 哭泣 -";
			mes "我讨厌 Nodor——！";
			mes "我也讨厌你——！";
			close2;
			warp "airplane",70,93;
			end;
		}
		else if (.@i < 5) {
			switch(.@i) {
				case 2: set .@n,100000; break;
				case 3: set .@n,300000; break;
				case 4: set .@n,1000000; break;
			}
			mes "太好了~~ 他给了你 "+callfunc("F_InsertComma",.@n)+" Zeny？真不少！";
			next;
			if (Zeny < .@n) {
				mes "[Nudor]";
				mes "什么？可是 "+callfunc("F_InsertComma",.@n)+" Zeny 在哪里？";
				close;
			}
		}
		else {
			mes "哦……天啊，你真的要把所有 Zeny 都给我？真的吗？";
			next;
			if(select("不，不是这样的……:全都给你") == 1) {
				mes "[Nudor]";
				mes "呸！真令人失望！";
				close;
			}
			if (!Zeny) {
				mes "[Nudor]";
				mes "诶？可是你没钱。你真穷啊？";
				close;
			}
			set .@n,Zeny;
		}
		mes "[Nudor]";
		mes "哇~！！"+.@n+" Zeny！这帮了我大忙~ 嘻嘻~";
		mes "真不敢相信……";
		changequest 5099,5100;
		set Zeny, Zeny - .@n;
		if (.@i < 5) set EXSUPNOV_Q_, .@i;
		else {
			if (.@n > 1000000) set EXSUPNOV_Q_,4;
			else if (.@n > 300000) set EX_SUPNOV_Q_,3;
			else set EXSUPNOV_Q_,2;
		}
		next;
		mes "[Nudor]";
		if (Sex == SEX_MALE) mes "你知道吗？你真的很帅~";
		else mes "我得告诉你，你真的……真的很漂亮。";
		next;
		mes "[Nudor]";
		mes "- 你感觉自己被骗了 -";
		mes "- 所以回去找 Nodor。 -";
		close;
	}
	else if (checkquest(5100) >= 0) {
		mes "[Nudor]";
		mes "真不敢相信哥哥给我寄了钱……我喜欢~";
		next;
		mes "[Nudor]";
		mes "哎呀！";
		mes strcharinfo(0)+"，嘘——！！";
		next;
		mes "[Nudor]";
		mes "别把这件事告诉 Nodor~~";
		close;
	}
	mes "[Nudor]";
	mes "啊~ 我没有钱买食物。";
	mes "我好饿，但不知道哥哥什么时候来……";
	close;
}

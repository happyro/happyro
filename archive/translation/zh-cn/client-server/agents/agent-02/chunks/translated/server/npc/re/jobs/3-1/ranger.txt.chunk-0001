//===== rAthena Script ======================================= 
//= Ranger Job Quest
//===== By: ================================================== 
//= Muad_Dib
//===== Current Version: ===================================== 
//= 1.7
//===== Compatible With: ===================================== 
//= rAthena Project
//===== Description: ========================================= 
//= [Official Conversion]
//= Job change Quest from Hunter / Sniper -> Ranger.
//===== Additional Comments: ================================= 
//= 1.0 First Version. [Masao]
//= 1.1 Updated SC_STONE duration from 2 Seconds to 2 Minutes
//=     and fixed Mercenary check.
//= 1.2 Fixed first quest so that when a false poring got killed
//=     it decreases the total points by 1, commented the SC_STONE
//=     part until M_DESERT_WOLF_B Mercenary is fully working.
//= 1.3 Fixed waves not being announced and counted [Elias]
//= 1.3a Little beauty fix, changed break; to next; . [Masao]
//= 1.4 Some optimization. [Euphy]
//= 1.5 Updated script, optimized. [Euphy]
//= 1.6 Added GM management function. [Euphy]
//= 1.7 Added VIP features. [Euphy]
//============================================================

tur_dun01,156,36,5	script	Survival Instructor#jr01	59,{
	mes "[Survival Instructor, Rescue]";
	if (BaseJob == Job_Hunter) {
		if (job_ranger01 < 1) {
		mes "嘿嘿嘿～哈！";
		mes "天气真好。";
			next;
			mes "[Survival Instructor, Rescue]";
		mes "怎么了？";
		mes "这里的魔物";
		mes "有点强，要小心。";
			next;
			if(select("我是来转职为游侠的。:我只是来看看。") == 2) {
				mes "[Survival Instructor, Rescue]";
				mes "哦，是吗？";
				mes "天气真好。要不要拍张照留念？";
				next;
				mes "[Survival Instructor, Rescue]";
				mes "不拍？";
				mes "那就安静地看看，然后回去吧。";
				close;
			}
			mes "[Survival Instructor, Rescue]";
			mes "嗯？";
			mes "你是怎么找到我的？";
			next;
			mes "[Survival Instructor, Rescue]";
			mes "能认出我算及格……让我看看。";
			next;
			if (BaseLevel < 99 || JobLevel < 50) {
				mes "[Survival Instructor, Rescue]";
				mes "不行。";
				mes "光看你我就知道你经验不足。";
				next;
				mes "[Survival Instructor, Rescue]";
				mes "对自己的职业更有自信，积累更多经验。作为猎人或神射手成长、能够独自制造气场后，再回来吧。";
				close;
			}
			mes "[Survival Instructor, Rescue]";
			mes "好！";
			mes "看来你已经有";
			mes "足够的经验了。";
			next;
			if (VIP_SCRIPT) {
				callfunc "VIP_Third_Class";
				set job_ranger01,1;
				setquest 8254;
				next;
			}
			mes "[Survival Instructor, Rescue]";
			mes "很好。";
			mes "首先，我告诉你成为游侠的转职资格。";
			next;
			mes "[Survival Instructor, Rescue]";
			mes "第一项资格我已经确认：你作为猎人或神射手积累了足够经验，能够制造气场。";
			next;
			mes "[Survival Instructor, Rescue]";
			mes "第二项资格是准确判断能力，你需要让身心都轻盈起来。";
			next;
			if (Class == Job_Hunter || Class == Job_Baby_Hunter) {
				mes "[Survival Instructor, Rescue]";
				mes "等等，在那之前。";
				mes "如果你从猎人直接转职为游侠，";
				mes "就没有机会学习神射手技能，这样也可以吗？";
				next;
				switch(select("我再考虑一下。:我已经想成为游侠了。")) {
				case 1:
					mes "[Survival Instructor, Rescue]";
					mes "好的。";
					mes "慢慢考虑，确定后再回来。";
					close;
				case 2:
					mes "[Survival Instructor, Rescue]";
					mes "好吧。";
					mes "那你准备好了。";
					next;
				}
				mes "[Survival Instructor, Rescue]";
				mes "那么继续谈吧。";
				mes "在你转职为游侠前，即使达到猎人的最高等级，也不能充分评价你的能力。";
				next;
				mes "[Survival Instructor, Rescue]";
				mes "所以为了检查能力，我需要评估你最纯粹的能力～";
				next;
			} else {
				mes "[Survival Instructor, Rescue]";
				mes "在你转职为游侠前，即使达到神射手的最高等级，也不能充分评价你的能力。";
				next;
				mes "[Survival Instructor]";
				mes "所以为了检查能力，我需要评估你最纯粹的能力～";
				next;
			}
			mes "[Survival Instructor, Rescue]";
			mes "为此，你需要净化身心。";
			mes "请确保负重为‘0’才能继续。";
			set job_ranger01,1;
			setquest 8254;
			close2;
			warp "alberta",117,57;
			end;
		} else if (job_ranger01 == 1) {
			if (Weight < 1) {
		mes "哇，你这么快就回来了。";
				next;
				mes "[Survival Instructor, Rescue]";
		mes "好，现在说说参加游侠测试的要求。";
				next;
				mes "[Survival Instructor, Rescue]";
		mes "成为游侠的所有测试都通过实践进行。";
				next;
				mes "[Survival Instructor, Rescue]";
		mes "会有笔试吗？";
				next;
				mes "[Survival Instructor, Rescue]";
		mes "你为什么想要笔试？";
		mes "这项测试最重要的是考验你在战场上的经验。";
				next;
				mes "[Survival Instructor, Rescue]";
		mes "所以，我要求你证明自己的生存能力。";
				next;
				mes "[Survival Instructor, Rescue]";
		mes "即使你倒下、挨打，我也想看到真正的生存力量。";
				next;
				mes "[Survival Instructor, Rescue]";
		mes "通过生存力量测试后，你就能获得第一项资格。";
				next;
				mes "[Survival Instructor, Rescue]";
		mes "获得测试资格后，我们再谈细节。";
		mes "想参加生存力量测试时，再来和我谈。";
				set job_ranger01,2;
				changequest 8254,8255;
				close;
			}
		mes "在你转职为游侠前，我需要评估你最纯粹的能力。";
			next;
			mes "[Survival Instructor, Rescue]";
		mes "为此，你需要净化身心。";
		mes "请确保负重为0才能继续。";
			close;
		} else if (job_ranger01 == 2) {
			if (Weight < 1) {
				mes "嗯。你再次来找我，说明你已决定转职为游侠并参加生存力量测试。";
				next;
				if(select("我再考虑一下:我要参加测试") == 1) {
					mes "[Survival Instructor, Rescue]";
					mes "参加测试前要做好充分准备。";
					next;
					mes "[Survival Instructor, Rescue]";
					mes "好好考虑后再回来。";
					close;
				}
				mes "[Survival Instructor, Rescue]";
				mes "既然你已经决定，就没什么好等的了。";
				next;
				mes "[Survival Instructor, Rescue]";
				mes "我简单说明一下。";
				mes "我会提供10个苍蝇翅膀、500支箭和1把测试弓。";
				next;
				mes "[Survival Instructor, Rescue]";
				mes "带上这些物品，生存力量测试只需要^0000ff前往海底洞穴西北区域寻找Teardrop教官^000000。";
				mes "很简单，对吧？";
				next;
				mes "[Survival Instructor, Rescue]";
				mes "记住你没有装备其他物品，所以要小心魔物。";
				mes "准备开始了吗？";
				next;
				if(select("等一下:好的，我准备好了") == 1) {
					mes "[Survival Instructor, Rescue]";
					mes "什么准备需要这么久。";
					next;
					mes "[Survival Instructor, Rescue]";
					mes "完全准备好后再来。";
					close;
				}
				mes "[Survival Instructor, Rescue]";
				mes "那么开始吧。";
				mes "没有时间犹豫。";
				mes "尽力而为。";
				set job_ranger01,3;
				changequest 8255,8256;
				getitem 1703,1; //Bow__
				getitem 12323,10; //N_Fly_Wing
				getitem 1750,500; //Arrow
				close;
			}
			mes "我就知道。";
			next;
			mes "[Survival Instructor, Rescue]";
			mes "你为什么带这么多东西？";
			mes "转职时努力是好事，但这项测试的关键是检验真正的能力……";
			next;
			mes "[Survival Instructor, Rescue]";
			mes "如果负重不是0，就无法参加测试。";
			close;
		} else if (job_ranger01 == 3) {
		mes "嗯？";
		mes "你在等什么？";
			next;
			if(select("再告诉我一次任务内容。:我只是想聊天。") == 1) {
				mes "[Survival Instructor, Rescue]";
				mes "哦，是吗。";
				mes "这就是要参加测试的人的状态吗？";
				next;
				mes "[Survival Instructor, Rescue]";
				mes "保持警觉，听好了。";
				next;
				mes "[Survival Instructor, Rescue]";
				mes "带上这些物品，生存力量测试只需要^0000ff前往海底洞穴西北区域寻找Teardrop教官^000000。";
				mes "很简单吧？";
				next;
				mes "[Survival Instructor, Rescue]";
				mes "因为你没有装备物品，要小心野外的魔物。";
				mes "那么，开始吗？";
				next;
				if(select("等一下:我开始") == 1) {
					mes "[Survival Instructor, Rescue]";
					mes "什么准备需要这么久。";
					next;
					mes "[Survival Instructor, Rescue]";
					mes "完全准备好后再来。";
					close;
				}
				mes "[Survival Instructor, Rescue]";
				mes "好，开始吧。";
				mes "没有时间犹豫，尽力而为。";
				close;
			}
			mes "[Survival Instructor, Rescue]";
			mes "我不认为你有那个时间。";
			next;
			mes "[Survival Instructor, Rescue]";
			mes "快点完成测试。";
			close;
		} else if (job_ranger01 > 3 && job_ranger01 < 7) {
			mes "你还在这里闲逛吗？";
			next;
			mes "[Survival Instructor, Rescue]";
			mes "如果你很随意，那与我无关；但既然已经决定，不如马上参加实践测试，成为游侠后再来见我？";
			close;
		} else if (job_ranger01 == 7) {
			mes "哦，嘿。你在这里做什么？";
			next;
			mes "[Survival Instructor, Rescue]";
			mes "因为你突然消失，游侠大师一直在找你。";
			mes "现在要去见他吗？";
			next;
			switch(select("不去:去")) {
			case 1:
				mes "[Survival Instructor, Rescue]";
				mes "你还有别的事要忙吗？";
				close;
			case 2:
				mes "[Survival Instructor, Rescue]";
				mes "那我送你过去，请多保重。";
				close2;
				warp "job3_rang01",89,38;
				end;
			}
		}
		mes "哦，嘿。这是谁？";
		next;
		mes "[Survival Instructor, Rescue]";
		mes "嘿，你看起来不错。";
		mes "恭喜你成为游侠～";
		next;
		mes "[Survival Instructor, Rescue]";
		mes "下次尽量别吓到别人。";
		close;
	}
	if (Class == Job_Ranger || Class == Job_Ranger_T || Class == Job_Baby_Ranger) {
		if (job_ranger01 == 8) {
		mes "哦，这是谁～";
		mes "你看起来真有天赋……";
			next;
			mes "[Survival Instructor, Rescue]";
		mes "下次尽量别吓到别人。";
			close;
		}
	}
	mes "哈哈～";
	mes "天气真好。";
	next;
	mes "[Survival Instructor, Rescue]";
	mes "怎么了？";
	mes "这里的魔物";
	mes "有点强，要小心。";
	close;
}

tur_dun01,91,169,3	script	Test Instructor#jr02	732,{
	mes "[Test Instructor, Teardrop]";
	if (BaseJob == Job_Hunter) {
		if (job_ranger01 < 3) {
			mes "准备好出发啦！！！！！！！";
			next;
			mes "[Test Instructor, Teardrop]";
			mes "嗯？你是谁？你这小弓箭手来这里做什么？";
			next;
			mes "[Test Instructor, Teardrop]";
			mes "我能告诉你一件事吗？";
			mes "想转职为游侠，先去和生存教官Rescue谈谈。";
			next;
			mes "[Test Instructor, Teardrop]";
			mes "他会告诉你转职测试的要求！！！";
			close;
		} else if (job_ranger01 == 3) {
			mes "准备好出发啦！！！！！！！";
			next;
			mes "[Test Instructor, Teardrop]";
			mes "嗯？你是谁？你这小弓箭手来这里做什么？";
			next;
			mes "[Test Instructor, Teardrop]";
			mes "你这样进进出出让我很烦，能停下来吗？！";
			next;
			if(select("游侠实践测试场？:我是来参加测试的。") == 1) {
				mes "[Test Instructor, Teardrop]";
			mes "什么，你在看什么……？";
				next;
				mes "[Test Instructor, Teardrop]";
			mes "你以为自己在看什么？";
				next;
				mes "[Test Instructor, Teardrop]";
			mes "连眼前的东西都认不出来，怎么能成为游侠？滚出去！";
				close;
			}
			mes "[Test Instructor, Teardrop]";
			mes "哦，能走到这里，说明你通过了第一次生存测试。";
			next;
			mes "[Test Instructor, Teardrop]";
			mes "不过，你能确定没有作弊吗？";
			next;
			if (Weight > 500) {
				mes "[Test Instructor, Teardrop]";
				mes "看吧，我就知道。";
				next;
				mes "[Test Instructor, Teardrop]";
				mes "正常完成测试的话，你应该把负重调到0，并拿着Rescue提供的物品！";
				mes "但你的负重为什么这么高？";
				next;
				mes "[Test Instructor, Teardrop]";
				mes "我认为这是作弊！";
				mes "再来见我！";
				close2;
				warp "tur_dun01",162,33;
				end;
			}
			mes "[Test Instructor, Teardrop]";
			mes "嗯……很可疑……";
			next;
			mes "[Test Instructor, Teardrop]";
			mes "目前我没有闻到作弊的迹象……";
			next;
			mes "[Test Instructor, Teardrop]";
			mes "参加实践测试前，我想吃点东西。";
			mes "你知道，在异国他乡食物状况不总是很好。";
			next;
			mes "[Test Instructor, Teardrop]";
			mes "我知道最基本的生存方式是增强自身力量。但对我来说，派冒险者去更容易。";
			next;
			mes "[Test Instructor, Teardrop]";
			mes "所以，杀死^0000ff1只龙尾^000000，带给我^0000ff1只蜻蜓翅膀^000000。";
			next;
			mes "[Test Instructor, Teardrop]";
			mes "提供的物品用完后我们无法补充，要小心。";
			mes "把这当作生存力量测试的延伸。";
			set job_ranger01,4;
			changequest 8256,8257;
			close;
		} else if (job_ranger01 == 4) {
			if (checkquest(8257,HUNTING) == 2) {
				if (countitem(7064) > 0) {
			mes "哦！哦！哇啊啊啊！";
			mes "你带来了！让我看看……";
					next;
					mes "[Test Instructor, Teardrop]";
			mes "嗯……它还很烫？！";
			mes "你看起来没有受伤……";
					next;
					mes "[Test Instructor, Teardrop]";
			mes "很好，你暂时具备参加实践测试的资格。";
					next;
					mes "[Test Instructor, Teardrop]";
			mes "在我解释之前，能把那只蜻蜓翅膀给我吗？";
			mes "你听过‘无论什么情况，吃饭第一’这句话吗？";
					delitem 7064,1; //Dragon_Fly_Wing
					set job_ranger01,5;
					changequest 8257,8258;
					close;
				}
			}
		mes "你站在那里做什么？一脸茫然。";
			next;
			mes "[Test Instructor, Teardrop]";
		mes "我饿了。";
		mes "参加实践测试前，我想吃点东西。";
			next;
			mes "[Test Instructor, Teardrop]";
			mes "我知道最基本的生存方式是增强自身力量。但对我来说，派冒险者去更容易。";
			next;
			mes "[Test Instructor, Teardrop]";
			mes "所以，杀死^0000ff1只龙尾^000000，带给我^0000ff1只蜻蜓翅膀^000000。";
			next;
			mes "[Test Instructor, Teardrop]";
			mes "提供的物品用完后我们无法补充，要小心。";
			mes "把这当作生存力量测试的延伸。";
			close;
		} else if (job_ranger01 == 5) {
		mes "嗷呜。真好吃。";
		mes "嗯？你在看什么？";
		mes "你也想吃吗？";
			next;
			switch(select("哦，尽管吃吧:……")) {
			case 1:
				mes "[Test Instructor, Teardrop]";
				mes "你为什么不吃？";
				mes "这完全可以吃。";
				mes "裹上米饭就像烤海苔，非常美味。";
				next;
				mes "[Test Instructor, Teardrop]";
				mes "你必须足够强大，不能对这种东西挑三拣四……";
				next;
				break;
			case 2:
				mes "["+strcharinfo(0)+"]";
				mes "不用了，谢谢……总之……";
				next;
				mes "[Test Instructor, Teardrop]";
				mes "嗯？哎呀，哎呀，我让你看到我邋遢的一面了。";
				next;
				break;
			}
			mes "[Test Instructor, Teardrop]";
			mes "好，我送你去实践测试场。";
			next;
			mes "[Test Instructor, Teardrop]";
			mes "实践测试总共分为3个部分。";
			mes "这是复核你作为猎人或神射手所学内容的测试，不必太担心。";
			next;
			mes "[Test Instructor, Teardrop]";
			mes "三项测试都达到及格分数，你就能成为游侠。";
			next;
			mes "[Test Instructor, Teardrop]";
			mes "我来说明测试流程。";
			next;
			mes "[Test Instructor, Teardrop]";
			mes "进入测试场后，工作人员会等你。进入工作人员准备的房间，待命即可。";
			next;
			mes "[Test Instructor, Teardrop]";
			mes "测试会逐一进行，所以人多时可能需要等待。";
			next;
			mes "[Test Instructor, Teardrop]";
			mes "第一项测试考验你的眼力。";
			mes "8个地点会出现不同魔物。只杀死名为‘Poring’的魔物即可得分，达到指定分数就能通过。简单吧？";
			next;
			mes "[Test Instructor, Teardrop]";
			mes "第二项测试考验你高效使用陷阱的能力。";
			mes "只使用提供的陷阱消灭魔物并完成任务即可通过。小心别被爆炸波及。";
			next;
			mes "[Test Instructor, Teardrop]";
			mes "第三项测试中，你将学习成为游侠后如何控制狼，并接受这方面的考验。";
			next;
			mes "[Test Instructor, Teardrop]";
			mes "使用提供的狼拆除炸弹即可得分。达到指定分数就能通过测试。";
			next;
			mes "[Test Instructor, Teardrop]";
			mes "那里的工作人员也会告诉你更多细节。";
			next;
			mes "[Test Instructor, Teardrop]";
			mes "现在我要让你进入实践测试场，准备好了吗？";
			next;
			if(select("请再等一下:我们去实践测试场吧！") == 1) {
				mes "[Test Instructor, Teardrop]";
				mes "嗯？你还没准备好吗？";
				next;

	emotion ET_HUK;
	next;
	mes "["+ strcharinfo(0) +"]";
	mes "嘿，你！小恶魔兽！！！";
	mes "真是个调皮鬼！！！抓到你了！";
	next;
	mes "-你迅速抓住了-";
	mes "-小恶魔兽的后颈-";
	next;
	mes "[小恶魔兽]";
	mes "你在做什么！？";
	mes "人类？";
	mes "现在就放开我……！";
	emotion ET_HUK;
	emotion ET_HUK, playerattached();
	next;
	mes "-小恶魔兽迅速逃走了-";
	mes "-并嘟囔着什么。-";
	mes "-你的身体突然飘了起来。-";
	close2;
	warp getarg(0),getarg(1),getarg(2);
	end;
}


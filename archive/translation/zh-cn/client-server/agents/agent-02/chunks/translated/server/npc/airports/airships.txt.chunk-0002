airplane_01,250,58,2	script	Airship Staff#airplane01	67,{
	mes "[Airship Staff]";
	mes "欢迎";
	mes "来到飞艇。";
	mes "我能为你做些什么？";
	next;
	switch (select("Using the Airship:Captain's Cabin:Facilities:Cancel")) {
	case 1:
		mes "[Airship Staff]";
		mes "听到广播通知";
		mes "抵达你的目的地后，";
		mes "请使用飞艇北端或南端";
		mes "的出口下船。";
		mes "出口位于飞艇两端。";
		mes "请不要错过下船时机。";
		next;
		mes "[Airship Staff]";
		mes "如果不小心错过了";
		mes "下船地点，也不用担心。";
		mes "飞艇会持续航行，";
		mes "你还会有机会再次抵达";
		mes "原本想去的目的地。";
		mes "请耐心等待下一站。";
		close;
	case 2:
		mes "[Airship Staff]";
		mes "船长室位于飞艇前部。";
		mes "在那里，你可以见到船长";
		mes "以及飞艇驾驶员。";
		mes "如果有问题，可以去那里咨询。";
		mes "祝你旅途顺利。";
		close;
	case 3:
		mes "[Airship Staff]";
		mes "飞艇为所有乘客准备了";
		mes "各种小游戏。";
		mes "欢迎你来试试运气，";
		mes "展现自己的技巧。";
		mes "快来参加飞艇小游戏吧～";
		mes "祝你玩得开心。";
		close;
	case 4:
		mes "[Airship Staff]";
		mes "希望你喜欢乘坐";
		mes "我们的飞艇。";
		mes "谢谢你，";
		mes "祝你今天愉快。";
		close;
	}
}

airplane_01,50,66,5	script	Apple Merchant#air01	86,{
	if (checkweight(1201,1) == 0) {
		mes "- 等一下！！-";
		mes "- 你当前携带的物品 -";
		mes "- 太多了。-";
		mes "- 请减轻负重后 -";
		mes "- 再试一次。-";
		close;
	}
	mes "[Meltz]";
	mes "欢迎来到梅尔兹的商店，";
	mes "你可以在这里购买苹果，";
	mes "也可以把苹果研磨成";
	mes "苹果汁。";
	next;
	switch (select("Buy Apples.:Make Apple Juice.:Cancel.")) {
	case 1:
		mes "[Meltz]";
		mes "请输入想购买的苹果数量。";
		mes "每个苹果需要 15 Zeny，";
		mes "一次最多购买 500 个。";
		mes "请输入数量，";
		mes "输入‘0’可取消订单。";
		mes "请确认后再提交。";
		next;
		while (1) {
			input .@input;
			set .@pay, .@input * 15;
			if (.@input == 0) {
				mes "[Meltz]";
				mes "谢谢你光顾我的商店。";
				mes "再见！";
				mes "想吃苹果的时候，";
				mes "随时都可以来。";
				mes "来点苹果当零食吧～";
				close;
			}
			else if (.@input < 1 || .@input > 500) {
				mes "[Meltz]";
				mes "你输入的数量超过了最大值。";
				mes "最大值为 500。";
				mes "请重新输入";
				mes "想购买的苹果数量。";
				mes "谢谢配合。";
				next;
			}
			else {
				mes "[Meltz]";
				mes "总计 ^FF0000" + .@input + "^000000 个苹果";
				mes "需要支付 ^FF0000" + .@pay + "^000000 Zeny。";
				mes "要继续吗？";
				next;
				if (select("Yes:No") == 2) {
					mes "[Meltz]";
					mes "谢谢你光顾我的商店。";
					mes "再见！";
					mes "想吃苹果的时候，";
					mes "随时都可以来。";
					mes "来点苹果当零食吧～";
					close;
				}
				break;
			}
		}
		if (Zeny < .@pay) {
			mes "[Meltz]";
			mes "抱歉，你的钱不够。";
			mes "请检查你的资金，";
			mes "或者少买一些苹果。";
			mes "谢谢理解。";
			close;
		}
		else if (checkweight(512,.@input) == 0) {
			mes "[Meltz]";
			mes "嗯……你的背包空间似乎不够。";
			mes "装不下这么多苹果。";
			mes "请先整理一下背包";
			mes "空间，再来购买吧。";
			mes "谢谢。";
			close;
		}
		else {
			set Zeny, Zeny - .@pay;
			getitem 512,.@input; //Apple
			mes "[Meltz]";
			mes "谢谢你光顾我的商店。";
			mes "希望你喜欢这些苹果的味道～！";
			mes "欢迎随时再来。";
			close;
		}
	case 2:
		mes "[Meltz]";
		mes "好的，我需要";
		mes "^FF00003 个苹果和 1 个空瓶^000000";
		mes "来为你制作 1 瓶苹果汁。";
		mes "要继续吗？";
		next;
		switch (select("Yes:No")) {
		case 1:
			if (countitem(512) < 3 || countitem(713) < 1) {
				mes "[Meltz]";
				mes "抱歉，你没有足够的材料。";
				mes "无法制作苹果汁。";
				mes "需要 3 个苹果";
				mes "和 1 个空瓶才能制作。";
				close;
			}
			else {
				mes "[Meltz]";
				mes "谢谢，请稍等。";
				next;
				mes "^3355FF*Grind* *Grind*";
				mes "*Grind* *Grind*";
				mes "*Clang...!*^000000";
				next;
				delitem 512,3; //Apple
				delitem 713,1; //Empty_Bottle
				getitem 531,1; //Apple_Juice
				mes "[Meltz]";
				mes "给你～";
				mes "欢迎下次再来。";
				close;
			}
		case 2:
			mes "[Meltz]";
			mes "谢谢你光顾我的商店。";
			mes "再见！";
			mes "想吃苹果的时候，";
			mes "随时都可以来。";
			mes "来点苹果当零食吧～";
			close;
		}
	case 3:
		mes "[Meltz]";
		mes "谢谢你光顾我的商店。";
		mes "再见！";
		mes "想吃苹果的时候，";
		mes "随时都可以来。";
		mes "来点苹果当零食吧～";
		close;
	}
}

airplane_01,221,158,2	script	Pilot#airplane_01	852,{
	switch (rand(1,4)) {
	case 1:
		mes "[Pilot]";
		mes "东经 131 度。";
		mes "北纬 37 度。";
		mes "航向正确，船长。";
		close;
	case 2:
		mes "[Pilot]";
		mes "今天看来云层很厚。";
		mes "天空不晴朗时很难导航。";
		mes "看来我们得增强雷达信号。";
		mes "请注意周围气流。";
		mes "准备调整航线。";
		close;
	case 3:
		mes "[Pilot]";
		mes "船长是个好人，";
		mes "我想不到更适合指挥";
		mes "这艘船的人了。";
		mes "不过他确实很严厉，";
		mes "简直像个监工。";
		next;
		mes "[^ff0000Tarlock^000000]";
		mes "^ff0000喂……！^000000";
		mes "^ff0000少闲聊，^000000";
		mes "^ff0000专心驾驶！^000000";
		next;
		mes "[Pilot]";
		mes "是、是的，长官！";
		mes "（看到了吧？）";
		close;
	default:
		mes "[Pilot]";
		mes "这身制服确实很帅气，";
		mes "不过……";
		//
	

			next;
			mes "[助理娜奥米]";
			mes "所以他才把你送到这里。顺便说，这不是我第一次听到这种事。";
			next;
			mes "[助理娜奥米]";
			mes "卢恩·米德加尔特王国和阿鲁纳佩兹建立后，关于那些部族、神话等的传闻在暗中流传开来。";
			next;
			mes "[助理娜奥米]";
			mes "总之，你应该把这些书都读完，我继续做我的工作。";
			next;
			mes "["+.@name$+"]";
			mes "不是应该由我来整理这些书吗？";
			next;
			mes "[助理娜奥米]";
			mes "医生说他会让别人来取书。而且，你不是需要了解该做什么的基本信息吗？";
			next;
			mes "[助理娜奥米]";
			mes "回医生那里之前，你最好读读这些书。那我就继续工作了。";
			set ins_nyd,4;
			close;
		}
	} else if (ins_nyd == 4) {
		mes "四处看看，读读这些书。";
		next;
		switch(select("异质性发现:原住民部族报告")) {
		case 1:
			mes "魔王梦罗克知道自己并非正常复活，也不是独自复活。";
			next;
			mes "卢恩·米德加尔特的冒险家不断攻击他，他的力量正在逐渐衰退。要完全复活还需要更多时间。";
			next;
			mes "魔王梦罗克先摧毁梦罗克城，将其变成废墟沙漠，随后开始撕裂世界。";
			next;
			mes "魔王梦罗克担心追兵，于是制造了梦罗克克隆体，留在身后监视。";
			next;
			mes "它们以梦罗克为原型，外貌使人难以绕过时空裂隙。";
			next;
			mes "但冒险家仍然追赶。他们来自世界各地，试图接近次元峡谷。";
			next;
			mes "这些冒险家的报告被送往各王国代表处，并成立了远征队以调查更多信息。";
			next;
			mes "施瓦尔茨瓦尔德的科学家利用次元峡谷发现的金属碎片，制造出一种合金。";
			next;
			mes "施瓦尔茨瓦尔德共和国请求调查新金属来源；由于卢恩·米德加尔特无法自行完成测试，最终同意了请求。";
			next;
			mes "他们联合起来招募志愿者，刺客公会第一个报名。";
			next;
			mes "刺客与魔王梦罗克有不堪回首的过去，于是集结 18 名成员追捕他。";
			next;
			mes "约 3 小时后，18 名成员平安归来，男女成员分享了收集到的信息。";
			next;
			mes "他们发现了另一个性质和环境完全不同的世界，而且人类也能在那里生活。";
			next;
			mes "最令人惊讶的是时间流速。18 名刺客在那里待了约两周，却在出发后 3 小时内返回。";
			next;
			mes "最后要测试的是……派遣自愿探索新世界的冒险家。";
			next;
			mes "冒险家申请如潮水般涌来。许多志愿者穿越次元峡谷后消失，又带回了新资料。";
			next;
			mes "新世界存在 3 种完全不同的生态系统，取决于居住者的种族。";
			next;
			mes "必须彻底而谨慎地研究异质现象，才能理解他们的世界与我们的关系。";
			next;
			mes "就在大家以为不可能前往异世界时，新篇章的第一页被翻开了。";
			close;
		case 2:
			mes "很久以前，没有太阳、月亮或星星，只有空旷的大地……巨人尤弥尔诞生了。后来尤弥尔生下儿子，逐渐壮大。";
			next;
			mes "但他的儿子们也长大了，奥丁、威利和维三位兄弟从不同方向袭击并杀死了他。";
			next;
			mes "尤弥尔倒下时，鲜血淹没了世界……杀死沿途的一切。";
			next;
			mes "只有萨帕族的赫维格尔米尔逃过血潮。他在被迷雾和积雪覆盖的约顿海姆发誓复仇。";
			next;
			mes "如今，在次元峡谷之外发现了萨帕族的一员。";
			next;
			mes "除了萨帕族，时空裂隙之外还有另一个部族，名为拉菲涅族。";
			next;
			mes "拉菲涅族也集结远征，探索时空裂隙，查明世界树的异常症状并寻找治疗方法。";
			next;
			mes "拉菲涅族负责管理伊格德拉西尔，在阿斯加德附近建立领地，保护伊格德拉西尔魔力的平衡。";
			next;
			mes "拉菲涅族从未与阿斯加德之外的人接触。但当他们发现伊格德拉西尔的力量正在衰弱……";
			next;
			mes "自神与魔法师的战争结束后，他们宣布将首次在一千个人类年后参加最高议会。";
			close;
		}
	} else {
		mes "医生一直不肯回来，而且事情太多了……我怎么忙得过来……";
		next;
		mes "[助理娜奥米]";
		mes "你没看到我很忙吗？别磨蹭，快走！";
		close;
	}
}

splendide,198,178,3	script	Grumbling Soldier#edq	447,3,3,{
	mes "[抱怨的士兵]";
	if (isequipped(2782) == 1) {
		mes "如今世界变得不稳定，我连飞行都无法安心。";
		next;
		if (ins_nyd == 5) {
			switch(select("北边的洞窟怎么回事？:萨帕族人是谁？:嗯，我们以后再聊。")) {
			case 1:
				mes "[抱怨的士兵]";
				mes "什么？如果你在那里闲逛……可能会受伤回来。";
				next;
				mes "[抱怨的士兵]";
				mes "我也说不清，但那里仿佛心情很差。里面有很多可怕的怪物。";
				next;
				mes "[抱怨的士兵]";
				mes "他们彼此低语，所以……那里肯定有什么……但我不在乎……";
				next;
				mes "[抱怨的士兵]";
				mes "也许……萨帕族人以前在洞窟里挖掘过……他们确实很擅长挖洞。";
				set ins_nyd,51;
				close;
			case 2:
				mes "[抱怨的士兵]";
				mes "哦！正因为他们，我们才在这座卑鄙肮脏的城市生活了一百多年。";
				next;
				mes "[抱怨的士兵]";
				mes "他们根本不在乎伊格德拉西尔是否出问题。";
				next;
				mes "[抱怨的士兵]";
				mes "他们肯定满脑子坏主意，所以……毁坏了伊格德拉西尔的根。";
				next;
				mes "[抱怨的士兵]";
				mes "我们在这里就是为了确保萨帕族不把事情变得更糟。";
				close;
			case 3:
				close;
			}
		} else {
			mes "[抱怨的士兵]";
			mes "如今世界变得不稳定，我连飞行都无法安心。";
			next;
			mes "[抱怨的士兵]";
			mes "当马努克巨人开始挖掘大地、破坏伊格德拉西尔时，你还能指望什么……";
			next;
			mes "[抱怨的士兵]";
			mes "最糟糕的是……城镇街道上竟有奇怪的东西大摇大摆……";
			next;
			mes "[抱怨的士兵]";
			mes "对，就是你……你怎么看政府处理这件事的方式……？";
			next;
			mes "[抱怨的士兵]";
			mes "虽然他们忽略了你的经历，但还是要小心……";
			close;
		}
	} else {
		mes "SeLarsmar Di marThusVil U SeMushVohl";
		close;
	}
}

splendide,240,164,3	script	Sighing Soldier#edq	461,3,3,{
	mes "[叹气的士兵]";
	if (isequipped(2782) == 1) {
		mes "我们什么时候才能结束与萨帕族的战斗？呜啊啊啊……";
		next;
		if (ins_nyd == 5) {
			switch(select("北边的洞窟怎么回事？:萨帕族人是谁？:嗯，我们以后再聊。")) {
			case 1:
				mes "[叹气的士兵]";
				mes "嗯……我不确定，但我们一直避免前往那片区域。";
				next;
				mes "[叹气的士兵]";
				mes "有时派去的研究员会在这里徘徊……那里什么也没有，真让人难受……";
				next;
				mes "[叹气的士兵]";
				mes "但指挥官们确信那里藏着什么。";
				next;
				mes "[叹气的士兵]";
				mes "我们不知道那里的怪物有多强，所以从未调查。但就个人而言，没人想去那里……";
				set ins_nyd,51;
				close;
			case 2:
				mes "[叹气的士兵]";
				mes "我不知道其他人怎么想……但我们对萨帕族的态度确实带来了麻烦。";
				next;
				mes "[叹气的士兵]";
				mes "我们没有尝试通过谈判解决问题，而是先攻击了他们。";
				next;
				mes "[叹气的士兵]";
				mes "也许……我们的指挥官不愿接受与我们不同的种族……";
				next;
				mes "[叹气的士兵]";
				mes "别误会……最近我们谈到你们这个特殊种族，指挥官们对你们心怀感激。";
				next;
				mes "[叹气的士兵]";
				mes "总之……这种无谓又令人紧张的局面让我筋疲力尽……唉。";
				close;
			case 3:
				close;
			}
		} else {
			mes "[叹气的士兵]";
			mes "我们什么时候才能结束与萨帕族的战斗？呜啊啊啊……";
			next;
			mes "[叹气的士兵]";
			mes "说实话，我不认为你或任何萨帕族人是我们的敌人。唉……";
			next;
			mes "[叹气的士兵]";
			mes "难道不能通过沟通解决吗？无谓的战斗毫无意义！真是的。";
			close;
		}
	} else {
		mes "VohlLarsmar Ha DielCyatas";
		close;
	}
}

spl_in01,109,60,3	script	Commander Lebiordirr#edq	435,3,3,{
		mes "[莱比奥迪尔指挥官]";
	if (isequipped(2782) == 1) {
		if (ins_nyd == 51) {
			mes "你是……收集我士兵信息的那个人吗……？";
			next;
			mes "[莱比奥迪尔指挥官]";
			mes "你应该谨慎。我们的部族尊重人类的存在，但……";
			next;
			mes "[莱比奥迪尔指挥官]";
			mes "允许你来到这里让我冒了很大风险，所以务必小心。";
			next;
			mes "[莱比奥迪尔指挥官]";
			mes "别引起太多注意，否则会让你们的族群难堪。";
			next;
			mes "[莱比奥迪尔指挥官]";
			mes "我们没必要多谈，你回到来处去吧。";
			next;
			mes "[莱比奥迪尔指挥官]";
			mes "除非你有话要对我说……看你的表情，似乎确实有……";
			next;
			if(select("不，没什么。以后再聊。:我打算留下，有充分理由。")==1) close;
			mes "[斯普伦迪德守卫]";
			mes "先生，我现在就可以把这个害虫拖出去。";
			next;
			mes "[莱比奥迪尔指挥官]";
			mes "不，先听听解释。好吧？现在，如果你愿意……";
			next;
			mes "[莱比奥迪尔指挥官]";
			mes "我知道最近时间出现了裂痕……所以你是来寻找解决办法的，对吗？";
			next;
			mes "[莱比奥迪尔指挥官]";
			mes "我们的部族尊重你，所以别再在这里搜寻和探索了。";
			next;
			mes "[莱比奥迪尔指挥官]";
			mes "我听说你要去北边的封闭洞窟寻找宝藏。";
			next;
			mes "[莱比奥迪尔指挥官]";
			mes "那个地方是拉菲涅族下令禁止进入的，未经许可不能前往。";
			next;
			mes "[莱比奥迪尔指挥官]";
			mes "如果你不遵守这条规则，我会停止与你来往，并禁止你们所有人进入这里。";
			next;
			mes "[莱比奥迪尔指挥官]";
			mes "我们与萨帕族的关系仍不稳定，通常不愿为外来者费心。";
			next;
			mes "[莱比奥迪尔指挥官]";
			mes "现在你明白了，就把这些告诉你的朋友。";
			set ins_nyd,61;
			close;
		} else if (ins_nyd == 61) {
			mes "如果你不遵守这条规则，我会停止与你来往，并禁止你们所有人进入这里。";
			next;
			mes "[莱比奥迪尔指挥官]";
			mes "我们与萨帕族的关系仍不稳定，通常不愿为外来者费心。";
			next;
			mes "[莱比奥迪尔指挥官]";
			mes "现在你明白了，就把这些告诉你的朋友。";
			close;
		} else if (ins_nyd == 81) {
			mes "外来者，你为什么回来？";
			next;
			select("询问拉菲涅族探索的事……");
			mes "[莱比奥迪尔指挥官]";
			mes "探索什么？说话小心点。";
			next;
			mes "[莱比奥迪尔指挥官]";
			mes "我们是不是没说清楚？你想要什么？";
			next;
			select("我必须探索洞窟。" );
			mes "[莱比奥迪尔指挥官]";
			mes "也就是说……你无视我的警告？这是你的决定，还是你只是在服从命令？";
			next;
			select("我只是在服从命令");
			mes "[莱比奥迪尔指挥官]";
			mes "外来者，你是故意想侮辱我吗？";
			next;
			mes "[莱比奥迪尔指挥官]";
			mes "你为什么想探索？最好有充分理由。";
			next;
			select("这是关于放大镜博士的报告……");
			mes "[莱比奥迪尔指挥官]";
			mes "所以……我为什么要在意外来者的报告？";
			next;
			mes "[莱比奥迪尔指挥官]";
			mes "保护伊格德拉西尔！这是拉菲涅族的命运。你能对自己这么说吗？";
			next;
			mes "[莱比奥迪尔指挥官]";
			mes "你有奥丁和伊格德拉西尔祝福你出生的证明吗？";
			next;
			mes "[莱比奥迪尔指挥官]";
			mes "我不该再说了。请别觉得我无礼，但现在请离开！";
			next;
			select("那我就向萨帕族求助。" );
			mes "[莱比奥迪尔指挥官]";
			mes "你在说什么，外来者？";
			next;
			mes "[斯普伦迪德守卫]";
			mes "先生，如果您愿意，我可以处理掉这个无礼的外来者。";
			next;
			mes "[莱比奥迪尔指挥官]";
			mes "不，等等……萨帕族人知道那个地方的意义？你要和他们合作？";
			next;
			mes "[莱比奥迪尔指挥官]";
			mes "啊……真狡猾……你是在试探我们吗？";
			next;
			mes "[斯普伦迪德守卫]";
			mes "冷静，先生。我会把这个外来者扔进监狱。";
			next;
			mes "[莱比奥迪尔指挥官]";
			mes "不……不，等等。好吧，我接受。我可以允许你进入神圣的塞科斯。";
			next;
			mes "[莱比奥迪尔指挥官]";
			mes "好。如果你如你所说是伊格德拉西尔的仆从，我允许你进入。但我不对你的行为负责。";
			next;
			mes "[莱比奥迪尔指挥官]";
			mes "如果在那里发现任何异常，务必与我们分享！";
			next;
			select("当然！");
			mes "[莱比奥迪尔指挥官]";
			mes "那么……既然我同意你探索……阿里奥斯，帮助他们并记录结果。";
			next;
			mes "[阿里奥斯助手]";
			mes "先生……您确定吗？这可是对神圣塞科斯的入侵……";
			next;
			mes "[莱比奥迪尔指挥官]";
			mes "‘入侵’这个词太严重了。我只是允许他们进入。总比让肮脏的巨人进入好，这也许能救我们的命……";
			next;
			mes "[莱比奥迪尔指挥官]";
			mes "来，外来者。阿里奥斯会解释巨人的情况，和他谈谈……";
			set ins_nyd,91;
			close;
		} else if ((ins_nyd == 91) || (ins_nyd == 101) || (ins_nyd == 111) || (ins_nyd == 200) || (ins_nyd == 201) || (ins_nyd == 202)) {
			mes "外来者。阿里奥斯会解释巨人的情况，和他谈谈……";
			close;
		} else if ((ins_nyd == 72) || (ins_nyd == 82) || (ins_nyd == 92) || (ins_nyd == 102) || (ins_nyd == 112) || (ins_nyd == 122) || (ins_nyd == 132)) {
			mes "外来者，欢迎来到斯普伦迪德的拉菲涅营地……我是莱比奥迪尔，这里由我负责。";
			next;
			mes "[莱比奥迪尔指挥官]";
			mes "行事要谨慎。我们和萨帕族已经有很多问题了。";
			next;
			mes "[莱比奥迪尔指挥官]";
			mes "只要你行事谨慎，我不会伤害你。告辞。";
			close;
		} else if (ins_nyd == 203) {
			mes "我在等你。你平安回来是好消息。找到什么了吗？";
			next;
			select("说明守护者尼德霍格离开的事。");
			mes "[莱比奥迪尔指挥官]";
			mes "什么？守护者不在巢穴里……？";
			next;
			mes "[莱比奥迪尔指挥官]";
			mes "而且因为他的失踪，守护者之影正在摧毁世界树的根部……？";
			next;
			mes "[莱比奥迪尔指挥官]";
			mes "难以置信。你一定是在侮辱守护者和我们的尊严。我帮你不是为了听这些。";
			next;
			mes "[阿里奥斯助手]";
			mes "不是那样，指挥官。他们说的是事实。";
			next;
			mes "[莱比奥迪尔指挥官]";
			mes "你在说什么？阿里奥斯，别忘了你作为守护者祭司的身份。";
			next;
			mes "[阿里奥斯助手]";
			mes "虽然我没亲眼见过，但这确实解释了我们为何与伟大的世界树伊格德拉西尔失去联系。";
			next;
			mes "[莱比奥迪尔指挥官]";
			mes "不要如此轻率地提及殿下、世界树伊格德拉西尔的名字。";
			next;
			select("转述世界树伊格德拉西尔的话。");
			mes "[莱比奥迪尔指挥官]";
			mes "殿下、世界树伊格德拉西尔，是这么说的吗？";
			next;
			mes "[莱比奥迪尔指挥官]";
			mes "这一切的原因……不是萨帕族，而是守护者突然离开？守护者放弃了自己的身份？";
			next;
			mes "[莱比奥迪尔指挥官]";
			mes "必须报告……报告给阿尔夫海姆的大祭司……难以置信。";
			next;
			mes "[阿里奥斯助手]";
			mes "指挥官……我们需要通知部族其他人吗……？";
			next;
			mes "[莱比奥迪尔指挥官]";
			mes "不用担心，阿里奥斯。作为指挥官，我会处理。你只要假装什么也没发生……";
			next;
			mes "[莱比奥迪尔指挥官]";
			mes "陌生人，谢谢你在这种情况下的配合……请忘记今天发生的一切……";
			next;
			mes "[莱比奥迪尔指挥官]";
			mes "阿里奥斯，请补偿这位陌生人的帮助。我得去休息了……";
			next;
			mes "[阿里奥斯助手]";
			mes "指挥官……";
			set ins_nyd,121;
			close;
		} else if ((ins_nyd == 121) || (ins_nyd == 131)) {
			mes "陌生人，谢谢你在这种情况下的配合……请忘记今天发生的一切……";
			close;
		} else {
			mes "外来者，欢迎来到斯普伦迪德的拉菲涅营地……我是莱比奥迪尔，这里由我负责。";
			next;
			mes "[莱比奥迪尔指挥官]";
			mes "行事要谨慎。我们和萨帕族已经有很多问题了。";
			next;
			mes "[莱比奥迪尔指挥官]";
			mes "只要你行事谨慎，我不会伤害你。告辞。";
			close;
		}
	} else {
		mes "ThusDurnah Ra SharVeldIyaz U UorAmanDur Yee neaOsaAdor Yee……";
		close;
	}
}

spl_in01,104,56,3	script	Aide Arioss#edq	437,3,3,{
		mes "[阿里奥斯助手]";
	if (isequipped(2782) == 1) {
		if (ins_nyd == 91) {
			mes "唉，既然是莱比奥迪尔指挥官的要求，我会配合你……";
			next;
			mes "[阿里奥斯助手]";
			mes "你想去那里，弄清楚那究竟是什么地方？";
			next;
			mes "[阿里奥斯助手]";
			mes "好吧……正如你猜的，那是连接世界树的地方，也是守护者的巢穴。";
			next;
			select("守护者的巢穴？");
			mes "[阿里奥斯助手]";
			mes "是的，那是世界树守护者尼德霍格的巢穴……";
			next;
			mes "[阿里奥斯助手]";
			mes "只有拉菲涅族被标记的守护者仆从才能进入。";
			next;
			mes "[阿里奥斯助手]";
			mes "那个地方最初不对公众开放，但萨帕族的巨人改变了一切……";
			next;
			mes "[阿里奥斯助手]";
			mes "为了获得更多矿物，他们开始疯狂挖掘。";
			next;
			mes "[阿里奥斯助手]";
			mes "最终，他们伤害了靠近矿井的世界树根部，使世界树病得很重。";
			next;
			mes "[阿里奥斯助手]";
			mes "我们了解情况来到这里时，世界树已经因萨帕族建造的大量工厂而陷入糟糕状态。";
			next;
			mes "[阿里奥斯助手]";
			mes "虽然我们长期攻击萨帕族，试图迫使他们离开，但他们并不容易击败，于是形成僵局。";
			next;
			mes "[阿里奥斯助手]";
			mes "在此期间，你们的人通过时空裂隙来到这片土地。";
			next;
			mes "[阿里奥斯助手]";
			mes "由于种种意外，本应深藏地下的守护者巢穴被你们发现了……";
			next;
			mes "[阿里奥斯助手]";
			mes "现在你明白情况有多严重了。因为萨帕族，我们无法接近守护者，也无法求教智慧。";
			next;
			mes "[阿里奥斯助手]";
			mes "这严重伤害了我们的自尊……但如果你能帮助我们再次进入那里，与守护者交谈，也许能找到解决办法……";
			next;
			mes "[阿里奥斯助手]";
			mes "那就拜托你了。至于你的请求，我会尽力配合。";
			next;
			mes "[阿里奥斯助手]";
			mes "我已经告诉你想知道的事了……还需要什么就告诉我。";
			set ins_nyd,101;
			close;
		} else if (ins_nyd == 101) {
			mes "你说有股奇怪力量阻挡着守护者巢穴入口，对吧？";
			next;
			mes "[阿里奥斯助手]";
			mes "因为只有被守护者选中的人才能进入。";
			next;
			mes "[阿里奥斯助手]";
			mes "我们世代都是守护者的仆从，一直保护着世界树。";
			next;
			mes "[阿里奥斯助手]";
			mes "在被抓到这里之前，包括我在内共有 3 名仆从。我们的任务是治愈世界树。";
			next;
			mes "[阿里奥斯助手]";
			mes "一人在我们与萨帕族的最后一场战争中被杀……另一人则被俘虏。";
			next;
			mes "[阿里奥斯助手]";
			mes "我会给你证明。别担心，我只是暂时把你标记为守护者仆从。";
			specialeffect2 EF_HOLYHIT;
			next;
			mes "[阿里奥斯助手]";
			mes "另外记住这个咒语，打开守护者之门需要它。";

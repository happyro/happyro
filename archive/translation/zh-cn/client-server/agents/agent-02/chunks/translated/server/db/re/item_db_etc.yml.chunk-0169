    SubType: Enchant
    Script: |
      .@g = getenchantgrade();
      bonus2 bMagicAddEle,Ele_Holy,5;
      bonus2 bAddEle,Ele_Holy,5;
      if (.@g>=ENCHANTGRADE_B) {
         bonus2 bMagicAddEle,Ele_Holy,5;
         bonus2 bAddEle,Ele_Holy,5;
         if (.@g>=ENCHANTGRADE_A) {
            bonus2 bMagicAddEle,Ele_Holy,5;
            bonus2 bAddEle,Ele_Holy,5;
         }
      }

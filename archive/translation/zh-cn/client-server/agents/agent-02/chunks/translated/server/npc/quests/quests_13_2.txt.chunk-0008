mid_camp,197,237,3	script	Schwarzwald Mechanic#1	869,{
	if( !checkweight(2782,1)) { // Custom weight check.
		mes "[Mechanic Engineer Dorance]";
		mes "你似乎带了太多东西。";
		mes "不如把一部分物品存进仓库后再回来？";
		close;
	}
	if (ep13_1_edq > 2 || ep13_start == 100) {
		if (ep13_2_rhea < 1) {
			mes "[Mechanic Engineer Dorance]";
			mes "你知道古代贤王之戒吗？戴上那枚戒指，你就能和动物交谈。";
			next;
			mes "[Mechanic Engineer Dorance]";
			mes "我不知道那是否是真实传说……但那种东西肯定很方便。";
			next;
			mes "[Mechanic Engineer Dorance]";
			mes "远征队营地外有一个动物种族，使用米德加尔特没有的神秘语言。";
			next;
			mes "[Mechanic Engineer Dorance]";
			mes "我们不知道他们是敌是友，但如果能弄清楚，对这里的研究会容易得多。";
			next;
			mes "[Mechanic Engineer Dorance]";
			mes "因此，三国联盟研究组正在合作调查。我想知道 ^0000ff阿鲁纳佩兹语言学家^000000 的解码进度。你能替我去问问吗？";
			next;
			mes "[Mechanic Engineer Dorance]";
			mes "^0000ff阿鲁纳佩兹语言学家^000000 应该在联盟总部二楼。";
			setquest 8243;
			set ep13_2_rhea,1;
			close;
		}
		else if ((ep13_2_rhea > 0) && (ep13_2_rhea < 7)) {
			mes "[Mechanic Engineer Dorance]";
			mes "远征队营地外有一个种族，使用米德加尔特没有的神秘语言。";
			next;
			mes "[Mechanic Engineer Dorance]";
			mes "我们不知道他们是敌是友，但有一点可以确定：这会让我们的研究更容易。";
			next;
			mes "[Mechanic Engineer Dorance]";
			mes "因此，三国联盟研究组正在合作调查。我想知道 ^0000ff阿鲁纳佩兹语言学家^000000 的解码进度。你能替我去问问吗？";
			next;
			mes "[Mechanic Engineer Dorance]";
			mes "去远征队营地中央的大楼，在里面找到 ^0000ff阿鲁纳佩兹语言学家^000000，询问他的进展。";
			next;
			mes "[Mechanic Engineer Dorance]";
			mes "^0000ff阿鲁纳佩兹语言学家^000000 应该在联盟总部二楼。";
			close;
		}
		else if (ep13_2_rhea == 7) {
			mes "- 他面对堆积如山的研究文件，露出凝重的表情。-";
			next;
			mes "[Mechanic Engineer Dorance]";
			mes "啊，你来了。";
			next;
			mes "[Mechanic Engineer Dorance]";
			mes "看来你为我们做了很多。我很感谢。";
			mes "但是……唉……";
			next;
			mes "[Mechanic Engineer Dorance]";
			mes "你看到了吗？这些研究文件的数量？";
			mes "终于解码了异世界的语言固然是好事……但文件实在太多了。";
			next;
			mes "[Mechanic Engineer Dorance]";
			mes "我们不可能总让语言学家陪同翻译……要探索这个世界，就必须与那些异世界种族交流……";
			next;
			mes "[Mechanic Engineer Dorance]";
			mes "要存储这么多信息，需要一台和总部大楼一样大的超级计算机，而且处理速度会非常非常慢。";
			next;
			mes "[Mechanic Engineer Dorance]";
			mes "唉……总之，如果能以某种方式存储海量数据，我应该就能制作出很小的便携式翻译器。";
			next;
			mes "[Mechanic Engineer Dorance]";
			mes "我听说使用卢恩·米德加尔特的魔法，可以把数据转换为魔力并封存在宝石中……我想听听卢恩·米德加尔特魔法师的建议。";
			next;
			mes "[Mechanic Engineer Dorance]";
			mes "能请你去向他们求助吗？";
			next;
			mes "[Mechanic Engineer Dorance]";
			mes "你离开期间，我会留在这里整理这些文件。";
			completequest 8248;
			setquest 8249;
			set ep13_2_rhea,8;
			close;
		}
		else if ((ep13_2_rhea > 7) && (ep13_2_rhea < 11)) {
			mes "[Mechanic Engineer Dorance]";
			mes "要存储这么多信息，需要一台和总部大楼一样大的超级计算机，而且处理速度会非常非常慢……";
			next;
			mes "[Mechanic Engineer Dorance]";
			mes "唉……总之，如果能以某种方式存储海量数据，我就能制作出很小的便携式翻译器。";
			next;
			mes "[Mechanic Engineer Dorance]";
			mes "我听说使用卢恩·米德加尔特的魔法，可以把数据转换为魔力并封存在宝石中……我想听听卢恩·米德加尔特魔法师的建议。";
			next;
			mes "[Mechanic Engineer Dorance]";
			mes "能请你去向他们求助吗？";
			next;
			mes "[Mechanic Engineer Dorance]";
			mes "你离开期间，我会留在这里整理这些文件。";
			close;
		}
		else if (ep13_2_rhea == 11) {
			mes "[Mechanic Engineer Dorance]";
			mes "进展如何？";
			next;
			select("Give him the Gem.");
			mes "[Mechanic Engineer Dorance]";
			mes "啊，看来你成功了。";
			mes "把数据输入带有魔力的宝石……这是科技无法做到的事情。虽然有点不甘心，但确实很了不起。";
			next;
			mes "[Mechanic Engineer Dorance]";
			mes "那么，我该开始制作读取宝石中魔法数据的机器，这样我们就能立即使用了。";
			next;
			mes "[Mechanic Engineer Dorance]";
			mes "嗯……";
			mes "幸运的是，事情不会像我们想的那么难。";
			next;
			mes "[Mechanic Engineer Dorance]";
			mes "如果把魔力波转换为电信号并连接到人体，再直接把数据传入大脑，就能不用加载过程直接接收并理解数据。";
			next;
			mes "[Mechanic Engineer Dorance]";
			mes "没时间解释全部了。我必须马上开始工作。";
			mes "准备工作完成后，大约一小时就能完成。";
			completequest 8252;
			setquest 8253;
			set ep13_2_rhea,12;
			close;
		}
		else if (ep13_2_rhea == 12) {
			set .@trs_time01,checkquest(8253,PLAYTIME);
			if (.@trs_time01 == 2) {
				mes "[Mechanic Engineer Dorance]";
				mes "唉，我现在该怎么办？！";
				next;
				mes "- 多兰斯在这里走来走去。-";
				mes "- in a dither. -";
				next;
				mes "["+ strcharinfo(0) +"]";
				mes "出什么问题了吗？！";
				next;
				mes "[Mechanic Engineer Dorance]";
				mes "我该怎么办？！我难道不是天才吗？！";
				next;
				mes "[Mechanic Engineer Dorance]";
				mes "我成功了！！！";
				next;
				mes "[Mechanic Engineer Dorance]";
				mes "方便携带的尺寸！";
				mes "时尚又实用的设计！";
				mes "收录异世界的单词、成语、语法和短语！！";
				next;
				mes "[Mechanic Engineer Dorance]";
				mes "你体验过它的加载速度吗？";
				mes "没体验过就别提了。";
				next;
				mes "[Mechanic Engineer Dorance]";
				mes "还不止这些！";
				mes "为了健康生活，它还能提升你的力量和智力!!!!";
				next;
				mes "[Mechanic Engineer Dorance]";
				mes "拥有如此多神奇功能，只要 39,900 Zeny……！！！";
				next;
				mes "["+ strcharinfo(0) +"]";
				mes "……你到底想模仿什么……";
				next;
				mes "[Mechanic Engineer Dorance]";
				mes "重要的是，我做出来了！！";
				next;
				mes "[Mechanic Engineer Dorance]";
				mes "眼见为实。";
				mes "你看看吧。";
				next;
				mes "- 他交出了小戒指。-";
				next;
				mes "[Mechanic Engineer Dorance]";
				mes "它叫“贤王之戒”。我参考古代国王用来与动物交流的戒指设计了它。";
				next;
				mes "[Mechanic Engineer Dorance]";
				mes "别把它当作普通戒指。看到这颗小宝石了吗？容纳宝石的插槽和戒指部分经过精密制作，能把魔力波转换成电信号，直接传入大脑。";
				next;
				mes "[Mechanic Engineer Dorance]";
				mes "这种电信号与人体神经系统使用的信号相同，因此我们就能流畅理解和使用语言。";
				next;
				mes "[Mechanic Engineer Dorance]";
				mes "翻译器普及后，我们进入异世界只是时间问题。问题是……目前数量还不够……";
				next;
				mes "[Mechanic Engineer Dorance]";
				mes "嗯……";
				mes "总之，现在思路清楚了，我把第一件成品交给你。";
				next;
				mes "[Mechanic Engineer Dorance]";
				mes "谢谢你的帮助。";
				mes "希望这枚戒指能为你的异世界旅程提供很大帮助。";
				completequest 8253;
				set ep13_2_rhea,100;
				if (checkre(3))
					getexp 200000,5000;
				else
					getexp 1000000,300000;
				getitem 2782,1; //Ring_Of_Wise_King
				close;
			}
			else {
				mes "- 他把机械零件散落在房间各处，-";
				mes "- 完全沉浸在自己的工作中，-";
				mes "- 无暇顾及其他。-";
				next;
				mes "- 如果打扰他，我可能会被咬。-";
				mes "- 我们别打扰他。-";
				close;
			}
		}
		else {
			mes "[Mechanic Engineer Dorance]";
		mes "谢谢你的帮助。";
			next;
			mes "[Mechanic Engineer Dorance]";
		mes "希望这枚戒指能为你的异世界旅程提供很大帮助。";
			close;
		}
	}
	else {
		mes "[Mechanic Engineer Dorance]";
		mes "你知道古代贤王之戒吗？戴上那枚戒指，你就能和动物交谈。";
		next;
		mes "[Mechanic Engineer Dorance]";
		mes "我不知道那是否是真实传说……但那种东西肯定很方便。";
		next;
		mes "[Mechanic Engineer Dorance]";
		mes "对了，你是谁？这栋建筑由指挥官管理，不能随意进入……你认识我们的指挥官吗？";
		next;
		mes "[Mechanic Engineer Dorance]";
		mes "你是在找事情做吗？也许我需要一些帮助……不过我还不知道你是否值得信任。";
		next;
		mes "[Mechanic Engineer Dorance]";
		mes "如果你能解决远征队营地的问题，并完成指挥官交给的任务……我想我就能信任你。";
		close;
	}
}

mid_campin,168,82,3	script	Arunafeltz Linguist#1	935,{
	if (ep13_2_rhea < 1) {
		mes "[Linguist Dictionary]";
		mes "语言将人类与动物区分开来。每一种有智慧的生命都有自己的语言。";
		next;
		mes "[Linguist Dictionary]";
		mes "语言是通过声音或文字传达感情和思想的方法与系统。总之，它的目的在于交流。";
		next;
		mes "[Linguist Dictionary]";
		mes "语言与声音的区别在于，语言是社会约定的承诺，通过共同的交流系统让彼此能够理解。";
		next;
		mes "[Linguist Dictionary]";
		mes "如果我们掌握这种社会约定的系统和结构，就能理解其他智慧生命的语言……";
		mes "...................................你又是谁？";
		next;
		mes "[Linguist Dictionary]";
		mes "这里是由指挥官管理的禁区。未经许可任何人都不能进入……你认识我们的指挥官吗？";
		close;
	}
	else if (ep13_2_rhea == 1) {
		mes "[Linguist Dictionary]";
		mes "与动物相比，语言是人类的显著特征。每一种有智慧的生命都有自己的语言。";
		next;
		mes "[Linguist Dictionary]";
		mes "语言是通过声音或文字传达感情和思想的方法与系统。总之，它的目的在于交流。";
		next;
		mes "[Linguist Dictionary]";
		mes "语言与声音的区别在于，语言是社会约定的承诺，通过共同的交流系统让彼此能够理解。";
		next;
		mes "[Linguist Dictionary]";
		mes "如果我们掌握这种社会约定的系统和结构，就能理解其他智慧生命的语言……";
		mes "…………………………你到底是谁？";
		next;
		switch(select("I am Me!:I don't have a name to tell you!")) {
		case 1:
			break;
		case 2:
			mes "[Linguist Dictionary]";
			mes "搞什么？";
			mes "这么无聊的话，为什么不去钓鱼？";
			close;
		}
		mes "[Linguist Dictionary]";
		mes "啊~我听指挥官提起过你。你为米德加尔特联盟营地做了很多事。总之，你来这里做什么？";
		next;
		switch(select("I thought I had confused you a bit...:What were you doing?")) {
		case 1:
			mes "[Linguist Dictionary]";
			mes "困惑是无法预料的事情发生时，思绪受到干扰而产生的感觉。我不是容易困惑的人。";
			next;
			break;
		case 2:
			break;
		}
		mes "[Linguist Dictionary]";
		mes "我是来自阿鲁纳佩兹的语言学家，研究世界上各种语言的系统与结构。";
		mes "而且……像我这样的人会在这里，难道不是有明确原因吗？";
		next;
		mes "[Linguist Dictionary]";
		mes "听说你为米德加尔特联盟研究组做了很多事。";
		mes "在帮助我们的过程中，你应该也见过并访问过异世界的许多地方。";
		next;
		mes "[Linguist Dictionary]";
		mes "你有没有遇到过异世界的人？";
		next;
		set .@check_splque00,checkquest(2158);
		set .@check_manque00,checkquest(2159);
		if ((.@check_splque00 == 0) && (.@check_manque00 == 0)) {
			// custom translation
			mes "[Linguist Dictionary]";
			mes "看来你还没有遇到他们。";
			next;
			mes "[Linguist Dictionary]";
			mes "这里有传闻说，营地旁的田野里住着外表像妖精的人，以及巨大的木头人。";
			next;
			mes "[Linguist Dictionary]";
			mes "据说他们使用人类无法理解的奇怪语言……但似乎没人能记住那种语言听起来是什么样。";
			next;
			mes "[Linguist Dictionary]";
			mes "一种全新的语言！！对我这样的语言学家来说，这是令人兴奋的发现，但外面有危险的魔物……普通学者不可能独自出去闲逛。";
			next;
			mes "[Linguist Dictionary]";
			mes "我说到这里，我想你应该能猜到我要请你做什么了。";
			next;
			mes "[Linguist Dictionary]";
			mes "联盟研究组对其他智慧生命非常感兴趣。各国特工都在努力与那两个种族交流，只是目前信息还不够。";
			next;
			mes "[Linguist Dictionary]";
			mes "帮我个忙，去营地外找到妖精和木头巨人，逐字记下他们说的一切，让我听听他们的语言是什么样。";
			completequest 8243;
			setquest 8244;
			set ep13_2_rhea,2;
			close;
		}
		else {
			mes "[Linguist Dictionary]";
			mes "看你的表情，我猜你心里有些疑问。";
			next;
			mes "[Linguist Dictionary]";
			mes "这里有传闻说，营地旁的田野里住着外表像妖精的人，以及巨大的木头人。";
			next;
			mes "[Linguist Dictionary]";
			mes "据说他们使用人类无法理解的奇怪语言……但似乎没人能记住那种语言听起来是什么样。";
			next;
			mes "[Linguist Dictionary]";
			mes "一种全新的语言！！对我这样的语言学家来说，这是令人兴奋的发现，但外面有危险的魔物……普通学者不可能独自出去闲逛。";
			next;
			mes "[Linguist Dictionary]";
			mes "我说到这里，我想你应该能猜到我要请你做什么了。";
			next;
			mes "[Linguist Dictionary]";
			mes "联盟研究组对其他智慧生命非常感兴趣。各国特工都在努力与那两个种族交流，只是目前信息还不够。";
			next;
			mes "[Linguist Dictionary]";
			mes "帮我个忙，去营地外找到妖精和木头巨人，逐字记下他们说的一切，让我听听他们的语言是什么样。";
			completequest 8243;
			setquest 8244;
			set ep13_2_rhea,2;
			close;
		}
	}
	else if (ep13_2_rhea == 2) {
		set .@check_splque00,checkquest(2158);
		set .@check_manque00,checkquest(2159);
		if ((.@check_splque00 > 0) && (.@check_manque00 > 0)) {
			mes "[Linguist Dictionary]";
			mes "你回来了！";
			next;
			mes "[Linguist Dictionary]";
			mes "那么，他们说了什么？";
			mes "你当然准确记得他们说的话，对吧？";
			next;
			mes "[Linguist Dictionary]";
			mes "现在从妖精开始！妖精的语言是什么样？请在这里逐句写下来！";
			next;
			set .@spl_score00,0;
			input .@input$;
			if (.@input$ == "RLGHLRXLA TKANTLFDMS") {
				mes "[Linguist Dictionary]";
				mes ""+ .@input$ +"....";
				mes "然后呢？";
				set .@spl_score01,.@spl_score00+1;
				next;
			}
			else {
				mes ""+ .@input$ +"....";
				mes "嗯……嗯？";
				set .@spl_score01,.@spl_score00;
				next;
			}
			input .@input$;
			if (.@input$ == "WJACK TNAHRDNJSDMFH") {
				mes ""+ .@input$ +"....";
				mes "然后呢？";
				set .@spl_score02,.@spl_score01+1;
				next;
			}
			else {
				mes ""+ .@input$ +"....";
				mes "原来如此……？";
				set .@spl_score02,.@spl_score01;
				next;
			}
			input .@input$;
			if ((.@input$ == "WLSGHKWND !!") || (.@input$ == "WLSGHKWND")) {
				mes ""+ .@input$ +"....";
				mes "就这些吗？";
				set .@spl_score03,.@spl_score02+1;
				next;
			}
			else {
				mes ""+ .@input$ +"....";
				mes "就这些吗？";
				set .@spl_score03,.@spl_score02;
				next;
			}
			if (.@spl_score03 > 2) {
				mes "[Linguist Dictionary]";
				mes "那么……把它们组合起来，";
				mes "RLGHLRXLA TKANTLFDMS";
				mes "WJACK TNAHRDNJSDMFH";
				mes "WLSGHKWND !!";
				mes "应该是这样。";
				next;
			}
			else {
				mes "[Linguist Dictionary]";
				mes "嗯……？";
				next;
				mes "[Linguist Dictionary]";
				mes "你确定他们确实是这么说的吗？";
				mes "我完全无法理解……";
				next;
				mes "[Linguist Dictionary]";
				mes "请再回去确认一下，看看他们是否真的这样说。";
				close;
			}
			mes "[Linguist Dictionary]";
			mes "很好。接下来是木头巨人！他们的语言是什么样？像记录妖精语言那样逐句写下来。";
			next;
			set .@man_score00,0;
			input .@input$;
			if (.@input$ == "TJDTMFJDNS CJFDI") {
				mes "[Linguist Dictionary]";
				mes ""+ .@input$ +"....";
				mes "然后呢？";

		if (select("我自己拿到的。：我带给你们的。") == 1) {
			mes "[谢尔比]";
			mes "你是人类，却吃罐头食品？你在做什么？";
			next;
			mes "[福特]";
			mes "谢尔比转开视线了！！福特不会错过这个机会！（砰砰）";
			next;
			mes "[谢尔比]";
			mes "哎哟～这只没用的猫！！";
			next;
			mes "^000099战斗仍在继续。如果没人阻止这场战斗，可能永远无法再和他谈话。^000000";
			close;
		}
		mes "[谢尔比]";
		mes "我真的可以收下这个吗？……";
		next;
		if (select("你不想要就算了。：当然可以～") == 1) {
			mes "[谢尔比]";
			mes "不，我只是开玩笑！为什么不要？";
			next;
		}
		mes "[谢尔比]";
		mes "好吧。你想要什么？是之前问过的次元裂缝碎片吗？";
		next;
		select("询问如何激活裂缝碎片。" );
		mes "[谢尔比]";
		mes "我明白了，这就是你想知道的。很难查到，因为连米德加尔特的科学家都试图对所有人隐瞒这项信息。不过和相关的安保措施相比，信息本身其实很简单。";
		next;
		mes "[谢尔比]";
		mes "首先，要激活次元裂缝碎片，需要^0000991个黑暗碎片^000000作为载体。由于碎片会与摩洛克的身体反应，所以需要至少与其相似的东西。";
		next;
		mes "[谢尔比]";
		mes "如果有黑暗水晶，就能施加更强的力量，但我没能得到那种组合方法。";
		next;
		mes "[谢尔比]";
		mes "如果列出全部材料，除了^0000991个黑暗碎片^000000，还需要^000099红/黄/蓝宝石各2个^000000。";
		next;
		select("为什么需要宝石？" );
		mes "[谢尔比]";
		mes "以黑暗碎片为载体与裂缝碎片反应时，周围会受到巨大的超自然力量影响。那时如果没有东西抵消副作用，会发生什么？";
		next;
		mes "[谢尔比]";
		mes "你可能以前见过。就像摩洛克发现的次元裂缝，周围区域会逐渐恶化。用于防止这种情况的牺牲材料就是宝石。";
		next;
		mes "[谢尔比]";
		mes "现在，我解释得够清楚了吗？不过你为什么要激活裂缝碎片这种危险物品？你想举行从地狱召唤什么东西的仪式吗？";
		next;
		select("先把罐头食品交给他。" );
		if (countitem(12636) < 10) {
			mes "[谢尔比]";
			mes "嗯？你刚才拿着的罐头食品怎么了？为什么两手空空？";
			close;
		}
		mes "[谢尔比]";
		mes "哦！谢谢！这是我第一次从人类那里领取工资。我以豹神之名祝福你的未来。";
		delitem 12636,10;// Malang_Sp_Can
		changequest 12285,12286;
		ep14_2_etran = 16;
		getexp 120000,80000;
		next;
		mes "^000099谢尔比用胖乎乎的前爪拍了拍你的背，为你送上祝福。你获得了经验值和职业经验值。^000000";
		close;
	}
	mes "[谢尔比]";
	if (ep14_2_etran < 13) {
		mes "嗯。";
		mes "如果你想要猫商人的服务，应该去找代理，而不是我。";
	}
	else if (ep14_2_etran == 13) {
		mes "嗯。";
		mes "如果你想要猫商人的服务，应该去找代理，而不是我。";
		next;
		select("真是有趣的猫。" );
		mes "[谢尔比]";
		mes "为什么？见过那些彬彬有礼又过分热情的猫后，看到我很奇怪吗？";
		next;
		mes "[谢尔比]";
		mes "喵～你好吗喵～我真的很喜欢罐头鱼喵～！！……这就是你想要的吗？";
		next;
		mes "[谢尔比]";
		mes "我们是猫，并不代表我们都一样。我现在也很沮丧，所以你最好去找其他猫帮忙。";
		next;
		select("询问次元裂缝碎片" );
		mes "[谢尔比]";
		mes "哈哈，真不敢相信你会问一只猫这个。我们的科学没多少人关注。我们最感兴趣的是商业和渔业。";
		next;
		mes "[谢尔比]";
		mes "给你一个建议。别在我身上浪费时间，去找其他人帮忙吧。";
		ep14_2_etran = 14;
	}
	else if (ep14_2_etran == 14)
		mes "这里有个建议。别在我身上浪费时间，去找其他人帮忙吧。";
	else if (ep14_2_etran < 20)
		mes "在你忘记前提醒一下，激活裂缝碎片需要的材料是^0000991个黑暗碎片，以及红/黄/蓝宝石各2个^000000。";
	else if (ep14_2_etran > 42)
		mes "嘿～之前的实验进行得顺利吗？";
	else
		mes "嗯？怎么了？";
	close;
}

mid_camp,179,258,4	script	Ford#pa0829	4_CAT_SAILOR1,{
	disable_items;
	if (checkweight(1201,1) == 0) {
		mes "携带的物品种类似乎太多。减少物品种类后再试吧。";
		close;
	}
	if ((MaxWeight - Weight) < 10000) {
		mes "携带的物品似乎太重。减轻负重后再试吧。";
		close;
	}
	if (ep14_2_etran == 15) {
		mes "^000099他正忙着和谢尔比战斗。如果没人阻止这场战斗，可能永远无法再和他交谈。^000000";
		close;
	}
	mes "[福特]";
	if (ep14_2_etran < 14)
		mes "^000099嫩味牌罐头食品^000000没有作为工资发下来。福特很伤心。那边的^000099谢尔比^000000似乎也很沮丧～";
	else if (ep14_2_etran == 14) {
		mes "^000099嫩味牌罐头食品^000000没有作为工资发下来。福特很伤心。那边的^000099谢尔比^000000似乎也很沮丧～。";
		next;
		mes "[谢尔比]";
		mes "闭嘴，福特！！";
		next;
		select("询问次元裂缝。" );
		mes "[福特]";
		mes "喵？";
		mes "福特不知道那么难的东西。福特很了解沙丁鱼！也了解鲭鱼！^000099次元……那种东西谢尔比更清楚！^000000不过谢尔比因为情绪低落不工作。我也不工作！！";
		next;
		mes "[谢尔比]";
		mes "闭嘴，福特！！";
		next;
		mes "^000099你听到两只猫打架的声音。^000000";
		changequest 12284,12285;
		ep14_2_etran = 15;
	}
	else if (ep14_2_etran > 15) {
		mes "你给了我们工资！你真好！谢尔比也喜欢你！我们不用再挨饿了！";
		next;
		mes "[谢尔比]";
		mes "...";
		next;
		mes "^000099谢尔比没有对福特大喊，看来他现在心情真的很好。^000000";
	}
	close;
}

ecl_in02,133,115,7	script	Prison Guard#pa0829	4_M_FAIRYSOLDIER2,{
	if (checkweight(1201,1) == 0) {
		mes "携带的物品种类似乎太多。减少物品种类后再试吧。";
		close;
	}
	if ((MaxWeight - Weight) < 10000) {
		mes "携带的物品似乎太重。减轻负重后再试吧。";
		close;
	}
	disable_items;
	mes "[监狱守卫]";
	if (ep14_2_etran < 2)
		mes "我以前没见过你……你是访客吗？";
	else if (ep14_2_etran == 2) {
		mes "我明白了，但我不记得访客名单上有你。你要探望谁？";
		next;
		input .@inputstr$;
		mes "[监狱守卫]";
		if (.@inputstr$ == "Clever") {
			mes "^000099"+ .@inputstr$ +"^000000？……也就是说……";
			next;
			mes "[聪明]";
			mes "嗯？有人来看我？呀呼！有人探视！好耶～";
			next;
			mes "[监狱守卫]";
			mes "啊……";
			next;
			mes "^000099守卫的表情变得阴沉。光是提到聪明这个名字，他看起来就很痛苦……^000000";
			next;
			mes "[监狱守卫]";
			mes "至少名单上是这样……看起来没有安排探视聪明……";
			next;
			mes "[聪明]";
			mes "嘿～守卫～你在做什么？快打开牢房好吗！这是探视，哈哈哈！如果你妨碍我的探视，我就每次你工作时都唱歌！是不是很期待？";
			next;
			mes "[聪明]";
			mes "话说回来，我现在开始唱歌怎么样？";
			next;
			mes "^000099守卫的脸色更加阴沉。他的表情暴露出对当前状况的极度恼火。^000000";
			next;
			mes "[监狱守卫]";
			mes "你不在名单上，不过哈哈，我想这是行政错误。请进去吧。至于探视时间，嗯……";
			next;
			mes "[监狱守卫]";
			mes "你想待多久都可以。不用担心，慢慢来。";
			ep14_2_etran = 3;
			close;
		}
		else
		mes "嗯？你想探望^000099"+ .@inputstr$ +"^000000？我在名单上没看到这项探视。你确定正式申请过吗？";
	}
	else if (ep14_2_etran >= 4 && ep14_2_etran < 5)
		mes "求你了，请让聪明先生闭嘴。我听他唱了一年，快要疯了。而且我也不能打犯人……";
	else if (ep14_2_etran == 8) {
		mes "这全都多亏了你！聪明先生正在睡觉，这意味着他几天都不会醒。";
		next;
		mes "[监狱守卫]";
		mes "我都不记得上次享受这么安宁是什么时候了。我祈祷你的家树得到祝福。";
		next;
		ep14_2_etran = 9;
		getexp 100000,60000;
		mes "^000099多亏聪明的睡眠和守卫的喜悦，你获得了经验值和职业经验值。^000000";
		close;
	}
	else
		mes "你还需要别的吗？";
	next;
	if (select("看看里面。：带我离开这里。") == 2) {
		warp "ecl_in02",98,29;
		end;
	}
	close;
}

ecl_in01,82,80,4	script	Monthly Eclage#pa0829	HIDDEN_NPC,{
	if (checkweight(1201,1) == 0)
		mes "携带的物品种类似乎太多。减少物品种类后再试吧。";
	else if ((MaxWeight - Weight) < 10000)
		mes "携带的物品似乎太重。减轻负重后再试吧。";
	else if (ep14_2_etran < 23)
		mes "^000099I see a plain-looking journal. It seems to deal with third-rate gossip stories.^000000";
	else if (ep14_2_etran > 22) {
		// disable_items;
		mes "^990000---Eclage Monthly---^000000";
		mes "^999900(Shocking! Birth of Eclage Special)^000000";
		mes "^000099这一定就是克莱弗提到的那本。夸张的文章已经褪色。^000000";
		next;
		mes "^000099这不是历史文献，只是三流杂志。看看目录吧。^000000";
		next;
		switch( select("合上书：绝望的定居-------第7页：长老议会的残酷-------第48页：永别--------第132页：（褪色区域）") ) {
		case 1:
			mes "^000099似乎没什么趣味。^000000";
			close;
		case 2:
			mes "^000099第一章：绝望之地^000000";
			mes "尤格拉德西尔出问题了吗？死亡的气味开始充满这片和平的土地。";
			next;
			mes "花园被污染、土地干涸、各种变异生命体发动攻击。拉斐尔族的居住地发生了巨大变化。";
			next;
			mes "^000099（我翻过几页褪色的书页。）^000000";
			next;
			mes "拉斐尔族的领袖曾坚信这里是尤格拉德西尔守护者的最佳居所。但长老议会施压，要求在这片荒地建立居所，如今很难管理拉斐尔族居民。";
			next;
			mes "诅咒般的时代过去了，许多家人和朋友遭受多种疾病以及原生生命体的攻击。";
			next;
			mes "^000099（剩余部分褪色严重，很难辨认。）^000000";
			close;
		case 3:
			mes "^000099Chapter 2. Elder Assembly's Scheme^000000";
			mes "长老议会不断把持续的失败归咎于拉斐尔族领袖。";
			next;
			mes "听说土地选址错误后，他们私下决定把首都迁到南方那片森林繁茂的区域。";
			next;
			mes "^000099（我翻过一页撕破的书页。）^000000";
			next;
			mes "派往南方的侦察兵发现了惊人的真相。南方森林远谈不上安全，派出的侦察兵有90%被未知怪物消灭。";
			next;
			mes "然而长老议会坚持认为那里是我们的命运所在，继续派出侦察队。这是荒谬的决定。";
			next;
			mes "领袖们需要采取激烈行动，反对长老议会荒谬的要求。那些长老太过年迈又野心勃勃，无法进行实际思考。";
			next;
			mes "这时，两位多纳——^000099埃特兰和罗伯特^000000——向领袖提出大规模复原计划。他们是拉斐尔族中复原能力和权威最高的人。";
			next;
			mes "领袖们开始听取自然复原专家的策略，这些专家一生都在践行复原原则。";
			next;
			mes "两位多纳的建议非常明确：^000099建造一棵巨大的家树，直接与尤格拉德西尔交流，一次性复原土地。^000000";
			next;
			mes "如预料的一样，长老议会完全否定了他们的建议。^000099为了建造家树，必须抽取土地的生命力。^000000";
			next;
			mes "因此，^000099建造家树复原土地反而可能成为障碍。^000000长老议会认为这个过程不可能实现。";
			next;
			mes "他们还不断宣称，为了让所有人活下去，迁往南方比复原荒地更好。这从一开始就是他们的计策。";
			next;
			mes "^000099（后面的书页被撕掉了。）^000000";
			if (ep14_2_etran == 23)
				ep14_2_etran = 24;
			close;
		case 4:
			mes "^000099（这里有许多墨渍，似乎是故意遮住了文字。）^000000";
			close;
		case 5:
			mes "^000099（这里有许多墨渍，似乎是故意遮住了文字。）^000000";
			if (ep14_2_etran > 23) {
				next;
				select("这里有一页折叠的纸。" );
				mes "^000099小心展开后，或许能看到其中的页面。^000000";
				next;
				select("小心地展开纸页。" );
				mes "^000099这是拉菲内读者写下的评论页。也许他们没有署名，但评论写得相当尖锐。^000000";
				next;
				mes "^990000RE：^000000谁把这里弄坏了？这可是仅剩的一份了！！我喜欢这个故事。";
				mes "----------";
				mes "^990000RE-RE：^000000我自己还做了一份副本。你想要的话告诉我。";
				next;
				mes "^990000RE：^000000各位，你们知道吗？长老议会最初完全反对建造家园树，但历史书上却说这个想法是他们提出的。奇怪吧？到底谁说得对？";
				next;
				mes "^990000RE：^000000如果你是翼展超过180厘米的拉菲内，我会考虑和你交往。";
				mes "----------";
				mes "<- 阿奈斯喜欢这个。";
				mes "----------";
				mes "^990000RE-RE：^000000你是怎么想到的？";
				next;
				mes "^990000RE：^000000我听父亲说过，为了反对长老议会的决定，^000099埃特兰和罗伯特故意在长老面前争吵。^000000是真的吗？";
				next;
				mes "^990000RE-RE：^000000我也听说过。^000099为了让一切看起来真实，他们从会议前几天开始逐渐争吵。^000000这是历史学家最有争议的话题。";
				next;
				mes "^990000RE：^000000居然还有更多傻瓜相信这种东西。孩子们，《伊克拉斯月刊》是三流八卦杂志，别把它和历史混为一谈。";
				mes "----------";
				mes "^990000RE-RE：^000000原来如此。非常感谢你的高见。我想在三流杂志上留下那种评论，确实显得你聪明极了。";
				next;
				mes "^990000RE：^000000我要刊登朱恩市长穿内衣的高曝光照片。谁先来认领就给谁！";
				mes "----------";
				mes "^990000RE-RE：^000000我来拿照片。我会把你安排进编辑部。";
				if (ep14_2_etran == 24) {
					next;
					changequest 12291,12292;
					ep14_2_etran = 25;
					mes "^000099（你收集到了关于两位多纳、埃特兰和罗伯特的信息。记下来并向克莱弗询问。）^000000";
				}
			}
			close;
		}
	}
	else
		mes "^000099这本书一定损坏了。我实在打不开它。^000000";
	close;
}

ecl_tdun01,60,56,4	script	#pa0829EtranInterio	HIDDEN_NPC,{
	if (checkweight(1201,1) == 0)
		mes "携带的物品种类似乎太多。减少物品种类后再试吧。";
	else if ((MaxWeight - Weight) < 10000)
		mes "携带的物品似乎太重。减轻负重后再试吧。";
	else if (ep14_2_etran == 33) {
		cutin "EP14_etran01",1;
		mes "[？？？？]";
		mes "嗯？这是什么？我是在做梦吗？感觉有些不同。";
		next;
		select("你能听到我吗？你是埃特兰先生吗？");
		cutin "EP14_etran3",1;
		mes "[埃特兰]";
		mes "你知道我的名字？你是谁？";
		next;
		select("说明情况。" );
		cutin "EP14_etran5",1;
		mes "[埃特兰]";
		mes "嗯？";
		mes "你要我相信那个故事？你来自数千年后的未来？未来已经有那种科学了吗？";
		next;
		select("向他说明裂缝反应堆。" );
		cutin "",255;
		mes "["+ strcharinfo(0) +"]";
		mes "埃特兰先生，我们并不是来自未来，而是暂时打开了过去与未来之间的墙。我有很多问题想问。";
		next;
		cutin "EP14_etran4",1;
		mes "^000099埃特兰出乎意料地和克莱弗很像。难道克莱弗和希尔是埃特兰与罗伯特的转世？不，不可能……^000000";
		while(1) {
			next;
			switch( select("询问长老议会。：询问与罗伯特的争斗。：询问土地复原计划。") ) {
				mes "[埃特兰]";
			case 1:
				cutin "EP14_etran8",1;
				mes "嗯，长老议会真是腐朽的组织。他们像化石一样，仍活在拉斐尔族刚诞生的时代。";
				next;
				mes "[埃特兰]";

comodo,171,137,1	script	Haith#um	92,{
	mes "[拉·艾德]";
	mes "那个地方一定藏着宝藏！";
	next;
	mes "[海丝]";
	mes "如果我们找到它，大家就不会再觉得我们是失败者了～！！";
	next;
	mes "[拉·艾德]";
	mes "终于！";
	next;
	mes "[海丝]";
	mes "我们去找那件宝藏吧！";
	next;
	mes "[拉·艾德]";
	mes "说走就走～！！";
	emotion ET_KIK;
	next;
	mes "[海丝]";
	mes "................";
	next;
	mes "[拉·艾德]";
	mes "话说回来……你觉得他会这么轻易地";
	mes "把这么伟大的宝藏";
	mes "告诉我们吗？";
	emotion ET_SCRATCH;
	emotion ET_SCRATCH, getnpcid(0, "La Ed#um");
	next;
	select("嗯？什么宝藏？");
	mes "[拉·艾德]";
	mes "什——？！你什么时候开始偷听我们的？！";
	next;
	mes "[海丝]";
	mes "咦……看来你想知道";
	mes "更多宝藏的消息。好吧，";
	mes "这消息可不便宜……";
	emotion ET_KIK;
	next;
	mes "[拉·艾德]";
		mes "而且，我们还需要一点";
		mes "一笔小小的费用，";
		mes "以防";
	mes "*咳！* ^555555我们什么也没找到。^000000";
	next;
	mes "[拉·艾德、海丝]";
	mes "只要付给我们 1,000 Zeny，我们就告诉你！";
	emotion ET_KIK;
	emotion ET_KIK, getnpcid(0, "La Ed#um");
	next;
	if (select("支付 1,000 Zeny:拒绝支付") == 1) {
		if (Zeny > 999) {
			set Zeny, Zeny-1000;
			mes "[海丝]";
			mes "哈哈哈哈！你真爽快！";
			next;
			mes "[拉·艾德]";
			mes "好吧，就在不久前，一位名叫尼尔斯的";
			mes "著名冒险家旅行归来了。";
			next;
			mes "[海丝]";
			mes "*小声说*";
			mes "^555555他带回了一个大箱子。^000000";
			next;
			mes "[拉·艾德]";
			mes "而且，他半夜回来";
			mes "没有告诉任何人。";
			mes "所以他肯定藏着什么秘密，对吧？";
			mes "你不觉得吗？";
			next;
			mes "[海丝]";
			mes "那个箱子里会是什么呢～？";
			mes "里面肯定是宝藏！！";
			next;
			mes "[拉·艾德]";
			mes "所以！我们决定踏上旅程，寻找属于自己的宝藏！！";
			next;
			mes "[海丝]";
			mes "问题是，我们不确定";
			mes "尼尔斯会不会告诉我们";
			mes "他发现宝藏的地点……";
			emotion ET_SCRATCH;
			next;
			mes "[拉·艾德]";
			mes "因为尼尔斯总把我们当成";
			mes "笨蛋！！呸～！！";
			next;
			select("那个叫尼尔斯的人在哪里？");
			mes "[拉·艾德]";
			mes "他住在这个村子的";
			mes "北部。";
			next;
			mes "[海丝]";
			mes "既然我们给了你有用的消息，";
			mes "当然希望你回报我们！";
			next;
			mes "[拉·艾德、海丝]";
			mes "祝你好运！";
			close;
		}
		mes "[拉·艾德]";
		mes "算了～！既然你没钱，我们就不能告诉你消息～";
		close;
	}
	mes "[海丝]";
	mes "呸！随便啦～";
	mes "那就这样吧。";
	emotion ET_SCRATCH;
	emotion ET_SCRATCH, getnpcid(0, "La Ed#um");
	close;
}

cmd_in01,175,120,3	script	Iriya#um	69,{
	mes "[伊莉雅]";
	mes "尼尔斯先生在角落的桌边。";
	mes "他有许多关于世界的";
	mes "有趣故事。";
	mes "值得一听。";
	next;
	mes "[伊莉雅]";
	mes "我不知道他这次去了哪里。";
	mes "他只是笑着说：‘我觉得自己不适合";
	mes "出现在这里。";
	mes "做这份教书的工作。’";
	next;
	mes "[伊莉雅]";
	mes "与此同时，人们不断来拜访尼尔斯先生……";
	mes "我也忍不住想……";
	mes "他究竟去了哪里？";
	close;
}

cmd_in01,164,115,1	script	Niels#um	731,{
	mes "[尼尔斯]";
	mes "嗯？你那是什么表情？";
	mes "啊～你一定听说了";
	mes "我找到某种宝藏的传闻。";
	mes "是啊，这很正常……";
	next;
	mes "[尼尔斯]";
	mes "我偶然发现奇妙宝藏的传闻，";
	mes "不过是大家想象力";
	mes "过于丰富的结果。";
	mes "我找到的只是收藏品中的";
	mes "一件小东西。";
	next;
	mes "[尼尔斯]";
	mes "但是……既然我亲眼看到";
	mes "‘它’确实存在，";
	mes "对我来说，我得到的就是";
	mes "珍贵的宝藏。";
	next;
	mes "[尼尔斯]";
	mes "就是科莫多这个村子！";
	mes "你不觉得";
	mes "这里的洞窟";
	mes "不知为何又小又窄吗？";
	next;
	mes "[尼尔斯]";
	mes "所以我思考了一番……";
	mes "反复思考之后，";
	mes "最后得出结论：";
	mes "洞窟里应该";
	mes "藏着什么……";
	next;
	mes "[尼尔斯]";
	mes "然后！";
	mes "我终于";
	mes "找到了。";
	mes "通往‘那个地方’的入口，";
	mes "一个从未有人";
	mes "发现的地方！";
	next;
	mes "[尼尔斯]";
	mes "................";
	next;
	mes "[尼尔斯]";
	mes "……嗯？";
	next;
	mes "[尼尔斯]";
	mes "我还期待声明时能有";
	mes "壮观而戏剧性的音效呢！";
	mes "呃，算了……";
	emotion ET_SCRATCH;
	next;
	mes "[尼尔斯]";
	mes "本着探索的精神，";
	mes "我提醒你，";
	mes "别想问我‘那个地方’的路线，";
	mes "也别问‘那个地方’里有什么。";
	mes "我可不想破坏";
	mes "这份惊喜。";
	next;
	mes "[尼尔斯]";
	mes "如果你是真正的冒险家，";
	mes "我希望你能放声大喊";
	mes "出来……";
	next;
	mes "[尼尔斯]";
	mes "‘啊啊啊！我一定要知道那是什么！！’";
	mes "然后踢开门，拼命寻找";
	mes "那个地方！！";
	next;
	mes "[尼尔斯]";
	mes "现在！快去找那个地方！";
	mes "那里会是全新的世界，";
	mes "还是通往地狱的陷阱？！";
	mes "出发吧，去迎接你的命运，";
	mes "冒险家！";
	close;
}

umbala,70,106,3	script	Utan Kid#um	781,{
	if (event_umbala >= 3) {
		mes "[???]";
		mes "咦？";
		mes "你不是我们的人，对吧？";
		next;
		mes "[???]";
		mes "嘿！你好！";
		mes "我叫哈坦。";
		emotion ET_SMILE;
		next;
		mes "[哈坦]";
		mes "...*Sigh*";
		mes "很抱歉，但我现在不能和你玩。";
		mes "我现在没法陪你。";
		mes "我父母的房子昨天被雷击中，";
		mes "屋顶都被烧毁了……";
		emotion ET_CRY;
		next;
		mes "[哈坦]";
		mes " . . . !";
		next;
		mes "[哈坦]";
		mes "对了！你能帮帮我吗？";
		mes "你看起来挺富裕……";
		mes "能捐点钱帮我";
		mes "重建父母的房子吗？";
		mes "你们卢恩·米德加尔特人都";
		mes "比乌坦人有钱！求求你！";
		emotion ET_SMILE;
		next;
		if (select("（点头）：（摇头）") == 1) {
			mes "[哈坦]";
			mes "哇啊啊！！";
			mes "你真是个好人～！";
			mes "太感谢你了，耶～！";
			if (Zeny > 1000) {
				set Zeny, Zeny-1000;
				if (checkweight(517,1)) {
					getitem 517,1;// Meat
				}
				emotion ET_PROFUSELY_SWEAT;
			}
			else {
				next;
				mes "[哈坦]";
				mes "呃……";
				mes "看起来……";
				mes "你自己也没多少钱……";
				emotion ET_HNG;
				close;
			}
			next;
			mes "[哈坦]";
			mes "太感谢你了！";
			emotion ET_SMILE;
			close;
		}
		mes "[哈坦]";
		mes "………………*抽泣*……";
		emotion ET_CRY;
		close;
	}
	else {
		mes "[???]";
		mes "Umbah?";
		mes "Umbala umbabah umbah?";
		next;
		mes "[???]";
		mes "Umbah! Umbaumbah!";
		mes "Umbahumbah Haatan babah.";
		emotion ET_CRY;
		next;
		mes "[哈坦]";
		mes "........umbah,";
		mes "Umbah umbah umbaumbumbah umbah umbah";
		mes "Babaum babahum woombah umbah umbabah";
		mes "Umbah umbah";
		mes "..Umbah umbabah umbah...";
		emotion ET_SMILE;
		next;
		mes "[哈坦]";
		mes " . . . !";
		next;
		mes "[哈坦]";
		mes "Umbah!";
		mes "Umbah umbah? Umbah umbahbah";
		mes "abaum babahum woombah!";
		mes "Umbahumbah umbabahumbaumhumbah! Umbah!";
		emotion ET_SMILE;
		next;
		if (select("(Nod head):(Shake head)") == 1) {
			mes "[哈坦]";
			mes "Umbaumbah!!";
			mes "Um~bahumbah~ Um~baumbah~";
			mes "Um~baumbah~ um~baumbah~";
			if (Zeny > 1000) {
				set Zeny, Zeny-1000;
				if (checkweight(517,1)) {
					getitem 517,1;// Meat
				}
				emotion ET_PROFUSELY_SWEAT;
			}
			else {
				next;
				mes "[哈坦]";
				mes "...umbah? Umbahumbah!! Umbaum!";
				emotion ET_HNG;
				close;
			}
			next;
			mes "[哈坦]";
			mes "Umba umba umbaum.";
			emotion ET_CRY;
			close;
		}
		mes "[哈坦]";
		mes "........umbah..";
		mes "我现在真的很难过。";
		emotion ET_SMILE;
		close;
	}
	close;
}

umbala,59,243,5	script	Utan Kid#1	787,{
	if (event_umbala >= 3) {
		mes "[科坦]";
		mes "............";
		mes ".........poop!";
		mes ".....me like Meat.";
		mes "....gimme a Meat.";
		emotion ET_ROCK;
		next;
		if (select("给他肉:拒绝") == 1) {
			if (countitem(517) > 0) {
				mes "[科坦]";
				mes "哇，你真的要给我";
				mes "肉吗？谢谢！我会用这些";
				mes "回报你。";
				delitem 517,1;// Meat
				if ( checkre(0) ) {
					//Clover 50%, Fluff 25%, Jellopy 25%
					switch (rand(1,4)) {
						case 1: getitem 909,3; break; // Jellopy
						case 2: getitem 914,3; break; // Fluff
						case 3: getitem 705,3; break; // Clover
						case 4: getitem 705,3; break; // Clover
					}
				} else {
					getitem 909,2; // Jellopy
					getitem 914,2; // Fluff
					getitem 705,2; // Clover
				}
				emotion ET_SCISSOR;
				close;
			}
			mes "[科坦]";
			mes "哈！你没有肉，";
			mes "却假装有？！";
			mes "我讨厌对我";
			mes "撒谎的人！！";
			percentheal -20,0;
			emotion ET_FRET;
			close;
		}
		mes "[科坦]";
		mes ".........";
		mes ".....hungwee.";
	mes "……我想要肉。";
		percentheal -1,0;
		emotion ET_CRY;
		close;
	}
	else {
		mes "[???]";
		mes "............";
		mes "........umbah.";
		mes ".......umbabah.";
		mes "......humbah.";
		emotion ET_ROCK;
		next;
		if (select("Umbah:Umbaboo") == 1) {
			if (countitem(517) > 0) {
				mes "[???]";
				mes "Umbaumbaumbabababah.";
				mes "Umbababahum.";
				delitem 517,1;// Meat
				if ( checkre(0) ) {
					switch (rand(1,4)) {
						//Clover 50%, Fluff 25%, Jellopy 25%
						case 1: getitem 909,3; break; // Jellopy
						case 2: getitem 914,3; break; // Fluff
						case 3: getitem 705,3; break; // Clover
						case 4: getitem 705,3; break; // Clover
					}
				} else {
					getitem 909,2; // Jellopy
					getitem 914,2; // Fluff
					getitem 705,2; // Clover
				}
				emotion ET_SCISSOR;
				close;
			}
			mes "[???]";
			mes "Umbahumumhumbubabababah!!";
			mes "Umbahumbababah umbahumboo!";
			percentheal -20,0;
			emotion ET_FRET;
			close;
		}
		mes "[???]";
		mes "...........";
		mes "......woong bah.";
		mes "....umbabababah.";
		emotion ET_CRY;
		percentheal -1,0;
		close;
	}
}

umbala,177,153,3	script	Pasto#um	97,{
	mes "[帕斯托]";
	emotion ET_SURPRISE;
	mes "天哪～！终于又见到";
	mes "一个卢恩·米德加尔特人了！";
	mes "我以前从没在这里见过";
	mes "来自故乡的人！";
	mes "很高兴见到你，我叫帕斯托！";
	next;
	mes "[帕斯托]";
	mes "这里叫乌巴拉。";
	mes "这个村子的当地人";
	mes "形成了";
	mes "一种与我去过的其他地方";
	mes "完全不同的文化。";
	next;
	mes "[帕斯托]";
	mes "我想这是因为这里的";
	mes "地理特征，";
	mes "使它与其他地区";
	mes "隔绝了。";
	next;
	mes "[帕斯托]";
	mes "他们和我们长得不同，";
	mes "使用的语言也让我";
	mes "很困惑。";
	mes "他们对面部表情的不同用法";
	mes "也让我摸不着头脑。";
	next;
	mes "[帕斯托]";
	mes "当然，我们之间也有一些";
	mes "相似之处。不过，遇到";
	mes "某些事情";
	mes "你最好小心一点。";
	next;
	mes "[帕斯托]";
	mes "有时你说的话或做的事";
	mes "可能会被误解为";
	mes "完全相反的意思。";

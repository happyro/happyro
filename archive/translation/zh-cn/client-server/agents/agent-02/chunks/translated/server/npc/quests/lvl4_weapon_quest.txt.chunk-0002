		mes "令人赞叹、常被模仿的";
		mes "杰作，不是吗？";
		next;
		switch(select("是的，我想要。:抱歉，我不需要！")) {
		case 1:
			if (BaseLevel < 70) {
				mes "[Hibilaithan]";
				mes "哦……";
				mes "你的心智太弱，无法承受我作品的力量。抱歉，你需要更多训练。";
				next;
				mes "[Hibilaithan]";
				mes "我知道等待拥有我的作品一定很难受。但为了你自己，先变强再回来找我吧。";
				close;
			}
			mes "[Hibilaithan]";
			mes "哈哈哈哈！";
			mes "你当然想要！";
			mes "我只是反问而已！";
			mes "不过我喜欢你的态度。现在告诉你需要带什么，";
			mes "可别忘了。";
			next;
			mes "[Hibilaithan]";
			mes "首先，我需要";
			mes "10 个黄金、";
			mes "50 个钢铁和";
			mes "10 个铱金。";
			mes "这些是基础材料。";
			next;
			mes "[Hibilaithan]";
			mes "我还需要稀有矿石赋予作品力量。白云母、黑云母或辉石，带来其中一种 30 个即可。";
			next;
			mes "[Hibilaithan]";
			mes "好，祝你好运！在此期间我会在这里休息，等你回来。";
			set lv4_weapon,8;
			close;
		case 2:
			mes "[Hibilaithan]";
			mes "哈哈哈哈哈~！";
			mes "没必要";
			mes "这么谦虚！";
			mes "哦，你们冒险者";
			mes "有时真是傻得可爱。";
			next;
			mes "[Hibilaithan]";
			mes "如果你鼓起勇气向我提出请求，随时回来。给我机会展示天才般的技艺！";
			close;
		}
	}
	if ((lv4_weapon < 8) || (lv4_weapon > 14)) {
		mes "[Hibilaithan]";
		mes "……";
		mes "啊……我现在";
		mes "什么^820A2A都不想做^000000";
		mes "。晚点再来，好吗？";
		close;
	}
	if ((lv4_weapon == 12) || (lv4_weapon == 13) || (lv4_weapon == 14)) {
		mes "[Hibilaithan]";
		mes "啊，我感觉一切都准备好了。很好，很好，";
		mes "我可以开始了！现在，不许偷看。";
		mes "我不能冒险泄露";
		mes "厉害的秘密！";
		next;
		mes "^3355FF希比莱森拿起所有材料，背对着你。虽然你看不清他在做什么，但随着奇异能量在他周围聚集，他的动作看起来简单而笨拙。^000000";
		next;
		mes "[Hibilaithan]";
		mes "嗯~ 嗯~ 嗯~";
		mes "啊~ 啊~ 啊~";
		mes "呼~ 呼~ 呼~";
		mes "呜~ 呜~ 呜~";
		mes "哈~ 哈~ 哈~";
		next;
		mes "[Hibilaithan]";
		mes "哈哈，完成了！";
		mes "^333333*呼*^000000 真够费劲的，但我相信你迫不及待想看成品。好了，一起来看看……";
		next;
		mes "[Hibilaithan]";
		if (lv4_weapon == 12) {
			mes "哦，这是巨大的成功！当然，既然是我的作品，这不言而喻。嘿，这是武器……某种……破甲剑！";
			set lv4_weapon,0;
			getitem 1225,1; //Mail_Breaker
		}
		else if (lv4_weapon == 13) {
			mes "哦，这是巨大的成功！当然，既然是我的作品，这不言而喻。嘿，这是武器……某种……破剑！";
			set lv4_weapon,0;
			getitem 1224,1; //Sword_Breaker
		}
		else if (lv4_weapon == 14) {
			mes "哦，这是巨大的成功！当然，既然是我的作品，这不言而喻。嘿，这是武器……某种……屠杀者！";
			set lv4_weapon,0;
			getitem 1367,1; //Slaughter
		}
		next;
		mes "[Hibilaithan]";
		mes "啊，又一件证明我高超技艺的作品！想让我为你制作真正伟大的东西时，随时回来。回头见~";
		close;
	}
	if (((lv4_weapon == 9) && (countitem(7292) > 29)) || ((lv4_weapon == 10) && (countitem(7297) > 29)) || ((lv4_weapon == 11) && (countitem(7296) > 29))) {
		if (lv4_weapon == 9) {
			set .@itemreq,7292; //Muscovite
		}
		else if (lv4_weapon == 10) {
			set .@itemreq,7297; // Biotite
		}
		else if (lv4_weapon == 11) {
			set .@itemreq,7296; // Pyroxene
		}
		mes "[Hibilaithan]";
		mes "好，开始吧！";
		mes "首先，我们要看看你今天有多幸运。";
		mes "我们玩个简单的游戏，让你猜";
		mes "我正在想哪只魔物。";
		next;
		mes "[Hibilaithan]";
		mes "别担心，我会告诉你我喜欢哪些魔物，所以游戏并非不可能。如果你猜中其中一只，就说明你今天运气不错！";
		next;
		for( set .@i, 1; .@i <= 5; set .@i,.@i+1 ) {
			setarray .@mons[.@i],rand(1,4);
			mes "[Hibilaithan]";
			if (.@i == 1) {
				mes "好吧……";
				mes "我喜欢的魔物是";
				mes "希尔瓦、爱丽丝、木乃伊和";
				mes "伊西斯。现在……猜猜";
				mes "我正在想哪一只！";
			}
			else if (.@i == 2) {
				mes "好……";
				mes "现在我在想另一只魔物。还是吗？猜猜是哪一只！";
			}
			else if (.@i == 3) {
				mes "现在……";
				mes "我正在想";
				mes "哪只魔物？";
			}
			else if (.@i == 4) {
				mes "你能猜出";
				mes "我现在想的是哪只魔物吗？";
			}
			else if (.@i == 5) {
				mes "再来一次！";
				mes "我正在想";
				mes "哪只魔物？";
			}
			next;
			set .@answer,select("希尔瓦:爱丽丝:木乃伊:伊西斯");
			if (.@answer == .@mons[.@i]) {
				set .@dap,.@dap + 1;
			}
		}
		mes "[Hibilaithan]";
		mes "好了，就这样！";
		mes "这就是我刚才";
		mes "思考的魔物";
		mes "顺序……";
		next;
		mes "[Hibilaithan]";
		for( set .@i, 1; .@i <= 5; set .@i,.@i+1 ) {
			if (.@mons[.@i] == 1) {
				mes "希尔瓦";
			}
			else if (.@mons[.@i] == 2) {
				mes "爱丽丝";
			}
			else if (.@mons[.@i] == 3) {
				mes "木乃伊";
			}
			else if (.@mons[.@i] == 4) {
				mes "伊西斯";
			}
		}
		if (.@dap > 0) {
			delitem .@itemreq,30;
			set lv4_weapon,lv4_weapon+3;
		}
		else if (.@dap < 1) {
			delitem .@itemreq,10;
		}
		next;
		mes "[Hibilaithan]";
		if (.@dap > 0) {
			mes "太神奇了……";
			mes "你一定拥有心灵力量之类的东西。你回答正确了";
			mes "" + .@dap + " 次！哇，你今天运气真好！";
			next;
			mes "[Hibilaithan]";
			mes "既然如此，就没有理由";
			mes "给我一点准备时间，然后我们开始为你制作，好吗？";
			close;
		}
		else if (.@dap < 1) {
			mes "哦……";
			mes "这可不好。";
			mes "你全都^660000猜错了^000000。";
			mes "我们最好用 10 个"+getitemname(.@itemreq)+"驱散你的坏运气。";
			next;
			mes "[Hibilaithan]";
			mes "在你的运气足够好之前无法开始，所以还要再玩一次。如果矿石不够，回来前再收集一些。";
			next;
			mes "[Hibilaithan]";
			mes "我不会去哪里，";
			mes "所以不用着急。慢慢来，";
			mes "我会等着你！";
			close;
		}
	}
	if ((lv4_weapon == 9) || (lv4_weapon == 10) || (lv4_weapon == 11)) {
		mes "[Hibilaithan]";
		mes "嗯……有些不对劲。";
		mes "我们一定漏了什么。";
		mes "请再检查一下";
		mes "你带来的材料。";
		close;
	}
	if ((lv4_weapon == 8) && (countitem(969) > 9) && (countitem(999) > 49) && (countitem(714) > 9)) {
		mes "[Hibilaithan]";
		mes "哦，你比我预想的更早回来。基础材料都有了，但你带来最重要的东西了吗……？";
		next;
		if ((countitem(7292) > 29) || (countitem(7297) > 29) || (countitem(7296) > 29)) {
			if ((countitem(7292) > 29) && (countitem(7297) > 29) && (countitem(7296) > 29)) {
				mes "[Hibilaithan]";
				mes "哇，你把我要求的三种矿石都带来了？哈哈，我们只能使用一种，选一个吧。";
				next;
				switch(select("白云母:黑云母:辉石")) {
				case 1:
					set .@itemreq,7292; //Muscovite
					break;
				case 2:
					set .@itemreq,7297; // Biotite
					break;
				case 3:
					set .@itemreq,7296; // Pyroxene
					break;
				}
			}
			else if ((countitem(7292) > 29) && (countitem(7297) > 29)) {
				mes "[Hibilaithan]";
				mes "哈哈哈，你只需要带一种矿石，不是两种。现在想用哪一种？";
				next;
				switch(select("白云母:黑云母")) {
				case 1:
					set .@itemreq,7292; //Muscovite
					break;
				case 2:
					set .@itemreq,7297; // Biotite
					break;
				}
			}
			else if ((countitem(7292) > 29) && (countitem(7296) > 29)) {
				mes "[Hibilaithan]";
				mes "哈哈哈，你只需要带一种矿石，不是两种。现在想用哪一种？";
				next;
				switch(select("白云母:辉石")) {
				case 1:
					set .@itemreq,7292; //Muscovite
					break;
				case 2:
					set .@itemreq,7296; // Pyroxene
					break;
				}
			}
			else if ((countitem(7297) > 29) && (countitem(7296) > 29)) {
				mes "[Hibilaithan]";
				mes "哈哈哈，你只需要带一种矿石，不是两种。现在想用哪一种？";
				next;
				switch(select("黑云母:辉石")) {
				case 1:
					set .@itemreq,7297; // Biotite
					break;
				case 2:
					set .@itemreq,7296; // Pyroxene
					break;
				}
			}
			else {
				if (countitem(7292) > 29) {
					set .@itemreq,7292; //Muscovite
				}
				else if (countitem(7297) > 29) {
					set .@itemreq,7297; // Biotite
				}
				else if (countitem(7296) > 29) {
					set .@itemreq,7296; // Pyroxene
				}
			}
			mes "[Hibilaithan]";
			mes getitemname(.@itemreq)+", eh?";
			mes "好，在开始前，我们要尽量减少你的坏运气。";
			next;
			mes "[Hibilaithan]";
			mes "我们要投入大量材料和能量，失败了就太可惜了，对吧？";
			next;
			mes "[Hibilaithan]";
			mes "如果能在你运气好的日子制作，应该就没问题。为了测量你的运气，我们玩个读心游戏。";
			next;
			mes "[Hibilaithan]";
			mes "很简单。从四个选项中猜出我想的魔物名称。猜对一次，我们就可以开始！";
			next;
			mes "[Hibilaithan]";
			mes "你有五次机会。但如果五次全错，我需要拿走你带来的 10 个特殊矿石来驱散厄运。";
			next;
			mes "[Hibilaithan]";
			mes "当然，这听起来可能不太好，";
			mes "但为了保证特殊物品制作成功，这点代价值得，对吧？";
			next;
			mes "[Hibilaithan]";
			mes "好，我需要一些时间准备。晚点回来，让我判断你的";
			mes "今日运气~";
			delitem 969,10; //Gold
			delitem 999,50; //Steel
			delitem 714,10; //Emperium
			if (countitem(7292) > 29) {
				set lv4_weapon,9;
			}
			else if (countitem(7297) > 29) {
				set lv4_weapon,10;
			}
			else if (countitem(7296) > 29) {
				set lv4_weapon,11;
			}
			close;
		}
		else {
			mes "[Hibilaithan]";
			mes "嗯……？";
			mes "看来你没有带来";
			mes "我要求的特殊矿石。";
			mes "";
			next;
			mes "[Hibilaithan]";
			mes "请带来 30 个";
			mes "黑云母、白云母";
			mes "或辉石中的一种，";
			mes "我需要其中一种矿石";
			mes "才能开始制作。";
			close;
		}
	}
	if (lv4_weapon == 8) {
		mes "[Hibilaithan]";
		mes "首先，我需要";
		mes "10 个黄金、";
		mes "50 个钢铁和";
		mes "10 个铱金。";
		mes "这些是基础材料。";
		next;
		mes "[Hibilaithan]";
		mes "我还需要稀有矿石赋予作品力量。白云母、黑云母或辉石，带来其中一种 30 个即可。";
		next;
		mes "[Hibilaithan]";
		mes "好，祝你好运！在此期间我会在这里休息，等你回来。";
		close;
	}
	mes "[Hibilaithan]";
	mes "嘿嘿嘿……";
	mes "这一天终于";
	mes "到来了。最终，";
	mes "我获得了";
	mes "乌姆巴拉最伟大工匠的称号！";
	next;
	mes "[Hibilaithan]";
	mes "没错没错，我就是^802A2A那位^000000希比莱森。";
	mes "如果你带来材料，我就屈尊为你制作一件杰作。哇哈哈哈~！";
	next;
	mes "[Hibilaithan]";
	mes "嗯？你说什么？";
	mes "没听说过我？";
	mes "别开玩笑了！";
	mes "虽然我是这门技艺的大师，但没必要感到畏惧。";
	next;
	mes "[Hibilaithan]";
	mes "现在老实回答……";
	mes "你想成为";
	mes "我那令人赞叹、";
	mes "常被模仿的";
	mes "杰作的拥有者吗？";
	next;
	switch(select("Yes. Yes, I do.:Sorry, I don't need it!")) {
	case 1:
		if (BaseLevel < 70) {
			mes "[Hibilaithan]";
			mes "哦……";
			mes "你的心智太弱，无法承受我作品的力量。抱歉，你需要更多训练。";
			next;
			mes "[Hibilaithan]";
			mes "我知道等待拥有我的作品一定很难受。但为了你自己，先变强再回来找我吧。";
			close;
		}
		mes "[Hibilaithan]";
		mes "哈哈哈哈！";
		mes "你当然想要！";
		mes "我只是反问而已！";
		mes "不过我喜欢你的态度。现在告诉你需要带什么，";
		mes "可别忘了。";
		next;
		mes "[Hibilaithan]";
		mes "首先，我需要";
		mes "10 个黄金、";
		mes "50 个钢铁和";
		mes "10 个铱金。";
		mes "这些是基础材料。";
		next;
		mes "[Hibilaithan]";
		mes "我还需要稀有矿石赋予作品力量。白云母、黑云母或辉石，带来其中一种 30 个即可。";
		next;
		mes "[Hibilaithan]";
		mes "好，祝你好运！在此期间我会在这里休息，等你回来。";
		set lv4_weapon,8;
		close;
	case 2:
		mes "[Hibilaithan]";
		mes "哈哈哈哈哈~！";
		mes "没必要";
		mes "这么谦虚！";
		mes "哦，你们冒险者";
		mes "有时真是傻得可爱。";
		next;
		mes "[Hibilaithan]";
		mes "如果你鼓起勇气向我提出请求，随时回来。给我机会展示天才般的技艺！";
		close;
	}
}

um_in,156,77,5	script	Tabezthan#lv4	788,{
	if (checkweight(908,300) == 0) {
		mes "^3355FF等一下！你现在携带了太多物品。把一些东西存进卡普拉仓库后再回来。^000000";
		close;
	}
	if (event_umbala < 3) {
		mes "[Tabezthan]";
		mes "乌姆巴！乌姆巴巴……呜呜！鲍姆巴！";
		mes "呜姆姆巴巴巴呜姆巴巴乌姆巴！";
		mes "乌姆巴乌姆巴乌姆巴乌姆哈哈！";
		mes "呜姆姆姆姆巴巴巴巴巴！";
		close;
	}
	if (lv4_weapon == 0) {
		mes "[Tabezthan]";
		mes "嗯……";
		mes "我感觉你与众不同。你是这里的陌生人，对吗？";
		next;
		mes "[Tabezthan]";
		mes "请允许我自我介绍。我是塔贝斯森，乌姆巴拉知识的源泉、闻名遐迩的天才。哈哈哈！";
		next;
		mes "[Tabezthan]";
		mes "我有两名弟子：愚蠢的希比莱森，以及相当聪明、很有潜力的巴佐。";
		next;
		mes "[Tabezthan]";
		mes "当然，他们都很有天赋和技巧，但我担心希比莱森。他经常犯愚蠢的错误，却对错误毫不羞愧。";
		next;
		mes "[Tabezthan]";
		mes "我教他们操纵乌姆巴拉的环境能量";
		mes "来创造物品。我听说外界有一种类似的技能，你们称之为炼金术。";
		next;
		mes "[Tabezthan]";
		mes "无论如何，你需要我的技艺吗？";
		mes "如果需要，请带来所需材料，让我为你效劳。";
		next;
		switch(select("好的，谢谢。:不用了，谢谢。")) {
		case 1:
			if (BaseLevel < 70) {
				mes "[Tabezthan]";
				mes "很遗憾，你还无法驾驭我的技艺。请先训练并变得更强再回来。祝你旅途平安。";
				close;
			}
			mes "[Tabezthan]";
			mes "很好。我希望你记住";
			mes "需要带给我的东西，";
			mes "这样我才能为你制作。我需要……";
			next;
			mes "[Tabezthan]";
			mes "10 个黄金、";
			mes "50 个钢铁";
			mes "和 10 个铱金，";
			mes "作为基础材料。";
			mes "我还需要稀有矿石来附魔作品。";
			next;
			mes "[Tabezthan]";
			mes "此外，请带来 30 个金云母、橄榄石或玫瑰石英。根据你选择的矿石，我的作品会拥有不同特性。";
			next;
			mes "[Tabezthan]";
			mes "请注意，我不知道确切会制作出什么物品。炼金术的因素太多，任何人的知识都有极限。";
			next;
			mes "[Tabezthan]";
			mes "换句话说，我们只能相信运气。不过之后还有时间讨论。现在请去收集必要材料，我会在这里等你。";
			set lv4_weapon,15;
			close;
		case 2:
			mes "[Tabezthan]";
			mes "哦……我明白了。";
			mes "听到这个有点失望，但如果你觉得我能帮上忙，";
			mes "请再回来";
			mes "找我。";
			close;
		}
	}

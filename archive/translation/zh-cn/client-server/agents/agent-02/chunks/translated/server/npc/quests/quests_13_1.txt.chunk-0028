que_dan02,115,53,3	script	Man#moc2_crazyR01	456,{
	if (mao_morocc2 == 19) {
		mes "一个浑身是血的男人站在角落，脸上带着神秘的笑容。";
		next;
		donpcevent "Mr. Kidd#moc_extra01::OnEnable";
		mes "[Mr. Kidd]";
		mes "看来时机正好。";
		mes "话说，这个人是谁？";
		mes "他看起来……他疯了，对吧？";
		cutin "mocseal_kid01",0;
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "哇！你从哪里来的？";
		next;
		mes "[Mr. Kidd]";
		mes "...From somewhere.";
		mes "总之……";
		mes "发生了什么？";
		mes "你是谁？";
		next;
		cutin "moc2_dan01",2;
		mes "[Man]";
		mes "……我是谁……？";
		mes "……我想不起来了……";
		mes "他们都死了……是我杀了他们。";
		mes "嘿嘿嘿，我只是遵从主人的意志。";
		mes "呜哈哈哈哈！！";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "不……不可能！";
		next;
		select("Rayan?!");
		cutin "moc2_kid02",0;
		mes "[Mr. Kidd]";
		mes "什么？这真的是我们一直追查的拉扬吗？";
		mes "..... !!!";
		mes "对了，你说拉扬和同伴发生了争执……";
		next;
		cutin "moc2_dan02",2;
		mes "[Rayan]";
		mes "……雷……拉扬？那是我的名字？没错……";
		mes "我是拉扬，拉扬·摩尔。";
		mes "你是谁……？";
		next;
		mes "[Rayan]";
		mes "我在哪里？这些血是怎么回事？！";
		mes "……嗯？我在哪里？我的同伴怎么了？";
		next;
		cutin "mocseal_kid01",0;
		mes "[Mr. Kidd]";
		mes "……看来我是对的。他确实是拉扬·摩尔。";
		mes "他怎么了？";
		mes "他似乎……真的很困惑。甚至可能精神不稳定。";
		next;
		mes "[Mr. Kidd]";
		mes "现在正是抓住他的好时机，免得他杀了我们。";
		mes "凛能确认他是不是拉扬，因为我从没见过他摘下面具……";
		next;
		mes "[Mr. Kidd]";
		mes "我会把这家伙带给凛，让她审问他。";
		mes "营地见。";
		cutin "mocseal_kid01",255;
		next;
		mes "- 你看着基德先生逮捕失去意识的拉扬，并取出传送道具。你决定返回城镇。-";
		set mao_morocc2,20;
		changequest 7028,7029;
		close2;
		//consumeitem 602; //Wing_Of_Butterfly
		warp "SavePoint",0,0;
		donpcevent "Mr. Kidd#moc_extra01::OnDisable";
	}
	else {
		mes "[Man]";
		mes "我活着就是为了侍奉主人！";
		mes "你是他的敌人吗？";
		mes "去死！";
		close2;
		percentheal -100,0;
		end;
	}
	cutin "mocseal_kid01",255;
	end;
}


que_dan02,21,37,0	script	#moc2_b1_gate	-1,1,1,{
OnTouch:
	if (mao_morocc2 == 17) {
		mes "- 你找到一扇通往地下室的侧门。";
		mes "微弱的光线从门缝中透出。";
		mes "里面有人在大声交谈。-";
		next;
		mes "[Male Voice]";
		mes "嘿，拉扬，说句话。";
		mes "我们做了你要求的一切，";
		mes "但是……";
		next;
		mes "[Male Voice]";
		mes "……这完全不对。";
		mes "我们做了不该做的事。";
		mes "拜托，重新考虑一下。";
		next;
		mes "[Male Voice]";
		mes "拉扬，拉扬！";
		mes "我们只是想让城镇稍微混乱一点，";
		mes "不是想召唤撒旦·摩洛克！仪式像最初计划的那样失败了，但是……";
		next;
		mes "[Voices]";
		mes "没错。仪式失败了，但发生了什么？撒旦·摩洛克自己复活了。";
		mes "他会带来这个世界的末日。";
		mes "我们都做了些什么？！";
		mes "现在我们甚至回不了自己的国家！";
		next;
		mes "[Anxious Voice]";
		mes "……我们都知道，失去利用价值后就会被处理掉，就像棋盘上的棋子。";
		mes "但我很好奇。";
		mes "拉扬……";
		next;
		mes "[Anxious Voice]";
		mes "拉扬，说句话！";
		mes "你到底怎么了？";
		mes "怎么，你还忘不了那个刺客吗？";
		mes "……喂，告诉我们。现在该怎么办？";
		next;
		mes "[Anxious Voice]";
		mes "让我问你一个问题。";
		mes "……是你……真的是你召唤了撒旦·摩洛克吗？";
		mes "是你吗？";
		mes "你真的让我们帮你复活撒旦·摩洛克？！";
		next;
		mes "[Anxious Voice]";
		mes "如果你的沉默意味着是，那我退出！";
		mes "我以前不知道，但现在知道了。我要走了！";
		next;
		mes "[Rayan]";
		mes "无能的弱者。";
		mes "我不再需要你们了。";
		mes "感谢你们一直以来听从我的指挥。";
		mes "但你们不过是女神的傀儡……*咯咯咯*";
		next;
		mes "[Male Voice]";
		mes "嘿，嘿！你在做什么？！";
		mes "你为什么要这样做？！";
		next;
		mes "- 你在他们的叫喊和尖叫声中听到沉重的撞击声。";
		mes "听起来他们正在发生激烈争执。-";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "...Rayan? ...Morocc? ...Resurrect...?";
		mes "我完全不知道他们在说什么。他们为什么打起来了？";
		next;
		mes "[Rayan]";
		mes "你们这些无知的傀儡……";
		mes "你们太愚蠢，无法理解我主人的伟大意志……";
		mes "……对了，我完全忘了‘它’。是时候把它拿回来了。";
		mes "你说什么？*咯咯咯*";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "什么？！他知道我在这里？！";
		mes "我最好快跑！";
		next;
		mes "- 你使用了蝴蝶翅膀。-";
		set mao_morocc2,18;
		changequest 7026,7027;
		close2;
		//consumeitem 602; //Wing_Of_Butterfly
		warp "SavePoint",0,0;
		end;
	}
	else if (mao_morocc2 == 19) {
		mes "- 通往地下室的侧门开着。";
		mes "- 你想进去的话可以进去。-";
		next;
		switch(select("进入。:不要进入。")) {
		case 1:
			warp "que_dan02",91,11;
			end;
		case 2:
			mes "你决定不进入地下室。";
			close;
		}
	}
	else {
		mes "- 这扇门似乎通往地下室，";
		mes "- 但它锁得很牢。-";
		close;
	}
}


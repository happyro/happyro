// Main Quest :: TutorialVer2
//============================================================
moc_para01,34,178,3	script	Tutorial Instructor	904,{
	if (Class == Job_Novice) {
		// Fall through
	} else if (checkquest(9167) == -1) {
	OnStartQuest:
		if (@tutorial_restart) {
			set .@tutorial_restart,1;
			set @tutorial_restart,0;
		}
		mes "[教程教官]";
		mes "最近有人说，";
		mes "人们正在研究为装备添加选项";
		mes "以便放入插槽或添加状态";
		mes "给原本没有这些效果的装备。";
		mes "他们把这称为^006400附魔^000000。";
		next;
		mes "[教程教官]";
		mes "看到这项技术正在开发后，";
		mes "我深受启发，";
		mes "努力研究";
		mes "最终找到了方法";
		mes "创造了自己的^006400附魔^000000方式！";
		next;
		mes "[教程教官]";
		mes "但要做到这一点，";
		mes "我需要一些特殊材料。";
		mes "如果你愿意的话……";
		mes "你能不能";
		mes "帮我收集它们？";
		next;
		switch(select("好的，我可以帮忙：我现在有点忙……")) {
		case 1:
			mes "[教程教官]";
			mes "不过，看看你现在的样子，";
			mes "让我怀疑";
			mes "你是否有能力收集";
			mes "我需要的物品……";
			next;
			mes "[教程教官]";
			mes "好吧，如果你雇佣";
			mes "一名^006400佣兵^000000来做这件事，";
			mes "我想我就可以把委托交给你……";
			mes "可以吧？";
			next;
			mes "[教程教官]";
			mes "想雇佣佣兵，";
			mes "就去找^006400佣兵公会^000000，";
			mes "它就在^8B4513普隆德拉^000000正门附近。";
			mes "去找^006400信息员^000000，";
			mes "询问^006400佣兵公会官员^000000";
			mes "的位置，他们会告诉你。";
			next;
			if (.@tutorial_restart) {
				erasequest 9167;
				erasequest 9168;
				erasequest 9169;
				erasequest 9170;
				erasequest 9171;
				erasequest 9172;
				completequest 9173;
				erasequest 9173;
			}
			mes "[教程教官]";
			mes "现在……快去雇佣";
			mes "一名^006400佣兵^000000再回来找我！";
			setquest 9167;
			close;
		case 2:
			mes "[教程教官]";
			mes "既然你说你很忙，";
			mes "那我也没办法……";
			mes "不忙的时候再来找我。";
			close;
		}
	} else if (checkquest(9167) == 0 || checkquest(9167) == 1) {
		if (!getmercinfo(1)) {
			mes "[教程教官]";
			mes "你还没有佣兵。";
			next;
			mes "[教程教官]";
			mes "想雇佣佣兵，";
			mes "就去找^006400佣兵公会^000000，";
			mes "它就在^8B4513普隆德拉^000000正门附近。";
			mes "去找^006400信息员^000000，";
			mes "询问^006400佣兵公会官员^000000";
			mes "的位置，他们会告诉你。";
			next;
			mes "[教程教官]";
			mes "现在……快去雇佣";
			mes "一名^006400佣兵^000000再回来找我！";
			close;
		}
		mes "[教程教官]";
		mes "看到你带着^006400佣兵^000000，我确实更信任你了。";
		next;
		mes "[教程教官]";
		mes "006400佣兵^000000会通过";
		mes "为你战斗直接提供帮助，";
		mes "而^006400宠物^000000则通过它们的";
		mes "能力和多样外表间接帮助你，";
		mes "并俘获你的心。";
		mes "将来也试着养一只^006400宠物^000000吧。";
		next;
		mes "[教程教官]";
		mes "现在，让我看看……为了";
		mes "让这次^006400附魔^000000成功，";
		mes "你需要为我收集一些材料……";
		mes "我需要的是……";
		mes "..............";
		next;
		select("我好像没听清楚……");
		mes "[教程教官]";
		mes "我真的不喜欢重复自己……";
		mes "你再这样问我，";
		mes "嘴巴不会累吗？";
		mes "这种情况下，打开^006400任务窗口^000000";
		mes "就能看到要求你做什么";
		mes "以及我的委托详情。";
		next;
		mes "[教程教官]";
		mes "查看左上角";
		mes "信息区域内";
		mes "会显示^006400任务^000000";
		mes "点击它后";
		mes "就会显示所有";
		mes "与委托相关的信息。";
		next;
		mes "[教程教官]";
		mes "确认所需材料后";
		mes "从";
		mes "^006400任务窗口^000000中收集，";
		mes "再回来和我说话。";
		completequest 9167;
		setquest 9168;
		close;
	} else if (checkquest(9168) == 0 || checkquest(9168) == 1) {
		if (checkweight(607,1) == 0) {
			if (MaxWeight - Weight < getiteminfo(607, ITEMINFO_WEIGHT)) {
				mes "[Tutorial Instructor]";
				mes "你似乎携带了太多物品，";
				mes "物品栏很重，行动迟缓……";
				mes "这样很难完成我的委托";
				mes "因为那些杂物让你负重过高！";
				mes "清空物品栏后再回来找我。";
				close;
			} else {
				mes "[Tutorial Instructor]";
				mes "看来你身上";
				mes "多带了一件物品……";
				mes "如果你想帮我";
				mes "就得先把一些东西";
				mes "收起来再回来。";
				close;
			}
		}
		mes "[Tutorial Instructor]";
		mes "你打开^006400任务窗口^000000了吗";
		mes "确认材料了吗？";
		next;
		switch(select("是的！：没有……：任务窗口在哪里……")) {
		case 1:
			mes "[教程教官]";
			mes "哦，是吗？那我来测试一下";
			mes "看看你是否真的检查过？";
			mes "写下我让你收集的材料。";
			next;
			input .@inputstr$;
			if (.@inputstr$ == "10 Jellopy") {
				mes "[Tutorial Instructor]";
				mes "很好，你知道。";
				mes "现在，你是否已经熟悉";
				mes "^006400任务窗口^000000了？";
				mes "但还有个问题……";
				mes "你知道要收集什么材料，";
				mes "但收集起来并不容易。";
				next;
				mes "[Tutorial Instructor]";
				mes "另外，还有一件事";
				mes "我强烈建议你尝试。";
				mes "那就是……";
				mes "^006400万能银色目录^000000。";
				next;
				mes "[Tutorial Instructor]";
				mes "^006400万能银色目录^000000";
				mes "可以从";
				mes "位于伊甸园集团总部的^0000FF目录魔法师^000000";
				mes "那里获得。";
				next;
				mes "[Tutorial Instructor]";
				mes "现在，去获得";
				mes "一本^006400万能银色目录^000000";
				mes "然后回来和我说话。";
				completequest 9168;
				setquest 9169;
				close;
			}
			mes "[Tutorial Instructor]";
			mes "你……看起来仍然";
			mes "不太了解";
			mes "^006400Quest Window^000000.";
			mes "我再告诉你一次。";
			next;
			break;
		case 2:
			mes "[Tutorial Instructor]";
			mes "快检查";
			mes "任务窗口中需要哪些材料。";
			mes "你的^006400任务窗口^000000。";
			close;
		case 3:
			break;
		}
		mes "[教程教官]";
		mes "查看左上角";
		mes "信息区域内";
		mes "会显示^006400任务^000000";
		mes "点击它后";
		mes "就会显示所有";
		mes "与委托相关的信息。";
		next;
		mes "[Tutorial Instructor]";
		mes "确认所需材料后";
		mes "从";
		mes "^006400任务窗口^000000中收集，";
		mes "再回来和我说话。";
		close;
	} else if (checkquest(9169) == 0 || checkquest(9169) == 1) {
		if (countitem(12580) == 0) {
			mes "[Tutorial Instructor]";
			mes "嗯？我注意到";
			mes "你还没有去领取";
			mes "^006400Universal Silver Catalog^000000 ！";
			next;
			mes "[Tutorial Instructor]";
			mes "你可以从";
			mes "^006400Universal Silver Catalog^000000";
			mes "从位于伊甸园集团总部的^0000FF目录魔法师^000000";
			mes "位于伊甸园集团总部的那里获得。";
			next;
			mes "[Tutorial Instructor]";
			mes "所以，去领取";
			mes "^006400Universal Silver Catalog^000000";
			mes "然后回来找我。";
			close;
		}
		mes "[Tutorial Instructor]";
		mes "哦！你成功获得了";
		mes "^006400Universal Silver Catalog^000000!";
		next;
		mes "[Tutorial Instructor]";
		mes "它可以让你浏览和搜索";
		mes "所有各种商店";
		mes "它们位于同一地图并且";
		mes "正在营业。";
		next;
		mes "[Tutorial Instructor]";
		mes "一本只需200 Zeny";
		mes "使用它可以";
		mes "搜索最多10次。";
		mes "可以说这是必需品。";
		next;
		mes "[Tutorial Instructor]";
		mes "所以，前往你想去的区域";
		mes "并试用 ^006400Universal Silver Catalog^000000";
		mes "然后来找我";
		mes "完成后";
		completequest 9169;
		setquest 9170;
		close;
	} else if (checkquest(9170) == 0 || checkquest(9170) == 1) {
		if (countitem(12580)) {
			mes "[Tutorial Instructor]";
			mes "嗯……看来你仍然有";
		mes "物品栏中的^006400万能银色目录^000000。";
			mes "既然你说忘了如何使用它";
			mes "我再向你说明一次。";
			next;
			mes "[Tutorial Instructor]";
		mes "你看……^006400万能银色目录^000000";
			mes "可以让你浏览和搜索";
			mes "所有各种商店";
			mes "它们位于同一地图并且";
			mes "正在营业。";
			next;
			mes "[Tutorial Instructor]";
			mes "所以，前往你想去的区域";
			mes "并试用 ^006400Universal Silver Catalog^000000";
			mes "之后来找我";
			mes "完成后";
			close;
		}
		mes "[Tutorial Instructor]";
		mes "试用后感觉如何？";
		mes "^006400万能银色目录^000000？";
		mes "这比";
		mes "逐一查看每个";
		mes "商人并寻找物品";
		mes "要轻松得多，对吧？";
		next;
		mes "[Tutorial Instructor]";
		mes "现在，出去收集";
		mes "我需要的材料，";
		mes "我一定会给你";
		mes "精彩的^006400附魔^000000！";
		mes "我会等你！";
		completequest 9170;
		setquest 9171;
		close;
	} else if (checkquest(9171) == 0 || checkquest(9171) == 1) {
		if (countitem(909) < 10) {
			mes "[Tutorial Instructor]";
			mes "看来你没有带来";
			mes "足够的材料。你忘了";
			mes "需要收集什么吗？";
			next;
			switch(select("是啊……：才不是！")) {
			case 1:
				mes "[Tutorial Instructor]";
				mes "有人告诉我，点击";
				mes "左上角写着";
				mes "^006400任务^000000的地方，就会显示所有";
				mes "你需要的信息";
				mes "以及与你的委托相关的内容。";
				next;
				mes "[Tutorial Instructor]";
				mes "收集完所有列出的材料后";
				mes "它们都在你的^006400任务窗口^000000中";
				mes "来和我说话。";
				close;
			case 2:
				mes "[Tutorial Instructor]";
				mes "收集物品后";
				mes "来找我，我会展示给你";
				mes "厉害的^006400附魔^000000。";
				mes "我会等你！";
				close;
			}
		}
		if (checkweight(607,6) == 0) {
			if (MaxWeight - Weight < getiteminfo(607, ITEMINFO_WEIGHT)) {
				mes "[Tutorial Instructor]";
				mes "你的物品栏似乎塞得太满";
				mes "装满各种东西……你觉得";
				mes "负重这么高还能完成什么吗？";
				mes "负重太高了。先收起一些东西";
				mes "然后回来找我。";
				close;
			} else {
				mes "[Tutorial Instructor]";
				mes "你似乎有太多东西";
				mes "在物品栏中。.. Go put some";
				mes "东西收起来，再回来找我";
				mes "等你身上没那么多东西时。";
				close;
			}
		}
		mes "[Tutorial Instructor]";
		mes "你带来了我要求的一切！";
		mes "那么～开始这厉害的";
		mes "我发现并开发的附魔吧？";
		next;
		specialeffect EF_BASH3D2;
		mes "[Tutorial Instructor]";
		mes "好！现在是第一个技能！！";
		mes "为防具添加新能力……";
		mes "^006400隐藏插槽附魔^000000！！";
		next;
		specialeffect EF_BASH3D2;
		mes "[Tutorial Instructor]";
		mes "第二个技能！！";
		mes "为你的武器和盾牌";
		mes "添加新插槽……";
		mes "^006400插槽附魔^000000！！";
		next;
		mes "[Tutorial Instructor]";
		mes "好了，附魔完成。光看我操作你无法理解过程，所以让你亲自查看这些物品。";
		delitem 909,10; //Jellopy
		completequest 9171;
		setquest 9172;
		getitem2 15033,1,1,0,0,0,0,0,4702; //Tutorial_Mattle[Strength3]
		getitem 15033,1; //Tutorial_Mattle
		getitem 15034,1; //Tutorial_Mattle_
		next;
		mes "[Tutorial Instructor]";
		mes "这些物品不能";
		mes "装备或交易，所以别想着";
		mes "带着它们逃跑。";
		mes "查看完后，";
		mes "把它们还给我。";
		close;
	} else if (checkquest(9172) == 0 || checkquest(9172) == 1) {
		if (countitem(15033) == 0 || countitem(15034) == 0) {
			mes "[Tutorial Instructor]";
			mes "你把我借给你查看的附魔";
			mes "物品弄到哪里去了？";
			mes "在你带回";
			mes "我的劳动成果前，我不想和你说话，";
			mes "更别说见你的脸。";
			close;
		}
		mes "[Tutorial Instructor]";
		mes "查看完";
		mes "我附魔的物品了吗？";
		next;
		switch(select("是的，谢谢：我还没看。")) {
		case 1:
			mes "[教程教官]";
			mes "检查后感觉如何？现在你已经看过真正的附魔物品，理解附魔了吗？";
			// Item deletions moved below to prevent errors.
			next;
			mes "[教程教官]";
			mes "多亏了你，我才能看到研究和学习的成果。";
			next;
			mes "[教程教官]";
			mes "如果你对我讲过的内容有任何疑问，我会全部告诉你！感谢你的努力！";
			delitem 15033,2;
			delitem 15034,1;
			completequest 9172;
			setquest 9173;
			getexp 5000,2500;
			close;
		case 2:
			mes "[教程教官]";
			mes "慢慢查看";
			mes "然后把它们还给我。";
			close;
		}
	} else if (checkquest(9173) == 0 || checkquest(9173) == 1) {
		mes "[教程教官]";
		mes "你有什么问题吗？";
		next;
		switch(select("可以再次做同样的任务吗？：关于任务窗口……：关于附魔……：关于商店搜索……：关于佣兵和宠物……：结束对话。")) {
		case 1:
			if (checkquest(9173,PLAYTIME) == 0 || checkquest(9173,PLAYTIME) == 1) {
				mes "[教程教官]";
				mes "重复完成同样任务的方法是进行^006400每日任务^000000。";
				next;
				mes "[教程教官]";
				mes "完成并提交^006400每日任务^000000后，等待大约一天，再回来领取委托并重新完成！";
				mes "[教程教官]";
				mes "领取每日任务后，查看^006400任务窗口^000000右下角。那里有名为^006400有限^000000的区域，会告诉你还需等待多久才能领取下一个每日任务。";
				next;
				mes "[教程教官]";
				mes "完成我的任务后似乎还要等待一段时间。再等一会儿，然后回来找我，就能再次接到同样的任务。";
				close;
			}
			mes "[教程教官]";
			mes "看来你完成我的任务已经过去一天左右了。好吧，和^006400每日任务^000000一样，你可以从我这里领取任务。要继续吗？";
			next;
			switch(select("是：否")) {
			case 1:
				set @tutorial_restart,1;
				goto OnStartQuest;
			case 2:
				mes "[教程教官]";
				mes "好吧。但如果改变主意想领取任务，就来找我。";
				close;
			}
		case 2:
			mes "[教程教官]";
			mes "据说^006400任务窗口^000000会详细列出你需要了解的任务信息。";
			next;
			mes "[教程教官]";
		mes "查看左上角信息区域，";
		mes "那里会显示^006400任务^000000；";
		mes "点击它后，";
		mes "就会显示所有与委托相关的信息。";
			next;
			mes "[教程教官]";
			mes "使用^006400任务窗口^000000会让生活更轻松。它会告诉你去哪里、获得哪些物品、寻找谁等等。";
			close;
		case 3:
			mes "[教程教官]";
			mes "一般来说，^006400附魔^000000分为两类：^006400插槽附魔^000000和^006400隐藏插槽附魔^000000。";
			next;
			mes "[教程教官]";
			mes "^006400插槽附魔^000000用于给装备增加插槽，^006400隐藏插槽附魔^000000用于给防具的插槽添加属性。";
			next;
			mes "[教程教官]";
			mes "当然，这需要一些材料，也有失败的可能，但这就是你要承担的风险。";
			next;

	next;
	mes "[Ktullanux]";
	mes "如果你不插手！！！";
	next;
	mes "[Ktullanux]";
	mes "我会除掉教皇和卢文。";
	next;
	mes "[Ktullanux]";
	mes "教皇，到这里来！";
	disablenpc instance_npcname("Ktullanux#3hmoon01");
	disablenpc instance_npcname("Pope#3hmoon04");
	if ('mode == 1)
		mercenary_create 3569,1800000; //POPE_MD_H_MERC_NORMAL
	else
		mercenary_create 3570,1800000; //POPE_MD_H_MERC_CASUAL
	instance_announce 0, "库特拉纳克斯：我会让你无痛地死去！", bc_map, "0xFFFF00";
	if ('progress == 16) {
		'progress = 17;
		donpcevent instance_npcname("#mob3hmoon") + "::OnStart";
	}
	close3;
}

1@pop3,57,68,1	script(DISABLED)	Pope#3hmoon02	4_F_ARUNA_POP2,{
	if ('progress != 18)
		end;
	mes "[" + strcharinfo(0) + "]";
	mes "教皇，你还好吗？";
	next;
	cutin "pops_sim", 2;
	mes "[Pope]";
	mes "兄弟……被冻在冰洞里了。";
	next;
	mes "[" + strcharinfo(0) + "]";
	mes "卢文的意识已经不在这个梦里了。";
	next;
	mes "[" + strcharinfo(0) + "]";
	mes "这是卢文创造、由教皇共享的梦境领域。双胞胎同时拥有的命运让这个梦成为可能。";
	next;
	mes "[Pope]";
	mes "我想救我的兄弟。我想在这里陪着他……";
	next;
	mes "[" + strcharinfo(0) + "]";
	mes "如果教皇不回去，很多人都会难过。";
	next;
	mes "[Pope]";
	mes "我不想回去。这里才是我的归宿。";
	next;
	enablenpc instance_npcname("Pope#3hmoon03");
	cutin "pop_nor", 0;
	mes "[Pope]";
	mes "回去吧。";
	npctalk "回到你该去的地方。", instance_npcname("Pope#3hmoon03");
	next;
	mes "[Pope]";
	mes "夜晚开启通道的梦之所在……";
	next;
	mes "[Pope]";
	mes "我无法隐藏。";
	next;
	disablenpc instance_npcname("Pope#3hmoon02");
	enablenpc instance_npcname("Pope#3hmoon05");
	cutin "pops_sim", 2;
	mes "[Pope]";
	mes "你是谁，你是谁？";
	npctalk "你是谁，你是谁？", instance_npcname("Pope#3hmoon05");
	next;
	cutin "pop_nor", 0;
	mes "[Pope]";
	mes "你知道自己是谁吗？";
	npctalk "你是谁？", instance_npcname("Pope#3hmoon03");
	next;
	cutin "pops_sim", 2;
	mes "[Pope]";
	mes "我……我……";
	next;
	cutin "pop_nor", 0;
	mes "[Pope]";
	mes "你已经知道答案了。";
	next;
	cutin "pops_sim", 2;
	mes "[Pope]";
	mes "我不知道答案……我会和兄弟在这里。";
	npctalk "……我会和兄弟在这里。", instance_npcname("Pope#3hmoon05");
	next;
	cutin "pop_nor", 0;
	mes "[Pope]";
	mes "我一直想和兄弟在一起。";
	npctalk "我一直想和兄弟在一起。", instance_npcname("Pope#3hmoon03");
	next;
	cutin "pops_sim", 2;
	mes "[Pope]";
	mes "爸爸妈妈不会希望这样……";
	npctalk "爸爸妈妈不会希望这样……", instance_npcname("Pope#3hmoon05");
	next;
	cutin "pop_nor", 0;
	mes "[Pope]";
	mes "我们的爸爸妈妈。他们‘荣幸地’把我们献上。";
	npctalk "我们的爸爸妈妈。他们‘荣幸地’把我们献上。", instance_npcname("Pope#3hmoon03");
	next;
	cutin "pops_sim", 2;
	mes "[Pope]";
	mes "一开始根本没人想要我。";
	npctalk "一开始根本没人想要我。", instance_npcname("Pope#3hmoon05");
	next;
	cutin "pop_nor", 0;
	mes "[Pope]";
	mes "那么现实中等待你的人呢？";
	npctalk "那么现实中等待你的人呢？", instance_npcname("Pope#3hmoon03");
	next;
	cutin "pops_sim", 2;
	mes "[Pope]";
	mes "……我不是任何人的替代品，我一开始就不希望发生这种事！";
	npctalk "……我不是任何人的替代品，我一开始就不希望发生这种事！", instance_npcname("Pope#3hmoon05");
	next;
	cutin "pop_nor", 0;
	mes "[Pope]";
	mes "生命是一种恩赐。有时你无法选择人生想要的东西。";
	npctalk "生命是一种恩赐。有时你无法选择人生想要的东西。", instance_npcname("Pope#3hmoon03");
	next;
	cutin "pops_sim", 2;
	mes "[Pope]";
	mes "即便如此，那也会让我……非常开心。";
	npctalk "即便如此，那也会让我……非常开心。", instance_npcname("Pope#3hmoon05");
	next;
	cutin "pop_nor", 0;
	mes "[Pope]";
	mes "你可以通过给别人机会来给自己机会。你是特殊的存在，就像黑暗中的月亮。";
	npctalk "你可以通过给别人机会来给自己机会。你是特殊的存在，就像黑暗中的月亮。", instance_npcname("Pope#3hmoon03");
	next;
	cutin "pops_sim", 2;
	mes "[Pope]";
	mes "我，我……";
	next;
	cutin "pop_nor", 0;
	mes "[Pope]";
	mes "你是谁？";
	next;
	cutin "pops_smi", 2;
	mes "[Pope]";
	mes "我是阿鲁纳佩尔兹的教皇。";
	npctalk "我是阿鲁纳佩尔兹的教皇。", instance_npcname("Pope#3hmoon05");
	next;
	cutin "pops_smi", 2;
	mes "[Pope]";
	mes "你就是我。";
	npctalk "你就是我。", instance_npcname("Pope#3hmoon05");
	next;
	cutin "pop_nor", 0;
	mes "[Pope]";
	mes "我就是你。";
	npctalk "我就是你。", instance_npcname("Pope#3hmoon03");
	next;
	cutin "pops_smi", 2;
	mes "[Pope]";
	mes "我是阿鲁纳佩尔兹的教皇。";
	npctalk "我是阿鲁纳佩尔兹的教皇。", instance_npcname("Pope#3hmoon05");
	next;
	cutin "pop_nor", 0;
	mes "[Pope]";
	mes "我是阿鲁纳佩尔兹的教皇。";
	npctalk "我是阿鲁纳佩尔兹的教皇。", instance_npcname("Pope#3hmoon03");
	cutin "pop_nor", 255;
	sleep2 2000;
	specialeffect EF_CONCENTRATION2, AREA, instance_npcname("Pope#3hmoon03");
	specialeffect EF_CONCENTRATION2, AREA, instance_npcname("Pope#3hmoon03");
	sleep2 1000;
	specialeffect EF_BASH3D6, AREA, instance_npcname("Pope#3hmoon05");
	specialeffect EF_ITEM315, AREA, instance_npcname("Pope#3hmoon05");
	specialeffect EF_BASH3D6, AREA, instance_npcname("Pope#3hmoon03");
	specialeffect EF_ITEM315, AREA, instance_npcname("Pope#3hmoon03");
	specialeffect 1044, AREA, instance_npcname("Pope#3hmoon03");
	specialeffect 1044, AREA, instance_npcname("Pope#3hmoon03");
	disablenpc instance_npcname("Pope#3hmoon03");
	sleep2 2000;
	specialeffect EF_PRIMECHARGE4, AREA, instance_npcname("Pope#3hmoon05");
	disablenpc instance_npcname("Pope#3hmoon05");
	enablenpc instance_npcname("Pope#3hmoon06");
	next;
	mes "[" + strcharinfo(0) + "]";
	mes "你还好吗？";
	next;
	cutin "pop_nor", 2;
	mes "[Pope]";
	mes "我终于明白了……";
	next;
	mes "[Pope]";
	mes "人们爱着我。做到最好……就是做自己。";
	next;
	mes "[Pope]";
	mes "是时候从这个梦中醒来了。";
	next;
	mes "[" + strcharinfo(0) + "]";
	mes "你的梦怎么样？";
	next;
	mes "[Pope]";
	mes "很有趣，我永远不想忘记它。我很开心。不过这是个快乐的梦，也可能是可怕的噩梦。";
	next;
	cutin "pop_nor", 2;
	mes "[Pope]";
	mes "……不过能这样见到兄弟，我很开心。";
	next;
	mes "[Pope]";
	mes "已经过去很久了。";
	next;
	mes "[Pope]";
	mes "如果我能再次做这个梦，我想救我的兄弟。";
	npctalk "如果你能得到……", instance_npcname("Pope#3hmoon06");
	next;
	mes "[" + strcharinfo(0) + "]";
	mes "不过……";
	next;
	mes "[Pope]";
	mes "别担心，我不会永远沉睡。";
	next;
	mes "[Pope]";
	mes "我还……也许我会再次做这个梦。";
	next;
	cutin "pop_nor", 2;
	mes "[Pope]";
	mes "……以及兄弟陪在身边的梦……";
	next;
	mes "[" + strcharinfo(0) + "]";
	mes "我们会一起面对。";
	next;
	cutin "pop_nor", 2;
	mes "[Pope]";
	mes "谢……谢谢你。";
	next;
	cutin "pop_nor", 2;
	mes "[Pope]";
	mes "等待白昼中的半月。";
	next;
	mes "[" + strcharinfo(0) + "]";
	mes "对了，我找到了这个玩偶。";
	next;
	mes "[Pope]";
	mes "蒂莉比！";
	next;
	mes "[" + strcharinfo(0) + "]";
	mes "丢失的玩偶……对你有什么特别意义吗？";
	next;
	mes "[Pope]";
	mes "兄弟把玩偶给我，让它安慰我。";
	next;
	mes "[Pope]";
	mes "只要有兄弟，我就不再需要它。我不孤单。";
	next;
	mes "[Pope]";
	mes "我要回到属于我的地方。";
	next;
	mes "[" + strcharinfo(0) + "]";
	mes "那么，明天见。";
	next;
	mes "[Pope]";
	mes "谢谢你帮助我。";
	if (countitem(25087) > 0) {
		delitem 25087,1; //Old_Doll
		getexp 350000,350000;
		getitem 25088,2; //Dream_Piece
	}
	if ('progress == 18)
		'progress = 19;
	disablenpc instance_npcname("Pope#3hmoon06");
	instance_announce 0, "东边出现了出口。", bc_map, "0xFFFF00";
	enablenpc instance_npcname("#3hmoond01");
	cutin "pop_nor",255;
	navigateto( "1@pop3",79,67 );
	close3;
}

1@pop3,0,0,0	script	#mob3hmoon	139,{
OnStart:
OnMyMobDead:
	if (mobcount('map_pop3$, instance_npcname("#mob3hmoon") + "::OnMyMobDead") > 0)
		end;
	killmonsterall 'map_pop3$;
	if (!'mode) {
		.@ice = 3515; //Easy
		.@loo = 3516;
	} else {
		.@ice = 3523; //Hard
		.@loo = 3524;
	}
	switch( '3hmoon ) {
	case 0:
		monster 'map_pop3$,55,61,"Enraged Luwmin",.@loo,1, instance_npcname("#mob3hmoon") + "::OnMyMobDead";
		monster 'map_pop3$,50,62,"Frozen Heart",.@ice,1;
		monster 'map_pop3$,49,65,"Frozen Heart",.@ice,1;
		monster 'map_pop3$,60,62,"Frozen Heart",.@ice,1;
		monster 'map_pop3$,44,56,"Frozen Heart",.@ice,1;
		monster 'map_pop3$,42,60,"Frozen Heart",.@ice,1;
		monster 'map_pop3$,42,51,"Frozen Heart",.@ice,1;
		'3hmoon++;
		end;
	case 1:
		if (playerattached()) {
			.@merc = getmercinfo(8,getcharid(0));
			if (.@merc)
				unitkill .@merc;
		}
		if (countitem(25087) < 1) {
			instance_announce 0, "卢文出现时，传来了某物掉落的声音。", bc_map, "0xFFFF00";
			enablenpc instance_npcname("#dollbox03");
			sleep 1000;
		}
		instance_announce 0, "... Lonely... Alone... I hate this coldness...", bc_map, "0xFFFF00";
		if (!'mode) {
			if ('progress == 15)
				'progress = 18;	// (final)
			enablenpc instance_npcname("Pope#3hmoon02");
			enablenpc instance_npcname("Luwmin#3hmoon02");
			end;
		}
		sleep 1000;
		instance_announce 0, "总有一天你也会像我一样被抛弃！！", bc_map, "0xFFFF00";
		enablenpc instance_npcname("Ktullanux#3hmoon01");
		enablenpc instance_npcname("Pope#3hmoon04");
		if ('progress == 15)
			'progress = 16;
		'3hmoon++;
		end;
	case 2:
		monster 'map_pop3$,54,69,"Ktullanux",3526,1, instance_npcname("#mob3hmoon") + "::OnMyMobDead";
		monster 'map_pop3$,62,57,"Frozen Heart",.@ice,1;
		monster 'map_pop3$,49,62,"Frozen Heart",.@ice,1;
		monster 'map_pop3$,63,54,"Frozen Heart",.@ice,1;
		monster 'map_pop3$,59,51,"Frozen Heart",.@ice,1;
		monster 'map_pop3$,59,55,"Frozen Heart",.@ice,1;
		monster 'map_pop3$,53,61,"Frozen Heart",.@ice,1;
		monster 'map_pop3$,53,58,"Frozen Heart",.@ice,1;
		monster 'map_pop3$,48,61,"Frozen Heart",.@ice,1;
		monster 'map_pop3$,54,53,"Frozen Heart",.@ice,1;
		monster 'map_pop3$,44,68,"Frozen Heart",.@ice,1;
		monster 'map_pop3$,51,54,"Frozen Heart",.@ice,1;
		'3hmoon++;
		end;
	case 3:
		if (playerattached()) {
			.@merc = getmercinfo(8,getcharid(0));
			if (.@merc)
				unitkill .@merc;
		}
		instance_announce 0, "啊……竟然只是个凡人……！真是耻辱……！！！", bc_map, "0xFFFF00";
		enablenpc instance_npcname("Pope#3hmoon02");
		enablenpc instance_npcname("Luwmin#3hmoon02");
		if ('progress == 17)
			'progress = 18;
		end;
	}
}

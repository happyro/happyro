				mes "[Magumagu]";
				mes "我一直在想，";
				mes "“如果有这样的人，";
				mes "我会把自己掌握的全部厨艺传授给他。”";
				next;
				mes "[Magumagu]";
				mes "而且……";
				mes "你……";
				mes "你就是那个人。";
				next;
				mes "[Magumagu]";
				mes "我已经老了。没人知道我还能握这把刀多久。你被选中继承我的厨艺……";
				mes " ";
				next;
				delitem 950,100; //Heart_Of_Mermaid
				set ama_sushi,4;
				completequest 10041;
				getitem 1144,1; //Sasimi
				mes "[Magumagu]";
				mes "来，拿着我的刀。";
				mes "从今以后，用这把刀做出美味佳肴。";
				mes "……学会切鱼。";
				mes " ";
				mes " ";
				next;
				mes "[Magumagu]";
				mes "从今以后，我不会再拜托你并用鱼片作为回报……";
				mes "用那把刀磨炼技艺，把美食的乐趣传授给大陆人……";
				close;
			}
			else {
				mes "[Magumagu]";
				mes "哇……这是真正的人鱼之心。";
				mes "传说另一片大陆能找到它们，";
				mes "原来是真的……";
				mes " ";
				next;
				mes "[Magumagu]";
				mes "收集这些一定很辛苦……那么，";
				mes "今天我要用全部";
				mes "食材为你做一道特别料理！";
				next;
				mes "[Magumagu]";
				mes "请稍等……";
				mes "让我展示 ^0000FF真正的厨艺^000000。";
				next;
				delitem 950,20; //Heart_Of_Mermaid
				getitem 551,20; //Shusi
				mes "[Magumagu]";
				mes "先尝尝这些。";
				mes "用最新鲜的食材制作。";
				next;
				delitem 950,20; //Heart_Of_Mermaid
				getitem 544,20; //Fish_Slice
				mes "[Magumagu]";
				mes "这些也尝尝。";
				mes "本店鱼片是最好的！";
				next;
				delitem 950,20; //Heart_Of_Mermaid
				getitem 551,20; //Shusi
				mes "[Magumagu]";
				mes "再来一些。别说不要……！";
				mes "很好吃吧？嗯？很好吃吧？";
				next;
				delitem 950,20; //Heart_Of_Mermaid
				getitem 544,20; //Fish_Slice
				mes "[Magumagu]";
				mes "哈哈~！还没结束！";
				mes "没关系，再吃一些！";
				next;
				delitem 950,20; //Heart_Of_Mermaid
				getitem 544,10; //Fish_Slice
				getitem 551,10; //Shusi
				mes "[Magumagu]";
				mes "拿着剩下的。";
				mes "你看起来已经吃撑了……";
				mes "剩下的和朋友家人分享吧。";
				next;
				set ama_sushi,ama_sushi+1;
				set fish_r,0;
				erasequest 10041;
				mes "[Magumagu]";
				mes "今天非常感谢！哈哈！";
				mes "想帮忙时再回来。保重……！！！";
				close;
			}
		}
		mes "[Magumagu]";
		mes "哎呀，你没有准备";
		mes "我要求的东西……";
		mes "别忘了我说过的要求。";
		next;
		mes "[Magumagu]";
		mes "100 个 ^0000FF人鱼之心^000000，好吗？";
		mes "你没忘吧？";
		mes "请把材料带来。";
		close;
	}
	mes "[Magumagu]";
	mes "天哪~";
	mes "这下麻烦了……";
	mes "客人太多，我拿不到所有需要的食材……";
	next;
	mes "[Magumagu]";
	mes "太糟糕了……";
		mes "有些客人没机会";
		mes "品尝美味的天津料理……";
		mes " ";
	next;
	mes "[Magumagu]";
	mes "哎呀，你是客人吗？";
	mes "欢迎光临。本店一如既往";
	mes "非常重视鱼片的新鲜度。";
	mes "你来这里做什么……？";
	next;
	switch(select("我想买寿司:我想买鱼片:需要帮忙吗？:请继续努力")) {
	case 1:
		mes "[Magumagu]";
		mes "好的……！要多少？";
		mes "一套寿司 700 Zeny。";
		mes "只要一份寿司的话是 74 Zeny。";
		mes "想要更多就告诉我。";
		next;
		switch(select("700 Zeny 一套！:74 Zeny 一份！:我稍后再试")) {
		case 1:
			if (Zeny < 700) {
				mes "[Magumagu]";
				mes "哎呀，你的钱不够。";
				mes "想吃美味鱼片就多带些钱来。";
				close;
			}
			set Zeny, Zeny-700;
			getitem 551,10; //Shusi
			mes "[Magumagu]";
			mes "给你。如果喜欢这个味道，请再点一些。";
			close;
		case 2:
			if (Zeny < 74) {
				mes "[Magumagu]";
				mes "哎呀，你的钱不够。";
				mes "想吃美味寿司，";
				mes "就多带些钱来。";
				close;
			}
			set Zeny, Zeny-74;
			getitem 551,1; //Shusi
			mes "[Magumagu]";
			mes "给你。如果喜欢这个味道，请再点一些。";
			close;
		case 3:
			mes "[Magumagu]";
			mes "随你。我家的寿司";
			mes "是最好的！味道和新鲜度";
			mes "都是世界第一。";
			mes "有时间就尝尝我的寿司。";
			close;
		}
	case 2:
		mes "[Magumagu]";
		mes "好的……！要多少？";
		mes "一套鱼片 350 Zeny。";
		mes "一份鱼片 37 Zeny。";
		mes "想要更多就告诉我。";
		next;
		switch(select("350 Zeny 一套！:37 Zeny 一份！:我稍后再试")) {
		case 1:
			if (Zeny < 350) {
				mes "[Magumagu]";
				mes "哎呀，你的钱不够。";
				mes "想吃美味鱼片就多带些钱来。";
				close;
			}
			set Zeny, Zeny-350;
			getitem 544,10; //Fish_Slice
			mes "[Magumagu]";
			mes "给你。如果喜欢这个味道，请再点一些。";
			close;
		case 2:
			if (Zeny < 37) {
				mes "[Magumagu]";
				mes "哎呀，你的钱不够。";
				mes "想吃美味鱼片就多带些钱来。";
				close;
			}
			set Zeny, Zeny-37;
			getitem 544,1; //Fish_Slice
			mes "[Magumagu]";
			mes "给你。如果喜欢这个味道，请再点一些。";
			close;
		case 3:
			mes "[Magumagu]";
			mes "随你。我家的鱼片";
			mes "是最好的！味道和新鲜度";
			mes "都是世界第一。";
			mes "有时间就尝尝我的鱼片。";
			close;
		}
	case 3:
		if (BaseJob == Job_Novice) {
			mes "[Magumagu]";
			mes "哈哈~需要帮助的是你！";
			mes "先照顾好自己";
			mes "再去帮助别人吧。";
			mes " ";
			close;
		}
		else {
			mes "[Magumagu]";
			mes "如果能帮忙就太好了~！！";
			mes "我们总是用光食材，";
			mes "我一直很担心……";
			mes "能帮我一个忙吗？";
			mes "我会给你报酬。";
			next;
			set .@fish_m1,rand(1,10);
			if (.@fish_m1 == 1 || .@fish_m1 == 2) {
				set fish_r,1;
				setquest 10036;
				mes "[Magumagu]";
				mes "我需要一些糖果";
				mes "给客人制作甜点。";
				mes "带给我 ^0000FF10 颗糖果^000000。";
				mes "不难吧？";
				mes " ";
			}
			else if (.@fish_m1 == 3 || .@fish_m1 == 4) {
				set fish_r,2;
				setquest 10037;
				mes "[Magumagu]";
				mes "我需要一些螃蟹壳";
				mes "为料理制作酱汁……";
				mes "带给我 ^0000FF10 个螃蟹壳^000000，";
				mes "我会给你报酬。";
				mes "好吗？";
			}
			else if (.@fish_m1 == 5 || .@fish_m1 == 6) {
				set fish_r,3;
				setquest 10038;
				mes "[Magumagu]";
				mes "我的海螺用完了。";
				mes "我需要它制作开胃菜……";
				mes "请带给我 ^0000FF10 个海螺^000000。";
				mes "这里很难找到海螺……";
				mes "请帮我这个忙。";
			}
			else if (.@fish_m1 == 7 || .@fish_m1 == 8) {
				set fish_r,4;
				setquest 10039;
				mes "[Magumagu]";
				mes "装饰用鱼尾缺货了。";
				mes "这很紧急……";
				mes "请带给我 ^0000FF10 条鱼尾^000000。";
				mes "每当急需时它们总是不够……";
				mes "请帮我这个忙。";
			}
			else if (.@fish_m1 == 9) {
				set fish_r,5;
				setquest 10040;
				mes "[Magumagu]";
				mes "我们缺少盛放鱼片的盘子。";
				mes "这太糟糕了……";
				mes "你能买些精美的 ^0000FF瓷器^000000 给我吗？";
				mes "我不能随便把食物放在哪里……";
			}
			else {
				if (rand(1,10) == 1) {
					set fish_r,6;
					setquest 10041;
					mes "[Magumagu]";
					mes "别问为什么……";
					mes "但我需要一些特别的东西……";
					mes "^0000FF100 个人鱼之心^000000……";
					mes "听起来不可思议，但对我真的很重要……";
					next;
					mes "[Magumagu]";
					mes "别问我的要求";
					mes "是什么……";
					mes "记住我想要的东西就好。";
				}
				else {
					set fish_r,5;
					setquest 10040;
					mes "[Magumagu]";
					mes "我们缺少盛放鱼片的盘子。";
					mes "这太糟糕了……";
					mes "你能买些精美的 ^0000FF瓷器^000000 给我吗？";
					mes "我不能随便把食物放在哪里……";
				}
			}
			next;
			mes "[Magumagu]";
			mes "那么，祝你好运……";
			mes "我会等着你。";
			mes "别忘了我的要求……";
			close;
		}
	case 4:
		mes "[Magumagu]";
		mes "哈哈，尝过我家的鱼片后，你不会忘记它的味道。";
		mes "有时间就再来尝尝吧。";
		mes " ";
		close;
	}
}

// Dungeon Quest :: japan_mono
//============================================================ 
amatsu,112,164,4	script	Gate Soldier#ama1	767,{
	mes "[Gate Soldier]";
	mes "这里是宏伟的宫殿，";
	mes "东宫城。";
	mes "当地居民禁止";
	mes "进入……";
	next;
	mes "[Gate Soldier]";
	mes "你的服装看起来很陌生。";
	mes "你来自其他大陆吗？";
	mes "领主允许游客进入，";
	mes "所以你可以进去。";
	mes " ";
	close;
}
	
amatsu,119,164,4	script	Gate Soldier#ama2	767,{
	mes "[Gate Soldier]";
	mes "你来自米德加尔特吗？";
	mes "欢迎来到天津。";
	mes "进去后请到春苏阁";
	mes "拜访我们的领主。";
	mes " ";
	next;
	mes "[Gate Soldier]";
	mes "他非常亲切。";
	mes "他投资天津的各个领域，";
	mes "大陆间贸易也是他的主意。";
	close;
}
	
ama_in02,207,40,6	script	Gate Soldier#ama3	767,{
	mes "[Gate Soldier]";
	mes "欢迎。宫殿领主";
	mes "特许其他大陆的客人";
	mes "进入这里。";
	next;
	mes "[Gate Soldier]";
	mes "请随意参观，不必着急。";
	mes "祝你在这里过得愉快。";
	close;
}
	
ama_in02,207,49,6	script	Gate Soldier#ama4	767,{
	mes "[Gate Soldier]";
	mes "领主真是个好人。";
	mes "谁能想到我们的城镇";
	mes "曾经只是个小村庄？";
	next;
	mes "[Gate Soldier]";
	mes "我很感谢他雇用我。";
	mes "最近他似乎";
	mes "有些烦恼。";
	mes "近来看起来相当忧郁。";
	mes " ";
	close;
}
	
amatsu,164,174,4	script	Gate Soldier#ama5	767,{
	mes "[Gate Soldier]";
	if (event_amatsu == 0) {
		mes "你不能进入这里。";
		mes "领主的母亲正在休息，她需要安静。";
		next;
		set event_amatsu,1;
		setquest 8131;
		mes "[Gate Soldier]";
		mes "她已经病了几个月。";
		mes "所以一直住在这里。";
		mes "这是一种相当可怕的疾病……";
	}
	else if (event_amatsu == 1) {
		mes "她应该会恢复健康……";
		mes "但领主仍然非常担心。";
		mes " ";
	}
	else if (event_amatsu == 5) {
		mes "啊！那巨大的声音吓了我一跳。";
		mes "发生什么了？嗯？";
		mes " ";
	}
	else if (event_amatsu == 6) {
		mes "领主的母亲还没有";
		mes "完全恢复健康。";
		mes "不过已经比以前好多了。";
		mes " ";
	}
	else {
		mes "如果是领主派你来的，";
		mes "可以进入……";
		mes "但你无法治好她。";
		mes "很多人都尝试过并失败了。";
	}
	close;
}
	
amatsu,171,174,4	script	Gate Soldier#ama6	767,{
	mes "[Gate Soldier]";
	if (event_amatsu == 0) {
		mes "你不能进入这里。";
		mes "领主的母亲正在这里休息。";
		mes " ";
		next;
		setquest 8131;
		set event_amatsu,1;
		mes "[Gate Soldier]";
		mes "她已经病了几个月。";
		mes "所以一直住在这里。";
		mes "...";
	}
	else if (event_amatsu == 1) {
		mes "请保持安静。";
		mes "领主的母亲住在这里，需要休息。";
		next;
		mes "[Gate Soldier]";
		mes "为什么会发生这种事";
		mes "在我亲切的领主身上……";
		mes "怎么会这样？*抽泣*……";
	}
	else if (event_amatsu == 5) {
		mes "咦？有什么东西在";
		mes "天空中飞过……你没看到？唉。";
		mes "那声音吓到我了。";
	}
	else if (event_amatsu == 6) {
		mes "现在领主放心了。";
		mes "我们之前一直非常担心。";
		mes "现在没事了……*抽泣*。";
	}
	else {
		mes "天哪。其他大陆来的人";
		mes "全都是医生！";
		mes "到底来了多少医生？！我都数不清了！";
	}
	close;
}
	
ama_in02,187,57,2	script	Soldier#ama1	767,{
	mes "[Ichiro]";
	mes "欢迎。";
	mes "我们的领主为你这样的旅人";
	mes "准备了客房。";
	next;
	mes "[Ichiro]";
	mes "如果遇到任何问题，";
	mes "请告诉我。也请和宫殿领主谈谈，";
	mes "这一切都是他提供的。";
	close;
}
	
ama_in02,170,62,4	script	Soldier#ama2	767,{
	mes "[Jiro]";
	mes "我是 Jiro，这座宫殿的管理员。";
	mes "有什么可以帮你？";
	next;
	switch(select("给我签发通行证:我想住在天津:没什么")) {
	case 1:
		if (event_amatsu == 6) {
			if (countitem(7160) > 0) {
				mes "[Jiro]";
			mes "你已经有一张了……";
			mes "不需要两张。";
				close;
			}
			mes "[Jiro]";
			mes "你把通行证弄丢了吗？";
			mes "需要缴纳 10,000 Zeny 税款";
			mes "才能补发通行证。";
			next;
			if (select("补发一张:稍后再聊") == 1) {
				set Zeny, Zeny-10000;
				getitem 7160,1; //Lord's_Passable_Ticket
				mes "[Jiro]";
				mes "给你。";
				mes "这次别再弄丢了。";
				close;
			}
			mes "[Jiro]";
			mes "好吧……";
			mes "需要帮助时再来找我。";
			close;
		}
		mes "[Gate Soldier]";
		mes "领主宣布";
		mes "允许来自米德加尔特的客人自由通行。";
		mes "你不需要我签发通行证。";
		close;
	case 2:
		mes "[Jiro]";
		mes "那是不可能的。你可以";
		mes "在天津自由行动，但领主不想处理移民事务。";
		mes "不过你可以随意留在这里。";
//

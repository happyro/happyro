		mes "Umbah woomumum!";
		mes "Umbah woomum umbabah!";
		close;
	}
	if (um_wind <= 3 && (MISC_QUEST & 32768) == 0) {
		if (um_wind == 0) set um_wind,1;
		emotion ET_FRET;
		mes "[Phrenetan]";
		mes "Umbaumbah wooga wooga";
		mes "Umbaumbabah babababah!";
		mes "Umbaum!";
		next;
		emotion ET_O;
		mes "[Phrenetan]";
		mes "Umbah umbaumba umbah";
		mes "Umbabababah wooga woo!";
		mes "Wooga wooga umbabah umbaum!";
		next;
		emotion ET_GO;
		close;
	}
	else if (um_wind == 6 || (MISC_QUEST & 32768)) {
		emotion ET_FRET;
		mes "[Phrenetan]";
		mes "Umbabah! Umbaumbah.....";
		mes "Umbaum Umbaum Wooga wooga!";
		mes "Wooga umumum woombababap!!!!!";
		next;
		emotion ET_SWEAT;
		close;
	}
	end;
}

um_in,144,45,5	script	Umpokoriohtan	789,{
	if (event_umbala >= 3) {
		if(rand(1,3) == 2) {
			mes "[Umpokoriohtan]";
			mes "嘿，酷家伙。";
			mes "别在意我老婆……";
			mes "虽然我很爱她，";
			mes "但我知道自己的责任，懂吗？";
			next;
			mes "[Umpokoriohtan]";
			mes "男人如果拥有很多，";
			mes "就应该与那些";
			mes "一无所有的人分享。";
			next;
			mes "[Umpokoriohtan]";
			mes "如果男人的双手擅长";
			mes "治疗，就应该用双手";
			mes "帮助人们活下去。";
			next;
			mes "[Umpokoriohtan]";
			mes "如果男人的嘴唇擅长";
			mes "歌唱，就应该唱出";
			mes "我们喜欢听的歌。";
			next;
			mes "[Umpokoriohtan]";
			mes "但如果甜蜜的爱是黄金，";
			mes "那么宝贝……我就有点金之手。";
			next;
			mes "[Umpokoriohtan]";
			mes "哦……！";
			mes "...........";
			mes "我的背——！";
			mes "冷静点，宝贝，马上就轮到你了～";
			emotion ET_ROCK, getnpcid(0, "Phrenetan");
			emotion ET_SWEAT;
			close;
		}
		else {
			mes "[Umpokoriohtan]";
			mes "唉……有时我老婆";
			mes "可能有点太粗暴，甚至";
			mes "会伤人。不过没关系……";
			mes "这只说明她很有活力。";
			next;
			mes "[Umpokoriohtan]";
			mes "但总有一天，她必须";
			mes "明白我得把这颗心";
			mes "分给那些真正需要";
			mes "爱情维生素的女士们，";
			mes "懂吗？这是我的责任。";
			next;
			mes "[Umpokoriohtan]";
			mes "韦娜坦、贝尔茨坦、查比玛坦……";
			mes "那些漂亮姑娘已经等了";
			mes "太——久了。别担心，";
			mes "大爸爸很快就来。";
			next;
			mes "[Umpokoriohtan]";
			mes "哦哦哦～！弗雷内坦！";
			mes "宝贝，你为什么这么粗暴？";
			mes "轻轻打我，懂吗？？";
			mes "我不是想伤害你～";
			emotion ET_HUK, getnpcid(0, "Phrenetan");
			emotion ET_KEK;
			close;
		}
	}
	emotion ET_SMILE;
	mes "[Umpokoriohtan]";
	mes "Umbaumbah...........";
	mes "Umbahwooga woogawoo!";
	mes "Umbah umumbabah umbawoo gaga.";
	next;
	emotion ET_FRET;
	close;

OnInit:
	disablenpc "Umpokoriohtan";
	end;
}


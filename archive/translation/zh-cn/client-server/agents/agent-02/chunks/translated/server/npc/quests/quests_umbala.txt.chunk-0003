umbala,94,181,0	script	#unpc	-1,1,1,{
OnInit:
	disablenpc "#unpc";
	end;

OnTouch_:
	if (um_wind == 5) {
		mes "^3355FF被踢出屋子后，";
		mes "你意识到发生了什么，";
		mes "并看到站立处附近的地面上";
		mes "有一片叶子。^000000";
		next;
		if (select("拿走。:留下。") == 1) {
			close2;
			set um_wind,0;
			set MISC_QUEST,MISC_QUEST | 32768;
			getitem 610,1; //Leaf_Of_Yggdrasil
			disablenpc "#unpc";
			end;
		}
		set um_wind,0;
		set MISC_QUEST,MISC_QUEST | 32768;
		mes "[" + strcharinfo(0) + "]";
		mes "我不应该拿走";
		mes "可能属于别人的东西。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "没错，我真是个好人。";
		close2;
		disablenpc "#unpc";
	}
	end;
}

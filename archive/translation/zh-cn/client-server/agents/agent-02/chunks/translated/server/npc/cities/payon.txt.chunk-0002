		mes "[弓箭手扎克]";
		mes "我们的首领住在中央宫殿。可以说，他是斐扬的精神向导。";
		next;
		mes "[弓箭手扎克]";
		mes "他过去常带着角弓威慑斐扬森林里的怪物。我还记得自己小时候看他战斗的样子。";
		next;
		mes "[弓箭手扎克]";
		mes "但现在他";
		mes "看起来又老又虚弱。";
		mes "不过他的眼神依旧像战斗时期那样锐利，";
		mes "那时他从来不会";
		mes "射偏目标。";
		next;
		mes "[弓箭手扎克]";
		mes "我从心底";
		mes "敬仰我们的首领。";
		mes "这份敬意发自内心。";
		break;
	case 3:
		mes "[弓箭手扎克]";
		mes "你不知道";
		mes "‘话痨’是什么意思……？";
		next;
		mes "[弓箭手扎克]";
		mes "话痨";
		mes "名词。指对无关紧要的事";
		mes "喋喋不休、根本不知道何时停下的傻瓜。";
		next;
		mes "[弓箭手扎克]";
		mes "没错，我那位朋友不仅";
		mes "是射术传奇，还因那张嘴能说多久而远近闻名。";
		next;
		mes "[弓箭手扎克]";
		mes "总之，我的朋友沃尔特没有";
		mes "自己的住处，所以住在旅馆。你不妨去见见他？只要能忍受他的唠叨，他其实是个不错的人。";
		break;
	}
	close;
}

payon_in01,47,59,2	script	Archer Wolt#payon	88,{
	mes "[弓箭手沃尔特]";
	mes "弓箭手应该";
	mes "尽可能多地练习。";
	mes "每天都不能松懈，";
	mes "否则，永远成不了高手。";
	next;
	mes "[弓箭手沃尔特]";
	mes "哦，嗨！";
	mes "我是弓箭手沃尔特，";
	mes "呃，你可以";
	mes "直接叫我‘沃尔特’。";
	next;
	mes "[弓箭手沃尔特]";
	mes "我知道这个问题有点突然，不过你是不是经常把很多时间";
	mes "花在无所事事上？";
	next;
	switch(select("当然不会。:嗯，我想是吧……")) {
	case 1:
		mes "[弓箭手沃尔特]";
		mes "哦，这很好。事实上，太棒了！要是所有弓箭手都有这种态度就好了。有时间坐着发呆，就有时间出去练习！";
		next;
		mes "[弓箭手沃尔特]";
		mes "是啊……";
		mes "我们弓箭手多少会看不起";
		mes "训练时偷懒";
		mes "的人。";
		next;
		mes "[弓箭手沃尔特]";
		mes "如果不努力，你最后会成为糟糕的弓箭手。没人能指望你的准头！";
		mes "我是说，一个人都不能！";
		next;
		mes "[弓箭手沃尔特]";
		mes "你问我们如何进行";
		mes "训练？斐扬的弓箭手没多少时间拿弓玩耍。";
		mes "我们会走出去，";
		mes "参加真正的战斗。";
		next;
		mes "[弓箭手沃尔特]";
		mes "所以我们无论去哪都带着弓，整天寻找可以猎杀的怪物。哦，找到怪物之后当然要";
		mes "杀掉它们。这不是显而易见吗。";
		next;
		if (select("I guess you'd need a good Bow. :You call that 'practice?!'") == 1) {
			mes "[弓箭手沃尔特]";
			mes "没错！";
			mes "弓箭手依靠";
			mes "弓的";
			mes "力量！";
			next;
			mes "[弓箭手沃尔特]";
			mes "斐扬制作的弓";
			mes "是这片大陆上最棒的！它们轻巧坚固，由斐扬森林的优质树干制成！";
			next;
			mes "[弓箭手沃尔特]";
			mes "木材的品质往往决定弓的品质。我的小宝贝由胡桃树制成，坚固到足以承受数千磅";
			mes "的力量。";
			next;
			mes "[弓箭手沃尔特]";
			mes "哦，哦！我的弓也很时髦。它是精致的乌木色，我用它猎杀怪物时看起来既酷又英勇～！";
			next;
			mes "[弓箭手沃尔特]";
			mes "哦，斐扬森林的树木还以木材品质闻名。不过越来越多的树变成了怪物。这是邪恶势力所为吗？！";
			next;
			mes "[弓箭手沃尔特]";
			mes "真可惜，因为树木怪物原本都是美丽雄伟的树。但为了用它们的木材制作弓，杀掉它们也没关系。";
			next;
			mes "[弓箭手沃尔特]";
			mes "然后我们用这些弓杀掉更多树木怪物……再制作更多木材！呜哈哈哈哈！这就是无尽的循环！";
			next;
			select("^666666*咳咳！*^000000 说到无尽……");
			mes "[弓箭手沃尔特]";
			mes "是啊……";
			mes "你说得对。";
			mes "怪物到处都是，";
			mes "你能相信吗？";
			next;
			mes "[弓箭手沃尔特]";
			mes "你明白";
			mes "弓箭手村";
			mes "为什么建在那里吗？";
			next;
			mes "[弓箭手沃尔特]";
			mes "向西走，在弓箭手村附近就能看到斐扬洞窟。洞窟里不断涌出大量怪物，完全没有减缓的迹象。";
			next;
			mes "[弓箭手沃尔特]";
			mes "我们弓箭手奉尊敬的首领之命守护领地，抵御它们！";
			next;
			switch(select("你说洞窟？:首领……？:天啊，我讨厌这座城镇！")) {
			case 1:
				mes "[弓箭手沃尔特]";
				mes "从城镇向北走";
				mes "就能找到";
				mes "斐扬洞窟。";
				next;
				mes "[弓箭手沃尔特]";
				mes "进去后会遇到各种丑陋的怪物，比如那些难看的蝙蝠，还有";
				mes "那些僵尸……";
				next;
				mes "[弓箭手沃尔特]";
				mes "要是放它们离开那里，它们会跑遍斐扬！所以我们得进去清理怪物。";
				next;
				mes "[弓箭手沃尔特]";
				mes "可是这些怪物会不断重生，有时我觉得我们只是在白白浪费时间和精力……";
				next;
				mes "[弓箭手沃尔特]";
				mes "哇……";
				mes "好了，我的嘴好像又跑了";
				mes "一场马拉松。你先走吧。我还有很多训练要做，也有很多怪物要杀！";
				break;
			case 2:
				mes "[弓箭手沃尔特]";
				mes "我们的首领？啊，他是个非常棒的人。不过，他总是因为我太爱说话而训斥我。";
				next;
				mes "[弓箭手沃尔特]";
				mes "他总是努力确保";
				mes "斐扬免受伤害。最近他一直不出宫殿，我有些担心。这可能不是好兆头。";
				next;
				mes "[弓箭手沃尔特]";
				mes "究竟是什么的坏兆头，我也不确定。可能是斐扬出了问题，也可能他有必须亲自处理的事。不管怎样，他房间里总是有守卫，不知为何。";
				next;
				mes "[弓箭手沃尔特]";
				mes "嘿嘿嘿～";
				mes "如果他知道我把他的事告诉外人";
				mes "太多，我就要惹麻烦了。算了！已经晚了。我都告诉你了！后悔也没用！";
				next;
				mes "[弓箭手沃尔特]";
				mes "但是……";
				mes "我现在闭嘴还不算晚。闭紧。现在不说话。安静得像老鼠。回见～！";
				break;
			}
			close;
		}
		mes "[弓箭手沃尔特]";
		mes "嗯……？";
		mes "你不是吗？";
		mes "还有什么比真正的、";
		mes "实打实的战斗";
		mes "更好的练习呢？";
		next;
		mes "[弓箭手沃尔特]";
		mes "不过你说得也有道理。";
		mes "我是说，练习时应该不必承受严重后果。";
		mes "比如死亡。";
		next;
		mes "[弓箭手沃尔特]";
		mes "但我们只能利用";
		mes "手头拥有的一切！";
		mes "弓箭手的一生就是";
		mes "无尽的训练！";
		mes "无尽的练习！";
		next;
		mes "[弓箭手沃尔特]";
		mes "嗯……？";
		mes "你是不是听腻了我一遍遍重复同样的话？";
		mes "忍耐一下吧，就当是在练习耐心～";
		break;
	case 2:
		mes "[弓箭手沃尔特]";
		mes "呃……";
		mes "我想抽时间休息";
		mes "也很重要。";
		next;
		mes "[弓箭手沃尔特]";
		mes "不过也要抽时间练习和训练，再练习、再训练！";
		next;
		mes "[弓箭手沃尔特]";
		mes "该保持警觉时休息，或者该做别的事时休息，都是非常糟糕的主意。";
		next;
		mes "[弓箭手沃尔特]";
		mes "这让我想起有一次";
		mes "我在节日期间把房子点着了。当然是意外，但我的父母可气坏了！";
		next;
		mes "[弓箭手沃尔特]";
		mes "哈哈哈哈～";
		mes "事情始于我决定洗澡。在斐扬，我们使用老式浴池，需要生火烧水。洗冷水澡实在太难受了。";
		next;
		mes "[弓箭手沃尔特]";
		mes "但舒服的热水澡非常惬意。那大概是我这辈子洗过最棒的澡！太舒服了，我睡着了。";
		next;
		mes "[弓箭手沃尔特]";
		mes "可我睡着时，";
		mes "大概没注意到火烧到了地板、墙和天花板！幸好我在装满水的浴池里，所以没事。";
		next;
		mes "[弓箭手沃尔特]";
		mes "要不是火在我打盹时烧掉了衣服，我本来可以求救。当然，我不能赤身裸体在城里乱跑。";
		next;
		mes "[弓箭手沃尔特]";
		mes "所以……";
		mes "我只好全裸坐在水里大约一小时，一直喊‘救命’，直到有人听见。";
		next;
		mes "[弓箭手沃尔特]";
		mes "但结果没人听见。幸好屋顶塌下来，把墙也彻底撞毁，我的喊声终于传到了路人耳中。就这样我活了下来。";
		next;
		switch(select("呃，这个故事的重点是什么？:看来我最好别偷懒了。: blah blah。回见。")) {
		case 1:
			mes "[弓箭手沃尔特]";
			mes "哦……";
			mes "呃……";
			mes "你的意思是，";
			mes "这个故事的寓意？";
			next;
			mes "[弓箭手沃尔特]";
			mes "在合适的时候休息完全没问题。只要别在不该休息时偷懒。那种行为会让城里所有人都生气！";
			next;
			mes "[弓箭手沃尔特]";
			mes "我们的首领尤其讨厌这种不负责任的态度。我想在这里，只有镇上的酒鬼奉行这种做法。";
			next;
			switch(select("首领？:镇上的酒鬼？:天啊，你太爱说话了！")) {
			case 1:
				mes "[弓箭手沃尔特]";
				mes "我们的首领？啊，他是个非常棒的人。不过，他总是因为我太爱说话而训斥我。";
				next;
				mes "[弓箭手沃尔特]";
				mes "他总是努力确保";
				mes "斐扬免受伤害。最近他一直不出宫殿，我有些担心。这可能不是好兆头……";
				next;
				mes "[弓箭手沃尔特]";
				mes "究竟是什么的坏兆头，我也不确定。可能是斐扬出了问题，也可能他有必须亲自处理的事。不管怎样，他房间里总是有守卫，不知为何。";
				next;
				mes "[弓箭手沃尔特]";
				mes "嘿嘿嘿～";
				mes "如果他知道我把他的事告诉外人";
				mes "太多，我就要惹麻烦了。算了！已经晚了。我都告诉你了！后悔也没用！";
				next;
				mes "[弓箭手沃尔特]";
				mes "但是……";
				mes "我现在闭嘴还不算晚。完全安静。我连嘴都不张。就从现在……开始！";
				mes "回见～！";
				break;
			case 2:
				mes "[弓箭手沃尔特]";
				mes "你知道……";
				mes "酒馆里的那个人。";
				mes "声音大，讨厌，";
				mes "听起来烦——";
				next;
				mes "[弓箭手沃尔特]";
				mes "嗯……？";
				mes "你那是什么表情？";
				mes "总之，我有";
				mes "闲钱时会尽量";
				mes "请他喝酒。";
				next;
				mes "[弓箭手沃尔特]";
				mes "不过……";
				mes "喝那么多酒";
				mes "可不是什么好主意。";
				mes "至少不该像他那样……";
				break;
			case 3:
				mes "[弓箭手沃尔特]";
				mes "...!";
				next;
				mes "[弓箭手沃尔特]";
				mes "……";
				mes "我……";
				mes "但、但是……！";
				break;
			}
			break;
		case 2:
				mes "[弓箭手沃尔特]";
				mes "哦，太好了～！";
				mes "看来你明白";
				mes "我故事的重点了！";
			next;
			mes "[弓箭手沃尔特]";
			mes "我们弓箭手非常重视训练和练习，所以多少会看不起";
			mes "完全不";
			mes "勤奋的人。";
			next;
			mes "[弓箭手沃尔特]";
			mes "不过……";
			mes "我得承认，我骨子里";
			mes "是个挺懒的人。像我这样的人";
			mes "居然能当上弓箭手，真是奇迹！";
			next;
			mes "[弓箭手沃尔特]";
			mes "总之，";
			mes "无论你一生做什么，";
			mes "都要";
			mes "满怀热情！";
			break;
		case 3:
			break;
		}
	}
	close;
}

payon_in03,99,190,4	script	Chief#payon	107,2,2,{
	end;

OnTouch_:
	if (BaseLevel < 30) {
		mes "[守卫]";
		mes "喂……";
		mes "喂……！";
		mes "对我们的首领";
		mes "放尊重点！";
		mes "这里不是可以胡闹的地方。";
		close;
	}
	if (BaseLevel > 30) {
		set .@oldman_random,rand(1,2);
		if (.@oldman_random == 1) {
			mes "[守卫]";
			mes "喂……";
			mes "喂……！";
			mes "对我们的首领";
			mes "放尊重点！";
			next;
			mes "[守卫]";
			mes "喂——！";
			mes "我说……";
			next;
			mes "[首领]";
			mes "没关系，没关系。";
			mes "我已经很久";
			mes "没和这么年轻的人";
			mes "交谈了。";
			next;
		}
		switch(select("请告诉我斐扬的事。:守卫来自哪里？:请告诉我洞窟的事。:弓箭手做什么？:猎人做什么？")) {
		case 1:
			mes "[首领]";
			mes "斐扬是高地人的城市。就历史所知，我们的城市一直都能自给自足。";
			next;
			mes "[首领]";
			mes "我们的祖先不像今天这样享有与卢恩·米德加尔兹王国文化交流的好处，但他们知道如何不依靠";
			mes "任何帮助生存下去。";
			next;
			mes "[首领]";
			mes "斐扬发展出了自己的文化和生活方式。我们发明了抵御自然环境的方法，斐扬的男女则训练成为弓箭手和猎人来保护自己。";
			next;
			mes "[首领]";
			mes "我听说有些软弱胆怯的";
			mes "年轻人害怕充满怪物的原野或地下城。但对我们而言，战斗就是生活方式。";
			next;
			mes "[首领]";
			mes "因此，特里斯坦三世陛下希望我们训练年轻人，让他们学会有效对抗邪恶生物。";
			break;
		case 2:
			mes "[首领]";
			mes "从我年轻时起，";
			mes "普隆德拉就不断派遣文职";
			mes "人员和使者来到斐扬。";
			next;
			mes "[首领]";
			mes "王国军队、卡普拉小姐、守卫……起初，我们的习俗";
			mes "和文化差异带来了冲突。";
			next;
			mes "[首领]";
			mes "不过随着时间推移，";
			mes "我们解决了这些小分歧。不可否认，他们帮助我们迅速发展了对外贸易。";
			next;
			mes "[首领]";
			mes "如今，曾经的外来者已经成为正式的斐扬居民。我年轻时从没想过会有这样的事。哈哈哈哈～！";
			next;
			mes "[首领]";
			mes "看到并与他们见面让我很高兴。虽然他们来自其他地方，但对斐扬的热爱和我一样真诚。";
			break;
		case 3:
			mes "[首领]";
			mes "啊……";
			mes "我以前偶尔会去";
			mes "北边的洞窟。但现在";
			mes "比那时难多了。";
			next;
			mes "[首领]";
			mes "那里不断重生着我从未见过的邪恶生物。如今斐扬洞窟里的怪物，和我们过去战斗的已不一样。";
			next;
			mes "[首领]";
			mes "你有没有见过";
			mes "僵尸……？其中一些是为了保护村庄进入洞窟、却再也没回来的战士。";
			next;
			mes "[首领]";
			mes "虽然它们构成威胁，但有些不死族也是洞窟的受害者。我年纪太大，承受不了那种痛苦……";
			next;
			mes "[首领]";
			mes "我必须尽力阻止不死族，将他们的灵魂从永恒的痛苦中解放出来。";
			break;
		case 4:
			mes "[首领]";
			mes "啊，幸好射术是斐扬的特长。由于四周有森林，我们有充足的木材制作弓。";
			next;
			mes "[首领]";
			mes "森林也是弓箭手学习利用环境的好地方：在安全距离攻击敌人的同时阻碍他们前进。";
			next;
			mes "[首领]";
			mes "森林有时也会以意想不到的方式提供便利。我年轻时在树林里和怪物战斗用光了箭，其他怪物掉落的箭却救了我的命！呜哈哈！";
			break;
		case 5:
			mes "[首领]";
			mes "随着外来文化传入斐扬，我们的战斗方式也发生了变化。";
			next;
			mes "[首领]";
			mes "技术，尤其是爆炸物技术，带来了新的";
			mes "战斗方法。我们不再局限于使用弓箭。";
			next;
			mes "[首领]";
			mes "让";
			mes "狩猎怪物变得容易许多的陷阱技能在斐扬得到发展。前任首领将掌握新技能的专家称为‘猎人’。";
			next;
			mes "[首领]";
			mes "陷阱虽然非常有效，使用不当却十分危险。因此我们不赞成没有经验的人成为猎人。";
			next;
			mes "[首领]";
			mes "不过，我们欢迎那些";
			mes "证明自己有能力接受猎人职业挑战的人。";
			break;
		}
		next;
		mes "[首领]";
		mes "真累……";
		mes "我最好休息一下。";
		mes "请照顾好";
		mes "自己。";
		close;

		//This actually never happens on iRO
		//if (.@oldman_random == 2) {
		//	mes "[Guard]";
		//	mes "The Chief is";
		//	mes "taking a rest.";
		//	mes "Would you mind";
		//	mes "coming back later?";
		//}
	}
	end;
}

payon_in03,102,185,5	script	Guard#payon	708,{
	if (BaseLevel < 30) {
		mes "[守卫]";
		mes "喂……！";
		mes "这里不";
		mes "准进入！";
		mes "回外面去！";
		close;
	}
	if (BaseLevel > 30) {
		mes "[守卫]";
		mes "抱歉，";
		mes "但你";
		mes "不能进入这里。";
		mes "请离开。";
		close;
	}
	end;
}


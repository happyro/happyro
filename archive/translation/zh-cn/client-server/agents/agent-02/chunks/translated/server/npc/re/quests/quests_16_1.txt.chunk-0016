		next;
		cutin "16mye_ang",1;
		mes "[Myer]";
	mes "你什么都不做，我也什么都不做。我希望能像^0000cd乔纳森^000000一样，在后街幸福地生活。";
		next;
		mes "[Myer]";
	mes "但你却和维格纳一起把杀人武器开发成新的商品。";
		next;
		mes "[Myer]";
	mes "连你的家人都不信任你，别人怎么能信任你？我无法信任你！而且我说过别再把我当孩子！";
		next;
		cutin "",255;
		mes "[Maximilian]";
	mes "你们两个，";
		next;
		cutin "16agn_ang",2;
		mes "[Agnes]";
	mes "住手！你们到底在争什么？难道我们不都想比任何人都幸福地生活吗？";
		next;
		mes "[Agnes]";
	mes "所以，每个人都在用自己的方式追求幸福。赫尔穆特在前线找到了幸福，沃尔夫在金钱中找到了，而迈尔在街头找到了。";
		next;
		mes "[Agnes]";
	mes "这样还不够吗？你们还需要更大的东西？事业？复仇？战争？";
	mes "这个家族里的每个人都在争斗，也在失去重要的东西。你们还想要战争吗？";
		next;
		mes "[Agnes]";
	mes "我们真正想要的是什么？如果争斗能让我们幸福，那当然好！但事实并非如此。我们已经争斗太久了。";
		next;
		mes "[Agnes]";
	mes "你们所有人，赫尔穆特、沃尔夫和迈尔。";
		next;
		cutin "",255;
		mes "[Maximilian]";
	mes "大家冷静下来。提高嗓门并不好。";
		next;
		cutin "16hel",0;
		mes "[Helmut]";
	mes "艾格尼丝说得对。你们两个别再争了。";
		next;
		cutin "16mye_nor",1;
		mes "[Myer]";
	mes "……失陪了。";
		next;
		cloakonnpcself( "Myer Roegenburg#ep16lug" );
		cutin "16agn_ang",2;
		mes "[Agnes]";
	mes "迈尔！你要去哪里？你又要离开家族吗？";
		next;
		cutin "",255;
		mes "[Maximilian]";
	mes "你觉得呢？我完全同意艾格尼丝。我认为我们互相争斗太久了。";
		next;
		mes "[Maximilian]";
	mes "但我们必须记住，复仇只会换来复仇，暴力只会换来暴力。";
		next;
		mes "[Maximilian]";
	mes "你知道我明明失去了儿子和儿媳，却一直保持沉默的原因吗？";
		next;
		mes "[Maximilian]";
	mes "因为复仇改变不了任何事。复仇是另一种暴力，只能带来短暂的满足。";
		next;
		mes "[Maximilian]";
	mes "死者不会回来。你们的父母也不会希望你们复仇。";
		next;
		mes "[Maximilian]";
	mes "我一直让你们做自己想做的事，但这次我希望你们听从艾格尼丝的话。如果可以，我想避免战争。";
		next;
		cutin "16hel",0;
		mes "[Helmut]";
		mes "......";
	mes "我也失陪了。";
		next;
		cloakonnpcself( "Helmut Roegenburg#ep16lug" );
		cutin "",255;
		mes "[Kalbern]";
	mes "赫尔穆特大人！你要去哪里？";
		next;
		cloakonnpcself( "Kalbern#ep16lug" );
		cutin "16wol_nor",2;
		mes "[Wolf]";
		mes "......";
		next;
		mes "[" + strcharinfo(0) + "]";
	mes "我不想打扰你们，但很多人都害怕战争，";
		next;
		mes "[" + strcharinfo(0) + "]";
	mes "包括孩子们。如果不爆发战争当然最好，但不安和恐惧持续太久也没有好处。";
		next;
		mes "[Maximilian]";
	mes "啊，很抱歉让你看到了这些。";
		next;
		mes "[Wolf]";
	mes "抱歉让你感到不舒服。再次向你道歉，但能请你帮个忙吗？";
		next;
		mes "[Wolf]";
	mes "我认为我们需要把传闻告知^0000cd维格纳^000000。请稍等一会儿。";
		next;
		cutin "",255;
	mes "[沃尔夫准备了一会儿文件，并将其封入信封。]";
		next;
		cutin "16wol_nor",2;
		mes "[Wolf]";
	mes "请把这份文件送去。再次抱歉，我突然有很多事要做，实在抽不出时间。";
		next;
		mes "[" + strcharinfo(0) + "]";
	mes "不用。我很快就会回来。";
		erasequest 14501;// Report to Wolf
		setquest 14502;// To Isaac
		getitem 6931,1;// Secret_Documents
		ep16_lug = 7;
		close3;
	}
	if (ep16_lug == 7) {
		cutin "16wol_nor",2;
		mes "[Wolf]";
	mes "你把文件交给艾萨克了吗？本来应该由我亲自去的，但我突然忙了起来。";
		next;
		mes "[Wolf]";
	mes "听艾格尼丝说完后，我想了很多。为了做那些事，我一分钟也不能浪费。";
		next;
		mes "[Wolf]";
	mes "那么回头见。";
		close3;
	}
	if (ep16_lug == 8) {
		cutin "16wol_nor",2;
		mes "[Wolf]";
	mes "亲爱的冒险者，非常感谢你。维格纳生气了吗？";
		next;
		mes "[" + strcharinfo(0) + "]";
	mes "他理解了一切。他相信维格纳会尽快找到新的商品。";
		next;
		mes "[Wolf]";
	mes "他能理解我的想法真是太好了。我想至少得开始一项新事业，不能让维格纳失望。";
		next;
		mes "[" + strcharinfo(0) + "]";
	mes "你还是不肯放弃经商的念头啊？";
		next;
		mes "[Wolf]";
	mes "没想到这很适合我。工作既有回报又很有趣。而且我能展示自己的能力，而不是罗根贝格家族的能力。";
		next;
		mes "[" + strcharinfo(0) + "]";
	mes "话说回来，你的兄弟们一定很忙。迈尔，还有赫尔穆特……";
		next;
		cutin "",255;
		mes "[Maximilian]";
	mes "赫尔穆特一声不响地去了前线。迈尔也离开了家。我想他们从艾格尼丝的话中感受到了什么。";
		next;
		mes "[Maximilian]";
	mes "如果你允许，我想^0000cd澄清传闻中关于我家族的误会^000000。你有时间吗？";
		next;
		mes "[" + strcharinfo(0) + "]";
	mes "有。";
		next;
		mes "[Maximilian]";
	mes "传闻是真的，除了会爆发战争的那部分。";
		next;
		mes "[Maximilian]";
	mes "让我告诉你一段往事。四个孩子的父母生下艾格尼丝后，前往邻国休养。";
		next;
		mes "[Maximilian]";
	mes "他们在那里遭到了魔物袭击。";
		next;
		mes "[" + strcharinfo(0) + "]";
	mes "在度假胜地？现在连度假胜地也会出现魔物吗？";
		next;
		mes "[Maximilian]";
	mes "那是一个偏远但安全的地方。但不知为何，魔物成群发动了攻击。";
		next;
		mes "[Maximilian]";
	mes "原因仍然不明，但人们猜测魔物是被讨伐队追赶，才逃到了城镇。";
		next;
		mes "[" + strcharinfo(0) + "]";
	mes "原来如此。";
		next;
		mes "[Maximilian]";
	mes "我们抵达现场时，区域已经封锁，禁止任何人进入，尽管我的儿子和儿媳就在里面。";
		next;
		mes "[Maximilian]";
	mes "我们见到了管理人员，但他们完全拦住了像我们这样全副武装的外国人。";
		next;
		mes "[Maximilian]";
	mes "我能理解。外国武装部队正在越过边境，我也无法确定这支武装部队会做什么。他们只能阻止我们。";
		next;
		mes "[Maximilian]";
	mes "于是我们一边设法进入封锁区，一边联系许多人，时间就这样过去了。";
		next;
		mes "[Maximilian]";
	mes "最后，我们不得不支付大笔贿赂，才得以派遣佣兵进入度假胜地，但我的儿子和儿媳已经遇害。";
		next;
		mes "[Maximilian]";
	mes "其实，在被找到前他们还活着。但进入现场的时间被耽搁了，他们只能痛苦地死去。";
		next;
		mes "[" + strcharinfo(0) + "]";
	mes "听到这些我很遗憾。";
		next;
		mes "[Maximilian]";
	mes "我没有告诉孩子们袭击的经过，但必须告诉他们父母已经去世。";
		next;
		mes "[Maximilian]";
	mes "失去挚爱的人后，我和孩子们便一起生活。";
		next;
		mes "[Maximilian]";
	mes "我把孩子们培养成配得上罗根贝格之名的人。";
	mes "但其实他们需要的不只是教育，还有温暖的心。";
		next;
		mes "[Maximilian]";
	mes "我当时不知道，只是一味对他们严厉。";
		next;
		mes "[Maximilian]";
	mes "孩子们再也无法忍受，终于有一天离开了家，作为反抗的表示。";
		next;
		mes "[Maximilian]";
	mes "孩子们不愿谈论那些日子。但我确信他们当时听到和看到的一切影响了他们。";
		next;
		mes "[" + strcharinfo(0) + "]";
	mes "怎么影响的？";
		next;
		mes "[Maximilian]";
	mes "赫尔穆特自行训练，长大后去了边境。沃尔夫则突然宣布要赚钱。";
		next;
		mes "[Maximilian]";
	mes "我说家族里不该有商人，试图阻止他，但他非常固执。";
		next;
		mes "[Maximilian]";
	mes "回家后，迈尔有一段时间表现得很好。但他留下一张字条后离开了。只有艾格尼丝一直顺利成长，没有遇到问题。";
		next;
		mes "[" + strcharinfo(0) + "]";
	mes "嗯。我明白了，他们每个人都有自己的故事！传闻中隐瞒了一些事情。";
		next;
		mes "[Maximilian]";
	mes "是的，迈尔说他会处理传闻，所以传闻会消失。能请你帮我一个忙吗？";
		next;
		mes "[" + strcharinfo(0) + "]";
	mes "请说吧。";
		next;
		mes "[Maximilian]";
	mes "我担心^0000cd赫尔穆特一声不响地离开^000000，毕竟有很多双眼睛在注视他。他是我们家族的继承人。";
		next;
		mes "[Maximilian]";
	mes "我希望他暂时留下，但他突然离开让我很难过。";
		next;
		mes "[" + strcharinfo(0) + "]";
	mes "那么，我的任务就是把他带回来。";
		next;
		mes "[Maximilian]";
	mes "是的。他应该在^0000cd施瓦茨瓦德边境附近的检查点^000000。由他负责巡逻队。";
		next;
		mes "[Maximilian]";
	mes "回来时使用这个。你可以立刻返回普隆德拉。";
		next;
		mes "[" + strcharinfo(0) + "]";
	mes "好。我很快回来。";
		erasequest 14503;// Report to Wolf
		setquest 14504;// In Search of Helmut
		getitem 22847,1;// BadgeOfProntera
		ep16_lug = 9;
		close3;
	}
	if (ep16_lug > 8 && ep16_lug < 13) {
		cutin "16wol_nor",2;
		mes "[Wolf]";
	mes "我觉得以前和赫尔穆特、迈尔这两个兄弟更亲近。";
		next;
		mes "[Wolf]";
	mes "艾格尼丝是家里最受宠的孩子。她是我们唯一的妹妹。";
		next;
		mes "[Wolf]";
	mes "但有时我会想，我们为什么会变得如此疏远。";
		next;
		mes "[Wolf]";
	mes "嗯，我想是因为我们逐渐变得不同，对何为正确也有不同看法。我多少能理解。";
		next;
		mes "[Wolf]";
	mes "迈尔离家时让我很震惊。他和我关系很亲密，却一声不响地离开了。";
		next;
		mes "[Wolf]";
	mes "从那以后，我想我开始寻找自己能做的事。我无法忍受只有自己没有进步的想法。";
		next;
		mes "[Wolf]";
	mes "人感到内心空缺时，往往会想办法填补它。";
		next;
		mes "[Wolf]";
	mes "我想我会继续四处寻找。";
		close3;
	}
	if (ep16_lug > 12) {
		cutin "16wol_nor",2;
		mes "[Wolf]";
	mes "亲爱的冒险者，多亏了你，我觉得我和兄弟们变得更亲近了。";
	mes "我和兄弟们不知道该如何弯曲，差点就此折断。";
		next;
		mes "[Wolf]";
	mes "我想这些经历让我们更加友善，也有所成长。";
	mes "我们分开了很久，大家都忘记了这一点。";
		next;
		mes "[Wolf]";
	mes "从今以后，我会帮助祖父领导家族。";
	mes "如果你偶尔来看看我们，我会很高兴。";
		next;
		mes "[Wolf]";
	mes "如果需要帮助，请再来找我们。";
		close3;
	}
}

prt_cas_q,90,184,7	script	#ep16lug004	HIDDEN_NPC,5,5,{
	end;
OnTouch:
	if (ep16_lug < 3)
		cloakonnpcself( "Myer Roegenburg#ep16lug" );
	else if (ep16_lug > 2 && ep16_lug < 7)
		cloakoffnpcself( "Myer Roegenburg#ep16lug" );
	else if (ep16_lug > 6) {
		cloakonnpcself( "Helmut Roegenburg#ep16lug" );
		cloakonnpcself( "Myer Roegenburg#ep16lug" );
		cloakonnpcself( "Kalbern#ep16lug" );
	}
	end;
}

prt_cas_q,92,182,7	script	Myer Roegenburg#ep16lug	4_EP16_MEYER,{
	if (ep16_lug > 2 && ep16_lug < 7) {
		cutin "16mye_nor",1;
		mes "[Myer]";
	mes "时隔这么久回到家，感觉真好。";
	mes "不过也有点令人窒息。";
		next;
		mes "[Myer]";
	mes "不管怎样，没有我这个家也运转得很好。我不担心家族，只担心祖父，毕竟他年纪很大了。";
		next;
		mes "[Myer]";
	mes "现在我回家了，赫尔穆特、沃尔夫和艾格尼丝似乎都过得很好。";
		next;
		mes "[Myer]";
	mes "我觉得这很好，虽然有点失望。";
	mes "毕竟是我离开了家，这样想也太傻了。";
		close3;
	}
	end;

OnInit:
	cloakonnpc();
	end;
}

prt_cas_q,74,189,5	script	#ep16lug000	HIDDEN_NPC,5,5,{
	end;
OnTouch:
	if (ep16_lug < 3)
		cloakonnpcself( "Myer Roegenburg#ep16lug" );
	else if (ep16_lug > 2 && ep16_lug < 7)
		cloakoffnpcself( "Myer Roegenburg#ep16lug" );
	else if (ep16_lug > 6) {
		cloakonnpcself( "Helmut Roegenburg#ep16lug" );
		cloakonnpcself( "Myer Roegenburg#ep16lug" );
		cloakonnpcself( "Kalbern#ep16lug" );
	}
	end;
}

function	script	F_kids_roegenburg_quest	{
	switch( ep16_lug ) {
	case 4:
		next;
		emotion ET_FRET, getnpcid(0, "Kiddo#ep16lug03");
		mes "[Harriet]";
	mes "住手！你们两个。我听着你们说话都头晕了。";
		next;
		mes "[" + strcharinfo(0) + "]";
	mes "你好，我有个问题。你们有什么有趣的故事吗？";
		next;
		mes "[Allen]";
	mes "这是任务吗？";
		next;
		mes "[Jin]";
	mes "有趣的故事？";
		next;
		mes "[Harriet]";
	mes "我有一个。";
		next;
		mes "[Allen]";
	mes "我来接待你。你有什么问题？";
		next;
		mes "[" + strcharinfo(0) + "]";
	mes "我是说战争故事、王室传闻之类的。";
	mes "我想王室会议或宴会应该有很多故事。我现在在首都，为了了解这里的气氛，我应该听听这些故事。";
		next;
		mes "[Jin]";
	mes "啊！我知道那个故事！我们都知道！";
		next;
		mes "[Harriet]";
	mes "让我来讲！";
		next;
		mes "[Allen]";
	mes "我也知道这个故事。但我不确定该不该告诉你。";
		next;
		mes "[" + strcharinfo(0) + "]";
	mes "为什么？如果你想要报酬，我可以给你。糖果？";
		next;
		mes "[Jin]";
	mes "你要用糖果当报酬？真傻。我们又不是孩子。";
		next;
		mes "[Harriet]";
	mes "你最好别提报酬。我妈妈告诉过我不能收陌生人的东西。";
		next;
		mes "[" + strcharinfo(0) + "]";
	mes "陌生人？我们不是正在互相交谈吗。那你想要什么？不要糖果的话。";
		next;
		mes "[Allen]";
	mes "报酬对我不重要。重要的是你是否有资格听这个故事。";
		next;
		mes "[Harriet]";
	mes "资格？他到底在说什么？他有时说话真奇怪。";
		next;
		mes "[Jin]";
	mes "我想要报酬。只要给我合适的报酬，我什么都能告诉你。所以先让我看看你的报价。";
		next;
		emotion ET_SWEAT, playerattached();
		mes "[" + strcharinfo(0) + "]";
	mes "我没打算欺骗你们。不过你们很坦率地说出了想要的东西。我一开始因为你们是孩子而小看了你们。";
	mes "好，我会给你们报酬。那资格又是什么？听个传闻也需要资格吗？";
		next;
		mes "[Allen]";
	mes "这取决于你想听什么传闻。价值越高，风险也越高。";
		next;
		mes "[Harriet]";
	mes "传闻有那么危险吗？我听的时候完全不知道。金，你知道吗？";
		next;
		mes "[Jin]";
	mes "那是艾伦。你只能相信他百分之三十。如果他总是正确，世界早就毁灭二十次了。";
		next;
		mes "[" + strcharinfo(0) + "]";
	mes "那么我该怎么办？告诉我。你们想要什么？";
		next;
		emotion ET_SMILE, getnpcid(0, "Kiddo#ep16lug02");
		mes "[Jin]";
	mes "终于到谈生意的时间了！太棒了！我喜欢！";
		next;
		emotion ET_SMILE, getnpcid(0, "Kiddo#ep16lug03");
		mes "[Harriet]";
	mes "漂亮的东西我都喜欢！";
		next;
		emotion ET_SURPRISE, getnpcid(0, "Kiddo#ep16lug01");
		mes "[Allen]";
	mes "验证资格！就这么简单！";
		next;
		mes "[" + strcharinfo(0) + "]";
	mes "我不知道你在说什么。请慢慢详细告诉我？";
		next;
		mes "[Allen]";
	mes "很简单。证明你的力量。我想你知道^0000cd玛乔雷洛斯^000000。";
	mes "那是一个肌肉强健的恶魔。抓住它来证明你的实力。它的力量数值是^0000cd33^000000！";
		next;
		mes "[" + strcharinfo(0) + "]";
	mes "原来如此。这样够了吗？我很快回来。";
		next;
		emotion ET_HUK, getnpcid(0, "Kiddo#ep16lug02");
		emotion ET_HUK, getnpcid(0, "Kiddo#ep16lug03");
		mes "[Jin]";

		mes "[Rebellion senior Ridsh]";
	mes "有时候你看起来比科特尼斯还老！";
		next;
		mes "[Rebellion senior Dien]";
	mes "哎呀，真的吗？";
		cutin "ep162_dn01.bmp",2;
		next;
		mes "[Rebellion senior Cotnes]";
	mes "呼！";
	mes "没那么老！";
		cutin "ep162_ctn01.bmp",2;
		next;
		mes "[Rebellion senior Cotnes]";
	mes "你最近好像皱纹更多了。";
	mes "为什么不涂点抗皱霜？";
		next;
		mes "[Rebellion senior Dien]";
	mes "这都是因为这里的空气！";
		cutin "ep162_dn01.bmp",2;
		next;
		mes "[Rebellion senior Ridsh]";
	mes "你说得对！";
	mes "这种空气对你这样的干性皮肤很糟糕！";
		cutin "ep162_rds01.bmp",0;
		next;
		mes "[Rebellion senior Ridsh]";
	mes "说起来，你还记得之前来过这里的那个孩子吗？";
	mes "告诉他从卢恩·米德加尔兹买些化妆品！";
		next;
		mes "[Rebellion senior Ridsh]";
	mes "我听说那里有一家很棒的化妆品店。";
		next;
		mes "[Rebellion senior Ridsh]";
	mes "让我们的孩子专程去那里买化妆品很困难。";
	mes "而且职位上也有问题……";
		cutin "ep162_rds03.bmp",0;
		next;
		mes "[Rebellion senior Dien]";
	mes "那个孩子？你说的是谁？";
		cutin "ep162_dn01.bmp",2;
		next;
		mes "[Rebellion senior Ridsh]";
	mes "秘密之翼的那个孩子～";
		cutin "ep162_rds01.bmp",0;
		next;
		mes "[Rebellion senior Dien]";
	mes "哦！";
	mes "我记得我曾让他跑腿。他会回这里吗？";
		cutin "ep162_dn01.bmp",2;
		next;
		mes "[Rebellion senior Ridsh]";
	mes "好像你已经解决了所有问题。而且他们不会越过你。";
		cutin "ep162_rds02.bmp",0;
		next;
		mes "[Rebellion senior Ridsh]";
	mes "当然，我们也有一些重要的想法～";
		cutin "ep162_rds03.bmp",0;
		next;
		mes "[Rebellion senior Ridsh]";
	mes "你真了不起。你怎么能在那么短的时间里想到这种主意？";
		next;
		mes "[Rebellion senior Dien]";
	mes "别说总统了，心脏猎人也让我们很恼火。";
		cutin "ep162_dn03.bmp",2;
		next;
		mes "[Rebellion senior Dien]";
	mes "虽然他们都是新手，但会妨碍我们击败秘密之翼。";
		next;
		mes "[Rebellion senior Ridsh]";
	mes "确实如此。";
		cutin "ep162_rds01.bmp",0;
		next;
		mes "[Rebellion senior Dien]";
	mes "假设我们贸然攻击秘密之翼，心脏猎人趁机袭击我们，我们会立刻崩溃。";
		cutin "ep162_dn03.bmp",2;
		next;
		mes "[Rebellion senior Dien]";
	mes "所以我们会假装与秘密之翼合作，先除掉那些讨厌的家伙。";
		cutin "ep162_dn04.bmp",2;
		next;
		mes "[Rebellion senior Ridsh]";
	mes "在他们意识到我们计划攻击之前，先解决掉他们。";
		cutin "ep162_rds05.bmp",0;
		next;
		mes "[Rebellion senior Ridsh]";
	mes "我们是叛乱军。我们已经走到枪口尽头。";
		next;
		mes "[Rebellion senior Dien]";
	mes "让我在这一代了结我的因果。";
	mes "我不想把它留给年轻人。";
		cutin "ep162_dn03.bmp",2;
		next;
		mes "[Rebellion senior Dien]";
	mes "在我死之前能有这个机会真好。";
		cutin "ep162_dn01.bmp",2;
		next;
		mes "[Rebellion senior Ridsh]";
	mes "拜托，姐姐！";
	mes "别说死不死的！";
		cutin "ep162_rds03.bmp",0;
		next;
		mes "[Rebellion senior Ridsh]";
	mes "你说完那句话后，我看到鲁珀特哭了。";
		cutin "ep162_rds04.bmp",0;
		next;
		mes "[Rebellion senior Ridsh]";
	mes "他已经不可爱了，只是个中年男人。但对他来说，你就像母亲。";
		cutin "ep162_rds03.bmp",0;
		next;
		mes "[Rebellion senior Ridsh]";
	mes "对我来说……";
		next;
		mes "[Rebellion senior Dien]";
	mes "是的，我明白。";
		cutin "ep162_dn01.bmp",2;
		next;
		mes "[Rebellion senior Dien]";
	mes "我们现在拥有的是一场愉快的聚会。我很期待。";
	mes "哈哈哈。";
		cutin "ep162_dn04.bmp",2;
		next;
		mes "[Rebellion senior Ridsh]";
	mes "我非常期待！";
		cutin "ep162_rds05.bmp",0;
		next;
		mes "[Rebellion senior Cotnes]";
	mes "那我会提前准备聚会用品。";
	mes "呵呵呵呵。";
		cutin "ep162_ctn02.bmp",2;
		terra_gloria_lady_part = 11;
		setquest 11463;// You said the party is ready?
		close3;
	}
	warp "rebel_in",158,83;
	end;

OnInit:
	questinfo( QTYPE_QUEST, QMARK_NONE, "terra_gloria_lady_part == 10" );
	end;
}



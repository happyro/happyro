in_orcs01,31,93,1	script	Orc Warrior#1	1023,2,2,{
OnTouch_:
	disable_items;
	if (checkweight(1201,1) == 0) {
		mes "- 等一下！！-";
		mes "- 你目前携带了-";
		mes "- 太多物品。-";
		mes "- 请先整理物品-";
		mes "- 减轻重量后再试。-";
		close;
	}
	if (orcs_hero_hat < 1) {
	mes "[兽人战士]";
		mes ".......";
		mes ".........";
	mes "人类，你在我家做什么？！";
		next;
	mes "[兽人战士]";
	mes "哼。";
	mes "我猜你以为没人，杀了同族后就进来休息。";
		next;
	mes "[兽人战士]";
	mes "我们兽人是骄傲的种族！";
	mes "别指望我和你说话。";
	mes "不过我得承认，你敢进入兽人的家，确实很有勇气。";
		next;
	mes "[兽人战士]";
	mes "我今天累得没力气杀你，但保持安静！如果受伤了，就安静地躺在地上流血，体面地死去吧。";
		if (rand(1,5) == 5 && BaseLevel >= 55) {
			next;
			if (select("……:来吧，我们谈谈。") == 1) {
				close;
			}
	mes "[兽人战士]";
			mes "你竟敢邀请兽人交谈？！我们兽人是野蛮种族！从苦难中诞生，只为战斗而活！";
			next;
	mes "[兽人战士]";
			mes "和人类交谈？！";
			mes "哈！除非你也失去尊严，否则我不会忍受这种屈辱。";
			next;
	mes "[兽人战士]";
			mes "你可以在我家流血，但我只会在你……";
			mes "带来^FF00001000 个杰勒比^000000时和你说话！";
			next;
			if (select("兽人，我向你挑战决斗！:那就要 1000 个杰勒比。") == 1) {
	mes "[兽人战士]";
			mes "人类……真是讨厌的混蛋！";
			mes "想打架就出去！";
			mes "快滚出我家！";
				close2;
				warp "gef_fild10",100,100;
				end;
			}
			set orcs_hero_hat,1;
	mes "[兽人战士]";
			mes "哈！那就说定了！";
			mes "哇哈哈哈哈哈哈！";
			mes "那可是 1000 个杰勒比！";
			mes "你们人类都这么愚蠢吗？！";
			close;
		}
		close;
	}
	else if (orcs_hero_hat == 1) {
		if (countitem(909) > 999) {
	mes "[兽人战士]";
			mes "什么？！";
			mes "好多杰勒比！！";
			next;
	mes "[兽人战士]";
			mes "人类，我不喜欢你开的这个玩笑。不过我不相信你真的带来了^FF00001000 个杰勒比^000000。";
			next;
	mes "[兽人战士]";
			mes "我们兽人是骄傲的种族，不喜欢承认自己错了。";
			next;
	mes "[兽人战士]";
			mes "一……";
			next;
	mes "[兽人战士]";
			mes "一……二、二……";
			next;
	mes "[兽人战士]";
			mes "一……二、二……";
			mes "三……";
			next;
	mes "[兽人战士]";
			mes "一……二、二……";
			mes "三……";
			mes "……四、四……";
			next;
	mes "[兽人战士]";
			mes ".......";
			next;
	mes "[兽人战士]";
			mes ".......";
			mes ".........";
			next;
	mes "[兽人战士]";
			mes ".......";
			mes ".........";
			mes "............";
			next;
	mes "[兽人战士]";
			mes "九百九十八……";
			next;
	mes "[兽人战士]";
			mes "九百九十八……";
			mes "九百九十九……";
			next;
	mes "[兽人战士]";
			mes "九百九十八……";
			mes "九百九十九……";
			mes "一……";
			next;
	mes "[兽人战士]";
			mes "九百九十八……";
			mes "九百九十九……";
			mes "一……一千。";
			next;
	mes "[兽人战士]";
			mes "诅咒你，人类。";
			mes "你的“交谈”结束了。";
			next;
	mes "[兽人战士]";
			mes "我恨人类！事实上，所有兽人都恨人类！恨你、恨你、恨你！";
			next;
			delitem 909,1000; //Jellopy
			set orcs_hero_hat,2;
	mes "[兽人战士]";
		mes "所以……";
			mes "你还想聊天？！";
			next;
	mes "[兽人战士]";
			mes "真顽强！";
			mes "想听更多的话，带来……";
			mes "^FF00001000 个杰勒比^000000！";
			next;
	mes "[兽人战士]";
			mes "现在滚出去，你这个可怕、恶臭、连动物都不如的家伙！！";
			close;
		}
	mes "[兽人战士]";
		mes "你已经忘了吗？！";
		mes "^FF00001000 个杰勒比^000000！";
		mes "想和我说话，";
		mes "就拿出你的尊重。";
		close;
	}
	else if (orcs_hero_hat == 2) {
		if (countitem(909) > 999) {
	mes "[兽人战士]";
			mes "不……不要再来一次了！！";
			mes "你拿这么多杰勒比做什么？！";
			next;
	mes "[兽人战士]";
			mes "可恶……！";
			mes "数完这些杰勒比之前，我拒绝和你说话。";
			next;
	mes "[兽人战士]";
			mes "...";
			next;
	mes "[兽人战士]";
			mes "...";
			mes ".....";
			next;
	mes "[兽人战士]";
			mes "...";
			mes ".....";
			mes "一千个。";
			next;
	mes "[兽人战士]";
			mes "人类，你又一次成功激怒了我。但我们兽人是骄傲的种族，我会履行这笔可悲交易中属于我的部分。";
			next;
	mes "[兽人战士]";
			mes "我刚才说到哪里了？";
			mes "哦，对了。";
			mes "我有多么憎恨人类。";
			next;
	mes "[兽人战士]";
			mes "人类总是入侵我们的村庄，侵占我们的土地！他们杀死我们的战士不是为了荣誉，而是出于自私的人类理由！！";
			next;
	mes "[兽人战士]";
			mes "哼！人类建造了自己的城镇和城市。他们会停止互相无意义地杀戮吗？！不会！人类总要肆意破坏一切！！";
			next;
			delitem 909,1000; //Jellopy
			set orcs_hero_hat,3;
	mes "[兽人战士]";
			mes "如果你还想";
			mes "继续听下去，";
			mes "就再带来……";
			next;
	mes "[兽人战士]";
			mes "再来^FF00001000个杰勒比^000000！";
			mes "我不认为你还能承受更多这种折磨。";
			mes "哇哈哈哈哈哈~！";
			close;
		}
	mes "[兽人战士]";
		mes "你已经忘了吗！？";
		mes "^FF00001000个杰勒比^000000！";
		mes "想和我说话的话，";
		mes "就拿出你的尊重。";
		close;
	}
	else if (orcs_hero_hat == 3) {
		if (countitem(909) > 999) {
	mes "[兽人战士]";
			mes ".....";
		mes "人类，你的顽固又让我困惑。我看人类都是受虐狂，或者只是喜欢让兽人数一千个杰勒比来烦我们。";
			next;
	mes "[兽人战士]";
			mes "*叹气* 让我数数……";
			next;
	mes "[兽人战士]";
			mes "...";
			next;
	mes "[兽人战士]";
			mes "...";
			mes ".......";
			next;
	mes "[兽人战士]";
			mes "九百九十九……";
			next;
	mes "[兽人战士]";
			mes "九百九十九……";
			mes "……一千。";
			next;
	mes "[兽人战士]";
			mes "啊~！";
			mes "我刚才说到哪里了？";
			mes "哦，对了，人类为什么是败类。";
			next;
	mes "[兽人战士]";
			mes "人类怎么敢以为自己如此伟大？！我们兽人也为世界做出了贡献！";
			next;
	mes "[兽人战士]";
			mes "人类也许建造了城镇和城市，但我们兽人也创建了自己的洞窟群和运河！";
			next;
	mes "[兽人战士]";
			mes "我们兽人发明了许多有用的东西！当然，现在我们不得不把它们留给自己。为什么？因为人类的愚蠢和贪婪！！";
			next;
	mes "[兽人战士]";
			mes "我们兽人曾为人类建造过一座高塔，却被困在那里并遭到奴役。不用说，人类理应承受我们的愤怒与怒火。";
			next;
	mes "[兽人战士]";
		mes "*叹气*";
			mes "我不明白自己为什么要分享部族的故事。";
			mes "今天就到这里！";
			next;
			delitem 909,1000; //Jellopy
			set orcs_hero_hat,4;
	mes "[兽人战士]";
			mes "呜~！想继续听的话，再带来^FF00001000个杰勒比^000000。";
			close;
		}
	mes "[兽人战士]";
		mes "你已经忘了吗！？";
		mes "^FF00001000个杰勒比^000000！";
		mes "想和我说话的话，";
		mes "就拿出你的尊重！！";
		mes "我才不把你给我的2000个杰勒比当回事！！";
		close;
	}
	else if (orcs_hero_hat == 4) {
		if (countitem(909) > 999) {
	mes "[兽人战士]";
			mes "哦……又是你。";
			mes "我看到你手里的杰勒比了，你肯定又带来了一千个，那我们快点结束吧。";
			next;
	mes "[兽人战士]";
			mes "*叹气* 我想是时候开始我们的谈话了。";
			next;
	mes "[兽人战士]";
			mes "很久以前，兽人和人类是盟友。我……我怀念那段时光。但怀念过去的友谊也没有意义，那些久远的误会不可能解开……";
			next;
	mes "[兽人战士]";
			mes "有太多人类不惜一切追求财富和名望。他们不理解荣誉与忠诚之类的理想，为了得到想要的一切不择手段。";
			next;
	mes "[兽人战士]";
			mes "那些可恨的人类开始铲除挡在他们和目标之间的一切障碍，无论挡路的是朋友还是敌人。";
			next;
	mes "[兽人战士]";
			mes "……我已经说得太多了。";
			mes "今天的谈话就到这里。";
			next;
			delitem 909,1000; //Jellopy
			set orcs_hero_hat,5;
	mes "[兽人战士]";
			mes "如果你明天还想继续听，就再带来";
			mes "^FF00001000个杰勒比^000000。";
			close;
		}
	mes "[兽人战士]";
		mes "你已经忘了吗？";
		mes "^FF00001000个杰勒比^000000！";
		mes "想和我说话的话，";
		mes "就拿出你的尊重。";
		mes "我才不把你给我的3000个杰勒比当回事。";
		close;
	}
	else if (orcs_hero_hat == 5) {
		if (countitem(909) > 999) {
	mes "[兽人战士]";
			mes "*叹气……*";
			mes "你太顽强了，甩不掉你。";
			mes "你真的这么想听我说吗……？";
			mes "好吧……那我再告诉你一点。";
			next;
	mes "[兽人战士]";
			mes "对我们兽人来说，战斗胜利是最高荣誉。";
			mes "我们勇敢无畏地与对手战斗，为公平胜利倾尽全力，甚至愿为胜利而死。";
			next;
	mes "[兽人战士]";
			mes "即使死后，我们也不会失去战斗精神。据说有些死得不公的兽人会从坟墓中站起，寻求更多战斗。";
			next;
	mes "[兽人战士]";
		mes "你们人类和我们的区别在于，我们绝不容忍战斗中的卑鄙手段。更重要的是，兽人永远不会撤退，必定战斗到最后一口气……";
			next;
	mes "[兽人战士]";
		mes "兽人从不在战斗中用你们可笑的药水恢复生命。哼。人类真弱，靠喝药水才能继续战斗。不过我不确定你是否也是这样。";
			next;
			delitem 909,1000; //Jellopy
			set orcs_hero_hat,6;
	mes "[兽人战士]";
		mes "如果你还想";
		mes "继续听我说，";
		mes "明天再来";
			mes "带给我^FF00001000 个杰勒比^000000。";
	// 切片行数保留
	// 切片行数保留
			close;
		}
	mes "[兽人战士]";
		mes "你已经忘了吗？";
		mes "^FF00001000 个杰勒比^000000！";
		mes "想和我说话，";
		mes "就拿出你的尊重。";
		mes "我可不把你给的 4,000 个杰勒比当回事。";
		close;
	}
	else if (orcs_hero_hat == 6) {
		if (countitem(909) > 999) {
	mes "[兽人战士]";
		mes "什么……！你不知道适可而止吗？我不敢相信人类会这么想了解兽人。不过……";
		mes "我们兽人是骄傲的种族，我就满足你吧。";
			next;
	mes "[兽人战士]";
		mes "我们只挑选族中最强者成为战士。兽人成年后会被送进森林，在环境中独自生存。";
			next;
	mes "[兽人战士]";
		mes "活着回来的兽人才会被认可为真正的族人。最强的雄性成为兽人战士，最强的雌性成为兽人女士。";
			next;
	mes "[兽人战士]";
		mes "证明视力和灵巧出色的兽人会得到弓箭，成为兽人弓箭手。";
			next;
	mes "[兽人战士]";
		mes "我们兽人有一项特殊训练，叫作“火焰试炼”。通过试炼的兽人战士会受到火神的庇护……";
			next;
	mes "[兽人战士]";
		mes "那名兽人的体力和能力会强于普通兽人战士，这些战士被称为高级兽人。";
			next;
	mes "[兽人战士]";
		mes "嗯，在你们人类看来我们可能都长得一样，但我们兽人能分辨彼此。人类，你觉得我和外面的每个战士都一样吗？";
			next;
			delitem 909,1000; //Jellopy
			set orcs_hero_hat,7;

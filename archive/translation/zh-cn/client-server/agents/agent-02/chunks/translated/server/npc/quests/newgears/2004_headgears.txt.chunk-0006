pay_dun03,48,84,4	script	SpawnManager#Kitsune	-1,{
OnInit:
	set .MyMobs1,1;
	set .MyMobs2,1;
	end;

OnMyMobDead:
	set .MyMobs1,.MyMobs1-1;
	if (.MyMobs1 < 1)
		enablenpc "Nine Tails#Kitsune Man";
	end;

OnMyMobDead2:
	set .MyMobs2,.MyMobs2-1;
	if (.MyMobs2 < 1)
		enablenpc "Nine Tails#Kitsune Mask";
	end;

}


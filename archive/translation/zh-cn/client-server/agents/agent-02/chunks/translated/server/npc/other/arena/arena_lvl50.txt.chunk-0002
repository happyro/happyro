	mapannounce "force_1-1","Arena will be activated due to an error occurred in the waiting room.",0,0xFFCE00;
	end;
OnNomal1:
	mapannounce "force_1-1","Arena will be reactivated.",0,0xFFCE00;
	end;
OnNomal2:
	mapannounce "force_1-1","Arena will be reactivated.",0,0xFFCE00;
	end;
}


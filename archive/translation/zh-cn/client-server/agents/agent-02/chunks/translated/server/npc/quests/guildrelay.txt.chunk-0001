//===== rAthena Script ======================================= 
//= Guild Relay Quest
//===== By: ================================================== 
//= L0ne_W0lf
//===== Current Version: ===================================== 
//= 1.1
//===== Compatible With: ===================================== 
//= rAthena Project
//===== Description: ========================================= 
//= [Official Conversion]
//= Guild Relay Quest.
//= Quest designed for multiple users at once.
//= Variable in use: guildrelay_q (Max: ??)
//= Variable in use: guildtime (Max: ??)
//===== Additional Comments: ================================= 
//= 1.0 First version.
//= 1.1 Fixed errors reported by NoHealing (Bugreport:3934) [L0ne_W0lf]
//= NPCs now duplicate from FLOATING npcs instead of Luina 1 npcs.
//============================================================ 

// Floating NPCs to duplicate from.
//============================================================
-	script	RelayDummy1::GuildRelay1	754,{
	set .@name$,strnpcinfo(1);
	if (.@name$ == "Buzz") {
		set .@name2$,"Lenya";
		set .@name3$,"Gealuve";
		set .@name4$,"Pariz";
		set .@GID, GetCastleData("aldeg_cas"+strnpcinfo(2),1);
	}
	else if (.@name$ == "Jody") {
		set .@name2$,"Ron Haware";
		set .@name3$,"Vers";
		set .@name4$,"Gen Garish";
		set .@GID, GetCastleData("gefg_cas"+strnpcinfo(2),1);
	}
	else if (.@name$ == "Chungye") {
		set .@name2$,"Dosuhlji";
		set .@name3$,"Yayula";
		set .@name4$,"Ashin";
		set .@GID, GetCastleData("payg_cas"+strnpcinfo(2),1);
	}
	else if (.@name$ == "Hermod") {
		set .@name2$,"Atila";
		set .@name3$,"Cecil";
		set .@name4$,"Diligo";
		set .@GID, GetCastleData("prtg_cas"+strnpcinfo(2),1);
	}
	if (checkweight(908,630) == 0) {
		mes "^3355FF等一下！你现在携带的物品太多了，请把多余物品存入卡普拉仓库后再回来。^000000";
		close;
		}
		if (.@GID == 0) {
		mes "^3355FF你不知道原因，但这个人看起来很沮丧。他短暂与你对视后便移开目光，显然想独处。^000000";
		next;
	mes "^3355FF没有理由继续留在无人拥有的要塞。你还是离开吧。^000000";
	close;
		}
		if (getcharid(2) == .@GID) {
		if (is_guild_leader() == true) {
		.@time = atoi( gettimestr("%H%M",5) );
		if (guildrelay_q == 100) {
		if (guildtime > 2299) {
		if (.@time > 0101 && .@time < guildtime) {
		mes "[" + .@name$ + "]";
		mes "哦，你回来了。休息够了吗？我相信其他公会成员现在也精神焕发。看起来你已经准备好下一项任务。";
		next;
		mes "[" + .@name$ + "]";
		mes "下一步是收下这个‘信任之灵’。要让公会稳固，你必须思考公会中有多少信任。";
	set guildrelay_q,8;
	getitem 7240,1; //Soul_Of_Confidence
		next;
			mes "[" + .@name$ + "]";
			mes "第二项测试是把^4D4DFF信任之灵^000000交给能操控自然属性的贤者，也就是贤者或学者来完成。";
				next;
					mes "[" + .@name$ + "]";
						mes "信任之灵必须交给^4D4DFF" + .@name3$ + "^000000，别忘了把信息告诉你的贤者或学者。好了，祝你旅途顺利。";
						close;
						}
						else {
						mes "[" + .@name$ + "]";
						mes "啊，你休息好——哦。你脸色怎么这么苍白？过度劳累可做不成大事！休息吧，公会必须依靠你的力量。";
						emotion ET_SURPRISE;
						next;
						mes "[" + .@name$ + "]";
						mes "你的决心和精神值得称赞，但必要时也要耐心恢复自己。我会在这里等你，请稍后再来。";
						close;
						}
						}
						else if (guildtime > 2200) {
						if (.@time > 0001 && .@time < guildtime) {
						mes "[" + .@name$ + "]";
						mes "哦，你回来了。休息够了吗？其他公会成员应该也恢复精神了。看来你准备好下一项任务。";
						next;
						mes "[" + .@name$ + "]";
						mes "下一步是收下这个‘信任之灵’。要让公会稳固，你必须思考公会中有多少信任。";
						set guildrelay_q,8;
						getitem 7240,1; //Soul_Of_Confidence
						next;
						mes "[" + .@name$ + "]";
						mes "第二项测试是把^4D4DFF信任之灵^000000交给能操控自然属性的贤者，也就是贤者或学者来完成。";
						next;
						mes "[" + .@name$ + "]";
						mes "信任之灵必须交给^4D4DFF" + .@name3$ + "^000000，别忘了把信息告诉你的贤者或学者。好了，祝你旅途顺利。";
						close;
						}
						else {
						mes "[" + .@name$ + "]";
						mes "啊，你休息好——哦。你脸色怎么这么苍白？过度劳累可做不成大事！休息吧，公会必须依靠你的力量。";
						emotion ET_SURPRISE;
					next;
					mes "[" + .@name$ + "]";
						mes "你的决心和精神值得称赞，但必要时也要耐心恢复自己。我会在这里等你，请稍后再来。";
						close;
						}
						}
						else if ((.@time - guildtime) > 0200) {
						mes "[" + .@name$ + "]";
						mes "哦，你回来了。休息够了吗？其他公会成员应该也恢复精神了。看来你准备好下一项任务。";
						next;
						mes "[" + .@name$ + "]";
						mes "下一步是收下这个‘信任之灵’。要让公会稳固，你必须思考公会中有多少信任。";
						set guildrelay_q,8;
						getitem 7240,1; //Soul_Of_Confidence
						next;
						mes "[" + .@name$ + "]";
						mes "第二项测试是把^4D4DFF信任之灵^000000交给能操控自然属性的贤者，也就是贤者或学者来完成。";
						next;
						mes "[" + .@name$ + "]";
					mes "信任之灵必须交给^4D4DFF" + .@name3$ + "^000000，别忘了把信息告诉你的贤者或学者。好了，祝你旅途顺利。";
				close;
				}
					else {
						mes "[" + .@name$ + "]";
						mes "啊，你休息好——哦。你脸色怎么这么苍白？过度劳累可做不成大事！休息吧，公会必须依靠你的力量。";
						emotion ET_SURPRISE;
						next;
						mes "[" + .@name$ + "]";
						mes "你的决心和精神值得称赞，但必要时也要耐心恢复自己。我会在这里等你，请稍后再来。";
						close;
						}
						}
						else if (guildrelay_q == 150) {
						if ((guildtime > 2299 && .@time > 0101 && .@time < guildtime) || (guildtime > 2199 && .@time > 0001 && .@time < guildtime) || ((.@time - guildtime) > 0200)) {
						mes "[" + .@name$ + "]";
						mes "啊，你休息得很好，大人。现在该进行第三项测试了。提醒你，这些灵魂极其珍贵，千万别弄丢。";
						next;
						mes "[" + .@name$ + "]";
						mes "和其他灵魂一样，请妥善保管这个。它是^4D4DFF和平之灵^000000。要塞与力量似乎与和平矛盾，但事实确实如此。";
						set guildrelay_q,15;
						getitem 7246,1; //Soul_Of_Peace
						next;
						mes "[" + .@name$ + "]";
						mes "如果力量不用于保护弱者，总会有某种形式的恶霸来剥削他们。这就是特里斯坦三世建造要塞的原因。";
						next;
						mes "[" + .@name$ + "]";
						mes "请派一名盗贼或神行太保把和平之灵交给^4D4DFF" + .@name4$ + "^000000。若不认识盗贼或神行太保，最好先去结识一位。";
						next;
						mes "[" + .@name$ + "]";
						mes "没错，盗贼提供的潜行和情报收集无可替代。总之，" + .@name4$ + "会指导你完成第三项测试。";
						close;
						}
						else {
						mes "[" + .@name$ + "]";
						mes "啊，你休息好——哦。你脸色怎么这么苍白？过度劳累可做不成大事！休息吧，公会必须依靠你的力量。";
						emotion ET_SURPRISE;
						next;
					mes "[" + .@name$ + "]";
					mes "你的决心和精神值得称赞，但必要时也要耐心恢复自己。我会在这里等你，请稍后再来。";
						close;
						}
						}
						else if (guildrelay_q == 25) {
						if ((guildtime > 2299 && .@time > 0401 && .@time < guildtime)
						|| (guildtime > 2199 && .@time > 0301 && .@time < guildtime)
						|| (guildtime > 2059 && .@time > 0201 && .@time < guildtime)
						|| (guildtime > 1999 && .@time > 0101 && .@time < guildtime)
						|| (guildtime > 1899 && .@time > 0001 && .@time < guildtime)
						|| ((.@time - guildtime) > 0500)) {
						mes "[" + .@name$ + "]";
						mes "啊，休息好了吗，大人？请原谅我之前的失礼。我当时要报告你的试炼结果，一时失态了。不会再发生了。";
						set guildrelay_q,999;
						close;
						}
						else {
						mes "...............................";
					mes "...............................";
				next;
				mes "...............................";
					mes "...............................";
					mes "...............................";
					next;
					mes "[" + .@name$ + "]";
					emotion ET_HUK;
					mes "哦！大、大人？你什么时候……？对不起，我刚才忙着工作。";
					next;
					mes "[" + .@name$ + "]";
					mes "你完成试炼才过了几天。现在先休息并照顾好公会，好吗？请稍后再来，我还有很多事要处理……";
					close;
					}
					}
					else if (guildrelay_q == 999) {
					mes "[" + .@name$ + "]";
					mes "您好，大人。出什么事了吗？看起来你有什么心事。";
					next;
					switch(select("没、没什么。:我想参加课程。")) {
					case 1:
					mes "[" + .@name$ + "]";
					mes "嗯？真奇怪。";
					emotion ET_SWEAT;
					mes "你不是想再次参加试炼吧？";
					close;
					case 2:
					mes "[" + .@name$ + "]";
					mes "我明白了。你知道这并不容易，但我想你已经准备好了。拿着^4D4DFF公会之灵^000000，交给你最信任的骑士或圣殿骑士。";
					set guildrelay_q,1;
					getitem 7234,1; //Soul_Of_Guild
					next;
					mes "[" + .@name$ + "]";
					mes "这名骑士应把公会之灵带给^4D4DFF" + .@name2$ + "^000000。祝你好运，愿诸神与你同在。";
					close;
					}
					}
				else if (guildrelay_q == 1) {
				if (countitem(7234) > 0) {
					mes "[" + .@name$ + "]";
					mes "你还留着我给你的公会之灵？看来还没找到可以托付它的骑士或圣殿骑士。必须尽快找到人。";
					next;
					mes "[" + .@name$ + "]";
					mes "为了公会，让骑士或圣殿骑士站在你这边很有利：他们的战斗技能能扭转战局。";
					next;
					mes "[" + .@name$ + "]";
					mes "找到骑士后，把公会之灵交给他，并请他去找" + .@name2$ + "，因为他将主持试炼。祝你好运，大人。";
					close;
					}
					else if (countitem(7239) > 0) {
					mes "[" + .@name$ + "]";
					mes "啊，这是进取之灵？这意味着你完成了第一项测试。干得好。把灵魂交给我，我来给你公会奖励。";
					delitem 7239,1; //Soul_Of_Proceeding
					set guildtime,.@time;
					set guildrelay_q,100;
					set .@incen_item,rand(1,100);
				if ((.@incen_item > 0) && (.@incen_item < 25)) {
			getitem 608,20; //Seed_Of_Yggdrasil
			getitem 678,2; //Poison_Bottle
				}
					else if ((.@incen_item > 24) && (.@incen_item < 50)) {
					getitem 607,10; //Yggdrasilberry
					getitem 678,2; //Poison_Bottle
					}
					else if ((.@incen_item > 50) && (.@incen_item < 75)) {
					getitem 644,5; //Gift_Box
					getitem 678,2; //Poison_Bottle
					}
					else if ((.@incen_item > 74) && (.@incen_item < 101)) {
					getitem 603,3; //Old_Blue_Box
					getitem 678,2; //Poison_Bottle
					}
					next;
					mes "[" + .@name$ + "]";
					mes "你做得很好，但前方还有更多试炼。现在先休息，再进行第二项测试。准备好后再来。";
					close;
					}
					else {
					mes "[" + .@name$ + "]";
					mes "如果你不忙，不妨花时间提升公会成员的士气？也许团队建设活动会有帮助。";
					close;
					}
					}
					else if (guildrelay_q == 8) {
					if (countitem(7240) > 0) {
					mes "[" + .@name$ + "]";
					mes "你一定很难找到" + .@name3$ + "。找到他后，务必让贤者或学者朋友把信任之灵交给他。";
					close;
					}
					else if (countitem(7245) > 0) {
					mes "[" + .@name$ + "]";
					mes "啊，你已经完成测试并获得友谊之灵了？干得好。现在你应该认识到团队合作的价值。请把友谊之灵交给我。";
					next;
					mes "[" + .@name$ + "]";
					mes "现在收下这份奖励，与公会成员分享。它可能会在你们共同面对的未来挑战中派上用场。干得好！";
					delitem 7245,1; //Soul_Of_Friendship
					set guildtime, atoi( gettimestr("%H%M",5) );
					set guildrelay_q,150;
					set .@incen_item,rand(1,100);
					if ((.@incen_item > 0) && (.@incen_item < 16)) {
					getitem 607,10; //Yggdrasilberry
				getitem 644,5; //Gift_Box
				getitem 678,3; //Poison_Bottle
					}
					else if ((.@incen_item > 14) && (.@incen_item < 31)) {
					getitem 607,10; //Yggdrasilberry
					getitem 603,3; //Old_Blue_Box
					getitem 678,3; //Poison_Bottle
					}

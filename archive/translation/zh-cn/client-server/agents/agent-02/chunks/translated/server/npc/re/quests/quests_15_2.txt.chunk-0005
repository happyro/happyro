verus02,60,30,1	script	Strewn paper#e152a01	4_ENERGY_BLUE,{
	if (checkweight(1301,3) == 0) {
		mes "- 你携带的物品太多，无法继续任务。 -";
		close;
	}
	if (isbegin_quest(7645) == 0 && isbegin_quest(7650) == 0 && ep15_1_atnad != 19) {
		mes "没有发现特别的东西。";
		close;
	}
	else if (ep15_1_atnad == 19 && countitem(6757) < 1)
		callsub(S_Type, 1);
	else if (ep15_1_atnad == 20) {
		mes "决定把从堆中找到的“记忆记录”交给伊恩·阿特纳德博士。";
		mes "现在只剩下一张难以阅读的纸。";
		close;
	}
	else if (ep15_1_atnad == 23 && countitem(6757) < 5)
		callsub(S_Type, 2);
	else if (countitem(6757) > 4) {
		mes "已经收集了足够的记忆记录。";
		mes "没必要再翻找垃圾堆。";
		close;
	}
	else if (isbegin_quest(7650) == 1 && countitem(6757) < 5)
		callsub(S_Type, 3);
	mes "没有发现特别的东西。";
	close;

OnTimer60000:
	stopnpctimer;
	enablenpc();
	end;

S_Type:
	.@type = getarg(0):
	if (.@type == 3)
		mes "搜索也许能找到东西。";
	else {
		mes "各种文件和办公用品堆成一堆。";
		mes "大部分文字损坏，难以阅读。";
	}
	next;
	if (select( "仔细检查。", "退出。" ) == 2) {
		mes "决定调查其他东西。";
		close;
	}
	progressbar "ffff00",3;
	disablenpc();
	initnpctimer;
	getitem 6757,1;// Memory_Record

	switch(.@type) {
	case 1:
		mes "你翻找文件和办公用品时发现了从未见过的物品。";
		mes "^4d4dff需要确认它是否具有足够研究价值，才能带回给伊恩·阿特纳德博士。^000000";
		erasequest 7642;// Explore Research facilities
		setquest 7643;// Mysterious Piece
		ep15_1_atnad = 20;
		close;
	case 2:
		mes "在文件堆之间找到了记忆记录。";
		mes "似乎有人故意把它藏在那里。";
		close;
	case 3:
		mes "找到了记忆记录。";
		close;
	}
	end;
}

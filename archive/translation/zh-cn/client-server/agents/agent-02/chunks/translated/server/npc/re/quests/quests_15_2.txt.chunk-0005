				setquest 13196;// Monthly Brigan
				setquest 13197;// Monthly Brigan
				setquest 13198;// Monthly Brigan : Krotzel's Request
				close;
			case 2:
				mes "[克罗采尔]";
				mes "我会等你。";
				close;
			case 3:
				mes "[克罗采尔]";
				mes "什么是月刊布里甘？就是你知道的、可以从魔物身上获得的战利品。它不是宝石，却能带来可观收入，像冒险者的甘霖。";
				next;
				mes "[克罗采尔]";
				mes "老板的目标就是这个。不是给冒险者头奖，而是制作能提供实用情报的杂志！这似乎就是目的。";
				close;
			}
			end;
		case 1:
			if (isbegin_quest(13195) > 0 || isbegin_quest(13196) > 0 || isbegin_quest(13197) > 0) {
				mes "我该确认大家是否安全。请去看看三个人是否都在努力工作。";
				close;
			}
			mes "今天大家都安全。因为我们是冒险队2组！谢谢你的帮助！";
			close2;
			erasequest 13198;// Monthly Brigan : Krotzel's Request
			setquest 13199;// Krotzel's Request - Complete
			getexp 1000000,500000;
			end;
		case 2:
			mes "[克罗采尔]";
			mes "我该确认大家是否安全。";
			close;
		}
		end;
	case 0:
	case 1:
		mes "看来他们还在工作。我很担心，但我也该专心工作！我们是月刊布里甘冒险队2组！";
		close;
	}
}

verus02,134,169,4	script	Photo Journalist#1	4_F_GON,{
	if (ep15_2_brigan < 4 || ep15_2_brigan == 6 || ep15_2_brigan == 7) {
		mes "[桑妮·金]";
		mes "月刊布里甘的资深摄影记者……啊哈！魔物不断出现！很危险！";
		close;
	}
	if (ep15_2_brigan == 4) {
		mes "[桑妮·金]";
		mes "克罗采尔？你是说我的搭档。我还要拍下酷炫的建筑风格和魔物。告诉她我没事。";
		close2;
		erasequest 13196;// Monthly Brigan
		ep15_2_brigan = 5;
		end;
	}
	if (ep15_2_brigan == 5) {
		mes "[桑妮·金]";
		mes "我以为自己在地面上做了很多工作，但这里让我印象深刻！我要把一切尽收掌中！";
		close;
	}
	switch( select( "询问是否安全", "有什么需要帮忙吗？", "交谈" ) ) {
	case 1:
		mes "[桑妮·金]";
		if (isbegin_quest(13196) == 0) {
			mes "地下怎么会有如此不可思议的建筑？越了解就越好奇。";
			close;
		}
		mes "当然！我在下面吃了很多苦！我还在拍照。告诉她准备好后我就回去。";
		close2;
		erasequest 13196;
		end;
	case 2:
		mes "[桑妮·金]";
		switch( checkquest(13203,PLAYTIME) ) {
		case -1:
		case 2:
			switch( checkquest(13202,HUNTING) ) {
			case -1:
				mes "正义的冒险者，你愿意帮我吗？";
				next;
				if (select( "帮助摄影记者桑妮·金", "拒绝" ) == 1) {
					mes "[桑妮·金]";
					mes "我要拍摄酷炫建筑、活跃魔物和冒险者！我有两个拍摄主题，你可以帮其中一个！";
					next;
					mes "[桑妮·金]";
					mes "帮我处理周围的魔物。我会把它们拍下来！这样我就能安心拍摄了！";
					if (isbegin_quest(13203))
						erasequest 13203;// Photo Journalist's Request - Complete
					setquest 13202;// Monthly Brigan : Photo Journalist's Request
				}
				close;
			case 0:
			case 1:
				mes "所以你要站在那里处理魔物！尽量做出有活力、大幅度的动作！照片需要合适的概念。";
				close;
			case 2:
				mes "多亏了你，我想一定能创作出优秀作品！我要回去拍建筑了。";
				erasequest 13202;// Monthly Brigan : Photo Journalist's Request
				setquest 13203;// Photo Journalist's Request - Complete
				getexp 1000000,500000;
				close;
			}
		case 0:
		case 1:
			mes "我拍了很多照片，但需要时间确认。有些可能失焦，或者需要更好的照片，下次再说。";
			close;
		}
	case 3:
		mes "[桑妮·金]";
		mes "我不可能总拍出好照片。摄影捕捉瞬间，却能长久保存时刻。这就是摄影之美！";
		close;
	}
}

verus01,41,103,4	script	Exhausted Journalist#1	52,{
	if (ep15_2_brigan < 6) {
		mes "[格里尔斯]";
		mes "哈哈，你是冒险者吗？我是格里兹利·格里尔斯！喜欢冒险的记者。";
		close;
	}
	if (ep15_2_brigan == 6) {
		mes "[格里尔斯]";
		mes "克罗采尔担心？别开玩笑。我是资深记者格里兹利·格里尔斯！我正在享受冒险！告诉她不用担心。";
		close2;
		erasequest 13197;// Monthly Brigan
		ep15_2_brigan = 7;
		end;
	}
	if (ep15_2_brigan == 7) {
		mes "[格里尔斯]";
		mes "现在我都分不清自己是记者还是冒险者了。我因为能在任何地方生存，还得到“生存之王”的绰号！";
		close;
	}
	switch( select( "询问是否安全", "有什么需要帮忙吗？", "交谈" ) ) {
	case 1:
		mes "[格里尔斯]";
		if (isbegin_quest(13197) == 0) {
			mes "除了这里比我想象中危险！我一直努力逃跑，饿坏了。真希望有东西吃。";
			close;
		}
		mes "我正在享受冒险！告诉她不用担心。不过我有点饿……";
		close2;
		erasequest 13197;// Monthly Brigan
		end;
	case 2:
		mes "[格里尔斯]";
		switch( checkquest(13205,PLAYTIME) ) {
		case -1:
		case 2:
			if (isbegin_quest(13204) == 0) {
				mes "不是什么大事，但你有时间吗？";
				next;
				if (select( "帮助生存记者格里尔斯", "拒绝" ) == 1) {
					mes "[格里尔斯]";
					mes "我一整天都在逃跑，完全没吃东西！我发现了会吃金属的虫子。";
					next;
					mes "[格里尔斯]";
					mes "我得尝尝这些虫子。我想这也是很好的新闻素材！生存之王的烤金属虫！这就是标题！";
					setquest 13204;// Monthly Brigan : Grylls' Request
				}
				close;
			}
			if (countitem(11597) < 30) {
				mes "啃食金属的虫子。不知道味道如何。我太好奇了！这就是我无法放弃记者工作的原因。";
				close;
			}
			mes "我现在就要烹饪！一想到味道我就流口水！";
			delitem 11597,30;// Iron_Bug
			erasequest 13204;// Monthly Brigan : Grylls' Request
			if (isbegin_quest(13205) > 0)
				erasequest 13205;
			setquest 13205;// Grylls' Request - Complete
			getexp 1000000,500000;
			close;
		case 0:
		case 1:
			mes "我正忙着烹饪这些虫子。你也想尝一口吗？";
			close;
		}
	case 3:
		mes "[格里尔斯]";
		mes "居然有啃食金属的虫子！但它们一定是珍贵的蛋白质来源，营养很高！";
		close;
	}
}

verus01,172,146,4	script	Lame Journalist#1	4_M_HUBOY,{
	if (ep15_2_brigan < 2 || ep15_2_brigan > 3 && ep15_2_brigan < 8) {
		mes "[新手记者]";
		mes "你好！我是新手记者特拉普！属于月刊布里甘冒险队2组！即使危险也会报道新闻！";
		close;
	}
	if (ep15_2_brigan == 2) {
		mes "[新手记者]";
		mes "你好！我是特拉普！月刊布里甘冒险队2组最新成员！前辈担心吗？我会报道完这条新闻回来！";
		close2;
		erasequest 13195;// Monthly Brigan
		ep15_2_brigan = 3;
		end;
	}
	if (ep15_2_brigan == 3) {
		mes "[新手记者]";
		mes "请告诉她别太担心！我现在也是记者了！不过你有时间的话，我想请你帮个忙。我的意思是以后。";
		close;
	}
	switch( select( "询问是否安全", "有什么需要帮忙吗？", "交谈" ) ) {
	case 1:
		mes "[新手记者]";
		if (isbegin_quest(13195) == 0) {
			mes "格里尔斯有“生存之王”的绰号！因为他能在最极端的地方生存！我想成为那样帅气的记者。";
			close;
		}
		mes "她真的很担心我！告诉她格里尔斯的工作结束后我就跟上！";
		close2;
		erasequest 13195;// Monthly Brigan
		end;
	case 2:
		mes "[新手记者]";
		switch( checkquest(13201,PLAYTIME) ) {
		case -1:
		case 2:
			switch( checkquest(13200,HUNTING) ) {
			case -1:
				mes "我鼓起勇气跟着他，但那里很危险。可以的话能帮我吗？";
				next;
				if (select( "帮助新手记者特拉普", "拒绝" ) == 1) {
					mes "[新手记者]";
					mes "请帮我消灭魔物！我已经尽力，但还不习惯。拜托你了。";
					if (isbegin_quest(13201))
						erasequest 13201;
					setquest 13200;
				}
				close;
			case 0:
			case 1:
				mes "因为“生存之王”这个绰号，我以为格里兹利擅长战斗，但他其实只是擅长生存。魔物一出现，他就像风一样消失了。";
				close;
			case 2:
				mes "你已经消灭这么多了吗？我还没完成，但谢谢你！";
				erasequest 13200;// Monthly Brigan : Rookie's Request
				setquest 13201;// Rookie's Request - Complete
				getexp 1000000,500000;
				close;
			}
		case 0:
		case 1:
			mes "我正在努力成为专业的生存记者！虽然……现在还不行，但可以的话请之后再来！";
			close;
		}
	case 3:
		mes "[新手记者]";
		mes "认识世界的真相与正义是记者的使命！无论困难和环境如何，我们都要守护它们！";
		close;
	}
}


// Memory record
un_bunker,382,335,3	script	Box#e152p00	4_ENERGY_BLUE,{
	if (checkweight(1301,3) == 0) {
		mes "- 你携带的物品太多，无法继续任务。-";
		close;
	}
	.@npc_name$ = strnpcinfo(1);
	if (ep15_1_atnad == 27 && countitem(6824) < 5) {
		if (.@npc_name$ == "Box")
			mes "这是一个封装松散的箱子。";
		else if (.@npc_name$ == "Under desk")
			mes "桌子下面似乎有闪闪发光的东西。";
		else if (.@npc_name$ == "Machine Remains") {
			mes "各种机器残骸堆成一堆。";
			mes "静止的机器残骸中似乎有熟悉的物品。";
		}
		else if (.@npc_name$ == "Thicket") {
			mes "灌木不顾身处地下和室内，肆意生长。";
			mes "灌木下面有东西在发光。";
		}
		else if (.@npc_name$ == "Organized food tray")
			mes "餐盘整齐地堆叠在一起。";
		else if (.@npc_name$ == "Document pile") {
			mes "各种文件和办公用品堆成一堆。";
			mes "大部分文字损坏，难以阅读。";
		}
		next;
		if (select( "仔细检查。", "退出。" ) == 2) {
			mes "决定调查其他东西。";
			close;
		}
		progressbar "ffff00",3;
		disablenpc();
		initnpctimer;
		if (.@npc_name$ == "Box") {
			mes "在箱子里找到了记忆记录。";
			mes "似乎是在包装其他东西时掉进去的。";
		}
		else if (.@npc_name$ == "Under desk")
			mes "找到了记忆记录。";
		else if (.@npc_name$ == "Machine Remains")
			mes "在机器残骸中找到了记忆记录。";
		else if (.@npc_name$ == "Thicket")
			mes "在灌木中找到了记忆记录。";
		else if (.@npc_name$ == "Organized food tray") {
			mes "在整齐堆叠的餐盘之间找到了记忆记录。";
			mes "难道是在整理餐盘时掉进去的？";
		}
		else if (.@npc_name$ == "Document pile") {
			mes "在文件堆之间找到了记忆记录。";
			mes "似乎有人故意把它藏在那里。";
		}
		getitem 6824,1;	// Lab_Memory_Record
		close;
	}
	if (countitem(6824) > 4) {
		if (.@npc_name$ == "Box")
			mes "这个箱子的记忆记录已经收集。";
		else if (.@npc_name$ == "Under desk") {
			mes "已经收集了足够的记忆记录。";
			mes "没必要继续爬来爬去寻找。";
		}
		else if (.@npc_name$ == "Machine Remains") {
			mes "已经收集了足够的记忆记录。";
			mes "没必要再翻找垃圾堆。";
		}
		else if (.@npc_name$ == "Thicket") {
			mes "已经收集了足够的记忆记录。";
			mes "没必要继续翻找灌木。";
		}
		else if (.@npc_name$ == "Organized food tray") {
			mes "已经收集了足够的记忆记录。";
			mes "没必要再逐一翻找餐盘。";
		}
		else if (.@npc_name$ == "Document pile") {
			mes "已经收集了足够的记忆记录。";
			mes "没必要再翻找文件堆。";
		}
		close;
	}
	if (isbegin_quest(7652) != 1) {
		mes "没有发现特别的东西。";
		close;
	}
	mes "搜索也许能找到东西。";
	next;
	if (select( "仔细检查。", "退出。" ) == 2) {
		mes "决定调查其他东西。";
		close;
	}
	progressbar "ffff00",3;
	disablenpc();
	initnpctimer;
	mes "找到了记忆记录。";
	getitem 6824,1;	// Lab_Memory_Record
	close;

OnTimer30000:
	enablenpc();
	stopnpctimer;
	end;
}

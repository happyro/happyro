verus04,172,149,3	script	Commander Arquien#e152v01	4_F_EDEN_MASTER,{
	mes "[Nile]";
	if (ep15_1_atnad < 23) {
		cutin "Arquien_n_atnad01.bmp",2;
		mes "我只是……不想让别人知道我在那里……";
		mes "有事的话，我们就在伊甸园集团办公室正式见面。";
		close3;
	}

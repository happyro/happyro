						select("你说这是紧急的事！！！" );
						mes "[Leo]";
						mes "如果吃不到它们，我感觉自己会死！！！";
						mes "还有什么比这更紧急？！！？！";
						next;
						mes "[Leo]";
						mes "反正你经常去斯普兰迪德！";
						mes "回来的路上，腋下夹一罐，手里再拿一罐，拜托了~";
						mes "我以后再也不会这样拜托你了！";
						next;
						mes "[Leo]";
						mes "所以……你答应了吗？";
						mes "我需要3罐捕虫堇腌果，再要3罐萤光蜂蜜果酱~";
						mes "它们在斯普兰迪德基地内出售。";
						setquest 7420;
						next;
						mes "[Leo]";
						mes "购买腌果和蜂蜜果酱可能需要斯普兰迪德硬币。";
						mes "在斯普兰迪德工作就能赚到硬币，所以……嘿嘿……";
						next;
						mes "[Leo]";
						mes "帮助斯普兰迪德最终也是在帮助艾克拉治。";
						mes "现在，出发吧！";
						close;
					}
				case 2:
					mes "[Leo]";
				mes "哦……不。我不是奇怪的拉斐内人。";
				mes "你误会我了。这是误会……";
					close;
				}
			case 1:
				mes "[Leo]";
				if (countitem(12344) < 3 || countitem(12345) < 3) {
					mes "我需要3罐捕虫堇腌果，再要3罐萤光蜂蜜果酱~";
					mes "它们是斯普兰迪德基地的特产。";
					mes "拜托你了！";
					close;
				}
				emotion ET_SPARK;
				mes "哦哦哦，看看这个！！！";
				mes "甜甜的腌果，还有更甜的蜂蜜果酱！！！";
				mes "你救了我的命。";
				mes "真不知道没有这些甜食我是怎么活下来的！";
				next;
				mes "[Leo]";
				mes "我应该重新评价你了。";
				mes "看来朱恩市长确实很会看人。";
				mes "他毕竟是市长……";
				next;
				delitem 12344,3;// Pinguicula's_fruit_Jam
				delitem 12345,3;// Luciola's_Honey_Jam
				completequest 7420;
				getexp 200000,200000;
				if ((isbegin_quest(7420) + isbegin_quest(7419) + isbegin_quest(7418)) > 5) {
					mes "[Eclage Guard]";
					mes "给你。";
					mes "朱恩市长说你已经做得够多了，让我来找你。";
					mes "利奥的工作你也完成了吗？";
					cutin "minuel01",4;
					next;
					mes "[Eclage Guard]";
					mes "我明白了。";
					mes "那我告诉你他的话。";
					next;
					mes "[Eclage Guard]";
					mes "虽然你可能还想为艾克拉治做更多工作，";
					mes "但我认为你已经做得够多了。";
					mes "事实上这并不重要，我只是想让你做这件事。";
					next;
					mes "[Eclage Guard]";
					mes "就是这样。";
					mes "他说你听到这些就会明白。恕我先告辞……";
					ep14_2_mylord = 8;
					changequest 7417,7421;
					next;
					cutin "",255;
					mes "[Leo]";
					mes "嗯，他就是这么说的。";
					mes "虽然我是请求你帮忙的人，说这些可能不合适，";
					mes "但我不明白市长为什么这么做。";
					next;
				}
				if (checkquest(7423) == -1)
					callsub S_Setquest7423;
				else {
					mes "[Leo]";
					mes "不管怎样，我会把你的事报告给上级，你迟早会收到他们的消息。";
				}
				close2;
				cutin "",255;
				end;
			default:
				if ((isbegin_quest(7420) + isbegin_quest(7419) + isbegin_quest(7418)) > 5) {
					mes "[Eclage Guard]";
					mes "给你。";
					mes "朱恩市长说你已经做得够多了，让我来找你。";
					mes "利奥的工作你也完成了吗？";
					cutin "minuel01",4;
					next;
					mes "[Eclage Guard]";
					mes "我明白了。";
					mes "那我告诉你他的话。";
					next;
					mes "[Eclage Guard]";
					mes "虽然你可能还想为艾克拉治做更多工作，";
					mes "但我认为你已经做得够多了。";
					mes "事实上这并不重要，我只是想让你做这件事。";
					next;
					mes "[Eclage Guard]";
					mes "就是这样。";
					mes "他说你听到这些就会明白。恕我先告辞……";
					ep14_2_mylord = 8;
					changequest 7417,7421;
					next;
					cutin "",255;
					mes "[Leo]";
					if (checkquest(7423) == -1) {
						mes "我不想知道他告诉你的事。";
						mes "我只是猜测你和朱恩市长之间有什么阴谋。";
						mes "他到底在想什么……";
						next;
						callsub S_Setquest7423;
					}
					else {
						mes "别再谈朱恩市长了。";
						mes "想想你现在要做什么吧。";
					}
					close;
				}
				mes "[Leo]";
				if (checkquest(7423) == -1) {
					mes "嗯……你和朱恩市长参与了某种阴谋吗？";
					mes "越想越觉得有事情发生。";
					mes "他到底在想什么……";
					next;
					callsub S_Setquest7423;
				}
				else {
					mes "蜂蜜果酱和腌果真好吃。";
					mes "基地里的家伙一定每天都在享用这些。";
					next;
					mes "[Leo]";
					mes "我已经把你协助的事报告给上级了。";
					mes "别担心。";
					mes "我想迟早还会再见到你。";
				}
				close;
			}
		}
		else {
			.@total = isbegin_quest(7423) + isbegin_quest(7424) + isbegin_quest(7425) + isbegin_quest(7426);
			if (checkquest(7423) == -1) {
				mes "[Leo]";
				mes "嗯……你和朱恩市长参与了某种阴谋吗？";
				mes "越想越觉得有事情发生。";
				mes "他到底在想什么……";
				next;
				callsub S_Setquest7423;
				.@quest7423 = 1;
			}
			if (ep14_2_mylord == 10) {
				if (.@total > (3 -.@quest7423)) {
					mes "[Leo]";
					if (.@quest7423 == 0) {
						mes "别再谈朱恩市长了。";
						mes "想想你现在要做什么吧。";
						next;
					}
				mes "据你所知，拉斐内人表面上对卡尔杜伊的评价还不错。";
				mes "但实际上，大多数拉斐内人对他感到不安、不信任和怀疑。";
				mes "别再担心了，直接去问卡尔杜伊吧！";
					ep14_2_mylord = 11;
					erasequest 7423;
					erasequest 7424;
					erasequest 7425;
					changequest 7426,7427;
				}
				else {
				mes "利奥似乎不信任他们的国王卡尔杜伊。";
				mes "如果有机会，你也可以听听其他拉斐内人的意见。";
				}
			}
			else {
				mes "[Leo]";
				mes "别再谈朱恩市长了。";
				mes "想想你现在要做什么吧。";
				next;
				mes "[Leo]";
				mes "对了，彩虹桥塔一定是怪物的制造机。";
				mes "消灭一个就会出现另一个，如此循环……";
				mes "就像拼命冲刺后，却发现自己又站回起点。";
			}
		}
		close;
	}
	mes "[Leo]";
	if (BaseLevel < 120) {
		mes "欢迎来到艾克拉治。";
		mes "- ,"+ strcharinfo(0) +"who recently became famous.";
		next;
		mes "[Leo]";
		mes "如果你的等级更高，我就能带你走一条适合散步的路线……";
		mes "真遗憾。";
		close;
	}
	.@daytime = checkquest(7433,PLAYTIME);
	if (.@daytime == 0) {
		mes "它们永远不会疲惫。";
		mes "旅行者不断投诉安全问题。";
		mes "说真的……它们太烦人了。";
		next;
		mes "[Leo]";
		mes "下次巡逻时，请消灭它们。";
		mes "呼……";
	}
	else if (.@daytime == 2) {
		erasequest 7433;
		mes "因为我们巡逻时会压制它们，";
		mes "幸好旅行者的投诉少了。";
		next;
		mes "[Leo]";
		mes "如果你不介意，我们再去巡逻一次吧。";
	}
	else {
		switch( checkquest(7432,HUNTING) ) {
		case 2:
			mes "你又做得很好。";
			mes "给，这是奖励。";
			next;
			mes "[Leo]";
			mes "如果愿意，明天这个时候再来吧。";
			mes "我会确保你的位置。当然，你的工作是在花田巡逻。";
			mes "哈哈哈！";
			changequest 7432,7433;
			getexp 200000,200000;
			getitem 6081,1;// Splendide_Coin
			break;
		case 1:
			mes "5 bodies of Menblatt and Fetal, each.";
			mes "你知道吗？";
			next;
			mes "[Leo]";
			mes "说实话，曼布勒特不是很漂亮吗？";
			mes "真想知道它怎么会变得这么……漂亮。";
			mes "拉斐内人？不，它们不是拉斐内人。";
			next;
			mes "[Leo]";
			mes "花瓣？花瓣也很可爱。";
			mes "我想在尤艾里养一只。";
			mes "但是……你也看到了。";
			next;
			mes "[Leo]";
			mes "它们会践踏花坛！";
			mes "所以绝不能接受……";
			break;
		case -1:
			mes "今天过得怎么样？";
			mes "我有一项对你来说不错又有益的工作。";
			mes "就是消灭出现在花田里的曼布勒特和花瓣。";
			next;
			mes "[Leo]";
			mes "许多旅行者投诉那些家伙无缘无故骚扰他们。";
			mes "你愿意做吗？";
			next;
			switch( select("我去！我来做！我来消灭它们！：今天没心情。：你不想要腌果吗？") ) {
				mes "[Leo]";
			case 1:
				mes "看看你的战斗精神！";
				mes "好，我们走！当然！只有你去！";
				mes "去惩罚骚扰旅行者、践踏花坛的曼布勒特和花瓣吧！";
				setquest 7432;
				next;
				mes "[Leo]";
				mes "你必须惩罚5只曼布勒特和5只花瓣。";
				mes "它们会在艾克拉治前方、彩虹桥塔所在的花田里到处活动。";
				mes "你已经知道了，对吧？";
				close;
			case 2:
				mes "啊……你不想做吗？";
				mes "那我只能自己做。";
				mes "全靠我自己……";
				close;
			case 3:
				mes "啊……腌果。";
				mes "我决定暂时不吃了。";
				mes "我吃太多了，牙痛得只能卧床。";
				mes ".........isn't it depressing.";
				close;
			}
		}
	}
	close;
S_Setquest7423:
	select("你不喜欢国王？" );
	emotion ET_THINK;
	mes "[Leo]";
	mes "不，不是我不喜欢他。我只是有点担心……或者说难以信任他……大概就是这样。";
	mes "既然他没做错什么，我也没有理由恨他，但是……";
	next;
	mes "[Leo]";
	mes "以前发生过类似的先例，";
	mes "而且是很罕见的情况……所以我有很多方面的担忧。";
	mes "这不该让你这样的外来者烦恼。";
	setquest 7423;
	return;
}

ecl_fild01,205,86,3	script	Eclage Messenger Roy#tl	4_M_FAIRYSOLDIER2,{
	if (!checkweight(1301,3)) {
		mes "- 你携带的物品太多，无法继续任务。-";
		close;
	}
	.@quest_7419 = isbegin_quest(7419);
	.@alltotal = isbegin_quest(7418) + .@quest_7419 + isbegin_quest(7420);
	if (ep14_2_mylord == 7) {
		if (.@quest_7419 == 0) {
			mes "[Roy]";
			mes "很难。";
			mes "真的很难。";
			mes "越想越觉得谢尼姆脾气很坏。";
			emotion ET_SURPRISE;
			next;
			mes "[Roy]";
			mes "你在危机时刻出现，";
			mes "你穿过了雾之森林迷宫……你是神的指引，还是神的祝福？";
			next;
			mes "[Roy]";
			mes "看来我别无选择。";
			mes "据说拉斐内人没有自尊就一无是处，但我更珍惜生命而非自尊，";
			mes "能请你帮个忙吗？";
			next;
			switch( select("是什么？：不。") ) {
				mes "[Roy]";
			case 1:
				mes "这对拉斐内人来说很难，但对人类很容易。";
				mes "那就是从斯普兰迪德带来消息！";
				next;
				mes "[Roy]";
				mes "本该由我处理，但……";
				mes "我的魔力并不强。";
				next;
				mes "[Roy]";
		mes "……好了，你不需要知道细节！";
				mes "你只需从斯普兰迪德联络员那里收集邮件。";
				next;
				mes "[Roy]";
				mes "没有机密内容，所以你也能做到。";
				mes "带回一封邮件。我相信这对你很容易。";
				next;
				switch( select("交给我吧！：我不想做。") ) {
					mes "[Roy]";
				case 1:
					mes "好！";
					mes "去斯普兰迪德见联络员！";
					mes "收集没有机密内容、可能是情书的邮件！";
					mes "然后带回来给我。";
					setquest 7419;
					next;
					mes "[Roy]";
					mes "这不简单吗？";
					mes "我会站在这里等你把邮件带回来。";
					close;
				case 2:
					mes "什么？让我说了这么久后，你竟然拒绝？";
					mes "....Well, things happen.";
					mes "不过你会回来的。所以我不担心。";
					next;
					mes "[Roy]";
					mes "嘿嘿，我就知道。";
					mes "从他们选我做这份工作开始，";
					mes "一切都在‘巨大无形之手’的掌控中！！";
					close;
				}
			case 2:
				mes "啊……";
				mes "你不到一秒就拒绝了，真够明确。";
				mes "现在我要抹去这一刻的记忆！";
				next;
				mes "[Roy]";
				mes "这样我就能以全新的心情再次问你。";
				mes "啊哈哈哈……哈……哈哈……哈哈……";
				close;
			}
		}
		else if (.@quest_7419 == 1) {
			mes "[Roy]";
			if (!countitem(6552)) {
				mes "我再说明一次。";
				mes "去斯普兰迪德见联络员！";
				mes "收集没有机密内容、可能是情书的邮件！";
				mes "然后带回来给我。";
				close;
			}
			mes "就是这个，正确的邮箱。";
			mes "你做对了。";
			mes "看，这里没有重要内容。";
			mes "大多只是问候彼此近况的私人信件。";
			next;
			delitem 6552,1;// Mail_Package
			completequest 7419;
			getexp 200000,200000;
			.@sub = 1;
			if (.@alltotal < 5) {
				mes "[Roy]";
				mes "现在我要去报告这些邮件的情况。";
				mes "谢谢。";
				close;
			}
		}
		if (.@alltotal > (5 -.@sub)) {
			mes "[Eclage Guard]";
			mes "给你。";
			mes "朱恩市长说你已经做得够多了，让我来找你。";
			mes "利奥的工作你也完成了吗？";
			cutin "minuel01",4;
			next;
			mes "[Eclage Guard]";
			mes "我明白了。";
			mes "那我告诉你他的话。";
			next;
			mes "[Eclage Guard]";
			mes "虽然你可能还想为艾克拉治做更多工作，";
			mes "但我认为你已经做得够多了。";
			mes "事实上这并不重要，我只是想让你做这件事。";
			next;
			mes "[Eclage Guard]";
			mes "就是这样。";
			mes "他说你听到这些就会明白。恕我先告辞……";
			ep14_2_mylord = 8;
			changequest 7417,7421;
			next;
			cutin "",255;
			mes "[Roy]";
		mes "你听到了吗？";
		}
		else {
			mes "[Roy]";
			mes "……要是连那些罐头食品也能拿到……我们就不用这样受苦了……";
		}
		close;
	}
	mes "[Roy]";
	if (ep14_2_mylord < 7) {
		mes "我可以去莫拉村。";
		mes "但我要怎么独自穿过雾之森林？";
		mes "……啊……我只是在自怜，所以你继续赶路吧。";
	}
	else if (ep14_2_mylord == 8) {
		mes "回想一下刚才来过的守卫说的话，";
		mes "市长想见你，对吧？";
		mes "你不该去吗？";
	}
	else if (ep14_2_mylord == 9) {
		mes "说到底，我不是信使，而是邮差。";
		mes "……没错。其实我连邮差都算不上。啊……";
	}
	else {
		.@checktime = checkquest(7431,PLAYTIME);
		if (.@checktime == 0) {
			mes "无用的信太多了。";
			mes "更糟的是，异地情侣还会寄情书……";
			mes "为什么我这样的信使要听别人的爱情故事？";
			next;
			mes "[Roy]";
			mes "……我本以为成为士兵会很棒……";
			mes "所以我申请去了前线基地，却最终成了信使……";
			next;
			mes "[Roy]";
			mes "...There will be those useless love letters again after some time, right?";
			mes "你负责带来，我负责投递。也可以说我们是一对，投递搭档。";
			next;
			mes "- 从背影看，罗伊似乎很孤独。-";
		}
		else if (.@checktime == 2) {
			mes "邮箱差不多该装满了。";
		mes "……时间越久，我就越焦虑。";
			erasequest 7431;
		}
		else if (isbegin_quest(7430) == 1) {
			if (!countitem(6552)) {
				mes "从斯普兰迪德前线基地的联络员那里";
				mes "收集邮箱。";
				mes "这不简单吗？";
				close;
			}
			mes "嗯……又装满了无用的问候信，";
			mes "还有炫耀动物角的信。";
			mes "谢谢。";
			next;
			mes "[Roy]";
			mes "既然你做得这么好，";
			mes "我会负责在艾克拉治投递邮件，";
		mes "……以后请定期和我一起工作，好吗？";
			next;
			mes "[Roy]";
			mes "答应我以后还会和我一起工作。";
			mes "这是给你的小礼物。";
			mes "期待再次见到你！";
			delitem 6552,1;// Mail_Package

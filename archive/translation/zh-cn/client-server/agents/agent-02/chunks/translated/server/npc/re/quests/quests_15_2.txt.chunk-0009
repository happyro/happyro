un_bk_q,56,286,4	script	Mechanician Mugeosi#EP15.2MR	4_M_REPAIR,{
	callfunc( "F_time_limit_recorder", .@cooldown_status_day );
	if (.@cooldown_status_day[0] == 1) {
		mes "[机械师穆高西]";
		mes "你是冒险者吗？这里是机器仓库。";
		next;
		mes "[机械师穆高西]";
		mes "这里原本是仓库，现在被机械师用来组装防空洞机器。";
		next;
		emotion 6;
		mes "[机械师穆高西]";
		mes "你想知道机械师总数？我想我不知道。";
		next;
		mes "[机械师穆高西]";
		mes "啊！上面的阿尔可能知道。去找阿尔。";
		close;
	}
	if ((.@cooldown_status_day[0] + .@cooldown_status_day[1] + .@cooldown_status_day[2] + .@cooldown_status_day[3] + .@cooldown_status_day[4]) == 0) {
		mes "[机械师穆高西]";
		mes "要帮忙移动空气净化器？";
		next;
		mes "[机械师穆高西]";
		mes "你看起来像其他研究员说的那样强壮。我敢说你能轻松搬起空气净化器！！";
		next;
		mes "[机械师穆高西]";
		mes "我们不该命令像你这样被卷入事故的人，但情况紧急。";
		next;
		mes "[机械师穆高西]";
		mes "之前运行的空气净化器坏了，所以我们制作了新的。";
		next;
		mes "[机械师穆高西]";
		mes "我们本该做成模块化，却误做成了一个整体。";
		next;
		emotion 18;
		mes "[机械师穆高西]";
		mes "制作时根本没想到这一点！！";
		next;
		mes "[机械师穆高西]";
		mes "这种事会发生。对吧？";
		next;
		mes "[机械师穆高西]";
		mes "设施管理员正吵着急需空气净化器。";
		next;
		mes "[机械师穆高西]";
		mes "用现有设备无法移动空气净化器……";
		next;
		mes "[机械师穆高西]";
		mes "如果有更多时间，我们可以制造运输它的机器……";
		next;
		mes "[机械师穆高西]";
		mes "所以最后只能请强大的冒险者帮忙。";
		next;
		select("是，先生。");
		emotion 18;
		mes "[机械师穆高西]";
		mes "你真让人精神振奋！！";
		next;
		if (isbegin_quest(5370) == 1)
			erasequest 5370;
		setquest 5351;
		setquest 5352;
		mes "[机械师穆高西]";
		mes "拜托你了。把5台空气净化器送到C-0、F-1、F-2、I-0、Z-0区域。准备好后和我说话。";
		close;
	}
	if (.@cooldown_status_day[1] == 1) {
		.@quest_day_2 = isbegin_quest(5352) + isbegin_quest(5353) + isbegin_quest(5354) + isbegin_quest(5355) + isbegin_quest(5356) + isbegin_quest(5357);
		if (.@quest_day_2 > 0 && .@quest_day_2 < 6) {
			emotion 1;
			mes "[机械师穆高西]";
			mes "准备好搬运重物了吗？";
			next;
			select("交给我。");
			if ((MaxWeight - Weight) < 10000) {
				mes "[机械师穆高西]";
				mes "你看起来很强，但似乎力气不够。这样无法搬起空气净化器。";
				close;
			}
			getitem 6825,1;
			mes "[机械师穆高西]";
			mes "把它们送到C-0、F-1、F-2、I-0、Z-0区域。顺序不重要，但它们是精密机器，请小心。";
			close;
		}
		if (.@quest_day_2 == 6) {
			emotion 21;
			mes "[机械师穆高西]";
			mes "做得好。空气净化器很重，对吧？";
			next;
			mes "[机械师穆高西]";
			mes "赛赫说冒险者喜欢这种东西，给你工作后我应该用这个作为补偿。";
			next;
			for ( .@i = 5352; .@i < 5358; .@i++ ) {
				if (isbegin_quest(.@i) > 0)
					erasequest .@i;
			}
			ep15_2_memory = 0;
			setquest 5370;
			getexp 1000000,1000000;
			mes "小圆胶囊渗入皮肤，感觉经验积累起来了。";
			next;
			mes "[机械师穆高西]";
			mes "多亏你我们度过了危机。我需要制造一台能搬运重物的机器，以防再次发生这种事。";
			close;
		}
		mes "[机械师穆高西]";
		mes "做得好。现在先休息吧。";
		close;
	}
	if (.@cooldown_status_day[2] == 1) {
		mes "[机械师穆高西]";
		mes "你尝过生物工程师用那个生长装置培育的葡萄吗？";
		next;
		mes "[机械师穆高西]";
		mes "现在我们能在这沉闷昏暗的防空洞里吃到新鲜水果了。";
		close;
	}
	if (.@cooldown_status_day[3] == 1) {
		mes "[机械师穆高西]";
		mes "有人突然攻击，你担心了吗？什么？你没被感染吧？";
		close;
	}
	if (.@cooldown_status_day[4] == 1) {
		mes "[机械师穆高西]";
		mes "为什么大家都反对我们制造方便运输的机器？切！！";
		close;
	}
	// unknown text
	end;
}


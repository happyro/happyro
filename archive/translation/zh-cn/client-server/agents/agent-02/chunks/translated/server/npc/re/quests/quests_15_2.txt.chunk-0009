		.@quest_day_3 = isbegin_quest(5359) + isbegin_quest(5360) + isbegin_quest(5361) + isbegin_quest(5362);
		switch(.@quest_day_3) {
		case 2:
			if (isbegin_quest(5360) != 1) {
				mes "[机械师阿尔]";
				mes "那串葡萄是给我的吗？不是？切！！";
				close;
			}
			mes "[机械师阿尔]";
			mes "什么？葡萄？你要送这个？";
			next;
			emotion 23;
			mes "[机械师阿尔]";
			mes "你是用手一颗颗摘的吗？";
			next;
			mes "[机械师阿尔]";
			mes "为什么做这么麻烦的工作？你可以让我们制造采葡萄机器……";
			next;
			mes "[机械师阿尔]";
			mes "谢谢你。这是补偿。弗雷斯说要补偿那些被迫卷入事故的冒险者。";
			next;
			if (isbegin_quest(5359) > 0)
				erasequest 5359;
			if (isbegin_quest(5360) > 0)
				erasequest 5360;
			if (isbegin_quest(5361) > 0)
				erasequest 5361;
			if (isbegin_quest(5362) > 0)
				erasequest 5362;
			setquest 5370;
			getexp 1000000,1000000;
			mes "- 小圆胶囊渗入皮肤，感觉经验积累起来了。";
			next;
			mes "[机械师阿尔]";
			mes "见到埃布里克就告诉他谢谢葡萄。";
			close;
		default:
			mes "[机械师阿尔]";
			mes "见到埃布里克就告诉他谢谢葡萄。";
			close;
		}
	}
	if (.@cooldown_status_day[3] == 1) {
		mes "[机械师阿尔]";
		mes "太忙了。这就是我最初要求增加人手的原因。现在看来没用了。";
		close;
	}
	if (.@cooldown_status_day[4] == 1) {
		.@quest_day_5 = isbegin_quest(5367) + isbegin_quest(5368) + isbegin_quest(5369);
		switch(.@quest_day_5) {
		case 1:
			mes "[机械师阿尔]";
			mes "嗯？怎么回事？";
			next;
			mes "[机械师阿尔]";
			mes "什么？物品不是应该运到Z-2区而不是这里吗？把它们带到那里。";
			close;
		case 2:
			mes "[机械师阿尔]";
			mes "嗯？怎么回事？ 我听说冒险者被用来搬运补给？";
			next;
			select("埃尔农的消息……");
			mes "[机械师阿尔]";
			mes "埃尔农？货物管理员埃尔农？他有消息给我？是什么？";
			next;
			input .@string$;
			if (isbegin_quest(5369) == 0)
				setquest 5369;
			if (.@string$ == "You idiots!! Stop wasting material with stupid machines!!")
				ep15_2_memory = 1;
			else
				ep15_2_memory = 0;
			mes "[" + strcharinfo(0) + "]";
			mes "" + .@string$ + "";
			next;
			emotion 57;
			mes "[机械师阿尔]";
			mes "嗯……呃……吧……吧……";
			next;
			mes "他似乎受到了惊吓，神志不清。消息送到后回去找埃尔农。";
			close;
		case 3:
			emotion 57;
			mes "[机械师阿尔]";
			mes "嗯……呃……吧……吧……";
			next;
			mes "他神志不清。消息送到后回去找埃尔农。";
			close;
		default:
			emotion 57;
			mes "[机械师阿尔]";
			mes "埃……尔农……啊……啊！！";
			next;
			mes "他像感染的病人一样抽搐。";
			close;
		}
	}
	mes "[机械师阿尔]";
	mes "太忙了。这就是我最初要求增加人手的原因。现在看来没用了。";
	close;
}


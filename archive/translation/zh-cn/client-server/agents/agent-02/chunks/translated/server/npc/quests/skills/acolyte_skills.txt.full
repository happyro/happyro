//===== rAthena Script =======================================
//= Acolyte Skill Quest
//===== By: ==================================================
//= kobra_k88
//===== Current Version: =====================================
//= 1.8
//===== Compatible With: ===================================== 
//= rAthena Project
//===== Description: ========================================= 
//= Quest for skills: Holy Light
//===== Additional Comments: ================================= 
//= 1.5 Rescripted to Aegis 10.3 stadards. [L0ne_W0lf]
//= 1.6 Fixed a typo in job check. (Bugreport:1531) [L0ne_W0lf]
//= 1.7 Updated to latest available official file. [Masao]
//= 1.8 Fixed JobLevel requirements. [Euphy]
//============================================================

prt_church,173,23,4	script	Cleric	79,{
	mes "[Acolyte Klift]";
	mes "啊，兄弟们！照顾";
	mes "迷途羔羊的任务";
	mes "是否让你们疲惫不堪？";
	mes "我来帮助你们。";
	next;
	switch (select("^3355FF‘关于服事的隐藏能力’^000000……:^3355FF‘神圣之光’^000000训练:结束对话")) {
	case 1:
		mes "[Acolyte Klift]";
		mes "我们教会的成员";
		mes "会随着成长自然学会技能。";
		mes "当服事接近资深阶段时，";
		mes "便能掌握这项特殊技能。";
		mes "这就是我们所说的能力。";
		next;
		mes "[Acolyte Klift]";
		mes "面对巨大的危险和";
		mes "与邪恶无休止的斗争，";
		mes "我们的同伴非常需要帮助。";
		mes "^3355FF‘神圣之光’^000000就是那项技能。";
		mes "要获得这项能力，";
		mes "还需要付出一些努力。";
		next;
		mes "[Acolyte Klift]";
		mes "要获得技能，你必须找到这些物品。";
		mes "^FF33551 Opal^000000";
		mes "^FF33551 Crystal Blue^000000";
		mes "^FF33551 Rosary^000000 ";
		next;
		mes "[Acolyte Klift]";
		mes "想要使用这项技能，";
		mes "必须拥有足够的经验。";
		mes "^FF3355 Job Level 30^000000";
		mes "才能学习这项技能。";
		next;
		mes "[Acolyte Klift]";
		mes "至于祭司，由于他们";
		mes "已经拥有丰富经验，";
		mes "任何职业等级都能";
		mes "获得这项技能。";
		close;
	case 2:
		if (getskilllv("AL_HOLYLIGHT") == 1) {
			mes "[Acolyte Klift]";
			mes "兄弟，你已经拥有";
			mes "‘神圣之光’技能了。";
			mes "你无法再次获得";
			mes "已经拥有的技能……";
			mes "愿你将这项技能";
			mes "用于行善……";
			close;
		}
		if ((countitem(727) > 0) && (countitem(991) > 0) && (countitem(2608) > 0) && (JobLevel > 29 || (BaseJob == Job_Priest || BaseJob == Job_Monk)) && (BaseClass == Job_Acolyte)) {
			mes "[Acolyte Klift]";
			mes "你的信仰已经证明";
			mes "你值得获得‘神圣之光’技能。";
			mes "你的能力足以";
			mes "使用这项技能。";
			mes "请明智地使用它……";
			next;
			delitem 727,1; //White_Jewel
			delitem 991,1; //Crystal_Blue
			delitem 2608,1; //Rosary
			skill "AL_HOLYLIGHT",1,SKILL_PERM;
			mes "[Acolyte Klift]";
			mes "你现在学会了‘神圣之光’。";
			mes "愿你只将这项技能";
			mes "用于正道……";
			close;
		}
		mes "[Acolyte Klift]";
		mes "哦，很明显……";
		mes "你还没有准备好";
		mes "接受‘神圣之光’技能。";
		next;
		mes "[Acolyte Klift]";
		mes "你应该仔细听清";
		mes "学习这项技能所需的一切。";
		mes "认真聆听，";
		mes "你就能知道自己的不足，";
		mes "从而不断提升自己。";
		close;
	case 3:
		mes "[Acolyte Klift]";
		mes "……";
		mes "我理解你的热忱。";
		mes "你还有很多时间";
		mes "练习并积累经验。";
		mes "愿祝福与你同在……";
		close;
	}
}


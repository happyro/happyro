		mes "["+strcharinfo(0)+"]";
	mes "这是否意味着你就是";
	mes "制造伊米尔之心仿制品的人？";
		next;
		mes "[Herico]";
		mes "嗯，我只是贤者 Varmunt 的助手，";
		mes "不能说是我创造了它。";
		next;
		mes "[Herico]";
		mes "雷根贝勒一直在秘密收集 ^FF0000伊米尔之心碎片^000000。";
		mes "他们非常痴迷于碎片，";
		mes "我想是因为碎片内部蕴含着巨大力量。";
		next;
		mes "[Herico]";
		mes "不过，原始心之碎片的力量";
		mes "太强，人类无法控制。";
		mes "因此不可能把这种力量";
		mes "作为能源使用。";
		mes "所以才制造了 ^3131FF伊米尔之心";
		mes "碎片的仿制品^000000。";
		next;
		mes "[Herico]";
		mes "包括贤者 Varmunt 在内的研究员，";
		mes "长期努力研究和分析这种革命性能源。";
		mes "我们的努力终于结出硕果：";
		mes "伊米尔之心碎片的仿制品。";
		next;
		mes "[Herico]";
		mes "凭借这项发明，我们能够制造守护者。";
		mes "我们终于实现梦想，";
		mes "为此感到非常开心。";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "但是贤者 Varmunt 反对将守护者用于军事目的，";
		mes "我听说他还参加了佣兵叛乱。";
		next;
		mes "- 你告诉他自己所知道的佣兵叛乱。-";
		next;
		mes "[Herico]";
		mes "嗯……我明白了。";
		next;
		mes "[Herico]";
		mes "成功制造伊米尔之心碎片仿制品后，";
		mes "贤者 Varmunt 不知为何显得很沮丧。";
		mes "后来他离开实验室，说 ^3131FF如果继续";
		mes "留在 Regenschirm 实验室";
		mes "会让所有人痛苦^000000。";
		mes "我至今也不明白他为什么这么说。";
		next;
		mes "[Herico]";
		mes "他是一位伟大的学者。";
		mes "总是努力将科学知识用于人类。";
		next;
		mes "[Herico]";
		mes "果然，贤者 Varmunt 离开 Regenschirm 后，";
		mes "几乎所有研究都开始停滞。";
		mes "许多项目甚至被取消或延期。";
		next;
		cutin "heri3.bmp",2;
		mes "[Herico]";
		mes "高层受到这种现象威胁，";
		mes "于是命令所有人^FF0000无论如何继续";
		mes "研究^000000。";
		mes "他们甚至允许对";
		mes "任何活物进行实验。";
		next;
		cutin "heri1.bmp",2;
		mes "[Herico]";
		mes "......................";
		mes "这就是我离开 Regenschirm 的原因。";
		next;
		mes "[Herico]";
		mes "雷根贝勒会不择手段实现目标。";
		mes "他们已经强大到不能只被视为大企业。";
		next;
		mes "["+strcharinfo(0)+"]";
	mes "所以他们建立了“生物实验室”，";
	mes "以便在没有贤者 Varmunt 的情况下继续研究。";
		next;
		cutin "heri3.bmp",2;
		emotion ET_ANGER;
		mes "[Herico]";
	mes "什么？“生物实验室”？";
	mes "我没想到他们竟会想到这个！";
	mes "我无法表达对他们的憎恨！";
		next;
		mes "[Herico]";
	mes "科学应该造福人类，";
		mes "而不是伤害他们。我认为必须做些什么。";
		mes "能给我拿杯水吗？";
		set hg_tre,50;
		close2;
		cutin "",255;
		end;
	} else if (hg_tre == 50) {
		mes "[Herico]";
		mes "你能猜到我现在在想什么吗？";
		next;
		mes "[Herico]";
		mes "我在想^3131FF摧毁 Regenschirm^000000。";
		next;
		mes "[Herico]";
		mes "雷根贝勒已经和施瓦茨瓦尔德共和国一样强大。";
		mes "我不认为自己能摧毁整个公司。";
		mes "即使能做到，也可能导致国家覆灭，";
		mes "因为雷根贝勒对这个国家意义重大。";
		next;
		mes "[Herico]";
		mes "所以，我想摧毁“Regenschirm”。";
		mes "实验室虽然没有公司那么大，";
		mes "但对他们意义重大。";
		mes "我想阻止他们不人道且危险的研究。";
	//
		next;
		mes "[Herico]";
		mes "……*叹气*……遗憾的是，我没有力量";
		mes "继续执行计划。因此我急需你的帮助。";
		next;
		mes "[Herico]";
		mes "告诉我你的想法。";
		mes "你愿意和我一起摧毁 Regenschirm 吗？";
		next;
		switch(select("Sorry, I won't:Yes, I will.")) {
		case 1:
			mes "[Herico]";
			mes "我尊重你的决定，毕竟这不是能轻易判断的事。";
			mes "感谢你至今为我做的一切。";
			mes "如果改变主意，随时欢迎回来。";
			close2;
			cutin "",255;
			end;
		case 2:
			cutin "heri2.bmp",2;
			mes "[Herico]";
			mes "我就知道你太正直，";
			mes "不会忽视谎言与不公。";
			mes "我从你的眼神中看出来了。";
			mes "我不知道这次任务能取得多少成果，";
			mes "但至少尝试对我们很有意义。";
			next;
			mes "[Herico]";
			mes "我们进一步讨论该怎么做吧。";
			set hg_tre,51;
			close2;
			cutin "",255;
			end;
		}
	} else if (hg_tre == 51) {
		mes "[Herico]";
	mes "我们必须想办法阻止他们";
	mes "继续作恶，至少暂时阻止。";
	mes "Regenschirm 是历史悠久的实验室，";
	mes "里面保存了大量";
	mes "积累的研究数据。";
		mes "没有研究资料，";
		mes "Regenschirm 内的所有研究";
		mes "都无法继续。";
		next;
		mes "[Herico]";
		mes "Regenschirm 位于地下层";
		mes "位于雷根贝勒里希塔乐总部地下。";
	mes "那里映照着他们肮脏的野心。";
	//
		mes "请潜入实验室，";
		mes "把^FF0000他们的研究资料^000000带给我。";
		set hg_tre,52;
		close2;
		cutin "",255;
		end;
	} else if (hg_tre == 52) {
		mes "[Herico]";
		mes "Regenschirm 位于";
		mes "雷根贝勒里希塔乐总部的地下层。";
		mes "你能潜入那里，把他们的研究资料带给我吗？";
		close2;
		cutin "heri1.bmp",255;
		end;
	} else if (hg_tre == 53) {
		mes "[Herico]";
		mes "啊，你回来了。";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "我遇到了一点麻烦，因为被守卫抓住了。";
		mes "但我已经处理好了。";
		next;
		mes "[Herico]";
		mes "非常感谢你的辛苦。";
		mes "哈哈，既然他们失去了研究资料，";
		mes "他们就无法继续研究";
		mes "至少暂时如此，我希望。";
		next;
		mes "[Herico]";
		mes "那么，我们进入下一步吧？";
		mes "我知道你至今经历了许多困难，";
		mes "但这可能是你做过最困难的事。";
		next;
		mes "[Herico]";
		mes "我认为生物实验室是 Regenschirm 最重要的设施。";
		mes "我们不能再让这种不人道的地方存在于世。";
		mes "一想到他们做了各种邪恶的事，我就不寒而栗";
		mes "以科学研究为借口。";
		next;
		mes "[Herico]";
		mes "我分析了你带来的研究资料，";
		mes "生物实验室由三层组成，";
		mes "我怀疑二楼被用来";
		mes "对活体进行实验研究。";
		next;
		mes "[Herico]";
		mes "我很确定我们能找到";
		mes "认识会制作";
		mes "^3131FF艾因贝赫^000000 的水球瓶，";
		mes "因为水球瓶是";
		mes "炸毁矿井内的隧道。";
		next;
		mes "[Herico]";
		mes "哈哈……你知道我现在要请你做什么，对吧？";
		next;
		mes "[Herico]";
		mes "请去见 ^3131FF水球瓶制造商^000000，";
		mes "并购买一些水球瓶。";
		mes "然后炸毁生物实验室二楼的^3131FF实验设备^000000！";
		next;
		mes "[Herico]";
		mes "我知道这是艰巨的任务，但请理解，";
		mes "你是我唯一的希望。";
		mes "请阻止他们对活体进行实验研究！";
		delitem 7342,1; //File Folder
		set hg_tre,54;
		close2;
		cutin "",255;
		end;
	} else if (hg_tre == 54) {
		mes "[Herico]";
		mes "请去见 ^3131FF水球瓶制造商^000000，";
		mes "并购买一些水球瓶。";
		mes "然后炸毁生物实验室二楼的^3131FF实验设备^000000。";
		mes "你是我唯一的希望。";
		mes "希望一切顺利。";
		next;
		mes "[Herico]";
		mes "如果你认识";
		mes "能为你制作水球瓶的人，";
		mes "你可以使用他的资料。";
		close2;
		cutin "",255;
		end;
	} else if (hg_tre == 55) {
		mes "["+strcharinfo(0)+"]";
		mes "机器爆炸了。";
		next;
		cutin "heri2.bmp",2;
		mes "[Herico]";
		mes "太好了！太好了！";
		next;
		mes "[Herico]";
		mes "现在我放心了，他们无法";
		mes "至少暂时继续他们的生物研究。";
		mes "你做得很好，我为你感到骄傲。";
		next;
		cutin "heri1.bmp",2;
		mes "[Herico]";
		mes "我想实验室里还有";
		mes "实验室里还留有一些失败的实验对象。";
		mes "根据研究文件，";
		mes "这些实验对象都带有 ^3131FF手铐^000000 标记。";
		next;
		mes "[Herico]";
		mes "从今以后，每当你带来";
		mes "一定数量的手铐，我都会奖励你。";
		next;
		mes "[Herico]";
		mes "而且……虽然我们暂时成功阻止了他们，";
		mes "它不会持续那么久。";
		mes "我们需要拥有力量、能永久阻止他们的人。";
		mes "遗憾的是，我不是那个人。";
		next;
		mes "[Herico]";
		mes "你是否认识能帮助他阻止他们的人？";
		next;
		input .@inputstr$;
		if (.@inputstr$ == "President Karl" || .@inputstr$ == "President Weierstrass" || .@inputstr$ == "President" || .@inputstr$ == "Karl Weierstrass") {
			mes "["+strcharinfo(0)+"]";
			mes "我想我认识一个……";
			next;
			mes "[Herico]";
			mes "好，告诉我他是谁。";
			next;
			mes "["+strcharinfo(0)+"]";
			mes "总统先生……！";
			mes "总统先生一定能帮助我们。";
			next;
			mes "[Herico]";
			mes "你是说 Karl……什么来着？";
			mes "我甚至可以说这个国家属于雷根贝勒。";
			mes "我不认为他没有受到他们影响。";
			next;
			mes "["+strcharinfo(0)+"]";
			mes "不，我认识的总统先生";
			mes "一直试图让这个国家摆脱雷根贝勒。";
			mes "即使他上次因荒唐理由而受挫，";
			mes "我相信他没有放弃希望。";
			next;
			mes "[Herico]";
			mes "嗯……我明白了。那我只能相信你的话。";
			mes "我把研究资料还给你，";
			mes "所以请把它交给总统先生。";
			mes "看看他能如何处理。";
			mes "感谢你至今为我做的一切，";
			mes "我真的非常感激。";
			set hg_tre,56;
			getitem 7342,1;
			close2;
			cutin "",255;
			end;
		}
		mes "["+strcharinfo(0)+"]";
		mes "嗯……不，我想我不认识这样的人。";
		next;
		mes "[Herico]";
		mes "哦……好吧。嗯……我们确实需要";
		mes "拥有力量、能永久阻止他们的人。";
		mes "你为什么不去其他城市";
		mes "找能帮助我们的人？我很确定";
		mes "你会找到一个。";
		close2;
		cutin "",255;
		end;
	} else {
		if (countitem(7342)) {
			mes "[Herico]";
			mes "你为什么还在这里？";
			mes "那些研究资料会对总统大有帮助。";
			mes "请尽快交给他。";
			close2;
			cutin "",255;
			end;
		} else {
			mes "[Herico]";
			mes "嘿，欢迎回来。";
			next;
			switch(select("I brought Handcuffs:Regarding Sage Varmunt's documents")) {
			case 1:
				mes "[Herico]";
				mes "我愿意用 100 副手铐交换 1 个 4 级料理。";
				next;
				if(select("Exchange:Cancel.") == 1) {
					if (countitem(7345) > 99) {
						mes "[Herico]";
						mes "给你，谢谢你的辛苦。";
						delitem 7345,100; //Handcuffs
						switch(rand(1,6)) {
						case 1:
							getitem 12044,1; //Herb Marinade Beef
							break;
						case 2:
							getitem 12049,1; //Morocc Fruit Wine
							break;
						case 3:
							getitem 12059,1; //Lutie Cold Noodle
							break;
						case 4:
							getitem 12064,1; //Cream Sandwich
							break;
						case 5:
							getitem 12069,1; //Steamed Ancient Lips
							break;
						case 6:
							getitem 12054,1; //Seasoned Jellyfish
							break;
						}
					} else {
						mes "[Herico]";
				mes "我想你没有带来 100 副手铐。";
					}
				}
				close2;
				cutin "",255;
				end;
			case 2:
				mes "[Herico]";
				mes "我检查你带来的研究资料时，";
				mes "发现贤者 Varmunt 用密码写下文件，";
				mes "所以他们无法解码。";
				mes "这就解释了他们为何如此执着";
				mes "通过仿生研究自行解决问题。";
				close2;
				cutin "",255;
				end;
			}
		}
	}
	cutin "",255;
	end;
}

lhz_in03,39,44,3	script	Enquro Carson	97,{
	if (hg_tre < 45) {
		mes "[Enquro Carson]";
		mes "大家好，这里是 Enquro Carson";
		mes "来自《光明新闻》。";
		next;
		mes "[Enquro Carson]";
		mes "人们想听到及时准确的新闻。";
		mes "作为新闻记者，我感到自豪。";
		mes "尤其是人们对新闻感到震惊时";
		mes "我正把它交给他们。";
		close;
	} else if (hg_tre == 45) {
		mes "[Enquro Carson]";
		mes "大家好，这里是 Enquro Carson";
		mes "来自《光明新闻》。";
		next;
		mes "[Enquro Carson]";
		mes "人们想听到及时准确的新闻。";
		mes "作为新闻记者，我感到自豪。";
		mes "尤其是人们对我带来的消息";
		mes "感到震惊时。";
		next;
		switch(select("Mercenary Rebellion:News reporter job")) {
		case 1:
			mes "[Enquro Carson]";
			mes "嗯……佣兵叛乱……？";
			mes "那是很久以前的事。";
			mes "佣兵们失去了工作";
			mes "守护者发明后，";
			mes "他们坚持用暴力手段";
			mes "保障社会安全，政府只好用武力制止。";
			next;
			mes "["+strcharinfo(0)+"]";
			mes "你知道佣兵叛乱的幸存者吗？";
			next;
			mes "[Enquro Carson]";
			mes "嗯……我没有负责这个案件，";
			mes "而且当年报道案件的记者";
			mes "很久以前就退休了……";
			mes "哦，我想我可以查查";
			mes "看看他是否留下关于叛乱的文件。";
			mes "请稍等。";
			next;
			mes "- *Rummage Rummage* -";
			mes "- *Rummage Rummage* -";
			mes "- *Rummage Rummage* -";
			next;
			mes "[Enquro Carson]";
			mes "哦！我找到了。";
			next;
			mes "[Enquro Carson]";
			mes "Balparan 先生，他是新闻记者，";
			mes "一定对叛乱很感兴趣。";
			mes "根据这些文件，";
			mes "叛乱失败后，他试图";
			mes "联系叛乱幸存者。";
			next;
			mes "["+strcharinfo(0)+"]";
			mes "能告诉我幸存者的位置吗？";
			next;
			mes "[Enquro Carson]";
			mes "嗯，我不该向外人透露";
			mes "任何个人信息。";
			mes "不过事情已经过去很久了，";
			mes "我也不知道他们是否还活着……";
			next;
			mes "["+strcharinfo(0)+"]";
			mes "非常感谢！";
			next;
			mes "[Enquro Carson]";
			mes "等等，我还没说要公开他们的信息。";
			mes "其实我的座右铭是";
			mes "\"^3131FFEvery bit of information must be shared^000000\".";
			next;
			mes "[Enquro Carson]";
			mes "希望你愿意把从幸存者那里得到的任何信息分享给我。";
			mes "哦，对了，你知道吗？“交换契约”。";
			next;
			mes "[Enquro Carson]";
			mes "我听说卢恩·米德加尔特王国的梦罗克";
			mes "有一家私人酒吧，";
			mes "不对公众开放。";
			mes "大家都在谈论酒吧最好的饮料，";
			mes "我很好奇它有多美味。";
			mes "能帮我弄一杯吗？哈哈哈，谢谢！";
			set hg_tre,46;
			close;
		case 2:
			mes "[Enquro Carson]";
			mes ".......Hmmm...Hmmm...Hmmm.";
			next;
		mes "- 恩库罗·卡森眯起眼睛上下打量着你。-";
			next;
			mes "[Enquro Carson]";
			mes "你不会是想当新闻记者吧？";
			close;
		}
	} else if (hg_tre == 46) {
		if (!countitem(12112) || !countitem(12113)) {
			mes "[Enquro Carson]";
			mes "我听说卢恩·米德加尔特王国的梦罗克";
	mes "有一家不对公众开放的私人酒吧。";
	//

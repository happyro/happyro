		close;
	} else {
		mes "[Old Man Nardo]";
		switch(rand(1, 6)) {
		case 1:
			mes "你认识卡普雷吗？听说" + $malayaNames$[1] + "的旅行者在帮助卡普雷……总之……";
			break;
		case 2:
			mes "最近有很多灵魂护符。" + $malayaNames$[0] + "很热衷于发放灵魂护符。这是你们那里的传统吗？";
			break;
		case 3:
			mes "我听说商人之间常提到" + $malayaNames$[1] + "？这个名字出现得很多。他似乎很有生意头脑。";
			break;
		case 4:
			mes "有一次我看到一位旅行者踩到水果滑倒。他喊着‘谁来帮帮" + $malayaNames$[1] + "~’，让我笑了半天。";
			break;
		case 5:
			mes "啊，又是你？谢谢你之前的帮助。";
			break;
		case 6:
			mes "听说" + $malayaNames$[2] + "在巴里奥很有名。你也去争取些名声吧？";
			break;
		}
		mes "有什么事？";
		next;
		switch (select("交谈。：给予灵魂护符。：老人和铸铁锅")) {
		case 1:
			mes "[Old Man Nardo]";
			mes "马来港是一座美丽的城市。";
			mes "古老与现代完美地融合在一起。";
			next;
			mes "[Old Man Nardo]";
			mes "当然，最近有幽灵游荡的问题……";
			mes "看到你和其他年轻人为此努力，我就放心了。";
			mes "谢谢。";
			close;
		case 2:
			if ((checkquest(7374) != -1) && (checkquest(7369) != -1)) {
				if (!countitem(6503)) {
					mes "^4d4dff没有可以交给老人的灵魂护符。^000000";
					close;
				}
				mes "[Old Man Nardo]";
				mes "这是用传统方法制作的新灵魂护符吗？";
				mes "感谢你用新的护符替换我的旧护符。";
				mes "我一直欠你和伊梅尔达一个人情。";
				next;
				mes "-已将灵魂护符交给老纳尔多。-";
				delitem 6503, 1; // Soul_Protection
				erasequest 7369;
				setquest 7383;
				if ((checkquest(7382) + checkquest(7383) + checkquest(7384) + checkquest(7385) + checkquest(7386) + checkquest(7387)) > 5) {
					mes "-老纳尔多是最后一位，所有灵魂护符都已送达。回去找伊梅尔达。-";
					if (malaya_hi == 23) {
						set malaya_hi, 24;
					}
					setquest 7379;
					erasequest 7382;
					erasequest 7383;
					erasequest 7384;
					erasequest 7385;
					erasequest 7386;
					erasequest 7387;
				}
				close;
			} else {
				mes "[Old Man Nardo]";
				mes "什么？新的灵魂护符？";
				mes "我没事。你之前给我的还在。";
				mes "这个失效后能再给我一个吗？";
				close;
			}
			break;
		case 3:
			if (BaseLevel < 100) {
				mes "[Old Man Nardo]";
				mes "嗯……你看起来不够强，无法前往巴里奥。";
				mes "抱歉，我不能让你携带珍贵的铸铁锅。";
				close;
			}
			if ((checkquest(7378, PLAYTIME) == 0) || (checkquest(7378, PLAYTIME) == 1)) {
				mes "[Old Man Nardo]";
				mes "你已经把铸铁锅送到巴里奥，今天就够了。";
				mes "无论锅多么坚固，即使是最结实的铸铁，也只能坚持一天。";
				next;
				mes "[Old Man Nardo]";
				mes "如果可以，明天再帮我一次。";
				close;
			} else if (checkquest(7378, PLAYTIME) == 2) {
				mes "[Old Man Nardo]";
				mes "嘿！";
				mes "你还好吗，吃饱了吗？";
				mes "有空时再来吧。";
				next;
				mes "[Old Man Nardo]";
				mes "是关于铸铁锅的事，但可以等你完成当前委托后再说。";
				erasequest 7378;
				close;
			 } else {
				if (checkquest(7377) != -1) {
					if (countitem(6503) < 5) {
						mes "[Old Man Nardo]";
					mes "你把锅完整地送到了吗？";
					mes "梦巴基的基科应该给了你灵魂护符。你带着吗？";
					mes "你一定把它落在哪里了。请去拿回来。";
						close;
					}
					mes "[Old Man Nardo]";
				mes "很好。这就是梦巴基的基科承诺给你的灵魂护符。";
				mes "我知道它们是伊梅尔达制作、由你每天带来的，但灵魂护符越多越好。";
					next;
					mes "[Old Man Nardo]";
				mes "请再来一趟。";
				mes "我总会准备好巴里奥需要的铸铁锅。";
					delitem 6503, 5; // Soul_Protection
					setquest 7378;
					erasequest 7377;
					if (!VIP_SCRIPT || vip_status(VIP_STATUS_ACTIVE))
						getitem 6497, 2; // Lesser_Agimat
					else
						getitem 6497, 1; // Lesser_Agimat
					getexp 200000,200000;
					if (!rand(3))
						$malayaNames$[2] = strcharinfo(0);
					close;
				} else {
					if (checkquest(7376) > -1) {
						mes "[Old Man Nardo]";
						mes "去奇科在巴里奥·马希瓦加的梦巴基据点，交付铸铁锅。";
						mes "这应该能帮助解决巴科纳瓦的麻烦。";
						close;
					} else {
						mes "[Old Man Nardo]";
						mes "没错，铸铁锅。";
						mes "去奇科在巴里奥·马希瓦加的梦巴基据点，交付铸铁锅。";
						mes "我想请你替我完成……";
						next;
						switch (select("铸铁锅？？：我来做。：我现在很忙。")) {
						case 1:
							mes "[Old Man Nardo]";
							mes "这是因为巴科纳瓦。";
							mes "敲打锅子，受惊的巴科纳瓦就会把月亮吐出来。";
							next;
							mes "[Old Man Nardo]";
							mes "巴里奥·马希瓦加靠近巴科纳瓦的居所，所以他们总是为麻烦做好准备。";
							next;
							mes "[Old Man Nardo]";
							mes "必须准备足够的铸铁锅用来敲打。";
							mes "但这里的熔炉更好。";
							mes "所以我每天把锅送过去。";
							close;
						case 2:
							mes "[Old Man Nardo]";
							mes "这是铸铁锅。马来亚有优秀的铁匠。";
							mes "把它送给附近巴里奥·马希瓦加的梦巴基据点的奇科。";
							setquest 7376;
							getitem 6504, 5; // Cast_Iron_Caldron
							close;
						case 3:
							mes "[Old Man Nardo]";
							mes "这样啊。";
							mes "抱歉，你一定很忙。";
							close;
						}
					}
				}
			}
			break;
		}
	}
	end;
}

malaya,224,267,3	script	Romel#malaya	573,{
	if (malaya_hi < 10) {
		mes "[Romel]";
		mes ".........";
		mes " ";
		mes "（他避开你的目光，不理会你。）";
		close;
	} else if (malaya_hi == 10) {
		if (checkquest(7357) == 2) {
			mes "[Romel]";
			mes "……真是冷酷无情。";
			mes "而我们一直生活在恐惧中……";
			next;
			mes "[Romel]";
			mes "连安心都不被允许……";
			close;
		} else {
			mes "[Romel]";
			mes "啊……";
			mes "……你……";
			mes "抱歉，刚才忽略了你。";
			mes "但是……你一定就是他们说的那个人……";
			next;
			mes "[Romel]";
			mes "你就是驱赶幽灵的人吗？";
			mes "如果可以，能给我一件你的物品或一些头发吗？";
			next;
			mes "[Romel]";
			mes "我想带在身上……当作护身符。";
			next;
		mes "- 因为你能驱赶幽灵，受困扰的村民想要你的物品。-";
			setquest 7357;
			completequest 7357;
			if ((checkquest(7352) + checkquest(7353) + checkquest(7354) + checkquest(7355) + checkquest(7356) + checkquest(7357)) > 9) {
				next;
		mes "- 已经有很多人向你提出这个请求。也许最好去和梦巴基的冯谈谈。-";
				set malaya_hi, 11;
				setquest 7358;
			}
			close;
		}
	} else if (malaya_hi == 11) {
		mes "罗梅尔悲伤地看着你。";
		mes "如果可以，他一定会拔你的头发或拽你的袖子！";
		close;
	} else if (malaya_hi == 12) {
		if (checkquest(7364) != -1) {
			mes "[Romel]";
			mes "坦白说，这是为了安心。";
			mes "有了它，我就能更勇敢地面对它们。";
			next;
			mes "[Romel]";
			mes "我的意思是，我依赖这样的物品，";
			mes "但有了它们，我会更勇敢。";
			close;
		}
		if (!countitem(523) || !countitem(717)) {
			mes "^4d4dffPrepare and give Blue Gemstone and Holy Water. ^000000";
			close;
		}
		mes "[Romel]";
		mes "……是什么？";
		next;
		select ("Hand him the prepared items");
		mes "[Romel]";
		mes "哦……谢谢。";
		mes "我能感受到你的精神。";
		mes "这会保护我的安全。";
		next;
		mes "[Romel]";
		mes "嘿……能也给我女儿一些吗？";
		next;
		mes "-已将准备好的圣水和蓝色宝石交给罗梅尔。-";
		delitem 717, 1; //Blue_Gemstone
		delitem 523, 1; //Holy_Water
		setquest 7364;
		completequest 7364;
		if ((checkquest(7359) + checkquest(7360) + checkquest(7361) + checkquest(7362) + checkquest(7363) + checkquest(7364)) > 11) {
			mes "-罗梅尔是最后一位，我想圣物已经送得差不多了。-";
			set malaya_hi, 13;
			erasequest 7351;
			setquest 7365;
		}
		close;
	} else if (malaya_hi == 13) {
		mes "[Romel]";
		mes "圣物得到了妥善保管。";
		mes "我女儿也是。";
		close;
	} else {
		mes "[Romel]";
		mes "你好。";
		switch(rand(1, 6)) {
		case 1:
			mes "哈哈，我昨晚做了个梦，梦里有" + $malayaNames$[0] + "。哈哈……真奇怪……";
			break;
		case 2:
			mes "有时我妻子睡觉时会发出这种声音。她说‘" + $malayaNames$[0] + "……" + $malayaNames$[0] + "……’。那是谁？你知道吗？！她是不是被幽灵附身了？";
			break;
		case 3:
			mes  "It's all thanks to " + $malayaNames$[0] + " for changing the atmosphere of the house. It seems like we were saved by the Holy Artifact and Spiritual Protection.";
			break;
		case 4:
			mes  "The people of the neighboring Baryo Mahiwaga are so strong. Even their children play in the forest. I can't imagine myself doing that.";
			break;
		case 5:
			mes  "Without the slightest doubt, the most famous person in town is " + $malayaNames$[2] + ". Even famous in Baryo they say.";
			break;
		case 6:
			mes  "Merchant Woeon says 'Our " + $malayaNames$[1] + " sir/ma'am' 'we " + $malayaNames$[1] + " sir/ma'am' during drinking. I wonder what happened between the two of them?";
			break;
		}
		next;
		if (select("给予灵魂护符：最近怎么样？") == 2) {
			mes "[Romel]";
			mes "我最近很平静。";
			close;
		}
		if ((checkquest(7374) == -1) || (checkquest(7373) == -1)) {
			mes "[Romel]";
			mes "新的灵魂护符？";
			mes "你之前给我的还很好用。";
			mes "我现在没事。";
			close;
		}
		if (!countitem(6503)) {
			mes "^4d4dff没有可以交给罗梅尔的灵魂护符。^000000";
			close;
		}
		mes "[Romel]";
		mes "新的灵魂护符。";
		mes "我正想着这个已经失效了……谢谢你来。";
		mes "这个灵魂护符也会保护我们。";
		next;
		mes "-已将灵魂护符交给罗梅尔。-";
		delitem 6503, 1; // Soul_Protection
		erasequest 7373;
		setquest 7387;
		if ((checkquest(7382) + checkquest(7383) + checkquest(7384) + checkquest(7385) + checkquest(7386) + checkquest(7387)) > 5) {
			mes "-罗梅尔是最后一位，所有灵魂护符都已送达。回去找伊梅尔达。-";
			if (malaya_hi == 23) {
				set malaya_hi, 24;
			}
			setquest 7379;
			erasequest 7382;
			erasequest 7383;
			erasequest 7384;
			erasequest 7385;
			erasequest 7386;
			erasequest 7387;
		}
		close;
	}
	end;
}

malaya,223,267,5	script	Talah#malaya	941,{
	if (malaya_hi < 10) {
		mes "[Talah]";
		mes "..........gasp!";
		mes " ";
		mes "（当你与她四目相对时，她跑到父亲身后躲了起来。）";
		close;
	} else if (malaya_hi == 10) {
		if (checkquest(7356) == 2) {
			mes "[Talah]";
			mes "塔拉今晚可能会被带走。";
			mes "可怕的孩子可能会来找塔拉。";
			next;
			mes "塔拉拉住罗梅尔的衣服，罗梅尔悲伤地看着你。";
			mes "最好在他们拿走你的纽扣之前做点什么……";
			close;
		} else {
			mes "[Talah]";
			mes "……我、嗯……那个……";
			mes ".........oh... Daddy....";
			next;
			mes "[Romel]";
			mes "嘿，能给我女儿一颗纽扣或一些你的头发吗？";
			mes "她晚上睡不好……";
			next;
			mes "[Romel]";
			mes "如果有你的东西当护身符，她是不是就能睡好了？";
			next;
			mes "-村民因你能驱赶鬼魂而想要你的物品。-";
			setquest 7356;
			completequest 7356;
			if ((checkquest(7352) + checkquest(7353) + checkquest(7354) + checkquest(7355) + checkquest(7356) + checkquest(7357)) > 9) {
				next;
				mes "-已经有很多人向你提出同样的请求。也许应该去和梦巴奇的峰谈谈。-";
				set malaya_hi, 11;
				setquest 7358;
			}
			close;
		}
	} else if (malaya_hi == 11) {
		mes "塔拉好奇地在你和父亲之间来回看。";
		close;
	} else if (malaya_hi == 12) {
		if (checkquest(7363) != -1) {
			mes "[Talah]";
			mes "我不太确定，";
			mes "但我从它们那里感到温暖。";
			mes "爸爸现在更勇敢了，塔拉也因此变得更强。";
			close;
		}
		if (!countitem(523) || !countitem(717)) {
			mes "^4d4dffPrepare and give Blue Gemstone and Holy Water. ^000000";
			close;
		}
		mes "[Talah]";
		mes "……我可以打招呼吗？";
		mes "你好……";
		next;
		select("交出准备好的物品。" );
		mes "[Talah]";
		mes "漂亮的蓝色宝石……！";
		mes "哦哦哦~真漂亮！";
		mes "这块宝石会保护塔拉吗？";
		next;
		mes "-已将圣水和蓝色宝石交给塔拉。-";
		delitem 717, 1; //Blue_Gemstone
		delitem 523, 1; //Holy_Water
		setquest 7363;
		completequest 7363;
		if ((checkquest(7359) + checkquest(7360) + checkquest(7361) + checkquest(7362) + checkquest(7363) + checkquest(7364)) > 11) {
			mes "-塔拉是最后一位，我想圣物已经送得差不多了。-";
			set malaya_hi, 13;
			erasequest 7351;
			setquest 7365;
		}
		close;
	} else if (malaya_hi == 13) {
		mes "[Talah]";
		mes "爸爸叫我要紧紧握住圣物。";
		mes "这样就能赶走坏幽灵……";
		close;
	} else {
		mes "[Talah]";
		mes "你好……";
		next;
		if (select("给予灵魂护符。：你好？") == 2) {
			mes "[Talah]";
			mes "……嘿……谢谢你。";
			mes "你会保护我们的，对吧？";
			close;
		}
		if ((checkquest(7374) != -1) && (checkquest(7372) != -1)) {
			if (!countitem(6503)) {
				mes "^4d4dff没有可以交给塔拉的灵魂护符。^000000";
				close;
			}
			mes "[Talah]";
		mes "这是新的灵魂护符吗？";
		mes "谢谢你。";
		mes "有了灵魂护符，塔拉现在可以好好睡觉了。";
		mes "爸爸也喜欢它。";
			next;
			mes "-已将新的灵魂护符交给塔拉。-";
			delitem 6503, 1; // Soul_Protection
			erasequest 7372;
			setquest 7386;
			if ((checkquest(7382) + checkquest(7383) + checkquest(7384) + checkquest(7385) + checkquest(7386) + checkquest(7387)) > 5) {
				mes "-塔拉是最后一位，所有灵魂护符都已送达。回去找伊梅尔达。-";
				if (malaya_hi == 23) {
					set malaya_hi, 24;
				}
				setquest 7379;
				erasequest 7382;
				erasequest 7383;
				erasequest 7384;
				erasequest 7385;
				erasequest 7386;
				erasequest 7387;
			}
			close;
		} else {
			mes "[Talah]";
			mes "嗯……";
			mes "你之前给的还在保护塔拉。";
			mes "我没事。";
			close;
		}
	}
	end;
}

malaya,62,274,0	script	Sand Trap#malaya	557,{
	if (MaxWeight - Weight < 1000 || checkweight(1201,1) == 0) {
		mes "-无法继续任务。你携带的物品太多。-";
		close;
	}
	if ((checkquest(7366) == -1) && (checkquest(7380) == -1)) {
		mes "沙子里埋着一台蒸发海水的装置……";
		close;
	}
	if (countitem(6501) >= 6) {
		mes "盐已经够了。";
		close;
	}
	mes "沙坑里安装着蒸发海水的装置。";
	next;
	mes "可以从干燥的叶子上刮下盐，";
	mes "有人把这些叶子撒在海水上。";
	close2;
	progressbar "0xffff00", 5;
	disablenpc();
	initnpctimer;
	getitem 6501, 1; // Salt_Bag
	mes "[" + strcharinfo(0) + "]";
	mes "这些应该够了。";
	close;

OnTimer30000:
	enablenpc();
	stopnpctimer;
	end;
}
malaya,66,277,0	duplicate(Sand Trap#malaya)	Sand Trap#malaya01	557

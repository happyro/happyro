		close;
	}
	switch( checkquest(14670,PLAYTIME) ) {
	case -1:
		break;
	case 0:
	case 1:
		mes "[Antoine]";
		mes "冒险者，我不想让你太勉强。去休息一下吧？";
		next;
		mes "[Antoine]";
		mes "好好睡一晚，天亮后再回来。";
		close;
	case 2:
		mes "[Antoine]";
		mes "冒险者，你昨晚做了好梦吗？我因为整天盯着那些鬃毛，可能做了噩梦。";
		next;
		mes "[Antoine]";
		mes "但我不会放弃！";
		mes "请像往常一样带给我^0000cd20根波浪鬃毛^000000。";
		next;
		mes "[Antoine]";
		mes "哦，如果你还能消灭^0000cd10只甜蜜梦魇^000000就更好了。我想知道这会如何影响梦境。谢谢！";
		erasequest 14670;// Time for Dreaming
		setquest 14669;// Sweet Dreams
		close;
	}
	switch( checkquest(14669,HUNTING) ) {
	case -1:
		mes "[Antoine]";
		mes "冒险者，可以和你谈一会儿吗？我想听听你对一件事的看法。";
		next;
		if (select( "当然可以。", "我有点忙。" ) == 2) {
			mes "[Antoine]";
			mes "哦，是吗？没关系，等你有空时再来找我。";
			close;
		}
		mes "[Antoine]";
		mes "你见过那些梦魇和吸血蝙蝠吧？你注意到它们和外面的种类长得不同吗？你觉得为什么？";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "我不知道。";
		next;
		mes "[Antoine]";
		mes "这里的一切都很有趣。尤其是那些甜蜜梦魇，它们充满矛盾。";
		next;
		emotion ET_SPARK;
		mes "[Antoine]";
		mes "你仔细看过它们的波浪鬃毛吗？看久了就会看到画面闪现，我认为那来自其他人的梦。";
		next;
		mes "[Antoine]";
		mes "甜蜜梦魇……连名字都自相矛盾。也许它们的鬃毛是一切梦魇的源头。";
		next;
		mes "[Antoine]";
		mes "又或者，它只是映照死者的梦。";
		next;
		mes "[Antoine]";
		mes "那两位女士可能不同意，但我不必一直留在这里。我留下只是因为^0000cd甜蜜梦魇^000000。";
		next;
		mes "[Antoine]";
		mes "我想弄到它们的鬃毛，看看是否会影响我们的梦。";
		next;
		mes "[Antoine]";
		mes "而且我不想丢下同事，让他们自生自灭。你明白我的意思吗？";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "你想让我^0000cd替你弄来它们的鬃毛^000000吗？";
		next;
		mes "[Antoine]";
		mes "是的，拜托了！^0000cd20根^000000就够了！";
		next;
		mes "[Antoine]";
		mes "另外请顺便猎杀^0000cd10只甜蜜梦魇^000000。我要知道这会如何影响梦境。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "我会做的。";
		next;
		emotion ET_THANKS;
		mes "[Antoine]";
		mes "谢谢。作为回报，我会给你一些从这里捡到的石头。";
		next;
		mes "[Antoine]";
		mes "我不知道它们有什么用途，但它们确实美丽又神秘。也许外面有人能认出它们的价值。";
		next;
		mes "[Antoine]";
		mes "总之，谢谢你为我做这些！";
		setquest 14669;// Sweet Dreams
		close;
	case 0:
	case 1:
		break;
	case 2:
		if (countitem(25270) < 20)
			break;
		mes "[Antoine]";
		mes "冒险者，我一直在等你！你拿到我要的东西了吗？";
		next;
		mes "[Antoine]";
		mes "你把它们全带来了。我希望能从中发现些什么。";
		next;
		mes "[Antoine]";
		mes "这些只能在这里找到。以后有机会请继续带给我。你知道的，醒来后梦就会消失。";
		next;
		mes "[Antoine]";
		mes "非常感谢。你现在该休息了。";
		delitem 25270,20;// Wavy_Mane
		erasequest 14669;// Sweet Dreams
		setquest 14670;// Time for Dreaming
		getexp 500000,500000;
		getitem 25271,1;// Illusion Stone
		close;
	}
	mes "[Antoine]";
	mes "冒险者，我一直在等你！你拿到我要的东西了吗？";
	next;
	mes "[Antoine]";
	mes "嗯，看来你还没找到。";
	next;
	mes "[Antoine]";
	mes "请从^0000cd甜蜜梦魇^000000那里带来^0000cd20根波浪鬃毛^000000。";
	next;
	mes "[Antoine]";
	mes "哦，如果你还能消灭^0000cd10只甜蜜梦魇^000000就更好了。我想知道这会如何影响梦境。谢谢！";
	close;

OnInit:
	.@main_completed$ = "isbegin_quest(14666) == 2";
	questinfo( QTYPE_QUEST, QMARK_YELLOW, (.@main_completed$ + " && checkquest(14670,PLAYTIME) == -1 && checkquest(14669,HUNTING) == -1") );
	questinfo( QTYPE_QUEST, QMARK_YELLOW, (.@main_completed$ + " && checkquest(14669,HUNTING) == 2 && countitem(25270) > 19") );
	questinfo( QTYPE_QUEST, QMARK_YELLOW, (.@main_completed$ + " && checkquest(14670,PLAYTIME) == 2") );
	end;
}

gef_d01_i,113,230,5	script	Gem#ilgf01	1_F_PRIEST,{
	if (checkweight(501,1) == 0 || (MaxWeight - Weight) < 1000) {
		mes "[Gem]";
		mes "你确定能带得动这么多东西吗？为什么不减轻一下背包？";
		close;
	}
	if (ill_vampire == 5) {
		mes "[Gem]";
		mes "安托万兄弟，你留在这里。我和玛丽娜姐妹去。你们有意见吗？";
		npctalk "就算你说了，我也听不见。", "", bc_self;
		next;
		mes "[Marina]";
		mes "我和安托万兄弟去。我们受过战斗训练，而你没有。";
		npctalk "而且我的脚步很快。", "Marina#ilgf01", bc_self;
		next;
		mes "[Antoine]";
		mes "玛丽娜，你留下吧。我和宝石姐妹去。考虑到我们的能力，我觉得这样最好。";
		npctalk "我们一个人搜索，另一个人掩护。", "Antoine#ilgf01", bc_self;
		next;
		mes "[Gem]";
		mes "不行。这里到处都是邪恶生物。由两名神的仆人去找更好。";
		next;
		mes "[Antoine]";
		mes "你这是什么意思？你是说我不是神的仆人，所以不能和僵尸战斗？";
		next;
		mes "[Marina]";
		mes "我们两人留下，一个人去，怎么样？";
		next;
		mes "[Gem]";
		mes "不行。必须两个人一起，这样可以互相照应。";
		next;
		mes "[Antoine]";
		mes "那留下的人呢？没人照应他。";
		next;
		select("打扰了。我受格林神父委托来到这里。" );
		mes "[Marina]";
		mes "你是来帮助我们的吗？";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "他担心你们还没出来。如果需要，他让我来帮忙。发生什么事了吗？";
		next;
		mes "[Marina]";
		mes "我们需要找到几个人。";
		next;
		mes "[Antoine]";
		mes "不能只这样告诉他。冒险者，你知道这里是什么地方吧？我们很着急，我快速说明情况。";
		next;
		mes "[Antoine]";
		mes "这里和吉芬地下墓穴一模一样，可能存在于笔记本主人的记忆中。";
		next;
		mes "[Antoine]";
		mes "我们来这里是为了查明这里如何以及为何被创造出来。";
		next;
		mes "[Antoine]";
		mes "我们没发现这里有什么异常。我们想离开，但有两个人，^0000cd一名祭司和一名魔法师^000000，没回来和我们会合。";
		next;
		mes "[Antoine]";
		mes "我们四处找过，但笔记本主人对这里的记忆模糊又不连贯。不同魔法师的幻象不断出现，而且数量很多。";
		next;
		mes "[Antoine]";
		mes "我们觉得找下去没完没了，所以决定分头行动。正在讨论怎么做时，你出现了。";
		next;
		mes "[Antoine]";
		mes "你能来这里真是太好了。现在我们有四个人，^0000cd两人留下，两人去寻找^000000。";
		next;
		select("失踪的成员长什么样？" );
		mes "[Gem]";
		mes "失踪的祭司叫^0000cd朱比利^000000，魔法师叫^0000cd乔乔^000000。他们就是典型的祭司和魔法师，不会认错。";
		next;
		mes "[Marina]";
		mes "冒险者，我们走吧！";
		next;
		mes "[Gem]";
		mes "在你出发前让我为你祈祷。亲爱的神，请守护你的孩子……";
		erasequest 14656;// Finding Father Grimm's Colleagues
		setquest 14657;// Jojo Is the Mage's Name
		setquest 14658;// Jubilee Is the Priest's Name
		npcskill "AL_INCAGI",10,0,0;
		npcskill "AL_BLESSING",10,0,0;
		ill_vampire = 6;
		.@char_id = getcharid(0);
		cloakoffnpcself( "Priest#ilgf01" );
		for ( .@i = 3; .@i < 10; ++.@i )
			cloakoffnpcself( "Marina#ilgf0" + .@i );
		close;
	}
	if (ill_vampire == 6) {
		.@char_id = getcharid(0);
		cloakoffnpcself( "Priest#ilgf01" );
		for ( .@i = 3; .@i < 10; ++.@i )
			cloakoffnpcself( "Marina#ilgf0" + .@i );
		mes "[Gem]";
		mes "希望朱比利兄弟和乔乔兄弟平安。";
		next;
		mes "[Gem]";
		mes "如果你必须离开，告诉玛丽娜姐妹。她会把你送回来的地方。";
		close;
	}
	if (ill_vampire == 7) {
		mes "[Gem]";
		mes "朱比利兄弟去治疗伤口了，但乔乔兄弟还没回来。真希望他平安。";
		next;
		mes "[Gem]";
		mes "如果你必须离开，告诉玛丽娜姐妹。她会把你送回来的地方。";
		close;
	}
	if (ill_vampire < 14) {
		mes "[Gem]";
		mes "真希望乔乔兄弟平安。";
		next;
		mes "[Gem]";
		mes "如果你必须离开，告诉玛丽娜姐妹。她会把你送回来的地方。";
		close;
	}
	if (ill_vampire == 14) {
		mes "[Gem]";
		mes "冒险者，你现在要离开吗？";
		next;
		select("格林神父现在一定很焦急。" );
		mes "[" + strcharinfo(0) + "]";
		mes "是的。既然知道你们平安，我该回格林神父那里了。";
		next;
		mes "[Gem]";
		mes "根据我们的判断，这里发生的事似乎不会^0000cd影响^000000外界。";
		next;
		mes "[Gem]";
		mes "那就好，但仍然需要有人留在这里监视它们。你明白我们的意思吧？请告诉格林兄弟。";
		next;
		select("我很惊讶。" );
		mes "[" + strcharinfo(0) + "]";
		mes "你来自教会。我没想到你会让那些吸血鬼活着。";
		next;
		mes "[Marina]";
		mes "如果按规矩办，我们不该让它们活着。";
		next;
		mes "[Gem]";
		mes "她说得对，我们不该。但看着它们……我不确定它们是否该死。";
		next;
		mes "[Gem]";
		mes "这是我们需要思考的问题。";
		next;
		emotion ET_STARE, getnpcid(0, "Marina#ilgf01");
		mes "[Marina]";
		mes "但如果它们犯下哪怕一点错误，我们就会消灭它们！";
		next;
		emotion ET_OK, getnpcid(0, "Antoine#ilgf01");
		mes "[Antoine]";
		mes "如果发生那种事，我会让你亲自处理它们。";
		next;
		mes "[Gem]";
		mes "请告诉格林兄弟，我们决定留下来监视它们。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "我会的。注意安全。";
		erasequest 14665;// Is the Fight Over?
		setquest 14666;// Warden's Role
		ill_vampire = 15;
		close2;
		warp "gef_dun01",133,219;
		end;
	}
	if (ill_vampire == 15) {
		mes "[Gem]";
		mes "请告诉格林兄弟，我们决定留下来";
		next;
		mes "[Gem]";
		mes "如果你想离开，就请玛丽娜姐妹放你出去。";
		close;
	}
	switch( checkquest(14668,PLAYTIME) ) {
	case -1:
		break;
	case 0:
	case 1:
		mes "[Gem]";
		mes "冒险者，距离你上次狩猎还没过多久。你需要休息。";
		next;
		mes "[Gem]";
		mes "请明天^0000cd天亮后^000000再回来。";
		close;
	case 2:
		mes "[Gem]";
		mes "冒险者，欢迎回来。";
		next;
		mes "[Gem]";
		mes "和往常一样，请消灭^0000cd静谧亡者^000000。它们有^0000cd小型、快速型和大型三种，请各消灭10只。^000000";
		erasequest 14668;// Get Some Rest
		setquest 14667;// Send the Dead Back to Earth
		close;
	}
	switch( checkquest(14667,HUNTING) ) {
	case -1:
		mes "[Gem]";
		mes "冒险者，你忙吗？";
		next;
		mes "[Gem]";
		mes "即使你很忙，也请抽一点时间给我。";
		next;
		if (select( "Sure, why not?", "But I'm too busy.") == 2) {
			mes "[Gem]";
			mes "好吧，那我等你有空。";
			close;
		}
		mes "[Gem]";
		mes "如你所知，我们来这里是为了监视它们。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "是的。";
		next;
		mes "[Gem]";
		mes "但这妨碍了我们的原本任务，也就是清除这里的邪恶生物。";
		next;
		mes "[Gem]";
		mes "我们一直试图两边兼顾，但只有我们三个人实在很难。";
		next;
		mes "[Gem]";
		mes "死者应当归于大地。我们来这里是为了^0000cd让亡者重新长眠^000000。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "也就是说你们需要帮助。";
		next;
		mes "[Gem]";
		mes "是的。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "你想让我处理哪种怪物？";
		next;
		mes "[Gem]";
		mes "请消灭^0000cd静谧亡者^000000。它们有^0000cd小型、快速型和大型三种，请各消灭10只。^000000";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "明白了。既然我在这里，就尽力帮你们吧。我很高兴能帮上忙。我会回来的。";
		setquest 14667;// Send the Dead Back to Earth
		close;
	case 0:
	case 1:
		mes "[Gem]";
		mes "冒险者，你处理好我拜托的事了吗？";
		next;
		mes "[Gem]";
		mes "还是忘了我要你做什么？";
		next;
		mes "[Gem]";
		mes "请消灭^0000cd静谧亡者^000000。它们有^0000cd小型、快速型和大型三种，请各消灭10只。^000000";
		next;
		mes "[Gem]";
		mes "所有死者都必须回归大地。";
		close;
	case 2:
		mes "[Gem]";
		mes "冒险者，你把它们全都处理好了。谢谢。它们也会在天堂感谢你。";
		next;
		mes "[Gem]";
		mes "你去休息一下，天亮后再回来吧？";
		erasequest 14667;// Send the Dead Back to Earth
		setquest 14668;// Get Some Rest
		getexp 500000,500000;
		getitem 25271,1;// Illusion Stone
		close;
	}
	end;

OnInit:
	.@main_completed$ = "isbegin_quest(14666) == 2";
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "isbegin_quest(14656) == 1" );
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "isbegin_quest(14665) == 1" );
	questinfo( QTYPE_QUEST, QMARK_YELLOW, (.@main_completed$ + " && checkquest(14668,PLAYTIME) == -1 && checkquest(14667,HUNTING) == -1") );
	questinfo( QTYPE_QUEST, QMARK_YELLOW, (.@main_completed$ + " && checkquest(14667,HUNTING) == 2") );
	questinfo( QTYPE_QUEST, QMARK_YELLOW, (.@main_completed$ + " && checkquest(14668,PLAYTIME) == 2") );
	end;
}

// Jubilee Is the Priest's Name
gef_d01_i,93,178,5	script(CLOAKED)	Marina#ilgf03	4_F_MONK,5,5,{
	end;
OnTouch:
	if (ill_vampire == 6) {
		setpcblock PCBLOCK_NPC, true;
		.@num = atoi( replacestr( strnpcinfo(2), "ilgf0", "" ) );
		if (.@num == 3)
			npctalk "我感知到东边有微弱能量。走吧。", "", bc_self;
		else if (.@num == 4)
			npctalk "东边那个人的能量正在增强。快走！", "", bc_self;
		else if (.@num == 5)
			npctalk "我感知到南边有微弱能量。快走！", "", bc_self;
		else if (.@num == 6)
			npctalk "我感知到东边有微弱能量。走吧。", "", bc_self;
		else if (.@num == 7)
			npctalk "再往东！我们快到了！", "", bc_self;
		else if (.@num == 8)
			npctalk "我们往北走！", "", bc_self;
		else if (.@num == 9)
			npctalk "我们往南走！", "", bc_self;
		sleep2 1500;
		specialeffect EF_TELEPORTATION2;
		cloakonnpcself();
		setpcblock PCBLOCK_NPC, false;
	}
	end;
}

// Suspicious Beach :: Suspicious_Beach.sc
//============================================================
brasilis,192,133,6	script	Lucia#brasilis	4_F_BRZ_WOMAN,{
	/* -------------- Hydra Ball -------------------------
	if (countitem(12408) > 0) {
		delitem 12408,1; //Leaf_Cat_Ball
		getitem 12408,1; //Leaf_Cat_Ball
	}
	else if (countitem(6221) > 0) {
		delitem 6221,1; //Mystic_Leaf_Cat_Ball
		getitem 6221,1; //Mystic_Leaf_Cat_Ball
	}
	--------------------------------------------------- */
	if (BaseLevel < 40) {
		mes "[Lucia]";
		mes "你好。";
		mes "我很担心南边海滩的";
		mes "^FF0000奇怪九头蛇^000000。";
		mes "希望有经验的冒险者";
		mes "能来帮忙。";
		emotion ET_OHNO;
		close;
	}
	.@nQState1 = checkquest(9028);
	.@nQState2 = checkquest(9029);
	if (.@nQState1 == -1) {
		mes "[Lucia]";
		mes "你好。";
		mes "你是来捕猎^FF0000奇怪九头蛇^000000的吗？";
		next;
		switch(select("是。:否。:^006400这里发生了什么？^000000")) {
		case 1:
			setquest 9028;
			getitem 12408,1; //Hydra_Ball
			mes "[Lucia]";
			mes "来，拿着这个 ^006400九头蛇球^000000。";
			mes "用它捕捉一只 ^FF0000奇怪九头蛇^8B4513。^000000";
			mes "希望你能成功~！";
			close;
		case 2:
			mes "[Lucia]";
			mes "啊，是我误会了。";
			mes "回头见。";
			close;
		case 3:
		L_WhatHappen:
			mes "[Lucia]";
			mes "有一天，^FF0000奇怪九头蛇^000000";
			mes "来到这里包围了城镇。";
			mes "我们不知道是什么吸引了它们，但有人说是因为你们这些冒险者。";
			next;
			mes "[Lucia]";
			mes "无论如何，要控制^FF0000奇怪九头蛇^000000，";
			mes "必须使用这种专门设计的工具，也就是 ^8B4513九头蛇球^000000。";
			next;
			mes "[Lucia]";
			mes "如果你还有 ^006400九头蛇球^000000，";
			mes "请对海滩上的";
			mes "^FF0000奇怪九头蛇^000000使用。";
			mes "幸运的话，工具会完美生效。";
			next;
			mes "[Lucia]";
			mes "希望有很多冒险者";
			mes "自愿接下这项工作。";
			mes " ";
			mes "我真的讨厌九头蛇！";
			emotion ET_CRY;
			close;
		}
	}
	else if ((.@nQState1 == 0) || (.@nQState1 == 1)) {
		if (countitem(6221) > 0) {
			mes "[Lucia]";
			mes "你好，你真的成功了！";
			if (checkweight(11502,3)) {
				//mes "I don't have enough ^006400Hydra Ball^000000s to give you."; //Poorly translated by iRO?
				mes "希望你能再来";
				mes "帮助我。";
				mes "祝你今天愉快~！";
				delitem 6221,1; //Mystic_Leaf_Cat_Ball
				completequest 9028;
				//recall_completequest 9029;
				if (.@nQState2 > -1) erasequest 9029;
				setquest 9029;
				if (checkre(0))
					consumeitem 607; //Yggdrasilberry
				consumeitem 12070; //Luk_Dish05
				consumeitem 12055; //Vit_Dish05
				consumeitem 12065; //Dex_Dish05
				if (checkre(0))
					getitem 11502,3; //Light_Blue_Pot
				else
					getitem 505,5; //Blue_Potion
				close;
			}
			else {
				mes " ";
				mes "我想奖励你，";
				mes "但你的背包满了。";
				mes "请腾出空间后再回来！";
				close;
			}
		}
		else {
			mes "[Lucia]";
			if (countitem(12408) < 1) {
				mes "你还需要一个 ^006400九头蛇球^000000 吗？";
				mes "我再给你一个。";
				getitem 12408,1; //Leaf_Cat_Ball
				close;
			}
			else {
				mes "有什么问题吗？";
				next;
					switch(select("没有。:^006400再告诉我发生了什么^000000")) {
				case 1:
					mes "[Lucia]";
					mes "好，请帮我这个忙。";
					close;
				case 2:
					goto L_WhatHappen;
				}
			}
		}
	}
	else {
		mes "[Lucia]";
		mes "哦，^0000FF"+strcharinfo(0)+"^000000，你回来了。";
		.@nCheckTime = checkquest(9029,PLAYTIME);
		if ((.@nCheckTime == 0) || (.@nCheckTime == 1)) {
			mes "非常感谢你的帮助。";
			mes "每隔 ^00640024 小时^000000 才会提供一个 ^006400九头蛇球^000000。";
			mes "请在合适的时间再来。";
			close;
		}
		else {
			//recall_completequest 9028;
			if (.@nQState1 > -1) erasequest 9028;
			completequest 9029;
			mes "你是来捕猎^FF0000奇怪九头蛇^000000的吗？";
			next;
				switch(select("是。:否。:^006400这里发生了什么？^000000")) {
			case 1:
				setquest 9028;
				getitem 12408,1; //Leaf_Cat_Ball
				mes "[Lucia]";
				mes "来，拿着这个 ^006400九头蛇球^000000。";
				mes "用它捕捉一只 ^FF0000奇怪九头蛇^8B4513。^000000";
				mes "希望你能成功~！";
				close;
			case 2:
				mes "[Lucia]";
				mes "啊，是我误会了。";
				mes "回头见。";
				close;
			case 3:
				goto L_WhatHappen;
			}
		}
	}
	end;

OnInit:
	initnpctimer;
	end;

OnTimer7000:
	emotion ET_SURPRISE;
	stopnpctimer;
	initnpctimer;
	end;
}

// Guarana Quest :: brazil_tre.sc
//============================================================
brasilis,187,162,5	script	Candy Maker	4_M_BRZ_MAN1,{
	if (!checkweight(1201,1)) {
		mes "- 无法开始任务。请减轻背包重量。-";
		close;
	}
	if (brazil_gua == 0) {
		mes "[Candy Maker]";
		mes "嘿，你知道一种叫 ^FF0000瓜拉纳^000000 的浆果吗？";
		next;
		mes "[Candy Maker]";
		mes "瓜拉纳是在特定地区生长的特殊浆果，能缓解身体疲劳，为身体提供力量，还能排出体内毒素。";
		next;
		mes "[Candy Maker]";
		mes "以前我会售卖用它制作的糖果。";
		mes "我曾在<年度最佳产品大赛>中获奖。那真是美好的日子。";
		next;
		mes "[Candy Maker]";
		mes "后来这种水果的产量下降、价格上涨，所以糖果原料改成了椰子或其他热带水果。我很想念瓜拉纳糖果。";
		next;
		switch(select("怎样才能尝到瓜拉纳糖果？:结束对话。")) {
		case 1:
			mes "[Candy Maker]";
			mes "嗯？我以前的存货已经全部卖光了。";
			next;
			mes "[Candy Maker]";
			mes "不过如果你能找到瓜拉纳，我可以为你制作。";
			next;
			switch(select("怎样找到瓜拉纳？:结束对话。")) {
			case 1:
				mes "[Candy Maker]";
				mes "你会去找瓜拉纳吗？？哦哦哦~";
				next;
				mes "[Candy Maker]";
				mes "你能找到吗？";
				mes "它可能非常昂贵。";
				mes "交易不是我的强项。让我想想。";
				next;
				mes "[Candy Maker]";
				mes "我介绍一个以前和我做瓜拉纳生意的人给你。";
				mes "他也许还在交易。";
				next;
				mes "[Candy Maker]";
				mes "他的名字叫 Cherto。";
				mes "如果在城里找不到他，就去博物馆。";
				mes "他很自恋，喜欢摆架子。";
				mes "他肯定在博物馆里闲逛，向别人炫耀。";
				brazil_gua = 1;
				setquest 2192;
				close;
			case 2:
				mes "[Candy Maker]";
				mes "不想尝尝瓜拉纳糖果吗？";
				close;
			}
		case 2:
			mes "[Candy Maker]";
			mes "那真是美好的日子……";
			close;
		}
	}
	else if (brazil_gua == 1) {
		mes "[Candy Maker]";
		mes "想要瓜拉纳就去找 Cherto。";
		mes "他可能在博物馆。";
		close;
	}
	else if (brazil_gua == 10) {
		if (!countitem(6237)) {
			mes "- 我拥有的瓜拉纳不见了。-";
			close;
		}
		delitem 6237,1; //Guarana_Fruit
		mes "[Candy Maker]";
		mes "你拿到瓜拉纳了吗？";
		next;
		mes "- 你把瓜拉纳交给他。-";
		next;
		mes "[Candy Maker]";
		mes "哇！你很有天赋。";
		mes "这是我见过最棒的东西。太酷了~！";
		next;
		mes "[Candy Maker]";
		mes "好，让我们制作糖果~！";
		mes "好久不见，我那美妙的瓜拉纳糖果……";
		next;
		mes "- 哈希 哈希 哈希 哈希 哈希 哈希 -";
		mes "- 哈希 哈希 哈希 哈希 哈希 哈希 -";
		next;
		mes "[Candy Maker]";
		mes "看！这就是受欢迎的瓜拉纳糖果。";
		mes "慢慢品尝它惊人的味道~别急。哈哈哈！！";
		brazil_gua = 11;
		completequest 2200;
		getitem 12414,1; //Guarana_Candy
		if (checkre(0)) {
			if (VIP_SCRIPT && vip_status(VIP_STATUS_ACTIVE))
				getexp 105000,15000;
			else
				getexp 70000,10000;
		}
		close;
	}
	else if (brazil_gua == 11) {
		mes "[Candy Maker]";
		mes "瓜拉纳糖果。那绝对是我一生中最独特的杰作！";
		next;
		mes "[Candy Maker]";
		mes "多亏你的帮助，瓜拉纳供应量稳步增加。";
		mes "所以我自然又开始制作瓜拉纳糖果。";
		next;
		mes "[Candy Maker]";
		mes "怎么样？想买一些吗？";
		mes "每个 4000 Zeny。";
		next;
		switch(select("购买瓜拉纳糖果。:取消。")) {
		case 1:
			if (Zeny > 3999) {
				mes "[Candy Maker]";
				mes "这是美味的瓜拉纳糖果。";
				Zeny = Zeny-4000;
				getitem 12414,1; //Guarana_Candy
				close;
			}
			else {
				mes "[Candy Maker]";
				mes "什么？没钱的话应该提前说！";
				mes "就算你很穷，我也不能免费送给你。";
				close;
			}
		case 2:
			mes "[Candy Maker]";
			mes "有些人不喜欢它的兴奋效果。";
			close;
		}
		close;
	}
	else {
		mes "[Candy Maker]";
		mes "瓜拉纳糖果。那绝对是我一生中最独特的杰作！";
		close;
	}
}

bra_in01,95,179,3	script	Cherto	4_M_BRZ_MAN2,{
	if (brazil_gua <= 1) {
		mes "[Cherto]";
		mes "嗯……嘿，朋友，你是外地人吧？";
		next;
		mes "[Cherto]";
		mes "Cherto 第一次见面就能看穿你。你骗不了 Cherto。";
		mes "Cherto 有鹰一样敏锐的眼睛！哈哈哈！";
		next;
		mes "[Cherto]";
		mes "好，好。是的，是的。我明白了！";
		next;
		mes "[Cherto]";
		mes "总之，你来到巴西利斯却不知道该做什么？";
		mes "我说得对吗？";
		mes "你不知道找到我这个合适的帮手有多幸运。";
		next;
		mes "[Cherto]";
		mes "Cherto 从你的表情看出你想说“你真是大师！”对吧？";
		mes "Cherto 一眼就能读懂并看穿一切！你的脸上都写着呢！";
		next;
		if (brazil_gua == 0) {
			mes "[Cherto]";
			mes "Cherto 很想留下来为你解释一切，但他可是大忙人。";
			close;
		}
		else {// brazil_gua == 1
			mes "[Cherto]";
			mes "如果你有什么好奇的事要问 Cherto，Cherto 会好心回答。";
			next;
			select("瓜拉纳？");
			mes "[Cherto]";
			mes "什么？你想找瓜拉纳？";
			next;
			mes "[Cherto]";
			mes "瓜拉纳只在这一带生长，内部柔软，外面覆盖着浅色绒毛。";
			mes "看起来有点奇怪，但花朵很大，气味也很香。";
			next;

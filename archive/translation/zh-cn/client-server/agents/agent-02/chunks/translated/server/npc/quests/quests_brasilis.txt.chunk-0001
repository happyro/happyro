//===== rAthena Script =======================================
//= Brasilis Quests
//===== Description: =========================================
//= [Official Conversion]
//= Lost Puppies (Repeatable, 24 hours.)
//= Suspicious Beach (Repeatable, 24 hours. iRO/cRO version.)
//= Guarana Candy Quest
//= Brasilis Water Lily Quest
//= Brasilis Dungeon Access Quest
//= Iara (Buff reward. Repeatable, 24 hours.)
//===== Changelog: ===========================================
//= 1.0 First version. [L0ne_W0lf]
//= 1.1 Hydra Ball (12408). [og2]
//= 1.2 Optimization. [Euphy]
//= 1.2a Added 'consumeitem' command. [Euphy]
//= 1.3 Added VIP features and fixed some EXP values. [Euphy]
//= 1.3a Clean-up. [Capuche]
//= 1.4 Added pre-renewal differences [Daegaladh]
//============================================================

// Lost Puppies :: dogdog.sc
//============================================================
brasilis,297,307,5	script	Angelo#br	1_M_04,{
	if (BaseLevel < 40) {
		mes "[Angelo]";
		mes "宠物跑出村子了~！！";
		mes "天哪……我该怎么办……？";
		close;
	}
	if (checkquest(9032,PLAYTIME) == 2) {
		erasequest 9032;
	}
	if (checkquest(9032,PLAYTIME) == 0) {
		mes "[Angelo]";
		mes "今天还没结束。";
		mes "你一天只能帮忙一次。嘿嘿。";
		close;
	}
	if (checkquest(9030) == 1) {
		mes "[Angelo]";
		mes "我的宠物在村外的田野里。";
		mes "它们为什么离开了？请帮我找到它们。";
		close;
	}
	if (checkquest(9031) == 1) {
		mes "[Angelo]";
		mes "哦，谢谢你。你找到了 3 只小狗。";
		mes "非常感谢。";
		mes "希望这对你有用。呵呵。";
		if (VIP_SCRIPT && vip_status(VIP_STATUS_ACTIVE))
			getexp 75000,0;
		else
			getexp 50000,0;
		erasequest 9031;
		setquest 9032;
		specialeffect2 EF_ASSUMPTIO;
		if (checkre(0)) {
			consumeitem 607; //Yggdrasilberry
			.@rand = rand(1,10);
			if (.@rand > 4 && .@rand < 9) getitem 504,2; //White_Potion
			else if (.@rand > 8) getitem 608,1; //Seed_Of_Yggdrasil
		}
		close;
	}
	mes "[Angelo]";
	mes "你是冒险者吗？你来得正是时候。";
	mes "小狗们一直在消失。";
	mes "有人说在村外的田野里见过它们……";
	next;
	mes "[Angelo]";
	mes "找到它们很困难，也很危险。";
	mes "你需要找到 ^0000FF3 只小狗^000000。";
	setquest 9030;
	close;

OnInit:
	initnpctimer;
	end;

OnTimer10000:
	stopnpctimer;
	donpcevent "Angelo#br::OnGo";
	end;

OnGo:
	emotion ET_SURPRISE;
	initnpctimer;
	end;
}

-	script	Puppy#bra	-1,{
	mes "[小狗]";
	mes "汪！汪汪！";
	if (checkquest(9030) == 1) {
		if (brazil_kid < 3) {
			next;
			brazil_kid++;
			mes "[" + strcharinfo(0) + "]";
			if (brazil_kid == 3) {
				mes "很好。我找到了全部 3 只小狗。";
				mes "现在得去告诉 Angelo。";
				brazil_kid = 0;
				erasequest 9030;
				setquest 9031;
			}
			else {
				mes "啊……谁是乖小狗？";
				mes "好，其他小狗在哪里？";
			}
			if (compare(strnpcinfo(2),"1")) setarray .@i[0],2,3;
			else if (compare(strnpcinfo(2),"2")) setarray .@i[0],1,3;
			else setarray .@i[0],1,2;
			donpcevent "Puppy#"+charat(strnpcinfo(2),0)+.@i[rand(2)]+"::OnEnable";
			hideonnpc strnpcinfo(0);
		}
	}
	close;

OnInit:
	if (!compare(strnpcinfo(2),"1")) hideonnpc strnpcinfo(0);
	end;

OnEnable:
	hideoffnpc strnpcinfo(0);
	end;

OnDisable:
	hideonnpc strnpcinfo(0);
	end;
}


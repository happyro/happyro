ba_bath,288,68,3	script	Sweep#172ba02	4_EP17_CLEANER,{
	if (checkweight(1000103,2) == 0) {
		mes "你持有的物品数量过多，无法继续对话。";
		mes "请清理物品栏后再试。";
		close;
	}
	if (ep17_2_bath == 2) {
		cutin "ep172_beta",2;
		mes "[清扫]";
		mes "怎么了？你特地来到这里，是想看看锅炉吗？";
		close3;
	}
	if (ep17_2_bath == 3) {
		cutin "ep172_beta",2;
		mes "[清扫]";
		mes "锅炉已经停止了。你不就是为此而来的吗？不去报告吗？";
		close3;
	}
	if (ep17_2_bath < 13) {
		cutin "ep172_beta",2;
		mes "[清扫]";
		mes "这里还有什么可看的吗？你不是还有事情要做吗？";
		close3;
	}

	// Daily : Sweepy's request
	if (isbegin_quest(17378) == 0) {
		cutin "ep172_beta",2;
		mes "[清扫]";
		mes "怎么了？还有故事要听吗？你还没找到关于怪物的全部答案吗？";
		next;
		cutin "",255;
		select( "我想和你谈谈。" );
		cutin "ep172_beta",2;
		mes "[清扫]";
		mes "你想谈什么？我唯一能谈的就是清洁。你对清洁感到好奇吗？";
		mes "这里是公共浴场，所以卫生非常重要。除了每天定期清扫，我还会在必要时尽可能频繁地清扫。";
		next;
		mes "[清扫]";
		mes "清洁用自动人偶会清除各处的异物和污垢。基本方针是在清扫时让所有客人离开浴场，但如果客人想继续泡澡，我们不应打扰他们，只需等待。";
		next;
		mes "[清扫]";
		mes "不过，清扫时出现的自动人偶很危险，而且只用于清洁，因此不建议尽可能接近它们。";
		mes "实际上，清洁人偶以前没有现在这么强。这是因为入侵者而不得不采取的措施。";
		next;
		cutin "",255;
		select( "因为入侵者？" );
		cutin "ep172_beta",2;
		mes "[清扫]";
		mes "你以前见过入侵者吗？我在浴场发现他们时，入侵者开关被触发了，我没有让他们进来。但他们成群结队地强行闯入。";
		next;
		mes "[清扫]";
		mes "他们穿过能容纳身体的地方，例如水管和排水道。湖里的鱼也能通过管道进入。";
		mes "多亏了他们，清扫变得更加困难。入侵者甚至在我清扫时进行干扰，而且事后也不帮忙清理。";
		next;
		mes "[清扫]";
		mes "这里是浴场。卫生应该是最优先的。因此清洁用自动人偶得到了强化。";
		next;
		mes "[清扫]";
		mes "入侵者虽然退了一步，但还没有完全消失。因此清洁人偶只能继续保持强化形态。清扫期间接触它们时请务必小心。";
		next;
		cutin "",255;
		select( "你经常受到干扰吗？" );
		cutin "ep172_beta",2;
		mes "[清扫]";
		mes "我不知道人类想要什么。";
		mes "不过，人类需要洗澡，也需要洗澡的空间。交给我的任务是清扫，这就是我知道的一切。";
		next;
		mes "[清扫]";
		mes "入侵者有两群。一群沉迷于浴场，另一群沉迷于浴场设施。他们的共同点是都对某件事过度执着。";
		next;
		mes "[清扫]";
		mes "沉迷洗澡的人类不配合清扫，沉迷设施的人类则破坏了设施和管理设施的自动人偶。";
		mes "锅炉被拆毁并偷走，管道被破坏，自动人偶也被拆解。其他人说不知道要多久才能恢复。宅邸其他区域的情况也差不多，整座宅邸都陷入了这种困境。";
		next;

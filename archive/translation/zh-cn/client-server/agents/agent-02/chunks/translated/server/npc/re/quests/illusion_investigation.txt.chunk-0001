//===== rAthena Script =======================================
//= Illusion Investigation
//===== Description: =========================================
//= [Walkthrough Conversion]
//= NPCs that give hunting quests in Illusion dungeons in exchange for experience.
//===== Changelog: ===========================================
//= 1.0 First version. [Capuche]
//============================================================

prt_in,136,34,3	script	Commander Joel#joel	1_M_ORIENT01,{
	if (BaseLevel < 100) {
		mes "[乔尔指挥官]";
		mes "你好，你来这里有什么事？";
		next;
		mes "[乔尔指挥官]";
		mes "如果你想加入幻影调查队，你的能力还不够。";
		next;
		mes "[乔尔指挥官]";
		mes "达到一定等级后再来吧。";
		next;
		mes "^4d4dff== 必须达到100级或以上才能加入。 ==^000000";
		close;
	}
	if (isbegin_quest(3470) == 0) {
		mes "[乔尔指挥官]";
		mes "你好，我是幻影调查队的乔尔指挥官。";
		next;
		mes "[乔尔指挥官]";
		mes "你听说过或体验过幻影吗？";
		next;
		mes "[乔尔指挥官]";
		mes "到目前为止，世界各地都发现了幻影，公众也对此有所了解。";
		next;
		mes "[乔尔指挥官]";
		mes "这里也是许多冒险者的狩猎场，因为很容易获得稀有材料。";
		next;
		mes "[乔尔指挥官]";
		mes "此外，幻影中的魔物是从未被发现过的新魔物，而且数量正在异常增加。";
		next;
		mes "[乔尔指挥官]";
		mes "尽管许多冒险者为了材料猎杀幻影中的魔物，但其数量快速恢复的原因仍未查明。";
		next;
		mes "[乔尔指挥官]";
		mes "我们组织幻影调查队是为了揭开幻影的谜团，首先决定调查幻影内魔物的生态。";
		next;
		mes "[乔尔指挥官]";
		mes "我们发现所有幻影都受到次元裂缝影响。";
		next;
		mes "[乔尔指挥官]";
		mes "我很久以来就猜测这可能与次元裂缝有关，而调查结果证实了这一点。";
		next;
		mes "[乔尔指挥官]";
		mes "仍有许多冒险者带着目的前往幻影，所以魔物数量得以维持。";
		next;
		mes "[乔尔指挥官]";
		mes "如果没人进入那里会非常危险，因为魔物可能超过饱和数量并入侵其他地区。";
		next;
		mes "[乔尔指挥官]";
		mes "因此我们仍在调查魔物数量，并为每个幻影安排一名调查员。";
		next;
		mes "[乔尔指挥官]";
		mes "我们正在招募能够控制幻影内魔物数量的成员。";
		next;
		mes "[乔尔指挥官]";
		mes "而你是冒险者，似乎足够强大，能够胜任……";
		next;
		mes "[乔尔指挥官]";
		mes "你愿意加入幻影调查队，和我们一起调查幻影吗？";
		next;
		if (select( "我要加入", "我考虑一下" ) == 2) {
			mes "[乔尔指挥官]";
			mes "这很有意义。";
			next;
			mes "[乔尔指挥官]";
			mes "告诉我之前请认真考虑。";
			close;
		}
		mes "[乔尔指挥官]";
		mes "好的，欢迎你！！";
		next;
		mes "[乔尔指挥官]";
		mes "手续很简单，请在这里填写誓约……";
		next;
		mes "[乔尔指挥官]";
		mes "这里……请签名。";
		next;
		mes "[乔尔指挥官]";
		mes ".";
		next;
		mes "[乔尔指挥官]";
		mes "..";
		next;
		mes "[乔尔指挥官]";
		mes "...";
		next;
		mes "[乔尔指挥官]";
		mes "这样你就成为幻影调查队成员了，再次欢迎你！";
		next;
		mes "[乔尔指挥官]";
		mes "冒险途中有时间的话，请顺路拜访各地的幻影，帮助我进行调查。";
		next;
		mes "[乔尔指挥官]";
		mes "派遣的调查员会引导你。";
		next;
		mes "[乔尔指挥官]";
		mes "那么祝你今天愉快。";
		close2;
		setquest 3470;
		completequest 3470;
		end;
	}
	mes "[乔尔指挥官]";
	mes "冒险者，多亏你，调查会容易很多。";
	next;
	mes "[乔尔指挥官]";
	mes "新的幻影还会再次出现。";
	next;
	mes "[乔尔指挥官]";
	mes "每次新发现都需要我们花很多时间适应。";
	next;
	mes "[乔尔指挥官]";
	mes "这项调查至少能缩短适应时间。";
	next;
	mes "[乔尔指挥官]";
	mes "谢谢，期待今后开展更多活动。";
	close;

OnInit:
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "isbegin_quest(3470) == 0" );
	end;
}

prt_in,136,29,3	script	Member Zenhi#zenhi	4_F_KHELLY,{
	mes "[成员泽尼]";
	mes "你好～～！！";
	next;
	mes "[成员泽尼]";
	mes "幻影调查队正在一点点壮大。";
	next;
	mes "[成员泽尼]";
	mes "成员越多，我们能做的事就越多，对吧？";
	close;
}

prt_in,121,36,6	script	Member Zenian#zenian	4_F_HUWOMAN,{
	mes "[成员泽尼安]";
	mes "你好，我是泽尼安，调查队的新成员。";
	next;
	mes "[成员泽尼安]";
	mes "我关注次元裂缝现象很久了。显然，尽管多次讨伐，魔物仍在不断出现。";
	next;
	mes "[成员泽尼安]";
	mes "已经证实幻影中也存在这种现象，所以我决定加入幻影调查队。";
	next;
	mes "[成员泽尼安]";
	mes "今后也请多多关照！！";
	close;
}

prt_in,124,21,1	script	 Member link#yeonsu	4_M_DEWWOMAN,{
	mes "[成员林克]";
	mes "初次见面，这是欢迎调查队。";
	next;
	mes "[成员林克]";
	mes "调查幻影中的魔物生态……";
	next;
	mes "[成员林克]";
	mes "另外……我觉得这可能与次元裂缝有关。";
	next;
	mes "[成员林克]";
	mes "希望现在努力工作的人都能平安无事地回来。";
	close;
}

pay_d03_i,149,34,5	script	Girocker#ziroker	4_M_ORIENT02,{
	if (BaseLevel < 100)
		end;
	if (isbegin_quest(3470) == 0) {
		mes "[吉罗克]";
		mes "你好！！";
		next;
		mes "[吉罗克]";
		mes "我是幻影调查队的J-吉罗克。";
		next;
		mes "[吉罗克]";
		mes "唉……居然真的来到这种地方……真希望冒险者也能帮帮我……";
		next;
		mes "[吉罗克]";
		mes "你还没有加入调查队。";
		next;
		mes "[吉罗克]";
		mes "想和我一起调查这里的魔物吗？一定很有意义！！";
		next;
		mes "[吉罗克]";
		mes "请向普隆德拉的调查员<NAVI>[乔尔]<INFO>prt_in,136,34,</INFO></NAVI>申请加入，然后来找我！！";
		close;
	}
	if (isbegin_quest(3446) == 0) {
		mes "[吉罗克]";
		mes "你好！！";
		next;
		mes "[吉罗克]";
		mes "我是幻影调查队的J-吉罗克。";
		next;
		mes "[吉罗克]";
		mes "唉……来到这种地方……";
		next;
		mes "[吉罗克]";
		mes "我平时假装勇敢，但我想是因为在意我喜欢的成员艾莉西亚。";
		next;
		mes "[吉罗克]";
		mes "其实我才是最胆小的那个……可恶。";
		next;
		mes "[吉罗克]";
		mes "总之……我负责调查这里。";
		next;
		mes "[吉罗克]";
		mes "你听乔尔队长说过调查内容吗？冒险者，你必须独自猎杀100只魔物。";
		next;
		mes "[吉罗克]";
		mes "想参加这里的调查吗？";
		next;
		if (select( "参加", "不参加" ) == 2) {
			mes "[吉罗克]";
			mes "那我去问其他冒险者……";
			close;
		}
		mes "[吉罗克]";
		mes "好啊！！";
		next;
		mes "[吉罗克]";
		mes "只要在这里猎杀100只任意类型的魔物。";
		next;
		mes "[吉罗克]";
		mes "那么小心！";
		close2;
		setquest 3446;
		completequest 3446;
		setquest 3447;
		end;
	}
	switch( checkquest(3448,PLAYTIME) ) {
	case -1:
		break;
	case 0:
	case 1:
		mes "[吉罗克]";
		mes "啊，今天的调查到此为止。";
		next;
		mes "[吉罗克]";
		mes "明天会恢复，所以如果你有时间，希望你能来帮我调查！！";
		close;
	case 2:
		erasequest 3448;
		break;
	}
	switch( checkquest(3447,HUNTING) ) {
	case -1:
		mes "[吉罗克]";
		mes "你好，你今天是来帮忙调查的吗？";
		next;
		mes "[吉罗克]";
		mes "内容和上次一样。";
		next;
		mes "[吉罗克]";
		mes "如果猎杀100只任意类型的魔物，想参加吗？";
		next;
		if (select( "参加", "不参加" ) == 2) {
			mes "[吉罗克]";
			mes "今天你能帮我就好了……";
			close;
		}
		mes "[吉罗克]";
		mes "好啊！！";
		next;
		mes "[吉罗克]";
		mes "只要在这里猎杀100只任意类型的魔物。";
		next;
		mes "[吉罗克]";
		mes "那么小心！";
		close2;
		setquest 3447;
		end;
	case 0:
	case 1:
		mes "[吉罗克]";
		mes "猎杀100只任意类型的魔物。";
		close;
	case 2:
		mes "[吉罗克]";
		mes "你平安回来了！";
		next;
		mes "[吉罗克]";
		mes "好……那么嗯……我得等一会儿，看看会生成多少魔物。";
		next;
		mes "[吉罗克]";
		mes "剩下的交给我！！谢谢！！";
		close2;
		erasequest 3447;
		setquest 3448;
		getexp 2500000,2500000;
		end;
	}
	end;

OnInit:
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "BaseLevel >= 100 && isbegin_quest(3470) == 2 && isbegin_quest(3446) == 0" );

	questinfo( QTYPE_QUEST2, QMARK_YELLOW, "checkquest(3447,HUNTING) == 2" );
	questinfo( QTYPE_DAILYQUEST, QMARK_YELLOW, "isbegin_quest(3446) == 2 && checkquest(3448,PLAYTIME) == -1 && checkquest(3447,HUNTING) == -1" );
	questinfo( QTYPE_DAILYQUEST, QMARK_YELLOW, "checkquest(3448,PLAYTIME) == 2" );
	end;
}

ice_dun02,142,18,5	script	Elysia#elisia	4_F_OPERATION,{
	if (BaseLevel < 120) {
		mes "[艾莉西亚]";
		mes "哦，你一定很难忍受这里的寒冷吧？";
		next;
		mes "[艾莉西亚]";
		mes "暖和一点后再回来。";
		next;
		mes "^4d4dff== 这是等级120或以上的任务。 ==^000000";
		close;
	}
	if (isbegin_quest(3470) == 0) {
		mes "[艾莉西亚]";
		mes "你好～";
		next;
		mes "[艾莉西亚]";
		mes "我是幻影调查队的艾莉西亚～";
		next;
		mes "[艾莉西亚]";
		mes "这里真的很冷……";
		next;
		mes "[艾莉西亚]";
		mes "我想请冒险者帮忙……";
		next;
		mes "[艾莉西亚]";
		mes "你还没有加入调查队。";
		next;
		mes "[艾莉西亚]";
		mes "如果你不介意，为什么不加入幻影调查队？这样就能帮我了！！！";
		next;
		mes "[艾莉西亚]";
		mes "请向普隆德拉的<NAVI>[乔尔]<INFO>prt_in,136,34,</INFO></NAVI>指挥官申请加入，然后来找我！！";
		close;
	}
	if (isbegin_quest(3449) == 0) {
		mes "[艾莉西亚]";
		mes "你好～";
		next;
		mes "[艾莉西亚]";
		mes "我是幻影调查队的艾莉西亚～";
		next;
		mes "[艾莉西亚]";
		mes "这里真的很冷……";
		next;
		mes "[艾莉西亚]";
		mes "我没想到会被独自派到这么危险的地方……我本想和吉罗克一起来……";
		next;
		mes "[艾莉西亚]";
		mes "不过就算吉罗克在，他也是个胆小鬼，反而得由我保护他……";
		next;
		mes "[艾莉西亚]";
		mes "你装得很勇敢……但我早就看出来了";
		next;
		mes "[艾莉西亚]";
		mes "吉罗克在废弃村庄安全地调查吗？我很担心。";
		next;
		mes "[艾莉西亚]";
		mes "嗯……其实现在不是担心吉罗克的时候，冒险者。你能帮我吗？";
		next;
		mes "[艾莉西亚]";
		mes "你听说这是调查魔物数量如何维持的任务吗？许多冒险者来这里狩猎，但数量似乎仍不够。";
		next;
		mes "[艾莉西亚]";
		mes "积极处理魔物就容易弄清数量。你呢？想参加这里的调查吗？";
		next;
		if (select( "参加", "不参加" ) == 2) {
			mes "[艾莉西亚]";
			mes "嗯，是的……";
			next;
			mes "[艾莉西亚]";
			mes "那我只能再发抖一会儿了……";
			close;
		}
		mes "[艾莉西亚]";
		mes "哦，是的！！谢谢！！";
		next;
		mes "[艾莉西亚]";
		mes "进入后猎杀100只任意类型的魔物。";
		next;
		mes "[艾莉西亚]";
		mes "期待你热情高涨的狩猎技能～～！！";
		close2;
		setquest 3449;
		completequest 3449;
		setquest 3450;
		end;
	}
	switch( checkquest(3451,PLAYTIME) ) {
	case -1:
		break;
	case 0:
	case 1:
		mes "[艾莉西亚]";
		mes "啊，我想今天应该够了！！";
		next;
		mes "[艾莉西亚]";
		mes "明天之后再来，你会有其他事情可做～";
		close;
	case 2:
		erasequest 3451;
		break;
	}
	switch( checkquest(3450,HUNTING) ) {
	case -1:
		mes "[艾莉西亚]";
		mes "啊，很高兴见到你！！你今天是来帮忙调查的吗？？";
		next;
		mes "[艾莉西亚]";
		mes "和上次一样，需要你的帮助～";
		next;
		mes "[艾莉西亚]";
		mes "如果猎杀100只任意类型的魔物，想参加吗？";
		next;
		if (select( "参加", "不参加" ) == 2) {
			mes "[艾莉西亚]";
			mes "好吧……我会继续在寒冷中发抖……";
			close;
		}
		mes "[艾莉西亚]";
		mes "谢谢你";
		next;
		mes "[艾莉西亚]";
		mes "进入后猎杀100只任意类型的魔物。";
		next;
		mes "[艾莉西亚]";
		mes "那么小心！";
		close2;
		setquest 3450;
		end;
	case 0:
	case 1:
		mes "[艾莉西亚]";
		mes "猎杀100只任意类型的魔物。";
		close;
	case 2:
		mes "[艾莉西亚]";
		mes "已经完成了吗？不愧是你，干劲十足～";
		next;
		mes "[艾莉西亚]";
		mes "那剩下的研究就交给我吧～";
		next;
		mes "[艾莉西亚]";
		mes "谢谢你 for your hard work. I hope we can meet again!!";
		close2;
		erasequest 3450;
		setquest 3451;
		getexp 6000000,6000000;
		end;
	}
	end;

OnInit:
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "BaseLevel >= 120 && isbegin_quest(3470) == 2 && isbegin_quest(3449) == 0" );

	questinfo( QTYPE_QUEST2, QMARK_YELLOW, "checkquest(3450,HUNTING) == 2" );
	questinfo( QTYPE_DAILYQUEST, QMARK_YELLOW, "isbegin_quest(3449) == 2 && checkquest(3451,PLAYTIME) == -1 && checkquest(3450,HUNTING) == -1" );
	questinfo( QTYPE_DAILYQUEST, QMARK_YELLOW, "checkquest(3451,PLAYTIME) == 2" );
	end;
}

gef_d01_i,122,237,3	script	Radimir#ridimir	8_F,{
	if (BaseLevel < 130)
		end;
	if (isbegin_quest(3470) == 0) {
		mes "[拉迪米尔]";
		mes "你好，冒险者。";
		next;
		mes "[拉迪米尔]";
		mes "我是幻影调查队的拉迪米尔。";
		next;
		mes "[拉迪米尔]";
		mes "我被派到这种阴沉的地方，说实话非常害怕。";
		next;
		mes "[拉迪米尔]";
		mes "我想和你一起进行调查，但是……你还没有加入调查队。";
		next;
		mes "[拉迪米尔]";
		mes "想和我一起做有意义的事吗？";
		next;
		mes "[拉迪米尔]";
		mes "如果你感兴趣，请去普隆德拉找指挥官<NAVI>[乔尔]<INFO>prt_in,136,34,</INFO></NAVI>，加入调查队后再回来。";
		close;
	}
	if (isbegin_quest(3452) == 0) {
		mes "[拉迪米尔]";
		mes "你好，冒险者。";

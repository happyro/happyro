      bonus bAgi,.@r/2;
      bonus bLuk,.@r/2;
      if (.@r>=7) {
         bonus bAspdRate,5;
         if (.@r>=9) {
             bonus bAspdRate,5;
             bonus bCritical,5;
         }
      }

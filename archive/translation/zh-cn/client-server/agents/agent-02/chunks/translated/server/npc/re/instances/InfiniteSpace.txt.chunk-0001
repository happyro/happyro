cmd_fild07,58,278,3	script	Reckless Explorer#pa0829_01	4_F_GON,{
	mes "^FF0000请注意，在副本内进行驯服等异常的魔物处理不属于正常行为，可能会妨碍副本进度。^000000"; 
	next;
	if (BaseLevel < 100) {
		mes "[ 鲁莽的探险家 ]";
		mes "等你变得更强一些后再回来吧？先升到 100 级怎么样？";
		close;
	}
	if (isbegin_quest(12364) != 2) {
		mes "[ 鲁莽的探险家 ]";
		mes "啊，不，我没打算进去。我也没打算违反任何法律。";
		next;
		select("What are you talking about?");
		mes "[ 鲁莽的探险家 ]";
		mes "哈？";
		next;
		mes "[ 鲁莽的探险家 ]";
		mes "嗯，你是王宫镇压部队的人吗？";
		next;
		select("I'm an ordinary adventurer.");
		mes "[ 鲁莽的探险家 ]";
		mes "呼～那就放心了。";
		mes "我以前从没见过你，所以以为你是王宫的镇压部队成员。";
		next;
		if (select("What if I am one of the suppression squad?:What's the matter?") == 1) {
			mes "[ 鲁莽的探险家 ]";
			mes "我只是出来散步的普通女性。散步就到此为止，我要去……";
			close;
		}
		mes "[ 鲁莽的探险家 ]";
		mes "你听说过帕罗斯灯塔倒塌的事吗？";
		next;
		mes "[ 鲁莽的探险家 ]";
		mes "^777700（她靠近了我）^000000";
		mes "这里的帕罗斯灯塔不久前因不明原因倒塌，下面还堆着许多东西。";
		next;
		mes "[ 鲁莽的探险家 ]";
		mes "派往王宫的一些修复工人和卫兵失踪了。据说魔物正在下面爬行。";
		next;
		mes "[ 鲁莽的探险家 ]";
		mes "由于深度仿佛没有尽头，这里的人们害怕这个地方，开始称它为无限空间。";
		next;
		mes "[ 鲁莽的探险家 ]";
		mes "我认识一些偷偷进去并发了财的人。所以我也打算试试，你有兴趣吗？";
		next;
		if (select("I'm not interested.:Yes.") == 1) {
			mes "[ 鲁莽的探险家 ]";
			mes "真遗憾。改变主意后随时回来，我随时欢迎你。";
			close;
		}
		mes "[ 鲁莽的探险家 ]";
		mes "好吧，不过有件事要说明，我没有经验，只是个新手冒险家。所以我会在安全的地方为你引路，帮你探索下面。";
		next;
		mes "[ 鲁莽的探险家 ]";
		mes "我负责冒险向导，你可以自己探索。我们不是很合拍吗？准备好后就开始吧。";
		setquest 12364;
		completequest 12364;
	} else {
		mes "[ 鲁莽的探险家 ]";
		mes "这次你还要再进去吗？";
		switch (checkquest(12365,PLAYTIME)) {
			case -1:
				break;

			case 0:
			case 1:
				next;
				mes "[ 鲁莽的探险家 ]";
				mes "哦，你的身体已经在喊累了。不能就这样下去。";
				close;

			case 2:
				erasequest 12365;
				break;
		}
	}
	next;
	.@md_name$ = "Infinite Space";
	.@party_id = getcharid(1);
	if (!.@party_id) {
		mes "[ 鲁莽的探险家 ]";
		mes "一个人是不可能的。要不要至少组织一支队伍，或加入其他队伍后再回来？";
		close;
	}
	if (select("Prepare to enter Infinite Space:Cancel") == 2)
		close;
	mes "[ 鲁莽的探险家 ]";
	mes "通道打开后先喘口气，再来和我谈谈。";
	if (instance_create(.@md_name$) == -3)
		dispbottom "The reservation of the instance '" + .@md_name$ + "' has failed due to an active instance.";
	close;
}

cmd_fild07,54,280,5	script	Temporary Entrance#pa0829_01	PORTAL,{
	switch (checkquest(12365,PLAYTIME)) {
		case -1:
			break;

		case 0:
		case 1:
			mes "通道尚未启动。";
			close;

		case 2:
			erasequest 12365;
			break;
	}
	.@party_id = getcharid(1);
	.@party_name = getpartyname(.@party_id);
	.@md_name$ = "Infinite Space";
	switch (instance_enter(.@md_name$)) {
		case IE_OK:
			setquest 12365;
			mapannounce "cmd_fild07", strcharinfo(0) + " of the party, "+ .@party_name$ +", is entering the " + .@md_name$ + ".", bc_map, "0x00FF99";
			end;

		default:
			mes "通道尚未启动。";
			close;
	}
}

1@infi,1,1,0	script	#inf_space_control	HIDDEN_WARP_NPC,{
	end;

OnInstanceInit:
	'map$ = instance_mapname("1@infi");
	'floor = 1;
	'sanity = 0;

	enablenpc instance_npcname("#inf_space_mobs");
	enablenpc instance_npcname("#w0_0");
	enablenpc instance_npcname("#w0");
	disablenpc instance_npcname("#w50_ppl");
	hideonnpc instance_npcname("#w0");

	// Initiate Warp Portals
	for (.@i = 1; .@i < 50; .@i++)
		disablenpc instance_npcname("#w" + .@i);

	// Initiate Treasure Chests
	for (.@i = 10; .@i < 51; .@i += 10)
		disablenpc instance_npcname("#w" + .@i + "_t");

	// Initiate Floor Coordinates
	setarray .@xy[1],
	//1~10
	27,18,33,25,
	29,47,36,57,
	24,81,34,91,
	25,112,35,123,
	16,152,45,164,
	24,228,34,239,
	26,261,35,271,
	25,291,36,302,
	24,324,35,335,
	23,375,23,375,
	//11~20
	108,15,118,29,
	108,49,118,58,
	107,80,118,91,
	108,111,116,121,
	99,152,123,163,
	106,229,116,236,
	106,259,117,271,
	109,295,118,303,
	107,324,118,335,
	114,364,114,364,
	//21~30
	192,15,204,25,
	192,47,202,56,
	193,80,204,91,
	192,111,204,122,
	191,152,212,162,
	188,219,200,231,
	190,251,199,263,
	188,283,199,295,
	188,315,199,327,
	202,385,202,385,
	//31~40
	274,16,285,22,
	274,49,283,58,
	274,80,285,91,
	276,112,286,123,
	268,153,294,164,
	274,220,286,231,
	276,252,285,263,
	274,283,286,294,
	275,316,286,323,
	269,376,269,376,
	//40~50
	356,20,364,27,
	357,48,367,58,
	357,79,368,91,
	356,112,368,123,
	349,152,374,164,
	362,221,371,230,
	360,251,372,263,
	361,283,372,295,
	360,315,372,325,
	354,376,354,376;
	for (.@i = 1; .@i < getarraysize(.@xy); .@i += 4) {
		.@f++;
		setd("'xy_" + .@f + "$",.@xy[.@i] + "," + .@xy[.@i+1] + "," + .@xy[.@i+2] + "," + .@xy[.@i+3]);
	}
end;
}

// Monster spawn mechanics
1@infi,1,1,0	script	#inf_space_mobs	HIDDEN_WARP_NPC,{
	end;

OnSummonPoring:
	.@event2$ = instance_npcname(strnpcinfo(0)) + "::OnPoringKill";
	if (!mobcount('map$,.@event2$)) {
		explode(.@xy$,getd("'xy_" + 'floor + "$"),",");
		areamonster 'map$,atoi(.@xy$[0]),atoi(.@xy$[1]),atoi(.@xy$[2]),atoi(.@xy$[3]),"--ja--",3494,1,.@event2$;
		initnpctimer;
	}
	end;

OnTimer20000:
	.@event2$ = instance_npcname(strnpcinfo(0)) + "::OnPoringKill";
	killmonster 'map$,.@event2$;
	stopnpctimer;
	end;

OnSummon:
	.@event$ = instance_npcname(strnpcinfo(0)) + "::OnMobKill";
	switch ('floor) {
		case 1:
			setarray .@mob,3384,3385,3386;
			setarray .@amount,6,5,3;
			break;

		case 2:
			setarray .@mob,3384,3386,3387;
			setarray .@amount,6,3,2;
			break;


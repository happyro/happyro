malangdo,175,163,0	script	Meowbell#nya_12	844,{
	if (countitem(6428) == 0) {
		mes "这里有一只和船不太相称的精致铃铛。";
		mes "猫咪勇气队在游戏中使用这只铃铛。";
		viewpoint 2,1,1,0,0xFFFFFF;
		viewpoint 2,1,1,1,0xFFFFFF;
		viewpoint 2,1,1,2,0xFFFFFF;
		viewpoint 2,1,1,3,0xFFFFFF;
		viewpoint 2,1,1,4,0xFFFFFF;
		viewpoint 2,1,1,5,0xFFFFFF;
		close;
	}
	if (nyadven02 == 16)
		set .@quest,7244;
	else if (nyadven02 == 26)
		set .@quest,7245;
	else {
	mes "甲板上巨大的通知铃旁还有一只小铃铛。";
	mes "这是猫咪勇气队的喵铃。";
		next;
	mes "如果你有游戏卡，这是最后要敲响的铃。";
	mes "暂时没什么可说的。";
		close;
	}
	mes "这是喵铃。";
	mes "你把卡片插入中间的插槽。";
	viewpoint 2,1,1,0,0xFFFFFF;
	viewpoint 2,1,1,1,0xFFFFFF;
	viewpoint 2,1,1,2,0xFFFFFF;
	viewpoint 2,1,1,3,0xFFFFFF;
	viewpoint 2,1,1,4,0xFFFFFF;
	viewpoint 2,1,1,5,0xFFFFFF;
	if (checkquest(.@quest,PLAYTIME) == 0 || checkquest(.@quest,PLAYTIME) == 1) {
	mes "敲响喵铃！！";
		set nyadven02,27;
		changequest .@quest,7257;
		next;
		if (nyadven == 3) {
			mes "[Deckhand Bubi]";
			mes "哦，真令人惊讶。";
			mes "你在很短时间内敲响了喵铃。";
			mes "我觉得你有成为冒险者的才能。";
			next;
			mes "[Deckhand Bubi]";
			mes "人们说……";
			mes "这个嘟噜嘟噜游戏的目的";
			mes "是快速准确地找到并前往目的地。";
			next;
			mes "[Deckhand Bubi]";
			mes "拿着那张冒险卡去找查罗。";
			mes "成功后我会给你盖确认章。";
			set nyadven,4;
			close;
		} else {
			mes "[Deckhand Bubi]";
		mes "哦，你真的熟练了。";
		mes "你又成功了。";
		mes "我在这里盖上爪印。";
		mes "现在跑去找拉托。";
			close;
		}
	} else {
		mes "-- Beep --";
		mes "卡片发出警告声弹了出来。";
		set nyadven02,28;
		changequest .@quest,7257;
		next;
		mes "[Deckhand Bubi]";
		mes "你没有在规定时间内敲响喵铃。";
		mes "好了，现在我也无能为力。";
		mes "我会给你盖失败章！！";
		close;
	}
}

malangdo,176,165,3	script	Deckhand Bubi#nya_16	544,{
	mes "[Bubi]";
	mes "嘿，人类冒险者，你来这里做什么？";
	mes "是啊~这里风景真美。";
	next;
	mes "[Bubi]";
	mes "你是来敲喵铃的人吗？";
	mes "我不是猫咪队成员，但可以给你盖确认章。";
	next;
	mes "[Bubi]";
	mes "嗯，我的工作？";
	mes "哦，那是我不出航时才做的事。";
	mes "我最近有空。";
	close;
}

malangdo,172,178,7	script	Cat Detective#nya_14	560,{
	cutin "mal_homnya_n",2;
	if (nyadven < 6) {
		mes "[Cat Detective]";
		mes "嗯？怎么了？";
		mes "嘿，这里有个可疑的家伙。";
		next;
		mes "[Cat Detective]";
		mes "从液体的气味我可以确定他喝醉了。";
		mes "我真是悲伤得说不出话。";
		next;
		mes "[Friend of Detective]";
		mes "哦，听说你有这么高明的分析能力，我真遗憾！";
		mes "他没有喝醉……";
		next;
		mes "[Cat Detective]";
		mes "醉汉总是有液体的气味。";
		mes "但他没有，所以他没醉，朋友。";
		next;
		select("那你的身份是什么？" );
		cutin "mal_homnya_s",2;
		mes "[Cat Detective]";
		mes "嗯……你什么都是，唯独不是醉汉！！！";
		next;
		mes "猫咪们的声音听起来在发抖。";
		close2;
	} else if (nyadven == 6) {
		mes "[Cat Detective]";
		mes "我说什么了？";
		mes "我不是告诉过你很快会有人来吗？";
		next;
		mes "[Friend of Detective]";
		mes "太好了。";
		mes "我只能佩服你的推理。";
		next;
		mes "[Detective Homnya]";
		mes "哈哈，喵森，这对我来说不算什么。";
		mes "在那之前，先听听访客的故事吧。";
		next;
		switch(select("查罗？罗西？：你们是侦探吗？")) {
		case 1:
			cutin "mal_homnya_s",2;
			mes "[Homnya]";
			mes "不……他们是谁？";
			mes "喵森，你认识他们吗？";
			next;
			mes "[Nyangson]";
			mes "我……我也不知道？";
			mes "我不认识查罗和罗西！";
			next;
			mes "[Homnya]";
			mes "是的，是的。";
			mes "我们是侦探和朋友！";
			next;
			break;
		case 2:
			mes "[Homnya]";
			mes "是的，我是侦探喵妮雅。";
			mes "这是我的朋友喵森。他负责报告我的案件。";
			next;
			break;
		}
		mes "[Homnya]";
		mes "总之，现在这不重要！";
		mes "我们应该关注当前情况。";
		next;
		mes "[Nyangson]";
		mes "是的，没错，朋友。";
		mes "我们认为……";
		next;
		mes "[Homnya]";
		mes "是的！这肯定是炸弹！";
		mes "真抱歉，我只有分析和侦探技能，没有拆除炸弹的技能！";
		next;
		cutin "mal_homnya_s",2;
		mes "[Nyangson]";
		mes "你这是什么意思？";
		mes "完全没有道理！";
		next;
		mes "[Homnya]";
		mes "是的，当它从希望的顶峰变成悲伤的顶峰时，我们就会大喊。";
		mes "顶峰！";
		mes "喵！";
		next;
		mes "我不明白这是什么意思，但他们似乎很着急。";
		next;
		 switch(select("继续陪他们演戏。：别再胡闹。")) {
		case 1:
			cutin "mal_homnya_n",2;
			mes "[Homnya]";
			mes "哦，如果你愿意帮忙，我会接受。你觉得呢，朋友？";
			next;
			mes "[Nyangson]";
			mes "我其实不在乎。我只想报告这个案件。";
			mes "这会成为最奇怪案件中的公开案例之一。";
			next;
			mes "[Homnya]";
			mes "我就知道这位访客有拆除炸弹的能力。";
			mes "他已经做好了逃离危险的充分准备。";
			next;
			mes "[Nyangson]";
			mes "哦，我听说过。据说还会使用苍蝇翅膀和蝴蝶翅膀。";
			mes "没想到真的能遇到使用这些东西的人。";
			next;
			mes "[Homnya]";
			mes "是的，我相信这位访客会解开谜团。";
			mes "那么请停止这台该死的机器！";
			next;
			mes "[Nyangson]";
			mes "没错，该死的机器！";
			mes "又吵又没用！";
			mes "而且马上就要爆炸了。";
			next;
			mes "[Homnya]";
			mes "好了，停下这台机器！！！";
			set nyadven,7;
			changequest 7246,7247;
			close2;
			break;
		case 2:
			cutin "mal_homnya_s",2;
			mes "[Homnya]";
			mes "请不要……";
			mes "请按照剧本行动。";
			next;
			mes "[Nyangson]";
			mes "查罗，剧本在哪里？";
			mes "不，喵妮雅。我的朋友……";
			next;
			mes "两只小猫不停地冒汗。";
			close2;
			break;
		}
	} else if (nyadven == 7) {
		mes "[Homnya]";
		mes "停止这台吵闹的机器！";
		mes "现在正是你的记忆可能恢复的时刻！";
		next;
		mes "[Nyangson]";
		mes "是的，是的。";
		mes "这就是拆除并突破所有陷阱的训练。";
		mes "没错，就是这样。";
		close2;
	} else if (nyadven == 8) {
		mes "[Homnya]";
		mes "那一刻真可怕。";
		mes "不过这台机器还好好的！";
		mes "再停一次。";
		next;
		mes "[Homnya]";
		mes "是的，操作这台机器需要冒险卡B。";
		mes "你想买一张新的吗？";
		next;
		mes "[Nyangson]";
		mes "需要一个马来岛罐头。";
		next;
		switch(select("购买冒险卡。：不买。")) {
		case 1:
			if (countitem(12636) == 0) {
				mes "[Homnya]";
				mes "我说过可以用一个马来岛罐头交换冒险卡~";
				close2;
				break;
			}
			mes "[Homnya]";
			mes "看，这是一台可怕的机器。";
			mes "这是你的冒险卡。";
			mes "这次把机器停下来。";
			delitem 12636,1; //Malang_Sp_Can
			set nyadven,7;
			getitem 6429,1; //Bravery_Card_B
			close2;
			break;
		case 2:
			mes "[Homnya]";
			mes "什么？";
			mes "但你来这里就是为了买冒险卡。";
			mes "......";
			next;
			mes "[Nyangson]";
			mes "如果你买一张冒险卡，就不会发生流血事件……";
			close2;
			break;
		}
	} else if (nyadven == 9) {
		mes "[Homnya]";
		mes "嘿，有个好消息告诉你。";
		mes "你和机器较劲时，我收到了很棒的消息。";
		next;
		mes "[Nyangson]";
		mes "你好，能干的朋友，你发现了什么？";
		mes "这是隐藏的宝藏吗？";
		next;
		mes "[Homnya]";
		mes "隐藏的宝藏？";
		mes "非常相似！";
		mes "它们藏在船舱里的几个地方。";
		mes "你去找找吧！";
		next;
		switch(select("我现在累了。：哦，好！")) {
		case 1:
			mes "[Homnya]";
			mes "哦，真的吗？";
			mes "累了的话就算了。";
			mes "想来的话再来吧。";
			next;
			mes "[Nyangson]";
			mes "请再来~";
			close2;
			break;
		case 2:
			mes "[Homnya]";
		mes "我就知道你会这么做！";
		mes "我很会看人。";
		mes "地点就在纳维号里面。";
			next;
			mes "[Nyangson]";
		mes "那里不大，不会有问题。";
		mes "期待你的积极表现！";
			set nyadven,10;
			setquest 7250;
			close2;
			break;
		}
	} else if (nyadven == 10) {
		mes "[Homnya]";
		mes "请找到宝藏碎片。";
		mes "根据我们的情报，宝藏藏在纳维号内部。";
		next;
		mes "[Nyangson]";
		mes "找到宝藏后马上来这里！";
		close2;
	} else if (nyadven == 11) {
		if (countitem(6430) > 5) {
			mes "[Homnya]";
			mes "你找齐了所有宝藏。";
			mes "没错，就是这样。";
			mes "你可能以为这幅画只是普通的画。";
			next;
			mes "[Homnya]";
			mes "但是……！";
			mes "如果我们这样做……！";
			next;
			mes "[Nyangson]";
			mes "哦，这是……那一刻的画……";
			mes "这是我们离开故乡时的画。";
			next;
			mes "[Homnya]";
			mes "是时候把它还给勇敢的新队伍了！";
			mes "还回去吧！";
			mes "喵~";
			next;
			mes "装扮成喵妮雅和喵森的查罗与罗西";
			mes "检查画的碎片，并再次将它们归还。";
			mes "他们看起来很兴奋。";
			next;
			mes "[Homnya]";
			mes "请把它还给猫咪勇气队~";
			mes "为了大家~喵~";
			mes "这才是真正的宝藏！";
			set nyadven,12;
			erasequest 7250;
			erasequest 7251;
			erasequest 7252;
			erasequest 7253;
			erasequest 7254;
			erasequest 7255;
			erasequest 7256;
			setquest 7258;
			close2;
		} else {
			mes "[Homnya]";
			mes "嗯？真奇怪。应该有6块宝藏碎片。";
			mes "少了几块……";
			mes "这是假的？我要把它扔掉！";
			next;
			mes "[Nyangson]";
			mes "再去找宝藏！";
			delitem 6430,countitem(6430); //Picture_Piece
			erasequest 7251;
			erasequest 7252;
			erasequest 7253;
			erasequest 7254;
			erasequest 7255;
			erasequest 7256;
			set nyadven,10;
			setquest 7250;
			close2;
		}
	} else if (nyadven == 12 || nyadven == 13) {
		mes "[Homnya]";
		mes "请把你找到的这些宝藏交给猫咪勇气队。";
		mes "交给他们时你就会知道这些宝藏有多珍贵~";
		next;
		mes "[Nyangson]";
		mes "是的，你会明白的。";
		mes "稍微休息一下也好，但我们现在没有多余时间。";
		close2;
	} else {
		if (countitem(6429) > 0) {
			mes "[Homnya]";
			mes "停止这台吵闹的机器！";
			mes "插入你的冒险卡，仔细观察机器的反应，然后采取正确行动！";
			next;
			mes "[Nyangson]";
			mes "没错~";
			close2;
		}
		mes "[Homnya]";
		mes "嘿，喵森。";
		mes "英雄来了。";
		mes "他似乎是来修理这台淘气机器的。";
		next;
		mes "[Nyangson]";
		mes "我一直很佩服你敏锐的洞察力。";
		mes "他确实就是那样的人。";
		mes "那么他会用马来岛罐头购买冒险卡吗？";
		next;
		mes "[Homnya]";
		mes "你越来越厉害了。";
		mes "我一直关注着你敏锐的洞察力。";

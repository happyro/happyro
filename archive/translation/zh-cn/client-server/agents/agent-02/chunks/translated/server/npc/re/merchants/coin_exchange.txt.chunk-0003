		break;
	}
	mes "每次使用间隔需要 5 秒。";
	mes "每个需要 "+ .cost[.@item] +" 枚斯普兰迪德硬币。";
	next;
	.@buy = select("购买 1 个。:购买 10 个。:不买。");
	if (.@buy == 3){
		close;
	}
	if (.@buy == 2){
		.@buy = 10;
	}
	mes "[Herb Merchant]";
	mes "要购买 "+ .@buy +" 个"+ getitemname(.items[.@item]) +"吗？";
	next;
	if (select("购买。:不买。") == 2){
		close;
	}
	if (countitem(6081) < (.cost[.@item]*.@buy) ) {
		mes "[Herb Merchant]";
		mes "你的硬币不够。";
		close;
	}
	mes "[Herb Merchant]";
	mes "感谢你的惠顾。";
	delitem 6081,.cost[.@item]*.@buy; //Splendide_Coin
	getitem .items[.@item],.@buy;
	close;
	
OnInit:
	setarray .items[0],12812,12813,12814,12815;
	setarray .cost[0],5,5,1,1;	//Splendide Coins
	end;
}

ecl_in01,67,39,4	script	Replication Expert Paltu	445,{
	if (checkweight(1301,3) == 0) {
		mes "你携带的物品太多，无法继续。";
		close;
	}
	emotion ET_THROB;
	mes "[Paltu]";
	mes "呜呼——你好。你在找什么？这里有很多商品。";
	next;
	switch (select("不用了，谢谢。:复制？:我知道你有很多本事！")) {
	case 1:
		emotion ET_FRET;
		mes "[Paltu]";
		mes "真的吗？嗯？";
		close;
	case 2:
		mes "[Paltu]";
		mes "可以说，在利用魔法抗性方面，埃克拉珠没人比我更厉害。";
		next;
		mes "[Paltu]";
		mes "无论是什么我都会给你优惠价。相信我就好。";
		next;
		select("你能帮我做件事吗？");
		emotion ET_BEST;
		mes "[Paltu]";
		mes "嘿，我喜欢你的态度。";
		next;
		mes "[Paltu]";
		mes "啊——你知道自己戴的帽子吗？";
		next;
		emotion ET_QUESTION;
		mes "[Paltu]";
		mes "你仓库里是不是有一些结实却丑得没法戴的帽子？有吧？";
		next;
		select("……");
		emotion ET_THINK, playerattached();
		emotion ET_SMILE;
		mes "[Paltu]";
		mes "看吧！我就知道。我第一眼就知道了。";
		next;
		mes "[Paltu]";
		mes "如果你带来 ^ff0000 50 枚斯普兰迪德硬币和材料^000000，我会制作同样形状、但作为^ff0000时装^000000穿戴的新帽子。";
		next;
		mes "[Paltu]";
		mes "嗯，叫什么来着……？";
		mes "我想你们冒险者称它们为^0571B0时装^000000，对吧？";
		next;
		select("是的~ 你需要什么？");
		mes "[Paltu]";
		mes "我需要 1 顶^0571B0要复制的帽子^000000，";
		mes "以及用于魔法抗性的 ^E1281E4 面晶镜^000000、作为催化剂的 ^E1281E1 份妖精魔粉^000000，还有用于增强魔力的 ^E1281E祖母绿、红宝石、蓝宝石、黄玉和锆石各 10 个^000000。";
		next;
		emotion ET_STARE_ABOUT;
		mes "[Paltu]";
		mes "材料很多，对吧？不过我也没办法。处理魔力可不是开玩笑。";
		next;
		select("哪些帽子可以复制？");
		mes "[Paltu]";
		mes "哦！你真敏锐！";
		mes "我差点忘了最重要的事。";
		next;
		mes "[Paltu]";
		mes "我可以复制的帽子有：";
		mes "^0571B0Frog Hat, Romantic Flower, Magestic Goat, Blush, Valkyrie Helm, Deviruchi Hat, Assassin Mask, Elven Ears, Hahoe Mask, and Boys Cap^000000 a total of 10 types.";
		next;
		mes "[Paltu]";
		mes "怎么样？只要材料和报酬齐全，我就能做到。";
		next;
		if (select("我以后再做。:让我看看你有什么！") == 1) {
			emotion ET_THINK;
			mes "[Paltu]";
			mes "什么？你在开玩笑吧？请告诉我是！";
			close;
		}
		break;
	}
	disable_items;
	emotion ET_BIGTHROB;
	mes "[Paltu]";
	mes "哦，哇。";
	mes "你做了正确的选择。我还以为拉菲内对漂亮帽子没兴趣，我要饿死了。";
	next;
	mes "[Paltu]";
	mes "我会给你很划算的价格。你应该知道我是在给你优惠。";
	next;
	mes "[Paltu]";
	mes "你有什么想要的吗？不妨看看。";
	next;
	setarray .@items[0], 5447, 2269, 2256, 5040, 5171, 5038, 5096, 2286, 5176, 5016;
	setarray .@costumes[0], 19548, 19552, 19549, 19550, 19546, 19547, 19553, 19551, 19554, 19545;
	if ((countitem(6081) >= 50) && (countitem(747) >= 4) && countitem(6395) && (countitem(721) >= 10) && (countitem(723) >= 10) && (countitem(726) >= 10) && (countitem(728) >= 10) && (countitem(729) >= 10))
		.@item_check =1;
	for(.@i = 0; .@i<getarraysize(.@items); .@i++) {
		if (.@item_check && countitem(.@items[.@i]))
			.@menu$ = .@menu$+getitemname(.@items[.@i])+" (^2502FDAble to Replicate^000000):";
		else
			.@menu$ = .@menu$+getitemname(.@items[.@i])+" (^777777Insufficient ingredients^000000):";
	}
	.@i = select(.@menu$)-1;
	mes "[Paltu]";
	mes "^0571B0"+getitemname(.@items[.@i])+"^000000 是你想要的吗？";
	next;
	if (.@item_check == 0 || countitem(.@items[.@i]) == 0) {
		emotion ET_CRY;
		mes "[Paltu]";
		mes "哎呀……赊账对我来说很难。";
		next;
		mes "[Paltu]";
		mes "^0571B0"+getitemname(.@items[.@i])+"^000000以及";
		mes "^E1281E50 枚斯普兰迪德硬币、4 面晶镜、1 份妖精魔粉、祖母绿、红宝石、蓝宝石、黄玉和锆石各 10 个^000000都是必需品。";
		next;
		mes "[Paltu]";
		mes "我自己也很困难。请考虑一下我的处境。";
		close;
	}
	emotion ET_QUESTION;
	mes "[Paltu]";
	mes "是的，这些完全够了。现在制作吗？";
	next;
	if (select("请现在制作。:糟糕，我还有事要处理……") == 2) {
		emotion ET_HUK;
		mes "[Paltu]";
		mes "嘿……嘿！嘿！你要去哪？";
		close;
	}
	emotion ET_HUK;
	mes "[Paltu]";
	mes "明白了。哦对！我差点又忘了。";
	next;
	mes "[Paltu]";
	mes "^FF0000复制过程中，魔力干涉现象会使帽子失去所有精炼、卡片和隐藏附魔。^000000";
	next;
	mes "[Paltu]";
	mes "^FF0000如果你拥有多顶同类型帽子，不想要的那顶可能会被用于复制，请务必确认。^000000";
	next;
	mes "[Paltu]";
	mes "这样有什么问题吗？";
	next;
	if (select("让我去确认一下。:开始复制过程。") == 1) {
		mes "[Paltu]";
		mes "好的，请务必确认！";
		close;
	}
	emotion ET_KIK;
	mes "[Paltu]";
	mes "呜呼——明白了。";
	mes "终于又到了施展技能的时候。";
	next;
	emotion ET_PROFUSELY_SWEAT;
	mes "[Paltu]";
	mes "这里做这个，那里做那个，然后再回这里做这个……";
	next;
	emotion ET_THINK;
	emotion ET_PROFUSELY_SWEAT;
	mes "[Paltu]";
	mes "... .. ...";
	specialeffect EF_BEGINSPELL;
	progressbar "0xFFFF00",1;
	specialeffect EF_BEGINSPELL2;
	progressbar "0xFFFF00",1;
	specialeffect EF_BEGINSPELL3;
	progressbar "0xFFFF00",1;
	specialeffect EF_BEGINSPELL4;
	progressbar "0xFFFF00",1;
	specialeffect EF_MVP;
	next;
	delitem 6081,50; //Splendide_Coin
	delitem 747,4; //Crystal_Mirror
	delitem 6395,1; //Angel_Magic_Power
	delitem 721,10; //Azure_Jewel
	delitem 723,10; //Cardinal_Jewel
	delitem 726,10; //Blue_Jewel
	delitem 728,10; //Golden_Jewel
	delitem 729,10; //Bluish_Green_Jewel
	delitem .@items[.@i],1;
	getitem .@costumes[.@i],1;
	mes "[Paltu]";
	mes "很好。这是令人满意的结果。";
	mes "下次我会做得更好。请把我的手艺告诉别人。祝你今天愉快~";
	close;
}

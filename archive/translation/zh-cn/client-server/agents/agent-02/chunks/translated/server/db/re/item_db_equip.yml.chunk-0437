         if (.@g>=ENCHANTGRADE_C) {
            bonus bPAtk,5;
            if (.@g>=ENCHANTGRADE_B) {
               bonus bPAtk,5;
               bonus bAtkRate,3;
               if (.@g>=ENCHANTGRADE_A) {
                  bonus bDelayrate,-5;
                  bonus bPAtk,7;
                  bonus bAtkRate,4;
               }
            }
         }
      }

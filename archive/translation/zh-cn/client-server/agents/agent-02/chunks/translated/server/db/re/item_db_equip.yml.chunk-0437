      bonus bPow,5;
      bonus bCon,5;
      bonus bAtkRate,(.@r/2);
      bonus bDef,15*(.@r/2);
      if (.@r>=7) {
         bonus bDelayrate,-5;
         if (.@r>=9) {
            bonus bLongAtkRate,10;

			mes "[Rebellion senior Dien]";
			mes "我才不在乎谁在看我。";
			next;
			mes "[Rebellion senior Dien]";
			mes "只靠复仇，你到目前为止做成了什么？";
			npctalk "迪恩：我们已经计划了多少年！", "Dien#162gmbs2", bc_self;

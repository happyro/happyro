			mes "[Rebellion senior Dien]";
			mes "你要永远恨他们，什么都不做，直到我死去吗？";
			next;
			mes "[Rebellion senior Dien]";
			mes "你觉得我还能活多少年！！！";
			next;
			mes "[Rebellion leader Rupert]";
			mes "看你现在的样子，我确信你还能活一百年！";
			npctalk "叛乱军首领：别这么说！", "", bc_self;
			next;
			mes "[Rebellion senior Dien]";
			mes "好极了！";

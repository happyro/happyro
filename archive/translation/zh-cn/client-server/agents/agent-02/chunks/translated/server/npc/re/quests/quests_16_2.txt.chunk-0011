			mes "[Rebellion senior Dien]";
			mes "你给我闭嘴！";
			next;
			mes "[Rebellion Guard leader Larcis]";
			mes "Ha...";
			emotion ET_CHAT_PROHIBIT, getnpcid(0, "Rebellion Guard leader#4");
			next;
			mes "[Rebellion leader Rupert]";
			mes "不管你说什么，我都反对！";
			next;
			mes "[Rebellion senior Dien]";
			mes "你这张大嘴还在喋喋不休！";
			mes "不是吗？";
			emotion ET_FRET, getnpcid(0, "Dien#162gmbs2");
			next;
			mes "[Rebellion leader Rupert]";
			mes "啊啊啊！！！";
			mes "喂，很痛啊！";
			next;
			mes "[Rebellion leader Rupert]";
			mes "你在做什么！大家都在看你！！！！";

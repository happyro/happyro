mjolnir_02,186,193,4	script	Middle-Aged Man#magum1	57,{
	if (dmdswrd_Q > 30) {
		if (dmdswrd_Q == 31) {
			mes "[Middle-Aged Man]";
			mes "已经有一阵子没人来这里了。";
			mes "这里路过的人不多，";
			mes "所以我很少接待访客。";
			mes "何不放松一下，聊一会儿？";
			next;
			mes "["+strcharinfo(0)+"]";
			mes "你在这片偏僻的区域";
			mes "做什么？你不是在这里";
			mes "工作吧？";
			next;
			mes "[Middle-Aged Man]";
			mes "管理这座避暑别墅";
			mes "就足够让我维持生计了。";
			mes "啊，我也把制作各种东西";
			mes "当作一种兴趣。";
			next;
			mes "[Middle-Aged Man]";
			mes "是啊，我年轻时在城里";
			mes "有自己的铁匠铺。";
			mes "那是很好的家族生意，";
			mes "我的兄弟姐妹最后都为城主";
			mes "甚至王室";
			mes "制作器物。";
			next;
			mes "[Middle-Aged Man]";
			mes "但后来发生了那场事故，";
			mes "我们不得不关门。";
			mes "这就是我的故事。虽然不算";
			mes "幸福，但除此之外，";
			mes "我也度过了漫长而美好的人生。";
			next;
			mes "[Middle-Aged Man]";
			mes "那么，究竟是什么";
			mes "带你来到这里？";
			mes "你只是探索这片土地，";
			mes "还是在猎杀魔物，或者……？";
			next;
			mes "["+strcharinfo(0)+"]";
			mes "其实，嗯，";
			mes "是这件东西把我引到这里。";
			mes "它叫作";
			mes "穆里涅尔之印。";
			next;
			mes "[Middle-Aged Man]";
			mes "哦……天啊。";
			mes "让我看看。";
			mes "哦，是的，这是真的。";
			mes "所以……它终于找到我了。";
			mes "那么，我愿意为你效劳。";
			next;
			next;
			mes "[Middle-Aged Man]";
			mes "我叫沃克，我和兄弟们";
			mes "是朱诺最有才华的三位铁匠。";
			mes "既然你被命运选中，";
			mes "我们会帮助你取得一把";
			mes "被诅咒的剑。";
			next;
			mes "[Walker]";
			mes "首先，被诅咒的剑";
			mes "被以五芒星封在魔法卷轴中。";
			mes "当它们真正的主人出现时，";
			mes "就能使用穆里涅尔之印";
			mes "将其解封。";
			next;
			mes "[Walker]";
			mes "至于我负责的解封部分，";
			mes "需要最高品质的材料。";
			mes "给我几分钟，";
			mes "我会告诉你需要带来什么。";
			set dmdswrd_Q,32;
			close;
			}
			else if (dmdswrd_Q == 32) {
			mes "[Walker]";
			mes "现在我得告诉你，";
			mes "我只能完成五芒星的一部分，";
			mes "它将解封其中一把被诅咒的剑。";
			mes "你还需要我兄弟们的帮助";
			mes "才能完成它。";
			next;
			mes "[Walker]";
			mes "五芒星完成并激活后，";
		mes "你将解封最适合你的";
		mes "那把被诅咒的剑。";
			mes "抱歉，我无法预测";
			mes "它究竟会是哪一把。";
			next;
			mes "[Walker]";
			mes "现在你必须迈出第一步，";
			mes "把以下物品带给我。";
			mes "记住我需要的东西……";
			next;
			mes "[Walker]";
			mes "我需要";
			mes "^FF00001 伊米尔之心碎片^000000、";
			mes "^FF00003 触手^000000、";
			mes "^FF000025 护身符^000000、";
			mes "^FF00001 煤炭^000000以及";
			mes "^FF00001 遗忘项链^000000。";
			set dmdswrd_Q,33;
			close;
			}
			else if (dmdswrd_Q == 33) {
			if (countitem(714) > 0 && countitem(962) > 2 && countitem(1003) > 0 && countitem(609) > 24 && countitem(1008) > 0) {
			mes "[Walker]";
			mes "啊，非常好。";
			mes "你把我需要的东西";
			mes "全都带来了。";
			mes "现在请稍等片刻，";
			mes "我来完成准备工作……";
			delitem 714,1; //Emperium
			delitem 962,3; //Tentacle
			delitem 1003,1; //Coal
			delitem 609,25; //Amulet
			delitem 1008,1; //Frozen_Heart
			set dmdswrd_Q,34;
		close;
		}
			mes "[Walker]";
				mes "嗯……？你还没有";
				mes "把我需要的东西";
				mes "全部带来，无法开始";
				mes "被诅咒之剑的五芒星。";
				mes "让我提醒你需要哪些材料。";
				next;
				mes "[Walker]";
				mes "我需要";
				mes "^FF00001 伊米尔之心碎片^000000、";
				mes "^FF00003 触手^000000、";
				mes "^FF000025 护身符^000000、";
				mes "^FF00001 煤炭^000000以及";
				mes "^FF00001 遗忘项链^000000。";
				close;
			}
			else if (dmdswrd_Q == 34) {
			mes "[Walker]";
			mes "啊，你回来了。";
			mes "你给的材料品质极佳，";
			mes "所以我比预想中";
			mes "更快完成了。";
			next;
			mes "[Walker]";
			mes "我 15 岁时，另外两位兄弟";
			mes "曾向矮人学习如何制作";
			mes "解封被诅咒之剑的五芒星。";
			mes "不过他们分别学到了不同部分。";
			next;
			mes "[Walker]";
			mes "我想矮人分散传授知识，";
			mes "是因为他们想让";
		mes "处刑者之剑在我们这一代";
		mes "尽可能晚些归来。";
			next;
			mes "[Walker]";
			mes "最初，处刑者之剑是三把剑之一。";
			mes "矮人受命为一个邪恶组织";
			mes "锻造它们，以换取";
			mes "村庄的安全。";
			next;
			mes "[Walker]";
			mes "尽管矮人拥有惊人的锻造技艺，";
			mes "他们仍难以在 15 天期限内";
			mes "取得锻造武器所需的";
			mes "稀有材料。";
			next;
			mes "[Walker]";
			mes "走投无路的矮人前去拜访我的父亲，";
			mes "他当时是著名铁匠兼冒险家。";
			mes "父亲同情他们的困境，";
			mes "把他们所需之物交给了他们。";
			next;
			mes "[Walker]";
			mes "为了感谢父亲的帮助，";
			mes "矮人教我的兄弟们制作";
			mes "被诅咒之剑的五芒星，";
			mes "但必须由我们三人";
			mes "共同合作才能完成。";
			next;
			mes "[Walker]";
			mes "遗憾的是，我听说那个强迫矮人";
			mes "锻造这些剑的邪恶组织，";
			mes "在矮人拒绝交出锻造秘诀后";
			mes "杀害了他们。";
			next;
			mes "[Walker]";
			mes "不过矮人没能透露，处刑者之剑";
			mes "被施加了可怕的诅咒。";
			mes "诅咒由矮人的憎恨驱动，";
			mes "会威胁处刑者之剑持有者的生命。";
			next;
			mes "[Walker]";
			mes "哦，不必太担心。";
			mes "如果你真的得到处刑者之剑，";
			mes "封印应该已经削弱诅咒，";
			mes "不会让它很快杀死你。";
			mes "那么……";
			next;
			mes "[Walker]";
			mes "你应该去找我的兄弟莫夫，";
			mes "请他完成被诅咒之剑五芒星的下一部分。";
			mes "莫夫很好找，";
			mes "他通常整天都在";
			mes "斐扬的酒馆里喝酒。";
			next;
			mes "[Walker]";
			mes "请带上这张刻有五芒星的卷轴，";
			mes "见到莫夫时替我向他问好。";
			mes "如果你成功取得被诅咒之剑，";
			mes "务必负责任地使用它的力量。";
			set dmdswrd_Q,35;
			close;
			}
			else if (dmdswrd_Q == 35) {
			mes "[Walker]";
			mes "去斐扬酒馆找我的哥哥莫夫——";
			mes "他总是在那里喝酒。";
			mes "希望他能帮你完成";
			mes "被诅咒之剑的五芒星。";
			close;
			}
			else if (dmdswrd_Q == 36) {
			mes "[Walker]";
			mes "啊，你已经见过莫夫了？";
			mes "下次见到他时请代我问好，";
			mes "告诉他我过得很好。";
			close;
			}
			else if (dmdswrd_Q == 37) {
			mes "[Walker]";
			mes "啊，你已经见过莫夫了？";
			mes "下次见到他时请代我问好，";
			mes "告诉他我过得很好。";
			close;
			}
			else if (dmdswrd_Q == 38) {
			mes "[Walker]";
			mes "莫夫最近怎么样？";
			mes "我知道他有些古怪，";
			mes "也许还有点无礼，";
			mes "但他其实是个非常好的人。";
			close;
			}
			else if (dmdswrd_Q == 39) {
		mes "[Walker]";
		mes "莫夫能帮助你真是太好了。";
			mes "至于我们的弟弟休伊，";
			mes "我有一阵子没听到他的消息了。";
			mes "我想他正在梦罗克一带旅行？";
			close;
			}
			else if (dmdswrd_Q >= 40 && dmdswrd_Q <= 44) {
			mes "[Walker]";
		mes "我相信休伊会照顾好自己。";
		mes "如果你再见到他，";
			mes "能请他抽空来看看我吗？";
			close;
			}
			else {
			mes "[Walker]";
			mes "哦！你完成了五芒星，";
			mes "并得到了一把被诅咒之剑？";
			mes "听到这个消息我很高兴。";
		mes "如果父亲还活着，";
		mes "一定会为你感到骄傲。";
			close;
			}
			}
			else {
			mes "[Middle-Aged Man]";
			mes "已经有一阵子没人来这里了。";
			mes "路过的人不多，所以我很少接待访客。";
			mes "尽管休息放松一会儿吧～";
		close;
		}
			}
						payon,248,159,1	script	Old Man#magum1	120,{
			if (dmdswrd_Q == 35) {
			mes "[Old Man]";
			mes "什——？你是谁？";
		mes "想干什么？";
		mes "别打扰我，让我安静喝酒！^333333*嗝*^000000";
			next;
			mes "["+strcharinfo(0)+"]";
			mes "呃，打扰一下，你是莫夫吗？";
			mes "你的兄弟沃克派我来，";
			mes "想请你帮忙完成这个五芒星。";
			next;
			mes "[Old Man]";
			mes "嗯……？让我看看……";
		mes "哦，这确实是沃克的作品。";
		mes "你、你真的想要被诅咒之剑？";
			mes "而且你手里真的是";
			mes "穆里涅尔之印？";
			next;
			mes "["+strcharinfo(0)+"]";
			mes "哦，这个印记！";
			mes "给，你想看的话就拿去看。";
			mes "如果这不是真的，";
			mes "那我可是费了很大劲";
		mes "才弄到这个赝品。";
		next;
			mes "[Old Man]";
			mes "啊！这是真的！";
			mes "这是不是意味着我现在真的得干活了？！";
			mes "我还醉着呢！";
			mes "该死……看来只能醒醒酒了。";
			next;
			mes "[Old Man]";
			mes "呃……不过我肯定会宿醉头痛。";
		mes "喂！带 20 瓶黄色药水给我，";
	mes "让我治治头痛！";
	mes "我真的非常需要它们……";
		set dmdswrd_Q,36;
		close;
		}
		else if (dmdswrd_Q == 36) {
		if (countitem(503) > 19) {
		mes "[Old Man]";
		mes "哦，谢天谢地，你把药水带来了！";
		mes "这些能帮我适应你们所谓的清醒。";
	mes "呃……我能清楚思考了……该死！";
next;

mes "["+strcharinfo(0)+"]";
mes "......";
	mes ".........";
		mes "............";
		next;
		mes "[Old Man]";
		mes "把刻有五芒星的卷轴给我。";
		mes "让我看看。嘿，沃克做得真不错。";
		mes "好了，听着。";
		mes "我需要你带来这些东西……";
		next;
		mes "[Old Man]";
		mes "^FF00001 煤炭^000000、";
		mes "^FF00003 树干^000000、";
		mes "^FF00003 老旧剑柄^000000、";
		mes "^FF000050 食人魔牙齿^000000以及";
		mes "^FF00001 盲人的愚行^000000。";
		next;
		mes "[Old Man]";
		mes "你必须把这些东西带给我，";
		mes "这样我才能继续完成";
		mes "被诅咒之剑的五芒星。";
		mes "我会在这里等你。";
		delitem 503,20; //Yellow_Potion
		set dmdswrd_Q,37;
		close;
		}
		mes "[Old Man]";
		mes "啊！你带来 20 瓶黄色药水了吗？";
		mes "我的宿醉越来越严重了！";
		mes "快、快把药给我！";
		close;
		}
		else if (dmdswrd_Q == 37) {
		if (countitem(7022) > 2 && countitem(1003) > 0 && countitem(1019) > 2 && countitem(7021) > 0 && countitem(7002) > 49) {
		mes "[Morf]";
		mes "嘿，你把东西全带来了？很好，";
		mes "我越快完成，就能越快回去喝酒。";
		mes "你现在只要坐下等着就行。";
		next;
		mes "[Morf]";
		mes "好了，开始吧……";
		mes "等等，我把需要的东西放哪了？嗯……";
		mes "啊，在这里。嗯……";
		next;
		mes "^3355FF*Scheeeezzzz*";
		mes "*Clang Clang*";
		mes "*Rattle Rattle*";
		mes "*Th-thump thump*^000000";
	next;
	mes "^3355FF*Crrrrrrunch*";
		mes "*Sh-sh-sh-shoom*";
			mes "*Rub-rub-rub-rub*";
			mes "*Flip ka-chink*^000000";
			next;
			mes ".........";

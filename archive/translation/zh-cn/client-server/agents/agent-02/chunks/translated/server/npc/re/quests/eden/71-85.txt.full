//===== rAthena Script =======================================
//= Eden Group Quests - Mission [71 - 85]
//===== By: ==================================================
//= L0ne_W0lf
//===== Current Version: =====================================
//= 1.5
//===== Compatible With: =====================================
//= rAthena Project
//===== Description: =========================================
//= Repetable Quests for Players between Baselevel 71 - 85.
//===== Additional Comments: =================================
//= 1.0 First Version.
//= 1.1 Some little optimization here and there. [Masao]
//= 1.2 Optimized. [Euphy]
//= 1.3 Updated to match the official scripts. [Euphy]
//= 1.4 Added support to Para_Team_Mark_ in Eden Group. [Ragno]
//= 1.5 Added use of F_HasEdenGroupMark function. [Ragno]
//============================================================

moc_para01,44,38,3	script	Mission [71 - 85]	857,{
	if (!callfunc("F_HasEdenGroupMark")) {
		mes "- 只有伊甸园集团成员 -";
		mes "- 才能阅读这块公告板。 -";
		mes "";
		close;
	}

	// Clear the original quest data (no longer used).
	if (slv_quest) set slv_quest,0;
	if (checkquest(10102) > -1 || checkquest(10103) > -1 || checkquest(10104) > -1 || checkquest(10105) > -1 || checkquest(10106) > -1) {
		for(set .@quest,10102; .@quest<=10106; set .@quest,.@quest+1) {
			if (checkquest(.@quest) > -1)
				erasequest .@quest;
		}
		mes "- 由于委托人已搬到 -";
		mes "- 其他地方，-";
		mes "- 申请表已被移除。 -";
		next;
	}

	if (BaseLevel < 71) {
		mes "- 只有等级合适的成员 -";
		mes "- 才能阅读这块公告板。 -";
		mes "- 请寻找 -";
		mes "- 适合你等级的公告板。 -";
		mes "";
		close;
	} else if (BaseLevel > 85) {
		// Quest IDs: 10107-10123, 5055-5057
		setarray .@quests[0],
			10107,10108,10109,
			10110,10111,10112,10113,
			10114,10115,10116,10117,
			10118,10119,10120,
			10121,10122,10123,5055,5056;
		for(set .@i,0; .@i<getarraysize(.@quests); set .@i,.@i+1) {
			if (checkquest(.@quests[.@i],HUNTING) == 2)
				set .@complete[getarraysize(.@complete)], .@quests[.@i];
		}
		if (checkquest(5057) > -1 && countitem(7187) >= 30)
			set .@complete[getarraysize(.@complete)],5057;
		if (getarraysize(.@complete)) {
		mes "你有正在进行的任务。";
		mes "要提交这些任务吗？";
			next;
			if(select("当然。:不。") == 2)
				close;
			for(set .@i,0; .@i<getarraysize(.@complete); set .@i,.@i+1)
				callsub L_Quest,.@complete[.@i];
			close;
		}
		mes "- 只有等级合适的成员-";
		mes "- 才能阅读这块-";
		mes "- 公告板。-";
		mes "- 请找一块-";
		mes "- 适合你等级的公告板。-";
		close;
	}
		mes "- 请选择 -";
		mes "- 想去哪里狩猎。 -";
	next;
	switch(select("斯芬克斯地下城:古城:朱诺地区:钟楼:异域岛屿")) {
	case 1:
		mes "- 这块任务公告板上有 -";
		mes "- 几项与斯芬克斯地下城 -";
		mes "- 相关的委托。 -";
		next;
		set .@str1$,"梦罗克村民担心斯芬克斯地下城的怪物越来越多。 ";
		set .@str2$,"- 来自梦罗克的 Meidi -";
		switch(select("猎杀安魂怪:猎杀玛尔杜克:猎杀帕莎纳")) {
			case 1: callsub L_Quest,10107,.@str1$+"Hunt 10 Requiems.",.@str2$;
			case 2: callsub L_Quest,10108,.@str1$+"Hunt 10 Marduks.",.@str2$;
			case 3: callsub L_Quest,10109,.@str1$+"Hunt 10 Pasanas.",.@str2$;
		}
	case 2:
		mes "- 这块任务公告板上有 -";
		mes "- 几项与古城 -";
		mes "- 相关的委托。 -";
		next;
		set .@str1$,"我很害怕古城的怪物会攻击我们。 ";
		set .@str2$,"- 来自吉芬的 Ancellia -";
		switch(select("猎杀暗黑魔法师:猎杀邪恶德鲁伊:猎杀幽灵:猎杀瑞德利克弓箭手")) {
			case 1: callsub L_Quest,10110,.@str1$+"Hunt 10 Dark Frames.",.@str2$;
			case 2: callsub L_Quest,10111,.@str1$+"Hunt 10 Evil Druids.",.@str2$;
			case 3: callsub L_Quest,10112,.@str1$+"Hunt 10 Wraiths.",.@str2$;
			case 4: callsub L_Quest,10113,.@str1$+"Hunt 10 Raydric Archers.",.@str2$;
		}
	case 3:
		mes "- 这块任务公告板上有 -";
		mes "- 几项与朱诺周边地区 -";
		mes "- 相关的委托。 -";
		next;
		set .@str1$,"像我这样不会战斗的人，因为怪物太多而很难旅行。 ";
		set .@str2$,"- 旅行者 Jeanbai -";
		switch(select("猎杀大嘴鸟:猎杀沉睡者:猎杀山羊:猎杀哈比")) {
			case 1: callsub L_Quest,10114,.@str1$+"Hunt 20 Grand Pecos.",.@str2$;
			case 2: callsub L_Quest,10115,.@str1$+"Hunt 20 Sleepers.",.@str2$;
			case 3: callsub L_Quest,10116,.@str1$+"Hunt 20 Goats.",.@str2$;
			case 4: callsub L_Quest,10117,.@str1$+"Hunt 20 Harpies.",.@str2$;
		}
	case 4:
		mes "- 这块任务公告板上有 -";
		mes "- 几项与钟楼 -";
		mes "- 相关的委托。 -";
		next;
		set .@str1$,"我曾经喜欢聆听艾尔迪巴兰钟楼的悦耳旋律，但怪物制造的噪音让我什么也听不见。 ";
		set .@str2$,"- 爱钟社区会长 Rizingsetter -";
		switch(select("猎杀钟怪:猎杀朋克:猎杀骑士")) {
			case 1: callsub L_Quest,10118,.@str1$+"Hunt 15 Clocks before it breaks.",.@str2$;
			case 2: callsub L_Quest,10119,.@str1$+"Hunt 15 Punks before it breaks.",.@str2$;
			case 3: callsub L_Quest,10120,.@str1$+"Hunt 15 Ridewords before it breaks.",.@str2$;
		}
	case 5:
		mes "- 这块任务公告板上有 -";
		mes "- 几项与异域岛屿 -";
		mes "- 相关的委托。 -";
		next;
		set .@str1$,"我想去冒险，但有太多事情要处理。如果我做不到，其他人也做不到！ ";
		set .@str2$,"- 想去冒险的 Funfy -";
		switch(select("猎杀奇奇莫拉:猎杀宫廷人偶:猎杀弥高:猎杀无头骡:猎杀塔姆鲁安:收集节庆面具")) {
			case 1: callsub L_Quest,10121,.@str1$+"Hunt 15 Kikimoras in Moscovia!",.@str2$;
			case 2: callsub L_Quest,10122,.@str1$+"Hunt 15 Miyabi Dolls in Amatsu!",.@str2$;
			case 3: callsub L_Quest,10123,.@str1$+"Hunt 15 Mi Gaos in Luoyang!",.@str2$;
			case 4: callsub L_Quest,5055,"我知道城外有很多可怕的怪物，但真正让我害怕的是四处游荡的无头骡。希望它们永远别进城。猎杀 15 只无头骡！","- 来自巴西利斯的 Mariana -";
			case 5: callsub L_Quest,5056,"塔姆鲁安制造很多噪音。早上我不介意，但晚上让我无法入睡。我想睡觉。猎杀 15 只塔姆鲁安！","- 来自阿育他雅的萨满 Pumo -";
			case 6: callsub L_Quest,5057,"团子童子偷走了我为节庆准备的所有面具。试着找回 30 个面具！我会欠你人情~","- 昆仑 SaYumMoon 首领 -";
		}
	}
	end;

//callsub L_Quest,<quest ID>{,"<description1>","<description2>"};
L_Quest:
	set .@quest, getarg(0);
	switch(.@quest) {
		case 10107: set .@name$,"猎杀安魂怪"; set .@exp,15000; break;
		case 10108: set .@name$,"猎杀玛尔杜克"; set .@exp,15000; break;
		case 10109: set .@name$,"猎杀帕莎纳"; set .@exp,15000; break;
		case 10110: set .@name$,"猎杀暗黑魔法师"; set .@exp,20000; break;
		case 10111: set .@name$,"猎杀邪恶德鲁伊"; set .@exp,20000; break;
		case 10112: set .@name$,"猎杀幽灵"; set .@exp,20000; break;
		case 10113: set .@name$,"猎杀瑞德利克弓箭手"; set .@exp,20000; break;
		case 10114: set .@name$,"猎杀大嘴鸟"; set .@exp,30000; break;
		case 10115: set .@name$,"猎杀沉睡者"; set .@exp,30000; break;
		case 10116: set .@name$,"猎杀山羊"; set .@exp,30000; break;
		case 10117: set .@name$,"猎杀哈比"; set .@exp,30000; break;
		case 10118: set .@name$,"猎杀钟怪"; set .@exp,25000; break;
		case 10119: set .@name$,"猎杀朋克"; set .@exp,25000; break;
		case 10120: set .@name$,"猎杀骑士"; set .@exp,25000; break;
		case 10121: set .@name$,"猎杀奇奇莫拉"; set .@exp,30000; break;
		case 10122: set .@name$,"猎杀宫廷人偶"; set .@exp,30000; break;
		case 10123: set .@name$,"猎杀弥高"; set .@exp,30000; break;
		case 5055: set .@name$,"猎杀无头骡"; set .@exp,30000; break;
		case 5056: set .@name$,"猎杀塔姆鲁安"; set .@exp,30000; break;
		case 5057: set .@name$,"收集节庆面具"; set .@exp,30000; break;
	}
	if (getargcount() == 1) {
		mes "‘"+.@name$+"’已完成。要提交并领取奖励吗？";
		next;
		if(select("提交任务。:取消。") == 1) {
			if (.@quest == 5057) delitem 7187,30; //Festival_Mask
			erasequest .@quest;
			getexp .@exp,0;
			mes "你已获得完成任务的经验值。";
			next;
			return;
		}
		close;
	} else {
		if (.@quest == 5057) {
			// Quest 5057 is the only collection quest, so separate conditions are unnecessary.
			if (checkquest(5057) == -1)
				set .@hunting,-1;
			else if (countitem(7187) >= 30)
				set .@hunting,2;
		} else
			set .@hunting, checkquest(.@quest,HUNTING);
		if (.@hunting == 0 || .@hunting == 1) {
			mes getarg(1);
			mes getarg(2);
			next;
			mes "完成任务后回到这里。";
		} else if (.@hunting == 2) {
			mes "你已完成任务。";
			next;
			if(select("提交任务。:取消。") == 1) {
				if (.@quest == 5057) delitem 7187,30; //Festival_Mask
				erasequest .@quest;
				getexp .@exp,0;
				mes "你已获得完成任务的经验值。";
			}
		}/* else if (.@hunting == 3) {
//			recall_completequest .@quest
			erasequest .@quest;
			mes "你重新接受了任务‘"+.@name$+"’。";
		}*/ else {
			mes getarg(1);
			mes getarg(2);
			next;
			mes "要接受这个任务吗？";
			next;
			if(select("是。:否。") == 1) {
				mes "你已接受任务‘"+.@name$+"’。详情请查看任务信息。";
				setquest .@quest;
			}
		}
		close;
	}
}

	mes "每到那边的";
	mes "满月？";
	next;
	mes "[???????]";
	mes "嗯……";
	mes "谁知道呢？";
	next;
	mes "[????]";
	mes "老、老板……！";
	next;
	mes "......";
	mes ".........";
	mes "............";
	mapannounce "que_job03","...Moooore... Give me... more blood...",1,0xDDA0DD;
	next;
	mes "["+ strcharinfo(0) +"]";
	mes "这些声音……";
	mes "就像这里曾发生过的";
	mes "某件事的过去记忆，";
	mes "发生在梦罗克城堡……";
	mes "发生在这座梦罗克城堡里……";
	close2;
	soundeffect "wander_man_move.wav",0;
	sc_end SC_All;
	disablenpc "#maogate2_talk4";
	end;
}


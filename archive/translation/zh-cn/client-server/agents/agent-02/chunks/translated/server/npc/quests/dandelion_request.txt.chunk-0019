que_job03,66,85,5	script	Dandelion Member#2_bt	880,{

	if(mao_request == 124 || mao_request == 125)
	{
		mes "[Dandelion Member]";
		mes "喂，你没事吧？";
		mes "刚才的爆炸";
		mes "可真够大的！";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "R先生……？";
		mes "哦，你不是他。";
		mes "谢谢，我想你";
		mes "刚才救了我一命。对了……";
		mes "你见过女性";
		mes "刺客在这附近吗？";
		next;
		mes "[Dandelion Member]";
		mes "不，我想没有，";
		mes "不过附近还有另一名";
		mes "刺客，基德。";
		mes "等等，你就是";
		mes "被雷扬·摩尔骗的那个人？";
		mes "他是你的委托人，对吧？";
		next;
		mes "[Dandelion Member]";
		mes "我是蒲公英组织的成员，";
		mes "我们一直在寻找他。";
		mes "事实证明我们对摩尔的判断";
		mes "是正确的：他真的计划复活";
		mes "魔王梦罗克。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "啊？你在说什么？";
		mes "等等，雷扬·摩尔？";
		mes "你是说 R. 摩尔先生？";
		mes "不！那就是说……";
		next;
		mes "[Dandelion Member]";
		mes "没错。";
		mes "他成功骗过了我们所有人。";
		mes "失陪了，既然你醒了，";
		mes "我最好去帮帮";
		mes "基德。";
		next;
		mes "[Lin's Voice]";
		mes "……别、别……";
		mes "……这太……";
		mes "这一切太疯狂了！";
		emotion ET_SURPRISE;
		next;
		mes "["+ strcharinfo(0) +"]";
		mes "那是……那是林的声音！";
		mes "我最好穿过这片黑暗，";
		mes "努力找到她的所在，";
		mes "然后尽快找到她！";
		mes "尽快找到她！";
		close2;
		set mao_request,125;
		disablenpc "Dandelion Member#2_bt";
		end;
	}

OnInit:
	disablenpc "Dandelion Member#2_bt";
	end;
	
OnEnter:
	enablenpc "Dandelion Member#2_bt";
	end;
}


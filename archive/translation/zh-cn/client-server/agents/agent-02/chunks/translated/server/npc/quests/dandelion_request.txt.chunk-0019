que_job03,117,101,1	script	#maogate2_end	139,3,3,{

OnInit:
	disablenpc "#maogate2_end";
	end;
	
OnReset:
	killmonster "que_job03","#maogate2_end::OnMyMobDead";
	end;
	
OnStop:
	killmonster "que_job03","#maogate2_end::OnMyMobDead";
	stopnpctimer;
	end;
	
OnEnter:
	enablenpc "#maogate2_end";
	end;
	
OnTouch:
	donpcevent "#maogate2_setting::OnStop";
	mes "[" + strcharinfo(0) + "]";
	mes "喂，这里发生什么了？";
	mes "基德！林！";
	mes "那、那个人是谁？";
	mes "难道会是……";
	mes "难道真的是他……";
	emotion ET_SURPRISE, playerattached();
	next;
	cutin "mocseal_kid01.bmp",0;
	mes "[Kidd]";
	mes ""+ strcharinfo(0) +"...";
	mes "退后，别靠近我！";
	mes "林，你为什么";
	mes "要这么做！放弃你的任务吧，";
	mes "你根本不知道";
	mes "你的委托人究竟是谁！";
	mes "你根本不知道委托人的真面目！";
	next;
	cutin "mocseal_rin01.bmp",2;
	mes "[Lin]";
	mes "你在说什么，基德？";
	mes "我刚知道你效力的蒲公英组织";
	mes "一直在追捕摩尔先生……";
	mes "一直在追捕";
	mes "摩尔先生……";
	emotion ET_KEK, getnpcid(0, "Lin#maogate2_1");
	next;
	cutin "mocseal_kid01.bmp",0;
	mes "[Kidd]";
	mes "没错，他们当然在追捕他。";
	mes "你的委托人，R. 摩尔先生，";
	mes "不是别人，";
	mes "正是雷扬·摩尔——而且他";
	mes "计划复活魔王梦罗克！";
	next;
	cutin "mocseal_rin01.bmp",2;
	mes "[Lin]";
	mes "什么？！怎么会？我和摩尔";
	mes "一起行动了好几天！如果是他";
	mes "绑架了那些孩子，";
	mes "那究竟是谁把他们扣为人质？";
	next;
	mes "[Lin]";
	mes "不，你应该把你知道的";
	mes "关于自己委托人——";
	mes "蒲公英组织的一切";
	mes "都告诉我……";
	emotion ET_SCRATCH, getnpcid(0, "R#maogate2");
	next;
	cutin "mocseal_rin01.bmp",255;
	cutin "mocseal_kid01.bmp",255;
	mes "[R. Moore]";
	mes "谢谢你的关心，林。";
	mes "不过真的……";
	mes "没必要。呵呵呵……";
	mes "我已经不必再担心蒲公英组织了。";
	mes "他们再也无法阻止我了。";
	next;
	mes "[R. Moore]";
	mes "做好准备，";
	mes "接受这场祭祀吧……林……";
	mes "你的血将被用来";
	mes "复活魔王梦罗克！";
	donpcevent "R#maogate2::OnSpell";
	emotion ET_SURPRISE, getnpcid(0, "Kidd#maogate2_1");
	emotion ET_SURPRISE, playerattached();
	next;
	mes "[Kidd]";
	mes "小心！";
	donpcevent "Kidd#maogate2_1::OnInit";
	donpcevent "Lin#maogate2_1::OnInit";
	donpcevent "Kidd#maogate2_2::OnEnter";
	donpcevent "Lin#maogate2_2::OnEnter";
	donpcevent "#maogate2_end2::OnSpell";
	next;
	mes "[" + strcharinfo(0) + "]";
	mes "基德！林！";
	next;
	mes "[Lin]";
	mes "为、为什么……？";
	mes "摩尔先生，你说过";
	mes "你要阻止";
	mes "魔王梦罗克复活的……";
	mes "你说过要阻止这一切……";
	next;
	mes "[Kidd]";
	mes "你还看不出来吗……？";
	mes "他在撒谎！他";
	mes "把我们所有人都骗了！";
	next;
	mes "[R. Moore]";
	mes "这样啊……";
	mes "你要反抗？";
	mes "好吧，你让我别无选择。";
	mes "感受魔王梦罗克的力量吧！";
	emotion ET_KIK, getnpcid(0, "R#maogate2");
	next;
	donpcevent "R#maogate2::OnInit";

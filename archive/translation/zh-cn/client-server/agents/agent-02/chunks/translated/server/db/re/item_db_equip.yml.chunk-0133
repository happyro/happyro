    AegisName: Krieger_Onehand_Sword1
    Name: "荣耀焰形剑"
    Type: Weapon
    SubType: 1hSword
    Buy: 20
    Attack: 130
    Range: 1
    Jobs:
      Alchemist: true
      Assassin: true
      Blacksmith: true
      Crusader: true
      Knight: true
      Merchant: true
      Novice: true
      Rogue: true
      SuperNovice: true

// Instance Creation :: buwaya_dun
//============================================================
ma_fild02,312,317,5	script	Guard#buwaya_cave	570,{
	if (BaseLevel < 130) {
		mes "[Guard]";
		mes "低于 ^ff0000 130 级^000000 的人";
		mes "不能进入这里。";
		mes "这里很危险，请回去吧。";
		close;
	}

	set .@party_id,getcharid(1);
	set .@md_name$,"Buwaya Cave";

	if (!.@party_id) {
		mes "[Guard]";
		mes "Buwaya 很危险。";
		mes "请和其他人组成队伍后";
		mes "再回来吧。";
		close;
	}
	if (is_party_leader() == true) {
		mes "[Guard]";
		mes "这里很危险，请回去吧。";
		mes "如果你没什么事要办，请回去。";
		next;
		while(1) {
				switch(select("为什么这么危险？:我来这里猎杀 Buwaya。:结束对话。")) {
			case 1:
				mes "[Guard]";
				mes "最近发生了村民失踪的事件。";
				mes "调查踪迹后，";
				mes "我们发现罪魁祸首是";
				mes "巨大的怪物 Buwaya。";
				next;
				mes "[Guard]";
				mes "我们派出了士兵和佣兵";
				mes "去猎杀 Buwaya，但始终";
				mes "没有完全成功。";
				next;
				mes "[Guard]";
				mes "直到今天，Buwaya 仍在绑架";
				mes "村民。";
				mes "请召集一些人消灭 Buwaya。";
				next;
				break;
			case 2:
				set .@playtime, checkquest(4229,PLAYTIME);
				if (.@playtime == -1) {
					// fall through
				} else if (.@playtime == 0 || .@playtime == 1) {
					mes "[Guard]";
					mes "Buwaya 还在躲藏。";
					mes "即使现在进去，Buwaya 也不会出来。";
					mes "请稍后再回来。";
					close;
				} else {
					erasequest 4229;
					// fall through
				}
				if (instance_create(.@md_name$) < 0) {
					mes "[Guard]";
					mes "队伍名称是……"+getpartyname(.@party_id)+"。";
					mes "队长是……"+strcharinfo(0);
					mes "^0000ff"+.@md_name$+"^000000 目前无法开启。";
					mes "请稍后再试。";
					close;
				}
				mes "[Guard]";
				mes "我会打开通往 ^0000ff"+.@md_name$+"^000000 的通道。";
				mes "祝你好运。";
				close;
			case 3:
				mes "[Guard]";
			mes "这里很危险，你不能进入。";
				close;
			}
		}
	} else {
		mes "[Guard]";
		mes "让我和队长谈谈。";
		mes "请让队长过来。";
		close;
	}
}

ma_fild02,315,323,0	script	Cave Entrance#buwaya	45,2,2,{
	end;
OnTouch:
	if (BaseLevel < 130) {
		mes "[Guard]";
		mes "低于 ^ff0000 130 级^000000 的人";
		mes "不能进入这里。";
		mes "这里很危险，请回去吧。";
		close;
	}
	set .@playtime, checkquest(4229,PLAYTIME);
	if (.@playtime == -1) {
		// fall through
	} else if (.@playtime == 0 || .@playtime == 1) {
		mes "[Guard]";
		mes "Buwaya 还在躲藏。";
		mes "即使现在进去，Buwaya 也不会出来。";
		mes "请稍后再回来。";
		close;
	} else {
		erasequest 4229;
		// fall through
	}
	switch(select("进入。:回头。")) {
	case 1:
		switch(instance_enter("Buwaya Cave")) {
		case IE_OTHER:
			mes "[Guard]";
			mes "哦，现在不是好时机。";
			mes "请稍后再试。";
			close;
		case IE_NOINSTANCE:
		case IE_NOMEMBER:
			mes "[Guard]";
			mes "这里很危险，请不要进入。";
			close;
		case IE_OK:
		mapannounce "ma_fild02",getpartyname(getcharid(1))+" 队伍的成员 "+strcharinfo(0)+" 开始在 Buwaya 洞穴猎杀 Buwaya。",bc_map,"0x00ff99"; //FW_NORMAL 12 0 0
			setquest 4229;
			//warp "1@ma_c",35,57;
			end;
		default:
		mes "- 因未知力量无法进入。-";
			close;
		}
	case 2:
		mes "[Guard]";
	mes "你必须珍惜自己的生命。";
	mes "行动前最好仔细考虑。";
		close;
	}
}

// Instance Scripts :: buwaya_in
//============================================================
1@ma_c,33,112,0	script	#damage	139,7,7,{
	end;
OnInstanceInit:
	initnpctimer;
	disablenpc instance_npcname("#damage");
	end;
OnTimer1000:
	enablenpc instance_npcname("#damage");
	specialeffect EF_POISONHIT;
	end;
OnTimer2000:
	stopnpctimer;
	initnpctimer;
	disablenpc instance_npcname("#damage");
	end;
OnTouch:
	percentheal -10,-10;
	sc_start SC_BLEEDING,60000,0;
	sc_start SC_POISON,60000,0;
	end;
}

1@ma_c,29,110,5	script	Kidnapped People#1	575,{
	mes "[Kidnapped Residents]";
	mes "Buwaya 到处乱跑，";
	mes "又有人被抓住了。";
	mes "我们会被困在这里度过余生。";
	next;
	switch(select("带我离开这里！！:难……难道逃不出去？")) {
	case 1:
		mes "[Kidnapped Residents]";
		mes "我们没有足够的力量消灭它，但 Buwaya 有弱点。";
		mes "看看那边的墙。";
		mes "如果敲击那里，Buwaya 会感到疼痛并把你吐出来。";
		donpcevent instance_npcname("#box_mob_call")+"::OnEnable";
		close2;
		disablenpc instance_npcname("Kidnapped People#1");
		end;
	case 2:
		mes "[Kidnapped People]";
		mes "这里有些不对劲……";
		mes "你以前经历过这种事吗？";
		close;
	}
	end;
OnInstanceInit:
	disablenpc instance_npcname("Kidnapped People#1");
	end;
OnEnable:
	enablenpc instance_npcname("Kidnapped People#1");
	donpcevent instance_npcname("#box_mob_call")+"::OnDisable";
	end;
}

1@ma_c,36,110,5	script	Kidnapped People#2	574,{
	mes "[Kidnapped Residents]";
	mes "啊哈！真希望我再强一点……";
	mes "我知道它的弱点……";
	next;
	switch(select("告诉我。:你真的知道吗？")) {
	case 1:
		mes "[Kidnapped Residents]";
		mes "你确定能做到吗……？";
		mes "好，仔细听，";
		mes "它的弱点是……";
		next;
		mes "[Kidnapped Residents]";
		mes "……就在我们身后的墙上。";
		sc_start SC_ATKPOTION,60000,45;
		sc_start SC_MATKPOTION,60000,45;
		disablenpc instance_npcname("Kidnapped People#2");
		close;
	case 2:
		mes "[Kidnapped Residents]";
		mes "什么？！";
		mes "你是在无视我吗，";
		mes "就因为我被困在这里？";
		close;
	}
	end;
OnInstanceInit:
	disablenpc instance_npcname("Kidnapped People#2");
	end;
OnEnable:
	enablenpc instance_npcname("Kidnapped People#2");
	end;
}

1@ma_c,3,3,0	script	#box_mob_call	139,1,1,{
	end;
OnInstanceInit:
	setcell instance_mapname("1@ma_c"),30,118,35,118,cell_shootable,1; //custom
	disablenpc instance_npcname("#box_mob_call");
	end;
OnEnable:
	enablenpc instance_npcname("#box_mob_call");
	set .@label$, instance_npcname("#box_mob_call")+"::OnMyMobDead";
	set .@map$, instance_mapname("1@ma_c");
	monster .@map$,30,118,"Buwaya's Weakness",2333,1,.@label$;
	monster .@map$,35,118,"Buwaya's Weakness",2333,1,.@label$;
	end;
OnDisable:
	killmonster instance_mapname("1@ma_c"),instance_npcname("#box_mob_call")+"::OnMyMobDead";
	disablenpc instance_npcname("#box_mob_call");
	end;
OnMyMobDead:
	if (mobcount(instance_mapname("1@ma_c"),instance_npcname("#box_mob_call")+"::OnMyMobDead") < 1)
		donpcevent instance_npcname("#box_out")+"::OnEnable";
	end;
}

1@ma_c,33,118,0	script	#box_out	45,2,2,{
OnInstanceInit:
OnDisable:
	disablenpc instance_npcname("#box_out");
	end;
OnEnable:
	enablenpc instance_npcname("#box_out");
	end;
OnTouch:
	set .@x, rand(1,20) + 97;
	set .@y, rand(1,20) + 74;
	warp instance_mapname("1@ma_c"),.@x,.@y;
	end;
}

1@ma_c,97,74,0	script	#box_call	139,50,50,{
	end;
OnInstanceInit:
	disablenpc instance_npcname("#box_call");
	initnpctimer;
	end;
OnTimer30000:
	mapannounce instance_mapname("1@ma_c"),"Buwaya：我要把你放进我的宝箱！",bc_map,"0x00ff99"; //FW_NORMAL 12 0 0
	// Should execute OnTimer33000, but client doesn't render the effect fast enough.
	for(set .@i,1; .@i<=9; set .@i,.@i+1)
		donpcevent instance_npcname("#yunobi"+.@i)+"::OnEnable";
	end;
OnTimer33000:
	donpcevent instance_npcname("#box_out")+"::OnDisable";
	donpcevent instance_npcname("#box_mob_call")+"::OnDisable";
	donpcevent instance_npcname("Kidnapped People#1")+"::OnEnable";
	donpcevent instance_npcname("Kidnapped People#2")+"::OnEnable";
	end;
OnTimer34000:
	enablenpc instance_npcname("#box_call");
	end;
OnTimer35000:
	stopnpctimer;
	initnpctimer;
	disablenpc instance_npcname("#box_call");
	end;
OnTouch_:
	specialeffect2 EF_GUIDEDATTACK;
	warp instance_mapname("1@ma_c"),33,112;
	end;
OnDisable:
	stopnpctimer;
	disablenpc instance_npcname("#box_call");
	end;
}


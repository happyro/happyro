      .@r = getrefine();
      bonus bBaseAtk,.@r;
      bonus bMatk,.@r;
      if (.@r>=9) {
         bonus2 bAddSize,Size_All,10;
      }
      else if (.@r>=7) {
         bonus2 bAddSize,Size_All,6;
      }
      else {
         bonus2 bAddSize,Size_All,3;
      }

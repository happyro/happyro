kh_dun01,44,203,0	script	Entrance Device#khd2::KHAccess	111,{
	if (countitem(7509) < 1) {
		mes "^3355FF你遇到一个";
		mes "机械装置。";
		mes "看起来可以将正确的";
		mes "钥匙卡插入";
		mes "插槽操作。^000000";
		close;
	}
	else {
		mes "^3355FF你遇到一个";
		mes "机械装置。";
		mes "看起来可以将正确的";
		mes "钥匙卡插入";
		mes "插槽操作。^000000";
		next;
		input .@KHInput$;
		if (.@KHInput$ == "Luxurious Keycard") {
			mes "^3355FF当你插入";
			mes "豪华钥匙卡";
			mes "进入钥匙卡插槽，";
			mes "门打开了，露出";
			mes "一段向下延伸的";
			mes "长长楼梯。^000000";
			next;
			switch(select("下楼梯:取消")) {
			case 1:
				warp "kh_dun02",41,198;
				end;
			case 2:
				mes "^3355FF看起来这扇门";
				mes "在预设时间结束后";
				mes "自动关闭了。^000000";
				mes "";
				close;
			}
		}
		else {
			mes "^3355FF你用尽全力";
			mes "试图推开门，";
			mes "但门纹丝不动。^000000";
			mes "";
			close;
		}
	}
}

kh_dun01,36,195,0	duplicate(KHAccess)	Entrance Device#khd1	111

//============================================================================
// Kiel Hyre Mansion NPCs, and Kiehl's Room NPCs
//============================================================================

//----------------------------------------------------------------------------
// Kiel's Steward
//----------------------------------------------------------------------------
kh_mansion,78,55,5	script	Steward#kh	109,{
	if (KielHyreQuest < 46) {
		mes "[Steward]";
		mes "这是私人住宅，";
		mes "请离开。";
		close2;
		warp "lighthalzen",188,201;
		end;
	}
	if ((KielHyreQuest >= 46) && (KielHyreQuest < 50)) {
		mes "[Steward]";
		mes "您好。";
		mes "您是受";
		mes "这座宅邸的主人";
		mes "邀请来的吗？";
		next;
		switch(select("出示金钥匙:????")) {
		case 1:
			mes "[Steward]";
			mes "啊，"+strcharinfo(0)+" 大人。";
			mes "我一直在等您到来。";
			mes "请往这边走。";
			close2;
			warp "kh_mansion",21,14;
			end;
		case 2:
			mes "[Steward]";
			mes "如果您没有受到";
			mes "这座宅邸主人的邀请，";
			mes "恐怕我必须要求您";
			mes "立即离开！";
			mes "";
			close2;
			warp "lighthalzen",188,201;
			end;
		}
	}
	if ((KielHyreQuest >= 50) && (KielHyreQuest < 64) || (KielHyreQuest >= 70)) {
		mes "[Steward]";
		mes "啊，"+strcharinfo(0)+" 大人。";
		mes "很高兴再次";
		mes "接待您。";
		mes "您想见";
		mes "我的主人吗？";
		next;
		switch(select("是:否")) {
		case 1:
			mes "[Steward]";
			mes "好的。";
			mes "请往这边走~";
			close2;
			warp "kh_mansion",21,14;
			end;
		case 2:
			mes "[Steward]";
			mes "好的。";
			mes "请随意。";
			mes "把这里当作自己家。";
			close;
		}
	}
	if ((KielHyreQuest == 52) || (KielHyreQuest == 54) || (KielHyreQuest >= 64) && (KielHyreQuest <= 70)) {
		mes "[Steward]";
		mes "啊，"+strcharinfo(0)+" 大人。";
		mes "很高兴再次";
		mes "接待您。";
		mes "您想见我的主人，";
		mes "还是……？";
		next;
		switch(select("^FF0000基尔·海勒^000000:^3355FF米切尔^000000")) {
		case 1:
			mes "[Steward]";
			mes "好的。";
			mes "请往这边走~";
			close2;
			warp "kh_mansion",21,14;
			end;
		case 2:
			mes "[Steward]";
			mes "哦……？你一定是来";
			mes "传达好消息的。";
			mes "请原谅……";
			next;
			mes "^3355FF管家偷偷地^000000";
			mes "^3355FF环顾四周，确认^000000";
			mes "^3355FF没有人在监视他。^000000";
			next;
			mes "[Steward]";
			mes "我想现在让你";
			mes "去见他应该足够安全了……";
			mes "请快往这边走。";
			mes "";
			close2;
			warp "kh_mansion",20,87;
			end;
		}
	}
}

//----------------------------------------------------------------------------
// Kiel Hyre
//----------------------------------------------------------------------------
kh_mansion,22,28,4	script	Kiel Hyre#kh	903,{
	if (checkweight(908,200) == 0) {
		mes "^3355FF等一下……";
		mes "你现在携带了太多物品，";
		mes "所以需要先腾出";
		mes "更多背包空间……^000000";
		mes "";
		mes "";
		close;
	}

	cutin "kh_kyel01",2;
	if (KielHyreQuest < 46) {
		mes "[Kiel Hyre]";
		mes ".........";
		mes ".........";
		mes "............";
		close2;
		cutin "",255;
		end;
	}

	else if (KielHyreQuest == 46) {
		cutin "kh_kyel01",2;
		mes "[Kiel Hyre]";
		mes "啊，你一定是"+strcharinfo(0)+"。";
		mes "谢谢你救了我的命。";
		mes "你一定有很多问题要问，";
		mes "我会尽力";
		mes "给你答案。";
		next;
		while(1) {
			switch(select("机器人？:^3355FF基尔^000000？:^FF0000艾莉^000000的按钮？")) {
			case 1:
				mes "[Kiel Hyre]";
				mes "我研究机器人";
				mes "已经三十二年了。";
				mes "我很自豪地说，";
				mes "我成功完成了";
				mes "伟大贤者";
				mes "瓦尔蒙特未能完成的事。";
				next;
				mes "[Kiel Hyre]";
				mes "我的梦想是从人类开发";
				mes "人形机器人。那些守护者";
				mes "也许也是机器人，但它们";
				mes "无法凭自由意志行动。";
				mes "";
				next;
				mes "[Kiel Hyre]";
				mes "如果你想了解更多";
				mes "机器人方面的细节，";
				mes "为什么不和^3355FF阿莉西亚^000000谈谈？";
				mes "她能比我更简洁地解释一切。";
				mes "我总是容易说个没完……";
				mes "";
				set .@KHQRead,.@KHQRead+1;
				next;
				break;
			case 2:
				mes "[Kiel Hyre]";
				mes "^3355FF基尔^000000是我唯一的儿子，";
				mes "但我一生的挚爱";
				mes "在生下他后去世了。";
				mes "我承认，他是机械";
				mes "设计和开发方面的天才。";
				mes "";
				next;
				mes "[Kiel Hyre]";
				mes "他主要负责创造";
				mes "像艾莉这样的第三代";
				mes "机器人。遗憾的是，他试图";
				mes "为了某种邪恶目的";
				mes "改造自己的作品。";
				mes "";
				next;
				mes "[Kiel Hyre]";
				mes "我试图阻止他，";
				mes "却最终被锁在工厂里。";
				mes "我不知道他为什么要这样做。";
				mes "我仍然完全不明白……";
				mes "";
				mes "";
				set .@KHQRead,.@KHQRead+1;
				next;
				break;
			case 3:
				mes "[Kiel Hyre]";

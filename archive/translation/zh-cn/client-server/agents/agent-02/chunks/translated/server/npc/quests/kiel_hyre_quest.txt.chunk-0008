//----------------------------------------------------------------------------
// Kiel Hyre - OnTouch
//----------------------------------------------------------------------------
kh_dun01,224,233,0	script	Factory B Area Door	-1,5,5,{
OnTouch:
	if (KielHyreQuest == 40) {
		if (checkweight(7497,1) == 0) {
			mes "^3355FF等一下……";
			mes "你现在携带了太多物品，";
			mes "所以需要先腾出";
			mes "更多背包空间……^000000";
			mes "";
			mes "";
			close;
		}
		mes "^3355FF你隐约听到";
		mes "门另一侧传来的声音。^000000";
		mes "";
		next;
		mes "[????]";
		mes "^333333...Kiehl...";
		mes "……你竟敢……！^000000";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "基尔·海勒先生？";
		mes "里面的是你吗？";
		next;
		mes "[Kiel Hyre]";
		mes "谁、谁在那里？";
		mes "报上身份！";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "我……我……";
		next;
		mes "^3355FF你向门后的声音解释";
		mes "自己的故事，并告诉他";
		mes "艾莉和阿莉西亚发生了什么。^000000";
		mes "";
		next;
		mes "[Kiel Hyre]";
		mes "^333333……是的……是我。";
		mes "我是基尔·海勒，被困在这里。";
		mes "他竟然走到这一步，";
		mes "改造了艾莉，嗯？";
		mes "...............................^000000";
		next;
		mes "[Kiel Hyre]";
		mes "^333333快，把这个模块";
		mes "带给阿莉西亚！";
		mes "她会知道如何使用。";
		mes "如果你真的在帮助我们，";
		mes "她也会给你一些指示。^000000 ";
		next;
		mes "^3355FF基尔·海勒把";
		mes "一块奇怪的金属碎片";
		mes "从门与地板之间的";
		mes "缝隙中递了出来。^000000";
		mes "";
		mes "";
		getitem 7497,1; //Steel_Piece
		set KielHyreQuest,42;
		close;
	}

	else if (KielHyreQuest >= 42) {
		mes "[Kiel Hyre]";
		mes "......";
		close;
	}
}


			mes "已经报告给基尔·海勒，";
			mes "他已经离开去阻止基尔。";
			mes "但海勒还没有回来。";
			next;
			mes "[Allysia]";
			mes "担心基尔会破坏我，";
			mes "基尔·海勒带来了我的复制品。";
			mes "我仍能检测到基尔·海勒的心跳，";
			mes "所以他应该没事，";
			mes "但他的亲生儿子可能很快伤害他。";
			mes "";
			next;
			mes "[Allysia]";
			mes "拿着这张钥匙卡，";
			mes "它能让你进入";
			mes "工厂内部的秘密区域。";
			mes "如果你找到基尔·海勒，";
			mes "请立即告诉我。";
			mes "";
			getitem 7496,1; //Red_Key_Card
			set KielHyreQuest,40;
			break;
		}
		close2;
		cutin "",255;
		end;
	}
	else if (KielHyreQuest == 40) {
		mes "[Allysia]";
		mes "我仍能检测到";
		mes "基尔·海勒的心跳，";
		mes "但他的儿子基尔可能";
		mes "很快对他做出危险举动。";
		mes "请在那之前找到";
		mes "基尔·海勒！";
		close2;
		cutin "",255;
		warp "kh_dun01",22,216;
		end;
	}
	else if (KielHyreQuest == 42) {
		mes "[Allysia]";
		mes "你已经";
		mes "找到基尔·海勒了吗？";
		next;
		mes "^3355FF你告诉阿莉西亚^000000";
		mes "^3355FF基尔·海勒被关在哪里，^000000";
		mes "^3355FF并把基尔·海勒交给你的金属^000000";
		mes "^3355FF碎片给她。她拿起碎片^000000";
		mes "^3355FF戴在手腕上。^000000";
		mes "^3355FF^000000";
		next;
		mes "[Allysia]";
		mes "……基尔·海勒的秘密代码";
		mes "确认。B_2_3 区域。";
		mes "生命体征正常。";
		mes "已收到信封。正在发送";
		mes "修改后的傀儡设计图……";
		next;
		mes "[Allysia]";
		mes "好了，我已经收到";
		mes "基尔·海勒的命令，";
		mes "必须执行……";
		delitem 7497,1; //Steel_Piece
		set KielHyreQuest,44;
		close2;
		cutin "",255;
		end;
	}
	else if (KielHyreQuest == 44) {
		mes "[Allysia]";
		mes "好了，我有一项任务";
		mes "要替基尔·海勒执行，";
		mes "而且时间不多。";
		mes "让我快速告诉你";
		mes "具体指示。";
		next;
		mes "[Allysia]";
		mes "首先，出于安全原因，";
		mes "我需要收走你的钥匙卡。";
		mes "其次，在里希塔乐镇的";
		mes "基尔·海勒宅邸与我会合。";
		mes "出示金钥匙";
		mes "才能进入宅邸。";
		delitem 7492,1; //Yellow_Key_Card
		delitem 7495,1; //Blue_Key_Card
		delitem 7496,1; //Red_Key_Card
		set KielHyreQuest,46;
		next;
		mes "[Allysia]";
		mes "我知道这一切很突然，";
		mes "也没有给你详细解释，";
		mes "但如果不尽快赶路，";
		mes "就会发生可怕的事情。";
		mes "请尽快行动。";
		mes "不要再耽搁。";
		close2;
		warp "yuno_fild08",73,172;
		cutin "",255;
		end;
	}
	else if (KielHyreQuest >= 44) {
		mes "[Allysia]";
		mes "我知道这一切很突然，";
		mes "也没有给你详细解释，";
		mes "但如果不尽快赶路，";
		mes "就会发生可怕的事情。";
		mes "请尽快行动。";
		mes "不要再耽搁。";
		close2;
		warp "yuno_fild08",73,172;
		cutin "",255;
		end;
	}
}


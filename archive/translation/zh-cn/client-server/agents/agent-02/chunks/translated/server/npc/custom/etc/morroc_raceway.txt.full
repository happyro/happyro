//Finish Line
pvp_y_1-5,174,244,5	script	Finish Line	111,6,6,{
	end;
OnTouch:
	if (@raceid != $@raceid) goto L_WrongRace;
	if (@race != 5) goto L_Miss;
	set @race,6;
	set $@position,$@position+1;
	announce "[" + strcharinfo(0) +"] 已到达终点！[名次：" + $@position + "]",1;
	end;
L_Miss:
	mes "你错过了一个检查点。请回去。";
	close;
L_WrongRace:
	mes "你不在这场比赛中。";
	close;
}


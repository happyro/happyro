			mes "[布里]";
			mes "我一直代替他采收，不过……";
			next;
			mes "[布里]";
			mes "总之，我才刚开始，所以不太了解。如果想问尤格拉德西尔果实，就去^6666cc马郎多西部^000000的我家。";
			next;
			mes "[布里]";
			mes "我父亲今天也会待在那里，说自己很无聊……";
			set ma_tomas,8;
			changequest 11215,11216;
			close;
		case 2:
			mes "[布里]";
			mes "呼……";
			close;
		}
	} else if (ma_tomas < 12) {
		mes "[布里]";
		mes "总之，我才刚开始，所以不太了解。如果想问尤格拉德西尔果实，就去^6666cc马郎多西部^000000的我家。";
		next;
		mes "[布里]";
		mes "我父亲今天也会待在那里，说自己很无聊……";
		close;
	} else if (ma_tomas == 12) {
		mes "[布里]";
		mes "马里博士，请让我帮忙修复裂缝！";
		mes "以前你经常叫我帮忙，为什么现在说不能把工作交给我？";
		next;
		mes "[地质学家马里]";
		mes "不行，喵～";
		mes "布里，你得帮助你的父亲，喵～";
		next;
		mes "[布里]";
		mes "但如果这座岛沉没，所有忙碌都没有意义！";
		next;
		mes "[地质学家马里]";
		mes "这和鸡生蛋、蛋生鸡的情况一样，喵～";
		mes "如果尤格拉德西尔果实卖不出去，我们就无法购买修复裂缝的工具，喵～";
		next;
		mes "[Brie]";
		mes "...";
		next;
		mes "[地质学家马里]";
		mes "所以回家帮助你的父亲吧，喵～";
		next;
		mes "[布里]";
		mes "好吧，那等他的腿恢复后我再回来。";
		next;
		mes "[地质学家马里]";
		mes "很好。";
		mes "我会等你，喵～";
		next;
		mes "[地质学家马里]";
		mes "现在我要把他送回家，再去寻找参与者，喵～";
		mes "干杯！";
		set ma_tomas,13;
		completequest 11220;
		close;
	}
	mes "[布里]";
	mes "呼……我紧张得有点变得挑剔了。";
	mes "现在我只考虑采收的事。";
	close;
}

mal_in01,114,169,5	script	Rican#mal	547,{
	if (ma_tomas < 9) {
		mes "[里坎]";
		mes "呜哇哈哈……";
		mes "呜哇啊啊啊……";
		mes "我受够了……像这样待在家里！！";
		emotion ET_SLEEPY;
		next;
		mes "[里坎]";
		mes "我的腿什么时候才能恢复，什么时候？！";
		mes "应该很快就会好起来，这样我就能像以前一样工作……";
		mes "但我几乎动不了。";
		if (ma_tomas < 8)
			close;
		next;
		mes "[里坎]";
		mes "我只能整天按按钮～";
		mes "一点也不有趣～";
		mes "我越来越不想做任何事了～嘟比嘟巴～";
		emotion ET_SLEEPY;
		next;
		select("打扰一下。这是里坎的家吗？" );
		mes "[里坎]";
		mes "嗯？";
		mes "你是谁！";
		mes "我是里坎！";
		mes "见到你真好，我现在无聊得很……";
		mes "快告诉我现在发生了什么！现在！";
		emotion ET_HUK;
		next;
		select("询问尤格拉德西尔果实。" );
		mes "[里坎]";
		mes "尤格拉德西尔果实？";
		mes "你……你知道些什么！";
		mes "嗯，哈哈哈！";
		mes "只有少数猫知道尤格拉德西尔果实！";
		emotion ET_SPARK;
		next;
		mes "[里坎]";
		mes "在和你这样的​​人类交易之前，尤格拉德西尔果实并不被认为是什么特别的水果。";
		next;
		mes "[里坎]";
		mes "以前在我的故乡到处都是。它味道不好，还会导致消化不良，喵～";
		mes "猫自然应该吃鱼。";
		emotion ET_SEXY;
		next;
		mes "[里坎]";
		mes "但人类吃了这个，就能完全恢复活力。";
		next;
		mes "[里坎]";
		mes "一开始，我从没想过它能卖出去！";
		next;
		mes "[里坎]";
		mes "咳咳～";
		mes "那时候真是太棒了……";
		next;
		mes "[里坎]";
		mes "很久以前……";
		mes "我们一群猫离开城镇，踏上新的贸易路线。";
		emotion ET_SHY;
		next;
		mes "[Rican]";
		mes "实际上，我们控制着城镇周边区域，寻找未探索的地方就像一项挑战。";
		next;
		mes "[Rican]";
		mes "但发现未知事物就是男人的浪漫，不是吗？";
		emotion ET_COOL;
		next;
		mes "[Rican]";
		mes "总之，开头还算不错。";
		mes "在海上漂了一个月或两个月后……";
		next;
		mes "[Rican]";
		mes "海里鱼很多，但我觉得很无聊。我最想吃有调味的食物，比如萝卜炖鸡。";
		emotion ET_HUNGRY;
		next;
		mes "[Rican]";
		mes "虽然漂流了很久，我们却没能在任何岛屿靠岸，反而遇到了暴风雨。";
		next;
		mes "[Rican]";
		mes "这是我第一次见到如此猛烈的龙卷风。";
		mes "当时我吓得失去理智，以为自己会死。";
		next;
		mes "[Rican]";
		mes "我不知道其他船怎么样，但这艘纳维号幸运地在这座岛上着陆。";
		next;
		mes "[Rican]";
		mes "咳咳！";
		mes "你能相信吗？";
		mes "^0000FF那艘巨大的船像飞艇一样呼呼飞来，最后掉在这座岛中央！^000000";
		emotion ET_HUK;
		next;
		mes "[Rican]";
		mes "总之我活了下来，但船上的大部分货物都被冲走，只剩下尤格拉德西尔果实。";
		next;
		mes "[Rican]";
		mes "嗯？既然不吃，为什么要装船？";
		mes "这……这是秘密……";
		emotion ET_SWEAT;
		next;
		mes "[Rican]";
		mes "这不重要。我们派出侦察队后，发现那里有与我们不同的种族居住。";
		mes "那就是你们人类的土地。";
		next;
		mes "[Rican]";
		mes "不管过程如何，我们找到了原本想要的贸易区域……只是还不知道怎么回故乡。";
		next;
		mes "[Rican]";
		mes "我们猫族开始大力销售。";
		mes "但我们手里只有尤格拉德西尔果实，对吧？";
		mes "本来没抱多大期待，没想到卖得非常好。";
		next;
		mes "[Rican]";
		mes "传闻中，它在人类中卖出了很高的价格，对人类有显著效果。";
		mes "于是我们终于定居下来，销售尤格拉德西尔果实，利润不断增长。";
		next;
		mes "[Rican]";
		mes "但我们卖的是干燥品，^0000FF和人类原本知道的有些不同，效果较弱，也很难生吃^000000。";
		next;
		mes "[Rican]";
		mes "因为加工时它会消失，所以这种方式对我们来说最好。";
		emotion ET_GOODBOY;
		next;
		mes "[Rican]";
		mes "对了，我在这个重要季节受了伤，如果不能按时交付订购数量，就会损害我的信誉！";
		mes "贸易就是信誉！！！";
		emotion ET_HUK;
		next;
		mes "[Rican]";
		mes "因此，你愿意帮我吗？";
		mes "虽然我儿子在帮忙，但我们能准备的数量还不够。";
		next;
		switch(select("我来帮他。：我不帮。")) {
		case 1:
			mes "[Rican]";
			mes "咳咳！";
			mes "我第一次见你就对你印象很好！";
			next;
			mes "[Rican]";
			mes "采收尤格拉德西尔果实很简单。";
			mes "只要挖地面就能得到，喵～";
			emotion ET_HUK, playerattached();
			next;
			select("？！" );
			mes "[里坎]";
			mes "嗯？";
			mes "它本来不就是从地里长出来的吗？";
			emotion ET_HUK, playerattached();
			next;
			select("它不是长在树上吗？" );
			mes "[里坎]";
			mes "米德加尔特的尤格拉德西尔果实或许是这样。";
			mes "但^6666cc我们这里的尤格拉德西尔果实是从地里挖出来的^000000。";
			emotion ET_HUK, playerattached();
			next;
			mes "[里坎]";
			mes "在马郎多岛很容易得到。带大约30个给我。";
			mes "啊！一定要对我儿子保密～";
			mes "那么拜托^ff99cc！！！^000000拜托^ff99cc！！！^000000拜托～～～";
			emotion ET_CHUP;
			set ma_tomas,9;
			changequest 11216,11217;
			close;
		case 2:
			mes "[里坎]";
			mes "哦？如果帮不了忙也没关系。";
			mes "我受伤的腿好痛……（呻吟）";
			close;
		}
	} else if (ma_tomas == 9) {
		if (countitem(6435) < 30) {
			mes "[Rican]";
			mes "在马郎多岛很容易得到。带大约30个给我。";
			mes "啊！一定要对我儿子保密～";
			mes "那么拜托^ff99cc！！！^000000拜托^ff99cc！！！^000000拜托～～～";
			emotion ET_CHUP;
			close;
		}
		mes "[Rican]";
		mes "哦，哦！！";
		mes "这新鲜的气味！！！";
		mes "哈啊～真新鲜，干得好！";
		mes "你很擅长采收尤格拉德西尔果实吗？";
		next;
		mes "[Rican]";
		mes "那么能把它放进我面前的机器里吗？";
		set ma_tomas,10;
		changequest 11217,11218;
		close;
	} else if (ma_tomas == 10) {
		mes "[Rican]";
		mes "哦，哦！！";
		mes "这新鲜的气味！！！";
		mes "哈啊～真新鲜，干得好！";
		mes "你很擅长采收尤格拉德西尔果实吗？";
		next;
		mes "[Rican]";
		mes "那么能把它放进我面前的机器里吗？";
		close;
	} else if (ma_tomas == 11) {
		if (checkweight(1201,1) == 0) {
			mes " - 注意！！-";
			mes " - 你携带的物品太多，- ";
			mes " - 无法领取物品。- ";
			mes " - 请减轻负重，- ";
			mes " - 然后再试一次。- ";
			close;
		}
		if (MaxWeight - Weight < 1000) {
			mes " - 注意！！-";
			mes " - 你携带的物品太重，- ";
			mes " - 无法领取物品。- ";
			mes " - 请减轻负重，- ";
			mes " - 然后再试一次。- ";
			close;
		}
		mes "[Rican]";
		mes "呼呼～多亏你的帮助，我安心多了。";
		mes "我还担心突然要这么多会不会太过分，结果刚刚好！";
		next;
		mes "[Rican]";
		mes "对了，我儿子说去开会了，但还没有消息。";
		mes "希望他没有又去烦马里博士……";
		next;
		mes "[Rican]";
		mes "自从我的腿受伤后，他似乎更常去找马里博士。";
		mes "这样下去研究时间会变长……";
		next;
		mes "[Rican]";
		mes "如果见到我儿子，请告诉他快点回来～";
		mes "这是给你的报酬，辛苦了，拿去买点好吃的吧。";
		set ma_tomas,12;
		getitem 6422,20; //Egrade_Coin
		changequest 11219,11220;
		setquest 11239;
		close;
	} else if (ma_tomas == 12) {
		mes "[Rican]";
		mes "自从我的腿受伤后，他似乎更常去找马里博士。";
		mes "这样下去研究时间会变长……";
		mes "如果见到我儿子，请告诉他快点回来～";
		close;
	} else if (ma_tomas > 99) {
		if (checkquest(11238) != -1) {
			if (countitem(6435) < 30) {
				mes "[Rican]";
				mes "你需要正好30个才能兑换一组！";
				close;
			}
			mes "[Rican]";
			mes "非常可靠！";
			mes "你不想和尤格拉德西尔果实做生意吗？";
			delitem 6435,30; //Fresh_Fruit
			erasequest 11238;
			setquest 11239;
			getitem 6422,5; //Egrade_Coin
			close;
		} else if (checkquest(11239,PLAYTIME) == 0 || checkquest(11239,PLAYTIME) == 1) {
			mes "[Rican]";
			mes "要休息一会儿吗？";
			mes "距离你上次工作还不到一天呢～";
			close;
		} else {
			if (checkquest(11239,PLAYTIME) == 2)
				erasequest 11239;
			mes "[Rican]";
			mes "嘿嘿～";
			mes "你又来帮我了吗？";
			mes "你真可靠！";
			next;
			switch(select("我来帮忙。：我不帮。")) {
			case 1:
				mes "[Rican]";
				mes "和之前是同样的任务。";
				mes "30个尤格拉德西尔果实。你可以在马兰岛轻松找到它们！！";
				mes "啊！一定要对我儿子保密～";
				mes "那么拜托^ff99cc！！！^000000拜托^ff99cc！！！^000000拜托～～～";
				emotion ET_CHUP;
				setquest 11238;
				close;
			case 2:
				mes "[Rican]";
				mes "是吗？既然来了，就在这里玩玩吧～";
				close;
			}
		}
	}
	mes "[Rican]";
	mes "呜哇哈哈……";
	mes "呜哇啊啊啊……";
	mes "我受够了……像这样待在家里！！";
	next;
	mes "[Rican]";
	mes "我只能整天按按钮～";
	mes "一点也不有趣～";
	mes "我越来越不想做任何事了～嘟比嘟巴～";
	close;
}

mal_in01,116,168,0	script	Dry Machine#mal	563,{
	if (ma_tomas == 10) {
		if (countitem(6435) < 30) {
			mes "[Rican]";

mal_dun01,136,122,3	script	Biscuit#mal	551,{
	if (ma_tomas < 20) {
		mes "- 这里有奇怪的东西。-";
		mes "- 不知为什么感觉-";
		mes "- 你不该和它对视。-";
		close;
	} else if (ma_tomas == 20) {
		mes "[Biscuit]";
	mes "星糖就这样牺牲了自己，但那些家伙只顾着为自己设置柱子。";
	mes "呼哇！！！";

<div id="PetInformations">
	<div class="titlebar" data-background="basic_interface/titlebar_mid.bmp">
		<div class="left">
			<span class="text" data-text="584">宠物信息</span>
		</div>
		<div class="right">
			<button
				class="base close"
				data-background="basic_interface/sys_close_off.bmp"
				data-hover="basic_interface/sys_close_on.bmp"
			></button>
		</div>
		<div class="clear"></div>
	</div>
	<div class="content">
		<div class="title_name">名称</div>
		<input type="text" class="name" value="" />
		<div class="title_level">等级</div>
		<div class="level"></div>
		<button
			class="modify"
			data-background="btn_edit.bmp"
			data-hover="btn_edit_a.bmp"
			data-down="btn_edit_b.bmp"
		></button>

		<div class="title_hunger">饥饿度</div>
		<div class="hunger"></div>
		<div class="title_intimacy">亲密度</div>
		<div class="intimacy"></div>

		<div class="title_accessory">饰品</div>
		<div class="accessory">已装备</div>
		<div class="feeding">
			<span data-text="2577">自动喂食</span
			><button class="pet_auto_feed" data-background="checkbox_0.bmp" data-preload="checkbox_1.bmp"></button>
		</div>

		<select class="command">
			<option value="default">&lt; Command &gt;</option>
			<option value="feed" data-text="592">喂食宠物</option>
			<option value="action" data-text="593">互动</option>
			<option value="release" data-text="594">返回蛋壳</option>
			<option value="unequip" data-text="595">卸下饰品</option>
		</select>
	</div>
</div>

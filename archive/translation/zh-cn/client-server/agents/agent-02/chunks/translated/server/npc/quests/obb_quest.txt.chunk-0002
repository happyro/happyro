			mes "哦，对，任何地方……除了卢迪。";
			mes "真糟糕。";
			close2;
			set thai_head,2;
			end;
		case 3:
			mes "[Tourist]";
			mes "哦……对了！";
			mes "没错，艾尔迪巴兰……";
			mes "看来我终究没有";
			mes "迷路。";
			next;
			mes "[Tourist]";
			mes "有人告诉我艾尔迪巴兰有一座^FF0000钟楼^000000。";
			mes "你能告诉我^FF0000钟楼^000000在哪里吗？";

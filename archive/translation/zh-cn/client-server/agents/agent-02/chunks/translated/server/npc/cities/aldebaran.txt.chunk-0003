					getitem 505,10;// Blue_Potion
					mes "三等奖～～";
					mes "三等奖！";
					mes "奖励是 ^00FF0010 瓶蓝色药水～^000000";
					next;
					mes "[Kafra Employee]";
					mes "精神力不足时就试试这些吧～";
				}
				else if (.@choose_prize < 20) {
					getitem 608,1;// Seed_Of_Yggdrasil
					getitem 526,10;// Royal_Jelly
					mes "二等奖～～";
					mes "二等奖～～";
					mes "奖励是 ^00FF001 个世界树种子～^000000";
					mes "奖励是 ^00FF0010 个蜂王浆～^000000";
					next;
					mes "[Kafra Employee]";
					mes "真是丰厚的礼物～";
					mes "这些都是非常健康的食物～";

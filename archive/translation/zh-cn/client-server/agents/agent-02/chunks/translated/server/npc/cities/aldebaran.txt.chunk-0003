			mes "至于超级初心者，我们其实不该把手推车租给他们，因为艾尔帕兰的超级初心者协会没有和我们签订合同。";
			next;
			mes "[Kafra Roxie]";
		mes "如果卡普拉员工把手推车租给超级初心者，可能会被莱拉严厉责罚……";
			break;
		case 3:
			mes "[Kafra Roxie]";
		mes "哦，好的～！";
		mes "如果你有任何问题，";
		mes "请随时告诉我！";
			break;
		}
		break;
	case 2:
		mes "[Kafra Roxie]";
		mes "谢谢你！";
		mes "得知顾客认可我们真是太好了！我们都在努力，让服务达到你的期望～";
		break;
	}
	close2;
	cutin "",255;
	end;
}

aldeba_in,91,244,4	script	Kafra Service#4alde	112,{
	cutin "kafra_06",2;
	mes "[Kafra Curly Sue]";
	mes "你好，你好！！";
	mes "我是卷毛苏，";
	mes "卡普拉员工中";
	mes "最新加入的成员！";
	next;
	mes "[Kafra Curly Sue]";
	mes "我还需要学习更多服务顾客的知识，但我一直在尽力而为！";
	next;
	if (select("Where's your mommy, kid?:End conversation.") == 1) {
		mes "[Kafra Curly Sue]";
		mes "哇啊啊啊～！";
		mes "我已经不是小孩子了！";
		close2;
		cutin "",255;
		end;
	}
	mes "[Kafra Curly Sue]";
	mes "在卡普拉公司，我们都会尽最大努力，为你提供期待的优质服务。";
	close2;
	cutin "",255;
	end;
}

// Kafra Special Reserve Point NPCs
//============================================================
// Special Reserve ----------------------------------------------
aldeba_in,79,161,7	script	Kafra Employee#reserve1	4_F_KAFRA3,{
	if (checkweight(1201,1) == 0) {
	mes "^3355FF等一下！你现在";
	mes "携带的物品太多了。请先把";
	mes "部分物品存入卡普拉仓库，";
	mes "整理好背包后再回来。";
	mes "谢谢配合。";
		close;
	}
	mes "[Kafra Employee]";
	mes "欢迎你，"+ strcharinfo(0) +"～";
	mes "在这里，你可以把使用";
	mes "卡普拉服务获得的特别储备点";
	mes "兑换成各种实用又有趣的奖品～";
	mes "希望你能找到喜欢的东西。";
	mes "欢迎来看看。";
	next;
	mes "[Kafra Employee]";
	mes "请注意，每个窗口可使用的特别储备点数量不同。";
	mes "这里可以使用 ^7D0781 100 点到 3000 点^000000。";
	next;
	mes "[Kafra Employee]";
	if ((MaxWeight - Weight) < 11000) {
		mes "嗯，不过我觉得你现在";
		mes "似乎没法携带太多东西。";
		mes "看起来你的背包里";
		mes "已经装了太多物品。";
		mes "请先整理一下。";
		mes "这样会更方便。";
		next;
		mes "[Kafra Employee]";
		mes "请把部分物品存入";
		mes "卡普拉仓库。使用这项服务时，";
		mes "我们建议你的背包至少保留";
		mes "^FF00001,100^000000 点重量的空间。";
		mes "这样才能顺利领取奖品。";
		mes "谢谢配合。";
		close;
	}
	.@total = RESRVPTS;
	mes "让我看看……";
	mes strcharinfo(0) +"...";
	mes "啊，你总共有";
	mes .@total +" 点特别储备点。";
	mes "你想把它们";
	mes "兑换成什么呢？";
	next;
	setarray .@select_price[0], 516, 100,7, 200,15, 300,25, 400,35, 500,50, 600,60, 700,75, 800,85, 900,100, 1000;// <item_id>,<points required>,<item quantity>
	.@s = select( "100 = 土豆 7 个", "200 = 土豆 15 个", "300 = 土豆 25 个", "400 = 土豆 35 个", "500 = 土豆 50 个", "600 = 土豆 60 个", "700 = 土豆 75 个", 
		"800 = 土豆 85 个", "900 = 土豆 100 个", "1000 = 第一次抽奖机会！", "下一页物品", "取消" );
	if (.@s == 11) {
		setarray .@select_price[0], 501, 1100,7, 1300,15, 1500,25, 1700,35, 1900,50, 2100,60, 2300,75, 2500,85, 2800,100, 3000;
		.@s = select( "1100 = 红色药水 7 个:1300 = 红色药水 15 个:1500 = 红色药水 25 个:1700 = 红色药水 35 个:1900 = 红色药水 50 个:2100 = 红色药水 60 个:" +
			"2300 = 红色药水 75 个:2500 = 红色药水 85 个:2800 = 红色药水 100 个:3000 = 第二次抽奖机会！::取消" );
		.@choose_sub_select = 1;
	}
	if (.@s != 12) {// cancel
		mes "[Kafra Employee]";
		.@index_points = .@s * 2 - 1;
		.@index_quantity = .@s * 2;
		if (.@total < .@select_price[.@index_points]) {
			.@points = .@select_price[.@index_points] - .@total;
			mes "抱歉，你没有足够的特别储备点";
			mes "来兑换这个奖励。";
			mes "你还需要至少";
			mes "^0000FF"+ .@points +"^000000 点。";
			mes "请继续努力。";
			close;
		}
		.@total = .@total - .@select_price[.@index_points];
		mes "领取这个奖励后，";
		mes "你还剩下 ^AC0000"+ .@total +"^000000 点特别储备";
		mes "点。要用这些点数兑换";
		mes "这个奖励吗？";
		mes "请确认你的选择。";
		mes "谢谢。";
		next;
		if (select( "Exchange.", "Cancel" ) == 1) {
			RESRVPTS = .@total;
			if (.@s < 10)
				getitem .@select_price[0], .@select_price[.@index_quantity];
			else {
				mes "[Kafra Employee]";
				if (.@choose_sub_select == 0) {
					mes "^0000FF第一次抽奖机会！！^000000";
					mes "现在来试试你的运气。";
					mes "准备好了吗！";
				}
				else {
					mes "哎呀……";
					mes "又到那个时候了～";
					mes "卡普拉抽奖时间到了！";
					mes "看看你今天的运气如何。";
					mes "准备好了吗？";
				}
				next;
				mes "[Kafra Employee]";
				mes "你想旋转抽奖机";
				mes "多少次？";
				mes "一次可以旋转 1 到 5 次。";
				mes "请输入次数。";
				next;
				while( input(.@input,1,5) != 0 ) {
					mes "[Kafra Employee]";
					mes "不好意思……？";
					mes "请选择";
					mes "1 到 5 之间的数字。";
					next;
				}
				.@choose_prize = rand(1,20);
				while( .@input != .@random_while ) {
					.@sound_word = rand(1,3);
					if (.@sound_word == 1) {
						mes "^3355FF咔啦啦啦啦……";
						mes "砰砰砰！^000000";
					}
					else if (.@sound_word == 2) {
						mes "^3355FF咔嚓咔嚓咔嚓";
						mes "嗖～～～^000000";
					}
					else if (.@sound_word == 3) {
						mes "^3355FF咚咚咚咚";
						mes "哗啦啦啦～^000000";
					}
					next;
					.@random_while++;
				}
				mes "[Kafra Employee]";
				if (.@choose_sub_select == 0) {
					mes "哦，有东西出来了！";
					mes "看看你赢到了什么～";
					mes "天哪，是……！";
					mes "快来看看吧。";
					next;
					mes "[Kafra Employee]";
					if (.@choose_prize <= 10) {
						getitem 516,100;// Sweet_Potato
						mes "嗯？第、第四等奖？";
						mes "你获得了第四等奖！！";
						mes "这也不错嘛。";
						mes "是 100 个土豆！";
						mes "切片后煎炸，是和朋友喝酒时的好零食～";
						mes "好好享用吧～";
					}
					else if (.@choose_prize <= 15) {
						getitem 602,4;// Wing_Of_Butterfly
						mes "这是三等奖！";
						mes "4 个蝴蝶翅膀～";
						mes "遇到麻烦时，";
						mes "挥动其中一个，";
						mes "就能带你离开……";
						mes "前往安全的地方。";
					}
					else if (.@choose_prize <= 19) {
						getitem 2403,1;// Shoes
						mes "这是二等奖！";
						mes "一双全新闪亮的鞋子！";
						mes "优雅的设计和耐久性";
						mes "值得我们强烈推荐。";
						mes "希望你喜欢新鞋～";
						mes "穿着它去冒险吧。";
					}
					else if (.@choose_prize == 20) {
						getitem 2328,1;// Wooden_Mail
						mes "哇……！";
						mes "这是一等奖！";
						mes "属于你的";
						next;
						mes "一套木制铠甲！";
						mes "今天一定是你的幸运日，";
						mes "冒险者！";
					}
				}
				else {
					mes "看起来";
					mes "有东西出来了！";
					mes "会是什么呢？";
					mes "哦，你刚刚赢到了……";
					next;
					mes "[Kafra Employee]";
					if (.@choose_prize <= 10) {
						getitem 501,100;// Red_Potion
						mes "第、第四等奖……？！";
						mes "呜呜！100 瓶红色药水。";
						mes "等等……其实挺不错的！";
						mes "太好了～你可以和朋友分享，";
						mes "看起来就像个大赢家！";
						mes "大家一起享用吧！";
					}
					else if (.@choose_prize <= 16) {
						getitem 2201,1;// Sunglasses
						mes "三等奖！";
						mes "属于你的一副";
						mes "帅气太阳镜！";
						mes "无论比拼帅气，";
						mes "还是玩扑克，";
						mes "都能让你占据优势～";
					}
					else if (.@choose_prize <= 19) {
						getitem 2226,1;// Cap
						mes "二等奖！";
						mes "一顶……帽子？嗯……";
						mes "防御力还不错，";
						mes "不过我不确定它";
						mes "是否够时尚。算了……";
						mes "至少很实用。";
					}
					else if (.@choose_prize == 20) {
						getitem 505,3;// Blue_Potion
						mes "哇哦……！";
						mes "一等奖！";
						mes "3 瓶蓝色药水～";
						mes "有了足够的药水，";
						mes "就可以更放心地使用技能～";
						mes "恭喜你！";
					}
				}
			}
			next;
		}
	}
	mes "[Kafra Employee]";
	mes "好的。那么请继续使用";
	mes "我们的服务，收集更多";
	mes "特别储备点，";
	mes "兑换更好的奖励。";
	mes "感谢你的光临。";
	mes "祝你好运。";
	close;
}

aldeba_in,88,161,3	script	Kafra Employee#reserve2	4_F_KAFRA3,{
	mes "[Kafra Employee]";
	mes "欢迎～ "+ strcharinfo(0) +"。";
	mes "卡普拉中心正在为顾客举办特别活动。";
	next;
	mes "[Kafra Employee]";
	mes "使用特别储备点参加 ^FF0000特别卡普拉 ^529DFF礼物活动^000000，就能获得免费礼物！";
	mes "卡普拉公司为本次活动添加了新礼物。";
	next;
	mes "[Kafra Employee]";
	mes "要使用你的点数吗？";
	next;
	if (select( "Yes, I do","Maybe in next time" ) == 1) {
		mes "[Kafra Employee]";
		if ((MaxWeight - Weight) < 11000) {
			mes "……天啊……你怎么带了这么多东西……？";
			mes "我觉得你的背包装不下领取的物品～";
			next;
			mes "[Kafra Employee]";
			mes "抱歉～但是～";
			mes "请先前往卡普拉仓库存放物品，空出 ^0000FF1100^000000 点空间后再回来。";
			mes "给你带来不便，敬请谅解～";
			close;
		}
		mes "你的特别储备点为 ^FF0000"+ RESRVPTS +"^000000～";
		mes "请选择类别来测试运气。";
		next;
		setarray .@points[1],5000,7000,10000;
		.@s = select( "5000p = 1st Lottery Chance!", "7000p = 2nd Lottery Chance!", "10000p = 3rd Lottery Chance!", "Cancel" );
		if (.@s != 4) {
			mes "[Kafra Employee]";
			if (RESRVPTS < .@points[.@s]) {
				mes "抱歉～亲爱的～";
				mes "你的特别储备点不足，无法选择这个机会。";
				mes "请检查点数并选择其他选项～";
				close;
			}
			RESRVPTS = RESRVPTS - .@points[.@s];
			mes "^0000FF"+ F_GetNumSuffix(.@s) +" 抽奖机会！！^000000";
			next;
			mes "[Kafra Employee]";
			mes "现在来试试你的运气。";
			next;
			mes "[Kafra Employee]";
			mes "看看你有多幸运。现在！准备好！";
			next;
			.@sound_word = rand(1,3);
			if (.@sound_word == 1)
			mes "‘哒哒哒～哒哒哒～’";
			else if (.@sound_word == 2)
			mes "‘rrrrrr……’";
			else if (.@sound_word == 3)
			mes "‘砰……砰……叮！’";
			next;
			mes "[Kafra Employee]";
			mes "有东西出来了～看看你得到了什么～";
			mes "猜～猜～看～呀～";
			next;
			mes "[Kafra Employee]";
			mes "^FF0000天哪！是！！^000000";
			next;
			mes "[Kafra Employee]";
			.@choose_prize = rand(1,20);
			if (.@s == 1) {
				if (.@choose_prize < 15) {
					getitem 501,150;// Red_Potion
					mes "真遗憾！";
					mes "你获得了第四等奖！！";
					mes "奖励是 ^00FF00150 瓶红色药水～^000000";
					next;
					mes "[Kafra Employee]";
					mes "哇～150 瓶药水！足够和朋友分享了～";
				}
				else if (.@choose_prize < 18) {
					getitem 645,15;// Center_Potion
					mes "三等奖～～";
					mes "三等奖！";
					mes "奖励是 ^00FF0015 瓶集中药水～^000000";
					next;
					mes "[Kafra Employee]";
					mes "需要集中精神时可以使用它。";
					mes "不过，过量使用对身体不好～";
				}
				else if (.@choose_prize < 20) {
					getitem 505,3;// Blue_Potion
					mes "二等奖～～";
					mes "二等奖～～";
					mes "奖励是 ^00FF003 瓶蓝色药水～^000000";
					next;
					mes "[Kafra Employee]";
					mes "精神力不足时就试试这些吧～";
				}
				else if (.@choose_prize == 20) {
					getitem 608,1;// Seed_Of_Yggdrasil
					mes "哇～！！一等奖……一等奖！！！";
					mes "恭喜～～你获得了一等奖～";
					mes "奖励是 ^00FF001 个世界树种子～^000000";
					next;
					mes "[Kafra Employee]";
					mes "看来你把全部运气都用在这次抽奖上了～";

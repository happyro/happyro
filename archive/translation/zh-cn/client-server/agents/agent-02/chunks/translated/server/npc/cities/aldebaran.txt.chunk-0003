				}
				else if (.@choose_prize == 20) {
					getitem 608,1;// Seed_Of_Yggdrasil
					getitem 607,1;// Yggdrasilberry
					mes "哇～！！一等奖……一等奖！！！";
					mes "恭喜～～你获得了一等奖～";
					mes "奖励是 ^00FF001 个世界树果实～^000000";
					mes "奖励是 ^00FF001 个世界树种子～^000000";
					next;
					mes "[Kafra Employee]";
					mes "看来你把全部运气都用在这次抽奖上了～";
				}
			}
			else if (.@s == 3) {
				if (.@choose_prize < 15) {
					getitem 504,30;// White_Potion
					mes "真遗憾！";
					mes "你获得了第四等奖！！";
					mes "奖励是 ^00FF0030 瓶白色药水～^000000";
					next;
					mes "[Kafra Employee]";

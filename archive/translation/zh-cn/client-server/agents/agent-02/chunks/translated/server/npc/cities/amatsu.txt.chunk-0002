	mes "………………";
	mes "…………";
	next;
	mes "^3355FF他的笑声随风越来越低。";
	mes "最后，我什么也听不见了。";
	mes "甚至想不起他当时想告诉我什么……^000000";
	close;
}

amatsu,262,197,1	script	Legendary Tree	111,{
	if (jap_tree == 1) {
		mes "^3355FF正如她所说，这棵树似乎是恋人求婚的著名地点。";
		mes "树皮上刻着许多爱心和恋人姓名首字母。^000000";
		next;
		mes "^3355FF除了求婚，人们也会在讨论重要事情时聚集在树下。";
		mes "在这个壮丽的地方，我能听到各种各样的故事。^000000";
		close;
	}
	else if (jap_tree == 2) {
		mes "^3355FF传说中的戏剧《白色树妖》……";
		mes "我从未听过这个剧名，但感觉很熟悉。";
		mes "樱花树的仙女……她在剧中会扮演什么角色呢？^000000";
		next;
		if (Sex == SEX_MALE) {
			mes "^3355FF我想找一位有表演天赋的人，帮助她直到完成演出。";
			mes "不过，这似乎说起来容易做起来难。^000000";
			close;
		}
		mes "^3355FF也许我有尚未被发现的表演天赋。";
		mes "我想，如果换上装扮，就该出演‘白色树妖’……^000000";
		close;
	}
	else if (jap_tree == 3) {
		mes "^3355FF和其他樱花树不同，这棵树散发着浓郁的香气。";
		mes "我不知不觉放松下来，香气减轻了我的负担，让我感到非常舒适。^000000";
		next;
		mes "^3355FF虽然只有片刻，我却忘记了生活的负担。";
		mes "真希望能再次回来，坐在这棵树下……^000000";
		close;
	}
	else if (jap_tree == 4) {
		mes "^3355FF这股浓郁的香气让我头晕。";
		mes "与其他樱花树不同，这棵树闪耀的白色花瓣令人感到奇异。^000000";
		next;
		mes "^3355FF如果继续待下去，我仿佛会被抽走灵魂。";
		mes "看了一眼樱花树后，我心想：‘必须赶快离开这里。’^000000";
		close;
	}
	mes "^3355FF山丘上有一棵樱花树，看起来与其他树不同。";
	mes "这棵树似乎有着悠久的历史……^000000";
	next;
	mes "^3355FF这里有人居住吗？我环顾四周，发现山下有个人。";
	mes "还是去问问她这棵树的事吧。^000000";
	close;
}


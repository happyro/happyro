//===== rAthena Script ======================================= 
//= 服装染色师
//===== By: ================================================== 
//= Usnul
//===== Current Version: ===================================== 
//= 2.5
//===== Compatible With: ===================================== 
//= rAthena Project
//===== Description: ========================================= 
//= 服装染色师，提供标准色板
//===== Additional Comments: ================================= 
//= Fully working
//= 2.1 Shortened some labels to make this script loading,
//= Added Black+White Colors desc [Lupus]
//= 2.1a added adv classes + baby class support [Lupus]
//= 2.2 Spell checked. [Nexon]
//= 2.3 Fixed dis $hit! [Poki#3]
//= 2.4 Disabled cloth dyeing since it's not implemented
//	   on official servers and cause your client to crash
//	   [Playtester]
//= 2.5 Optimized. [Euphy]
//============================================================

prt_in,284,168,2	script	Dyer Ginedin Rephere	55,{
function Dyes;

	set .@EnableDyes,1;	// Disable (set to 0) if palettes cause errors [see note v2.4]

	set .n$,"[染色师 Ginedin Rephere]";
	mes .n$;
	mes "11……12……嗯……很好。我应该能在今晚的派对前完成。哦！我都没注意到你来了！";
	while(1) {
		next;
		mes .n$;
		mes "我能为你做些什么？";
		next;
		switch(select("- 交谈:- 服装染色:- 价格表:- ^777777取消^000000")) {
		case 1:
			mes .n$;
			mes "生活或许变好了些，但看看我收到的订单……呼！";
			mes "看来如今卢恩·米德加尔特的年轻女性都很富裕。";
			next;
			mes .n$;
			mes "别误会，我不是说她们在追求奢侈品。";
			mes "追求美丽、紧跟时尚并没有什么错。";
			next;
			mes .n$;
			mes "对没有鲜艳毛皮或装饰鳞片的人类来说，服装是展现个性、风格与美丽的少数方式之一。";
			next;
			mes .n$;
			mes "哈哈……这么一想，我真的觉得自己的工作很有意义。我相信我提供的是人们需要的服务。";
			next;
			mes .n$;
			mes "你也能感受到吗？粗糙的布料和皮革被色彩赋予生命时释放的能量？……";
			next;
			mes .n$;
			mes "虽然过程很繁琐又耗时，但礼服完成时的喜悦与幸福足以弥补所有辛劳！！";
			break;
		case 2:
			mes .n$;
			if (!.@EnableDyes) {
				mes "抱歉，我正忙着其他工作，没时间为你的服装染色。";
				break;
			}
			mes "哦……你需要我的服务？好吧……听起来不错。";
			next;
			mes .n$;
			mes "请选择一种适合你的";
			mes "颜色。";
			next;

			// Dyes(<color value>,<dye number>{,...});
			// Colors: [1]Orange, [2]Violet, [3]Red, [4]Black, [5]Green, [6]Blue, [7]White, [8]Yellow
			switch(BaseJob) {
			case Job_Novice:
				if (Sex == SEX_MALE) Dyes(4,1,6,2,5,3); else Dyes(6,1,3,2,5,3,4,4);
			case Job_Swordman:
				if (Sex == SEX_MALE) Dyes(4,1,6,2,5,3); else Dyes(3,1,5,3,4,4);
			case Job_Mage:
				if (Sex == SEX_MALE) Dyes(3,1,2,2,1,3,7,4); else Dyes(3,1,2,2,7,3,4,4);
			case Job_Archer:
				if (Sex == SEX_MALE) Dyes(4,1,2,2,5,3); else Dyes(3,1,5,2,7,3,4,4);
			case Job_Acolyte:
				if (Sex == SEX_MALE) Dyes(6,1,3,2,7,3,4,4); else Dyes(3,1,5,3,4,4);
			case Job_Merchant:
				if (Sex == SEX_MALE) Dyes(4,1,6,2,5,3); else Dyes(2,1,5,3,4,4);
			case Job_Thief:
				if (Sex == SEX_MALE) Dyes(5,1,3,2,7,4); else Dyes(3,1,7,3,4,4);
			case Job_Knight:
			case Job_Crusader:
				if (Sex == SEX_MALE) Dyes(2,1,3,3,4,4); else Dyes(6,1,7,3,4,4);
			case Job_Priest:
			case Job_Monk:
				if (Sex == SEX_MALE) Dyes(6,1,5,2,3,3,7,4); else Dyes(3,1,5,2,7,3,4,4);
			case Job_Wizard:
			case Job_Sage:
				if (Sex == SEX_MALE) Dyes(6,1,5,3,4,4); else Dyes(3,1,6,2,7,3,5,4);
			case Job_Blacksmith:
			case Job_Alchemist:
				if (Sex == SEX_MALE) Dyes(4,4,5,2,7,3); else Dyes(3,1,5,2,2,3,4,4);
			case Job_Hunter:
			case Job_Bard:
			case Job_Dancer:
				if (Sex == SEX_MALE) Dyes(4,1,6,2,5,3); else Dyes(6,1,5,3,2,4);
			case Job_Assassin:
			case Job_Rogue:
				if (Sex == SEX_MALE) Dyes(6,1); else Dyes(4,1,8,2,7,3);
			case Job_Super_Novice:
				if (Sex == SEX_MALE) Dyes(2,1,6,2,5,3,4,4); else Dyes(6,1,3,2,5,3,4,4);
			default: 
				mes "哇，我从没见过这样的服装！抱歉，我恐怕无法为它染色。";
				close;
			}
		case 3:
			mes .n$;
			mes "每种颜色需要 10000z 和 1 份染料：";
			mes " ";
			mes " - ^FF4422红色^000000：猩红色染料";
			mes " - ^D5A500黄色^000000：柠檬色染料";
			mes " - ^AA00AA紫色^000000：紫色染料";
			mes " - ^FF8800橙色^000000：橙色染料";
			mes " - ^4422FF蓝色^000000：钴蓝色染料";
			mes " - ^009500绿色^000000：深绿色染料";
			mes " - 黑色：黑色染料";
			mes " - 白色：白色染料";
			break;
		case 4:
			goto L_End;
		}
	}

L_End:
	mes .n$;
	mes "请随意。虽然我没时间招待你。";
	close;

function Dyes {
	setarray .@DyeName$[0],"默认颜色","橙色","紫色","红色","黑色","绿色","蓝色","白色","黄色";
	setarray .@DyeItems[0],0,980,981,975,983,979,978,982,976;
	set .@menu$,"- 默认颜色:";
	for(set .@i,0; .@i<getargcount(); set .@i,.@i+2)
		set .@menu$, .@menu$+"- "+.@DyeName$[getarg(.@i)]+":";
	set .@menu$, .@menu$+"- ^777777取消^000000";
	set .@s, select(.@menu$)-1;
	if (.@s == (getargcount()/2)+1) goto L_End;
	mes .n$;
	if (.@s == 0) {
		mes "我可以免费将你的染色改回";
		mes "默认颜色。";
		mes "确定吗？";
		next;
		switch(select("是:否")) {
		case 1:
			mes .n$;
			setlook 7,0;
			mes "你的服装已染成"+.@DyeName$[0]+"。";
			close;
		case 2:
			goto L_End;
		}
	}
	if (!countitem(.@DyeItems[getarg((.@s-1)*2)])) {
		mes "要为你的服装染色，我需要相应的染料。详情请查看价格表。";
		close;
	}
	if (Zeny < 10000) {
		mes "抱歉，你的钱不够。";
		close;
	}
	delitem .@DyeItems[getarg((.@s-1)*2)],1;
	set Zeny, Zeny-10000;
	setlook 7, ((.@s)?(getarg((.@s-1)*2+1)):0);
	mes "你的服装已染成"+((.@s)?.@DyeName$[getarg((.@s-1)*2)]:.@DyeName$[0])+"。";
	close;
}
}

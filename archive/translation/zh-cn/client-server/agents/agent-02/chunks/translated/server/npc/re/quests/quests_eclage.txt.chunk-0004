	}
	close;
}

eclage,266,216,4	script	Moreng#ep14_2	4_M_FAIRYKID3,{
	if (ep14_2_oliver < 16) {
		mes "艾克拉治是非常适合居住的地方。";
		mes "鲜花总是盛开，天气也一直很舒适。";
		next;
		mes "[Moreng]";
		mes "如果我有一个美丽的尤艾，那就真的是天堂了！";
		next;
		mes "[Moreng]";
		mes "尤艾其实指的是蛋。";
		mes "对拉斐内人来说，尤艾甚至可以代表超越家的存在……";
		emotion ET_SHY;
	}
	else if (ep14_2_oliver == 16) {
		mes "艾克拉治是非常适合居住的地方。";
		mes "鲜花总是盛开，天气也一直很舒适。";
		next;
		mes "[Moreng]";
		mes "如果我有一个美丽的尤艾，那就真的是天堂了！";
		emotion ET_SHY;
		next;
		mes "[Oliver]";
		mes "哦，原来你们把那些圆形房子叫作尤艾。";
		cutin "bu_oliver2",0;
		next;
		cutin "",255;
		mes "[Moreng]";
		mes "尤艾其实指的是蛋。";
		mes "对拉斐内人来说，尤艾甚至可以代表超越家的存在……";
		next;
		mes "[Moreng]";
		mes "我投入了时间和精力，甚至赌上性命，可我的尤艾不过是赝品。";
		emotion ET_FRET;
		next;
		mes "[Moreng]";
		mes "它被叫作蛋，看起来也像蛋，但实际上根本不是蛋！";
		mes "只是某种看起来像蛋的其他东西！";
		emotion ET_HUK;
		next;
		mes "[Moreng]";
		mes "等等！";
		mes "你难道来自米德加尔特？！";
		next;
		if (select("是的。：不，我不是。") == 2) {
			mes "[Moreng]";
		mes "这样啊……";
		mes "你看起来确实像，但看来不是。";
			close;
		}
		mes "[Moreng]";
		mes "啊，太好了！";
		mes "那么你知道生活在米德加尔特的巨鸟传说吗？";
		ep14_2_oliver = 17;
		changequest 11324,11325;
	}
	else if (ep14_2_oliver == 17) {
		mes "我从不同的旅行者那里听到过一些。";
		mes "据传说，米德加尔特有一只巨鸟，会下和房子一样大的蛋。";
		next;
		mes "[Du Lian]";
		mes "哇，如果蛋和房子一样大，要多少天才能吃完？";
		cutin "bu_du1",2;
		next;
		cutin "",255;
		mes "[Moreng]";
		mes "......";
		emotion ET_THINK;
		next;
		mes "[Moreng]";
		mes "我第一次听说这个传说时兴奋得几天睡不着。";
		next;
		mes "[Moreng]";
		mes "但随着时间流逝、年岁增长，我渐渐忘记了它。";
		mes "所有童年的梦想不都是这样吗？";
		emotion ET_CRY;
		next;
		mes "[Moreng]";
		mes "但不久前我去广场时，遇到了老邻居。他告诉我有一位来自米德加尔特的旅行者，手里拿着一根巨大无比的羽毛……";
		next;
		mes "[Moreng]";
		mes "自从听说这件事，我就再也无法专心做其他事。";
		mes "那个传说难道是真的？";
		emotion ET_OHNO;
		next;
		mes "[Moreng]";
		mes "说实话，听到那个故事后我找遍了城镇，却没找到拿着巨大羽毛的人。";
		next;
		mes "[Moreng]";
		mes "你觉得那位老人说的是真的吗？还是认为那是谎言？";
		mes "我以前以为那是被遗忘的传说，但现在甚至害怕知道它是真是假。";
		emotion ET_KEK;
		next;
		mes "[Du Lian]";
		mes "如果你是真正的男子汉，就别这么畏缩！";
		mes "正面面对它！就算最后粉身碎骨也无所谓！";
		emotion ET_HUK;
		emotion ET_HUK, playerattached();
		cutin "bu_du2",2;
		next;
		cutin "",255;
		mes "[Moreng]";
		mes "别把什么东西撞得粉身碎骨……";
		emotion ET_THINK;
		next;
		mes "[Du Lian]";
		mes "为了这种事——！";
		mes "我会去问那位老人，再告诉你！";
		mes "如果传说听起来是假的，我就不告诉你，所以别担心！";
		cutin "bu_du2",2;
		next;
		mes "[Mark Esha]";
		mes "有时真的应该提醒自己，什么叫‘无知就是福’。";
		cutin "bu_mark4",0;
		next;
		mes "[Mark Esha]";
		mes "不管怎样，我也没听说过那个传说。";
		mes "不过对普通拉斐内人来说，对我们微不足道的事也可能非常重大……";
		cutin "bu_mark1",0;
		next;
		mes "[Alp Ocart]";
		mes "但米德加尔特幅员辽阔，也许存在我们没听说过的传说……";
		cutin "bu_alp3",2;
		next;
		mes "[Du Lian]";
		mes "是啊，看来只有去见那位老人了！";
		cutin "bu_du1",2;
		ep14_2_oliver = 18;
		changequest 11325,11326;
	}
	else if (ep14_2_oliver == 18) {
		mes "你觉得那位老人说的是真的吗？还是认为那是谎言？";
		mes "我以前以为那是被遗忘的传说，但现在甚至害怕知道它是真是假。";
		next;
		mes "[Du Lian]";
		mes "是啊，看来只有去见那位老人了！";
		mes "我们去广场吧！";
		cutin "bu_du1",2;
	}
	else if (ep14_2_oliver == 19 || ep14_2_oliver == 20) {
		mes "你觉得那位老人说的是真的吗？还是认为那是谎言？";
		mes "我以前以为那是被遗忘的传说，但现在甚至害怕知道它是真是假。";
	}
	else if (ep14_2_oliver == 21 || ep14_2_oliver == 22) {
		mes "这是真的吗？";
		mes "我不敢相信传说是真的……";
		next;
		mes "[Moreng]";
		mes "我该说什么？";
		mes "我觉得自己不能继续待在这里了。";
		mes "我得赶紧收拾行李，前往米德加尔特！";
		if (ep14_2_oliver == 22) {
			emotion ET_HUK;
			emotion ET_HUK, playerattached();
		}
		next;
		mes "- 莫伦格似乎真的快要离开了。我应该告诉格拉塞斯。-";
		if (ep14_2_oliver == 21) {
			ep14_2_oliver = 22;
			changequest 11329,11330;
		}
	}
	else {
		mes "和朋友的生日告别派对结束后，我就打算前往米德加尔特。";
		next;
		mes "[Moreng]";
		mes "我肯定会想念朋友，但我应该尽快回来。";
	}
	close2;
	cutin "",255;
	end;
}

ecl_in01,60,71,4	script	Old Man#ep14_2	4_M_FAIRYKID2,{
	mes "[Old Man]";
	if (ep14_2_oliver == 18) {
		mes "呵呵呵";
		next;
		mes "[Old Man]";
		mes "看来最近有很多有趣的访客……";
		mes "我年轻时，前往异国必须赌上性命。";
		next;
		mes "[Old Man]";
		mes "如今随着管制放宽，一切方便多了。";
		mes "有传送和飞行可以去任何地方，冒险还有什么浪漫可言？";
		emotion ET_HNG;
		next;
		mes "[Old Man]";
		mes "现在的年轻人恐怕连青蛙卵是什么味道都不知道。";
		emotion ET_HNG;
		next;
		mes "[Old Man]";
		mes "我攒够果冻肉买村正剑仿佛就在昨天，但那把村正剑现在也被遗忘在仓库某处。";
		emotion ET_CRY;
		next;
		mes "[Old Man]";
		mes "时间真是无情……如果当时知道会这样，我就会……";
		next;
		mes "[Old Man]";
		mes "嘿！你听说过一位名叫光之标准的拉斐内英雄吗？";
		next;
		switch( select("不，我没听说过。：是的，我听说过。")) {
			mes "[Old Man]";
			mes "呵呵呵……";
		case 1:
			mes "他是很久以前的英雄，这一代人甚至不知道他是谁。";
			mes "他可能早已被遗忘……";
			break;
		case 2:
			mes "像你这样的年轻人竟然知道他，真令人惊讶。";
			mes "我以为他早已被遗忘……";
			break;
		}
		next;
		mes "[Old Man]";
		mes "他身材矮小，甚至算不上高级拉斐内人，却与不可思议的怪物战斗并将其击败。";
		mes "‘传说’这个词仿佛就是为他创造的。";
		next;
		mes "[Old Man]";
		mes "他的英雄事迹家喻户晓，孩子们会在街上歌唱。";
		mes "但诸神黄昏过去、和平降临后，他突然退休了。";
		next;
		mes "[Old Man]";
		mes "他很快就被遗忘了……";
		mes "他力量强大、智慧超群，也有优秀可靠的伙伴，但他并不完美……";
		next;
		mes "[Old Man]";
		mes "你知道他缺少什么吗？";
		next;
		mes "[Old Man]";
		mes "那就是像我这样的‘朋友’。";
		mes "要是他有可靠又宽厚的朋友就好了……";
		next;
		mes "[Du Lian]";
		mes "不过老人家，你知道关于米德加尔特巨鸟的传说吗？";
		emotion ET_HUK, playerattached();
		cutin "bu_du1",2;
		next;
		cutin "",255;
		emotion ET_SHY, playerattached();
		next;
		mes "[Old Man]";
		mes "哦！";
		mes "你说的是米德加尔特巨鸟的传说？";
		next;
		mes "[Old Man]";
		mes "关于这个，在艾克拉治恐怕没人比我更了解。";
		emotion ET_SPARK;
		next;
		mes "[Old Man]";
		mes "光之标准抵达米德加尔特后没过多久。";
		next;
		mes "[Old Man]";
		mes "他说来米德加尔特前经历过许多冒险，但这是他第一次见到如此巨大的鸟。";
		next;
		mes "[Old Man]";
		mes "老实说，我也不相信世上会有那么大的鸟。";
		mes "直到散步时在城镇入口遇到一位带着巨大羽毛的旅行者。";
		next;
		mes "[Old Man]";
		mes "一看到那根羽毛，我就开始相信光之标准说的一切。";
		mes "比如尤通海姆那个戴着尖帽的尘土块……";
		next;
		mes "[Du Lian]";
		mes "嗯……";
		mes "莫伦之前说还没在城里见到他们，也许他还在外面？";
		cutin "bu_du1",2;
		next;
		mes "[Du Lian]";
		mes "那我们开始吧！";
		cutin "bu_du2",2;
		next;
		cutin "",255;
		mes "[Old Man]";
		mes "咦？但我还没讲他在米德加尔特遇到的、能折断任何金属的怪物呢！";
		emotion ET_HUK;
		next;
		mes "[Du Lian]";
		mes "以后再听吧~";
		cutin "bu_du2",2;
		ep14_2_oliver = 19;
		changequest 11326,11327;
	}
	else if (ep14_2_oliver == 19) {
		mes "哦~你改变主意了？";
		mes "好吧，那我告诉你光之标准只告诉我的故事：他在米德加尔特深山遇到了一只吃宝石的黄金怪物！";
		next;
		mes "[Maggi Steen]";
		mes "嗯……";
		mes "杜已经跑掉了……";
		mes "放任他不管的话，不知道他接下来会惹出什么麻烦。";
		cutin "bu_maggi3",2;
		next;
		mes "[Maggi Steen]";
		mes "要去城镇入口，必须经过杜弄坏的桥，不知道修好没有。";
	}
	else {
		mes "呵呵呵~！";
		next;
		mes "[Old Man]";
		mes "看来最近有很多有趣的访客……";
		mes "我年轻时，前往异国必须赌上性命。";
		next;
		mes "老人#ep14_2";
		mes "如今随着管制放宽，一切方便多了。";
		mes "有传送和飞行可以去任何地方，冒险还有什么浪漫可言？";
		emotion ET_HNG;
		next;
		mes "[Old Man]";
		mes "现在的年轻人恐怕连青蛙卵是什么味道都不知道。";
		next;
		mes "[Old Man]";
		mes "我攒够果冻肉买村正剑仿佛就在昨天，但那把村正剑现在也被遗忘在仓库某处。";
		emotion ET_CRY;
	}
	close2;
	cutin "",255;
	end;
}

ecl_fild01,97,315,4	script	Traveler#ep14_2	4_M_JOB_HUNTER,{
	mes "[Traveler]";
	if (ep14_2_oliver == 19) {
		mes "你是谁？";
		mes "我以前没见过你。";
		next;
		mes "[Traveler]";
		mes "哦，你也是来问我羽毛的？";
		mes "那只是普通的旧装饰品，但大家都喜欢为此来烦我。";
		emotion ET_SPARK;
		next;
		mes "[Traveler]";
		mes "如果你想买它，还是放弃吧。";
		mes "无论你怎么求，我都不打算卖。";
		next;
		mes "[Traveler]";
		mes "这根羽毛。";
		mes "它不是普通的羽毛。";
		next;
		mes "[Traveler]";
		mes "嘿……";
		mes "其实事情发生得太近，也没什么好夸耀的……";
		next;
		mes "[Traveler]";
		mes "我抵达阿尔夫海姆后不久遇到它，只是运气好。";
		next;
		mes "[Traveler]";
		mes "那真是太惊人了。它扇动巨大翅膀时，我光是抓紧身体就忙不过来，根本无法攻击。";
		next;
		mes "[Traveler]";
		mes "但我不是轻易放弃的人。";
		mes "现在想来，那是一场非常漫长的战斗。";
		emotion ET_SHY;
		next;
		mes "[Du Lian]";
		mes "奇怪。刚才那位老人说他在米德加尔特见过它。";
		emotion ET_HUK;
		cutin "bu_du1",2;
		next;
		cutin "",255;
		mes "[Traveler]";
		mes "呃！";
		mes "不……不可能。";
		mes "我确实是在米德加尔特见到它的。";
		emotion ET_PROFUSELY_SWEAT;
		next;
		mes "[Traveler]";
		mes "我本来不想给你看，但这道伤疤就是证据。";
		mes "那真是一场危及生命的战斗。";
		next;
		mes "[Mark Esha]";
		mes "嗯……";
		mes "如果战斗发生在不久前，这道伤疤看起来未免太旧了。";
		mes "从伤疤的样子看，甚至不像接受过魔法治疗……";
		emotion ET_HUK;
		cutin "bu_mark4",0;
		next;

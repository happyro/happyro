		ep14_2_oliver = 12;
		changequest 11319,11320;
	}
	else if (ep14_2_oliver == 12)
		mes "塔托住在城镇西边，你去那里问问他吧。";
	else {
		mes "拉斐内人赌上性命，只为让尤艾变得美丽。";
		mes "我自己也是拉斐内人，但很难理解这种优先顺序。";
	}
	close;
}

eclage,137,169,4	script	Tato#ep14_2	4_F_FAIRYKID4,{
	if (ep14_2_oliver == 12) {
		mes "[Tato]";
		mes "莫伦的年龄？";
		mes "我认识他没多久，所以不太清楚他的年龄。";
		next;
		mes "[Tato]";
		mes "可是为什么连他们自己都不知道自己的年龄？！";

			else {
				mes "[Yube]";
				mes "我最多可以制作128个。你需要多少？";
				cutin "war_y4",2;
				next;
				input .@input;
				mes "[Yube]";
				if (.@input < 1 || .@input > 128)
					mes "你不打算制作吗？";
				else if (countitem(6561) < .@input) {
					mes "嗯……";
					mes "要制作那么多，恐怕还需要更多尘土块……";
					cutin "war_y3",2;
				}
				else {
					mes "我这样把尘土块塑形，再这样放上灯芯！";
					mes "好了！";
					delitem 6561,.@input;// Dustball
					getitem 6555,.@input;// Birthday_Candle
					next;
					mes "[Yube]";
					mes "全都做好了！";
					mes "请把它们带给格拉斯。";
					mes "别再弄丢了~~~";
					cutin "war_y2",2;
				}
			}
		}
	}
	else {
		mes "你去过尤通海姆吗？";
		mes "那里住着非常厉害的巨人！";
		cutin "war_y4",2;
	}
	close2;
	cutin "",255;
	end;
}

ecl_in01,73,51,4	script	Murah#ep14_2	4_M_FAIRYKID,{
	mes "[Murah]";
	if (ep14_2_oliver == 10) {
		mes "莫伦的年龄？";
		mes "我不太清楚……";
		mes "也许舒尔知道？";
		next;
		mes "[Murah]";
		mes "莫伦、尤贝和舒尔在一百年前相识。我记得当时他们年龄差距很大，莫伦和尤贝的年龄相加正好等于舒尔的年龄。";
		next;
		mes "[Murah]";
		mes "舒尔的家在城市东边，他应该就在那附近。";
		mes "不管怎样，他们在我出生前就是朋友了，真不可思议。";
		ep14_2_oliver = 11;
		changequest 11318,11319;
	}
	else if (ep14_2_oliver == 11) {
		mes "舒尔的家在城市东边，他应该就在那附近。";
		mes "不管怎样，他们在我出生前就是朋友了，真不可思议。";
	}
	else
		mes "嗯……该送什么特别的礼物呢？";
	emotion ET_SPARK;
	close;
}

eclage,265,166,4	script	Shul#ep14_2	4_M_FAIRYKID2,{
	mes "[Shul]";
	if (ep14_2_oliver == 11) {
		mes "莫伦的年龄？";
		mes "嗯……";
		mes "我已经很久没记大家的年龄了。";
		mes "我只记得格拉斯比我小两岁。";
		emotion ET_SCRATCH;
		next;
		mes "[Shul]";
		mes "说起来，不久前塔托说过，他的年龄等于我的年龄和尤贝年龄的平均值。";
		mes "也许塔托还记得？";
		next;
		mes "[Shul]";

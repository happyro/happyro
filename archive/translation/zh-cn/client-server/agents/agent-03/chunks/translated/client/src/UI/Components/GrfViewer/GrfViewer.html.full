<div id="grfviewer">
	<!-- head titlebar -->
	<div id="head">
		<div id="previous"></div>
		<div id="next"></div>
		<input type="text" value="" id="path" />
		<input type="text" value="Search..." id="search" />
	</div>

	<!-- Loading progress -->
	<div id="progress"></div>

	<!-- Context Menu -->
	<div class="overlay"></div>
	<div id="contextmenu">
		<div class="header" title="复制到剪贴板">名称</div>
		<hr />
		<div class="open">打开文件</div>
		<a class="save" href="#">提取文件</a>
		<hr />
		<div class="info">属性</div>
	</div>

	<!-- Preview box -->
	<div id="preview">
		<div class="box"></div>
	</div>

	<!-- Message -->
	<div id="msg"></div>

	<!-- Drag drop box -->
	<div id="info">
		<h3>将 GRF 文件拖到此区域以开始</h3>
		<div class="input">
			<button>选择文件</button>
			<input type="file" accept="" multiple="multiple" id="file" />
		</div>
	</div>
</div>

//===== rAthena Script ======================================= 
//= Dead Branch (+Bloody Branch) Quest
//===== By: ================================================== 
//= GM-Yevon
//===== Current Version: ===================================== 
//= 1.1
//===== Compatible With: ===================================== 
//= rAthena Project
//===== Description: ========================================= 
// Simple item trade-in quest, a person can get a Dead Branch
// by simply providing the items: Log x3 (7201), Wooden Heart x1 (7189), 
// Trunk x5 (1019), and Wooden Gnarl x1 (7222).
//===== Additional Comments: ================================= 
//= 1.1 Optimized, added Bloody Branch with 0.01% chance [Lupus]
//============================================================

niflheim,204,179,3	script	Mister Mobry	121,{

	mes "[莫布里先生]";
	mes "树木拥有灵魂，你知道吗……";
	next;

	mes "[莫布里先生]";
	mes "事实上，我知道一个关于这些灵魂的秘密，也许……能在某种程度上帮助你……";
	next;

	mes "[莫布里先生]";
	mes "我可以制作一根有灵性的树枝……只要你能提供正确的材料……";
	next;
	goto L_MENU;

L_MENU:
	menu "我需要什么？",-,"在哪里能找到这些破烂？",M_FIND,"给我制作死亡树枝！",M_CREATE,"算了……",M_END;

	mes "[莫布里先生]";
	mes "嘿嘿嘿……我看你是想控制树木的灵魂，对吧？好吧……我需要：";
	mes "^1354453原木^000000";
	mes "^1354451木心^000000";
	mes "^1354455树干^000000";
	mes "^1354451木节^000000";
	next;
	goto L_MENU;

M_FIND:
	mes "[莫布里先生]";
	mes "你可以从某些怪物身上找到以下物品，嘿嘿……";
	mes "^135445原木可以从树精身上找到。^000000";
	mes "^135445木心是树精的精华。^000000";
	mes "^135445树干？认真的吗，想想木头……^000000";
	mes "^135445木节……绞刑台附近就有……^000000";
	next;
	goto L_MENU;

L_NOLOG:
	mes "[莫布里先生]";
	mes "^135445原木^000000是树枝的主体……我还需要更多。";
	mes "给我三根原木，我就为你制作灵魂……";
	close;

L_NOHEART:
	mes "[莫布里先生]";
	mes "^135445木心^000000是灵魂的精华。";
	mes "给我一颗木心，我就为你制作灵魂……";
	close;

L_NOTRUNK:
	mes "[莫布里先生]";
	mes "什么？你连^1354455根树干^000000都找不到？";
	mes "去杀老树精之类的吧……真是的……连树干都没有，真可怜。";
	close;

L_NOGNARL:
	mes "[莫布里先生]";
	mes "没有^135445木节^000000，叫我怎么制作？";
	mes "我说了绞刑台……这里到处都是……";
	close;

M_CREATE:
	mes "[莫布里先生]";
	mes "好吧……让我看看你带来了什么……";
	next;
	if(countitem(7201)<3) goto L_NOLOG;
	if(countitem(7189)<1) goto L_NOHEART;
	if(countitem(1019)<5) goto L_NOTRUNK;
	if(countitem(7222)<1) goto L_NOGNARL;
	delitem 7201,3;
	delitem 7189,1;
	delitem 1019,5;
	delitem 7222,1;
	mes "[莫布里先生]";
	mes "嘿嘿……希望你能和树木的灵魂玩得开心……现在小心点……";
	mes "嘿嘿……小心点？你死不死关我什么事……算了。";
	if(rand(1000)==0) goto L_GIVE2;
	getitem 604,1; //Dead Branch
	close;
L_GIVE2:
	getitem 12103,1; //Bloody Branch
	close;

M_END:
	mes "[莫布里先生]";
	mes "不给你灵魂……那就走吧！";
	close;
}

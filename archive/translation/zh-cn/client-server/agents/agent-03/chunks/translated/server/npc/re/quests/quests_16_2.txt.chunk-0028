// twin quests
rebel_in,105,54,5	script	Ilya Lebedev#16.2rm	4_M_ILYA,{
	if (lebedev_quest_16_2 < 11) {
		switch( rand(4) ) {
		case 0:
			mes "银发男孩看了我一眼。他皱眉并转过头。";
			next;
			mes "[Ilya Lebedev]";
			mes "......";
			next;
			mes "即使你和他说话，他也完全不听。";
			mes "看来和女孩说话更容易。";
			close;
		case 1:
			mes "[Ilya Lebedev]";
			mes ".........";
			next;
			mes "[Ilya Lebedev]";
			mes ".....................";
			next;
			mes "[Ilya Lebedev]";
			mes "...................................................";
			next;
			mes "他抿紧嘴唇看着我。";
			mes "看来和女孩说话更容易。";
			close;
		case 2:
			mes "[Ilya Lebedev]";
			mes "……别和 Jana 说话。";
			next;
			mes "[Ilya Lebedev]";
			mes "......";
			next;
			mes "[Ilya Lebedev]";
			mes "也别和我说话。";
			next;
			mes "他带着固执的表情抿紧嘴唇……";
			mes "看来和女孩说话更容易。";
			close;
		case 3:
			mes "[Ilya Lebedev]";
			mes "Jana……你连呼吸的样子都很可爱……";
			next;
			mes "[Ilya Lebedev]";
			mes "……？！！！";
			mes "你为什么偷听我？";
			next;
			mes "他非常生气。但明明是他自己大声说的……";
			mes "看来和女孩说话更容易。";
			close;
		}
	}
	switch( rand(4) ) {
	case 0:
		mes "[Ilya Lebedev]";
		mes "冒险者，你能问问 Jana 吗？";
		next;
		mes "[Ilya Lebedev]";
		mes "我是说……她有多喜欢哥哥……";
		next;
		mes "[Jana Levedeva]";
		mes "Ilya，我听到了。";
		next;
		mes "[Ilya Lebedev]";
		mes "天啊！不，不……我只是……！！";
		close;
	case 1:
		mes "[Ilya Lebedev]";
		mes "我和 Jana 一起做了饼干。昨天一起读了书。明天要一起探索死矿……";
		next;
		mes "Ilya Lebedev 兴奋地夸耀着发生的事情。";
		close;
	case 2:
		mes "[Ilya Lebedev]";
		mes "我想让她叫我的名字，Ilya……";
		next;
		mes "[Ilya Lebedev]";
		mes "我是说……让 Jana 叫，不是你。";
		next;
		mes "[Ilya Lebedev]";
		mes "有时我希望她叫我“哥哥”……";
		next;
		mes "[Ilya Lebedev]";
		mes "Jana 称呼你为" + ( Sex ? "哥哥" : "姐姐" ) + "。那她为什么叫我 Ilya……？！";
		close;
	case 3:
		mes "[Ilya Lebedev]";
		mes "射击？我喜欢。但这不是我练习射击的唯一原因。";
		next;
		mes "[Ilya Lebedev]";
		mes "因为我必须保护 Jana。谁敢碰 Jana，我就射谁。";
		next;
		mes "Ilya Lebedev 看起来非常兴奋。";
		close;
	}
}

rebel_in,109,54,3	script	Jana Levedeva#16.2rm	4_F_ANYA,{
	if (lebedev_quest_16_2 == 0) {
		mes "[Jana Levedeva]";
		mes "我不想被当作孩子。";
		mes "别摸我的头。";
		next;
		mes "[Jana Levedeva]";
		mes "只有 Ilya 能叫我 Jana。";
		mes "叫我 Lebedeva。";
		close;
	}
	if (lebedev_quest_16_2 == 1) {
		mes "[Jana Levedeva]";
		mes "……你是谁？";
		mes "你看起来不像叛乱军。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "你说得对。我是冒险者。";
		next;
		mes "[Ilya Lebedev]";
		mes "冒险者怎么会来到这里？";
		next;
			npctalk "Jana Levedeva：哦，你是……", "", bc_self;
		mes "[Jana Levedeva]";
		mes "你就是击败我们指挥官的冒险者？";
		mes "所以你就是秘密之翼的人，对吧？";
		next;
		mes "[Jana Levedeva]";
		mes "呵呵，这里的老人讨厌秘密之翼，但我们不在乎。";
		mes "既然我们想在任务中奋力战斗，欢迎你的提议。";
		next;
			npctalk "Ilya Lebedev：我也是！", "Ilya Lebedev#16.2rm", bc_self;
		mes "[Ilya Lebedev]";
		mes "Jana 喜欢什么，我也喜欢。";
		next;
		mes "[Jana Levedeva]";
		mes "你带来了充满火药味的故事吗？";
		mes "……好吧，反正我们也不能参加任务。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "你们还年轻。";
		next;
		emotion ET_FRET;
		mes "[Jana Levedeva]";
		mes "……我们很快就会成为大人。";
		mes "和这里其他人相比，我们没年轻多少。多活几年有什么区别？";
		next;
		mes "[Jana Levedeva]";
		mes "他们都知道我们的能力比成年人强。";
		mes "如果不是因为一件事……不，算了。";
		next;
		mes "[Jana Levedeva]";
		mes "真烦……";
		mes "Ilya，叫这个冒险者离开。";
		next;
			npctalk "Ilya Lebedev：别担心，Jana。", "Ilya Lebedev#16.2rm", bc_self;
		mes "[Ilya Lebedev]";
		mes "请离开。";
		mes "我们不想再和你说话。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "（看来他们很早就开始讨厌我了……我该怎么办？";
		mes "也许我必须听听^0000CD他们身边的叛乱军^000000怎么说。）";
		erasequest 16012;// Troublesome twin
		setquest 16013;// Testimony: Chef's story
		setquest 16014;// Testimony: Sniper's story
		lebedev_quest_16_2 = 2;
		close;
	}
	if (lebedev_quest_16_2 == 2 || lebedev_quest_16_2 == 3) {
		emotion ET_FRET;
		mes "[Jana Levedeva]";
		mes "啊，Ilya。那个人一直让我烦。";
		next;
		mes "[Ilya Lebedev]";
		mes "请离开。";
		mes "如果你让 Jana 难过，我不会原谅你。";
		close;
	}
	if (lebedev_quest_16_2 == 4) {
		mes "[Jana Levedeva]";
		mes "你又来了？";
		mes "我们不想说话。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "（询问他们过去发生的事件……）";
		next;
		if (select( "直接询问。", "拐弯抹角。" ) == 1) {
			mes "[" + strcharinfo(0) + "]";
			mes "你们在实际任务中把手榴弹扔进平民区了吗？";
			mes "你们为什么这么做？";
			next;
			mes "[Jana Levedeva]";
			mes "什么……！！";
			next;
			npctalk "Ilya Lebedev：……什么，搞什么鬼！", "Ilya Lebedev#16.2rm", bc_self;
			mes "[Ilya Lebedev]";
			mes "你从哪里听说的！";
			mes "嘿，你为什么这么说？";
			next;
			npctalk "Jana Levedeva：嗯，那是……";
			emotion ET_ANGER, getnpcid(0, "Ilya Lebedev#16.2rm");
			mes "[Ilya Lebedev]";
			mes "滚开！离 Jana 远点！";
			emotion ET_SMILE;
			npctalk "Jana Levedeva：我，我……";
			npctalk "Ilya Lebedev：别听，Jaja……！！", "Ilya Lebedev#16.2rm", bc_self;
			next;
			mes "[" + strcharinfo(0) + "]";
			mes "(......Looks like a huge mistake. Let's go back to ^0000CDElena Volkova^000000.)";
		}
		else {
			mes "[" + strcharinfo(0) + "]";
			mes "我有件事想问你们。";
			mes "我问过别人，他们说你们……";
			next;
			mes "[Jana Levedeva]";
			mes "...Why do you pry into our private affairs?";
			next;
			mes "[" + strcharinfo(0) + "]";
			mes "我没有打听什么。我的意思是，他们说你们最近看起来很累……";
			next;
			mes "[Jana Levedeva]";
			mes "我们是因为有人烦我们才累。";
			npctalk "Ilya Lebedev: ......", "Ilya Lebedev#16.2rm", bc_self;
			next;
			mes "[" + strcharinfo(0) + "]";
			mes "(......This is getting difficult. Let's go back to ^0000CDElena Volkova^000000.)";
		}
		setquest 16015;// The cause of failure is a careless attempt
		lebedev_quest_16_2 = 5;
		questinfo_refresh();
		close;
	}
	if (lebedev_quest_16_2 == 5 || lebedev_quest_16_2 == 6) {
		mes "[Jana Levedeva]";
		mes "我们不想和你说话。离开吧。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "(...I guess they really hate me now.)";
		close;
	}
	if (lebedev_quest_16_2 == 7) {
		if (countitem(25161) < 1) {
			mes "[Jana Levedeva]";
			mes "你又来了？";
			next;
			mes "[" + strcharinfo(0) + "]";
			mes "( I did take the cookie... Where is it?";
			mes "回去找 Ericsson 谈谈吧。）";
			close;
		}
		mes "[" + strcharinfo(0) + "]";
		mes "你们好？";
		next;
		mes "[Jana Levedeva]";
		mes "...Do you have so much free time? Why do you keep stalking us?";
		next;
		if (select( "我有件事想告诉你们。", "想吃饼干吗？" ) == 1) {
			mes "[Jana Levedeva]";
			mes "我不想听。";
			mes "除非你付 100 万 Zeny 让我们听你的故事，否则现在离开。";
			close;
		}
		mes "[Jana Levedeva]";
		mes "我不知道你想做什么。但是我们……";
		mes "……等等，你从哪里得到这块饼干的？";
		npctalk "Jana Levedeva：这篮饼干，是 Lucy 老奶奶给的……？", "", bc_self;
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "一个你熟悉的人让我把这个交给你们。";
		next;
		mes "[Ilya Lebedev]";
		mes "……Adler 指挥官？";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "他还让我转告这句话。";
		mes "相信我。如果有问题，就告诉这位冒险者。";
		mes "这是我的请求。你能告诉我吗？";
		next;
		mes "[Jana Levedeva]";
		mes "……什么……";
		mes "那……是谎言。我怎么能相信冒险者……？";
		npctalk "Jana Levedeva：你以为一块饼干就能诱骗我们吗？", "", bc_self;
		npctalk "Ilya Lebedev：Jana……", "Ilya Lebedev#16.2rm", bc_self;
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "就像我之前说的，请想想 Adler 指挥官。";
		mes "他很担心你们。我也是，Volkova 指挥官也是。";
		next;
		mes "[Jana Levedeva]";
		mes "我们……";
		mes "不。我们不会告诉你。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "请告诉我一件事。";
		mes "我听说你们以前没有把自己弄成这样。";
		mes "你们为什么一直伤害自己？";
		next;
		mes "[Jana Levedeva]";
		npctalk "Jana Levedeva：哦……", "", bc_self;
		mes "你为什么这么说？你了解我们什么？";
		mes "你什么都不知道！";
		next;
		mes "[Jana Levedeva]";
		mes "……我当时太……";
		mes "害怕……所以……";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "害怕……？";
		next;
		mes "[Jana Levedeva]";
		mes "然后……我变得失控……";
		mes "所以我害怕……我是故意……这么做的……抽泣。";
		next;
		mes "[Ilya Lebedev]";
		mes "......";
		next;
		mes "[Ilya Lebedev]";
		mes "我相信你知道不久前我们第一次任务中发生了什么。";
		mes "那之后，Jana 过得非常艰难。";
		next;
		mes "[Ilya Lebedev]";
		mes "因为 Jana 和我原本非常自信，觉得能做得很好。";
		mes "但事情发生了……我们……非常痛苦。";
		next;
		mes "[Jana Levedeva]";
		mes "抽泣。我们不是故意扔手榴弹，也一点都不享受。是我们的错。但是，但是……";
		next;
		mes "[Jana Levedeva]";
		mes "我们受到惩罚并被调到 USU……然后觉得所有人都把我们当成坏孩子。";
		npctalk "Jana Levedeva：其实，我们听到有人这么说。甚至有些不认识我们的人也这么说。", "", bc_self;
		next;
		mes "[Ilya Lebedev]";
		mes "我们想和 Ericsson 指挥官谈谈。但我们不能，因为被分配到了其他部队。";
		next;
		mes "[Jana Levedeva]";
		mes "我们不知道该怎么办。只想逃跑。因为所有人都责怪我们，对我们失望……";
		mes "但我们喜欢自己的部队和 Ericsson 指挥官……";
		next;
		mes "[Jana Levedeva]";
		mes "我们以为自己已经毁了一切。";
		mes "既然所有人都已经对我们失望，我们觉得可以随便做什么……";
		npctalk "Ilya Lebedev：所以我们以为很快就会被遣散，便随心所欲地行动。", "Ilya Lebedev#16.2rm", bc_self;
		next;
		mes "[Jana Levedeva]";
		mes "我们随心所欲，事情变得越来越糟……所以我们害怕了……";
		mes "然后我们开始相信自己是最糟糕、最无可救药的孩子……";
		npctalk "Ilya Lebedev：所以我们以为自己又会被抛下……", "Ilya Lebedev#16.2rm", bc_self;
		next;
		mes "[Ilya Lebedev]";
		mes "说没人阻止我们只是借口……";
		mes "很抱歉给你添麻烦……";
		next;
		mes "[Jana Levedeva]";
		mes "我……也很抱歉……";
		npctalk "Ilya Lebedev：还有，谢谢你……", "Ilya Lebedev#16.2rm", bc_self;
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "原来是这样……现在我知道你们受了很多苦。";
		mes "我可以把这些告诉你们的指挥官吗？";
		mes "当然不会告诉其他人。";
		next;
		npctalk "Ilya Lebedev：好的，拜托了。", "Ilya Lebedev#16.2rm", bc_self;
		npctalk "Jana Levedeva：好的……", "", bc_self;
		mes "[" + strcharinfo(0) + "]";
		mes "（你听完了他们的故事。去找 ^0000CDElena Volkova^000000 告诉她吧。）";
		lebedev_quest_16_2 = 8;
		delitem 25161,1;// Handmade_cookie2
		erasequest 16033;// Bring dessert and listen the story
		setquest 16017;// Twin's sincere confession
		close;
	}
	if (lebedev_quest_16_2 == 8) {
		mes "[Jana Levedeva]";
		mes "......";
		mes "我们会被责骂……";
		mes "但我们别无选择。这是我们的错。请向指挥官报告。";
		npctalk "Jana Levedeva：如果她让我们离开这个部队怎么办……？", "", bc_self;
		close;
	}
	if (lebedev_quest_16_2 == 9) {
		mes "[Jana Levedeva]";
		mes "USU 指挥官的来电？";

	end;

OnTimer5415000:
	mapannounce "moc_fild21","我没时间管这个！走开！",bc_map,"0xFFFF00";
	donpcevent "Satan Summon#edq::OnDisable";
	end;
}

sec_in02,14,43,5	script	Morocc GlobalVar Admin::MoroccAdmin_sec	971,{
	callfunc "F_GM_NPC";
	mes "[Helper]";
	mes "请输入密码并按 # 键。";
	next;
	if (callfunc("F_GM_NPC",1854,0) < 1) {
		mes "[Helper]";
		mes "请按下我们总是唱到的数字。";
		close;
	} else {
		mes "[Helper]";
		mes "你好。我是邮局。现在正在检查梦罗克状态。";
		next;
		mes "=============";
		mes "当前状态";
		mes "=============";
		mes "^3131FF<Morocc>^000000";
		if ($@re_moc == 0) {
			mes "已重置。可以召唤梦罗克。";
			mes "^3131FF<Continental Guards>^000000";
			mes "可以进入 moc_fild21 地图。";
		} else if ($@re_moc == 1) {
			mes "^3131FF<Morocc>^000000";
			mes "重置后有战士进入，但尚未开始任务。拥有 rebirth_moc_edq 4 和 7 的战士现在可以召唤梦罗克。";
			mes "^3131FF<Continental Guards>^000000";
			mes "拥有 rebirth_moc_edq 4 ~ 7 的战士现在可以进入 moc_fild21。";
		} else if ($@re_moc == 2) {
			mes "^3131FF<Morocc>^000000";
			mes "梦罗克已被召唤。90 分钟后将恢复为重置状态。";
			mes "^3131FF<Continental Guards>^000000";
			mes "拥有 rebirth_moc_edq 4 ~ 7 的战士现在可以进入 moc_fild21。";
		} else if ($@re_moc == 3) {
			mes "^3131FF<Morocc>^000000";
			mes "梦罗克已被击杀。死亡时间为 "+$@re_moc_time$+"（00 时/00 分/00 秒）。死亡 6 小时后将重置。仍在地图中的战士可以通过时空裂隙继续任务。";
			mes "^3131FF<Continental Guards>^000000";
			mes "已禁止从地图外进入 moc_fild21。";
		} else {
			mes "^3131FF<Morocc>^000000";
			mes "梦罗克已被击杀。死亡时间为 "+$@re_moc_time$+"（00 时/00 分/00 秒）。死亡 6 小时后将重置。梦罗克死亡已超过 30 分钟，即使点击时空裂隙，战士也无法继续任务。";
			mes "^3131FF<Continental Guards>^000000";
			mes "已禁止从地图外进入 moc_fild21。";
		}
		next;
		mes "[Helper]";
		mes "你想做什么？";
		next;
		switch(select("取消。:重置")) {
		case 1:
			mes "[Helper]";
			mes "好。";
			close;
		case 2:
			if (strnpcinfo(4) == "sec_in02")
			mes "你可以在 moc_fild21 5 5 重置。";
			else {
			mes "开始重置。";
				next;
				donpcevent "Group of Evil#edq::OnEnable";
			mes "邪恶团体 NPC 出现。时空裂隙 NPC 消失。";
			mes "6 小时期限计时器已停止。";
				donpcevent "Satan Summon#edq::OnDisable";
			mes "梦罗克 90 分钟存活计时器停止。梦罗克正在被击杀。现在大陆卫兵会让玩家进入。";
			}
			close;
		}
	}
}
moc_fild21,5,5,5	duplicate(MoroccAdmin_sec)	Morocc GlobalVar Admin::MoroccAdmin_moc	971

// The Crow of the Fate
// ============================================================
moc_ruins,137,70,3	script	Book-Touching Man#garas	48,{
	if (BaseLevel > 59) {
		if (checkweight(703,3) == 0) {
			mes "- 你的物品栏中物品太多，无法继续任务。-";
			close;
		}
		if (barmunt_crow == 0) {
			mes "^660000沙漠之城梦罗克已经被撒旦梦罗克彻底摧毁。^000000";
			next;
			mes "^660000梦罗克居民足以忍受当地恶劣天气，但即使如此，他们也无法承受亲眼目睹撒旦梦罗克给城市带来的毁灭。^000000";
			next;
			mes "^660000这个男人像在阳光下晒干的鱼一样干瘦，脸上却带着让你想起仁慈之神的笑容，手里还抚摸着一本书。^000000";
			next;
			mes "^660000看着他让你忍不住发笑。他看起来不比金字塔里的干尸好多少，但显然还活着，也不像魔物。不知为何，你被吸引着走近这个有趣的男人。^000000";
			next;
			emotion ET_THROB;
			mes "[Book-Touching Man]";
		mes "啊……Mammi……";
			next;
			mes "[Book-Touching Man]";
		mes "你健康的金色肌肤在梦罗克受祝福的阳光下熠熠生辉。";
			next;
			emotion ET_CRY;
			mes "[Book-Touching Man]";
		mes "你的笑容胜过英灵殿诸神的光辉。你就是活生生的福音，甚至让芙蕾雅女神羞愧地躲进阴影！啊……Mammi，我的 Mammi！";
			next;
			mes "^660000你在他脸旁挥手想引起注意，但他似乎沉浸在自己的梦中，完全没有察觉你的存在。^000000";
			next;
			switch(select("交谈:路过")) {
			case 1:
				mes "["+ strcharinfo(0) +"]";
				mes "你在自言自语吗？";
				next;
				emotion ET_HUK;
				mes "[Book-Touching Man]";
				mes "哇！天啊，你一定是想打断我感受 Mammi 的恶魔使者！我不怕你，放马过来！";
				next;
			mes "^660000他被你的声音吓到并冲你大喊，看起来十分奇怪。";
				mes "他明明只是在看书、摸书，你却不明白他所说的‘感受她’是什么意思。^000000";
				next;
				mes "["+ strcharinfo(0) +"]";
			mes "Mammi 是谁？";
				next;
				emotion ET_HUK;
				mes "[Book-Touching Man]";
			mes "什么？你不知道 Mammi？她可是卢恩-米德加尔特三大偶像之一！";
				next;
				emotion ET_OHNO;
				mes "[Book-Touching Man]";
			mes "你什么都不知道，对吧？！看你脸上的傻样，我猜你是个为别人跑腿、到处做无聊任务的冒险者。嘿嘿！";
				next;
			mes "^660000嗯……你现在后悔一开始和他说话了。^000000";
				next;
				mes "[Book-Touching Man]";
			mes "我的 Mammi 和那些只靠外表、没有内涵的明星不同。她日程再忙也总带着书，仅此就说明她比其他人聪明！啊……Mammi……";
				next;
				mes "[Book-Touching Man]";
			mes "她甚至在《梦罗克时报》的采访中说，想遇到一个爱书的男人。";
				next;
				emotion ET_COOL;
				mes "[Book-Touching Man]";
			mes "这意味着……她在等像我这样的人。嘿嘿嘿！你看，卢恩-米德加尔特图书馆的每本书上都有 Benjamin 的名字……那就是我！";
				next;
			mes "^660000这个 Benjamin 似乎是名叫 Mammi 的女明星的狂热粉丝。他不停夸赞并崇拜她的美貌，但突然停下来，显得很沮丧。^000000";
				next;
				mes "[Benjamin]";
				mes "我遇到一个问题……";
				next;
				mes "[Benjamin]";
				mes "我的 Mammi 说她爱上了施瓦茨瓦尔德的 ^FF0000‘Oliver Hilpert’^000000 写的书：^FF0000《命运之鸦》^000000，但我连看一眼的机会都没有！";
				next;
			mes "^660000《命运之鸦》^000000？";
				next;
				mes "[Benjamin]";
				mes "除非你是瞎子，否则你知道现在的梦罗克有多糟。";
				next;
				mes "[Benjamin]";
				mes "我得读那本书，告诉她我一直支持她，但眼下的局势让我连喘息的时间都没有！";
				next;
				emotion ET_CRY;
				mes "[Benjamin]";
				mes "我的 Mammi 枕套被埋在瓦砾下……喘不过气了！Mammi，我来了！你可别死啊！";
				next;
			mes "^660000他仿佛看到了 Mammi 的身影，焦急地喘息着喊她的名字。你为他的痛苦感到难过。^000000";
				next;
			mes "^660000他深吸一口气，然后突然转头看向你。^000000";
				next;
				emotion ET_AHA;
				mes "[Benjamin]";
				mes "....Ye... Yes, you!";
				next;
				mes "["+ strcharinfo(0) +"]";
				mes "嗯？";
				emotion ET_PROFUSELY_SWEAT, playerattached();
				next;
				mes "[Benjamin]";
				mes "你看起来很无聊，一定在等别人给你找事做！帮我联系 Mammi。谁知道呢？我也许会让你和卢恩-米德加尔特人人喜爱的 Mammi 交谈。";
				next;
			mes "^660000你刚才不是还说我是替别人到处跑腿、做无聊任务的冒险者吗……？^000000";
				next;
				mes "[Benjamin]";
				mes "我只要求你替我从普隆德拉图书馆借一本书。听起来很简单，对吧？你看起来不像爱读书的人，但至少应该知道怎么从图书馆借书。";
				next;
				if (Sex == SEX_MALE) {
					mes "[Benjamin]";
					mes "如果你帮我，我会给你看一次 Mammi 的限量画册……嘿嘿嘿。怎么样？你愿意帮忙吧？";
					next;
				}
				else {
					mes "[Benjamin]";
					mes "如果你帮我，我会给你看一次 Mammi 的限量画册……嘿嘿嘿。你不想看看其他女孩的照片吗？呃，如果你愿意，我可以介绍梦罗克的帅气卫兵给你……怎么样？你愿意帮忙吧？";
					next;
				}
				mes "^660000What do you want to do?^000000";
				next;
					switch(select("帮助他:不帮助他")) {
				case 1:
					mes "[Benjamin]";
					mes "哇，你真的要帮我吗？";
					next;
					mes "[Benjamin]";
					mes "太感谢了！记住书名：《命运之鸦》，作者是 Oliver Hilpert。我相信你能在普隆德拉图书馆找到。嘿嘿，Mammi！我快成功了！";
					set barmunt_crow,1;
					setquest 2063;
					close;
				case 2:
					mes "[Benjamin]";
					mes "什么，你不知道怎么从图书馆借书？天啊……";
					close;
				}
			case 2:
				mes "[Benjamin]";
				mes "哦……Mammi……我的 Mammi……";
				close;
			}
		}
		else if (barmunt_crow == 1) {
			mes "[Benjamin]";
			mes "别忘了书名：《命运之鸦》，作者是 Oliver Hilpert。我相信你能在普隆德拉图书馆找到。";
			close;
		}
		else if (barmunt_crow == 10) {
			mes "[Benjamin]";
			mes "哦……Mammi……我的 Mammi……";
			next;
			mes "^660000就像上次见到他时一样，Benjamin 仍活在自己的梦里，把书在脸上摩擦。^000000";
			next;
			mes "^660000你小心地走近他，然后拍了拍他的肩膀。^000000";
			next;
			emotion ET_HUK;
			mes "[Benjamin]";
			mes "嗷！谁敢碰我？！";
			next;
			mes "^660000……嗯……显然你还不够小心……^000000";
			next;
			mes "[Benjamin]";
			mes "谁敢打断我感受 Mammi？你想挨揍吗……呃？天啊，是你。怎么花了这么久？普隆德拉图书馆不是只要五分钟吗？";
			next;
			mes "["+ strcharinfo(0) +"]";
			mes "阿嚏！都怪你，我没能在图书馆找到它。所以我一路跑到施瓦茨瓦尔德……阿嚏！";
			specialeffect2 EF_VENOMDUST;
			next;
			mes "^660000你对他感到生气，于是夸张地连续打了一阵喷嚏。^000000";
			next;
			mes "[Benjamin]";
			mes "哦……你找到了？嘿嘿，你比我想的可靠。谢谢你带来这本书……等等，难道我得去施瓦茨瓦尔德归还它？真麻烦！";
			next;
			mes "[Benjamin]";
			mes "……不，只要是为了 Mammi，我什么都能做。嘿嘿，你真是善良的冒险者。谢谢。";
			mes "那里冷吗？施瓦茨瓦尔德在北方，想必很冷。";
			next;
			mes "["+ strcharinfo(0) +"]";
			mes "..................";
			next;
			mes "[Benjamin]";
			mes "让我想想。如果这本书在普隆德拉图书馆还没有，说明卢恩-米德加尔特没多少人读过它。";
			next;
			mes "[Benjamin]";
			mes "嗷……Mammi！我来了，遵循你高雅的品味阅读如此罕见的书！Mammi……！";
			emotion ET_BIGTHROB;
			next;
			mes "[Benjamin]";
			mes "想到能和 Mammi 深入讨论文学，我就兴奋不已！太好了！我得马上读这本书。嘿嘿！";
			emotion ET_DELIGHT;
			next;
			mes "[Benjamin]";
			mes "哎呀，我不能忘记报答你。我可是个有礼貌的人。";
			next;
			mes "[Benjamin]";
			mes "看，这就是我告诉你的 Mammi 画册。";
			next;
			cutin "mami01",4;
			mes "[Benjamin]";
			mes "啊……看她戴着卷起的狗狗耳朵！她独自在爱之城科莫多徘徊，像只悲伤的小狗，不是吗？！看了这张悲伤的照片，谁能不流泪？！啊，Mammi！我要让你成为世界上最幸福的女人！";
			next;
			cutin "mami02",4;
			mes "["+ strcharinfo(0) +"]";
			mes "'She looks different than I thought with these glasses and pony tails... She really looks like someone who loves literature.";
			mes "等等，人们什么时候开始叫科莫多‘爱之城’了？嗯……这家伙的想法真奇怪！";
			next;
			mes "[Benjamin]";
			mes "我决定把这本充满她美丽照片的《天使 Mammi 特别画册：科莫多篇》送给你，以答谢你的帮助。咳……你觉得呢？";
			next;
			mes "^660000He is staring at you arrogantly. Obviously, he doesn't care if you like the book or not.^000000";
			next;
			switch(select("我收下。:不用了，谢谢。")) {
			case 1:
				mes "'^660000Well, if it's for free, and there's no harm keeping it.'^000000";
				next;
				break;
			case 2:
				mes "["+ strcharinfo(0) +"]";
				mes "不用了，谢谢。我不像你那么迷恋她。";
				next;
				mes "...^660000Was what you were about to say, but you could not refuse his offer. Looking at his fanatical eyes, burning with love for her, even Odin could not refuse...^000000";
				next;
				break;
			}
			mes "^660000Quickly blinking his eyes, he made you take Mammi's picture book in your arms";
			mes "要求你把画册装入保护套，以免损坏。^000000";
			set barmunt_crow,11;
			getitem 7795,1; //Mami_Photo_Album
			next;
			mes "[Benjamin]";
			mes "哦，对了。如果你对作者 Oliver Hilpert 感兴趣，我建议你阅读《命运之鸦》的前传 ^3131FF《命运的轨迹》^000000以及续篇。";
			next;
			mes "[Benjamin]";
			mes "那也是一本畅销书。";
			next;
			mes "[Benjamin]";
			mes "我得开始读这本书，为见 Mammi 做准备，所以请别打扰我。";
			next;
			mes "^660000As soon as he finished, he returned to escaping reality by indulging himself in his dreams of Mammi.^000000";
			next;
			mes "^660000The Trace of the Fate, huh?";
			mes "嗯，我也没别的事可做。也许该读读这本书……^000000";
			next;
			mes "["+ strcharinfo(0) +"]";
			mes "等等，难道我得回朱诺图书馆吗？";
			next;
			mes "^660000Thinking of travelling back to Juno made you sigh in frustration.^000000";
			changequest 2067,2068;
			close2;
			cutin "",255;
			end;
		}
		else if (barmunt_crow == 11) {
			mes "^660000You have embarked on a journey to Juno to read the prequel of <The Crow of the Fate>: <The Trace of the Fate>.^000000";
			close;
		}
		else if (barmunt_crow == 15) {
			if ((countitem(7797) == 1) && (countitem(7796) == 1)) {
				mes "["+ strcharinfo(0) +"]";
				mes "嘿，Benjamin！我有件能帮你赢得 Mammi 好感的完美东西。想看看吗？";
				next;
				mes "[Benjamin]";
				mes "什、什么？！那是什么？给我看看！？";
				next;
				mes "^660000You have shown him an autograph and a written note by Oliver Hilpert.^000000";
				next;
				mes "[Benjamin]";
				mes "天啊！这些一定能帮我接近 Mammi！给我！";
				next;
				switch(select("给他:不给")) {
				case 1:
					mes "[Benjamin]";
					mes "哦，"+ strcharinfo(0) +"！你最好了！谢谢！";
					next;
					mes "[Benjamin]";
					mes "Mammmii！";
					mes "明天天一亮我就去见她！Mammi，我来了！";
					delitem 7797,1; //Author_Memo
					delitem 7796,1; //Author_Autograph
					set barmunt_crow,16;
					if (checkre(3))
						getexp 90000,90000;
					else
						getexp 900000,900000;
					close;
				case 2:
					mes "[Benjamin]";
					mes "嗯？什么，你在开玩笑吗？";
					close;
				}
			}
			else {
				mes "[Benjamin]";
				mes "哦……Mammi……哦……";
				close;
			}
		}
		else {
			mes "[Benjamin]";
			mes "哦……Mammi……哦……";
			close;
		}
	}
	else {
		mes "那个男人眼神迷离，低头看着手中的书。";
		close;
	}
}

prt_in,179,92,3	script	Library Curator#garas	57,{
	if (barmunt_crow == 0) {
		mes "[Curator Guys]";
		mes "本馆的《魔物百科》按地下城分类收录卢恩-米德加尔特王国的所有魔物，方便读者查找。我们还有许多冒险者必备书籍。要看看吗？";
		next;
		mes "[Curator Guys]";
		mes "街对面的另一座图书馆也有《魔物百科》。感兴趣的话，也可以去那里看看。";
		close;
	}
	else if (barmunt_crow == 1) {
		mes "[Curator Guys]";
		mes "本馆的《魔物百科》按地下城分类收录卢恩-米德加尔特王国的所有魔物，方便读者查找。我们还有许多冒险者必备书籍。要看看吗？";
		next;
		switch(select("搜索书籍。:在图书馆里看看。")) {
		case 1:
			mes "[Curator Guys]";
			mes "你想找某本特定的书吗？没问题，我来帮你。你要找哪类书？";
			next;
			switch(select("说出书名。:说出作者。:按关键词搜索。")) {
			case 1:
				mes "[Curator Guys]";
				mes "哦，你知道书名吗？好，现在告诉我名字。";
				input .@input$;
				next;
				if (compare(.@input$,"The Crow of the Fate") == 1) {
					mes "[Curator Guys]";
					mes ""+.@input$+"...?";
					mes "好，让我看看……";
					next;
				}
				else {
					mes "[Curator Guys]";
					mes "嗯……抱歉。我在这里工作了几十年，但似乎从没见过这样的书。";
					close;
				}
				break;
			case 2:
				mes "[Curator Guys]";
				mes "哦，你知道作者吗？好，现在告诉我名字。";
				input .@input$;
				next;
				if (compare(.@input$,"Oliver Hilpert") == 1) {

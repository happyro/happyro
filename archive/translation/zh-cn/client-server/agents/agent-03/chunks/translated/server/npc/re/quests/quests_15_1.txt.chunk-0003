		mes "别让他惹你生气。";
		ep15_1_atnad = 6;
		close3;
	case 6:
	case 7:
		cutin "verus_aures.bmp",0;
		mes "[Aures]";
		mes "谢谢你耐心应对 Ian。";
		mes "他以前不是这样的。";
		mes "他是故意这样做的。";
		close3;
	case 8:
		cutin "verus_aures.bmp",0;
		mes "[Aures]";
		mes "如果你和他谈完了，我需要你的帮助。";
		mes "队伍里还有一名成员。";
		next;
		mes "[Aures]";
		mes "他去了广场调查遗迹。";
		mes "他是个叫^4d4dffLloyd^000000的年轻人。";
		mes "我派 Luke 和他一起去保护他，";
		next;
		mes "[Aures]";
		mes "但我想知道 Lloyd 的调查进展如何。";
		mes "你能去看看他吗？";
		mes "谢谢。";
		completequest 7619;// Assisting the Excavation Team
		setquest 7620;// Young Blood?
		ep15_1_atnad = 9;
		close3;
	case 9:
		cutin "verus_aures.bmp",0;
		mes "[Aures]";
		mes "Lloyd 应该在维鲁斯中央广场的某处。";
		mes "找找 Luke。他应该在 Lloyd 附近。";
		next;
		mes "[Aures]";
		mes "除了你，他是队伍里唯一的年轻成员。";
		mes "我们队伍的其他成员都和我一样年纪大，无法前往。";
		next;
		mes "[Aures]";
		mes "请好好照顾";
		mes "Lloyd。";
		close3;
	case 10:
		cutin "verus_aures.bmp",0;
		mes "[Aures]";
		mes "Lloyd 怎么样？";
		mes "啊，原来你在帮助他。";
		next;
		mes "[Aures]";
		mes "谢谢你";
		mes "感谢你的努力。";
		next;
		cutin "verus_ian01.bmp",2;
		mes "[Ian Atnad]";
		mes "他们是来为我们工作的。";
		mes "别再感谢他们了。";
		mes "他们已经够娇气了。";
		next;
		cutin "verus_aures.bmp",0;
		mes "[Aures]";
		mes "唉，你能停下吗？";
		mes "*摇头*";
		close3;
	case 11:
		cutin "verus_aures.bmp",0;
		mes "[Aures]";
		mes "啊，你回来了。";
		mes "Lloyd 怎么样？";
		mes "他想在那里露营。";
		mes "不会太危险吗？我想 Luke 能保护他。";
		next;
		mes "[Aures]";
		mes "请这边走。";
		mes "我等你的时候写了一份报告。";
		mes "我想让你把它带给中央指挥中心的 Louis 指挥官。";
		next;
		mes "[Aures]";
		mes "这也许只是跑腿，";
		mes "但能给你一个认识指挥官的机会。";
		next;
		mes "[Aures]";
		mes "我们年纪大了，不在乎名声。你不一样。";
		mes "赢得雷根贝勒的好感";
		mes "会带来很大帮助。";
		erasequest 7622;// Good News!
		setquest 7617;// Turning In Excavation Report
		ep15_1_atnad = 12;
		getitem 6748,1;// Excavator_Repoet
		close3;
	case 12:
		cutin "verus_aures.bmp",0;
		mes "[Aures]";
		mes "请把报告带给 Louis 指挥官。";
		mes "每天写报告很麻烦，但仍然很重要。";
		next;
		mes "[Aures]";
		mes "我注意到 Louis 一直在观察我们。希望这是个好兆头。";
		close3;
	case 13:
		cutin "verus_aures.bmp",0;
		mes "[Aures]";
		mes "你把报告送到了吗？";
		mes "很好。";
		mes "现在可以休息了。";
		next;
		cutin "verus_ian01.bmp",2;
		mes "[Ian Atnad]";
		mes "不，你不能！";
		mes "你还有工作要做！";
		mes "现在过来！";
		close3;
	case 14:
		cutin "verus_aures.bmp",0;
		mes "[Aures]";
		mes "我有时真的无法理解他。";
		mes "我很同情你。";
		mes "真希望我能帮忙。";
		next;
		mes "[Aures]";
		mes "也许其他年轻人能给你更好的建议。";
		mes "^4d4dff不如去咨询 Lloyd 或 Luke？^000000";
		next;
		mes "[Aures]";
		mes "唉，他固执得像头骡子。";
		next;
		cutin "verus_ian01.bmp",2;
		mes "[Ian Atnad]";
		mes "我听到了。";
		next;
		cutin "verus_aures.bmp",0;
		mes "[Aures]";
		mes "那就停下";
		mes "别再骚扰他们。";
		mes "伊甸园集团知道这件事后不会高兴。";
		next;
		cutin "verus_ian01.bmp",2;
		mes "[Ian Atnad]";
		mes "伊甸园集团？*哼* 谁在乎？";
		next;
		cutin "verus_aures.bmp",0;
		mes "[Aures]";
		mes "你真没救。";
		mes "我真的、真的很抱歉。";
		mes "你真的应该和那两个人谈谈。";
		close3;
	case 15:
	case 16:
		cutin "verus_aures.bmp",0;
		mes "[Aures]";
		mes "所以你找到一些线索了，是吗？";
		mes "嗯，连我都兴奋起来了。";
		close3;
	default:
		switch( checkquest(7618,PLAYTIME) ) {
		case -1:
			if (isbegin_quest(7617) == 1) {
				cutin "verus_aures.bmp",0;
				mes "[Aures]";
				mes "请把报告带给 Louis 指挥官。";
				mes "每天写报告很麻烦，但仍然很重要。";
				next;
				mes "[Aures]";
				mes "我注意到 Louis 一直在观察我们。希望这是个好兆头。";
				close3;
			}
			if ((checkquest(7616,PLAYTIME) == 0 || checkquest(7616,PLAYTIME) == 1) && (checkquest(7629,PLAYTIME) == 0 || checkquest(7629,PLAYTIME) == 1)) {
				cutin "verus_aures.bmp",0;
				mes "[Aures]";
				mes "你回来得正是时候。";
				mes "利用你带来的电力控制装置，我的研究有了进展。";
				next;
				mes "[Aures]";
				mes "我刚写完关于它的报告";
				mes "以及 Lloyd 正在研究的能源。";
				next;
				mes "[Aures]";
				mes "这是报告。";
				mes "请^4d4dff把它带给 Louis";
				mes "到指挥中心^000000。";
				setquest 7617;// Turning In Excavation Report
				getitem 6748,1;// Excavator_Repoet
				close3;
			}
			cutin "verus_aures.bmp",0;
			mes "[Aures]";
			mes "Ian 正在研究电力控制装置。";
			mes "Lloyd 正在研究装置的能源供应。";
			next;
			mes "[Aures]";
			mes "那么整理文件这种琐碎工作就留给我了。";
			mes "你能帮帮他们两个吗？";
			next;
			mes "[Aures]";
			mes "越快收集到研究材料，我们就能越快提交报告。";
			close3;
		case 0:
		case 1:
			cutin "verus_aures.bmp",0;
			mes "[Aures]";
			mes "你把报告送到了吗？";
			mes "这也许只是跑腿，";
			mes "但能给你一个认识指挥官的机会。";
			next;
			mes "[Aures]";
			mes "我们年纪大了，不在乎名声。你不一样。";
			mes "赢得雷根贝勒的好感会带来很大帮助。";
			next;
			mes "[Aures]";
			mes "所以今后由你来提交报告吧。";
			close3;
		case 2:
			erasequest 7618;// Reporting the Results - Down
			mes "[Aures]";
			mes "又该写一份报告了。";
			mes "研究完电力控制装置后我会写。";
			close3;
		}
	}
	end;

OnInit:
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "isbegin_quest(7619) == 0" );
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "isbegin_quest(7617) == 0 && isbegin_quest(7618) == 0 && (checkquest(7616,PLAYTIME) == 0 || checkquest(7616,PLAYTIME) == 1) && (checkquest(7629,PLAYTIME) == 0 || checkquest(7629,PLAYTIME) == 1)" );
	end;
}

verus04,144,193,3	script	Ian Atnad#ep152	4_M_IAN,{
	if (checkweight(1301,3) == 0) {
		mes "- 你携带的物品太多，无法继续任务。-";
		close;
	}
	mes "[Ian Atnad]";
	switch(ep15_1_atnad) {
	case 0:
	case 1:
	case 2:
	case 3:
	case 4:
		cutin "verus_ian01.bmp",2;
		mes "……这让人分心。";
		close3;
	case 5:
		cutin "verus_ian01.bmp",2;
		mes "你一直在这里偷懒做什么？";
		mes "这家伙到底是谁？";
		next;
		cutin "verus_aures.bmp",0;
		mes "[Aures]";
		mes "Ian，你为什么这样？";
		mes "这位年轻冒险者是伊甸园集团派来的。";
		mes "他是来帮助我们的。";
		next;
		cutin "verus_ian01.bmp",2;
		mes "[Ian Atnad]";
		mes "..Hm... Rookie.";
		mes "我不需要这种帮助，把他送回去！";
		next;
		cutin "verus_aures.bmp",0;
		mes "[Aures]";
		mes "看来他又这样了……";
		mes "你觉得一群老人能轻松完成这项任务吗？";
		mes "偶尔别这么固执。";
		next;
		cutin "verus_ian03.bmp",2;
		mes "[Ian Atnad]";
		mes "..Hey, Rookie.";
		mes "你是奉我女儿的命令来监视我的吗？";
		mes "是这样吗？";
		next;
		if (select( "只是来帮忙。", "我还是第一次听说。" ) == 2) {
			cutin "verus_ian02.bmp",2;
			mes "[Ian Atnad]";
			mes "嗯？你没听说过我女儿？";
			mes "那我就不必提这些闲话了。";
		}
		next;
		cutin "verus_ian01.bmp",2;
		mes "[Ian Atnad]";
		mes "……所以你知道我和女儿的关系？";
		mes "所以你打算保持沉默，只做自己的工作？";
		mes "你不想卷入其中？";
		next;
		mes "[Ian Atnad]";
		mes "很好。";
		mes "那我就命令你做一件现在确实需要的事。";
		mes "看看你能多好地执行我的指示。";
		next;
		cutin "verus_aures.bmp",0;
		mes "[Aures]";
		mes "这个人……到最后还是这样。";
		mes "总之，既然你在这里，我也会为你效劳。";
		mes "恐怕我们要做的工作有点危险。";
		next;
		cutin "verus_ian01.bmp",2;
		mes "[Ian Atnad]";
		mes "别说废话，过来，新人。";
		next;
		cutin "verus_aures.bmp",0;
		mes "[Aures]";
		mes "抱歉。";
		mes "我们先走吧。";
		mes "我会支援你。";
		ep15_1_atnad = 6;
		close3;
	case 6:
		cutin "verus_ian01.bmp",2;
		mes "所以，你说你要帮我们工作？";
		mes "那就看看你做得怎么样。";
		mes "离开这里继续深入，就能看到一个广场。";
		next;
		mes "[Ian Atnad]";
		mes "那里有高度发达文明制造的机器。";
		mes "有一种让机器运转的关键装置。";
		next;
		mes "[Ian Atnad]";
		mes "目前由于还在调查，我们暂时称它为^4d4dff操作控制装置^000000。";
		mes "调查机器并收集 20 个操作控制装置。";
		next;
		mes "[Ian Atnad]";
		mes "我会看看你的工作表现。";
		setquest 7615;// Core Collection
		ep15_1_atnad = 7;
		close3;
	case 7:
		if (countitem(6749) < 20) {// Power_Control_Device
			cutin "verus_ian01.bmp",2;
			mes "20 Power Control Devices.";
			mes "对那个所谓伟大人物推荐的人来说，应该不成问题吧？";
			mes "嗯。";
			close3;
		}
		cutin "verus_ian02.bmp",2;
		mes ".. Hm..";
		mes "别因此得意忘形！";
		mes "我们会把它用于研究。";
		mes "把你拥有的一切交出来。";
		next;
		cutin "verus_aures.bmp",0;
		mes "[Aures]";
		mes "哈哈……这家伙一如既往地死板。";
		mes "说一句“谢谢你做得好”有那么难吗？";
		next;
		cutin "verus_ian01.bmp",2;
		mes "[Ian Atnad]";
		mes "走开！";
		mes "你为什么一直插手？";
		next;
		cutin "verus_aures.bmp",0;
		mes "[Aures]";
		mes "这是这个老人的少数乐趣之一，你能怎么办。";
		mes "那我替他向你道谢。";
		mes "总之，辛苦你了。";
		next;
		cutin "verus_aures.bmp",0;
		mes "[Aures]";
		mes "你今后可能会专注于这类工作。";
		mes "我们想研究这些操作装置，但不知道那些机器有多可怕。";
		next;
		mes "[Aures]";
		mes "我很快会写报告，到时还会请你帮忙。";
		delitem 6749, countitem(6749);// Power_Control_Device
		erasequest 7615;// Core Collection
		setquest 7619;// Assisting the Excavation Team
		getexp 750000,500000;
		ep15_1_atnad = 8;
		next;
		cutin "verus_ian03.bmp",2;
		mes "[Ian Atnad]";
		mes "你们两个相处得不错。";
		mes "走开！";
		close3;
	case 8:
		cutin "verus_ian01.bmp",2;
		mes "……我还是不信任你。";
		mes "这叫契约，所以我希望你安静地继续工作。";
		next;
		mes "[Ian Atnad]";
		mes "你还指望我说谢谢……";
		next;
		cutin "verus_aures.bmp",0;
		mes "[Aures]";
		mes "嘿。别管那个固执的家伙，过来一下！";
		next;
		cutin "verus_ian01.bmp",2;
		mes "[Ian Atnad]";
		mes "……嗯……你在做什么？走开！";
		close3;
	case 9:
	case 10:
	case 11:
	case 12:
		cutin "verus_ian01.bmp",2;
		mes "……你……";
		mes "别在这里闲逛，去找点事情做吧？";
		next;
		mes "[Ian Atnad]";
		mes "我再说一次，";
		mes "我不认为你只是来帮助我们的。";
		mes "我确定 Arquien 在策划什么。";
		next;
		mes "[Ian Atnad]";
		mes ".....hm.";
		mes "做完手头的事后马上回来找我。";
		close3;
	case 13:
		cutin "verus_ian01.bmp",2;
		mes "你送完报告回来了？";
		mes "回来得正是时候。";
		mes "给我带点零食。";
		next;
		mes "[Ian Atnad]";
		mes "不是这里的军粮……那是什么？";
		mes "找些美味食物刺激我的食欲，这里又热又闷。";
		next;
		cutin "verus_aures.bmp",0;
		mes "[Aures]";
		mes "嘿，伙计。你在这里找什么美味食物？";
		mes "拿 Louis 带来的东西就好。";
		next;
		cutin "verus_ian01.bmp",2;
		mes "[Ian Atnad]";
		mes "啊，你别插手。";
		mes "让新人自己处理。";
		mes "找一种^4d4dff容易食用、汁水丰富清爽、收尾利落的美味食物^000000给我！";
		next;
		mes "[Ian Atnad]";
		mes "如果你找到我想要的东西，我就答应你一个愿望。";
		mes "你来这里不就是想得到什么吗？";
		next;
		cutin "",255;
		mes "为了向 Ian Atnad 询问^4d4dff最后的探索^000000";
		mes "看来必须找到一种^4d4dff容易食用、汁水丰富清爽、收尾利落的美味食物^000000。";
		erasequest 7623;// Atnad's Summon
		setquest 7624;// In Search of a Delicacy
		ep15_1_atnad = 14;
		close;
	case 14:
	case 15:
		cutin "verus_ian03.bmp",2;
		mes "你要我重复吗？";
		mes "找一种^4d4dff容易食用、汁水丰富清爽、收尾利落的美味食物^000000";
		mes "我就会满足你的愿望。";
		next;
		cutin "verus_ian01.bmp",2;
		mes "[Ian Atnad]";
		mes "如果你那迟钝的脑子找不到，就至少试着问问别人！";
		mes "找符合我口味的东西。";
		close3;
	case 16:
		cutin "verus_ian01.bmp",2;
		if (countitem(11519) < 1) {// Beef_Toast
			mes "..Hm.";
			mes "放弃了？";
			mes "真的吗？";
			mes "我没想到你会这么轻易放弃……？";
			next;
			mes "[Ian Atnad]";
			mes "如果我要求的东西那么难找，那我就收回要求。";
			mes "但是，你必须离开这支挖掘队。";
			next;
			cutin "",255;
			mes "我必须去找丢失的牛肉吐司。";
			close;
		}
		mes "嗯……是这个吗？";
		mes "……我真的可以在工作时不用餐具就方便地吃这个。";
		mes "..Smells of freshly cooked meat.";
		next;
		mes "Ian 擦了擦手，慢慢开始吃牛肉吐司。";
		next;
		cutin "verus_ian03.bmp",2;
		mes "[Ian Atnad]";
		mes "嗯……";
		mes ".....!";
		mes "这……这个味道！";
		mes "充满细磨牛肉的汁水！";
		mes "我能尝到明火带来的味道……！";
		next;
		cutin "verus_ian02.bmp",2;
		mes "[Ian Atnad]";
		mes "异国水果和蔬菜中和了油的细腻油腻感！";
		mes "...!";
		next;
		select("试试包在外面的叶子。");
		cutin "verus_ian04.bmp",2;
		mes "[Ian Atnad]";
		mes "确实……这个也可以吃。";
		mes "丰富的汁水、新鲜的沙拉……甜美的水果……";
		mes "用清新的收尾味道将一切包裹起来……！";
		next;
		mes "[Ian Atnad]";
		mes "...Kid..";
		mes "不错。";
		mes "你满足了我提出的所有条件。";
		next;
		mes "[Ian Atnad]";
		mes "我别无选择。";
		mes "好吧。我早就猜到你想要什么。";

						mes "把鼻子伸进你的私事。";
						next;
						mes "[Ghalstein]";
						mes "好吧，我接受你的道歉，但我必须警告你，不要窥探我的私事。";
						close;
				}

			case 2:
				mes "["+strcharinfo(0)+"]";
				mes "嗯……现在我也不知道了。我想，也许是我错了。";
				next;
				mes "[Ghalstein]";
				mes ".......";
				mes "是啊，我也不建议你到处随意指责陌生人做奇怪的事。";
				close;
		}
	}
	else if(lhz_boss == 4)
	{
		mes "[Ghalstein]";
		mes "我已经做出决定，也找到了一种让你了解内情、又不会危及组织行动的方法。";
		next;
		mes "[Ghalstein]";
		mes "如你所料，我是某个组织的成员。这个组织的最终目标是终结 Rekenber 公司。";
		next;
		mes "[Ghalstein]";
		mes "不过，在我透露更多关于组织及其行动的信息前，需要你的配合。";
		next;
		switch( select( "我该如何配合？" ) )
		{
			case 1:
				break;
		}
		mes "["+strcharinfo(0)+"]";
		mes "我该如何配合？呃，你究竟想让我做什么？";
		next;
		mes "[Ghalstein]";
		mes "你似乎想更多了解我们，而我们也能借助你作为冒险者的本领。但首先，你必须决定是否承诺配合。";
		next;
		switch( select( "我还是不明白……","好，我会配合。","不用了，谢谢。" ) )
		{
			case 1:
				mes "[Ghalstein]";
				mes "好吧，我说得更清楚些。你有两个选择。";
				next;
				switch( select( "两个选择？" ) )
				{
					case 1:
						break;
				}
				mes "[Ghalstein]";
				mes "如果你选择与我们合作，就必须定期饮用这种红色魔法药剂。";
				next;
				mes "[Ghalstein]";
				mes "红色药剂能让我们监视你的一举一动，确保你不会背叛。你必须继续合作，否则我们不会给你解药。";
				next;
				mes "[Ghalstein]";
				mes "在任务期间，你需要不时服用红色药剂，以免遭受不愉快的后果。任务完成后，你会得到解毒剂。";
				next;
				switch( select( "........." ) )
				{
					case 1:
						break;
				}
				mes "[Ghalstein]";
				mes "如果你选择不合作，只要喝下这种蓝色药剂，就会抹去关于我们见面的所有记忆。";
				next;
				mes "[Ghalstein]";
				mes "那么，你决定怎么做？";
				next;
				switch( select( "不合作","合作" ) )
				{
					case 1:
						break;

					case 2:
						mes "[Ghalstein]";
						mes "啊，明智的选择。你要服用这种红色药剂吗？";
						next;
						switch( select( "不服用。","服用。" ) )
						{
							case 1:
								break;

							case 2:
								mes "[Ghalstein]";
								mes "很好。那么请立刻喝下它。";
								next;
								mes "^3355FF你喝下红色药剂。感觉和红色药水没什么不同，但在任务完成前与 Ghalstein 合作才是明智之举。^000000";
								next;
								mes "[Ghalstein]";
								mes "第一次喝这种药剂后，你可能会有些头晕。在我们谈任务前，先给你一点时间恢复。";
								set lhz_boss,5;
								close;
						}
						break;
				}
				break;

			case 2:
				mes "[Ghalstein]";
				mes "啊，明智的选择。你要服用这种红色药剂吗？";
				next;
				switch( select( "不服用。","服用。" ) )
				{
					case 1:
						break;

					case 2:
						mes "[Ghalstein]";
						mes "很好。那么请立刻喝下它。";
						next;
						mes "^3355FF你喝下红色药剂。感觉和红色药水没什么不同，但在任务完成前与 Ghalstein 合作才是明智之举。^000000";
						next;
						mes "[Ghalstein]";
						mes "第一次喝这种药剂后，你可能会有些头晕。在我们谈任务前，先给你一点时间恢复。";
						set lhz_boss,5;
						close;
				}

			case 3:
				break;
		}
		mes "[Ghalstein]";
		mes "你真的这么想？真遗憾，实在可惜……";
		next;
		mes "^3355FF你突然觉得一直有人站在身后。你慢慢转身查看，却被打晕了……^000000";
		percentheal 100,0;
		percentheal -50,0;
		next;
		mes "..........";
		mes "........";
		mes ".....";
		mes "..";
		next;
		mes "[??????]";
		mes "^666666现在……^000000";
		if(Sex == SEX_MALE) mes "^666666让他^000000";
		else mes "^666666让她^000000";
		mes "^666666吞下这颗药。^000000";
		next;
		mes "^3355FF你被迫吞下一颗奇怪的药，思绪立刻变得模糊，仿佛整个意识都被漂白了。^000000";
		set lhz_boss,0;
		close2;
		warp "lighthalzen",217,313;
		end;
	}
	else if(lhz_boss == 5)
	{
		mes "[Ghalstein]";
		mes "感觉怎么样？恶心感应该很快就会消退。总之，我们开始吧。";
		next;
		mes "[Ghalstein]";
		mes "Rekenber 公司与 Regenschirm 紧密相连。那是一座地下实验室，里面住着奇怪而可疑的生物。";
		next;
		mes "[Ghalstein]";
		mes "你的任务是潜入这座地下实验室，带回能证明这些生物存在的证据。你必须收集各种证明。";
		next;
		mes "[Ghalstein]";
		mes "更重要的是，那里有^FF0000某样东西必须带回来给我^000000。我不能告诉你具体是什么，但相信我，你会知道的。";
		next;
		mes "[Ghalstein]";
		mes "只要在实验室里仔细搜寻，你就会找到我说的东西。无论如何，你得想办法进入实验室。";
		next;
		mes "[Ghalstein]";
		mes "你应该知道，我们收到过^FF0000东侧贫民窟^000000居民失踪的报告。我们认为他们可能在非法转运……";
		next;
		mes "[Ghalstein]";
		mes "如果那里有人未经许可运送人员，也许你能找到联系人，偷偷带你进入实验室。";
		set lhz_boss,6;
		changequest 12015,12016;
		close;
	}
	else if(lhz_boss == 6)
	{
		mes "[Ghalstein]";
		mes "现在最好先调查东侧贫民窟，看看能否找到带你进入实验室的人。";
		close;
	}
	else if(lhz_boss == 7)
	{
		if(!(MISC_QUEST&512))
		{
			mes "[Ghalstein]";
			mes "发生错误。";
			close;
		}
		if ((countitem(7346)) && (countitem(7347) > 9) && (countitem(7345) > 9))
		{
			mes "[Ghalstein]";
			mes "啊，这些证据足够让我们有效打击敌人了。我相信你已经准备好执行下一个任务。";
			next;
			mes "[Ghalstein]";
			mes "不过首先，该再服一剂红色药剂了，这样我们才能继续监视你。别担心，它不会成瘾，也没有什么奇怪之处。";
			next;
			mes "[Ghalstein]";
			mes "现在去找我们的成员 ^FF0000Gusharr^000000，他在^FF0000朱诺附近^000000。关于下一个任务他会告诉你。把这个给他看，证明你在为我们工作。别忘了。";
			delitem 7346,1; //Pile_Of_Ymir_Heart
			delitem 7347,10; //Lab_Staff_Record
			delitem 7345,10; //Armlet_Of_Prisoner
			set lhz_boss,8;
			getitem 7348,1; //Indication_Of_Member01
			changequest 12016,12017;
			close;
		}
		else if((!countitem(7346)) && (!countitem(7347)) && (!countitem(7345)))
		{
			mes "[Ghalstein]";
			mes "进入实验室后，务必搜寻记录，取得任何我们能利用的确凿证据。我就靠你了。";
			close;
		}
		else
		{
			mes "[Ghalstein]";
			mes "我们还需要实验室里的更多证据，才能对敌人造成影响。我知道目标很难找到，但我相信你能做到。";
			close;
		}
	}
	else if(lhz_boss == 8)
	{
		mes "[Ghalstein]";
		mes "请在朱诺附近找到 Gushaar。他会告诉你下一个任务的全部详情。";
		close;
	}
	else if(lhz_boss < 25)
	{
		mes "[Ghalstein]";
		mes "你决定帮助我们，以了解更多关于组织的事情。我们感谢你能提供的一切帮助，但希望你不会后悔陷得这么深。";
		next;
		mes "[Ghalstein]";
		mes "知识有它的代价。我相信你有能力付出，但这场经历对你是否值得，难以判断。";
		close;
	}
	else if(lhz_boss < 43)
	{
		mes "[Ghalstein]";
		mes "你离完成任务已经很近了。如果一切按计划进行，我们就能重创敌人，而你也终于自由了。";
		close;
	}
	else if(lhz_boss == 43)
	{
		mes "[Ghalstein]";
		mes "我不敢相信发生了这种事。我刚听说总统遭到了背叛！太可怕了！我们得从头开始。难道这一切都白费了吗？！";
		next;
		mes "[Ghalstein]";
		mes "不，不行。如果我就此放弃，Jargeah 一定会对我失望。无论障碍是什么，我都必须追随我们的梦想。Jargeah，请赐予我力量！";
		next;
		mes "[Ghalstein]";
		mes "另外，你为我们立下了大功。虽然我们失败了，但你完美完成了任务。拿着这份解毒剂，你终于可以摆脱我们了。";
		next;
		mes "[Ghalstein]";
		mes "请收下这份小礼物，作为我们的歉意。我们让你做了那么多事，却没能实现最初的目标。不过……";
		set lhz_boss,44;
		getitem 617,1; //Old_Violet_Box
		getexp (checkre(3))?180000:1800000,0;
		completequest 12028;
		next;
		mes "[Ghalstein]";
		mes "感谢你所做的一切。希望你在决定帮助我们时，找到了自己寻找的答案。再见，忠诚的朋友。";
		close;
	}
	else
	{
		mes "[Ghalstein]";
		mes "我讨厌等待，但老话说得对：留得青山在，不怕没柴烧。只是那一天似乎还遥遥无期……";
		close;
	}
}

lighthalzen,173,167,1	script	Switch	HIDDEN_NPC,2,4,{


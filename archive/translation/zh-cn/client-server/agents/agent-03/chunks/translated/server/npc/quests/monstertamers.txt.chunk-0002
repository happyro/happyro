comodo,112,182,0	script	Munak's Grandma	103,{
	if (countitem(1558) > 0) {
		mes "[Munak's grandma]";
		mes "哎呀……";
		mes "你见过我的孙女吗，";
		if (Sex == SEX_MALE) {
			mes "小伙子？我可怜的孙女";
		}
		else {
			mes "姑娘？我可怜的孙女";
		}
		mes "失踪了……";
		next;
		mes "[Munak's Grandma]";
		mes "我记不清具体时间了，";
		mes "但我住在斐扬时，";
		mes "有一个可爱的孙女。她";
		mes "在我把她的头发做成";
		mes "^000077发簪^000000时非常开心……";
		next;
		mes "[Munak's Grandma]";
		mes "她总是和";
		mes "村长一起工作……她是个可爱的";
		mes "女孩，总是和";
		mes "村长的儿子相处融洽……";
		next;
		mes "[Munak's Grandma]";
		mes "但有一天，我们的神明发怒了，";
		mes "诅咒村长的儿子，让他患上";
		mes "疾病！村子只好把";
		mes "我的孙女献给他作为";
		mes "解除诅咒的伴侣……";
		next;
		mes "[Munak's Grandma]";
		mes "村长的儿子恢复了";
		mes "健康，但我失去了";
		mes "孙女！我一看到他";
		mes "就会想起她，所以我试着";
		mes "抛开痛苦，来到";
		mes "这里的海洞……";
		next;
		switch(select("别这样！振作起来！:嗯，这是日记吗……？")) {
		case 1:
			mes "[Munak's Grandma]";
			mes "看来我的孙女每晚都";
			mes "出现在梦里。我想我已经";
			mes "努力振作好多年了，";
			mes "现在……";
			close;
		case 2:
			if (countitem(901) > 0) {
				mes "[Munak's Grandma]";
				mes "天啊！";
				mes "这是我孙女的日记！";
				mes "这、这是她的字！天啊……！";
				next;
				mes "[Munak's Grandma]";
				if (Sex == SEX_MALE) {
					mes "年轻人……如果你给我";
				}
				else {
					mes "姑娘……如果你给我";
				}
				mes "和发簪，我就读给你听，";
				mes "求你了。我已经没有";
				mes "属于她的东西了……";
				next;
				switch(select("没门。:好，我愿意。")) {
				case 1:
					mes "[Munak's Grandma]";
					mes "哦……？";
					if (Sex == SEX_MALE) {
						mes "好吧，年轻人。";
						mes "还是谢谢你。";
					}
					else {
						mes "还是谢谢你，";
						mes "姑娘。";
					}
					next;
					mes "[Munak's Grandma]";
					mes "没关系……";
					mes "我只能希望神明";
					mes "好好照顾她！";
					close;
				case 2:
					delitem 1558,1;
					delitem 901,1;
					mes "[Munak's Grandma]";
					if (Sex == SEX_MALE) {
						mes "Oh!";
						mes "谢谢你，";
						mes "年轻人～！";
					}
					else {
						mes "天哪！";
						mes "谢谢你，";
						mes "姑娘……";
					}
					next;
					mes "[Munak's Grandma]";
					mes "好……";
					mes "我来读读。";
					mes "让我看看……";
					next;
					mes "[Munak's Grandma]";
					mes "看来我的孙女被";
					mes "村长当作亲生";
					mes "孩子！这本书里有这么多快乐的";
					mes "回忆！";
					next;
					getitem 659,1;
					mes "[Munak's Grandma]";
					mes "哦，谢谢你。我现在有了一件";
					mes "孙女的纪念品。非常";
					mes "感谢你！愿神明保佑";
					mes "你！";
					close;
				}
			}
			else {
				mes "[Munak's Grandma]";
				mes "什么？日记？那是什么日记……？";
				mes "我不……我想不起来了，天啊……";
				next;
				mes "[Munak's Grandma]";
				mes "我真希望能再次把她的头发";
				mes "做成^000077发簪^000000。真的希望……";
				mes "哦，我的孙女……";
				close;
			}
		}
	}
	else {
		mes "[Munak's Grandma]";
		mes "我的孙女……";
		mes "她为什么要离开……？";
		close;
	}
}

		mes "咳咳！";
		next;
		mes "- 他把什么东西放进嘴里咽下去了。 -";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "那是什么？！";
		mes "你嘴里含着什么……？";
		mes "你为什么要这么做？";
		next;
		mes "已经来不及救他了。";
		mes "他去世了。";
		mes "你发现他脖子上挂着一把装饰华丽的钥匙。";
		set job_3rd_gc, 13;
		getitem 6150,1; //Key_Of_The_Mansion
		changequest 7107,7108;
		close;
	} else {
		if (job_3rd_gc == 13) {
			mes "没什么可做的。";
			mes "我们离开这里吧。";
		} else
			mes "你被一股未知的力量推开了。";
		close2;
		warp "veins",178,62;
		end;
	}
OnInit:
OnDisable:
	disablenpc "Dandelion#3rdgc12";
	end;
OnEnable:
	enablenpc "Dandelion#3rdgc12";
	end;
}

rachel,115,77,3	script	Girke#3rdgc13	85,{
	mes "[Girke]";
	mes "哦~年轻人。";
	mes "我是吉尔克·萨拉。";
	mes "叫我吉尔克就好。";
	next;
	mes "- 他身上有酒味。 -";
	next;
	mes "[Girke]";
	mes "你知道吗？";
	mes "我们村里住着一位传说中的钥匙工匠。";
	mes "嗝~";
	next;
	mes "[Girke]";
	mes "啊~哈哈哈哈";
	mes "我父亲很喜欢那样的作品。";
	mes "有一天，他对我说。";
	next;
	mes "[Girke]";
	mes "‘吉尔克，我希望能得到一把奥雷萨制作的钥匙。’";
	next;
	mes "[Girke]";
	mes "但奥雷萨把一切交给学徒后就失踪了。";
	mes "最后，我父亲没能见到那样的钥匙就去世了……";
	next;
	mes "[Girke]";
	mes "你知道吗。";
	mes "就是那个奥雷萨！他住在我们镇上？！";
	mes "嗝~";
	next;
	mes "[Girke]";
	mes "可是他太老了……";
	mes "不过那位工匠……";
	next;
	mes "[Girke]";
	mes "……很难见到。";
	mes "就像我父亲一样……他有点孤僻。";
	next;
	mes "[Girke]";
	mes "我在和你说什么呢。";
	mes "你醉了吗？爸爸……（抽泣）";
	mes "啊……爸爸……";
	next;
	mes "- 吉尔克开始哭泣。 -";
	close;
}

ra_in01,175,196,3	script	Oresa Rava#3rdgc13	866,{
	mes "[Oresa Rava]";
	if (job_3rd_gc == 13) {
		mes "不知道你为什么来找我，但我已经不再制作钥匙了。";
		mes "我太老了，做不动了。";
		next;
		select("你认识这把钥匙吗？");
		mes "[Oresa Rava]";
		mes "嗯？呃……把它给我。";
		mes "这个纹样……";
		mes "你从哪里得到的？";
		next;
		switch(select("我只是捡到的。:我有一个故事……")) {
		case 1:
			mes "[Oresa Rava]";
			mes "嗯？你只是捡到的？";
			mes "不可能。";
			mes "那栋房子里发生了什么吗？";
			next;
			mes "[Oresa Rava]";
			mes "那你打算怎么处理这把钥匙？";
			next;
			select("我要找到它的主人。" );
			mes "[Oresa Rava]";
			mes "啊~！所以你才来找我。";
			mes "我把那把钥匙交给了一位神父。";
			next;
			mes "[Oresa Rava]";
			mes "他成为神父后我就没再见过他，但我为庆典制作了那把钥匙。";
			next;
			mes "[Oresa Rava]";
			mes "那是他宅邸的钥匙。";
			mes "现在我不知道他住在哪里。";
			mes "你能去那里，把避暑别墅的管理员带来吗？";
			next;
			break;
		case 2:
			mes "[Oresa Rava]";
			mes "我不知道发生了什么。";
			mes "我把那把钥匙交给了一位神父。";
			next;
			mes "[Oresa Rava]";
			mes "他成为神父后我就没再见过他，但我为庆典制作了那把钥匙。";
			next;
			mes "[Oresa Rava]";
			mes "那是他宅邸的钥匙。";
			mes "现在我不知道他住在哪里。";
			mes "你能去那里，把避暑别墅的管理员带来吗？";
			next;
			mes "[Oresa Rava]";
			mes "其实我不能相信你……";
			mes "但你带着钥匙出现了，也许这是天意。";
			next;
			select("好。" );
			break;
		}
		mes "[Oresa Rava]";
		mes "那座宅邸……";
		mes "建在维因斯的峡谷里。";
		mes "不过我不知道确切位置。";
		next;
		select("这样就够了。" );
		mes "[Oresa Rava]";
		mes "你确定吗？";
		mes "你真善良。";
		mes "把那把钥匙送过去吧。";
		next;
		mes "- 尽快找到钥匙的主人，并告诉梅谢尔。 -";
		set job_3rd_gc, 14;
		close;
	} else if (job_3rd_gc == 14) {
		mes "那把钥匙属于建在维因斯峡谷里的宅邸。";
		mes "我确定。";
		close;
	} else {
		mes "那是关于那位工匠的旧事。";
		mes "现在……最好去见我的孙辈。";
		next;
		mes "[Oresa Rava]";
		mes "你现在笑吧，但很快就会理解我。";
		close;
	}
}

//Pre-RE: ve_fild05 (327,308)
ve_fild02,330,384,3	script	Girl#3rdgc14	466,{
	if (job_3rd_gc > 14 && job_3rd_gc < 18) {
		mes "[Renzak]";
		if (job_3rd_gc == 15) {
			mes "你来了。";
			mes "我是伦扎克。";
			mes "你是梅谢尔派来的？";
			//mes "I'm not dwelling on."; //FIXME: Dialogue.
			next;
			mes "[Renzak]";
			mes "我们的最终目标就在那边。";
			mes "宅邸被悬崖包围。";
			mes "你必须清除宅邸里的目标。";
			next;
			mes "[Renzak]";
			mes "我给你 10 分钟。";
			mes "完成任务后在宅邸后门等待。";
			mes "我会在那里等你。";
		} else if (job_3rd_gc == 16) {
			mes "你必须达成目标，并在 10 分钟内从宅邸后门出来。";
			mes "你能做到。";
		} else {
			mes "你失败了。";
			mes "你必须成功。";
			next;
			mes "[Renzak]";
			mes "你必须从宅邸后门出来。";
			mes "我会等你。";
		}
		next;
		switch(select("明白了。:我会准备好。")) {
		case 1:
			if ($@3rdgc_room02 == 0) {
				erasequest ((job_3rd_gc == 17)?7110:7109);
				set job_3rd_gc, 17;
				setquest 7110;
				set $@3rdgc_room02, 1;
				warp "job3_guil03",22,70;
			} else {
				mes "[Renzak]";
				mes "等一下。";
				mes "等到天黑。";
				next;
				mes "[Renzak]";
				mes "那里被悬崖阴影遮蔽，很容易潜入。";
				set job_3rd_gc, 16;
			}
			close;
		case 2:
			mes "[Renzak]";
			mes "你没有时间浪费。";
			mes "准备行动吧。";
			if (job_3rd_gc == 17) {
				erasequest 7110;
				setquest 7109;
			}
			set job_3rd_gc, 16;
			close;
		}
	} else if (job_3rd_gc > 18) {
		mes "[Renzak]";
		mes "你看起来不错。";
		mes "我？我一直都是这个样子。";
		next;
		mes "[Renzak]";
		mes "我只是在等愿意照我说的做的人。";
		close;
	} else {
		mes "[Shadow-faced girl]";
		mes "......";
		mes "这条路被堵住了。";
		mes "回去吧。";
		close;
	}
OnInit:
	set $@3rdgc_room02, 0;
	end;
}


//===== rAthena Script =======================================
//= Magazine Dealers
//===== Description: =========================================
//= Turns bullets into magazines/packs.
//===== Changelogs: ==========================================
//= 1.0 First version. [SinSloth]
//= 1.1 Optimized version - Reduced to only one function [SinSloth]
//= 1.2 Optimized^2, corrected npc's name [ultramage]
//= 1.2a Optimized. Please, ommit extra NPC names [Lupus]
//= 1.3 Updated to match AEGIS script. [Kisuka]
//= 1.4 Updated to match AEGIS script again. [Masao]
//= 1.5 Moved Izlude duplicate to pre-re/re paths. [Euphy]
//= 2.0 Clean-up. [Capuche]
//= 2.1 Fixes Issue #1482, where Rebellion jobs cannot use this npc. [Limestone]
//= 2.2 Updated to new bullets. [Aleos]
//============================================================

que_ng,187,149,3	script	Magazine Dealer Kenny::mdk	4_M_01,{
	mes "[Kenny]";
	mes "子弹袋能让你更轻松地携带子弹。";
	mes "来看看吧～";
	next;
	switch(select("各种子弹盒:球体兑换:旧球体兑换:霰弹兑换:取消")) {
	case 1:
		switch(select("子弹盒:血腥子弹盒:银色子弹盒:AP弹药盒:烈焰弹药盒:冰冻弹药盒:闪电弹药盒:魔法石弹药盒:净化弹药盒:照明弹盒:闪电弹盒:冰弹盒:毒弹盒:致盲弹盒:取消")) {
			case 1: callsub S_Casing,13200,12149;
			case 2: callsub S_Casing,13222,22737;
			case 3: callsub S_Casing,13221,22738;
			case 4: callsub S_Casing,13215,22744;
			case 5: callsub S_Casing,13216,22745;
			case 6: callsub S_Casing,13217,22746;
			case 7: callsub S_Casing,13218,22747;
			case 8: callsub S_Casing,13219,22748;
			case 9: callsub S_Casing,13220,22749;
			case 10: callsub S_Casing,13228,23123;
			case 11: callsub S_Casing,13229,23124;
			case 12: callsub S_Casing,13230,23125;
			case 13: callsub S_Casing,13231,23126;
			case 14: callsub S_Casing,13232,23127;
			case 15: callsub S_Close;
		}
	case 2:
		switch(select("火焰子弹:风之子弹:冰冻子弹:毒子弹:致盲子弹:取消")) {
		case 1: callsub S_Sphere_Exchange,13223,13228;
		case 2: callsub S_Sphere_Exchange,13224,13229;
		case 3: callsub S_Sphere_Exchange,13227,13230;
		case 4: callsub S_Sphere_Exchange,13225,13231;
		case 5: callsub S_Sphere_Exchange,13226,13232;
		case 6: callsub S_Close;
		}
	case 3:
		switch(select("火焰球:风之球:冰冻球:毒球:致盲球:取消")) {
		case 1: callsub S_Old_Sphere_Exchange,13203,13228;
		case 2: callsub S_Old_Sphere_Exchange,13204,13229;
		case 3: callsub S_Old_Sphere_Exchange,13207,13230;
		case 4: callsub S_Old_Sphere_Exchange,13205,13231;
		case 5: callsub S_Old_Sphere_Exchange,13206,13232;
		case 6: callsub S_Close;
		}
	case 4:
		switch(select("L型霰弹:M型霰弹:H型霰弹:SH型霰弹:XH型霰弹:取消")) {
		case 1: callsub S_Slug_Exchange,13210,24;
		case 2: callsub S_Slug_Exchange,13211,12;
		case 3: callsub S_Slug_Exchange,13212,8;
		case 4: callsub S_Slug_Exchange,13213,6;
		case 5: callsub S_Slug_Exchange,13214,5;
		case 6: callsub S_Close;
		}
	case 5:
		callsub S_Close;
	}

S_Casing:
	.@bullet_id = getarg(0);
	.@pack_id = getarg(1);
	.@bullet_str$ = getitemname(.@bullet_id);
	.@pack_str$ = getitemname(.@pack_id);
	.@bullet_count = countitem(.@bullet_id);
	.@pack_count = .@bullet_count / 500;

	if (.@bullet_count < 500 || getequipid(EQI_AMMO) != -1 || BaseClass != Job_Gunslinger) {
		mes "[Kenny]";
		mes "嘿～你需要准确数量的物品才能兑换。再去收集一些吧。";
		mes "你必须有500个以上的^FF0000" + .@bullet_str$ + "^000000，明白吗？兑换前也不要^FF0000装备^000000它们。";
		close;
	}

	mes "[Kenny]";
	mes "你选择了^FF0000" + .@pack_str$ + "^000000。";
	mes "需要500发^3131FF" + .@bullet_str$ + "^000000才能制作1个^3131FF" + .@bullet_str$ + "^000000物品，费用为^3131FF500^000000 Zeny。";
	mes "你想兑换多少？";
	next;
	switch(select("全部兑换:只制作1个:取消")) {
		case 1:
			mes "[Kenny]";
			mes "子弹数量：^3131FF" + .@bullet_count;
			mes "子弹袋数量：^3131FF" + .@pack_count;
			mes "所需Zeny：^3131FF" + .@pack_count * 500;
			next;
			mes "要兑换吗？";
			next;
			switch(select("兑换:取消")) {
				case 1:
					if (Zeny < .@pack_count * 500) {
						mes "[Kenny]";
						mes "嘿～你需要准确数量的Zeny才能兑换。再去收集一些吧。";
						mes "你必须有^FF0000" + .@pack_count * 500 + "^000000，明白吗？";
						close;
					}
					mes "[Kenny]";
					mes "完成了。";
					mes "背包重量超过70%时，子弹袋就无法使用。请注意。";
					Zeny -= .@pack_count * 500;
					delitem .@bullet_id, .@pack_count * 500;
					getitem .@pack_id, .@pack_count;
					close;
				case 2:
					close;
			}
		case 2:
			if (Zeny < 500) {
				mes "[Kenny]";
				mes "嘿～你需要准确数量的Zeny才能兑换。再去收集一些吧。";
				mes "You must have ^FF0000500^000000, ok?";
				close;
			}
			mes "[Kenny]";
			mes "All done.";
			mes "背包重量超过70%时，子弹袋就无法使用。请注意。";
			Zeny -= 500;
			delitem .@bullet_id, 500;
			getitem .@pack_id, 1;
			close;
		case 3:
			callsub S_Close;
	}

S_Sphere_Exchange:
	.@old_id = getarg(0);
	.@new_id = getarg(1);
	.@old_str$ = getitemname(.@old_id);
	.@new_str$ = getitemname(.@new_id);
	.@old_count = countitem(.@old_id);
	.@new_count = .@old_count / 10;

	if (.@old_count < 10 || getequipid(EQI_AMMO) != -1 || BaseClass != Job_Gunslinger) {
		mes "[Kenny]";
		mes "嘿～你需要准确数量的物品才能兑换。再去收集一些吧。";
		mes "你必须有10个以上的^FF0000" + .@old_str$ + "^000000，明白吗？兑换前也不要^FF0000装备^000000它们。";
		close;
	}

	mes "[Kenny]";
	mes "你选择了^FF0000" + .@old_str$ + "^000000。";
	mes "需要10个^3131FF" + .@old_str$ + "^000000才能制作1个^3131FF" + .@new_str$ + "^000000。";
	mes "你想兑换多少？";
	next;
	switch(select("全部兑换:只制作1个:取消")) {
		case 1:
			mes "[Kenny]";
			mes .@old_str$ + "数量：^3131FF" + .@old_count;
			mes .@new_str$ + "数量：^3131FF" + .@new_count;
			next;
			mes "要兑换吗？";
			next;
			switch(select("兑换:取消")) {
				case 1:
					mes "[Kenny]";
					mes "完成了。";
					delitem .@old_id, .@new_count * 10;
					getitem .@new_id, .@new_count;
					close;
				case 2:
					close;
			}
		case 2:
			mes "[Kenny]";
			mes "All done.";
			delitem .@old_id, 10;
			getitem .@new_id, 1;
			close;
		case 3:
			callsub S_Close;
	}

S_Old_Sphere_Exchange:
	.@old_id = getarg(0);
	.@new_id = getarg(1);
	.@old_str$ = getitemname(.@old_id);
	.@new_str$ = getitemname(.@new_id);
	.@old_count = countitem(.@old_id);

	if (.@old_count < 1 || getequipid(EQI_AMMO) != -1 || BaseClass != Job_Gunslinger) {
		mes "[Kenny]";
		mes "嘿～你需要准确数量的物品才能兑换。再去收集一些吧。";
		mes "你必须有1个以上的^FF0000" + .@old_str$ + "^000000，明白吗？兑换前也不要^FF0000装备^000000它们。";
		close;
	}

	mes "[Kenny]";
	mes "你选择了^FF0000" + .@old_str$ + "^000000。";
	mes "需要1个^3131FF" + .@old_str$ + "^000000才能制作1个^3131FF" + .@new_str$ + "^000000。";
	mes "你想兑换多少？";
	next;
	switch(select("全部兑换:只制作1个:取消")) {
		case 1:
			mes "[Kenny]";
			mes .@old_str$ + " count: ^3131FF" + .@old_count;
			mes .@new_str$ + "数量：^3131FF" + .@old_count;
			next;
			mes "要兑换吗？";
			next;
			switch(select("兑换:取消")) {
				case 1:
					mes "[Kenny]";
					mes "完成了。";
					delitem .@old_id, .@old_count;
					getitem .@new_id, .@old_count;
					close;
				case 2:
					close;
			}
		case 2:
			mes "[Kenny]";
			mes "All done.";
			delitem .@old_id, 1;
			getitem .@new_id, 1;
			close;
		case 3:
			callsub S_Close;
	}

S_Slug_Exchange:
	.@slug_id = getarg(0);
	.@req_count = getarg(1);
	.@slug_str$ = getitemname(.@slug_id);
	.@new_slug_str$ = getitemname(25187);
	.@count = countitem(.@slug_id);
	.@new_count = .@count / .@req_count;

	if (.@count < .@req_count || getequipid(EQI_AMMO) != -1 || BaseClass != Job_Gunslinger) {
		mes "[Kenny]";
		mes "嘿～你需要准确数量的物品才能兑换。再去收集一些吧。";
		mes "你必须有" + .@req_count + "个以上的^FF0000" + .@slug_str$ + "^000000，明白吗？兑换前也不要^FF0000装备^000000它们。";
		close;
	}

	mes "[Kenny]";
	mes "你选择了^FF0000" + .@slug_str$ + "^000000。";
	mes "需要" + .@req_count + "个^3131FF" + .@slug_str$ + "^000000才能制作1个^3131FF" + .@new_slug_str$ + "^000000。";
	mes "你想兑换多少？";
	next;
	switch(select("全部兑换:只制作1个:取消")) {
		case 1:
			mes "[Kenny]";
			mes .@slug_str$ + "数量：^3131FF" + .@count;
			mes .@new_slug_str$ + "数量：^3131FF" + .@new_count;
			next;
			mes "要兑换吗？";
			next;
			switch(select("兑换:取消")) {
				case 1:
					mes "[Kenny]";
					mes "完成了。";
					delitem .@slug_id, .@new_count * .@req_count;
					getitem 25187, .@new_count;
					close;
				case 2:
					close;
			}
		case 2:
			mes "[Kenny]";
			mes "All done.";
			delitem .@slug_id, .@req_count;
			getitem 25187, 1;
			close;
		case 3:
			callsub S_Close;
	}

S_Close:
	mes "[Kenny]";
	mes "好的。";
	mes "如果还需要什么，";
	mes "请再回来。";
	close;
}

alberta,118,157,3	duplicate(mdk)	Magazine Dealer Kenny#al	4_M_01
izlude_in,74,104,5	duplicate(mdk)	Magazine Dealer Kenny#iz	4_M_01

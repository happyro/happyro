    Type: Card
    SubType: Enchant
    Script: |
      .@g = getenchantgrade();
      if (BaseLevel<175) {
         bonus2 bExpAddRace,RC_Angel,15;
      }
      if (BaseLevel>=175) {
         bonus2 bExpAddRace,RC_Angel,7;
      }
      if (.@g>=ENCHANTGRADE_D) {
         bonus2 bExpAddRace,RC_Angel,1;
         if (.@g>=ENCHANTGRADE_C) {
            bonus2 bExpAddRace,RC_Angel,3;
            if (.@g>=ENCHANTGRADE_B) {
               bonus2 bExpAddRace,RC_Angel,5;
            }
         }
      }

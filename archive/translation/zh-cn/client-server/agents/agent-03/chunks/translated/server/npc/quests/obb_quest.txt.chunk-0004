moc_ruins,107,62,0	script	Tommy#thai	716,{
	if (thai_head >= 6 && thai_head <= 11) {
		switch(thai_head) {
		case 6:
			mes "[Tommy]";
			mes "哇啊啊啊～～～！！";
			mes "爸爸～～给我一只妖道～～～！";
			mes "哇啊啊啊……";
			next;
			mes "[Tommy]";
			mes "我想要妖道～～！！";
			mes "别人都有，为什么我不能有？！";
			next;
			mes "[Tommy]";
			mes "妖道妖道妖道妖道～～～";
			next;
			mes "[Jacob]";
			mes "嗯……汤米……";
			next;
			mes "[Tommy]";
			mes "妖道妖道妖道妖道～～～";
			next;
			mes "[Jacob]";
			mes "汤米，爸爸现在有点忙……";
			next;
			mes "[Tommy]";
			mes "妖道妖道妖道妖道！";
			next;
			mes "[Jacob]";
			mes "唉……好吧，好吧……";
			close;
		case 7:
			mes "[Tommy]";
			mes "*哭泣*……我想要妖道！……*哭泣*";
			mes "我的朋友都有妖道，我却没有……";
			mes "哇啊啊啊～～";
			close;
		case 8:
			mes "[Tommy]";
			mes "爸爸，我讨厌你！！";
			mes "我讨厌你们所有人！！！";
			next;
			mes "[Tommy]";
			mes "哇啊啊啊～～～！";
			mes "我不在乎任何人对我说什么！";
			mes "因为我讨厌所有人，所以我要当坏孩子！";
			close;
		case 9:
			mes "[Tommy]";
			mes "嘿～！";
			mes "我好开心～";
			mes "我们要去找妖道～！";
			mes "嘿嘿嘿～！";
			close;
		case 10:
			mes "[Tommy]";
			mes "嘿～！";
			mes "我真的好开心～";
			mes "我们要去找妖道～！";
			mes "嘿嘿嘿～！";
			close;
		case 11:
			mes "[Tommy]";
			mes "嘿～！";
			mes "我喜欢你～";
			mes "因为我们现在要去";
			mes "找妖道～";
			mes "好开心！*微笑*";
			close;
		}
	}
	else if (thai_head > 11) {
		mes "[Tommy]";
		mes "爸爸……我不会再向你要太难的东西。";
		next;
		mes "[Tommy]";
		mes "我们去抓妖道时，我看到你气喘吁吁。";
		mes "对不起，爸爸，我给你添麻烦了……";
		next;
		mes "[Tommy]";
		mes "从现在起我会做个好孩子。";
		mes "我会善待爸爸、你和所有人。";
		next;
		mes "[Tommy]";
		mes "爸爸说，只要我不再做坏事，我就是好孩子。";
		close;
	}
	else {
		mes "[Tommy]";
		mes "我不喜欢周末看到爸爸整天在房间里休息。";
		mes "但今天我好开心，因为爸爸要和我一起散步！！";
		close;
	}
}


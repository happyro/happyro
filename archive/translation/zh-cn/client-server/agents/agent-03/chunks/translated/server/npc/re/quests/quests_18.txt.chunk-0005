		mes "[Maram]";
		mes "<FONT SIZE = 14>I have a favor to ask!</FONT>";
		mes "^e5555eCould you please help me secretly buy the goods for Mother?";
		cutin "ep18_maram_02.png",2;
		next;
		mes "[Maram]";
		mes "^e5555eWith an outsider^000000 like " + strcharinfo(0) + ", we might be able to buy the goods!";
		next;
		select( "购买物品的理由" );
		mes "[Maram]";
		mes "啊~";
		mes "那个……";
		cutin "ep18_maram_01.png",2;
		next;
		mes "[Miriam]";
		mes "你打算隐瞒多久？";
		mes "如果有人不知道理由就请求这种帮助，拒绝也是理所当然的。";
		cutin "ep18_miriam_03.png",2;
		next;
		mes "[Maram]";
		mes "没错。";
		mes "我明白了。";
		cutin "ep18_maram_01.png",2;
		next;
		mes "[Maram]";
		mes "" + strcharinfo(0) + "...";
		mes "其实，Miriam和我正在^e5555e帮助另一个地区陷入困境的原住民^000000。";
		mes "^e5555eProcure the supplies needed to live^000000 is one of those tasks.";
		next;
		mes "[Maram]";
		mes "虽然这被称为^e5555e歧视与迫害^000000，但实际上几乎就像是在逃离^e5555e强硬派或极端分子^000000。";
		mes "对于那些^e5555e逃亡者^000000来说，唯一的生存方式就是^e5555e躲藏^000000。";
		next;
		mes "[Maram]";
		mes "躲藏着生活……即使没有我们的帮助他们也能活下去……<FONT SIZE = 10>或者说，即使他们活不下去，</FONT>要是能想办法谋生就好了，但遗憾的是事实并非如此。";
		cutin "ep18_maram_03.png",2;
		npctalk "即使没有我们的帮助，他们也活不下去……", "Maram#ep18_merchant2", bc_self;
		next;
		mes "[Miriam]";
		mes "我也提出同样的请求。";
		mes "<FONT SIZE = 14>为了不让因饥饿而疲惫的孩子走上和我一样的道路……</FONT> <FONT SIZE = 10>经历同样的痛苦</FONT>。";
		cutin "ep18_miriam_03.png",2;
		npctalk "为了不让那些孩子经历和我一样的痛苦。", "Miriam#ep18_merchant2", bc_self;
		next;
		switch( select( "帮助他们。", "不帮助他们。", "通知Niren。" ) ) {
		case 1:
			mes "[Maram]";
			mes "<FONT SIZE = 14><B>谢谢你！</FONT></B>";
			mes "<FONT SIZE = 14><B>我们马上出发！</FONT></B>";
			mes "既然回到刚才去过的商店很奇怪，不如去^e5555e广场对面的商店^000000。";
			npctalk "谢谢你！", "Maram#ep18_merchant2", bc_self;
			npctalk "谢谢你！", "Miriam#ep18_merchant2", bc_self;
			cutin "ep18_maram_02.png",2;
			erasequest 11708;
			setquest 11709;
			ep18_main = 21;
			cloakoffnpcself( "Merchant#ep18_Rachel3" );
			close2;
			cutin "",255;
			cloakonnpcself( "Miriam#ep18_merchant2" );
			cloakonnpcself( "Maram#ep18_merchant2" );
			navigateto("rachel",137,85);
			end;
		case 2:
		case 3:
			close3;
		}
	}
	end;

OnInit:
	questinfo( QTYPE_QUEST2, QMARK_YELLOW, "isbegin_quest(11708) == 1" );
	end;
}


pay_fild10,108,357,5	script	Li#Dokebi_Hunt	90,{
	if (checkquest(60128) != -1) {
		if (checkquest(60128,HUNTING) != 2 ) {
			mes "[Li]";
			mes "你完成了猎杀50只鬼女的任务吗？";
			next;
			switch(select("是:否:我想退出")) {
			case 1:
				mes "[Li]";
				mes "嗯，我觉得你还没猎杀够50只……";
				close;
			case 2:
				mes "[Li]";
				mes "记住，我需要你帮忙猎杀鬼女，去猎杀50只吧。";
				close;
			case 3:
				mes "[Li]";
				mes "确定要停止猎杀吗？";
				mes "你取得的进度都会被清除。";
				next;
				switch(select("是:否")) {
				case 1:
					mes "[Li]";
					mes "好吧，改变主意后再回来。";
					erasequest 60128;
					close;
				case 2:
					mes "[Li]";
					mes "请猎杀50只鬼女。";
					close;
				}
			}
		}
		else {
			mes "[Li]";
			mes "太棒了，你完成得真快。";
			mes "";
			getexp 42000,36000;
			erasequest 60128;
			close;
		}
	}
	if (checkquest(60129) != -1) {
		if (checkquest(60129,HUNTING) != 2 ) {
			mes "[Li]";
			mes "你完成了猎杀100只鬼女的任务吗？";
			next;
			switch(select("是:否:我想退出")) {
			case 1:
				mes "[Li]";
				mes "嗯，我觉得你还没猎杀够100只……";
				close;
			case 2:
				mes "[Li]";
				mes "记住，我需要你帮忙猎杀鬼女，去猎杀100只吧。";
				close;
			case 3:
				mes "[Li]";
				mes "确定要停止猎杀吗？";
				mes "你取得的进度都会被清除。";
				next;
				switch(select("是:否")) {
				case 1:
					mes "[Li]";
					mes "好吧，改变主意后再回来。";
					erasequest 60129;
					close;
				case 2:
					mes "[Li]";
					mes "请猎杀100只鬼女。";
					close;
				}
			}
		}
		else {
			mes "[Li]";
			mes "太棒了，你完成得真快。";
			getexp 42000,36000;
			getexp 42000,36000;
			erasequest 60129;
			close;
		}
	}
	if (checkquest(60130) != -1) {
		if (checkquest(60130,HUNTING) != 2 ) {
			mes "[Li]";
			mes "你完成了猎杀150只鬼女的任务吗？";
			next;
			switch(select("是:否:我想退出")) {
			case 1:
				mes "[Li]";
				mes "嗯，我觉得你还没猎杀够150只……";
				close;
			case 2:
				mes "[Li]";
				mes "记住，我需要你帮忙猎杀鬼女，去猎杀150只吧。";
				close;
			case 3:
				mes "[Li]";
				mes "确定要停止猎杀吗？";
				mes "你取得的进度都会被清除。";
				next;
				switch(select("是:否")) {
				case 1:
					mes "[Li]";
					mes "好吧，改变主意后再回来。";
					erasequest 60130;
					close;
				case 2:
					mes "[Li]";
					mes "请猎杀150只鬼女。";
					close;
				}
			}
		}
		else {
			mes "[Li]";
			mes "太棒了，你完成得真快。";
			getexp 42000,36000;
			getexp 42000,36000;
			getexp 42000,36000;
			erasequest 60130;
			close;
		}
	}
	//for minimum level
	if (BaseLevel > 34) {
		//for maximum level
		if (BaseLevel < 71) {
			mes "[Li]";
			mes "你好。你能帮帮我吗？";
			next;
			switch(select("当然:不")) {
			case 1:
				mes "[Li]";
				mes "这里有这么多鬼女……我感觉很不安全。";
				next;
				switch(select("收集物品:猎杀鬼女:取消")) {
				case 1:
					// Item turn in
					mes "[Li]";
					mes "我的占卜生意需要大量^FF0000鬼女角^000000来给顾客带来好运。";
					next;
					switch(select("我有鬼女角:你需要什么？")) {
					case 1:
						if (countitem(1021) > 49) {
							mes "[Li]";
							mes "哦，太好了！";
							mes "谢谢你的鬼女角。";
							delitem 1021,50; //Dokkaebi_Horn
							getexp 42000,36000;
							close;
						}
						else {
							mes "[Li]";
							mes "看起来你的数量不够。";
							next;
							mes "[Li]";
							mes "我的占卜需要^FF000050个鬼女角^000000。";
							close;
						}
					case 2:
						mes "[Li]";
						mes "如果你带来";
						mes "^FF000050个鬼女角^000000，我就能给你带来好运。";
						close;
					}
				case 2:
					// Kill Count Quest
					mes "[Li]";
					mes "啊，好吧。你可以帮我猎杀一些鬼女。";
					mes "你想猎杀多少只？";
					next;
					switch(select("50只鬼女:100只鬼女:150只鬼女")) {
					case 1:
						mes "[Li]";
						mes "完成任务后回来，我会给你小奖励。";
						setquest 60128;
						close;
					case 2:
						mes "[Li]";
						mes "完成任务后回来，我会给你小奖励。";
						setquest 60129;
						close;
					case 3:
						mes "[Li]";
						mes "完成任务后回来，我会给你小奖励。";
						setquest 60130;
						close;
					}
				case 3:
					mes "[Li]";
					mes "改变主意后请再回来。";
					close;
				}
			case 2:
				mes "[Li]";
				mes "改变主意后请再回来。";
				close;
			}
		}
		else {
			mes "[Li]";
			mes "你好。";
			mes "我在斐扬占卜。";
			close;
		}
	}
	else {
		mes "[Li]";
		mes "这里很危险！";
		next;
		mes "[Li]";
		mes "你应该快点离开！";
		mes "";
		close;
	}
}

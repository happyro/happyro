		}
		else {
			mes "[探员]";
			mes "我不知道这些";
			mes "恶作剧者是谁，但一旦抓到他们……";
			mes "我一定会——！我一定会——！";
			specialeffect EF_BEGINSPELL;
			next;
			mes "[探员]";
			mes "天啊，我想喝酒。";
			mes "听着，你能替我去盗贼公会报告吗？";
			mes "我知道这是我的责任，但……";
			mes "也给你找点事做。";
			mes "";
			next;
			mes "[探员]";
			mes "嘿！继续努力~";
			mes "";
			set rumour_nd,21;
			close;
		}
			// 保持翻译切片物理行数
		// 保持翻译切片物理行数
	}
	else if (rumour_nd == 21) {
		mes "[探员]";
		mes "快点替我去盗贼公会报告。";
		mes "你去的时候，我要享受一杯酒~";
		mes "";
		mes "";
		close;
	}
	else {
		mes "[探员]";
		mes "*嗝*";
		mes "啊哈哈，";
		mes "感觉真好！";
		mes "老朋友啤酒~";
		next;
		mes "[Agent]";
		mes "*Hiccup*";
		next;
		mes "[探员]";
		mes "你是什么人？";
		mes "滚开！";
		close;
	}
}

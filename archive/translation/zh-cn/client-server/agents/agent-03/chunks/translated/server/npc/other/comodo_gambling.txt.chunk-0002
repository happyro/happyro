		mes "[德韦恩]";
		mes "啊，你真有";
		mes "鉴宝的眼光！";
		mes "当然，为什么不呢！";
		mes "我还会给你折扣！";
		mes "一颗钻石 55,000 Zeny，";
		mes "怎么样？";
		next;
		mes "[德韦恩]";
		mes "你需要多少";
		mes "颗钻石？";
		mes "如果改变主意，输入‘0’取消。";
		mes "";
		next;
		input .@amount;
		if (.@amount == 0){
			mes "[德韦恩]";
			mes "好吧，你取消了交易。";
			mes "保重！";
			mes "";
			close;
		}else if (.@amount < 1 || .@amount > 500){
			mes "[德韦恩]";
			mes "最大数量是 500。";
			mes "请输入 500 或更少。";
			mes "";
			close;
		}
		.@cost = .@amount * 55000;
		.@weight = .@amount * 100;
		if (Zeny < .@cost){
			mes "[德韦恩]";
			mes "呃……";
			mes "抱歉，你的钱不够。";
			mes "以这个价格卖我会亏本。";
			mes "";
			mes "";
			close;
		}
		if ((MaxWeight - Weight) < .@weight){
			mes "[德韦恩]";
			mes "呃……";
			mes "你携带的物品太多。";
			mes "背包没有空间我没法给你东西。把一些物品存进卡普拉仓库吧？";
			close;
		}
		Zeny = Zeny - .@cost;
		getitem 732,.@amount;
		mes "[德韦恩]";
		mes "谢谢你购买";
		mes "我的钻石！";
		mes "随时欢迎再来。";
		mes "";
		close;
	case 2:
		mes "[德韦恩]";
		mes "哈哈，谢谢~";
		mes "如果你需要钻石，";
		mes "欢迎来找我。";
		mes "我会以便宜价格卖给你。";
		mes "";
		mes "";
		close;
	}
}

// - Lusa's desk
// -----------------------------------------------------------------------------
iz_ac02,131,82,4	script	Lusa's Desk#ac	CLEAR_NPC,{
	if (nov_3_guns == 8) {
		mes "[Lusa's Desk]";
		mes "桌上有很多文件，似乎是普隆德拉和依斯鲁得居民的委托。";
		next;
	} else {
		mes "[Lusa's Desk]";
		mes "桌上堆着一叠文件。";
		close;
	}
	while(1) {
		.@gun_quest_01 = checkquest(5149,HUNTING);
		.@gun_quest_02 = checkquest(5150,HUNTING);
		.@gun_quest_03 = checkquest(5151,HUNTING);
		.@gun_quest_04 = checkquest(5152,HUNTING);

		if (.@gun_quest_01 == -1)
			.@gque_01$ = "^000000可接受^000000";
		else if (.@gun_quest_01 == 1)
			.@gque_01$ = "^0000FF进行中^000000";
		else if (.@gun_quest_01 == 2)
			.@gque_01$ = "^FF0000不可接受^000000";
		else
			.@gque_01$ = "^FF0000错误^000000";

		if (.@gun_quest_02 == -1)
			.@gque_02$ = "^000000Available^000000";
		else if (.@gun_quest_02 == 1)
			.@gque_02$ = "^0000FFIn Progress^000000";
		else if (.@gun_quest_02 == 2)
			.@gque_02$ = "^FF0000Not Available^000000";
		else
			.@gque_02$ = "^FF0000Error^000000";

		if (.@gun_quest_03 == -1)
			.@gque_03$ = "^000000Available^000000";
		else if (.@gun_quest_03 == 1)
			.@gque_03$ = "^0000FFIn Progress^000000";
		else if (.@gun_quest_03 == 2)
			.@gque_03$ = "^FF0000Not Available^000000";
		else
			.@gque_03$ = "^FF0000Error^000000";

		if (.@gun_quest_04 == -1)
			.@gque_04$ = "^000000Available^000000";
		else if (.@gun_quest_04 == 1)
			.@gque_04$ = "^0000FFIn Progress^000000";
		else if (.@gun_quest_04 == 2)
			.@gque_04$ = "^FF0000Not Available^000000";
		else
			.@gque_04$ = "^FF0000Error^000000";

		switch(select("委托 A ("+.@gque_01$+")", "委托 B ("+.@gque_02$+")", "委托 C ("+.@gque_03$+")", "委托 D ("+.@gque_04$+")", "取消")) {
		case 1:
			if (!.@gun_quest_01) {
				mes "这是<委托 A>的信息。";
				mes "委托人：孩子们";
				mes "村外有一只很凶的蜂兵，孩子们无法在外面玩耍。请消灭 10 只蜂兵。";
				next;
				if (select("接受委托", "查看其他委托", "取消") == 1) {
					setquest 5149;
					mes "你已收到^A2563E<委托 A>^000000详情。请按 ALT + U 查看。";
					next;
				}
			} else if (.@gun_quest_01 == 1) {
				mes "["+strcharinfo(0)+"]";
				mes "我正在进行这项任务。露莎说如果想放弃委托，就去找她。";
				next;
			} else if (.@gun_quest_01 == 2) {
				mes "["+strcharinfo(0)+"]";
				mes "我已经完成这项委托了。应该找露莎领取奖励。";
				next;
			}
			break;
		case 2:
			if (!.@gun_quest_02) {
				mes "这是<委托 B>的信息。";
				mes "委托人：居民 H";
				mes "最近罗达青蛙让我夜不能寐。请消灭 10 只罗达青蛙，让我好好休息。";
				next;
				if (select("接受委托", "查看其他委托", "取消") == 1) {
					setquest 5150;
					mes "你已收到^A2563E<委托 B>^000000详情。请按 ALT + U 查看。";
					next;
				}
			} else if (.@gun_quest_02 == 1) {
				mes "["+strcharinfo(0)+"]";
				mes "我正在进行这项任务。露莎说如果想放弃委托，就去找她。";
				next;
			} else if (.@gun_quest_02 == 2) {
				mes "["+strcharinfo(0)+"]";
				mes "我已经完成这项委托了。应该找露莎领取奖励。";
				next;
			}
			break;
		case 3:
			if (!.@gun_quest_03) {
				mes "这是<委托 C>的信息。";
				mes "委托人：可爱宠物研究学生";
				mes "我想要一只可爱的宠物陪我散步。能帮我捕获 10 只小野猪吗？";
				next;
				if (select("接受委托", "查看其他委托", "取消") == 1) {
					setquest 5151;
					mes "你已收到^A2563E<委托 C>^000000详情。请按 ALT + U 查看。";
					next;
				}
			} else if (.@gun_quest_03 == 1) {
				mes "["+strcharinfo(0)+"]";
				mes "我正在进行这项任务。露莎说如果想放弃委托，就去找她。";
				next;
			} else if (.@gun_quest_03 == 2) {
				mes "["+strcharinfo(0)+"]";
				mes "我已经完成这项委托了。应该找露莎领取奖励。";
				next;
			}
			break;
		case 4:
			if (!.@gun_quest_04) {
				mes "这是<委托 D>的信息。";
				mes "委托人：志愿吟游诗人";
				mes "听说一些摇滚蝗虫在举办歌唱比赛，但我迷路了。能帮我捕获 10 只摇滚蝗虫吗？总有一天摇滚蝗虫会从世界上消失！";
				next;
				if (select("接受委托", "查看其他委托", "取消") == 1) {
					setquest 5152;
					mes "你已收到^A2563E<委托 D>^000000详情。请按 ALT + U 查看。";
					next;
				}
			} else if (.@gun_quest_04 == 1) {
				mes "["+strcharinfo(0)+"]";
				mes "我正在进行这项任务。露莎说如果想放弃委托，就去找她。";
				next;
			} else if (.@gun_quest_04 == 2) {
				mes "["+strcharinfo(0)+"]";
				mes "我已经完成这项委托了。应该找露莎领取奖励。";
				next;
			}
			break;
		case 5:
			break;
		}
		mes "[Lusa's desk]";
		mes "桌上有很多文件，似乎是普隆德拉和依斯鲁得居民的委托。";
		next;
	}
}

iz_ac02_a,131,82,4	duplicate(Lusa's Desk#ac)	Lusa's Desk#ac_a	CLEAR_NPC
iz_ac02_b,131,82,4	duplicate(Lusa's Desk#ac)	Lusa's Desk#ac_b	CLEAR_NPC
iz_ac02_c,131,82,4	duplicate(Lusa's Desk#ac)	Lusa's Desk#ac_c	CLEAR_NPC
iz_ac02_d,131,82,4	duplicate(Lusa's Desk#ac)	Lusa's Desk#ac_d	CLEAR_NPC

// - Staff sent by guild
// -----------------------------------------------------------------------------
iz_ac02,162,86,4	script	Guild Staff#ac	4W_M_02,{
	if (!checkweight(1301,1)) {
		mes "- 你携带的物品太多。 -";
		close;
	}
	if (nov_3_guns < 8) {
		mes "[Sharp Snake's Fang]";
		mes "什——？我是学院派来的。";
		close;
	}
	disable_items;
	mes "[Sharp Snake's Fang]";
	mes "我是枪手公会的^A2563E尖牙蛇^000000。你需要什么？";
	next;
	if (select("交换枪械", "只是打个招呼") == 2) {
		mes "[Sharp Snake's Fang]";
		mes "你似乎就是我们兄弟提到的那个人。";
		next;
		mes "[Sharp Snake's Fang]";
		mes "不用担心，他说你做得很好！";
		close;
	}
	mes "[Sharp Snake's Fang]";
	mes "你想交换公会发放的武器吗？";
	next;
	mes "[Sharp Snake's Fang]";
	mes "先检查一下你的枪械状况。";
	next;
	.@gun = getequipid(EQI_HAND_R);
	.@equip_refine = getequiprefinerycnt(.@part);
	setarray .@card[0], getequipcardid(.@part,0), getequipcardid(.@part,1), getequipcardid(.@part,2), getequipcardid(.@part,3);
	if (.@gun == -1) {
		mes "[Sharp Snake's Fang]";
		mes "要继续，你必须装备武器。";
		close;
	}
	mes "[Sharp Snake's Fang]";
	mes "让我看看……";
	next;
	mes "[Sharp Snake's Fang]";
	if (.@gun == 13116) {// Novice_Revolver
		.@gun_code$ = "RV";
		.@now_gun$ = "Revolver";
		mes "你要交换公会发放的左轮手枪？";
	} else if (.@gun == 13180) {// Novice_Rifle
		.@gun_code$ = "RF";
		.@now_gun$ = "Rifle";
		mes "你要交换公会发放的步枪？";
	} else if (.@gun == 13181) {// Novice_Shotgun
		.@gun_code$ = "SG";
		.@now_gun$ = "Shotgun";
		mes "你要交换公会发放的霰弹枪？";
	} else if (.@gun == 13182) {// Novice_Gatling
		.@gun_code$ = "GT";
		.@now_gun$ = "Gatling";
		mes "你要交换公会发放的格林机枪？";
	} else if (.@gun == 13183) {// Novice_Grenade_Launcher
		.@gun_code$ = "GL";
		.@now_gun$ = "Grenade Launcher";
		mes "你要交换公会发放的榴弹发射器？";
	} else {
		mes "你使用的枪不是公会提供的。";
		close;
	}
	next;
	mes "[Sharp Snake's Fang]";
	mes "这把枪看起来状况良好。";
	next;
	mes "[Sharp Snake's Fang]";
	mes "请选择要用来交换当前"+.@now_gun$+"的初心者武器！";
	next;
	setarray .@selection_item_id[0], 13116, 13180, 13181, 13182, 13183;
	.@s = select("交换左轮手枪", "交换步枪", "交换霰弹枪", "交换格林机枪", "交换榴弹发射器", "取消") - 1;
	if (.@s != 5) {
		if (.@gun == .@selection_item_id[.@s]) {
			mes "[Sharp Snake's Fang]";
			mes "你已经有那把枪了，直接使用吧！";
			close;
		}
		// anti-hack
		if (callfunc("F_IsEquipIDHack", EQI_HAND_R, .@gun) || callfunc("F_IsEquipCardHack", EQI_HAND_R, .@card[0], .@card[1], .@card[2], .@card[3]) || callfunc("F_IsEquipRefineHack", EQI_HAND_R, .@equip_refine))
			close;

		delequip EQI_HAND_R;
		getitem .@selection_item_id[.@s],1;
	}
	mes "[Sharp Snake's Fang]";
	mes "枪械管理编号 ^FF0000"+.@gun_code$+""+rand(9)+""+rand(9)+""+rand(9)+""+rand(9)+""+rand(9)+""+rand(9)+"^000000。";
	next;
	mes "[Sharp Snake's Fang]";
	mes "有任何问题吗？";
	next;
	select("没有问题。" );
	mes "[Sharp Snake's Fang]";
	mes "珍惜你的枪械！";
	close;
}

iz_ac02_a,162,86,4	duplicate(Guild Staff#ac)	Guild Staff#ac_a	4W_M_02
iz_ac02_b,162,86,4	duplicate(Guild Staff#ac)	Guild Staff#ac_b	4W_M_02
iz_ac02_c,162,86,4	duplicate(Guild Staff#ac)	Guild Staff#ac_c	4W_M_02
iz_ac02_d,162,86,4	duplicate(Guild Staff#ac)	Guild Staff#ac_d	4W_M_02

// =============================================================================
// = Taekwon
// =============================================================================

// - Arang
// -----------------------------------------------------------------------------
iz_ac02,70,85,5	script	Arang#ac	4_F_TAEKWON,{
	mes "[Arang]";
	mes "嗨，早上好！";
	emotion ET_DELIGHT;
	cutin "arang03.bmp", 0;
	next;
	if (Class == Job_Novice) {
		if (isbegin_quest(4269) == 2) {
			if (nov_3_taekwon == 1) {
				if (JobLevel >= 10) {
					cutin "arang01.bmp", 0;
					mes "[Arang]";
					mes "该选择职业了吗？太拳"+(Sex == SEX_MALE ? "男孩" : "女孩")+"怎么样？你也可以成为像我一样优秀的大人。";
					next;
				}
				while (1) {
					switch(select("遵循太拳之道的人", "我要遵循太拳之道！！！", "早上好！现在……", "结束对话")) {
					case 1:
						mes "[Arang]";
						mes "想了解太拳男孩/女孩吗？你也想成为像我一样酷的人，对吧？";
						next;
						mes "[Arang]";
						mes "用正确的精神锻炼强健身体，让世界变得美好。这就是太拳的格言！";
						next;
						mes "[Arang]";
						mes "将来锻炼出更强的身体后，可以转职为^FF0000太拳大师^000000或^FF0000灵媒师^000000。";
						next;
						mes "[Arang]";
						mes "这条路并不容易。如果没有充分准备，我不建议你选择。但它确实值得追随！！";
						next;
						if (isequipped(2942) > 0 || countitem(2942) > 0) {
							mes "[Arang]";
							mes "职业介绍能让你更详细地了解太拳。";
							next;
						} else {
							mes "[Arang]";
							mes "如果你真的对太拳感兴趣，我建议你看看简短介绍。要使用吗？";
							next;
							if (select("我再看看。", "好，就这么做！") == 1) {
								mes "[Arang]";
								mes "每个冒险者都可以拥有自己的职业！希望你能找到想要的！";
								next;
							} else {
								getitem 2942,1;// Taekwon_Manual
								mes "[Arang]";
								mes "装备手册后打开技能窗口的[杂项]标签，就能看到一些技能。";
								next;
								mes "[Arang]";
								mes "^FF0000飞踢^000000是快速接近并攻击敌人的技能！充分体现了太拳的特色！";
								next;
								mes "[Arang]";
								mes "^FF0000暖风^000000是改变攻击属性的技能，是^FF0000无法使用武器的太拳^000000必备技能。";
								next;
								mes "[Arang]";
								mes "接受任务时可以体验太拳技能！一楼有一位熟练的教练。";
								next;
							}
						}
						break;
					case 2:
						mes "[Arang]";
						mes "想遵循太拳之道吗？让我看看……";
						next;
						if (JobLevel >= 10) {
							mes "[Arang]";
							mes "太拳之道要求自行艰苦训练，而不是向别人学习。不过如果你想追随，我可以推荐一位教练。";
							next;
							mes "[Arang]";
							mes "训练要靠你自己，但他会指导你。我可以带你过去。现在要去吗？";
							next;
							if (select("让我再想想。", "走吧！！") == 1) {
								mes "[Arang]";
								mes "请谨慎选择。这关系到你未来的冒险。";
								next;
							} else {
								mes "[Arang]";
								mes "从^FF0000西入口^000000进入城镇，经过酒馆、到达弓箭手城镇前，沿^FF0000北方^000000道路前进，就能找到一个和我长得一样的男孩。";
								next;
								setquest 13101;
								cutin "", 255;
								warp "pay_fild08", 148, 76;
								end;
							}
						} else {
							mes "[Arang]";
							mes "要遵循太拳之道，必须达到职业等级 10。想成为太拳，就训练到职业等级 10！";
							next;
							mes "[Arang]";
							mes "如果觉得独自训练困难，就去一楼拜访教练。";
							next;
						}
						break;
					case 3:
						mes "[Arang]";
						mes "啊哈哈……已经到时间了吗？我还在里面……别担心。";
						next;
						break;
					case 4:
						mes "[Arang]";
						mes "祝你今天愉快！";
						close2;
						cutin "", 255;
						end;
					}
				}
			} else {
				cutin "arang01.bmp", 0;
				mes "[Arang]";
				mes "如果你想成为用强大精神锻炼健康身体的太拳，这里能学到很多。";
				next;
				mes "[Arang]";
				mes "你觉得呢？对成为太拳感兴趣吗？我不勉强你！但如果你愿意，我可以成为你的教练……";
				cutin "arang02.bmp", 0;
				next;
				if (select("我感兴趣！", "我对你感兴趣！") == 1) {
					mes "[Arang]";
					mes "真的吗！？你愿意！？呀呼！我现在是老师了！想问什么都可以！";
					nov_3_taekwon = 1;
					emotion ET_SMILE;
					close2;
					cutin "", 255;
					end;
				}
				mes "[Arang]";
				mes "哈哈哈……你对我感兴趣？";
				emotion ET_FRET;
				cutin "arang03.bmp", 0;
				next;
				mes "突然，你看到阿朗的脚飞向你。";
				specialeffect2 EF_TRIPLEATTACK;
				emotion ET_KEK, playerattached();
				next;
				cutin "", 255;
				mes "你眼前只剩星星……";
				sc_start SC_BLIND,10000,0;
                sc_start SC_STUN,10000,0;
				percentheal -90,0;
				setquest 13102;
				close2;
				warp "iz_ac01", 53, 49;
				end;
			}
		} else {
			mes "[Arang]";
			mes "你看起来像个天真的新手？想加入这个职业的话，先去一楼登记再来。";
			close2;
			cutin "", 255;
			end;
		}
	} else {
		if (nov_3_taekwon > 0) {
			if (Class == Job_Taekwon) {
				mes "[Arang]";
				mes "你在认真训练吗？训练有成后，可以成为太拳大师或灵媒师。";
				close2;
			} else if (Class == Job_Star_Gladiator) {
				mes "[Arang]";
				mes "你成为优秀的太拳大师了！？请记住力量伴随着责任。";
				close2;
			} else if (Class == Job_Soul_Linker) {
				mes "[Arang]";
				mes "听说操控灵魂是非常细致的工作。太棒了！我带领的冒险者就这样成长起来了。";
				close2;
			} else {
				mes "[Arang]";
				mes "哎呀！我还以为你追随太拳之道~~虽然遗憾，但每个人都有自己的生活，嘿嘿。";
				close2;
			}
		} else {
			mes "[Arang]";
			mes "我正在宣传太拳之道！";
			close2;
		}
	}
	cutin "", 255;
	end;
}

iz_ac02_a,70,85,5	duplicate(Arang#ac)	Arang#ac_a	4_F_TAEKWON
iz_ac02_b,70,85,5	duplicate(Arang#ac)	Arang#ac_b	4_F_TAEKWON
iz_ac02_c,70,85,5	duplicate(Arang#ac)	Arang#ac_c	4_F_TAEKWON
iz_ac02_d,70,85,5	duplicate(Arang#ac)	Arang#ac_d	4_F_TAEKWON

iz_ac01,54,49,0	script	#acKick	HIDDEN_NPC,5,5,{
	end;

OnTouch:
	if (isbegin_quest(13102) == 1) {
		mes "我想不起来了，只感觉有什么东西撞到了我的头。";
		mes "^FF0000I should look for somebody to heal me nearby.^000000.";
		erasequest 13102;
		close;
	} else if (isbegin_quest(13102) == 2) {
		erasequest 13102;
		end;
	}
}


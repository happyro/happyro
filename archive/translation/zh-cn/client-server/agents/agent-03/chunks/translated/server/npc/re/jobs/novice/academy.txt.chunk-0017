				next;
				break;
			case 4:
				mes "[Lusa]";
				mes "呼~希望我回答了你的所有问题。这还是我第一次见到想学习其他职业的人。";
				next;
				mes "[Lusa]";
				mes "保重！";
				close2;
				cutin "", 255;
				end;
			}
			mes "[Lusa]";
			mes "还有其他问题吗？";
			next;
		}
		mes "[Lusa]";
		mes "呼~希望我回答了你的所有问题。这还是我第一次见到想学习其他职业的人。";
		next;
		mes "[Lusa]";
		mes "保重！";
		close2;
		cutin "", 255;
		end;
	}
	cutin "", 255;
	end;
}

iz_ac02_a,142,85,6	duplicate(Lusa#ac)	Lusa#ac_a	4_F_GUNSLINGER

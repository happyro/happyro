// - Captain Carocc (Ship)
// -----------------------------------------------------------------------------
int_land,78,103,5	script	Captain Carocc#intro_npc03	4_M_REINDEER,{
	switch( isbegin_quest(21008) ) {
	case 0:
		mes "[Captain Carocc]";
		mes "船舱里还有人？！";
		mes "至少你平安无事。";
		mes "你还好吗？";
		next;
		if (select("我没事，但其他人需要帮助。", "我想我是最后一个？") == 1) {
			mes "[Captain Carocc]";
			mes "还有其他人？";
			mes "我会派救援队去找他们。";
			mes "谢谢你的报告。";
		} else {
			mes "[Captain Carocc]";
			mes "好，那就好。";
			mes "暴风雨来得很突然，但我没想到它会给我们造成这么严重的影响。";
		}
		next;
		mes "[Captain Carocc]";
		mes "至少大多数人都安全了。";
		next;
		mes "[Captain Carocc]";
		mes "看那边的树，^4d4dff沿着它们向西南走^000000，就能找到一艘新船。";
		mes "那艘船会带你去^4d4dff伊兹鲁德^000000，也就是我们原本的目的地。";
		next;
		mes "[Captain Carocc]";
		mes "啊！说到这个，这座岛上的^4d4dff波利^000000会掉落一些可用于修理的材料。";
		next;
		mes "[Captain Carocc]";
		mes "^4d4dff猎杀波利，并把 2 个木材带给南边的船员^000000。";
		next;
		mes "[Captain Carocc]";
		mes "这任务很艰难，但看起来你足够强壮。";
		specialeffect2 EF_HEAL2;
		heal 9999,0;
		skilleffect 34,0;
		sc_start SC_BLESSING,240000,10;
		skilleffect 29,0;
		sc_start SC_INCREASEAGI,240000,10;
		if (isbegin_quest(21001) == 1) {
			completequest 21001;
			getexp 600,600;
		}
		setquest 21008;
		next;
		mes "[Captain Carocc]";
		mes "说到波利，你必须装备好装备。";
		mes "你应该装备一件^4d4dff武器和一件护甲^000000。";
		next;
		cutin "tutorial03",4;
		mes "！- 信息 -！";
		mes "^4d4dff双击装备即可装备，双击物品即可使用。";
		mes "按 Alt + E 或菜单按钮即可打开物品窗口。^000000";
		next;
		mes "！- 信息 -！";
		mes "按 Alt + Q 可以查看^4d4dff已装备的物品。";
		mes "双击或拖放即可装备或卸下物品。^000000";
		next;
		cutin "",255;
		mes "[Captain Carlock]";
		mes "你检查过所有装备了吗？";
		mes "应该完成^4d4dff技能点分配^000000。";
		next;
		mes "[Captain Carlock]";
		mes "为了顺利战斗，你必须合理分配能力点。";
		mes "^4d4dff想提高力量就要提升 Str^000000。^4d4dff想提高命中就要提升 Dex^000000。";
		break;
	case 1:
		mes "[Captain Carocc]";
		specialeffect2 EF_HEAL2;
		heal 9999, 0;
		skilleffect 34,0;
		sc_start SC_BLESSING,240000,10;
		skilleffect 29,0;
		sc_start SC_INCREASEAGI,240000,10;
		mes "^4d4dff船^000000停泊在西南方，会带你去伊兹鲁德。";
		mes "别忘了为船^4d4dff收集一些木材^000000。";
		next;
		mes "[Captain Carocc]";
		mes "别忘了提升你的^4d4dff技能^000000。";
		break;
	case 2:
		mes "[Captain Carocc]";
		mes "一切准备就绪，可以驶向伊兹鲁德了。";
		mes "船位于岛的西南部。";
		close;
	}
	next;
	mes "！- 信息 -！";
	mes "每提升一级，你都会获得^4d4dff属性加成。";
	mes "使用快捷键 Alt + A^000000 可以打开和关闭状态窗口。";
	next;
	mes "！- 信息 -！";
	mes "^4d4dff请合理分配战斗所需的属性点^000000。";
	next;
	mes "[Captain Carocc]";
	mes "猎杀波利，把木材带给船员。";
	mes "祝你好运！";
	close;

OnInit:
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "!isbegin_quest(21008) && Class == Job_Novice" );
	end;
}

int_land01,78,103,5	duplicate(Captain Carocc#intro_npc03)	Captain Carocc#intro_npc03_01	4_M_REINDEER
int_land02,78,103,5	duplicate(Captain Carocc#intro_npc03)	Captain Carocc#intro_npc03_02	4_M_REINDEER
int_land03,78,103,5	duplicate(Captain Carocc#intro_npc03)	Captain Carocc#intro_npc03_03	4_M_REINDEER
int_land04,78,103,5	duplicate(Captain Carocc#intro_npc03)	Captain Carocc#intro_npc03_04	4_M_REINDEER

//== Lumin (int_land) ==========================================
int_land,73,100,3	script	Lumin#new_ship	4_M_NOV_RUMIN,{
	if (isbegin_quest(7471) == 0) {
		cutin "nov_lumin01.bmp",0;
		mes "[Lumin]";
		mes ".............";
		mes "..?";
		next;
		cutin "fly_trock.bmp",2;
		mes "[Captain Carocc]";
		mes "做了个好梦吗？";
		mes "我们很快就要到伊兹鲁德了。到时候你可以和其他人交谈，就像刚才和我交谈一样。";
		next;
		mes "[Captain Carocc]";
		mes "我觉得那边的家伙失去了记忆，所以我给他取了个新名字。";
		mes "Lumin.";
		next;
		mes "[Captain Carocc]";
		mes "许多年轻人来到^4d4dff卢恩·米德加尔特王国^000000追寻梦想。";
		mes "伊兹鲁德是卢恩·米德加尔特王国首都普隆德拉的卫星城市。";
		next;
		mes "[Captain Carocc]";
		mes "伊兹鲁德总是欢迎像你这样刚开始世界旅程的年轻冒险者。";
		mes "当然，你也是其中之一。";
		next;
		mes "[Captain Carocc]";
		mes "我很想再告诉你一些故事，但现在该准备抵达了。";
		mes "伊兹鲁德有一所为你这样的新人的学院。";
		next;
		mes "[Captain Carocc]";
		mes "之后我再告诉你更多详情。我们在港口甲板见。";
		next;
		mes "[Captain Carocc]";
		mes "下船时，你应该进入那边的^4d4dff闪耀传送门^000000。";
		mes "所有传送都通过传送门进行。";
		setquest 7471;
		completequest 7471;
		next;
		cutin "nov_lumin01.bmp", 0;
		mes "[Lumin]";
		mes "是。";
		next;
		cloakonnpcself();
		cutin "fly_trock.bmp",2;
		mes "[Captain Carocc]";
		mes "哎呀。";
		mes "真是可爱的反应。";
		close2;
		cutin "",255;
		end;
	}
	cutin "nov_lumin01.bmp",0;
	mes "[Lumin]";
	mes ".....";
	next;
	select("我应该自我介绍吗？", "我叫～！");
	mes "[" + strcharinfo(0) + "]";
	mes "我是" + strcharinfo(0) + "!";
	next;
	mes "[Lu]";
	mes ".....";
	next;
	mes "[Lu]";
	mes ".....";
	mes "……所以呢？";
	next;
	cloakonnpcself();
	mes "- Lu 带着讥讽的表情走开了。-";
	next;
	cutin "fly_trock.bmp",2;
	mes "[Captain Carocc]";
	mes "看来……他性格很害羞。";
	mes "你去伊兹鲁德时，能去看看他吗？";
	next;
	mes "[Captain Carocc]";
	mes "接下来我会驾驶这艘船环绕岛屿航行。";
	mes "我们走吧？";
	close2;
	cutin "",255;
	end;

OnInit:
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "Class == Job_Novice && !isbegin_quest(7471) && isbegin_quest(21008) == 1" );
	end;
}
int_land01,73,100,3	duplicate(Lumin#new_ship)	Lumin#new_ship01	4_M_NOV_RUMIN
int_land02,73,100,3	duplicate(Lumin#new_ship)	Lumin#new_ship02	4_M_NOV_RUMIN
int_land03,73,100,3	duplicate(Lumin#new_ship)	Lumin#new_ship03	4_M_NOV_RUMIN
int_land04,73,100,3	duplicate(Lumin#new_ship)	Lumin#new_ship04	4_M_NOV_RUMIN

int_land,58,69,5	script	Sailor#intro_npc04	4W_SAILOR,{
	if (isbegin_quest(21008) == 1) {
		if (countitem(6008) < 2) {
			mes "[Sailor]";
			mes "这些波利偷走了我修船的材料。你能帮我拿回来吗？";
			mes "这座岛上有很多波利。";
			next;
			mes "[Sailor]";
			mes "如果你能帮忙，我会非常感激。";
			mes "我不能踏上这座岛。";
			mes "所以我才来请求你的帮助～";
			close;
		}
		mes "[Sailor]";
		mes "难以置信，太完美了！你愿意加入我的船员队伍吗？";
		mes "别说了！！";
		mes "来吧，我们准备启航了！";
		mes "非常感谢你！";
		next;
		mes "[Sailor]";
		mes "如果你想和我们一起航行到伊兹鲁德，就上船吧！";
		delitem 6008,2;
		getexp 100,100;
		getitem 611,5;
		completequest 21008;
		next;
		mes "[Sailor]";
		mes "哦，还有，拿着这些^4d4dff放大镜^000000。";
		mes "猎杀怪物时，你可能会发现^4d4dff未鉴定物品^000000。";
		next;
		mes "[Sailor]";
		mes "使用放大镜即可鉴定物品。";
		next;
		mes "[Sailor]";
		mes "也许你和那些波利战斗时已经获得了一些未鉴定物品？";
		close;
	}
	mes "[Sailor]";
	mes "船很快就要驶向伊兹鲁德了～！";
	mes "启航时我会通知你～！";
	close;

OnInit:
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "Class == Job_Novice && !isbegin_quest(21002) && isbegin_quest(21008) == 1" );
	end;
}

int_land01,58,69,5	duplicate(Sailor#intro_npc04)	Sailor#intro_npc04_01	4W_SAILOR
int_land02,58,69,5	duplicate(Sailor#intro_npc04)	Sailor#intro_npc04_02	4W_SAILOR
int_land03,58,69,5	duplicate(Sailor#intro_npc04)	Sailor#intro_npc04_03	4W_SAILOR
int_land04,58,69,5	duplicate(Sailor#intro_npc04)	Sailor#intro_npc04_04	4W_SAILOR

// - Captain Carocc
// -----------------------------------------------------------------------------
izlude,198,213,3	script	Captain Carocc#iz	4_M_REINDEER,5,5,{
	cutin "fly_trock.bmp", 2;
	if (Class == Job_Novice && BaseLevel < 15) {
		if (isbegin_quest(4269) == 2) {
			if (isbegin_quest(7471) == 2 || isbegin_quest(7472) > 0) {
				mes "[Carocc]";
				mes "哦，"+strcharinfo(0)+"!";
				mes "你为什么在码头？";
				mes "我猜你在学院过得不错。";
				next;
				mes "[Carocc]";
				mes "我会在这里停靠一阵子，修理船只。";
				mes "我会走之前尝试过的同一条路线。";
			} else {
				mes "[Carocc]";
				mes "嗯？你一定是克里图拉学院的学生吧？";
				mes "你之前在我的船上吗？";
				mes "嗯，我想不起来了。";
				next;
				mes "[Carocc]";
				mes "嗯，怎样都行。";
				mes "既然你说自己是学院学生，我要不要对你手下留情？";
				mes "不管怎样，我仍然是这艘船的船长。";
			}
			next;
			mes "[Carocc]";
			mes "修理完成后我就打算出发。";
			mes "到那时，通往^4d4dff灯塔^000000的路线也会开放。";
		} else {
			if (isbegin_quest(7471) == 2) {
				if (!isbegin_quest(7472)) {
					mes "[Carocc]";
					mes "这里就是伊兹鲁德。";
					mes "这是最适合你展翅追梦的城市。";
					next;
					mes "[Carocc]";
					mes "虽然我对你没有什么特别的感情，";
					mes "但我驾驶这艘船时见过许多像你一样的年轻人。";
					next;
					mes "[Carocc]";
					mes "他们之中有成功的，也有失败后无法适应而回去的。";
					mes "我希望你能在这里有一个成功的开始。";
					next;
					mes "[Carocc]";
					mes "你知道吗？";
					mes "伊兹鲁德有一所为你这样的新冒险者开设的新学院！";
					next;
					select("你是说学院？");
					mes "[Carocc]";
					mes "是的！它叫^4d4dff皇家克里图拉学院^000000。";
					mes "由卢恩·米德加尔特王室创建，用来帮助新冒险者。";
					next;
					mes "[Carocc]";
					mes "我的一位朋友在那里工作，我会把你介绍给他。";
					mes "他能让你的许多事情变得更容易。";
					next;
					mes "[Carocc]";
					mes "他通常在学院入口附近和新冒险者交谈。";
					mes "去那里见他吧。";
					next;
					if (!isbegin_quest(7473)) {
						mes "[Carocc]";
						mes "他的名字是^4d4dffHun^000000";
						mes "我会在地图上标出他的位置，去见他吧。";
						setquest 7472;
						viewpoint 1,122,207,0,0x4d4dff;
						next;
						mes "！- 信息 -！";
						mes "^4d4dff小地图位于屏幕右上角。";
						mes "可以用 + 放大、用 - 缩小。NPC 提供的路标会标记在上面。^000000";
						next;
						cutin "tutorial02.bmp", 4;
						mes "！- 信息 -！";
						mes "已从^4d4dffCaptain Carocc处接取任务。";
						mes "可以在任务窗口查看任务内容。";
						next;

	npctalk "芬里尔：永恒燃烧的烈焰，连灵魂都能灼焦的火焰！！现在在我面前出现！！", 'fenrir_7$;
	specialeffect EF_BEGINSPELL_YB, AREA, 'fenrir_7$;
	specialeffect EF_BOTTOM_BASILICA2, AREA, 'sarah_17$;

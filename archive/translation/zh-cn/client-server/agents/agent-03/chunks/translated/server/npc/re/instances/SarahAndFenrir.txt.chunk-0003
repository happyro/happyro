// Final room
1@glast,199,336,0	script	#glast_event_18	HIDDEN_WARP_NPC,10,10,{
	end;
OnTouch:
	disablenpc instance_npcname("#glast_event_18");
	setpcblock PCBLOCK_NPC, true;
	cutin "sarah_hero3.bmp",0;
	sleep2 1000;
	npctalk "莎拉·艾琳：等你等得仿佛过了永远~芬里尔。", 'sarah_17$;
	sleep2 3000;
	cutin "fenrir_b.bmp",2;
	npctalk "芬里尔：废话少说，现在交出哨兵微风！", 'fenrir_7$;
	sleep2 3000;
	cutin "sarah_hero3.bmp",0;
	npctalk "莎拉·艾琳：有本事就试试。", 'sarah_17$;
	sleep2 3000;
	cutin "fenrir_b.bmp",2;
	npctalk "芬里尔：莎拉可能不是你独自能对付的。我必须面对她！", 'fenrir_7$;
	sleep2 3000;
	npctalk "芬里尔：纯白枷锁，永恒牢狱，现在与我缔约！", 'fenrir_7$;
	donpcevent instance_npcname("#glast_event_18") + "::OnBar";
	sleep2 3000;
	npctalk "芬里尔：白色监禁！！", 'fenrir_7$;
	specialeffect EF_BOTTOM_BASILICA2, AREA, 'sarah_17$;
	sleep2 3000;
	npctalk "莎拉·艾琳：呃……他……", 'sarah_17$;
	npctalk "芬里尔：我会用白色监禁削弱莎拉，并在她被束缚时面对她，", 'fenrir_7$;
	sleep2 3000;
	npctalk "芬里尔：你负责处理她召唤的怪物。我就靠你了。", 'fenrir_7$;
	sleep2 3000;
	unittalk getcharid(3), "" + strcharinfo(0) + "：交给我吧。强大的敌人让我热血沸腾。";
	sleep2 6000;
	npctalk "芬里尔：趁莎拉陷入危急状态立即攻击并解决她，这是我们的策略。记住，对手很强。", 'fenrir_7$;
	sleep2 3000;
	cutin "sarah_hero3_2.bmp",0;
	npctalk "莎拉·艾琳：所以你们的计划就是用这种小把戏绑住我？", 'sarah_17$;
	sleep2 3000;
	npctalk "莎拉·艾琳：还借助这种菜鸟冒险者的力量……", 'sarah_17$;
	sleep2 3000;
	npctalk "莎拉·艾琳：你们和那把破剑一起从这里消失吧！！", 'sarah_17$;
	sleep2 3000;
	cutin "",255;
	hideonnpc 'sarah_17$;
	donpcevent instance_npcname("#glast_event_19") + "::OnEvent";
	monster 'map_glast$,200,336, "Sarah Irene#1",3190,1, instance_npcname("#fenrir_boss_final_1") + "::OnBossDead";	// MM_SARAH
	'boss_id = $@mobid[0];
	setpcblock PCBLOCK_NPC, false;
	end;
OnBar:
	progressbar_npc "000000",3, 'fenrir_7$;
	end;
}


//===== rAthena Script =======================================
//= Dungeon Signposts - Monster Info
//===== Description: =========================================
//= [Official Conversion]
//= Informations Boards about monsters.
//===== Changelogs: ==========================================
//= 1.0 Initial release. [Capuche] [Cydh]
//= 1.0.1 Typos clean up. [Aleos]
//============================================================

function	script	F_AvenBoard	{
	.@mo_board = select( "按楼层查找怪物",
					"怪物信息检索系统",
					( countitem(909) == 30000 ? "Request" : "" ),
					"取消" );
	if (.@mo_board == 1)
		return 1;
	else if (.@mo_board == 2) {
		while(1) {
			mes "[怪物信息检索系统]";
			mes "这里是怪物信息检索系统。可以搜索出现在该地下城中的怪物信息。搜索时请输入怪物名称，包括空格。";
			next;
			input .@inputstr$;
			setarray .@element$[0],"无属性","水","地","火","风","毒","圣","暗","念","不死";
			setarray .@size$[0],"中型","小型","大型";
			setarray .@race$[0],"无形","不死","动物","植物","昆虫","鱼类","恶魔","人形","天使","龙族";
			.@size = getargcount();
			.@i = 0;
			while( .@i < .@size && getarg(.@i+1,"") != .@inputstr$ ) .@i += 3;
			mes "[怪物信息检索系统]";
			mes "正在搜索";
			next;
			mes "[怪物信息检索系统]";
			mes "搜索完成。";
			mes "现在显示搜索结果。";
			next;
			mes "[怪物信息检索系统]";
			if (.@i >= .@size) {
				mes "没有该怪物的信息。";
				mes "请检查怪物名称。";
			}
			else {
				.@mob_id = getarg(.@i);
				mes "- 名称："+ getarg(.@i+1);
				mes "- 属性："+ .@element$[ getmonsterinfo(.@mob_id,MOB_ELEMENT) ];
				mes "- 大小："+ .@size$[ getmonsterinfo(.@mob_id,MOB_SIZE) ];
				mes "- 种族："+ .@race$[ getmonsterinfo(.@mob_id,MOB_RACE) ];
				mes "--------------------------------^FD8D02";
				mes getarg(.@i+2);
			}
			next;
			mes "[怪物信息检索系统]";
			mes "要搜索其他怪物信息吗？";
			next;
			if (select( "搜索","取消" ) == 1)
				continue;
			mes "[怪物信息检索系统]";
			mes "怪物搜索系统现在关闭。";
			next;
			return 2;
		}
	}
	else if (.@mo_board == 3) {
		mes "请求的信息会显示在这里——显示出来就没有问题。";
		next;
		return 3;
	}
	else if (.@mo_board == 4)
		close;
	else {
		mes "操作错误。";
		close;
	}
}

function	script	F_InfoBoard	{
	next;
	mes "[冒险者公会]";
	mes "如需更多怪物信息";
	mes "怪物信息检索系统";
	mes "必须使用。";
	next;
	return;
}

cmd_fild08,326,357,0	script	Signpost#Ant Hell 1	2_BULLETIN_BOARD,{
	while(1) {
		mes "[蚂蚁地狱]";
		mes "为了让冒险者在世界各地轻松冒险，公开从各地冒险者收集的信息。请向冒险者公会提供情报，以便修订信息。";
		mes "-- 冒险者公会 --";
		next;
		.@mo_board = callfunc( "F_AvenBoard",
			1005,"吸血蝙蝠","吸血蝙蝠是一种具有攻击性的蝙蝠生物，会给毫无防备的冒险者带来麻烦。",
			1097,"蚂蚁卵","它本身没有威胁，但会孵化出各种巨型蚂蚁。",
			1105,"迪诺","这只贪婪的工蚁不会主动攻击，但会吃掉附近掉落的物品。",
			1160,"皮耶","这只贪婪的工蚁不会主动攻击，但会吃掉附近掉落的物品。",
			1095,"安德烈","这只贪婪的工蚁不会主动攻击，但会吃掉附近掉落的物品。",
			1176,"维塔塔","这种体型较大的昆虫会为蚁群生产蜂蜜和蜂王浆。",
			1121,"地灵","这种小型恶魔妖精只会在地下城中少量出现。",
			1289,"玛雅紫","这只稀有的蚁后怪物被击杀后会掉落贵重矿物，但接近时要小心。",
			1147,"蚁后玛雅","出现在蚂蚁地狱第二层的 MVP，是更强大的玛雅紫变种。" );
		if (.@mo_board == 1) {
			mes "[蚂蚁地狱]";
			mes "蚂蚁地狱地下城遍布巨型昆虫，攻击其中一只时，其他昆虫可能会加入战斗。";
			next;
			while(1) {
				switch( select( "蚂蚁地狱 B1","蚂蚁地狱 B2","取消" ) ) {
				case 1:
					mes "[蚂蚁地狱 B1]";
					mes "------------ 怪物 ------------";
					mes "吸血蝙蝠(24)";
					mes "蚂蚁卵(28)";
					mes "迪诺(31)";
					mes "皮耶(32)";
					mes "安德烈(33)";
					mes "维塔塔(35)";
					mes "地灵(42)";
					mes "玛雅紫(81)";
					mes "--------------------------------";
					next;
					mes "<玛雅紫？和玛雅到底有什么区别！谁知道——我想知道葡萄杀手探险家。>";
					F_InfoBoard;
					continue;
				case 2:
					mes "[蚂蚁地狱 B2]";
					mes "------------ 怪物 ------------";
					mes "吸血蝙蝠(24)";
					mes "蚂蚁卵(28)";
					mes "迪诺(31)";
					mes "皮耶(32)";
					mes "安德烈(33)";
					mes "维塔塔(35)";
					mes "地灵(42)";
					mes "--------------------------------";
					next;
					mes "<蚂蚁女王！MVP 怪物玛雅！看起来真恶心——嗯？没拿到两个玛雅？好吧，我明白了。放下石头！——喜欢葡萄的玛雅探险家>";
					F_InfoBoard;
					continue;
				}
				break;
			}
		}
	}
}
cmd_fild08,341,84,0	duplicate(Signpost#Ant Hell 1)	Signposts#Ant Hell2	2_BULLETIN_BOARD

gef_tower,55,142,0	script	Signposts#Geffen Dungeon	2_BULLETIN_BOARD,{
	while(1) {
		mes "[吉芬地下城]";
		mes "注意！吉芬地下城有 3 层，对新冒险者来说非常危险。请向冒险者公会提供情报，以便修订信息。";
		mes "推荐等级约为 60～70 级。";
		next;
		.@mo_board = callfunc( "F_AvenBoard",
			1077,"毒 Spore","具有攻击性的蘑菇生物，建议携带绿色草药来抵抗它的毒性特殊攻击。",
			1031,"波波利","在沼泽地区发现的波利兄长。身体由有毒物质构成，比波利更坚固。",
			1035,"猎蝇","这是早期服事的天敌，一种出现在黑暗恶臭地点的致命飞行昆虫……",
			1015,"僵尸","到处可见的不死生物，僵尸单独时很弱，但数量多时会构成威胁。",
			1036,"食尸鬼","僵尸的古老变种，数百年的死亡让它成为更难对付的敌人。",
			1130,"杰克","这个长着可怕南瓜头的怪物会用火焰或诅咒攻击让人措手不及。",
			1111,"红蝙蝠","巨大丑陋的吸血蝙蝠。这种红色威胁在许多黑暗地下城都不受欢迎。",
			1061,"梦魇","不要试图骑上这匹幽灵马。",
			1204,"兽人英雄","一把出问题的魔法剑。",
			1179,"幽灵","看起来被床单覆盖的念属性怪物。普通武器对它的灵体无效。",
			1109,"小恶魔","恶魔学徒，对恶魔之道还不太熟悉。",
			1143,"傀儡娃娃","傀儡师最可怕的噩梦，傀儡娃娃能释放火焰或冰冻法术。",
			1046,"幽灵波利","会偷走他人外貌的恶魔。如果看到剑士从身后走来，先确认它不是邪恶怪物。",
			1389,"德古拉","这些 MVP 吸血鬼不会闪闪发光。^000000" );
		if (.@mo_board == 1) {
			mes "[吉芬地下城]";
			mes "你想查看地下城的哪一部分？";
			next;
			while(1) {
				switch( select( "吉芬地下城 B1","吉芬地下城 B2","吉芬地下城 B3","取消" ) ) {
				case 1:
					mes "[吉芬地下城 B1]";
					mes "------------ 怪物 ------------";
					mes "毒魔菇(26)";
					mes "波波利(30),";
					mes "猎蝇(63)";
					mes "--------------------------------";
					F_InfoBoard;
					continue;
				case 2:
					mes "[吉芬地下城 B2]";
					mes "------------ 怪物 ------------";
					mes "僵尸(17)";
					mes "红蝙蝠(47)";
					mes "食尸鬼(61)";
					mes "杰克(63)";
					mes "梦魇(69)";
					mes "兽人英雄(114)";
					mes "--------------------------------";
					next;
					mes "<这个地下城中会出现稀有的剑类怪物兽人英雄。>";
					F_InfoBoard;
					continue;
				case 3:
					mes "[吉芬地下城 B3]";
					mes "------------ 怪物 ------------";
					mes "幽灵(34)";
					mes "食尸鬼(61)";
					mes "猎蝇(63)";
					mes "梦魇(69)";
					mes "小恶魔(93)";
					mes "傀儡娃娃(90)";
					mes "--------------------------------";
					next;
					mes "<这里是恶魔小马、可爱恶魔和傀儡恶魔的栖息地。如果你喜欢恶魔，就应该来这里。>";
					F_InfoBoard;
					continue;
				}
				break;
			}
		}
	}
}

glast_01,372,298,0	script	Signposts#Glastheim	2_BULLETIN_BOARD,{
	while(1) {
		mes "[古城]";
		mes "古城是拥有无数层的大型地下城。推荐 70～130 级的冒险者前往。";
		mes "-- 冒险者公会 --";
		next;
		.@mo_board = callfunc( "F_AvenBoard",
			1036,"食尸鬼","被邪恶死灵法师诅咒复活的尸体。它会伏击附近的活物并吞食尸体来满足饥饿，但因为是复活尸体，永远无法真正满足。^000000",
			1186,"巨大幽灵","需要冒险者提供情报。",
			1111,"红蝙蝠","栖息在黑暗洞窟中的群居蝙蝠。它用巨大锋利的牙齿攻击附近生物并吸血。它比吸血蝙蝠更大。^000000",
			1195,"邪恶书","被恶魔力量赋予生命的魔法书。它没有情感和自我意识，只会依靠本能攻击活物。",
			1143,"傀儡娃娃","外形像木偶戏人偶的恶魔。普通武器对它的灵体无效。^000000",
			1191,"拟态","需要冒险者提供情报。",
			1203,"米斯提汀","它看似被封印的恶魔之刃，实际上是被链状怪物封印。它操纵被锁链束缚的剑发动攻击。",
			1208,"浪姬","复活为不死怪物的流浪武士。它使用曾经掌握的剑术攻击，精准到足以将飞虫斩成两半。",
			1219,"深渊骑士","侍奉传奇迷宫主人的恶魔骑士。它非常强大而残暴。",
			1320,"猫头鹰公爵","穿着蓝色披风的猫头鹰男爵兄弟。它喜欢下雨天。",
			1295,"猫头鹰男爵","穿着红色披风的鸟类怪物。被它绅士般的外表欺骗，就会遭到猛烈魔法攻击的伏击。",
			1194,"阿克鲁斯","拥有坚硬外壳的怪物。它会滚动身体，用外壳发动攻击。",
			1275,"爱丽丝","负责城堡各种杂务的自动人偶。它主要负责清洁周围环境，但会用钢制扫帚攻击入侵者。",
			1204,"兽人英雄","需要冒险者提供情报。",
			1179,"幽灵","看起来被床单覆盖的念属性怪物。普通武器对它的灵体无效。^000000",
			1015,"僵尸","被邪恶死灵法师困在腐烂尸体中的亡魂，被诅咒而无法感受痛苦地活着。它的不洁力量能够施加毒素。^000000",
			1209,"螃蟹","生活在地下城深处的啮齿动物。外形类似塔鲁，但更加凶猛，牙齿带有毒性。",
			1268,"血腥骑士","勇敢骑士的灵魂，被诅咒困在血腥铠甲中成为怪物。它强大到足以领导城堡骑士团。",
			1035,"猎蝇","鲜红色的苍蝇。敏捷是苍蝇的 3 倍，攻击力也高得多。玩家捕获的苍蝇宠物无法与猎蝇相比！“苍蝇与……”这个名字一定会在宠物饲养者中流行……^000000",
			1253,"石炮火树","长着巨大翅膀的低阶恶魔。它利用飞行能力在空中发动攻击。",
			1260,"暗黑祭司","被恶魔附身的镜子。它挂在墙上，直到有人靠近照镜子，或四处游荡寻找猎物。",
			1163,"瑞德利克","步兵的灵魂被诅咒困在铠甲中成为怪物。它唯一的目的就是驱逐城堡入侵者。",
			1276,"瑞德利克弓箭手","弓箭手的灵魂被诅咒困在铠甲中成为怪物。与瑞德利克不同，瑞德利克弓箭手使用弓进行远程攻击。",
			1192,"幽灵","心怀恶意的人死后被诅咒成为不死怪物。它相信献祭活物能让自己复活，并在阴暗角落悄悄寻找不幸的祭品。",
			1201,"利比奥","负责在旧监狱拷问囚犯的怪物。它总是戴着面具隐藏脸孔，害怕遭到报复。",
			1310,"牛魔人","外形像牛的怪物。挥舞锤子的力道比米诺斯猛烈得多。",
			1281,"贤者蠕虫","这些蠕虫拥有更高智慧，被其他蠕虫奉为神明。它是被动怪物，感到危险时只会用百科全书攻击。",
			1196,"骷髅囚犯","曾被不公正囚禁的犯人，死后成为怪物，只剩悔恨。",
			1207,"石头波利","浑身泥泞的怪物；攻击距离长，很难躲避。接近它时要小心。",
			1117,"邪恶德鲁伊","曾经骄傲的大神官，被恶魔的阴谋腐化并变成怪物。它仍保有前大神官的力量。",
			1257,"不公","需要冒险者提供情报。",
			1197,"僵尸囚犯","曾是城堡囚犯的尸体，复活为不死怪物。不再满足于怨恨囚禁自己的人，如今憎恨所有活物。",
			1200,"泽洛斯","来自恶魔族的女性。她强势的性格迫使人类作为奴隶服侍她。挥动鞭子时几乎不会失手。",
			1132,"卡利斯格","骑士的灵魂被诅咒困在铠甲中成为怪物。它仍保有身为骑士时的惊人力量。",
			1267,"卡拉特","外形像小丑的恶魔。它像小丑一样站在马戏球上行走，但是……",
			1202,"芬里尔","监狱顾问。它从出生起就戴着塑造脸型的面具，喜欢扭曲人们的心智。",
			1283,"奇美拉","由各种怪物部位组成的魔兽。它唯一的目的就是用强大攻击杀戮并摧毁目标。",
			1198,"黑暗祭司","需要冒险者提供情报。",
			1263,"风 念","需要冒险者提供情报。",
			1302,"暗黑幻影","黑暗领主的护卫。它从天空召唤陨石，仿佛要毁灭世界。",
			1272,"黑暗领主","强大的魔王。虽然无法发挥全部力量，但仍强大到挥手间就能摧毁普通冒险者。" );
		if (.@mo_board == 1) {
			mes "[古城]";
			mes "地下城由古老隧道连接的多个地下层组成。请准备好应对其中不死和恶魔怪物的攻击。";
			next;
			while(1) {
				switch( select( "取消","古城室内","古城 B1","古城 B2","古城骑士团 B1","古城骑士团 B2","古城圣堂","古城墓地","古城洞窟 B1","古城洞窟 B2","古城地下监狱 B1","古城地下监狱 B2","古城下水道 B1","古城下水道 B2","古城下水道 B3","古城下水道 B4","古城楼梯" ) ) {
				case 2:
					mes "[古城室内]";
					mes "------------ 怪物 ------------";
					mes "贤者蠕虫(70)";
					mes "邪恶书(74)";
					mes "暗黑祭司(76)";
					mes "傀儡娃娃(90)";
					mes "爱丽丝(100)";
					mes "浪姬(120)";
					mes "--------------------------------";
					F_InfoBoard;
					continue;
				case 3:
					mes "[古城 B1]";
					mes "------------ 怪物 ------------";
					mes "幽灵(34)";
					mes "贤者蠕虫(70)";
					mes "邪恶书(74)";
					mes "暗黑祭司(76)";
					mes "猫头鹰公爵(92)";
					mes "爱丽丝(100)";
					mes "卡拉特(103)";
					mes "猫头鹰男爵(120)";
					mes "--------------------------------";
					mes "中央 6 点钟方向——B2";
					mes "中央 9 点、3 点，大地图 1 点钟方向——地下监狱 B1";
					F_InfoBoard;
					continue;
				case 4:
					mes "[古城 B2]";
					mes "------------ 怪物 ------------";
					mes "拟态(59)";
					mes "奇美拉(70)";
					mes "邪恶书(74)";
					mes "邪恶德鲁伊(80)";
					mes "瑞德利克弓箭手(82)";
					mes "爱丽丝(100)";
					mes "兽人英雄(114)";
					mes "瑞德利克(115)";
					mes "卡利斯格(118)";
					mes "浪姬(120)";
					mes "深渊骑士(122)";
					mes "米斯提汀(130)";
					mes "--------------------------------";
					mes "大地图 6 点钟方向——B1";
					F_InfoBoard;
					continue;
				case 5:
					mes "[古城骑士团 B1]";
					mes "------------ 怪物 ------------";
					mes "巨大幽灵(66)";
					mes "邪恶书(74)";
					mes "瑞德利克弓箭手(82)";
					mes "爱丽丝(100)";
					mes "瑞德利克(115)";
					mes "卡利斯格(118)";
					mes "深渊骑士(122)";

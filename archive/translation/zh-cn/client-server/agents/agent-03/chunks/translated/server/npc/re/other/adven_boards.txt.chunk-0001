yuno_fild03,37,143,0	script	Signposts#Nogg Road	2_BULLETIN_BOARD,{
	while(1) {
		mes "[熔岩地下城]";
		mes "为了让冒险者在世界各地轻松冒险，公开从各地冒险者收集的信息。请向冒险者公会提供情报，以便修订信息。";
		mes "-- 冒险者公会 --";
		next;
		.@mo_board = callfunc( "F_AvenBoard",
			1381,"灰熊","栖息在岩浆流域的熊。它的毛皮看起来像在燃烧，深受毛皮爱好者欢迎。",
			1072,"卡浩","被火焰覆盖的恶魔。攻击华丽，但其实是攻击力较弱的低阶恶魔。",
			1383,"爆炎蝙蝠","栖息在岩浆流域的蝙蝠。它失去了超音速尖叫，换来了近乎完美的视力和发出强光的能力。",
			1367,"火焰妖","火球怪物。骨架维持着它的形状。",
			1366,"熔岩魔像","由硬化岩浆形成的魔像。拥有强大的力量。",
			1387,"吉格","栖息在这片潮湿地区的蝎子。它通过钻入沙中躲避热气，尾刺上覆盖着麻痹毒素。",

rebel_in,108,36,3	script	Master#16nego02	4_F_HUWOMAN,{
	if (checkweight(25155,3) == 0 || (MaxWeight - Weight) < 1000) {
		emotion ET_OHNO;
		mes "[Master]";
		mes "你的背包里物品太多。减轻负重后再回来吧，看起来太重了。";
		close;
	}
	if (terra_gloria_main < 17) {
		mes "[Master]";
		mes "仅限授权人员。请勿靠近。";
		close;
	}
	switch( checkquest(14612,PLAYTIME) ) {
	case -1:
		break;
	case 0:
	case 1:
		mes "[Master]";
		mes "冒险者，今天请好好休息。一定要照顾自己。";
		next;
		mes "[Master]";
		mes "明天见。";
		close;
	case 2:
		mes "[Master]";
		mes "欢迎回来，冒险者。身心休息得好吗？";
		next;
		mes "[Master]";
		mes "昨晚有很多武器没归还。我真得教训这些家伙……";
		next;
		mes "[Master]";
		mes "总之，我要靠你了。^0000cd从艾因布洛克下方找到可疑土堆^000000并调查。然后请^0000cd带回大约三把破损的枪^000000。";
		erasequest 14612;// Time for repair
		setquest 14611;// Gun recycling
		close;
	}

	// daily quest
	switch( isbegin_quest(14611) ) {
	case 0:
		break;
	case 1:
		mes "[Master]";
		mes "哈……有这么多人没有归还武器。";
		next;
		emotion ET_OHNO;
		mes "[" + strcharinfo(0) + "]";
		mes "嗯……";
		next;
		mes "[Master]";
		mes "欢迎回来，冒险者。你比我们预想的早回来。没有被怨念攻击吗？";
		next;
		mes "[Master]";
		mes "你带来了我说的东西？让我看看……";
		next;
		if (countitem(25153) < 3) {
			mes "[Master]";
			mes "嗯……不够。我让你带来^0000cd三把破损的枪^000000。";
			next;
			mes "[Master]";
			mes "^0000cdGo down from Einbech^000000 and investigate ^0000cdSuspicious Heap of earth^000000 in several places. Then you can find them.";
			next;
			mes "[Master]";
			mes "因为有怨念，我知道这不容易。但我们要依靠你。";
			close;
		}
		if (checkquest(14611,HUNTING) != 2) {
			mes "[Master]";
			mes "你带来了足够的破损枪械。但我们无法使用它们。";
			next;
			mes "[Master]";
			mes "我想你必须至少搜索五个土堆并击败约五个怨念。";
			next;
			mes "[Master]";
			mes "我知道你辛苦为我们带来它们。抱歉还要再拜托你。";
			close;
		}
		mes "[Master]";
		mes "天啊……太惊人了。你在这么短时间内找回了所有武器。他们竟然到处藏了这么多武器。";
		next;
		mes "[Master]";
		mes "冒险者，你今天一定累了。休息一下，明天^0000cd天亮^000000后再回来。";
		next;
		mes "[Master]";
		mes "非常感谢你。";
		erasequest 14611;// Gun recycling
		delitem 25153,3;// Broken_Gun_Wreck
		setquest 14612;// Time for repair
		getitem 25155,3;// Swz_Honor_Token
		getexp 200000,200000;
		close;
	case 2:
		end;
	}

	// first time
	switch( isbegin_quest(14610) ) {
	case 0:
		mes "[" + strcharinfo(0) + "]";
		mes "你好？我能看看周围吗？";
		next;
		mes "[Master]";
		mes "哦，你就是著名的冒险者。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "我因什么出名？";
		next;
		mes "[Master]";
		mes "他们说我们很久后又迎来了一位外来者，而这位外来者说服我们与政府合作。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "我没有做那么多。";
		next;
		mes "[Master]";
		mes "但我听到的就是这样。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "顺便问，这是什么地方？这里有这么多枪，我想这是军械库。";
		next;
		mes "[Master]";
		mes "差不多。我们在这里为叛乱军借出武器。";
		next;
		emotion ET_QUESTION, playerattached();
		mes "[" + strcharinfo(0) + "]";
		mes "他们有自己的武器。你们还借给他们更多？";
		next;
		mes "[Master]";
		mes "你说得对。但根据任务和情况，有时我们需要额外武器";
		next;
		mes "[Master]";
		mes "对于新人，我们不知道哪种枪适合他们。所以他们必须尝试许多不同的枪。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "所以他们可以在这里借。";
		next;
		mes "[Master]";
		mes "是. They must write down the period, names and the purpose on the ledger. When returning them, they only have to sign.";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "真麻烦。我以为你们会不经手续直接借出。";
		next;
		mes "[Master]";
		mes "起初，他们借还枪械不需要填写任何东西。但几乎没人归还。我们的资源有限，不能一直生产和购买武器。";
		next;
		mes "[Master]";
		mes "所以我们建立了这样的制度。这都是这里的人造成的。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "这是账簿……";
		next;
		mes "[Master]";
		mes "别仔细看。别忘了，你是外来者。";
		next;
		mes "[Master]";
		mes "请记住，我们最近一直是施瓦尔茨瓦尔德最神秘、最封闭的组织。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "真厉害。这些红线是什么？";
		next;
		mes "[Master]";
		mes "哈.......................................";
		emotion ET_OTL;
		next;
		mes "[Master]";
		mes "那些没有归还武器的人。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "这么多人……即使你们管理得很严格？";
		next;
		mes "[Master]";
		mes "因为这些不是他们的私人枪械，所以他们不在意。他们不明白必须小心使用。";
		next;
		mes "[Master]";
		mes "武器损坏后必须带回这里修理。但他们直接扔掉，即使我们处罚也不带回来，反而声称弄丢了。";
		next;
		mes "[Master]";
		mes "哦！太好了！冒险者，有时间能帮我们吗？";
		next;
		if (select( "我总是喜欢工作。", "对不起。我不能。" ) == 2) {
			mes "[" + strcharinfo(0) + "]";
			mes "突然？也许现在不行……";
			next;
			mes "[Master]";
			mes "嗯，这不紧急。有时间再找吧。";
			next;
			mes "[" + strcharinfo(0) + "]";
			mes "是. I will.";
			close;
		}
		mes "[" + strcharinfo(0) + "]";
		mes "突然？我总是喜欢工作。";
		next;
		mes "[Master]";
		mes "态度不错。看看那些有红线的人，找回他们扔掉的武器。";
		next;
		mes "[Master]";
		mes "他们执行任务时，大多会在武器损坏后找回。到达艾因贝赫时，他们想到我会责骂，就把武器扔掉。";
		next;
		mes "[Master]";
		mes "有时间时我会找回它们。有时也派新人去拿。但如你所见，我们最近很忙。";
		next;
		mes "[Master]";
		mes "一旦你触碰残骸……";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "会发生什么？";
		next;
		emotion ET_KEK;
		mes "[Master]";
		mes "哦……枪械怨念会出现并攻击你。你必须亲眼看看。眼见为实。";
		next;
		mes "[Master]";
		mes "去艾因贝赫下方原野的^0000cd几个地点^000000，在可疑土堆中找回^0000cd破损枪械^000000。";
		next;
		mes "[Master]";
		mes "让我从最新的开始看看……请带回^0000cd大约三把^000000。带太多的话很难修理。";
		setquest 14610;// Gun recycling
		close;
	case 1:
		mes "[Master]";
		mes "欢迎回来。带来我要求的东西了吗？";
		next;
		if (countitem(25153) < 3) {
			mes "[Master]";
			mes "嗯……不够。我让你带来三把破损的枪。";
			next;
			mes "[Master]";
			mes "从艾因贝赫下去，在几个地点调查可疑土堆，就能找到它们。";
			next;
			mes "[Master]";
			mes "因为有怨念，我知道这不容易。但我们要依靠你。";
			close;
		}
		if (checkquest(14610,HUNTING) != 2) {
			mes "[Master]";
			mes "你带来了足够的破损枪械。但我们无法使用它们。";
			next;
			mes "[Master]";
			mes "我想你必须至少搜索五个土堆并击败约五个怨念。";
			next;
			mes "[Master]";
			mes "我知道你辛苦为我们带来它们。抱歉还要再拜托你。";
			close;
		}
		mes "[Master]";
		mes "你带来的数量足够了。非常感谢。";
		next;
		mes "[Master]";
		mes "顺便说，他现在应该在这里。";
		next;
		cloakoffnpcself( "Daryl#16nego01" );
		mes "[Daryl]";
		mes "我在这里。";
		next;
		mes "[Master]";
		mes "你的武器呢？";
		next;
		mes "[Daryl]";
		mes "我没有。";
		next;
		mes "[Master]";
		mes "为什么？";
		next;
		mes "[Daryl]";
		mes "我弄丢了。";
		next;
		mes "[Master]";
		mes "见鬼，干得好。";
		next;
		mes "[Daryl]";
		mes "嗯，也不算干得好。";
		next;
		emotion ET_OK;
		mes "[Master]";
		mes "你做得很好。所以你又会弄丢武器，对吧？";
		next;
		mes "[Daryl]";
		mes "不.";
		next;
		mes "[Master]";
		mes "我告诉过你什么？你可以迷路，但绝不能弄丢武器！";
		next;
		mes "[Daryl]";
		mes "对不起。";
		emotion ET_SORRY, getnpcid(0, "Daryl#16nego01");
		next;
		mes "[Master]";
		mes "这不像道歉的态度。你弄丢了借来的东西。现在把你的交出来。";
		next;
		mes "[Daryl]";
		mes "不! Never! Don't touch me! Yikes!";
		emotion ET_HELP, getnpcid(0, "Daryl#16nego01");
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "嗯…… Can I leave now?";
		next;
		mes "[Daryl]";
		mes "不, you can't! I don't know who you are. But please save me!";
		next;
		mes "[Master]";
		mes "对！我们必须补偿你。先看看是谁扔掉了这个。";
		next;
		mes "[Master]";
		mes "让我看看……谁扔掉了这个……？序列号是……";
		next;
		mes "[Master]";
		mes "... Daryl?";
		next;
		mes "[Daryl]";
		mes "是吧？";
		next;
		mes "[Master]";
		mes "你上次借的武器……你说弄丢了，对吧？";
		next;
		emotion ET_SCRATCH, getnpcid(0, "Daryl#16nego01");
		mes "[Daryl]";
		mes "天啊。它为什么在那里……";
		next;
		mes "[Master]";
		mes "你求我给你武器！！就因为它不是你的，你就这样弄坏后扔掉？为什么不把自己的武器这样处理？";
		next;
		mes "[Daryl]";
		mes "我的女神！！我必须珍惜它！！！";
		next;
		mes "[Master]";
		mes "这不是第一次，而且我手里有确凿证据。你现在无话可说！";
		next;
		mes "[Master]";
		mes "我们会暂时保管你的女神。你去训练室好好反省！";
		next;
		cloakoffnpcself( "Trainee#16nego01" );
		cloakoffnpcself( "Trainee#16nego02" );
		mes "[Master]";
		mes "学员们！！！";
		npctalk "是!!", "Trainee#16nego01", bc_self;
		npctalk "是!!", "Trainee#16nego02", bc_self;
		next;
		mes "[Master]";
		mes "过来把他拖出去！";
		next;
		mes "[Daryl]";
		mes "什么？？？";
		next;
		mes "[Daryl]";
		mes "不！别瞄准我！我还不想死！！！对不起！是我的错！我再也不敢了！";
		emotion ET_CRY, getnpcid(0, "Daryl#16nego01");
		npctalk "走吧。", "Trainee#16nego01", bc_self;
		npctalk "这次我不会射偏。", "Trainee#16nego02", bc_self;
		next;
		cloakonnpcself( "Trainee#16nego01" );
		cloakonnpcself( "Trainee#16nego02" );
		cloakonnpcself( "Daryl#16nego01" );
		mes "[Master]";
		mes "你现在一定很累。休息一下。明天能靠你吗？有兴趣的话天亮后回来。";
		emotion ET_SWEAT, playerattached();
		next;
		mes "[Master]";
		mes "非常感谢你。";
		erasequest 14610;// Gun recycling
		setquest 14612;// Time for repair
		delitem 25153,3;// Broken_Gun_Wreck
		getitem 25155,3;// Swz_Honor_Token
		getexp 200000,200000;
		close;
	case 2:
		end;
	}
	end;

OnInit:
	.@terra_main$ = "terra_gloria_main > 16";
	questinfo( QTYPE_QUEST, QMARK_NONE, (.@terra_main$ + " && (checkquest(14610,HUNTING) == -1 || (checkquest(14610,HUNTING) == 2 && countitem(25153) > 2)) && checkquest(14612,PLAYTIME) == -1 && isbegin_quest(14611) == 0") );
	questinfo( QTYPE_QUEST, QMARK_NONE, (.@terra_main$ + " && (checkquest(14612,PLAYTIME) == 2 || (checkquest(14611,HUNTING) == 2 && countitem(25153) > 2))") );
	end;
}

ein_fild09,70,175,5	script	Suspicious Heap of Earth#1	4_SOIL,{
	if (isbegin_quest(14610) == 0 && isbegin_quest(14611) == 0)
		end;
	if (countitem(25153) >= 3) {	// what if true but hunting not completed?
		mes "[" + strcharinfo(0) + "]";
		mes "你已经找回足够多了。回去找 Master 吧。";
		close;
	}
	setpcblock PCBLOCK_NPC, true;
	npctalk "这里是埋葬破损枪械的土堆。挖开它，把枪械找回来。", "", bc_self;
	sleep2 1000;
	setpcblock PCBLOCK_NPC, false;
	npctalk "你试图找回破损枪械时，土堆动了起来，突然有什么东西冒了出来。", "", bc_self;
	getmapxy .@map$,.@x,.@y, BL_NPC;
	monster .@map$,.@x,.@y,"Grudge of Broken Gun",3629,1;
	.@r = rand(9);	// incomplete?
	if (.@r == 0) unittalk $@mobid[0], "Just leave me alone!";
	else if (.@r == 1) unittalk $@mobid[0], "Why did you abandon me!";
	else if (.@r == 2) unittalk $@mobid[0], "I will follow you till the end!!!!";
	else if (.@r == 3) unittalk $@mobid[0], "I can never forgive you who abandoned me!!!";
	else if (.@r == 4) unittalk $@mobid[0], "Let me show you what a biller grudge is all about!";
	else if (.@r == 5) unittalk $@mobid[0], "I knew we would meet again. I've waiting for this day to kill you.";
	else if (.@r == 6) unittalk $@mobid[0], "You said you needed me!!! Why did you abandon me!!";
	else if (.@r == 7) unittalk $@mobid[0], "So you are abandoning me again? Then let me kill you first!";
	else if (.@r == 8) unittalk $@mobid[0], "It's been cold and I was lonely waiting for you... Let us die together.";
	initnpctimer;
	disablenpc();
	end;
OnTimer300000:
	stopnpctimer;
	enablenpc();
	end;
}

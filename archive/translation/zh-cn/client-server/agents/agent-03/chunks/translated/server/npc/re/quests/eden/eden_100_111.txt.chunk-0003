	close2;
	cutin "",255;
	end;
}

moc_para01,41,95,5	script	Rohtert#12	4_M_ROTERT,{
	mes "[Rohtert]";
	if (!callfunc("F_HasEdenGroupMark")) {
		cutin "rote01",2;
		mes "你甚至不是伊甸园集团的成员。来这里做什么？";
		mes "我只接待基础等级^FF0000100～110^000000的冒险者。";
	}
	else {
		cutin "rote03",2;
		mes "......";
		next;
		mes "[Rohtert]";
		if (BaseLevel < 100)
			mes "真是个新手……再去训练吧。什么？不喜欢我说话的方式？那就变强。";
		else if (BaseLevel > 110) {
			mes "你是个过于成熟的冒险者。你和我没什么事。离开吧。我只接待等级110以下的新三转冒险者。";
			if (checkquest(13047,PLAYTIME) == 2)
				erasequest 13047;
			if (checkquest(13049,PLAYTIME) == 2)
				erasequest 13049;
			if (checkquest(13048,HUNTING) > -1)
				erasequest 13048;
			if (checkquest(13046,HUNTING) > -1)
				erasequest 13046;
		}
		else if (para_100lv01 < 2) {
			mes "喂，小鬼，你想从我这里得到什么？你以为我会说‘好吧，我当你师父，把知道的一切教给你’吗？";
			next;
			mes "[Rohtert]";
			mes "我不是慈善机构，滚吧。";
		}
		else if (para_100lv01 == 2) {
			mes "你是新冒险者？";
			next;
			mes "[Rohtert]";
			mes "有那么多事可做，你却在我这里浪费时间。去和Gelkah谈，她比我健谈多了。";
			next;
			mes "[Rohtert]";
			mes "你看起来勇敢，足以成为优秀冒险者，但在我眼里仍只是新手。";
			para_100lv01 = 3;
		}
		else if (para_100lv01 == 3) {
			mes "我以前和你一样是伊甸园集团的冒险者，不过当然，我是最优秀的。";
			next;
			mes "[Rohtert]";
			mes "我想我现在退休了，因为我的冒险技能太强，没法和你们这些孩子竞争。";
		}
		else if (para_100lv01 == 4) {
			mes "总之，我是在帮伊甸园集团。";
			next;
			mes "[Rohtert]";
			mes "我在找一个把友谊或忠诚看得像Spoon Stub一样的人。";
			next;
			if (select( "什么Spoon？", "你是坏人。" ) == 1) {
				cutin "rote03",2;
				mes "[Rohtert]";
				mes "知道吗？Spoon Stub。僵尸囚犯会掉落，看似有用，其实没什么价值。";
				next;
				mes "[Rohtert]";
				mes "总之，我猜你算是忠诚的人……大概吧……";
			}
			else {
				mes "[Rohtert]";
				mes "这让我感觉很奇怪。那不算坏，但我大概就是坏人，也不在乎。";
			}
			next;
			cutin "rote04",2;
			mes "[Rohtert]";
			mes "记得保持勇敢，你这个傻冒险者。";
		}
		else if (para_100lv01 == 5) {
			cutin "rote03",2;
			mes "好！你已经尽力了。";
			next;
			mes "[Rohtert]";
			mes "我担心你会变得像Gelkah。她像只迷路的小狗。别学她，好吗？";
		}
		else if (para_100lv01 == 6) {
			cutin "rote03",2;
			mes "你忙着到处奔波。";
			next;
			mes "[Rohtert]";
			if (checkquest(13046) == 2) {
				if (checkquest(13047,PLAYTIME) == 0) {
					mes "我的事情办完了。";
					mes "我负责清理文件。我讨厌做这种事。";
					next;
					mes "[Rohtert]";
					mes "我想还得再和他谈一次……明天再来！";
				}
				else if (checkquest(13047,PLAYTIME) == 2) {
					mes "哦，过了多久？";
					erasequest 13047;// Tendrilion Request Timer
				}
				else if (checkquest(13049,PLAYTIME) == 0)
					mes "白的是纸，黑的是字。我讨厌公文，但不得不做，所以会忙一阵子。";
				else if (checkquest(13048,HUNTING) == 1)
					mes "我知道猎杀Tens Drillion对你来说不算太难。";
				else if (checkquest(13048,HUNTING) == 2) {
					cutin "rote02",2;
					mes "很好！你正在成为优秀冒险者！加油！";
					erasequest 13048;// Tendrilion Request
					setquest 13049;// Tendrilion Request Timer
					getexp 352000,253000;
				}
				else {
					cutin "rote02",2;
					mes "Tens Drillion，我想我们该再教训它几次，让它知道谁才是老大！";
					next;
					if (select( "这次一定好好教训它。", "我觉得一次就够了。" ) == 2) {
						mes "[Rohtert]";
						mes "没关系，还有很多冒险者能做这件事。";
					}
					else {
						cutin "rote04",2;
						mes "[Rohtert]";
						mes "不是因为我胆小。";
						next;
						mes "[Rohtert]";
						mes "祝你好运。这次一定要彻底解决它。哈哈！";
						if (checkquest(13049,PLAYTIME) == 2)
							erasequest 13049;
						setquest 13048;// Tendrilion Request
					}
				}
			}
			else if (checkquest(13046,HUNTING) == 1)
				mes "还在吗，新手？如果一个人应付不了，就去找朋友，因为这可不容易。";
			else if (checkquest(13046,HUNTING) == 2) {
				mes "哦，你安全回来了！";
				mes "看来你不像我想的那样是个菜鸟。";
				completequest 13046;// Tendrilion Request
				setquest 13047;// Tendrilion Request Timer
				getexp 352000,253000;
			}
			else {
				cutin "rote04",2;
				mes "介意帮我跑个简单的差事吗？";
				next;
				if (select( "不介意！", "简单差事只有笨蛋才做。" ) == 2) {
					mes "[Rohtert]";
					mes "你真是个奇怪的冒险者……";
				}
				else {
					mes "[Rohtert]";
					mes "一个风和日丽的日子，我在米德加尔特联合军岗哨西南采花，以完成伊甸园集团的请求。";
					next;
					mes "[Rohtert]";
					mes "然后那家伙突然出现了。";
					next;
					select("什么家伙？");
					cutin "rote02",2;
					mes "[Rohtert]";
					mes "是^FF0000Tens Drillion。^000000";
					next;
					cutin "gelca03",2;
					mes "[^FF0000Gelkah^000000]";
					mes "糟糕！其实是^FF0000Tendrilion^000000！！师父！";
					next;
					cutin "rote04",2;
					mes "[Rohtert]";
					mes "好啦好啦，土豆都一样！";
					emotion ET_HNG;
					next;
					cutin "gelca02",2;
					mes "[^FF0000Gelkah^000000]";
					mes "......";
					next;
					cutin "rote04",2;
					mes "[Rohtert]";
					mes "直视野兽的眼睛时我们才发现，它看起来像狮子，却不是普通动物。";
					emotion ET_HNG;
					next;
					mes "[Rohtert]";
					mes "^8008F8我知道那是你死我活。^000000";
					next;
					mes "[Rohtert]";
					mes "当然我轻松打败了那头野兽！比从波利手里抢糖还容易。";
					next;
					mes "[Rohtert]";
					mes "但令我惊讶的是，野兽又站了起来。我只好再打倒它12次，它才不再起身。这不是普通的Tens Drillion。";
					next;
					mes "[Rohtert]";
					mes "听说它还在四处游荡，但我现在有点忙。";
					next;
					mes "[Rohtert]";
					mes "我想让你处理它。我一个人去没问题，但建议你多带几名冒险者。";
					next;
					select("你确定这是你自己做的吗？");
					mes "[Rohtert]";
					mes "重要的是我很强，不是次数。去那里解决野兽吧。";
					next;
					mes "[Rohtert]";
					mes "你会在灰色沃土米德加尔特联合军岗哨西边找到它。";
					next;
					select("看来我别无选择。");
					cutin "rote03",2;
					mes "[Rohtert]";
					mes "还在吗，新手？如果一个人应付不了，就去找朋友，因为这并不容易。";
					next;
					cutin "gelca02",2;
					mes "[^FF0000Gelkah^000000]";
					mes "……"+ strcharinfo(0) +"，等等……";
					next;
					cutin "gelca01",2;
					mes "[^FF0000Gelkah^000000]";
					mes "找到它时别害怕。师父才没有和Tendrilion战斗12次。";
					next;
					cutin "gelca03",2;
					mes "[^FF0000Gelkah^000000]";
					mes "其实师父醉得厉害，几乎不记得那件事。";
					next;
					cutin "gelca04",2;
					mes "[^FF0000Gelkah^000000]";
					mes "我只是觉得师父和一只Tendrilion战斗有点可爱，所以没管它。现在它成了问题。";
					next;
					cutin "gelca01",2;
					mes "[^FF0000Gelkah^000000]";
					mes "解决一只Tendrilion后再回来。还有，请对师父保密。";
					setquest 13046;// Tendrilion Request
				}
			}
		}
	}
	close2;
	cutin "",255;
	end;
}

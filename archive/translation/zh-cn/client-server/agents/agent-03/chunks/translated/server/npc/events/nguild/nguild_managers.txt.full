//===== rAthena Script =======================================
//= War of Emperium Managers for N Guild Castles
//===== By: ==================================================
//= kobra_k88
//===== Current Version: =====================================
//= 1.2
//===== Compatible With: =====================================
//= rAthena Project; RO Episode 4+
//===== Description: =========================================
//=
//==============================================
//= Break down of arguments used in the function:
//=   arg(0): name of Castle Manager
//=   arg(1): name of guild castle.
//=   arg(2): x1 coordinate for warp to treasure room
//=   arg(3): y1 coordinate for warp to treasure room
//=   arg(4): guild script suffix for kafra, etc.
//===== Additional Comments: =================================
//= 1.0 Based off existing guild scripts.  Do not know if it is accurate.[kobra_k88]
//= 1.1 Added modified guild manager function. [L0ne_W0lf]
//= 	Removed guardian summoning.
//= 1.2 Corrected function name. (bugreport:1728) [L0ne_W0lf]
//============================================================

//==============================================
function	script	F_GldManager	{
	.@npc_name$ = getarg(0);
	.@map_name$ = getarg(1);
	.@gid = getcastledata(.@map_name$,1);
	.@gm_name$ = getguildmaster(.@gid);

	mes "[ "+ .@npc_name$ +" ]";
	if (.@gid == 0){
		mes "我正在等待主人。勇敢的冒险者，追随你的命运吧！";
		return;
	}
	if (getcharid(2) != .@gid){
		mes "我只听从 ^5533FF" + getguildmaster(.@gid) + "^000000 的命令！嘿！你根本不是公会成员！！";
		mes "守卫在哪里？消灭这些入侵者！";
		return;
	}
	if (is_guild_leader() == false){
		mes "你不是 ^5533FF" + getguildmaster(.@gid) + "^000000！我只听从 ^5533FF" + getguildmaster(.@gid) + "^000000 的命令。";
		return 0;
	}

	mes "欢迎主人 ^5533FF" + getguildmaster(.@gid) + "^000000！我会尽力协助你！";
	next;

	menu "雇用/解雇卡普拉职员",M_Kaf, "进入宝物库",M_Treas, "取消",M_End;

	//===========================
	M_Kaf:
	//======
		mes "[ "+ .@npc_name$ +" ]";
		if (GetCastleData(.@map_name$,9) == 1) goto L_Dismiss;
		if (getgdskilllv(.@gid,10001) == 0){
			mes "主人，你还没有和卡普拉公司签订合同。";
			mes "要雇用卡普拉，必须先学习公会技能 ^5533FF卡普拉契约^000000。";
			return;
		}

		L_Hire:
			mes "要雇用卡普拉服务吗？需要支付 ^5533FF10,000 Zeny^000000……";
			next;
			menu "Employ Kafra.",-,"Cancel",sM_KafEnd;

				mes "[ "+ .@npc_name$ +" ]";
				if (Zeny < 10000){
					mes "主人，你没有足够的钱雇用卡普拉。雇用已取消。";
					return;
				}
				set Zeny,Zeny-10000;
				enablenpc "Kafra Staff#"+getarg(4);
				SetCastleData .@map_name$,9,1;
				mes "你已与卡普拉公司签订合同。";
				next;
				cutin "kafra_01",2;
				mes "[ Kafra Staff ]";
				mes "你好！我会为你提供贴心服务！我会尽力服务。";
				next;
				cutin "kafra_01",255;
				mes "[ "+ .@npc_name$ +" ]";
				//mes "Your employment contract lasts ^5533FF1 month^000000.  After this term is over you will have to create a new contract.";
				mes "我相信卡普拉职员会让公会成员受益。";
				return;

			sM_KafEnd:
				mes "[ "+ .@npc_name$ +" ]";
				mes "遵命，主人。不过我建议尽快雇用卡普拉！";
				return;

		L_Dismiss:
			mes "要解雇当前的卡普拉吗？";
			next;
			menu "Dismissal",-,"Cancel",sM_KafEnd2;

				cutin "kafra_01",2;
				mes "[ Kafra Staff ]";
				mes "我做错什么了吗？如果有，请原谅我。";
				next;
				menu "Dismiss",-,"Cancel",ssM_KafEnd2;

					mes "[ Kafra Staff ]";
					mes "真遗憾，我以后不能再为你的公会服务了……";
					next;
					disablenpc "Kafra Staff#"+getarg(4);
					SetCastleData .@map_name$,9,0;
					cutin "kafra_01",255;
					mes "[ "+ .@npc_name$ +" ]";
					mes "卡普拉已被解雇。不过……我们应该尽快再雇一名卡普拉！";
					return;
				ssM_KafEnd2:
					mes "[ Kafra Staff ]";
					mes "谢谢主人，我会尽力的！^^";
					cutin "kafra_01",255;
					return;
			sM_KafEnd2:
				mes "[ "+ .@npc_name$ +" ]";
				mes "主人，我认为应该留下当前的卡普拉职员，因为她已经在尽力服务我们。";
				return;

	//=========================
	M_Treas:
	//========
		mes "[ "+ .@npc_name$ +" ]";
		mes "要去宝物库吗？只有公会会长可以进入这个房间。";
		next;
		menu "Enter Treasure room.",-,"Cancel",sM_TresEnd;

			mes "[ "+ .@npc_name$ +" ]";
			mes "请沿秘密通道跟我来。";
			mes "出去时必须拉下秘密开关。";
			next;
			warp .@map_name$,getarg(2),getarg(3);
			return;
		sM_TresEnd:
			mes "[ "+ .@npc_name$ +" ]";
			mes "货物每天都会生产。";
			mes "有机会就应该领取，否则在错误的时间领取可能会消失。";
			return;


	//==========================
	M_End:
	//=======
		mes "[ "+ .@npc_name$ +" ]";
		mes "遵命，主人。";
		return;
}

// Castle 1 ==================================================================================
nguild_alde,218,175,0	script	Frolo	55,{
	callfunc "F_GldManager","Frolo","nguild_alde",119,223,"N01";
	close;
}


// Castle 2 ==================================================================================
nguild_gef,40,48,5	script	Leiber	55,{
	callfunc "F_GldManager","Leiber","nguild_gef",155,112,"N02";
	close;
}


// Castle 3 ==================================================================================
nguild_pay,120,58,4	script	Dundar	55,{
	callfunc "F_GldManager","Dundar","nguild_pay",290,7,"N03";
	close;
}


// Castle 4 ==================================================================================
nguild_prt,112,181,0	script	Thefton	55,{
	callfunc "F_GldManager","Thefton","nguild_prt",15,209,"N04";
	close;
}

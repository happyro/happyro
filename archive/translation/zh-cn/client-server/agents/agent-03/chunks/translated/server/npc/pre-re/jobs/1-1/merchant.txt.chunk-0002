		mes "[Union Staff Kay]";
		mes "嘿，你好。";
		mes "你来这里";
		mes "做什么？";
		next;
		switch(select("我的商人执照测试。:我在找兼职。:没什么。")) {
		case 1:
			mes "[Union Staff Kay]";
			mes "I see.";
			mes "好。";
			mes "你的名字";
			mes "是什么？";
			mes "" + strcharinfo(0) + "...?";
			next;

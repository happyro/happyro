			mes "He.........";
			getitem 6237,1; //Guarana_Fruit
			close;
		}
	}
	else {
		mes "- 孩子正在微笑。-";
		close;
	}
}

brasilis,56,224,7	script	Mage Paje#bra	4_M_BIBI,{
	mes "[Mage Paje]";
	mes "阿布拉卡达布拉~";
	specialeffect EF_POISONHIT,AREA,"Poring#bra";
	setarray .@display[0],800,876,909;
	setnpcdisplay "Poring#bra",.@display[rand(3)];
	if (brazil_gua != 5) close;
	next;
	mes "[Mage Paje]";
	mes "哦哦哦~！";
	mes "我有客人。";
	mes "很高兴见到你。";
	mes "我是魔法师帕杰。";
	next;
	mes "["+strcharinfo(0)+"]";
	mes "你好。Cherto 先生让我来找你。";
	next;
	mes "[Mage Paje]";
	mes "嗯……Cherto 先生？发生了什么？";
	mes "你是来询问许多奇怪传闻的吗？";
	next;
	mes "-你把字条交给帕杰-";
	next;
	mes "[Mage Paje]";
	mes "哦哦哦~";
	mes "嗯，天哪……原来是这样。";
	next;
	mes "[Mage Paje]";
	mes "我不能直接帮助你。";
	mes "但我会给你一个简单的魔法，让你自己找出答案。";
	next;
	select("什么魔法？");
	mes "[Mage Paje]";
	mes "这个魔法会让其他动物把你看成动物。很酷吧？";
	next;
	mes "[Mage Paje]";
	mes "好~我把魔法给你。";
	mes "大多数动物都很敏感，可能会察觉到。去野外找一只对魔法毫无察觉的巨嘴鸟。和它交谈时你就会明白。";
	next;
	mes "[Mage Paje]";
	mes "祝你好运~！";
	brazil_gua = 6;
	changequest 2195,2196;
	specialeffect2 EF_ASSUMPTIO;
	close;
}


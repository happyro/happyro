			mes "[Cherto]";
			mes "很久以前，瓜拉纳被用来缓解疾病和口渴。最近它因能恢复体力、促进血液循环而广受欢迎。";
			next;
			mes "[Cherto]";
			mes "虽然效果很好，但 Cherto 很遗憾地告诉你，我们已经弄不到它了。";
			next;
			select("什么——？？");
			mes "[Cherto]";
			mes "已经有一段时间，瓜拉纳浆果不再在这里生长了。";
			next;
			mes "[Cherto]";
			mes "即使 Cherto 找到一颗，也会很快腐烂。";
			next;
			mes "[Cherto]";
			mes "要是没发生这种事就好了！";
			next;
			select("你在说什么？");
			mes "[Cherto]";
			mes "安静！！！！！！！！";
			mes "这个故事是禁忌！可能有人在偷听我们的谈话……";
			next;
			mes "[Cherto]";
			mes "Cherto 告诉你的话，可能会给我们带来麻烦。但你看起来真的想知道，那我就给你一点提示。";
			mes "靠近些。Cherto 会小声说，免得被人听见。";
			brazil_gua = 2;
			close;
		}
	}
	else if (brazil_gua == 2) {
		mes "[Cherto]";
		mes "一个瓜拉纳男孩出生了。";
		next;
		select("瓜拉纳小孩？");
		mes "[Cherto]";
		mes "有一位精通植物学的女性。";
		mes "所有生物都很喜欢她。";
		next;
		mes "[Cherto]";
		mes "孩子出生前后，她开办了瓜拉纳农场。不知为何，她的兄弟嫉妒她，于是毁掉农场后消失了。";
		mes "就是这样的故事……";
		next;
		mes "[Cherto]";
		mes "我们不能确定那个孩子是否出生在这个世界，但从那时起，巴西里斯的瓜拉纳全都消失了。";
		next;
		mes "[Cherto]";
		mes "谁是瓜拉纳小孩？";
		mes "那个以贪婪闻名的佩德罗？";
		mes "无法忍受所有水果的梅托？";
		mes "性格阴沉的霍维纽？";
		mes "他们可能知道~！";
		next;
		mes "[Cherto]";
		mes "你呢？";
		mes "谁是瓜拉纳小孩？";
		mes "你能找出答案吗？呵呵呵呵~";
		brazil_gua = 3;
		changequest 2192,2193;
		close;
	}
	else if (brazil_gua == 3) {
		mes "[Cherto]";
		mes "你能找到瓜拉纳小孩吗？";
		mes "也许能？也许不能？";
		close;
	}
	else if (brazil_gua == 4) {
		mes "[Cherto]";
		mes "你找到瓜拉纳小孩了吗？";
		next;
		mes "- I tell Cherto about the kid making animal-like sounds. -";
		next;
		mes "[Cherto]";
		mes "哦哦。真难以置信。";
		mes "那个孩子可能就是瓜拉纳小孩。没错……";
		mes "传说中那孩子能和动物交谈。";
		next;
		mes "[Cherto]";
		mes "如果他能发出动物的叫声，也许就能和它们交流！";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "那么，我该怎么办？";
		mes "如果他就是传说中的孩子，有办法让瓜拉纳重新生长吗？";
		next;
		mes "[Cherto]";
		mes "哈哈！！Cherto 怎么说来着？";
		mes "Cherto 什么都知道~！！";
		mes "Cherto 已经想好";
		mes "下一步了。";
		next;
		mes "[Cherto]";
		mes "巴西里斯有一位魔法大师。";
		mes "他的名字是帕杰。";
		mes "把这张字条交给他。";
		mes "他会为你和那个孩子指引解决办法。";
		brazil_gua = 5;
		changequest 2194,2195;
		close;
	}
	else {
		mes "[Cherto]";
		mes "呵呵，挠痒~挠痒~~~~！！！";
		close;
	}
}

brasilis,203,64,3	script	Strange Kid#bra	4_M_KID1,{
	if (brazil_gua < 3) {
		mes "[Strange Kid]";
		mes "................";
		close;
	}
	else if (brazil_gua == 3) {
		mes "[Strange Kid]";
		mes "................";
		next;
		if(select("试着交谈。:假装路过。") == 2) {
			mes "[Strange Kid]";
			mes "................";
			close;
		}
		mes "我该对他说什么？";
		next;
		while(1) {
			switch(select("你叫什么名字？:你几岁了？:你在做什么？:结束交谈。")) {
			case 1:
				mes "[Strange Kid]";
				mes "Kaaaaaaao~";
				mes "Grrrrrrrrr - kaaan-";
				next;
				break;
			case 2:
				mes "[Strange Kid]";
				mes "Booooowoooooo-";
				mes "Booooowoooooo- -";
				next;
				break;
			case 3:
				mes "[Strange Kid]";
				mes "chamber pot braeee chamber pot brae chamber pot brae -";
				mes "Bbeeeebbeee -";
				next;
				break;
			case 4:
				mes "[Strange Kid]";
				mes "Kaaaaaaao~";
				mes "Grrrrrrrrr - kaaan-";
				next;
				mes "["+strcharinfo(0)+"]";
				mes "他发出像动物一样的奇怪声音。";
				mes "我要向 Cherto 请教吗？";
				brazil_gua = 4;
				changequest 2193,2194;
				close;
			}
		}
	}
	else if (brazil_gua == 4) {
		mes "["+strcharinfo(0)+"]";
		mes "他发出像动物一样的奇怪声音。";
		mes "我要向 Cherto 请教吗？";
		close;
	}
	else if ((brazil_gua > 4) && (brazil_gua < 9)) {
		mes "[Strange Kid]";
		mes "Ah...? ah.....?";
		close;
	}
	else if (brazil_gua == 9) {
		mes "[Strange Kid]";
		mes "ah... ahah.....";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "我没有故事可讲，但外面有很多朋友在等你。";
		next;
		mes "-你把羽毛、新鲜肉和葡萄枝交给孩子-";
		next;
		mes "[Strange Kid]";
		mes "Ah.............";
		next;
		mes "[Strange Kid]";
		mes "Un, uhh....";
		mes "mooo... mommy.....";
		next;
		mes "[Strange Kid]";
		mes "Ah..........";
		mes "bird....";
		mes "mon, mon, mon...key......";
		mes "boo, booow...........";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "狗？！";
		mes "呃，是的。很多朋友想见你。";
		mes "别再孤单了，和朋友们开心地生活吧。";
		next;
		mes "[Strange Kid]";
		mes "ah....he...hehe....";
		next;
		mes "-他开始微笑，轻轻笑了起来。-";
		next;
		mes "[Strange Kid]";
		mes "Ye......yes.......";
		mes "tha... than......thank......yo.........you.";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "真是可爱的笑容！";
		mes "永远做个快乐的孩子吧。";
		next;
		mes "[Strange Kid]";
		mes "Uh......";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "what?";
		next;
		mes "[Strange Kid]";
		mes "hey..........";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "你想说什么吗？";
		next;
		mes "-你靠近一些，假装小心翼翼。-";
		next;
		emotion ET_CHUP;
		mes "(kiss~)";
		next;
		mes "-孩子又轻轻笑了笑，然后把什么东西放进你手里。-";
		next;
		mes "-那是一颗红色坚硬的新鲜浆果。-";
		next;
		mes "[Strange Kid]";
		mes "ga...ra..........na...";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "哎呀，瓜拉纳浆果？";
		mes "啊！非常感谢你！";
		emotion ET_CHUPCHUP, playerattached();
		emotion ET_SMILE;
		next;
		mes "["+strcharinfo(0)+"]";
		mes "有了这个，我就能制作瓜拉纳糖果。";
		mes "我最好去找那个糖果制造者！";
		brazil_gua = 10;
		changequest 2199,2200;
		getitem 6237,1; //Guarana_Fruit
		close;
	}
	else if (brazil_gua == 10) {

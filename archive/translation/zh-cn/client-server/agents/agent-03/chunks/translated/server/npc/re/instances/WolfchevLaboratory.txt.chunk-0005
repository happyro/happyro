// Wolfchev - Final encounter
//============================================================
1@lhz,137,156,7	script	Wolfchev#last	4_LGTSCIENCE,{
	if ((MaxWeight - Weight) < 1000 || !checkweight(1201, 1)) {
		mes "^FF0000请检查背包。你携带的物品太多，无法继续任务。^000000";
		close;
	}
	for(.@i = 5113; .@i <= 5125; .@i++) {
		switch( checkquest(.@i,HUNTING) ) {
		case -1:
			break;
		case 0:
		case 1:
			.@all_quests_complete += 1;
			break;
		case 2:
			.@all_quests_complete += 2;
			break;
		}
	}
	if (.@all_quests_complete == 26) {
		// Quests Complete. Get Rewards.
		if (lght_duk01 == 8) {
			// First time beating the instance.
			mes "[Wolfchev]";
			mes "你终于打败了我的Boss生物。";
			next;
			mes "[Wolfchev]";
			mes "终于……这就是结果吗？？我到底为谁做实验？他们骗了我吗？";
			next;
			mes "[Wolfchev]";
			mes "这个按钮本应在紧急情况下按下……但是……";
			next;
			mes "[Wolfchev]";
			mes "嘿……你我因糟糕的契机相遇……";
			next;
			mes "[Wolfchev]";
			mes "但是……你帮助了我……你为什么要这么做？";
			next;
			mes "["+ strcharinfo(0) +"]";
			mes "第一次见到你时，你看起来疯狂却又悲伤，尽管你做着残酷可怕的实验。";
			next;
			mes "["+ strcharinfo(0) +"]";
			mes "但其实，你是因为孤独才这么做……所以才把心思全放在实验上，对吗？";
			next;
			mes "[Wolfchev]";
			mes "哈哈哈哈。孤独……你说？";
			next;
			mes "[Wolfchev]";
			mes "在你看来或许如此。但事实不是。孤独只是失败者好用又轻易的借口。";
			next;
			mes "[Wolfchev]";
			mes "我很享受追求完美的实验，从未感到孤独。";
			next;
			mes "[Wolfchev]";
			mes "总之，既然我发现雷根贝勒背叛了我，就不能任由他们为所欲为。";
			next;
			mes "[Wolfchev]";
			mes "暂时我会放过他们，但他们会为试图除掉Wolfchev而哭泣后悔。";
			next;
			mes "["+ strcharinfo(0) +"]";
			mes "... .... ... ....";
			next;
			lght_duk01 = 9;
			callsub L_Reward;
			mes "[Wolfchev]";
			mes "啊啊啊，"+ strcharinfo(0) +"，非常感谢你除掉那些发疯的孩子。礼物不贵，希望你别拒绝，我已经不需要它了。";
			next;
			mes "[Wolfchev]";
			mes "如果可以……希望你常回来，尤其带上朋友。我想让这里重新拥有人的温度，让悲伤消失。";
			next;
			mes "离开实验室前，我又看了Wolfchev一眼，感觉他已经不再执迷……";
			close2;
			warp "lhz_dun04", 147, 273;
			end;
		} else {
			mes "[Wolfchev]";
			mes "你确实打败了所有Boss生物。再次感谢。";
			next;
			callsub L_Reward;
			mes "[Wolfchev]";
			mes "我再说一次，"+ strcharinfo(0) +"，非常感谢你除掉那些发疯的孩子。礼物不贵，希望你别拒绝，我已经不需要它了。";
			next;
			mes "[Wolfchev]";
			mes "咔哈哈，再见。你现在想离开这里吗？";
			next;
			if (select("还不想", "是") == 1) {
				mes "[Wolfchev]";
				mes "那你想走时告诉我。";
				close;
			}
			mes "[Wolfchev]";
			mes "那我送你出去。";
			close2;
			warp "lhz_dun04", 147, 273;
			end;
		}
	} else {
		if (.@all_quests_complete == 0) {
			mes "[Wolfchev]";
			mes "我正在研究这个系统……不知道是谁制造的……但太复杂了，完全搞不懂……";
			next;
		} else {
			mes "[Wolfchev]";
			mes "咔咔咔……谢谢。你把那些Boss生物处理得很好……";
			next;
		}
		if (lght_duk01 == 7) {
			lght_duk01 = 8;
			mes "[Wolfchev]";
			mes "你苦战的时候……";
			next;
			mes "[Wolfchev]";
			mes "我发现了一些事情……系统错误让我们无法自由进出，所以72小时后你才能帮助我……回去休息后再来。";
			next;
			mes "[Wolfchev]";
			mes "啊……我可以把你送出实验室。要出去吗？";
			next;
		} else {
			mes "[Wolfchev]";
			mes "你现在想离开这里吗？";
			next;
		}
		if (select("还不想", "是") == 1) {
			mes "[Wolfchev]";
			mes "那你想走时告诉我。";
			close;
		}
		mes "[Wolfchev]";
		mes "那我送你出去。";
		close2;
		warp "lhz_dun04", 147, 273;
		end;
	}

L_Reward:
	for(.@i = 5113; .@i <= 5125; .@i++) {
		erasequest .@i;
	}
	.@r = rand(1, 1000);
	if      (.@r < 84)  getitem 2582,  1; //Salvage_Cape
	else if (.@r < 167) getitem 18570, 1; //Ancient_Gold_Deco
	else if (.@r < 250) getitem 1490,  1; //Giant_Lance
	else if (.@r < 333) getitem 16017, 1; //Bloody_Cross
	else if (.@r < 416) getitem 1291,  1; //Guillotine_Katar
	else if (.@r < 499) getitem 1584,  1; //Chilly_Spell_Book
	else if (.@r < 582) getitem 6471, 10; //Goast_Chill
	else if (.@r < 665) getitem 6470, 10; //Blood_Thirst
	else if (.@r < 748) getitem 6469, 10; //Will_Of_Warrior
	else if (.@r < 831) getitem 6471, 20; //Goast_Chill
	else if (.@r < 914) getitem 6470, 20; //Blood_Thirst
	else                getitem 6469, 20; //Will_Of_Warrior
	return;

OnInstanceInit:
OnDisable:
	disablenpc instance_npcname("Wolfchev#last");
	end;

OnEnable:
	enablenpc instance_npcname("Wolfchev#last");
	end;
}

//===== rAthena Script ======================================= 
//= Wanderer Job Quest
//===== By: ================================================== 
//= Muad_Dib, Meyraw
//===== Current Version: ===================================== 
//= 1.5
//===== Compatible With: ===================================== 
//= rAthena Project
//===== Description: ========================================= 
//= [Official Conversion]
//= Job change Quest from Dancer / Gypsy -> Wanderer.
//===== Additional Comments: ================================= 
//= 1.0 First Version.
//= 1.1 Updated dialogue to be more official / accurate. Huge thanks to Muad_Dib! [Masao]
//= 1.2 Fixed an endless loop in dialogue.
//= 1.3 Fixed a typo and added checkquest. [Joseph]
//= 1.4 Updated script, optimized. [Euphy]
//= 1.5 Added VIP features. [Euphy]
//============================================================

xmas,162,209,5	script	Aspiring Wanderer, Soy	714,{
	if (job_wan == 0) {
		mes "[Soy]";
		mes "Mimi，我该怎么办？";
		mes "我的心跳得好快。啊啊啊～";
		next;
		mes "[Mimi]";
		mes "你的脸为什么这么红？哈哈哈。";
		next;
		mes "[Soy]";
		mes "别取笑我，Mimi～";
		mes "我梦想登上舞者 Kim 的舞台已经很久了！";
		emotion ET_SHY, getnpcid(0, "Aspiring Wanderer, Soy");
		next;
		mes "[Soy]";
		mes "如果真的看到她像天使一样跳舞，我可能会激动得失去理智。";
		next;
		mes "[Mimi]";
		mes "冷静点，Soy。";
		mes "演出还没开始你就要晕倒了。哈哈。";
		next;
		mes "[Mimi]";
		mes "但我理解你的心情。";
		mes "很多人都期待见到世界上最优秀的浪姬。";
		if (BaseJob != Job_Dancer || BaseLevel < 99) close;
		next;
		select("舞者 Kim？:浪姬？");
		emotion ET_HUK, getnpcid(0, "Aspiring Wanderer, Soy");
		mes "[Soy]";
		mes "什么？你竟然不知道著名的浪姬舞者 Kim？";
		mes "天哪，天哪！！！";
		mes "看起来你懂舞蹈艺术，怎么会不知道她？";
		mes "哦，不！";
		next;
		mes "[Mimi]";
		mes "浪姬是随风与星辰漫游世界、崇尚自由的人。";
		mes "无论走到哪里，节奏与音乐都会伴随着她们。";
		next;
		mes "[Mimi]";
		mes "舞者 Kim 是最著名的浪姬，她与大师 Guitar Dong 组成 <Nollio> 组合巡演世界。";
		next;
		mes "[Mimi]";
		mes "Soy 和我都是憧憬成为浪姬的人，<Nollio> 很快会在镇上演出，我们非常期待观看。";
		next;
		mes "[Soy]";
		mes "如果你是真正的舞者，一定会被她的舞蹈震撼！";
		mes "Mimi，我总有一天能遇到像 Guitar Song 一样的大师吗？";
		next;
		emotion ET_SMILE, getnpcid(0, "Aspiring Wanderer, Soy");
		mes "[Mimi]";
		mes "坚持住，Soy。哈哈。";
		next;
		switch(select("演出在哪里？:结束对话。")) {
		case 1:
			mes "[Soy]";
			mes "就在圣诞树前！";
			mes "洁白的雪、美妙的旋律，还有我迷人的舞蹈。";
			mes "你不觉得这会是一场精彩的演出吗？";
			set job_wan,1;
			close;
		case 2:
			mes "[Mimi]";
			mes "如果你对成为浪姬感兴趣，随时都可以回来找我。虽然我并不完美，但我会尽力帮助你。";
			close;
		}
	} else if (job_wan == 1) {
		if (strnpcinfo(0) == "Aspiring Wanderer, Soy") {
			mes "[Soy]";
			mes "演出将在卢迪前方的圣诞树旁举行。";
			mes "我等不及了！啊～我都快失去理智了，Mimi。";
		} else {
			mes "[Mimi]";
			mes "浪姬的舞蹈魅力高于舞者或舞娘，任何人看到她们的演出都会为之倾倒。";
			next;
			mes "[Mimi]";
			mes "我想成为浪姬，但我现在还是舞者。";
			mes "但我认为^3131FF最好先学习舞娘的独特技能，再成为浪姬^000000。Soy 已经等不及要成为浪姬了。";
		}
		close;
	} else if (job_wan == 10) {
		mes "[Soy]";
		mes "<Nollio> 最棒了！！";
		close;
	} else {
		if (strnpcinfo(0) == "Aspiring Wanderer, Soy") {
			mes "[Soy]";
			mes "Mimi，我也想成为著名的浪姬。";
		} else {
			mes "[Mimi]";
			mes "我不知道自己是不是太贪心，但要成为浪姬，我必须学会舞者和舞娘的全部技能。";
		}
		close;
	}
}
xmas,163,209,3	duplicate(Aspiring Wanderer, Soy)	Aspiring Wanderer, Mimi	714

xmas,132,143,5	script	Performance Manager#wnd	713,{
	mes "[Performance Manager]";
	if (job_wan == 0) {
		mes "哦，我该怎么办？";
		close;
	} else if (job_wan == 1) {
		mes "哦，我该怎么办？";
		mes "他们为什么要这样做？";
		next;
		emotion ET_SHY, getnpcid(0, "Aspiring Wanderer, Soy");
		mes "[Performance Manager]";
		mes "嘿，那边的人！";
		mes "请听我说说这件事。";
		mes "其实我不该告诉任何人。";
		mes "但我实在不知所措，快要疯了。啊啊啊～～！";
		next;
		while (1) {
			set .@loop,0;
			switch(select("抱歉，我不在乎。:怎么回事？:你为什么要告诉我这些？")) {
			case 1:
				mes "[Performance Manager]";
				mes "这话有点过分了，你不觉得吗？";
				close;
			case 2:
				mes "[Performance Manager]";
				mes "演出马上就要开始了！";
				next;
				mes "[Performance Manager]";
				mes "那些人一点责任感都没有……";
				mes "大家都在期待他们，而我也为他们做了大量宣传。";
				next;
				set .@loop,1;
				break;
			case 3:
				emotion ET_ANGER;
				mes "[Performance Manager]";
				mes "我都说了我快被逼疯了！";
				mes "你根本不理解我！";
				next;
				break;
			}
			if (.@loop) break;
		}
		while (1) {
			set .@loop,0;
			switch(select("出什么问题了吗？:你指的是谁？:这和我无关。")) {
			case 1:
				mes "[Performance Manager]";
				mes "他们怎么能这样做？";
				mes "人们会扔雪球！";
				mes "说不定还会扔来一个大雪人，不行！";
				next;
				emotion ET_KEK;
				mes "[Performance Manager]";
				mes "人们可能会抓住我的衣领！！";
				mes "摇啊摇，晃啊晃！！";
				mes "太糟糕了。";
				next;
				set .@loop,1;
				break;
			case 2:
				mes "[Performance Manager]";
				mes "谁？！";
				mes "就是 <Nollio>！";
				mes "这也算问题？";
				mes "他们是世界上最糟糕的人。";
				next;
				break;
			case 3:
				mes "[Performance Manager]";
				mes "真是无情的话！";
				close;
			}
			if (.@loop) break;
		}
		while (1) {
			set .@loop,0;
			switch(select("你害怕人群吗？:演出者惹麻烦了吗？:别理他。")) {
			case 1:
				mes "[Performance Manager]";
				mes "如果你是我，面对所有人的目光难道不会害怕吗？";
				mes "我负责这场演出！很多人都期待观看，还有许多赞助商支持我们！我压力太大了。";
				next;
				break;
			case 2:
				mes "[Performance Manager]";
				mes "是的！";
				mes "<Nollio> 取消了演出！";
				next;
				mes "[Performance Manager]";
				mes "而且他们完全没有给我任何理由！";
				next;
				mes "[Performance Manager]";
				mes "更别提我为宣传和搭建舞台花的钱了……";
				mes "我该怎么应付那些愤怒的人？";
				next;
				set .@loop,1;
				break;
			case 3:
				mes "[Performance Manager]";
				mes "嘿，你要去哪儿！";
				close;
			}
			if (.@loop) break;
		}
		mes "[" + strcharinfo(0) + "]";
		mes "我看得出你担心这场演出会泡汤。";
		mes "你想办好演出来满足粉丝的期待。";
		next;
		mes "[Performance Manager]";
		mes "我真的不知道该如何处理。";
		mes "他们为什么突然取消演出？";
		mes "你知道吗？";
		next;
		mes "[Performance Manager]";
		mes "<Nollio> 为什么对我采取这种态度？";
		mes "是我犯了什么错吗？和他们签约后，我做了他们要求的一切！";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "因为……";
		input .@inputstr$;
		mes "^3131FF" + .@inputstr$ + "^000000";
		mes "……";
		next;
		emotion ET_ANGER;
		mes "[Performance Manager]";
		mes "你到底在说什么？";
		mes "你是因为我情绪不稳定才戏弄我吗？";
		next;
		mes "[Performance Manager]";
		mes "哦，我太担心了，心脏都在悸动，开始头晕了！";
		next;
		mes "[Performance Manager]";
		mes "嘿！你能出去找大师 Guitar Song 吗？";
		next;
		switch(select("啊，好吧。:我为什么要做？:我不去！")) {
		case 1:
			break;
		case 2:
			emotion ET_FRET;
			mes "[Performance Manager]";
			mes "你问我为什么！？";
			mes "啊，不……";
			mes "因为你看起来也是艺术家。";
			mes "你也想看演出，对吧？";
			next;
			break;
		case 3:
			mes "[Performance Manager]";
			mes "你真是铁石心肠……";
			close;
		}
		if (VIP_SCRIPT) {
			callfunc "VIP_Third_Class";
			set job_wan,2;
			setquest 2218;
			next;
		}
		mes "[Performance Manager]";
		mes "如果可以，我真想抓住他们的衣领！";
		mes "我真想问他们“为什么要毁掉演出？”但现在光是应付愤怒的赞助商就够难了……哦，不！";
		next;
		mes "[Performance Manager]";
		mes "我不知道 Guitar Song 在哪里，但很明显他喜欢去梦罗克赌场！";
		mes "呼，快点！！我真的头晕了！Guitar Song！！！";
		set job_wan,2;
		setquest 2218;
		close;
	} else if (job_wan == 2) {
		mes "我不确定 Guitar Song 是否在梦罗克，你应该去那里找他！";
		close;
	} else if (job_wan == 9) {
		mes "他们回来了！！";
		close;
	} else if (job_wan == 10) {
		mes "多亏了你，演出成功了。";
		mes "你真能干！";
		mes "作为回报，改天我会为你准备舞台。";
		close;
	}
	mes "啊啊啊，真让人分心！";
	close;
}

comodo,140,86,5	script	Cheerless Maestro	479,{
	if (job_wan < 2) {
		mes "[Cheerless Maestro]";
		mes "你会跳舞～";
		mes "你能完成工作～";
		mes "你是舞蹈女王～";
		mes "我是铃鼓之王～";
		next;
		mes "[Cheerless Maestro]";
		mes "呼……";
		close;
	} else if (job_wan == 2) {
		mes "[Cheerless Maestro]";
		mes "你会跳舞～";
		mes "你能完成工作～";
		mes "你是舞蹈女王～";
		mes "我是铃鼓之王～";
		next;
		mes "- You found a Maestro -";
		mes "- singing a weird song. -";
		next;
		if(select("好奇怪的歌。:无视它。") == 2) {
			mes "- 真是个奇怪的人，我还是离远点吧。-";
			close;
		}
		emotion ET_HUK;
		mes "[Cheerless Maestro]";
		mes "什么？！";
		mes "你竟敢无视我的不朽杰作《铃鼓之王》？你还是第一个打我脸的人。";
		next;
		select("我没有打你。");
		emotion ET_SURPRISE;
		mes "[Cheerless Maestro]";
		mes "哦！小姐，看你的样子一定是舞者吧？";
		next;
		mes "[Cheerless Maestro]";
		mes "你有一起旅行的吟游诗人或诗人吗？";
		mes "如果没有，和我组建一个巡回剧团怎么样？";
		next;
		mes "[Cheerless Maestro]";
		mes "团队的名字是《Guitar Song 的痛苦》。";
		mes "这个名字表达了创作艺术作品时所承受的煎熬痛苦。";
		next;
		mes "[Cheerless Maestro]";
		mes "这个名字很前卫，所以我认为团队一定会很受欢迎。";
		next;
		select("你是 Guitar Song？");
		emotion ET_SHY;
		mes "[Guitar Song]";
		mes "嗯……你现在才认出我，让我有点失望。";
		mes "没错，我就是著名组合 <Nollio> 中英俊的 Guitar Song。";
		mes "哈哈哈！";
		next;
		mes "[Guitar Song]";
		mes "怎么样？这个提议很诱人吧？";
		mes "我是正值人气巅峰的著名大师。人们都抢着和我合作，可你这位小姐却对我无动于衷。";
		next;
		select("舞者 Kim 在哪里？:你为什么取消演出？");
		mes "[Guitar Song]";
		mes "你为什么突然问我这个问题？";
		mes "来吧，我们还是聊点开心的事。";
		mes "舞者 Kim 和演出都与我无关。";
		next;
		select("你是什么意思？");
		mes "[Guitar Song]";
		mes "嘿，我说过别再谈这件事……";
		mes "我不想去想它，那只会让我难过。";
		next;
		mes "- Guitar Song is adamantly refusing to talk. What should I do to hear the story about <Nollio>? -";
		set job_wan,3;
		close;
	} else if (job_wan == 3) {
		mes "[" + strcharinfo(0) + "]";
		mes "(Would it be possible for me to make him tell me what happened with Nollio?)";
		next;
		switch(select("使用惊艳之舞:使用摇篮曲:使用幸运之吻")) {
		case 1:
			if (getskilllv("DC_UGLYDANCE") == 5 || rand(100) >= 80) {
				mes "- You get closer to Song's ear. -";
				next;
				mes "[" + strcharinfo(0) + "]";
				mes "好——";
				next;
				mes "[" + strcharinfo(0) + "]";
				mes "喂——！！！";
				specialeffect EF_STUNATTACK;
				next;
				mes "[Guitar Song]";
				mes "什……什么！！你在做什么？！";
				mes "你差点震坏我的耳膜。";
				emotion ET_FRET;
				next;
				mes "[" + strcharinfo(0) + "]";
				mes "嘿，振作起来！！！";
				next;
				mes "[Guitar Song]";
				mes "你在说什么？";
				next;
				mes "[" + strcharinfo(0) + "]";
				mes "你应该知道，人们都沉迷于你的音乐吧？";
				mes "这么多人满怀期待地支持你。";
				mes "你要违背承诺，让大家失望吗？连个理由都不给？";
				next;
			} else {
				mes "[" + strcharinfo(0) + "]";
				mes "好——";
				next;
				mes "[" + strcharinfo(0) + "]";
				mes "啊啊啊！！！";
				next;
				mes "[Guitar Song]";
				mes "你……你在做什么？！你怎么了！";
				mes "保安！！！";
				next;
				mes "[Black-suit Guards]";
				mes "请停下来。";
				close2;
				warp "comodo",117,98;
				end;
			}
			break;
		case 2:
			if (getskilllv("BD_LULLABY") == 0) {
				mes "- You cannot use this skill without learning it. -";
				close;
			}
			mes "[" + strcharinfo(0) + "]";
			mes "看来就算强迫他，我也得不到答案。";
			close;
		case 3:
			if (getskilllv("DC_FORTUNEKISS") == 0) {
				mes "- You cannot use this skill without learning it. -";
				close;
			}
			emotion ET_QUESTION, playerattached();
			mes "[" + strcharinfo(0) + "]";
			mes "啊，啊，我的 Guitar Song～";
			next;
			mes "[Guitar Song]";
			mes "什么？我起鸡皮疙瘩了。";
			next;
			emotion ET_QUESTION, playerattached();
			mes "[" + strcharinfo(0) + "]";
			mes "我关注 <Nollio> 已经好几年了。";
			next;
			mes "[Guitar Song]";
			mes "我当然知道我们这么受欢迎！哈哈哈！";
			next;
			emotion ET_QUESTION, playerattached();
			mes "[" + strcharinfo(0) + "]";
			mes "我看过其他大师的演出，但没有人比 Guitar Song 更优秀。";
			next;
			mes "[Guitar Song]";
			mes "嘿嘿嘿！没错，我知道自己超级厉害！";
			next;
			emotion ET_BEST, playerattached();
			mes "[" + strcharinfo(0) + "]";
			mes "哦……第一次听到 Guitar Song 的演出时，我立刻就迷上你了。";
			next;
			mes "[" + strcharinfo(0) + "]";
			mes "那感觉就像听到妈妈的摇篮曲～太美妙、太感人了……你是这个时代最优秀的艺术家。";
			next;
			specialeffect EF_STEAL;
			mes "[Guitar Song]";
			mes "哈哈哈。我当然知道，但听到你的赞美还是很开心！";
			next;
			mes "[" + strcharinfo(0) + "]";
			mes "所以我一直期待这次在卢迪观看你的演出。";
			mes "但听说演出取消后，我非常难过。";
			next;
			emotion ET_CRY, playerattached();
			mes "[" + strcharinfo(0) + "]";
			mes "现在我听不到 Guitar Song 的旋律了～～";
			mes "我想像美丽的蝴蝶一样随着你的音乐起舞。";
			mes "我的梦想现在真的无法实现了吗？呜呜……";
			next;
			mes "[Guitar Song]";
			mes "呼呼！不，不是那样……";
			next;
			emotion ET_CRY, playerattached();
			mes "[" + strcharinfo(0) + "]";
			mes "能亲自见到你我真的很开心，但我希望在美丽的雪城卢迪看到你的演出……呜呜……";
			next;
			emotion ET_CRY, playerattached();
			mes "[" + strcharinfo(0) + "]";
			mes "Guitar Song，你到底为什么不为我们演出？";
			mes "你不喜欢我吗？呜呜……";
			next;
			emotion ET_HUK;
			mes "[Guitar Song]";
			mes "不，不是因为那个！";
			next;
			mes "[" + strcharinfo(0) + "]";
			mes "那就请告诉我吧，我真的很喜欢你的音乐……但现在心情好低落……";
			emotion ET_QUESTION;
			next;
			break;
		}
		mes "[Guitar Song]";
		mes "哦，不！你知道……";

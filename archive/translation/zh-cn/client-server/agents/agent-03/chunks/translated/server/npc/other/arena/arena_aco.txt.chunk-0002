	end;

On04_Start:
	mapannounce "force_5-1","目标：消灭所有怪物！",bc_map|bc_npc;
	end;

On04_End:
	mapannounce "force_5-1","东侧出口已打开！",bc_map|bc_npc;
	end;

On05_Start:
	mapannounce "force_5-1","目标：击败石像鬼！",bc_map|bc_npc;
	end;

On05_End:
	mapannounce "force_5-1","南侧出口已打开！",bc_map|bc_npc;
	end;

On06_Start:
	mapannounce "force_5-1","目标：击杀所有卡利茨堡！",bc_map|bc_npc;
	end;

On06_End:
	mapannounce "force_5-1","南侧出口已打开！",bc_map|bc_npc;
	end;

On07_Start:
	mapannounce "force_5-1","目标：击杀1只远古木乃伊！",bc_map|bc_npc;
	end;

On07_End:
	mapannounce "force_5-1","西侧出口已打开！",bc_map|bc_npc;
	end;

On08_Start:

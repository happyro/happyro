ra_temin,73,126,1	script	Ladder#vol1	111,{
	if (aru_vol == 5) {
		mes "["+strcharinfo(0)+"]";
		mes "等等，我可以用这架梯子偷偷出去！我是偷偷进来的，要是直接经过卫兵肯定会被抓……";
		next;
		if (select("爬上梯子:取消") == 1) {
			mes "^3355FFYou climbed the";
			mes "爬上梯子越过墙，偷偷溜出去。^000000";
			close2;
			warp "ra_temin",74,136;
			end;
		}
		mes "^3355FFYou decided not to climb";
		mes "暂时爬上梯子。^000000";
		close;
	}
	end;
}

ve_in,280,223,0	script	#volroom	-1,2,2,{
OnTouch:
	if (aru_vol == 6) {
		mes "^3355FFThis house looks like";
		mes "这里废弃了一段时间：地板积满灰尘，还有许多废纸。^000000";
		next;
		mes "^3355FFOne particular piece";
		mes "一张纸引起你的注意。你捡起来读了读。^000000";
		next;
		mes "[Paper]";
		mes "''^333333The regularly scheduled";
		mes "地质调查已经推迟一周多。请尽快向我们提交报告。^000000''";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "虽然信上没有寄件人姓名，但我能猜到是谁写的。说起来……地质学家在哪里？";
		set aru_vol,7;
		close;
	}
	else if (aru_vol < 6) {
		mes "^3355FFThis house looks like";
		mes "这里废弃了一段时间：地板积满灰尘，还有许多废纸。^000000";
		close;
	}
	end;
}

veins,159,171,3	script	Towner#vol	945,{
	mes "[Towner]";
	mes "楼上的小办公室";
	mes "2nd floor of this weapon";
	mes "被一名地质学家占用。至少，他应该是……";
	next;
	mes "[Towner]";

	close;
}

ve_in,233,116,3	script	Drunken Man#vol	901,{
	if ((MaxWeight-Weight) < 2000 || checkweight(1201,1) == 0) {
		mes "^3355FFWait a second!";
		mes "你现在携带的物品太多了。请使用卡普拉服务存放一些物品后再回来。^000000";
		close;
	}
	if (aru_vol < 7) {
		mes "[Drunken Man]";
		mes "所以……^333333*嗝*^000000";
		mes "然后我就说……";
		next;
		mes "[Drunken Man]";
		mes "''^3131FFHey, buddy! A man";
		mes "要用背来说话，";
		mes "而不是用拳头！想找我麻烦？放马过来！^000000''";
		next;
		mes "[Drunken Man]";
		mes "然后他吓得落荒而逃！";
		mes "哈哈哈哈！看来我";
		mes "很强悍，对吧？";
		next;
		emotion ET_THROB, getnpcid(0, "Drunken Lady#1");
		emotion ET_THROB, getnpcid(0, "Drunken Lady#2");
		mes "[Ladies]";
		mes "我的天！";
		mes "你太酷了～！";
		next;
		mes "[Drunken Man]";
		mes "嗯……谁都会这么做。";
		mes "我只是表现得像个绅士。";
		mes "哈哈哈，没错！";
		close;
	}
	else if (aru_vol == 7) {
		mes "[Drunken Man]";
		mes "所以……^333333*嗝*^000000";
		mes "然后我就说……";
		next;
		mes "[Drunken Man]";
		mes "''^3131FFHey, buddy! A man";
		mes "要用背来说话，";
		mes "而不是用拳头！想找我麻烦？放马过来！^000000''";
		next;
		mes "[Drunken Man]";
		mes "然后他吓得落荒而逃！";
		mes "哈哈哈哈！看来我很强悍，对吧？";
		next;
		emotion ET_THROB, getnpcid(0, "Drunken Lady#1");
		emotion ET_THROB, getnpcid(0, "Drunken Lady#2");
		mes "[Ladies]";
		mes "我的天！";
		mes "你太酷了～！";
		next;
		mes "[Drunken Man]";
		mes "嗯……谁都会这么做。";
		mes "我只是表现得像个绅士。哈哈哈，没错！";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "不好意思，请问你是";
		mes "维因斯地质队的执行主任吗？";
		next;
		mes "[Drunken Man]";
		mes "当然！执行主任、副主任、主任、研究员、CEO，";
		mes "不……等等，最后一个听起来不太对。哈！";
		mes "这些职位我全都兼任～";
		next;
		mes "[Drunken Man]";
		mes "我是执行主任……";
		mes "其实研究所只有我一个人在工作。";
		mes "你找我有什么事？";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "呃……办公室里有一些给你的正式通知。";
		mes "我想你需要完成一些调查？";
		mes "听起来相当重要。";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "也许……";
		mes "甚至是^FF0000紧急^000000的。";
		next;
		mes "[Drunken Man]";
		mes "什——？等等，今天是几号？可恶！";
		mes "好吧好吧，该工作了。";
		mes "偏偏在我正玩得开心的时候！";
		mes "啊，我真不想清醒！";
		next;
		mes "[Drunken Man]";
		mes "但是……工作是我负担这些酒钱的唯一办法……";
		mes "这就是人生。这就是人生。";
		next;
		mes "[Ladies]";
		mes "你要去哪里？";
		mes "不能再多待一会儿和我们聊聊吗？求求你？";
		next;
		mes "[Drunken Man]";
		mes "抱歉，女士们，";
		mes "职责在召唤我。";
		mes "哈哈哈哈哈～";
		next;
		emotion ET_THROB, getnpcid(0, "Drunken Lady#1");
		emotion ET_THROB, getnpcid(0, "Drunken Lady#2");
		mes "[Ladies]";
		mes "请别走～";
		next;
		mes "[Drunken Man]";
		mes "咳咳！";
		mes "让我想想。";
		mes "怎样才最好呢……？";
		mes "..............................";
		mes "..............................";
		mes "..............................";
		next;
		mes "[Drunken Man]";
		mes "..............................";
		mes "..............................";
		mes "........................Right!";
		next;
		mes "[Drunken Man]";
		mes "喂，你。";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "什么？";
		next;
		emotion ET_BEST;
		mes "[Drunken Man]";
		mes "我现在任命你为维因斯地质研究所的首席研究员。";
		mes "恭喜！欢迎加入团队，朋友！";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "嗯……？";
		mes "我不明白你在说什么！";
		next;
		mes "[Drunken Man]";
		mes "嘿！我愿意收你为学生，";
		mes "你应该心怀感激！";
		mes "能拜在我——世界最伟大的地质学家 Gio——门下，人人都会自豪！";
		mes "（大概吧。）";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "等等，我从没——";
		next;
		mes "[Geologist Gio]";
		mes "啊啊！既然你是我的学生，";
		mes "想学到东西就得努力工作。";
		mes "首先，去我的办公室，";
		mes "把拖延的事务处理好。";
		next;
		mes "[Geologist Gio]";
		mes "拿着这本^FF0000参考指南^000000去我的办公室。";
		mes "检查我的桌子时，你会找到^FF0000高温计^000000和^FF0000报告表^000000。";
		mes "把这些东西全部带到托尔火山。";
		next;
		mes "[Geologist Gio]";
		mes "到达托尔火山后，用高温计测量火山温度，";
		mes "并填写报告表。";
		next;
		mes "[Geologist Gio]";
		mes "把填好的报告表带到火山深处的地质营地，";
		mes "让他们盖章确认。";
		mes "这不难，对吧？";
		next;
		mes "[Geologist Gio]";
		mes "啊，我也决定收这些可爱的女士们为学生～";
		mes "我应该留在这里给她们讲课。";
		next;
		emotion ET_THROB, getnpcid(0, "Drunken Lady#1");
		emotion ET_THROB, getnpcid(0, "Drunken Lady#2");
		mes "[Ladies]";
		mes "哦～！你真的要教我们地质学吗？";
		next;
		mes "[Geologist Gio]";
		mes "对了！你在地质营地提交报告时，";
		mes "他们问起火山温度，就编一个答案。";
		mes "一定要说得很严重！";
		next;
		mes "[Geologist Gio]";
		mes "‘爆炸’、‘灾难’和‘附带损害’之类的词就很合适。";
		mes "做好你的部分，剩下的交给我。好～";
		mes "快回来，我的学生！";
		next;
		mes "^3355FF嗯，这和你预想的不同，";
		mes "但你感觉一切最终会对你有利。";
		mes "你也有这种感觉，对吧？^000000";
		changequest 2116,2117;
		set aru_vol,8;
		getitem 7705,1; //Note_Of_Geologist
		close;
	}
	else if ((aru_vol > 7) && (aru_vol < 24)) {
		mes "[Geologist Gio]";
		mes "喂，你最好快点。";
		mes "那份通知是你在我办公室找到的，对吧？";
		mes "你知道这项工作对我们有多重要！";
		next;
		mes "[Geologist Gio]";
		mes "拿上高温计，去托尔火山填写报告表，";
		mes "然后提交给地质营地！";
		close;
	}
	else if (aru_vol == 24) {
		mes "[Geologist Gio]";
		mes "嗯，那双腿不错，";
		mes "但不是我见过最好的——";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "我回来了。";
		next;
		mes "[Geologist Gio]";
		mes "*咳*这就是侵蚀……的原理。明天我会教你们所有岩石知识。";
		next;
		mes "[Geologist Gio]";
		mes "欢迎回来！火山温度报告怎么样？";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "我照你说的做了。嘿，你确定要我夸大温度吗？营地怎么办？";
		next;
		mes "[Geologist Gio]";
		mes "哦，别担心温度。它本来就该升高。";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "你在说什么……？其实我觉得温度计可能坏了。";
		next;
		mes "[Geologist Gio]";
		mes "嘿！你说得对~我是故意弄坏的。";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "什么？！";
		next;
		mes "[Geologist Gio]";
		mes "你知道，像我这样的学者很难谋生。见鬼，我能从地质营地得到测温工作已经很幸运了。";
		next;
		mes "[Geologist Gio]";
		mes "自从他们发现火山休眠后，就一直想解雇我。但……只要有证据证明它随时可能爆发，他们就不能解雇我！";
		next;
		mes "[Geologist Gio]";
		mes "然后他们惊慌失措时，我冷静优雅地提出看似有效的解决方案。当然，根本就没有问题……";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "所以……你是骗子。";
		next;
		mes "[Geologist Gio]";
		mes "啊，别那样看我。我是真正的科学家。拜托……哦，拜托……";
		next;
		mes "[Geologist Gio]";
		mes "这样吧，回我的研究所看看书架？那里有个小盒子，放着各种小玩意。";
		next;
		mes "[Geologist Gio]";
		mes "盒子里第一个跳出来的东西就送给你。希望女神赐你好运，说不定会得到好东西~";
		next;
		mes "[Geologist Gio]";
		mes "把它当作出色完成工作的报酬。干得好！我对明星学生的期待就是这么高！";
		changequest 60211,60212;
		set aru_vol,25;
		delitem 7342,1; //File01
		delitem 7704,1; //Broken_Thermometer
		delitem 7705,1; //Note_Of_Geologist
		close;
	}
	mes "[Drunken Man]";
	mes "所以……^333333*嗝*^000000";
	mes "然后我就说……";
	next;
	mes "[Drunken Man]";
	mes "''^3131FF嘿，伙计！人要";
	mes "要用背来说话，";
	mes "而不是用拳头！想找我麻烦？放马过来！^000000''";
	next;
	mes "[Drunken Man]";
	mes "然后他吓得落荒而逃！";
	mes "哈哈哈哈！看来我很强悍，对吧？";
	next;
	emotion ET_THROB, getnpcid(0, "Drunken Lady#1");
	emotion ET_THROB, getnpcid(0, "Drunken Lady#2");
	mes "[Ladies]";
	mes "我的天！";
	mes "你太酷了～！";
	next;
	mes "[Drunken Man]";
	mes "嗯……谁都会这么做。";
	mes "我只是表现得像个绅士。哈哈哈，没错！";
	close;
}


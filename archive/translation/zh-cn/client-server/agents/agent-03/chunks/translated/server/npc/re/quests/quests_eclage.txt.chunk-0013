				mes "几乎就像有人";
				mes "故意让它";
				mes "看起来像是盗贼做的。";
				next;
				mes "["+ strcharinfo(0) +"]";
				mes "当然，这只是";
				mes "一种可能。嗯……";
				setquest 9254;

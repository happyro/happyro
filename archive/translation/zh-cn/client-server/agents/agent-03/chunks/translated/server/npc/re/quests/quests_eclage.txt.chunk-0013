ecl_in04,208,194,3	script	Daughter Luen#eclage2	4_F_FAIRYKID2,{
	if (ep14_2_detect == 9) {
		switch( select("现在我会追查盗贼。:我再考虑一下。:我们先在外面见。") ) {
			.@header$ = "["+ strcharinfo(0) +"]";
			mes .@header$;
		case 1:
			mes "大家！";
			mes "我请大家来的原因就是被盗的项链。";
			next;
			mes .@header$;
			mes "我邀请大家";
			mes "聚集到这里";
			mes "这样我们就能共同揭开";
			mes "抢劫发生的原因";
			mes "以及";
			mes "盗贼是谁。";
			next;
			mes .@header$;
			mes "首先……让我直接揭露";
			mes "盗贼身份！！";
			next;
			mes .@header$;
			mes "偷走项链的盗贼";
			mes "就是！！";
			next;
			switch( select("Rosa:流浪商人:Dames:Balumin:Cruyan:我再考虑一下。") ) {
				mes .@header$;
			case 1:
				mes "盗贼不是别人，正是";
				mes "^006400Rosa^000000!!";
				next;
				mes "[Mother Rosa]";
				mes "我是盗贼？";
				mes "不，我绝对不是盗贼！";
				next;
				mes .@header$;
				mes "Rosa肯定是盗贼！！";
				mes "抢劫的原因是~！！";
				next;
				select("Dames不会给她买新项链。");
				mes .@header$;
				mes "我审问Rosa时，她说不怀疑家里的任何人，而且项链是她非常珍视的东西。";
				next;
				mes .@header$;
				mes "Dames说他们最近争吵变多，她也提出了更多要求，说明他们的婚姻并不顺利。";
				next;
				mes .@header$;
				mes "根据Luen的说法，她以为自己是第一个到家的人。";
				mes "但她发现Rosa比她先到，却仍然把我留在那里昏迷不醒。";
				next;
				mes .@header$;
				mes "综合这一切！";
				mes "Rosa！";
				mes "既然你没有怀疑家人，我能感觉到你爱护自己的家庭。";
				next;
				mes .@header$;
				mes "然而，由于婚姻不顺，你想从家人那里获得更多关注和关心！！";
				next;
				mes .@header$;
				mes "你假装从Dames那里得到的项链被盗，试图让家人更亲近，也让自己得到更多关注。";
				mes "现在~你愿意把项链展示给大家并承认吗？";
				next;
				mes "[Mother Rosa]";
				mes "这不公平！！";
				mes "我为什么要做这种事？";
				mes "你要怎么解释被盗的酒？";
				next;
				if (select("那可能是因为你喜欢酒。:一定是我搞错了。") == 1) {
					mes "[Mother Rosa]";
					mes "我一生一口酒都没喝过。";
					mes "我的家人可以作证。";
					mes "你觉得像我这样的柔弱女人能把你打晕吗？";
					next;
					if (select("嗯，我不这么认为，但是……:一定是我搞错了。") == 1) {
						mes "[Mother Rosa]";
						mes "即便如此，如果我真想让它看起来可信，为什么要把你打晕后就丢在那里？";
						mes "难道我不会把你放到更远、更安全的地方吗？";
						next;
						select("呃，大概是这样……");
					}
				}
				break;
			case 2:
				mes "盗贼不是别人，正是";
				mes "^006400流浪商人^000000！！";
				next;
				mes "[Wandering Merchant]";
				mes "嘿！！之前……嗝……";
				mes "你叫我骗子";
				mes "现在又叫我盗贼？";
				mes "我可能骗过一些人";
				mes "但我从没偷过东西！";
				next;
				mes .@header$;
				mes "流浪商人";
				mes "绝对就是盗贼！！";
				mes "原因是~！！";
				next;
				select("你的发色！！");
				mes .@header$;
				mes "根据Luen的证词，一个红色短发的陌生人曾匆忙跑向某处。";
				next;
				mes .@header$;
				mes "这种抢劫在这个街区很少见。";
				mes "换句话说，很可能是这个地区的陌生人所为。";
				next;
				mes .@header$;
				mes "更重要的是，你现在身上散发着酒味！！";
				mes "被盗物品中还有两瓶酒！";
				next;
				mes .@header$;
				mes "综合这一切！";
				mes "流浪商人！";
				mes "因为生意不景气，你闯进房子偷走了东西。";
				next;
				mes .@header$;
				mes "而且你还拿走了";
				mes "2 bottles of alcohol and";
				mes "并把它们喝了！！";
				mes "现在~你愿意把项链展示给大家并承认吗？";
				next;
				mes "[Wandering Merchant]";
				mes "这不公平！！";
				mes "绝对不是我！！";
				mes "我告诉你我每天赚多少钱。";
				mes "我的生意非常好！！";
				mes "我没有理由去抢劫房子！";
				next;
				if (select("但是，酒味……:一定是我搞错了。") == 1) {
					mes "[Wandering Merchant]";
					mes "我没有偷酒。";
					mes "我只是喝了自己买的酒";
					mes "！！";
					next;
					if (select("嗯，但是……:一定是我搞错了。") == 1) {
						mes "[Mother Rosa]";
						mes "就因为我是陌生人，你就能无缘无故指控我吗？";
						mes "怎么能仅凭他是陌生人这一点就这样对待他？";
						next;
						select("我……我很抱歉……");
					}
				}
				break;
			case 3:
				mes "盗贼不是别人，正是";
				mes "^006400Dames^000000!!";
				next;
				mes "[Father Dames]";
				mes "我？";
				mes "绝对不是我！！";

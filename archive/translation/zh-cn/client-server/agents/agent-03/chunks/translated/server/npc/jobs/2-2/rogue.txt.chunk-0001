//===== Current Version: ===================================== 
//= 2.9
//===== Compatible With: ===================================== 
//= rAthena Project
//===== Description: ========================================= 
//= [Official Conversion]
//= Job quest for Rogue classes
//===== Additional Comments: ================================= 
//= 2.4 Rescripted to Aegis 10.3 stadards. [L0ne_W0lf]
//=     No longer uses function "F_BlockHigh"
//= 2.4a Deleted unused variables. [Samuray22]
//= 2.4b Changed a Problem with JobLevel what made 
//=     impossible get a Gladius [3]. (bugreport:481) [Samuray22]
//= 2.4c Corrected a Typo error ";;" and a typo error with "rouge". (bugreport:909) [Samuray22]
//= 2.5 Added dummy "OnMyMobDead" labels. (bugreport:1100) [L0ne_W0lf]
//= 2.6 Fixed a few bugs in the Rogue Guildsman. [L0ne_W0lf]
//= 2.7 Fixed a bug on Markie question 5, bugreport:1600 [Brainstorm]
//= 2.8 Moved "Thug" to Morocc Ruins. [L0ne_W0lf]
//= 2.9 Added Quest Log commands. [Kisuka]
//============================================================ 

moc_ruins,86,103,1	script	Thug#rg	118,{
	mes "[暴徒]";
	mes "*叹气……*";
	mes "人生是什么？";
	mes "金钱又有什么用？";
	mes "……该死。";
	mes "这毫无价值的人生！";
	next;
	mes "[暴徒]";
	mes "嘿，小子。";
	mes "你到底";
	mes "在看什么？";
	next;
	if (select("我？没、没什么！:……") == 1) {
		mes "[Thug]";
		mes "那就从我面前";
		mes "滚开！";
		mes "没听见吗？";
		mes "快滚！";
		close;
	}
	mes "[Thug]";
	mes "嗯嗯……";
	mes "也许我该去^0000FF帕罗斯灯塔^000000的^0000FF盗贼公会^000000看看……";
	next;
	mes "[Thug]";
	mes "我需要钱，";
	mes "他们最好已经准备好了……";
	close;
}

in_rogue,363,122,4	script	Rogue Guildsman#rg	747,{
	if (Upper == 1) {
		mes "[马克]";
		mes "咦？你……你……？！";
		mes "嘿，我们以前见过吗？";
		next;
		mes "[Markie]";
		mes "………………";
		mes "啊，^FF0000对不起^000000！我好像把你认成认识的人了。";
		next;
		mes "[Markie]";
		mes "……";
		mes "……不过真奇怪。嗯。";
		next;
		mes "[Markie]";
		mes "我从不会认错人……算了，总之注意安全！";
		close;
	}
	if (BaseJob == Job_Thief) {
		if (SkillPoint) {
			mes "[盗贼公会成员]";
			mes "哟，你在做什么？！";
			mes "还有未使用的技能点就不能转职，全部用掉。先检查好自己，别搞砸了。";
			close;
		}
		if (JobLevel > 39) {
			if (ROGUE_Q == 0) {
				mes "[Rogue Guildsman]";
				mes "像你这样的孩子";
				mes "来这里做什么？";
				if (Sex == SEX_MALE) {
					mes "哦，我明白了……";
					mes "这个小男孩想要";
				}
				else {
					mes "哦，原来如此……";
					mes "这个小可爱想要";
				}
				mes "成为^800000盗贼^000000。";
				next;
				mes "[Rogue Guildsman]";
				mes "呃，很高兴见到你。我是马克，为盗贼公会工作。这是一个慈善——*咳*，^800000感情慈善^000000团体。你叫什么名字？";
				next;
				mes "[Markie]";
				mes "……" + strcharinfo(0) + "？";
				mes "嘿嘿！酷名字。";
				mes "要是太蠢，我们会";
				mes "让你改名，";
				mes "所以你走运了。";
				next;
				mes "[Markie]";
				mes "你为什么想加入盗贼？你告诉我真名，应该会成为诚实的盗贼。这样的人可不多，嘿嘿~";
				next;
				mes "[Markie]";
				mes "盗贼守则第一条……";
				mes "大多数时候不要向大多数人透露真实身份。这是我们喜欢使用的小小保护措施。";
				next;
				mes "[Markie]";
				mes "好了，我正式接受你的申请。现在你要参加测试。别紧张，第一项很简单。";
				next;
				mes "[Markie]";
				mes "好吧……";
				mes "我们开始吧！";
				next;
			}
			else if (ROGUE_Q == 1) {
				mes "[Markie]";
				mes "又是你？";
				mes "好吧，你上次可能因为太紧张搞砸了。放松下来，通过";
				mes "这次测试，好吗？";
				next;
			}
			else if (ROGUE_Q == 2) {
				mes "[Markie]";
				mes "去和史密斯谈谈。他的测试可能很难。他负责确保人们偿还欠我们的债务。所以，他可能有点严厉。";
				next;
				mes "[Markie]";
				mes "是啊……";
				mes "那家伙可能很死板，但公会需要他这样的人。总之，小心点。祝你好运，朋友。";
				close;
			}
			else if (ROGUE_Q > 2 && ROGUE_Q < 16) {
				mes "[Markie]";
				mes "嘿哟……";
				mes "尽力而为。";
				next;
				mes "[Markie]";
				mes "嘿嘿……";
				mes "新鲜肉。这会很容易——等等！";
				mes "呃，我不是说你！我是说另一个新鲜肉~";
				close;
			}
			else if (ROGUE_Q == 16 || ROGUE_Q == 17) {
				changequest 2026,2027;
				mes "[Markie]";
				if (ROGUE_Q == 16) {
					mes "哦，是你！";
					mes "你做得很好。";
					mes "现在让我把你的";
					mes "职业改为盗贼。你应得的！";
					next;
					mes "[Markie]";
					mes "恭喜~！";
					mes "你看起来";
					mes "太酷了！";
				}
				else {
					mes "哦！是你！";
					mes "你居然能忍受那家伙？干得好！收集那些物品一定很辛苦吧？";
					next;
					mes "[Markie]";
					mes "嘿嘿~";
					mes "恭喜！";
					mes "你一直";
					mes "做得很棒~";
				}
				set .@jlevel,JobLevel;
				callfunc "Job_Change",Job_Rogue;
				callfunc "F_ClearJobVar";
				completequest 2027;
				next;
				mes "[Markie]";
				mes "现在……";
				mes "是时候";
				mes "让我发表";
				mes "演讲了~ *咳*";
				next;
				mes "[Markie]";
				mes "享受作为盗贼的自由吧。记住要同时保持自由与责任。用你希望被对待的方式对待别人，明白吗？好了，回头见。";
				close2;
				if (.@jlevel == 50) {
					getitem 1220,1; //Gladius_
				} else {
					getitem 1219,1; //Gladius
				}
				end;
			}
			if (select("我准备好了。:等等，我还要准备！") == 2) {
				mes "[Markie]";
				mes "准备……？";
				mes "好吧，好吧。";
				mes "慢慢";
				mes "准备吧。";
				mes "但快点回来，";
				mes "明白吗？";
				close;
			}
			next;
			mes "[Markie]";
			mes "仔细听，";
			mes "选择正确答案。";
			mes "明白？现在让我";
			mes "读出这些问题……";
			next;
			switch(rand(1,3)) {
			case 1:
				mes "[Markie]";
				mes "1. 选择学习^880000潜行^000000所需的技能。";
				next;
				if (select("^880000隐匿^000000:^880000偷窃^000000:^880000闪避提升^000000:^880000狂击^000000") == 1)
					set .@assassin_t,.@assassin_t+10;

				mes "[Markie]";
				mes "2. 与商人10级^880000折扣^000000技能相比，盗贼10级^880000讨价还价^000000技能能多获得多少百分比折扣？";
				next;
				if (select("3%:2%:1%:0%") == 3)
					set .@assassin_t,.@assassin_t+10;

				mes "[Markie]";
				mes "3. ^880000抢夺^000000技能的正确描述是什么？";
				next;
				if (select("从玩家偷物品:从怪物偷物品:从怪物偷Zeny:从玩家偷Zeny") == 3)
					set .@assassin_t,.@assassin_t+10;

				mes "[Markie]";
				mes "4. 激活^880000狡猾^000000技能需要多少名盗贼？";
				next;
				if (select("1名盗贼+2名刺客:1名小偷+2名盗贼:4名小偷:2名盗贼") == 4)
					set .@assassin_t,.@assassin_t+10;

				mes "[Markie]";
				mes "5. 选择5级^880000卸除头盔^000000时可以学习的技能。";
				next;
				if (select("^880000施毒^000000:^880000卸除服装^000000:^880000毒液喷射^000000:^880000卸除盾牌^000000") == 4)
					set .@assassin_t,.@assassin_t+10;

				mes "[Markie]";
				mes "6. 选择允许使用者在隐匿状态下移动的技能。";
				next;
				if (select("^880000隐匿^000000:^880000后退回避^000000:^880000潜行^000000:^880000沙尘攻击^000000") == 3)
					set .@assassin_t,.@assassin_t+10;

				mes "[Markie]";
				mes "7. 选择能提高持有者命中率的卡片。";
				next;
				if (select("安德烈卡片:小恶魔卡片:木乃伊卡片:玛丽娜卡片") == 3)
					set .@assassin_t,.@assassin_t+10;

				mes "[Markie]";
				mes "8. 选择被装备维顿卡片的武器攻击时会受到更多伤害的怪物（火属性伤害增加20%）。";
				next;
				if (select("维顿:小恶魔:长老树精:巴风特") == 3)
					set .@assassin_t,.@assassin_t+10;

				mes "[Markie]";
				mes "9. 使用短剑时，^880000二刀连击^000000技能需要多少SP？";
				next;
				if (select("15:被动技能，不需要SP:被动技能，10SP:54") == 2)
					set .@assassin_t,.@assassin_t+10;

				mes "[Markie]";
				mes "10. 选择在海底洞窟使用最有效的短剑。";
				next;
				if (select("风属性左轮手枪:冰属性左轮手枪:地属性左轮手枪:火属性左轮手枪") == 1)
					set .@assassin_t,.@assassin_t+10;
				break;
			case 2:
				mes "[Markie]";
				mes "1. 哪种怪物会掉落带洞短剑？";
				next;
				if (select("盗虫:大嘴鸟:沙漠之狼:哥布灵") == 4)
					set .@assassin_t,.@assassin_t+10;

				mes "[Markie]";
				mes "2. 哪种怪物会掉落带洞左轮手枪？";
				next;
				if (select("蜂兵:沙漠之狼:傀儡娃娃:米斯特") == 1)
					set .@assassin_t,.@assassin_t+10;

				mes "[Markie]";
				mes "3. 选择能够制作独特药剂的职业。";
				next;
				if (select("商人:炼金术士:铁匠:牧师") == 2)
					set .@assassin_t,.@assassin_t+10;

				mes "[Markie]";
				mes "4. 选择盗贼不能使用的武器。";
				next;
				if (select("角弓:十字弓:短剑:拳刃") == 4)
					set .@assassin_t,.@assassin_t+10;

				mes "[Markie]";
				mes "5. 选择怪物霍德拥有的属性。";
				next;
				if (select("水:火:风:地") == 4)
					set .@assassin_t,.@assassin_t+10;

				mes "[Markie]";
				mes "6. 选择无法驯服为宠物的魔物。";
				next;
				if (select("波利:克瑞米:兽人:毒魔菇") == 2)
					set .@assassin_t,.@assassin_t+10;

				mes "[Markie]";
				mes "7. 选择受到火属性短剑更多伤害的魔物。";
				next;
				if (select("短剑哥布林:钉锤哥布林:晨星哥布林:铁锤哥布林") == 4)
					set .@assassin_t,.@assassin_t+10;

				mes "[Markie]";
				mes "8. 选择没有公会城堡的城镇。";
				next;
				if (select("普隆德拉:艾尔帕兰:艾尔贝塔:斐扬") == 3)
					set .@assassin_t,.@assassin_t+10;

				mes "[Markie]";
				mes "9. 选择会掉落蓝色药草的植物。";
				next;
				switch(select("绿色植物:黄色植物:蓝色植物:闪耀植物")) {
				default:
					break;
				case 3:
					set .@assassin_t,.@assassin_t+10;
					break;
				case 4:
					set .@assassin_t,.@assassin_t+10;
					break;
				}
				mes "[Markie]";
				mes "10. 选择不具有不死属性的魔物。";
				next;
				if (select("僵尸:深海大嘴鱼:小恶魔:卡利斯格") == 3)
					set .@assassin_t,.@assassin_t+10;
				break;
			case 3:
				mes "[Markie]";
				mes "1. 盗贼掌握^880000闪避提升^000000后，闪避率提高百分之多少？";
				next;
				if (select("30:40:160:20") == 1)
					set .@assassin_t,.@assassin_t+10;

				mes "[Markie]";
				mes "2. 选择能发现使用隐匿或伪装技能角色的魔物。";
				next;
				if (select("虫尾:阿格斯:木乃伊:骷髅士兵") == 2)
					set .@assassin_t,.@assassin_t+10;

				mes "[Markie]";
				mes "3. 选择盗贼可以转职为流氓的地点。";
				next;
				if (select("科摩多:可可海滩:帕罗斯灯塔:梦罗克") == 3)
					set .@assassin_t,.@assassin_t+10;

				mes "[Markie]";
				mes "4. 初学者可以在哪个城镇转职为盗贼？";
				next;
				if (select("科摩多:卢蒂:艾尔贝塔:梦罗克") == 4)
					set .@assassin_t,.@assassin_t+10;

				mes "[Markie]";
				mes "5. 选择不影响 DEX 属性的卡片。";
				next;
				if (select("摇滚蝗虫卡:木乃伊卡:邪骸海盗卡:滴水兽卡") == 2)
					set .@assassin_t,.@assassin_t+10;

				mes "[Markie]";
				mes "6. 成为流氓有什么酷的地方？";
				next;
				select("成为真正的狠角色。:服装与风格。:可以叫别人‘菜鸟’。:出色的攻击力");
				set .@assassin_t,.@assassin_t+10;

				mes "[Markie]";
				mes "7. 盗贼什么时候可以转职为流氓？";
				next;
				switch(select("职业等级30:职业等级35:职业等级40:职业等级50")) {
				default:
					break;
				case 3:
					set .@assassin_t,.@assassin_t+10;
					break;
				case 4:
					set .@assassin_t,.@assassin_t+10;
					break;
				}
				mes "[Markie]";
				mes "8. 你想把头发染成蓝色。以 12 点为北方，你应该去哪个城镇、哪个方向？";
				next;
				if (select("梦罗克7点钟方向:普隆德拉7点钟方向:梦罗克5点钟方向:普隆德拉1点钟方向") == 2)
					set .@assassin_t,.@assassin_t+10;

				mes "[Markie]";
				mes "9. 选择盗贼转职任务所需的蘑菇。";
				next;
				switch(select("橙色黏菌:红色毛茸茸蘑菇:橙色网状蘑菇:橙色黏性蘑菇")) {
				default:
					break;
				case 1:
				case 3:
					set .@assassin_t,.@assassin_t+10;
					break;
				}
				mes "[Markie]";
				mes "10. 选择对流氓职业帮助最小的卡片。";
				next;
				if (select("小幽灵卡:长老树精卡:邪骸海盗卡:玛特卡") == 2)
					set .@assassin_t,.@assassin_t+10;
			}
			mes "[Markie]";
			mes "*Whew~*";
			mes "终于。";
			mes "我们完成了。";
			next;
			mes "[Markie]";
			mes "让我看看。";
			mes "你的分数是……";
			mes "" + .@assassin_t + " points.";
			if (.@assassin_t > 80) {
				set ROGUE_Q,2;
				setquest 2017;
				mes "很好。你通过了。";
				mes "我们不用";
				mes "再做一次。";
				next;
				mes "[Markie]";
				mes "但别太放松，你还有更多测试。下一项由史密斯负责。";
				next;
				mes "[Markie]";
				mes "那么……";
				mes "去找史密斯完成测试，好吗？不过小心点，他相当严厉。";
				close;
			}
			else {
				set ROGUE_Q,1;
				mes "糟糕……你失败了！";
				next;
				mes "[Markie]";
				mes "你本该趁机会多学习。谢谢你浪费我的时间。";
				next;
				mes "[Markie]";
				mes "*Sigh...* Lemme give you some tips, yeah? I'm supposed to tell you about some kind of ^990000iro.ragnarokonline.com^000000 to help you learn what you need to know.";
				next;
				mes "[Markie]";
				mes "当然，我也不知道这到底是什么意思，但如果你理解了，应该会很有帮助。";
				close;
			}
		}
		else if (JobLevel < 40) {
			mes "[Rogue Guildsman]";
			mes "喂，慢点，新人。我们只接受职业等级至少40的小偷。在你准备好前让我你加入太冒险了。明白吗？";
			close;
		}
	}
	else if (BaseJob == Job_Assassin) {
		mes "[Rogue Guildsman]";
		mes "咦……？";
		mes "刺客来这里做什么？呃，你不是被派来杀盗贼公会某人的吧？";
		next;
		mes "[Rogue Guildsman]";
		mes "总之，别惹我们！你抓不到我……我是潇洒的罪犯！";
		next;
		mes "[Rogue Guildsman]";
		mes "不明白吗？这是我以前常对休伊说的话。如果你在刺客公会，应该见过他……";
		close;
	}
	else if (BaseJob == Job_Rogue) {
		mes "[Markie]";
		mes "嘿嘿~";
		mes "好久不见。";
		mes "呃，目前公会没有";
		mes "给你的请求，";
		mes "稍后再回来";
		mes "看看吧。";
		close;
	}
	else {
		mes "[Rogue Guildsman]";
		mes "嘿，你……";
		mes "赶紧把你丑陋的";
		mes "屁股从这里滚出去，";
		mes "免得我重新装饰";
		mes "你的脸！";
		close;
	}
}

in_rogue,376,23,1	script	Mr. Smith#rg	57,{
	if (ROGUE_Q == 2) {
		mes "[Mr. Smith]";
		mes "欢迎来到";
		mes "盗贼公会。";
		mes "从现在开始，我会";
		mes "确认你的资格。";
		next;
		mes "[Mr. Smith]";

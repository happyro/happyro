ein_in01,85,208,5	script	Ei'felle#repay01	854,{
	if (!ein_medal01) {
		mes "[Ei'felle]";
		mes "可恶！我们必须交付";
		mes "顾客订购的东西，";
		mes "但我们做出来的全是";
		mes "粗制滥造的产品！要是有那种金属，";
		mes "我们就能提升产品质量！";
		mes "";
		next;
		select("你说的是哪种金属？");
		mes "[Ei'felle]";
		mes "施瓦茨瓦尔德共和国边境有一个小村庄，";
		mes "会发放用这种金属制成的特殊奖牌，";
		mes "正是我们急需的东西……";
		mes "";
		mes "";
		mes "";
		next;
		mes "[Ei'felle]";
		mes "我们派了一位最优秀的公会成员";
		mes "去为我们获取奖牌，但他还没有";
		mes "回来报告。";

		mes "在你的小地图上，";
		mes "这样就能轻松找到他。";
		viewpoint 1,73,22,1,0xFF3355;
		next;
		break;
	case 3:
		mes "[Game Guide]";
		mes "如果你押中了单人怪物赛的冠军，";
		mes "或双人怪物赛的第一、第二名，";
		mes "就可以用赛跑票";
		mes "兑换奖牌。";
		mes "";
		mes "";
		next;
		mes "[Game Guide]";
		mes "不过，你必须在比赛结束后的";
		mes "5分钟内向奖牌兑换员";
		mes "^FF0000兑换赛跑票。^FFFFFF ^FF0000超过5分钟后，票券将作废。^000000";
		mes "";
		mes "";
		next;
		mes "[Game Guide]";
		mes "5分钟期限结束后，你会被传送到场外，";
		mes "我们也会立即准备下一场比赛。";
		mes "下注时请记住这些信息。";
		mes "";
		next;
		mes "[Game Guide]";
		mes "如果你还没有领取免费的赛跑票，";
		mes "请去找票券助手。";
		mes "我已经在你的小地图上标出了";
		mes "他的位置。";
		mes "";
		viewpoint 1,67,45,2,0xCE6300;
		next;
		break;
	}
	mes "[Game Guide]";
	mes "谢谢，";
	mes "希望你在这里的";
	mes "怪物赛跑竞技场";
	mes "玩得开心。";
	close;
}

p_track02,67,45,5	script	Medal Distributor#medal	845,{
	if (!checkweight("Jellopy",20)) {
		mes "[Medal Distributor]";
		mes "抱歉，在你的背包腾出空间前，";
		mes "我无法发放奖牌。";
		mes "";
		mes "";
		close;
	}
	mes "[Medal Distributor]";
	mes "你好～";
	mes "如果你在最近的比赛中押中了";
	mes "获胜怪物，";
	mes "就可以在这里用比赛票";
	mes "兑换奖牌。";
	mes "";
	next;
	if (!countitem(7514)) {
		mes "[Medal Distributor]";
		mes "请记住，只有在比赛结束后，";
		mes "才能用获胜的比赛票兑换奖牌。";
		mes "奖牌可以交给朱诺的Wayne";
		mes "兑换物品。";
		mes "";
		mes "";
		close;
	}
	mes "[Medal Distributor]";
	mes "请记住，只有在比赛结束后，";
	mes "才能用获胜的比赛票兑换奖牌。";
	mes "奖牌可以交给朱诺的Wayne";
	mes "兑换物品。";
	mes "";
	mes "";
	next;
	if ((monster_race_2_1 == $@mon_race_2_1 && monster_race_2_2 == $@mon_race_2_2) || (monster_race_2_1 == $@mon_race_2_2 && monster_race_2_2 == $@mon_race_2_1)) {
		mes "[Medal Distributor]";
		mes "恭喜！双人怪物赛的胜者";
		mes "非常难猜，你一定很幸运！";
		mes "要用获胜的赛跑票";
		mes "兑换奖牌吗？";
		mes "";
		mes "";
		next;
		if (select("好的。:不了，谢谢。") == 1) {
			mes "[Medal Distributor]";
			mes "好，一切都没问题，";
			mes "这是你的奖牌～";
			mes "如果想用奖牌兑换物品，";
			mes "请去找朱诺的Wayne。";
			mes "希望你享受怪物赛跑～";
			mes "";
			monster_race_2_1 = monster_race_2_2 = 7;
			delitem 7514,1; //Monster_Ticket
			getitem 7515,15; //Marvelous_Medal
			close;
		}
		mes "[Medal Distributor]";
		mes "嗯，你确定吗？获胜的赛跑票";
		mes "只能在比赛结束后的短时间内兑换。";
		mes "如果弄错了，请尽快再来找我。";
		mes "";
		mes "";
		close;
	} else if (!monster_race_2_1 && !monster_race_2_2) {
		mes "[Medal Distributor]";
		mes "嗯，下次好运……";
		mes "虽然不可能一直幸运，";
		mes "但给怪物赛跑下注总是很有趣！";
		mes "";
		close;
	} else if (monster_race_2_1 == 7 && monster_race_2_2 == 7) {
		mes "[Medal Distributor]";
		mes "感谢你来到怪物赛跑竞技场，";
		mes "希望你在这里玩得开心。";
		mes "下次再见～";
		mes "";
		close;
	} else if (monster_race_2_1 != $@mon_race_2_1 || monster_race_2_2 != $@mon_race_2_2) {
		mes "[Medal Distributor]";
		mes "你可能没有押中上一场比赛的冠军，";
		mes "但希望你下次好运～";
		mes "";
		mes "";
		close;
	}

OnInit:
	disablenpc "Medal Distributor#medal";
	end;
}

p_track02,76,38,1	script	Exit Guide#double	798,{
	mes "[Exit Guide]";
	mes "如果你有获胜的赛跑票，";
	mes "请现在兑换奖牌。";
	mes "下一场比赛开始后，";
	mes "所有赛跑票都会作废。";
	mes "";
	next;
	mes "[Exit Guide]";
	mes "如果你想离开竞技场，";
	mes "我可以带你出去。";
	mes "现在要离开竞技场吗？";
	mes "";
	next;
	if (select("是:否") == 2) {
		mes "[Exit Guide]";
		mes "好吧。";
		mes "准备离开时";
		mes "告诉我一声。";
		mes "";
		close;
	}
	if (!countitem(7514)) {
		mes "[Exit Guide]";
		mes "感谢你的光临，";
		mes "希望你很快";
		mes "再次来访～";
		mes "";
	} else {
		mes "[Exit Guide]";
		mes "根据我们的规定，";
		mes "你离开前必须交出赛跑票。";
		mes "感谢你的光临，";
		mes "希望你在怪物赛跑竞技场";
		mes "玩得开心。";
		mes "";
		delitem 7514,1; //Monster_Ticket
	}
	monster_race_2_1 = monster_race_2_2 = 0;
	close2;
	warp "hugel",63,73;
	end;
}

-	script	mob1#main	-1,{
function	MN	{
	setarray .@n$[1], "poring","lunatic","savagebebe","desertwolf","deviruchi","baphomet";
	for ( .@i = 1; .@i <= 6; .@i++ ) {
		if (compare(strnpcinfo(0),.@n$[.@i])) 
			break;
	}
	return .@i;	
}

OnEnable:
	enablenpc();
	setarray .@n[1], 1725,1726,1727,1728,1730,1729;
	getmapxy(.@m$,.@x,.@y,BL_NPC);
	.@i = MN;
	monster "p_track02",58,.@y,"Monster "+.@i,.@n[.@i],1,strnpcinfo(0)+"::OnMyMobDead";
	end;

OnTouchNPC:
	.@i = MN;
	if (!$@mon_race_2_1) {
		emotion ET_THROB;
		specialeffect EF_MVP;
		mapannounce "p_track02","Monster "+.@i+" has reached the Finish Line!",bc_map,"0x66FFCC";
		$@mon_race_2_1 = .@i;
		donpcevent strnpcinfo(0)+"::OnDisable";
	} else {
		emotion ET_THROB;
		specialeffect EF_MVP;
	mapannounce "p_track02","比赛结束！魔物 "+.@i+" 已经到达终点！",bc_map,"0x66FFCC";
		$@mon_race_2_2 = .@i;
		donpcevent "#poring1::OnDisable";
		donpcevent "#lunatic1::OnDisable";
		donpcevent "#savagebebe1::OnDisable";
		donpcevent "#desertwolf1::OnDisable";
		donpcevent "#deviruchi1::OnDisable";
		donpcevent "#baphomet1::OnDisable";
		donpcevent "TrapGlobal#race02::OnDisable";
		enablenpc "Medal Distributor#medal";
		donpcevent "#race_timer2-3::OnEnable";
	}
OnMyMobDead:
	end;

OnDisable:
	killmonster "p_track02",strnpcinfo(0)+"::OnMyMobDead";

OnInit:
	if ( strnpcinfo(2) != "main" )
		disablenpc();
	end;
}

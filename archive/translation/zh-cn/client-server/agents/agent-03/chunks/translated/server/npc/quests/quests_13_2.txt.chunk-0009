				mes "所以，如果把它们组合起来，";
				mes "TJDTMFJDNS CJFDI";
				mes "TKADLFDMF QKATOS";
				mes "EKDTLSDML DLFMADMS..";
				mes "就会变成这样。";
				next;
			}
			else {
				mes "[Linguist Dictionary]";
				mes "嗯……？";
				next;
				mes "[Linguist Dictionary]";
				mes "你确定他们说的就是这些吗？";
				mes "嗯……我不明白……";
				next;
				mes "[Linguist Dictionary]";
				mes "请再回去确认一下他们到底说了什么，好吗？";
				close;
			}
			mes "[Linguist Dictionary]";
			mes "嗯……嗯……原来如此……";
			next;
			mes "[Linguist Dictionary]";
			mes "……呃……";
			next;
			mes "- Dictionary专注地盯着纸张。-";
			set ep13_2_rhea,3;
			close;
		}
		else {
			// custom translation
			mes "[Linguist Dictionary]";
			mes "根据远征队营地的调查，有一个类似妖精的异族，还有一个类似巨人的异族。";
			next;
			mes "[Linguist Dictionary]";
			mes "据说他们使用米德加尔特人无法理解的语言……虽然大家都这么说，却没人能记住他们的对话或话语。";
			next;
			mes "[Linguist Dictionary]";
			mes "一种新语言！！！作为语言学家，我不能坐在这里。但外面有许多怪物，作为学者，出去太危险了。";
			next;
			mes "[Linguist Dictionary]";
			mes "既然我们已经谈到这里，你应该明白我的请求了吧？";
			next;
			mes "[Linguist Dictionary]";
			mes "三国联盟研究组对其他智慧生命非常感兴趣。为了尝试与他们交流，各国官员秘密采取了各种努力。然而由于信息不足，他们面临困难。";
			next;
			mes "[Linguist Dictionary]";
			mes "如果你在远征队营地附近遇到那些种族，一定要记住他们的对话！然后回来向我报告！";
			close;
		}
	}
	else if (ep13_2_rhea == 3) {
		mes "[Linguist Dictionary]";
		mes "............................";
		next;
		mes "- Dictionary专注地盯着纸张。-";
		next;
		switch(select("他看起来很认真，我们别打扰他:和他说话")) {
		case 1:
			mes "[Linguist Dictionary]";
			mes "............................";
			close;
		case 2:
			break;
		}
		mes "[Linguist Dictionary]";
		mes "啊啊啊啊啊啊！！！！！！";
		next;
		select("你弄明白什么了吗？");
		mes "[Linguist Dictionary]";
		mes "我……无法理解它！！！";
		mes "这~~是~~什么~~~到底该怎么读~~~~~~我完全不懂这里的规则~~~~嗯？";
		next;
		mes "[Linguist Dictionary]";
		mes "..................................";
		next;
		mes "[Linguist Dictionary]";
		mes "哼！";
		mes "什么？";
		next;
		switch(select("他看起来很认真。我们别打扰他。:问问发生了什么。")) {
		case 1:
			mes "[Linguist Dictionary]";
			mes "............................";
			mes "...................Hmph...";
			close;
		case 2:
			break;
		}
		mes "[Linguist Dictionary]";
		mes "啊！事情不像我想的那么简单。这些语言在米德加尔特大陆任何地方都听不到。已知的语音规则似乎都不适用。";
		next;
		mes "[Linguist Dictionary]";
		mes "很难掌握它们的规则或体系，更重要的是，我甚至不知道这种发音是否正确。我从未听过这种发音。";
		next;
		mes "[Linguist Dictionary]";
		mes "对了，我听说^0000ff卢恩-米德加尔特魔法师^000000知道如何根据语言样本进行研究，你能去请他帮忙吗？";
		next;
		mes "[Linguist Dictionary]";
		mes "^0000ff卢恩-米德加尔特魔法师^000000正在远征队营地内游荡。";
		next;
		mes "[Linguist Dictionary]";
		mes "没有更多语言样本，很难继续研究。请帮帮我。";
		completequest 8244;
		setquest 8245;
		set ep13_2_rhea,4;
		close;
	}
	else if ((ep13_2_rhea > 3) && (ep13_2_rhea < 6)) {
		mes "[Linguist Dictionary]";
		mes "我听说^0000ff卢恩-米德加尔特魔法师^000000知道如何根据语言样本进行研究，你能去找他帮忙吗？";
		next;
		mes "[Linguist Dictionary]";
		mes "^0000ff卢恩-米德加尔特魔法师^000000正在远征队营地内游荡。";
		next;
		mes "[Linguist Dictionary]";
		mes "没有更多语言样本，很难继续研究。请帮帮我。";
		close;
	}
	else if (ep13_2_rhea == 6) {
		mes "- 语言学家仿佛着了魔似的在纸上书写。-";
		next;
		mes "[Linguist Dictionary]";
		mes "……哦，你好。";
		next;
		mes "[Linguist Dictionary]";
		mes "听说你带来了记录着异世界语言的宝石。多亏你的帮助，解码工作进展顺利。";
		mes "其实，顺利得过头了……";
		next;
		mes "[Linguist Dictionary]";
		mes "真奇怪，我亲耳听到那种语言的瞬间，竟不由自主地完美解码了。一定是芙蕾雅女神的祝福。";
		next;
		mes "[Linguist Dictionary]";
		mes "但问题是……";
		mes "我们要怎样整合这些庞大资料，把它做成便携式翻译器……我实在想不出来。";
		next;
		mes "[Linguist Dictionary]";
		mes "不知道施瓦茨瓦尔德共和国的机械工程师会怎么想……能请你去问问他吗？";
		completequest 8247;
		setquest 8248;
		set ep13_2_rhea,7;
		close;
	}
	else if ((ep13_2_rhea > 6) && (ep13_2_rhea < 13)) {
		mes "[Linguist Dictionary]";
		mes "究竟要怎样整合这些庞大的数据，制作成便携式翻译器……我实在想不出来。";
		next;
		mes "[Linguist Dictionary]";
		mes "不知道施瓦茨瓦尔德共和国的机械工程师会怎么想……能请你去问问他吗？";
		close;
	}
	else if (ep13_2_rhea > 12) {
		mes "[Linguist Dictionary]";
		mes "终于，我们成功制作出翻译器了！";
		mes "用起来怎么样？没有什么问题吧？";
		next;
		mes "[Linguist Dictionary]";
		mes "希望这个翻译器能帮助你的旅程。";
		next;
		mes "[Linguist Dictionary]";
		mes "不过，虽然使用翻译器很重要，语言和交流的基础是努力理解他人。";
		next;
		mes "[Linguist Dictionary]";
		mes "不要把一切都依赖于机器……别忘了相互理解。带着翻译器享受异世界之旅吧。";
		close;
	}
	else {
		mes "[Linguist Dictionary]";
		mes "终于，我们成功制作出翻译器了！";
		mes "用起来怎么样？没有什么问题吧？";
		next;
		mes "[Linguist Dictionary]";
		mes "希望这个翻译器能帮助你的旅程。";
		next;
		mes "[Linguist Dictionary]";
		mes "不过，虽然使用翻译器很重要，语言和交流的基础是努力理解他人。";
		next;
		mes "[Linguist Dictionary]";
		mes "不要把一切都依赖于机器……别忘了相互理解。带着翻译器享受异世界之旅吧。";
		close;
	}
}

mid_camp,147,256,3	script	Rune-Midgarts Magician#1	735,{
	if (ep13_2_rhea < 4) {
		mes "[Magician Whisper]";
		mes "要存储如此庞大的信息，现有技术是不可能做到的。";
		next;
		mes "[Magician Whisper]";
		mes "古代卢恩-米德加尔特王国曾将某种魔法施加在宝石上，以存储大量信息……用宝石作为存储介质……";
		next;
		mes "[Magician Whisper]";
		mes "哦，抱歉，你给人一种很舒服的感觉，我不知不觉就和你说话了。你是谁？";
		close;
	}
	else if (ep13_2_rhea == 4) {
		mes "[Magician Whisper]";
		mes "要存储如此庞大的信息，现有技术是不可能做到的。";
		next;
		mes "[Magician Whisper]";
		mes "古代卢恩-米德加尔特王国曾将某种魔法施加在宝石上，以存储大量信息……用宝石作为存储介质……";
		next;
		mes "[Magician Whisper]";
		mes "哦，抱歉，你给人一种很舒服的感觉，我不知不觉就和你说话了。你是谁？";
		next;
		select("呃，是词典先生派我来的……");
		mes "[Magician Whisper]";
		mes "哦？你是说来自阿鲁纳佩兹的语言学家。也就是说，我们需要记录下来的语言样本。";
		next;
		mes "[Magician Whisper]";
		mes "嗯……其实，我在他们领地附近埋下了能用魔力记录声波的宝石……用来收集他们语言的信息。";
		next;
		mes "[Magician Whisper]";
		mes "但是，负责埋藏宝石的刺客们……正在执行其他任务，无法去取回宝石。";
		next;
		mes "[Magician Whisper]";
		mes "如果没有人帮忙取回宝石，我就无法把样本交给你。";
		next;
		switch(select("那我晚点再来？:我去把它们取回来怎么样？")) {
		case 1:
			mes "[Magician Whisper]";
			mes "…………当然可以，你可以等上一百年……";
			next;
			mes "["+ strcharinfo(0) +"]";
			mes "什么？";
			next;
			mes "[Magician Whisper]";
			mes "啊，不，不，没什么。";
			next;
			break;
		case 2:
			break;
		}
		mes "[Magician Whisper]";
		mes "如果你能做到，就能为我们节省大量时间，对我们很有帮助！对吧？你也这么想吧？";
		next;
		mes "[Magician Whisper]";
		mes "我相信你已经见过外面的两个异族了吧？";
		mes "刺客们趁他们不注意，把魔法宝石埋在了村庄附近。";
		next;
		mes "[Magician Whisper]";
		mes "第一颗宝石埋在妖精村庄附近的蘑菇状建筑下。";
		next;
		mes "[Magician Whisper]";
		mes "第二颗宝石埋在巨人村庄附近的树下。";
		next;
		mes "[Magician Whisper]";
		mes "把那两颗宝石带回来，就能帮我大忙。";
		next;
		mes "[Magician Whisper]";
		mes "当然，如果你有其他事情要忙，我也不能强求……";
		next;
		mes "[Magician Whisper]";
		mes "有句老话说，口渴的人会自己挖井……";
		next;
		mes "[Magician Whisper]";
		mes "我差点忘了！挖宝石时一定要小心。";
		mes "刺客们埋宝石时设置了陷阱来保护它们。";
		completequest 8245;
		setquest 8246;
		set ep13_2_rhea,5;
		close;
	}
	else if (ep13_2_rhea == 5) {
		set .@check_spljew00,checkquest(8241);
		set .@check_manjew00,checkquest(8242);
		if ((.@check_spljew00 > 0) && (.@check_manjew00 > 0)) {
			if (countitem(7575) > 0) && (countitem(7576) > 0) {
				mes "[Magician Whisper]";
				mes "哇，你这么快就回来了！";
				mes "那么，让我看看宝石！";
				next;
				mes "- 你把宝石交给他后，-";
				mes "- 他仔细地检查起来。-";
				next;
				mes "[Magician Whisper]";
				mes "嗯……";
				mes "里面混入了很多噪音，不过我应该很快就能提取出声音。";
				next;
				mes "[Magician Whisper]";
				mes "我会提取宝石中记录的声音，并发送给阿鲁纳佩兹的语言学家。";
				next;
				mes "[Magician Whisper]";
				mes "这里似乎有很多便利的机器。使用这台录音机，就能把提取出的声音直接发送给阿鲁纳佩兹的语言学家。";
				next;
				mes "[Magician Whisper]";
				mes "接下来我自己就可以了。谢谢你的辛劳。";
				completequest 8241;
				completequest 8242;
				completequest 8246;
				setquest 8247;
				delitem 7575,1; //Red_Jewel_
				delitem 7576,1; //Blue_Jewel_
				set ep13_2_rhea,6;
				close;
			}
			else {
				// custom translation
				mes "[Magician Whisper]";
				mes "啊，真快。";
				next;
				mes "[Magician Whisper]";
				mes "请把宝石给我。我会提取其中的声音记录，再交给阿鲁纳佩兹的语言学家。";
				next;
				mes "[Magician Whisper]";
				mes "……但是……宝石呢？";
				close;
			}
		}
		else {
			mes "[Magician Whisper]";
			mes "第一颗宝石埋在妖精村附近的蘑菇状建筑下。";
			next;
			mes "[Magician Whisper]";
			mes "第二颗宝石埋在巨人村附近的树下。";
			next;
			mes "[Magician Whisper]";
			mes "把那两颗宝石带回来，就能帮我大忙。";
			next;
			mes "[Magician Whisper]";
			mes "如果你忙于其他事情，我也不能强迫你……";
			next;
			mes "[Magician Whisper]";
			mes "有句老话说：口渴的人会自己挖井……";
			next;
			mes "[Magician Whisper]";
			mes "我差点忘了！挖宝石时一定要小心。";
			mes "刺客在埋藏宝石时设置了陷阱来保护它们。";
			close;
		}
	}
	else if ((ep13_2_rhea > 5) && (ep13_2_rhea < 8)) {
		mes "[Magician Whisper]";
		mes "如果你不忙，请去看看阿鲁纳佩兹语言学家的研究进展如何。";
		next;
		mes "[Magician Whisper]";
		mes "我还要提取声音数据并发送给阿鲁纳佩兹的语言学家。";
		close;
	}
	else if (ep13_2_rhea == 8) {
		mes "[Magician Whisper]";
		mes "嗯……数据比我们想象的还多……";
		next;
		mes "[Magician Whisper]";
		mes "把数据转化为魔力并装进宝石当然很容易……最重要的是，我不知道有没有足够存储空间来容纳这么多数据的宝石……";
		next;
		mes "[Magician Whisper]";
		mes "我听说远征队营地外的寒冷地带，有一种在米德加尔特找不到的^0000ff神秘矿石。";
		next;
		mes "[Magician Whisper]";
		mes "只要能找到那种矿石，工作就会容易得多……你觉得呢？能帮我找一块吗？";
		next;
		mes "[Magician Whisper]";
		mes "你离开期间，我会整理要放入宝石的数据。";
		completequest 8249;
		setquest 8250;
		set ep13_2_rhea,9;
		close;
	}
	else if (ep13_2_rhea == 9) {
		if (countitem(6048) > 0) {
			mes "[Magician Whisper]";
			mes "哦！这就是那种矿石吗？";
			next;
			mes "[Magician Whisper]";
			mes "真有意思。它还没有经过提炼，但我能感受到其中的神秘力量。";
			next;
			mes "[Magician Whisper]";
			mes "那似乎是……带有生命力的特殊波动。";
			next;
			mes "[Magician Whisper]";
			mes "让我们测试一下它能储存多少魔力。";
			next;
			mes "- 他闭上眼睛吟唱咒语。-";
			mes "- 手中握着那块矿石。-";
			next;
			mes "[Magician Whisper]";
			mes "Lumos Nox Densaugeo Dissendium Diffindo Engorgio Mobiliarbus Expecto patronum!!!!";
			next;
			specialeffect EF_FLASHER; // 99 : "Rune-Midgarts Magician#ep132_rhea03" EF_FLASHER
			emotion ET_SURPRISE;
			mes "[Magician Whisper]";
			mes "哇！！！这、这真令人难以置信！";
			next;
			mes "[Magician Whisper]";
			mes "这么小、指甲大小的矿石，竟有这么大的存储空间，能容纳两种语言！";
			next;
			mes "[Magician Whisper]";
			mes "你能稍等一会儿吗？";
			mes "我把矿石制成宝石并将魔法数据放进去时，你先休息一下。你看起来很疲惫……";
			completequest 8250;
			setquest 8251;
			delitem 6048,1; //Unidentified_Mineral
			set ep13_2_rhea,10;
			close;
		}
		else {
			mes "[Magician Whisper]";
			mes "我听说远征队营地外的寒冷地带有一种在米德加尔特找不到的未鉴定矿石。";
			next;
			mes "[Magician Whisper]";
			mes "只要能找到那种矿石，工作就会容易得多……你觉得呢？能帮我找一块吗？";
			next;
			mes "[Magician Whisper]";
			mes "你离开期间，我会整理要放入宝石的数据。";
			close;
		}
	}
	else if (ep13_2_rhea == 10) {
		if (rand(1,5) == 3) {
			mes "- 他的脸色变得有些苍白。-";
			mes "- 看到你时，他显得很高兴。-";
			next;
			mes "[Magician Whisper]";
			mes "啊！你来得正好！";
			next;
			mes "[Magician Whisper]";
			mes "我刚刚完成了魔力注入。";
			mes "接下来就交给施瓦茨瓦尔德的机械工程师，把宝石与机器结合，制成实时翻译器。";
			next;
			mes "[Magician Whisper]";
			mes "最后再拜托你一件事。";
			mes "请把这颗制作完成的宝石交给施瓦茨瓦尔德的机械工程师。";
			next;
			mes "[Magician Whisper]";
			mes "真的很抱歉总是拜托你……啊……我消耗了太多魔力……得休息一会儿。";
			next;
			mes "- ^0000ff收到制作完成的宝石^000000-";
			mes "- ^0000ff来自低语！！^000000-";
			completequest 8251;
			setquest 8252;
			set ep13_2_rhea,11;
			close;
		}
		else {
			mes "[Magician Whisper]";
			mes "你能稍等一会儿吗？";
			mes "我把矿石制成宝石并将魔法数据放进去时，你先休息一下。你看起来很疲惫……";
			close;
		}
	}
	else if (ep13_2_rhea == 11) {
		mes "[Magician Whisper]";
		mes "请把这颗制作完成的宝石交给施瓦茨瓦尔德的机械工程师。";
		next;
		mes "[Magician Whisper]";
		mes "真的很抱歉总是拜托你……啊……我消耗了太多魔力……得休息一会儿。";
		next;
		mes "- 他睡眼惺忪地说道。-";
		mes "- 一边揉着快要闭上的眼睛。-";
		close;
	}
	else if (ep13_2_rhea == 12) {
		mes "[Magician Whisper]";
		mes "翻译器制作得怎么样了？";
		close;
	}
	else if (ep13_2_rhea > 12) {
		mes "[Magician Whisper]";
		mes "我刚收到消息，翻译器已经完成了！";
		next;
		mes "[Magician Whisper]";
		mes "虽然数量还不够，但它会让我们前往异世界的行动更加容易！";
		close;
	}
	else {
		mes "[Magician Whisper]";
		mes "我刚收到消息，翻译器已经完成了！";
		next;
		mes "[Magician Whisper]";
		mes "虽然数量还不够，但它会让我们前往异世界的行动更加容易！";
		close;
	}
}


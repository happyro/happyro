//----------------------------------------------------------------------------
// Kiehl's Room; Big Door, (Fifth, and final)
// - Anyone can pass through this door
// - Consumes 4 Solid Iron Pieces
//----------------------------------------------------------------------------
kh_kiehl01,166,187,0	script	Big Door#BigDoorKHQ5	111,{
	if (($@KHQuestBusy == 0) && (KielHyreQuest >= 74) && (KielHyreQuest <= 106)) {
		if (KielHyreQuest < 86) {
			mes "^3355FF这扇大门……";
			mes "紧紧关闭。";
			mes "仔细听，";
			mes "可以听见门";
			mes "铰链轻轻吱呀。^000000";
			next;
			select("推门:踢门:摇门:拉门:抬门");
			mes "^3355FF一群怪物";
			mes "在你对门施加压力时";
			mes "突然出现。";
			mes "这一定是某种";
			mes "安全装置。^000000";
			close2;
			set @KHDoorPushAttempt,@KHDoorPushAttempt+1;
			monster "kh_kiehl01",163,183,"Alicel",1739,1;
			monster "kh_kiehl01",163,179,"Aliot",1740,1;
			monster "kh_kiehl01",169,183,"Alicel",1739,1;
			monster "kh_kiehl01",169,179,"Aliot",1740,1;
			if (@KHDoorPushAttempt >= 3) { 
				set KielHyreQuest,86; 
			}
			end;
		}
		else if ((KielHyreQuest > 84) && (KielHyreQuest < 94)) {
			mes "^3355FF你对门施加压力，";
			mes "发现门可以稍微移动，";
			mes "但无法完全打开。^000000";
			next;
			mes "^3355FF如果把东西塞进";
			mes "门与门框之间的缝隙，";
			mes "再充分利用杠杆，";
			mes "就应该能打开。^000000";
			next;
			switch(select("钢铁:生锈铁片:坚固铁片:铁片:螺丝:取消")) {
			case 1:
				set .@KHPryingItem$,"Steel";
				break;
			case 2:
				set .@KHPryingItem$,"Rusty Iron Piece";
				break;
			case 3:
				if (countitem(7507) >= 1) {
					if (KielHyreQuest < 92) {
						mes "^3355FF你将坚固铁片的一端";
						mes "插入门缝，费力";
						mes "撬动大门。";
						mes "缝隙稍微变宽，";
						mes "但你折断了一块";
						mes "坚固铁片。^000000";
						delitem 7507,1; //Hard_Piece_of_Steel
						set KielHyreQuest,KielHyreQuest+2;
						close;
					}
					else if (KielHyreQuest == 92) {
						mes "^3355FF你猛地用力，";
						mes "将坚固铁片撬入门框，";
						mes "把门彻底打开。";
						mes "无法承受强大力量，";
						mes "坚固铁片碎成了尘土。^000000";
						delitem 7507,1; //Hard_Piece_of_Steel
						set KielHyreQuest,94;
						close;
					}
				}
				else {
					mes "^3355FF要是有坚固铁片，";
					mes "就能用它";
					mes "撬开这扇门了。^000000";
					close;
				}
			case 4:
				set .@KHPryingItem$,"Iron Piece";
				break;
			case 5:
				set .@KHPryingItem$,"Screw";
				break;
			case 6:
				mes "^3355FF找找看有没有";
				mes "重物可以用来撬开";
				mes "这扇门。^000000";
				close;
			}

			mes "^3355FF这件"+.@KHPryingItem$+"太";
			mes "脆弱，无法完成这个任务，";
			mes "断裂了。^000000";
			close;
		}
		else if ((KielHyreQuest >= 94) && (KielHyreQuest <= 104)) {
			if (.KHDoor5Opened == 0) {
				mes "^3355FF大门";
				mes "已经完全打开，";
				mes "你现在可以进入。^000000";
				next;
				switch(select("是:否")) {
				case 1:
					close2;
					donpcevent "Big_Door_5_Warp::OnEnable";
					enablenpc "Big_Door_5_Warp";
					set .KHDoor5Opened,1;
					end;
				case 2:
					mes "^3355FF谁知道门的另一边有什么。";
					mes "在贸然进入前，";
					mes "先考虑清楚……^000000";
					close;
				}
			}
			else {
				mes "^3355FF门是开着的。^000000";
				close;
			}
		}
		else {
			mes "^3355FF这扇大门……";
			mes "紧紧关闭。";
			mes "仔细听，门铰链";
			mes "发出轻微吱呀声。^000000";
			close;
		}
	}
	else {
		mes "^3355FF这扇大门……";
		mes "紧紧关闭。";
		mes "仔细听，门铰链";
		mes "发出轻微吱呀声。^000000";
		close;
	}
}


				mes "^3355FF输入密码后，附近的门";
				mes "发出悦耳的铃声，";
				mes "箱子弹开，露出";
				mes "一把小钥匙。^000000";
				getitem 7505,1; //Toy_Key
				close;
			}
			else {
				mes "^3355FF什么也没发生。^000000";
				close;
			}
		}
		else {
			mes "^3355FF你就是在这里";
			mes "找到玩具钥匙的。^000000";
			close;
		}
	}
	else{
		mes "^3355FF箱子大开着，";
		mes "里面";
		mes "什么也没有。^000000";
		close;
	}
}

//----------------------------------------------------------------------------
// Kiehl's Room; Big Door, (First)
// - Anyone can pass through this door
// - Consume one Black KeyCard when opened.
// - Only one person actually needs to open it.
//----------------------------------------------------------------------------
kh_kiehl01,44,33,0	script	Big Door#BigDoorKHQ1	111,{
	if (.KHDoor1Opened == 0) {
		mes "^3355FF门锁着，";
		mes "但门把手旁有一个";
		mes "狭窄的插槽。^000000";
		next;
		input .@KHInput$;
		if (.@KHInput$ == "Black Keycard") {
			if (countitem(7506) >= 1) {
				mes "^3355FF你将黑色钥匙卡插入";
				mes "插槽，成功";
				mes "解锁并打开了门。^000000";
				delitem 7506,1; //Black_Key_Card
				donpcevent "Big_Door_1_Warp::OnEnable";
				enablenpc "Big_Door_1_Warp";
				set .KHDoor1Opened,1;
				close;
			}

		}
		mes "^3355FF你使尽全力";
		mes "试图推开门，却无法";
		mes "让它移动。^000000";
		close;
	}

	else {
		mes "^3355FF门是开着的。^000000";
		close;
	}
}


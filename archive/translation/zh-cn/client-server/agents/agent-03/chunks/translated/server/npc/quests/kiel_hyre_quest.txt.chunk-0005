kh_vila,44,126,0	script	Map#khp1	111,{
	if ((KHCottagePoem1 < 2) && (KielHyreQuest < 30)) {
		mes "^3355FF一张宏伟的世界地图，";
		mes "详细描绘卢恩·米德加尔特";
		mes "王国、施瓦茨瓦尔德共和国，";
		mes "以及西边另一个";
		mes "你不熟悉名字的国家，";
		mes "被贴在墙上。^000000";
		next;
		mes "^3355FF当你仔细检查";
		mes "世界地图时，";
		mes "你发现地图下面";
		mes "藏着什么。^000000";
		switch(select("忽略:检查")) {
		case 1:
			mes "^3355FF藏在地图下的东西";
			mes "可能不够重要，";
			mes "不值得你";
			mes "调查。^000000";
			mes "";
			close;
		case 2:
			mes "^3355FF遗憾的是，你看不到";
			mes "地图下面的东西，";
			mes "因为它贴在墙上。";
			mes "你需要找到";
			mes "松开胶水";
			mes "且不损坏地图的方法……^000000";
			set KHCottagePoem1,1;
			close;
		}
	}
	else  if ((KHCottagePoem1 == 2) && (KielHyreQuest < 30)) {
		mes "^3355FF你把装有";
		mes "滚烫液体的锅";
		mes "移到世界地图附近。";
		mes "墙上的浆糊";
		mes "变湿后，地图慢慢";
		mes "开始剥落。^000000";
		next;
		mes "^3355FF剥落的地图露出";
		mes "一张折叠的纸，";
		mes "藏在下面。你";
		mes "拿起纸，并把地图抚平";
		mes "让它重新贴在";
		mes "墙上。纸上";
		mes "写着一段消息。^000000";
		next;
		mes "^0000FF她会在一个";
		mes "像两极一样寒冷的地方。";
		mes "当井水干涸";
		mes "大地龟裂时，";
		mes "通往她心灵的道路——";
		mes "一颗像水晶一样";
		mes "透明的心——会打开。^000000";
		next;
		mes "^3355FF我必须用四把剑";
		mes "对付四条蛇";
		mes "才能找到她。第一把剑";
		mes "是爱，第二把剑";
		mes "是绝望，第三把剑";
		mes "是愤怒，第四把剑是";
		mes "希望。为了找到她，拯救她。^000000";
		next;
		mes "^3355FF...............................";
		mes "这首诗更深的含义";
		mes "如果确实存在，";
		mes "你也无法理解。^000000";
		set KHCottagePoem1,3;
		close;
	}
	else  if ((KHCottagePoem1 > 2) || (KielHyreQuest >= 30)) {
		mes "^3355FF这里就是你找到";
		mes "写有诗歌的纸张的地方。也许";
		mes "写下这首诗。也许";
		mes "最好刷新记忆，";
		mes "再";
		mes "最好再读一遍那首诗。^000000";
		next;
		switch(select("重读:取消")) {
		case 1:
			mes "^0000FF她会在一个";
			mes "像两极一样寒冷的地方。";
			mes "当井水干涸";
			mes "大地龟裂时，";
			mes "通往她心灵的道路——";
			mes "一颗像水晶一样";
			mes "透明的心——会打开。^000000";
			next;
			mes "^3355FF我必须用四把剑";
			mes "对付四条蛇";
			mes "才能找到她。第一把剑";
			mes "是爱，第二把剑";
			mes "是绝望，第三把剑";
			mes "是愤怒，第四把剑是";
			mes "希望。为了找到她，拯救她。^000000";
			next;
			mes "^3355FF...............................";
			mes "这首诗更深的含义";
			mes "如果确实存在，";
			mes "你也无法理解。^000000";
			close;
		case 2:
			mes "^3355FF没必要";
			mes "重读这首诗。";
			mes "你真是个天才！^000000";
			close;
		}
	}
}


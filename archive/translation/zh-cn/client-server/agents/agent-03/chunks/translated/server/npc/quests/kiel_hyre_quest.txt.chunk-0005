kh_vila,14,55,0	script	Calabash#khp1	111,{
	if ((countitem(7329) < 1) && (countitem(7516) < 1) && (countitem(7491) < 1) && (KielHyreQuest < 38)) {
		if (checkweight(7329,1) == 0) {
			mes "^3355FF这是一个漂亮的葫芦。";
			mes "你甚至可以从里面";
			mes "从里面得到东西……";
			mes "但首先你最好减轻";
			mes "额外负重。";
			mes "减轻负重，指的是物品。^000000";
			close;
		}
		mes "^3355FF这是一个看起来很昂贵的葫芦，";
		mes "换个不那么讲究的说法，";
		mes "就是一个‘葫芦’。";
		mes "你要怎么做？^000000";
		next;
		switch(select("打破葫芦:查看葫芦内部:忽略")) {
		case 1:
			mes "^3355FF你不能打破";
			mes "不能打破那个葫芦……";
			mes "你是英雄，不是破坏者。";
			mes "不过，如果这种破坏行为";
			mes "可以被视为";
			mes "那就可以算作英雄行为。^000000";
			close;
		case 2:
			mes "^3355FF你温柔地把手伸进";
			mes "把手伸进";
			mes "葫芦，轻轻地";
			mes "用手指轻轻摸索，";
			mes "直到取出";
			mes "取出一把旧铜钥匙。^000000";
			getitem 7329,1; //Old_Bronze_Key
			close;
		case 3:
			mes "^3355FF里面大概什么都没有。^000000";
			close;
		}
	}
	else {
		mes "^3355FF这是那个昂贵的";
		mes "葫芦，你从中取出了";
		mes "";
		mes "旧铜钥匙。";
		mes "现在对你没用了。^000000";
		close;
	}
}


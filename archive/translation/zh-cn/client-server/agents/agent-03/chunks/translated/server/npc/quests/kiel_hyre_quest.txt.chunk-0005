			mes "所以无法捡起它。^000000";
			mes "";
			close;
		}
		mes "^3355FF你在地板上发现一封信，";
		mes "自然地，";
		mes "你把它捡起来，尽管";
		mes "它并不是";
		mes "写给你的。^000000";
		getitem 7490,1; //Kyll_Hire_Letter
		set KielHyreQuest,20;
		close;
	} 

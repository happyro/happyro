		mes "^3355FF你进入了房间。^000000";
		close;
	}
	end; 
}

//----------------------------------------------------------------------------
// Cottage interior, kitchen; Box (Pet Food vending machine)
//----------------------------------------------------------------------------
kh_vila,16,175,0	script	Box#khp1	111,{
	mes "^FFFFFF##^000000*Tasty-Nutricious-Delicious*";
	mes "*Cute Pet Doof Vending Machine*";
	mes "这是给可爱宠物的最佳食物，";
	mes "比市场上可以买到的";
	mes "宠物食品更好！";
	mes "^FFFFFF_^000000";
	mes "价格：1,100 Zeny（很便宜！）";
	next;
	switch(select("购买！:取消")) {
	case 1:
		if (Zeny < 1100) {
			mes "^3355FF遗憾的是，你";
			mes "没有足够的";
			mes "Zeny投入";
			mes "自动售货机。^000000";
			close;
		}
		else {
			mes "^3355FF糟糕……！^000000";
			mes "^3355FF1,100 Zeny 对宠物食品来说";
			mes "对宠物食品来说很贵，";
			mes "但如果它比普通食品好，";
			mes "也许值得一试。^000000";
			next;
			mes "^3355FF糟糕……！";
			mes "它没什么特别的，";
			mes "一点特别也没有！只是";
			mes "普通宠物食品！";
			set Zeny, Zeny-1100;
			getitem 537,1;	//Pet_Food
			close;
		}
	case 2:
		mes "^3355FF这台自动售货机不知为何";
		mes "看起来十分可疑，";
		mes "让人觉得不太对劲。^000000";
		close;
	}
}


	close;
}

lhz_cube,234,202,0	script	Picture#cube	HIDDEN_NPC,{
	if (lhz_secret01 < 2) {
		mes "^3355FF墙上的画不知为何吸引了你的注意。^000000";
		next;
		if ( select("查看画后。", "取消" ) == 1) {
			mes "^3355FF你使尽全力推拉，但画纹丝不动。既然这么难移动，后面一定藏着东西。^000000";
		}
		close;
	}
	if (lhz_secret01 == 2) {
		mes "^3355FF墙上的画不知为何吸引了你的注意。^000000";
		next;
		if (select( "查看画后。", "取消" ) == 1) {
			mes "^3355FF你使尽全力推拉，但仅凭蛮力很难移动这幅画。^000000";
			next;
			input .@input$;
			if (.@input$ == "Jackknife") {
				mes "^3355FF你把折叠刀插入画下并扭动，将画从墙上撬下。^000000";
				next;
				mes "^3355FF你发现画后写着以下数字：^000000";
				mes " ";
				.@number_rand = rand(1,3);
				if (.@number_rand == 1) {
					mes "4 3 2 9 1 6 8 2 7";
					lhz_secret01 = 3;
				}
				else if (.@number_rand == 2) {
					mes "3 6 4 1 2 8 7 1 5";
					lhz_secret01 = 4;
				}
				else {
					mes "4 9 3 7 6 2 8 6 6";
					lhz_secret01 = 5;
				}
				close;
			}
			mes "^3355FF遗憾的是，这样仍不足以移动画。也许该试试别的方法。^000000";
			close;
		}
		close;
	}
	if (lhz_secret01 < 6) {
		mes "^3355FF画后写着以下数字。既然藏起来了，这些数字一定很重要。^000000";
		mes " ";
		if (lhz_secret01 == 3)
			mes "4 3 2 9 1 6 8 2 7";
		else if (lhz_secret01 == 4)
			mes "3 6 4 1 2 8 7 1 5";
		else if (lhz_secret01 == 5)
			mes "4 9 3 7 6 2 8 6 6";
		close;
	}
	mes "^3355FF墙上挂着一幅画。^000000";
	next;
	if (select( "查看画下。", "取消" ) == 1) {
		mes "^3355FF画后有一些数字，但现在没必要记住它们。^000000";
	}
	close;
}


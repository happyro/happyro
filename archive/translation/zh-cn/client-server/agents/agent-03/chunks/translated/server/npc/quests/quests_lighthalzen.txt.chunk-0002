			next;
			if (select( "Not yet.", "Yes.") == 1) {
				mes "[Fishbone]";
				mes "呃……？好吧，没问题。慢慢来。";
				close;
			}
			mes "[Fishbone]";
			mes "太好了！好吧，出发！";
			close2;
			lhz_sincube = 7;
			switch(rand(1,3)) {
			case 1: warp "lhz_cube",67,193; break;
			case 2: warp "lhz_cube",66,136; break;
			case 3: warp "lhz_cube",66,74; break;
			}
			end;
		}
		if (lhz_sincube < 10) {
			mes "[Fishbone]";
			mes "嗯，你一定还没有完成";
			if (lhz_boss == 6) {
				mes "在雷根贝勒实验室需要做的事。";
			}
			else {
				mes "你在实验室做的事。要";
			}
			mes "我再送你去那里吗？";
			next;
			if (select( "No.", "Yes." ) == 1) {
				mes "[Fishbone]";
				mes "天啊，你在那里一定很辛苦。准备好再告诉我，好吗？";
				close;
			}
			mes "[Fishbone]";
			mes "你很有精神嘛！嘿！我喜欢你的风格~准备好，出发……！";
			close2;
			lhz_sincube = 7;
			switch(rand(1,3)) {
			case 1: warp "lhz_cube",67,193; break;
			case 2: warp "lhz_cube",66,136; break;
			case 3: warp "lhz_cube",66,74; break;
			}
			end;
		}
		if (lhz_sincube == 10) {
			mes "[Fishbone]";
			mes "嘿，你回来了！太好了，我开始担心你了。你在那里得到想要的东西了吗？";
			if (isbegin_quest(12014) == 1)
				completequest 12014;// More missions
			next;
			mes "[" + strcharinfo(0) + "]";
			mes "是的……希望如此。";
			next;
			mes "[Fishbone]";
			mes "很好！不管你做了什么，希望能狠狠打击他们！我曾是雷根贝勒受尊敬的科学家，直到被解雇！那些忘恩负义的混蛋活该！";
			next;
			mes "[Fishbone]";
			mes "不过现在的工作更适合我，也不用再担心公式和算法了。";
			next;
			mes "[Fishbone]";
			mes "哦对了，你刚才去的地方有通往实验室的秘密路径。如果你愿意，我可以送你回去。怎么样？";
			next;
			if (select( "Sure", "No thanks~" ) == 1) {
				mes "[Fishbone]";
				mes "好吧，出发！祝你好运，朋友。";
				close2;
				switch(rand(1,3)) {
				case 1: warp "lhz_cube",67,193; break;
				case 2: warp "lhz_cube",66,136; break;
				case 3: warp "lhz_cube",66,74; break;
				}
				end;
			}
			mes "[Fishbone]";
			mes "好吧，由你决定。你持有的通行证应该能让你进入实验室。祝你好运，朋友。";
			close;
		}
		mes "[Fishbone]";
		mes "嘿，朋友！好久不见。你还好吗？我好得很，谢谢~";
		close;
	}
	if (BaseLevel < 60) {
		mes "嘿，小子，快离开！看不出我在做见不得人的交易吗？这里不是你这种娃娃脸该来的地方！";
		close;
	}
	if (lhz_boss > 6) {
		mes "[Fishbone]";
		mes "嘿，朋友！好久不见。你还好吗？我好得很，谢谢~";
		close;
	}
}


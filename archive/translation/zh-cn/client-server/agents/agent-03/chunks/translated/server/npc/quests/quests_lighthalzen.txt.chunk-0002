lhz_cube,237,183,0	script	Barrel#cube	HIDDEN_NPC,{
	if (lhz_sincube < 8) {
		mes "^3355FF你发现一个简陋的木桶。^000000";
		close;
	}
	if (lhz_sincube == 8) {
		mes "^3355FF你发现一个简陋的木桶。里面似乎有东西，但你需要某件物品把桶砸开。^000000";
		next;
		input .@input$;
		if (.@input$ == "Axe") {
			mes "^3355FFAxe in hand, you lift";
			mes "你把它举过头顶向下挥，砸开桶顶。里面有一个顶部带金属板的箱子。^000000";
			next;
			mes "^3355FFThe numbers one";
			mes "金属板表面刻着 0 到 9 的数字，就像某种键盘……^000000";
			lhz_sincube = 9;
		}
		else {
			mes "^3355FFDoing that probably won't";
			mes "无法打开这个桶。你需要试试其他方法。^000000";
		}
		close;
	}
	if (lhz_sincube == 9) {
		if (lhz_secret01 < 3) {
			mes "^3355FFYou decide to enter";
			mes "向金属键盘输入数字。记住，一次只能输入一位数字……^000000";
			next;
			for( .@i = 0; .@i < 9; .@i++ )
				input .@input;
			mes "^3355FFNothing happened...^000000";
			close;
		}
		if (lhz_secret01 <= 5) {
			switch(lhz_secret01) {
			case 3: setarray .@numbers[0],4,3,2,9,1,6,8,2,7; break;
			case 4: setarray .@numbers[0],3,6,4,1,2,8,7,1,5; break;
			case 5: setarray .@numbers[0],4,9,3,7,6,2,8,6,6; break;
			}
			mes "^3355FFYou decide to enter";
			mes "向桶内箱子顶部金属板上的数字键盘输入数字。^000000";
			next;
			for( .@i = 0; .@i < 9; .@i++ ) {
				input .@input;
				if (.@input == .@numbers[.@i])
					.@number_line++;
			}
			if (.@number_line == 9) {
				mes "^3355FFThe metal plate slides";
				mes "打开后，你在箱子里发现一把钥匙。你决定保留这把^000000黄钥匙^3355FF。^000000";
				lhz_secret01 = 6;
			}
			else {
				mes "^3355FFNothing happened.";
				mes "你可能没有输入正确的数字。^000000";
			}
			close;
		}
		mes "^3355FFThis is the box with";
		mes "这是你找到^000000黄钥匙^3355FF的数字键盘。箱子现在空了。^000000";
		close;
	}
	mes "^3355FF这是一个箱子，上面有一块看起来像简陋键盘的金属板。^000000";
	close;
}


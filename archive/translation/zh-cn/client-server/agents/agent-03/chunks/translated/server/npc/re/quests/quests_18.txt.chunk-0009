// Main Quest: Step 51.
wolfvill,140,112,0	duplicate(#contest1)	#sms01	HIDDEN_WARP_NPC,5,5

wolfvill,142,109,1	duplicate(dummy_cloaked_npc)	Miriam#sms01	4_EP18_MIRIAM
wolfvill,143,110,1	duplicate(dummy_cloaked_npc)	Maram#sms01	4_EP18_MARAM

wolfvill,140,112,5	script(CLOAKED)	Suad#sms01	4_EP18_SUAD,{
	if (getequipid(EQI_HEAD_TOP) != 400127) {	// Ep18_Mini_Elly
		npctalk ".......", "Suad#sms01", bc_self;
		unittalk getcharid(3), "" + strcharinfo(0) + " : Where did Mini Elly go?", bc_self;
		end;
	}
	if (ep18_main == 47) {
		cutin "ep18_suad_01.png",0;
		mes "[Suad]";
		mes "冒险家？你怎么已经回来了？你不是和Miriam去调查武器来源了吗？";
		next;
		select( "我查到了，但来源是……" );
		cutin "",255;
		mes "[Mini Elly]";
		mes "不只是这样。更大的问题是，本应被处理掉的武器和弹药在没有稳定性保障的情况下不断流入。";
		mes "分析结果显示，储存火药和未管理武器的风险约为9.72%。";
		next;
		cutin "ep18_suad_03.png",0;
		mes "[Suad]";
		mes "我预料到了，但情况比想象中更糟。我之前只担心来源，现在也无法保证武器的稳定性。那些都是旧武器……";
		next;
		cutin "ep18_suad_01.png",0;
		mes "[Suad]";
		mes "虽然我们确实需要武装，但不能使用来源可疑的物品。如果开始追查从另一边流出的武器并把事情闹大，局势可能会恶化。";
		next;
		mes "[Suad]";
		mes "不过，寻找可靠供应商并进行谈判也需要时间，所以我们必须谨慎决定。";
		next;
		mes "[Suad]";
		mes "现在先把所有武器收回，等Maram和Miriam回来后再讨论未来计划。";
		mes "Miriam和Maram不是一起回来的吗？";
		next;
		select( "揭露武器走私……" );
		mes "[Suad]";
		mes "是啊，看来现在我们只能等。";
		next;

// Main Quest: Step 44.
rachel,72,42,3	duplicate(dummy_cloaked_npc)	Maram#1_2	4_EP18_MARAM

rachel,75,44,3	script	Bearded Jack#armsman_rachel	4_M_MIDDLE1,{
	if (ep18_main == 43) {
		cloakoffnpcself( "Maram#1_2" );
		mes "[Mini Elly]";
		mes "你到了。‘Bearded Jack’经营的是五金店。";
		next;
		mes "[Bearded Jack]";
		mes "欢迎。有什么我能帮你的吗？";
		next;
		mes "[Bearded Jack]";
		mes "说到菜刀和锅具，拉赫没有比我们店更好的地方。";
		mes "请慢慢看。";
		next;
		cutin "ep18_maram_01.png",2;
		mes "[Maram]";
		mes "呃，我们来找一点不一样的东西。";
		mes "冒险家，你刚才说什么？";
		next;
		cutin "",255;
		switch( select( "臭袜子", "臭蒲公英", "香袜子", "香蒲公英" ) ) {
		case 1:
			mes "[Mini Elly]";
			mes "嗯，我觉得不是这个。";
			next;
			mes "[Bearded Jack]";
			mes "你为什么要在我们店里找这么脏的东西？";
			close2;
			cloakonnpcself( "Maram#1_2" );
			end;
		case 2:
			mes "[Bearded Jack]";
			mes "哎呀，终于来了。";
			mes "你是来看看香蒲公英盛开的地方吗？";
			next;
			mes "[Bearded Jack]";
			mes "去汶斯，你会在那里找到我。";
			mes "在汶斯村的一个角落，有一位不为人知的武器商人。";
			next;
			mes "[Bearded Jack]";
			mes "如果有人问是谁推荐你的，就说是Jack推荐的。";
			mes "他们大概只做短期生意，方便迅速赚一笔就走，所以你去晚了，他们就不会和你交易。";
			next;
			mes "[Bearded Jack]";
			mes "总之，连接到<NAVI>[武器商店]<INFO>veins,293,282,0,101,0</INFO></NAVI>后，就不归我管了。";
			mes "那么，祝你好运。";
			erasequest 16575;
			setquest 16576;
			ep18_main = 44;
			close2;
			cloakonnpcself( "Maram#1_2" );
			end;
		case 3:
			mes "[Mini Elly]";
			mes "嗯，我觉得不是。";
			next;
			mes "[Bearded Jack]";
			mes "不，我们店是五金店，不是洗衣店。";
			close2;
			cloakonnpcself( "Maram#1_2" );
			end;
		case 4:
			end;
		}
	}
	if (ep18_main == 44) {
		mes "[Bearded Jack]";
		mes "总之，连接到<NAVI>[武器商人]<INFO>veins,293,282,0,101,0</INFO></NAVI>后，就不归我管了。";
		mes "那么，祝你好运。";
		cloakonnpcself( "Maram#1_2" );
		close;
	}
	mes "[Bearded Jack]";
	mes "欢迎。这是‘Bearded Jack’五金店。";
	mes "我们出售制作精良的菜刀和锅具。";
	next;
	mes "[Bearded Jack]";
	mes "我的名字？当然是Bearded Jack。";
	mes "这家店完全属于我！";
	close;

OnInit:
	questinfo( QTYPE_QUEST2, QMARK_YELLOW, "isbegin_quest(16575) == 1" );
	end;
}


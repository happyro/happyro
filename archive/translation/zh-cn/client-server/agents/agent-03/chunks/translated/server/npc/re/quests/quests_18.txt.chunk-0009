		mes "我也分析过了。那些武器被归类为杀伤人员武器，也就是用于战争的武器。";
		mes "即使你想用它们打猎，猎物也会被撕碎，根本无法用于那种用途。";
		next;
		cutin "ep18_suad_03.png",2;
		mes "[Suad]";
		mes "发生了什么？";
		mes "获得这种武器可不容易。";
		next;
		cutin "ep18_maram_03.png",2;
		mes "[Maram]";
		mes "哦……我可以肯定，这种东西在市场上并不容易买到。";
		mes "我想知道它们是从哪里来的。";
		next;
		cutin "ep18_miriam_01.png",2;
		mes "[Miriam]";
		mes "有一个猜测，但还不能确定。";
		mes "那么，我们试着确认那些人的身份，查清他们来自哪里，怎么样？";
		next;
		cutin "ep18_suad_03.png",2;
		mes "[Suad]";
		mes "我明白了。总之，抗议活动需要一定程度的武装。";
		mes "我们用一些诱饵交换情报，怎么样？";
		next;
		cutin "ep18_suad_02.png",2;
		mes "[Suad]";
		mes "我也不一定反对通过实际交易来武装自己。";
		mes "我们一直遭受压迫，是因为缺乏力量。";
		next;
		cutin "ep18_maram_02.png",2;
		mes "[Maram]";
		mes "嘿，首领。我们好不容易把事情从斗争转为抗议，可如果在战争中受到武器诱惑，该怎么办？";
		mes "我们只要找出来源，只找来源。";
		next;
		cutin "ep18_maram_01.png",2;
		mes "[Maram]";
		mes "让Suad在这里带头不太合适。";
		mes "让冒险家和Miriam主导调查，怎么样？";
		next;
		cutin "ep18_miriam_01.png",2;
		mes "[Miriam]";
		mes "比起直接面对那些人，我想调查另一边的情况。";
		mes "所以直接接触就交给你和冒险家了，Mara。";
		next;
		cutin "ep18_maram_02.png",2;
		mes "[Maram]";
		mes "好了。冒险家，我们开始工作吧？";
		mes "为了安全起见，假装对交易感兴趣再接近他们。";
		mes "有这张地图，应该不会太难。";
		erasequest 16573;
		setquest 16574;
		ep18_main = 42;
		getitem 1000405,40;	// Ep18_Amethyst_Fragment
		getexp 18252408,2000000;
		close2;
		cutin "",255;
		cloakonnpcself( "Miriam#1" );
		cloakonnpcself( "Maram#1" );
		end;
	}
	end;

OnInit:
	questinfo( QTYPE_QUEST2, QMARK_YELLOW, "isbegin_quest(16573) == 1" );
	end;
}

// Main Quest: Step 43.
wolfvill,143,145,7	script(CLOAKED)	Radical Young Man#Radic	4_M_RASWORD,{
	if (getequipid(EQI_HEAD_TOP) != 400127) {	// Ep18_Mini_Elly
		mes "[Mini Elly]";
		mes "把它从袋子里拿出来。请放到你的头上。";
		close;
	}
	if (ep18_main == 42) {
		cloakonnpcself( "Suad#1" );
		cloakoffnpcself( "Maram#1_1" );
		cutin "ep18_maram_01.png",2;
		mes "[Maram]";
		mes "你好。";
		mes "我有件事想问一下，可以吗？";
		next;
		cutin "",255;
		mes "[Radical Man]";
		mes "怎么了？我没什么好说的。";
		next;
		cutin "ep18_maram_02.png",2;
		mes "[Maram]";
		mes "不，这些武器酷极了。";
		mes "在其他地方似乎很难找到，你是从哪里弄来的？";
		next;
		cutin "",255;
		mes "[Radical Man]";
		mes "这个？因为有人卖得特别便宜，所以我就买了！";
		mes "既能保护自己又能向别人炫耀……我穿成这样，谁还敢惹我？";
		next;
		mes "[Energetic Man]";
		mes "没错，没错！抗议时也需要这种程度的保护才能安全！";
		mes "你觉得他们会自己害怕得发抖，在神殿前低头吗？";
		next;
		cutin "ep18_maram_01.png",2;
		mes "[Maram]";
		mes "你能提供卖家的一些信息吗？";
		next;
		cutin "",255;
		mes "[Radical Man]";
		mes "呃……我们不能就这样直接穿着。毕竟我们也花了些力气才弄到它。";
		next;
		cutin "ep18_maram_02.png",2;
		mes "[Maram]";
		mes "但他们说在那边卖得很便宜，对吧？";
		mes "看来他们想清理库存。那我们该相信自己知道的，还是相信神殿知道的~";
		next;
		cutin "",255;
		mes "[Energetic Man]";
		mes "哈，好吧。如果这么便宜卖出的武器落到那些被女神思想支配的人手里，可不是什么好事，对吧？";
		mes "直说吧。总之，要参加抗议，我们就必须武装起来。";
		next;
		cutin "ep18_maram_02.png",2;
		mes "[Maram]";
		mes "你想得很好。不愧是你，真聪明。";
		next;
		cutin "",255;
		mes "[Radical Man]";
		mes "我明白了……但我们不能随便见面。";
		mes "首先，去拉赫找Bearded Jack。";
		next;
		npctalk "Maram：Bearded Jack？", "Maram#1_1", bc_self;
		mes "[Radical Man]";
		mes "如果你说是来买香蒲公英的，他们会从那里引导你。";
		mes "我不会无视所谓的安全，也不是傻瓜。";
		next;
		cutin "ep18_maram_01.png",2;
		mes "[Maram]";
		mes "谁是傻瓜？我一直说的是自己很聪明。";
		mes "谢谢你提供这么重要的信息！";
		next;
		cutin "",255;
		mes "[Mini Elly]";
		mes "你要回拉赫。我们重新设置目标坐标。";
		next;
		cutin "ep18_maram_01.png",2;
		mes "[Maram]";
		mes "那么，冒险家。看来要找到核心，我们得稍微绕点路，果然如此。";
		mes "我们一起去<NAVI>[拉赫]<INFO>rachel,75,44,0,101,0</INFO></NAVI>吧！";
		erasequest 16574;
		setquest 16575;
		ep18_main = 43;
		cutin "",255;
		close2;
		cutin "",255;
		cloakonnpcself();
		cloakonnpcself( "Excited Youth#Radical3" );
		cloakonnpcself( "Maram#1_1" );
		end;
	}
	mes "[Radical Man]";
	mes "这样武装起来不是更安全吗？";
	mes "就连那些像拉赫人一样患有女神综合征的家伙，也会自己害怕得发抖、低下头！";
	close;

OnInit:
	questinfo( QTYPE_QUEST2, QMARK_YELLOW, "isbegin_quest(16574) == 1" );
	end;
}


veins,289,281,7	duplicate(dummy_cloaked_npc)	Maram#1_3	4_EP18_MARAM

veins,293,282,3	script	Dandelion#weapons_bains	4_M_DESERT,{
	if (ep18_main == 44) {
		mes "[Maram]";
		mes "你好~";
		mes "你们营业吗？";
		next;
		cutin "",255;
		mes "[Dandelion]";
		mes "我们打烊了。";
		next;
		cutin "ep18_maram_02.png",2;
		mes "[Maram]";
		mes "别这样。我是Jack介绍来的，他说这里有臭蒲公英。";
		next;
		cutin "",255;
		mes "[Dandelion]";
		mes "谁啊，蒲公英，谁啊！";
		mes "哪个混蛋想出了这么奇怪的暗号！";
		next;
		cutin "ep18_maram_01.png",2;
		mes "[Maram]";
		mes "啊，你的名字是……原来是蒲公英。";
		mes "和安全有关的暗号，居然这么简单。";
		next;
		cutin "",255;
		mes "[Dandelion]";
		mes "总之，怎么回事！";
		mes "如果你是来买武器的，就别犹豫，拿你需要的吧。";
		next;
		select( "我是来买武器的……" );
		cutin "ep18_maram_02.png",2;
		mes "[Maram]";
		mes "对吧？冒险家说得没错。";
		mes "与其说是买一两件武器，不如说是批量采购，对吧？";
		next;
		cutin "",255;
		mes "[Dandelion]";
		mes "批量采购？你打算买多少？";
		next;
		cutin "ep18_maram_01.png",2;
		mes "[Maram]";
		mes "嗯，大概这么多？";
		mes "这个数量在本店可以接受吗？";
		next;
		cutin "",255;
		mes "[Dandelion]";
		mes "咕噜，这、这么多？你是想发动战争吗？";
		mes "呃、嗯，给我一点时间的话，应该可以。";
		next;
		cutin "ep18_maram_01.png",2;
		mes "[Maram]";
		mes "我们该怎么办？时间不多了。";
		mes "希望我们能尽快找到它。";
		next;
		cutin "",255;
		mes "[Dandelion]";
		mes "告诉我你的时间安排。我会尽快配合。";
		next;
		cutin "ep18_maram_01.png",2;
		mes "[Maram]";
		mes "那也不错，不过直接把我们介绍给供应商怎么样？";
		mes "中间费用由我们承担，不会给你添麻烦。";
		next;
		cutin "",255;
		mes "[Dandelion]";
		mes "嘿！做生意时谁会透露背景啊！";
		mes "够了，回去，回去！";
		next;
		cutin "ep18_maram_02.png",2;
		mes "[Maram]";
		mes "嘿，你在骗谁？我什么都知道。以这种特殊价格出售，只是引人注目的经营策略，对吧？";
		mes "总之，我们不会建立长期商业关系，对吧？";
		next;
		cutin "ep18_maram_01.png",2;
		mes "[Maram]";
		mes "所以我只是想从你这边打听一点消息。";
		mes "不管是我们的紧急情况，还是免除中间费，对双方都有好处，不是吗？";
		next;
		cutin "",255;
		mes "[Dandelion]";
		mes "嗯……好吧。但绝对不能泄露。";
		next;
		cutin "ep18_maram_01.png",2;
		mes "[Maram]";
		mes "真是明知故问。";
		next;
		cutin "",255;
		mes "[Dandelion]";
		mes "是托尔火山。深处有一座秘密基地，武器就是从那里来的。";
		mes "告诉你是因为那里的库存一旦耗尽，交易也会中断。";
		next;
		cutin "ep18_maram_01.png",2;
		mes "[Maram]";
		mes "听你说话的样子，似乎很快就要断绝关系了，对吧？";
		next;
		cutin "",255;
		mes "[Dandelion]";
		mes "小子，别再到处晃了。剩下的自己调查。";
		mes "既然拿到了想要的东西，就付佣金离开吧。";
		next;
		cutin "ep18_maram_03.png",2;
		mes "[Maram]";
		mes "托尔火山的秘密基地……这闻起来非常可疑。";
		mes "我觉得那里可能就是我们的最终目的地，你不觉得吗？";
		next;
		cutin "ep18_maram_01.png",2;
		mes "[Maram]";
		mes "我们在<NAVI>[托尔火山]<INFO>thor_v01,169,169,0,101,0</INFO></NAVI>见。记得做好准备！";
		mes "不要直接进入军事基地；从那里朝3点钟方向走，我会在那里等你。";
		erasequest 16576;
		setquest 16577;
		ep18_main = 45;
		close2;
		cutin "",255;
		cloakonnpcself( "Maram#1_3" );
		end;
	}
	if (ep18_main == 45) {
		cloakoffnpcself( "Maram#1_3" );
		mes "[Dandelion]";
		mes "小子，别再到处晃了。剩下的自己调查。";
		mes "既然拿到了想要的东西，就付佣金离开吧。";
		next;
		cutin "ep18_maram_01.png",2;
		mes "[Maram]";
		mes "我们在<NAVI>[托尔火山]<INFO>thor_v01,169,169,0,101,0</INFO></NAVI>见。记得做好准备！";
		mes "不要直接进入军事基地；从那里朝3点钟方向走，我会在那里等你。";
		close2;
		cutin "",255;
		cloakonnpcself( "Maram#1_3" );
		end;
	}
	end;

OnInit:
	questinfo( QTYPE_QUEST2, QMARK_YELLOW, "isbegin_quest(16576) == 1" );
	end;
}


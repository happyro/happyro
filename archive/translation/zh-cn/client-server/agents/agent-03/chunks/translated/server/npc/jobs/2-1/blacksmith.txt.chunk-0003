	else {
		mes "[Baisulist]";
		mes "哦……";
		mes "已经有一阵子";
		mes "没去";
		mes "艾尔贝塔了。";
		next;
		mes "[Baisulist]";
		mes "我不久前从那里";
		mes "订了东西，";
		mes "但还没收到";
		mes "货物……";
		next;
		mes "[Baisulist]";
		mes "不知道……";
		mes "铁匠公会";
		mes "是不是人手不足？我想不出他们迟到的其他原因……";
		next;
		mes "[Baisulist]";
		mes "我什么时候才能拿到";
		mes "我的特殊奥术魔杖？";
		close;
	}
}

morocc,27,112,4	script	Wickebine#BLS	725,{
	if (BSMITH_Q == 10 && countitem(1219) > 0) {

		mes "[Wickebine]";
		mes "哈哈哈哈！";
		mes "终于！现在……";
		mes "让我";
		mes "看看！";
		next;
		mes "- 她看起来非常开心。 -";
		next;
		set BSMITH_Q,14;
		delitem 1219,1; //Gladius
		cutin "Job_Black_hucke01",2;
		mes "[Wickebine]";
		mes "你是";
		mes "艾因布罗克铁匠公会的人吗？";
		mes "把这句话转告给盖休庞兹特！";
		next;
		cutin "Job_Black_hucke03",2;
		mes "[Wickebine]";
		mes "'^660000你迟到了！";
		mes "你知道我等了";
		mes "多久吗？！^000000'";
		next;
		cutin "Job_Black_hucke02",2;
		mes "[Wickebine]";
		mes "不过，这也是";
		mes "一件精心制作的物品。";
		mes "告诉他我很满意做工质量。";
		next;
		getitem 1073,1; //Merchant_Voucher_1
		emotion ET_THROB;
		mes "[Wickebine]";
		mes "这是收据。";
		mes "我想你做得";
		mes "很好。";
		mapannounce "morocc","谢谢你送来，" + strcharinfo(0) + "～！",bc_map;
		close2;
		cutin "Job_Black_hucke02",255;
		end;
	}
	else if (BSMITH_Q == 14) {
		emotion ET_THROB;
		cutin "Job_Black_hucke02",2;
		mes "[Wickebine]";
		mes "谢谢你送货。";
		close2;
		cutin "Job_Black_hucke02",255;
		end;
	}
	else {
		cutin "Job_Black_hucke03",2;
		mes "[Wickebine]";
		mes "……";
		next;
		mes "[Wickebine]";
		mes "……";
		mes "……";
		next;
		mes "[Wickebine]";
		mes "他们迟到了。";
		mes "他们迟到了，";
		mes "迟到了，";
		mes "迟到了~！";
		next;
		mes "[Wickebine]";
		mes "从盖休庞兹特那里寄东西要多久？通常，吉芬铁匠公会都很准时……";
		next;
		emotion ET_THROB;
		mes "[Wickebine]";
		mes "哦哦……";
		mes "这真是";
		mes "令人难过……";
		close2;
		cutin "Job_Black_hucke03",255;
		end;
	}
}


ein_in01,24,41,5	script	Blacksmith Guildsman#moc	726,{
	if (BSMITH_Q == 16) {
		emotion ET_SCRATCH;
		mes "[Mitehmaeeuh]";
		mes "哦……你就是想成为铁匠的人吗？";
		mes "很好，呵呵。";
		mes "正如你从之前的测试中了解到的，你不会立刻从商人晋升为铁匠。";
		next;
		mes "[Mitehmaeeuh]";
		mes "你真正了解多少锻造知识？准备好回答我的问题了吗？";
		next;
		if (select("是:还没有~") == 1) {
			mes "[Mitehmaeeuh]";
			mes "好吧……";
			mes "我的测试很简单。";
			mes "我会问五个问题。";
			mes "错得太多就会失败。";
			mes "而且我不会告诉你";
			mes "错了哪些。";
			next;
			set .@blackss_te,0;
			mes "[Mitehmaeeuh]";
			mes "请仔细听";
			mes "并认真回答……";
			next;
			switch(rand(1,3)) {
			case 1:
				mes "[Mitehmaeeuh]";
				mes "1. 学习^8E6B23折扣^000000技能";
				mes "需要什么能力？";
				mes "";
				next;
				if (select("3级手推车:物品鉴定:10级金钱攻击:3级重量强化") == 4)
					set .@blackss_te,.@blackss_te+20;
				mes "[Mitehmaeeuh]";
				mes "2. 使用^8E6B23金钱风暴^000000攻击时，";
				mes "可以对敌人施加什么";
				mes "状态效果？";
				mes "";
				next;
				if (select("眩晕:失明:混乱:沉默") == 1)
					set .@blackss_te,.@blackss_te+20;
				mes "[Mitehmaeeuh]";
				mes "3. 使用精通的金钱攻击技能";
				mes "进行攻击时要花费多少Zeny？";
				mes "（10级金钱攻击）";
				mes "";
				next;
				if (select("900 Zeny:1000 Zeny:2000 Zeny:100,000 Zeny") == 2)
					set .@blackss_te,.@blackss_te+20;
				mes "[Mitehmaeeuh]";
				mes "4. 精通^8E6B23折扣^000000技能后，";
				mes "折扣率是多少？";
				mes "";
				mes "请认真回答。";
				next;
				if (select("21 % :22 % :23 % :24 % ") == 4)
					set .@blackss_te,.@blackss_te+20;
				mes "[Mitehmaeeuh]";
				mes "5. 精通^8E6B23高价卖出^000000技能后，";
				mes "向NPC出售物品时";
				mes "最高可以收取多少百分比？";
				mes "";
				mes "这是最后一题。";
				next;
				if (select("21%:22%:23%:24%") == 3)
					set .@blackss_te,.@blackss_te+20;
				break;
			case 2:
				mes "[Mitehmaeeuh]";
				mes "1. 以下哪种怪物";
				mes "会掉落钢铁？";
				mes "请作答。";
				next;
				if (select("邪骸战士:苍蝇:骷髅工人:安魂者") == 3)
					set .@blackss_te,.@blackss_te+20;
				mes "[Mitehmaeeuh]";
				mes "2. 以下哪种石头可以由";
				mes "红色血液制成？";
				mes "";
				next;
				if (select("火焰心脏:粗糙的风:大地的祝福:神秘冰块") == 1)
					set .@blackss_te,.@blackss_te+20;
				mes "[Mitehmaeeuh]";
				mes "3. 以下哪种石头在你的";
				mes "卡普拉仓库里最多？";
				mes "";
				next;
				select("翠绿之风:红色血液:绿色活:水蓝宝石");
					set .@blackss_te,.@blackss_te+20;
				mes "[Mitehmaeeuh]";
				mes "4. In general,";
				mes "以下哪种属性";
				mes "会受到风属性武器";
				mes "的最大伤害？";
				mes "请作答。";
				next;
				if (select("火属性:水属性:地属性:风属性") == 2)
					set .@blackss_te,.@blackss_te+20;
				mes "[Mitehmaeeuh]";
				mes "5. 制作1个钢铁";
				mes "需要多少铁矿石？";
				mes "请作答。";
				next;
				if (select("5个铁矿石:4个铁矿石:3个铁矿石:6个铁矿石") == 1)
					set .@blackss_te,.@blackss_te+20;
				break;
			case 3:
				mes "[Mitehmaeeuh]";
				mes "1. 在街上偶遇某人时，";
				mes "你通常会怎么做？";
				mes "";
				next;
				switch(select("问他需要什么。:简单交谈。:无视他。:送东西后逃跑。")) {
				case 1:
				case 2:
					set .@blackss_te,.@blackss_te+20;
					break;
				default:
					break;
				}
				mes "[Mitehmaeeuh]";
				mes "2. 在哪个村庄可以学习";
				mes "^8E6B23疯狂呐喊^000000和";
				mes "相关技能？";

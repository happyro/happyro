rebel_in,82,68,2	script	Arinoa Yurhik#TFQ01	4_F_GUNSLINGER,{
	if (checkweight(501,1) == 0 || (MaxWeight - Weight) < 1000) {
		mes "- Cannot progress, because you have too many items in your possession. -";
		close;
	}
	if (terra_gloria_main < 17) {
		emotion ET_THINK;
		mes "那个面无表情、正在翻找书籍和文件的枪手女孩瞥了我一眼，然后继续翻找书籍和文件。";
		close;
	}
	if (yurhik_quest == 0) {
		emotion ET_THINK;
		mes "那个面无表情、正在翻找书籍和文件的枪手女孩瞥了我一眼，然后继续翻找书籍和文件。";
		next;
		switch( checkquest(5727,PLAYTIME) ) {
		case -1:
			cloakoffnpcself( "Arivero Yurhik#TFQ02" );
			npctalk "你就是在 Clana Nemieri 闹出动静的冒险者吗？", "Arivero Yurhik#TFQ02", bc_self;
			mes "[Strange man]";
			mes "你就是在 Clana Nemieri 闹出动静的冒险者吗？";
			next;
			mes "[" + strcharinfo(0) + "]";
			mes "???";
			next;
			mes "你听到了突然出现的男人的声音。他到底从哪里出现的？";
			close;
		case 0:
		case 1:
			mes "名叫 Vero 的男人还没出现。看来他们还没准备好。";
			close;
		case 2:
			mes "时间到了。现在让我和他们谈谈。";
			next;
			cloakoffnpcself( "Arivero Yurhik#TFQ02" );
			npctalk "哎呀？！你在这里。你已经到了吗？", "Arivero Yurhik#TFQ02", bc_self;
			mes "[Arivero Yurhik]";
			mes "哎呀？！你在这里。你已经到了吗？";
			close;
		}
	}
	if (yurhik_quest == 1) {
		emotion ET_THINK;
		mes "那个面无表情、正在翻找书籍和文件的枪手女孩瞥了我一眼，然后继续翻找书籍和文件。";
		next;
		cloakoffnpcself( "Arivero Yurhik#TFQ02" );
		npctalk "你必须和我谈，不是和姐姐谈。", "Arivero Yurhik#TFQ02", bc_self;
		mes "[Arivero Yurhik]";
		mes "你必须和我谈，不是和姐姐谈。";
		close;

		mes "那我能怎么办？为什么吟游诗人不只唱他们看见和听见的？";
		mes "有些人听说过这事，有些人告诉我，所以一定是真的。";
		next;
		mes "[Lily]";
		mes "别担心。向教授报告时我会用冒险者的名字……";
		mes "是的……" + strcharinfo(0) + "。";
		mes "好吧。";
		next;
		mes "[Lily]";
		mes "这里有作为研究材料的怪物清单，感兴趣的话请查看任务。";
		close;
	case 3:
		mes "[Lily]";
		mes "啊，不……！";
		mes "慷慨的冒险者，请把我从教授的魔法中解放出来……！";
		close;
	}
	end;

S_CheckDelay:
	switch( checkquest(getarg(0),PLAYTIME) ) {
	case -1:
		break;
	case 0:
	case 1:
		mes "[Lily]";
		mes "你已经完成今天的报告了。";
		mes "明天的报告也能帮我吗……？";
		close;
	case 2:
		erasequest getarg(0);
		break;
	}
	return;

S_Give:
	next;
	if (select( "我接受。", "我很忙。" ) == 2) {
		mes "[Lily]";
		mes "研究最重要的是坚持。";
		mes "不忙时再帮我吧。";
		close;
	}
	mes "[Lily]";
	mes "谢谢！";
	mes "我会在这里等。";
	setquest getarg(0);
	close;

S_SetDelay:
	.@quest_ongoing = getarg(0);
	.@quest_first = getarg(1);
	.@quest_delay = getarg(2);
	next;
	mes "[Lily]";
	mes "谢谢你耐心的说明。";
	mes "但我不认为仅凭这些你就能理解全部故事。虽然这正是委托调查的魅力……";
	mes "我明天再问你。";
	if (.@quest_ongoing == .@quest_first)
		completequest .@quest_ongoing;
	else
		erasequest .@quest_ongoing;
	setquest .@quest_delay;
	getexp getarg(3), getarg(4);
	close;

OnInit:
	setunitdata getnpcid(0), UNPC_CLASS, JOB_SAGE;
	setunitdata getnpcid(0), UNPC_SEX, SEX_FEMALE;
	setunitdata getnpcid(0), UNPC_HAIRCOLOR, 6;
	setunitdata getnpcid(0), UNPC_HAIRSTYLE, 22;
	setunitdata getnpcid(0), UNPC_HEADTOP, 316;

	// completed first quest
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "checkquest(8550,HUNTING) == 2" );
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "checkquest(8553,HUNTING) == 2" );
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "checkquest(8556,HUNTING) == 2" );
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "checkquest(8559,HUNTING) == 2" );

	// completed daily
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "checkquest(8552,HUNTING) == 2" );
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "checkquest(8555,HUNTING) == 2" );
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "checkquest(8558,HUNTING) == 2" );
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "checkquest(8561,HUNTING) == 2" );

	// timeout
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "checkquest(8551,PLAYTIME) == 2" );
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "checkquest(8554,PLAYTIME) == 2" );
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "checkquest(8557,PLAYTIME) == 2" );
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "checkquest(8560,PLAYTIME) == 2" );

	// not started first quest
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "isbegin_quest(8550) == 0 && checkquest(8551,PLAYTIME) == -1" );
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "isbegin_quest(8553) == 0 && checkquest(8553,PLAYTIME) == -1" );
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "isbegin_quest(8556) == 0 && checkquest(8555,PLAYTIME) == -1" );
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "isbegin_quest(8559) == 0 && checkquest(8557,PLAYTIME) == -1" );

	// not started daily
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "isbegin_quest(8550) == 2 && isbegin_quest(8552) == 0 && checkquest(8551,PLAYTIME) == -1" );
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "isbegin_quest(8553) == 2 && isbegin_quest(8555) == 0 && checkquest(8554,PLAYTIME) == -1" );
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "isbegin_quest(8556) == 2 && isbegin_quest(8558) == 0 && checkquest(8557,PLAYTIME) == -1" );
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "isbegin_quest(8559) == 2 && isbegin_quest(8561) == 0 && checkquest(8560,PLAYTIME) == -1" );
	end;
}


// ein_dun03
einbech,143,244,3	script	Apprentice Researcher Sally#extdq01	4_F_LGTGIRL,{
	if (BaseLevel < 180) {
		mes "[Sally]";
		mes "你好，冒险者！";
		mes "请给我介绍一位有才华的冒险者！";
		mes "这关系到我的工作，非常非常重要……！";
		next;
		mes "^4d4dff有等级180以上的任务。^000000";
		close;
	}
	if (checkquest(7879,HUNTING) == 2) {
		mes "[Sally]";
		mes "我们收集到了足够的" + getmonsterinfo("POISONOUS", MOB_NAME) + "和" + getmonsterinfo("TOXIOUS", MOB_NAME) + "数据！";
		erasequest 7879;
		setquest 7880;
		getexp 27512240,19258560;
		next;
	}
	if (checkquest(7881,HUNTING) == 2) {
		mes "[Sally]";
		mes "我收集到了足够的" + getmonsterinfo("MINERAL_G", MOB_NAME) + "和" + getmonsterinfo("MINERAL_R", MOB_NAME) + "数据！";
		erasequest 7881;
		setquest 7882;
		getexp 27836640,19485600;
		next;
	}
	if (checkquest(7883,HUNTING) == 2) {
		mes "[Sally]";
		mes "关于" + getmonsterinfo("MINERAL_W", MOB_NAME) + "和" + getmonsterinfo("MINERAL_P", MOB_NAME) + "的数据如下。非常有帮助。";
		erasequest 7883;
		setquest 7884;
		getexp 27838400,19486880;
		next;
	}
	if (checkquest(7885,HUNTING) == 2) {
		mes "[Sally]";
	mes getmonsterinfo("ABYSSMAN", MOB_NAME) + "的数据总是令人惊叹。";
		erasequest 7885;
		setquest 7886;
		getexp 6938800,4857160;
		next;
	}
	if (checkquest(7887,HUNTING) == 2) {
		mes "[Sally]";
		mes "你成功获得了" + getmonsterinfo("JEWELIANT", MOB_NAME) + "和" + getmonsterinfo("PORCELLIO_W", MOB_NAME) + "的数据！";
		erasequest 7887;
		setquest 7888;
		getexp 13854240,9697960;
		next;
	}
	mes "[Sally]";
	mes "这可怜的学徒生活什么时候结束？";
	next;
	mes "[Sally]";
	mes "我急需一位有才华的冒险者帮忙。";
	mes "就像你一样！";
	mes "愿意帮助保住这名可怜实习研究员的工作吗？";
	next;
	switch( select( "新毒素研究", "特殊矿物研究1", "特殊矿物研究2", "深渊人研究", "矿虫研究", "为什么做这些？" ) ) {
	case 1:
		switch( checkquest(7880,PLAYTIME) ) {
		case -1:
			break;
		case 0:
		case 1:
			mes "[Sally]";
			mes "嗯，别勉强。";
			mes "机会总会来的。";
			close;
		case 2:
			erasequest 7880;
			break;
		}
		switch( checkquest(7879,HUNTING) ) {
		case -1:
			mes "[Sally]";
			mes "我需要研究艾因贝赫矿山地下城中新发现的毒气怪物数据。";
			mes "这里人手不足，很难对付占据矿山的怪物，所以需要兼顾两件事。";
			next;
			mes "[Sally]";
			mes "冒险者战斗时，我会收集^4d4dff" + getmonsterinfo("POISONOUS", MOB_NAME) + "和" + getmonsterinfo("TOXIOUS", MOB_NAME) + "^000000的数据。";
			mes "这不是很划算吗？";
			next;
			if (select( "接受请求", "拒绝" ) == 2) {
				mes "[Sally]";
				mes "没关系。";
				mes "世界很大，冒险者很多。";
				close;
			}
			mes "[Sally]";
			mes "请处理出现在^4d4dff艾因贝赫矿山地下城3楼^000000的^4d4dff" + getmonsterinfo("POISONOUS", MOB_NAME) + "和" + getmonsterinfo("TOXIOUS", MOB_NAME) + "^000000！";
			setquest 7879;
			close;
		case 0:
		case 1:
			mes "[Sally]";
	mes getmonsterinfo("POISONOUS", MOB_NAME) + "和" + getmonsterinfo("TOXIOUS", MOB_NAME) + "在艾因贝赫矿山地下城3楼。";
			mes "它们对我这样的普通人很难对付，所以我只能躲起来看你工作并收集数据。";
			close;
		case 2:
			end;
		}
		end;
	case 2:
		switch( checkquest(7882,PLAYTIME) ) {
		case -1:
			break;
		case 0:
		case 1:
			mes "[Sally]";
			mes "嗯，别勉强。";
			mes "机会总会来的。";
			close;
		case 2:
			erasequest 7882;
			break;
		}
		switch( checkquest(7881,HUNTING) ) {
		case -1:
			mes "[Sally]";
			mes "矿物有多种类型。这次要研究的是^4d4dff" + getmonsterinfo("MINERAL_G", MOB_NAME) + "和" + getmonsterinfo("MINERAL_R", MOB_NAME) + "^000000。";
			mes "控制数量的同时收集研究所需数据吧！";
			next;
			if (select( "接受请求", "拒绝" ) == 2) {
				mes "[Sally]";
				mes "没关系。";
				mes "世界很大，冒险者很多。";
				close;
			}
			mes "[Sally]";
			mes "请处理出现在^4d4dff艾因贝赫矿山地下城3楼^000000的^4d4dff" + getmonsterinfo("MINERAL_G", MOB_NAME) + "和" + getmonsterinfo("MINERAL_R", MOB_NAME) + "^000000！";
			setquest 7881;
			close;
		case 0:
		case 1:
			mes "[Sally]";
	mes getmonsterinfo("MINERAL_G", MOB_NAME) + "和" + getmonsterinfo("MINERAL_R", MOB_NAME) + "在艾因贝赫矿山地下城3楼。";
			mes "小心，它们很危险。";
			close;
		case 2:
			end;
		}
		end;
	case 3:
		switch( checkquest(7884,PLAYTIME) ) {
		case -1:
			break;
		case 0:
		case 1:
			mes "[Sally]";
			mes "嗯，别勉强。";
			mes "机会总会来的。";
			close;
		case 2:
			erasequest 7884;
			break;
		}
		switch( checkquest(7883,HUNTING) ) {
		case -1:
			mes "[Sally]";
			mes "矿物有多种类型。这次要研究的是^4d4dff" + getmonsterinfo("MINERAL_W", MOB_NAME) + "和" + getmonsterinfo("MINERAL_P", MOB_NAME) + "^000000。";
			mes "控制数量的同时收集研究所需数据吧！";
			next;
			if (select( "Received a request", "Rejected" ) == 2) {
				mes "[Sally]";
				mes "没关系。";
				mes "世界很大，冒险者很多。";
				close;
			}
			mes "[Sally]";
			mes "请处理出现在^4d4dff艾因贝赫矿山地下城3楼^000000的^4d4dff" + getmonsterinfo("MINERAL_W", MOB_NAME) + "和" + getmonsterinfo("MINERAL_P", MOB_NAME) + "^000000！";
			setquest 7883;
			close;
		case 0:
		case 1:
			mes "[Sally]";
	mes getmonsterinfo("MINERAL_W", MOB_NAME) + "和" + getmonsterinfo("MINERAL_P", MOB_NAME) + "在艾因贝赫矿山地下城3楼。";
			mes "小心，它们很危险。";
			close;
		case 2:
			end;
		}
		end;
	case 4:
		switch( checkquest(7886,PLAYTIME) ) {
		case -1:
			break;
		case 0:
		case 1:
			mes "[Sally]";
			mes "嗯，别勉强。";
			mes "机会总会来的。";
			close;
		case 2:
			erasequest 7886;
			break;
		}
		switch( checkquest(7885,HUNTING) ) {
		case -1:
			mes "[Sally]";
			mes "据说凝视深渊时，深渊也会吞噬你。";
			mes "我想，俗称" + getmonsterinfo("ABYSSMAN", MOB_NAME) + "的怪物也是如此。";
			mes "所以我们需要^4d4dff" + getmonsterinfo("ABYSSMAN", MOB_NAME) + "^000000的数据。";
			next;
			if (select( "Received a request", "Rejected" ) == 2) {
				mes "[Sally]";
				mes "没关系。";
				mes "世界很大，冒险者很多。";
				close;
			}
			mes "[Sally]";
			mes "请处理出现在^4d4dff艾因贝赫矿山地下城3楼^000000的^4d4dff" + getmonsterinfo("ABYSSMAN", MOB_NAME) + "^000000！";
			setquest 7885;
			close;
		case 0:
		case 1:
			mes "[Sally]";
	mes getmonsterinfo("ABYSSMAN", MOB_NAME) + "在艾因贝赫矿山地下城3楼。";
			mes "小心，它们很危险。";
			close;
		case 2:
			end;
		}
		end;
	case 5:
		switch( checkquest(7888,PLAYTIME) ) {
		case -1:
			break;
		case 0:
		case 1:
			mes "[Sally]";
			mes "嗯，别勉强。";
			mes "机会总会来的。";
			close;
		case 2:
			erasequest 7888;
			break;
		}
		switch( checkquest(7887,HUNTING) ) {
		case -1:
			mes "[Sally]";
			mes "专门的昆虫生活在地下城等黑暗地方。";
			mes "这次要收集的是^4d4dff" + getmonsterinfo("PORCELLIO_W", MOB_NAME) + "和" + getmonsterinfo("JEWELIANT", MOB_NAME) + "^000000的数据，也叫矿虫。";
			mes "和普通的波利西奥差别很大吗？";
			next;
			if (select( "Received a request", "Rejected" ) == 2) {
				mes "[Sally]";
				mes "没关系。";
				mes "世界很大，冒险者很多。";
				close;
			}
			mes "[Sally]";
			mes "请处理出现在^4d4dff艾因贝赫矿山地下城3楼^000000的^4d4dff" + getmonsterinfo("PORCELLIO_W", MOB_NAME) + "和" + getmonsterinfo("JEWELIANT", MOB_NAME) + "^000000！";
			setquest 7887;
			close;
		case 0:
		case 1:
			mes "[Sally]";
		mes getmonsterinfo("PORCELLIO_W", MOB_NAME) + "和" + getmonsterinfo("JEWELIANT", MOB_NAME) + "在艾因贝赫矿山地下城3楼。";
			mes "小心，它们很危险。";
			close;
		case 2:
			end;
		}
		end;
	case 6:
		mes "[Sally]";
		mes "嗯？这是全职工作！";
		mes "不久前我作为实习研究员加入雷根贝勒，这就是我被任命的工作。";
		mes "负责收集矿山怪物数据，我的考核取决于此。";
		next;
		mes "[Sally]";
		mes "总部一直抱怨，不知道该如何处理矿山怪物。";
		mes "收集数据的同时还能控制数量。这项考核是双赢，双赢！";
		close;
	}
	end;

OnInit:
	// completed
	questinfo( QTYPE_QUEST2, QMARK_YELLOW, "checkquest(7879,HUNTING) == 2" );
	questinfo( QTYPE_QUEST2, QMARK_YELLOW, "checkquest(7881,HUNTING) == 2" );
	questinfo( QTYPE_QUEST2, QMARK_YELLOW, "checkquest(7883,HUNTING) == 2" );
	questinfo( QTYPE_QUEST2, QMARK_YELLOW, "checkquest(7885,HUNTING) == 2" );
	questinfo( QTYPE_QUEST2, QMARK_YELLOW, "checkquest(7887,HUNTING) == 2" );

	// timeout
	questinfo( QTYPE_DAILYQUEST, QMARK_YELLOW, "checkquest(7880,PLAYTIME) == 2" );
	questinfo( QTYPE_DAILYQUEST, QMARK_YELLOW, "checkquest(7882,PLAYTIME) == 2" );
	questinfo( QTYPE_DAILYQUEST, QMARK_YELLOW, "checkquest(7884,PLAYTIME) == 2" );
	questinfo( QTYPE_DAILYQUEST, QMARK_YELLOW, "checkquest(7886,PLAYTIME) == 2" );
	questinfo( QTYPE_DAILYQUEST, QMARK_YELLOW, "checkquest(7888,PLAYTIME) == 2" );

	// not started
	questinfo( QTYPE_DAILYQUEST, QMARK_YELLOW, "BaseLevel >= 180 && isbegin_quest(7879) == 0 && checkquest(7880,PLAYTIME) == -1" );
	questinfo( QTYPE_DAILYQUEST, QMARK_YELLOW, "BaseLevel >= 180 && isbegin_quest(7881) == 0 && checkquest(7882,PLAYTIME) == -1" );
	questinfo( QTYPE_DAILYQUEST, QMARK_YELLOW, "BaseLevel >= 180 && isbegin_quest(7883) == 0 && checkquest(7884,PLAYTIME) == -1" );
	questinfo( QTYPE_DAILYQUEST, QMARK_YELLOW, "BaseLevel >= 180 && isbegin_quest(7885) == 0 && checkquest(7886,PLAYTIME) == -1" );
	questinfo( QTYPE_DAILYQUEST, QMARK_YELLOW, "BaseLevel >= 180 && isbegin_quest(7887) == 0 && checkquest(7888,PLAYTIME) == -1" );
	end;
}


// Sage - Starting Point
//----------------------------------------------------------------------------
mosk_fild02,198,252,3	script	Sage#rus01	4_M_SAGE_C,{
	if (!rhea_rus_main) {
		mes "[Sage]";
		mes "啊，外国人，你不是这里人吧？很高兴见到你！";
		next;
		mes "[Sage]";
		mes "我听说过许多来自你们国家的冒险者。不过他们总是很忙，我没怎么和他们交谈过。";
		next;
		if(select("抱歉，我很忙……:好，我们聊聊。") == 1) {
			mes "[Sage]";
			mes "啊，你……我只是想听听其他国家的消息……";
			next;
			mes "[Sage]";
			mes "抱歉打扰了。祝你旅途愉快。";
			close;
		}
		mes "[Sage]";
		mes "我听说你们的土地上生活着有趣的生物。能告诉我其中一种吗？";
		next;
		select("给他看波利卡片");
		mes "["+ strcharinfo(0) +"]";
		mes "这是生活在米德加尔特大陆上的一种魔物卡片。";
		next;
		if (!countitem(4001)) {
			mes "[Sage]";
			mes "...?!";
			mes "你在说什么？";
			next;
			mes "["+ strcharinfo(0) +"]";
			mes "我的意思是，这张卡……";
			mes "..................Ehhh?";
			next;
			mes "["+ strcharinfo(0) +"]";
			mes "啊……哈哈……在哪里？！等、等等……我好像有一张！";
			close;
		}
		mes "[Sage]";
		mes "哦，真的是……难以相信这是真的。谢谢你给我看。";
		next;
		mes "[Sage]";
		mes "顺便问一下，你喜欢这里吗？";
		next;
		mes "[Sage]";
		mes "冬天已经过去，夏天将至，天气很好。我知道冬天每年都会来，但总祈祷它不要再回来。";
		next;
		mes "[Sage]";
		mes "冬天过去后，夏日让森林变得茂密，空气也很温暖。我最喜欢的季节永远是夏天。";
		next;
		mes "[Sage]";
		mes "但别忘了仍要小心。许多冒险者在我们面前的森林里迷失了。";
		next;
		mes "["+ strcharinfo(0) +"]";
		mes "有冒险者回来吗？";
		next;
		mes "[Sage]";
		mes "只有一个人回来，告诉我道路分成三条的地方有一块神秘石头，会诅咒触碰它的人，所以我一直避开那里。";
		next;
		mes "[Sage]";
		mes "不过别担心我。我熟悉这里的路，也不怕魔物，哈哈。";
		rhea_rus_main = 1;
		// setquest 8136;
		close;
	}
	mes "[Sage]";
	mes "冬天已经过去，夏天将至，天气很好。我知道冬天每年都会来，但总祈祷它不要再回来。";
	next;
	mes "[Sage]";
	mes "冬天过去后，夏日让森林变得茂密，空气也很温暖。我最喜欢的季节永远是夏天。";
	next;
	mes "[Sage]";
	mes "但别忘了仍要小心。许多冒险者在我们面前的森林里迷失了。";
	next;
	mes "[Sage]";
	mes "只有一个人回来，告诉我道路分成三条的地方有一块神秘石头，会诅咒触碰它的人，所以我一直避开那里。";
	next;
	mes "[Sage]";
	mes "我？哈哈，别担心我。我熟悉这里的路，也不怕魔物，哈哈。";
	close;
}


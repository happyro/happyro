	if (mos_nowinter == 10) {
		if (mos_elder == 0) {
			next;
			select("你需要休息。 ");
			mes "[Lev]";
			if (rand(1,100) > 70) {
				mes "是的，在温暖的阳光下，我喜欢休息。";
				next;
				specialeffect2 EF_SUMMONSLAVE;
				mes "[Lev]";
				mes "希望这种暖和的天气永远持续。我讨厌寒冷的冬天。";
				mos_elder = 1;
				if (mos_kid == 1 && mos_middle == 1) {
					mos_nowinter = 11;
					changequest 18075,18076;
				}
				close;
			}
		mes "是的，在温暖的阳光下，我喜欢休息。";
			next;
			mes "[Lev]";
		mes "但我还活着！我不想听你说这种话。";
		}
	}
	close;
}

moscovia,196,71,3	script	A Young Man#mos14	4_M_RUSMAN2,{
	mes "[Fredek]";
	mes "这里的男人们在广阔海面经历狂涛后成长。";
	if (mos_nowinter == 10) {
		if (mos_middle == 0) {
			next;
			select("不过，如果冬天来了……");
			mes "[Fredek]";
			if (rand(1,100) > 70) {
				mes "是的，冬天海面会结冰，无法航行。";
				next;
				specialeffect2 EF_SUMMONSLAVE;
				mes "[Fredek]";
				mes "我希望冬天永远不要来。这是我的梦想。";
				mos_middle = 1;
				if (mos_kid == 1 && mos_elder == 1) {
					mos_nowinter = 11;
					changequest 18075,18076;
				}
				close;
			}
			mes "虽然我无法航行，但我的热情不会因冬天而冷却。";
			close;
		}
	}
	next;
	mes "[Fredek]";
	mes "你喜欢航海吗？";
	close;
}

moscovia,234,168,5	script	A Man#mos15	4_M_RUSBALD,{
	mes "[Gavrel]";
	mes "你不觉得城堡很宏伟吗？它是我的曾曾祖父建造的。";
	if (mos_nowinter == 10) {
		if (mos_elder == 0) {
			next;
			mes "[Gavrel]";

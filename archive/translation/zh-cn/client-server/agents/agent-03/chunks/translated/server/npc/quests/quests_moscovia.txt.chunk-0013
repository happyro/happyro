			next;
			select("冬天很冷吗？");
			mes "[Gavrel]";
			if (rand(1,100) > 70) {
				mes "是的，非常冷。如果不做准备，会很难熬。";
				next;
				specialeffect2 EF_SUMMONSLAVE;
				mes "[Gavrel]";

}

moscovia,228,80,3	script	A Little Boy#mos16	4_M_RUSCHILD,{
	if (mos_nowinter == 10) {
		if (mos_kid == 0) {
			select("你喜欢夏天吗？");
			mes "[Rurik]";
			if (rand(1,100) > 70) {
				mes "啊，往旁边挪一点。再多一点……好。啊，停在那里。";
				next;
				mes "[Rurik]";
				mes "我当然喜欢夏天。只要阳光别太强，它比寒冷的冬天好多了。";
				next;
				specialeffect2 EF_SUMMONSLAVE;
				mes "[Rurik]";
				mes "顺便问一下，这是做什么的？喜欢夏天很自然。你觉得冬天应该再来吗？";
				mos_kid = 1;
				if (mos_middle == 1 && mos_elder == 1) {
					mos_nowinter = 11;
					changequest 18075,18076;
				}
				close;
			}
			mes "当然，我喜欢夏天。你为什么突然问这种问题？";
			close;
		}
	}
	mes "[Rurik]";
	mes "抬头看你很困难。低一点，让我能看到你的眼睛。";
	next;
	mes "[Rurik]";
	mes "嗯，这样好多了。孩子是未来。如果我抬头看你时摔倒伤到脖子，就没有未来了。";
	close;
}


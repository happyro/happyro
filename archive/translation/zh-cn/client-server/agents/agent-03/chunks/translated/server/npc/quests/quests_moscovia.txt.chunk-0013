// Magic Bottle
//----------------------------------------------------------------------------
mosk_dun03,225,233,0	script	Pile of skeletons#Magic	HIDDEN_NPC,5,5,{
	if (mos_nowinter == 8) {
		mes "-There are ugly skulls";
			mes "这里到处都是，但只有这里能让我待着。";
		next;
		mes "-Get closer to see";
			mes "更仔细地查看。";
		close;
	}
	mes "-The ugly skulls are gathered.-";
	close;

OnTouch:
	if (mos_nowinter == 8) {
		mes "-She said that the Magic Gourd Bottle that";
			mes "能承载人们话语的东西就在附近。";
		next;
		mes "["+strcharinfo(0)+"]";
			mes "瓶子大概就藏在这里，但到处都是骨头。";
		next;
		mes "["+strcharinfo(0)+"]";
			mes "话说，我为什么在这里？要是龙回来了可就麻烦了……";
		next;
		while(1) {
			if(select("寻找它。:下次再试。") == 1) {
				if (BaseClass == Job_Thief) {
					mes "["+strcharinfo(0)+"]";
					mes "在这里。真容易找到。";
					mos_nowinter = 9;
					getitem 7761,1;
					changequest 18073,18074;
					close;
				}
				if (rand(1,20) > 14) {
					mes "["+strcharinfo(0)+"]";
					mes "啊，拿到了！我最好赶快离开这里。";
					mos_nowinter = 9;
					getitem 7761,1;// Magic_Gourd_Bottle
					changequest 18073,18074;
					close;
				}
				mes "............";
				next;
				mes "["+strcharinfo(0)+"]";
				mes "到底在哪里？！一定就在这里某处！";
				next;
			}
			mes "["+strcharinfo(0)+"]";
		mes "我稍后再试。";
			close;
		}
	}
}

// Shafka Hat :: mos_whale_edq
//============================================================
moscovia,211,93,3	script	Irina#edq	4_F_RUSCHILD,{
	if (!checkweight(1201,1)) {
		mes "等一下！！你携带的物品太多了，无法接收这个。减轻负重后再试。";
		close;
	}
	mes "[Irina]";
	mes "你好，外国旅行者！在莫斯科比亚过得愉快吗？";
	next;
	mes "[Irina]";
	mes "莫斯科比亚的特别纪念品……？";
	next;
	mes "[Irina]";
	mes "我们给你做一顶沙夫卡帽吧。沙夫卡既实用又漂亮！你想要一顶吗？";
	next;
	if(select("了解沙夫卡。:制作沙夫卡帽。") == 1) {
		mes "[Irina]";
		mes "看着你，我觉得你想在这种气温下戴一顶厚厚的毛皮帽。那就是沙夫卡！";
		next;
		mes "[Irina]";
		mes "如果你第一次来，可能不知道……莫斯科比亚的冬天以漫长寒冷闻名。";
		next;
		mes "[Irina]";
		mes "寒冷季节在这里生活尤其需要沙夫卡帽。没有这顶帽子，你可能熬不过冬天！";
		next;
		mes "[Irina]";
		mes "现在，漫长的冬天结束了，阳光明媚……但冬天总有一天会再来。所以要提前准备，随身备一顶沙夫卡帽。";
		next;
		mes "[Irina]";
		mes "戴着沙夫卡帽不用担心保暖。即使天气最冷……你在雪地里打滚，沙夫卡也能让你暖和！";
		close;
	}
	mes "[Irina]";
	mes "你想制作沙夫卡帽吗？嘿嘿，好主意！这是件好事，你会永远感激自己的。";
	next;
	mes "[Irina]";
	mes "带来材料后，我们马上就能制作！材料是：^0000FF九尾狐尾巴 20、毛线 10、柔软丝绸 10、海獭毛皮 20、线轴 1^000000。";
	if (isbegin_quest(18121) == 0)
		setquest 18121;
	next;
	if (countitem(1022) > 19 && countitem(7038) > 9 && countitem(7166) > 9 && countitem(7065) > 19 && countitem(7217)) {
		mes "[Irina]";
		mes "做得好。把材料给我，我来制作沙夫卡。";
		next;
		delitem 1022,20; //Fox_Tail
		delitem 7038,10; //Yarn
		delitem 7166,10; //Soft_Silk_Cloth
		delitem 7065,20; //Sea_Otter_Leather
		delitem 7217,1; //Spool
		getitem 5243,1; //Chullos
		completequest 18121;
		mes "[Irina]";
		mes "好了，做好了。怎么样？喜欢吗？";
		next;
		mes "[Irina]";
		mes "需要沙夫卡帽时，带着材料随时来找我，我会帮你制作。";
		next;
		mes "[Irina]";
		mes "好吗？好了……再见！~";
		close;
	}
	mes "[Irina]";
	mes "啊……你缺少一些材料。只有这些材料无法制作沙夫卡帽。";
	next;
	mes "[Irina]";
	mes "带来正确的材料后，我会马上制作沙夫卡。";
	next;
	mes "[Irina]";
	mes "材料是：^0000FF九尾狐尾巴 20、毛线 10、柔软丝绸 10、海獭毛皮 20、线轴 1^000000。";
	close;
}


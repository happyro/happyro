		mes "你已经处理好了吗？我也想参加！";
		npctalk "纽沃兹：你已经处理好了吗？我也想参加！";
		next;
		cutin "roel01",0;
		mes "[Roel]";
		mes "它们看起来很可爱，但很凶猛。";
		npctalk "罗埃尔：它们看起来很可爱，但很凶猛。", .@roel$;
		next;
		cutin "shaloshi01",2;
		mes "[Shaloshi]";
		mes "小朋友跟着我们。不可爱。";
		npctalk "莎洛希：小朋友跟着我们。不可爱。", .@shaloshi$;
		next;
		cutin "lunain01",0;
		mes "[Runane]";
		mes "它们是怪物，不是你的朋友。小心。";
		npctalk "鲁娜妮：它们是怪物，不是你的朋友。小心。", .@runane$;
		next;
		cutin "shaloshi01",2;
		mes "[Shaloshi]";
		mes "怪物……";
		npctalk "莎洛希：怪物……", .@shaloshi$;
		next;
		cutin "roel01",0;
		mes "[Roel]";
		mes "她可能失忆了吗？看来她不理解危险。";
		npctalk "罗埃尔：她可能失忆了吗？看来她不理解危险。", .@roel$;
		next;
		cutin "shaloshi01",2;
		mes "[Shaloshi]";
		mes "危险，不。";
		npctalk "莎洛希：危险，不。", .@shaloshi$;
		next;
		cutin "lunain02",0;
		mes "[Runane]";
		mes "我想她是。";
		npctalk "鲁娜妮：我想她是。", .@runane$;
		next;
		cutin "shaloshi01",2;
		mes "[Shaloshi]";
		mes "...";
		npctalk "莎洛希：……", .@shaloshi$;
	}
	if ('room == 10 && is_party_leader() == true)
		donpcevent 'jitterbug_main$ + "::OnNextIs11";
	close3;
}


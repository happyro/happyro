// Room 11
1@jtb,26,201,5	script	Runane#11	4_F_RUNAIN,{
	if ('room != 11 || is_party_leader() == false) {
		cutin "lunain04",0;
		mes "[Runane]";
		mes "阿朗，你为什么不喝？";
		close3;
	}
	if (select( "Talk.", "Hurry." ) == 2 && isbegin_quest(13183) == 2) {
		mes "赶紧想想，试着恢复记忆。";
		if ('room == 11 && 'additionnal_option && is_party_leader() == true)
			disablenpc instance_npcname("Roel#11");
	}
	else {
		.@roel$ = instance_npcname("Roel#11");
		.@aigu$ = instance_npcname("Aigu#11");
		.@arang$ = instance_npcname("Arang#11");
		.@mingmin$ = instance_npcname("Mingmin#11");

		cutin "lunain01",0;
		emotion ET_DELIGHT;
		mes "[Runane]";
		mes "推，推~";
		npctalk "鲁娜妮：推，推~";
		next;
		cutin "min01",0;
		emotion ET_DELIGHT, getnpcid(0,.@mingmin$);
		mes "[Mingmin]";
		mes "推，推~";
		npctalk "明明：推，推~", .@mingmin$;
		next;
		cutin "igu02",0;
		emotion ET_DELIGHT, getnpcid(0,.@aigu$);
		mes "[Aigu]";
		mes "还要扭肩膀多久~";
		npctalk "艾古：还要扭肩膀多久~", .@aigu$;
		next;
		cutin "lunain01",0;
		mes "[Runane]";
		mes "砰，砰，砰~";
		npctalk "鲁娜妮：砰，砰，砰~";
		next;
		cutin "min02",0;
		mes "[Mingmin]";
		mes "恰卡，恰卡~";
		npctalk "明明：恰卡，恰卡~", .@mingmin$;
		next;
		cutin "igu02",0;
		mes "[Aigu]";
		mes "砰，砰，砰，砰~";
		npctalk "艾古：砰，砰，砰，砰~", .@aigu$;
		next;
		cutin "lunain01",0;
		mes "[Runane]";
		mes "*Blow*";
		npctalk "鲁娜妮：*吹气*";
		next;
		cutin "arang01",2;
		mes "[Arang]";
		mes "呃，我不想喝这个！";
		npctalk "阿朗：呃，我不想喝这个！", .@arang$;
		next;
		cutin "min03",0;
		mes "[Mingmin]";
		mes "相信我，喝下去！";
		npctalk "明明：相信我，喝下去！", .@mingmin$;
		next;
		cutin "roel01",2;
		emotion ET_SURPRISE, getnpcid(0,.@roel$);
		mes "[Roel]";
		mes "你想给这孩子喂什么？绿色瓶子里是什么？……不……";
		npctalk "罗埃尔：你想给这孩子喂什么？绿色瓶子里是什么？……不……", .@roel$;
		next;
		cutin "min02",0;
		mes "[Mingmin]";
		mes "绿色药水";
		npctalk "明明：绿色药水", .@mingmin$;
		next;
		cutin "roel01",2;
		mes "[Roel]";
		mes "绿色药水好苦……嗯，你说绿色药水？";
		npctalk "罗埃尔：绿色药水好苦……嗯，你说绿色药水？", .@roel$;
		next;
		cutin "igu03",0;
		mes "[Aigu]";
		mes "绿色药水！";
		npctalk "艾古：绿色药水！", .@aigu$;
		next;
		cutin "roel01",2;
		mes "[Roel]";
		mes "绿色药水？";
		npctalk "罗埃尔：绿色药水？", .@roel$;
		next;
		cutin "lunain04",0;
		mes "[Runane]";
		mes "我说绿色药水！";
		npctalk "鲁娜妮：我说绿色药水！";
		next;
		cutin "roel01",2;
		mes "[Roel]";
		mes "但你在唱奇怪的歌，而且……绿色药水？";
		npctalk "罗埃尔：但你在唱奇怪的歌，而且……绿色药水？", .@roel$;
		next;
		cutin "igu03",0;
		mes "[Aigu]";
		mes "我有一瓶快过期的绿色药水，所以我们决定玩猜拳，给输家喝。";
		npctalk "艾古：我有一瓶快过期的绿色药水，所以我们决定玩猜拳，给输家喝。", .@aigu$;
		next;
		cutin "min02",0;
		mes "[Mingmin]";
		mes "没中毒时它什么也不会做。我们只是不想浪费好药水。";
		npctalk "明明：没中毒时它什么也不会做。我们只是不想浪费好药水。", .@mingmin$;
		next;
		cutin "arang01",0;
		mes "[Arang]";
		mes "但它太苦了。";
		npctalk "阿朗：但它太苦了。", .@arang$;
		next;
		cutin "lunain04",0;
		mes "[Runane]";
		mes "你还没喝吗？";
		npctalk "鲁娜妮：你还没喝吗？";
		next;
		cutin "igu02",0;
		mes "[Aigu]";
		mes "喝！喝！";
		npctalk "艾古：喝！喝！", .@aigu$;
		next;
		cutin "min01",0;
		mes "[Mingmin]";
		mes "喝！喝！";
		npctalk "明明：喝！喝！", .@mingmin$;
		next;
		cutin "arang02",2;
		mes "[Arang]";
		mes "罗埃尔，你不能替你妹妹喝吗？";
		npctalk "阿朗：罗埃尔，你不能替你妹妹喝吗？", .@arang$;
		next;
		cutin "roel01",2;
		mes "[Roel]";
		mes "我去寻找可能的威胁。";
		npctalk "罗埃尔：我去寻找可能的威胁。", .@roel$;
		disablenpc instance_npcname("Roel#11");
	}
	if ('room == 11 && is_party_leader() == true)
		donpcevent 'jitterbug_main$ + "::OnNextIs12";
	close3;
}


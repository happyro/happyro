// Room 12
1@jtb,106,198,5	script	Mingmin#12	4_F_GENETIC,{
	if (is_party_leader() == false) {
		mes "[Mingmin]";
		mes "有学者证明波利卡片的掉率是……百分之多少。";
		close;
	}
	if ('room != 12) {
		cutin "min02",0;
		mes "[Mingmin]";
		mes "幸好蘑菇没有毒。";
		close3;
	}
	if (select( "Talk.", "Hurry." ) == 2 && isbegin_quest(13183) == 2)
		mes "赶紧想想，试着恢复记忆。";
	else {
		cutin "min02",0;
		mes "[Mingmin]";
		mes "内部看起来像森林，后来又变成洞穴。真奇怪。";
		npctalk "明明：内部看起来像森林，后来又变成洞穴。真奇怪。";
		next;
		mes "[Mingmin]";
		mes "奇怪的植物长在更奇怪的地形上。一切都不合常理。";
		npctalk "明明：奇怪的植物长在更奇怪的地形上。一切都不合常理。";
		next;
		mes "[Mingmin]";
		mes "我采了几朵蘑菇尝尝。";
		npctalk "明明：我采了几朵蘑菇尝尝。";
		next;
		cutin "min01",0;
		mes "[Mingmin]";
		mes "这蘑菇有毒，但不会危及生命。要尝一口吗？";
		npctalk "明明：这蘑菇有毒，但不会危及生命。要尝一口吗？";
		next;
		if (select( "Decline.", "Have a bite." ) == 1) {
			cutin "min03",0;
			mes "[Mingmin]";
			mes "我不接受拒绝！";
			npctalk "明明：我不接受拒绝！";
			next;
			mes "- Mingmin shoves a mushroom into your mouth. -";
			next;
			cutin "min02",0;
			mes "[Mingmin]";
			mes "嗯？";
			npctalk "明明：嗯？";
			next;
			mes "[Mingmin]";
			mes "你没有反应。也许蘑菇其实没毒。也许我该尝一朵……";
			npctalk "明明：你没有反应。也许蘑菇其实没毒。也许我该尝一朵……";
			next;
			mes "[Mingmin]";
			mes "嗯……";
			npctalk "明明：嗯……";
			next;
			mes "[Mingmin]";
			mes "几乎没有味道。";
			npctalk "明明：几乎没有味道。";
			next;
			mes "[Mingmin]";
			mes "啧，真是浪费时间。你先走吧。我还想看看另一件事。";
			npctalk "明明：啧，真是浪费时间。你先走吧。我还想看看另一件事。";
		}
		else {
			mes "[Mingmin]";
			mes "你比我想象中勇敢。";
			npctalk "明明：你比我想象中勇敢。";
			next;
			mes "- You feel good, possibly a side effect of eating the mushroom. -";
			next;
			mes "[Mingmin]";
			mes "我应该尝一朵。";
			npctalk "明明：我应该尝一朵。";
			next;
			mes "[Mingmin]";
			mes "嗯……";
			npctalk "明明：嗯……";
			next;
			mes "[Mingmin]";
			mes "几乎没有味道。";
			npctalk "明明：几乎没有味道。";
			next;
			mes "[Mingmin]";
			mes "啧，真是浪费时间。你先走吧。我还想看看另一件事。";
			npctalk "明明：啧，真是浪费时间。你先走吧。我还想看看另一件事。";
		}
	}
	if ('room == 12 && is_party_leader() == true)
		donpcevent 'jitterbug_main$ + "::OnNextIs13";
	close3;
}

// Room 13
1@jtb,195,206,4	script	Newoz#13	4_M_NEWOZ,{
	if (is_party_leader() == false) {
		cutin "nines01",2;
		mes "[Newoz]";
		mes "我突然想吃肉。早知道就带一整盒了！";
		close3;
	}
	if ('room != 13) {
		cutin "nines01",2;
		mes "[Newoz]";
		mes "你说得太复杂了，其实直接说‘互相给予’就好。";
		close3;
	}
	if (select( "Talk.", "Hurry." ) == 2 && isbegin_quest(13183) == 2) {
		mes "赶紧想想，试着恢复记忆。";
		if ('room == 13 && is_party_leader() == true)
			donpcevent 'jitterbug_main$ + "::OnNextIs14";
		close3;
	}
	.@melody$ = instance_npcname("Melody-Jack#13");
	cutin "nines04",2;
	mes "[Newoz]";
	mes "嗯，我怎么又把其他人弄丢了？";
	npctalk "纽沃兹：嗯，我怎么又把其他人弄丢了？";
	next;
	cutin "",255;
	emotion ET_THINK, getnpcid(0,.@melody$);
	mes "[Melody-Jack]";
	mes "纽沃兹。";
	npctalk "旋律杰克：纽沃兹。", .@melody$;
	next;
	cutin "nines01",2;
	mes "[Newoz]";
	mes "哇！天啊！";
	npctalk "纽沃兹：哇！天啊！";
	next;
	cutin "",255;
	emotion ET_THINK, getnpcid(0,.@melody$);
	mes "[Melody-Jack]";
	mes "我还以为你已经习惯我隐身在身边了。";
	npctalk "旋律杰克：我还以为你已经习惯我隐身在身边了。", .@melody$;
	next;
	cutin "nines01",2;
	mes "[Newoz]";
	mes "我们还处于危险中吗？";
	npctalk "纽沃兹：我们还处于危险中吗？";
	next;
	cutin "",255;
	emotion ET_THINK, getnpcid(0,.@melody$);
	mes "[Melody-Jack]";
	mes "应该吧。顺便说，我们一直在同一个地方绕圈。";
	npctalk "旋律杰克：应该吧。顺便说，我们一直在同一个地方绕圈。", .@melody$;
	next;
	cutin "nines04",2;
	mes "[Newoz]";
	mes "所以我说这里像迷宫是对的。呃，我又饿了。";
	npctalk "纽沃兹：所以我说这里像迷宫是对的。呃，我又饿了。";
	next;
	cutin "",255;
	emotion ET_THINK, getnpcid(0,.@melody$);
	mes "[Melody-Jack]";
	mes "我一直等你，因为想和你谈谈。";
	npctalk "旋律杰克：我一直等你，因为想和你谈谈。", .@melody$;
	next;
	mes "[Melody-Jack]";
	mes "纽沃兹，你回到公会时合同已经到期了。";
	npctalk "旋律杰克：纽沃兹，你回到公会时合同已经到期了。", .@melody$;
	next;
	cutin "nines01",2;
	mes "[Newoz]";
	mes "哦，对了。既然我不再是主人，合同自然到期了。";
	npctalk "纽沃兹：哦，对了。既然我不再是主人，合同自然到期了。";
	next;
	cutin "",255;
	emotion ET_THINK, getnpcid(0,.@melody$);
	mes "[Melody-Jack]";
	mes "但鉴于现在的情况，我对你的承诺仍然有效。";
	npctalk "旋律杰克：但鉴于现在的情况，我对你的承诺仍然有效。", .@melody$;
	next;
	cutin "nines01",2;
	mes "[Newoz]";
	mes "谢谢。我很高兴备用计划仍然有效。";
	npctalk "纽沃兹：谢谢。我很高兴备用计划仍然有效。";
	next;
	cutin "",255;
	emotion ET_THINK, getnpcid(0,.@melody$);
	mes "[Melody-Jack]";
	mes "哼，我遵守承诺只是因为你拥有我想要的东西。";
	npctalk "旋律杰克：哼，我遵守承诺只是因为你拥有我想要的东西。", .@melody$;
	next;
	cutin "nines02",2;
	mes "[Newoz]";
	mes "哦，你是说这把尤克里里？";
	npctalk "纽沃兹：哦，你是说这把尤克里里？";
	next;
	cutin "",255;
	emotion ET_MERONG, getnpcid(0,.@melody$);
	mes "[Melody-Jack]";
	mes "你这个笨蛋，那一文不值。你的合同虽已到期，但承诺就是承诺，我会遵守。";
	npctalk "旋律杰克：你这个笨蛋，那一文不值。你的合同虽已到期，但承诺就是承诺，我会遵守。", .@melody$;
	next;
	cutin "nines01",2;
	mes "[Newoz]";
	mes "谢谢。";
	npctalk "纽沃兹：谢谢。";
	close2;
	cutin "",255;
	if ('room == 13 && is_party_leader() == true)
		donpcevent 'jitterbug_main$ + "::OnNextIs14";
	end;
}

1@jtb,191,206,5	script	Melody-Jack#13	CLEAR_NPC,{
	mes "[Melody-Jack]";
	mes "请别和我说话——我躲在这里是有原因的。";
	close;
}


// Room 14 (menu affects the boss encounter in the next room)
1@jtb,282,194,5	script	Newoz#14	4_M_NEWOZ,{
	if ('room != 14 || is_party_leader() == false) {
		cutin "nines01",0;
		mes "[Newoz]";
		mes "这里可能还有其他人。";
		close3;
	}
	if (select( "Talk.", "Hurry." ) == 2 && isbegin_quest(13183) == 2) {
		mes "赶紧想想，试着恢复记忆。";
		if ('room == 14 && is_party_leader() == true) {
			donpcevent 'jitterbug_main$ + "::OnNextIs15";
			if (jitterbug_options & 2)
				areamonster 'map_jtb$,358,212,388,182, "--ja--", 3108,1;	// no label
		}
		close3;
	}
	.@lagi$ = instance_npcname("Lagi#14");
	.@aigu$ = instance_npcname("Aigu#14");
	.@shaloshi$ = instance_npcname("Shaloshi#14");
	.@mingmin$ = instance_npcname("Mingmin#14");
	.@roel$ = instance_npcname("Roel#14");

	cutin "shaloshi01",0;
	mes "[Shaloshi]";
	mes "我想起了一些事情。";
	npctalk "莎洛希：我想起了一些事情。", .@shaloshi$;
	next;
	cutin "igu04",2;
	mes "[Aigu]";
	mes "真的吗？";
	npctalk "艾古：真的吗？", .@aigu$;
	next;
	cutin "ragi03",2;
	emotion ET_DELIGHT, getnpcid(0,.@lagi$);
	mes "[Lagi]";
	mes "她说她想起来了。";
	npctalk "拉吉：她说她想起来了。", .@lagi$;
	next;
	cutin "nines03",0;

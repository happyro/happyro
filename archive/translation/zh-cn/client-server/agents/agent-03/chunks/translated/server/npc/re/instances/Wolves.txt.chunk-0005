1@nyr,68,163,5	script	Miriam#dms801	EP18_NPC_MIRIAM,{
	if (is_party_leader() == false) {
		npctalk "队长还没到吗？";
		end;
	}
	if ('nyr_main_step == 18) {
		mes "[Crowd]";
		mes "承认我们的存在！";
		next;
		mes "[Crowd]";
		mes "我们还活着！我们在这里！！";
		next;
		mes "[Crowd]";
		mes "这是我们的土地！";
		next;
		mes "[Crowd]";
		mes "把土地归还给合法主人！";
		next;
		mes "[Temple Guard]";
		mes "如果你们现在解散，我们不会追究擅闯神殿的责任！";
		next;
		mes "[Temple Guard]";
		mes "我给你们整整30分钟！在时限内回去！";
		next;
		mes "[Crowd]";
		mes "你现在是在威胁我们吗？";
		next;
		mes "[Crowd]";
		mes "你们想做什么？";
		next;
		mes "[Crowd]";
		mes "你们要逮捕所有人并关进监狱，对吧？";
		next;
		mes "[Crowd]";
		mes "事到如今，我们先进去吧！！！";
		next;
		cutin "ep18_miriam_03.png",1;
		mes "[Miriam]";
		mes "不对劲。人们变得太激进了。";
		next;
		mes "[Miriam]";
		mes "情况不妙。我需要找苏阿德，但副手在哪里？";
		npctalk "谁去找苏阿德，情况紧急！", instance_npcname("Miriam#dms801");
		next;
		enablenpc instance_npcname("Niren#dms201");
		enablenpc instance_npcname("Zhed#dms101");
		cutin "ra_gwoman.bmp",2;
		mes "[Niren]";
		mes "你在这里。我带来了泽德祭司。";
		next;
		cutin "ra_gman2.bmp",2;
		mes "[Zhed]";
		mes "这里发生了什么？和聚集在此的人们有关吗？还是神殿内部有什么东西导致了这一切……";
		next;
		if ('nyr_main_step == 18) {
			'nyr_main_step = 19;
			disablenpc instance_npcname("#mstep09");
			disablenpc instance_npcname("#mstep10");
			disablenpc instance_npcname("#mstep11");
			disablenpc instance_npcname("#dmswch02");
			enablenpc instance_npcname("Suad#dms102");
			npctalk "怎么回事？你说你急着找到了它？", instance_npcname("Suad#dms102");
		}
		cutin "ep18_suad_04.png",0;
		mes "[Suad]";
		mes "怎么回事？你说情况紧急。";
		npctalk "怎么回事？你说情况紧急。", instance_npcname("Suad#dms102");
		close3;
	}
	if ('nyr_main_step == 21) {
		'nyr_main_step = 22;
		enablenpc instance_npcname("#dmwrp02");
		navigateto("1@nyr",45,28);
		npctalk "冒险者，请务必安全。", instance_npcname("Miriam#dms801");
		cutin "ep18_miriam_03.png",2;
		mes "[Miriam]";
		mes "处理好后快点行动。他们在安全屋等你。";
		disablenpc instance_npcname("Miriam#dms801");
		close3;
	}
	end;

OnMove1:
	unitwalk getnpcid(0),90,153, instance_npcname("Miriam#dms801") + "::OnMove2";
	end;
OnMove2:
	unitwalk getnpcid(0),107,165, instance_npcname("Miriam#dms801") + "::OnMove3";
	end;
OnMove3:
	unitwalk getnpcid(0),128,165, instance_npcname("Miriam#dms801") + "::OnMove4";
	end;
OnMove4:
	'nyr_main_step = 18;
	end;
}



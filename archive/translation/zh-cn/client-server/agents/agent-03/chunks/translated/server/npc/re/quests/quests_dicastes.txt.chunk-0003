}

dic_in01,263,193,3	script	Diel Guard#ep133_20	450,{
	if (!isequipped(2782)) {
		mes "[Diel Guard]";
		mes "∈∬⊆ ⊇ ￢⊃∬?";
		mes "∃⊆⊂ ∏ ⊇∀∧ ⊂ ∠∋∩С...";
		mes "∝∪∮ ∈ ∫∋∪ ∋..!";
		next;
		mes "无法与他交流。";
		close;
	}
	if (ep13_3_secret < 13) {
		mes "[Diel Guard]";
		mes "请停下。";
		mes "不能再往前了。";
		close;
	}
	else if ((ep13_3_secret > 11) && (ep13_3_secret < 19)) {
		mes "[Diel Guard]";
		mes "你是来见阿哈特的吗？";
		mes "你在名单上。";
		close2;
		warp "dic_in01",299,251;
		end;
	}
	else if (ep13_3_secret > 18) {
		if (ep13_3_ahtdayq == 1) {
			mes "[Diel Guard]";
			mes "你刚完成阿哈特的差事回来？";
			mes "他在里面等你。";
			mes "请进去。";
		}
		else if (countitem(6304) > 0) {
			mes "[Diel Guard]";
			mes "你是来见阿哈特的吗？";
			mes "你在名单上。";
			mes "请进去。";
			delitem 6304,1; //Sapa_Feat_Cert
		}
		else {
			mes "[Diel Guard]";
			mes "需要 1 张漏洞认证才能见阿哈特。";
			mes "至少这是给你的特殊待遇。";
			close;
		}
		close2;
		warp "dic_in01",299,251;
		end;
	}
	mes "[Diel Guard]";
	mes "这里是限制区域。";
	mes "需要许可才能继续前进。";
	close;
}

dic_in01,299,268,0	script	#ep133_event01	139,4,4,{
	end;
OnTouch:
	if (ep13_3_secret == 13) {
		mes "你一进入房间，就有人";
		mes "按下你的头，强迫你鞠躬。";
		soundeffect "wander_man_move.wav",0;
		sc_start SC_Blind,60000,0;
		next;
		mes "[Ringing Voice]";
		mes "好了，柴郡。";
		mes "你是来见我的吗？";
		next;
		mes "[Ringing Voice]";
		mes "抬起头，靠近一些。";
		mes "交谈应该保持眼神接触。";
		next;
		cutin (Sex == SEX_MALE?"ep13_ahat_f":"ep13_ahat_m"),1;
		mes "听到阿哈特的声音，你抬起头，";
		mes "却看到面前站着一个穿着高级萨帕服饰的人类。";
		sc_end SC_Blind;
		emotion ET_HUK, playerattached();
		set ep13_3_secret, 14;
		erasequest 7198;
		close2;
		cutin "",255;
	}
	end;
}

dic_in01,294,276,5	script	Secret Adjutant#ep133_2	498,{
	// if ((GetInventoryRemainCount 1301 3 == 2) || (GetInventoryRemainCount 1301 3 == 3)) {
	if ((MaxWeight - Weight) < 1000) {
		mes "- You can too many items to proceed with the quest. -";
		close;
	}
	cutin "ep13_cheshire_h",0;
	if (ep13_3_secret < 16) {
		mes "[Cheshire]";
		mes "........";
		mes "........Humph.";
		close2;
	}
	else if (ep13_3_secret == 16) {
		mes "- Cheshire stands quietly next to Ahat with his head and face covered with a bandana.";
		mes "你瞥见柴郡臀部后方闪过一条尾巴。 -";
		next;
		select("尾巴？");
		mes "[Cheshire]";
		mes "你在看什么？！";
		mes "你说的是什么尾巴。";
		next;
		select("你去过三角地带附近吗？");
		mes "[Cheshire]";
		mes ".. Hey, what are you talking about?";
		mes "你想说什么？";
		next;
		cutin (Sex == SEX_MALE?"ep13_ahat_f":"ep13_ahat_m"),2;
		mes "[Ahat]";
		mes "" + strcharinfo(0) + "....";
		mes "你只需服从柴郡的命令。";
		mes "别问愚蠢的问题。这是命令。";
		mes "柴郡，继续。";
		next;
		cutin "ep13_cheshire_h",0;
		mes "[Cheshire]";
		mes "嗯……你需要做的是这个。";
		mes "城市南边有一道巨大裂隙。";
		mes "裂隙附近发生了许多……";
		mes "事故。";
		next;
		mes "[Cheshire]";
		mes "我需要你去清除所有痕迹。";
		mes "你会找到^4d4dff凝固血迹、魔法残留和皮肤碎片^000000。";
		next;
		mes "[Cheshire]";
		mes "别让任何人发现，清除它们。";
		mes "把它们带到这里，不要随便丢弃。";
		mes "每种至少带回 10 个。";
		set ep13_3_secret, 17;
		setquest 7199;
		next;
		mes "[Cheshire]";
		mes "不能被任何人发现。";
		mes "不能告诉萨帕族。";
		mes "务必绝对保密！";
		close2;
	}
	else if (ep13_3_secret == 17) {
		if (countitem(6306) > 9 && countitem(6305) > 9 && countitem(6307) > 9) {
			mes "[Cheshire]";
			mes "……你……";
			mes "很有用，对吧？";
			mes "今天就到这里。";
			mes "我们要一点一点地工作，避免引起注意。";
			delitem 6306,10; //Solid_Bloodstain
			delitem 6305,10; //Frozen_Skin_Piece
			delitem 6307,10; //Suspicious_Magic_Stone
			set ep13_3_secret, 18;
			erasequest 7199;
			setquest 7200;
			set ep13_3_ahtdayq, 2;
			close2;
		}
		else {
			mes "[Cheshire]";
			mes "清除裂隙附近的各种痕迹。";
			mes "你的任务是收集并带回凝固血迹、魔法残留和皮肤碎片。";
			next;
			mes "[Cheshire]";
			mes "这不是一天能完成的，请每种至少带回 10 个。";
			mes "明白了吗？";
			close2;
		}
	}
	else if (ep13_3_secret == 18) {
		mes "[Cheshire]";
		mes "和我的工作完成了。";
		mes "你有东西要交给阿哈特吗？";
		close2;
	}
	else {
		if (ep13_3_ahtdayq == 1) {
			if ((countitem(6306) > 9) && (countitem(6305) > 9) && (countitem(6307) > 9)) {
				mes "[Cheshire]";
				mes "好，确认完毕。";
				mes "很好。";
				mes "你是使用漏洞认证来到这里的，对吧？";
				mes "我把它还给你。";
				next;
				mes "[Cheshire]";
				mes "明天再继续。";
				mes "阿哈特似乎非常信任你。";
				mes "让我们尽力而为。";
				delitem 6306,10; //Solid_Bloodstain
				delitem 6305,10; //Frozen_Skin_Piece
				delitem 6307,10; //Suspicious_Magic_Stone
				set ep13_3_ahtdayq, 2;
				getitem 6304,1; //Sapa_Feat_Cert
				getexp 70000,0;
				getexp 0,30000;
				erasequest 7201;
				setquest 7200;
				close2;
			}
			else {
				mes "[Cheshire]";
				mes "和往常一样，去收集这里北边裂隙附近的痕迹。";
				mes "凝固血迹、冰冻皮肤碎片、奇异魔法石……";
				mes "每种 10 个。";
				close2;
			}
		}
		else if (ep13_3_ahtdayq == 2) {
			if (checkquest(7200,PLAYTIME) == 0 || checkquest(7200,PLAYTIME) == 1) {
				mes "[Cheshire]";
				mes "还不行。";
				mes "我们必须仔细计划裂隙附近的清理工作。";
				mes "稍后再来。";
				close2;
			}
			else if (checkquest(7200,PLAYTIME) == 2) {
				mes "[Cheshire]";
				mes "今天继续工作。";
				mes "凝固血迹、冰冻皮肤碎片、奇异魔法石……";
				mes "悄悄把它们带回来。";
				next;
				mes "[Cheshire]";
				mes "和往常一样每种收集 10 个。";
				mes "明白了吗？";
				set ep13_3_ahtdayq, 1;
				if (checkquest(7200,PLAYTIME) >= 0) erasequest 7200;
				setquest 7201;
				next;
				mes "你收到了柴郡关于清理裂隙区域的委托。";
				mes "阿哈特和柴郡仍然毫无线索。";
				close2;
			}
			else {
				mes "不能发生这种事。案例 4";
				mes "请求 GM 协助。";
				close2;
			}
		}
		else {
			mes "不能发生这种事。案例 5";

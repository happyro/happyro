dic_in01,138,225,3	script	Diel Guard#ep133_19	492,{
	if (!isequipped(2782)) {
		mes "[Diel Guard]";
		mes "∈∬⊆ ⊇ ￢⊃∬?";
		mes "∃⊆⊂ ∏ ⊇∀∧ ⊂ ∠∋∩С...";
		mes "∝∪∮ ∈ ∫∋∪ ∋..!";
		next;
		mes "无法与他交流。";
		close;
	}
	if (ep13_3_secret < 13) {
		mes "[Diel Guard]";
		mes "不能再往前了。";
		mes "这里是最高大臣的办公室。";
		mes "只有获准者才能进入。";
		mes "请回去。";
		close;
	}
	else if (ep13_3_secret == 13) {
		mes "[Diel Guard]";
		mes "请停下。";
		mes "只有获准者才能进入。";
		next;
		if (select("我有许可。:回去。") == 1) {
			mes "[Diel Guard]";
			mes "等等……";
			mes strcharinfo(0) + "......ah... I see your name on the list.";
			mes "抱歉。";
			mes "请通过。";
			close2;
			warp "dic_in01",241,177;
			end;
		}
		mes "[Diel Guard]";
		mes "唉……";
		mes "请理解。";
		mes "有很多人试图见大臣。";
		mes "所以安保很严格。";
		close;
	}
	else if (ep13_3_secret > 13) {
		mes "[Diel Guard]";
		mes "啊，你是" + strcharinfo(0) + "……";
		mes "我收到阿哈特的命令，随时让你通过。";
		mes "请上去吧。";
		close2;
		warp "dic_in01",241,177;
		end;
	}
	mes "[Diel Guard]";
	mes "不能再往前了。";
	mes "这里是最高大臣的办公室。";
	mes "只有获准者才能进入。";
	mes "请回去。";
	close;
}


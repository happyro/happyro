			mes "[Papyrus]";
			mes "我们许多研究员正通过古代遗物研究生与死，以及宇宙的诞生与消亡。";
			next;
			mes "[Papyrus]";
			mes "如果你找到并带来未知遗物，每带来一件^9900993未知遗物^000000，便可换取一张^9900991萨帕认证^000000。";
			next;
			mes "[Papyrus]";
			mes "带来^99009930件遗物^000000，我就换给你^99009911张萨帕认证^000000。";
			break;
	}
	close;
}

// Document Packages
//============================================================
-	script	Document Package#main	-1,{
	function	eldicastes_dp;
	if (isequipped(2782) < 1) {
		mes "你看不懂上面的文字。";
		close;
	}
	if (BaseLevel < 80) {
		mes "这份文档档案对经验丰富的冒险者似乎没有价值。";
		close;
	}
	if (ep13_3_invite < 6) {
		mes "你试图打开阅读文档时，一名萨帕管理者示意要叫加尔腾守卫。我们快离开吧。";
		close;
	}
	if (checkquest(12165,PLAYTIME) == 2) {
		mes "感觉好些了。";
		erasequest 12165;
		close;
	}
	else if (checkquest(12165,PLAYTIME) != -1) {
		mes "呃……光盯着文档就头晕。冷静下来后再回来。";
		close;
	}
	specialeffect2 EF_DISPELL;
	progressbar "ffff00",4;
	set .@doc,rand(1,70);
	if (.@doc > 50 && .@doc <= 60) {
		mes "没有文档看起来异常。";
		close;
	} else if (.@doc > 60 && .@doc <= 70) {
		mes "你突然感到恶心，似乎一时半会儿不会好转。找文档只能等以后了。";
		setquest 12165;
		close; 
	}
	else if (.@doc == 1) eldicastes_dp(12209,"Horn","某些昆虫坚硬的楔形角。实用价值不高。","");
	else if (.@doc == 2) eldicastes_dp(12195,"Horrendous Mouth","尸体上的牙齿。","研究死亡时间和健康状况的重要材料，有助于了解人类生态。");
	else if (.@doc == 3) eldicastes_dp(12186,"Orc's Fangs","生活在森林中的绿皮怪物。外形似人，但对人类极具敌意。","据说两族过去曾有友好关系。");
	else if (.@doc == 4) eldicastes_dp(12172,"Frog Eggs","生活在温暖地区的两栖动物的卵。不知道这种卵能否在马努克的寒冷地区孵化。","");
	else if (.@doc == 5) eldicastes_dp(12208,"Snail's Shells","保护巨大蜗牛身体的坚硬甲壳。出于好奇，研究这种生物很有趣。","");
	else if (.@doc == 6) eldicastes_dp(12188,"Powder of Butterfly","来自米德加尔特翼虫的粉末。一些人类用它化妆或制药。","");
	else if (.@doc == 7) eldicastes_dp(12167,"Reptile Tongue","生活在米德加尔特沙漠地带的怪物舌头。晒干后常用作药材。","");
	else if (.@doc == 8) eldicastes_dp(12168,"Scorpion Tail","生活在沙漠中的生物的有毒尾巴。","记录显示人类遭到攻击时可能丧命。");
	else if (.@doc == 9) eldicastes_dp(12173,"Jellopy","马努克地区的未知物质，但在米德加尔特各处都能找到。","需要研究它作为建筑材料的可能性。");
	else if (.@doc == 10) eldicastes_dp(12166,"Tree Root","人类用它当柴火或建筑材料。在米德加尔特森林中很常见。","");
	else if (.@doc == 11) eldicastes_dp(12169,"Stem","马努克没有类似米德加尔特植物的东西。","这些植物可用于食物和药物，有些甚至有毒。");
	else if (.@doc == 12) eldicastes_dp(12170,"Pointed Scale","来自凹凸生物的茎。用途未知，需要研究。","");
	else if (.@doc == 13) eldicastes_dp(12171,"Resin","收集并凝固的古树树液。在人类世界非常珍贵。","");
	else if (.@doc == 14) eldicastes_dp(12174,"Fish Tail","人类食用一种叫鱼的肉。","可以作为访问城市的外国冒险者的重要食物来源。");
	else if (.@doc == 15) eldicastes_dp(12175,"Worm Peeling","据说有些虫皮很有价值。","但这是根据人类的价值标准判断的，需要研究。");
	else if (.@doc == 16) eldicastes_dp(12176,"Gill","米德加尔特有生活在海中、用鳃呼吸的生物。","进一步研究它们的生态会很有用。");
	else if (.@doc == 17) eldicastes_dp(12177,"Tooth of Bat","马努克未知夜行生物的痕迹。从牙齿大小来看并不强壮。","");
	else if (.@doc == 18) eldicastes_dp(12178,"Fluff","许多米德加尔特生物身上覆盖着柔软的毛。","毛发可用于御寒，需要进一步研究。");
	else if (.@doc == 19) eldicastes_dp(12179,"Chrysalis","装有未知物的活体大型昆虫囊。","完全不活动，但其中的生命结构很独特，值得研究。");
	else if (.@doc == 20) eldicastes_dp(12180,"Feather of Birds","米德加尔特各处都能找到的鸟羽。","保暖效果不佳，但可用作装饰品或书写工具。");
	else if (.@doc == 21) eldicastes_dp(12181,"Talon","适合打孔或制作简单饰品的尖爪。","与马努克大型生物的爪子一起使用非常有用。");
	else if (.@doc == 22) eldicastes_dp(12182,"Sticky Webfoot","米德加尔特两栖动物身上发现的奇特结构。进化成更适应海洋生活的形态。","");
	else if (.@doc == 23) eldicastes_dp(12183,"Animal Skin","哺乳动物的皮革。","非常温暖柔软，可有多种用途。在米德加尔特加工后很有价值。");
	else if (.@doc == 24) eldicastes_dp(12184,"Wolf Claw","名为狼的生物的爪子。","用途未知，但许多好奇的萨帕族对此很感兴趣。");
	else if (.@doc == 25) eldicastes_dp(12185,"Mushroom Spore","米德加尔特各处都能找到的蘑菇孢子。","稍加研究似乎就能在这里培育。");
	else if (.@doc == 26) eldicastes_dp(12187,"Evil Horn","由出现在非神圣地区的邪恶之角制成的物品。","售价很高，但似乎不实用。");
	else if (.@doc == 27) eldicastes_dp(12214,"Cactus Needle","几乎没有水分也能在沙漠中生存的植物表面。","");
	else if (.@doc == 28) eldicastes_dp(12189,"Bill of Birds","适合打孔或制作简单饰品的尖喙，看起来像鸟爪。","");
	else if (.@doc == 29) eldicastes_dp(12190,"Snake Scale","没有腿却能移动的爬行动物的鳞片。","生物会蜕下鳞片，可用于简单工艺品制作。");
	else if (.@doc == 30) eldicastes_dp(12191,"Insect Feeler","神经敏锐的昆虫触角。","其结构与马努克生物不同，是很好的研究对象。");
	else if (.@doc == 31) eldicastes_dp(12192,"Immortal Heart","永不停跳的心脏，来自名为人鱼的神秘生物。","心脏跳动的动力仍未知，值得研究。");
	else if (.@doc == 32) eldicastes_dp(12193,"Rotten Bandage","用于尸体的绷带。看来人类相信死者会回来取回身体。","");
	else if (.@doc == 33) eldicastes_dp(12194,"Decayed Nail","尸体上的指甲，是研究死亡时间和健康状况的重要材料。","有助于了解人类生态。");
	else if (.@doc == 34) eldicastes_dp(12215,"Stone Heart","据说米德加尔特荒芜地区的巨石会自行移动。","巨石的心脏会是罕见的研究对象。");
	else if (.@doc == 35) eldicastes_dp(12196,"Tentacle","海洋生物的触手。与昆虫触角不同，它会主动移动。","");
	else if (.@doc == 36) eldicastes_dp(12197,"Shell","保护昆虫或甲壳类生物的外壳。","这些生物的皮肤被外壳包围，行动非常灵活，值得研究。");
	else if (.@doc == 37) eldicastes_dp(12198,"Scale Shell","某些爬行动物身上的闪亮鳞片。","表面含有的荧光物质可用于多种用途。");
	else if (.@doc == 38) eldicastes_dp(12199,"Venom Canine","带毒的犬齿。人类用它制作杀戮武器。","");
	else if (.@doc == 39) eldicastes_dp(12200,"Sticky Mucus","仍有些黏性的液体。","可作为建筑关键材料，目前用于某些马努克建筑风格，在米德加尔特各处都很常见。");
	else if (.@doc == 40) eldicastes_dp(12201,"Bee Sting","从活昆虫身上取下的毒刺。","一些人类利用它的药效进行治疗。");
	else if (.@doc == 41) eldicastes_dp(12202,"Grasshopper's Leg","能跳很远的昆虫后腿，研究其结构很有趣。","");
	else if (.@doc == 42) eldicastes_dp(12203,"Royal Jelly","从蜂王身上采集的一种奇药。","人类很喜欢，但对马努克族没有发现功效。");
	else if (.@doc == 43) eldicastes_dp(12204,"Yoyo Tail","类人生物的尾巴。","研究人类为何没有这种痕迹会很有趣，但会伤害当前与人类的联盟。");
	else if (.@doc == 44) eldicastes_dp(12205,"Solid Shell","因某种环境因素进化出的外壳。","可以作为制作各种工具或武器的优秀材料。");
	else if (.@doc == 45) eldicastes_dp(12206,"Yam","成熟后可食用的黄色食物。","人类很喜欢。我还没尝过，但闻起来像成熟的甜薯。");
	else if (.@doc == 46) eldicastes_dp(12207,"Raccoon Leaf","据说有种动物把它贴在身上就能改变形态。","值得研究以验证传闻是否属实。");
	else if (.@doc == 47) eldicastes_dp(12210,"Bear's Footskin","人类收集猎杀的熊掌。","用途未知，收集熊掌的人类本身就是研究对象。");
	else if (.@doc == 48) eldicastes_dp(12211,"Feather","像绒毛一样柔软温暖的毛。","一定能用于御寒，在米德加尔特各处都能收集。");
	else if (.@doc == 49) eldicastes_dp(12212,"Red Herb","一种红色药用植物。","人类用它制作恢复药剂，是值得研究的植物。");
	else if (.@doc == 50) eldicastes_dp(12213,"Carrot","红色植物。酒馆老板总是要它，值得研究。","");
	close;

	function	eldicastes_dp	{
		if (checkquest(getarg(0)) >= 0) {
			mes "你找到了一份已经拥有的文档。";
			close;
		}
		mes "^660066"+getarg(2)+"^000000";
		mes "^660066"+getarg(3)+"^000000";
		next;
		mes "你找到了一份关于^990099"+getarg(1)+"^000000的文档。请在^800080任务窗口^000000查看详情。";
		specialeffect2 EF_STEAL;
		setquest getarg(0);
		close; 
	}
}
dic_in01,31,192,0	duplicate(Document Package#main)	Document Package#0001	844

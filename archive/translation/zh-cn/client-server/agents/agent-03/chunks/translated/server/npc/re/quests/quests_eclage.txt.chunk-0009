eclage,156,51,6	script	#hidden_eclage	HIDDEN_NPC,3,3,{
	end;
OnTouch:
	if (ep14_2_detect < 1 && BaseLevel >= 120) {
		mes "["+ strcharinfo(0) +"]";
		mes "沙沙……沙沙……";
		mes "嗒……嗒……嘎吱……嘎吱……";
		mes "咚咚咚……";
		mes "咚咚！！！嘎吱~咚！";
		next;
		switch( select("这些是什么声音？:忽略它们，继续前进。") ) {
			mes "["+ strcharinfo(0) +"]";
		case 1:
			mes "好像有奇怪的声音……";
			mes "我应该进去看看。";
			next;
			mes "["+ strcharinfo(0) +"]";
			mes "你好~";
			mes "出什么事了吗？";
			next;
			mes "- Something hits you";
			mes "狠狠敲在头上。";
			mes "你的身体失去力量，视线变得模糊——";
			specialeffect2 EF_HIT1;
			sc_start SC_BLIND,30000,0;
			next;
			mes "- Oh, I can't lose my consciousness like this -";
			close2;
			setquest 9225;
			ep14_2_detect = 1;
			percentheal -50,0;
			warp "ecl_in04",80,108;
			end;
		case 2:
			mes "大概没什么。";
			mes "我还是继续赶路吧~";
			close;
		}	
	}
}

ecl_in04,81,106,6	script	#hidden2_eclage	HIDDEN_NPC,2,2,{
	end;
OnTouch:
	if (ep14_2_detect == 1) {
		mes "[Daughter Luen]";
		mes "刚才发生了什么？";
		next;
		mes "[Father Dames]";
		mes "这座房子不可能";
		mes "在没有";
		mes "小偷闯入的情况下变得这么混乱……";
		next;
		mes "[Mother Rosa]";
		mes "就在刚才，我的项链";
		mes "被偷了！";
		next;
		mes "[Poppy]";
		mes "汪汪！汪汪！";
		mes "嗷呜汪！";
		next;
		mes "[Mother Rosa]";
		mes "这条该死的狗总是";
		mes "咬陌生人";
		mes "其他Laphine都讨厌它！";
		mes "我说过多少次";
		mes "我们应该把";
		mes "这条狗彻底赶出去？";
		next;
		mes "[Daughter Luen]";
		mes "Poppy~乖一点~";
		mes "这个人不是";
		mes "需要害怕的人，";
		mes "嘘~嘘~~";
		next;
		mes "[Mother Rosa]";
		mes "还有多少次";
		mes "我告诉过你要把门锁好";
		mes "亲爱的！！";
		mes "这一切都是因为你";
		mes "没有好好照顾我们的房子！";
		next;
		mes "[Father Dames]";
		mes "嘿，嘿，你总是";
		mes "太过分地责怪我！";
		mes "我们不是已经很幸运，";
		mes "没有";
		mes "受伤吗？";
		next;
		mes "[Mother Rosa]";
		mes "你说什么？";
		mes "我的天！";
		next;
		mes "[Daughter Luen]";
		mes "嗯？";
		mes "我觉得那个人醒了！";
		mes "嘿，你没事吧？";
		next;
		select("我的头好痛……");
		mes "[Mother Rosa]";
		mes "如果人类醒了，就把他赶走！";
		mes "我们的房子刚被抢劫，";
		mes "而且我们没有";
		mes "照顾别人的余力！";
		next;
		mes "[Daughter Luen]";
		mes "不过，也不能对一个被打晕的人这样说……";
		next;
		mes "[Daughter Luen]";
		mes "你感觉怎么样？";
		mes "你昏倒在我们房子前，所以我们把你带了进来。";
		mes "你发生了什么？";
		next;
		select("有人出来了……然后……");
		mes "[Daughter Luen]";
		mes "哇……真不敢相信发生了这种事。";
		mes "我觉得把你";
		mes "打晕的人";
		mes "就是抢劫我们房子的人。";
		next;
		mes "[Mother Rosa]";
		mes "你怎么能相信"+ (Sex == SEX_MALE?"他":"她") +"说的话？";
		mes "你怎么知道"+ (Sex == SEX_MALE?"他":"她") +"没有撒谎";
		mes "抢走我们的东西"+ (Sex == SEX_MALE?"他自己":"她自己") +"？";
		mes "马上搜查"+ (Sex == SEX_MALE?"他的":"她的") +"财物！！";
		next;
		mes "[Father Dames]";
		mes "不，你怎么能说这种话？";
		mes "按常理说，劫匪为什么会躺在房子前？";
		mes "我觉得这个人";
		mes "说的可能是真的……";
		next;
		mes "[Daughter Luen]";
		mes "总之，你打算怎么办？";
		mes "因为我们的房子刚被抢，";
		mes "我们没有办法照顾你。";
		next;
		if (select("我不是任人欺负的类型。:我会帮你抓住小偷。") == 1) {
			mes "[Daughter Luen]";
			mes "嗯……从你的样子看，";
			mes "你过去似乎";
			mes "经常被欺负……";
			next;
			mes "[Daughter Luen]";
			mes "嗯，我想";
			mes "我们需要";
			mes "你的帮助";
			mes "来处理这件事。";
		}
		else {
			mes "[Daughter Luen]";
			mes "嗯，既然你这么说，";
			mes "我不能百分之百相信你，但";
			mes "我会尽我所能信任你。";
		}
		next;
		mes "["+ strcharinfo(0) +"]";
		mes "是的。我一定会";
		mes "找到那个";
		mes "敲我头的混蛋。";
		next;
		mes "["+ strcharinfo(0) +"]";
		mes "首先，我会听听你对";
		mes "事情经过的观察。";
		mes "请全力配合。";
		next;
		mes "[Daughter Luen]";
		mes "好的，没问题。";
		next;
		mes "[Mother Rosa]";
		mes "我不太确定……";
		next;
		mes "[Father Dames]";
		mes "好，那就试试吧。";
		ep14_2_detect = 2;
		changequest 9225,9226;
		close;
	}
	if (ep14_2_detect == 3) {
		mes "["+ strcharinfo(0) +"]";
		mes "嗯……你告诉我的故事……";
		mes "我现在已经整理过了……";
		next;
		mes "["+ strcharinfo(0) +"]";
		mes "有几个值得关注的地方，";
		mes "我现在正在考虑……";
		mes "首先……";

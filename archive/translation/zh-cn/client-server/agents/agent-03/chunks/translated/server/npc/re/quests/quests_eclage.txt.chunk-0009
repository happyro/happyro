			next;
			mes "["+ strcharinfo(0) +"]";
			mes "什么！它什么时候到这里的？！";
			close;
		}
		mes "你为什么需要我父亲的一块翅膀……？";
		next;
		mes "- You briefly share Wuhuru's story -";
		next;
		mes "[Giranni]";
		mes "我明白了……这是他们共同研究的结果……";
		next;
		mes "[Giranni]";
		mes "好，当然。我会把它给你。我相信这也是我父亲希望你得到的。";
		next;
		mes "[Giranni]";
		mes "请告诉他我祝他一切顺利。";
		getitem 6548,1;// Piece_Of_Lapine_Wing
	//	getitem 1058,1;
	}
	else if (ep14_2_big > 25) {
		mes "我去看了我的父亲。";
		next;
		mes "[Giranni]";
		mes "我想在这里再回忆一下我的父亲。";
	}
	else
		mes "他去哪儿了……？";
	close;
}


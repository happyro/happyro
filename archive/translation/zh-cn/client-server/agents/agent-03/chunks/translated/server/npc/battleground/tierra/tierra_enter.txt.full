bat_room,127,178,5	script	Guillaume Knight#1	417,{
	mes "[Guillaume Knight]";
	mes "提耶拉峡谷由两侧垂直陡峭的区域组成，11 点和 7 点方向分别设有吉约姆军与克鲁瓦军的粮食补给站。";
	next;
	mes "[Guillaume Knight]";
	mes "战斗从己方军舰开始，目标是在敌人摧毁我方补给站之前推进并摧毁敌方补给站。";
	next;
	mes "[Guillaume Knight]";
	mes "战场治疗师每 25 秒会复活士兵，让他们重返战斗。";
	mes "夺取战场中央中立旗帜的军队将获得额外再生点数，其士兵复活次数会多于另一方，从而取得优势。";
	next;
	mes "[Guillaume Knight]";
	mes "两座补给站由狭窄的短路相连，但入口被路障封锁。";
	mes "请尽快思考并行动。军队的胜利取决于你的贡献。";
	next;
	mes "[Guillaume Knight]";
	if (getbattleflag("feature.bgqueue"))
		mes "准备好后，请点击界面中的 ^0000FF战斗按钮^000000。";
	else {
		mes "请记住：参加战斗时你会获得一个令牌，表示你在指定时间内不能参加同类型战斗。";
		mes "按 Alt+U 键即可查看剩余时间。";
	}
	next;
	mes "[Guillaume Knight]";
	if (getbattleflag("feature.bgqueue"))
		mes "请注意，取消后 ^0000FF一分钟内不能再次申请^000000！";
	else
		mes "准备好战斗了吗？请向我旁边的招募员申请！";
	close;
}

bat_room,143,178,5	duplicate(Guillaume Knight#1)	Guillaume Knight#2	417


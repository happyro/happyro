		next;
		mes "[Lazy]";
		mes "哇——你见过教皇吗？殿下太棒了。我真的很喜欢她。";
		emotion ET_BIGTHROB;
		next;
		mes "[Lazy]";
		mes "哦，教皇……！！";
		npctalk "我这颗流淌着鲜血的心属于教皇……", "", bc_self;
		emotion ET_CRY;
		next;
		mes "[Lazy]";
		mes "我真的很想见教皇。但我还没有做好见到殿下神圣面容的心理准备。我想，看到教皇时我可能会昏过去。如果你之后有时间，请带我去见教皇。";
		emotion ET_SHY;
		next;
		mes "[Lazy]";
		mes "对了，我们在这里做什么？我们不是应该在^0000cd艾因贝赫^000000见面吗？我等了很久才来到这里，结果发现你也在这里。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "他们让我来这里。";
		next;
		cutin "16lei_03.bmp",2;
		mes "[Lazy]";
		mes "嘿～谁？谁说的？沟通中一定出了什么误会。我们必须去艾因贝赫。";
		npctalk "也许有人就是想让你吃苦。", "", bc_self;
		next;
		cutin "16lei_02.bmp",2;
		mes "[Lazy]";
		mes "嗯，反正我喜欢坐火车，坐多少次都没关系。";
		next;
		cutin "16lei_01.bmp",2;
		mes "[Lazy]";
		mes "快点吧。我们还有很长的路要走。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "我们现在要去哪里？";
		next;
		cutin "16lei_03.bmp",2;
		mes "[Lazy]";
		mes "最危险的地方。";
		next;
		cutin "16lei_02.bmp",2;
		emotion ET_HUK, playerattached();
		mes "[Lazy]";
		mes "冷静！我只是开玩笑。你太认真了。我们只是要去艾因贝赫的叛乱军秘密基地。";
		npctalk "你的脸现在很苍白。你没事吧？想吐的话可以去那边。", "", bc_self;
		next;
		cutin "16lei_01.bmp",2;
		mes "[Lazy]";
		mes "我只是说感觉那里很危险，并不是说真的会有危险。冷静点。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "既然我们要和叛乱军谈判，为什么不去艾因布洛克，而要去艾因贝赫？";
		next;
		mes "[Lazy]";
		mes "你听说过施瓦尔茨瓦尔德的佣兵叛乱吗？";
		next;
		cutin "16lei_03.bmp",2;
		mes "[Lazy]";
		mes "简单来说，佣兵曾被共和国用作驻军。但共和国建造守护者后，他们就要被抛弃了。于是佣兵发动叛乱，几乎全军覆没。";
		next;
		mes "[Lazy]";
		mes "一部分残部去了菲格尔，其余人聚集在艾因贝赫和艾因布洛克，组织起叛乱军。顺便说，艾因布洛克是很多人居住和经过的大城市，对吧？";
		next;
		mes "[Lazy]";
		mes "所以叛乱军把公会设在艾因布洛克，其余人则藏在艾因布洛克的其他地方。这就是我提议在艾因贝赫见面的原因……";
		next;
		mes "[Lazy]";
		mes "总之，政府因为各种原因一直对这些残部睁一只眼闭一只眼。我想政府对此仍然感到不安。";
		next;
		cutin "16lei_02.bmp",2;
		mes "[Lazy]";
		mes "所以这次谈判非常重要。我们要向那个对我生气的人求助，这不会容易。";
		next;
		cutin "16lei_03.bmp",2;
		mes "[Lazy]";
		mes "我们应该向他们表达歉意，并许诺未来的希望。同时，^0000cd我们必须让他们安心，并承诺今后在事务上合作^000000……";
		npctalk "我们必须独自完成。", "", bc_self;
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "光是听起来就很困难。";
		next;
		cutin "16lei_02.bmp",2;
		mes "[Lazy]";
		mes "最困难的不是和他们谈话，而是如何进入^0000cd秘密基地^000000。";
		next;
		cutin "16lei_01.bmp",2;
		mes "[Lazy]";
		mes "总之，我们路上再想办法。你只要相信我，跟着我就好。只要相信我，没有什么是不可能的。任何情况下你都可以相信我。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "我不太信任你。";
		next;
		cutin "16lei_02.bmp",2;
		mes "[Lazy]";
		mes "没关系，因为我相信自己。在这个广阔世界的所有人中，我只相信自己。所以你跟着我就好。";
		emotion ET_BEST;
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "你对自己真有信心。";
		next;
		cutin "16lei_01.bmp",2;
		mes "[Lazy]";
		mes "当然。如果我对自己没有信心，就无法完成这项工作。";
		next;
		mes "[Lazy]";
		mes "有时我必须面对令人不快的情况，做一些不太道德的事。但为了任务和生存，我不能犹豫，必须果断决定并执行。";
		next;
		mes "[Lazy]";
		mes "假设你开始怀疑。一旦内心动摇，任务就会陷入危险。坚定不移的信心比任何事情都重要。";
		emotion ET_OK;
		next;
		cutin "16lei_02.bmp",2;
		mes "[Lazy]";
		mes "当然，你也需要有能力支撑自己的信心。没有证据就什么都不能相信。";
		emotion ET_BEST;
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "听了你的话，我并不完全信任你。但我觉得自己必须相信你。";
		next;
		cutin "16lei_01.bmp",2;
		mes "[Lazy]";
		mes "这很自然。很好。祝我们的任务顺利。我的目标是和你组成一对出色搭档，建立好名声。";
		emotion ET_BEST;
		next;
		mes "[Lazy]";
		mes "出发吧。这边。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "检票口在那边！坐火车要付钱。你是说我们要走过去吗？";
		next;
		cutin "16lei_03.bmp",2;
		mes "[Lazy]";
		mes "哎呀！安静！！当然要坐火车。去特别的地方，就要用特别的方法。";
		emotion ET_FRET;
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "免费乘车？为什么？";
		npctalk "请不要把它说成免费乘车。", "", bc_self;
		next;
		mes "[Lazy]";
		mes "你想叫它免费乘车就随你。但你真的想把自己的行动贬低成“免费乘车”吗？你可以使用优雅的说法“闭锁渗透后的占领”。";
		unittalk getcharid(3), "" + strcharinfo(0) + " : Yes. Yes. It sounds great.", bc_self;
		next;
		cutin "16lei_03.bmp",2;
		mes "[Lazy]";
		mes "通常，我们可以买票、向车站工作人员问好、吃美味的零食，享受旅程。";
		next;
		mes "[Lazy]";
		mes "但我们正处于任务之中，任务已经开始了。这有点紧急，所以必须保持紧张。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "我真的不明白保持紧张和免费乘车有什么关系。";
		next;
		cutin "16lei_03.bmp",2;
		mes "[Lazy]";
		mes "你真的以为我只是想省下 200 Zeny 吗？我知道自己在做什么。别唠叨，跟着我就好。我们赶时间。";
		setquest 14595;// To Einbech train station
		terra_gloria_main = 10;
		close2;
		navigateto( "einbroch",267,268,NAV_NONE,1 );
		cutin "",255;
		cloakonnpcself( "Unusual person#16nego01" );
		cloakoffnpcself( "Lazy#16nego06" );
		end;
	}
	if (terra_gloria_main == 10) {
		cutin "16lei_01.bmp",2;
		mes "[Lazy]";
		mes "你为什么不跟上？我们可能赶不上火车！";
		close2;
		navigateto( "einbroch",267,268,NAV_NONE,1 );
		cutin "",255;
		cloakonnpcself( "Unusual person#16nego01" );
		cloakoffnpcself( "Lazy#16nego06" );
		end;
	}
	if (terra_gloria_main == 11) {
		cutin "16lei_01.bmp",2;
		mes "[Lazy]";
		mes "好久不见！我要去另一个任务地点。明白了吗？回头见！";
		close2;
		cutin "",255;
		cloakonnpcself( "Unusual person#16nego01" );
		end;
	}
	if (terra_gloria_main < 17) {
		cutin "16lei_01.bmp",2;
		mes "[Lazy]";
		mes "你现在来这里没问题吗？";
		close2;
		cutin "",255;
		cloakonnpcself( "Unusual person#16nego01" );
		end;
	}
	cutin "16lei_01.bmp",2;
	mes "[Lazy]";
	mes "好久不见！我要去另一个任务地点。明白了吗？回头见！";
	close2;
	cutin "",255;
	cloakonnpcself( "Unusual person#16nego01" );
	end;

OnInit:
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "isbegin_quest(14595) == 0 && isbegin_quest(7737) == 1" );
	end;
}

einbroch,270,267,5	script	Very small hole#16nego0	4_CRACK,5,5,{
	if (terra_gloria_main != 10 && terra_gloria_main != 11) {
		cloakonnpcself( "Very small hole#16nego0" );
		cloakonnpcself( "Lazy#16nego06" );
		end;
	}
	if (terra_gloria_main == 10) {
		mes "这是一个勉强能让一个人通过的小洞。";
		close;
	}
	mes "你穿过了那个勉强能让一个人进入的小洞。";
	close2;
	warp "einbech",44,207;
	end;

OnTouch:
	if (terra_gloria_main == 10 || terra_gloria_main == 11)
		cloakoffnpcself( "Very small hole#16nego0" );
	end;
}

einbroch,270,268,3	script	Lazy#16nego06	4_M_LAZY,{
	if (terra_gloria_main != 10) {
		cloakonnpcself( "Lazy#16nego06" );
		end;
	}
	cutin "16lei_01.bmp",2;
	mes "[Lazy]";
	mes "我们要从这里搭火车。你看到下面下水道里的^0000cd小洞^000000了吗？";
	next;
	mes "[" + strcharinfo(0) + "]";
	mes "这是……^0000cd狗洞^000000吗？我听说秘密之翼是总统的直属机构。你为什么这么狼狈？";
	unittalk getcharid(3), "" + strcharinfo(0) + " : I can't believe it. This is not what I imagined.", bc_self;
	next;
	cutin "16lei_03.bmp",2;
	emotion ET_SWEAT, playerattached();
	mes "[Lazy]";
	mes "嘘——我说过别提那个名字。从现在开始小心点。我不想因为没做过的事被人从背后捅刀。如果你真的想说，就叫它苍鹭。";
	npctalk "你想象出来的？看来你小说看得太多了。", "", bc_self;
	next;
	emotion ET_FRET;
	mes "[" + strcharinfo(0) + "]";
	mes "我是说，你为什么要经过这种地方？他们不给你行动经费吗？也许阁下根本不在乎你的舒适。";
	next;
	cutin "16lei_02.bmp",2;
	mes "[Lazy]";
	mes "不是这样的。我们有免费使用这片大陆所有交通工具的通行证，包括飞艇、火车和传送等。";
	next;
	mes "[" + strcharinfo(0) + "]";
	mes "那你为什么还要经过这种地方？";
	next;
	cutin "16lei_01.bmp",2;
	mes "[Lazy]";
	mes "因为我们不想留下记录。我们不能被别人发现。即使被抓住，也必须隐藏行动路线。行动路线可能会成为重要线索。";
	next;
	mes "[Lazy]";
	mes "难怪我们的名字里有“秘密”二字。这就是我执行任务时如此谨慎的原因。";
	next;
	mes "[Lazy]";
	mes "为了避免被发现，低下身子跟着我。";
	terra_gloria_main = 11;
	close2;
	cutin "",255;
	cloakonnpcself( "Lazy#16nego06" );
	end;

OnInit:
	cloakonnpc "Lazy#16nego06";
	end;
}


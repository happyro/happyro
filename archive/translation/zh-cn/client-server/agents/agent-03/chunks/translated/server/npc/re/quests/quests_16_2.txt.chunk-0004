einbech,46,208,3	script	Lazy#16nego01	4_M_LAZY,{
	if (terra_gloria_main < 9) {
		cutin "16lei_01.bmp",2;
		mes "[Someone crazy about Yuno]";
		mes "朱诺～去朱诺～如果你生而为人，就去朱诺～如果你来到了施瓦尔茨瓦尔德，就去朱诺～只要你还在呼吸，就去朱诺～";
		close3;
	}
	if (terra_gloria_main == 9) {
		cutin "16lei_01.bmp",2;
		mes "[Lazy]";
		mes "他说他会来这里。也许他还在艾因布洛克火车站？我得再去一趟。";
		close2;
		cutin "",255;
		cloakonnpcself( "Lazy#16nego01" );
		end;
	}
	if (terra_gloria_main == 10 || terra_gloria_main == 11) {
		cutin "16lei_01.bmp",2;
		mes "[Lazy]";
		mes "这里是艾因贝赫。上次我来这里时，身后有 17 个追兵。";
		next;
		cutin "16lei_02.bmp",2;
		mes "[Lazy]";
		mes "抱歉我不能透露更多。这是机密。";
		npctalk "这是国家机密。", "", bc_self;
		next;
		emotion ET_SWEAT, playerattached();
		mes "[" + strcharinfo(0) + "]";
		mes "......";
		next;
		cutin "16lei_03.bmp",2;
		mes "[Lazy]";
		mes "嘿！我只是在任务开始前开了个玩笑。你连这个都接受不了吗？";
		npctalk "看看你现在的表情！别那样看着我～", "", bc_self;
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "我有点紧张。谈判……";
		next;
		cutin "16lei_01.bmp",2;
		mes "[Lazy]";
		mes "你不用紧张。我负责和他们谈话。你只要在旁边说几句话就好。";
		npctalk "紧张？你比我想象中可爱。", "", bc_self;
		next;
		mes "[Lazy]";
		mes "这次任务中，信任很重要。政府把你和我这位专业谈判者一起安排到任务中，是有原因的。";
		npctalk "重新建立信任极其困难。但我们还能怎么办？他们想让我们修补破裂的关系。", "", bc_self;
		next;
		mes "[Lazy]";
		mes "你在米德加尔特大陆上被称为英雄，是信任的象征。你和我一起去，叛乱军就不会那么固执。一旦取得他们的信任，一切都会顺利。";
		next;
		emotion ET_BEST;
		mes "[" + strcharinfo(0) + "]";
		mes "穿成这样说话，你看起来不太有说服力。";
		next;
		cutin "16lei_02.bmp",2;
		mes "[Lazy]";
		mes "这是我为这次任务准备的关键服装。谁会怀疑一个游客呢？";
		npctalk "这副是我的特别太阳镜。", "", bc_self;
		next;
		cutin "16lei_01.bmp",2;
		mes "[Lazy]";
		mes "正如我之前所说，我们最大的挑战是在不发生武装冲突的情况下进入叛乱军秘密基地。这套服装就是为此准备的。";
		next;
		mes "[Lazy]";
		mes "而朱诺是个很棒的地方。我梦想退休后在那里买栋房子，舒适地度过晚年。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "人们通常不会选择梦罗克那样的度假胜地安度晚年吗？";
		next;
		cutin "16lei_03.bmp",2;
		mes "[Lazy]";
		mes "哦，我不喜欢海滩。年轻时我每天都能看到大海，现在已经厌倦了海水的咸味。为了离开大海，我曾梦想成为飞艇船长。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "既然你想成为飞行员，为什么又当了秘密特工？";
		next;
		mes "[Lazy]";
		mes "我不能告诉你。这是机密。";
		next;
		emotion ET_SWEAT, playerattached();
		mes "[" + strcharinfo(0) + "]";
		mes "我明白了。";
		unittalk getcharid(3), "" + strcharinfo(0) + " : I never expected.", bc_self;
		next;
		cutin "16lei_02.bmp",2;
		mes "[Lazy]";
		mes "哦，任务结束回来后，你可以买张火车票给车站工作人员看。但我可以免费乘车。";
		unittalk getcharid(3), "" + strcharinfo(0) + " : I have a favor to ask of you. Please let me hit you once.", bc_self;
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "那么，我们现在该去哪儿？";
		next;
		cutin "16lei_01.bmp",2;
		mes "[Lazy]";
		mes "我们要去村子深处。从这里开始，相信我并跟着我。由于路线有点复杂，我会留下^0000cd痕迹^000000。记得跟上。";
		unittalk getcharid(3), "" + strcharinfo(0) + " : I can smell something from the traces.", bc_self;
		erasequest 14595;// To Einbech train station
		setquest 14596;// Follow the trails
		terra_gloria_main = 12;
		close2;
		cutin "",255;
		viewpoint 1,74,129,1,0x4D4DFF00;
		navigateto( "einbech",74,129,NAV_NONE,1 );
		cloakonnpcself( "Lazy#16nego01" );
		end;
	}
	if (terra_gloria_main == 12) {
		cutin "16lei_01.bmp",2;
		mes "[Lazy]";
		mes "你在做什么？我叫你跟着我。";
		close2;
		cutin "",255;
		viewpoint 1,74,129,1,0x4D4DFF00;
		navigateto( "einbech",74,129,NAV_NONE,1 );
		cloakonnpcself( "Lazy#16nego01" );
		end;
	}
	if (terra_gloria_main < 17) {
		cutin "16lei_01.bmp",2;
		mes "[Lazy]";
		mes "我们现在不该在这里。";
		mes "我们必须去叛乱军那里。";
		close2;
		cutin "",255;
		cloakonnpcself( "Lazy#16nego01" );
		end;
	}
	cutin "16lei_01.bmp",2;
	mes "[Lazy]";
	mes "好久不见！我要去另一个任务地点。明白了吗？回头见！";
	close2;
	cutin "",255;
	cloakonnpcself( "Lazy#16nego01" );
	end;
}


//===== rAthena Script =======================================
//= Eden Group Quests - Mission [41 - 55]
//===== By: ==================================================
//= L0ne_W0lf
//===== Current Version: =====================================
//= 1.4
//===== Compatible With: =====================================
//= rAthena Project
//===== Description: =========================================
//= Repetable Quests for Players between Baselevel 41 - 55.
//===== Additional Comments: =================================
//= 1.0 First Version.
//= 1.1 Some little optimization here and there. [Masao]
//= 1.2 Optimized. [Euphy]
//= 1.3 Added support to Para_Team_Mark_ in Eden Group. [Ragno]
//= 1.4 Added use of F_HasEdenGroupMark function. [Ragno]
//============================================================

moc_para01,40,38,3	script	Mission [41 - 55]	857,{
	if (!callfunc("F_HasEdenGroupMark")) {
		mes "你不是伊甸园成员，没有资格使用任务公告板。";
		close;
	}
	if (checkweight(1201,1) == 0 || (MaxWeight - Weight) < 1000) {
		mes "^008800等一下！！";
		mes "你携带的物品太多，无法再领取物品。减轻负重后再试。^000000";
		close;
	}
	if (checkquest(12088) == -1) {
		if (BaseLevel < 41 || BaseLevel > 55) {
			mes "41~55 级冒险者任务公告板。";
			close;
		}
		mes "[任务公告板]";
		mes "任务公告板。";
		next;
		if(select("查看任务:取消。") == 2) {
			mes "^000077好的，下次再查看任务。^000000。";
			close;
		}
		switch(select("猎杀塔拉青蛙:猎杀巡航者:猎杀库克雷:猎杀兽人婴儿:猎杀兽人战士:猎杀海葵:猎杀巨齿鲨:猎杀马尔斯:猎杀独角兽:猎杀米斯特:猎杀贝壳魔:猎杀海灵球")) {
			case 1: callsub L_Quest,12072,"你见过红色青蛙吗？它叫塔拉青蛙，非常稀有。请猎杀 20 只塔拉青蛙。";
			case 2: callsub L_Quest,12073,"听说有玩具在攻击人，太荒唐了！让它们见识我们的力量！猎杀 15 个巡航者！";
			case 3: callsub L_Quest,12074,"有人在海滩附近被抢了！嫌疑犯是名为库克雷的罪犯怪物。请猎杀 30 只库克雷。";
			case 4: callsub L_Quest,12075,"最近兽人婴儿变得更加暴力。请猎杀 15 个兽人婴儿。";
			case 5: callsub L_Quest,12076,"兽人战士越来越好斗。请猎杀 20 个兽人战士。";
			case 6: callsub L_Quest,12077,"你见过厚壳螃蟹吗？它们是海葵。请猎杀 15 只海葵。";
			case 7: callsub L_Quest,12078,"海滩到处都是死鱼，情况越来越糟。请猎杀 30 条巨齿鲨。";
			case 8: callsub L_Quest,12079,"你能猎杀马尔斯吗？我的研究需要 15 只。请帮帮我。";
			case 9: callsub L_Quest,12080,"一只笨蛋独角兽咬了市长的脚。市长很生气，所以我们需要猎杀 20 只独角兽让他开心！";
			case 10: callsub L_Quest,12081,"人们被米斯特吓坏了。它看起来像幽灵，令人害怕。请猎杀 15 只米斯特。";
			case 11: callsub L_Quest,12082,"别问为什么，请猎杀 30 只贝壳魔。这是秘密任务！";
			case 12: callsub L_Quest,12083,"海灵球？你知道海灵球是什么吗？我有个任务，要你猎杀 15 个海灵球，请完成它。";
			case 13: callsub L_Quest,12084,"市长想吃美味的鱼料理。海葵幼虫会是完美食材。请猎杀 20 只海葵幼虫！";
			case 14: callsub L_Quest,12085,"死去的兽人怪物回到了城镇，并复活成兽人骷髅。我们陷入混乱！请猎杀 15 个兽人骷髅。";
			case 15: callsub L_Quest,12086,"一些名为邪骸兽人的奇怪怪物正在攻击我们。请猎杀 30 只邪骸兽人。";
			case 16: callsub L_Quest,12087,"做好准备！这是残酷的任务！猎杀 15 个木乃伊！！我试过一次，但没能成功。太可怕了！";
		}
		end;
	}
	setarray .@Exp[0],9600,7200,15750,7875,11100,8550,17100,9000,12300,9900,20250,10350,13800,11025,22500,11250;
	for(set .@i,0; .@i<16; set .@i,.@i+1)
		if (checkquest(12072+.@i,HUNTING) == 2) {
			mes "[任务公告板]";
			mes "你完成了任务。";
			mes "这是你的奖励。";
			erasequest 12088;
			erasequest 12072+.@i;
			specialeffect2 EF_STEAL;
			getexp .@Exp[.@i],0;
			close;
		}
	if ((checkquest(12072,HUNTING) == 0) && (checkquest(12073,HUNTING) == 0) && (checkquest(12074,HUNTING) == 0) && (checkquest(12075,HUNTING) == 0) && (checkquest(12076,HUNTING) == 0) && (checkquest(12077,HUNTING) == 0) && (checkquest(12078,HUNTING) == 0) && (checkquest(12079,HUNTING) == 0) && (checkquest(12080,HUNTING) == 0) && (checkquest(12081,HUNTING) == 0) && (checkquest(12082,HUNTING) == 0) && (checkquest(12083,HUNTING) == 0) && (checkquest(12084,HUNTING) == 0) && (checkquest(12085,HUNTING) == 0) && (checkquest(12086,HUNTING) == 0) && (checkquest(12087,HUNTING) == 0)) {
		mes "现在可以查看公告板了。";
		erasequest 12088;
		close;
	}
	mes "没有特别的事情可做。";
	close;
L_Quest:
	mes "[任务公告板备忘录]";
	mes getarg(1);
	next;
	if(select("接受任务:取消。") == 1) {
		mes "[任务公告板]";
		mes "你已接受任务。更多详情请按 Alt+U，在任务窗口查看信息。";
		setquest 12088;
		setquest getarg(0);
	}
	close;
}

moc_ruins,113,181,4	duplicate(William)	William#moc	89

// Binoculars Quest
// ============================================================
moc_ruins,118,176,4	duplicate(Alchemist)	Alchemist#moc	64

// Resurrection of Satan Morocc
// ============================================================

morocc,176,103,3	duplicate(Continental Official)	Continental Official#mor	754

// Succession of the Prince
// ============================================================
prontera,153,353,4	script	Messenger#prince1	105,{
	if (nk_prince == 0) {
		if (rebirth_moc_edq > 1) {
			mes "[Messenger]";
			mes "我是王室派来的使者，负责寻找可靠的冒险者。这关系到国家的重要事务。";
			next;
			if (aru_monas > 23) {
				mes "[Messenger]";
				mes "这可能带来国家动荡，但人们都对恶魔复生保持警惕。现在正是处理此事、避免额外骚动的好时机。";
				next;
				mes "[Messenger]";
				mes "哦，我不想让你太惊慌……嗯……我想说的是，统治卢恩·米德加尔特的Tristan三世……";
				next;
				switch(select("去世了？:又是来参加庆典？")) {
				case 1:
					emotion ET_SURPRISE;
					mes "[Messenger]";
					mes "你已经知道了……";
					mes "那我就不再解释了。";
					next;
					mes "[Messenger]";
					mes "王位不能空缺太久。";
					mes "现在正在积极讨论下一任国王的人选。为了卢恩·米德加尔特的未来，请帮助我们。";
					set nk_prince,1;
					setquest 10000;
					close;
				case 2:
					mes "[Messenger]";
					mes "...";
					next;
					mes "[Messenger]";
					mes "你在想什么？";
					mes "你真的觉得现在举办庆典对国家很重要吗？";
					next;
					mes "[Messenger]";
					mes "是啊……";
					mes "你什么都没期待也很自然。我还不知道该怎么向你表达。别太困惑。";
					next;
					mes "[Messenger]";
					mes "统治卢恩·米德加尔特的Tristan三世……";
					next;
					mes "[Messenger]";
					mes "...";
					mes "已经去世了。";
					next;
					mes "[Messenger]";
					mes "为防止民众骚乱，暂时不会公开。王室目前正专注于选出下一任国王，忙于讨论此事。";
					next;
					mes "[Messenger]";
					mes "你可以在王室了解更多详情。我的任务只是把消息传达给可靠勇敢的冒险者。";
					next;
					mes "[Messenger]";
					mes "请……请……";
					mes "为了卢恩·米德加尔特王国的未来";
					mes "伸出援手吧。";
					set nk_prince,1;
					setquest 10000;
					close;
				}
			}
			else {
				mes "[Messenger]";
				mes "这可能带来国家动荡，但人们都对恶魔复生保持警惕。现在正是处理此事、避免额外骚动的好时机。";
				next;
				mes "[Messenger]";
				mes "国王已经有一段时间没有公开露面了。";
				mes "许多人都对情况感到好奇。";
				mes "";
				next;
				mes "[Messenger]";
				mes "我讨厌把这个悲伤的事实告诉别人。";
				mes "我想你已经从我的话里猜到了……";
				mes "";
				next;
				mes "[Messenger]";
				mes "Tristan国王……";
				mes "";
				next;
				mes "[Messenger]";
				mes "Tristan国王……";
				mes "……去世了……";
				mes "……长期饱受疾病折磨后离世。";
				next;
				mes "[Messenger]";
				mes "王室正在选出下一任国王。我的任务是寻找忠诚的冒险者并送他们去王室。";
				mes "";
				next;
				mes "[Messenger]";
				mes "他们会告诉你在王室要做什么。";
				mes "希望你能帮助卢恩·米德加尔特带来和平。";
				mes "";
				mes "";
				set nk_prince,1;
				setquest 10000;
				close;
			}
		}
		else {
			mes "[Messenger]";
			mes "我是卢恩·米德加尔特的使者。";
			mes "这个国家有什么特别的事吗？";
			next;
			mes "[Messenger]";
			mes "你没见过什么神秘的事，或听到什么传闻吗？";
			mes "";
			close;
		}
	}
	else if (nk_prince == 1) {
		mes "[Messenger]";
		mes "我希望你去普隆德拉王室，协助选出下一任国王。";
		next;
		mes "[Messenger]";
		mes "我会留在这里寻找其他冒险者。愿你的心为卢恩·米德加尔特带来荣耀！";
		close;
	}
	else {
		mes "[Messenger]";
		mes "我现在正在执行任务。你可能找错地方了，去问问其他人。";
		close;
	}
}

prt_castle,117,163,5	script	Inspector#prince	755,{
	if (checkquest(10004) == 0 || checkquest(10004) == 1) {
		mes "[Inspector]";
		mes "法官！";
		mes "进展如何？会见并评估七位候选人可不容易。";
		next;
		mes "[Inspector]";
		mes "哈，你完成了吗？";
		mes "动作真快，工作完成得很好！";
		next;
		mes "[Inspector]";
		mes "把候选人的情况告诉我吧～";
		next;
		mes "- 我立即向监察官";
		mes "- 说明了对王子候选人的印象。";
		mes "- 我只告诉了他清晰简洁的事实。-";
		mes "";
		mes "";
		next;
		mes "[Inspector]";
		mes "嗯……是这样吗？你说的对我帮助很大。谢谢你的辛苦工作。";
		next;
		mes "[Inspector]";
		mes "顺便说，我听到了关于Walter家族的Eigen Ahrum王子的传闻。";
		mes "你能再评估一次所有候选人吗？这件事很紧急。";
		next;
		mes "[Inspector]";
		mes "现在整体情况可能会改变……其他人可能也一样。";
		mes "但我担心Eigen Ahrum，不能忽略任何候选人的传闻。";
		next;
		mes "[Inspector]";
		mes "好吧……请再进去一次。";
		mes "";
		completequest 10004;
		setquest 10018;
		setquest 10019;
		setquest 10020;
		setquest 10021;
		setquest 10022;
		close;
	}
	if (nk_prince < 2) {
		mes "[Inspector]";
		mes "你有什么问题？";
		mes "这里不是开放区域！";
		next;
		switch(select("好吧，好吧。:使者让我来这里。")) {
		case 1:
			mes "[Inspector]";
			mes "既然知道，为什么还来这里？出去！";
			close2;
			warp "prontera",155,353;
			end;
		case 2:
			if (nk_prince == 0) {
				mes "[Inspector]";
				mes "我觉得他不是有经验的评估者……";
				close;
			}
			mes "[Inspector]";
			mes "......";
			next;
			if (BaseLevel > 89) {
				mes "[Inspector]";
				mes "使者只检查了你的身体资质，就把一名战士送到王室。这就是他的职责。";
				next;
				mes "[Inspector]";
				mes "检查你的资格是我的职责。";
				next;
				mes "[Inspector]";
				mes "Hmm...";
				next;
				mes "[Inspector]";
				mes "你是经验丰富的旅行者，力量也足够，但王室不会只根据力量和战斗经验选人。";
				next;
				mes "[Inspector]";
				mes "要考察一个人的品质，";
				mes "必须了解他的性格。";
				mes "";
				next;
				mes "[Inspector]";
				mes "因此，我想做个简单实验。";
				mes "来测试你。";
				next;
				mes "[Inspector]";
				mes "不复杂。每种情况出现后，请快速、坦率地回答。";
				next;
				mes "[Inspector]";
				mes "好，开始吧。准备好，仔细听并回答。";
				next;
				mes "[Inspector]";
				mes "作为狩猎队队长，你认为";
				mes "最重要的考虑是什么？";
				next;
				switch(select("怪物的力量与特征:狩猎效率:狩猎所得")) {
				case 1:
					set .@int,.@int+10;
					break;
				case 2:
					set .@solid,.@solid+10;
					break;
				case 3:
					set .@brave,.@brave+10;
					break;
				}
				mes "[Inspector]";
				mes "如果战斗中失去一名队员怎么办？";
				next;
				switch(select("继续战斗直到成功:换地方并改变方法:停止狩猎并补给")) {
				case 1:
					set .@brave,.@brave+10;
					break;
				case 2:
					set .@int,.@int+10;
					break;
				case 3:
					set .@solid,.@solid+10;
					break;
				}
				mes "[Inspector]";
				mes "狩猎所得应该……";
				next;
				switch(select("按约定分配:我不想管分配:给需要它的队员")) {
				case 1:
					set .@int,.@int+10;
					break;
				case 2:
					set .@solid,.@solid+10;
					break;
				case 3:
					set .@brave,.@brave+10;
					break;
				}
				mes "[Inspector]";
				mes "敌人还活着时，哪种职业的队员";
				mes "必须优先治疗？";
				next;
				switch(select("牧师，治疗职业:猎人，伤害输出:骑士领主，坦克")) {
				case 1:
					set .@int,.@int+10;
					break;
				case 2:
					set .@brave,.@brave+10;
					break;
				case 3:
					set .@solid,.@solid+10;
					break;
				}
				mes "[Inspector]";
				mes "你最想和谁成为朋友？";
				mes "";
				next;
				switch(select("强大的人:有经验的人:善良的人")) {
				case 1:
					set .@brave,.@brave+10;
					break;
				case 2:
					set .@int,.@int+10;
					break;
				case 3:
					set .@solid,.@solid+10;
					break;
				}
				mes "[Inspector]";
				mes "训练期间帮助你最多的能力是什么？";
				next;
				switch(select("人际关系:收集大量信息:判断力与行动力")) {
				case 1:
					set .@solid,.@solid+10;
					break;
				case 2:
					set .@int,.@int+10;
					break;
				case 3:
					set .@brave,.@brave+10;
					break;
				}
				mes "[Inspector]";
				mes "你通常如何鼓励他人？";
				mes "";
				next;
				switch(select("提及过去的失败:犹豫是最糟糕的事:你并不孤单")) {
				case 1:
					set .@int,.@int+10;
					break;
				case 2:
					set .@brave,.@brave+10;
					break;
				case 3:
					set .@solid,.@solid+10;
					break;
				}
				mes "[Inspector]";
				mes "你人生中最重要的美德是什么？";
				mes "";
				next;
				switch(select("自我成长:世界和平:追求真理")) {
				case 1:
					set .@brave,.@brave+10;
					break;
				case 2:
					set .@solid,.@solid+10;
					break;
				case 3:
					set .@int,.@int+10;
					break;
				}
				mes "[Inspector]";
				mes "如果你在荒岛上，最想保留什么？";
				next;
				switch(select("地图:燧石:武器")) {
				case 1:
					set .@int,.@int+10;
					break;
				case 2:
					set .@solid,.@solid+10;
					break;
				case 3:
					set .@brave,.@brave+10;
					break;
				}
				mes "[Inspector]";
				mes "你最喜欢哪种故事？";
				mes "";
				mes "";
				next;
				switch(select("爱情故事:英雄史诗:宗教故事")) {
				case 1:
					set .@solid,.@solid+10;
					break;
				case 2:
					set .@brave,.@brave+10;
					break;
				case 3:
					set .@int,.@int+10;
					break;
				}
				mes "[Inspector]";
				mes "你在新区域遇到新怪物。";
				mes "你会怎么做？";
				mes "";
				mes "";
				next;
				switch(select("先发起攻击:远距离观察:逃跑")) {
				case 1:
					set .@brave,.@brave+10;
					break;
				case 2:
					set .@int,.@int+10;
					break;
				case 3:
					set .@solid,.@solid+10;
					break;
				}
				mes "[Inspector]";
				mes "统治卢恩·米德加尔特王国时，";
				mes "首先应该做什么？";
				next;
				switch(select("强化军队以支配他国:发展经济与科技:维持公共安全")) {
				case 1:
					set .@brave,.@brave+10;
					break;
				case 2:
					set .@int,.@int+10;
					break;
				case 3:
					set .@solid,.@solid+10;
					break;
				}
				mes "[Inspector]";
				mes "你的人性测试结束了。";
				mes "你一直以来的生活是……";
				next;
				if (.@brave > 50) {
					if (.@int > 30) {
						mes "[Inspector]";
						mes "充满坚定信念，";
						mes "并拥有合理判断力。";
						mes "";
						next;
					}
					else if (.@solid > 30) {
						mes "[Inspector]";
						mes "非常勇敢，";
						mes "但生活也很节制。";
						mes "";
						next;
					}
					else {
						mes "[Inspector]";
						mes "拥有果断的头脑。";
						mes "你能凭此克服困难。";
						next;
					}
				}
				else if (.@int > 50) {
					if (.@brave > 30) {
						mes "[Inspector]";
						mes "坚定不移，";
						mes "并拥有合理判断力。";
						mes "";
						next;
					}
					else if (.@solid > 30) {
						mes "[Inspector]";
						mes "拥有合理判断力";
						mes "和和谐的感受力。";
						mes "";
						next;
					}
					else {
						mes "[Inspector]";
						mes "能够冷静而谨慎地做决定。";
						mes "我想你也有许多美好经历。";
						next;
					}
				}
				else if (.@solid > 50) {
					if (.@brave > 30) {
						mes "[Inspector]";
						mes "非常勇敢，";
						mes "但生活也很节制。";
						mes "";
						next;
					}
					else if (.@int > 30) {
						mes "[Inspector]";
						mes "拥有合理判断力";
						mes "和宁静的感受力。";
						mes "";
						next;
					}
					else {
						mes "[Inspector]";
						mes "……呃，其实……";
						mes "你没有偏向任何一方……";
						mes "稳定与和谐";
						mes "是你人生中的重要美德。";
						next;
					}
				}
				mes "[Inspector]";
				mes "我认为你已经具备";
				mes "评估他人的资格。为一开始的无礼向你道歉。";
				next;
				mes "[Inspector]";
				mes "所以请你帮我们一个忙。你已经成为正式的冒险者评估员。";
				next;
				mes "[Inspector]";
				mes "啊，你和我待了很久，一定很累了。开始工作前如果需要准备就先离开，之后再回来。我会在这里等你。";
				next;
				set nk_prince,4;

		mes "从梦罗克城向西南方向走。";
		mes "在那里你会找到通往蚂蚁地狱洞穴的地洞。";
		next;
		mes "[Boya]";
		mes "里面有很多蚂蚁。呵呵？";
		mes "那里还覆盖着沙子，所以要小心，好吗？";
		next;
		mes "[Boya]";
		mes "所以才叫蚂蚁地狱。";
		mes "我们的一名成员会在那里等你。";
		mes "他的名字是……K？M？嗯？总之我想不起来了。";
		next;
		mes "[Boya]";
		mes "他是我们的人，所以会认识我。";
		mes "他会给你一个任务。";
		mes "有问题就问他。";
		next;
		mes "[Boya]";
		mes "你为什么盯着我？";
		mes "我们很久没见了，所以我才想不起他的名字！";
		next;
		mes "[Boya]";
		mes "总之……";
		mes "那里离这里不远，快点回来。";
		mes "好，愿祝福与你同在～！！";
		para_suv01 = 17;
		setquest 7142;
		close;
	}
	return;
S_Quest3:
	if (BaseLevel < 50) {
		mes "你已经进行到课程 A 的第三步。";
		mes "这门课程叫“征服兽人村落！”。";
		mes "让我看看……";
		next;
		mes "[Boya]";
		mes "穿过普隆德拉城门一直向西走。兽人村就在那个方向。";
		mes "或者从吉芬西门出去，继续向东南方向走……";
		next;
		mes "[Boya]";
		mes "嗯。兽人村有派驻的卡普拉职员，你可以使用卡普拉服务……";
		mes "由你决定。";
		next;
		mes "[Boya]";
		mes "我们的一名派驻成员正在卡普拉职员附近的建筑里等你。";
		next;
		mes "[Boya]";
		mes "她会说明在那里需要做什么。";
		mes "有问题就问她。";
		next;
		mes "[Boya]";
		mes "好，愿芙蕾雅祝福你！";
		para_suv01 = 24;
		setquest 7147;
	}
	else if (BaseLevel < 60) {
		mes "你已经进行到课程 B 的第三步。";
		mes "这门课程叫“征服兽人地下城！”。";
		mes "这是最适合你当前等级的任务。";
		next;
		mes "[Boya]";
		mes "穿过普隆德拉城门一直向西走。兽人村就在那个方向。";
		mes "或者从吉芬西门出去，继续向东南方向走……";
		next;
		mes "[Boya]";
		mes "嗯。兽人村有派驻的卡普拉职员，你可以使用卡普拉服务……";
		mes "由你决定。";
		next;
		mes "[Boya]";
		mes "我们的一名派驻成员正在卡普拉职员附近的建筑里等你。";
		next;
		mes "[Boya]";
		mes "她会说明在那里需要做什么。";
		mes "有问题就问她。";
		next;
		mes "[Boya]";
		mes "好，愿芙蕾雅祝福你！";
		para_suv01 = 29;
		setquest 7152;
	}
	else {
		mes "这是最后一步。";
		mes "这门课程叫“征服海洋之城！”。";
		mes "我不知道它是否适合你，但总之这是训练的最后一门课程。";
		next;
		mes "[Boya]";
		mes "先从伊兹鲁德乘船前往巴亚兰岛！";
		mes "那里有地下洞穴。进去后到达最底层，你会找到一座历史悠久的海底城市……";
		next;
		mes "[Boya]";
		mes "虽然在水下，但你可以呼吸，不用担心。";
		mes "海洋之城入口附近有一名派驻学员。";
		next;
		mes "[Boya]";
		mes "告诉他是我派你来的，并按照他的指引行动。";
		mes "好，愿芙蕾雅祝福你！";
		para_suv01 = 33;
		setquest 7156;
	}
	close;
}

moc_fild11,180,253,5	script	Talking Dog#para03	972,{
	if (para_suv01 == 1) {
		mes "[Talking Dog]";
		mes "呜啊啊啊。";
		mes "呜噜噜噜。";
		mes "汪汪……";
		next;
		mes "[Talking Dog]";
		mes "怎么了？";
		mes "原来是你！";
		mes "伊甸园集团的成员。";
		mes "你是来给我送饭的吗？我不喜欢饮料。";
		next;
		switch (select("Boya 真完美。:Boya 真棒。:Boya 真温柔。")) {
		case 1:
			mes "[Talking Dog]";
			mes "呃……";
			mes "你在说什么。";
			close;
		case 2:
			mes "[Talking Dog]";
			mes "啊……嗯……";
			mes "天啊，你是来参加训练的吗？";
			mes "既然 Boya 派你来，你应该知道这是战斗训练。";
			mes "汪呜……";
			next;
			mes "[Talking Dog]";
			mes "那么，我要开始更彻底地确保绿洲安全吗？";
			mes "你看到飞翔的秃鹰了吗？";
			next;
			mes "[Talking Dog]";
			mes "你能帮我把它们赶走吗？";
			mes "这样人们就能更安全、更舒适地使用绿洲。";
			next;
			mes "[Talking Dog]";
			mes "我们至少要猎杀 10 只秃鹰，好吗？";
			mes "我要睡一会儿。";
			mes "呼噜噜，呜，汪……";
			set para_suv01,2;
			changequest 7128,7129;
			close;
		case 3:
			mes "[Talking Dog]";
			mes "你还好吗？";
			mes "你以前没见过会说话的狗吗？";
			mes "你在说什么？";
			close;
		}
	}
	if (para_suv01 == 2) {
		if (checkquest(7129,HUNTING) == 2) {
			mes "[Talking Dog]";
			mes "呜哦……";
			mes "太好了！";
			mes "我能从你身上感受到青春。";
			next;
			mes "[Talking Dog]";
			mes "算了。";
			mes "我们找下一个目标吧，呵呵！";
			mes "好。我们把沙漠狼赶出去。";
			next;
			mes "[Talking Dog]";
			mes "它们长大后会变得危险。";
			mes "......";
			next;
			mes "[Talking Dog]";
			mes "为什么，为什么要那样看我？";
			mes "它们是狼，而我是一只善良的狗。";
			mes "但我并不是一生都是狗。";
			next;
			mes "[Talking Dog]";
			mes "我会让你知道，完全不必可怜我。";
			next;
			mes "[Talking Dog]";
			mes "它们到处撒尿，毫无羞耻。";
			mes "长大后只会摇尾巴，还毫不在意地咬人！";
			next;
			mes "[Talking Dog]";
			mes "你至少要猎杀 10 只！";
			mes "正好 10 只！";
			mes "去吧去吧去吧！";
			set para_suv01,3;
			changequest 7129,7130;
			close;
		}
		mes "[Talking Dog]";
		mes "首先追踪那只秃头又吵闹的鸟。";
		mes "没错，秃鹰。";
		mes "猎杀 10 只秃鹰。看起来很简单，对吧？";
		mes "哦，如果你累了，我会帮助你。";
		next;
		mes "- 狗叫时，你的 HP 和 SP 恢复了。-";
		npcskill "AL_HEAL",11,99,60;
		percentheal 100,100;
		close;
	}
	if (para_suv01 == 3) {
		if (checkquest(7130,HUNTING) == 2) {
			mes "[Talking Dog]";
			mes "你真完美。";
			next;
			mes "[Talking Dog]";
			mes "也许不是。嘿嘿，总之谢谢你的帮助。";
			mes "绿洲现在基本安全了。";
			mes "好，这是最后一步！";
			next;
			mes "[Talking Dog]";
			mes "有一种讨厌的怪物藏在沙中，突然出现给人下毒。";
			next;
			mes "[Talking Dog]";
			mes "美丽的东西往往带着毒，但这种毒真的会杀人。";
			mes "猎杀被称为沙漠之毒的蝎子！";
			next;
			mes "[Talking Dog]";
			mes "这是最后一步，所以简单点吧";
			mes "只要猎杀 5 只！";
			mes "汪汪！";
			set para_suv01,4;
			changequest 7130,7131;
			close;
		}
		mes "[Talking Dog]";
		mes "我不想让你表现出怜悯。";
		mes "我是一只拥有金子般心灵的狗。";
		next;
		mes "[Talking Dog]";
		mes "猎杀 10 只沙漠狼后再回来。";
		mes "哦，如果你累了，我会帮助你。";
		next;
		mes "- 狗叫时，你的 HP 和 SP 恢复了。-";
		npcskill "AL_HEAL",11,99,60;
		percentheal 100,100;
		close;
	}
	if (para_suv01 == 4) {
		if (checkquest(7131,HUNTING) == 2) {
			mes "[Talking Dog]";
			mes "嗯。非常好。";
			mes "你太厉害了！";
			next;
			mes "[Talking Dog]";
			mes "多亏你的努力，绿洲安全了。";
			mes "别东张西望！";
			mes "我说安全就是安全！";
			mes "呜呜呜啊！";
			next;
			mes "[Talking Dog]";
			mes "这里，这里，这里。";
			mes "如果我继续挖，也许能找到蝎子，但";
			mes "这样绿洲肯定会更安全。";
			next;
			mes "[Talking Dog]";
			mes "你可以为自己感到自豪和自信，并尽力而为。";
			mes "多亏你的帮助，我才能舒适地休息。";
			next;
			mes "[Talking Dog]";
			mes "你帮助征服了沙漠，";
			mes "并通过了初心者训练步骤，所以我要跺脚庆祝。";
			mes "呼噜噜噜噜。哈。";
			next;
			mes "[Talking Dog]";
			mes "回到伊甸园集团总部，把它展示给那位华丽的符文骑士。";
			mes "让我再说一次，你很棒！";
			mes "呜哦哦哦～";
			set para_suv01,5;
			changequest 7131,7132;
			close;
		}
		mes "[Talking Dog]";
		mes "我们只猎杀 5 只蝎子。";
		mes "这样绿洲就能恢复和平。";
		next;
		mes "[Talking Dog]";
		mes "我打盹时它们就不会再咬我的尾巴了。";
		mes "因为他的错误，我的脚也不会受伤了。";
		next;
		mes "[Talking Dog]";
		mes "你可以战斗。";
		mes "我可以更舒服地休息。";
		mes "其他人也会更安全。";
		next;
		mes "[Talking Dog]";
		mes "所有人都会对伊甸园集团留下好印象。";
		mes "哦，如果你累了，我会帮助你。";
		next;
		mes "- 狗叫时，你的 HP 和 SP 恢复了。-";
		npcskill "AL_HEAL",11,99,60;
		percentheal 100,100;
		close;
	}
	if (para_suv01 == 5) {
		mes "[Talking Dog]";
		mes "喵呜呜呜。";
		mes "哎呀……";
		next;
		mes "[Talking Dog]";
		mes "你为什么还在这里？";
		mes "你已经完成这里的任务了。";
		mes "呜哦哦，汪汪。";
		close;
	}
	if (para_suv01 > 5) {
		mes "[Talking Dog]";
		mes "嘿，伙计～怎么了？";
		mes "符文骑士怎么样？";
		mes "呼噜噜……";
		mes "呼克呼克……";
		next;
		mes "[Talking Dog]";
		mes "伊甸园集团很酷。";
		mes "他们真是很棒的集团。";
		mes "他们接纳了一只流浪的会说话的狗。";
		mes "保重，祝你好运。";
		close;
	}
	mes "嘿，看。";
	mes "我是一只会说话的狗。";
	mes "不是狼。";
	mes "我原本不是狗……";
	next;
	if (callfunc("F_HasEdenGroupMark")) {
		mes "[Talking Dog]";
		mes "总之，你是伊甸园集团成员吗？";
		mes "哦，很高兴见到你。";
		mes "我也是伊甸园集团成员。";
		mes "保重，祝你好运。";
		close;
	}
	mes "[Talking Dog]";
	mes "你为什么那样看我？";
	mes "......";
	close;
}

prt_sewb1,131,262,3	script	Timid Cat#para04	422,{
	if (para_suv01 < 6) {
		mes "[Timid Cat]";
		mes "喵……";
		mes "你是谁，喵？";
		mes "你为什么在这里，喵？";
		close;
	}
	if (para_suv01 == 6) {
		mes "[Timid Cat]";
		mes "来吧，喵……";
		mes "我也许站在这里这样和你说话，喵，但我仍然是一只猫，喵……";
		next;
		mes "[Timid Cat]";
		mes "亲爱的人类，你是";
		mes "我的同伴吗？";
		mes "真……真的吗……！";
		mes "亲爱的，Boya 的帮助就像巨人一样，而且……";
		next;
		switch (select("美味秋刀鱼:新鲜鲭鱼:漂亮金枪鱼")) {
		case 1:
			mes "[Timid Cat]";
			mes "又大又漂亮的秋刀鱼……";
			mes "我很害羞。";
			close;
		case 2:
			mes "[Timid Cat]";
			mes "我想吃鲭鱼。";
			mes "又大又新鲜的鲭鱼在哪里，喵？";
			close;
		case 3:
			mes "[Timid Cat]";
			mes "你知道又大又漂亮的金枪鱼吗？";
			mes "亲爱的，Boya 肯定是派你来的。";
			mes "我该怎么解释呢……？";
			next;
			mes "[Timid Cat]";
			mes "刚才有什么东西从我脚下经过吗，喵？";
			mes "你想杀猫吗？";
			mes "这里的环境太糟糕了。";
			next;
			mes "[Timid Cat]";
			mes "总之，我正在完成分配给我的工作。";
			mes "所以，嗨，你好，欢迎。";
			next;
			mes "[Timid Cat]";
			mes "你是来这里战斗的吗？";
			mes "快去猎杀那些盗虫！";
			mes "至少猎杀 10 只！";
			mes "喵呜！";
			next;
			mes "[Timid Cat]";
			mes "我真的不喜欢那些讨厌的爬虫……";
			mes "喵～！";
			next;
			mes "^4d4dffThe cat was suprised by";
			mes "一只盗虫，然后冻结在";
			mes "原地。猎杀这里的";
			mes "盗虫。^000000";
			set para_suv01,7;
			changequest 7133,7134;
			close;
		}
	}
	if (para_suv01 == 7) {
		if (checkquest(7134,HUNTING) == 2) {
			mes "[Timid Cat]";
			mes "现在明白肮脏潮湿的下水道了吗？";
			mes "咦，喵，看看接下来是什么。";
			next;
			mes "[Timid Cat]";
			mes "那是盗虫旁边的污垢象征。";
			mes "猎杀一些塔鲁，让下水道更干净。";
			next;
			mes "[Timid Cat]";
			mes "为了参加这项任务的成员。";
			mes "猎杀 10 只塔鲁。";
			mes "很简单，对吧？";
			next;
			mes "[Timid Cat]";
			mes "我怎么没早点问你？呵呵……？？";
			mes "嗯……";
			mes "因为这只是训练任务。";
			next;
			mes "[Timid Cat]";
			mes "训练任务又困难又烦人。";
			mes "所以快去猎杀 10 只塔鲁。";
			set para_suv01,8;
			changequest 7134,7135;
			close;
		}
		mes "[Timid Cat]";
		mes "清理下水道。第一步是猎杀盗虫。";
		mes "很简单，对吧，喵？";
		next;
		mes "[Timid Cat]";
		mes "注意查看地图，别迷路。";
		mes "这是服务，喵呜。";
		npcskill "AL_HEAL",11,99,60;
		percentheal 100,100;
		close;
	}
	if (para_suv01 == 8) {
		if (checkquest(7135,HUNTING) == 2) {
			mes "[Timid Cat]";
			mes "干得好～！";
			mes "你是怎么消灭那些肮脏的盗虫和塔鲁的？你真勇敢。";
			next;
			mes "[Timid Cat]";
			mes "鼓起勇气吧，我要把你送去面对更强的对手。";
			mes "但首先为了测试你的勇气，猎杀吸血蝙蝠。";
			next;
			mes "[Timid Cat]";
			mes "吸血蝙蝠会咬你，小心。";
			mes "它们很凶。";
			mes "它们让我害怕，所以猎杀 5 只就够了。";
			next;
			mes "[Timid Cat]";
			mes "这样就能证明你很勇敢。";
			mes "喵～！";
			next;
			mes "[Timid Cat]";
			mes "我什么都没有……";
			mes "......";
			mes "你想要什么，喵？吸血蝙蝠正等着和你战斗，快点行动～！";
			set para_suv01,9;
			changequest 7135,7136;
			close;
		}
		mes "[Timid Cat]";
		mes "如果你杀不死塔鲁，可能会染上各种肮脏的疾病。";
		mes "所以为自己感到自豪，尽力杀死它们。";
		next;
		mes "[Timid Cat]";
		mes "我会稍微帮你一下。";
		mes "来，我恢复了你的体力，喵……";
		npcskill "AL_HEAL",11,99,60;
		percentheal 100,100;
		close;
	}
	if (para_suv01 == 9) {
		if (checkquest(7136,HUNTING) == 2) {
			mes "[Timid Cat]";
			mes "你真棒，喵～";
			mes "你这么快就杀死它们了！";
			mes "喵……";
			next;
			mes "[Timid Cat]";
			mes "现在你完全不怕虫子和塔鲁了。";
			mes "谢谢你参加“征服下水道”训练任务。";
			next;
			mes "[Timid Cat]";
			mes "现在回总部，找 Boya 教官确认他是否有漂亮的金枪鱼……";
			mes "我会在这里等你。";
			next;
			mes "[Timid Cat]";
			mes "你知道怎么去伊甸园集团总部吗？";
			mes "普隆德拉是离这里最近的城市。";
			mes "去普隆德拉找伊甸园集团传送员。";
			set para_suv01,10;
			changequest 7136,7137;
			close;
		}

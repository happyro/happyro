		mes "科学的卓越";
		mes "对那些只相信";
		mes "神秘学的人来说……";
		next;
		mes "[?]";
		mes "我想利用";
		mes "魔法的力量作为合理形式";
		mes "而且是可见的。凭借更强的";
		mes "成果，我想用科学";
		mes "控制魔法的力量，";
		mes "通过科学……";
		next;
		mes "[?]";
		mes "我想证明科学";
		mes "非常适合控制魔法，";
		mes "就像控制神秘学。我研究了很多";
		mes "东西，并苦恼于让";
		mes "科学与魔法";
		mes "共存。";
		next;
		mes "[?]";
		mes "我的研究把我带到这里，";
		mes "朱彼洛斯。这里有";
		mes "许多科学产物，";
		mes "足以刺激学者的";
		mes "头脑……";
		next;
		mes "[?]";
		mes "我发现魔法的力量可以与科学结合。";
		mes "虽然并不完美，但已经足以吸引其他学者……";
		next;
		mes "[?]";
		mes "近期世界发生的事件造成混乱，所以我的研究还没能与世人分享。";
		next;
		set job__mechanic,6;
		changequest 10094,10095;
		mes "[?]";
		mes "所以……我回到朱彼洛斯，继续研究科学与魔法。";
		close;
	}
	end;
}

jupe_core2,242,62,3	script	Ghostfire#3	802,{
	mes "[?]";
	if (job__mechanic > 6) {
		mes "我想进一步了解知识……";
		mes "人类的特征……";
		mes "先做什么、后做什么……";
		mes "真理之门稍后……";
		close;
	} else if (job__mechanic == 6) {
		mes "有才能的人。";
		mes "确认周围";
		mes "没有敌人。";
		mes "如果你专注于我，";
		mes "可能会遭到攻击。";
		next;
		if(select("那就以后再说:专注") == 1) close;
		mes "[?]";
		mes "我对自己的成果不满意，所以一次又一次回到这里。";
		next;
		mes "[?]";
		mes "当我踏上这座雕像的基座时，收集并学到的能量被吸收了。";
		next;
		mes "[?]";
		mes "但是随着能量被吸收，我开始获得以前从未知道的知识。";
		next;
		mes "[?]";
		mes "但这需要付出代价。随着知识增加，我开始失去人性。";
		mes "我失去了身体，只剩下灵魂。";
		next;
		mes "[?]";
		mes "我不后悔获得知识。我唯一的愿望是找回身体。";
		next;
		set job__mechanic,7;
		changequest 10095,10096;
		mes "[?]";
		mes "把能量注入雕像后，我发现可以将能量转移到不同雕像。";
		close;
	}
	end;
}


jupe_core2,288,142,3	script	#Door	844,1,1,{
	end;
OnInit:
OnDisable:
	disablenpc "#Door";
	end;
OnEnable:
	enablenpc "#Door";
	specialeffect EF_MAPPILLAR;
	initnpctimer;
	end;
OnTimer180000:
	donpcevent "#Door::OnDisable";
	end;
OnTouch_:
	mes "-声音再次响起-";
	mes "-在我的脑中。这一次是-";
	mes "-不同于之前的-";
	mes "-威严之人的声音。-";
	next;
	mes "我知道你来到这里，是因为渴望知识。";
	mes "人类是脆弱的动物，";
	mes "做出任何牺牲都是艰难的";
	mes "决定。";
	next;
	mes "但你还缺少通过这扇真理之门的东西。";
	mes "门后是超越人类思维的知识。";
	next;
	mes "只要不超过你的脑容量，就不会伤害人类的心智。";
	next;
	mes "试着把身体放在南边的知识基座上。";
	next;
	mes "如果知识适合你，就能获得它而不成为祭品。";
	mes "如果你不合格，就会失去身体成为祭品。";
	next;
	mes "合格后，你就能通过真理之门。";
	mes "在那之前，不要迷失自我。";
	next;
	mes "............";
	next;
	mes "-我再也听不到-";
	mes "-任何声音，也感觉不到-";
	mes "-这个地方的一切。-";
	next;
	mes "-按照脑中回响的声音-";
	mes "-的指示，去-";
	mes "-南边的基座。-";
	close2;
	set job__mechanic,9;
	changequest 10098,10099;
	donpcevent "#Door::OnDisable";
	end;
}


	setcell "iz_ac02",58,130,63,132,cell_icewall,1;
	end;

OnReset:
	killmonster strnpcinfo(4),"#"+strnpcinfo(2)+"::OnMyMobDead";
	donpcevent "#"+strnpcinfo(2)+"::OnSpawn";
	end;

OnMyMobDead:
	.@dead_num = mobcount(""+strnpcinfo(4)+"", "#"+strnpcinfo(2)+"::OnMyMobDead");
	if (.@dead_num < 1)
		initnpctimer;
	end;

OnTimer5000:	// custom timer (there is officially no respawn delay)
	stopnpctimer;
	donpcevent "#"+strnpcinfo(2)+"::OnSpawn";
	end;

OnSpawn:
	monster strnpcinfo(4),59,131,"Poring",1725,1,"#"+strnpcinfo(2)+"::OnMyMobDead";
	monster strnpcinfo(4),60,131,"Poring",1725,1,"#"+strnpcinfo(2)+"::OnMyMobDead";
	monster strnpcinfo(4),61,131,"Poring",1725,1,"#"+strnpcinfo(2)+"::OnMyMobDead";
	monster strnpcinfo(4),62,131,"Poring",1725,1,"#"+strnpcinfo(2)+"::OnMyMobDead";
	end;
}

iz_ac02_a,1,1,0	duplicate(#nbacStone03)	#nbacStone03_a	CLEAR_NPC
iz_ac02_b,1,1,0	duplicate(#nbacStone03)	#nbacStone03_b	CLEAR_NPC
iz_ac02_c,1,1,0	duplicate(#nbacStone03)	#nbacStone03_c	CLEAR_NPC
iz_ac02_d,1,1,0	duplicate(#nbacStone03)	#nbacStone03_d	CLEAR_NPC

// =============================================================================
// = Acolyte
// =============================================================================

// - Acolyte Leader Alice
// -----------------------------------------------------------------------------
iz_ac02,156,169,5	script	Acolyte Leader Alice#2	4_F_ACOLYTE,{
	if (isbegin_quest(4269) < 1) {
		mes "[Alice Yisha]";
		mes "你已经^ff0000在克里图拉学院登记^000000了吗？";
		mes "你可以在^ff0000克里图拉学院信息中心^000000登记。";
		cutin "acact_03.bmp", 2;
		next;
		mes "[Alice Yisha]";
		mes "虽然很麻烦……但你需要登记，才能获得^ff0000克里图拉学院的大量教育和服务^000000。";
		cutin "acact_01.bmp", 2;
		close2;
		cutin "", 255;
		end;
	} else {
		if (isbegin_quest(11343) == 0) {
			mes "[Alice Yisha]";
			mes "哦，奥丁！";
			mes "很高兴见到你。";
			mes "我是 Alice Yisha，^ff0000负责服事职业^000000。";
			cutin "acact_01.bmp", 2;
			setquest 11343;
			completequest 11343;
			next;
		} else {
			mes "[Alice Yisha]";
			mes "欢迎～";
			mes "很高兴再次见到你。";
			cutin "acact_01.bmp", 2;
			if (isbegin_quest(11343) == 1)
				completequest 11343;
			next;
		}
		if (Class == Job_Novice) {
			mes "[Alice Yisha]";
			mes "如果你没有选择服事作为职业，不如多了解一下？";
			cutin "acact_01.bmp", 2;
			next;
			.@menu$ = "What is an Acolyte?:Battle Acolyte:Support Acolyte:Change job class to Acolyte.:End Conversation";
		} else {
			mes "[Alice Yisha]";
			mes "我想你已经不需要我的帮助了。";
			mes "你对服事有什么疑问吗？";
			cutin "acact_03.bmp", 2;
			next;
			.@menu$ = "What is an Acolyte?:Battle Acolyte:Support Acolyte::End Conversation";
		}
		switch(select(.@menu$)) {
			case 1:
				mes "[Alice Yisha]";
				mes "服事侍奉^ff0000奥丁^000000，能够按照奥丁的意志使用^ff0000神圣技能^000000。";
				cutin "acact_02.bmp", 2;
				next;
				mes "[Alice Yisha]";
				mes "大多数技能都以^ff0000治疗或辅助为目的^000000，因此服事是^ff0000组队狩猎^000000中非常重要的职业。";
				cutin "acact_03.bmp", 2;
				next;
				mes "[Alice Yisha]";
				mes "这是一个^ff0000混合型职业^000000，攻击类型会随提升的属性而改变；但由于宗教原因不使用致命武器，武器范围较窄。";
				close2;
				cutin "", 255;
				end;
			case 2:
				mes "[Alice Yisha]";
				mes "服事分为^ff0000辅助型^000000和^ff0000物理攻击型^000000。";
				next;
				switch(select("辅助型", "攻击型", "停止。")) {
				case 1:
					mes "[Alice Yisha]";
					mes "^ff0000INT^000000是^ff0000辅助型服事^000000的重要属性。";
					mes "^ff0000INT^000000会增强^ff0000治疗效果^000000并提升使用技能所需的^ff0000SP^000000。";
					mes "它也有助于^ff0000SP 恢复^000000。";
					cutin "acact_02.bmp", 2;
					next;
					mes "[Alice Yisha]";
					mes "但辅助型服事也有弱点，例如^ff0000难以独自狩猎^000000。";
					mes "所以需要和^ff0000队伍^000000一起狩猎，或对^ff0000火属性^000000怪物使用^ff0000治愈术^000000。";
					next;
					mes "[Alice Yisha]";
					mes "也就是说，带有神圣力量的^ff0000治愈术对火属性不死怪物是致命的^000000。";
					cutin "acact_01.bmp", 2;
					close2;
					cutin "", 255;
					end;
				case 2:
					mes "[Alice Yisha]";
					mes "^ff0000物理攻击型^000000服事的重要属性是^ff0000STR、VIT、AGI、DEX^000000。";
					mes "这些属性看起来比辅助型复杂，但其实很简单。";
					cutin "acact_02.bmp", 2;
					next;
					mes "[Alice Yisha]";
					mes "^ff0000STR 提升力量和攻击力，VIT 提升物理能力，AGI 提升攻击速度和闪避，DEX 提升命中率和技能咏唱速度。";
					cutin "acact_01.bmp", 2;
					next;
					mes "[Alice Yisha]";
					mes "对于^ff0000攻击型^000000角色，^ff0000DEX^000000是最重要的属性……对吧？";
					mes "如果攻击无法命中敌人，攻击就没有意义。";
					mes "你可以根据自己的风格提升 STR、VIT、AGI。";
					next;
					mes "[Alice Yisha]";
					mes "你可能会认为服事没有攻击型技能，实力不够强；但它可以使用辅助技能，随意强化自身能力，帮助你稳定狩猎。";
					close2;
					cutin "", 255;
					end;
				case 3:
					mes "[Alice Yisha]";
					mes "还有问题的话尽管问我。";
					close2;
					cutin "", 255;
					end;
				}
			case 3:
				mes "[Alice Yisha]";
				mes "服事拥有许多技能。";
				mes "这些技能都很有用。";
				next;
				mes "[Alice Yisha]";
				mes "^ff0000治愈术^000000用于治疗伤口，也可攻击相反属性的不死怪物。";
				mes "提升与^ff0000速度^000000相关的能力，并使用^ff0000[速度激发]^000000提升^ff0000移动速度^000000";
				mes "^ff0000[天使之赐福]^000000可以同时^ff0000提升^000000^ff0000STR、INT、DEX^000000。";
				next;
				mes "[Alice Yisha]";
				mes "^ff0000[瞬间移动]^000000可以^ff0000移动^000000到其他地点。";
				mes "^ff0000[传送之阵]^000000可以打开通往^ff0000记忆地点^000000的门。";
				mes "此外还有更多技能。";
				next;
				mes "[Alice Yisha]";
				mes "如果想体验服事技能，请向旁边的修女^ff0000询问^000000。";
				mes "现在我要介绍一项入门技能。";
				emotion ET_HUK, getnpcid(0, "A Nun#"+strnpcinfo(2));
				close2;
				cutin "", 255;
				end;
			case 4:
				mes "[Alice Yisha]";
				mes "哦，天哪！";
				mes "所以……你决定成为服事了吗？";
				mes "奥丁欢迎你。";
				cutin "acact_02.bmp", 2;
				next;
				mes "[Alice Yisha]";
				mes "你真的想成为神的仆人吗？";
				mes "让我看看你是否准备好了……嗯……";
				next;
				if (BaseLevel > 14) {
					mes "[Alice Yisha]";
					mes "请前往^ff0000普隆德拉^000000^ff0000东北角^000000的教堂拜访^ff0000Mareusis 神父^000000。";
					mes "达到^ff0000Job 等级 10^000000后即可加入神职。";
					cutin "acact_01.bmp", 2;
					close2;
					cutin "", 255;
					end;
				} else if (JobLevel < 10) {
					mes "[Alice Yisha]";
					mes "天哪？！你还没完成基础训练？！你还有很长的路要走！提升 Job 等级后再来吧！";
					close2;
					cutin "", 255;
					end;
				} else {
					mes "[Alice Yisha]";
					mes "太好了！我会把你转交给普隆德拉当地的神职部门。";
					mes "^ff0000请前往普隆德拉东北角教堂拜访 Mareusis 神父。^000000";
					mes "达到^ff0000Job 等级 10^000000后即可加入神职。";
					cutin "acact_01.bmp", 2;
					next;
					if (select("前往普隆德拉南边的原野", "结束对话") == 2) {
						mes "[Alice Yisha]";
						mes "还有问题的话尽管问我。";
						close2;
						cutin "", 255;
						end;
					}
					mes "[Alice Yisha]";
					mes "很好，祝你好运～";
					mes "我们走吧～";
					close2;
					cutin "", 255;
					warp "prt_fild08", 170, 369;
					end;
				}
			case 5:
				mes "[Alice Yisha]";
				mes "还有问题的话尽管问我。";
				close2;
				cutin "", 255;
				end;
		}
	}
}

iz_ac02_a,156,169,5	duplicate(Acolyte Leader Alice#2)	Acolyte Leader Alice#2_a	4_F_ACOLYTE
iz_ac02_b,156,169,5	duplicate(Acolyte Leader Alice#2)	Acolyte Leader Alice#2_b	4_F_ACOLYTE
iz_ac02_c,156,169,5	duplicate(Acolyte Leader Alice#2)	Acolyte Leader Alice#2_c	4_F_ACOLYTE
iz_ac02_d,156,169,5	duplicate(Acolyte Leader Alice#2)	Acolyte Leader Alice#2_d	4_F_ACOLYTE

// - A nun
// -----------------------------------------------------------------------------
iz_ac02,152,165,5	script	A Nun#2	4_F_SISTER,{
	if (JobLevel > 10 || Class != Job_Novice) {
		mes "[A nun]";
		mes "哇……这所学院真了不起？";
		mes "我以前训练时，这里可不是这样的。";
		close;
	} else {
		if (!checkweight(1119,3)) {
			mes "- You have too many items. Clear inventory and try again. -";
			close;
		}
		if (!isbegin_quest(4269)) {
			mes "[A nun]";
			mes "哇……这所学院真了不起？";
			mes "我以前训练时，这里可不是这样的。";
			next;
			mes "[A nun]";
			mes "你可以在^ff0000克里图拉学院信息中心^000000^ff0000登记^000000，这会很有帮助。";
			close;
		} else {
			mes "[A nun]";
			mes "咳……～";
			mes "你是谁？";
			mes "你对这个^ff0000入门课程^000000感兴趣吗？";
			next;
			mes "[A nun]";
			mes "这本入门手册很神奇！它可以^ff0000使用几项服事技能^000000。";
			mes "你要借用它吗？";
			next;
			if (select("参加服事课程。", "停止。") == 2) {
				mes "[A nun]";
				mes "嗯……如果你没兴趣……那就算了。";
				mes "喃喃自语";
				close;
			}
			if (isequippedcnt(2821) > 0 || countitem(2821) > 0) {
				mes "[A nun]";
				mes "你已经有一本了。";
				mes "我们不会给你两本。";
				close;
			} else {
				mes "[A nun]";
				mes "那么，好好使用它吧。";
				mes "^ff0000Equip (double click or drag to equipment window)^000000 and open the ^ff0000skill window(Alt+S)^000000 to see the skills in manual.";
				getitem 2821,1;// Acolyte_Manual
				close;
			}
		}
	}
}

iz_ac02_a,152,165,5	duplicate(A Nun#2)	A Nun#2_a	4_F_SISTER
iz_ac02_b,152,165,5	duplicate(A Nun#2)	A Nun#2_b	4_F_SISTER
iz_ac02_c,152,165,5	duplicate(A Nun#2)	A Nun#2_c	4_F_SISTER
iz_ac02_d,152,165,5	duplicate(A Nun#2)	A Nun#2_d	4_F_SISTER

// =============================================================================
// = Ninja
// =============================================================================

// - Ninja Guide (Ko Ori)
// - Teaches the player about the Ninja class.
// -----------------------------------------------------------------------------
iz_ac02,140,139,5	script	Ninja Guide#ac	4_M_NINJA_BLUE,{
	cutin "aca_ninja_k.bmp", 2;
	if (Class != Job_Novice) {
		if (Upper != 0) {
			mes "[Ninja Guide]";
			mes "我不想和你说话。现在离开……";
			close2;
			cutin "", 255;
			end;
		} else {
			if (Class == Job_Ninja) {
				if (!isbegin_quest(4268)) {
					mes "[Ninja Guide]";
					mes "如果你想接受忍者训练，就去找 Hono O，他在你转职房间旁边的房间里。";
					setquest 4268;
					close2;
					cutin "", 255;
					end;
				} else if (isbegin_quest(4268) == 1) {
					mes "[Ko Ori]";
					mes "如果你想接受忍者训练，就去找 Hono O，他在你转职房间旁边的房间里。";
					close2;
					cutin "", 255;
					end;
				} else {
					mes "[Ko Ori]";
					mes "感觉怎么样？";
					mes "虽然他很直率，但他非常关心新人。";
					close2;
					cutin "", 255;
					end;
				}
			} else {
				mes "[Ninja Guide]";
				mes "我是为新人指引忍者之道的人。";
				next;
				mes "[Ninja Guide]";
				mes "我对已经走上自己道路的人不感兴趣。";
				mes "现在请离开……";
				close2;
				cutin "", 255;
				end;
			}
		}
	} else {
		if (Upper == 2) {
			mes "[Ninja Guide]";
			mes "孩子无法接受忍者的生活。";
			mes "这样的生活并不容易胜任，所以不要感到遗憾……";
			close2;
			cutin "", 255;
			end;
		}
		if (isbegin_quest(4269) != 2) {
			mes "[Ninja Guide]";
			mes "首先，你必须在学院^ff0000登记^000000，然后再来找我。";
			mes "一切都必须遵循正确的流程，笨拙不能成为借口。";
			close2;
			cutin "", 255;
			end;
		}
		mes "[Ninja Guide]";
		mes "嗯。来了一位新的初学者啊？";
		mes "你为什么来这里？";
		next;
		switch(select("忍者说明。", "我决定成为忍者。", "我没事要来这里。")) {
		case 1:
			while(1) {
				mes "[Ninja Guide]";
				mes "想成为忍者的初学者……";
				mes "有什么好奇的就问我。";
				next;
				switch(select("成为忍者后我能做什么？", "成为忍者需要什么条件？", "我想体验忍者技能。", "我对忍者没有疑问。")) {
				case 1:
					mes "[Ninja Guide]";
					mes "忍者可以在潜行时发动攻击，造成最大伤害。";
					mes "忍者拥有各种欺敌技能，非常适合单人行动。";
					next;
					mes "[Ninja Guide]";
					mes "你不仅能学习类似魔法的忍术，还能直接攻击、造成暴击伤害或向敌人投掷飞刀。";
					next;
					mes "[Ninja Guide]";
					mes "没有足够的装备，你无法完美做到这些。";
					mes "如果被击中，你会比其他人承受更多伤害。";
					next;
					mes "[Ninja Guide]";
					mes "因此，如果一个还不了解这个世界的人不加考虑地选择这个职业，就会遭遇失败。";
					next;
					break;
				case 2:
					mes "[Ninja Guide]";
					mes "忍者可以学习多种不同的路线。";
					mes "每种路线都有优点和缺点。";
					mes "最好经过深思熟虑后自行决定。";
					next;
					mes "[Ninja Guide]";
					mes "有两个主要属性会影响伤害程度。";
					mes "一个是^ff0000力量^000000，另一个是^ff0000智力^000000，";
					mes "力量影响^8E2323物理攻击^000000和^8E2323投掷攻击^000000的伤害。";
					mes "智力影响^8E2323忍者技能^000000造成的伤害。";
					next;
					mes "[Ninja Guide]";
					mes "除此之外，你还可以学习";
					mes "其他属性，而不是从我们这样的专业教官那里学习";
					mes "而是向教授基础战斗技能的教官学习。";
					next;
					mes "[Ninja Guide]";
					mes "例如，要提高命中率，";
					mes "你应该怎么做？";
					mes "要提高防御力，你应该穿什么？等等……";
					next;
					break;
				case 3:
					if (countitem(2940) > 0) {
						mes "[Ninja Guide]";
						mes "你可以装备这本手册来体验一些技能。";
						mes "按 <Alt+S> 打开技能窗口，在 Misc 标签中找到这些技能。";
						next;
						mes "[Ninja Guide]";
						mes "学院楼下有一位会提供战场训练的教官。去见他并训练技能。";
						next;
						mes "[Ninja Guide]";
						mes "他会给你一些任务。使用手册帮助你战斗。";
						if (countitem(13295) < 10)
							getitem 13295,10;// Light_Shuriken
						next;
					} else {
						mes "[Ninja Guide]";
						mes "珍惜每一个有用的时刻。";
						mes "你可以装备这本手册来体验一些技能。";
						mes "按 <Alt+S> 打开技能窗口，在 Misc 标签中找到这些技能。";
						getitem 2940,1;// Ninja_Manual
						getitem 13295,10;// Light_Shuriken
						next;
						mes "[Ninja Guide]";
						mes "学院楼下有一位会提供战场训练的教官。去见他并训练技能。";
						next;
						mes "[Ninja Guide]";
						mes "他会给你一些任务。使用手册帮助你战斗。";
						next;
					}
					break;
				case 4:
					mes "[Ninja Guide]";
					mes "我说的你都明白了吗？";
					mes "就是这些……你没有问题了吗？";
					close2;
					cutin "", 255;
					end;
				}
			}
			break;
		case 2:
			if (!callfunc("F_CanChangeJob")) {
				mes "[Ninja Guide]";
				mes "我欣赏你的勇气，但首先你必须熟悉当前职业。";
				next;
				mes "[Ninja Guide]";
				mes "在你决定成为忍者之前，";
				mes "你需要达到初心者 Job 等级 9 后再回来。到那时我会接受你。";
				close2;
				cutin "", 255;
				end;
			} else {
				mes "[Ninja Guide]";
				mes "这可能是我最后的警告。";
				mes "成为忍者意味着过上艰苦的生活。";
				next;
				mes "[Ninja Guide]";
				mes "忍者不属于公会，因此初心者很容易获得这条道路。";
				mes "确保你的决定是最终决定！";
				next;
				if (select("我会重新考虑。", "我已经决定了。") == 1) {
					mes "[Ninja Guide]";
					mes "深思熟虑的行动通常会带来好结果。";
					close2;
					cutin "", 255;
					end;
				}
				mes "[Ninja Guide]";
				mes "既然你如此坚定，我只能带你去那里。";
				next;
				mes "[Ninja Guide]";
				mes "我会把你送到可以转职的地方附近。";
				next;
				mes "[Ninja Guide]";
				mes "我会给你一个特别提示。";
				mes "你要到达的是天津町。去空房子里寻找隐藏的通道。";
				next;
				mes "[Ninja Guide]";
				mes "在那里你会遇到带你成为忍者的人。";
				next;
				mes "[Ninja Guide]";
				mes "如果你在城里迷路，那就没办法了……成为忍者需要观察力。";
				next;
				mes "-Select ^ff0000Confirm^000000 to go to Amatsu.";
				cutin "", 255;
				next;

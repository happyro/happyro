mid_camp,66,122,55	script	Henry Clifford	712,{
	if (countitem(6049) > 0) {
		mes "[Henry Clifford]";
		mes "恭喜你，抓到了珍贵的旗鱼。";
		mes "我会用 2 点猫爪商队点数交换你的旗鱼。";
		next;
		mes "[Henry Clifford]";
		mes "这些点数是我从黑市商人那里弄来的，";
		mes "但我保证点数真实有效。";
		mes "你有兴趣吗？";
		next;
		switch(select("好的。:不用了，谢谢。")) {
		case 1:
			delitem 6049,1; //Marlin
			set ep13_yong1,ep13_yong1+2;
			mes "[Henry Clifford]";
			mes "谢谢你的旗鱼。";
			mes "这是给你的点数。";
			mes "你可以去猫爪代理商那里查看点数。";
			close;
		case 2:
			mes "[Henry Clifford]";
			mes "好吧，既然你这么说。";
			mes "改变主意的话，随时回来。";
			close;
		}
	}
	else {
		mes "[Henry Clifford]";
		mes "你可能已经听说过，";
		mes "不过这条河里充满了稀有鱼类。";
		mes "我跟着这些猫过来";
		mes "想确认传闻是否属实。";
		mes "所以才知道这里的情况。";
		next;
		mes "[Henry Clifford]";
		mes "传说中的银色旗鱼";
		mes "是最棒的猎物。";
		mes "你还可以抓到漂浮在河里的";
		mes "珍贵宝物。";
		next;
		mes "[Henry Clifford]";
		mes "如果你碰巧抓到旗鱼，";
		mes "请拿来和我交换。";
		mes "我会给你";
		mes "不错的回报。";
		close;
	}
}

mid_camp,88,100,55	script	Cat Paw Mining Agent	876,{
	if (checkquest(12062,PLAYTIME) == -1) {
		if ((countitem(6048) > 2) && (ep13_yong1 > 9)) {
			mes "[Cat Paw Mining Agent]";
			mes "哦，哇~";
			mes "谢谢你帮我收集矿物。";
			next;
			delitem 6048,3; //Unidentified_Mineral
			getexp (checkre(3))?20000:30000,0;
			setquest 12062;
			set ep13_yong1,ep13_yong1+1;
			select("我快冻僵了！快拿走吧。");
			mes "[Cat Paw Mining Agent]";
			mes "好的，好的~我收到矿物样本了。";
			mes "我现在就给你的信用点数加分。";
			close;
		}
		else {
			mes "[Cat Paw Mining Agent]";
			mes "要收集矿物，";
			mes "我们得去东边的";
			mes "冰冻大地。";
			mes "但对我这样的短毛猫来说，";
			mes "那里的天气";
			mes "实在难以忍受。";
			next;
			mes "[Cat Paw Mining Agent]";
			mes "如果明天天气";
			mes "不错，";
			mes "我也许会试着去，";
			mes "但今天不行。";
			mes "看起来你也觉得";
			mes "冷得刺骨，对吧？";
			close;
		}
	}
	else if ((checkquest(12062,PLAYTIME) == 0) || (checkquest(12062,PLAYTIME) == 1)) {
		mes "[Cat Paw Mining Agent]";
		mes "希望你明天还能带矿物给我……";
		mes "如果可以的话。等你帮忙总比我自己去那里好多了。";
		close;
	}
	else {
		erasequest 12062;
		mes "[Cat Paw Mining Agent]";
		mes "嗯……该收集矿物了。";
		mes "要不要帮我收集矿物？";
		close;
	}
}

-	script	Mysterious Rock#0::manukrock	-1,{
	if ((countitem(6048) < 3) && (checkquest(12062,PLAYTIME) == -1)) {
		specialeffect2 EF_REPAIRWEAPON;
		progressbar "ffff00",10;
		set .@rhea_ran,rand(1,20);
		if (.@rhea_ran < 13) getitem 7049,1; //Stone
		else if (.@rhea_ran == 13) getitem 990,1; //Boody_Red
		else if (.@rhea_ran == 14) getitem 991,1; //Crystal_Blue
		else if (.@rhea_ran == 15) getitem 992,1; //Wind_Of_Verdure
		else if (.@rhea_ran == 16) getitem 993,1; //Yellow_Live
		else getitem 6048,1; //Unidentified_Mineral
		initnpctimer;
		disablenpc();
		end;
	}
	else {
		mes "这块岩石里含有未鉴定的矿物。";
		mes "不能超过采集上限。";
		close;
	}
	end;

OnTimer120000:
	enablenpc();
	stopnpctimer;
	end;
}

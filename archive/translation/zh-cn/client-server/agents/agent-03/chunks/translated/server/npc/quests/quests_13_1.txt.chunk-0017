mid_campin,90,121,5	script	Hibba Agip	459,{
	cutin "ep13_captin_edq",2;
	set .@start,(ep13_newbs + ep13_ryu + mao_morocc2 + ep13_1_rhea + ep13_animal + ep13_start);
	if ((ep13_1_edq == 0) && (.@start > 115)) {
		mes "[Hibba Agip]";
		mes "*Sigh* Look at me, I used to command the desert of Morocc, but I've been deployed to a world that only God knows where...";
		next;
		mes "[Staff Officer Abidal]";
		mes "别这样，这不对。实际上，你以前只是小镇的官员，后来才晋升为远征队指挥官。";
		mes "你的成功几乎好得令人难以置信。";
		next;
		mes "[Instructor Igrid]";
		mes "喂，老大。我们能不能先敷衍过去，直到离开这里？这个所谓的灰烬真空太无聊了。对王国的学者来说是天堂，对我可不是。";
		next;
		mes "[Hibba Agip]";

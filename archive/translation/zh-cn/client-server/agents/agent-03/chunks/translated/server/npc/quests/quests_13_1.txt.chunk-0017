		next;
		mes "[Fluffy Gyaruk]";
		mes "唯一的区别是，我们的服务会根据客户的信用点数受到限制。";
		next;
		select("信用点数？");
		mes "[Fluffy Gyaruk]";
		mes "如你所知，我们是这片小众市场里勉强维持生计的小公司。";
		mes "我们迫切需要你的支持来发展。";
		next;
		mes "[Fluffy Gyaruk]";
		mes "你可以帮我们获取食物或收集矿物来提高信用点数。";
		next;
		mes "[Fluffy Gyaruk]";
		mes "信用点数越多，你能使用的服务就越多，还可以申请参加特别活动。";
		mes "怎么样？要不要和我们签订会员合同？";
		next;
		switch(select("好的。:我需要考虑一下。")) {
		case 1:
			mes "[Fluffy Gyaruk]";
			mes "太好了！感谢你加入猫爪商队会员服务。";
			mes "希望你能支持我们探索这片未知土地。";
			next;
			mes "[Fluffy Gyaruk]";
			mes "请去和那边的猫爪代理商谈谈，使用基础服务。";
			mes "哦，之后请再回来。";
			set ep13_yong1,2;
			close;
		case 2:
			mes "[Fluffy Gyaruk]";
			mes "真令人失望！";
			mes "不过我理解。";
			close;
		}
	}
	else if (ep13_yong1 == 3) {
		mes "[Fluffy Gyaruk]";
		mes "我们为新客户提供一项服务。";
		mes "如果你想使用更多服务，就必须为我们做些事。";
		next;
		select("什么事？");
		mes "[Fluffy Gyaruk]";
		mes "目前……";
		mes "请每天捕捉猫爪商队员工的主食——鱼，并收集矿物。";
		mes "每天完成这些事，你的信用点数就会增加。";
		next;
		mes "[Fluffy Gyaruk]";
		mes "当然，完成服务后我们会奖励你适量的经验值。";
		next;
		mes "[Fluffy Gyaruk]";
		mes "这是同时提高信用点数和经验值的好机会。";
		mes "这不是双赢吗？";
		mes "现在就开始吗？";
		next;
		switch(select("好的。:我得先准备一下。")) {
		case 1:
			mes "[Fluffy Gyaruk]";
			mes "太好了。";
			mes "想了解钓鱼和采矿的详情，请去和河边的两位猫爪代理商谈谈。";
			set ep13_yong1,4;
			close;
		case 2:
			mes "[Fluffy Gyaruk]";
			mes "没问题。";
			mes "慢慢来。";
			close;
		}
	}
	else if (ep13_yong1 == 4) {
		mes "[Fluffy Gyaruk]";
		mes "想了解钓鱼和采矿的详情，请去和河边的两位猫爪代理商谈谈。";
		close;
	}
	else {
		mes "[Fluffy Gyaruk]";
		mes "你目前在我们这里的信用点数是 ^0000FF" + ep13_yong1 + "^000000。";
		next;
		switch(select("如何提高点数？:我没兴趣。")) {
		case 1:
			mes "[Cat Paw Agent]";
			mes "每天钓鱼和采矿都能提高点数。请把捕获的鱼片交给戈鲁荣，把矿物交给采矿代理商。";
			close;
		case 2:
			close;
		}
	}
}

mid_camp,69,144,0	script	Ferocious Gorurug	421,{
	if (checkquest(12060,PLAYTIME) == -1) {
		if (ep13_yong1 < 4) {
			mes "[Ferocious Gorurug]";
			mes "嗷呜……";
			next;
			mes "一只像狮子般呼噜的猫";
			mes "正望着水面。";
			close;
		}
		else if (ep13_yong1 == 4) {
			mes "[Ferocious Gorurug]";
			mes "我很忙。";
			mes "我得抓鱼。";
			next;
			select("加尤鲁克派我来的。");
			mes "[Ferocious Gorurug]";
			mes "加尤鲁克派你来的？";
			mes "哦，你是来钓鱼的？*呼噜*";
			next;
			select("我该怎么做？");
			mes "[Ferocious Gorurug]";
			mes "你需要抓鱼。水里有鱼群。";
			mes "它们很难看见，但用光标在周围点击，就能抓到。";
			next;
			mes "[Ferocious Gorurug]";
			mes "在城外的水域钓鱼更容易。";
			mes "如果你不怕怪物，可以去那里钓鱼。";
			mes "*呼噜*";
			next;
			mes "[Ferocious Gorurug]";
			mes "现在让我教你怎么钓鱼。";
			mes "很简单：把光标移到鱼群上，然后点击抓住它们。";
			next;
			mes "[Ferocious Gorurug]";
			mes "刚开始会很难抓到，但你会越来越熟练。";
			mes "练习一下就会容易些。";
			set ep13_yong1,5;
			close;
		}
		else if (ep13_yong1 == 5) {
			if (countitem(6039) > 9) {
				mes "[Ferocious Gorurug]";
				mes "你带来了鱼片！";
				mes "干得好！";
				delitem 6039,10; //Piece_Of_Fish
				getexp (checkre(3))?20000:30000,0;
				set ep13_yong1,10;
				setquest 12060;
				next;
				mes "^0000ff你获得了 "+(checkre(3)?"20,000":"30,000")+" 点经验值^000000";
				close;
			}
			else {
				mes "[Ferocious Gorurug]";
				mes "把光标移到鱼群上，然后点击抓住它们。";
				mes "操作时不要移动！";
				close;
			}
		}
		else if ((ep13_yong1 > 5) && (ep13_yong1 < 20)) {
			if (countitem(6039) > 9) {
				mes "[Ferocious Gorurug]";
				mes "你带来了鱼片！";
				mes "干得好！";
				delitem 6039,10; //Piece_Of_Fish
				getexp 15000,0;
				setquest 12060;
				set ep13_yong1,ep13_yong1+1;
				next;
				mes "^0000ff你获得了 15,000 点经验值^000000";
				close;
			}
			else {
				mes "[Ferocious Gorurug]";
				mes "还要再钓鱼吗？";
				mes "抓到鱼片后，";
				mes "别忘了带给我。";
				close;
			}
		}
		else if ((ep13_yong1 > 19) && (ep13_yong1 < 40)) {
			if (countitem(6039) > 9) {
				mes "[Ferocious Gorurug]";
				mes "你带来了鱼片！";
				mes "干得好！";
				delitem 6039,10; //Piece_Of_Fish
				getexp 15000,0;
				setquest 12060;
				set ep13_yong1,ep13_yong1+1;
				next;
				mes "^0000ffYou gain EXP 15,000^000000";
				close;
			}
			else {
				mes "[Ferocious Gorurug]";
				mes "嘿，我一直在等你！";
				mes "祝你今天钓鱼顺利！";
				close;
			}
		}
		else if ((ep13_yong1 > 39) && (ep13_yong1 < 60)) {
			if (countitem(6039) > 9) {
				mes "[Ferocious Gorurug]";
				mes "你带来了鱼片！";
				mes "干得好！";
				delitem 6039,10; //Piece_Of_Fish
				getexp 15000,0;
				setquest 12060;
				set ep13_yong1,ep13_yong1+1;
				next;
				mes "^0000ffYou gain EXP 15,000^000000";
				close;
			}
			else {
				mes "戈鲁鲁格见到你很高兴。";
				next;
				mes "[Ferocious Gorurug]";
				mes "今天想抓什么？*呼噜*";
				close;
			}
		}
		else if (ep13_yong1 > 59) {
			npcskill "AL_HEAL",8,50,50;
			if (countitem(6039) > 9) {
				mes "[Ferocious Gorurug]";
				mes "你带来了鱼片！";
				mes "干得好！";
				delitem 6039,10; //Piece_Of_Fish
				getexp 15000,0;
				setquest 12060;
				set ep13_yong1,ep13_yong1+1;
				next;
				mes "^0000ffYou gain EXP 1,500^000000";
				close;
			}
			else {
				mes "戈鲁荣用欢快的呼噜声欢迎你。";
				next;
				mes "[Ferocious Gorurug]";
				mes "欢迎！";
				mes "你是来给我鱼的，对吧？";
				close;
			}
		}
		else {
			mes "凶猛的戈鲁鲁格睡着了。";
			close;
		}
	}
	else if ((checkquest(12060,PLAYTIME) == 0) || (checkquest(12060,PLAYTIME) == 1)) {
		mes "[Ferocious Gorurug]";
		mes "*Yawn*";
		mes "抱歉，我现在下班了。";
		mes "现在不能收鱼。";
		mes "明天再来，好吗？";
		close;
	}
	else {
		erasequest 12060;
		mes "[Ferocious Gorurug]";
		mes "*Purr*";
		mes "新的一天开始了，回去工作吧！";
		mes "现在抓到鱼就可以带给我了。";
		close;
	}
}

spl_fild02,314,165,0	script	School of Fish#1::Fishinghole	844,{
	if ((checkquest(12060,PLAYTIME) == -1) && (countitem(6039) < 20)) {
		specialeffect2 EF_BUBBLE;
		specialeffect2 EF_INVENOM;
		set .@fcast,15;
		if (isequipped(2550)) //Fisher's_Muffler
			set .@fcast,.@fcast - 2;
		if (isequipped(2443)) //Fish_Shoes
			set .@fcast,.@fcast - 2;
		if (isequipped(2764)) //Small_Fishing_Rod
			set .@fcast,.@fcast - 3;
		if (isequipped(2775)) //Lure
			set .@fcast,.@fcast - 1;
		if (isequipped(1599)) //Ahura_Mazda
			set .@fcast,.@fcast - 3;
		if (isequipped(2199)) //Angra_Manyu
			set .@fcast,.@fcast - 4;
		progressbar "ffff00",.@fcast;
		if (ep13_1_rhea == 13) {
			if (rand(1,20) == 2) {
				getitem 6037,1; //Rough_File
				set ep13_1_rhea,14;
				specialeffect EF_BUBBLE;
				mapannounce strcharinfo(3),strcharinfo(0) + " has caught a Messy File!!",bc_map,"0xff77ff";
			}
		}
		set .@rhea_ran,rand(1,70);
		if (.@rhea_ran < 20) getitem 6039,1; //Piece_Of_Fish
		else if (.@rhea_ran == 20) getitem 908,1; //Spawn
		else if (.@rhea_ran == 21) getitem 909,1; //Jellopy
		else if (.@rhea_ran == 22) getitem 963,1; //Sharp_Scale
		else if (.@rhea_ran == 23) getitem 956,1; //Gill
		else if (.@rhea_ran == 24) getitem 6049,1; //Marlin
		else if (.@rhea_ran == 25) getitem 918,1; //Sticky_Webfoot
		else if (.@rhea_ran == 26) getitem 960,1; //Nipper
		else if (.@rhea_ran == 27) getitem 910,1; //Garlet
		else if (.@rhea_ran == 28) getitem 938,1; //Sticky_Mucus
		else if ((.@rhea_ran > 28) && (.@rhea_ran < 40)) getitem 7049,1; //Stone
		else {
			mes "什么也没抓到。";
			close;
		}
		if (rand(1,200) == 3) {
			getitem 644,1; //Gift_Box
			mapannounce strcharinfo(3),strcharinfo(0) + " has caught a Gift Box!!",bc_map,"0x00ffff";
		}
		if (rand(1,500) == 3) {
			getitem 603,1; //Old_Blue_Box
			mapannounce strcharinfo(3),strcharinfo(0) + " has caught an Old Blue Box!!",bc_map,"0x00ffff";
		}
		if (rand(1,3000) == 3) {
			getitem 617,1; //Old_Violet_Box
			mapannounce strcharinfo(3),strcharinfo(0) + " has caught an Old Purple Box!!",bc_map,"0x44ff44";
		}
		end;
	}
	else {
		mes "鱼儿正在水里游。";
		close;
	}
}


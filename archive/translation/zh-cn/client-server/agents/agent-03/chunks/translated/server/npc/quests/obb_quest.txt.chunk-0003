				case 1:
					mes "[Elder Creek]";
					mes "我真羡慕你！不过，像你这样的年轻人很幸运，";
					mes "能遇到这些问题……遗憾的是，";
					mes "这种情况下，除了你自己，";
					mes "没人能真正帮助你。";
					mes "";
					mes "";
					next;

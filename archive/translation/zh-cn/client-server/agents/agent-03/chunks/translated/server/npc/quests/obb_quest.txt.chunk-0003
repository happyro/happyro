				case 3:
					mes "[Elder Creek]";
					mes "是的，我们总需要娱乐。";
					mes "但是……看来";
					mes "你似乎对什么都不满足。";
					next;
					mes "[Elder Creek]";
					mes "关键在于人们各不相同的品味";
					mes "和兴趣。";
					mes "别人享受的事也许不会";
					mes "让你不悦。此外，如果你的";
					mes "内心不愿快乐，";
					mes "你就无法享受生活。";
					next;
					mes "[Elder Creek]";
					mes "这里有个保持正确心态的例子。";

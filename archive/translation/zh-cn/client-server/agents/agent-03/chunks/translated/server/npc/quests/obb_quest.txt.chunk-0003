			mes "回答我，冒险者！";
			next;
			switch(select("我寻求财富！:我寻求……智慧。:我想完成已经开始的事。")) {
			case 1:
				mes "[Elder Creek]";
				mes "你很诚实……！";
				mes "不过，我建议你不要沉迷财富。";
				next;
				mes "[Elder Creek]";
				mes "你知道这句古话的确切";
				mes "含义吗……";
				mes "^0000FF过犹不及^000000？";
				mes "如果你的回答符合我的期待，";
				mes "我就会给你想要的东西。";
				next;
				switch(select("多多益善！:愚蠢到看不见未来。:好东西太多也会变坏。:向强者卑躬屈膝。")) {
				case 1:
					mes "[Elder Creek]";
					mes "...";
					mes "滚出我的视线，";
					mes "你这个贪婪的蠢货。";
					set thai_head,12;
					close;
				case 2:
					mes "[Elder Creek]";
					mes "呸！越无知的人，行为越傲慢！";
					mes "你以为我会接受随便一种解释吗？";
					mes "保重吧，无知的蠢货。";
					set thai_head,12;
					close;
				case 3:
					mes "[Elder Creek]";
					mes "没错。你理解得";
					mes "很好。这句格言正是关于贪婪的教训。";
					next;
					mes "[Elder Creek]";
					mes "我认识一个人很久了……";
					mes "他对金钱和财富极其贪婪，";
					mes "完全不在乎别人怎么看他。";
					next;
					mes "[Elder Creek]";
					mes "结果，他身边的人";
					mes "都不喜欢他。最后，他因贪婪失去了朋友。";
					next;
					mes "[Elder Creek]";
					mes "当然，这条规则也适用于";
					mes "你。毕竟这是一条普遍原则。";
					set thai_head,13;
					close;
				case 4:
					mes "[Elder Creek]";
					mes ".....";
					mes "你以为我会接受随便一种解释吗？！";
					mes "保重吧，无知的蠢货。";
					set thai_head,12;
					close;
				}
			case 2:
				mes "[Elder Creek]";
				mes "我明白了。我一直在帮助";
				mes "需要建议的人，";
				mes "让他们改善生活。";
				next;
				mes "[Elder Creek]";
				mes "既然你也需要我的建议，";
				mes "我会用你能理解的方式";
				mes "把智慧";
				mes "传授给你。";
				next;
				mes "[Elder Creek]";
				mes "现在，告诉我你此刻的烦恼。";

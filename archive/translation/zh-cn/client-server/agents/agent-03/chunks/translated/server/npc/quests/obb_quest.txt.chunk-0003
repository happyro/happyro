				mes "父母还活着时要尊敬他们。";
				mes "失去他们后再后悔就太迟了。";
				next;
				mes "["+strcharinfo(0)+"]";
				mes "（嗯……我知道这家伙还能告诉我更多……）";
				close;
			}
			else {
				mes "[Jacob]";
				mes "你有了孩子后，";
				mes "别忘了教他们";
				mes "这件事：";
				next;
				mes "[Jacob]";
				mes "‘^0000FF善待他人。^000000’";
				mes "‘^0000FF在评判别人前，先设身处地为对方着想。^000000’";
				mes "明白了吗？";
				next;
				mes "["+strcharinfo(0)+"]";
				mes "（我知道这家伙还能告诉我更多……）";
				close;
			}
		case 11:
			mes "[Jacob]";
			mes "现在，去拜访贤者吧？";
			mes "谢谢你的好意。";
			next;
			mes "[Jacob]";
			mes "他在海洞，如果你没听清。";
			mes "像你这样的冒险者应该能轻松到达。";
			close;
		}
	}
	else if (thai_head > 11) {
		mes "[Jacob]";
		mes "谢谢你为我做的好事……";
		mes "虽然我们最后没能";
		mes "抓到一只妖道……";
		next;
		mes "[Jacob]";
		mes "看来他从这次经历中";
		mes "学到了什么。";
		mes "他不再要求我做";
		mes "我做不到的事，也不再";
		mes "调皮捣蛋了。";
		next;
		mes "[Jacob]";
		mes "即使你不是有意的，那也是你为我做的另一件好事。谢谢。";
		close;
	}
	else {
		mes "[Jacob]";
		mes "*打哈欠*……";
		mes "今天真无聊～";
		mes "我想我最好和儿子";
		mes "出去走走。你要和我一起吗？";
		next;
		mes "[Jacob's son]";
		mes "听你这么说我很开心，爸爸～";
		close;
	}
}

comodo,68,195,0	script	Old Man#thai	120,{
	if (checkweight(1201,1) == 0) {
		mes "- 等一下！-";
		mes "- 你现在携带了 -";
		mes "- 太多物品。-";
		mes "- 请减轻负重 -";
		mes "- 后再试。-";
		close;
	}
	if (thai_head >= 11 && thai_head <= 15) {

					mes "[Elder Creek]";
					mes "如果你把所爱的人";
					mes "当作特别的人，那个人";
					mes "最终会理解";
					mes "你的感情……";
					next;
					mes "[Elder Creek]";
					mes "还有，记住……";
					mes "每个人表达爱意的方式都不同。";

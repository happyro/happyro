			next;
			mes "[Suspicious Man]";
			mes "啊啊啊啊啊！！！！！";
			set ep14_1_rope,8;
			close;
		} else {
			mes "[Suspicious Man]";
			mes "……";
			close;
		}
	}
}

// Find the Research Tools :: ep14_1_muk
//============================================================
mora,31,138,6	script	Raffle Researcher#ep14	522,{
	if (checkweight(1201,1) == 0 || MaxWeight - Weight < 500) {
		mes "^FF0000- Warning message -";
		mes "- Hang on there!! -";
		mes "- You have too many items -";
		mes "- to receive any more items. -";
		mes "- Please lighten your load -";
		mes "- and try again. -^000000";
		close;
	}
	// NPC disabled from 12am ~ 5am.
	if (gettime(DT_HOUR) >= 0 && gettime(DT_HOUR) < 5) {
		if (ep14_1_muk > 0) {
			mes "[Raffle Researcher]";
			mes "人类不睡觉吗？";
			mes "这个时间人们应该在睡觉。";
			mes "你到底为什么来打扰我？";
			next;
			mes "[Raffle Researcher]";
			mes "都怪你，我睡不着了。";
			mes "为了明天的研究，我必须睡觉。";
			mes "你也该去睡觉。";
			close;
		} else {
			mes "Z z Z z";
			next;
			mes "^FF0000He appears to be asleep.^000000";
			close;
		}
	}
	if (ep14_1_muk == 0) {
		mes "[Raffle Researcher]";
		mes "糟了~我的研究工具……";
		mes "什么……到底怎么回事？";
		emotion ET_CRY;
		next;
		select("你在这里做什么？");
		mes "[Raffle Researcher]";
		mes "嗯？";
		emotion ET_QUESTION;
		next;
		mes "[Raffle Researcher]";
		mes "你是人类……？你是人类吗……？";
		mes "你……来自地下世界？";
		next;
		mes "[Raffle Researcher]";
		mes "人类真不可思议……";
		mes "你穿过裂隙活着来到了这里。";
		next;
		mes "[Raffle Researcher]";
		mes "... ... ...";
		next;
		mes "[Raffle Researcher]";
		mes "你，过来一下。";
		mes "只是简单的实验，不用害怕。";
		emotion ET_KIK;
		next;
		if(select("真是疯狂的Raffle，我得逃跑。:……") == 1) {
			mes "[Raffle Researcher]";
			mes "你说自己从裂隙上来了，";
			mes "所以我想知道你是什么种族，";
			mes "但你只是人类？你是怎么来到这里的？";
			emotion ET_THROB;
			close;
		}
		if (BaseLevel < 100) {
			mes "[Raffle Researcher]";
			mes "什么……我以为能从裂隙上来的人类";
			mes "应该非同寻常，";
			mes "但你不过是个孩子。";
			next;
			mes "[Raffle Researcher]";
			mes "去多猎杀一些^000000波利^000000，";
			mes "等级达到三位数后再回来，孩子！";
			close;
		}
		mes "[Raffle Researcher]";
		mes "... ... ...";
		emotion ET_THINK;
		next;
		mes "[Raffle Researcher]";
		mes "你……你和其他人类不一样。";
		mes "你没有逃跑……";
		next;
		mes "[Raffle Researcher]";
		mes "你真有胆量……";
		mes "现在我真的想在你身上做实验了……";
		next;
		select("嗯……那个……呃……");
		mes "[Raffle Researcher]";
		mes "哈哈……开玩笑的……";
		mes "我是Raffle研究员，";
		mes "但我不研究人类。";
		mes "其实，我完全不知道";
		mes "该研究什么";
		mes "关于人类的事……";
		next;
		select("听你这么说我就放心了……");
		mes "[Raffle Researcher]";
		mes "就是这样。你不忙吧？";
		mes "我想请你帮个忙……";
		next;
		select("帮助他。:愿意帮助。:虽然有点尴尬，还是帮忙。:坚定地帮助。:可爱地帮助。:虽然怀疑，还是帮忙。:别无选择，只能帮助他。");
		mes "[Raffle Researcher]";
		mes "我没见过多少人类，";
		mes "但你明显很关心";
		mes "别人的困难。";
		mes "你一定是个^FF0000非常^000000善良的人类。";
		emotion ET_BEST;
		next;
		mes "[Raffle Researcher]";
		mes "为了节省时间，感谢的话就先不说了。";
		mes "这件事很重要，请尽快处理。";
		mes "因为它，我无法继续研究。";
		next;
		mes "[Raffle Researcher]";
		mes "在Mora旅馆这里，";
		mes "有一处非常有名的浴池。";
		mes "任何人，不只是我们Raffle，";
		mes "只要进入浴池的水中，";
		mes "伤口就会立刻痊愈……";
		next;
		mes "[Raffle Researcher]";
		mes "所以作为优秀的研究员，我进入浴池";
		mes "进一步调查，";
		mes "但……不幸的是……";
		next;
		mes "[Raffle Researcher]";
		mes "我遭到了神秘生物的攻击，";
		mes "失去了意识。";
		next;
		mes "[Raffle Researcher]";
		mes "醒来后我发现";
		mes "重要的研究工具不见了……";
		mes "所以我不知道该怎么办。";
		next;
		mes "[Raffle Researcher]";
		mes "而你，一个人类，";
		mes "一个从裂隙来到Mora村的勇敢英雄。";
		mes "你愿意帮忙，真的让我轻松了许多。";
		next;
		select("... ... ...");
		mes "[Raffle Researcher]";
		mes "请去浴场找回我的研究工具。";
		mes "你越快找回来，";
		mes "我就越快能继续研究。";
		setquest 5016;
		set ep14_1_muk,1;
		next;
		mes "[Raffle Researcher]";
		mes "一路平安。";
		emotion ET_WRAP;
		close;
	} else if (ep14_1_muk == 1) {
		if (checkquest(5016) > -1 && countitem(6385) == 0) {
			mes "[Raffle Researcher]";
			mes "你回来了？我的研究工具呢？";
			emotion ET_QUESTION;
			next;
			mes "[Raffle Researcher]";
			mes "你还没找到研究工具？";
			mes "我很失望。快去浴池";
			mes "找回我的研究工具，";
			mes "它们被人从我这里拿走了。";
			close;
		}
		mes "[Raffle Researcher]";
		mes "哇！！你找到研究工具了……？";
		mes "你真有能力。";
		mes "我很欣赏你做事的方式。";
		next;
		mes "[Raffle Researcher]";
		mes "我喜欢你。";
		mes "你愿意和我一起进行研究吗？";
		mes "在我完成这项研究前，";
		mes "我需要你不时帮忙。";
		next;
		select("如你所愿。");
		mes "[Raffle Researcher]";
		mes "太好了，谢谢。完成后，";
		mes "我会给你丰厚报酬。";
		mes "此外，每完成一个研究项目，";
		mes "我还会给你一些零花钱。";
		next;
		mes "[Raffle Researcher]";
		mes "现在的年轻Raffle……真是太笨了。";
		mes "我一直想要一个有能力的研究助手，";
		mes "但很难找到。";
		next;
		if (checkweight(6380,1) == 0) {
			mes "[Raffle Researcher]";
			mes "顺便问一下……";
			mes "找回研究工具很难吗？";
			mes "你带着看起来很重的装备。";
			mes "去减轻负重，我会支付你的报酬。";
			close;
		}
		mes "[Raffle Researcher]";
		mes "找回工具一定很辛苦。";
		mes "拿着这个去旅馆";
		mes "休息一下吧？现在没什么事要你做。";
		delitem 6385,1; //Research_Tool_Bag
		set ep14_1_muk,2;
		getitem 6380,1; //Mora_Coin
		erasequest 5016;
		close;
	} else if (ep14_1_muk == 2) {
		// Unofficial check, but it's needed here.
		if (checkquest(5029,PLAYTIME) == 0 || checkquest(5029,PLAYTIME) == 1) {
			mes "[Raffle Researcher]";
			mes "找回工具一定很辛苦。";
			mes "拿着这个去旅馆";
			mes "休息一下吧？现在没什么事要你做。";
			close;
		}
		switch(rand(1,5)) {
		case 1:
			mes "[Raffle Researcher]";
			mes "我还在为研究做准备。";
			mes "遗憾的是，有几件研究工具";
			mes "损坏了。";
			emotion ET_FRET;
			close;
		case 2:
			mes "[Raffle Researcher]";
			mes "说起来，我好像还没";
			mes "告诉你我的名字。";
			next;
			mes "[Raffle Researcher]";
			mes "我叫Inffle。如果有人";
			mes "问你和谁一起工作，";
			mes "你可以说^0000FF我和研究员Inffle一起工作。^000000";
			mes "所以我才告诉你我的名字。";
			emotion ET_OK;
			close;
		case 3:
			mes "[Raffle Researcher]";
			mes "为什么？旅馆关门了？";
			mes "真奇怪，不应该这样。";
			mes "你再去试一次吧？";
			emotion ET_QUESTION;
			close;
		case 4:
			break;
		case 5:
			mes "[Raffle Researcher]";
			mes "可恶，越想越生气。";
			mes "我又不是怀着恶意去的……";
			mes "我只是想做些研究……";
			mes "真不敢相信我竟然遭到了攻击……";
			mes "我就是无法相信……";
			mes "你怎么看？";
			emotion ET_FRET;
			close;
		}
		mes "[Raffle Researcher]";
		mes "你来得正好。";
		next;
		mes "[Raffle Researcher]";
		mes "我一直在想";
		mes "浴池里的未知生物。";
		mes "它真是个小恶魔，竟敢拿走研究工具，";
		mes "那可是研究员的命一样重要……";
		next;
		mes "[Raffle Researcher]";
		mes "研究助手的工作";
		mes "就是确保研究员能专心研究，";
		mes "而不必担心其他事情……非常重要！";
		next;
		mes "[Raffle Researcher]";
		mes "我想让你替我";
		mes "向那个未知生物复仇……";
		next;
		mes "[Raffle Researcher]";
		mes "我也不要求你做得太过分。";
		mes "3 times! Go bully him for just 3 times.";
		mes "你可以在它脸上画画，";
		mes "捏它、挠它，";
		mes "随你喜欢。只要欺负它3次。";
		set ep14_1_muk,3;
		setquest 5017;
		close;
	} else if (ep14_1_muk  < 6) {
		mes "[Raffle Researcher]";
		mes "工作进展如何？";
		mes "助手必须快速有效地工作。";
		mes "难道你忘了";
		mes "自己的任务吗？";
		next;
		select("没错，我该做什么？");
		mes "[Raffle Researcher]";
		mes "去欺负那个未知生物";
		mes "只要3次。";
		mes "你可以在它脸上画画，";
		mes "捏它、挠它，随你喜欢。";
		mes "欺负它3次。";
		emotion ET_KIK;
		close;
	} else if (ep14_1_muk == 6) {
		mes "[Raffle Researcher]";
		mes "你教训它了？太好了，我感觉大仇得报！";
		emotion ET_SMILE;
		next;
		mes "[Raffle Researcher]";
		mes "有一阵子我睡不着，";
		mes "因为我总是想起丢失的研究工具。";
		next;
		mes "[Raffle Researcher]";
		mes "就是这样！现在我们要开始浴池研究。";
		mes "我需要尽快完成研究，";
		mes "这样才能开始新的课题。";
		next;
		mes "[Raffle Researcher]";
		mes "去浴池的水中，";
		mes "带上我给你的样本管，";
		mes "收集一些样本。";
		next;
		mes "[Raffle Researcher]";
		mes "在浴池水中寻找，";
		mes "你会发现一个散发独特气场的区域。";
		mes "你可以从那里";
		mes "收集样本。";
		next;
		if (MaxWeight - Weight < 100 || checkweight(1092,10) == 0) {
			mes "[Raffle Researcher]";
			mes "你携带的重量太多了。";
			mes "我不能把样本管给你。";
			mes "减轻负重后再回来吧？";
			close;
		}
		mes "[Raffle Researcher]";
		mes "这是用来收集样本的样本管。";
		mes "去收集10个样本！";
		set ep14_1_muk,7;
		getitem 1092,10; //Empty_Cylinder
		erasequest 5018;
		setquest 5019;
		close;
	} else if (ep14_1_muk == 7) {
		if (checkquest(5019) > -1 && countitem(6386) < 10) {
			mes "[Raffle Researcher]";
			mes "你收集到样本了吗？";
			mes "请快一点。";
			next;
			mes "[Raffle Researcher]";
			mes "在浴池水中寻找，";
			mes "你会发现一个散发独特气场的区域。";
			mes "你可以从那里";
			mes "收集样本。";
			close;
		}
		if (checkweight(6380,1) == 0) {
			mes "[Raffle Researcher]";
			mes "我知道你做了很多事……";
			mes "但你携带的东西太多了。";
			mes "虽然我想给你零花钱，但现在做不到。";
			mes "你能减轻负重后再回来吗？";
			close;
		}
		mes "[Raffle Researcher]";
		mes "你拿到了浴池水样本。干得好。";
		next;
		mes "[Raffle Researcher]";
		mes "我得用浴池水样本";
		mes "进行几项测试。";
		mes "通常需要大约24小时。";
		mes "到时候再回来吧？";
		delitem 6386,10; //Bathtub_R_Sample
		getitem 6380,1; //Mora_Coin
		set ep14_1_muk,8;
		erasequest 5019;
		setquest 5020;
		close;
	} else if (ep14_1_muk == 8) {
		if (checkquest(5020,PLAYTIME) == 0 || checkquest(5020,PLAYTIME) == 1) {
			mes "[Raffle Researcher]";
			mes "基础测试还没有完成。";
			mes "现在没什么事要你做。";
			mes "去散散步吧。";
			mes "花掉我给你的钱。";
			close;
		}
		mes "[Raffle Researcher]";
		mes "基础测试完成了。";
		mes "果然……";
		mes "浴池水中有许多有趣的物质。";
		emotion ET_DELIGHT;
		next;
		mes "[Raffle Researcher]";
		mes "最值得注意的是这种无法识别的DNA。";
		mes "我还没有机会把它和大量DNA样本比较，";
		mes "但我很确定这种DNA";
		mes "被浴池中的神秘物质改变了。";
		next;
		mes "[Raffle Researcher]";
		mes "经过仔细思考，";
		mes "我得出结论，这种DNA可能属于";
		mes "攻击我的未知生物。";
		next;
		if (rand(2)) {
			set .@str$,"teeth";
			set .@quest,5021;
		} else {
			set .@str$,"scales";
			set .@quest,5022;
		}
		mes "[Raffle Researcher]";
		mes "最好把两者进行比较。";
		mes "请回到浴池";
		mes "寻找那只生物的"+.@str$+"。";
		mes "如果可以，请带10个回来。";
		set ep14_1_muk,9;
		erasequest 5020;
		setquest .@quest;
		close;
	} else if (ep14_1_muk == 9) {
		if (checkquest(5021) > -1 || checkquest(5022) > -1) {
			if (checkquest(5021) > -1) {
				set .@quest,5021;
				set .@item,6387; //Teeth_Sample
				setarray .@str$[0],"tooth","teeth";
			} else {
				set .@quest,5022;
				set .@item,6388; //Scale_Sample
				setarray .@str$[0],"scale","scales";
			}
			if (countitem(.@item) < 10) {
				mes "[Raffle Researcher]";
				mes "你还没找到未知生物的"+.@str$[1]+"吗？";
				mes "仔细找！";
				mes "我确定那只生物";
				mes "把它的"+.@str$[1]+"丢在了某处。";
				close;
			}
			mes "[Raffle Researcher]";
			mes "你终于收集齐了所有"+.@str$[0]+"样本。";
			mes "用人类的话说，";
			mes "我等它们等得太久了。";
			next;
			if (checkweight(6380,1) == 0) {
				mes "[Raffle Researcher]";
				mes "我知道你做了很多事……";
				mes "但你携带的东西太多了。";
				mes "虽然我想给你零花钱，但现在做不到。";
				mes "你能减轻负重后再回来吗？";
				close;
			}
			mes "[Raffle Researcher]";
			mes "好，我马上开始工作。";
			mes "你有其他事情就先去处理吧。";
			mes "DNA分析大约需要6小时。";
			mes "你不如去散散步，";
			mes "之后再回来？";
			delitem .@item,10;
			getitem 6380,1; //Mora_Coin
			erasequest .@quest;
			setquest 5023;
			close;
		} else if (checkquest(5023,PLAYTIME) == 0 || checkquest(5023,PLAYTIME) == 1) {
			mes "[Raffle Researcher]";
			mes "我还在分析DNA。";
			mes "DNA分析大约需要6小时。";
			mes "你不如去散散步，之后再回来？";
			close;
		} else {
			switch(rand(1,6)) {
			case 1:
			case 3:
				set .@quest,5021;
				set .@item,6387; //Teeth_Sample
				setarray .@str$[0],"tooth","teeth";
				break;
			case 2:
			case 4:
				set .@quest,5022;
				set .@item,6388; //Scale_Sample
				setarray .@str$[0],"scale","scales";
				break;
			case 5:
			case 6:
				break;
			}
			if (.@quest) {
				mes "[Raffle Researcher]";
				mes "不是这个。";

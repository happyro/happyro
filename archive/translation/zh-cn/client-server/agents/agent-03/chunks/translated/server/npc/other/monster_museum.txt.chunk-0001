yuno_in03,15,33,5	script	Violy#yuno	1390,{
	end;
}
yuno_in03,19,33,1	script	#VIOLY	111,{
	mes " ";
	mes " 学名：Violy";
	mes " 体型：中型";
	mes " 属性：无";
	next;
	mes "说明：";
	mes "长着美丽金发、外表像漂亮娃娃的生物。";
	mes "它总是面带平静表情拉小提琴，人们一开始不会意识到它是怪物。";
	next;
	mes "遇到Violy时务必格外小心，否则它会用迷人的歌声瞬间夺走你的灵魂。";
	close;
}
	
yuno_in03,10,39,5	script	Alice#yuno	1275,{
	end;
}
yuno_in03,12,39,1	script	#ALICE	111,{
	mes " ";
	mes " 学名：Alice";
	mes " 体型：中型";
	mes " 属性：无";
	next;
	mes "说明：";
	mes "Alice是为担任城堡女仆而制造的机器人。";
	mes "即使城堡被废弃很久，";
	mes "它们仍会留下并自动完成任务。";
	mes "";
	mes "";
	next;
	mes "由于没有可辨识的能量来源，";
	mes "它如何移动和运作";
	mes "至今仍是科学谜团。";
	close;
}
	

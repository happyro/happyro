	mes " 体型：中型";
	mes " 属性：风";
	next;
	mes "说明：";
	mes "与海龟岛上的其他乌龟不同，";
	mes "这种乌龟用两条腿站立，";
	mes "用另外两条腿攻击路人，";
	mes "并从背后挥舞巨大的手里剑。";
	mes "";
	next;
	mes "有趣的是，遇到危险的敌人时，";
	mes "它会制造分身以造成更多伤害。";
	mes "它的手里剑伤害非常高，";
	mes "但指甲攻击更加危险。";
	mes "";
	mes "";
	close;
}
	

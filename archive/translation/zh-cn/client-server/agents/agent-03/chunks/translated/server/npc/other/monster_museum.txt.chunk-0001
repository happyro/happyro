yuno_in03,48,104,3	script	Mandragora#yuno	1020,{
	end;
}
yuno_in03,46,105,1	script	#MANDRAGORA	111,{
	mes " ";
	mes " 学名：Mandragora";
	mes " 体型：中型";
	mes " 属性：地";
	next;
	mes "说明：";
	mes "吞食一切活物的食虫生物。";
	mes "发现猎物后，会先用长触手";
	mes "攻击，使其麻痹。";
	mes "";
	mes "";
	next;
	mes "猎物麻痹后会被放入";
	mes "连接在它身体上的大管子，";
	mes "在那里慢慢消化。虽然管子上";
	mes "有骷髅标记，但Mandragora";
	mes "实际上不含任何毒液。";
	mes "";
	mes "";
	next;
	mes "这套消化管装置还散发独特";
	mes "却令人恶心的气味，";
	mes "完全无法用来吸引猎物。";
	mes "";

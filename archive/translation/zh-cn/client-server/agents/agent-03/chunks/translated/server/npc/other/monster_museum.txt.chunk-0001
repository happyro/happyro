yuno_in03,32,15,3	script	Museum Guide	67,{
	mes "[Cenia]";
	mes "欢迎来到怪物博物馆。";
	next;
	switch(select("怪物博物馆？:提示")) {
	case 1:
		mes "[Cenia]";
		mes "怪物博物馆由";
		mes "施威彻尔比尔魔法学院的贤者们";
		mes "研究了米德加尔特大陆";
		mes "上所有生物后建立。";
		mes "";
		next;
		mes "[Cenia]";
		mes "在这座博物馆里，你可以看到米德加尔特的";
		mes "每一种怪物，";
		mes "甚至是几乎遇不到的怪物。";
		next;
		mes "[Cenia]";
		mes "收容怪物的玻璃管采用最新技术，";
		mes "作为施瓦茨计划的一部分开发。请放心，";
		mes "你会受到充分保护。";
		mes "";
		mes "";
		next;
		break;
	case 2:
		mes "[Cenia]";
		mes "如果想看清怪物，";
		mes "请按ALT+O打开选项窗口，";
		mes "并勾选不透明选项。";
		mes "";
		next;
		break;
	}
	mes "[Cenia]";
	mes "随时都可以来找我聊天。";
	close;
}
	
yuno_in03,36,21,3	script	Deviace#yuno	1108,{
	end;
}
yuno_in03,33,21,1	script	#DEVIACE	111,{
	mes " ";
	mes "学名：Deviace";
	mes "体型：中型";
	mes "属性：水";
	next;
	mes "说明：";
	mes "这种怪物栖息在深海，";
	mes "身体呈圆形，背部有吸盘。";
	mes "虽然锋利的牙齿很吓人，";
	mes "但性格非常温和。";
	mes "";
	mes "";
	next;
	mes "因此，除非先受到攻击，";
	mes "否则它不会主动攻击海底旅行者。";
	mes "不过一旦被激怒，";
	mes "它会使用高级魔法技能。";
	mes "所以最好小心应对这种怪物。";
	mes "";
	close;
}
	
yuno_in03,36,27,3	script	Seal#yuno	1317,{
	end;
}
yuno_in03,33,27,1	script	#FUR_SEAL	111,{
	mes " ";
	mes "学名：Seal";
	mes "体型：中型";
	mes "属性：水";
	next;
	mes "说明：";
	mes "仔细观察这种怪物，你会发现";
	mes "它其实不是海豹，而是";
	mes "藏在海豹状皮衣里的";
	mes "不明怪物。";
	mes "";
	mes "";
	next;
	mes "据说这种怪物穿着皮衣，";
	mes "是为了保护敏感的皮肤";
	mes "免受天气影响。海豹的皮衣";
	mes "是制作冬衣的优质材料。";
	mes "";
	mes "";
	close;
}
	
yuno_in03,36,33,3	script	Sage Worm#yuno	1281,{
	end;
}
yuno_in03,33,33,1	script	#SAGEWORM	111,{
	mes " ";
	mes "学名：Sage Worm";
	mes "体型：小型";
	mes "属性：无";
	next;
	mes "说明：";
	mes "一种奇怪的野兽，长着老学者的头";
	mes "和蠕虫的尾巴。虽然身体";
	mes "很弱，但拥有智慧，";
	mes "能用魔法技能支援同伴。";
	mes "";
	mes "";
	next;
	mes "从它学者般的外表可知，";
	mes "它通常出现在书籍或书架附近。";
	close;
}
	
yuno_in03,39,39,3	script	Penomena#yuno	1216,{
	end;
}
yuno_in03,38,39,1	script	#PENOMANA	111,{
	mes " ";
	mes "学名：Penomena";
	mes "体型：中型";
	mes "属性：毒";
	next;
	mes "说明：";
	mes "这种怪物栖息在洞穴最深处，";
	mes "那里有足够的湿气，";
	mes "不会让它干燥。";
	mes "";
	next;
	mes "它外形类似九尾狐，但不同的是，";
	mes "它能利用吸盘上的许多小附肢";
	mes "向敌人移动。";
	mes "";
	next;
	mes "身体上的细长触手会射出致命毒液，";
	mes "足以一击杀死敌人。";
	mes "";
	close;
}
	
yuno_in03,39,44,3	script	Galapago#yuno	1391,{
	end;
}
yuno_in03,37,44,3	script	#GALAPAGO	111,{
	mes " ";
	mes "学名：Galapago";
	mes "体型：小型";
	mes "属性：地";
	next;
	mes "说明：";
	mes "这是一种鸟，但身体太重，无法飞行。";
	mes "它对阳光非常敏感，所以总是带着水瓶并戴着太阳镜。";
	next;
	mes "虽然贪吃，";
	mes "但它总会合作攻击猎物，";
	mes "也会攻击捕食者。";
	mes "除此之外，Galapago通常是";
	mes "性情悠闲的怪物。";
	close;
}
	

				case 10:
					if (Sex == SEX_MALE) {
						mes "哎呀！！？“转生术”发型？";
						mes "这个造型像一位冷峻的城市男子，强大到足以杀死怪物。";
					} else {
						mes "哎呀！！？“药水制作”发型？";
						mes "这个造型以药液为主题，让人感觉得到治愈。";
					}
					break;
				case 11:
					if (Sex == SEX_MALE) {
						mes "哎呀！！？“龙知识”发型？";
						mes "这是神秘巨龙般充满智慧的造型。";
					} else {
						mes "哎呀！！？“圣十字攻击”发型？";
						mes "整齐的发型线条带来可靠感。";
					}
					break;
				case 12:
					if (Sex == SEX_MALE) {
						mes "哎呀！！？“钝器熟练度”发型？";
						mes "用发蜡打理后看起来清爽又整洁。";
					} else {
						mes "哎呀！！？“霸王魂”发型？";
						mes "这个造型非常亲切。";
					}
					break;
				case 13:
					if (Sex == SEX_MALE) {
						mes "哎呀！！？“雷鸣术”发型？";
						mes "这个造型有自然迷人的卷发，仿佛被雷暴击中过。";
					} else {
						mes "哎呀！！？“气弹”发型？";
						mes "沉静又略带男孩气的短发造型十分引人注目。";
					}
					break;
				case 14:
					if (Sex == SEX_MALE) {
						mes "哎呀！！？“安可”发型？";
						mes "摇滚乐手最喜欢的造型……光是名字就很有感觉……";
					} else {
						mes "哎呀！！？“舞娘之吻”发型？";
						mes "这款发型……对所有人都很温柔……整齐圆润的发际线柔和又迷人。";
					}
					break;
				case 15:
					if (Sex == SEX_MALE) {
						mes "哎呀！！？“黑暗瞬间”发型？";
						mes "棱角分明的造型。";
					} else {
						mes "哎呀！！？“反击”发型？";
						mes "这是看起来冷漠又傲慢的造型，很难接近……";
						mes "不过对男朋友可能会很温柔……？";
					}
					break;
				case 16:
					if (Sex == SEX_MALE) {
						mes "哎呀！！？“闪电冲击”发型？";
						mes "这是我的前辈和女友分手五次后发明的造型。";
					} else {
						mes "哎呀！！？“定位陷阱”发型？";
						mes "这是致命的造型……让人移不开视线！";
					}
					break;
				case 17:
					if (Sex == SEX_MALE) {
						mes "哎呀！！？“寻找矿石”发型？";
						mes "这个造型似乎能让人在街上行走时邂逅或发现意外之物。";
					} else {
						mes "哎呀！！？“地裂术”发型？";
						mes "令人惊艳、充满魅力的发型。";
					}
					break;
				case 18:
					if (Sex == SEX_MALE) {
						mes "哎呀！！？“火柱”发型？";
						mes "以前人人都留这种发型……说明它曾是一个时代的潮流。";
					} else {
						mes "哎呀！！？“雷击术”发型？";
						mes "两侧头发烫出轻柔波浪的清爽造型。";
					}
					break;
				case 19:
					if (Sex == SEX_MALE) {
						mes "哎呀！！？“阿修罗霸凰拳”发型？";
						mes "这是讲究一击必杀的造型……像真正的男子汉，对吧？";
					} else {
						mes "哎呀！！？“风暴”发型？";
						mes "这是随风飘动的帅气造型。啦、啦、啦、啦～";
					}
					break;
				}
				close2;
				cutin "", 255;
				end;
			}
			close;
		case 2:
			if (!countitem(6593)) {
				mes "[Otter Samssoon]";
				mes "来吧……亲爱的～";
				mes "你应该带来^ff0000“克里图拉发型优惠券”^000000来更换发型……";
				close;
			}
			mes "[Otter Samssoon]";
			mes "亲爱的～你想要什么造型？";
			mes "你完全就是我的类型。所以我非常兴奋～～";
			mes "请从第 1 到 19 页选择造型。";
			next;
			input .@style;
			if (.@style > 19) {
				mes "[Otter Samssoon]";
				mes "来吧……亲爱的～你可以在这里使用发型优惠券～";
				close;
			} else if (!.@style) {
				mes "[Otter Samssoon]";
				mes "哎呀！！？你不想要吗？";
				close;
			} else if (getlook(1) == .@style) {
				mes "[Otter Samssoon]";
				mes "来吧……亲爱的～那就是你现在的发型。";
				mes "你想尝试新造型吗？";
				close;
			}
			callsub L_cutin, .@style;
			mes "[Otter Samssoon]";
			mes "造型（"+.@style+")？";
			mes "感觉就是这样……怎么样？";
			next;
			if (select("很好。", "不要。") == 1) {
				if (!getlook(6)) {
					mes "[Otter Samssoon]";
					mes "没错！";
					mes "亲爱的！要不要顺便染发？";
					mes "这项服务也包括染发。";
					next;
					switch(select("热情红:甜蜜黄:致命紫:华丽橙:舒适绿:清澈蓝:透明白:深黑:停止。")) {
						case 1:
							.@pallete = 8;
							break;
						case 2:
							.@pallete = 1;
							break;
						case 3:
							.@pallete = 2;
							break;
						case 4:
							.@pallete = 3;
							break;
						case 5:
							.@pallete = 4;
							break;
						case 6:
							.@pallete = 5;
							break;
						case 7:
							.@pallete = 6;
							break;
						case 8:
							.@pallete = 7;
							break;
						case 9:
							mes "[Otter Samssoon]";
							mes "不要吗？";
							mes "还需要时间吗？如果想保持原来的颜色，就选择相同的颜色。";
							close2;
							cutin "", 255;
							end;
					}
				}
				nude;
				mes "[Otter Samssoon]";
				mes "放松，马上就完成了～";
				next;
				mes "[Otter Samssoon]";
				mes "- 沙沙、咔咔、咔咔咔 -";
				mes "- 咔嚓、咔嚓、咔嚓……-";
				mes "- 啪、啪、啪……咔嚓 -";
				next;
				delitem 6593,1;// Criatura_Hair_Coupon
				cutin "", 255;
				mes "[Otter Samssoon]";
				mes "哎呀！哎呀！哎呀！";
				mes "编号为（"+.@style+")的发型很适合你，看起来不错～";
				mes "你觉得怎么样？";
				setlook 1, .@style;
				setlook 6, .@pallete;
				next;
				mes "[Otter Samssoon]";
				mes "我想帮你打理造型……";
				mes "但因为我属于这里，没办法选择顾客。";
				next;
				mes "[Otter Samssoon]";
				mes "要更换发型，请去^ff0000艾尔贝塔或里希塔乐镇^000000。";
				mes "要染发，请去^ff0000普隆德拉或里希塔乐镇^000000。";
				close;
			}
			mes "[Otter Samssoon]";
			mes "亲爱的～你不喜欢吗？";
			mes "咳……你想再读一遍造型书吗？";
			mes "慢慢来，决定后告诉我～好吗？～";
			close;
		case 3:
			mes "[Otter Samssoon]";
			mes "你可以从^ff0000学院前台的初心者接待员或伊甸园集团^000000获得^ff0000克里图拉发型优惠券^000000";
			next;
			mes "[Otter Samssoon]";
			mes "他们不是免费给你的……嗯……";
			mes "你到达学院时收到的装备呢？";
			mes "把^ff0000初心者蛋壳^000000换成优惠券？";
			next;
			mes "[Otter Samssoon]";
			mes "我来到这里后这项服务就开始了。所以……没有优惠券就没有免费服务～";
			close;
		case 4:
			mes "[Otter Samssoon]";
			mes "哎呀！！？亲爱的，你不打算换发型吗？";
			mes "你现在的粗犷发型看起来很棒。";
			close;
	}

L_cutin:
	if (Sex == SEX_MALE) {
		if (getarg(0) < 10)
			cutin "hair_m_0"+getarg(0),4;
		else
			cutin "hair_m_"+getarg(0),4;
	} else {
		if (getarg(0) < 10)
			cutin "hair_f_0"+getarg(0),4;
		else
			cutin "hair_f_"+getarg(0),4;
	}
	return;
}


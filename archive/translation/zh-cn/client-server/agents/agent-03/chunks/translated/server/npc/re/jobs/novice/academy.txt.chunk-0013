// - Quiet Trainee
// -----------------------------------------------------------------------------
iz_ac02,143,77,3	script	Quite Trainee#ac	4_F_KID2,{
	if (Class == Job_Novice) {
		mes "[Quiet Trainee]";
		switch(rand(1,5)) {
		case 1:
			mes "你是来上枪手课程的吗？";
			break;
		case 2:
			mes "Lusa 小姐真的很漂亮。";
			break;
		case 3:
			mes "我希望像她一样成为枪手。";
			break;
		case 4:
			mes "希望我快点完成课程！";
			break;
		case 5:
			mes "学习太难了……";
			break;
		}
		close;
	} else if (Class == Job_Gunslinger) {
		mes "[Quiet Trainee]";
		mes "你是枪手？你看起来很棒！我想成为枪手……";
		close;
	} else {
		mes "[Quiet Trainee]";
		mes "暴风射击是子弹……吧啦……远程攻击……物理……";
		next;
		mes "因为她的声音太小，你听不清她的话。";
		close;
	}
}


// - Ragie
// - Teaches the player about Transcendent and Third classes.
// -----------------------------------------------------------------------------
iz_ac02,149,43,3	script	Ragie#ac	1_M_BARD,{
	mes "[Ragie]";
	mes "突然涌现了诗意灵感！";
	next;
	mes "[Ragie]";
	mes "^3377FF巴亚兰岛的月夜，在月光下独坐伊兹鲁德^000000";
	next;
	mes "[Ragie]";
	mes "^3377FF腹上佩着短剑，深深地焦虑着，^000000";
	next;
	mes "[Ragie]";
	mes "^3377FF听说有人发了财，温柔地将我击倒。^000000";
	next;
	mes "[Ragie]";
	mes "........";
	next;
	mes "[Ragie]";
	mes "怎么样？很棒吧？";
	next;

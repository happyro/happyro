// - Noisy Trainee
//-----------------------------------------------------------------------------
iz_ac02,152,79,3	script	Noisy Trainee#ac	4_M_HUBOY,{
	if (Class == Job_Novice) {
		mes "[Noisy Trainee]";
		mes "嘿，你知道枪手专用的武器吗？";
		next;
		if (select("不知道", "知道") == 2) {
			mes "[Noisy Trainee]";
			mes "哈，才怪！";
			close;
		}
		mes "[Noisy Trainee]";
		mes "我就猜到你是。";
		next;
		mes "[Noisy Trainee]";
		mes "枪手使用 5 种枪械，每种枪都有自己的特点。";
		next;
		select("什么特点？");
		mes "[Noisy Trainee]";
		mes "哈哈哈哈～我也在上课，但还没成为枪手，所以不知道细节。";
		next;
		mes "[Noisy Trainee]";
		mes "我听说枪械很危险，所以他们还不让我们使用！";
		close;
	} else if (Class == Job_Gunslinger) {
		mes "[Noisy Trainee]";
		mes "哦，枪手先生！！真棒。";
		close;
	} else {
		mes "[Noisy Trainee]";
		mes "什么？你为什么选择其他职业，而不是成为帅气的枪手？";
		close;
	}
}

iz_ac02_a,152,79,3	duplicate(Noisy Trainee#ac)	Noisy Trainee#ac_a	4_M_HUBOY

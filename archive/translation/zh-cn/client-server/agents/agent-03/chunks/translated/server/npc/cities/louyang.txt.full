// Luoyang Transportation
//============================================================
-	script	::Girl_louyang	-1,{
	mes "[女孩]";
	mes "啦啦啦啦~";
	mes "我今天感觉真好~";
	mes "我想去某个地方野餐~";
	mes "啦啦啦啦~";
	next;
	switch(select("关于洛阳:前往洛阳:取消")) {
	case 1:
		mes "[女孩]";
		mes "哦，你对洛阳感兴趣吗？";
		mes "那里是旅行者值得游览的好地方。";
		mes "";
		mes "";
		next;
		mes "[女孩]";
		mes "洛阳历史悠久，流传着古代魔法和武士的故事。";
		mes "据说许多邪恶野兽在洛阳地区出没。";
		mes "";
		mes "";
		next;
		mes "[女孩]";
		mes "包治百病的药物、神秘事件和武术家，";
		mes "在一个地方都能找到！";
		next;
		mes "[女孩]";
		mes "我在洛阳时每天早晨练武。我看起来也许不像，但其实很强！";
		next;
		mes "[女孩]";
		mes "如果你想去洛阳，尽管告诉我。";
		mes "给我一些 Zeny，我们就出发~";
		mes "";
		mes "";
		close;
	case 2:
		mes "[女孩]";
		mes "我马上带你去洛阳。";
		mes "服务费是 10,000 Zeny。";
		mes "";
		mes "";
		next;
		mes "[女孩]";
		mes "准备好了吗？";
		next;
		if (select("是！:不。") == 1) {
			if (Zeny > 9999) {
				mes "[女孩]";
				mes "好~";
				mes "准备出发！";
				mes "玩得开心！";
				close2;
				set Zeny, Zeny-10000;
				warp "lou_fild01",190,101;
				end;
			}
			mes "[女孩]";
			mes "……";
			mes "你似乎没有 10,000 Zeny……";
			mes "先去弄点钱吧！";
			mes "";
			close;
		}
		mes "[女孩]";
		mes "哦……";
		mes "听你这么说真令人失望。";
		mes "祝你今天愉快！";
		mes "";
		close;
	case 3:
		mes "[女孩]";
		mes "哦……";
		mes "祝你今天愉快！";
		close;
	}
}

lou_fild01,190,100,7	script	Girl#1lou	815,{
	mes "[女孩]";
	mes "你想";
	mes "回艾尔贝塔";
	mes "吗？";
	next;
	if (select("返回艾尔贝塔:取消") == 1) {
		mes "[女孩]";
		mes "希望";
		mes "再见到你！";
		mes "拜拜！";
		close2;
		if (checkre(0))
			warp "alberta",245,87;
		else
			warp "alberta",235,45;
		end;
	}
	mes "[女孩]";
	mes "如果你喜欢这里，为什么不留下来";
	mes "享受美食和风景呢！";
	mes "";
	mes "";
	next;
	if (Sex == SEX_MALE) {
		mes "[Girl]";
		mes "说到风景……";
		mes "我是指女孩！";
		mes "嘻嘻~";
	}
	else {
		mes "[Girl]";
		mes "这里的男孩";
		mes "长得也不赖~";
	}
	close;
}

// Generic Luoyang NPCs
//============================================================
louyang,297,167,2	script	Muscular Woman#lou	815,{
	if (Sex == SEX_FEMALE) {
		mes "[芝晴丽]";
		mes "少女宫的所有成员，包括我和师父，都是女性。";
		next;
		mes "[芝晴丽]";
		mes "最近我们很难招募新成员，所以我来这里看看是否有女性愿意加入。";
		emotion ET_THINK;
		close;
	}
	mes "[芝晴丽]";
	mes "...";
	next;
	mes "[芝晴丽]";
	mes "...";
	mes "......";
	next;
	mes "[芝晴丽]";
	mes "请别打扰我，";
	mes "我很忙。";
	close;
}

louyang,274,136,4	script	Powerful-looking guy#lou	819,{
	mes "[阿基拉]";
	mes "我正在练习‘龙爪’。不仅要运用拳头的力量，还必须磨炼精神。";
	next;
	mes "[阿基拉]";
	mes "每种武术都需要精神训练，";
	mes "因为心灵控制身体。";
	mes "如果完成精神训练，";
	mes "就能轻松使用身体的任何部位！";
	mes "";
	next;
	mes "[阿基拉]";
	mes "如果你考虑学习武术，";
	mes "应该先获得知识，再开始体能训练。";
	mes "";
	next;
	mes "[阿基拉]";
	mes "了解武术，思考人生真理。";
	mes "首先必须找到内心平静，才能掌握身心。";
	close;
}

louyang,276,136,4	script	Fist master#lou	819,{
	mes "[张小吉]";
	mes "终于……";
	mes "我掌握了";
	mes "‘龙爪’！";
	next;
	mes "[张小吉]";
	mes "虽然只有八个基本步骤，但我必须学习这门武术的历史并冥想，专注于精神提升，";
	mes "整整三年。";
	next;
	mes "[张小吉]";
	mes "之后师父才开始训练我的身体，让我能使用龙爪的八个步骤。我为这门武术奉献了三十年。";
	next;
	mes "[张小吉]";
	mes "我很自豪能比预期早十年掌握这门武术。现在，我需要研究招式，修正弱点、强化优点来改进它。";
	mes "";
	next;
	mes "[张小吉]";
	mes "我想这大约需要十年。但我一点也不气馁。";
	next;
	mes "[张小吉]";
	mes "学习武术不能急于求成，试图短时间学会一切是不可能的！而且那也不是武术的精髓……";
	close;
}


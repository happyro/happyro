// Luoyang Viewing Tower
//============================================================
lou_in01,25,23,5	script	Friendly Looking Lady#lo	817,{
	mes "[洪妙]";
	mes "欢迎。";
	next;
	mes "[洪妙]";
	mes "这是通往观景塔的电梯。我们以实惠价格提供安全快捷的接送服务。要使用吗？";
	next;
	switch(select("信息:是:下次吧")) {
	case 1:
		mes "[洪妙]";
		mes "洛阳旅游办公室收到许多建议后，建造了观景塔，让游客欣赏风景。";
		next;
		mes "[洪妙]";
		mes "由于洛阳的地理特点，";
		mes "很难欣赏这片土地的壮丽景色。";
		next;
		mes "[洪妙]";
		mes "乘坐这里的电梯即可上塔。我们提供快捷安全的服务，每人 500 Zeny。";
		close;
	case 2:
		if (Zeny < 500) {
			mes "[洪妙]";
			mes "抱歉，你没有足够的 Zeny。希望你稍后回来参观观景塔。祝你愉快。";
			close;
		}
		mes "[洪妙]";
		mes "感谢惠顾。";
		mes "我们会努力提供最好的服务。请";
		mes "再次光临。";
		next;
		set Zeny, Zeny-500;
		warp "lou_in01",17,19;
		end;
	case 3:
		mes "[洪妙]";
		mes "请稍后再来。";
		mes "祝你愉快。";
		close;
	}
}

louyang,84,254,0	script	Exit#lou	111,{
	mes "^3355FF这里有某种下降装置。";
	mes "要使用吗？^000000";
	next;
	if (select("是:否") == 1) {
		if (rand(1,100) == 34) {
			percentheal -99,0;
			warp "louyang",86,269;
			mapannounce "louyang",""+strnpcinfo(0)+"：天啊，我要掉下去啦~~~~！",bc_map;
		}
		else {
			warp "lou_in01",10,18;
		}
		end;
	}
	close;
}


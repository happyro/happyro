arena_room,162,88,3	script	Ponox	124,{
	end;

OnInit:
	waitingroom "Party Mode - 5 Member Parties",11,"Ponox::OnStartArena",5,0,10;
	enablewaitingroomevent;
	end;

OnStartArena:
	donpcevent "toarena#party::OnInit";
	donpcevent "toout#party::OnInit";
	warpwaitingpc "prt_are_in",73,78;
	donpcevent "toout#party::OnTimer";
	donpcevent "Helper#party::OnEnter";
	disablewaitingroomevent;
	end;

OnStart:
	enablewaitingroomevent;
	end;
}

prt_are_in,76,87,3	script	Helper#party	67,4,4,{
	if($arn_partywait == 0) {
		set $arn_partywait,1;
		emotion ET_SURPRISE;
		mes "[助手伊里夫]";
		mes "大家好，挑战者们！";
		mes "这里是队伍竞技场等候室。";
		next;
		mes "[助手伊里夫]";
		mes "这个等候室每次只允许一人停留。";
		mes "现在要开始战斗吗？";
		next;
		switch( select( "否","是" ) ) {
		case 1:
			set $arn_partywait,0;
			mes "[助手伊里夫]";
			mes "我明白了。";
			mes "不过请记住，你的时间有限。";
			close;
		case 2:
			mes "[助手伊里夫]";
			mes "谢谢，我来开始战斗。";
			mes "通往竞技场房间的传送门将会开启。";
			mes "希望你能坚持到战斗结束，并把名字刻在荣誉榜上……";
			close2;
			donpcevent "toarena#party::OnEnter";
			donpcevent "Helper#party::OnStop";
			donpcevent "arena_p::OnStart";
			end;
		}
	}
	end;

OnEnter:
	enablenpc "Helper#party";
	end;

OnStop:
	disablenpc "Helper#party";
	end;

OnInit:
	set $arn_partywait,0;
	end;
}

prt_are_in,73,78,0	script	toarena#party	-1,20,20,{
OnInit:
	disablenpc "toarena#party";
	end;

OnTouch_:
	if(Zeny < 1000)
		warp "arena_room",100,75;
	else {
		set Zeny,Zeny -1000;
		set $arn_partywait,0;
		donpcevent "toout#party::OnStop";
		warp "force_1-2",99,26;
	}

OnEnter:
	enablenpc "toarena#party";
	end;
}

prt_are_in,73,79,0	script	toout#party	-1,20,20,{
OnInit:
	disablenpc "toout#party";
	end;

OnTimer:
	initnpctimer;
	end;

OnTimer60000:
	set $arn_partywait,0;
	enablenpc "toout#party";
	end;

OnTimer70000:
	donpcevent "toout#party::OnStop";
	donpcevent "Ponox::OnStart";
	disablenpc "toout#party";

OnTouch_:
	set $arn_partywait,0;
	warp "arena_room",100,75;

OnEnter:
	enablenpc "toout#party";
	end;

OnStop:
// 	broadcastinmap "toout turns off the timer."
	stopnpctimer;
	end;
}

prt_are_in,73,74,0	script	arena_out	-1,1,1,{
OnTouch_:
	set $arn_partywait,0;
	warp "arena_room",100,75;
	end;
}

force_1-2,99,31,4	script	Slipslowrun#party	124,{
OnStart:
	initnpctimer;
	set $arena_minptst,gettime(DT_MINUTE);
	set $arena_secptst,gettime(DT_SECOND);
	end;

OnTimer2000:
	mapannounce "force_1-2","大家好，我叫斯利普斯洛伦！我会协助你们进行队伍竞技场战斗！",bc_all;
	//Official "arena_compass" script is extremely buggy, so we aren't using it.
	//donpcevent "arena_compass::OnStart";
	end;

OnTimer3000:
	mapannounce "force_1-2","队伍竞技场的目标是消灭每个房间中的所有怪物。",bc_all;
	end;

OnTimer4000:
	mapannounce "force_1-2","三个方向的三个房间没有进入顺序，但必须消灭房间内所有怪物才能继续下一阶段。",bc_all;
	end;

OnTimer5000:
	mapannounce "force_1-2","从现在起你有10分钟。期待你们全力以赴！",bc_all;
	end;

OnTimer60000:
	if (getmapusers("force_1-2") == 0)
		donpcevent "Slipslowrun#party::OnFail";
	mapannounce "force_1-2","剩余时间：9分钟",bc_all;
	end;

OnTimer120000:
	if (getmapusers("force_1-2") == 0)
		donpcevent "Slipslowrun#party::OnFail";
	mapannounce "force_1-2","剩余时间：8分钟",bc_all;
	end;

OnTimer180000:
	if (getmapusers("force_1-2") == 0)
		donpcevent "Slipslowrun#party::OnFail";
	mapannounce "force_1-2","剩余时间：7分钟",bc_all;
	end;

OnTimer240000:
	if (getmapusers("force_1-2") == 0)
		donpcevent "Slipslowrun#party::OnFail";
	mapannounce "force_1-2","剩余时间：6分钟",bc_all;
	end;

OnTimer300000:
	if (getmapusers("force_1-2") == 0)
		donpcevent "Slipslowrun#party::OnFail";
	mapannounce "force_1-2","剩余时间：5分钟",bc_all;
	end;

OnTimer360000:
	if (getmapusers("force_1-2") == 0)
		donpcevent "Slipslowrun#party::OnFail";
	mapannounce "force_1-2","剩余时间：4分钟",bc_all;
	end;

OnTimer420000:
	if (getmapusers("force_1-2") == 0)
		donpcevent "Slipslowrun#party::OnFail";
	mapannounce "force_1-2","剩余时间：3分钟",bc_all;
	end;

OnTimer480000:
	if (getmapusers("force_1-2") == 0)
		donpcevent "Slipslowrun#party::OnFail";
	mapannounce "force_1-2","剩余时间：2分钟",bc_all;
	end;

OnTimer540000:
	if (getmapusers("force_1-2") == 0)
		donpcevent "Slipslowrun#party::OnFail";
	mapannounce "force_1-2","剩余时间：1分钟",bc_all;
	end;

OnTimer600000:
	mapannounce "force_1-2","时间到了！离开前请确认没有遗落任何东西。",bc_all;
	end;

OnTimer605000:
	donpcevent "arena_p::OnReset";
	mapwarp "force_1-2","prt_are_in",177,138;
	end;

OnTimer606000:
OnTimer607000:
OnTimer608000:
OnTimer609000:
OnTimer610000:
OnTimer611000:
OnTimer612000:
OnTimer613000:
	mapwarp "force_1-2","prt_are_in",177,138;
	end;

OnTimer614000:
	mapwarp "force_1-2","prt_are_in",177,138;
	donpcevent "Slipslowrun#party::OnFail";
	end;

OnFail:
	donpcevent "Slipslowrun#party::OnTimerOff";
	mapwarp "force_1-2","prt_are_in",177,138;
	donpcevent "arena_p::OnReset";
	donpcevent "alloff#party::OnInit";
	donpcevent "Ponox::OnStart";
	end;

OnTimerOff:
	stopnpctimer;
	end;

On01_End:
	mapannounce "force_1-2","通往东侧房间的门打开了！",bc_all;
	end;

On02_End:
	mapannounce "force_1-2","通往西侧房间的门打开了！",bc_all;
	end;

On03_End:
	mapannounce "force_1-2","通往南侧房间的门打开了！",bc_all;
	end;

On04_Start:
	mapannounce "force_1-2","通往东侧第4个房间的门打开了！",bc_all;
	end;

On04_End1:
	mapannounce "force_1-2","西侧传送门已开启！请清理西侧走廊尽头的第5个房间！",bc_all;
	end;

On04_End2:
	mapannounce "force_1-2","西北房间的传送门已开启！",bc_all;
	end;

On05_End1:
	mapannounce "force_1-2","通往东侧房间的门打开了～",bc_all;
	end;

On05_End2:
	mapannounce "force_1-2","通往北侧房间的门打开了～",bc_all;
	end;

On06_End:
	mapannounce "force_1-2","通往东侧房间的门打开了～",bc_all;
	end;

On07_End:
	mapannounce "force_1-2","北侧的门打开了～",bc_all;
	end;

On08_End:
	mapannounce "force_1-2","通往西侧走廊的门打开了～",bc_all;
	end;

On09_End:
	mapannounce "force_1-2","西侧出口已打开！",bc_all;
	end;

On10_End:
	mapannounce "force_1-2","首领阶段已通过！东侧出口已打开！谢谢。",bc_all;
	end;
}


	end;

OnMyMobDead:
	if (mobcount("force_1-2","force_01mob#party::OnMyMobDead") < 1) {
		enablenpc "force_01_00";
		donpcevent "Slipslowrun#party::On01_End";
		set $arn_partyc,$arn_partyc +1;
		if($arn_partyc == 3) {
			donpcevent "Slipslowrun#party::On04_Start";
			enablenpc "force_03_04";

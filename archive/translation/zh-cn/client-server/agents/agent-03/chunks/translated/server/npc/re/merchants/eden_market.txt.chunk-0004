		mes "以及魔法实验用的属性石，全都在这里出售！";
		next;
		mes "[Earl the Alchemist]";
		mes "库存不多，供应有限，不过……";
		mes "想找什么？";
		next;
		switch (select("查看材料。:查看属性石。:取消。")) {
		case 1:
			mes "[Earl the Alchemist]";
			mes "不朽心脏、树枝和许多来自各地下城的材料";
			mes "在这里以合理价格出售。";
			next;
			mes "[Earl the Alchemist]";
			mes "如果什么都看不到，就表示全部售罄。";
			close2;
			callshop "para_alc20";
			end;
		case 2:
			mes "[Earl the Alchemist]";
			mes "这里有星尘和星星碎片。";
			mes "不确定我们是否还有库存。";
			close2;
			callshop "para_alc30";
			end;
		case 3:
			mes "[Earl the Alchemist]";
			mes "欢迎再来！";
			mes "请注意，我们周三不开门，因为那天要进货！";
			close;
		}
	} else { // holiday
		mes "[Earl the Alchemist]";
		mes "周三休息。";
		mes "想买东西的话明天再来。";
		close;
	}
}



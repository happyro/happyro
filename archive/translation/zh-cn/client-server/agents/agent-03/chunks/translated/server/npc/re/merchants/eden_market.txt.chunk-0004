// Gecko the Trainer
paramk,124,97,3	script	Gecko the Trainer#unm01	4_M_DESERT,{
	mes "[Gecko the Trainer]";
	switch( Class ) {
	case Job_Rune_Knight:
	case Job_Rune_Knight_T:
	case Job_Baby_Rune_Knight:
		mes "欢迎。要租一条龙吗？";
		next;
		if (select("是:否") == 2) {
			mes "[Gecko the Trainer]";
			mes "我明白了。祝你今天愉快。";
			close;
		}
		// if (!getskilllv("RK_DRAGONTRAINING")) {
		if (!getskilllv("KN_RIDING")) {
			mes "[Gecko the Trainer]";
			mes "请先学习骑龙。";
			close;
		} else if (checkriding() || checkdragon()) {
			mes "[Gecko the Trainer]";
			mes "你已经有龙了。";
			close;
		} else if (ismounting()) {
			mes "[Gecko the Trainer]";
			mes "请解除现金坐骑。";
			close;
		}
		setdragon;
		close;

	case Job_Royal_Guard:
	case Job_Royal_Guard_T:
	case Job_Baby_Royal_Guard:
		mes "欢迎。要租一只狮鹫吗？";
		next;
		if (select("是:否") == 2) {
			mes "[Gecko the Trainer]";
			mes "我明白了。祝你今天愉快。";
			close;
		}
		if (!getskilllv("KN_RIDING")) {
			mes "[Gecko the Trainer]";
			mes "请先学习骑狮鹫。";
			close;
		}
		if (checkriding()) {
			mes "[Gecko the Trainer]";
			mes "你已经有狮鹫了。";
			close;
		}
		if (ismounting()) {
			mes "[Gecko the Trainer]";
			mes "请解除现金坐骑。";
			close;
		}
		setriding;
		close;

	default:
		mes "我为卢恩骑士和皇家卫士提供骑乘生物。";
		close;
	}
}


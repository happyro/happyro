// Madoha
paramk,95,102,3	script	Madoha#mag01	4_M_SAGE_A,{
	if ($event_paramk > 0) {
		mes "[Madoha]";
		mes "欢迎。";
		mes "这里是Ma兄弟经营的Ma-Ma-Ma-Ma魔法商店，帮助非法师使用魔法。";
		next;
		mes "[Madoha]";
		mes "我们出售魔法卷轴和宝石。";
		mes "你在找什么特别的东西吗？";
		next;
		if (select("查看物品。:取消。") == 1) {
			mes "[Madoha]";
			mes "蓝、红、黄宝石，以及陨石术、暴风雪、雷神之怒等魔法卷轴……";
			mes "^4d4dff如果什么都看不到，就表示全部售罄^000000，请注意。";
			close2;
			callshop "para_mag10";
			end;
		}
		mes "[Madoha]";
		mes "制作魔法卷轴很有趣。";
		mes "魔法卷轴能让非魔法师冒险者使用不会的魔法，也很有帮助。";
		next;
		mes "[Madoha]";
		mes "但我每周能书写的卷轴有限，所以有时会卖光。";
		close;
	} else { // holiday
		mes "[Madoha]";
		mes "哦，客人？";
		mes "今天是假日，只出售基础魔法材料，不卖卷轴。可以吗？";
		mes "我们有蓝宝石、符文石等……";
		next;
		if (select("查看物品。:取消。") == 1) {
			mes "[Madoha]";
			mes "我们尽量备足库存，但可能已经卖光。";
			mes "如果什么都看不到，就表示全部售罄。";
			close2;
			callshop "para_mag11";
			end;
		}
		mes "[Madoha]";
		mes "黄、红宝石和魔法卷轴在其他日子出售，";
		mes "明天再来吧。";
		close;
	}
}


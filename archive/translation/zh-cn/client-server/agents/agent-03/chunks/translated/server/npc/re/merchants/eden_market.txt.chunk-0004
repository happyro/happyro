		next;
		switch (select("高级烹饪材料。:酱料和香料。:出售物品。:取消。")) {
		case 1:
			mes "[Manbok]";
			mes "不确定还剩多少。";
			mes "如果^4d4dff什么都看不到，就表示全部售罄^000000。";
			mes "请随意浏览。";
			close2;
			callshop "para_fod10";
			end;
		case 2:
			mes "[Manbok]";
			mes "来自世界各地的酱料和香料……";
			mes "想要烹饪材料就找我。";
			close2;
			callshop "para_fod01",1;
			end;
		case 3:
			mes "[Manbok]";
			mes "只要是我经营的商品，我会以合理价格收购。";
			close2;
			callshop "para_fod01",2;
			end;
		case 4:
			mes "[Manbok]";
			mes "你可能已经知道，但我还是要说。";
			mes "库存有限。犹豫太久的话材料经常会售罄。";
			next;
			mes "[Manbok]";
			mes "只是提醒一下。";
			close;
		}
	} else { // holiday
		mes "[Manbok]";
		mes "周三不营业。";
		mes "今天补货。明天再来。";
		close;
	}
}



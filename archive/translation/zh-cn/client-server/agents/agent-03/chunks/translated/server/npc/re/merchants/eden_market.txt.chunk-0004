}

// Mist the Hunter
paramk,130,98,3	script	Mist the Hunter#unm03	4_M_JOB_HUNTER,{
	if (Upper == 0) .@price = 2500; // Normal Falcon - default price
	if (Upper == 1) .@price = 2500; // Scarf Falcon
	if (Upper == 2) .@price = 2500; // Baby Falcon
	mes "[Mist, the Hunter]";
	if (BaseJob == Job_Hunter) {
		if (checkoption(Option_Wug) || checkoption(Option_Wugrider)) {
			mes "Um...";
			mes "你不能租用猎鹰";
			mes "除非先解除战狼！";
			close;
		}
		mes "需要猎鹰吗？";
		mes "只需";
		mes "费用就能租到可靠的猛禽，";
		mes "" + .@price + " Zeny～";
		next;
		switch (select("租猎鹰。:购买猎鹰笛。:取消。")) {
		case 1:
			if (checkwug()) {
				mes "[Mist, the Hunter]";
				mes "Um...";
				mes "你不能租用猎鹰";
				mes "除非先解除战狼！";
				close;
			}
			if (Zeny < .@price) {
				mes "[Mist, the Hunter]";
				mes "这是怎么回事？";
				mes "你没有";
				mes "足够的Zeny？！";
				mes "你最好开始";
				mes "赚钱";
				mes "而不是猎杀怪物～";
				close;
			}
			if (getskilllv("HT_FALCON") == 0) {
				mes "[Mist, the Hunter]";
				mes "天哪～";
				mes "先去学习如何";
				mes "管理猎鹰，";
				mes "否则我不能租给你";
				mes "，因为你不会";
				mes "使用它。";
				close;
			}
			if (checkfalcon()) {
				mes "[Mist, the Hunter]";
				mes "Um...";
				mes "你已经有";
				mes "猎鹰了。它就在";
				mes "那里，你看不见吗？";
				close;
			}
			Zeny -= .@price;
			setfalcon;
			close;
		case 2:
			mes "[Mist, the Hunter]";
			mes "用魔法笛可以从任何地方召唤猎鹰！";
			next;
			mes "[Mist, the Hunter]";
			mes "很神奇，对吧？哈哈哈！";
			next;
			mes "[Mist, the Hunter]";
			mes "我为什么卖这些猎鹰笛？";
			mes "因为我完全不知道它们怎么用。";
			mes "Ha ha ha!";
			next;
			mes "[Mist, the Hunter]";
			mes "当然，你需要^ff0000猎鹰精通^000000技能。";
			mes "我没有这个技能，所以不知道怎么管理猎鹰。";
			mes "照这样下去，我可能永远都不会有猎鹰。";
			next;
			mes "[Mist, the Hunter]";
			mes "但我不能免费给你！";
			mes "我也要吃饭，所以得赚钱！";
			next;
			mes "[Mist, the Hunter]";
			mes "需要猎鹰笛的话，我以12,500 Zeny出售。是不是太贵了？";
			next;
			if (eaclass()&EAJL_THIRD) {
				mes "[Mist, the Hunter]";
				mes "不过对游侠有特价，只要10,000 Zeny！";
				.@price = 10000;
				next;
			} else
				.@price = 12500;
			if (select("不买。:购买猎鹰笛。") == 1) {
				mes "[Mist, the Hunter]";
				mes "真遗憾。如果你需要，就再回来吧！";
				close;
			}
			if (Zeny >= .@price) {
				if (countitem(12848) >= 1) { // Falcon_Flute
					mes "[Mist, the Hunter]";
					mes "看来你已经有猎鹰笛了！";
					mes "别担心，年轻朋友，买过猎鹰笛后就不必再买";
					mes "因为猎鹰笛使用后不会消失，很棒吧？";
					close;
				}
				mes "[Mist, the Hunter]";
				mes "给你，拿着这支笛子。";
				mes "用它可以从任何地方呼唤猎鹰。";
				Zeny -= .@price;
				getitem(12848, 1); // Falcon_Flute
				next;
				mes "[Mist, the Hunter]";
				mes "提醒一下。";
				mes "使用它需要^ff0000猎鹰精通^000000技能！";
				close;
			}
			mes "[Mist, the Hunter]";
			mes "抱歉，你的钱不够买猎鹰笛，钱够后再回来！";
			close;

		case 3:
			mes "[Mist the Hunter]";
			mes "看看我们店里的其他物品。";
			mes "我们很快可能会提供新的宠物用品～";
			mes "哈哈哈哈！";
			close;
		}
	} else {
		mes "年轻的傻瓜！";
		mes "猎鹰只能由";
		mes "猎人";
		mes "和神射手使用，明白吗？";
		mes "……嘿嘿，嫉妒吗？";
		close;
	}
}

// exit
paramk,97,5,0	warp	paramk#ex	1,1,moc_para01,106,35

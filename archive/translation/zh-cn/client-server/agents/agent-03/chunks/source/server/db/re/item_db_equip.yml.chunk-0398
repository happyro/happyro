  - Id: 450350
    AegisName: Gaebolg_Armor
    Name: Gaebolg Armor
    Type: Armor
    Weight: 2400
    Defense: 198
    Slots: 1
    Locations:
      Armor: true
    ArmorLevel: 2
    EquipLevelMin: 245
    Refineable: true
    Gradable: true
    Script: |
      .@g = getenchantgrade();
      .@r = getrefine();
      bonus bBaseAtk,130+15*(.@r/2);
      bonus bDef,15*(.@r/2);
      if (.@r>=7) {
         bonus bLongAtkRate,3;
         bonus bShortAtkRate,3;
         if (.@r>=9) {
            bonus bVariableCastrate,-10;
            bonus bPAtk,5;
            if (.@r>=10) {
               bonus bLongAtkRate,5;
               bonus bShortAtkRate,5;
               if (.@r>=12) {
                  bonus bDelayrate,-5;
               }
            }
         }
      }
      if (.@g>=ENCHANTGRADE_D) {
         bonus bDelayrate,-5;
         bonus bPow,3;
         bonus bCon,3;
         if (.@g>=ENCHANTGRADE_C) {
            bonus bPAtk,2;
            bonus bAtkRate,3;
            if (.@g>=ENCHANTGRADE_B) {
               bonus bPAtk,3;
               bonus bPow,4;
               bonus bCon,4;
               if (.@g>=ENCHANTGRADE_A) {
                  bonus bPAtk,5;
                  bonus bAtkRate,4;
               }
            }
         }
      }

               bonus2 bMagicAtkEle,Ele_Ghost,15;
               bonus2 bMagicAtkEle,Ele_Dark,15;
               bonus bFixedCast,-1000;
               bonus bVariableCastrate,-5;
            }
         }
      }
      if (.@g>=ENCHANTGRADE_D) {
         bonus bMatk,25;
         bonus bSpl,5;
         bonus bCon,5;
         if (.@g>=ENCHANTGRADE_C) {
            bonus bSMatk,3;
            bonus bMatkRate,3;
            if (.@g>=ENCHANTGRADE_B) {
               bonus bSMatk,3;
               bonus bMatkRate,5;
               if (.@g>=ENCHANTGRADE_A) {
                  bonus2 bMagicAtkEle,Ele_Undead,15;
                  bonus2 bMagicAtkEle,Ele_Fire,15;
                  bonus2 bMagicAtkEle,Ele_Neutral,15;
                  bonus2 bMagicAtkEle,Ele_Wind,15;
                  bonus2 bMagicAtkEle,Ele_Ghost,15;
                  bonus2 bMagicAtkEle,Ele_Holy,15;
                  bonus2 bMagicAtkEle,Ele_Dark,15;
                  bonus2 bMagicAddRace2,RC2_Encroached_Gephenia,10;
               }
            }
         }
      }
  - Id: 470339
    AegisName: Dimension_E_Boots
    Name: Dimension World Executioner Boots
    Type: Armor
    Weight: 1200
    Defense: 100
    Slots: 1
    Locations:
      Shoes: true
    ArmorLevel: 2
    EquipLevelMin: 260

    Script: |
      .@aspd = 1;
      .@crit_dmg = 2 + 2 * (readparam(bDex) / 10);
      .@sub_player = 2;
      .@luk = readparam(bLuk);
      if (.@luk > 107) {
         .@aspd += 1;
         .@crit_dmg += 2;
         .@sub_player += 2;
      }
      if (.@luk > 119) {
         .@aspd += 2;
         .@crit_dmg += 4;
         .@sub_player += 4;
         bonus bSplashRange,1;
      }
      bonus bAspd,.@aspd;
      bonus bCritAtkRate,.@crit_dmg;
      bonus2 bSubRace,RC_Player_Human,.@sub_player;

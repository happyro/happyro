			mes "Ah, I need a handkerchief. There are so many things to do and I'm so busy.";
			next;
			mes "[Agnes]";
			mes "Oh, I would like to thank you for working hard for me. Here you are.";
			next;
			mes "[Agnes]";
			mes "And Can I ask you to get more? I am afraid that cloth is not sufficient.";

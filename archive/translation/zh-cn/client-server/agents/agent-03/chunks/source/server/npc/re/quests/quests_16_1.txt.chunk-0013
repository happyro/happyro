				mes "Not yet? OK. We have still time.";
				next;
				mes "[Agnes]";
				mes "You forget what I asked didn't you? ^0000cdThey are three " + getitemname(722) + " and 50 strands of " + getitemname(949) + "^000000.";
				next;
				mes "[Agnes]";
				mes "Please don't be late!";
				close3;
			}
			mes "Here you are.";
			mes "Am I too late?";
			next;
			mes "[Agnes]";
			mes "No! you have brought all of them. I'm so happy!";
			next;
			mes "[Agnes]";
			mes "I'll take pearls to the jeweler, the best jeweler. They are so pretty!";

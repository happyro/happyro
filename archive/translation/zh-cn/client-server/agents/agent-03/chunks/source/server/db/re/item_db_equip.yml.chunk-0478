         if (.@r>=9) {
            bonus2 bSkillAtk,"SO_DIAMONDDUST",25;
            bonus2 bSkillAtk,"SO_EARTHGRAVE",25;
            if (.@r>=11) {
               bonus2 bSkillCooldown,"SO_DIAMONDDUST",-2000;
               bonus2 bSkillCooldown,"SO_EARTHGRAVE",-2000;
            }
         }
      }
      if (.@g >= ENCHANTGRADE_D) {
         bonus2 bSkillAtk,"EM_DIAMOND_STORM",5;

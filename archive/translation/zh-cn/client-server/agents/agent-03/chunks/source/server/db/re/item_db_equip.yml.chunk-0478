      bonus2 bSkillAtk,"EM_DIAMOND_STORM",10;
      bonus2 bSkillAtk,"EM_TERRA_DRIVE",10;
      bonus2 bSkillAtk,"SO_DIAMONDDUST",3*(.@r/2);
      bonus2 bSkillAtk,"SO_EARTHGRAVE",3*(.@r/2);

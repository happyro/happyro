rachel,151,155,3	script	Kid#2rachel	921,{
	mes "[Kid]";
	mes "Oh wow! I wanna be an";
	mes "adventurer like you when";
	mes "I grow up! Go to all sorts";
	mes "of places, visit different";
	mes "towns. It sounds so fun!";
	next;
	mes "[Kid]";

PACKET.ZC.ACK_RANKING = function PACKET_ZC_ACK_RANKING(fp, end) {
	this.rankType = fp.readShort();
	this.Name = (function () {
		const count = 10,
			out = new Array(count);
		for (let i = 0; i < count; ++i) {
			out[i] = fp.readString(NAME_LENGTH);
		}
		return out;
	})();
	this.Point = (function () {
		const count = 10,
			out = new Array(count);
		for (let i = 0; i < count; ++i) {
			out[i] = fp.readLong();
		}
		return out;
	})();
	this.myPoints = fp.readLong();
};
PACKET.ZC.ACK_RANKING.size = 288;


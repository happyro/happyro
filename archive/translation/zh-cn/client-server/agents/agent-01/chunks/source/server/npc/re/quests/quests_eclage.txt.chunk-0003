		emotion ET_QUESTION, playerattached();
		next;
		mes "[Du Lian]";
		mes "What do you mean?";
		mes "We had that kid following us ever since we entered the city.";
		cutin "bu_du1",2;
		next;
		cutin "",255;
		mes "["+ strcharinfo(0) +"]";
		mes "Huh?!";
		emotion ET_QUESTION, playerattached();
		next;
		mes "[Du Lian]";
		mes "Sure, he's kind of cute too, but we have our cutest Maggi to beat them all!!!";
		cutin "bu_du3",2;
		next;
		mes "[Maggi Steen]";
		mes "...";
		cutin "bu_maggi1",2;
		next;
		mes "[???]";
		mes "...";
		cutin "bu_oliver0",0;
		next;

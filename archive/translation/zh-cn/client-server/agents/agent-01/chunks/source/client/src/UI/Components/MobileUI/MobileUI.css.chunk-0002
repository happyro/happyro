}

#MobileUI #attackButton:active {
	background-color: #4caf50;
	box-shadow: 0px 8px 12px rgba(0, 0, 0, 0.4);
	border: 2px solid #388e3c;
	transition:
		transform 0.2s ease,
		background-color 0.2s ease,
		box-shadow 0.2s ease,
		border 0.2s ease;
}

/* Joystick container -MicromeX */
#MobileUI .joystick-container {
	position: absolute;
	bottom: 7%;
	left: 10%;
	width: 25vmin;
	height: 25vmin;
	z-index: 1000;
}

/* Joystick base -MicromeX */
#MobileUI .joystick-base {
	position: relative;
	width: 100%;
	height: 100%;
	background: rgba(193, 193, 193, 0.33);
	border-radius: 50%;
	display: flex;
	justify-content: center;
	align-items: center;
}

/* Joystick thumb -MicromeX */
#MobileUI .joystick-thumb {
	position: absolute;
	width: 10vmin;
	height: 10vmin;
	background: radial-gradient(circle, rgba(236, 240, 241, 1) 70%, rgba(189, 195, 199, 1) 100%);
	border-radius: 50%;
	box-shadow: 0px 3px 5px rgba(0, 0, 0, 0.4);
	touch-action: none;
	cursor: grab;
}

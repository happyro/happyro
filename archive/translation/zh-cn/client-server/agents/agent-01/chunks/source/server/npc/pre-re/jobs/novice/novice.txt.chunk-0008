					getitem 1504,1; //Mace
					getitem 1010,7; //Phracon
					////getgold 100
					//---------------------------------------------------------------------------------------------------------------------------------------------------
					mes "[Hanson]";
					mes "Please check your inventory to see if you have received all the supplies listed. Let me briefly inform you about the items you've received.";
					next;

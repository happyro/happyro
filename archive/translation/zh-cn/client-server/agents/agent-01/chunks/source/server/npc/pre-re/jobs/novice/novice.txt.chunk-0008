					set nov_3_magician,0;
					set nov_3_acolyte,0;
					set nov_3_merchant,0;
					savepoint "prontera",117,72,1,1;
					warp "prt_church",172,19;
					end;
				case 2:
					callsub S_UserJobchoice,"Acolyte";
					end;
				}
			}
		case 2:
			mes "[Hanson]";
			mes "I understand.";
			mes "Let me transport";
			mes "you to the world of";
			mes "Ragnarok Online";
			mes "immediately.";
			next;
			mes "[Hanson]";
			mes "For more information and knowledge, I hope you will obtain your own experiences in Midgard.";
			next;
			mes "[Hanson]";
			mes "Lastly...";
			mes "I hope you will";
			mes "become a nice player,";
			mes ""+ strcharinfo(0) +".";
			mes "Fare well.";
			next;
			set nov_3_swordman,40;
			set nov_1st_cos,0;
			set nov_2nd_cos,0;

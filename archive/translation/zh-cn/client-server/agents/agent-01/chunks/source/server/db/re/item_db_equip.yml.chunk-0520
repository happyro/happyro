    Gradable: true
    Script: |
      .@g = getenchantgrade();
      .@r = getrefine();
      bonus bMaxHPrate,5;
      bonus bPow,2;
      bonus2 bSkillAtk,"DK_DRAGONIC_BREATH",5;
      if (.@r>=5) {
         bonus2 bSkillAtk,"DK_DRAGONIC_BREATH",10;
         if (.@r>=7) {
            bonus bLongAtkRate,5;
            if (.@r>=9) {
               bonus2 bSkillAtk,"DK_DRAGONIC_BREATH",10;
               if (.@r>=10) {

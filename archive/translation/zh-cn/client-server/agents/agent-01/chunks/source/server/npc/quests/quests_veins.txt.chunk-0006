}

sec_in02,10,43,4	script	Extra Story Patch	809,{
	callfunc "F_GM_NPC";
	mes "[Patch]";
	mes "Yeah, you can try.";
	next;
	if(select("Now:How many?") == 2) {
		input .@input,0,1000;
		set que_sch, .@input;
	}
	mes " ";
	mes ""+que_sch;
	close;
}


		mes "wait, where are you going?";
		close;
	}
	else if (que_sch == 22) {
		mes "[Nosdan]";
		mes "Ah, are you the one";
		mes "that Vitre mentioned";
		mes "in his message? Okay,";
		mes "please give me a moment.";
		next;
		mes "[Nosdan]";
		mes "^333333*Ahem ahem*^000000";
		mes "I'm ready. Now";
		mes "please listen..";
		next;

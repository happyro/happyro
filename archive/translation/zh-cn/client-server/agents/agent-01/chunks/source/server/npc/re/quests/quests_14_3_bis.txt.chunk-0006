		mes "Come on,";
		mes "hurry over to ^0000FFInstructor Rugen^000000!";
		cutin "ep143_tahuk.bmp",2;
		close3;
	}
	if (ep14_3_newerabs == 23) {
		mes "[Tamarin]";
		mes "Thank the gods, who knew that thing I ate out of hunger would save me?";
		mes "Let's report to Barget.";
		cutin "ep143_tahuk.bmp",2;
		close3;

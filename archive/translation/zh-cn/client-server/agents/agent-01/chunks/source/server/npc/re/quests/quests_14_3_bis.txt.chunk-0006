		mes "[Instructor Rugen]";
		mes "Phew...";
		mes "Why were you so reckless?";
		next;
		mes "[Instructor Rugen]";
		mes "Is this worth it?";
		mes "...";
		close;
	}
	if (ep14_3_newerabs == 20) {
		mes "[Instructor Rugen]";
		mes "Phew...";
		mes "Why were you so reckless?";
		next;
		mes "[Instructor Rugen]";
		mes "Is this worth it?";
		mes "...";
		next;
		if (select( "Talk to him.", "No, he looks too upset to talk." ) == 2) {

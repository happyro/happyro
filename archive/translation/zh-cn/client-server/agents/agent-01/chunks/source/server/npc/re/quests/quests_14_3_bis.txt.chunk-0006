	mes "[Tamarin]";
	mes "Arrgh!";
	mes "" + strcharinfo(0) + " get in there before everyone else explores it!";
	cutin "ep143_tahuk.bmp",2;
	next;
	if (select( "Enter.", "Quit." ) == 2) {
		mes "[Tamarin]";
		mes "Ah...";

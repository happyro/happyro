      if (.@r>=5) {
         bonus2 bSkillAtk,"SH_CHUL_HO_SONIC_CLAW",10;
         if (.@r>=7) {
            bonus bLongAtkRate,5;
            if (.@r>=9) {
               bonus2 bSkillAtk,"SH_CHUL_HO_SONIC_CLAW",10;
               if (.@r>=10) {
                  bonus bCritical,10;
                  if (.@r>=11) {
                     bonus2 bSkillAtk,"SH_CHUL_HO_SONIC_CLAW",5;

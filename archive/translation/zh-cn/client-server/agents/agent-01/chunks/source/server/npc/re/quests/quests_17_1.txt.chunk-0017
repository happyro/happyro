	questinfo (QTYPE_QUEST, QMARK_YELLOW, " isbegin_quest(16366) == 1 && isbegin_quest(16371) == 1 ");
	questinfo (QTYPE_QUEST, QMARK_YELLOW, " isbegin_quest(16366) == 1 && isbegin_quest(16372) == 1 ");
	end;
}


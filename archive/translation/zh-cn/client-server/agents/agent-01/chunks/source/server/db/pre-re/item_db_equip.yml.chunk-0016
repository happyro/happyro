      bonus2 bIgnoreDefRaceRate,RC_Player_Human,25;
      bonus bUnbreakableWeapon;
      if (getrefine()>5) {
         bonus2 bAddRace,RC_DemiHuman,(getrefine()-4)*(getrefine()-4);

         bonus2 bIgnoreDefRaceRate,RC_Player_Human,5;
      }
      if (getrefine()>8) {
         if (BaseJob == Job_Knight)
            bonus4 bAutoSpellOnSkill,"KN_PIERCE","NPC_CRITICALWOUND",2,200;
         else if (BaseJob == Job_Crusader)
            bonus3 bAutoSpell,"PA_PRESSURE",5,200;
      }

  - Id: 470173
    AegisName: Flame_Rune_Boots
    Name: 火焰符文长靴
    Type: Armor
    Weight: 1000
    Defense: 45
    Slots: 1
    Locations:
      Shoes: true
    ArmorLevel: 2
    EquipLevelMin: 230
    Refineable: true
    Gradable: true
    Script: |
      .@g = getenchantgrade();
      .@r = getrefine();
      if (.@r>=7) {
         bonus bPAtk,2;
         bonus bAtkRate,5;
         if (.@r>=9) {
            bonus bFixedCast,-300;
            bonus bVariableCastrate,-10;
            if (.@r>=11) {
               bonus bFixedCast,-200;
               bonus bShortAtkRate,10;
            }
         }
      }
      if (.@g>=ENCHANTGRADE_D) {
         bonus bAtkRate,5;
         if (.@g>=ENCHANTGRADE_C) {
            bonus bFixedCast,-300;
            if (.@g>=ENCHANTGRADE_B) {
               bonus bPAtk,5;
               bonus bAtkRate,5;
               if (.@g>=ENCHANTGRADE_A) {
                  bonus bFixedCast,-200;
                  bonus bPAtk,2;
               }
            }
         }
      }

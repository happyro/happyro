alberta,23,238,4	script	Guide#01alberta::AlbertaGuide	105,{
	cutin "prt_soldier",2;
	mes "[艾尔贝塔向导]";
	mes "欢迎来到^8B4513艾尔贝塔^000000，";
	mes "港口城市。";
	mes "需要我帮你熟悉城市吗？";
	F_Navi("[艾尔贝塔向导]");
	next;
	set .@str$,"还要查看其他地点吗？";
	while (1) {
		switch(select("[ 主要设施 ]:[ 商人和助手 ]:[ 目的地港口 ]:移除小地图标记:取消")) {
		case 1:
			set .@loop,1;
			while (.@loop) {
				switch(select("[ 工具店 ]:[ 锻造厂 ]:[ 武器和防具店 ]:[ 旅馆 ]:[ 美容院 ]:[ 商人公会 ]:上一级菜单")) {
				case 1:
					mes "[艾尔贝塔向导]";
					mes "让我标记";
					mes F_Navi("工具店","alberta,98,154","^0000FF");
					mes "在你的小地图上。";
					mes .@str$;
					viewpoint 1,98,154,0,0x0A82FF;
					next;
					break;
				case 2:
					mes "[艾尔贝塔向导]";
					mes F_Navi("锻造厂","alberta,35,41","^B9062F")+"目前";
					mes "位于商人公会大楼内。";
					mes .@str$;
					viewpoint 1,35,41,1,0xFF0000;
					next;
					break;
				case 3:
					mes "[艾尔贝塔向导]";
					mes "让我标记";
					mes F_Navi("武器和防具店","alberta,117,37","^FF5400");
					mes "在你的小地图上。";
					mes .@str$;
					viewpoint 1,117,37,2,0xFFB400;
					next;
					break;
				case 4:
					mes "[艾尔贝塔向导]";
					mes "让我标记";
					mes F_Navi("旅馆","alberta,65,233","^006400");
					mes "在你的小地图上。";
					mes .@str$;
					viewpoint 1,65,233,3,0xAAFF00;
					next;
					break;
				case 5:
					mes "[艾尔贝塔向导]";
					mes "让我标记";
					mes F_Navi("美容院","alberta,48,145","^7F3300");
					mes "在你的小地图上。";
					mes .@str$;
					viewpoint 1,48,145,4,0xD2691E;
					next;
					break;
				case 6:
					mes "[艾尔贝塔向导]";
					mes F_Navi("商人公会","alberta,33,41")+"可以";
					mes "让你转职为 ^800080商人^000000。";
					mes "让我标记它的位置";
					mes "在你的小地图上。";
					mes .@str$;
					viewpoint 1,33,41,5,0xDA70D6;
					next;
					break;
				case 7:
					set .@loop,0;
					break;
				}
			}
			break;
		case 2:
			set .@loop,1;
			while (.@loop) {
				switch(select("[ 伊甸园传送人员 ]:[ 卡普拉员工 ]:[ 酷炫活动公司员工 ]:[ 子弹商人 ]:[ 烹饪材料商人 ]:上一级菜单")) {
				case 1:
					mes "[艾尔贝塔向导]";
					mes "^B9062F伊甸园传送人员^000000位于"+F_Navi("艾尔贝塔南部","alberta,121,68");
					mes "以及"+F_Navi("商人公会","alberta,33,41")+"大楼内。";
					mes "让我在你的小地图上标记他们的位置。";
					mes .@str$;
					viewpoint 1,33,41,6,0xFF0000;
					viewpoint 1,121,68,7,0xFF0000;
					next;
					break;
				case 2:
					mes "[艾尔贝塔向导]";
					mes "让我标记";
					mes "^0000FF卡普拉员工^000000";
					mes "在你的小地图上。";
					mes .@str$;
					viewpoint 1,33,41,8,0x0A82FF;
					viewpoint 1,113,60,9,0x0A82FF;
					next;
					break;
				case 3:
					mes "[艾尔贝塔向导]";
					mes "赢得活动物品后，";
					mes "可以通过"+F_Navi("酷炫活动公司员工","alberta,148,57","^FF5400")+"领取。";
					mes .@str$;
					viewpoint 1,148,57,10,0xFFB400;
					next;
					break;
				case 4:
					mes "[艾尔贝塔向导]";
					mes "^7F3300神枪手^000000的^7F3300子弹商人^000000";
					mes "位于";
					mes F_Navi("城市中心","alberta,117,158")+"附近。";
					mes .@str$;
					viewpoint 1,117,158,11,0xD2691E;
					next;
					break;
				case 5:
					mes "[艾尔贝塔向导]";
					mes "艾尔贝塔的"+F_Navi("厨师助手","alberta,167,135","^006400")+"";
					mes "有很多常客，";
					mes "尤其喜欢他的^006400美味鱼料理^000000。";
					mes .@str$;
					viewpoint 1,167,135,12,0xAAFF00;
					next;
					break;
				case 6:
					set .@loop,0;
					break;
				}
			}
			break;
		case 3:
			set .@loop,1;
			while (.@loop) {
				switch(select("[ 港口 - 北码头 ]:[ 港口 - 中央码头 ]:[ 港口 - 南码头 ]:上一级菜单")) {
				case 1:
					mes "[艾尔贝塔向导]";
					mes "你可以使用"+F_Navi("北码头","alberta,192,196");
					mes "前往^0000FF马来港^000000或^0000FF德瓦塔^000000。";
					mes .@str$;
					viewpoint 1,192,196,13,0xFF0000;
					next;
					break;
				case 2:
					mes "[艾尔贝塔向导]";
					mes "你可以使用"+F_Navi("中央码头","alberta,192,151");
					mes "前往^B9062F沉船^000000或^B9062F伊兹鲁德码头^000000。";
					mes .@str$;
					viewpoint 1,192,151,14,0xFF0000;
					next;
					break;
				case 3:
					mes "[艾尔贝塔向导]";
					mes "你可以使用"+F_Navi("南码头","alberta,245,86");
					mes "前往^0000FF海龟岛^000000、^0000FF巴西利斯^000000、^0000FF天津^000000、^0000FF昆仑^000000、^0000FF莫斯科比亚^000000、^0000FF洛阳^000000或^0000FF艾尔帕兰^000000。";
					mes .@str$;
					viewpoint 1,245,86,15,0xFF0000;
					next;
					break;
				case 4:
					set .@loop,0;
					break;
				}
			}
			break;
		case 4:
			mes "[艾尔贝塔向导]";
			mes "好的，我会移除你小地图上的所有标记。";
			mes "还有其他我能帮你的吗？";
			viewpoint 2,1,1,0,0xFFFF00;
			viewpoint 2,1,1,1,0x000000;
			viewpoint 2,1,1,2,0xFF0000;
			viewpoint 2,1,1,3,0xFFFF00;
			viewpoint 2,1,1,4,0xFFFF00;
			viewpoint 2,1,1,5,0xFFFF00;
			viewpoint 2,1,1,6,0xFFFF00;
			viewpoint 2,1,1,7,0xFFFF00;
			viewpoint 2,1,1,8,0xFFFF00;
			viewpoint 2,1,1,9,0xFFFF00;
			viewpoint 2,1,1,10,0xFFFF00;
			viewpoint 2,1,1,11,0xFFFF00;
			viewpoint 2,1,1,12,0x000000;
			viewpoint 2,1,1,13,0xFFFF00;
			viewpoint 2,1,1,14,0xFFFF00;
			viewpoint 2,1,1,15,0xFFFF00;
			next;
			break;
		case 5:
			mes "[艾尔贝塔向导]";
			mes "祝你在这里过得愉快。";
			close2;
			cutin "prt_soldier",255;
			end;
		}
	}
}
alberta,120,60,3	duplicate(AlbertaGuide)	Guide#02alberta	105
alberta,184,143,4	duplicate(AlbertaGuide)	Guide#03alberta	105

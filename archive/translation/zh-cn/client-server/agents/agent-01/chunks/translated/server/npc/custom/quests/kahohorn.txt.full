//===== rAthena Script =======================================
//= Lord Kaho's Horns Quest
//===== By: ==================================================
//= ?
//===== Current Version: =====================================
//= 1.1
//===== Compatible With: =====================================
//= rAthena Project
//===== Description: =========================================
//= Custom quest for Lord Kaho's Horns.
//===== Additional Comments: =================================
//= 1.1 Optimized, and fixed some requirements. [Euphy]
//============================================================

geffen,115,107,5	script	Lord Kaho's Servant	61,{

	setarray .@Items[0],7005, 968, 923, 734, 724,2268,7036,7020,5053,7018,741,742,743,750,751,752,753,754;
	setarray .@Drops[0],1272,1087,1039,1260,1046,1115,1252,1147,1038,1059;
	set .@n$, "[Lord Kaho's Servant]";

	mes .@n$;
	mes "为了满足 Kaho 大人对头饰的荒唐要求，我差点累死！";
	mes "现在我终于找到了完美头饰的配方，愿意分享我的时间和才能。";
	next;
	mes .@n$;
	mes "要获得 Kaho 之角，需要以下物品：";
	mes "3x ^0055FFEmperium^000000";
	next;
	mes .@n$;
	mes "对了……";
	mes "我还忘了提到这些……";
	next;
	mes .@n$;
	for(set .@i,0; .@i<10; set .@i,.@i+1)
		mes "1 个^0055FF"+getitemname(.@Items[.@i])+"^000000（来自"+getmonsterinfo(.@Drops[.@i], MOB_NAME)+"）";
	next;
	mes .@n$;
	mes "还没结束呢，亲爱的……";
	mes "我很喜欢玩偶，所以你得带来这些可爱的小家伙！";
	for(set .@i,10; .@i<18; set .@i,.@i+1)
		mes "1x ^0055FF"+getitemname(.@Items[.@i])+"^000000";
	next;
	mes .@n$;
	mes "最后，我会用上述所有物品努力为主人制作这对角……";
	mes "请为我的努力支付 ^0055FF500 万 Zeny^000000。"; 
	next;
	mes .@n$;
	mes "准备好让我制作这件特殊物品了吗？";
	next;
	if(select("当然准备好了！:这些要求太离谱了！")==2) {
		mes .@n$;
		mes "我经历的事情更加离谱……";
		mes "如果你成功收集这些物品，就会获得惊人的力量！";
		close; }
	mes .@n$;
	for(set .@i,0; .@i<18; set .@i,.@i+1)
		if (!countitem(.@Items[.@i])) { set .@nr,1; break; }
	if (.@nr || countitem(714) < 3 || Zeny < 5000000) {
		mes "如果你不带齐材料，我无法负担制作成本。请理解，这是为了造福你这样的英雄！";
		close; }
	for(set .@i,0; .@i<18; set .@i,.@i+1)
		delitem .@Items[.@i],1;
	delitem 714,3;
	set Zeny, Zeny-5000000;
	mes "哇！你真勇敢！";
	getitem 5013,1;
	mes "享受成为米德加尔特之神的感觉吧！";
	close;
}

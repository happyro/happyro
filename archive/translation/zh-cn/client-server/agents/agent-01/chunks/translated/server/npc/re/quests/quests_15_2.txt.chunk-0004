			ep15_2_bslast = 8;
		}
		close3;
	}
	mes "[Du]";
	mes "哇……这是什么地方？";
	cutin "bu_du1.bmp",2;
	next;
	mes "[Mark]";
	mes "真是个可疑的地方……";
	mes "没想到防空洞里还有这样的空间……";
	cutin "bu_mark1.bmp",0;
	close3;
}

un_myst,333,206,3	script	Weird piece#01	4_GC109,{
	if (ep15_2_bslast < 8) {
		mes "这里有一块奇怪的碎片。";
		close;
	}
	if (ep15_2_bsmemo == 1) {// A
		mes "我不知道进入这里多久了。";
		mes "在黑暗中，我对时间的感觉越来越模糊，大家也很快疲惫起来。";
		next;
		mes "他们不清楚外面的情况，却在谈论逃出去……这是正确的选择吗？";
		next;
		mes "但我们已经找不到回去的路了。";
		mes "是的……这不是逃离。";
		mes "只是为了生存而逃跑……";
		next;
		mes "我们还能跑多久？";
		close2;
		if (ep15_2_bslast < 9) {
			completequest 11388;
			setquest 11389;// Vestige
		}
		warp "un_myst",260,204;
		ep15_2_bsmemo = 2;
		end;
	}
	if (ep15_2_bsmemo == 2) {
		mes "虽然我已经做好准备，但情况正在恶化。";
		mes "我只能说，如果继续留在那里，我肯定活不下来。";
		next;
		mes "希望……";
		next;
		mes "很多人已经无法抱有希望……";
		close2;
		warp "un_myst",260,204;
		ep15_2_bsmemo = 3;
		end;
	}
	mes "按计算我们现在应该已经出去了，但眼前仍然只有泥土。";
	next;
	mes "计算可能出错了，我们也许一直在绕圈。";
	mes "感觉不太对。";
	next;
	mes "不……";
	mes "从那天起我就一直无法安心。";
	close2;
	warp "un_myst",347,138;
	if (ep15_2_bsmemo == 3)
		ep15_2_bsmemo = 4;
	end;
}

un_myst,182,137,3	script	Weird piece#02	4_GC109,{
	if (ep15_2_bsmemo < 4) {
		mes "这里有一块奇怪的碎片。";
		close;
	}
	if (ep15_2_bsmemo == 4) {// B
		mes "我可能已经到极限了。";
		mes "现在身体过度疲惫，不听使唤，也只能怪我自己。";
		next;
		mes "幸存者的人数正在减少。";
		next;
		mes "这样下去……";
		mes "我以为自己看到的是终结，也许这就是报应……";
		mes "或许是因为我的自私。";
		mes "我想自己已经没有多少时间了……";
		close2;
		warp "un_myst",86,136;
		ep15_2_bsmemo = 5;
		end;
	}
	if (ep15_2_bsmemo == 5) {
		mes "现在连走路都很困难。";
		next;
		mes "我曾经自信地说要带领大家……";
		mes "没能帮上忙，反而成了负担，我觉得自己很可悲。";
		next;
		mes "一切都令人后悔。";
		mes "我开始的一切……";
		mes "属于我的一切……";
		close2;
		warp "un_myst",86,136;
		ep15_2_bsmemo = 6;
		end;
	}
	if (ep15_2_bsmemo == 6) {
		mes "放弃我也许更好……";
		close2;
		warp "un_myst",86,136;
		ep15_2_bsmemo = 7;
		end;
	}
	mes "现在睡着的日子比醒着的日子更多。";
	next;
	mes "在越来越模糊的意识中，我突然想起他的脸。";
	next;
		mes "塔蒂奥……";
	next;
	mes "他是对我很温柔的人，尽管我过去只在乎工作。";
	next;
	mes "哈……人……";
	mes "我把他当成成功的项目，想到过去的自己就感到羞耻，无法忍受。";
	next;
	mes "虽然我可能会死在这里……";
	mes "但至少要向他道歉……";
	mes "至少说一句温柔的话，我就有了活下去的念头。";
	next;
	mes "……可能做到吗？";
	close2;
	warp "un_myst",14,92;
	if (ep15_2_bsmemo == 7)
		ep15_2_bsmemo = 8;
	end;
}

un_myst,214,86,3	script	Weird piece#03	4_GC109,{
	if (ep15_2_bsmemo < 8) {
	mes "这里有一块奇怪的碎片。";
		close;
	}
	if (ep15_2_bsmemo < 16) {
		if (ep15_2_bsmemo == 8)// C
			mes "01001000010001010100110001001100010011110101011101001111010100100100110001000100";
		else if (ep15_2_bsmemo == 9)
			mes "01001001010000010100110101000110010010010100111001000101";
		else if (ep15_2_bsmemo == 10)
			mes "@#$%&!#...";
		else if (ep15_2_bsmemo == 11)
			mes "调试中";
		else if (ep15_2_bsmemo == 12) {
			mes "文件……错误……恢复……";
			mes "操作……进度……25%……30%……35%……";
		}
		else if (ep15_2_bsmemo == 13)
			mes "45%……50%……最低限度的正常操作可用，开始安全模式操作。";
		else if (ep15_2_bsmemo == 14)
			mes "60% 移动速度正常。身体机能正常。";
		else if (ep15_2_bsmemo == 15)
			mes "70% 大部分语言功能恢复。出现轻微败血性贫血症状，但似乎很快就能修复。";
		close2;
		warp "un_myst",160,89;
		ep15_2_bsmemo++;
		end;
	}
	if (ep15_2_bsmemo == 16) {
		mes "80% 尽管没有充分准备，手术仍相当成功。";
		mes "计划以这次成功为基础，为其他幸存者进行治疗。";
		close2;
		warp "un_myst",209,33;
		ep15_2_bsmemo = 17;
		end;
	}
	mes "98% 检测到损坏扇区。";
	mes "为了更高效地运行，我复制了内存芯片并构建了‘T_W_O_002b’。";
	mes "复制过程中似乎丢失了一些数据……";
	close2;
	warp "un_myst",209,33;
	end;
}

un_myst,209,42,3	script	Tamarin#Lastroom Entrance	4_M_TAMARIN,{
	if (checkweight(1119,3) == 0) {
		mes "- 你携带的物品太多，无法继续任务。-";
		close;
	}
	mes "[Tamarin]";
	mes "……看来最后的幸存者一直留在这里……";
	cutin "ep143_taang.bmp",2;
	next;
	mes "[Tamarin]";
	mes "不知为什么，我害怕打开下一扇门。";
	next;
	if (ep15_2_bsmemo == 17) {
		select("打开门。");
		if (ep15_2_bslast < 9) {
			ep15_2_bslast = 9;
			ep15_2_bsmemo = 18;
			completequest 11389;// Vestige
			getexp 0,1000000;
			getitem 6827,1;// Normal_Parts
			getitem 6828,1;// Gravity_Parts
		}
		close2;
		warp "un_myst",142,38;
		end;
	}
	.@s = select( "打开门。", "出去。" ) - 1;
	mes "[Tamarin]";
	mes "有一种苦涩的感觉……";
	close2;
	if (.@s == 0)
		warp "un_myst",142,38;
	else
		warp "un_bunker",98,91;
	end;
}

verus01,123,181,3	script	Verity#Warper	4_F_BERRYTEA,{
	mes "[Verity]";
	mes "你好。";
	mes "你是来调查地下防空洞的吗？";
	cutin "EP15_2_brt_2.bmp", 2;
	next;
	switch( select( "是", "不是。", "使用重力安全装置" ) ) {
	case 1:
		mes "[Verity]";
		mes "下面似乎非常危险，请小心。";
		cutin "EP15_2_brt_1.bmp",2;
		next;
		mes "[Verity]";
		mes "考虑到出现了其他区域没有的怪物，这里一定……";
		cutin "EP15_2_brt_3.bmp",2;
		close2;
		warp "un_bunker",98,91;
		end;
	case 2:
		break;
	case 3:
		mes "[Verity]";
		mes "使用重力安全装置，就能轻松到达最后房间的入口。";
		cutin "EP15_2_brt_1.bmp",2;
		next;
		if (select( "使用。", "退出。" ) == 1) {
			mes "[Verity]";
			if (countitem(6828) < 1) {
				mes "看来你没有携带重力安全装置。";
				close3;
			}
			delitem 6828,1;// Gravity_Parts
			close2;
			warp "un_myst",142,38;
			end;
		}
		break;
	}
	mes "[Verity]";
	mes "是这样吗？";
	mes "嗯……";
	cutin "EP15_2_brt_1.bmp",2;
	close3;
}


// Others
verus03,167,257,5	script	Access Controller Damhw#atnd02	4_M_LGTGUARD,{
	.@visible_name$ = strnpcinfo(1);
	if (.@visible_name$ == "Access Controller Damhw")
		.@npc_name$ = "Damhwa";
	else if (.@visible_name$ == "Access Controller Geuma")
		.@npc_name$ = "Geuman";
	else
		.@npc_name$ = "Gyuhwa";

	switch( isbegin_quest(7641) ) {
	case 0:
		mes "[" + .@npc_name$ + "]";
	mes "抱歉，只有获得许可的挖掘队成员才能进入。";
	mes "和现在的挖掘队一起努力，你就能获得许可。";
		close;
	case 1:
		mes "[" + .@npc_name$ + "]";
	mes "这里只有获得许可的成员才能进入。";
	mes "你是从哪里来的？";
		next;
		if (select("我来自阿特纳德挖掘队", "为什么禁止我进入？") == 1) {
			mes "[" + .@npc_name$ + "]";
		mes "啊，你是阿特纳德挖掘队的成员。";
		mes "是的，我已经在名单上确认了你的身份。";
		mes "阿特纳德挖掘队成员可以进入。";
			next;
			select("为什么禁止进入？");
		}
		mes "[" + .@npc_name$ + "]";
	mes "维鲁斯城分为四个大区域。";
	mes "你知道吗？";
		next;
		mes "[" + .@npc_name$ + "]";
	mes "目前开放的区域是城镇和广场。";
	mes "虽然原因不明，但这里已经封锁并禁止进入。";
		next;
		mes "[" + .@npc_name$ + "]";
	mes "在招募挖掘队之前的企业独立调查中，";
	mes "我们发现这里发生过大爆炸，为了确认区域安全，";
	mes "需要进行一段时间的检查。";
		next;
		mes "[" + .@npc_name$ + "]";
	mes "目前这里除了地形危险以及可能遭到机器攻击外，并不被认为有很大风险，";
	mes "但和广场一样，所以只有挖掘队可以进入。";
		next;
		mes "[" + .@npc_name$ + "]";
	mes "请注意，许可也包括西侧相连的区域。";
		next;
		mes "[" + .@npc_name$ + "]";
	mes "总之，既然你获得了许可，以后可以自由进入。";
	mes "那么我期待你取得好成果！";
		completequest 7641;// Access Permitted (note : player can enter in verus01 without this quest)
		close;
	case 2:
		mes "[" + .@npc_name$ + "]";
	mes "研究和调查进行得怎么样？";
	mes "限制区域里的机器相当危险，请小心。";
		close;
	}
	end;

OnInit:
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "isbegin_quest(7641) == 1" );
	end;
}
verus03,172,257,3	duplicate(Access Controller Damhw#atnd02)	Access Controller Gyuhw#atnd03	4_M_LGTGUARD
verus03,52,250,5	duplicate(Access Controller Damhw#atnd02)	Access Controller Geuma#atnd01	4_M_LGTGUARD

verus03,55,245,3	script	Rekenber Scholar#e152a01	2_M_MOLGENSTEIN,{
	mes "[Rekenber Scholar]";
	mes "嗯……这台机器似乎曾用来追踪某种东西。";
	mes "你觉得呢？";
	next;
	mes "[Rekenber Technician]";
	mes "我也这么认为。";
	mes "这个屏幕可能显示了它追踪或检测对象的位置或状态。";
	next;
	mes "[Rekenber Scholar]";
	mes "它显示的或许是这个封锁区域的情况？";
	mes "根据之前的内部情况推测，当时不可能直接进入。";
	next;
	mes "[Rekenber Technician]";
	mes "大概是这样。";
	mes "仅凭观察就能推测这里发生过大爆炸……";
	mes "那么外面的人安装这种东西的原因就是……";
	next;
	mes "[Rekenber Scholar]";
	mes "是的。为了了解内部情况。";
	mes "也许发生过重大事故，所以是为了寻找幸存者……";
	next;
	mes "[Rekenber Technician]";
	mes "确实。你可能是对的。";
	mes "而我们的任务就是找出这里发生过什么的秘密。";
	close;

}
verus03,55,243,3	duplicate(Rekenber Scholar#e152a01)	Rekenber technician#e152a02	4_M_REPAIR

verus03,59,250,7	script	Coral Excavation team C#e152a03	2_M_SAGE_B,{
	mes "[Cecil]";
	mes "嘿，科贝尔。如果我们想被选为优秀挖掘队……！";
	next;
	mes "[Kobell]";
	mes "被选为……？";
	next;
	mes "[Cecil]";
	mes "就要查明这些未知机械装置的身份！";
	next;
	mes "[Kobell]";
	mes "什么？怎么会这样？";
	mes "我们甚至都不是工程专业的！";
	next;
	mes "[Cecil]";
	mes "这里到处都是机器！如果能分析它们，我们就能像阿特纳德挖掘队一样获得认可！";
	next;
	mes "[Kobell]";
	mes "啊哈！确实如此。";
	mes "不过我觉得阿特纳德挖掘队就在附近……？";
	next;
	mes "[Cecil]";
	mes "哈！不能让别人发现我们的研究目标。这是你我之间的秘密！";
	next;
	mes "[Kobell]";
	mes "就这么办~";
	close;
}
verus03,61,250,7	duplicate(Coral Excavation team C#e152a03)	Coral Excavation team C#e152a04	4_M_ALCHE_C


//- Krotzel's Request
verus02,79,31,4	script	Krotzel#1	4_F_HUWOMAN,{
	if (ep15_1_atnad < 19)
		end;
	mes "[Krotzel]";
	switch(ep15_2_brigan) {
	case 0:
	mes "我是《月刊布里甘》的资深记者克罗策尔！随着这里被公开，越来越多的冒险者聚集到了这里。";
		next;
		mes "[Krotzel]";
	mes "普通冒险者获得的信息并不多。所以我们亲自采访冒险者！亲自跑腿收集情报。";
		next;
		mes "[Krotzel]";
	mes "如果你有可靠情报，请告诉我们。如果情报有价值，我们会给你小小的奖励。";
		next;
		mes "[Krotzel]";
	mes "我们是谁？我们是《月刊布里甘》的冒险队 2 队……";
		next;
		mes "[Krotzel]";
		mes "...?";
		next;
		mes "[Krotzel]";
	mes "大家都去哪儿了？真是一群麻烦鬼！冒险队 2 队由两名资深记者、一名老手和一名实习记者组成，共四个人。";
		next;
		mes "[Krotzel]";
	mes "我负责采访和整理报道，我的同事负责拍照。资深老手负责带路。作为专门报道冒险的杂志，我们经常前往危险的地方。";
		next;
		mes "[Krotzel]";
	mes "虽然我并非完全没有战斗经验，但我的专长是报道！不过大家到底去哪儿了？不知道的还以为我们来野餐呢！";
		ep15_2_brigan = 1;
		close;
	case 1:
	mes "我最担心那名实习成员。他还是新人，什么都不懂。很可能是跟着资深老手走了。方便的话，你能找到他吗？";
		next;
	if (select( "寻找实习记者", "太忙了" ) == 1) {
			mes "[Krotzel]";
			mes "非常感谢。如果他跟着资深老手，可能去了废墟区域。我看到他用清澈的眼睛看着那位老手。";
			next;
			mes "[Krotzel]";
			mes "我会在这附近找找。你不用把他带回来。虽然他还在实习期，但也该知道如何独自工作！找到他后告诉我他在哪里就行。";
			close2;
			setquest 13195;// Monthly Brigan
			ep15_2_brigan = 2;
			end;
		}
		close;
	case 2:
		mes "如果她跟着资深老手，可能去了废墟区域。找到她后请告诉我她在哪里。";
		close;
	case 3:
		mes "果然如此。至少他平安，我就放心了。方便的话，你也能找到我的同事金桑妮吗？";
		next;
		mes "[Krotzel]";
		mes "我们加入后相处得很好，最后还组建了队伍，所以我不免担心她。";
		next;
		mes "[Krotzel]";
		mes "她一到这里就开始唱建筑风格的歌，所以应该就在这附近。";
		close2;
		setquest 13196;// Monthly Brigan
		ep15_2_brigan = 4;
		end;
	case 4:
		mes "我们加入后相处得很好，最后还组建了队伍，所以我不免担心他。";
		next;
		mes "[Krotzel]";
		mes "他一到这里就开始唱建筑风格的歌，所以应该就在这附近。拜托你了。";
		close;
	case 5:
		mes "大家会担心也是没办法的事。最后一位资深记者，格里兹利·格里尔斯！指定的生存记者！";
		next;
		mes "[Krotzel]";
		mes "因为他在哪里都能活下来，这个外号就传开了，但说实话他没有战斗天赋，只是运气好。";
		next;
		mes "[Krotzel]";
		mes "虽然我觉得他应该安全……你能查查他在哪里吗？他可能跑到那边的废墟去了……";
		close2;
		setquest 13197;// Monthly Brigan
		ep15_2_brigan = 6;
		end;
	case 6:
		mes "帮我找到无论哪里都能生存的资深记者格里兹利·格里尔斯。我想他可能在东边的废墟里……";
		next;
		mes "[Krotzel]";
		mes "说起来，他和我以前采访过的一位公会会长很像。总是跳进危险里，不管怎样都能回来……一开始避开危险不是更好吗！";
		close;
	case 7:
		mes "太好了！大家都平安。每个人都会自己写一篇新闻，对吧？";
		next;
		mes "[Krotzel]";
		mes "如果他们明天还不回来，我就该去找他们了。";
		close2;
		setquest 13199;// Krotzel's Request - Complete
		getexp 1500000,1000000;
		ep15_2_brigan = 8;
		end;
	default:
		break;
	}
	switch( checkquest(13199,PLAYTIME) ) {
	case -1:
	case 2:
		switch( isbegin_quest(13198) ) {
		case 0:
			mes "你就是上次见过的冒险者！我们的队员还没回来，我很担心。方便的话，你能确认他们是否安全吗？";
			next;
			switch( select( "寻找队员", "现在不是好时机", "交谈" ) ) {
			case 1:
				mes "[Krotzel]";
				mes "他们都有专业精神，如果还没完成工作，就先确认他们是否安全。";
				if (isbegin_quest(13199) > 0)
					erasequest 13199;// Krotzel's Request - Complete
				setquest 13195;// Monthly Brigan

		mes "如果再有一阵巨浪撞上";
		mes "这艘船，我感觉它可能会";
		mes "碎成一片！";
		next;
		mes "[伊万诺夫先生]";
		mes "祝你好运。希望你";
		mes "能平安无事地回来。";
		mes "我会为你祈祷。";
		mes "下次再见。";
		mos_whale_edq = 30;
		close2;
		warp "mosk_fild01",93,94;
		if (isbegin_quest(18115))
			changequest 18115,18116;
		end;
	}
	mes "[伊万诺夫先生]";
	mes "什么？你怎么上了";
	mes "这艘船？？你……算了。";
	mes "这次我就原谅你，但现在";
	mes "赶紧回去。";
	close2;
	warp "moscovia",163,55;
	end;

S_D_1:
	if (rand(1,getarg(0)) == 3) {
		.@ship2 = rand(4);
		setarray .@d$[0],"东","西","南","北";
		mes "[伊万诺夫先生]";
		mes "嗯。海流变了。";
		mes "把船舵向前调整到";
		mes .@d$[.@ship2]+"，顺着海流前进。";
		mos_whale_edq = getarg(.@ship2+1);
		close;
	}
	mes "[伊万诺夫先生]";
	mes "还没有……水流";
	mes "没有任何变化。没有什么";
	mes "值得注意的……";
	next;
	mes "[伊万诺夫先生]";
	mes "我们暂时最好继续朝这个方向航行。";
	close;

S_D_2:
	setarray .@d$[0],"东","西","南","北";
	mes "[伊万诺夫先生]";
	mes "喂！";
	mes "你没听见我说话吗？";
	mes "把船舵向前调整到";
	mes .@d$[getarg(0)]+"，顺着海流前进！";
	close;
}

//----------------------------------------------------------------------------
// Rudder
//----------------------------------------------------------------------------
mosk_ship,101,111,4	script	rudder#ship	HIDDEN_NPC,{
	if (mos_whale_edq == 5)
		callsub S_Rud1,1,0;
	else if (mos_whale_edq == 4) {
		mes "[伊万诺夫先生]";
		mes "现在不用调整船舵。";
		mes "等我的指示。";
		close;
	} else if (mos_whale_edq == 6) {
		mes "[伊万诺夫先生]";
		mes "现在还不要调整船舵。";
		mes "只有我下令时，";
		mes "你才能调整船舵。";
		close;
	} else if ($@mos1_edq > 0) {
		mes "[伊万诺夫先生]";
		mes "我们得确保杀掉船上的";
		mes "所有怪物。";
		close;
	} else if (mos_whale_edq == 7)
		callsub S_Rud1,4,1;
	else if (mos_whale_edq == 8 || mos_whale_edq == 21 || mos_whale_edq == 23) {
		mes "[伊万诺夫先生]";
		mes "现在还不要调整船舵。";
		mes "只有我下令时，";
		mes "你才能调整船舵。";
		close;
	} else if (mos_whale_edq >= 91 && mos_whale_edq <= 94)
		callsub S_Rud1, (mos_whale_edq -90), 2;
	else if (mos_whale_edq > 10 && mos_whale_edq < 13) {
		mes "[伊万诺夫先生]";
		mes "看……海的那边！";
		mes "你有没有看到什么东西";
		mes "在神秘地移动？";
		next;
		mes "[伊万诺夫先生]";
		mes "嘿嘿……那是什么……";
		mes "那个……喂！你……";
		mes "绕到甲板另一边看清楚些！";
		mes "快去！";
		close;
	} else if (mos_whale_edq == 20)
		callsub S_Rud1,1,0;
	else if (mos_whale_edq == 22)
		callsub S_Rud1,4,1;
	else if (mos_whale_edq >= 241 && mos_whale_edq <= 243)
		callsub S_Rud1, (mos_whale_edq -240), 2;
	else if (mos_whale_edq == 244)
		callsub S_Rud1,4,1;
	else if (mos_whale_edq == 25) {
		mes "[伊万诺夫先生]";
		mes "你可以调整船舵，";
		mes "但要听从我的指示。";
		close;
	} else if (mos_whale_edq == 26) {
		mes "[伊万诺夫先生]";
		mes "喂！听我说话。";
		mes "你怎么能未经我的";
		mes "允许就去那里……";
		//next;
		close;
	}
	mes "[伊万诺夫先生]";
	mes "什么？你怎么上了";
	mes "这艘船？？你……算了。";
	mes "这次我就原谅你，但现在";
	mes "赶紧回去。";
	close2;
	//mos_whale_edq = 4;
	warp "moscovia",162,56;
	end;

S_Rud1:
	.@direction = getarg(0);
	.@monster_setting = getarg(1);

	mes "往哪个方向？";
	next;
	setarray .@d$[1],"东","西","南","北";
	.@j = select(implode(.@d$,":")) -1;
	if (.@j == .@direction) {
		mes "[伊万诺夫先生]";
		mes "很好。首先，我们应该";
		mes "继续朝"+ strtolower(.@d$[.@direction]) +"方向前进。";
		mes "等我下令时，";
		mes "请再次调整船舵。";
		if (.@monster_setting == 2) .@r = rand(1,4);
		if (.@monster_setting == 2 && .@r == 3) {
			next;
			mes "[伊万诺夫先生]";
			mes "等等！前面出现了什么东西……";
			next;
			mes "[伊万诺夫先生]";
			mes "怪物！！！";
			next;
			mes "[伊万诺夫先生]";
			mes "这些怪物是我从未遇到过的类型！";
			mes "小心！我们必须击退这些怪物！";
			mes "一定要把它们赶走！";
			$@mos1_edq++;
			if (mos_whale_edq >= 241)
				donpcevent "Baehideun4#ship::OnEnable";
			else
				donpcevent "Baehideun3#ship::OnEnable";
		}
		mos_whale_edq = (.@monster_setting == 2)?((mos_whale_edq >= 241)?((.@r != 3)?26:25):((.@r != 3)?10:11)):(mos_whale_edq + 1);
		close;
	}
	mes "[伊万诺夫先生]";
	mes "我说过我们应该向"+ .@d$[.@direction] +"前进！";
	mes "你应该朝正确的";
	mes "方向航行！向"+ strtolower(.@d$[.@direction]) +"！";
	if (.@monster_setting >= 1) {
		.@r = (.@monster_setting == 1)?5:4;
		if (rand(1,.@r) <= 2) {
			next;
			mes "[伊万诺夫先生]";
			mes "不好！怪物出现了！";
			mes "准备战斗！快！";
			$@mos1_edq++;
			donpcevent "Baehideun1#ship::OnEnable";
		}
	}
	close;
}

//----------------------------------------------------------------------------
// Aged Stranger - Whale Island
//----------------------------------------------------------------------------
mosk_fild01,86,104,3	script	Aged Stranger#npc	4_M_GUSLIMAN,{
	if ((MaxWeight-Weight) < 2000) {
		mes "[老者]";
		mes "你携带的物品太多了。";
		mes "请使用卡普拉服务后再来。";
		close;
	}
	if (mos_whale_edq == 13) {
		mes "[老者]";
		mes "哦，你醒了。";
		mes "感觉怎么样？没事吧？？";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "嗯……这……里是……";
		mes "呃！发生了什么……？";
		next;
		mes "[老者]";
		mes "嗯……你可真让人";
		mes "意外！我已经很久没";
		mes "和生活在陆地上的人";
		mes "说过话了……";
		mes "真的很久了。";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "我在哪里？";
		mes "老人家，你是谁？";
		next;
		mes "[老者]";
		mes "这里……嗯……";
		mes "该怎么说呢……";
		mes "大多数人把这里称为";
		mes "移动岛。";
		next;
		mes "[老者]";
		mes "这是一座只有我居住的小岛。";
		next;
		mes "[老者]";
		mes "我称它为……";
		mes "鲸鱼岛。";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "这里就是大名鼎鼎的";
		mes "移动岛！但是……这座";
		mes "岛难道是……";
		next;
		mes "[老者]";
		mes "现在明白了吧？哈哈哈！";
		mes "没错。我们正站在";
		mes "一头巨鲸的背上！";
		mes "所以我才叫它鲸鱼岛！";
		// if (isbegin_quest(18109))
		// 	changequest 18109,18110;
		next;
		mes "["+strcharinfo(0)+"]";
		mes "怎么……？怎么可能";
		mes "有水流在这里流淌？";
		mes "树木还在鲸鱼的背上";
		mes "生长？！";
		next;
		mes "[老者]";
		mes "嘿嘿嘿。这是一座";
		mes "传说中的岛屿。此刻你正在";
		mes "体验伟大之处！哈哈哈哈！";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "你是真正的人类吗？";
		next;
		mes "[老者]";
		mes "嘿嘿，如你所见，";
		mes "我只是个老人。";
		mes "我只是悠闲地在这里度过一生，";
		mes "与尘世的一切";
		mes "断绝了联系。";
		next;
		mes "[老者]";
		mes "好了，现在振作起来。";
		mes "我会把你送回陆地。";
		mes "如果不尽快回去，";
		mes "可能会有人担心。";
		next;
		soundeffect "mos_gusli1.wav",0;
		mes "-老人弹奏陌生乐器时，";
		mes "小岛开始缓缓移动……-";
		mes "-";
		next;
		mes "[老者]";
		mes "几分钟后你就会回到";
		mes "出发的陆地。";
		mes "放松些吧。";
		next;
		callsub S_AS_3;
		mos_whale_edq = 14;
		if (isbegin_quest(18109))
			changequest 18109,18110;
		close2;
		sleep2 20000;
		mos_whale_edq = 15;
		end;
	} else if (mos_whale_edq == 14) {
		callsub S_AS_3;
		mos_whale_edq = 15;
		close;
	} else if (mos_whale_edq == 15) {
		mes "[老者]";
		mes "嗯……快到了……";
		mes "年轻人，几分钟后你就会回到";
		mes "大陆。路上小心。";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "老人家，如果我想再回到";
		mes "这里，该怎么做？";
		next;
		mes "[老者]";
		mes "嘿嘿……你想再来这里？";
		mes "来这里？来我独自生活的";
		mes "这座小岛？你真";
		mes "有趣……";
		next;
		mes "[老者]";
		mes "如果我们命中注定会相遇，";
		mes "就一定会再次在这里见面，";
		mes "不是吗？嘿嘿嘿……";
		next;
		mes "[老者]";
		mes "是时候……嗯，";
		mes "平安回去了。将来如果你";
		mes "想再来见我，";
		mes "就再经历一次上次那样的海上旅程。";
		mes "我不会阻止你。嘿嘿。";
		changequest 18110,18111;
		close2;
		warp "moscovia",163,54;
		end;
	} else if (mos_whale_edq == 30) {
		mes "[老者]";
		mes "哈哈哈……我没想到会";
		mes "再次见到你！你是怎么回来的？";
		mes "你是怎么回来的？";
		next;
		select("说明事情的经过。");
		mes "[老者]";
		mes "嗯……就这样？";
		mes "换作没亲自来过这里的人，";
		mes "肯定想不到你会这样回来。";
		mes "好吧。";
		next;
		mes "[老者]";
		mes "我只是想悠闲地在这里度过";
		mes "余生……我对外面的世界感兴趣……";
		mes "但我不是它的对手……";
		mes "我已经老了……";
		next;
		mes "[老者]";
		mes "不用替我难过。";
		mes "你回去时，我也没要求你";
		mes "不要把这座岛的事";
		mes "告诉其他人。";
		next;
		mes "[老者]";
		mes "如果我决定躲到无人找得到的地方……";
		mes "嗯，你现在";
		mes "不用太担心那件事了。";
		mes "一切都没问题。";
		next;
		mes "[老者]";
		mes "总之，你遇到麻烦了吗？";
		mes "你打算怎么办？";
		next;
		if(select("再想想。:你没有办法吗？") == 1) {
			mes "[老者]";
			mes "那就这么做。仔细想想，";
			mes "答案一定能找到……";
			mes "呼呼呼！";
			close;
		}
		mes "[老者]";
		mes "把沙皇带到这里，让他看到";
		mes "一切？！这很困难……";
		next;
		mes "[老者]";
		mes "鲸鱼岛的证据……";
		mes "如果这座岛上存在某种证据，";
		mes "那就是你需要的全部……";
		next;
		soundeffect "mos_gusli1.wav",0;
		mes "-老者闭上眼睛，开始演奏乐器，";
		mes "陷入沉思。-";
		mes "-";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "老人家，你能为我制作一把";
		mes "那样的乐器吗？这是我只在";
		mes "这里见过的神奇东西。";
		mes "我想把它带回去。";
		next;
		mes "[老者]";
		mes "哦……这是个好主意。";
		mes "整个莫斯科比亚都没有这样的乐器！";
		mes "确实如此……";
		next;
		mes "[老者]";
		mes "嗯……如果你答应我的请求，";
		mes "我就为你制作这件乐器。";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "你的请求是什么？";
		next;
		mes "[老者]";
		mes "正好。我一直使用的这件乐器";
		mes "已经有五十多年历史了。琴身";
		mes "磨损得很严重。它会散架也";
		mes "不足为奇……";
		mes "实在太旧了……";
		next;
		mes "[老者]";
		mes "它由只有这里才有的琴弦制成，";
		mes "不过其他材料";
		mes "可以在";
		mes "大陆上找到。";
		next;
		mes "[老者]";
		mes "只要你带来材料，我就能";
		mes "制作一件新的。";
		next;
		mes "[老者]";
		mes "材料是^0000FF木材 30、坚韧藤蔓 20、羚羊角 20、海獭毛皮 10^000000。";
		next;
		mes "[老者]";
		mes "我不会移动小岛，";
		mes "所以你带着材料回来时";
		mes "就能找到这里。";
		next;
		mes "[老者]";
		mes "准备好后告诉我，";
		mes "我会把你送回";
		mes "大陆。";
		if (isbegin_quest(18116))
			changequest 18116,18117;
		mos_whale_edq = 31;
		close;
	} else if (mos_whale_edq == 31) {
		mes "[老者]";
		mes "好了，你准备回大陆了吗？";
		next;
		if(select("需要什么材料？:我准备好了。") == 1) {
			mes "[老者]";
			mes "你应该带来这些材料：";
			next;
			mes "[老者]";
			mes "你应该带来这些材料：";
			mes "^0000FF木材 30、坚韧藤蔓 20、羚羊角 20、海獭毛皮 10^000000。";
			close;
		}
		mes "[老者]";
		mes "我明白了。那我们走吧。";
		next;
		mos_whale_edq = 32;
		callsub S_AS_3;
		close2;
		warp "moscovia",162,56;
		end;
	} else if (mos_whale_edq == 33) {
		mes "[老者]";
		mes "哦……你收集齐";
		mes "材料了吗？";
		next;
		if (countitem(7201) > 29 && countitem(7197) > 19 && countitem(7106) > 19 && countitem(7065) > 9) {
			mes "[老者]";
			mes "你找到了正确的材料。";
			mes "好，我要开始制作";
			mes "乐器了。";
			next;
			delitem 7201,30; //Log
			delitem 7197,20; //Tough_Vines
			delitem 7106,20; //Goat's_Horn
			delitem 7065,10; //Sea_Otter_Leather
			mos_whale_edq = 34;
			if (isbegin_quest(18117))
				changequest 18117,18118;
			mes "[老者]";
			mes "请稍等一会儿，等我成功制作出";
			mes "乐器。";
			close;
		}
		mes "[老者]";
		mes "唉……我们还需要更多材料……";
		mes "我们需要^0000FF木材 30、坚韧藤蔓 20、羚羊角 20、海獭毛皮 10^000000。";
		next;
		mes "[老者]";
		mes "你打算怎么办？要回到";
		mes "大陆去寻找";
		mes "材料吗？";
		next;
		if(select("需要什么材料？:我准备好了。") == 1) {
			mes "[老者]";
			mes "你应该带来这些材料：";
			next;
			mes "[老者]";
			mes "你应该带来这些材料：";
			mes "^0000FF木材 30、坚韧藤蔓 20、羚羊角 20、海獭毛皮 10^000000。";
			close;
		}
		mes "[老者]";
		mes "我明白了。那我们走吧。";
		next;
		callsub S_AS_3;
		close2;
		warp "moscovia",162,56;
		end;
	} else if (mos_whale_edq == 34 || mos_whale_edq == 35) {
		if (mos_whale_edq == 34) {
			if (rand(1,3) != 2) {
				mes "[老者]";

		select("我代表他来这里。");
		mes "[米伦]";
		mes "啊，我明白了。扎巴鲁最近背部确实很不舒服。";
		mes "好吧，这种情况下我们可以稍微通融一下。";
		next;
		mes "[米伦]";
		mes "把那些石头带给那边的巴赫德。";
		mes "他会处理它们。";
		set veins_stone,6;
		close;
	}
	mes "[米伦]";
	mes "赫塔利姆……";
	mes "它有什么特别之处？看起来明明和铁矿石一样。";
	mes "为什么会被列为机密信息？";
	next;
	mes "[米伦]";
	mes "真希望我能回莱肯贝尔总部……";
	mes "我讨厌被困在这种偏僻地方收集无聊的石头。";
	close;
}

ve_in02,54,49,2	script	Factory Worker#ve1	943,{
	if (veins_stone < 6) {
		mes "[巴赫德]";
		mes "最近我一直觉得很虚弱……";
		mes "听说之前那个人也因为开始感到虚弱而辞职了。";
		next;
		mes "[巴赫德]";
		mes "不可能……";
		mes "不可能是因为这种‘赫塔利姆’吧……";
		mes "这太荒谬了……";
		close;
	}
	else if (veins_stone == 6) {
		mes "[巴赫德]";
		mes "哦，你拿到石头了？";
		mes "是替扎巴鲁带来的吗？";
		mes "他怎么样了？听说他扭伤了背。";
		next;
		select("他还在疼。");
		mes "[巴赫德]";
		mes "哦，不……听到这个我很遗憾。";
		mes "希望他早点好起来。总之，";
		mes "把石头带到这里来吧？";
		next;
		mes "[巴赫德]";
		mes "让我确认一下扎巴鲁今天的配额。";
		mes "啊，别担心，我们会定期支付他的配额报酬。";
		next;
		select("我有个问题……");
		mes "[巴赫德]";
		mes "嗯？你想知道什么？";
		mes "我不能说自己什么都知道，";
		mes "但我会尽量告诉你我知道的事。";
		mes "毕竟你帮助了扎巴鲁，所以……";
		next;
		select("赫塔利姆是什么？");
		mes "[巴赫德]";
		mes "这些石头引起城外关注的时间还不长。";
		mes "在那之前，镇民只是用它们雕刻东西。";
		next;
		mes "[巴赫德]";
		mes "后来，突然有一群来自——我想是施瓦茨瓦尔德——的人来到这里，";
		mes "买走了许多石头。之后他们甚至建了这座工厂来加工石头！";
		next;
		mes "[巴赫德]";
		mes "他们试过用机器采集石头，但机器很快就全坏了。";
		mes "所以他们雇佣维恩斯的人来收集。";
		next;
		mes "[巴赫德]";
		mes "我不确定有多少人知道这座工厂的主人。";
		mes "也许是莱肯贝尔？对，我看到过他们的企业飞艇来到镇上，";
		mes "所以我觉得应该就是他们。";
		next;
		select("他们如何使用赫塔利姆？");
		mes "[巴赫德]";
		mes "我也不太确定。只是偶然听到上层人员提到心脏之类的东西。";
		mes "心脏碎片？我完全不明白。";
		next;
		mes "[巴赫德]";
		mes "我只知道他们用石头制造与那些心脏有关的机器。";
		mes "这就是我知道的一切。总之，请把石头放到那边~";
		set veins_stone,7;
		close;
	}
	mes "[巴赫德]";
	mes "我每天都感觉越来越虚弱……";
	mes "难道是慢性疲劳综合征？唉……";
	close;
}

ve_in02,68,39,7	script	Factory Worker#ve2	943,{
	mes "[工人]";
	mes "这些到底是什么石头？";
	mes "不就是普通石头吗？";
	mes "这里给的钱太少了……";
	close;
}

// Spy Quest :: veins_secret
//============================================================
prontera,202,122,0	script	Kid#sch	703,{
	if (que_sch == 0) {
		mes "[鲁尼]";
		mes "到底在哪里？我不知道……在哪里……？";
		mes "我想他一定就在这附近……";
		next;
		select("怎么了？:……");
		mes "[鲁尼]";
		mes "哦，只是……";
		mes "有人让我送东西，但我找不到收件人。";
		mes "他说那个人很好找，但我还是找不到。";
		next;
		mes "[鲁尼]";
		mes "我本该问清楚具体地点。";
		mes "如果找不到他，我就拿不到这次送货的报酬。^333333*叹气*^000000";
		next;
		if (select("听起来很难。祝你好运！:需要帮忙吗？") == 1) {
			mes "[鲁尼]";
			mes "谢谢。我想我可能确实需要帮助。";
			mes "那家伙会在哪里？既然在等送货，";
			mes "他应该让自己更容易被找到……";
			close;
		}
		mes "[鲁尼]";
		mes "当然，如果你能帮忙就太好了。";
		mes "我需要把这封信送给一位叫……";
		mes "啊，叫^FF0000拉斯达·米达尔^000000的吟游诗人！";
		next;
		mes "[鲁尼]";
		mes "我在镇上到处找看起来像吟游诗人的人，但没有任何收获。";
		mes "如果你找到他，能告诉我吗？";
		set que_sch,1;
		close;
	}
	else if (que_sch == 1) {
		mes "[鲁尼]";
		mes "我还是没找到拉斯达·米达尔。";
		mes "如果你找到他，能告诉我吗？";
		mes "这样我就能把信交给他了。";
		close;
	}
	else if (que_sch == 2) {
		if (Zeny < 100) {
			mes "[鲁尼]";
			mes "拉斯达·米达尔……";
			mes "那家伙到底会在哪里？";
			close;
		}
		mes "[鲁尼]";
		mes "哇，你真的找到拉斯达·米达尔了？";
		mes "为什么我就是找不到他？";
		mes "总之，非常感谢你的帮助。";
		mes "我还以为这次送货要失败了！";
		next;
		select("他让我把这个交给你。");
		mes "[鲁尼]";
		mes "嘿，太好了！谢谢你的钱！嘿嘿~";
		set Zeny, Zeny-100;
		set que_sch,3;
		close;
	}
	mes "[鲁尼]";
	mes "今天天气不错，对吧？";
	close;
}

prt_church,89,108,6	script	Bard#sch	741,{
	if ((MaxWeight-Weight) < 2000 || checkweight(1201,1) == 0) {
		mes "^3355FF等等！";
		mes "你现在携带的物品太多了。";
		mes "请使用卡普拉服务存放一些物品后再回来。^000000";
		close;
	}

	if (que_sch < 1) {
		mes "[拉斯达]";
		mes "你好，今天真是美好的一天，不是吗？";
		mes "好天气总能激发我的诗人灵感，";
		mes "让我忍不住放声歌唱~";
		close;
	}
	else if (que_sch == 1) {
		mes "[拉斯达]";
		mes "多么灿烂的一天！我应该唱首歌赞美它！";
		mes "哦……啦啦啦啦~";
		mes "女孩们，女孩们，女——孩们……";
		next;
		if(select("不好意思……:……") == 1) {
			mes "[拉斯达]";
			mes "多么灿烂的一天！我应该唱首歌赞美它！";
			mes "哦……啦啦啦啦~";
			mes "女孩们，女孩们，女——孩们……";
			close;
		}
		mes "[拉斯达]";
		mes "女孩们，女孩们，女——孩们……";
		mes "让我的心跳……";
		mes "跳得太快。我的心在狂奔……";
		mes "而你就在终点线上——爱情冠军！";
		next;
		mes "[拉斯达]";
		mes "哦？别那样盯着我，你让我脸红了。";
		mes "你是想和我说话吗？";
		next;
		if(select("对不起。:你是^ff0000拉斯达·米达尔^000000吗？") == 1) {
			mes "[拉斯达]";
			mes "哦，没关系。";
			mes "...............................";
			mes "姑娘，我会笑话你的所有笑话，";
			mes "同意你的政治观点~你很迷人！";
			mes "不过亲爱的，你笨得像块砖~";
			close;
		}
		mes "[拉斯达]";
		mes "哦？哦，是的，我就是。";
		mes "有什么我能帮你的吗？";
		next;
		select("我是来把这个交给你的。");
		mes "[拉斯达]";
		mes "啊！他终于把信寄来了。";
		mes "请稍等一下，让我看看……";
		next;
		mes "^3355FF拉斯达打开信，开始阅读。^000000";
		next;
		mes "[拉斯达]";
		mes "嗯……";
		mes "哦，不……";
		next;
		mes "[拉斯达]";
		mes "啊，抱歉让你久等了。";
		mes "请把这笔钱交给那个本该来找我的孩子。";
		set que_sch,2;
		set Zeny, Zeny+100;
		next;
		mes "[拉斯达]";
		mes "有空的话之后再来和我聊聊。";
		mes "回头见~";
		close;
	}
	else if (que_sch == 2) {
		mes "^3355FF拉斯达似乎陷入了沉思。^000000";
		close;
	}
	else if (que_sch == 3) {
		mes "[拉斯达]";
		mes "哦，太好了，你回来了！";
		mes "谢谢你替我送信。听着，";
		mes "你能听我说一会儿吗？";
		mes "我想请你帮个忙。";
		next;
		if (select("当然。:不。") == 1) {
			mes "[拉斯达]";
			mes "你带来的信来自我过去最好的朋友。";
			mes "我已经有一段时间没收到他的消息了，";
			mes "所以很担心……";
			next;
			mes "[拉斯达]";
			mes "维特在信中说自己被诬告入狱，";
			mes "希望我帮他。然而我能做的不多。";
			mes "你觉得你能帮他吗？";
			next;
			if (select("当然。:不。") == 1) {
				mes "[拉斯达]";
				mes "非常感谢！";
				mes "现在最好先去^FF0000梦罗克^000000的监狱找我的朋友，";
				mes "看看你能怎样帮助他。";
				set que_sch,4;
				close;
			}
			mes "[拉斯达]";
			mes "我……我想……";
			mes "你一定也帮不了他……";
			close;
		}
		mes "[拉斯达]";
		mes "我想你一定已经在忙别的事了。";
		mes "好吧，我理解……";
		close;
	}
	else if (que_sch < 8) {
		mes "[拉斯达]";
		mes "我还是不敢相信维特被关在梦罗克监狱。";
		mes "到底发生了什么？希望你能帮助他……";
		close;
	}
	else if (que_sch == 8) {
		mes "[拉斯达]";
		mes "他因为涉嫌间谍活动而被捕？";
		mes "这说不通。到底发生了什么？";
		next;
		select("^ff0000克里格^000000告诉我的。");
		mes "[拉斯达]";
		mes "克里格？你是说克里格·拉杰·曼迪？";
		mes "我其实很了解他。让我给你写一封推荐信。";
		mes "希望这样就足以让你进入监狱。";
		set que_sch,9;
		close;
	}
	else if (que_sch == 9) {
		mes "[拉斯达]";
		mes "快把我的信带给克里格。";
		mes "不知道到底发生了什么……";
		mes "一定是有什么奇怪的误会。";
		close;
	}
	else if (que_sch < 19) {
		mes "[拉斯达]";
		mes "他真的让你把他救出监狱？";
		mes "我知道这在道德上很模糊，";
		mes "但希望你尽力帮助维特。";
		close;
	}
	else if (que_sch < 25) {
		mes "[拉斯达]";
		mes "谢谢你愿意帮助我。";
		mes "不过我还是不敢相信维特竟敢越狱……";
		next;
		mes "[拉斯达]";
		mes "我仍然无法帮他做任何事，";
		mes "所以请替我尽力照顾他。";
		mes "我真的非常感谢你。";
		close;
	}
	else if (que_sch == 25) {
		mes "[拉斯达]";
		mes "啊，你回来了。我想你现在一定有很多问题。";
		mes "你应该知道，我让你做的一切都是确认维特罪行的计划。";
		next;
		mes "[拉斯达]";
		mes "得知他是阿鲁纳佩尔兹间谍后，我们逮捕了他，";
		mes "但因为缺乏确凿证据，无法惩罚他。";
		next;
		mes "[拉斯达]";
		mes "所以我们故意让他逃走，计划跟踪他取得所需证据。";
		mes "我们的诱捕行动甚至抓住了他的所有同伙！";
		next;
		mes "[拉斯达]";
		mes "抱歉一直瞒着你，但这是计划必不可少的一环。";
		mes "没有你的帮助我们不可能成功。";
		mes "请收下这份奖励，表达我们诚挚的谢意。";
		set que_sch,26;
		getitem 12106,1; //Accessory_Box
		getexp (checkre(3))?60000:600000,0;
		close;
	}
	else {
		mes "[拉斯达]";
		mes "最近涉及维特这类间谍的案件太多了。";
		mes "这可能意味着阿鲁纳佩尔兹正计划对我们采取行动……";
		close;
	}
}


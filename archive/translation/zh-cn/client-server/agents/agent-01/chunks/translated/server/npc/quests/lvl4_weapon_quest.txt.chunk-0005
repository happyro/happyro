		mes "[Kayron]";
		mes "有没有办法让我恢复更多记忆？在此期间，先把这些材料交给我吧。我保证会用它们为你制作一把好武器。";
		delitem 1005,2; //Hammer_Of_Blacksmith
		delitem 989,1; //Emperium_Anvil
		delitem 710,1; //Illusion_Flower
		delitem 969,20; //Gold
		set lv4_weapon,26;
		close;
	}
	if (lv4_weapon == 25) {
		mes "[Kayron]";
		mes "我需要很多材料，不过先提醒你一些我还记得的必需品。";
		next;
		mes "[Kayron]";
		mes "目前我知道需要：2个铁匠之锤、1个铝铁砧、1朵幻觉之花和20个黄金。";
		next;
		mes "[Kayron]";
		mes "我知道还有几样对制作武器至关重要的东西，但是……我无法集中精神想起来。";
		close;
	}
	if (lv4_weapon == 24) {
		mes "[Kayron]";
		mes "好吧……我刚想起大部分制作好武器所需的东西。";
		next;
		mes "[Kayron]";
		mes "坦白说，我记不起来了，所以不能保证最终会制作出什么武器，先告诉你这一点比较公平。";
		next;
		mes "[Kayron]";
		mes "目前我知道需要：";
		mes "2 个铁匠之锤";
		mes "1 Emperium Anvil";
		mes "1 朵幻觉之花和";
		mes "20 Gold.";
		next;
		mes "[Kayron]";
		mes "先把这些物品带给我。我很确定还需要别的东西，但就是想不起来。我的记忆开始让我有点担心了……";
		next;
		mes "[Kayron]";
		mes "总之，你去收集那些东西时我会在这里等着。注意安全，好吗？";
		set lv4_weapon,25;
		close;
	}
	if (lv4_weapon == 23) {
		mes "[Kayron]";
		mes "活着时，人们叫我凯隆。";
		mes "但现在我只是死者之国里四处游荡的幽灵。没有身体，我觉得自己毫无用处。";
		next;
		mes "[Kayron]";
		mes "我什么也做不了。";
		mes "我……呃……我是……？";
		input .@input$;
		next;
		if (.@input$ == "I'm utterly helpless here.") {
			mes "[Kayron]";
			mes "我在这里完全无能为力。";
			mes "对，对！我父亲以前总这么说！看来我和兄弟们在很多方面都像父亲。";
			next;
			mes "[Kayron]";
			mes "我的思绪一直很模糊。";
			mes "我甚至忘了自己曾经是活生生的人。";
			mes "^333333*Sigh...*^000000";
			next;
			mes "[Kayron]";
			mes "不过，那段小小的记忆让我稍微安心了一点。我真的很感激。";
			next;
			mes "[Kayron]";
			mes "我活着时是武器工匠，如果你愿意，我可以为你锻造好东西。不过你得带来材料。";
			next;
			mes "[Kayron]";
			mes "你也明白，死亡多少限制了我的行动。";
			mes "但被困在尼夫海姆其实也有好处，这里充满能帮助我锻造的奇异能量。";
			next;
			mes "[Kayron]";
			mes "虽然实验性锻造害死了我，但这次不用担心了。毕竟我已经死了！哈哈哈～";
			next;
			mes "[Kayron]";
			mes "好了，给我一点时间，让我想想需要哪些东西，好吗？";
			set lv4_weapon,24;
			close;
		}
		else {
			mes "[Kayron]";
			mes "咦……？";
			mes "你刚才说什么？抱歉，我正在努力回忆父亲以前常说的话……";
			close;
		}
	}
	if (lv4_weapon == 22) {
		mes "[Kayron]";
	mes "活着时，人们叫我凯隆。";
	mes "但现在我只是死者之国里四处游荡的幽灵。没有身体，我觉得自己毫无用处。";
		next;
		mes "[Kayron]";
		mes "咦……？我想不起刚才要说什么了。我的记忆！我……我似乎回忆不起来……";
		close;
	}
	mes "[Kayron]";
	mes "活着时，人们叫我凯隆。";
	mes "但现在我只是死者之国里四处游荡的幽灵。没有身体，我觉得自己毫无用处。";
	next;
	switch(select("表示感兴趣。:无视他。")) {
	case 1:
		mes "[Kayron]";
		mes "咦……？我想不起刚才要说什么了。我的记忆！我……我似乎回忆不起来……";
		set lv4_weapon,22;
		close;
	case 2:
		mes "[Kayron]";
		mes "没用……";
		mes "完全没用……";
		close;
	}
}

niflheim,99,268,5	script	Reyghema#lv4	794,{
	if (MaxWeight - Weight < 3000) {
		mes "^3355FF等一下！你现在携带的物品太多了。请先把一些东西存进卡普拉仓库，再回来吧。^000000";
		close;
	}
	if (BaseLevel < 80) {
		mes "[Reyghema]";
		mes "怎么……";
		mes "搞什么……？";
		next;
		mes "[Reyghema]";
		mes "活人怎么会在这里？继续待着的话，我保证你活不了多久。别变得和我一样，快离开这里！";
		close;
	}
	if (lv4_weapon == 0) {
		mes "[Reyghema]";
		mes "可恶……";
		mes "我不想死！";
		next;
		mes "[Reyghema]";
		mes "活着的东西当然都不想死，但我差一点就完成想做的事了。啊，青春……";
		next;
		mes "[Reyghema]";
		mes "青春……";
		mes "享受你的青春……";
		mes "我记得听过类似的话，";
		mes "但后面还有内容……";
		next;
		switch(select("表示感兴趣。:无视他。")) {
		case 1:
			mes "[Reyghema]";
			mes "享受你的青春……";
			mes "享受你的青春……";
			mes "……后面是什么？";
			next;
			mes "[Reyghema]";
			mes "啊！";
			mes "我想不起来！";
			mes "我的脑子里";
			mes "一片混乱！";
			set lv4_weapon,31;
			close;
		case 2:
			mes "[Reyghema]";
			mes "享受你的青春……";
			mes "享受你的青春……";
			mes "……接下来是什么？";
			close;
		}
	}
	if ((lv4_weapon < 31) || (lv4_weapon > 39)) {
		mes "[Reyghema]";
		mes "嘿……";
		mes "感觉你来这里是为了完成某件事。";
		mes "没错，没有目标的人和有目标的人完全不同。";
		next;
		mes "[Reyghema]";
		mes "不过，如果你要在尼夫海姆这种地方完成事情，我几乎会为你感到难过。";
		close;
	}
	if ((lv4_weapon == 38) || (lv4_weapon == 39)) {
		mes "[Reyghema]";
		mes "...";
		mes "……终于。";
		next;
		if (rand(1,2) == 1) {
			mes "[Reyghema]";
			mes "我成功了！";
			mes "我为制作它而死，但终于完成了！";
			if (lv4_weapon == 38) {
				mes "这是……狂暴之剑！";
				getitem 1814,1; //Berserk
			}
			else {
				mes "这是……天锤！";
				getitem 1416,1; //Tjungkuletti
			}
			set lv4_weapon,0;
			next;
			mes "[Reyghema]";
			mes "^333333*叹气*^000000我能感觉到它又发生了。我的记忆开始消散了，难道不能让我留住这段记忆吗？";
			next;
			mes "[Reyghema]";
			mes "看来死者不该记得过去。不过谢谢你让我实现毕生愿望，即使这一刻很短暂。";
			next;
			mes "[Reyghema]";
			mes "如果有机会，请回来帮我回忆过去，让我再次体验制作武器的快乐。再见，冒险者……";
			close;
		}
		else {
			mes "[Reyghema]";
			mes "我成功了！";
			mes "我为制作它而死，但终于完成了！";
			if (lv4_weapon == 38) {
			mes "这是……鲁德拉之弓！";
				getitem 1720,1; //Bow_Of_Rudra
			}
			else {
			mes "这是……布罗卡！呜～我做到了！";
				getitem 1415,1; //Skewer
			}
			set lv4_weapon,0;
			next;
			mes "[Reyghema]";
			mes "^333333*叹气*^000000 我能感觉到它又开始发生了。我的记忆正在逐渐消失。难道不能让我保留这段记忆吗？";
			next;
			mes "[Reyghema]";
			mes "看来死者不该记得过去。不过谢谢你让我实现毕生愿望，即使这一刻很短暂。";
			next;
			mes "[Reyghema]";
			mes "如果有机会，请回来帮我回忆过去，让我再次体验制作武器的快乐。再见，冒险者……";
			close;
		}
	}
	if (((lv4_weapon == 36) && (countitem(7292) > 29) && (countitem(7293) > 29) && (countitem(7289) > 29)) || ((lv4_weapon == 37) && (countitem(7297) > 29) && (countitem(7291) > 29) && (countitem(7295) > 29))) {
		mes "[Reyghema]";
		mes "等等……";
		mes "你带的东西正是我制作时需要的材料！让我看看……";
		next;
		mes "[Reyghema]";
		mes "没错，太完美了！";
		mes "不过你怎么会知道我需要哪些材料？算了，这不重要。";
		next;
		mes "[Reyghema]";
		mes "现在到了最难、也可能最简单的部分。";
		mes "是时候测试你的运气了。如果运气太差，我们就无法继续。";
		next;
		mes "[Reyghema]";
		mes "好了，我们来玩^660000石头、剪刀、布^000000。三局中赢两局，我们才能继续锻造。";
		next;
		mes "[Reyghema]";
		mes "如果你运气不好输了，就得倒掉你带来的一种矿石来驱散厄运。规则就是这样。";
		next;
		mes "[Reyghema]";
		mes "好了，这是纸。听我说时，写下“石头”、“布”或“剪刀”。明白了吗？开始吧。";
		next;
		set .@npchand1,rand(1,3);
		set .@myhand1,select("剪刀:石头:布");
		if (((.@myhand1 == 1) && (.@npchand1 == 3)) || ((.@myhand1 == 2) && (.@npchand1 == 1)) || ((.@myhand1 == 3) && (.@npchand1 == 2))) {
			set .@shobu,.@shobu+1;
		}
		mes "[Reyghema]";
		mes "好了，现在再来一次。";
		next;
		set .@npchand2,rand(1,3);
		set .@myhand2,select("剪刀:石头:布");
		if (((.@myhand2 == 1) && (.@npchand2 == 3)) || ((.@myhand2 == 2) && (.@npchand2 == 1)) || ((.@myhand2 == 3) && (.@npchand2 == 2))) {
			set .@shobu,.@shobu+1;
		}
		mes "[Reyghema]";
		mes "最后一次。";
		mes "写下“石头”、“布”或“剪刀”。";
		next;
		set .@npchand3,rand(1,3);
		set .@myhand3,select("剪刀:石头:布");
		if (((.@myhand3 == 1) && (.@npchand3 == 3)) || ((.@myhand3 == 2) && (.@npchand3 == 1)) || ((.@myhand3 == 3) && (.@npchand3 == 2))) {
			set .@shobu,.@shobu+1;
		}
		set .@aekddam,rand(1,3);
		if (.@shobu > 1) {
			if (lv4_weapon == 36) {
				delitem 7292,30; //Muscovite
				delitem 7293,30; //Rose_Quartz
				delitem 7289,30; //Olivine
			}
			else {
				delitem 7297,30; //Biotite
				delitem 7291,30; //Agate
				delitem 7295,30; //Citrine
			}
			set lv4_weapon,lv4_weapon+2;
		}
		else if (.@shobu < 2) {
			if (.@aekddam == 1) {
				if (lv4_weapon == 36) {
					delitem 7292,30; //Muscovite
				}
				else {
					delitem 7297,30; //Biotite
				}
			}
			else if (.@aekddam == 2) {
				if (lv4_weapon == 36) {
					delitem 7293,30; //Rose_Quartz
				}
				else {
					delitem 7291,30; //Agate
				}
			}
			else if (.@aekddam == 3) {
				if (lv4_weapon == 36) {
					delitem 7289,30; //Olivine
				}
				else {
					delitem 7295,30; //Citrine
				}
			}
		}
		mes "[Reyghema]";
		mes "好了，我写下的是……";
		if (.@npchand1 == 1) {
			mes "剪刀";
		}
		else if (.@npchand1 == 2) {
			mes "石头";
		}
		else if (.@npchand1 == 3) {
			mes "布";
		}
		if (.@npchand2 == 1) {
			mes "剪刀";
		}
		else if (.@npchand2 == 2) {
			mes "石头";
		}
		else if (.@npchand2 == 3) {
			mes "布";
		}
		if (.@npchand3 == 1) {
			mes "剪刀";
		}
		else if (.@npchand3 == 2) {
			mes "石头";
		}
		else if (.@npchand3 == 3) {
			mes "布";
		}
		next;
		mes "[Reyghema]";
		mes "你写下的是……";
		if (.@myhand1 == 1) {
			mes "剪刀";
		}
		else if (.@myhand1 == 2) {
			mes "石头";
		}
		else if (.@myhand1 == 3) {
			mes "布";
		}
		if (.@myhand2 == 1) {
			mes "剪刀";
		}
		else if (.@myhand2 == 2) {
			mes "石头";
		}
		else if (.@myhand2 == 3) {
			mes "布";
		}
		if (.@myhand3 == 1) {
			mes "剪刀";
		}
		else if (.@myhand3 == 2) {
			mes "石头";
		}
		else if (.@myhand3 == 3) {
			mes "布";
		}
		next;
		if (.@shobu > 1) {
			mes "[Reyghema]";
		mes "不错，你赢了" + .@shobu + "次。你的运气真好，我们终于可以结束这场闹剧了。";
			next;
			mes "[Reyghema]";
		mes "给我一点时间准备。先把矿石交给我，稍后再来找我，好吗？";
			close;
		}
		else if (.@shobu < 2) {
			mes "[Reyghema]";
		mes "可恶……";
		mes "我本该为获胜高兴，但这意味着你的运气很差，";
		mes "我们还得再来一次。";
			next;
			mes "[Reyghema]";
		mes "抱歉，我得拿走你的一种矿石来驱散厄运。";
		mes "带着我们需要的全部矿石回来，我们再测试一次运气，好吗？";
			close;
		}
	}
	if ((lv4_weapon == 35) || (lv4_weapon == 36) || (lv4_weapon == 37)) {
		mes "[Reyghema]";
		mes "啊啊啊！";
		mes "我还是想不起需要什么！";
		mes "我发誓，这简直要了我的命！";
		next;
		mes "[Reyghema]";
		mes "...";
		next;
		mes "[Reyghema]";
		mes "...";
		mes "......";
		next;
		mes "[Reyghema]";
		mes "可恶。";
		mes "可恶、可恶、可恶！";
		mes "“要了我的命？！”我已经死了！";
		close;
	}
	if ((lv4_weapon == 34) && (countitem(1005) > 1) && (countitem(989) > 0) && (countitem(710) > 0) && (countitem(969) > 19)) {
		mes "[Reyghema]";
		mes "干得好，你带来了我要求的一切。不过计划出了点小差错……";
		next;
		mes "[Reyghema]";
		mes "原计划是等你带回这些东西后，我就能想起其他所需材料。但我没想起来。";
		next;
		mes "[Reyghema]";
		mes "再给我一点时间想想。现在先把你带来的东西交给我。";
		mes "我保证会用它们为你制作武器。";
		delitem 1005,2; //Hammer_Of_Blacksmith
		delitem 989,1; //Emperium_Anvil
		delitem 710,1; //Illusion_Flower
		delitem 969,20; //Gold
		set lv4_weapon,35;
		close;
	}
	if (lv4_weapon == 34) {
		mes "[Reyghema]";
		mes "我最好提醒你需要哪些东西。";
		mes "如果需要，就全部记下来。";
		next;
		mes "[Reyghema]";
		mes "1个铝铁砧、2个铁匠之锤、1朵幻觉之花和20个黄金……";
		next;
		mes "[Reyghema]";
		mes "还有几样至关重要的东西，但我现在想不起来……";
		close;
	}
	if (lv4_weapon == 33) {
		mes "[Reyghema]";
		mes "好了，你回来了。我记得大部分需要的东西，记下来吧。";
		next;
		mes "[Reyghema]";
			mes "1个铝铁砧、2个铁匠之锤、1朵幻觉之花和20个黄金……";
		next;
		mes "[Reyghema]";
		mes "还有几样重要的东西，但我想不起是什么。希望你带着物品回来时，我已经想起来了。";
		next;
		mes "[Reyghema]";
		mes "现在先去带回我要求的东西，越快越好。快点，我不知道记忆还能维持多久……";
		set lv4_weapon,34;
		close;

//===== rAthena Script =======================================
//= Kagerou/Oboro Job Quest
//===== By: ==================================================
//= M45T3R, Dastgir Pojee, Euphy
//===== Current Version: =====================================
//= 1.0
//===== Compatible With: =====================================
//= rAthena Project
//===== Description: =========================================
//= [Official Conversion]
//= Job change Quest from Ninja -> Kagerou/Oboro.
//===== Additional Comments: =================================
//= 1.0 First version. Uses official script structure and text
//=     from iRO (ripped by M45T3R/Dastgir Pojee). [Euphy]
//============================================================

// Starting the Quest
//============================================================
que_ng,28,156,0	script	Start#ko	139,1,1,{
	end;
OnTouch:
	if (BaseLevel >= 99 && JobLevel >= 70 && job_kagero == 0 && Class == Job_Ninja) {
		mes "通往^25C18D忍者公会^25C18D的秘密通道";
		mes "你听见熟悉的声音正在交谈。";
		next;
		mes "[Unknown Voice A]";
		mes "好久不见。你还好吗？你收养的孩子们怎么样？";
		next;
		mes "[Unknown Voice B]";
		mes "真佩服你。你挑选的孩子都很有竞争力。";
		next;
		mes "[Unknown Voice A]";
		mes "听起来真悦耳。被派往空气污染的异国已经够糟了，现在还被这里的回忆纠缠……";
		next;
		mes "[Unknown Voice A]";
		mes "你觉得呢？我们现在轮换吗？";
		next;
		mes "[Unknown Voice B]";
		mes "你还没放弃啊。你真的觉得他会同意吗？";
		next;
		mes "[Unknown Voice A]";
		mes "不用这么刻薄。嘿！来这里的孩子中，有人找到过^BD0408那个地方^BD0408吗？";
		next;
		mes "[Unknown Voice B]";
		mes "因为找到隐藏地点也是测试的一部分。";
		next;
		mes "[Unknown Voice A]";
		mes "你和我第一次见你时一样固执。那不过是某处的一面墙……";
		next;
		mes "[Unknown Voice B]";
		mes "嘘！我觉得有人在偷听。快点！回任务区域去。";
		next;
		mes "谈话突然中断了。隐藏地点？墙？测试的一部分？这到底是怎么回事？";
		setquest 5131;
		set job_kagero,1;
		close;
	} else if (BaseJob != Job_Ninja && job_kagero > 0) {
		for (set .@i,5131; .@i<=5146; set .@i,.@i+1)
			if (isbegin_quest(.@i)) erasequest .@i;
		set job_kagero,0;
	}
	end;
}

que_ng,21,76,0	script	Wall with a Drawing#ko	844,{
	if (Class == Job_Oboro || Class == Job_Kagerou) {
		mes "你不该再使用这条秘密通道。";
		close;
	} else if (job_kagero == 1 && Class == Job_Ninja) {
		mes "你找到了一个像隐藏地点的地方。";
		next;
		mes "这面墙一直都在。为什么我以前没有注意到？";
		next;
		mes "既然知道这是秘密通道，要怎么进去？";
		next;
		if(select("撕下画。:用手触摸画。") == 1) {
			mes "我不能撕下来，因为这不是我的东西。";
			close;
		}
		mes "你用指尖触摸画，突然感到一股拉扯感。";
		close2;
		warp "job_ko",26,111;
		end;
	} else if (job_kagero > 1 && Class == Job_Ninja) {
		mes "通往^25C18D忍者公会^000000藏身处的入口。";
		next;
		if(select("进入。:不进入。") == 2)
			close;
		mes "触摸画时，你感到自己被拉进去……"; //custom translation
		close2;
		warp "job_ko",26,111;
		end;
	} else {
		mes "墙上有一幅巨大的画。";
		close;
	}
	end;
}

job_ko,25,115,4	script	Old Man#ko	588,{
	if (MaxWeight - Weight < 1000 || checkweight(1201,1) == 0) {
		mes "[Kuuga Gai]";
		mes "你不需要携带这么多东西。"; //custom translation
		close;
	}
	if (BaseJob != Job_Ninja) {
		for (set .@i,5131; .@i<=5146; set .@i,.@i+1)
			if (isbegin_quest(.@i)) erasequest .@i;
		set job_kagero,0;
		mes "[Kuuga Gai]";
		mes "你不属于忍者一族。";
		close2;
		warp "amatsu",147,136;
		end;
	}
	if (job_kagero == 1) {
		cutin "job_ko03",2;
		mes "^1A95E6一位精神矍铄的老人坐在那里，茫然地凝视着远方。^1A95E6";
		next;
		if(select("无视。:和他交谈。") == 1) {
			close2;
			cutin "",255;
			end;
		}
		mes "["+strcharinfo(0)+"]";
		mes "打扰了……";
		next;
		mes "^1A95E6你试着和老人交谈，但没有得到回应。正当你准备转身时……^1A95E6";
		next;
		mes "[Old Man]";
		mes "终于有客人了！嗯……而且还是活的！";
		next;
		select("打扰了……这里是哪里？");
		mes "[Old Man]";
		mes "^1A95E6他继续自言自语，没有停下来回答你的问题。^1A95E6";
		next;
		mes "[Old Man]";
		mes "古代天津町曾有一个安静的家族，但历史书和故事中从未提及他们。";
		next;
		mes "[Old Man]";
		mes "他们生活在阴影之下，却总是像向日葵一样渴望灿烂的阳光。";
		next;
		mes "[Old Man]";
		mes "他们忠于自己的领主，将领主视为照耀自己的太阳。";
		next;
		mes "[Old Man]";
		mes "……一个非常值得信赖的家族……";
		next;
		mes "[Old Man]";
		mes "……忠诚到骨子里……";
		next;
		mes "[Old Man]";
		mes "……一个正直的家族……";
		next;
		select("他们后来怎么样了？");
		mes "^1A95E6老人带着忧郁的表情看着你。^1A95E6";
		next;
		mes "[Old Man]";
		mes "为什么会对一个被领主抛弃、从历史中消失的家族感兴趣？";
		next;
		if(select("我是忍者。:我很无聊。") == 2) {
			mes "[Old Man]";
			mes "很高兴见到你。";
			close2;
			warp "amatsu",147,136;
			end;
		}
		cutin "job_ko02",2;
		mes "[Old Man]";
		mes "忍者！这个家族曾经也被称为忍者。";
		next;
		erasequest 5131;
		setquest 5132;
		set job_kagero,2;
		mes "[Old Man]";
		mes "请听我讲，我有很多关于这个家族的故事要告诉你。";
		close2;
		cutin "",255;
		end;
	} else if (job_kagero == 2) {
		cutin "job_ko01",2;
		mes "^1A95E6老人用非常舒缓的语调开始讲故事，仿佛在给孙辈讲故事。^1A95E6";
		next;
		mes "[Old Man]";
		mes "这要追溯到远古时代，天津町已经没有人记得这件事了。";
		next;
		mes "[Old Man]";
		mes "这个家族在幕后工作，基本上为领主而活。";
		next;
		mes "[Old Man]";
		mes "他们非常忠诚，领主要求他们做什么就做什么。";
		next;
		mes "[Old Man]";
		mes "忍者，这个家族被称为暗之族，但这并不意味着他们想隐藏在黑暗中。";
		next;
		mes "[Old Man]";
		mes "他们忠诚到满足于成为领主的仆人，但这份忠诚反而成了问题。";
		next;
		select("问题？");
		mes "[Old Man]";
		mes "他们是一个连领主都不太了解的秘密组织。";
		next;
		mes "[Old Man]";
		mes "少数知道家族存在的人试图调查他们，但没人能揭开他们的真实身份。";
		next;
		mes "[Old Man]";
		mes "因此，这个家族从忠诚的仆人变成了一个因秘密而令人畏惧的团体。";
		next;
		mes "[Old Man]";
		mes "领主疏远了这个家族，不再召集他们效力，但他们从未背叛领主。";
		next;
		select("他们真是忠诚的人。");
		cutin "job_ko03",2;
		mes "[Old Man]";
		mes "是的，他们非常忠诚。";
		next;
		erasequest 5132;
		setquest 5133;
		set job_kagero,3;
		mes "^1A95E6老人看起来更加哀伤。^1A95E6";
		close2;
		cutin "",255;
		end;
	} else if (job_kagero == 3) {
		cutin "job_ko03",2;
		mes "[Old Man]";
		mes "这个家族从很久以前就一直隐居。如今的领主甚至不知道他们的存在。";
		next;
		select("……");
		cutin "job_ko01",2;
		mes "[Old Man]";
		mes "我是吉恩首领，暗之忍者一族的最后一人。";
		next;
		if(select("我觉得你的时代结束了。:我需要你的教导。") == 1) {
			cutin "job_ko04",2;
			mes "[Leader Gion]";
			mes "你是来结束这个老头性命的刺客吗？";
			next;
			mes "[Leader Gion]";
			mes "原来如此，你就是因为这个才对我的家族感兴趣。我不会轻易放弃。";
			next;
			percentheal -99,0;
			mes "砰！！";
			mes "^1A95E6巨大的冲击让你失去了意识。^000000";
			close2;
			warp "amatsu",147,136;
			end;
		}
		cutin "job_ko02",2;
		mes "[Leader Gion]";
		mes "教导……";
		mes "我已经很久没听到这个词了。";
		next;
		mes "[Leader Gion]";
		mes "我想这次小小的拜访并非巧合，而是建立联系的开始。";
		next;
		mes "[Leader Gion]";
		mes "抱歉，我不是老师。但是！";
		next;
		mes "[Leader Gion]";
		mes "我可以在你选择的^33CC71"+((Sex == SEX_MALE)?"影狼":"朧")+"^000000道路上帮助你。";
		next;
		mes "^1A95E6你离开时，隐约听见吉恩首领的声音。^1A95E6";
		next;
		erasequest 5133;
		setquest 5134;
		set job_kagero,4;
		mes "[Leader Gion]";
		mes "如果你准备沿着"+((Sex == SEX_MALE)?"影狼":"朧")+"道路跟随我，吉恩首领，我们还会再见。";
		close2;
		warp "amatsu",147,136;
		end;
	} else if (job_kagero == 4) {
		cutin "job_ko02",2;
		mes "[Leader Gion]";
		mes "我以为你害怕^33CC71"+((Sex == SEX_MALE)?"影狼":"朧")+"的道路^33CC71，不会再回来了。";
		next;
		mes "[Leader Gion]";
		mes "但从你的眼神来看，看来是我误判了你。";
		next;
		mes "[Leader Gion]";
		mes "你必须锻炼身心，才能在未知世界中稳步前行，永远不被诱惑带离道路。";
		next;
		mes "[Leader Gion]";
		mes "我们的祖先设计了 4 项测试来训练族人。";
		next;
		select("4 项测试？");
		cutin "job_ko01",2;
		mes "[Leader Gion]";
		mes "是的，一共有 4 项测试。";
		mes "祖先用包含^087FF8知识^000000、^087FF8生存^000000、^087FF8武器^000000和^087FF8战斗^000000的 4 项测试训练族人。";
		next;
		mes "[Leader Gion]";
		mes "我知道你很好奇这些测试是什么。让我逐一说明。";
		next;
		while(1) {
			set .@i, select("知识测试:生存测试:武器测试:战斗测试");
			set .@test, .@test | (1<<(.@i-1));
			switch (.@i) {
			case 1:
				mes "[Leader Gion]";
				mes "我们需要拥有知识才能协助领主。这项测试就是为此而设。";
				next;
				mes "[Leader Gion]";
				mes "10 道题中答对超过 9 道，就能通过测试。";
				next;
				if (.@test != 15) {
					mes "[Leader Gion]";
					mes "如果你一直认真学习，测试就很容易通过。你还对哪项测试感兴趣？";
					next;
				}
				break;
			case 2:
				mes "[Leader Gion]";
				mes "任务并不总是简单安全，所以生存本能对我们至关重要。";
				next;
				mes "[Leader Gion]";
				mes "祖先把这项测试称为骰子测试。根据骰子结果前进。";
				next;
				mes "[Leader Gion]";
				mes "把它想成普通人玩的简单骰子游戏。";
				next;
				mes "[Leader Gion]";
				mes "但测试中绝不能放松警惕，因为它被称为生存测试不是没有原因的。";
				next;
				mes "[Leader Gion]";
				mes "有些格子会帮助你，也有些格子会阻碍你。";
				next;
				if (.@test != 15) {
					mes "[Leader Gion]";
					mes "如果你能明智处理各种情况，就能通过测试。你还对哪项测试感兴趣？";
					next;
				}
				break;
			case 3:
				mes "[Leader Gion]";
				mes "我的家族因使用亲手创造的独特武器而闻名。";
				next;
				mes "[Leader Gion]";
				mes "如果能创造自己的独特武器，就会被认为受到了祝福。";
				next;
				mes "[Leader Gion]";
				mes "为自己创造武器并精炼它，就是这项测试的目的。";
				next;
				if (.@test != 15) {
					mes "[Leader Gion]";
					mes "希望你能受到祝福，找到最适合自己的武器。你还对哪项测试感兴趣？";
					next;
				}
				break;
			case 4:
				mes "[Leader Gion]";
				mes "任务并不总是独自完成。你经常要和 2 至 3 人组成队伍，为共同目标努力。";
				next;
				mes "[Leader Gion]";
				mes "战斗测试只对通过知识、生存和武器测试的人开放。所以！这是最后一项测试。";
				next;
				mes "[Leader Gion]";
				mes "与其他三项独自完成的测试不同，最后一项测试需要和其他人竞争。";
				next;
				mes "[Leader Gion]";
				mes "目标只有一个！！";
				mes "只有第一个抵达目标的人才能通过测试。";
				next;
				mes "[Leader Gion]";
				mes "测试时没有竞争对手的话，你就算走运了。";
				next;
				if (.@test != 15) {
					mes "[Leader Gion]";
					mes "挑战一次胜过解释一百遍。实际体验才能让你变得更强。";
					next;
				}
				break;
			}
			if (.@test == 15) break;
		}
		cutin "job_ko02",2;
		mes "[Leader Gion]";
		mes "眼见为实，所以去接受挑战吧。"; //custom translation
		next;
		erasequest 5134;
		setquest 5135;
		set job_kagero,5;
		mes "[Leader Gion]";
		mes "准备好后我们马上开始。";
		close2;
		cutin "",255;
		end;
	} else if (job_kagero == 5) {
		set .@ko_test_01, isbegin_quest(5136);
		set .@ko_test_02, isbegin_quest(5137);
		set .@ko_test_03, isbegin_quest(5138);
		set .@ko_test, .@ko_test_01 + .@ko_test_02 + .@ko_test_03;
		if (.@ko_test == 0) {
			cutin "job_ko03",2;
			mes "[Leader Gion]";
		mes "已经有一段时间了。";
			next;
			mes "[Leader Gion]";
		mes "我已经很久没有这样开心过了。看到你这样的年轻人挑战新的道路，我也觉得自己年轻而充满活力。";
			next;
			mes "[Leader Gion]";
		mes "测试说明讲完了，现在要听我的家族故事吗？";
			next;
			cutin "job_ko01",2;
			mes "[Leader Gion]";
		mes "我的家族起源于两位战士。";
			next;
			mes "[Leader Gion]";
		mes "影狼，像太阳舞动的火焰一样的战士。";
			next;
			mes "[Leader Gion]";
		mes "朧，像朦胧月光一样的战士。";
			next;
			mes "[Leader Gion]";
		mes "太阳与月亮。";
		mes "照亮世界的阳光与照亮夜晚的月光。两位战士十分相似，却又截然不同。";
			next;
			mes "[Leader Gion]";
		mes "曾经有一段时间，两位战士彼此敌对。";
			next;
			mes "[Leader Gion]";
		mes "但没过多久，他们就合为一个家族。";
			next;
		select("后来怎么样了？");
			cutin "job_ko02",2;
			mes "[Leader Gion]";
		mes "哈哈哈。一次听完整个故事可没意思，对吧？通过一项测试后再回来，我会继续讲。";
			next;
			mes "[Leader Gion]";
		mes "你要选择哪项作为第一项测试？";
			next;
			callsub L_StartTest,select("知识测试:生存测试:武器测试"),1;
			end;
		} else if (.@ko_test == 2) {
			cutin "job_ko01",2;
			mes "[Leader Gion]";
			if (.@ko_test_01 == 2) {
				set .@menu$,":Test of Survival:Test of Weaponry";
		mes "你通过了知识测试。";
				next;
				mes "[Leader Gion]";
		mes "我的朋友不容易认可别人，但我想他喜欢你。";
				next;
			} else if (.@ko_test_02 == 2) {
				set .@menu$,"Test of Knowledge::Test of Weaponry";
		mes "你通过了生存测试。";
				next;
				mes "[Leader Gion]";
		mes "看来这项测试让你经历了地狱。";
				next;
			} else if (.@ko_test_03 == 2) {
				set .@menu$,"Test of Knowledge:Test of Survival:";
		mes "你通过了武器测试。";
				next;
				mes "[Leader Gion]";
		mes "不知道乔是否满意你的表现。";
				next;
			}
			select("请继续讲家族故事。");
			cutin "job_ko02",2;
			mes "[Leader Gion]";
		mes "看来你很想继续听。刚才讲到哪里了……啊！我想起来了。";
			next;
			mes "[Leader Gion]";
		mes "影狼，像太阳舞动的火焰一样的战士。";
			next;
			mes "[Leader Gion]";
		mes "朧，像朦胧月光一样的战士。";
			next;
			mes "[Leader Gion]";
		mes "两位战士一开始并不亲近，因为性格和其他一切都完全相反。";
			next;
			mes "[Leader Gion]";
		mes "他们第一次见面是在战场上。你知道敌人在战场上会如何打招呼。";
			next;
			mes "[Leader Gion]";
		mes "结果他们都身受重伤。";
			next;
			mes "[Leader Gion]";
		mes "但又能怎么办？战争就是战争。";
			next;
			mes "[Leader Gion]";
		mes "昨天与你欢笑的朋友，今天在战争中就会成为你必须交战的敌人。";
			next;
			mes "[Leader Gion]";
		mes "所以战争中没有人能和任何人和平相处。";
			next;
			mes "[Leader Gion]";
		mes "通过另一项测试后，我会继续这个故事。";
			next;
			mes "[Leader Gion]";
		mes "第二项测试你要选择哪一项？";
			next;
			callsub L_StartTest,select(.@menu$),2;
			end;
		} else if (.@ko_test == 4) {

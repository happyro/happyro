rachel,174,138,6	script	High Priestess Niren#HM	4_F_MADAME,{
	cutin "ra_gwoman",2;

	if (BaseLevel < 80) {
		mes "[Niren]";
		mes "抱歉，我现在很忙。";
		next;
		mes "[Niren]";
		mes "愿芙蕾雅的祝福与你同在。";
		close3;
	}
	.@player_name$ = strcharinfo(0);

	if (isbegin_quest(14594) == 0) {
		mes "[Niren]";
		mes "冒险者，你来了。谢谢你百忙之中抽出时间。";
		next;
		mes "[Niren]";
		mes "我请你来这里，是因为有件事想拜托冒险者。";
		next;
		mes "[" + .@player_name$ + "]";
		mes "如果是很麻烦的请求……教皇发生什么事了吗？";
		next;
		mes "[Niren]";
		mes "首先，请原谅我向你提出这个请求。";
		next;
		mes "[Niren]";
		mes "关于教皇，除了获准在神殿内公开外，严禁对外宣布。任何谈论或听闻此事的人都会受到重罪惩罚。";
		next;
		mes "[Niren]";
		mes "不过，即使情况如此，而且冒险者认为我是可靠的人，也请听我接下来的话。无论你是否接受请求，都必须对今天的谈话绝对保密。";
		next;
		mes "[Niren]";
		mes "明白了吗？";
		next;
		select( "我不太明白。" );
		mes "[Niren]";
		mes "毕竟我觉得你值得信任，所以我会相信你并告诉你。";
		next;
		mes "[Niren]";
		mes "正如冒险者猜测的那样，教皇最近遇到了一点问题。";
		next;
		mes "[Niren]";
		mes "^0000cd教皇的睡眠时间^000000异常，而且越来越长。";
		next;
		mes "[Niren]";
		mes "一开始她只是傍晚早早睡觉，后来早上起得越来越晚，现在甚至更加频繁地睡觉。";
		next;
		mes "[Niren]";
		mes "现在她仍然在睡觉。";
		next;
		mes "[" + .@player_name$ + "]";
		mes "她的健康出了问题吗？";
		next;
		mes "[Niren]";
		mes "不是。我们也曾认为教皇的健康可能异常，做过各种检查，但除了总是睡觉外，她的身体状况非常好。";
		next;
		mes "[Niren]";
		mes "但是……";
		next;
		mes "[" + .@player_name$ + "]";
		mes "但是？";
		next;
		mes "[Niren]";
		mes "醒来后，她表情悲伤，经常沉浸在其他思绪中，注意力也无法集中。然后又回去睡觉。";
		next;
		mes "[Niren]";
		mes "情况持续如此，连神殿内部也开始一点点流传起传闻。";
		next;
		mes "[" + .@player_name$ + "]";
		mes "如果不是健康问题，那是什么问题？";
		next;
		mes "[Niren]";
		mes "一定是心理问题。在我看来，这似乎和她在^0000cd梦中^000000看到的东西有关。";
		next;
		mes "[Niren]";
		mes "有一次，她醒来后问起了她的^0000cd兄弟卢明^000000。";
		next;
		mes "[" + .@player_name$ + "]";
		mes "所以教皇有家人……？";
		next;
		mes "[Niren]";
		mes "是的。不过按照我们的宗教，成为教皇前进入神殿时，必须洗去并忘记一切。";
		next;
		mes "[Niren]";
		mes "这也包括与家人的所有联系。";
		next;
		mes "[Niren]";
		mes "这是人生只有一次的机会：作为被选中的孩子出生，进入神殿，重生为供奉女神的躯体。";
		next;
		mes "[Niren]";
		mes "所以从官方角度来说，教皇没有世俗家人。";
		next;
		mes "[Niren]";
		mes "了解这一事实的教皇在梦醒后询问家事，说明她在梦中看到了什么。";
		next;
		mes "[" + .@player_name$ + "]";
		mes "但那只是梦，对吧？";
		next;
		mes "[Niren]";
		mes "是的，当然只是梦，但我不这么认为。这就是我们招募冒险者的原因。";
		next;
		mes "[Niren]";
		mes "教皇不被允许接触神殿中的任何人。如果有人想接近教皇，就必须贿赂神殿内部的人，或使用其他方法。";
		next;
		mes "[Niren]";
		mes "不过，由于被发现的概率很高，这种方法不太可能成功。";
		next;
		mes "[Niren]";
		mes "不引起他人怀疑而接触教皇的唯一方法就是进入梦境。看来有人突破了监视，干扰教皇的梦境。";
		next;
		mes "[" + .@player_name$ + "]";
		mes "这可能吗？";
		next;
		mes "[Niren]";
		mes "无法确认，但有可能。";
		next;
		mes "[Niren]";
		mes "还有一个人对此抱有疑问。";
		next;
		mes "[Niren]";
		mes "教皇的^0000cd双胞胎兄弟^000000，他被^0000ff克图拉纳克斯^000000封在^0000ff冰洞^000000深处的冰中。";
		next;
		mes "[Niren]";
		mes "根据最近的调查报告，他因为受到克图拉纳克斯的影响而获得了微弱的魔力。";
		next;
		mes "[Niren]";
		mes "双胞胎在同一天、同一时刻出生，应该存在特殊联系。";
		next;
		mes "[Niren]";
		mes "如果意识能通过梦境与教皇接触，就有可能通过梦境干预与教皇有关的一切。";
		next;
		mes "[Niren]";
		mes "以无意识的方式。";
		next;
		mes "[Niren]";
		mes "由于教皇目前的睡眠时间越来越长，我们推测有人试图控制她，或者教皇自己不愿醒来。";
		next;
		mes "[Niren]";
		mes "所以我希望你能进入教皇的梦境，看看发生了什么。如果发现问题，就解决它们。";
		next;
		mes "[" + .@player_name$ + "]";
		mes "但要怎么进入别人的梦？";
		next;
		mes "[Niren]";
		mes "可以通过能够穿越梦境的^0000cd特殊装置^000000。";
		next;
		mes "[" + .@player_name$ + "]";
		mes "但为什么必须由我去，而不是神殿官员？";
		next;
		mes "[Niren]";
		mes "我不能告诉你更多细节，但阿鲁纳佩尔兹的情况并不好，尤其是神殿内部。";
		next;
		mes "[Niren]";
		mes "教皇目前的状态可能会被政治势力利用。";
		next;
		mes "[Niren]";
		mes "所以教皇寻找了能公平看待双方且值得信任的人，最后秘密招募了你。";
		next;
		mes "[Niren]";
		mes "我必须守住自己的职位并照顾教皇，所以只能拜托你。";
		next;
		mes "[Niren]";
		mes "教皇是阿鲁纳佩尔兹的希望与梦想。";
		next;
		mes "[Niren]";
		mes "如果她的梦境时间继续增加，总有一天她会无法醒来，永远沉睡……";
		next;
		mes "[Niren]";
		mes "在梦中保护教皇，并尽可能查明发生了什么。";
		next;
		mes "[Niren]";
		mes "不过那是梦，我不知道里面会有什么。没人知道教皇会展示什么，或她会如何反应。";
		next;
		mes "[Niren]";
		mes "也许真的很危险。所以请务必小心。";
		next;
		mes "[" + .@player_name$ + "]";
		mes "好。";
		next;
		mes "[" + .@player_name$ + "]";
		mes "你现在要进入她的梦吗？还是需要时间准备？";
		next;
		select( "让我准备一下。" );
		mes "[Niren]";
		mes "好。请做好准备，准备踏上梦境之路后再来找我。";
		setquest 14594;
		close3;
	}
	if (checkquest(14585,HUNTING) == 2 || checkquest(14587,HUNTING) == 2) {
		mes "[Niren]";
		mes "冒险者，教皇的梦境是什么样的？";
		next;
		mes "- 你详细描述了教皇和卢明的梦境。-";
		next;
		mes "[Niren]";
		mes "真奇怪。所以你发现她的梦源于日常生活中的焦虑？";
		next;
		mes "[Niren]";
		mes "我相信她已经恢复理智了。";
		next;
		mes "[Niren]";
		mes "冒险者，我可以再拜托你一件事吗？";
		next;
		mes "[Niren]";
		mes "你能再次陪教皇进入梦境吗？她……需要有人陪伴。";
		next;
		mes "[" + .@player_name$ + "]";
		mes "当然。我也亲口答应过教皇。";
		next;
		mes "[Niren]";
		mes "非常感谢。她一直被内心的恶魔困扰……";
		next;
		mes "[Niren]";
		mes "至于今天，你可以舒舒服服地休息了。";
		if (checkquest(14585,HUNTING) == 2)
			erasequest 14585;
		else
			erasequest 14587;
		getexp 126000,90000;
		close3;
	}
	switch( checkquest(14586,PLAYTIME) ) {
	case -1:
		if (!is_party_leader()) {
			mes "[Niren]";
			mes "……我觉得这不对。";
			next;
			mes "[Niren]";
			mes "继续之前，你应该先组队。";
			close3;
		}
		mes "[Niren]";
		mes "我需要你的帮助。";
		mes "最近教皇开始做很长的梦，而且梦境随着时间推移越来越长。";
		next;
		mes "[Niren]";
		mes "也许进入她的梦境，就能找出原因并安全解决。";
		next;
		if (select( "我要进入教皇的梦。", "取消" ) == 2)
			close3;
		if (isbegin_quest(14594) == 1)
			completequest 14594;
		if (isbegin_quest(14585) == 2)
			erasequest 14585;
		if (isbegin_quest(14587) == 2)
			erasequest 14587;
		.@md_name$ = "Half Moon In The Daylight";
		instance_create(.@md_name$);
		close3;
	case 0:
	case 1:
		mes "[Niren]";
		mes "教皇还没有入睡。";
		close3;
	case 2:
		mes "^0000ff次元旅行的痕迹已经消失。现在可以在次元之间移动了。^000000";
		erasequest 14586;
		close3;
	}
}

rachel,176,145,6	script	Dream#poent	PORTAL,{
	switch( checkquest(14586,PLAYTIME) ) {
	case -1:
		break;
	case 0:
	case 1:
		mes "[Dream Path]";
		mes "时空裂缝还不够稳定，无法来回通行。请等待后效计时结束后再来。";
		close;
	case 2:
		mes "^0000ff次元旅行的痕迹已经消失。现在可以在次元之间移动了。^000000";
		erasequest 14586;
		close;
	}
	if (!is_party_leader()) {
		mes "[Dream Path]";
		mes "只有队长可以进入。";
		close;
	}
	mes "[Dream Path]";
	mes "你好，我是通往梦境的通道。能为你做什么？";
	next;
	if (select( "让我进入你的梦境。", "取消" ) == 2) {
		mes "[Dream Path]";
		mes "好，我明白了。改变主意后请再来。";
		close;
	}
	if (!is_party_leader()) {	// shouldn't happen
		mes "[Dream Path]";
		mes "只有队长可以进入。";
		close;
	}
	.@md_name$ = "Half Moon In The Daylight";

	switch( instance_enter(.@md_name$) ) {
	case IE_NOMEMBER:
		end;
	case IE_NOINSTANCE:
		mes "通道尚未启动。";
		close;
	case IE_OTHER:
		mes "发生未知错误。";
		close;
	case IE_OK:
		mes "[Dream Path]";
		mes "我会打开我的梦境。";
		mes "希望你做个好梦。";
		mapannounce "rachel", "队伍成员 " + strcharinfo(0) + "（" + getpartyname( getcharid(1) ) + "）正在进入" + .@md_name$ + "。", bc_map, 0xFF99;
		if (BaseLevel < 130) {
			if (isbegin_quest(14585) == 0)
				setquest 14585;
		} else {
			if (isbegin_quest(14587) == 0)
				setquest 14587;
		}
		setquest 14586;
		close;
	}
	end;
}

//============================================================
//== Map 1
//============================================================
1@pop1,50,137,3	script	Pope#1hmoon01	4_F_ARUNA_POP,{
	if (!is_party_leader())	// shouldn't happen
		end;
	if ('progress != 0)
		end;

	'account_id_leader = getcharid(3);
	if (BaseLevel > 129)
		'mode = 1;
	.@player_name$ = strcharinfo(0);

	cutin "pop_sim",2;
	mes "[Pope]";
	mes "……妮伦？";
	npctalk "……妮伦？";
	next;
	mes "[Pope]";
	mes "妮伦……？";
	next;
	mes "[Pope]";
	mes "我找不到提利比。";
	mes "这里太……黑了……";
	npctalk "我什么都看不见……";
	next;
	mes "[Pope]";
	mes "妮伦……？";
	next;
	mes "[Pope]";
	mes "……你在哪里……？";
	next;
	mes "[" + .@player_name$ + "]";
	mes "教皇，我是来帮助你的。";
	next;
	mes "[Pope]";
	mes "...........";
	mes "...........";
	next;
	mes "[" + .@player_name$ + "]";
	mes "教皇，请冷静。我是妮伦派来的。";
	next;
	mes "[Pope]";
	mes "谁……？";
	npctalk "妮伦派来的……？";
	next;
	mes "[" + .@player_name$ + "]";
	mes "我是冒险者，" + .@player_name$ + "。";
	next;
	mes "[Pope]";
	mes "" + .@player_name$ + "?";
	next;
	mes "[Pope]";
	mes "妮伦……是她派你来的吗？";
	next;
	mes "[Pope]";
	mes "妮伦在哪里？";
	next;
	mes "[" + .@player_name$ + "]";
	mes "妮伦最近很忙，所以派我来了。";
	next;
	mes "[Pope]";
	mes "是啊……我想起来了。冒险者……";
	npctalk "我记起来了……";
	next;
	mes "[" + .@player_name$ + "]";
	mes "你刚才在做什么？";
	next;
	mes "[Pope]";
	mes "提利比……不见了。无论我怎么找……";
	next;
	mes "[" + .@player_name$ + "]";
	mes "提利比是谁？";
	next;
	mes "[Pope]";
	mes "妮伦把玩偶给了我。我刚才还拿着它。";
	next;
	mes "[Pope]";
	mes "我想我把玩偶弄丢在这里了。";
	npctalk "你去哪儿了……";
	next;
	mes "[" + .@player_name$ + "]";
	mes "我们去找它吧。";
	next;
	mes "[Pope]";
	mes "不，已经太晚了……";
	next;
	mes "[" + .@player_name$ + "]";
	mes "没关系。你一定能找到它。";
	next;
	mes "[Pope]";
	mes "不……我有约定。";
	mes "我有要见的人。";
	npctalk "我迟到了。";
	next;
	mes "[" + .@player_name$ + "]";
	mes "约定？在这里吗？";
	next;
	mes "[Pope]";
	mes "在神殿外……但它看起来不像提利比。";
	next;
	mes "[Pope]";
	mes "现在找提利比已经太晚了。";
	next;
	mes "[" + .@player_name$ + "]";
	mes "提利比似乎不在这里，要不要去别处找找？";
	next;
	mes "[" + .@player_name$ + "]";
	mes "我们一起找吧。";
	next;
	cutin "POP_nor", 2;
	mes "[Pope]";
	mes "……好。";
	next;
	mes "[Pope]";
	mes "你的名字叫什么来着？";
	next;
	mes "[" + .@player_name$ + "]";
	mes "" + .@player_name$ + ".";
	next;
	mes "[Pope]";
	mes "来吧，我们一起走。";
	disablenpc();
	enablenpc instance_npcname("#1hmoond01");	// (warp)
	if ('progress == 0)
		'progress = 1;
	close3;

OnInstanceInit:
	'progress = 0;
	'mode = 0;
	'account_id_leader = 0;
	'1hmoon = 0;
	'2hmoon = 0;
	'3hmoon = 0;

	'map_pop1$ = instance_mapname("1@pop1");
	'map_pop2$ = instance_mapname("1@pop2");
	'map_pop3$ = instance_mapname("1@pop3");
	end;
}

1@pop1,100,142,3	script	Pope#1hmoon03	4_F_ARUNA_POP,5,5,{
	end;
OnTouch:
	if ('progress != 1)
		end;
	'progress = 2;
	npctalk "向南走……";
	disablenpc();
	enablenpc instance_npcname("#1hmoond03");	// (warp)
	end;
}

1@pop1,100,98,3	script	Pope#1hmoon04	4_F_ARUNA_POP,{
	if ('progress != 2)
		end;
	mes "[Priest]";
	mes "教皇陛下。";
	npctalk "教皇陛下", instance_npcname("Priest#1hmoon01");
	next;
	mes "[Priest]";
	mes "教皇到了。";
	npctalk "教皇到了。", instance_npcname("Priest#1hmoon02");
	next;
	mes "[Devotee]";

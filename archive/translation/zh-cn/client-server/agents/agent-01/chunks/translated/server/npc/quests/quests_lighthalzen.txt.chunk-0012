lhz_in01,273,121,1	script	Mad Scientist#li	4_LGTSCIENCE,{
	if (lhz_curse == 13) {
		mes "[沃尔切夫]";
		mes "谁也不许";
		mes "打断我的";
		mes "研究！你敢的话，我就……";
		mes "吃了你。";
		mes "活生生地吃掉你。";
		next;
		switch(select("不……不行！:需要帮忙吗？")) {
		case 1:
			mes "[沃尔切夫]";
			mes "从我眼前消失，";
			mes "你这个小脑袋的蠢货！";
			close;
		case 2:
			mes "[沃尔切夫]";
			mes "嗯？你以为我有闲心";
			mes "记住每一个被我解雇的";
			mes "临时工的脸吗？滚开，";
			mes "否则我就让你体验";
			mes "被活生生吃掉的痛苦！";
			mes "现在马上离开。";
			set lhz_curse,14;
			close;
		}
	}
	else if (lhz_curse == 14) {
		mes "[沃尔切夫]";
		mes "又是你？！";
		mes "你到底想从我这里";
		mes "得到什么？！";
		emotion ET_ANGER;
		next;
		switch(select("让我和你谈谈。:抱歉打扰你了。")) {
		case 1:
			mes "[沃尔切夫]";
			mes "我没时间";
			mes "浪费在废话上！我正";
			mes "忙着做研究呢！";
			next;
			mes "[沃尔切夫]";
			mes "………………！";
			emotion ET_SURPRISE;
			next;
		mes "[沃尔切夫]";
		mes "啊，等等！我正在收集";
			mes "某样东西。对，把我必须收集的";
			mes "东西带来。对，对。";
			mes "提示……它是圆的……";
			mes "闪闪发光……孩子们喜欢拿它玩游戏！哎呀，我说太多了！";
			set lhz_curse,15;
			changequest 2089,2090;
			close;
		case 2:
			emotion ET_FRET;
			mes "[沃尔切夫]";
			mes "‘抱歉？！’你以为";
			mes "一句‘抱歉’就能";
			mes "弥补我浪费在对你";
			mes "大喊大叫上的宝贵一分钟吗？！";
			mes "滚出去！";
			close;
		}
	}
	else if (lhz_curse == 15) {
		if (countitem(746) > 0) {
			delitem 746,1; //Glass_Bead
			mes "[沃尔切夫]";
			mes "是……！玻璃珠！";
			mes "你把它们带来了！";
			mes "你没有我想象中";
			mes "那么笨嘛！";
			next;
				switch(select("你为什么要玻璃珠？")) {
			case 1:
				mes "[沃尔切夫]";
				mes "..................";
				mes "我收回刚才的话！";
				mes "你现在应该知道，";
				mes "我绝不会告诉你";
				mes "我为什么需——要";
				mes "这些玻璃珠。呜嘿嘿！";
				emotion ET_KIK;
				next;
				break;
			}
			mes "[沃尔切夫]";
			mes "你帮了我这个忙，";
			mes "值得我和你聊几句，";
			mes "我可以抽出一两分钟";
			mes "回答你那些无聊的问题。";
			mes "所以你想知道什么？！";
			next;
			while (1) {
					switch(select("询问爱好:询问工作")) {
				case 1:
					if (Sex == SEX_MALE) {
						mes "[沃尔切夫]";
						mes "嘻嘻~我觉得你";
						mes "实在太天真，";
						mes "不适合知道我的秘密";
						mes "爱好。是的，是的，我不能";
						mes "告诉你，那会很奇怪，";
						mes "太奇怪了……";
						next;
					}
					else {
						mes "[沃尔切夫]";
						mes "哦，不，不，不，";
						mes "我绝对不能说……";
						mes "那是——那是个秘密。";
						mes "反正你不会想知道的。";
						mes "呜嘿嘿嘿嘿！";
						next;
					}
					break;
				case 2:
					mes "[沃尔切夫]";
					mes "哦，我不知道这能不能算工作。";
					mes "毕竟，我想研究什么";
					mes "就研究什么。";
					mes "他们还付钱让我做！";
					mes "对我这样的科学家来说，";
					mes "这里真是最棒的地方。";
					next;
					mes "[沃尔切夫]";
					mes "当然，在理想的世界里，";
					mes "我的实验对象应该";
					mes "更加合作，但";
					mes "我想也不能怪他们。";
					mes "我又没有让他们";
					mes "承受不必要的痛苦什么的……";
					next;
					set .@exit,1;
					break;
				}
				if (.@exit) break;
			}
			switch(select("什么研究？")) {
			case 1:
				mes "[沃尔切夫]";
				mes "嗯，我不能确切告诉你。";
				mes "不过别担心，我正在进行的";
				mes "发现会造福全世界，";
				mes "你很快就会看到。";
				mes "这是我的研究方向。";
				next;
				mes "[沃尔切夫]";
				mes "这么说吧，一旦成功，";
				mes "我就能满足人类最原始的";
				mes "本能之一：变得强大，";
				mes "并支配那些";
				mes "比自己弱小的存在。";
				mes "这就是我真正的目标。";
				next;
				mes "[沃尔切夫]";
				mes "我的进展还没有达到预期，";
				mes "但没关系。这只是实验问题！";
				mes "是的，要让人类变得";
				mes "更强、更好、更强大，";
				mes "然后继续进化——";
				mes "不断变得更强。";
				next;
				break;
			}
			select("嗯，你在测试什么？");
			mes "[沃尔切夫]";
			mes "你知道什么？";
			mes "我最好回去工作，";
			mes "否则就赶不上进度了。";
			mes "我可没空再和你";
			mes "闲聊下去。呜嘿嘿嘿！";
			mes "快回去工作吧。";
			set lhz_curse,16;
			close;
		}
		else {
			mes "[沃尔切夫]";
			mes "我没时间";
			mes "浪费在废话上！我正";
			mes "忙着做研究呢！";
			next;
				mes "[沃尔切夫]";
				mes "...........!";
			emotion ET_SURPRISE;
			next;
			emotion ET_KIK;
			mes "[沃尔切夫]";
			mes "啊，等等！我正在收集";
			mes "某样东西。对，把我必须收集的";
			mes "东西带来。对，对。";
			mes "提示……它是圆的……";
			mes "闪闪发光……孩子们喜欢拿它玩游戏！哎呀，我说太多了！";
			close;
		}
	}
}


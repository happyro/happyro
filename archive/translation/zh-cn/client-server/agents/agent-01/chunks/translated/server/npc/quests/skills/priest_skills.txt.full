				prt_church,111,112,1	script	Sister Linus	79,{
				if (BaseJob == Job_Priest) {
				if (PRIEST_SK == 100) {
			if (getskilllv("PR_REDEMPTIO") == 0) {
			mes "[Sister Linus]";
			mes "嗯？我们以前见过，";
			mes "对吧？不过话说回来，";
			mes "所有服事看久了都";
			mes "长得一样。啊，";
			mes "你是不是我教过";
			mes "救赎技能的人？";
			next;
			mes "[Sister Linus]";
			mes "啊，你忘了吗？";
			mes "没关系，我可以再教你。";
			mes "这项技能能让你牺牲自己的生命，";
			mes "复活倒下的队伍成员。";
			next;
			mes "[Sister Linus]";
			mes "^3131FF神圣而尊贵的存在，";
			mes "我们向你祈祷。请施予慈悲，";
			mes "用你的光引导我们。赐予我们";
			mes "走上爱与牺牲之路的力量。救赎！^000000";
			skill "PR_REDEMPTIO",1,SKILL_PERM;
			next;
			mes "[Sister Linus]";
			mes "好了……";
			mes "现在你应该";
			mes "可以施放救赎了。";
			mes "希望你在冒险中善用它~";
			close;
			}
			else {
			mes "[Sister Linus]";
			mes "我会一直为你的安全祈祷。";
			mes "请多加小心，希望你能把爱与怜悯";
			mes "带给旅途中遇到的所有人。";
			close;
			}
			}
			else if (PRIEST_SK == 0) {
			set redemp,1014;
			if (getskilllv("PR_REDEMPTIO")) {
			mes "[Sister Linus]";
			mes "我会一直为你的安全祈祷。";
			mes "请多加小心，希望你能把爱与怜悯";
			mes "带给旅途中遇到的所有人。";
			set PRIEST_SK,100;
			close;
			}
			mes "[Sister Linus]";
			mes "请施予慈悲，";
			mes "让你的光照耀世界。用仁慈的智慧引导她……";
			mes "祝福她，让她受到你的恩典保护。";
			next;
			select("姐姐，你在为谁祈祷？");
			mes "[Sister Linus]";
			mes "哦！你吓到我了！";
			mes "我在为谁祈祷？";
			mes "嗯，我曾认识一位年轻、";
			mes "活泼快乐又有点大胆的修女。";
			mes "我和她有许多快乐的回忆。";
			next;
			mes "[Sister Linus]";
			mes "一天，一群冒险者来到普隆德拉教堂，";
			mes "希望雇佣服事陪他们前往^3131DD古城^000000。";
			mes "命运安排她成为唯一可用的";
			mes "服事。";
			next;
			mes "[Sister Linus]";
			mes "我记得她非常";
			mes "坚定地想加入冒险者，";
			mes "我们只好让她离开。";
			mes "不过很多人认为";
			mes "那太危险了……";
			next;
			mes "[Sister Linus]";
			mes "听说一开始，他们那支";
			mes "临时队伍成功消灭了";
			mes "大量怪物。";
			mes "但作为服事支援他们";
			mes "一定让她很辛苦……";
			next;
			mes "[Sister Linus]";
			mes "后来，悲剧发生了。";
			mes "冒险者被流浪者包围，";
			mes "一个接一个迅速败下阵来。很快，";
			mes "队伍里只剩年轻修女站着。";
			next;
			mes "[Sister Linus]";
			mes "面对不可能的困境，";
			mes "可怜的女孩只能";
			mes "孤注一掷。她开始吟唱";
			mes "古老的神圣法术……";
			next;
			select("古老的法术……？");
			mes "[Sister Linus]";
			mes "是的！^FF0000救赎^000000！";
			mes "只有最有天赋的服事";
			mes "才能施放的技能！";
			mes "而她，一个经验极少的";
			mes "年轻修女，竟然尝试了！";
			next;
			mes "[Sister Linus]";
			mes "救赎是最后手段，";
			mes "可以高尚地拯救他人生命，";
			mes "代价是^3131FF牺牲自己的生命^000000。";
			next;
			mes "[Sister Linus]";
			mes "是的，我记得她过去";
			mes "对学习服事和服事见习生技能";
			mes "并不感兴趣。令人惊讶的是，";
			mes "她学到了足够的知识，";
			mes "尝试施放救赎……";
			next;
			mes "[Sister Linus]";
			mes "奇迹般地，她成功";
			mes "复活了队伍成员。";
			mes "他们迅速使用世界树叶";
			mes "恢复她的生命，击败流浪者，";
			mes "安全回到了家。";
			next;
			mes "[Sister Linus]";
			mes "因为这次成功，尽管过去犯过许多错误，";
			mes "她还是晋升为大主教。";
			mes "如今她周游世界，";
			mes "尽力帮助冒险者。";
			next;
			mes "[Sister Linus]";
			mes "不过对我来说，";
			mes "她永远是那个";
			mes "活泼快乐的女孩。";
			next;
			mes "["+ strcharinfo(0) +"]";
			mes "等等，你还没回答我的问题。";
			mes "你是在为这位修女祈祷吗？";
			mes "如果是，她遇到了什么危险吗？";
			next;
			mes "[Sister Linus]";
			mes "嗯，几个月前，";
			mes "她前往^3131FF莱茵哈特^000000，";
			mes "施瓦尔茨瓦德共和国的一座城市。";
			mes "我只是担心，因为有一段时间";
			mes "没收到她的消息了。";
			next;
		mes "[Sister Linus]";
		mes "我每天来这里为她祈祷，";
			mes "希望她平安归来，";
			mes "和我分享冒险故事。";
			mes "哦，我们可以聊一整晚！一定很有趣！";
			next;
			mes "[Sister Linus]";
			mes "天啊，我一直在喋喋不休！";
				mes "抱歉耽搁你了，你是不是";
				mes "还有地方要去？那么，";
				mes "我会为你的安全祈祷~";
				next;
				mes "["+ strcharinfo(0) +"]";
				mes "在我离开前，能告诉我";
				mes "你说的那位大主教的名字吗？";
				mes "如果我见到她，会请她联系你。";
				next;
				mes "[Sister Linus]";
				mes "哦，谢谢你！她叫索林大主教。嗯，";
				mes "^3131FF玛格丽特·索林^000000。找到她的话，";
				mes "请告诉她我在为她的安全祈祷。";
				set PRIEST_SK,1;
				close;
				}
				else if (PRIEST_SK == 1) {
				mes "[Sister Linus]";
				mes "哦，你好~";
				mes "今天过得";
				mes "怎么样？";
				next;
				if (select("请教我 ^3131FF救赎^000000。:取消") == 1) {
				mes "[Sister Linus]";
				mes "哦，救赎是很适合你学习的技能~";
				mes "虽然很难施放，但成功后可以复活所有";
				mes "倒下的队伍成员。";
				next;
				mes "[Sister Linus]";
				mes "当然，缺点是你必须^3131FF牺牲自己的生命^000000";
			mes "才能使用技能。要学习救赎，";
			mes "必须先学会^3131FF 1 级复活^000000。";
			next;
			mes "[Sister Linus]";
			mes "啊，你还必须带来";
			mes "^3131FF30 瓶圣水和 20 颗蓝色宝石^000000，";
			mes "才能尝试学习技能。";
			set PRIEST_SK,2;
		next;
		mes "[Sister Linus]";
			mes "嗯，如果学习救赎失败，";
				mes "你会失去 1 瓶圣水和 1 颗蓝色宝石，";
					mes "还得再次尝试……";
					close;
					}
					mes "[Sister Linus]";
					mes "祈祷让我感到";
					mes "平静和安慰。也许这";
					mes "就是我选择这份工作的";
					mes "原因之一……";
					close;
					}
					else if (PRIEST_SK == 2) {
					if (getskilllv("ALL_RESURRECTION") > 0) {
					if (countitem(523) > 29 && countitem(717) > 19) {
					mes "[Sister Linus]";
					mes "哦，看来你已经带齐";
					mes "学习救赎所需的";
					mes "所有东西。";
					mes "准备好尝试了吗？如果失败，";
					mes "会失去 1 瓶圣水";
					mes "和 1 颗蓝色宝石，明白吗？";
					next;
					mes "[Sister Linus]";
					mes "现在，请集中精神，";
					mes "跟着我重复";
					mes "这段特殊的祷词。";
						next;
							mes "[修女莉娜丝]";
					mes "^3131FF神圣而尊贵的存在，";
						mes "我们向你祈祷。请施予慈悲，";
							mes "用你的光引导我们。赐予我们";
					mes "走上爱与牺牲之路的力量。救赎！^000000";
						next;
							set .@redem_s,JobLevel+getskilllv("ALL_RESURRECTION");
					set .@red_suc,rand(1,100);
if( .@redem_s < 31 ) {
					if( .@red_suc > 20 && .@red_suc < 41 )
						set .@success,1;
						} else if( .@redem_s < 41 ) {
						if( .@red_suc > 10 && .@red_suc < 41 )
						set .@success,1;
						} else {
						if( .@red_suc > 10 && .@red_suc < 51 )
						set .@success,1;
						}
						
						if (.@success) {
						specialeffect2 EF_HEALSP;
						mes "[修女莉娜丝]";
						mes "恭喜你！";
					mes "你成功学会了";
					mes "救赎！";
						mes "请记住只在最危急的";
						mes "情况下使用这项技能。";
						delitem 717,20; //Blue_Gemstone
						delitem 523,30; //Holy_Water
						set PRIEST_SK,100;
						skill "PR_REDEMPTIO",1,SKILL_PERM;
						close;
						}
						else {
						specialeffect2 EF_POISONHIT;
						mes "[修女莉娜丝]";
					mes "糟糕！抱歉，";
mes "你没能学会救赎。";
				mes "我会在这里等着，";
				mes "等你准备好后再试，好吗？";
					delitem 717,1; //Blue_Gemstone
					delitem 523,1; //Holy_Water
					close;
					}
					
					}
					else {
					mes "[修女莉娜丝]";
				mes "想尝试学习救赎，请带来";
			mes "^3131FF20 颗蓝色宝石^000000和";
			mes "^3131FF30 瓶圣水^000000。啊，还要";
				mes "先学会^3131FF 1 级复活^000000。";
				close;
				}
				}
				else {
				mes "[修女莉娜丝]";
				mes "想尝试学习救赎，请带来";
				mes "^3131FF20 颗蓝色宝石^000000和";
			mes "^3131FF30 瓶圣水^000000。啊，还要";
		mes "先学会^3131FF 1 级复活^000000。";
	close;
	}
		}
		}
		else {
		mes "[修女莉娜丝]";
		mes "请施予慈悲，让你的光";
		mes "照耀世界。用仁慈的智慧引导她……";
		mes "祝福她，让她受到你的恩典保护。";
		close;
	}
}


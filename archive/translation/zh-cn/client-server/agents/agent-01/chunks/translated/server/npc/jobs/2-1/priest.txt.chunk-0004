job_prist,98,105,4	script	prst3_1	45,3,3,{
OnTouch_:
	if (BaseJob == Job_Priest) {
		warp "prt_church",15,36;
		end; 
	}
	else if (BaseClass == Job_Acolyte) {
		set PRIEST_Q,7;
		if(checkquest(8012) != -1) {
			changequest 8012,8013;
		}
		warp "prt_church",16,37;
		donpcevent "Mummy_Generator::OnDisable";
	}
	end;
}

// Functions
//==========================================================
function	script	F_FatherRub	{
	if (PRIEST_Q != 0) {
		if (PRIEST_Q == 1) {
			mes "啊，你就是想成为牧师的年轻服事者。";
			next;
			mes "[鲁巴卡巴拉神父]";
			mes "我收到了保罗主教的消息。既然你完成了朝圣，希望你能实现成为牧师的目标。";
			next;
			mes "[鲁巴卡巴拉神父]";
			mes "另外，有机会请再来这座修道院。这是我们教会的圣地。";
			next;
			mes "[鲁巴卡巴拉神父]";
			mes "那么，请前往朝圣的下一个目的地。旅途小心。";
			close2;
			savepoint "prt_fild03",361,255,1,1;
			set PRIEST_Q,2;
			end;
		}
		else if (PRIEST_Q == 2) {
			mes "请尽快前往朝圣的下一个目的地。希望你早日成为牧师。";
			close;
		}
		mes "可以问问你为什么回来吗？请回去继续修行。";
		close;
	}
	mes "我不知道你为何来到这里，请容我失陪。";
	close;
}

function	script	F_MotherMart	{
	if (PRIEST_Q != 0) {
		if (PRIEST_Q == 1) {
			mes "嗯……";
			mes "看来你正在";
			mes "训练成为";
			mes "牧师。";
			next;
			mes "[玛蒂尔达修女]";
			mes "不过，在朝圣的这个阶段，你不该来找我。";
			next;
			mes "[玛蒂尔达修女]";
			mes "也许你该再去询问保罗主教或塞西莉亚修女。愿上帝与你同在……";
			close;
			}
			else if (PRIEST_Q == 2) {
			mes "啊，你是";
			mes "牧师学徒……？";
			mes "欢迎！";
		next;
			mes "[玛蒂尔达修女]";
			mes "我们牧师有义务将上帝的福音传达给";
			mes "世人。";
			next;
			mes "[玛蒂尔达修女]";
			mes "成为牧师后，你可能会前往梦罗克金字塔。希望你能将那里的不死族从束缚它们的邪恶中解放。";
			next;
			mes "[玛蒂尔达修女]";
			mes "那么……";
			mes "我会向上帝祈祷";
			mes "愿上帝保佑";
			mes "愿你旅途平安。";
			close2;
			savepoint "moc_fild07",35,355,1,1;
			set PRIEST_Q,3;
			end;
			}
			else if (PRIEST_Q == 3) {
			mes "请尽快离开，";
			mes "继续训练。";
			close;
			}
			mes "可以问问你为何回来吗？请继续训练。";
			close;
			}
			mes "愿上帝";
		mes "与你同在……";
		close;
			}
			
			function	script	F_FatherYos	{
		if (PRIEST_Q != 0) {
		if (PRIEST_Q == 1) {
		mes "嗯……";
		mes "牧师学徒吗？";
	next;
	mes "[约斯克神父]";
	mes "你找错人了。如果之后需要见我，那也不是现在。";
	next;
mes "[约斯克神父]";
mes "但这是你自己的错。";
mes "现在回教会去，孩子。";
close;
	}
		else if (PRIEST_Q == 2) {
			mes "嗯……";
			mes "牧师学徒吗？";
			next;
			mes "[约斯克神父]";
			mes "你找错人了。如果之后需要见我，那也不是现在。";
			next;
			mes "[约斯克神父]";
			mes "但这是你自己的错。回教会去。";
			close;
			}
			else if (PRIEST_Q == 3) {
		mes "嗯。";
		mes "牧师";
		mes "学徒吗？";
		mes "欢迎。";
		next;
			mes "[约斯克神父]";
				mes "我不再多说。";
				mes "更多的话。";
				mes "把一生奉献给";
				mes "上帝吧。";
			next;
			mes "[约斯克神父]";
				mes "现在回教会去。";
				mes "你的第一项试炼";
				mes "至此";
				mes "完成。";
			close2;
			savepoint "prt_fild00",206,230,1,1;
			set PRIEST_Q,4;
			end;
		}
		else if (PRIEST_Q == 4) {
			mes "我叫你回教会。";
			mes "还是说你想在这里和我共度余生……？";
			close;
			}
			mes "去当牧师吧。这里不是孩子的游乐场。";
			close;
			}
		mes "……服事者，你在这里没什么事可做。";
			close;
			}
 

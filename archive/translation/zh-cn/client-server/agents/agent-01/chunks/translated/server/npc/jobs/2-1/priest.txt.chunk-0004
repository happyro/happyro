		next;
		mes "[黑暗领主]";
		mes "^330033捏碎你脆弱的身体、将骨头碾成尘埃对我来说易如反掌。";
		mes "现在回去吧，凡人！^000000";
		next;
		if (select("对不起，请饶了我！:上帝会保护我。") == 1) {
			mes "[黑暗领主]";
			mes "^330033永远别再回来！^000000";
			close2;
			warp "gl_church",145,170;
			end;
		}
		mes "[黑暗领主]";
		mes "^330033装出力量和勇气毫无用处。在我面前你毫无还手之力。你的技能可笑，武器与我的力量相比只是玩具。^000000";
		next;
		mes "[黑暗领主]";
		mes "^330033我挥手之间你就会消失，也没人会记得你。在我无尽魔法的威力前颤抖吧！^000000";
		next;
		if (select("求你了，别这样……！:滚开，卑鄙的恶魔！") == 1) {
			mes "[黑暗领主]";
			mes "^330033永远别再回来！^000000";
			close2;
			warp "gl_church",145,170;
			end;
		}
		mes "[黑暗领主]";
		mes "^330033为什么……";
		mes "你为什么不怕我？！";
		mes "对于脆弱的凡人，你";
		mes "真令人烦恼。^000000";
		next;
		mes "[黑暗领主]";
		mes "^330033下次见面时，我会把你带到受苦之境，让你在剧痛中度过多年。";
		mes "记住我的话……^000000";
		close;
	}
}

job_prist,168,150,4	script	Baphomet#prst	736,8,1,{
OnTouch_:
	if (BaseJob == Job_Priest) {
		mes "[巴风特]";
		mes "我讨厌";
		mes "牧师……";
		next;
		mes "[巴风特]";
		mes "我与你无关，上帝的仆人。请通过这里。";
		close;
	}
	else if (BaseClass == Job_Acolyte) {
		mes "[巴风特]";
		mes "问候。";
		next;
		mes "[巴风特]";
		mes "..."+ strcharinfo(0) +".";
		next;
		mes "[巴风特]";
		mes "是的，人类，";
		mes "我知道你是谁。";
		next;
		mes "[巴风特]";
		mes "我也知道小恶魔、卓柏卡布拉和黑暗领主都没能说服你放弃牧师之路。";
		mes "现在我站在";
		mes "你面前提出交易。";
		next;
		mes "[巴风特]";
		mes "我能赐予你想要的宝藏和触手可及的无限力量，以及人类从未见过的强大武器……";
		next;
		mes "[巴风特]";
		mes "堆积如山的 Zeny，一生也花不完。不过，谁说你的寿命必须有限？名望、力量、不朽：都可以属于你。";
		next;
		mes "[巴风特]";
		mes "你可以随时召唤我。所有人类都会害怕成为你的敌人。你将成为历史上最强大的人！";
		next;
		mes "[巴风特]";
		mes "停止追求牧师的愚行。与我签订契约。整个世界任你取用。";
		next;
		if (select("成交。:不，巴风特。你输了。") == 1) {
			mes "[巴风特]";
			mes "那么我们签订契约。你永远不会后悔这一刻……";
			next;
			mes "[巴风特]";
			mes "跟我来。";
			mes "我们将在我的";
			mes "黑暗圣所签订";
			mes "契约。";
			close2;
			warp "glast_01",200,203;
			end;
		}
		mes "[巴风特]";
		mes "愚蠢的人类……";
		mes "你做出了选择。那我暂时不打扰你。不过训练不会像你想的那么简单。";
		next;
		mes "[巴风特]";
		mes "我会为你准备军队。终有一天，我会享受看着爪牙慢慢吞噬你、让你痛苦挣扎的样子。";
		close;
	}
}

job_prist,168,180,4	script	prst2_1	45,3,3,{
OnTouch_:
	if (BaseJob == Job_Priest) warp "job_prist",98,40;
	else if (BaseClass == Job_Acolyte) {
		warp "job_prist",98,40;
		donpcevent "Mummy_Generator::OnEnable";
	}
	end;
}


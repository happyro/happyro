		next;
		mes "[戈帕拉]";
		mes "是的，但我也没办法。";
		npctalk "我好无聊。", "Gopara#dorcon01", bc_self;
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "呃，你就是供应卡卢纳的莱加拉斯吗？";
		next;
		mes "[莱加拉斯]";
		mes "你看！因为我没能完成交货，竟然有人找上门了！我完了！我会饿死的！";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "冷静。情况虽然糟糕，但没必要这么悲观。这里的人为什么都这么极端？";
		next;
		mes "[莱加拉斯]";
		mes "我不明白你的意思。请解释一下。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "冒险者俱乐部的卡卢想知道为什么迟迟没有交货。他今天有足够的货出售，只要今天能交货就没问题。";
		next;
		mes "[莱加拉斯]";
		mes "哈！呃！哈！我也希望能做到。但那两头猪正在吞食卡卢尼亚克！一开始只吃一两只，现在我一抓到它们就立刻吃掉。我根本没机会清洗和发酵！";
		next;
		mes "[莱加拉斯]";
		mes "如果你想要卡卢纳，就处理一下^0000cd那边的两个家伙^000000！他们不仅纠缠我，还毁了我的工作，我快疯了。也许我该回战场！";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "请冷静。我会和他们谈谈。";
		completequest 14567;// Kaluna milk is in Danger!
		setquest 14568;// Time to persuade
		lasagna_quest[2] = 2;
		close;
	}
	if (lasagna_quest[2] == 2) {
		mes "[莱加拉斯]";
		mes "无论如何他们都不听。看看他们的肚子，都是吃太多卡卢尼亚克和卡卢纳造成的。";
		close;
	}
	if (lasagna_quest[2] >= 3 && lasagna_quest[2] < 6) {
		mes "[莱加拉斯]";
		mes "谁知道猪突然跑到哪里去了，但希望它们暂时别回来。我正顺利工作呢！再一点，就差一点……！";
		close;
	}
	if (lasagna_quest[2] == 6) {
		mes "[" + strcharinfo(0) + "]";
		mes "莱加拉斯，我试过各种办法让他们工作，但他们既没有技能也没有意愿。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "不过他们答应不再吃卡卢尼亚克，所以你之后交货不会再有问题。";
		npctalk "他在说什么？", "Daldal#dorcon01", bc_self;
		npctalk "你这是怎么了？", "Gopara#dorcon01", bc_self;
		next;
		mes "[戈帕拉]";
		mes "你似乎对我们有意见。我会在莱加拉斯回来后把一切告诉他。";
		npctalk "你居然告我们的状。", "Gopara#dorcon01", bc_self;
		next;
		mes "[达尔达尔]";
		mes "我们到底做错了什么？";
		next;
		mes "[莱加拉斯]";
		mes "我还在想你为什么突然带走这两个家伙。原来是这样。带着他们到处跑一定很辛苦。";
		next;
		mes "[莱加拉斯]";
		mes "多亏你的牺牲，我才做出了大部分需要交付的^0000cd卡卢纳^000000。非常感谢。";
		next;
		mes "[戈帕拉]";
		mes "你们这是公开欺负我们。";
		next;
		mes "[达尔达尔]";
		mes "卡卢尼亚克果然是最棒的。";
		npctalk "又在吃？", "Gopara#dorcon01", bc_self;
		next;
		mes "[莱加拉斯]";
		mes "哎呀！那头猪又在吃卡卢尼亚克！";
		next;
		mes "[达尔达尔]";
		mes "我饿了。我再也不能吃鳀鱼，只能吃卡卢尼亚克。";
		npctalk "我也是。", "Gopara#dorcon01", bc_self;
		next;
		mes "[戈帕拉]";
		mes "我没工作，所以我要再吃一次。";
		npctalk "我要自己把这些吃完。", "Daldal#dorcon01", bc_self;
		next;
		mes "[莱加拉斯]";
		mes "冒险者，我想请你帮个忙。我的交货配额还没完成，但那两个家伙吃光了所有卡卢尼亚克！这就是我今天得到的全部，照这样下去我无法完成订单。";
		next;
		mes "[莱加拉斯]";
		mes "请再把他们带走一会儿，哪怕只有一小段时间！";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "我正好要给卡卢送消息，所以会把他们两个带走。";
		npctalk "去哪儿？", "Gopara#dorcon01", bc_self;
		npctalk "我吃完这些才走。", "Daldal#dorcon01", bc_self;
		next;
		mes "[莱加拉斯]";
		mes "求你了！";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "伙计们，我们去^0000cd酒吧烤炉^000000怎么样？";
		next;
		mes "[戈帕拉]";
		mes "好吧，只要不无聊，去哪儿都行。";
		next;
		mes "[达尔达尔]";
		mes "那里有很多好吃的吗？如果有，我就去。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "那就走吧。";
		erasequest 14572;// Helpless...
		setquest 14573;// I need the time on my own
		lasagna_quest[2] = 7;
		close;
	}
	if (lasagna_quest[2] >= 7) {
		mes "[莱加拉斯]";
		mes "谢谢你照看这些猪。多亏你，我的工作轻松多了！";
		close;
	}
}

lasagna,246,103,5	script	Gopara#dorcon01	4_GALAPAGO,3,3,{
	if (lasagna_quest[2] == 2) {
		mes "[" + strcharinfo(0) + "]";
		mes "伙计们，我有件事想和你们分享。";
		next;
		mes "[达尔达尔]";
		mes "我已经吃腻了。但没有别的东西可吃。";
		next;
		mes "[戈帕拉]";
		mes "我们什么时候是因为想吃才吃的？明明只是因为眼前有东西。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "伙计们？";
		next;
		mes "[达尔达尔]";
		mes "什么事？你带吃的了吗？";
		npctalk "什么事？你带吃的了吗？", "Daldal#dorcon01", bc_self;
		next;
		mes "[戈帕拉]";
		mes "你要和我们玩吗？";
		npctalk "你要和我们玩吗？", "", bc_self;
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "听说你们吃光了莱加拉斯清理的所有卡卢尼亚克。现在用这些卡卢尼亚克制作的卡卢纳快没了。请稍微克制一点，好吗？";
		next;
		mes "[达尔达尔]";
		mes "我们为什么要克制？";
		npctalk "对。", "", bc_self;
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "没有卡卢纳就无法制作卡卢纳牛奶。原本要从莱加拉斯那里收货的人现在正陷入困境。";
		next;
		mes "[戈帕拉]";
		mes "那和我们有什么关系？";
		npctalk "没错。", "", bc_self;
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "卡卢确实需要卡卢纳。没有卡卢纳，他就无法继续经营。";
		next;
		mes "[达尔达尔]";
		mes "那和我没关系。";
		npctalk "我不知道他是谁。", "", bc_self;
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "这和莱加拉斯关系很大。你们知道莱加拉斯会把卡卢尼亚克发酵成卡卢纳供应给卡卢，对吧？";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "如果他不能按时完成配额，就会被别人取代。";
		next;
		mes "[戈帕拉]";
		mes "那和我们有什么关系？";
		npctalk "我只想填饱肚子。", "Daldal#dorcon01", bc_self;
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "如果莱加拉斯丢了工作，就赚不到钱。如果他赚不到钱，你们不也会陷入困境吗？";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "据我所知，莱加拉斯给你们食物、衣服和住处。";
		next;
		mes "[达尔达尔]";
		mes "我们不穿衣服。";
		next;
		mes "[戈帕拉]";
		mes "那莱加拉斯可以去找别的工作。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "如果你们现在毁掉他的工作，凭什么认为莱加拉斯以后不会做些什么？他很可能会丢下你们两个，去寻找其他机会。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "那你们两个无法养活自己，只能在肮脏的后巷流浪，最后饿死。";
		next;
		mes "[达尔达尔]";
		mes "不、不可能！";
		next;
		mes "[戈帕拉]";
		mes "这、这太夸张了！";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "所以你们现在不该碍事，对吧？还要继续吃卡卢尼亚克吗？";
		next;
		mes "[达尔达尔]";
		mes "不！不吃了！";
		npctalk "不！再也不吃了！", "Daldal#dorcon01", bc_self;
		next;
		mes "[戈帕拉]";
		mes "不吃卡卢尼亚克还不够。我从没想过莱加拉斯可能离开我们。我们必须做点什么。";
		npctalk "我们也得做点什么。", "", bc_self;
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "态度很好！现在莱加拉斯会……";
		next;
		mes "[戈帕拉]";
		mes "现在，教我们。";
		next;
		mes "[达尔达尔]";
		mes "对！^0000cd教我们工作^000000之类的。";
		next;
		mes "[戈帕拉]";
		mes "既然是你提起这件事，就该负责我们。这就是莱加拉斯一直照顾我们的方式。";
		next;
		mes "[达尔达尔]";
		mes "莱加拉斯去哪儿，我就去哪儿。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "多拉姆之间有一种叫多拉姆垃圾的东西。可惜你们不是多拉姆，不能使用它。就这样。好吧。";
		npctalk "多拉姆垃圾？什么？你怎么能这么说？！", "", bc_self;
		npctalk "那是什么意思？", "Daldal#dorcon01", bc_self;
		npctalk "你还是不知道为好。", "", bc_self;
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "是我提起了这件事。为了可怜的莱加拉斯，我会帮你们找工作。";
		next;
		mes "[戈帕拉]";
		mes "你应该教我们。";
		next;
		mes "[达尔达尔]";
		mes "你应该雇佣我们。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "我没什么能教你们的。但正如我说的，我会找个你们能学习的地方。";
		next;
		mes "[戈帕拉]";
		mes "那就找点简单的。我觉得^0000cd照顾婴儿^000000就不错。";
		npctalk "简单。", "", bc_self;
		next;
		mes "[达尔达尔]";
		mes "对，我喜欢婴儿。又小又可爱。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "好吧。我去看看附近有没有婴儿。酒吧上方似乎有^0000cd游乐场^000000，去那里看看。";
		erasequest 14568;// Time to persuade
		setquest 14569;// Babysitter
		lasagna_quest[2] = 3;
		close;
	}
	if (lasagna_quest[2] == 6) {
		mes "[戈帕拉]";
		mes "对，这里最好了。虽然味道不好，但喝卡卢纳似乎就是我的命运。";
		close;
	}
	if (lasagna_quest[2] == 7) {
		mes "[戈帕拉]";
		mes "我说过要去见卡卢。反正我也很无聊，一切都好。走吧，你带路。";
		close;
	}
	mes "[戈帕拉]";
	mes "我现在喝卡卢纳，不是因为它好喝，只是因为它就在这里。";
	close;
OnTouch:
	if (lasagna_quest[2] == 3) {
		classchange( HIDDEN_WARP_NPC, "Daldal#dorcon01", bc_self );
		classchange( HIDDEN_WARP_NPC, "Gopara#dorcon01", bc_self );
	}
	end;
}


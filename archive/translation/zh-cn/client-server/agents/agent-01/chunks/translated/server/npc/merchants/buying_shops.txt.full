// Black Marketeer (Buy Licenses - Non-Merchant Classes) :: qskill_buy_store
//============================================================ 
que_job01,68,84,1	script	Black Marketeer#Buying	881,{
	if (checkweight(1201,1) == 0 || MaxWeight - Weight < 2400) {
		mes "[贾斯先生]";
		mes "你太贪心了，就连我也自愧不如！";
		mes "先去清理一下背包吧？";
		close;
	}
	if (getskilllv("ALL_BUYING_STORE") == 1) {
		mes "[贾斯先生]";
		mes "嘿，你已经和休签过合同了。";
		mes "我和你没什么业务。";
		close;
	}
	mes "[贾斯先生]";
	mes "你一定急需某样东西才来找我。";
	mes "你想要什么？";
	next;
	switch(select("批量收购商店许可证:你是谁？:没什么，没什么！")) {
	case 1:
		mes "[贾斯先生]";
		mes "我就知道！";
		mes "当然，我可以帮你制作。";
		mes "我的许可证和商人从那个混蛋休那里得到的正品一模一样！";
		next;
		mes "[贾斯先生]";
		mes "而且我的许可证更好，因为不需要学习任何技能。";
		mes "你想要多少？";
		next;
		mes "[贾斯先生]";
		mes "不过我一次只能少量制作，最多 10 个。";
		mes "每个要 500 Zeny。";
		next;
		while(1) {
			input .@input;
			mes "[贾斯先生]";
			if (.@input == 0) {
				mes "你不需要那些许可证吗？";
				close;
			} else if (.@input > 10) {
				mes "我一次最多只能制作 10 个。";
				next;
			} else {
				mes "费用为 "+(.@input*500)+" Zeny。";
				if (Zeny < (.@input*500)) {
					mes "但你的钱不够。";
					next;
					mes "[贾斯先生]";
					mes "你不懂基本商业规则吗？一切都有价格。";
					mes "想要东西就得付钱。";
				} else {
					mes "哈……哈哈哈！";
					mes "休先生，我会接管你的许可证生意。等着瞧！";
					mes "*咯咯笑*";
					getitem 12548,.@input; //Buy_Market_Permit2
					set Zeny,Zeny-(.@input*500);
				}
				close;
			}
		}
	case 2:
		mes "[贾斯先生]";
		mes "我很久以前离开了故乡。";
		mes "问我是谁没有意义，因为我只剩下仇恨。";
		next;
		mes "[贾斯先生]";
		mes "...";
		mes "休是个没有商业道德的腐败商人。";
		mes "我活着的唯一目的就是毁掉休。";
		next;
		mes "[贾斯先生]";
		mes "啊，我喝太多了……（*嗝*）";
		mes "那只是酒后胡话。";
		mes "请忘掉我说的一切。";
		close;
	case 3:
		mes "[贾斯先生]";
		mes "好吧，好吧！不用喊。";
		mes "没事就别来烦我。";
		close;
	}
}

// Purchasing Team (Learn Skill - Merchant Classes)
//============================================================ 
alberta_in,58,52,4	script	Purchasing Team#Buying	59,{
	if (checkweight(1201,1) == 0 || MaxWeight - Weight < 2400) {
		mes "- 你携带的物品太多，无法交谈或进行任务。-";
		close;
	}
	mes "[休先生]";
	if (BaseClass == Job_Merchant && getskilllv("MC_VENDING") >= 1) {
		if (getskilllv("ALL_BUYING_STORE") == 1) {
			mes "我是收购团队的休。";
			mes "今天我能帮你什么？";
			next;
			if(select("购买批量收购商店许可证:退出") == 2) {
				mes "[休先生]";
				mes "需要批量收购商店许可证时随时来找我。";
				mes "欢迎再来~";
				close;
			}
			mes "[休先生]";
			mes "每张批量收购商店许可证 200 Zeny，一次最多购买 50 张。";
			mes "你需要多少张许可证？";
			next;
			while(1) {
				input .@input;
				mes "[休先生]";
				if (.@input == 0) {
					mes "你取消了交易。";
					mes "祝你今天愉快。";
					close;
				} else if (.@input > 50) {
					mes "请输入不超过 50 的数值。";
					next;
				} else {
					mes "购买 "+.@input+" 张许可证需支付 "+(.@input*200)+" Zeny。";
					if (Zeny < (.@input*200)) {
						mes "但你的钱似乎不够。";
					} else {
						mes "感谢惠顾。";
						getitem 6377,.@input; //Buy_Market_Permit
						set Zeny,Zeny-(.@input*200);
					}
					close;
				}
			}
		} else {
			mes "我是艾尔贝塔商人公会收购团队的休。";
			mes "你是……";
			next;
			mes "[休先生]";
			mes "你知道吗？我们公会发行了一种许可证，允许个人向他人购买商品。";
			next;
			select("我买东西从没遇到过问题……");
			mes "[休先生]";
			mes "你说得对，但想想看：";
			mes "批量购买是不是很麻烦？";
			mes "你得找到并联系每个拥有所需物品的人。很不方便，对吧？";
			next;
			mes "[休先生]";
			mes "批量购买对商人很重要，我根据十年采购经验向公会提出了创新方案。";
			next;
			mes "[休先生]";
			mes "‘让个人开设批量收购商店！’";
			mes "这就是方案标题。读下去你就明白了……";
			mes "这项方案会改善购物体验。";
			mes "商人们也能从中获益。";
			mes "这正是我努力的原因。";
			next;
			mes "[休先生]";
			mes "...";
			mes "……（休先生没完没了地讲着各种细节。）";
			next;
			select("好吧，你到底想说什么？");
			mes "[休先生]";
			mes "哦，对了。总之，你可以通过露天商店";
			mes "批量购买特定物品。";
			next;
			mes "[休先生]";
			mes "要开设批量收购商店，需要商人公会发行的许可证。";
			next;
			mes "[休先生]";
			mes "每次开店都需要它。";
			mes "我们预计这种新许可证会显著增加利润。";
			next;
			mes "[休先生]";
			mes "这就是我的方案重点！会长听说我们能赚大钱后非常高兴！";
			next;
			mes "["+strcharinfo(0)+"]";
			mes "请直接说重点！";
			next;
			mes "[休先生]";
			mes "别这么急，好吗？";
			mes "重点是，只要学会露天商店，我们就允许你开设批量收购商店。";
			next;
			mes "[休先生]";
			mes "当然，我们会收取一次性 10,000 Zeny 登记费。";
			mes "每次开店都需要 ^4A4AFF批量收购商店许可证^000000。";
			next;
			mes "[休先生]";
			mes "要现在登记吗？";
			mes "登记后，我会教你如何开设批量收购商店。";
			next;
			if(select("学习如何开设批量收购商店:取消") == 2) {
			mes "[休先生]";
				mes "哎呀，真令人失望！";
				mes "批量收购能在很多方面帮助你的生意，";
				mes "但决定权在你。";
				mes "我随时愿意为你咨询！";
				close;
			}
			mes "[休先生]";
			if (Zeny < 10000) {
				mes "登记费是 10,000 Zeny。";
				mes "请先准备好费用。";
				close;
			} else {
				mes "你做了个好决定。";
				mes "请交登记费，并在这里签名……";
				next;
				input .@name$;
				mes "[休先生]";
				mes .@name$+"……";
				mes "你的字迹不错。";
				mes "好了，你现在获准开设批量收购商店。";
				set Zeny,Zeny-10000;
				getitem 6377,5; //Buy_Stall_Permit
				skill "ALL_BUYING_STORE",1,SKILL_PERM_GRANT;
				next;
				mes "[休先生]";
				mes "目前只有普通物品^8C2121（装备、特定药水和手工物品除外）^000000可以批量购买，但用得好仍然很有帮助。";
				next;
				mes "[休先生]";
				mes "另外，背包里必须至少有一件想购买的物品，因为你要通过商店展示给别人。";
				next;
				mes "[休先生]";
				mes "技能现在应该已经登记在技能窗口。如果看不到，请缩小技能列表并检查三转标签。";
				next;
				mes "[休先生]";
				mes "这是给你试用的 5 张批量收购商店许可证。";
				mes "祝你购物愉快！";
				close;
			}
		}
	}
	mes "我是艾尔贝塔商人公会收购团队的休。";
	mes "我很想聊天，但现在太忙了。";
	next;
	mes "[休先生]";
	mes "我的时间都用来服务商人行业的客户。";
	close;
}

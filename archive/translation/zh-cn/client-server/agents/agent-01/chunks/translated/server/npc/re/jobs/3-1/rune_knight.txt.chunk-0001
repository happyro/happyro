//= 1.4 Fixed a few bugs. [Euphy]
//= 1.4a Moved Kafra to main file. [Euphy]
//= 1.5 Added GM management function. [Euphy]
//= 1.6 Added VIP features. [Euphy]
//============================================================

prt_in,162,24,3	script	Splendid-Looking Knight	470,2,2,{
	mes "[Rune Knight Manuel]";
	if (Class == Job_Rune_Knight || Class == Job_Rune_Knight_T || Class == Job_Baby_Rune_Knight) {
		mes "你现在已经是我们精英兄弟会的一员。我仍记得第一次见到你的时候。";
		next;
		mes "[Rune Knight Manuel]";
		mes "努力以荣誉之道挥剑而生……";
		next;
		mes "[Rune Knight Manuel]";
		mes "为我们的新未来干杯……";
		close;
	}
	if (job_rune_edq == 0) {
		mes "世上有许多道路可以选择。大多数人看得见自己的路，却没有真正走下去……";
		next;
		mes "[Rune Knight Manuel]";
		mes "总之，这里的酒很不错。要来一杯吗？";
		next;
		if(select("好，我们喝一杯。:我拒绝。") == 2) {
			mes "[Rune Knight Manuel]";
			mes "你确定吗？你还不了解这种酒真正的优雅……";
			close;
		}
		mes "[Rune Knight Manuel]";
		if (BaseJob == Job_Knight) {
		mes "你也走在剑之道上，对吧？那我们就能互相理解。和剑士同伴一起喝酒味道更好。";
			next;
			mes "[Rune Knight Manuel]";
		mes "这轮我请客。";
		mes "为友谊干杯~";
			next;
			mes "[Rune Knight Manuel]";
			if (BaseLevel > 98 && JobLevel > 49) {
				mes "在我看来，你似乎已经准备好踏上新的道路……";
				next;
				mes "[Rune Knight Manuel]";
				mes "走在剑之道上就是永恒的战斗。从现在开始，你可能会经历艰难的旅程……";
				next;
				mes "[Rune Knight Manuel]";
				mes "如果你想走上新道路，超越当前极限，我愿意帮助你。";
				next;
				mes "[Rune Knight Manuel]";
				mes "领悟和谐、突破剑之极限的真正剑士之道，就是符文骑士。";
				next;
				mes "[Rune Knight Manuel]";
				mes "要加入我们的兄弟会吗？你看起来完全有资格成为我们的一员。";
				next;
				mes "[Rune Knight Manuel]";
				mes "如果你感兴趣，我会凭推荐将你介绍给引导你走上符文骑士之道的大师们。";
				next;
				switch(select("我还没准备好。:我准备成为符文骑士。")) {
				case 1:
					mes "[Rune Knight Manuel]";
					mes "没错，每项挑战都需要准备。好，我等你。";
					next;
					mes "[Rune Knight Manuel]";
					mes "当然，只有当你百分之百确定要成为符文骑士时，我才会接受你。";
					close;
				case 2:
					if (VIP_SCRIPT) {
						callfunc "VIP_Third_Class";
						set job_rune_edq,1;
						setquest 3200;
						next;
					}
					mes "[Rune Knight Manuel]";
					mes "现在确定了吗？";
					mes "我会向同伴发出通知，告诉他们你愿意加入我们的队伍。";
					next;
					set job_rune_edq,1;
					setquest 3200;
					mes "[Rune Knight Manuel]";
					mes "你知道格拉斯海姆吗？那里有一名符文骑士在等你，他会带你到格拉斯海姆塔入口。";
					next;
					mes "[Rune Knight Manuel]";
					mes "我叫曼努埃尔，被称为光辉的符文骑士。告诉他你是由我推荐的符文骑士候选人，剩下的交给他。";
					next;
					mes "[Rune Knight Manuel]";
					mes "我会等待你成为真正符文骑士、成为我们同伴的那一天。";
					close;
				}
			}
		mes "如果你一直走在剑之道上，最终会感受到力量的极限。就像曾经的我……";
			next;
			mes "[Rune Knight Manuel]";
		mes "时机到来时，会有办法帮助你超越极限。在力量成长到那一天之前，我们至少还能一起喝酒。";
			next;
			mes "[Rune Knight Manuel]";
		mes "为你的力量能够承受符文骑士之力的那一天干杯！";
			close;
		}
		mes "我相信变化之风并不总是好事。";
		next;
		mes "[Rune Knight Manuel]";
		mes "就像这杯酒的味道。我希望这杯酒的味道永远留在这里。";
		close;
	} else if (job_rune_edq == 1) {
		mes "符文骑士正在格拉斯海姆等你。他会带你到格拉斯海姆塔入口。";
		next;
		mes "[Rune Knight Manuel]";
		mes "告诉他你是符文骑士候选人，剩下的交给他。";
		next;
		mes "[Rune Knight Manuel]";
		mes "我会等待你成为真正符文骑士、成为我们同伴的那一天。";
		close;
	}
	mes "你现在没有事情要做吗？";
	next;
	mes "[Rune Knight Manuel]";
	mes "没有？那就算了。";
	mes "你不喜欢酒精的香味吗？";
	close;
}

glast_01,44,363,3	script	Rune Leader Jungberg	468,2,2,{
	mes "[Rune Leader Jungberg]";
	if (Class == Job_Rune_Knight || Class == Job_Rune_Knight_T || Class == Job_Baby_Rune_Knight) {
		mes "哦，你一定是"+strcharinfo(0)+"。";
		mes "欢迎。";
		next;
		mes "[Rune Leader Jungberg]";
		mes "我们期待你帮助符文骑士将荣誉传播到全世界。";
		next;
		mes "[Rune Leader Jungberg]";
		mes "那么，我能帮你什么？";
		next;
		switch(select("我想去集合地点。:没事。")) {
		case 1:
			mes "[Rune Leader Jungberg]";
			mes "好。我现在就送你过去。回头见。";
			close2;
			warp "job3_rune01",80,65;
			end;
		case 2:
			close;
		}
	}
	if (BaseJob != Job_Knight) {
		mes "我是唯一在这诅咒之地格拉斯海姆守护剑士之道的骑士。";
		next;
		mes "[Rune Leader Jungberg]";
		mes "你不走剑之道，所以不会理解我们的精神。我自己能应付。走你自己的路吧。";
		close;
	}
	if (job_rune_edq < 2) {
		mes "你是这个地方的诅咒幽灵？还是无知的冒险者？";
		next;
		mes "[Rune Leader Jungberg]";
		mes "如果你是活着的人类，就仔细听我说。我不会在这里冒险和随便什么人交谈。";
		next;
		if (job_rune_edq == 0) {
			switch(select("你是谁？:你在这里做什么？:取消。")) {
			case 1:
				mes "[Rune Leader Jungberg]";
				mes "我是唯一在这诅咒之地格拉斯海姆守护剑士之道的骑士。";
				next;
				mes "[Rune Leader Jungberg]";
				mes "如果你也走剑士之道，等你发挥全部潜力时，我们的道路一定会再次交汇。";
				close;
			case 2:
				mes "[Rune Leader Jungberg]";
				mes "我是走在剑之道上的人。但我和你这样的卢恩·米德加尔特骑士并不完全相同。";
				next;
				mes "[Rune Leader Jungberg]";
				mes "我们不像其他沉迷排场的骑士，所以你可能还不了解我们。";
				next;
				mes "[Rune Leader Jungberg]";
				mes "我们是符文骑士。一个将真正的力量与肉体力量引向正义剑之道的团体。";
				next;
				mes "[Rune Leader Jungberg]";
				mes "半个世纪以来，我们一直秘密生活在格拉斯海姆深处，但现在是让世界了解我们使命的时候了。";
				next;
				mes "[Rune Leader Jungberg]";
				mes "如今许多指导者正在卢恩·米德加尔特各地寻找有天赋的剑士。他们在寻找愿意加入真正剑之道的人。";
				next;
				mes "[Rune Leader Jungberg]";
				mes "如果你想加入符文骑士，请从某位指导者那里取得推荐，再来找我。";
				close;
			case 3:
				close;
			}
		} else if (job_rune_edq == 1) {
			switch(select("我来成为符文骑士。:取消。")) {
			case 1:
				mes "[Rune Leader Jungberg]";
				mes "嗯……你就是曼努埃尔提到的符文骑士候选人吗？";
				next;
				mes "[Rune Leader Jungberg]";
				mes "你叫"+strcharinfo(0)+"，对吧？我能清楚看出你有资格成为我们的同伴。";
				next;
				mes "[Rune Leader Jungberg]";
				mes "很好。我不用再询问你加入兄弟会的资格了……1.S……现在给你第一项任务。";
				next;
				mes "[Rune Leader Jungberg]";
				mes "找到隐藏在格拉斯海姆内部的符文骑士集合地点。";
				next;
				mes "[Rune Leader Jungberg]";
				mes "格拉斯海姆骑士团内部有一处通往符文骑士秘密集合室的地方。自己找到它。";
				next;
				mes "[Rune Leader Jungberg]";
				mes "如果你能找到那里，会有人等着迎接你。开始吧。";
				next;
				mes "[Rune Leader Jungberg]";
				mes "当然，格拉斯海姆的幽灵可能会威胁你的生命……但对符文骑士候选人来说，克服风险不该太难。";
				set job_rune_edq,2;
				changequest 3200,3201;
				close;
			case 2:
				close;
			}
		}
	} else if (job_rune_edq == 2) {
		mes "第一项任务是找出隐藏在格拉斯海姆内部的符文骑士集合地点。";
		next;
		mes "[Rune Leader Jungberg]";
		mes "格拉斯海姆骑士团内部有一处通往符文骑士秘密集合地的地方。自己找到它。";
		next;
		mes "[Rune Leader Jungberg]";
		mes "如果你能找到那里，会有人等着迎接你。开始吧。";
		next;
		mes "[Rune Leader Jungberg]";
		mes "当然，格拉斯海姆的幽灵可能会威胁你的生命……但对符文骑士候选人来说，克服风险不该太难。";
		close;
	}
	mes "看来你还在参加测试。尽你所能，通过所有测试。";
	next;
	switch(select("我想去集合地点。:结束交谈。")) {
	case 1:
		mes "[Rune Leader Jungberg]";
		mes "好。我现在就送你过去，之后再检查你。";
		close2;
		warp "job3_rune01",80,65;
		end;
	case 2:
		close;
	}
}

gl_knt02,150,55,3	script	Rune Knight Staff	83,2,2,{
	mes "[Rune Knight Staff]";
	if (Class == Job_Rune_Knight || Class == Job_Rune_Knight_T || Class == Job_Baby_Rune_Knight) {
	mes "欢迎，"+strcharinfo(0)+"。你要去集合地点吗？";
		next;
		switch(select("是，带我过去。:我有其他事情。:取消。")) {
		case 1:
			mes "[Rune Knight Staff]";
			mes "好，进来吧。我来带路。";
			close2;
			warp "job3_rune01",80,65;
			end;
		case 2:
			mes "[Rune Knight Staff]";
			mes "哦，真的吗？那你继续工作吧。我也要继续任务。";
			close;
		case 3:
			close;
		}
	}
	if (BaseJob == Job_Knight) {
		if (job_rune_edq == 1) {
		mes "啊……这里是禁区，禁止你进入。请不要妨碍我们的工作。";
			next;
			mes "[Rune Knight Staff]";
		mes "不过……你似乎有潜力成为剑之道同行者的伙伴。";
			next;
			mes "[Rune Knight Staff]";
		mes "我们很快就会再次相遇。我相信我们还会见面的。";
			close;
		} else if (job_rune_edq > 1) {
		mes "你正确找到了这里。荣格伯格派我送你去集合地点。";
			next;
			mes "[Rune Knight Staff]";
		mes "进入集合地点后，和提格里斯队长交谈。他一直在等新成员出现。";
			next;
			mes "[Rune Knight Staff]";
		mes "好，请跟我来。";
			close2;
			warp "job3_rune01",80,65;
			end;
		}
	}
	mes "等等！这里是禁区。你随便逛逛我不介意，但别再打扰我。";
	close;
}

job3_rune01,80,60,3	script	Rune Knight Captain	470,2,2,{
	if (checkweight(1201,1) == 0 || MaxWeight - Weight < 1000) {
		mes "你带的东西太多，无法继续。减轻负重后再来。";
		close;
	}
	if (Class == Job_Rune_Knight || Class == Job_Rune_Knight_T || Class == Job_Baby_Rune_Knight) {
		mes "[提格里斯船长]";
		if (job_rune_edq == 23) {
			mes "哦，我明白了……请稍等。";
			next;
		mes "[提格里斯船长]";
			mes "我忘了确认你是否有资格领取转职庆祝礼物……";
			next;
		mes "[提格里斯船长]";
			mes "让我检查负责测试的指导者报告。";
			next;
		mes "[提格里斯船长]";
			if (job_rune_edq3 == 0) {
				mes "嗯……太完美了。你的记录非常优秀，十分罕见。";
				set .@item,2140; //Energy_Rune_Guard
			} else if (job_rune_edq3 > 2 && job_rune_edq3 < 6) {
				mes "嗯……很好。你的记录相当不错。";
				set .@item,2794; //Magic_Stone_Ring
			} else {
				mes "嗯，不错。虽然记录不算优秀，但你已经尽力了。";
				set .@item,15002; //Rune_Plate
			}
			next;
		mes "[提格里斯船长]";
			mes "给，拿着这个。这是我喜欢送给你这样的年轻人的礼物。";
			getitem .@item,1; //Energy_Rune_Guard
			set job_rune_edq,24;
			close;
		}
		mes "嘿，好久不见，"+strcharinfo(0)+"。我想你没有什么重要事情要谈，放松就好。";
		close;
	}
	if (BaseJob == Job_Knight) {
		if (job_rune_edq == 2) {
			mes "一名身穿华丽铠甲、眼中充满热情的男子站在我面前。";
			next;
			mes "他茫然地盯着我，过了一会儿开始说话。";
			next;
		mes "[提格里斯船长]";
			mes "嘿，你就是曼努埃尔推荐的符文骑士候选人吗？我是符文骑士的提格里斯队长，你叫什么？";
			next;
		mes "[提格里斯船长]";
			mes "哦，我以前听过，但忘记了。对了，你是"+strcharinfo(0)+"？衷心欢迎你来到这里。";
			next;
		mes "[提格里斯船长]";
			mes "让我看看。有多少候选人来过这个房间？嘿，露娜莉亚，这位是第几位候选人？";
			next;
			mes "[Rune Knight, Lunarea]";
			mes "……第 172 位。";
			next;
		mes "[提格里斯船长]";
			mes "她是这么说的，我的朋友。其实我不想再见到下一位，所以请你加油。";
			next;
		mes "[提格里斯船长]";
			mes "让我看看……曼努埃尔和荣格伯格应该已经完成基本确认，那我们马上开始测试。";
			next;
		mes "[提格里斯船长]";
			mes "露娜莉亚，进行第一项测试。";
			next;
			mes "[Rune Knight, Lunarea]";
			mes "...";
			next;
			mes "这位名叫露娜莉亚、肤色苍白的女符文骑士安静地点头，注视着我。";
			next;
		mes "[提格里斯船长]";
			mes "测试现在开始。首先，你会接受那位美丽冰冷女士的第一项测试，请尽力而为。";
			next;
		mes "[提格里斯船长]";
			mes "测试完成后和我谈谈。另外，你也要留意其他人的测试进度。";
			next;
			set job_rune_edq,3;
			changequest 3201,3202;
		mes "[提格里斯船长]";
			mes "那么，我会在这里等你。去参加测试吧。";
			close;
		} else if (job_rune_edq == 3) {
		mes "[提格里斯船长]";
			mes "现在测试开始。首先，你会接受那位美丽冰冷女士的第一项测试，请尽力而为。";
			next;
		mes "[提格里斯船长]";
			mes "测试完成后和我谈谈……另外，你也要留意其他人的测试进度。";
			next;
		mes "[提格里斯船长]";
			mes "那么，我会在这里等你。去参加测试吧。";
			close;
		} else if (job_rune_edq > 3 && job_rune_edq < 6) {
		mes "[提格里斯船长]";
			mes "嘿，你不是在测试吗？露娜莉亚，发生什么事了？测试结束了吗？";
			next;
			mes "[Rune Knight, Lunarea]";
			mes "......";
			next;
			mes "她一言不发地摇头，盯着我。她的眼神非常锐利。";
			next;
		mes "[提格里斯船长]";
			mes "好了，露娜莉亚。嘿，仔细听我说。露娜莉亚不善言辞又沉默，但你不能无视她。";
			next;
		mes "[提格里斯船长]";
			mes "就连我……不，任何惹恼她的人都无法应付。";
			next;
			mes "[Rune Knight, Lunarea]";
			mes "......";
			next;
		mes "[提格里斯船长]";
			mes "哇，别那样看我。好，你看到了吧？有志成为符文骑士的人，回去听露娜莉亚的安排参加测试。那对你有好处。";
			close;
		} else if (job_rune_edq == 6) {
		mes "[提格里斯船长]";
			mes "嗯，看来你通过了露娜莉亚的测试？我想基础测试不用再考了。";
			next;
		mes "[提格里斯船长]";
			mes "不可否认，我们符文骑士有一些不同，但不能忘记剑士的根源。";
			next;
		mes "[提格里斯船长]";
			mes "从现在起才是你想成为符文骑士的真正测试。准备好参加下一项测试。";
			next;
		mes "[提格里斯船长]";
			mes "雷诺娅，我知道你等了很久，但现在轮到你了。";
			next;
			mes "[Rune Knight, Renoa]";
			mes "确实等了很久，但我的测试和露娜莉亚的测试天差地别。希望你不会只是个四肢发达的笨蛋。";
			next;
		mes "[提格里斯船长]";
			mes "哈哈哈，听见了吗？这次不会容易。希望你能通过，我的朋友。";
			next;
		mes "[提格里斯船长]";
			mes "去图书室找那位火焰般的女士完成下一项测试，然后回来。";
			set job_rune_edq,7;
			changequest 3204,3205;
			close;
		} else if (job_rune_edq > 6 && job_rune_edq < 16) {
		mes "[提格里斯船长]";
			mes "现在才是符文骑士的真正测试。你必须准备好参加下一项测试。";
			next;
		mes "[提格里斯船长]";

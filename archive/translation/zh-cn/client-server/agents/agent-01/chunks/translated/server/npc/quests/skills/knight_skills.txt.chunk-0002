	mes "他们知道我太";
	mes "娇弱，承受不了";
	mes "这种剧烈活动吗？";
	next;
	mes "[加塔克]";
	mes "啊，如果我在战斗中倒下，";
	mes "我不会太惊讶，毕竟";
	mes "我是这里最弱的人之一。";
	mes "不过真发生时，";
	mes "我会忙着保持帅气。";
	close;
}


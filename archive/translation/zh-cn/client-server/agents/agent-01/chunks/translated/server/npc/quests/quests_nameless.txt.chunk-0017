			mes "好吧。";
			mes "先告诉我";
			mes "在哪里能找到";
			mes "Z 帮。";
			next;
			mes "[Z 帮线人]";
			mes "我……我真的";
			mes "不知道";
			mes "在哪里能找到他们。";

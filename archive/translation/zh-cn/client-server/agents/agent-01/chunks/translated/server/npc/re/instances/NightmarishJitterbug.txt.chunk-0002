// Room 2
1@jtb,123,45,4	script	Runane#02	4_F_RUNAIN,{
	if ('room != 2 || is_party_leader() == false) {
		cutin "lunain01",2;
		mes "[露安娜]";
		mes "拜托别再有意外了。";
		close3;
	}
	if (select( "Talk.", "Hurry." ) == 2 && isbegin_quest(13183) == 2) {
		mes "一边赶路一边努力回忆。";
		if ('room == 2 && is_party_leader() == true) {
			if ('additionnal_option) {
				disablenpc instance_npcname("Runane#02");
				disablenpc instance_npcname("Aigu#02");
			}
			donpcevent 'jitterbug_main$ + "::OnNextIs3";
		}
		end;
	}
	.@shaloshi$ = instance_npcname("???#02");
	.@aigu$ = instance_npcname("Aigu#02");

	cutin "lunain01",2;
	mes "[露安娜]";
	mes "嗯，我有种会有东西突然跳出来袭击我们的感觉。";
	npctalk "Runane: 嗯，我有种会有东西突然跳出来袭击我们的感觉。";
	next;
	if ('room == 2 && is_party_leader() == true)
		donpcevent 'jitterbug_main$ + "::OnNextIs3";
	cutin "shaloshi01",0;
	mes "[???]";
	mes "是什么？";
	npctalk "???: 是什么？", .@shaloshi$;
	next;
	enablenpc .@shaloshi$;
	cutin "lunain04",2;
	mes "[露安娜]";
	mes "*尖叫*";
	npctalk "Runane: *尖叫*";
	emotion ET_HUK;
	next;
	cutin "igu03",0;
	mes "[艾古]";
	mes "怪物——！……呃，只是个女人。";
	npctalk "Aigu: 怪物——！……呃，只是个女人。", .@aigu$;
	emotion ET_HUK, getnpcid(0,.@aigu$);
	next;
	cutin "lunain04",0;
	mes "[露安娜]";
	mes "有东西！有东西！";
	npctalk "Runane: 有东西！有东西！";
	next;
	cutin "igu01",0;
	mes "[艾古]";
	mes "冷静。只是个女人。";
	npctalk "Aigu: 冷静。只是个女人。", .@aigu$;
	next;
	cutin "shaloshi01",0;
	mes "[???]";
	mes "女人的声音……";
	npctalk "？？？：男人的声音……", .@shaloshi$;
	emotion ET_QUESTION, getnpcid(0,.@shaloshi$);
	next;
	cutin "igu01",0;
	mes "[艾古]";
	mes "你问我们是怎么进来的？";
	npctalk "Aigu: 你问我们是怎么进来的？", .@aigu$;
	next;
	cutin "shaloshi01",0;
	mes "[???]";
	mes "不知道。你是怎么进来的？";
	npctalk "???: 不知道。你是怎么进来的？", .@shaloshi$;
	next;
	cutin "lunain03",2;
	mes "[露安娜]";
	mes "我们迷路了，现在身处时空裂隙。怎么会这样？";
	npctalk "Runane: 我们迷路了，现在身处时空裂隙。怎么会这样？";
	next;
	cutin "igu04",0;
	mes "[艾古]";
	mes "如果不是某个人，我们本来不必来到这里。";
	npctalk "Aigu: 如果不是某个人，我们本来不必来到这里。", .@aigu$;
	emotion ET_PROFUSELY_SWAT, getnpcid(0,.@aigu$);
	next;
	cutin "shaloshi01",0;
	mes "[???]";
	mes "那个唱歌的人。";
	npctalk "???: 那个唱歌的人。", .@shaloshi$;
	next;
	cutin "lunain01",2;
	mes "[露安娜]";
	mes "你认识纽沃兹吗？我们把他带离这里。";
	npctalk "Runane: 你认识纽沃兹吗？我们把他带离这里。";
	next;
	cutin "igu03",0;
	mes "[艾古]";
	mes "好。牵我的手。";
	npctalk "Aigu: 好。牵我的手。", .@aigu$;
	next;
	cutin "shaloshi01",0;
	mes "[???]";
	mes "你的手……很温暖。";
	npctalk "？？？：你的手……好温暖。", .@shaloshi$;
	next;
	cutin "igu02",0;
	mes "[艾古]";
	mes "跳舞会长茧。嘿嘿。";
	npctalk "Aigu: 跳舞会长茧。嘿嘿。", .@aigu$;
	next;
	cutin "shaloshi01",0;
	mes "[???]";
	mes "跳舞……";
	npctalk "???: 跳舞……", .@shaloshi$;
	next;
	cutin "lunain01",2;
	mes "[露安娜]";
	mes "大家在哪里？他们去别的地方了吗？我们往那个方向走。";
	npctalk "Runane: 大家在哪里？他们去别的地方了吗？我们往那个方向走。";
	close2;
	cutin "",255;
	disablenpc instance_npcname("Runane#02");
	disablenpc .@aigu$;
	disablenpc .@shaloshi$;
	end;
}


// Room 3
1@jtb,198,31,5	script	Roter#03	4_M_ROTERT,{
	if ('room != 3 || is_party_leader() == false) {
		cutin "rote01",0;
		mes "[罗特尔]";
		mes "这些怪物真无聊。";
		close3;
	}
	if (select( "Talk.", "Hurry." ) == 2 && isbegin_quest(13183) == 2)
		mes "一边赶路一边努力回忆。";
	else {
		.@gelka$ = instance_npcname("Gelka#03");
		cutin "gelca01",2;
		mes "[格尔卡]";
		mes "我检测到前方有电磁波。至少是 E 级怪物。";
		npctalk "Gelka: 我检测到前方有电磁波。至少是 E 级怪物。", .@gelka$;
		next;
		emotion ET_SWEAT;
		cutin "rote01",0;
		mes "[罗特尔]";
		mes "嘿，你最近在读什么？";
		npctalk "Roter: 嘿，你最近在读什么？";
		next;
		cutin "gelca03",2;
		mes "[格尔卡]";
		mes "嘿，科幻小说。有一种机械工具可以……";
		npctalk "Gelka: 嘿，科幻小说。有一种机械工具可以……", .@gelka$;
		next;
		emotion ET_OHNO;
		cutin "rote01",0;
		mes "[罗特尔]";
		mes "别说了，准备练习你们的特殊技能。";
		npctalk "Roter: 别说了，准备练习你们的特殊技能。";
		next;
		cutin "gelca03",2;
		mes "[格尔卡]";
		mes "哦，这就像重现书中怪物肆虐的场景。";
		npctalk "Gelka: 哦，这就像重现书中怪物肆虐的场景。", .@gelka$;
		next;
		cutin "rote01",0;
		mes "[罗特尔]";
		mes "格尔卡，超特殊技能 8 号：狂野之舞！";
		npctalk "Roter: 格尔卡，超特殊技能 8 号：狂野之舞！";
		next;
		emotion ET_SURPRISE, getnpcid(0,.@gelka$);
		cutin "gelca01",2;
		mes "[格尔卡]";
		mes "!!";
		npctalk "Gelka: !!", .@gelka$;
		next;
		mes "[格尔卡]";
		mes "来了！";
		npctalk "Gelka: 来了！", .@gelka$;
		next;
		cutin "rote01",0;
		mes "[罗特尔]";
		mes "精巧闪光灯，双重光辉！";
		npctalk "Roter: 精巧闪光灯，双重光辉！";
		specialeffect EF_LEXAETERNA;
		specialeffect EF_POTION_BERSERK;
		specialeffect EF_SIGNUM;
		next;
		cutin "gelca01",2;
		mes "[格尔卡]";
		mes "毁灭十二天网！";
		npctalk "Gelka: 毁灭十二天网！";
		specialeffect EF_HITLINE,AREA, .@gelka$;
		specialeffect EF_BASH3D2,AREA, .@gelka$;
		specialeffect EF_GUMGANG,AREA, .@gelka$;
		next;
		emotion ET_SPARK;
		emotion ET_SPARK, getnpcid(0,.@gelka$);
		mes "[格尔卡/罗特尔]";
		mes "交叉！！！";
		npctalk "Roter: 交叉！！！";
		npctalk "Gelka: 交叉！！！", .@gelka$;
		specialeffect EF_GRANDCROSS;
		specialeffect EF_GRANDCROSS,AREA, .@gelka$;
		next;
		cutin "rote01",0;
		mes "[格尔卡/罗特尔]";
		mes "散射——千重闪光！";
		npctalk "Gelka: 散射——千重闪光！", .@gelka$;
		npctalk "Roter: 散射——千重闪光！";
		specialeffect EF_LEXAETERNA;
		specialeffect EF_LEXAETERNA,AREA, .@gelka$;
		sleep2 300;
		specialeffect EF_LORD;
		specialeffect EF_LORD,AREA, .@gelka$;
		specialeffect EF_LORD;
		specialeffect EF_LORD,AREA, .@gelka$;
		sleep2 300;
		specialeffect EF_SUI_EXPLOSION;
		specialeffect EF_SUI_EXPLOSION,AREA, .@gelka$;
		specialeffect EF_BEGINASURA;
		specialeffect EF_BEGINASURA,AREA, .@gelka$;
		next;
		cutin "gelca01",2;
		mes "[格尔卡]";
		mes "……呼。";
		npctalk "Gelka: ……呼。", .@gelka$;
		next;
		cutin "rote01",0;
		mes "[罗特尔]";
		mes "嗯，还不够好，格尔卡。别让公会事务分散你训练的注意力。";
		npctalk "Roter: 嗯，还不够好，格尔卡。别让公会事务分散你训练的注意力。";
		next;
		cutin "gelca03",2;
		mes "[格尔卡]";
		mes "是，师父！";
		npctalk "Gelka: 是，师父！", .@gelka$;
		next;
		cutin "rote01",0;
		mes "[罗特尔]";
		mes "其他人在哪里？这里绝不是普通的洞穴。";
		npctalk "Roter: 其他人在哪里？这里绝不是普通的洞穴。";
	}
	if ('room == 3 && is_party_leader() == true)
		donpcevent 'jitterbug_main$ + "::OnNextIs4";
	close3;
}


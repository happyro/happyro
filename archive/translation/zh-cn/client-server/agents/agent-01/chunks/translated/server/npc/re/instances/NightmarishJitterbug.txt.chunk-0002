	mes "同意。他又暴力又邋遢……";
	npctalk "Arang: 同意。他又暴力又邋遢……", .@arang$;
	next;
	cutin "rote01",0;
	mes "[罗特尔]";
	mes "哦，你们两个都闭嘴！";
	npctalk "Roter: 哦，你们两个都闭嘴！", .@roter$;
	next;
	cutin "nines03",0;
	mes "[纽沃兹]";
	mes "这让我想起罗特尔年轻的时候……";
	npctalk "Newoz: 这让我想起罗特尔年轻的时候……";
	next;
	cutin "gelca04",0;
	mes "[格尔卡]";
	mes "罗特？这是你的昵称吗，师父？你们是朋友吗？";
	npctalk "Gelka: 罗特？这是你的昵称吗，师父？你们是朋友吗？", .@gelka$;
	next;
	cutin "rote01",0;
	mes "[罗特尔]";
	mes "够了！我要走了！";
	npctalk "Roter: 够了！我要走了！", .@roter$;
	next;
	cutin "min02",0;
	mes "[明敏]";
	mes "那个裂缝，或者说入口，已经消失了。如果你真的想离开，就跟着艾古。";
	npctalk "Mingmin: 那个裂缝，或者说入口，已经消失了。如果你真的想离开，就跟着艾古。", .@mingmin$;
	next;
	cutin "rote01",0;
	mes "[罗特尔]";
	mes "别装作关心我！我能照顾好自己！";
	npctalk "Roter: 别装作关心我！我能照顾好自己！", .@roter$;
	next;
	cutin "gelca04",0;
	mes "[格尔卡]";
	mes "师父，跟我来！";
	npctalk "Gelka: 师父，跟我来！", .@gelka$;
	next;
	cutin "min02",0;
	mes "[明敏]";
	mes "哦，我们有新成员了？太好了，我正好有几种想尝尝的蘑菇……";
	npctalk "Mingmin: 哦，我们有新成员了？太好了，我正好有几种想尝尝的蘑菇……", .@mingmin$;
	next;
	disablenpc .@roter$;
	disablenpc .@gelka$;
	cutin "ragi02",2;
	mes "[拉吉]";
	mes "洛尔，我想我们也该走了。";
	npctalk "Lagi: 洛尔，我想我们也该走了。", .@lagi$;
	next;
	cutin "roel01",2;
	mes "[洛尔]";
	mes "走吧。";
	npctalk "Roel: 走吧。", .@roel$;
	next;
	cutin "nines01",0;
	mes "[纽沃兹]";
	mes "阿朗，走吧。冒险时间到了！";
	npctalk "Newoz: 阿朗，走吧。冒险时间到了！";
	next;
	disablenpc .@lagi$;
	disablenpc .@roel$;
	cutin "arang02",0;
	mes "[阿朗]";
	mes "好嘞！";
	npctalk "Arang: 好嘞！", .@arang$;
	next;
	cutin "min02",0;
	mes "[明敏]";
	mes "希望这里有很多值得研究的东西。";
	npctalk "Mingmin: 希望这里有很多值得研究的东西。", .@mingmin$;
	next;
	cutin "",255;
	disablenpc instance_npcname("Newoz#01");
	mes "[" + strcharinfo(0) + "]";
	mes "...";
	next;
	disablenpc .@arang$;
	disablenpc .@mingmin$;
	emotion ET_THINK, getnpcid(0,.@melody$);
	mes "[旋律·杰克]";
	mes "...";
	npctalk "Melody-Jack: ...", .@melody$;
	next;
	mes "[" + strcharinfo(0) + "]";
	mes "...";
	next;
	emotion ET_THINK, getnpcid(0,.@melody$);
	mes "[旋律·杰克]";
	mes "...";
	npctalk "Melody-Jack: ...", .@melody$;
	next;
	mes "[旋律·杰克]";
	mes "趁他们忘记我们之前快走。";
	npctalk "Melody-Jack: 趁他们忘记我们之前快走。", .@melody$;
	close3;
}


//===== rAthena Script ======================================= 
//= Nidhoggr's Nest
//===== By: ================================================== 
//= L0ne_W0lf, various sources
//===== Current Version: ===================================== 
//= 1.6
//===== Compatible With: ===================================== 
//= rAthena Project
//===== Description: ========================================= 
//= [Official Conversion]
//= Nidhoggr's Nest Instance
//===== Additional Comments: ================================= 
//= 1.0 First version.
//= 1.1 Minor dialog updates.
//= 1.2 No longer glitches when anyone but party leader talks to the first NPC.
//= 1.3 Added 'instance_check_party' command to the script for proper checking if
//=     the invoking party meets the requirements to join the Memorial Dungeon.
//= 1.4 Cleaning. [Euphy]
//= 1.5 Instance system rewrite. [Euphy]
//= 1.6 Added GM management NPCs. [Euphy]
//============================================================ 

nyd_dun02,100,201,3	script	Yggdrasil Gatekeeper	111,8,8,{
	if (ins_nyd == 0) {
		mes "一座巨大石门矗立在你面前。可怕巨龙的雕像展开威武的翅膀。";
		next;
		mes "石门底部附近，拉赫族女性被石化，看起来已成为大门的一部分。";
		next;
		switch(select("靠近仔细观察。:后退。")) {
		case 1:
			specialeffect2 EF_HOLYHIT;
			pushpc 3,3;
			if (ep13_1_edq == 14)
				set ep13_1_edq,15;
			mes "神秘力量阻止你靠得太近。门后似乎有强大的存在……";
			next;
			mes "门后也许隐藏着超乎想象的重大秘密。";
			next;
			mes "最好回营地通知其他人并寻求帮助。";
			if (ep13_1_edq != 15) {
				next;
				mes "你必须努力工作，获得远征营地其他人的信任。";
			}
			set ins_nyd,1;
			close;
		case 2:
			close;
		}
	} else if (ins_nyd == 1) {
		mes "神秘力量阻止你靠得太近。门后似乎有强大的存在……";
		next;
		mes "门后也许隐藏着超乎想象的重大秘密。";
		next;
		mes "最好回营地通知其他人并寻求帮助。";
		if (ep13_1_edq == 14 || ep13_1_edq == 15) {
			set ep13_1_edq,15;
			close;
		}
		next;
		mes "你必须努力工作，获得远征营地其他人的信任。";
		close;
	} else if (ins_nyd == 111 || ins_nyd == 112) {
		specialeffect2 EF_CHANGECOLD;
		mes "环绕身体的奇怪感觉消失了。";
		next;
		mes "触摸石门时，你听到威严的声音。";
		next;
		mes "[??????]";
		mes "无翼者……我们的约定之言……";
		next;
		switch(select("“守护者的咒语”！:后退一步。")) {
		case 1:
			mes "[??????]";
			mes "约定之言……守护者的咒语……他们存在的证明。";
			next;
			mes "[Yggdrasil Gatekeeper]";
			mes "以世界树族之名，我接受你成为守护者的仆人。";
			next;
			specialeffect2 EF_CHANGECOLD;
			set ins_nyd,200;
			mes "[Yggdrasil Gatekeeper]";
			mes "我允许你通过守护者之门。现在你被视为守护者尼德霍格的忠实仆人。";
			next;
			mes "声音消失，石门后的黑暗力量逐渐平息。";
			close;
		case 2:
			close;
		}
	} else if (ins_nyd == 131 || ins_nyd == 132 || ins_nyd > 199) {

		set .@party_id,getcharid(1);
		set .@md_name$,"Nidhoggur's Nest";

		set .@ins_nyd_check,checkquest(3135,PLAYTIME); // 3 Day cooldown
		set .@ins_nyd_check2,checkquest(3136,PLAYTIME); // 4 Hour play limit

		mes "当我把手放在石门上时，心底响起了声音。";
		next;
		if (.@ins_nyd_check == -1 && .@ins_nyd_check2 == -1) {
			if (!instance_check_party(.@party_id,2,70)) {
				mes "[Yggdrasil Gatekeeper]";
				mes "其他仆人在哪里？你们要共同合作。单独的仆人不能获准进入……";
				next;
				mes "[Yggdrasil Gatekeeper]";
				mes "至少再带 1 名仆人来……只有队长能接受进入尼德霍格巢穴的许可。";
				next;
				mes "[Yggdrasil Gatekeeper]";
				mes "你们只需派 1 名代表和我交谈，别来烦我……";
				close;
			}
			if (is_party_leader(.@party_id) == true) {
				mes "[Yggdrasil Gatekeeper]";
				mes "守护者的忠实仆人……我能为你做什么？";
				next;
				switch(select("请允许我进入。:我想进去。:我想离开。")) {
				case 1:
					if (instance_create(.@md_name$) < 0) {
						mes "[Yggdrasil Gatekeeper]";
						mes "守护者似乎想独处。我进去查看，请在外面等候。";
						close;
					}
					mes "[Yggdrasil Gatekeeper]";
					mes "我已记录你的请求，准备好进去了吗？";
					next;
					mes "[Yggdrasil Gatekeeper]";
					mes "准备好后，我会允许你进入。";
					close;
				case 2:
					goto L_Enter;
				case 3:
					close;
				}
			}
			mes "[Yggdrasil Gatekeeper]";
			mes "如果副本已经创建，就可以进入。";
			next;
			if(select("我想进去。:我想离开。") == 2)
				close;
			goto L_Enter;
		} else {
			if (.@ins_nyd_check == 0 || .@ins_nyd_check == 1) {
				if (ins_nyd2 == 3 || ins_nyd2 == 4) {
					mes "[Yggdrasil Gatekeeper]";
					mes "尼德霍格之影被击败后，世界树的根系也受到影响。";
					next;
					mes "[Yggdrasil Gatekeeper]";
					mes "尼德霍格之影消失后，至少需要 3 天才能稳定。";
					close;
				}
				mes "[Yggdrasil Gatekeeper]";
				mes "如果副本已经创建，就可以进入。";
				next;
				if(select("我想进去。:我想离开。") == 2)
					close;
				goto L_Enter;
			} else if (.@ins_nyd_check == 2) {
				if (.@ins_nyd_check2 == 0 || .@ins_nyd_check2 == 1) {
					mes "[Yggdrasil Gatekeeper]";
					mes "进入副本的时限已过。必须等待世界树力量稳定后才能再次进入。";
					close;
				} else if (.@ins_nyd_check2 == 2) {
					mes "[Yggdrasil Gatekeeper]";
					mes "世界树已经稳定。想再次进入尼德霍格巢穴吗？";
					next;
					mes "[Yggdrasil Gatekeeper]";
					mes "想再次进入，请向我登记。";
					erasequest 3135;
					erasequest 3136;
					set ins_nyd2,0;
					close;
				}
			}
		}
		close;
	} else {
		mes "一座巨大石门矗立在你面前。可怕巨龙的雕像展开威武的翅膀。";
		next;
		mes "石门底部附近，拉赫族女性被石化，看起来已成为大门的一部分。";
		next;
		switch(select("靠近仔细观察。:后退。")) {
		case 1:
			specialeffect2 EF_HOLYHIT;
			pushpc 3,3;
			mes "神秘力量阻止你靠得太近。门后似乎有强大的存在……";
			next;
			mes "门后也许隐藏着超乎想象的重大秘密。";
			close;
		case 2:
			close;
		}
	}
	close;

L_Enter:
	switch(instance_enter("Nidhoggur's Nest")) {
	case IE_OTHER:
		mes "[Yggdrasil Gatekeeper]";
		mes "发生未知错误。";
		close;
	case IE_NOINSTANCE:
		mes "[Yggdrasil Gatekeeper]";
		mes "你没有申请许可……进入前应先取得许可。";
		close;
	case IE_NOMEMBER:
		mes "[Yggdrasil Gatekeeper]";
		mes "其他仆人在哪里？你们要共同合作。单独的仆人不能获准进入……";
		close;
	case IE_OK:
		mapannounce "nyd_dun02", getpartyname(getcharid(1))+"的队伍成员"+strcharinfo(0)+"已进入尼德霍格巢穴。",bc_map,"0x00ff99";
		if (checkquest(3135) == -1) setquest 3135;
		if (checkquest(3136) == -1) setquest 3136;
		//warp "1@nyd",32,36;
		close;
	}

OnTouch_:
	if (ins_nyd == 0) {
		specialeffect2 EF_CHANGECOLD;
		specialeffect EF_CHANGECOLD;
	}
	end;
}

mid_camp,271,299,3	script	Historian Magnifier#edq	755,3,3,{
	mes "[Historian Magniffer]";
	if (ins_nyd == 1) {
		mes "当然，大陆也有许多有趣的冒险……你好，我是普隆德拉王室派遣的历史学家 Magnifier。";
		next;
		mes "[Historian Magniffer]";
		mes "其他工作也许同样有价值，但只有历史学家能了解整个世界……";
		next;
		mes "[Historian Magniffer]";
		mes "这个世界如何组织……以及未来的道路！研究过去和现在，就能预测即将发生的事。";
		next;
		mes "[Historian Magniffer]";
		mes "我们对你寄予厚望，资深冒险者。如果发现什么……请告诉我。";
		close;
	} else if (ins_nyd == 2) {
		mes "Agip 指挥官想和我谈谈吗？听听他的故事吧。";
		next;
		mes "[Historian Magniffer]";
		mes "你找到了妖精部族视为圣地的洞穴？你真厉害。发现了什么？";
		next;
		mes "[Historian Magnifier]";
		mes "...";
		next;
		mes "... ...";
		next;
		mes "[Historian Magnifier]";
		mes "等一下……我有个绝妙主意。";
		next;
		mes "[Historian Magnifier]";
		mes "让我看看……这本书……不……这本？嗯……也许是这个……";
		next;
		mes "[Historian Magnifier]";
		mes "...";
		next;
		mes "[Historian Magnifier]";
		mes "... ...";
		next;
		mes "[Historian Magnifier]";
		mes "哦，找到了！世界树和神之部族……就是这本书！";
		next;
		mes "[Historian Magnifier]";
		mes "也许你找到了进入世界树核心的路线！";
		next;
		mes "[Historian Magnifier]";
		mes "如果是真的，这就是掌握魔力以来最伟大的发现。令人兴奋吧？";
		next;
		mes "[Historian Magnifier]";
		mes "但我们需要更多信息……他们拒绝让你进入吗？";
		next;
		mes "[Historian Magnifier]";
		mes "我会给普隆德拉图书馆的助手发消息。请帮她寻找更多信息。";
		next;
		mes "[Historian Magnifier]";
		mes "我一定会帮你找到直接进入世界树的方法，相信我！好吗~！！";
		set ins_nyd,3;
		close;
	} else if (ins_nyd == 3) {
		mes "你为什么还站着？去找普隆德拉图书馆的助手！";
		close;
	} else if (ins_nyd == 4) {
		mes "你回来了……很好，Naomi 怎么样？其实不用担心她，她总是很开朗。哈哈。";
		next;
		mes "[Historian Magnifier]";
		mes "你似乎有很多心事……脸上满是好奇和疑问。";
		next;
		mes "[Historian Magnifier]";
		mes "那么，你读完我准备的全部故事了吗？";
		next;
		switch(select("还没有。:我读完了所有故事。")) {
		case 1:
			mes "[Historian Magnifier]";
			mes "唉~我精心为你准备这些故事，你却什么也没看，对吧？";
			next;
			mes "[Historian Magnifier]";
			mes "读完后再回来比较好。那是我们未来行动的基础资料。";
			close;
		case 2:
			mes "[Historian Magnifier]";
			mes "嗯，干得好。也许不用再检查其他东西了，对吧？";
			next;
			mes "[Historian Magnifier]";
			mes "我派你去调查后续工作所需的基础材料。你应该带回研究报告……";
			next;
			mes "[Historian Magnifier]";
			mes "你也许会抱怨我为什么不亲自带来……那是因为我相信你的能力，别把一切视为理所当然。";
			next;
			mes "[Historian Magnifier]";
			mes "但不久前，你把 Agip 指挥官的报告送往大陆时弄丢了……还记得吗？";
			next;
			mes "[Historian Magnifier]";
			mes "到目前为止还没发现什么……有人袭击你了吗？";
			next;
			mes "[Historian Magnifier]";
			mes "真相总会大白，但如果未经通知就前往，当地人没有准备，可能会受到惊吓，我们必须小心。";
			next;
			mes "[Historian Magnifier]";
			mes "我说得太多了……总之，正如报告所示，你发现了很重要的东西！";
			next;
			mes "[Historian Magnifier]";
			mes "首先要进一步了解那里。我想可以做到，但……没有别人的帮助，我们做不了多少。";
			next;
			mes "[Historian Magnifier]";
			mes "听说最近有冒险者远征队尝试联系部族……你听说过吗？";
			next;
			mes "[Historian Magnifier]";
			mes "总之，先尝试联系他们，弄清洞穴或宝藏的情况。";
			next;
			mes "[Historian Magnifier]";
			mes "现在请联系萨法和拉赫部族，设法从他们那里获取信息。";
			next;
			mes "[Historian Magnifier]";
			mes "我也会继续在这里调查。发现什么就回来告诉我。";
			set ins_nyd,5;
			close;
		}
	} else if ((ins_nyd == 5) || (ins_nyd == 51) || (ins_nyd == 52)) {
		mes "好，先尝试联系他们，弄清洞穴或宝藏的情况。";
		next;
		mes "[Historian Magnifier]";
		mes "现在请联系萨法和拉赫部族，设法获取更多信息。";
		next;
		mes "[Historian Magnifier]";
		mes "我也会继续在这里调查。发现什么就回来告诉我。";
		close;
	} else if ((ins_nyd == 61) || (ins_nyd == 62)) {
		mes "啊，你来得正好。我查阅阿鲁纳佩尔兹报告时发现了有趣的事。";
		next;
		mes "[Historian Magnifier]";
		mes "我们现在正站在世界树一条根系的一部分上。";
		next;
		mes "[Historian Magnifier]";
		mes "这里通过根系与世界树相连。我想萨法和拉赫最终会在这里发生冲突，你不觉得吗？";
		next;
		mes "[Historian Magnifier]";
		mes "正如我所料，洞穴是通往世界树一条根系的入口……";
		next;
		mes "[Historian Magnifier]";
		mes "你找到关于萨法和拉赫的消息了吗？";
		next;
		mes "...";
		next;
		mes "... ...";
		next;
		mes "[Historian Magnifier]";
		mes "双方的行动都很暧昧，所以……我开始担心了……";
		next;
		mes "[Historian Magnifier]";
		mes "两个部族的高层之间似乎有些问题。虽然还不是正式冲突，但是……";
		next;
		mes "[Historian Magnifier]";
		mes "把目前情况报告给 Agip 指挥官，然后等待他的决定。";
		set ins_nyd,7;
		close;
	} else if ((ins_nyd == 7) || (ins_nyd == 8)) {
		mes "向 Hibba Agip 指挥官报告我们的发现，因为接下来的时间取决于他的决定。";
		close;
	} else if ((ins_nyd == 121) || (ins_nyd == 122) || (ins_nyd == 131) || (ins_nyd == 132) || (ins_nyd ==14)) {
		mes "原来如此……有些地方我们猜对了……那里叫守护者巢穴。";
		next;
		mes "[Historian Magnifier]";
		mes "今天我们获得了大量知识，但是……";
		next;
		mes "[Historian Magnifier]";
		mes "我们查明的事情……会怎样影响人类？太难预测了……";
		next;
		mes "[Historian Magnifier]";
		mes "这只是开始……从现在起我们会很忙。";
		next;
		mes "[Historian Magnifier]";
		mes "先向 Agip 指挥官报告，再根据情况行动。让我整理研究成果……";
		close;
	} else {
		mes "当然，大陆也有许多有趣的冒险……你好，我是普隆德拉王室派遣的历史学家 Magnifier。";
		next;
		mes "[Historian Magnifier]";
		mes "其他工作也许同样有价值，但只有历史学家能了解整个世界……";
		next;
		mes "[Historian Magnifier]";
		mes "这个世界如何组织……以及未来的道路！研究过去和现在，就能预测即将发生的事。";
		next;
		mes "[Historian Magnifier]";
		mes "我们对你寄予厚望，资深冒险者。如果发现什么……请告诉我。";
		close;
	}
}

prt_in,171,94,3	script	Assistant Naomi#edq	893,3,3,{
	mes "[Assistant Naomi]";
	set .@name$,strcharinfo(0);
	if (ins_nyd == 3) {
		mes "博士从不回来，事情又这么多……我怎么做得完……";
		next;
		mes "[Assistant Naomi]";
		mes "嘿，你。请搬动这些书，放到 3 号书架 B 排。";
		next;
		mes "["+.@name$+"]";
		mes "啊……嗯……我……是……";
		next;
		mes "[Assistant Naomi]";
		mes "没看到我很忙吗？别犹豫，快做。";
		next;
		switch(select("装作很忙，后退一步。:只帮她这一次。")) {
		case 1:
			mes "[Assistant Naomi]";
			mes "天啊！在哪里？放哪儿了？呃！太难了！";
			close;
		case 2:
			mes "[Assistant Naomi]";
			mes "啊……搬完那些后，这些也放到 3 号书架 B 排。";
			next;
			mes "["+.@name$+"]";
			mes "啊……我……明白了……";
			next;
			mes "[Assistant Naomi]";
			mes "现在差不多完成了……你是谁？是 Magnifier 博士的新助手吗？";
			next;
			mes "["+.@name$+"]";
			mes "他让我来取一些报告。他什么也没说吗？";
			next;
			mes "[Assistant Naomi]";
			mes "嗯……我一年多没见过他了！他现在在做什么？";
			next;
			mes "["+.@name$+"]";
			mes "他说会给你发消息……你没收到吗？";
			next;
			mes "[Assistant Naomi]";
			mes "消息？……让我看看……没想到他会写消息……";
			next;
			mes "[Assistant Naomi]";
			mes "我去检查邮箱，等一下。无聊的话看看那些书。";
			next;
			mes "...";
			next;
			mes "... ...";
			next;
			mes "堆积的书和文件太多，这里很乱。Magnifier 博士似乎有大量报告。";
			next;
			mes "["+.@name$+"]";
				mes "《世界的诞生》、《奥丁神话的虚构》、《诸神之战及其后》、《部族之梦》。这里有各种各样的书……";
			next;
			mes "...";
			next;
			mes "[Assistant Naomi]";
			mes "哦，抱歉花了这么久。邮件太多，找东西花了些时间。";
			next;
			mes "[Assistant Naomi]";
			mes "他给我发了 20 多次邮件。我竟然不知道……";
			next;
			mes "[Assistant Naomi]";
			mes "啊，这是关于你的消息。他说要共享研究和报告信息。";
			next;
			mes "["+.@name$+"]";
			mes "博士的专业领域是什么？";
			next;
			mes "[Assistant Naomi]";
			mes "五年前起，他就对世界如何诞生感到好奇，于是开始寻找创造之神。";
			next;
			mes "[Assistant Naomi]";
			mes "他研究奥丁与诸神之间的战斗，以及诸神的起源和生命。";
			next;
			mes "["+.@name$+"]";
			mes "那么，他早就知道魔王梦罗克会复活吗？";
			next;
			mes "[Assistant Naomi]";
			mes "我不确定，但他认为终有一天会发生。只是爆发得比预想更早。";
			next;
			mes "["+.@name$+"]";
			mes "但卢恩-米德加尔特批准了这项研究吗？";
			next;
			mes "[Assistant Naomi]";
			mes "我们的学术并非宗教，他们也对世界历史充满好奇。";
			next;
			mes "[Assistant Naomi]";
			mes "奥丁与诸神的战斗、神之子及其目的……博士一生都在研究这些。";
			next;
			mes "["+.@name$+"]";
			mes "但那些报告还没公布，对吧？";

//===== rAthena Script =======================================
//= Blacksmith Job Quest
//===== By: ==================================================
//= EREMES THE CANIVALIZER(Aegis)
//= Translated by: yoshiki.
//= Converted by: Komurka.
//= Optimized and further edited by kobra_k88.
//= Further bugfixed and tested by Lupus
//===== Current Version: =====================================
//= 2.9
//===== Compatible With: =====================================
//= rAthena Project
//===== Description: =========================================
//= [Official Conversion]
//= Job Change quest for Blacksmith class.
//===== Additional Comments: =================================
//= Changed some npc names to the iRO names. Changed some variable
//= names and labels. Edited some text.[kobra_k88]
//= Removed "if (JobLevel > 48) goto higher". It was a left over line.
//= Thx to "Decker".[kobra_k88]
//= Fixed some typos, thanks to Riotblade [celest]
//= 1.3-1.5 Added Baby Class support [Lupus]
//= 1.6 Added a func which prevent advanced classes passing
//=     2nd Job Quests again. It also guides adv classes where
//=     to go. [Lupus]
//= 1.7 item quantity/ids typos fix
//= 1.8 Moved the Quest to Einbroch [Poki#3]
//= 2.0 Changed numbers to constants. [Vicious]
//= 2.1 Removed Duplicates [Silent]
//= 2.2 Merged Jfunc, changed job numbers to constants [Lupus]
//= 2.3 Rescripted to Aegis 10.3 standards. [L0ne_W0lf]
//= 2.4 Several bugfixes with the help of Barron-Monster. [L0ne_W0lf]
//= 2.4a Changed a BaseJob to baseclass. [L0ne_W0lf]
//= 2.4b Further bug fixes with teh hel of Barron-Monster. [L0ne_W0lf]
//= 2.4c More fixes courtosy of Micktu. [L0ne_W0lf]
//= 2.4d Fixed an incorrect answer in the quiz. (Trojal) [L0ne_W0lf]
//= 2.4e Touched up a few issues as pointed out by Ultramage. [L0ne_W0lf]
//= 2.5 Krongast is in Lighthalzen. (DarkValmir) [L0ne_W0lf]
//= 2.6 Fixed 4 bugs [Lupus]
//= 2.6a Typo fix [Yommy]
//= 2.7 Added Quest Log commands. [Kisuka]
//= 2.8 Removed the need for use of 'goto.' [L0ne_W0lf]
//= 2.9 Updated with some extra conditions. [Euphy]
//==============================================================

ein_in01,18,28,4	script	Guildsman#BLS	731,{
	if (Upper == 1) {
		mes "[奥尔蒂雷根]";
		mes "嘿嘿。我没时间闲聊，忙得很。许多商人都在努力成为铁匠。";
		next;
		mes "[奥尔蒂雷根]";
		mes "等等，我觉得以前见过你。";
		mes "嗯……";
		next;
		mes "[奥尔蒂雷根]";
		mes "你是打坏我的武器后逃跑的那个人？还是逼我为你锻造武器的那个人？我怎么想不起来？";
		next;
		mes "[奥尔蒂雷根]";
		mes "……";
		mes "我完全想不起你是谁。这是似曾相识吗？";
		next;
		mes "[奥尔蒂雷根]";
		mes "啊！！真让人烦恼！不过我能感觉到你很特别。算了，祝你今天愉快~";
		close;
	}
	mes "[奥尔蒂雷根]";
	mes "欢迎！";
	mes "我们是钢铁工匠，";
	mes "铁匠公会。";
	next;
	mes "[奥尔蒂雷根]";
	mes "我们将灵魂的热忱";
	mes "与激情倾注于";
	mes "我们的技艺是将金属熔铸成新武器";
	mes "和工具，确实是一种艺术！";
	if (BaseClass >= Job_Thief) close;	// Custom expanded class check.
	next;

	// Third class check - precedes other BaseClass dialogue.
	if (Class >= Job_Rune_Knight && Class <= Job_Baby_Mechanic2) {
		mes "[奥尔蒂雷根]";
		mes "你……看起来很陌生。但不知为何，你似乎与公会有关。哈哈~";
		mes "我说得对吗？";
		close;
	}

	if (BaseClass == Job_Novice) {
		mes "[奥尔蒂雷根]";
		if (Sex == SEX_FEMALE) {
			mes "哦~";
			mes "多么";
			mes "漂亮的女士！";
		}
		mes "你有兴趣";
		mes "成为铁匠吗？";
		next;
		mes "[奥尔蒂雷根]";
		mes "首先你必须先成为商人才能成为铁匠。去艾尔贝塔学习商人之道吧。";
		close;
	}
	else if (BaseClass == Job_Swordman) {
		mes "[奥尔蒂雷根]";
		mes "哦，你想锻造武器吗？很抱歉让你失望了，但我有很多事务要处理。";
		close;
	}
	else if (BaseClass == Job_Archer) {
		mes "[奥尔蒂雷根]";
		mes "哦……";
		mes "我们这里没什么能提供给你。除非你会制作东西，否则帮不上忙……";
		close;
	}
	else if (BaseClass == Job_Mage) {
		mes "[奥尔蒂雷根]";
		mes "哦？魔法师来这里做什么？真令人惊讶。通常这种粗活不适合你们知识分子。";
		close;
	}
	else if (BaseClass == Job_Acolyte) {
		mes "[奥尔蒂雷根]";
		mes "哦！你是神职人员吧？离开前能祝福我吗！";
		close;
	}
	else if (BaseClass == Job_Thief) {
		mes "[奥尔蒂雷根]";
		mes "抱歉……";
		mes "这里真的没什么可偷的。后面倒是有些短剑，不过……";
		close;
	}
	else if (BaseJob == Job_Alchemist) {
		mes "[奥尔蒂雷根]";
		mes "最近药店生意如何？";
		mes "我的锻造生意似乎也不再增长。";
		close;
	}
	else if (BaseJob == Job_Blacksmith) {
		mes "[奥尔蒂雷根]";
		mes "哦！好久不见。";
		mes "你来向克里斯托弗购买材料吗？最近我被困在这张桌子后，身体都渴望敲打老铁砧了。";
		close;
	}
	else if (BaseJob == Job_Merchant) {
		if (SkillPoint) {
			mes "[奥尔蒂雷根]";
			mes "使用完所有技能点后才能转职铁匠。请合理使用技能点后再回来。";
			close;
		}
		if (BSMITH_Q == 0) {
			mes "[奥尔蒂雷根]";
			mes "别再辛苦";
			mes "作为商人赚取 Zeny，";
			mes "加入精英铁匠职业？";
			mes "如果你有兴趣，请填写申请，写上名字";
			mes "和职业等级。";
			next;
			switch(select("填写申请。:有什么要求？:呃，我需要考虑一下。")) {
			case 1:
				if (SkillPoint) {
					mes "[奥尔蒂雷根]";
					mes "使用完所有技能点后才能转职铁匠。请合理使用技能点后再回来。";
					close;
				}
				else if (JobLevel > 39 && BSMITH_Q == 0) {
					mes "[奥尔蒂雷根]";
					mes "嗯……";
					mes "看来你";
					mes "符合职业等级";
					mes "要求。";
					next;
					mes "[奥尔蒂雷根]";
					mes "我们不会随便接纳任何人。首先，只接受真正想成为优秀铁匠的资深商人。让我看看……";
					next;
					mes "^3355FF*翻动文件*^000000";
					next;
					mes "[奥尔蒂雷根]";
					mes "嗯……";
					mes "我们在艾因贝赫的铁匠 ^8E6B23Geschupenschte^000000 发来消息说缺人手。你的第一项品格测试就是帮助他。";
					next;
					set BSMITH_Q,1;
					setquest 2000;
					mes "[奥尔蒂雷根]";
					mes "小心";
					mes "祝你好运！";
					close;
				}
				else if (JobLevel < 40) {
					mes "[奥尔蒂雷根]";
					mes "嗯，你的商人经验似乎不足。我们要求职业等级至少 40。";
					next;
					mes "[奥尔蒂雷根]";
					mes "你走了这么远我却拒绝你，真过意不去，但规矩就是规矩。抱歉让你失望，准备好后欢迎回来。";
					close;
				}
			case 2:
				mes "[奥尔蒂雷根]";
			mes "想知道要求？首先，商人职业等级至少 40。其次，必须通过铁匠公会的测试。";
				next;
				mes "[奥尔蒂雷根]";
				mes "测试可能包含困难任务，但绝非不可能。你需要把特定物品送到世界各地";
				mes "才能完成测试。";
				close;
			case 3:
				mes "[奥尔蒂雷根]";
				mes "嗯……";
				mes "那么，希望";
				mes "还能再见到你。";
				close;
			}
		}
		else if (BSMITH_Q > 0  && BSMITH_Q < 8) {
			mes "[奥尔蒂雷根]";
			mes "你还没离开？";
			mes "去艾因贝赫找到 ^8E6B23Geschupenschte^000000。帮助他完成工作后回来找我。";
			close;
		}
		else if (BSMITH_Q > 8 && BSMITH_Q < 15) {
			mes "[奥尔蒂雷根]";
			mes "你为 ^8E6B23Geschupenschte^000000 做的工作还满意吗？他可是出了名的严格……";
			close;
		}
		else if (BSMITH_Q == 15) {
			mes "[奥尔蒂雷根]";
			mes "干得好！！";
			mes "你通过了";
			mes "第一项测试……";
			next;
			mes "[奥尔蒂雷根]";
			mes "嗯？你看起来很惊讶。";
			mes "看来你不知道不止一项测试。";
			mes "哈哈，别担心，不用走那么远。";
			mes "请和建筑内的公会成员交谈，了解下一项测试详情。";
			next;
			if (select("我想快点转职！但是……算了。:啊！受够了！") == 1) {
				set BSMITH_Q,16;
				changequest 2013,2014;
				mes "[奥尔蒂雷根]";
				mes "抱歉，但你应该理解。我们不能随便接纳任何人进入";
				mes "公会！";
				next;
				mes "[奥尔蒂雷根]";
				mes "如果不保持标准，";
				mes "就无法维护铁匠公会的声誉！";
				mes "我们不能这样让公会蒙羞！*咳咳*总之，现在去和建筑内的公会成员交谈。";
				close;
			}
			mes "[奥尔蒂雷根]";
			mes "你是说你要";
			mes "放弃申请？这是对公会的侮辱！";
			mes "滚出去！凭这种态度，别想成为铁匠公会成员！";
			next;
			mes "[奥尔蒂雷根]";
			mes "你没有精神！";
			mes "无法忍受这些，你永远成不了铁匠！";
			close;
		}
		else if (BSMITH_Q == 16) {
			mes "[奥尔蒂雷根]";
			mes "嗯？你还没和公会成员谈过？";
			mes "如果没有，我建议你尽快去。";
			close;
		}
		else if (BSMITH_Q == 17 && countitem(1005) > 0 && JobLevel > 39) {
			mes "[Altiregen]";
			if (ismounting()) {
			mes "你正骑着坐骑，无法转职。";
			mes "请解除坐骑后重试！";
				close;
			}
			mes "太棒了，从你眼中的光彩就能看出你成功了。现在我可以将锻造这门铁匠艺术传授给你。";
			if (checkquest(2015) != -1) {
				changequest 2015,2016;
			}
			next;
			set .@joblvl,JobLevel;
			callfunc "Job_Change",Job_Blacksmith;
			callfunc "F_ClearJobVar";		// clears all job variables for the current player
			mes "[Altiregen]";
			mes "永远记住，我们是创造者，是金属艺术家。小心不要陷入自私和贪婪的陷阱。";
			next;
			delitem 1005,1; //Hammer_Of_Blacksmith
			completequest 2016;
			mes "[Altiregen]";
			mes "这份小礼物标志着你铁匠生涯的开始。恭喜！！！";
			if (.@joblvl > 48)
				getitem 999,30; //Steel
			else 
				getitem 999,5; //Steel
			close;
		}
	}
}

ein_in01,201,27,3	script	Guildsman#alberta	63,{
	mes "[Geschupenschte]";
	mes "你好！";
	mes "我是 ^8E6B23Geschupenschte^000000，";
	mes "职业是铁匠。";
	mes "很高兴见到你！";
	next;
	if (BaseJob == Job_Merchant) {
		mes "[Geschupenschte]";
		mes "哦呵呵！";
		mes "你是商人！";
		mes "太好了！我正";
		mes "需要一些帮助！";
		next;
		if (BSMITH_Q == 0) {
			mes "[Geschupenschte]";
			mes "当然，如果你很忙我不会打扰。需要的话就先走吧~";
			next;
			mes "[Geschupenschte]";
			mes "毕竟……我知道忙碌是什么感觉~";
			close;
		}
		else if ((BSMITH_Q == 1) || (BSMITH_Q == 2)) {
			if (BSMITH_Q == 1) {
				mes "[Geschupenschte]";
				mes "你就是铁匠公会派来的帮手吗？值得信赖、能雇来帮忙的人不多，所以我总是缺人手。";
				next;
				mes "[Geschupenschte]";
				mes "嗯，不管怎样，你就是派来的帮手，对吧？好，我有些工作必须马上处理！";
				next;
				mes "[Geschupenschte]";
				mes "前段时间有个毫无经验的孩子替我工作，结果买错了材料！真糟糕……";
				next;
				mes "[Geschupenschte]";
				mes "谁都不愿因这种愚蠢错误损失钱。不过，我有一项稍微困难的工作给你。";
				next;
				mes "[Geschupenschte]";
				mes "不过，我要确认你具备商人的基础知识。如果可以，我想问你几个问题。";
				next;
				set .@selection,select("是的。:呃，能给我一些准备时间吗？");
			}
			else if (BSMITH_Q == 2) {
				mes "[Geschupenschte]";
				mes "那么，这次你有多学习一些吗？";
				next;
				mes "[Geschupenschte]";
				mes "我承认要求第一次就满分不太合理，所以给你一点宽限……";
				next;
				mes "[Geschupenschte]";
				mes "你可以错一道题！好，开始答题~";
				next;
			}
			if (.@selection != 2) {
				if (rand(2)) {
					mes "[Geschupenschte]";
						mes "1. 以下哪个地区与其特色";
					mes "它的特色商品是什么？";
					next;
					if (select("梦罗克 - 盗贼服:艾尔贝塔 - 双手斧:海洞 - 狂暴药水:艾尔贝塔 - 剑锤") == 4)
						set .@black_q,.@black_q+10;
					mes "[Geschupenschte]";
						mes "2. ^8E6B23锤击^000000技能会造成哪种状态？";
					mes "会受到哪种状态";
					next;
					if (select("昏迷:失明:沉默:睡眠") == 1)
						set .@black_q,.@black_q+10;
					mes "[Geschupenschte]";
						mes "3. 以下哪项技能无法执行？";
					mes "的影响？";
					next;
					if (select("露天商店:折扣:高价买进:敏捷提升") == 4)
						set .@black_q,.@black_q+10;
					mes "[Geschupenschte]";
						mes "4. 你可以在哪里找到一家商店，";
					mes "出售蓝色宝石？";
					next;
					if (select("艾尔贝塔:梦罗克:吉芬:普隆德拉") == 3)
						set .@black_q,.@black_q+10;
					mes "[Geschupenschte]";
						mes "5. 吉芬的工具商";
					mes "位于吉芬的";
					mes "工具商？";
					next;
					if (select("城镇广场 8 点钟方向:城镇广场 11 点钟方向:城镇广场 6 点钟方向:城镇广场 5 点钟方向") == 1)
						set .@black_q,.@black_q+10;
					mes "[Geschupenschte]";
						mes "6. 商人不能使用哪种武器？";
					mes "商人不能使用";
					mes "什么？";
					next;
					if (select("短剑:环首剑:锁链:圣经") == 4)
						set .@black_q,.@black_q+10;
					mes "[Geschupenschte]";
						mes "7. 以下哪件装备";
					mes "拥有最高防御率？";
					next;
					if (select("内裤:貂皮大衣:木铠甲:丝质长袍") == 2)
						set .@black_q,.@black_q+10;
					mes "[Geschupenschte]";
						mes "8. 3 级武器的^8E6B23安全^000000精炼上限是多少？";
					next;
					if (select("最高 +3:最高 +4:最高 +5:最高 +6") == 3)
						set .@black_q,.@black_q+10;
						mes "9. 哪件物品可以使用";
					mes "可以使用 ^8E6B23树枝^000000 制作什么？";
					next;
					if (select("孙悟空帽:鬼头巾:山羊头盔:鹿角") == 1)
						set .@black_q,.@black_q+10;
					mes "[Geschupenschte]";
						mes "10. 成为商人最重要的一环是……？";
					mes "成为商人的重要一环是……？";
					next;
					select("信用:诚信:金钱:修辞");
					set .@black_q,.@black_q+10;
				}
				else {
					mes "[Geschupenschte]";
						mes "1. 以下城市中，哪个与其特色不匹配？";
					next;
					if (select("艾尔迪巴兰 - 世界树叶:艾尔贝塔 - 铁锤:海洞 - 狂暴药水:艾尔迪巴兰 - 铁锤") == 4)
						set .@black_q,.@black_q+10;
					mes "[Geschupenschte]";
						mes "2. 一个杰勒比结晶值多少 Zeny？";
					mes "一个杰勒比结晶值多少？";
					next;
					if (select("1 Zeny:2 Zeny:3 Zeny:4 Zeny") == 3)
						set .@black_q,.@black_q+10;
					mes "[Geschupenschte]";
						mes "3. 商人使用^8E6B23露天商店^000000技能需要什么？";
					mes "商人使用 ^8E6B23露天商店^000000 技能需要什么？";
					next;
					if (select("必须拥有手推车。:必须有待售物品。:必须装备武器。:必须穿戴护甲。") == 1)
						set .@black_q,.@black_q+10;
					mes "[Geschupenschte]";
						mes "4. 你可以在哪里";
					mes "转职成为商人？";
					next;
					if (select("艾尔贝塔:梦罗克:吉芬:普隆德拉") == 1)
						set .@black_q,.@black_q+10;
					mes "[Geschupenschte]";
						mes "5. 位于梦罗克的";
					mes "位于梦罗克的";
					mes "武器商？";
					next;
					if (select("城镇中心 7 点钟方向:城镇中心 11 点钟方向:城镇中心 6 点钟方向:城镇中心 5 点钟方向") == 4)
						set .@black_q,.@black_q+10;
					mes "[Geschupenschte]";
						mes "6. 商人不能使用哪种武器？";
					mes "商人不能使用";
					mes "什么？";
					next;
					if (select("马刀:双手剑:锁链:双手斧") == 2)
						set .@black_q,.@black_q+10;
					mes "[Geschupenschte]";
						mes "7. 以下哪件装备";
					mes "拥有最高防御率？";
					next;
					if (select("内裤:貂皮大衣:木铠甲:丝质长袍") == 2)
						set .@black_q,.@black_q+10;
					mes "[Geschupenschte]";
						mes "8. 3 级武器的安全精炼上限是多少？";
					next;
					if (select("最高 +3:最高 +4:最高 +5:最高 +6") == 3)
						set .@black_q,.@black_q+10;
					mes "[Geschupenschte]";
						mes "9. 哪种怪物不会掉落铁矿石？";
					mes "不会掉落铁矿石？";
					next;
					if (select("苍蝇:钢铁苍蝇:邪骸浪人:鳄鱼人") == 4)
						set .@black_q,.@black_q+10;
					mes "[Geschupenschte]";
						mes "10. 对商人来说最重要的是什么？";
					mes "对商人很重要？";
					next;
					select("修辞:信用:金钱:经验");
					set .@black_q,.@black_q+10;
				}
				mes "[Geschupenschte]";
				mes "嗯。你做得很好！";
				next;
				mes "[Geschupenschte]";
			mes "让我看看……你的分数是……" + .@black_q + " 分。";

rebel_in,90,51,5	script	Rachel Smith#16.2rm	4_F_GUNSLINGER2,{
	if (terra_gloria_main < 17) {
		mes "[Rachel Smith]";
		mes "我负责这里的维修。物资由那边负责。";
		next;
		mes "[Rachel Smith]";
		mes "枪械其实是消耗品。有人开枪，就必须有人维护。";
		close;
	}
	// twins daily quest
	if (isbegin_quest(16029) == 1) {
		mes "[Rachel Smith]";
		mes "饼干？你从哪里拿到的？啊……是列别捷夫家的孩子做的吗？";
		mes "好，谢谢你！";
		next;
		if (countitem(25161) < 1) {
			mes "[Rachel Smith]";
			mes "嗯？饼干在哪里？";
			close;
		}
		emotion ET_DELIGHT;
		mes "[Rachel Smith]";
		mes "闻起来不错……我之后去问他们配方。";
		completequest 16029;// Service: Cookies delivery
		delitem 25161,1;// Handmade_cookie2
		close;
	}

	if (rachel_quest_16_2 == 0) {
		mes "[Rachel Smith]";
		mes "又来了？如果你弄坏了武器却假装丢了，想都别想。";
		next;
		mes "[Rachel Smith]";
		mes "……哎？哦，抱歉。你是谁？";
		mes "今天有三个人弄坏武器后骗我说武器丢了。所以我以为你也会这么说。";
		next;
		mes "[Rachel Smith]";
		mes "啊，你是冒险者。";
		mes "这么说来，你一定是和 USU 的埃琳娜指挥官切磋过的冒险者。你真勇敢。";
		next;
		mes "[Rachel Smith]";
		mes "我是瑞秋·史密斯。我是铁匠，负责协助武器维修和保养。";
		mes "要不要把你的武器给我看看？通过观察各种武器，我可以研究它们。";
		next;
		mes "[Rachel Smith]";
		mes "嗯……这是一把不错的武器。你保养得很好。";
		mes "很有意思。虽然是同一种武器，但根据主人关注的方面不同，会呈现不同的特性。";
		next;
		mes "[Rachel Smith]";
		mes "……但我维修的武器却不会这样。我不知道为什么。";
		next;
		emotion ET_PROFUSELY_SWAT;
		mes "[Rachel Smith]";
		mes "哦，抱歉。我最近有些担心。我最近维修的武器缺陷率很高。";
		mes "因此前线的士兵很辛苦。";
		next;
		mes "[Rachel Smith]";
		mes "幸运的是，到目前为止没有发生坏事。但我还是很紧张。";
		mes "我每天晚上都会梦见武器在士兵手中爆炸……";
		next;
		mes "[Rachel Smith]";
		mes "虽然我还不是专家，但我想解决这些问题，不让师父或士兵担心。";
		next;
		mes "[Rachel Smith]";
		mes "嘿，冒险者。能帮我一个忙吗？";
		mes "能把我维修的武器拿给铁匠公会，请他们提供建议吗？";
		next;
		if (select( "答应。", "拒绝。" ) == 2) {
			mes "[Rachel Smith]";
			mes "哦……我明白了。";
			close;
		}
		mes "[Rachel Smith]";
		mes "谢谢你的帮助。我就靠你了。";
		next;
		mes "[Rachel Smith]";
		mes "如果我维修的武器伤害的是我们自己人，而不是敌人，那将是一场悲剧。我想防止这种事发生。";
		next;
		mes "[Rachel Smith]";
		mes "把这把左轮手枪带到艾因布洛克铁匠公会给他们看。因为我是公会成员，他们看到我维修的左轮手枪就能认出来。我就靠你了。";
		setquest 16035;// Delivery: Explosive revolver materials
		getitem 25151,1;	// Rachels_Revolver
		rachel_quest_16_2 = 1;
		close;
	}
	if (rachel_quest_16_2 == 1) {
		if (countitem(25151) < 1) {
			mes "[Rachel Smith]";
			mes "嗯……我的左轮手枪在哪里？";
			mes "太不负责任了。我再给你一把枪。别再这样了。";
			getitem 25151,1;// Rachels_Revolver
			close;
		}
		mes "[Rachel Smith]";
		mes "把我的枪带到艾因布洛克铁匠公会给他们看。我就靠你了。";
		close;
	}
	if (rachel_quest_16_2 == 2) {
		mes "[Rachel Smith]";
		mes "欢迎回来。他们怎么说？";
		next;
		mes "[Rachel Smith]";
		mes "所以……是材料的问题。嗯……";
		mes "事实上，我之前估算得有些偏差。";
		next;
		mes "[Rachel Smith]";
		mes "但我别无选择。由于预算不足，我无法获得更好的材料。";
		next;
		mes "[Rachel Smith]";
		mes "而且，我们的师父能用这些材料出色地维修武器。但我总是把它们弄坏……";
		next;
		mes "[Rachel Smith]";
		mes "所以我一直想自己改进。但听了你的话后，我改变主意了。";
		next;
		mes "[Rachel Smith]";
		mes "这不只是我个人的错误，也可能让每一名士兵陷入危险。所有人的安全比我的个人自尊更重要。";
		next;
		mes "[Rachel Smith]";
		mes "所以……冒险者，我想拜托你一件事。能把我需要的材料带来吗？";
		mes "什么时候想起来都可以……每天一次最好。偶尔带来也没关系。";
		next;
		mes "[Rachel Smith]";
		mes "我不能为此付给你钱，但会用其他东西补偿你。你觉得怎么样？";
		next;
		if (select( "答应她的请求。", "拒绝她的请求。" ) == 1) {
			// note: always iron
			mes "[Rachel Smith]";
		mes "谢谢你，冒险者。";
		mes "嗯……最重要的物品是……让我看看。今天……我需要一些铁。";
		mes "5 个铁。能带给我吗？";
			next;
			completequest 16036;// Expert's keen eye
			setquest 16040;// Collect 5 Irons
			getitem 25155,7;// Swz_Honor_Token
			rachel_quest_16_2 = 3;
			close;
		}
		mes "[Rachel Smith]";
		mes "好，我会的。";
		mes "我别无选择。";
		completequest 16036;// Expert's keen eye
		getitem 25155,7;// Swz_Honor_Token
		rachel_quest_16_2 = 3;
		close;
	}
	switch( checkquest(16037,PLAYTIME) ) {
	case -1:
		break;
	case 0:
	case 1:
		mes "[Rachel Smith]";
		mes "我想用你带来的矿石就能解决问题。";
		next;
		mes "[Rachel Smith]";
		mes "如果你能再次帮忙……明天能回来吗？我可能会需要其他矿石。";
		close;
	case 2:
		erasequest 16037;// Material collection once a day
		break;
	}
	if (isbegin_quest(16038) == 1)		callsub( S_Quest, 16038, 984,2, "two" );	// Oridecon
	else if (isbegin_quest(16039) == 1) callsub( S_Quest, 16039, 985,2, "two" );	// Elunium
	else if (isbegin_quest(16040) == 1) callsub( S_Quest, 16040, 998,5, "five" );	// Iron
	else {
		mes "[Rachel Smith]";
		mes "欢迎，冒险者。多亏你上次的帮助，我才能顺利工作。";
		mes "可以再拜托你一件事吗？";
		next;
		if (select( "当然可以。", "我今天很忙。" ) == 2) {
			mes "[Rachel Smith]";
			mes "嗯……我明白了。不过还是谢谢你上次的帮助。";
			mes "谢谢你再次到来。";
			next;
			mes "[Rachel Smith]";
			mes "除了材料之外……";
			mes "你能偶尔来这里见见我吗？";
			close;
		}
		switch( rand(16038,16040) ) {
		case 16038:
			mes "[Rachel Smith]";
			mes "要强化枪管，我需要奥利德奥康。";
			mes "请带给我 2 个奥利德奥康。";
			setquest 16038;// Collect 2 Oridecons
			close;
		case 16039:
			mes "[Rachel Smith]";
			mes "今天我的铝不够了。能带给我 2 个铝吗？";
			mes "我就靠你了，冒险者。";
			setquest 16039;// Collect 2 Eluniums
			close;
		case 16040:
			mes "[Rachel Smith]";
			mes "铁是所有武器最基本的材料。没有它，只靠其他强化材料什么也做不了。";
			mes "所以请带给我 5 个铁。";
			setquest 16040;// Collect 5 Irons
			close;
		}
	}
	end;

S_Quest:
	.@quest_id = getarg(0);
	.@item_req = getarg(1);
	.@count_req = getarg(2);
	.@count_req_string$ = getarg(3);
	switch( .@quest_id ) {
	case 16038:
		if (countitem(.@item_req) < .@count_req) {
			mes "[Rachel Smith]";
			mes "如果枪管不够坚硬，内管开几枪后就会熔化。最终它很快就会磨损。";
			mes "为了防止这种情况，我们需要高品质的奥利德奥康。请带来 2 个。";
			close;
		}
		break;
	case 16039:
		if (countitem(.@item_req) < .@count_req) {
			mes "[Rachel Smith]";
			mes "大城市的铁匠会把铝矿石兑换成铝……请带给我 2 个铝。";
			mes "如果我的技术更好，只用矿石就够了。我真惭愧……";
			close;
		}
		break;
	case 16040:
		if (countitem(.@item_req) < .@count_req) {
			mes "[Rachel Smith]";
			mes "我们总是缺铁。请带来 5 个铁。";
			mes "非常感谢你，冒险者。";
			close;
		}
		break;
	}
	mes "[Rachel Smith]";
	mes "你带来了我拜托你的 " + .@count_req_string$ + " 个" + getitemname(.@item_req) + "？非常感谢！";
	mes "你确定要把它们给我吗？";
	next;
	if (select( "当然。", "抱歉，我还需要它。" ) == 2) {
		mes "[Rachel Smith]";
		mes "好吧。我只是拜托你而已。";
		mes "如果你有更重要的事要做，不用担心我。";
		close;
	}
	mes "[Rachel Smith]";
	mes "谢谢你，冒险者……";
	mes "虽然我不能给你钱，但请收下这个。";
	mes "如果可以，明天也想拜托你帮忙。";
	erasequest .@quest_id;
	delitem .@item_req, .@count_req;
	setquest 16037;// Material collection once a day
	getexp 200000,200000;
	getitem 25155,3;// Swz_Honor_Token
	close;

OnInit:
	.@terra_main$ = "terra_gloria_main > 16";
	.@has_item$ = 
		"(isbegin_quest(16038) == 1 && countitem(984) > 1) || " +
		"(isbegin_quest(16039) == 1 && countitem(985) > 1) || " +
		"(isbegin_quest(16040) == 1 && countitem(998) > 4)";
	questinfo( QTYPE_QUEST, QMARK_NONE, (.@terra_main$ + " && isbegin_quest(16035) == 0 && (isbegin_quest(16036) == 0 || isbegin_quest(16036) == 1)") );
	questinfo( QTYPE_QUEST, QMARK_NONE, (.@terra_main$ + " && ((checkquest(16037,PLAYTIME) == -1 && (" + .@has_item$ + ")) || checkquest(16037,PLAYTIME) == 2)") );

	// twins daily quest : "Service: Cookies delivery"
	questinfo( QTYPE_QUEST, QMARK_NONE, "isbegin_quest(16029) == 1 && countitem(25161) > 0" );
	end;
}

ein_in01,38,21,3	script	Blacksmith Jack#16.2rm	4_M_MIDDLE1,{
	if (rachel_quest_16_2 == 1) {
		mes "[Blacksmith Jack]";
		mes "你似乎在找人。有什么事？";
		next;
		mes "[Blacksmith Jack]";
		mes "关于武器维修的建议？可是，你不是铁匠吧？";
		next;
		mes "[Blacksmith Jack]";
		mes "哦，你是受我们公会成员所托来这里的。让我看看。";
		next;
		if (countitem(25151) < 1) {
			mes "[Blacksmith Jack]";
			mes "拜托。我要先看武器才能给建议。";
			mes "我是铁匠，不是通灵师。";
			close;
		}
		mes "[Blacksmith Jack]";
		mes "嗯。这确实是我们公会成员的手艺。她改进了我们教给她的方法。";
		mes "她的技术很好。嗯，但是……";
		next;
		mes "[Blacksmith Jack]";
		mes "这是……嗯，我明白了……";
		next;
		mes "杰克正在仔细检查瑞秋的左轮手枪。";
		next;
		mes "[Blacksmith Jack]";
		mes "这不是她技术的问题，而是材料的问题。";
		mes "金属中混入了太多杂质，她处理起来一定很困难。但她还是勉强完成了。";
		next;
		mes "[Blacksmith Jack]";
		mes "回去告诉她，必须使用纯度更高的金属。";
		mes "这不是操作者的问题。如果它在她维修时爆炸，我也不会惊讶。";
		next;
		mes "[Blacksmith Jack]";
		mes "回去告诉她。也许它在这期间已经爆炸了……";
		delitem 25151,1;// Rachels_Revolver
		erasequest 16035;// Delivery: Explosive revolver materials
		setquest 16036;// Expert's keen eye
		rachel_quest_16_2 = 2;
		close;
	}
	mes "[Blacksmith Jack]";
	mes "经验丰富的铁匠用锤子敲击武器时，只要感受手臂上的震动，就能判断武器的状态。";
	next;
	mes "[Blacksmith Jack]";
	mes "除此之外，真正的大师还必须用眼睛和耳朵检查。";
	close;

OnInit:
	questinfo( QTYPE_QUEST, QMARK_NONE, "isbegin_quest(16035) == 1" );
	end;
}

// Misc npcs
rebel_in,72,32,7	script	Danae#16nego01	4_F_REBELLION2,{
	mes "[Danae]";
	mes "真好吃。还没有任务吗？";
	next;
	mes "[Tommy]";
	mes "是的。他们让我待命。";
	next;
	mes "[Danae]";
	mes "哦，我在等休假日。我要去朱诺吃些好吃的。";
	close;
}

rebel_in,72,29,5	script	Grinder#16nego01	4_M_REBELLION,{
	mes "[Grinder]";
	mes "哦，真辛苦。不是吗？";
	next;
	mes "[Fang]";
	mes "没那么辛苦。我告诉过你我去赫尔墨斯弗列图时的故事吗？";
	next;
	mes "[Grinder]";
	mes "你说过。超过一千次了。";
	next;
	mes "[Fang]";
	mes "我告诉过你，拿着枪时不要喝茶。要是茶洒在枪上怎么办？";
	next;
	mes "[Grinder]";
	mes "好吧，我先把茶喝完。";
	close;
}

rebel_in,75,31,3	script	Tommy#16nego01	4_M_GUNSLINGER2,{
	mes "[Tommy]";
	mes "你为什么一直擦它？";
	next;
	mes "[Danae]";
	mes "我总得照料它。";
	next;
	mes "[Tommy]";
	mes "你真勤快。";
	close;
}


		mes "你是著名的米德加尔特远征队成员，对吧？！";
		next;
		select("是的。:你怎么知道？");
		mes "[Fome]";
		mes "很简单。";
		mes "艾可拉玖周围没有人长得像你，也没有人穿着像你。";
		next;
		mes "[Fome]";
		mes "我听说通往彩虹桥的道路被奇怪的裂缝阻挡了，不久后，穿过迷雾森林来到这里的旅行者就开始出现。";
		next;
		mes "[Fome]";
		mes "他们是穿过约顿海姆、从米德加尔特来的人类！";
		mes "说真的……我很高兴来到了艾可拉玖。";
		mes "没想到能遇到来自米德加尔特的人！";
		next;
		mes "[Fome]";
		mes "艾可拉玖挤满了旅行者，直到最近，他们大多来自阿尔普海姆。";
		mes "见到你真好。我刚才正想和你说话。";
		next;
		switch( select("为什么艾可拉玖在旅行者中很受欢迎？:艾可拉玖最大的景点是什么？") ) {
			mes "[Fome]";
		case 1:
			mes "为什么这里有这么多旅行者……？";
			mes "首先，我认为是因为艾可拉玖与彩虹桥相连，所以大家可以在这里自由交流。";
			next;
			mes "[Fome]";
			mes "多亏彩虹桥的意志，大家在这里都能毫无障碍地交流，就像现在的你和我一样。";
			next;
			mes "[Fome]";
			mes "其次，是因为艾可拉玖既是阿尔普海姆的尽头，也是门户。";
			mes "这里是前往约顿海姆的唯一道路。";
			next;
			mes "[Fome]";
			mes "许多憧憬未知世界的旅行者会来到艾可拉玖。";
			mes "他们也想亲眼看看连接约顿海姆和阿尔普海姆的彩虹桥。";
			next;
			mes "[Fome]";
			mes "此外，艾可拉玖最近如此拥挤的最大原因是……！！！";
			next;
			select("是……？！");
			emotion ET_BLABLA;
			mes "[Fome]";
			mes "新任朱恩市长诞生了！";
			next;
			select("什么市长？");
			mes "[Fome]";
			mes "不，不，是朱恩市长。这是拉斐尔的名字。";
			mes "它……对了，意思是‘王’。";
			mes "王诞生了！";
			next;
			mes "[Fome]";
			mes "虽然他年纪不小，但还是成为了王。";
			mes "作为拉斐尔之王，他非常美丽。";
			next;
			select("那是什么时候？");
			mes "[Fome]";
			mes "嗯？也许是10年前？";
			mes "5年前？还是15年前？总之还不到100年。";
			next;
			mes "这个叫 Fome 的旅行者一直在讲拉斐尔之王。";
			mes "她似乎完全不在意别人，沉浸在自己的世界里，所以很难听懂她在说什么。";
			mes "去和其他旅行者聊聊吧。";
			setquest 7411;
			break;
		case 2:
			mes "艾可拉玖最大的景点？";
			mes "当然是彩虹桥塔！";
			mes "虽然严格来说它不在艾可拉玖境内！啊哈哈哈哈哈";
			next;
			mes "[Fome]";
			mes "我最近才来到这里，所以还没机会离开艾可拉玖。";
			mes "呼，外面有点吓人。";
			next;
			mes "[Fome]";
			mes "彩虹桥塔……哦，对了。";
			mes "Litrip 去过那里，对吧？去问 Litrip 吧！";
			next;
			mes "一个叫 Litrip 的旅行者似乎了解彩虹桥塔。";
			mes "去和他聊聊吧。";
			break;
		}
		ep14_2_mylord = 2;
	}
	else if (ep14_2_mylord == 3 || ep14_2_mylord == 4) {
		mes "刚才有个艾可拉玖卫兵在找你，对吧？";
		mes "我想他说会在东门等你。你不是得去吗？";
		next;
		mes "[Fome]";
		mes "他那么有礼貌，我想肯定是好事。";
		mes "当然。艾可拉玖的拉斐尔对旅行者非常慷慨。";
	}
	else if (ep14_2_mylord < 10) {
		mes "你看起来很忙。";
		mes "我从各处听说了很多关于你的事。";
		mes "看来你已经和拉斐尔成为朋友了。";
	}
	else if (ep14_2_mylord == 10) {
		if (checkquest(7424) == -1) {
			mes "原来你一直在为拉斐尔之王工作？！";
			mes "你怎么一句话都没告诉我？";
			mes "我也想经常见到王。";
			next;
			mes "[Fome]";
			mes "我只有祝贺他时见过一次，也只说了几句话……";
			mes "说真的~我还记得他有多美。";
			next;
			mes "[Fome]";
			mes "但拉斐尔似乎并不那么高兴见到他们的王。";
			mes "为什么？你知道些什么吗？";
			next;
			mes "[Fome]";
			mes "我不敢直接问他们相关的问题，因为担心会伤害他们的自尊。";
			next;
			setquest 7424;
			if ((isbegin_quest(7423) + isbegin_quest(7424) + isbegin_quest(7425) + isbegin_quest(7426)) == 4) {
				mes "据你所知，拉斐尔表面上对 Kardui 的看法还算不错。";
				mes "但实际上，大多数拉斐尔对他感到不安、不信任和怀疑。";
				mes "别再担心了，直接去问 Kardui 吧！";
				ep14_2_mylord = 11;
				erasequest 7423;
				erasequest 7424;
				erasequest 7425;
				changequest 7426,7427;
			}
			else {
				mes "Fome 说的很有意思。";
				mes "一个不受信任的王……我该听听其他拉斐尔对此的看法吗？";
			}
		}
		else {
			mes "我确定有些问题。";
			mes "据我观察，他们在庆祝王诞生时显得很焦虑。";
		}
	}
	else {
		mes "我该开始计划前往下一个地区了。";
		mes "我在犹豫是直接回去，还是去摩拉村……";
	}
	close;
	
OnTouch:
	if (ep14_2_mylord == 0 && BaseLevel > 98) {
		mes "一群来自阿尔普海姆的旅行者正在交谈。";
		emotion ET_BLABLA;
		emotion ET_BLABLA, getnpcid(0, "Traveler Litrip#tl02");
		emotion ET_BLABLA, getnpcid(0, "Traveler Chiba#tl03");
		next;
		switch( select("避开他们。:加入他们。") ) {
		case 1:
			mes "他们似乎不太在意。";
			close;
		case 2:
			mes "你靠近时，他们停下交谈，为你让出一个座位。";
			mes "开始交谈。";
			ep14_2_mylord = 1;
			close;
		}
	}
}

ecl_in01,32,51,7	script	Traveler Litrip#tl02	4_M_DOGTRAVELER,{
	if (BaseLevel < 99) {
		mes "[Litrip]";
		mes "嘿，年轻人。";
		mes "你能走到这么远，真是令人佩服……";
		close;
	}
	if (ep14_2_mylord == 2 && isbegin_quest(7412) == 1) {
		EclageinEntrance;
		mes "[Litrip]";
		mes "只听我的故事可没意思。";
		mes "你也该去和 Fome、Chiba 聊聊。";
		next;
		mes "[Litrip]";
		mes "如果你解开了彩虹桥塔的谜团，记得告诉我。";
		mes "我期待听到你的消息，哈哈哈。";
		close;
	}
	mes "[Litrip]";
	if (ep14_2_mylord < 3) {
		mes "哦，看看这个奇怪的旅行者。";
		mes "过来吧。我叫 Litrip。";
		next;
		mes "[Litrip]";
		mes "你来自摩拉？";
		mes "那你一定在路上见过彩虹桥塔吧？";
		next;
		switch( select("我从外面看过。:我进过塔内。") ) {
			mes "[Litrip]";
		case 1:
			mes "真的吗？那真遗憾。";
			mes "不过，塔里有可怕的怪物，小心一点也是好事。";
			mes "总比鲁莽行事丢掉性命好。";
			break;
		case 2:
			mes "我明白了。那里很疯狂吧？";
			mes "很久以前，那里曾是一座很棒的观测台。";
			next;
			mes "[Litrip]";
			mes "不过现在已经被可怕的怪物占据了。";
			mes "看你进塔后还能毫发无伤地出来，我就知道你相当厉害。";
			break;
		}
		next;
		mes "[Litrip]";
		mes "有传闻说塔顶住着一位可疑的炼金术士。";
		mes "没人知道为什么，但我听说他在那里待了很久。";
		next;
		mes "[Litrip]";
		mes "如果那位炼金术士还活着，他自己就是活生生的历史，因为塔、炼金术士和彩虹桥在艾可拉玖建立之前就已经存在了。";
		next;
		mes "[Litrip]";
		mes "仍有不少人挑战自己，试图寻找彩虹桥塔的神秘传说，但到目前为止没有人成功。";
		next;
		select("拉斐尔呢？");
		mes "[Litrip]";
		mes "嗯，拉斐尔？";
		mes "不知为什么，他们完全不关心彩虹桥塔。";
		mes "我想他们只是把它当成自然景观。";
		next;
		mes "[Litrip]";
		mes "如果他们愿意，其实完全有能力解开谜团，但我感觉他们只是尊重彩虹桥塔的存在。";
		next;
		mes "[Litrip]";
		mes "不过他们也不会阻止人们进入高塔。所以我想，他们可能只是没有意识到这一点。";
		mes "如果你好奇，就去挑战自己，解开高塔的谜团吧。";
		setquest 7412;
		ep14_2_mylord = 2;
		next;
		mes "[Litrip]";
		mes "我的故事到这里就结束了。";
		mes "去问问 Fome 和 Chiba，他们应该也有有用的信息。";
	}
	else if (ep14_2_mylord == 3) {
		mes "看来拉斐尔有公务要和你处理。";
		mes "他们不是叫你去东门吗？";
		mes "你应该去。";
	}
	else if (ep14_2_mylord == 4)
		mes "你不是应该在东门见某个人吗？";
	else if (ep14_2_mylord < 10) {
		mes "自从上次看见你和卫兵交谈后，我到处都听到你的名字。";
		mes "是很重要的事吗？你在这里已经很有名了。";
	}
	else if (ep14_2_mylord == 10) {
		mes "庆祝新王诞生的气氛现在几乎消失了。";
		mes "但这里感觉有些奇怪。";
		next;
		mes "[Litrip]";
		mes "就像热闹的节日结束后产生的空虚感……";
	}
	else {
		mes "我在考虑和 Chiba 再去一次高塔。";
		mes "听说那里景色很美。";
		mes "如果运气好，我也会去摩拉。";
	}
	close;
}

ecl_in01,35,51,3	script	Traveler Chiba#tl03	4_M_DOGTRAVELER2,{
	if (BaseLevel < 99) {
		mes "[Chiba]";
		mes "虽然我喜欢独自旅行，";
		mes "但在危险地区有同伴也不错。";
		mes "不过你……嗯……我觉得你的实力还不足以在这一带旅行。";
		close;
	}
	if (ep14_2_mylord == 2 && isbegin_quest(7413) == 1) {
		EclageinEntrance;
		mes "[Chiba]";
		mes "我知道拉斐尔会为王位继承举行盛大仪式，但不清楚仪式具体是什么。";
		next;
		mes "[Chiba]";
		mes "朱恩市长的寿命很长，所以能亲眼看到仪式的机会很难得。";
		close;
	}
	mes "[Chiba]";
	if (ep14_2_mylord < 3) {
		mes "你是来自米德加尔特的人类。";
		mes "我叫 Chiba。";
		mes "如你所见，我也是和你一样的旅行者。";
		next;
		mes "[Chiba]";
		mes "我认为旅行时当地信息最重要。";
		mes "你也这么认为吧？";
		next;
		mes "[Chiba]";
		mes "我听说有办法避开阻挡约顿海姆的裂缝……";
		mes "人们真的会穿过迷雾森林旅行吗？";
		next;
		switch( select("是的。:用魔法！") ) {
			mes "[Chiba]";
		case 1:
			mes "原来如此。";
			mes "我想，这就是人类的强大之处。";
			mes "我在摩拉时，听说迷雾森林里有很多失踪的人……";
			break;
		case 2:
			mes "确实……先到达摩拉的人会用魔法帮助其他人旅行？";
			mes "真聪明。";
			break;
		}
		next;
		mes "[Chiba]";
		mes "总之，多亏你们，交流确实变得活跃了。";
		mes "我应该为此感到感激。";
		next;
		mes "[Chiba]";
		mes "你想知道更有趣的事吗？";
		mes "阿尔普海姆人人都知道，但我确定你们从未听说过。";
		next;
		mes "[Chiba]";
		mes "在拉斐尔中，你见过那些身材更高、皮肤特别明亮、还长着华丽翅膀的人吗？";
		next;
		mes "[Chiba]";
		mes "他们叫‘多纳斯’。顺便说，外表普通的拉斐尔在他们的语言中叫‘帕邦’。";
		mes "听起来像某种零食，不过我们应该尊重他们。";
		next;
		mes "[Chiba]";
		mes "多纳斯之所以更高大华丽，是因为他们都是市长候选人。";
		mes "也就是说，他们都有机会成为王。";
		next;
		mes "[Chiba]";
		mes "这里说的不是上层阶级或下层阶级，而是按照职业分类。";
		mes "这可能不重要，但作为外来者，了解一下也不错。";
		next;
		mes "[Chiba]";
		mes "总之，多纳斯拥有强大的魔力，寿命也更长。但他们人数不多，所以大多数都被安排在重要职位上。";
		mes "谁知道呢？赢得他们的好感也许不错。哈哈哈。";
		next;
		mes "[Chiba]";
		mes "拉斐尔之王的王位看似由血统继承，但实际上并非如此。";
		mes "据说朱恩市长会在多纳斯中出现，但事实就只是这样。";
		next;
		mes "[Chiba]";
		mes "他会直接出现，完全没有正式的继承流程。";
		mes "是不是很有意思？";
		setquest 7413;
		if (ep14_2_mylord < 2) {
			ep14_2_mylord = 2;
			next;
			mes "你从 Chiba 那里得到了与拉斐尔有关的信息。";
			mes "去和其他旅行者聊聊吧。";
		}
		else {
			next;
			mes "[Chiba]";
			mes "如果我早点来，也许就能成为历史时刻的一部分……";
			mes "但我错过了。嘿嘿嘿。";
		}
	}
	else if (ep14_2_mylord == 3) {
		mes "刚才不是有艾可拉玖卫兵在找你吗？";
		mes "为了避免冲突，你最好尽可能尊重拉斐尔。";
		mes "这是旅行的基本原则。";
	}
	else if (ep14_2_mylord == 4) {
		mes "你不是和艾可拉玖卫兵一起去了什么地方吗？";
		mes "如果路上迷路，就去问东门的卫兵。";
		mes "他会为你指路。";
	}
	else if (ep14_2_mylord < 10)
		mes "所以，你果然不只是普通旅行者。";
	else {
		mes "嗯……我要不要试着穿过迷雾森林？";
		mes "也许太勉强了……对吧？";
		mes "我还是和 Litrip 再去一次高塔吧。";
	}
	close;
}

ecl_in01,31,49,7	script	Eclage Guard#tl01	4_M_FAIRYSOLDIER,{
	mes "[Eclage Guard]";
	mes "哦，我该赶紧回原来的地方了。";
	mes "失陪。";
	close2;
OnInit:
OnDisable:
	hideonnpc "Eclage Guard#tl01";
	end;
OnEnable:
	hideoffnpc "Eclage Guard#tl01";
	end;
}

ecl_in01,82,70,3	script	Eclage Guard#tl02	4_M_FAIRYSOLDIER,{
	if (!checkweight(1301,3)) {
		mes "- 你携带的物品太多，无法继续任务。-";
		close;
	}
	cutin "minuel01",2;
	if (ep14_2_mylord == 7) {
		if (checkquest(7418) == -1) {
			mes "[Eclage Guard]";
			mes "咦，很高兴再次见到你。";
			mes "早知道会这么频繁地遇到，我们应该早点互相介绍。";
			next;
			mes "[Minuel]";
			mes "我叫 Minuel。";
			mes "这是个很普通的名字，我甚至不知道它是什么意思。";
			mes "我想父母只是给我取了个听起来顺耳的名字。";
			next;
			mes "[Minuel]";
			mes "说起来，我听到了消息。";
			mes "你决定在艾可拉玖工作……";
			cutin "minuel02",2;
			next;
			switch( select("只是传闻。:他们有工作要给我吗？") ) {
				mes "[Minuel]";
			case 1:
				mes "咦？真的吗？";
				mes "那真遗憾。本来有适合你的工作。";
				mes "好吧，我明白了。";
				cutin "minuel01",2;
				break;
			case 2:
				mes "其实我必须一直待在这里，根本没有自己的时间。";
				mes "不只是我，大多数从事这项工作的拉斐尔也面临同样的情况。";
				cutin "minuel01",2;
				next;
				mes "[Minuel]";
				mes "所以我们没有时间装饰我们的 Yai。";
				mes "当然可以买材料。但和其他消费者一样，我们想自己收集。";
				next;
				mes "[Minuel]";
				mes "既然你可以自由前往各处，";
				mes "能帮忙收集一些 Yai 的装饰品吗？";
				next;
				if (select("当然。:不。") == 1) {
					mes "[Minuel]";
					mes "谢谢。";
					mes "你需要找到";
					mes "5个山狮之角、5个魔力和5个马蹄。";
					next;
					mes "[Minuel]";
					mes "我想用未经雕琢的美来装饰它。";
					mes "你可以去斯普兰迪附近狩猎怪物获得材料，那里我不方便去。";
					next;
					mes "[Minuel]";
					mes "我听说过一些关于山狮的传闻，它们似乎出现在萨帕的地区。";
					mes "还有它们的角、生活在草原上的科鲁努斯的神秘之角，以及叫作马蹄的东西。";
					next;
					mes "[Minuel]";
					mes "我相信你比我更了解那些马蹄。";
					mes "拜托你了！";
					setquest 7418;
				}
				else {
					mes "[Minuel]";
					mes "哈，你真的这么想吗？";
					mes "你还会再来这里的。";
					mes "很快，就在不久之后。嘿嘿嘿。";
					cutin "minuel02",2;
				}
				close2;
				cutin "",255;
				end;
			}
		}
		else if (isbegin_quest(7418) == 1) {
			mes "[Minuel]";
			if (countitem(6032) < 5 || countitem(6023) < 5 || countitem(944) < 5) {
				mes "我让你收集5个山狮之角、5个神秘之角和5个马蹄。";
				mes "你可以在斯普兰迪附近捕捉科鲁努斯获得神秘之角。";
			}
			else {
				mes "你已经来了！";
				mes "让我检查一下物品。";
				mes "嗯……";
				next;
				mes "[Minuel]";
				mes "适当地刮花后，它们看起来会更狂野。";
				mes "这些很棒。非常感谢你。";
				cutin "minuel02",2;
				next;
				delitem 6032,5;// Horn_Of_Hilsrion
				delitem 6023,5;// Mystic_Horn
				delitem 944,5;// Horseshoe
				completequest 7418;
				getexp 200000,200000;
				mes "[Minuel]";
				if ((isbegin_quest(7418) + isbegin_quest(7419) + isbegin_quest(7420)) > 5) {
					mes "说起来，你也为其他拉斐尔做了很多工作。";
					mes "这就够了。现在你应该去见他。";
					cutin "minuel01",2;
					next;
					mes "[Minuel]";
					mes "我的工作是在合适的时间传达他的意志。";
					mes "我想现在就是时候了。";
					ep14_2_mylord = 8;
					changequest 7417,7421;
					next;
					mes "[Minuel]";
					mes "因为经常见到你，我想自己已经对你产生感情了。";
					mes "嗯，我只是说说自己的感受。";
				}
				else {
					mes "很快你就能听到好消息了。";
					mes "敬请期待吧。";
				}

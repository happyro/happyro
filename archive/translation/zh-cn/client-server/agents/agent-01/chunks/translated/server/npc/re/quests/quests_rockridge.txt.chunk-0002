		else {
			mes "[怀亚特·沃普]";
			mes "这次公司派来了一位能干的冒险者。";
			mes "我们两个人可以处理这件事，但市长需要知道村里发生了什么。";
			next;
			mes "[怀亚特·沃普]";
			mes "好，那就去和他谈谈。";
			mes "与此同时，我会为会面做准备。";
			next;
			mes "[怀亚特·沃普]";
			mes "你应该能像往常一样在码头找到科斯特洛。";
		}
		mes "稍后我会再来这里和你会合。";
		rock_main_quest = 3;
		erasequest 7792;// Problems in Rock Ridge 2
		setquest 7793;// Good News
		close;
	}
	if (rock_main_quest == 3) {
		mes "[怀亚特·沃普]";
		mes "你应该能像往常一样在码头找到科斯特洛。";
		mes "稍后我会再来这里和你会合。";
		close;
	}
	if (rock_main_quest == 4) {
		mes "[怀亚特·沃普]";
		mes "啊，你回来了。";
		mes "我已经准备好会面了。";
		mes "只有你和我，对吧？";
		next;
		mes "[怀亚特·沃普]";
		mes "科斯特洛呢？";
		mes "他不可能愿意去那里。";
		mes "我就知道最后会是你代替他。";
		next;
		mes "[怀亚特·沃普]";
		mes "差不多该去见强盗了。";
		mes "从东门离开村庄，你就会到达^4d4dff奇瓦瓦沙漠^000000。";
		mes "仙人掌族把那片荒地称为沙漠。总之，沙漠北边有一列^4d4dff停驶的货运列车^000000。";
		next;
		mes "[怀亚特·沃普]";
		mes "如果你觉得找不到，就沿着铁路走。";
		mes "我们会在火车旁等他。";
		mes "去看看水牛强盗的首领^4d4dff约翰尼·詹姆斯^000000到底有多丑吧。";
		rock_main_quest = 5;
		erasequest 7794;// Expected Response
		setquest 7795;// Negotiation on the Railroad
		close;
	}
	if (rock_main_quest == 5) {
		mes "[怀亚特·沃普]";
		mes "从东门出去，沿铁路向北走。你会看到一列^4d4dff停驶的货运列车^000000。";
		mes "我们在火车旁等强盗吧。";
		close;
	}
	if (rock_main_quest == 6) {
		setpcblock PCBLOCK_NPC, true;
		npctalk "我说，我们应该让他反过来对付自己的同伙。", "Ivoka Skudi#rr03", bc_self;
		sleep2 2000;
		npctalk "你不觉得普通的酷刑或威胁就能奏效吗？", "", bc_self;
		sleep2 3000;
		npctalk "约翰尼·詹姆斯不是我们唯一需要担心的人。还有谁？", "Ivoka Skudi#rr03", bc_self;
		sleep2 1000;
		npctalk "我知道。还有艾伯特。", "", bc_self;
		sleep2 2000;
		setpcblock PCBLOCK_NPC, false;
		mes "[怀亚特·沃普]";
		mes "欢迎。";
		mes "*轻笑* 你真有用。只要站在我们身边就能发挥奇效。";
		next;
		mes "[怀亚特·沃普]";
		mes "总之，约翰尼·詹姆斯比我想的更顽固。";
		mes "他还是没告诉我们被偷的矿石在哪里。";
		next;
		npctalk "他可能想让我们用他交换矿石。", "Ivoka Skudi#rr03", bc_self;
		mes "[怀亚特·沃普]";
		mes "有可能。";
		mes "我猜艾伯特·福特很快就会想和我们谈谈。";
		next;
		mes "[怀亚特·沃普]";
		mes "但那只是暂时的。";
		sleep2 1000;
		npctalk "我们还必须夺回矿井！", "Ivoka Skudi#rr03", bc_self;
		mes "没错。我们还必须夺回矿井。";
		next;
		mes "[怀亚特·沃普]";
		mes "所以我们一直在讨论下一步行动。";
		mes "伊沃卡想让他反过来对付自己的同伙。";
		next;
		select("他只要告诉我们矿石在哪里，就能自由离开这里。 ");
		mes "[怀亚特·沃普]";
		mes "通常来说，这确实是首先会想到的办法。";
		mes "问题在于，";
		mes "约翰尼这家伙不正常。";
		mes "又或者，他在等待什么。";
		next;
		mes "[怀亚特·沃普]";
		mes "无论如何，他拒绝合作让我们很难办。";
		mes "我想我们应该等艾伯特联系我们会面，";
		next;
		mes "[怀亚特·沃普]";
		mes "但伊沃卡有不同的想法。";
		mes "听听他的意见吧。";
		rock_main_quest = 7;
		questinfo_refresh();	// the update of the variable refreshes questinfo
		close;
	}
	if (rock_main_quest == 7) {
		mes "[怀亚特·沃普]";
		mes "听听伊沃卡的意见吧。";
		close;
	}
	if (rock_main_quest == 8) {
		mes "[怀亚特·沃普]";
		mes "^4d4dff约翰尼·詹姆斯被关在地下室里^000000。";
		mes "我们试着让他相信艾伯特背叛了他，而他唯一的出路就是和我们谈谈。";
		close;
	}
	if (rock_main_quest == 9) {
		mes "[怀亚特·沃普]";
		mes "约翰尼甚至把联系艾伯特的暗号告诉你了吗？";
		mes "他正在帮助我们抓住艾伯特。";
		next;
		mes "[怀亚特·沃普]";
		mes "好，那就去和艾伯特见面。";
		mes "与此同时，我会再吓吓约翰尼。";
		mes "哇哈哈哈！";
		next;
		mes "[怀亚特·沃普]";
		mes "哦，对了！我差点忘了，^4d4dff肖恩·麦柯迪^000000想和你谈谈矿井的事。";
		mes "你出去时就能找到他。去和他谈谈吧。";
		next;
		mes "[怀亚特·沃普]";
		mes "谁知道呢？也许你能找到对付水牛强盗的办法。";
		rock_main_quest = 10;
		erasequest 7798;
		setquest 7799;// Shawn McCurdy's Weapon 1
		close;
	}
	if (rock_main_quest == 10) {
		mes "[怀亚特·沃普]";
		mes "和艾伯特的谈判交给你处理。";
		mes "趁他以为你真的来自总部时，我想抓住他。";
		next;
		mes "[怀亚特·沃普]";
		mes "哦，还有，你出去时应该和肖恩·麦柯迪谈谈。";
		mes "他说有重要的事要告诉你。";
		close;
	}
	if (rock_main_quest == 11) {
		mes "[怀亚特·沃普]";
		mes "我明白了。";
		mes "我们可以用它说服强盗，让他们相信矿井没有他们想的那么有用。";
		mes "这也不完全是谎话。很快就会变成事实。";
		next;
	}
	if (rock_main_quest < 14) {
		mes "[怀亚特·沃普]";
		mes "这取决于你和肖恩。";
		mes "就像肖恩说的，去矿井第二层拿一块矿石给艾伯特看看。";
		mes "这样就能进一步让他老实。";
		next;
		mes "[怀亚特·沃普]";
		mes "我怎么去矿井？";
		mes "沿铁路向东走。";
		mes "尽量走对路线。";
		close;
	}
	if (rock_main_quest == 14) {
		if (isbegin_quest(7809) == 0 && countitem(25247) > 0) {
			mes "[怀亚特·沃普]";
			mes "肖恩说得对。";
			mes "把矿石给我。";
			mes "我会交给肖恩。";
			delitem 25247, countitem(25247);// Violet_Stone
			setquest 7809;// Collecting Ores
			completequest 7809;// Collecting Ores
			next;
		}
		mes "[怀亚特·沃普]";
		mes "嗯？你手里的那撮毛是什么？";
		mes "艾伯特的鬃毛？";
		mes "你真的把他解决了吗？";
		next;
		mes "[怀亚特·沃普]";
		mes "天哪，你们冒险者真可怕。";
		mes "嗯？不是？哦，是他给你的。";
		mes "啊，是为了骗约翰尼！";
		next;
		mes "[怀亚特·沃普]";
		mes "*摇头* 哈哈哈。";
		mes "好，最后再去和约翰尼谈一次。";
		mes "至少应该让他做个好梦，对吧？";
		close;
	}
	if (rock_main_quest == 15) {
		if (isbegin_quest(7809) == 0 && countitem(25247) > 0) {
			mes "[怀亚特·沃普]";
			mes "肖恩说得对。";
			mes "把矿石给我。";
			mes "我会交给肖恩。";
			delitem 25247, countitem(25247);// Violet_Stone
			setquest 7809;// Collecting Ores
			completequest 7809;// Collecting Ores
			next;
		}
		mes "[怀亚特·沃普]";
		mes "好，那就让肖恩处理这件事。";
		mes "你能去告诉肖恩矿石在哪里吗？";
		mes "我去和科斯特洛谈谈。";
		next;
		mes "[怀亚特·沃普]";
		mes "哦，还有，";
		mes "我想是时候警告艾伯特了。";
		mes "告诉他，他们在矿井里待得越久，活着出来的机会就越小。";
		next;
		select("你打算直接和他们战斗吗？");
		mes "[怀亚特·沃普]";
		mes "是的，我们没什么好谈的了。";
		mes "是时候威胁他们了。";
		mes "现在先^4d4dff和肖恩一起寻找矿石。^000000";
		next;
		mes "[怀亚特·沃普]";
		mes "拿回矿石后，我们就没什么可担心的了。";
		mes "消灭岩脊和矿井周围的水牛强盗，";
		mes "然后把他们的^4d4dff围巾和头巾交给艾伯特。^000000";
		next;
		mes "[怀亚特·沃普]";
		mes "他虽然愚蠢，但也该明白这意味着什么。";
		mes "*轻笑* 谁能想到冒险者这么有用？";
		mes "我要告诉科斯特洛，多招募一些像你这样的冒险者！";
		next;
		mes "[怀亚特·沃普]";
		mes "现在去找^4d4dff肖恩·麦柯迪^000000吧，好吗？";
		mes "我们快解决这些强盗了！";
		mes "坚持住！";
		rock_main_quest = 16;
		erasequest 7804;// Location of the Ores
		setquest 7805;// Location of the Ores 2
		close;
	}
	if (rock_main_quest == 16) {
		mes "[怀亚特·沃普]";
		mes "现在去找^4d4dff肖恩·麦柯迪^000000吧，好吗？";
		mes "我们快解决这些强盗了！";
		next;
		mes "[怀亚特·沃普]";
		mes "拿回矿石后，我们就能打倒强盗！";
		mes "这次别忘了给艾伯特一个教训。";
		close;
	}
	if (rock_main_quest < 21) {
		mes "[怀亚特·沃普]";
		mes "*轻笑* 我该拿水牛强盗怎么办？";
		mes "光是想到要玩弄他们，我就兴奋起来了。";
		close;
	}
	if (rock_main_quest == 21) {
		if (countitem(25248) < 1) {// note: player can't finish the quest without the item
			mes "[怀亚特·沃普]";
			mes "肖恩说你会带来矿石箱。它在哪里？";
			mes "如果因为太重把它放在了什么地方，请把它带来。";
			close;
		}
		mes "[怀亚特·沃普]";
		mes "进展如何？";
		mes "你已经向艾伯特·福特宣战了。";
		next;
		mes "[怀亚特·沃普]";
		mes "哇哈哈哈哈！";
		mes "这正是我想要的！";
		mes "我们最好再招募一些冒险者，一口气解决这些强盗！";
		next;
		mes "[怀亚特·沃普]";
		mes "你是岩脊的英雄。";
		mes "矿井第一层已经废弃，但第二层的储备足够让我们维持一阵子。矿井的问题解决了。";
		next;
		mes "[怀亚特·沃普]";
		mes "我唯一要做的就是奖励你。";
		mes "来，选一个你喜欢的。";
		mes "岩脊感谢你的";
		mes "帮助。";
		next;
		mes "[怀亚特·沃普]";
		mes "两枚徽章都是我们治安官佩戴的，但效果不同。";
		mes "我有 " + mesitemlink( 28495, false, "治安官徽章（左）" );
		mes "和 " + mesitemlink( 28496, false, "治安官徽章（右）" ) + "。";
		mes "选一个你喜欢的。";
		next;
		setarray .@item_name$[0], "Vigilante Badge (L)", "Vigilante Badge (R)";
		setarray .@item_id[0], 28495, 28496;
		.@s = select( "Vigilante Badge (L)", "Vigilante Badge (R)" ) - 1;
		mes "[怀亚特·沃普]";
		mes "你想要 " + mesitemlink( .@item_id[.@s], false, .@item_name$[.@s] ) + "吗？";
		mes "真是明智的选择！";
		mes "你确定要这个吗？";
		next;
		if (select( "Yes.", "No." ) == 2) {
			mes "[怀亚特·沃普]";
			mes "看来你想仔细考虑";
			mes "自己要拿什么。";
			mes "慢慢来。";
			close;
		}
		mes "[怀亚特·沃普]";
		mes "来，这是你应得的。";
		mes "为自己感到骄傲吧。";
		mes "这是奖励金。";
		rock_main_quest = 22;
		delitem 25248,1;// Violet_Stone_Box
		erasequest 7808;// Case Solved
		setquest 9457;// Solved Anyway
		completequest 9457;// Solved Anyway
		getitem .@item_id[.@s],1;
		getitem 25250,200;// Coin_Of_Rr
		getexp 2500000,1200000;
		close;
	}
	mes "[怀亚特·沃普]";
	mes "你为岩脊带回了希望。";
	mes "年轻的英雄，";
	mes "挺起胸膛，把世界当成自己的领地去旅行吧！";
	close;

OnInit:
	questinfo( QTYPE_QUEST, QMARK_YELLOW,
		"rock_main_quest == 2 || rock_main_quest == 4 || rock_main_quest == 6 || rock_main_quest == 9 || rock_main_quest == 15 || rock_main_quest == 21" );
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "rock_main_quest == 14 && isbegin_quest(7809) == 0 && countitem(25247) > 0" );
	end;
}

har_in01,14,24,5	script	Ivoka Skudi#rr03	4_M_EVOKASCUDI,{
	if (checkweight(1301,3) == 0) {
		mes "- 你携带的物品太多，无法继续任务。-";
		close;
	}
	if (rock_main_quest < 7) {
		mes "[伊沃卡·斯库迪]";
		mes "这里是警长办公室。";
		mes "做了不该做的事的人会被戴上手铐带到这里。";
		close;
	}
	if (rock_main_quest == 7) {
		mes "[伊沃卡·斯库迪]";
		mes "约翰尼一定担心自己在帮派中的地位不保，尽管他装作毫不在意。";
		mes "艾伯特已经逃跑过一次了。";
		next;
		mes "[伊沃卡·斯库迪]";
		mes "啊，当然，艾伯特逃跑了。这样他就能把朋友带来。";
		mes "嗯，换句话说，是我们放他逃跑的。";
		next;
		mes "[伊沃卡·斯库迪]";
		mes "你觉得约翰尼看到那一幕会怎么想？";
		next;
		select("他可能觉得艾伯特背叛了他。");
		mes "[伊沃卡·斯库迪]";
		mes "没错。不信任的种子已经种下。我们现在只需要";
		next;
		mes "[伊沃卡·斯库迪]";
		mes "告诉约翰尼艾伯特和其他人抛弃了他。艾伯特现在是他们的首领！";
		mes "虽然老套，但很有说服力，对吧？";
		next;
		npctalk "但他们绝不会那样做。他们宁愿袭击我们的村庄救他，也不会背叛他。", "Wyatt Warp#har_in01", bc_self;
		sleep2 2000;
		mes "[伊沃卡·斯库迪]";
		mes "啊，你说得有道理。而且这样更合理，对吧？";
		mes "这就是冒险者你发挥作用的地方。";
		next;
		mes "[伊沃卡·斯库迪]";
		mes "需要有人说服艾伯特，约翰尼作为人质根本一文不值，";
		mes "我们希望这个人就是你。";
		next;
		mes "[伊沃卡·斯库迪]";
		mes "告诉他";
		mes "我们不需要矿石，";
		mes "让他以为自己没有谈判筹码。";
		next;
		mes "[伊沃卡·斯库迪]";
		mes "并告诉他，我们一直想要的其实是约翰尼。";
		mes "只要让他相信这一点，我们就能以强势地位谈判。";
		next;
		select("矿井怎么办？");
		mes "[伊沃卡·斯库迪]";
		mes "你可以告诉他，总部正在考虑关闭矿井。";
		mes "那些水牛也没有办法证实这件事。";
		next;
		mes "[伊沃卡·斯库迪]";
		mes "如果有必要，我可以散播村里的职位都已经招满的谣言。*轻笑*";
		npctalk "看来你觉得我们应该给艾伯特施压。那约翰尼呢？", "Wyatt Warp#har_in01", bc_self;
		next;
		mes "[伊沃卡·斯库迪]";
		mes "我们可以告诉他艾伯特已经放弃了他，";
		mes "并且正煽动其他人反对他，好成为他们的首领。";
		next;
		npctalk "我明白了。", "Wyatt Warp#har_in01", bc_self;
		mes "[怀亚特·沃普]";
		mes "嗯，这主意不坏。";
		mes "不知道科斯特洛会怎么想。";
		mes "他大概会说些蠢话，比如^4d4dff花一百万 Zeny 买矿石^000000。";
		next;
		mes "[怀亚特·沃普]";
		mes "他想用钱解决一切？而且还是别人的钱。";
		mes "我认为现在应该按我们的计划行事。";
		next;
		mes "[怀亚特·沃普]";
		mes "你在这件事中扮演着非常重要的角色。";
		mes "第一次见面时我们谎称你来自总部，这一步走得很好。";
		next;
		mes "[怀亚特·沃普]";
		mes "现在先处理约翰尼，怎么样？";
		mes "艾伯特的间谍一直进出地下室。";
		sleep2 1000;
		npctalk "是的，我们可以利用他为自己谋利。", "Wyatt Warp#har_in01", bc_self;
		next;
		mes "[怀亚特·沃普]";
		mes "伊沃卡说得对。";
		mes "让间谍看到你和约翰尼谈话。";
		mes "并说服约翰尼，艾伯特已经放弃了你。";
		rock_main_quest = 8;
		erasequest 7796;
		setquest 7797;// Hear Me Out 1
		close;
	}
	if (rock_main_quest == 8) {
		mes "[伊沃卡·斯库迪]";
		mes "我们就靠你了，冒险者！";
		mes "别给约翰尼思考的机会。";
		next;
		mes "[伊沃卡·斯库迪]";
		mes "约翰尼被关在地下监狱里。";
		mes "去戏弄他吧！";
		close;
	}
	if (rock_main_quest < 14) {
		mes "[伊沃卡·斯库迪]";
		mes "在矿井前的岩石上敲三下，艾伯特就会出来。";
		mes "我还以为那是矿工们用来表示吃饭的信号。";
		next;
		mes "[伊沃卡·斯库迪]";
		mes "愚蠢的水牛。";
		mes "连自己的信号都想不出来。";
		close;
	}
	if (rock_main_quest == 14 || rock_main_quest == 15) {
		mes "[伊沃卡·斯库迪]";
		mes "成功了！";
		mes "来，我们去戏弄约翰尼！";
		mes "*轻笑*";
		close;
	}
	mes "[伊沃卡·斯库迪]";
	mes "我能想象那些水牛会有什么反应。";
	mes "看来我得加强训练我们的治安官。";
	close;

OnInit:
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "rock_main_quest == 6 || rock_main_quest == 7" );
	end;
}

har_in01,34,28,0	script	har_in01_jail	WARPNPC,1,1,{
	end;
OnTouch:
	if (rock_main_quest < 6) {
		mes "[伊沃卡·斯库迪]";
		mes "你不能进去。";
		mes "那里是牢房。";
		close;
	}
	warp "har_in01",99,27;
	end;
}

// Prison
har_in01,100,14,3	script	Vigilante#srdg01	4_M_CACTUSLADY,{
	setpcblock PCBLOCK_NPC, true;
	npctalk "你最好别做傻事。", "", bc_self;
	sleep2 1000;
	npctalk "我会像鹰一样盯着你。", "", bc_self;
	setpcblock PCBLOCK_NPC, false;
	end;
}

har_in01,81,30,3	script	Harold#srdg01	4_TOWER_09,{
	setpcblock PCBLOCK_NPC, true;
	emotion ET_OHNO;
	npctalk "真不敢相信你。唉！", "", bc_self;
	sleep2 1000;
	npctalk "你在说什么？", "Egring#srdg01", bc_self;
	sleep2 1000;
	emotion ET_ANGER;
	npctalk "你故意不付餐馆账单，好让自己进监狱，然后靠牢饭把自己养胖。太离谱了！", "", bc_self;
	sleep2 1000;
	emotion ET_HNG, getnpcid(0, "Egring#srdg01");
	npctalk "食物这么好吃，我也没办法。", "Egring#srdg01", bc_self;
	sleep2 1000;
	npctalk "这个嘛，我同意。", "", bc_self;
	setpcblock PCBLOCK_NPC, false;
	end;
}

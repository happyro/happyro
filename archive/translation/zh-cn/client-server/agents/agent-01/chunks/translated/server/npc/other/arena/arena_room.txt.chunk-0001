arena_room,94,93,5	script	Vendigos	97,{
	mes "[文迪戈斯]";
	mes "欢迎来到竞技场，这是与时间限制的战斗。";
	mes "我叫文迪戈斯，来这里帮助你。";
	next;
	mes "[文迪戈斯]";
	mes "有问题随时问我。";
	next;
	while(1) {
		switch(select("如何挑战:关于竞技场点数:我的当前竞技场点数:取消")) {
		case 1:
			mes "[文迪戈斯]";
			mes "竞技场有两种模式：^3131FF个人模式^000000 和 ^3131FF组队模式^000000。";
			next;
			mes "[文迪戈斯]";
			mes "^3131FF个人模式^000000 按角色等级 50～80 分为 4 个阶段。";
			mes "5 人队伍可以参加 ^3131FF组队模式^000000。";
			next;
			mes "[文迪戈斯]";
			mes "在 ^3131FF每个个人模式阶段^000000，超过该阶段等级要求 20 级的角色不能进入，防止高等级角色占用低等级阶段。";
			next;
			mes "[文迪戈斯]";
			mes "个人模式阶段 NPC 按顺时针方向排列。";
			mes "在聊天室等待时，会按等待顺序自动引导至竞技场房间。";
			break;
		case 2:
			mes "[文迪戈斯]";
			mes "让我说明 ^3131FF竞技场点数^000000。";
			mes "这是 ^3131FF成功完成竞技场阶段^000000 的奖励点数，每人最多拥有 30,000 点。";
			next;
			mes "[文迪戈斯]";
			mes "即使因超时或其他错误未完成阶段，也会获得少量竞技场点数。";
			next;
			mes "[文迪戈斯]";
			mes "关于竞技场点数的使用，";
			mes "我们通过名为吉武的 NPC 提供纪念照片等服务。";
			break;
		case 3:
			mes "[文迪戈斯]";
			mes "让我查看 "+strcharinfo(0)+"的当前竞技场点数。";
			next;
			mes "[文迪戈斯]";
			mes ""+strcharinfo(0)+" 共有 ^3131FF"+arena_point+"^000000 点。";
			next;
			mes "[文迪戈斯]";
			mes "想了解竞技场点数的使用方法，请查看第二项菜单 ^3131FF“关于竞技场点数”^000000。";
			break;
		case 4:
			mes "[文迪戈斯]";
			mes "好，那么，";
			mes "祝你";
			mes "玩得开心。";
			close;
		}
		next;
		mes "[文迪戈斯]";
		mes "还有什么";
		mes "我能帮你吗？";
		next;
	}
	close;

OnLineRec_50:
	mapannounce "arena_room",""+$arena_50topn$+" 刷新了竞技场 50 级限时战斗的最高纪录。恭喜！",0;
	end;

OnLineRec_60:
	mapannounce "arena_room",""+$arena_60topn$+" 刷新了竞技场 60 级限时战斗的最高纪录。恭喜！",0;
	end;

OnLineRec_70:
	mapannounce "arena_room",""+$arena_70topn$+" 刷新了竞技场 70 级限时战斗的最高纪录。恭喜！",0;
	end;
OnLineRec_80:
	mapannounce "arena_room",""+$arena_80topn$+" 刷新了竞技场 80 级限时战斗的最高纪录。恭喜！",0;
	end;

OnLineRec_pt:
	mapannounce "arena_room","组队模式的 "+$arena_pttopn$+" 刷新了竞技场限时战斗最高纪录。恭喜！",0;
	end;

//OnLineRec_vs:
//	mapannounce "arena_room","Party "+$040611_arn_vstopn$+" has renewed the top record in the Arena Time Force Battle. Congratulations!",0;
//	end;
}

arena_room,105,82,5	script	Arena Record Staff	57,{
	mes "[欧文·基尤夫]";
	mes "你好，我叫欧文·基尤夫";
	mes "负责竞技场各阶段玩家记录。";
	next;
	mes "[欧文·基尤夫]";
	mes "想查看各阶段最高纪录玩家吗？";
	mes "请选择下方菜单。";
	next;
	switch(select("50 级阶段:60 级阶段:70 级阶段:80 级阶段:组队阶段")) {
	case 1:
		mes "[欧文·基尤夫]";
		mes "当前竞技场 50 级阶段最高玩家是 ^3131FF"+$arena_50topn$+"^000000，最高纪录为 ^3131FF"+$top_50min+"^000000 分钟 ^3131FF"+$top_50sec+"^000000 秒。";
		close;
	case 2:
		mes "[欧文·基尤夫]";
		mes "当前竞技场 60 级阶段最高玩家是 ^3131FF"+$arena_60topn$+"^000000，最高纪录为 ^3131FF"+$top_60min+"^000000 分钟 ^3131FF"+$top_60sec+"^000000 秒。";
		close;
	case 3:
		mes "[欧文·基尤夫]";
		mes "当前竞技场 70 级阶段最高玩家是 ^3131FF"+$arena_70topn$+"^000000，最高纪录为 ^3131FF"+$top_70min+"^000000 分钟 ^3131FF"+$top_70sec+"^000000 秒。";
		close;
	case 4:
		mes "[欧文·基尤夫]";
		mes "当前竞技场 80 级阶段最高玩家是 ^3131FF"+$arena_80topn$+"^000000，最高纪录为 ^3131FF"+$top_80min+"^000000 分钟 ^3131FF"+$top_80sec+"^000000 秒。";
		close;
	case 5:
		mes "[欧文·基尤夫]";
		mes "当前最高队伍是 ^3131FF"+$arena_pttopn$+"^000000, 最高纪录为 ^3131FF"+$top_ptmin+"^000000 分钟 ^3131FF"+$top_ptsec+"^000000 秒。";
		close;
	}
}

arena_room,68,135,3	script	Helper Pat	726,{
	mes "[Pat]";
	mes "欢迎，欢迎。";
	mes "我是 50 级竞技场阶段的助手。";
	next;
	mes "[Pat]";
	mes "这是^3131FF等级 50 竞技场阶段^000000";
	mes "^FF0000等级 50^000000 至 ^FF0000等级 69^000000 的角色可以进入。";
	next;
	mes "[Pat]";
	mes "等级限制是为了防止高等级角色占用低等级竞技场阶段。希望你能理解。";
	mes "入场费为 1,000 Zeny。";
	next;
	mes "[Pat]";
	mes "让我介绍竞技场的游戏规则。";
	next;
	mes "[Pat]";
	mes "^3131FF在聊天室等待轮到你。^000000";
	mes "轮到你时，会自动传送到竞技场地图。";
	next;
	mes "[Pat]";
	mes "进入后会立即启动计时器，记录游戏时间。";
	mes "请按照^3131FF脚跟与脚尖^000000的指引行动。";
	next;
	mes "[Pat]";
	mes "你有^3131FF 5 分钟^000000战斗时间。";
	next;
	mes "[Pat]";
	mes "通关包括首领房间在内的所有房间后，会再次传送到^3131FF结束等候室^000000。";
	mes "只能在等候室停留^3131FF 1 分钟^000000，请尽快领取竞技场点数并离开。";
	next;
	mes "[Pat]";
		mes "在结束等候室停留超过 1 分钟会被强制送出，也不会获得竞技场点数。请记住。";
		next;
		mes "[Pat]";
	mes "希望你玩得开心。";
	close;
}


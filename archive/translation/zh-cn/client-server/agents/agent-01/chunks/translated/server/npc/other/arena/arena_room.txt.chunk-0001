arena_room,147,49,3	script	Helper Epin	727,{
	mes "[艾宾]";
	mes "你好，";
	mes "我是 80 级竞技场阶段的助手，我叫艾宾。";
	mes "我喜欢读书，今年 19 岁……咦？……你不想听我的事吗……？";
	next;
	emotion ET_CRY;
	mes "[艾宾]";
	mes "好吧……";
	next;
	mes "[艾宾]";
	mes "这是 ^3131FF等级 80 竞技场阶段^000000";
	mes "^FF0000等级 80^000000 至 ^FF0000等级 "+(checkre(0)?"160":"99")+"^000000 的角色可以进入。";
	next;
	mes "[艾宾]";
	mes "等级限制是为了防止高等级角色占用低等级竞技场阶段。希望你能理解。";
	mes "入场费为 1,000 Zeny。";
	next;
	mes "[艾宾]";
	mes "让我介绍竞技场的游戏规则。";
	next;
	mes "[艾宾]";
	mes "^3131FF在聊天室等待轮到你。^000000";
	mes "轮到你时，会自动传送到竞技场地图。";
	next;
	mes "[艾宾]";
	mes "进入后会立即启动计时器，记录游戏时间。";
	mes "请按照 ^3131FF阿克图斯^000000 的指引行动。";
	next;
	mes "[艾宾]";
	mes "你有 ^3131FF8 分钟^000000 战斗时间。";
	next;
	mes "[艾宾]";
	mes "通关包括首领房间在内的所有房间后，会再次传送到 ^3131FF结束等候室^000000。";
	mes "只能在等候室停留 ^3131FF1 分钟^000000，请尽快领取竞技场点数并离开。";
	next;
	mes "[艾宾]";
	mes "在结束等候室停留超过 1 分钟会被强制送出，也不会获得竞技场点数。请记住。";
	next;
	mes "[艾宾]";
	mes "希望你玩得开心。";
	close;
}

arena_room,158,93,5	script	Helper Lunic	828,{
	mes "[卢尼克]";
	mes "欢迎来到组队竞技场阶段。";
	mes "请仔细听我的介绍，";
	mes "因为组队竞技场阶段与个人模式阶段略有不同。";
	next;
	mes "[卢尼克]";
	mes "^3131FF组队竞技场阶段^000000";
	mes "^FF0000等级 10^000000 至 ^FF0000等级 "+(checkre(0)?"160":"99")+"^000000 的玩家可以进入。";
	next;
	mes "[卢尼克]";
	mes "必须等 5 名队伍成员全部进入房间后，竞技场才会开始。入场费为 1,000 Zeny。";
	next;
	mes "[卢尼克]";
	mes "让我介绍竞技场的游戏规则。";
	next;
	mes "[卢尼克]";
	mes "^3131FF和朋友组队，并在聊天室等待。^000000";
	mes "你必须事先组队。即使没有组队也能游玩，但会遇到很多不便。";
	next;
	mes "[卢尼克]";
	mes "还请记住，自动传送到竞技场房间的 5 名玩家，顺序按 ^FF0000进入聊天室^000000 的先后，而不是按 ^FF0000队伍^000000 顺序。";
	next;
	mes "[卢尼克]";
	mes "进入聊天室前，请先组成一支 ^3131FF5 人队伍^000000。";
	next;
	mes "[卢尼克]";
	mes "轮到你时，会被传送到一张有传送点和帮助 NPC 的小地图。";
	mes "如果和其他队伍的成员一起进入，请使用传送点离开地图，然后返回等候室。";
	next;
	mes "[卢尼克]";
	mes "如果和自己的队伍成员一起进入，请在小地图与帮助 NPC 对话继续。";
	mes "帮助 NPC 每次只能与 ^FF00001 名玩家^000000 对话。";
	next;
	mes "[卢尼克]";
	mes "NPC 会引导你和队伍成员进入真正的竞技场房间。";
	mes "但是，如果队伍中有人 ^3131FF没有足够的钱支付入场费，就会被传送到场外^000000。";
	next;
	mes "[卢尼克]";
	mes "还请注意，你在这张地图内最多只能停留 ^FF0000 1 分钟^000000。";
	next;
	mes "[卢尼克]";
	mes "进入竞技场地图后，会立即启动计算战斗时间的计时器。";
	mes "请按照 ^3131FF慢跑者^000000 的指引行动。";
	next;
	mes "[卢尼克]";
	mes "你有 ^3131FF10 分钟^000000 完成阶段，不过这并不容易，请合理利用时间。";
	next;
	mes "[卢尼克]";
	mes "通关包括首领房间在内的所有房间后，会再次传送到 ^3131FF结束等候室^000000。";
	mes "只能在等候室停留 ^3131FF1 分钟^000000，请尽快领取竞技场点数并离开。";
	next;
	mes "[卢尼克]";
	mes "在结束等候室停留超过 1 分钟会被强制送出，也不会获得竞技场点数。请记住。";
	next;
	mes "[卢尼克]";
	mes "另外，如果队伍创下地图通关新纪录，";
	mes "^3131FF队长^000000 可以记录 ^3131FF队伍名称^000000。";
	next;
	mes "[卢尼克]";
	mes "如果队伍有多名队长或没有队长，就无法写入 ^FF0000最高队伍纪录^000000。";
	mes "因此，强烈建议在进入竞技场地图前先组好一支队伍。";
	next;
	mes "[卢尼克]";
	mes "感谢你的聆听，";
	mes "希望你玩得开心。";
	close;
}

arena_room,158,82,1	script	Helper Lonik	828,{
	emotion ET_BEST;
	mes "[洛尼克]";
	mes "哒哒！我在这里！";
	next;
	mes "[洛尼克]";
	mes "你想知道里面有没有人，对吧？";
	next;
	mes "[洛尼克]";
	mes "我的答案是……";
	mes "……";
	if (getmapusers("force_1-2")) {
		emotion ET_O;
		mes "有！";
		mes "里面有人。";
		next;
		mes "[洛尼克]";
		mes "你最好再等一会儿！";
	} else {
		emotion ET_X;
		mes "没有！";
		mes "出发吧，祝你好运！";
	}
	close;
}

sec_in02,72,180,3	script	Arena Manager#arena	802,{
	set .@i, callfunc("F_GM_NPC",1357,0);
	if (.@i == -1) {
		mes "[竞技场管理员]";
		mes "命令已取消。";
		close;
	} else if (.@i == 0) {
		mes "密码错误。";
		close;
	} else {
		mes "[竞技场管理员]";
		mes "请选择一项。";
		next;
		switch(select("重启竞技场:重新排列排名时间")) {
		case 1:
			switch(select("等级 50:等级 60:等级 70:等级 80:组队模式")) {
			case 1:
				set .@arena,50;
				break;
			case 2:
				set .@arena,60;
				break;
			case 3:
				set .@arena,70;
				break;
			case 4:
				set .@arena,80;
				break;
			case 5:
				mes "[竞技场管理员]";
				mes "== 注意 ==";
				mes "你选择了重启组队竞技场阶段。";
				mes "要继续吗？";
				next;
				switch(select("是:否")) {
				case 1:
					donpcevent "Ponox::OnStart";
					mes "[竞技场管理员]";
					mes "竞技场阶段已成功重新启动。";
					close;

				case 2:
					mes "[竞技场管理员]";
					mes "命令已取消。";
					close;
				}
			}
			mes "[竞技场管理员]";
			mes "== 注意 ==";
			mes "你选择了重启等级 "+.@arena+" 竞技场阶段。";
			mes "要继续吗？";
			next;
			switch(select("是:否")) {
			case 1:
				donpcevent "Lv"+.@arena+" Waiting Room::OnStart";
				mes "[竞技场管理员]";
				mes "竞技场阶段已成功重新启动。";
				close;
			case 2:
				mes "[竞技场管理员]";
				mes "命令已取消。";
				close;
			}
		case 2:
			mes "[竞技场管理员]";
			mes "== 注意 ==";
			mes "^CE0000你选择了重新排列排名时间。除非发生严重问题，否则请不要这样做！^000000";
			next;
			mes "[竞技场管理员]";
			mes "确定要重新排列排名时间吗？";
			next;
			switch(select("否:是")) {
			case 1:
				mes "[竞技场管理员]";
				mes "呼～ :)";
				close;
			case 2:
				switch(select("等级 50:等级 60:等级 70:等级 80:组队模式")) {
				case 1:
					set .@min$,"$top50min";
					set .@sec$,"$top50sec";
					set .@mode$,"等级 50";
					break;
				case 2:
					set .@min$,"$top60min";
					set .@sec$,"$top60sec";
					set .@mode$,"等级 60";
					break;
				case 3:
					set .@min$,"$top70min";
					set .@sec$,"$top70sec";
					set .@mode$,"等级 70";
					break;
				case 4:
					set .@min$,"$top80min";
					set .@sec$,"$top80sec";
					set .@mode$,"等级 80";
					break;
				case 5:
					set .@min$,"$top_ptmin";
					set .@sec$,"$top_ptsec";
					set .@mode$,"组队";
					break;
				}
				mes "[竞技场管理员]";
	mes "（……真不知道我怎么会来做这种糟糕的工作……嘟囔……抱怨……）";
	next;
	mes "[维西斯]";
	mes "这是^3131FF等级 70 竞技场阶段^000000";
	mes "^FF0000等级 70^000000 至 ^FF0000等级 89^000000 的角色可以进入。";
	next;
	mes "[维西斯]";
	mes "等级限制是为了防止高等级角色占用低等级竞技场阶段。希望你能理解。";
	mes "入场费为 1,000 Zeny。";
	next;
	mes "[维西斯]";
	mes "让我介绍竞技场的游戏规则。";
	next;
	mes "[维西斯]";
	mes "^3131FF在聊天室等待轮到你。^000000";
	mes "轮到你时，会自动传送到竞技场地图。";
	next;
	mes "[维西斯]";
	mes "进入后会立即启动计时器，记录游戏时间。";
	mes "请按照^3131FF凯迪拉克^000000的指引行动。";
	next;
	mes "[维西斯]";
	mes "你有^3131FF 7 分钟^000000战斗时间。";
	next;
	mes "[维西斯]";
	mes "通关包括首领房间在内的所有房间后，会再次传送到^3131FF结束等候室^000000。";
	mes "只能在等候室停留^3131FF 1 分钟^000000，请尽快领取竞技场点数并离开。";
	next;
	mes "[维西斯]";
	mes "在结束等候室停留超过 1 分钟会被强制送出，也不会获得竞技场点数。请记住。";

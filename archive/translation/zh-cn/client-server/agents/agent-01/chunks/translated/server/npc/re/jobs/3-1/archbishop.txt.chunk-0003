job3_arch02,113,327,5	script	Valkyrie#arch_01	403,{
	if (getmercinfo(1)) {
		mes "[女武神]";
		mes "想和我交谈，必须先^3131FF取消与所有佣兵的契约^000000。";
		close;
	}
	mes "[女武神安古希尔德]";
	mes "恶魔总是努力扰乱人心。";
	mes "不用在意它们的低语。";
	next;
	mes "[女武神安古希尔德]";
	mes "总之，我能感觉到力量正在恢复。";
	mes "把你找到的东西给我看看。";
	next;
	mes "- 你把一段金色管子交给女武神。-";
	next;
	mes "[女武神安古希尔德]";
	mes "哦，是一段管子！";
	mes "收集碎片后，可以请求其他女武神帮助。";
	next;
	mes "[女武神安古希尔德]";
	mes "由于战斗激烈，我只能恢复少量能量。";
	mes "我要给你一张^3131FF新的古代卷轴^000000。";
	mes "它能帮助你寻找剩余碎片。";
	next;
	mes "[女武神安古希尔德]";
	mes "那么，我期待你的好消息。";
	close2;
	getitem 12382,1; //ValkyrieB_Scroll
	viewpoint 1,244,46,1,0xFFFF99;
	hideonnpc "Valkyrie#arch_01";
	donpcevent "#arch_2_start::OnEnable";
	end;
}

job3_arch02,244,46,5	script	Valkyrie#arch_02	403,{
	mes "[女武神安古希尔德]";
	mes "你找到剩余碎片了吗？";
	next;
	if (countitem(6154) < 2) {
		mes "[女武神安古希尔德]";
		mes "嗯？";
		mes "我能看到你身边的这块。";
		getitem 6154,2; //Broken_Horn_Pipe
		next;
	}
	mes "[女武神安古希尔德]";
	mes "好。";
	mes "我会修复损坏的号角管！";
	next;
	mes "[女武神安古希尔德]";
	mes "但战斗还没有结束。";
	mes "你还记得^3131FF岛中央的废弃神殿^000000吗？";
	mes "只有使用号角管才能完成它。";
	next;
	mes "[女武神安古希尔德]";
	mes "我能感觉到周围的空气越来越污浊。";
	mes "也能感受到漆黑暗影的寒冷。";
	mes "这次会很危险。";
	next;
	mes "[女武神安古希尔德]";
	mes "我送你一条项链作为礼物。";
	mes "但不知道它是否有用……";
	mes "保重。";
	mes "请快一点！";
	close2;
	getitem 2798,1; //Will_Of_Exhausted_Angel
	hideonnpc "Valkyrie#arch_02";
	donpcevent "#arch_3_start::OnEnable";
	end;
}

job3_arch02,279,234,0	script	#arch_end	139,7,7,{
	end;
OnTouch:
	donpcevent "#arch_3_01::OnKill";
	donpcevent "#arch_3_02::OnKill";
	donpcevent "#arch_3_03::OnKill";
	donpcevent "mob#arch_2::OnKill";
	hideoffnpc "Valkyrie Anguhilde#end";
	if (checkweight(1201,1) == 0 || (MaxWeight - Weight) < 2000) {
		mes "- 等一下！！-";
		mes "- 你携带的物品太多，-";
		mes "- 无法获得新物品。-";
		mes "- 请卸下一些物品-";
		mes "- 再来接受挑战。-";
		close;
	}
	if (ismounting()) {
		mes "你正在骑乘坐骑，";
		mes "所以无法转职。";
		mes "请卸下坐骑后再试一次！";
		close;
	}
	if (countitem(6154) < 2) {
		mes "[女武神安古希尔德]";
		mes "你收集齐我的号角管碎片了吗？";
		next;
		mes "[女武神安古希尔德]";
		mes "我知道你竭尽全力帮助我，但没有 2 个号角管碎片我什么也做不了。";
		next;
		mes "[女武神安古希尔德]";
		mes "那里可能很危险，我们回去吧。";
		close2;
		nude;
		if (countitem(2798))
			delitem 2798,(2798); //Will_Of_Exhausted_Angel
		delitem 6154,countitem(6154); //Broken_Horn_Pipe
		mapwarp "job3_arch02","job3_arch01",29,29;
		end;
	}
	mes "[女武神安古希尔德]";
	mes "终于完成了所有准备。";
	next;
	mes "女武神拿起号角管，朝天空吹响。";
	next;
	mes "呜—— —— —— ——";
	next;
	mes "呜—— —— ——";
	next;
	hideoffnpc "Valkyrie of the heavens";
	mes "[女武神安古希尔德]";
	mes "奥丁的援助！瓦尔哈拉的战士们！";
	mes "奥丁神的圣地被黑暗污染了！";
	next;
	mes "[天界女武神]";
	mes "别担心，安古希尔德。";
	mes "你的愿望已经传达到了瓦尔哈拉。";
	mes "正如你所愿，其他女武神已经驱除了恶魔。";
	next;
	mes "[女武神安古希尔德]";
	mes "女武神们！现在安全了吗？";
	next;
	mes "[天界女武神]";
	mes "是的，安古希尔德。";
	mes "虽然你曾因一场事故被驱逐，但奥丁说他正在重新考虑你的放逐。";
	next;
	mes "[女武神安古希尔德]";
	mes "啊！我可以回阿斯加德了！";
	next;
	mes "[天界女武神]";
	mes "别急着下结论。";
	mes "不过我想你会收到好消息。";
	next;
	mes "[女武神安古希尔德]";
	mes "向奥丁致敬！";
	mes "我感觉充满了恩典。";
	mes "如此明亮又温暖……";
	next;
	mes "- 嗖—— -";
	specialeffect EF_CLOAKING,AREA,"Valkyrie Anguhilde#end";
	hideonnpc "Valkyrie Anguhilde#end";
	emotion ET_HUK, playerattached();
	next;
	mes "[天界女武神]";
	mes "请放心。";
	mes "她去了她该去的地方。";
	next;
	mes "[天界女武神]";
	mes "我想你还没明白。";
	next;
	mes "[天界女武神]";
	mes "安古希尔德是很久以前就死去的女武神。";
	mes "你没看到被恶魔覆盖的神殿吗？";
	mes "遗憾的是，安古希尔德没能完成任务，最终倒下了。";
	next;
	mes "[天界女武神]";
	mes "这是不愿被认出的安古希尔德幻象。";
	mes "即使死后她也无法前往地狱，只能在持续的噩梦中挣扎。";
	next;
	mes "[天界女武神]";
	mes "但你的帮助让她得到了解脱。";
	mes "虽然这与现实不同，但现在她或许可以安息了。";
	next;
	mes "[天界女武神]";
	mes "人类，女武神欠你一个人情。谢谢。";
	mes "虽然不能如愿邀请你，但奥丁赐予的力量可以帮助你。";
	next;
	mes "[天界女武神]";
	mes "现在，回到你的世界吧。";
	mes "号角管的声音和鸟鸣会为你传开。";
	next;
	if (SkillPoint) {
		mes "使用完所有技能点才能继续。请用完所有技能点后再继续~";
		close;
	}
	mes "[天界女武神]";
	mes "永远不要忘记今天这种无私奉献的精神。";
	mes "希望有一天我们能在瓦尔哈拉再会。";
	nude;
	if (countitem(2798))
		delitem 2798,countitem(2798); //Will_Of_Exhausted_Angel
	delitem 6154,countitem(6154); //Broken_Horn_Pipe
	set job_arch,100;
	completequest 2191;
	getitem 5747,1; //Mitra
	getitem 2795,1; //Green_Apple_Ring
	jobchange roclass(eaclass()|EAJL_THIRD);
	close;
OnInit:
	disablenpc "#arch_end";
	end;
}


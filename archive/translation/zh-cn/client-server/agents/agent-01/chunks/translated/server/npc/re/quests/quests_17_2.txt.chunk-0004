	end;

OnInit:
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "isbegin_quest(17336) == 1" );
	end;
}

ba_maison,333,144,5	duplicate(dummy_cloaked_npc)	Worry#172nw01	4_EP17_SCISSORE

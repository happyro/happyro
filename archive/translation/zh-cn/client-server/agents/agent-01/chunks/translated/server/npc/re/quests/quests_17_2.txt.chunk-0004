ba_maison,245,206,5	script	Gabriel#172nw01	4_EP17_GUARD_B,5,5,{
	if (ep17_2_main < 10) {
		npctalk "只有获得授权的人才能进入此区域。", "", bc_self;
		end;
	}
	if (ep17_2_main == 14) {
		mes "[Gabriel]";
		mes "如果这是最后一个，请回去向<NAVI>[阿尔法]<INFO>ba_maison,74,150,0,0,0</INFO></NAVI>报告。";
		close;
	}
	mes "[Gabriel]";
	mes "有什么需要帮助的吗？";
	mes "这里只有获得授权的人员可以进入。";
	mes "请返回入口。";
	close;

OnTouch:
	if (checkweight(1000103,5) == 0) {
		mes "你携带的物品太多，无法继续交谈。";
		mes "请整理物品栏后再试。";
		close;
	}
	if (ep17_2_main < 10) {
		npctalk "只有获得授权的人才能进入此区域。", "", bc_self;
		end;
	}
	if (ep17_2_main < 13) {
		mes "[Gabriel]";
		mes "你好，冒险者。";
		close;
	}
	if (ep17_2_main == 13) {
		mes "[Gabriel]";
		mes "别再靠近了。";
		mes "这里只有获得授权的人员可以进入。";
		next;
		select( "哦，我是……" );
		mes "[Gabriel]";
		mes "我不关心那个。我不需要了解你的任何事。这里是禁区。举起手，别再靠近。";
		next;
		mes "[Gabriel]";
		mes "别想使用武器，我比你快得多。你从哪里来的？";
		next;
		select( "下水道，但是我……" );
		mes "[Gabriel]";
		mes "原来你是从下水道来的。那就站着别动，等我把你交给保安。";
		next;
		sleep2 1500;
		npctalk "呼叫，4 区。4 区。", "", bc_self;
		sleep2 2000;
		npctalk "保安办公室：这里是 4 区，完毕。", "", bc_self;
		sleep2 2000;
		npctalk "需要支援。7 区有入侵者，完毕。", "", bc_self;
		sleep2 2000;
		npctalk "保安办公室：目前所有入侵者都已击退。不再需要巡逻，完毕。", "", bc_self;
		sleep2 2000;
		npctalk "你在说什么？我面前明明就有一个！4 区！4 区？", "", bc_self;
		sleep2 2000;
		npctalk "保安办公室：……", "", bc_self;
		select( "我是宅邸的客人。" );
		mes "[Gabriel]";
		mes "客人？如果你是客人，我应该知道。";
		unittalk getcharid(3), "" + strcharinfo(0) + "：我说的是实话……";
		next;
		mes "[Gabriel]";
		mes "我马上确认。别离开原地。";
		progressbar_npc "00FF00",2;
		next;
		mes "[Gabriel]";
		mes "哦，你真的是客人？你是获准进入所有区域的特殊客人……抱歉是我弄错了。请原谅。";
		next;
		select( "真不敢相信。你突然袭击了我。" );
		mes "[Gabriel]";
		mes "袭击？我袭击了吗？我只是按照入侵者应对手册行动。哦，你觉得自己被袭击了吗？";
		next;
		select( "没有……" );
		mes "[Gabriel]";
		mes "再次为我的错误道歉。";
		mes "最近因为入侵者，我们保安更加警惕、敏锐。而且其中出现了一个低调却强烈抵抗的男人。";
		next;
		mes "[Gabriel]";
		mes "对了，你是怎么获得进入所有区域的许可的？通常普通客人只能进入非限制区域。";
		next;
		mes "[Gabriel]";
		mes "如果你是这么尊贵的客人，我应该早就收到你的资料了。";
		next;
		select( "因为中继器。" );
		mes "[Gabriel]";
		mes "中继器？这里的中继器运转正常……";
		next;
		mes "[Gabriel]";
		mes "等等，这不是信号问题，而是突然有^0000CD黑客频道^000000干扰它……对吧？";
		next;
		select( "黑客？" );
		mes "[Gabriel]";
		mes "你知道宅邸里的自动人偶通过中继器收发信号。有时人们会^0000CD入侵中继器^000000，试图控制自动人偶，或监视宅邸内部发生的事。";
		next;
		mes "[Gabriel]";
		mes "宅邸里仍有入侵者。";
		mes "我必须彻底搜查。";
		next;
		mes "[Gabriel]";
		mes "之前，入侵者因为一名在宅邸里四处闲逛的客人而暴露了，因为他们以为宅邸里没有这样的客人。";
		next;
		mes "[Gabriel]";
		mes "但这改变不了他们是入侵者的事实。与之前只是好奇的客人不同，他们潜入宅邸并实施了各种暴力行为。你不觉得他们像小偷吗？";
		next;
		mes "[Gabriel]";
		mes "" + strcharinfo(0) + "，如果你不想被宅邸里的其他自动人偶误会，尤其是在限制区域附近，就应该提前表明身份。";
		next;
		select( "这是最后一个。" );
		mes "[Gabriel]";
		mes "是这样吗？那我得赶快去处理中继器，失陪了。";
		mes "另外，这点东西不多，请收下作为赔礼。";
		next;
		mes "[Gabriel]";
		mes "如果这是最后一件，请向 <NAVI>[阿尔法]<INFO>ba_maison,74,150,0,0,0</INFO></NAVI> 回报。另外……欢迎来到瓦尔蒙特宅邸。如果需要帮助，尽管向任何自动人偶询问。";
		ep17_2_main = 14;
		erasequest 17337;
		setquest 17338;
		getitem 1000103,5;
		getexp 300000,0;	// note: ~exp. getbaseexp_ratio?
		close;
	}
	if (ep17_2_main == 14) {
		mes "[Gabriel]";
		mes "如果这是最后一件，请向 <NAVI>[阿尔法]<INFO>ba_maison,74,150,0,0,0</INFO></NAVI> 回报。";
		close;
	}
	end;

OnInit:
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "isbegin_quest(17337) == 1" );
	end;
}

ba_in01,221,116,0	script	#jh5_1hw	HIDDEN_WARP_NPC,2,2,{
	end;
OnTouch:
	if (ep17_2_main == 17 && (isbegin_quest(16442) == 1 || isbegin_quest(16443) == 1 || isbegin_quest(16444) == 1 || isbegin_quest(16445) == 1 || isbegin_quest(16453) == 1))
		cloakonnpcself( "Kaya Toss#jh5_1" );
	if (ep17_2_main >= 20 && ep17_2_main < 24)
		cloakonnpcself( "Kaya Toss#jh5_1" );
	if (ep17_2_main >= 24)
		cloakoffnpcself( "Tatio#jh5_1" );
	if (ep17_2_main == 25)
		cloakonnpcself( "Rookie#jh5" );
	end;
}

ba_in01,206,106,3	script	Philofontes#jh5_1	4_M_PHILOFONTES,{
	if (ep17_2_main < 15) {
		cutin "ep16_tes01",2;
		mes "[Tess]";
		mes "你能先去见阿尔法，再回到茶馆这里吗？";
		mes "看来你首先要做的是登记成为客人。";
		mes "- 之前的任务仍在进行。-";
		close3;
	}
	if (ep17_2_main == 15) {
		cutin "ep16_tes01",2;
		mes "[Tess]";
		mes "蒂恩，请再次确认真伪。";
		mes "这是政府在佣兵留在瓦尔蒙特宅邸时审查过的文件。";
		next;
		cutin "ep162_dn01",2;
		mes "[Dien]";
		mes "嗯……即使反复确认了很多次真伪。";
		mes "我也不确定我们的合作能进行到什么程度。";
		next;
		mes "[Dien]";
		mes "反复说同样的话，我有点累了。";
		next;
		cutin "",255;
		mes "（气氛不太好，先观察一下吧。）";
		next;
		cutin "ep16_tes01",2;
		mes "[Tess]";
		mes "你看看就会理解这份证据。";
		mes "这证明政府曾试图和佣兵交谈，但他们没有回应。";
		next;
		cutin "ep162_rds01",2;
		mes "[Ridsh]";
		mes "根本没有发生过那种谈话！你知道吗？政府没有任何人来找我们谈过。";
		mes "我已经说过没有了，你还要像鹦鹉一样追问多久才能知道真相？";
		next;
		cutin "ep162_rds02",2;
		mes "[Ridsh]";
		mes "你带来新文件时也是这样，你在撒谎！";
		mes "你已经多次对我们撒谎了！";
		next;
		cutin "ep16_tes03",2;
		mes "[Tess]";
		mes "你为什么会觉得我们会故意使用假文件……！";
		mes "啊，" + strcharinfo(0) + "，你什么时候来的？让你看到我丢脸的一面了。";
		next;
		mes "[Tess]";
		mes "我正在和反叛军的<NAVI>[长老们]<INFO>ba_in01,203,103,0,0,0</INFO></NAVI>交谈，但过去发生的事很难确认……";
		ep17_2_main = 16;
		erasequest 17381;
		setquest 16440;
		close3;
	}
	if (ep17_2_main == 16) {
		cutin "ep16_tes03",2;
		mes "[Tess]";
		mes "我正在和反叛军的<NAVI>[长老们]<INFO>ba_in01,203,103,0,0,0</INFO></NAVI>交谈，但他们很固执，也许是因为年纪大了。";
		next;
		cutin "ep162_rds02",2;
		mes "[Ridsh]";
		mes "嘿！你说谁年纪大？";
		close3;
	}
	if (ep17_2_main == 17) {
		cutin "ep16_tes01",2;
		mes "[Tess]";
		mes "冒险者，请去找宅邸管理者，查明佣兵住在瓦尔蒙特宅邸期间发生了什么。";
		close3;
	}
	if (ep17_2_main == 18) {
		npctalk "Tess：请注意里德什。", "", bc_self;
		end;
	}
	if (ep17_2_main == 19) {
		npctalk "Tess：我觉得凯娅·托斯有话要说。", "", bc_self;
		end;
	}
	if (ep17_2_main < 25) {
	 npctalk "Tess：我们所有人都被企业玩弄于股掌之间。", "", bc_self;
		end;
	}
	npctalk "Tess：谢谢你的所有帮助，冒险者。", "", bc_self;
	end;

OnInit:
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "isbegin_quest(17381) == 1" );
	end;
}

ba_in01,203,103,5	script	Dien#jh5_1	4_F_DIENE,{
	if (ep17_2_main < 16) {
		cutin "ep162_dn02",2;
		mes "[Dien]";
		mes "如果你想找高品质的茶，这座宅邸就是你要找的地方。";
		mes "我在艾因贝赫喝的茶也不差，但和这里的茶无法相比。";
		close3;
	}
	if (ep17_2_main == 16) {
		cutin "ep162_dn01",2;
		mes "[Dien]";
		mes "嗯……嘿，政府来的先生。既然你不相信我们说的话，为什么还一直索要证据？";
		next;
		cutin "ep162_dn03",2;
		mes "[Dien]";
		mes "我们把假文件拿给佣兵，让他们证明每一处错误。对此我们无话可说。";
		next;
		cutin "ep162_dn02",2;
		mes "[Dien]";
		mes "这是浪费时间。";
		mes "我宁愿找别的方法，而不是把时间浪费在自相矛盾的事情上。";
		next;
		cutin "ep16_tes02",2;
		mes "[Tess]";
		mes "……除了检查记录并写报告，还能有什么办法？";
		mes "你是说不能无条件相信政府制作的报告？";
		next;
		cutin "16loo_01",2;
		mes "[Rookie]";
		mes "能听我说一会儿吗？";
		next;
		mes "[Rookie]";
		mes "问题在于，记录本身的可信度不是吗？";
		mes "无论我们如何使用这份各执一词的记录，都无法达成一致。";
		next;
		cutin "ep16_tes02",2;
		mes "[Tess]";
		mes "……所以才发生了这种事。";
		next;
		cutin "16loo_01",2;
		mes "[Rookie]";
		mes "所以与其依赖政府记录，不如调查这里真正发生过的事？";
		next;
		mes "[Rookie]";
		mes "这里是佣兵战争的基地。如果亲眼调查，你可能会看到以前没见过的东西。";
		next;
		cutin "",255;
		select( "这是个好主意。" );
		cutin "16loo_01",2;
		mes "[Rookie]";
		mes "那么，谁能准确而生动地记住这里发生的事？";
		next;
		cutin "",255;
		if (select( "宅邸管理者。", "清洁机器人。" ) == 2) {
			cutin "16loo_03",2;
			mes "[Rookie]";
			mes "冒险者，清洁机器人只会回应人们说的话。";
			mes "啊，对了。宅邸管理者会记得！";
			next;
		}
		cutin "16loo_01",2;
		mes "[Rookie]";
		mes "没错，瓦尔蒙特宅邸管理者！虽然不是人类，但可能是更中立的资料来源。";
		next;
		cutin "ep162_rds02",2;
		mes "[Ridsh]";
		mes "幸运，你为什么不听我们说，反而站在政府那边？";
		next;
		cutin "ep16_tes01",2;
		mes "[Tess]";
		mes "这是合理的方法。但谁来作证？";
		mes "如果我说我来，你们也不会相信。";
		next;
		cutin "ep162_dn01",2;
		mes "[Dien]";
		mes "如果政府要我相信他们一直编造的谎言，那我就无法与你合作。";
		next;
		cutin "ep162_dn03",2;
		mes "[Dien]";
		mes "你怎么知道政府真的试图和佣兵交谈？又怎么知道佣兵拒绝了？你只是拿来了一份我们都不了解的证据。";
		next;
		cutin "ep16_tes03",2;
		mes "[Tess]";
		mes "长老们甚至不愿亲自出去调查……";
		mes "冒险者，你是长老们唯一会相信的人。";
		next;
		cutin "",255;
		select( "我会取得他们的许可。" );
		cutin "ep162_dn01",2;
		mes "[Dien]";
		mes "我相信冒险者至今为止所做的一切。";
		mes "冒险者，你能替我们听取管理者的证词吗？";
		next;
		cutin "ep16_tes01",2;
		mes "[Tess]";
		mes "冒险者的存在对双方都非常重要，在各方敌对势力活动的这里更是无可替代。";
		next;
		cutin "ep16_tes03",2;
		mes "[Tess]";
		mes "冒险者，请去找宅邸管理者，查明佣兵住在瓦尔蒙特宅邸期间发生了什么。";
		next;
		if (select( "接受。", "拒绝。" ) == 2) {
			cutin "ep16_tes02",2;
			mes "[Tess]";
			mes "你很忙，还是时机不对？";
			mes "你不喜欢我拜托的事吗？";
			mes "我不能强迫你。";
			close3;
		}
		cutin "ep162_dn02",2;
		mes "[Dien]";
		mes "谢谢你，冒险者。看来麻烦的工作又落到你身上了。";
		mes "我期待中立一方带来的真相。";
		close2;
		cutin "",255;
		ep17_2_main = 17;
		erasequest 16440;
		setquest 16441;
		setquest 16442;
		setquest 16443;
		setquest 16444;
		setquest 16445;
		end;
	}
	if (ep17_2_main == 17) {
		cutin "ep162_dn02",2;
		mes "[Dien]";
		mes "谢谢你，冒险者。看来麻烦的工作又落到你身上了。";
		mes "我期待中立一方带来的真相。";
		close3;
	}
	if (ep17_2_main == 18) {
		npctalk "蒂恩：能听听里德什的故事吗？", "", bc_self;
		end;
	}
	if (ep17_2_main == 19) {
		npctalk "蒂恩：听听企业方面怎么说。", "", bc_self;
		end;
	}
	if (ep17_2_main < 25) {
		npctalk "蒂恩：我现在无话可说，请原谅。", "", bc_self;
		end;
	}
	npctalk "蒂恩：茶香真好。要喝一杯吗？", "", bc_self;
	end;

OnInit:
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "isbegin_quest(16440) == 1" );
	end;
}

ba_in01,202,108,5	script	Rookie#jh5	4_M_ROOKIE,{
	if (ep17_2_main < 17) {
		npctalk "新人：嗯，我们取得了很大进展。全都多亏你的帮助，冒险者。", "", bc_self;
		end;
	}
	if (ep17_2_main == 17) {
		if (isbegin_quest(16442) == 1 || isbegin_quest(16443) == 1 || isbegin_quest(16444) == 1 || isbegin_quest(16445) == 1 || isbegin_quest(16453) == 1) {
			cutin "16loo_01",2;
			mes "[Rookie]";
			mes "管理者知道佣兵战争的真相。";
			mes "它们都是自动人偶，记忆清晰，也不会说谎。";
			next;
			mes "[Rookie]";
			mes "请听听它们对那段日子的叙述，冒险者。";
			close3;
		}
		cutin "16loo_01",2;
		mes "[Rookie]";
		mes "你已经听够管理者的证词了吗？";
		mes "现在告诉我们你听到的事实。";
		next;
		cutin "",255;
		select( "讲述神秘尸体的故事。" );
		cutin "16loo_03",2;
		mes "[Rookie]";
		mes "突然出现了一具尸体？你是什么意思？";
		emotion ET_SWEAT;
		next;
		cutin "ep162_dn03",2;
		mes "[Dien]";
		mes "据说发现的尸体既不是佣兵、宅邸员工，也不属于企业……你有具体情报吗？";
		next;
		cutin "",255;
		select( "交出具体资料。" );
		cutin "ep162_rds03",2;
		mes "[Ridsh]";
		mes "这个人看起来不像佣兵。这样的人为什么会在瓦尔蒙特宅邸附近并被杀？";
		next;
		cutin "ep16_tes01",2;
		mes "[Tess]";
		mes "等等……把资料也给我看看。";
		next;
		mes "[Tess]";
		mes "..................";
		mes "..................";
		emotion ET_SURPRISE, getnpcid(0,"Philofontes#jh5_1");
		next;
		cutin "ep162_dn01",2;
		mes "[Dien]";
		mes "这份资料有什么让你在意的地方吗？";
		next;
		cutin "ep16_tes01",2;
		mes "[Tess]";
		mes "我们知道这个人的身份。";
		mes "这个人是政府派去和佣兵谈判的专员之一。";
		next;
		mes "[Tess]";
		mes "据说专员被派出去后没有回来，后来被认定为失踪人员。";
		mes "但之后却被发现死在瓦尔蒙特宅邸。";
		next;
		cutin "16loo_01",2;
		mes "[Rookie]";
		mes "所以，你是说……一名去见佣兵的政府官员，在见到佣兵之前就被杀了……";
		next;
		mes "[Rookie]";
		mes "这是谁干的？";
		next;
		cutin "",255;
		switch( select( "企业。", "政府。", "佣兵。" ) ) {
		case 1:
			cutin "16loo_03",2;
			mes "[Rookie]";
			mes "……没有证据，冒险者。";
			mes "你的话让我很难受。";
			emotion ET_SWEAT;
			next;
			mes "[Rookie]";
			mes "我们应该更谨慎地谈论。";
			break;
		case 2:
			cutin "ep16_tes02",2;
			mes "[Tess]";
			mes "政府的人为什么要杀死他们派出去的人？";
			emotion ET_QUESTION, getnpcid(0,"Philofontes#jh5_1");
			next;
			cutin "ep16_tes03",2;
			mes "[Tess]";
			mes "即使是政府的对立方，也很难在不被瓦尔蒙特宅邸内佣兵和员工发现的情况下杀人。";
			break;
		case 3:
			cutin "ep162_dn03",2;
			mes "[Dien]";
			mes "不，佣兵甚至不知道那是政府的人。连尸体也是很晚才被发现。";
			emotion ET_SURPRISE, getnpcid(0,"Dien#jh5_1");
			next;
			mes "[Dien]";
			mes "不是佣兵。";
			break;
		}
		next;

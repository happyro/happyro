	if (lasagna_quest[1] == 14) {
		mes "[乘务长]";
		if (Class != Job_Summoner)
			mes "船长和大副在里面。你可以去见他们，也可以向他们询问航行安排。";
		else
			mes "船长室就在那边。船长很重视礼节和礼貌，千万别犯错。";
		close;
	}
	if (lasagna_quest[1] == 15) {
		mes "[乘务长]";
		mes "去见离这里最近的记录员吧。他很有趣，和他聊天会很开心。";
		close;
	}
	if (lasagna_quest[1] == 16) {
		mes "[乘务长]";
		mes "你见过记录员了吗？要不要去见见主厨？";
		close;
	}
	if (lasagna_quest[1] == 17) {
		mes "[乘务长]";
		mes "那么，你见过他们所有人了吗？";
		npctalk "他们都是好人。", "", bc_self;
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "没有。我没能找到所有人。";
		next;
		mes "[乘务长]";
		mes "我想也是。他们一定在某处喝卡卢格纳牛奶、打着呼噜。启航时他们会回来，到时候你就能见到他们了……";
		npctalk "反正启航时他们会回来的。", "", bc_self;
		next;
		mes "[乘务长]";
		mes "你手里拿的不是^0000cd卡卢格纳^000000吗？不是谁都能拥有它的。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "入口检票的人让我把它交给主厨。";
		next;
		mes "[乘务长]";
		mes "那你为什么不交给主厨？快把它交给他！";
		npctalk "快把它交给主厨！", "", bc_self;
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "是，是！";
		erasequest 14535;// To Purser
		setquest 14536;// Delivery to Chef
		lasagna_quest[1] = 18;
		close;
	}
	if (lasagna_quest[1] == 18) {
		mes "[乘务长]";
		mes "你把东西交给主厨了吗？材料要趁新鲜送到！厨房就在走廊尽头。";
		close;
	}
	if (lasagna_quest[1] == 19) {
		mes "[乘务长]";
		mes "嗯，我们遇到问题了。";
		npctalk "喵喵喵……出问题了。", "", bc_self;
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "我已经交出去了。水手长想知道什么时候发布^0000cd航行信号^000000。";
		next;
		mes "[乘务长]";
		mes "我刚才也在想这件事。你已经为冒险接受充分训练了吗？在启程前不想^0000cd测试一下自己的力量^000000吗？";
		npctalk "出发冒险前测试力量非常重要。", "", bc_self;
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "我能帮你吗？";
		next;
		mes "[乘务长]";
		mes "看看拉斯格纳。你觉得怎么样？";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "我觉得这是一个充满活力、幸福快乐的村庄！";
		next;
		mes "[乘务长]";
		mes "这不是我想听的。看看我们即将探索的海域。";
		npctalk "不必说那些没必要的话。", "", bc_self;
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "雾……？";
		next;
		mes "[乘务长]";
		mes "是的。海上的^0000cd雾^000000，海雾。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "如果有魔物从雾中冲出来，我也不会惊讶。我还闻到了烟味。附近最近有火山喷发吗？";
		next;
		mes "[乘务长]";
		mes "由于海雾，我们无法发布航行信号。去问^0000cd大副^000000航行安排是否改变了，如果有问题就解决它。";
		npctalk "只有大副才能判断我们能否前往新大陆。", "", bc_self;
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "什么？我昨天已经完成训练了。";
		next;
		mes "[乘务长]";
		mes "我们不是在做慈善。我们训练有潜力的多拉姆，把他们送往新大陆，为多拉姆这个名字带来荣耀。这就是训练你们的原因。";
		next;
		mes "[乘务长]";
		mes "把它当作你在新大陆会遇到的各种困难的热身吧。";
		npctalk "大副就在那边的船长室。", "", bc_self;
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "是！";
		erasequest 14537;// When do we take off?
		setquest 14538;// Can we take off?
		lasagna_quest[1] = 20;
		close;
	}
	if (lasagna_quest[1] == 20) {
		mes "[乘务长]";
		mes "大副在船长室。去问他海雾是否会改变航行安排！";
		close;
	}
	if (lasagna_quest[1] == 21) {
		mes "[乘务长]";
		mes "我想我们会因为雾气无法出发。";
		close;
	}
	if (lasagna_quest[1] == 28) {
		mes "[乘务长]";
		if (Class != Job_Summoner)
			mes "进展如何？请向大副斯特洛报告。";
		else
			mes "去向大副报告吧。";
		close;
	}
	if (lasagna_quest[1] == 29) {
		mes "[乘务长]";
		if (Class != Job_Summoner)
			mes "祝你航行顺利。";
		else
			mes "很高兴你已经像一名成熟的多拉姆一样工作了。";
		close;
	}
	mes "[乘务长]";
	mes "启航前我应该检查货物。";
	close;

OnInit:
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "isbegin_quest(14531) == 1" );
	end;
}

conch_in,52,60,0	script	#dorcon95	HIDDEN_WARP_NPC,1,1,{
	end;
OnTouch:
	if (lasagna_quest[1] != 14)
		npctalk "- Knock knock -", "", bc_self;
	end;
}

// in A_B
conch_in,24,62,5	script	Stello#dorcon	4_DR_STELO,{
	if (checkweight(1001,4) == 0) {
		mes "[斯特洛]";
		mes "看起来又多又大。减少一些怎么样？";
		close;
	}
	if (lasagna_quest[1] < 14) {
		mes "[斯特洛]";
		mes "你是谁？没有许可不准进入这里。请离开。";
		close;
	}
	if (lasagna_quest[1] == 14) {
		mes "[斯特洛]";
		mes "你来这里做什么？是来见船长的吗？如果不是，请离开。你不该待在这里。";
		close;
	}
	if (lasagna_quest[1] < 20) {
		mes "[斯特洛]";
		mes "记住这一点。和这艘船的船员打交道时要注意礼貌。";
		close;
	}
	if (lasagna_quest[1] == 20) {
		mes "[" + strcharinfo(0) + "]";
		mes "尊敬的大副！";
		next;
		mes "[斯特洛]";
		mes "怎么回事？";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "乘务长让我确认，在浓厚的^0000cd海雾^000000中启航是否会有问题。";
		npctalk "是雾！", "Captain Gamberi#dorcon0", bc_self;
		npctalk "没错。", "", bc_self;
		next;
		mes "[斯特洛]";
		mes "嗯……这片雾一定是……";
		next;
		mes "[甘贝里船长]";
		mes "又是^0000cd那个东西^000000。";
		next;
		mes "[斯特洛]";
		mes "是的，又来了。嗯，我们该怎么办？没人能派过去，大家都忙着准备启航。";
		npctalk "真麻烦。", "", bc_self;
		next;
		mes "[甘贝里船长]";
		mes "斯特洛，我想你应该亲自下去。";
		npctalk "没有别的办法了。", "Captain Gamberi#dorcon0", bc_self;
		next;
		mes "[斯特洛]";
		mes "那就派蛋灵去吧。";
		next;
		mes "[甘贝里船长]";
		mes "蛋灵还没准备好处理这件事。想想为什么它还叫蛋灵。";
		next;
		mes "[斯特洛]";
		mes "……看来我应该去。可恶。";
		npctalk "他只会让事情变得更糟。", "", bc_self;
		next;
		mes "[甘贝里船长]";
		mes "斯特洛，绅士无论何时都应该使用得体的语言。";
		npctalk "我该出发了。哦，亲爱的。", "", bc_self;
		npctalk "斯特洛？", "Captain Gamberi#dorcon0", bc_self;
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "嗯……乘务长派我来处理问题。";
		next;
		emotion ET_SURPRISE;
		emotion ET_SURPRISE, getnpcid(0, "Captain Gamberi#dorcon0");
		mes "[斯特洛]";
		mes "这里有一个。";
		next;
		mes "[甘贝里船长]";
		mes "一个训练有素的。";
		next;
		mes "[斯特洛]";
		mes "多拉姆。";
		next;
		mes "[甘贝里船长]";
		mes "就在我们面前。";
		npctalk "是的，这里有一个。", "", bc_self;
		next;
		emotion ET_SWEAT, playerattached();
		mes "[斯特洛]";
		mes "很好。就把这当作启航前的最后训练。";
		next;
		mes "[甘贝里船长]";
		mes "斯特洛，我们面对的是已经完成冒险训练的多拉姆，称之为最后训练不合适。应该叫第一次实践。";
		next;
		mes "[斯特洛]";
		mes "叫什么都行。好吧，我会把第一项任务作为你的第一次实践。";
		npctalk "屁股和臀部有那么大的区别吗？", "", bc_self;
		next;
		mes "[斯特洛]";
		mes "我们即将航行的海路^0000cd并不普通^000000。你需要观察星辰和风的动向，走一条地图上没有标记、甚至让你怀疑能否找到陆地的路线。";
		next;
		mes "[斯特洛]";
		mes "所以我们必须驱散阻碍我们观察太阳和风的所有雾气。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "我们能驱散雾气吗？";
		next;
		mes "[斯特洛]";
		mes "如果是普通的雾，只要等它散去就行。不过有^0000cd某种东西导致了这片雾^000000，问题可以解决。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "有东西导致雾气？难道有反派参与？真刺激！";
		next;
		mes "[斯特洛]";
		mes "不完全是。附近洞窟里住着一条龙。它喷出的火焰会烧毁周围一切，雾就是烟形成的。";
		npctalk "我想你一定读过很多冒险小说，亲爱的冒险者。", "", bc_self;
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "难怪雾闻起来像烟。";
		next;
		mes "[斯特洛]";
		mes "警卫队一直监控龙的状况。请去见^0000cd守卫村庄南桥的警卫^000000，确认龙的状态。";
		next;
		mes "[斯特洛]";
		mes "如果你需要帮助，也请协助他们阻止龙喷火。";
		next;
		mes "[甘贝里船长]";
		mes "能否启航取决于你的行动，亲爱的冒险者。去完成你的第一个任务吧！";
		next;
		mes "[斯特洛]";
		mes "等等，把这个带上。紧急时会派上用场。请小心！";
		erasequest 14538;// Can we take off?
		setquest 14539;// Crazy Dragon
		getitem 569,30;// Novice Potion
		getitem 12323,20;// Novice Fly Wing
		lasagna_quest[1] = 21;
		close;
	}
	if (lasagna_quest[1] < 28) {
		mes "[斯特洛]";
		mes "向警卫询问龙的情况，如果发生问题，就和警卫队一起解决。";
		close;
	}
	if (lasagna_quest[1] == 28) {
		mes "[" + strcharinfo(0) + "]";
		mes "尊敬的大副！";
		next;
		mes "[斯特洛]";
		mes "你来了。我们刚才还在谈论你。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "你们在谈什么？";
		next;
		mes "[甘贝里船长]";
		mes "我们在想是不是得下去把你的尸体带回来……";
		emotion ET_HUK;
		emotion ET_HUK, playerattached();
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "什么？任务有那么危险吗？";
		next;
		mes "[斯特洛]";
		mes "完全不是。船长，你在说什么？";
		npctalk "他有时会面不改色地说出这种血腥的话。", "", bc_self;
		next;
		mes "[甘贝里船长]";
		mes "斯特洛，这叫玩笑。";
		npctalk "绅士应该有幽默感。", "Captain Gamberi#dorcon0", bc_self;
		next;
		mes "[斯特洛]";
		mes "玩笑应该让双方都愉快。这只是诅咒。";
		npctalk "至少你吓到我了。", "", bc_self;
		next;
		mes "[甘贝里船长]";
		mes "斯特洛，你必须学习一种叫社交礼仪的东西。";
		next;
		mes "[斯特洛]";
		mes "这个以后再谈。我正好奇你什么时候回来。雾散后，我们知道你成功了，亲爱的冒险者。谢谢你的努力。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "这对我来说是一次很棒的经历。";
		next;
		mes "[甘贝里船长]";
		mes "斯特洛，你应该大方地赞美别人，就像我赞美你一样。";
		next;
		mes "[斯特洛]";
		mes "哦，对了。让我们为完成任务归来的冒险者热烈鼓掌！";
		npctalk "哇。啪啪啪啪。", "", bc_self;
		npctalk "斯特洛？你得认真一点。", "Captain Gamberi#dorcon0", bc_self;
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "哦，对。嗯，谢谢。";
		next;
		if (Class != Job_Summoner) {
			mes "[甘贝里船长]";
			mes "那么，是时候发布航行信号了。";
			next;
			mes "[甘贝里船长]";
			mes "所有人就位！现在启航！";
			next;
			mes "[呜——]";
			completequest 14554;// We can start sail now
		}
		else {
			mes "[甘贝里船长]";
			mes "斯特洛，把^0000cd那个^000000交给冒险者。";
			next;
			mes "[斯特洛]";
			mes "那个？你说的是什么？";
			next;
			mes "[甘贝里船长]";
			mes "离开拉斯格纳时，金钱买不到的东西。";
			npctalk "哦，那个！我一定把它放在附近了……", "", bc_self;
			next;
			mes "[" + strcharinfo(0) + "]";
			mes "鳀鱼？";
			next;
			mes "[斯特洛]";
			mes "哦！你怎么知道？";
			emotion ET_HUK;
			next;
			mes "[" + strcharinfo(0) + "]";
			mes "我已经收到一些了，不需要更多。";
			next;
			mes "[斯特洛]";
			mes "真的吗？那你可能也不需要这个。真遗憾。我本来为你准备的，现在看来它属于别人了。";
			next;
			mes "[" + strcharinfo(0) + "]";
			mes "什么……那是什么？";
			next;
			mes "[斯特洛]";
			mes "这是法法雷警卫队队长和康奇莉娜船长为庆祝新手冒险者完成首次任务准备的小礼物。";
			next;
			mes "[" + strcharinfo(0) + "]";
			mes "一顶帽子和一枚戒指？";
			next;
			mes "[斯特洛]";
			mes "帽子是佩佩罗奇诺听完你的故事后准备的。多拉姆冒险者应该有一顶帽子，它会带给你好运。";
			next;
			mes "[斯特洛]";
			mes "戒指是船长准备的。亲爱的船长？";
			next;
			mes "[甘贝里船长]";
			mes "这枚戒指会帮助你作为新手冒险者积累特殊经历。";
			next;
			mes "[甘贝里船长]";
			mes "它会伴随你成长，直到你不再需要帮助。成为老练的冒险者后，它会失去力量，变成普通的草制戒指。";
			next;
			mes "[斯特洛]";
			mes "哦，我应该给你一个放大镜。拿到未鉴定的武器或装备时，可以用它检查。";
			next;
			mes "[斯特洛]";
			mes "我会给你一些所有来过拉斯格纳的多拉姆都渴望的^0000cd卡卢格纳牛奶^000000。非常感谢你的努力。";
			emotion ET_DELIGHT;
			next;
			mes "[甘贝里船长]";
			mes "那么，是时候发布航行信号了。";
			next;
			mes "[甘贝里船长]";
			mes "所有人就位！现在启航！";
			next;
			mes "[呜——]";
			completequest 14544;// Now I can leave
			getexp 500,500;
			getitem 19084,1;// Parfaille Vigilante Hat [1]
			getitem 28374,1;// Foxtail Ring
			getitem 11601,50;// Delicious Anchovy
			getitem 12325,20;// Novice Magnifier
		}
		getitem 22984,5;// Kahluna Milk
		lasagna_quest[1] = 29;
		close2;
		warp "izlude",193,209;
		end;
	}
	if (lasagna_quest[1] == 29) {
		mes "[斯特洛]";
		if (Class != Job_Summoner)
			mes "如果有一天能离船，我想去探索新大陆。";
		else {
			mes "新大陆是什么样的？我该不该请假去冒险？";
			next;
			mes "[甘贝里船长]";
			mes "胡说！谁来负责通往新大陆的航路？";
			next;
			mes "[斯特洛]";
			mes "我只是说说……说出来又不会受伤。";
		}
		close;
	}
}

conch_in,26,64,5	script	Captain Gamberi#dorcon0	4_DR_GAMBERI,{
	if (lasagna_quest[1] < 14) {
		mes "[甘贝里船长]";
		mes "记得敲门。注意礼貌。";
		close;
	}
	if (lasagna_quest[1] == 14) {
		if (Class != Job_Summoner) {
			mes "[甘贝里船长]";
			mes "斯特洛，我说过你的穿着体现你是哪种多拉姆。请调整你的服装。";
			next;
			mes "[斯特洛]";
			mes "这太重、太紧又烦人了，实在不舒服。";
			next;
			mes "[甘贝里船长]";
			mes "你必须克服不便，才能保持正确姿势。正确姿势是成为绅士的第一步。明白吗，斯特洛？";
			next;
			emotion ET_OK;
			mes "[甘贝里船长]";
			mes "斯特洛，再说一遍。";
			npctalk "斯特洛？", "", bc_self;
			next;
			mes "[斯特洛]";
			mes "是，先生。";
			npctalk "他总是非得听到答案吗？", "Stello#dorcon", bc_self;
			npctalk "斯特洛？", "", bc_self;
			next;
			mes "[" + strcharinfo(0) + "]";
			mes "不好意思。";
			next;
			mes "[斯特洛]";
			mes "你是谁？没有许可不准进入这里。请离开。";
			next;

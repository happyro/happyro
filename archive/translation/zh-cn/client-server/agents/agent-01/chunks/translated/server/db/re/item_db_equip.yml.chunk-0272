      .@r = getrefine();
      bonus bMaxHP,.@r*10;
      bonus bCritical,5+2*(.@r/3);
      bonus bCRate,(.@r/3);
      if (.@r>=7) {
         bonus bCritical,3;
         bonus bAspd,1;
         if (.@r>=9) {
            bonus bCritAtkRate,5;
            bonus bAspdRate,8;
            if (.@r>=10) {
               bonus bCritAtkRate,3;
               bonus bCRate,3;
            }
         }
      }
  - Id: 24768
    AegisName: S_Mega_Blitz_Weapon
    Name: 超级闪电影子武器
    Type: ShadowGear
    Locations:
      Shadow_Weapon: true
    Refineable: true
    Script: |
      .@r = getrefine();
      bonus bBaseAtk,.@r;
      bonus bMatk,.@r;
      bonus bAspdRate,5;
      bonus bDelayrate,-(.@r/2);
      if (.@r>=7) {
         bonus bAspdRate,5;
         bonus bAspd,1;
         if (.@r>=9) {
            bonus bDelayrate,-2;
            if (.@r>=10) {
               bonus bPAtk,2;
               bonus bSMatk,2;
            }
         }
      }
  - Id: 24770
    AegisName: S_EXP_Weapon
    Name: 经验影子武器
    Type: ShadowGear
    Locations:
      Shadow_Weapon: true
    Refineable: true
    Script: |
      .@r = getrefine();
      bonus bBaseAtk,.@r;
      bonus bMatk,.@r;
      if (BaseLevel<175) {
         bonus2 bExpAddRace,RC_All,20;
      }
      if (BaseLevel>=175) {
         bonus2 bExpAddRace,RC_All,10;
      }
      if (.@r>=10) {
         bonus2 bExpAddRace,RC_All,5;
      }
      bonus2 bExpAddRace,RC_All,(.@r/2);

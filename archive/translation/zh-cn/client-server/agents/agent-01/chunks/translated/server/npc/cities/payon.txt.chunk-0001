payon,246,154,0	script	Lady#payon	90,{
	mes "[Lady]";
	mes "很久以前，帕扬还在发展时，";
	mes "许多村民生活在贫困中。";
	next;
	mes "[Lady]";
	mes "许多家庭为了生存苦苦挣扎，甚至常常无力妥善安葬死者。有人把死者丢进村庄附近的洞穴。";
	next;
	mes "[Lady]";
	mes "据说那座洞穴里有许多游荡的僵尸，";
	mes "它们无法安息，也无法前往来世。";
	next;
	mes "[Lady]";
	mes "僵尸感受到人类的温暖后就会发起攻击，但这并不意味着不死族对活人怀有仇恨。";
	next;
	mes "[Lady]";
	mes "它们腐烂的身体无法离开阴冷、黑暗、潮湿的洞穴，因此攻击能加速身体腐烂的温暖只是本能。";
	next;
	mes "[Lady]";
	mes "帕扬洞穴里的僵尸虽然吓人，";
	mes "但它们的故事也有些悲惨。";
	close;
	}
	
	payon,134,211,4	script	Young Man#payon	59,{
	mes "[Young Man]";
mes "从你的装束来看，";
mes "你应该是外地人。";
mes "欢迎来到帕扬。";
	next;
	mes "[Young Man]";
	mes "你一定是经验丰富的战士，否则不可能穿过环绕城市的险峻山地和危险生物来到这里。";
	next;
	mes "[Young Man]";
	mes "我不擅长战斗，但有人告诉过我，单靠蛮力无法赢得某些战斗。";
	next;
	mes "[Young Man]";
	mes "有时你会遇到受到硬壳保护的生物，物理攻击无法伤害它们。只有魔法之类的精神力量才能轻易击败它们。";
	next;
	mes "[Young Man]";
	mes "当然，不是每个人都能学习魔法。重点是要结交各种各样的朋友和同伴，因为你不可能独自应对所有情况。";
	close;
	}
	
	payon,173,82,0	script	Young Man#2payon	88,{
	mes "[Young Man]";
	mes "我记得已故祖父曾给我讲过的故事。";
next;
mes "[Young Man]";
mes "那是关于一枚拥有邪恶力量的护身符。";
	mes "用它可以让死者";
	mes "从坟墓中苏醒。";
	next;
	mes "[Young Man]";
	mes "我不知道这是真是假。不过，如果用它把祖父从另一个世界召唤回来，会发生什么呢……";
	next;
	mes "[?]";
mes "^3299CC别想";
	mes "别想这种事……";
	mes "我的孩子。^000000";
	next;
	mes "[Young Man]";
	mes "呀啊啊——！";
	mes "那是什么？！";
	mes "祖、祖父……？";
	next;
	mes "...";
	next;
	mes "...";
	mes "......";
	mes "[Young Man]";
	mes "...";
	mes "神、神啊……？";
	close;
	}
	
	payon,158,246,3	script	Guardsman#payon	708,3,3,{
	end;
	
	OnTouch_:
mes "[Guardsman]";
mes "这里是帕扬中央宫殿。宫殿向公众开放，但依照法律，进入后必须遵守秩序。";
next;
	mes "[Guardsman]";
mes "为了维护和平，进入后我们会卸下你的装备。";
mes "感谢你的合作。";
	nude;
	close;
	}
	
	payon,249,156,1	script	Woman#payon	66,{
	mes "[Woman]";
	mes "欢迎来到帕扬。";
	mes "穿过帕扬森林一定很辛苦。";
	mes "旅途还顺利吗？";
next;
mes "[Woman]";
mes "由于城外的怪物越来越多，游客也减少了，所以最近安静多了。";
	next;
	mes "[Woman]";
	mes "说实话，那些怪物让日子越来越难过。^666666*叹气……*^000000";
	next;
	mes "[Woman]";
	if (Sex == SEX_MALE)
	mes "哇~！我刚注意到你的手臂很结实。你看起来很强壮，杀过多少怪物啊？！";
	else
	mes "哦！之前没注意到，原来你柔美的外表下也很强壮。";
	next;
	mes "[Woman]";
	mes "嘿，我知道一个适合狩猎的好地方。正好帕扬中央有一座洞穴。";
	next;
	mes "[Woman]";
	mes "如果感兴趣，就向北穿过森林，再往西北走。闻到臭怪物气味的地方就是了。";
		next;
	switch(select("听起来很危险！:我最好先准备一下……！:你穿的裙子真漂亮~")) {
		case 1:
	mes "[Woman]";
	mes "拜托，别当胆小鬼。";
	mes "那只是充满普通怪物的洞穴，很安全。我们还在附近建立了弓箭手村，防止意外。呵呵呵呵~";
	break;
	case 2:
	mes "[Woman]";
	mes "不用担心准备工作。洞穴正前方就有工具商，你可以从我丈夫，也就是那家伙那里买到所需物品~";
	break;
	case 3:
		mes "[Woman]";
		mes "哦呵呵呵呵！";
		mes "你注意到了？";
		mes "听说这是最近";
	mes "普隆德拉最流行的款式。";
		next;
		mes "[Woman]";
		mes "镇上的大多数女人都不懂时尚！我丈夫买来送给我。";
	mes "你知道的，他赚了不少钱。呵呵呵呵~";
		break;
		}
		close;
		}
		
		payon,246,158,5	script	Woman#2payon	66,0,0,{
		mes "[Jim's Mother]";
		mes "哎呀~";
		mes "她又开始了。";
		mes "毫无疑问，那个女人";
		mes "就是镇上的长舌妇。";
	next;
	mes "[Jim's Mother]";
mes "请不要因为她的行为";
mes "就评判帕扬的其他居民。她只是个大嘴巴，可能是算命师的话让她太兴奋了。";
next;
	mes "[Jim's Mother]";
	if (Sex == SEX_MALE) {
	mes "哦……！";
	mes "你的肩膀真宽！";
	mes "愿意和我约会吗？";
	mes "我请你吃顿美餐~";
	}
	else {
	mes "哎呀，你真是个漂亮女孩！";
	mes "我想你总是忙着用棍子";
	mes "赶走男孩……";
	mes "或者用恰到好处的挖苦。";
		}
		next;
		if (select("算命师……？:那先这样~") == 1) {
		mes "[Jim's Mother]";
		mes "哦，对了……";
		mes "帕扬中央宫殿里有一位非凡的算命师。给她的 Zeny 越多，得到的运势越好！";
	next;
	mes "[Jim's Mother]";
		mes "她说我这个月";
		mes "会遇到一个好男人。";
		mes "呵呵呵呵~";
		close;
	}
	mes "[Jim's Mother]";
	mes "嗯……？";
		mes "你没时间留下来";
		mes "和我聊聊天吗？";
		close;
		}
		
		payon,210,110,1	script	Drunkard#payon	120,{
		if (Class != Job_Archer) {
		mes "[Drunkard]";
		mes "嘿……";
		mes "嘿、嘿……！";
	next;
	mes "[Drunkard]";
	mes "我真不懂那些笨弓箭手";
	mes "为什么还费心瞄准！";
	mes "你们都很弱！";
	mes "弱爆了！";
	next;
mes "[Drunkard]";
mes "哇哈哈哈哈！";
mes "请我喝一杯？！";
	} else {
		mes "[Drunkard]";
		mes "弓箭手！";
		mes "天啊，你们真棒！";
		mes "你们是最好的！";
		next;
		mes "[Drunkard]";
		mes "哇哈哈哈哈！";
		mes "请我喝一杯？！";
		}
		next;
		switch(select("好吧，但只喝一杯。:不用了，朋友。:我的天！绝对不要！")) {
		case 1:
		set Zeny, (Zeny < 100)?0:(Zeny - 100);
		mes "[Drunkard]";
	mes "谢谢……！";
		mes "……兄弟！";
		next;
		mes "[Drunkard]";
		mes "大多数人根本不想请我喝酒！";
		mes "也许是因为我年轻时太爱和女士们鬼混了！";
		next;
		mes "[Drunkard]";
		mes "不过，我以前玩弄的女人现在都成了老太太！哈哈哈！其中一个还在化妆打扮！你敢相信吗？！";
	next;
	mes "[Drunkard]";
	mes "我就想说……";
	mes "拜托……！";
		mes "有些脸已经";
		mes "无可救药了！";
		mes "哦？我讲了个笑话！";
		mes "哇哈哈哈哈哈！";
		next;
		mes "[Drunkard]";
mes "^666666*咕噜~ 咕噜~*^000000";
		mes "伙计，这太棒了！";
		mes "你真是个大好人~！";
		mes "呜哈哈哈哈！";
		break;
		case 2:
		mes "[Drunkard]";
		mes "呸！";
		mes "现在的年轻人！";
		mes "一点也不尊敬长辈！算了！";
		mes "我才不会求你！";
		break;
		case 3:
		mes "[Drunkard]";
		mes "好吧……！";
		mes "随你便！";
		break;
		}
		close;
		}
	
		payon,132,235,3	script	Monster Scholar#02	98,{
		mes "[Monster Scholar Vuicokk]";
		mes "很高兴见到你。";
		mes "我叫 Vuicokk。";
		mes "我是卢恩-米德加尔特王国怪物研究组织的学者。你有关于怪物的问题吗？";
		next;
		switch(select("有什么新闻吗？:不死族怪物？:怪物研究组织？")) {
	case 1:
		mes "[Monster Scholar Vuicokk]";
		mes "帕扬位于森林深处，很容易遭到大群怪物袭击。怪物也会从城镇附近的危险洞穴出现。";
		next;
		mes "[Monster Scholar Vuicokk]";
	mes "由于不死族怪物在帕扬洞穴游荡，这里吸引了怪物学界的注意。我的工作是分析它们的特征。";
	break;
case 2:
mes "[Monster Scholar Vuicokk]";
mes "帕扬不死族怪物最令人惊讶的是它们的起源：大多数曾经是帕扬居民！";
	next;
	mes "[Monster Scholar Vuicokk]";
	mes "然而，这些灵魂无法安息，";
	mes "仍以不死族的形态游荡，";
	mes "被束缚在这个世界。";
	next;
	mes "[Monster Scholar Vuicokk]";
		mes "这些怪物不能和由生物变异而来的其他怪物归为一类，因此英明仁慈的特里斯坦三世国王非常关注帕扬的不死族。";
		next;
		mes "[Monster Scholar Vuicokk]";
		mes "毕竟，其中一些不死族";
		mes "曾经属于卢恩-米德加尔特王国。";
		next;
	mes "[Monster Scholar Vuicokk]";
		mes "作为他们的君主，";
		mes "特里斯坦三世国王";
		mes "觉得自己有责任";
		mes "解放他们的灵魂。";
		next;
		mes "[Monster Scholar Vuicokk]";
		mes "陛下一直支持我们寻找";
		mes "消灭世上所有不死族的方法。";
		mes "我们会尽快实现这个目标。";
		next;
		mes "[Monster Scholar Vuicokk]";
		mes "为了人民的安全，";
		mes "为了他们的家人，也为了遵从特里斯坦三世国王的命令，我们必须成功！";
		break;
		case 3:
		mes "[Monster Scholar Vuicokk]";
		mes "如你所知，怪物不断在这个世界繁衍，";
		mes "它们袭击的威胁也日益增加。";
		next;
		mes "[Monster Scholar Vuicokk]";
		mes "为了应对这种情况，";
		mes "怪物研究组织";
		mes "应运而生。";
		next;
		mes "[Monster Scholar Vuicokk]";
		mes "世界各地的优秀人才联合起来，试图推断怪物的起源，并寻找一劳永逸消灭它们的方法。";
		next;
		mes "[Monster Scholar Vuicokk]";
		mes "当然，这不像你想的那么容易。许多人为了追求这些知识献出了生命。";
		next;
		mes "[Monster Scholar Vuicokk]";
	mes "在任务中，遭到怪物袭击的受害者数不胜数。但没有什么能阻止我们。如果我们的苦难能拯救人类，那就值得！";
		next;
		mes "[Monster Scholar Vuicokk]";
		mes "^666666*咳咳*^000000 抱歉，我有时会太激动。不过如果你遇到像我一样的其他学者，请善待他们。我们的工作非常艰难！";
		break;
		}
		close;
		}
		

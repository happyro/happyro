		payon_in01,180,7,2	script	Waitress#payon	90,{
		mes "[Pub Lady]";
		mes "这里总是人来人往。小初心者进进出出，准备成为弓箭手，其他人都在买箭，而我只能待在这间小店里。";
		next;
		mes "[Pub Lady]";
		mes "我也厌倦了做这种面汤。为了去掉身上的味道，我得不停洗澡，而且味道还很难消除。";
		next;
		mes "[Pub Lady]";
		mes "我感觉……";
		mes "好无聊。";
		mes "也好孤独……";
		next;
	mes "[Pub Lady]";
	if (Sex == SEX_MALE)
mes "我该去哪里找那个对的人，一个能带我离开这里的性感帅哥？嗯，先生，你在听吗？";
else {
mes "我该去哪里找那个对的人，一个可爱又健壮、能带我离开这里的帅哥？";
mes "嗯，女士，你在听吗？";
}
	next;
	mes "[Pub Lady]";
	mes "老算命师告诉我近期会有好运！可我到底怎么了？我只是得过且过。也许我又笨又优柔寡断。";
	next;
	mes "[Pub Lady]";
	mes "真对不起，";
	mes "我说得太多了。";
	mes "现在看起来像个傻瓜。";
	mes "抱歉让你听了这些。";
	next;
	mes "[Pub Lady]";
	mes "那么……";
	mes "有什么可以帮你？";
	next;
		switch(select("你听说过僵尸吗？:算命师……？:我需要一些酒。")) {
	case 1:
		mes "[Pub Lady]";
		mes "当然听说过僵尸！";
		mes "这里可是帕扬。";
	mes "僵尸是会行走的不死族，";
	mes "在这里很容易找到。";
	next;
	mes "[Pub Lady]";
	mes "听说它们害怕神圣力量，所以弓箭手喜欢用神圣金属白银制成的箭对付它们。";
	next;
	mes "[Pub Lady]";
	mes "传说镇长曾用白银箭射杀那些曾是同胞的僵尸，以解放它们的灵魂，让它们得以安息。";
	next;
	mes "[Pub Lady]";
	mes "我们相信这样驱除僵尸，";
	mes "能让它们平静地前往来世，不再受灵魂的折磨。";
	next;
	mes "[Pub Lady]";
	mes "你也许不认同我们的信仰，但我的祖父曾是不死族。我很感激镇长把他从活人世界的束缚中解放出来。";
	break;
	case 2:
	mes "[Pub Lady]";
		mes "哦！我们的算命师非常非凡。不过她已经不像以前那样常待在这里了。";
		next;
		mes "[Pub Lady]";
		mes "她以前会留在这里为客人算命，但镇长发现她的才能后，她就住进中央宫殿了。想见她的话最好去那里。";
		break;
		case 3:
		mes "[Pub Lady]";
		mes "你……";
		mes "需要一些";
		mes "酒，对吧？";
		mes "谁不需要呢？";
		next;
		mes "[Pub Lady]";
		mes "可是很抱歉，我们卖光了。";
		mes "由于外面的敌对生物，我们也负担不起继续酿酒的成本。请稍后再来，给你添麻烦了。";
		break;
		}
		next;
		mes "[Pub Lady]";
		mes "祝你今天";
		mes "过得愉快，亲爱的。";
	next;
		mes "[Pub Lady]";
mes "^666666*呜咽*^000000";
		mes "什么时候才会有一个";
		mes "身材完美又博学的男人";
		mes "来追求我呢？";
		close;
		}
	
		payon_in03,96,116,3	script	Chief Guardsman#payon	708,3,3,{
		end;
		
		OnTouch_:
		mes "[Chief Guardsman]";
		mes "是什么带你";
		mes "来到这里？";
		next;
		mes "[Chief Guardsman]";
		mes "我看得出你不是帕扬本地人。提醒你要遵守秩序。记住，";
	mes "你是这里的客人。";
	next;
	mes "[Chief Guardsman]";
	mes "为了维护公共安全，我会卸下你的装备。感谢你的合作。";
	nude;
	close;
	}
	
	payon_in01,66,64,5	script	Archer Zakk#payon	88,{
	mes "[Archer Zakk]";
	mes "我有点担心";
	mes "我的一个朋友。";
next;
mes "[Archer Zakk]";
mes "虽然他是射箭专家，但没人喜欢他的碎嘴。连我们的镇长都快受不了他了！";
	next;
switch(select("你的朋友？:帕扬有镇长？:碎……嘴？")) {
case 1:
	mes "[Archer Zakk]";
	mes "啊，对了。我的这位朋友是帕扬第一弓箭手。";
	mes "他在弓箭手村教导新手弓箭手。至少和他谈一次也许是个好主意。";
	
	
	
	
	
	
	
	
	



	
	
	
	
	
	
	
	
	
		
		
		
		break;
	case 2:

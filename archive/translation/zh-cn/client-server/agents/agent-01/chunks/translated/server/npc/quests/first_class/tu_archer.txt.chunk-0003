			mes "[Reidin Corse]";
			mes "我知道有点危险，";
			mes "但我有个朋友会在那里帮助你。当然，她还在训练中，不过……";
			next;
			mes "[Reidin Corse]";
			mes "哦……";
			mes "还有最后一件事。";
			mes "拿上一些这些东西。";
			next;
			mes "[Reidin Corse]";
			if(MaxWeight - Weight < 2100){
			mes "嘿、嘿！";
			mes "你为什么带这么多东西？";
			mes "最好把不需要的物品放进卡普拉仓库。";
				close;
			} else {
			mes "这些只是鼓励你的小礼物，别误会！现在快去拿我要求的东西，";
			mes "然后回来！";
				tu_archer01 = 14;
				getitem 601,10; //Wing_Of_Fly
				getitem 501,10; //Red_Potion
				getitem 602,1; //Wing_Of_Butterfly
				close;
			}
		} else if((tu_archer01 == 14) || (tu_archer01 == 15)){
			if (checkre(0) && (countitem(906) < 10 || countitem(921) < 10)) {// Pointed_Scale, Mushroom_Spore
				mes "记住，你需要前往斐扬东部的森林，带回";
				mes "^3131FF10 个蘑菇孢子^000000";
				mes "和 ^3131FF10 个尖锐鳞片^000000。";
				close;
			} else if (!checkre(0) && (countitem(1032) < 5 || countitem(905) < 20)) {
				mes "记住，你需要前往妙勒尼山，带回";
				mes "^3131FF5 食人花^000000";
				mes "和 ^3131FF20 根茎^000000。";
				next;
				mes "[Reidin Corse]";
				mes "从普隆德拉出发，向^3131FF北^000000、^3131FF北^000000再向^3131FF东^000000即可到达妙勒尼山。";
				mes "如果你愿意，我可以直接送你过去。";
				next;
				switch(select("Go!:W-Wait!")) {
				case 1:
					mes "[Reidin Corse]";
					mes "好！";
					mes "哦，如果有机会，";
					mes "替我向那边的服事者朋友问好～";
					emotion ET_SMILE;
					close2;
					warp "mjolnir_11",25,221;
					end;
				case 2:
					mes "[Reidin Corse]";
					mes "嗯？";
					mes "呃，好吧。不过";
					mes "没必要这么紧张，";
					mes "即使这是你的最终考试。";
					close;
				}
			}
			mes "哈哈～！";
			mes "你现在看起来更像";
			mes "老手而不是新手了！";
			mes "没错，我能从你的眼神中看出来。";
			next;
			mes "[Reidin Corse]";
			mes "对了，你有机会见到我的服事者朋友玛芙拉吗？她很害羞，希望你们相处得不错。";
			next;
			mes "[Reidin Corse]";
			mes "我很高兴告诉你，";
			mes "你通过了我的最终考试！";
			mes "来，收下这份小奖励！";
			specialeffect2 EF_WIND;
			tu_archer01 = 16;
			if (checkre(3))
				getexp 1000,1000;
			else
				getexp 3000,3000;
			getitem 1770,500; //Iron_Arrow
			next;
			mes "[Reidin Corse]";
			mes "你现在已经是名副其实的弓箭手了。说实话，";
			mes "我没什么可再教你的了，至少弓术方面是这样。";
			emotion ET_SMILE;
			next;
			mes "[Reidin Corse]";
			mes "如果你和他谈谈，卡瓦鲁克大师也许会交给你一些事。";
			mes "他也总让我到处替他跑腿。真讨厌！";
			emotion ET_HNG;
			next;
			mes "[Reidin Corse]";
			mes "那么，"+ strcharinfo(0) +"，";
			mes "如果你能真正爱上弓术，我会很高兴。以后再见，好吗？";
			emotion ET_BEST;
			close;
		} else if(tu_archer01 == 16){
			mes "我很喜欢这个城镇。";
			mes "这里绿意盎然，";
			mes "鸟儿总在歌唱。斐扬真的很和平。";
			next;
			mes "[Reidin Corse]";
			mes "当然，我在这里有能托付性命的朋友。我们总会争论，但都希望彼此最好。";
			emotion ET_HNG;
			next;
			mes "[Reidin Corse]";
			mes "你不觉得";
			mes "拥有";
			mes "优秀的朋友";
			mes "很棒吗？";
			close;
		} else {
			mes "我很喜欢这个城镇。";
			mes "四周一片翠绿、鸟儿歌唱……斐扬真是个和平的地方。";
			next;
			mes "[Reidin Corse]";
			mes "躺在草地上仰望天空让我感到幸福。";
			next;
			mes "[Reidin Corse]";
			mes "也许是因为这里有值得信赖的朋友陪着我。哈哈。";
			mes "我们总会争论，但内心深处都在乎彼此。";
			emotion ET_HNG;
			next;
			mes "[Reidin Corse]";
			mes "……‘朋友’真是个美好的词。你也这么认为吧？";
			close;
		}
	}
	mes "请允许我自我介绍。我是弓箭手中的弓箭手，^3131FF雷丁·科斯^000000，伊卡洛斯公会会长！";
	next;
	emotion ET_BEST;
	mes "[Reidin Corse]";
	mes "现在正在举办特别活动！伊卡洛斯公会申请费减半！现在加入还免年费！";
	next;
	emotion ET_THROB;
	mes "[Reidin Corse]";
	mes "特别活动期间不限制职业！";
	mes "此外，所有新加入的男性成员都会认识美丽的舞娘女孩！";
	next;
	emotion ET_SMILE;
	mes "[Reidin Corse]";
	mes "新加入的女性成员还有机会和我约会！千万不要错过！";
	next;
	emotion ET_MONEY;
	mes "[Reidin Corse]";
	mes "现在加入，";
	mes "只需一次性支付 ^3131FF1,000,000 Zeny^000000！趁优惠还在，快加入伊卡洛斯公会！";
	next;
	emotion ET_HNG, getnpcid(0, "Arpesto");
	mes "[Arpesto]";
	mes "雷丁……";
	mes "别胡闹了。";
	mes "嘿，小子。真正的";
	mes "伊卡洛斯公会会长";
	mes "在那栋建筑里。";
	next;
	emotion ET_HUK;
	mes "[Reidin Corse]";
	mes "阿佩斯托……！";
	mes "你为什么……？！";
	next;
	emotion ET_ANGER;
	mes "[Reidin Corse]";
	mes "^333333*Sigh*^000000";
	mes "你赢了，你赢了。";
	mes "没有申请费。";
	mes "但我还是会和那些";
	mes "可爱的女孩约会……";
	close;
}

// Seisner
//============================================================
pay_arche,84,139,3	script	Seisner	4_F_JOB_HUNTER,{
	specialeffect EF_HIT2,AREA,"#Target";
	mes "[Seisner]";
	mes "啊啊啊！";
	mes "二连矢！";
	specialeffect EF_HIT2,AREA,"#Target";
	next;
	mes "[Seisner]";
	mes "我做到了！";
	mes "只有弓箭手";
	mes "才能射出那一箭！";
	next;
	mes "[Seisner]";
	mes "有些盗贼系职业也使用弓箭，";
	mes "但他们更适合使用小刀。我们弓箭手";
	mes "才是弓箭专家！";
	if(tu_archer01 == 1 || tu_archer01 > 2){
		next;
		mes "^3355FF你把信展示给赛斯纳，";
		mes "这是卡瓦鲁克大师写给她的";
		mes "信。^000000";
		next;
		mes "[Seisner]";
		mes "所以卡瓦鲁克大师希望我教你";
		mes "弓箭手和弓术？好吧，你想了解什么？";
		while(1){
			next;
			switch(select("About Archers.:Stats for Archers:End Conversation.")){
			case 1:
				mes "[Seisner]";
				mes "弓箭手专精";
				mes "射击 ^3131FF弓箭^000000。我们通常远程攻击，但在提高闪避率前，单挑时相当脆弱。";
				next;
				mes "[Seisner]";
				mes "因此，弓箭手会在敌人靠近前攻击。";
				mes "我们也喜欢和能提供近战保护的";
				mes "伙伴组队。";
				next;
				mes "[Seisner]";
				mes "只有初心者在达到职业等级 10";
				mes "并学会所有基本技能后，";
				mes "才能转职为弓箭手。";
				next;
				mes "[Seisner]";
				mes "经验丰富的弓箭手可以转为二转职业：^3131FF猎人^000000；男性可成为 ^3131FF吟游诗人^000000，女性可成为 ^3131FF舞娘^000000。";
				next;
				mes "[Seisner]";
				mes "如果你达到 99 级";
				mes "作为二转职业角色，可以在女武神的帮助下转为超越者职业。";
				next;
				mes "[Seisner]";
				mes "猎人最终可转为 ^3131FF神射手^000000，吟游诗人转为 ^3131FF搞笑艺人^000000，舞娘转为 ^3131FF冷艳舞姬^000000。确实很复杂。";
				if(tu_archer01 == 1) tu_archer01 = 2;
				break;
			case 2:
				mes "[Seisner]";
				mes "所以你想了解更多";
				mes "属性及其如何影响弓箭手能力？";
				mes "我会尽力解释。";
				next;
				while(1) {
					switch(select("STR:^3131FFAGI^000000:VIT:^FF9900INT^000000:^FF3131DEX^000000:LUK:End Conversation.")) {
					case 1:
						mes "[Seisner]";
						mes "STR 通常会增加攻击伤害。但弓箭手使用依靠 ^FF3131DEX^000000 提高伤害的武器。";
						next;
						mes "[Seisner]";
						mes "从某种意义上说，弓箭手不一定需要 STR，不过某些技能或情况中 STR 仍会派上用场。";
						next;
						mes "[Seisner]";
						mes "例如箭用完（每个弓箭手的噩梦）而必须装备小刀时，拥有一些 STR";
						mes "可能会有帮助。";
						next;
						mes "[Seisner]";
						mes "提高 STR 也会增加角色的负重上限。因此 STR 越高，就能携带更多箭。";
						next;
						if(tu_archer01 == 1) tu_archer01 = 2;
						continue;
					case 2:
						mes "[Seisner]";
			mes "如你所知，^FF3131AGI^000000 ^3131Ff会提高攻击速度";
		mes "（ASPD），^000000并影响 ^3131FF闪避率^000000。";
		mes "提升 AGI 能改善弓箭手闪避率较低的弱点。";
						next;
						mes "[Seisner]";
						mes "弓箭手的缺点是力量较弱、闪避率较低。不过提高 ^FF3131AGI^000000 可以减轻闪避率劣势。";
						next;
						if(tu_archer01 == 1) tu_archer01 = 2;
						continue;
					case 3:
						mes "[Seisner]";
		mes "^3131FFVIT^000000 会提高";
						mes "最大 HP 及";
						mes "伤害抗性。";
						next;
						mes "[Seisner]";
						mes "弓箭手虽不专精特殊防御，但 VIT 能缓解弓箭手职业的防御弱点。";
						next;
						mes "[Seisner]";
						mes "VIT 是否有帮助取决于使用方式。不过作为弓箭手，不建议过度提升 VIT。";
						next;
						if(tu_archer01 == 1) tu_archer01 = 2;
						continue;
					case 4:
						mes "[Seisner]";
		mes "^FF0000INT^000000 比你想象中";
						mes "对弓箭手职业";
						mes "比你想象的更重要～";
						next;
						mes "[Seisner]";
						mes "提高 ^FF0000INT^000000 会增加最大 SP，这意味着你";
						mes "能更频繁地使用特殊技能。";
						next;
						mes "[Seisner]";
						mes "对弓箭手二转职业猎人来说，更高的 INT 会增加 ^3131FF猎鹰^000000 造成的伤害。";
						next;
						if(tu_archer01 == 1) tu_archer01 = 2;
						continue;
					case 5:
						mes "[Seisner]";
						mes "现在 DEX 几乎毫无疑问是";
						mes "所有弓箭手";
						mes "最重要的属性。";
						next;
						mes "[Seisner]";
			mes "^FF3131DEX^000000 ^3131Ff会提高伤害^000000，";
						mes "弓箭手使用的箭矢武器包括 ^3131FF弓^000000、^3131FF乐器^000000 和 ^3131FF鞭子^000000。";
						next;
						mes "[Seisner]";
						mes "灵巧增强弓箭手命中弱点并造成更多伤害的能力，所以箭矢武器不像其他职业武器那样依赖 STR。";
						next;
						mes "[Seisner]";
						mes "和其他职业一样，^FF3131DEX^000000 会提高 ^3131FF命中率（HIT）^000000，并略微提高攻击速度（ASPD）。";
						next;
						if(tu_archer01 == 1) tu_archer01 = 2;
						continue;
					case 6:
						mes "[Seisner]";
		mes "^FF0000LUK^000000 会影响你的";
						mes "完全回避率";
						mes "和暴击率。";
						next;
						mes "[Seisner]";
						mes "对弓箭手二转职业猎人来说，LUK 会提高 ^3131FF猎鹰突击^000000 自动发动的概率。因此依赖猎鹰的猎人可以考虑投资 LUK。";
						next;
						if(tu_archer01 == 1) tu_archer01 = 2;
						continue;
					case 7:
						mes "[Seisner]";
						mes "那么还有";
						mes "其他内容";
						mes "你想问我的吗？";
						break;
					}
					break;
				}
				break;
			case 3:
				mes "[Seisner]";
				mes "弓箭手射出箭后，无法停止飞行或改变目标。因此弓箭手在战斗中必须冷静并格外小心。";
				next;
				mes "[Seisner]";
				mes "有一天，我想成为伟大的弓箭手，用技能为卢恩·米德加尔特做好事。";
				close;
			}
		}
	} else if(tu_archer01 == 2){
		next;
		mes "[Seisner]";
		mes "谢谢你的聆听。";
		mes "我知道告诉了你很多信息，但我认为每个人";
		mes "理解弓术都很重要。";
		next;
		mes "[Seisner]";
		mes "如果你已经掌握了我教的知识，就回去找卡瓦鲁克大师。如果还有疑问，随时可以来问我。";
		close2;
		specialeffect2 EF_WIND;
		tu_archer01 = 3;
		if(JobLevel == 1){
			getexp 0,30;
		} else if((JobLevel > 1) && (JobLevel < 11)){
			getexp 0,80;
		} else if((JobLevel > 10) && (JobLevel < 21)){
			getexp 0,100;
		} else {
			getexp 0,120;
		}
		end;
	}
	close;
}

// Target
//============================================================
pay_arche,76,135,3	script	#Target	HIDDEN_NPC,{ end; }

// Acolyte
//============================================================
-	script	::Acolyte_Tu	-1,{
	mes "[Acolyte]";
	if(tu_archer01 == 14){
		if(gettime(DT_HOUR) >= 18 && gettime(DT_HOUR) < 22){
			mes "你、你好！";
			mes "嗯，嗯……";
			mes "你也是雷丁·科斯的";
			mes "朋友吗？";
			next;
			mes "[Acolyte]";
			mes "我、我叫玛芙拉。";
			mes "自从他救了我的命，雷丁就一直是我的好朋友。";
			mes "他是很棒的弓箭手，也是个非常好的人！";
			next;
			mes "[Acolyte]";
			mes "嗯，还有……";
			mes "呃……糟糕～";
			mes "我该告诉你";
			mes "什么呢……？";
			emotion ET_PROFUSELY_SWEAT;
			next;
			mes "[Acolyte]";
			mes "哦，我正在训练成为服事者，应该帮助他教导的人。所以……";
			mes "让我们互相帮助训练吧！";
			mes "嗯，可以吗？";
			next;
			switch(select("Sure.:No thanks.:Reidin Corse is mine!")) {
			case 1:
				mes "[Acolyte]";
				mes "哇！";
				mes "谢谢，谢谢！";
				mes "我会尽全力的！";
				tu_archer01 = 15;
				close;
			case 2:
				mes "[Acolyte]";
				mes "哦……哦。";
				mes "真对不起。";
				mes "如果你不需要";
				mes "我的帮助，我想";
				mes "也没关系……";
				emotion ET_CRY;
				close;
			case 3:
				mes "[Acolyte]";
				mes "咦？！";
				mes "真、真的吗？";
				mes "我想他不";
				mes "需要告诉我他";
				mes "是否已经有女朋友……";
				next;
				mes "[Acolyte]";
				if(Sex == SEX_MALE){
					mes "等、等一下！";
					mes "你、你是男的！";
					mes "别、别这样逗我，";
					mes "我是认真的！";
				} else {
					mes "而且他勇敢、";
					mes "风趣又聪明。";
					mes "你、你能和他在一起真幸运。";
					mes "^333333*Sniff*^000000 I... I...";
					next;
					mes "[Acolyte]";
					mes "^333333*Sniffle*^000000";
					mes "我会尽、尽力帮助你！";
					mes "祝你们幸福！（哇啊啊～！）";
				}
				tu_archer01 = 15;
				close;
			}
		}
		else {
			mes "^666666Zzzzz...^000000";
			mes "什、什么……？";
			mes "你是谁？";
			specialeffect EF_SLEEPATTACK;
			next;
			mes "[Acolyte]";
			mes "等等，我知道了……";
			mes "你、你是……^666666*哈欠*^000000";
			mes "好困。先拿着这个……";
			switch(rand(4)) {
				case 0: npcskill "AL_HEAL",3,90,62; break;
				case 1: npcskill "AL_HEAL",9,90,62; break;
				case 2: npcskill "AL_HEAL",8,90,62; break;
			}
			switch(rand(3)) {
				case 0: npcskill "AL_INCAGI",1,0,0; break;
				case 1: npcskill "AL_INCAGI",5,0,0; break;
				case 2: npcskill "AL_INCAGI",10,0,0; break;
			}
			switch(rand(3)) {
				case 0: npcskill "AL_BLESSING",1,0,0; break;
				case 1: npcskill "AL_BLESSING",5,0,0; break;
				case 2: npcskill "AL_BLESSING",10,0,0; break;
			}
			close;
		}
	}
	else if(tu_archer01 == 15){
		if((gettime(DT_HOUR) >= 18) && (gettime(DT_HOUR) < 22)){
			mes "^666666Zzzzz...^000000";
			mes "什、什么……？";
			mes "你是谁？";
			specialeffect EF_SLEEPATTACK;
			next;
			mes "[Acolyte]";
			mes "雷丁·科斯？";
			mes "真不敢相信";
			mes "我居然睡着了——";
			mes "^666666Zzzzzzz...^000000";
			next;
			mes "[Acolyte]";
			mes "^666666Zzzz^000000--Oooh!";
//
//
//
//
//
//
//
//
//
//
//
//
//

airplane,100,69,3	script	Airship Crew#ein-1	852,{
	mes "[Airship Crew]";
	mes "如果我们降落在";
	mes "目的地并想离开飞艇时，";
	mes "请使用飞艇前方的楼梯。";
	mes "楼梯就在前方，";
	mes "感谢您的乘坐。";
	mes "祝您旅途愉快。";
	close;
}

airplane,64,94,1	script	Umbala Kid#ein_p	787,{
	emotion ET_PROFUSELY_SWEAT;
	mes "[Kid]";
	if (event_umbala >= 3) {
		mes "哇，妈妈！";
		mes "快、看这个！";
		mes "我们在飞！我、我们……";
		mes "我们竟然在天空中！";
	}
	else {
		mes "Makumalagu!";
		mes "Saampa joojimbo";
		mes "kaku na jedi Solo.";
		mes "哇哈哈哈哈哈哈！";
	}
	close;
}

airplane,66,93,3	script	Umbala Lady#ein_p	783,{
	emotion ET_THINK;
	mes "[Lady]";
	if (event_umbala >= 3) {
		mes "嘘……";
		mes "亲爱的，乖一点~";
		mes "别这么兴奋，";
		mes "尤其是当我们";
		mes "身处这样的公共场所时！";
	}
	else {
		mes "Chooktu!";
		mes "Sacraup matii!";
		mes "Shaka gurftalfi";
		mes "huntiki manjoo!";
	}
	close;
}

airplane,71,91,7	script	Umbala Man#ein_p	789,{
	if (event_umbala >= 3) {
		mes "[Chrmlim]";
		mes "你好呀~";
		mes "从你的表情看来，";
		mes "我看得出你能听懂";
		mes "我说的话。";
		mes "我的话。^333333*呼……*^000000";
		next;
		emotion ET_HNG;
		mes "[Chrmlim]";
		mes "我一直在帮助飞艇公司";
		mes "让飞艇船员";
		mes "在乌姆巴拉接受训练，";
		mes "通过蹦极克服恐高症。";
		mes "很酷吧？";
		next;
		mes "[Chrmlim]";
		mes "但是……";
		mes "有些人无法克服";
		mes "对高度的恐惧。";
		mes "甚至有几个人最后，呃，";
		mes "去了^333333尼福尔海姆^000000。";
	}
	else {
		mes "[Chrmlim]";
		mes "Bajoo ga";
		mes "nukta Airship.";
		next;
		mes "[Chrmlim]";
		mes "...";
		mes "......";
		next;
		emotion ET_HNG;
		mes "[Chrmlim]";
		mes "Shabala moow bajama";
		mes "Airship kulaha googoona ";
		mes "salu. Dama, kookoo na nu";
		mes "yukuta. Um, fashuku na ret!";
	}
	close;
}

airplane,250,58,2	script	Airship Staff#airplane	67,{
	// Hugel quest addition
	if (hg_ma1 == 3) {
		mes "[Airship Staff]";
		mes "欢迎";
		mes "来到飞艇。";
		mes "有什么可以帮您？";
		next;
		select("你们有一位叫蒂埃里的乘客吗？");
		mes "[Airship Staff]";
		mes "抱歉，我想我们没有这位乘客。";
		close;
	}
	// Hugel quest end
	mes "[Airship Staff]";
	mes "欢迎";
	mes "来到飞艇。";
	mes "有什么可以帮您？";
	next;
	switch (select("使用飞艇:船长室:设施:取消")) {
	case 1:
		mes "[Airship Staff]";
		mes "听到广播通知";
		mes "我们已抵达目的地时，";
		mes "请使用飞艇北端或";
		mes "南端的出口。";
		mes "出口位于飞艇两端。";
		mes "请从那里离开。";
		next;
		mes "[Airship Staff]";
		mes "如果错过了下船地点，";
		mes "不用担心。飞艇会继续航行，";
		mes "你还有机会再次抵达";
		mes "预定的目的地。";
		mes "请耐心等待下一站。";
		mes "我们会继续提供服务。";
		close;
	case 2:
		mes "[Airship Staff]";
		mes "船长室位于飞艇前部。";
		mes "在那里你可以见到";
		mes "飞艇的船长和驾驶员。";
		mes "欢迎前往拜访。";
		mes "不要打扰船员工作。";
		close;
	case 3:
		mes "[Airship Staff]";
		mes "飞艇为乘客准备了各种小游戏。";
		mes "欢迎来试试运气和技巧，";
		mes "这里有许多有趣的挑战，";
		mes "我们为所有乘客准备了";
		mes "欢迎享受小游戏。";
		mes "享受旅途中的娱乐时光~";
		close;
	case 4:
		mes "[Airship Staff]";
		mes "希望你喜欢乘坐飞艇。";
		mes "希望你喜欢这次飞行。";
		mes "祝你旅途愉快。";
		mes "谢谢，祝你今天愉快。";
		close;
	}
}

airplane,80,71,2	script	Zerta#01airplane	834,{
	mes "[Zerta]";
	mes "哦，你好，冒险者。";
	mes "我正在进行神圣的旅程，";
	mes "为米德加尔特大陆";
	mes "献上虔诚的祈祷，";
	mes "献上祈祷。";
	close;
}

airplane,65,63,4	script	Maelin#01airplane	714,{
	mes "[Maelin]";
	mes "嗯，这艘飞艇是去鲁蒂的，对吧？";
	mes "我等了很久，";
	mes "却一直没听到";
	mes "任何关于鲁蒂的";
	mes "关于鲁蒂的广播。";
	close;
}

airplane,72,34,6	script	Aanos#01airplane	702,{
	mes "[Aanos]";
	mes "哇哦~";
	mes "从上面看，天空";
	mes "真的很不一样，";
	mes "也很漂亮！";
	close;
}

airplane,221,158,2	script	Pilot#airplane	852,{
	// Hugel quest addition
	if (hg_ma1 == 3) {
		mes "[Pilot]";
		mes "真想喝一杯冰凉的新鲜啤酒。";
		mes "喝酒是我人生的目标！喝酒给我能量！";
		mes "没有酒我什么都不是！";
		next;
		mes "[Pilot]";
		mes "但是！酒后驾驶可不好。";
		mes "可是！这让我更想喝个不停！";
		emotion ET_CRY;
		next;
		select("你认识一位叫蒂埃里的乘客吗？");
		mes "[Pilot]";
		mes "这套制服很帅气，";
		mes "但穿着它在飞艇里";
		mes "活动实在太厚了。";
		mes "穿起来很不方便。";
		next;
		mes "[Pilot]";
		mes "...";
		mes "......";
		mes "几乎没人会进这个房间。";
		mes "而且船长真的是驯鹿。";
		mes "我甚至可以脱到只剩短裤。";
		next;
		emotion ET_HUK;
		mes "[Pilot]";
		mes "哇！？是谁！";
		next;
		mes "-……他完全没有在听你说话。-";
		close;
	}
	// Hugel quest end
	switch (rand(1,4)) {
	case 1:
		mes "[Pilot]";
		mes "我已经很久没有";
		mes "享受一杯冰凉的酒了。";
		mes "但这份工作要求我";
		mes "尽可能保持";
		mes "头脑清醒！";
		mes "工作要求我时刻清醒。";
		next;
		mes "[Pilot]";
		mes "请始终负责任地饮酒！";
		mes "不过，我都记不起上次";
		mes "真正休假";
		mes "或休息一天是什么时候了。";
		mes "酒、薯片、电视和彻底放松，";
		mes "现在都该安排上了。";
		emotion ET_CRY;
		close;
	case 2:
		mes "[Pilot]";
		mes "今天的天气真好。";
		mes "明亮开阔的天空";
		mes "让视野清晰，";
		mes "天空明亮开阔，";
		mes "飞行安全又轻松。";
		close;
	case 3:
		mes "[Pilot]";
		mes "我们的船长是个值得尊敬的人。";
		mes "他和弟弟在航空业";
		mes "都很有名。";
		mes "谁能想到驯鹿";
		mes "也能成为优秀的船长？";
		mes "真是令人惊讶。";
		next;
		mes "[Pilot]";
		mes "只告诉你一个人，";
		mes "我得告诉你，圣诞老人";
		mes "让驯鹿和精灵为他工作，";
		mes "真是有一套。";
		mes "那家伙一定是天才，";
		mes "真令人佩服！";
		close;
	default:
		mes "[Pilot]";
		mes "你知道，驾驶飞艇";
		mes "在空中飞行这件事，";
		mes "其实还很新，你知道吗？";
		mes "他们很快就建立了飞艇";
		mes "运营体系。";
		next;
		emotion ET_HUK;
		mes "[Pilot]";
		mes "不过他们非常认真，";
		mes "考虑得很周全。";
		mes "他们一直在提前准备。";
		mes "飞艇还在发明阶段时，";
		mes "他们就已经让我们接受训练。";
		mes "这不是很疯狂吗？！";
		close;
	}
}

airplane,50,66,5	script	Apple Merchant#airplane	86,{
	mes "[Fruitz]";
	mes "欢迎来到 Fruitz 的";
	mes "商店，你可以在这里";
	mes "购买苹果，或将苹果榨成果汁。";
	mes "欢迎光临。";
	next;
	switch (select("购买苹果：制作苹果汁：你为什么在这里？：取消。")) {
	case 1:
		mes "[Fruitz]";
		mes "请输入要购买的苹果数量。";
		mes "每个苹果 15 Zeny，最多购买";
		mes "500 个。请输入“0”取消订单。";
		mes "请输入数量后继续。";
		mes "";
		mes "每次购买最多 500 个苹果。";
		next;
		while (1) {
			input .@input;
			set .@pay, .@input * 15;
			if (.@input == 0) {
				mes "[Fruitz]";
				mes "谢谢光临我的商店。";
				mes "再见！想吃苹果时";
				mes "随时再来~";
				mes "祝你用餐愉快。";
				mes "";
				close;
			}
			else if (.@input < 1 || .@input > 500) {
				mes "[Fruitz]";
				mes "你输入的数字超过了最大值 500。";
				mes "请重新输入想要购买的";
				mes "苹果数量。";
				mes "";
				mes "";
				next;

	mapannounce "airplane","飞艇离开地面。下一站是胡格尔。",bc_map,"0xca4bf3";
	end;
OnTimer340000:
	mapannounce "airplane","我们正前往胡格尔。",bc_map,"0xca4bf3";
	end;
OnTimer370000:
	mapannounce "airplane","我们很快就会抵达胡格尔。",bc_map,"0xca4bf3";
	end;
OnTimer380000:
	set $@airplanelocation,3;
	donpcevent "#AirshipWarp-1::OnUnhide";
	donpcevent "#AirshipWarp-2::OnUnhide";
	mapannounce "airplane","欢迎来到胡格尔。祝您旅途平安。",bc_map,"0xca4bf3";
	end;
OnTimer390000:
	mapannounce "airplane","目前我们在胡格尔。飞艇即将离开。",bc_map,"0xca4bf3";
	end;
OnTimer400000:
	donpcevent "#AirshipWarp-1::OnHide";
	donpcevent "#AirshipWarp-2::OnHide";
	mapannounce "airplane","飞艇离开地面。下一站是朱诺。",bc_map,"0xff8200";
	end;
OnTimer420000:
	mapannounce "airplane","我们正前往朱诺。",bc_map,"0xff8200";
	end;
OnTimer450000:
	mapannounce "airplane","我们很快就会抵达朱诺。",bc_map,"0xff8200";
	end;
OnTimer460000:
	set $@airplanelocation,0;
	donpcevent "#AirshipWarp-1::OnUnhide";
	donpcevent "#AirshipWarp-2::OnUnhide";
	mapannounce "airplane","欢迎来到朱诺。祝您旅途平安。",bc_map,"0xff8200";
	end;
OnTimer470000:
	mapannounce "airplane","目前我们在朱诺。飞艇即将离开。",bc_map,"0xff8200";
	end;
OnTimer480000:
	donpcevent "#AirshipWarp-1::OnHide";
	donpcevent "#AirshipWarp-2::OnHide";
	mapannounce "airplane","飞艇离开地面。下一站是艾因布罗克。",bc_map,"0x00ff00";
	stopnpctimer;
	initnpctimer;
}


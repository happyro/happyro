//= Domestic Airship Route
//= ... -> Juno -> Einbroch -> Lighthalzen -> Einbroch
//= -> Juno -> Hugel -> ...
//============================================================ 

airplane,243,73,0	script	#AirshipWarp-1	45,1,1,{
	end;

OnInit:
OnHide:
	specialeffect EF_BASH;
	disablenpc();
	end;

OnUnhide:
	enablenpc();
	specialeffect EF_SUMMONSLAVE;
	end;

OnTouch_:
	switch ($@airplanelocation) {
	case 0: warp "yuno",92,260; end;
	case 1: warp "einbroch",92,278; end;
	case 2: warp "lighthalzen",302,75; end;
	case 3: warp "hugel",181,146; end;
	}
}

airplane,243,29,0	duplicate(#AirshipWarp-1)	#AirshipWarp-2	45,1,1

airplane,1,1,0	script	Domestic_Airship	-1,{
	end;
OnInit:
	initnpctimer;
	end;
OnTimer20000:
	mapannounce "airplane","我们正前往艾因布罗克。",bc_map,"0x00ff00";
	end;
OnTimer50000:
	mapannounce "airplane","我们很快就会抵达艾因布罗克。",bc_map,"0x00ff00";
	end;
OnTimer60000:
	set $@airplanelocation,1;
	donpcevent "#AirshipWarp-1::OnUnhide";
	donpcevent "#AirshipWarp-2::OnUnhide";
	mapannounce "airplane","欢迎来到艾因布罗克。祝您旅途平安。",bc_map,"0x00ff00";
	end;
OnTimer70000:
	mapannounce "airplane","目前我们在艾因布罗克。飞艇即将起飞。",bc_map,"0x00ff00";
	end;
OnTimer80000:
	donpcevent "#AirshipWarp-1::OnHide";
	donpcevent "#AirshipWarp-2::OnHide";
	mapannounce "airplane","飞艇现在起飞。下一站是里希塔乐。",bc_map,"0x70dbdb";
	end;
OnTimer100000:
	mapannounce "airplane","我们正前往里希塔乐。",bc_map,"0x70dbdb";
	end;
OnTimer130000:
	mapannounce "airplane","我们很快就会抵达里希塔乐。",bc_map,"0x70dbdb";
	end;
OnTimer140000:
	set $@airplanelocation,2;
	donpcevent "#AirshipWarp-1::OnUnhide";
	donpcevent "#AirshipWarp-2::OnUnhide";
	mapannounce "airplane","欢迎来到里希塔乐。祝您旅途平安。",bc_map,"0x70dbdb";
	end;
OnTimer150000:
	mapannounce "airplane","目前我们在里希塔乐。飞艇即将离开。",bc_map,"0x70dbdb";
	end;
OnTimer160000:
	donpcevent "#AirshipWarp-1::OnHide";
	donpcevent "#AirshipWarp-2::OnHide";
	mapannounce "airplane","飞艇离开地面。下一站是艾因布罗克。",bc_map,"0x00ff00";
	end;
OnTimer180000:
	mapannounce "airplane","我们正前往艾因布罗克。",bc_map,"0x00ff00";
	end;
OnTimer210000:
	mapannounce "airplane","我们很快就会抵达艾因布罗克。",bc_map,"0x00FF00";
	end;
OnTimer220000:
	set $@airplanelocation,1;
	donpcevent "#AirshipWarp-1::OnUnhide";
	donpcevent "#AirshipWarp-2::OnUnhide";
	mapannounce "airplane","欢迎来到艾因布罗克。祝您旅途平安。",bc_map,"0x00ff00";
	end;
OnTimer230000:
	mapannounce "airplane","目前我们在艾因布罗克。飞艇即将起飞。",bc_map,"0x00ff00";
	end;
OnTimer240000:
	donpcevent "#AirshipWarp-1::OnHide";
	donpcevent "#AirshipWarp-2::OnHide";
	mapannounce "airplane","飞艇现在起飞。下一站是朱诺。",bc_map,"0xff8200";
	end;
OnTimer260000:
	mapannounce "airplane","我们正前往朱诺。",bc_map,"0xff8200";
	end;
OnTimer290000:
	mapannounce "airplane","我们很快就会抵达朱诺。",bc_map,"0xff8200";
	end;
OnTimer300000:

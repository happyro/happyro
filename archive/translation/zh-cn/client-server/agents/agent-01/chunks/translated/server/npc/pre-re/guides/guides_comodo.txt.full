comodo,322,178,4	script	Comodo Guide#cmd::CmdGuide	700,{
	callfunc "F_CmdGuide","科科莫原住民";
}

comodo,176,350,4	script	Comodo Guide#2cmd	700,{
	callfunc "F_CmdGuide","努特科科原住民";
}

comodo,37,219,4	script	Guide#2cmd	700,{
	callfunc "F_CmdGuide","木瓜原住民";
}

function	script	F_CmdGuide	{
	mes "["+getarg(0)+"]";
	mes "欢迎来到海洞，";
	mes "梦想与幻想之城，";
	mes "这里的夜生活永不结束！";
	mes "我非常熟悉这里，";
	mes "需要";
	mes "任何地点的方向就告诉我。";
	next;
	switch(select("赌场:呼啦舞台 ^3355FF（舞者转职）^000000:武器和防具店:工具店:旅游商店:卡普拉公司西部分部:首领之家:酒馆:露营地:结束对话")) {
	case 1:
		viewpoint 1,140,98,0,0xFF6633;
		mes "请参考小地图上的十字标记，";
		mes "^FF6633+^000000, 以找到";
		mes "赌场，疲惫旅行者的休息地，";
		mes "也是海洞夜生活的";
		mes "中心。";
		close;
	case 2:
		viewpoint 1,188,168,1,0x0000FF;
		mes "请参考小地图上的十字标记，";
		mes "^0000FF+^000000, 以找到";
		mes "呼啦舞台，女性弓箭手";
		mes "可以在这里";
		mes "转职为舞者。";
		close;
	case 3:
		viewpoint 1,266,70,2,0x00FFFF;
		mes "请参考小地图上的十字标记，";
		mes "^00FFFF+^000000, 以找到";
		mes "武器和防具店。务必";
		mes "查看那里是否有";
		mes "海洞特有的";
		mes "特殊物品！";
		close;
	case 4:
		viewpoint 1,86,128,3,0x515151;
		mes "请参考小地图上的十字标记，";
		mes "^515151+^000000, 以找到";
		mes "工具店。如果你没去过，";
		mes "建议你去看看并";
		mes "储备";
		mes "以后可能需要的工具。";
		close;
	case 5:
		viewpoint 1,298,124,4,0x3355FF;
		mes "请参考小地图上的十字标记，";
		mes "^3355FF+^000000, 以找到";
		mes "旅游商店，你可以";
		mes "购买只有海洞地区才有的礼物~";
		close;
	case 6:
		viewpoint 1,136,202,5,0xFF5555;
		mes "请参考小地图上的十字标记，";
		mes "^FF5555+^000000, 以找到";
		mes "卡普拉公司的西部分部，";
		mes "提供一些";
		mes "重要服务，之后可以来看看。";
		close;
	case 7:
		viewpoint 1,114,294,5,0xFF5555;
		mes "请参考小地图上的十字标记，";
		mes "^FF5555+^000000, 以找到";
		mes "首领之家。欢迎";
		mes "拜访首领，他通常";
		mes "很乐意接待访客。";
		close;
	case 8:
		viewpoint 1,166,298,5,0xFF5555;
		mes "请参考小地图上的十字标记，";
		mes "^FF5555+^000000, 以找到";
		mes "酒馆。在那里你能遇到其他";
		mes "游客，放松并社交";
		mes "在愉快的环境中~";
		close;
	case 9:
		viewpoint 1,210,308,5,0xFF5555;
		mes "请参考小地图上的十字标记，";
		mes "^FF5555+^000000, 以找到";
		mes "露营地。和家人朋友";
		mes "一起享受";
		mes "海洞露营地的特色";
		mes "烧烤~";
		close;
	case 10:
		mes "["+getarg(0)+"]";
		mes "其实，科摩多看起来总是";
		mes "像处于夜晚一样。";
		mes "因为它建在巨大的";
		mes "洞穴里。我们没有阳光，";
		mes "但这里的黑暗";
		mes "比阴沉更令人兴奋~";
		close;
	}
}

	next;
	if (select("继续对话。：结束对话。") == 1) {
		mes "[Nastasia]";
		mes "虽然刺客受益于高速度和高 AGI，但仍然需要一些 DEX。";
		next;
		mes "[Nastasia]";
		mes "如果想命中有翅膀的怪物，DEX 尤其重要。这些怪物移动和攻击都很快。";
		next;
		mes "[Nastasia]";
		mes "总之，如果想命中速度和你一样快甚至更快的怪物，就需要一些 DEX。";
		close;
	}
	mes "[Nastasia]";
	mes "常言道，世上没有免费的东西。不过，如果学习成为刺客不需要花钱……";
	close;
}


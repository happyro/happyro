}

aldeba_in,156,179,4	script	Master#alde	61,{
	mes "[Master]";
	mes "卡普拉公司总部就在艾尔帕兰。";
	mes "你知道";
	mes "这意味着什么吗？";
	next;
	mes "[Master]";
	mes "这意味着可爱的卡普拉员工会来这里午休！很棒吧？！";
	next;
	mes "[Master]";
	mes "那么好！";
	mes "快问快答时间！";
	mes "你最喜欢的";
	mes "卡普拉女孩是谁？";
	next;
	if (Sex == SEX_FEMALE) {
		mes "[Master]";
		mes "哦，别担心。我知道女孩也会评价其他女孩的漂亮程度。";
		next;
	}
	if (select("太棒了！：不，我才不是色狼。") == 1) {
		mes "[Master]";
		mes "好，开始吧！";
		mes "选择你最喜欢的卡普拉小姐！";
		next;
		mes "[Master]";
		mes "最初的卡普拉吉祥物，经典的蓝发女士！一号候选人：^3355FF帕维安^000000！";
		next;
		mes "[Master]";
		mes "她优雅的马尾令人屏息！青少年男性最喜欢的候选人！二号候选人：^5533FF布洛瑟姆^000000！";
		next;
		mes "[Master]";
		mes "她的长直发如东方丝绸，是她的魅力所在。来自斐扬的三号候选人：^555555茉莉^000000！";
		next;
		mes "[Master]";
		mes "留着明亮橙色短发的假小子。四号候选人：^1133DD罗克茜^000000！";
		next;
		mes "[Master]";
		mes "聪明优雅，总戴着奢华眼镜。五号候选人：^33FF55莱拉^000000！";
		next;
		mes "[Master]";
		mes "漂亮可爱、清新稚嫩。虽然看起来年轻不成熟，但她是最棒的员工！";
		mes "六号候选人 ^AAAA00卷毛苏^000000！！";
		next;
		switch(select("（1）帕维安：（2）布洛瑟姆：（3）茉莉：（4）罗克茜：（5）莱拉：（6）卷毛苏")) {
		case 1:
			mes "[Master]";
			mes "哦~";
			mes "原来你喜欢经典。我非常尊重这一点。";
			next;
			mes "[Master]";
			mes "我猜你更喜欢原版电影而不是续集，也讨厌拙劣的模仿。对吗？";
			close;
		case 2:
			mes "[Master]";
			mes "嗯……";
			mes "布洛瑟姆是邻家女孩类型。看来你喜欢这种女孩，对吧？";
			close;
		case 3:
			mes "[Master]";
			mes "这样啊……";
			mes "长而华丽的头发对你很重要吗？这种头发确实让女性显得优雅。";
			close;
		case 4:
			mes "[Master]";
			mes "啊，原来你喜欢活泼率性的类型。我能理解……";
			next;
			mes "[Master]";
			mes "罗克茜并不是文静的家庭主妇类型，所以你对女性气质的定义应该很开放，对吧？";
			close;
		case 5:
			mes "[Master]";
			mes "啊，原来你喜欢知性类型。很好，很好。";
			next;
			mes "[Master]";
			mes "不过莱拉有时冷得像石头。我见过她拒绝许多年轻人，伤透更多人的心！";
			close;
		case 6:
			mes "[Master]";
			mes "你说什么？！";
			mes "她太年轻了！";
			close;
		}
	}
	mes "[Master]";
	mes "我可是为这项有趣的调查付出了很多努力！来吧，配合一下！欣赏美女就像欣赏艺术。";
	close;
}

aldeba_in,84,166,4	script	Kafra Service#alde	117,{
	cutin "kafra_01",2;
	mes "[Kafra Pavianne]";
	mes "欢迎！我是帕维安，";
	mes "卡普拉公司的资深员工之一。卡普拉服务一直努力满足顾客 100% 的期望。";
	next;
	mes "[Kafra Pavianne]";
	mes "由于客户支持政策变更，我们不再接受卡普拉通行证。但仍持有通行证的顾客可以申请退款。";
	next;
	if (select("出售卡普拉通行证：好的，再见~") == 1) {
		if (countitem(1084) == 0) {
			mes "[Kafra Pavianne]";
			mes "抱歉，";
			mes "但你没有";
			mes "卡普拉通行证。";
			close2;
			cutin "",255;
			end;
		}
		else {
			set .@kafrapassmoney,countitem(1084)*2000;
			mes "[Kafra Pavianne]";
			mes "让我看看……";
			if (countitem(1084) == 1) {
				mes "你有 1 张卡普拉通行证。";
				mes "可以卖给我们换取 2000 Zeny。要把它卖回卡普拉公司吗？";
			}
			else {
				mes "你有 "+ countitem(1084) +" 张卡普拉通行证。";
				mes "卖给我们可获得 "+ .@kafrapassmoney +" Zeny。要把它们卖回卡普拉公司吗？";
			}
			next;
			if (select("是：否") == 1) {
				if (countitem(1084) == 0) {
					mes "[Kafra Pavianne]";
					mes "抱歉，你没有卡普拉通行证。";
					close2;
					cutin "",255;
					end;
				}
				delitem 1084,countitem(1084); //Kapra's_Pass
				set Zeny,Zeny+.@kafrapassmoney;
				mes "[Kafra Pavianne]";
				mes "谢谢。";
			}
			close2;
			cutin "",255;
			end;
		}
	}
	mes "[Kafra Pavianne]";
	mes "谢谢，";
	mes "祝你今天愉快。";
	close2;
	cutin "",255;
	end;
}

aldeba_in,83,245,4	script	Kafra Service#2alde	116,{
	cutin "kafra_02",2;
	mes "[Kafra Blossom]";
	mes "欢迎来到";
	mes "卡普拉公司。";
	mes "卡普拉员工";
	mes "随时为你服务。";
	next;
	mes "[Kafra Blossom]";
	mes "感谢你一直使用卡普拉服务。如有问题请随时询问。";
	next;
	switch(select("卡普拉仓库如何运作？：你们如何传送人？")) {
	case 1:
		mes "[Kafra Blossom]";
		mes "像你这样的冒险者可以把物品放入卡普拉仓库，不必一直随身携带。";
		next;
		mes "[Kafra Blossom]";
		mes "卡普拉仓库窗口分为三个标签，物品会自动分类。";
		next;
		mes "[Kafra Blossom]";
		mes "^3355FF物品^000000、^3355FF装备^000000和^3355FF其他^000000标签与角色物品栏中的标签相同。";
		next;
		mes "[Kafra Blossom]";
		mes "物品和其他标签中，同类物品只占一个槽位。例如 324 个杰勒比结晶只占一个槽位，22 瓶红色药水占另一个槽位。";
		next;
		mes "[Kafra Blossom]";
		mes "但在装备标签中，每件物品都占用独立槽位，因为每件装备都能通过锻造或卡片进行独特升级。";
		next;
		mes "[Kafra Blossom]";
		mes "卡普拉仓库三个物品类别共有 300 个槽位，请记住这一点。";
		next;
		break;
	case 2:
		mes "[Kafra Blossom]";
		mes "哦，我经常被问到这个问题。“^CC0066布洛瑟姆，你是怎么做到的？^000000”嗯……";
		next;
		mes "[Kafra Blossom]";
		mes "当然，我不能透露太多细节，那是机密。不过我可以告诉你，传送是魔法与科技的结合。";
		next;
		mes "[Kafra Blossom]";
		mes "卡普拉女孩也不能独自传送顾客，我们只是接收并处理你的传送请求。";
		next;
		mes "[Kafra Blossom]";
		mes "幕后有熟练的专业人员和技术员全天工作，确保你快速安全地抵达目的地。";
		next;
		break;
	}
	mes "[Kafra Blossom]";
	mes "总之，希望你喜欢参观卡普拉总部。";
	if (rand(1,11) == 9) {
		next;
		mes "[Kafra Blossom]";
		mes "...";
		next;
		mes "[Kafra Blossom]";
		mes "...";
		mes "......";
		next;
		mes "[Kafra Blossom]";
		mes "哦，曼苏……";
	}
	close2;
	cutin "",255;
	end;
}


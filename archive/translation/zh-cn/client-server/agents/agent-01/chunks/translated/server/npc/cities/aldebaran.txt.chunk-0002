aldeba_in,232,241,4	script	RS125#alde	48,{
	mes "[RS125]";
	mes "我听起来可能不像人类，更像机器人，";
	mes "但希望你不要害怕我。我和你一样有人性。";
	next;
	mes "[RS125]";
	mes "我有一颗机械心脏，心脏发出的噪音可能会打扰你，";
	mes "但这不会阻止我为艾尔帕兰的未来努力。";
	next;
	if (select("听他的故事。：结束对话") == 1) {
		mes "[RS125]";
		mes "已经过去 3 年了。";
		mes "我的兄弟 996 曾是艾尔帕兰市队的短道运动员。";
		mes "那时人们因他惊人的腿速，";
		mes "给他起了‘艾尔帕兰的 Peco Peco’这个绰号……";
		next;
		mes "[RS125]";
		mes "他因精彩表现而大受欢迎，";
		mes "所以每四年举办一次‘艾尔帕兰极速赛’时，";
		mes "大陆各地的人都会来到这座城市，只为见我的兄弟。";
		mes "那时我是他的经理，也因他的粉丝而压力巨大。";
		next;
		mes "[RS125]";
		mes "但是，没有什么会永远持续……";
		mes "有一天，来自斐扬的女孩在比赛中击败了我的兄弟。";
		next;
		mes "[RS125]";
		mes "我的兄弟无法接受输掉比赛的事实，";
		mes "于是过度练习，导致严重心脏病发作。";
		mes "他现在还躺在床上。";
		next;
		mes "[RS125]";
		mes "我是兄弟唯一的希望，也是艾尔帕兰的未来！";
		mes "请祝我好运，我会击败来自斐扬的‘微风哈瓦那’！";
		close;
	}
	mes "[RS125]";
	mes "总有一天我想环游世界。";
	mes "如果能从艾尔贝塔港看到大海，一定很棒。";
	mes "明年体育比赛后，我要和兄弟一起环游世界。";
	close;
}

aldeba_in,223,121,4	script	Threatening-Looking Man	63,{
	mes "[Threatening-Looking Man]";
	mes "喂，未经允许不要进入别人的房子。";
	mes "这太荒唐了！";
	mes "你怎么敢闯进我家，还若无其事地跟我说话？";
	next;
	mes "[Threatening-Looking Man]";
	mes "哈哈哈哈……放松，我只是开玩笑。";
	next;
	if (select("继续：退出") == 1) {
		mes "[Threatening-Looking Man]";
		mes "你可能已经知道，";
		mes "这个世界有一种叫佣兵系统的制度。";
		mes "没错，我就是佣兵。";
		next;
		mes "[Threatening-Looking Man]";
		mes "很简单。你只需付钱请人帮助你战斗。";
		mes "想要更好的佣兵，就要付更多钱，明白吗？";
		next;
		mes "[Threatening-Looking Man]";
		mes "别再说无聊的事了。";
		mes "我来告诉你如何找到优秀的佣兵。";
		next;
		mes "[Threatening-Looking Man]";
		mes "检查他的鼻子是否干净湿润。";
		mes "优秀的佣兵必须有湿润的鼻子，";
		mes "这表示他的健康状况很好。";
		mes "如果鼻子干燥，就说明他感冒了。";
		next;
		mes "[Threatening-Looking Man]";
		mes "别忘了检查佣兵的脚踝。";
		mes "最好的佣兵有纤细的脚踝和白皙的脖子！";
		mes "长发更好！如果是卷曲的波浪发，那就完美了！";
		next;
		mes "[Threatening-Looking Man]";
		mes "最后要确认他是否准备好提供优质服务！";
		mes "也就是说，他必须尽力协助你战斗！";
		close;
	}
	mes "[Threatening-Looking Man]";
	mes "现在出去！";
	mes "如果你是警察，就出示搜查令；";
	mes "如果你是我的家人，就用胎记证明！";
	close;
}


	mes "[Kafra Roxie]";
	mes "欢迎~！";
	mes "卡普拉公司始终用优质服务支持米德加尔特的冒险者。";
	next;
	mes "[Kafra Roxie]";
	mes "我叫罗克茜！";
	mes "希望你喜欢";
	mes "参观这里的";
	mes "卡普拉公司的";
	mes "总部。";
	next;
	mes "[Kafra Roxie]";
	mes "我可以回答你关于卡普拉公司政策的问题，也会记录你的反馈。";
	next;
	switch(select("卡普拉政策：我爱卡普拉！")) {
	case 1:
		mes "[Kafra Roxie]";
		mes "你想了解政策和服务资格的更多详情吗？想让我解释什么？";
		next;
		switch(select("卡普拉仓库：手推车租赁：算了，没事。")) {
		case 1:
			mes "[Kafra Roxie]";
			mes "如你所知，顾客必须至少拥有基本技能等级 6 才能使用卡普拉仓库。";
			next;
			mes "[Kafra Roxie]";
			mes "制定这项政策是因为年轻的初心者常把所有东西都放进仓库，给我们带来过问题。";
			next;
			mes "[Kafra Roxie]";
			mes "想想你还是初心者的时候。一切新鲜刺激，但 Zeny 稀缺。许多初心者甚至会把武器和防具放进卡普拉仓库。";
			next;
			mes "[Kafra Roxie]";
			mes "但到这时，他们已经花掉仅有的 Zeny 打开仓库，却没有足够的钱再次使用仓库！";
			next;
			mes "[Kafra Roxie]";
			mes "于是这些没有武器和防具的初心者只能徒手战斗，直到攒够 Zeny 再次打开卡普拉仓库！";
			next;
			mes "[Kafra Roxie]";
			mes "这当然是个愚蠢的错误，但卡普拉公司重视生命，因此设定基本技能等级 6 的要求来避免此类事故。";
			break;
		case 2:
			mes "[Kafra Roxie]";
			mes "如你所知，卡普拉公司与商人、铁匠和炼金术师公会有特殊关系。";
			next;
			mes "[Kafra Roxie]";
			mes "卡普拉公司只向商人、铁匠和炼金术师租赁手推车，因为这些职业公会与我们有特殊合约。";
			next;
			mes "[Kafra Roxie]";
			mes "而且，把手推车租给不能制作或出售商品的人也不实际。";
			next;
			mes "[Kafra Roxie]";

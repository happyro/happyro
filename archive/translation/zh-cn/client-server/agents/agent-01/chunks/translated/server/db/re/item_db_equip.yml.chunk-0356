      Third: true
    Locations:
      Head_Top: true
    ArmorLevel: 2
    EquipLevelMin: 235
    Refineable: true
    Gradable: true
    View: 2415
    Script: |
      .@g = getenchantgrade();
      .@r = getrefine();
      bonus bBaseAtk,10*(.@r/2);
      bonus2 bSkillAtk,"NW_THE_VIGILANTE_AT_NIGHT",4*(.@r/3);
      bonus2 bSkillAtk,"NW_SPIRAL_SHOOTING",4*(.@r/3);
      if (.@r>=7) {
         bonus bDelayrate,-10;
         if (.@r>=9) {
            bonus bLongAtkRate,10;
            bonus bCritAtkRate,10;
            if (.@r>=11) {
               bonus bFixedCast,-300;
               bonus bAtkRate,5;
            }
         }
      }
      if (.@g>=ENCHANTGRADE_D) {
         bonus bPAtk,3;
         bonus bPow,5;
         bonus bCon,5;
         if (.@g>=ENCHANTGRADE_C) {
            bonus bLongAtkRate,10;
            bonus bCritAtkRate,10;
            if (.@g>=ENCHANTGRADE_B) {
               bonus bFixedCast,-200;
               bonus bAtkRate,5;
               if (.@g>=ENCHANTGRADE_A) {
                  bonus bCritAtkRate,15;
                  bonus bLongAtkRate,15;
                  bonus bPAtk,5;
               }
            }
         }
      }

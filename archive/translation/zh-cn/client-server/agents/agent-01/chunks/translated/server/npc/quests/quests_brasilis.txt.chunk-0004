		if(select("继续。:你是月亮吗？") == 1) {
			mes "[Recluse]";
			mes "你没有特别的事找我。";
			close;
		}
		mes "[Recluse]";
		mes "月亮？我叫贾西。我们家世代照料睡莲。";
		next;
		mes "[Jasi]";
		mes "巴西利斯睡莲很害羞，不会在人前出现，只在少数地方开花。我想它们喜欢这里，所以我才待了这么久。";
		next;
		mes "[Jasi]";
		mes "我们家族细心照料睡莲，防止被人或魔物伤害。";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "你记得一个叫贾西的女孩吗？";
		next;
		mes "[Jasi]";
		mes "贾……西……啊！！一个风风火火的女孩。天啊，我就是被她搞得很麻烦。";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "麻烦？";
		next;
		mes "[Jasi]";
		mes "一天一位伤痕累累的女孩出现，我帮助了她。后来她突然想摘睡莲，还要我娶她或把她变成睡莲，真是疯了！";
		next;
		mes "[Jasi]";
		mes "我好不容易让她冷静并送回村子。睡莲就是我的人生，我不想发生丢脸的事。";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "这是贾希拉为那次事件道歉的礼物。她因个人困难无法亲自来，非常难过。";
		next;
		if (countitem(513) < 10) {
			mes "[Jasi]";
			mes "你说什么？";
			next;
			mes "- 对了，我忘了带10根香蕉 -";
			close;
		}
		mes "[Jasi]";
		mes "啊！香蕉！好久没见了。她真体贴，对吧？";
		next;
		mes "[Jasi]";
		mes "总之，你找我就是这些事吗？";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "嗯，说实话我想找睡莲，偶然遇到你。贾希拉告诉我她的悲伤故事，所以我来到这里。";
		next;
		mes "[Jasi]";
		mes "我明白了。如你所见，这里有很多巴西利斯睡莲。只要保证不破坏它们，你可以尽情欣赏。";
		brazil_regia = 4;
		changequest 2202,2203;
		close;
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
//
	}
	else if (brazil_regia == 4) {
		mes "[Jasi]";
		mes "欣赏睡莲愉快吗？";
		close;
	}
	else if (brazil_regia == 5) {
		mes "[Jasi]";
		mes "我忘了那种水果叫什么……";
		close;
	}
	else if (brazil_regia == 6) {
		if (countitem(11515) < 5) {
			mes "[Jasi]";
			mes "我忘了那种水果叫什么……";
			close;
		}
		else {
			mes "[Jasi]";
			mes "找到水果了吗？哦，对了，这是……？";
			next;
			mes "["+strcharinfo(0)+"]";
		mes "它叫“椰子”。";
			next;
			mes "[Jasi]";
		mes "啊哈！椰子！！我想起来了，谢谢。真不记得上次吃这种水果是什么时候。";
			next;
			mes "[Jasi]";
		mes "看来该兑现承诺了。你可以摘一朵睡莲。";
			next;
			mes "[Jasi]";
		mes "希望巴西利斯睡莲能理解我。趁机会赶快摘花吧～";
			next;
			mes "[Jasi]";
		mes "能替我告诉贾希拉一件事吗？告诉她我不是故事中的月亮，但想成为只为她照耀的月亮。";
			delitem 11515,5; //Coconut
			brazil_regia = 7;
			changequest 2205,2206;
			close;
		}
	}
	else {
		mes "[Jasi]";
		mes "今天睡莲开的花真美。";
		close;
	}
	end;

OnTouchNPC:
	unitwarp 0,"this",67,215;
	end;
}

bra_dun02,71,200,3	script	Water lily#bra	HIDDEN_NPC,{
	if (brazil_regia == 4) {
		mes "一朵奇特的睡莲在这里盛开。想到很少有人见过它开花，你目不转睛地看着。";
		next;
		if(select("摘下花朵。:继续凝视。") == 2) {
			mes "- 你无法移开对它美丽的注视。 -";
			close;
		}
		mes "[Jasi]";
		mes "呃！你在做什么？！";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "有人真的需要这朵花，我可以摘一朵吗？";
		next;
		mes "[Jasi]";
		mes "我之前说过，我是睡莲守护者。不能眼睁睁看你摘下一朵。";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "嘿～我给你带了美味水果……尝尝！这是成熟又新鲜的香蕉。";
		next;
		if (countitem(513) < 10) {
			mes "[Jasi]";
			mes "你说什么？";
			next;
			mes "- 对了，我忘了带10根香蕉 -";
			close;
		}
		mes "[Jasi]";
		mes "嗯……我好久没吃这种水果了。";
		next;
		mes "[Jasi]";
		mes "我只尝一个。就一个。";
		next;
		mes "- 咀嚼 -";
		mes "- 咕哝咕哝 -";
		specialeffect EF_POTION7,AREA,"Recluse#bra";
		next;
		mes "[Jasi]";
		mes "呃，这个味道……是！我记得妈妈会把它烤成美味面包！";
		next;
		mes "[Jasi]";
		mes "让我想念童年。";
		next;
		emotion ET_HUK, getnpcid(0, "Recluse#bra");
		mes "[Jasi]";
		mes "呵呵！！！！我记得自己一直在这里……甚至没有时间做吃美味水果这样的简单事情。";
		next;
		mes "[Jasi]";
		mes "香蕉真的很美味。但规则就是规则！";
		mes "我必须履行职责。";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "求你了！我只需要一朵花～怎样才能说服你？";
		next;
		mes "[Jasi]";
		mes "规则就是规则，你想让我怎样？";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "香蕉让你想起童年了吗？我能为你做什么？";
		next;
		mes "[Jasi]";
		mes "你这么一说，我确实很想念一种水果。年轻时我最喜欢，但忘了叫什么。";
		next;
		mes "[Jasi]";
		mes "它是棕色的，外面有坚硬外壳，里面有果汁，吃完后还能当杯子。你知道是什么吗？";
		next;
		mes "[Jasi]";
		mes "如果你带来5个，我会重新考虑你的建议。";
		delitem 513,10; //Banana
		brazil_regia = 5;
		changequest 2203,2204;
		next;
		mes "["+strcharinfo(0)+"]";
		mes "好，我得带来5个硬壳水果。嗯，是什么呢？";
		close;
	}
	else if (brazil_regia == 5) {
		mes "[Jasi]";
		mes "年轻时我最喜欢，但忘了叫什么。";
		next;
		mes "[Jasi]";
		mes "它是棕色的，外壳坚硬，里面有果汁，吃完还能当杯子。你知道是什么吗？";
		close;
	}
	else if (brazil_regia == 7) {
		if (!checkweight(1201,1)) {
		mes "- 等一下！！ -";
		mes "- 你携带的物品太多，无法获得更多。 -";
		mes "- 减轻负重后再试。 -";
			close;
		}
	mes "- 你小心地将美丽的睡莲捧在手中。 -";
		brazil_regia = 8;
		getitem 7553,1; //Lotus_Flower
		close;
	}
}


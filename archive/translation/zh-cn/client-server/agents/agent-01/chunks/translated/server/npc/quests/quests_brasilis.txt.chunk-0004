		mes "[Mariana]";
	mes "咔咔咔啊啊啊！！虫子！！赶走它们！";
		close;
	}
}

brasilis,180,249,5	script	Daniel#bra	4_M_KID1,{
	if (brazil_ghost == 0) {
		doevent "Pedro#bra::OnTalk";
		end;
	}
	else if (brazil_ghost == 1) {
		mes "[Daniel]";
	mes "喵喵喵～";
		close;
	}
	else {
		mes "[Daniel]";
	mes "嘿嘿，在这里～我又发现更多虫子～";
		close;

brasilis,185,246,5	script	Pedro#bra	1_M_SIZ,{
	if (brazil_ghost == 0) {
		OnTalk:
		mes "[Pedro]";
		mes "哇，真是壮观的雕像！";
		next;
		mes "[Mariana]";
		mes "是吧？这座雕像叫维拉斯纪念碑。";
		next;
		mes "[Mariana]";
		mes "很久以前，有位勇敢冒险者叫维拉斯。多亏他坚持探索，巴西利斯才发展成这座伟大城市。";
		next;
		mes "[Pedro]";
		mes "太棒了！！";
		mes "我想成为像维拉斯一样真正的男子汉。";
		next;
		mes "[Mariana]";
		mes "佩德罗，你可以成为想成为的任何人。";
		next;
		mes "[Pedro]";
		mes "玛丽安娜真聪明，对吧？嘿嘿。";
		next;
		mes "[Fabio]";
		mes "哦哦哦！你喜欢她，对吧！";
		next;
		mes "[Daniel]";
		mes "哇啊啊，佩德罗和玛丽坐在树上！";
		next;
		mes "[Fabio]";
		mes "接、接、接吻～！！！";
		next;
		mes "[Daniel]";
		mes "喵喵喵！";
		next;
		mes "[Fabio]";
		mes "哈哈哈哈哈。";
		next;
		mes "[Pedro]";
		mes "别像小孩子一样胡闹！";
		next;
		mes "[Mariana]";
		mes "男孩子们～！";
		next;
		mes "[Daniel]";
		mes "好啦好啦……嘿，你们听说几天前发生的事了吗？";
		next;
		mes "[Mariana]";
		mes "哦～我听说发生了非常可怕的事。";
		next;
		mes "[Fabio]";
		mes "呃，所以玛丽安娜吓得三天不敢去厕所，到处都臭烘烘的。呜呜～";
		next;
		mes "[Daniel]";
		mes "哈哈哈！臭玛丽！";
		next;
		mes "[Mariana]";
		mes "我讨厌你～！别散布关于我的谣言。我才不怕厕所。佩德罗，你觉得我臭吗？";
		next;
		mes "[Pedro]";
		mes "呃？呃？不……不会……不可能。嘿，大家对她好点～";
		next;
		mes "[Fabio]";
		mes "咔咔咔咔咔咔";
		next;
		mes "[Daniel]";
		mes "咔咔咔咔咔";
		next;
		if(select("Walk by.:Ask about the gossip.") == 1) {
			mes "[Fabio]";
			mes "玛丽安娜～好臭～喵喵～";
			next;
			mes "[Daniel]";
		mes "哎呀你也臭～！喵喵～";
			close;
		}
		mes "[Fabio]";
		mes "你没听说吗？美术馆里的幽灵故事。";
		next;
		mes "[Daniel]";
		mes "哦哦哦！好可怕～～～！";
		next;
		select("你能再多告诉我一些吗？");
		mes "[Fabio]";
		mes "几天前我们学校去美术馆野餐。没什么特别的，就是普通郊游。";
		next;
		mes "[Fabio]";
		mes "博物馆太无聊了，我和几个朋友偷偷离开队伍～！";
		next;
		mes "[Fabio]";
		mes "就在那时，我们听到尖叫声回荡在整个博物馆。";
		next;
		mes "[Daniel]";
		mes "咔咔咔啊啊啊！！咿——！呵呵……";
		next;
		mes "[Mariana]";
		mes "我也听到了尖叫……你们男孩子总是在不该出声的地方制造噪音。";
		next;
		mes "[Pedro]";
		mes "我们还能做什么？我们不做就会有人做。";
		next;
		emotion ET_FRET, getnpcid(0, "Mariana#bra");
		mes "[Mariana]";
		mes "啊～男孩子有时真让人头疼。";
		next;
		select("那么后来发生了什么？");
		mes "[Fabio]";
		mes "我和丹尼尔猜到有怪事，就跑向尖叫传来的地方。";
		next;
		mes "[Fabio]";
		mes "尖叫来自厕所。有些孩子吓得也开始尖叫并闭上眼睛，场面很糟。";
		next;
		mes "[Daniel]";
		mes "我觉得你尿裤子或拉裤子了。味道难闻死了。";
		next;
		mes "[Fabio]";
		mes "才不是～是你妈妈尿裤子了～喵！";
		next;
		mes "[Daniel]";
		mes "才不是～是你～尿裤子了～";
		next;
		mes "[Fabio]";
		mes "总之，美术馆幽灵的传闻就是这样开始的。";
		next;
		mes "[Daniel]";
		mes "骗子，根本没有幽灵～";
		next;
		select("So was it a ghost?");
		mes "[Fabio]";
		mes "我怎么知道？没人敢说看到了，也没人想被老师惩罚。";
		next;
		mes "[Pedro]";
		mes "我听说说出特殊魔法咒语，幽灵就会出现。";
		next;
		mes "[Daniel]";
		mes "佩德罗，别插嘴。";
		next;
		mes "[Fabio]";
		mes "是啊，佩德罗，你在说什么？你看到幽灵了吗？";
		next;
		mes "[Pedro]";
		mes "不……没有。我害怕幽灵。但朋友说看到了，他们不会撒谎。";
		next;
		select("有人告诉你魔法咒语了吗？");
		mes "[Pedro]";
		mes "我在一首歌里听到过。特殊魔法咒语是……";
		next;
		mes "[Pedro]";
		mes "'^3131FF妈妈，门打不开！^000000'";
		mes "'^FF0000把钥匙转过彩虹的颜色数那么多次。^000000'";
		mes "'^3131FF妈妈，水要漫出来了！^000000'";
		mes "'^FF0000月亮消失 3 次的话，不用担心。^000000'";
		mes "'^3131FF妈妈，旱灾开始了！^000000'";
		mes "'^FF0000别担心，瀑布会帮助它。^000000'";
		mes "'^3131FF妈妈，我的朋友在哪里？^000000'";
		mes "'^FF0000你的 7 个朋友正在睡觉。现在该叫醒他们了。^000000'";
		mes "'^3131FF妈妈，你在哪里？^000000'";
		next;
		mes "[Mariana]";
		mes "嗯，听起来像谜语。";
		next;
		select("想帮我找到这个幽灵吗？");
		mes "[Pedro]";
		mes "朋友，你自己想吧～";
		next;
		mes "[Mariana]";
		mes "我不喜欢恐怖的东西！";
		next;
		mes "[Fabio]";
		mes "噗，我不敢相信你会相信那个故事。";
		next;
		mes "[Daniel]";
		mes "我一如既往地跟着法比奥做！";
		next;
		mes "[Fabio]";
		mes "也许你只是害怕……";
		brazil_ghost = 1;
		setquest 2208;
		close;
	}
	else if (brazil_ghost == 1) {
		mes "[Pedro]";
	mes "想再听一遍魔法咒语吗？";
		next;
		mes "[Pedro]";
		mes "'^3131FF妈妈，门打不开！^000000'";
		mes "'^FF0000把钥匙转过彩虹的颜色数那么多次。^000000'";
		mes "'^3131FF妈妈，水要漫出来了！^000000'";
		mes "'^FF0000月亮消失 3 次的话，不用担心。^000000'";
		mes "'^3131FF妈妈，旱灾开始了！^000000'";
		mes "'^FF0000别担心，瀑布会帮助它。^000000'";
		mes "'^3131FF妈妈，我的朋友在哪里？^000000'";
		mes "'^FF0000你的 7 个朋友正在睡觉。现在该叫醒他们了。^000000'";
		mes "'^3131FF妈妈，你在哪里？^000000'";
		close;
	}
	else {
		mes "[Pedro]";
	mes "要怎样才能让人给我做雕像呢？";
		close;
	}
}

brasilis,187,244,1	script	Mariana#bra	1_F_MARIA,{
	if (brazil_ghost == 0) {
		doevent "Pedro#bra::OnTalk";
		end;
	}
	else if (brazil_ghost == 1) {
		mes "[Mariana]";
	mes "你们能别再谈幽灵了吗？我已经起鸡皮疙瘩了。";
		close;
	}
	else {
		mes "[Mariana]";
	mes "法比奥和丹尼尔为什么总来烦我们？";
		close;
	}
}

brasilis,181,250,5	script	Fabio#bra	4_M_KID1,{
	if (brazil_ghost == 0) {
		doevent "Pedro#bra::OnTalk";
		end;
	}
	else if (brazil_ghost == 1) {
		mes "[Fabio]";
	mes "你还在为那个幽灵故事浪费时间？";
		close;
	}
	else {
		mes "[Fabio]";
	mes "玛丽安娜，想看点酷的吗？";

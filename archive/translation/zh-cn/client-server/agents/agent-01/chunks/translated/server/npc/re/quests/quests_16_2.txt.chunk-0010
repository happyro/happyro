				mes "[USU commander Elena]";
			mes "……那我就不能告诉你了。";
			mes "忘了我说过的话吧。";
				close3;
			}
			mes "[USU commander Elena]";
		mes "是的。一定要保守秘密。";
			next;
			mes "[USU commander Elena]";
		mes "很好。首先……你知道我指挥的 USU 吗？";
			next;
			if (select( "高级……单位？", "不是你们隔离问题儿童的地方吗？" ) == 1) {
				mes "[USU commander Elena]";
				mes "……不，不是那样。";
				mes "实际上正好相反。";
			}
			else {
				mes "[USU commander Elena]";
				mes "……什么？";
				next;
				cutin "162elena_02.bmp",2;
				mes "[USU commander Elena]";
				mes "哈哈……卡卡。没错，你很了解它。";
				mes "但别在士兵面前这么说，他们可能会开枪。";
			}
			next;
			cutin "162elena_01.bmp",2;
			mes "[USU commander Elena]";
			mes "USU 是^0000CD封印部队^000000的缩写。这是一群做过疯狂事情的怪人。";
			mes "因为他们为反叛军立下过大功，我们没有判处死刑或开除，而是将他们隔离，并在脖子上套上铅圈。";
			next;
			mes "[USU commander Elena]";
			mes "正如我所说，这是一个不受我们规章约束的单位，所以不能详细告诉你。但我们会做一些反叛军不会做的事。";
			mes "你可以尽情想象，包括谋杀或暴力。实际情况会比那更糟。";
			next;
			mes "[USU commander Elena]";
			mes "但我们仍有一条绝对规则：不能干扰其他反叛军。";
			mes "虽然我们允许他们在外面随心所欲，但会让他们知道谁牵着他们脖子上的铅圈。";
			next;
			mes "[USU commander Elena]";
			mes "最近来了新成员……^0000CD亚娜·列别杰娃^000000和^0000CD伊利亚·列别杰夫^000000。他们是双胞胎，还很年轻。";
			mes "虽然年轻，但能力出众。问题在于他们不受控制。";
			next;
			mes "[USU commander Elena]";
			mes "他们逃避训练，还在训练中制造事故，弄伤了一名队员……最近他们试图逃离部队，结果被抓了回来。所以值班负责人和我都很头疼。";
			next;
			mes "[USU commander Elena]";
			mes "按照规定，我们必须开除他们。";
			mes "……但他们还未成年。据他们原部队的指挥官说，他们没有父母。";
			next;
			mes "[USU commander Elena]";
			mes "如果把他们赶出去，他们可能会成为小混混。最糟糕的是，他们会卷入犯罪。";
			mes "由 USU 指挥官的我说这些，听起来真可笑……";
			next;
			emotion ET_THINK;
			mes "[USU commander Elena]";
			mes "至少我不想看到孩子们自甘堕落。";
			mes "但从他们的行为来看，他们最多只能作为戴着铅圈的野兽活在 USU。";
			next;
			mes "[USU commander Elena]";
			mes "……也许他们已经把我当成敌人了，所以不会听我的。";
			mes "我知道怎么让他们听话，但那只会让情况更糟。";
			next;
			mes "[USU commander Elena]";
			mes "所以我想请你调查并解决他们的问题，冒险者。";
			mes "如果他们什么都不说，就去问问身边的其他同伴。";
			next;
			mes "[USU commander Elena]";
			mes "你愿意帮我吗？";
			next;
			if (select( "我会帮忙。", "不。" ) == 2) {
				mes "[USU commander Elena]";
				mes "我不想强迫你做这件事。";
				mes "这是我们部队内部的问题，还是由我们自己处理比较好。";
				next;
				mes "[USU commander Elena]";
				mes "忘了我告诉你的事吧。";
				close3;
			}
			mes "[USU commander Elena]";
		mes "谢谢。";
		mes "^0000CD亚娜和伊利亚双胞胎^000000在大厅里。";
		mes "他们有明亮的银发，总是形影不离。你很容易找到他们。";
			next;
			mes "[USU commander Elena]";
		mes "如果和他们谈过后没有结果，就去问问其他同伴。";
		mes "食堂工作人员……还有外面商店里的另一位同伴似乎也想说些什么。";
		npctalk "埃琳娜·沃尔科娃：他们是内米耶里氏族的梅森和米洛吗……？", "", bc_self;
			setquest 16012;// Troublesome twin
			lebedev_quest_16_2 = 1;
			questinfo_refresh();
			close3;
		}
		if (lebedev_quest_16_2 == 1) {
			mes "[USU commander Elena]";
			mes "那么，你和他们谈过了吗？";
			mes "嗯，还没有……";
			next;
			mes "[USU commander Elena]";
			mes "现在我能信任的只有你。";
			mes "拜托你了，冒险者。";
			close3;
		}
		if (lebedev_quest_16_2 < 5) {
			mes "[USU commander Elena]";
			mes "你和他们谈过了吗？";
			next;
			mes "[USU commander Elena]";
			mes "如果你很难判断，就去和他们身边的^0000CD其他同伴^000000谈谈。";
			npctalk "埃琳娜·沃尔科娃：看来米洛和梅森有很多话要说。", "", bc_self;
			close3;
		}
		if (lebedev_quest_16_2 == 5) {
			mes "[USU commander Elena]";
			mes "怎么样了？";
			next;
			emotion ET_THINK;
			mes "[USU commander Elena]";
			mes "嗯……一点进展都没有？";
			mes "我以为他们可能会向陌生人敞开心扉，但我错了。";
			next;
			mes "[USU commander Elena]";
			mes "……最后还有一个人你应该去谈谈。";
			mes "我本来不想这么做。";
			npctalk "埃琳娜·沃尔科娃：如果可以，我本想自己解决这个问题。", "", bc_self;
			next;
			mes "[USU commander Elena]";
			mes "下楼去找^0000CD埃里克松·阿德勒，独立部队指挥官^000000。他应该就在壁炉附近。";
			mes "他是个中年男人……也是双胞胎以前的上司。";
			next;
			mes "[USU commander Elena]";
			mes "既然他们被分配到我的部队，我本想在这里照顾他们，但他们并不配合。";
			mes "如果我亲自向阿德勒询问他们的事，场面会很难看。所以才拜托你。拜托了。";
			erasequest 16015;// The cause of failure is a careless attempt
			setquest 16016;// Borrowing wisdom of the experts
			lebedev_quest_16_2 = 6;
			questinfo_refresh();
			close3;
		}
		if (lebedev_quest_16_2 == 6) {
			mes "[USU commander Elena]";
			mes "^0000CD埃里克松·阿德勒，独立部队指挥官^000000应该就在壁炉附近。";
			next;
			mes "[USU commander Elena]";
			mes "他是双胞胎以前的上司。";
			npctalk "埃琳娜·沃尔科娃：我不想这样做。", "", bc_self;
			close3;
		}
		if (lebedev_quest_16_2 == 7) {
			mes "[USU commander Elena]";
			mes "现在进展如何？";
			close3;
		}
		if (lebedev_quest_16_2 == 8) {
			cutin "",255;
		mes "你把列别杰夫双胞胎告诉你的事转告给了埃琳娜·沃尔科娃。";
			next;
			cutin "162elena_01.bmp",2;
			mes "[USU commander Elena]";
		mes "原来……是因为这个。";
		mes "我已经听说过那起事故。";
			next;
			mes "[USU commander Elena]";
		mes "但我没想到这给他们造成了这么大的负担。";
		mes "因为他们一直不受控制……我根本无法察觉。";
			next;
			emotion ET_THINK;
			mes "[USU commander Elena]";
		mes "毕竟他们还是孩子。因为能力很强，我和其他队员一直把他们当成成年人对待。";
		mes "我们不该这样做……";
			next;
			mes "[USU commander Elena]";
			mes "而且我本该提前和阿德勒谈谈。";
			mes "谢谢你，" + strcharinfo(0) + "。你帮了我大忙。";
			next;
			mes "[USU commander Elena]";
			mes "看来无论如何我都得和他们谈谈。";
			mes "你能再帮我一次吗？告诉他们我在找他们，并请你带他们过来。";
			erasequest 16017;// Twin's sincere confession
			setquest 16018;// Encourage instead of punishment
			lebedev_quest_16_2 = 9;
			questinfo_refresh();
			close3;
		}
		if (lebedev_quest_16_2 == 9) {
			mes "[USU commander Elena]";
			mes "双胞胎应该就在他们一直待的地方附近。";
			mes "告诉他们我的意思，再带他们回来。";
			close3;
		}
		if (lebedev_quest_16_2 == 10) {
			mes "[USU commander Elena]";
			mes "你们都来了？我已经听说了事情的经过。";
			next;
			cloakoffnpcself( "Ilya Lebedev#16.2rms" );
			cloakoffnpcself( "Jana Levedeva#16.2rms" );
			cutin "",255;
			mes "[Ilya Lebedev]";
			mes "是。";
			next;
			mes "[Jana Levedeva]";
			mes "……是……";
			next;
			cutin "162elena_01.bmp",2;
			mes "[USU commander Elena]";
			mes "亚娜·列别杰娃和伊利亚·列别杰夫！立正！";
			npctalk "雅娜·列别捷娃：是！", "Jana Levedeva#16.2rms", bc_self;
			npctalk "伊利亚·列别捷夫：是！没错！", "Ilya Lebedev#16.2rms", bc_self;
			next;
			emotion ET_ANGER, getnpcid(0, "Elena Volkova#16.2rm");
			mes "[USU commander Elena]";
			mes "你们疯了吗？因为私事逃离部队，还弄伤了同伴！";
			next;
			mes "[USU commander Elena]";
			mes "这里看起来也许像一群乌合之众组成的佣兵团，但我们面对的是人的生命。你们必须遵守纪律。";
			next;
			cutin "",255;
			mes "[Lebedev twins]";
			mes "......";
			next;
			mes "[Lebedev twins]";
			mes "……对不起……";
			next;
			cutin "162elena_01.bmp",2;
			mes "[USU commander Elena]";
			mes "但在责备你们之前……";
			mes "我很抱歉。";
			npctalk "Jana Levedeva: Pardon...?", "Jana Levedeva#16.2rms", bc_self;
			npctalk "伊利亚·列别捷夫：抱歉……？", "Ilya Lebedev#16.2rms", bc_self;
			next;
			mes "[USU commander Elena]";
			mes "我不知道你们承受了这么大的压力，也没有意识到这一点。虽然我是你们的上司，却没有及时开导你们。";
			next;
			mes "[USU commander Elena]";
			mes "这完全是我的过错和失误。";
			mes "我向你们道歉。你们一直过得很辛苦。";
			npctalk "Elena Volkova: I sincerely apologize.", "", bc_self;
			next;
			cutin "",255;
			mes "[Lebedev twins]";
			mes "……不，不……该道歉的是我们。";
			next;
			cutin "162elena_01.bmp",2;
			mes "[USU commander Elena]";
			mes "今后我会更加关注你们。";
			mes "请你们努力确保这种事不再发生，好吗？";
			next;
			cutin "",255;
			mes "[Jana Levedeva]";
			mes "……不……该道歉的是我们。";
			next;
			mes "[Ilya Lebedev]";
			mes "不会再发生了……";
			next;
			cutin "162elena_01.bmp",2;
			mes "[USU commander Elena]";
			mes "既然这是军事组织，你们就必须遵守规章。";
			mes "但你们还未成年，我希望尽可能给你们成长的机会。";
			next;
			mes "[USU commander Elena]";
			mes "亚娜·列别杰娃和伊利亚·列别杰夫，我会暂时让你们远离真正的战斗。";
			mes "相反，你们可以自由完成部队内部力所能及的工作。";
			next;
			mes "[USU commander Elena]";
			mes "你们可以结交新朋友、培养兴趣，或提高射击能力，甚至可以做一些我意想不到的事。";
			mes "去做你们想做的事吧，但一定要遵守规章。";
			next;
			cutin "",255;
			mes "[Jana Levedeva]";
			mes "所以我们……不会被赶出去？";
			next;
			cutin "162elena_01.bmp",2;
			mes "[USU commander Elena]";
			mes "别让我重复第二遍。我说过，我会对发生的一切负责。";
			next;
			cutin "",255;
			mes "[Ilya Lebedev]";
			mes "哦……太谢谢你了！";
			mes "还有……对不起。";
			npctalk "伊利亚·列别捷夫：对不起……沃尔科娃指挥官……", "Ilya Lebedev#16.2rms", bc_self;
			next;
			mes "[Jana Levedeva]";
			mes "谢谢你，指挥官……！";
			npctalk "雅娜·列别捷娃：对不起……", "Jana Levedeva#16.2rms", bc_self;
			next;
			cutin "162elena_02.bmp",2;
			mes "[USU commander Elena]";
			mes "事情就是这样。你们现在可以回去了。我还有些事想和冒险者谈。";
			mes "如果有什么需要，随时来找我。";
			next;
			cutin "",255;
			mes "[Lebedev twins]";
			mes "是！";
			next;
			cloakonnpcself( "Ilya Lebedev#16.2rms" );
			cloakonnpcself( "Jana Levedeva#16.2rms" );
			cutin "162elena_01.bmp",2;
			mes "[USU commander Elena]";
			mes "呼……";
			mes "干得好，" + strcharinfo(0) + "。";
			mes "多亏你的支持和关心，我们才能做到这些。";
			next;
			mes "[USU commander Elena]";
			mes "哈……我让他们去做自己想做的事，他们会困惑一阵子，不知道该做什么。";
			mes "要让那两个孩子做自己想做的事，他们还需要你的帮助。";
			mes "到时候请再帮帮他们。";
			next;
			cutin "162elena_02.bmp",2;
			mes "[USU commander Elena]";
			mes "……谢谢。";
			mes "今后也拜托你了。";
			completequest 16019;// Elena Volkova's Solution
			getexp 200000,200000;
			getitem 25155,10;// Swz_Honor_Token
			lebedev_quest_16_2 = 11;
			questinfo_refresh();
			close3;
		}
		mes "[USU commander Elena]";
		mes "你把他们照顾得好吗？";
		mes "哇，现在有保姆照顾他们，我就放心了。";
		next;
		cutin "162elena_02.bmp",2;
		mes "[USU commander Elena]";
		mes "哈哈！开个玩笑。谢谢你的支持，你真可靠。";
		mes "请照顾好那两个孩子。";
		close3;
	}
	end;

OnInit:
	questinfo( QTYPE_QUEST, QMARK_NONE, "isbegin_quest(16011) == 0 && isbegin_quest(14602) == 1" );
	questinfo( QTYPE_QUEST, QMARK_NONE, "isbegin_quest(16061) == 2" );
	questinfo( QTYPE_QUEST, QMARK_NONE, "checkquest(16010,PLAYTIME) == 2" );

	// twin quest main
	questinfo( QTYPE_QUEST, QMARK_NONE, "terra_gloria_main > 16 && (lebedev_quest_16_2 == 0 || lebedev_quest_16_2 == 5 || lebedev_quest_16_2 == 8 || lebedev_quest_16_2 == 10)" );

	// twins daily quest : "Service: Cookies delivery"
	questinfo( QTYPE_QUEST, QMARK_NONE, "isbegin_quest(16031) == 1 && countitem(25161) > 0" );
	end;
}

rebel_in,177,30,3	script	Sorita Doritas#16.2rm	4_M_GUNSLINGER3,{
	mes "[Tough Guy Sorita]";
	mes "这次又怎么了？";
	next;
	if (select( "我想出去。", "没什么。" ) == 2) {
		mes "[Tough Guy Sorita]";
		mes "没话说就别来找我。";
		close;
	}
	mes "[Tough Guy Sorita]";
	mes "你在说什么？你是说想不战斗就逃跑，对吧？";
	next;
	mes "[Tough Guy Sorita]";
	mes "你一定是在开玩笑。这是什么胡话！你当初为什么要来这里烦我？";
	next;
	emotion ET_FRET;
	mes "[Tough Guy Sorita]";
	mes "该死，指挥官把这份无聊的工作交给我后，我已经够烦了。你又让我更烦。赶紧滚出去！";
	close2;
	warp "rebel_in",68,76;
	end;
}

// rebel_in,177,28,5	script	Ivan Ivanov#16.2rm	4_M_REBELLION2,10,10,{
// rebel_in,177,28,3	script	Ivan Ivanov#16.2rmA	HIDDEN_NPC,{
rebel_in,177,28,5	script	Ivan Ivanov#16.2rm	4_M_REBELLION2,{
	end;
OnInit:
	questinfo( QTYPE_QUEST, QMARK_NONE, "isbegin_quest(16061) == 1" );
	waitingroom "Enter Rebellion arena",20,"Ivan Ivanov#16.2rm::OnEvent",1;
	end;
OnEvent:
	if (.event_start == 0) {
		.event_start = 1;
		cloakoffnpc "#job_rmA";
		warpwaitingpc "rebel_in",201,19;
	}
	end;
OnStart:
	initnpctimer;
	end;
OnTimer3000:
	stopnpctimer;
	disablenpc "Naga#16.2rmA";
	areawarp "rebel_in",192,12,207,27,"rebel_in",68,76;
	.event_start = 0;
	if (getwaitingroomstate(33) == true)	// warp next player in waitingroom
		donpcevent "Ivan Ivanov#16.2rm::OnEvent";
	end;
}

rebel_in,200,19,0	script	#job_rmA	HIDDEN_WARP_NPC,12,12,{
	end;
OnTouch:
	cloakonnpc "#job_rmA";
	donpcevent "Milo River#16.2rmA::OnStart";
	.base_job = BaseJob;
	end;
OnStart:
	monster "rebel_in",201,19, "Elena Volkova",3630,1, "#job_rmA::OnMobDead";	// EP16_2_E_BOLKOBA
	if (.base_job == Job_Priest)
		setunitdata $@mobid[0], UMOB_HP, 19000;
	else
		setunitdata $@mobid[0], UMOB_HP, 1100000;
	end;
OnMobDead:
	stopnpctimer;
	completequest 16061;	// Fair and equitable result
	npctalk "米洛·里弗：" + strcharinfo(0) + "，你赢了！可以出去庆祝了。三秒后将移动到大厅。";
	donpcevent "Ivan Ivanov#16.2rm::OnStart";
	enablenpc "Naga#16.2rmA";
	end;
OnInit:
	cloakonnpc "#job_rmA";
	end;
}


			mes "我有个主意。";
			next;
			emotion ET_DELIGHT;
			mes "[西皮]";
			mes "嗯？什么主意？";
			next;
			mes "[妮伦大主教]";
			mes "你们都需要休假。";
			next;
			mes "[妮伦大主教]";
			mes ""+strcharinfo(0)+".";
			next;
			mes "["+strcharinfo(0)+"]";
			mes "是吗？";
			next;
			mes "[妮伦大主教]";
			mes "我应该奖励天空花";
			mes "园里每个人的贡献。";
			mes "不过，他们是";
			mes "维尔德雇用的，";
			mes "所以我不能直接批";
			mes "准他们休假。嗯……";
			next;
			mes "[妮伦大主教]";
			mes "西皮……";
			mes "我需要一支";
			mes "笔和一些纸。";
			next;
			mes "[西皮]";
			mes "是，大人。";
			mes "给您！";
			cutin "ra_gwoman",255;
			next;
			mes "^3355FF*沙沙沙*^000000";
				mes "^3355FF*沙沙沙*^000000";
				mes "^3355FF*沙沙沙*^000000";
				mes "^3355FF*沙沙沙*^000000";
			next;
			cutin "ra_gwoman",2;
			mes "[妮伦大主教]";
			mes "我曾为一个本地家";
			mes "庭的孩子施加祝福，";
			mes "他们非常感激，因为大";
			mes "多数神父都";
			mes "排斥本地人。";
			next;
			mes "[妮伦大主教]";
			mes "原来这个孩子";
			mes "很擅长伪造。";
			mes "她不喜欢和别";
			mes "人走得太近，";
			mes "不过这不是重点";
			mes "。拿着这封信。";
			next;
			mes "[妮伦大主教]";
			mes "啊，还有这份包含维";
			mes "尔德笔迹样本的文件。";
			mes "把它们带给北拉赫一个";
			mes "村庄里的女";
			mes "孩伊什梅尔。";
			mes "希望她能帮助我们……";
			set aru_em,17;
			getitem 7343,1; //File02
			changequest 2136,2137;
			close2;
		}
		else if (aru_em == 17) {
			mes "[妮伦大主教]";
			mes "请把我的信和那份文件";
			mes "交给北拉赫";
			mes "的伊什梅尔。";
			mes "希望她能发挥";
			mes "才能帮助我们。";
			close2;
		}
		else if (aru_em == 19) {
			if (countitem(7343) > 0) {
				mes "[High Priestess Niren]";
				mes "你见过伊什梅尔了吗？";
				next;
				mes "^3355FF你把伊什梅尔伪造的文件";
				mes "交给了妮伦。^000000";
				next;
				emotion ET_STARE;
				mes "[妮伦大主教]";
				mes "太完美了！这份伪";
				mes "造品做得如此逼真，";
				mes "我敢肯定连维尔德也分辨不出";
				mes "是不是他亲自写的。";
				next;
				mes "[妮伦大主教]";
				mes ""+strcharinfo(0)+"...";
				mes "我要用它让神父和信徒们休假。";
				mes "这样我和泽德就";
				mes "能与教皇交谈，";
				mes "不会受到";
				mes "不必要的打扰。";
				next;
				mes "[妮伦大主教]";
				mes "我真的不想用我和泽德要";
				mes "说的事给教皇增添负担……";
				mes "但这总比什么都";
				mes "不做，眼睁睁看着";
				mes "我们深爱的阿鲁纳";
				mes "佩尔兹衰败要好。";
				next;
				mes "[妮伦大主教]";
				mes "西皮，请把这";
				mes "份休假批准交给";
				mes "天空花园里的";
				mes "神父和信徒。";
				next;
				mes "[西皮]";
				mes "是，大人！";
				next;
				mes "[妮伦大主教]";
				mes ""+strcharinfo(0)+",";
				mes "请回去找泽德，";
				mes "告诉他一切都准备好了。";
				mes "然后到^3131FF天空花";
				mes "园^000000与我们会合。";
				next;
				mes "["+strcharinfo(0)+"]";
				mes "是！";
				next;
				mes "[妮伦大主教]";
				mes "我们必须赶快，";
				mes "在维尔德大主教发现我";
				mes "们在做什么";
				mes "之前完成。";
				delitem 7343,1; //File02
				set aru_em,20;
				changequest 2139,2140;
				close2;
			}
			else {
				mes "^3131FF你似乎把伊什梅";
				mes "尔的文件弄丢了。^000000";
				close2;
			}
		}
		else if ((aru_em == 20) || (aru_em == 21)) {
			mes "[妮伦大主教]";
			mes "请赶快回去找";
			mes "泽德大主教。";
			close2;
		}
		else if (aru_em == 22) {
			mes "[妮伦大主教]";
			mes "我为我们的教皇感到骄傲！";
			mes "你听到她精彩的演讲了吗？";
			mes "嗯，应该说那";
			mes "是芙蕾雅的话，";
			mes "不过……你懂的。呵呵呵！";
			next;
			mes "[妮伦大主教]";
			mes "我们的神父可能表现得很自私，";
			mes "但他们仍然致力于阿";
			mes "鲁纳佩尔兹的福祉。";
			mes "现在事情应该会";
			mes "向好的方向发展。";
			next;
			mes "[妮伦大主教]";
			mes "我为自己偏离和平之道、";
			mes "险些危及国家而感到羞愧。";
			mes "幸好泽德让我";
			mes "恢复了理智。";
			mes "从今以后，我会和泽";
			mes "德一起为罪过忏悔。";
			next;
			mes "[妮伦大主教]";
			mes "希望女神能原谅我。";
			mes "啊，你应该知道";
			mes "泽德正在等你。";
			mes "你现在就去见他吧？";
			mes "……";
			next;
			mes "^3355FF妮伦";
			mes "对你露出温柔的微笑，";
			mes "你意识到这是第一次看到她脸上";
			mes "出现这种表情。";
			mes "^000000";
			set aru_em,23;
			getexp (checkre(3))?100000:1000000,0;
			changequest 2141,2142;
			close2;
		}
		else if (aru_em > 21) {
			mes "[妮伦大主教]";
			mes "多亏了你和贝肯托，";
			mes "我想我终于找到";
			mes "了自己的道路。";
			close2;
		}
		else {
			mes "[妮伦大主教]";
			mes "对不起……";
			mes "我现在真的不想";
			mes "考虑泽德。他只是……";
			mes "……";
			close2;
		}
	}
	cutin "ra_gwoman",255;
	end;
}

ra_temple,168,54,3	script	Sippie#ss	917,{
	mes "[西皮]";
	mes "我终于有时间休息一下了。";
	mes "太多信徒围着妮伦大主教，";
	mes "给我带来了大量工作！";
	mes "……";
	mes "……";
	mes "……";
	if (aru_em < 11) {
		close;
	}
	else if (aru_em == 11) {
		next;
		mes "[西皮]";
		mes "请问，你是我们";
		mes "教皇的朋友吗？";
		mes "我刚才好像看到";
		mes "你和她谈话……";
		next;
		mes "[西皮]";
		mes "我不明白妮伦大主教";
		mes "为什么想发动战争。";
		mes "我觉得她内心其";
		mes "实并不想这样。";
		mes "了解她之后，你会";
		mes "发现她温柔又善良。";
		next;
		mes "[西皮]";
		mes "她很喜欢孩子……";
		mes "她就像阿鲁纳佩尔";
		mes "兹所有孩子的母亲。";
		mes "她甚至在教皇还是婴";
		mes "儿时把她带到拉赫，";
		mes "像自己的孩子一样抚养她。";
		next;
		mes "[西皮]";
		mes "如果你不知道她";
		mes "是我们的教皇，";
		mes "很容易把她误认为";
		mes "妮伦大主教的女儿。";
		close;
	}
	else {
		close;
	}
}


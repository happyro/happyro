moc_ruins,77,167,4	script	Foreign Merchant#aru1	880,5,5,{
	if (aru_vol == 27) {
		if (aru_em == 0) {
			emotion ET_THINK;
			mes "[外国商人]";
			mes "我没想到沙漠会这么热！";
			mes "他们居然在这里建城？！";
			mes "怎么能说这";
			mes "里适合居住！";
			mes "更糟的是，人群";
			mes "让这里更热了！";
			next;
			emotion ET_THINK;
			mes "[外国商人]";
			mes "我听说在梦罗";
			mes "克能赚大钱，";
			mes "所以才把生意搬到这里。";
			mes "但看来天气会";
			mes "先把我热死！";
			next;
			select("你是怎么听说梦罗克的？");
			emotion ET_THINK;
			mes "[外国商人]";
			mes "我……我刚才不是告诉你了吗？";
			mes "我听说梦罗克到处都是";
			mes "愿意高价购物的客人。";
			mes "唉，但这里简直";
			mes "是燃烧的地狱！";
			next;
			emotion ET_SWEAT;
			mes "[外国商人]";
			mes "我已经不在乎赚钱了！";
			mes "我只想去凉快的地方";
			mes "，喝一杯冰爽的饮料！";
			mes "我可能明天就离开这座";
			mes "城。忘了这个沙漠吧！";
			mes "……";
			next;
			emotion ET_CRY;
			emotion ET_SWEAT, playerattached();
			mes "[外国商人]";
			mes "啊，对了。他们不是在这";
			mes "里卖某种甜美的饮料吗？";
			mes "就在梦罗克中";
			mes "央的池塘附近。";
			mes "离开前，我想尝";
			mes "尝那种饮料……";
			set aru_em,1;
			setquest 2129;
			close;
		}
		else if ((aru_em > 0) && (aru_em < 7)) {
			mes "[外国商人]";
			mes "对了，梦罗克中央的池塘附";
			mes "近不是有个流";
			mes "动饮料商吗？";
			mes "真想喝到他卖";
			mes "的美味饮料……";
			next;
			mes "[外国商人]";
			mes "哦，热得我受不了了……";
			mes "我连汗都快流干了……我觉得";
			mes "自己快要晕倒了";
			mes "！我需要饮料！";
			close;
		}
		else if (aru_em == 7) {
			mes "[外国商人]";
			mes "*喘、喘*";
			mes "*汗*";
			next;
			switch(select("Give Fruit Wine:Quietly Watch Him")) {
			case 1:
				mes "[外国商人]";
				mes "哦，谢谢！闻";
				mes "起来像天堂……";
				mes "这就是我一直听说";
				mes "的那种著名饮料吗？";
				next;
				mes "^3355FF*咕咚咕咚咕咚咕咚*^000000";
				mes "^3355FF*咕咚咕咚咕咚咕咚*^000000";
				mes "^3355FF*咕咚咕咚咕咚咕咚*^000000";
				mes "^3355FF*咕咚咕咚咕咚咕咚*^000000";
				mes "^3355FF*咕咚咕咚咕咚咕咚*^000000";
				next;
				emotion ET_THROB;
				mes "[外国商人]";
				mes "啊！太舒服了！";
				mes "清爽又奇妙，就";
				mes "像……就像……";
				mes "科莫多的舞者！啊啊啊！";
				mes "太谢谢你了，朋友！";
				next;
				mes "[外国商人]";
				mes "我一定要想办法报答你。";
				mes "啊，找到了。";
				mes "拿着。";
				mes "你叫"+ strcharinfo(0) +"，对吧？";
				next;
				mes "["+ strcharinfo(0) +"]";
				mes "什么——？";
				mes "你怎么知道？";
				next;
				mes "^3355FF商人咯咯笑";
				mes "着从袖子下拿出一张便条。";
				mes "你打开便条，读起上面";
				mes "的内容。^000000";
				next;
				mes "^666666"+ strcharinfo(0) +"。";
				mes " ";
				mes "我们再次行动的时刻";
				mes "到了。";
				mes "有机会时请来";
				mes "见我。";
				mes " ";
				mes " - 贝肯托^000000";
				next;
				emotion ET_HUK, playerattached();
				mes "["+ strcharinfo(0) +"]";
				mes "所以……这意味着……";
				mes "你其实不是商人，";
				mes "对吧？";
				next;
				emotion ET_MERONG;
				mes "^3355FF商人带着恶作剧般的";
				mes "笑容，静静地看着";
				mes "你。^000000";
				next;
				mes "["+ strcharinfo(0) +"]";
				mes "所以你让我买饮料，";
				mes "只是为了找借";
				mes "口和你说话？！";
				emotion ET_CRY, playerattached();
				next;
				mes "["+ strcharinfo(0) +"]";
				mes "算了，谢谢你";
				mes "把便条带来。";
				mes "但我不会再给你买";
				mes "饮料了，明白吗？";
				next;
				mes "[外国商人]";
				mes "嘿，明白了。";
				mes "现在你为什么";
				mes "不去和他谈谈？";
				mes "祝你好运！";
				set aru_em,8;
				changequest 2130,2131;
				close;
			case 2:
				mes "[外国商人]";
				mes "什么——你";
				mes "就喜欢看着我";
				mes "慢慢出汗热死吗？";
				close;
			}
		}
		else {
			mes "[外国商人]";
			mes "嗯，我已经来这里了。";
			mes "那我还是去梦罗克观光吧。";
			mes "*喘、喘* ";
			mes "但这里太热了！";
			close;
		}
	}
	else {
		mes "[外国商人]";
		mes "我没想到沙漠会这么热！";
		mes "他们居然在这里建城？！";
		mes "这里怎么能住人！而";
		mes "且人群让这里更热了！";
		mes "……";
		mes "……";
		close;
	}

OnTouch:
	if (aru_vol == 27) {
		if (aru_em == 0) {
			mes "[外国商人]";
			mes "*喘、喘*";
			mes "天啊，我觉得自";
			mes "己要被热死了！";
			close;
		}
	}
	end;
}


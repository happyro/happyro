		mes "可以买到好喝的饮料。";
		mes "你就是卖饮料的人吗？";
		mes "……";
		mes "……";
		next;
		mes "[外国商人]";
		mes "哦，你说的是我的水果酒？";
		mes "恐怕它没有传";
		mes "闻中那么好。";
		mes "只是一点小东西，";

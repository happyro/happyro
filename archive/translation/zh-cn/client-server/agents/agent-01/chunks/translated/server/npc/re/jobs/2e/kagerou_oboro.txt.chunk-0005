		mes "……在那里……";
		next;
		specialeffect EF_GUIDEDATTACK,AREA,"Crafting Tools#ko_03";
		setquest 5142;
		mes "[Red Leopard Joe]";
	mes "……还有其他地方。现在开始吧！！";
		close;
	} else if (.@ko_test_03_1 == 1 && .@ko_test_03_2 == 1 && .@ko_test_03_3 == 0 && .@ko_test_03_4 == 0 && .@ko_test_03_5 == 0) {
		callsub L_Weapon,":";
		end;
	} else if (.@ko_test_03_1 == 1 && .@ko_test_03_2 == 0 && (.@ko_test_03_3 == 1 || .@ko_test_03_4 == 1) && .@ko_test_03_5 == 0) {
		callsub L_Weapon,":Yes, I'm done.";
		if (countitem(13074)) {
			mes "[Red Leopard Joe]";
		mes "嗯……有意思……这是苦无形状的短剑吗？";
			next;
			mes "[Red Leopard Joe]";
		} else if (countitem(13312)) {
			mes "[Red Leopard Joe]";
		mes "嗯……这是普通风魔手里剑吗？";
			next;
			mes "[Red Leopard Joe]";
		mes "啊，不是普通风魔手里剑。";
		} else {
			mes "[Red Leopard Joe]";
		mes "啊，怎么会这样？你没有武器？难道你已经装备上了？";
			close;
		}
	mes "很有创意。虽然还有改进空间，但稍微打磨一下，这件武器本身或许会很有用。";
		next;
		mes "[Red Leopard Joe]";
	mes "很好。我想你准备好了。";
		next;
		mes "[Red Leopard Joe]";
	mes "现在该升级了吧？";
	mes "我两侧有强化工具。用它们强化武器后再回来。";
		next;
		mes "[Red Leopard Joe]";
	mes "这些强化工具是我费了很大力气亲自制作的，你使用时不会有问题。";
		next;
		setquest 5145;
		mes "[Red Leopard Joe]";
	mes "啊……不过以防万一，";
	mes "^FF0000小心别把这些工具展示给外面的铁匠，以免惹出麻烦。^000000";
		close;
	} else if (.@ko_test_03_1 == 1 && .@ko_test_03_2 == 0 && (.@ko_test_03_3 == 1 || .@ko_test_03_4 == 1) && .@ko_test_03_5 == 1) {
		disable_items;
		mes "[Red Leopard Joe]";
	mes "结果成功了吗？";
		next;
	switch(select("还没有。:在这里。:其实……")) {
		case 1:
			mes "[Red Leopard Joe]";
		mes "一开始要得到满意的结果并不容易。";
			close;
		case 2:
			break;
		case 3:
			mes "[Red Leopard Joe]";
		mes "我都提醒过你了，你还是把武器弄丢了。";
			next;
			mes "[Red Leopard Joe]";
		mes "没有别的办法了。等等！";
			next;
	mes "红豹乔低声念叨了几句，所有武器突然都被卸下了。";
			next;
			nude;
			if (countitem(13074) || countitem(13312)) {
				mes "[Red Leopard Joe]";
			mes "这是什么？你还留着原型。别闹了。";
				close;
			}
			mes "[Red Leopard Joe]";
		mes "哦！你真的把它弄丢了。";
			next;
			setquest 5142;
			if (isbegin_quest(5143)) erasequest 5143;
			if (isbegin_quest(5144)) erasequest 5144;
			erasequest 5145;
			mes "[Red Leopard Joe]";
		mes "好吧！我们再做一次吧！";
			close;
		}
		mes "[Red Leopard Joe]";
	mes "看来你有些成果了。";
		next;
		set .@part, EQI_HAND_R;
		if (!getequipisequiped(.@part)) {
			mes "[Red Leopard Joe]";
		mes "啊！你没有装备任何武器！";
			close;
		} else {
			set .@equip_id, getequipid(.@part);
			set .@equip_refine, getequiprefinerycnt(.@part);
			if (.@equip_id == 13074 || .@equip_id == 13312) {
				mes "[Red Leopard Joe]";
			mes "那件武器是你的吗？让我看看。";
				next;
			} else {  //custom translation
				mes "[Red Leopard Joe]";
			mes "你确定是那件武器吗？";
				next;
				mes "[Red Leopard Joe]";
			mes "你想用那个骗我吗？再来一次！！";
				close;
			}
		}
	mes "乔仔细检查了封印。";
		next;
		if (.@equip_refine < 7) {
			mes "[Red Leopard Joe]";
		mes "你只有这种程度吗？";
		mes "一定是我看错你了。你也许已经满足，但我还不满意。再来一次！！";
			close;
		} else if (.@equip_refine > 6 && .@equip_refine < 9) {
			mes "[Red Leopard Joe]";
		mes "嗯……这就是你的极限吗？";
		mes "你刚才差一点就通过了。我再问一次，你满意了吗？";
			next;
		if(select("是:否") == 2) {
				mes "[Red Leopard Joe]";
			mes "你还在这里。为什么？";
				close;
			}
			mes "[Red Leopard Joe]";
		mes "你的能力足够了。";
			next;
		} else if (.@equip_refine > 8 && .@equip_refine < 13) {  //custom translation(?)
			mes "[Red Leopard Joe]";
		mes "啊，和我预想的一样。";
		mes "我相信你不会止步于此。";
			next;
		if(select("我想停下。:我想继续。") == 2) {
				mes "[Red Leopard Joe]";
			mes "我期待你的成果。";
				close;
			}
			mes "[Red Leopard Joe]";
		mes "你的能力足够了。";
			next;
		} else {  //custom translation(?)
			mes "[Red Leopard Joe]";
		mes "比预想的更好。";
			next;
			mes "[Red Leopard Joe]";
		mes "对初学者来说相当不错。这个测试对你也许不算什么，但你的能力已经足够了。";
			next;
		}
		mes "[Red Leopard Joe]";
	mes "我能感觉到。";
	mes "我会拿这件武器再做最后的处理。";
		next;

		// anti-hack
		if (callfunc("F_IsEquipIDHack", .@part, .@equip_id) || callfunc("F_IsEquipRefineHack", .@part, .@equip_refine))
			close;

		delequip .@part;
		erasequest 5145;
		completequest 5138;
		if (isbegin_quest(5143) == 1) completequest 5143;
		if (isbegin_quest(5144) == 1) completequest 5144;
		mes "[Red Leopard Joe]";
		mes "'" + strcharinfo(0) + "'";
	mes "武器测试通过！！";
		close;
	} else if (.@ko_test_03_1 == 2 && .@ko_test_03_2 == 0 && (.@ko_test_03_3 == 2 || .@ko_test_03_4 == 2) && .@ko_test_03_5 == 0) {
		mes "[Red Leopard Joe]";
	mes "哦，我差点忘了。";
	mes "去把测试结果报告给吉翁！";
		close2;
		warp "job_ko",26,104;
		end;
	} else {  //custom translation
		mes "[Red Leopard Joe]";
	mes "你不该来这里……";
	mes "消灭你是我的职责。";
	mes "这一击会把你击退！";
		close2;
		warp "amatsu",147,136;
		end;
	}
	end;

L_Weapon:
	mes "[Red Leopard Joe]";
	mes "你已经做好新武器的原型了吗？";
	next;
	switch(select("制作工具？:我没有足够的材料。:你希望我怎么制作武器？" + getarg(0))) {
	case 1:
		specialeffect EF_GUIDEDATTACK,AREA,"Crafting Tools#ko_01";
		mes "[Red Leopard Joe]";
		mes "尽管使用这里的工具，还有……";
		next;
		specialeffect EF_GUIDEDATTACK,AREA,"Crafting Tools#ko_02";
		mes "[Red Leopard Joe]";
		mes "……在那里……";
		next;
		specialeffect EF_GUIDEDATTACK,AREA,"Crafting Tools#ko_03";
		mes "[Red Leopard Joe]";
		mes "……还有其他地方。";
		close;
	case 2:
		mes "[Red Leopard Joe]";
		mes "你带来的材料不够吗？";
		next;
		specialeffect EF_GUIDEDATTACK,AREA,"Drawer#ko";
		mes "[Red Leopard Joe]";
		mes "那我们得去一趟村子。试试那边的^FF0000抽屉^000000，它会把你送到村子。";
		close;
	case 3:
		mes "[Red Leopard Joe]";
		mes "嗯……看来我期望太高了？让我解释一下。";
		next;
		mes "[Red Leopard Joe]";
		mes "首先要熔化用于制作武器的矿石。获得高纯度金属的最佳方法，是熔化同类材料。";
		next;
		mes "[Red Leopard Joe]";
		mes "例如铁矿石、铁和钢的性质相近，可以从它们中得到高纯度金属。";
		next;
		mes "[Red Leopard Joe]";
		mes "熔化高纯度金属后，把它倒入模具塑造武器形状，再通过研磨和淬火使其坚固。";
		next;
		mes "[Red Leopard Joe]";
		mes "顺便说一下，充分旋转、研磨和淬火才能得到最佳结果。";
		next;
		mes "[Red Leopard Joe]";
		mes "我想这些足够你入门了，对吧？现在去制作那个原型吧！！";
		close;
	case 4:
		return;
	}
}

job_ko,117,128,0	script	Drawer#ko	844,{
	mes "抽屉上有某种装置。";
	next;
	if(select("停止。:尝试操作。") == 2) {
		mes "咔哒咔哒叮。";
		close2;
		warp "amatsu",147,136;
		end;
	}
	close;
}

job_ko,131,124,0	script	Crafting Tools#ko_01	844,{
	if (MaxWeight - Weight < 1000 || checkweight(1201,1) == 0) {
		mes "太重了！请减轻负重。";  //custom translation
		close;
	}
	if (isbegin_quest(5138) == 1 && isbegin_quest(5142) == 1 && isbegin_quest(5143) == 0 && isbegin_quest(5144) == 0 && isbegin_quest(5145) == 0) {
		// fall through
	} else {
	mes "制作工具。";
	mes "现在还不太需要。";
		close;
	}
	mes "用于制作武器的工具。";
	next;

	// Part 1: Melting Metal
	// Input similar materials to proceed to next step.
	mes "首先要熔化铁和铁矿石之类的金属，才能用来制作武器。";
	next;
	callsub L_CheckMaterials;
	while(1) {
		switch(select("熔化铁矿石。:熔化铁。:熔化钢。:熔化普拉康。:熔化埃姆维洛泰康。:熔化粗糙的神之金属。:熔化粗糙的铝。:停止。")) {
			case 1: set .@item,1002; setarray .@val[0],1,0,0; break;  //Iron_Ore
			case 2: set .@item, 998; setarray .@val[0],2,0,0; break;  //Iron
			case 3: set .@item, 999; setarray .@val[0],3,0,0; break;  //Steel
			case 4: set .@item,1010; setarray .@val[0],0,1,0; break;  //Phracon
			case 5: set .@item,1011; setarray .@val[0],0,2,0; break;  //Emveretarcon
			case 6: set .@item, 756; setarray .@val[0],0,3,0; break;  //Oridecon_Stone
			case 7: set .@item, 757; setarray .@val[0],0,0,5; break;  //Elunium_Stone
			case 8: close;
		}
		if (countitem(.@item)) {
			delitem .@item,1;
			if (.@val[0]) {			//Iron Ore, Iron, Steel
				set .@ston_t01, .@ston_t01 + .@val[0];
				if (.@ston_t02 > 0)
					set .@ston_t02, .@ston_t02 - .@val[0];
			} else if (.@val[1]) {	//Phracon, Emveretarcon, Rough Oridecon
				set .@ston_t02, .@ston_t02 + .@val[1];
				if (.@ston_t01 > 0)
					set .@ston_t01, .@ston_t01 - .@val[1];
			} else if (.@val[2]) {	//Rouch Elunium
				if (.@ston_t01 > 0)
					set .@ston_t01, .@ston_t01 - .@val[2];
				if (.@ston_t02 > 0)
					set .@ston_t02, .@ston_t02 - .@val[2];
			}
			specialeffect EF_DEMONSTRATION;
			mes "在高温下熔化了" + getitemname(.@item) + "。";
			next;
			if (.@ston_t01 > 49 || .@ston_t02 > 49)
				break;
		} else {
			mes "没有" + getitemname(.@item) + "。";
			next;
		}
		callsub L_CheckMaterials;
	mes "接下来要熔化哪种金属？";
		next;
	}
	set .@boll_01, ((.@ston_t01 > 49) ? .@ston_t01 : .@ston_t02);

	// Part 2: Forging
	// Grind and temper a weapon.
	mes "金属已经熔化，可以用来制作武器了。";
	next;
	mes "接下来要把熔化的金属倒入模具使其成形。你要使用哪种模具？";
	next;
	switch(select("短剑模具:手里剑模具")) {
	case 1:
		set .@weapon_who,0;
	mes "已将熔化的金属倒入短剑模具。";
		break;
	case 2:
		set .@weapon_who,1;
	mes "已将熔化的金属倒入手里剑模具。";
		break;
	}
	next;
	progressbar "ffff00",3;
	mes "看来金属正在成形。接下来做什么？";
	next;
	set @job_ko_forge,0;
	set @job_ko_lastaction,0;
	callsub L_ForgeWeapon,":";
	while(1) {
	mes "接下来做什么？";
		next;
		if (callsub(L_ForgeWeapon,":Final Touches") == 0)
			break;
	}
	set .@boll_02, @job_ko_forge;
	set @job_ko_forge,0;
	set @job_ko_lastaction,0;

	// Part 3: Create the Weapon
	// Success rate based on previous two parts.
	set .@boll_00, .@boll_01 + .@boll_02;
	mes "开始用磨刀石打磨工具，进行最后处理。";
	next;
	progressbar "ffff00",3;
	set .@success_pp, rand(1,100);
	if (.@boll_00 < 100) {
		if (.@success_pp == 77) set .@success,1;
	} else {
		if (.@success_pp != 44) set .@success,1;
	}
	if (.@success) {
		specialeffect2 EF_PERFECTION;
		erasequest 5142;
		if (.@weapon_who == 0) {
			setquest 5143;
			getitem 13074,1; //Ninja_Cutter
		} else {
			setquest 5144;
			getitem 13312,1; //Huuma_Job_Test
		}
	mes "武器制作成功。";
		next;
	mes "把它带给红豹乔吧。";
		close;
	} else {
		specialeffect2 EF_SUI_EXPLOSION;
	mes "进行最后处理时，武器损坏了。";
		next;
	mes "制作武器时一定遗漏了什么。虽然很遗憾，但你必须从头再来。";
		close;
	}
	end;

L_CheckMaterials:
	if (!countitem(1002) && !countitem(998) && !countitem(999) && !countitem(1010) && !countitem(1011) && !countitem(756) && !countitem(757)) {
	mes "但你没有更多金属可以熔化了。拿到更多金属后再试吧。";
		close;
	}
	return;

L_ForgeWeapon:
	set .@i, select("研磨武器:淬火武器" + getarg(0));
	switch (.@i) {
	case 1:
		specialeffect2 EF_DETOXICATION;
		mes "已研磨武器。";
		break;
	case 2:
		specialeffect2 EF_REPAIRWEAPON;
		mes "已对武器淬火。";
		break;
	case 3:
		return 0;
	}
	next;
	if (@job_ko_lastaction == .@i)
		set @job_ko_forge, @job_ko_forge + 1;
	else
		set @job_ko_forge, @job_ko_forge + 2;
	set @job_ko_lastaction, .@i;
	return 1;
}
job_ko,129,129,0	duplicate(Crafting Tools#ko_01)	Crafting Tools#ko_02	844
job_ko,116,124,0	duplicate(Crafting Tools#ko_01)	Crafting Tools#ko_03	844

job_ko,121,121,0	script	Refinement Tools#ko_01	844,{
	if (isbegin_quest(5138) == 1 && isbegin_quest(5142) == 0 && (isbegin_quest(5143) == 1 || isbegin_quest(5144) == 1) && isbegin_quest(5145) == 1) {
		disable_items;
	} else {
	mes "这个工具可以自动强化武器。不过你现在还用不上。";
		close;
	}
	mes "你打开了强化工具。";
	mes "设备伴随着舒适的震动启动了。";
	next;
	mes "看来可以立即使用这个工具进行强化，因为里面储存了大量铝和神之金属。";
	next;
	if(select("开始强化。:不开始强化。") == 2) {
		mes "你关闭了工具。";
		close;
	}
	set .@part, EQI_HAND_R;
	if (!getequipisequiped(.@part)) {
	mes "嘶滋。";
	mes "工具发出了警告声。";
		next;
		mes "[Red Leopard Joe]";
	mes "没有装备需要强化的物品时，这台设备无法工作。";
		close;
	} else {
		set .@equip_id, getequipid(.@part);
		set .@equip_refine, getequiprefinerycnt(.@part);
		setarray .@card[0], getequipcardid(.@part,0), getequipcardid(.@part,1), getequipcardid(.@part,2), getequipcardid(.@part,3);
		if (.@equip_id == 13074 || .@equip_id == 13312) {
	mes "正在分析武器。";
			next;
		} else {
			mes "[Red Leopard Joe]";
	mes "等等……这不是定制武器。";
			next;
			mes "[Red Leopard Joe]";
	mes "为什么不去找外面那些暴躁的铁匠强化它？";
			close;
		}
	}
	if (!getequipisenableref(.@part)) {
	mes "嘶滋。";
	mes "工具发出了警告声。";
		next;
		mes "[Red Leopard Joe]";
	mes "那件武器无法强化。你从哪里得到的？";  //custom translation
		close;
	}
	if (.@equip_refine >= 20) {
	mes "嘶滋。";
	mes "工具发出了警告声。";
		next;
		mes "[Red Leopard Joe]";
	mes "这件装备已经强化到完美了。留着自己用吧！";  //custom translation
		close;
	}
	if (getequippercentrefinery(.@part) < 100) {
	mes "这件装备强化得很好。要继续吗？如果强化失败，强化技能会下降 1 级。";
		next;
	if(select("继续。:停止。") == 2) {
	mes "你关闭了工具。";
			close;
		}
	} else {
	mes "开始强化。";  //custom translation
		next;
	}
	progressbar "ffff00",1;
	set .@rand, rand(1,100);
	if (.@equip_refine < 5) {			// 0>5 100%
		set .@wlevel_up,1;
	} else if (.@equip_refine == 5) {	// 5>6  40%
		if (.@rand < 41) set .@wlevel_up,1;
	} else if (.@equip_refine == 6) {	// 6>7  30%
		if (.@rand < 31) set .@wlevel_up,1;
	} else if (.@equip_refine == 7) {	// 7>8  20%
		if (.@rand < 21) set .@wlevel_up,1;
	} else if (.@equip_refine == 8) {	// 8>9  10%
		if (.@rand < 11) set .@wlevel_up,1;
	} else if (.@equip_refine == 9) {	// 9>10  5%
		if (.@rand < 6) set .@wlevel_up,1;
	} else {							// 10>20 2%
		if (.@rand < 3) set .@wlevel_up,1;
	}

	// anti-hack
	if (callfunc("F_IsEquipIDHack", .@part, .@equip_id) || callfunc("F_IsEquipCardHack", .@part, .@card[0], .@card[1], .@card[2], .@card[3]) || callfunc("F_IsEquipRefineHack", .@part, .@equip_refine))
		close;

	if (.@wlevel_up) {
		successrefitem .@part;
	mes "强化成功。";

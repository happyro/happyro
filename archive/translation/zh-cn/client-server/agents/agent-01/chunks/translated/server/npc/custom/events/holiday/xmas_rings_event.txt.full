//===== rAthena Script =======================================
//= Karachun Event (Xmas Rings Quest)
//===== By: ==================================================
//= Lupus (1.0)
//===== Current Version: =====================================
//= 1.2
//===== Compatible With: =====================================
//= rAthena Project; SVN r4880+
//===== Description: =========================================
//= Custom event: Karachun (from 8 Dec till 8 Jan), X-Mas, HNY
//===== Additional Comments: =================================
//= 1.0 Tested, fully working. 1.0a a few typos fix
//= 1.1 Readded Mdef +1 and  Luk +1 to Santa's Hat [Lupus]
//= 1.2 Fixed double quotes not being escaped [brianluau]
//============================================================

prontera,156,174,4	script	Snower	713,{
	mes "[Snower]";
	if (Q_XMSRINGS == 2) {
		mes "哦……真的吗？你帮助了我妹妹 Sneewy？谢谢。";
	} else if (Q_XMSRINGS == 3) {
		mes "Snoowy 让鸟儿给我捎了信，说起你帮助她的事……";
		mes "我来告诉你魔法戒指的秘密。";
		emotion ET_BEST;
		next;
		mes "[Snower]";
		mes "它们只有在 12 月 8 日至 1 月 8 日期间拥有魔力。";
		next;
		mes "[Snower]";
		mes "顺便说一句，戴上圣诞帽就能发现它们真正的力量。";
		next;
		mes "[Snower]";
		mes "同时戴上两枚戒指，力量会加倍。";
		mes "祝你今天愉快！";
		close;
	} else {
		mes "嗨！我和两个妹妹正在为三大节日准备礼物！";
	}
	emotion ET_CRY;
	next;
	menu "你的姐妹在哪里？",-, "什么节日？",M_PR,"什么礼物？",M_WRAP,"我能帮忙吗？",M_QUEST;

	mes "[Snower]";
	mes "我的妹妹 Sneewy 去了遥远的地方，为那里的穷孩子准备礼物……我不知道在哪里。你应该问问姐姐和她的鸟儿。";
	next;
	mes "[Snower]";
	mes "我的姐姐？她叫 Snoowy。她航行去了某个绿色岛屿……听说要给海豚之类的准备礼物……";
	close;

M_PR:
	mes "[Snower]";
	mes "三大节日？它们会一个接一个到来！";
	mes "^000080圣诞节^000000、^FF0000卡拉钦节^000000和^008000新年前夜^000000！";
	next;
	mes "[Snower]";
	mes "^FF0000卡拉钦节^000000？嘿……这是古老的异教节日。在新年和圣诞节出现以前，人们就会庆祝它。";
	next;
	goto M_QUEST;

M_WRAP:
	mes "[Snower]";
	mes "姐妹们说所有礼物都应该长得一样，否则孩子们可能会为漂亮的礼物打架！";
	next;
	mes "[Snower]";
	mes "你想让我用灰纸包装漂亮的礼物盒吗？";
	next;
	menu "请把它们包起来！",-, "不用了，谢谢。",M_QUEST;

	set @prizes, countitem(664)+countitem(665)+countitem(666)+countitem(667);
	if (@prizes == 0) {
		mes "[Snower]";
		mes "我没看到你身上有漂亮盒子里的礼物……";
		if(countitem(644))mes "你只有灰色盒子。";
		close;
	}
	delitem 664,countitem(664);
	delitem 665,countitem(665);
	delitem 666,countitem(666);
	delitem 667,countitem(667);
	getitem 644,@prizes;

	mes "[Snower]";
	mes "*沙沙声* 给你。";
	next;

M_QUEST:
	mes "[Snower]";
	mes "希望你尽快找到我的姐妹们……她们需要帮助。";
	if (Q_XMSRINGS == 0) set Q_XMSRINGS,1;
	close;

OnInit:
//Santa's Hat
	setitemscript 2236,"{ bonus bMdef,1; bonus bLuk,1; if(isequipped(2636,2637)){if(@xmr == gettime(DT_MINUTE))end; set @xmr,gettime(DT_MINUTE); misceffect EF_RAINBOW; end;} if(isequipped(2636)){if(@xmr == gettime(DT_MINUTE))end; set @xmr,gettime(DT_MINUTE); misceffect EF_SPHERE;} if(isequipped(2637)){if(@xmr == gettime(DT_MINUTE))end; set @xmr,gettime(DT_MINUTE); misceffect EF_ANGEL2;}}";
//Gold Xmas Ring
	setitemscript 2636,"{ bonus bLoseSPWhenUnequip,30; if(isequipped(2236)==0)end; if(getskilllv(\"AL_HEAL\")){skill \"TF_HIDING\",4+isequipped(2637);}else{skill \"AL_HEAL\",1+4*isequipped(2637);} }";
//Silver Xmas Ring
	setitemscript 2637,"{ bonus bDamageWhenUnequip,40; if(isequipped(2236)==0)end; if(getskilllv(\"AL_TELEPORT\")){skill \"MC_IDENTIFY\",1;}else{skill \"AL_TELEPORT\",1+isequipped(2636);} }";
	end;
}

louyang,224,249,4	script	Sneewy	717,{
	mes "[Sneewy]";
	if (Q_XMSRINGS == 0) {
		mes "嗨！我正在等妹妹的鸟儿送信……";
		emotion ET_CRY;
		close;
	}
	if (Q_XMSRINGS == 1) {
		mes "真希望我还有 4 个灰色礼物盒给本地孩子……";
		emotion ET_CRY;
		next;
		mes "[Sneewy]";
		mes "哦，你好。我的哥哥 Snower 把一切都告诉你了吗？";
		next;
	menu "这是你的 4 个礼物盒",-, "我不知道什么雪恨者……",M_END;

		mes "[Sneewy]";
		if (countitem(644) < 4) {
			mes "给我 4 份礼物给穷孩子……等等，你没有 4 份！";
			emotion ET_SORRY;
			close;
		}
		set Q_XMSRINGS,2;
		delitem 644,4;
		getnameditem 2637,strcharinfo(0);
		emotion ET_CHUPCHUP;
		mes "谢谢！这是给你的小礼物！";
		next;
		mes "[Sneewy]";
		mes "顺便说一句，同时戴上两枚不同的戒指，节日升级会更容易！";
		close;
	}
	emotion ET_THANKS;
	mes "再次感谢！不会有孩子在没有礼物的情况下迎接节日！";
	close;

M_END:
	mes "[Sneewy]";
	mes "真遗憾……我有一枚魔法圣诞戒指……想用它换 4 个礼物盒……";
	emotion ET_SWEAT;
	close;
}

izlu2dun,133,160,2	script	Snoowy	714,{
	mes "[Snoowy]";
	if (Q_XMSRINGS == 0) {
		mes "你好——！你认识我的哥哥和妹妹吗？怎么认识的？我的哥哥 Snower 在普隆德拉很有名！！问问那里的孩子就知道了。";
		emotion ET_SCRATCH;
		close;
	}
	if (Q_XMSRINGS == 1) {
		mes "可恶……穷孩子怎么会比海洋居民更重要……是我错了吗？";
		next;
		mes "[Snoowy]";
		mes "呃，你好。妹妹 Sneewy 让鸟儿给我捎了信。信被弄湿了，我只看清地址末尾的几个字母……";
		next;
		mes "[Snoowy]";
		mes "看，最后好像是‘yang’……嗯……她一定把地址拼错成了‘Al Doo Boryang’……";
		close;
	}
	if (Q_XMSRINGS == 2) {
		mes "你帮助了我的妹妹？太棒了！";
		next;
		mes "[Snoowy]";
		mes "但我还需要 3 份礼物送给海洋居民朋友……";
		next;
		menu "给你这些礼物！",-, "我需要一点小礼物作为回报",M_END;

		mes "[Snoowy]";
		if (countitem(644) < 3) {
			mes "糟糕！！你身上没有 3 个灰色礼物盒。";
			emotion ET_SORRY;
			close;
		}
		set Q_XMSRINGS,3;
		delitem 644,3;
		getnameditem 2636,strcharinfo(0);
		emotion ET_CHUP;
		mes "谢谢你！拿着这枚魔法戒指！";
		close;
	}
	emotion ET_THANKS;
	mes "哦……所有海洋居民都向你表示感谢！他们太喜欢礼物了！！！";
	if (rand(2))
		mes "你不知道圣诞帽能揭示戒指真正的力量吗？";
	close;

M_END:
	mes "[Snoowy]";
	mes "我愿意用一枚金色魔法戒指换 3 个礼物盒……";
	emotion ET_SWEAT;
	close;
}

		cutin "16go_01.bmp",1;
		mes "[Gonie]";
		mes "....!";
		next;
		cutin "16lei_02.bmp",2;
		mes "[Lazy]";
		mes "哎呀！你把他摔下来了。也许你太勉强自己了。";
		unittalk getcharid(3), "" + strcharinfo(0) + " : That must hurt...", bc_self;
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "他睁眼了！看来他醒了！";
		next;
		mes "[Lazy]";
		mes "不，他是受到撞击后本能地睁开了眼。他仍然昏迷不醒。";
		unittalk getcharid(3), "" + strcharinfo(0) + " : Is that possible?", bc_self;
		next;
		cutin "16loo_01.bmp",0;
		mes "[??]";
		mes "Gonie！你没事吧？站起来。";
		next;
		cutin "",255;
		mes "砰！";
		specialeffect EF_QUAKEBODY2, AREA, "Gonie#16nego03";
		specialeffect EF_GRAVITATION, AREA, "Gonie#16nego03";
		next;
		emotion ET_PROFUSELY_SWAT;
		emotion ET_PROFUSELY_SWAT, playerattached();
		emotion ET_HUK, getnpcid(0, "Nemi#16nego01");
		emotion ET_HUK, getnpcid(0, "Eri#16nego01");
		cutin "16go_01.bmp",1;
		mes "[Gonie]";
		mes "....!";
		next;
		cutin "16lei_02.bmp",2;
		mes "[Lazy]";
		mes "天啊！你又把他摔下来了。别太勉强自己。";
		npctalk "你不是应该去帮忙吗？", "Eri#16nego01", bc_self;
		sleep2 300;
		npctalk "哦……我该这么做吗？", "Nemi#16nego01", bc_self;
		next;
		cutin "16loo_01.bmp",0;
		mes "[??]";
		mes "Gonie！你怎么了？再站起来。";
		next;
		cutin "",255;
		mes "砰！";
		specialeffect EF_QUAKEBODY2, AREA, "Gonie#16nego03";
		specialeffect EF_GRAVITATION, AREA, "Gonie#16nego03";
		next;
		emotion ET_PROFUSELY_SWAT;
		emotion ET_PROFUSELY_SWAT, playerattached();
		emotion ET_HUK, getnpcid(0, "Nemi#16nego01");
		emotion ET_HUK, getnpcid(0, "Eri#16nego01");
		cutin "16go_01.bmp",1;
		mes "[Gonie]";
		mes "......!!";
		next;
		cutin "16lei_03.bmp",2;
		mes "[Lazy]";
		mes "天啊，你的手臂怎么这么弱？看来这里遇到麻烦了。你们没有人手，所以雇了这么弱的人？天啊。";
		npctalk "看啊。戈尼可能会死。", "Eri#16nego01", bc_self;
		sleep2 300;
		npctalk "这次他可能真的会死。", "Eri#16nego01", bc_self;
		next;
		cutin "16loo_01.bmp",0;
		mes "[??]";
		mes "我不知道你是谁。但我听得到你说的话！";
		next;
		cutin "16lei_02.bmp",2;
		mes "[Lazy]";
		mes "听到什么？我只是在心里说话！";
		unittalk getcharid(3), "" + strcharinfo(0) + " : As I told you earlier, your big mouth is always a problem.", bc_self;
		next;
		cutin "",255;
		mes "砰！";
		specialeffect EF_QUAKEBODY2, AREA, "Gonie#16nego03";
		specialeffect EF_GRAVITATION, AREA, "Gonie#16nego03";
		next;
		specialeffect EF_DEATHSUMMON, AREA, "Gonie#16nego03";
		emotion ET_PROFUSELY_SWAT;
		emotion ET_PROFUSELY_SWAT, playerattached();
		emotion ET_HUK, getnpcid(0, "Nemi#16nego01");
		emotion ET_HUK, getnpcid(0, "Eri#16nego01");
		next;
		cutin "16go_02.bmp",1;
		mes "[Gonie]";
		mes "....!!!! ....";
		next;
		cutin "16loo_03.bmp",0;
		mes "[??]";
		mes "Gonie！你怎么浑身是血？他们袭击你了吗？";
		npctalk "我本想接待客人，但现在别无选择。", "Nemi#16nego01", bc_self;
		next;
		emotion ET_ANGER, getnpcid(0, "Nemi#16nego01");
		mes "[Shopkeeper]";
		mes "你！都怪你！你根本抬不动他！来吧，我们一起抬。你太弱了，连比勺子重的东西都抬不起来。";
		next;
		mes "[Shopkeeper]";
		mes "别给 Lucky 太大压力。";
		next;
		cutin "16lei_03.bmp",2;
		mes "[Lazy]";
		mes "我好不容易才救回他的命，你现在却想杀了他。幸好他昏迷了，感觉不到疼痛。";
		npctalk "顺便说，他迟钝得在这种情况下都醒不过来。", "", bc_self;
		sleep2 300;
		unittalk getcharid(3), "" + strcharinfo(0) + " : Perhaps... Is he nearly dead?", bc_self;
		sleep2 500;
		npctalk "Maybe.", "", bc_self;
		next;
		cutin "16loo_01.bmp",0;
		mes "[??]";
		mes "谢谢你，Nemi。啊。我们把他带过去放下吧。";
		next;
		cutin "16lei_03.bmp",2;
		mes "[Lazy]";
		mes "喂。你没有什么要对我们说的吗？";
		next;
		cutin "16loo_01.bmp",0;
		mes "[??]";
		mes "哦，我听说过一些你的事。非常感谢你救了我的朋友，还一路把他带到这里。店主会补偿你的。";
		next;
		mes "[??]";
		mes "回头见。";
		next;
		cutin "16lei_03.bmp",2;
		mes "[Lazy]";
		mes "等等！他们就这样把我们打发走了？好像确实是这样。是我理解错了吗？";
		cloakonnpcself( "Nemi#16nego01" );
		cloakonnpcself( "Lucky#16nego01" );
		cloakonnpcself( "Gonie#16nego03" );
		next;
		mes "[Lazy]";
		mes "哎？他们进去了！快走！";
		next;
		mes "[Lazy]";
		mes "给了点钱就要我们回去？你们不能这样！至少也该给我一杯茶！";
		next;
		emotion ET_ANGER;
		mes "[Shopkeeper]";
		mes "拜托，客人。你不该这样。";
		next;
		emotion ET_FRET;
		mes "[Lazy]";
		mes "那就叫他们出来！现在出来！出来！出来！";
		npctalk "你为什么不行！！", "", bc_self;
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "嗯，Lazy。这有点丢人。我们现在回去吧。我们还有任务。";
		next;
		emotion ET_ANGER;
		mes "[Lazy]";
		mes "绝不！我才不怕丢脸，我要一直喊到他们出来为止！喂！菜鸟！出来！出来！";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "我觉得很丢脸……";
		npctalk "你以我为耻吗？", "", bc_self;
		next;
		mes "[Shopkeeper]";
		mes "安静。如果你继续闹，我就叫人把你赶出去。";
		next;
		emotion ET_FRET;
		mes "[Lazy]";
		mes "谁敢赶我出去！不可能！我要躺在这里！出来！";
		unittalk getcharid(3), "" + strcharinfo(0) + " : I am so ashamed...", bc_self;
		next;
		cloakoffnpcself( "Nemi#16nego01" );
		cloakoffnpcself( "Lucky#16nego01" );
		cutin "16loo_03.bmp",0;
		mes "[Lucky]";
		mes "呼……";
		next;
		cutin "16lei_01.bmp",2;
		mes "[Lazy]";
		mes "他来了！！！";
		next;
		cutin "16loo_01.bmp",0;
		mes "[Lucky]";
		mes "你的声音太大，震得我耳朵疼。一般来说，笨蛋的声音都很大。";
		npctalk "谁是笨蛋？我吗？", "", bc_self;
		next;
		cutin "16lei_01.bmp",2;
		emotion ET_SMILE;
		mes "[Lazy]";
		mes "我还能做得更过分。";
		unittalk getcharid(3), "" + strcharinfo(0) + " : Lazy, please calm down!", bc_self;
		next;
		cutin "16loo_01.bmp",0;
		mes "[Lucky]";
		mes "我明白了。进来吧。我们可以如你所愿给你一杯茶。";
		next;
		mes "[Shopkeeper]";
		mes "真的没问题吗？";
		next;
		cutin "16loo_03.bmp",0;
		mes "[Lucky]";
		mes "看看他。他甚至伤不了我们。";
		next;
		cutin "16lei_01.bmp",2;
		emotion ET_OK;
		mes "[Lazy]";
		mes "感觉有点奇怪，不过我就不计较了。哦！我好渴~";
		unittalk getcharid(3), "" + strcharinfo(0) + " : Really? Are you sure we are going in there?", bc_self;
		next;
		cutin "16loo_01.bmp",0;
		mes "[Lucky]";
		mes "跟我来。往这边走。";
		cloakonnpcself( "Lucky#16nego01" );
		cloakonnpcself( "Lazy#16nego04" );
		erasequest 14598;// Invisible entrance
		setquest 14599;// A glass of tea gratitude
		terra_gloria_main = 15;
		close2;
		cutin "",255;
		warp "rebel_in",40,43;
		end;
	}
}


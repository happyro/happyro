rebel_in,62,44,5	duplicate(dummy_cloaked_npc)	Philopontess#ep162_02	4_M_PHILOFONTES

rebel_in,65,46,5	script	Rebellion Squadder#ep16	4_M_GUNSLINGER2,3,3,{
	if (terra_gloria_main < 17) {
		mes "[Squadder]";
		mes "这些人真吵。";
		mes "我永远不会觉得无聊。";
		close;
	}
	if (terra_gloria_main == 17) {
		mes "[Squadder]";
		mes "有人来了，我想他是在找你。";
		mes "虽然感觉不太好，我还是让他进来了。";
		next;
		cloakoffnpcself( "Philopontess#ep162_02" );
		npctalk "Hoo ...", "Philopontess#ep162_02", bc_self;
		mes "[Tess]";
		mes "这些人真没礼貌。";
		mes "……怎么能这样把访客晾在外面？";
		cutin "ep16_tes03.bmp",0;
		next;
		cutin "",255;
		mes "[Squadder]";
		mes "喂，老兄。你说话真客气，对吧？";
		mes "要不是这件事，我们根本不会和政府的人合作！";
		next;
		cutin "ep16_tes01.bmp",0;
		mes "[Tess]";
		mes "有一位来自卢恩·米德加尔特的访客。我把访客护送到了^4d4dff艾因布罗克旅馆^000000。";
		mes "我不知道这里进展得怎么样。";
	npctalk "嘿，伙计！你在无视我吗？", "", bc_self;
		next;
		cutin "ep16_tes01.bmp",0;
		mes "[Tess]";
		mes "既然我能进来，我想谈判应该成功了。";
		mes "……行动区域在哪里？";
		npctalk "Oh~~ Man!!", "", bc_self;
		next;
		cutin "",255;
		mes "[Squadder]";
		mes "我正要告诉你这件事！";
		mes "要不是你，我早就把一切都告诉他了！";
		next;
		mes "[Squadder]";
		mes "嗯，我不知道你是不是访客。但你要去艾因布罗克？很好。";
		mes "我们也要去艾因布罗克。";
		next;
		mes "[Squadder]";
		mes "艾因布罗克旅馆？不错。";
		mes "从这里搭火车，很快就能到艾因布罗克。";
		next;
		select("苍鹭……");
		cutin "ep16_tes01.bmp",0;
		mes "[Tess]";
		mes "苍鹭？哦，Lazy？";
		mes "我相信他会自己想办法到那里。";
		next;
		mes "[Tess]";
		mes "^4d4dff艾因布罗克旅馆^000000见。";
		next;
		cutin "",255;
		mes "[Squadder]";
		mes "好吧，我护送你们去火车站。";
		mes "我们现在出发吗？";
		erasequest 7737;// Together with Rebel
		setquest 7738;// Next operation plan
		completequest 14615;// Between negotiation and deception
		terra_gloria_main = 18;
		next;
		.@s = select( "好！", "我们自己走。" );
		mes "[Squadder]";
		mes "从艾因贝赫车站到艾因布罗克，你们自己走。";
		mes "现在你们知道方向了。";
	npctalk "我会在酒店等你。", "Philopontess#ep162_02", bc_self;
		close2;
		cloakonnpcself( "Philopontess#ep162_02" );
		if (.@s == 1)
			warp "einbech",68,208;
		end;
	}
	if (terra_gloria_main == 18) {
		mes "[Squadder]";
		mes "你说的是^4d4dff艾因布罗克旅馆^000000。";
		mes "我们会派一个你可能很熟悉的人去。";
		close;
	}
	mes "[Squadder]";
	mes "也许这是我们给企业送上一份大礼的机会~";
	close;

OnTouch:
	if (terra_gloria_main == 17)
	npctalk "嘿，伙计，这边。", "", bc_self;
	end;

OnInit:
	questinfo( QTYPE_QUEST, QMARK_NONE, "isbegin_quest(14615) == 1" );
	end;
}

// Main - Einbroch Inn
function	script	F_Terra_Gloria_Inn	{
	if (countitem(25179) < 1) {	// no way to retrieve the item ?
		mes "由于你没有^00ffff" + getitemname(25179) + "^000000，无法继续前进。";
		close;
	}
	mes "[Tess]";
	mes "......";
	next;
	cutin "ep16_nihi_miseria_heine01.bmp",2;
	mes "[Nihil]";
	mes ".......";
	next;
	cutin "ep16_skia_nerius01.bmp",0;
	mes "[Skia]";
	mes "这是怎么回事？";
	mes "气氛有些不对。";
	next;
	cutin "ep16_tes03.bmp",1;
	mes "[Tess]";
	mes "好吧，我不得不佩服你。";
	mes "我以前从未退缩过。";
	next;
	cutin "ep16_nihi_miseria_heine01.bmp",2;
	mes "[Nihil]";
	mes "这没什么大不了的，对吧？";
	mes "我们这么做是为了双方的利益。";
	mes "现在还不能确定。";
	next;
	cutin "ep16_tes01.bmp",1;
	mes "[Tess]";
	mes "反正最终决定会由总统做出。";
	mes "……但我相信阁下会毫无异议地接受。";
	next;
	cutin "ep16_tes03.bmp",1;
	mes "[Tess]";
	mes "但我还是很不高兴。";
	mes "……这只是我个人的感受。";
	next;
	cutin "ep16_skia_nerius02.bmp",0;
	mes "[Skia]";
	mes "可以请你告诉我，你们刚才在谈什么吗？";
	next;
	cutin "ep16_nihi_miseria_heine02.bmp",2;
	mes "[Nihil]";
	mes "没那么严重。";
	mes "我们一直在讨论行动期间可能出现的外交问题，也谈到了与企业的关系和其他计划。";
	next;
	mes "[Nihil]";
	mes "我们还谈到了这次合作中双方可能获得的利益与承担的损失……";
	next;
	cutin "ep16_tes01.bmp",1;
	mes "[Tess]";
	mes "……虽然这是企业做的，但我们不能否认事情发生在我国。因此我们必须承担一部分责任。";
	next;
	cutin "ep16_nihi_miseria_heine04.bmp",2;
	mes "[Nihil]";
	mes "是的。就是这样。";
	mes "但我不确定他们是否会接受这样的补偿或合同……";
	next;
	cutin "ep16_nihi_miseria_heine01.bmp",2;
	select("他们？");
	cutin "ep16_nihi_miseria_heine04.bmp",2;
	mes "[Nihil]";
	mes "我们曾经派代表去过斯瓦尔兹瓦尔特。";
	mes "……但他们再也没有回来。";
	npctalk "........", "Philopontess#ep162_03", bc_self;
	next;
	cutin "ep16_nihi_miseria_heine01.bmp",2;
	mes "[Nihil]";
	mes "说起来，你应该已经完成任务了。";
	next;
	select("把祝福之星交给他。");
	mes "[Nihil]";
	mes "……泰拉·格洛丽亚，表面已经消失了。";
	mes "只剩下星星。";
	next;
	select("有什么问题吗？");
	mes "[Nihil]";
	mes "不，表面只是用来覆盖星星的东西。";
	mes "重要的是星星。";
	mes "你带来了正确的物品。";
	next;
	cutin "ep16_tes01.bmp",1;
	mes "[Tess]";
	mes "嗯？这只是一块宝石，对吧？";
	mes "他们究竟为什么要偷这个？";
	next;
	cutin "ep16_skia_nerius01.bmp",0;
	mes "[Skia]";
	mes "因为它就像一块精美的魔法石。";
	next;
	cutin "ep16_tes01.bmp",1;
	mes "[Tess]";
	mes "……现在他们还要偷实验材料？";
	mes "据推测，还有几处设施拥有这样的秘密实验室。";
	next;
	cutin "ep16_nihi_miseria_heine01.bmp",2;
	mes "[Nihil]";
	mes "你是在担心未来吗？";
	mes "我们已经谈完这件事了。";
	mes "我说过，如果你需要，我会支持你。";
	next;
	cutin "ep16_tes01.bmp",1;
	mes "[Tess]";
	mes "……那是指双方的协议。所以请别把功劳都算在自己头上。";
	next;
	cutin "ep16_nihi_miseria_heine02.bmp",2;
	mes "[Nihil]";
	mes "功劳？我只是在说实话。";
	mes "现在我没必要继续待在这里了。";
	next;
	cutin "ep16_tes01.bmp",1;
	mes "[Tess]";
	mes "你真冷漠。";
	mes "得到想要的东西后就要离开吗？";
	next;
	cutin "ep16_nihi_miseria_heine02.bmp",2;
	mes "[Nihil]";
	mes "有必要的话，我们还会再见。";
	mes "Tess，如果你来普隆德拉，我们非常欢迎。";
	next;
	cutin "ep16_nihi_miseria_heine01.bmp",2;
	mes "[Nihil]";
	mes "而且，我没有多少时间了。";
	mes "回去后还有很多事情要处理。";
	next;
	mes "[Nihil]";

//= [Official Conversion]
//= Job quest for Alchemist classes
//===== Additional Comments: ================================= 
//= 2.5 Rescripted to Aegis 10.3 stadards. [L0ne_W0lf]
//=     No longer uses function "F_BlockHigh"
//= 2.6 Corrected a bug in advanced class checking. [L0ne_W0lf]
//= 2.7 Added missing checkweights. [L0ne_W0lf]
//= 2.8 Fixed minor typo in test section. [L0ne_W0lf]
//= 2.9 Added Quest Log commands. [Kisuka]
//= 3.0 Removed the need for use of 'goto.' [L0ne_W0lf]
//= 3.1 Added missing changequest commands. [Kisuka]
//============================================================ 

alde_alche,27,185,5	script	Alchemist Guildsman#am	744,{
	mes "[帕米·吉亚尼诺]";
	if (Upper == 1) {
		mes "欢迎来到";
		mes "炼金术士公会——";
		mes "不、不可能！怎么会";
		mes "发生这种事？";
		next;
		mes "[帕米·吉亚尼诺]";
		mes "等等，等等……";
		mes "抱歉，我只是糊涂了，";
		mes "仅此而已。你看起来很像";
		mes "我曾经认识的人。";
		mes "不过，我对你有种奇怪的";
		mes "感觉……";
		close;
	}
	if (BaseJob != Job_Merchant) {
		if (BaseJob == Job_Alchemist) {
			mes "欢迎，" + strcharinfo(0) + ".";
			mes "炼金术士公会";
			mes "今天和往常一样忙碌。";
			next;
			mes "[帕米·吉亚尼诺]";
			mes "每个人都忙于自己的";
			mes "研究，不过最近生物技术领域取得了一些进展。";
			next;
			mes "[帕米·吉亚尼诺]";
			mes "大家都希望生物技术研究取得积极成果。说起来，不知道研究人工生命的炼金术士们进展如何……";
			close;
		}
		else if (BaseClass == Job_Novice) {
			mes "欢迎来到";
			mes "炼金术士公会。";
			mes "我们正在招募";
			mes "有才华的人才";
			mes "和新颖的想法。";
			next;
			mes "[帕米·吉亚尼诺]";
			mes "如果你对化学感兴趣，积累更多知识后再来找我们。";
			next;
			mes "[帕米·吉亚尼诺]";
			mes "只有一点：";
			mes "你必须先具备";
			mes "物品知识，";
			mes "成为商人后再来。";
			close;
		}
		mes "欢迎来到";
		mes "炼金术士公会。";
		mes "我们正在招募";
		mes "有才华的人才";
		mes "和新颖的想法。";
		next;
		mes "[帕米·吉亚尼诺]";
		mes "如果你认识优秀的商人，请务必推荐给我们。他们通常很有炼金和实验天赋~";
		close;
	}
	if (ALCH_Q == 0) {
		mes "欢迎来到";
		mes "炼金术士公会。";
		mes "我能帮你什么？";
		next;
		switch(select("我想了解炼金术士。:我想成为炼金术士。:没什么。")) {
		case 1:
			mes "[帕米·吉亚尼诺]";
			mes "炼金术士研究并利用现有材料创造新物质和物品。我们的知识能在原子层面改变化学品性质。";
			next;
			mes "[帕米·吉亚尼诺]";
			mes "大多数人认为我们的最终目标";
			mes "是制造黄金，但事实并非如此。我们也想制造药物";
			mes "和新材料。";
			next;
			mes "[帕米·吉亚尼诺]";
			mes "少数人研究";
			mes "生命创造，尽管许多人认为那属于上帝的领域。这个领域太复杂，所以大多数人会研究稍简单的项目。";
			next;
			mes "[帕米·吉亚尼诺]";
			mes "如果你想成为炼金术士，建议先积累丰富的商人经验。作为商人接触材料是学习材料知识的好机会。";
			next;
			mes "[帕米·吉亚尼诺]";
			mes "是否尝试成为";
			mes "炼金术士由你决定。这条路充满挑战，你需要专注实验和研究，而不是商业。";
			close;
		case 2:
			mes "[帕米·吉亚尼诺]";
			mes "是这样吗？";
			mes "很高兴见到你。";
			mes "我叫帕米·吉亚尼诺";
			mes "来自炼金术士公会。";
			next;
			mes "[帕米·吉亚尼诺]";
			mes "加入公会并";
			mes "完成训练后，你";
			mes "会被正式认可为";
			mes "炼金术士，并能";
			mes "为研究作出贡献。";
			next;
			mes "[帕米·吉亚尼诺]";
			mes "但我们不会接纳所有人。";
			mes "你必须有坚韧不拔的意志";
			mes "和探索";
			mes "各个科学领域的真诚热情。";
			next;
			mes "[帕米·吉亚尼诺]";
			mes "加入公会有一些";
			mes "要求，";
			mes "但我们会在你申请后";
			mes "讨论";
			mes "这些要求。";
			next;
			mes "[帕米·吉亚尼诺]";
			mes "那么，你愿意";
			mes "申请";
			mes "登记吗？";
			next;
			if (select("我想申请。:我稍后再来。") == 1) {
				if (JobLevel < 40) {
					mes "[帕米·吉亚尼诺]";
					mes "嗯……";
					mes "请稍等。";
					mes "很遗憾，";
					mes "你作为商人的经验";
					mes "还不足以";
					mes "现在加入我们。";
					next;
					mes "[帕米·吉亚尼诺]";
					mes "你至少需要";
					mes "^551A8B职业等级 40^000000 才能成为";
					mes "炼金术士。达到";
					mes "职业等级要求后再回来，";
					mes "好吗？";
					close;
				}
				mes "[帕米·吉亚尼诺]";
				mes "好，你的申请已获接受。现在支付 50,000 Zeny 申请费并带来一些物品，才能开始正式训练。";
				next;
				mes "[帕米·吉亚尼诺]";
				mes "不过，如果你带来 ^551A8B古旧魔法书^000000 和 ^551A8B铁匠之锤^000000，";
				mes "我们会接受它们作为材料要求的替代品。";
				next;
				mes "[帕米·吉亚尼诺]";
				mes "现在……";
				mes "请在申请上";
				mes "签名。";
				next;
				select(strcharinfo(0));
				mes "[帕米·吉亚尼诺]";
				mes "很好，很好。如果你准备好了";
				mes "申请费 Zeny，我会告诉你需要带来的物品。注意听。";
				next;
				if (Zeny < 50000) {
					mes "[帕米·吉亚尼诺]";
					mes "糟糕，你似乎";
					mes "没有足够的 Zeny。";
					mes "准备好 50,000 Zeny 后再回来，否则无法处理申请。";
					close;
				}
				set Zeny, Zeny-50000;
				mes "[Parmy Gianino]";
				mes "让我看看。";
				mes "" + strcharinfo(0);
				mes "需要带来……";
				switch(rand(1,3)) {
				case 1:
					set ALCH_Q,1;
					setquest 2028;
					mes "^551A8B7 Berserk Potions^000000.";
					break;
				case 2:
					set ALCH_Q,2;
					setquest 2029;
					mes "^551A8B100 Mini Furnaces^000000.";
					break;
				case 3:
					set ALCH_Q,3;
					setquest 2030;
					mes "^551A8B7,500 Fire Arrows^000000.";
				}
				next;
				mes "[Parmy Gianino]";
				mes "收集齐这些物品后，";
				mes "回来找我，";
				mes "你的炼金术士训练";
				mes "就会开始。";
				mes "很快再见~";
				close;
			}
			mes "[Parmy Gianino]";
			mes "有才华的商人";
			mes "永远受到这里欢迎。";
			mes "请尽快回来。";
			close;
		case 3:
			mes "[Parmy Gianino]";
			mes "嗯……";
			mes "如果需要什么，";
			mes "请告诉我。";
			close;
		}
	}
	else if (ALCH_Q >= 1 && ALCH_Q <= 3) {
		if (countitem(1006) > 0 && countitem(1005) > 0) {
			mes "那么~！";
			mes "你带来了";
			mes "古旧魔法书和";
			mes "铁匠之锤。";
			mes "我们会好好利用";
			mes "这些物品。";
			next;
			delitem 1006,1; //Old_Magic_Book
			delitem 1005,1; //Hammer_Of_Blacksmith
			mes "[Parmy Gianino]";
			mes "好，现在你需要学习";
			mes "成为炼金术士的基础，以及混合化学品和药剂的流程。";
			set ALCH_Q,4;
			if(checkquest(2028) != -1) {
				changequest 2028,2031;
			}
			else if(checkquest(2029) != -1) {
				changequest 2029,2031;
			}
			else {
				changequest 2030,2031;
			}
			next;
			mes "[Parmy Gianino]";
			mes "不过在此之前，你需要和拉斯普钦交谈。我也不太清楚你们会谈什么……";
			next;
			mes "[Parmy Gianino]";
			mes "应该没什么特别的，但你仍必须和拉斯普钦交谈，因为他似乎负责炼金术士选拔流程。";
			close;
		}
		switch(ALCH_Q) {
		case 1: setarray .@items[0],657,7; break;
		case 2: setarray .@items[0],612,100; break;
		case 3: setarray .@items[0],1752,7500; break;
		}
		if (countitem(.@items[0]) >= .@items[1]) {
			mes "看来";
			mes "你都准备好了。";
			mes "公会会好好利用";
			mes "这些物品。";
			next;
			delitem .@items[0],.@items[1];
			mes "[Parmy Gianino]";
			mes "好，现在你需要学习";
			mes "成为炼金术士的基础，以及混合化学品和药剂的流程。";
			set ALCH_Q,4;
			if(checkquest(2028) != -1) {
				changequest 2028,2031;
			}
			else if(checkquest(2029) != -1) {
				changequest 2029,2031;
			}
			else {
				changequest 2030,2031;
			}
			next;
			mes "[Parmy Gianino]";
			mes "不过在此之前，你需要和拉斯普钦交谈。我也不太清楚你们会谈什么……";
			next;
			mes "[Parmy Gianino]";
			mes "应该没什么特别的，但你仍必须和拉斯普钦交谈，因为他似乎负责炼金术士选拔流程。";
			close;
		}
		mes "你还没准备好吗？";
		mes "正如我之前说的，";
		mes "你必须带来";
		mes "^551A8B"+callfunc("F_InsertPlural",.@items[1],getitemname(.@items[0]))+"^000000.";
		next;
		mes "[Parmy Gianino]";
		mes "准备好所需";
		mes "物品后再回来。";
		mes "";
		close;
	}
	else if (ALCH_Q == 4) {
		mes "去和";
		mes "拉斯普钦先生交谈。";
		mes "他参与";
		mes "炼金术士选拔流程，具体是什么我也不清楚。";
		next;
		mes "[Parmy Gianino]";
		mes "希望这";
		mes "不会太";
		mes "麻烦。我想他只会面试你并询问";
		mes "一些简单问题。";
		close;
	}
	else {
		mes "啊，抱歉，";
		mes "我现在很忙~";
		next;
		mes "[Parmy Gianino]";
		mes "不如问问";
		mes "其他人，如果你不确定";
		mes "下一步该拜访谁。";
		mes "祝你好运~";
		close;
	}
}

alde_alche,175,107,3	script	Fastidious Alchemist#am	749,{
	mes "[拉斯普钦·格里高利]";
	if (BaseJob != Job_Merchant) {
		if (BaseJob == Job_Alchemist) {
			mes "嘻嘻嘻";
			mes "咯咯咯~！";
			mes "咦？你想要什么？！";
			next;
			mes "[拉斯普钦·格里高利]";
			mes "你不是来偷我的实验结果或剽窃作品的吧？竟敢考虑知识盗窃！";
			next;
			mes "[拉斯普钦·格里高利]";
			mes "你不是吧？";
			mes "作为同行，";
			mes "我要警告你，";
			mes "这种伎俩在";
			mes "炼金术士公会";
			mes "是不被容忍的！";
			close;
		}
		else if (BaseClass == Job_Novice) {
			mes "嘻嘻嘻";
			mes "咯咯咯~！";
			mes "真可爱，你一路来到这里";
			mes "只是为了玩耍……";
			next;
			mes "[拉斯普钦·格里高利]";
			mes "这次我让你";
			mes "离开……";
			mes "但下次别指望";
			mes "能这么容易离开……";
			close;
		}
		else {
			mes "什么事？！";
			mes "你想知道";
			mes "我在做什么吗？";
			next;
			mes "[拉斯普钦·格里高利]";
			mes "嘻嘻";
			mes "咯咯咯~！";
			mes "我当然在忙着";
			mes "研究，";
			mes "当然！";
			next;
			mes "[拉斯普钦·格里高利]";
			mes "这瓶";
			mes "药剂完成后……";
			mes "你可以用它";
			mes "征服整个国家！";
			next;
			mes "[拉斯普钦·格里高利]";
			mes "嘻嘻嘻！";
			mes "这么危险的东西";
			mes "必须";
			mes "保密！";
			mes "明白吗？";
			close;
		}
	}
	if (ALCH_Q == 0) {
		mes "嘻嘻嘻";
		mes "咯咯咯~！";
		mes "你想要";
		mes "什么，孩子？";
		next;
		mes "[拉斯普钦·格里高利]";
		mes "商人应该摆摊售卖物品。你为什么在这种地方闲逛？";
		next;
		mes "[拉斯普钦·格里高利]";
		mes "嘿嘿嘿~！";
		mes "去别处摆摊！";
		mes "别妨碍我的";
		mes "黑暗事业！";
		close;
	}
	else if (ALCH_Q >= 1 && ALCH_Q <= 3) {
		mes "嘻嘻嘻";
		mes "咯咯咯~！";
		mes "你想要";
		mes "什么，孩子？";
		next;
		mes "[拉斯普钦·格里高利]";
		mes "什么……？";
		mes "学习炼金术？！";
		mes "别说这种";
		mes "胡话！";
		next;
		mes "[拉斯普钦·格里高利]";
		mes "即使学习一千年甚至更久，对你也没用！忘了它，管好你的商店吧！";
		close;
	}
	else if ((ALCH_Q == 4) || (ALCH_Q == 5)) {
		if (ALCH_Q == 4) {
			mes "嘻嘻嘻";
			mes "咯咯咯~！";
			mes "你想要";
			mes "什么，孩子？";
			next;
			mes "[拉斯普钦·格里高利]";
			mes "什么……？";
			mes "加入公会？！";
			mes "我不喜欢……";
			mes "就是不喜欢……！";
			next;
			mes "[拉斯普钦·格里高利]";
			mes "如今谁都以为自己能";
			mes "只要会混合几种草药就成为炼金术士。所以才需要面试。";
			next;
			mes "[拉斯普钦·格里高利]";
			mes "嘻嘻嘻";
			mes "咯咯咯~！";
			mes "我打算淘汰所有愚蠢无能的人，把他们";
			mes "全部赶走！我们不需要笨蛋！";
			next;
			if (JobLevel == 50) {
				mes "[拉斯普钦·格里高利]";
				mes "等等……";
				mes "也许我";
				mes "误判你了。";
				if (Sex == SEX_MALE) {
					mes "你可能是个漂亮男孩，";
					mes "但从你的眼神我能看出你很聪明。";
					mes "从你的眼神就能看出。";
				}
				else {
					mes "嗯，你确实很可爱，";
					mes "但我看得出你很有头脑。";
				}
				next;
				mes "[拉斯普钦·格里高利]";
				mes "你不只是个蠢孩子。";
				mes "我看得出你作为商人经历过艰难时期。很好。咯咯咯~";
				next;
				mes "[拉斯普钦·格里高利]";
				mes "好吧，为了不侮辱彼此的智力，我让你通过面试。";
				next;
				mes "[拉斯普钦·格里高利]";
				mes "快点成为炼金术士，做好研究，说不定能帮到我。哈哈哈哈哈哈~！";
				next;
				mes "[拉斯普钦·格里高利]";
				mes "现在去找达尔文！";
				mes "他会教你如何实验。告诉他是";
				mes "我派你来的。";
				set ALCH_Q,6;
				changequest 2031,2032;
				close;
			}
			else {
				mes "[拉斯普钦·格里高利]";
				mes "惊讶吗？";
				mes "咯咯咯~如果你以为";
				mes "成为炼金术士只是";
				mes "换换";
				mes "衣服，那么你就";
				mes "大错特错。";
				next;
				mes "[拉斯普钦·格里高利]";
				mes "现在试着解决";
				mes "这些问题。";
				mes "让我看看你";
				mes "到底有多聪明。";
			}
		}
		else if (ALCH_Q == 5) {
			mes "什么……？!";
			mes "你想再参加";
			mes "一次测试？！";
			mes "我不是告诉过你";
			mes "离开吗！";
			next;
			mes "[拉斯普钦·格里高利]";
			mes "我不喜欢……";
			mes "我不喜欢这样！";
			next;

		close3;
	}
	if (ep15_1_elb == 12) {
		mes "[Mark]";
	mes "我走北边的路。之后在上面汇合。";
		cutin "bu_mark2.bmp",0;
		next;
		mes "[Mark]";
	mes "看好杜，他很容易走散。";
		cutin "bu_mark4.bmp",0;
		close3;
	}
	mes "- 看起来普通的喷泉 -";
	mes "- 里面什么也没有。-";
	close;
}


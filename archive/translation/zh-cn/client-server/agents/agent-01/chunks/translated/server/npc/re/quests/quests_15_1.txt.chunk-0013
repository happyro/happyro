		mes "[Alph]";
		mes "道路被堵住了，而且幻影废墟挖掘队没有清理它，一定有原因。在了解更多情况前，还是避开它吧。";
		cutin "bu_alp1.bmp",2;
		next;
		mes "[Du]";
		mes "别取笑我！";
		cutin "bu_du5.bmp",2;
		next;
		mes "[Mark]";
		mes "我同意。";
		mes "我们先去看看其他地方。";
		ep15_1_elb = 15;
		completequest 11375;
		getexp 1000000,0;
		cutin "bu_mark2.bmp",0;
		close3;
	}
	if (ep15_1_elb == 15) {

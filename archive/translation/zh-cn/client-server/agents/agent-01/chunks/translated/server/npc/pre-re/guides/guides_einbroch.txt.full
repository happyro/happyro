					einbroch,72,202,4	script	Guide#ein::EinGuide	852,{
					cutin "ein_soldier",2;
					mes "[艾因布洛克向导]";
					mes "欢迎";
						mes "来到艾因布洛克，";
					mes "钢铁之城。";
				mes "有问题请";
					mes "询问我。";
					set .@loop1,1;
					while (.@loop1) {
					next;
					switch(select("城市指南。:移除小地图标记。:注意事项。:取消。")) {
					case 1:
						mes "[艾因布洛克向导]";
					mes "请选择";
				mes "一个地点";
					mes "从下方菜单。";
					if (.@compass_check == 0) {
					mes "你想让我";
					mes "在小地图上标记地点";
					mes "吗？";
					next;
						if (select("是。:否。") == 1) set .@compass_check,1;
					}
				set .@loop2,1;
					while(.@loop2) {
					if (.@wait_button_chk == 0) set .@wait_button_chk,1;
					else next;
					switch(select("^FF0000机场^000000:火车站:工厂:广场:酒店:武器店:实验室:铁匠公会:艾因布洛克塔:取消")) {
					case 1:
					mes "[艾因布洛克向导]";
					mes "^FF0000机场^000000位于";
						mes "城市西北部。";
					mes "在那里你能看到";
				mes "城市的骄傲飞艇。登上飞艇需要支付费用。";
					if (.@compass_check)
					viewpoint 1,63,228,2,0xFF0000;
					break;
					case 2:
					mes "[艾因布洛克向导]";
					mes "火车站位于";
					mes "艾因布洛克东北部。";
						mes "往返这里";
					mes "和艾因贝赫的列车";
				mes "全天运行，";
					mes "每天如此。";
					if (.@compass_check)
					viewpoint 1,236,279,3,0xFF00FF;
					break;
					case 3:
					mes "[艾因布洛克向导]";
						mes "工厂可能是艾因布洛克";
					mes "最重要的设施，位于";
				mes "城市南部。";
					mes "";
					if (.@compass_check)
					viewpoint 1,158,78,4,0xFF00FF;
					break;
					case 4:
					mes "[艾因布洛克向导]";
					mes "广场是最大的";
						mes "购物区，位于";
					mes "艾因布洛克中心";
				mes "正东。";
					if (.@compass_check)
					viewpoint 1,232,190,5,0xFF00FF;
					break;
					case 5:
					mes "[艾因布洛克向导]";
					mes "酒店位于广场以东，";
					mes "提供顶级";
						mes "住宿。";
					mes "在那里你能舒适地享受";
				mes "艾因布洛克之旅~";
					if (.@compass_check)
					viewpoint 1,260,201,6,0x00FF00;
					break;
					case 6:
					mes "[艾因布洛克向导]";
					mes "武器店位于";
					mes "广场以北。你可以在那里";
				mes "购买";
			mes "供自己使用的";
			mes "武器。";
		if (.@compass_check)
			viewpoint 1,215,221,7,0x00FF00;
			break;
			case 7:
			mes "[艾因布洛克向导]";
			mes "实验室是工厂的附属设施，";
			mes "位于艾因布洛克";
			mes "西南区域。";
			if (.@compass_check)
			viewpoint 1,36,49,8,0x00FF;
			break;
			case 8:
			mes "[艾因布洛克向导]";
			mes "铁匠公会位于";
			mes "艾因布洛克东南部。";
			mes "你可以使用他们的服务";
			mes "升级装备。";
			if (.@compass_check)
			viewpoint 1,244,90,9,0x00FF00;
		break;
			case 9:
			mes "[艾因布洛克向导]";
			mes "艾因布洛克塔位于";
			mes "城市中心。从塔顶可以";
			mes "俯瞰整个艾因布洛克。";
			if (.@compass_check)
			viewpoint 1,174,195,10,0xFFFF00;
			break;
			case 10:
			mes "[艾因布洛克向导]";
			mes "如果不想继续显示地点标记，";
			mes "请让我‘移除小地图标记’。";
			set .@loop2,0;
			}
			}
			break;
			case 2:
			viewpoint 2,63,228,2,0xFF0000;
			viewpoint 2,236,279,3,0xFF00FF;
			viewpoint 2,158,78,4,0xFF00FF;
			viewpoint 2,232,190,5,0xFF00FF;
			viewpoint 2,260,201,6,0x00FF00;
			viewpoint 2,215,221,7,0x00FF00;
		viewpoint 2,36,49,8,0x00FF00;
			viewpoint 2,244,90,9,0x00FF00;
			viewpoint 2,174,195,10,0xFFFF00;
			set .@compass_check,0;
			mes "[艾因布洛克向导]";
			mes "好的，小地图上的标记已移除。";
			mes "如果需要艾因布洛克周边的指导，";
			mes "请告诉我或其他向导。";
			break;
		case 3:
	mes "[艾因布洛克向导]";
	mes "通过施瓦尔茨瓦德共和国的技术，";
	mes "我们升级了数字信息系统，";
mes "可以在你的小地图上标记地点，";
mes "方便导航。";
next;
mes "[艾因布洛克向导]";
mes "小地图位于屏幕右上角。";
mes "如果看不到，请按 Ctrl + Tab，";
	mes "或点击基础信息窗口的‘地图’按钮。";
	next;
	mes "[艾因布洛克向导]";
	mes "在小地图上点击‘+’和‘-’";
	mes "可以放大和缩小。祝你在艾因布洛克";
	mes "旅途愉快，冒险者。";
	break;
	case 4:
	mes "[艾因布洛克向导]";
		mes "希望你在艾因布洛克";
		mes "旅途愉快。";
		mes "哦，还请注意烟雾警报。";
			close2;
			set .@loop1,0;
			}
			}
			cutin "ein_soldier",255;
				end;
				}
				
				einbroch,155,43,4	duplicate(EinGuide)	Guide#2ein	852
				einbroch,162,317,4	duplicate(EinGuide)	Guide#3ein	852
			
			einbech,67,37,4	script	Guide#4ein::EinGuide2	852,{
			cutin "ein_soldier",2;
				mes "[Einbech Guide]";
				mes "欢迎来到艾因贝赫，";
				mes "矿业城镇。我们在这里";
				mes "为游客提供帮助，";
					mes "如果你有任何问题，";
					mes "请随时询问。";
					set .@loop1,1;
					while (.@loop1) {
					next;
					switch(select("城市指南。:移除小地图标记。:注意事项。:取消。")) {
					case 1:
						mes "[Einbech Guide]";
					mes "请选择";
				mes "一个地点";
					mes "从下方菜单。";
					if (.@compass_check == 0) {
					mes "你想让我";
					mes "在小地图上标记地点";
					mes "吗？";
					next;
						if (select("是。:否。") == 1) set .@compass_check,1;
					}
				set .@loop2,1;
					while (.@loop2) {
					if (.@wait_button_chk == 0) set .@wait_button_chk,1;
					else next;
					switch(select("火车站:酒馆:工具店:剑士公会:矿井:取消")) {
					case 1:
					mes "[Einbech Guide]";
					mes "火车站位于艾因贝赫";
						mes "西北部和东北部。你可以";
					mes "在那里乘坐前往艾因布洛克的火车。";
				if (.@compass_check)
					viewpoint 1,43,213,2,0xFF0000;
					break;
					case 2:
					mes "[艾因贝赫向导]";
					mes "酒馆位于艾因贝赫南部。";
					mes "这是结束漫长一天后";
					mes "放松的好地方。";
					if (.@compass_check)
						viewpoint 1,142,112,3,0xFF00FF;
					break;
				case 3:
					mes "[艾因贝赫向导]";
					mes "工具店位于艾因贝赫中心。";
					mes "在那里可以买到旅行可能";
					mes "需要的各种工具。";
					if (.@compass_check)
					viewpoint 1,176,136,4,0xFF00FF;
					break;
						case 4:
					mes "[艾因贝赫向导]";
				mes "剑士公会位于艾因贝赫东郊。";
					mes "目前正在建设，尚未开始";
					mes "接受申请。";
					if (.@compass_check)
					viewpoint 1,250,110,5,0xFF00FF;
					break;
					case 5:
					mes "[艾因贝赫向导]";
				mes "矿井是艾因贝赫的主要产业，";
			mes "位于城镇北部。这里产出矿石，";
			mes "尽管怪物会阻碍矿工。";
		if (.@compass_check)
			viewpoint 1,138,251,6,0x00FF00;
			break;
			case 6:
			mes "[艾因贝赫向导]";
			mes "如果不想在小地图上显示地点标记，";
			mes "请让我‘移除小地图标记’。";
			set .@loop2,0;
			}
			}
			break;
			case 2:
			viewpoint 2,43,213,2,0xFF0000;
			viewpoint 2,142,112,3,0xFF00FF;
			viewpoint 2,176,136,4,0xFF00FF;
		viewpoint 2,250,110,5,0xFF00FF;
			viewpoint 2,138,251,6,0x00FF00;
			set .@compass_check,0;
			mes "[艾因贝赫向导]";
			mes "好的，小地图上的标记已移除。";
			mes "如果需要艾因贝赫周边的指导，";
			mes "请告诉我或其他向导。";
			break;
			case 3:
			mes "[艾因贝赫向导]";
			mes "通过施瓦尔茨瓦德共和国的技术，";
			mes "我们升级了数字信息系统，";
			mes "可以在小地图上标记地点，";
			mes "方便导航。";
			next;
			mes "[艾因贝赫向导]";
			mes "小地图位于屏幕右上角。";
			mes "如果看不到，请按 Ctrl + Tab，";
			mes "或点击基础信息窗口的‘地图’按钮。";
			next;
			mes "[艾因贝赫向导]";
			mes "在小地图上点击‘+’和‘-’";
			mes "可以放大和缩小。祝你在艾因贝赫";
			mes "旅途愉快，冒险者。";
		break;
			case 4:
			mes "[艾因贝赫向导]";
			mes "希望你在艾因贝赫";
			mes "旅途愉快。";
			close2;
			set .@loop1,0;
		}
	}
	cutin "ein_soldier",255;
	end;
}

einbech,48,214,4	duplicate(EinGuide2)	Guide#5ein	852

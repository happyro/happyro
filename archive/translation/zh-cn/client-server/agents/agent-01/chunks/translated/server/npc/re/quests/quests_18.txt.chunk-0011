		cutin "ep18_miriam_01.png",1;
		mes "[Miriam]";
		mes "遭遇挫折后，一直无精打采的副手突然恢复了精神，变得积极起来。从那以后，阿鲁纳佩尔兹的原住民和移民之间的紧张关系逐渐升级。";
		next;
		cutin "",255;
		mes "[Mini Elly]";
		mes "这大致与心脏猎人从宅邸逃脱的时间吻合。";
		next;
		cutin "ra_gman2.bmp",0;
		mes "[Zed]";
		mes "看来他们确实串通在了一起。";
		next;
		select( "因为我亲眼见过。" );
		cutin "ra_gwoman.bmp",0;
		mes "[Niren]";
		mes "令人不安的是，青年阿迈勒副院长不可能不知道伊米尔心脏碎片的价值。仅仅通过渗透组织制造冲突，不足以让他轻易背叛组织……";
		next;
		cutin "ep18_suad_01.png",2;
		mes "[Suad]";
		mes "他们是同意收取更多东西后再把它交出去吗？";
		next;
		cutin "ep18_miriam_01.png",1;
		mes "[Miriam]";
		mes "我不确定，但我的副手……不，我得亲自去确认。";
		next;
		cutin "ep18_suad_01.png",2;
		mes "[Suad]";
		mes "你要去哪？你知道该从哪里开始找吗？";
		next;
		cutin "ep18_miriam_01.png",1;
		mes "[Miriam]";
		mes "拉赫的郊外有一座避暑别墅。最近，我的副手经常去那里接受治疗。如果他和那些疯狂科学家合谋策划什么事情，他大概就在那里。";
		next;
		cutin "",255;
		mes "[Mini Elly]";
		mes "我们需要追踪调查。";
		next;
		cutin "ra_gwoman.bmp",0;
		mes "[Niren]";
		mes "追查偷走心脏碎片的人就交给米里亚姆吧。希望冒险者能陪她一起去。";
		next;
		select( "明白了。" );
		cutin "ra_gman2.bmp",0;
		mes "[Zed]";
		mes "我们会留在这里照顾伤员，并确认附近是否还有掉队的人。我们也需要考虑民众的看法。";
		next;
		cutin "ep18_suad_01.png",2;
		mes "[Suad]";
		mes "我们也得回森林处理后续事宜。";
		mes "米里亚姆，冒险者。追踪的事就拜托你们了。";
		next;
		cutin "ep18_miriam_01.png",1;
		mes "[Miriam]";
		mes "走吧，冒险者。在前往别墅之前，还有人会和我们同行。我们在<NAVI>[奥兹迷宫]<INFO>oz_dun01,223,116,0,101,0</INFO></NAVI>会合。";
		erasequest 17521;
		setquest 17525;
		ep18_main = 53;
		getitem 1000405,60;	// Ep18_Amethyst_Fragment
		getexp 18252408,2000000;
		close2;
		cutin "",255;
		cloakonnpcself( "Miriam#sms04" );
		cloakonnpcself( "Suad#sms04" );
		end;
	}
	if (ep18_main == 53) {
		cutin "ra_gwoman.bmp",0;
		mes "[Niren]";
		mes "我们约好在<NAVI>[奥兹迷宫]<INFO>oz_dun01,223,116,0,101,0</INFO></NAVI>与米里亚姆会合。";
		close3;
	}
	mes "[Miriam]";
	mes "最近这里的情况不太好。";
	close;

OnInit:
	questinfo( QTYPE_QUEST2, QMARK_YELLOW, "isbegin_quest(17521) == 1" );
	end;
}

// Main Quest: Step 60.
oz_dun01,223,116,3	script	Appointment Point#c12_evt01	4_POINT_BLUE,5,5,{
	if (ep18_main < 53)
		end;
	if (ep18_main == 53) {
		mes "抵达会合地点。";
		mes "其他人似乎还没到。";
		mes "我们等等吧。";
		close2;
		setpcblock PCBLOCK_NPC, true;
		emotion ET_THINK, playerattached();
		sleep2 2000;
		emotion ET_SLEEPY, playerattached();
		cloakoffnpcself( "Maram#c12_01" );
		npctalk "哦！它还在那里！", "Maram#c12_01", bc_self;
		sleep2 500;
		cloakoffnpcself( "Suad#c12_01" );
		npctalk "是不是太晚了？", "Suad#c12_01", bc_self;
		setpcblock PCBLOCK_NPC, false;

		select( "你是在等米里亚姆吗？" );
		mes "[Maram]";
		mes "我征得母亲同意，出来一会儿。";
		mes "我正在处理中抗议活动，所以很快就得回去，不过……";
		mes "米里亚姆在哪里？";
		cutin "ep18_maram_01.png",2;
		next;
		mes "[Suad]";
		mes "她来了。";
		cutin "ep18_suad_01.png",0;
		next;
		cloakoffnpcself( "Miriam#c12_01" );
		cloakoffnpcself( "Ira#c12_01" );
		mes "[Miriam]";
		mes "抱歉来晚了。我花了些时间找人。";
		cutin "ep18_miriam_01.png",0;
		next;
		mes "[Miriam]";
		mes "这是艾拉。";
		mes "她经常帮我父亲送书，是个孩子，不过她需要帮助才能进入别墅。";
		next;
		cutin "",255;
		npctalk "你好。", "Ira#c12_01", bc_self;
		next;
		mes "[Maram]";
		mes "什么，艾拉为什么在这里？";
		mes "她和这件事有关吗？";
		cutin "ep18_maram_01.png",2;
		next;
		cutin "",255;
		mes "[Ira]";
		mes "好久不见，玛拉姆姐姐。";
		mes "我正好来报答米里亚姆姐姐的恩情。";
		next;
		mes "[Ira]";
		mes "你说别墅里有东西要看？";
		mes "我一直推着阿迈勒大人的轮椅，所以哪里都去过。";
		next;
		mes "[Ira]";
		mes "碰巧我有仆人的钥匙。最近一直陪着阿迈勒大人，所以还没归还。";
		mes "最近我也一直和阿迈勒大人外出，因此还没还回去。";
		next;
		mes "[Ira]";
		mes "至于那座别墅。";
		mes "我们有时会把它借给祭司。";
		mes "这次也是一样。";
		mes "但有点奇怪。";
		next;
		mes "[Suad]";
		mes "奇怪？";
		mes "如果你能说具体一点就好了。";
		cutin "ep18_suad_04.png",0;
		next;
		cutin "",255;
		mes "[Ira]";
		mes "他们说会有一些祭司暂住一阵子，但感觉像是在撒谎……";
		next;
		mes "[Ira]";
		mes "看来阿迈勒大人又在运营一个秘密组织。";
		mes "上次他不是说要发动战争，却被赶出了神殿吗？";
		next;
		mes "[Ira]";
		mes "看来他还没有放弃。";
		mes "这次住在别墅里的人似乎比上次更加危险。";
		next;
		mes "[Ira]";
		mes "不管是谁，我都希望有人能阻止他。";
		mes "气氛也很糟糕。";
		mes "如果发生战争，我们这些原住民会成为被战火波及的人。";
		next;
		mes "[Miriam]";
		mes "嗯……不，不会发生战争。";
		mes "放松点，没事的。";
		cutin "ep18_miriam_01.png",0;
		next;
		cutin "",255;
		mes "[Ira]";
		mes "姐姐！你怎么能这么冷静？";
		mes "你知道我管理那座别墅时有多害怕吗？！";
		mes "尤其是那里还有那个奇怪的女人……";
		next;
		mes "[Maram]";
		mes "哈哈哈……";
		mes "好了，冷静点，艾拉。";
		mes "我们现在聚在这里就是为了查清这件事。";
		cutin "ep18_maram_02.png",2;
		next;
		mes "[Miriam]";
		mes "因此，我们打算进入那座住着好斗客人的别墅。";
		mes "因为他们似乎就是我们在神殿遇到的那些人。";
		cutin "ep18_miriam_01.png",0;
		next;
		mes "[Suad]";
		mes "我明白你的意思。";
		mes "老实说，我也想和你们一起去。";
		mes "但我还有事情要处理。";
		cutin "ep18_suad_01.png",0;
		next;
		mes "[Maram]";
		mes "是啊。我匆忙征得同意，出来一会儿。";
		mes "我还需要处理抗议活动并做一些协调工作。";
		cutin "ep18_maram_01.png",2;
		next;
		mes "[Maram]";
		mes "抱歉，但我和苏阿德不能和你们一起去。";
		mes "你能理解吗？";
		next;
		mes "[Miriam]";
		mes "当然。";
		mes "你们自己处理事情比较好。";
		mes "我会依靠狼村的人。";
		cutin "ep18_miriam_01.png",0;
		next;
		mes "[Miriam]";
		mes "那么，" + strcharinfo(0) + "，你愿意和我们一起侦察别墅吗？";
		next;
		select( "交给我吧。" );
		mes "[Suad]";
		mes "谢谢你的理解。";
		mes "如果你们安全进入别墅，我们会带着艾拉一起去。";
		cutin "ep18_suad_01.png",0;
		next;
		mes "[Miriam]";
		mes "谢谢。";
		mes "那么，艾拉。你能送我们去别墅吗？";
		cutin "ep18_miriam_01.png",0;
		next;
		cutin "",255;
		mes "[Ira]";
		mes "当然。";
		mes "准备好后和我说一声。";
		mes "我马上送你们过去。";
		erasequest 17525;
		setquest 18083;
		ep18_main = 54;
		close;
	}
	if (ep18_main == 54) {
		npctalk "准备好了吗？", "Ira#c12_01", bc_self;
		cloakoffnpcself( "Miriam#c12_01" );
		cloakoffnpcself( "Ira#c12_01" );
		end;
	}
	if (ep18_main == 55) {
		cloakoffnpcself( "Maram#c12_01" );
		end;
	}
	mes "你可以进入 MD 纪念馆的别墅剧情模式。";
	mes "已经完成该剧情的冒险者只能陪同其他冒险者进入。";
	mes "要和你的同伴一起进入吗？";
	next;
	.@md_name$ = "High Priest's Villa";

	select( "进入" + .@md_name$ + "" );

	switch( instance_enter(.@md_name$) ) {
	case IE_OTHER:
		mes "^ff0000发生未知错误。^000000";
		close;
	case IE_NOINSTANCE:
		mes "目前无法陪同进入。请确认同行队员是否申请了 MD。";
		close;
	case IE_NOMEMBER:
		mes "^ff0000只有队伍成员才能进入纪念地下城。^000000";
		close;
	case IE_OK:
		mapannounce "oz_dun01", "玩家 " + strcharinfo(0) + " 所在的 " + getpartyname( getcharid(1) ) + " 队伍进入了 " + .@md_name$ + "。", bc_map, 0xFF99;
		// warp "1@adv",123,17;
		end;
	}
	end;

OnTouch:
	if (ep18_main == 54) {
		npctalk "准备好了吗？", "Ira#c12_01", bc_self;
		cloakoffnpcself( "Miriam#c12_01" );
		cloakoffnpcself( "Ira#c12_01" );
		end;
	}
	if (ep18_main == 55) {
		cloakoffnpcself( "Maram#c12_01" );
		end;
	}
	end;

OnInit:
	questinfo( QTYPE_CLICKME, QMARK_YELLOW, "isbegin_quest(17525) == 1" );
	end;
}

oz_dun01,223,120,5	script(CLOAKED)	Suad#c12_01	4_EP18_SUAD,{
	mes "[Suad]";
	mes "抱歉把这件麻烦事交给你。";
	mes "但灰狼村的成员一定还在等我。";
	cutin "ep18_suad_01.png",0;
	next;
	mes "[Suad]";
	mes "米里亚姆就拜托你了。";
	close3;
}

oz_dun01,220,118,5	script(CLOAKED)	Miriam#c12_01	4_EP18_MIRIAM,{
	mes "[Miriam]";
	mes "只有米里亚姆和冒险者能进入别墅。";
	mes "苏阿德和玛拉姆会回去处理抗议活动。";
	cutin "ep18_miriam_01.png",0;
	next;
	mes "[Miriam]";
	mes "据说别墅位于这处峡谷下方。";
	mes "艾拉有单独的入口钥匙，所以准备好后去找艾拉。";
	close3;
}

// Main Quest: Step 61. (entrance npc is a part of the instance Villa of High Priest)
// Main Quest: Step 62-66 inside the instance.

// Main Quest: Step 67.
oz_dun01,225,119,3	script(CLOAKED)	Maram#c12_01	4_EP18_MARAM,{
	if (ep18_main == 55) {
		mes "[Maram]";
		mes "哦，你来了。";
		mes "情况已经稍微解决了，所以我过来看看你。";
		mes "米里亚姆和尤斯祭司去了神殿。";
		cutin "ep18_maram_01.png",2;
		next;
		mes "[Maram]";
		mes "由于尤斯祭司大闹一场，苏阿德只好把他护送离开。";
		mes "他们说会在神殿讨论详情。";
		next;
		mes "[Maram]";
		mes "你要马上去那里吗？";
		next;
		if (select( "我会请求你的帮助。", "我自己去。" ) == 2)
			end;
		mes "[Maram]";
		mes "那我们一起从这边走吧。哈哈……";
		close2;
		cutin "",255;
		warp "ra_temin",169,26;
		end;
	}
	mes "[Maram]";
	mes "即使这件事是心脏猎人和幻影捏造的，也迟早会爆发。";
	cutin "ep18_maram_01.png",2;
	next;
	mes "[Maram]";
	mes "我不知道为什么大家想要和平共处会这么困难。";
	cutin "ep18_maram_03.png",2;
	next;
	mes "[Maram]";
	mes "这些烦恼就交给我们吧。";
	mes "冒险者，和米里亚姆一起调查别墅。";
	mes "我不知道阿迈勒在想什么。";
	cutin "ep18_maram_01.png",2;
	close3;

OnInit:
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "isbegin_quest(18084) == 1" );
	end;
}

// Main Quest: Step 68.
ra_temin,256,130,1	script	Temple Knight#c12_02	4_M_RASWORD,3,3,{
	if (ep18_main == 55 || ep18_main == 56)
		end;
	mes "[Temple Knight]";
	mes "塞特鲁姆尼尔圣域。";
	mes "大礼拜堂不在这里，请回去吧。";
	close;
OnTouch:
	if (ep18_main == 55 || ep18_main == 56) {
		npctalk "我一直在等你。请进来吧。", "Temple Knight#c12_02", bc_self;
		cloakoffnpcself( "Niren#c12last" );
		cloakoffnpcself( "Maram#c12last" );
		cloakoffnpcself( "Suad#c12last" );
		cloakoffnpcself( "Miriam#c12_02" );
		end;
	}
	npctalk "除官员外禁止进入。", "Temple Knight#c12_02", bc_self;
	warp "ra_temin",255,138;
	end;
}

ra_temin,254,117,5	script(CLOAKED)	Miriam#c12_02	4_EP18_MIRIAM,{
	if (getequipid(EQI_HEAD_TOP) == 400127 && countitem(400127) == 1) {	// player must unequip the item
		mes "你必须携带拉伸后的艾莉。";
		close;
	}
	if (ep18_main == 55) {
		cutin "ep18_miriam_01.png",0;
		mes "[Miriam]";
		mes "你到达时，我听说了一些详细情况……";
		mes "看来真正的目标是通过伊米尔的碎片召唤芙蕾雅。";
		next;
		cutin "ep18_miriam_03.png",0;
		mes "[Miriam]";
		mes "煽动原住民和移民之间的冲突，也是为了转移神殿和民众的注意力。";
		mes "唉……";
		mes "[Miriam]";
		mes "有多少人因为那件事受苦挣扎……";
		next;
		mes "[Miriam]";
		mes "神？神究竟是什么？";
		mes "我的父亲究竟祈求什么，才会献上如此错误的祷告？";
		next;
		mes "[Miriam]";
		mes "....";
		mes "我得再问问，才能了解详情。";
		mes "但我真的对盲目信仰感到幻灭。";
		next;
		cutin "ra_gwoman.bmp",2;
		mes "[Niren]";
		mes "你真的毫无廉耻。";
		mes "我从没想过青年会做出这种事。";
		next;
		mes "[Niren]";
		mes "你还记得他曾经是强硬派的首领吗？";
		mes "但他没能发动战争。";
		mes "因此从前线退下后，他一直在幕后策划这种事情。";
		next;
		mes "[Niren]";
		mes "我们是神的仆人，侍奉神的意志。";
		mes "我们一直在等待，希望芙蕾雅能再次向我们传达神谕。";
		next;
		mes "[Niren]";
		mes "即便如此，我们也不能妄图把神召唤到凡间。";
		mes "那不是神的意志。";
		next;
		mes "[Niren]";
		mes "青年违反了禁忌。";
		mes "胆敢自称神的仆人，还试图将神据为己有。";
		next;
		mes "[Niren]";
		mes "光是这一点就不可饶恕，而且他还因此让神和无辜的人承受痛苦。";
		mes "伊米尔心脏遗失的碎片该怎么办……";
		next;
		cutin "ep18_maram_03.png",2;
		mes "[Maram]";
		mes "母亲。";
		mes "我们可以取回伊米尔的心脏碎片。";
		mes "别太担心。";
		next;
		cutin "ep18_miriam_01.png",0;
		mes "[Miriam]";
		mes "你说得对。";
		mes "我也会取回伊米尔的心脏碎片。";
		next;
		mes "事情变得越来越复杂了。";
		mes "我们什么时候才能介入……";
		next;
		cutin "ep18_suad_01.png",0;
		mes "[Suad]";
		mes "....";
		mes "既然你在这里，就现身吧。";
		next;
		cutin "ra_gwoman.bmp",2;
		mes "[Niren]";
		mes "哦，我们讨论得太投入，竟没意识到冒险者已经到了。";
		mes "你的调查怎么样？";
		mes "是关于在青年宅邸发现的那个亵渎之物的残骸。";
		next;
		cutin "ep18_miriam_01.png",0;
		mes "[Miriam]";
		mes "是叫‘巴戈特’，对吧？";
		mes "我们在宅邸看到的是巴戈特制造的合成兽……";
		close2;
		cutin "",255;
		unittalk getcharid(3), "" + strcharinfo(0) + "：艾莉：请听我解释。", bc_self;
		cloakoffnpcself( "Elly's Figure#c12_02" );
		specialeffect EF_BLUELIGHTBODY, AREA, "Elly's Figure#c12_02";
		erasequest 18084;
		setquest 18085;
		ep18_main = 56;
		end;
	}
	npctalk "在父亲犯下更大的罪之前，我们不得不阻止他。", "Miriam#c12_02", bc_self;
	end;

OnInit:
	questinfo( QTYPE_QUEST2, QMARK_YELLOW, "isbegin_quest(18084) == 1" );
	end;
}

// Main Quest: Step 69.
ra_temin,258,117,3	script(CLOAKED)	Elly's Figure#c12_02	4_EP17_TABLET,{
	disable_items;
	if (checkweight(1201,2) == 0) {
		mes "- 等一下！！-";
		mes "- 你目前携带了-";
		mes "- 太多物品。-";
		mes "- 请减轻负重后-";
		mes "- 再试一次。-";
		close;

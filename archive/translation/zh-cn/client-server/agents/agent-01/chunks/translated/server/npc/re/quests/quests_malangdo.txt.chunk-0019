			mes "你很有礼貌，喵。不过很遗憾，我只能给你这些，喵。";
			break;
		}
		next;
		mes "[Paa]";
		mes "再见，喵~明天再来练习，喵~";
		if (.@win == 5) {
			mes "哦！你赢了全部 5 场比赛，喵。给你一些额外罐头，喵！";
			getitem 12636,10; //Malang_Sp_Can
		} else
			getitem 12636,5; //Malang_Sp_Can
		setquest 5070;
		close;
	}
	mes "[Paa]";
	mes "你输了。喵……喵……";
	next;
	mes "帕变得非常傲慢。";
	next;
	mes "[Paa]";
	mes "你想和我玩吗？帕？凭你那点技术？喵？";
	next;
	mes "[Paa]";
	mes "什么？要礼物，喵？你怎么能提出这种要求，喵？你输了，喵！继续练习！！工作！！没错，我就该让你做这个，喵！！";
	next;
	setquest 5070;
	switch(rand(1,13)) {
	case 1:
		setquest 5074;
		mes "[Paa]";
		mes "嗯。你知道一种叫菲恩的鱼吗，喵？知道吗？它看起来很好吃，对吧，喵？";
		next;
		mes "- 咕噜 -";
		mes "帕擦了擦嘴边的口水。";
		next;
		mes "[Paa]";
		mes "去捕捉 30 只菲恩，喵。再给我拿 10 个鱼尾，喵。把它们交给我们的猫咪总监，他会用它们做出美味的料理，喵。";
		close;
	case 2:
		setquest 5075;
		mes "[Paa]";
		mes "最近我感到无力，身上的负担也太重了，喵。我应该照顾好自己的健康，喵。";
		next;
		mes "[Paa]";
		mes "现在是吃健康食物的时间，喵。";
		next;
		mes "[Paa]";
		mes "给我们的猫咪玩家总监带 50 只马尔斯和 25 瓶牛奶，喵。他非常了解健康食物，喵。";
		close;
	case 3:
		setquest 5076;
		mes "[Paa]";
		mes "我们确实有竞争对手，喵。他们是‘狗狗华尔兹’，他们一出现就什么都不顺利，喵。";
		next;
		mes "[Paa]";
		mes "我本来想让你欺负他们，但那应该是违法的，喵……所以我会让你骚扰长得相似的怪物，喵。";
		next;
		mes "[Paa]";
		mes "哦，是狗头人中的弓箭手，喵！！我最讨厌那些家伙。去骚扰 30 只狗头人弓箭手，然后向我们的猫咪玩家总监报告，喵。";
		close;
	case 4:
		setquest 5077;
		mes "[Paa]";
		mes "赢得比赛最重要的是什么，喵？是敏捷。我们该怎么变快，喵？";
		next;
		mes "[Paa]";
		mes "我想过了，喵……对我们猫来说，最好的方法显然是捉老鼠，喵。";
		next;
		mes "[Paa]";
		mes "你知道痉挛鱼吧，喵？就是那种蓝色胖乎乎的生物，喵……请去捕捉 10 只，然后向我们的猫咪玩家总监报告，喵。";
		close;
	case 5:
		setquest 5078;
		mes "[Paa]";
		mes "咕噜……我想吃鸟肉料理，喵。哪种最美味，喵？";
		next;
		mes "[Paa]";
		mes "啄木鸟？啊！太小了，喵。秃鹰怎么样？我不确定……波波利，喵？";
		next;
		mes "[Paa]";
		mes "好吧，喵！请捕捉 50 只波波利，交给我们的猫咪玩家总监，喵。今晚我们要举办鸟肉料理派对，喵。";
		close;
	case 6:
		setquest 5079;
		mes "[Paa]";
		mes "我在比赛前太紧张了，喵。紧张时我发挥不好，喵。比赛开始前需要一些东西让我冷静，喵。";
		next;
		mes "[Paa]";
		mes "哦！对了，喵！毛线，喵！我小时候经常玩毛线，喵。加入‘猫咪玩家’后就没法这样放松了，喵。";
		next;
		mes "[Paa]";
		mes "请给我拿 20 个毛线，喵。为什么是 20 个？还有很多猫也有同样的问题，喵。我们的总监会替你处理，喵。";
		close;
	case 7:
		setquest 5080;
		mes "[Paa]";
		mes "最近我们的总监似乎一直在削减开支，喵。还是管理者在占便宜，喵？";
		next;
		mes "[Paa]";
		mes "玩家们的日常零食减少了，喵。你应该去拿 30 个鼠尾，交给我们的猫咪玩家总监，喵。";
		next;
		mes "[Paa]";
		mes "这样我们就能知道管理者是不是贪心了，喵。";
		close;
	case 8:
		setquest 5081;
		mes "[Paa]";
		mes "我最近状态低迷，喵。没法把 100% 的精力投入比赛，喵。";
		next;
		mes "[Paa]";
		mes "这种时候我们需要柠檬，喵。";
		next;
		mes "[Paa]";
		mes "给我拿 5 个柠檬，喵。别忘了，我需要 5 个柠檬，喵……我们的猫咪玩家总监应该知道怎么用它们，喵。";
		close;
	case 9:
		setquest 5082;
		mes "[Paa]";
		mes "马兰多是适合猫生活的地方，喵。但我们比赛时会变得很热，喵。";
		next;
		mes "[Paa]";
		mes "我们玩得多时会热得发疯，很难忍受，喵。你知道我们猫发起狂来有多可怕吧，喵？";
		next;
		mes "[Paa]";
		mes "给我拿 10 个冰块或 10 个冰淇淋。我们的猫咪玩家总监应该知道怎么用它们，喵。";
		close;
	case 10:
		setquest 5083;
		mes "[Paa]";
		mes "我看你也需要休息，喵。尽管放松一会儿，喵。去村子里散散步怎么样，喵？我坚持，喵~！";
		next;
		mes "[Paa]";
		mes "不过只在村子里散步没意思，喵。嗯……对了，喵！！去见一只叫艾利乌的猫怎么样，喵？";
		next;
		mes "[Paa]";
		mes "哦！见到那只猫时，记得说‘回来’，喵。这是密码，喵。别忘了告诉我们的总监我一直和你在一起，喵！！";
		close;
	case 11:
		setquest 5085;
		mes "[Paa]";
		mes "我看你也需要休息，喵。尽管放松一会儿，喵。去村子里散散步怎么样，喵？我坚持，喵~！";
		next;
		mes "[Paa]";
		mes "不过只在村子里散步没意思，喵。嗯……对了，喵！！去见一只叫炖汤的猫怎么样，喵？";
		next;
		mes "[Paa]";
		mes "哦！见到那只猫时，记得说‘回来’，喵。这是密码，喵。别忘了告诉我们的总监我一直和你在一起，喵！！";
		close;
	case 12:
		mes "[Paa]";
		mes "我看你也需要休息，喵。尽管放松一会儿，喵。去村子里散散步怎么样，喵？我坚持，喵~！";
		next;
		mes "[Paa]";
		mes "不过只在村子里散步没意思，喵。嗯……对了，喵！！去见一只叫番茄酱的猫怎么样，喵？";
		next;
		mes "[Paa]";
		mes "哦！见到那只猫时，记得说‘回来’，喵。这是密码，喵。别忘了告诉我们的总监我一直和你在一起，喵！！";
		close;
	case 13:
		mes "[Paa]";
		mes "我看你也需要休息，喵。尽管放松一会儿，喵。去村子里散散步怎么样，喵？我坚持，喵~！";
		next;
		mes "[Paa]";
		mes "不过只在村子里散步没意思，喵。嗯……对了，喵！！去见一只叫艾夫的猫怎么样，喵？";
		next;
		mes "[Paa]";
		mes "哦！见到那只猫时，记得说‘回来’，喵。这是密码，喵。别忘了告诉我们的总监我一直和你在一起，喵！！";
		close;
	}
}

mal_in01,91,222,4	script	Kuka#gamer	422,{
	if (MaxWeight - Weight < 1000) {
		mes "你的物品栏重量太高，无法继续。减轻负重后再来。";
		close;
	}
	if (checkweight(1201,1) == 0) {
		mes "你的物品栏太满，无法继续。腾出空间后再来。";
		close;
	}
	for(set .@i,5074; .@i<=5090; set .@i,.@i+1) {
		if (checkquest(.@i) > -1) {
			mes "[Kuka]";
			mes "你还没有完成我们拜托你的事情，哟~一诺千金，你知道的，哟~";
			next;
			mes "[Kuka]";
			mes "完成后，请去那边让猫咪玩家总监检查，哟~";
			close;
		}
	}
	if (malang_gamer < 20) {
		if (countitem(2872)) {
			mes "[Kuka]";
		mes "你看起来是第一次来，哟~你从哪里拿到证书的，哟~最好把它还回去，哟~";
			close;
		}
		mes "[Kuka]";
		mes "猫咪玩家总监说会有练习伙伴来，哟~但那个人类没有出现，哟~我好无聊，哟~";
		close;
	}
	if (!isequipped(2872)) {
		mes "[Kuka]";
		mes "哦，尊贵的会员，^0000FF"+strcharinfo(0)+"^000000~来玩猜拳吧，哟~";
		next;
		mes "[Kuka]";
		mes "... ... ...";
		next;
		mes "[Kuka]";
		mes "但是你没有证书，哟~证书能帮助你保存游戏记录，哟~你必须拥有它！哟~";
		next;
		mes "[Kuka]";
		mes "请去拿证书，哟~";
		close;
	}
	if (checkquest(5071,PLAYTIME) == 0 || checkquest(5071,PLAYTIME) == 1) {
		mes "[Kuka]";
		mes "还没到明天吗，哟~每天只能玩一场，哟~明天再来，哟~";
		close;
	} else if (checkquest(5071,PLAYTIME) == 2)
		erasequest 5071;
	mes "[Kuka]";
	mes "哦，尊贵的会员，^0000FF"+strcharinfo(0)+"^000000~来玩猜拳吧，哟~";
	next;
	switch(select("开始游戏。:询问第一名。:询问游戏规则。")) {
	case 1:
		mes "[Kuka]";
		mes "不错的选择，哟~";
		next;
		break;
	case 2:
		// custom condition
		if (!$malangdo_gamer) {
			mes "[Kuka]";
			mes "猜拳游戏还没有人保持记录，哟~";
			mes "你可以成为第一名，哟~";
			close;
		}
		mes "[Kuka]";
		mes "目前猜拳游戏的第一名是";
		mes "^0000FF"+$malangdo_gamer$+"^000000，连续获胜 ^DE2B21"+$malangdo_gamer+"^000000 场，哟~";
		if (strcharinfo(0) == $malangdo_gamer$)
			mes "不知道什么时候会有人打破记录，哟~";
		else
			mes "我期待你，"+strcharinfo(0)+"，有一天能打败^0000FF"+$malangdo_gamer$+"^000000，哟~";
		close;
	case 3:
		mes "[Kuka]";
		mes "猜拳游戏规则很简单，哟~";
		mes "只要把手指向我脸朝的方向，哟~";
		next;
		cutin "g_cat_01",4;
		mes "[Kuka]";
		mes "像这样，哟~";
		next;
		cutin "g_cat_03",4;
		mes "[Kuka]";
		mes "或者那样，哟~";
		next;
		cutin "",255;
		mes "[Kuka]";
		mes "赢 3 场就有礼物，哟~";
		mes "如果打破之前的记录，就能得到更大的礼物，哟~";
		next;
		mes "[Kuka]";
		mes "练习时见，哟~";
		close;
	}
	while(1) {
		cutin "g_cat_00",4;
		mes "[Kuka & "+strcharinfo(0)+"]";
		mes "Cham!";
		next;
		mes "[Kuka & "+strcharinfo(0)+"]";
		mes "Cham! Cham!";
		next;
		mes "[Kuka & "+strcharinfo(0)+"]";
		mes "Cham! Cham! Cham!";
		next;
		switch(select("手指向左:手指向右")) {
		case 1:
			if (rand(1000) < 500) {
				cutin "g_cat_01",4;
				set .@win, .@win+1;
			} else {
				cutin "g_cat_02",4;
				set .@loss,1;
			}
			break;
		case 2:
			if (rand(1000) < 500) {
				cutin "g_cat_03",4;
				set .@win, .@win+1;
			} else {
				cutin "g_cat_04",4;
				set .@loss,1;
			}
			break;
		}
		if (.@loss) {
			mes "[Kuka]";
			mes "嘿嘿~我赢了，哟~感觉真好，哟~";
			next;
			cutin "",255;
			break;
		}
		mes "[Kuka]";
		mes "好吧~我输了，哟~再多练习吧，哟~";
		next;
		cutin "",255;
		mes "[Kuka]";
		mes strcharinfo(0)+"赢了 "+.@win+" 场，哟~下一场游戏开始，哟~";
		next;
	}
	if (.@win == 0) {
		// fall through
	} else if (.@win > 0 && .@win < 3) {
		setquest 5071;
		mes "[Kuka]";
		mes "练习结束后，"+strcharinfo(0)+"连续赢了 "+.@win+" 场，哟~";
		mes "赢 3 场或以上才有礼物，哟~今天没有礼物，哟~不过明天再来，哟~";
		close;
	} else {
		set .@name_record$, $malangdo_gamer$;
		set .@win_record, $malangdo_gamer;
		set .@win_cnt, .@win-.@win_record;
		set .@cans, .@win-2;
		if (.@win > .@win_record) {
			set $malangdo_gamer$, strcharinfo(0);
			set $malangdo_gamer, .@win;
			mes "[Kuka]";
			mes "恭喜，哟~你连续赢了 ^DE2B21"+.@win+"^000000 场，哟~";
			if (strcharinfo(0) == .@name_record$)
				mes "你多赢了 ^DE2B21"+.@win_cnt+"^000000 场，超过最近的 ^DE2B21"+.@win_record+"^000000 场记录，哟~恭喜，哟~";
			// custom conditions
			//else
			else if (.@win_record)
				mes "你多赢了 ^DE2B21"+.@win_cnt+"^000000 场，超过^0000FF"+.@name_record$+"^000000的 ^DE2B21"+.@win_record+"^000000 连胜记录，哟~新记录，哟~恭喜，哟~";
			else
				mes "新记录，哟~恭喜，哟~";
			next;
			mes "[Kuka]";
			mes "我会给你 1 个随机硬币袋作为特别礼物，哟~做得好，哟~明天再来，哟~";
			setquest 5071;
			getitem 12636, .@cans; //Malang_Sp_Can
			getitem 12621,1; //Egrade_Pocket
			close;
		} else {
			mes "[Kuka]";
			mes "恭喜，哟~你赢了 "+.@win+" 场，我会给你 "+.@cans+" 个罐头，哟~做得好，哟~明天再来，哟~";
			setquest 5071;
			getitem 12636, .@cans; //Malang_Sp_Can
			close;
		}
	}
	mes "[Kuka]";
	mes strcharinfo(0)+" 一场都没赢，哟~你必须找出原因，哟~";
	next;
	setquest 5071;
	switch(rand(1,13)) {
	case 1:
		setquest 5074;
		mes "[Kuka]";
		mes "库卡想让你捕捉美味的菲恩，哟~";
		next;
		mes "- 咕噜 -";
		mes "库卡擦了擦嘴边的口水。";
		next;
		mes "[Kuka]";
		mes "捕捉 30 只菲恩，哟~再给我拿 10 个鱼尾，哟~把它们交给猫咪总监，他会用它们做出美味料理，哟~";
		close;
	case 2:
		setquest 5075;
		mes "[Kuka]";
		mes "最近我感到无力，身上的负担也太重了，哟~我应该照顾好健康，哟~";
		next;
		mes "[Kuka]";
		mes "现在是吃健康食物的时间，哟~";
		next;
		mes "[Kuka]";
		mes "给我们的猫咪玩家总监带 50 只马尔斯和 25 瓶牛奶，哟~他非常了解健康食物，哟~";
		close;
	case 3:
		setquest 5076;
		mes "[Kuka]";
		mes "我们有竞争对手，哟~‘狗狗华尔兹’，哟~";
		next;
		mes "[Kuka]";
		mes "我想骚扰长得相似的家伙，哟~";
		next;
		mes "[Kuka]";
		mes "狗头人中有弓箭手，哟~骚扰 30 只狗头人弓箭手，然后向猫咪玩家总监报告，哟~";
		close;
	case 4:
		setquest 5077;
		mes "[Kuka]";
		mes "敏捷对赢得比赛非常重要，哟~训练敏捷吧，哟~";
		next;
		mes "[Kuka]";
		mes "捉老鼠是训练敏捷最好的运动，哟~";
		next;
		mes "[Kuka]";
		mes "捕捉 10 只蓝色胖乎乎的痉挛鱼，然后向猫咪玩家总监报告，哟~";
		close;
	case 5:
		setquest 5078;
		mes "[Kuka]";
		mes "我想吃鸟肉料理，哟~鸟肉料理真美味，哟~";
		next;
		mes "[Kuka]";
		mes "啄木鸟太小，秃鹰又不好吃，哟~波波利怎么样，哟~？";
		next;
		mes "[Kuka]";
		mes "好，哟~捕捉 50 只波波利，向猫咪玩家总监报告，哟~今晚我们要举办鸟肉料理派对，哟~";
		close;
	case 6:
		setquest 5079;
		mes "[Kuka]";
		mes "我在比赛前太紧张了，哟~紧张时发挥不好，哟~比赛开始前需要一些东西让我冷静，哟~";
		next;
		mes "[Kuka]";
		mes "毛线非常适合放松，哟~";
		next;
		mes "[Kuka]";
		mes "拿 20 个毛线，哟~还有很多猫有同样的问题，哟~猫咪玩家总监会处理，哟~";
		close;
	case 7:
		setquest 5080;
		mes "[Kuka]";
		mes "最近我们的总监似乎一直在削减开支，哟~也许是管理猫在占便宜，哟~";
		next;
		mes "[Kuka]";
		mes "玩家们的日常零食减少了，哟~"+strcharinfo(0)+"应该去拿 30 个鼠尾，向猫咪玩家总监报告，哟~";
		next;
		mes "[Kuka]";
		mes "这样我们就能知道管理者是不是贪心了，哟~";
		close;
	case 8:
		setquest 5081;
		mes "[Kuka]";
		mes "我最近状态低迷，哟~没法把 100% 的精力投入比赛。";
		next;
		mes "[Kuka]";
		mes "这种时候我们需要柠檬，哟~";
		next;
		mes "[Kuka]";
		mes "给我拿 5 个柠檬，哟~别忘了，我需要 5 个柠檬，哟~猫咪玩家总监应该知道怎么用它们，哟~";
		close;
	case 9:
		setquest 5082;
		mes "[Kuka]";
		mes "马兰多是适合猫生活的地方，哟~但我们比赛时会变得很热，哟~";

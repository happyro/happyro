			}
			else if (.@input > 20) {
				mes "[加速赛道点数管理员]";
				mes "你的请求超过";
				mes "最大限制。请输入";
				mes "不超过 20 的数值。";
				close;
			}
			else {
				set .@want_point1,10 * .@input;
				set .@want_point,5 * .@input;
				set .@my_turbo_all,tt_point+.@want_point;
				set .@my_arena_all,arena_point-.@want_point1;
				if (.@my_turbo_all > 28999) {
					mes "[加速赛道点数管理员]";
					mes "继续兑换会超过加速赛道点数上限。请先消费更多";
					mes "加速赛道点数后再使用服务。谢谢。";
					close;
				}
				if (.@my_arena_all < 0) {
					mes "[加速赛道点数管理员]";
					mes "抱歉，你没有";
					mes "足够的竞技场点数";
					mes "进行此次加速赛道点数";
					mes "兑换。";
					close;
				}
				else {
					mes "[加速赛道点数管理员]";
					mes "你已兑换";
					mes "10 点竞技场点数为";
					mes "加速赛道点数，次数：" + .@input + " 次。";
					mes "总计 " + .@want_point1 + " 竞技场点数";
					mes "已兑换为";
					mes "" + .@want_point +" 加速赛道点数。";
					set arena_point,.@my_arena_all; //arena_point
					set tt_point,.@my_turbo_all;
					next;
					mes "[加速赛道点数管理员]";
					mes "" + strcharinfo(0) + ",";
					mes "你现在拥有";
					mes "^00688B" + tt_point + "^000000 加速赛道点数";
					mes "以及 ^4682B4" + arena_point + "^000000 竞技场点数。";
					mes "感谢惠顾。";
					close;
				}
			}
		case 6:
			mes "[加速赛道点数管理员]";
			mes "你已";
			mes "取消";
			mes "请求。";
			close;
		}
	case 3:
		// There is no dialog for this option.
		// It's possible it's missing, or maybe
		// the dialog was never translated. XD
		//??
		close;
	}

S_ExchangePoints:
	if (tt_point > getarg(0)) {
		mes "[加速赛道点数管理员]";
		mes "继续兑换会超过加速赛道点数上限。请先消费更多";
		mes "加速赛道点数后再使用服务。谢谢。";
		close;
	}
	if (arena_point >= getarg(1)) {
		mes "[加速赛道点数管理员]";
		mes "按要求，";
		mes "2 竞技场点数";
		mes "已兑换";
		mes "为 1 点加速赛道点数。";
		set arena_point,arena_point-getarg(1);
		set tt_point,tt_point+getarg(2);
		next;
		mes "[加速赛道点数管理员]";
		mes "" + strcharinfo(0) + ",";
		mes "你现在拥有";
		mes "^00688B" + tt_point + "^000000 加速赛道点数";
		mes "以及 ^4682B4" + arena_point + "^000000 竞技场点数。";
		mes "感谢惠顾。";
		close;
	}
	else {
		mes "[加速赛道点数管理员]";
		mes "抱歉，你没有足够的竞技场点数。使用此服务";
		mes "至少需要 2 点竞技场点数。";
		mes "";
		close;
	}
}

alde_gld,183,204,0	script	en_turbo	45,1,1,{
OnTouch_:
	if (checkweight(1201,1) == 0) {
		mes "^3355FF等一下！";
		mes "请稍候。";
		mes "你现在携带的物品";
		mes "太多了。";
		mes "请使用卡普拉服务";
		mes "存放一些物品后再回来。^000000";
		close;
	}
	if ((BaseJob == Job_Knight || BaseJob == Job_Crusader) && (checkriding() || checkdragon())) {
		if (MaxWeight-Weight < 20000) {
			if (!(eaclass()&EAJL_THIRD)) {
				set .@mount$,(BaseJob == Job_Knight)?"Peco Peco":"Grand Peco";
				mes "[助手]";
				mes .@mount$+"禁止进入";
				mes "加速赛道竞技场。";
				mes "请从你的";
				mes .@mount$+"上下来，";
				mes "你会获得免费大嘴鸟骑乘券";
				mes "用于取回你的"+.@mount$+"。";
			} else {
				set .@mount$,(BaseJob == Job_Knight)?"Dragon":"Gryphon";
				mes "[助手]";
				mes .@mount$+"禁止进入";
				mes "加速赛道竞技场。";
				mes "请从你的";
				mes .@mount$+"上下来。你可以在外面";
				mes "免费取回它。";
			}
			close2;
			warp "alde_gld",183,199;
			end;
		} else {
			if (!(eaclass()&EAJL_THIRD)) {
				setriding 0;
				getitem 7310,1; //Free_Peco_Ticket
			} else {
				if (BaseJob == Job_Knight)
					setdragon 0;
				else
					setriding 0;
			}
			warp "turbo_room",100,65;
		}
	} else if ((Class == Job_Ranger || Class == Job_Ranger_T || Class == Job_Baby_Ranger) && checkoption(Option_Wugrider)) {
		if (MaxWeight-Weight < 20000) {
			mes "[助手]";
			mes "狼骑兵禁止进入";
			mes "加速赛道竞技场。";
			mes "请从狼身上下来。";
			close2;
			warp "alde_gld",183,199;
			end;
		} else {
			setoption Option_Wugrider,0;
			warp "turbo_room",100,65;
		}
	} else if ((Class == Job_Mechanic || Class == Job_Mechanic_T || Class == Job_Baby_Mechanic) && checkmadogear()) {
		if (MaxWeight-Weight < 20000) {
			mes "[助手]";
			mes "魔导机甲禁止进入";
			mes "加速赛道竞技场。";
			mes "请从你的";
			mes "魔导机甲上下来。你可以在外面";
			mes "免费取回它。";
			close2;
			warp "alde_gld",183,199;
			end;
		} else {
			setmadogear 0;
			warp "turbo_room",100,65;
		}
	} else
		warp "turbo_room",100,65;
	end;
}

alde_gld,186,199,3	script	Turbo Track Guide#Entran	845,{
	mes "[向导]";
	mes "欢迎来到";
	mes "艾尔帕兰";
	mes "加速赛道~";
	next;
	mes "[向导]";
	if (checkre(0))
		mes "大嘴鸟、巨型大嘴鸟、龙、狮鹫、狼和魔导机甲禁止进入加速赛道竞技场。";
	else
		mes "大嘴鸟禁止进入加速赛道竞技场。";
	mes "骑乘大嘴鸟的玩家将在加速赛道入口获得免费大嘴鸟骑乘券，并自动下坐骑。";
	next;
	mes "[向导]";
	mes "那么，";
	mes "祝你在";
	mes "加速赛道玩得开心~！";
	close;
}

-	script	::MountManager_turbo	-1,{
	set .@n$, "["+strnpcinfo(1)+"]";
	mes .@n$;
	if (ismounting()) {
		mes "请先从当前骑乘的坐骑上下来。";
		mes "然后再与我交谈。";
		close;
	}
	if (BaseJob == Job_Knight || BaseJob == Job_Crusader) {
		if (!(eaclass()&EAJL_THIRD)) {
			if (BaseJob == Job_Knight) {
				set .@zeny,2500;
				set .@zeny$,"2,500";
				set .@mount$,"大嘴鸟";
			} else {
				set .@zeny,3500;
				set .@zeny$,"3,500";
				set .@mount$,"巨型大嘴鸟";
			}
			set .@skill,63;
			set .@skill$,"大嘴鸟骑乘";
			set .@riding, checkriding();
			set .@i,1;
		} else {
			if (BaseJob == Job_Knight) {
				set .@mount$,"龙";
				set .@skill,63;
				set .@skill$,"龙驯养术";
				set .@riding, checkdragon();
				set .@i,2;
			} else {
				set .@mount$,"狮鹫";
				set .@skill,63;
				set .@skill$,"大嘴鸟骑乘";
				set .@riding, checkriding();
				set .@i,1;
			}
		}
	} else if (Class == Job_Mechanic || Class == Job_Mechanic_T || Class == Job_Baby_Mechanic) {
		set .@mount$,"魔导机甲";
		set .@skill,2255;
		set .@skill$,"魔导机甲执照";
		set .@riding, checkmadogear();
		set .@i,3;
	} else {
		mes "感谢你";
		mes "光临艾尔帕兰的";
		mes "加速赛道~";
		close;
	}
	mes "欢迎，";
	mes "你想取回你的"+.@mount$+"吗？";
	if (.@zeny) {
		mes "请出示大嘴鸟骑乘";
		mes "免费券。你也可以";
		mes "支付租赁费"+.@zeny$+" Zeny。";
		mes "即可。";
	}
	next;
	switch(select("是：取消")) {
	case 1:
		if (getskilllv(.@skill) == 0) {
			mes .@n$;
			mes "抱歉，";
			mes "你没有资格使用此服务。";
			mes "请先学习";
			mes .@skill$+"技能。";
			close;
		} else {
			if (.@riding) {
				mes .@n$;
				mes "你已经";
				mes "骑乘着";
				mes .@mount$+"。";
				mes "谢谢~";
				close;
			} else {
				if (.@zeny) {
					if (countitem(7310) < 1 && Zeny < .@zeny) {
						mes .@n$;
						mes "抱歉，你没有大嘴鸟骑乘免费券";
						mes "或足够的"+.@zeny$+" Zeny。";
						mes "无法使用大嘴鸟租赁服务。";
						mes "请准备好所需物品。";
						close;
					} else {
						if (countitem(7310) > 0)
							delitem 7310,1; //Free_Peco_Ticket
						else
							set Zeny, Zeny-.@zeny;
					}
				}
				switch(.@i) {
					case 1: setriding; break;
					case 2: setdragon; break;
					case 3: setmadogear; break;
				}
				mes .@n$;
				mes "感谢";
				mes "惠顾~";
				close;
			}
		}
	case 2:
		mes .@n$;
		mes "你要回去参加";
		mes "比赛";
		mes "加速赛道比赛吗？";
		mes "祝你好运！";
		close;
	}
}


//-------------------------------------------------------------------
// Quest: Gather Opinions in Rachel. Step 1 + 2 (final).
rachel,155,236,3	script	Junok#atm	4_M_TRAINEE,{
	if (checkweight(1000405,10) == 0) {
		mes "[Junok]";
	mes "希望情况能尽快平息。整理好随身物品后再来和我谈谈吧。";
		close;
	}
	if (BaseLevel < 170) {
		mes "[Junok]";
	mes "你好。看来你目前还缺乏完成我这个请求所需的经验。";
		next;
		mes "[Junok]";
	mes "再接受一些训练后回来找我吧。";
		next;
	mes "- 此任务仅限 170 级及以上角色接取。-";
		close;
	}
	if (ep18_main < 12)
		end;	// unknown text
	switch( checkquest(3504,PLAYTIME) ) {
	case -1:	// first time
		if (isbegin_quest(3503) == 0) {
			mes "[Junok]";
		mes "你好，我是朱诺克牧师。";
			next;
			mes "[Junok]";
		mes "这个村庄长期以来分成原住民和移民两派，双方一直处于对立状态。";
			next;
			mes "[Junok]";
		mes "虽然一直有人努力解决两派之间的冲突，但目前还没有取得明显成果。";
			next;
			mes "[Junok]";
		mes "因此，我想请你分别直接接触他们，了解问题究竟出在哪里。";
			next;
			mes "[Junok]";
		mes "你能代替我和他们谈谈吗？我不方便离开自己的岗位。";
			next;
			if (select( "好的。", "下次吧。" ) == 2) {
				mes "[Junok]";
				mes "你拒绝了我，真让我失望。我的心好痛。";
				close;
			}
			setquest 3503;

			setarray .@quest_id[0],3493,3494,3495,3496,3497,3498,3499,3500,3501,3502;
			.@size = getarraysize(.@quest_id);

			for ( .@i = 0; .@i < 6; ++.@i ) {
				.@r = rand(.@size);
				setquest .@quest_id[.@r];
				deletearray .@quest_id[.@r],1;
				.@size--;
			}
			mes "[Junok]";
		mes "请和指定的 3 名原住民及 3 名移民交谈，之后把结果告诉我。";
			next;
			mes "[Junok]";
		mes "需要交谈的人员名单可以在任务窗口或小地图上查看。";
			close;
		}
		break;
	case 0:
	case 1:
		mes "[Junok]";
	mes "今天我已经收集到足够的信息了。如果还需要帮助，请明天再来。";
		close;
	case 2:	// daily
		if (isbegin_quest(3503) == 0) {
			mes "[Junok]";
		mes "好的，我今天会了解原住民和移民之间的情况。如果有具体需要我帮忙的地方，尽管告诉我。";
			next;
			if (select( "好的", "不用。" ) == 2)
				end;
			erasequest 3504;
			setquest 3503;

			setarray .@quest_id[0],3493,3494,3495,3496,3497,3498,3499,3500,3501,3502;
			.@size = getarraysize(.@quest_id);

			for ( .@i = 0; .@i < 6; ++.@i ) {
				.@r = rand(.@size);
				setquest .@quest_id[.@r];
				deletearray .@quest_id[.@r],1;
				.@size--;
			}
			mes "[Junok]";
			mes "那就拜托你了。如果需要帮助，尽管来问我。祝你今天愉快！";
			next;
			mes "[Junok]";
			mes "和 3 名原住民及 3 名移民谈过后再回来吧。";
			next;
			mes "[Junok]";
			mes "需要交谈的人员名单可以在任务窗口或小地图上查看。";
			close;
		}
		break;
	}
	switch( isbegin_quest(3505) ) {
	case 0:
		mes "[Junok]";
		mes "请和全部 6 名居民交谈后再回来。";
		close;
	case 1:	// task completed
		switch( checkquest(3504,PLAYTIME) ) {
		case -1:	// first completion
			mes "[Junok]";
			mes "是这样啊……";
			next;
			mes "[Junok]";
			mes "看来他们之间仍然积怨很深。";
			next;
			mes "[Junok]";
			mes "比我预想的还要严重。嗯……不知道该怎么解决才好。";
			next;
			getitem 1000405,10;	// Ep18_Amethyst_Fragment
			getexp 7769124,3000000;	// dummy value
			break;
		case 0:
		case 1:	// (shouldn't happen)
			mes "[Junok]";
			mes "今天我已经收集到足够的信息了。如果还需要帮助，请明天再来。";
			close;
		case 2:	// daily quest
			mes "[Junok]";
			mes "是这样啊……";
			next;
			mes "[Junok]";
			mes "看来他们之间仍然积怨很深。";
			next;
			mes "[Junok]";
			mes "比我预想的还要严重。嗯……不知道该怎么解决才好。";
			next;
			getitem 1000405,3;	// Ep18_Amethyst_Fragment
			getexp 18252408,2000000;
			break;
		}
		for ( .@i = 3493; .@i < 3506; ++.@i ) {
			if (isbegin_quest(.@i) > 0)
				erasequest .@i;
		}
		setquest 3504;
		mes "[Junok]";
		mes "这些指导很有帮助……";
		next;
		mes "[Junok]";
		mes "谢谢你的帮助。如果明天还能帮忙，请再来一趟。";
		close;
	case 2:
		end;
	}
	end;

OnInit:
	questinfo( QTYPE_DAILYQUEST, QMARK_YELLOW, "ep18_main >= 12 && isbegin_quest(3503) == 0 && (checkquest(3504,PLAYTIME) == -1 || checkquest(3504,PLAYTIME) == 2)" );
	questinfo( QTYPE_QUEST, QMARK_YELLOW, "isbegin_quest(3505) == 1" );
	end;
}

rachel,69,234,3	script	Jarad#atm1	4_M_CHILD1,2,2,{
	if (isbegin_quest(3493) == 1) {
		mes "[Jarad]";
		mes "你好。";
		next;
		mes "[Jarad]";
		mes "不久前，村里发生了一场骚动。";
		next;
		mes "[Jarad]";
		mes "一位演讲者以尊重理想人类的尊严为主题发表演讲，但似乎反而激怒了部分听众。";
		next;
		mes "[Jarad]";
		mes "我也觉得那场演讲并没有得到预期的积极反响。";
		next;
		mes "[Jarad]";
		mes "那只是一套脱离现实的理想主义说辞。";
		next;
		mes "[Jarad]";
		mes "双方发生了激烈的争吵，眼看就要动手，但旁观者及时阻止了冲突。";
		next;
		mes "[Jarad]";
		mes "只要不影响到我个人，我倒是不太在意。";
		next;
		completequest 3493;
		for ( .@i = 3493; .@i <= 3502; ++.@i )
			.@total += isbegin_quest(.@i);
		if (.@total == 12)
			setquest 3505;	// setquest here to prevent bug
		mes "[Jarad]";
		mes "祝你今天愉快！";
		next;
		mes "- 你已经和贾拉德交谈完毕。-";
		next;
		mes "- 去找下一个人吧。-";
		if (.@total == 12) {
			next;
			// setquest 3505;
			mes "- 你已经和全部 6 个人交谈完毕。回朱诺克那里去吧。-";
		}
		close;
	}
	mes "[Jarad]";
	mes "安静地……";
	next;
	mes "[Jarad]";
	mes "我只想平静地生活……";
	close;

OnTouch_:
	end;

OnInit:
	questinfo( QTYPE_QUEST2, QMARK_YELLOW, "isbegin_quest(3493) == 1" );
	end;
}

rachel,100,72,3	script	Rohi#atm2	4_F_SHABBY,2,2,{
	if (isbegin_quest(3494) == 1) {
		mes "[Rohi]";
		mes "你好，我叫罗希。";
		next;
		mes "[Rohi]";
		mes "直到最近，我一直因为找不到合适的工作而过着贫困的生活……";
		next;
		mes "[Rohi]";
		mes "多亏了迪娜，我最近找到了建筑管理的工作，终于能养活自己了。";
		next;
		mes "[Rohi]";
		mes "可是从某个时候开始，工作时间增加了，报酬却没有相应增加。";
		next;
		mes "[Rohi]";
		mes "为什么会这样？迪娜在移民中也算富有，不像是拿不出钱来支付报酬。";
		next;
		mes "[Rohi]";
		mes "我直接向迪娜提出过这种不公平，但没有任何结果。";
		next;
		mes "[Rohi]";
		mes "即使工资很低，还是有很多人愿意接受这份工作，你知道的……";
		next;
		mes "[Rohi]";
		mes "马拉姆和其他资深成员正在讨论解决这个问题的办法，所以我决定暂时再等等。";
		next;
		completequest 3494;
		for ( .@i = 3493; .@i <= 3502; ++.@i )
			.@total += isbegin_quest(.@i);
		if (.@total == 12)
			setquest 3505;
		mes "[Rohi]";
		mes "谢谢你，也祝你度过平静的一天！";
		next;
		mes "- 你已经结束了与罗希的交谈。-";
		next;
		mes "- 去找下一个人吧。-";
		if (.@total == 12) {
			next;
			mes "- 你已经和全部 6 个人交谈完毕。回朱诺克那里去吧。-";
		}
		close;
	}
	mes "[Rohi]";
	mes "今天的工作这么多，我不知道能不能按时全部做完……";
	close;

OnTouch_:
	end;

OnInit:
	questinfo( QTYPE_QUEST2, QMARK_YELLOW, "isbegin_quest(3494) == 1" );
	end;
}

rachel,258,207,3	script	Jeojin#atm3	4_F_RACHOLD,2,2,{
	if (isbegin_quest(3495) == 1) {
		mes "[Jeojin]";
		mes "你好，我叫乔金。";
		next;
		mes "[Jeojin]";
		mes "我算是原住民，从祖先那一代起就一直生活在这里。";
		next;
		mes "[Jeojin]";
		mes "最近因为和移民之间的摩擦，出现了不少争论。";
		next;
		mes "[Jeojin]";
		mes "他们当中有些人很富有，尤其是迪娜，拥有很强的经济实力。";
		next;
		mes "[Jeojin]";
		mes "即使在原住民中，我也拥有不少财产，却仍然无法和那个人相比。";
		next;
		mes "[Jeojin]";
		mes "他们开始影响原住民的商业区，政策也在向他们倾斜，让我的生意越来越难做。";
		next;
		mes "[Jeojin]";
		mes "前些时候，迪娜提出要买下我拥有的几栋建筑。我不知道该怎么办。";
		next;
		completequest 3495;
		for ( .@i = 3493; .@i <= 3502; ++.@i )
			.@total += isbegin_quest(.@i);
		if (.@total == 12)
			setquest 3505;
		mes "[Jeojin]";
		mes "那么，祝你今天愉快。";
		next;
		mes "- 你已经结束了与乔金的交谈。-";
		next;
		if (.@total == 12) {
			next;
			mes "- 你已经和全部 6 个人交谈完毕。回朱诺克那里去吧。-";
		}
		close;
	}
	mes "[Jeojin]";
	mes "嗯……我该怎么办呢？";
	close;

OnTouch_:
	end;

OnInit:
	questinfo( QTYPE_QUEST2, QMARK_YELLOW, "isbegin_quest(3495) == 1" );
	end;
}


		mes "[Japer]";
		mes "国家的繁荣离不开像我这样尽职尽责的人，你说对吧？";
		next;
		mes "[Japer]";
		mes "而且，我建立了规模可观的商人协会，为许多居住在拉赫的原住民提供了就业机会……";
		next;
		mes "[Japer]";
		mes "我明白了，看来移民和原住民之间现在矛盾重重，尤其是对我的不满越来越强烈。";
		next;
		mes "[Japer]";
		mes "看来他们对现在的工作条件并不满意，还觉得如果没有我，他们根本不会得到那些工作机会。";
		next;
		mes "[Japer]";
		mes "那些原住民不但不知感恩，还总觉得自己受了委屈，真让我不寒而栗。";
		next;
		completequest 3498;
		for ( .@i = 3493; .@i <= 3502; ++.@i )
			.@total += isbegin_quest(.@i);
		if (.@total == 12)
			setquest 3505;
		mes "[Japer]";
		mes "那么，下次再见……";
		next;
		mes "- 你已经结束了与杰珀的交谈。-";
		next;
		mes "- 去找下一个人吧。-";
		if (.@total == 12) {
			next;
			mes "- 你已经和全部 6 个人交谈完毕。回朱诺克那里去吧。-";
		}
		close;
	}
	mes "[Japer]";
	mes "我靠自己的方法积累了财富。";
	next;
	mes "[Japer]";
	mes "他们误解我了。";
	close;

OnTouch_:
	end;

OnInit:
	questinfo( QTYPE_QUEST2, QMARK_YELLOW, "isbegin_quest(3498) == 1" );
	end;
}

rachel,40,73,7	script	Shiroan#atm7	1_F_02,2,2,{

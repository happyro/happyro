rachel,190,30,5	script	Senado#atm5	4_F_MONK,2,2,{
	if (isbegin_quest(3497) == 1) {
		mes "[Senado]";
		mes "你好。";
		next;
		mes "[Senado]";
		mes "我叫塞纳多，已经练习武术 20 多年了。";
		next;
		mes "[Senado]";
		mes "我曾游历各个村庄，检验自己积累的武术实力。打败许多道场后，我不久前在拉赫定居了下来。";
		next;
		mes "[Senado]";
		mes "不过最近，我感觉这个村子的气氛有些不对劲。";
		next;
		mes "[Senado]";
		mes "人们似乎分成了两派并彼此对立，也就是原住民和移民之间的冲突……";
		next;
		mes "[Senado]";
		mes "严格来说，我属于原住民一方。不过我不想卷入这场对立。";
		next;
		mes "[Senado]";
		mes "我对他们的权力斗争没有兴趣。";
		next;
		completequest 3497;
		for ( .@i = 3493; .@i <= 3502; ++.@i )
			.@total += isbegin_quest(.@i);
		if (.@total == 12)
			setquest 3505;
		mes "[Senado]";
		mes "那么下次再见吧。";
		next;
		mes "- 我已经结束了与塞纳多的交谈。-";
		next;
		mes "- 去找下一个人吧。-";
		if (.@total == 12) {
			next;
			mes "- 你已经和全部 6 个人交谈完毕。回朱诺克那里去吧。-";
		}
		close;
	}
	mes "[Senado]";
	mes "无论是原住民还是移民……";
	next;
	mes "[Senado]";
	mes "我不明白他们为什么会如此对立、争吵不休。";
	close;

OnTouch_:
	end;

OnInit:
	questinfo( QTYPE_QUEST2, QMARK_YELLOW, "isbegin_quest(3497) == 1" );
	end;
}

rachel,210,52,5	script	Japer#atm6	1_ETC_01,2,2,{
	if (isbegin_quest(3498) == 1) {
		mes "[Japer]";
		mes "你好，大家都叫我商人杰珀……";

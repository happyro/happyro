//= MasterOfMuppets
//===== Current Version: =====================================
//= 1.0
//===== Compatible With: =====================================
//= rAthena Project
//===== Description: =========================================
//= [Official Conversion]
//= Guides for the City of Ayothaya
//===== Additional Comments: =================================
//= 1.0 First version [L0ne_W0lf]
//============================================================

ayothaya,203,169,3	script	Noi#ayo	839,{
	mes "[诺伊]";
	mes "欢迎来到阿约他雅。";
	mes "我们美丽的村庄建在";
	mes "水面之上，周围环绕着";
	mes "茂密森林。";
	next;
	mes "[诺伊]";
	mes "村里有许多别处找不到的景点。鱼市场和独特建筑足以成为参观阿约他雅的理由。";
	next;
	mes "[诺伊]";
	mes "请随意";
	mes "四处看看。";
	next;
	switch(select("建筑位置。:移除小地图标记。:取消。")) {
	case 1:
		mes "[诺伊]";
		mes "你想去";
		mes "哪里？";
		next;
		switch(select("武器店:工具店:酒馆:神殿:钓鱼点:取消")) {
		case 1:
			mes "[诺伊]";
			mes "在武器店，你会找到";
			mes "勇敢的阿约他雅航海者喜爱的";
			mes "优质武器。";
			next;
			mes "[诺伊]";
			mes "我们的武器店";
			mes "位于 ^55FF33+^000000。";
			viewpoint 1,165,90,2,0x55FF33;
			close;
		case 2:
			mes "[诺伊]";
			mes "阿约他雅人出发旅行前总会准备齐全。做好准备总没坏处，对吧？";
			next;
			mes "[诺伊]";
			mes "我们的工具店";
			mes "位于 ^3355FF+^000000。";
			viewpoint 1,129,86,3,0x3355FF;
			close;
		case 3:
			mes "[诺伊]";
			mes "冒险的基础之一是收集信息，至少大家这么说。酒馆里能遇到各地的人，相信你能学到有用的东西。";
			next;
			mes "[诺伊]";
			mes "当然，你必须";
			mes "来酒馆看看。";
			mes "它位于 ^00FF00+^000000。";
			viewpoint 1,232,76,4,0x00FF00;
			close;
		case 4:
			mes "[诺伊]";
			mes "想向上帝祈祷或让心灵平静，就来神殿吧。即使只是观光，所有人都";
			mes "欢迎。";
			next;
			mes "[诺伊]";
			mes "我们的神殿";
			mes "位于 ^00FF00+^000000.";
			viewpoint 1,208,283,5,0x00FF00;
			close;
		case 5:
			mes "[诺伊]";
			mes "阿约他雅建在水面上且靠近海滩，一直是渔夫喜爱的地方。何不在钓鱼点抓些鱼当晚餐？";
			next;
			mes "[诺伊]";
			mes "我们著名的";
			mes "钓鱼点";
			mes "位于 ^00FF00+^000000";
			viewpoint 1,253,99,6,0x00FF00;
			close;
		case 6:
			mes "[诺伊]";
			mes "想移除小地图位置标记，请从菜单选择“移除小地图标记”。";
			close;
		}
	case 2:
		viewpoint 2,165,90,2,0x55FF33;
		viewpoint 2,129,86,3,0x3355FF;
		viewpoint 2,232,76,4,0x00FF00;
		viewpoint 2,208,283,5,0x00FF00;
		viewpoint 2,253,99,6,0x00FF00;
		mes "[诺伊]";
		mes "好……";
		mes "我已移除你小地图上的";
		mes "所有位置标记。";
		mes "谢谢。";
		mes "谢谢。";
		close;
	case 3:
		mes "[诺伊]";
		mes "祝你";
		mes "旅途愉快。";
		close;
	}
}

// Dewata Transportation :: dewata_trans
//============================================================
alberta,212,202,4	script	Dewata Sailor#alberta	536,{
	mes "[Dewata Sailor]";
	mes "要去^8B4513德瓦塔岛^000000吗？";
	mes "那里有耀眼的海浪和迷人的景色，是放松的好地方。";
	if (VIP_SCRIPT) {
		set .@cost, vip_status(VIP_STATUS_ACTIVE)?1000:10000;
		mes "交通费为 10,000 Zeny，VIP 只需 1,000 Zeny。";
	} else {
		set .@cost,10000;
	mes "交通费为 10,000 Zeny。";
	}
	next;
	switch(select("是！:不。")) {
	case 1:
		if (Zeny >= .@cost) {
			mes "[Dewata Sailor]";
			mes "^8B4513德瓦塔^000000是一个美丽而宁静的岛国。";
			mes "祝你旅途愉快~";
			close2;
			set Zeny, Zeny - .@cost;
			warp "dewata",232,53;
			end;
		} else {
			mes "[Dewata Sailor]";
		mes "你没有足够的钱，小鬼。";
		mes "钱包鼓一点再回来吧。";
			close;
		}
	case 2:
		mes "[Dewata Sailor]";
		mes "准备好旅行时";
		mes "告诉我一声~";
		close;
	}
}

dewata,229,49,6	script	Alberta Sailor#dewata	536,{
	mes "[Alberta Sailor]";
	mes "要回到艾尔贝塔吗？";
	next;
	switch(select("是。:不。")) {
	case 1:
		mes "[Alberta Sailor]";
		mes "希望你在^8B4513德瓦塔^000000岛";
		mes "玩得很开心。";
		mes "欢迎下次再来！";
		close2;
		warp "alberta",192,215;
		end;
	case 2:
		mes "[Alberta Sailor]";
		mes "离开前再多玩一会儿吧。";
		mes "^8B4513德瓦塔^000000岛还有很多精彩之处。";
		close;
	}
}

// Generic Dewata NPCs :: dewata_npc
//============================================================ 
dewata,221,237,5	script	Young Man#dew-1	536,{
	mes "[Fruit Fancier]";
	mes "你的脸怎么了？你真是毫无头绪啊！";
	next;
	mes "[Fruit Fancier]";
	mes "让我给你讲点知识。";
	next;
	mes "[Fruit Fancier]";
	mes "我虽然年轻，但没人比我更了解^777700棕榈果^000000。好了！你想知道什么？";
	next;
	switch(select("关于果壳……:关于果肉……:关于棕榈果仁……:不用了。")) {
	case 1:
		mes "[Fruit Fancier]";
		mes "你想了解棕榈果的果肉？让我解释一下。";
		next;
		mes "[Fruit Fancier]";
		mes "通常棕榈果壳用于制油。棕榈油是许多料理的实用材料。";
		next;
		mes "[Fruit Fancier]";
		if (dew_drink > 0)
			mes "嗯……你已经见过梅莫了吗？那应该很容易理解。";
		else
		mes "如果想知道如何使用棕榈油，就去德瓦塔岛北边找梅莫。他每天都用棕榈油制作传统饮料。";
		next;
		mes "[Fruit Fancier]";
		mes "总之，我们把棕榈果制成的油称为棕榈油或椰子油，以品质优良闻名。";
		next;
		mes "[Fruit Fancier]";
		mes "制油后的残渣会被晒干，用作烹饪或取暖的燃料。";
		next;
		mes "[Fruit Fancier]";
		mes "它燃烧充分且气味好，没什么比这更棒了。";
		next;
		mes "[Fruit Fancier]";
		mes "好了！！果肉就讲到这里，再解释棕榈果壳的所有用途就太久了。";
		next;
		mes "[Fruit Fancier]";
		mes "别以为这就是我全部的知识。别误会！";
		close;
	case 2:
		mes "[Fruit Fancier]";
		mes "你想了解棕榈果内部？让我解释一下。";
		next;
		mes "[Fruit Fancier]";
		mes "棕榈果肉有两层。外层很粗糙，内层很光滑……";
		next;
		mes "[Fruit Fancier]";
		mes "嗯……没错！棕榈果肉比核桃壳稍硬，一定是因为里面含有水分。";
		next;
		mes "[Fruit Fancier]";
		mes "果壳里大约有 300cc 水。德瓦塔岛天气炎热，这些水很适合解渴。";
		next;
		mes "[Fruit Fancier]";
		mes "而且喝完里面的水后，我们不会直接把它扔掉！！";
		next;
		mes "[Fruit Fancier]";
		mes "我们还可以用它制作优质水壶！正如我所说，它的外壳足够厚，可以当作水瓶。";
		next;
		mes "[Fruit Fancier]";
		mes "它也很适合制作木炭。棕榈果制成的木炭以持久、火力优良而闻名，";
		next;
		mes "[Fruit Fancier]";
		mes "人们喜欢用棕榈果木炭烹饪海鲜和鸡肉……";
		next;
		mes "[Fruit Fancier]";
		mes "燃烧时还会散发怡人的棕榈香气。";
		next;
		mes "[Fruit Fancier]";
		mes "好了！！果肉信息就讲到这里，解释所有用途要花太久。";
		next;
		mes "[Fruit Fancier]";
		mes "别以为这就是我全部的知识。别误会！";
		close;
	case 3:
		mes "[Fruit Fancier]";
		mes "所以，你想了解里面柔嫩的果仁？让我解释一下。";
		next;
		mes "[Fruit Fancier]";
		mes "坚硬果肉里的果仁可以作为天然助消化剂。";
		next;
		mes "[Fruit Fancier]";
		mes "关于里面的果仁没什么好说的……";
		next;
		mes "[Fruit Fancier]";
		mes "但我们会确保利用棕榈果的每个部分。";
		next;
		mes "[Fruit Fancier]";
		mes "你同意吗？";
		close;
	case 4:
		mes "[Fruit Fancier]";
		mes "啊！你对这个世界毫无兴趣！";
		close;
	}
}

dewata,114,243,6	script	Lazy Young Man#dew	536,1,1,{
	if (checkweight(1201,1) == 0 || MaxWeight - Weight < 500) {
		mes "[Lazy Young Man]";
		mes "你为什么带这么多东西？不觉得重吗？";
		close;
	}
	if (countitem(11534)) {
		mes "[Lazy Young Man]";
		mes "哇~！！那是棕榈汁吗？";
		mes "可以给我吗？我刚睡醒，";
		mes "嗓子都渴干了！";
		next;
		switch(select("给你:不给")) {
		case 1:
			mes "[Lazy Young Man]";
			mes "真的吗？给我的？？我用这个回报你……谢谢……嘿嘿~";
			delitem 11534,1; //Coco_Juice
			getgroupitem(IG_GiftBox);
			close;
		case 2:
			mes "[Lazy Young Man]";
			mes "那就算了~好吧……";
			close;
		}
	}
	mes "[Lazy Young Man]";
	mes "啊~好渴~有没有人给我一些棕榈";
	mes "汁啊~";
	close;
OnTouch:
	if (countitem(11534) == 0) {
		mes "[Lazy Young Man]";
		mes "啊~我好渴~~太渴了~~";
		mes "给我棕榈汁……棕榈汁~~";
		emotion ET_FRET;
		next;
		emotion ET_FRET;
		next;
		emotion ET_FRET;
		next;
		emotion ET_FRET;
		close;
	}
	end;
}


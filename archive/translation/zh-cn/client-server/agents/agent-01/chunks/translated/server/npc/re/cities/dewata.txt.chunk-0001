dewata,146,109,5	script	Restauranteur#dew	886,{
	if (checkweight(11532,1) == 0 || checkweight(11533,1) == 0 || MaxWeight - Weight < 500) {
		mes "[Restauranteur]";
	mes "你来品尝我的料理吗？空腹吃饭总是很舒服。";
		close;
	}
	mes "[Restauranteur]";
	mes "欢迎来到德瓦塔岛。";
	mes "希望你能像高贵的";
	mes "旅行者一样举止得体，别像这些";
	mes "小屁孩一样……";
	next;
	switch(select("关于德瓦塔料理:今天的菜单？:我没事。")) {
	case 1:
		mes "[Restauranteur]";
		mes "想了解我们的食物？嗯……我没什么好说的，不过你想听就听吧。";
		next;
		mes "[Restauranteur]";
		mes "要讲的内容很多，我开始吧。";
		next;
		mes "[Restauranteur]";
		mes "首先，德瓦塔料理会根据烹饪方式拥有特殊名称，";
		next;
		mes "[Restauranteur]";
		mes "料理名称中有‘Goreng’，就表示是炒制或油炸食品。";
		next;
		mes "[Restauranteur]";
		mes "如果是‘Bakar’，就是烧烤食品。";
		next;
		mes "[Restauranteur]";
		mes "如果是‘Satay’，就是串烧料理。";
		next;
		mes "[Restauranteur]";
		mes "其次，有些料理以基本食材命名，";
		next;
		mes "[Restauranteur]";
		mes "在德瓦塔岛，米饭叫 Nasi，面条叫 Mie，面包叫 Roti，鸡肉叫 Ayam，鱼叫 Ikan，玉米叫 Jagung。";
		next;
		mes "[Restauranteur]";
		mes "所以炒饭叫‘Nasi Goreng’，炒面叫‘Mie Goreng’。";
		next;
		mes "[Restauranteur]";
		mes "好了……这些足够让你享受德瓦塔料理了！！如果你饿了，我们有只需^0000FF5000^000000 Zeny 的特别套餐。";
		close;
	case 2:
		mes "[Restauranteur]";
		mes "我们有两种料理：‘Nasi Goreng’和‘Satay’。你想要哪一种？";
		next;
		switch(select("Nasi Goreng:Satay")) {
		case 1:
			mes "[Restauranteur]";
			mes "这是用我的特制酱汁炒制、上面加了煎蛋的 Nasi Goreng。只需^0000FF5000^000000 Zeny。";
			set .@food,11532;
			break;
		case 2:
			mes "[Restauranteur]";
			mes "这是 Satay，将肉片串起来用棕榈果木炭烤制。只需^0000FF5000^000000 Zeny。";
			set .@food,11533;
			break;
		}
		next;
		switch(select("品尝:离开")) {
		case 1:
			if (Zeny < 5000) {
				mes "[Restauranteur]";
				mes "钱呢，小鬼？啧！这里没有免费食物！明白吗？";
				close;
			}
			mes "[Restauranteur]";
			mes "这是你的"+getitemname(.@food)+"，你不会后悔的！";
			set Zeny, Zeny - 5000;
			getitem .@food,1;
			close;
		case 2:
			mes "[Restauranteur]";
			mes "真遗憾你不品尝这道美味料理……";
			close;
		}
	case 3:
		mes "[Restauranteur]";
		mes "你是认真的吗？这可一点也不好笑。";
		close;
	}
}


dewata,89,191,6	script	Small Shrine#dew1	844,{
	mes "这里有一座小神龛。许多人正在许愿。";
	next;
	switch(select("捐献。:许愿。:离开。")) {
	case 1:
		mes "捐献箱上写着：";
		mes "^FF00001,000 ~ 100,000 Zeny^000000";
		mes "你想捐献多少？";
		next;
		input .@input,0,100000;
		if (.@input < 1000) {
			mes "- 已取消。-";
			close;
		} else if (.@input <= 50000)
			set .@good_luck, rand(1,10000);
		else
			set .@good_luck, rand(1,5000);
		if (.@input > Zeny) {
			mes "- Zeny 不足。-";
			close;
		}
		mes "你的愿望是什么？";
		next;
		input(.@wish$);

		setarray .@wishes$[0],
			"Power","Strength", //1
			"Faster","Speed","Quickness","Agility", //2
			"Skillful Hands","Dex", //4

//===== rAthena Script =======================================
//= BattleGround System - KvM Entrance NPCs
//===== Description: =========================================
//= [Official Conversion]
//= Kreiger Von Midgard Battleground Entrance NPCs
//= Original NPCs scrapped from bg_common.
//===== Changelogs: ==========================================
//= 1.0 First Version. [L0ne_W0lf]
//= 1.1 Corrected some typos, and shifted messages around.
//=     Corrected iRO style quest log entries, however it's
//=     advisable that you not use them, as they conflict.
//= 1.2 Added battle_config checks to allow this script to use the new queue interface or the previous method. [Aleos]
//============================================================

// KvM Officer - Guillaume
//============================================================
bat_room,164,178,5	script	KVM Mercenary Officer#1	418,{
	if (getbattleflag("feature.bgqueue"))
		end;
	/*
	set .@kvm,checkquest(6026,PLAYTIME);
	if ((.@kvm == 0) || (.@kvm == 1)) {
		mes "[Croix Mercenary Officer]";
		mes "我知道你已经与克鲁瓦签约。回去加入他们吧。我们不会接受叛徒为我们而战。";
		close;
	}
	else if (.@kvm == 2) erasequest 6026;
	*/
	set .@permit,checkquest(6025,PLAYTIME);
	if ((.@permit == 0) || (.@permit == 1)) {
		mes "[Guillaume Mercenary Officer]";
		mes "你最近参加过 KVM 战斗，必须等待 5 分钟才能再次报名。";
		close;
	}
	else if (.@permit == 2) erasequest 6025;
	mes "[Guillaume Mercenary Officer]";
	mes "让他们知道纪尧姆的真正实力！";
	next;
	switch(select("我将与你并肩战斗。：结束对话。")) {
	case 1:
		mes "[Guillaume Mercenary Officer]";
		mes "让他们看看我们的实力。";
		mes "今天所有人都会听到纪尧姆的胜利呐喊！";
		close2;
		//setquest 6025;
		if (BaseLevel > 79)  warp "bat_room",169,223;
		else if (BaseLevel < 60) warp "bat_room",197,223;
		else warp "bat_room",225,223;
		end;
	case 2:
		mes "[Guillaume Mercenary Officer]";
		mes "我们会赢！";
		close;
	}
}

// Guillaume Knight - KvM
//============================================================
bat_room,167,178,5	script	Guillaume Knight#kvm	417,{
	mes "[纪尧姆骑士]";
	mes "你好。";
	mes "你想了解什么？";
	next;
	switch(select("申请 KVM。：什么是 KVM？：如何参加 KVM？：我想知道我的克里格点数。")) {
	case 1:
	mes "[纪尧姆骑士]";
		if (getbattleflag("feature.bgqueue"))
			mes "准备好战斗后，点击界面中的 ^0000FF战斗按钮^000000 申请 KVM 战斗！";
		else {
			mes "目前还不能报名。";
			mes "要报名，请前往 KVM 雇佣兵军官。";
		}
		close;
	case 2:
		mes "[纪尧姆骑士]";
		mes "KVM 是“米德加兹战士”（Kreiger Von Midgard）的缩写。";
		mes "冒险者，你知道通往新世界的道路已经开放了吗？";
		next;
		mes "[纪尧姆骑士]";
		mes "我们纪尧姆行政区有多个推进新世界的计划。";
		mes "KVM 就是其中之一。";
		next;
	mes "[纪尧姆骑士]";
		mes "这意味着我们这个米德加尔特大陆的国家之一，";
		mes "决定雇佣许多冒险者，立即向新世界推进。";
		next;
	mes "[纪尧姆骑士]";
		mes "因此，为了选出最优秀的冒险者，我们举办了 KVM。";
		mes "我们期待许多冒险者的响应。";
		next;
	mes "[纪尧姆骑士]";
		mes "我们会为参与者提供奖励！";
		mes "关于奖励，请联系 KVM 后勤军官。";
		close;
	case 3:
	mes "[纪尧姆骑士]";
		if (getbattleflag("feature.bgqueue")) {
			mes "KVM 基本上是 3 对 3 的战斗。";
			mes "组队或单独点击界面中的 ^0000FF战斗按钮^000000 报名。";
		} else {
			mes "KVM 基本上是 5 对 5 的战斗。";
			mes "首先，组队或单独向 KVM 接待员报名。";
		}
		next;
	mes "[纪尧姆骑士]";
		if (getbattleflag("feature.bgqueue"))
			mes "组队报名适用于你打算与队伍或公会成员参加 KVM 的情况，";
		else
			mes "组队报名适用于你打算与队伍成员参加 KVM 的情况，";
		mes "个人报名适用于你打算单独参加 KVM 的情况。";
		next;
	mes "[纪尧姆骑士]";
		if (getbattleflag("feature.bgqueue"))
			mes "请注意，取消后 ^0000FF一分钟内不能再次报名^000000。";
		else {
			mes "请向 KVM 军官报名，之后你在普隆德拉时他会联系你。";
			next;
	mes "[纪尧姆骑士]";
			mes "然后进入战场并遵循其中的指示。";
			next;
	mes "[纪尧姆骑士]";
			mes "但请注意，除非你在 KVM 办事处，否则他无法联系你。";
		}
		close;
	case 4:
	mes "[纪尧姆骑士]";
		mes "你的克里格点数是：";
		mes ""+kvm_point+".";
		close;
	}
}


	}
	end;
}

// Troublesome Fairies (Prankster of Eclage)
//============================================================
ecl_in02,160,36,4	script	Eirinn#nk	4_F_FAIRYKID6,{
	switch( isbegin_quest(4254) ) {
		mes "[艾琳]";
	case 0:
		if (BaseLevel < 120) {
			mes "呜，我的肚子好痛！！";
			mes "你在看什么？";
			next;
			mes "[艾琳]";
			mes "我最近没吃什么奇怪的东西，可为什么总是胃痛！";
			close;
		}
		mes "呜，我的肚子好痛！！";
		mes "你在看什么？";
		next;
		mes "[艾琳]";
		mes "我最近没吃什么奇怪的东西，可为什么总是胃痛！";
		next;
		mes "[艾琳]";
		mes "你还在吗？";
		mes "太好了，你来得正是时候。";
		next;
		mes "[艾琳]";
		mes "我本来想拿治疗胃痛的药，但仓库里已经没有那种草药了。";
		next;
		mes "[艾琳]";
		mes "正如老话所说，";
		mes "“需要的时候，连绿色药草都很难找到。”";
		mes "你能出去找些药草之类的东西吗？";
		next;
		if (select("为什么要我去？:当然！") == 1) {
			mes "[艾琳]";
			mes "好吧，那就别来烦我，";
			mes "走开。";
			close;
		}
		mes "[艾琳]";
		mes "我需要";
		mes "^ff000010 个绿色药草^000000";
		mes "希望你快一点，别等艾可拉玖充满我的呻吟声。";
		setquest 4254;
		close;
	case 1:
		mes "呜，我的肚子好痛！！";
		mes "绿色药草不是很常见吗？";
		mes "真不敢相信竟然没库存！";
		next;
		if (select("交出药草:去别的地方。") == 1) {
			mes "[艾琳]";
			if (countitem(511) < 10) {
				mes "幼儿园老师没告诉过你吗？";
				mes "“撒谎是不对的！”";
				mes "不知道她有没有也说过要帮助有需要的人。";
				close;
			}
			delitem 511,10;// Green_Herb
			getitem 12812,1;// Snow_Flip
			getitem 12813,1;// Peony_Mommy
			getitem 12814,1;// Slapping_Herb
			getitem 12815,1;// Yggdrasil_Dust
			completequest 4254;
			getexp 100000,0;
			mes "啊，太感谢你了！";
			mes "那我就去准备药。";
			mes "希望它有效……";
			next;
			mes "[艾琳]";
			mes "对了，我翻仓库时找到了一些药草。虽然不能治胃痛，但我送你一些作为回报。";
			next;
			mes "[艾琳]";
			mes "平时在附近就能找到，不过它非常有效，所以很多冒险者都喜欢。";
		}
		close;
	case 2:
		if (isbegin_quest(4257) == 0) {
			mes "嗯……我确定自己吃了正确的药……";
			mes "但为什么还没有好转？";
			mes "也许不只是胃痛？";
			mes "难道我得了……";
			next;
			mes "[艾琳]";
			mes "严重的病？比如无法治愈的病？？";
			mes "我是不是要像电视剧里饰演悲剧角色的女主角一样？";
			emotion ET_QUESTION;
		}
		else if (isbegin_quest(4257) == 1) {
			if (checkquest(4258) == 2) {
				mes "塞西莉亚真是莫名其妙。";
				mes "她明明知道我喜欢书……";
				next;
				mes "[艾琳]";
				mes "如果你还记得其他故事，再告诉我。";
				mes "还有，记得问塞西莉亚为什么问那种问题。";
				close;
			}
			mes "我最近读过什么书吗？";
			mes "嗯……是的，我平时读很多书。";
			mes "在诊所里也没别的事可做。";
			next;
			mes "[艾琳]";
			mes "啊，在我胃痛之前，";
			mes "我借过一本书。";
			mes "那本书讲的是你来自哪里，非常有趣。但为什么问这个？";
			next;
			mes "[艾琳]";
			mes "塞西莉亚真是莫名其妙。";
			mes "她明明知道我喜欢书……";
			mes "总之，告诉她我这么说。";
			completequest 4258;
		}
		else if (checkquest(4258) == 2) {
			if (checkquest(4260) < 2) {
				mes "塞西莉亚在调查什么吗？";
				mes "对吧？她不是在调查吗？我说得对吧？对吧？";
				close;
			}
			switch( isbegin_quest(4261) ) {
			case 0:
				mes "那么……";
				mes "多米尼克害得这位美丽女士胃痛，我是不是该开始惩罚他了！！";
				next;
				mes "[艾琳]";
				mes "以翼还翼，以触须还触须，以恶作剧还恶作剧！";
				mes "这就是我们的法则。";
				next;
				mes "[艾琳]";
				mes "既然多米尼克把书架照顾得很好，我是不是该在那附近弄得一团糟来惹恼他？";
				next;
				mes "[艾琳]";
				mes "好，我决定了。";
				mes "请再帮我一个忙，好吗？";
				mes "能各带给我一根植物茎和一株绿色药草吗？";
				mes "我要在这里施展一些魔法。";
				next;
				if (select("为什么要我去？:当然！") == 1) {
					mes "[艾琳]";
					mes "嗯……你不愿意的话，我也没办法。";
					mes "我应该找别人……";
					close;
				}
				mes "[艾琳]";
				mes "很简单，不会花太久，对吧？";
				mes "我会在这里准备，所以快去快回！";
				setquest 4261;
				close;
			case 1:
				if (!countitem(905) || !countitem(511)) {
					mes "你做完了吗？";
					mes "我等得好累～";
					mes "再快一点吧。";
					mes "恶作剧想太多就不好玩了。";
					next;
					mes "[艾琳]";
					mes "我需要一根植物茎和一株绿色药草。";
					close;
				}
				mes "我已经准备好了。";
				mes "现在，把你带来的东西这样混合，然后……";
				delitem 905,1;// Stem
				delitem 511,1;// Green_Herb
				getitem 6563,1;// Weeds
				completequest 4261;
				setquest 4262;
				specialeffect EF_PHARMACY_OK;
				next;
				mes "[艾琳]";
				mes "锵锵～";
				mes "简单的召唤工具：新芽完成了！";
				mes "人人都能使用～";
				next;
				mes "[艾琳]";
				mes "剧本由艾琳编写！";
				mes "主演："+ strcharinfo(0) +"！";
				mes "反派角色由多米尼克饰演。";
				mes "人员到齐，道具准备完毕！";
				next;
				mes "[艾琳]";
				mes "现在只要把它偷偷种在多米尼克照看的书架附近，我们的任务就完成了！";
				mes "如果他发现书架旁长出杂草，一定会很生气，对吧？";
				next;
				mes "[艾琳]";
				mes "快点，花太久就没意思了。";
				mes "走吧，我们去做这件事！";
				close;
			case 2:
				switch( isbegin_quest(4262) ) {
				case 0:
					mes "嗯？真奇怪。";
					mes "你身上有些奇怪。";
					next;
					mes "[艾琳]";
					mes "现在再拿上这个，别忘了偷偷种在多米尼克的书架附近。";
					setquest 4262;
					getitem 6563,1;// Weeds
					close;
				case 1:
					mes "我们……我们终于成功了吗？！";
					mes "现在去把这个偷偷种在多米尼克的书架附近。";
					mes "如果他发现书架旁长出杂草，一定会很生气，对吧？";
					next;
					mes "[艾琳]";
					mes "快点，花太久就没意思了。";
					mes "走吧，我们去做这件事！";
					close;
				case 2:
					mes "嘿嘿嘿，我在这里都能听到多米尼克的尖叫。";
					mes "他现在真的很生气吗？";
					next;
					mes "[艾琳]";
					mes "真可惜，没能亲眼看到他在那里闹腾。";
					mes "我之后应该再试一次。";
					next;
					mes "["+ strcharinfo(0) +"]";
					mes "……";
					close;
				}
				mes "可怜的多米尼克，他再也不敢惹我了。";
				close;
			}
		}
		close;
	}
}

ecl_in03,175,69,4	script	Bourbon#nk	4_M_FAIRYKID3,{
	mes "[波旁]";
	switch( isbegin_quest(4255) ) {
	case 0:
		if (BaseLevel < 120) {
			mes "真奇怪。我最近总是丢东西，连放在口袋里或好好收起来的东西都会丢。";
			close;
		}
		mes "真奇怪。我最近总是丢东西，连放在口袋里或好好收起来的东西都会丢。";
		next;
		mes "[波旁]";
		mes "没错，我确定是外面那些小淘气鬼对我做的。";
		mes "我不在的时候，一定是他们拿走了我的东西。";
		next;
		mes "[波旁]";
		mes "我想教训他们，但我还有工作要做，哪里也去不了。";
		mes "如果因为这种私事离开，我会惹上麻烦。";
		next;
		mes "[波旁]";
		mes "所以，你来得正是时候！";
		mes "你能代我教训一下外面那些小混混吗？";
		mes "怎么样，愿意吗？";
		next;
		if (select("为什么要我去？:当然！") == 1) {
			mes "[波旁]";
			mes "嗯，我想我不能强迫你。";
			mes "我应该找别人……";
			close;
		}
		mes "[波旁]";
		mes "很好，你答应了。";
		mes "去外面教训 20 个妖精。";
		mes "这样我会舒服多了。";
		next;
		mes "[波旁]";
		mes "他们就在门外，所以不用我告诉你具体位置了吧？";
		mes "祝你好运～";
		setquest 4255;
		close;
	case 1:
		switch( checkquest(4255,HUNTING) ) {
		case -1:
		case 0:
			mes "哎呀，你……你不是答应过";
			mes "要好好教训外面那些小家伙吗？";
			next;
			mes "[波旁]";
			mes "我觉得出了点问题。";
			mes "你能再和我谈谈吗？";
			erasequest 4255;
			close;
		case 1:
			mes "他们就在门外，所以不用我告诉你具体位置了吧？";
			mes "请教训外面的 20 个妖精后再回来～";
			next;
			mes "[波旁]";
			mes "那么，祝你好运。";
			close;
		case 2:
			mes "嗯？你已经完成了？";
			mes "噗哈哈哈！";
			next;
			mes "[波旁]";
			mes "你得把衣服上的东西刷掉。";
			mes "你身上到处都是羽毛。";
			mes "这有那么难吗……？";
			mes "嗯，看起来你吃了不少苦。让我给你奖励。";
			next;
			mes "[波旁]";
			mes "总之，谢谢。";
			mes "但我感觉你离开时有人拿走了我的笔……会是谁呢……？";
			completequest 4255;
			getexp 100000,0;
			getitem 6081,2;// Splendide_Coin
			close;
		}
	case 2:
		switch( isbegin_quest(4257) ) {
		case 0:
			mes "真奇怪……";
			mes "我到处都找不到我的笔。";
			mes "我最近一直经常使用它……";
			mes "是谁对我做了这种事……";
			close;
		case 1:
			if (checkquest(4259) == 2) {
				mes "突然之间，来自米德加尔特的人越来越常来艾可拉玖。";
				mes "所以我们也开始获得米德加尔特的情报，我也很感兴趣。";
				next;
				mes "[波旁]";
				mes "那里似乎不是适合居住的完美地方，但听起来确实很有趣。";
				mes "不知道最近有没有新书出版……";
				mes "我应该去看看。";
				close;
			}
			mes "书？我很喜欢书。";
			mes "最近米德加尔特出了很多新书，所以我自己都读过。";
			next;
			mes "[波旁]";
			mes "我很好奇为什么突然有这么多来自你们村庄的访客来到艾可拉玖。";
			mes "那里似乎不是适合居住的完美地方，但听起来确实很有趣。";
			completequest 4259;
			close;
		case 2:
			if (checkquest(4260) < 2) {
				mes "嗯……我闻到了……";
				mes "我闻到了有趣事情的气息……";
				close;
			}
			switch( isbegin_quest(4263) ) {
			case 0:
				mes "真正的绅士应该回报自己得到的东西！";
				mes "我不会容忍这种事。";
				next;
				mes "[波旁]";
				mes "让我看看多米尼克最讨厌什么……";
				mes "啊哈～我干劲十足。";
				mes "我叫波旁，天生就是恶作剧高手。";
				next;
				mes "[波旁]";
				mes "我记得他说讨厌小巧、敏捷、尾巴很长的东西。";
				mes "越想越觉得那听起来像……老鼠？";
				next;
				mes "[波旁]";
				mes "没错，就是老鼠。现在没人能阻止我。";
				mes "那我就放几只老鼠吧！";
				next;
				mes "[波旁]";
				mes "……不过仔细想想，这里没有老鼠，对吧？";
				mes "再帮我一个忙吧。";
				mes "这关系到我的自尊。你会帮我吗？";
				next;
				if (select("我还是不要了……:当然！") == 1) {
					mes "[波旁]";
					mes "什么？你怎么能这样！";
					mes "你没听见我的心脏像鼓一样跳吗？";
					mes "你装作没看见，还对我置之不理，这不合理。";
					close;
				}
				mes "[波旁]";
				mes "这才像话！";
				mes "你和我一样，都是调皮的小猴子！";
				next;
				mes "[波旁]";
				mes "准备好后我会告诉你详情，现在需要的是 2 根老鼠尾巴。";
				mes "这里当然没有老鼠，所以你可能要花点时间找。";
				next;
				mes "[波旁]";
				mes "谢谢你，我的朋友。";
				mes "哈哈哈哈哈！";
				mes "我们已经站在同一边了。";
				setquest 4263;
				close;
			case 1:
				if (countitem(1016) < 2) {
					mes "呜，我热血沸腾！！";
					mes "我的全身都充满了恶作剧精神！";
					next;
					mes "[波旁]";
					mes "……嗯？";
					mes "你还没找到老鼠尾巴？";
					mes "我知道这很难，但我就靠你了，我的朋友！";
					close;
				}
				mes "很好！";
				mes "我也准备好了。";
				mes "让我看看……我已经很久没用过材料转换魔法了。";
				completequest 4263;
				setquest 4264;
				delitem 1016,2;// Rat_Tail
				getitem 6562,1;// Tiny_Mouse_Tail
				specialeffect EF_DETOXICATION;
				next;
				mes "[波旁]";
				mes "你看，现在它只是一条小尾巴，但它会变成伟大的……";
				mes "好吧，终究只是老鼠，不是“伟大”的老鼠，但它仍然拥有神秘的力量。";
				next;
				mes "[波旁]";
				mes "沙赞！魔法完成了。";
				mes "把你得到的东西扔到多米尼克旁边！";
				mes "它会变成老鼠，开始在他身边活动。";
				mes "我们的“任务”就完成了！";
				next;
				mes "[波旁]";
				mes "嘿嘿嘿……";
				mes "我太兴奋了。";
				mes "你还在做什么？快去！";
				close;
			case 2:
				switch( isbegin_quest(4264) ) {
				case 0:
					mes "不，这里有点奇怪。";
					mes "我觉得哪里不对。";
					mes "啊，算了！总之拿着这个。";
					mes "我不想再想了。";
					next;
					setquest 4264;
					getitem 6562,1;// Tiny_Mouse_Tail
					mes "[波旁]";
					mes "把这个扔到多米尼克面前。";
					mes "它会变成老鼠，开始在他身边活动。";
					close;
				case 1:
					mes "把你得到的东西扔到多米尼克面前。";
					mes "它会变成老鼠，开始在他身边活动。";
					next;
					mes "[波旁]";
					mes "嘿嘿嘿……";
					mes "我太兴奋了。";
					mes "你还在做什么？快去！";
					close;
				case 2:
					mes "啊哈～对了，";
					mes "多米尼克会怎么处理那只老鼠？";
					mes "它不会像回旋镖一样回到我这里吧？";
					next;
					mes "[波旁]";
					mes "我确定多米尼克动不了，连一根手指都动不了。";
					next;
					mes "[波旁]";
					mes "希望他明白论恶作剧我比他高明一筹，这样他就不会再惹我了。";
					next;
					mes "["+ strcharinfo(0) +"]";
					mes "……";
					close;
				default:
					mes "希望他明白论恶作剧我比他高明一筹，这样他就不会再惹我了。";
					close;
				}
			}
		}
	}
}

ecl_in01,26,88,5	script	Cecilia#nk	4_F_FAIRYKID5,{
	if (BaseLevel < 120) {
		mes "[塞西莉亚]";
		mes "嗯……嗯……我该怎么办……";
		next;
		mes "- 她似乎太忙了，没空和你说话。 -";
		close;
	}
	switch( isbegin_quest(4256) ) {
	case 0:
		mes "[塞西莉亚]";
		mes "嗯……嗯……";
		next;
		mes "[塞西莉亚]";
		mes "我该怎么办？";
		mes "不管检查多少次，总有些物品不见了……";
		mes "难道是因为最近城里突然出现的那些流浪者？";
		next;
		emotion ET_SURPRISE;
		mes "[塞西莉亚]";
		mes "嘿～嘿～听我说！";
		mes "喂，你在那里做什么？";
		mes "你刚才听到我说的全部了吧？";
		next;
		mes "[塞西莉亚]";
		mes "艾可拉玖不可能有小偷。";
		mes "越想越觉得这是外来者干的。";
		mes "你不觉得吗？";
		next;
		mes "[塞西莉亚]";
		mes "所以，知道我们的物资不见了，而且碰巧也是外来者的你，";
		mes "一定就是小偷！";
		emotion ET_SMILE;
		next;
		mes "[塞西莉亚]";
		mes "你有权要求律师在场，而且……不，算了。";

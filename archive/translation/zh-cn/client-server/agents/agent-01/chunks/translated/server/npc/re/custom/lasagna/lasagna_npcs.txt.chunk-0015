	mes "[" + strcharinfo(0) + "]";
	mes "一头牛的名字是 [Woncow]……";
	next;
	mes "[水手长]";
	mes "怎么了？我可是打赌赢来的。每次叫她的名字，都会让我想起胜利的那一刻。真美。";
	npctalk "哞——", "", bc_self;
	emotion ET_BIGTHROB;
	npctalk "对吧？", "Boatswain#dorcon", bc_self;
	emotion ET_THROB;
	next;
	mes "[" + strcharinfo(0) + "]";
	mes "话说回来，为什么船上会有一头牛？";
	next;
	mes "[水手长]";
	mes "为什么？因为我们想每天喝新鲜牛奶！";
	npctalk "哞——哞——", "", bc_self;
	next;
	mes "[" + strcharinfo(0) + "]";
	mes "你们为了新鲜牛奶把牛带上船？";
	next;
	mes "[舵手]";
	mes "水手长一刻也不能离开她，因为她是他的幸运女神。幸运的是，我们每天都能喝到卡鲁纳牛奶。";
	npctalk "谁能想到我们每天都能在船上喝到卡鲁纳牛奶？", "Helmsman#dorcon", bc_self;
	next;
	mes "[水手长]";
	mes "嘿！再说下去会把好运说没的！";
	npctalk "哞——--------", "", bc_self;
	npctalk "不，不——那个人不会伤害你——", "Boatswain#dorcon", bc_self;
	close;
}

conch_in,189,63,3	script	Head Chef#dorcon	4_DR_TORTEL,{
	emotion ET_SLEEPY;
	mes "[主厨]";
	mes "*呼噜*";
	npctalk "*呼噜*", "", bc_self;
	close;
}

conch_in,186,57,3	script	Sous Chef#dorcon	4_CAT_CHEF,{
	if (checkweight(1001,1) == 0) {
		mes "[副厨师长]";
		mes "东西太多太重了。要不要减少一些？";
		close;
	}
	if (lasagna_quest[1] < 16) {
		mes "[副厨师长]";
		mes "很快就到用餐时间了。我得抓紧。";
		close;
	}
	if (lasagna_quest[1] == 16) {
		mes "[" + strcharinfo(0) + "]";
		mes "你好，我是" + strcharinfo(0) + "，正在进行新的冒险。很高兴认识你。";
		next;
		mes "[副厨师长]";
		mes "......";
		npctalk "你真冷淡。", "Boatswain#dorcon", bc_self;
		npctalk "他可能没听见。", "Helmsman#dorcon", bc_self;
		next;
		mes "[水手长]";
		mes "哦，你就是刚受训完、准备前往新大陆冒险的冒险者。我喜欢有冒险精神的人。年轻时我也经常到处旅行。";
		next;
		mes "[舵手]";
		mes "具体是什么时候？多久以前？";
		next;
		mes "[水手长]";
		mes "没多久。感觉就像昨天发生的一样。";
		next;
		mes "[舵手]";
		mes "昨天你还在半夜于甲板上奔跑。";
		next;
		mes "[水手长]";
		mes "呼，真是胡说八道。";
		next;
		mes "[副厨师长]";
		mes "嘿，我明白了。那里太吵了。你现在可以走了。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes ".......";
		next;
		mes "[水手长]";
		mes "副厨师长在出航前总是很紧张。别往心里去。";
		npctalk "这不代表他不喜欢你。", "Helmsman#dorcon", bc_self;
		next;
		mes "[舵手]";
		mes "成熟的多郎族不会计较这种事。你可以走了。我们马上要出发。";
		erasequest 14534;// To the kitchen
		setquest 14535;// To Purser
		getexp 200,300;
		lasagna_quest[1] = 17;
		close;
	}
	if (lasagna_quest[1] == 17) {
		mes "[副厨师长]";
		mes "去问事务长什么时候发布出航信号。根据时间，我们需要更换或补充材料。";
		close;
	}
	if (lasagna_quest[1] == 18) {
		mes "[" + strcharinfo(0) + "]";
		mes "亲爱的副厨师长。";
		next;
		mes "[副厨师长]";
		mes "长话短说。我很忙。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "我的意思是，^0000cd新手来了！^000000";
		emotion ET_HUK, getnpcid(0, "Boatswain#dorcon");
		emotion ET_HUK, getnpcid(0, "Helmsman#dorcon");
		next;
		mes "[副厨师长]";
		mes "你在做什么？这是找死的新方法吗？我不怕挑战。拔出你的武器。";
		npctalk "你听到我听见的了吗？", "Boatswain#dorcon", bc_self;
		npctalk "听到了。现在的年轻人……真是鲁莽……", "Helmsman#dorcon", bc_self;
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "我不是那个意思……我不是……那个……";
		next;
		mes "[副厨师长]";
		mes "你这个小老鼠！告诉我，我不认为你这样的新手能独自想出这种事。是谁派你来的？";
		npctalk "这背后有个操纵者！", "Boatswain#dorcon", bc_self;
		npctalk "副厨师长是怎么发现的？", "Helmsman#dorcon", bc_self;
		npctalk "等等，那个人拿着……", "Boatswain#dorcon", bc_self;
		next;
		mes "[舵手]";
		mes "副厨师长！我觉得他说的是真的。这是你下令的，对吧？";
		next;
		mes "[副厨师长]";
		mes "^0000cdKahlugnag^000000？那个蛋壳灵！是他让这个新手这么做、还恶作剧的！嘿，抱歉，请接受我的道歉。";
		npctalk "你得赶紧好好道歉。", "Boatswain#dorcon", bc_self;
		npctalk "绅士就该这么做。", "Helmsman#dorcon", bc_self;
		next;
		mes "[副厨师长]";
		mes "我会让他向你道歉。他真是个麻烦精，永远只是个小水手。";
		npctalk "愿蛋壳灵安息。", "Boatswain#dorcon", bc_self;
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "不，没什么。";
		next;
		mes "[副厨师长]";
		mes "你喜欢^0000cd食物^000000吗？";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "是的！喜欢！";
		next;
		mes "[副厨师长]";
		mes "我是说制作食物，不是吃食物。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "呃，我从没试过，但我想我会喜欢。";
		next;
		mes "[副厨师长]";
		mes "你稍后回来时，^0000cd我会教你做饭^000000。就当作我的道歉。好了，你现在可以走了。";
		npctalk "教做饭？到底怎么回事！", "Boatswain#dorcon", bc_self;
		next;
		mes "[水手长]";
		mes "嘿，新手！路上去问事务长什么时候出航。我觉得一直没有信号，肯定出了什么问题。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "好，我会的！";
		delitem 25047,1;// Kahlunac
		erasequest 14536;// Delivery to Chef
		setquest 14537;// When do we take off?
		getexp 200,300;
		lasagna_quest[1] = 19;
		close;
	}
	if (lasagna_quest[1] < 29) {
		mes "[副厨师长]";
		mes "很快就到用餐时间了。我得抓紧。";
		close;
	}
	if (lasagna_quest[1] == 29 && isbegin_quest(14536) == 0) {// Delivery to Chef
		mes "[副厨师长]";
		mes "你是来学习做饭的吗？";
		next;
		if (select( "是！", "不是。" ) == 2) {
			mes "[副厨师长]";
			mes "如果想学做饭，随时来找我。";
			close;
		}
		if (BaseLevel > 30) {
			mes "[副厨师长]";
			mes "你看起来已经不是新手了。我太忙，不能再继续教你。如果想进一步探索料理世界，就去找别人吧。";
			next;
			mes "[副厨师长]";
			mes "我听说新大陆的宫殿里有人教做饭。去那里看看是个好主意。";
			for ( .@quest_id = 14154; .@quest_id < 14157; .@quest_id++ ) {
				if (isbegin_quest(.@quest_id) > 0)
					erasequest .@quest_id;
			}
			setquest 14536;// Delivery to Chef
			completequest 14536;// Delivery to Chef
			close;
		}
		if (sous_chef_quest == 0) {
			mes "[副厨师长]";
			mes "美食可以^0000cd提升某项状态^000000并^0000cd恢复 HP^000000。没有理由不做饭和吃饭。";
			next;
			mes "[副厨师长]";
			mes "料理主要有两种功能。";
			next;
			emotion ET_SURPRISE;
			mes "[副厨师长]";
			mes "第一，^0000cd提升状态^000000。";
			next;
			mes "[副厨师长]";
			mes "料理分为六种，分别提升^0000cd力量、敏捷、体质、智力、灵巧或幸运^000000。提升量取决于料理等级。";
			next;
			emotion ET_SURPRISE;
			mes "[副厨师长]";
			mes "第二，^0000cd恢复 HP 和 SP^000000。恢复量也取决于料理等级，有些食物只能恢复 HP。";
			next;
			mes "[副厨师长]";
			mes "要制作这些料理，需要做一些准备。";
			next;
			mes "[副厨师长]";
			mes "准备分为两个步骤。";
			next;
			emotion ET_SURPRISE;
			mes "[副厨师长]";
			mes "第一！你需要一本^0000cd料理书^000000。";
			next;
			mes "[副厨师长]";
			mes "料理书能教你准备材料和烹饪。你可以通过^0000cd任务^000000或^0000cd魔物^000000获得料理书。";
			next;
			emotion ET_SURPRISE;
			mes "[副厨师长]";
			mes "获得料理书后，你需要收集^0000cd材料^000000。没有材料，舔料理书的页面也没用。连蛋壳灵都知道这一点。";
			next;
			mes "[副厨师长]";
			mes "你可以从^0000cd魔物^000000或^0000cd材料商人^000000那里获得材料。烹饪虽然需要准备，但效果值得付出。";
			next;
			mes "[副厨师长]";
			mes "哦，顺便说一下，^0000cd料理可能会失败^000000。失败率取决于你的烹饪器具和料理等级。";
			next;
			mes "[副厨师长]";
			mes "那么，开始烹饪吧。准备好后再来找我！";
			sous_chef_quest = 1;
			close;
		}
		if (sous_chef_quest == 1) {
			for ( .@i = 14154; .@i < 14158; .@i++ ) {
				if (isbegin_quest(.@i) == 1) {
					.@quest_id = .@i;
					break;
				}
			}
			if (.@quest_id > 0) {
				mes "[副厨师长]";
				mes "让我看看。你把所有材料都带来了吗？";
				next;
				mes "[副厨师长]";
				switch( .@quest_id ) {
				case 14154:
					callsub( S_Check, 705,1, 511,1, 507,1 );
					mes "吃下这个后去狩猎吧。你不会相信自己获得的新力量。";
					next;
					delitem 705,1;// Clover
					delitem 511,1;// Green Herb
					delitem 507,1;// Red Herb
					getitem 11551,1;// Savory Herb Salad (Str+1)
					erasequest 14154;// Fragrant herb mix
					close;
				case 14155:
					callsub( S_Check, 512,1, 515,2 );
					mes "吃下这个后，你会比别人移动得更快，甚至比振翅的蜂鸟还快。";
					delitem 512,1;// Apple
					delitem 515,2;// Carrot
					getitem 11552,1;// Apple Carrot Salad (Agi+1)
					erasequest 14155;// Crunchy salad
					close;
				case 14156:
					callsub( S_Check, 949,1, 909,1, 914,1 );
					mes "你已经感觉到神秘力量在血管中涌动了吗？你无法抵抗它！";
					delitem 949,1;// Feather
					delitem 909,1;// Jellopy
					delitem 914,1;// Fluff
					getitem 11553,1;// Casual Stew (Vit+1)
					erasequest 14156;// Anything shabushabu
					close;
				case 14157:
					callsub( S_Check, 705,1, 512,1 );
					mes "吃一口这个，你会变得更加熟练。";
					next;
					delitem 705,1;// Clover
					delitem 512,1;// Apple
					getitem 11554,1;// Golden Roasted Apple (Dex+1)
					erasequest 14157;// Baked golden apple
					close;
				}
			}
			mes "[副厨师长]";
			mes "准备好了吗？行动胜于言语！开始烹饪吧！";
			next;
			mes "[副厨师长]";
			mes "其实你需要配方和烹饪器具，但这对新手来说可能太复杂。这次我替你做一个。材料不能浪费。";
			next;
			mes "[副厨师长]";
			mes "这是新手试用版，效果和 1 级料理相同，但^0000cd持续时间较短。^000000";
			next;
			mes "[副厨师长]";
			mes "你喜欢吃什么料理？智力或幸运料理暂时帮不上你，所以现在可以制作四种料理。";
			next;
			switch( select( "香味调味药草", "脆爽沙拉", "混合炖菜", "烤金苹果" ) ) {
			case 1:
				mes "[副厨师长]";
				mes "^0000cd香味调味药草^000000。它能提升^0000cd力量^000000。经常使用体力的人会吃这个。";
				next;
				mes "[副厨师长]";
				mes "材料是^0000cd1 个四叶草、1 株绿色药草和 1 株红色药草^000000。";
				next;
				cutin "루나틱카드.bmp",3;
				mes "[副厨师长]";
				mes "可以从外面原野的叶疯兔或草精灵那里获得四叶草和红色药草。";
				next;
				cutin "파브르카드.bmp",3;
				mes "[副厨师长]";
				mes "可以从草精灵那里获得绿色药草。";
				next;
				cutin "",255;
				mes "[副厨师长]";
				mes "带齐所有材料后我们就能烹饪。快点。";
				setquest 14154;// Fragrant herb mix
				close;
			case 2:
				mes "[副厨师长]";
				mes "^0000cd脆爽沙拉^000000！我很喜欢这道菜。你很有品味。";
				next;
				mes "[副厨师长]";
				mes "脆爽沙拉提升^0000cd敏捷^000000。想更快攻击或不想被命中的人会吃它。";
				next;
				mes "[副厨师长]";
				mes "材料是^0000cd1 个苹果和 2 根胡萝卜^000000。";
				next;
				cutin "에그링카드.bmp",3;
				mes "[副厨师长]";
				mes "可以从依斯鲁得外围原野跳跃的蛋壳灵那里获得苹果。";
				next;
				cutin "리프루나틱카드.bmp",3;
				mes "[副厨师长]";
				mes "可以从叶疯兔那里获得胡萝卜。";
				next;
				cutin "",255;
				mes "[副厨师长]";
				mes "带齐所有材料后我们就能烹饪！";
				setquest 14155;// Crunchy salad
				close;
			case 3:
				mes "[副厨师长]";
				mes "^0000cd混合炖菜^000000。它能提升^0000cd体质^000000。吃了很有饱腹感，即使被魔物攻击也不会感到太痛。";
				next;
				mes "[副厨师长]";
				mes "材料是^0000cd1 个杰勒比结晶、1 个绒毛和 1 根羽毛^000000。";
				next;
				cutin "에그링카드.bmp",3;
				mes "[副厨师长]";
				mes "可以从外围原野跳跃的蛋壳灵那里获得杰勒比结晶。";
				next;
				cutin "그래스파브르카드.bmp",3;
				mes "[副厨师长]";
				mes "可以从草精灵或叶疯兔那里获得绒毛。";
				next;
				cutin "리프루나틱카드.bmp",3;
				mes "[副厨师长]";
				mes "可以从草精灵或叶疯兔那里获得羽毛。";
				next;
				cutin "",255;
				mes "[副厨师长]";
				mes "带齐所有材料后我们就能烹饪。快点。";
				setquest 14156;// Anything shabushabu
				close;
			case 4:
				mes "[副厨师长]";
				mes "^0000cd烤金苹果^000000。它表面的金色光泽让人难以抗拒。";
				next;
				mes "[副厨师长]";
				mes "它能提升^0000cd灵巧^000000。想提高命中率的人通常会吃这个。";
				next;
				mes "[副厨师长]";
				mes "材料是^0000cd1 个苹果和 1 个四叶草^000000。";
				next;
				cutin "에그링카드.bmp",3;
				mes "[副厨师长]";
				mes "可以从外围原野的蛋壳灵那里获得苹果。";
				next;
				cutin "그래스파브르카드.bmp",3;
				mes "[副厨师长]";
				mes "可以从草精灵或叶疯兔那里获得四叶草。";
				next;
				cutin "",255;
				mes "[副厨师长]";
				mes "带齐所有材料后我们就能烹饪。快点。";
				setquest 14157;// Baked golden apple
				close;
			}
		}
	}

	// daily quest
	if (BaseLevel < 140) {
		mes "[副厨师长]";
		mes "我需要找人帮个忙。你看起来还不够有经验。";
		close;
	}
	switch( isbegin_quest(14555) ) {
	case 0:
		if (Class != Job_Summoner) {
			mes "[副厨师长]";
			mes "我说过不要那样进入厨房……哦……你是来自新大陆吗？";
			npctalk "新大陆！新大陆！", "Head Chef#dorcon", bc_self;
			next;
			mes "[副厨师长]";
			mes "最近经常看到你。你的样子真奇怪，脸上没有胡须，屁股后面也没有尾巴。";
			npctalk "在当事人面前讨论外貌很不礼貌！", "Boatswain#dorcon", bc_self;
			npctalk "真没礼貌！", "Helmsman#dorcon", bc_self;
			next;
			mes "[副厨师长]";
			mes "请原谅。我是负责这间厨房的副厨师长。";
			next;
			mes "[" + strcharinfo(0) + "]";
			mes "你好。我是" + strcharinfo(0) + "。";
			next;
			mes "[副厨师长]";
			mes "你的名字也很奇怪。";
		}
		else {
			mes "[副厨师长]";
			mes "我说过不要那样进入厨房……哦……你看起来有点眼熟……";
			next;
			mes "[" + strcharinfo(0) + "]";
			mes "你好。我是" + strcharinfo(0) + "，正在康·奇利纳号上展开冒险。";
			next;
			mes "[副厨师长]";
			mes "这样啊？让我自我介绍一下。我是负责这间厨房的副厨师长。";
		}
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "那主厨呢？为什么是副厨师长负责厨房？";
		npctalk "哦，你不该说那句话的！", "Boatswain#dorcon", bc_self;
		npctalk "又开始了。漫长的故事。", "Helmsman#dorcon", bc_self;
		next;
		mes "[副厨师长]";
		mes "看那边。那个睡在地上、完全不像绅士的人。^0000cd他就是我们的主厨^000000。船长总说我们必须把工作做到最好，但对他没用。";
		emotion ET_SLEEPY, getnpcid(0, "Head Chef#dorcon");
		npctalk "*呼噜*","Head Chef#dorcon", bc_self;
		next;
		mes "[副厨师长]";
		mes "你知道烹饪最重要的是什么吗？是对最佳味道无尽的热情与追求。不过，我们的主厨对这些毫无兴趣。";
		npctalk "味道，这很重要。", "Head Chef#dorcon", bc_self;
		next;
		mes "[副厨师长]";
		mes "不过，他很擅长在短时间内做出足够多人食用的份量，所以才成为主厨。但人们开始抱怨味道后，我就被叫来了。";
		npctalk "我不介意主厨做的东西。", "Boatswain#dorcon", bc_self;
		npctalk "你的舌头有问题。", "Helmsman#dorcon", bc_self;
		next;
		mes "[副厨师长]";
		mes "从那以后，主厨把一切都交给我负责。";
		next;
		mes "[副厨师长]";
		mes "我相信新大陆的人吃的食物和我们不同。那里的居民觉得什么好吃呢？";
		next;
		mes "[副厨师长]";
		mes "我想去那里尝尝每一道菜。不过如果我离开，船员们就会饿死。";
		npctalk "如果你想去，就应该带我一起去。", "Head Chef#dorcon", bc_self;
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "嗯，食物有很多种。我们也会狩猎材料并烹饪。肯定还有很多新东西……";
		next;
		mes "[副厨师长]";
		mes "我这里正好有一本^0000cd新大陆料理书^000000。你现在有那些食物的材料吗？";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "不太有……";
		next;
		mes "[副厨师长]";
		mes "那么拜托你一件事。请带来这本^0000cd料理书^000000中的一些材料。这个叫^0000cd马斯特拉果酒^000000的料理……我很好奇，但它需要这里找不到的材料。";
		next;
		mes "[副厨师长]";
		mes "另外，也请带来一些^0000cd纳比主厨制作的猫咪硬饼干^000000。我听说味道不好，但营养丰富又便于储存。";
		next;
		mes "[副厨师长]";
		mes "请带来^0000cd4 个马斯特拉果实和 1 个猫咪硬饼干^000000。";
		next;
		mes "[副厨师长]";
		mes "带来这些后，我会给你丰厚的奖励。";
		npctalk "我也很兴奋。新食物。", "Boatswain#dorcon", bc_self;
		npctalk "你不就是需要食物填饱肚子吗？", "Helmsman#dorcon", bc_self;
		next;
		mes "[副厨师长]";
		mes "那么，就拜托你了。";
		setquest 14555;// Whole new world of taste
		close;
	case 1:
		if (countitem(522) < 4 || countitem(11536) < 1) {
			mes "[副厨师长]";
			mes "我拜托你的事情怎么样了？4 个马斯特拉果实和 1 个猫咪硬饼干。";
			close;
		}
		mes "[副厨师长]";
		mes "你这么快就带来了。我要用这些挑战制作新料理，心跳得好快。";

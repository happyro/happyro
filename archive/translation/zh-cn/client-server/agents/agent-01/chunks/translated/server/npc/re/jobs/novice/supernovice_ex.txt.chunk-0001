function	script	Esseray_Ex	{
	if (BaseLevel > 98 && JobLevel > 98) {
		if (EXSUPNOV_Q > 0 && EXSUPNOV_Q < 6) {
			mes "[埃塞雷]";
			mes "初心者世界的一位传奇人物去了海洞，不知在做什么。";
			mes "你应该找到他。";
			next;
			mes "[埃塞雷]";
			mes "他会引导你走上";
			mes "正确的道路……";
			close;
		}
		mes "[埃塞雷]";
		mes "哦？你是初心者协会的成员吗？";
		mes "你看起来不错。";
		next;
		mes "[埃塞雷]";
		mes "你看起来精力充沛……";
		mes "似乎足够强大，可以承受测试。";
		next;
		mes "[埃塞雷]";
		mes "我知道变强的方法。你愿意试试吗？";
		next;
		if(select("不用，我现在很好。:我想变强！") == 1) {
			mes "[埃塞雷]";
			mes "如果你满足于平庸，我帮不了你。";
			mes "那就过普通人的生活吧。";
			close;
		}
		mes "[埃塞雷]";
		mes "很好！";
		mes "初心者世界的一位传奇人物去了海洞，不知在做什么。";
		mes "你应该找到他。";
		next;
		setquest 5092;
		set EXSUPNOV_Q,1;
		mes "[埃塞雷]";
		mes "他会引导你走上";
		mes "正确的道路……";
		close;
	}
	else return;
}

beach_dun2,119,92,4	script	Fishing Novice#sp2	567,{
	if (checkquest(5092) >= 0) {
		mes "[钓鱼初心者]";
		mes "嘘---------！！";
		mes "请安静。";
		mes "会把鱼吓跑的。";
		next;
		select("嗯……打扰一下……");
		mes "[钓鱼初心者]";
		mes "啊啊啊啊！！";
		mes "你在做什么？";
		mes "我说过要安静！";
		mes "鱼都被噪音吓跑了~";
		next;
		mes "[钓鱼初心者]";
		mes "（-- 摇--晃 --）";
		mes "你……是谁？";
		mes "为什么打扰我钓鱼？";
		next;
		select("埃塞雷让我送东西来……");
		emotion ET_SCRATCH;
		mes "[钓鱼初心者]";
		mes "什么？埃塞雷？埃塞雷？";
		mes "嗯！我认识他……";
		mes "埃塞雷……埃塞雷……嗯。";
		next;
		emotion ET_THINK, playerattached();
		emotion ET_THINK;
		mes "..................";
		next;
		emotion ET_SURPRISE;
		mes "[钓鱼初心者]";
		mes "啊啊啊——！！----- 啊啊啊——！！";
		mes "想起来了！——想起来了！";
		mes "^0000FF艾尔帕兰初心者协会的成员。^000000";
		mes "埃塞雷，对吗？还是不对？";
		next;
		if(select("不是他:对，没错") == 2) {
			mes "[钓鱼初心者]";
			mes "呼呼~ 我的直觉还活着……";
			next;
			mes "[钓鱼初心者]";
			mes "那么你想从我这里得到什么？";
		}
		else {
			mes "[钓鱼初心者]";
			mes "什么？！他不是？";
			mes "那埃塞雷来自哪里？";
			next;
			emotion ET_THINK, playerattached();
			emotion ET_THINK;
			mes ".... .... .... ....";
			next;
			mes "[钓鱼初心者]";
			mes "什么---------！！";
			mes "那不重要，对吧？";
			next;
			mes "[钓鱼初心者]";
			mes "那么---------！！";
			mes "你为什么来这里？";
		}
		next;
		mes "- 你解释了来这里的原因。-";
		next;
		emotion ET_SCRATCH;
		mes "[钓鱼初心者]";
		mes "嗯……这是个既简单又困难的问题。";
		next;
		mes "- 你听到一个声音在抱怨什么。-";
		next;
		emotion ET_FRET;
		mes "[钓鱼初心者]";
		mes "埃塞雷！这个%@&$#的家伙毁了我的假期……";
		next;
		mes "[钓鱼初心者]";
		mes "唉~";
		mes "我可怜的人生~";
		mes "啊~ 真是问题重重。";
		next;
		emotion ET_QUESTION;
		mes "[钓鱼初心者]";
		mes "太~难了。嘿，小家伙！";
		mes "你叫什么名字？";
		next;
		select(strcharinfo(0)+"，你呢？");
		mes "[诺多尔]";
		mes "我叫诺多尔！诺多尔。";
		next;
		mes "[诺多尔]";
		mes ".... .... .....";
		next;
		mes "[诺多尔]";
		mes "嘿！我能从你的表情看出你在想什么~";
		next;
		mes "[诺多尔]";
		mes "因为我叫诺多尔，一辈子都被人取笑。";
		mes "秃鹫和臭味……";
		mes "别想骗我。";
		next;
		changequest 5092,5093;
		mes "[诺多尔]";
		mes "不管原因是什么……你来这里了！";
		mes "让我们一起继续前进。";
		mes "过一会儿再来找我~";
		next;
		mes "- 再次和他交谈。-";
		close;
	}
	else if (checkquest(5093) >= 0) {
		mes "[诺多尔]";
		mes "嗯哼-----！！";
		next;
		mes "- 诺多尔用怀疑的眼神看着你。-";
		next;
		mes "[诺多尔]";
		mes "你不知道^0000FF超级初心者^000000很厉害吗？";
		next;
		mes "- 诺多尔自信地问道。-";
		next;
		mes "[诺多尔]";
		mes "嘿！超级初心者~";
		mes "你知道我是谁吗？";
		next;
		select("你在说什么？！");
		mes "[诺多尔]";
		mes "嘿……";
		mes "你胆子真大，是吧？";
		next;
		select("…… …… ……");
		mes "- 这家伙真怪。-";
		next;
		mes "[诺多尔]";
		mes "嘿！超级初心者~";
		mes "我会让你变强！";
		mes "你愿意相信我说的话吗？";
		next;
		if(select("我不跟你走。:为什么不？嘿嘿~") == 1) {
			mes "[诺多尔]";
			mes "拒绝？你不想变强吗？";
			mes "我也很想什么都不做。";
			mes "你要走的话就让我安心钓鱼吧。";
			close;
		}
		mes "[诺多尔]";
		mes "嗯哼~ 我听起来很严厉吗？";
		mes "嗯，我也没办法，总得说这些话。";
		next;
		mes "[诺多尔]";
		mes "别紧张。";
		mes "教你变强对我来说不成问题。";
		next;
		mes "[诺多尔]";
		mes "太好了~！";
		mes "你的问题是什么？";
		mes "你不知道如何变强，对吧？";
		next;
		select("是的，我无法变强。");
		emotion ET_SCRATCH;
		mes "[诺多尔]";
		mes "嗯嗯~！";
		mes "有一种方法……";
		mes "虽然很危险，但我可以";
		mes "告诉你该怎么做。";
		next;
		mes "[诺多尔]";
		mes "我只在一个条件下这么做：你不能问任何问题，而且必须照我说的做！";
		mes "怎么样？";
		mes "你愿意这么做吗？";
		next;
		if(select("不，我不愿意！:就这么做！") == 1) {
			mes "[诺多尔]";
			mes "变强是生存的唯一方式！";
			mes "你想永远当个弱者吗？";
			next;
			mes "[诺多尔]";
			mes "我给你一个提示。";
			mes "你不可能永远正确。";
			mes "有时需要放下自尊，听听别人的意见。";
			emotion ET_FRET;
			close;
		}
		mes "[诺多尔]";
		mes "好---------！！";
		mes "你的热情会让你变强。";
		mes "冷静下来了吗？";
		next;
		mes "[诺多尔]";
		mes "我要你做的是……";
		mes "猎杀 1,000 只魔物。";
		next;
		mes "[诺多尔]";
		mes "你知道这是为了什么吗？";
		next;
		setarray .@Monsters$[0],"波利","疯兔","法布尔","波奇";
		set .@i, rand(4);
		changequest 5093,5094+.@i;
		mes "[诺多尔]";
		mes "你知道^FF0000"+.@Monsters$[.@i]+"^000000是什么魔物，对吧？";
		next;
		mes "[诺多尔]";
		mes "猎杀 1,000 只！";
		mes "别说你做不到！";
		mes "我知道数量很多，但它们很弱！";
		next;
		select("你在开玩笑吗？");
		mes "[诺多尔]";
		mes "呼呼~！";
		mes "记住，不许提问！";
		mes "猎杀满 1,000 只之前不要回来。";
		close;
	}
	else if (checkquest(5094) >= 0 || checkquest(5095) >= 0 || checkquest(5096) >= 0 || checkquest(5097) >= 0) {
		mes "["+strcharinfo(0)+"]";
		mes "嘿，诺多尔！";
		next;
		emotion ET_HUK;
		mes "[诺多尔]";
		mes "天啊！";
		mes "真吓人……让我看看？";
		next;
		if (checkquest(5094,HUNTING) != 2 && checkquest(5095,HUNTING) != 2 && checkquest(5096,HUNTING) != 2 && checkquest(5097,HUNTING) != 2) {
			mes "[诺多尔]";
			mes "嘿！超级初心者！";
			mes "我不是说要猎杀 1,000 只吗？";
			mes "完成之前别回来。";
			close;
		}
		mes "[诺多尔]";
		mes "你已经猎杀完 1,000 只了吗？";
		next;
		mes "[诺多尔]";
		mes "你比我想象中厉害。";
		mes "对了，我让你猎杀的是什么魔物？";
		next;
		set .@i, select("波利:疯兔:法布尔:波奇:巴风特")-1;
		if (.@i == 4) {
			mes "[诺多尔]";
			mes "嘿嘿？你真的能独自猎杀巴风特？";
			mes "别撒谎！！我会打你的！！";
			close;
		}
		if (checkquest(5094+.@i,HUNTING) != 2) {
			mes "[诺多尔]";
			mes "别撒谎！";
			mes "我没让你猎杀这个！";
			close;
		}
		changequest 5094+.@i,5098;
		emotion ET_SMILE;
		mes "[诺多尔]";
		mes "嘿嘿嘿嘿嘿~";
		next;
		mes "[诺多尔]";
		mes "你惹恼了我，所以我才让你做这个任务……";
		next;
		mes "[诺多尔]";
		mes "哇！你真的猎杀了 1,000 只？";
		mes "看来我不能质疑你变强的热情。";
		next;
		mes "[诺多尔]";
		mes "好！到目前为止都不错。";
		mes "我会告诉你如何克服力量上的不足。";
		close;
	}
	else if (checkquest(5098) >= 0) {
		if (rand(10) != 1) {
			mes "[诺多尔]";
			mes "哦！你已经来这里了？";
			mes "你不是说还有事情要处理吗？";
			mes "你有足够的热情，但是……";
			mes "你需要学习耐心。";
			close;
		}
		emotion ET_KIK;
		mes "[诺多尔]";
		mes "呼呼呼呼呼~";
		next;
		mes "[诺多尔]";
		mes "哦，抱歉！抱歉！";
		mes "我很久以前收到弟弟的信，你愿意读读这封信了解情况吗？";
		next;
		if(select("是的，我愿意:不，我不愿意") == 2) {
			mes "[诺多尔]";
			mes "你应该多读书！";
			next;
		}
		else {
			mes "["+strcharinfo(0)+"]";
			mes "啧……好吧……";
			next;
		}
		mes "- 他把一封捆好的信扔给你。-";
		next;
		mes "亲爱的哥哥诺多尔：";
		mes " ";
		mes "哥哥，是你的弟弟努多尔。你过得怎么样？我写这封信是因为……";
		mes "我需要钱买食物。你那么有钱，帮帮我吧。";
		next;
		mes "如果你不帮……记得上次你 %$&*@*&%$……";
		mes "- 信被揉皱了，你无法继续阅读。-";
		mes "我还在施瓦茨瓦尔德共和国。";
		mes "~ 努多尔";
		next;
		mes "- 读完这封信，你感到不安。-";
		next;
		mes "[诺多尔]";
		mes "呼~呜~";
		mes "嗯，我只有一个弟弟，而且他总是在要钱。";
		mes "一定是因为我的名声……T_T";
		next;
		mes "- 现在你真的感到不安了。-";
		next;
		changequest 5098,5099;
		mes "[诺多尔]";
		mes "嘿——超级初心者"+strcharinfo(0)+"！";
		next;
		mes "[诺多尔]";
		mes "你可以给我弟弟一些钱。他在飞艇上。";
		close;
	}
	else if (checkquest(5099) >= 0) {
		mes "[诺多尔]";
		mes "你已经去过了吗？";
		next;
		select("我该给多少钱？");
		mes "[诺多尔]";
		mes "哦，你还没去那里？";
		mes "给他一点钱吧~";
		next;
		mes "[诺多尔]";
		mes "100,000 Zeny 就可以~";
		mes "1,000,000 Zeny 就可以~";
		mes "10,000,000 Zeny 就可以~";
		close;
	}
	else if (checkquest(5100) >= 0) {
		if (EXSUPNOV_Q_ == 3) set .@n,300000;
		else if (EXSUPNOV_Q_ == 4) set .@n,1000000;
		else set .@n,100000;
		mes "[诺多尔]";
		mes "嘿，你去那里了吗？";
		mes "我又收到弟弟的消息了。";
		next;
		mes "哥哥，有人给了我……";
		mes callfunc("F_InsertComma",.@n)+" Zeny.";
		mes "你还是关心我的……";
		mes "~ 努多尔";
		next;
		select("他看起来很饿……");
		mes "[诺多尔]";
		mes "顺便说……";
		mes callfunc("F_InsertComma",.@n)+" Zeny 太少了，考虑到我的名声，你不觉得吗？";
		next;
		select("嗯……");
		mes "[诺多尔]";
		mes "总之~";
		mes callfunc("F_InsertComma",.@n)+" Zeny...";
		mes "你不觉得给得太少了吗？我的名声会受损的。";
		next;
		select("嘿……");
		mes "[诺多尔]";
		mes "哇，你已经明白我的意思了？";
		next;
		mes "[诺多尔]";
		mes "我想你说得对。";
		mes "这项测试考验的是你唤起他人同情心的能力。";
		next;
		mes "[诺多尔]";
		mes "我是说你的消费习惯和你的肚子……";
		mes "哈哈哈哈！";
		next;
		select("嘿，那不是我的……");
		mes "[诺多尔]";
		mes "嗯？啊……";
		mes "我差点忘了告诉你";
		mes "如何突破你的极限，";
		mes "对吧？";
		next;
		mes "[诺多尔]";
		mes "咳咳！我把你派走后可不是在浪费时间！！";
		next;
		emotion ET_HUK;
		mes "[诺多尔]";
		mes "什么？——啊？——！！";
		next;
		select("??????");
		emotion ET_SWEAT;
		mes "[诺多尔]";
		mes "小心！！一群魔像正在追我们！";
		mes "我们……必须逃跑……！！！";
		next;
		emotion ET_HUK, playerattached();
		if(select("什么？！:嗯？") == 2) {
			mes "- 你环顾四周，-";
			mes "- 你身后什么也没有。-";
			mes "- 正当你开始怀疑时……-";
		}
		else {
			mes "- 你惊恐地再次问诺多尔……-";
			mes "- 你惊恐地再次问道……-";
		}
		next;
		if (SkillPoint) {
			mes "[诺多尔]";
			mes "你还有未使用的技能点。";
			mes "在使用这些技能点之前，我无法让你变强。";
			close;
		}
		specialeffect2 EF_LORD;
		specialeffect2 EF_SIGHTRASHER;
		specialeffect2 EF_STORMGUST;
		erasequest 5100;
		mes "[诺多尔]";
		mes "哈哈-------------！！";
		mes "-----呜哈哈哈-----！！";
		mes "------------耶--！！";
		next;
		nude;
		callfunc "F_ClearJobVar"; // -- Clears all job variables for the current player
		jobchange roclass(eaclass()|EAJL_THIRD);
		set EXSUPNOV_Q,5;	
		emotion ET_SMILE;
		mes "[诺多尔]";
		mes "噗哈哈哈哈哈哈哈哈哈哈！！";
		mes "很好！吓到了吗？";
		next;
		select("... ... ...");
		emotion ET_THINK, playerattached();
		emotion ET_SORRY;
		mes "[诺多尔]";
		mes "抱歉吓到你了！";
		mes "我想，初心者的职责和使命就是让每一天都充满欢乐。";
		next;
		mes "[诺多尔]";
		mes "那么，你不觉得刚才有什么改变了吗？";
		mes "感觉身体比以前更轻了吗……？";
		mes "或者更强大了？";
		next;
		select("...? ...? ...?");

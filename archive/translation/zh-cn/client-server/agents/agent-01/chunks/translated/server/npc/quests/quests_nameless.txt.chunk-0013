		mes "如有这些罪犯的任何情报，";
		mes "请向卢恩-米德加尔特王国";
		mes "国家安全办公室";
		mes "报告。";
		next;
		mes "====国家通缉令====";
		mes "^0000ff路易斯·冯·西洛肯斯^000000 - 人类男性";
		mes "^0000ff玛莎·赫蒂赞^000000 - 人类女性";
		mes "^0000ff卡特菲伊^000000 - 宠物猫";
		next;
		mes "====国家通缉令====";
		mes "这些臭名昭著的 Z 帮成员";
		mes "涉嫌盗窃国家宝藏，";
		mes "以及其他罪行。";
		mes "诈骗、伪造，";
		mes "并传播各种";
		mes "堕落与不道德行为。";
		next;
		mes "====国家通缉令====";
		mes "抓获上述罪犯的人";
		mes "将获得";
		mes "《禁忌之谜》一书，";
		mes "这是王国的宝藏之一。";
		mes "它是王国的宝藏。";

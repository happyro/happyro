			close;
		}
	}
	mes "[沃拉]";
	mes "食物会对你的身体产生";
	mes "巨大的影响：";
	mes "把它当作药物一样看待，";
	mes "注意自己吃了什么。哦，";
	mes "还要做好调查！";
	next;
	mes "[沃拉]";
	mes "你知道吗，生活方式";
	mes "和习惯决定了";
	mes "你未来的健康。";
	mes "照顾好自己！";
	close;

OnTouch:
	if (diamond_edq == 17) {
		mes "[沃拉]";
		mes "哦，怎么会";
		mes "这样？";
		mes "我该怎么办？";
		set diamond_edq,18;
		close;
	}
	end;
}

in_rogue,366,46,3	script	Rogue Investigator	828,{
	if ((diamond_edq == 22) && (BaseJob == Job_Rogue)) {
		mes "[调查员]";
		mes "哦，还记得我吗？";
		mes "已经过去很久了，";
		mes "你不记得也不能怪你：";
		mes "你刚加入我们公会时，";
		mes "我就在现场！";
		mes "是什么风把你吹来了？";
		next;
		select("询问 Z 帮的事");
		mes "[调查员]";
		mes "啊，你说的是 Z 帮？";
		next;
		mes "[调查员]";
		mes "哦，我们正在调查那群人。";
		mes "其实我们找到了";
		mes "他们的藏身处，";
		mes "但还没来得及抓住他们，";
		mes "他们就逃走了。真狡猾……";
		mes "我觉得他们提前收到了风声！";
		next;
		mes "[调查员]";
		mes "我们有几名流氓公会成员";
		mes "正在调查那个藏身处，";
		mes "但我怀疑他们找不到";
		mes "任何有用的东西。";
		next;
		select("藏身处在哪里？");
		mes "[调查员]";
		mes "那是科莫多的一座";
		mes "大型仓库。";
		mes "如果你真的想去，";
		mes "可以随意调查那里。";
		mes "但找到任何东西的机会";
		mes "非常渺茫。";
		close;
	}
	else if ((diamond_edq == 22) && (BaseClass == Job_Thief)) {
		mes "[调查员]";
		mes "嘿，最近怎么样？";
		mes "你有没有考虑过";
		mes "加入";
		mes "流氓公会？会很有趣的。";
		mes "你可以随便看看，";
		mes "有问题尽管问我。";
		next;
		select("询问 Z 帮的事");
		mes "[调查员]";
		mes "哦，我们正在调查那群人。";
		mes "其实我们找到了他们的";
		mes "藏身处，";
		mes "但还没来得及抓住他们，";
		mes "他们就逃走了。真狡猾……";
		mes "我觉得他们提前收到了风声！";
		next;
		mes "[调查员]";
		mes "我们有几名流氓公会成员";
		mes "正在调查那个藏身处，";
		mes "但我怀疑他们找不到";
		mes "任何有用的东西。";
		next;
		select("藏身处在哪里？");
		mes "[调查员]";
		mes "嗯，我不确定能否直接告诉你";
		mes "这种信息。";
		mes "我的意思是，";
		mes "你还不是我们公会的成员……";
		mes "不过还不是。你想做什么？";
		next;
		mes "[调查员]";
		mes "我知道了。";
		mes "我就告诉老板，";
		mes "你用 10,000 Zeny 贿赂了我。";
		mes "不算太多，对吧？我们流氓公会";
		mes "虽然不太正派……但也没那么糟。";
		next;
		switch(select("Sounds good!:Never mind, I'll find it myself...")) {
		case 1:
			if (Zeny > 9999) {
				set Zeny, Zeny-10000;
		mes "[调查员]";
		mes "谢谢你的钱～";
		mes "多谢。";
				mes "当然，如果你成为流氓，";
				mes "这点钱和你能偷到的东西相比";
				mes "根本算不了什么。^666666*咳咳*^000000";
				next;
		mes "[调查员]";
		mes "Z 帮以前的藏身处";
		mes "是";
				mes "科莫多的一座大仓库。";
				mes "我不觉得你能在那里找到什么，";
				mes "但你可以去看看。";
				changequest 3115,3116;
				set diamond_edq,23;
				close;
			}
			else {
		mes "[调查员]";
		mes "唉，要是老板要求查看";
		mes "钱，";
				mes "我该怎么办？我们得让这次";
				mes "贿赂看起来真实才行！";
				close;
			}
		case 2:
		mes "[调查员]";
		mes "请自便，";
		mes "也许这会是很好的学习经历。";
		mes "不过，如果你考虑换职业，";
		mes "记得回来，好吗？";
		mes "成为流氓吧～";
			close;
		}
	}
	else if (diamond_edq == 22) {
		mes "[调查员]";
		mes "哇，你在这里做什么？";
		mes "我和你没什么过节，";
		mes "不过有些流氓公会成员，";
		mes "嗯，他们对你意见很大。";
		mes "呃，你想要什么？";
		mes "希望不是来打架的。";
		next;
		select("询问 Z 帮的事");
		mes "[调查员]";
		mes "那群人一直在";
		mes "骚扰所有人！";
		mes "没错，可以说我们";
		mes "在这件事上团结一致。";
		next;
		mes "[调查员]";
		mes "哦，我们正在调查那群人。";
		mes "其实我们找到了";
		mes "他们的藏身处，";
		mes "但还没来得及抓住他们，";
		mes "他们就逃走了。真狡猾……";
		mes "我觉得他们提前收到了风声！";
		next;
		mes "[调查员]";
		mes "我们有几名流氓公会成员";
		mes "正在调查那个藏身处，";
		mes "但我怀疑他们找不到";
		mes "任何有用的东西。";
		next;
		select("藏身处在哪里？");
		mes "[调查员]";
		mes "呃，如果你不是";
		mes "我们公会的成员，";
		mes "我不能直接告诉你这个信息。";
		mes "不过既然我们";
		mes "目标一致，";
		mes "我就收你 10,000 Zeny。";
		next;
		switch(select("听起来不错！:算了……")) {
		case 1:
			if (Zeny > 9999) {
				set Zeny, Zeny-10000;
		mes "[调查员]";
		mes "好，好。";
		mes "我没收你太多钱，";
		mes "毕竟藏身处";
				mes "只是科莫多的一座大仓库，";
				mes "我也不觉得你能找到什么。";
				mes "不过，谁知道呢？";
				changequest 3115,3116;
				set diamond_edq,23;
				close;
			}
			else {
				mes "[调查员]";
				mes "喂，这点钱不够。";
				mes "我还以为你们这种职业的人";
				mes "每天赚的 Zeny";
				mes "都比这多呢！";
				close;
			}
		case 2:
		mes "[调查员]";
		mes "好吧，不过我觉得你需要";
		mes "一点额外帮助";
		mes "才能找到那个地方。";
			mes "我的意思是，流氓公会可是";
			mes "隐藏专家，连我们找起来";
			mes "都有些困难！";
			close;
		}
	}
	mes "[调查员]";
	mes "唉，我好困……";
	mes "大家都出去执行任务了，";
	mes "只有我被困在这里站岗。";
	mes "我什么时候才能再次行动？";
	mes "唉！流氓公会最讨厌";
	mes "站在同一个地方不动了！";
	close;
}

cmd_in02,94,208,5	script	Investigator	828,{
	if ((diamond_edq == 22) || (diamond_edq == 23)) {
		if (BaseJob == Job_Rogue) {
			mes "[调查员]";
			mes "嘿，朋友。";
			mes "你是公会成员？";
			mes "不错。";
			mes "如果他们派你来帮忙，";
			mes "那你没什么可做的了。";
			mes "这里基本已经被搜空。";
			close;
		}
		else {
			mes "[调查员]";
			mes "你想做什么？";
			mes "哦，你的公会一定是";
			mes "派你来帮忙的。";
			mes "是的，我们调查过了。";
			mes "什么也没找到。";
			mes "Z 帮早就逃之夭夭了。";
			next;
			mes "[调查员]";
			mes "你可以随便看看，";
			mes "但要问我的意见，";
			mes "这只是浪费时间。";
			close;
		}
	}
	else {
		mes "[调查员]";
		mes "唉，我得一直待在这里，";
		mes "直到收到";
		mes "公会的新命令。";
		mes "他们不会……不会";
		mes "把我忘了吧？";
		close;
	}
}

cmd_in02,69,188,1	script	Small Safe	844,{
	if ((diamond_edq == 22) || (diamond_edq == 23)) {
		mes "^3355FF这些箱子的阴影下";
		mes "藏着一个小";
		mes "保险箱。^000000";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "看来 Z 帮逃跑得太匆忙，";
		mes "忘了把它带走。";
		mes "他们逃得太快了。";
		mes "嗯……我要怎么打开它？";
		mes "有没有钥匙、开关，";
		mes "或者其他我能用的东西？";
		hideoffnpc "Odd Switch#Switch1";
		close;
	}
	if (diamond_edq == 24) {
		mes "[" + strcharinfo(0) + "]";
		mes "嘿，保险箱打开了！";
		mes "一定是那些开关起了作用。";
		mes "现在……";
		mes "看看里面有什么。";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "太棒了！是一颗巨大的";
		mes "红色钻石！这是";
		mes "易卜拉欣的";
		mes "毁灭之钻吗？";
		next;
		getitem 7723,1; //Diamond_Of_Ruin
		mes "[调查员]";
		mes "呼……呼……";
		next;
		mes "[" + strcharinfo(0) + "]";
		mes "幸好这家伙睡着了。";
		mes "我最好悄悄离开这里，";
		mes "尽快把这颗";
		mes "大钻石";
		mes "还给易卜拉欣。";
		changequest 3117,3118;
		set diamond_edq,25;
		close;
	}
	if ((diamond_edq < 22) && (diamond_edq > 24)) {
		mes "[" + strcharinfo(0) + "]";
		mes "这里原本有东西固定在地面上，";
		mes "但现在看起来像是被";
		mes "什么东西";
		mes "强行拔走了。真奇怪。";
		close;
	}
	mes "[" + strcharinfo(0) + "]";
	mes "这是什么？";
	mes "算了，";
	mes "我想应该不重要。";
	close;
}


lou_in02,248,166,2	script	Tool Shop Master#lou	824,{
	if (ch_par < 2) {
		mes "[王翠仪]";
		mes "我的生意最近不太顺利。";
		mes "而且这天气到底怎么回事？我真不知道世界发生了什么……";
		close;
	}
	else if (ch_par == 2) {
		mes "[王翠仪]";
		mes "真该死！";
		mes "我讨厌这";
		mes "天气……！";
		next;
		mes "[王翠仪]";
		mes "嗯？有什么";
		mes "我能帮你的吗？";
		emotion ET_QUESTION;
		next;
		if (select("我是来替医生取东西的……:没错，这天气确实很糟。") == 1) {
			mes "[王翠仪]";
			mes "嗯？";
			mes "替医生跑腿？";
			mes "她一定又把";
			mes "药用完了。";
			mes "去仓库看看吧。";
			next;
			mes "[王翠仪]";
			mes "仓库就在这栋建筑的另一边。";
			mes "你会看到一个叫江夏友的人，去向他索要你需要的东西吧。";
			set ch_par,3;
			changequest 11044,11045;
			close;
		}
		mes "[王翠仪]";
		mes "可不是嘛。这天气一直让我压力很大。";
		mes "照这样被天气折腾下去，";
		mes "我觉得自己活不了多久了……";
		close;
	}
	else if (ch_par == 3) {
		mes "[王翠仪]";
		mes "我不明白外地人为什么不顾天气，仍要来洛阳。";
		mes "我也厌倦了在这里经营生意。迟早有一天，";
		close;
	}
	else if (ch_par == 4) {
		mes "我可能得离开。";
		mes "[王翠仪]";
		close;
	}
	else if (ch_par < 10) {
		mes "什么？他没给你需要的东西？";
		mes "嗯，我猜你做了他不喜欢的事。那样的话我也帮不了你。";
		mes "[Wang Chuiyi]";
		close;
	}
	else {
		mes "我不明白外地人为什么不顾天气，仍要来洛阳。";
		mes "我也厌倦了在这里经营生意。迟早有一天，我可能得离开。";
		close;
	}
}

lou_in02,201,166,4	script	Storage Keeper#lou	819,{
	if ((MaxWeight-Weight) < 2000 || checkweight(1201,1) == 0) {
		mes "[Wang Chuiyi]";
		mes "天啊，这天气到底怎么回事？！真希望云神带来雨季，但看来不太可能。";
		close;
	}
	if (ch_par < 3) {
		mes "^3355FF * 请稍等！！ *";
		mes "你目前超重，无法再将物品放入物品栏。请把一些物品存入卡普拉仓库后再试。^000000";
		mes "[江夏友]";
		mes "^666666*哈欠……*^000000";
		close;
	}
	else if (ch_par == 3) {
		mes "真无聊……";
		mes "无聊得离谱。我不想再浪费时间了，还有重要的事要做……";
		mes "[江夏友]";
		mes "嗯？";
		next;
		switch(select("抱歉。:天气很热，对吧？:我是来替医生办事的。")) {
		case 1:
			mes "什么，你来这里做什么？";
			mes "不需要东西的话就赶紧走。";
			mes "[Jiang Xiayou]";
			close;
		case 2:
			mes "没错！";
			mes "这么热的天气别来烦我！现在走开。没看见我正忙着吗！";
			mes "[江夏友]";
			mes "……";
			mes "你不用问我。";
			mes "我自己就能感受到！现在我有";
			mes "一堆事情要处理";
			close;
		case 3:
			mes "，别再烦我了。";
			mes "该死，真热！";
			mes "[江夏友]";
			mes "……";
			mes "哦，是吗？";
			next;
			emotion ET_SURPRISE;
			next;
			mes "那你怎么不早说？让我看看。";
			mes "嗯……";
			mes "[Jiang Xiayou]";
			mes "其实，你能先帮我个忙吗？";
			next;
			if (select("嗯，是什么事？:抱歉，我很忙。") == 1) {
				mes "别担心，不难，但对我很重要。你帮完后，我就";
				mes "把你需要的东西给你。";
				mes "[Jiang Xiayou]";
				mes "太好了，谢谢";
				next;
				mes "。我得去市政厅取一些官方文件，";
				mes "但没人能替我的班，所以我不能离开仓库。";
				mes "[Jiang Xiayou]";
				next;
				mes "所以我想请你替我去市政厅取文件。";
				mes "我想不会花你太多时间。";
				mes "[Jiang Xiayou]";
				next;
				mes "从这里向东走，";
				mes "找一栋看起来像量规形状的建筑，那就是市政厅。";
				next;
				mes "[Jiang Xiayou]";
				mes "我不明白政府为什么要花这么多钱建那栋楼，不过，希望你能帮我。";
				mes "[Jiang Xiayou]";
				next;
				mes "哦，我差点忘了。";
				mes "你必须申请特定类型的文件，我现在告诉你。";
				mes "[Jiang Xiayou]";
				set .@paper_j,rand(10,13);
				if (.@paper_j == 10) {
					mes "这很重要，";
					set ch_par,5;
					changequest 11045,11046;
				}
				else if (.@paper_j == 11) {
					mes "所以别忘了这件事。";
					set ch_par,6;
					changequest 11045,11047;
				}
				else if (.@paper_j == 12) {
					mes "那个人问你需要什么时，就告诉他：‘^ff0000居住转移申请^000000。’就这样。";
					set ch_par,7;
					changequest 11045,11048;
				}
				else if (.@paper_j == 13) {
					mes "那个人问你需要什么时，就告诉他：‘^ff0000暑期课程申请^000000。’明白了吗？";
					set ch_par,8;
					changequest 11045,11049;
				}
				next;
				mes "那个人问你需要什么时，就告诉他：‘^ff0000沙尘现象报告^000000。’很简单吧？";
				mes "那个人问你需要什么时，就告诉他：‘^ff0000通信提案^000000。’就这样。";
				mes "[Jiang Xiayou]";
				close;
			}
			mes "如果你不说清楚需要的文件，";
			mes "他们什么也不会给你。所以要小心，别忘了！";
			mes "[Jiang Xiayou]";
			next;
			mes "呸~！";
			mes "那就算了！";
			emotion ET_HNG;
			set ch_par,4;
			changequest 11045,11050;
			close;
		}
	}
	else if (ch_par == 4) {
		mes "[Jiang Xiayou]";
		mes "你找的药可能就在附近，自己找找吧。要不是看在医生的份上，我根本不会让你在这里闲逛，知道吗？";
		mes "[Jiang Xiayou]";
		close;
	}
	else if (ch_par < 9) {
		mes "哈……";
		mes "抱歉，朋友，你得自己找药。有人命危在旦夕，所以你最好赶快行动。";
		mes "[Jiang Xiayou]";
		mes "嗯？";
		mes "你还没去";
		next;
		mes "市政厅吗？";
		mes "真是个懒鬼。";
		next;
		mes "[Jiang Xiayou]";
		mes "你不该赶紧把药送给医生吗？这可是人命关天，对你来说这意味着什么？";
		mes "[Jiang Xiayou]";
		mes "我猜你是那种";
		mes "健忘的人……";
		if (ch_par == 5) {
			mes "那个人问你需要什么时，";
		}
		else if (ch_par == 6) {
			mes "你就告诉他：";
		}
		else if (ch_par == 7) {
			mes "‘^ff0000居住转移申请^000000。’";
		}
		else if (ch_par == 8) {
			mes "‘^ff0000暑期课程申请^000000。’";
		}
		next;
		mes "‘^ff0000沙尘现象报告^000000’。";
		mes "‘^ff0000通信提案^000000。’";
		mes "[Jiang Xiayou]";
		close;
	}
	else if (ch_par == 9) {
		mes "就这样。";
		mes "现在去吧，小老虎。";
		mes "[Jiang Xiayou]";
		mes "嗯……";
		mes "你真幸运。";
		mes "好吧，去吧。";
		close;
	}
	else if (ch_par == 10) {
		mes "不过，事情已经";
		mes "变复杂了……";
		mes "[Jiang Xiayou]";
		next;
		mes "^666666*哈欠~*^000000 真希望";
		mes "等天气好转吧。唉，我干吗又想到炎热？现在心情全变差了……";
		mes "[江夏友]";
		mes "……";
		close;
	}
	else if (ch_par < 15) {
		mes "嗯，我想我应该";
		mes "尽快处理这些事情……";
		mes "[Jiang Xiayou]";
		next;
		mes "嗯？";
		mes "你还没去市政厅吗？真是个懒鬼。";
		next;
		mes "[Jiang Xiayou]";
		mes "如果我是你，我会赶快把药送给医生。这里可是人命关天，这对你总该有点意义吧！";
		mes "[Jiang Xiayou]";
		mes "我猜你是那种";
		mes "健忘的人……";
		if (ch_par == 11) {
			mes "那个人问你需要什么时，";
		}
		else if (ch_par == 12) {
			mes "你就告诉他：";
		}
		else if (ch_par == 13) {
			mes "‘^ff0000居住转移申请^000000。’";
		}
		else if (ch_par == 14) {
			mes "‘^ff0000暑期课程申请^000000。’";
		}
		next;
		mes "‘^ff0000沙尘现象报告^000000。’";
		mes "‘^ff0000通信提案^000000。’";
		mes "[Jiang Xiayou]";
		close;
	}
	else if (ch_par == 15) {
		mes "就这样。";
		mes "现在去吧，小老虎。";
		mes "[Jiang Xiayou]";
		mes "你终于带来了！哈哈，";
		mes "我也刚好拿到了你需要的一切。让我看看……";
		next;
		mes "没错，就是这个！";
		mes "很好，很好……";
		next;
		select("打扰一下。");
		mes "^3355FF*翻找翻找*";
		mes "......^000000";
		mes "[Jiang Xiayou]";
		mes "嗯？";
		mes "啊……";
		mes "哈哈……";
		next;
		mes "抱歉啊。";
		mes "哈哈哈~";
		mes "[Jiang Xiayou]";
		set ch_par,16;
		changequest 11055,11056;
		getitem 7252,1; //Herb_Medicine
		close;
	}
	mes "啊！给你。虽然做起来有点麻烦，";
	mes "但我们总得互相帮助，对吧？好了，回头见。";
	mes "[Jiang Xiayou]";
	next;
	mes "^666666*哈欠~*^000000 真希望";
	mes "等天气好转吧。唉，我干吗又想到炎热？现在心情全变差了……";
	mes "[江夏友]";
	mes "……";
	close;
}

lou_in02,210,47,0	script	City Hall Officer#lou	825,{
	if (ch_par < 5) {
		mes "嗯，我想我应该";
		mes "尽快处理这些事情……";
		mes "[Jin Chiyuan]";
		mes "^666666*哈欠~*^000000";
		next;
		mes "天啊，这炎热的天气真让人难受。";
		mes "哦？你看起来像游客。住得还愉快吗？";
		mes "[Jin Chiyuan]";
		close;
	}
	else if (ch_par < 9) {
		mes "虽然最近天气不好，但洛阳有许多值得游览的地方。";
		mes "希望你玩得开心。";
		mes "[Jin Chiyuan]";
		next;
		if (select("我需要一份文件。:我只是顺路来看看。") == 1) {
			mes "嗯？米德加尔特人？";
			mes "我能为你做什么？";
			mes "[Jin Chiyuan]";
			mes "啊，你确实需要吗？";
			next;
			mes "很遗憾，现在有很多人在排队申请政府表格，";
			mes "处理你的请求需要一些时间。";
			mes "[Jin Chiyuan]";
			next;
			if (select("嗯？再说一遍？:给点 Zeny 就能走后门，是吧？") == 1) {
				mes "^333333*低声耳语*";
				mes "嗯，有一种方法可以……加快处理你的请求……^000000";
				mes "[Jin Chiyuan]";
				close;
			}
			input .@input;
			if (.@input < 10000) {
				mes "^666666*咳！*^000000 没什么。";
				mes "没什么重要的事。现在我很忙，请去那边填写申请……";
				mes "[Jin Chiyuan]";
				mes "天啊，";
				mes "你在想什么？";
				mes "我是什么，乞丐吗？！";
				next;
				mes "这算什么蹩脚的";
				mes "贿赂借口！";
				mes "[Jin Chiyuan]";
				emotion ET_HNG;
				close;
			}
			else {
				if (Zeny > .@input) {
					mes "我的意思是……";
					mes "你竟敢贿赂执法人员！希望其他外地人不会像你一样！请立即离开！";
					mes "[Jin Chiyuan]";
					mes "什么……？！";
					next;
					mes "我不是这个意思，";
					mes "不过既然你坚持要向政府捐款……";
					mes "[Jin Chiyuan]";
					set Zeny, Zeny-.@input;
					if (ch_par == 5) {
						set ch_par,11;
						changequest 11046,11051;
					}
					else if (ch_par == 6) {
						set ch_par,12;
						changequest 11047,11052;
					}
					else if (ch_par == 7) {
						set ch_par,13;
						changequest 11048,11053;
					}
					else if (ch_par == 8) {
						set ch_par,14;
						changequest 11049,11054;
					}
					close;
				}
				else {
					mes "^666666*低声耳语*^000000";
					mes "^333333上楼后，另一位官员会把你想要的文件交给你。^000000 ^666666*咳^000000 洛阳感谢你！";
					next;
					mes "[Jin Chiyuan]";
					mes "天啊，你在想什么？我是什么，乞丐吗？！这算什么蹩脚的贿赂借口！";
					mes "[Jin Chiyuan]";
					emotion ET_HNG;
					close;
				}
			}
		}
		mes "我的意思是……";
		mes "你竟敢贿赂执法人员！希望其他外地人不会像你一样！请立即离开！";
		mes "[Jin Chiyuan]";
		mes "唉……";
		next;
		mes "现在不是游客游览的好时机。希望你不要误入";
		mes "不该去的地方。";
		mes "[Jin Chiyuan]";
		mes "坦白说，";
		close;
	}
	else if (ch_par == 9) {
		mes "现在这种环境对好奇心很危险。请务必";
		mes "小心。";
		mes "[Jin Chiyuan]";
		mes "唉……";
		next;
		mes "现在不是游客游览的好时机。希望你不要误入";
		mes "不该去的地方。";
		mes "[Jin Chiyuan]";
		mes "坦白说，";
		close;
	}
	else if (ch_par == 10) {
		mes "现在这种环境对好奇心很危险。请务必";
		mes "小心。";
		mes "[Jin Chiyuan]";
		mes "唉……";
		next;
		mes "现在不是游客游览的好时机。希望你不要误入";
		mes "不该去的地方。";
		mes "[Jin Chiyuan]";
		mes "坦白说，";
		close;
	}
	else if (ch_par < 15) {
		mes "现在这种环境对好奇心很危险。请务必";
		mes "小心。";
		next;
		mes "[Jin Chiyuan]";
		mes "你还没见到我提过的那位官员吗？我已经联系过他了，你可以去楼上见他。";
		mes "[Jin Chiyuan]";
		mes "哈哈哈哈……";
	}
	else if (ch_par == 15) {
		mes "保重，";
		mes "米德加尔特人。";
		mes "[Jin Chiyuan]";
		mes "啊~";
		mes "你见到他了，";
		mes "对吧？";
		mes "哈哈哈……";
		emotion ET_SMILE;
		close;
	}
	mes "祝你在洛阳";
	mes "玩得愉快！";
	mes "[Jin Chiyuan]";
	next;
	mes "欢迎。";
	mes "我能为你做什么？";
	mes "[Jin Chiyuan]";
	emotion ET_HNG;
	close;
}


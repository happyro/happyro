moc_fild17,208,346,5	script	Shone#Hode_Hunt	707,{
	if (checkquest(60104) != -1) {
		if (checkquest(60104,HUNTING) != 2 ) {
			mes "[肖恩]";
			mes "你完成猎杀 50 只霍德了吗？";
			next;
			switch(select("是:否:我想放弃")) {
			case 1:
				mes "[肖恩]";
				mes "嗯，我不认为你已经猎杀了 50 只……";
				close;
			case 2:
				mes "[肖恩]";
				mes "记住，我需要帮助猎杀霍德，请去猎杀 50 只。";
				close;
			case 3:
				mes "[肖恩]";
				mes "确定要停止猎杀吗？";
				mes "你取得的所有进度都会被删除";
				next;
				switch(select("是:否")) {
				case 1:
					mes "[肖恩]";
					mes "好吧，改变主意后再回来。";
					erasequest 60104;
					close;
				case 2:
					mes "[肖恩]";
					mes "请猎杀 50 Hodes.";
					close;
				}
			}
		}
		else {
			mes "[肖恩]";
			mes "真棒，你完成得很快。";
			getexp 15775,1125;
			erasequest 60104;
			close;
		}
	}
	if (checkquest(60105) != -1) {
		if (checkquest(60105,HUNTING) != 2 ) {
			mes "[肖恩]";
			mes "你完成猎杀 50 只霍德了吗？";
			next;
			switch(select("是:否:我想放弃")) {
			case 1:
				mes "[肖恩]";
				mes "嗯，我不认为你已经猎杀了 100 只……";
				close;
			case 2:
				mes "[肖恩]";
				mes "记住，我需要帮助猎杀霍德，请去猎杀 100 只。";
				close;
			case 3:
				mes "[肖恩]";
				mes "确定要停止猎杀吗？";
				mes "你取得的所有进度都会被删除";
				next;
				switch(select("是:否")) {
				case 1:
					mes "[肖恩]";
					mes "好吧，改变主意后再回来。";
					erasequest 60105;
					close;
				case 2:
					mes "[肖恩]";
					mes "请猎杀 100 Hodes.";
					close;
				}
			}
		}
		else {
			mes "[肖恩]";
			mes "真棒，你完成得很快。";
			getexp 15775,1125;
			getexp 15775,1125;
			erasequest 60105;
			close;
		}
	}
	if (checkquest(60106) != -1) {
		if (checkquest(60106,HUNTING) != 2 ) {
			mes "[肖恩]";
			mes "你完成猎杀 150 只霍德了吗？";
			next;
			switch(select("是:否:我想放弃")) {
			case 1:
				mes "[肖恩]";
				mes "嗯，我不认为你已经猎杀了 150 只……";
				close;
			case 2:
				mes "[肖恩]";
				mes "记住，我需要帮助猎杀霍德，请去猎杀 150 只。";
				close;
			case 3:
				mes "[肖恩]";
				mes "确定要停止猎杀吗？";
				mes "你取得的所有进度都会被删除";
				next;
				switch(select("是:否")) {
				case 1:
					mes "[肖恩]";
					mes "好吧，改变主意后再回来。";
					erasequest 60106;
					close;
				case 2:
					mes "[肖恩]";
					mes "请猎杀 150 Hodes.";
					close;
				}
			}
		}
		else {
			mes "[肖恩]";
			mes "真棒，你完成得很快。";
			getexp 15775,1125;
			getexp 15775,1125;
			getexp 15775,1125;
			erasequest 60106;
			close;
		}
	}
	//for minimum level
	if (BaseLevel > 24) {
		//for maximum level
		if (BaseLevel < 61) {
			mes "[肖恩]";
			mes "等等！你能看到我？";
			mes "好吧，我还没完全掌握自己的技能。";
			next;
			mes "[肖恩]";
			mes "嘿，你能帮帮我吗？";
			next;
			switch(select("好的:不了")) {
			case 1:
				mes "[肖恩]";
				mes "多谢你，朋友！";
				next;
				switch(select("收集物品:猎杀沙漠之狼:取消")) {
				case 1:
					// Item turn in
					mes "[肖恩]";
					mes "我想收集 ^00CE0025蚯蚓皮^000000。";
					mes "如果你帮忙，我会给你奖励。";
					next;
					switch(select("我有 25 个蚯蚓皮:你刚才说什么来着？")) {
					case 1:
						/*
						if (checkweight(502,10) == 0) {
							mes "[肖恩]";
						mes "嘿，看起来你背上的重量快把你压垮了。";
						mes "减轻一些负重后再回来吧。";
						mes "";
							close;
						}
						*/
						if (countitem(1055) > 24) {
							mes "谢谢你的 25 个蚯蚓";
							mes "皮！";
							mes "这是我承诺的奖励，希望你能把我传授的智慧带给其他人。";
							delitem 1055,25; //Earthworm_Peeling
							getexp 15775,1125;
							//getitem 502,10; //Orange_Potion
							close;
						}
						else {
							mes "[肖恩]";
							mes "我没看到任何 ^00CE00蚯蚓皮^000000。";
							mes "你想骗我吗？";
							close;
						}
					case 2:
						mes "[肖恩]";
						mes "我需要 ^00CE0025蚯蚓皮^000000。";
						close;
					}
				case 2:
					// Kill Count Quest
					mes "[肖恩]";
					mes "啊，好。我想你可以通过猎杀沙漠之狼来帮我。";
					mes "你想猎杀多少只？";
					next;
					switch(select("50 只沙漠之狼:100 只沙漠之狼:150 只沙漠之狼")) {
					case 1:
						mes "[肖恩]";
						mes "完成任务后回来，我会给你一份小奖励。";
						setquest 60104;
						close;
					case 2:
						mes "[肖恩]";
						mes "完成任务后回来，我会给你一份小奖励。";
						setquest 60105;
						close;
					case 3:
						mes "[肖恩]";
						mes "完成任务后回来，我会给你一份小奖励。";
						setquest 60106;
						close;
					}
				case 3:
					mes "[肖恩]";
					mes "如果你改变主意，请再回来。";
					close;
				}
			case 2:
				mes "[肖恩]";
				mes "如果你改变主意，请再回来。";
				close;
			}
		}
		else {
			mes "[肖恩]";
			mes "你太强了，不该再和这些东西战斗！";
			close;
		}
	}
	else {
		mes "[肖恩]";
		mes "你需要一些帮助，但我无法为你提供。";
		mes "等你变得更强、积累更多智慧后再回来。";
		close;
	}
}

			break;
		case 2:
		mes "[喵喵勇气队队长]";
			mes "ChamChamCham 玩家其实在抱怨练习，因为你和他们配合得太好，很难记住谁是赢家。嘿嘿~";
			break;
		case 3:
		mes "[喵喵勇气队队长]";
			mes "嘿嘿~KongNyangKong 玩家非常享受练习。嘿嘿~";
			break;
		case 4:
		mes "[喵喵勇气队队长]";
			mes "嘿嘿~旗帜游戏玩家总是很紧张，因为你让他们练习很多。嘿嘿~不过他们确实进步了。";
			break;
		}
		next;
		mes "[喵喵勇气队队长]";
		mes "嘿嘿~请继续努力，"+strcharinfo(0)+"。嘿嘿~";
		close;
	case 2:
		mes "[喵喵勇气队队长]";
		mes "嘿嘿~你好呀~"+strcharinfo(0)+"。你真有礼貌~嘿嘿~";
		next;
		mes "[喵喵勇气队队长]";
		mes "嘿嘿~最近有很多猫和人类都没有基本礼貌。嘿嘿~";
		next;
		mes "[喵喵勇气队队长]";
		mes "我们的‘猫咪玩家’里也有这样的人。每次我们赢得比赛，他们都很傲慢……嘿嘿~";
		next;
		mes "[喵喵勇气队队长]";
		mes "嘿嘿~应该多一些像你这样的人，"+strcharinfo(0)+"。嘿嘿~";
		next;
		mes "[喵喵勇气队队长]";
		mes "嘿嘿~请多和我们的玩家练习~嘿嘿~这样他们就能向你学习礼貌，"+strcharinfo(0)+"。嘿嘿~";
		next;
		mes "[喵喵勇气队队长]";
		mes "继续努力~嘿嘿~";
		close;
	case 3:
		mes "[喵喵勇气队队长]";
		mes "嘿嘿~你的脸怎么了，"+strcharinfo(0)+"？练习时输了吧？嘿嘿~";
		emotion ET_KIK;
		next;
		mes "[喵喵勇气队队长]";
		mes "嘿嘿~我看到玩家们把纸条放进了‘请愿箱’。嘿嘿~那应该是你的工作吧。让我看看……";
		next;
		break;
	}

	// Detect quest (ID range 5074~5090)
		mes "[喵喵勇气队队长]";
	if (checkquest(5074,HUNTING) > -1) {
		mes "嘿嘿~我也不是没好好喂它们……嘿嘿~希望这对你来说不算太难，"+strcharinfo(0)+"。";
		next;
		if (checkquest(5074,HUNTING) == 2 && countitem(1023) >= 10) {
			delitem 1023,10; //Fish_Tail
			callsub L_CompleteQuest,5074,
				"Heh~ So, you brought 30 Phens and 10 Fish Tails, just as ordered.";
		} else {
		mes "[喵喵勇气队队长]";
				mes "嘿嘿~纸条上说要带来 30 只菲恩和 10 个鱼尾。嘿嘿~也许你捕捉的菲恩不够，或忘了鱼尾？嘿嘿~";
			close;
		}
	} else if (checkquest(5075,HUNTING) > -1) {
		mes "嘿嘿~嗯，50 只马尔斯和 30 瓶牛奶……嘿嘿~";
		next;
		if (checkquest(5075,HUNTING) == 2 && countitem(519) >= 30) {
			delitem 519,30; //Milk
			callsub L_CompleteQuest,5075,
				"Heh~ Guess they wanted some healthy food. Heh~ They should have just told me... Let me show you my skills. Heh~";
		} else {
		mes "[喵喵勇气队队长]";
			mes "嘿嘿~但是 50 只马尔斯和 30 瓶牛奶在哪里？嘿嘿~请确认你没有漏掉它们……";
			close;
		}
	} else if (checkquest(5076,HUNTING) > -1) {
		mes "嘿嘿~我们的队伍一定和‘狗狗华尔兹’队有仇，才会请你帮这种忙……";
		next;
		if (checkquest(5076,HUNTING) == 2) {
			callsub L_CompleteQuest,5076,
				"Heh~ So you have finished harassing 30 Kobold Archers as noted. Heh~ Outstanding.";
		} else {
		mes "[喵喵勇气队队长]";
			mes "嘿嘿~纸条上说要骚扰 30 只狗头人弓箭手。嘿嘿~请确认你已经骚扰了 30 只。";
			close;
		}
	} else if (checkquest(5077,HUNTING) > -1) {
		mes "嘿嘿~啊，敏捷训练。看到我们的玩家努力训练真不错。";
		mes "嘿嘿~是的，没有什么比捉老鼠更能提升敏捷了。";
		next;
		if (checkquest(5077,HUNTING) == 2) {
			callsub L_CompleteQuest,5077,
				"Heh~ Oh, you got some fresh and chubby Cramps. Heh~ Great.";
		} else {
		mes "[喵喵勇气队队长]";
			mes "嘿？你答应的 10 只痉挛鱼在哪里？嘿嘿~你不会把它们吃了吧？";
			close;
		}
	} else if (checkquest(5078,HUNTING) > -1) {
		mes "嘿嘿~‘请给 50 只波波利！！来开派对吧。’嗯……嘿嘿~50 只波波利够喂饱所有邻居了。";
		next;
		if (checkquest(5078,HUNTING) == 2) {
			callsub L_CompleteQuest,5078,
				"Heh~ Wow, you did bring 50 Peco Pecos. Heh~ I guess we'll really have a party this evening.";
		} else {
		mes "[喵喵勇气队队长]";
			mes "嘿嘿~那些波波利在哪里？还没准备好吗？嘿嘿~";
			close;
		}
	} else if (checkquest(5079) > -1) {
		mes "嘿嘿~嗯……让我看看……嘿嘿~对了，我担心队伍在正式比赛前太紧张……但他们甚至不愿和我谈这件事。";
		next;
		if (countitem(7038) >= 20) {
			delitem 7038,20; //Yarn
			callsub L_CompleteQuest,5079,
				"Heh~ How could I miss that? I shall give some to my team for sure.";
		} else {
		mes "[喵喵勇气队队长]";
			mes "嘿嘿~那 20 个毛线在哪里？纸条上写的是 20 个，对吧……？请确认是不是弄丢了。";
			close;
		}
	} else if (checkquest(5080) > -1) {
		mes "嘿嘿~纸条上说，给我拿 30 个鼠尾当零食。";
		next;
		if (countitem(1016) >= 30) {
			delitem 1016,30; //Rat_Tail
			callsub L_CompleteQuest,5080,
				"Heh~ I think I've fed them good snacks... Didn't I? Lately I was little busy, they should have some patience... Heh~ Poor manager...";
		} else {
		mes "[喵喵勇气队队长]";
			mes "嘿嘿~那 30 个鼠尾在哪里？请确认后稍后再来。";
			close;
		}
	} else if (checkquest(5081) > -1) {
		mes "嘿嘿~纸条上写着 5 个……什么的 5 个？什么？！柠檬？";
		next;
		if (countitem(568) >= 5) {
			delitem 568,5; //Lemon
			callsub L_CompleteQuest,5081,
				"Heh~ Lemon is forbidden before the actual game... heh? They won't eat it at game time, right? Heh~";
		} else {
		mes "[喵喵勇气队队长]";
			mes "嘿嘿~那就给他们拿 5 个柠檬吧，好吗？嘿嘿~我还是不知道他们想用来做什么……";
			close;
		}
	} else if (checkquest(5082) > -1) {
		mes "嘿嘿~给我们 10 个冰块或 10 个冰淇淋！！嘿嘿~顺便说一句，我个人更喜欢冰淇淋。";
		next;
		if (countitem(7066) >= 10) {
			delitem 7066,10; //Ice_Piece
			callsub L_CompleteQuest,5082,
				"Heh~ Oh, you brought Ice Pieces. Heh~ The players will love it.";
		} else if (countitem(536) >= 10) {
			delitem 536,10; //Ice_Cream
			callsub L_CompleteQuest,5082,
				"Heh~ Oh, you brought Ice Creams. Heh~ The players will love it.";
		} else {
		mes "[喵喵勇气队队长]";
			mes "嘿嘿~冰块或冰淇淋在哪里？你应该在它们融化前拿来……";
			close;
		}
	} else if (checkquest(5083) > -1 || checkquest(5084) > -1) {
		mes "嘿嘿~我找到了队伍的纸条。嘿嘿~";
		next;
		if (checkquest(5083) > -1) {
			mes "[喵喵勇气队队长]";
			mes "嘿嘿~上面写着‘我们一起去见艾利乌。’嘿嘿~你已经见过艾利乌了吗？我想没有……嘿嘿~";
			close;
		} else {
			callsub L_CompleteQuest,5084,
				"Heh~ Oh, you did meet Eryu. Heh~ I will lecture them later for making you work too much... Heh~";
		}
	} else if (checkquest(5085) > -1 || checkquest(5086) > -1) {
		mes "嘿嘿~我找到了队伍的纸条。嘿嘿~";
		next;
		if (checkquest(5085) > -1) {
			mes "[喵喵勇气队队长]";
			mes "嘿嘿~上面写着‘我们一起去见炖汤。’嘿嘿~你已经见过炖汤了吗？我想没有……嘿嘿~";
			close;
		} else {
			callsub L_CompleteQuest,5086,
				"Heh~ Oh, you did meet Stew. Heh~ I will lecture them later for making you work too much... Heh~";
		}
	} else if (checkquest(5087) > -1 || checkquest(5088) > -1) {
		mes "嘿嘿~我找到了队伍的纸条。嘿嘿~";
		next;
		if (checkquest(5087) > -1) {
			mes "[喵喵勇气队队长]";
			mes "嘿嘿~上面写着‘我们一起去见番茄酱。’嘿嘿~你已经见过番茄酱了吗？我想没有……嘿嘿~";
			close;
		} else {
			callsub L_CompleteQuest,5088,
				"Heh~ Oh, you did meet Ketchup. Heh~ I will lecture them later for making you work too much... Heh~";
		}
	} else if (checkquest(5089) > -1 || checkquest(5090) > -1) {
		mes "嘿嘿~我找到了队伍的纸条。嘿嘿~";
		next;
		if (checkquest(5089) > -1) {
			mes "[喵喵勇气队队长]";
			mes "嘿嘿~上面写着‘我们一起去见艾夫。’嘿嘿~你已经见过艾夫了吗？我想没有……嘿嘿~";
			close;
		} else {
			callsub L_CompleteQuest,5090,
				"Heh~ Oh, you did meet Eff. Heh~ I will lecture them later for making you work too much... Heh~";
		}
	}
		mes "[喵喵勇气队队长]";
	mes "嘿？！没有给你的委托纸条，"+strcharinfo(0)+"。嘿嘿~你想报告什么？嘿嘿~";
	close;

// callsub L_CompleteQuest,<quest ID>,"<message>";
L_CompleteQuest:
	erasequest getarg(0);
	getitem 12636,3; //Malang_Sp_Can
			mes "[喵喵勇气队队长]";
	mes getarg(1);
	next;
			mes "[喵喵勇气队队长]";
	mes "嘿嘿~谢谢你过来，"+strcharinfo(0)+"。嘿嘿~继续努力。嘿嘿~";
	emotion ET_THANKS;
	close;
}

malangdo,127,111,4	script	Strange Cat#gamer	547,{
	if (MaxWeight - Weight < 1000) {
		mes "你的物品栏重量太高，无法继续。减轻负重后再来。";
		close;
	}
	if (checkweight(1201,1) == 0) {
		mes "你的物品栏太满，无法继续。腾出空间后再来。";
		close;
	}
	if (malang_gamer < 3) {
		mes "[Strange Cat]";
		mes "喵~喵~嗷嗷~喵喵~呜呜~";
		next;
		mes "这里有一只奇怪的猫。";
		close;
	} else if (malang_gamer == 3) {
		mes "[Manager Cat]";
		mes "喵~喵~嗷嗷~喵喵~呜呜~";
		next;
		mes "[Manager Cat]";
		mes "你想做什么？";
		emotion ET_QUESTION;
		next;
		set .@cat_gam, rand(1,10);
		select("询问队伍的态度……");
		if (.@cat_gam == 5) {
			mes "[Manager Cat]";
			mes "别骗我！我怎么能相信你并透露队伍的秘密？你不是狗狗队的间谍吧？";
			emotion ET_ANGER;
			next;
			select("哎呀，拜托……");
			mes "你在附近玩一会儿狐尾草，然后再来问。";
			next;
			select("猫咪玩家总监说……");
			mes "管理猫似乎对狐尾草感兴趣，开始回答了。";
			emotion ET_COOL;
			next;
			mes "[Manager Cat]";
			mes "玩家们害怕猫咪玩家总监。比赛时看到总监，他们就会紧张。";
			emotion ET_THROB;
			next;
			mes "[Manager Cat]";
			mes "可以把那个给我吗？";
			set malang_gamer,4;
			erasequest 5058;
			setquest 5059;
			next;
			mes "你把狐尾草交给管理猫。回去找猫咪玩家总监。";
			close;
		} else {
			mes "[Manager Cat]";
			mes "别骗我！";
			mes "我为什么要相信你，";
			mes "把我们队伍的信息告诉你？";
			mes "你不是狗狗队的间谍吗……？";
			mes "走开。";
			emotion ET_ANGER;
			next;
			mes "这只猫可能会打你。";
			close;
		}
	} else if (malang_gamer < 8) {
		mes "管理猫正在玩你给他的狐尾草。";
		mes "他似乎很喜欢……";
		emotion ET_THROB;
		close;
	} else if (malang_gamer == 8) {
	mes "管理猫正在玩你给他的狐尾草。";
	mes "他似乎很喜欢……";
		emotion ET_THROB;
		next;
		switch(select("救命~着火了~:嘿~！:想听点什么吗？")) {
		case 1:
			mes "[Manager Cat]";
			mes "别骗我~我们没有经常用火~";
			emotion ET_FRET;
			next;
			break;
		case 2:
			mes "管理猫无视你，继续玩着狐尾草。";
			emotion ET_THROB;
			close;
		case 3:
			mes "[Manager Cat]";
			mes "喵~我想告诉你一个故事~跟我来，喵~我们去那边聊，喵~";
			emotion ET_KIK;
			next;
			break;
		}
		mes "["+strcharinfo(0)+"]";
		mes "哈哈，我只是开玩笑。其实我想告诉你，猫咪玩家总监遇到了问题……";
		emotion ET_PROFUSELY_SWEAT, playerattached();
		next;
		mes "你把事情告诉了管理猫。";
		emotion ET_PROFUSELY_SWEAT, playerattached();
		next;
		mes "[Manager Cat]";
		mes "真可怕的景象……喵，我明白了……猫咪玩家总监应该通过放下执念来获得平静。";
		emotion ET_SCRATCH;
		next;
		mes "["+strcharinfo(0)+"]";
		mes "... ... ...";
		emotion ET_THINK, playerattached();
		next;
		mes "[Manager Cat]";
		mes "喵！去把这件事告诉他，喵~准备一个箱子，喵~";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "箱子？";
		emotion ET_QUESTION, playerattached();
		next;
		mes "[Manager Cat]";

		mes "[喵喵勇气队队长]";
		mes "嘿嘿~也许是我太担心了……不过请戴上这张^0000FF猫咪玩家证书^000000，然后去玩游戏吧。嘿嘿~";
		close;
	} else if (malang_gamer == 20) {
		// fall through
	} else {

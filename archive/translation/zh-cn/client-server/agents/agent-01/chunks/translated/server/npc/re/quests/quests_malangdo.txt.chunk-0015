		next;
		switch(select("不，我只是路过。:我接受你的提议。")) {
		case 1:
		mes "[喵喵勇气队队长]";
			mes "嘿嘿~我明白了。";
			mes "不过，让我再告诉你一次，"+strcharinfo(0)+"。";
			mes "我们随时欢迎你成为‘猫咪玩家荣誉会员’。";
			mes "嘿嘿~";
			close;
		case 2:
		mes "[喵喵勇气队队长]";
			mes "嘿嘿~终于！！";
			mes strcharinfo(0)+"要成为我们的荣誉会员了！！";
			mes "我马上制作一张^0000FF猫咪玩家证书^000000。嘿嘿~";
			emotion ET_DELIGHT;
			next;
		mes "[喵喵勇气队队长]";
			mes "一小时后回来，我会把^0000FF猫咪玩家证书^000000交给你。";
			mes "嘿嘿~";
			set malang_gamer,12;
			setquest 5069;
			close;
		}
	} else if (malang_gamer == 12) {
		if (checkquest(5069,PLAYTIME) == 0 || checkquest(5069,PLAYTIME) == 1) {
		mes "[喵喵勇气队队长]";
			mes "嘿嘿~你想快点拿到^0000FF猫咪玩家证书^000000。嘿嘿~这种证书可不是那么容易制作的。";
			next;
		mes "[喵喵勇气队队长]";
			mes "所以有点麻烦……嘿嘿~请稍后再来。嘿嘿~";
			emotion ET_DELIGHT;
			close;
		}
		mes "[喵喵勇气队队长]";
		mes "嘿嘿~我收到工坊的消息，证书已经制作完成了。嘿嘿~";
		next;
		mes "[喵喵勇气队队长]";
		mes "这可不是普通的证书。嘿嘿~";
		next;
		mes "["+strcharinfo(0)+"]";
		mes "什么意思？";
		next;
		mes "[喵喵勇气队队长]";
		mes "嘿嘿~这就是……";
		next;
		mes "猫咪玩家总监的眼中闪耀着骄傲。";
		next;
		mes "[喵喵勇气队队长]";
		mes "嘿嘿~这是‘猫咪玩家’技术团队努力的纯粹结晶！！";

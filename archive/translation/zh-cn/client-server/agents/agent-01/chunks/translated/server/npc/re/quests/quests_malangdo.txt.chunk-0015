		close;
	}
		mes "[喵喵勇气队队长]";
	mes "嘿嘿~你好，"+strcharinfo(0)+"。和玩家们练习得怎么样？";
	emotion ET_QUESTION;
	next;
	switch(select("玩家们情况如何？:只是来打个招呼~:这是目前的情况……")) {
	case 1:
		mes "[喵喵勇气队队长]";

mosk_fild02,243,270,0	script	Marozka#rus31	4_M_LGTGRAND,{
	if (rhea_rus_main < 8) {
		mes "[玛洛兹卡]";
		mes "...........................";
		close;
	} else if (rhea_rus_main == 8) {
		if (rhea_rus_quiz < 3) {
			mes "[玛洛兹卡]";
			mes "...........................";
			close;
		} else if (rhea_rus_quiz == 3) {
			if (getequipid(EQI_SHOES) != 2429 && getequipid(EQI_SHOES) != 2430) {
				mes "["+ strcharinfo(0) +"]";
				mes "……嗯，我是不是忘了穿什么？";
				close;
			}
			mes "[玛罗兹卡]";
			mes "………………你来了。";
			next;
			mes "["+ strcharinfo(0) +"]";
			mes "你是玛罗兹卡吗？看，我已经证明了自己的力量，现在你能制作“黄金线”了吗？";
			mes "我需要它把玛丽亚从墙里救出来。";
			next;
			mes "- 你把饼干和苹果 -";
			mes "- 放到他面前， -";
			mes "- 他慢慢说道 -";
			next;
			mes "[玛罗兹卡]";
			mes "如你所听说的，制作“黄金线”非常困难，需要很长时间。";
			next;
			mes "[玛罗兹卡]";
			mes "我现在就开始制作……让我看看……你能一小时后再回来吗？";
			rhea_rus_quiz = 4;
			rus_time01 = gettime(DT_HOUR);
			rus_time02 = gettime(DT_DAYOFWEEK);
			// changequest 8155,8156;
			close;
		} else if (rhea_rus_quiz == 4) {
			if (rus_time01 != gettime(DT_HOUR) || rus_time02 != gettime(DT_DAYOFWEEK)) {
				mes "[玛罗兹卡]";
				mes "啊，来得正是时候。";
				mes "我终于做好“黄金线”了。再等一秒就完成。";
				rhea_rus_quiz = 28;
				close;
			}
			mes "[玛罗兹卡]";
			mes "如你所听说的，制作“黄金线”非常困难，需要很长时间。";
			next;
			mes "[玛罗兹卡]";
			mes "我现在就开始制作……让我看看……你能一小时后再回来吗？";
			close;
		} else if (rhea_rus_quiz == 28) {
			mes "[玛罗兹卡]";
			mes "如约，这是“黄金线”。";
			mes "所以，你真的要去对抗不朽的科谢吗？";
			next;
			mes "["+ strcharinfo(0) +"]";
			mes "我不知道，但我答应过要把玛丽亚救出来。";
			next;
			mes "[玛罗兹卡]";
			mes "科谢可不是普通的对手。单靠力量无法击败他，你需要智慧和坚定不移的精神才能获胜。";
			next;
	mes "[玛洛兹卡]";
			mes "因为你在帮助玛丽亚，科谢会对你极其敌视。";
			next;
		mes "[玛洛兹卡]";
			mes "你还想要黄金线吗？好，我给你！不过还有最后一个考验。";
			next;
			mes "["+ strcharinfo(0) +"]";
			mes "最后一个考验？";
			mes "我不是已经证明自己的价值了吗？";
			next;
			mes "[玛罗兹卡]";
			mes "那是对力量的考验。现在你必须通过头脑与智慧的考验。";
			rhea_rus_quiz = 29;
			// changequest 8156,8157;
			close;
		} else if (rhea_rus_quiz == 29) {
			if (getequipid(EQI_SHOES) != 2429 && getequipid(EQI_SHOES) != 2430) {
				mes "["+ strcharinfo(0) +"]";
				mes "……嗯，我是不是忘了穿什么？";
				close;
			}
			mes "[玛罗兹卡]";
			mes "……怎么样？你决定了吗？";
			next;
			if(select("我需要更多时间……:我接受！") == 1) {
				mes "[玛罗兹卡]";
				mes "好吧，准备好后再回来。";
				close;
			}
			mes "[玛罗兹卡]";
			mes "你接受了……好，我们开始吧。你必须正确回答所有问题才能通过考验。";
			next;
			mes "[玛洛兹卡]";
			mes "什么东西又聋、又哑、又瞎，却总是在说真话？";
			next;
			.@j = select("波利:皮奇:镜子:树"); 
			.@rus_quiz01 = (.@j==3) ? 1 : 0;
	mes "[玛洛兹卡]";
			mes "如果 4 只猫每 4 分钟能抓 4 只老鼠，那么 10 分钟抓 10 只老鼠至少需要几只猫？";
			next;
			.@j = select("4:5:6:10");
			.@rus_quiz01 = (.@j==1)?.@rus_quiz01+1:.@rus_quiz01;
		mes "[玛洛兹卡]";
			mes "下面哪一项冬天变短、夏天变长？";
			next;
			.@j = select("天空:白天:波浪:风");
			.@rus_quiz01 = (.@j==2)?.@rus_quiz01+1:.@rus_quiz01;
			mes "[玛洛兹卡]";
			mes "多丽丝穿着衬裙，长着红鼻子；她站得越久，身体就越短。她是什么？";
			next;
			.@j = select("星星:蜡烛:剑:月亮");
			.@rus_quiz01 = (.@j==2)?.@rus_quiz01+1:.@rus_quiz01;
	mes "[玛洛兹卡]";
			mes "我的顶部和底部是一对双胞胎，中间将它们合成一个整体。若我高高站立且静止不动，我就会跑得更快。我是什么？";
			next;
			.@j = select("女人:女武神:月亮:沙漏");
			.@rus_quiz01 = (.@j==4)?.@rus_quiz01+1:.@rus_quiz01;
		mes "[玛洛兹卡]";
			mes "现在看看你答得怎么样。";
			next;
			if (.@rus_quiz01 > 4) {
	mes "[玛洛兹卡]";
			mes "你全部答对了。";
				next;
			} else {
		mes "[玛洛兹卡]";
			mes "我之前说过，除非你全部答对，否则我不会给你黄金线。";
				next;
	mes "[玛洛兹卡]";
			mes "现在再试还不晚。智慧伴随着耐心。";
				close;
			}
			mes "[玛洛兹卡]";
			mes "我知道用问答来评估一个人的智慧很奇怪，但这是我确认你是否真心决意对抗科谢的方法。";
			next;
			mes "[玛洛兹卡]";
			mes "希望你用力量和善意帮助玛丽亚。";
			rhea_rus_quiz = 30;
			getitem 7879,10;// Golden_Thread
			// completequest 8157;
			close;
		}
	}
	mes "[玛洛兹卡]";
	mes "...............................";
	next;
	mes "- 他闭上眼睛 -";
	mes "- 一动不动地站着 -";
	close;
}


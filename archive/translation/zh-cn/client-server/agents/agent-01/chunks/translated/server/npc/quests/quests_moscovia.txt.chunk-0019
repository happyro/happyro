			mes "................................................她还好吗？谢谢，你给了我勇气。";
			next;
			mes "[面色阴沉的士兵]";
			mes "我会回莫斯科比亚。但我现在的身体还不够好，无法回去。";
			next;
			mes "[面色阴沉的士兵]";
			mes "你能去找她，把我的话告诉她吗？";
			mes "我记得和她共度的每一刻……我仍然爱她。";
			next;
			mes "[面色阴沉的士兵]";
			mes "满月之前，我会回到莫斯科比亚见她。";
			mes "我会带着足够的力量和快乐回来，让她见到我时不再受苦。";
			rhea_rus_hair = 7;
			// changequest 8152,8153;
			close;
		} else if (rhea_rus_hair == 7) {
			mes "[面色阴沉的士兵]";
			mes "你能去找她，把我的话告诉她吗？";
			mes "我记得和她共度的每一刻……我仍然爱她。";
			next;
			mes "[面色阴沉的士兵]";
			mes "满月之前，我会回到莫斯科比亚见她。";
			mes "我会带着足够的力量和快乐回来，让她见到我时不再受苦。";
			close;
		} 
	}
	mes "[面色阴沉的士兵]";
	mes "……我感觉自己失去了一件珍贵的东西。";
	next;
	mes "- 他低头看着金耳环，小心地擦拭着它 -";
	close;
}


mosk_dun02,48,214,5	script	Baba Yaga#rus32	4_F_BABAYAGA,{
	if (rhea_rus_main < 9) {
	mes "[芭芭雅嘎]";
		mes "...........................";
		mes "你要是再在这里闲逛，我就给自己煮一锅美味的人肉汤！嘿嘿嘿嘿。";
		emotion ET_KIK;
		emotion ET_HUK, playerattached();
		close;
	} else if (rhea_rus_main == 9) {
		.@player_name$ = strcharinfo(0);
		mes "[巴巴雅嘎]";
		mes "你这个看起来很美味的人类，来这里做什么？再闲逛下去，我就煮人肉汤！嘿嘿嘿嘿。";
		next;
		mes "["+ .@player_name$ +"]";
		mes "我、呃，我……黄金……黄金……";
		next;
		mes "[巴巴雅嘎]";
		mes "你在嘀咕什么？";
		mes "想让我把你变成野兽吗？！";
		next;
		mes "[巴巴雅嘎]";
		mes "‘变身咒！！’";
		mes "‘变成猪！！’";
		specialeffect2 EF_BARRIER;
		emotion ET_HUK;
		next;
		mes "[巴巴雅嘎]";
		mes "嗯？你受到保护咒保护？";
		mes "不过它太弱了。我的咒语已经摧毁了它。";
		next;
		mes "[巴巴雅嘎]";
		mes "现在离开，否则我就再次诅咒你！‘变……’";
		next;
		mes "["+ .@player_name$ +"]";
		mes "呃，呃……我的意思是……我说……咒语……";
		next;
		input .@input$;
		if (.@input$ == "Spellshield Protection") {
			mes "["+ .@player_name$ +"]";
			mes "呃，呃……我的意思是……我说……咒语……";
			mes ""+ .@input$ +" !!!";
			specialeffect2 EF_ABSORBSPIRITS;
			next;
		} else {
			mes "["+ .@player_name$ +"]";
		mes "呃，呃……我的意思是……我说……咒语……";
			mes ""+ .@input$ +" !!!";
			next;
			mes "[芭芭雅嘎]";
			mes "你想用那个弱小的咒语做什么！？";
			mes "走开，孩子！";
			close2;
			warp "mosk_dun02",135,163;
			end;
		}
		mes "[巴巴雅嘎]";
		mes "哦，你受到保护咒保护。你不是普通的孩子。";
		next;
		mes "["+ .@player_name$ +"]";
		mes "我听说你能制作“黄金钥匙”，所以我才来这里！";
		next;
		mes "[芭芭雅嘎]";
		mes "‘黄金钥匙’？你为什么需要它？";
		next;
		mes "["+ .@player_name$ +"]";
		mes "我需要它把玛丽亚·莫布雷娜从黑暗的墙牢里解救出来。";
		next;
	mes "[芭芭雅嘎]";
		mes "……玛丽亚·莫布雷娜……";
		mes "你要和科谢战斗吗？";
		next;
		mes "["+ .@player_name$ +"]";
		mes "如果他妨碍我履行对她的承诺，我想我会与他战斗。";
		next;
		mes "[芭芭雅嘎]";
		mes "哦，嘻嘻嘻嘻嘻。嘿嘿嘿嘿。";
		mes "你很有意思。你似乎不怕科谢。";
		next;
	mes "[芭芭雅嘎]";
		mes "好，制作钥匙所需的材料是……";
		next;
		if (countitem(724) > 1 && countitem(969) > 2 && countitem(7877) && countitem(7878) > 1 && countitem(7879) > 9) {
			mes "[芭芭雅嘎]";
			mes "你已经收集齐所有材料了吗？";
			next;
		} else {
			mes "[芭芭雅嘎]";
			mes "什么？没有材料我无法为你制作“黄金钥匙”。";
			next;
	mes "[芭芭雅嘎]";
			mes "去找^0000ff 2 个诅咒红宝石、3 个黄金、1 个红色戒指、2 根露莎卡的头发、10 根黄金线^000000！";
			close;
		}
		mes "[芭芭雅嘎]";
		mes "好，我们开始吧。啊，在那之前……在这里等着！";
		delitem 724,2;
		delitem 969,3;
		delitem 7877,1;
		delitem 7878,2;
		delitem 7879,10;
		rhea_rus_main = 10;
		close;
	} else if (rhea_rus_main == 10) {
		mes "[芭芭雅嘎]";
		mes "你来这里！";
		next;
		mes "- 芭芭雅嘎仔细地 -";
		mes "- 打量着你 -";
		next;
	mes "[芭芭雅嘎]";
		mes "嗯，你看起来精力充沛又强壮。好，在我制作“黄金钥匙”时，你得先帮我一个忙！";
		next;
		if (BaseClass == Job_Archer) {
			mes "[芭芭雅嘎]";
			mes "我的牛跑掉了。找到它并对它施放回返咒。咒语是‘^ff0000好饲料是橙子味的^000000’。你应该记住。";
			next;
		mes "[芭芭雅嘎]";
			mes "好！快去，快去！最好动作快点，否则我会想办法惩罚你。嘿嘿嘿嘿。";
			rhea_rus_main = 11;
			// changequest 8158,8159;
			close;

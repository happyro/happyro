mosk_que,49,22,3	script	#rus27	-1,3,3,{
	end;
OnTouch_:
	if (rhea_rus_main == 8) {
		if (!rhea_rus_quiz) {
			mes "[身份不明的声音]";
			mes "是谁敢闯入我的洞窟！";
			next;
			mes "["+ strcharinfo(0) +"]";
			mes "你是玛罗兹卡吗？玛丽亚派我来的！我需要你的“黄金线”制作“黄金钥匙”，把她从墙上解救出来！";
			next;
			mes "[身份不明的声音]";
			mes "……制作“黄金钥匙”？";
			mes "你觉得自己适合这项工作吗？";
			next;
			mes "[身份不明的声音]";
			mes "你既然问起“黄金钥匙”和玛丽亚，就一定要与“科谢”战斗！你觉得自己足够强大，能与他战斗吗？";
			next;
			mes "["+ strcharinfo(0) +"]";
			mes "我当然足够强大！";
			next;
			mes "[身份不明的声音]";
			mes "你很有自信。";
			mes "不过，我需要测试你，看看你是否真的有能力。";
			next;
			mes "[身份不明的声音]";
			mes "洞窟里有一座“石炉”和一棵“苹果树”。";
			mes "你可以从石炉取得^0000ff100 个烤好的饼干^000000，从苹果树取得^0000ff100 个苹果^000000，然后逃出洞窟。";
			next;
			mes "[身份不明的声音]";
			mes "这不会容易。石炉和苹果树周围有怪物游荡。";
			next;
			mes "[身份不明的声音]";
			mes "让我看看你的本事。";
			rhea_rus_quiz = 1;
			// setquest 8155;
			close;
		}
	}
	emotion ET_QUESTION, playerattached();
	end;
}

mosk_que,45,131,0	script	Stone Furnace#rus28	HIDDEN_NPC,{
	if (rhea_rus_main == 8) {
		if (rhea_rus_quiz == 1) {
			if (getequipid(EQI_SHOES) != 2429 && getequipid(EQI_SHOES) != 2430) {
				mes "["+ strcharinfo(0) +"]";
				mes "……嗯，我是不是忘了穿什么……？";
				close;
			}
			mes "- 你看到了 -";
			mes "- 烤得很好的饼干。 -";
			mes "- 小心， -";
			mes "- 别被烫伤。 -";
			next;
			if (rand(1,3) == 2) {
				mes "- 你迅速伸出手， -";
				mes "- 捡起了 -";
				mes "- 烤好的饼干！ -";
				next;
				mes "- ^0000ff你获得了 100 个^000000 -";
				mes "- ^0000ff烤得香脆的饼干！！^000000 -";
				next;
			} else {
				mes "- 你迅速伸出手， -";
				mes "- 捡起了 -";
				mes "- 烤好的饼干！ -";
				next;
				mes "["+ strcharinfo(0) +"]";
				mes "糟糕，好烫，好烫！！！";
				specialeffect2 EF_FIREHIT;
				emotion ET_HUK, playerattached();
				percentheal -5,0;
				close;
			}
			mes "[玛罗兹卡的守卫]";
			mes "这只老鼠是怎么进洞窟的？！";
			announce "马罗兹卡的守卫：入侵者！搜查整个洞穴！！",bc_map,0x87CEEB;
			rhea_rus_quiz = 2;
			if (!$@rus_req01) {
				initnpctimer;
				monster "mosk_que",49,156,"玛洛兹卡的守卫",1889,1,"Stone Furnace#rus28::OnMyMobDead";
				$@rus_req01 = 1;
			}
			close;
		}
	}
	emotion ET_QUESTION, playerattached();
	end;

OnMyMobDead:
	stopnpctimer;
	$@rus_req01 = 0;
	announce "玛罗兹卡：你真的很勇敢。拿到饼干和苹果后，来见我。",bc_map,0x87CEEB;
	end;

OnTimer300000:
	killmonster "mosk_que","Stone Furnace#rus28::OnMyMobDead";
	stopnpctimer;
OnInit:
	$@rus_req01 = 0;
	end;
}


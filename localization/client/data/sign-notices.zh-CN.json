      "sha256": "bb41caef5c8898ba49d1d3b4cf60a5dae074a7416ec8fd4e9e285a2c62559331",
      "lines": [
        "致所有身怀绝技、",
        "胸怀远大梦想的人："
      ],
      "size": [
        232,
        464
      ]
    },
    {
      "file": "localization/client/data/texture/유저인터페이스/illust/sign_02.bmp",
      "source": "work/grf-extract/kro-20211105/data/data/texture/유저인터페이스/illust/sign_02.bmp",
      "source_sha256": "6c96ab5c2c78e9d1af9bc509a6dfdb6d2c7c6becaa0da236ba55fadee798b36e",
      "sha256": "9e671695838fefe451ed686797cc9d240bde69fcdd63fb9444a9b1a7f3c62d93",
      "lines": [
        "我想为你们",
        "指明一条道路。",
        "这条路十分危险，",
        "而且艰难险阻重重，",
        "却会让你获得",
        "非凡的力量。"
      ],
      "size": [
        232,
        464
      ]
    },
    {
      "file": "localization/client/data/texture/유저인터페이스/illust/sign_03.bmp",
      "source": "work/grf-extract/kro-20211105/data/data/texture/유저인터페이스/illust/sign_03.bmp",
      "source_sha256": "5c2831647e4c13ad86d7fe8a08de58fc80e31a9dc8bc50f1fe12c28a3b4fef82",
      "sha256": "77cb568644d43acee71abb51886cd1329587eee8eb02d460f65cb059f45436bb",
      "lines": [
        "我，梅兹·布雷德，",
        "以自己的名义",
        "向你保证。"
      ],
      "size": [
        232,
        464
      ]
    },
    {
      "file": "localization/client/data/texture/유저인터페이스/illust/sign_04.bmp",
      "source": "work/grf-extract/kro-20211105/data/data/texture/유저인터페이스/illust/sign_04.bmp",
      "source_sha256": "dae4293c6d47aeb3f9f7d1518bfcb57ff1c421d786f1abb1efe74a30070439e1",
      "sha256": "009395cd5d46c6042884aa2b96088364fdb87a16763ce2465a1cc3ef8f77dd8e",
      "lines": [
        "不过，要获得",
        "这份强大的力量，",
        "你必须接受资格考验。",
        "先来找到我。",
        "寻找我的过程，",
        "就是考验的开始。",
        "",
        "梅兹·布雷德"
      ],
      "size": [
        232,
        464
      ],
      "background_source": "work/grf-extract/kro-20211105/data/data/texture/유저인터페이스/illust/sign_01.bmp"
